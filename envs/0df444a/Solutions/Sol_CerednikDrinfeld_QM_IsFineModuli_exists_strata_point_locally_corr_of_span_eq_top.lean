  choose L instL instLA instLloc instLC instLT instLO instLOT h0L vv vv' ϱ ϱ' hϱ hϱ' i₀ hi₀ hvia hcorr hpt hpt' using hwit
  choose ib hib hibf uA huA huAg i₁ j₁ hrel using hcorr

  let J : ℕ := Finset.univ.sup (fun p : (Σ i : Fin m, Σ j : Fin m, Fin (mL i j)) => j₁ p.1 p.2.1 p.2.2)
  have hJ : ∀ i j k, j₁ i j k ≤ J := fun i j k =>
    Finset.le_sup (f := fun p : (Σ i : Fin m, Σ j : Fin m, Fin (mL i j)) => j₁ p.1 p.2.1 p.2.2) (Finset.mem_univ ⟨i, j, k⟩)

  have hdeg := fun i => exists_orthogonalIdempotents_finrank_const 𝒪 π Onr Λ hΛℤ A₀ n C ψ (B i) (hB0 i) (u i) (ρ i)
  choose nv ev hevO hevS Aφ Γ hAΓ using hdeg

  let μ : ∀ i, Fin (nv i) → ℕ := fun i v => padicValNat (Γ i v) (Aφ i v)
  let K : ℕ := J + Finset.univ.sup (fun p : (Σ i : Fin m, Fin (nv i)) => μ p.1 p.2)
  have hμK : ∀ i v, μ i v + J ≤ K := fun i v => by
    have := Finset.le_sup (f := fun p : (Σ i : Fin m, Fin (nv i)) => μ p.1 p.2) (Finset.mem_univ ⟨i, v⟩)
    simp only at this; omega
  let s : ∀ i, Fin (nv i) → ℕ := fun i v => K - μ i v
  let e : ℕ := Finset.univ.sup (fun p : (Σ i : Fin m, Fin (nv i)) => d p.1 + s p.1 p.2)
  have hse : ∀ i v, d i + s i v ≤ e := fun i v =>
    Finset.le_sup (f := fun p : (Σ i : Fin m, Fin (nv i)) => d p.1 + s p.1 p.2) (Finset.mem_univ ⟨i, v⟩)
  let t : ∀ i, Fin (nv i) → ℕ := fun i v => e - (d i + s i v)
  have hpe : ∀ i v, (pad hΛℤ (ρ i) (s i v) (t i v)).d = e := fun i v => by
    show (ρ i).d + s i v + t i v = e
    rw [hd i]; simp only [t]; have := hse i v; omega

  let qX : X e ⟶ Spec (CommRingCat.of C) := ξ e ≫ Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))
  let yv : ∀ i (v : Fin (nv i)), Spec (CommRingCat.of (Localization.Away (ev i v))) ⟶ X e := fun i v =>
    Spec.map (CommRingCat.ofHom (algebraMap (B i) (Localization.Away (ev i v)))) ≫
      (ptX e (B i) _ rfl (u i) (pad hΛℤ (ρ i) (s i v) (t i v)) (hpe i v) (hB0 i)).1
  have hyv : ∀ i v, yv i v ≫ qX = Spec.map (CommRingCat.ofHom (algebraMap (B i) (Localization.Away (ev i v)))) ≫
      Spec.map (CommRingCat.ofHom (algebraMap C (B i))) := fun i v => by
    simp only [yv, qX, Category.assoc]
    rw [(ptX e (B i) _ rfl (u i) (pad hΛℤ (ρ i) (s i v) (t i v)) (hpe i v) (hB0 i)).2]
  have hyB := fun i => glue_points_of_orthogonalIdempotents qX (B i) (nv i) (ev i) (hevO i).toOrthogonalIdempotents (hevS i) (yv i) (hyv i)
  choose yB hyBC hyBv using hyB

  have compat : ∀ i j,
      Spec.map (CommRingCat.ofHom (σ₁ i j : B i →+* D i j)) ≫ yB i = Spec.map (CommRingCat.ofHom (σ₂ i j : B j →+* D i j)) ≫ yB j := by
    intro i j

    let ι : Type := Fin (nv i) × Fin (nv j) × Fin (mL i j)
    let cι : ι → D i j := fun p => ((σ₁ i j) (ev i p.1) * (σ₂ i j) (ev j p.2.1)) * g i j p.2.2
    have hcι : Ideal.span (Set.range cι) = ⊤ :=
      span_range_mul_mul_eq_top (fun v => (σ₁ i j) (ev i v)) (fun w => (σ₂ i j) (ev j w)) (g i j)
        (span_range_comp_eq_top (σ₁ i j : B i →+* D i j) (ev i) (hevS i))
        (span_range_comp_eq_top (σ₂ i j : B j →+* D i j) (ev j) (hevS j)) (hg i j)
    let eι : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
    let c : Fin (Fintype.card ι) → D i j := fun q => cι (eι.symm q)
    have hc : Ideal.span (Set.range c) = ⊤ := by
      have : Set.range c = Set.range cι := eι.symm.surjective.range_comp cι
      rw [this, hcι]
    have hσC : ∀ (σ : B i →ₐ[A] D i j), (σ : B i →+* D i j).comp (algebraMap C (B i)) = algebraMap C (D i j) := fun σ => by
      rw [IsScalarTower.algebraMap_eq C A (B i), ← RingHom.comp_assoc, σ.comp_algebraMap, ← IsScalarTower.algebraMap_eq C A (D i j)]
    have hσC' : ∀ (σ : B j →ₐ[A] D i j), (σ : B j →+* D i j).comp (algebraMap C (B j)) = algebraMap C (D i j) := fun σ => by
      rw [IsScalarTower.algebraMap_eq C A (B j), ← RingHom.comp_assoc, σ.comp_algebraMap, ← IsScalarTower.algebraMap_eq C A (D i j)]

    have piece : ∀ (v : Fin (nv i)) (w : Fin (nv j)) (k : Fin (mL i j)) (xq : D i j)
        (hxq : xq = ((σ₁ i j) (ev i v) * (σ₂ i j) (ev j w)) * g i j k)
        (P : Type) [CommRing P] [Algebra (D i j) P] [IsLocalization.Away xq P],
        Spec.map (CommRingCat.ofHom (algebraMap (D i j) P)) ≫ (Spec.map (CommRingCat.ofHom (σ₁ i j : B i →+* D i j)) ≫ yB i) =
          Spec.map (CommRingCat.ofHom (algebraMap (D i j) P)) ≫ (Spec.map (CommRingCat.ofHom (σ₂ i j : B j →+* D i j)) ≫ yB j) := by
      intro v w k xq hxq P _ _ _
      subst hxq
      by_cases hP : Subsingleton P
      · haveI := hP
        haveI : IsEmpty ↥(Spec (CommRingCat.of P)) := inferInstanceAs (IsEmpty (PrimeSpectrum P))
        exact Limits.IsInitial.hom_ext isInitialOfIsEmpty _ _
      haveI : Nontrivial P := not_subsingleton_iff_nontrivial.mp hP

      letI := instL i j k; letI := instLA i j k; letI := instLloc i j k; letI := instLC i j k
      haveI := instLT i j k; letI := instLO i j k; haveI := instLOT i j k
      let τ : L i j k →+* P :=
        IsLocalization.Away.awayToAwayLeft (S := L i j k) (g i j k) ((σ₁ i j) (ev i v) * (σ₂ i j) (ev j w)) (P := P)
      have hτ : τ.comp (algebraMap (D i j) (L i j k)) = algebraMap (D i j) P :=
        RingHom.ext fun a => IsLocalization.Away.awayToAwayLeft_eq (S := L i j k) (g i j k) ((σ₁ i j) (ev i v) * (σ₂ i j) (ev j w)) (P := P) a

      let φ₁ : B i →ₐ[C] L i j k := (IsScalarTower.toAlgHom C (D i j) (L i j k)).comp ((σ₁ i j).restrictScalars C)
      let φ₂ : B j →ₐ[C] L i j k := (IsScalarTower.toAlgHom C (D i j) (L i j k)).comp ((σ₂ i j).restrictScalars C)
      have hφ₁ : (φ₁ : B i →+* L i j k) = (algebraMap (D i j) (L i j k)).comp (σ₁ i j : B i →+* D i j) := rfl
      have hφ₂ : (φ₂ : B j →+* L i j k) = (algebraMap (D i j) (L i j k)).comp (σ₂ i j : B j →+* D i j) := rfl

      have hu₁ : IsUnit ((algebraMap (D i j) P) ((σ₁ i j) (ev i v))) :=
        IsLocalization.Away.isUnit_of_dvd (((σ₁ i j) (ev i v) * (σ₂ i j) (ev j w)) * g i j k) (S := P)
          ⟨(σ₂ i j) (ev j w) * g i j k, by ring⟩
      have hu₂ : IsUnit ((algebraMap (D i j) P) ((σ₂ i j) (ev j w))) :=
        IsLocalization.Away.isUnit_of_dvd (((σ₁ i j) (ev i v) * (σ₂ i j) (ev j w)) * g i j k) (S := P)
          ⟨(σ₁ i j) (ev i v) * g i j k, by ring⟩
      have hu₁' : IsUnit (((algebraMap (D i j) P).comp (σ₁ i j : B i →+* D i j)) (ev i v)) := hu₁
      have hu₂' : IsUnit (((algebraMap (D i j) P).comp (σ₂ i j : B j →+* D i j)) (ev j w)) := hu₂
      let κ₁ : Localization.Away (ev i v) →+* P := IsLocalization.Away.lift (ev i v) (S := Localization.Away (ev i v)) hu₁'
      let κ₂ : Localization.Away (ev j w) →+* P := IsLocalization.Away.lift (ev j w) (S := Localization.Away (ev j w)) hu₂'
      have hκ₁ : κ₁.comp (algebraMap (B i) (Localization.Away (ev i v))) = (algebraMap (D i j) P).comp (σ₁ i j : B i →+* D i j) :=
        IsLocalization.Away.lift_comp (ev i v) (S := Localization.Away (ev i v)) hu₁'
      have hκ₂ : κ₂.comp (algebraMap (B j) (Localization.Away (ev j w))) = (algebraMap (D i j) P).comp (σ₂ i j : B j →+* D i j) :=
        IsLocalization.Away.lift_comp (ev j w) (S := Localization.Away (ev j w)) hu₂'

      have step : ∀ {T : Type} [CommRing T] [Algebra A T] [Algebra C T] [IsScalarTower C A T] (σ : T →+* D i j)
          (yT : Spec (CommRingCat.of T) ⟶ X e) {Lv : Type} [CommRing Lv] [Algebra T Lv] (κ : Lv →+* P)
          (hκ : κ.comp (algebraMap T Lv) = (algebraMap (D i j) P).comp σ) (z : Spec (CommRingCat.of T) ⟶ X e)
          (hz : Spec.map (CommRingCat.ofHom (algebraMap T Lv)) ≫ yT = Spec.map (CommRingCat.ofHom (algebraMap T Lv)) ≫ z),
          Spec.map (CommRingCat.ofHom (algebraMap (D i j) P)) ≫ (Spec.map (CommRingCat.ofHom σ) ≫ yT) =
            Spec.map (CommRingCat.ofHom τ) ≫ (Spec.map (CommRingCat.ofHom ((algebraMap (D i j) (L i j k)).comp σ)) ≫ z) := by
        intro T _ _ _ _ σ yT Lv _ _ κ hκ z hz
        calc Spec.map (CommRingCat.ofHom (algebraMap (D i j) P)) ≫ (Spec.map (CommRingCat.ofHom σ) ≫ yT)
            = Spec.map (CommRingCat.ofHom (κ.comp (algebraMap T Lv))) ≫ yT := by
                rw [hκ, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
          _ = Spec.map (CommRingCat.ofHom κ) ≫ (Spec.map (CommRingCat.ofHom (algebraMap T Lv)) ≫ yT) := by
                rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
          _ = Spec.map (CommRingCat.ofHom κ) ≫ (Spec.map (CommRingCat.ofHom (algebraMap T Lv)) ≫ z) := by rw [hz]
          _ = Spec.map (CommRingCat.ofHom (κ.comp (algebraMap T Lv))) ≫ z := by
                rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
          _ = Spec.map (CommRingCat.ofHom ((τ.comp (algebraMap (D i j) (L i j k))).comp σ)) ≫ z := by rw [hκ, hτ]
          _ = Spec.map (CommRingCat.ofHom τ) ≫ (Spec.map (CommRingCat.ofHom ((algebraMap (D i j) (L i j k)).comp σ)) ≫ z) := by
                rw [RingHom.comp_assoc, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
      rw [step (σ₁ i j : B i →+* D i j) (yB i) κ₁ hκ₁ _ (hyBv i v), step (σ₂ i j : B j →+* D i j) (yB j) κ₂ hκ₂ _ (hyBv j w)]
      congr 1

      have hπL : algebraMap 𝒪 (L i j k) π = 0 := by rw [IsScalarTower.algebraMap_apply 𝒪 C (L i j k)]; exact h0L i j k
      obtain ⟨𝔭, h𝔭⟩ := exists_point_quot_forall_isUnit_not_mem π (L i j k) P τ hπL
      let y' : ↥(ϱ' i j k).Ab.A := ((ϱ' i j k).Ab.L.one (𝟙 _)).1.base 𝔭
      have hy' : (ϱ' i j k).Ab.f.base y' = 𝔭 := base_one_base (ϱ' i j k).Ab.L 𝔭

      have hle : ∀ {T : Type} [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T] (φ : T →ₐ[C] L i j k),
          Ideal.span {algebraMap 𝒪 T π} ≤ (Ideal.span {algebraMap 𝒪 (L i j k) π}).comap (φ : T →+* L i j k) := by
        intro T _ _ _ _ φ
        rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap,
          IsScalarTower.algebraMap_apply 𝒪 C T, AlgHom.coe_toRingHom, AlgHom.commutes, ← IsScalarTower.algebraMap_apply 𝒪 C (L i j k)]
        exact Ideal.subset_span rfl
      let φb₁ := Ideal.quotientMap (Ideal.span {algebraMap 𝒪 (L i j k) π}) (φ₁ : B i →+* L i j k) (hle φ₁)
      let φb₂ := Ideal.quotientMap (Ideal.span {algebraMap 𝒪 (L i j k) π}) (φ₂ : B j →+* L i j k) (hle φ₂)
      have hpt₁ : (ptX (d i) (L i j k) _ rfl (vv i j k) (ϱ i j k) (hϱ i j k) (h0L i j k)).1 =
          Spec.map (CommRingCat.ofHom (φ₁ : B i →+* L i j k)) ≫ (ptX (d i) (B i) _ rfl (u i) (ρ i) (hd i) (hB0 i)).1 := by
        rw [hpt i j k, hpres i, hφ₁, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
      have hpt₂ : (ptX (d j) (L i j k) _ rfl (vv' i j k) (ϱ' i j k) (hϱ' i j k) (h0L i j k)).1 =
          Spec.map (CommRingCat.ofHom (φ₂ : B j →+* L i j k)) ≫ (ptX (d j) (B j) _ rfl (u j) (ρ j) (hd j) (hB0 j)).1 := by
        rw [hpt' i j k, hpres j, hφ₂, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
      obtain ⟨z₁, z₂, hz₁, hz₂, hdeg, hΓ⟩ := exists_finrank_rel_of_witness 𝒪 π Onr Λ hΛℤ A₀ n M fM C ψ X ξ ptX hx2 hx4
        (B i) (B j) (L i j k) (hB0 i) (hB0 j) (h0L i j k) φ₁ φ₂ φb₁ (by ext; rfl) φb₂ (by ext; rfl)
        (u i) (ρ i) (d i) (hd i) (u j) (ρ j) (d j) (hd j) (vv i j k) (vv' i j k) (ϱ i j k) (ϱ' i j k) (hϱ i j k) (hϱ' i j k)
        (i₀ i j k) (hi₀ i j k) (hvia i j k) (ib i j k) (hib i j k) (hibf i j k) (uA i j k) (huA i j k) (huAg i j k)
        (i₁ i j k) (j₁ i j k) (hrel i j k) hpt₁ hpt₂ y'

      have loc : ∀ {T : Type} [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T] (φ : T →ₐ[C] L i j k) (a : T)
          (ha : IsUnit (τ (φ a))) (z : ↥(Spec (CommRingCat.of (T ⧸ Ideal.span {algebraMap 𝒪 T π}))))
          (hz : z = (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (Ideal.span {algebraMap 𝒪 (L i j k) π}) (φ : T →+* L i j k) (hle φ)))).base
            ((ϱ' i j k).Ab.f.base y')),
          Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 T π}) a ∉ z.asIdeal := by
        intro T _ _ _ _ φ a ha z hz
        rw [hz, hy', mem_SpecMap_base_asIdeal_iff, Ideal.quotientMap_mk]
        exact h𝔭 (φ a) ha
      have hτφ₁ : IsUnit (τ (φ₁ (ev i v))) := by
        have : τ (φ₁ (ev i v)) = algebraMap (D i j) P ((σ₁ i j) (ev i v)) := by
          rw [← hτ]; rfl
        rw [this]; exact hu₁
      have hτφ₂ : IsUnit (τ (φ₂ (ev j w))) := by
        have : τ (φ₂ (ev j w)) = algebraMap (D i j) P ((σ₂ i j) (ev j w)) := by
          rw [← hτ]; rfl
        rw [this]; exact hu₂
      obtain ⟨hA₁, hΓ₁, hA₁pos, hΓ₁gt⟩ := hAΓ i v z₁ (loc φ₁ (ev i v) hτφ₁ _ hz₁)
      obtain ⟨hA₂, hΓ₂, hA₂pos, -⟩ := hAΓ j w z₂ (loc φ₂ (ev j w) hτφ₂ _ hz₂)
      rw [hA₁, hA₂, hΓ₁] at hdeg
      rw [hΓ₂, hΓ₁] at hΓ
      have hμ := padicValNat_add_eq_of_mul_pow_eq (Γ i v) (Aφ i v) (Aφ j w) (i₁ i j k) (j₁ i j k) hΓ₁gt hA₁pos hA₂pos hdeg
      have hμ' : μ j w + i₁ i j k = μ i v + j₁ i j k := by
        simp only [μ]; rw [hΓ]; exact hμ
      have hK₁ := hμK i v
      have hK₂ := hμK j w
      have hJ₁ := hJ i j k
      obtain ⟨w₀, hs₁, hs₂⟩ : ∃ w₀, s i v = j₁ i j k + w₀ ∧ s j w = i₁ i j k + w₀ :=
        ⟨s i v - j₁ i j k, by simp only [s]; omega, by simp only [s]; omega⟩

      have gen : ∀ (s₁ s₂ : ℕ) (h₁ : (pad hΛℤ (ρ i) s₁ (t i v)).d = e) (h₂ : (pad hΛℤ (ρ j) s₂ (t j w)).d = e),
          s₁ = j₁ i j k + w₀ → s₂ = i₁ i j k + w₀ →
          Spec.map (CommRingCat.ofHom (φ₁ : B i →+* L i j k)) ≫ (ptX e (B i) _ rfl (u i) (pad hΛℤ (ρ i) s₁ (t i v)) h₁ (hB0 i)).1 =
            Spec.map (CommRingCat.ofHom (φ₂ : B j →+* L i j k)) ≫ (ptX e (B j) _ rfl (u j) (pad hΛℤ (ρ j) s₂ (t j w)) h₂ (hB0 j)).1 := by
        intro s₁ s₂ h₁ h₂ e₁ e₂
        subst e₁ e₂
        exact restrict_ptX_pad_eq_of_witness 𝒪 π Onr Λ hΛℤ A₀ n M fM C ψ X ξ ptX hx2 hx4 (B i) (B j) (L i j k)
          (hB0 i) (hB0 j) (h0L i j k) φ₁ φ₂ (u i) (ρ i) (d i) (hd i) (u j) (ρ j) (d j) (hd j)
          (vv i j k) (vv' i j k) (ϱ i j k) (ϱ' i j k) (hϱ i j k) (hϱ' i j k) (i₀ i j k) (hi₀ i j k) (hvia i j k)
          (ib i j k) (hib i j k) (hibf i j k) (uA i j k) (huA i j k) (huAg i j k) (i₁ i j k) (j₁ i j k) (hrel i j k)
          hpt₁ hpt₂ w₀ (t i v) (t j w) e h₁ h₂
      rw [← hφ₁, ← hφ₂]
      exact gen (s i v) (s j w) (hpe i v) (hpe j w) hs₁ hs₂

    refine glue_points_ext qX (D i j) (Fintype.card ι) c hc (fun q => Localization.Away (c q)) _ _ ?_ ?_ (fun q => ?_)
    · rw [Category.assoc, hyBC i, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσC]
    · rw [Category.assoc, hyBC j, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσC']
    · exact piece (eι.symm q).1 (eι.symm q).2.1 (eι.symm q).2.2 (c q) rfl (Localization.Away (c q))

  have hyBC' : ∀ i, yB i ≫ qX = Spec.map (CommRingCat.ofHom (algebraMap A (B i))) ≫ Spec.map (CommRingCat.ofHom (algebraMap C A)) := by
    intro i; rw [hyBC, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq C A (B i)]
  obtain ⟨x₀, hx₀C, hx₀B⟩ := glue_points qX A m f hf B D (fun i j => (σ₁ i j : B i →+* D i j)) (fun i j => (σ₂ i j : B j →+* D i j))
    (fun i j => (σ₁ i j).comp_algebraMap) (fun i j => (σ₂ i j).comp_algebraMap) yB hyBC' compat
  refine ⟨e, x₀, by simpa only [qX, Category.assoc] using hx₀C, fun i => ?_⟩

  rw [← hpres i]
  refine locCorr_of_forall_restrict_eq_ptX_pad 𝒪 π Onr Λ hΛℤ A₀ n M fM C ψ X ξ ptX hx2 (B i) (hB0 i) (u i) (ρ i) (d i) e (hd i)
    (nv i) (ev i) (hevS i) (s i) (t i) (hpe i) _ (fun v => ?_)
  rw [hx₀B i, hyBv i v]

theorem core_canonical
    (hx2 : (∀ (d : ℕ) (T T' : Type) [CommRing T] [Algebra C T] [Algebra 𝒪 T] [IsScalarTower 𝒪 C T]
                [CommRing T'] [Algebra C T'] [Algebra 𝒪 T'] [IsScalarTower 𝒪 C T'] (φ : T →ₐ[C] T')
                (ψT : Onr →ₐ[𝒪] T) (hψT : ψT = (IsScalarTower.toAlgHom 𝒪 C T).comp ψ)
                (hψT' : (φ.restrictScalars 𝒪).comp ψT = (IsScalarTower.toAlgHom 𝒪 C T').comp ψ)
                (u : FakeEllipticCurve.WithFullLevel Λ N n T) (u' : FakeEllipticCurve.WithFullLevel Λ N n T')
                (ρ : FakeEllipticCurve.Rigidification r π A₀ ψT u.1)
                (ρ' : FakeEllipticCurve.Rigidification r π A₀ ((φ.restrictScalars 𝒪).comp ψT) u'.1)
                (g : u'.1.A ⟶ u.1.A) (hg : FakeEllipticCurve.IsPullbackVia (φ : T →+* T') u.1 u'.1 g)
                (hd : ρ.d = d) (hd' : ρ'.d = d) (h0 : algebraMap C T (algebraMap 𝒪 C π) = 0) (h0' : algebraMap C T' (algebraMap 𝒪 C π) = 0),
                (u'.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ (u.2.P).1 →
                FakeEllipticCurve.Rigidification.IsPullbackVia (φ.restrictScalars 𝒪) g hg ρ ρ' →
                  (ptX d T' ((φ.restrictScalars 𝒪).comp ψT) hψT' u' ρ' hd' h0').1 =
                    Spec.map (CommRingCat.ofHom (φ : T →+* T')) ≫ (ptX d T ψT hψT u ρ hd h0).1))
