    have hI : (CSS s).integers = (RSS s).integers := (hCSS s).integers_eq.trans (hRSS s).symm
    have hst' : ∀ f : ↥(fieldBar q M'), f ∈ (RSS s).integers ↔ ModularCurve.arithmeticGalois (xHFunctionField (q ^ 2 * M') (levelH q M')) τ • f ∈ (RSS s).integers := fun f => by
