              t r) ∈
          (Ideal.span
              {algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)
                  (TypeDensity.chartBase R t x t)})^(n+1) := by
        rw [← Prod.mk_sub_mk, map_sub, hD0, sub_zero]
        exact hab
      obtain ⟨r', -, ha', hb'⟩ := TypeDensity.cech_layer_step R t x hreg beta hregSwap d n _ _ har hbr hD'
      refine ⟨r + r', ?_, ?_⟩
      · convert ha' using 1; rw [map_add]; ring
      · convert hb' using 1; rw [map_add]; ring
  induction w using Submodule.Quotient.induction_on with
