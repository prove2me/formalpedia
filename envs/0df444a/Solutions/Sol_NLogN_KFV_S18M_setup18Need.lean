open IntMul RS

theorem exDgS_pos : ∀ e : Ex HS, 1 ≤ exDgS e
  | .reg _ | .lit _ => le_rfl
  | .add _ _ => by simp [exDgS]
  | .mul a _ => by have := exDgS_pos a; simp only [exDgS]; omega
  | .neg a | .pow2 a => exDgS_pos a
  | .ndiv a _ | .nmod a _ => by have := exDgS_pos a; simp only [exDgS]; omega
  | .sel c _ _ => by have := exDgS_pos c; simp only [exDgS]; omega
  | .shl _ _ | .quo _ _ | .rem _ _ => le_rfl

theorem pow_mono_A {A : ℕ} (hA : 2 ≤ A) {i j : ℕ} (h : i ≤ j) : (A : ℤ) ^ i ≤ (A : ℤ) ^ j :=
  pow_le_pow_right₀ (by exact_mod_cast (by omega : 1 ≤ A)) h

theorem exSmS_abs (A : ℕ) (s : IState HS) (hA : 2 ≤ A) :
    ∀ e : Ex HS, exSmS A s e → |e.eval s| ≤ (A : ℤ) ^ exDgS e
  | .reg i, h => by simp only [exSmS] at h; simpa [exDgS, Ex.eval] using h
  | .lit c, h => by simp only [exSmS] at h; simpa [exDgS, Ex.eval] using h
  | .add a b, h => by
    have ha := exSmS_abs A s hA a h.1
    have hb := exSmS_abs A s hA b h.2
    have h1 := pow_mono_A hA (le_max_left (exDgS a) (exDgS b))
    have h2 := pow_mono_A hA (le_max_right (exDgS a) (exDgS b))
    have hA' : (2 : ℤ) ≤ A := by exact_mod_cast hA
    have hp : (0 : ℤ) ≤ (A : ℤ) ^ max (exDgS a) (exDgS b) := by positivity
    simp only [exDgS, Ex.eval, pow_succ]
    calc |a.eval s + b.eval s| ≤ |a.eval s| + |b.eval s| := abs_add_le _ _
      _ ≤ _ := by nlinarith
  | .neg a, h => by simpa [exDgS, Ex.eval, abs_neg] using exSmS_abs A s hA a h
  | .mul a b, h => by
    simp only [exDgS, Ex.eval, pow_add, abs_mul]
    exact mul_le_mul (exSmS_abs A s hA a h.1) (exSmS_abs A s hA b h.2) (abs_nonneg _)
      (by positivity)
  | .ndiv a b, h => by
    simp only [exDgS, Ex.eval]
    calc |a.eval s / b.eval s| ≤ |a.eval s| := Int.abs_ediv_le_abs _ _
      _ ≤ _ := le_trans (exSmS_abs A s hA a h.1) (pow_mono_A hA (le_max_left _ _))
  | .nmod a b, h => by
    simp only [exDgS, Ex.eval]
    have hb := exSmS_abs A s hA b h.2.1
    have hpos := h.2.2
    rw [abs_of_nonneg (Int.emod_nonneg _ hpos.ne')]
    have := Int.emod_lt_of_pos (a.eval s) hpos
    have := le_abs_self (b.eval s)
    have := pow_mono_A hA (le_max_right (exDgS a) (exDgS b))
    linarith
  | .pow2 a, h => by
    simp only [exDgS, Ex.eval]
    rw [abs_of_nonneg (by positivity)]
    have : ((2 ^ (a.eval s).toNat : ℕ) : ℤ) ≤ A := by exact_mod_cast h.2.2
    push_cast at this
    have h1 := pow_mono_A hA (exDgS_pos a)
    simp only [pow_one] at h1
    linarith
  | .sel c x y, h => by
    simp only [exDgS, Ex.eval]
    split_ifs
    · exact le_trans (exSmS_abs A s hA x h.2.1)
        (pow_mono_A hA (le_trans (le_max_left _ _) (le_max_right _ _)))
    · exact le_trans (exSmS_abs A s hA y h.2.2)
        (pow_mono_A hA (le_trans (le_max_right _ _) (le_max_right _ _)))
  | .shl _ _, h | .quo _ _, h | .rem _ _, h => h.elim

theorem zsz_of_abs {z : ℤ} {A B k : ℕ} (h : |z| ≤ (A : ℤ) ^ k) (hB : A ^ k < 2 ^ B) : zsz z ≤ B :=
  zsz_le_of_natAbs_le (M := A ^ k) (by rw [Int.abs_eq_natAbs] at h; exact_mod_cast h) hB

theorem exSmS_zsz (A B : ℕ) (s : IState HS) (hA : 2 ≤ A) (e : Ex HS) (h : exSmS A s e)
    (hB : A ^ exDgS e < 2 ^ B) : zsz (e.eval s) ≤ B :=
  zsz_of_abs (exSmS_abs A s hA e h) hB

theorem exSmS_bnd (A B : ℕ) (s : IState HS) (hA : 2 ≤ A) :
    ∀ e : Ex HS, exSmS A s e → A ^ exDgS e < 2 ^ B → e.Bnd s B
  | .reg i, h, hB => exSmS_zsz A B s hA (.reg i) h hB
  | .lit c, h, hB => exSmS_zsz A B s hA (.lit c) h hB
  | .add a b, h, hB => by
    have h1 : A ^ exDgS a < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h2 : A ^ exDgS b < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    exact ⟨exSmS_bnd A B s hA a h.1 h1, exSmS_bnd A B s hA b h.2 h2,
      exSmS_zsz A B s hA (.add a b) h hB⟩
  | .mul a b, h, hB => by
    have h1 : A ^ exDgS a < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h2 : A ^ exDgS b < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    exact ⟨exSmS_bnd A B s hA a h.1 h1, exSmS_bnd A B s hA b h.2 h2,
      exSmS_zsz A B s hA (.mul a b) h hB⟩
  | .neg a, h, hB => exSmS_bnd A B s hA a h hB
  | .ndiv a b, h, hB => by
    have h1 : A ^ exDgS a < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h2 : A ^ exDgS b < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    exact ⟨exSmS_bnd A B s hA a h.1 h1, exSmS_bnd A B s hA b h.2.1 h2,
      exSmS_zsz A B s hA (.ndiv a b) h hB⟩
  | .nmod a b, h, hB => by
    have h1 : A ^ exDgS a < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h2 : A ^ exDgS b < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    exact ⟨exSmS_bnd A B s hA a h.1 h1, exSmS_bnd A B s hA b h.2.1 h2,
      exSmS_zsz A B s hA (.nmod a b) h hB⟩
  | .pow2 a, h, hB => by
    refine ⟨exSmS_bnd A B s hA a h.1 hB, ?_⟩
    have h1 : A ≤ A ^ exDgS a := by
      calc A = A ^ 1 := (pow_one A).symm
        _ ≤ _ := Nat.pow_le_pow_right (by omega) (exDgS_pos a)
    have : 2 ^ (a.eval s).toNat < 2 ^ B := lt_of_le_of_lt h.2.2 (lt_of_le_of_lt h1 hB)
    have := (Nat.pow_lt_pow_iff_right (by norm_num : 1 < 2) |>.1 this)
    omega
  | .sel c x y, h, hB => by
    have h1 : A ^ exDgS c < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h2 : A ^ exDgS x < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    have h3 : A ^ exDgS y < 2 ^ B :=
      lt_of_le_of_lt (Nat.pow_le_pow_right (by omega) (by simp only [exDgS]; omega)) hB
    refine ⟨exSmS_bnd A B s hA c h.1 h1, ?_⟩
    split_ifs
    · exact exSmS_bnd A B s hA x h.2.1 h2
    · exact exSmS_bnd A B s hA y h.2.2 h3
  | .shl _ _, h, _ | .quo _ _, h, _ | .rem _ _, h, _ => h.elim

end NLogN.KFM

