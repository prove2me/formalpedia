      rw [NLogN.zsz_one]; omega)
    have : NLogN.zsz (3 : ℤ) ≤ 2 := NLogN.zsz_le_of_abs (by norm_num)
    have := NLogN.splitCost_le k; have := NLogN.shlCost_le k
    simp only [NLogN.zsz_one] at *
    clear et eQ eQ' ht hQd hQ zl h1 h2 hd
    generalize NLogN.zsz (3 : ℤ) = z3 at *
    linarith
  have h1 := h1g s hT1 hT2 hDL
  set s1 := ((s.upd NLogN.T2 (.int Q :: L2)).upd NLogN.T3 (.int (Q * 2 ^ k : ℕ) :: s.G NLogN.T3)).upd NLogN.PW
    (.int Q :: s.G NLogN.PW) with hs1
  have h2 := NLogN.pow2_runs (I := I) pP hP Q s1 (s.G NLogN.PW) (by simp +decide [s1])
  have epow : (2 : ℤ) ^ Q * 2 ^ Q = 2 ^ (2 * Q) := by rw [two_mul, pow_add]
  have h3g : ∀ s' : NLogN.IState NLogN.NS, s'.G NLogN.PW = .int (2 ^ Q) :: s.G NLogN.PW →
      NLogN.IRuns I iprog (.seq (.op (.mv NLogN.PW NLogN.RQ)) (.seq (.op (.dup NLogN.RQ NLogN.T4)) (.seq (.op (.shl NLogN.T4 NLogN.RQ))
        (.op (.mv NLogN.T4 NLogN.DE))))) s'
        (((s'.upd NLogN.PW (s.G NLogN.PW)).upd NLogN.RQ (.int (2 ^ Q) :: s'.G NLogN.RQ)).upd NLogN.DE
          (.int (2 ^ (2 * Q)) :: s'.G NLogN.DE)) (2000 * (N + 3)) := by
    intro s' h
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, h, epow]
    refine ⟨by clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ Q)); have := NLogN.zsz_two_pow Q
    have := NLogN.moveIntCost_le (NLogN.zsz ((2 : ℤ) ^ (2 * Q))); have := NLogN.zsz_two_pow (2 * Q)
    have := NLogN.dupCost_le (NLogN.zsz ((2 : ℤ) ^ Q)); have := NLogN.shlCost_le Q
    omega
  have h3 := h3g (s1.upd NLogN.PW (.int (2 ^ Q) :: s.G NLogN.PW)) (by simp)
  refine (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 h3)).mono' ?_ ?_
  · simp only [hs1]; clear * -; ((apply NLogN.IState.ext' <;> intros <;> simp +decide only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · simp only [NLogN.pow2CostS]; omega
end
