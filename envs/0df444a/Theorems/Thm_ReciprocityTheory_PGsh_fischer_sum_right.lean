variable {ν : ℕ} {ι : Type*}

theorem ReciprocityTheory.PGsh.fischer_sum_right {α : Type*} (s : Finset α) (P : MvPolynomial (Fin ν × ι) ℂ)
    (f : α → MvPolynomial (Fin ν × ι) ℂ) :
    fischer P (∑ i ∈ s, f i) = ∑ i ∈ s, fischer P (f i) := by sorry
