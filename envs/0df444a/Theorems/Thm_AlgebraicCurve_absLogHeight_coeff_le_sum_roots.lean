-- title:
--   Height of coefficients bounded by heights of roots
-- statement:
--   Let $\iota$ be a type, $t \subseteq \iota$ a finite subset, $\alpha : \iota \to \overline{\mathbb{Q}}$ a family of elements of the algebraic closure of $\mathbb{Q}$, $m : \iota \to \mathbb{N}$ a family of multiplicities, and $n$ a natural number such that $\sum_{i \in t} m_i \le n$. Form the monic polynomial $f = \prod_{i \in t} (X - \alpha_i)^{m_i}$ over $\overline{\mathbb{Q}}$ and the tuple of its first $n+1$ coefficients, $k \mapsto \mathrm{coeff}_k f$ for $k \in \{0,\dots,n\}$. The assertion is the inequality $$\mathrm{absLogHeight}\big((\mathrm{coeff}_k f)_{k \le n}\big) \le \sum_{i \in t} m_i \cdot \mathrm{absLogHeight}\,(\alpha_i, 1) + n \log 2,$$ where for a finite family $x$ of elements of $\overline{\mathbb{Q}}$ the quantity $\mathrm{absLogHeight}\,x$ is defined as $[\,\mathbb{Q}(\mathrm{range}\,x) : \mathbb{Q}\,]^{-1}$ times the logarithmic height `Height.logHeight` of $x$ regarded as a family in the intermediate field $\mathbb{Q}(\mathrm{range}\,x)$ generated by its entries, and where $(\alpha_i, 1)$ denotes the two-entry tuple with entries $\alpha_i$ and $1$. No hypothesis is imposed on the $\alpha_i$ beyond being algebraic numbers; in particular they need not be distinct.
--
--   This is the standard comparison, in the direction 'coefficients bounded by roots', between the absolute logarithmic Weil height of the coefficient vector of a monic polynomial and the heights of its roots, the archimedean loss being the factor $2^n$ coming from Mahler measure. It is used in the height estimates for representatives on the modular curve $X_0(N)$, via [`ModularCurve.JZero.divNaiveHeight_le_baseMass_of_isRepOf`](thm.html#ModularCurve.JZero.divNaiveHeight_le_baseMass_of_isRepOf).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_absLogHeight_coeff_le_sum_roots.lean

import Definitions.Def_ModularCurve_JZeroHeightForm

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem AlgebraicCurve.absLogHeight_coeff_le_sum_roots {ι : Type*} (t : Finset ι)
    (α : ι → AlgebraicClosure ℚ) (m : ι → ℕ) {n : ℕ} (hdeg : ∑ i ∈ t, m i ≤ n) :
    absLogHeight (fun k : Fin (n + 1) =>
        (∏ i ∈ t, (Polynomial.X - Polynomial.C (α i)) ^ m i).coeff k)
      ≤ ∑ i ∈ t, (m i : ℝ) * absLogHeight ![α i, 1] + n * Real.log 2 := by sorry
