section Mono

variable {P : Scheme.{u}}

/-- A mono of étale objects is injective on geometric fibres. -/
theorem fib_injective_of_mono {D₁ D : P.Etale} (d : D₁ ⟶ D) [Mono d.left] (x : P) :
    Function.Injective ((geomPtAt x).point.fiber.map d) := fun b b' h => by
  have h1 : ((geomPtAt x).liftOf b).left ≫ d.left = ((geomPtAt x).liftOf b').left ≫ d.left :=
    congrArg (fun c => ((geomPtAt x).liftOf c).left) h
  exact fiber_ext _ ((cancel_mono d.left).1 h1)

end Mono

section Chart

variable {P : Scheme.{u}} {R : CommRingCat.{u}} (c : Spec R ⟶ P) [IsOpenImmersion c]
  (D : P.Etale) {V : D.left.Opens} (hV : IsAffineOpen V) (hVc : ∀ v ∈ V, D.hom v ∈ Set.range c)

include c hV hVc

theorem range_fromSpec_comp_sub : Set.range (hV.fromSpec ≫ D.hom) ⊆ Set.range c := by
  rintro _ ⟨y, rfl⟩
  rw [Scheme.Hom.comp_apply]
  have hy : hV.fromSpec y ∈ Set.range hV.fromSpec := ⟨y, rfl⟩
  rw [hV.range_fromSpec] at hy
  exact hVc _ hy

/-- The affine open `V` mapped into the chart. -/
def chartLift : Spec Γ(D.left, V) ⟶ Spec R :=
  IsOpenImmersion.lift c (hV.fromSpec ≫ D.hom) (range_fromSpec_comp_sub c D hV hVc)

theorem chartLift_fac : chartLift c D hV hVc ≫ c = hV.fromSpec ≫ D.hom :=
  IsOpenImmersion.lift_fac _ _ _

/-- The ring map `φ_V : R ⟶ Γ(V)`. -/
def chartRing : R ⟶ Γ(D.left, V) := Spec.preimage (chartLift c D hV hVc)

theorem spec_chartRing : Spec.map (chartRing c D hV hVc) = chartLift c D hV hVc := Spec.map_preimage _

instance etale_chartLift : Etale (chartLift c D hV hVc) := by
  have : Etale (chartLift c D hV hVc ≫ c) := by rw [chartLift_fac]; infer_instance
  exact Etale.of_comp _ c

theorem chartRing_etale : (chartRing c D hV hVc).hom.Etale := by
  have : Etale (Spec.map (chartRing c D hV hVc)) := by rw [spec_chartRing]; infer_instance
  exact (HasRingHomProperty.Spec_iff (P := @Etale)).1 this

theorem chartLift_apply (x : Spec Γ(D.left, V)) : c (chartLift c D hV hVc x) = D.hom (hV.fromSpec x) := by
  rw [← Scheme.Hom.comp_apply, chartLift_fac, Scheme.Hom.comp_apply]

end Chart

section A1

variable (k : Type u) [Field k]

/-- The closed point `X = a` of `A¹`. -/
def A1pt (a : k) : A1 k :=
  ⟨Ideal.span {X - C a}, (Ideal.span_singleton_prime (X_sub_C_ne_zero a)).2 (prime_X_sub_C a)⟩

theorem exists_X_sub_C_mem' [IsAlgClosed k] (p : Ideal k[X]) [hp : p.IsMaximal] :
    ∃ a : k, X - C a ∈ p := by
  obtain ⟨f, hf⟩ := Submodule.IsPrincipal.principal p
  have hf0 : f ≠ 0 := by
    rintro rfl
    have hbot : p = ⊥ := by rw [hf]; exact Submodule.span_singleton_eq_bot.mpr rfl
    exact (Ideal.bot_lt_of_maximal p (Polynomial.not_isField k)).ne' hbot
  have hprime : Prime f := (Ideal.span_singleton_prime hf0).mp (by
    have := hp.isPrime; rw [hf] at this; exact this)
  obtain ⟨a, ha⟩ := IsAlgClosed.exists_root f (degree_pos_of_irreducible hprime.irreducible).ne'
  refine ⟨a, ?_⟩
  have hmem : f ∈ p := by rw [hf]; exact Submodule.mem_span_singleton_self f
  obtain ⟨g, hg⟩ := dvd_iff_isRoot.mpr ha
  rcases hprime.irreducible.isUnit_or_isUnit hg with h | h
  · exact absurd h (Polynomial.not_isUnit_X_sub_C a)
  · have : X - C a = f * ((h.unit⁻¹ : k[X]ˣ) : k[X]) := by
      rw [hg, mul_assoc, IsUnit.mul_val_inv, mul_one]
    rw [this]
    exact p.mul_mem_right _ hmem

end A1

section D1

variable {k : Type u} [Field k] {P : Scheme.{u}} (c : A1 k ⟶ P) [IsOpenImmersion c]
  {D : P.Etale} {V : D.left.Opens} (hV : IsAffineOpen V) (hVc : ∀ v ∈ V, D.hom v ∈ Set.range c)
  (g : Γ(D.left, V))

/-- `Γ(V) ⟶ Γ(V)_g`. -/
abbrev locG : Γ(D.left, V) ⟶ CommRingCat.of (Localization.Away g) := CommRingCat.ofHom (algebraMap _ _)

include c hV hVc

/-- `k[X] ⟶ Γ(V)_g` through the chart. -/
def phiG : CommRingCat.of k[X] ⟶ CommRingCat.of (Localization.Away g) := chartRing c D hV hVc ≫ locG g

end D1

