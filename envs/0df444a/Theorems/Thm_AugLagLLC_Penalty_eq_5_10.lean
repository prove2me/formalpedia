-- url     : https://prove2.me/theorems/0c72a411-9e5c-4637-b152-ce731ad39101
-- title:
--   (5.10), proof of Theorem 5.4, p. 13 — if ρₖ → ∞ then ‖h₁(xₖ)‖∞ ≤ LM‖λₖ − λ_*‖∞/ρₖ for k large
-- statement:
--   Assume the hypotheses of Theorem 5.4 for problem (5.1): a sequence generated by Algorithm 3.1 with the safeguard of §5.1, with $x_k\to x_*$ feasible, linearly independent constraint gradients at $x_*$, $f,h_1,h_2$ twice continuously differentiable near $x_*$, the second-order sufficient condition with multipliers $\lambda_*,v_*$, $\lambda_*$ in the interior of the safeguard box, and tolerances with $\varepsilon_k\le\eta_k\|h_1(x_k)\|_\infty$ for a sequence $\eta_k\to0$. Suppose moreover that $\rho_k\to\infty$ (the hypothesis of the proof by contradiction). Then there is a constant $C>0$ such that
--   $$\|h_1(x_k)\|_\infty\le C\,\frac{\|\lambda_k-\lambda_*\|_\infty}{\rho_k}\quad\text{for } k \text{ large enough}. \tag{5.10}$$
--
--   On the page $C=LM$, with $L$ a local Lipschitz-type constant of $h_1$ at $x_*$ and $M$ the constant of Lemma 5.3. Together with the bound on $\|\lambda_k-\lambda_*\|_\infty$ it gives the one-step contraction of $\|h_1(x_k)\|_\infty$.
--
--   **Formalization Note** $\lambda_k$ is `P.lamNext x ρ lamBar (k - 1)`, i.e. $\bar\lambda_{k-1}+\rho_{k-1}h_1(x_{k-1})$; the eventual quantifier avoids $k=0$. The constants $L$, $M$ are existential in the proof, so $C$ is existential. The hypothesis $0<\tau$ of the goal theorem is not needed here and is not assumed.
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, p. 13, proof of Theorem 5.4, (5.10)

import Mathlib
import Definitions.Def_AugLagLLC_Penalty_SecondOrder

open Filter
open scoped Topology

namespace AugLagLLC.Penalty

/-- (5.10), proof of Theorem 5.4, p. 13: under the hypotheses of Theorem 5.4 and the
contradiction hypothesis `ρₖ → ∞`, there is `C > 0` (the page's `LM`) with
`‖h₁(xₖ)‖∞ ≤ C ‖λₖ − λ_*‖∞ / ρₖ` for `k` large, where `λₖ = P.lamNext x ρ lamBar (k - 1)`. -/
theorem eq_5_10
    {n m1 m2 : ℕ} (P : Problem n m1 0 m2 0) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin 0 → ℝ} {ε : ℕ → ℝ}
    (hpar : Problem.IsParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin 0 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin 0 → ℝ}
    -- Assumption 1: a run of Algorithm 3.1 on (5.1), with the safeguard Definition of §5.1
    (hrun : P.IsProjRun τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    {xs : EuclideanSpace ℝ (Fin n)} (hlim : Tendsto x atTop (𝓝 xs))
    -- Assumption 2
    (hfeas : xs ∈ P.Omega1 ∩ P.Omega2)
    -- Assumption 3
    (hLI : LinearIndependent ℝ
      (Sum.elim (fun i => gradient (P.h1 i) xs) (fun i => gradient (P.h2 i) xs)))
    -- Assumption 4
    (hC2 : P.IsC2At xs)
    -- Assumption 5
    (lamS : Fin m1 → ℝ) (vS : Fin m2 → ℝ) (hSOSC : P.SOSC0 lamS vS xs)
    -- Assumption 6
    (hbox : ∀ i, lamMin i < lamS i ∧ lamS i < lamMax i)
    (η : ℕ → ℝ) (hη : Tendsto η atTop (𝓝 0))
    (hεη : ∀ k, 1 ≤ k → ε k ≤ η k * ‖P.h1vec (x k)‖)
    -- the contradiction hypothesis of the proof
    (hρ : Tendsto ρ atTop atTop) :
    ∃ C : ℝ, 0 < C ∧ ∀ᶠ k in atTop,
      ‖P.h1vec (x k)‖ ≤ C * ‖P.lamNext x ρ lamBar (k - 1) - lamS‖ / ρ k := by sorry

end AugLagLLC.Penalty
