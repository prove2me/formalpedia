/-! # Real parameter families: joint `C^∞` calculus (ATLAS-IV-03)

Theorems only (no definitions). A *parameter family* of coordinate fields is a function
`Φ : ℝ → Pt n → ℝ`; its regularity is always stated for the uncurried map
`(ε, y) ↦ Φ ε y` on an open set `W ⊆ ℝ × ℝⁿ`, with the order `∞ = ((⊤ : ℕ∞) : WithTop ℕ∞)` of the pinned
Mathlib (not `ω`). Fixed-parameter smoothness in `y` is *not* assumed to imply joint smoothness.

* `pd_eq_fderiv_joint`: on `W`, the registered coordinate derivative `pd i (Φ ε) y` is the joint
  derivative applied to `(0, eᵢ)`; `contDiffOn_pd_joint`: it is jointly `C^∞` on `W`.
* `hasDerivAt_param_joint`: the parameter slice `ε ↦ Φ ε y` has the genuine derivative `D(ε,y)(1,0)`.
* **`hasDerivAt_pd_param`** (interchange): if `ψ y` is the genuine parameter derivative of `ε ↦ Φ ε y` at
  `ε₀` for every `y` of the open slice `{y | (ε₀, y) ∈ W}`, then `ε ↦ pd i (Φ ε) x` has derivative
  `pd i ψ x` at `ε₀`. Proof: symmetry of the second derivative of the jointly `C^∞` map (Mathlib's
  `ContDiffAt.isSymmSndFDerivAt`), not an assumed commutation.
* `contDiffOn_inv_joint`: a left inverse of a jointly `C^∞` matrix family is jointly `C^∞` (Cramer).
* `hasDerivAt_param_inv`: `∂_ε G^{ab} = -Σ_{c,d} G^{ac} (∂_ε g_{cd}) G^{db}`, from differentiating the
  true identity `G_ε g_ε = 1` (no independent `δG` survives). -/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

theorem differentiableAt_joint {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {p : ℝ × Pt n} (hp : p ∈ W) : DifferentiableAt ℝ φ p :=
  (hφ.contDiffAt (hW.mem_nhds hp)).differentiableAt (by simp)

/-- Coordinate slice of a jointly differentiable map. -/
theorem hasDerivAt_slice_joint {φ : ℝ × Pt n → ℝ} {p : ℝ × Pt n} (hd : DifferentiableAt ℝ φ p)
    (i : Fin n) :
    HasDerivAt (fun u : ℝ => φ (p.1, Function.update p.2 i u))
      (fderiv ℝ φ p ((0 : ℝ), (Pi.single i 1 : Pt n))) (p.2 i) := by
  have h1 : HasDerivAt (fun u : ℝ => (p.1, Function.update p.2 i u))
      ((0 : ℝ), (Pi.single i 1 : Pt n)) (p.2 i) :=
    (hasDerivAt_const _ p.1).prodMk (hasDerivAt_update p.2 i (p.2 i))
  have h2 : HasFDerivAt φ (fderiv ℝ φ p) (p.1, Function.update p.2 i (p.2 i)) := by
    rw [Function.update_eq_self]; exact hd.hasFDerivAt
  exact h2.comp_hasDerivAt (p.2 i) h1

/-- On `W`, `pd i (φ(ε, ·)) y = Dφ(ε, y)(0, eᵢ)`. -/
theorem pd_eq_fderiv_joint {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {ε : ℝ} {y : Pt n} (hy : (ε, y) ∈ W) (i : Fin n) :
    pd i (fun z => φ (ε, z)) y = fderiv ℝ φ (ε, y) ((0 : ℝ), (Pi.single i 1 : Pt n)) :=
  pd_eq_of_hasDerivAt (hasDerivAt_slice_joint (p := (ε, y)) (differentiableAt_joint hW hφ hy) i)

theorem contDiffOn_pd_joint_aux {φ : ℝ × Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) (i : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => pd i (fun z => φ (p.1, z)) p.2) W := by
  have hd : ContDiffOn ℝ ∞ (fun p => fderiv ℝ φ p ((0 : ℝ), (Pi.single i 1 : Pt n))) W :=
    (hφ.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
  refine hd.congr fun p hp => ?_
  have hp' : (p.1, p.2) ∈ W := hp
  exact pd_eq_fderiv_joint hW hφ hp' i

/-- Coordinate derivatives of a jointly `C^∞` family are jointly `C^∞`. -/
theorem contDiffOn_pd_joint {Φ : ℝ → Pt n → ℝ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => Φ p.1 p.2) W) (i : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => pd i (Φ p.1) p.2) W :=
  contDiffOn_pd_joint_aux hW hΦ i

