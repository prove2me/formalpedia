set_option backward.isDefEq.respectTransparency false

namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]









theorem ambientCechRestriction_refl (rank : V ↪ ℕ) (K : Complex V) (T : Finset V) :
    ambientCechRestriction k rank (Finset.Subset.refl K.faces) T = 𝟙 _ := by
  apply HomologicalComplex.hom_ext
  intro p
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  funext F
  change localizedFaceRestriction k (Finset.Subset.refl K.faces) F.1 (y F) = y F
  exact congrArg (fun g => g (y F)) (localizedFaceRestriction_refl k K F.1)

theorem ambientCechRestriction_comp (rank : V ↪ ℕ) {K L M : Complex V}
    (hKL : K.faces ⊆ L.faces) (hLM : L.faces ⊆ M.faces) (T : Finset V) :
    ambientCechRestriction k rank hLM T ≫ ambientCechRestriction k rank hKL T =
      ambientCechRestriction k rank (hKL.trans hLM) T := by
  apply HomologicalComplex.hom_ext
  intro p
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  funext F
  change localizedFaceRestriction k hKL F.1
      (localizedFaceRestriction k hLM F.1 (y F)) =
    localizedFaceRestriction k (hKL.trans hLM) F.1 (y F)
  exact congrArg (fun g => g (y F)) (localizedFaceRestriction_comp k hKL hLM F.1)

end LPCA


