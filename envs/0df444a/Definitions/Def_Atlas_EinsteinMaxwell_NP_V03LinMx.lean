attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin

/-! ### The four Maxwell source combinations (V-02's inline expressions, named) -/

section src
variable (g gi : Metric 4) (F : TwoForm 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (z : Pt 4)

/-- `(H(l,m̄,m) − θ^n(J))/2 + δ̄Φ₀ + (π − 2α)Φ₀ − κΦ₂` (NP Maxwell equation 1 for `(D − 2ρ)Φ₁`). -/
noncomputable def mxS1 : ℂ :=
  (Hfr F E 0 3 2 z - Jfr g gi F Θ 1 z) / 2 + fdir E 3 (FfrF F E 0 2) z
    + (npPi g gi E Θ z - 2 * npAlpha g gi E Θ z) * phi0 E z F - npKappa g gi E Θ z * phi2 E z F
/-- `(θ^{m̄}(J) + H(n,m,l))/2 + ΔΦ₀ + (μ − 2γ)Φ₀ − σΦ₂` (NP Maxwell equation 3 for `(δ − 2τ)Φ₁`). -/
noncomputable def mxS2 : ℂ :=
  (Jfr g gi F Θ 3 z + Hfr F E 1 2 0 z) / 2 + fdir E 1 (FfrF F E 0 2) z
    + (npMu g gi E Θ z - 2 * npGamma g gi E Θ z) * phi0 E z F - npSigma g gi E Θ z * phi2 E z F
/-- `δΦ₂ + νΦ₀ − (τ − 2β)Φ₂ − (H(n,m,m̄) − θ^l(J))/2` (NP Maxwell equation 4, negative branch). -/
noncomputable def mxS4 : ℂ :=
  fdir E 2 (FfrF F E 3 1) z + npNu g gi E Θ z * phi0 E z F
    - (npTau g gi E Θ z - 2 * npBeta g gi E Θ z) * phi2 E z F - (Hfr F E 1 2 3 z - Jfr g gi F Θ 0 z) / 2
/-- `DΦ₂ + λΦ₀ − (ρ − 2ε)Φ₂ − (θ^m(J) − H(l,n,m̄))/2` (NP Maxwell equation 2, negative branch). -/
noncomputable def mxS3 : ℂ :=
  fdir E 0 (FfrF F E 3 1) z + npLambda g gi E Θ z * phi0 E z F
    - (npRho g gi E Θ z - 2 * npEps g gi E Θ z) * phi2 E z F - (Jfr g gi F Θ 2 z - Hfr F E 0 1 3 z) / 2

end src

section srclin
variable (F f : TwoForm 4) (g gi h : Metric 4) (E Θ B : Fin 4 → Fin 4 → Pt 4 → ℂ) (z : Pt 4)

/-- First variation of `mxS1` at a background with `Φ₀ = Φ₂ = κ = 0` near `z` (explicit). -/
noncomputable def srcS1 : ℂ :=
  (HfrVar F f E B 0 3 2 z - JfrVar g gi F h f Θ B 1 z) / 2 + fdir E 3 (FfrFVar F f E B 0 2) z
    + (npPi g gi E Θ z - 2 * npAlpha g gi E Θ z) * FfrFVar F f E B 0 2 z
/-- First variation of `mxS2` at a background with `Φ₀ = Φ₂ = σ = 0` near `z` (explicit). -/
noncomputable def srcS2 : ℂ :=
  (JfrVar g gi F h f Θ B 3 z + HfrVar F f E B 1 2 0 z) / 2 + fdir E 1 (FfrFVar F f E B 0 2) z
    + (npMu g gi E Θ z - 2 * npGamma g gi E Θ z) * FfrFVar F f E B 0 2 z
/-- First variation of `mxS4` at a background with `Φ₀ = Φ₂ = ν = 0` near `z` (explicit). -/
noncomputable def srcS4 : ℂ :=
  fdir E 2 (FfrFVar F f E B 3 1) z - (npTau g gi E Θ z - 2 * npBeta g gi E Θ z) * FfrFVar F f E B 3 1 z
    - (HfrVar F f E B 1 2 3 z - JfrVar g gi F h f Θ B 0 z) / 2
/-- First variation of `mxS3` at a background with `Φ₀ = Φ₂ = λ = 0` near `z` (explicit). -/
noncomputable def srcS3 : ℂ :=
  fdir E 0 (FfrFVar F f E B 3 1) z - (npRho g gi E Θ z - 2 * npEps g gi E Θ z) * FfrFVar F f E B 3 1 z
    - (JfrVar g gi F h f Θ B 2 z - HfrVar F f E B 0 1 3 z) / 2

end srclin

