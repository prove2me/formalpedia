/-- The ambient real-linear rotation, not merely its quotient action. -/
def rotationLinear (c s : ℝ) : CV →L[ℝ] CV :=
  LinearMap.toContinuousLinearMap {
    toFun := rotation c s
    map_add' := by
      intro z w
      ext i
      fin_cases i <;> simp [rotation] <;> ring
    map_smul' := by
      intro r z
      simp only [RingHom.id_apply]
      rw [real_smul_complex, rotation_phase, ← real_smul_complex] }

def pathLinear (t : ℝ) : CV →L[ℝ] CV := rotationLinear (Real.cos (Real.pi*t)) (Real.sin (Real.pi*t))
lemma rotation_symplectic (c s : ℝ) (hcs : c^2+s^2 = 1) (u v : CV) :
    omega (rotation c s u) (rotation c s v) = omega u v := by
  simp [omega, rotation, Fin.sum_univ_succ, Complex.mul_im, Complex.mul_re]
  linear_combination
    (((u 1).re*(v 1).im-(u 1).im*(v 1).re + (u 2).re*(v 2).im-(u 2).im*(v 2).re +
      (u 3).re*(v 3).im-(u 3).im*(v 3).re + (u 4).re*(v 4).im-(u 4).im*(v 4).re))*hcs

lemma rotationPath_symplectic (t : ℝ) (u v : CV) :
    omega (rotationPath (t,u)) (rotationPath (t,v)) = omega u v :=
  rotation_symplectic _ _ (Real.cos_sq_add_sin_sq _) _ _

lemma rotationPath_pullback (t : ℝ) (u v : CV) :
    omega (rotationPath (t,u)) v = omega u (rotationPath (-t,v)) := by
  have h := rotationPath_symplectic t u (rotationPath (-t,v))
  simpa only [show rotationPath (t,rotationPath (-t,v)) = v by
    simpa only [neg_neg] using rotationPath_inverse (-t) v] using h

lemma rotationPath_comp_hasDerivAt {u : ℝ → CV} {u' : CV} {t : ℝ}
    (hu : HasDerivAt u u' t) :
    HasDerivAt (fun s ↦ rotationPath (s,u s))
      (rotationGenerator (rotationPath (t,u t)) + rotationPath (t,u')) t := by
  have hF := (rotationPath_smooth.differentiable (by simp) (t,u t)).hasFDerivAt
  have ht := hF.comp_hasDerivAt t ((hasDerivAt_id t).prodMk (hasDerivAt_const t (u t)))
  have heT : fderiv ℝ rotationPath (t,u t) (1,0) = rotationGenerator (rotationPath (t,u t)) :=
    ht.unique (rotationPath_hasDerivAt t (u t))
  have hinc : HasFDerivAt (fun w : CV ↦ (t,w)) (ContinuousLinearMap.inr ℝ ℝ CV) (u t) :=
    (hasFDerivAt_const t (u t)).prodMk (hasFDerivAt_id (𝕜 := ℝ) (u t))
  have heS := (hF.comp (u t) hinc).unique ((pathLinear t).hasFDerivAt (x := u t))
  have heV : fderiv ℝ rotationPath (t,u t) (0,u') = rotationPath (t,u') :=
    congrArg (fun L : CV →L[ℝ] CV ↦ L u') heS
  convert! hF.comp_hasDerivAt t ((hasDerivAt_id t).prodMk hu) using 1
  rw [show ((1:ℝ),u') = (1,0) + (0,u') by ext <;> simp, map_add, heT, heV]

end ArnoldCounterexample.Quadric

namespace ArnoldCounterexample.Construction
open ArnoldCounterexample.Quadric ArnoldCounterexample.Field
open scoped ContDiff Topology

def forward (p : ℝ × CV) : CV := rotationPath (p.1,forwardMid p)
def backward (p : ℝ × CV) : CV := backwardMid (p.1,rotationPath (-p.1,p.2))
def hamiltonian (p : ℝ × CV) : ℝ := rotationHamiltonian p.2 + midHamiltonian (p.1,rotationPath (-p.1,p.2))

lemma forward_smooth : ContDiff ℝ ∞ forward := rotationPath_smooth.comp (contDiff_fst.prodMk forwardMid_smooth)
lemma backward_smooth : ContDiff ℝ ∞ backward :=
  backwardMid_smooth.comp (contDiff_fst.prodMk (rotationPath_smooth.comp (contDiff_fst.neg.prodMk contDiff_snd)))
lemma hamiltonian_smooth : ContDiff ℝ ∞ hamiltonian :=
  (rotationHamiltonian_smooth.comp contDiff_snd).add
    (midHamiltonian_smooth.comp (contDiff_fst.prodMk
      (rotationPath_smooth.comp (contDiff_fst.neg.prodMk contDiff_snd))))

lemma forward_preserves (t : ℝ) (z : UnitQuadric) : IsUnitQuadric (forward (t,z)) :=
  rotationPath_preserves t ⟨forwardMid (t,z),forwardMid_preserves t z⟩
lemma backward_preserves (t : ℝ) (z : UnitQuadric) : IsUnitQuadric (backward (t,z)) :=
  backwardMid_preserves t ⟨rotationPath (-t,z),rotationPath_preserves (-t) z⟩
lemma forward_phase (p : ℝ × CV) (c : ℂ) (hc : Complex.normSq c = 1) :
    forward (p.1,c•p.2) = c • forward p := by
  simp only [forward, forwardMid_phase p c hc, rotationPath_phase]
lemma backward_phase (p : ℝ × CV) (c : ℂ) (hc : Complex.normSq c = 1) :
    backward (p.1,c•p.2) = c • backward p := by
  simp only [backward, rotationPath_phase, backwardMid_phase (p.1,rotationPath (-p.1,p.2)) c hc]
lemma hamiltonian_phase (p : ℝ × CV) (c : ℂ) (hc : Complex.normSq c = 1) :
    hamiltonian (p.1,c•p.2) = hamiltonian p := by
  simp only [hamiltonian, rotationHamiltonian_smul, hc, one_mul, rotationPath_phase,
    midHamiltonian_phase (p.1,rotationPath (-p.1,p.2)) c hc]
lemma backward_forward_full (p : ℝ × CV) : backward (p.1,forward p) = p.2 := by
  simp only [backward, forward, rotationPath_inverse, backward_forward]
lemma forward_backward_full (p : ℝ × CV) : forward (p.1,backward p) = p.2 := by
  simp only [forward, backward, forward_backward (p.1,rotationPath (-p.1,p.2))]
  simpa only [neg_neg] using rotationPath_inverse (-p.1) p.2
lemma forward_start (z : CV) : forward (0,z) = z := by simp only [forward, forwardMid_start, rotationPath_start]

def mainEquiv : Q3 ≃ Q3 := descendEquiv (fun z ↦ forward (1,z)) (fun z ↦ backward (1,z))
  (forward_preserves 1) (backward_preserves 1)
  (fun z c hc ↦ forward_phase (1,z) c hc) (fun z c hc ↦ backward_phase (1,z) c hc)
  (fun z ↦ backward_forward_full (1,z)) (fun z ↦ forward_backward_full (1,z))

lemma mainEquiv_project (z : UnitQuadric) : mainEquiv (project z) =
    project ⟨forward (1,z),forward_preserves 1 z⟩ :=
  descend_project (fun z ↦ forward (1,z)) (forward_preserves 1)
    (fun z c hc ↦ forward_phase (1,z) c hc) z

lemma forward_equation (t : ℝ) (z : UnitQuadric) (v : CV) :
    omega (deriv (fun s ↦ forward (s,z)) t) v =
      fderiv ℝ (fun w ↦ hamiltonian (t,w)) (forward (t,z)) v := by
  have hM : ContDiff ℝ ∞ (fun s ↦ forwardMid (s,z)) :=
    forwardMid_smooth.comp (contDiff_id.prodMk contDiff_const)
  have hd := rotationPath_comp_hasDerivAt ((hM.differentiable (by simp) t).hasDerivAt)
  change HasDerivAt (fun s ↦ forward (s,z)) _ t at hd
  rw [hd.deriv]
  have hK : ContDiff ℝ ∞ (fun w ↦ midHamiltonian (t,w)) :=
    midHamiltonian_smooth.comp (contDiff_const.prodMk contDiff_id)
  let y := forward (t,z)
  have hdK := (hK.differentiable (by simp) (pathLinear (-t) y)).hasFDerivAt.comp y
    (pathLinear (-t)).hasFDerivAt
  have hdH := (rotationHamiltonian_smooth.differentiable (by simp) y).hasFDerivAt.add hdK
  change HasFDerivAt (fun w ↦ hamiltonian (t,w)) _ y at hdH
  rw [hdH.fderiv]
  rw [← symplectic_apply, map_add, add_apply, symplectic_apply, symplectic_apply]
  change omega (rotationGenerator (rotationPath (t,forwardMid (t,z)))) v +
      omega (rotationPath (t,deriv (fun s ↦ forwardMid (s,z)) t)) v =
    fderiv ℝ rotationHamiltonian y v +
      fderiv ℝ (fun w ↦ midHamiltonian (t,w)) (pathLinear (-t) y) (pathLinear (-t) v)
  rw [rotationPath_pullback, mid_equation]
  have hback : pathLinear (-t) y = forwardMid (t,z) := rotationPath_inverse t _
  rw [hback]
  congr 1
  exact rotationHamiltonian_equation y v

/-- A complete smooth Hamiltonian path on the actual normalized Fubini--Study quadric. -/
def mainHamiltonianPath : HamiltonianPath mainEquiv where
  forward := forward
  backward := backward
  hamiltonian := hamiltonian
  forward_smooth := forward_smooth
  backward_smooth := backward_smooth
  hamiltonian_smooth := hamiltonian_smooth
  forward_preserves t _ z := forward_preserves t z
  backward_preserves t _ z := backward_preserves t z
  forward_phase t _ z c hc := forward_phase (t,z) c hc
  backward_phase t _ z c hc := backward_phase (t,z) c hc
  hamiltonian_phase t _ z c hc := hamiltonian_phase (t,z) c hc
  left_inverse t _ z := backward_forward_full (t,z)
  right_inverse t _ z := forward_backward_full (t,z)
  start z := forward_start z
  finish z := (mainEquiv_project z).symm
  equation t _ z v _ := forward_equation t z v

end ArnoldCounterexample.Construction

