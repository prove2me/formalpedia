-- title:
--   Section 3.5 — two-qubit example: the code corrects only the subalgebra generated by $1$ and $\bar X$
-- statement:
--   Let the code subspace of two qubits be spanned by $|\phi_+\rangle=\tfrac1{\sqrt2}(|00\rangle+|11\rangle)$ and $|\psi_+\rangle=\tfrac1{\sqrt2}(|01\rangle+|10\rangle)$, with logical operators $\bar X=|\psi_+\rangle\langle\phi_+|+|\phi_+\rangle\langle\psi_+|$ (exchanging the two states) and $\bar Z=|\phi_+\rangle\langle\phi_+|-|\psi_+\rangle\langle\psi_+|$. Then:
--   1. $\bar X$ and $\bar Z$ act within the code subspace;
--   2. $\bar X$ is realized on the first qubit by the bit flip $X_1=\sigma_x\otimes\mathbb 1$: $X_1|\tilde\psi\rangle=\bar X|\tilde\psi\rangle$ and $X_1^\dagger|\tilde\psi\rangle=\bar X^\dagger|\tilde\psi\rangle$ for every code state;
--   3. no operator $M\otimes\mathbb 1$ acting on the first qubit alone satisfies $(M\otimes\mathbb 1)|\tilde\psi\rangle=\bar Z|\tilde\psi\rangle$ for all code states, so $\bar Z$ cannot be realized on the first qubit;
--   4. every operator $O$ that acts within the code subspace and has a representation on the first qubit acts on the code subspace as $a\mathbb 1+b\bar X$ for some $a,b\in\mathbb C$, i.e. the code corrects only the subalgebra generated by $\mathbb 1$ and $\bar X$;
--   5. $\bar X$ is also realized on the second qubit, by $X_2=\mathbb 1\otimes\sigma_x$ (with the same two conditions).
--
--   The example shows that a code can protect a proper subalgebra of logical operators without correcting the erasure of a qubit, and that an abelian subalgebra (here generated by $\mathbb 1$ and $\bar X$) can be represented on either of two complementary subsystems. This is the situation operator-algebra quantum error correction is designed to describe.
-- source:
--   A. Almheiri, X. Dong, D. Harlow, Bulk Locality and Quantum Error Correction in AdS/CFT, JHEP 04 (2015) 163, https://arxiv.org/abs/1411.7041v3, Section 3.5, paragraph 'For example in the two qubit system, consider a code subspace spanned by ...' and the following paragraph ('the encoded 1 and X operators can be realized on either of the two qubits')

import Mathlib
import Definitions.Def_ADH2015_defs

open Matrix
open scoped Kronecker

namespace ADH2015

theorem twoQubit_example :
    ActsWithin twoQubitCode logicalX ∧ ActsWithin twoQubitCode logicalZ ∧
    (∀ v ∈ twoQubitCode,
      (pauliX ⊗ₖ (1 : Matrix Qubit Qubit ℂ)) *ᵥ v = logicalX *ᵥ v ∧
      (pauliX ⊗ₖ (1 : Matrix Qubit Qubit ℂ))ᴴ *ᵥ v = logicalXᴴ *ᵥ v) ∧
    (¬ ∃ M : Matrix Qubit Qubit ℂ, ∀ v ∈ twoQubitCode,
      (M ⊗ₖ (1 : Matrix Qubit Qubit ℂ)) *ᵥ v = logicalZ *ᵥ v) ∧
    (∀ O : Matrix (Qubit × Qubit) (Qubit × Qubit) ℂ, ActsWithin twoQubitCode O →
      HasRepOnE twoQubitCode O →
      ∃ a b : ℂ, ∀ v ∈ twoQubitCode, O *ᵥ v = a • v + b • (logicalX *ᵥ v)) ∧
    (∀ v ∈ twoQubitCode,
      ((1 : Matrix Qubit Qubit ℂ) ⊗ₖ pauliX) *ᵥ v = logicalX *ᵥ v ∧
      ((1 : Matrix Qubit Qubit ℂ) ⊗ₖ pauliX)ᴴ *ᵥ v = logicalXᴴ *ᵥ v) := by sorry

end ADH2015
