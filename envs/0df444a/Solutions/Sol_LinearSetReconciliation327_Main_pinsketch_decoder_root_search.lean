/-- Any polynomial-row footprint is inside the root-computation footprint. -/
theorem padeWritable_le_rootComputeWritable (R U D C TB cap addr : ℕ)
    (h : padeWritable R U D C cap addr) : rootComputeWritable R U D C TB cap addr := by
  dsimp [padeWritable] at h
  rcases h with h | h | h | h | h | h
  · exact rootComputeWritable.of_meta (rootComputeMeta.of_range h.1 h.2)
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · exact rootComputeWritable.of_R h.1 h.2
  · exact rootComputeWritable.of_U h.1 h.2
  · exact rootComputeWritable.of_D h.1 h.2
  · exact rootComputeWritable.of_C h.1 h.2

/-- The scratch area is part of the fixed metadata slots. -/
theorem padeScratch_le_rootComputeWritable (R U D C TB cap addr : ℕ) (h : padeScratch addr) :
    rootComputeWritable R U D C TB cap addr := by
  dsimp [padeScratch] at h
  rcases h with h | h | h | h | h | h
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])

theorem RootWorkspace.zero_readonly {R U D C TB ZB cap : ℕ} (h : RootWorkspace R U D C TB ZB cap)
    (i : ℕ) (hi : i < cap) : ¬ rootComputeWritable R U D C TB cap (ZB + i) := by
  have hz := h.Zlow
  have hR := h.ZR
  have hU := h.ZU
  have hD := h.ZD
  have hC := h.ZC
  have hT := h.ZT
  dsimp [rootComputeWritable, rootComputeMeta]
  omega

theorem RootWorkspace.node_zero_readonly {R U D C TB ZB cap QB T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hq : QB + T * cap ≤ ZB ∨ ZB + cap ≤ QB)
    (i : ℕ) (hi : i < cap) : ¬ rootNodeWritable R U D C TB cap QB T (ZB + i) := by
  have hz := h.Zlow
  have hzero := h.zero_readonly i hi
  intro hbad
  rcases hbad with h90 | hwork | hqueue
  · omega
  · exact hzero hwork
  · omega

theorem RootWorkspace.meta_readonly {R U D C TB ZB cap QB T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hQB : 128 ≤ QB)
    (slot : ℕ) (hs : slot < 128) (hslot : ¬ rootNodeMeta slot) :
    ¬ rootNodeWritable R U D C TB cap QB T slot := by
  have hR := h.rows.Rlow
  have hU := h.rows.Ulow
  have hD := h.rows.Dlow
  have hC := h.rows.Clow
  have hT := h.Tlow
  dsimp [rootNodeWritable, rootComputeWritable, rootNodeMeta, rootComputeMeta] at *
  omega

theorem RootWorkspace.copy_writable {R U D C TB ZB cap dst : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hd : dst = R ∨ dst = U ∨ dst = D ∨ dst = C ∨ dst = TB)
    (addr : ℕ) (ha : copyFromSlotsWritable dst cap addr) : rootComputeWritable R U D C TB cap addr := by
  dsimp [copyFromSlotsWritable] at ha
  rcases ha with h1 | h1 | h1 | h1
  · subst h1
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h1
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · subst h1
    exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
  · obtain ⟨hlo, hhi⟩ := h1
    rcases hd with h2 | h2 | h2 | h2 | h2
    · subst h2; exact rootComputeWritable.of_R hlo hhi
    · subst h2; exact rootComputeWritable.of_U hlo hhi
    · subst h2; exact rootComputeWritable.of_D hlo hhi
    · subst h2; exact rootComputeWritable.of_C hlo hhi
    · subst h2; exact rootComputeWritable.of_TB hlo hhi

theorem trace_writable_le_root (R U D C TB cap addr : ℕ) (h : traceLoopWritable R U D C TB cap addr) :
    rootComputeWritable R U D C TB cap addr := by
