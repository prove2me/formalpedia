set_option autoImplicit false

open AlgebraicCurve

private def torsionEquiv (K F : Type*) [Field K] [Field F] [Algebra K F] (n : ℕ) :
    Pic0.torsion K F n ≃ {c : Pic0 K F // n • c = 0} :=
  Equiv.subtypeEquivRight fun c => by rw [Pic0.mem_torsion, natCast_zsmul]

private theorem natCard_torsion_eq_of_charZero (K F : Type*) [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    [CharZero K]
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    (ℓ : ℕ) [Fact ℓ.Prime] : Nat.card (Pic0.torsion K F ℓ) = ℓ ^ (2 * genusFF K F) := by
  obtain ⟨x, hx, hxfd⟩ := hfg
  haveI : FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F := hxfd
  haveI : IsCurveOver K F := isCurveOver_of_isAlgClosed_of_transcendental x hx
  haveI : Algebra.EssFiniteType K F := essFiniteType_of_transcendental_of_finiteDimensional hx hxfd
  haveI : HasCanonicalDivisor (K := K) (F := F) := hasCanonicalDivisor_of_isCurveOver
  haveI : ∀ v : Place K F, v.DCoordGenerates := dCoordGenerates_of_isCurveOver
  have hRR : FunctionFieldRiemannRoch K F := functionFieldRiemannRoch_of_isAlgClosed_of_transcendental hx hxfd
  have hC : ConstantsAreBase K F := constantsAreBase_of_isAlgClosed_of_transcendental x hx
  have hWDA : WeilDualityAdelic K F :=
    weilDualityAdelic_of_functionFieldRiemannRoch_of_stichtenothGenusExists hRR
      (stichtenothGenusExists_of_isCurveOver hC)
  rw [Pic0.natCard_torsion_prime_eq_pow_genus K F ⟨x, hx, hxfd⟩ ℓ, genus_eq_genusFF hRR hWDA hC]

theorem solution
    (K F : Type*) [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    [IsCurveOver K F]
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : K) ≠ 0) :
    ℓ ^ (2 * genusFF K F) ≤ Nat.card (Pic0.torsion K F ℓ) := by
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  obtain ⟨L, _, _, _, A, e, F', _, _, _, he, hF', R, hR⟩ := exists_charZero_constantReduction_isGood K F hfg

  have hcount : Nat.card (Pic0.torsion L F' ℓ) = ℓ ^ (2 * genusFF L F') := natCard_torsion_eq_of_charZero L F' hF' ℓ

  obtain ⟨hgen, ⟨ψ⟩⟩ :=
    genusFF_eq_and_nonempty_pic0_addEquiv_of_algebraMap_eq_comp (IsLocalRing.ResidueField A) K F e he
  have hgood : genusFF (IsLocalRing.ResidueField A) F = genusFF L F' := R.isGood_iff.mp hR

  have hℓk : (ℓ : IsLocalRing.ResidueField A) ≠ 0 := by
    intro h
    apply hℓ
    have h' := congrArg e h
    rwa [map_natCast, map_zero] at h'

  have hmem : ∀ c : Pic0.torsion L F' ℓ, R.pic0Map c.1 ∈ Pic0.torsion (IsLocalRing.ResidueField A) F ℓ := fun c => by
    rw [Pic0.mem_torsion, ← map_zsmul, Pic0.mem_torsion.mp c.2, map_zero]
  have hinj : Function.Injective (fun c : Pic0.torsion L F' ℓ =>
      (⟨R.pic0Map c.1, hmem c⟩ : Pic0.torsion (IsLocalRing.ResidueField A) F ℓ)) := by
    intro a b hab
    have h1 : R.pic0Map (a.1 - b.1) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact congrArg Subtype.val hab
    have h2 : ℓ • (a.1 - b.1) = 0 :=
      (natCast_zsmul _ ℓ).symm.trans (Pic0.mem_torsion.mp (sub_mem a.2 b.2))
    have h3 := ConstantReduction.eq_zero_of_nsmul_eq_zero_of_pic0Map_eq_zero_of_isAlgClosed A F' hF' F R hR ℓ hℓk
      (a.1 - b.1) h2 h1
    exact Subtype.ext (sub_eq_zero.mp h3)

  let τ : Pic0.torsion (IsLocalRing.ResidueField A) F ℓ ≃ Pic0.torsion K F ℓ :=
    ψ.toEquiv.subtypeEquiv fun x => by
      rw [Pic0.mem_torsion, Pic0.mem_torsion]
      show ((ℓ : ℤ) • x = 0) ↔ ((ℓ : ℤ) • ψ x = 0)
      rw [← map_zsmul ψ, ψ.map_eq_zero_iff]
  obtain ⟨hfinK, -⟩ := Pic0.finite_and_card_torsion_le_of_natCast_ne_zero K F hfg ℓ hℓ0 hℓ
  haveI : Finite {c : Pic0 K F // ℓ • c = 0} := hfinK
  haveI : Finite (Pic0.torsion K F ℓ) := Finite.of_equiv _ (torsionEquiv K F ℓ).symm
  haveI : Finite (Pic0.torsion (IsLocalRing.ResidueField A) F ℓ) := Finite.of_equiv _ τ.symm
  calc ℓ ^ (2 * genusFF K F) = ℓ ^ (2 * genusFF L F') := by rw [← hgen, hgood]
    _ = Nat.card (Pic0.torsion L F' ℓ) := hcount.symm
    _ ≤ Nat.card (Pic0.torsion (IsLocalRing.ResidueField A) F ℓ) := Nat.card_le_card_of_injective _ hinj
    _ = Nat.card (Pic0.torsion K F ℓ) := Nat.card_congr τ

#print axioms solution

end S_AlgebraicCurve_Pic0_pow_two_mul_genusFF_le_natCard_torsion_prime_of_natCast_ne_zero
