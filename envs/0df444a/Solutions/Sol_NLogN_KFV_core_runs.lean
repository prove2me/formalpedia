theorem length_flatMap_blocks {α : Type*} {r : ℕ} (g : ℕ → List α) (hg : ∀ j, (g j).length = r) :
    ∀ N, ((List.range N).flatMap g).length = N * r
  | 0 => by simp
  | N + 1 => by
    rw [List.range_succ, List.flatMap_append, List.length_append, length_flatMap_blocks g hg N]
    simp [hg]; ring

theorem getD_flatMap_blocks {α : Type*} (d : α) {r : ℕ} (g : ℕ → List α) (hg : ∀ j, (g j).length = r) :
    ∀ (N j c : ℕ), j < N → c < r → ((List.range N).flatMap g).getD (j * r + c) d = (g j).getD c d
  | 0, j, c, hj, _ => absurd hj (Nat.not_lt_zero _)
  | N + 1, j, c, hj, hc => by
    have hlen : ((List.range N).flatMap g).length = N * r := length_flatMap_blocks g hg N
    rw [List.range_succ, List.flatMap_append]
    rcases Nat.lt_or_ge j N with h | h
    · rw [List.getD_append _ _ _ _ (by
        rw [hlen]
        have : (j + 1) * r ≤ N * r := Nat.mul_le_mul_right _ h
        rw [add_mul] at this; omega)]
      exact getD_flatMap_blocks d g hg N j c h hc
    · have hjN : j = N := by omega
      subst hjN
      rw [List.getD_append_right _ _ _ _ (by rw [hlen]; omega), hlen,
        show j * r + c - j * r = c by omega]
      simp

theorem getD_blk {r j i : ℕ} (hi : i < r) (z : List GI) :
    (NLogN.KFV.blk r j z).getD i 0 = z.getD (j * r + i) 0 := by
  simp only [NLogN.KFV.blk, List.getD_eq_getElem?_getD, List.getElem?_take, if_pos hi, List.getElem?_drop]

theorem getD_zipWith_ppq {r p : ℕ} {xf xg : List (Fin r → ℂ)} {j : ℕ} (hf : j < xf.length)
    (hg : j < xg.length) :
    (List.zipWith (ppq r p) xf xg).getD j 0 = ppq r p (xf.getD j 0) (xg.getD j 0) := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_zipWith, List.getElem?_eq_getElem hf,
    List.getElem?_eq_getElem hg, Option.map₂_some_some, Option.getD_some]

/-- **The Kronecker stage stores the pointwise products.** -/
theorem recRep_kmulN {r p ρ N : ℕ} (hr : r = 2 ^ ρ) {zf zg : List GI}
    {xf xg : List (Fin r → ℂ)} (hf : RecRep r p zf xf) (hg : RecRep r p zg xg)
    (hlf : xf.length = N) (hlg : xg.length = N) :
    RecRep r p (kmulN r p ρ N zf zg) (List.zipWith (ppq r p) xf xg) := by
  refine ⟨by rw [length_kmulN, List.length_zipWith, hlf, hlg, Nat.min_self], fun j c hj => ?_⟩
  rw [List.length_zipWith, hlf, hlg, Nat.min_self] at hj
  unfold kmulN
  rw [getD_flatMap_blocks 0 _ (fun j => length_kmul r p ρ _ _) N j c hj c.isLt,
    getD_zipWith_ppq (by omega) (by omega)]
  have := toC_kmul (p := p) hr (zx := NLogN.KFV.blk r j zf) (zy := NLogN.KFV.blk r j zg) (u := xf.getD j 0)
    (v := xg.getD j 0) (fun i => by rw [getD_blk i.isLt]; exact hf.2 j i (by omega))
    (fun i => by rw [getD_blk i.isLt]; exact hg.2 j i (by omega)) c
  exact this
end NLogN.KFV
