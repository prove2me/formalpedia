variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
theorem solution [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : AModel.Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (t : NLogN.IState NLogN.HS) (xs : List ℤ) (w : ℕ)
    (R L1 L2 L4 L14 : List NLogN.Item)
    (hlen : xs.length = AModel.vol sh) (hb : NLogN.Bnd w xs)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int (AModel.vol A) :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int (AModel.vol C) :: L4)
    (h14 : t.G 14 = NLogN.ints ((List.range (AModel.vol A)).map fun p => (NLogN.KIL.offs Λ c A p : ℤ)) ++ L14) :
    NLogN.IRuns I iprog NLogN.KFC.rotF t ((t.upd 0 (NLogN.ints (AModel.shiftArr Λ i 1 c 0 xs) ++ R)).upd 14 L14)
      (NLogN.KFC.cRotF (AModel.vol A) Q (AModel.vol C) w) := by
  rw [NLogN.KIL.shiftArr_eq_rot Λ i c hc A C hsh hA]
  exact NLogN.KFC.rotF_spec t xs (NLogN.KIL.offs Λ c A) (AModel.vol A) Q (AModel.vol C) w R L1 L2 L4 L14
    (fun p => (ZMod.val_lt _).le) (by rw [hlen, hsh, AModel.vol_append, AModel.vol_cons]; simp [AModel.vol]; ring)
    hb h0 h1 h2 h4 h14
end
