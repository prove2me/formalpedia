theorem ReciprocityTheory.ChartRestriction.DS.HW.tensKRep_op (ρ : KG ε →* unitary (Matrix ι ι ℂ)) (dρ : Matrix (Fin n) (Fin n) ℂ →ₗ[ℂ] Matrix ι ι ℂ)
