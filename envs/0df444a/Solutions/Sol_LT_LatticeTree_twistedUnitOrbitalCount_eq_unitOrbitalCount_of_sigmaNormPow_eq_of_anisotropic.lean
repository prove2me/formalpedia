private theorem not_lt_sup_of_le {ϖ : R} (hϖ : ϖ ≠ 0) {L : Submodule R (Fin 2 → K)}
    (hLlow : L ≤ latticeMap (scalarGL (unitOfNeZero (K := K) hϖ)) (stdLattice R K)) :
