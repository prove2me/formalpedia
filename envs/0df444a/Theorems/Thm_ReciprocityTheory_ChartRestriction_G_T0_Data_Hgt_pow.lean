theorem ReciprocityTheory.ChartRestriction.G.T0.Data.Hgt_pow (hd : d.AxH 𝒜) (h : d.S1) (G : WT) (f : ∀ c, A c)
    (hf : ∀ c, f c ∈ 𝒜 c G ∧ f c ≠ 0) (hI : d.IntOK G f) (n : ℕ) :
    (∀ c, (f ^ (n + 1)) c ∈ 𝒜 c ((n + 1) • G) ∧ (f ^ (n + 1)) c ≠ 0) ∧
      d.IntOK ((n + 1) • G) (f ^ (n + 1)) ∧
      d.Hgt h ((n + 1) • G) (f ^ (n + 1)) = ((n + 1 : ℕ) : ℝ) * d.Hgt h G f := by sorry
