-- Source module: Solutions.J6SegILSlab8
/-!
# B-line IL, B1 (streaming slab pass) §8: the slab passes of `axisPipe` on `GI` arrays

The three IL slab passes, on `gflat` arrays (`post` `GI` entries = `m = 2 post` integers per slab):

* **`slabId_runs`** (passes 3, 5: `h = fun _ z => z`; control `ctlOf n n' src (fun _ => 0)`),
* **`slabSc_runs`** (pass 1: `h = selH p P`; control `ctlOf n n' src (fun _ => 2^(P-p-1))`),
* **`slabOut_runs`** (pass 7: `h = outH p P s t α` on `zip Y Y₂`, source `some l`; control
  `ctlOf N N some argO` with `argO l = d̃_l` for `l < s`, else `0`; the two arrays on stacks
  `0` and `rZ`; constants `2^(P-p)`, `2^p` on `rK1`, `rK2`; multiplication `MulOK pM`).

Each takes the skeleton inputs (`rC` = `flatC cs ++ RC`, `rACC = []`, `rNB = pre`, `rNC = |cs|`,
`rM = 2 post`, `rTOT = pre · n' · 2 post`, the `rptX` counters empty) and leaves
`gflat (slabPass …) ++ l` on stack `0`, everything else unchanged. The cost is `passC …`;
with `passC_le` and `|cs| ≤ n + n'` (`length_ctlOf_le`) it is, per block,
`O((n + n' + 1) (post + 1) (cu + Ba + 1))` with `cu = O(Bu + 1)` (identity),
`O(Bu + P + 1)` (scale), `O(cU (Bu + Ba + 2) + P)` (output: one multiplication per entry).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFB (GI gflat)
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## The commands of `ctlOf` -/

theorem mem_ctlAux (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) {c : ℤ × ℤ} :
    ∀ (ls : List ℕ) (cur : ℕ), c ∈ (ctlAux src argOf ls cur).1 →
      c = dropC ∨ c = (0, 0) ∨ ∃ l ∈ ls, c = (1, argOf l)
  | [], cur, h => by simp +decide [ctlAux] at h
  | l :: ls, cur, h => by
    cases hs : src l with
    | none =>
      simp only [ctlAux, hs, List.mem_cons] at h
      rcases h with h | h
      · exact Or.inr (Or.inl h)
      · rcases mem_ctlAux src argOf ls cur h with h | h | ⟨l', hl', h⟩
        · exact Or.inl h
        · exact Or.inr (Or.inl h)
        · exact Or.inr (Or.inr ⟨l', List.mem_cons_of_mem _ hl', h⟩)
    | some k =>
      simp only [ctlAux, hs, List.mem_append, List.mem_cons] at h
      rcases h with h | h | h
      · exact Or.inl (List.eq_of_mem_replicate h)
      · exact Or.inr (Or.inr ⟨l, List.mem_cons_self, h⟩)
      · rcases mem_ctlAux src argOf ls k h with h | h | ⟨l', hl', h⟩
        · exact Or.inl h
        · exact Or.inr (Or.inl h)
        · exact Or.inr (Or.inr ⟨l', List.mem_cons_of_mem _ hl', h⟩)

theorem mem_ctlOf {n n' : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} {c : ℤ × ℤ}
    (h : c ∈ ctlOf n n' src argOf) :
    c = dropC ∨ c = (0, 0) ∨ ∃ l < n', c = (1, argOf l) := by
  unfold ctlOf at h
  rcases List.mem_append.1 h with h | h
  · rcases mem_ctlAux src argOf _ 0 h with h | h | ⟨l, hl, h⟩
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr ⟨l, List.mem_range.1 hl, h⟩)
  · exact Or.inl (List.eq_of_mem_replicate h)

theorem cmdsOK_ctlOf {n n' : ℕ} {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} {OkA : ℤ → Prop} {Ba : ℕ}
    (hBa : 1 ≤ Ba) (harg : ∀ l < n', zsz (argOf l) ≤ Ba ∧ OkA (argOf l)) :
    CmdsOK OkA Ba (ctlOf n n' src argOf) := by
  intro c hc
  rcases mem_ctlOf hc with rfl | rfl | ⟨l, hl, rfl⟩
  · refine ⟨?_, ?_, ?_⟩
    · show zsz (-1) ≤ Ba; rw [zsz_neg, zsz_one]; exact hBa
    · show zsz 0 ≤ Ba; rw [zsz_zero]; omega
    · intro h; exact absurd h (by decide)
  · refine ⟨?_, ?_, ?_⟩
    · show zsz 0 ≤ Ba; rw [zsz_zero]; omega
    · show zsz 0 ≤ Ba; rw [zsz_zero]; omega
    · intro h; exact absurd h (by decide)
  · exact ⟨by show zsz 1 ≤ Ba; rw [zsz_one]; exact hBa, (harg l hl).1, fun _ => (harg l hl).2⟩

/-! ## Flattening -/

theorem length_gflat (L : List GI) : (gflat L).length = 2 * L.length :=
  length_flatMap2 (fun z : GI => [z.1, z.2]) (fun _ => rfl) L

/-- The integer pass of a `GI` pass. -/
theorem gflat_slabPass {n n' post pre : ℕ} (hnp : 0 < n * post) (src : ℕ → Option ℕ)
    (h : ℕ → GI → GI) (h' : ℕ → ℤ → ℤ) (hh : ∀ l x, h l x = (h' l x.1, h' l x.2))
    (hd' : ∀ l, h' l 0 = 0) (L : List GI) (hL : L.length = pre * (n * post)) :
    gflat (slabPass n n' post src h L) = slabPass n n' (2 * post) src h' (gflat L) := by
  unfold gflat
  exact flat_slabPass (fun z : GI => [z.1, z.2]) (fun _ => rfl) rfl n n' post pre hnp src h
    (fun z : GI => [z.1, z.2]) (fun _ => rfl) h' (fun l x => by rw [hh]; rfl) rfl hd' L hL

section inst
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- **The identity slab pass (passes 3, 5).** -/
theorem slabId_runs (s : IState HS) (F : Fin HS → List ℤ) {n n' post pre : ℕ} (hnp : 0 < n * post)
    {src : ℕ → Option ℕ} (hs : MonoSrc n n' src) (L : List GI) (l : List ℤ)
    (hL : L.length = pre * (n * post)) {Bu : ℕ} (hBu : ∀ u ∈ gflat L, zsz u ≤ Bu)
    (hF0 : F 0 = gflat L ++ l) (hA : F lA = []) (hC : F lC = []) (hD : F lD = []) (RC : List ℤ)
    (hFC : F rC = flatC (ctlOf n n' src (fun _ => 0)) ++ RC) (hACC : F rACC = [])
    {LM : List ℤ} (hM : F rM = ((2 * post : ℕ) : ℤ) :: LM) {LN : List ℤ}
    (hN : F rNC = ((ctlOf n n' src (fun _ => 0)).length : ℤ) :: LN) {LB : List ℤ}
    (hB : F rNB = (pre : ℤ) :: LB) {LT : List ℤ}
    (hT : F rTOT = ((pre * (n' * (2 * post)) : ℕ) : ℤ) :: LT) :
    IRuns I iprog (passP (.op (.drop 0)) (.op (.mv 0 rT)) itI (.op (.mv rT 0))) (encK s F)
      (encK s (update F 0 (gflat (slabPass n n' post src (fun _ z => z) L) ++ l)))
      (passC pre (ctlOf n n' src (fun _ => 0)).length (2 * post) 1
        (2 * Bu + 2 + (2 * moveCost Bu + 19) + 300 * (Bu + 1) + (2 * moveCost Bu + 19))
        (pre * (n' * (2 * post))) Bu) := by
  have hnm : 0 < n * (2 * post) := by rw [show n * (2 * post) = 2 * (n * post) by ring]; omega
  have hxs : (gflat L).length = pre * (n * (2 * post)) := by rw [length_gflat, hL]; ring
  have hout : passOut (2 * post) (fun _ u => u) (ctlOf n n' src (fun _ => 0)) n pre (gflat L) =
      gflat (slabPass n n' post src (fun _ z => z) L) := by
    rw [passOut_eq (2 * post) (fun _ u => u) hs (fun _ => 0) pre hnm (gflat L) hxs,
      gflat_slabPass hnp src (fun _ z => z) (fun _ u => u) (fun _ _ => rfl) (fun _ => rfl) L hL]
  have hlen : (passOut (2 * post) (fun _ u => u) (ctlOf n n' src (fun _ => 0)) n pre
      (gflat L)).length = pre * (n' * (2 * post)) := by
    rw [passOut_eq (2 * post) (fun _ u => u) hs (fun _ => 0) pre hnm (gflat L) hxs,
      length_slabPass hnm hs _ hxs]
  have h := passZ_runs (I := I) (iprog := iprog) (unitsI Bu) s F (gflat L) l hF0
    (fun _ _ _ _ _ => trivial) hA hC hD (ctlOf n n' src (fun _ => 0)) RC hFC hACC hM hN
    (cmdsOK_ctlOf (Ba := 1) le_rfl (fun l _ => ⟨by rw [zsz_zero]; omega, trivial⟩)) n
    (VC_ctlOf hs _) (nDrop_ctlOf hs _) pre hB hxs hBu (by rw [hlen]; exact hT) (Bo := Bu)
    (by
      intro y hy
      rw [passOut_eq (2 * post) (fun _ u => u) hs (fun _ => 0) pre hnm (gflat L) hxs] at hy
      rcases mem_slabPass hnm hxs hy with rfl | ⟨l', x, hx, hyx⟩
      · show zsz 0 ≤ Bu; rw [zsz_zero]; omega
      · subst hyx; exact hBu _ hx)
  rw [hlen, hout] at h
  exact h

end inst

end J6Seg.Slab

