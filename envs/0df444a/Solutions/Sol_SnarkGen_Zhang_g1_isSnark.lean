private def checkAllQuints : Bool :=
  (List.finRange 5).all (fun k =>
    ((quintsList k).map Prod.fst == g1Wedges) &&
    (quintsList k).all (fun wq =>
      quintOk wq.1.1 wq.1.2.1 wq.1.2.2
        (refWedge k).1 (refWedge k).2.1 (refWedge k).2.2 wq.2))

private lemma checkAllQuints_eq_true : checkAllQuints = true := rfl

private lemma all_quints_ok (k : Fin 5) (w : Wedge34) (hw : w ∈ g1Wedges) :
    ∃ q : Quint34,
      quintOk w.1 w.2.1 w.2.2 (refWedge k).1 (refWedge k).2.1 (refWedge k).2.2 q = true := by
  have hk := List.all_eq_true.mp checkAllQuints_eq_true k (List.mem_finRange k)
  simp only [Bool.and_eq_true, beq_iff_eq] at hk
  have hw' : w ∈ (quintsList k).map Prod.fst := by rw [hk.1]; exact hw
  rcases List.mem_map.mp hw' with ⟨⟨w', q⟩, hmem, rfl⟩
  exact ⟨q, List.all_eq_true.mp hk.2 (w', q) hmem⟩

private lemma card_five_le_of_mem {α : Type*} [DecidableEq α] {S : Finset α}
    {e₀ e₁ e₂ e₃ e₄ : α}
    (h01 : e₀ ≠ e₁) (h02 : e₀ ≠ e₂) (h03 : e₀ ≠ e₃) (h04 : e₀ ≠ e₄)
    (h12 : e₁ ≠ e₂) (h13 : e₁ ≠ e₃) (h14 : e₁ ≠ e₄)
    (h23 : e₂ ≠ e₃) (h24 : e₂ ≠ e₄) (h34 : e₃ ≠ e₄)
    (m0 : e₀ ∈ S) (m1 : e₁ ∈ S) (m2 : e₂ ∈ S) (m3 : e₃ ∈ S) (m4 : e₄ ∈ S) : 5 ≤ S.card := by
  have hsub : ({e₀, e₁, e₂, e₃, e₄} : Finset α) ⊆ S := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl <;> assumption
  have hcard : ({e₀, e₁, e₂, e₃, e₄} : Finset α).card = 5 := by
    rw [Finset.card_insert_of_notMem, Finset.card_insert_of_notMem,
        Finset.card_insert_of_notMem, Finset.card_insert_of_notMem, Finset.card_singleton]
    · simp [h34]
    · simp [h23, h24]
    · simp [h12, h13, h14]
    · simp [h01, h02, h03, h04]
  linarith [Finset.card_le_card hsub]

private lemma reachable_of_walkValid (S : Finset (Sym2 (Fin 34))) :
    ∀ (a : Fin 34) (l : List (Fin 34)),
      walkValid a l = true →
      (∀ p ∈ walkPairs a l, s(p.1, p.2) ∉ S) →
      (g1.deleteEdges ↑S).Reachable a (walkEnd a l)
  | a, [], _, _ => SimpleGraph.Reachable.refl a
  | a, b :: l, hval, hdisj => by
    simp only [walkValid, Bool.and_eq_true] at hval
    have hadj : (g1.deleteEdges ↑S).Adj a b := by
      rw [SimpleGraph.deleteEdges_adj]
      exact ⟨adj_of_adjBool hval.1, fun hm => hdisj (a, b) List.mem_cons_self hm⟩
    exact hadj.reachable.trans (reachable_of_walkValid S b l hval.2
      (fun p hp => hdisj p (List.mem_cons_of_mem _ hp)))

private lemma reachable_of_pathOk (S : Finset (Sym2 (Fin 34)))
    {ua ub uc ra rb rc : Fin 34} {w : Path34}
    (hab : (g1.deleteEdges ↑S).Adj ua ub)
    (hbc : (g1.deleteEdges ↑S).Adj ub uc)
    (hrab : (g1.deleteEdges ↑S).Adj ra rb)
    (hrbc : (g1.deleteEdges ↑S).Adj rb rc)
    (hok : pathOk ua ub uc ra rb rc w = true)
    (hdisj : ∀ p ∈ pPairs w, s(p.1, p.2) ∉ S) :
    (g1.deleteEdges ↑S).Reachable ub rb := by
  simp only [pathOk, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at hok
  rcases hok with ⟨⟨hstart, hend⟩, hval⟩
  have h1 : (g1.deleteEdges ↑S).Reachable ub w.1 := by
    rcases hstart with (h | h) | h
    · rw [h]; exact hab.symm.reachable
    · rw [h]
    · rw [h]; exact hbc.reachable
  have h2 : (g1.deleteEdges ↑S).Reachable w.1 (walkEnd w.1 w.2) :=
    reachable_of_walkValid S w.1 w.2 hval hdisj
  have h3 : (g1.deleteEdges ↑S).Reachable (walkEnd w.1 w.2) rb := by
    rcases hend with (h | h) | h
    · rw [h]; exact hrab.reachable
    · rw [h]
    · rw [h]; exact hrbc.symm.reachable
  exact h1.trans (h2.trans h3)

private lemma ne_of_listDisj {l₁ l₂ : List (Fin 34 × Fin 34)} (h : listDisj l₁ l₂ = true)
    {p₁ p₂ : Fin 34 × Fin 34} (h1 : p₁ ∈ l₁) (h2 : p₂ ∈ l₂) : s(p₁.1, p₁.2) ≠ s(p₂.1, p₂.2) := by
  have h1' := List.all_eq_true.mp h p₁ h1
  have h2' := List.all_eq_true.mp h1' p₂ h2
  simp only [Bool.not_eq_true', sameEdge, Bool.or_eq_false_iff, Bool.and_eq_false_iff,
    beq_eq_false_iff_ne, ne_eq, ← Fin.ext_iff] at h2'
  intro heq
  rw [Sym2.eq_iff] at heq
  rcases heq with ⟨e1, e2⟩ | ⟨e1, e2⟩
  · cases h2'.1 <;> contradiction
  · cases h2'.2 <;> contradiction

private lemma reachable_of_quintOk (S : Finset (Sym2 (Fin 34))) (hS : S.card < 5)
    {ua ub uc ra rb rc : Fin 34} {q : Quint34}
    (hab : (g1.deleteEdges ↑S).Adj ua ub)
    (hbc : (g1.deleteEdges ↑S).Adj ub uc)
    (hrab : (g1.deleteEdges ↑S).Adj ra rb)
    (hrbc : (g1.deleteEdges ↑S).Adj rb rc)
    (hok : quintOk ua ub uc ra rb rc q = true) :
    (g1.deleteEdges ↑S).Reachable ub rb := by
  rcases q with ⟨w₀, w₁, w₂, w₃, w₄⟩
  simp only [quintOk, Bool.and_eq_true] at hok
  rcases hok with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hp0, hp1⟩, hp2⟩, hp3⟩, hp4⟩, d01⟩, d02⟩, d03⟩, d04⟩, d12⟩, d13⟩, d14⟩, d23⟩, d24⟩, d34⟩
  by_cases h0 : ∀ p ∈ pPairs w₀, s(p.1, p.2) ∉ S
  · exact reachable_of_pathOk S hab hbc hrab hrbc hp0 h0
  · by_cases h1 : ∀ p ∈ pPairs w₁, s(p.1, p.2) ∉ S
    · exact reachable_of_pathOk S hab hbc hrab hrbc hp1 h1
    · by_cases h2 : ∀ p ∈ pPairs w₂, s(p.1, p.2) ∉ S
      · exact reachable_of_pathOk S hab hbc hrab hrbc hp2 h2
      · by_cases h3 : ∀ p ∈ pPairs w₃, s(p.1, p.2) ∉ S
        · exact reachable_of_pathOk S hab hbc hrab hrbc hp3 h3
        · by_cases h4 : ∀ p ∈ pPairs w₄, s(p.1, p.2) ∉ S
          · exact reachable_of_pathOk S hab hbc hrab hrbc hp4 h4
          · simp only [not_forall, Classical.not_not] at h0 h1 h2 h3 h4
            rcases h0 with ⟨p₀, hp₀, m0⟩
            rcases h1 with ⟨p₁, hp₁, m1⟩
            rcases h2 with ⟨p₂, hp₂, m2⟩
            rcases h3 with ⟨p₃, hp₃, m3⟩
            rcases h4 with ⟨p₄, hp₄, m4⟩
            have := card_five_le_of_mem
              (ne_of_listDisj d01 hp₀ hp₁) (ne_of_listDisj d02 hp₀ hp₂) (ne_of_listDisj d03 hp₀ hp₃) (ne_of_listDisj d04 hp₀ hp₄)
              (ne_of_listDisj d12 hp₁ hp₂) (ne_of_listDisj d13 hp₁ hp₃) (ne_of_listDisj d14 hp₁ hp₄)
              (ne_of_listDisj d23 hp₂ hp₃) (ne_of_listDisj d24 hp₂ hp₄) (ne_of_listDisj d34 hp₃ hp₄)
              m0 m1 m2 m3 m4
            omega

private def refPairs (k : Fin 5) : List (Fin 34 × Fin 34) :=
  [((refWedge k).1, (refWedge k).2.1), ((refWedge k).2.1, (refWedge k).2.2)]

private def checkRefWedges : Bool :=
  (List.finRange 5).all (fun k =>
    adjBool (refWedge k).1 (refWedge k).2.1 && adjBool (refWedge k).2.1 (refWedge k).2.2) &&
  listDisj (refPairs 0) (refPairs 1) &&
  listDisj (refPairs 0) (refPairs 2) &&
  listDisj (refPairs 0) (refPairs 3) &&
  listDisj (refPairs 0) (refPairs 4) &&
  listDisj (refPairs 1) (refPairs 2) &&
  listDisj (refPairs 1) (refPairs 3) &&
  listDisj (refPairs 1) (refPairs 4) &&
  listDisj (refPairs 2) (refPairs 3) &&
  listDisj (refPairs 2) (refPairs 4) &&
  listDisj (refPairs 3) (refPairs 4)

private lemma checkRefWedges_eq_true : checkRefWedges = true := rfl

private lemma exists_refWedge_adj (S : Finset (Sym2 (Fin 34))) (hS : S.card < 5) :
    ∃ k : Fin 5,
      (g1.deleteEdges ↑S).Adj (refWedge k).1 (refWedge k).2.1 ∧
      (g1.deleteEdges ↑S).Adj (refWedge k).2.1 (refWedge k).2.2 := by
  have href := checkRefWedges_eq_true
  simp only [checkRefWedges, Bool.and_eq_true] at href
  rcases href with ⟨⟨⟨⟨⟨⟨⟨⟨⟨⟨hadj_all, d01⟩, d02⟩, d03⟩, d04⟩, d12⟩, d13⟩, d14⟩, d23⟩, d24⟩, d34⟩
  by_contra H
  simp only [not_exists, not_and_or] at H
  have hmem : ∀ k : Fin 5, ∃ p ∈ refPairs k, s(p.1, p.2) ∈ S := by
    intro k
    have hk_adj := List.all_eq_true.mp hadj_all k (List.mem_finRange k)
    simp only [Bool.and_eq_true] at hk_adj
    rcases H k with h1 | h2
    · rw [SimpleGraph.deleteEdges_adj] at h1
      have hs : s((refWedge k).1, (refWedge k).2.1) ∈ S := by
        by_contra hns; exact h1 ⟨adj_of_adjBool hk_adj.1, hns⟩
      exact ⟨_, List.mem_cons_self, hs⟩
    · rw [SimpleGraph.deleteEdges_adj] at h2
      have hs : s((refWedge k).2.1, (refWedge k).2.2) ∈ S := by
        by_contra hns; exact h2 ⟨adj_of_adjBool hk_adj.2, hns⟩
      exact ⟨_, List.mem_cons_of_mem _ List.mem_cons_self, hs⟩
  rcases hmem 0 with ⟨p₀, hp₀, m0⟩
  rcases hmem 1 with ⟨p₁, hp₁, m1⟩
  rcases hmem 2 with ⟨p₂, hp₂, m2⟩
  rcases hmem 3 with ⟨p₃, hp₃, m3⟩
  rcases hmem 4 with ⟨p₄, hp₄, m4⟩
  have := card_five_le_of_mem
    (ne_of_listDisj d01 hp₀ hp₁) (ne_of_listDisj d02 hp₀ hp₂) (ne_of_listDisj d03 hp₀ hp₃) (ne_of_listDisj d04 hp₀ hp₄)
    (ne_of_listDisj d12 hp₁ hp₂) (ne_of_listDisj d13 hp₁ hp₃) (ne_of_listDisj d14 hp₁ hp₄)
    (ne_of_listDisj d23 hp₂ hp₃) (ne_of_listDisj d24 hp₂ hp₄) (ne_of_listDisj d34 hp₃ hp₄)
    m0 m1 m2 m3 m4
  omega

private lemma exists_wedge_of_isCycle (S : Finset (Sym2 (Fin 34)))
    {v : Fin 34} {p : (g1.deleteEdges ↑S).Walk v v} (hp : p.IsCycle) :
    ∃ a b c : Fin 34,
      a.val < c.val ∧
      (g1.deleteEdges ↑S).Adj a b ∧
      (g1.deleteEdges ↑S).Adj b c ∧
      (g1.deleteEdges ↑S).Reachable v b := by
  have hlen : 3 ≤ p.length := hp.three_le_length
  have hnd : p.edges.Nodup := hp.edges_nodup
  cases p with
  | nil => simp at hlen
  | @cons _ u _ h1 p1 =>
    cases p1 with
    | nil => simp at hlen
    | @cons _ w _ h2 p2 =>
      simp only [SimpleGraph.Walk.edges_cons, List.nodup_cons, List.mem_cons] at hnd
      have hne_edge : s(v, u) ≠ s(u, w) := fun heq => hnd.1 (Or.inl heq)
      have hvw : v ≠ w := by
        intro h
        subst h
        exact hne_edge Sym2.eq_swap
      rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hvw) with hlt | hlt
      · exact ⟨v, u, w, hlt, h1, h2, h1.reachable⟩
      · exact ⟨w, u, v, hlt, h2.symm, h1.symm, h1.reachable⟩


private lemma g1_cyc5 : CyclicallyEdgeConnected g1 5 := by
  intro S _ hS c₁ c₂ ⟨v₁, hv₁, p₁, hp₁⟩ ⟨v₂, hv₂, p₂, hp₂⟩
  rcases exists_refWedge_adj S hS with ⟨k, hrab, hrbc⟩
  rcases exists_wedge_of_isCycle S hp₁ with ⟨a₁, b₁, c₁', hlt₁, hab₁, hbc₁, hvb₁⟩
  rcases exists_wedge_of_isCycle S hp₂ with ⟨a₂, b₂, c₂', hlt₂, hab₂, hbc₂, hvb₂⟩
  have hw₁ := mem_g1Wedges (SimpleGraph.deleteEdges_adj.mp hab₁).1
    (SimpleGraph.deleteEdges_adj.mp hbc₁).1 hlt₁
  have hw₂ := mem_g1Wedges (SimpleGraph.deleteEdges_adj.mp hab₂).1
    (SimpleGraph.deleteEdges_adj.mp hbc₂).1 hlt₂
  rcases all_quints_ok k (a₁, b₁, c₁') hw₁ with ⟨q₁, hq₁⟩
  rcases all_quints_ok k (a₂, b₂, c₂') hw₂ with ⟨q₂, hq₂⟩
  have hr₁ := hvb₁.trans (reachable_of_quintOk S hS hab₁ hbc₁ hrab hrbc hq₁)
  have hr₂ := hvb₂.trans (reachable_of_quintOk S hS hab₂ hbc₂ hrab hrbc hq₂)
  have hreach : (g1.deleteEdges ↑S).Reachable v₁ v₂ := hr₁.trans hr₂.symm
  rw [SimpleGraph.ConnectedComponent.mem_supp_iff] at hv₁ hv₂
  rw [← hv₁, ← hv₂, SimpleGraph.ConnectedComponent.eq]
  exact hreach

private lemma g1_cyc4 : CyclicallyEdgeConnected g1 4 := by
  intro S hS1 hS2
  exact g1_cyc5 S hS1 (by omega)

theorem solution : IsSnark g1 := by
  refine ⟨?_, g1_not_colourable, g1_cyc4, g1_five_le_egirth⟩
  intro v
  convert g1_isRegularOfDegree_three v
