noncomputable def nodeVL (K t S0 r k Bn : ℕ) : List (Fin HS × ℤ) :=
  [(NLogN.KFW.wF, ((mC ^ k : ℕ) : ℤ)), (NLogN.KFW.wB, (Bn : ℤ)), (wR0, ((S0 * r : ℕ) : ℤ)),
    (wL, ((Bn * 2 ^ t * S0 * r : ℕ) : ℤ)), (wV, ((2 * (Bn * (S0 * r * 2 ^ t)) : ℕ) : ℤ)),
