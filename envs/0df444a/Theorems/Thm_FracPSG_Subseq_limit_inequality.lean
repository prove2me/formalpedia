-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:09:21.465285+00:00
-- url     : https://prove2.me/theorems/e6a0c9be-38f7-4722-be4a-4a56354d3e0e
-- title:
--   Proof of Theorem 4.5(iii) — limit inequality at a cluster point of e-PSG
-- statement:
--   Under the hypotheses of Theorem 4.5, suppose in addition that $g$ is Lipschitz continuous around every point of $S$ and that $\liminf_{n\to+\infty}\tau_n\ge\bar\tau>0$. Let $\bar x$ be a cluster point of the sequence $(x_n)$ generated by Algorithm 1. Then there is $\bar g\in\partial_L g(\bar x)$ such that, for all $x\in S$,
--   $$f(x)-f(\bar x)\ \ge\ -\frac1{2\bar\tau}\|x-\bar x\|^2-\frac{f(\bar x)}{g(\bar x)}\langle\bar g,\bar x-x\rangle-\frac\ell2\|x-\bar x\|^2 .$$
--
--   The inequality says that $\bar x$ minimizes over $S$ a proximal model of $f-\frac{f(\bar x)}{g(\bar x)}\langle\bar g,\cdot\rangle$, from which lifted stationarity follows.
--
--   **Formalization Note** Written as $f(\bar x)+r\le f(x)$ in $(-\infty,+\infty]$; in particular it forces $f(\bar x)<+\infty$. The hypothesis $\liminf\tau_n\ge\bar\tau>0$ is written as: for every $\varepsilon>0$, eventually $\tau_n\ge\bar\tau-\varepsilon$; it covers the paper's choice $\bar\tau=\liminf\tau_n$. The Lipschitz hypothesis on $g$ is not on the page: it is a correction, needed for the subgradients $g_n$ to have a convergent subsequence (see Theorem 4.5(iii)); it holds automatically under the first alternative of Assumption 2.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 13, display after (20) in the proof of Theorem 4.5(iii)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Subseq_Basic
import Definitions.Def_FracPSG_Subseq_EPSG

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Subseq

open NonconvexSplitting.Shared

/-- The limit inequality in the proof of Theorem 4.5(iii) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 13,
display after (20)): if `liminf τₙ ≥ τ̄ > 0` (i.e. `τₙ ≥ τ̄ − ε` eventually, for every `ε > 0`;
the page takes `τ̄ = liminf τₙ`), then for every cluster point `x̄` of the iterates
there is `ḡ ∈ ∂_L g(x̄)` with, for all `x ∈ S`,
`f(x) − f(x̄) ≥ −(1/(2τ̄))‖x − x̄‖² − (f(x̄)/g(x̄))⟨ḡ, x̄ − x⟩ − (ℓ/2)‖x − x̄‖²`.

Correction to the page: `g` is assumed Lipschitz around every point of `S` (`hgLip`); without
it the subgradients `gₙ` need not have a convergent subsequence (see the mission's notes). -/
theorem limit_inequality
    {N : ℕ} {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {g : EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ μbar κbar : ℝ}
    {x gs : ℕ → EuclideanSpace ℝ (Fin N)} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : Assumption1 S fs fn ℓ) (hA2 : Assumption2 S g β)
    (hδ : 0 < δ) (hζ : 0 < ζ) (hβζ : 0 < 1 - Real.sqrt β * ζ) {m M : ℝ}
    (hpar : ParamsBC S (objF fs fn) g ℓ β δ ζ μbar κbar m M ∨ ParamsNoBC μbar κbar)
    (hrun : IsEPSGRun S fs fn g ℓ β δ ζ μbar κbar x gs τ κ μ)
    (hS0 : Bornology.IsBounded (S0 S (objF fs fn) g (x 0)))
    (hgLip : ∀ y ∈ S, ∃ K : NNReal, ∃ U ∈ 𝓝 y, LipschitzOnWith K g U)
    (τbar : ℝ) (hτbar : 0 < τbar) (hτ : ∀ ε > 0, ∀ᶠ n in atTop, τbar - ε ≤ τ n)
    (xbar : EuclideanSpace ℝ (Fin N)) (hxbar : MapClusterPt xbar atTop x) :
    ∃ gbar ∈ LimitingSubdiff (fun y => (g y : EReal)) xbar, ∀ y ∈ S,
      objF fs fn xbar +
          ((-(1 / (2 * τbar)) * ‖y - xbar‖ ^ 2
            - ratio (objF fs fn) g xbar * ⟪gbar, xbar - y⟫_ℝ
            - ℓ / 2 * ‖y - xbar‖ ^ 2 : ℝ) : EReal) ≤
        objF fs fn y := by sorry

end FracPSG.Subseq
