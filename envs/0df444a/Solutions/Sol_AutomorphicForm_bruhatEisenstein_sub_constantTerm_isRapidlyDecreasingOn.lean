section Uniform

open Matrix

private theorem continuous_coeGL : Continuous fun g : GL (Fin 2) ℝ => (g : Matrix (Fin 2) (Fin 2) ℝ) :=
  Units.continuous_val

private theorem continuous_botNormSq_GL : Continuous fun g : GL (Fin 2) ℝ => botNormSq (g : Matrix (Fin 2) (Fin 2) ℝ) := by
  unfold botNormSq
  exact ((continuous_coeGL.matrix_elem 1 0).pow 2).add ((continuous_coeGL.matrix_elem 1 1).pow 2)

private theorem continuous_det_GL : Continuous fun g : GL (Fin 2) ℝ => (g : Matrix (Fin 2) (Fin 2) ℝ).det :=
  continuous_coeGL.matrix_det

private theorem botNormSq_GL_ne_zero (g : GL (Fin 2) ℝ) : botNormSq (g : Matrix (Fin 2) (Fin 2) ℝ) ≠ 0 :=
  (botNormSq_pos (GeneralLinearGroup.det_ne_zero g)).ne'

private theorem continuous_foot_GL : Continuous fun g : GL (Fin 2) ℝ => foot (g : Matrix (Fin 2) (Fin 2) ℝ) := by
  unfold foot
  refine Continuous.div ?_ continuous_botNormSq_GL botNormSq_GL_ne_zero
  exact (((continuous_coeGL.matrix_elem 0 0).mul (continuous_coeGL.matrix_elem 1 0)).add
    ((continuous_coeGL.matrix_elem 0 1).mul (continuous_coeGL.matrix_elem 1 1))).neg

private theorem continuous_towerRatio_GL : Continuous fun g : GL (Fin 2) ℝ => towerRatio (g : Matrix (Fin 2) (Fin 2) ℝ) := by
  unfold towerRatio
  exact continuous_botNormSq_GL.div continuous_det_GL.abs
    fun g => abs_ne_zero.2 (GeneralLinearGroup.det_ne_zero g)

private theorem continuous_radFloor_GL : Continuous fun g : GL (Fin 2) ℝ => radFloor (g : Matrix (Fin 2) (Fin 2) ℝ) := by
  unfold radFloor
  refine Continuous.min ?_ (continuous_botNormSq_GL.div_const 2)
  refine Continuous.div ((continuous_det_GL.pow 2).div continuous_botNormSq_GL botNormSq_GL_ne_zero)
    (continuous_const.add (continuous_const.mul (continuous_foot_GL.pow 2))) fun g => ?_
  positivity

private theorem exists_uniform_bound {S : Set (GL (Fin 2) ℝ)} (hS : IsCompact S) (n : ℕ) {κ Cc β : ℝ}
    (hκ : 0 ≤ κ) (hCc : 0 ≤ Cc) (hβ : 0 ≤ β) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ g ∈ S, ∀ (Ψ c : ℝ → ℂ), ContDiff ℝ ∞ Ψ → ContDiff ℝ ∞ c →
      (∀ (j : ℕ) (t : ℝ), ‖iteratedDeriv j Ψ t‖ ≤ κ ^ j * ‖Ψ t‖) →
      (∀ j, j ≤ n → ∀ θ : ℝ, ‖iteratedDeriv j c θ‖ ≤ Cc) →
      ∀ M : ℝ, (∀ t, ‖Ψ t‖ ≤ M * Real.exp (-β * t)) →
      ∀ u : ℝ, ‖iteratedDeriv n (fun u => Ψ (Real.log (rad (g : Matrix (Fin 2) (Fin 2) ℝ) u))
          * c (angle (g : Matrix (Fin 2) (Fin 2) ℝ) u)) u‖ ≤ C * M * max 1 |u| ^ (-β) := by
  rcases S.eq_empty_or_nonempty with rfl | hne
  · exact ⟨0, le_rfl, fun g hg => (Set.notMem_empty g hg).elim⟩
  obtain ⟨g₁, -, h₁⟩ := hS.exists_isMaxOn hne continuous_towerRatio_GL.continuousOn
  obtain ⟨g₂, -, h₂⟩ := hS.exists_isMinOn hne continuous_radFloor_GL.continuousOn
  have hc₀ : 0 < radFloor (g₂ : Matrix (Fin 2) (Fin 2) ℝ) := radFloor_pos (GeneralLinearGroup.det_ne_zero g₂)
  have hd₀ : 0 ≤ (n ! : ℝ) * max 1 (towerRatio (g₁ : Matrix (Fin 2) (Fin 2) ℝ)) := by positivity
  refine ⟨kConst n κ Cc ((n ! : ℝ) * max 1 (towerRatio (g₁ : Matrix (Fin 2) (Fin 2) ℝ)))
      * Real.sqrt (radFloor (g₂ : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β),
    mul_nonneg (kConst_nonneg n hCc hd₀) (Real.rpow_nonneg (Real.sqrt_nonneg _) _),
    fun g hg Ψ c hΨ hc hΨd hcb M hM u => ?_⟩
  have hgdet : (g : Matrix (Fin 2) (Fin 2) ℝ).det ≠ 0 := GeneralLinearGroup.det_ne_zero g
  have hM0 : 0 ≤ M := by
    have h := (norm_nonneg _).trans (hM 0)
    simpa using h
  have hD : towerD (g : Matrix (Fin 2) (Fin 2) ℝ) n ≤ (n ! : ℝ) * max 1 (towerRatio (g₁ : Matrix (Fin 2) (Fin 2) ℝ)) := by
    unfold towerD
    exact mul_le_mul_of_nonneg_left (max_le_max le_rfl (isMaxOn_iff.1 h₁ g hg)) (by positivity)
  have hK := kConst_mono n (κ := κ) hCc (towerD_pos (g := (g : Matrix (Fin 2) (Fin 2) ℝ)) n).le hD
  have hsq : Real.sqrt (radFloor (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β)
      ≤ Real.sqrt (radFloor (g₂ : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β) :=
    Real.rpow_le_rpow_of_nonpos (Real.sqrt_pos.2 hc₀) (Real.sqrt_le_sqrt (isMinOn_iff.1 h₂ g hg)) (neg_nonpos.2 hβ)
  have hstep : kConst n κ Cc (towerD (g : Matrix (Fin 2) (Fin 2) ℝ) n)
        * Real.sqrt (radFloor (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β)
      ≤ kConst n κ Cc ((n ! : ℝ) * max 1 (towerRatio (g₁ : Matrix (Fin 2) (Fin 2) ℝ)))
        * Real.sqrt (radFloor (g₂ : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β) :=
    mul_le_mul hK hsq (Real.rpow_nonneg (Real.sqrt_nonneg _) _) (kConst_nonneg n hCc hd₀)
  calc ‖iteratedDeriv n (fun u => Ψ (Real.log (rad (g : Matrix (Fin 2) (Fin 2) ℝ) u))
          * c (angle (g : Matrix (Fin 2) (Fin 2) ℝ) u)) u‖
      ≤ kConst n κ Cc (towerD (g : Matrix (Fin 2) (Fin 2) ℝ) n)
          * Real.sqrt (radFloor (g : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β) * M * max 1 |u| ^ (-β) :=
        norm_iteratedDeriv_le hgdet hΨ hc hκ hΨd hcb hβ hM u
    _ ≤ kConst n κ Cc ((n ! : ℝ) * max 1 (towerRatio (g₁ : Matrix (Fin 2) (Fin 2) ℝ)))
          * Real.sqrt (radFloor (g₂ : Matrix (Fin 2) (Fin 2) ℝ)) ^ (-β) * M * max 1 |u| ^ (-β) :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hstep hM0)
          (Real.rpow_nonneg (zero_le_one.trans (le_max_left _ _)) _)

end Uniform
