* `sum_flat`: a double sum over `u < n`, `j < m` as one sum over `x < n m` (`x / m`, `x % m`).
* `sum_Hset`: the coupling-offset sum as a sum over `j < 2w + 1` with the test `hc`.
* `TsumI_range`, `TinvI_eq`, `capI_flat`, `ccOf_flat`: the forms the IL loops compute.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

open Finset

namespace J6Seg

theorem sum_flat {M : Type*} [AddCommMonoid M] (f : ℕ → ℕ → M) {m : ℕ} (hm : 0 < m) :
    ∀ n : ℕ, ∑ x ∈ range (n * m), f (x / m) (x % m) = ∑ u ∈ range n, ∑ j ∈ range m, f u j
  | 0 => by simp
  | n + 1 => by
    rw [Nat.succ_mul, Finset.sum_range_add, sum_flat f hm n, Finset.sum_range_succ]
    congr 1
    refine Finset.sum_congr rfl (fun j hj => ?_)
    have hj' : j < m := Finset.mem_range.mp hj
    congr 1
    · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt hj', zero_add]
    · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hj']

theorem sum_Hset {M : Type*} [AddCommMonoid M] (B : Blocks) (i : ℕ) (g : ℤ → M) :
    ∑ h ∈ Hset B i, g h = ∑ j ∈ range (2 * B.w + 1), if hcT B i j then g ((j : ℤ) - B.w) else 0 := by
  unfold Hset
  rw [Finset.sum_filter, Finset.sum_image (fun x _ y _ h => by simpa using h)]
  rfl

section tab
variable (P : ℕ) (T : Tables) (B : Blocks)

/-- **The capacitance entry as one flat sum.** -/
theorem capI_flat (a b : ℕ) :
    capI P T B a b = (if a = b then 2 ^ P else 0) + ∑ x ∈ range (B.len a * (2 * B.w + 1)),
      capG P T B a b (x / (2 * B.w + 1)) (x % (2 * B.w + 1)) := by
  unfold capI
  congr 1
  rw [sum_flat (capG P T B a b) (by omega), Finset.sum_Ico_eq_sum_range]
  simp only [Nat.add_sub_cancel_left]
  refine Finset.sum_congr rfl (fun u _ => ?_)
  rw [sum_Hset]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  unfold capG
  split_ifs <;> simp_all

end tab

end J6Seg

