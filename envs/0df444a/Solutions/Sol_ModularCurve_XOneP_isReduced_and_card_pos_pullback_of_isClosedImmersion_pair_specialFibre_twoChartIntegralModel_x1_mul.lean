      intro y hyx
      constructor
      · intro hy
        rcases hcover y with hy' | hy'
        · rw [r₁] at hy' ⊢
          exact specializes_iff_mem_closure.mp ((specializes_iff_mem_closure.mpr hy').trans hyx)
        · exfalso
          rw [r₂] at hy'
          have h2 : (pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base (i₂.base (genericPoint ↥C₂)) ⤳ (pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base y :=
            (specializes_iff_mem_closure.mpr hy').map (pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base.hom.continuous
