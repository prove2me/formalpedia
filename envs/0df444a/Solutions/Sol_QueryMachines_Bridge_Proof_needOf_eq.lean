    ceilMul (num (unary l, unary k)).1 (num (unary l, unary k)).2 (k ^ 2 * lam) + C₀ * k ^ 2 * Nat.size (k * (lam + B + 1)) + 2 := by
  simp only [needOf, length_unary]
