-- title:
--   Expected whole-horizon loss of Algorithm 3
-- statement:
--   Algorithm 3's expected incurred loss is
--
--   $$
--   \mathbb E\!\left[\sum_{t=1}^T\ell_{t,I_t}\right],
--   $$
--
--   evaluated over the finite tree generated by its history-dependent next-arm law.
-- source:
--   Zhang–Zhang–Luo–Mineiro, Near-Optimal First-Order Regret for Bandits with Feedback Graphs, arXiv:2610.40861, §2, p.3; Algorithm 3, p.15

import Mathlib
import Definitions.Def_FirstOrderFG_Supplement_Alg3_play
import Definitions.Def_FirstOrderFG_treeExp
import Definitions.Def_FirstOrderFG_pathLoss

set_option autoImplicit false

namespace FirstOrderFG.Supplement

/-- **Algorithm 3's whole-horizon expected incurred loss.**
Zhang–Zhang–Luo–Mineiro, arXiv:2610.40861, §2, p.3, and Algorithm 3, p.15.
The finite tree samples exactly the arm law after every possible history. -/
noncomputable def Alg3.expLoss {K : ℕ} (E : Fin K → Fin K → Prop) [DecidableRel E]
    (T : ℕ) (ℓ : ℕ → Fin K → ℝ) : ℝ :=
  FirstOrderFG.treeExp (Alg3.play E T ℓ) T [] (FirstOrderFG.pathLoss ℓ 1)

end FirstOrderFG.Supplement


