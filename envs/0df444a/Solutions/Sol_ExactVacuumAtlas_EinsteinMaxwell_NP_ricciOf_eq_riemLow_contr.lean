variable {g gi : Metric n} {U : Set (Pt n)}

theorem gi_symm (hm : MetricData g gi U) {x : Pt n} (hx : x ∈ U) (i j : Fin n) :
    gi i j x = gi j i x := by
  have h2 : metricMatrix g x * metricMatrix gi x = 1 := hm.mul_inv hx
  have h3 : (metricMatrix gi x)ᵀ * metricMatrix g x = 1 := by
    rw [← hm.transpose_eq hx, ← Matrix.transpose_mul, h2, Matrix.transpose_one]
  have h4 : (metricMatrix gi x)ᵀ = metricMatrix gi x := by
    calc (metricMatrix gi x)ᵀ = (metricMatrix gi x)ᵀ * (metricMatrix g x * metricMatrix gi x) := by
          rw [h2, Matrix.mul_one]
      _ = metricMatrix gi x := by rw [← Matrix.mul_assoc, h3, Matrix.one_mul]
  have := congrFun (congrFun h4 j) i
  simpa [Matrix.transpose_apply, metricMatrix] using this

theorem gi_g_apply (hm : MetricData g gi U) {x : Pt n} (hx : x ∈ U) (a b : Fin n) :
