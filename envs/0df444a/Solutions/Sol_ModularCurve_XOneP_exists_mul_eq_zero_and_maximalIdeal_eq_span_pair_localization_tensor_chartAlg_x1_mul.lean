    (S : Subalgebra A ↥K) (s : ↥K) (hs : s ∈ S) (hst : Function.Injective (Polynomial.aeval (R := A) s))
    (hS : ∀ b : ↥S, IsIntegral ↥(Algebra.adjoin A ({s} : Set ↥K)) (b : ↥K))
