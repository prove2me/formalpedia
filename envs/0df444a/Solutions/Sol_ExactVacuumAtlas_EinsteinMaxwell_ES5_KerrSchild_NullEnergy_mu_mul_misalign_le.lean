open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullEnergy
theorem solution (f m N w p a : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) :
    muCoeff f m N w p a x * misalign f m N w p a x k ≤ nullSOS f m N w p a x k := by
  have h0 : muCoeff f m N w p a x ≤ coeff0 f m N (x 1) := min_le_left _ _
  have h2 : muCoeff f m N w p a x ≤ coeff2 f m N w p a x :=
    (min_le_right _ _).trans (min_le_left _ _)
  have h4 : muCoeff f m N w p a x ≤ coeff4 f m N w p a x :=
    (min_le_right _ _).trans (min_le_right _ _)
  have e : nullSOS f m N w p a x k - muCoeff f m N w p a x * misalign f m N w p a x k =
      (coeff0 f m N (x 1) - muCoeff f m N w p a x) * resL f m N w p a x k ^ 2 +
        (coeff2 f m N w p a x - muCoeff f m N w p a x) * frameInv w x k 2 ^ 2 +
        (coeff4 f m N w p a x - muCoeff f m N w p a x) * frameInv w x k 4 ^ 2 := by
    simp only [nullSOS, misalign]; ring
  have : 0 ≤ nullSOS f m N w p a x k - muCoeff f m N w p a x * misalign f m N w p a x k := by
    rw [e]
    exact add_nonneg (add_nonneg (mul_nonneg (sub_nonneg.mpr h0) (sq_nonneg _))
      (mul_nonneg (sub_nonneg.mpr h2) (sq_nonneg _))) (mul_nonneg (sub_nonneg.mpr h4) (sq_nonneg _))
  linarith
