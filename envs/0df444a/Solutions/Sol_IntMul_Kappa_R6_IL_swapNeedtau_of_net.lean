/-!
# Round six, item language: the item-language Prop. 11 interface for a bit network

* `depH_le_log`, `depH_pow_le`: the recursion depth of `progH` is logarithmic; at the widths
  `m ^ k` it is `≤ cW k`.
* `ilCostR`, **`ILProp11 tab C q T₀ c₁ K₁ K₂`**: at every level `k` (width `m ^ k`), with the
  KIL5 calling convention `DescIn`, the procedure `tab 0` computes `progH C q (m ^ k)` on the bit
  stream at cost `⌈K₁ costH C (m^k) V + K₂ (m^k + 1)^c₁ (Bb + 2)²⌉`.
* `ilProp11_of_net` (in `R6ILProp`): the item-language Prop. 11 program for a round-six network.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## 1. The recursion depth of `progH` is logarithmic -/

section Depth

/-- At the widths `m ^ k` the depth is at most linear in `k`. -/
theorem depH_pow_le {m : ℕ} (hm : 2 ≤ m) :
    ∃ c : ℕ, 1 ≤ c ∧ ∀ k, Bit.depH m (m ^ k) ≤ c * k := by
  have hm2 : (2 : ℝ) ≤ m := by exact_mod_cast hm
  have hm1' : (0 : ℝ) < (m : ℝ) - 1 := by linarith
  have hm1 : (1 : ℝ) < (m : ℝ) / ((m : ℝ) - 1) := by
    rw [one_lt_div hm1']; linarith
  set lam := Real.log ((m : ℝ) / ((m : ℝ) - 1)) with hlam
  have hl0 : 0 < lam := Real.log_pos hm1
  refine ⟨⌈Real.log m / lam⌉₊ + 1, by omega, fun k => ?_⟩
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · rw [pow_zero, Bit.depH_of_not (by omega)]; simp
  · have h := depH_le_log hm (m ^ k) (Nat.one_le_pow _ _ (by omega))
    have hl : Real.log ((m ^ k : ℕ) : ℝ) = k * Real.log m := by
      push_cast; rw [Real.log_pow]
    rw [hl, mul_div_assoc] at h
    have hc : Real.log m / lam ≤ ⌈Real.log m / lam⌉₊ := Nat.le_ceil _
    have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
    have h3 : (k : ℝ) * (Real.log m / lam) ≤ k * ⌈Real.log m / lam⌉₊ :=
      mul_le_mul_of_nonneg_left hc (by positivity)
    have h4 : (Bit.depH m (m ^ k) : ℝ) ≤ ((⌈Real.log m / lam⌉₊ + 1) * k : ℕ) := by
      push_cast
      nlinarith
    exact_mod_cast h4

end Depth

/-! ## 2. The item-language Prop. 11 for a round-six network -/

end

end IntMul.Kappa.R6.IL

