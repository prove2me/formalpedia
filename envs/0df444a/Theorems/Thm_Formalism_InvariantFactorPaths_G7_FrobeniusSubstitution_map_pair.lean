theorem Formalism.InvariantFactorPaths.G7.FrobeniusSubstitution.map_pair {κ : Type} (σ : K →+* K) {u v : MvPowerSeries κ K}
    (h : MvPowerSeries.HasSubst ![u, v]) (H : MvPowerSeries (Fin 2) K) :
