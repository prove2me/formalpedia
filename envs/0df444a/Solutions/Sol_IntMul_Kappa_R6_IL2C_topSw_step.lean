/-- **A swap of two fields on the records.** -/
theorem swRec_runs {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) {P Mid S B u : ℕ} (hu : 1 ≤ u)
    (hP : 0 < P) (hMid : 0 < Mid) (hS : 0 < S) (hB : 0 < B) (I : List Sym) (t : IState HS)
    {recs : ℕ → List ℤ} (hlen : ∀ m, (recs m).length = B)
    (hb : KFL.Bits (flR recs (P * 2 ^ u * Mid * 2 ^ u * S))) (R0 : List Item)
    (h0 : t.G 0 = ints (flR recs (P * 2 ^ u * Mid * 2 ^ u * S)) ++ R0)
    (eP eG eS eU : Ex HS) (Bb : ℕ)
    (hBb : Bb ≤ zsz ((P * 2 ^ u * Mid * 2 ^ u * S * B : ℕ) : ℤ) + 3)
    (hsz : eP.size + eG.size + eS.size + eU.size ≤ 50)
    (nP : KFX.NoK eP) (nG : KFX.NoK eG) (nS : KFX.NoK eS) (nU : KFX.NoK eU)
    (E1 : ESp eP t Bb (P : ℤ)) (E2 : ESp eG t Bb (Mid : ℤ)) (E3 : ESp eS t Bb ((S * B : ℕ) : ℤ))
    (E4 : ESp eU t Bb (u : ℤ)) :
    ∃ c : ℕ, IRuns I tab (IL2.swE l12 eP eG eS eU) t
      (t.upd 0 (ints (flR (fun m => recs (swP (2 ^ u) (Mid * 2 ^ u * S) S m))
        (P * 2 ^ u * Mid * 2 ^ u * S)) ++ R0)) c ∧
      (c : ℝ) ≤ Ksw * (((P * 2 ^ u * Mid * 2 ^ u * S * B : ℕ) : ℝ) + 1) * (u : ℝ) ^ τ := by
  set zs := flR recs (P * 2 ^ u * Mid * 2 ^ u * S)
  set xs : List (ZMod 2) := zs.map fun z : ℤ => (Int.cast z : ZMod 2)
  have hx : enc2 xs = zs := KFL.bits_enc2 zs hb
  have hvol : vol (binShape [P] [Mid] [S * B] (2 ^ u)) = P * 2 ^ u * Mid * 2 ^ u * S * B := by
    simp [binShape, vol]; ring
  have hzl : zs.length = P * 2 ^ u * Mid * 2 ^ u * S * B := by
    rw [length_flR hlen]; try ring
  obtain ⟨c, Hc, hc⟩ := H u [P] [Mid] [S * B] hu (by intro a ha; simp at ha; omega) (by intro a ha; simp at ha; omega)
    (by intro a ha; simp at ha; subst ha; exact Nat.mul_pos hS hB) I t xs R0 (by rw [hx]; exact h0) (by simp [xs, hzl, hvol])
    eP eG eS eU Bb (by rw [hvol]; exact hBb) hsz nP nG nS nU
    (by simpa [vol] using E1) (by simpa [vol] using E2) (by simpa [vol] using E3) E4
  rw [hvol] at hc
  refine ⟨c, ?_, hc⟩
  rw [hx] at Hc
  have e3 : swapPos ([P] : Shape).length (([P] : Shape).length + 1 + ([Mid] : Shape).length) =
      swapPos 1 3 := rfl
  rw [e3, sw_flR hP hMid hS (by positivity : 0 < 2 ^ u) hB hlen] at Hc
  exact Hc

