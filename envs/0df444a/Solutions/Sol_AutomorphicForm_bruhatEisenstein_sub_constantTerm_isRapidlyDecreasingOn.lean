variable {E : Type*} [AddCommGroup E] [Module ℝ E]
variable {ι : Type*} [Fintype ι] (b : Module.Basis ι ℝ E)

private def torusMap : E →+ UnitAddTorus ι :=
  AddMonoidHom.mk' (fun x i => ((b.equivFun x i : ℝ) : UnitAddCircle)) fun x y => by
    funext i
    simp only [map_add, Pi.add_apply, AddCircle.coe_add]

private theorem torusMap_apply (x : E) (i : ι) : torusMap b x i = ((b.repr x i : ℝ) : UnitAddCircle) := rfl

private theorem torusMap_eq_zero_iff (x : E) : torusMap b x = 0 ↔ x ∈ Submodule.span ℤ (Set.range b) := by
  rw [Module.Basis.mem_span_iff_repr_mem ℤ b x, funext_iff]
  refine forall_congr' fun i => ?_
  rw [Pi.zero_apply, torusMap_apply, AddCircle.coe_eq_zero_iff]
  constructor
  · rintro ⟨n, hn⟩
    exact ⟨n, by rw [← hn, zsmul_eq_mul, mul_one]; rfl⟩
  · rintro ⟨n, hn⟩
    exact ⟨n, by rw [← hn, zsmul_eq_mul, mul_one]; rfl⟩

end TorusMapAlg

