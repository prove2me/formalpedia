-- title:
--   Proposition 4.19: Euler affine pairs with a generated zero grade
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g=\mathfrak g(\mathfrak s,V,\mathfrak z,\beta)$ be admissible in its structural presentation, where $\mathfrak s$ is a direct sum of simple hermitian algebras of tube type and $\mathfrak z=[V,V]$. For every ad-nilpotent $x$ with pointed $C_x$, there is an Euler derivation $D$ with
--
--   $$Dx=x,\qquad\mathfrak g_0(D)=[\mathfrak g_1(D),\mathfrak g_{-1}(D)].$$
--
--   Subspace brackets mean real linear spans of brackets. No preservation of the fixed complement is required. Tube type uses the verified equivalent nonzero three-grading condition on each simple hermitian factor.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 27, Proposition 4.19: Euler affine pairs with a generated zero grade

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Derivations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 4.19, PDF p. 27. No preservation of the fixed complement is asserted. -/
theorem euler_affine_pair_generated_zero_grade (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (hsemisimple : LieAlgebra.IsSemisimple ℝ P.L)
    (htube : ∀ I : LieIdeal ℝ P.L, LieAlgebra.IsSimple ℝ I →
      Hermitian (G := I) ∧ TubeType (G := I))
    (hz : (LieAlgebra.center ℝ G).toSubmodule = bracketSpan P.V P.V)
    (x : G) (hn : AdNilpotent x) (hp : Pointed (orbitCone x)) :
    ∃ D : LieDerivation ℝ G G, EulerLinear D.toLinearMap ∧ D x = x ∧
      grade D.toLinearMap 0 = bracketSpan (grade D.toLinearMap 1) (grade D.toLinearMap (-1)) := by sorry

end Derivations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
