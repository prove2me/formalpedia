section
variable (q : ℕ) [Fact q.Prime] (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
  (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ))

noncomputable def toA : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) →+* ↥A where
  toFun x := ⟨algebraMap ↥k₀ (AlgebraicClosure ℚ) (x : ↥k₀), x.2⟩
  map_one' := Subtype.ext (by simp)
  map_mul' a b := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' a b := Subtype.ext (by simp)

include hA in

theorem natCast_mem_maximalIdeal_comap :
    ((q : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
  rw [mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  have hu' := hu.map (toA A k₀)
  rw [map_natCast] at hu'
  have hqA : ((q : ℕ) : ↥A) ∈ maximalIdeal ↥A := by
    rw [← ValuationSubring.coe_mem_nonunits_iff]
    have : (((q : ℕ) : ↥A) : AlgebraicClosure ℚ) = (q : AlgebraicClosure ℚ) := by norm_cast
    rw [this]; exact hA
  exact (mem_maximalIdeal _).mp hqA hu'

include hA in

theorem isUnit_natCast_comap_of_coprime (n : ℕ) (hn : Nat.Coprime n q) :
    IsUnit ((n : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) := by
  by_contra hnu
  have hnm : ((n : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := (mem_maximalIdeal _).mpr hnu
  have hqm := natCast_mem_maximalIdeal_comap q A hA k₀
  obtain ⟨a, b, hab⟩ := (Nat.isCoprime_iff_coprime.mpr hn : IsCoprime (n : ℤ) (q : ℤ))
  have h1 : (1 : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) =
      (a : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) * (n : ℕ) + (b : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) * (q : ℕ) := by
    have := congrArg (Int.cast : ℤ → ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) hab
    push_cast at this
    exact this.symm
  apply (maximalIdeal.isMaximal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))).ne_top
  rw [Ideal.eq_top_iff_one, h1]
  exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hnm) (Ideal.mul_mem_left _ _ hqm)

include hA in

theorem isUnit_two_three_ell_M_comap (hq : 5 ≤ q) (ℓ' : ℕ) [Fact ℓ'.Prime] (hℓ'q : ℓ' ≠ q)
    (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M') :
    IsUnit ((2 : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∧
    IsUnit ((3 : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∧
    IsUnit ((ℓ' : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∧
    IsUnit ((M' : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) := by
  have hqp : q.Prime := Fact.out
  refine ⟨isUnit_natCast_comap_of_coprime q A hA k₀ 2 ?_, isUnit_natCast_comap_of_coprime q A hA k₀ 3 ?_,
    isUnit_natCast_comap_of_coprime q A hA k₀ ℓ' ?_, isUnit_natCast_comap_of_coprime q A hA k₀ M' ?_⟩
  · exact (Nat.coprime_primes Nat.prime_two hqp).mpr (by omega)
  · exact (Nat.coprime_primes Nat.prime_three hqp).mpr (by omega)
  · exact (Nat.coprime_primes (Fact.out : ℓ'.Prime) hqp).mpr hℓ'q
  · exact (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hqp).mpr hqM'))

include hA in

theorem charP_residueField_comap : CharP (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) q := by
  have h0 : ((q : ℕ) : ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) = 0 := by
    rw [← map_natCast (residue ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))), residue_eq_zero_iff]
    exact natCast_mem_maximalIdeal_comap q A hA k₀
  exact (CharP.charP_iff_prime_eq_zero (Fact.out : q.Prime)).mpr h0

end

