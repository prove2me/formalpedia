/-!
# B-line IL, the `J` kernel (B4), part 13: one real part

`partP`: from the row `v` (length `G`) on `V` and the table body
`flatT fs ++ flatB k bs ++ flatT cc` on `dTJ`, the forward loop, the backward loop, the cyclic
extension and the coupling window leave `W = Wl.reverse` with
`Wl = (range m).map (wF P cc (zext K (bwdS P bs (fA P fs v m) m).1))`; every other stack is as
before (`V` emptied), the table is restored from `TT` (`partP_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL NLogN.KFB Function Finset

theorem bnd_flatMap_mem {α : Type*} {B : ℕ} {l : List α} {g : α → List ℤ}
    (h : ∀ x ∈ l, Bnd B (g x)) : Bnd B (l.flatMap g) := by
  intro a ha
  obtain ⟨x, hx, hx'⟩ := List.mem_flatMap.1 ha
  exact h x hx a hx'

theorem bnd_flatT {B : ℕ} {l : List (List ℤ)} (h : ∀ r (hr : r < l.length), Bnd B l[r])
    (hl : ∀ r (hr : r < l.length), zsz (l[r].length : ℤ) ≤ B) : Bnd B (flatT l) := by
  apply bnd_flatMap_mem
  intro x hx
  obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
  intro a ha
  simp only [rowT, List.mem_cons] at ha
  rcases ha with rfl | ha
  · exact hl r hr
  · exact h r hr a ha

theorem zsz_lt_pow {n B : ℕ} (h : n < 2 ^ B) : zsz (n : ℤ) ≤ B := by
  apply zsz_le_of_lt; simpa using h

theorem jBody_bnd_sol_aux {P k K G Xb Bc Bx : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
    {cc : List (List ℤ)} {v : List ℤ} (hD : PartD P k K G Xb Bc fs bs cc v) (hBx : k + 1 ≤ Bx)
    (hc : Bc ≤ Bx) : Bnd Bx (jBody k fs bs cc) := by
  have hXk : Xb ≤ Bx := by have := hD.kB; omega
  have hm := hD.cnts
  have hlf : ∀ r (hr : r < fs.length), fs[r].length < 2 ^ Bc := fun r hr => by
    have := hD.wf r hr; omega
  have hlc : ∀ r (hr : r < cc.length), cc[r].length < 2 ^ Bc := fun r hr => by
    have := hD.wc r hr; omega
  have hB2 : 2 ^ Bc ≤ 2 ^ Bx := Nat.pow_le_pow_right (by norm_num) hc
  refine bnd_append (bnd_flatT (fun r hr => bnd_mono (hD.bf r hr) hXk)
    (fun r hr => zsz_lt_pow (by have := hlf r hr; omega)))
    (bnd_append ?_ (bnd_flatT (fun r hr => bnd_mono (hD.bc r hr) hXk)
      (fun r hr => zsz_lt_pow (by have := hlc r hr; omega))))
  apply bnd_flatMap_mem
  intro x hx
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hx
  have hD' := hD.bwd
  have hjt : j < (fA P fs v fs.length).length := by rw [← hD'.len]; exact hj
  have l1 : bs[j].1.length < 2 ^ Bc := by have := hD'.wb j hj; have := hD'.mB; omega
  have l2 : bs[j].2.1.length < 2 ^ Bc := by
    have := hD'.wz j hj
    have := bwdS_length2 P bs (fA P fs v fs.length) (j := j) hj.le hjt.le
    have := hD'.mB; omega
  have hiv : zsz (ivOf k bs[j].2.2.1) ≤ Bx := by
    rcases lt_or_eq_of_le (hD'.pv0 j hj) with h | h
    · apply zsz_le_of_lt
      have h0 := ivOf_nonneg k h; have h1 := ivOf_le k h
      have hn : (ivOf k bs[j].2.2.1).natAbs ≤ 2 ^ k := by
        have e := Int.natAbs_of_nonneg h0
        have : ((ivOf k bs[j].2.2.1).natAbs : ℤ) ≤ ((2 ^ k : ℕ) : ℤ) := by
          rw [e]; push_cast; exact h1
        exact_mod_cast this
      exact lt_of_le_of_lt hn (Nat.pow_lt_pow_right (by norm_num) (by omega))
    · rw [← h]; simp [ivOf, zsz_zero]
  have hfl : zsz bs[j].2.2.2 ≤ Bx := by
    rcases hD'.fl01 j hj with h | h <;> rw [h]
    · rw [zsz_zero]; omega
    · rw [zsz_one]; omega
  intro a ha
  simp only [recT, rowT, List.mem_append, List.mem_cons, List.mem_singleton,
    List.not_mem_nil, or_false] at ha
  rcases ha with (rfl | ha) | (rfl | ha) | rfl | rfl | rfl
  · exact zsz_lt_pow (by omega)
  · exact le_trans (hD'.bcb j hj a ha) hXk
  · exact zsz_lt_pow (by omega)
  · exact le_trans (hD'.bcz j hj a ha) hXk
  · exact le_trans (hD'.bpv j hj) hXk
  · exact hiv
  · exact hfl

end J6Seg.JK

end

