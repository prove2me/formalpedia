/-- The per-row constant of the chunk pass. -/
def cY (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) (ap : AxPlan6) : ℕ :=
  2 * 10 ^ 9 * (cBI P n src k ap + cBH P n src k ap + 2) + 2 * cYb P n src k ap + 10 ^ 4 + 2 +
