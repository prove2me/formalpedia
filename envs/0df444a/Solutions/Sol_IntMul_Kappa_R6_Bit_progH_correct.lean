namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

/-- The base case and the tail: `r` digit swaps at the start of the runs. -/
lemma tailSwaps_hd {P L : ℕ} {A B Cs : Shape} {e q a r : ℕ} (har : a + r ≤ e) {xs : List R}
    (hxs : xs.length = vol (P :: L :: hdShape A B Cs e q)) :
    tailSwaps (P :: L :: hdShape A B Cs e q) (A.length + 2 + a) (A.length + B.length + e + 2 + a)
      r xs =
    pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
      (blockSwap (A.length + 2 + a) (A.length + B.length + e + 2 + a) r) 0 xs := by
  refine tailSwaps_eq (by omega) (by rw [len_hd]; omega) (fun k hk => ?_) hxs
  rw [show A.length + 2 + a + k = A.length + 2 + (a + k) by omega,
    show A.length + B.length + e + 2 + a + k = A.length + B.length + e + 2 + (a + k) by omega,
    hd_digit_H _ _ _ _ _ _ _ _ (by omega), hd_digit_D _ _ _ _ _ _ _ _ (by omega)]

/-- **Generalized Prop. 11, denotation.** -/
theorem progH_correct_sol_aux (C : QHNet R W T m) {q : ℕ} (hq : 1 ≤ q) (hm : 2 ≤ m)
    (hOK : ∀ f, C.OK (q ^ f)) :
    ∀ (e P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ depH m e ∣ L →
      xs.length = vol (P :: L :: hdShape A B Cs e q) →
      progH C q e P L A B Cs xs =
        pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
          (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro P L A B Cs xs hL hxs
  rw [progH]
  split_ifs with he
  · set f := e / m with hfdef
    set r := e % m with hrdef
    have hf : 1 ≤ f := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
    have hdec : m * f + r = e := Nat.div_add_mod e m
    have hNz : NeZero (q ^ f) := ⟨by positivity⟩
    -- rows
    have hdep := depH_of_le he hm
    obtain ⟨L', rfl⟩ : W ∣ L := (dvd_pow_self W (by omega)).trans hL
    have hLW : W * L' / W = L' := Nat.mul_div_cancel_left L' (NeZero.pos W)
    have hL' : W ^ (depH m e - 1) ∣ L' := by
      rw [show depH m e = (depH m e - 1) + 1 by omega, pow_succ'] at hL
      exact Nat.dvd_of_mul_dvd_mul_left (NeZero.pos W) hL
    rw [hLW]
    set B' := List.replicate r q ++ B with hB'
    set C' := List.replicate r q ++ Cs with hC'
    have hshape : hdShape A B Cs e q = hdShape A B' C' (m * f) q := by
      rw [← hdec, hdShape_tail]
    have hvol : vol (P :: W * L' :: hdShape A B' C' m (q ^ f)) =
        vol (P :: W * L' :: hdShape A B Cs e q) := by
      rw [hshape, vol_cons, vol_cons, vol_cons, vol_cons, vol_hdShape_digits]
    -- the children
    have hch : ChildOKH (R := R) (m := m) (q ^ f) P L' A B' C'
        (fun ρ ys => if hρ : ρ.2.2 * f < e then
            progH C q (ρ.2.2 * f) P L' (A ++ List.replicate ρ.1 (q ^ f))
              (List.replicate (m - ρ.1 - ρ.2.2) (q ^ f) ++ (B' ++ List.replicate ρ.2.1 (q ^ f)))
              (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ f) ++ C') ys
          else ys) := by
      intro ρ hρ ys hys
      obtain ⟨i, j, w⟩ := ρ
      obtain ⟨hw0, hwm, hiw, hjw⟩ := hρ
      simp only at hw0 hwm hiw hjw ⊢
      have hlt : w * f < e := by nlinarith
      rw [dif_pos hlt]
      have hchild := hdShape_child A B' C' (N := q ^ f) hiw hjw
      rw [ih (w * f) hlt P L' _ _ _ ys
        ((pow_dvd_pow W (by have := depH_child hm he hwm; rw [← hfdef] at this; omega)).trans hL')
        (by rw [hys, vol_cons, vol_cons, vol_cons, vol_cons, ← vol_hdShape_digits, hchild]),
        ← field_digit, hchild]
      congr 2
      · simp; omega
      · simp; omega
    have hlev := levelH_correct C (q ^ f) P L' A B' C' (hOK f) hch (by rw [hvol]; exact hxs)
    rw [hlev, field_digit, ← hshape]
    -- the tail
    have hxs2 : (pull (P :: W * L' :: hdShape A B Cs e q) (P :: W * L' :: hdShape A B Cs e q)
        (blockSwap (A.length + 2) (A.length + B'.length + m * f + 2) (m * f)) 0 xs).length =
        vol (P :: W * L' :: hdShape A B Cs e q) := by simp
    have hBl : B'.length = r + B.length := by simp [hB']
    rw [tailSwaps_hd (a := m * f) (r := r) (by omega) hxs2,
      pull_comp _ _ (fun a ha => valid_blockSwap (by omega) (by rw [len_hd]; omega)
        (fun k hk => by
          rw [show A.length + 2 + m * f + k = A.length + 2 + (m * f + k) by omega,
            show A.length + B.length + e + 2 + m * f + k = A.length + B.length + e + 2 + (m * f + k)
              by omega, hd_digit_H _ _ _ _ _ _ _ _ (by omega),
            hd_digit_D _ _ _ _ _ _ _ _ (by omega)]) ha)]
    refine pull_congr (fun a ha => ?_) _ _
    rw [Function.comp_apply, hBl,
      show A.length + (r + B.length) + m * f + 2 = A.length + B.length + e + 2 by omega,
      blockSwap_split (by omega) (by rw [ha.length_eq, len_hd]; omega), hdec]
  · rw [show A.length + 2 = A.length + 2 + 0 by rfl,
      show A.length + B.length + e + 2 = A.length + B.length + e + 2 + 0 by rfl]
    exact tailSwaps_hd (by omega) hxs

end IntMul.Kappa.R6.Bit

end

theorem solution.{u_1} : type_of% @IntMul.Kappa.R6.Bit.progH_correct_sol_aux.{u_1} := @IntMul.Kappa.R6.Bit.progH_correct_sol_aux.{u_1}
