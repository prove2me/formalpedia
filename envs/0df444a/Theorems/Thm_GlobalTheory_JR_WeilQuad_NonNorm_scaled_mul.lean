theorem GlobalTheory.JR.WeilQuad.NonNorm.scaled_mul (A : Et F E) (O : Subring A.L) (t c : A.Kˣ) :
    {y : A.L | algebraMap A.K A.L (t : A.K) * y ∈ {y : A.L | ∃ z ∈ O, y = algebraMap A.K A.L (c : A.K) * z}} =
      {y : A.L | ∃ z ∈ O, y = algebraMap A.K A.L ((t⁻¹ * c : A.Kˣ) : A.K) * z} := by sorry
