/-! # Actual computation of the terminal reporting depth -/

namespace ThreeSum.LightSwitchDepth

open Light










variable {lim : Limits} {P : Program} {μ : ℕ→ℤ} {J d : ℕ}

theorem meets {p pDiv : ℕ} (hp : P[p]?=some (body pDiv))
    (hdiv : P[pDiv]?=some LightSmallDivide.body)
    (hword : (word J : ℤ) ≤ lim.word) (hd : d < lim.depth) :
    Meets lim P p d [J] μ (time J)
      (fun result ν => result=(depth J : ℤ) ∧ ν=μ) := by
  unfold word at hword
  apply Meets.of_body hp
  unfold body time
  have hc := LightSmallDivide.meets (d := d+1) (a := 13*J) (b := 20) hdiv μ hword
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (hc _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen hc ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, word,
                LightSmallDivide.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [word, LightSmallDivide.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, word,
                LightSmallDivide.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro result ν ⟨hresult, rfl⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (depth J) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, depth,
                word, LightSmallDivide.time, hresult]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [depth, word, LightSmallDivide.time, hresult] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, depth, word,
                LightSmallDivide.time, hresult] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  exact ⟨rfl,rfl⟩



theorem program_meets (hword : (word J : ℤ) ≤ lim.word) (hd : d < lim.depth) :
    Meets lim program 0 d [J] μ (time J)
      (fun result ν => result=(depth J : ℤ) ∧ ν=μ) := meets rfl rfl hword hd









end ThreeSum.LightSwitchDepth

