                Y.frame.toProj =
              pullback.fst Y.f (𝟙 (Spec (CommRingCat.of T))) ≫ P'.toProj) ↔
          J.map φ = ⊥) := by
  classical
  obtain ⟨Jpt, hJptfg, hpt⟩ :=
