open R6Chk
open Matrix Matrix.Module Module
variable {n bad : ℕ}

theorem R6Chk.entChk_sound (hbad : bad = BADf n) (hn : n ≤ 24) {kV nH H s : ℕ} (hnk : nH + kV = n)
    (hH : H < 2 ^ (32 * nH)) (hHr : ∀ i < nH, row H i < 2 ^ n)
    {SV : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (hmem : ∀ x, x ∈ SV ↔ ∀ i : Fin nH, vr n H i ⬝ᵥ x = 0) (hV : NondegF SV)
    (hVd : finrank (ZMod 2) SV = kV) (h : entChk bad kV nH H s = true) :
    spanP n (tk (nx s) (f32 s)) (f32 s) ≤ SV ∧
      finrank (ZMod 2) (spanP n (tk (nx s) (f32 s)) (f32 s)) = f32 s ∧
      NondegF (spanP n (tk (nx s) (f32 s)) (f32 s)) ∧
      (spanP n (tk (nx s) (f32 s)) (f32 s) = SV ∨
        ∃ w ∈ SV, w ⬝ᵥ w = 1 ∧ ∀ z ∈ spanP n (tk (nx s) (f32 s)) (f32 s), z ⬝ᵥ w = 0) := by sorry
