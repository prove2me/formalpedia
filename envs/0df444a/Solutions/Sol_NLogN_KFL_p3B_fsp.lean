-- Source module: Solutions.KFLCorr1
/-!
# KFL §12: the correction, pass 1 (extraction of the moved records)

The bit array `flR recs M` (record `m` = `recs m`, `B` bits) is on stack `0`, record `0` on top.
For `m = 0, …, M-1` the pass computes the key `κ m = keyR m` (`keyProg`), and moves the record
* to `sKB` (and pushes `κ m` on `sKK`) if `κ m ≠ m` (a *moved* record),
* to `sT` otherwise,
and pushes the flag `[κ m ≠ m]` on `sFL`; `rNB` counts the moved records.
`p1_fsp`: the whole pass, as the list state `P1 … M`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## Stacks and registers of the correction -/

/-! ## List helpers -/

theorem stkF_succ (p : ℕ → Bool) (F : ℕ → List ℤ) (k : ℕ) :
    stkF p F (k + 1) = (if p k then F k else []) ++ stkF p F k := by
  simp only [stkF, List.range_succ, List.reverse_append, List.reverse_singleton,
    List.singleton_append, List.filter_cons]
  split_ifs with h <;> simp

theorem stkK_succ (p : ℕ → Bool) (G : ℕ → ℤ) (k : ℕ) :
    stkK p G (k + 1) = (if p k then [G k] else []) ++ stkK p G k := by
  simp only [stkK, List.range_succ, List.reverse_append, List.reverse_singleton,
    List.singleton_append, List.filter_cons]
  split_ifs with h <;> simp

theorem restR_succ (recs : ℕ → List ℤ) {M k : ℕ} (hk : k < M) :
    restR recs M k = recs k ++ restR recs M (k + 1) := by
  unfold restR
  rw [List.drop_eq_getElem_cons (by simpa using hk)]
  simp

/-! ## The pass-1 state -/

section P1

variable (κ : ℕ → ℕ) (recs : ℕ → List ℤ) (M : ℕ)

theorem flL_succ (k : ℕ) : flL κ (k + 1) = flagV κ k :: flL κ k := by
  simp [flL, List.range_succ]

end P1

