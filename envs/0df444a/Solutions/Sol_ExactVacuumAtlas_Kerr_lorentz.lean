-- ==== segment from Atlas/Kerr/Domain.lean ====
/-!
# Kerr, Boyer–Lindquist coordinates: domain facts

Coordinates `(t, r, θ, φ) = (x 0, x 1, x 2, x 3)`; `Σ = r² + a² cos²θ`, `Δ = r² − 2Mr + a²`
(`KerrBL.Sig`, `KerrBL.Del`). The regular domain is `Σ ≠ 0`, `Δ ≠ 0`, `sin θ ≠ 0`, for every real
`M` and `a`. It contains both signs of `Δ`, negative `r` and the set `g_tt ≥ 0`; the only exclusions
are `Δ = 0` and `sin θ = 0` (where the chart matrix is singular) and `Σ = 0` (for `M ≠ 0` the ring
singularity, a genuine curvature singularity; here only a point set where the data are undefined).
No causal or global statement is made about any of these loci.
-/

open Real

namespace ExactVacuumAtlas.Kerr

theorem domBL_Sig {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) :
    KerrBL.Sig a (x 1) (cos (x 2)) ≠ 0 := hx.1

theorem domBL_Del {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : KerrBL.Del M a (x 1) ≠ 0 := hx.2.1

theorem domBL_sin {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : sin (x 2) ≠ 0 := hx.2.2

theorem Sig_nonneg (a r c : ℝ) : 0 ≤ KerrBL.Sig a r c := by
  unfold KerrBL.Sig; positivity

theorem domBL_Sig_pos {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) :
    0 < KerrBL.Sig a (x 1) (cos (x 2)) :=
  lt_of_le_of_ne (Sig_nonneg _ _ _) (domBL_Sig hx).symm

theorem domBL_sin_sq_pos {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : 0 < sin (x 2) ^ 2 := by
  have := domBL_sin hx; positivity

end ExactVacuumAtlas.Kerr

-- ==== segment from Atlas/Kerr/Frame.lean ====
/-!
# Kerr, Boyer–Lindquist: Lorentz signature on the whole regular domain

Let `P = r² + a²`. The unnormalised Carter-type frame
`T₀ = P ∂_t + a ∂_φ`, `T₁ = ∂_r`, `T₂ = ∂_θ`, `T₃ = a sin²θ ∂_t + ∂_φ`
(columns of `frameP`; `det frameP = P − a² sin²θ = Σ`) diagonalises the metric *without square
roots*: `Tᵀ g T = diag(−ΔΣ, Σ/Δ, Σ, Σ sin²θ)`. The three nontrivial identities are
`P² g_tt + 2aP g_tφ + a² g_φφ = −ΔΣ`, `a sin²θ · P · g_tt + (P + a² sin²θ) g_tφ + a g_φφ = 0` and
`a² sin⁴θ g_tt + 2a sin²θ g_tφ + g_φφ = Σ sin²θ`; they hold on `Σ ≠ 0` using `cos²θ = 1 − sin²θ`.

For `Δ > 0` the first entry is negative and the rest positive; for `Δ < 0` the roles of `T₀`
and `T₁` are swapped (`frameN`), since then `∂_r` is timelike and `T₀` spacelike. No part of `domBL`
(`Δ < 0`, `r < 0`, `g_tt ≥ 0`, `g_φφ ≤ 0`) is excluded. Normalisation by `1/√|dᵢ|`
happens once, in `isLorentzian_of_diag`.
-/

open Real

namespace ExactVacuumAtlas.Kerr

/-- The Boyer–Lindquist metric matrix at `x`, written out (`KerrBL.gKerr`, unchanged). -/
theorem metricMatrix_gKerr (M a : ℝ) (x : Pt 4) :
    metricMatrix (KerrBL.gKerr M a) x =
      !![(-1) + 2*M*(x 1)/KerrBL.Sig a (x 1) (cos (x 2)), 0, 0,
           (-2)*M*a*(x 1)*sin (x 2)^2/KerrBL.Sig a (x 1) (cos (x 2));
         0, KerrBL.Sig a (x 1) (cos (x 2))/KerrBL.Del M a (x 1), 0, 0;
         0, 0, KerrBL.Sig a (x 1) (cos (x 2)), 0;
         (-2)*M*a*(x 1)*sin (x 2)^2/KerrBL.Sig a (x 1) (cos (x 2)), 0, 0,
           sin (x 2)^2*(a^2 + (x 1)^2 + 2*M*(x 1)*a^2*sin (x 2)^2/KerrBL.Sig a (x 1) (cos (x 2)))] := by
  ext i j; fin_cases i <;> fin_cases j <;> rfl

theorem frameP_diag (M a : ℝ) (x : Pt 4) (hx : x ∈ domBL M a) :
    (frameP a x).transpose * metricMatrix (KerrBL.gKerr M a) x * frameP a x =
      Matrix.diagonal ![-(KerrBL.Del M a (x 1) * KerrBL.Sig a (x 1) (cos (x 2))),
        KerrBL.Sig a (x 1) (cos (x 2)) / KerrBL.Del M a (x 1),
        KerrBL.Sig a (x 1) (cos (x 2)),
        KerrBL.Sig a (x 1) (cos (x 2)) * sin (x 2) ^ 2] := by
  have hS := domBL_Sig hx; have hD := domBL_Del hx; have hs := domBL_sin hx
  have hc : cos (x 2) ^ 2 = 1 - sin (x 2) ^ 2 := cos_sq' (x 2)
  rw [metricMatrix_gKerr]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [frameP, Matrix.mul_apply, Fin.sum_univ_four, Matrix.diagonal]
  all_goals (try field_simp)
  all_goals (try simp only [KerrBL.Sig, KerrBL.Del, hc])
  all_goals ring

theorem frameN_diag (M a : ℝ) (x : Pt 4) (hx : x ∈ domBL M a) :
    (frameN a x).transpose * metricMatrix (KerrBL.gKerr M a) x * frameN a x =
      Matrix.diagonal ![KerrBL.Sig a (x 1) (cos (x 2)) / KerrBL.Del M a (x 1),
        -(KerrBL.Del M a (x 1) * KerrBL.Sig a (x 1) (cos (x 2))),
        KerrBL.Sig a (x 1) (cos (x 2)),
        KerrBL.Sig a (x 1) (cos (x 2)) * sin (x 2) ^ 2] := by
  have hS := domBL_Sig hx; have hD := domBL_Del hx; have hs := domBL_sin hx
  have hc : cos (x 2) ^ 2 = 1 - sin (x 2) ^ 2 := cos_sq' (x 2)
  rw [metricMatrix_gKerr]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [frameN, Matrix.mul_apply, Fin.sum_univ_four, Matrix.diagonal]
  all_goals (try field_simp)
  all_goals (try simp only [KerrBL.Sig, KerrBL.Del, hc])
  all_goals ring

end ExactVacuumAtlas.Kerr

