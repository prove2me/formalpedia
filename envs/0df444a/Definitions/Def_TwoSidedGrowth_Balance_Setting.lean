-- title:
--   §3 — the two-sided growth model in size-balance form: homogeneous output (1), h and (11), the size equation (12), problem (13) on [0, T], G (Definition 4), Assumptions 1–4, and the balance rule (14)
-- statement:
--   This file fixes the deterministic growth model of a two-sided platform of Lian and van Ryzin, in its size-balance form (§3, pp. 8–19).
--
--   **Primitives.** A supply stock $s$ and a demand stock $d$ generate $g(s,d)$ transactions per unit time, where the output function $g$ is homogeneous of degree $\alpha$:
--   $$g(ks,kd)=k^{\alpha}g(s,d)\qquad(k>0,\ s,d\ge 0).\tag{1}$$
--   Buyers receive gross utility $v$ and sellers incur cost $c$ per transaction. The attrition coefficients of supply and demand are $\beta^s_0,\beta^d_0$, the adoption coefficients $\beta^s_1,\beta^d_1$, and $\rho$ is the platform's discount rate.
--
--   **Size-balance form.** With the market size $x$ and the balance $\gamma\in[0,1]$, define
--   $$h(\gamma)=g\bigl(\beta^s_1\gamma,\ \beta^d_1(1-\gamma)\bigr),\qquad g(\gamma,x)=x^{\alpha}h(\gamma)\tag{11}$$
--   and the net welfare rate (Definition 4)
--   $$G(\gamma,x)=(v-c)\,g(\gamma,x)-\bigl(\rho+\beta^s_0\gamma+\beta^d_0(1-\gamma)\bigr)x .$$
--   Write $\kappa(x)=(\beta^s_0-\beta^d_0)x^{1-\alpha}/(v-c)$ for the argument of $(h')^{-1}$ in (14).
--
--   **Standing assumptions.** All of $\beta^s_0,\beta^d_0,\beta^s_1,\beta^d_1$ and $\rho$ are positive (pp. 10–11); $g$ satisfies (1); and $h$ satisfies Assumptions 1–4 (pp. 17–18):
--   1. $h$ is twice differentiable and positive on $(0,1)$, and $h(0)\ge 0$, $h(1)\ge 0$;
--   2. $h''(\gamma)<0$ on $(0,1)$;
--   3. $h'(\gamma)=0$ has a unique solution $\gamma\in(0,1)$;
--   4. if $\alpha<1$, then $(1-\alpha)h'(\gamma)^2<-\alpha h(\gamma)h''(\gamma)$ on $(0,1)$.
--
--   **The balance rule (14).** A balance $\gamma$ satisfies (14) at size $x$,
--   $$\gamma=\max\Bigl\{\min\Bigl\{(h')^{-1}\Bigl(\frac{(\beta^s_0-\beta^d_0)x^{1-\alpha}}{v-c}\Bigr),1\Bigr\},0\Bigr\},$$
--   when either $\gamma\in(0,1)$ and $h'(\gamma)=\kappa(x)$; or $\gamma=0$ and $h'\le\kappa(x)$ on all of $(0,1)$; or $\gamma=1$ and $\kappa(x)\le h'$ on all of $(0,1)$.
--
--   **Paths and profit.** On a horizon $[0,T]$, a size path $x$, a balance path $\gamma$ and a margin path $\pi=p_d-p_s$ are *admissible* when $x>0$ and $0\le\gamma\le 1$ on $[0,T]$, $\gamma$ and $\pi$ are continuous, and $x$ is continuously differentiable on $[0,T]$ with
--   $$\dot x=-\bigl(\beta^s_0\gamma+\beta^d_0(1-\gamma)\bigr)x+(v-c-\pi)\,g(\gamma,x).\tag{12}$$
--   The discounted profit of such a triple is the objective of (13) truncated at $T$,
--   $$\int_0^T e^{-\rho t}\,\pi(t)\,g(\gamma(t),x(t))\,dt .$$
--
--   These objects are shared by every statement of the mission: Theorem 1, Lemma 5, Lemma 6 and the displays (33)–(34).
--
--   **Formalization Note.** The Greek coefficients are the ASCII fields `bs0 bd0 bs1 bd1` ($\beta^s_0,\beta^d_0,\beta^s_1,\beta^d_1$) and the margin is `pm`. Three standing assumptions are added and disclosed: $\alpha>0$; $c<v$ (the formula (14) divides by $v-c$); and continuity of $h$ on $[0,1]$ (implicit in $g$ being a production function; without it the boundary cases of (14) fail). Assumption 3, printed "on [0,1]", is posed on $(0,1)$ because $h'$ exists only there; the derivatives of $h$ are never evaluated at $0$ or $1$. The balance rule (14) is the clamp of the *extended* inverse of the strictly decreasing $h'$, since $h'$ may be unbounded at the ends (as for Cobb–Douglas, the paper's own example), and it is a predicate, not an argmax: that it is the maximizer of $G(\cdot,x)$ is a theorem. Problem (13) is posed on finite horizons $[0,T]$ with smooth paths; the impulse (Dirac) controls of §3.6 are not modelled. Powers $x^{\alpha}$ are real powers and every statement takes $x>0$.
-- source:
--   Lian, van Ryzin, Optimal Growth in Two-Sided Markets, SSRN working paper 3310559 (version of 2020-01-16), pp. 8–19, (1), (4)–(5), (11)–(14), Definition 4, Assumptions 1–4

import Mathlib

namespace TwoSidedGrowth.Balance

/-- §3.1–§3.2, pp. 8–11: the primitives of the two-sided growth model. `g s d` is the output
(number of transactions) generated by a supply stock `s` and a demand stock `d`, homogeneous of
degree `α` (1); `v` is the buyers' gross utility and `c` the sellers' cost per transaction; `ρ` is
the platform's discount rate; `bs0 bd0` are the attrition coefficients `β^s_0, β^d_0` and
`bs1 bd1` the adoption coefficients `β^s_1, β^d_1` of (4)–(5). -/
structure Model where
  α : ℝ
  ρ : ℝ
  v : ℝ
  c : ℝ
  bs0 : ℝ
  bd0 : ℝ
  bs1 : ℝ
  bd1 : ℝ
  g : ℝ → ℝ → ℝ

/-- p. 15: `h(γ) = g(β^s_1 γ, β^d_1 (1 − γ))`. -/
def h (M : Model) (γ : ℝ) : ℝ := M.g (M.bs1 * γ) (M.bd1 * (1 - γ))

/-- (11), p. 15: the market output in size-balance form, `g(γ, x) = x^α h(γ)`. -/
noncomputable def out (M : Model) (γ x : ℝ) : ℝ := x ^ M.α * h M γ

/-- Definition 4, p. 17: `G(γ, x) = (v − c) g(γ, x) − (ρ + β^s_0 γ + β^d_0 (1 − γ)) x`. -/
noncomputable def G (M : Model) (γ x : ℝ) : ℝ :=
  (M.v - M.c) * out M γ x - (M.ρ + M.bs0 * γ + M.bd0 * (1 - γ)) * x

/-- The argument of `(h′)^{−1}` in (14), p. 19: `κ(x) = (β^s_0 − β^d_0) x^{1−α} / (v − c)`. -/
noncomputable def kappa (M : Model) (x : ℝ) : ℝ :=
  (M.bs0 - M.bd0) * x ^ (1 - M.α) / (M.v - M.c)

/-- The standing assumptions of §3: positivity of the coefficients (p. 10) and of the discount
rate (p. 11); homogeneity (1) for `k > 0`, `s, d ≥ 0`; Assumptions 1–4 (pp. 17–18), with
Assumption 2 in its "i.e. `h″(γ) < 0`" form and Assumption 3 as a unique zero of `h′` in `(0, 1)`.
Disclosed additions: `0 < α`, `c < v`, and continuity of `h` on `[0, 1]`. -/
structure Model.Standing (M : Model) : Prop where
  bs0_pos : 0 < M.bs0
  bd0_pos : 0 < M.bd0
  bs1_pos : 0 < M.bs1
  bd1_pos : 0 < M.bd1
  ρ_pos : 0 < M.ρ
  α_pos : 0 < M.α
  c_lt_v : M.c < M.v
  homogeneous : ∀ k s d : ℝ, 0 < k → 0 ≤ s → 0 ≤ d → M.g (k * s) (k * d) = k ^ M.α * M.g s d
  h_continuousOn : ContinuousOn (h M) (Set.Icc 0 1)
  h_differentiableOn : DifferentiableOn ℝ (h M) (Set.Ioo 0 1)
  h'_differentiableOn : DifferentiableOn ℝ (deriv (h M)) (Set.Ioo 0 1)
  h_pos : ∀ γ ∈ Set.Ioo (0:ℝ) 1, 0 < h M γ
  h_zero_nonneg : 0 ≤ h M 0
  h_one_nonneg : 0 ≤ h M 1
  assumption_2 : ∀ γ ∈ Set.Ioo (0:ℝ) 1, deriv (deriv (h M)) γ < 0
  assumption_3 : ∃! γ : ℝ, γ ∈ Set.Ioo (0:ℝ) 1 ∧ deriv (h M) γ = 0
  assumption_4 : M.α < 1 → ∀ γ ∈ Set.Ioo (0:ℝ) 1,
    (1 - M.α) * deriv (h M) γ ^ 2 < -(M.α * h M γ * deriv (deriv (h M)) γ)

/-- (14), p. 19: `γ = max{min{(h′)^{−1}(κ(x)), 1}, 0}`, read with the extended inverse of the
strictly decreasing `h′` on `(0, 1)`: either `γ` is an interior root of `h′(γ) = κ(x)`, or
`γ = 0` and `h′ ≤ κ(x)` on all of `(0, 1)`, or `γ = 1` and `κ(x) ≤ h′` on all of `(0, 1)`. -/
def IsBalance (M : Model) (x γ : ℝ) : Prop :=
  (γ ∈ Set.Ioo 0 1 ∧ deriv (h M) γ = kappa M x) ∨
  (γ = 0 ∧ ∀ η ∈ Set.Ioo (0:ℝ) 1, deriv (h M) η ≤ kappa M x) ∨
  (γ = 1 ∧ ∀ η ∈ Set.Ioo (0:ℝ) 1, kappa M x ≤ deriv (h M) η)

/-- (12)–(13), pp. 15–16, on a finite horizon `[0, T]`: a size path `x`, a balance path `γ` and a
margin path `pm` (the profit margin `π = p_d − p_s`) are admissible when `x > 0` and
`0 ≤ γ ≤ 1` on `[0, T]`, `γ` and `pm` are continuous, and `x` has a continuous derivative `x′`
on `[0, T]` (one-sided at the ends) obeying the state equation (12)
`ẋ = −(β^s_0 γ + β^d_0 (1 − γ)) x + (v − c − π) g(γ, x)`. -/
def Admissible (M : Model) (T : ℝ) (x γ pm : ℝ → ℝ) : Prop :=
  0 ≤ T ∧ (∀ t ∈ Set.Icc 0 T, 0 < x t ∧ γ t ∈ Set.Icc 0 1) ∧
  ContinuousOn γ (Set.Icc 0 T) ∧ ContinuousOn pm (Set.Icc 0 T) ∧
  ∃ x' : ℝ → ℝ, ContinuousOn x' (Set.Icc 0 T) ∧ ∀ t ∈ Set.Icc 0 T,
    HasDerivWithinAt x (x' t) (Set.Icc 0 T) t ∧
    x' t = -(M.bs0 * γ t + M.bd0 * (1 - γ t)) * x t + (M.v - M.c - pm t) * out M (γ t) (x t)

/-- The objective of (13), p. 15, truncated at the horizon `T`:
`∫_0^T e^{−ρt} π(t) g(γ(t), x(t)) dt`. -/
noncomputable def profit (M : Model) (T : ℝ) (x γ pm : ℝ → ℝ) : ℝ :=
  ∫ t in (0:ℝ)..T, Real.exp (-(M.ρ * t)) * pm t * out M (γ t) (x t)

end TwoSidedGrowth.Balance


