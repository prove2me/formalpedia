-- title:
--   Plain witness: frozen deferred readout data for all 1,771 targets
-- statement:
--   These are Jain's frozen round-seven witness 2 readouts, with all 15,949 chronological events. For each of the 1,771 triples of coordinates from 0 to 22, the data record the source slot and an integer basis of its rational frame at every event. Triples are ordered lexicographically. Repeated frames and empty target schedules are kept.
--
--   Each row packs its signed coordinates in five-bit digits with bias 16. Other arrays use fixed-width little-endian digits with a high sentinel bit. The decoder, row table, bases, identities, edges, and chronological paths are all in this module. An integer row identity certifies each generator that changes representation at an adjacent frame.
-- source:
--   https://github.com/Swapnil-jain/integer-mult-kappa/blob/5868dc701a9bec375c9dc5391d992ab3b8c35f3f/independent/joint-frame-stack/check_design.py#L78-L103

import Definitions.Def_IntMul_Kappa_DeferredReadoutCertificates

namespace IntMul.Kappa.DeferredReadout.Plain

set_option maxRecDepth 12000
set_option maxHeartbeats 0

/-- Little-endian fixed-width digits, terminated by a leading one bit. -/
private def digits (width value : Nat) : List Nat :=
  (List.range (value.log2 / width)).map fun j => (value >>> (width * j)) % (2 ^ width)

private def basisCode (v : Nat) : Frame := digits 11 v
private def signed (z : Nat) : Int :=
  if z % 2 = 0 then (z / 2 : Nat) else -((z / 2 : Nat) : Int) - 1
private def identityCode (v : Nat) : Identity :=
  match digits 16 v with
  | lhs :: den :: rest => ⟨lhs, den, rest.map (fun x => (x >>> 5, signed (x % 32)))⟩
  | _ => default
private def edgeCode (v : Nat) : Edge :=
  match digits 13 v with
  | a :: b :: refs => ⟨a, b, refs⟩
  | _ => default
private def pathCode (v : Nat) : List Event :=
  (digits 41 v).map fun x => ⟨x % 32768, (x >>> 15) % 8192, x >>> 28⟩

