section Sep

variable {S S₁ : Type} [CommRing S] [CommRing S₁] (q : S →+* S₁) {Λ : Type} [Ring Λ]

noncomputable def φ : S ⊗[ℤ] Λ →ₐ[ℤ] S₁ ⊗[ℤ] Λ :=
  Algebra.TensorProduct.map q.toIntAlgHom (AlgHom.id ℤ Λ)

theorem φ_tmul (s : S) (l : Λ) : φ q (s ⊗ₜ l) = (q s) ⊗ₜ l := by
  simp [φ]

theorem φ_algebraMap (s : S) :
    φ q (algebraMap S (S ⊗[ℤ] Λ) s) = algebraMap S₁ (S₁ ⊗[ℤ] Λ) (q s) := by
  rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self,
    Algebra.algebraMap_self, RingHom.id_apply, RingHom.id_apply, φ_tmul]

theorem φ_smul (s : S) (m : S ⊗[ℤ] Λ) : φ q (s • m) = q s • φ q m := by
  induction m using TensorProduct.induction_on with
  | zero => rw [smul_zero, map_zero, smul_zero]
  | tmul a l => rw [TensorProduct.smul_tmul', smul_eq_mul, φ_tmul, φ_tmul, TensorProduct.smul_tmul', smul_eq_mul, map_mul]
  | add x y hx hy => rw [smul_add, map_add, hx, hy, map_add, smul_add]

theorem φ_surjective (hq : Function.Surjective q) : Function.Surjective (φ (Λ := Λ) q) := by
  intro y
  induction y using TensorProduct.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | tmul s l =>
    obtain ⟨s, rfl⟩ := hq s
    exact ⟨s ⊗ₜ l, φ_tmul q s l⟩
  | add x y hx hy =>
    obtain ⟨x, rfl⟩ := hx
    obtain ⟨y, rfl⟩ := hy
    exact ⟨x + y, map_add _ _ _⟩

noncomputable def ψ : (S ⊗[ℤ] Λ) ⊗[S] (S ⊗[ℤ] Λ) →+ (S₁ ⊗[ℤ] Λ) ⊗[S₁] (S₁ ⊗[ℤ] Λ) :=
  TensorProduct.liftAddHom
    { toFun := fun m =>
        (TensorProduct.mk S₁ (S₁ ⊗[ℤ] Λ) (S₁ ⊗[ℤ] Λ) (φ q m)).toAddMonoidHom.comp
          (φ (Λ := Λ) q).toRingHom.toAddMonoidHom
      map_zero' := by
        ext n
        simp
      map_add' := fun m m' => by
        ext n
        simp }
    (fun s m n => by
      change φ q (s • m) ⊗ₜ[S₁] φ q n = φ q m ⊗ₜ[S₁] φ q (s • n)
      rw [φ_smul, φ_smul, TensorProduct.smul_tmul])

theorem ψ_tmul (m n : S ⊗[ℤ] Λ) : ψ q (m ⊗ₜ n) = φ q m ⊗ₜ φ q n :=
  TensorProduct.liftAddHom_tmul _ _ m n

theorem mul'_ψ (z : (S ⊗[ℤ] Λ) ⊗[S] (S ⊗[ℤ] Λ)) :
    LinearMap.mul' S₁ (S₁ ⊗[ℤ] Λ) (ψ q z) = φ q (LinearMap.mul' S (S ⊗[ℤ] Λ) z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a b => rw [ψ_tmul, LinearMap.mul'_apply, LinearMap.mul'_apply, map_mul]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]

theorem map_mulLeft_ψ (x : S ⊗[ℤ] Λ) (z : (S ⊗[ℤ] Λ) ⊗[S] (S ⊗[ℤ] Λ)) :
    TensorProduct.map (LinearMap.mulLeft S₁ (φ q x)) LinearMap.id (ψ q z) =
      ψ q (TensorProduct.map (LinearMap.mulLeft S x) LinearMap.id z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    rw [ψ_tmul, TensorProduct.map_tmul, TensorProduct.map_tmul, ψ_tmul, LinearMap.mulLeft_apply,
      LinearMap.mulLeft_apply, LinearMap.id_apply, LinearMap.id_apply, map_mul]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]

theorem map_mulRight_ψ (x : S ⊗[ℤ] Λ) (z : (S ⊗[ℤ] Λ) ⊗[S] (S ⊗[ℤ] Λ)) :
    TensorProduct.map LinearMap.id (LinearMap.mulRight S₁ (φ q x)) (ψ q z) =
      ψ q (TensorProduct.map LinearMap.id (LinearMap.mulRight S x) z) := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    rw [ψ_tmul, TensorProduct.map_tmul, TensorProduct.map_tmul, ψ_tmul, LinearMap.mulRight_apply,
      LinearMap.mulRight_apply, LinearMap.id_apply, LinearMap.id_apply, map_mul]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]

theorem exists_sep_baseChange (hq : Function.Surjective q) (e : (S ⊗[ℤ] Λ) ⊗[S] (S ⊗[ℤ] Λ))
    (he₁ : LinearMap.mul' S (S ⊗[ℤ] Λ) e = 1)
    (he₂ : ∀ x : S ⊗[ℤ] Λ, TensorProduct.map (LinearMap.mulLeft S x) LinearMap.id e =
      TensorProduct.map LinearMap.id (LinearMap.mulRight S x) e) :
    ∃ e₁ : (S₁ ⊗[ℤ] Λ) ⊗[S₁] (S₁ ⊗[ℤ] Λ),
      LinearMap.mul' S₁ (S₁ ⊗[ℤ] Λ) e₁ = 1 ∧
      ∀ x : S₁ ⊗[ℤ] Λ, TensorProduct.map (LinearMap.mulLeft S₁ x) LinearMap.id e₁ =
        TensorProduct.map LinearMap.id (LinearMap.mulRight S₁ x) e₁ := by
  refine ⟨ψ q e, ?_, fun x => ?_⟩
  · rw [mul'_ψ, he₁, map_one]
  · obtain ⟨x, rfl⟩ := φ_surjective q hq x
    rw [map_mulLeft_ψ, map_mulRight_ψ, he₂]

end Sep

section Quot

variable {S : Type} [CommRing S] [IsLocalRing S] (J : Ideal S)

omit [IsLocalRing S] in
theorem nontrivial_quot (hJ : J ≠ ⊤) : Nontrivial (S ⧸ J) :=
  Ideal.Quotient.nontrivial_iff.mpr hJ

theorem isLocalRing_quot (hJ : J ≠ ⊤) : IsLocalRing (S ⧸ J) :=
  haveI := nontrivial_quot J hJ
  IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective

theorem exists_residueField_equiv (hJ : J ≠ ⊤) :
    letI := isLocalRing_quot J hJ
    ∃ r : ResidueField S →+* ResidueField (S ⧸ J), Function.Bijective r := by
  haveI := nontrivial_quot J hJ
  letI := isLocalRing_quot J hJ
  haveI : IsLocalHom (Ideal.Quotient.mk J) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
  refine ⟨ResidueField.map (Ideal.Quotient.mk J), (ResidueField.map (Ideal.Quotient.mk J)).injective, fun y => ?_⟩
  obtain ⟨z, rfl⟩ := residue_surjective y
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective z
  exact ⟨residue S s, ResidueField.map_residue _ s⟩

end Quot

theorem mul_val_congr {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{0}} {t t' : T ⟶ Spec (CommRingCat.of R)} (h : t = t')
    (P Q : SchemeHomOver t f) (P' Q' : SchemeHomOver t' f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t P Q).1 = (L.mul t' P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem devissage (n : ℕ) :
    ∀ {S S₀ : Type} [CommRing S] [CommRing S₀]
    [IsLocalRing S] [IsArtinianRing S] [IsAlgClosed (IsLocalRing.ResidueField S)] (ℓ : ℕ) [Fact ℓ.Prime]
    [CharP (IsLocalRing.ResidueField S) ℓ]
    (p : S →+* S₀) (_hp : Function.Surjective p)
    (_hI : RingHom.ker p * RingHom.ker p = ⊥)
