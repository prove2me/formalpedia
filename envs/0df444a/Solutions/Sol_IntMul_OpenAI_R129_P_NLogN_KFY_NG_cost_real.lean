  -- the overheads
  have hOR : (((3 * IntMul.OpenAI.R129.dP n + 1) * IntMul.OpenAI.R129.P.NLogN.KFY.overN n + 2 : ℕ) : ℝ) + ((Q2 : ℕ) : ℝ) + (IntMul.OpenAI.R129.dP n : ℝ) ≤ IntMul.OpenAI.Glue.VP n := by
    have : ((((3 * IntMul.OpenAI.R129.dP n + 1) * IntMul.OpenAI.R129.P.NLogN.KFY.overN n + 2 : ℕ) + Q2 + IntMul.OpenAI.R129.dP n : ℕ) : ℝ) ≤ ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℝ) := by
