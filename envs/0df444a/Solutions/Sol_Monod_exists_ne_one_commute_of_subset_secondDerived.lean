section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set
open scoped commutatorElement

variable {A : Subring ℝ}

/-! ### Monotonicity of `G` and `H` in the ring -/

/-! ### Affine germs at `±∞` -/

/-- `f` is eventually `t ↦ lam * t + μ` along `l` -/
def AG (l : Filter ℝ) (f : OnePoint ℝ → OnePoint ℝ) (lam μ : ℝ) : Prop :=
  0 < lam ∧ ∀ᶠ t : ℝ in l, f (t : OnePoint ℝ) = ((lam * t + μ : ℝ) : OnePoint ℝ)

/-- filters preserved by increasing affine maps -/
def GoodL (l : Filter ℝ) : Prop :=
  ∀ lam μ : ℝ, 0 < lam → Tendsto (fun t => lam * t + μ) l l

lemma goodL_atBot : GoodL atBot := fun _ μ h =>
  tendsto_atBot_add_const_right _ μ (tendsto_id.const_mul_atBot h)

lemma goodL_atTop : GoodL atTop := fun _ μ h =>
  tendsto_atTop_add_const_right _ μ (tendsto_id.const_mul_atTop h)

lemma AG_comp {l : Filter ℝ} (hl : GoodL l) {f1 f2 : OnePoint ℝ → OnePoint ℝ} {l1 m1 l2 m2 : ℝ}
    (h1 : AG l f1 l1 m1) (h2 : AG l f2 l2 m2) : AG l (f1 ∘ f2) (l1 * l2) (l1 * m2 + m1) := by
  refine ⟨mul_pos h1.1 h2.1, ?_⟩
  filter_upwards [h2.2, (hl l2 m2 h2.1).eventually h1.2] with t ht1 ht2
  simp only [Function.comp_apply]
  rw [ht1, ht2]
  congr 1; ring

lemma AG_symm {l : Filter ℝ} (hl : GoodL l) (f : OnePoint ℝ ≃ₜ OnePoint ℝ) {lam μ : ℝ}
    (h : AG l f lam μ) : AG l f.symm lam⁻¹ (-μ / lam) := by
  refine ⟨inv_pos.2 h.1, ?_⟩
  have ht : Tendsto (fun s => lam⁻¹ * s + -μ / lam) l l := hl _ _ (inv_pos.2 h.1)
  filter_upwards [ht.eventually h.2] with s hs
  have : lam * (lam⁻¹ * s + -μ / lam) + μ = s := by have := h.1.ne'; field_simp; ring
  rw [this] at hs
  rw [← hs, f.symm_apply_apply]

lemma AG_congr {l : Filter ℝ} {f : OnePoint ℝ → OnePoint ℝ} {lam μ lam' μ' : ℝ}
    (h : AG l f lam μ) (h1 : lam = lam') (h2 : μ = μ') : AG l f lam' μ' := by
  subst h1; subst h2; exact h

lemma AG_id (l : Filter ℝ) : AG l id 1 0 :=
  ⟨one_pos, Eventually.of_forall fun t => by simp⟩

/-- elements of `H A` have affine germs at `-∞` and `+∞` -/
lemma AG_of_H {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H A) :
    (∃ lam μ, AG atBot f lam μ) ∧ (∃ lam μ, AG atTop f lam μ) := by
  have hG := (Subgroup.mem_inf.1 hf).1
  have hinf : f ∞ = ∞ := (Subgroup.mem_inf.1 hf).2
  have key : ∀ g : Matrix.SpecialLinearGroup (Fin 2) A, f ∞ = mob g ∞ →
      ∃ lam μ, 0 < lam ∧ ∀ t : ℝ, mob g (t : OnePoint ℝ) = ((lam * t + μ : ℝ) : OnePoint ℝ) := by
    intro g hg
    have hdet := det_ent g
    have hc : ent g 1 0 = 0 := by
      rw [hinf, mob_infty] at hg
      split_ifs at hg with h
      · exact h
      · exact absurd hg.symm (coe_ne_infty _)
    have hd : ent g 1 1 ≠ 0 := by intro h; rw [h, hc] at hdet; simp at hdet
    have had : ent g 0 0 * ent g 1 1 = 1 := by rw [hc] at hdet; linarith
    refine ⟨ent g 0 0 / ent g 1 1, ent g 0 1 / ent g 1 1, ?_, fun t => ?_⟩
    · have h2 : ent g 0 0 / ent g 1 1 = ent g 0 0 * ent g 1 1 / (ent g 1 1 * ent g 1 1) := by
        field_simp
      rw [h2, had]; exact div_pos one_pos (mul_self_pos.2 hd)
    · rw [mob_coe, hc, zero_mul, zero_add, if_neg hd]
      congr 1; field_simp
  constructor
  · obtain ⟨g, hg⟩ := germR_of_mem_G hG ∞
    obtain ⟨lam, μ, hl, hm⟩ := key g (germ_value RF_le_nhds f.continuous hg)
    refine ⟨lam, μ, hl, ?_⟩
    have := Filter.eventually_map.1 hg
    filter_upwards [this] with t ht
    rw [ht, hm]
  · obtain ⟨g, hg⟩ := germL_of_mem_G hG ∞
    obtain ⟨lam, μ, hl, hm⟩ := key g (germ_value LF_le_nhds f.continuous hg)
    refine ⟨lam, μ, hl, ?_⟩
    have := Filter.eventually_map.1 hg
    filter_upwards [this] with t ht
    rw [ht, hm]

lemma coe_commutator (a b : H A) :
    ((⁅a, b⁆ : H A) : OnePoint ℝ ≃ₜ OnePoint ℝ) =
      (a : OnePoint ℝ ≃ₜ OnePoint ℝ) * b * (a : OnePoint ℝ ≃ₜ OnePoint ℝ)⁻¹ * (b : OnePoint ℝ ≃ₜ OnePoint ℝ)⁻¹ := by
  rw [commutatorElement_def]; rfl

lemma coeFn_commutator (a b : H A) :
    (((⁅a, b⁆ : H A) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
      (a : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (b : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘
        (a : OnePoint ℝ ≃ₜ OnePoint ℝ).symm ∘ (b : OnePoint ℝ ≃ₜ OnePoint ℝ).symm := by
  rw [coe_commutator]; rfl

section level

variable {l : Filter ℝ} (hl : GoodL l)
  (h0 : ∀ f : OnePoint ℝ ≃ₜ OnePoint ℝ, f ∈ H A → ∃ lam μ, AG l f lam μ)

include hl h0 in
lemma level1 {w : H A} (hw : w ∈ derivedSeries (H A) 1) :
    ∃ μ, AG l ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) 1 μ := by
  rw [derivedSeries_succ, derivedSeries_zero, Subgroup.commutator_def] at hw
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, -, b, -, rfl⟩ := hx
    obtain ⟨la, ma, ha⟩ := h0 a a.2
    obtain ⟨lb, mb, hb⟩ := h0 b b.2
    have ha' := AG_symm hl _ ha
    have hb' := AG_symm hl _ hb
    have := AG_comp hl ha (AG_comp hl hb (AG_comp hl ha' hb'))
    rw [coeFn_commutator]
    exact ⟨_, AG_congr this (by field_simp [ha.1.ne', hb.1.ne']) rfl⟩
  | one => exact ⟨0, AG_id l⟩
  | mul x y _ _ hx hy =>
    obtain ⟨m1, h1⟩ := hx
    obtain ⟨m2, h2⟩ := hy
    have e : ((↑(x * y) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
        (x : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (y : OnePoint ℝ ≃ₜ OnePoint ℝ) := rfl
    rw [e]
    exact ⟨_, AG_congr (AG_comp hl h1 h2) (by ring) rfl⟩
  | inv x _ hx =>
    obtain ⟨m1, h1⟩ := hx
    exact ⟨_, AG_congr (AG_symm hl _ h1) (by simp) rfl⟩

include hl h0 in
lemma level2 {w : H A} (hw : w ∈ derivedSeries (H A) 2) :
    AG l ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) 1 0 := by
  rw [derivedSeries_succ, Subgroup.commutator_def] at hw
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, ha1, b, hb1, rfl⟩ := hx
    obtain ⟨ma, ha⟩ := level1 hl h0 ha1
    obtain ⟨mb, hb⟩ := level1 hl h0 hb1
    have ha' := AG_symm hl _ ha
    have hb' := AG_symm hl _ hb
    have := AG_comp hl ha (AG_comp hl hb (AG_comp hl ha' hb'))
    rw [coeFn_commutator]
    exact AG_congr this (by simp) (by simp)
  | one => exact AG_id l
  | mul x y _ _ hx hy =>
    have e : ((↑(x * y) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
        (x : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (y : OnePoint ℝ ≃ₜ OnePoint ℝ) := rfl
    rw [e]
    exact AG_congr (AG_comp hl hx hy) (by ring) (by ring)
  | inv x _ hx => exact AG_congr (AG_symm hl _ hx) (by simp) (by simp)

end level

/-- elements of the second derived subgroup of `H A` are trivial near `∞` -/
theorem derived2_trivial {w : H A} (hw : w ∈ derivedSeries (H A) 2) :
    ∀ᶠ x in 𝓝 (∞ : OnePoint ℝ), (w : OnePoint ℝ ≃ₜ OnePoint ℝ) x = x := by
  have hbot := level2 goodL_atBot (fun f hf => (AG_of_H hf).1) hw
  have htop := level2 goodL_atTop (fun f hf => (AG_of_H hf).2) hw
  have hinf : (w : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞ = ∞ := (Subgroup.mem_inf.1 w.2).2
  rw [nhds_infty_eq, eventually_sup, coclosedCompact_eq_cocompact, cocompact_eq_atBot_atTop,
    eventually_map, eventually_sup, eventually_pure]
  refine ⟨⟨?_, ?_⟩, hinf⟩
  · filter_upwards [hbot.2] with t ht; rw [ht]; simp
  · filter_upwards [htop.2] with t ht; rw [ht]; simp

end Monod.Dev.Dyn
end

