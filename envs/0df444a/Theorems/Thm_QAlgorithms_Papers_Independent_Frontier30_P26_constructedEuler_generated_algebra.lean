variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Remark 4.16, PDF p. 25. Full zero-grade formula, generated algebra, raising/lowering identities,
and the canonical special case. The construction does not impose a nonzero derivation. -/
theorem constructedEuler_generated_algebra (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G))
    (hz : (LieAlgebra.center ℝ G).toSubmodule = bracketSpan P.V P.V)
    (h : P.L) (he : EulerElement h) (hd : h ∈ LieAlgebra.derivedSeries ℝ P.L 1)
    (A B : Submodule ℝ G) (hs : EulerModuleSplit P h A B)
    (hi : ThreeIndependent (bracketSpan A A) (bracketSpan B B)
      (bracketSpan A B ⊔ bracketSpan (fixedSpace P h) (fixedSpace P h))) :
    (∃ D : LieDerivation ℝ G G, ConstructedEuler P h A B D ∧ EulerLinear D.toLinearMap ∧
      grade D.toLinearMap 0 =
        ((LieAlgebra.center ℝ G).toSubmodule ⊓ grade D.toLinearMap 0) ⊔
        (A ⊓ grade (LieAlgebra.ad ℝ G (h : G)) (-(1 / 2))) ⊔
        (B ⊓ grade (LieAlgebra.ad ℝ G (h : G)) (1 / 2)) ⊔ fixedSpace P h ⊔
        (P.L.toSubmodule ⊓ grade (LieAlgebra.ad ℝ G (h : G)) 0) ∧
      (gradedGeneratedAlgebra D).toSubmodule ⊓ P.L.toSubmodule =
        (idealGeneratedBy h).toSubmodule.map P.L.toSubmodule.subtype ∧
      (∀ a : ℝ, a = 1 ∨ a = -1 →
        bracketSpan (P.L.toSubmodule ⊓ grade (LieAlgebra.ad ℝ G (h : G)) a)
          (A ⊓ grade (LieAlgebra.ad ℝ G (h : G)) (-a / 2)) =
          A ⊓ grade (LieAlgebra.ad ℝ G (h : G)) (a / 2)) ∧
      (gradedGeneratedAlgebra D = ⊤ ↔ idealGeneratedBy h = ⊤ ∧ fixedSpace P h = ⊥)) ∧
    (idealGeneratedBy h = ⊤ →
      ∃ D : LieDerivation ℝ G G, D.toLinearMap = canonicalDilation P + LieAlgebra.ad ℝ G (h : G) ∧
        EulerLinear D.toLinearMap ∧
        grade D.toLinearMap 0 = bracketSpan (grade D.toLinearMap 1) (grade D.toLinearMap (-1))) := by sorry

end Derivations

end

