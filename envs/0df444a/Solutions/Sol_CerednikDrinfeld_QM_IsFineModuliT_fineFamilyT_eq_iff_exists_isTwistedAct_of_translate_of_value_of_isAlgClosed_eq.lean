theorem exists_sub_eq_smul_of_pushPt_eq {m : ℕ} (k : Type) [Field k] [IsAlgClosed k]
    (E : FakeEllipticCurve Λ N k) (Pn : E.FullLevel m) (c c' : ↥Λ)
    (h : pushPt (E.act c) (E.act_over c) Pn.P = pushPt (E.act c') (E.act_over c') Pn.P) :
    ∃ y : ↥Λ, (c : ℍ[ℚ, a, b]) - (c' : ℍ[ℚ, a, b]) = (m : ℚ) • (y : ℍ[ℚ, a, b]) := by
  set X := sectionAt Pn.P k (RingHom.id k) with hX
  have h1 : pushPt (E.act c) (E.act_over c) X = pushPt (E.act c') (E.act_over c') X := by
    rw [hX, sectionAt, pushPt_schemeHomOverComp, pushPt_schemeHomOverComp, h]
  have h2 := E.act_add (c - c') c' (geomPoint k (RingHom.id k)) X
  rw [sub_add_cancel] at h2
  letI : Group (SchemeHomOver (geomPoint k (RingHom.id k)) E.f) := E.L.pointGroup (geomPoint k (RingHom.id k))
  have h3 : pushPt (E.act (c - c')) (E.act_over (c - c')) X * pushPt (E.act c') (E.act_over c') X =
      1 * pushPt (E.act c') (E.act_over c') X := by
    rw [one_mul]
    exact h2.symm.trans h1
  have h4 : pushPt (E.act (c - c')) (E.act_over (c - c')) X = E.L.one (geomPoint k (RingHom.id k)) :=
    mul_right_cancel h3
  obtain ⟨y, hy⟩ := (Pn.annihilator k (RingHom.id k) (c - c')).1 h4
  exact ⟨y, by rw [← hy, Submodule.coe_sub]⟩

theorem exists_label_inv {n : ℕ} {B : Type} [CommRing B] {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of B)}
    {ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
