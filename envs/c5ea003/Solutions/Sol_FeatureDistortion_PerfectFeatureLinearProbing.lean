section FeatureDistortionBundleModule1
/-! Linear probing recovers the aligned head. Source: Kumar et al., Proposition
A.20 and its rotated-feature extension, PDF pp. 45--46, equations (A.208)--(A.211).
Injectivity of the observed feature map gives exponential decay of the head error. -/

noncomputable section
open Set Filter
open scoped Topology
namespace FeatureDistortion

lemma lp_error_norm_sq_deriv {n d k : ℕ} (P : Problem n d k)
    (v₀ : Vec k) (v : ℝ → Vec k)
    (hv : IsLinearProbingFlow P.data (labels P) v₀ (initialFeatures P) v)
    (t : ℝ) (ht : 0 ≤ t) :
    HasDerivWithinAt (fun s ↦ ‖v s - alignedHead P‖ ^ 2)
      (-4 * ‖P.data ((initialFeatures P).adjoint (v t - alignedHead P))‖ ^ 2) (Ici 0) t := by
  have he : inner ℝ (v t - alignedHead P)
      ((initialFeatures P) (P.data.adjoint (residual P.data (labels P) (v t)
        (initialFeatures P)))) =
      ‖P.data ((initialFeatures P).adjoint (v t - alignedHead P))‖ ^ 2 := by
    rw [← ContinuousLinearMap.adjoint_inner_left, ContinuousLinearMap.adjoint_inner_right,
      residual_eq_initial_map_sub, real_inner_self_eq_norm_sq]
  convert ((hv.2 t ht).sub_const (alignedHead P)).norm_sq using 1
  simp only [headGradient, inner_neg_right, real_inner_smul_right, he]
  ring

lemma lp_error_exp_bound {n d k : ℕ} (P : Problem n d k) (h : Admissible P)
    (v₀ : Vec k) (v : ℝ → Vec k)
    (hv : IsLinearProbingFlow P.data (labels P) v₀ (initialFeatures P) v) :
    ∃ c : ℝ, 0 < c ∧ ∀ t : ℝ, 0 ≤ t →
      ‖v t - alignedHead P‖ ^ 2 ≤ ‖v₀ - alignedHead P‖ ^ 2 * Real.exp (-c * t) := by
  let A := P.data.comp (initialFeatures P).adjoint
  have hi : Function.Injective A :=
    visible_data_injective P.data (initialFeatures P) h.2.2.2.2.2.1
  obtain ⟨K, hK, hAK⟩ := A.toLinearMap.injective_iff_antilipschitz.mp hi
  have hK' : 0 < (K : ℝ) := hK
  have hKsq : 0 < (K : ℝ) ^ 2 := sq_pos_of_pos hK'
  let c : ℝ := 4 / (K : ℝ) ^ 2
  have hc : 0 < c := div_pos (by norm_num) hKsq
  refine ⟨c, hc, ?_⟩
  intro t ht
  have hder := lp_error_norm_sq_deriv P v₀ v hv
  have hcont : ContinuousOn (fun s ↦ ‖v s - alignedHead P‖ ^ 2) (Icc 0 t) := by
    intro s hs
    exact (hder s hs.1).continuousWithinAt.mono (fun _ hx ↦ hx.1)
  have hbound : ∀ s ∈ Ico 0 t,
      -4 * ‖A (v s - alignedHead P)‖ ^ 2 ≤
      -c * ‖v s - alignedHead P‖ ^ 2 + 0 := by
    intro s hs
    have hn := hAK.le_mul_dist (v s - alignedHead P) 0
    simp only [map_zero, dist_zero_right] at hn
    have hsq : ‖v s - alignedHead P‖ ^ 2 ≤ (K : ℝ) ^ 2 * ‖A (v s - alignedHead P)‖ ^ 2 := by
      have hs := (sq_le_sq₀ (norm_nonneg (v s - alignedHead P))
        (mul_nonneg K.coe_nonneg (norm_nonneg (A (v s - alignedHead P))))).2 hn
      simpa only [mul_pow] using hs
    have hdiv : c * ‖v s - alignedHead P‖ ^ 2 ≤ 4 * ‖A (v s - alignedHead P)‖ ^ 2 := by
      dsimp [c]
      rw [div_mul_eq_mul_div, div_le_iff₀ hKsq]
      nlinarith
    linarith
  have hh := le_gronwallBound_of_liminf_deriv_right_le hcont
    (fun s hs r hr ↦ ((hder s hs.1).mono (fun _ hx ↦ le_trans hs.1 hx)).liminf_right_slope_le hr)
    (by simp [hv.1] : ‖v 0 - alignedHead P‖ ^ 2 ≤ ‖v₀ - alignedHead P‖ ^ 2) hbound t ⟨ht, le_rfl⟩
  simpa only [gronwallBound_ε0, sub_zero] using hh

theorem PerfectFeatureLinearProbing :
  ∀ (n d k : ℕ) (P : Problem n d k), Admissible P →
    (∀ v : Vec k,
      trainingLoss P.data (labels P) v (initialFeatures P) = 0 ↔ v = alignedHead P) ∧
    (∀ (v₀ : Vec k) (v : ℝ → Vec k),
      IsLinearProbingFlow P.data (labels P) v₀ (initialFeatures P) v →
      Tendsto v atTop (𝓝 (alignedHead P))) := by
  intro n d k P h
  refine ⟨trainingLoss_eq_zero_iff P h, ?_⟩
  intro v₀ v hv
  obtain ⟨c, hc, hb⟩ := lp_error_exp_bound P h v₀ v hv
  have he : Tendsto (fun t : ℝ ↦ ‖v₀ - alignedHead P‖ ^ 2 * Real.exp (-c * t))
      atTop (𝓝 0) := by
    simpa using tendsto_const_nhds.mul
      (Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atTop_of_neg (neg_neg_of_pos hc)))
  have hs : Tendsto (fun t : ℝ ↦ ‖v t - alignedHead P‖ ^ 2) atTop (𝓝 0) :=
    squeeze_zero' (Eventually.of_forall (fun _ ↦ sq_nonneg _))
      (eventually_atTop.2 ⟨0, hb⟩) he
  apply tendsto_iff_norm_sub_tendsto_zero.2
  simpa only [Function.comp_def, Real.sqrt_sq_eq_abs, abs_norm, Real.sqrt_zero] using
    (Real.continuous_sqrt.tendsto 0).comp hs

end FeatureDistortion
