namespace IsoTDescent

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N m ℓ : ℕ}

def TBC {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (Cu : u.1.ExtraLevel ℓ)
    (u' : FakeEllipticCurve.WithFullLevel Λ N m S') (Cu' : u'.1.ExtraLevel ℓ) (g : u'.1.A ⟶ u.1.A) : Prop :=
  FakeEllipticCurve.IsPullbackVia φ u.1 u'.1 g ∧
  (u'.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom φ) ≫ (u.2.P).1 ∧
  (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' u'.1.f),
    FactorsThrough Cu'.levK P → ∃ P₀ : T₀ ⟶ Cu.K, P₀ ≫ Cu.levK = P.1 ≫ g)

def TBCI {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (Cu : u.1.ExtraLevel ℓ)
    (u' : FakeEllipticCurve.WithFullLevel Λ N m S') (Cu' : u'.1.ExtraLevel ℓ) (g : u'.1.A ⟶ u.1.A) : Prop :=
  TBC φ u Cu u' Cu' g ∧
  (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' u'.1.f),
    (∃ P₀ : T₀ ⟶ u.1.C, P₀ ≫ u.1.lev = P.1 ≫ g) → FactorsThrough u'.1.lev P) ∧
  (∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of S')) (P : SchemeHomOver t' u'.1.f),
    FactorsThrough Cu'.levK P ↔ ∃ P₀ : T₀ ⟶ Cu.K, P₀ ≫ Cu.levK = P.1 ≫ g)

def IsoT {S : Type} [CommRing S] (u w : FakeEllipticCurve.WithFullLevel Λ N m S) (Cu : u.1.ExtraLevel ℓ) (Cw : w.1.ExtraLevel ℓ) : Prop :=
  ∃ (e : u.1.A ≅ w.1.A) (he : e.hom ≫ w.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoTVia u w Cu Cw e he

theorem tbci_of_tbc {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (Cu : u.1.ExtraLevel ℓ)
    (u' : FakeEllipticCurve.WithFullLevel Λ N m S') (Cu' : u'.1.ExtraLevel ℓ) (g : u'.1.A ⟶ u.1.A)
    (h : TBC φ u Cu u' Cu' g) : TBCI φ u Cu u' Cu' g := by
  refine ⟨h, fun t' P hP => ?_, fun t' P => ⟨h.2.2 t' P, ?_⟩⟩
  · exact CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_of_exists_comp_eq_comp_of_isPullbackVia u.1 φ u'.1 g h.1 t' P hP
  · obtain ⟨hg, -⟩ := h.1
    exact CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_levK_of_exists_comp_eq_of_isPullback φ
      (⟨u.1, Cu⟩ : FakeEllipticCurve.WithExtraLevel Λ N ℓ S) ⟨u'.1, Cu'⟩ g hg (fun t' P hP => h.2.2 t' P hP) t' P

theorem exists_tbci {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (Cu : u.1.ExtraLevel ℓ) :
    ∃ (u' : FakeEllipticCurve.WithFullLevel Λ N m S') (Cu' : u'.1.ExtraLevel ℓ) (g : u'.1.A ⟶ u.1.A), TBCI φ u Cu u' Cu' g := by
  obtain ⟨u', Cu', g, h1, h2, h3, h4⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.exists_extraLevel_isPullbackVia_forall_factorsThrough_iff φ u Cu
  exact ⟨u', Cu', g, ⟨h1, h2, fun t' P hP => (h4 t' P).mp hP⟩, h3, h4⟩

theorem tbc_comp {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] (φ : S →+* S') (ψ : S' →+* S'')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (u' : FakeEllipticCurve.WithFullLevel Λ N m S')
    (u'' : FakeEllipticCurve.WithFullLevel Λ N m S'')
    (Cu : u.1.ExtraLevel ℓ) (Cu' : u'.1.ExtraLevel ℓ) (Cu'' : u''.1.ExtraLevel ℓ)
    (g : u'.1.A ⟶ u.1.A) (g' : u''.1.A ⟶ u'.1.A)
    (h : TBC φ u Cu u' Cu' g) (h' : TBC ψ u' Cu' u'' Cu'' g') : TBC (ψ.comp φ) u Cu u'' Cu'' (g' ≫ g) := by
  obtain ⟨-, K2, -, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.isoTVia_unique_comp_transport_trans Λ N m ℓ
  exact K2 S S' S'' φ ψ u u' u'' Cu Cu' Cu'' g g' h.1 h.2.1 (fun t' P hP => h.2.2 t' P hP) h'.1 h'.2.1
    (fun t' P hP => h'.2.2 t' P hP)

theorem exists_tbc_cancel {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] (φ : S →+* S') (ψ : S' →+* S'')
    (u : FakeEllipticCurve.WithFullLevel Λ N m S) (u₁ : FakeEllipticCurve.WithFullLevel Λ N m S')
    (u'' : FakeEllipticCurve.WithFullLevel Λ N m S'')
    (Cu : u.1.ExtraLevel ℓ) (Cu₁ : u₁.1.ExtraLevel ℓ) (Cu'' : u''.1.ExtraLevel ℓ)
    (g₁ : u₁.1.A ⟶ u.1.A) (g : u''.1.A ⟶ u.1.A)
    (h₁ : TBC φ u Cu u₁ Cu₁ g₁) (h : TBC (ψ.comp φ) u Cu u'' Cu'' g) :
    ∃ g' : u''.1.A ⟶ u₁.1.A, TBC ψ u₁ Cu₁ u'' Cu'' g' := by
  have h₁' := tbci_of_tbc φ u Cu u₁ Cu₁ g₁ h₁
  obtain ⟨g', -, hv, hP, hC⟩ :=
