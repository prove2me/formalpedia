/-- Double cones grow with the apex angle. -/
lemma solution {v : E} {ϑ ϑ' : ℝ} (hϑ₀ : 0 ≤ ϑ) (hϑ' : ϑ' ≤ π) (h : ϑ ≤ ϑ') :
    QFS.doubleCone v ϑ ⊆ QFS.doubleCone v ϑ' := by
  intro y hy
  rw [QFS.mem_doubleCone_iff] at hy ⊢
  exact hy.imp (fun a => QFS.cone_mono hϑ₀ hϑ' h a) (fun a => QFS.cone_mono hϑ₀ hϑ' h a)
