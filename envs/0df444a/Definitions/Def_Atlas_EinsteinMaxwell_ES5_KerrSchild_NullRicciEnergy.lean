/-! ## Residuals and coefficients (transparent notation, Class B) -/

/-- Fiber/time residual `L = f a' ξ₀ + H e ξ₃` of `ξ = frameInv w x k`. -/
noncomputable def resL (f m N w p a : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) : ℝ :=
  f (x 1) * deriv a (x 1) * frameInv w x k 0 + Hfun m N (x 1) * eFun w p a (x 1) * frameInv w x k 3

/-- Magnetic discriminant `betaSq = 4a²/A²` on the paper dictionary. -/
noncomputable def betaSq (f m a : ℝ → ℝ) (r : ℝ) : ℝ := betaSqFrame (Afun f m r) (a r)

/-- `c₀ = 2/(D f H)`. -/
noncomputable def coeff0 (f m N : ℝ → ℝ) (r : ℝ) : ℝ := 2 / (Dfun f m N r * f r * Hfun m N r)

/-- `c₂ = 2(alphaSq+betaSq) A/(4U)`, `U = u(1-u)`. -/
noncomputable def coeff2 (f m N w p a : ℝ → ℝ) (x : Pt 5) : ℝ :=
  2 * (alphaSq f m N w p a (x 1) + betaSq f m a (x 1)) * Afun f m (x 1) / (4 * (x 2 * (1 - x 2)))

/-- `c₄ = 2(alphaSq+betaSq) A U`. -/
noncomputable def coeff4 (f m N w p a : ℝ → ℝ) (x : Pt 5) : ℝ :=
  2 * (alphaSq f m N w p a (x 1) + betaSq f m a (x 1)) * Afun f m (x 1) * (x 2 * (1 - x 2))

/-- The weighted sum of squares `c₀ L² + c₂ ξ₂² + c₄ ξ₄²`. -/
noncomputable def nullSOS (f m N w p a : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) : ℝ :=
  coeff0 f m N (x 1) * resL f m N w p a x k ^ 2 + coeff2 f m N w p a x * frameInv w x k 2 ^ 2 +
    coeff4 f m N w p a x * frameInv w x k 4 ^ 2

/-- `mu = min c₀ (min c₂ c₄)` (depends on the point only, not on `k`). -/
noncomputable def muCoeff (f m N w p a : ℝ → ℝ) (x : Pt 5) : ℝ :=
  min (coeff0 f m N (x 1)) (min (coeff2 f m N w p a x) (coeff4 f m N w p a x))

/-- Unweighted residual square sum `L² + ξ₂² + ξ₄²` (fixed-chart numerical comparison only). -/
noncomputable def misalign (f m N w p a : ℝ → ℝ) (x : Pt 5) (k : Fin 5 → ℝ) : ℝ :=
  resL f m N w p a x k ^ 2 + frameInv w x k 2 ^ 2 + frameInv w x k 4 ^ 2

