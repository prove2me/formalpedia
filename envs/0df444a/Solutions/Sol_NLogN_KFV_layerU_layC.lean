theorem lin2_bnd {p q x y : GI} {w : ℕ} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) (hx : zsz x.1 ≤ w ∧ zsz x.2 ≤ w)
    (hy : zsz y.1 ≤ w ∧ zsz y.2 ≤ w) :
    zsz (lin2 p q x y).1 ≤ w + 2 ∧ zsz (lin2 p q x y).2 ≤ w + 2 := by
  have b : ∀ (c a : ℤ), c.natAbs ≤ 1 → zsz a ≤ w → (c * a).natAbs ≤ 2 ^ w - 1 := by
    intro c a hc ha
    have := zsz_le_iff.1 ha
    rw [Int.natAbs_mul]
    have : c.natAbs * a.natAbs ≤ 1 * a.natAbs := Nat.mul_le_mul_right _ hc
    omega
  have hw : 1 ≤ 2 ^ w := Nat.one_le_two_pow
  have h4 : 4 * (2 ^ w - 1) < 2 ^ (w + 2) := by rw [pow_add]; omega
  constructor
  · apply zsz_le_of_lt
    simp only [lin2, NLogN.KFB.gmul, Prod.fst_add]
    have e1 := b p.1 x.1 hp.1 hx.1; have e2 := b p.2 x.2 hp.2 hx.2
    have e3 := b q.1 y.1 hq.1 hy.1; have e4 := b q.2 y.2 hq.2 hy.2
    have := Int.natAbs_add_le (p.1 * x.1 - p.2 * x.2) (q.1 * y.1 - q.2 * y.2)
    have := Int.natAbs_sub_le (p.1 * x.1) (p.2 * x.2)
    have := Int.natAbs_sub_le (q.1 * y.1) (q.2 * y.2)
    omega
  · apply zsz_le_of_lt
    simp only [lin2, NLogN.KFB.gmul, Prod.snd_add]
    have e1 := b p.2 x.1 hp.2 hx.1; have e2 := b p.1 x.2 hp.1 hx.2
    have e3 := b q.2 y.1 hq.2 hy.1; have e4 := b q.1 y.2 hq.1 hy.2
    have := Int.natAbs_add_le (p.2 * x.1 + p.1 * x.2) (q.2 * y.1 + q.1 * y.2)
    have := Int.natAbs_add_le (p.2 * x.1) (p.1 * x.2)
    have := Int.natAbs_add_le (q.2 * y.1) (q.1 * y.2)
    omega

theorem GB_zipWith {p q : GI} {w : ℕ} (hp : NLogN.KFB.Sm p) (hq : NLogN.KFB.Sm q) {u v : List GI} (hu : NLogN.KFB.GB w u)
    (hv : NLogN.KFB.GB w v) : NLogN.KFB.GB (w + 2) (List.zipWith (lin2 p q) u v) := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hi1 : i < u.length := by simp at hi; omega
  have hi2 : i < v.length := by simp at hi; omega
  rw [List.getElem_zipWith]
  exact lin2_bnd hp hq (hu _ (List.getElem_mem hi1)) (hv _ (List.getElem_mem hi2))

theorem GB_pairOut {M : M2G} (hM : M.Ok) {w : ℕ} {u v : List GI} (hu : NLogN.KFB.GB w u) (hv : NLogN.KFB.GB w v) :
    NLogN.KFB.GB (w + 2) (pairOut M u v) := by
  intro z hz
  rcases List.mem_append.1 hz with h | h
  · exact GB_zipWith hM.1 hM.2.1 hu hv z h
  · exact GB_zipWith hM.2.2.1 hM.2.2.2 hu hv z h

theorem GB_take {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (n : ℕ) : NLogN.KFB.GB w (zs.take n) :=
  h.sub fun _ hz => List.mem_of_mem_take hz

theorem GB_drop {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (n : ℕ) : NLogN.KFB.GB w (zs.drop n) :=
  h.sub fun _ hz => List.mem_of_mem_drop hz

theorem GB_grpOut {w B1 : ℕ} : ∀ (Ms : List M2G), (∀ M ∈ Ms, M.Ok) → ∀ (zs : List GI), NLogN.KFB.GB w zs →
    NLogN.KFB.GB (w + 2) (grpOut Ms B1 zs)
  | [], _, _, _ => by intro z hz; simp [grpOut] at hz
  | M :: Ms, hM, zs, h => by
    intro z hz
    rw [grpOut] at hz
    rcases List.mem_append.1 hz with hz | hz
    · exact GB_pairOut (hM M List.mem_cons_self) (NLogN.KFB.GB_take h _) (NLogN.KFB.GB_take (NLogN.KFB.GB_drop h _) _) z hz
    · exact GB_grpOut Ms (fun M' h' => hM M' (List.mem_cons_of_mem _ h')) _ (NLogN.KFB.GB_drop h _) z hz

theorem qopL_succ (Ms : List M2G) (B1 G : ℕ) (zs : List GI) :
    qopL Ms B1 (G + 1) zs = qopL Ms B1 G zs ++ grpOut Ms B1 (zs.drop (G * (2 * B1 * Ms.length))) := by
  simp [qopL, List.range_succ, List.flatMap_append]

theorem GB_qopL {w B1 : ℕ} (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok) (zs : List GI) (hb : NLogN.KFB.GB w zs) :
    ∀ G, NLogN.KFB.GB (w + 2) (qopL Ms B1 G zs)
  | 0 => by intro z hz; simp [qopL] at hz
  | G + 1 => by
    rw [qopL_succ]; intro z hz
    rcases List.mem_append.1 hz with h | h
    · exact GB_qopL Ms hM zs hb G z h
    · exact GB_grpOut Ms hM _ (NLogN.KFB.GB_drop hb _) z h

theorem mem_reT (p q : GI) : ∀ t ∈ reT p q, t.2 ∈ ([rUr, rUi, rVr, rVi] : List (Fin HS)) := by
  intro t ht; simp only [reT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl <;> simp

theorem mem_imT (p q : GI) : ∀ t ∈ imT p q, t.2 ∈ ([rUr, rUi, rVr, rVi] : List (Fin HS)) := by
  intro t ht; simp only [imT, List.mem_cons, List.not_mem_nil, or_false] at ht
  rcases ht with rfl | rfl | rfl | rfl <;> simp

theorem touch_lcE_reT (p q : GI) : ∀ x ∈ (lcE (reT p q)).regs, x ∈ qT_all := by
  intro x hx
  obtain ⟨t, ht, rfl⟩ := lcE_regs _ x hx
  have := mem_reT p q t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at this
  simp only [qT_all, List.mem_cons, List.not_mem_nil, or_false]; tauto

theorem touch_lcE_imT (p q : GI) : ∀ x ∈ (lcE (imT p q)).regs, x ∈ qT_all := by
  intro x hx
  obtain ⟨t, ht, rfl⟩ := lcE_regs _ x hx
  have := mem_imT p q t ht
  simp only [List.mem_cons, List.not_mem_nil, or_false] at this
  simp only [qT_all, List.mem_cons, List.not_mem_nil, or_false]; tauto

theorem touch_zb (M : M2G) : ∀ x ∈ touch (zb M), x ∈ qT_all ∧ x ≠ c1 := by
  intro x hx
  simp only [zb, touch, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hx
  have h1 := touch_lcE_reT M.a M.b x; have h2 := touch_lcE_imT M.a M.b x
  have h3 := touch_lcE_reT M.c M.d x; have h4 := touch_lcE_imT M.c M.d x
  have k1 : ∀ y ∈ (lcE (reT M.a M.b)).regs, y ≠ c1 := fun y hy => by
    obtain ⟨t, ht, rfl⟩ := lcE_regs _ y hy; have := mem_reT _ _ t ht; simp at this
    rcases this with h | h | h | h <;> rw [h] <;> decide
  have k2 : ∀ y ∈ (lcE (imT M.a M.b)).regs, y ≠ c1 := fun y hy => by
    obtain ⟨t, ht, rfl⟩ := lcE_regs _ y hy; have := mem_imT _ _ t ht; simp at this
    rcases this with h | h | h | h <;> rw [h] <;> decide
  have k3 : ∀ y ∈ (lcE (reT M.c M.d)).regs, y ≠ c1 := fun y hy => by
    obtain ⟨t, ht, rfl⟩ := lcE_regs _ y hy; have := mem_reT _ _ t ht; simp at this
    rcases this with h | h | h | h <;> rw [h] <;> decide
  have k4 : ∀ y ∈ (lcE (imT M.c M.d)).regs, y ≠ c1 := fun y hy => by
    obtain ⟨t, ht, rfl⟩ := lcE_regs _ y hy; have := mem_imT _ _ t ht; simp at this
    rcases this with h | h | h | h <;> rw [h] <;> decide
  rcases hx with (h | h) | (h | h) | (h | h) | (h | h) | h | h | h | h
  all_goals first
    | (subst h; exact ⟨by simp [qT_all], by decide⟩)
    | exact ⟨h1 h, k1 x h⟩ | exact ⟨h2 h, k2 x h⟩ | exact ⟨h3 h, k3 x h⟩ | exact ⟨h4 h, k4 x h⟩

theorem touch_blk (M : M2G) : ∀ x ∈ touch (NLogN.KFB.blk M), x ∈ qT_all := by
  intro x hx
  simp only [NLogN.KFB.blk, touch, List.mem_append] at hx
  rcases hx with h | h | h | h | h | h
  · exact (by decide : ∀ y ∈ touch (NLogN.mvK 0 qT c1 (.reg rB4)), y ∈ qT_all) x h
  · exact (by decide : ∀ y ∈ touch (distB rVr rVi), y ∈ qT_all) x h
  · exact (by decide : ∀ y ∈ touch (distB rUr rUi), y ∈ qT_all) x h
  · simp only [zipR, touch, Ex.regs, List.mem_cons, List.mem_append, List.not_mem_nil,
      or_false] at h
    rcases h with h | h | h
    · subst h; decide
    · subst h; decide
    · exact (NLogN.KFB.touch_zb M x h).1
  · exact (by decide : ∀ y ∈ touch (NLogN.mvK qO qT c1 (.reg rB2)), y ∈ qT_all) x h
  · exact (by decide : ∀ y ∈ touch (NLogN.mvK qT qA c1 (.reg rB2)), y ∈ qT_all) x h

theorem touch_blks : ∀ (Ms : List M2G), ∀ x ∈ touch (blks Ms), x ∈ qT_all
  | [], x, hx => by simp [blks, touch] at hx
  | M :: Ms, x, hx => by
    simp only [blks, touch, List.mem_append] at hx
    rcases hx with h | h
    · exact touch_blk M x h
    · exact touch_blks Ms x h

theorem fok_zipR (M : M2G) : NLogN.KFD.fok (zipR M) = true := by
  have : (touch (zb M)).contains NLogN.KFB.c1 = false :=
    not_contains_of fun h => (NLogN.KFB.touch_zb M NLogN.KFB.c1 h).2 rfl
  simp only [zipR, NLogN.KFD.fok, this]
  simp +decide [zb, NLogN.KFD.fok, NLogN.KFD.scr]

theorem fok_blk (M : M2G) : NLogN.KFD.fok (NLogN.KFB.blk M) = true := by
  simp only [NLogN.KFB.blk, NLogN.KFD.fok, fok_zipR, Bool.and_true, Bool.true_and, fok_mvK_eq]
  simp +decide [distB, NLogN.KFD.fok, touch, Ex.regs, NLogN.KFD.scr]

theorem fok_blks : ∀ Ms : List M2G, NLogN.KFD.fok (blks Ms) = true
  | [] => rfl
  | M :: Ms => by simp [blks, NLogN.KFD.fok, fok_blk, fok_blks Ms]

theorem fok_qop (Ms : List M2G) : NLogN.KFD.fok (qop Ms) = true := by
  have : (touch (blks Ms)).contains cG = false :=
    not_contains_of fun h => by have := touch_blks Ms cG h; revert this; decide
  simp only [qop, NLogN.KFD.fok, this, fok_blks, fok_mvK_eq]
  simp +decide [NLogN.KFD.scr]

end NLogN.KFB

