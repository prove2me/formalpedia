theorem GlobalTheory.HL.RatPat.main : ∀ {F E : Type} [Field F] [NumberField F] [Field E] [NumberField E] [Algebra F E] {sig : E →ₐ[F] E}
    (A : Places F E sig), ∀ (r k : ℕ) (G : GFrames A r k), ∀ t : Matrix (Fin (r + 1)) (Fin (r + 1)) E,
    (∀ i j, ¬ (i < j ∧ ∀ l : Fin (r + 2), ((i : Fin (r + 1)) : ℕ) < l → (l : ℕ) ≤ ((j : Fin (r + 1)) : ℕ) →
      G.D l = 0) → t i j = if i = j then 1 else 0) →
    ∃ g ∈ G.St, ∀ j, g (G.f j) = ∑ i, t i j • G.f i := by sorry
