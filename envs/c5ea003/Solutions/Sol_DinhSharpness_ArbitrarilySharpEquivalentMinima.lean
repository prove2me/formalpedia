section DinhSharpnessBundleModule2
/-!
The curvature step in Dinh et al., arXiv:1703.04933v2, Section 4.2,
Theorem 4, PDF pp. 5--6. A nonzero Hessian at a local minimum has a
positive diagonal entry. The local differentiability hypotheses are those
of the mission model, and positive semidefiniteness is proved from the minimum.
-/

noncomputable section

open scoped Topology
open Filter

namespace DinhSharpness

/-- The second derivative at a continuous local minimum is nonnegative.
Mathlib provides the second-derivative maximum test; combining the resulting
maximum with the minimum would make the function locally constant. -/
theorem second_deriv_nonneg_of_localMin {f : ℝ → ℝ} {x : ℝ}
    (hmin : IsLocalMin f x) (hc : ContinuousAt f x) :
    0 ≤ deriv (deriv f) x := by
  by_contra hn
  have hneg : deriv (deriv f) x < 0 := lt_of_not_ge hn
  have hmax := isLocalMax_of_deriv_deriv_neg hneg hmin.deriv_eq_zero hc
  have heq : f =ᶠ[𝓝 x] fun _ ↦ f x := by
    filter_upwards [hmin, hmax] with y hymin hymax
    exact le_antisymm hymax hymin
  have hz : deriv (deriv f) x = 0 := by
    simpa using heq.deriv.deriv_eq
  linarith

theorem hessian_symmetric {d h : ℕ} {L : Parameter d h → ℝ} {θ : Parameter d h}
    (hL : TwiceDifferentiableAt L θ) (u v : Parameter d h) :
    hessian L θ u v = hessian L θ v u := by
  apply second_derivative_symmetric_of_eventually
    (hL.1.mono fun z hz ↦ hz.hasFDerivAt) hL.2.hasFDerivAt

theorem hessian_self_nonneg {d h : ℕ} {L : Parameter d h → ℝ} {θ : Parameter d h}
    (hL : TwiceDifferentiableAt L θ) (hmin : IsLocalMin L θ) (u : Parameter d h) :
    0 ≤ hessian L θ u u := by
  let line : ℝ → Parameter d h := fun t ↦ θ + t • u
  have hline (t : ℝ) : HasDerivAt line u t := by
    simpa [line] using ((hasDerivAt_id t).smul_const u).const_add θ
  have hline0 : line 0 = θ := by simp [line]
  have hevent : ∀ᶠ t in 𝓝 (0 : ℝ), DifferentiableAt ℝ L (line t) := by
    have ht : Tendsto line (𝓝 0) (𝓝 θ) := by
      simpa only [hline0] using (hline 0).continuousAt.tendsto
    exact ht hL.1
  have hfirst : deriv (L ∘ line) =ᶠ[𝓝 (0 : ℝ)] fun t ↦ fderiv ℝ L (line t) u := by
    filter_upwards [hevent] with t ht
    exact (ht.hasFDerivAt.comp_hasDerivAt t (hline t)).deriv
  have hsecond : HasDerivAt (fun t ↦ fderiv ℝ L (line t) u) (hessian L θ u u) 0 := by
    have hc := hL.2.hasFDerivAt.comp_hasDerivAt_of_eq 0 (hline 0) hline0.symm
    simpa [Function.comp_def, hessian] using hc.clm_apply (hasDerivAt_const 0 u)
  have hminline : IsLocalMin (L ∘ line) 0 := by
    apply IsLocalMin.comp_continuous (g := line)
    · simpa [hline0] using hmin
    · exact (hline 0).continuousAt
  have hcline : ContinuousAt (L ∘ line) 0 :=
    ((hevent.self_of_nhds).hasFDerivAt.comp_hasDerivAt 0 (hline 0)).continuousAt
  rw [← hsecond.deriv, ← hfirst.deriv_eq]
  exact second_deriv_nonneg_of_localMin hminline hcline

/-- A nonzero symmetric positive semidefinite bilinear form has a positive
diagonal entry in the standard Euclidean basis. -/
theorem exists_positive_diagonal {ι : Type*} [Fintype ι] [DecidableEq ι]
    (B : EuclideanSpace ℝ ι →L[ℝ] EuclideanSpace ℝ ι →L[ℝ] ℝ)
    (hsym : ∀ u v, B u v = B v u) (hpos : ∀ u, 0 ≤ B u u) (hne : B ≠ 0) :
    ∃ i : ι, 0 < B (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) := by
  classical
  by_contra hn
  push Not at hn
  have hdiag (i : ι) : B (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) = 0 :=
    le_antisymm (hn i) (hpos _)
  have hcross (i j : ι) : B (EuclideanSpace.single i 1) (EuclideanSpace.single j 1) = 0 := by
    have hsum := hpos (EuclideanSpace.single i 1 + EuclideanSpace.single j 1)
    have hsub := hpos (EuclideanSpace.single i 1 - EuclideanSpace.single j 1)
    simp only [map_add, map_sub, ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      hdiag, hsym (EuclideanSpace.single j 1) (EuclideanSpace.single i 1)] at hsum hsub
    linarith
  apply hne
  apply ContinuousLinearMap.coe_injective
  apply (EuclideanSpace.basisFun ι ℝ).toBasis.ext
  intro i
  apply ContinuousLinearMap.coe_injective
  apply (EuclideanSpace.basisFun ι ℝ).toBasis.ext
  intro j
  simpa only [ContinuousLinearMap.coe_coe, ContinuousLinearMap.coe_zero,
    LinearMap.zero_apply, OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply,
    ContinuousLinearMap.zero_apply] using hcross i j

/-- The positive coordinate curvature used by Theorem 4's scaling argument. -/
theorem hessian_exists_positive_diagonal {d h : ℕ} {L : Parameter d h → ℝ}
    {θ : Parameter d h} (hL : TwiceDifferentiableAt L θ) (hmin : IsLocalMin L θ)
    (hne : hessian L θ ≠ 0) :
    ∃ i : Coordinate d h,
      0 < hessian L θ (EuclideanSpace.single i 1) (EuclideanSpace.single i 1) :=
  exists_positive_diagonal (hessian L θ) (hessian_symmetric hL)
    (hessian_self_nonneg hL hmin) hne

end DinhSharpness
end -- original EOF-open anonymous section
end DinhSharpnessBundleModule2
