private lemma leaves_eq_piFinset (π : Cube L) :
    Cube.leaves π = Fintype.piFinset fun ℓ => symbolTerms (π ℓ) := by
  ext τ
  rw [Cube.mem_leaves, Fintype.mem_piFinset]
  refine forall_congr' fun ℓ => ?_
  cases h : π ℓ <;> simp [symbolTerms, eq_comm]

