-- title:
--   Remark 2.4 — under the hypotheses of Theorem 2.2 the limit Y is a semimartingale
-- statement:
--   For each $n$ let $(\Omega_n,\mathcal F^n,P_n)$ be a probability space with filtration $\{\mathcal F^n_t\}$, let $X_n$ be an $\{\mathcal F^n_t\}$-adapted cadlag process with values in the $k\times m$ real matrices $\mathbb M^{km}$, and let $Y_n$ be an $\mathbb R^m$-valued $\{\mathcal F^n_t\}$-semimartingale. Fix $\delta\in(0,\infty]$, put $Y_n^\delta=Y_n-J_\delta(Y_n)$, and suppose $\{Y_n^\delta\}$ has decompositions satisfying C2.2(i). Let $(X,Y)$ be a cadlag process on a probability space $(\Omega',P')$. If $(X_n,Y_n)\Rightarrow(X,Y)$ in the Skorohod topology on $D_{\mathbb M^{km}\times\mathbb R^m}[0,\infty)$, then
--   $$Y\text{ is a semimartingale with respect to a filtration to which }X\text{ and }Y\text{ are adapted;}$$
--   precisely: there are a probability space with a filtration $\{\mathcal G_t\}$ and processes $(\tilde X,\tilde Y)$ on it with the law of $(X,Y)$, both $\{\mathcal G_t\}$-adapted, and $\tilde Y$ a $\{\mathcal G_t\}$-semimartingale.
--
--   This is the first half of the conclusion of Theorem 2.2; Remark 2.4 gives its proof through the filtration generated by the limit processes and the limits of the stopping times $\tau_n^\alpha$.
--
--   **Formalization Note** "$\Rightarrow$" is convergence in distribution in coupling form, of the *pair* $(X_n,Y_n)$ (one time change for both components). The semimartingale claim is made for a copy of $(X,Y)$ on a space that may carry extra randomness (the limits of the $\tau_n^\alpha$), which is what the remark's argument produces. C2.2(i) is read as in the definitions file: some decomposition, $t$ universally quantified, stopping times chosen before $t$.
-- source:
--   Kurtz and Protter, Weak Limit Theorems for Stochastic Integrals and Stochastic Differential Equations, Ann. Probab. 19 (1991), p. 1040, Remark 2.4 (and Theorem 2.2, p. 1039)

import Mathlib
import Definitions.Def_EthierKurtz_IsSourceLocalMartingale
import Definitions.Def_EthierKurtz_HasCrossVariation
import Definitions.Def_KurtzProtter91_Integrals_Skorohod
import Definitions.Def_KurtzProtter91_Integrals_Semimartingale

open Filter Topology MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace KurtzProtter91.Integrals

theorem remark_2_4 {k m : ℕ} {Ω : ℕ → Type*} [∀ n, MeasurableSpace (Ω n)]
    (P : ∀ n, Measure (Ω n)) [∀ n, IsProbabilityMeasure (P n)]
    (𝓕 : ∀ n, Filtration ℝ≥0 (‹∀ n, MeasurableSpace (Ω n)› n))
    (X : ∀ n, ℝ≥0 → Ω n → Fin k → Fin m → ℝ) (Y : ∀ n, ℝ≥0 → Ω n → Fin m → ℝ)
    (hXad : ∀ n, Adapted (𝓕 n) (X n)) (hXc : ∀ n ω, IsCadlag fun t => X n t ω)
    (hY : ∀ n, IsSemimartingale (𝓕 n) (P n) (Y n)) (δ : ℝ≥0∞) (hδ : 0 < δ)
    (hC : SatisfiesC22i P 𝓕 fun n t ω => Y n t ω - Jdelta δ (fun s => Y n s ω) t)
    {Ω' : Type*} [MeasurableSpace Ω'] (P' : Measure Ω') [IsProbabilityMeasure P']
    (X' : ℝ≥0 → Ω' → Fin k → Fin m → ℝ) (Y' : ℝ≥0 → Ω' → Fin m → ℝ)
    (hX'c : ∀ ω, IsCadlag fun t => X' t ω) (hY'c : ∀ ω, IsCadlag fun t => Y' t ω)
    (hconv : SkorohodConvInDist P (fun n t ω => (X n t ω, Y n t ω)) P'
      (fun t ω => (X' t ω, Y' t ω))) :
    ∃ (Ω'' : Type) (_ : MeasurableSpace Ω'') (P'' : Measure Ω'')
      (𝓖 : Filtration ℝ≥0 ‹MeasurableSpace Ω''›)
      (Xt : ℝ≥0 → Ω'' → Fin k → Fin m → ℝ) (Yt : ℝ≥0 → Ω'' → Fin m → ℝ),
      IsProbabilityMeasure P'' ∧
      IdentDistrib (fun ω t => (Xt t ω, Yt t ω)) (fun ω t => (X' t ω, Y' t ω)) P'' P' ∧
      Adapted 𝓖 Xt ∧ Adapted 𝓖 Yt ∧ IsSemimartingale 𝓖 P'' Yt := by sorry

end KurtzProtter91.Integrals
