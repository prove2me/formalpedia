variable {σ : Type*}
variable {ι : Type*} [DecidableEq ι] (w : σ → ℕ) (f : ι → MvPolynomial σ ℝ) (μ : ι → σ →₀ ℕ)
  (hf : ∀ l, TopTerm w (f l) (μ l)) (T : Finset ι) (N : ι)
  (hdisj : ∀ l ∈ T, Disjoint (μ N).support (μ l).support)
  (IH : ∀ h ∈ Ideal.span (f '' (T : Set ι)), ∀ d, DegLE w d h →
    weightedHomogeneousComponent w d h ∈ MI μ T)
include hf IH
lemma lift_base (d E : ℕ) (hEd : E ≤ d) (h' q : MvPolynomial σ ℝ)
    (hh' : h' ∈ Ideal.span (f '' (T : Set ι))) (hE : DegLE w E h')
    (hq : ∀ s ∈ q.support, Finsupp.weight w s + Finsupp.weight w (μ N) ≤ E) :
    weightedHomogeneousComponent w d (h' + q * f N) ∈ MI μ (insert N T) := by
  rw [map_add]
  refine add_mem (MI_mono μ T N (IH h' hh' d fun s hs => (hE s hs).trans hEd)) ?_
  by_cases hq0 : q = 0
  · simp [hq0]
  obtain ⟨s0, hs0⟩ := Finset.nonempty_of_ne_empty (mt support_eq_empty.1 hq0)
  have := hq s0 hs0
  rw [comp_mul_top (hf N) (e := d - Finsupp.weight w (μ N))
    (fun s hs => by have := hq s hs; omega) (by omega)]
  exact Ideal.mul_mem_left _ _ (mon_mem_MI μ T N)

omit [DecidableEq ι] in
include hdisj in
lemma lift_reduce (d E : ℕ) (hdE : d ≤ E) (h' q : MvPolynomial σ ℝ)
    (hh' : h' ∈ Ideal.span (f '' (T : Set ι))) (hE : DegLE w (E + 1) h')
    (hq : ∀ s ∈ q.support, Finsupp.weight w s + Finsupp.weight w (μ N) ≤ E + 1)
    (hd : DegLE w d (h' + q * f N)) :
    ∃ h'' q'' : MvPolynomial σ ℝ, h'' ∈ Ideal.span (f '' (T : Set ι)) ∧ DegLE w E h'' ∧
      (∀ s ∈ q''.support, Finsupp.weight w s + Finsupp.weight w (μ N) ≤ E) ∧
      h'' + q'' * f N = h' + q * f N := by
  classical
  by_cases hq0 : q = 0
  · subst hq0
    refine ⟨h', 0, hh', fun s hs => ?_, by simp, rfl⟩
    have := hd s (by simpa using hs)
    omega
  obtain ⟨s0, hs0⟩ := Finset.nonempty_of_ne_empty (mt support_eq_empty.1 hq0)
  have := hq s0 hs0
  set wN := Finsupp.weight w (μ N) with hwN
  set e := E + 1 - wN with he
  have hqe : DegLE w e q := fun s hs => by have := hq s hs; omega
  set c := weightedHomogeneousComponent w e q with hc
  -- the top component vanishes
  have h0 : weightedHomogeneousComponent w (E + 1) (h' + q * f N) = 0 :=
    weightedHomogeneousComponent_eq_zero' _ _ fun s hs => by have := hd s hs; omega
  rw [map_add, comp_mul_top (hf N) hqe (by omega)] at h0
  have hmem : monomial (μ N) 1 * c ∈ monIdeal (fun l : T => μ l) := by
    rw [← MI_eq, mul_comm, eq_neg_of_add_eq_zero_right h0]
    exact neg_mem (IH h' hh' (E + 1) hE)
  have hcI := colon (fun l : T => μ l) (μ N) (fun l => hdisj l l.2) 1 one_ne_zero c hmem
  obtain ⟨cl, hcsum, hcl⟩ := homog_decomp w (fun l : T => μ l) hcI
    (weightedHomogeneousComponent_isWeightedHomogeneous e q)
  have hq'' : ∀ s ∈ (q - c - ∑ l : T, cl l * (f l - monomial (μ l) 1)).support,
      Finsupp.weight w s + wN ≤ E := by
    intro s hs
    have hlt : Finsupp.weight w s < e := by
      rcases Finset.mem_union.1 (support_sub _ _ _ hs) with h1 | h1
      · rw [mem_support_iff, coeff_sub, hc, coeff_weightedHomogeneousComponent] at h1
        split_ifs at h1 with hse
        · simp at h1
        · rw [sub_zero] at h1
          have := hqe s (mem_support_iff.2 h1)
          omega
      · obtain ⟨l, -, hl⟩ := Finset.mem_biUnion.1 (support_sum h1)
        obtain ⟨u, hu, v, hv, rfl⟩ := mem_support_mul' hl
        have hu' := (hcl l).1 (mem_support_iff.1 hu)
        have hne : cl l ≠ 0 := fun h0 => by simp [h0] at hu
        have hle := (hcl l).2 hne
        have hv' := hf l v hv
        rw [map_add]
        omega
    omega
  have heq : (h' + ∑ l : T, (cl l * f N) * f l) +
      (q - c - ∑ l : T, cl l * (f l - monomial (μ l) 1)) * f N = h' + q * f N := by
    have : ∑ l : T, (cl l * f N) * f l -
        (∑ l : T, cl l * (f l - monomial (μ l) 1)) * f N = c * f N := by
      rw [hcsum, Finset.sum_mul, Finset.sum_mul, ← Finset.sum_sub_distrib]
      exact Finset.sum_congr rfl fun l _ => by ring
    linear_combination this
  refine ⟨_, _, ?_, ?_, hq'', heq⟩
  · refine add_mem hh' (Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ ?_)
    exact Ideal.subset_span ⟨l, l.2, rfl⟩
  · intro s hs
    have hs' : s ∈ ((h' + q * f N) -
        (q - c - ∑ l : T, cl l * (f l - monomial (μ l) 1)) * f N).support := by
      convert hs using 2
      rw [← heq]
      ring
    rcases Finset.mem_union.1 (support_sub _ _ _ hs') with h1 | h1
    · have := hd s h1
      omega
    · obtain ⟨u, hu, v, hv, rfl⟩ := mem_support_mul' h1
      have := hq'' u hu
      have := topTerm_degLE (hf N) v hv
      rw [map_add]
      omega

include hdisj in
lemma lift_insert (d E : ℕ) : ∀ (h' q : MvPolynomial σ ℝ),
    h' ∈ Ideal.span (f '' (T : Set ι)) → DegLE w E h' →
    (∀ s ∈ q.support, Finsupp.weight w s + Finsupp.weight w (μ N) ≤ E) →
    DegLE w d (h' + q * f N) →
    weightedHomogeneousComponent w d (h' + q * f N) ∈ MI μ (insert N T) := by
  induction E with
  | zero =>
    intro h' q hh' hE hq _
    exact lift_base w f μ hf T N IH d 0 (Nat.zero_le _) h' q hh' hE hq
  | succ E ih =>
    intro h' q hh' hE hq hd
    by_cases hEd : E + 1 ≤ d
    · exact lift_base w f μ hf T N IH d (E + 1) hEd h' q hh' hE hq
    obtain ⟨h'', q'', hh'', hE'', hq'', heq⟩ :=
      lift_reduce w f μ hf T N hdisj IH d E (by omega) h' q hh' hE hq hd
    rw [← heq] at hd ⊢
    exact ih h'' q'' hh'' hE'' hq'' hd

