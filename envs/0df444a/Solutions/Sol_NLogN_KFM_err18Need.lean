section Rounds

variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ} (C : CoeffModel y r)
variable {D : ℕ} {sh : Shape} {ι : Type} [Fintype ι] [DecidableEq ι]

theorem getD_map_co (xs : List R) (j : ℕ) : (xs.map C.co).getD j 0 = C.co (xs.getD j 0) := by
  rw [← map_zero C.co, List.getD_map]

theorem co_twL (Ex : ℕ → ℤ) (zs : List R) :
    (twL y sh Ex zs).map C.co = twLc r sh Ex (zs.map C.co) := by
  unfold twL twLc
  rw [List.map_map]
  apply List.map_congr_left
  intro j _
  simp only [Function.comp_apply]
  rw [co_yp_mul C, getD_map_co]

theorem co_layerQ (p : ℕ) (Sb : SelBits sh ι) (xs : List R) :
    (layerQ C p Sb xs).map C.co = layerQc p Sb (xs.map C.co) := by
  unfold layerQ layerQc QpArr
  rw [← co_selOp, List.map_map, List.map_map]
  apply List.map_congr_left
  intro z _
  simp [co_QpR]

theorem co_compR (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List R) :
    (compR C p Sb Ex xs).map C.co = compRc p Sb Ex (xs.map C.co) := by
  unfold compR compRc
  rw [co_twL, co_layerQ]

theorem co_compRI (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ) (xs : List R) :
    (compRI y C p Sb Ex xs).map C.co = compRIc p Sb Ex (xs.map C.co) := by
  unfold compRI compRIc
  rw [co_layerQ, co_twL]

theorem co_procQ (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ∀ n (xs : List R), (procQ C p L ℓ P Sb n xs).map C.co = procQc p L ℓ P Sb n (xs.map C.co)
  | 0, _ => rfl
  | n + 1, xs => by
    unfold procQ procQc
    rw [runDown, runDown]
    have := co_procQ p L ℓ P Sb n (compR C p (Sb n) (roundEx L ℓ n (P n)) xs)
    unfold procQ procQc at this
    rw [this, co_compR]

theorem co_foldl_RI (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ∀ (l : List ℕ) (xs : List R),
      (l.foldl (fun u k => compRI y C p (Sb k) (roundEx L ℓ k (P k)) u) xs).map C.co =
        l.foldl (fun u k => compRIc p (Sb k) (roundEx L ℓ k (P k)) u) (xs.map C.co)
  | [], _ => rfl
  | k :: l, xs => by
    simp only [List.foldl_cons]
    rw [co_foldl_RI p L ℓ P Sb l, co_compRI]

theorem co_procQI (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (n : ℕ) (xs : List R) :
    (procQI y L C p ℓ P Sb n xs).map C.co = procQIc p L ℓ P Sb n (xs.map C.co) :=
  co_foldl_RI C p L ℓ P Sb _ xs

end Rounds

