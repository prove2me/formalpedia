-- Prove2me | Theorems.Thm_MomentPolytopes_QuantumFunctionals_theorem_7_6
-- name    : MomentPolytopes.QuantumFunctionals.theorem_7_6
-- status  : Open
-- author  : @Shuze Chen
-- created : 2026-11-11T01:06:11.986885+00:00
-- url     : https://prove2.me/theorems/3b8e24d4-a1d9-4c19-8376-63c3205ad4cd
-- title:
--   Theorem 7.6 — entropic tensor scaling: 0 ≤ E_θ(T) − Σ_ℓ θ_ℓ H((ρ_k)_ℓ) ≤ 2(log‖T‖ − log Cap_{p⋆}(T))/k, and ≤ poly(d, n_max, ⟨T⟩)/k for Gaussian-integer T
-- statement:
--   Let $\theta$ be a probability distribution on $[d]$, let $T\in\mathrm{Ten}(n_0;n_1,\dots,n_d)\setminus\{0\}$ be a concise tensor tuple, and let $(T_k)_{k\in\mathbb N}$ be the sequence generated by entropic tensor scaling,
--   $$T_{k+1}=\Big(I\otimes\bigotimes_{\ell=1}^d\rho_\ell^{-\theta_\ell/2}\Big)T_k,\qquad(\rho_1,\dots,\rho_d)=\mu(T_k),\qquad T_0=T .$$
--   Write $((\rho_k)_1,\dots,(\rho_k)_d)=\mu(T_k)$ for the one-body quantum marginals of $T_k$. Then for every $k\ge1$ and every minimizer $p^\star$ of $\phi_\theta$ on $\Delta(T)$,
--   $$0\ \le\ E_\theta(T)-\sum_{\ell\in[d]}\theta_\ell H\big((\rho_k)_\ell\big)\ \le\ \frac{2\big(\log\|T\|-\log\operatorname{Cap}_{p^\star}(T)\big)}{k}.$$
--   Moreover, there is one polynomial bound $C(1+d+n_{\max}+\langle T\rangle)^c$, fixed before $d,n_0,\dots,n_d,\theta,T,p^\star,k$, such that whenever $T$ in addition has Gaussian integer entries, the right-hand side is at most $C(1+d+n_{\max}+\langle T\rangle)^c/k$, where $n_{\max}=\max_\ell n_\ell$ and $\langle T\rangle$ is the bit-length of $T$.
--
--   This is the paper's main algorithmic result (Theorem 1.5): entropic tensor scaling approximates the logarithmic quantum functional $E_\theta(T)$ to additive error $\varepsilon$ in a number of iterations linear in $1/\varepsilon$ and polynomial in the input size.
--
--   Differences from the source:
--   - encoding: ℓ ∈ [d] = {1, …, d} → ℓ : Fin d (0-based); reason: indexing convention; same instances
--   - encoding: H(X) = −tr[X log X] on PSD matrices → vnEntropy X = Shannon entropy of the sorted spectrum (natural log, 0 log 0 = 0); reason: same value on PSD matrices
--   - encoding: log Cap and log cap in [−∞, ∞) → EReal, −∞ = ⊥; the bound is an EReal inequality; reason: Lean convention; same values, no junk value for −∞
--   - reading: ⟨T⟩, 'the bit-length of the tensor tuple' (not defined in the paper) → bitLength T = ∑ over entries a + bi of (1 + Nat.size |a|) + (1 + Nat.size |b|); reason: standard binary encoding length; any encoding within a constant factor gives the same polynomial bound
--   - encoding: E_θ(T) = max_{p∈Δ(T)} ∑_ℓ θ_ℓ H(p_ℓ) → logQuantumFunctional θ T = real sSup of the image of Δ(T); reason: Δ(T) is nonempty and compact for T ≠ 0 and the function is continuous, so the sup is the max
--   - encoding: poly(d, n_max, ⟨T⟩) → C(1 + d + n_max + ⟨T⟩)^c, with C and c existentially quantified before every instance; reason: every polynomial in these arguments is bounded by such an expression and conversely; one polynomial for all instances
--   - encoding: division by k → EReal division by the positive real k; reason: same value for k ≥ 1
-- source:
--   Doğan, Sakabe, Walter, Convex optimization on moment polytopes, arXiv:2609.06633 (PDF sha256 fcf40771…), p. 57, Theorem 7.6 (= Theorem 1.5, p. 11)

import Mathlib
import Definitions.Def_MomentPolytopes_QuantumFunctionals_Spectra
import Definitions.Def_MomentPolytopes_QuantumFunctionals_TensorAction
import Definitions.Def_MomentPolytopes_QuantumFunctionals_EntanglementPolytope
import Definitions.Def_MomentPolytopes_QuantumFunctionals_QuantumFunctional
import Definitions.Def_MomentPolytopes_QuantumFunctionals_EntropicScaling
import Definitions.Def_MomentPolytopes_QuantumFunctionals_Capacity
import Definitions.Def_MomentPolytopes_QuantumFunctionals_GaussianInteger

set_option autoImplicit false

open scoped ComplexOrder Matrix

namespace MomentPolytopes.QuantumFunctionals

/-- Theorem 7.6 (p. 57; Theorem 1.5, p. 11). For every probability distribution `θ` on `[d]`,
every nonzero concise tensor tuple `T`, every minimizer `p⋆` of `ϕ_θ` on `Δ(T)` and every
`k ≥ 1`, the `k`-th iterate of entropic tensor scaling (7.5) with `η = 1` satisfies
`0 ≤ E_θ(T) − ∑_ℓ θ_ℓ H((ρ_k)_ℓ) ≤ 2 (log‖T‖ − log Cap_{p⋆}(T)) / k`,
`((ρ_k)_1, …, (ρ_k)_d) = µ(T_k)`. Moreover one polynomial `C (1 + d + n_max + ⟨T⟩)^c`, fixed
before the instance, bounds the right-hand side by `poly(d, n_max, ⟨T⟩)/k` whenever `T` has
Gaussian integer entries. -/
theorem theorem_7_6 :
    (∀ (d n0 : ℕ) (n : Fin d → ℕ) (θ : Fin d → ℝ), IsProbVec θ →
      ∀ T : Ten d n0 n, T ≠ 0 → IsConcise T →
      ∀ pstar ∈ entanglementPolytope T,
        (∀ p ∈ entanglementPolytope T, phiTheta θ pstar ≤ phiTheta θ p) →
      ∀ k : ℕ, 1 ≤ k →
        0 ≤ logQuantumFunctional θ T -
            ∑ ℓ, θ ℓ * vnEntropy (momentMap (entropicScalingSeq 1 θ T k) ℓ) ∧
        (((logQuantumFunctional θ T -
            ∑ ℓ, θ ℓ * vnEntropy (momentMap (entropicScalingSeq 1 θ T k) ℓ) : ℝ)) : EReal) ≤
          ((2 : ℝ) : EReal) * ((Real.log (tnorm T) : EReal) - logCap pstar T) /
            ((k : ℝ) : EReal)) ∧
    (∃ C : ℝ, ∃ c : ℕ, ∀ (d n0 : ℕ) (n : Fin d → ℕ) (θ : Fin d → ℝ), IsProbVec θ →
      ∀ T : Ten d n0 n, T ≠ 0 → IsConcise T → IsGaussianInteger T →
      ∀ pstar ∈ entanglementPolytope T,
        (∀ p ∈ entanglementPolytope T, phiTheta θ pstar ≤ phiTheta θ p) →
      ∀ k : ℕ, 1 ≤ k →
        ((2 : ℝ) : EReal) * ((Real.log (tnorm T) : EReal) - logCap pstar T) /
            ((k : ℝ) : EReal) ≤
          ((C * (1 + d + nmax n + bitLength T : ℝ) ^ c / k : ℝ) : EReal)) := by sorry

end MomentPolytopes.QuantumFunctionals
