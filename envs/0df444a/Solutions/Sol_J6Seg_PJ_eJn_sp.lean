/-!
# B5 chunk side, part 10: the native set-up pair `eCn` / `tearP`

`eCn = initP rg; eCcore; finiP rg; distAll oN`: from the descriptor alone on `Zn` to the
chunk-pass register file `kerRegs …` on `oN` (`eCn_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

theorem kerRegs_vals (w f pre nc post : ℕ) (T : List ℤ) (i : Fin 9) :
    kerRegs w w f pre nc post T (Fin.castLE (by omega) i) = [(cVals w f pre nc post).getD i 0] := by
  fin_cases i <;> simp [kerRegs, cVals]

theorem kerRegs_hi (w f pre nc post : ℕ) (T : List ℤ) (i : Fin 19) (h : 11 ≤ i.val) :
    kerRegs w w f pre nc post T i = [] := by
  unfold kerRegs
  simp only [show i.val ≠ 0 by omega, show i.val ≠ 1 by omega, show i.val ≠ 2 by omega,
    show i.val ≠ 3 by omega, show i.val ≠ 4 by omega, show i.val ≠ 5 by omega,
    show i.val ≠ 6 by omega, show i.val ≠ 7 by omega, show i.val ≠ 8 by omega,
    show i.val ≠ 9 by omega, show i.val ≠ 10 by omega, if_false]

theorem extend_clean (oN : Fin 19 → Fin HS) (hinj : Injective oN) (V : Fin 19 → List ℤ) (G : Cs)
    (a b c : List ℤ) (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC)
    (hX : G sX = []) (hL : G sLn = []) (hO : G sOut = []) :
    update (update (update (extend oN V (update (update (update G sX a) sOut b) sLn c)) sX [])
      sLn []) sOut [] = extend oN V G := by
  funext j
  by_cases hj : ∃ i, oN i = j
  · obtain ⟨i, rfl⟩ := hj
    obtain ⟨a1, a2, a3, -, -⟩ := hx i
    rw [update_of_ne a3, update_of_ne a2, update_of_ne a1, hinj.extend_apply, hinj.extend_apply]
  · rw [extend_apply' _ _ _ hj]
    by_cases jO : j = sOut
    · subst jO; rw [update_self, hO]
    rw [update_of_ne jO]
    by_cases jL : j = sLn
    · subst jL; rw [update_self, hL]
    rw [update_of_ne jL]
    by_cases jX : j = sX
    · subst jX; rw [update_self, hX]
    rw [update_of_ne jX, extend_apply' _ _ _ hj, update_of_ne jL, update_of_ne jO, update_of_ne jX]

end J6Seg.PJ

