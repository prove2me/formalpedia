theorem Subalgebra.exists_valuationSubring_centre {R F : Type*} [CommRing R] [Field F] [Algebra R F]
    (B : Subalgebra R F) (𝔮 : Ideal ↥B) [𝔮.IsPrime] :
    ∃ V : ValuationSubring F, (LocalSubring.ofPrime B.toSubring 𝔮).toSubring ≤ V.toSubring ∧
      (∀ b : ↥B, (b : F) ∈ V) ∧ ∀ b : ↥B, b ∈ 𝔮 ↔ (b : F) ∈ V.nonunits := by
  obtain ⟨V, hV⟩ := (LocalSubring.ofPrime B.toSubring 𝔮).exists_le_valuationSubring
  obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hV
  have hBV : ∀ b : ↥B, (b : F) ∈ V := fun b => hle (LocalSubring.le_ofPrime B.toSubring 𝔮 b.2)
  refine ⟨V, hle, hBV, fun b => ?_⟩

  let 𝔮' : Ideal ↥B.toSubring := 𝔮
  have key : b ∈ 𝔮 ↔ algebraMap ↥B.toSubring ↥(LocalSubring.ofPrime B.toSubring 𝔮').toSubring b ∈
      maximalIdeal ↥(LocalSubring.ofPrime B.toSubring 𝔮').toSubring :=
    (IsLocalization.AtPrime.to_map_mem_maximal_iff _ 𝔮' b).symm
  rw [key, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  show ¬ _ ↔ ((⟨(b : F), hBV b⟩ : ↥V) : F) ∈ V.nonunits
  rw [ValuationSubring.coe_mem_nonunits_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_iff_not]
  constructor
  · intro hu; exact hu.map (Subring.inclusion hle)
  · intro hu; exact hloc.map_nonunit _ hu

