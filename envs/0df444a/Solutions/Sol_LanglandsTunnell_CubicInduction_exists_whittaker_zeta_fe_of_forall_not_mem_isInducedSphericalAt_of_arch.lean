private theorem isKFinite_comp_mul (τ : GL (Fin 3) (InfiniteAdeleRing ℚ)) {W : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ}
    (h : IsKFinite W) : IsKFinite fun g => W (τ * g) := by
  classical
  obtain ⟨S, hS⟩ := h
  refine ⟨S.image fun f => f ∘ fun x => τ * x, fun k hk => ?_⟩
  have e : (fun x => W (τ * (x * k))) = (fun x => W (x * k)) ∘ fun x => τ * x :=
    funext fun x => congrArg W (mul_assoc τ x k).symm
  have hmem := Submodule.apply_mem_span_image_of_mem_span
    (LinearMap.funLeft ℂ ℂ fun x : GL (Fin 3) (InfiniteAdeleRing ℚ) => τ * x) (hS k hk)
  show (fun x => W (τ * (x * k))) ∈ _
  rw [e, Finset.coe_image]
  exact hmem

end
