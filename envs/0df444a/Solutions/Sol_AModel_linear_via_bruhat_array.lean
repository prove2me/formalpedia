lemma vmap_id {a : List ℕ} (ha : Valid sh a) : vmap Λ id a = a := setAct_act Λ ha

lemma amap_eq_vmap (L : Matrix (Fin n) (Fin n) (ZMod Q)) : amap Λ L = vmap Λ (L *ᵥ ·) := rfl

lemma valid_amap [NeZero Q] (L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
