theorem natAbs_tdiv_le (a b : ℤ) : (a.tdiv b).natAbs ≤ a.natAbs := by
  rw [Int.natAbs_tdiv]; exact Nat.div_le_self _ _

theorem getD_natAbs_lt {l : List ℤ} {m : ℕ} (h : ∀ y ∈ l, zsz y ≤ m) (k : ℕ) :
    (l.getD k 0).natAbs < 2 ^ m := by
  rw [List.getD_eq_getElem?_getD]
  cases hk : l[k]? with
  | none => simp
  | some y => simpa using zsz_le_iff.1 (h y (List.mem_of_getElem? hk))

/-- Accumulator entries stay below `(j + 1) 2^{2m}` after `j` rounds. -/
theorem bandF_take_bound (R : ℤ) (Dl : List ℕ) (Ws : List (List ℤ)) (X acc : List ℤ) (m B : ℕ)
    (hX : ∀ y ∈ X, zsz y ≤ m) (hW : ∀ W ∈ Ws, ∀ y ∈ W, zsz y ≤ m)
    (hA : ∀ y ∈ acc, zsz y ≤ 2 * m) (hB : (Ws.length + 1) * 2 ^ (2 * m) ≤ 2 ^ B) :
    ∀ j ≤ Ws.length, ∀ y ∈ bandF R Dl (Ws.take j) X acc, zsz y ≤ B := by
  intro j hj y hy
  obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hy
  have hk' : k < acc.length := by rwa [bandF_length] at hk
  have e := bandF_getD R Dl (Ws.take j) X acc k hk'
  rw [List.getD_eq_getElem _ _ hk] at e
  rw [e]
  apply zsz_le_of_lt
  have h1 : (acc.getD k 0).natAbs < 2 ^ (2 * m) := getD_natAbs_lt hA k
  have h2 : ∀ i ∈ Finset.range (Ws.take j).length,
      ((((Ws.take j).getD i []).getD k 0 * X.getD (NLogN.Rsp.pre Dl (k + 1) + i) 0).tdiv R).natAbs
        ≤ 2 ^ (2 * m) := by
    intro i _
    refine le_trans (natAbs_tdiv_le _ _) ?_
    rw [Int.natAbs_mul, two_mul, pow_add]
    apply Nat.mul_le_mul
    · apply le_of_lt; apply getD_natAbs_lt
      intro y hy
      rw [List.getD_eq_getElem?_getD] at hy
      cases hi : (Ws.take j)[i]? with
      | none => simp [hi] at hy
      | some W =>
        simp only [hi, Option.getD_some] at hy
        exact hW W (List.mem_of_mem_take (List.mem_of_getElem? hi)) y hy
    · exact le_of_lt (getD_natAbs_lt hX _)
  have h3 := Finset.sum_le_sum h2
  have h4 := Finset.abs_sum_le_sum_abs (fun i => ((((Ws.take j).getD i []).getD k 0 *
      X.getD (NLogN.Rsp.pre Dl (k + 1) + i) 0).tdiv R)) (Finset.range (Ws.take j).length)
  simp only [Finset.sum_const, Finset.card_range, smul_eq_mul, List.length_take] at h3
  have hmin : min j Ws.length ≤ Ws.length := min_le_right _ _
  have h5 : (min j Ws.length) * 2 ^ (2 * m) ≤ Ws.length * 2 ^ (2 * m) := Nat.mul_le_mul_right _ hmin
  zify at h1 h3 h5 hB ⊢
  have := abs_add_le (acc.getD k 0) (∑ i ∈ Finset.range (List.take j Ws).length,
    (((Ws.take j).getD i []).getD k 0 * X.getD (NLogN.Rsp.pre Dl (k + 1) + i) 0).tdiv R)
  simp only [List.length_take] at h4 this ⊢
  linarith

end NLogN.Rsp

