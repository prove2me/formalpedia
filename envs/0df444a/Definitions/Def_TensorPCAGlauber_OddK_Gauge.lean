-- title:
--   Average-gradient gauge transformation (eq. (71), Lemmas 6.5–6.6), $H_{null}$, $H_{sig}$, the planted law $P$ and null law $Q$ (Definitions 6.7–6.8) and the joint filtration $(\mathcal G_t)$
-- statement:
--   Let $H_0^\perp(x)=H_0(x)-\langle\zeta,x\rangle$. For a fixed $x^\star$ set (eq. (71)) $\xi_i=x^\star_i\zeta_i$, $U_i=\lambda\sigma_N^2+\xi_i$, $\varphi_i=\mathrm{sgn}(U_i)$, $R_i=|U_i|$. The gauge map is $y\mapsto x^\star\odot\varphi\odot y$; $W(y)=H_0^\perp(x^\star\odot\varphi\odot y)$, $m_\varphi(y)=m(x^\star\odot\varphi\odot y)$, $H_\varphi(y)=H(x^\star\odot\varphi\odot y)$, and $Y_t(e)=x^\star\odot\varphi\odot X_t(x^\star\odot\varphi\odot e)$, where $X_t(e')$ is Glauber dynamics for $H$ at $\beta$ from $e'$. In an environment $(\varphi,R,W)$,
--   $$H_{null}(y)=\langle R,y\rangle+W(y),\qquad H_{sig}(y)=N\lambda\,m_\varphi(y)^k-N\lambda\sigma_N^2\,m_\varphi(y),\qquad m_\varphi(y)=N^{-1}\langle\varphi,y\rangle .$$
--   The **planted law** $P$ (Definition 6.7): $U_i$ i.i.d. $N(\lambda\sigma_N^2,\sigma_N^2)$, $(\varphi,R)=(\mathrm{sgn}U,|U|)$, $W$ independent with the law of $H_0^\perp$, and given the environment, Glauber dynamics at $\beta$ for $H_{null}+H_{sig}$ from $Y_0=e$. The **null law** $Q$ (Definition 6.8): $\varphi_i$ i.i.d. uniform signs, $R_i=|U_i|$ with $U_i$ i.i.d. $N(0,\sigma_N^2)$ independent of $\varphi$, $W$ as before, and Glauber dynamics at $\beta$ for $H_{null}$ from $e$. Both are laws on the canonical space of environments and marks $(T_n,I_n,Z_n)_{n\ge1}$; the trajectory is reconstructed from $e$ and the marks. The joint filtration $\mathcal G_t$ is generated by $(\varphi,R,W)$ and the marks with $T_n\le t$.
--
--   **Formalization Note.** $P$ and $Q$ are given as pushforwards of explicit driving measures (`plantedDriveMeasure`, `nullDriveMeasure`) under `plantedCanon` / `nullCanon`; probabilities are written as the driving measure of the preimage, which avoids `Measure.map` (zero on a non-measurable map). $W$ is realised as $H_0^\perp$ of an independent copy of $G'$, which gives it exactly the law of $H_0^\perp$ and independence from $(\varphi,R)$. `jointFiltration N t` is a `MeasurableSpace` on `Canon N` generated by the environment and by the events $\{T_n\le t,\ (T_n,I_n,Z_n)\in S\}$.
-- source:
--   Das & Schramm, Averaged Annealed Markov Chains Achieve the Algorithmic Threshold for Tensor PCA, Part I: Glauber Dynamics, arXiv:2610.16705 (PDF of 2026-11-03, sha256 b1d9d241…), pp. 43–46 (PDF 46–49), Lemma 6.5, eq. (71), Lemma 6.6, Definitions 6.7–6.8; p. 48 (PDF 51), Theorem 6.10

import Mathlib
import Definitions.Def_TensorPCAGlauber_OddK_Hypercube
import Definitions.Def_TensorPCAGlauber_OddK_Model
import Definitions.Def_TensorPCAGlauber_OddK_Glauber

open MeasureTheory ProbabilityTheory

namespace TensorPCAGlauber.OddK

/-! ### The average-gradient gauge transformation (§6.3, eq. (71), Lemmas 6.5–6.6) -/

/-- `H_0^⊥(x) = H_0(x) − ⟨ζ, x⟩` (Lemma 6.5), with `ζ = E_π[∇_Ω H_0]`. -/
noncomputable def H0perp (k N : ℕ) (G' : KTensor k N) (x : Cube N) : ℝ :=
  H0 k N G' x - dot (zeta k N G') (vec x)

/-- `U_i = λσ²_N + ξ_i` with `ξ_i = x⋆_i ζ_i` (eq. (71)). -/
noncomputable def gaugeU (k N : ℕ) (lam : ℝ) (xstar : Cube N) (G' : KTensor k N) : Fin N → ℝ :=
  fun i => lam * sigmaSq k N + vec xstar i * zeta k N G' i

/-- `φ_i = sgn(U_i)` (eq. (71)), with `sgn 0 = +1`. -/
noncomputable def gaugePhi (k N : ℕ) (lam : ℝ) (xstar : Cube N) (G' : KTensor k N) : Cube N :=
  sgnCube (gaugeU k N lam xstar G')

/-- `R_i = |U_i|` (eq. (71)). -/
noncomputable def gaugeR (k N : ℕ) (lam : ℝ) (xstar : Cube N) (G' : KTensor k N) : Fin N → ℝ :=
  fun i => |gaugeU k N lam xstar G' i|

/-- The gauge map `y ↦ x⋆ ⊙ φ ⊙ y` (an involution of `Ω_N`). -/
def gaugeMap {N : ℕ} (xstar φ y : Cube N) : Cube N := hadamard (hadamard xstar φ) y

/-- `W(y) = H_0^⊥(x⋆ ⊙ φ ⊙ y)` (Lemma 6.6). -/
noncomputable def gaugeW (k N : ℕ) (lam : ℝ) (xstar : Cube N) (G' : KTensor k N) (y : Cube N) :
    ℝ :=
  H0perp k N G' (gaugeMap xstar (gaugePhi k N lam xstar G') y)

/-- The gauge-transformed correlation `m_φ(y) = m(x⋆ ⊙ φ ⊙ y)` (Lemma 6.6). -/
noncomputable def gaugeCorr {N : ℕ} (xstar φ y : Cube N) : ℝ := corr xstar (gaugeMap xstar φ y)

/-- The gauge-transformed Hamiltonian `H_φ(y) = H(x⋆ ⊙ φ ⊙ y)` (Lemma 6.6), `φ = gaugePhi`. -/
noncomputable def gaugeH (k N : ℕ) (lam : ℝ) (xstar : Cube N) (G' : KTensor k N) (y : Cube N) :
    ℝ :=
  tpcaH k N lam xstar G' (gaugeMap xstar (gaugePhi k N lam xstar G') y)

/-- The gauge-transformed trajectory `Y_t(e) = x⋆ ⊙ φ ⊙ X_t(x⋆ ⊙ φ ⊙ e)`, where `X_t(e')` is
Glauber dynamics for `H` at `β` started at `e'` (§6.3). -/
noncomputable def gaugeTraj (k N : ℕ) (lam β : ℝ) (xstar : Cube N) (G' : KTensor k N)
    (e : Cube N) (ω : Noise N) (t : ℝ) : Cube N :=
  let φ := gaugePhi k N lam xstar G'
  gaugeMap xstar φ (glauberPath (tpcaH k N lam xstar G') β (gaugeMap xstar φ e) ω t)

/-! ### The environment Hamiltonians and the planted and null laws (Definitions 6.7–6.8) -/

/-- `m_φ(y) = N^{−1}⟨φ, y⟩`, the correlation in gauge coordinates as a function of the
environment sign vector `φ`. -/
noncomputable def envCorr {N : ℕ} (φ y : Cube N) : ℝ := (N : ℝ)⁻¹ * dot (vec φ) (vec y)

/-- `H_null(y) = ⟨R, y⟩ + W(y)` (Lemma 6.6). -/
noncomputable def Hnull {N : ℕ} (R : Fin N → ℝ) (W : Cube N → ℝ) (y : Cube N) : ℝ :=
  dot R (vec y) + W y

/-- `H_sig(y) = Nλ m_φ(y)^k − Nλσ²_N m_φ(y)` (Lemma 6.6). -/
noncomputable def Hsig (k N : ℕ) (lam : ℝ) (φ y : Cube N) : ℝ :=
  N * lam * envCorr φ y ^ k - N * lam * sigmaSq k N * envCorr φ y

/-- The planted Hamiltonian in the environment `(φ, R, W)`:
`H_φ(y) = ⟨R, y⟩ + W(y) + Nλ m_φ(y)^k − Nλσ²_N m_φ(y)` (Definition 6.7(3)). -/
noncomputable def Hplanted (k N : ℕ) (lam : ℝ) (φ : Cube N) (R : Fin N → ℝ) (W : Cube N → ℝ)
    (y : Cube N) : ℝ :=
  Hnull R W y + Hsig k N lam φ y

/-- The environment `(φ, R, W) ∈ Ω_N × ℝ^N × ℝ^{Ω_N}`. -/
abbrev Env (N : ℕ) := Cube N × (Fin N → ℝ) × (Cube N → ℝ)

/-- The driving space of the planted law `P` (Definition 6.7): `U ∈ ℝ^N` (so `φ = sgn U`,
`R = |U|`), the raw Gaussian tensor `G'` (so `W = H_0^⊥` built from `G'`), and the Glauber noise. -/
abbrev PlantedDrive (k N : ℕ) := (Fin N → ℝ) × KTensor k N × Noise N

/-- Law of the planted driving variables: `U_i` i.i.d. `N(λσ²_N, σ²_N)`, `G'` with i.i.d. `N(0,1)`
entries, and the Glauber noise, all independent. -/
noncomputable def plantedDriveMeasure (k N : ℕ) (lam : ℝ) : Measure (PlantedDrive k N) :=
  (Measure.pi fun _ : Fin N => gaussianReal (lam * sigmaSq k N) (sigmaSq k N).toNNReal).prod
    ((disorderMeasure k N).prod (noiseMeasure N))

/-- The environment under `P`: `(φ, R, W) = (sgn U, |U|, H_0^⊥)`. -/
noncomputable def plantedEnv {k N : ℕ} (d : PlantedDrive k N) : Env N :=
  (sgnCube d.1, fun i => |d.1 i|, H0perp k N d.2.1)

/-- The driving space of the null law `Q` (Definition 6.8): `φ ∈ Ω_N`, `U ∈ ℝ^N` (so `R = |U|`),
the raw Gaussian tensor `G'` (so `W = H_0^⊥`), and the Glauber noise. -/
abbrev NullDrive (k N : ℕ) := Cube N × (Fin N → ℝ) × KTensor k N × Noise N

/-- Law of the null driving variables: `φ ∼ π` (i.i.d. uniform signs), `U_i` i.i.d.
`N(0, σ²_N)`, `G'` with i.i.d. `N(0,1)` entries, and the Glauber noise, all independent. -/
noncomputable def nullDriveMeasure (k N : ℕ) : Measure (NullDrive k N) :=
  (piMeasure N).prod ((Measure.pi fun _ : Fin N => gaussianReal 0 (sigmaSq k N).toNNReal).prod
    ((disorderMeasure k N).prod (noiseMeasure N)))

/-- The environment under `Q`: `(φ, R, W) = (φ, |U|, H_0^⊥)`. -/
noncomputable def nullEnv {k N : ℕ} (d : NullDrive k N) : Env N :=
  (d.1, fun i => |d.2.1 i|, H0perp k N d.2.2.1)

/-- The record of the updates of single-site dynamics (§3.3): the `n`-th entry is the arrival time
`T_{n+1}`, the site `I_{n+1}` and the new spin `Z_{n+1}`. -/
abbrev Marks (N : ℕ) := ℕ → ℝ × Fin N × Bool

/-- The marks `(T_n, I_n, Z_n)_{n ≥ 1}` of Glauber dynamics for `V` at `β` from `x₀`. -/
noncomputable def glauberMarks {N : ℕ} (V : Cube N → ℝ) (β : ℝ) (x₀ : Cube N) (ω : Noise N) :
    Marks N :=
  fun n => (arrivalAt (n + 1) ω, (ω n).2.1, glauberState V β x₀ ω (n + 1) (ω n).2.1)

/-- The canonical space of Glauber dynamics in a random environment: environment and marks. -/
abbrev Canon (N : ℕ) := Env N × Marks N

/-- The state after the first `n` marks, starting from `e`. -/
def canonState {N : ℕ} (e : Cube N) (c : Marks N) : ℕ → Cube N
  | 0 => e
  | n + 1 => Function.update (canonState e c n) (c n).2.1 (c n).2.2

/-- The trajectory `Y_t` on the canonical space, started at `Y_0 = e`: the state after the marks
with `T_n ≤ t` (a deterministic function of the initialization and the marks, §3.3). -/
noncomputable def canonPath {N : ℕ} (e : Cube N) (c : Canon N) (t : ℝ) : Cube N :=
  canonState e c.2 {n : ℕ | (c.2 n).1 ≤ t}.ncard

/-- The planted law `P` (Definition 6.7) as the law of the canonical element
`(φ, R, W, marks)`: the environment `(sgn U, |U|, H_0^⊥)` and the marks of Glauber dynamics at `β`
for `H_φ = ⟨R,·⟩ + W + Nλm_φ^k − Nλσ²_N m_φ` started at `e`. -/
noncomputable def plantedCanon (k N : ℕ) (lam β : ℝ) (e : Cube N) (d : PlantedDrive k N) :
    Canon N :=
  let env := plantedEnv d
  (env, glauberMarks (Hplanted k N lam env.1 env.2.1 env.2.2) β e d.2.2)

/-- The null law `Q` (Definition 6.8) as the law of the canonical element: the environment
`(φ, |U|, H_0^⊥)` and the marks of Glauber dynamics at `β` for `H_null = ⟨R,·⟩ + W` from `e`. -/
noncomputable def nullCanon (k N : ℕ) (β : ℝ) (e : Cube N) (d : NullDrive k N) : Canon N :=
  let env := nullEnv d
  (env, glauberMarks (Hnull env.2.1 env.2.2) β e d.2.2.2)

/-- The joint filtration `(G_t)` of the environment and the dynamics (Theorem 6.10): generated by
the environment `(φ, R, W)` and by the marks `(T_n, I_n, Z_n)` with `T_n ≤ t`. -/
def jointFiltration (N : ℕ) (t : ℝ) : MeasurableSpace (Canon N) :=
  MeasurableSpace.generateFrom
    ({A | ∃ B : Set (Env N), MeasurableSet B ∧ A = Prod.fst ⁻¹' B} ∪
      {A | ∃ (n : ℕ) (S : Set (ℝ × Fin N × Bool)), MeasurableSet S ∧
        A = {c : Canon N | (c.2 n).1 ≤ t ∧ c.2 n ∈ S}})

end TensorPCAGlauber.OddK


