  have p1 : NLogN.expNegFixCost n (2 * n + 10) A T ≤ 10 ^ 20 * (300 * S ^ 2) ^ 5 := by
    unfold NLogN.expNegFixCost
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (by nlinarith) 5)
  have p2 : NLogN.expPosBB n A T (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) (NLogN.zsz (σ : ℤ)) + 4 ≤ 400 * S ^ 2 := by
    unfold NLogN.expPosBB NLogN.expNegB; nlinarith
  have p3 : (NLogN.expPosBB n A T (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) (NLogN.zsz (σ : ℤ)) + 4) ^ 2 ≤
      (400 * S ^ 2) ^ 2 := Nat.pow_le_pow_left p2 2
  have p4 : (2 * n + 10 + 10) ^ 3 ≤ (2 * S) ^ 3 := Nat.pow_le_pow_left (by omega) 3
