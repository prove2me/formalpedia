import Definitions.Def_OAI_PiExponent_FormalInterpolationPackets
import Definitions.Def_OAI_PiExponent_WeightedSupport
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic.NormNum

open scoped BigOperators
open OAI.PiExponent OAI.PiExponent.DeterminantContradiction

/- A concrete failure of weighted support for an ideal generated by 1. -/

theorem weighted_support_counterexample :
    let f : RingHom (MvPolynomial (Fin 1) Complex) (MvPowerSeries (Fin 1) Complex) :=
      MvPolynomial.coeToMvPowerSeries.ringHom;
    let x : Fin 1 → MvPolynomial (Fin 1) Complex := fun _ => 1;
    (∀ i, FormalInterpolation.hasWeightedSupport (fun _ : Fin 1 => (-1 : Real))
      0 (f (x i))) ∧
    (MvPolynomial.X (0 : Fin 1) ∈ (Ideal.span (Set.range x)) ^ 1) ∧
    ¬ FormalInterpolation.hasWeightedSupport (fun _ : Fin 1 => (-1 : Real))
      ((1 : Real) * 0) (f (MvPolynomial.X (0 : Fin 1))) := by
  classical
  dsimp only
  refine ⟨?_, ?_, ?_⟩
  · intro i b hb
    have he : InterpolationMatrix.exponentVector b = 0 := by
      by_contra he
      change MvPowerSeries.coeff (InterpolationMatrix.exponentVector b)
        ((1 : MvPolynomial (Fin 1) Complex) : MvPowerSeries (Fin 1) Complex) ≠ 0 at hb
      simp [MvPowerSeries.coeff_one, he] at hb
    have h0 : b 0 = 0 := by
      simpa [InterpolationMatrix.exponentVector] using
        congrArg (fun d : Fin 1 →₀ Nat => d 0) he
    simp [h0]
  · have ht : Ideal.span (Set.range (fun _ : Fin 1 =>
        (1 : MvPolynomial (Fin 1) Complex))) = ⊤ := by
      apply (Ideal.eq_top_iff_one _).2
      exact Ideal.subset_span ⟨0, rfl⟩
    rw [ht]
    simp
  · intro h
    have he : InterpolationMatrix.exponentVector (fun _ : Fin 1 => 1) =
        Finsupp.single (0 : Fin 1) 1 := by
      apply Finsupp.ext
      intro i
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      simp [InterpolationMatrix.exponentVector]
    have hc : MvPowerSeries.coeff
        (InterpolationMatrix.exponentVector (fun _ : Fin 1 => 1))
        (MvPolynomial.coeToMvPowerSeries.ringHom
          (MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) Complex)) ≠ 0 := by
      change MvPowerSeries.coeff _
        ((MvPolynomial.X (0 : Fin 1) : MvPolynomial (Fin 1) Complex) :
          MvPowerSeries (Fin 1) Complex) ≠ 0
      simp [he, MvPowerSeries.coeff_X]
    have hw := h (fun _ : Fin 1 => 1) hc
    norm_num [Fin.sum_univ_one] at hw

-- Negate the entire target, including its implicit dimension and hypotheses.
theorem solution :
    ¬ (∀ {m : Nat} (v : Fin (m + 1) → Real) (R : Real) (n : Nat)
      (f : RingHom (MvPolynomial (Fin (m + 1)) Complex)
        (MvPowerSeries (Fin (m + 1)) Complex))
      (x : Fin (m + 1) → MvPolynomial (Fin (m + 1)) Complex)
      (hx : ∀ i, FormalInterpolation.hasWeightedSupport v R (f (x i)))
      (P : MvPolynomial (Fin (m + 1)) Complex)
      (hP : Membership.mem ((Ideal.span (Set.range x)) ^ n) P),
      FormalInterpolation.hasWeightedSupport v ((n : Real) * R) (f P)) := by
  intro h
  rcases weighted_support_counterexample with ⟨hx, hP, hnot⟩
  apply hnot
  simpa only [Nat.cast_one] using (h (m := 0) (fun _ : Fin 1 => (-1 : Real)) 0 1
    MvPolynomial.coeToMvPowerSeries.ringHom
    (fun _ : Fin 1 => (1 : MvPolynomial (Fin 1) Complex))
    hx (MvPolynomial.X (0 : Fin 1)) hP)
