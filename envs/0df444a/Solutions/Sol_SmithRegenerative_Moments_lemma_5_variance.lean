import Mathlib
import Definitions.Def_SmithRegenerative_Moments_CumulativeProcess



namespace SmithRegenerative.Moments

open MeasureTheory Filter ProbabilityTheory Topology

variable {Ω : Type*} [MeasurableSpace Ω] (C : CumulativeProcess Ω)

/-- 0-indexed cycle triple. -/
noncomputable def CumulativeProcess.V (i : ℕ) (ω : Ω) : ℝ × ℝ × ℝ :=
  (C.renewal.cycleLength (i + 1) ω, cycleReward C.renewal C.w (i + 1) ω,
    cycleVariation C.renewal C.w (i + 1) ω)

lemma CumulativeProcess.measurable_V (i : ℕ) : Measurable (C.V i) :=
  (C.renewal.measurable_cycle i).prodMk
    ((C.measurable_reward i).prodMk (C.measurable_variation i))

lemma CumulativeProcess.iIndep_V : iIndepFun C.V C.renewal.P := C.independent_cycles

lemma CumulativeProcess.map_V (i : ℕ) :
    Measure.map (C.V i) C.renewal.P = Measure.map (C.V 0) C.renewal.P := by
  have := C.identical_cycles i
  unfold CumulativeProcess.V
  simpa using this

lemma CumulativeProcess.epoch_eq (n : ℕ) (ω : Ω) :
    C.renewal.epoch n ω = ∑ l ∈ Finset.range n, (C.V l ω).1 := by
  unfold Renewal.epoch
  rw [← Finset.Ico_succ_right_eq_Icc, Finset.sum_Ico_eq_sum_range]
  simp [CumulativeProcess.V, add_comm]

lemma CumulativeProcess.measurable_epoch (n : ℕ) : Measurable (C.renewal.epoch n) := by
  have : C.renewal.epoch n = fun ω => ∑ l ∈ Finset.range n, (C.V l ω).1 := by
    funext ω; exact C.epoch_eq n ω
  rw [this]
  exact Finset.measurable_sum _ fun l _ => (C.measurable_V l).fst

/-- The event `{∀ j < k, T_j ≤ t}`, which is `{n_t ≥ k}` when `n_t` is finite. -/
def CumulativeProcess.A (t : ℝ) (k : ℕ) : Set Ω := {ω | ∀ j < k, C.renewal.epoch j ω ≤ t}

lemma CumulativeProcess.A_zero (t : ℝ) : C.A t 0 = Set.univ := by
  ext ω; simp [CumulativeProcess.A]

/-- σ-algebra generated by the cycles with indices in `S`. -/
noncomputable def CumulativeProcess.sigS (S : Finset ℕ) : MeasurableSpace Ω :=
  ⨆ l ∈ (S : Set ℕ), MeasurableSpace.comap (C.V l) inferInstance

lemma CumulativeProcess.sigS_le (S : Finset ℕ) : C.sigS S ≤ ‹MeasurableSpace Ω› := by
  unfold CumulativeProcess.sigS
  exact iSup₂_le fun l _ => (C.measurable_V l).comap_le

lemma CumulativeProcess.measurable_V_sigS (S : Finset ℕ) {l : ℕ} (hl : l ∈ S) :
    Measurable[C.sigS S] (C.V l) := by
  rw [measurable_iff_comap_le]
  exact le_iSup₂ (f := fun l (_ : l ∈ (S : Set ℕ)) => MeasurableSpace.comap (C.V l) inferInstance) l
    (by simpa using hl)

lemma CumulativeProcess.measurable_epoch_sigS (k : ℕ) {j : ℕ} (hj : j ≤ k) :
    Measurable[C.sigS (Finset.range k)] (C.renewal.epoch j) := by
  have : C.renewal.epoch j = fun ω => ∑ l ∈ Finset.range j, (C.V l ω).1 := by
    funext ω; exact C.epoch_eq j ω
  rw [this]
  exact Finset.measurable_sum _ fun l hl =>
    measurable_fst.comp (C.measurable_V_sigS (Finset.range k)
      (Finset.mem_range.2 (lt_of_lt_of_le (Finset.mem_range.1 hl) hj)))

lemma CumulativeProcess.measurableSet_A_sigS (t : ℝ) (k : ℕ) :
    MeasurableSet[C.sigS (Finset.range (k - 1))] (C.A t k) := by
  have : C.A t k = ⋂ j, ⋂ (_ : j < k), {ω | C.renewal.epoch j ω ≤ t} := by
    ext ω; simp [CumulativeProcess.A]
  rw [this]
  refine MeasurableSet.iInter fun j => MeasurableSet.iInter fun hj => ?_
  exact measurableSet_le (C.measurable_epoch_sigS (k - 1) (by omega)) measurable_const

lemma CumulativeProcess.measurableSet_A (t : ℝ) (k : ℕ) : MeasurableSet (C.A t k) :=
  C.sigS_le _ _ (C.measurableSet_A_sigS t k)

/-- Independence of a function of cycle `i` and the event `A t k` when `k ≤ i + 1`. -/
lemma CumulativeProcess.indepFun_V_A {β : Type*} [MeasurableSpace β]
    (f : ℝ × ℝ × ℝ → β) (hf : Measurable f) (t : ℝ) {k i : ℕ} (hki : k ≤ i + 1) :
    IndepFun (fun ω => f (C.V i ω)) ((C.A t k).indicator (fun _ => (1 : ENNReal)))
      C.renewal.P := by
  have hind := indep_iSup_of_disjoint (μ := C.renewal.P)
    (m := fun l => MeasurableSpace.comap (C.V l) inferInstance)
    (fun l => (C.measurable_V l).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 C.iIndep_V)
    (S := ((Finset.range (k - 1) : Finset ℕ) : Set ℕ)) (T := (({i} : Finset ℕ) : Set ℕ))
    (by
      rw [Finset.disjoint_coe]
      simp only [Finset.disjoint_singleton_right, Finset.mem_range]
      omega)
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_left (indep_of_indep_of_le_right hind.symm ?_) ?_
  · rw [← measurable_iff_comap_le]
    exact measurable_const.indicator (C.measurableSet_A_sigS t k)
  · rw [← measurable_iff_comap_le]
    exact hf.comp (C.measurable_V_sigS {i} (Finset.mem_singleton_self i))

/-! ### Facts about `count` on the event where some epoch exceeds `t` -/

lemma CumulativeProcess.epoch_zero (ω : Ω) : C.renewal.epoch 0 ω = 0 := by
  simp [Renewal.epoch]

lemma CumulativeProcess.le_count_iff {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) (k : ℕ) :
    k ≤ C.renewal.count t ω ↔ ω ∈ C.A t k := by
  constructor
  · intro hk j hj
    have := Nat.notMem_of_lt_sInf (s := {n : ℕ | t < C.renewal.epoch n ω}) (lt_of_lt_of_le hj hk)
    simpa using this
  · intro hA
    by_contra h
    push_neg at h
    have hmem : t < C.renewal.epoch (C.renewal.count t ω) ω :=
      Nat.sInf_mem (s := {n : ℕ | t < C.renewal.epoch n ω}) hS
    have := hA _ h
    linarith

lemma CumulativeProcess.lt_epoch_count {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) :
    t < C.renewal.epoch (C.renewal.count t ω) ω :=
  Nat.sInf_mem (s := {n : ℕ | t < C.renewal.epoch n ω}) hS

lemma CumulativeProcess.one_le_count {t : ℝ} (ht : 0 ≤ t) {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) : 1 ≤ C.renewal.count t ω := by
  rw [C.le_count_iff hS]
  intro j hj
  have : j = 0 := by omega
  subst this
  simpa [C.epoch_zero] using ht

lemma CumulativeProcess.epoch_count_pred_le {t : ℝ} (ht : 0 ≤ t) {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) :
    C.renewal.epoch (C.renewal.count t ω - 1) ω ≤ t := by
  have h1 := C.one_le_count ht hS
  have := (C.le_count_iff hS (C.renewal.count t ω)).1 le_rfl
  exact this _ (by omega)

/-- Pointwise: a finite sum up to `n_t + m` as a series with indicators. -/
lemma CumulativeProcess.sum_range_count_eq_tsum {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) (m : ℕ) (g : ℕ → ENNReal) :
    ∑ i ∈ Finset.range (C.renewal.count t ω + m), g i =
      ∑' i, g i * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω := by
  rw [tsum_eq_sum (s := Finset.range (C.renewal.count t ω + m))]
  · refine Finset.sum_congr rfl fun i hi => ?_
    have hmem : ω ∈ C.A t (i + 1 - m) := by
      rw [← C.le_count_iff hS]
      have := Finset.mem_range.1 hi
      omega
    simp [Set.indicator_of_mem hmem]
  · intro i hi
    have hnot : ω ∉ C.A t (i + 1 - m) := by
      rw [← C.le_count_iff hS]
      have : ¬ i < C.renewal.count t ω + m := fun h' => hi (Finset.mem_range.2 h')
      omega
    simp [Set.indicator_of_notMem hnot]

/-! ### Almost surely the epochs tend to infinity (strong law) -/

lemma CumulativeProcess.ae_nonneg_cycles :
    ∀ᵐ ω ∂C.renewal.P, ∀ i : ℕ, 0 ≤ (C.V i ω).1 := by
  rw [ae_all_iff]
  intro i
  exact C.renewal.nonnegative_cycle i

lemma CumulativeProcess.meanLength_pos
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) : 0 < C.meanLength := by
  unfold CumulativeProcess.meanLength
  have := C.renewal.probability
  rw [integral_pos_iff_support_of_nonneg_ae (C.renewal.nonnegative_cycle 0) hμ]
  have hlt := C.renewal.not_all_zero
  have hmeas : MeasurableSet {ω | C.renewal.cycleLength 1 ω = 0} :=
    measurableSet_eq_fun (C.renewal.measurable_cycle 0) measurable_const
  have hc : Function.support (C.renewal.cycleLength 1) =
      {ω | C.renewal.cycleLength 1 ω = 0}ᶜ := by
    ext ω; simp [Function.mem_support]
  rw [hc, prob_compl_eq_one_sub hmeas]
  exact tsub_pos_iff_lt.2 hlt

/-- `E n_t` as an extended nonnegative real. -/
noncomputable def CumulativeProcess.nt (t : ℝ) : ENNReal :=
  ∫⁻ ω, (C.renewal.count t ω : ENNReal) ∂C.renewal.P

/-- The truncated mean `E min(t₁, M)`. -/
noncomputable def CumulativeProcess.muM (M : ℕ) : ℝ :=
  ∫ ω, min (C.V 0 ω).1 (M : ℝ) ∂C.renewal.P

lemma CumulativeProcess.integrable_min' (M : ℕ) :
    Integrable (fun ω => min (C.V 0 ω).1 (M : ℝ)) C.renewal.P := by
  have := C.renewal.probability
  refine Integrable.mono' (integrable_const (M : ℝ))
    ((C.measurable_V 0).fst.min measurable_const).aestronglyMeasurable ?_
  filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
  have : (0 : ℝ) ≤ (C.V 0 ω).1 := hω
  rw [Real.norm_eq_abs, abs_of_nonneg (le_min this (by positivity))]
  exact min_le_right _ _

lemma CumulativeProcess.muM_one_pos : 0 < C.muM 1 := by
  have := C.renewal.probability
  unfold CumulativeProcess.muM
  have hnn : 0 ≤ᵐ[C.renewal.P] fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ) := by
    filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
    exact le_min hω (by positivity)
  rw [integral_pos_iff_support_of_nonneg_ae hnn (C.integrable_min' 1)]
  have hlt := C.renewal.not_all_zero
  have hmeas : MeasurableSet {ω | C.renewal.cycleLength 1 ω = 0} :=
    measurableSet_eq_fun (C.renewal.measurable_cycle 0) measurable_const
  have hc : ({ω | C.renewal.cycleLength 1 ω = 0}ᶜ : Set Ω) ≤ᵐ[C.renewal.P]
      (Function.support (fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ)) : Set Ω) := by
    filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
    intro hne
    change ω ∈ ({ω | C.renewal.cycleLength 1 ω = 0}ᶜ : Set Ω) at hne
    change ω ∈ Function.support (fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ))
    rw [Set.mem_compl_iff, Set.mem_setOf_eq] at hne
    have h0 : (0 : ℝ) ≤ (C.V 0 ω).1 := hω
    have h1 : (C.V 0 ω).1 ≠ 0 := hne
    rw [Function.mem_support, Nat.cast_one]
    have : 0 < min (C.V 0 ω).1 1 := lt_min (lt_of_le_of_ne h0 (Ne.symm h1)) one_pos
    exact this.ne'
  have h2 : 0 < C.renewal.P ({ω | C.renewal.cycleLength 1 ω = 0}ᶜ : Set Ω) := by
    rw [prob_compl_eq_one_sub hmeas]
    exact tsub_pos_iff_lt.2 hlt
  exact lt_of_lt_of_le h2 (measure_mono_ae hc)

lemma CumulativeProcess.ae_tendsto_epoch :
    ∀ᵐ ω ∂C.renewal.P, Tendsto (fun n => C.renewal.epoch n ω) atTop atTop := by
  have := C.renewal.probability
  have hφ : Measurable fun v : ℝ × ℝ × ℝ => min v.1 ((1 : ℕ) : ℝ) := measurable_fst.min measurable_const
  have hint : Integrable (fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ)) C.renewal.P := C.integrable_min' 1
  have hindep : Pairwise (fun i j => IndepFun (fun ω => min (C.V i ω).1 ((1 : ℕ) : ℝ))
      (fun ω => min (C.V j ω).1 ((1 : ℕ) : ℝ)) C.renewal.P) := by
    intro i j hij
    exact (C.iIndep_V.indepFun hij).comp hφ hφ
  have hident : ∀ i, IdentDistrib (fun ω => min (C.V i ω).1 ((1 : ℕ) : ℝ))
      (fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ)) C.renewal.P C.renewal.P := by
    intro i
    refine ⟨(hφ.comp (C.measurable_V i)).aemeasurable, (hφ.comp (C.measurable_V 0)).aemeasurable, ?_⟩
    have h1 : (fun ω => min (C.V i ω).1 ((1 : ℕ) : ℝ)) = (fun v : ℝ × ℝ × ℝ => min v.1 ((1 : ℕ) : ℝ)) ∘ C.V i := rfl
    have h0 : (fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ)) = (fun v : ℝ × ℝ × ℝ => min v.1 ((1 : ℕ) : ℝ)) ∘ C.V 0 := rfl
    rw [h1, h0, ← Measure.map_map hφ (C.measurable_V i),
      ← Measure.map_map hφ (C.measurable_V 0), C.map_V i]
  have hslln := strong_law_ae (μ := C.renewal.P) (fun i ω => min (C.V i ω).1 ((1 : ℕ) : ℝ))
    hint hindep hident
  have hpos : 0 < C.muM 1 := C.muM_one_pos
  have hmean : (C.renewal.P)[fun ω => min (C.V 0 ω).1 ((1 : ℕ) : ℝ)] = C.muM 1 := rfl
  filter_upwards [hslln, C.ae_nonneg_cycles] with ω hω hnn
  rw [hmean] at hω
  have h2 : Tendsto (fun n : ℕ => (n : ℝ) * ((n : ℝ)⁻¹ • ∑ i ∈ Finset.range n, min (C.V i ω).1 ((1 : ℕ) : ℝ)))
      atTop atTop :=
    Tendsto.atTop_mul_pos hpos tendsto_natCast_atTop_atTop hω
  have h3 : Tendsto (fun n : ℕ => ∑ i ∈ Finset.range n, min (C.V i ω).1 ((1 : ℕ) : ℝ)) atTop atTop := by
    refine h2.congr' ?_
    filter_upwards [eventually_ge_atTop 1] with n hn
    rw [smul_eq_mul, ← mul_assoc, mul_inv_cancel₀ (by positivity), one_mul]
  refine tendsto_atTop_mono (fun n => ?_) h3
  rw [C.epoch_eq]
  exact Finset.sum_le_sum fun i _ => min_le_left _ _

lemma CumulativeProcess.ae_exists_epoch_gt (t : ℝ) :
    ∀ᵐ ω ∂C.renewal.P, ∃ n, t < C.renewal.epoch n ω := by
  filter_upwards [C.ae_tendsto_epoch] with ω hω
  obtain ⟨n, hn⟩ := (tendsto_atTop_atTop.1 hω (t + 1)) 
  exact ⟨n, by linarith [hn n le_rfl]⟩

/-! ### Wald's identity (in `ℝ≥0∞`) -/

lemma CumulativeProcess.lintegral_V_eq (f : ℝ × ℝ × ℝ → ENNReal) (hf : Measurable f) (i : ℕ) :
    ∫⁻ ω, f (C.V i ω) ∂C.renewal.P = ∫⁻ ω, f (C.V 0 ω) ∂C.renewal.P := by
  rw [← lintegral_map hf (C.measurable_V i), C.map_V i, lintegral_map hf (C.measurable_V 0)]

/-- `∫ ∑_{i < n_t + m} f(V_i) = (∫ f(V_0)) · ∫ (n_t + m)`. -/
lemma CumulativeProcess.wald
    (f : ℝ × ℝ × ℝ → ENNReal) (hf : Measurable f) (t : ℝ) (m : ℕ) :
    ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω + m), f (C.V i ω) ∂C.renewal.P =
      (∫⁻ ω, f (C.V 0 ω) ∂C.renewal.P) *
        ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P := by
  have hae := C.ae_exists_epoch_gt t
  have hmeasA : ∀ k, Measurable ((C.A t k).indicator (fun _ => (1 : ENNReal))) :=
    fun k => measurable_const.indicator (C.measurableSet_A t k)
  have e1 : ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω + m), f (C.V i ω) ∂C.renewal.P =
      ∫⁻ ω, ∑' i, f (C.V i ω) * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P := by
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with ω hω
    exact C.sum_range_count_eq_tsum hω m _
  have e2 : ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P =
      ∫⁻ ω, ∑' i, (1 : ENNReal) * (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P := by
    refine lintegral_congr_ae ?_
    filter_upwards [hae] with ω hω
    rw [← C.sum_range_count_eq_tsum hω m (fun _ => 1)]
    simp
  rw [e1, e2, lintegral_tsum, lintegral_tsum]
  · rw [← ENNReal.tsum_mul_left]
    refine tsum_congr fun i => ?_
    rw [lintegral_mul_eq_lintegral_mul_lintegral_of_indepFun'' (f := fun ω => f (C.V i ω))
      (hf.comp (C.measurable_V i)).aemeasurable
      (hmeasA _).aemeasurable (C.indepFun_V_A f hf t (k := i + 1 - m) (i := i) (by omega)),
      lintegral_mul_eq_lintegral_mul_lintegral_of_indepFun'' measurable_const.aemeasurable
      (hmeasA _).aemeasurable, C.lintegral_V_eq f hf i]
    · have := C.renewal.probability
      simp
    · exact (C.indepFun_V_A (fun _ => (1 : ENNReal)) measurable_const t (k := i + 1 - m) (i := i)
        (by omega))
  · exact fun i => (measurable_const.mul (hmeasA _)).aemeasurable
  · exact fun i => ((hf.comp (C.measurable_V i)).mul (hmeasA _)).aemeasurable

/-! ### The elementary renewal theorem -/

lemma CumulativeProcess.V0_fst : (fun ω => (C.V 0 ω).1) = C.renewal.cycleLength 1 := rfl

lemma CumulativeProcess.integrable_min
    (M : ℕ) : Integrable (fun ω => min (C.V 0 ω).1 (M : ℝ)) C.renewal.P :=
  C.integrable_min' M

lemma CumulativeProcess.muM_nonneg (M : ℕ) : 0 ≤ C.muM M := by
  unfold CumulativeProcess.muM
  refine integral_nonneg_of_ae ?_
  filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
  exact le_min hω (by positivity)

lemma CumulativeProcess.muM_tendsto (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto C.muM atTop (𝓝 C.meanLength) := by
  have h1 : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by rw [C.V0_fst]; exact hμ
  have hmean : C.meanLength = ∫ ω, (C.V 0 ω).1 ∂C.renewal.P := rfl
  rw [hmean]
  refine tendsto_integral_of_dominated_convergence (fun ω => |(C.V 0 ω).1|)
    (fun M => (C.integrable_min M).aestronglyMeasurable) h1.abs ?_ ?_
  · intro M
    filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
    have : (0 : ℝ) ≤ (C.V 0 ω).1 := hω
    rw [Real.norm_eq_abs, abs_of_nonneg (le_min this (by positivity)), abs_of_nonneg this]
    exact min_le_left _ _
  · refine Eventually.of_forall fun ω => ?_
    refine tendsto_const_nhds.congr' ?_
    obtain ⟨N, hN⟩ := exists_nat_ge (C.V 0 ω).1
    filter_upwards [eventually_ge_atTop N] with M hM
    rw [min_eq_left (hN.trans (by exact_mod_cast hM))]

lemma CumulativeProcess.lintegral_ofReal_min
    (M : ℕ) :
    ∫⁻ ω, ENNReal.ofReal (min (C.V 0 ω).1 (M : ℝ)) ∂C.renewal.P = ENNReal.ofReal (C.muM M) := by
  unfold CumulativeProcess.muM
  rw [ofReal_integral_eq_lintegral_ofReal (C.integrable_min M)]
  filter_upwards [C.renewal.nonnegative_cycle 0] with ω hω
  exact le_min hω (by positivity)

lemma CumulativeProcess.lintegral_ofReal_V0 (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (C.V 0 ω).1 ∂C.renewal.P = ENNReal.ofReal C.meanLength := by
  have h1 : Integrable (fun ω => (C.V 0 ω).1) C.renewal.P := by rw [C.V0_fst]; exact hμ
  have hmean : C.meanLength = ∫ ω, (C.V 0 ω).1 ∂C.renewal.P := rfl
  rw [hmean, ofReal_integral_eq_lintegral_ofReal h1 (C.renewal.nonnegative_cycle 0)]

/-- Upper bound: `E min(t₁,M) · E n_t ≤ t + M`. -/
lemma CumulativeProcess.nt_upper
    (M : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    ENNReal.ofReal (C.muM M) * C.nt t ≤ ENNReal.ofReal (t + M) := by
  have := C.renewal.probability
  have hw := C.wald (fun v => ENNReal.ofReal (min v.1 (M : ℝ)))
    (ENNReal.measurable_ofReal.comp (measurable_fst.min measurable_const)) t 0
  simp only [add_zero] at hw
  rw [← C.lintegral_ofReal_min M]
  unfold CumulativeProcess.nt
  rw [← hw]
  calc ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω), ENNReal.ofReal (min (C.V i ω).1 (M : ℝ))
        ∂C.renewal.P ≤ ∫⁻ _, ENNReal.ofReal (t + M) ∂C.renewal.P := by
        refine lintegral_mono_ae ?_
        filter_upwards [C.ae_exists_epoch_gt t, C.ae_nonneg_cycles] with ω hS hnn
        rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => le_min (hnn i) (by positivity))]
        refine ENNReal.ofReal_le_ofReal ?_
        have h1 := C.one_le_count ht hS
        have h2 := C.epoch_count_pred_le ht hS
        rw [C.epoch_eq] at h2
        obtain ⟨n, hn⟩ : ∃ n, C.renewal.count t ω = n + 1 := ⟨_, (Nat.succ_pred_eq_of_pos h1).symm⟩
        rw [hn] at h2 ⊢
        simp only [Nat.add_sub_cancel] at h2
        rw [Finset.sum_range_succ]
        have h3 : ∑ i ∈ Finset.range n, min (C.V i ω).1 (M : ℝ) ≤ ∑ i ∈ Finset.range n, (C.V i ω).1 :=
          Finset.sum_le_sum fun i _ => min_le_left _ _
        linarith [min_le_right (C.V n ω).1 (M : ℝ)]
    _ = ENNReal.ofReal (t + M) := by simp

/-- Lower bound: `t ≤ μ₁ · E n_t`. -/
lemma CumulativeProcess.nt_lower (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {t : ℝ} :
    ENNReal.ofReal t ≤ ENNReal.ofReal C.meanLength * C.nt t := by
  have := C.renewal.probability
  have hw := C.wald (fun v => ENNReal.ofReal v.1)
    (ENNReal.measurable_ofReal.comp measurable_fst) t 0
  simp only [add_zero] at hw
  rw [← C.lintegral_ofReal_V0 hμ]
  unfold CumulativeProcess.nt
  rw [← hw]
  calc ENNReal.ofReal t = ∫⁻ _, ENNReal.ofReal t ∂C.renewal.P := by simp
    _ ≤ ∫⁻ ω, ∑ i ∈ Finset.range (C.renewal.count t ω), ENNReal.ofReal (C.V i ω).1
        ∂C.renewal.P := by
        refine lintegral_mono_ae ?_
        filter_upwards [C.ae_exists_epoch_gt t, C.ae_nonneg_cycles] with ω hS hnn
        rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => hnn i)]
        refine ENNReal.ofReal_le_ofReal ?_
        have := C.lt_epoch_count hS
        rw [C.epoch_eq] at this
        exact this.le

/-- The real-valued renewal function `E n_t`. -/
noncomputable def CumulativeProcess.H (t : ℝ) : ℝ := (C.nt t).toReal

lemma CumulativeProcess.muM_mono {M N : ℕ} (hMN : M ≤ N) : C.muM M ≤ C.muM N := by
  unfold CumulativeProcess.muM
  refine integral_mono (C.integrable_min' M) (C.integrable_min' N) fun ω => ?_
  exact min_le_min le_rfl (Nat.cast_le.2 hMN)

lemma CumulativeProcess.exists_muM_pos :
    ∃ M₀ : ℕ, ∀ M ≥ M₀, 0 < C.muM M :=
  ⟨1, fun M hM => lt_of_lt_of_le C.muM_one_pos (C.muM_mono hM)⟩

lemma CumulativeProcess.nt_ne_top
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : C.nt t ≠ ⊤ := by
  have h := C.nt_upper M ht
  intro htop
  rw [htop, ENNReal.mul_top (by simpa using hM)] at h
  exact absurd h (by simp)

lemma CumulativeProcess.H_upper
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : C.muM M * C.H t ≤ t + M := by
  have h := C.nt_upper M ht
  have hne := C.nt_ne_top hM ht
  have := ENNReal.toReal_mono (by simp) h
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal hM.le, ENNReal.toReal_ofReal (by positivity)] at this

lemma CumulativeProcess.H_lower (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    {M : ℕ} (hM : 0 < C.muM M) {t : ℝ} (ht : 0 ≤ t) : t ≤ C.meanLength * C.H t := by
  have h := C.nt_lower hμ (t := t)
  have hne := C.nt_ne_top hM ht
  have := ENNReal.toReal_mono (ENNReal.mul_ne_top (by simp) hne) h
  rwa [ENNReal.toReal_mul, ENNReal.toReal_ofReal (C.meanLength_pos hμ).le,
    ENNReal.toReal_ofReal ht] at this

lemma CumulativeProcess.H_nonneg (t : ℝ) : 0 ≤ C.H t := ENNReal.toReal_nonneg

/-- The elementary renewal theorem: `E n_t / t → 1/μ₁`. -/
theorem CumulativeProcess.H_div_tendsto (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto (fun t : ℝ => C.H t / t) atTop (𝓝 (1 / C.meanLength)) := by
  have hμpos := C.meanLength_pos hμ
  obtain ⟨M₀, hM₀⟩ := C.exists_muM_pos
  rw [Metric.tendsto_atTop]
  intro ε hε
  -- choose M with 1/muM M ≤ 1/μ + ε/2
  have hinv : Tendsto (fun M => 1 / C.muM M) atTop (𝓝 (1 / C.meanLength)) :=
    tendsto_const_nhds.div (C.muM_tendsto hμ) hμpos.ne'
  obtain ⟨M₁, hM₁⟩ := eventually_atTop.1 (hinv.eventually (gt_mem_nhds (by linarith : 1 / C.meanLength < 1 / C.meanLength + ε / 2)))
  set M := max M₀ M₁ with hMdef
  have hMpos : 0 < C.muM M := hM₀ M (le_max_left _ _)
  have hMinv : 1 / C.muM M < 1 / C.meanLength + ε / 2 := hM₁ M (le_max_right _ _)
  refine ⟨max 1 (2 * M / (C.muM M * ε)), fun t ht => ?_⟩
  have ht1 : 1 ≤ t := le_trans (le_max_left _ _) ht
  have ht0 : 0 < t := by linarith
  have ht2 : 2 * M / (C.muM M * ε) ≤ t := le_trans (le_max_right _ _) ht
  have hup := C.H_upper hMpos ht0.le
  have hlo := C.H_lower hμ hMpos ht0.le
  rw [Real.dist_eq, abs_lt]
  constructor
  · -- lower bound
    have : 1 / C.meanLength ≤ C.H t / t := by
      rw [div_le_div_iff₀ hμpos ht0]
      linarith
    linarith
  · have h1 : C.H t / t ≤ (t + M) / (C.muM M * t) := by
      rw [div_le_div_iff₀ ht0 (by positivity)]
      nlinarith
    have h2 : (t + M) / (C.muM M * t) = 1 / C.muM M + M / (C.muM M * t) := by
      field_simp
    have h3 : (M : ℝ) / (C.muM M * t) ≤ ε / 2 := by
      rw [div_le_iff₀ (by positivity)]
      have := (div_le_iff₀ (by positivity)).1 ht2
      nlinarith
    linarith

/-! ### The infinite-mean case: `E n_t / t → 0` -/

lemma CumulativeProcess.muM_tendsto_atTop (hμ : ¬ Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto C.muM atTop atTop := by
  have := C.renewal.probability
  have htop : ∫⁻ ω, ENNReal.ofReal (C.V 0 ω).1 ∂C.renewal.P = ⊤ := by
    by_contra hne
    apply hμ
    rw [← C.V0_fst]
    refine ⟨(C.measurable_V 0).fst.aestronglyMeasurable, ?_⟩
    have hnn : 0 ≤ᵐ[C.renewal.P] fun ω => (C.V 0 ω).1 := C.renewal.nonnegative_cycle 0
    rw [hasFiniteIntegral_iff_ofReal (f := fun ω => (C.V 0 ω).1) hnn]
    exact lt_top_iff_ne_top.2 hne
  have hmono := lintegral_tendsto_of_tendsto_of_monotone (μ := C.renewal.P)
    (f := fun (M : ℕ) ω => ENNReal.ofReal (min (C.V 0 ω).1 (M : ℝ)))
    (F := fun ω => ENNReal.ofReal (C.V 0 ω).1)
    (fun M => (ENNReal.measurable_ofReal.comp ((C.measurable_V 0).fst.min measurable_const)).aemeasurable)
    (Eventually.of_forall fun ω M N hMN => ENNReal.ofReal_le_ofReal
      (min_le_min le_rfl (Nat.cast_le.2 hMN)))
    (Eventually.of_forall fun ω => by
      refine tendsto_const_nhds.congr' ?_
      obtain ⟨N, hN⟩ := exists_nat_ge (C.V 0 ω).1
      filter_upwards [eventually_ge_atTop N] with M hM
      rw [min_eq_left (hN.trans (by exact_mod_cast hM))])
  rw [htop] at hmono
  simp only [C.lintegral_ofReal_min] at hmono
  rw [tendsto_atTop_atTop]
  intro K
  have hK : ENNReal.ofReal (max K 1) < ⊤ := ENNReal.ofReal_lt_top
  obtain ⟨M₀, hM₀⟩ := eventually_atTop.1 (hmono.eventually (Ioi_mem_nhds hK))
  refine ⟨max M₀ 1, fun M hM => ?_⟩
  have h1 := hM₀ M (le_trans (le_max_left _ _) hM)
  have hpos : 0 < C.muM M := lt_of_lt_of_le C.muM_one_pos (C.muM_mono (le_trans (le_max_right _ _) hM))
  rw [ENNReal.ofReal_lt_ofReal_iff hpos] at h1
  exact le_trans (le_max_left _ _) h1.le

theorem CumulativeProcess.H_div_tendsto_zero
    (hμ : ¬ Integrable (C.renewal.cycleLength 1) C.renewal.P) :
    Tendsto (fun t : ℝ => C.H t / t) atTop (𝓝 0) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨M₁, hM₁⟩ := eventually_atTop.1 ((C.muM_tendsto_atTop hμ).eventually
    (eventually_ge_atTop (4 / ε)))
  set M := max M₁ 1 with hMdef
  have hMpos : 0 < C.muM M := lt_of_lt_of_le C.muM_one_pos (C.muM_mono (le_max_right _ _))
  have hMbig : 4 / ε ≤ C.muM M := hM₁ M (le_max_left _ _)
  have hMinv : 1 / C.muM M ≤ ε / 4 := by
    rw [div_le_iff₀ hMpos]
    have := (div_le_iff₀ hε).1 hMbig
    linarith
  refine ⟨max 1 (4 * M / (C.muM M * ε)), fun t ht => ?_⟩
  have ht1 : 1 ≤ t := le_trans (le_max_left _ _) ht
  have ht0 : 0 < t := by linarith
  have ht2 : 4 * M / (C.muM M * ε) ≤ t := le_trans (le_max_right _ _) ht
  have hup := C.H_upper hMpos ht0.le
  have hH0 := C.H_nonneg t
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (div_nonneg hH0 ht0.le)]
  have h1 : C.H t / t ≤ (t + M) / (C.muM M * t) := by
    rw [div_le_div_iff₀ ht0 (by positivity)]
    nlinarith
  have h2 : (t + M) / (C.muM M * t) = 1 / C.muM M + M / (C.muM M * t) := by
    field_simp
  have h3 : (M : ℝ) / (C.muM M * t) ≤ ε / 4 := by
    rw [div_le_iff₀ (by positivity)]
    have := (div_le_iff₀ (by positivity)).1 ht2
    nlinarith
  linarith

/-- In all cases `E n_t / t` has a limit. -/
theorem CumulativeProcess.exists_H_div_tendsto :
    ∃ L : ℝ, 0 ≤ L ∧ Tendsto (fun t : ℝ => C.H t / t) atTop (𝓝 L) := by
  by_cases hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P
  · exact ⟨1 / C.meanLength, by have := C.meanLength_pos hμ; positivity, C.H_div_tendsto hμ⟩
  · exact ⟨0, le_rfl, C.H_div_tendsto_zero hμ⟩

/-! ### Random sums `∑_{i < n_t + m} g(V_i)` with `g ≥ 0` -/

lemma CumulativeProcess.nt_ne_top'
    {t : ℝ} (ht : 0 ≤ t) : C.nt t ≠ ⊤ := by
  obtain ⟨M₀, hM₀⟩ := C.exists_muM_pos
  exact C.nt_ne_top (hM₀ M₀ le_rfl) ht

/-- The random sum `∑_{i < n_t + m} g(V_i)`. -/
noncomputable def CumulativeProcess.G (g : ℝ × ℝ × ℝ → ℝ) (m : ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.range (C.renewal.count t ω + m), g (C.V i ω)

lemma CumulativeProcess.aemeasurable_G
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v) (m : ℕ) (t : ℝ) :
    AEMeasurable (C.G g m t) C.renewal.P := by
  have hmeas : Measurable (fun ω => (∑' i, ENNReal.ofReal (g (C.V i ω)) *
      (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω).toReal) := by
    refine ENNReal.measurable_toReal.comp (Measurable.tsum fun i => ?_)
    exact ((ENNReal.measurable_ofReal.comp (hg.comp (C.measurable_V i))).mul
      (measurable_const.indicator (C.measurableSet_A t _)))
  refine ⟨_, hmeas, ?_⟩
  filter_upwards [C.ae_exists_epoch_gt t] with ω hS
  unfold CumulativeProcess.G
  rw [← C.sum_range_count_eq_tsum hS m, ENNReal.toReal_sum (fun i _ => ENNReal.ofReal_ne_top)]
  exact Finset.sum_congr rfl fun i _ => (ENNReal.toReal_ofReal (hg0 _)).symm

lemma CumulativeProcess.lintegral_G
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v) (m : ℕ) (t : ℝ) :
    ∫⁻ ω, ENNReal.ofReal (C.G g m t ω) ∂C.renewal.P =
      (∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P) *
        ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P := by
  rw [← C.wald (fun v => ENNReal.ofReal (g v)) (ENNReal.measurable_ofReal.comp hg) t m]
  refine lintegral_congr fun ω => ?_
  unfold CumulativeProcess.G
  rw [ENNReal.ofReal_sum_of_nonneg (fun i _ => hg0 _)]

lemma CumulativeProcess.lintegral_count_add
    (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    (∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P).toReal = C.H t + m := by
  have := C.renewal.probability
  have h : (fun ω => ((C.renewal.count t ω + m : ℕ) : ENNReal)) =
      fun ω => (C.renewal.count t ω : ENNReal) + (m : ENNReal) := by
    funext ω; push_cast; rfl
  have hne : (∫⁻ ω, (C.renewal.count t ω : ENNReal) ∂C.renewal.P) ≠ ⊤ := C.nt_ne_top' ht
  rw [h, lintegral_add_right _ measurable_const, lintegral_const, measure_univ, mul_one,
    ENNReal.toReal_add hne (by simp)]
  simp [CumulativeProcess.H, CumulativeProcess.nt]

lemma CumulativeProcess.integrable_G
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v)
    (hfin : ∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    Integrable (C.G g m t) C.renewal.P := by
  have := C.renewal.probability
  refine ⟨(C.aemeasurable_G g hg hg0 m t).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (f := C.G g m t)
    (Eventually.of_forall fun ω => Finset.sum_nonneg fun i _ => hg0 _),
    C.lintegral_G g hg hg0 m t]
  refine ENNReal.mul_lt_top hfin.lt_top ?_
  have h : (fun ω => ((C.renewal.count t ω + m : ℕ) : ENNReal)) =
      fun ω => (C.renewal.count t ω : ENNReal) + (m : ENNReal) := by
    funext ω; push_cast; rfl
  rw [h, lintegral_add_right _ measurable_const, lintegral_const, measure_univ, mul_one]
  exact ENNReal.add_lt_top.2 ⟨(C.nt_ne_top' ht).lt_top, by simp⟩

lemma CumulativeProcess.integral_G
    (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (hg0 : ∀ v, 0 ≤ g v)
    (hfin : ∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) (m : ℕ) {t : ℝ} (ht : 0 ≤ t) :
    ∫ ω, C.G g m t ω ∂C.renewal.P =
      (∫⁻ ω, ENNReal.ofReal (g (C.V 0 ω)) ∂C.renewal.P).toReal * (C.H t + m) := by
  rw [integral_eq_lintegral_of_nonneg_ae (f := C.G g m t)
    (Eventually.of_forall fun ω => Finset.sum_nonneg fun i _ => hg0 _)
    (C.aemeasurable_G g hg hg0 m t).aestronglyMeasurable, C.lintegral_G g hg hg0 m t,
    ENNReal.toReal_mul, C.lintegral_count_add m ht]

/-! ### Lemma 4 -/

lemma CumulativeProcess.overshootReward_eq (t : ℝ) (ω : Ω) :
    C.overshootReward t ω =
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
  unfold CumulativeProcess.overshootReward CumulativeProcess.G
  rw [← Finset.sum_sub_distrib, ← Finset.Ico_succ_right_eq_Icc, Finset.sum_Ico_eq_sum_range]
  simp only [Nat.add_sub_cancel]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [CumulativeProcess.V, add_comm]
  rcases le_total 0 (cycleReward C.renewal C.w (i + 1) ω) with h | h
  · rw [max_eq_left h, max_eq_right (by linarith)]; ring
  · rw [max_eq_right h, max_eq_left (by linarith)]; ring

lemma ofReal_max_zero (a : ℝ) : ENNReal.ofReal (max a 0) = ENNReal.ofReal a := by
  rcases le_total 0 a with h | h
  · rw [max_eq_left h]
  · rw [max_eq_right h, ENNReal.ofReal_of_nonpos h, ENNReal.ofReal_zero]

lemma CumulativeProcess.V0_reward : (fun ω => (C.V 0 ω).2.1) = cycleReward C.renewal C.w 1 := rfl

lemma CumulativeProcess.lintegral_pos_part_ne_top
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (max (C.V 0 ω).2.1 0) ∂C.renewal.P ≠ ⊤ := by
  refine ne_top_of_le_ne_top hκ.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
  rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal (le_abs_self _)

lemma CumulativeProcess.lintegral_neg_part_ne_top
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    ∫⁻ ω, ENNReal.ofReal (max (-(C.V 0 ω).2.1) 0) ∂C.renewal.P ≠ ⊤ := by
  refine ne_top_of_le_ne_top hκ.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
  rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
  exact ENNReal.ofReal_le_ofReal (neg_le_abs _)

theorem CumulativeProcess.integrable_overshootReward
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) {t : ℝ} (ht : 0 ≤ t) :
    Integrable (C.overshootReward t) C.renewal.P := by
  have h : C.overshootReward t = fun ω =>
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
    funext ω; exact C.overshootReward_eq t ω
  have hgp : Measurable fun v : ℝ × ℝ × ℝ => max v.2.1 0 := by fun_prop
  have hgn : Measurable fun v : ℝ × ℝ × ℝ => max (-v.2.1) 0 := by fun_prop
  rw [h]
  exact (C.integrable_G _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht).sub
    (C.integrable_G _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht)

theorem CumulativeProcess.integral_overshootReward
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) {t : ℝ} (ht : 0 ≤ t) :
    ∫ ω, C.overshootReward t ω ∂C.renewal.P = C.meanReward * (C.H t + 1) := by
  have h : C.overshootReward t = fun ω =>
      C.G (fun v => max v.2.1 0) 1 t ω - C.G (fun v => max (-v.2.1) 0) 1 t ω := by
    funext ω; exact C.overshootReward_eq t ω
  have hgp : Measurable fun v : ℝ × ℝ × ℝ => max v.2.1 0 := by fun_prop
  have hgn : Measurable fun v : ℝ × ℝ × ℝ => max (-v.2.1) 0 := by fun_prop
  have hp := C.integrable_G _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht
  have hn := C.integrable_G _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht
  rw [h]
  beta_reduce
  rw [integral_sub hp hn,
    C.integral_G _ hgp (fun v => le_max_right _ _) (C.lintegral_pos_part_ne_top hκ) 1 ht,
    C.integral_G _ hgn (fun v => le_max_right _ _) (C.lintegral_neg_part_ne_top hκ) 1 ht]
  have hκ' : C.meanReward = ∫ ω, (C.V 0 ω).2.1 ∂C.renewal.P := rfl
  rw [hκ', integral_eq_lintegral_pos_part_sub_lintegral_neg_part (by rw [C.V0_reward]; exact hκ)]
  simp only [ofReal_max_zero]
  push_cast
  ring

theorem lemma_4_mean_core {Ω : Type*} [MeasurableSpace Ω]
    (C : CumulativeProcess Ω)
    (hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P)
    (hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P) :
    (∀ t : ℝ, 0 ≤ t → Integrable (C.overshootReward t) C.renewal.P) ∧
    (fun t : ℝ =>
      (∫ ω, C.overshootReward t ω ∂C.renewal.P) -
        C.meanReward / C.meanLength * t) =o[atTop] (fun t : ℝ => t) := by
  refine ⟨fun t ht => C.integrable_overshootReward hμ hκ ht, ?_⟩
  rw [Asymptotics.isLittleO_iff_tendsto']
  · have h1 : Tendsto (fun t : ℝ => C.meanReward * (C.H t / t - 1 / C.meanLength) +
        C.meanReward / t) atTop (𝓝 0) := by
      have h2 := ((C.H_div_tendsto hμ).sub_const (1 / C.meanLength)).const_mul C.meanReward
      have h3 : Tendsto (fun t : ℝ => C.meanReward / t) atTop (𝓝 0) :=
        tendsto_const_nhds.div_atTop tendsto_id
      simpa using h2.add h3
    refine h1.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with t ht
    rw [C.integral_overshootReward hμ hκ ht.le]
    field_simp
    ring
  · filter_upwards [eventually_gt_atTop 0] with t ht h
    exact absurd h ht.ne'

/-! ### Lemma 9: the moment of the cycle increment of the cycle containing `t` -/

/-- Independence of a function of cycle `i` and an event measurable w.r.t. cycles `< k ≤ i`. -/
lemma CumulativeProcess.indepFun_V_set {β : Type*} [MeasurableSpace β]
    (f : ℝ × ℝ × ℝ → β) (hf : Measurable f) {k i : ℕ} (hki : k ≤ i) {B : Set Ω}
    (hB : MeasurableSet[C.sigS (Finset.range k)] B) :
    IndepFun (fun ω => f (C.V i ω)) (B.indicator (fun _ => (1 : ENNReal))) C.renewal.P := by
  have hind := indep_iSup_of_disjoint (μ := C.renewal.P)
    (m := fun l => MeasurableSpace.comap (C.V l) inferInstance)
    (fun l => (C.measurable_V l).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 C.iIndep_V)
    (S := ((Finset.range k : Finset ℕ) : Set ℕ)) (T := (({i} : Finset ℕ) : Set ℕ))
    (by
      rw [Finset.disjoint_coe]
      simp only [Finset.disjoint_singleton_right, Finset.mem_range]
      omega)
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_left (indep_of_indep_of_le_right hind.symm ?_) ?_
  · rw [← measurable_iff_comap_le]
    exact measurable_const.indicator hB
  · rw [← measurable_iff_comap_le]
    exact hf.comp (C.measurable_V_sigS {i} (Finset.mem_singleton_self i))

lemma CumulativeProcess.lintegral_V_mul_indicator (f : ℝ × ℝ × ℝ → ENNReal) (hf : Measurable f)
    {k i : ℕ} (hki : k ≤ i) {B : Set Ω} (hB : MeasurableSet[C.sigS (Finset.range k)] B) :
    ∫⁻ ω, f (C.V i ω) * B.indicator (fun _ => (1 : ENNReal)) ω ∂C.renewal.P =
      (∫⁻ ω, f (C.V 0 ω) ∂C.renewal.P) * C.renewal.P B := by
  have hBm : MeasurableSet B := C.sigS_le _ _ hB
  rw [lintegral_mul_eq_lintegral_mul_lintegral_of_indepFun'' (f := fun ω => f (C.V i ω))
    (hf.comp (C.measurable_V i)).aemeasurable (measurable_const.indicator hBm).aemeasurable
    (C.indepFun_V_set f hf hki hB), C.lintegral_V_eq f hf i, lintegral_indicator_const hBm, one_mul]

lemma CumulativeProcess.tsum_measure_A
    (t : ℝ) (m : ℕ) :
    ∑' i, C.renewal.P (C.A t (i + 1 - m)) =
      ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P := by
  have hw := C.wald (fun _ => (1 : ENNReal)) measurable_const t m
  simp only [lintegral_const, one_mul, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
    at hw
  have := C.renewal.probability
  rw [measure_univ, one_mul] at hw
  rw [← hw]
  have e2 : ∫⁻ ω, ((C.renewal.count t ω + m : ℕ) : ENNReal) ∂C.renewal.P =
      ∫⁻ ω, ∑' i, (C.A t (i + 1 - m)).indicator (fun _ => (1 : ENNReal)) ω ∂C.renewal.P := by
    refine lintegral_congr_ae ?_
    filter_upwards [C.ae_exists_epoch_gt t] with ω hω
    have e3 := C.sum_range_count_eq_tsum hω m (fun _ => 1)
    simp only [one_mul] at e3
    rw [← e3]
    simp
  rw [e2, lintegral_tsum fun i => (measurable_const.indicator (C.measurableSet_A t _)).aemeasurable]
  exact tsum_congr fun i => by rw [lintegral_indicator_const (C.measurableSet_A t _), one_mul]

/-- `{n_t = i + 1}` as a measurable set. -/
def CumulativeProcess.D (t : ℝ) (i : ℕ) : Set Ω := C.A t (i + 1) \ C.A t (i + 2)

lemma CumulativeProcess.measurableSet_D (t : ℝ) (i : ℕ) : MeasurableSet (C.D t i) :=
  (C.measurableSet_A t _).diff (C.measurableSet_A t _)

lemma CumulativeProcess.mem_D_iff {t : ℝ} {ω : Ω} (hS : ∃ n, t < C.renewal.epoch n ω) (i : ℕ) :
    ω ∈ C.D t i ↔ C.renewal.count t ω = i + 1 := by
  simp only [CumulativeProcess.D, Set.mem_diff, ← C.le_count_iff hS]
  omega

lemma CumulativeProcess.A_succ (t : ℝ) (k : ℕ) :
    C.A t (k + 1) = C.A t k ∩ {ω | C.renewal.epoch k ω ≤ t} := by
  ext ω
  simp only [CumulativeProcess.A, Set.mem_setOf_eq, Set.mem_inter_iff]
  constructor
  · intro h; exact ⟨fun j hj => h j (by omega), h k (by omega)⟩
  · rintro ⟨h1, h2⟩ j hj
    rcases Nat.lt_succ_iff_lt_or_eq.1 hj with h | h
    · exact h1 j h
    · subst h; exact h2

lemma CumulativeProcess.epoch_succ (i : ℕ) (ω : Ω) :
    C.renewal.epoch (i + 1) ω = C.renewal.epoch i ω + (C.V i ω).1 := by
  rw [C.epoch_eq, C.epoch_eq, Finset.sum_range_succ]

/-- The tail function `g(a) = E[h(V₀) ; a < t₁]`. -/
noncomputable def CumulativeProcess.tailFun (h : ℝ × ℝ × ℝ → ℝ) (a : ℝ) : ENNReal :=
  ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) * ({ω | a < (C.V 0 ω).1}).indicator (fun _ => (1 : ENNReal)) ω
    ∂C.renewal.P

lemma CumulativeProcess.tailFun_le (h : ℝ × ℝ × ℝ → ℝ) (a : ℝ) :
    C.tailFun h a ≤ ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P := by
  refine lintegral_mono fun ω => ?_
  calc ENNReal.ofReal (h (C.V 0 ω)) * ({ω | a < (C.V 0 ω).1}).indicator (fun _ => (1 : ENNReal)) ω
      ≤ ENNReal.ofReal (h (C.V 0 ω)) * 1 :=
        mul_le_mul' le_rfl (Set.indicator_apply_le' (fun _ => le_rfl) (fun _ => zero_le_one))
    _ = _ := mul_one _

lemma CumulativeProcess.tailFun_tendsto (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h)
    (hfin : ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) :
    Tendsto (fun a : ℕ => C.tailFun h a) atTop (𝓝 0) := by
  have := tendsto_lintegral_of_dominated_convergence (μ := C.renewal.P)
    (F := fun (a : ℕ) (ω : Ω) => ENNReal.ofReal (h (C.V 0 ω)) *
      ({ω | (a : ℝ) < (C.V 0 ω).1}).indicator (fun _ => (1 : ENNReal)) ω)
    (f := fun _ => 0) (fun ω => ENNReal.ofReal (h (C.V 0 ω)))
    (fun a => (ENNReal.measurable_ofReal.comp (hh.comp (C.measurable_V 0))).mul
      (measurable_const.indicator (measurableSet_lt measurable_const (C.measurable_V 0).fst)))
    (fun a => Eventually.of_forall fun ω => by
      show ENNReal.ofReal (h (C.V 0 ω)) *
        ({ω | (a : ℝ) < (C.V 0 ω).1}).indicator (fun _ => (1 : ENNReal)) ω ≤ ENNReal.ofReal (h (C.V 0 ω))
      have hind : ({ω | (a : ℝ) < (C.V 0 ω).1}).indicator (fun _ => (1 : ENNReal)) ω ≤ 1 :=
        Set.indicator_apply_le' (fun _ => le_rfl) (fun _ => zero_le_one)
      calc _ ≤ ENNReal.ofReal (h (C.V 0 ω)) * 1 := mul_le_mul' le_rfl hind
        _ = _ := mul_one _)
    hfin
    (Eventually.of_forall fun ω => by
      refine tendsto_const_nhds.congr' ?_
      obtain ⟨N, hN⟩ := exists_nat_ge (C.V 0 ω).1
      filter_upwards [eventually_ge_atTop N] with a ha
      have : ω ∉ {ω | (a : ℝ) < (C.V 0 ω).1} := by
        simp only [Set.mem_setOf_eq, not_lt]
        exact hN.trans (by exact_mod_cast ha)
      simp [Set.indicator_of_notMem this])
  simpa [CumulativeProcess.tailFun] using this

/-- Pointwise: on the a.s. event, `#{i < n_t : T_i > t - a} + n_{t-a} ≤ n_t`. -/
lemma CumulativeProcess.count_split {t a : ℝ} (ha : 0 ≤ a) {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) (hS' : ∃ n, t - a < C.renewal.epoch n ω) :
    (∑ i ∈ Finset.range (C.renewal.count t ω), (if t - a < C.renewal.epoch i ω then 1 else 0 : ℕ))
      + C.renewal.count (t - a) ω ≤ C.renewal.count t ω := by
  have hle : C.renewal.count (t - a) ω ≤ C.renewal.count t ω := by
    have hmem := C.lt_epoch_count hS
    exact Nat.sInf_le (by simp only [Set.mem_setOf_eq]; linarith)
  have hA : ∀ i < C.renewal.count (t - a) ω, C.renewal.epoch i ω ≤ t - a :=
    (C.le_count_iff hS' _).1 le_rfl
  have h1 : C.renewal.count (t - a) ω ≤
      ∑ i ∈ Finset.range (C.renewal.count t ω), (if C.renewal.epoch i ω ≤ t - a then 1 else 0 : ℕ) := by
    calc C.renewal.count (t - a) ω
        = ∑ i ∈ Finset.range (C.renewal.count (t - a) ω), (if C.renewal.epoch i ω ≤ t - a then 1 else 0 : ℕ) := by
          rw [Finset.sum_congr rfl (g := fun _ => (1 : ℕ))]
          · simp
          · intro i hi
            rw [if_pos (hA i (Finset.mem_range.1 hi))]
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hle)
          (fun _ _ _ => Nat.zero_le _)
  calc _ ≤ (∑ i ∈ Finset.range (C.renewal.count t ω), (if t - a < C.renewal.epoch i ω then 1 else 0 : ℕ))
        + ∑ i ∈ Finset.range (C.renewal.count t ω), (if C.renewal.epoch i ω ≤ t - a then 1 else 0 : ℕ) :=
        Nat.add_le_add_left h1 _
    _ = ∑ i ∈ Finset.range (C.renewal.count t ω), (1 : ℕ) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun i _ => ?_
        split_ifs with h1 h2 <;> first | rfl | (exfalso; linarith) | omega
    _ = _ := by simp

/-- The key bound for Lemma 9. -/
lemma CumulativeProcess.lintegral_D_bound
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) (hh0 : ∀ v, 0 ≤ h v) {t : ℝ} (a : ℕ) (hta : (a : ℝ) ≤ t) :
    (∑' i, ∫⁻ ω, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω
      ∂C.renewal.P) + (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P) * C.nt (t - a) ≤
      C.tailFun h a * C.nt t + (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P) * C.nt t := by
  set G := ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P with hG
  -- the two pieces
  set B1 : ℕ → Set Ω := fun i => C.A t (i + 1) ∩ {ω | C.renewal.epoch i ω ≤ t - a} with hB1
  set B2 : ℕ → Set Ω := fun i => C.A t (i + 1) ∩ {ω | t - a < C.renewal.epoch i ω} with hB2
  have hB1m : ∀ i, MeasurableSet[C.sigS (Finset.range i)] (B1 i) := fun i =>
    (C.measurableSet_A_sigS t (i + 1)).inter
      (measurableSet_le (C.measurable_epoch_sigS i le_rfl) measurable_const)
  have hB2m : ∀ i, MeasurableSet[C.sigS (Finset.range i)] (B2 i) := fun i =>
    (C.measurableSet_A_sigS t (i + 1)).inter
      (measurableSet_lt measurable_const (C.measurable_epoch_sigS i le_rfl))
  have hB1M : ∀ i, MeasurableSet (B1 i) := fun i => C.sigS_le _ _ (hB1m i)
  have hB2M : ∀ i, MeasurableSet (B2 i) := fun i => C.sigS_le _ _ (hB2m i)
  -- pointwise bound
  have hpt : ∀ i ω, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω ≤
      (ENNReal.ofReal (h (C.V i ω)) * ({v : ℝ × ℝ × ℝ | (a : ℝ) < v.1}).indicator
          (fun _ => (1 : ENNReal)) (C.V i ω)) * (B1 i).indicator (fun _ => (1 : ENNReal)) ω +
      ENNReal.ofReal (h (C.V i ω)) * (B2 i).indicator (fun _ => (1 : ENNReal)) ω := by
    intro i ω
    by_cases hD : ω ∈ C.D t i
    · rw [Set.indicator_of_mem hD]
      have hA1 : ω ∈ C.A t (i + 1) := hD.1
      have hA2 : ω ∉ C.A t (i + 2) := hD.2
      rw [C.A_succ t (i + 1)] at hA2
      have hT : t < C.renewal.epoch (i + 1) ω := by
        by_contra hc
        exact hA2 ⟨hA1, not_lt.1 hc⟩
      rw [C.epoch_succ] at hT
      by_cases hle : C.renewal.epoch i ω ≤ t - a
      · have hm1 : ω ∈ B1 i := ⟨hA1, hle⟩
        have hv : C.V i ω ∈ {v : ℝ × ℝ × ℝ | (a : ℝ) < v.1} := by
          simp only [Set.mem_setOf_eq]; linarith
        rw [Set.indicator_of_mem hm1, Set.indicator_of_mem hv]
        simp
      · have hm2 : ω ∈ B2 i := ⟨hA1, not_le.1 hle⟩
        rw [Set.indicator_of_mem hm2]
        simp
    · rw [Set.indicator_of_notMem hD]
      simp
  have hfm : Measurable fun v : ℝ × ℝ × ℝ => ENNReal.ofReal (h v) *
      ({v : ℝ × ℝ × ℝ | (a : ℝ) < v.1}).indicator (fun _ => (1 : ENNReal)) v :=
    (ENNReal.measurable_ofReal.comp hh).mul
      (measurable_const.indicator (measurableSet_lt measurable_const measurable_fst))
  have hterm : ∀ i, ∫⁻ ω, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω
      ∂C.renewal.P ≤ C.tailFun h a * C.renewal.P (B1 i) + G * C.renewal.P (B2 i) := by
    intro i
    calc _ ≤ ∫⁻ ω, (ENNReal.ofReal (h (C.V i ω)) * ({v : ℝ × ℝ × ℝ | (a : ℝ) < v.1}).indicator
          (fun _ => (1 : ENNReal)) (C.V i ω)) * (B1 i).indicator (fun _ => (1 : ENNReal)) ω +
          ENNReal.ofReal (h (C.V i ω)) * (B2 i).indicator (fun _ => (1 : ENNReal)) ω ∂C.renewal.P :=
          lintegral_mono (hpt i)
      _ = _ := by
          have hm1 : Measurable fun ω => (ENNReal.ofReal (h (C.V i ω)) *
              ({v : ℝ × ℝ × ℝ | (a : ℝ) < v.1}).indicator (fun _ => (1 : ENNReal)) (C.V i ω)) *
              (B1 i).indicator (fun _ => (1 : ENNReal)) ω :=
            (hfm.comp (C.measurable_V i)).mul (measurable_const.indicator (hB1M i))
          rw [lintegral_add_left hm1]
          have e1 := C.lintegral_V_mul_indicator _ hfm le_rfl (hB1m i)
          have e2 := C.lintegral_V_mul_indicator (fun v => ENNReal.ofReal (h v))
            (ENNReal.measurable_ofReal.comp hh) le_rfl (hB2m i)
          beta_reduce at e1 e2
          rw [e1, e2]
          rfl
  have hsum1 : ∑' i, C.renewal.P (B1 i) ≤ C.nt t := by
    calc ∑' i, C.renewal.P (B1 i) ≤ ∑' i, C.renewal.P (C.A t (i + 1 - 0)) :=
          ENNReal.tsum_le_tsum fun i => measure_mono Set.inter_subset_left
      _ = _ := by
          rw [C.tsum_measure_A t 0]
          simp [CumulativeProcess.nt]
  have hsum2 : ∑' i, C.renewal.P (B2 i) + C.nt (t - a) ≤ C.nt t := by
    have hmeas2 : ∀ i, Measurable ((B2 i).indicator (fun _ => (1 : ENNReal))) := fun i =>
      measurable_const.indicator (hB2M i)
    have e : ∑' i, C.renewal.P (B2 i) =
        ∫⁻ ω, ∑' i, (B2 i).indicator (fun _ => (1 : ENNReal)) ω ∂C.renewal.P := by
      rw [lintegral_tsum fun i => (hmeas2 i).aemeasurable]
      exact tsum_congr fun i => by rw [lintegral_indicator_const (hB2M i), one_mul]
    rw [e]
    unfold CumulativeProcess.nt
    rw [← lintegral_add_left (Measurable.tsum hmeas2)]
    refine lintegral_mono_ae ?_
    filter_upwards [C.ae_exists_epoch_gt t, C.ae_exists_epoch_gt (t - a)] with ω hS hS'
    have hc := C.count_split (a := a) (by positivity) hS hS'
    have e3 : ∑' i, (B2 i).indicator (fun _ => (1 : ENNReal)) ω =
        ((∑ i ∈ Finset.range (C.renewal.count t ω),
          (if t - a < C.renewal.epoch i ω then 1 else 0 : ℕ) : ℕ) : ENNReal) := by
      rw [tsum_eq_sum (s := Finset.range (C.renewal.count t ω))]
      · push_cast
        refine Finset.sum_congr rfl fun i hi => ?_
        have hA : ω ∈ C.A t (i + 1) := by
          rw [← C.le_count_iff hS]
          have := Finset.mem_range.1 hi
          omega
        by_cases hlt : t - a < C.renewal.epoch i ω
        · rw [Set.indicator_of_mem (show ω ∈ B2 i from ⟨hA, hlt⟩), if_pos hlt]
        · rw [Set.indicator_of_notMem (show ω ∉ B2 i from fun hm => hlt hm.2), if_neg hlt]
      · intro i hi
        have hA : ω ∉ C.A t (i + 1) := by
          rw [← C.le_count_iff hS]
          have : ¬ i < C.renewal.count t ω := fun h' => hi (Finset.mem_range.2 h')
          omega
        exact Set.indicator_of_notMem (show ω ∉ B2 i from fun hm => hA hm.1) _
    rw [e3]
    exact_mod_cast hc
  calc (∑' i, ∫⁻ ω, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P) + G * C.nt (t - a)
      ≤ (∑' i, (C.tailFun h a * C.renewal.P (B1 i) + G * C.renewal.P (B2 i))) + G * C.nt (t - a) :=
        add_le_add (ENNReal.tsum_le_tsum hterm) le_rfl
    _ = C.tailFun h a * ∑' i, C.renewal.P (B1 i) + G * (∑' i, C.renewal.P (B2 i) + C.nt (t - a)) := by
        rw [ENNReal.tsum_add, ENNReal.tsum_mul_left, ENNReal.tsum_mul_left, mul_add, add_assoc]
    _ ≤ C.tailFun h a * C.nt t + G * C.nt t :=
        add_le_add (mul_le_mul' le_rfl hsum1) (mul_le_mul' le_rfl hsum2)

/-! ### A general functional of the cycle containing `t` -/

/-- `h(V_{n_t - 1})`: a function of the cycle triple of the cycle containing `t`. -/
noncomputable def CumulativeProcess.ZZ (h : ℝ × ℝ × ℝ → ℝ) (t : ℝ) (ω : Ω) : ℝ :=
  h (C.V (C.renewal.count t ω - 1) ω)

lemma CumulativeProcess.ofReal_ZZ_eq
    (h : ℝ × ℝ × ℝ → ℝ) {t : ℝ} (ht : 0 ≤ t) :
    ∀ᵐ ω ∂C.renewal.P, ENNReal.ofReal (C.ZZ h t ω) =
      ∑' i, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω := by
  filter_upwards [C.ae_exists_epoch_gt t] with ω hS
  have h1 := C.one_le_count ht hS
  obtain ⟨i₀, hi₀⟩ : ∃ i₀, C.renewal.count t ω = i₀ + 1 := ⟨_, (Nat.succ_pred_eq_of_pos h1).symm⟩
  rw [tsum_eq_single i₀]
  · have hD : ω ∈ C.D t i₀ := (C.mem_D_iff hS i₀).2 hi₀
    rw [Set.indicator_of_mem hD, mul_one]
    unfold CumulativeProcess.ZZ
    rw [hi₀, Nat.add_sub_cancel]
  · intro i hi
    have hD : ω ∉ C.D t i := fun hm => hi (by have := (C.mem_D_iff hS i).1 hm; omega)
    rw [Set.indicator_of_notMem hD, mul_zero]

lemma CumulativeProcess.aemeasurable_ZZ
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) (hh0 : ∀ v, 0 ≤ h v) {t : ℝ} (ht : 0 ≤ t) :
    AEMeasurable (C.ZZ h t) C.renewal.P := by
  have hmeas : Measurable (fun ω => (∑' i, ENNReal.ofReal (h (C.V i ω)) *
      (C.D t i).indicator (fun _ => (1 : ENNReal)) ω).toReal) := by
    refine ENNReal.measurable_toReal.comp (Measurable.tsum fun i => ?_)
    exact ((ENNReal.measurable_ofReal.comp (hh.comp (C.measurable_V i))).mul
      (measurable_const.indicator (C.measurableSet_D t i)))
  refine ⟨_, hmeas, ?_⟩
  filter_upwards [C.ofReal_ZZ_eq h ht] with ω hω
  rw [← hω]
  exact (ENNReal.toReal_ofReal (hh0 _)).symm

lemma CumulativeProcess.lintegral_ZZ_eq
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) {t : ℝ} (ht : 0 ≤ t) :
    ∫⁻ ω, ENNReal.ofReal (C.ZZ h t ω) ∂C.renewal.P =
      ∑' i, ∫⁻ ω, ENNReal.ofReal (h (C.V i ω)) * (C.D t i).indicator (fun _ => (1 : ENNReal)) ω
        ∂C.renewal.P := by
  rw [lintegral_congr_ae (C.ofReal_ZZ_eq h ht), lintegral_tsum]
  intro i
  exact ((ENNReal.measurable_ofReal.comp (hh.comp (C.measurable_V i))).mul
      (measurable_const.indicator (C.measurableSet_D t i))).aemeasurable

lemma CumulativeProcess.lintegral_ZZ_le
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) {t : ℝ} (ht : 0 ≤ t) :
    ∫⁻ ω, ENNReal.ofReal (C.ZZ h t ω) ∂C.renewal.P ≤
      (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P) * C.nt t := by
  rw [C.lintegral_ZZ_eq h hh ht]
  calc _ ≤ ∑' i, ∫⁻ ω, ENNReal.ofReal (h (C.V i ω)) *
        (C.A t (i + 1)).indicator (fun _ => (1 : ENNReal)) ω ∂C.renewal.P := by
        refine ENNReal.tsum_le_tsum fun i => lintegral_mono fun ω => ?_
        exact mul_le_mul' le_rfl
          (Set.indicator_le_indicator_of_subset Set.diff_subset (fun _ => zero_le_one) ω)
    _ = ∑' i, (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P) * C.renewal.P (C.A t (i + 1)) :=
        tsum_congr fun i => C.lintegral_V_mul_indicator (fun v => ENNReal.ofReal (h v))
          (ENNReal.measurable_ofReal.comp hh) le_rfl (C.measurableSet_A_sigS t (i + 1))
    _ = _ := by
        rw [ENNReal.tsum_mul_left]
        congr 1
        have := C.tsum_measure_A t 0
        simp only [Nat.sub_zero, add_zero] at this
        rw [this]
        rfl

theorem CumulativeProcess.integrable_ZZ
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) (hh0 : ∀ v, 0 ≤ h v)
    (hfin : ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P ≠ ⊤)
    {t : ℝ} (ht : 0 ≤ t) : Integrable (C.ZZ h t) C.renewal.P := by
  refine ⟨(C.aemeasurable_ZZ h hh hh0 ht).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_ofReal (f := C.ZZ h t) (Eventually.of_forall (fun ω => hh0 _))]
  exact lt_of_le_of_lt (C.lintegral_ZZ_le h hh ht)
    (ENNReal.mul_lt_top hfin.lt_top (C.nt_ne_top' ht).lt_top)

lemma CumulativeProcess.integral_ZZ_bound
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) (hh0 : ∀ v, 0 ≤ h v)
    (hG : ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P ≠ ⊤)
    (a : ℕ) {t : ℝ} (hta : (a : ℝ) ≤ t) :
    ∫ ω, C.ZZ h t ω ∂C.renewal.P ≤
      (C.tailFun h a).toReal * C.H t +
        (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P).toReal * (C.H t - C.H (t - a)) := by
  have ht : 0 ≤ t := le_trans (by positivity) hta
  have hta' : 0 ≤ t - a := by linarith
  have hg : C.tailFun h a ≠ ⊤ := ne_top_of_le_ne_top hG (C.tailFun_le _ _)
  have hnt := C.nt_ne_top' ht
  have hnt' := C.nt_ne_top' hta'
  have hb := C.lintegral_D_bound h hh hh0 a hta
  rw [← C.lintegral_ZZ_eq h hh ht] at hb
  have hZ : ∫ ω, C.ZZ h t ω ∂C.renewal.P =
      (∫⁻ ω, ENNReal.ofReal (C.ZZ h t ω) ∂C.renewal.P).toReal :=
    integral_eq_lintegral_of_nonneg_ae (f := C.ZZ h t) (Eventually.of_forall (fun ω => hh0 _))
      (C.aemeasurable_ZZ h hh hh0 ht).aestronglyMeasurable
  have hZfin : ∫⁻ ω, ENNReal.ofReal (C.ZZ h t ω) ∂C.renewal.P ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top hG hnt) (C.lintegral_ZZ_le h hh ht)
  have hr := ENNReal.toReal_mono
    (ENNReal.add_ne_top.2 ⟨ENNReal.mul_ne_top hg hnt, ENNReal.mul_ne_top hG hnt⟩) hb
  rw [ENNReal.toReal_add hZfin (ENNReal.mul_ne_top hG hnt'),
    ENNReal.toReal_add (ENNReal.mul_ne_top hg hnt) (ENNReal.mul_ne_top hG hnt),
    ENNReal.toReal_mul, ENNReal.toReal_mul, ENNReal.toReal_mul] at hr
  rw [hZ]
  unfold CumulativeProcess.H
  linarith

theorem CumulativeProcess.integral_ZZ_div_tendsto
    (h : ℝ × ℝ × ℝ → ℝ) (hh : Measurable h) (hh0 : ∀ v, 0 ≤ h v)
    (hG : ∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P ≠ ⊤) :
    Tendsto (fun t : ℝ => (∫ ω, C.ZZ h t ω ∂C.renewal.P) / t) atTop (𝓝 0) := by
  obtain ⟨L, hL0, hL⟩ := C.exists_H_div_tendsto
  set Gr := (∫⁻ ω, ENNReal.ofReal (h (C.V 0 ω)) ∂C.renewal.P).toReal with hGr
  have hGr0 : 0 ≤ Gr := ENNReal.toReal_nonneg
  rw [Metric.tendsto_atTop]
  intro ε hε
  have hpos : (0 : ENNReal) < ENNReal.ofReal (ε / (2 * (L + 1))) :=
    ENNReal.ofReal_pos.2 (by positivity)
  obtain ⟨a, ha⟩ := eventually_atTop.1
    ((C.tailFun_tendsto h hh hG).eventually (gt_mem_nhds hpos))
  set ga := (C.tailFun h a).toReal with hga_def
  have hga : ga ≤ ε / (2 * (L + 1)) :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) (ha a le_rfl).le
  have hga0 : 0 ≤ ga := ENNReal.toReal_nonneg
  have hHa : Tendsto (fun t : ℝ => C.H (t - a) / t) atTop (𝓝 L) := by
    have h1 : Tendsto (fun t : ℝ => C.H (t - a) / (t - a)) atTop (𝓝 L) :=
      hL.comp (tendsto_atTop_add_const_right atTop (-(a : ℝ)) tendsto_id)
        |>.congr' (Eventually.of_forall fun t => by simp [sub_eq_add_neg])
    have h2 : Tendsto (fun t : ℝ => (t - a) / t) atTop (𝓝 1) := by
      have h3 : Tendsto (fun t : ℝ => 1 - (a : ℝ) / t) atTop (𝓝 (1 - 0)) :=
        tendsto_const_nhds.sub (tendsto_const_nhds.div_atTop tendsto_id)
      rw [sub_zero] at h3
      refine h3.congr' ?_
      filter_upwards [eventually_gt_atTop 0] with t ht
      field_simp
    have := h1.mul h2
    rw [mul_one] at this
    refine this.congr' ?_
    filter_upwards [eventually_gt_atTop (a : ℝ)] with t ht
    have : t - a ≠ 0 := by linarith
    field_simp
  have hR : Tendsto (fun t : ℝ => ga * (C.H t / t) + Gr * (C.H t / t - C.H (t - a) / t)) atTop
      (𝓝 (ga * L + Gr * (L - L))) :=
    (hL.const_mul ga).add ((hL.sub hHa).const_mul Gr)
  have hlim : ga * L + Gr * (L - L) < ε := by
    rw [sub_self, mul_zero, add_zero]
    calc ga * L ≤ (ε / (2 * (L + 1))) * L := by gcongr
      _ < ε := by
        rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
        nlinarith
  obtain ⟨T, hT⟩ := eventually_atTop.1 (hR.eventually (gt_mem_nhds hlim))
  refine ⟨max T ((a : ℝ) + 1), fun t ht => ?_⟩
  have ht1 : T ≤ t := le_trans (le_max_left _ _) ht
  have ht2 : (a : ℝ) + 1 ≤ t := le_trans (le_max_right _ _) ht
  have htpos : 0 < t := by linarith [(by positivity : (0 : ℝ) ≤ a)]
  have hb := C.integral_ZZ_bound h hh hh0 hG a (by linarith : (a : ℝ) ≤ t)
  have hI0 : 0 ≤ ∫ ω, C.ZZ h t ω ∂C.renewal.P := integral_nonneg (fun ω => hh0 _)
  rw [Real.dist_eq, sub_zero, abs_of_nonneg (div_nonneg hI0 htpos.le)]
  calc (∫ ω, C.ZZ h t ω ∂C.renewal.P) / t
      ≤ (ga * C.H t + Gr * (C.H t - C.H (t - a))) / t := by gcongr
    _ = ga * (C.H t / t) + Gr * (C.H t / t - C.H (t - a) / t) := by field_simp
    _ < ε := hT t ht1

/-! ### Theorem 8 (i) -/

lemma abs_sub_le_eVar {f : ℝ → ℝ} {s : Set ℝ} (hbv : eVariationOn f s ≠ ⊤) {x y : ℝ}
    (hx : x ∈ s) (hy : y ∈ s) : |f x - f y| ≤ (eVariationOn f s).toReal := by
  rw [← Real.dist_eq, dist_edist]
  exact ENNReal.toReal_mono hbv (eVariationOn.edist_le f hx hy)

lemma CumulativeProcess.epoch_nonneg {ω : Ω} (hω : ∀ i, 0 ≤ (C.V i ω).1) (n : ℕ) :
    0 ≤ C.renewal.epoch n ω := by
  rw [C.epoch_eq]; exact Finset.sum_nonneg fun l _ => hω l

lemma CumulativeProcess.epoch_mono {ω : Ω} (hω : ∀ i, 0 ≤ (C.V i ω).1) {m n : ℕ}
    (h : m ≤ n) : C.renewal.epoch m ω ≤ C.renewal.epoch n ω := by
  rw [C.epoch_eq, C.epoch_eq]
  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono h) (fun l _ _ => hω l)

lemma CumulativeProcess.ae_good (t : ℝ) : ∀ᵐ ω ∂C.renewal.P,
    (∀ i, 0 ≤ (C.V i ω).1) ∧ C.w 0 ω = 0 ∧
    (∀ s : ℝ, 0 ≤ s → BoundedVariationOn (fun u => C.w u ω) (Set.Icc 0 s)) ∧
    ∃ n, t < C.renewal.epoch n ω := by
  filter_upwards [C.ae_nonneg_cycles, C.zero_initial, C.bounded_variation,
    C.ae_exists_epoch_gt t] with ω h1 h2 h3 h4
  exact ⟨h1, h2, h3, h4⟩

lemma CumulativeProcess.eVar_cycle_ne_top {ω : Ω} (h1 : ∀ i, 0 ≤ (C.V i ω).1)
    (h3 : ∀ s : ℝ, 0 ≤ s → BoundedVariationOn (fun u => C.w u ω) (Set.Icc 0 s)) (i : ℕ) :
    eVariationOn (fun s => C.w s ω)
      (Set.Icc (C.renewal.epoch i ω) (C.renewal.epoch (i + 1) ω)) ≠ ⊤ := by
  have hT : 0 ≤ C.renewal.epoch i ω := C.epoch_nonneg h1 i
  have hT' : C.renewal.epoch i ω ≤ C.renewal.epoch (i + 1) ω := C.epoch_mono h1 (Nat.le_succ i)
  have hb : eVariationOn (fun u => C.w u ω) (Set.Icc 0 (C.renewal.epoch (i + 1) ω)) ≠ ⊤ :=
    h3 _ (hT.trans hT')
  exact ne_top_of_le_ne_top hb (eVariationOn.mono _ (Set.Icc_subset_Icc hT le_rfl))

lemma CumulativeProcess.abs_reward_le_variation (i : ℕ) :
    ∀ᵐ ω ∂C.renewal.P,
      |cycleReward C.renewal C.w (i + 1) ω| ≤ cycleVariation C.renewal C.w (i + 1) ω := by
  filter_upwards [C.ae_good 0] with ω hg
  obtain ⟨h1, -, h3, -⟩ := hg
  have hT' : C.renewal.epoch i ω ≤ C.renewal.epoch (i + 1) ω := C.epoch_mono h1 (Nat.le_succ i)
  have hbv := C.eVar_cycle_ne_top h1 h3 i
  unfold cycleReward cycleVariation
  simp only [Nat.add_sub_cancel]
  exact abs_sub_le_eVar hbv ⟨hT', le_rfl⟩ ⟨le_rfl, hT'⟩

/-- positive / negative part of the reward coordinate, and the variation coordinate -/
noncomputable def yP (v : ℝ × ℝ × ℝ) : ℝ := max v.2.1 0
noncomputable def yN (v : ℝ × ℝ × ℝ) : ℝ := max (-v.2.1) 0
noncomputable def yV (v : ℝ × ℝ × ℝ) : ℝ := |v.2.2|

lemma measurable_yP : Measurable yP := by unfold yP; fun_prop
lemma measurable_yN : Measurable yN := by unfold yN; fun_prop
lemma measurable_yV : Measurable yV := by unfold yV; fun_prop
lemma yP_nonneg (v : ℝ × ℝ × ℝ) : 0 ≤ yP v := le_max_right _ _
lemma yN_nonneg (v : ℝ × ℝ × ℝ) : 0 ≤ yN v := le_max_right _ _
lemma yV_nonneg (v : ℝ × ℝ × ℝ) : 0 ≤ yV v := abs_nonneg _

lemma yP_sub_yN (v : ℝ × ℝ × ℝ) : yP v - yN v = v.2.1 := by
  unfold yP yN
  rcases le_total 0 v.2.1 with h | h
  · rw [max_eq_left h, max_eq_right (by linarith)]; ring
  · rw [max_eq_right h, max_eq_left (by linarith)]; ring

/-- Pointwise: `w(T_{n_t}) = ∑_{i < n_t} y_{i+1}` and `|w(T_{n_t}) - w_t| ≤ ỹ_{n_t}`. -/
lemma CumulativeProcess.decomp {t : ℝ} (ht : 0 ≤ t) :
    ∀ᵐ ω ∂C.renewal.P,
      C.G yP 0 t ω - C.G yN 0 t ω = C.w (C.renewal.epoch (C.renewal.count t ω) ω) ω ∧
      |C.G yP 0 t ω - C.G yN 0 t ω - C.w t ω| ≤ C.ZZ yV t ω := by
  filter_upwards [C.ae_good t] with ω hg
  obtain ⟨h1, h2, h3, hS⟩ := hg
  set n := C.renewal.count t ω with hn
  have hn1 : 1 ≤ n := C.one_le_count ht hS
  have hlow : C.renewal.epoch (n - 1) ω ≤ t := C.epoch_count_pred_le ht hS
  have hup : t < C.renewal.epoch n ω := C.lt_epoch_count hS
  have hsum : C.G yP 0 t ω - C.G yN 0 t ω = C.w (C.renewal.epoch n ω) ω := by
    unfold CumulativeProcess.G
    rw [← Finset.sum_sub_distrib, add_zero]
    have e : ∀ i ∈ Finset.range n, yP (C.V i ω) - yN (C.V i ω) =
        C.w (C.renewal.epoch (i + 1) ω) ω - C.w (C.renewal.epoch i ω) ω := by
      intro i _
      rw [yP_sub_yN]
      simp [CumulativeProcess.V, cycleReward]
    rw [Finset.sum_congr rfl e, Finset.sum_range_sub (fun i => C.w (C.renewal.epoch i ω) ω),
      C.epoch_zero, h2, sub_zero]
  refine ⟨hsum, ?_⟩
  rw [hsum]
  have hZ : C.ZZ yV t ω = cycleVariation C.renewal C.w n ω := by
    unfold CumulativeProcess.ZZ yV CumulativeProcess.V
    simp only
    rw [Nat.sub_add_cancel hn1]
    exact abs_of_nonneg ENNReal.toReal_nonneg
  rw [hZ]
  have hbv := C.eVar_cycle_ne_top h1 h3 (n - 1)
  rw [Nat.sub_add_cancel hn1] at hbv
  unfold cycleVariation
  exact abs_sub_le_eVar hbv ⟨(hlow.trans hup.le), le_rfl⟩ ⟨hlow, hup.le⟩

/-! ### Theorem 8 (ii) -/

lemma var_sub_close {Ω' : Type*} [MeasurableSpace Ω'] {μ : Measure Ω'} [IsProbabilityMeasure μ]
    {X Q : Ω' → ℝ} (hX : MemLp X 2 μ) (hQ : MemLp Q 2 μ) {ε : ℝ} (hε : 0 < ε) :
    |variance (X - Q) μ - variance X μ| ≤ ε * variance X μ + (1 / ε + 1) * variance Q μ := by
  have h1 := variance_nonneg (ε • X - Q) μ
  have h2 := variance_nonneg (ε • X + Q) μ
  rw [variance_sub (hX.const_smul ε) hQ, variance_smul, covariance_smul_left] at h1
  rw [variance_add (hX.const_smul ε) hQ, variance_smul, covariance_smul_left] at h2
  rw [variance_sub hX hQ]
  have hq : 0 ≤ variance Q μ := variance_nonneg _ _
  set v := variance X μ
  set q := variance Q μ
  set c := cov[X, Q; μ]
  have e : (ε * v + q / ε) * ε = ε ^ 2 * v + q := by field_simp
  have k1 : 2 * c ≤ ε * v + q / ε := by
    have : 2 * c * ε ≤ (ε * v + q / ε) * ε := by rw [e]; nlinarith
    exact le_of_mul_le_mul_right this hε
  have k2 : -(2 * c) ≤ ε * v + q / ε := by
    have : -(2 * c) * ε ≤ (ε * v + q / ε) * ε := by rw [e]; nlinarith
    exact le_of_mul_le_mul_right this hε
  have e2 : (1 / ε + 1) * q = q / ε + q := by ring
  rw [e2, abs_le]
  constructor <;> linarith

lemma littleO_combine {a b c : ℝ → ℝ} {K : ℝ}
    (ha : (fun t => a t - K * t) =o[atTop] (fun t : ℝ => t))
    (hb : b =o[atTop] (fun t : ℝ => t)) (hb0 : ∀ᶠ t in atTop, 0 ≤ b t)
    (ha0 : ∀ᶠ t in atTop, 0 ≤ a t)
    (hc : ∀ ε > 0, ∀ᶠ t in atTop, |c t - a t| ≤ ε * a t + (1 / ε + 1) * b t) :
    (fun t => c t - K * t) =o[atTop] (fun t : ℝ => t) := by
  rw [Asymptotics.isLittleO_iff] at ha hb ⊢
  intro δ hδ
  set ε := δ / (4 * (|K| + 1)) with hεdef
  have hε : 0 < ε := by positivity
  have hp : 0 < 1 / ε + 1 := by positivity
  filter_upwards [ha (by positivity : (0:ℝ) < δ / 4), ha one_pos,
    hb (by positivity : (0:ℝ) < δ / 4 / (1 / ε + 1)), hb0, ha0, hc ε hε,
    eventually_gt_atTop 0] with t h1 h2 h3 h4 h5 h6 ht
  simp only [Real.norm_eq_abs, abs_of_pos ht] at h1 h2 h3 ⊢
  have hK : K * t ≤ |K| * t := mul_le_mul_of_nonneg_right (le_abs_self K) ht.le
  have hat : a t ≤ (|K| + 1) * t := by
    have := (abs_le.1 h2).2; nlinarith
  have e1 : ε * a t ≤ δ / 4 * t := by
    calc ε * a t ≤ ε * ((|K| + 1) * t) := by gcongr
      _ = δ / 4 * t := by rw [hεdef]; field_simp
  have e2 : (1 / ε + 1) * b t ≤ δ / 4 * t := by
    have := (abs_le.1 h3).2
    calc (1 / ε + 1) * b t ≤ (1 / ε + 1) * (δ / 4 / (1 / ε + 1) * t) := by gcongr
      _ = δ / 4 * t := by field_simp
  have := abs_le.1 h6
  have := abs_le.1 h1
  rw [abs_le]
  constructor <;> nlinarith

noncomputable def yV2 (v : ℝ × ℝ × ℝ) : ℝ := v.2.2 ^ 2
lemma measurable_yV2 : Measurable yV2 := by unfold yV2; fun_prop
lemma yV2_nonneg (v : ℝ × ℝ × ℝ) : 0 ≤ yV2 v := sq_nonneg _

lemma CumulativeProcess.G_succ (g : ℝ × ℝ × ℝ → ℝ) (t : ℝ) (ω : Ω) :
    C.G g 1 t ω = C.G g 0 t ω + g (C.V (C.renewal.count t ω) ω) := by
  unfold CumulativeProcess.G
  rw [add_zero]
  exact Finset.sum_range_succ _ _

/-! ### Lemma 5: Wald's second identity and the variance of `Y_t` -/

lemma CumulativeProcess.sigS_mono {S T : Finset ℕ} (h : S ⊆ T) : C.sigS S ≤ C.sigS T := by
  unfold CumulativeProcess.sigS
  exact iSup₂_le fun l hl => le_iSup₂
    (f := fun l (_ : l ∈ (T : Set ℕ)) => MeasurableSpace.comap (C.V l) inferInstance) l
    (Finset.mem_coe.2 (h (Finset.mem_coe.1 hl)))

lemma CumulativeProcess.indepFun_V_meas {β γ : Type*} [MeasurableSpace β] [MeasurableSpace γ]
    (f : ℝ × ℝ × ℝ → β) (hf : Measurable f) {k i : ℕ} (hki : k ≤ i) {g : Ω → γ}
    (hg : Measurable[C.sigS (Finset.range k)] g) :
    IndepFun (fun ω => f (C.V i ω)) g C.renewal.P := by
  have hind := indep_iSup_of_disjoint (μ := C.renewal.P)
    (m := fun l => MeasurableSpace.comap (C.V l) inferInstance)
    (fun l => (C.measurable_V l).comap_le) ((iIndepFun_iff_iIndep _ _ _).1 C.iIndep_V)
    (S := ((Finset.range k : Finset ℕ) : Set ℕ)) (T := (({i} : Finset ℕ) : Set ℕ))
    (by
      rw [Finset.disjoint_coe]
      simp only [Finset.disjoint_singleton_right, Finset.mem_range]
      omega)
  rw [IndepFun_iff_Indep]
  refine indep_of_indep_of_le_left (indep_of_indep_of_le_right hind.symm ?_) ?_
  · rw [← measurable_iff_comap_le]
    exact hg
  · rw [← measurable_iff_comap_le]
    exact hf.comp (C.measurable_V_sigS {i} (Finset.mem_singleton_self i))

lemma CumulativeProcess.integrable_V_comp (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g)
    (h0 : Integrable (fun ω => g (C.V 0 ω)) C.renewal.P) (i : ℕ) :
    Integrable (fun ω => g (C.V i ω)) C.renewal.P := by
  refine ⟨(hg.comp (C.measurable_V i)).aestronglyMeasurable, ?_⟩
  unfold HasFiniteIntegral
  rw [C.lintegral_V_eq (fun v => ‖g v‖ₑ) (by fun_prop) i]
  exact h0.hasFiniteIntegral

lemma CumulativeProcess.integral_V_eq (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (i : ℕ) :
    ∫ ω, g (C.V i ω) ∂C.renewal.P = ∫ ω, g (C.V 0 ω) ∂C.renewal.P := by
  rw [← integral_map (C.measurable_V i).aemeasurable hg.aestronglyMeasurable, C.map_V i,
    integral_map (C.measurable_V 0).aemeasurable hg.aestronglyMeasurable]

/-- real indicator of `{n_t ≥ i}` -/
noncomputable def CumulativeProcess.Ind (t : ℝ) (i : ℕ) (ω : Ω) : ℝ :=
  (C.A t i).indicator (fun _ => (1 : ℝ)) ω

lemma CumulativeProcess.measurable_Ind_sigS (t : ℝ) {i k : ℕ} (h : i ≤ k) :
    Measurable[C.sigS (Finset.range k)] (C.Ind t i) := by
  unfold CumulativeProcess.Ind
  exact measurable_const.indicator
    (C.sigS_mono (Finset.range_mono (by omega : i - 1 ≤ k)) _ (C.measurableSet_A_sigS t i))

lemma CumulativeProcess.measurable_Ind (t : ℝ) (i : ℕ) : Measurable (C.Ind t i) :=
  measurable_const.indicator (C.measurableSet_A t i)

lemma CumulativeProcess.Ind_sq (t : ℝ) (i : ℕ) (ω : Ω) : C.Ind t i ω ^ 2 = C.Ind t i ω := by
  unfold CumulativeProcess.Ind
  by_cases h : ω ∈ C.A t i
  · simp [Set.indicator_of_mem h]
  · simp [Set.indicator_of_notMem h]

lemma CumulativeProcess.Ind_nonneg (t : ℝ) (i : ℕ) (ω : Ω) : 0 ≤ C.Ind t i ω := by
  unfold CumulativeProcess.Ind
  exact Set.indicator_nonneg (fun _ _ => zero_le_one) ω

lemma CumulativeProcess.Ind_le_one (t : ℝ) (i : ℕ) (ω : Ω) : C.Ind t i ω ≤ 1 := by
  unfold CumulativeProcess.Ind
  exact Set.indicator_apply_le' (fun _ => le_rfl) (fun _ => zero_le_one)

/-- window sums `∑_{n ≤ i < n+k} g(V_i) 1{n_t ≥ i}` -/
noncomputable def CumulativeProcess.Wd (g : ℝ × ℝ × ℝ → ℝ) (t : ℝ) (n k : ℕ) (ω : Ω) : ℝ :=
  ∑ i ∈ Finset.Ico n (n + k), g (C.V i ω) * C.Ind t i ω

lemma CumulativeProcess.measurable_Wd_sigS (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (t : ℝ)
    (n k : ℕ) : Measurable[C.sigS (Finset.range (n + k))] (C.Wd g t n k) := by
  unfold CumulativeProcess.Wd
  refine Finset.measurable_sum _ fun i hi => ?_
  have hi' := Finset.mem_Ico.1 hi
  exact (hg.comp (C.measurable_V_sigS _ (Finset.mem_range.2 hi'.2))).mul
    (C.measurable_Ind_sigS t (by omega))

lemma CumulativeProcess.measurable_Wd (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (t : ℝ)
    (n k : ℕ) : Measurable (C.Wd g t n k) :=
  (C.measurable_Wd_sigS g hg t n k).mono (C.sigS_le _) le_rfl

/-- Wald's second identity on a window. -/
lemma CumulativeProcess.window_identity (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g)
    (h2 : Integrable (fun ω => g (C.V 0 ω) ^ 2) C.renewal.P)
    (h0 : ∫ ω, g (C.V 0 ω) ∂C.renewal.P = 0) (t : ℝ) (n : ℕ) :
    ∀ k : ℕ, MemLp (C.Wd g t n k) 2 C.renewal.P ∧
      ∫ ω, C.Wd g t n k ω ^ 2 ∂C.renewal.P =
        (∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P) *
          ∑ i ∈ Finset.Ico n (n + k), C.renewal.P.real (C.A t i) := by
  have hprob := C.renewal.probability
  have hgm : ∀ i, MemLp (fun ω => g (C.V i ω)) 2 C.renewal.P := fun i =>
    (memLp_two_iff_integrable_sq (hg.comp (C.measurable_V i)).aestronglyMeasurable).2
      (C.integrable_V_comp (fun v => g v ^ 2) (hg.pow_const 2) h2 i)
  intro k
  induction k with
  | zero =>
    have : C.Wd g t n 0 = 0 := by funext ω; simp [CumulativeProcess.Wd]
    rw [this]
    simp
  | succ k ih =>
    obtain ⟨hX, hXint⟩ := ih
    set m := n + k with hm
    have hsplit : C.Wd g t n (k + 1) = fun ω => C.Wd g t n k ω + g (C.V m ω) * C.Ind t m ω := by
      funext ω
      unfold CumulativeProcess.Wd
      rw [show n + (k + 1) = m + 1 by omega, Finset.sum_Ico_succ_top (by omega : n ≤ m)]
    have hU : MemLp (fun ω => g (C.V m ω) * C.Ind t m ω) 2 C.renewal.P := by
      refine (hgm m).of_le ((hg.comp (C.measurable_V m)).mul
        (C.measurable_Ind t m)).aestronglyMeasurable (Eventually.of_forall fun ω => ?_)
      simp only [Real.norm_eq_abs, abs_mul]
      have h1 := C.Ind_nonneg t m ω
      have h2 := C.Ind_le_one t m ω
      rw [abs_of_nonneg h1]
      nlinarith [abs_nonneg (g (C.V m ω))]
    refine ⟨by rw [hsplit]; exact hX.add hU, ?_⟩
    rw [hsplit]
    have hX2 := (memLp_two_iff_integrable_sq hX.aestronglyMeasurable).1 hX
    have hU2 := (memLp_two_iff_integrable_sq hU.aestronglyMeasurable).1 hU
    have hXU : Integrable (fun ω => C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω))
        C.renewal.P := by
      refine (hX2.add hU2).mono' (hX.aestronglyMeasurable.mul hU.aestronglyMeasurable)
        (Eventually.of_forall fun ω => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      simp only [Pi.add_apply]
      nlinarith [sq_nonneg (|C.Wd g t n k ω| - |g (C.V m ω) * C.Ind t m ω|),
        sq_abs (C.Wd g t n k ω), sq_abs (g (C.V m ω) * C.Ind t m ω),
        abs_nonneg (C.Wd g t n k ω), abs_nonneg (g (C.V m ω) * C.Ind t m ω)]
    have e1 : (fun ω => (C.Wd g t n k ω + g (C.V m ω) * C.Ind t m ω) ^ 2) =
        fun ω => C.Wd g t n k ω ^ 2 + (2 * (C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω)) +
          (g (C.V m ω) * C.Ind t m ω) ^ 2) := by
      funext ω; ring
    have hXU2 : Integrable (fun ω => 2 * (C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω)))
        C.renewal.P := hXU.const_mul 2
    have hR : Integrable (fun ω => 2 * (C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω)) +
        (g (C.V m ω) * C.Ind t m ω) ^ 2) C.renewal.P := hXU2.add hU2
    rw [e1, integral_add hX2 hR, integral_add hXU2 hU2, integral_const_mul]
    -- cross term vanishes
    have hcross : ∫ ω, C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω) ∂C.renewal.P = 0 := by
      have e : (fun ω => C.Wd g t n k ω * (g (C.V m ω) * C.Ind t m ω)) =
          fun ω => g (C.V m ω) * (C.Wd g t n k ω * C.Ind t m ω) := by
        funext ω; ring
      have hmeas : Measurable[C.sigS (Finset.range m)]
          (fun ω => C.Wd g t n k ω * C.Ind t m ω) :=
        (C.measurable_Wd_sigS g hg t n k).mul (C.measurable_Ind_sigS t le_rfl)
      rw [e, IndepFun.integral_fun_mul_eq_mul_integral
        (C.indepFun_V_meas g hg le_rfl hmeas)
        (hg.comp (C.measurable_V m)).aestronglyMeasurable
        (hmeas.mono (C.sigS_le _) le_rfl).aestronglyMeasurable]
      rw [C.integral_V_eq g hg m, h0, zero_mul]
    -- square term
    have hsq : ∫ ω, (g (C.V m ω) * C.Ind t m ω) ^ 2 ∂C.renewal.P =
        (∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P) * C.renewal.P.real (C.A t m) := by
      have e : (fun ω => (g (C.V m ω) * C.Ind t m ω) ^ 2) =
          fun ω => g (C.V m ω) ^ 2 * C.Ind t m ω := by
        funext ω; rw [mul_pow, C.Ind_sq]
      rw [e, IndepFun.integral_fun_mul_eq_mul_integral
        (C.indepFun_V_meas (fun v => g v ^ 2) (hg.pow_const 2) le_rfl
          (C.measurable_Ind_sigS t le_rfl))
        ((hg.pow_const 2).comp (C.measurable_V m)).aestronglyMeasurable
        (C.measurable_Ind t m).aestronglyMeasurable]
      rw [C.integral_V_eq (fun v => g v ^ 2) (hg.pow_const 2) m]
      congr 1
      unfold CumulativeProcess.Ind
      exact integral_indicator_one (C.measurableSet_A t m)
    rw [hcross, hsq, hXint, show n + (k + 1) = m + 1 by omega,
      Finset.sum_Ico_succ_top (by omega : n ≤ m)]
    ring

lemma max_sub_max_neg (a : ℝ) : max a 0 - max (-a) 0 = a := by
  rcases le_total 0 a with h | h
  · rw [max_eq_left h, max_eq_right (by linarith)]; ring
  · rw [max_eq_right h, max_eq_left (by linarith)]; ring

lemma CumulativeProcess.G_pos_neg (g : ℝ × ℝ × ℝ → ℝ) (m : ℕ) (t : ℝ) (ω : Ω) :
    C.G g m t ω = C.G (fun v => max (g v) 0) m t ω - C.G (fun v => max (-g v) 0) m t ω := by
  unfold CumulativeProcess.G
  rw [← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun i _ => (max_sub_max_neg _).symm

lemma CumulativeProcess.aemeasurable_G' (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g) (m : ℕ) (t : ℝ) :
    AEMeasurable (C.G g m t) C.renewal.P := by
  have e : C.G g m t = fun ω =>
      C.G (fun v => max (g v) 0) m t ω - C.G (fun v => max (-g v) 0) m t ω := by
    funext ω; exact C.G_pos_neg g m t ω
  rw [e]
  exact (C.aemeasurable_G _ (hg.max measurable_const) (fun v => le_max_right _ _) m t).sub
    (C.aemeasurable_G _ (hg.neg.max measurable_const) (fun v => le_max_right _ _) m t)

lemma CumulativeProcess.Wd_zero_eq_G (g : ℝ × ℝ × ℝ → ℝ) {t : ℝ} {ω : Ω}
    (hS : ∃ n, t < C.renewal.epoch n ω) {m : ℕ} (hm : C.renewal.count t ω + 1 ≤ m) :
    C.Wd g t 0 m ω = C.G g 1 t ω := by
  unfold CumulativeProcess.Wd CumulativeProcess.G
  rw [zero_add, ← Finset.range_eq_Ico, ← Finset.sum_range_add_sum_Ico _ hm]
  have h1 : ∑ i ∈ Finset.Ico (C.renewal.count t ω + 1) m, g (C.V i ω) * C.Ind t i ω = 0 := by
    refine Finset.sum_eq_zero fun i hi => ?_
    have hi' := (Finset.mem_Ico.1 hi).1
    have : ω ∉ C.A t i := by
      rw [← C.le_count_iff hS]; omega
    simp [CumulativeProcess.Ind, Set.indicator_of_notMem this]
  rw [h1, add_zero]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hi' := Finset.mem_range.1 hi
  have : ω ∈ C.A t i := by
    rw [← C.le_count_iff hS]; omega
  simp [CumulativeProcess.Ind, Set.indicator_of_mem this]

lemma CumulativeProcess.Wd_split (g : ℝ × ℝ × ℝ → ℝ) (t : ℝ) (n k : ℕ) (ω : Ω) :
    C.Wd g t n k ω = C.Wd g t 0 (n + k) ω - C.Wd g t 0 n ω := by
  unfold CumulativeProcess.Wd
  simp only [zero_add]
  rw [← Finset.sum_Ico_consecutive _ (Nat.zero_le n) (Nat.le_add_right n k)]
  ring

/-- `p_i = P(n_t ≥ i)` -/
lemma CumulativeProcess.summable_pA {t : ℝ} (ht : 0 ≤ t) :
    Summable (fun i => C.renewal.P.real (C.A t i)) ∧
      ∑' i, C.renewal.P.real (C.A t i) = C.H t + 1 := by
  have hprob := C.renewal.probability
  have e := C.tsum_measure_A t 1
  simp only [Nat.add_sub_cancel] at e
  have hne : ∑' i, C.renewal.P (C.A t i) ≠ ⊤ := by
    rw [e]
    have h : (fun ω => ((C.renewal.count t ω + 1 : ℕ) : ENNReal)) =
        fun ω => (C.renewal.count t ω : ENNReal) + (1 : ENNReal) := by
      funext ω; push_cast; rfl
    rw [h, lintegral_add_right _ measurable_const, lintegral_const, measure_univ, mul_one]
    exact ENNReal.add_ne_top.2 ⟨C.nt_ne_top' ht, by simp⟩
  refine ⟨ENNReal.summable_toReal hne, ?_⟩
  simp only [Measure.real]
  rw [← ENNReal.tsum_toReal_eq (fun i => measure_ne_top _ _), e, C.lintegral_count_add 1 ht]
  simp

lemma CumulativeProcess.lintegral_tail_le (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g)
    (h2 : Integrable (fun ω => g (C.V 0 ω) ^ 2) C.renewal.P)
    (h0 : ∫ ω, g (C.V 0 ω) ∂C.renewal.P = 0) {t : ℝ} (ht : 0 ≤ t) (n : ℕ) :
    ∫⁻ ω, ENNReal.ofReal ((C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) ∂C.renewal.P ≤
      ENNReal.ofReal ((∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P) *
        ∑' i, C.renewal.P.real (C.A t (i + n))) := by
  have hsum := (C.summable_pA ht).1
  have hE0 : 0 ≤ ∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P := integral_nonneg fun ω => sq_nonneg _
  have hmeas : ∀ k, Measurable (fun ω => ENNReal.ofReal (C.Wd g t n k ω ^ 2)) := fun k =>
    ENNReal.measurable_ofReal.comp ((C.measurable_Wd g hg t n k).pow_const 2)
  have hfat := lintegral_liminf_le (μ := C.renewal.P) (u := atTop)
    (f := fun k ω => ENNReal.ofReal (C.Wd g t n k ω ^ 2)) hmeas
  have hlim : ∀ᵐ ω ∂C.renewal.P,
      liminf (fun k => ENNReal.ofReal (C.Wd g t n k ω ^ 2)) atTop =
        ENNReal.ofReal ((C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) := by
    filter_upwards [C.ae_exists_epoch_gt t] with ω hS
    refine Tendsto.liminf_eq (tendsto_const_nhds.congr' ?_)
    filter_upwards [eventually_ge_atTop (C.renewal.count t ω + 1)] with k hk
    rw [C.Wd_split g t n k ω, C.Wd_zero_eq_G g hS (by omega : C.renewal.count t ω + 1 ≤ n + k)]
  calc ∫⁻ ω, ENNReal.ofReal ((C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) ∂C.renewal.P
      = ∫⁻ ω, liminf (fun k => ENNReal.ofReal (C.Wd g t n k ω ^ 2)) atTop ∂C.renewal.P :=
        lintegral_congr_ae (hlim.mono fun ω h => h.symm)
    _ ≤ liminf (fun k => ∫⁻ ω, ENNReal.ofReal (C.Wd g t n k ω ^ 2) ∂C.renewal.P) atTop := hfat
    _ ≤ _ := by
        refine liminf_le_of_frequently_le' (Frequently.of_forall fun k => ?_)
        obtain ⟨hX, hXint⟩ := C.window_identity g hg h2 h0 t n k
        have hX2 := (memLp_two_iff_integrable_sq hX.aestronglyMeasurable).1 hX
        rw [← ofReal_integral_eq_lintegral_ofReal hX2
          (Eventually.of_forall fun ω => sq_nonneg _), hXint]
        have hs' : Summable (fun i => C.renewal.P.real (C.A t (i + n))) :=
          (summable_nat_add_iff (f := fun i => C.renewal.P.real (C.A t i)) n).2 hsum
        have hle : ∑ i ∈ Finset.Ico n (n + k), C.renewal.P.real (C.A t i) ≤
            ∑' i, C.renewal.P.real (C.A t (i + n)) := by
          rw [Finset.sum_Ico_eq_sum_range, Nat.add_sub_cancel_left]
          have e : ∀ i ∈ Finset.range k, C.renewal.P.real (C.A t (n + i)) =
              C.renewal.P.real (C.A t (i + n)) := fun i _ => by rw [add_comm]
          rw [Finset.sum_congr rfl e]
          exact hs'.sum_le_tsum (Finset.range k) (fun i _ => ENNReal.toReal_nonneg)
        exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hle hE0)

/-- Wald's second identity: `E (∑_{i ≤ n_t} g(V_i))² = E g(V₀)² · E(n_t + 1)`. -/
theorem CumulativeProcess.wald_two (g : ℝ × ℝ × ℝ → ℝ) (hg : Measurable g)
    (h2 : Integrable (fun ω => g (C.V 0 ω) ^ 2) C.renewal.P)
    (h0 : ∫ ω, g (C.V 0 ω) ∂C.renewal.P = 0) {t : ℝ} (ht : 0 ≤ t) :
    MemLp (C.G g 1 t) 2 C.renewal.P ∧
      ∫ ω, C.G g 1 t ω ^ 2 ∂C.renewal.P =
        (∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P) * (C.H t + 1) := by
  have hprob := C.renewal.probability
  obtain ⟨hsum, htsum⟩ := C.summable_pA ht
  set E2 := ∫ ω, g (C.V 0 ω) ^ 2 ∂C.renewal.P with hE2
  have hE0 : 0 ≤ E2 := integral_nonneg fun ω => sq_nonneg _
  have hGm := (C.aemeasurable_G' g hg 1 t).aestronglyMeasurable
  -- square integrability
  have hG2 : Integrable (fun ω => C.G g 1 t ω ^ 2) C.renewal.P := by
    refine ⟨hGm.pow 2, ?_⟩
    rw [hasFiniteIntegral_iff_ofReal (Eventually.of_forall fun ω => sq_nonneg _)]
    have hb := C.lintegral_tail_le g hg h2 h0 ht 0
    have hW : ∀ ω, C.Wd g t 0 0 ω = 0 := fun ω => by simp [CumulativeProcess.Wd]
    simp only [hW, sub_zero] at hb
    exact lt_of_le_of_lt hb ENNReal.ofReal_lt_top
  have hGL : MemLp (C.G g 1 t) 2 C.renewal.P := (memLp_two_iff_integrable_sq hGm).2 hG2
  refine ⟨hGL, ?_⟩
  set X := ∫ ω, C.G g 1 t ω ^ 2 ∂C.renewal.P
  set L := E2 * (C.H t + 1)
  have hL0 : 0 ≤ L := mul_nonneg hE0 (by linarith [C.H_nonneg t])
  -- the sequences
  set u : ℕ → ℝ := fun n => ∫ ω, C.Wd g t 0 n ω ^ 2 ∂C.renewal.P with hu
  set e : ℕ → ℝ := fun n => ∫ ω, (C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2 ∂C.renewal.P with he
  have hWm : ∀ n, MemLp (C.Wd g t 0 n) 2 C.renewal.P := fun n =>
    (C.window_identity g hg h2 h0 t 0 n).1
  have hD2 : ∀ n, Integrable (fun ω => (C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) C.renewal.P :=
    fun n => (memLp_two_iff_integrable_sq (hGm.sub (hWm n).aestronglyMeasurable)).1
      (hGL.sub (hWm n))
  have hW2 : ∀ n, Integrable (fun ω => C.Wd g t 0 n ω ^ 2) C.renewal.P := fun n =>
    (memLp_two_iff_integrable_sq (hWm n).aestronglyMeasurable).1 (hWm n)
  have hu_lim : Tendsto u atTop (𝓝 L) := by
    have h := (hsum.hasSum.tendsto_sum_nat).const_mul E2
    rw [htsum] at h
    refine h.congr' (Eventually.of_forall fun n => ?_)
    simp only [hu]
    rw [(C.window_identity g hg h2 h0 t 0 n).2, zero_add, ← Finset.range_eq_Ico]
  have he_le : ∀ n, e n ≤ E2 * ∑' i, C.renewal.P.real (C.A t (i + n)) := by
    intro n
    simp only [he]
    rw [integral_eq_lintegral_of_nonneg_ae (Eventually.of_forall fun ω => sq_nonneg _)
      (hD2 n).aestronglyMeasurable]
    exact ENNReal.toReal_le_of_le_ofReal
      (mul_nonneg hE0 (tsum_nonneg fun i => ENNReal.toReal_nonneg))
      (C.lintegral_tail_le g hg h2 h0 ht n)
  have he_lim : Tendsto e atTop (𝓝 0) := by
    have h := (tendsto_sum_nat_add (fun i => C.renewal.P.real (C.A t i))).const_mul E2
    rw [mul_zero] at h
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h
      (fun n => integral_nonneg fun ω => sq_nonneg _) he_le
  -- comparison for each ε
  have hcmp : ∀ ε > 0, |X - L| ≤ ε * L := by
    intro ε hε
    have hn : ∀ n, |X - u n| ≤ ε * u n + (1 / ε + 1) * e n := by
      intro n
      have hpt : ∀ ω, |C.G g 1 t ω ^ 2 - C.Wd g t 0 n ω ^ 2| ≤
          ε * C.Wd g t 0 n ω ^ 2 + (1 / ε + 1) * (C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2 := by
        intro ω
        set a := C.Wd g t 0 n ω
        set b := C.G g 1 t ω - C.Wd g t 0 n ω
        have hG : C.G g 1 t ω = a + b := by simp [a, b]
        rw [hG]
        have k : |2 * a * b| ≤ ε * a ^ 2 + b ^ 2 / ε := by
          have hq1 : 0 ≤ (ε * a - b) ^ 2 / ε := by positivity
          have hq2 : 0 ≤ (ε * a + b) ^ 2 / ε := by positivity
          have e1 : (ε * a - b) ^ 2 / ε = ε * a ^ 2 - 2 * a * b + b ^ 2 / ε := by
            field_simp; ring
          have e2 : (ε * a + b) ^ 2 / ε = ε * a ^ 2 + 2 * a * b + b ^ 2 / ε := by
            field_simp; ring
          rw [abs_le]; constructor <;> linarith
        have e2 : (a + b) ^ 2 - a ^ 2 = 2 * a * b + b ^ 2 := by ring
        rw [e2]
        have e3 : (1 / ε + 1) * b ^ 2 = b ^ 2 / ε + b ^ 2 := by ring
        rw [e3]
        calc |2 * a * b + b ^ 2| ≤ |2 * a * b| + |b ^ 2| := abs_add_le _ _
          _ = |2 * a * b| + b ^ 2 := by rw [abs_of_nonneg (sq_nonneg b)]
          _ ≤ _ := by linarith
      have hint : Integrable (fun ω => ε * C.Wd g t 0 n ω ^ 2 +
          (1 / ε + 1) * (C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) C.renewal.P :=
        ((hW2 n).const_mul ε).add ((hD2 n).const_mul _)
      have hdiff : X - u n = ∫ ω, (C.G g 1 t ω ^ 2 - C.Wd g t 0 n ω ^ 2) ∂C.renewal.P :=
        (integral_sub hG2 (hW2 n)).symm
      have hrhs : ε * u n + (1 / ε + 1) * e n = ∫ ω, (ε * C.Wd g t 0 n ω ^ 2 +
          (1 / ε + 1) * (C.G g 1 t ω - C.Wd g t 0 n ω) ^ 2) ∂C.renewal.P := by
        rw [integral_add ((hW2 n).const_mul ε) ((hD2 n).const_mul _), integral_const_mul,
          integral_const_mul]
      rw [hdiff, hrhs]
      refine (abs_integral_le_integral_abs).trans (integral_mono (hG2.sub (hW2 n)).abs hint hpt)
    have hlim : Tendsto (fun n => ε * u n + (1 / ε + 1) * e n - |X - u n|) atTop
        (𝓝 (ε * L + (1 / ε + 1) * 0 - |X - L|)) :=
      ((hu_lim.const_mul ε).add (he_lim.const_mul _)).sub
        ((continuous_abs.tendsto _).comp (tendsto_const_nhds.sub hu_lim))
    have := ge_of_tendsto hlim (Eventually.of_forall fun n => sub_nonneg.2 (hn n))
    linarith
  -- conclude
  by_contra hne
  have hd : 0 < |X - L| := abs_pos.2 (sub_ne_zero.2 hne)
  have h := hcmp (|X - L| / (2 * (L + 1))) (by positivity)
  have : |X - L| / (2 * (L + 1)) * L < |X - L| := by
    rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
    nlinarith
  linarith

noncomputable def tF2 (v : ℝ × ℝ × ℝ) : ℝ := v.1 ^ 2
lemma measurable_tF2 : Measurable tF2 := by unfold tF2; fun_prop
lemma tF2_nonneg (v : ℝ × ℝ × ℝ) : 0 ≤ tF2 v := sq_nonneg _

/-- `D_t = T_{n_t+1} - t` -/
noncomputable def CumulativeProcess.Dt (t : ℝ) (ω : Ω) : ℝ :=
  C.renewal.epoch (C.renewal.count t ω + 1) ω - t

lemma CumulativeProcess.Dt_bound {t : ℝ} (ht : 0 ≤ t) :
    ∀ᵐ ω ∂C.renewal.P, C.Dt t ω ^ 2 ≤
      2 * tF2 (C.V (C.renewal.count t ω) ω) + 2 * C.ZZ tF2 t ω := by
  filter_upwards [C.ae_nonneg_cycles, C.ae_exists_epoch_gt t] with ω h1 hS
  set n := C.renewal.count t ω with hn
  have hn1 : 1 ≤ n := C.one_le_count ht hS
  have hlow : C.renewal.epoch (n - 1) ω ≤ t := C.epoch_count_pred_le ht hS
  have hup : t < C.renewal.epoch n ω := C.lt_epoch_count hS
  have e1 : C.renewal.epoch (n + 1) ω = C.renewal.epoch n ω + (C.V n ω).1 := C.epoch_succ n ω
  have e2 : C.renewal.epoch n ω = C.renewal.epoch (n - 1) ω + (C.V (n - 1) ω).1 := by
    have := C.epoch_succ (n - 1) ω
    rwa [Nat.sub_add_cancel hn1] at this
  have hx := h1 (n - 1)
  have hy := h1 n
  have hD0 : 0 ≤ C.Dt t ω := by
    unfold CumulativeProcess.Dt; rw [← hn, e1]; linarith
  have hD1 : C.Dt t ω ≤ (C.V (n - 1) ω).1 + (C.V n ω).1 := by
    unfold CumulativeProcess.Dt; rw [← hn, e1, e2]; linarith
  have hZ : C.ZZ tF2 t ω = (C.V (n - 1) ω).1 ^ 2 := rfl
  rw [hZ]
  unfold tF2
  have : C.Dt t ω ^ 2 ≤ ((C.V (n - 1) ω).1 + (C.V n ω).1) ^ 2 :=
    pow_le_pow_left₀ hD0 hD1 2
  nlinarith [sq_nonneg ((C.V (n - 1) ω).1 - (C.V n ω).1)]

theorem lemma_5_core {Ω : Type*} [MeasurableSpace Ω]
    (C : CumulativeProcess Ω)
    (hμ₂ : Integrable (fun ω => C.renewal.cycleLength 1 ω ^ 2) C.renewal.P)
    (hκ₂ : Integrable (fun ω => cycleReward C.renewal C.w 1 ω ^ 2) C.renewal.P) :
    (∀ t : ℝ, 0 ≤ t →
      Integrable (fun ω => C.overshootReward t ω ^ 2) C.renewal.P) ∧
    (fun t : ℝ =>
      ProbabilityTheory.variance (C.overshootReward t) C.renewal.P -
        t / C.meanLength *
          (ProbabilityTheory.variance (cycleReward C.renewal C.w 1) C.renewal.P -
            2 * C.lengthRewardCovariance * (C.meanReward / C.meanLength) +
            ProbabilityTheory.variance (C.renewal.cycleLength 1) C.renewal.P *
              (C.meanReward / C.meanLength) ^ 2))
      =o[atTop] (fun t : ℝ => t) := by
  have hprob := C.renewal.probability
  have hμm : MemLp (C.renewal.cycleLength 1) 2 C.renewal.P :=
    (memLp_two_iff_integrable_sq (C.renewal.measurable_cycle 0).aestronglyMeasurable).2 hμ₂
  have hκm : MemLp (cycleReward C.renewal C.w 1) 2 C.renewal.P :=
    (memLp_two_iff_integrable_sq (C.measurable_reward 0).aestronglyMeasurable).2 hκ₂
  have hμ : Integrable (C.renewal.cycleLength 1) C.renewal.P := hμm.integrable one_le_two
  have hκ : Integrable (cycleReward C.renewal C.w 1) C.renewal.P := hκm.integrable one_le_two
  have hμpos := C.meanLength_pos hμ
  set a := C.meanReward / C.meanLength with ha_def
  set zf : ℝ × ℝ × ℝ → ℝ := fun v => v.2.1 - a * v.1 with hzf
  have hzfm : Measurable zf := by rw [hzf]; fun_prop
  have hz0m : MemLp (fun ω => zf (C.V 0 ω)) 2 C.renewal.P := hκm.sub (hμm.const_mul a)
  have hz0 : Integrable (fun ω => zf (C.V 0 ω)) C.renewal.P := hz0m.integrable one_le_two
  have hz2 : Integrable (fun ω => zf (C.V 0 ω) ^ 2) C.renewal.P :=
    (memLp_two_iff_integrable_sq hz0m.aestronglyMeasurable).1 hz0m
  have h0 : ∫ ω, zf (C.V 0 ω) ∂C.renewal.P = 0 := by
    have e : (fun ω => zf (C.V 0 ω)) =
        fun ω => cycleReward C.renewal C.w 1 ω - a * C.renewal.cycleLength 1 ω := rfl
    rw [e, integral_sub hκ (hμ.const_mul a), integral_const_mul]
    have : C.meanReward = ∫ ω, cycleReward C.renewal C.w 1 ω ∂C.renewal.P := rfl
    have h2 : C.meanLength = ∫ ω, C.renewal.cycleLength 1 ω ∂C.renewal.P := rfl
    rw [← this, ← h2, ha_def]
    field_simp
    ring
  -- the constant
  set Kc := ProbabilityTheory.variance (cycleReward C.renewal C.w 1) C.renewal.P -
      2 * C.lengthRewardCovariance * a +
      ProbabilityTheory.variance (C.renewal.cycleLength 1) C.renewal.P * a ^ 2 with hKc
  have hE2 : ∫ ω, zf (C.V 0 ω) ^ 2 ∂C.renewal.P = Kc := by
    have hv := variance_eq_sub hz0m
    have e : (fun ω => zf (C.V 0 ω)) =
        fun ω => cycleReward C.renewal C.w 1 ω - a * C.renewal.cycleLength 1 ω := rfl
    have hv2 : ProbabilityTheory.variance (fun ω => zf (C.V 0 ω)) C.renewal.P = Kc := by
      rw [e, variance_fun_sub hκm (hμm.const_mul a), covariance_const_mul_right,
        variance_const_mul, covariance_comm, hKc]
      unfold CumulativeProcess.lengthRewardCovariance
      ring
    rw [hv2, h0] at hv
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, sub_zero] at hv
    rw [hv]
    rfl
  -- finiteness facts
  have hfP : ∫⁻ ω, ENNReal.ofReal (max (zf (C.V 0 ω)) 0) ∂C.renewal.P ≠ ⊤ := by
    refine ne_top_of_le_ne_top hz0.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
    rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hfN : ∫⁻ ω, ENNReal.ofReal (max (-zf (C.V 0 ω)) 0) ∂C.renewal.P ≠ ⊤ := by
    refine ne_top_of_le_ne_top hz0.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
    rw [ofReal_max_zero, Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (neg_le_abs _)
  have hfT : ∫⁻ ω, ENNReal.ofReal (tF2 (C.V 0 ω)) ∂C.renewal.P ≠ ⊤ := by
    refine ne_top_of_le_ne_top hμ₂.hasFiniteIntegral.ne (lintegral_mono fun ω => ?_)
    rw [Real.enorm_eq_ofReal_abs]
    exact ENNReal.ofReal_le_ofReal (le_abs_self _)
  have hgp : Measurable fun v => max (zf v) 0 := hzfm.max measurable_const
  have hgn : Measurable fun v => max (-zf v) 0 := hzfm.neg.max measurable_const
  -- the martingale part S_t
  have hS : ∀ {t : ℝ}, 0 ≤ t → MemLp (C.G zf 1 t) 2 C.renewal.P ∧
      ProbabilityTheory.variance (C.G zf 1 t) C.renewal.P = Kc * (C.H t + 1) := by
    intro t ht
    obtain ⟨hm, hsq⟩ := C.wald_two zf hzfm hz2 h0 ht
    refine ⟨hm, ?_⟩
    have hmean : ∫ ω, C.G zf 1 t ω ∂C.renewal.P = 0 := by
      have e : C.G zf 1 t = fun ω =>
          C.G (fun v => max (zf v) 0) 1 t ω - C.G (fun v => max (-zf v) 0) 1 t ω := by
        funext ω; exact C.G_pos_neg zf 1 t ω
      rw [e, integral_sub (C.integrable_G _ hgp (fun v => le_max_right _ _) hfP 1 ht)
        (C.integrable_G _ hgn (fun v => le_max_right _ _) hfN 1 ht),
        C.integral_G _ hgp (fun v => le_max_right _ _) hfP 1 ht,
        C.integral_G _ hgn (fun v => le_max_right _ _) hfN 1 ht]
      have h0' := h0
      rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hz0] at h0'
      simp only [ofReal_max_zero]
      rw [← sub_mul, h0', zero_mul]
    rw [variance_eq_sub hm, hmean]
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, sub_zero]
    rw [← hE2]
    exact hsq
  -- decomposition of Y_t
  have hYeq : ∀ t : ℝ, C.overshootReward t =
      fun ω => (C.G zf 1 t ω - (-(a * C.Dt t ω))) + a * t := by
    intro t; funext ω
    have e1 : C.overshootReward t ω = C.G (fun v => v.2.1) 1 t ω := by
      rw [C.overshootReward_eq, C.G_pos_neg (fun v => v.2.1)]
    have e2 : C.G (fun v => v.2.1) 1 t ω = C.G zf 1 t ω + a * C.G (fun v => v.1) 1 t ω := by
      unfold CumulativeProcess.G
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      simp only [hzf]; ring
    have e3 : C.G (fun v => v.1) 1 t ω = C.renewal.epoch (C.renewal.count t ω + 1) ω := by
      unfold CumulativeProcess.G; rw [C.epoch_eq]
    rw [e1, e2, e3]
    unfold CumulativeProcess.Dt
    ring
  -- the remainder
  have hDm : ∀ t : ℝ, AEStronglyMeasurable (C.Dt t) C.renewal.P := by
    intro t
    have e : C.Dt t = fun ω => C.G (fun v => v.1) 1 t ω - t := by
      funext ω; unfold CumulativeProcess.Dt CumulativeProcess.G; rw [C.epoch_eq]
    rw [e]
    exact ((C.aemeasurable_G' _ measurable_fst 1 t).sub_const t).aestronglyMeasurable
  have hT1 : ∀ {t : ℝ}, 0 ≤ t →
      Integrable (fun ω => tF2 (C.V (C.renewal.count t ω) ω)) C.renewal.P := by
    intro t ht
    have e : (fun ω => tF2 (C.V (C.renewal.count t ω) ω)) =
        fun ω => C.G tF2 1 t ω - C.G tF2 0 t ω := by
      funext ω; rw [C.G_succ]; ring
    rw [e]
    exact (C.integrable_G _ measurable_tF2 tF2_nonneg hfT 1 ht).sub
      (C.integrable_G _ measurable_tF2 tF2_nonneg hfT 0 ht)
  set ET := (∫⁻ ω, ENNReal.ofReal (tF2 (C.V 0 ω)) ∂C.renewal.P).toReal with hET
  have hT1int : ∀ {t : ℝ}, 0 ≤ t →
      ∫ ω, tF2 (C.V (C.renewal.count t ω) ω) ∂C.renewal.P = ET := by
    intro t ht
    have e : (fun ω => tF2 (C.V (C.renewal.count t ω) ω)) =
        fun ω => C.G tF2 1 t ω - C.G tF2 0 t ω := by
      funext ω; rw [C.G_succ]; ring
    rw [e, integral_sub (C.integrable_G _ measurable_tF2 tF2_nonneg hfT 1 ht)
      (C.integrable_G _ measurable_tF2 tF2_nonneg hfT 0 ht),
      C.integral_G _ measurable_tF2 tF2_nonneg hfT 1 ht,
      C.integral_G _ measurable_tF2 tF2_nonneg hfT 0 ht]
    push_cast; ring
  have hZT : ∀ {t : ℝ}, 0 ≤ t → Integrable (C.ZZ tF2 t) C.renewal.P := fun ht =>
    C.integrable_ZZ tF2 measurable_tF2 tF2_nonneg hfT ht
  have hD2 : ∀ {t : ℝ}, 0 ≤ t → Integrable (fun ω => C.Dt t ω ^ 2) C.renewal.P := by
    intro t ht
    refine Integrable.mono' (((hT1 ht).const_mul 2).add ((hZT ht).const_mul 2))
      ((hDm t).pow 2) ?_
    filter_upwards [C.Dt_bound ht] with ω hω
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact hω
  have hDL : ∀ {t : ℝ}, 0 ≤ t → MemLp (C.Dt t) 2 C.renewal.P := fun ht =>
    (memLp_two_iff_integrable_sq (hDm _)).2 (hD2 ht)
  have hQL : ∀ {t : ℝ}, 0 ≤ t → MemLp (fun ω => -(a * C.Dt t ω)) 2 C.renewal.P := fun ht =>
    ((hDL ht).const_mul a).neg
  have hYL : ∀ {t : ℝ}, 0 ≤ t → MemLp (C.overshootReward t) 2 C.renewal.P := by
    intro t ht
    rw [hYeq t]
    exact ((hS ht).1.sub (hQL ht)).add (memLp_const (a * t))
  refine ⟨fun t ht => (memLp_two_iff_integrable_sq (hYL ht).aestronglyMeasurable).1 (hYL ht), ?_⟩
  -- asymptotics
  have hb : (fun t : ℝ => a ^ 2 * ∫ ω, C.Dt t ω ^ 2 ∂C.renewal.P) =o[atTop] (fun t : ℝ => t) := by
    have hz : (fun t : ℝ => ∫ ω, C.ZZ tF2 t ω ∂C.renewal.P) =o[atTop] (fun t : ℝ => t) := by
      rw [Asymptotics.isLittleO_iff_tendsto']
      · exact C.integral_ZZ_div_tendsto tF2 measurable_tF2 tF2_nonneg hfT
      · filter_upwards [eventually_gt_atTop 0] with t ht h
        exact absurd h ht.ne'
    have hsum : (fun t : ℝ => 2 * ET + 2 * ∫ ω, C.ZZ tF2 t ω ∂C.renewal.P) =o[atTop]
        (fun t : ℝ => t) :=
      (Asymptotics.isLittleO_const_id_atTop (2 * ET)).add (hz.const_mul_left 2)
    refine Asymptotics.IsLittleO.const_mul_left ?_ (a ^ 2)
    refine Asymptotics.IsBigO.trans_isLittleO ?_ hsum
    refine Asymptotics.IsBigO.of_bound 1 ?_
    filter_upwards [eventually_ge_atTop 0] with t ht
    have hle : ∫ ω, C.Dt t ω ^ 2 ∂C.renewal.P ≤ 2 * ET + 2 * ∫ ω, C.ZZ tF2 t ω ∂C.renewal.P := by
      rw [← hT1int ht, ← integral_const_mul, ← integral_const_mul,
        ← integral_add ((hT1 ht).const_mul 2) ((hZT ht).const_mul 2)]
      exact integral_mono_ae (hD2 ht) (((hT1 ht).const_mul 2).add ((hZT ht).const_mul 2))
        (C.Dt_bound ht)
    have h0 : 0 ≤ ∫ ω, C.Dt t ω ^ 2 ∂C.renewal.P := integral_nonneg fun ω => sq_nonneg _
    rw [one_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg h0,
      abs_of_nonneg (h0.trans hle)]
    exact hle
  have ha : (fun t : ℝ => (if 0 ≤ t then ProbabilityTheory.variance (C.G zf 1 t) C.renewal.P
      else 0) - Kc / C.meanLength * t) =o[atTop] (fun t : ℝ => t) := by
    rw [Asymptotics.isLittleO_iff_tendsto']
    · have h1 := ((C.H_div_tendsto hμ).sub_const (1 / C.meanLength)).const_mul Kc
      have h2 : Tendsto (fun t : ℝ => Kc / t) atTop (𝓝 0) :=
        tendsto_const_nhds.div_atTop tendsto_id
      have h3 := h1.add h2
      rw [sub_self, mul_zero, zero_add] at h3
      refine h3.congr' ?_
      filter_upwards [eventually_gt_atTop 0] with t ht
      rw [if_pos ht.le, (hS ht.le).2]
      field_simp
      ring
    · filter_upwards [eventually_gt_atTop 0] with t ht h
      exact absurd h ht.ne'
  have key := littleO_combine
    (c := fun t => ProbabilityTheory.variance (C.overshootReward t) C.renewal.P)
    ha hb (Eventually.of_forall fun t => mul_nonneg (sq_nonneg a)
      (integral_nonneg fun ω => sq_nonneg _))
    (Eventually.of_forall fun t => by split_ifs <;> first | exact variance_nonneg _ _ | exact le_rfl)
    (by
      intro ε hε
      filter_upwards [eventually_ge_atTop 0] with t ht
      rw [if_pos ht]
      have h1 := var_sub_close (hS ht).1 (hQL ht) hε
      have hv : ProbabilityTheory.variance (C.overshootReward t) C.renewal.P =
          ProbabilityTheory.variance (C.G zf 1 t - fun ω => -(a * C.Dt t ω)) C.renewal.P := by
        rw [hYeq t]
        exact variance_add_const ((hS ht).1.aestronglyMeasurable.sub
          (hQL ht).aestronglyMeasurable) (a * t)
      rw [hv]
      have h2 : ProbabilityTheory.variance (fun ω => -(a * C.Dt t ω)) C.renewal.P ≤
          a ^ 2 * ∫ ω, C.Dt t ω ^ 2 ∂C.renewal.P := by
        refine (variance_le_expectation_sq (hQL ht).aestronglyMeasurable).trans (le_of_eq ?_)
        rw [← integral_const_mul]
        congr 1; funext ω; simp only [Pi.pow_apply]; ring
      have h3 : 0 ≤ 1 / ε + 1 := by positivity
      exact h1.trans (by gcongr))
  refine key.congr' (Eventually.of_forall fun t => ?_) EventuallyEq.rfl
  simp only [hKc, ha_def]; ring

end SmithRegenerative.Moments

open SmithRegenerative.Moments
open MeasureTheory Filter

theorem solution {Ω : Type*} [MeasurableSpace Ω]
    (C : CumulativeProcess Ω)
    (hμ₂ : Integrable (fun ω => C.renewal.cycleLength 1 ω ^ 2) C.renewal.P)
    (hκ₂ : Integrable (fun ω => cycleReward C.renewal C.w 1 ω ^ 2) C.renewal.P) :
    (∀ t : ℝ, 0 ≤ t →
      Integrable (fun ω => C.overshootReward t ω ^ 2) C.renewal.P) ∧
    (fun t : ℝ =>
      ProbabilityTheory.variance (C.overshootReward t) C.renewal.P -
        t / C.meanLength *
          (ProbabilityTheory.variance (cycleReward C.renewal C.w 1) C.renewal.P -
            2 * C.lengthRewardCovariance * (C.meanReward / C.meanLength) +
            ProbabilityTheory.variance (C.renewal.cycleLength 1) C.renewal.P *
              (C.meanReward / C.meanLength) ^ 2))
      =o[atTop] (fun t : ℝ => t) :=
  lemma_5_core C hμ₂ hκ₂
