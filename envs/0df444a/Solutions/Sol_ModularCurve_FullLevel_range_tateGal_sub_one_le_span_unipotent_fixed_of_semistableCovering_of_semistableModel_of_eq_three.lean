theorem chart_dom_levelAut (𝒞 : SemistableCovering q M' A W) (hEq : 𝒞.EquivClauses) {ζ₀ : Idx q}
    (hd : ∀ (γ : SL(2, ℤ)), γ ∈ CongruenceSubgroup.Gamma0 M' → ∀ ℓ,
      ((𝒞.CIg ℓ).comap (levelAutBar q M' ζ₀ γ⁻¹)).integers = (𝒞.CIg ((redQ q γ)⁻¹ • ℓ)).integers ∧
      ((𝒞.CIg ℓ).comap (levelAutBar q M' ζ₀ γ⁻¹)).dom = (𝒞.CIg ((redQ q γ)⁻¹ • ℓ)).dom ∧
      ∀ s, ((𝒞.An ℓ s).comap (levelAutBar q M' ζ₀ γ⁻¹)).dom = (𝒞.An ((redQ q γ)⁻¹ • ℓ) s).dom)
    (γ : SL(2, ℤ)) (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') :
    ∀ (j : CuspidalType.ProjLine q ⊕ ↥W) (P : Place Qbar ↥(fieldBar q M')),
      P ∈ (𝒞.sumChart j).dom ↔
        SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹) • P ∈
          (𝒞.sumChart ((Equiv.sumCongr (MulAction.toPerm (redQ q γ)) (Equiv.refl ↥W)) j)).dom
  | .inl ℓ, P => by
      obtain ⟨-, hdom, -⟩ := hd γ hγ (redQ q γ • ℓ)
      rw [inv_smul_smul] at hdom
      exact ((Set.ext_iff.mp hdom) P).symm
  | .inr s, P => by
      obtain ⟨-, -, hcss, -⟩ := hEq ζ₀ γ⁻¹ (inv_mem hγ)
      exact ((Set.ext_iff.mp (hcss s).2) P).symm

theorem chart_int_levelAut (𝒞 : SemistableCovering q M' A W) (hEq : 𝒞.EquivClauses) {ζ₀ : Idx q}
