theorem diff_of_C2 {b : ℝ → ℝ} {U : Set ℝ} (hU : IsOpen U) (hb : ContDiffOn ℝ 2 b U) {R : ℝ}
    (hR : R ∈ U) : DifferentiableAt ℝ b R ∧ DifferentiableAt ℝ (deriv b) R := by
  have hd : ContDiffOn ℝ 1 (deriv b) U := hb.deriv_of_isOpen hU (by norm_num)
  exact ⟨(hb.contDiffAt (hU.mem_nhds hR)).differentiableAt (by norm_num),
    (hd.contDiffAt (hU.mem_nhds hR)).differentiableAt (by norm_num)⟩

/-- Differences of horizon-`C¹` functions are horizon-`C¹`. -/
theorem HorizonC1.sub {Rh : ℝ} {b1 b2 : ℝ → ℝ} (h1 : HorizonC1 Rh b1) (h2 : HorizonC1 Rh b2) :
    HorizonC1 Rh (fun s => b1 s - b2 s) := by
  obtain ⟨η1, hη1, bt1, c1, e1⟩ := h1
  obtain ⟨η2, hη2, bt2, c2, e2⟩ := h2
  refine ⟨min η1 η2, lt_min hη1 hη2, fun s => bt1 s - bt2 s, ?_, ?_⟩
  · refine (c1.mono ?_).sub (c2.mono ?_)
    · exact Ioo_subset_Ioo (by linarith [min_le_left η1 η2]) (by linarith [min_le_left η1 η2])
    · exact Ioo_subset_Ioo (by linarith [min_le_right η1 η2]) (by linarith [min_le_right η1 η2])
  · intro s hs
    have hs1 : s ∈ Ioo Rh (Rh + η1) := ⟨hs.1, by linarith [hs.2, min_le_left η1 η2]⟩
    have hs2 : s ∈ Ioo Rh (Rh + η2) := ⟨hs.1, by linarith [hs.2, min_le_right η1 η2]⟩
    simp only [e1 hs1, e2 hs2]

