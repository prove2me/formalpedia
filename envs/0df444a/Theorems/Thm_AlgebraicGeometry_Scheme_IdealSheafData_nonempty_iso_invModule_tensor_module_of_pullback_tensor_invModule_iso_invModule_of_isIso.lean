    {X' X : Scheme.{u}} (π : X' ⟶ X) [IsIso π] (ℒ : X.Modules) (I₁ I₂ : X.IdealSheafData) (J₁ J₂ : X'.IdealSheafData)
    (hJ₁ : I₁.comap π = J₁) (hJ₂ : I₂.comap π = J₂) (hJ₁i : J₁.IsInvertible) (hJ₂i : J₂.IsInvertible)
