      have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg V
      have a1 : (K : ℝ) * (((V : ℝ) + 1) * X) ≤ X * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * (K * (q + 1)) := by
        have : (K : ℝ) * (((V : ℝ) + 1) * X) ≤ (K : ℝ) * (((V : ℝ) + (W : ℝ) ^ (j + 1)) * X) := by
