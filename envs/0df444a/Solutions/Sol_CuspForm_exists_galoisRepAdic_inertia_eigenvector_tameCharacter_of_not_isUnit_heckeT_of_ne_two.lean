    (hA2 : ∀ {q : ℕ} (_hq : q.Prime) (_ : q ≠ 2)
        (H : Type) (_ : CommRing H) (_ : HopfAlgebra (GaloisRep.ratLocalizedAt q) H)
        (_ : Module.Finite (GaloisRep.ratLocalizedAt q) H)
        (_ : Module.Free (GaloisRep.ratLocalizedAt q) H)
        (_ : Coalgebra.IsCocomm (GaloisRep.ratLocalizedAt q) H)
