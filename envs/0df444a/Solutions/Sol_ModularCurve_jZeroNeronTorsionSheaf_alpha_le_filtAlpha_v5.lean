open ModularCurve AlgebraicCurve MazurAdmissible AlgebraicGeometry AlgebraicGeometry.Scheme

namespace HADEngine

local notation "Qbar" => AlgebraicClosure ℚ

private theorem eisensteinNumerator_pos (p : ℕ) [hp : Fact p.Prime] : 0 < eisensteinNumerator p := by
  have hp1 : 0 < p - 1 := Nat.sub_pos_of_lt hp.out.one_lt
  exact Nat.div_pos (Nat.gcd_le_left 12 hp1) (Nat.gcd_pos_of_pos_left 12 hp1)

theorem hqp (p : ℕ) [hp : Fact p.Prime] (q : ℕ) (hq : q.Prime)
    (hqn : q ∣ eisensteinNumerator p) : q ≠ p := by
  have _ := hq
  have h1 : q ∣ p - 1 := hqn.trans (eisensteinNumerator_dvd p)
  have h2 : p - 1 < p := Nat.sub_one_lt hp.out.ne_zero
  have h3 : q ≤ p - 1 := Nat.le_of_dvd (Nat.sub_pos_of_lt hp.out.one_lt) h1
  omega

theorem exists_place_over (q : ℕ) (hq : q.Prime) :
    ∃ Aq : ValuationSubring (AlgebraicClosure ℚ), Aq.LiesOverPrime q := by
  obtain ⟨A, hA, _⟩ := ValuationSubring.exists_isFrobeniusAt_rat q hq
  exact ⟨A, hA⟩

theorem cycloWitness (q : ℕ) [hq : Fact q.Prime] (m : ℕ) :
    ∃ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      ∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ := by
  haveI : NeZero (q ^ m) := ⟨(pow_pos hq.out.pos m).ne'⟩
  refine ⟨fun σ => (modularCyclotomicCharacter.toFun (L := AlgebraicClosure ℚ)
    (q ^ m) σ.toRingEquiv).val, fun σ ζ hζ => ?_⟩
  have hζ0 : ζ ≠ 0 := fun h => by
    rw [h, zero_pow (NeZero.ne (q ^ m))] at hζ
    exact one_ne_zero hζ.symm
  set u : (AlgebraicClosure ℚ)ˣ := Units.mk0 ζ hζ0 with hu
  have huroot : u ∈ rootsOfUnity (q ^ m) (AlgebraicClosure ℚ) := by
    rw [mem_rootsOfUnity]
    exact Units.ext (by push_cast; exact hζ)
  have hspec := modularCyclotomicCharacter.toFun_spec' (L := AlgebraicClosure ℚ)
    σ.toRingEquiv huroot
  have hval : (u : AlgebraicClosure ℚ) = ζ := rfl
  have key : σ.toRingEquiv (u : AlgebraicClosure ℚ) =
      (u : AlgebraicClosure ℚ) ^ (modularCyclotomicCharacter.toFun (L := AlgebraicClosure ℚ)
        (q ^ m) σ.toRingEquiv).val := hspec
  rw [show σ ζ = σ.toRingEquiv (u : AlgebraicClosure ℚ) from by rw [hval]; rfl, key, hval]

theorem mem_of_nsmul_mem_of_sub_nsmul_mem {M : Type*} [AddCommGroup M] {q a : ℕ} (hq : q.Prime)
    (ha : ¬ a ≡ 1 [MOD q]) {B : AddSubgroup M} {x : M} (hqx : q • x ∈ B) (hax : x - a • x ∈ B) :
    x ∈ B := by
  have hnd : ¬ ((q : ℤ) ∣ (1 : ℤ) - (a : ℤ)) := fun h =>
    ha (Nat.modEq_iff_dvd.mpr (by rw [Nat.cast_one]; exact h))
  have hprime : Prime (q : ℤ) := Nat.prime_iff_prime_int.mp hq
  obtain ⟨u, v, huv⟩ := (Prime.coprime_iff_not_dvd hprime).mpr hnd
  have h1 : ((q : ℤ) • x) ∈ B := by
    rw [natCast_zsmul]
    exact hqx
  have h2 : (((1 : ℤ) - (a : ℤ)) • x) ∈ B := by
    rw [sub_smul, one_smul, natCast_zsmul]
    exact hax
  have hx : x = u • ((q : ℤ) • x) + v • (((1 : ℤ) - (a : ℤ)) • x) := by
    rw [← mul_smul, ← mul_smul, ← add_smul, huv, one_smul]
  rw [hx]
  exact B.add_mem (B.zsmul_mem h1 u) (B.zsmul_mem h2 v)

theorem exists_isPrimitiveRoot (q : ℕ) [hq : Fact q.Prime] :
    ∃ ζ : AlgebraicClosure ℚ, IsPrimitiveRoot ζ q := by
  haveI : NeZero q := ⟨hq.out.ne_zero⟩
  exact HasEnoughRootsOfUnity.exists_primitiveRoot (AlgebraicClosure ℚ) q

theorem exists_inertia_exponent_ne_one (q : ℕ) [hq : Fact q.Prime] (hq2 : q ≠ 2)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (hAq : Aq.LiesOverPrime q) :
    ∃ σ ∈ Aq.inertiaSubgroupIn ℚ, ∃ a : ℕ, ¬ a ≡ 1 [MOD q] ∧
      ∀ μ : AlgebraicClosure ℚ, μ ^ q = 1 → σ μ = μ ^ a := by
  obtain ⟨σ, hσ, h⟩ :=
    ValuationSubring.exists_mem_inertiaSubgroupIn_apply_eq_pow Aq hq.out hAq (-1)
  refine ⟨σ, hσ, ((-1 : (ZMod q)ˣ) : ZMod q).val, ?_, h⟩
  intro hmod
  haveI : Fact (2 < q) := ⟨lt_of_le_of_ne hq.out.two_le (Ne.symm hq2)⟩
  haveI : NeZero q := ⟨hq.out.ne_zero⟩
  apply ZMod.neg_one_ne_one (n := q)
  have h1 := (ZMod.natCast_eq_natCast_iff _ _ _).mpr hmod
  rw [ZMod.natCast_zmod_val, Units.val_neg, Units.val_one, Nat.cast_one] at h1
  exact h1

theorem step_kill {M : Type*} [AddCommGroup M] {q : ℕ} (hq : q.Prime)
    {Φ : OpenAction M} (c : AdmissibleChain q Φ) (W : AddSubgroup M)
    {σ₀ : Qbar ≃ₐ[ℚ] Qbar} {a : ℕ} (ha : ¬ a ≡ 1 [MOD q])
    (hζa : ∀ μ : Qbar, μ ^ q = 1 → σ₀ μ = μ ^ a)
    (hdisp : ∀ x : M, Φ.φ σ₀ x - x ∈ W)
    (i : Fin c.n) (htag : c.tag i = false) :
    c.step i.succ ≤ W ⊔ c.step i.castSucc := by
  intro x hx
  have hact' : IsCyclotomicStep q Φ (c.step i.castSucc) (c.step i.succ) := by
    have h := c.hact i
    rw [htag] at h
    simpa using h
  haveI : Fact q.Prime := ⟨hq⟩
  obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot q
  have hσζ : σ₀ ζ = ζ ^ a := hζa ζ hζ.pow_eq_one
  have hcyc : Φ.φ σ₀ x - a • x ∈ c.step i.castSucc := hact' σ₀ ζ hζ a hσζ x hx
  have hd : Φ.φ σ₀ x - x ∈ W := hdisp x
  have hax : x - a • x ∈ W ⊔ c.step i.castSucc := by
    have hrw : x - a • x = (Φ.φ σ₀ x - a • x) - (Φ.φ σ₀ x - x) := by abel
    rw [hrw]
    exact AddSubgroup.sub_mem _ (AddSubgroup.mem_sup_right hcyc) (AddSubgroup.mem_sup_left hd)
  have hqx : q • x ∈ c.step i.castSucc := by
    haveI hfin : Finite (↥(c.step i.succ) ⧸ (c.step i.castSucc).addSubgroupOf (c.step i.succ)) := by
      apply Nat.finite_of_card_ne_zero
      rw [c.hcard i]
      exact hq.ne_zero
    set x' : ↥(c.step i.succ) := ⟨x, hx⟩ with hx'def
    set π := QuotientAddGroup.mk' ((c.step i.castSucc).addSubgroupOf (c.step i.succ)) with hπdef
    have hdvd : addOrderOf (π x') ∣ q := by
      have h := addOrderOf_dvd_natCard (π x')
      rwa [c.hcard i] at h
    have hz : π (q • x') = 0 := by
      rw [map_nsmul]
      exact addOrderOf_dvd_iff_nsmul_eq_zero.mp hdvd
    have hmem : q • x' ∈ (c.step i.castSucc).addSubgroupOf (c.step i.succ) :=
      (QuotientAddGroup.eq_zero_iff (q • x')).mp hz
    have hcoe : ((q • x' : ↥(c.step i.succ)) : M) ∈ c.step i.castSucc :=
      (AddSubgroup.mem_addSubgroupOf).mp hmem
    simpa using hcoe
  exact mem_of_nsmul_mem_of_sub_nsmul_mem hq ha (AddSubgroup.mem_sup_right hqx) hax

theorem relIndex_sup_le {M : Type*} [AddCommGroup M] {q : ℕ} (hq0 : q ≠ 0)
    {Φ : OpenAction M} (c : AdmissibleChain q Φ) (W : AddSubgroup M) (i : Fin c.n) :
    (W ⊔ c.step i.castSucc).relIndex (W ⊔ c.step i.succ) ≤ q := by
  haveI hfin : Finite (↥(c.step i.succ) ⧸ (c.step i.castSucc).addSubgroupOf (c.step i.succ)) := by
    apply Nat.finite_of_card_ne_zero
    rw [c.hcard i]
    exact hq0
  have h1 : c.step i.succ ≤ W ⊔ c.step i.succ := le_sup_right
  have hcompat : (c.step i.castSucc).addSubgroupOf (c.step i.succ) ≤
      ((W ⊔ c.step i.castSucc).addSubgroupOf (W ⊔ c.step i.succ)).comap
        (AddSubgroup.inclusion h1) := by
    intro y hy
    rw [AddSubgroup.mem_addSubgroupOf] at hy
    rw [AddSubgroup.mem_comap, AddSubgroup.mem_addSubgroupOf]
    exact AddSubgroup.mem_sup_right hy
  set f := QuotientAddGroup.map ((c.step i.castSucc).addSubgroupOf (c.step i.succ))
    ((W ⊔ c.step i.castSucc).addSubgroupOf (W ⊔ c.step i.succ))
    (AddSubgroup.inclusion h1) hcompat with hfdef
  have hsurj : Function.Surjective f := by
    intro y
    induction y using QuotientAddGroup.induction_on with
    | H y' =>
      obtain ⟨w, hw, s, hs, hws⟩ := AddSubgroup.mem_sup.mp y'.2
      refine ⟨((⟨s, hs⟩ : ↥(c.step i.succ)) :
        ↥(c.step i.succ) ⧸ (c.step i.castSucc).addSubgroupOf (c.step i.succ)), ?_⟩
      rw [hfdef, QuotientAddGroup.map_mk]
      rw [QuotientAddGroup.eq]
      rw [AddSubgroup.mem_addSubgroupOf]
      have hincl : ((AddSubgroup.inclusion h1 ⟨s, hs⟩ : ↥(W ⊔ c.step i.succ)) : M) = s := rfl
      have hcoe : ((-(AddSubgroup.inclusion h1 ⟨s, hs⟩) + y' : ↥(W ⊔ c.step i.succ)) : M) = w := by
        push_cast
        rw [hincl, ← hws]
        abel
      rw [hcoe]
      exact AddSubgroup.mem_sup_left hw
  have hcard_le : Nat.card (↥(W ⊔ c.step i.succ) ⧸
        (W ⊔ c.step i.castSucc).addSubgroupOf (W ⊔ c.step i.succ)) ≤
      Nat.card (↥(c.step i.succ) ⧸ (c.step i.castSucc).addSubgroupOf (c.step i.succ)) :=
    Nat.card_le_card_of_surjective f hsurj
  rw [c.hcard i] at hcard_le
  show ((W ⊔ c.step i.castSucc).addSubgroupOf (W ⊔ c.step i.succ)).index ≤ q
  rw [AddSubgroup.index_eq_card]
  exact hcard_le

theorem natCard_quotient_le_pow_filtAlpha {M : Type*} [AddCommGroup M] {q : ℕ} (hq : q.Prime)
    {Φ : OpenAction M} (c : AdmissibleChain q Φ) (W : AddSubgroup M)
    (σ₀ : Qbar ≃ₐ[ℚ] Qbar) (a : ℕ) (ha : ¬ a ≡ 1 [MOD q])
    (hζa : ∀ μ : Qbar, μ ^ q = 1 → σ₀ μ = μ ^ a)
    (hdisp : ∀ x : M, Φ.φ σ₀ x - x ∈ W) :
    Nat.card (M ⧸ W) ≤ q ^ filtAlpha c := by
  have key : ∀ k : Fin (c.n + 1), (W ⊔ c.step k).index ≤
      q ^ (Finset.univ.filter (fun j : Fin c.n => k.val ≤ j.val ∧ c.tag j = true)).card := by
    intro k
    induction k using Fin.reverseInduction with
    | last =>
      have h1 : W ⊔ c.step (Fin.last c.n) = ⊤ := by
        rw [c.htop]
        simp
      have h2 : (Finset.univ.filter
          (fun j : Fin c.n => (Fin.last c.n).val ≤ j.val ∧ c.tag j = true)) = ∅ := by
        apply Finset.filter_false_of_mem
        intro j _
        rw [Fin.val_last]
        intro hcon
        have := j.isLt
        omega
      rw [h1, h2]
      simp [AddSubgroup.index_top]
    | cast i ih =>
      by_cases htag : c.tag i = true
      ·
        have hle : W ⊔ c.step i.castSucc ≤ W ⊔ c.step i.succ := sup_le_sup_left (c.hmono i) W
        have hmul := AddSubgroup.relIndex_mul_index hle
        have hrel := relIndex_sup_le hq.ne_zero c W i
        have hset : (Finset.univ.filter
              (fun j : Fin c.n => (i.castSucc).val ≤ j.val ∧ c.tag j = true))
            = insert i (Finset.univ.filter
              (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert,
            Fin.val_castSucc, Fin.val_succ]
          constructor
          · rintro ⟨hlej, htgj⟩
            rcases eq_or_lt_of_le hlej with heq | hlt
            · left
              exact Fin.ext heq.symm
            · right
              exact ⟨by omega, htgj⟩
          · rintro (rfl | ⟨hlej, htgj⟩)
            · exact ⟨le_refl _, htag⟩
            · exact ⟨by omega, htgj⟩
        have hnot : i ∉ (Finset.univ.filter
            (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)) := by
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fin.val_succ]
          intro hcon
          omega
        have hcount : (Finset.univ.filter
              (fun j : Fin c.n => (i.castSucc).val ≤ j.val ∧ c.tag j = true)).card
            = (Finset.univ.filter
              (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)).card + 1 := by
          rw [hset, Finset.card_insert_of_notMem hnot]
        rw [hcount]
        calc (W ⊔ c.step i.castSucc).index
            = (W ⊔ c.step i.castSucc).relIndex (W ⊔ c.step i.succ)
              * (W ⊔ c.step i.succ).index := hmul.symm
          _ ≤ q * q ^ (Finset.univ.filter
              (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)).card :=
              Nat.mul_le_mul hrel ih
          _ = q ^ ((Finset.univ.filter
              (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)).card + 1) :=
              (pow_succ' q _).symm
      ·
        have htag' : c.tag i = false := by
          revert htag
          cases c.tag i <;> simp
        have hkill := step_kill hq c W ha hζa hdisp i htag'
        have hsup : W ⊔ c.step i.succ = W ⊔ c.step i.castSucc := by
          apply le_antisymm
          · refine sup_le le_sup_left ?_
            intro x hx
            exact hkill hx
          · exact sup_le_sup_left (c.hmono i) W
        have hset : (Finset.univ.filter
              (fun j : Fin c.n => (i.castSucc).val ≤ j.val ∧ c.tag j = true))
            = (Finset.univ.filter
              (fun j : Fin c.n => (i.succ).val ≤ j.val ∧ c.tag j = true)) := by
          ext j
          simp only [Finset.mem_filter, Finset.mem_univ, true_and,
            Fin.val_castSucc, Fin.val_succ]
          constructor
          · rintro ⟨hlej, htgj⟩
            refine ⟨?_, htgj⟩
            rcases eq_or_lt_of_le hlej with heq | hlt
            · exfalso
              have hji : j = i := Fin.ext heq.symm
              rw [hji, htag'] at htgj
              simp at htgj
            · omega
          · rintro ⟨hlej, htgj⟩
            exact ⟨by omega, htgj⟩
        rw [hset, ← hsup]
        exact ih
  have h0 : W ⊔ c.step 0 = W := by
    rw [c.hbot]
    simp
  have hkey := key 0
  rw [h0] at hkey
  have hcnt0 : (Finset.univ.filter
        (fun j : Fin c.n => (0 : Fin (c.n + 1)).val ≤ j.val ∧ c.tag j = true)).card
      = filtAlpha c := by
    show _ = (Finset.univ.filter fun i => c.tag i = true).card
    congr 1
    apply Finset.filter_congr
    intro j _
    simp
  rw [hcnt0] at hkey
  rw [← AddSubgroup.index_eq_card]
  exact hkey

theorem alphaGlue (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (hAq : Aq.LiesOverPrime q)
    (Φ : ∀ m : ℕ,
      letI := heckeModuleBar p
      OpenAction ↥(eisensteinPrimaryTorsionBar p q m))
    (hΦ : ∀ m : ℕ,
      letI := heckeModuleBar p
      ∀ (σ : (AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ))
        (x : ↥(eisensteinPrimaryTorsionBar p q m)),
        ((Φ m).φ σ x : JZero p) = σ • (x : JZero p))
    (c : ∀ m : ℕ,
      letI := heckeModuleBar p
      AdmissibleChain q (Φ m)) :
    ∀ m, ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
      (∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (q ^ m) = 1 → σ ζ = ζ ^ n σ) →
    ∀ W : AddSubgroup (JZero p),
      W ≤ eisensteinPrimaryTorsionBar p q m →
      MultiplicativeTypeNat (Aq.inertiaSubgroupIn ℚ) n W →
      (∀ σ ∈ Aq.inertiaSubgroupIn ℚ, ∀ x ∈ eisensteinPrimaryTorsionBar p q m,
        σ • (x : JZero p) - x ∈ W) →
      Nat.card (↥(eisensteinPrimaryTorsionBar p q m) ⧸ W.addSubgroupOf (eisensteinPrimaryTorsionBar p q m))
        ≤ q ^ filtAlpha (c m) := by
  intro m n hn W hWle hWmt hWdisp
  have _hn := hn
  have _hWmt := hWmt
  have _hWle := hWle
  obtain ⟨σ₀, hσ₀mem, a, ha, hζa⟩ := exists_inertia_exponent_ne_one q hq2 Aq hAq
  letI := heckeModuleBar p
  have hdisp : ∀ x : ↥(eisensteinPrimaryTorsionBar p q m),
      (Φ m).φ σ₀ x - x ∈ W.addSubgroupOf (eisensteinPrimaryTorsionBar p q m) := by
    intro x
    refine AddSubgroup.mem_addSubgroupOf.mpr ?_
    have h1 : (((Φ m).φ σ₀ x - x : ↥(eisensteinPrimaryTorsionBar p q m)) : JZero p)
        = σ₀ • (x : JZero p) - (x : JZero p) := by
      push_cast
      rw [hΦ m σ₀ x]
    rw [h1]
    exact hWdisp σ₀ hσ₀mem (x : JZero p) x.2
  exact natCard_quotient_le_pow_filtAlpha (Fact.out : q.Prime) (c m)
    (W.addSubgroupOf (eisensteinPrimaryTorsionBar p q m)) σ₀ a ha hζa hdisp

end HADEngine

theorem solution (p : ℕ) [Fact p.Prime]
    (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqn : q ∣ eisensteinNumerator p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (S : JZeroNeronPrimaryTorsionSheaf p q A hA)
    (Φ : ∀ m : ℕ,
      letI := heckeModuleBar p
      OpenAction ↥(eisensteinPrimaryTorsionBar p q m))
    (hΦ : ∀ m : ℕ,
      letI := heckeModuleBar p
      ∀ (σ : (AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ))
        (x : ↥(eisensteinPrimaryTorsionBar p q m)),
        ((Φ m).φ σ x : JZero p) = σ • (x : JZero p))
    (c : ∀ m : ℕ,
      letI := heckeModuleBar p
      AdmissibleChain q (Φ m)) :
    ∀ m : ℕ,
      letI := heckeModuleBar p
      (S.invPins.inv m).α ≤ filtAlpha (c m) := by
  intro m
  letI := heckeModuleBar p
  have hqp : q ≠ p := HADEngine.hqp p q Fact.out hqn
  obtain ⟨Aq, hAq⟩ := HADEngine.exists_place_over q Fact.out
  obtain ⟨n, hn⟩ := HADEngine.cycloWitness q m

  obtain ⟨c₀, _hc₀, hEq⟩ := ModularCurve.exists_eisensteinPrimaryTorsionBar_eq_torsionBySet_span_sup_pow p q
  have hqI : (q : HeckeAlg) ∈ (Ideal.span {(q : HeckeAlg)} ⊔ eisensteinMaximalIdeal p q ^ c₀) :=
    Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
  have hI : eisensteinMaximalIdeal p q ^ c₀ ≤ (Ideal.span {(q : HeckeAlg)} ⊔ eisensteinMaximalIdeal p q ^ c₀) := le_sup_right
  obtain ⟨W, hWle, hWmt, hWdisp⟩ :=
    ModularCurve.exists_multiplicativeTypeNat_torsionBySet_pow_inertiaSubgroupIn
      p q hqp Aq hAq (Ideal.span {(q : HeckeAlg)} ⊔ eisensteinMaximalIdeal p q ^ c₀) hqI c₀ hI m n hn

  have hWle' : W ≤ eisensteinPrimaryTorsionBar p q m := by
    rw [hEq m]; exact hWle
  have hWdisp' : ∀ σ ∈ Aq.inertiaSubgroupIn ℚ, ∀ x ∈ eisensteinPrimaryTorsionBar p q m,
      σ • (x : JZero p) - x ∈ W := by
    intro σ hσ x hx
    rw [hEq m] at hx
    exact hWdisp σ hσ x hx
  have hcard :=
    ModularCurve.natCard_eisensteinPrimaryTorsionBar_quotient_eq_pow_alpha_of_multiplicativeTypeNat
      p q hq2 hqp A hA S Aq hAq m n hn W hWle' hWmt hWdisp'
  have hle := HADEngine.alphaGlue p q hq2 Aq hAq Φ hΦ c m n hn W hWle' hWmt hWdisp'
  rw [hcard] at hle
  exact (Nat.pow_le_pow_iff_right (Fact.out : q.Prime).one_lt).mp hle

end S_ModularCurve_jZeroNeronTorsionSheaf_alpha_le_filtAlpha_v5
