section
-- Source module: Solutions.R6IL2CKeyRunA
/-!
# Round six, compact controls (I2C): the run of the key program, part A

Definitions and the six pushes of `keyProgC` (`keyPush_fsp`, continuation style).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## `Psi` from its steps -/

section Mk

variable {K ρ G n L : ℕ}

theorem phInv_mk {t u y t1 y1 t2 y2 : ℕ} (h1 : t1 = subM (Qc G n) t (-(oC K ρ G n u y)))
    (h2 : y1 = subM (2 ^ L) y (oB K ρ G n u t1)) (h3 : t2 = subM (Qc G n) t1 (oS K ρ G n y1))
    (h4 : y2 = subM (2 ^ L) y1 (oA K ρ G n u t2)) :
    phInv K ρ G n L ⟨t, u, y⟩ = ⟨t2, u, y2⟩ := by
  subst h1 h2 h3 h4; rfl

theorem Psi_mk {x t u y u1 t2 y2 u2 t4 y4 : ℕ} (h0 : u1 = subM (Qc G n) u (-(oS K ρ G n x)))
    (hp1 : phInv K ρ G n L ⟨t, u1, y⟩ = ⟨t2, u1, y2⟩) (h5 : u2 = subM (Qc G n) u1 (oS K ρ G n x))
    (hp2 : phInv K ρ G n L ⟨t2, u2, y2⟩ = ⟨t4, u2, y4⟩) :
    Psi K ρ G n L x ⟨t, u, y⟩ = ⟨t4, u2, y4⟩ := by
  unfold Psi
  have e1 : pU G n (-(oS K ρ G n x)) ⟨t, u, y⟩ = ⟨t, u1, y⟩ := by rw [h0]; rfl
  rw [e1, hp1]
  have e2 : pU G n (oS K ρ G n x) ⟨t2, u1, y2⟩ = ⟨t2, u2, y2⟩ := by rw [h5]; rfl
  rw [e2, hp2]

end Mk

/-! ## The run -/

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CKeyRunB
/-!
# Round six, compact controls (I2C): the run of the key program, part B

The eleven register updates of `keyProgC` (`keyMid_fsp`, continuation style).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

set_option maxHeartbeats 8000000 in
/-- **The eleven updates**: `stU 1; phK; stU (-1); phK; stT` realise `Psi` and `Tl`. -/
theorem keyMid_fsp_sol_aux {l : Lay} {K ρ G n L M Bb : ℕ} (hV : KVal l K ρ G n L M Bb)
    {s : IState HS} {G0 : Fin HS → List ℤ} (hc : G0 rC = []) (hE : KEnv (encK s G0) l K ρ G n)
    {x t u y : ℕ} (hx : x < l.QL) (ht : t < l.QC) (hu : u < l.QC) (hy : y < l.QL) :
    ∃ t4 u2 y4 : ℕ, Psi K ρ G n L x ⟨t, u, y⟩ = ⟨t4, u2, y4⟩ ∧ t4 < l.QC ∧ u2 < l.QC ∧
      Tl K ρ n x y4 < l.QL ∧
      ∀ {rest : RS} {fin : IState HS} {c : ℕ},
        FSp rest (encK s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 (Tl K ρ n x y4))) fin c →
        FSp (.seq (stU 1) (.seq phK (.seq (stU (-1)) (.seq phK (.seq stT rest)))))
          (encK s (KS G0 n ((2 : ℤ) ^ G) x t u y)) fin (cMid Bb n + c) := by
  have hEK : ∀ x' t' u' y' : ℕ, KEnv (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')) l K ρ G n :=
    fun x' t' u' y' => hE.congr (fun r hr => by
      simp only [kEnvRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact encK_G_eq (KS_ne _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide)))
  have hQCe : l.QC = Qc G n := hV.qc
  have hQLe : l.QL = 2 ^ L := hV.ql
  have T1 := stU_fsp hV hc (hEK x t u y) hx ht hu hy (c := 1) (Or.inl rfl)
  rw [one_mul, hQCe] at T1
  set u1 := subM (Qc G n) u (-(oS K ρ G n x)) with hu1d
  have hu1 : u1 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T2 := stC_fsp hV hc (hEK x t u1 y) hx ht hu1 hy
  rw [one_mul, hQCe] at T2
  set t1 := subM (Qc G n) t (-(oC K ρ G n u1 y)) with ht1d
  have ht1 : t1 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T3 := stB_fsp hV hc (hEK x t1 u1 y) hx ht1 hu1 hy
  rw [neg_one_mul, neg_neg, hQLe] at T3
  set y1 := subM (2 ^ L) y (oB K ρ G n u1 t1) with hy1d
  have hy1 : y1 < l.QL := by rw [hQLe]; exact subM_lt (by positivity) _ _
  have T4 := stS_fsp hV hc (hEK x t1 u1 y1) hx ht1 hu1 hy1
  rw [neg_one_mul, neg_neg, hQCe] at T4
  set t2 := subM (Qc G n) t1 (oS K ρ G n y1) with ht2d
  have ht2 : t2 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T5 := stA_fsp hV hc (hEK x t2 u1 y1) hx ht2 hu1 hy1
  rw [neg_one_mul, neg_neg, hQLe] at T5
  set y2 := subM (2 ^ L) y1 (oA K ρ G n u1 t2) with hy2d
  have hy2 : y2 < l.QL := by rw [hQLe]; exact subM_lt (by positivity) _ _
  have T6 := stU_fsp hV hc (hEK x t2 u1 y2) hx ht2 hu1 hy2 (c := -1) (Or.inr rfl)
  rw [neg_one_mul, neg_neg, hQCe] at T6
  set u2 := subM (Qc G n) u1 (oS K ρ G n x) with hu2d
  have hu2 : u2 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T7 := stC_fsp hV hc (hEK x t2 u2 y2) hx ht2 hu2 hy2
  rw [one_mul, hQCe] at T7
  set t3 := subM (Qc G n) t2 (-(oC K ρ G n u2 y2)) with ht3d
  have ht3 : t3 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T8 := stB_fsp hV hc (hEK x t3 u2 y2) hx ht3 hu2 hy2
  rw [neg_one_mul, neg_neg, hQLe] at T8
  set y3 := subM (2 ^ L) y2 (oB K ρ G n u2 t3) with hy3d
  have hy3 : y3 < l.QL := by rw [hQLe]; exact subM_lt (by positivity) _ _
  have T9 := stS_fsp hV hc (hEK x t3 u2 y3) hx ht3 hu2 hy3
  rw [neg_one_mul, neg_neg, hQCe] at T9
  set t4 := subM (Qc G n) t3 (oS K ρ G n y3) with ht4d
  have ht4 : t4 < l.QC := by rw [hQCe]; exact subM_lt Qc_pos _ _
  have T10 := stA_fsp hV hc (hEK x t4 u2 y3) hx ht4 hu2 hy3
  rw [neg_one_mul, neg_neg, hQLe] at T10
  set y4 := subM (2 ^ L) y3 (oA K ρ G n u2 t4) with hy4d
  have hy4 : y4 < l.QL := by rw [hQLe]; exact subM_lt (by positivity) _ _
  have T11 := stT_fsp hV hc (hEK x t4 u2 y4) hx ht4 hu2 hy4
  rw [one_mul, hQLe, ← Tl_sub hV.hK hV.hL x (by rw [← hQLe]; exact hy4)] at T11
  have hy5 : Tl K ρ n x y4 < l.QL := by
    rw [hQLe]; exact (Tl_spec hV.hK hV.hL x (by rw [← hQLe]; exact hy4)).1
  have hPsi : Psi K ρ G n L x ⟨t, u, y⟩ = ⟨t4, u2, y4⟩ :=
    Psi_mk rfl (phInv_mk rfl rfl rfl rfl) rfl (phInv_mk rfl rfl rfl rfl)
  refine ⟨t4, u2, y4, hPsi, ht4, hu2, hy5, fun hr => ?_⟩
  refine (T1.seq ((T2.seq (T3.seq (T4.seq T5))).seq (T6.seq ((T7.seq (T8.seq (T9.seq T10))).seq
    (T11.seq hr))))).mono ?_
  simp only [cMid]
  clear * -
  omega

end IntMul.Kappa.R6.IL2C

end

theorem solution : type_of% @IntMul.Kappa.R6.IL2C.keyMid_fsp_sol_aux := @IntMul.Kappa.R6.IL2C.keyMid_fsp_sol_aux
