  have hcomm : ∀ a b : PtGrp u.L t, a * b = b * a := fun a b =>
    show u.L.mul t a b = u.L.mul t b a from u.comm t a b
  have h : ThetaPt.ptHom (θ * θ' * θ⁻¹ * θ'⁻¹) = (1 : PtGrp u.L t) := by
    rw [map_mul, map_mul, map_mul, map_inv, map_inv, hcomm (ThetaPt.ptHom θ) (ThetaPt.ptHom θ'),
      mul_inv_cancel_right, mul_inv_cancel]
  rw [ThetaPt.ptHom_apply] at h
  exact h

