-- Source module: Solutions.J6SegILJKer7
/-!
# B-line IL, the `J` kernel (B4), part 7: list moves on managed states

Plain register programs (no products, linear cost) used around the kernel loops:

* `rdT X`: one table entry from `dTJ` onto `X`, recorded on the consumed-table stack `TT`;
* `rdH X`: one header entry from `dTJ` onto `X` (not recorded);
* `popL X C n`: drop `n` entries of `X`;
* `dupMv X Y T C n`: copy the top `n` entries of `X` (reversed) onto `Y` and onto `T`, removing
  them from `X`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

section moves
variable {s : IState HS} {G : Fin HS → List ℤ}

theorem popL_spec {X C : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56)
    (hC : G C = []) {L l : List ℤ} (hX : G X = L ++ l) {n : Ex HS} (hnc : n.Clean)
    (hno : n.ok (encK s G)) (hnl : n.Lin) {B : ℕ} (hnb : n.Bnd (encK s G) B)
    (hn : n.eval (encK s G) = L.length) (hL : Bnd B L) :
    Sp (popL X C n) (encK s G) (encK s (update G X l))
      ((n.size + 1) * 2000 * (B + 2) + L.length * (8000 * (B + 2) + 2 * B + 32) + 32) := by
  have hF0 : update G X (L.drop 0 ++ l) = G := by
    rw [List.drop_zero, ← hX, update_eq_self]
  have H := Sp.rep (s := s) (C := C) (n := n) (b := .pop X)
    (F := fun k => update G X (L.drop k ++ l)) (N := L.length) (B := B)
    (c := 2 * B + 2) hC5 (fun k => by simp [update_apply, Ne.symm hXC, hC])
    (by simp [RS.writes, hXC, Ne.symm hXC]) hnc (by simp only [hF0]; exact hno) hnl
    (by simp only [hF0]; exact hnb) (by simp only [hF0]; exact hn) (fun k hk => by
      have hd : L.drop k ++ l = L[k] :: (L.drop (k + 1) ++ l) := by
        rw [List.drop_eq_getElem_cons hk]; rfl
      have hk' : (update (update G X (L.drop k ++ l)) C [(L.length : ℤ) - k]) X =
          L[k] :: (L.drop (k + 1) ++ l) := by
        rw [update_of_ne hXC, update_self, hd]
      have := Sp.pop (s := s) (f := _) (B := B) hX5 hk' (hL _ (List.getElem_mem hk))
      refine this.congr ?_
      congr 1
      rw [update_comm (Ne.symm hXC), update_idem])
  simp only [hF0, List.drop_length, List.nil_append] at H
  refine H.mono (le_of_eq (by ring))

end moves

end J6Seg.JK

