-- title:
--   Brownian natural filtration, possibly infinite stopping times and McKean discounted put model
-- statement:
--   Defines a genuine continuous drifted Brownian Lévy process by its Gaussian exponent, the natural sigma-field generated by its past, possibly infinite stopping times, and the exact discounted American put reward. A nontrivial first downcrossing and piecewise value candidate are defined without assuming optimality. Draft source not yet elaborated remotely.
-- source:
--   Kyprianou (2006), Chapter 1, pp. 21–23, equations (1.14)–(1.16) and Theorem 1.13.

import Mathlib
import Definitions.Def_LeanLevy_Processes_LevyProcess
import Definitions.Def_PerfCorrMSQ_NaturalFiltration
import Mathlib.MeasureTheory.Measure.CharacteristicFunction.Basic

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal

set_option autoImplicit false
namespace Kyprianou.Ch01
variable {Ω : Type*} [MeasurableSpace Ω]

/-- Natural filtration generated by the observed real process up to time t. -/
noncomputable def naturalSigma
    (X : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) : MeasurableSpace Ω :=
  PerfCorrMSQ.natFiltr X t

/-- A possibly infinite stopping time in the natural filtration of X. -/
def IsNaturalStoppingTime
    (X : ℝ≥0 → Ω → ℝ) (τ : Ω → WithTop ℝ≥0) : Prop :=
  ∀ t : ℝ≥0,
    @MeasurableSet Ω (naturalSigma X t)
      {ω | τ ω ≤ (t : WithTop ℝ≥0)}

/-- A drifted Brownian motion specified by its a.s. continuous Lévy paths
    and Gaussian characteristic exponent. -/
def IsLinearBrownian (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℝ≥0 → Ω → ℝ) (sigma gamma : ℝ) : Prop :=
  IsLevyProcess X P ∧
    (∀ᵐ ω ∂P, Continuous (fun t : ℝ≥0 => X t ω)) ∧
    ∀ (t : ℝ≥0) (xi : ℝ),
      charFun (P.map (X t)) xi =
        Complex.exp (((t : ℝ) : ℂ) *
          (Complex.I * ((gamma * xi : ℝ) : ℂ) -
            (((sigma ^ 2 * xi ^ 2 / 2 : ℝ)) : ℂ)))

/-- Payoff is zero if the exercise time is infinite. -/
noncomputable def discountedPut
    (X : ℝ≥0 → Ω → ℝ) (x K q : ℝ)
    (τ : Ω → WithTop ℝ≥0) (ω : Ω) : ℝ :=
  match τ ω with
  | none => 0
  | some t =>
      Real.exp (-q * (t : ℝ)) *
        max (K - Real.exp (x + X t ω)) 0

/-- First strict downcrossing time, infinite if the path never crosses. -/
noncomputable def firstLowerPassage
    (X : ℝ≥0 → Ω → ℝ) (x barrier : ℝ)
    (ω : Ω) : WithTop ℝ≥0 :=
  by
    classical
    exact if h : ∃ t : ℝ≥0, 0 < t ∧ x + X t ω < barrier then
      ((sInf ({t : ℝ≥0 | 0 < t ∧ x + X t ω < barrier} : Set ℝ≥0) : ℝ≥0) : WithTop ℝ≥0)
    else ⊤

/-- McKean's explicit candidate value, with the stopping boundary b. -/
noncomputable def mckeanValue
    (K b phi x : ℝ) : ℝ :=
  if x < b then K - Real.exp x
    else (K - Real.exp b) * Real.exp (-phi * (x - b))

end Kyprianou.Ch01


