/-! The readonly serializer context of an actual verifier, bounded by its seven-field
metadata encoding rather than by an assumed polynomial-time output-size argument. -/
set_option backward.isDefEq.respectTransparency false
namespace QMAPerfectCompleteness.Main.CircuitRecipe.Context
open QMAPerfectCompleteness.Uniformity.StructuredStack

def ofMeta (P : CyclicRaw.Meta) (src : List RawEncoding.Instruction) : Context 0 where
  values
    | .inl p => P.env p
    | .inr (.inl j) => j.elim0
    | .inr (.inr ()) => 0
  source := src

noncomputable def ofVerifier (V : Verifier gatesG2) : Context 0 :=
  ofMeta (CyclicRaw.params V) (RawEncoding.eraseVerifier V).gates





 theorem sourceValid_erase (V : Verifier gatesG2) : SourceValid (RawEncoding.eraseVerifier V).gates := by
  intro g hg
  obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hg
  constructor
  · exact i.gate.isLt
  · simp only [RawEncoding.eraseInstr,List.length_ofFn]
    exact (congrArg (fun x=>x.getD 0) (RawEncoding.g2Table_correct i.gate)).symm

@[simp] theorem ofVerifier_code (V : Verifier gatesG2) : (ofVerifier V).code=V.gates.flatMap Instr.encode := by
  simp [Context.code,ofVerifier,ofMeta,RawEncoding.eraseVerifier,List.flatMap_map,Function.comp_def]

 theorem metadata_length (V : Verifier gatesG2) :
    (CyclicMetadataTM.metadataCode V).length=indexQubits V+clockQubits V.proofQubits+ell V.proofQubits+
      V.proofQubits+V.ancillaQubits+V.output.val+hhCount V+7+(ofVerifier V).code.length := by
  simp [CyclicMetadataTM.metadataCode,CyclicMetadataTM.clockCode,CyclicMetadataTM.code,
    QAlgorithms.Complexity.encNat,List.length_append]
  omega

/-- Every readonly unary field and the source byte stream fit within the actual metadata input. -/
theorem ofVerifier_valid (V : Verifier gatesG2) :
    (ofVerifier V).Valid (CyclicMetadataTM.metadataCode V).length := by
  have hl := metadata_length V
  refine ⟨?_,rfl,?_,sourceValid_erase V⟩
  · intro a
    rcases a with (p|j|u)
    · cases p <;>
        simp only [ofVerifier,ofMeta,CyclicRaw.Meta.env,CyclicRaw.params,CyclicRaw.ofRaw_erase] <;>
        omega
    · exact j.elim0
    · cases u
      exact Nat.zero_le _
  · omega

end QMAPerfectCompleteness.Main.CircuitRecipe.Context


