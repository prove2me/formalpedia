-- title:
--   A vertex repeated on a face is a cut vertex
-- statement:
--   For a permutation $\sigma$ of a finite set $D$ of darts, $c(\sigma)$ is its number of cycles. A pair $(\sigma,\theta)$ is planar if $c(\sigma)+c(\theta)+c(\sigma\theta)=|D|+2k$, where $k$ is the number of components of the relation generated by both permutations. Let $(\sigma,\theta)$ be planar and $x\ne y$ darts lying in the same cycle of $\sigma$ (the same vertex) and in the same cycle of $\sigma\theta$ (the same face). Then after splitting the vertex,
--   $$
--   x\text{ and }y\text{ lie in different components of }\bigl((x\ y)\sigma,\ \theta\bigr).
--   $$
--
--   In genus zero, a vertex that appears twice on the same face is a cut vertex.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/Suppression.lean#L152-L166

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

theorem OAI.KervaireRibbon.planar_vertex_split_separates (σ θ : Equiv.Perm D) {x y : D} (hne : x ≠ y)
    (hxy : σ.SameCycle x y) (hφ : (σ*θ).SameCycle x y) (hp : planar σ θ) :
    ¬ components (swap x y * σ) θ x y := by sorry
