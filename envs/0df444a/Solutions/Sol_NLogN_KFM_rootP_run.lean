theorem satLoop_run (rv : Fin HS) (hv56 : rv.val < 56) (hvJ : rv ≠ sJ) (hvY : rv ≠ sY)
    (t : IState HS) (v y0 : ℕ) (LY LV : List Item) (hY : t.G sY = .int (y0 : ℤ) :: LY)
    (hV : t.G rv = .int (v : ℤ) :: LV) (hy : y0 ≤ v + 1) (m : ℕ) :
    (rep sJ (.lit m) (.asg sY (satE rv))).ok t ∧
      (rep sJ (.lit m) (.asg sY (satE rv))).run t =
        t.upd sY (.int (min ((y0 : ℤ) ^ (2 ^ m)) ((v : ℤ) + 1)) :: LY) := by
  have H := genLoop_run sJ sY (.lit (m : ℤ)) (.asg sY (satE rv)) t m (satG ((v : ℤ) + 1)) (y0 : ℤ) LY
    (by decide) (by decide) (by intro j hj; simp [Ex.regs] at hj) trivial (by simp [Ex.eval])
    (by simp [RS.writes]; decide) hY
    (by
      intro k hk
      set u := lpSt t sJ sY LY m k (accSeq (satG ((v : ℤ) + 1)) (y0 : ℤ) k) with hu
      have uY : u.G sY = .int (accSeq (satG ((v : ℤ) + 1)) (y0 : ℤ) k) :: LY := lpSt_G_a _ _ _ _ _ _ _
      have uV : u.G rv = .int (v : ℤ) :: LV := by rw [hu, lpSt_G_ne _ _ _ _ _ _ _ _ hvJ hvY, hV]
      have tY := IState.top_eq uY
      have tV := IState.top_eq uV
      refine ⟨⟨by decide, satE_clean hv56, ?_, IState.isInt_of uY⟩, ?_⟩
      · simp only [satE, Ex.ok]
        refine ⟨⟨⟨IState.isInt_of uV, trivial⟩, IState.isInt_of uY, IState.isInt_of uY⟩, ?_⟩
        split_ifs
        · exact ⟨IState.isInt_of uV, trivial⟩
        · exact ⟨IState.isInt_of uY, IState.isInt_of uY⟩
      · simp only [RS.run, uY, List.tail_cons]
        congr 2
        simp only [satE, Ex.eval, tY, tV, satG, sub_eq_add_neg])
  rw [accSeq_satSq ((v : ℤ) + 1) (by omega) (y0 : ℤ) (by positivity) (by exact_mod_cast hy)] at H
  exact H

theorem rootInd_eq (m v x : ℕ) :
    (if (v : ℤ) + -min ((x : ℤ) ^ (2 ^ m)) ((v : ℤ) + 1) < 0 then (0 : ℤ) else 1) = rootInd m v x := by
  unfold rootInd
  by_cases hx : x ^ (2 ^ m) ≤ v
  · have : ((x : ℤ) ^ (2 ^ m)) ≤ v := by exact_mod_cast hx
    rw [min_eq_left (by omega), if_neg (by omega), if_pos hx]
  · have : (v : ℤ) < (x : ℤ) ^ (2 ^ m) := by exact_mod_cast not_le.1 hx
    rw [if_pos (by omega), if_neg hx]

