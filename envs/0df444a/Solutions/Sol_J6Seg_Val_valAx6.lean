-- Source module: Solutions.J6SegVal1
/-!
# B-line value bounds 1: entrywise predicates through the passes

Generic facts: an entrywise predicate `Pr` that holds at `default` passes through
`transposeL`, `blkTg`, `rowMap`, `kerPass` (when the kernel maps `Pr`-rows to `Pr'`-rows),
`slabPass` (when every `h l` maps `Pr` to `Pr'`), `chunksG` and `liftG`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY NLogN

namespace J6Seg.Val

section gen
variable {α β : Type*} [Inhabited α] [Inhabited β]

theorem getD_pr {Pr : α → Prop} (h0 : Pr default) {L : List α} (hL : ∀ z ∈ L, Pr z) (i : ℕ) :
    Pr (L.getD i default) := by
  rw [List.getD_eq_getElem?_getD]
  cases h : L[i]? with
  | none => exact h0
  | some z => exact hL z (List.mem_of_getElem? h)

theorem transposeL_pr {Pr : α → Prop} (h0 : Pr default) {L : List α} (hL : ∀ z ∈ L, Pr z)
    (n m : ℕ) : ∀ z ∈ transposeL n m L, Pr z := by
  intro z hz
  unfold transposeL at hz
  obtain ⟨q, -, rfl⟩ := List.mem_map.1 hz
  exact getD_pr h0 hL _

theorem take_drop_pr {Pr : α → Prop} {L : List α} (hL : ∀ z ∈ L, Pr z) (a b : ℕ) :
    ∀ z ∈ (L.drop a).take b, Pr z :=
  fun z hz => hL z (List.mem_of_mem_drop (List.mem_of_mem_take hz))

theorem blkTg_pr {Pr : α → Prop} (h0 : Pr default) {L : List α} (hL : ∀ z ∈ L, Pr z)
    (m k a : ℕ) : ∀ z ∈ blkTg m k a L, Pr z := by
  intro z hz
  unfold blkTg at hz
  obtain ⟨i, -, hi⟩ := List.mem_flatMap.1 hz
  exact transposeL_pr h0 (take_drop_pr hL _ _) m k z hi

theorem rowMap_pr {Pr Pr' : α → Prop} {n R : ℕ} {g : ℕ → List α → List α}
    (hg : ∀ r X, X.length = n → (∀ z ∈ X, Pr z) → ∀ y ∈ g r X, Pr' y)
    {X : List α} (hXl : X.length = R * n) (hX : ∀ z ∈ X, Pr z) :
    ∀ y ∈ rowMap n R g X, Pr' y := by
  intro y hy
  unfold rowMap at hy
  obtain ⟨r, hr, hy⟩ := List.mem_flatMap.1 hy
  rw [List.mem_range] at hr
  refine hg r _ ?_ (take_drop_pr hX _ _) y hy
  simp only [List.length_take, List.length_drop, hXl]
  have : (r + 1) * n ≤ R * n := Nat.mul_le_mul_right _ hr
  rw [Nat.succ_mul] at this; omega

/-- **Kernel passes keep entrywise predicates.** -/
theorem kerPass_pr {Pr Pr' : α → Prop} (h0' : Pr' default) (h0 : Pr default)
    {m post A : ℕ} {g : ℕ → List α → List α}
    (hg : ∀ b X, X.length = m → (∀ z ∈ X, Pr z) → ∀ y ∈ g b X, Pr' y)
    {L : List α} (hX : ∀ z ∈ L, Pr z) :
    ∀ y ∈ kerPass m post A g L, Pr' y := by
  unfold kerPass
  apply blkTg_pr h0'
  apply rowMap_pr (Pr := Pr) (fun r X hX' hXp => hg (r / post) X hX' hXp)
  · rw [length_blkTg]; ring
  · exact blkTg_pr h0 hX _ _ _

theorem slabOf_pr {Pr : α → Prop} {Pr' : β → Prop} (h0' : Pr' default) {h : α → β}
    (hh : ∀ z, Pr z → Pr' (h z)) {B : List α} (hB : ∀ z ∈ B, Pr z) (post : ℕ)
    (src : Option ℕ) : ∀ y ∈ slabOf B post src h, Pr' y := by
  intro y hy
  unfold slabOf at hy
  cases src with
  | none =>
    simp only [List.mem_replicate] at hy
    rw [hy.2]; exact h0'
  | some k =>
    obtain ⟨z, hz, rfl⟩ := List.mem_map.1 hy
    exact hh z (take_drop_pr hB _ _ z hz)

theorem chunkL_pr {Pr : α → Prop} {L : List α} (hL : ∀ z ∈ L, Pr z) (n : ℕ) :
    ∀ B ∈ IntMul.HvdH.Ref.chunkL n L, ∀ z ∈ B, Pr z := by
  intro B hB
  unfold IntMul.HvdH.Ref.chunkL at hB
  obtain ⟨i, -, rfl⟩ := List.mem_map.1 hB
  exact take_drop_pr hL _ _

/-- **Slab passes keep entrywise predicates.** -/
theorem slabPass_pr {Pr : α → Prop} {Pr' : β → Prop} (h0' : Pr' default)
    {n n' post : ℕ} {src : ℕ → Option ℕ} {h : ℕ → α → β}
    (hh : ∀ l z, Pr z → Pr' (h l z)) {L : List α} (hL : ∀ z ∈ L, Pr z) :
    ∀ y ∈ slabPass n n' post src h L, Pr' y := by
  intro y hy
  unfold slabPass at hy
  obtain ⟨B, hB, hy⟩ := List.mem_flatMap.1 hy
  obtain ⟨l, -, hy⟩ := List.mem_flatMap.1 hy
  exact slabOf_pr h0' (hh l) (chunkL_pr hL _ B hB) post (src l) y hy

end gen

/-! ## Integer bounds on Gaussian lists -/

theorem PB_default {A : ℤ} (hA : 0 ≤ A) : PB A default := by
  simp [PB, default_GI, hA]

theorem PB_mono {A B : ℤ} (h : A ≤ B) {z : ℤ × ℤ} (hz : PB A z) : PB B z :=
  ⟨hz.1.trans h, hz.2.trans h⟩

/-- A real kernel bound lifts to `liftG`. -/
theorem liftG_pr {A B : ℤ} {f : List ℤ → List ℤ} {n : ℕ}
    (hf : ∀ v : List ℤ, v.length = n → (∀ a ∈ v, |a| ≤ A) → ∀ y ∈ f v, |y| ≤ B)
    {x : List (ℤ × ℤ)} (hxl : x.length = n) (hx : ∀ z ∈ x, PB A z) :
    ∀ y ∈ liftG f x, PB B y := by
  intro y hy
  unfold liftG at hy
  refine ⟨hf _ (by simp [hxl]) ?_ _ (List.of_mem_zip hy).1,
    hf _ (by simp [hxl]) ?_ _ (List.of_mem_zip hy).2⟩
  · intro a ha
    obtain ⟨z, hz, rfl⟩ := List.mem_map.1 ha
    exact (hx z hz).1
  · intro a ha
    obtain ⟨z, hz, rfl⟩ := List.mem_map.1 ha
    exact (hx z hz).2

/-- `PB` gives `GB` widths: `|a| ≤ 2^e ⇒ zsz a ≤ e + 1`. -/
theorem zsz_of_abs {a : ℤ} {e : ℕ} (h : |a| ≤ 2 ^ e) : zsz a ≤ e + 1 := by
  apply zsz_le_of_lt
  have h1 : (a.natAbs : ℤ) ≤ 2 ^ e := by rw [Int.natCast_natAbs]; exact h
  have h2 : a.natAbs ≤ 2 ^ e := by exact_mod_cast h1
  exact lt_of_le_of_lt h2 (Nat.pow_lt_pow_right (by norm_num) (by omega))

end J6Seg.Val

