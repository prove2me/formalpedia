    @MeasureTheory.StronglyMeasurable Ω ℝ _ (ℱ.rightCont b)
      (LevyStochCalc.Brownian.Ito.polarQuadVarIncrement W ℱ hℱ H₁ H₂ hm₁ hm₂ hp₁ hp₂ hq₁ hq₂ a b) := by
