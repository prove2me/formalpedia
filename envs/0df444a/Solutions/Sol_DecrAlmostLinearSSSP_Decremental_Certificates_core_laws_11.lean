      t.natReg 560 = CoreMemory.encodedEdge b e := by
  have hempty : CorePending.View B ([] : List (Fin (logicalCount b))) s := by simpa only [hp,List.map_nil] using h.pending
  obtain ⟨cost,t,ys,ht,hcost,hys,htview,hlen,htr,htn⟩ := CorePending.enqueue B [] s (logicalIndexEquiv b e)
    hempty h.layout.recordBase he h.captured.unit h.captured.two
  have hmemory : CorePending.MemoryFrame B (logicalCount b) s t :=
    fun j hj => htn j (hj (logicalIndexEquiv b e)).1 (hj (logicalIndexEquiv b e)).2
  have hhm := queue_image b B K state ys s t h hB
    (fun k hk h546 => ht.nat_frame (CorePending.nat_frame k h546
      (by simp only [NatRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega)))
    (fun k _ => ht.real_frame (CorePending.real_frame k)) htview htr hmemory
  have hhm' : Image b B K {state with pending := [e]} t := by
    have hys' : ys = [logicalIndexEquiv b e] := by simpa using hys
    simpa only [hys',List.map_cons,List.map_nil,Equiv.symm_apply_apply] using hhm
  have hsm : CoreSource.Image B (CoreMemory.sourceRecord b B) N g t := by
    apply hs.host_frame b B N g
    · intro k hk
      exact ht.nat_frame (CorePending.nat_frame k
        (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hk;omega)
        (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
    · intro j hj
      have heven : evenRegisters CorePending.code = true := by decide
      have hf := evenRegisters_frames _ heven (shadowReg j) (by simp [shadowReg])
      exact ⟨ht.nat_frame hf.1,ht.real_frame hf.2⟩
    · intro address ha
