-- title:
--   Lemma A.5, p. 30 — the empirical measure of a finite exchangeable sequence is a regular conditional distribution of each $Y_i$ given it
-- statement:
--   Let $\mathcal Y$ be a Polish space and $Y_1,\dots,Y_N$ a finite exchangeable sequence of $\mathcal Y$-valued random variables on $(\Omega,\mathcal F,P)$: the law of $(Y_{\sigma(1)},\dots,Y_{\sigma(N)})$ equals that of $(Y_1,\dots,Y_N)$ for every permutation $\sigma$. Let
--   $$\mu^N_\omega=\frac1N\sum_{i=1}^N\delta_{Y_i(\omega)},\qquad\omega\in\Omega,$$
--   be the associated empirical measure. Then for every $i\in\{1,\dots,N\}$,
--   $$P\big(Y_i\in\cdot\mid\mu^N\big)=\mu^N(\cdot),$$
--   in the sense that $\mu^N$ is a regular conditional distribution of $Y_i$ given the σ-algebra generated by $\mu^N$.
--
--   In the proof of Theorem 6.1 this identifies the conditional law of player 1's state given the empirical flow of the $N$-player game.
--
--   **Formalization Note** The σ-algebra generated by $\mu^N$ is taken with respect to Mathlib's (Giry) σ-algebra on measures on $\mathcal Y$, the one generated by the evaluations $\mu\mapsto\mu(A)$.
-- source:
--   Campi & Fischer, Correlated equilibria and mean field games: a simple model, arXiv:2004.06185v2, p. 30, Lemma A.5 (with the standing assumptions of Appendix A, p. 27)

import Mathlib
import Definitions.Def_SimpleCorrMFG_Conv_RegCondDistrib

namespace SimpleCorrMFG.Conv

open MeasureTheory ProbabilityTheory unitInterval Filter Topology

/-- Lemma A.5 (p. 30). Exchangeability of `(Y_1, …, Y_N)`: its law is invariant under every
permutation of the indices. -/
theorem lemma_A_5 {Ω 𝒴 : Type*} [MeasurableSpace Ω] [TopologicalSpace 𝒴] [PolishSpace 𝒴]
    [MeasurableSpace 𝒴] [BorelSpace 𝒴] (P : Measure Ω) [IsProbabilityMeasure P] {N : ℕ}
    (Y : Fin N → Ω → 𝒴) (hY : ∀ i, Measurable (Y i))
    (hexch : ∀ π : Equiv.Perm (Fin N),
      P.map (fun ω i => Y (π i) ω) = P.map (fun ω i => Y i ω))
    (i : Fin N) :
    IsRegCondDistrib P (Y i) (empiricalMeasure Y)
      (MeasurableSpace.comap (empiricalMeasure Y) inferInstance) := by sorry

end SimpleCorrMFG.Conv
