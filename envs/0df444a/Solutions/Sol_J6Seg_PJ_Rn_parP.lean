theorem Rn.rdK {v : Vr} {c : Cs} {W : ℕ} {X dst : Fin HS} (hX : X ∉ rg) (hX5 : X.val < 56)
    (hXT : X ≠ sTmp) (hXC : X ≠ cRdC) (hdst : dst ∈ rg) (hd9 : dst ≠ rIx) {L : List ℤ}
    (hcX : c X = L) {j : ℕ} (hj : j < L.length) (hv : BV W v)
    (hL : ∀ x ∈ L, |x| < 2 ^ W) (hjW : j < 2 ^ W) (hdW : |v dst| < 2 ^ W) :
    Rn (rdK X j dst) v c (· = Function.update (Function.update v rIx j) dst L[j]) c (cRdK j W) := by
  have h1 := Rn.asg (i := rIx) (e := .lit j) (c := c) (v := v) (W := W) (by decide)
    (fun i hi => by simp [Ex.regs] at hi) (fun i hi => by simp [Ex.regs] at hi) trivial
    (by show (((j : ℕ) : ℤ)).natAbs ≤ 2 ^ W; simp; omega) hv
    (fun i hi => by simp [Ex.regs] at hi)
  refine (Rn.seq h1 (fun v1 hv1 => ?_)).mono (fun _ h => h) le_rfl
  subst hv1
  have h2 := Rn.rd (v := Function.update v rIx (ev v c (.lit j))) (c := c) (X := X) (T := sTmp)
    (C := cRdC) (idx := rIx) (dst := dst) hX (by decide) hXT hXC (by decide) hX5 (by decide)
    (by decide) (by decide) hdst (Ne.symm hd9) hcX hj (by simp) hL (by simp; omega)
    (by rw [Function.update_of_ne hd9]; exact hdW)
  simpa using h2

end J6Seg.PJ

