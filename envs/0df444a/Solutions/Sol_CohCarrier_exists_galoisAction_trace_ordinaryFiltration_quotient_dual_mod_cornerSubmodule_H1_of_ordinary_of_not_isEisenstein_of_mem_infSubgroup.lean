theorem cbar_ϑ_basisA (κ : Fin K) :
    cb (ϑϑ (bAO κ)) = cstar c RR (cstar c RR (εc op hop hgen T u bO hbO Sp i₀ r huindO huspanO) (Pi.single κ 1))
      (εc op hop hgen T u bO hbO Sp i₀ r huindO huspanO) := by
  have h1 : ΞAA ((ϑϑ (bAO κ) : Sp.CornerRing i₀) : 𝕋) = ΞAA (Sp.e i₀) * bAO κ * ΞAA (Sp.e i₀) := by
    apply Subtype.ext
    rw [Subalgebra.coe_mul, Subalgebra.coe_mul, coe_ΞA, coe_ΞA, Ξ_ϑ op hop hgen T bO hbO Sp i₀]
  show (red r) ∘ crdO (ΞAA ((ϑϑ (bAO κ) : Sp.CornerRing i₀) : 𝕋)) = _
  rw [h1, crd_mul T u c 𝒪 huindO huspanO hu_mul, crd_mul T u c 𝒪 huindO huspanO hu_mul, crd_basisA, cstar_map, cstar_map]
  have hs : (red r) ∘ (Pi.single κ (1 : 𝒪) : Fin K → 𝒪) = Pi.single κ 1 := by
    funext m; by_cases hm : m = κ
    · subst hm; simp
    · simp [Pi.single_eq_of_ne hm]
  rw [hs]
  rfl

