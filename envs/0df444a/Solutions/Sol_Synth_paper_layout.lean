lemma idx_lt {n : ℕ} {o : LOp} (h : o.WF n) {k : ℕ} (hk : k < n) : o.idx k < n := by
  cases o with
  | mv c p => obtain ⟨h1, h2⟩ := h; simp only [idx]; exact rotIdx_lt (by omega) hk
  | xch i j K => obtain ⟨h1, h2⟩ := h; simp only [idx]; exact bsIdx_lt h1 h2 hk

lemma inv_lt {n : ℕ} {o : LOp} (h : o.WF n) {k : ℕ} (hk : k < n) : o.inv k < n := by
  cases o with
  | mv c p => obtain ⟨h1, h2⟩ := h; simp only [Synth.LOp.inv]; exact rotIdx_lt (by omega) hk
  | xch i j K => obtain ⟨h1, h2⟩ := h; simp only [Synth.LOp.inv]; exact bsIdx_lt h1 h2 hk

lemma idx_inv {n : ℕ} {o : LOp} (h : o.WF n) (k : ℕ) : o.idx (o.inv k) = k := by
  cases o with
  | mv c p => simp only [idx, Synth.LOp.inv]; exact rotIdx_inv _ _ _ _
  | xch i j K => obtain ⟨h1, h2⟩ := h; simp only [idx, Synth.LOp.inv]; unfold bsIdx; split_ifs <;> omega

lemma inv_idx {n : ℕ} {o : LOp} (h : o.WF n) (k : ℕ) : o.inv (o.idx k) = k := by
  cases o with
  | mv c p => simp only [idx, Synth.LOp.inv]; exact rotIdx_inv _ _ _ _
  | xch i j K => obtain ⟨h1, h2⟩ := h; simp only [idx, Synth.LOp.inv]; unfold bsIdx; split_ifs <;> omega

end LOp

lemma valid_binSh_permIdx {n : ℕ} {f : ℕ → ℕ} (hf : ∀ k < n, f k < n) {a : List ℕ}
    (ha : Valid (binSh n) a) : Valid (binSh n) (permIdx f a) :=
  valid_permIdx ha fun k hk => by
    simp only [binSh, List.length_replicate] at hk ⊢
    exact ⟨hf k hk, by simp [List.getD_eq_getElem?_getD, hf k hk, hk]⟩

lemma nodup_permIdx {n : ℕ} {o : LOp} (h : o.WF n) {arr : List ℕ} (hl : arr.length = n)
    (hnd : arr.Nodup) : (permIdx o.idx arr).Nodup := by
  rw [List.nodup_iff_injective_getElem] at hnd ⊢
  intro ⟨k, hk⟩ ⟨m, hm⟩ he
  simp only [length_permIdx] at hk hm
  simp only [getElem_permIdx] at he
  rw [List.getD_eq_getElem _ _ (by rw [hl]; exact o.idx_lt h (by omega)),
    List.getD_eq_getElem _ _ (by rw [hl]; exact o.idx_lt h (by omega))] at he
  have := hnd (a₁ := ⟨o.idx k, by rw [hl]; exact o.idx_lt h (by omega)⟩)
    (a₂ := ⟨o.idx m, by rw [hl]; exact o.idx_lt h (by omega)⟩) he
  simp only [Fin.mk.injEq] at this
  have := congrArg o.inv this
  rw [o.inv_idx h, o.inv_idx h] at this
  exact Fin.ext this

lemma getElem_permIdx_inv {n : ℕ} {o : LOp} (h : o.WF n) {arr : List ℕ} (hl : arr.length = n)
    {k : ℕ} (hk : k < n) (h' : o.inv k < (permIdx o.idx arr).length) :
    (permIdx o.idx arr)[o.inv k] = arr[k]'(by omega) := by
  rw [getElem_permIdx, o.idx_inv h, List.getD_eq_getElem]

/-- One primitive: relabelling composes with the primitive's inverse position map. -/
lemma relabel_step {n : ℕ} {o : LOp} (h : o.WF n) {init arr : List ℕ} (hl : arr.length = n)
    (hnd : arr.Nodup) (hsub : ∀ nm ∈ init, nm ∈ arr) {y : List ℕ} (hy : y.length = n) :
    relabel init arr (permIdx o.inv y) = relabel init (permIdx o.idx arr) y := by
  unfold relabel
  apply List.map_congr_left
  intro nm hnm
  have hmem := hsub nm hnm
  set k := arr.idxOf nm with hk
  have hkl : k < n := by rw [← hl]; exact List.idxOf_lt_length_iff.2 hmem
  have hak : arr[k]'(by omega) = nm := List.getElem_idxOf (by omega)
  have hlt : o.inv k < (permIdx o.idx arr).length := by
    rw [length_permIdx, hl]; exact o.inv_lt h hkl
  have hidx : (permIdx o.idx arr).idxOf nm = o.inv k := by
    rw [← hak, ← getElem_permIdx_inv h hl hkl hlt]
    exact (nodup_permIdx h hl hnd).idxOf_getElem _ _
  rw [hidx, List.getD_eq_getElem _ _ (by rw [length_permIdx, hy]; exact hkl), getElem_permIdx]

lemma relabel_self {init : List ℕ} (hnd : init.Nodup) {y : List ℕ} (hy : y.length = init.length) :
    relabel init init y = y := by
  apply List.ext_getElem (by simp [relabel, hy])
  intro k h₁ h₂
  simp only [relabel, List.getElem_map]
  rw [hnd.idxOf_getElem, List.getD_eq_getElem]

/-- **Denotation of the layout.** For well-formed primitives on `n` address bits and distinct
initial slot names, running the primitives on the records equals the single `pull` by the
relabelling from the initial to the final slot order. -/
theorem runArr_eq_pull {α : Type*} (n : ℕ) (d : α) {init : List ℕ} (hinit : init.Nodup)
    (hn : init.length = n) :
    ∀ (ops : List LOp), (∀ o ∈ ops, o.WF n) → ∀ (arr : List ℕ), arr.length = n → arr.Nodup →
      (∀ nm ∈ init, nm ∈ arr) → ∀ xs : List α,
        runArr n d ops (pull (binSh n) (binSh n) (relabel init arr) d xs) =
          pull (binSh n) (binSh n) (relabel init (applyN ops arr)) d xs
  | [], _, _, _, _, _, _ => rfl
  | o :: ops, hops, arr, hl, hnd, hsub, xs => by
    have ho := hops o (by simp)
    simp only [runArr, applyN, List.foldl_cons]
    rw [pull_comp _ _ (fun y hy => valid_binSh_permIdx (fun k hk => o.inv_lt ho hk) hy)]
    rw [pull_congr (g' := relabel init (permIdx o.idx arr)) (fun y hy => by
      simp only [Function.comp_apply]
      exact relabel_step ho hl hnd hsub (by rw [hy.length_eq]; simp [binSh]))]
    exact runArr_eq_pull n d hinit hn ops (fun o' h' => hops o' (by simp [h'])) _
      (by rw [length_permIdx, hl]) (nodup_permIdx ho hl hnd)
      (fun nm hnm => by
        have hmem := hsub nm hnm
        obtain ⟨k, hk, rfl⟩ := List.getElem_of_mem hmem
        have hlt : o.inv k < (permIdx o.idx arr).length := by
          rw [length_permIdx, hl]; exact o.inv_lt ho (by omega)
        rw [← getElem_permIdx_inv ho hl (by omega) hlt]; exact List.getElem_mem _) xs

theorem runArr_eq_pull_init {α : Type*} (n : ℕ) (d : α) {init : List ℕ} (hinit : init.Nodup)
    (hn : init.length = n) (ops : List LOp) (hops : ∀ o ∈ ops, o.WF n) {xs : List α}
    (hxs : xs.length = 2 ^ n) :
    runArr n d ops xs = pull (binSh n) (binSh n) (relabel init (applyN ops init)) d xs := by
  have hvol : vol (binSh n) = 2 ^ n := by simp [binSh, vol]
  conv_lhs => rw [← pull_id (sh := binSh n) d (by rw [hxs, hvol] : xs.length = vol (binSh n))]
  rw [← runArr_eq_pull n d hinit hn ops hops init hn hinit (fun _ h => h)]
  congr 1
  apply pull_congr
  intro y hy
  exact (relabel_self hinit (by simp only [id]; rw [hy.length_eq]; simp [binSh, hn])).symm

lemma getD_append_eq (l l' : List ℕ) (k : ℕ) :
    (l ++ l').getD k 0 = if k < l.length then l.getD k 0 else l'.getD (k - l.length) 0 := by
  split_ifs with h
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_left h, List.getD_eq_getElem?_getD]
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (Nat.le_of_not_lt h),
      List.getD_eq_getElem?_getD]

lemma getD_single (x k : ℕ) (hk : k < 1) : [x].getD k 0 = x := by
  rw [show k = 0 by omega]; rfl

/-- A single move on a list in surgery form. -/
lemma permIdx_mv (P rest : List ℕ) {m : ℕ} (hm : m < rest.length) :
    permIdx (LOp.mv P.length (P.length + m)).idx (P ++ rest) =
      P ++ ([rest.getD m 0] ++ (rest.take m ++ rest.drop (m + 1))) := by
  apply List.ext_getElem (by simp; omega)
  intro k h₁ h₂
  have hk : k < P.length + rest.length := by simpa using h₁
  rw [getElem_permIdx, ← List.getD_eq_getElem (d := 0)]
  simp only [LOp.idx, Nat.add_sub_cancel_left, getD_append_eq, List.length_singleton,
    List.length_take, getD_drop_eq]
  unfold rotIdx
  split_ifs <;> (try simp (disch := omega) only [getD_take_eq, getD_single]) <;>
    first | omega | (congr 1; omega) | rfl

/-- **Prefix moves.** The listed slots (distinct, all outside the current prefix `P`) can be
moved one by one to just after the prefix by `|Lst|` single moves; the other slots keep
their relative order. -/
theorem prefix_moves (n : ℕ) : ∀ (Lst P rest : List ℕ), (P ++ rest).Nodup → Lst.Nodup →
    (∀ nm ∈ Lst, nm ∈ rest) → (P ++ rest).length = n →
    ∃ ops : List LOp, ops.length = Lst.length ∧ (∀ o ∈ ops, o.isMv = true) ∧
      (∀ o ∈ ops, o.WF n) ∧ applyN ops (P ++ rest) = P ++ Lst ++ rest.filter (· ∉ Lst)
  | [], P, rest, _, _, _, _ => ⟨[], rfl, by simp, by simp, by simp [applyN]⟩
  | nm :: Lst, P, rest, hnd, hL, hsub, hn => by
    have hmem := hsub nm (by simp)
    set m := rest.idxOf nm
    have hm : m < rest.length := List.idxOf_lt_length_iff.2 hmem
    have hrm : rest[m] = nm := List.getElem_idxOf hm
    have hrest : rest.Nodup := (List.nodup_append.1 hnd).2.1
    have herase : rest.eraseIdx m = rest.erase nm :=
      (List.erase_eq_eraseIdx_of_idxOf rfl).symm
    have h1 := permIdx_mv P rest hm
    rw [← List.eraseIdx_eq_take_drop_succ,
      List.getD_eq_getElem _ _ hm, hrm, herase, List.singleton_append] at h1
    obtain ⟨ops, hlen, hmv, hwf, happ⟩ := prefix_moves n Lst (P ++ [nm]) (rest.erase nm)
      (by
        have : (P ++ [nm] ++ rest.erase nm) = P ++ (nm :: rest.erase nm) := by simp
        rw [this, ← h1]
        exact nodup_permIdx (o := LOp.mv P.length (P.length + m)) ⟨by omega, by simp; omega⟩ rfl hnd)
      (List.nodup_cons.1 hL).2
      (fun nm' h' => by
        have hne : nm' ≠ nm := fun e => (List.nodup_cons.1 hL).1 (e ▸ h')
        exact (List.mem_erase_of_ne hne).2 (hsub nm' (by simp [h'])))
      (by simp at hn ⊢; rw [List.length_erase_of_mem hmem]; omega)
    refine ⟨LOp.mv P.length (P.length + m) :: ops, by simp [hlen], ?_, ?_, ?_⟩
    · intro o ho; simp at ho; rcases ho with rfl | ho
      · rfl
      · exact hmv o ho
    · intro o ho; simp at ho; rcases ho with rfl | ho
      · exact ⟨by omega, by simp at hn; omega⟩
      · exact hwf o ho
    · simp only [applyN, List.foldl_cons]
      change applyN ops (permIdx (LOp.mv P.length (P.length + m)).idx (P ++ rest)) = _
      rw [h1, show P ++ (nm :: rest.erase nm) = P ++ [nm] ++ rest.erase nm by simp, happ,
        hrest.erase_eq_filter, List.filter_filter]
      rw [List.filter_congr (q := fun x => decide (x ∉ nm :: Lst))
        (fun x _ => by by_cases h : x = nm <;> simp [h])]
      simp

/-- Exchanging two equal-length chunks in surgery form. -/
lemma permIdx_xch (P X M Y S : List ℕ) (hXY : X.length = Y.length) :
    permIdx (LOp.xch P.length (P.length + X.length + M.length) X.length).idx
        (P ++ X ++ M ++ Y ++ S) = P ++ Y ++ M ++ X ++ S := by
  apply List.ext_getElem (by simp; omega)
  intro k h₁ h₂
  rw [getElem_permIdx, ← List.getD_eq_getElem (d := 0)]
  simp only [LOp.idx, getD_append_eq, List.length_append]
  have hk : k < P.length + X.length + M.length + Y.length + S.length := by
    simp at h₁; omega
  unfold bsIdx
  split_ifs <;> first | omega | (congr 1; omega) | rfl

lemma length_flatten_uniform {K : ℕ} : ∀ (A : List (List ℕ)), (∀ c ∈ A, c.length = K) →
    A.flatten.length = A.length * K
  | [], _ => by simp
  | c :: A, h => by
    simp only [List.flatten_cons, List.length_append, List.length_cons]
    rw [h c (by simp), length_flatten_uniform A (fun c' hc' => h c' (by simp [hc']))]; ring

/-- **Selection sort by chunk exchanges.** Distinct chunks of a common length `K`, after a
prefix `P`, can be brought into any rearranged order by at most `#chunks - 1` exchanges. -/
theorem chunk_sort (n K : ℕ) : ∀ (bs tb : List (List ℕ)) (P : List ℕ), bs.Nodup → tb.Perm bs →
    (∀ c ∈ bs, c.length = K) → P.length + bs.length * K = n →
    ∃ ops : List LOp, ops.length ≤ bs.length - 1 ∧ (∀ o ∈ ops, o.isMv = false) ∧
      (∀ o ∈ ops, o.WF n) ∧ applyN ops (P ++ bs.flatten) = P ++ tb.flatten
  | [], tb, P, _, hp, _, _ => by
    rw [List.Perm.nil_eq hp.symm]; exact ⟨[], by simp, by simp, by simp, rfl⟩
  | b :: bs, tb, P, hnd, hp, hK, hn => by
    obtain ⟨t, tb', rfl⟩ : ∃ t tb', tb = t :: tb' := by
      cases tb with
      | nil => exact absurd hp.length_eq (by simp)
      | cons t tb' => exact ⟨t, tb', rfl⟩
    by_cases htb : t = b
    · subst htb
      obtain ⟨ops, hlen, hx, hwf, happ⟩ := chunk_sort n K bs tb' (P ++ t)
        (List.nodup_cons.1 hnd).2 (hp.cons_inv) (fun c hc => hK c (by simp [hc]))
        (by simp at hn ⊢; rw [hK t (by simp)]; rw [Nat.add_mul] at hn; linarith)
      refine ⟨ops, by simp; omega, hx, hwf, ?_⟩
      simp only [List.flatten_cons, ← List.append_assoc]; exact happ
    · have htmem : t ∈ bs := by
        have : t ∈ b :: bs := hp.subset (by simp)
        simp at this; tauto
      obtain ⟨A, B, rfl⟩ := List.append_of_mem htmem
      have hbK := hK b (by simp)
      have htK := hK t (by simp)
      have hAK := length_flatten_uniform A (fun c hc => hK c (by simp [hc]))
      have hperm : (b :: (A ++ t :: B)).Perm (t :: (A ++ b :: B)) :=
        ((List.perm_middle).cons b).trans ((List.Perm.swap t b _).trans
          ((List.perm_middle).symm.cons t))
      have hnd2 : (A ++ b :: B).Nodup := (List.nodup_cons.1 (hperm.nodup_iff.1 hnd)).2
      obtain ⟨ops, hlen, hx, hwf, happ⟩ := chunk_sort n K (A ++ b :: B) tb' (P ++ t) hnd2
        ((hp.trans hperm).cons_inv)
        (fun c hc => by
          rcases List.mem_append.1 hc with h | h
          · exact hK c (by simp [h])
          · rcases List.mem_cons.1 h with h | h
            · rw [h]; exact hbK
            · exact hK c (by simp [h]))
        (by simp at hn ⊢; rw [htK]; nlinarith)
      set o := LOp.xch P.length (P.length + b.length + A.flatten.length) b.length
      have hstep : permIdx o.idx (P ++ (b :: (A ++ t :: B)).flatten) =
          P ++ t ++ (A ++ b :: B).flatten := by
        have := permIdx_xch P b A.flatten t B.flatten (hbK.trans htK.symm)
        simp only [List.flatten_cons, List.flatten_append, List.append_assoc] at this ⊢
        exact this
      refine ⟨o :: ops, by simp at hlen ⊢; omega, ?_, ?_, ?_⟩
      · intro o' ho'; simp at ho'; rcases ho' with rfl | ho'
        · rfl
        · exact hx o' ho'
      · intro o' ho'; simp at ho'; rcases ho' with rfl | ho'
        · refine ⟨by omega, ?_⟩
          simp at hn; rw [hAK, hbK]; nlinarith
        · exact hwf o' ho'
      · simp only [applyN, List.foldl_cons]
        change applyN ops (permIdx o.idx (P ++ (b :: (A ++ t :: B)).flatten)) = _
        rw [hstep, happ]; simp

end Synth

end

