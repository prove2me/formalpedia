variable {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]

theorem PI.RL.W.derivation_finset_prod {ι : Type*} [DecidableEq ι] (D : Derivation R S S) (f : ι → S) (s : Finset ι) :
    D (∏ j ∈ s, f j) = ∑ i ∈ s, ∏ j ∈ s, Function.update f i (D (f i)) j := by sorry
