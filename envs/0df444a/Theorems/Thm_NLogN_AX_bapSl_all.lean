theorem NLogN.AX.bapSl_all (M : MulSpec) (p s t α kb Bi Bo mm Φ Bacc Q : ℕ) (hM : MulBnd M mm Φ)
    (H : BapHyp p s t α kb Bi Bo mm Bacc Q) (st : IState HS) (x : List (ℤ × ℤ)) (R : List Item)
    (hC : CtxB p s t α kb st) (hx : x.length = t ∧ GB Bi x) (hI : st.G bI = gints x ++ R) :
    bapSlP.run st = (st.upd bI R).upd bO (gints (bapL p s t α x) ++ st.G bO) ∧
      bapSlP.ok M st ∧ bapSlP.cost M st ≤ bapSlC p s t α kb mm Φ Bacc Q := by sorry
