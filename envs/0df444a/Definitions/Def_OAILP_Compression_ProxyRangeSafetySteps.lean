open RangeKernel

def rangeHeadBits (B fuel : ℕ) : ℕ := 10^9*(B+4) + 8*(B+fuel+8)

def rangeRegisterBound (B fuel : ℕ) : ℕ := 10^9 * rangeHeadBits B fuel

