  have h2 := Ex.zsz_eval_le s B e h
  simp only [moveCost]; nlinarith

/-- Two register-program results agree when all their stacks agree. -/
theorem run_ext {p : RS} {s t : IState HS} (h : ∀ j, (p.run s).G j = t.G j) (hip : s.ip = t.ip)
