theorem scaleZP_run (p k Bz : ℕ) (x y : ℤ) (hx : |x| < 2 ^ Bz) (hy : |y| < 2 ^ Bz)
    (s : IState HS) (L10 L11 L12 L13 L14 : List Item)
    (h10 : s.G 10 = .int p :: L10) (h11 : s.G 11 = .int k :: L11) (h12 : s.G 12 = .int x :: L12)
    (h13 : s.G 13 = .int y :: L13) (h14 : s.G 14 = .int Bz :: L14) :
    scaleZP.run s = (s.upd 15 (.int (scaleZ p k (x, y)).1 :: s.G 15)).upd 16
      (.int (scaleZ p k (x, y)).2 :: s.G 16) := by
  simp only [scaleZP, NLogN.RS.seqL, NLogN.RS.run_seq]
  rw [scSt_eq p k Bz x y s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14, run_ite',
    scCond_eval s p k x y h10, scaleZ_eq]
  by_cases hc : (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) ≤ 2 ^ (p + p)
  · have hc' : ¬ (2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) < 0) := by omega
    rw [if_neg hc', if_pos hc]
    simp only [scaleElse, NLogN.RS.seqL, NLogN.RS.run_seq]
    apply IState.ext' _ (by simp [NLogN.scSt]) (by simp [NLogN.scSt])
    intro j
    simp (config := {decide := true}) only [NLogN.scSt, RS.run_push_G, RS.run_pop_G, IState.upd_G,
      Ex.eval, IState.top, if_true, if_false, List.tail_cons]
    split_ifs <;> simp_all
  · have hc' : 2 ^ (p + p) + -(2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)) < 0 := by omega
    rw [if_pos hc', if_neg hc]
    simp only [scaleThen, NLogN.RS.seqL, NLogN.RS.run_seq]
    rw [(scaleThen_run p k Bz x y hx hy s L10 L11 L12 L13 L14 h10 h11 h12 h13 h14).2.1]
    have hpos : (0 : ℤ) < ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
      have : 0 < (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
        have : (0 : ℤ) < 2 ^ (p + p) := by positivity
        omega
      exact_mod_cast ceilSqrt_pos _ this
    apply IState.ext' _ (by simp [NLogN.scSt, scSt2]) (by simp [NLogN.scSt, scSt2])
    intro j
    have t43 : (scSt2 s k Bz x y).top 43 = ceilSqrt (2 ^ k * x * (2 ^ k * x) + 2 ^ k * y * (2 ^ k * y)).toNat := by
      simp (config := {decide := true}) [scSt2, NLogN.scSt, IState.top, IState.upd_G]
    simp (config := {decide := true}) only [RS.run_push_G, RS.run_pop_G, IState.upd_G]
    rw [tdivE_eval _ _ _ (by
      simp only [Ex.eval]
      first
        | (rw [t43]; exact hpos)
        | (rw [top_push_ne _ _ _ _ (by decide), t43]; exact hpos))]
    rw [tdivE_eval _ _ _ (by
      simp only [Ex.eval]
      first
        | (rw [t43]; exact hpos)
        | (rw [top_push_ne _ _ _ _ (by decide), t43]; exact hpos))]
    simp (config := {decide := true}) only [scSt2, NLogN.scSt, RS.run_push_G, RS.run_pop_G,
      IState.upd_G, Ex.eval, IState.top, if_true, if_false, List.tail_cons, h10,
      Int.toNat_natCast]
    split_ifs <;> simp_all

