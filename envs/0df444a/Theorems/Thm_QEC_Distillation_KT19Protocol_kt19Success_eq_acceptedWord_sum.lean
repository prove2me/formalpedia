theorem QEC.Distillation.KT19Protocol.kt19Success_eq_acceptedWord_sum
    (R : CubicRowFamily q Logical Stabilizer Site)
    (mu : ZMod q → ℝ) (hmu_nonneg : ∀ a : ZMod q, 0 ≤ mu a)
    (hmu_sum : ∑ a : ZMod q, mu a = 1) :
    kt19Success R mu hmu_nonneg hmu_sum =
      ∑ error ∈ Finset.univ.filter (kt19AcceptedWord R),
        wordProbability q mu error := by sorry
