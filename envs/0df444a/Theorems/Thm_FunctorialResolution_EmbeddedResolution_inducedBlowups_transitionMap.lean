theorem FunctorialResolution.EmbeddedResolution.inducedBlowups_transitionMap (S : EmbeddedBlowupSequence k Y pY) (h : S.TransitionsAreBlowups) {a b : ℕ}
    (hab : a ≤ b) : (S.inducedBlowups h).transitionMap hab = S.totalMapOfLE hab := by sorry
