theorem centerA_covers_slope {s : ℝ} (hs : s ∈ Icc (centerT) (centerT)) :
    ∃ a : ℝ, E8TAxisProd0001PaddedInputs.centerAInput.alpha.Contains a ∧
      0 < a ∧ Y a = s := by
