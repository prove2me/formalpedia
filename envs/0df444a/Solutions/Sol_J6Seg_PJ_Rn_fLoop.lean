theorem Fx.of {Q kk m mw cB : ℕ} {u u' : Vr} (h : Fx Q kk m mw cB u)
    (h' : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), u' j = u j) : Fx Q kk m mw cB u' := by
  obtain ⟨a, b, c, d, e, f⟩ := h
