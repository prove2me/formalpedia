theorem ModularCurve.exists_mem_eisensteinIdeal_heckeProj_eq_eisensteinNumerator (p : ℕ) [Fact p.Prime] (hIB : CuspForm.HasIntegralBasis p) : ∃ i ∈ eisensteinIdeal p, heckeProj p i = algebraMap ℤ (CuspForm.heckeAlgebra p 2 ∅) (eisensteinNumerator p : ℤ) := by sorry
