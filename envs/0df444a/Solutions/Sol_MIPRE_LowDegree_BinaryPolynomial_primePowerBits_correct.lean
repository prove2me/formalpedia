namespace MIPRE.LowDegree.BinaryPolynomial
section
open Cost
/-- The polynomial used by Shoup's contract reads the same coefficient bits. -/
theorem coeff_polyOfBits (l : BitStr) (i : ℕ) :
    (polyOfBits l).coeff i = ofBool (l.getD i false) := by
  simp only [polyOfBits, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial]
  rw [Finset.sum_ite_eq']
  by_cases hi : i < l.length
  · simp [hi, ofBool]
  · simp [hi, ofBool, List.getD_eq_getElem?_getD]
end
end MIPRE.LowDegree.BinaryPolynomial

namespace MIPRE.LowDegree.BinaryPolynomial
section
open Cost
theorem polyOfBits_cons (b : Bool) (l : BitStr) :
    polyOfBits (b :: l) = Polynomial.C (ofBool b) + Polynomial.X * polyOfBits l := by
  ext i
  cases i <;> simp [coeff_polyOfBits, Polynomial.coeff_X_mul]
end
end MIPRE.LowDegree.BinaryPolynomial

namespace MIPRE.LowDegree.BinaryArtinSchreier
noncomputable section
open Cost Cost.PolyTimeFun BinaryPolynomial Polynomial
/-- Every output is in canonical nonzero coefficient form. -/
theorem powerTwoBits_getLast (u : Unary) : (powerTwoBits u).getLastD false = true := by
  unfold powerTwoBits
  split <;> simp
end
end MIPRE.LowDegree.BinaryArtinSchreier

namespace MIPRE.LowDegree.BinaryPolynomial
noncomputable section
open Cost Cost.PolyTimeFun Polynomial DegreeArithmetic
/-- Degree one has the fixed irreducible polynomial `X`. -/
theorem polyOfBits_X : polyOfBits [false, true] = (X : (ZMod 2)[X]) := by
  simp only [polyOfBits_cons, show polyOfBits [] = 0 from rfl, ofBool,
    Bool.false_eq_true, ↓reduceIte, C_0, C_1, mul_zero, add_zero, mul_one, zero_add]
end
end MIPRE.LowDegree.BinaryPolynomial

/-! The uploaded declaration as `solution` (a root name declared inside the source's
namespace, so that names resolve as they do in the source). -/
namespace MIPRE.LowDegree.BinaryPolynomial
open Cost Cost.PolyTimeFun Polynomial DegreeArithmetic
theorem _root_.solution (q e : ℕ) (he : e = 0 ∨ q.Prime) :
    let a := primePowerBits (unary q) (unary (q ^ e))
    a.getLastD false = true ∧ (polyOfBits a).Monic ∧ Irreducible (polyOfBits a) ∧
      (polyOfBits a).natDegree = q ^ e := by
  cases e with
  | zero =>
    simp only [primePowerBits, length_unary, pow_zero, ↓reduceIte, polyOfBits_X,
      List.getLastD_cons]
    exact ⟨rfl, monic_X, irreducible_X, natDegree_X⟩
  | succ e =>
    have hq : q.Prime := he.resolve_left (by omega)
    have hr : q ^ (e + 1) ≠ 1 := ne_of_gt (one_lt_pow₀ hq.one_lt (by omega))
    by_cases hq2 : q = 2
    · subst q
      simp only [primePowerBits, length_unary, hr, ↓reduceIte]
      exact ⟨BinaryArtinSchreier.powerTwoBits_getLast _,
        BinaryArtinSchreier.powerTwoBits_correct (e + 1)⟩
    · simpa only [primePowerBits, length_unary, hr, hq2, ↓reduceIte] using
        oddPrimePowerBits_correct q e hq hq2
end MIPRE.LowDegree.BinaryPolynomial
