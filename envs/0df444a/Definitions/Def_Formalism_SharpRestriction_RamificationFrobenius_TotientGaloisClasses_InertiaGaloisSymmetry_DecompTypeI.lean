structure HostCore {φ : Frame} (H : HostRaw φ) : Prop where
  art_surj : Function.Surjective H.art
  cm : IsCMField H.E
  conj_iff : ∀ (ψ : H.E →+* ℂ) (σ : H.E ≃ₐ[ℚ] H.E), (∀ x, ψ (σ x) = starRingEnd ℂ (ψ x)) ↔ H.gal σ = φ.cc
