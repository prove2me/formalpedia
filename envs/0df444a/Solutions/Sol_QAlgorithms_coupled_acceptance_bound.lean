theorem norm_sub_sq_le_two {E : Type*} [SeminormedAddCommGroup E] (x y : E) :
    ‖x - y‖ ^ 2 ≤ 2 * ‖x‖ ^ 2 + 2 * ‖y‖ ^ 2 := by
  calc
    ‖x - y‖ ^ 2 ≤ (‖x‖ + ‖y‖) ^ 2 := by
      gcongr
      exact norm_sub_le x y
    _ ≤ 2 * ‖x‖ ^ 2 + 2 * ‖y‖ ^ 2 := by nlinarith [sq_nonneg (‖x‖ - ‖y‖)]

theorem norm_sq_le_two_add_sub {E : Type*} [SeminormedAddCommGroup E] (x y : E) :
    ‖x‖ ^ 2 ≤ 2 * ‖y‖ ^ 2 + 2 * ‖x - y‖ ^ 2 := by
  simpa only [sub_sub_cancel, norm_sub_rev] using norm_sub_sq_le_two y (y - x)

theorem probEvent_le_two_add {Z : Type*} [Fintype Z] [DecidableEq Z]
    (ψ φ : EuclideanSpace ℂ Z) (acc : Z → Prop) [DecidablePred acc] :
    probEvent ψ acc ≤ 2 * probEvent φ acc + 2 * ‖ψ - φ‖ ^ 2 := by
  simp only [probEvent, prob, QAlgorithms.ket, EuclideanSpace.inner_single_left,
    map_one, one_mul]
  have hrest : (∑ z ∈ Finset.univ.filter acc, ‖ψ z - φ z‖ ^ 2) ≤ ‖ψ - φ‖ ^ 2 := by
    rw [EuclideanSpace.norm_sq_eq]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
      (fun z _ _ => sq_nonneg _)
  calc
    (∑ z ∈ Finset.univ.filter acc, ‖ψ z‖ ^ 2) ≤
        ∑ z ∈ Finset.univ.filter acc, (2 * ‖φ z‖ ^ 2 + 2 * ‖ψ z - φ z‖ ^ 2) :=
      Finset.sum_le_sum fun z _ => norm_sq_le_two_add_sub _ _
    _ = 2 * (∑ z ∈ Finset.univ.filter acc, ‖φ z‖ ^ 2) +
        2 * (∑ z ∈ Finset.univ.filter acc, ‖ψ z - φ z‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ _ := by linarith

section Oracle

variable {ι κ W : Type*} [Fintype ι] [Fintype κ] [Fintype W]
  [DecidableEq ι] [DecidableEq κ] [DecidableEq W] [AddCommGroup κ]

theorem query_filtered_mass_eq (f : ι → κ) (ψ : EuclideanSpace ℂ ((ι × κ) × W))
    (P : ι → Prop) [DecidablePred P] :
    (∑ z : (ι × κ) × W, if P z.1.1 then
      ‖act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ)) ψ z‖ ^ 2 else 0) =
    ∑ z : (ι × κ) × W, if P z.1.1 then ‖ψ z‖ ^ 2 else 0 := by
  simp only [act_xor_eq_perm, act_perm_apply]
  exact (queryPerm (W := W) f).symm.sum_comp
    (fun z : (ι × κ) × W => if P z.1.1 then ‖ψ z‖ ^ 2 else 0)

theorem xor_disagreement_sq (f g : ι → κ) (ψ : EuclideanSpace ℂ ((ι × κ) × W)) :
    ‖act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ)) ψ -
      act (Matrix.kronecker (xorOracle g) (1 : Matrix W W ℂ)) ψ‖ ^ 2 ≤
      4 * ∑ z : (ι × κ) × W, if f z.1.1 ≠ g z.1.1 then ‖ψ z‖ ^ 2 else 0 := by
  let u := act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ)) ψ
  let v := act (Matrix.kronecker (xorOracle g) (1 : Matrix W W ℂ)) ψ
  have hpoint : ∀ z : (ι × κ) × W, ‖u z - v z‖ ^ 2 ≤
      2 * (if f z.1.1 ≠ g z.1.1 then ‖u z‖ ^ 2 else 0) +
      2 * (if f z.1.1 ≠ g z.1.1 then ‖v z‖ ^ 2 else 0) := by
    rintro ⟨⟨i, y⟩, w⟩
    by_cases h : f i = g i
    · dsimp only [u, v]
      simp only [act_xor_tensor_apply, h]
      simp
    · simp only [h, ne_eq, not_false_eq_true, if_true]
      exact norm_sub_sq_le_two _ _
  change ‖u - v‖ ^ 2 ≤ _
  rw [EuclideanSpace.norm_sq_eq]
  calc
    (∑ z, ‖(u - v) z‖ ^ 2) ≤
        ∑ z, (2 * (if f z.1.1 ≠ g z.1.1 then ‖u z‖ ^ 2 else 0) +
          2 * (if f z.1.1 ≠ g z.1.1 then ‖v z‖ ^ 2 else 0)) :=
      Finset.sum_le_sum fun z _ => hpoint z
    _ = 2 * (∑ z, if f z.1.1 ≠ g z.1.1 then ‖u z‖ ^ 2 else 0) +
        2 * (∑ z, if f z.1.1 ≠ g z.1.1 then ‖v z‖ ^ 2 else 0) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ = _ := by
      dsimp only [u, v]
      rw [query_filtered_mass_eq f ψ (fun i => f i ≠ g i),
        query_filtered_mass_eq g ψ (fun i => f i ≠ g i)]
      ring

theorem query_norm (f : ι → κ) (ψ : EuclideanSpace ℂ ((ι × κ) × W)) :
    ‖act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ)) ψ‖ = ‖ψ‖ := by
  rw [act_xor_eq_perm]
  exact act_norm_of_mem_unitaryGroup (permUnitary (queryPerm (W := W) f)).property ψ

theorem stateAt_unit {q : ℕ} (A : QueryAlg ι κ W q) (f : ι → κ)
    (i : Fin (q + 1)) : ‖A.stateAt (xorOracle f) i‖ = 1 := by
  induction i using Fin.induction with
  | zero =>
    change ‖act (A.U 0 : Matrix _ _ ℂ) A.start‖ = 1
    rw [act_norm_of_mem_unitaryGroup (A.U 0).property, A.start_unit]
  | succ i ih =>
    change ‖act (A.U i.succ : Matrix _ _ ℂ)
      (act (Matrix.kronecker (xorOracle f) (1 : Matrix W W ℂ))
        (A.stateAt (xorOracle f) i.castSucc))‖ = 1
    rw [act_norm_of_mem_unitaryGroup (A.U i.succ).property, query_norm, ih]

