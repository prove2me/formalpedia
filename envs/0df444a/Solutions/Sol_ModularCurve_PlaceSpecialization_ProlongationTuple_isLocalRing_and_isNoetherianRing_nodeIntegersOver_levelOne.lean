    IsLocalRing ↥(R.nodeIntegersOver K w) ∧ IsNoetherianRing ↥(R.nodeIntegersOver K w) := by
  classical

  have hC := fun f => R.mem_modularLocalizedAtPoint_iff_exists_mem_nodeIntegersOver hmodel W hW hreg K w hw a ha x hx f

  obtain ⟨ϖ, hϖ⟩ := ModularCurve.Loc1.exists_uniformizer red K q
  obtain ⟨hnoeth, hloc, -, -⟩ :=
    ModularCurve.NodeLocalized.isNoetherianRing_isLocalRing_modularLocalizedAtPoint_coeffSubring red a K x hx ϖ hϖ

  set S := R.nodeIntegersOver K w with hSdef
  set R₀ := modularLocalizedAtPoint (1 * q) (coeffSubring A K) (redRestrict red K) a (a ^ q) with hR₀def
  let φ : ↥S →+* LaurentSeries (AlgebraicClosure ℚ) :=
    ((modularFunctionFieldBar (1 * q)).val.toRingHom).comp S.subtype
  have hφ : ∀ g : ↥S, φ g = ((g : ↥(modularFunctionFieldBar (1 * q))) : LaurentSeries (AlgebraicClosure ℚ)) := fun g => rfl
  have hφinj : Function.Injective φ := by
    intro g g' h
    rw [hφ, hφ] at h
    exact Subtype.ext (Subtype.ext h)
  have hφmem : ∀ g : ↥S, φ g ∈ R₀ := fun g => (hC (φ g)).mpr ⟨(g : ↥(modularFunctionFieldBar (1 * q))), g.2, (hφ g).symm⟩

  let ψ : ↥S →+* ↥R₀ := φ.codRestrict R₀ hφmem
  have hψbij : Function.Bijective ψ := by
    constructor
    · intro g g' h
      exact hφinj (show φ g = φ g' from congrArg (fun z : ↥R₀ => (z : LaurentSeries (AlgebraicClosure ℚ))) h)
    · intro f
      obtain ⟨g, hg, hgf⟩ := (hC (f : LaurentSeries (AlgebraicClosure ℚ))).mp f.2
      exact ⟨⟨g, hg⟩, Subtype.ext hgf⟩
  let e : ↥S ≃+* ↥R₀ := RingEquiv.ofBijective ψ hψbij
  haveI := hnoeth
  haveI := hloc
  refine ⟨?_, ?_⟩
  · exact IsLocalRing.of_surjective' (e.symm : ↥R₀ →+* ↥S) e.symm.surjective
