    show ModularCurve.jqNModC L (q * ℓ) = _
    rw [hcoeffEmb_qExpand, hcoeffEmb_jq]; rfl
  have hjOf_eq' : (jOfK : LaurentSeries L) =
      ModularCurve.qExpand L ℓ (ModularCurve.qExpand L q (ModularCurve.coeffEmb L ModularCurve.jq)) := by
    show ModularCurve.jqNModC L (q * ℓ) = _
    rw [ModularCurve.qExpand_qExpand, hcoeffEmb_jq, ModularCurve.jqNModC]
    exact ModularCurve.qExpand_congr (mul_comm q ℓ) _

