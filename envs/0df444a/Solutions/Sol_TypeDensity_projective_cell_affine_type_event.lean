    MeasurableSet (TypeDensity.projectiveCell O n (TypeDensity.divisorVector (IsLocalRing.ResidueField O) n D) ∩
      TypeDensity.affineTypeEvent O n σ) ∧ TypeDensity.cellMeasure O (n+1) (TypeDensity.projectiveCell O n
      (TypeDensity.divisorVector (IsLocalRing.ResidueField O) n D)) (TypeDensity.affineTypeEvent O n σ) = TypeDensity.densityValue
      (TypeDensity.lawCoeff (TypeDensity.arrayLaw m) σ) (Nat.card (IsLocalRing.ResidueField O)) := by
  obtain ⟨_, _, _, _, hGμ, _, hG0⟩ := TypeDensity.divisor_vector_properties (IsLocalRing.ResidueField O) n D hD
  set G := TypeDensity.divisorVector (IsLocalRing.ResidueField O) n D with hG
  set μ : Fin (n+1) := ⟨n - D (TypeDensity.infinityDirection (IsLocalRing.ResidueField O)), by omega⟩ with hμ
  obtain ⟨hPCm, _⟩ := TypeDensity.projective_cell_mass O htop n G hG0
  obtain ⟨hmaps, _, _, hmp⟩ := TypeDensity.projective_cell_normalization_pushforward O htop n G μ hGμ
  obtain ⟨hEm, hEv⟩ := TypeDensity.divisor_form_cell_law hroot O htop n D hD m hm σ
  have hscale := (TypeDensity.affine_type_event_unit_scaling O n σ).2 G μ hGμ
  have hset : TypeDensity.projectiveCell O n G ∩ TypeDensity.affineTypeEvent O n σ
      = TypeDensity.projectiveCell O n G ∩ (TypeDensity.projectiveNormalize O n G μ ⁻¹'
          (TypeDensity.reducedFormCell O n μ G ∩ TypeDensity.insertOne μ ⁻¹' TypeDensity.affineTypeEvent O n σ)) := by
    ext a
    simp only [Set.mem_inter_iff, Set.mem_preimage]
    constructor
    · rintro ⟨ha, hb⟩
      exact ⟨ha, hmaps ha, (hscale a ha).2 hb⟩
    · rintro ⟨ha, _, hb⟩
      exact ⟨ha, (hscale a ha).1 hb⟩
  refine ⟨?_, ?_⟩
  · rw [hset]
    exact hPCm.inter (hmp.measurable hEm)
  · have hDc := (TypeDensity.normalized_form_cell_cylinder_mass O htop n μ G hGμ).2.2.2.1
    rw [← TypeDensity.cellMeasure_cell_inter hPCm, hset, TypeDensity.cellMeasure_cell_inter hPCm,
