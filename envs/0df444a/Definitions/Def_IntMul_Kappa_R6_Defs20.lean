theorem sclean_of_lt {σ : Fin HS → Option ℤ} (h : ∀ i v, σ i = some v → i.val < 56) :
    SClean σ := by
  intro i hi hz
  obtain ⟨v, hv⟩ := Option.isSome_iff_exists.1 hi
  have := h i v hv
  simp only [zX, ExSt.all, List.mem_cons, List.not_mem_nil, or_false] at hz
