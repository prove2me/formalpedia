    (hx : RecRep (2 ^ ℓ) p zs xs) (hl : xs.length = 2 ^ n) (hb : NLogN.KFB.GB W zs) :
    RecRep (2 ^ ℓ) p (zs.map (gtr 0)) (QpArr p xs) ∧ NLogN.KFB.GB W (zs.map (gtr 0)) ∧
      IRuns I iprog (fcode truncTop) (encK s (o0 (gflat zs ++ l)))
        (encK s (o0 (gflat (zs.map (gtr 0)) ++ l))) (cTruncTop n ℓ W B) := by
  have hz : zs.length = 2 ^ n * 2 ^ ℓ := by rw [hx.1, hl]
