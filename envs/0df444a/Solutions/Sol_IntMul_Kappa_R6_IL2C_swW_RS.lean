section
-- Source module: Solutions.R6IL2CPhase
/-!
# Round six, compact controls (I2C): the compact phase as record steps

The ten table rotations (`rotYA`, `rotYB` on `Y`; `rotS`, `rotC`, `rotL ±1` on `Bk`) and the
twelve Lemma 12 swaps (`swT`, `swU`: the compact fields `T`, `U` with `Bk`) of the compact
program, with all parameters read from the registers of `CEnv`, as `RecStep`s:

* `phaseC_step`: one phase is `l.stepP phInv`;
* `psiC_step`: phase, load, phase, unload is `l.stepP Psi`;
* `compactC_step`: followed by the correction it is `l.stepP TlS` (exactly).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel AModelL12

/-! ## Generic rotation and swap steps -/

section Gen

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {E : IState HS → Prop} {M Br Bb : ℕ}

theorem swRS {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) {P Mid u : ℕ} (hu : 1 ≤ u) (hP : 0 < P)
    (hMid : 0 < Mid) (hBr : 0 < Br) (hM : P * 2 ^ u * Mid * 2 ^ u * 1 = M)
    (hBb : Bb ≤ zsz ((M * Br : ℕ) : ℤ) + 3) {eP eG eS eU : Ex HS}
    (hsz : eP.size + eG.size + eS.size + eU.size ≤ 50)
    (nP : KFX.NoK eP) (nG : KFX.NoK eG) (nS : KFX.NoK eS) (nU : KFX.NoK eU)
    (E1 : ∀ t, E t → ESp eP t Bb (P : ℤ)) (E2 : ∀ t, E t → ESp eG t Bb (Mid : ℤ))
    (E3 : ∀ t, E t → ESp eS t Bb ((1 * Br : ℕ) : ℤ)) (E4 : ∀ t, E t → ESp eU t Bb (u : ℤ)) :
    RecStep I tab (IL2.swE l12 eP eG eS eU) E M Br (swP (2 ^ u) (Mid * 2 ^ u * 1) 1)
      (Ksw * (((M * Br : ℕ) : ℝ) + 1) * (u : ℝ) ^ τ) := by
  intro t recs R0 ht hl hb h0
  rw [← hM] at h0 ⊢ hBb
  obtain ⟨c, Hc, hc⟩ := swRec_runs H hu hP hMid Nat.one_pos hBr I t hl (bits_flR hb _) R0 h0
    eP eG eS eU Bb hBb hsz nP nG nS nU (E1 t ht) (E2 t ht) (E3 t ht) (E4 t ht)
  exact ⟨c, Hc, hc⟩

end Gen

/-! ## The layout facts of the compact phase -/

namespace PhOK

variable {l : Lay} {K ρ G n L Br : ℕ} (hP : PhOK l K ρ G n L Br)
include hP

theorem ok : l.OK := hP.kv.ok
theorem qc2 : l.QC = 2 ^ (n * G) := by rw [hP.kv.qc, Qc, ← pow_mul, mul_comm]

theorem z3 {v : ℕ} (h : v ≤ 3 * l.M) : zsz (v : ℤ) ≤ zsz ((l.M * Br : ℕ) : ℤ) + 3 := hP.kv.zn h

theorem ngM : n * G ≤ l.M := by
  have h1 : n * G < 2 ^ (n * G) := Nat.lt_two_pow_self
  have h2 : l.QC ≤ l.M := le_trans hP.kv.qcQL hP.kv.qlM
  rw [hP.qc2] at h2; omega

end PhOK

/-! ## The register expressions -/

/-! ## The steps -/

section Steps

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}
  {l : Lay} {K ρ G n L q Br : ℕ} {fl : ℤ}

theorem sp_reg {t : IState HS} {r : Fin HS} {v : ℕ} (h : ∃ L, t.G r = .int (v : ℤ) :: L)
    (hr : r.val < 56) {Bb : ℕ} (hz : zsz (v : ℤ) ≤ Bb) : ESp (.reg r) t Bb (v : ℤ) := by
  obtain ⟨L, hL⟩ := h; exact ESp.ofG' hL hr hz

variable (hP : PhOK l K ρ G n L Br)
include hP

/-- **The swap of a compact field** (stride `s = Mid QC`, on register `r`) with `Bk`. -/
theorem swW_RS_sol_aux {Ksw : ℝ} (H : SwOK tab l12 τ Ksw) (hnG : 1 ≤ n * G) {r : Fin HS} {s P Mid : ℕ}
    (hr : r = kSU ∨ r = kST)
    (hreg : ∀ t, CEnv t l K ρ G n q Br fl → ∃ L, t.G r = .int (s : ℤ) :: L)
    (hs : s = Mid * l.QC) (hM : l.M = P * l.QC * s) (hP0 : 0 < P) (hMid : 0 < Mid) :
    RecStep I tab (swW l12 r) (fun t => CEnv t l K ρ G n q Br fl) l.M Br (swP l.QC s 1)
      (cW Ksw τ l n G Br) := by
  have hqc := hP.qc2
  have hQ0 : 0 < l.QC := hP.ok.qc
  have hs0 : 0 < s := by rw [hs]; positivity
  have hS0 : 0 < l.QC * s := by positivity
  have hQSM : l.QC * s ≤ l.M := by
    rw [hM, show P * l.QC * s = P * (l.QC * s) by ring]; exact Nat.le_mul_of_pos_left _ hP0
  have hsM : s ≤ l.M := le_trans (Nat.le_mul_of_pos_left _ hQ0) hQSM
  have hQM : l.QC ≤ l.M := le_trans (Nat.le_mul_of_pos_right _ hs0) hQSM
  have hMM : P * 2 ^ (n * G) * Mid * 2 ^ (n * G) * 1 = l.M := by rw [hM, hs, ← hqc]; ring
  have hrr : r.val < 56 := by rcases hr with rfl | rfl <;> decide
  have hsz : (eWP r).size + (eWM r).size + (Ex.reg kBr : Ex HS).size +
      (Ex.reg kNG : Ex HS).size ≤ 50 := by rcases hr with rfl | rfl <;> decide
  have nP : KFX.NoK (eWP r) := by rcases hr with rfl | rfl <;> (unfold KFX.NoK; decide)
  have nG : KFX.NoK (eWM r) := by rcases hr with rfl | rfl <;> (unfold KFX.NoK; decide)
  have nS : KFX.NoK (Ex.reg kBr : Ex HS) := by unfold KFX.NoK; decide
  have nU : KFX.NoK (Ex.reg kNG : Ex HS) := by unfold KFX.NoK; decide
  have ePv : l.M / (l.QC * s) = P := by
    rw [hM, show P * l.QC * s = (l.QC * s) * P by ring, Nat.mul_div_cancel_left _ hS0]
  have eMv : s / l.QC = Mid := by rw [hs, Nat.mul_div_cancel _ hQ0]
  have hPM : P ≤ l.M := by rw [← ePv]; exact Nat.div_le_self _ _
  have hMidM : Mid ≤ l.M := by rw [← eMv]; exact le_trans (Nat.div_le_self _ _) hsM
  have h := swRS (I := I) (E := fun t => CEnv t l K ρ G n q Br fl)
    (Bb := zsz ((l.M * Br : ℕ) : ℤ) + 3) H hnG hP0 hMid (by have := hP.br; omega) hMM le_rfl
    hsz nP nG nS nU
    (fun t ht => by
      rw [← ePv]
      exact ESp.ndivN (sp_reg ht.m (by decide) (hP.z3 (by omega)))
        (ESp.mulN (sp_reg ht.key.qc (by decide) (hP.z3 (by omega)))
          (sp_reg (hreg t ht) hrr (hP.z3 (by omega))) (hP.z3 (by push_cast; omega)))
        hS0 (hP.z3 (by rw [ePv]; omega)))
    (fun t ht => by
      rw [← eMv]
      exact ESp.ndivN (sp_reg (hreg t ht) hrr (hP.z3 (by omega)))
        (sp_reg ht.key.qc (by decide) (hP.z3 (by omega))) hQ0 (hP.z3 (by rw [eMv]; omega)))
    (fun t ht => by
      rw [one_mul]
      exact sp_reg ht.br (by decide) (hP.zB (by nlinarith [hP.br, show 1 ≤ l.M by omega])))
    (fun t ht => sp_reg ht.ng (by decide) (hP.z3 (by have := hP.ngM; omega)))
  rw [← hqc, mul_one, ← hs] at h
  exact h

end Steps

end IntMul.Kappa.R6.IL2C

end

theorem solution : type_of% @IntMul.Kappa.R6.IL2C.swW_RS_sol_aux := @IntMul.Kappa.R6.IL2C.swW_RS_sol_aux
