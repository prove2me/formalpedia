/-- the history σ-algebra generated by `ε 1, …, ε n`. -/
def F {Ω : Type*} (ε : ℕ → Ω → ℝ) (n : ℕ) : MeasurableSpace Ω :=
  ⨆ i ∈ Set.Icc 1 n, MeasurableSpace.comap (ε i) inferInstance

lemma F_mono {Ω : Type*} (ε : ℕ → Ω → ℝ) {m n : ℕ} (h : m ≤ n) : F ε m ≤ F ε n := by
  unfold F
  exact biSup_mono (fun i hi => ⟨hi.1, le_trans hi.2 h⟩)

lemma eps_measF {Ω : Type*} (ε : ℕ → Ω → ℝ) {i n : ℕ} (h1 : 1 ≤ i) (h2 : i ≤ n) :
    Measurable[F ε n] (ε i) := by
  rw [measurable_iff_comap_le]
  unfold F
  exact le_iSup₂_of_le (f := fun j (_ : j ∈ Set.Icc 1 n) =>
    MeasurableSpace.comap (ε j) inferInstance) i ⟨h1, h2⟩ le_rfl

lemma priceAux_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (n : ℕ) :
    Measurable[F ε n] (fun ω => priceAux π β ε ω n) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    have h : (fun ω => priceAux π β ε ω n) = fun ω => π.rule n (fun i : Fin n =>
        (M.DHat + β * (priceAux π β ε ω i - M.pHat) + ε ((i : ℕ) + 1) ω, priceAux π β ε ω i)) := by
      funext ω
      rw [priceAux]
    rw [h]
    letI : MeasurableSpace Ω := F ε n
    refine (π.measurable_rule n).comp (measurable_pi_lambda _ (fun i => ?_))
    have hi : Measurable[F ε n] (fun ω => priceAux π β ε ω i) :=
      (ih i i.isLt).mono (F_mono ε (le_of_lt i.isLt)) le_rfl
    have he : Measurable[F ε n] (ε ((i : ℕ) + 1)) := eps_measF ε (by omega) (by omega)
    exact ((measurable_const.add (measurable_const.mul (hi.sub_const _))).add he).prodMk hi

lemma dev_measF {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (s : ℕ) :
    Measurable[F ε (s - 1)] (fun ω => dev π β ε s ω) :=
  (priceAux_measF π β ε (s - 1)).sub_const _

lemma indep_eps {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) (ε : ℕ → Ω → ℝ)
    (hm : ∀ t, Measurable (ε t)) (hind : iIndepFun ε P) (s : ℕ) (hs : 1 ≤ s)
    {γ : Type*} [MeasurableSpace γ]
    (Y : Ω → γ) (hY : Measurable[F ε (s - 1)] Y) : IndepFun (ε s) Y P := by
  rw [IndepFun_iff_Indep]
  have h := indep_iSup_of_disjoint (m := fun i => MeasurableSpace.comap (ε i) inferInstance)
    (fun i => (hm i).comap_le) hind.iIndep (S := {s}) (T := Set.Icc 1 (s - 1))
    (by rw [Set.disjoint_singleton_left]; simp; omega)
  refine indep_of_indep_of_le_right (indep_of_indep_of_le_left h ?_) ?_
  · exact le_iSup₂_of_le (f := fun j (_ : j ∈ ({s} : Set ℕ)) =>
      MeasurableSpace.comap (ε j) inferInstance) s rfl le_rfl
  · exact hY.comap_le


lemma F_le {Ω : Type*} [MeasurableSpace Ω] (ε : ℕ → Ω → ℝ) (hm : ∀ t, Measurable (ε t))
    (n : ℕ) : F ε n ≤ ‹MeasurableSpace Ω› := by
  unfold F
  exact iSup₂_le (fun i _ => (hm i).comap_le)

lemma dev_meas {M : Model} {Ω : Type*} [MeasurableSpace Ω] (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (hm : ∀ t, Measurable (ε t)) (s : ℕ) :
    Measurable (fun ω => dev π β ε s ω) :=
  (dev_measF π β ε s).mono (F_le ε hm _) le_rfl

lemma price_mem {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (t : ℕ) (ω : Ω) : price π β ε t ω ∈ Set.Icc M.l M.u := by
  unfold price
  rw [priceAux]
  exact π.rule_mem _ _

lemma dev_abs {M : Model} {Ω : Type*} (π : Policy M) (β : ℝ)
    (ε : ℕ → Ω → ℝ) (t : ℕ) (ω : Ω) : |dev π β ε t ω| ≤ M.u - M.l := by
  have h2 := price_mem π β ε t ω
  have h3 := M.pHat_mem
  unfold dev
  simp only [Set.mem_Icc] at h2 h3
  rw [abs_le]; constructor <;> linarith


lemma exp_le_quad (x : ℝ) : Real.exp x ≤ 1 + x + x ^ 2 * Real.exp |x| := by
  have h1 : 1 ≤ Real.exp |x| := Real.one_le_exp (abs_nonneg x)
  rcases le_or_gt |x| 1 with h | h
  · have h2 := (abs_le.mp (Real.abs_exp_sub_one_sub_id_le h)).2
    nlinarith [sq_nonneg x, mul_nonneg (sq_nonneg x) (sub_nonneg.mpr h1)]
  · have h3 : Real.exp x ≤ Real.exp |x| := Real.exp_le_exp.mpr (le_abs_self x)
    have hx2 : 1 < x ^ 2 := by
      rw [← sq_abs]; nlinarith [abs_nonneg x]
    have h4 : 0 ≤ x ^ 2 + x := by
      rcases abs_cases x with ⟨hx, _⟩ | ⟨hx, _⟩ <;> nlinarith
    nlinarith [mul_nonneg (sub_nonneg.mpr hx2.le) (sub_nonneg.mpr h1)]

lemma sq_le_exp (a x : ℝ) (ha : 0 < a) : x ^ 2 ≤ 2 / a ^ 2 * Real.exp (a * |x|) := by
  have h := Real.quadratic_le_exp_of_nonneg (mul_nonneg ha.le (abs_nonneg x))
  have hy : 0 ≤ a * |x| := mul_nonneg ha.le (abs_nonneg x)
  rw [div_mul_eq_mul_div, le_div_iff₀ (by positivity)]
  have : (a * |x|) ^ 2 = a ^ 2 * x ^ 2 := by rw [mul_pow, sq_abs]
  nlinarith

lemma mgf_bound {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ) :
    ∃ K : ℝ, 0 < K ∧ ∃ l₀ : ℝ, 0 < l₀ ∧ ∀ t (l : ℝ), |l| ≤ l₀ →
      Integrable (fun ω => Real.exp (l * ε t ω)) P ∧
        ∫ ω, Real.exp (l * ε t ω) ∂P ≤ Real.exp (K * l ^ 2) := by
  obtain ⟨z₀, hz₀, hint⟩ := hε.exp_moment
  set a := z₀ / 2 with ha
  have ha0 : 0 < a := by positivity
  set K' := 2 / a ^ 2 * (∫ ω, Real.exp (z₀ * ε 0 ω) ∂P + ∫ ω, Real.exp (-z₀ * ε 0 ω) ∂P)
    with hK'
  have hK'0 : 0 ≤ K' := by
    have : 0 ≤ ∫ ω, Real.exp (z₀ * ε 0 ω) ∂P + ∫ ω, Real.exp (-z₀ * ε 0 ω) ∂P :=
      add_nonneg (integral_nonneg (fun _ => (Real.exp_pos _).le))
        (integral_nonneg (fun _ => (Real.exp_pos _).le))
    positivity
  refine ⟨K' + 1, by linarith, a, ha0, fun t l hl => ?_⟩
  have hm := hε.measurable t
  have hl' : |l| ≤ z₀ := by rw [ha] at hl; linarith
  have hI : Integrable (fun ω => Real.exp (l * ε t ω)) P := hint t l hl'
  refine ⟨hI, ?_⟩
  have hIp : Integrable (fun ω => Real.exp (z₀ * ε t ω)) P := hint t z₀ (by rw [abs_of_pos hz₀])
  have hIn : Integrable (fun ω => Real.exp (-z₀ * ε t ω)) P :=
    hint t (-z₀) (by rw [abs_neg, abs_of_pos hz₀])
  set g : Ω → ℝ := fun ω => ε t ω ^ 2 * Real.exp |l * ε t ω| with hg
  have hgb : ∀ ω, g ω ≤ 2 / a ^ 2 * (Real.exp (z₀ * ε t ω) + Real.exp (-z₀ * ε t ω)) := by
    intro ω
    have h1 := sq_le_exp a (ε t ω) ha0
    have h2 : Real.exp |l * ε t ω| ≤ Real.exp (a * |ε t ω|) := by
      apply Real.exp_le_exp.mpr
      rw [abs_mul]; exact mul_le_mul_of_nonneg_right hl (abs_nonneg _)
    have h3 : Real.exp (a * |ε t ω|) * Real.exp (a * |ε t ω|) = Real.exp (z₀ * |ε t ω|) := by
      rw [← Real.exp_add]; congr 1; rw [ha]; ring
    have h4 : Real.exp (z₀ * |ε t ω|) ≤ Real.exp (z₀ * ε t ω) + Real.exp (-z₀ * ε t ω) := by
      rcases abs_cases (ε t ω) with ⟨h, _⟩ | ⟨h, _⟩
      · rw [h]; linarith [Real.exp_pos (-z₀ * ε t ω)]
      · rw [h, show z₀ * -ε t ω = -z₀ * ε t ω by ring]; linarith [Real.exp_pos (z₀ * ε t ω)]
    have hE0 : 0 ≤ Real.exp (a * |ε t ω|) := (Real.exp_pos _).le
    calc g ω = ε t ω ^ 2 * Real.exp |l * ε t ω| := rfl
      _ ≤ (2 / a ^ 2 * Real.exp (a * |ε t ω|)) * Real.exp (a * |ε t ω|) :=
          mul_le_mul h1 h2 (Real.exp_pos _).le (by positivity)
      _ = 2 / a ^ 2 * (Real.exp (a * |ε t ω|) * Real.exp (a * |ε t ω|)) := by ring
      _ ≤ 2 / a ^ 2 * (Real.exp (z₀ * ε t ω) + Real.exp (-z₀ * ε t ω)) := by
          rw [h3]; exact mul_le_mul_of_nonneg_left h4 (by positivity)
  have hgm : Measurable g := (hm.pow_const 2).mul (((measurable_const.mul hm).abs).exp)
  have hgI : Integrable g P := Integrable.mono' ((hIp.add hIn).const_mul (2 / a ^ 2))
    hgm.aestronglyMeasurable (Filter.Eventually.of_forall (fun ω => by
      rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]; exact hgb ω))
  have hεI : Integrable (ε t) P := (hε.memLp_two t).integrable one_le_two
  have hbound : ∫ ω, g ω ∂P ≤ K' := by
    refine (integral_mono hgI ((hIp.add hIn).const_mul (2 / a ^ 2)) hgb).trans (le_of_eq ?_)
    rw [integral_const_mul]
    simp only [Pi.add_apply]
    rw [integral_add hIp hIn, hK']
    congr 2
    · exact ((hε.identDistrib t).comp (u := fun x => Real.exp (z₀ * x))
        (measurable_const.mul measurable_id).exp).integral_eq
    · exact ((hε.identDistrib t).comp (u := fun x => Real.exp (-z₀ * x))
        (measurable_const.mul measurable_id).exp).integral_eq
  have hstep : ∫ ω, Real.exp (l * ε t ω) ∂P ≤ ∫ ω, (1 + l * ε t ω + l ^ 2 * g ω) ∂P := by
    apply integral_mono hI (((integrable_const 1).add (hεI.const_mul l)).add (hgI.const_mul _))
    intro ω
    have := exp_le_quad (l * ε t ω)
    have e : (l * ε t ω) ^ 2 = l ^ 2 * ε t ω ^ 2 := by ring
    rw [e] at this
    simp only [hg, Pi.add_apply]
    linarith
  have i1 : Integrable (fun ω => 1 + l * ε t ω) P := (integrable_const 1).add (hεI.const_mul l)
  have i2 : Integrable (fun ω => l ^ 2 * g ω) P := hgI.const_mul _
  have hR : ∫ ω, (1 + l * ε t ω + l ^ 2 * g ω) ∂P = 1 + l ^ 2 * ∫ ω, g ω ∂P := by
    rw [integral_add i1 i2, integral_add (integrable_const 1) (hεI.const_mul l),
      integral_const_mul, integral_const_mul, hε.mean_zero t]
    simp
  rw [hR] at hstep
  have hfin : 1 + l ^ 2 * ∫ ω, g ω ∂P ≤ Real.exp ((K' + 1) * l ^ 2) := by
    have h1 : l ^ 2 * ∫ ω, g ω ∂P ≤ (K' + 1) * l ^ 2 := by
      nlinarith [sq_nonneg l]
    have := Real.add_one_le_exp ((K' + 1) * l ^ 2)
    linarith
  linarith

/-- clamping to `[-B, B]`. -/
noncomputable def clampB (B x : ℝ) : ℝ := max (-B) (min x B)

lemma clampB_abs (B x : ℝ) (hB : 0 ≤ B) : |clampB B x| ≤ B := by
  unfold clampB; rw [abs_le]; constructor
  · exact le_max_left _ _
  · exact max_le (by linarith) (min_le_right _ _)

lemma clampB_eq (B x : ℝ) (h : |x| ≤ B) : clampB B x = x := by
  unfold clampB; rw [abs_le] at h
  rw [min_eq_left h.2, max_eq_right h.1]

lemma clampB_cont (B : ℝ) : Continuous (clampB B) := by
  unfold clampB; fun_prop

end Aux_KZI_L5

