      all_goals first | positivity | (unfold NLogN.CR.facN; positivity))
    (copQ K (2 ^ e)) (by
      simp +decide [NLogN.CR.QE, ht1, NLogN.Ex.eval, tR, NLogN.CR.top_of g1, copQ, NLogN.CR.facN]
      try (rw [Int.natCast_ediv]; push_cast; ring))
  set t2 := NLogN.CR.pushV t1 NLogN.CR.pTQ (copQ K (2 ^ e)) with ht2
  have hq2 : t2.G NLogN.CR.pTQ = .int (copQ K (2 ^ e) : ℕ) :: t1.G pTQ := by simp [ht2]
  obtain ⟨o3a, o3b⟩ := NLogN.CR.mE_eval K hK NLogN.CR.hRh t2 (2 ^ (e - 1)) (copQ K (2 ^ e)) LH _
    (by simp +decide [ht2, ht1, hH]) hq2 (NLogN.CR.copQ_pos _ _)
  have h3 := NLogN.CR.push_sp t2 NLogN.CR.pT5 (by decide) (NLogN.CR.mE K NLogN.CR.hRh) (NLogN.CR.mE_clean K NLogN.CR.hRh (by decide)) o3a (NLogN.CR.m1V K (2 ^ e))
    (by rw [o3b, NLogN.CR.m1V, hr2])
  set t3 := NLogN.CR.pushV t2 NLogN.CR.pT5 (NLogN.CR.m1V K (2 ^ e)) with ht3
  obtain ⟨o4a, o4b⟩ := NLogN.CR.mE_eval K hK NLogN.CR.hRr t3 (2 ^ e) (copQ K (2 ^ e)) LR (t1.G NLogN.CR.pTQ)
    (by simp +decide [ht3, ht2, ht1, hR]) (by simp +decide [ht3, hq2]) (NLogN.CR.copQ_pos _ _)
  have h4 := NLogN.CR.push_sp t3 NLogN.CR.pT6 (by decide) (NLogN.CR.mE K NLogN.CR.hRr) (NLogN.CR.mE_clean K NLogN.CR.hRr (by decide)) o4a (NLogN.CR.m2V K (2 ^ e))
    (by rw [o4b, NLogN.CR.m2V])
  set t4 := NLogN.CR.pushV t3 NLogN.CR.pT6 (NLogN.CR.m2V K (2 ^ e)) with ht4
  have h5 := NLogN.CR.pop_sp t4 NLogN.CR.pT4 (by decide) ((NLogN.CR.facN K).factorial : ℕ) (t.G NLogN.CR.pT4) (by simp +decide [ht4, ht3, ht2, ht1])
  set F := (NLogN.CR.facN K).factorial with hFd
  set Q := copQ K (2 ^ e) with hQd
  have hfN : 1 ≤ NLogN.CR.facN K := by unfold NLogN.CR.facN; nlinarith
  have hFF : F ≤ 2 * F * NLogN.CR.facN K := by nlinarith
  have hfF : NLogN.CR.facN K ≤ 2 * F * NLogN.CR.facN K := by nlinarith
  have hQF : (2 : ℤ) * F * ((2 ^ e : ℕ) / (2 * F * NLogN.CR.facN K : ℕ) + 1 : ℕ) = Q := by
    rw [hQd, copQ]; push_cast; rfl
  have hqd : ((2 ^ e : ℕ) / (2 * F * NLogN.CR.facN K : ℕ) : ℕ) ≤ 2 ^ e := Nat.div_le_self _ _
  have hQK : Q ≤ K * Q := Nat.le_mul_of_pos_left Q hK
  have hrK : 2 ^ e ≤ K * 2 ^ e := Nat.le_mul_of_pos_left _ hK
  have hr2 : 2 ^ (e - 1) ≤ 2 ^ e := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hFF2 : F + NLogN.CR.facN K ≤ 2 * F * NLogN.CR.facN K := by nlinarith
  have hBF : F + NLogN.CR.facN K < 2 ^ B := by omega
  have c1 := NLogN.CR.facP_cost t NLogN.CR.pT4 NLogN.CR.hQ (by decide) (.lit (NLogN.CR.facN K)) (by simp [NLogN.Ex.regs]) (NLogN.CR.facN K) rfl B
    (by simp only [NLogN.Ex.Bnd]; exact NLogN.CR.natCast_lt_pow (by omega)) hBF
  have c2 := NLogN.CR.push_cost t1 NLogN.CR.pTQ (NLogN.CR.QE K) B (by
    simp +decide [NLogN.CR.QE, ht1, NLogN.Ex.Bnd, NLogN.Ex.eval, tR, NLogN.CR.top_of g1]
    have q0 : (0 : ℤ) ≤ 2 ^ e / (2 * (F : ℤ) * (NLogN.CR.facN K : ℤ)) := Int.ediv_nonneg (by positivity) (by positivity)
    have q1 : (2 : ℤ) ^ e / (2 * (F : ℤ) * (NLogN.CR.facN K : ℤ)) ≤ 2 ^ e := Int.ediv_le_self _ (by positivity)
    have q2 : (2 : ℤ) * F * (2 ^ e / (2 * (F : ℤ) * (NLogN.CR.facN K : ℤ)) + 1) = Q := by
      rw [← hQF]; push_cast; rfl
    have q3 : (Q : ℤ) ≤ K * Q := by exact_mod_cast hQK
    have q4 : ((2 : ℤ) ^ e) ≤ K * 2 ^ e := by exact_mod_cast hrK
    have q5 : (F : ℤ) + NLogN.CR.facN K ≤ 2 * F * NLogN.CR.facN K := by exact_mod_cast hFF2
    have q6 : (1 : ℤ) ≤ F := by exact_mod_cast hF
    have q7 : (1 : ℤ) ≤ NLogN.CR.facN K := by exact_mod_cast hfN
    have q8 : (0 : ℤ) ≤ Q := by positivity
    have q9 : (0 : ℤ) ≤ 2 ^ e := by positivity
    have q10 : (2 : ℤ) * F ≤ 2 * F * NLogN.CR.facN K := by nlinarith
    constructorm* _ ∧ _
    all_goals (apply NLogN.CR.zszI hV <;> push_cast <;> linarith))
  have m1 := Nat.mul_le_mul_left (4 * K) hr2
  have c3 := NLogN.CR.push_cost t2 NLogN.CR.pT5 (NLogN.CR.mE K NLogN.CR.hRh) B (NLogN.CR.mE_bnd K hK NLogN.CR.hRh t2 (2 ^ (e - 1)) Q LH (t1.G NLogN.CR.pTQ)
    (by simp +decide [ht2, ht1, hH]) hq2 (NLogN.CR.copQ_pos _ _) _ B hV (by nlinarith))
  have c4 := NLogN.CR.push_cost t3 NLogN.CR.pT6 (NLogN.CR.mE K NLogN.CR.hRr) B (NLogN.CR.mE_bnd K hK NLogN.CR.hRr t3 (2 ^ e) Q LR (t1.G NLogN.CR.pTQ)
    (by simp +decide [ht3, ht2, ht1, hR]) (by simp +decide [ht3, hq2]) (NLogN.CR.copQ_pos _ _) _ B hV (by nlinarith))
  have g5 : t4.G NLogN.CR.pT4 = .int (F : ℕ) :: t.G pT4 := by simp +decide [ht4, ht3, ht2, ht1]
  have c5 := NLogN.CR.pop_cost t4 NLogN.CR.pT4 B (by rw [NLogN.CR.top_of g5]; exact NLogN.CR.natCast_lt_pow (by omega))
  unfold NLogN.CR.stC
  simp only [NLogN.RS.seqL]
  refine le_trans (NLogN.CR.seq_cost r1 c1 (NLogN.CR.seq_cost h2.2 c2 (NLogN.CR.seq_cost h3.2 c3 (NLogN.CR.seq_cost h4.2 c4 c5)))) ?_
  simp only [NLogN.Ex.size, NLogN.CR.QE, NLogN.CR.mE, NLogN.CR.max0]
  have hX : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  generalize (B + 2) ^ 2 = X at *
  nlinarith
