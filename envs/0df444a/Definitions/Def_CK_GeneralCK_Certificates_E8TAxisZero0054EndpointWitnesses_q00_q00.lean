namespace GeneralCK.Certificates.E8TAxisZero0054EndpointWitnesses

open Set DyadicInterval E8TAxisStableInterval E8TAxisStableScalar
open E8TAxisFirstCellInverseCoverage E8TAxisZero0054Geometry

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

def precision : ℕ := 160
def endpointLogTwo : DyadicInterval precision := ⟨1013035739299659071135698605846798551586536899314, 1013035739299659071135698605846798551586536901381⟩
def fastLogWitness : FastLogBoxWitness := ⟨0, 1024, 0, 1024⟩

theorem endpointLogTwo_checked :
    logBoxCheck (ofInt precision 2) endpointLogTwo fastLogWitness = true := by decide +kernel

def centerBLowerAlpha : DyadicInterval precision := ⟨2161831022368146643392260577941081767660351386648, 2161831022368146643392260577941081767660351386648⟩
def centerBLowerExp : DyadicInterval precision := ⟨75857007209467699670786625005704562934098397488, 75857007209467699670786625005704562934098528561⟩
def centerBLowerLog : DyadicInterval precision := ⟨73953958922723310047967461309952003273926828016, 73953958922723310047967461309952003273926954679⟩
def centerBLowerYBox : DyadicInterval precision := ⟨8840714748066964933646477283402840753587410633966, 8840714748066964933646477283402840753587420861569⟩
def centerBLowerInput : Inputs precision :=
  ⟨centerBLowerAlpha, centerBLowerExp, centerBLowerLog, endpointLogTwo⟩
def centerBLowerExpWitness : ExpWitness precision :=
  ⟨75857007209467699670786625005704562934098397488, scale precision, 75857007209467699670786625005704562934098528561, scale precision,
    0, 1024, 0, 1024, ⟨-4323662044736293286784521155882163535320704037588, -4323662044736293286784521155882163535320704035436⟩, ⟨-4323662044736293286784521155882163535320701512254, -4323662044736293286784521155882163535320701510104⟩⟩

theorem centerBLower_primitive_checks :
    expBoxCheck ((ofInt precision (-2)).mul centerBLowerAlpha) centerBLowerExp centerBLowerExpWitness = true ∧
    logBoxCheck ((ofInt precision 1).add centerBLowerExp) centerBLowerLog fastLogWitness = true := by decide +kernel

theorem centerBLower_denominators : DenominatorsPositive centerBLowerInput := by
  unfold DenominatorsPositive
  decide +kernel

theorem centerBLower_yBox_eq : (yBox centerBLowerInput).d0 = centerBLowerYBox := by decide +kernel

theorem centerBLower_contains :
    centerBLowerYBox.Contains (Y (lower E8TAxisZero0054PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0054PaddedInputs.centerBInput.alpha = ((2161831022368146643392260577941081767660351386648 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
  have ha : centerBLowerInput.alpha.Contains (lower E8TAxisZero0054PaddedInputs.centerBInput.alpha) := by
    rw [e]; exact point_contains precision 2161831022368146643392260577941081767660351386648
  have h := checked_yBox_d0_contains (i := centerBLowerInput) (we := centerBLowerExpWitness)
    (wl := fastLogWitness) (wL := fastLogWitness)
    centerBLower_primitive_checks.1 centerBLower_primitive_checks.2 endpointLogTwo_checked
    centerBLower_denominators ha
  rw [centerBLower_yBox_eq] at h
  exact h

def centerBUpperAlpha : DyadicInterval precision := ⟨2161831022368146643392260577941081767660384941081, 2161831022368146643392260577941081767660384941081⟩
end GeneralCK.Certificates.E8TAxisZero0054EndpointWitnesses


