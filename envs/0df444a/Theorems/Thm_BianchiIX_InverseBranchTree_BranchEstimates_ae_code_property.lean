theorem BianchiIX.InverseBranchTree.BranchEstimates.ae_code_property {L : ℝ}
    (hbudget : ∀ n, (∑ j ∈ Finset.range n, (e j + if j = 0 then 0 else 2 * d j)) ≤ L)
    {P : ℝ → Prop} (hP : ∀ᵐ y ∂volume, P y) :
    ∀ᵐ x ∂(volume.comap (Subtype.val : T.survivors → ℝ)), P (T.code x) := by sorry
