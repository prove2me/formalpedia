import Definitions.Def_MazurTransfer_Order13ActualConicFieldCubicExtensionData
import Theorems.Thm_MazurTransfer_FiniteAutomorphismSubgroupFixedFieldDegree_finrank_fixedField
import Theorems.Thm_MazurTransfer_Order13ActualDiamondExactOrder_diamondAlgEquiv_order

noncomputable section
namespace MazurTransfer.Order13ActualOrderThreeFixedField
open GoodCharacteristicGeometryPublicProof.MazurTransfer.Order13GoodCharacteristicCurveModel
open Order13ActualDiamondFunctionFieldAutomorphism Order13ActualDiamondExactOrder
open Order13PellActualOrdinaryChart Order13ActualOrdinaryPolynomialTranscendence
open Order13ActualConicFunctionParameter Order13ActualConicFieldCubicExtension
local instance : Fact ((104 : ℚ) ≠ 0) := ⟨by norm_num⟩

def orderThreeGroup : Subgroup (actualCurveFunctionField ℚ ≃ₐ[ℚ] actualCurveFunctionField ℚ) :=
  Subgroup.zpowers (diamondAlgEquiv ^ 2)

theorem orderThreeGroup_card : Nat.card orderThreeGroup = 3 := by
  rw [orderThreeGroup, Nat.card_zpowers, orderOf_pow' (x := diamondAlgEquiv) (n := 2) (by decide), diamondAlgEquiv_order]
  norm_num

instance : Finite orderThreeGroup := Nat.finite_of_card_ne_zero (by rw [orderThreeGroup_card]; decide)

def quotientFixedField : IntermediateField ℚ (actualCurveFunctionField ℚ) :=
  IntermediateField.fixedField orderThreeGroup

theorem fixedField_degree : Module.finrank quotientFixedField (actualCurveFunctionField ℚ) = 3 := by
  rw [quotientFixedField, FiniteAutomorphismSubgroupFixedFieldDegree.finrank_fixedField,
    orderThreeGroup_card]

theorem parameter_fixedField_mem : t ∈ quotientFixedField := by
  apply (IntermediateField.mem_fixedField_iff _ _).mpr
  intro f hf
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hf
  have H : t ∈ MulAction.fixedBy (actualCurveFunctionField ℚ) (diamondAlgEquiv ^ 2) := by
    change diamondSecond t = t
    exact square_fixes_parameter
  exact MulAction.mem_fixedBy_zpow H n

theorem conicField_le_fixedField : conicField ≤ quotientFixedField := by
  apply IntermediateField.adjoin_le_iff.mpr
  intro z hz
  exact Set.mem_singleton_iff.mp hz ▸ parameter_fixedField_mem

theorem actual_order_three_fixed_field : conicField = quotientFixedField := by
  letI := curveField_finite
  apply IntermediateField.eq_of_le_of_finrank_le' conicField_le_fixedField
  rw [fixedField_degree]
  exact curveField_degree_le_three

theorem curveField_degree_three : Module.finrank conicField (actualCurveFunctionField ℚ) = 3 := by
  rw [actual_order_three_fixed_field]
  exact fixedField_degree

local instance : Algebra ℚ conicField := IntermediateField.algebra' conicField
local instance : Algebra ℚ (RatFunc ℚ) := RatFunc.instAlgebraOfPolynomial ℚ ℚ

theorem parameter_transcendental : Transcendental ℚ t := by
  intro Ht
  haveI : Algebra.IsAlgebraic ℚ conicField :=
    IntermediateField.isAlgebraic_adjoin_simple (isAlgebraic_iff_isIntegral.mp Ht)
  exact xImage_transcendental (IsIntegral.trans_isAlgebraic (R := ℚ) x_integral)

def rationalQuotientFieldEquiv : RatFunc ℚ ≃ₐ[ℚ] conicField :=
  RatFunc.algEquivOfTranscendental t parameter_transcendental

theorem curveField_galois : IsGalois conicField (actualCurveFunctionField ℚ) := by
  rw [actual_order_three_fixed_field]
  exact IsGalois.of_fixed_field (actualCurveFunctionField ℚ) orderThreeGroup

def cyclicGaloisGroupEquiv : orderThreeGroup ≃*
    (actualCurveFunctionField ℚ ≃ₐ[conicField] actualCurveFunctionField ℚ) := by
  rw [actual_order_three_fixed_field]
  exact FixedPoints.toAlgAutMulEquiv orderThreeGroup (actualCurveFunctionField ℚ)

end MazurTransfer.Order13ActualOrderThreeFixedField
