theorem pre_eDel (s : ℕ) : ∀ l, l < s → NLogN.Rsp.pre (eDel s) (l + 1) = l
  | 0, h => by rw [pre_succ _ _ (by rw [eDel_length]; omega)]; simp [NLogN.Rsp.pre, eDel]
  | l + 1, h => by
    rw [pre_succ _ _ (by rw [eDel_length]; omega), pre_eDel s l (by omega)]
    simp [eDel]

theorem pre_eDel_le (s : ℕ) : NLogN.Rsp.pre (eDel s) s ≤ s := by
  rcases Nat.eq_zero_or_pos s with h | h
  · subst h; simp [NLogN.Rsp.pre]
  · obtain ⟨k, rfl⟩ : ∃ k, s = k + 1 := ⟨s - 1, by omega⟩
    rw [pre_eDel _ k (by omega)]; omega

theorem eTab_length (p s t α : ℕ) : (eTab p s t α).length = 2 * HvdH.eWidth p α + 1 := by
  simp [eTab]

theorem eTab_rows (p s t α : ℕ) : ∀ W ∈ eTab p s t α, W.length = s := by
  intro W hW; simp only [eTab, List.mem_map, List.mem_range] at hW
  obtain ⟨i, _, rfl⟩ := hW; simp

theorem resL_E_getD (g : ℤ × ℤ → ℤ) (p s t α : ℕ) (u : List (ℤ × ℤ)) (hs : 0 < s)
    (hu : u.length = s) (l : ℕ) (hl : l < s) :
    (resL (2 ^ p) (eDel s) (eTab p s t α) (u.map g) (sOff s (HvdH.eWidth p α)) s).getD l 0 =
      ∑ i ∈ Finset.range (2 * HvdH.eWidth p α + 1),
        (NLogN.Rsp.eW p s t α i l * g (u.getD ((((l : ℕ) : ℤ) - ((HvdH.eWidth p α : ℕ) : ℤ) +
          ((i : ℕ) : ℤ)) % (s : ℤ)).toNat (0, 0))).tdiv (2 ^ p) := by
  unfold resL
  rw [bandF_getD _ _ _ _ _ l (by simp; exact hl), eTab_length]
  have h0 : (List.replicate s (0 : ℤ)).getD l 0 = 0 := by simp [List.getD_eq_getElem?_getD]
  rw [h0, zero_add]
  apply Finset.sum_congr rfl
  intro i hi
  rw [Finset.mem_range] at hi
  have hw : ((eTab p s t α).getD i []).getD l 0 = NLogN.Rsp.eW p s t α i l := by
    simp [eTab, List.getD_eq_getElem?_getD, hi, hl]
  have hx : (cycL (u.map g) (sOff s (HvdH.eWidth p α))
      ((u.map g).length + (2 * HvdH.eWidth p α + 1))).getD (NLogN.Rsp.pre (eDel s) (l + 1) + i) 0 =
      g (u.getD ((((l : ℕ) : ℤ) - ((HvdH.eWidth p α : ℕ) : ℤ) +
          ((i : ℕ) : ℤ)) % (s : ℤ)).toNat (0, 0)) := by
    rw [pre_eDel s l hl, cycL_getD _ _ _ _ (by simp [hu]; omega), sOff_idx _ _ _ _ hs]
    have hl' : (u.map g).length = s := by simp [hu]
    rw [hl', ← Nat.add_assoc]
    have hlt : (sOff s (HvdH.eWidth p α) + l + i) % s < u.length := by
      rw [hu]; exact Nat.mod_lt _ hs
    simp [List.getD_eq_getElem?_getD, hlt]
  rw [hw, hx]

/-- The term of `Eapprox` with our weight. -/
theorem eTerm_eq (p s t α l : ℕ) (U : ℕ → ℤ × ℤ) (i : ℕ) :
    HvdH.eTerm p s t α l U ((i : ℤ) - (HvdH.eWidth p α : ℤ)) =
      ((NLogN.Rsp.eW p s t α i l * (U ((((l : ℕ) : ℤ) - ((HvdH.eWidth p α : ℕ) : ℤ) +
          ((i : ℕ) : ℤ)) % (s : ℤ)).toNat).1).tdiv (2 ^ p),
       (NLogN.Rsp.eW p s t α i l * (U ((((l : ℕ) : ℤ) - ((HvdH.eWidth p α : ℕ) : ℤ) +
          ((i : ℕ) : ℤ)) % (s : ℤ)).toNat).2).tdiv (2 ^ p)) := by
  unfold HvdH.eTerm NLogN.Rsp.eW
  by_cases h : i = HvdH.eWidth p α
  · have : (i : ℤ) - (HvdH.eWidth p α : ℤ) = 0 := by rw [h]; ring
    simp [this, h]
  · have : ¬ ((i : ℤ) - (HvdH.eWidth p α : ℤ) = 0) := by omega
    rw [if_neg this, if_neg h]
    have e : (l : ℤ) + ((i : ℤ) - (HvdH.eWidth p α : ℤ)) = (l : ℤ) - (HvdH.eWidth p α : ℤ) + i := by
      ring
    simp only [e]

theorem resL_E_fst (p s t α : ℕ) (u : List (ℤ × ℤ)) (hs : 0 < s) (hu : u.length = s) :
    resL (2 ^ p) (eDel s) (eTab p s t α) (u.map Prod.fst) (sOff s (HvdH.eWidth p α)) s =
      (eapL p s t α u).map Prod.fst := by
  apply List.ext_getElem (by simp [resL_length, eapL])
  intro l h1 h2
  rw [resL_length] at h1
  rw [← List.getD_eq_getElem _ 0, resL_E_getD Prod.fst p s t α u hs hu l h1]
  simp only [eapL, List.getElem_map, List.getElem_range, HvdH.Eapprox, eTerm_eq]

theorem resL_E_snd (p s t α : ℕ) (u : List (ℤ × ℤ)) (hs : 0 < s) (hu : u.length = s) :
    resL (2 ^ p) (eDel s) (eTab p s t α) (u.map Prod.snd) (sOff s (HvdH.eWidth p α)) s =
      (eapL p s t α u).map Prod.snd := by
  apply List.ext_getElem (by simp [resL_length, eapL])
  intro l h1 h2
  rw [resL_length] at h1
  rw [← List.getD_eq_getElem _ 0, resL_E_getD Prod.snd p s t α u hs hu l h1]
  simp only [eapL, List.getElem_map, List.getElem_range, HvdH.Eapprox, eTerm_eq]

