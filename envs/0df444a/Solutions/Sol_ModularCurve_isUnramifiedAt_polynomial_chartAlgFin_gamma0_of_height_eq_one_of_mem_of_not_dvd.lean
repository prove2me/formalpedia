  have halgP : ∀ p : Polynomial A, algebraMap (Polynomial A) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K₀) j₀) p = polynomialToChartFin A (↥K₀) j₀ p := fun _ => rfl
