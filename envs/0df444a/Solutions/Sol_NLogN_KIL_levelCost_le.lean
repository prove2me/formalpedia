/-- The register-count network cost as a frame sum. -/
theorem netCIU_eq (V Bb : ℕ) (Mout : Fin W → M) :
    ∀ (gates : List (NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M),
      netCIU cE V Bb Mout lab gates =
        frameSum (fun X => cE X + cCU V Bb) gates lab Mout +
          gates.length * (cRebuildU W V Bb + 1) + 1
  | [], lab => by simp [netCIU, frameSum, sum_finRange, Finset.sum_add_distrib]
  | g :: gs, lab => by
    simp only [netCIU, frameSum, netCIU_eq V Bb Mout gs, sum_touchL, List.length_cons]
    ring

