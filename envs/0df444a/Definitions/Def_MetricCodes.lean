def BoundedTableau (μ : YoungDiagram) (n : ℕ) :=
  {T : SemistandardYoungTableau μ //
    ∀ i j : ℕ, (i, j) ∈ μ → T i j < n}
def BoundedTableau.cellEntry {μ : YoungDiagram} {n : ℕ}
    (T : BoundedTableau μ n) (c : μ.cells) : Fin n :=
  ⟨T.val c.val.1 c.val.2, T.property c.val.1 c.val.2 c.property⟩
theorem boundedTableau_cellEntry_injective (μ : YoungDiagram) (n : ℕ) :
    Function.Injective
      (fun T : BoundedTableau μ n => T.cellEntry) := by
  intro S T h
  apply Subtype.ext
  apply SemistandardYoungTableau.ext
  intro i j
  by_cases hc : (i, j) ∈ μ
  · let c : μ.cells := ⟨(i, j), hc⟩
    exact congrArg Fin.val (congrFun h c)
  · rw [S.val.zeros hc, T.val.zeros hc]
instance boundedTableau_finite (μ : YoungDiagram) (n : ℕ) :
    Finite (BoundedTableau μ n) :=
  Finite.of_injective _ (boundedTableau_cellEntry_injective μ n)
noncomputable instance boundedTableau_fintype (μ : YoungDiagram) (n : ℕ) :
    Fintype (BoundedTableau μ n) := Fintype.ofFinite _
