theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N)
    (k : Type) [Field k] [IsAlgClosed k] [CharP k q] :
    Nonempty (FakeEllipticCurve Λ N k) := by
  obtain ⟨E₁⟩ := CerednikDrinfeld.QM.nonempty_fakeEllipticCurve_one_of_isAlgClosed_of_charP hqq' hB Λ hΛ k
  obtain ⟨φ, h1, hmul, hsurj, hker⟩ :=
    QuaternionAlgebra.exists_linearMap_matrix_zmod_of_isMaximalOrder_of_not_dvd hB Λ hΛ N hqN hq'N
  have hN : (N : k) ≠ 0 := by
    intro h
    exact hqN ((CharP.cast_eq_zero_iff k q N).mp h)
  exact CerednikDrinfeld.QM.FakeEllipticCurve.nonempty_of_isIndefiniteRamifiedExactlyAt_of_linearMap_matrix_zmod_of_natCast_ne_zero
    hB Λ hΛ N φ h1 hmul hsurj hker k hN E₁

