/-! ## The two actual principal null directions (paper dictionary) -/

/-- Coordinate components `𝒦_λ = (e/f, λ, 0, w e/f - a'/H, w e/f - a'/H)`. -/
theorem principalCoord_eq (f m N w p a : ℝ → ℝ) (lam : ℝ) (x : Pt 5) :
    principalCoord f m N w p a lam x =
      ![eFun w p a (x 1) / f (x 1), lam, 0,
        w (x 1) * (eFun w p a (x 1) / f (x 1)) - deriv a (x 1) / Hfun m N (x 1),
        w (x 1) * (eFun w p a (x 1) / f (x 1)) - deriv a (x 1) / Hfun m N (x 1)] := by
