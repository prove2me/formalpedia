variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.parE_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N n k Q ℓ : ℕ)
    (L1 L2 L3 LZ : List Item) (hn : 1 ≤ n) (hkn : k ≤ n) (hnN : n ≤ N) (hQ : Q ≤ N)
    (hℓ : ℓ ≤ N)
    (hT1 : s.G T1 = .int k :: L1) (hT2 : s.G T2 = .int Q :: L2) (hT3 : s.G NLogN.T3 = .int n :: L3)
    (hZ : s.G ZZ = .int ℓ :: LZ) :
    IRuns I iprog (parE pP) s
      ((((((((s.upd W2 (.int (2 ^ (n - k)) :: s.G W2)).upd HB (.int (2 ^ (n - 1)) :: s.G HB)).upd
        PRM (.int n :: s.G PRM)).upd NLogN.T3 L3).upd T2 L2).upd T1 L1).upd ZZ LZ))
      (60000 * (N + 3)) := by sorry
