-- title:
--   Lemma 1
-- statement:
--   Let $L$ be a Lie algebra over any field $F$ and $N$ a nilpotent Lie ideal of $L$. Define $\operatorname{ad}(a)(b)=[a,b]$, and let $A$ be the unital associative $F$-subalgebra of $\operatorname{End}_F(L)$ generated by $\operatorname{ad}(L)$. If $J(A)$ is the Jacobson radical, then
--
--   $$\operatorname{ad}(N)\subseteq J(A).$$
--
--   Membership is taken inside that particular generated algebra. There is no finite-dimensionality or characteristic-zero assumption. This connects Lie nilpotence to the associative radical.
-- source:
--   Structure of H-(co)module Lie algebras, arXiv:1205.0778v7, PDF p. 5, Lemma 1

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P22

namespace QAlgorithms.Papers.Independent.Next46.P22

noncomputable section

open scoped TensorProduct

open Classical

section Statements

variable {F H L : Type*} [Field F] [Ring H] [HopfAlgebra F H] [LieRing L] [LieAlgebra F L]

/-- Lemma 1, PDF p.5: use the PARTICULAR unital associative algebra generated by
ad(L), not an arbitrary envelope. No dimension or characteristic assumption. -/
theorem lemma1 (N : LieIdeal F L) (hN : LieModule.IsNilpotent N N) :
    let A := Algebra.adjoin F (Set.range (LieAlgebra.ad F L))
    ∀ a ∈ N, ∃ z : A, (z : Module.End F L) = LieAlgebra.ad F L a ∧
      z ∈ Ring.jacobson A := by sorry

end Statements

end

end QAlgorithms.Papers.Independent.Next46.P22
