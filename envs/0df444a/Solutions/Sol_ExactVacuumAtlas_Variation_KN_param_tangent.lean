* every member is certified by `certReg` (no derivative of the horizon cut `rPlus` is taken);
* hence (`param_tangent`) its genuine tangent `paramTangent` (componentwise `ε`-derivative at `0`, a true
  `HasDerivAt` by `isTangent_paramTangent`) satisfies `LE = LJ = LH = 0` at every `x ∈ domReg M a Q`, and
  (`param_tangent_exterior`) on the BL exterior `domKN M a Q` when `0 < M`. -/

open Real
open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.KN

namespace ExactVacuumAtlas.Variation.KN

theorem isOpen_domJ (M a Q m α q : ℝ) : IsOpen (domJ M a Q m α q) := by
  have h1 : Continuous fun p : ℝ × Pt 4 => Sig (a + p.1 * α) (p.2 1) (p.2 2) := by
    unfold Sig; fun_prop
  have h2 : Continuous fun p : ℝ × Pt 4 => Del (M + p.1 * m) (a + p.1 * α) (Q + p.1 * q) (p.2 1) := by
    unfold Del; fun_prop
  have h3 : Continuous fun p : ℝ × Pt 4 => sin (p.2 2) := by fun_prop
  exact (isOpen_ne_fun h1 continuous_const).inter
    ((isOpen_ne_fun h2 continuous_const).inter (isOpen_ne_fun h3 continuous_const))

theorem zero_mem_domJ {M a Q m α q : ℝ} {x : Pt 4} (hx : x ∈ domReg M a Q) :
    ((0 : ℝ), x) ∈ domJ M a Q m α q := by
  show x ∈ domReg (M + 0 * m) (a + 0 * α) (Q + 0 * q)
  simpa only [zero_mul, add_zero] using hx

theorem familyData (M a Q m α q : ℝ) :
    FamilyData (fun ε => gKN (M + ε * m) (a + ε * α) (Q + ε * q))
      (fun ε => giKN (M + ε * m) (a + ε * α) (Q + ε * q)) (fun ε => faradayKN (a + ε * α) (Q + ε * q))
      (domJ M a Q m α q) where
  isOpen := isOpen_domJ M a Q m α q
  smooth i j := by
    intro p hp
    have hS : p.2 1 ^ 2 + (a + p.1 * α) ^ 2 * cos (p.2 2) ^ 2 ≠ 0 := domReg_S hp
    have hD : p.2 1 ^ 2 - 2 * (M + p.1 * m) * p.2 1 + (a + p.1 * α) ^ 2 + (Q + p.1 * q) ^ 2 ≠ 0 := domReg_D hp
    refine ContDiffAt.contDiffWithinAt ?_
    fin_cases i <;> fin_cases j <;> simp only [gKN, Sig, Del] <;>
      fun_prop (disch := first | assumption | exact pow_ne_zero _ hS)
  smooth_F i j := by
    intro p hp
    have hS : p.2 1 ^ 2 + (a + p.1 * α) ^ 2 * cos (p.2 2) ^ 2 ≠ 0 := domReg_S hp
    refine ContDiffAt.contDiffWithinAt ?_
    fin_cases i <;> fin_cases j <;> simp only [faradayKN, Sig] <;>
      fun_prop (disch := first | assumption | exact pow_ne_zero _ hS)
  inv p hp := ExactVacuumAtlas.EinsteinMaxwell.KN.inv_mul _ _ _ hp

end ExactVacuumAtlas.Variation.KN

-- ==== solution ====
open Real
open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.KN
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
open ExactVacuumAtlas.Variation.KN
theorem solution (M a Q m α q : ℝ) {x : Pt 4} (hx : x ∈ domReg M a Q) :
    (∀ i j, linEinstein (gKN M a Q) (giKN M a Q) (faradayKN a Q)
      (paramTangent fun ε => gKN (M + ε * m) (a + ε * α) (Q + ε * q))
      (paramTangent fun ε => faradayKN (a + ε * α) (Q + ε * q)) i j x = 0) ∧
    (∀ j, linMaxwell (gKN M a Q) (giKN M a Q) (faradayKN a Q)
      (paramTangent fun ε => gKN (M + ε * m) (a + ε * α) (Q + ε * q))
      (paramTangent fun ε => faradayKN (a + ε * α) (Q + ε * q)) j x = 0) ∧
    (∀ i j k, linFaraday (paramTangent fun ε => faradayKN (a + ε * α) (Q + ε * q)) i j k x = 0) := by
  have hfam := familyData M a Q m α q
  have ht := isTangent_paramTangent hfam
  have hx0 := zero_mem_domJ (m := m) (α := α) (q := q) hx
  have hcert : ∀ p ∈ domJ M a Q m α q, EinsteinMaxwellCertificate
      (gKN (M + p.1 * m) (a + p.1 * α) (Q + p.1 * q)) (giKN (M + p.1 * m) (a + p.1 * α) (Q + p.1 * q))
      (faradayKN (a + p.1 * α) (Q + p.1 * q)) (domReg (M + p.1 * m) (a + p.1 * α) (Q + p.1 * q)) :=
    fun p _ => certReg _ _ _
  refine ⟨fun i j => ?_, fun j => ?_, fun i j k => ?_⟩
  · have := linEinstein_eq_zero_of_onShell hfam ht (fun p hp i j => (hcert p hp).einstein p.2 hp i j) hx0 i j
    simpa only [zero_mul, add_zero] using this
  · have := linMaxwell_eq_zero_of_onShell hfam ht (fun p hp j => (hcert p hp).maxwell p.2 hp j) hx0 j
    simpa only [zero_mul, add_zero] using this
  · exact linFaraday_eq_zero_of_onShell hfam ht (fun p hp i j k => (hcert p hp).closed p.2 hp i j k) hx0 i j k
