theorem GaussianTensorExecution.inverse_forward_leaf_canonical (n e : Nat) (z : Cube n) (p : Path n) :
    normalize ⟨get n (inverse n (forward n z)) p,e+2*n⟩ = normalize ⟨get n z p,e⟩ := by sorry
