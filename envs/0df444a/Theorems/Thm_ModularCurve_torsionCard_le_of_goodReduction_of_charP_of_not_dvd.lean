open AlgebraicCurve IsLocalRing ModularCurve

attribute [local instance] ModularCurve.instDecEqResidueFieldF3nrp
  ModularCurve.instAlgebraResidueFieldModularFunctionFieldCF3nrp

theorem ModularCurve.torsionCard_le_of_goodReduction_of_charP_of_not_dvd
    {A : ValuationSubring (AlgebraicClosure ℚ)} {q : ℕ} {hq : q.Prime} {N : ℕ} [NeZero N]
    [Module HeckeAlg (JZero N)]
    [Module HeckeAlg (Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) N))]
    [CharP (ResidueField A) q] (hqN : ¬ q ∣ N)
    (D : JZeroGoodReductionSpecialization A q hq N)
    (n : ℕ) (hn : 0 < n) (hqn : ¬ q ∣ n) :
    Finite {c : Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) N) //
        n • c = 0} ∧
      Nat.card {c : Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) N) //
          n • c = 0} ≤
        Nat.card {y : JZero N // n • y = 0} := by sorry
