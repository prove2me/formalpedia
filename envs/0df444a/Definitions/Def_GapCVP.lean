              ((remaining.flatMap fun item =>
                (paperSourceNormalizedClause item).map Prod.fst) ++
                suffix)).eraseDups := by
                simpa [List.append_assoc] using rest
        _ = (seen ++
              ((clause :: remaining).flatMap fun item =>
                (paperSourceNormalizedClause item).map Prod.fst) ++
              suffix).eraseDups := by
                simp [List.append_assoc]
