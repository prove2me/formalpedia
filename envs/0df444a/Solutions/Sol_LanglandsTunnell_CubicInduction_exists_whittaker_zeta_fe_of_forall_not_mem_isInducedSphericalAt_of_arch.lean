section

variable {G : Type*} [Group G]

private theorem isRightInvariant_comp_mul_left {U : Subgroup G} {W : G → ℂ} (hW : IsRightInvariant U W) (d : G) :
    IsRightInvariant U (fun h => W (d * h)) := by
  intro g u hu
  dsimp only
  rw [← mul_assoc]
  exact hW (d * g) u hu

private theorem isCosetEigenfunction_comp_mul_left {U : Subgroup G} {gen : G} {W : G → ℂ} {lam : ℂ}
    (hW : IsCosetEigenfunction U gen W lam) (d : G) : IsCosetEigenfunction U gen (fun h => W (d * h)) lam := by
  intro ι _ reps hreps g
  have h := hW ι reps hreps (d * g)
  simp only [cosetSum, mul_assoc] at h ⊢
  exact h

private theorem isRightInvariant_dualWhittakerFn3 {A : Type*} [CommRing A] {U : Subgroup (GL (Fin 3) A)}
    (hU : ∀ u ∈ U, transposeInv3 u ∈ U) {W : GL (Fin 3) A → ℂ} (hW : IsRightInvariant U W) :
    IsRightInvariant U (dualWhittakerFn3 W) := by
  intro g u hu
  have hmul : transposeInv3 (g * u) = transposeInv3 g * transposeInv3 u := by
    refine Units.ext ?_
    change Matrix.transpose (((g * u)⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) =
      Matrix.transpose ((g⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A) *
        Matrix.transpose ((u⁻¹ : GL (Fin 3) A) : Matrix (Fin 3) (Fin 3) A)
    rw [mul_inv_rev, Units.val_mul, Matrix.transpose_mul]
  simp only [dualWhittakerFn3_apply]
  rw [hmul, ← mul_assoc]
  exact hW _ _ (hU u hu)

end
