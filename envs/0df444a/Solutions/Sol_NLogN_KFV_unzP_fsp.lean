  · intro k hk
    have hd : zs.drop k = zs[k] :: zs.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : zs.take (k + 1) = zs.take k ++ [zs[k]] := (List.take_concat_get' zs k hk).symm
    obtain ⟨hz1, hz2, hz3, hz4⟩ := hw zs[k] (List.getElem_mem hk)
    obtain ⟨G, hG⟩ : ∃ G, G = Function.update (F k) C [(zs.length : ℤ) - k] := ⟨_, rfl⟩
    rw [← hG]
    have hGX : G X = zs[k].1 :: zs[k].2 :: (NLogN.KFB.gflat (zs.drop (k + 1)) ++ l) := by
      rw [hG, Function.update_of_ne h3, hF]
      simp only [Function.update_of_ne h2, Function.update_of_ne h1, Function.update_self]
      rw [hd]; rfl
    have s1 := NLogN.KIL.Sp.push s G (i := SA) (e := .add (.reg X) (.lit c)) (B := w) hA5
      (NLogN.KIL.clean_add (NLogN.KIL.clean_reg hX5) (NLogN.KIL.clean_lit _)) ⟨NLogN.KIL.ok_reg hGX, trivial⟩ ⟨trivial, trivial⟩
      ⟨NLogN.KIL.bnd_reg hGX hz1, hc, by simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK hGX]; exact hz3⟩
    rw [show NLogN.Ex.eval (NLogN.KIL.encK s G) (.add (.reg X) (.lit c)) = zs[k].1 + c by
      simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK hGX]] at s1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G SA ((zs[k].1 + c) :: G SA) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have s2 := NLogN.KIL.Sp.push s G1 (i := SA) (e := .lit 0) (B := w) hA5 (NLogN.KIL.clean_lit _) trivial trivial
      (by simp [NLogN.Ex.Bnd, NLogN.zsz_zero])
    rw [show NLogN.Ex.eval (NLogN.KIL.encK s G1) (.lit (0 : ℤ)) = 0 from rfl] at s2
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 SA (0 :: G1 SA) := ⟨_, rfl⟩
    rw [← hG2] at s2
    have hG2X : G2 X = zs[k].1 :: zs[k].2 :: (NLogN.KFB.gflat (zs.drop (k + 1)) ++ l) := by
      rw [hG2, Function.update_of_ne h1, hG1, Function.update_of_ne h1, hGX]
    have s3 := NLogN.KIL.Sp.pop s G2 (i := X) (B := w) hX5 hG2X hz1
    obtain ⟨G3, hG3⟩ : ∃ G3, G3 = Function.update G2 X (zs[k].2 :: (NLogN.KFB.gflat (zs.drop (k + 1)) ++ l)) :=
      ⟨_, rfl⟩
    rw [← hG3] at s3
    have hG3X : G3 X = zs[k].2 :: (NLogN.KFB.gflat (zs.drop (k + 1)) ++ l) := by
      rw [hG3, Function.update_self]
    have s4 := NLogN.KIL.Sp.push s G3 (i := SB) (e := .add (.reg X) (.lit c)) (B := w) hB5
      (NLogN.KIL.clean_add (NLogN.KIL.clean_reg hX5) (NLogN.KIL.clean_lit _)) ⟨NLogN.KIL.ok_reg hG3X, trivial⟩ ⟨trivial, trivial⟩
      ⟨NLogN.KIL.bnd_reg hG3X hz2, hc, by simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK hG3X]; exact hz4⟩
    rw [show NLogN.Ex.eval (NLogN.KIL.encK s G3) (.add (.reg X) (.lit c)) = zs[k].2 + c by
      simp only [NLogN.Ex.eval]; rw [NLogN.KIL.top_encK hG3X]] at s4
    obtain ⟨G4, hG4⟩ : ∃ G4, G4 = Function.update G3 SB ((zs[k].2 + c) :: G3 SB) := ⟨_, rfl⟩
    rw [← hG4] at s4
    have s5 := NLogN.KIL.Sp.push s G4 (i := SB) (e := .lit 0) (B := w) hB5 (NLogN.KIL.clean_lit _) trivial trivial
      (by simp [NLogN.Ex.Bnd, NLogN.zsz_zero])
    rw [show NLogN.Ex.eval (NLogN.KIL.encK s G4) (.lit (0 : ℤ)) = 0 from rfl] at s5
    obtain ⟨G5, hG5⟩ : ∃ G5, G5 = Function.update G4 SB (0 :: G4 SB) := ⟨_, rfl⟩
    rw [← hG5] at s5
    have hG5X : G5 X = zs[k].2 :: (NLogN.KFB.gflat (zs.drop (k + 1)) ++ l) := by
      rw [hG5, Function.update_of_ne h2, hG4, Function.update_of_ne h2, hG3X]
    have s6 := NLogN.KIL.Sp.pop s G5 (i := X) (B := w) hX5 hG5X hz2
    have HH := NLogN.KFD.FSp.of_norep rfl (s1.seq (s2.seq (s3.seq (s4.seq (s5.seq s6)))))
    refine NLogN.KFD.FSp.mono (NLogN.KFD.FSp.congr HH ?_) (by simp only [NLogN.Ex.size]; omega)
    congr 1
    funext j
    by_cases e1 : j = C
    · subst e1
      simp only [hG5, hG4, hG3, hG2, hG1, hG, Function.update_of_ne h6.symm,
        Function.update_of_ne h5.symm, Function.update_of_ne h3.symm, Function.update_self]
    by_cases e2 : j = SB
    · subst e2
      simp only [hG5, hG4, hG3, hG2, hG1, hG, hF, Function.update_of_ne h2.symm,
        Function.update_of_ne h4.symm, Function.update_of_ne h6, Function.update_self]
      rw [ht, List.map_append, NLogN.KFB.gflat_append, List.reverse_append, List.append_assoc]; rfl
    by_cases e3 : j = SA
    · subst e3
      simp only [hG5, hG4, hG3, hG2, hG1, hG, hF, Function.update_of_ne h1.symm,
        Function.update_of_ne h4, Function.update_of_ne h5, Function.update_self]
      rw [ht, List.map_append, NLogN.KFB.gflat_append, List.reverse_append, List.append_assoc]; rfl
    by_cases e4 : j = X
    · subst e4
      simp only [hG5, hG4, hG3, hG2, hG1, hG, hF, Function.update_of_ne h1,
        Function.update_of_ne h2, Function.update_of_ne h3, Function.update_self]
    · simp only [hG5, hG4, hG3, hG2, hG1, hG, hF, Function.update_of_ne e1,
        Function.update_of_ne e2, Function.update_of_ne e3, Function.update_of_ne e4]
end
