/-- A root node computes its trace splitter from a factor in the old queue. -/
theorem rootTraceProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L src : ℕ) (f : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootTraceProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : DetAgrees E t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hp : RootPersistent b R U D C TB ZB cap L src f a m)
    (hsrc : 128 ≤ src) (hSrcWord : src + cap ≤ 2 ^ E.W)
    (hsep : RootSourceSeparated R U D C TB cap src) (hmeta : (108 : ℕ) < 2 ^ E.W)
    (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t) :
    Sem P E pc (pc + 1021) (boundaryState pc m)
      (fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 258) * w + 77 * cap + 443 ∧
        ∃ m', z = boundaryState (pc + 1021) m' ∧ RootPersistent b R U D C TB ZB cap L src f a m' ∧
          PadeRows b E R U D C L cap m' (⟨traceRemainder a f w, 0, f, 0⟩ : PadeState F) ∧
          PolynomialStored b m' TB cap (traceRemainder a f w) ∧
          MemoryFrame (rootComputeWritable R U D C TB cap) m m') := by
  have hwe : w ≤ E.W := by omega
  have hcapPos : 1 ≤ cap := by omega
  have hf : f ≠ 0 := by intro hz; simp [hz] at hFpos
  have hfdeg : f.natDegree < cap := by omega
  have hwWord : w < 2 ^ E.W := lt_of_le_of_lt hwe (Nat.lt_two_pow_self (n := E.W))
  obtain ⟨hPrepAt, hTraceAt⟩ := At.seqStmt hAt
  have hPrep := rootPrepareProcedure_spec b P E pc R U D C TB ZB cap L src f a m hPrepAt
    hl hwords hp hsrc hSrcWord hsep hmeta hwe hcapPos hf hfdeg
  have hFull := Sem.seq_bound hPrep (fun z _ hQ => by
    obtain ⟨m1, hz, hp1, hr1, ht1, h92, h95, h98, hf01⟩ := hQ
    subst z
    have hTrace := traceProcedure_spec b ι t N P E (pc + 504) R U D C TB L cap w f a m1 hTraceAt
      hw hW hdet ht hL hcap hr1 hl.Tlow hwords.Tword hl.TR hl.TU hl.TD hl.TC ht1 hFpos hF
      hwWord h92 h95 hp1.scalar h98
    refine Sem.mono (Q' := fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 258) * w + 4 ∧
      ∃ m', z = boundaryState (pc + 1021) m' ∧ RootPersistent b R U D C TB ZB cap L src f a m' ∧
        PadeRows b E R U D C L cap m' (⟨traceRemainder a f w, 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap (traceRemainder a f w) ∧
        MemoryFrame (rootComputeWritable R U D C TB cap) m m') hTrace ?_
    intro k z hQ
    obtain ⟨hk, m2, hz, hr2, ht2, _, _, _, _, hf12⟩ := hQ
    have hf12' := hf12.mono (trace_writable_le_root R U D C TB cap)
    exact ⟨hk, m2, hz, hp1.of_compute_frame hl hsrc (hsep.readonly hsrc) hf12', hr2, ht2,
      MemoryFrame.trans hf01 hf12'⟩)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

/-- The first child gcd uses the computed splitter, while retaining a copy
of that splitter and the original factor for the second child. -/
theorem rootFirstGcdProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L src : ℕ) (f p : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootFirstGcdProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : DetAgrees E t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hp : RootPersistent b R U D C TB ZB cap L src f a m)
    (hsrc : 128 ≤ src) (hsep : RootSourceSeparated R U D C TB cap src)
    (hmeta : (108 : ℕ) < 2 ^ E.W)
    (hrows : PadeRows b E R U D C L cap m (⟨p, 0, f, 0⟩ : PadeState F))
    (htrace : PolynomialStored b m TB cap p) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hpf : p.natDegree < f.natDegree) :
    Sem P E pc (pc + 658) (boundaryState pc m)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * L + 17 * cap + 154 ∧
        ∃ m' out, z = boundaryState (pc + 658) m' ∧ m' 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
          PolynomialStored b m' out cap (EuclideanDomain.gcd f p) ∧
          RootPersistent b R U D C TB ZB cap L src f a m' ∧ PolynomialStored b m' TB cap p ∧
          MemoryFrame (rootComputeWritable R U D C TB cap) m m' ∧
          ∀ i < cap, padeWritable R U D C cap (out + i)) := by
  let m1 := swapRowMemory m R U D C
  let m2 := Function.update m1 93 L
  have hSrc := hsep.readonly hsrc
  have hLWord : L < 2 ^ E.W := by have h := hwords.Rword; have h' := hl.rows.Rlow; omega
  have hRWord : R < 2 ^ E.W := by have h := hwords.Rword; omega
  have hUWord : U < 2 ^ E.W := by have h := hwords.Uword; omega
  have hDWord : D < 2 ^ E.W := by have h := hwords.Dword; omega
  have hCWord : C < 2 ^ E.W := by have h := hwords.Cword; omega
  have hf01raw := swapRowMemory_frame m R U D C cap
  have hf01 : MemoryFrame (rootComputeWritable R U D C TB cap) m m1 := hf01raw.mono (by
    intro addr ha
    exact padeWritable_le_rootComputeWritable R U D C TB cap addr ha)
  have hp1 := hp.of_compute_frame hl hsrc hSrc hf01
  have hr1 := hrows.swap_memory
  have ht1 : PolynomialStored b m1 TB cap p := htrace.of_frame hf01raw (by
    intro i hi
    have hT := hl.Tlow
    have hR := hl.TR
    have hU := hl.TU
    have hD := hl.TD
    have hC := hl.TC
    dsimp [padeWritable]
    omega)
  have hp2 := hp1.meta_update hl hsrc hSrc 93 L (by simp [rootComputeMeta])
  have hr2 := hr1.gcdCounter_update L
  have ht2 := ht1.meta_update hl.Tlow 93 L (by norm_num)
  have hf12 : MemoryFrame (rootComputeWritable R U D C TB cap) m1 m2 :=
    MemoryFrame.update_allowed _ m1 93 L (by simp [rootComputeWritable, rootComputeMeta])
  obtain ⟨hSwapAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hCountAt, hGcdAt⟩ := At.seqStmt hRestAt
  have hSwap : Sem P E pc (pc + 40) (boundaryState pc m)
      (fun k z => k ≤ 40 ∧ z = boundaryState (pc + 40) m1) := by
    exact Sem.boundary_block P E _ swapRowsCode m m1 hSwapAt
      (by simp [swapRowsCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (swapRows_spec E _ R U D C (by omega) hRWord hUWord hDWord hCWord
        hrows.ptr72 hrows.ptr73 hrows.ptr74 hrows.ptr75)
  have hCount : Sem P E (pc + 40) (pc + 62) (boundaryState (pc + 40) m1)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 62) m2) := by
    exact Sem.boundary_block P E _ (copyMetaCode 76 93) m1 m2 hCountAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 76 93 L (by omega) (by omega) hLWord hp1.length)
  have hi : GcdInv L (⟨f, 0, p, 0⟩ : PadeState F) := by
    refine ⟨?_, ?_, rfl, rfl⟩
    · change f.natDegree < L; omega
    · change p.natDegree < L; omega
  have hGcd := gcdProcedure_spec b ι t N P E (pc + 62) D C R U L cap (⟨f, 0, p, 0⟩ : PadeState F)
    m2 hGcdAt hw hW hdet (by omega) hcap hr2 hi (by simp [m2])
  obtain ⟨_, kg, zg, hRunG, hPcG, hCostG, out, h97, houtLow, houtWord, hOut, hf23raw, hRegsG, hRangeG⟩ := hGcd
  let m3 := zg.mem
  have hzG : zg = boundaryState (pc + 658) m3 := by
    apply ramState_eq_of
    · exact hPcG
    · rfl
    · intro r
      simpa only [boundaryState] using congrFun hRegsG r
  have hf23 : MemoryFrame (rootComputeWritable R U D C TB cap) m2 m3 := hf23raw.mono (by
    intro addr ha
    dsimp [gcdProcedureWritable, gcdLoopWritable] at ha
    rcases ha with h | h | h
    · subst h
      exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
    · subst h
      exact rootComputeWritable.of_meta (by norm_num [rootComputeMeta])
    · exact padeWritable_le_rootComputeWritable R U D C TB cap addr
        ((padeWritable_swap R U D C cap addr).mp h))
  have hp3 := hp2.of_compute_frame hl hsrc hSrc hf23
  have ht3 : PolynomialStored b m3 TB cap p := ht2.of_frame hf23raw (by
    intro i hi
    have hT := hl.Tlow
    have hR := hl.TR
    have hU := hl.TU
    have hD := hl.TD
    have hC := hl.TC
    dsimp [gcdProcedureWritable, gcdLoopWritable, padeWritable]
    omega)
  have hfne : f ≠ 0 := by intro hz; simp [hz] at hFpos
  have hOut' : PolynomialStored b m3 out cap (EuclideanDomain.gcd f p) := by
    rw [gcd_swap_of_natDegree_lt f p hfne hpf]
    exact hOut
  have hGcdDone : Sem P E (pc + 62) (pc + 658) (boundaryState (pc + 62) m2)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * L + 17 * cap + 92 ∧
        ∃ m' out, z = boundaryState (pc + 658) m' ∧ m' 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
          PolynomialStored b m' out cap (EuclideanDomain.gcd f p) ∧
          RootPersistent b R U D C TB ZB cap L src f a m' ∧ PolynomialStored b m' TB cap p ∧
          MemoryFrame (rootComputeWritable R U D C TB cap) m m' ∧
          ∀ i < cap, padeWritable R U D C cap (out + i)) :=
    ⟨rfl, kg, zg, hRunG, hPcG, hCostG, m3, out, hzG, h97, houtLow, houtWord, hOut', hp3, ht3,
      MemoryFrame.trans (MemoryFrame.trans hf01 hf12) hf23,
      fun i hi => (padeWritable_swap R U D C cap (out + i)).mp (hRangeG i hi)⟩
  have hFull := Sem.seq_bound hSwap (fun z _ hz => by
    subst z
    exact Sem.seq_bound hCount (fun z _ hz => by subst z; exact hGcdDone))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

/-- Change a square/trace polynomial into the other bit-valued splitter. -/
theorem polynomial_sub_one_stored {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (B cap : ℕ) (p : F[X])
    (hp : PolynomialStored b m B cap p) :
    PolynomialStored b (Function.update m B (enc b (p.coeff 0 + 1))) B cap (p - 1) := by
  haveI : CharP F 2 := pinsketch_charP_detFor65
  intro i hi
  by_cases hz : i = 0
  · subst i
    simp [Polynomial.coeff_sub, CharTwo.sub_eq_add]
  · rw [Function.update_of_ne (by omega : B + i ≠ B), hp i hi]
    congr 1
    simp [Polynomial.coeff_sub, Polynomial.coeff_one, hz, Ne.symm hz]

theorem toggleConstant_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (slot B cap : ℕ) (p : F[X])
    (hslot : slot < 2 ^ E.W) (hmeta : (78 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W)
    (hB : B < 2 ^ E.W) (hcap : 1 ≤ cap) (hp : PolynomialStored b s.mem B cap p)
    (hmSlot : s.mem slot = B) (hm78 : s.mem 78 = enc b 1) :
    runBlock (toggleConstantCode slot) E s =
      boundaryState (s.pc + 25) (Function.update s.mem B (enc b (p.coeff 0 + 1))) := by
  have hSlot : slot % 2 ^ E.W = slot := Nat.mod_eq_of_lt hslot
  have h78 : (78 : ℕ) % 2 ^ E.W = 78 := Nat.mod_eq_of_lt hmeta
  have hB0 : B % 2 ^ E.W = B := Nat.mod_eq_of_lt hB
  have hEnc (z : F) : enc b z % 2 ^ E.W = enc b z :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le (enc_lt b z) (Nat.pow_le_pow_right (by norm_num) hwe))
  have hmB : s.mem B = enc b (p.coeff 0) := by simpa only [Nat.add_zero] using hp 0 (by omega)
  let sA := runBlock (toggleReadCode slot) E s
  have hA2 : sA.regs r2 = B := by
    simp [sA, toggleReadCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hSlot, h78, hmSlot, hm78, hB0, hEnc]
  have hA10 : sA.regs r10 = enc b (p.coeff 0) := by
    simp [sA, toggleReadCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hSlot, h78, hmSlot, hm78, hB0, hmB, hEnc]
  have hA11 : sA.regs r11 = enc b 1 := by
    simp [sA, toggleReadCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hSlot, h78, hmSlot, hm78, hB0, hEnc]
  let sB := runBlock [iBxor r10 r10 r11, iSt r2 r10] E sA
  have hmem : sB.mem = Function.update s.mem B (enc b (p.coeff 0 + 1)) := by
    simp [sB, runBlock_cons, runBlock_nil, execInstr, hA2, hA10, hA11,
      ← enc_add_xor, hEnc] <;> rfl
  have hfinish : runBlock (toggleConstantCode slot) E s = boundaryState (sB.pc + 16) sB.mem := by
    have he : runBlock (toggleConstantCode slot) E s = runBlock zeroRegsCode E sB := by
      simp only [toggleConstantCode, runBlock_append] <;> rfl
    rw [he, zeroRegs_spec]
  have hpc : sB.pc + 16 = s.pc + 25 := by
    have h := runBlock_pc (toggleConstantCode slot) E s (by
      simp [toggleConstantCode, toggleReadCode, metaReadCode, zeroRegsCode])
    rw [hfinish] at h
    exact h
  rw [hfinish, hpc, hmem]

/-- A divisor-row update preserves the other three Euclidean rows. -/
theorem PadeRows.replace_rem {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {R U D C L cap : ℕ}
    {m m' : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E R U D C L cap m s) (q : F[X])
    (hf : MemoryFrame (fun addr => D ≤ addr ∧ addr < D + cap) m m')
    (hq : PolynomialStored b m' D cap q) :
    PadeRows b E R U D C L cap m' (⟨s.prevR, s.prevC, q, s.curC⟩ : PadeState F) := by
  have hmeta (slot : ℕ) (hs : slot < 128) : m' slot = m slot := hf slot (by have h' := h.layout.Dlow; omega)
  refine ⟨h.layout, h.Rword, h.Uword, h.Dword, h.Cword,
    h.prevR.of_frame hf (by intro i hi; have h' := h.layout.RD; omega),
    h.prevC.of_frame hf (by intro i hi; have h' := h.layout.UD; omega), hq,
    h.curC.of_frame hf (by intro i hi; have h' := h.layout.DC; omega), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hmeta 72 (by norm_num)).trans h.ptr72
  · exact (hmeta 73 (by norm_num)).trans h.ptr73
  · exact (hmeta 74 (by norm_num)).trans h.ptr74
  · exact (hmeta 75 (by norm_num)).trans h.ptr75
  · exact (hmeta 76 (by norm_num)).trans h.length
  · exact (hmeta 77 (by norm_num)).trans h.dimension
  · exact (hmeta 81 (by norm_num)).trans h.capacity

/-- Restore the parent and saved splitter for the second gcd.  Both dummy
coefficient rows are explicitly cleared from the independent zero source. -/
theorem rootSecondPrepareProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L src : ℕ) (f p : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootSecondPrepareProcedure pc))
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hp : RootPersistent b R U D C TB ZB cap L src f a m)
    (hsrc : 128 ≤ src) (hSrcWord : src + cap ≤ 2 ^ E.W)
    (hsep : RootSourceSeparated R U D C TB cap src)
    (hmeta : (108 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hcap : 1 ≤ cap)
    (htrace : PolynomialStored b m TB cap p) :
    Sem P E pc (pc + 345) (boundaryState pc m)
      (fun k z => k ≤ 48 * cap + 305 ∧ ∃ m', z = boundaryState (pc + 345) m' ∧
        RootPersistent b R U D C TB ZB cap L src f a m' ∧
        PadeRows b E R U D C L cap m' (⟨f, 0, p - 1, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap p ∧ MemoryFrame (rootComputeWritable R U D C TB cap) m m') := by
  have hSrc := hsep.readonly hsrc
  obtain ⟨hResetAt, hRest0⟩ := At.seqStmt hAt
  obtain ⟨hRAt, hRest1⟩ := At.seqStmt hRest0
  obtain ⟨hDAt, hRest2⟩ := At.seqStmt hRest1
  obtain ⟨hUAt, hRest3⟩ := At.seqStmt hRest2
  obtain ⟨hCAt, hToggleAt⟩ := At.seqStmt hRest3
  let m1 := resetRootMemory m R U D C
  have hf01 := resetRootMemory_frame m R U D C TB cap
  have hp1 := hp.of_compute_frame hl hsrc hSrc hf01
  have hT1 : PolynomialStored b m1 TB cap p :=
    (((htrace.meta_update hl.Tlow 72 R (by norm_num)).meta_update hl.Tlow 73 U (by norm_num)).meta_update hl.Tlow 74 D (by norm_num)).meta_update hl.Tlow 75 C (by norm_num)
  have hReset : Sem P E pc (pc + 40) (boundaryState pc m)
      (fun k z => k ≤ 40 ∧ z = boundaryState (pc + 40) m1) := by
    exact Sem.boundary_block P E _ resetRootRowsCode m m1 hResetAt
      (by simp [resetRootRowsCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (resetRootRows_spec E _ R U D C (by omega)
        (by have h := hwords.Rword; omega) (by have h := hwords.Uword; omega)
        (by have h := hwords.Dword; omega) (by have h := hwords.Cword; omega)
        hp.fixedR hp.fixedU hp.fixedD hp.fixedC)
  have hR := rootCopy_spec b P E (pc + 40) R U D C TB ZB cap L src 102 99 R src
    f f a m1 hRAt hl hp1 hsrc hSrc (by simp) (by omega) (by omega) (by omega)
    hwe hcap hsrc hwords.Rword hSrcWord hsep.SR hp1.factor hp1.fixedR hp1.source
  obtain ⟨_, k1, z1, hRun1, hPc1, hCost1, m2, hz1, hStored2, hp2, hf12⟩ := hR
  have hRExact : Sem P E (pc + 40) (pc + 110) (boundaryState (pc + 40) m1)
      (fun k z => k ≤ 12 * cap + 60 ∧ z = boundaryState (pc + 110) m2) :=
    ⟨rfl, k1, z1, hRun1, hPc1, hCost1, hz1⟩
  have hT2 := hT1.after_root_copy hl.Tlow (hl.TR.elim Or.inr Or.inl) hf12
  have hD := rootCopy_spec b P E (pc + 110) R U D C TB ZB cap L src 103 106 D TB
    f p a m2 hDAt hl hp2 hsrc hSrc (by simp) (by omega) (by omega) (by omega)
    hwe hcap hl.Tlow hwords.Dword hwords.Tword hl.TD hT2 hp2.fixedD hp2.fixedT
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, m3, hz2, hStored3, hp3, hf23⟩ := hD
  have hDExact : Sem P E (pc + 110) (pc + 180) (boundaryState (pc + 110) m2)
      (fun k z => k ≤ 12 * cap + 60 ∧ z = boundaryState (pc + 180) m3) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hU := rootCopy_spec b P E (pc + 180) R U D C TB ZB cap L src 104 108 U ZB
    f 0 a m3 hUAt hl hp3 hsrc hSrc (by simp) (by omega) (by omega) (by omega)
    hwe hcap hl.Zlow hwords.Uword hwords.Zword hl.ZU hp3.zero hp3.fixedU hp3.fixedZ
  obtain ⟨_, k3, z3, hRun3, hPc3, hCost3, m4, hz3, hStored4, hp4, hf34⟩ := hU
  have hUExact : Sem P E (pc + 180) (pc + 250) (boundaryState (pc + 180) m3)
      (fun k z => k ≤ 12 * cap + 60 ∧ z = boundaryState (pc + 250) m4) :=
    ⟨rfl, k3, z3, hRun3, hPc3, hCost3, hz3⟩
  have hC := rootCopy_spec b P E (pc + 250) R U D C TB ZB cap L src 105 108 C ZB
    f 0 a m4 hCAt hl hp4 hsrc hSrc (by simp) (by omega) (by omega) (by omega)
    hwe hcap hl.Zlow hwords.Cword hwords.Zword hl.ZC hp4.zero hp4.fixedC hp4.fixedZ
  obtain ⟨_, k4, z4, hRun4, hPc4, hCost4, m5, hz4, hStored5, hp5, hf45⟩ := hC
  have hCExact : Sem P E (pc + 250) (pc + 320) (boundaryState (pc + 250) m4)
      (fun k z => k ≤ 12 * cap + 60 ∧ z = boundaryState (pc + 320) m5) :=
    ⟨rfl, k4, z4, hRun4, hPc4, hCost4, hz4⟩
  have hR3 := hStored2.after_root_copy hl.rows.Rlow (hl.rows.RD.elim Or.inr Or.inl) hf23
  have hR4 := hR3.after_root_copy hl.rows.Rlow (hl.rows.RU.elim Or.inr Or.inl) hf34
  have hR5 := hR4.after_root_copy hl.rows.Rlow (hl.rows.RC.elim Or.inr Or.inl) hf45
  have hD4 := hStored3.after_root_copy hl.rows.Dlow hl.rows.UD hf34
  have hD5 := hD4.after_root_copy hl.rows.Dlow (hl.rows.DC.elim Or.inr Or.inl) hf45
  have hU5 := hStored4.after_root_copy hl.rows.Ulow (hl.rows.UC.elim Or.inr Or.inl) hf45
  have hT3 := hT2.after_root_copy hl.Tlow (hl.TD.elim Or.inr Or.inl) hf23
  have hT4 := hT3.after_root_copy hl.Tlow (hl.TU.elim Or.inr Or.inl) hf34
  have hT5 := hT4.after_root_copy hl.Tlow (hl.TC.elim Or.inr Or.inl) hf45
  have hMeta5 (slot : ℕ) (hlo : 67 ≤ slot) (hhi : slot < 128) : m5 slot = m1 slot := by
    rw [root_copy_meta hf45 hl.rows.Clow hlo hhi, root_copy_meta hf34 hl.rows.Ulow hlo hhi,
      root_copy_meta hf23 hl.rows.Dlow hlo hhi, root_copy_meta hf12 hl.rows.Rlow hlo hhi]
  have hRows5 : PadeRows b E R U D C L cap m5 (⟨f, 0, p, 0⟩ : PadeState F) := by
    refine ⟨hl.rows, hwords.Rword, hwords.Uword, hwords.Dword, hwords.Cword,
      hR5, hU5, hD5, hStored5, ?_, ?_, ?_, ?_, hp5.length, hp5.dimension, hp5.capacity⟩
    · rw [hMeta5 72 (by norm_num) (by norm_num)]; simp [m1, resetRootMemory]
    · rw [hMeta5 73 (by norm_num) (by norm_num)]; simp [m1, resetRootMemory]
    · rw [hMeta5 74 (by norm_num) (by norm_num)]; simp [m1, resetRootMemory]
    · rw [hMeta5 75 (by norm_num) (by norm_num)]; simp [m1, resetRootMemory]
  let m6 := Function.update m5 D (enc b (p.coeff 0 + 1))
  have hf56 : MemoryFrame (fun addr => D ≤ addr ∧ addr < D + cap) m5 m6 :=
    (MemoryFrame.update m5 D _).mono (by intro addr ha; subst addr; omega)
  have hStored6 := polynomial_sub_one_stored b m5 D cap p hD5
  have hRows6 := hRows5.replace_rem (p - 1) hf56 hStored6
  have hT6 : PolynomialStored b m6 TB cap p := hT5.of_frame hf56 (by intro i hi; have h := hl.TD; omega)
  have hf56comp : MemoryFrame (rootComputeWritable R U D C TB cap) m5 m6 := hf56.mono (by
    intro addr ha
    dsimp [rootComputeWritable]
    first | omega | tauto)
  have hp6 := hp5.of_compute_frame hl hsrc hSrc hf56comp
  have hToggle : Sem P E (pc + 320) (pc + 345) (boundaryState (pc + 320) m5)
      (fun k z => k ≤ 25 ∧ z = boundaryState (pc + 345) m6) := by
    exact Sem.boundary_block P E _ (toggleConstantCode 103) m5 m6 hToggleAt
      (by simp [toggleConstantCode, toggleReadCode, metaReadCode, zeroRegsCode])
      (toggleConstant_spec b E _ 103 D cap p (by omega) (by omega) hwe
        (by have h := hwords.Dword; omega) hcap hD5 hp5.fixedD hp5.unit)
  have hf05 : MemoryFrame (rootComputeWritable R U D C TB cap) m m5 :=
    MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans hf01
      (hf12.mono (hl.copy_writable (by simp)))) (hf23.mono (hl.copy_writable (by simp))))
      (hf34.mono (hl.copy_writable (by simp)))) (hf45.mono (hl.copy_writable (by simp)))
  have hFull := Sem.seq_bound hReset (fun z _ hz => by
    subst z
    exact Sem.seq_bound hRExact (fun z _ hz => by
      subst z
      exact Sem.seq_bound hDExact (fun z _ hz => by
        subst z
        exact Sem.seq_bound hUExact (fun z _ hz => by
          subst z
          exact Sem.seq_bound hCExact (fun z _ hz => by subst z; exact hToggle)))))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, m6, hQ.2, hp6, hRows6, hT6, MemoryFrame.trans hf05 hf56comp⟩)

/-- The second child uses the saved trace minus one; it is recomputed from
immutable sources after the first gcd has reused the Euclidean workspace. -/
theorem rootSecondGcdProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L src : ℕ) (f p : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootSecondGcdProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : DetAgrees E t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hp : RootPersistent b R U D C TB ZB cap L src f a m)
    (hsrc : 128 ≤ src) (hSrcWord : src + cap ≤ 2 ^ E.W)
    (hsep : RootSourceSeparated R U D C TB cap src) (hmeta : (108 : ℕ) < 2 ^ E.W)
    (htrace : PolynomialStored b m TB cap p) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hpf : p.natDegree < f.natDegree) :
    Sem P E pc (pc + 963) (boundaryState pc m)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * L + 65 * cap + 419 ∧
        ∃ m' out, z = boundaryState (pc + 963) m' ∧ m' 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
          PolynomialStored b m' out cap (EuclideanDomain.gcd f (p - 1)) ∧
          RootPersistent b R U D C TB ZB cap L src f a m' ∧ PolynomialStored b m' TB cap p ∧
          MemoryFrame (rootComputeWritable R U D C TB cap) m m' ∧
          ∀ i < cap, padeWritable R U D C cap (out + i)) := by
  have hwe : w ≤ E.W := by omega
  have hcapPos : 1 ≤ cap := by omega
  have hLWord : L < 2 ^ E.W := by have h := hwords.Rword; have h' := hl.rows.Rlow; omega
  have hminus : (p - 1).natDegree < f.natDegree :=
    lt_of_le_of_lt (by simpa using Polynomial.natDegree_sub_le p (1 : F[X])) hpf
  have hf : f ≠ 0 := by intro hz; simp [hz] at hFpos
  obtain ⟨hPrepAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hCountAt, hGcdAt⟩ := At.seqStmt hRestAt
  have hPrep := rootSecondPrepareProcedure_spec b P E pc R U D C TB ZB cap L src f p a m
    hPrepAt hl hwords hp hsrc hSrcWord hsep hmeta hwe hcapPos htrace
  have hFull := Sem.seq_bound hPrep (fun z _ hQ => by
    obtain ⟨m1, hz, hp1, hr1, ht1, hf01⟩ := hQ
    subst z
    let m2 := Function.update m1 93 L
    have hp2 := hp1.meta_update hl hsrc (hsep.readonly hsrc) 93 L (by simp [rootComputeMeta])
    have hr2 := hr1.gcdCounter_update L
    have ht2 := ht1.meta_update hl.Tlow 93 L (by norm_num)
    have hf12 : MemoryFrame (rootComputeWritable R U D C TB cap) m1 m2 :=
      MemoryFrame.update_allowed _ m1 93 L (by simp [rootComputeWritable, rootComputeMeta])
    have hCount : Sem P E (pc + 345) (pc + 367) (boundaryState (pc + 345) m1)
        (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 367) m2) := by
      exact Sem.boundary_block P E _ (copyMetaCode 76 93) m1 m2 hCountAt
        (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
        (copyMeta_spec E _ 76 93 L (by omega) (by omega) hLWord hp1.length)
    have hi : GcdInv L (⟨f, 0, p - 1, 0⟩ : PadeState F) := by
      refine ⟨?_, ?_, rfl, rfl⟩
      · change f.natDegree < L; omega
      · change (p - 1).natDegree < L; omega
    have hGcd := gcdProcedure_spec b ι t N P E (pc + 367) R U D C L cap (⟨f, 0, p - 1, 0⟩ : PadeState F)
      m2 hGcdAt hw hW hdet (by omega) hcap hr2 hi (by simp [m2])
    obtain ⟨_, kg, zg, hRunG, hPcG, hCostG, out, h97, houtLow, houtWord, hOut, hf23raw, hRegsG, hRangeG⟩ := hGcd
    let m3 := zg.mem
    have hzG : zg = boundaryState (pc + 963) m3 := by
      apply ramState_eq_of
      · exact hPcG
      · rfl
      · intro r
        simpa only [boundaryState] using congrFun hRegsG r
    have hf23 : MemoryFrame (rootComputeWritable R U D C TB cap) m2 m3 :=
      hf23raw.mono (gcd_writable_le_root R U D C TB cap)
    have hp3 := hp2.of_compute_frame hl hsrc (hsep.readonly hsrc) hf23
    have ht3 : PolynomialStored b m3 TB cap p := ht2.of_frame hf23raw (by
      intro i hi
      have hT := hl.Tlow
      have hR := hl.TR
      have hU := hl.TU
      have hD := hl.TD
      have hC := hl.TC
      dsimp [gcdProcedureWritable, gcdLoopWritable, padeWritable]
      omega)
    have hOut' : PolynomialStored b m3 out cap (EuclideanDomain.gcd f (p - 1)) := by
      rw [gcd_swap_of_natDegree_lt f (p - 1) hf hminus]
      exact hOut
    have hGcdDone : Sem P E (pc + 367) (pc + 963) (boundaryState (pc + 367) m2)
        (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * L + 17 * cap + 92 ∧
          ∃ m' out, z = boundaryState (pc + 963) m' ∧ m' 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
            PolynomialStored b m' out cap (EuclideanDomain.gcd f (p - 1)) ∧
            RootPersistent b R U D C TB ZB cap L src f a m' ∧ PolynomialStored b m' TB cap p ∧
            MemoryFrame (rootComputeWritable R U D C TB cap) m m' ∧
          ∀ i < cap, padeWritable R U D C cap (out + i)) :=
      ⟨rfl, kg, zg, hRunG, hPcG, hCostG, m3, out, hzG, h97, houtLow, houtWord, hOut', hp3, ht3,
        MemoryFrame.trans (MemoryFrame.trans hf01 hf12) hf23, hRangeG⟩
    exact Sem.seq_bound hCount (fun z _ hz => by subst z; exact hGcdDone))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem RootWorkspace.compute_meta_readonly {R U D C TB ZB cap : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (slot : ℕ) (hs : slot < 128) (hn : ¬ rootComputeMeta slot) :
    ¬ rootComputeWritable R U D C TB cap slot := by
  have hR := h.rows.Rlow
  have hU := h.rows.Ulow
  have hD := h.rows.Dlow
  have hC := h.rows.Clow
  have hT := h.Tlow
  dsimp [rootComputeWritable]
  intro hbad
  rcases hbad with hmeta | hR' | hU' | hD' | hC' | hT'
  · exact hn hmeta
  all_goals omega

theorem RootSourceSeparated.node_readonly {R U D C TB cap src QB T : ℕ}
    (h : RootSourceSeparated R U D C TB cap src) (hsrc : 128 ≤ src)
    (hQ : src + cap ≤ QB ∨ QB + T * cap ≤ src) (i : ℕ) (hi : i < cap) :
    ¬ rootNodeWritable R U D C TB cap QB T (src + i) := by
  intro hbad
  rcases hbad with h90 | hwork | hqueue
  · omega
  · exact h.readonly hsrc i hi hwork
  · omega

theorem FrontierStored.of_compute_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m m' : ℕ → ℕ}
    {R U D C TB ZB cap QB T : ℕ} {fs : List F[X]}
    (h : FrontierStored b m QB cap fs) (hq : QueueWorkspaceSeparated R U D C TB ZB cap QB T)
    (hQB : 128 ≤ QB) (hn : fs.length ≤ T)
    (hf : MemoryFrame (rootComputeWritable R U D C TB cap) m m') : FrontierStored b m' QB cap fs := by
  intro j hj
  apply (h j hj).of_frame hf
  intro i hi
  have hprod := Nat.zero_le (j * cap)
  exact hq.readonly hQB _ (by omega) (queue_slot_before_next QB cap T j i (by omega) hi)

theorem queue_keep_writable_le_whole (QB T cap n degree addr : ℕ)
    (hroom : 0 < degree → n < T) (h : queueKeepWritable QB n cap degree addr) :
    wholeQueueWritable QB T cap addr := by
  by_cases hp : 0 < degree
  · have hn := hroom hp
    have hm : (n + 1) * cap ≤ T * cap := Nat.mul_le_mul_right cap (by omega)
    have he : (n + 1) * cap = n * cap + cap := by ring
    dsimp [queueKeepWritable] at h
    dsimp [wholeQueueWritable]
    omega
  · dsimp [queueKeepWritable] at h
    dsimp [wholeQueueWritable]
    omega

theorem PolynomialStored.after_queue_keep {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m m' : ℕ → ℕ} {B QB T cap n degree : ℕ} {f : F[X]}
    (h : PolynomialStored b m B cap f) (hB : 128 ≤ B) (hsep : B + cap ≤ QB ∨ QB + T * cap ≤ B)
    (hroom : 0 < degree → n < T)
    (hf : MemoryFrame (queueKeepWritable QB n cap degree) m m') : PolynomialStored b m' B cap f := by
  apply h.of_frame (hf.mono (fun addr ha => queue_keep_writable_le_whole QB T cap n degree addr hroom ha))
  intro i hi
  dsimp [wholeQueueWritable]
  omega

/-- A complete breadth-first root node: modular trace, the two gcd branches,
and bounded appends to the next frontier. -/
theorem rootNodeProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L src QB T : ℕ) (f : F[X]) (a : F) (gs : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootNodeProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : DetAgrees E t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hp : RootPersistent b R U D C TB ZB cap L src f a m)
    (hsrc : 128 ≤ src) (hSrcWord : src + cap ≤ 2 ^ E.W) (hsep : RootSourceSeparated R U D C TB cap src)
    (hQB : 128 ≤ QB) (hQWord : QB + T * cap ≤ 2 ^ E.W)
    (hQSep : QueueWorkspaceSeparated R U D C TB ZB cap QB T)
    (hSrcQ : src + cap ≤ QB ∨ QB + T * cap ≤ src) (hmeta : (108 : ℕ) < 2 ^ E.W)
    (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hgs : FrontierStored b m QB cap gs) (hgsPos : ∀ g ∈ gs, 0 < g.natDegree)
    (hbudget : frontierMass gs + f.natDegree ≤ T) (hm84 : m 84 = QB) (hm90 : m 90 = gs.length) :
    Sem P E pc (pc + 3060) (boundaryState pc m)
      (fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 258) * w +
          2 * ((17 * cap + (48 * L + 187) * L + 228) * L) + 217 * cap + 1350 ∧
        ∃ m', z = boundaryState (pc + 3060) m' ∧ RootPersistent b R U D C TB ZB cap L src f a m' ∧
          m' 90 = ((gs ++ keepFactor (EuclideanDomain.gcd f (traceRemainder a f w))) ++
            keepFactor (EuclideanDomain.gcd f (traceRemainder a f w - 1))).length ∧
          FrontierStored b m' QB cap ((gs ++ keepFactor (EuclideanDomain.gcd f (traceRemainder a f w))) ++
