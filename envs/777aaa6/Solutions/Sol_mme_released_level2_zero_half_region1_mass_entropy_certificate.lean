abbrev Z := {c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1) // ∃ j, (c.2.val j).val = 0}

def md (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) : Fin 3 :=
  if (c.2.val 0).val = 0 then 1 else if (c.2.val 1).val = 0 then 2 else 0

def Mc (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) : ℕ :=
  m3 1 c.1 c.2 + m3 1 c.1 (complement (htotal3 1 c.1) c.2)

def dv (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) (w : CompleteSplit.CompleteWord 2) : ℕ :=
  (cellDist 1 (md c) c.1 c.2).getD (3 * (w 0).val + (w 1).val) 0

theorem D_dvd (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) : D ∣ Mc c := by
  unfold Mc m3
  exact dvd_add (Dvd.dvd.mul_left (dvd_pow_self D two_ne_zero) _)
    (Dvd.dvd.mul_left (dvd_pow_self D two_ne_zero) _)

theorem mu3_eq (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) (w : CompleteSplit.CompleteWord 2) :
    mu3 1 (md c) c w = Mc c / D * dv c w := by
  show Mc c * dv c w / D = _
  rw [Nat.div_mul_right_comm (D_dvd c)]

def pq (c : Cell (2 * 2 ^ (2 - 1)) 88 (RecStage.parent3 1)) (w : CompleteSplit.CompleteWord 2) : ℚ :=
  (dv c w : ℚ) / 10 ^ 12

inductive KT where
  | leaf : KT
  | node : KT → ℕ → ℕ × ℕ × ℕ → KT → KT

def KT.find : KT → ℕ → Option (ℕ × ℕ × ℕ)
  | .leaf, _ => none
  | .node l k v r, d =>
    if Nat.blt d k then l.find d else if Nat.beq d k then some v else r.find d

def KT.toList : KT → List (ℕ × ℕ × ℕ × ℕ)
  | .leaf => []
  | .node l k v r => l.toList ++ (k, v) :: r.toList

theorem KT.find_mem : ∀ (t : KT) (d : ℕ) (v : ℕ × ℕ × ℕ), t.find d = some v → (d, v) ∈ t.toList
  | .leaf, d, v, h => by simp [KT.find] at h
  | .node l k v' r, d, v, h => by
    simp only [KT.find] at h
    split_ifs at h with h1 h2
    · exact List.mem_append_left _ (KT.find_mem l d v h)
    · have hdk : d = k := Nat.eq_of_beq_eq_true h2
      subst hdk
      simp only [Option.some.injEq] at h
      subst h
      simp [KT.toList]
    · simp [KT.toList, KT.find_mem r d v h]

