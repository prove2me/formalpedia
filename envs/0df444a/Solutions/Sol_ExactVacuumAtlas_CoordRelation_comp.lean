open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.CoordRelation
variable {g₁ g₂ g₃ : Metric 4} {U V W : Set (Pt 4)} {Φ₁ Ψ₁ Φ₂ Ψ₂ : Pt 4 → Pt 4}
  {J₁ J₂ : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}
theorem solution (hV : IsOpen V) (h₁ : CoordRelation g₁ g₂ U V Φ₁ Ψ₁ J₁)
    (h₂ : CoordRelation g₂ g₃ V W Φ₂ Ψ₂ J₂) :
    CoordRelation g₁ g₃ U W (fun x => Φ₂ (Φ₁ x)) (fun z => Ψ₁ (Ψ₂ z))
      (fun x => J₂ (Φ₁ x) * J₁ x) where
  left_inv x hx := by rw [h₂.left_inv _ (h₁.bijOn.mapsTo hx), h₁.left_inv x hx]
  right_inv z hz := by rw [h₁.right_inv _ (h₂.bijOn_inv.mapsTo hz), h₂.right_inv z hz]
  bijOn := h₂.bijOn.comp h₁.bijOn
  smooth := h₂.smooth.comp h₁.smooth h₁.bijOn.mapsTo
  smooth_inv := h₁.smooth_inv.comp h₂.smooth_inv h₂.bijOn_inv.mapsTo
  jacobian x hx k i := jacobian_comp hV h₁ h₂ hx k i
  pullback x hx := by
    have e₁ := h₁.pullback x hx
    have e₂ := h₂.pullback (Φ₁ x) (h₁.bijOn.mapsTo hx)
    rw [← e₁, ← e₂]
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
