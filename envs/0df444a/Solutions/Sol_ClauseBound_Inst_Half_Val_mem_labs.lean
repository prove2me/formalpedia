open ClauseBound ClauseBound.Inst ClauseBound.Inst.Half
open Groundwork PaddedDescent.F ClauseBound.Alg ClauseBound.Inst.Rec Finset
open ClauseBound.Inst.Half.Val
namespace ClauseBound.Inst.Half.Val
theorem _root_.solution {T : PT} {tr : Bool} {h : ℕ} {s : ℤ} {p : ℕ × List ℕ} (hp : p ∈ labs T tr h s) : p.1 ≤ 2 * h ∧ p.2 ∈ T.flatten := by
  obtain ⟨j, hj, hp⟩ := List.mem_flatMap.1 hp
  split_ifs at hp
  · obtain ⟨τ, hτ, rfl⟩ := List.mem_map.1 hp
    exact ⟨Nat.lt_succ_iff.1 (List.mem_range.1 hj), mem_flatten_of_mem_getD hτ⟩
  · simp at hp
end ClauseBound.Inst.Half.Val
