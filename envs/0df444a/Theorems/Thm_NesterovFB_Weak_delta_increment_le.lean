-- title:
--   §1.3, proof of Theorem 3, p. 5 — δ_{k+1} − δ_k ≤ 2(k + α − 1)‖x_k − x_{k−1}‖²
-- statement:
--   Let $\mathcal H$, $\Psi$, $\Phi$, $L$, $s$, $\alpha>3$ and the sequence $(x_k)$ generated by algorithm (2) be as in Theorem 3, and let $x^*\in\operatorname{argmin}(\Psi+\Phi)$. Define
--   $$\delta_k = (k-1)\big[\|x_k - x^*\|^2 - \|x_{k-1}-x^*\|^2\big] + (\alpha-1)\|x_k - x^*\|^2 .$$
--   Then for every $k\ge1$,
--
--   $$\delta_{k+1}-\delta_k \le 2(k+\alpha-1)\,\|x_k - x_{k-1}\|^2 .$$
--
--   Combined with the summability of $k\|x_k-x_{k-1}\|^2$ (a consequence of the energy estimates of the paper) and the boundedness of $(\delta_k)$, this one-sided bound forces $(\delta_k)$ to converge, which is the key step towards the convergence of $\|z_k - x^*\|$.
--
--   **Formalization Note** Conventions as in the other items of this mission: $L\ge0$, $0<s$, $sL<1$, the proximal map as a map $P$ with the minimization property, the run from $k=1$.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 5, §1.3, proof of Theorem 3, definition of δ_k, (17) and the last display before "Since the right-hand side is summable"

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Weak_Algorithm
open Filter Topology NNReal

namespace NesterovFB.Weak

theorem delta_increment_le
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : ℝ≥0) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hα : 3 < α)
    (hrun : NesterovFB.Rates.IsAccelFBRun Φ P α s x)
    (xstar : H) (hxstar : ∀ y, NesterovFB.Rates.theta Ψ Φ xstar ≤ NesterovFB.Rates.theta Ψ Φ y) :
    ∀ k : ℕ, 1 ≤ k →
      deltaSeq α x xstar (k + 1) - deltaSeq α x xstar k ≤
        2 * ((k : ℝ) + α - 1) * ‖x k - x (k - 1)‖ ^ 2 := by sorry

end NesterovFB.Weak
