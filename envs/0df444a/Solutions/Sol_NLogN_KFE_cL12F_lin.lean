/-!
# KFE: closed fine cost bound of the Lemma 12 program

* `cL12F_lin`: `cL12F ≤ Av·(Vb+1)(Kp+1) + Ao·(Bb+2)²(u+1) + Σ_j digit_j · cO j` — the data passes
  are linear in the bit volume `Vb` (no `(Bb+2)` factor); the descriptor work costs
  `O((u+1)(Bb+2)²)`.
* `calls_le`: the per-call overhead of the oracle, `Σ_{j<L} digit_j (S+1)^j ≤ m·n^(c+1)` with
  `c = clog_m (S+1)`: the number of Prop. 11 calls is polynomial in `n ≤ u`.
* `cL12F_le`: with the fine oracle cost `ilCostF` and `S/W < m^τ`,
  `cL12F ≤ K·((Vb + 1)·u^τ + (u+1)^(c+1)·(Bb+2)²)`, `c = clog_m (S+1)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFE

open IntMul RS AModel AModelL12 Finset KIL KFD

set_option maxHeartbeats 4000000 in
theorem cL12F_lin_sol_aux {q m W u e Kp r n Vb Vq V' : ℕ} (cO : ℕ → ℕ) (B : ℕ) (hm : 2 ≤ m)
    (hq : 2 ≤ q) (h1 : e ≤ u) (h3 : Vq ≤ q ^ 2 * Vb) (h4 : r ≤ W * Kp) (h5 : n ≤ e)
    (h6 : n ≠ 0 → V' ≤ 2 * Vq) (h7 : Kp ≤ u) :
    cL12F u e r Kp n Vq V' m q cO B ≤ Av q W * ((Vb + 1) * (Kp + 1)) +
      Ao m W * ((B + 2) ^ 2 * (u + 1)) +
      ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j := by
  set X := (B + 2) ^ 2 with hXd
  have hX1 : 1 ≤ X := Nat.one_le_pow _ _ (by omega)
  have hBX : B + 2 ≤ X := Nat.le_self_pow (by norm_num) _
  set U := X * (u + 1) with hU
  have hXU : X ≤ U := Nat.le_mul_of_pos_right _ (by omega)
  have hU1 : 1 ≤ U := le_trans hX1 hXU
  set Z := (Vb + 1) * (Kp + 1) with hZ
  have hVbZ : Vb ≤ Z := le_trans (Nat.le_succ _) (Nat.le_mul_of_pos_right _ (by omega))
  have hVqZ : Vq ≤ q ^ 2 * Z := le_trans h3 (Nat.mul_le_mul_left _ hVbZ)
  set D := ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * cO j with hDd
  -- 1. the descriptor
  have T1 : cPreA u e B ≤ 7 * 10 ^ 9 * U := by
    unfold cPreA
    rw [← hXd, hU]
    have : u + 2 * e + 4 ≤ 7 * (u + 1) := by omega
    calc 10 ^ 9 * (u + 2 * e + 4) * X ≤ 10 ^ 9 * (7 * (u + 1)) * X :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
      _ = 7 * 10 ^ 9 * (X * (u + 1)) := by ring
  -- 2. the four binary paddings
  have T2 : 4 * (10 ^ 9 * X + cPadF Vq B) ≤ (4 * 10 ^ 9 + 8008) * U + 80000 * (q ^ 2 * Z) := by
    unfold cPadF
    have := Nat.mul_le_mul_left 80000 hVqZ
    have : B + 2 ≤ U := le_trans hBX hXU
    nlinarith
  -- 3. the swaps
  have T3 : (r + 1) * (cSw1F q Vq B + 10 ^ 4 * (B + 2)) ≤
      (W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) + (W + 1) * (10 ^ 9 + 10 ^ 4) * U := by
    unfold cSw1F
    have a : r + 1 ≤ (W + 1) * (Kp + 1) := by nlinarith
    have b1 : (r + 1) * ((4 * q + 136) * 276 * Vq) ≤ (W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) := by
      calc (r + 1) * ((4 * q + 136) * 276 * Vq) ≤ ((W + 1) * (Kp + 1)) * ((4 * q + 136) * 276 * (q ^ 2 * Vb)) :=
            Nat.mul_le_mul a (Nat.mul_le_mul_left _ h3)
        _ ≤ ((W + 1) * (Kp + 1)) * ((4 * q + 136) * 276 * (q ^ 2 * (Vb + 1))) :=
            Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.le_succ _)))
        _ = (W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) := by rw [hZ]; ring
    have b2 : (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) ≤ (W + 1) * (10 ^ 9 + 10 ^ 4) * U := by
      calc (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) ≤ ((W + 1) * (Kp + 1)) * ((10 ^ 9 + 10 ^ 4) * X) :=
            Nat.mul_le_mul a (by nlinarith)
        _ ≤ ((W + 1) * (u + 1)) * ((10 ^ 9 + 10 ^ 4) * X) :=
            Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
        _ = (W + 1) * (10 ^ 9 + 10 ^ 4) * U := by rw [hU]; ring
    have e : (r + 1) * ((4 * q + 136) * 276 * Vq + 10 ^ 9 * X + 10 ^ 4 * (B + 2)) =
        (r + 1) * ((4 * q + 136) * 276 * Vq) + (r + 1) * (10 ^ 9 * X + 10 ^ 4 * (B + 2)) := by ring
    rw [e]; exact Nat.add_le_add b1 b2
  -- 4. the middle part
  have T4 : (if n = 0 then 0 else cMidF Kp V' m n cO B) + 26 ≤
      (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) * U + 80000 * (q ^ 2 * Z) + D := by
    split_ifs with hn
    · nlinarith
    · unfold cMidF cPadF
      have hL := digits_len_le hm (show 1 ≤ n by omega)
      have hP := cPcs_le m n cO B hm
      rw [← hDd] at hP
      have hV' := h6 hn
      have a : 10 ^ 9 * (Kp + 3) * X ≤ 3 * 10 ^ 9 * U := by
        calc 10 ^ 9 * (Kp + 3) * X ≤ 10 ^ 9 * (3 * (u + 1)) * X :=
              Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ (by omega))
          _ = 3 * 10 ^ 9 * U := by rw [hU]; ring
      have b : 40000 * V' ≤ 80000 * (q ^ 2 * Z) := by
        have := Nat.mul_le_mul_left 2 hVqZ
        omega
      have c : ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X ≤
          (3 * m + 7) * 10 ^ 9 * U := by
        have c1 : (3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2) ≤ (3 * m + 7) * (u + 1) := by
          nlinarith
        calc ((3 * m + 3) * (Nat.digits m n).length + 2 * (n + 2)) * 10 ^ 9 * X
            ≤ ((3 * m + 7) * (u + 1)) * 10 ^ 9 * X :=
              Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ c1)
          _ = (3 * m + 7) * 10 ^ 9 * U := by rw [hU]; ring
      have d : 2 * (2000 * (B + 2)) ≤ 4000 * U := by
        have := le_trans hBX hXU
        linarith
      generalize cPcs m n cO B = CP at hP ⊢
      rw [← hXd] at hP ⊢
      nlinarith
  have T5 : 25 * (2 * B + 2) + 1 ≤ 51 * U := by
    have : B + 2 ≤ U := le_trans hBX hXU
    omega
  -- the constants
  have hA : 80000 * q ^ 2 + (W + 1) * ((4 * q + 136) * 276) * q ^ 2 + 80000 * q ^ 2 ≤ Av q W := by
    unfold Av
    have e1 : q ^ 2 ≤ (q + 1) ^ 3 := by nlinarith
    have e2 : (4 * q + 136) * 276 * q ^ 2 ≤ 37536 * (q + 1) ^ 3 := by nlinarith
    have e3 : 1 ≤ W + 1 := by omega
    have := Nat.mul_le_mul_left (W + 1) e2
    nlinarith
  have hO : 7 * 10 ^ 9 + (4 * 10 ^ 9 + 8008) + (W + 1) * (10 ^ 9 + 10 ^ 4) +
      (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) + 51 ≤ Ao m W := by
    unfold Ao
    nlinarith
  unfold cL12F
  have hZ0 : 0 ≤ Z := Nat.zero_le _
  calc _ ≤ 7 * 10 ^ 9 * U + ((4 * 10 ^ 9 + 8008) * U + 80000 * (q ^ 2 * Z)) +
        ((W + 1) * ((4 * q + 136) * 276) * (q ^ 2 * Z) + (W + 1) * (10 ^ 9 + 10 ^ 4) * U) +
        ((3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) * U + 80000 * (q ^ 2 * Z) + D) +
        51 * U := by
          have := Nat.add_le_add (Nat.add_le_add (Nat.add_le_add (Nat.add_le_add T1 T2) T3) T4) T5
          simpa only [add_assoc] using this
    _ = (80000 * q ^ 2 + (W + 1) * ((4 * q + 136) * 276) * q ^ 2 + 80000 * q ^ 2) * Z +
        (7 * 10 ^ 9 + (4 * 10 ^ 9 + 8008) + (W + 1) * (10 ^ 9 + 10 ^ 4) +
          (3 * 10 ^ 9 + 4000 + (3 * m + 7) * 10 ^ 9 + 26) + 51) * U + D := by ring
    _ ≤ Av q W * Z + Ao m W * U + D :=
        Nat.add_le_add_right (Nat.add_le_add (Nat.mul_le_mul_right _ hA) (Nat.mul_le_mul_right _ hO)) _

