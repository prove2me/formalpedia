-- title:
--   Conic hull
-- statement:
--   The **conic hull** of a set: all finite nonnegative combinations of its elements.
--
--   For $K \subseteq \mathbb{R}^n$,
--
--   $$\operatorname{cone}(K) \;=\; \Bigl\{\, \sum_{i=1}^{m} \theta_i u_i \;:\; m \in \mathbb{N},\ \theta_i \ge 0,\ u_i \in K \,\Bigr\},$$
--
--   the smallest convex cone containing $K$ (the empty combination gives $0$, so $0 \in \operatorname{cone}(K)$ always).
--
--   The conic hull is to cones what the convex hull is to convex sets, and it is the object that appears on the far side of the bidualization theorem: $K^{**} = \overline{\operatorname{cone}(K)}$. It is also the feasible geometry underlying conic programming, where a cone is presented by a set of generators.
--
--   **Formalization Note** The combination length `m` is existentially quantified, with coefficients `θ : Fin m → ℝ` and generators `u : Fin m → EuclideanSpace ℝ (Fin n)`; nothing is assumed about `K`. Source: B&V §2.1.5, p. 25.
-- source:
--   Boyd & Vandenberghe 2004, Convex Optimization, Cambridge University Press (seventh printing with corrections, 2009), https://web.stanford.edu/~boyd/cvxbook/, pp. 25, §2.1.5 (conic hull)

import Mathlib

open scoped RealInnerProductSpace ENNReal
open MeasureTheory

namespace ConvexOptimization

/-- **Conic hull**: all finite nonnegative combinations of elements of `K`
(the convex hull of the cone generated by `K`, plus `0`). -/
def conicHull {n : ℕ} (K : Set (EuclideanSpace ℝ (Fin n))) :
    Set (EuclideanSpace ℝ (Fin n)) :=
  {z | ∃ (m : ℕ) (θ : Fin m → ℝ) (u : Fin m → EuclideanSpace ℝ (Fin n)),
    (∀ i, 0 ≤ θ i) ∧ (∀ i, u i ∈ K) ∧ z = ∑ i, θ i • u i}

end ConvexOptimization


