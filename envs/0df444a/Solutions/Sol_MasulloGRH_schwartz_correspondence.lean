namespace LCA

/-- If `‖j • t‖ ≤ 1/4` for `j = 1, …, M` then `‖t‖ ≤ 1/(4M)`. -/
lemma circle_small (t : UnitAddCircle) (M : ℕ) (hM : 0 < M)
    (h : ∀ j : ℕ, 1 ≤ j → j ≤ M → ‖j • t‖ ≤ 1 / 4) : ‖t‖ ≤ 1 / (4 * M) := by
  obtain ⟨u, hu, rfl⟩ : ∃ u : ℝ, |u| ≤ 1 / 2 ∧ (u : UnitAddCircle) = t := by
    refine ⟨(AddCircle.equivIoc 1 (-1 / 2) t : ℝ), ?_, ?_⟩
    · have h1 := (AddCircle.equivIoc 1 (-1 / 2) t).2
      rw [abs_le]; constructor
      · linarith [h1.1]
      · linarith [h1.2]
    · exact (AddCircle.equivIoc 1 (-1 / 2)).symm_apply_apply t
  have hn : ∀ x : ℝ, |x| ≤ 1 / 2 → ‖(x : UnitAddCircle)‖ = |x| := fun x hx =>
    (AddCircle.norm_coe_eq_abs_iff (p := 1) one_ne_zero).2 (by simpa using hx)
  rw [hn u hu]
  have hMpos : (0 : ℝ) < M := by exact_mod_cast hM
  by_contra hcon
  push Not at hcon
  have hupos : 0 < |u| := lt_of_le_of_lt (by positivity) hcon
  by_cases hq : |u| ≤ 1 / 4
  · set j := ⌊1 / (4 * |u|)⌋₊ + 1 with hjdef
    have hj1 : (1 / (4 * |u|) : ℝ) < j := by
      have := Nat.lt_floor_add_one (1 / (4 * |u|)); push_cast [hjdef]; linarith
    have hj2 : (j : ℝ) ≤ 1 / (4 * |u|) + 1 := by
      have := Nat.floor_le (show (0 : ℝ) ≤ 1 / (4 * |u|) by positivity); push_cast [hjdef]; linarith
    have hjM : j ≤ M := by
      have h1 : (1 / (4 * |u|) : ℝ) < M := by
        rw [div_lt_iff₀ (by positivity)]
        rw [div_lt_iff₀ (by positivity)] at hcon
        nlinarith
      have : ⌊1 / (4 * |u|)⌋₊ < M := Nat.floor_lt' (by omega) |>.2 h1
      omega
    have hA : 1 / 4 < (j : ℝ) * |u| := by
      have := mul_lt_mul_of_pos_right hj1 hupos
      have e : 1 / (4 * |u|) * |u| = 1 / 4 := by field_simp
      linarith
    have hB : (j : ℝ) * |u| ≤ 1 / 2 := by
      have := mul_le_mul_of_nonneg_right hj2 hupos.le
      have e : (1 / (4 * |u|) + 1) * |u| = 1 / 4 + |u| := by field_simp
      linarith
    have hj := h j (by omega) hjM
    rw [← AddCircle.coe_nsmul, nsmul_eq_mul, hn _ (by rw [abs_mul, Nat.abs_cast]; linarith),
      abs_mul, Nat.abs_cast] at hj
    linarith
  · have h1 := h 1 le_rfl (by omega)
    rw [one_smul, hn u hu] at h1
    linarith

/-- Continuous characters of `ℝ`. -/
lemma charR (g : ℝ → UnitAddCircle) (hg : ∀ s t, g (s + t) = g s + g t) (hgc : Continuous g) :
    ∃ c : ℝ, ∀ t, g t = ((c * t : ℝ) : UnitAddCircle) := by
  let q : Multiplicative ℝ →* Multiplicative UnitAddCircle :=
    AddMonoidHom.toMultiplicative (QuotientAddGroup.mk' _)
  have hq : ∀ x, q x = Multiplicative.ofAdd ((Multiplicative.toAdd x : ℝ) : UnitAddCircle) :=
    fun _ => rfl
  have hqc : Continuous q :=
    continuous_ofAdd.comp (QuotientAddGroup.continuous_mk.comp continuous_toAdd)
  have hqo : IsOpenMap q :=
    isOpenMap_ofAdd'.comp (QuotientAddGroup.isOpenMap_coe.comp isOpenMap_toAdd')
  have hloc : ∃ N ∈ 𝓝 (1 : Multiplicative ℝ), ∀ x ∈ N, ∀ y ∈ N, q x = q y → x = y := by
    refine ⟨Multiplicative.toAdd ⁻¹' Metric.ball 0 (1 / 4),
      continuous_toAdd.continuousAt.preimage_mem_nhds (Metric.ball_mem_nhds _ (by norm_num)), ?_⟩
    intro x hx y hy hxy
    rw [hq, hq] at hxy
    have h1 : ((Multiplicative.toAdd x : ℝ) : UnitAddCircle) = (Multiplicative.toAdd y : ℝ) :=
      Multiplicative.ofAdd.injective hxy
    obtain ⟨n, hn⟩ := (QuotientAddGroup.eq).1 h1
    simp only [Metric.mem_ball, dist_zero_right, Real.norm_eq_abs, mem_preimage] at hx hy
    have hn' : (n : ℝ) = -Multiplicative.toAdd x + Multiplicative.toAdd y := by
      simpa using hn
    have : |(n : ℝ)| < 1 := by
      rw [hn']
      have h2 := abs_add_le (-Multiplicative.toAdd x) (Multiplicative.toAdd y)
      rw [abs_neg] at h2
      linarith
    have hn0 : n = 0 := by
      have h : |n| < 1 := by exact_mod_cast this
      rw [abs_lt] at h
      omega
    rw [hn0, Int.cast_zero] at hn'
    have : Multiplicative.toAdd x = Multiplicative.toAdd y := by linarith
    exact Multiplicative.toAdd.injective this
  have hopen : ∀ N ∈ 𝓝 (1 : Multiplicative ℝ), ∃ V ∈ 𝓝 (1 : Multiplicative UnitAddCircle),
      ∀ y ∈ V, y ∈ q.range → ∃ x ∈ N, q x = y := by
    intro N hN
    refine ⟨q '' N, ?_, fun y hy _ => hy⟩
    have := hqo.image_mem_nhds hN
    rwa [map_one] at this
  obtain ⟨G', hG'c, hG'hom, hG'q⟩ := lift_one_param q hqc hloc hopen
    (fun t => Multiplicative.ofAdd (g t)) (fun s t => by rw [hg, ofAdd_add])
    (continuous_ofAdd.comp hgc) (fun t => by
      obtain ⟨x, hx⟩ := QuotientAddGroup.mk_surjective (g t)
      exact ⟨Multiplicative.ofAdd x, by rw [hq, toAdd_ofAdd, hx]⟩)
  have hG'0 : G' 0 = 1 := by
    have h := hG'hom 0 0
    rw [add_zero] at h
    have := congrArg (fun z => z * (G' 0)⁻¹) h
    simpa using this.symm
  let f : ℝ →+ ℝ :=
    { toFun := fun t => Multiplicative.toAdd (G' t)
      map_zero' := by rw [hG'0]; rfl
      map_add' := fun s t => by rw [hG'hom, toAdd_mul] }
  have hfc : Continuous f := continuous_toAdd.comp hG'c
  refine ⟨f 1, fun t => ?_⟩
  have h1 : f t = t * f 1 := by
    have := map_real_smul f hfc t 1
    simpa using this
  have h2 := hG'q t
  rw [hq] at h2
  have h3 : ((Multiplicative.toAdd (G' t) : ℝ) : UnitAddCircle) = g t :=
    Multiplicative.ofAdd.injective h2
  rw [← h3]
  show ((f t : ℝ) : UnitAddCircle) = _
  rw [h1, mul_comm]

/-- Continuous characters of `𝕋`. -/
lemma charT (η : UnitAddCircle → UnitAddCircle) (hη : ∀ s t, η (s + t) = η s + η t)
    (hηc : Continuous η) : ∃ l : ℤ, ∀ θ, η θ = l • θ := by
  obtain ⟨c, hc⟩ := charR (fun t => η (t : UnitAddCircle))
    (fun s t => by rw [AddCircle.coe_add, hη]) (hηc.comp QuotientAddGroup.continuous_mk)
  have h0 : η 0 = 0 := by
    have := hη 0 0; rw [add_zero] at this
    have := congrArg (fun z => z - η 0) this; simpa using this.symm
  have h1 : ((c : ℝ) : UnitAddCircle) = 0 := by
    have := hc 1
    rw [mul_one, AddCircle.coe_period] at this
    rw [← this, h0]
  obtain ⟨l, hl⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 h1
  refine ⟨l, fun θ => ?_⟩
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective θ
  show η (t : UnitAddCircle) = l • (t : UnitAddCircle)
  rw [hc t, ← hl, zsmul_one, ← AddCircle.coe_zsmul, zsmul_eq_mul]

/-- The basic character of `ZMod d`. -/
noncomputable def zchar (d : ℕ) (b : ZMod d) : UnitAddCircle := (((b.val : ℝ) / d : ℝ) : UnitAddCircle)

lemma zchar_add (d : ℕ) [NeZero d] (a b : ZMod d) : zchar d (a + b) = zchar d a + zchar d b := by
  unfold zchar
  have hd : (0 : ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne d)
  have h := ZMod.val_add a b
  have hdiv := Nat.mod_add_div (a.val + b.val) d
  set q := (a.val + b.val) / d
  have e : (((a + b).val : ℝ) / d) = (a.val : ℝ) / d + (b.val : ℝ) / d - q := by
    rw [h]
    have : (((a.val + b.val) % d : ℕ) : ℝ) = (a.val : ℝ) + b.val - d * q := by
      have := congrArg (fun z : ℕ => (z : ℝ)) hdiv
      push_cast at this
      linarith
    rw [this]
    field_simp
  rw [e, AddCircle.coe_sub, AddCircle.coe_add]
  have hq : ((q : ℝ) : UnitAddCircle) = 0 :=
    (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).2 ⟨q, by simp⟩
  rw [hq, sub_zero]

/-- Characters of `ZMod d`. -/
lemma charZMod (d : ℕ) [NeZero d] (ζ : ZMod d → UnitAddCircle)
    (hζ : ∀ a b, ζ (a + b) = ζ a + ζ b) : ∃ j : ℤ, ∀ b, ζ b = j • zchar d b := by
  have hd : (0 : ℝ) < d := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne d)
  have hnat : ∀ (k : ℕ) (b : ZMod d), ζ ((k : ZMod d) * b) = k • ζ b := by
    intro k b
    induction k with
    | zero =>
      simp only [Nat.cast_zero, zero_mul, zero_smul]
      have := hζ 0 0; rw [add_zero] at this
      have := congrArg (fun z => z - ζ 0) this; simpa using this.symm
    | succ k ih => rw [Nat.cast_succ, add_mul, one_mul, hζ, ih, succ_nsmul]
  obtain ⟨u, hu⟩ := QuotientAddGroup.mk_surjective (ζ 1)
  have hdu : ((d * u : ℝ) : UnitAddCircle) = 0 := by
    have := hnat d 1
    rw [ZMod.natCast_self, zero_mul] at this
    rw [← nsmul_eq_mul, AddCircle.coe_nsmul]
    change d • ((u : ℝ) : UnitAddCircle) = 0
    have hu' : ((u : ℝ) : UnitAddCircle) = ζ 1 := hu
    rw [hu', ← this]
    have h0 := hζ 0 0; rw [add_zero] at h0
    have := congrArg (fun z => z - ζ 0) h0; simpa using this.symm
  obtain ⟨j, hj⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 hdu
  rw [zsmul_one] at hj
  refine ⟨j, fun b => ?_⟩
  have hb : b = (b.val : ZMod d) * 1 := by rw [mul_one, ZMod.natCast_zmod_val]
  rw [hb, hnat, mul_one, ZMod.natCast_zmod_val]
  unfold zchar
  have hu' : ((u : ℝ) : UnitAddCircle) = ζ 1 := hu
  rw [← hu', ← AddCircle.coe_nsmul, ← AddCircle.coe_zsmul]
  congr 1
  rw [nsmul_eq_mul, zsmul_eq_mul]
  have : u = j / d := by rw [hj]; field_simp
  rw [this]
  ring

end LCA

end AnnihA_sec

section SC1_sec

namespace MasulloGRH

open Topology Filter

variable {m n r s : ℕ} {d : Fin s → ℕ}

lemma cd_nat {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [NormedAddCommGroup F]
    [NormedSpace ℝ F] {f : E → F} (h : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) f) (k : ℕ) :
    ContDiff ℝ k f :=
  h.of_le (by exact_mod_cast le_top)

lemma elemLift_add (g₁ g₂ : ElemGroup m n r s d → ℂ) (a : Fin r → ℤ) (b : (i : Fin s) → ZMod (d i)) :
    elemLift (g₁ + g₂) a b = elemLift g₁ a b + elemLift g₂ a b := rfl

lemma elemLift_smul (c : ℂ) (g : ElemGroup m n r s d → ℂ) (a : Fin r → ℤ)
    (b : (i : Fin s) → ZMod (d i)) : elemLift (c • g) a b = c • elemLift g a b := rfl

lemma isRapidDecay_add {g₁ g₂ : ElemGroup m n r s d → ℂ} (h₁ : IsRapidDecay g₁)
    (h₂ : IsRapidDecay g₂) : IsRapidDecay (g₁ + g₂) := by
  refine ⟨fun a b => by rw [elemLift_add]; exact (h₁.1 a b).add (h₂.1 a b), fun i j k => ?_⟩
  obtain ⟨C₁, hC₁⟩ := h₁.2 i j k
  obtain ⟨C₂, hC₂⟩ := h₂.2 i j k
  refine ⟨C₁ + C₂, fun a b xt => ?_⟩
  rw [elemLift_add, iteratedFDeriv_add_apply (cd_nat (h₁.1 a b) k).contDiffAt (cd_nat (h₂.1 a b) k).contDiffAt]
  calc ‖a‖ ^ j * ‖xt.1‖ ^ i * ‖iteratedFDeriv ℝ k (elemLift g₁ a b) xt +
        iteratedFDeriv ℝ k (elemLift g₂ a b) xt‖
      ≤ ‖a‖ ^ j * ‖xt.1‖ ^ i * (‖iteratedFDeriv ℝ k (elemLift g₁ a b) xt‖ +
        ‖iteratedFDeriv ℝ k (elemLift g₂ a b) xt‖) :=
        mul_le_mul_of_nonneg_left (norm_add_le _ _) (by positivity)
    _ ≤ C₁ + C₂ := by rw [mul_add]; exact add_le_add (hC₁ a b xt) (hC₂ a b xt)

lemma isRapidDecay_smul (c : ℂ) {g : ElemGroup m n r s d → ℂ} (h : IsRapidDecay g) :
    IsRapidDecay (c • g) := by
  refine ⟨fun a b => by rw [elemLift_smul]; exact (h.1 a b).const_smul c, fun i j k => ?_⟩
  obtain ⟨C, hC⟩ := h.2 i j k
  refine ⟨‖c‖ * C, fun a b xt => ?_⟩
  rw [elemLift_smul, iteratedFDeriv_const_smul_apply (cd_nat (h.1 a b) k).contDiffAt, norm_smul]
  have := hC a b xt
  calc ‖a‖ ^ j * ‖xt.1‖ ^ i * (‖c‖ * ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖)
      = ‖c‖ * (‖a‖ ^ j * ‖xt.1‖ ^ i * ‖iteratedFDeriv ℝ k (elemLift g a b) xt‖) := by ring
    _ ≤ ‖c‖ * C := mul_le_mul_of_nonneg_left this (norm_nonneg _)

lemma isRapidDecay_zero : IsRapidDecay (0 : ElemGroup m n r s d → ℂ) := by
  refine ⟨fun a b => ?_, fun i j k => ⟨0, fun a b xt => ?_⟩⟩
  · exact contDiff_const (c := (0 : ℂ))
  · have : elemLift (0 : ElemGroup m n r s d → ℂ) a b = fun _ => 0 := rfl
    rw [this, iteratedFDeriv_fun_zero]
    simp

theorem mem_elemSchwartz_iff (g : ElemGroup m n r s d → ℂ) :
    g ∈ elemSchwartzSubmodule m n r s d ↔ IsRapidDecay g := by
  constructor
  · intro h
    induction h using Submodule.span_induction with
    | mem x hx => exact hx
    | zero => exact isRapidDecay_zero
    | add x y _ _ hx hy => exact isRapidDecay_add hx hy
    | smul c x _ hx => exact isRapidDecay_smul c hx
  · intro h; exact Submodule.subset_span h

lemma ElemSchwartz.isRapidDecay (g : ElemSchwartz m n r s d) : IsRapidDecay g.toFun :=
  (mem_elemSchwartz_iff _).1 g.2

/-- The weighted derivative functions defining the topology. -/
noncomputable def wf (g : ElemGroup m n r s d → ℂ) (p : ℕ × ℕ × ℕ)
    (q : (Fin r → ℤ) × ((i : Fin s) → ZMod (d i)) × ((Fin m → ℝ) × (Fin n → ℝ))) :
    ContinuousMultilinearMap ℝ (fun _ : Fin p.2.2 => (Fin m → ℝ) × (Fin n → ℝ)) ℂ :=
  (‖q.1‖ ^ p.2.1 * ‖q.2.2.1‖ ^ p.1) • iteratedFDeriv ℝ p.2.2 (elemLift g q.1 q.2.1) q.2.2

lemma wf_sub {g₁ g₂ : ElemGroup m n r s d → ℂ} (h₁ : IsRapidDecay g₁) (h₂ : IsRapidDecay g₂)
    (p : ℕ × ℕ × ℕ) (q) : wf (g₁ - g₂) p q = wf g₁ p q - wf g₂ p q := by
  unfold wf
  have e : elemLift (g₁ - g₂) q.1 q.2.1 = elemLift g₁ q.1 q.2.1 - elemLift g₂ q.1 q.2.1 := rfl
  rw [e, iteratedFDeriv_sub_apply (cd_nat (h₁.1 _ _) _).contDiffAt (cd_nat (h₂.1 _ _) _).contDiffAt, smul_sub]

lemma continuous_wf (p : ℕ × ℕ × ℕ) :
    Continuous (fun g : ElemSchwartz m n r s d => UniformFun.ofFun (wf g.toFun p)) := by
  have h : Continuous (fun (g : ElemSchwartz m n r s d) (p : ℕ × ℕ × ℕ) =>
      UniformFun.ofFun
        (fun q : (Fin r → ℤ) × ((i : Fin s) → ZMod (d i)) × ((Fin m → ℝ) × (Fin n → ℝ)) =>
          (‖q.1‖ ^ p.2.1 * ‖q.2.2.1‖ ^ p.1) •
            iteratedFDeriv ℝ p.2.2 (elemLift g.toFun q.1 q.2.1) q.2.2)) :=
    continuous_induced_dom
  exact (continuous_apply p).comp h

/-- **Continuity criterion** for linear maps between elementary Schwartz spaces. -/
theorem continuous_of_wf_bound {m' n' r' s' : ℕ} {d' : Fin s' → ℕ}
    (T : ElemSchwartz m n r s d →ₗ[ℂ] ElemSchwartz m' n' r' s' d')
    (hT : ∀ p' : ℕ × ℕ × ℕ, ∃ (S : Finset (ℕ × ℕ × ℕ)) (C : ℝ), ∀ (g : ElemSchwartz m n r s d)
      (M : ℝ), (∀ p ∈ S, ∀ q, ‖wf g.toFun p q‖ ≤ M) → ∀ q', ‖wf (T g).toFun p' q'‖ ≤ C * M) :
    Continuous T := by
  apply continuous_induced_rng.2
  refine continuous_pi fun p' => ?_
  show Continuous (fun g : ElemSchwartz m n r s d => UniformFun.ofFun (wf (T g).toFun p'))
  obtain ⟨S, C, hC⟩ := hT p'
  rw [continuous_iff_continuousAt]
  intro g₀
  unfold ContinuousAt
  rw [UniformFun.tendsto_iff_tendstoUniformly, Metric.tendstoUniformly_iff]
  intro ε hε
  set M := ε / (2 * (|C| + 1)) with hM
  have hMpos : 0 < M := by positivity
  have hev : ∀ᶠ g in 𝓝 g₀, ∀ p ∈ S, ∀ q, ‖wf (g₀ - g).toFun p q‖ ≤ M := by
    refine S.eventually_all.2 fun p _ => ?_
    have h1 := (continuous_wf (m := m) (n := n) (r := r) (s := s) (d := d) p).continuousAt
      (x := g₀)
    unfold ContinuousAt at h1
    rw [UniformFun.tendsto_iff_tendstoUniformly, Metric.tendstoUniformly_iff] at h1
    filter_upwards [h1 M hMpos] with g hg q
    have e : (g₀ - g).toFun = g₀.toFun - g.toFun := rfl
    rw [e, wf_sub g₀.isRapidDecay g.isRapidDecay, ← dist_eq_norm]
    exact (hg q).le
  filter_upwards [hev] with g hg q'
  have e1 : (T g₀).toFun - (T g).toFun = (T (g₀ - g)).toFun := by
    rw [map_sub]; rfl
  show dist (wf (T g₀).toFun p' q') (wf (T g).toFun p' q') < ε
  rw [dist_eq_norm, ← wf_sub (T g₀).isRapidDecay (T g).isRapidDecay, e1]
  calc ‖wf (T (g₀ - g)).toFun p' q'‖ ≤ C * M := hC _ M hg q'
    _ ≤ |C| * M := mul_le_mul_of_nonneg_right (le_abs_self C) hMpos.le
    _ < ε := by
      rw [hM]
      have : |C| * (ε / (2 * (|C| + 1))) = ε * (|C| / (2 * (|C| + 1))) := by ring
      rw [this]
      have h2 : |C| / (2 * (|C| + 1)) < 1 := by
        rw [div_lt_one (by positivity)]; linarith [abs_nonneg C]
      nlinarith

end MasulloGRH

end SC1_sec

section SC2_sec

open MeasureTheory Topology Filter

namespace MasulloGRH

lemma integrable_of_cont_compact {α E : Type*} [TopologicalSpace α] [CompactSpace α]
    [MeasurableSpace α] [OpensMeasurableSpace α] (μ : Measure α) [IsFiniteMeasure μ]
    [NormedAddCommGroup E] (f : α → E) (hf : Continuous f) : Integrable f μ :=
  hf.integrable_of_hasCompactSupport
    (isCompact_univ.of_isClosed_subset (isClosed_tsupport _) (Set.subset_univ _))

/-- Smoothness of parametric integrals over a compact parameter space, with differentiation
under the integral sign. -/
theorem integral_iteratedFDeriv {H α : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    [ProperSpace H] [TopologicalSpace α] [CompactSpace α] [MeasurableSpace α]
    [OpensMeasurableSpace α] (μ : Measure α) [IsFiniteMeasure μ] (F : H → α → ℂ)
    (hF : ∀ a, ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => F x a))
    (hc : ∀ k : ℕ, Continuous (fun p : H × α => iteratedFDeriv ℝ k (fun x => F x p.2) p.1)) :
    (∀ k : ℕ, iteratedFDeriv ℝ k (fun x => ∫ a, F x a ∂μ) =
      fun x => ∫ a, iteratedFDeriv ℝ k (fun x => F x a) x ∂μ) ∧
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => ∫ a, F x a ∂μ) := by
  let D : (k : ℕ) → H → α → ContinuousMultilinearMap ℝ (fun _ : Fin k => H) ℂ :=
    fun k x a => iteratedFDeriv ℝ k (fun x => F x a) x
  have hDc : ∀ k x, Continuous (fun a => D k x a) := fun k x =>
    (hc k).comp (continuous_const.prodMk continuous_id)
  have hderiv : ∀ k x a, HasFDerivAt (fun y => D k y a)
      ((continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => H) ℂ) (D (k + 1) x a)) x := by
    intro k x a
    have hdiff : Differentiable ℝ (fun y => iteratedFDeriv ℝ k (fun x => F x a) y) :=
      (hF a).differentiable_iteratedFDeriv (by exact_mod_cast ENat.coe_lt_top k)
    have e : (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => H) ℂ) (D (k + 1) x a) =
        fderiv ℝ (fun y => D k y a) x := by
      show _ = fderiv ℝ (iteratedFDeriv ℝ k (fun x => F x a)) x
      simp only [D, iteratedFDeriv_succ_eq_comp_left, Function.comp_apply,
        LinearIsometryEquiv.apply_symm_apply]
    rw [e]
    exact (hdiff x).hasFDerivAt
  have hInt : ∀ k x₀, HasFDerivAt (fun x => ∫ a, D k x a ∂μ)
      (∫ a, (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => H) ℂ)
        (D (k + 1) x₀ a) ∂μ) x₀ := by
    intro k x₀
    have hK : IsCompact (Metric.closedBall x₀ 1 ×ˢ (Set.univ : Set α)) :=
      (isCompact_closedBall x₀ 1).prod isCompact_univ
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn ((hc (k + 1)).continuousOn)
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (bound := fun _ => B)
      (Metric.closedBall_mem_nhds x₀ one_pos)
      (Eventually.of_forall fun x => (integrable_of_cont_compact μ _ (hDc k x)).aestronglyMeasurable)
      (integrable_of_cont_compact μ _ (hDc k x₀))
      (integrable_of_cont_compact μ _ ((LinearIsometryEquiv.continuous _).comp (hDc (k + 1) x₀))).aestronglyMeasurable
      (ae_of_all _ fun a x hx => ?_) (integrable_const B) (ae_of_all _ fun a x _ => hderiv k x a)
    rw [LinearIsometryEquiv.norm_map]
    exact hB (x, a) ⟨hx, Set.mem_univ _⟩
  have hIter : ∀ k : ℕ, iteratedFDeriv ℝ k (fun x => ∫ a, F x a ∂μ) =
      fun x => ∫ a, D k x a ∂μ := by
    intro k
    induction k with
    | zero =>
      funext x
      rw [iteratedFDeriv_zero_eq_comp, Function.comp_apply]
      exact (ContinuousLinearEquiv.integral_comp_comm (𝕜 := ℝ)
        (continuousMultilinearCurryFin0 ℝ H ℂ).symm.toContinuousLinearEquiv
        (fun a => F x a)).symm
    | succ k ih =>
      funext x
      rw [iteratedFDeriv_succ_eq_comp_left, Function.comp_apply, ih, (hInt k x).fderiv]
      have h := ContinuousLinearEquiv.integral_comp_comm (𝕜 := ℝ) (μ := μ)
        (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => H) ℂ).symm.toContinuousLinearEquiv
        (fun a => (continuousMultilinearCurryLeftEquiv ℝ (fun _ : Fin (k + 1) => H) ℂ)
          (D (k + 1) x a))
      simp only [LinearIsometryEquiv.coe_toContinuousLinearEquiv,
        LinearIsometryEquiv.symm_apply_apply] at h
      exact h.symm
  refine ⟨hIter, ?_⟩
  apply contDiff_of_differentiable_iteratedFDeriv
  intro k _
  rw [hIter]
  exact fun x => (hInt k x).differentiableAt

end MasulloGRH

end SC2_sec

section SC3_sec

open Set Filter Topology

namespace MasulloGRH

variable {m n r s : ℕ} {d : Fin s → ℕ}

/-- The exponential map from lifted coordinates `ℝ^m × ℝ^n` to `E`. -/
def expE (w : (Fin m → ℝ) × (Fin n → ℝ)) : ElemGroup m n r s d :=
  (w.1, fun j => ((w.2 j : ℝ) : UnitAddCircle), 0, 0)

lemma expE_add (w₁ w₂ : (Fin m → ℝ) × (Fin n → ℝ)) :
    (expE (w₁ + w₂) : ElemGroup m n r s d) = expE w₁ + expE w₂ := by
  simp only [expE, Prod.fst_add, Prod.snd_add, Pi.add_apply, AddCircle.coe_add]
  ext <;> simp

lemma continuous_expE : Continuous (expE : (Fin m → ℝ) × (Fin n → ℝ) → ElemGroup m n r s d) := by
  have h1 : Continuous fun w : (Fin m → ℝ) × (Fin n → ℝ) =>
      (fun j => ((w.2 j : ℝ) : UnitAddCircle)) :=
    continuous_pi fun j => QuotientAddGroup.continuous_mk.comp ((continuous_apply j).comp continuous_snd)
  exact continuous_fst.prodMk (h1.prodMk continuous_const)

/-- Open subgroups of `E` contain the identity component. -/
lemma expE_mem_of_isOpen (H : AddSubgroup (ElemGroup m n r s d)) (hH : IsOpen (H : Set (ElemGroup m n r s d)))
    (w : (Fin m → ℝ) × (Fin n → ℝ)) : expE w ∈ H := by
  let S : AddSubgroup ((Fin m → ℝ) × (Fin n → ℝ)) :=
    { carrier := {w | expE w ∈ H}
      add_mem' := fun {a b} ha hb => by
        show expE (a + b) ∈ H
        rw [expE_add]; exact H.add_mem ha hb
      zero_mem' := by
        show expE 0 ∈ H
        have : (expE 0 : ElemGroup m n r s d) = 0 := by ext <;> simp [expE]
        rw [this]; exact H.zero_mem
      neg_mem' := fun {a} ha => by
        show expE (-a) ∈ H
        have : (expE (-a) : ElemGroup m n r s d) = -expE a := by
          have h := expE_add (m := m) (n := n) (r := r) (s := s) (d := d) (-a) a
          rw [neg_add_cancel] at h
          have h0 : (expE 0 : ElemGroup m n r s d) = 0 := by ext <;> simp [expE]
          rw [h0] at h
          exact eq_neg_of_add_eq_zero_left h.symm
        rw [this]; exact H.neg_mem ha }
  have hSo : IsOpen (S : Set ((Fin m → ℝ) × (Fin n → ℝ))) := hH.preimage continuous_expE
  have hScl : IsClosed (S : Set ((Fin m → ℝ) × (Fin n → ℝ))) := AddSubgroup.isClosed_of_isOpen S hSo
  have : (S : Set ((Fin m → ℝ) × (Fin n → ℝ))) = univ :=
    IsClopen.eq_univ ⟨hScl, hSo⟩ ⟨0, S.zero_mem⟩
  have hw : w ∈ (S : Set ((Fin m → ℝ) × (Fin n → ℝ))) := by rw [this]; trivial
  exact hw

/-- A coordinatewise-zero test for integer vectors bounded under all multiples. -/
lemma int_vec_eq_zero {r : ℕ} (a : Fin r → ℤ) (R : ℝ) (h : ∀ N : ℕ, ‖(N : ℤ) • a‖ ≤ R) : a = 0 := by
  funext i
  by_contra hne
  obtain ⟨N, hN⟩ := exists_nat_gt R
  have h1 := (norm_le_pi_norm ((N : ℤ) • a) i).trans (h N)
  simp only [Pi.smul_apply, smul_eq_mul, Int.norm_eq_abs, Int.cast_mul,
    Int.cast_natCast] at h1
  have h2 : (1 : ℝ) ≤ |((a i : ℤ) : ℝ)| := by
    have : (1 : ℤ) ≤ |a i| := Int.one_le_abs hne
    exact_mod_cast this
  rw [abs_mul, Nat.abs_cast] at h1
  nlinarith

lemma real_vec_eq_zero {m : ℕ} (x : Fin m → ℝ) (R : ℝ) (h : ∀ N : ℕ, ‖(N : ℝ) • x‖ ≤ R) :
    x = 0 := by
  by_contra hne
  have hpos : 0 < ‖x‖ := norm_pos_iff.2 hne
  obtain ⟨N, hN⟩ := exists_nat_gt (R / ‖x‖)
  have := h N
  rw [norm_smul, Real.norm_natCast] at this
  rw [div_lt_iff₀ hpos] at hN
  linarith

end MasulloGRH

end SC3_sec

section SC3b_sec

open Set Filter Topology

namespace MasulloGRH

/-- The circle projection on vectors. -/
noncomputable def piT (k : ℕ) : (Fin k → ℝ) →+ (Fin k → UnitAddCircle) :=
  AddMonoidHom.compLeft (QuotientAddGroup.mk' _) (Fin k)

lemma piT_apply (k : ℕ) (z : Fin k → ℝ) (j : Fin k) : piT k z j = ((z j : ℝ) : UnitAddCircle) := rfl

lemma continuous_piT (k : ℕ) : Continuous (piT k) :=
  continuous_pi fun j => QuotientAddGroup.continuous_mk.comp (continuous_apply j)

lemma isOpenMap_piT (k : ℕ) : IsOpenMap (piT k) :=
  IsOpenMap.piMap (fun _ => QuotientAddGroup.isOpenMap_coe)
    (Filter.Eventually.of_forall fun _ => QuotientAddGroup.mk_surjective)

lemma piT_surjective (k : ℕ) : Function.Surjective (piT k) := fun θ => by
  choose z hz using fun j => QuotientAddGroup.mk_surjective (θ j)
  exact ⟨z, funext hz⟩

lemma piT_eq_zero_iff (k : ℕ) (z : Fin k → ℝ) : piT k z = 0 ↔ ∀ j, ∃ n : ℤ, z j = n := by
  constructor
  · intro h j
    have := congrFun h j
    rw [piT_apply] at this
    obtain ⟨n, hn⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 this
    exact ⟨n, by rw [← hn, zsmul_one]⟩
  · intro h; funext j
    obtain ⟨n, hn⟩ := h j
    rw [piT_apply, hn]
    exact (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).2 ⟨n, by rw [zsmul_one]⟩

/-- Continuous additive maps from a finite-dimensional real space to a torus are linear modulo
the lattice. -/
lemma charTorus {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H] [FiniteDimensional ℝ H]
    {k : ℕ} (f : H →+ (Fin k → UnitAddCircle)) (hf : Continuous f) :
    ∃ L : H →ₗ[ℝ] (Fin k → ℝ), ∀ w, f w = piT k (L w) := by
  classical
  let b := Module.finBasis ℝ H
  have hc : ∀ (j : Fin k) (i : Fin (Module.finrank ℝ H)), ∃ c : ℝ, ∀ t : ℝ,
      f (t • b i) j = ((c * t : ℝ) : UnitAddCircle) := fun j i =>
    LCA.charR (fun t => f (t • b i) j) (fun s t => by rw [add_smul, map_add]; rfl)
      ((continuous_apply j).comp (hf.comp (continuous_id.smul continuous_const)))
  choose c hc using hc
  let L : H →ₗ[ℝ] (Fin k → ℝ) := LinearMap.pi fun j =>
    ∑ i, (c j i) • (b.coord i)
  refine ⟨L, fun w => ?_⟩
  funext j
  conv_lhs => rw [← b.sum_repr w]
  rw [map_sum, Finset.sum_apply]
  simp only [hc, L, piT_apply, LinearMap.pi_apply, LinearMap.sum_apply,
    LinearMap.smul_apply, Module.Basis.coord_apply, smul_eq_mul]
  rw [show ((∑ i, c j i * (b.repr w) i : ℝ) : UnitAddCircle) =
      ∑ i, ((c j i * (b.repr w) i : ℝ) : UnitAddCircle) from
    map_sum (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℝ))) _ _]

end MasulloGRH

end SC3b_sec

section SC3c_sec

open Set Filter Topology

namespace MasulloGRH

theorem exists_linear_lift
    {P : Type*} [CommGroup P] [TopologicalSpace P] [IsTopologicalGroup P] [T2Space P]
    (P₀ : Subgroup P) (hP₀ : IsOpen (P₀ : Set P))
    {m n r s : ℕ} {d : Fin s → ℕ} (α : ↥P₀ →* Multiplicative (ElemGroup m n r s d))
    (hαc : Continuous α)
    {m' n' r' s' : ℕ} {d' : Fin s' → ℕ} (β : P →* Multiplicative (ElemGroup m' n' r' s' d'))
    (hβc : Continuous β) (hβo : IsOpenMap β) (hβk : IsCompact {x : P | β x = 1}) :
    ∃ Λ : (Fin m' → ℝ) × (Fin n' → ℝ) →ₗ[ℝ] (Fin m → ℝ) × (Fin n → ℝ),
      ∀ w, ∃ p : P₀, Multiplicative.toAdd (β p) = expE w ∧ ∃ q : P₀, β q = 1 ∧
        Multiplicative.toAdd (α p) = expE (Λ w) + Multiplicative.toAdd (α q) := by
  classical
  let ea : P₀ → ElemGroup m n r s d := fun p => Multiplicative.toAdd (α p)
  have ea_mul : ∀ p q, ea (p * q) = ea p + ea q := fun p q => by simp [ea]
  have ea_one : ea 1 = 0 := by simp [ea]
  have ea_inv : ∀ p, ea p⁻¹ = - ea p := fun p => by simp [ea]
  have ea_pow : ∀ (p : P₀) (N : ℕ), ea (p ^ N) = N • ea p := fun p N => by simp [ea]
  have hea_c : Continuous ea := continuous_toAdd.comp hαc
  have hP₀cl : IsClosed (P₀ : Set P) := Subgroup.isClosed_of_isOpen P₀ hP₀
  have hK₀ : IsCompact {q : P₀ | β q = 1} :=
    hP₀cl.isClosedEmbedding_subtypeVal.isCompact_preimage hβk
  obtain ⟨R₁, hR₁⟩ := hK₀.exists_bound_of_continuousOn (f := fun q => (ea q).1)
    ((continuous_fst.comp hea_c).continuousOn)
  obtain ⟨R₂, hR₂⟩ := hK₀.exists_bound_of_continuousOn (f := fun q => (ea q).2.2.1)
    ((continuous_fst.comp (continuous_snd.comp (continuous_snd.comp hea_c))).continuousOn)
  have hqN : ∀ q : P₀, β q = 1 → ∀ N : ℕ, (q ^ N : P₀) ∈ {q : P₀ | β q = 1} := fun q hq N => by
    show β ((q ^ N : P₀) : P) = 1
    rw [Subgroup.coe_pow, map_pow, hq, one_pow]
  have hx0 : ∀ q : P₀, β q = 1 → (ea q).1 = 0 ∧ (ea q).2.2.1 = 0 := by
    intro q hq
    constructor
    · refine real_vec_eq_zero _ R₁ fun N => ?_
      have := hR₁ _ (hqN q hq N)
      rw [ea_pow, Prod.smul_fst, ← Nat.cast_smul_eq_nsmul ℝ] at this
      exact this
    · refine int_vec_eq_zero _ R₂ fun N => ?_
      have := hR₂ _ (hqN q hq N)
      rw [ea_pow, Prod.smul_snd, Prod.smul_snd, Prod.smul_fst, ← natCast_zsmul] at this
      exact this
  -- the subgroup `D` of the torus
  let D : AddSubgroup (Fin n → UnitAddCircle) :=
    { carrier := {θ | ∃ q : P₀, β q = 1 ∧ ea q = (0, θ, 0, 0)}
      add_mem' := by
        rintro _ _ ⟨q₁, h₁, e₁⟩ ⟨q₂, h₂, e₂⟩
        refine ⟨q₁ * q₂, ?_, ?_⟩
        · show β ((q₁ : P) * q₂) = 1
          rw [map_mul, h₁, h₂, one_mul]
        · rw [ea_mul, e₁, e₂]; ext <;> simp
      zero_mem' := ⟨1, map_one _, by rw [ea_one]; rfl⟩
      neg_mem' := by
        rintro _ ⟨q, h, e⟩
        refine ⟨q⁻¹, ?_, ?_⟩
        · show β ((q : P)⁻¹) = 1
          rw [map_inv, h, inv_one]
        · rw [ea_inv, e]; ext <;> simp }
  have hDset : (D : Set (Fin n → UnitAddCircle)) =
      (fun q => (ea q).2.1) '' ({q : P₀ | β q = 1} ∩ {q | (ea q).2.2.2 = 0}) := by
    ext θ
    constructor
    · rintro ⟨q, hq, e⟩
      exact ⟨q, ⟨hq, show (ea q).2.2.2 = 0 by rw [e]⟩, show (ea q).2.1 = θ by rw [e]⟩
    · rintro ⟨q, ⟨hq, hb⟩, rfl⟩
      refine ⟨q, hq, Prod.ext (hx0 q hq).1 (Prod.ext rfl (Prod.ext (hx0 q hq).2 hb))⟩
  have hDcl : IsClosed (D : Set (Fin n → UnitAddCircle)) := by
    rw [hDset]
    refine (IsCompact.image (hK₀.inter_right (isClosed_eq
      (continuous_snd.comp (continuous_snd.comp (continuous_snd.comp hea_c))) continuous_const))
      ((continuous_fst.comp (continuous_snd.comp hea_c)))).isClosed
  let Dt : AddSubgroup (Fin n → ℝ) := D.comap (piT n)
  have hDtcl : IsClosed (Dt : Set (Fin n → ℝ)) := hDcl.preimage (continuous_piT n)
  obtain ⟨-, k, m₂, -, -, κ, hκs, hκD, -⟩ := LCA.closedSubgroup_structure Dt hDtcl
  have hZ : ∀ z : Fin n → ℤ, (fun j => (z j : ℝ)) ∈ Dt := by
    intro z
    show piT n (fun j => (z j : ℝ)) ∈ D
    rw [(piT_eq_zero_iff n _).2 (fun j => ⟨z j, rfl⟩)]
    exact D.zero_mem
  let κ₁ : (Fin n → ℝ) →ₗ[ℝ] (Fin k → ℝ) := LinearMap.fst ℝ _ _ ∘ₗ κ
  let κ₂ : (Fin n → ℝ) →ₗ[ℝ] (Fin m₂ → ℝ) := LinearMap.snd ℝ _ _ ∘ₗ κ
  have hκ2 : κ₂ = 0 := by
    refine (Pi.basisFun ℝ (Fin n)).ext fun i => ?_
    have h := (hκD _).1 (hZ (Pi.single i 1))
    have e : (fun j => ((Pi.single i (1 : ℤ) : Fin n → ℤ) j : ℝ)) = Pi.basisFun ℝ (Fin n) i := by
      funext j; simp [Pi.single_apply]
    rw [e] at h
    simpa [κ₂] using h.2
  have hκ1s : Function.Surjective κ₁ := fun y => by
    obtain ⟨z, hz⟩ := hκs (y, 0)
    exact ⟨z, by simp [κ₁, hz]⟩
  have hD_iff : ∀ z : Fin n → ℝ, piT n z ∈ D ↔ piT k (κ₁ z) = 0 := by
    intro z
    rw [piT_eq_zero_iff]
    show z ∈ Dt ↔ _
    rw [hκD]
    have : (κ z).2 = 0 := by
      have := congrArg (fun f => f z) hκ2
      simpa [κ₂] using this
    simp [this, κ₁]
  -- the induced map on the torus
  let lift : (Fin n → UnitAddCircle) → (Fin n → ℝ) := fun θ => (piT_surjective n θ).choose
  have hlift : ∀ θ, piT n (lift θ) = θ := fun θ => (piT_surjective n θ).choose_spec
  let φθ : (Fin n → UnitAddCircle) → (Fin k → UnitAddCircle) := fun θ => piT k (κ₁ (lift θ))
  have hφθ : ∀ z, φθ (piT n z) = piT k (κ₁ z) := by
    intro z
    have h0 : piT n (lift (piT n z) - z) ∈ D := by
      rw [map_sub, hlift, sub_self]; exact D.zero_mem
    have := (hD_iff _).1 h0
    rw [map_sub, map_sub, sub_eq_zero] at this
    exact this
  have hφθ_add : ∀ θ₁ θ₂, φθ (θ₁ + θ₂) = φθ θ₁ + φθ θ₂ := by
    intro θ₁ θ₂
    obtain ⟨z₁, rfl⟩ := piT_surjective n θ₁
    obtain ⟨z₂, rfl⟩ := piT_surjective n θ₂
    rw [← map_add, hφθ, hφθ, hφθ, map_add, map_add]
  have hφθ_ker : ∀ θ, φθ θ = 0 ↔ θ ∈ D := by
    intro θ
    obtain ⟨z, rfl⟩ := piT_surjective n θ
    rw [hφθ, hD_iff]
  have hφθ_c : Continuous φθ := by
    have hq : Topology.IsQuotientMap (piT n) :=
      (IsOpenQuotientMap.mk (piT_surjective n) (continuous_piT n) (isOpenMap_piT n)).isQuotientMap
    rw [hq.continuous_iff]
    have : φθ ∘ piT n = fun z => piT k (κ₁ z) := funext hφθ
    rw [this]
    exact (continuous_piT k).comp (LinearMap.continuous_of_finiteDimensional κ₁)
  -- the map `ψ₀`
  let ψ₀ : P₀ → (Fin m → ℝ) × (Fin k → UnitAddCircle) := fun p => ((ea p).1, φθ (ea p).2.1)
  have hψ₀_mul : ∀ p q, ψ₀ (p * q) = ψ₀ p + ψ₀ q := fun p q => by
    simp only [ψ₀, ea_mul, Prod.fst_add, Prod.snd_add, hφθ_add]; rfl
  have hψ₀_one : ψ₀ 1 = 0 := by
    have h := hψ₀_mul 1 1
    rw [one_mul] at h
    have := congrArg (fun z => z - ψ₀ 1) h
    simpa using this.symm
  have hψ₀_inv : ∀ p, ψ₀ p⁻¹ = - ψ₀ p := fun p => by
    have h := hψ₀_mul p⁻¹ p
    rw [inv_mul_cancel, hψ₀_one] at h
    exact eq_neg_of_add_eq_zero_left h.symm
  have hψ₀_c : Continuous ψ₀ :=
    (continuous_fst.comp hea_c).prodMk (hφθ_c.comp (continuous_fst.comp (continuous_snd.comp hea_c)))
  let inQ : P₀ → Prop := fun p => (ea p).2.2.1 = 0 ∧ (ea p).2.2.2 = 0
  have hinQ_open : IsOpen {p : P₀ | inQ p} :=
    (isOpen_discrete ({0} : Set (Fin r → ℤ))).preimage
      (continuous_fst.comp (continuous_snd.comp (continuous_snd.comp hea_c))) |>.inter
    ((isOpen_discrete ({0} : Set ((i : Fin s) → ZMod (d i)))).preimage
      (continuous_snd.comp (continuous_snd.comp (continuous_snd.comp hea_c))))
  have hfactor : ∀ p p' : P₀, inQ p → inQ p' → β p = β p' → ψ₀ p = ψ₀ p' := by
    intro p p' hp hp' hβ
    let q := p⁻¹ * p'
    have hq : β q = 1 := by
      show β ((p : P)⁻¹ * p') = 1
      rw [map_mul, map_inv, hβ, inv_mul_cancel]
    have heq : ea q = ea p' - ea p := by
      simp only [q, ea_mul, ea_inv]; abel
    have hθ : (ea q).2.1 ∈ D := by
      refine ⟨q, hq, Prod.ext (hx0 q hq).1 (Prod.ext rfl (Prod.ext (hx0 q hq).2 ?_))⟩
      rw [heq]; simp [hp.2, hp'.2]
    have hψq : ψ₀ q = 0 := by
      show ((ea q).1, φθ (ea q).2.1) = 0
      rw [(hx0 q hq).1, (hφθ_ker _).2 hθ]; rfl
    have : ψ₀ p' = ψ₀ p + ψ₀ q := by
      rw [← hψ₀_mul]; simp [q]
    rw [this, hψq, add_zero]
  -- the image of `inQ` under `β` contains the identity component
  let eb : P → ElemGroup m' n' r' s' d' := fun x => Multiplicative.toAdd (β x)
  let βQ : AddSubgroup (ElemGroup m' n' r' s' d') :=
    { carrier := {e | ∃ p : P₀, inQ p ∧ eb p = e}
      add_mem' := by
        rintro _ _ ⟨p₁, h₁, rfl⟩ ⟨p₂, h₂, rfl⟩
        refine ⟨p₁ * p₂, ⟨?_, ?_⟩, ?_⟩
        · simp only [inQ, ea_mul, Prod.snd_add, Prod.fst_add, h₁.1, h₂.1, add_zero]
        · simp only [inQ, ea_mul, Prod.snd_add, h₁.2, h₂.2, add_zero]
        · simp [eb]
      zero_mem' := ⟨1, ⟨by simp [ea_one], by simp [ea_one]⟩, by simp [eb]⟩
      neg_mem' := by
        rintro _ ⟨p, h, rfl⟩
        refine ⟨p⁻¹, ⟨?_, ?_⟩, ?_⟩
        · simp only [inQ, ea_inv, Prod.snd_neg, Prod.fst_neg, h.1, neg_zero]
        · simp only [inQ, ea_inv, Prod.snd_neg, h.2, neg_zero]
        · simp [eb] }
  have hβQo : IsOpen (βQ : Set (ElemGroup m' n' r' s' d')) := by
    have : (βQ : Set (ElemGroup m' n' r' s' d')) =
        Multiplicative.toAdd '' (β '' (Subtype.val '' {p : P₀ | inQ p})) := by
      ext e
      constructor
      · rintro ⟨p, hp, rfl⟩
        exact ⟨β p, ⟨p, ⟨p, hp, rfl⟩, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨_, ⟨p, hp, rfl⟩, rfl⟩, rfl⟩
        exact ⟨p, hp, rfl⟩
    rw [this]
    exact LCA.isOpenMap_toAdd' _ (hβo _ (hP₀.isOpenMap_subtype_val _ hinQ_open))
  have hpw : ∀ w : (Fin m' → ℝ) × (Fin n' → ℝ), ∃ p : P₀, inQ p ∧ eb p = expE w :=
    fun w => expE_mem_of_isOpen βQ hβQo w
  choose pw hpwQ hpwe using hpw
  have hβeq : ∀ p p' : P₀, eb p = eb p' → β p = β p' := fun p p' h =>
    Multiplicative.toAdd.injective h
  let fΨ : (Fin m' → ℝ) × (Fin n' → ℝ) →+ (Fin m → ℝ) × (Fin k → UnitAddCircle) :=
    { toFun := fun w => ψ₀ (pw w)
      map_zero' := by
        rw [hfactor (pw 0) 1 (hpwQ 0) ⟨by simp [ea_one], by simp [ea_one]⟩ (hβeq _ _ (by
          rw [hpwe]; ext <;> simp [eb, expE])), hψ₀_one]
      map_add' := fun w₁ w₂ => by
        rw [hfactor (pw (w₁ + w₂)) (pw w₁ * pw w₂) (hpwQ _)
          ⟨by simp only [ea_mul, Prod.snd_add, Prod.fst_add, (hpwQ w₁).1, (hpwQ w₂).1, add_zero],
           by simp only [ea_mul, Prod.snd_add, (hpwQ w₁).2, (hpwQ w₂).2, add_zero]⟩
          (hβeq _ _ (by
            have e1 : eb ((pw w₁ * pw w₂ : P₀) : P) = eb (pw w₁) + eb (pw w₂) := by
              simp [eb]
            rw [e1, hpwe, hpwe, hpwe, expE_add])), hψ₀_mul] }
  have hfΨc : Continuous fΨ := by
    apply continuous_of_continuousAt_zero fΨ
    intro W hW
    rw [map_zero] at hW
    show fΨ ⁻¹' W ∈ 𝓝 0
    have hN : ψ₀ ⁻¹' W ∩ {p : P₀ | inQ p} ∈ 𝓝 (1 : P₀) :=
      inter_mem (hψ₀_c.continuousAt.preimage_mem_nhds (by rw [hψ₀_one]; exact hW))
        (hinQ_open.mem_nhds ⟨by simp [ea_one], by simp [ea_one]⟩)
    have h1 := hP₀.isOpenMap_subtype_val.image_mem_nhds hN
    have h2 := hβo.image_mem_nhds h1
    have h3 := LCA.isOpenMap_toAdd'.image_mem_nhds h2
    have h4 := continuous_expE.continuousAt.preimage_mem_nhds
      (x := (0 : (Fin m' → ℝ) × (Fin n' → ℝ))) (by
        have e0 : (expE 0 : ElemGroup m' n' r' s' d') = 0 := by ext <;> simp [expE]
        rw [e0]
        simpa using h3)
    filter_upwards [h4] with w hw
    obtain ⟨_, ⟨_, ⟨p, ⟨hpW, hpQ⟩, rfl⟩, rfl⟩, hpe⟩ := hw
    show ψ₀ (pw w) ∈ W
    rw [hfactor (pw w) p (hpwQ w) hpQ (hβeq _ _ (by rw [hpwe]; exact hpe.symm))]
    exact hpW
  -- linear structure
  let L1 := (AddMonoidHom.toRealLinearMap
    ((AddMonoidHom.fst (Fin m → ℝ) (Fin k → UnitAddCircle)).comp fΨ)
    (by have := continuous_fst.comp hfΨc; exact this)).toLinearMap
  obtain ⟨L2, hL2⟩ := charTorus ((AddMonoidHom.snd (Fin m → ℝ) (Fin k → UnitAddCircle)).comp fΨ)
    (by have := continuous_snd.comp hfΨc; exact this)
  obtain ⟨ρ, hρ⟩ := LinearMap.exists_rightInverse_of_surjective κ₁
    (LinearMap.range_eq_top.2 hκ1s)
  refine ⟨L1.prod (ρ ∘ₗ L2), fun w => ⟨pw w, hpwe w, ?_⟩⟩
  have hψw : ψ₀ (pw w) = (L1 w, piT k (L2 w)) := Prod.ext rfl (hL2 w)
  have hθ : (ea (pw w)).2.1 - piT n (ρ (L2 w)) ∈ D := by
    rw [← hφθ_ker, sub_eq_add_neg, hφθ_add]
    have h1 : φθ (ea (pw w)).2.1 = piT k (L2 w) := congrArg Prod.snd hψw
    have h2 : φθ (-piT n (ρ (L2 w))) = - piT k (L2 w) := by
      rw [← map_neg, hφθ, map_neg, map_neg]
      congr 2
      exact congrArg (fun f => f (L2 w)) hρ
    rw [h1, h2, add_neg_cancel]
  obtain ⟨q, hq, hqe⟩ := hθ
  refine ⟨q, hq, ?_⟩
  have hx : (ea (pw w)).1 = L1 w := by have := congrArg Prod.fst hψw; exact this
  show ea (pw w) = expE ((L1.prod (ρ ∘ₗ L2)) w) + ea q
  rw [hqe]
  refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
  · simp [expE, hx]
  · have e2 : (expE ((L1.prod (ρ ∘ₗ L2)) w) : ElemGroup m n r s d).2.1 = piT n (ρ (L2 w)) := rfl
    show (ea (pw w)).2.1 = (expE ((L1.prod (ρ ∘ₗ L2)) w) : ElemGroup m n r s d).2.1 +
      ((ea (pw w)).2.1 - piT n (ρ (L2 w)))
    rw [e2]; abel
  · simp [expE, (hpwQ w).1]
  · simp [expE, (hpwQ w).2]

end MasulloGRH

end SC3c_sec

section SC5_sec

open Set Filter Topology

namespace MasulloGRH

/-- The size of the noncompact coordinates of a point of `E`. -/
def nc {m n r s : ℕ} {d : Fin s → ℕ} (e : ElemGroup m n r s d) : ℝ := ‖e.1‖ + ‖e.2.2.1‖

section nc
variable {m n r s : ℕ} {d : Fin s → ℕ}

lemma nc_nonneg (e : ElemGroup m n r s d) : 0 ≤ nc e := by unfold nc; positivity

lemma nc_add (e₁ e₂ : ElemGroup m n r s d) : nc (e₁ + e₂) ≤ nc e₁ + nc e₂ := by
  unfold nc
  simp only [Prod.fst_add, Prod.snd_add]
  linarith [norm_add_le e₁.1 e₂.1, norm_add_le e₁.2.2.1 e₂.2.2.1]

lemma nc_zsmul (k : ℤ) (e : ElemGroup m n r s d) : nc (k • e) ≤ |(k : ℝ)| * nc e := by
  unfold nc
  simp only [Prod.smul_fst, Prod.smul_snd]
  have h1 := norm_zsmul_le k e.1
  have h2 := norm_zsmul_le k e.2.2.1
  rw [Int.norm_eq_abs] at h1 h2
  nlinarith

lemma nc_nsmul (k : ℕ) (e : ElemGroup m n r s d) : nc (k • e) ≤ k * nc e := by
  have := nc_zsmul (k : ℤ) e
  rw [natCast_zsmul] at this
  simpa using this

lemma nc_sum {ι : Type*} (t : Finset ι) (f : ι → ElemGroup m n r s d) :
    nc (∑ i ∈ t, f i) ≤ ∑ i ∈ t, nc (f i) := by
  classical
  induction t using Finset.induction_on with
  | empty => simp [nc]
  | insert a t ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    exact (nc_add _ _).trans (by linarith)

lemma continuous_nc : Continuous (nc : ElemGroup m n r s d → ℝ) :=
  (continuous_norm.comp continuous_fst).add
    (continuous_norm.comp (continuous_fst.comp (continuous_snd.comp continuous_snd)))

end nc

/-- Preimages of compact sets under open continuous homomorphisms with compact kernel are
compact. -/
lemma isCompact_preimage_of_open_hom {Q E : Type*} [CommGroup Q] [TopologicalSpace Q]
    [IsTopologicalGroup Q] [LocallyCompactSpace Q] [AddCommGroup E] [TopologicalSpace E]
    [IsTopologicalAddGroup E] [T2Space E]
    (f : Q → E) (hf : ∀ a b, f (a * b) = f a + f b) (hfc : Continuous f) (hfo : IsOpenMap f)
    (hk : IsCompact {x | f x = 0}) (B : Set E) (hB : IsCompact B) : IsCompact {p | f p ∈ B} := by
  classical
  have hf1 : f 1 = 0 := by
    have h := hf 1 1; rw [one_mul] at h
    have := congrArg (fun z => z - f 1) h; simpa using this.symm
  have hfinv : ∀ a, f a⁻¹ = - f a := fun a => by
    have h := hf a⁻¹ a; rw [inv_mul_cancel, hf1] at h
    exact eq_neg_of_add_eq_zero_left h.symm
  obtain ⟨V, hVc, hV⟩ := exists_compact_mem_nhds (1 : Q)
  have hrange_open : IsOpen (range f) := by rw [← image_univ]; exact hfo _ isOpen_univ
  have hrange_closed : IsClosed (range f) := by
    -- the range is an open subgroup, hence closed
    let Hr : AddSubgroup E :=
      { carrier := range f
        add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, hf a b⟩
        zero_mem' := ⟨1, hf1⟩
        neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨a⁻¹, hfinv a⟩ }
    exact AddSubgroup.isClosed_of_isOpen Hr hrange_open
  let O : E → Set E := fun e => if h : ∃ p, f p = e then
      f '' ((fun y => h.choose * y) '' interior V) else (range f)ᶜ
  have hOo : ∀ e, IsOpen (O e) := by
    intro e
    simp only [O]
    split_ifs with h
    · exact hfo _ ((Homeomorph.mulLeft h.choose).isOpenMap _ isOpen_interior)
    · exact hrange_closed.isOpen_compl
  obtain ⟨t, ht⟩ := hB.elim_finite_subcover O hOo (by
    intro e _
    refine mem_iUnion.2 ⟨e, ?_⟩
    simp only [O]
    split_ifs with h
    · exact ⟨h.choose * 1, ⟨1, mem_interior_iff_mem_nhds.2 hV, rfl⟩, by rw [mul_one, h.choose_spec]⟩
    · exact fun ⟨p, hp⟩ => h ⟨p, hp⟩)
  have hsub : {p | f p ∈ B} ⊆ ⋃ e ∈ t, ⋃ (h : ∃ p, f p = e),
      (fun z : Q × Q => h.choose * z.1 * z.2) '' (V ×ˢ {x | f x = 0}) := by
    intro p hp
    obtain ⟨e, he, hpe⟩ := mem_iUnion₂.1 (ht hp)
    simp only [O] at hpe
    split_ifs at hpe with h
    · obtain ⟨_, ⟨v, hv, rfl⟩, hfv⟩ := hpe
      refine mem_iUnion₂.2 ⟨e, he, mem_iUnion.2 ⟨h, ⟨(v, (h.choose * v)⁻¹ * p), ⟨interior_subset hv, ?_⟩, ?_⟩⟩⟩
      · show f ((h.choose * v)⁻¹ * p) = 0
        rw [hf, hfinv, hfv, neg_add_cancel]
      · simp only; group
    · exact absurd ⟨p, rfl⟩ hpe
  refine IsCompact.of_isClosed_subset ?_ (hB.isClosed.preimage hfc) hsub
  refine t.isCompact_biUnion fun e _ => ?_
  refine isCompact_iUnion fun h => ?_
  exact (hVc.prod hk).image (by fun_prop)

end MasulloGRH

end SC5_sec

section SC5b_sec

open Set Filter Topology

namespace MasulloGRH

lemma coord_bound {r k : ℕ} (b : Module.Basis (Fin k) ℤ (Fin r → ℤ)) :
    ∃ Cc : ℝ, 0 ≤ Cc ∧ ∀ (a : Fin r → ℤ) (j : Fin k), |((b.repr a j : ℤ) : ℝ)| ≤ Cc * ‖a‖ := by
  classical
  refine ⟨∑ j, ∑ i, |((b.repr (Pi.single i 1) j : ℤ) : ℝ)|, by positivity, fun a j => ?_⟩
  have ha : a = ∑ i, a i • (Pi.single i (1 : ℤ) : Fin r → ℤ) := by
    funext l; simp [Pi.single_apply]
  have e : b.repr a j = ∑ i, a i * b.repr (Pi.single i 1) j := by
    conv_lhs => rw [ha]
    rw [map_sum, Finsupp.finset_sum_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_zsmul, Finsupp.smul_apply, smul_eq_mul]
  rw [e]
  push_cast
  calc |∑ i, ((a i : ℤ) : ℝ) * ((b.repr (Pi.single i 1) j : ℤ) : ℝ)|
      ≤ ∑ i, |((a i : ℤ) : ℝ)| * |((b.repr (Pi.single i 1) j : ℤ) : ℝ)| := by
        refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq ?_)
        simp [abs_mul]
    _ ≤ ∑ i, ‖a‖ * |((b.repr (Pi.single i 1) j : ℤ) : ℝ)| := by
        refine Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
        have := norm_le_pi_norm a i
        rwa [Int.norm_eq_abs] at this
    _ = ‖a‖ * ∑ i, |((b.repr (Pi.single i 1) j : ℤ) : ℝ)| := by rw [Finset.mul_sum]
    _ ≤ ‖a‖ * ∑ j, ∑ i, |((b.repr (Pi.single i 1) j : ℤ) : ℝ)| := by
        refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
        exact Finset.single_le_sum (f := fun j => ∑ i, |((b.repr (Pi.single i 1) j : ℤ) : ℝ)|)
          (fun j _ => by positivity) (Finset.mem_univ j)
    _ = _ := by ring

/-- **Properness estimate.** -/
theorem proper_bound {P : Type*} [CommGroup P] [TopologicalSpace P] [IsTopologicalGroup P]
    [T2Space P] [LocallyCompactSpace P] (P₀ : Subgroup P) (hP₀ : IsOpen (P₀ : Set P))
    {m n r s : ℕ} {d : Fin s → ℕ} (hd : ∀ i, d i ≠ 0)
    (α : ↥P₀ →* Multiplicative (ElemGroup m n r s d)) (hαc : Continuous α) (hαo : IsOpenMap α)
    (hαk : IsCompact {x : ↥P₀ | α x = 1})
    {m' n' r' s' : ℕ} {d' : Fin s' → ℕ} (β : P →* Multiplicative (ElemGroup m' n' r' s' d'))
    (hβc : Continuous β) :
    ∃ C : ℝ, ∀ p : P₀, nc (Multiplicative.toAdd (β p)) ≤ C * (1 + nc (Multiplicative.toAdd (α p))) := by
  classical
  haveI : LocallyCompactSpace P₀ := hP₀.locallyCompactSpace
  haveI : ∀ i, NeZero (d i) := fun i => ⟨hd i⟩
  let ea : P₀ → ElemGroup m n r s d := fun p => Multiplicative.toAdd (α p)
  let eb : P₀ → ElemGroup m' n' r' s' d' := fun p => Multiplicative.toAdd (β p)
  have ea_mul : ∀ p q, ea (p * q) = ea p + ea q := fun p q => by simp [ea]
  have eb_mul : ∀ p q, eb (p * q) = eb p + eb q := fun p q => by simp [eb]
  have ea_inv : ∀ p, ea p⁻¹ = - ea p := fun p => by simp [ea]
  have eb_inv : ∀ p, eb p⁻¹ = - eb p := fun p => by simp [eb]
  have ea_one : ea 1 = 0 := by simp [ea]
  have heb_c : Continuous eb := continuous_toAdd.comp (hβc.comp continuous_subtype_val)
  have hea_c : Continuous ea := continuous_toAdd.comp hαc
  have hea_o : IsOpenMap ea := LCA.isOpenMap_toAdd'.comp hαo
  let B1 : Set (ElemGroup m n r s d) :=
    Metric.closedBall 0 1 ×ˢ (univ ×ˢ (Metric.closedBall 0 1 ×ˢ univ))
  have hB1 : IsCompact B1 :=
    (isCompact_closedBall _ _).prod (isCompact_univ.prod ((isCompact_closedBall _ _).prod isCompact_univ))
  have hk' : {x : P₀ | ea x = 0} = {x | α x = 1} := by ext x; simp [ea]
  have hS1 : IsCompact {p : P₀ | ea p ∈ B1} :=
    isCompact_preimage_of_open_hom ea ea_mul hea_c hea_o (by rw [hk']; exact hαk) B1 hB1
  obtain ⟨M, hM⟩ := hS1.exists_bound_of_continuousOn (f := fun p => nc (eb p))
    (continuous_nc.comp heb_c).continuousOn
  have hMb : ∀ p, ea p ∈ B1 → nc (eb p) ≤ |M| := fun p hp => by
    have := hM p hp
    rw [Real.norm_eq_abs, abs_of_nonneg (nc_nonneg _)] at this
    exact this.trans (le_abs_self M)
  have hB1mem : ∀ e : ElemGroup m n r s d, ‖e.1‖ ≤ 1 → ‖e.2.2.1‖ ≤ 1 → e ∈ B1 := fun e h1 h2 =>
    ⟨mem_closedBall_zero_iff.2 h1, trivial, mem_closedBall_zero_iff.2 h2, trivial⟩
  let Hr : AddSubgroup (ElemGroup m n r s d) :=
    { carrier := range ea
      add_mem' := by rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩; exact ⟨a * b, ea_mul a b⟩
      zero_mem' := ⟨1, ea_one⟩
      neg_mem' := by rintro _ ⟨a, rfl⟩; exact ⟨a⁻¹, ea_inv a⟩ }
  have hHr_open : IsOpen (Hr : Set (ElemGroup m n r s d)) := by
    show IsOpen (range ea); rw [← image_univ]; exact hea_o _ isOpen_univ
  let M₁ : AddSubgroup (Fin r → ℤ) :=
    { carrier := {a | ∃ b, ((0, 0, a, b) : ElemGroup m n r s d) ∈ Hr}
      add_mem' := by
        rintro a₁ a₂ ⟨b₁, h₁⟩ ⟨b₂, h₂⟩
        refine ⟨b₁ + b₂, ?_⟩
        have := Hr.add_mem h₁ h₂
        convert this using 1
        ext <;> simp
      zero_mem' := ⟨0, Hr.zero_mem⟩
      neg_mem' := by
        rintro a ⟨b, h⟩
        refine ⟨-b, ?_⟩
        have := Hr.neg_mem h
        convert this using 1
        ext <;> simp }
  obtain ⟨sN, snf⟩ := M₁.toIntSubmodule.smithNormalForm (Pi.basisFun ℤ (Fin r))
  have hc := LCA.snf_coeff_ne_zero snf
  have hlift : ∀ i, ∃ p : P₀, ∃ b, ea p = (0, 0, (snf.bN i : Fin r → ℤ), b) := fun i => by
    obtain ⟨b, p, hp⟩ := (snf.bN i).2
    exact ⟨p, b, hp⟩
  choose h hb hh using hlift
  set Mh := ∑ i, nc (eb (h i)) with hMh
  have hMh0 : 0 ≤ Mh := Finset.sum_nonneg fun i _ => nc_nonneg _
  obtain ⟨Cc, hCc0, hCc⟩ := coord_bound snf.bM
  refine ⟨4 * |M| + Cc * Mh + 1, fun p => ?_⟩
  -- decomposition
  set L : ℕ := ⌈‖(ea p).1‖⌉₊ + 1 with hLdef
  have hLpos : (0 : ℝ) < L := by positivity
  have hL1 : ‖(ea p).1‖ < L := by
    have := Nat.le_ceil ‖(ea p).1‖; push_cast [hLdef]; linarith
  have hL2 : (L : ℝ) ≤ ‖(ea p).1‖ + 2 := by
    have := Nat.ceil_lt_add_one (norm_nonneg (ea p).1); push_cast [hLdef]; linarith
  obtain ⟨u, hu⟩ : ∃ u : P₀, ea u = expE ((L : ℝ)⁻¹ • (ea p).1, 0) :=
    expE_mem_of_isOpen Hr hHr_open _
  obtain ⟨z, hz⟩ := piT_surjective n (ea p).2.1
  obtain ⟨v, hv⟩ : ∃ v : P₀, ea v = expE (0, z) := expE_mem_of_isOpen Hr hHr_open _
  have hu' : ea u = ((L : ℝ)⁻¹ • (ea p).1, 0, 0, 0) := by
    rw [hu]; ext <;> simp [expE]
  have hv' : ea v = (0, (ea p).2.1, 0, 0) := by
    rw [hv, ← hz]; rfl
  let p' := p * (u ^ L)⁻¹ * v⁻¹
  have hp' : ea p' = (0, 0, (ea p).2.2.1, (ea p).2.2.2) := by
    have e1 : ea (u ^ L) = L • ea u := by simp [ea]
    simp only [p', ea_mul, ea_inv, e1, hu', hv']
    refine Prod.ext ?_ (Prod.ext ?_ (Prod.ext ?_ ?_))
    · simp only [Prod.fst_add, Prod.fst_neg, Prod.smul_fst]
      rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul, mul_inv_cancel₀ hLpos.ne', one_smul]
      abel
    · simp
    · simp
    · simp
  have ha : (ea p).2.2.1 ∈ M₁ := ⟨(ea p).2.2.2, p', hp'⟩
  have ha' : (ea p).2.2.1 ∈ M₁.toIntSubmodule := ha
  let q := snf.bN.repr ⟨(ea p).2.2.1, ha'⟩
  have hq : ∀ i, |((q i : ℤ) : ℝ)| ≤ Cc * ‖(ea p).2.2.1‖ := by
    intro i
    have e := LCA.snf_repr snf ha' i
    have h1 : (1 : ℝ) ≤ |((snf.a i : ℤ) : ℝ)| := by
      have : (1 : ℤ) ≤ |snf.a i| := Int.one_le_abs (hc i)
      exact_mod_cast this
    calc |((q i : ℤ) : ℝ)| ≤ |((snf.a i : ℤ) : ℝ)| * |((q i : ℤ) : ℝ)| :=
          le_mul_of_one_le_left (abs_nonneg _) h1
      _ = |((snf.bM.repr (ea p).2.2.1 (snf.f i) : ℤ) : ℝ)| := by
          rw [e]; push_cast; rw [abs_mul]
      _ ≤ Cc * ‖(ea p).2.2.1‖ := hCc _ _
  have hsum : (ea p).2.2.1 = ∑ i, q i • (snf.bN i : Fin r → ℤ) := by
    have := congrArg Subtype.val (snf.bN.sum_repr ⟨(ea p).2.2.1, ha'⟩)
    rw [Submodule.coe_sum] at this
    simpa using this.symm
  let PP : P₀ := ∏ i, h i ^ q i
  have hPPa : ea PP = ∑ i, q i • ea (h i) := by simp [PP, ea, map_prod, toAdd_prod]
  have hPPb : eb PP = ∑ i, q i • eb (h i) := by simp [PP, eb, map_prod, toAdd_prod]
  let p'' := p' * PP⁻¹
  have hp''B : ea p'' ∈ B1 := by
    apply hB1mem
    · simp only [p'', ea_mul, ea_inv, hp', hPPa, Prod.fst_add, Prod.fst_neg, Prod.fst_sum,
        Prod.smul_fst, hh]
      simp
    · have e : (ea p'').2.2.1 = 0 := by
        simp only [p'', ea_mul, ea_inv, hp', hPPa, Prod.snd_add, Prod.fst_add, Prod.snd_neg,
          Prod.fst_neg, Prod.snd_sum, Prod.fst_sum, Prod.smul_snd, Prod.smul_fst, hh]
        rw [hsum]; abel
      rw [e, norm_zero]; norm_num
  have hdec : eb p = L • eb u + eb v + eb PP + eb p'' := by
    have e1 : eb (u ^ L) = L • eb u := by simp [eb]
    simp only [p'', p', eb_mul, eb_inv, e1]; abel
  have huB : ea u ∈ B1 := by
    apply hB1mem
    · rw [hu', norm_smul, norm_inv, Real.norm_natCast, inv_mul_le_iff₀ hLpos]; linarith
    · rw [hu']; simp
  have hvB : ea v ∈ B1 := by
    apply hB1mem <;> rw [hv'] <;> simp
  have hPPnc : nc (eb PP) ≤ Cc * ‖(ea p).2.2.1‖ * Mh := by
    rw [hPPb]
    refine (nc_sum _ _).trans ?_
    rw [hMh, Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    exact (nc_zsmul _ _).trans (mul_le_mul_of_nonneg_right (hq i) (nc_nonneg _))
  have hpnc : nc (ea p) = ‖(ea p).1‖ + ‖(ea p).2.2.1‖ := rfl
  have hfin : nc (eb p) ≤ L * |M| + |M| + Cc * ‖(ea p).2.2.1‖ * Mh + |M| := by
    rw [hdec]
    refine (nc_add _ _).trans (add_le_add ((nc_add _ _).trans (add_le_add ((nc_add _ _).trans
      (add_le_add ((nc_nsmul _ _).trans (mul_le_mul_of_nonneg_left (hMb u huB) hLpos.le))
        (hMb v hvB))) hPPnc)) (hMb p'' hp''B))
  show nc (eb p) ≤ (4 * |M| + Cc * Mh + 1) * (1 + nc (ea p))
  rw [hpnc]
  have hx0 := norm_nonneg (ea p).1
  have ha0 := norm_nonneg (ea p).2.2.1
  have hM0 := abs_nonneg M
  have hCM : 0 ≤ Cc * Mh := mul_nonneg hCc0 hMh0
  nlinarith [mul_le_mul_of_nonneg_right hL2 hM0]

end MasulloGRH

end SC5b_sec

section SC4a_sec

open Set Filter Topology

namespace MasulloGRH

variable {m n r s : ℕ} {d : Fin s → ℕ}

/-- An integer lattice vector in lifted coordinates. -/
def latv (k : Fin n → ℤ) : (Fin m → ℝ) × (Fin n → ℝ) := (0, fun j => (k j : ℝ))

lemma elemLift_periodic (g : ElemGroup m n r s d → ℂ) (a : Fin r → ℤ)
    (b : (i : Fin s) → ZMod (d i)) (xt : (Fin m → ℝ) × (Fin n → ℝ)) (k : Fin n → ℤ) :
    elemLift g a b (xt + latv k) = elemLift g a b xt := by
  unfold elemLift latv
  congr 1
  refine Prod.ext (by simp) (Prod.ext (funext fun j => ?_) rfl)
  simp only [Prod.snd_add, Pi.add_apply, AddCircle.coe_add]
  have : (((k j : ℤ) : ℝ) : UnitAddCircle) = 0 :=
    (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).2 ⟨k j, by simp⟩
  rw [this, add_zero]

lemma iteratedFDeriv_elemLift_periodic (g : ElemGroup m n r s d → ℂ) (a : Fin r → ℤ)
    (b : (i : Fin s) → ZMod (d i)) (q : ℕ) (xt : (Fin m → ℝ) × (Fin n → ℝ)) (k : Fin n → ℤ) :
    iteratedFDeriv ℝ q (elemLift g a b) (xt + latv k) = iteratedFDeriv ℝ q (elemLift g a b) xt := by
  have h : (fun y => elemLift g a b (y + latv k)) = elemLift g a b :=
    funext fun y => elemLift_periodic g a b y k
  rw [← iteratedFDeriv_comp_add_right, h]

/-- A chosen lift of a point of the torus. -/
noncomputable def liftT (θ : Fin n → UnitAddCircle) : Fin n → ℝ := (piT_surjective n θ).choose

lemma piT_liftT (θ : Fin n → UnitAddCircle) : piT n (liftT θ) = θ :=
  (piT_surjective n θ).choose_spec

lemma liftT_piT (z : Fin n → ℝ) : ∃ k : Fin n → ℤ, liftT (piT n z) = z + fun j => (k j : ℝ) := by
  have h0 : piT n (liftT (piT n z) - z) = 0 := by rw [map_sub, piT_liftT, sub_self]
  choose k hk using (piT_eq_zero_iff n _).1 h0
  exact ⟨k, funext fun j => by have := hk j; simp only [Pi.sub_apply] at this; simp; linarith⟩

section Psi

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]

/-- Derivatives of `elemLift g` composed with a linear map. -/
noncomputable def Dk (g : ElemGroup m n r s d → ℂ) (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ))
    (k : ℕ) (a : Fin r → ℤ) (b : (i : Fin s) → ZMod (d i)) (xt : (Fin m → ℝ) × (Fin n → ℝ)) :
    ContinuousMultilinearMap ℝ (fun _ : Fin k => H) ℂ :=
  (iteratedFDeriv ℝ k (elemLift g a b) xt).compContinuousLinearMap (fun _ => Λc)

/-- The same, as a function on `E`. -/
noncomputable def Ψb (g : ElemGroup m n r s d → ℂ) (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ))
    (k : ℕ) (e : ElemGroup m n r s d) : ContinuousMultilinearMap ℝ (fun _ : Fin k => H) ℂ :=
  Dk g Λc k e.2.2.1 e.2.2.2 (e.1, liftT e.2.1)

lemma Ψb_eq (g : ElemGroup m n r s d → ℂ) (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (k : ℕ)
    (e : ElemGroup m n r s d) (z : Fin n → ℝ) (hz : piT n z = e.2.1) :
    Ψb g Λc k e = Dk g Λc k e.2.2.1 e.2.2.2 (e.1, z) := by
  unfold Ψb Dk
  obtain ⟨k', hk'⟩ := liftT_piT z
  rw [← hz, hk']
  have : ((e.1, z + fun j => (k' j : ℝ)) : (Fin m → ℝ) × (Fin n → ℝ)) = (e.1, z) + latv k' := by
    ext <;> simp [latv]
  rw [this, iteratedFDeriv_elemLift_periodic]

lemma continuous_Dk {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (k : ℕ) (a : Fin r → ℤ)
    (b : (i : Fin s) → ZMod (d i)) : Continuous (Dk g Λc k a b) :=
  (ContinuousMultilinearMap.compContinuousLinearMapL (fun _ : Fin k => Λc)).continuous.comp
    ((hg.1 a b).continuous_iteratedFDeriv (by exact_mod_cast le_top))

lemma continuous_Ψb {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (k : ℕ) : Continuous (Ψb g Λc k) := by
  rw [continuous_iff_continuousAt]
  intro e₀
  let Φ : (Fin m → ℝ) × (Fin n → UnitAddCircle) → ContinuousMultilinearMap ℝ (fun _ : Fin k => H) ℂ :=
    fun p => Ψb g Λc k (p.1, p.2, e₀.2.2.1, e₀.2.2.2)
  have hQ : Topology.IsQuotientMap (Prod.map (id : (Fin m → ℝ) → (Fin m → ℝ)) (piT n)) :=
    (IsOpenQuotientMap.mk ((Function.surjective_id).prodMap (piT_surjective n))
      (continuous_id.prodMap (continuous_piT n)) (IsOpenMap.id.prodMap (isOpenMap_piT n))).isQuotientMap
  have hΦ : Continuous Φ := by
    rw [hQ.continuous_iff]
    have : Φ ∘ Prod.map id (piT n) = fun p => Dk g Λc k e₀.2.2.1 e₀.2.2.2 (p.1, p.2) := by
      funext p
      exact Ψb_eq g Λc k _ p.2 rfl
    rw [this]
    exact (continuous_Dk hg Λc k _ _).comp (continuous_fst.prodMk continuous_snd)
  have hU : {e : ElemGroup m n r s d | e.2.2 = e₀.2.2} ∈ 𝓝 e₀ :=
    ((isOpen_discrete {e₀.2.2}).preimage (continuous_snd.comp continuous_snd)).mem_nhds rfl
  have hev : (fun e => Φ (e.1, e.2.1)) =ᶠ[𝓝 e₀] Ψb g Λc k := by
    filter_upwards [hU] with e he
    show Ψb g Λc k (e.1, e.2.1, e₀.2.2.1, e₀.2.2.2) = Ψb g Λc k e
    rw [← he]
  exact ((hΦ.comp (continuous_fst.prodMk (continuous_fst.comp continuous_snd))).continuousAt).congr hev

end Psi

section phi

variable {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]

lemma phi_eq (g : ElemGroup m n r s d → ℂ) (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ))
    (e : ElemGroup m n r s d) :
    (fun w => g (e + expE (Λc w))) =
      fun w => elemLift g e.2.2.1 e.2.2.2 ((e.1, liftT e.2.1) + Λc w) := by
  funext w
  unfold elemLift expE
  congr 1
  refine Prod.ext rfl (Prod.ext (funext fun j => ?_) (Prod.ext (by simp) (by simp)))
  simp only [expE, Prod.snd_add, Prod.fst_add, Pi.add_apply, AddCircle.coe_add]
  congr 1
  have := congrFun (piT_liftT e.2.1) j
  rw [piT_apply] at this
  exact this.symm

lemma phi_contDiff {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (e : ElemGroup m n r s d) :
    ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun w => g (e + expE (Λc w))) := by
  rw [phi_eq]
  exact (hg.1 _ _).comp (contDiff_const.add Λc.contDiff)

lemma phi_iter {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (e : ElemGroup m n r s d) (k : ℕ) (w : H) :
    iteratedFDeriv ℝ k (fun w => g (e + expE (Λc w))) w =
      Dk g Λc k e.2.2.1 e.2.2.2 ((e.1, liftT e.2.1) + Λc w) := by
  rw [phi_eq]
  have h1 : (fun w => elemLift g e.2.2.1 e.2.2.2 ((e.1, liftT e.2.1) + Λc w)) =
      (fun y => elemLift g e.2.2.1 e.2.2.2 ((e.1, liftT e.2.1) + y)) ∘ Λc := rfl
  have hcd : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞)
      (fun y => elemLift g e.2.2.1 e.2.2.2 ((e.1, liftT e.2.1) + y)) :=
    (hg.1 _ _).comp (contDiff_const.add contDiff_id)
  rw [h1, Λc.iteratedFDeriv_comp_right hcd w (by exact_mod_cast le_top),
    iteratedFDeriv_comp_add_left]
  rfl

lemma phi_iter_Ψb {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (e : ElemGroup m n r s d) (k : ℕ) (w : H) :
    iteratedFDeriv ℝ k (fun w => g (e + expE (Λc w))) w = Ψb g Λc k (e + expE (Λc w)) := by
  rw [phi_iter hg, Ψb_eq g Λc k _ (liftT e.2.1 + (Λc w).2)]
  · congr 1 <;> simp [expE]
  · simp only [expE, Prod.snd_add, Prod.fst_add, map_add, piT_liftT]
    rfl

lemma phi_bound {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g)
    (Λc : H →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) (e : ElemGroup m n r s d) (k : ℕ) (w : H) :
    ‖iteratedFDeriv ℝ k (fun w => g (e + expE (Λc w))) w‖ ≤
      ‖iteratedFDeriv ℝ k (elemLift g e.2.2.1 e.2.2.2) ((e.1, liftT e.2.1) + Λc w)‖ * ‖Λc‖ ^ k := by
  rw [phi_iter hg]
  unfold Dk
  refine (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans (le_of_eq ?_)
  simp

lemma continuous_of_isRapidDecay {g : ElemGroup m n r s d → ℂ} (hg : IsRapidDecay g) :
    Continuous g := by
  have h := continuous_Ψb (H := ℝ) hg 0 0
  have e : ∀ e, g e = Ψb g (0 : ℝ →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) 0 e (fun i => Fin.elim0 i) := by
    intro e
    unfold Ψb Dk
    rw [ContinuousMultilinearMap.compContinuousLinearMap_apply, iteratedFDeriv_zero_apply]
    unfold elemLift
    congr 1
    refine Prod.ext rfl (Prod.ext ?_ rfl)
    have := piT_liftT e.2.1
    exact this.symm
  have : g = fun e => Ψb g (0 : ℝ →L[ℝ] (Fin m → ℝ) × (Fin n → ℝ)) 0 e (fun i => Fin.elim0 i) :=
    funext e
  rw [this]
  exact (continuous_eval_const _).comp h

end phi

end MasulloGRH

end SC4a_sec

section SC6a_sec

open MeasureTheory Set Filter Topology

namespace MasulloGRH

lemma continuous_ite_clopen {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] {S : Set X}
    (hS : IsClopen S) [DecidablePred (· ∈ S)] {f g : X → Y} (hf : ContinuousOn f S)
    (hg : Continuous g) : Continuous fun x => if x ∈ S then f x else g x :=
  continuous_if (by simp [hS.frontier_eq]) (by
    show ContinuousOn f (closure S); rwa [hS.isClosed.closure_eq]) hg.continuousOn

lemma continuous_extendPullback {P : Type*} [CommGroup P] [TopologicalSpace P]
    [IsTopologicalGroup P] (P₀ : Subgroup P) (hP₀ : IsOpen (P₀ : Set P)) {m n r s : ℕ}
    {d : Fin s → ℕ} (α : ↥P₀ →* Multiplicative (ElemGroup m n r s d)) (hαc : Continuous α)
    {g : ElemGroup m n r s d → ℂ} (hg : Continuous g) : Continuous (extendPullback P₀ α g) := by
  classical
  rw [continuous_iff_continuousAt]
  intro x
  by_cases hx : x ∈ P₀
  · have hon : ContinuousOn (extendPullback P₀ α g) P₀ := by
      rw [continuousOn_iff_continuous_domRestrict]
      have : (P₀ : Set P).domRestrict (extendPullback P₀ α g) =
          fun y : P₀ => g (Multiplicative.toAdd (α y)) := by
        funext y
        show (if h : (y : P) ∈ P₀ then g (Multiplicative.toAdd (α ⟨y, h⟩)) else 0) = _
        rw [dif_pos (show (y : P) ∈ P₀ from y.2)]
        rfl
      rw [this]
      exact hg.comp (continuous_toAdd.comp hαc)
    exact hon.continuousAt (hP₀.mem_nhds hx)
  · have hcl : IsClosed (P₀ : Set P) := Subgroup.isClosed_of_isOpen P₀ hP₀
    have hev : ∀ᶠ y in 𝓝 x, y ∉ P₀ := hcl.isOpen_compl.mem_nhds hx
    exact (continuousAt_const (y := (0 : ℂ))).congr (hev.mono fun y hy => by
      simp only [extendPullback, dif_neg hy])

section Haar

variable {P : Type*} [CommGroup P] [TopologicalSpace P] [IsTopologicalGroup P]

/-- The Borel structure on subgroups (as in the definition of `subgroupHaar`). -/
abbrev kms (K : Subgroup P) : MeasurableSpace K := borel K

attribute [local instance] kms

instance kmsBorel (K : Subgroup P) : BorelSpace K := ⟨rfl⟩

/-- The average over a compact subgroup. -/
noncomputable def Fav (K : Subgroup P) (f : P → ℂ) (x : P) : ℂ :=
  ∫ y : K, f (x * y) ∂subgroupHaar K

lemma sba_eq (K : Subgroup P) (f : P → ℂ) (x : P) :
    schwartzBruhatAverage ⊤ K f x = Fav K f x := by
  unfold schwartzBruhatAverage Fav
  simp

lemma subgroupHaar_eq (K : Subgroup P) (hK : IsCompact (K : Set P)) [CompactSpace K] :
    subgroupHaar K = Measure.haarMeasure ⊤ := by
  unfold subgroupHaar
  rw [dif_pos hK]

lemma subgroupHaar_isProb (K : Subgroup P) (hK : IsCompact (K : Set P)) [CompactSpace K] :
    IsProbabilityMeasure (subgroupHaar K) := by
  rw [subgroupHaar_eq K hK]
  constructor
  have := Measure.haarMeasure_self (G := K) (K₀ := ⊤)
  simpa using this

lemma integral_shift (K : Subgroup P) (hK : IsCompact (K : Set P)) [CompactSpace K]
    (f : K → ℂ) (k : K) : ∫ y : K, f (k * y) ∂subgroupHaar K = ∫ y : K, f y ∂subgroupHaar K := by
  rw [subgroupHaar_eq K hK]
  exact integral_mul_left_eq_self f k

lemma Fav_inv (K : Subgroup P) (hK : IsCompact (K : Set P)) [CompactSpace K] (f : P → ℂ)
    (x : P) (k : K) : Fav K f (x * k) = Fav K f x := by
  unfold Fav
  have := integral_shift K hK (fun y : K => f (x * y)) k
  simp only [Subgroup.coe_mul, ← mul_assoc] at this
  exact this

end Haar

end MasulloGRH

