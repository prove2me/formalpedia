theorem GlobalTheory.JR.WeilQuad.Fnf.tr_smul_right (A : Et F E) (c : A.K) (a b : A.L) :
    Algebra.trace A.K A.L (star a * (c • b)) = c * Algebra.trace A.K A.L (star a * b) := by sorry
