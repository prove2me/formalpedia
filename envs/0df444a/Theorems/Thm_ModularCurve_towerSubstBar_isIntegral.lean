open ModularCurve AlgebraicCurve

theorem ModularCurve.towerSubstBar_isIntegral (L : Type*) [Field L] [Algebra ℚ L] {N M : ℕ} [NeZero N] [NeZero M] (ℓ : ℕ) [Fact ℓ.Prime] (h : N * ℓ ∣ M) : (towerSubstBar L N ℓ h).toRingHom.IsIntegral := by sorry
