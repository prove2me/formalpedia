      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, zsz_zero, NLogN.zsz_two_pow]
      refine ⟨?_, by rw [hlol, hjE']; omega⟩
      simp only [hs4, hs3', hs3, hs2, hs1, htops, hbots]
