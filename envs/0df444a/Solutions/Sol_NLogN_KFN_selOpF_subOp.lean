variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
variable {M : Type*} [AddCommMonoid M] [Module ℂ M]
theorem solution {g : κ → ι} (hg : Function.Injective g) (st : ι → ℕ) (n : ℕ)
    (T : Matrix (κ → Fin 2) (κ → Fin 2) ℂ) (xs : List M) :
    NLogN.KFN.selOpF st n (NLogN.KFN.subOp g T) xs = NLogN.KFN.selOpF (st ∘ g) n T xs := by
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [NLogN.KFN.selOpF, List.getElem_map, List.getElem_range]
  set x := NLogN.KFN.fbit st j
  -- the nonzero terms are the extensions
  have hfilt : (Finset.univ.filter fun y : ι → Fin 2 => ∀ i, (∀ k, g k ≠ i) → x i = y i) =
      Finset.univ.image (NLogN.KFN.extB g x) := by
    ext y
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
    constructor
    · intro hy
      refine ⟨y ∘ g, funext fun i => ?_⟩
      by_cases hi : ∃ k, g k = i
      · obtain ⟨k, rfl⟩ := hi
        rw [NLogN.KFN.extB_g hg]; rfl
      · push Not at hi
        rw [NLogN.KFN.extB_off _ _ hi, hy i hi]
    · rintro ⟨z, rfl⟩ i hi
      rw [NLogN.KFN.extB_off _ _ hi]
  have hinj : Function.Injective (NLogN.KFN.extB g x) := by
    intro z z' h
    funext k
    have := congrFun h (g k)
    rwa [NLogN.KFN.extB_g hg, NLogN.KFN.extB_g hg] at this
  rw [← Finset.sum_filter_add_sum_filter_not Finset.univ
    (fun y : ι → Fin 2 => ∀ i, (∀ k, g k ≠ i) → x i = y i)]
  rw [Finset.sum_eq_zero (s := Finset.univ.filter fun y => ¬ _) (fun y hy => by
    simp only [Finset.mem_filter] at hy
    simp only [NLogN.KFN.subOp, if_neg hy.2, zero_smul]), add_zero, hfilt,
    Finset.sum_image (fun a _ b _ h => hinj h)]
  refine Finset.sum_congr rfl fun z _ => ?_
  have hc : ∀ i, (∀ k, g k ≠ i) → x i = NLogN.KFN.extB g x z i := fun i hi => (NLogN.KFN.extB_off _ _ hi).symm
  have hgz : NLogN.KFN.extB g x z ∘ g = z := funext fun k => NLogN.KFN.extB_g hg _ _ k
  rw [NLogN.KFN.subOp, if_pos hc, hgz]
  congr 2
  unfold NLogN.KFN.fset
  rw [NLogN.KFN.fsetZ_extB hg]
