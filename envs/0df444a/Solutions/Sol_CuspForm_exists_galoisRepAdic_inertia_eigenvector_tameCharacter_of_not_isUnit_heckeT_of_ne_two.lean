          (y : ℕ → ModularCurve.JZero Mg) = σ • (x : ℕ → ModularCurve.JZero Mg) →
            ∀ b : 𝒪'', ρM σ (b ⊗ₜ[ℤ_[p]] x) = b ⊗ₜ[ℤ_[p]] y)
