theorem solution (hsw : IntMul.OpenAI.R129.P.NLogN.KFM.SwapNeed) : IntMul.OpenAI.R129.P.NLogN.KFM.PhiNeed := by
  obtain ⟨E₁, ext₁, entry, sdS, K, hdS, hK0, hS⟩ := hsw
  refine ⟨E₁ + 0 + 0 + 2, NLogN.KFM.mExt ext₁ NLogN.KFUU.ext0 NLogN.KFUU.ext0 (NLogN.KFUU.ownPhi E₁ entry sdS), NLogN.KFM.gO E₁ 0 0 2 0,
    NLogN.KFM.gO E₁ 0 0 2 1, NLogN.KFUU.dP, (NLogN.KFUU.C1 : ℝ) + 781 * K, by decide, by positivity, ?_⟩
  intro Isym w h d bL sF μ hh hsz s f l hf hfd
  have hs : ∀ j < d, 1 ≤ sF j := fun j hj => (hsz j hj).1
  have hst : ∀ j < d, sF j ≤ 2 ^ (h + if bL j then 1 else 0) := fun j hj => (hsz j hj).2.1
  have hμ : ∀ j < d, μ j < sF j := fun j hj => (hsz j hj).2.2
  set ext := NLogN.KFM.mExt ext₁ NLogN.KFUU.ext0 NLogN.KFUU.ext0 (NLogN.KFUU.ownPhi E₁ entry sdS) with hext
  set eSw := NLogN.KFM.gI E₁ (E₁ + 0 + 0 + 2) 0 (by omega) entry with heSw
  -- the multiplier and the swaps in the merged table
  have hM : NLogN.MulOK Isym (NLogN.KFM.kTable ext) (NLogN.KFM.pMul _) MS := NLogN.KFM.kTable_mulOK ext
  have hK : IntMul.OpenAI.R129.P.NLogN.KFUU.SwOKU Isym (NLogN.KFM.kTable ext) eSw sdS K := by
    intro u w' sh p q hu hpos hpq hq gp gq s' f' zs l' hf' hfd' h0' hlen' hgb'
    obtain ⟨c, H, hc⟩ := hS Isym u w' sh p q hu hpos hpq hq gp gq s' f' zs l' hf' hfd' h0' hlen' hgb'
    exact ⟨c, NLogN.KFM.IRuns.relabel (NLogN.KFM.mTable_g1 ext₁ NLogN.KFUU.ext0 NLogN.KFUU.ext0 (NLogN.KFUU.ownPhi E₁ entry sdS)) H, by
      unfold IntMul.OpenAI.R129.P.NLogN.KFUU.cSwN; exact hc⟩
