theorem chirpP_runs_aux {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {Δ φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ Δ + 2 → NLogN.zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (T : ℕ) :
    ∀ (d : ℕ) (s t : Fin d → ℕ), (∀ i, s i ≤ t i) → (∀ i, 0 < t i) → (∀ i, t i ≤ T) →
      d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
      ∀ (st : NLogN.IState NLogN.HS) (LR : List NLogN.Item), st.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR →
      NLogN.IRuns I iprog (NLogN.KFM.chirpP pM Δ d s t) st
        (st.upd NLogN.KFM.pQ1 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.chirpArr Δ d s t)) ++ st.G NLogN.KFM.pQ1)) (NLogN.KFM.cChirpP Δ φ d s t) 
  | 0, s, t, _, _, _, _, st, LR, hR => by
    have k1 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := st) NLogN.KFM.pQ1 0
    have k2 := NLogN.IRuns.const (I := I) (iprog := iprog) (s := st.upd NLogN.KFM.pQ1 (.int 0 :: st.G NLogN.KFM.pQ1)) NLogN.KFM.pQ1
      (2 ^ Δ)
    refine (k1.seq k2).mono' ?_ ?_
    · simp [NLogN.KFM.chirpArr, NLogN.KFM.oneP, NLogN.ints]
    · have := NLogN.KFM.zsz_two_pow Δ; simp only [NLogN.zsz_zero, NLogN.KFM.cChirpP] at *; omega
  | d + 1, s, t, hst, ht, hT, hu, st, LR, hR => by
    have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ Δ := by positivity
    have hu' : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := by
      refine le_trans ?_ hu; push_cast
      have : (0 : ℝ) ≤ (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ := by positivity
      nlinarith
    have ih := chirpP_runs_aux hM hdom hΦ T d (fun i => s i.castSucc) (fun i => t i.castSucc)
      (fun i => hst _) (fun i => ht _) (fun i => hT _) hu' st LR hR
    set A := NLogN.KFM.chirpArr Δ d (fun i => s i.castSucc) (fun i => t i.castSucc) with hAdef
    have hAl : A.length = ∏ i : Fin d, t i.castSucc := NLogN.KFM.length_chirpArr Δ d _ _
    have hT0 : (0 : ℝ) ≤ (T : ℝ) ^ 2 := by positivity
    have e1 : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := hu'
    have hA : NLogN.KFB.GB (Δ + 2) A := fun z hz =>
      (NLogN.KFM.chirpArr_near Δ T d _ _ (fun i => hst _) (fun i => ht _) (fun i => hT _) hu' z hz).bnd hu'
    have hC : NLogN.KFB.GB (Δ + 2) (NLogN.KFM.oprod Δ A (NLogN.KFM.axTab Δ (s (Fin.last d)) (t (Fin.last d)))) := fun z hz =>
      (NLogN.KFM.chirpArr_near Δ T (d + 1) s t hst ht hT hu z (by rw [NLogN.KFM.chirpArr]; exact hz)).bnd hu
    have htl : (t (Fin.last d) : ℝ) ≤ T := by exact_mod_cast hT _
    have htl0 : (0 : ℝ) ≤ t (Fin.last d) := Nat.cast_nonneg _
    have hsq : (t (Fin.last d) : ℝ) ^ 2 ≤ (T : ℝ) ^ 2 := by gcongr
    have hax : (4 * (t (Fin.last d) : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := by
      have h4 : 4 * (t (Fin.last d) : ℝ) ^ 2 + 1 ≤ ((d + 1 : ℕ) : ℝ) * (8 * (T : ℝ) ^ 2 + 2) := by
        push_cast; nlinarith
      exact (mul_le_mul_of_nonneg_right h4 hu0).trans hu
    have lv := NLogN.KFM.levP_runs (I := I) (iprog := iprog) hM hdom hΦ (s (Fin.last d)) (t (Fin.last d))
      (hst _) (ht _) hax (st.upd NLogN.KFM.pQ1 (NLogN.ints (NLogN.KFB.gflat A) ++ st.G NLogN.KFM.pQ1)) A (st.G NLogN.KFM.pQ1) LR (by simp)
      (by simp +decide [hR]) hA hC
    rw [hAl] at lv
    refine (ih.seq lv).mono' ?_ le_rfl
    simp [NLogN.KFM.chirpArr, hAdef]

theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {Δ φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ Δ + 2 → NLogN.zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (T : ℕ) :
    ∀ (d : ℕ) (s t : Fin d → ℕ), (∀ i, s i ≤ t i) → (∀ i, 0 < t i) → (∀ i, t i ≤ T) →
      d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 →
      ∀ (st : NLogN.IState NLogN.HS) (LR : List NLogN.Item), st.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR →
      NLogN.IRuns I iprog (NLogN.KFM.chirpP pM Δ d s t) st
        (st.upd NLogN.KFM.pQ1 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.chirpArr Δ d s t)) ++ st.G NLogN.KFM.pQ1)) (NLogN.KFM.cChirpP Δ φ d s t) := by
  first
  | exact chirpP_runs_aux
  | exact chirpP_runs_aux hM hdom hΦ T
  | (intros; apply chirpP_runs_aux <;> assumption)
