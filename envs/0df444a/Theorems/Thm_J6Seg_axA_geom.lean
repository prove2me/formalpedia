theorem J6Seg.axA_geom (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D,
    1 ≤ HA6 P n ∧ 0 < tF6 P n k / (16 * HA6 P n) ∧
    tF6 P n k = tF6 P n k / (16 * HA6 P n) * 8 * (2 * HA6 P n) ∧
    J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ src k ∧ src k ≤ tF6 P n k ∧
    2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) * tF6 P n k ≤ 16 * HA6 P n * src k ∧
    2 * J6A.WA (pP6 P n) (αN6 P n) (HA6 P n) ≤ 8 * HA6 P n ∧
    2 ^ (Nat.log 2 (sWidth (pP6 P n) (αN6 P n)) + 3) = 8 * HA6 P n ∧
    0 < preT P n D k ∧ 0 < postT P n D k := by sorry
