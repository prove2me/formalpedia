    (hfr : ∀ j, j ∉ myW → t.G j = s0.G j)
    (hD : t.G NLogN.GL.gD = gints x ++ r) (hx : x.length = ax.n) (hxB : NLogN.GL.GB B x) :
    (chunkBody ax).run t = (t.upd NLogN.GL.gD r).upd gZB ((gints (ax.f x)).reverse ++ t.G gZB) ∧
    (chunkBody ax).ok M t ∧
    (chunkBody ax).cost M t ≤ ax.C + 3 * (8000 * (Q + 2) + 2 * (ax.n + ax.n') *
      (14000 * (Q + 2) + 30) + 32) := by
