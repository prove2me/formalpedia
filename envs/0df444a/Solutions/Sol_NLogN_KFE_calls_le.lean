theorem solution {m n : ℕ} (S : ℕ) (hm : 2 ≤ m) (hn : 1 ≤ n) :
    ∑ j ∈ range (Nat.digits m n).length, n / m ^ j % m * (S + 1) ^ j ≤
      m * n ^ (Nat.clog m (S + 1) + 1) := by
  set c := Nat.clog m (S + 1)
  have hSc : S + 1 ≤ m ^ c := Nat.le_pow_clog (by omega) _
  have hterm : ∀ j ∈ range (Nat.digits m n).length, n / m ^ j % m * (S + 1) ^ j ≤ m * n ^ c := by
    intro j hj
    rw [mem_range] at hj
    have h1 : n / m ^ j % m ≤ m := (Nat.mod_lt _ (by omega)).le
    have h2 : (S + 1) ^ j ≤ n ^ c := by
      calc (S + 1) ^ j ≤ (m ^ c) ^ j := Nat.pow_le_pow_left hSc j
        _ = (m ^ j) ^ c := by rw [← pow_mul, ← pow_mul, mul_comm]
        _ ≤ n ^ c := Nat.pow_le_pow_left (NLogN.KIL.pow_le_of_lt_len hm hn hj) c
    exact Nat.mul_le_mul h1 h2
  calc _ ≤ ∑ j ∈ range (Nat.digits m n).length, m * n ^ c := sum_le_sum hterm
    _ = (Nat.digits m n).length * (m * n ^ c) := by rw [sum_const, card_range, smul_eq_mul]
    _ ≤ n * (m * n ^ c) := Nat.mul_le_mul_right _ (NLogN.KIL.digits_len_le hm hn)
    _ = m * n ^ (c + 1) := by ring
end
