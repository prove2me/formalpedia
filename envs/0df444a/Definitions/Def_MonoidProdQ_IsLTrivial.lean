-- title:
--   $\mathcal L$-trivial monoid
-- statement:
--   For an element $x$ of a monoid $M$, the **left ideal** generated by $x$ is $Mx=\{sx : s\in M\}$. Green's relation $\mathcal L$ relates $x$ and $y$ when $Mx=My$. The monoid is **$\mathcal L$-trivial** if
--
--   $$Mx=My\ \Longrightarrow\ x=y\qquad(x,y\in M).$$
--
--   This is the left-handed counterpart of $\mathcal R$-triviality.
-- source:
--   Lee–Santha, The quantum query complexity of the semigroup product problem, arXiv:2609.39974 (held version, sha256 9eec405d…ffb6), §3, Ideals and Green's preorders, pp.22–23

import Mathlib

namespace MonoidProdQ

/-- Lee–Santha, *The quantum query complexity of the semigroup product problem*,
arXiv:2609.39974 (held version, sha256 9eec405d…ffb6), §3, "Ideals and Green's preorders", pp.22–23: the left ideal generated by `m` is
`Mm = {sm : s ∈ M}`, `x L y ⟺ Mx = My`, and a monoid is L-trivial if `Mx = My` implies `x = y`
("similarly for the other relations"). The left ideal `Mx` is `Set.range (fun s => s * x)`. -/
def IsLTrivial (M : Type*) [Monoid M] : Prop :=
  ∀ x y : M, Set.range (fun s : M => s * x) = Set.range (fun s : M => s * y) → x = y

end MonoidProdQ


