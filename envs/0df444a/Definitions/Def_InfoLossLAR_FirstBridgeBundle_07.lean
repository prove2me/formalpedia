  simp only [List.map_reverse,List.reverse_reverse,List.append_nil,List.length_reverse] at hfeed
  obtain ⟨hcall⟩ := _root_.Integration9_9.TM2StockThread.native_call_run machine ein eout (word.map ein.symm) letters context time hcallee
  have hreverse := _root_.Integration9_9.TM2StockThread.context_reverse_run machine ein eout (_root_.Integration9_9.TM2StockThread.nativeOutput machine letters) context [] []
  simp only [List.append_nil] at hreverse
  have hforward := _root_.Integration9_9.TM2StockThread.context_forward_run machine ein eout (_root_.Integration9_9.TM2StockThread.nativeOutput machine letters) context.reverse [] []
  simp only [List.reverse_reverse,List.append_nil,List.length_reverse] at hforward
  have hquote := _root_.Integration9_9.TM2StockThread.quote_output_run machine ein eout letters [] [] (false::context)
  simp only [List.append_nil] at hquote
  have hfinish := _root_.Integration9_9.TM2StockThread.finish_reverse_run machine ein eout (_root_.Integration9_9.TM2StockThread.nativeOutput machine [])
    (letters.flatMap (fun symbol => [true,eout symbol])).reverse [] (false::context)
  simp only [List.reverse_reverse,List.length_reverse,_root_.Integration9_9.TM2StockThread.quotedPayload_length] at hfinish
  have hout : letters.flatMap (fun symbol => [true,eout symbol])++false::context=
      OAI.MetricKMedian.Binary.quote (letters.map eout)++context := by
    simp only [_root_.Integration9_9.TM2StockThread.quote_flatMap,List.flatMap_map,Function.comp_def,List.append_assoc,List.singleton_append]
  rw [hout] at hfinish
  have h1 := EvalsToInTime.trans _ _ _ _ _ _ hparse hfeed
  have h2 := EvalsToInTime.trans _ _ _ _ _ _ h1 hcall
  have h3 := EvalsToInTime.trans _ _ _ _ _ _ h2 hreverse
  have h4 := EvalsToInTime.trans _ _ _ _ _ _ h3 hforward
