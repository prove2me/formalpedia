      ((contDiff_phaseP om mm).comp contDiff_embRT).contDiffOn fun z _ => phaseP_ne_zero om mm _
  refine hc.congr fun z hz => ?_
  rw [hm _ (embRT_mem p hz), toRT_embRT]
  field_simp [phaseP_ne_zero om mm (embRT z)]

