  · intro y hy
    apply ContDiffAt.contDiffWithinAt
    have hsq : ContDiffAt ℝ ∞ (fun y : Pt 4 => √(y 1 ^ 2 + y 2 ^ 2)) y :=
      ContDiffAt.sqrt (by fun_prop) (S2_pos hy).ne'
    have hin : ContDiffAt ℝ ∞ (fun y : Pt 4 => -(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) y :=
      ContDiffAt.div (by fun_prop) (hsq.sub (by fun_prop)) (rho2_sub_pos hy).ne'
    have hat : ContDiffAt ℝ ∞
        (Real.arctan ∘ fun y : Pt 4 => -(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) y :=
      ContDiffAt.comp y Real.contDiff_arctan.contDiffAt hin
    have h2 : ContDiffAt ℝ ∞
        (fun y : Pt 4 => π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1))) y :=
      contDiffAt_const.add (contDiffAt_const.mul hat)
