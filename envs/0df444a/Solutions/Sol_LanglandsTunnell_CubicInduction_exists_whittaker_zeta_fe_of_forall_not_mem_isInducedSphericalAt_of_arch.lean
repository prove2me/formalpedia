namespace NormUnramified
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open NumberField IsDedekindDomain IsDedekindDomain.HeightOneSpectrum NumberField.TateGlobal LanglandsTunnell.TateLocal
open LanglandsTunnell.RankinSelberg M4aHerbrand.GenuineDescent

section

variable {F : Type} [Field F] [NumberField F]

private theorem hasConductorExponentAt_zero_of_isUnramifiedCharAt {χ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {v : HeightOneSpectrum (𝓞 F)} (h : IsUnramifiedCharAt χ v) :
    HasConductorExponentAt F v (localChar χ v) 0 := by
  refine (hasConductorExponentAt_zero_iff F v).mpr fun u hu => h u ?_ ?_
  · exact (mem_adicCompletionIntegers _ _ _).mpr hu.le
  · exact (mem_adicCompletionIntegers _ _ _).mpr (by rw [Units.val_inv_eq_inv_val, map_inv₀, hu, inv_one])

private theorem isUnramifiedCharAt_of_hasConductorExponentAt_zero {χ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {v : HeightOneSpectrum (𝓞 F)} (h : HasConductorExponentAt F v (localChar χ v) 0) :
    IsUnramifiedCharAt χ v := by
  intro t ht ht'
  refine (hasConductorExponentAt_zero_iff F v).mp h t (le_antisymm ((mem_adicCompletionIntegers _ _ _).mp ht) ?_)
  have h1 : (Valued.v (t : v.adicCompletion F))⁻¹ ≤ 1 := by
    have := (mem_adicCompletionIntegers _ _ _).mp ht'
    rwa [Units.val_inv_eq_inv_val, map_inv₀] at this
  have h0 : Valued.v (t : v.adicCompletion F) ≠ 0 := (Valuation.ne_zero_iff _).mpr t.ne_zero
  exact (inv_le_one₀ (zero_lt_iff.mpr h0)).mp h1

private theorem localChar_one (v : HeightOneSpectrum (𝓞 F)) :
    localChar (1 : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ) v = 1 :=
  MonoidHom.one_comp _

private theorem one_mul_hom {M : Type} [MulOneClass M] (f : M →* ℂˣ) : (1 : M →* ℂˣ) * f = f :=
  MonoidHom.ext fun x => by rw [MonoidHom.mul_apply, MonoidHom.one_apply, one_mul]

end
