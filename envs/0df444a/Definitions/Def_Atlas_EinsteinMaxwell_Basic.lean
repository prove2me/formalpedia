import Mathlib
import Definitions.Def_Atlas_Core_Basic
/-! # Einstein–Maxwell residual in coordinates (ATLAS-IV-01)

B3 local definition layer (`mission/PHYSICS_BOUNDARY.md` §H, `Atlas/EinsteinMaxwell/CONVENTIONS.md`).
Pinned Mathlib has no Lorentzian Levi-Civita connection, Ricci tensor or Maxwell field; everything here
is built on the registered class-A objects `pd`, `christoffel`, `ricciOf` (`Atlas/Core/Basic.lean`),
unchanged.

Conventions: signature `(-,+,+,+)`; `christoffel g ginv a b c = Γ^a_{bc}`; `ricciOf` as in
`Atlas/Core/Basic.lean` (2-sphere has `R_θθ = 1`); `Λ = 0`, no charge current, field equations normalised
as `G_ab = 2 S_ab` (action `(16π)⁻¹ ∫ (R - F_ab F^ab) √(-g) d⁴x`). All index contractions are written
out as explicit `Fin` sums. Generic objects are stated for total dimension `n`; the Einstein–Maxwell
residual itself (coefficient `1/4`, coupling `2`) is stated for dimension `4` only. -/

namespace ExactVacuumAtlas.EinsteinMaxwell

/-- Components `F_{ab}(x)` of a covariant 2-tensor field (class B notation). Antisymmetry is not part
of the type; certificates carry it as a separate obligation. -/
abbrev TwoForm (n : ℕ) := Fin n → Fin n → Pt n → ℝ

/-- Components `A_a(x)` of a covector field, used for the electromagnetic potential (class B notation;
named `emPotential…` in instances, never `A`, to keep it apart from the Atlas III matrix `A`). -/
abbrev CoVec (n : ℕ) := Fin n → Pt n → ℝ

/-- Both indices raised: `F^{ab} = Σ_{c,d} g^{ac} g^{bd} F_{cd}` (two raisings, not one). -/
noncomputable def raise2 {n : ℕ} (ginv : Metric n) (F : TwoForm n) (a b : Fin n) (x : Pt n) : ℝ :=
  ∑ c : Fin n, ∑ d : Fin n, ginv a c x * ginv b d x * F c d x

/-- Field invariant `F_{ab} F^{ab} = Σ_{a,b} F_{ab} F^{ab}`. -/
noncomputable def fieldSq {n : ℕ} (ginv : Metric n) (F : TwoForm n) (x : Pt n) : ℝ :=
  ∑ a : Fin n, ∑ b : Fin n, F a b x * raise2 ginv F a b x

/-- Ricci scalar `R = Σ_{a,b} g^{ab} R_{ab}` with `R_{ab} = ricciOf g ginv a b`. -/
noncomputable def ricciScalar {n : ℕ} (g ginv : Metric n) (x : Pt n) : ℝ :=
  ∑ a : Fin n, ∑ b : Fin n, ginv a b x * ricciOf g ginv a b x

/-- Maxwell stress tensor (4D, without the `1/4π`):
`S_{ab} = Σ_{c,d} F_{ac} g^{cd} F_{bd} - (1/4) g_{ab} F_{cd} F^{cd}`. -/
noncomputable def emStress (g ginv : Metric 4) (F : TwoForm 4) (a b : Fin 4) (x : Pt 4) : ℝ :=
  (∑ c : Fin 4, ∑ d : Fin 4, F a c x * ginv c d x * F b d x) - g a b x * fieldSq ginv F x / 4

/-- Einstein–Maxwell residual (4D): `E_{ab} = R_{ab} - (1/2) g_{ab} R - 2 S_{ab}`. -/
noncomputable def einsteinMaxwell (g ginv : Metric 4) (F : TwoForm 4) (a b : Fin 4) (x : Pt 4) : ℝ :=
  ricciOf g ginv a b x - g a b x * ricciScalar g ginv x / 2 - 2 * emStress g ginv F a b x

/-- Maxwell divergence `J^b = ∇_a F^{ab}`, written with the registered Christoffel symbols:
`J^b = Σ_a (∂_a F^{ab} + Σ_k (Γ^a_{ak} F^{kb} + Γ^b_{ak} F^{ak}))`. -/
noncomputable def maxwellDiv {n : ℕ} (g ginv : Metric n) (F : TwoForm n) (b : Fin n) (x : Pt n) : ℝ :=
  ∑ a : Fin n, (pd a (raise2 ginv F a b) x +
    ∑ k : Fin n, (christoffel g ginv a a k x * raise2 ginv F k b x +
      christoffel g ginv b a k x * raise2 ginv F a k x))

/-- Cyclic sum `H_{abc} = ∂_a F_{bc} + ∂_b F_{ca} + ∂_c F_{ab}` (coordinate form of `dF`). -/
noncomputable def faradayCyclic {n : ℕ} (F : TwoForm n) (a b c : Fin n) (x : Pt n) : ℝ :=
  pd a (F b c) x + pd b (F c a) x + pd c (F a b) x

/-- Exterior derivative of a covector field in coordinates: `(dA)_{ab} = ∂_a A_b - ∂_b A_a`. -/
noncomputable def extD {n : ℕ} (A : CoVec n) (a b : Fin n) (x : Pt n) : ℝ :=
  pd a (A b) x - pd b (A a) x

end ExactVacuumAtlas.EinsteinMaxwell


