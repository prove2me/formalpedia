-- Source module: Solutions.R6ChkPack
/-!
# Packed bit-vector kernels for reflective certificate checking (round six)

Kernel-friendly primitives on `ℕ` (every operation is a single GMP-accelerated kernel step:
`Nat.land`, `Nat.xor`, `Nat.mul`, `Nat.shiftLeft`, `Nat.shiftRight`, ...), with their bit-level
specifications.

* `row X i`: the `i`-th 32-bit field of `X` (a list of `F₂` vectors packed with stride 32).
* `pkf s f k = Σ_{i<k} f i · 2^{s i}`, `testBit_pkf`: bits of packed sums.
* `fold32`: five xor-shifts; bit `p` of `fold32 x` is the parity of bits `p, …, p+31` of `x`.
* `dotsP A B`: **all 24 × 24 inner products over `F₂` in 16 big-number operations**: for
  `A, B < 2^768` (at most 24 rows each), bit `800 j + 32 i` of `dotsP A B` is the parity of
  `row A j &&& row B i` (`dotsP_spec`).
* `tgt o k`: the target pattern with ones exactly at `(j, o + j)`, `j < k` (`testBit_tgt`).

Definitions use the `Nat.*` functions directly (not the `HAnd`/`HMul` notation) because kernel
reduction through the notation instances is about four times slower.
-/

namespace R6Chk

/-! ## Notation bridges (all `rfl`) -/

theorem nxor (x y : ℕ) : Nat.xor x y = x ^^^ y := rfl

theorem nshl (x y : ℕ) : Nat.shiftLeft x y = x <<< y := rfl
theorem nmul (x y : ℕ) : Nat.mul x y = x * y := rfl
theorem nadd (x y : ℕ) : Nat.add x y = x + y := rfl
theorem nsub (x y : ℕ) : Nat.sub x y = x - y := rfl
theorem nmod (x y : ℕ) : Nat.mod x y = x % y := rfl
theorem ndiv (x y : ℕ) : Nat.div x y = x / y := rfl

/-! ## Packed sums -/

theorem pkf_succ (s : ℕ) (f : ℕ → ℕ) (k : ℕ) : pkf s f (k + 1) = pkf s f k + 2 ^ (s * k) * f k := rfl

theorem pkf_lt {s : ℕ} {f : ℕ → ℕ} : ∀ {k : ℕ}, (∀ i < k, f i < 2 ^ s) → pkf s f k < 2 ^ (s * k)
  | 0, _ => by simp [pkf]
  | k + 1, h => by
    rw [pkf_succ]
    have h1 := pkf_lt (k := k) (fun i hi => h i (by omega))
    have h2 : f k + 1 ≤ 2 ^ s := h k (by omega)
    calc pkf s f k + 2 ^ (s * k) * f k < 2 ^ (s * k) + 2 ^ (s * k) * f k := by omega
      _ = 2 ^ (s * k) * (f k + 1) := by ring
      _ ≤ 2 ^ (s * k) * 2 ^ s := Nat.mul_le_mul_left _ h2
      _ = 2 ^ (s * (k + 1)) := by rw [← pow_add]; ring_nf

theorem testBit_pkf {s : ℕ} {f : ℕ → ℕ} : ∀ {k : ℕ}, (∀ i < k, f i < 2 ^ s) →
    ∀ i j, j < s → (pkf s f k).testBit (s * i + j) = (decide (i < k) && (f i).testBit j)
  | 0, _, i, j, _ => by simp [pkf]
  | k + 1, h, i, j, hj => by
    rw [pkf_succ, add_comm, Nat.testBit_two_pow_mul_add _ (pkf_lt (fun i hi => h i (by omega)))]
    by_cases hik : i < k
    · have : s * i + j < s * k := by nlinarith
      rw [if_pos this, testBit_pkf (fun i hi => h i (by omega)) i j hj]
      simp [hik, show i < k + 1 by omega]
    · have : ¬ (s * i + j < s * k) := by nlinarith
      rw [if_neg this]
      by_cases hik' : i = k
      · subst hik'
        have : s * i + j - s * i = j := by omega
        simp [this]
      · have hgt : k < i := by omega
        have e : s * i + j - s * k = s * (i - k) + j := by
          rw [Nat.mul_sub]; have : s * k ≤ s * i := Nat.mul_le_mul_left _ hgt.le; omega
        rw [e, Nat.testBit_lt_two_pow]
        · simp [show ¬ i < k + 1 by omega]
        · calc f k < 2 ^ s := h k (by omega)
            _ ≤ 2 ^ (s * (i - k) + j) := Nat.pow_le_pow_right (by norm_num) (by
                have : 1 ≤ i - k := by omega
                nlinarith)

theorem testBit_pkf' {s : ℕ} {f : ℕ → ℕ} {k : ℕ} (hs : 0 < s) (h : ∀ i < k, f i < 2 ^ s) (p : ℕ) :
    (pkf s f k).testBit p = (decide (p / s < k) && (f (p / s)).testBit (p % s)) := by
  conv_lhs => rw [← Nat.div_add_mod p s]
  exact testBit_pkf h _ _ (Nat.mod_lt _ hs)

theorem pkf_congr {s : ℕ} {f g : ℕ → ℕ} : ∀ {k : ℕ}, (∀ i < k, f i = g i) → pkf s f k = pkf s g k
  | 0, _ => rfl
  | k + 1, h => by rw [pkf_succ, pkf_succ, pkf_congr (fun i hi => h i (by omega)), h k (by omega)]

theorem mul_pkf (s c : ℕ) (f : ℕ → ℕ) : ∀ k, c * pkf s f k = pkf s (fun i => c * f i) k
  | 0 => by simp [pkf]
  | k + 1 => by rw [pkf_succ, pkf_succ, ← mul_pkf s c f k]; ring

theorem pkf_add (s : ℕ) (f : ℕ → ℕ) (a : ℕ) : ∀ b,
    pkf s f (a + b) = pkf s f a + 2 ^ (s * a) * pkf s (fun t => f (a + t)) b
  | 0 => by simp [pkf]
  | b + 1 => by
    rw [← add_assoc, pkf_succ, pkf_add s f a b, pkf_succ]
    rw [show s * (a + b) = s * a + s * b by ring, pow_add]; ring

/-- Kronecker substitution: a stride-`s·m` packing times `Σ_{t<m} 2^{st}` replicates each field
`m` times at stride `s`. -/
theorem pkf_flat (s m : ℕ) (f : ℕ → ℕ) (hm : 0 < m) : ∀ k,
    pkf (s * m) f k * pkf s (fun _ => 1) m = pkf s (fun q => f (q / m)) (k * m)
  | 0 => by simp [pkf]
  | k + 1 => by
    rw [pkf_succ, add_mul, pkf_flat s m f hm k, Nat.succ_mul, pkf_add]
    congr 1
    rw [mul_assoc, mul_pkf, show s * m * k = s * (k * m) by ring]
    congr 1
    apply pkf_congr
    intro t ht
    rw [show (k * m + t) / m = k by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hm, Nat.div_eq_of_lt ht, zero_add]]
    ring

/-- The geometric series `Σ_{i<k} 2^{s i}` in closed form. -/
theorem pkf_one_mul (s : ℕ) : ∀ k, pkf s (fun _ => 1) k * (2 ^ s - 1) + 1 = 2 ^ (s * k)
  | 0 => by simp [pkf]
  | k + 1 => by
    have ih := pkf_one_mul s k
    have hs : 1 ≤ 2 ^ s := Nat.one_le_two_pow
    rw [pkf_succ, mul_one, add_mul, show s * (k + 1) = s * k + s by ring, pow_add]
    zify [hs] at ih ⊢
    linear_combination (2 ^ s : ℤ) * ih - ih + ih - (2 ^ s : ℤ) * ih + ih

theorem pkf_one_eq_div (s k : ℕ) (hs : 0 < s) :
    pkf s (fun _ => 1) k = (2 ^ (s * k) - 1) / (2 ^ s - 1) := by
  have h := pkf_one_mul s k
  have hpos : 0 < 2 ^ s - 1 := by
    have : 2 ≤ 2 ^ s := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ s := Nat.pow_le_pow_right (by norm_num) hs
    omega
  rw [← h, Nat.add_sub_cancel, Nat.mul_div_cancel _ hpos]

/-! ## Rows -/

theorem testBit_row (X i t : ℕ) : (row X i).testBit t = (decide (t < 32) && X.testBit (32 * i + t)) := by
  rw [row, Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]

theorem row_lt (X i : ℕ) : row X i < 2 ^ 32 := Nat.mod_lt _ (by norm_num)

/-- Rows of a concatenation `X ++ Y` (with `X` of `a` rows). -/
theorem row_append {X Y a : ℕ} (hX : X < 2 ^ (32 * a)) (i : ℕ) :
    row (X + (Y <<< (32 * a))) i = if i < a then row X i else row Y (i - a) := by
  apply Nat.eq_of_testBit_eq; intro t
  rw [Nat.shiftLeft_eq, add_comm, mul_comm, testBit_row, Nat.testBit_two_pow_mul_add _ hX]
  by_cases h2 : i < a
  · rw [if_pos h2, testBit_row]
    by_cases ht : t < 32
    · rw [if_pos (by omega)]
    · simp [ht]
  · rw [if_neg h2, testBit_row, if_neg (by omega)]
    by_cases ht : t < 32
    · simp only [ht, decide_true, Bool.true_and]
      congr 1; rw [Nat.mul_sub]; omega
    · simp [ht]

theorem append_lt {X Y a b : ℕ} (hX : X < 2 ^ (32 * a)) (hY : Y < 2 ^ (32 * b)) :
    X + (Y <<< (32 * a)) < 2 ^ (32 * (a + b)) := by
  rw [Nat.shiftLeft_eq, show 32 * (a + b) = 32 * a + 32 * b by ring, pow_add]
  have : Y + 1 ≤ 2 ^ (32 * b) := hY
  calc X + Y * 2 ^ (32 * a) < 2 ^ (32 * a) + Y * 2 ^ (32 * a) := by omega
    _ = 2 ^ (32 * a) * (Y + 1) := by ring
    _ ≤ 2 ^ (32 * a) * 2 ^ (32 * b) := Nat.mul_le_mul_left _ this

/-! ## Parity and the xor-shift fold -/

theorem parB_add (f : ℕ → Bool) (a : ℕ) : ∀ b,
    parB f (a + b) = xor (parB f a) (parB (fun t => f (a + t)) b)
  | 0 => by simp [parB]
  | b + 1 => by rw [← add_assoc, parB, parB_add f a b, parB, Bool.xor_assoc]

theorem parB_congr {f g : ℕ → Bool} : ∀ {k}, (∀ t < k, f t = g t) → parB f k = parB g k
  | 0, _ => rfl
  | k + 1, h => by rw [parB, parB, parB_congr (fun t ht => h t (by omega)), h k (by omega)]

theorem parB_false : ∀ k, parB (fun _ => false) k = false
  | 0 => rfl
  | k + 1 => by rw [parB, parB_false k]; rfl

theorem xs_step {x y m : ℕ} (hy : ∀ p, y.testBit p = parB (fun t => x.testBit (p + t)) m) :
    ∀ p, (xs y m).testBit p = parB (fun t => x.testBit (p + t)) (m + m) := by
  intro p
  rw [xs, nxor, nshr, Nat.testBit_xor, Nat.testBit_shiftRight, hy, hy, parB_add]
  congr 1
  apply parB_congr; intro t _; congr 1; omega

theorem testBit_fold32 (x p : ℕ) : (fold32 x).testBit p = parB (fun t => x.testBit (p + t)) 32 := by
  have h0 : ∀ p, x.testBit p = parB (fun t => x.testBit (p + t)) 1 := by intro p; simp [parB]
  exact xs_step (xs_step (xs_step (xs_step (xs_step h0)))) p

/-! ## All inner products of two 24-row lists -/

theorem testBit_AR1 {A : ℕ} (hA : A < 2 ^ 768) (p : ℕ) :
    (A * R1).testBit p = (decide (p / 768 < 24) && A.testBit (p % 768)) := by
  rw [R1, mul_pkf, testBit_pkf' (by norm_num) (fun i _ => by rw [mul_one]; exact hA), mul_one]

theorem testBit_M1 (p : ℕ) : M1.testBit p = (decide (p / 800 < 24) && decide (p % 800 < 32)) := by
  rw [M1, testBit_pkf' (by norm_num) (fun i _ => lt_of_lt_of_le (by norm_num : 2 ^ 32 - 1 < 2 ^ 32)
    (Nat.pow_le_pow_right (by norm_num) (by norm_num))), Nat.testBit_two_pow_sub_one]

theorem asp_eq {A : ℕ} (hA : A < 2 ^ 768) :
    (A * R1) &&& M1 = pkf 800 (fun j => row A j) 24 := by
  apply Nat.eq_of_testBit_eq; intro p
  rw [Nat.testBit_and, testBit_AR1 hA, testBit_M1, testBit_pkf' (by norm_num)
    (fun i _ => lt_of_lt_of_le (row_lt A i) (Nat.pow_le_pow_right (by norm_num) (by norm_num))),
    testBit_row]
  by_cases hq : p / 800 < 24
  · by_cases hr32 : p % 800 < 32
    · have e1 : p / 768 = p / 800 := by omega
      have e2 : p % 768 = 32 * (p / 800) + p % 800 := by omega
      simp [hq, hr32, e1, e2]
    · simp [hr32]
  · simp [hq]

theorem arep_eq {A : ℕ} (hA : A < 2 ^ 768) :
    ((A * R1) &&& M1) * R2 = pkf 32 (fun q => row A (q / 25)) (24 * 25) := by
  rw [asp_eq hA, R2, show (800 : ℕ) = 32 * 25 by norm_num]
  exact pkf_flat 32 25 _ (by norm_num) 24

theorem testBit_arep {A : ℕ} (hA : A < 2 ^ 768) {j i t : ℕ} (hj : j < 24) (hi : i < 25) (ht : t < 32) :
    (((A * R1) &&& M1) * R2).testBit (800 * j + 32 * i + t) = (row A j).testBit t := by
  rw [arep_eq hA, show 800 * j + 32 * i + t = 32 * (25 * j + i) + t by ring,
    testBit_pkf (fun q _ => row_lt A _) _ _ ht]
  have : (25 * j + i) / 25 = j := by omega
  simp [this, show 25 * j + i < 24 * 25 by omega]

theorem testBit_btile {B : ℕ} (hB : B < 2 ^ 768) {j i t : ℕ} (hj : j < 24) (hi : i < 25) (ht : t < 32) :
    (B * R3).testBit (800 * j + 32 * i + t) = (row B i).testBit t := by
  rw [R3, mul_pkf, mul_one, show 800 * j + 32 * i + t = 800 * j + (32 * i + t) by ring,
    testBit_pkf (fun _ _ => lt_of_lt_of_le hB (Nat.pow_le_pow_right (by norm_num) (by norm_num)))
      _ _ (by omega), testBit_row]
  simp [hj, ht]

theorem testBit_LOW {j i : ℕ} (hj : j < 24) (hi : i < 24) : LOW.testBit (800 * j + 32 * i) = true := by
  rw [LOW, testBit_pkf (fun _ _ => lt_of_lt_of_le (pkf_lt (fun _ _ => by norm_num))
    (Nat.pow_le_pow_right (by norm_num) (by norm_num))) _ _ (by omega)]
  rw [show 32 * i = 32 * i + 0 by ring, testBit_pkf (fun _ _ => by norm_num) _ _ (by norm_num)]
  simp [hj, hi]

theorem dotsP_spec {A B : ℕ} (hA : A < 2 ^ 768) (hB : B < 2 ^ 768) {j i : ℕ} (hj : j < 24) (hi : i < 24) :
    (dotsP A B).testBit (800 * j + 32 * i) =
      parB (fun t => (row A j &&& row B i).testBit t) 32 := by
  rw [dotsP, dotsK, nland, Nat.testBit_and, testBit_LOW hj hi, Bool.and_true, testBit_fold32]
  apply parB_congr; intro t ht
  rw [nland, nmul, nland, nmul, nmul, Nat.testBit_and, Nat.testBit_and]
  rw [testBit_arep hA hj (by omega) ht, testBit_btile hB hj (by omega) ht]

/-! ## Target patterns -/

theorem testBit_one' (r : ℕ) : (1 : ℕ).testBit r = decide (r = 0) := by
  cases r with
  | zero => rfl
  | succ r =>
    rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le (by norm_num : 1 < 2 ^ 1)
      (Nat.pow_le_pow_right (by norm_num) (by omega)))]
    simp

theorem tgt_eq (o k : ℕ) : tgt o k = pkf 832 (fun _ => 1) k <<< (32 * o) := by
  rw [tgt, nshl, ndiv, nsub, nshl, nmul, nmul, Nat.one_shiftLeft, C832,
    pkf_one_eq_div 832 k (by norm_num)]

theorem testBit_tgt {o k j i : ℕ} (hok : o + k ≤ 24) (hj : j < 24) (hi : i < 24) :
    (tgt o k).testBit (800 * j + 32 * i) = decide (j < k ∧ i = o + j) := by
  rw [tgt_eq, Nat.testBit_shiftLeft]
  by_cases hp : 32 * o ≤ 800 * j + 32 * i
  · have hq := Nat.div_add_mod (800 * j + 32 * i - 32 * o) 832
    rw [← hq, testBit_pkf (fun _ _ => by norm_num) _ _ (Nat.mod_lt _ (by norm_num)),
      testBit_one']
    simp only [ge_iff_le, hp, decide_true, Bool.true_and]
    set q := (800 * j + 32 * i - 32 * o) / 832
    set r := (800 * j + 32 * i - 32 * o) % 832
    have hr : r < 832 := Nat.mod_lt _ (by norm_num)
    by_cases h : j < k ∧ i = o + j
    · have hq' : q = j := by omega
      have hr' : r = 0 := by omega
      simp [h, hq', hr']
    · simp only [h, decide_false, Bool.and_eq_false_iff, decide_eq_false_iff_not]
      by_cases hr0 : r = 0
      · left; omega
      · right; exact hr0
  · simp only [ge_iff_le, hp, decide_false, Bool.false_and]
    symm; simp only [decide_eq_false_iff_not, not_and]
    intro _ hio; omega

/-! ## Range check: fields below `2^n` -/

theorem row_lt_of_bad {n X i : ℕ} (hn : n ≤ 32) (h : X &&& BADf n = 0) (hi : i < 48) :
    row X i < 2 ^ n := by
  apply Nat.lt_pow_two_of_testBit
  intro t ht
  rw [testBit_row]
  by_cases ht32 : t < 32
  · have hb : (BADf n).testBit (32 * i + t) = true := by
      rw [BADf, testBit_pkf (fun _ _ => ?_) _ _ ht32]
      · rw [Nat.testBit_mul_two_pow, Nat.testBit_two_pow_sub_one]
        simp [hi]; omega
      · calc (2 ^ (32 - n) - 1) * 2 ^ n < 2 ^ (32 - n) * 2 ^ n := by
              apply Nat.mul_lt_mul_of_pos_right (by have := Nat.one_le_two_pow (n := 32 - n); omega)
                (by positivity)
          _ = 2 ^ 32 := by rw [← pow_add]; congr 1; omega
    have := congrArg (fun z => z.testBit (32 * i + t)) h
    simp only [Nat.testBit_and, hb, Bool.and_true, Nat.zero_testBit] at this
    simp [this]
  · simp [ht32]

end R6Chk

