      _ ≤ k * 2 ^ N + 2 ^ N := by
        rw [abs_mul, abs_pow, hσ, one_pow, one_mul]; exact add_le_add ih hq
      _ = ((k + 1 : ℕ) : ℤ) * 2 ^ N := by push_cast; ring

