  have hfC : axfC6 P n < lam := by rw [hlamC]; exact Nat.lt_two_pow_self
  have hTC : (tabsT (axTC6 P n src k ap) nc).length ≤ 19 * T := by
    have h1 := tabsT_len (axTC6 P n src k ap) (cLc P n) nc (fun q _ => hLen q)
