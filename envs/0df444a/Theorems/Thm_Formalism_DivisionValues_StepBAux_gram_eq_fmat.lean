variable {K : Type} [Field K] [NumberField K] [StarRing K]

theorem Formalism.DivisionValues.StepBAux.gram_eq_fmat {d m : ℕ} (X : InfinitePlace K → Matrix (Fin d) (Fin d) ℂ)
    (v : InfinitePlace K) (e : Fin m → Fin d → K) :
    gram X v e = (fmat v.embedding e)ᴴ * met X v * fmat v.embedding e := by sorry
