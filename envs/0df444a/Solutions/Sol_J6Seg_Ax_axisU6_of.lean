theorem axisBody6_of_steps {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
    {st1 st2 stc st3 st4 st5 st6 sts st7 : IStmt HS Pp} {eX : Fin Pp} {dA : Fin HS}
    {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {C : ℝ}
    (hX : tbl eX = axProg st1 st2 stc st3 st4 st5 st6 sts st7) (hA0 : dA ≠ 0) (hZA : sZ ≠ dA)
    (hst : ∀ k ≤ D, AxStepsAt Isym tbl st1 st2 stc st3 st4 st5 st6 sts st7 dA P n src D k C) :
    AxisBody6 P n src D Isym tbl eX dA (C + 2) := by
  intro k hk s F L l hF hd h0 hlen hgb
  obtain ⟨P1, P2, P3, P4, P5, P6, Pc, Ps, P7, C1, C2, Cc, C3, C4, C5, C6, Cs, C7,
    h1, h2, hc, h3, h4, h5, h6, hs, h7, hpre, hC⟩ := hst k hk
  obtain ⟨p1, p2, pc, p3, p4, p5, p6, ps, p7⟩ := hpre L hlen hgb
  obtain ⟨c, r, kc⟩ := axis_chain (g7 := gO6 P n src D k) h1 h2 hc h3 h4 h5 h6 hs h7
    (by decide) hZA hA0 s F L l hF hd h0 p1 p2 pc p3 p4 p5 p6 ps p7
  refine ⟨c + 2, ?_, ?_⟩
  · have e : gO6 P n src D k (gY6 P n src D k (arrS6 P n src D k L))
        (gY6 P n src D k (gWp6 P n src D k (gW6 P n src D k (gJ6 P n src D k
          (gY6 P n src D k (arrS6 P n src D k L)))))) = pipe6 P n src D k L := by
      rw [pipe6_eq P n src D k hk]; rfl
    rw [e] at r
    exact IRuns.call (by rw [hX]; exact r)
  · push_cast; linarith

