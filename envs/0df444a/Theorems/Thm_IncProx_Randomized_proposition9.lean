-- title:
--   Proposition 9 — randomized order, $\alpha_k\to0$, $\sum\alpha_k=\infty$: a.s. $\liminf F(x_k)=F^*$; with $X^*\neq\emptyset$, $\sum\alpha_k^2<\infty$: a.s. $x_k\to x^*\in X^*$
-- statement:
--   Consider the problem
--   $$\text{minimize } F(x)=\sum_{i=1}^m\bigl(f_i(x)+h_i(x)\bigr)\quad\text{subject to } x\in X,$$
--   where $X\subseteq\mathbb R^n$ is nonempty, closed and convex and $f_i,h_i:\mathbb R^n\to\mathbb R$ are convex, with optimal value $F^*=\inf_{x\in X}F(x)\in[-\infty,\infty)$ and optimal set $X^*$. Let $\{x_k\}$ be generated by one of the randomized incremental subgradient-proximal methods (42)–(44): at iteration $k$ a component $\omega_k$ is drawn uniformly from $\{1,\dots,m\}$, independently of the past history $\mathcal F_k=\{x_k,z_{k-1},\dots,z_0,x_0\}$, and a proximal step on $f_{\omega_k}$ and a projected subgradient step on $h_{\omega_k}$ are taken with stepsize $\alpha_k>0$. Assume Assumption 3(b) (for (42), (43)) or Assumption 4(b) (for (44)) with constant $c$, and let the stepsize satisfy
--   $$\lim_{k\to\infty}\alpha_k=0,\qquad\sum_{k=0}^\infty\alpha_k=\infty.$$
--   Then:
--   1. with probability 1,
--   $$\liminf_{k\to\infty}F(x_k)=F^*;$$
--   2. if furthermore $X^*$ is nonempty and $\sum_{k=0}^\infty\alpha_k^2<\infty$, then with probability 1 the sequence $\{x_k\}$ converges to some $x^*\in X^*$.
--
--   The limit $x^*$ in part 2 may depend on the sample path. This is the exact-convergence result for the randomized order, the counterpart of Proposition 6 for the cyclic order.
--
--   **Formalization Note** $F^*$ and the $\liminf$ are taken in the extended reals (`EReal`), so part 1 includes the case $F^*=-\infty$. $\sum\alpha_k=\infty$ is stated as divergence of the partial sums to $+\infty$. Part 2 is "almost surely, there exists $x^*\in X^*$ with $x_k\to x^*$". The paper's phrase "independent of the past history" is formalized as independence of $\sigma(\omega_k)$ from the $\sigma$-algebra generated by $x_0,\dots,x_k,z_0,\dots,z_{k-1}$, together with the hypotheses that make it meaningful: the iterates are measurable, the step iteration $k$ would take for each component is measurable with respect to that $\sigma$-algebra, and $x_0$ is a fixed vector. The bounds (45)–(48) are required for every component $i$, not only the sampled one, as in the paper. $\mathbb R^n$ is `EuclideanSpace ℝ (Fin n)`, components are indexed $0,\dots,m-1$, and $m\ge1$.
-- source:
--   Bertsekas, Incremental Proximal Methods for Large Scale Convex Optimization, LIDS-P-2847 (rev. March 2011), p. 20, Proposition 9

import Mathlib
import Definitions.Def_IncProx_Randomized_Basic

namespace IncProx.Randomized

open Filter Topology MeasureTheory

/-- Proposition 9 (p. 20): for the randomized methods (42)–(44) with α_k → 0 and Σ α_k = ∞, with
probability 1, liminf_k F(x_k) = F*. If moreover X* is nonempty and Σ α_k² < ∞, then with
probability 1 the sequence x_k converges to some x* ∈ X* (which may depend on the sample path). -/
theorem proposition9 {Ω : Type*} [MeasurableSpace Ω] {n m : ℕ} [NeZero m]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (P : Problem n m) (hP : P.Standing) (A : Alg)
    (α : ℕ → ℝ) (hαpos : ∀ k, 0 < α k) (ω : ℕ → Ω → Fin m) (x : ℕ → Ω → Vec n)
    (zc gFc gHc xc : ℕ → Fin m → Ω → Vec n) (x₀ : Vec n) (c : ℝ)
    (hR : RandHyp μ P A α ω x zc gFc gHc xc x₀ c)
    (hα0 : Tendsto α atTop (𝓝 0))
    (hαsum : Tendsto (fun N => ∑ k ∈ Finset.range N, α k) atTop atTop) :
    (∀ᵐ s ∂μ, liminf (fun k => ((P.F (x k s) : ℝ) : EReal)) atTop = P.Fstar) ∧
      (P.Xstar.Nonempty → Summable (fun k => α k ^ 2) →
        ∀ᵐ s ∂μ, ∃ xs ∈ P.Xstar, Tendsto (fun k => x k s) atTop (𝓝 xs)) := by sorry

end IncProx.Randomized
