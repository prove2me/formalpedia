section
-- Source module: Solutions.R6ILGen
/-!
# Round six, item language: the general procedure and its correctness

`genP C q` (entry `genE`, level branch `genL C`, tail `genTail q`) is run by `tabG C q ad 0` when
the descriptor register `dJ` holds `-1` (generic mode, descriptor `DescG`). `gen_correct`: by strong
induction on the width `e`, `tabG C q ad 0` computes `progH C q e` at cost `costN C q Bb e V`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

/-- The general procedure. -/
def genP (C : Bit.QHNet (ZMod 2) W T m) (q : ℕ) : IStmt HS 1 :=
  .seq (genE m q W T).code (.seq (genL C) (genTail q))

/-- The procedure table: generic mode (`dJ < 0`) runs `genP`, otherwise the adapter `ad`. -/
def tabG (C : Bit.QHNet (ZMod 2) W T m) (q : ℕ) (ad : IStmt HS 1) : Fin 1 → IStmt HS 1 :=
  fun _ => .ite dJ (fun c => c == .neg) (genP C q) ad

/-- Cost of the general procedure at width `e` on volume `V`. -/
def costN (C : Bit.QHNet (ZMod 2) W T m) (q Bb : ℕ) (e V : ℕ) : ℕ :=
  cGenE m q W T e Bb + (cGenL C e (V / W) Bb (fun ρ => if h : ρ.2.2 * (e / m) < e then
      costN C q Bb (ρ.2.2 * (e / m)) (V / W) else 0) + cTail q V Bb (e % m)) + 25
termination_by e

/-- The specification of the general procedure at width `e`. -/
def GenSpec (C : Bit.QHNet (ZMod 2) W T m) (q : ℕ) (ad : IStmt HS 1) (M Bb e : ℕ) : Prop :=
  ∀ (P L : ℕ) (A B Cs : Shape), 1 ≤ P → 1 ≤ L → (∀ x ∈ A, 1 ≤ x) → (∀ x ∈ B, 1 ≤ x) →
    (∀ x ∈ Cs, 1 ≤ x) → W ^ Bit.depH m e ∣ L →
    (m + q + T + W + 16) * (vol (P :: L :: hdShape A B Cs e q) + 1) ≤ M →
    ∀ (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
      DescG t e P L (vol A) (vol B) (vol Cs) →
      xs.length = vol (P :: L :: hdShape A B Cs e q) →
      IRuns I (tabG C q ad) (tabG C q ad 0) (t.upd 0 (ints (enc2 xs) ++ R))
        (t.upd 0 (ints (enc2 (Bit.progH C q e P L A B Cs xs)) ++ R))
        (costN C q Bb e (vol (P :: L :: hdShape A B Cs e q)))

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILCost
/-!
# Round six, item language: the cost of the general procedure, node bounds

`costN_le_big` / `costN_le_small`: one node of the call tree costs at most
`cq q (r + 1) V + Kv C ⌊V / W⌋ + Σ (children) + KA C q (e + 1) (Bb + 2)²` (`r = e mod m`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

/-- The coefficient of one counted loop. -/
def crK (n : NE) (L : List (Fin HS × NE)) : ℕ := (n.size + 1) * 2000 + szA L * 10 ^ 7 + 8062

variable {W T m : ℕ} [NeZero W]

/-- The entry coefficient. -/
def KE (m q W T : ℕ) : ℕ :=
  52001 + szA (entA1 m) * 10 ^ 7 + crK (.reg gF) (mulL sQQ q) + crK (.reg gR) (mulL gQR q) +
    crK (.lit m) (mulR kG sQQ) * (m + 1) + szA (entA2 W T) * 10 ^ 7

/-- The linear swap coefficient. -/
def cq (q : ℕ) : ℕ := (4 * q + 136) * 276

/-- The tail coefficient. -/
def KT (q : ℕ) : ℕ := szA (tailA q) * 10 ^ 7 + 10 ^ 9 + 10 ^ 4 + 30

/-- The constant of the child-call wrappers. -/
def KR (C : Bit.QHNet (ZMod 2) W T m) : ℕ :=
  ((runsL C).map fun ρ => pushSz (chR m ρ) * 10 ^ 7 + 30).sum

/-- The linear level coefficient. -/
def Kv (C : Bit.QHNet (ZMod 2) W T m) : ℕ := KL C * 10 ^ 14 * (T + W)

/-- The node constant. -/
def KA (C : Bit.QHNet (ZMod 2) W T m) (q : ℕ) : ℕ :=
  KE m q W T + KT q + KR C + KL C * (10 ^ 14 + 10 ^ 11) + 10 ^ 4

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILCostR
/-!
# Round six, item language: the cost of the general procedure against `costH`

`costN_real`: `costN e V ≤ (2 cq + Kv) · V · cH e + KA · ovN e · (Bb + 2)²` for `e ≥ 1`, where
`ovN` counts `(e + 1)` per node of the call tree; `ovN_le`: `ovN e ≤ (e + 1) (S + 1) ^ depH e`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

/-- The overhead weight of the call tree at width `e`. -/
def ovN (C : Bit.QHNet (ZMod 2) W T m) (e : ℕ) : ℕ :=
  (e + 1) + (if m ≤ e then ((runsL C).map fun ρ => if h : ρ.2.2 * (e / m) < e then
    ovN C (ρ.2.2 * (e / m)) else 0).sum else 0)
termination_by e

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILAd
/-!
# Round six, item language: the adapter from the KIL5 descriptor to the generic one

`adS m`: with `k` on top of `dJ`, compute `m ^ k` (loop on a scratch register), push it on `dT`,
push `-1` on `dJ`, call procedure `0`, pop `dJ` and `dT`. `ad_runs`: the adapter runs the call on
the state with the generic descriptor and restores every stack.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-- The adapter, before the call. -/
def adPre (m : ℕ) : RS :=
  .seq (pushZs [gTV]) (.seq (asgL [(gTV, .lit 1)])
    (.seq (.rep gC (NE.reg dJ).toEx (asgL (mulL gTV m)))
    (.seq (.push dT (.reg gTV)) (.seq (popDs [gTV]) (.push dJ (.lit (-1)))))))

/-- The adapter, after the call. -/
def adPost : RS := .seq (.pop dJ) (.pop dT)

/-- The adapter. -/
def adS (m : ℕ) : IStmt HS 1 := .seq (adPre m).code (.seq (.call 0) adPost.code)

/-- Cost of the adapter around a call of cost `c0`. -/
def cAd (m k Bb c0 : ℕ) : ℕ :=
  (([gTV].length * 4000 * (Bb + 2) + 1) + (szA [(gTV, NE.lit 1)] * 10 ^ 7 * (Bb + 2) ^ 2 +
    (cRep (.reg dJ) k (mulL gTV m) Bb + (((Ex.reg (S := HS) gTV).size + 1) * 2000 * (Bb + 2) +
    (([gTV].length * (2 * Bb + 2) + 1) + ((Ex.lit (S := HS) (-1)).size + 1) * 2000 * (Bb + 2)))))) +
  ((c0 + 2) + ((2 * Bb + 2) + (2 * Bb + 2)))

end

end IntMul.Kappa.R6.IL

end

