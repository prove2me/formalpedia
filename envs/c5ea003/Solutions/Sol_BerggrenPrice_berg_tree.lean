/-!
# Berggren–Price interlock, Part II: the two trees over one vertex set

In Euclid parameters `(m,n)` the Barning–Hall–**Berggren** tree is generated by

  `bA (m,n) = (2m - n, m)`,  `bB (m,n) = (2m + n, m)`,  `bC (m,n) = (m + 2n, n)`,

with `2×2` determinants `+1, -1, +1`, while **Price**'s tree is generated by

  `pA (m,n) = (2m, m - n)`,  `pB (m,n) = (2m, m + n)`,  `pC (m,n) = (m + n, 2n)`,

with determinants `-2, +2, +2`.  Both are ternary trees on the *same* vertex set
`IsNode` with the *same* root `(2,1)`: this is the "interlock".

## Main results

* `isNode_berg`, `isNode_price` — the six generators preserve valid Euclid parameters
  (the delicate point for Price is that determinant `±2` still preserves coprimality,
  because opposite parity forces the gcd to be odd).
* `berg_parent`, `price_parent` — the two descent (parent) rules: Berggren compares
  `m` with `2n` and `3n` (continued-fraction style), Price halves `m` or `n`
  (binary-GCD style).
* `berg_tree`, `price_tree` — every node is reached from `(2,1)` by a **unique** word
  in each tree.
-/

open BerggrenPrice

/-! ### The six generators -/





/-! ### The generators preserve nodes -/

theorem isNode_bA {v : Node} (h : IsNode v) : IsNode (bA v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bA]; omega, by simp [bA]; omega, ⟨-y, x + 2 * y, by simp [bA]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bA]
  omega

theorem isNode_bB {v : Node} (h : IsNode v) : IsNode (bB v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bB]; omega, by simp [bB]; omega, ⟨y, x - 2 * y, by simp [bB]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bB]
  omega

theorem isNode_bC {v : Node} (h : IsNode v) : IsNode (bC v) := by
  obtain ⟨h1, h2, ⟨x, y, hxy⟩, ho⟩ := h
  refine ⟨by simp [bC]; omega, by simp [bC]; omega, ⟨x, y - 2 * x, by simp [bC]; linear_combination hxy⟩, ?_⟩
  rw [Int.odd_iff] at ho ⊢
  simp only [bC]
  omega




theorem isNode_berg (i : Fin 3) (v : Node) (h : IsNode v) : IsNode (berg i v) := by
  fin_cases i
  · exact isNode_bA h
  · exact isNode_bB h
  · exact isNode_bC h


/-! ### The size `m + n` strictly increases -/

theorem size_berg (i : Fin 3) (v : Node) (h : IsNode v) : size v < size (berg i v) := by
  obtain ⟨h1, h2, -, -⟩ := h
  fin_cases i <;> simp [size, berg, bA, bB, bC] <;> omega


/-! ### Injectivity and disjointness of the three subtrees -/

theorem inj_berg (i : Fin 3) (u v : Node) (h : berg i u = berg i v) : u = v := by
  fin_cases i <;>
    · simp only [berg, bA, bB, bC, Prod.ext_iff] at h ⊢
      omega


theorem disj_berg (i j : Fin 3) (u v : Node) (hu : IsNode u) (hv : IsNode v)
    (h : berg i u = berg j v) : i = j := by
  obtain ⟨hu1, hu2, -, -⟩ := hu
  obtain ⟨hv1, hv2, -, -⟩ := hv
  fin_cases i <;> fin_cases j <;>
    · simp only [berg, bA, bB, bC, Prod.ext_iff] at h
      first
        | rfl
        | (exfalso; omega)


/-! ### The two descent (parent) rules -/



/-! ### The two tree theorems -/




open BerggrenPrice in
theorem solution(v : Node) (hv : IsNode v) :
    ∃! w : List (Fin 3), applyWord berg w root = v :=
  exists_unique_word berg isNode_berg size_berg berg_parent inj_berg disj_berg v hv
