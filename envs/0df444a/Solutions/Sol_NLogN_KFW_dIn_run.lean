theorem moveCost_mono {a b : ℕ} (h : a ≤ b) : moveCost a ≤ moveCost b := by
  unfold moveCost; omega

theorem SExt.upd {σ0 σ : Fin HS → Option ℤ} (hs : SExt σ0 σ) {i : Fin HS} (hi : σ0 i = none)
    (v : ℤ) : SExt σ0 (Function.update σ i (some v)) := by
  intro x u hx
  have : x ≠ i := by rintro rfl; rw [hi] at hx; exact absurd hx (by simp)
  rw [Function.update_of_ne this]; exact hs x u hx

