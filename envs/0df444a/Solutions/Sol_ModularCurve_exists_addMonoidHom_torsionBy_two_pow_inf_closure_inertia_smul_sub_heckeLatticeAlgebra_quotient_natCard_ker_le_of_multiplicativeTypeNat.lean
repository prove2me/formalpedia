  have hDisp : ∀ (t : HeckeAlg), ∀ y ∈ (AddSubgroup.closure
            {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
              ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}), t • y ∈ (AddSubgroup.closure
            {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
              ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) := by
    intro t y hy
    refine AddSubgroup.closure_induction (fun y hy => ?_) ?_ (fun a b _ _ ha hb => ?_)
      (fun a _ ha => ?_) hy
    · obtain ⟨σ, hσ, M, x, hx, rfl⟩ := hy
      have hx' : x ∈ Submodule.torsionBySet HeckeAlg (JZero p)
