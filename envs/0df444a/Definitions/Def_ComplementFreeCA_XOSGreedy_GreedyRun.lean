-- title:
--   The greedy price-update algorithm for XOS bidders (§3.3)
-- statement:
--   The combinatorial 2-approximation algorithm of §3.3 for XOS bidders, run with a demand oracle $\mathrm{dem}$ and an XOS oracle $\mathrm{cl}$:
--
--   1. Initialize $S_1=\dots=S_n=\emptyset$ and $p_1=\dots=p_m=0$.
--   2. For each bidder $i=1,\dots,n$:
--      (a) let $S_i$ be the demand of bidder $i$ at the current prices $p$, i.e. $S_i=\mathrm{dem}(i,p)$;
--      (b) for every $i'<i$, remove the items of $S_i$ from $S_{i'}$: $S_{i'}\leftarrow S_{i'}\setminus S_i$;
--      (c) let $q^i=\mathrm{cl}(i,S_i)$ be the maximizing clause for $S_i$ in $v_i$;
--      (d) for every $j\in S_i$ set $p_j=q^i_j$.
--
--   The *state after stage $k$* consists of the bundles and the price vector $p^k$ after bidders $1,\dots,k$ have been processed, with $p^0=0$. The allocation generated by the algorithm is $A_1,\dots,A_n$, the bundles after stage $n$.
--
--   Prices of items that are not in the current demand are never changed, and an item removed from an earlier bundle in step (b) is always in the new bundle $S_i$ and receives a new price in step (d).
--
--   **Formalization Note** The run is defined by recursion on the stage `k : ℕ`: stage `k + 1` processes the bidder `⟨k, _⟩ : Fin n` (the paper's bidder $k+1$), so the prices after stage `k` are the paper's $p^k$. For `k ≥ n` the state no longer changes. The oracles enter as functions `dem : Fin n → (Fin m → ℝ) → Finset (Fin m)` and `cl : Fin n → Finset (Fin m) → (Fin m → ℝ)`; the definition itself does not require them to meet their specifications — the theorems assume that.
-- source:
--   Dobzinski, Nisan, Schapira, Approximation Algorithms for Combinatorial Auctions with Complement-Free Bidders, Math. Oper. Res. 35(1), 2010, p. 8, §3.3, algorithm steps (i)–(ii)(d); stage prices p^i from the proof of Theorem 3.3

import Mathlib
import Definitions.Def_ComplementFreeCA_XOSGreedy_Model

namespace ComplementFreeCA.XOSGreedy

/-- The state of the greedy algorithm between stages: the current bundles `S_1, …, S_n`
and the current item prices `p_1, …, p_m`. -/
structure GreedyState (n m : ℕ) where
  /-- The current bundle of each bidder. -/
  bundles : Fin n → Finset (Fin m)
  /-- The current price of each item. -/
  prices : Fin m → ℝ

/-- One stage of the algorithm (§3.3, step (ii)), processing bidder `k`:
(a) `D` is the demand of bidder `k` at the current prices; (b) the items of `D` are taken away
from every earlier bidder `i' < k`; bidder `k` receives `D`; (c)–(d) every item `j ∈ D` gets the
price `q^k_j`, its value in the maximizing clause `cl k D` for `D` in `v_k`. Prices of the other
items are unchanged. -/
noncomputable def greedyStep {n m : ℕ} (dem : Fin n → (Fin m → ℝ) → Finset (Fin m))
    (cl : Fin n → Finset (Fin m) → (Fin m → ℝ)) (k : Fin n) (s : GreedyState n m) :
    GreedyState n m :=
  let D := dem k s.prices
  { bundles := fun i => if i = k then D else if i < k then s.bundles i \ D else s.bundles i
    prices := fun j => if j ∈ D then cl k D j else s.prices j }

/-- The state of the algorithm after stage `k` (the paper's stage `k`, 1-based): stage `0` is
the initialization (i) (all bundles empty, all prices `0`), and stage `k + 1` processes the
bidder `⟨k, _⟩` (0-based) for `k < n`. After stage `n` the state no longer changes. -/
noncomputable def greedyState {n m : ℕ} (dem : Fin n → (Fin m → ℝ) → Finset (Fin m))
    (cl : Fin n → Finset (Fin m) → (Fin m → ℝ)) : ℕ → GreedyState n m
  | 0 => { bundles := fun _ => ∅, prices := fun _ => 0 }
  | k + 1 =>
    if h : k < n then greedyStep dem cl ⟨k, h⟩ (greedyState dem cl k)
    else greedyState dem cl k

/-- The price vector `p^k` after stage `k` of the algorithm (`p^0 = 0`). -/
noncomputable def greedyPrices {n m : ℕ} (dem : Fin n → (Fin m → ℝ) → Finset (Fin m))
    (cl : Fin n → Finset (Fin m) → (Fin m → ℝ)) (k : ℕ) : Fin m → ℝ :=
  (greedyState dem cl k).prices

/-- The allocation `A_1, …, A_n` generated by the algorithm: the bundles after stage `n`. -/
noncomputable def greedyAlloc {n m : ℕ} (dem : Fin n → (Fin m → ℝ) → Finset (Fin m))
    (cl : Fin n → Finset (Fin m) → (Fin m → ℝ)) : Fin n → Finset (Fin m) :=
  (greedyState dem cl n).bundles

end ComplementFreeCA.XOSGreedy


