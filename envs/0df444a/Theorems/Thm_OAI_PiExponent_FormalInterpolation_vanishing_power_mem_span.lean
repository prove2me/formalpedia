-- title:
--   Strong Nullstellensatz for a finite family of polynomials
-- statement:
--   For a finite family of complex multivariate polynomials, any polynomial vanishing at every common zero has a positive power in the ideal generated by the family. This is the strong Nullstellensatz in the form needed by the parent. Its boundary cases include an empty family: the hypothesis then requires vanishing on all points, and the conclusion follows from the same theorem.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

theorem OAI.PiExponent.FormalInterpolation.vanishing_power_mem_span {d m : Nat} (q : Fin m → MvPolynomial (Fin d) Complex) (f : MvPolynomial (Fin d) Complex) (hvanish : ∀ x : Fin d → Complex, (∀ j : Fin m, MvPolynomial.eval x (q j) = 0) → MvPolynomial.eval x f = 0) : ∃ N : Nat, 0 < N ∧ f ^ N ∈ Ideal.span (Set.range q) := by sorry
