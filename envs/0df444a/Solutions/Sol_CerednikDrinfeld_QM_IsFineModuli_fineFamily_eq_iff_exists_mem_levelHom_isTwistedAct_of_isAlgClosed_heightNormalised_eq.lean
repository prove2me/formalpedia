theorem eq_of_mapPt_iso_eq {A A' : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (i : A ≅ A') (hi : i.hom ≫ f' = f) {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of R)} {P Q : SchemeHomOver t f}
