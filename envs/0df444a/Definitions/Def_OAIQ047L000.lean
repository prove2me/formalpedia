namespace OAI

namespace Laughlin

noncomputable def modeFactor (Q x : ℕ) : ℝ :=
  Real.sqrt ((Q.descFactorial x : ℝ) / (Q : ℝ)^x)

noncomputable def pairFactor (Q p : ℕ) : ℝ :=
  Real.sqrt (((2 : ℝ)*Q)^p / ((2*Q-2).descFactorial p : ℝ))

end Laughlin

end OAI
