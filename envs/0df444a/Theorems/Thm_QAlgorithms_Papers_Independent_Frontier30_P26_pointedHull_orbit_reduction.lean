section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Theorem 3.2, PDF p. 8. Orbit intersection is a conclusion. -/
theorem pointedHull_orbit_reduction (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (x : G) (hp : Pointed (orbitHull x)) :
    (innerAdjointOrbit x ∩ ((LieAlgebra.center ℝ G).toSubmodule ⊔ P.L.toSubmodule : Submodule ℝ G)).Nonempty := by sorry

end Presentations

end

