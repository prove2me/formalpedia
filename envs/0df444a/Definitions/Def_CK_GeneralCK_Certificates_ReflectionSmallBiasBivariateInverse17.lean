  have h12 := ((lossPower12_approximates hk hklog).scale (30421755 : ℚ)).addAppend h13
  have h11 := ((lossPower11_approximates hk hklog).scale (13037895 : ℚ)).addAppend h12
  have h10 := ((lossPower10_approximates hk hklog).scale (5311735 : ℚ)).addAppend h11
  have h9 := ((lossPower9_approximates hk hklog).scale (2042975 : ℚ)).addAppend h10
  have h8 := ((lossPower8_approximates hk hklog).scale (735471 : ℚ)).addAppend h9
