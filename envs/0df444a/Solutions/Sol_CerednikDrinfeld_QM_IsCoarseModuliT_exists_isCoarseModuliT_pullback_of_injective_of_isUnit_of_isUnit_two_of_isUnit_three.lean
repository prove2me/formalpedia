theorem flat_specMap_of_injective (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] (k : Type) [Field k]
    (i : 𝒪 →+* k) (hi : Function.Injective i) : Flat (Spec.map (CommRingCat.ofHom i)) := by
  rw [HasRingHomProperty.Spec_iff (P := @Flat)]
  show i.Flat
  have hj : (IsFractionRing.lift (K := FractionRing 𝒪) hi).comp (algebraMap 𝒪 (FractionRing 𝒪)) = i :=
    RingHom.ext fun x => IsFractionRing.lift_algebraMap hi x
  rw [← hj]
  refine RingHom.Flat.comp ?_ ?_
  · exact RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat (FractionRing 𝒪) (nonZeroDivisors 𝒪))
  · letI : Algebra (FractionRing 𝒪) k := (IsFractionRing.lift (K := FractionRing 𝒪) hi).toAlgebra
    exact RingHom.flat_algebraMap_iff.mpr Module.Flat.of_free

theorem isCoarseModuliT_transport {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N ℓ : ℕ} {B : Type} [CommRing B]
    {X₁ : Scheme.{0}} {π₁ : X₁ ⟶ Spec (CommRingCat.of B)}
    {pt₁ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
      FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s π₁}
    (h₁ : IsCoarseModuliT Λ N ℓ X₁ π₁ pt₁)
    {X₂ : Scheme.{0}} (π₂ : X₂ ⟶ Spec (CommRingCat.of B)) (e : X₁ ⟶ X₂) [IsIso e] (he : e ≫ π₂ = π₁) :
    ∃ pt₂ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B)),
        FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s π₂,
      IsCoarseModuliT Λ N ℓ X₂ π₂ pt₂ ∧
      ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of B))
        (u : FakeEllipticCurve.WithExtraLevel Λ N ℓ S), (pt₂ S s u).1 = (pt₁ S s u).1 ≫ e := by
  have he' : inv e ≫ π₁ = π₂ := by simp [← he]
  refine ⟨fun S _ s E => ⟨(pt₁ S s E).1 ≫ e, by rw [Category.assoc, he, (pt₁ S s E).2]⟩, ⟨?_, ?_, ?_, ?_, ?_⟩,
    fun S _ s u => rfl⟩
  · intro S _ s E E' hEE'
    apply Subtype.ext
    dsimp only
    rw [h₁.ptT_iso S s E E' hEE']
  · intro S S' _ _ φ s s' hss' E E' hP
    show (pt₁ S' s' E').1 ≫ e = Spec.map (CommRingCat.ofHom φ) ≫ ((pt₁ S s E).1 ≫ e)
    rw [h₁.ptT_pullback S S' φ s s' hss' E E' hP, Category.assoc]
  · intro K _ _ s x
    obtain ⟨E, hE⟩ := h₁.ptT_surjective K s ⟨x.1 ≫ inv e, by rw [Category.assoc, he', x.2]⟩
    refine ⟨E, Subtype.ext ?_⟩
    show (pt₁ K s E).1 ≫ e = x.1
    rw [hE]
    simp
  · intro K _ _ s E E' hEE'
    apply h₁.ptT_injective K s E E'
    apply Subtype.ext
    have h := congrArg Subtype.val hEE'
    exact (cancel_mono e).mp h
  · intro T πT pt' hiso hpb
    obtain ⟨g, ⟨hgπ, hg⟩, huniq⟩ := h₁.univ T πT pt' hiso hpb
    refine ⟨inv e ≫ g, ⟨by rw [Category.assoc, hgπ, he'], fun S _ s E => ?_⟩, ?_⟩
    · show (pt' S s E).1 = ((pt₁ S s E).1 ≫ e) ≫ inv e ≫ g
      rw [hg S s E]
      simp
    · rintro g' ⟨hg'π, hg'⟩
      have hfac : e ≫ g' = g := huniq (e ≫ g') ⟨by rw [Category.assoc, hg'π, he], fun S _ s E => by
        rw [hg' S s E]; simp⟩
      rw [← hfac]
      simp

theorem mem_stabilizer_iff_of_label {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b])
    (hmul : ∀ x y : ℍ[ℚ, a, b], x ∈ Λ → y ∈ Λ → x * y ∈ Λ)
    (m ℓ : ℕ) (hℓm : ℓ ∣ m)
    (L₀ : Submodule ℤ ℍ[ℚ, a, b]) (hL₀ : L₀ ≤ Λ) (hℓL₀ : ∀ x : ↥Λ, (ℓ : ℚ) • (x : ℍ[ℚ, a, b]) ∈ L₀)
    (c c' y : ↥Λ) (hcc' : (c : ℍ[ℚ, a, b]) - (c' : ℍ[ℚ, a, b]) = (m : ℚ) • (y : ℍ[ℚ, a, b])) :
    (∀ x : ℍ[ℚ, a, b], x ∈ L₀ → x * (c : ℍ[ℚ, a, b]) ∈ L₀) ↔
      (∀ x : ℍ[ℚ, a, b], x ∈ L₀ → x * (c' : ℍ[ℚ, a, b]) ∈ L₀) := by
  obtain ⟨n, hn⟩ := hℓm
  have key : ∀ x : ℍ[ℚ, a, b], x ∈ L₀ → x * (c : ℍ[ℚ, a, b]) - x * (c' : ℍ[ℚ, a, b]) ∈ L₀ := by
    intro x hx
    have hxy : x * (y : ℍ[ℚ, a, b]) ∈ Λ := hmul x y (hL₀ hx) y.2
    have h1 : (ℓ : ℚ) • (x * (y : ℍ[ℚ, a, b])) ∈ L₀ := hℓL₀ ⟨_, hxy⟩
    have h2 : ((n : ℤ)) • ((ℓ : ℚ) • (x * (y : ℍ[ℚ, a, b]))) ∈ L₀ := L₀.smul_mem (n : ℤ) h1
    have : x * (c : ℍ[ℚ, a, b]) - x * (c' : ℍ[ℚ, a, b]) = ((n : ℤ)) • ((ℓ : ℚ) • (x * (y : ℍ[ℚ, a, b]))) := by
      rw [← mul_sub, hcc', mul_smul_comm, hn, Nat.cast_mul, ← Int.cast_smul_eq_zsmul ℚ, Int.cast_natCast, smul_smul,
        mul_comm (n : ℚ)]
    rw [this]; exact h2
  constructor
  · intro h x hx
    have := L₀.sub_mem (h x hx) (key x hx)
    simpa using this
  · intro h x hx
    have := L₀.add_mem (h x hx) (key x hx)
    simpa using this

end CoarseBCFieldQMT

