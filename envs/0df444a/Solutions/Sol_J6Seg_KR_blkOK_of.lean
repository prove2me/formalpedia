-- Source module: Solutions.J6SegKr6
/-!
# B3 (chunk kernel), part 6: the chunk on pairs with per-block records, and growth bounds

* `chunkB`, `chunkG2`: the chunk kernel on pairs, each block of length `n` with its own record
  length `r = 2n`; `liftG_chunkL2`: `liftG (chunkL …) = chunkG2 …`.
* growth: if the row entries are bounded by `X` and the tables by `2^P·Kt`, every stage value of a
  block of length `n ≤ λ` is bounded by `Xs ((λ+1)·Kt+1) X 7`, where `Xs K X i` iterates `X ↦ K·X+1`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-! ## The chunk on pairs, per-block records -/

/-! ## Growth of the stage values -/

lemma AB_mono {A A' : ℤ} {u : List GI} (h : AB A u) (hA : A ≤ A') : AB A' u :=
  fun w hw => ⟨(h w hw).1.trans hA, (h w hw).2.trans hA⟩

lemma rs_bnd (P : ℕ) {y M : ℤ} (h : |y| ≤ 2 ^ P * M) : |rs P y| ≤ M + 1 := by
  have e := rs_err P y
  have hP : (0 : ℝ) < 2 ^ P := by positivity
  have hy : |(y : ℝ) / 2 ^ P| ≤ M := by
    rw [abs_div, abs_of_pos hP, div_le_iff₀ hP]
    have : |(y : ℝ)| ≤ 2 ^ P * M := by rw [← Int.cast_abs]; exact_mod_cast h
    linarith
  have : |((rs P y : ℤ) : ℝ)| ≤ (M : ℝ) + 1 := by
    have := abs_sub_abs_le_abs_sub ((rs P y : ℤ) : ℝ) ((y : ℝ) / 2 ^ P)
    linarith
  exact_mod_cast this

lemma getD_TB {A : ℤ} {c : List ℤ} (h : TB A c) (hA : 0 ≤ A) (i : ℕ) : |c.getD i 0| ≤ A := by
  rcases lt_or_ge i c.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ hi]; simpa using hA

lemma AB_dgG (P : ℕ) {Kt X : ℤ} {cs : List ℤ} {z : List GI} (hc : TB (2 ^ P * Kt) cs) (hz : AB X z)
    (hX : 0 ≤ X) : AB (Kt * X + 1) (dgG P cs z) := by
  intro w hw
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hw
  have hi' : i < cs.length ∧ i < z.length := by simpa [dgG] using hi
  simp only [dgG, List.getElem_zipWith]
  have hci := hc _ (List.getElem_mem hi'.1)
  have hzi := hz _ (List.getElem_mem hi'.2)
  have hKt : 0 ≤ Kt := by
    have : (0 : ℤ) ≤ 2 ^ P * Kt := (abs_nonneg _).trans hci
    exact nonneg_of_mul_nonneg_right (by linarith) (by positivity : (0 : ℤ) < 2 ^ P)
  have hb : ∀ a : ℤ, |a| ≤ X → |cs[i] * a| ≤ 2 ^ P * (Kt * X) := fun a ha => by
    rw [abs_mul, ← mul_assoc]
    exact mul_le_mul hci ha (abs_nonneg _) (by positivity)
  exact ⟨rs_bnd P (hb _ hzi.1), rs_bnd P (hb _ hzi.2)⟩

lemma TB_lwL (P : ℕ) {Kt X : ℤ} {n : ℕ} {c y : List ℤ} (hc : TB (2 ^ P * Kt) c) (hy : TB X y)
    (hX : 0 ≤ X) (hKt : 0 ≤ Kt) (hn : y.length ≤ n) : TB (n * Kt * X + 1) (lwL P c y) := by
  intro a ha
  simp only [lwL, convL, List.map_map, List.mem_map, List.mem_range, Function.comp] at ha
  obtain ⟨u, hu, rfl⟩ := ha
  apply rs_bnd
  have hP : (0 : ℤ) ≤ 2 ^ P * Kt := by positivity
  calc |∑ k ∈ Finset.range (u + 1), c.getD (u - k) 0 * y.getD k 0|
      ≤ ∑ k ∈ Finset.range (u + 1), |c.getD (u - k) 0 * y.getD k 0| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k ∈ Finset.range (u + 1), 2 ^ P * Kt * X := by
        apply Finset.sum_le_sum; intro k _
        rw [abs_mul]
        exact mul_le_mul (getD_TB hc hP _) (getD_TB hy hX _) (abs_nonneg _) hP
    _ = (u + 1 : ℕ) * (2 ^ P * Kt * X) := by simp
    _ ≤ n * (2 ^ P * Kt * X) := by
        apply mul_le_mul_of_nonneg_right (by exact_mod_cast (by omega : u + 1 ≤ n)) (by positivity)
    _ = 2 ^ P * (n * Kt * X) := by ring

lemma AB_liftG {f : List ℤ → List ℤ} {A : ℤ} {z : List GI} (X : ℤ) (hz : AB X z)
    (hf : ∀ y : List ℤ, TB X y → y.length = z.length → TB A (f y)) : AB A (liftG f z) := by
  intro w hw
  unfold liftG at hw
  have h1 := List.of_mem_zip hw
  refine ⟨hf _ ?_ (by simp) _ h1.1, hf _ ?_ (by simp) _ h1.2⟩
  · intro a ha; simp only [List.mem_map] at ha; obtain ⟨v, hv, rfl⟩ := ha; exact (hz v hv).1
  · intro a ha; simp only [List.mem_map] at ha; obtain ⟨v, hv, rfl⟩ := ha; exact (hz v hv).2

lemma AB_lwG (P : ℕ) {Kt X : ℤ} {n : ℕ} {c : List ℤ} {z : List GI} (hc : TB (2 ^ P * Kt) c)
    (hz : AB X z) (hX : 0 ≤ X) (hKt : 0 ≤ Kt) (hzn : z.length ≤ n) (hzc : z.length ≤ c.length) :
    AB (n * Kt * X + 1) (lwG P (2 * n) c z) := by
  rw [← liftG_lwL P c z hzc (by omega)]
  exact AB_liftG X hz (fun y hy hl => TB_lwL P hc hy hX hKt (by omega))

lemma AB_upG (P : ℕ) {Kt X : ℤ} {n : ℕ} {c : List ℤ} {z : List GI} (hc : TB (2 ^ P * Kt) c)
    (hz : AB X z) (hX : 0 ≤ X) (hKt : 0 ≤ Kt) (hzn : z.length ≤ n) (hzc : z.length ≤ c.length) :
    AB (n * Kt * X + 1) (upG P (2 * n) c z) :=
  AB_rev (AB_lwG P hc (AB_rev hz) hX hKt (by simpa using hzn) (by simpa using hzc))

lemma Xs_nonneg {K X : ℤ} (hK : 0 ≤ K) (hX : 0 ≤ X) : ∀ i, 0 ≤ Xs K X i
  | 0 => hX
  | i + 1 => by have := Xs_nonneg hK hX i; simp only [Xs]; positivity

lemma Xs_succ_ge {K X : ℤ} (hK : 1 ≤ K) (hX : 0 ≤ X) (i : ℕ) : Xs K X i ≤ Xs K X (i + 1) := by
  have := Xs_nonneg (K := K) (by omega) hX i
  simp only [Xs]; nlinarith [mul_nonneg (sub_nonneg.2 hK) this]

lemma Xs_mono {K X : ℤ} (hK : 1 ≤ K) (hX : 0 ≤ X) {i j : ℕ} (h : i ≤ j) : Xs K X i ≤ Xs K X j := by
  induction h with
  | refl => exact le_rfl
  | step _ ih => exact ih.trans (Xs_succ_ge hK hX _)

/-- **Growth**: all stage values of a block bounded. -/
theorem blkOK_of_sol_aux (P : ℕ) {Kt X : ℤ} {lam n pk : ℕ} {di gi gam dd am ap : List ℤ} {z : List GI}
    (hKt : 0 ≤ Kt) (hX : 0 ≤ X) (hz : AB X z) (hzn : z.length = n) (hnl : n ≤ lam)
    (tdi : TB (2 ^ P * Kt) di) (tgi : TB (2 ^ P * Kt) gi) (tga : TB (2 ^ P * Kt) gam)
    (tdd : TB (2 ^ P * Kt) dd) (tam : TB (2 ^ P * Kt) am) (tap : TB (2 ^ P * Kt) ap)
    (hdi : n ≤ di.length) (hgi : n ≤ gi.length) (hga : n ≤ gam.length) (hdd : n ≤ dd.length)
    (ham : n ≤ am.length) (hap : n ≤ ap.length)
    (hpk : Xs ((lam + 1) * Kt + 1) X 7 ≤ 2 ^ pk) :
    blkOK P (2 ^ pk) (2 * n) di gi gam dd am ap z := by
  set K := ((lam : ℤ) + 1) * Kt + 1 with hK
  have hK1 : 1 ≤ K := by have : (0 : ℤ) ≤ (lam + 1) * Kt := by positivity
                         omega
  have hKt' : Kt ≤ K := by
    have : (0 : ℤ) ≤ lam * Kt := by positivity
    rw [hK]; nlinarith
  have hnK : (n : ℤ) * Kt ≤ K := by
    have : (n : ℤ) ≤ lam + 1 := by have := (show (n : ℤ) ≤ lam by exact_mod_cast hnl); omega
    rw [hK]; nlinarith
  have step_dg : ∀ {c : List ℤ} {u : List GI} {i : ℕ}, TB (2 ^ P * Kt) c → AB (Xs K X i) u →
      AB (Xs K X (i + 1)) (dgG P c u) := by
    intro c u i hc hu
    have h0 := Xs_nonneg (K := K) (by omega) hX i
    refine AB_mono (AB_dgG P hc hu h0) ?_
    simp only [Xs]; nlinarith [mul_le_mul_of_nonneg_right hKt' h0]
  have step_lw : ∀ {c : List ℤ} {u : List GI} {i : ℕ}, TB (2 ^ P * Kt) c → AB (Xs K X i) u →
      u.length ≤ n → u.length ≤ c.length → AB (Xs K X (i + 1)) (lwG P (2 * n) c u) := by
    intro c u i hc hu h1 h2
    have h0 := Xs_nonneg (K := K) (by omega) hX i
    refine AB_mono (AB_lwG P hc hu h0 hKt h1 h2) ?_
    simp only [Xs]; nlinarith [mul_le_mul_of_nonneg_right hnK h0]
  have step_up : ∀ {c : List ℤ} {u : List GI} {i : ℕ}, TB (2 ^ P * Kt) c → AB (Xs K X i) u →
      u.length ≤ n → u.length ≤ c.length → AB (Xs K X (i + 1)) (upG P (2 * n) c u) := by
    intro c u i hc hu h1 h2
    have h0 := Xs_nonneg (K := K) (by omega) hX i
    refine AB_mono (AB_upG P hc hu h0 hKt h1 h2) ?_
    simp only [Xs]; nlinarith [mul_le_mul_of_nonneg_right hnK h0]
  have l1 : (dgG P di z).length = n := by rw [length_dgG P (by omega), hzn]
  have l2 : (dgG P gi (dgG P di z)).length = n := by rw [length_dgG P (by omega), l1]
  have l3 : (lwG P (2 * n) am (dgG P gi (dgG P di z))).length = n := by
    rw [length_lwG P (by omega), l2]
  have l4 : (dgG P gam (lwG P (2 * n) am (dgG P gi (dgG P di z)))).length = n := by
    rw [length_dgG P (by omega), l3]
  have l5 : (upG P (2 * n) ap (dgG P gam (lwG P (2 * n) am (dgG P gi (dgG P di z))))).length = n := by
    simp only [upG, List.length_reverse]; rw [length_lwG P (by simp; omega)]; simp [l4]
  have l6 : (dgG P gi (upG P (2 * n) ap (dgG P gam (lwG P (2 * n) am
      (dgG P gi (dgG P di z)))))).length = n := by rw [length_dgG P (by omega), l5]
  have a0 : AB (Xs K X 0) z := hz
  have a1 := step_dg (i := 0) tdi a0
  have a2 := step_dg (i := 1) tgi a1
  have a3 := step_lw (i := 2) tam a2 (by omega) (by omega)
  have a4 := step_dg (i := 3) tga a3
  have a5 := step_up (i := 4) tap a4 (by omega) (by omega)
  have a6 := step_dg (i := 5) tgi a5
  have a7 := step_dg (i := 6) tdd a6
  have fin : ∀ i ≤ 7, Xs K X i ≤ 2 ^ pk := fun i hi => (Xs_mono hK1 hX hi).trans hpk
  exact ⟨AB_mono a0 (fin 0 (by omega)), AB_mono a1 (fin 1 (by omega)), AB_mono a2 (fin 2 (by omega)),
    AB_mono a3 (fin 3 (by omega)), AB_mono a4 (fin 4 (by omega)), AB_mono a5 (fin 5 (by omega)),
    AB_mono a6 (fin 6 (by omega)), AB_mono a7 (fin 7 (by omega))⟩

end J6Seg.KR

end

