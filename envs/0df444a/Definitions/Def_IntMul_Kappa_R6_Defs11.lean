  | sel c x y, s, hc, hok => by
    have hcc : c.Clean := fun i hi => hc i (by simp [regs, hi])
    have hcx : x.Clean := fun i hi => hc i (by simp [regs, hi])
    have hcy : y.Clean := fun i hi => hc i (by simp [regs, hi])
    obtain ⟨hoc, hoxy⟩ := hok
    have h1 := code_runs_r6c c s hcc hoc
    have h2 := IRuns.mv_r6c (I := I) (iprog := iprog) (s := s.upd 56 (.int (c.eval s) :: s.G 56))
      (i := zX.V) (j := zX.A) (a := c.eval s) (L := s.G 56) (by decide) (by simp)
    set s2 := ((s.upd 56 (.int (c.eval s) :: s.G 56)).upd zX.V (s.G 56)).upd zX.A
      (.int (c.eval s) :: (s.upd 56 (.int (c.eval s) :: s.G 56)).G zX.A)
    have hd := IRuns.drop_r6c (I := I) (iprog := iprog) (s := s2) (i := zX.A) (a := c.eval s)
      (L := s.G 57) (by simp [s2])
    have e3 : s2.upd zX.A (s.G 57) = s := by simp only [s2]; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))
    rw [e3] at hd
    by_cases hneg : c.eval s < 0
    · have hx := code_runs_r6c x s hcx (by simpa [hneg] using hoxy)
      have hi := IRuns.iteT (I := I) (iprog := iprog) (i := zX.A) (f := fun k => k == .neg)
        (q := .seq (.op (.drop zX.A)) (y.code zX))
        (by rw [cl_int s2 zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; omega)
        (hd.seq_r6c hx)
      refine (h1.seq_r6c (h2.seq_r6c hi)).mono' (by simp [eval, hneg]) ?_
      simp only [cost, if_pos hneg]; omega
    · have hy := code_runs_r6c y s hcy (by simpa [hneg] using hoxy)
      have hi := IRuns.iteF (I := I) (iprog := iprog) (i := zX.A) (f := fun k => k == .neg)
        (p := .seq (.op (.drop zX.A)) (x.code zX))
        (by rw [cl_int s2 zX.A (c.eval s) (s.G 57) (by simp [s2])]; simp [hneg]; split_ifs <;> simp)
        (hd.seq_r6c hy)
      refine (h1.seq_r6c (h2.seq_r6c hi)).mono' (by simp [eval, hneg]) ?_
      simp only [cost, if_neg hneg]; omega
  | ndiv a b, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [regs, hi])
    have hcb : b.Clean := fun i hi => hc i (by simp [regs, hi])
    obtain ⟨hoa, hob, ha0, hb0⟩ := hok
    have ha := code_runs_r6c a s hca hoa
    set s1 := s.upd 56 (.int (a.eval s) :: s.G 56)
    have hb := code_runs_r6c b s1 hcb ((ok_upd s 56 _ b hcb.not56).2 hob)
    rw [eval_upd s 56 _ b hcb.not56, cost_upd s 56 _ b hcb.not56] at hb
    obtain ⟨u, hu⟩ : ∃ u : ℕ, a.eval s = u := ⟨(a.eval s).toNat, by omega⟩
    obtain ⟨v, hv⟩ : ∃ v : ℕ, b.eval s = v := ⟨(b.eval s).toNat, by omega⟩
    have hv0 : 0 < v := by omega
    rw [hv] at hb
    have hd := ldivCode_runs (I := I) (iprog := iprog) (s1.upd 56 (.int v :: s1.G 56)) u v hv0
      (s.G 56) (by simp [s1, hu])
    have ht : IRuns I iprog (.op (.drop zX.G))
        (((s1.upd 56 (.int v :: s1.G 56)).upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)).upd 63
          (.int ((u % v : ℕ) : ℤ) :: (s1.upd 56 (.int v :: s1.G 56)).G 63))
        (s.upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)) (2 * zsz ((u % v : ℕ) : ℤ) + 2) := by
      apply IRuns.of_runsTo_r6c 0
      simp +decide [IStmt.run, IOp.run, s1]
      try refine ⟨?_, ?_⟩
      all_goals first | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)) | omega
    refine (ha.seq_r6c (hb.seq_r6c (hd.seq_r6c ht))).mono' (by simp [eval, hu, hv]) ?_
    simp only [cost, hu, hv]
    have : zsz ((u % v : ℕ) : ℤ) ≤ zsz (v : ℤ) :=
      zsz_mono_r6c (by simp; exact (Nat.mod_lt _ hv0).le)
    have : 2 * zsz (v : ℤ) + 2 ≤ ldivCost (zsz (u : ℤ) + zsz (v : ℤ)) := by
      have := Nat.le_self_pow (n := 2) (by norm_num) (zsz (u : ℤ) + zsz (v : ℤ) + 2)
      simp only [ldivCost]; omega
    omega
  | nmod a b, s, hc, hok => by
    have hca : a.Clean := fun i hi => hc i (by simp [regs, hi])
    have hcb : b.Clean := fun i hi => hc i (by simp [regs, hi])
    obtain ⟨hoa, hob, ha0, hb0⟩ := hok
    have ha := code_runs_r6c a s hca hoa
    set s1 := s.upd 56 (.int (a.eval s) :: s.G 56)
    have hb := code_runs_r6c b s1 hcb ((ok_upd s 56 _ b hcb.not56).2 hob)
    rw [eval_upd s 56 _ b hcb.not56, cost_upd s 56 _ b hcb.not56] at hb
    obtain ⟨u, hu⟩ : ∃ u : ℕ, a.eval s = u := ⟨(a.eval s).toNat, by omega⟩
    obtain ⟨v, hv⟩ : ∃ v : ℕ, b.eval s = v := ⟨(b.eval s).toNat, by omega⟩
    have hv0 : 0 < v := by omega
    rw [hv] at hb
    have hd := ldivCode_runs (I := I) (iprog := iprog) (s1.upd 56 (.int v :: s1.G 56)) u v hv0
      (s.G 56) (by simp [s1, hu])
    have ht : IRuns I iprog (.seq (.op (.drop zX.V)) (.op (.mv zX.G zX.V)))
        (((s1.upd 56 (.int v :: s1.G 56)).upd 56 (.int ((u / v : ℕ) : ℤ) :: s.G 56)).upd 63
          (.int ((u % v : ℕ) : ℤ) :: (s1.upd 56 (.int v :: s1.G 56)).G 63))
        (s.upd 56 (.int ((u % v : ℕ) : ℤ) :: s.G 56))
        (2 * zsz ((u / v : ℕ) : ℤ) + 2 + (2 * moveCost (zsz ((u % v : ℕ) : ℤ)) + 19)) := by
      apply IRuns.of_runsTo_r6c 0
      simp +decide [IStmt.run, IOp.run, s1]
      try refine ⟨?_, ?_⟩
      all_goals first | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)) | omega
    refine (ha.seq_r6c (hb.seq_r6c (hd.seq_r6c ht))).mono' (by simp [eval, hu, hv]) ?_
    simp only [cost, hu, hv]
    have h1 : zsz ((u % v : ℕ) : ℤ) ≤ zsz (v : ℤ) :=
      zsz_mono_r6c (by simp; exact (Nat.mod_lt _ hv0).le)
    have h2 : zsz ((u / v : ℕ) : ℤ) ≤ zsz (u : ℤ) :=
      zsz_mono_r6c (by simp; exact Nat.div_le_self _ _)
    have : 2 * zsz (u : ℤ) + 2 + (2 * moveCost (zsz (v : ℤ)) + 19) ≤
        ldivCost (zsz (u : ℤ) + zsz (v : ℤ)) := by
      have := Nat.le_self_pow (n := 2) (by norm_num) (zsz (u : ℤ) + zsz (v : ℤ) + 2)
      simp only [ldivCost, moveCost]; omega
    have : moveCost (zsz ((u % v : ℕ) : ℤ)) ≤ moveCost (zsz (v : ℤ)) := by
      simp only [moveCost]; omega
    omega

end Ex

end NLogN

end

section
-- Source module: NLogN.HExprCost
/-!
# A uniform cost bound for expressions

If every value an expression computes (and every register it reads) has at most `B` bits, its
code costs at most `size · 10^7 · (B+2)^2`.
-/

namespace NLogN

open IntMul

variable {S : ℕ}

namespace Ex

theorem zsz_eval_le (s : IState S) (B : ℕ) : ∀ e : Ex S, e.Bnd s B → zsz (e.eval s) ≤ B
  | reg _, h | lit _, h => h
  | add _ _, h | mul _ _, h | shl _ _, h | ndiv _ _, h | nmod _ _, h => h.2.2
  | neg a, h => by simp only [eval, zsz_neg_r6c]; exact zsz_eval_le s B a h
  | quo a r, h => by
    simp only [eval]
    exact le_trans (zsz_mono_r6c (by rw [Int.natAbs_tdiv]; exact Nat.div_le_self _ _))
      (zsz_eval_le s B a h.1)
  | rem a r, h => by
    simp only [eval]
    exact le_trans (zsz_mono_r6c (by rw [Int.natAbs_tmod]; exact Nat.mod_le _ _))
      (zsz_eval_le s B a h.1)
  | pow2 a, h => by
    simp only [eval]; rw [zsz_two_pow_r6c]; have := h.2; omega
  | sel c x y, h => by
    simp only [eval]; split_ifs with hc
    · exact zsz_eval_le s B x (by simpa [hc] using h.2)
    · exact zsz_eval_le s B y (by simpa [hc] using h.2)

theorem cost_le_r6c (s : IState S) (B : ℕ) : ∀ e : Ex S, e.Bnd s B →
    e.cost s ≤ e.size * 10 ^ 7 * (B + 2) ^ 2
  | reg i, h => by
    simp only [cost, size, Bnd] at h ⊢; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | lit c, h => by
    simp only [cost, size, Bnd] at h ⊢; nlinarith
  | add a b, h => by
    have ha := cost_le_r6c s B a h.1; have hb := cost_le_r6c s B b h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | mul a b, h => by
    have ha := cost_le_r6c s B a h.1; have hb := cost_le_r6c s B b h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | shl a b, h => by
    have ha := cost_le_r6c s B a h.1; have hb := cost_le_r6c s B b h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | quo a b, h | rem a b, h => by
    have ha := cost_le_r6c s B a h.1; have hb := cost_le_r6c s B b h.2
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | ndiv a b, h | nmod a b, h => by
    have ha := cost_le_r6c s B a h.1; have hb := cost_le_r6c s B b h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | neg a, h => by
    have ha := cost_le_r6c s B a h
    have : 1 ≤ (B + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
    simp only [cost, size]; nlinarith
  | pow2 a, h => by
    have ha := cost_le_r6c s B a h.1
    have za := zsz_eval_le s B a h.1
    have ht := h.2
    have zt : zsz (((a.eval s).toNat : ℕ) : ℤ) ≤ B := by
      have := zsz_natCast_le_self' (a.eval s).toNat; omega
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | sel c x y, h => by
    have hc := cost_le_r6c s B c h.1
    have zc := zsz_eval_le s B c h.1
    simp only [cost, size]
    split_ifs with hn
    · have hx := cost_le_r6c s B x (by simpa [hn] using h.2)
      (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
    · have hy := cost_le_r6c s B y (by simpa [hn] using h.2)
      (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith

end Ex

end NLogN

end

section
-- Source module: NLogN.HExprLin
/-!
# Linear cost bound for multiplication-free expressions

Expressions built from registers, literals, `add`, `neg`, `shl`, `quo`, `rem` and `sel` cost at
most `size · 2000 · (B + 2)` when every value has at most `B` bits.  This is what per-element
list operations use; products of large numbers go through the multiplication procedure instead.
-/

namespace NLogN

open IntMul

variable {S : ℕ}

namespace Ex

theorem cost_le_lin (s : IState S) (B : ℕ) : ∀ e : Ex S, e.Lin → e.Bnd s B →
    e.cost s ≤ e.size * 2000 * (B + 2)
  | reg i, _, h => by
    simp only [cost, size, Bnd] at h ⊢; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | lit c, _, h => by
    simp only [cost, size, Bnd] at h ⊢; nlinarith
  | add a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | shl a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2.1
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | quo a b, hl, h | rem a b, hl, h => by
    have ha := cost_le_lin s B a hl.1 h.1; have hb := cost_le_lin s B b hl.2 h.2
    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2
    simp only [cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | neg a, hl, h => by
    have ha := cost_le_lin s B a hl h
    simp only [cost, size]; nlinarith
  | sel c x y, hl, h => by
    have hc := cost_le_lin s B c hl.1 h.1
    have zc := zsz_eval_le s B c h.1
    simp only [cost, size]
    split_ifs with hn
    · have hx := cost_le_lin s B x hl.2.1 (by simpa [hn] using h.2)
      (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
    · have hy := cost_le_lin s B y hl.2.2 (by simpa [hn] using h.2)
      (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | mul _ _, hl, _ | pow2 _, hl, _ | ndiv _ _, hl, _ | nmod _ _, hl, _ => hl.elim

end Ex

end NLogN

end

section
-- Source module: NLogN.HReg
/-!
# Register programs

`RS` is a small structured language over the register stacks `0 … 55`: assignments of
expressions, pushes and pops, conditionals and counted loops.  `RS.run` is its functional
semantics on `IState`s, and `RS.code_runs` shows that the compiled `IStmt` realises it with cost
`RS.cost`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

namespace RS

/-! ## Frame -/

theorem run_G_of_not_mem : ∀ (p : RS) (s : IState HS) (j : Fin HS), j ∉ p.writes →
    (p.run s).G j = s.G j
  | skip, s, j, _ => rfl
  | asg i e, s, j, h | push i e, s, j, h | pop i, s, j, h => by
    simp only [writes, List.mem_singleton] at h; simp [run, IState.upd_G, h]
  | seq a b, s, j, h => by
    simp only [writes, List.mem_append, not_or] at h
    simp only [run]; rw [run_G_of_not_mem b _ j h.2, run_G_of_not_mem a _ j h.1]
  | ite c a b, s, j, h => by
    simp only [writes, List.mem_append, not_or] at h
    simp only [run]; split_ifs
    · exact run_G_of_not_mem a _ j h.1
    · exact run_G_of_not_mem b _ j h.2
  | rep i n b, s, j, h => by
    simp only [writes, List.mem_cons, not_or] at h
    simp only [run, IState.upd_G, if_neg h.1]
    suffices H : ∀ k (t : IState HS), ((fun t => decSt i (b.run t))^[k] t).G j = t.G j by
      rw [H]; simp [IState.upd_G, h.1]
    intro k; induction k with
    | zero => intro t; rfl
    | succ k ih =>
      intro t
      rw [Function.iterate_succ_apply']
      have e := ih t
      generalize ((fun t => decSt i (b.run t))^[k] t) = X at e ⊢
      simp only [decSt, IState.upd_G, if_neg h.1]
      rw [run_G_of_not_mem b _ j h.2, e]

theorem repSt_G (i : Fin HS) (n : Ex HS) (b : RS) (s : IState HS) (hi : i ∉ b.writes) :
    ∀ k, (repSt i n b s k).G i = .int (n.eval s - k) :: s.G i := by
  intro k; induction k with
  | zero => simp [repSt, IState.upd_G]
  | succ k ih =>
    simp only [repSt] at ih ⊢
    rw [Function.iterate_succ_apply']
    generalize ((fun t => decSt i (b.run t))^[k] (s.upd i (.int (n.eval s) :: s.G i))) = X at ih ⊢
    have h1 := run_G_of_not_mem b X i hi
    rw [ih] at h1
    simp only [decSt, IState.upd_G, if_pos rfl, IState.top, h1, List.tail_cons]
    push_cast; ring_nf

/-! ## Compilation -/

theorem ne56 {i : Fin HS} (hi : i.val < 56) : (56 : Fin HS) ≠ i := by
  intro h; rw [← h] at hi; exact absurd hi (by decide)

theorem clean_of_lt {i : Fin HS} (hi : i.val < 56) : (Ex.reg i).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_singleton] at hj
  subst hj; simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false]
  intro h; rcases h with h | h | h | h | h | h | h | h <;> (subst h; exact absurd hi (by decide))

theorem asg_runs (i : Fin HS) (e : Ex HS) (s : IState HS) (hi : i.val < 56) (hc : e.Clean)
    (hok : e.ok s) (hint : s.IsInt i) :
    IRuns I iprog (.seq (e.code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i)))) s
      (s.upd i (.int (e.eval s) :: (s.G i).tail)) (asgCost i e s) := by
  have hne := ne56 hi
  have h1 := Ex.code_runs_r6c (I := I) (iprog := iprog) e s hc hok
  obtain ⟨L, hL⟩ := hint
  have h2 := IRuns.drop_r6c (I := I) (iprog := iprog) (s := s.upd 56 (.int (e.eval s) :: s.G 56))
    (i := i) (a := s.top i) (L := L) (by simp [IState.upd_G, Ne.symm hne, hL])
  have h3 := IRuns.mv_r6c (I := I) (iprog := iprog)
    (s := (s.upd 56 (.int (e.eval s) :: s.G 56)).upd i L) (i := zX.V) (j := i) (a := e.eval s)
    (L := s.G 56) (by simpa using hne) (by simp [IState.upd_G, hne])
  refine (h1.seq_r6c (h2.seq_r6c h3)).mono' ?_ (by simp only [asgCost]; omega)
  have hne' := Ne.symm hne
  apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
    split_ifs <;> simp_all

theorem code_runs : ∀ (p : RS) (s : IState HS), p.ok s →
    IRuns I iprog (p.code) s (p.run s) (p.cost s)
  | skip, s, _ => IRuns.skip_r6c s
  | asg i e, s, ⟨hi, hc, hok, hint⟩ => asg_runs i e s hi hc hok hint
  | push i e, s, ⟨hi, hc, hok⟩ => by
    have hne := ne56 hi
    have h1 := Ex.code_runs_r6c (I := I) (iprog := iprog) e s hc hok
    have h3 := IRuns.mv_r6c (I := I) (iprog := iprog)
      (s := s.upd 56 (.int (e.eval s) :: s.G 56)) (i := zX.V) (j := i) (a := e.eval s)
      (L := s.G 56) (by simpa using hne) (by simp [IState.upd_G])
    refine (h1.seq_r6c h3).mono' ?_ (by simp only [cost]; exact le_rfl)
