theorem perPiece
    (g N n : ℕ) (δ : Fin g → ℕ) [hδ : ∀ i, NeZero (δ i)] (hδd : ∏ i, δ i = N + 1)
    (e : Fin (N + 1) ≃ ((i : Fin g) → ZMod (δ i)))
    (B : Type) [CommRing B] (hd : IsUnit ((N + 1 : ℕ) : B))
    (ζ : B) (hζ : ζ ^ (N + 1) = 1) (hζu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - ζ ^ j))
    (ω : B) (hω : ω ^ 2 = ζ)
    (hint : ∀ γ : (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)), ∃ U : Matrix (Fin (N + 1)) (Fin (N + 1)) B, ThetaLevel.IsIntertwiner δ (N + 1) B ω e γ.1 U)
    {S : Type} [CommRing S] (φB : B →+* S)
    (X X' : FramedPolarisedAbelianScheme g N n S) (hX : X.IsThetaAdapted δ e) (hX' : X'.IsThetaAdapted δ e)
    {m : ℕ} (r : Fin m → S)
    (hloc : ∀ (j : Fin m) (wj : PolarisedAbelianScheme g (N + 1) n (Localization.Away (r j))),
        PolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X'.toPolarisedAbelianScheme wj →
        PolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r j))) X.toPolarisedAbelianScheme wj)
    (a : Fin m) :
    ∃ (Ya Ya' Xa : FramedPolarisedAbelianScheme g N n (Localization.Away (r a)))
      (k : ℕ) (ε : Fin k → Localization.Away (r a)) (γ : Fin k → (ThetaLevel.Heis.Gam (δ := δ) (d := N + 1)))
      (c : (Localization.Away (r a))ˣ),
      FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r a))) X Ya ∧
      FramedPolarisedAbelianScheme.IsPullback (algebraMap S (Localization.Away (r a))) X' Ya' ∧
      FramedPolarisedAbelianScheme.Iso Xa Ya' ∧
      (∀ l, IsIdempotentElem (ε l)) ∧ (∑ l, ε l = 1) ∧ (∀ l l', l ≠ l' → ε l * ε l' = 0) ∧
      Ya.IsReframe (fun i j => ∑ l, ε l * (c : Localization.Away (r a)) *
          ((algebraMap S (Localization.Away (r a))).comp φB)
            ((Matrix.transpose (ThetaLevel.inter δ (N + 1) B ω e ((γ l)⁻¹).1)) i j)) Xa := by
  classical

  obtain ⟨Ya, hYa⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isPullback_type0 (algebraMap S (Localization.Away (r a))) X
  obtain ⟨Ya', hYa'⟩ := AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_isPullback_type0 (algebraMap S (Localization.Away (r a))) X'

  have hYaP := isPullback_toPolarisedAbelianScheme _ X Ya hYa
  have hYa'P := hloc a Ya'.toPolarisedAbelianScheme (isPullback_toPolarisedAbelianScheme _ X' Ya' hYa')

  obtain ⟨eA, heA, hmul, hP, ⟨ψ⟩⟩ :=
    AlgebraicGeometry.PolarisedAbelianScheme.exists_iso_nonempty_pullback_pol_iso_of_isPullback_of_isPullback (algebraMap S (Localization.Away (r a))) X.toPolarisedAbelianScheme
      Ya.toPolarisedAbelianScheme Ya'.toPolarisedAbelianScheme hYaP hYa'P

  obtain ⟨Pa, -, hto, h₁, h₂⟩ := AlgebraicGeometry.Scheme.Modules.ProjPresentation.exists_sigma_eq_app_unit_and_toProj_eq_comp_of_iso eA heA ψ Ya'.frame Ya'.frame_isClosedImmersion Ya'.frame_basis

  have hIso : FramedPolarisedAbelianScheme.Iso
      (⟨Ya.toPolarisedAbelianScheme, Pa, h₁, h₂⟩ : FramedPolarisedAbelianScheme g N n _) Ya' :=
    AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_mk_of_iso_hom_comp_toProj_eq Ya.toPolarisedAbelianScheme Ya' eA heA hmul hP ψ Pa h₁ h₂ hto

  have hζS : (φB ζ) ^ (N + 1) = 1 := by rw [← map_pow, hζ, map_one]
  have hζSu : ∀ j : ℕ, 0 < j → j < N + 1 → IsUnit (1 - (φB ζ) ^ j) := fun j hj hj' => by
    simpa using (hζu j hj hj').map φB
  have hYa_ad : Ya.IsThetaAdapted δ e := AlgebraicGeometry.FramedPolarisedAbelianScheme.isThetaAdapted_of_isPullback δ e _ (φB ζ) hζS hζSu X Ya hYa hX
  have hYa'_ad : Ya'.IsThetaAdapted δ e := AlgebraicGeometry.FramedPolarisedAbelianScheme.isThetaAdapted_of_isPullback δ e _ (φB ζ) hζS hζSu X' Ya' hYa' hX'
  have hXa_ad : FramedPolarisedAbelianScheme.IsThetaAdapted δ e
      (⟨Ya.toPolarisedAbelianScheme, Pa, h₁, h₂⟩ : FramedPolarisedAbelianScheme g N n _) :=
    AlgebraicGeometry.FramedPolarisedAbelianScheme.isThetaAdapted_of_iso δ e Ya' _ (AlgebraicGeometry.FramedPolarisedAbelianScheme.iso_symm _ _ hIso) hYa'_ad
  obtain ⟨F, hF⟩ := hYa_ad
  obtain ⟨F', hF'⟩ := hXa_ad

  obtain ⟨k, ε, γ, c, hε₁, hε₂, hε₃, hLG⟩ :=
    AlgebraicGeometry.FramedPolarisedAbelianScheme.exists_idempotents_gam_units_schrodingerFrame_sigma_eq
      g N n δ hδd e B hd ζ hζ hζu ω hω hint ((algebraMap S (Localization.Away (r a))).comp φB) Ya F F'

  have hre := AlgebraicGeometry.FramedPolarisedAbelianScheme.isReframe_mk_of_forall_eq_sum_baseScalar_smul_pullbackLocalSection e Ya Pa h₁ h₂ F.σ F'.σ hF hF' _ hLG
  exact ⟨Ya, Ya', ⟨Ya.toPolarisedAbelianScheme, Pa, h₁, h₂⟩, k, ε, γ, c, hYa, hYa', hIso, hε₁, hε₂, hε₃, hre⟩

