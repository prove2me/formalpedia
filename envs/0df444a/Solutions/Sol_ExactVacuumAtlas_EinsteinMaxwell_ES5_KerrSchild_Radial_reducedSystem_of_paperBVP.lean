/-! # VII-03 (F2b): the paper's Eqs. 23a, 24a, 24b, 25 and the four remaining VI residuals

The residuals below are the paper's equations (Fröb et al., EPJC 82:215 (2022), Eqs. 23a, 24a,
24b, 25) written literally as left minus right, with genuine derivatives in the VI radial variable
`R`; `Q`, `J` are parameters (common constants at the BVP level). With `T = 2m²(a')² - f a²`:

* `paperNResidual   = N'' - 2`,
* `paperFResidual   = f²m (m f'/f²)' - m m'(m'/m - 2N'/N) f - (4m²/N - f) f - (8/3)(fm/N) T
                      + (4/3) Q² f²m²/N²`,
* `paperMResidual   = f m (N m'/m)' + (f²N/m² - 2f) m - (4/3) f T - (4/3) Q² f²m/N
                      - 4 (f²m²/N²)(J + 2Qa)²`,
* `paperConstraintResidual = m²(a')² - [f a² - m + fN/(4m) + Q² fm/N + (fm²/N²)(J + 2Qa)²
      + (N m'/8)(f'/f - 2m'/m + 4N'/N) - (N m f'/(8f))(2f'/f - m'/m + 2N'/N)]`.

They are *not* defined as combinations of the VI residuals. The theorems below prove, on any open
`I` with `f, m, N ≠ 0` (no sign, no connectedness, no conservation law), that with the pointwise
values `Q = -q(r)`, `J = -ℓ(r)/2` each actual VI residual `Generic.redE_tt/rr/uu/σσ` on the
paper-gauge dictionary is an explicit combination of the four paper residuals and conversely. -/

open scoped ContDiff Topology
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

/-- Abbreviations for the four actual VI Einstein residuals on the paper-gauge dictionary. -/
local notation "Ett" => Generic.redE_tt f (Dfun f m N) (Afun f m) (Hfun m N) w p a r
local notation "Err" => Generic.redE_rr f (Dfun f m N) (Afun f m) (Hfun m N) w p a r
local notation "Euu" => Generic.redE_uu f (Dfun f m N) (Afun f m) (Hfun m N) w p a r
local notation "Ess" => Generic.redE_σσ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r
local notation "Qr" => -qFun f N w p a r
local notation "Jr" => -ellFun f m N w p a r / 2

/-! ## Inverse identities: each VI residual from the paper residuals (pointwise `Q`, `J`) -/

/-- `redE_rr = -(4f/m²) · (Eq. 25 residual)`. -/
theorem redE_rr_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Err = -4 * f r / m r ^ 2 * paperConstraintResidual f m N a Qr Jr r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  unfold Generic.redE_rr
  rw [(hasDerivAt_Afun hP hr).deriv, (hasDerivAt_Hfun hP hr).deriv]
  simp only [paperConstraintResidual, Dfun, Afun, Hfun, qFun, ellFun, Kfun, eFun]
  field_simp
  ring

/-- `redE_uu = (2f/m) · (N'' - 2) + (4f/m²) · (Eq. 25 residual)`. -/
theorem redE_uu_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Euu = 2 * f r / m r * paperNResidual N r +
      4 * f r / m r ^ 2 * paperConstraintResidual f m N a Qr Jr r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  unfold Generic.redE_uu
  simp only [paperNResidual, paperConstraintResidual]
  simp only [(hasDerivAt_deriv_Afun hP hr).deriv, (hasDerivAt_deriv_Hfun hP hr).deriv,
    (hasDerivAt_Dfun hP hr).deriv, (hasDerivAt_Afun hP hr).deriv, (hasDerivAt_Hfun hP hr).deriv]
  simp only [Dfun, Afun, Hfun, qFun, ellFun, Kfun, eFun]
  field_simp
  ring

/-- `redE_tt = (2f/m)(N''-2) - (4N/m³)·(24a) + (2/m²)·(24b) - (12f/m²)·(25)`. -/
theorem redE_tt_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Ett = 2 * f r / m r * paperNResidual N r - 4 * N r / m r ^ 3 * paperFResidual f m N a Qr r +
      2 / m r ^ 2 * paperMResidual f m N a Qr Jr r -
      12 * f r / m r ^ 2 * paperConstraintResidual f m N a Qr Jr r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  unfold Generic.redE_tt
  simp only [paperNResidual, paperFResidual, paperMResidual, paperConstraintResidual]
  simp only [(hasDerivAt_deriv_Afun hP hr).deriv, (hasDerivAt_deriv_Hfun hP hr).deriv,
    (hasDerivAt_Dfun hP hr).deriv, (hasDerivAt_Afun hP hr).deriv, (hasDerivAt_Hfun hP hr).deriv,
    (hasDerivAt_mDf hP hr).deriv, (hasDerivAt_NDm hP hr).deriv]
  simp only [Dfun, Afun, Hfun, qFun, ellFun, Kfun, eFun]
  field_simp
  ring

/-- `redE_σσ = -(2N/m³)·(24a) + (4/m²)·(24b) - (4f/m²)·(25)`. -/
theorem redE_σσ_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    Ess = -2 * N r / m r ^ 3 * paperFResidual f m N a Qr r +
      4 / m r ^ 2 * paperMResidual f m N a Qr Jr r -
      4 * f r / m r ^ 2 * paperConstraintResidual f m N a Qr Jr r := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  unfold Generic.redE_σσ
  simp only [paperFResidual, paperMResidual, paperConstraintResidual]
  simp only [(hasDerivAt_deriv_Afun hP hr).deriv, (hasDerivAt_Dfun hP hr).deriv,
    (hasDerivAt_Afun hP hr).deriv, (hasDerivAt_mDf hP hr).deriv, (hasDerivAt_NDm hP hr).deriv]
  simp only [Dfun, Afun, Hfun, qFun, ellFun, Kfun, eFun]
  field_simp
  ring

/-! ## Forward identities: each paper residual from the VI residuals (pointwise `Q`, `J`) -/

/-- Eq. 23a: `N'' - 2 = (m/(2f)) (redE_uu + redE_rr)`; fully off shell. -/
theorem paperNResidual_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    paperNResidual N r = m r / (2 * f r) * (Euu + Err) := by
  have hf := hP.nf r hr; have hm := hP.nm r hr
  rw [redE_uu_eq hP hr, redE_rr_eq hP hr]
  field_simp
  ring

/-- Eq. 24a: residual `= (m³/(6N)) (-2 redE_tt + 7 redE_rr + 2 redE_uu + redE_σσ)`. -/
theorem paperFResidual_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    paperFResidual f m N a Qr r = m r ^ 3 / (6 * N r) * (-2 * Ett + 7 * Err + 2 * Euu + Ess) := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  rw [redE_tt_eq hP hr, redE_rr_eq hP hr, redE_uu_eq hP hr, redE_σσ_eq hP hr]
  field_simp
  ring

/-- Eq. 24b: residual `= (m²/6) (-redE_tt + 2 redE_rr + redE_uu + 2 redE_σσ)`. -/
theorem paperMResidual_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    paperMResidual f m N a Qr Jr r = m r ^ 2 / 6 * (-Ett + 2 * Err + Euu + 2 * Ess) := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  rw [redE_tt_eq hP hr, redE_rr_eq hP hr, redE_uu_eq hP hr, redE_σσ_eq hP hr]
  field_simp
  ring

/-- Eq. 25: residual `= -(m²/(4f)) redE_rr`. -/
theorem paperConstraintResidual_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    paperConstraintResidual f m N a Qr Jr r = -(m r ^ 2 / (4 * f r)) * Err := by
  have hf := hP.nf r hr; have hm := hP.nm r hr
  rw [redE_rr_eq hP hr]
  field_simp

/-! ## Local two-sided equivalence (pointwise `Q = -q(r)`, `J = -ℓ(r)/2`) -/

/-- At any `r ∈ I`: the four actual VI residuals vanish iff the four paper residuals do.
No conservation law, sign or connectedness is used; nothing is divided by `Q`, `J`, `a'`. -/
theorem einstein4_iff_paper4 (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    (Ett = 0 ∧ Err = 0 ∧ Euu = 0 ∧ Ess = 0) ↔
      (paperNResidual N r = 0 ∧ paperFResidual f m N a Qr r = 0 ∧
        paperMResidual f m N a Qr Jr r = 0 ∧ paperConstraintResidual f m N a Qr Jr r = 0) := by
  constructor
  · rintro ⟨h1, h2, h3, h4⟩
    rw [paperNResidual_eq hP hr, paperFResidual_eq hP hr, paperMResidual_eq hP hr,
      paperConstraintResidual_eq hP hr, h1, h2, h3, h4]
    norm_num
  · rintro ⟨h1, h2, h3, h4⟩
    rw [redE_tt_eq hP hr, redE_rr_eq hP hr, redE_uu_eq hP hr, redE_σσ_eq hP hr, h1, h2, h3, h4]
    norm_num

/-- The same equivalence for constants `Q`, `J` that equal `-q(r)`, `-ℓ(r)/2` at `r`. -/
theorem einstein4_iff_paper4_of_eq (hP : PaperData I f m N w p a) (hr : r ∈ I) {Q J : ℝ}
    (hq : qFun f N w p a r = -Q) (hl : ellFun f m N w p a r = -2 * J) :
    (Ett = 0 ∧ Err = 0 ∧ Euu = 0 ∧ Ess = 0) ↔
      (paperNResidual N r = 0 ∧ paperFResidual f m N a Q r = 0 ∧
        paperMResidual f m N a Q J r = 0 ∧ paperConstraintResidual f m N a Q J r = 0) := by
  have hQ : -qFun f N w p a r = Q := by rw [hq, neg_neg]
  have hJ : -ellFun f m N w p a r / 2 = J := by rw [hl]; ring
  rw [einstein4_iff_paper4 hP hr, hQ, hJ]

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
end R05Seg6

