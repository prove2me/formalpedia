-- title:
--   Ex ante payoff table of a pricing-equilibrium family, §4.2
-- statement:
--   A **pricing family** $E$ assigns to every status profile $X$ a pricing profile $(\rho_X, f_X)$; it is a pricing-equilibrium family when each $(\rho_X, f_X)$ is a pricing equilibrium for $X$. Its **payoff table** lists, for each $X$, the ex ante profits before any side payment: $M(X, i)$ for manufacturer $i$ and $R(X)$ for the retailer. In the paper's notation, $\pi_M(0) = M(UU, i)$, $\pi_M(2) = M(II, i)$, $\pi_M^I(1)$ and $\pi_M^U(1)$ are the informed and the uninformed manufacturer's profits when $n = 1$, and $\pi_R(n) = R(X)$ for a profile with $n$ informed manufacturers.
--
--   A status profile $X$ is a **no-contracting outcome** (§5.1) if the retailer, choosing the statuses for free, cannot do better: $R(X') \le R(X)$ for every $X'$.
--
--   The contracting games of §5 take this table as input.
--
--   This is a shared definition of the series, reviewed once for both missions: `01-diseconomy-sequential` (production diseconomy, §5; Shang, Ha & Tong 2016, p. 252, §4.2 and §5.1) and `02-economy-sequential` (production economy, §6; p. 252, §4.2 and p. 255, §6.1). The cost parameter $c$ is a plain real; the missions differ only in the hypotheses their theorems put on it: $c > 0$ in the first, $c = -c_e$ with $0 < c_e < 2/(1+\phi)$ in the second.
-- source:
--   Shang, Ha & Tong, Information Sharing in a Supply Chain with a Common Retailer, Management Sci. 62(1) 2016, p. 252, §4.2; p. 252, §5.1; p. 255, §6.1

import Mathlib
import Definitions.Def_InfoSharing_Shared_IsPricingEq
open MeasureTheory

namespace InfoSharing.Shared

/-- A strategy profile of the pricing stage: the retailer's rule `ρ` and the manufacturers'
wholesale strategies `f`. -/
structure PricingProfile where
  ρ : (Fin 2 → ℝ) → ℝ → (Fin 2 → ℝ)
  f : Fin 2 → ℝ → ℝ

/-- A pricing family assigns a pricing equilibrium to every information-status profile. -/
def IsPricingEqFamily {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (θ Y : Ω → ℝ)
    (a b c φ β : ℝ) (E : (Fin 2 → Status) → PricingProfile) : Prop :=
  ∀ X, IsPricingEq μ θ Y a b c φ β X (E X).ρ (E X).f

/-- The table of ex ante profits before side payments (§4.2, p. 252): `M X i` is manufacturer
`i`'s profit and `R X` the retailer's under the status profile `X`. -/
structure PayoffTable where
  M : (Fin 2 → Status) → Fin 2 → ℝ
  R : (Fin 2 → Status) → ℝ

/-- The payoff table generated by a pricing family `E`: the ex ante profits of the pricing
equilibrium `E X` for each status profile `X`. -/
noncomputable def payoffTable {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) (θ Y : Ω → ℝ)
    (a b c φ : ℝ) (E : (Fin 2 → Status) → PricingProfile) : PayoffTable where
  M X i := manufacturerProfit μ θ Y a b c φ (E X).ρ (E X).f i
  R X := retailerProfit μ θ Y a φ (E X).ρ (E X).f

/-- Information sharing without side payment (§5.1, p. 252; §6.1, p. 255): the retailer freely chooses the
status profile, so an outcome maximizes her ex ante profit. -/
def IsNoContractOutcome (P : PayoffTable) (X : Fin 2 → Status) : Prop :=
  ∀ X', P.R X' ≤ P.R X

end InfoSharing.Shared


