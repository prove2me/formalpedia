theorem rev_getD (f : ℕ → ℤ) {n i : ℕ} (hi : i < n) :
    (((List.range n).map f).reverse).getD (n - 1 - i) 0 = f i := by
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_reverse]
  simp only [List.getElem_map, List.getElem_range, List.length_map, List.length_range]
  congr 1; omega

theorem rev_mem_bnd {f : ℕ → ℤ} {n : ℕ} {V : ℤ} (h : ∀ i < n, |f i| ≤ V) :
    ∀ x ∈ ((List.range n).map f).reverse, |x| ≤ V := by
  intro x hx
  simp only [List.mem_reverse, List.mem_map, List.mem_range] at hx
  obtain ⟨i, hi, rfl⟩ := hx
  exact h i hi

