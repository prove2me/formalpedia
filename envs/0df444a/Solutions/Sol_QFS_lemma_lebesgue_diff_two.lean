/-- **Lemma A.2 for functions of a pair.** For a locally integrable `Φ` on
`ℝ^d × ℝ^d` and almost every pair `p`, the averages of `Φ` over any shrinking
sequence of product cubes containing `p` converge to `Φ p`. -/
theorem solution
    {Φ : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) → ℝ}
    (hΦ : LocallyIntegrable Φ volume) :
    ∀ᵐ p : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d),
      ∀ {ι : Type} {l : Filter ι} (hn : ι → ℝ)
        (un : ι → EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d)),
        (∀ i, 0 < hn i) → Tendsto hn l (𝓝 0) → (∀ i, p ∈ closedCube_two (hn i) (un i)) →
        Tendsto (fun i => ⨍ q in closedCube_two (hn i) (un i), Φ q) l (𝓝 (Φ p)) := by
  filter_upwards [(cubeVitali_two d).ae_tendsto_average hΦ] with p hp ι l hn un hpos hlim hmem
  exact hp.comp (QFS.tendsto_closedCube₂_filterAt hn un hpos hlim hmem)
