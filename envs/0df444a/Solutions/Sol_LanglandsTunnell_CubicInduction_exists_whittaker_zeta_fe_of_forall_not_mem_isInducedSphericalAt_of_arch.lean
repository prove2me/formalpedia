private theorem dualForm_globalPointsGL_mul {Φ : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ}
    (haut : ∀ (γ : GL (Fin 3) ℚ) (g : AdelicGL 3 (𝓞 ℚ) ℚ), Φ (globalPointsGL 3 (𝓞 ℚ) ℚ γ * g) = Φ g)
    (γ : GL (Fin 3) ℚ) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    dualForm Φ (globalPointsGL 3 (𝓞 ℚ) ℚ γ * g) = dualForm Φ g := by
  show Φ (transposeInv3 (globalPointsGL 3 (𝓞 ℚ) ℚ γ * g)) = Φ (transposeInv3 g)
  calc Φ (transposeInv3 (globalPointsGL 3 (𝓞 ℚ) ℚ γ * g))
      = Φ (transposeInv3 (globalPointsGL 3 (𝓞 ℚ) ℚ γ) * transposeInv3 g) :=
        congrArg Φ (transposeInv3_mul (globalPointsGL 3 (𝓞 ℚ) ℚ γ) g)
    _ = Φ (globalPointsGL 3 (𝓞 ℚ) ℚ (transposeInv3 γ) * transposeInv3 g) :=
        congrArg (fun x => Φ (x * transposeInv3 g)) (map_transposeInv3 (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)) γ).symm
    _ = Φ (transposeInv3 g) := haut _ _

