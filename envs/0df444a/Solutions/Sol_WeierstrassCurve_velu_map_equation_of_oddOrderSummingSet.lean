private def _root_.WeierstrassCurve.veluDeficitCrossQuadBetaSq (S : Finset (F × F)) (r s : F) : F :=
  (W.veluY S r s - s) ^ 2 - ∑ A ∈ S, (W.veluY {A} r s - s) ^ 2

