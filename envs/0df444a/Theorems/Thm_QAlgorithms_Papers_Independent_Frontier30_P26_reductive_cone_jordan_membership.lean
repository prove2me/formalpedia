section LieGeometry

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 3.11, PDF p. 10. The redundant introductory x∈W is removed in accordance with both proof directions. -/
theorem reductive_cone_jordan_membership [LieAlgebra.HasCentralRadical ℝ G]
    (W : Set G) (hc : ClosedCone W) (hi : Invariant W) (x0 xs xn : G)
    (hz : x0 ∈ LieAlgebra.center ℝ G) (hs : xs ∈ LieAlgebra.derivedSeries ℝ G 1)
    (hn : xn ∈ LieAlgebra.derivedSeries ℝ G 1) (hj : JordanPair xs xn) :
    x0 + xs + xn ∈ W ↔ x0 + xs ∈ W ∧ xn ∈ W := by sorry

end LieGeometry

end

