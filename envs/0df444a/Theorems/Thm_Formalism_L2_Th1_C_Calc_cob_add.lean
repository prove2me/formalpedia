variable {K : Type} [Field K] [CharZero K] {O : Type} [CommRing O] [StarRing O]
variable {R : Subring K} {l linv : PowerSeries K} {τ : O →+* K}

theorem Formalism.L2.Th1.C.Calc.cob_add (D : Data R l linv τ) {ph : PowerSeries K} (hF1 : F1 R l linv ph) {σ : Type}
    (a a' b : ptsSub D σ) :
    cob (phi D ph) (a + a') b = cob (phi D ph) a b + cob (phi D ph) a' b := by sorry
