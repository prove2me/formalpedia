private noncomputable def d035 (S : Finset (HeightOneSpectrum (𝓞 K))) (p : ↥(torusClass (K := K) S) × ℝ)
    (β : {β : Kˣ // IsSUnit K S β}) : (AdeleRing (𝓞 K) K)ˣ :=
  Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β.1
    * ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K p.2

private theorem t0320 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℝ≥0∞)
    (p : ↥(torusClass (K := K) S) × ℝ) : d026 S F p = ∑' β : {β : Kˣ // IsSUnit K S β}, F (d035 S p β) := rfl

private noncomputable def d036 (S : Finset (HeightOneSpectrum (𝓞 K))) (f : (AdeleRing (𝓞 K) K)ˣ → ℝ)
    (p : ↥(torusClass (K := K) S) × ℝ) : ℝ≥0∞ :=
  d026 S (fun z => ENNReal.ofReal (max (f z) 0)) p

private theorem t0321 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) : Measurable (d036 S f) :=
  measurable_of_Ioi fun y => ((t0297 S
    (ENNReal.continuous_ofReal.comp (hf.max continuous_const)).lowerSemicontinuous).isOpen_preimage y).measurableSet

private theorem t0322 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) :
    ∫⁻ p, d036 S f p ∂(d012 S)
      = d034 S * ∫⁻ y in d020 S, ENNReal.ofReal (max (f y) 0) ∂(NumberField.Idele.idelicHaar K) :=
  t0319 S (ENNReal.continuous_ofReal.comp (hf.max continuous_const)).lowerSemicontinuous

private theorem t0323 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hfi : IntegrableOn f (d020 S) (NumberField.Idele.idelicHaar K)) :
    ∫⁻ y in d020 S, ENNReal.ofReal (max (f y) 0) ∂(NumberField.Idele.idelicHaar K) ≠ ⊤ := by
  refine ne_of_lt (lt_of_le_of_lt (lintegral_mono fun y => ?_) hfi.2)
  rw [← ofReal_norm, Real.norm_eq_abs]
  exact ENNReal.ofReal_le_ofReal (max_le (le_abs_self _) (abs_nonneg _))

private theorem t0324 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) (hfi : IntegrableOn f (d020 S) (NumberField.Idele.idelicHaar K)) :
    ∫⁻ p, d036 S f p ∂(d012 S) ≠ ⊤ := by
  rw [t0322 S hf]
  exact ENNReal.mul_ne_top (t0318 S) (t0323 S hfi)

private theorem t0325 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) (hfi : IntegrableOn f (d020 S) (NumberField.Idele.idelicHaar K)) :
    ∀ᵐ p ∂(d012 S), d036 S f p < ⊤ :=
  ae_lt_top' (t0321 S hf).aemeasurable (t0324 S hf hfi)

private theorem t0326 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) (hfi : IntegrableOn f (d020 S) (NumberField.Idele.idelicHaar K)) :
    Integrable (fun p => (d036 S f p).toReal) (d012 S) :=
  integrable_toReal_of_lintegral_ne_top (t0321 S hf).aemeasurable
    (t0324 S hf hfi)

private theorem t0327 (S : Finset (HeightOneSpectrum (𝓞 K))) {f : (AdeleRing (𝓞 K) K)ˣ → ℝ}
    (hf : Continuous f) (hfi : IntegrableOn f (d020 S) (NumberField.Idele.idelicHaar K)) :
    ∫ p, (d036 S f p).toReal ∂(d012 S)
      = (d034 S).toReal * ∫ y in d020 S, max (f y) 0 ∂(NumberField.Idele.idelicHaar K) := by
  rw [integral_toReal (t0321 S hf).aemeasurable (t0325 S hf hfi),
    t0322 S hf, ENNReal.toReal_mul,
    integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall fun y => le_max_right (f y) 0)
      (hf.max continuous_const).aestronglyMeasurable]

private theorem t0328 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (f : (AdeleRing (𝓞 K) K)ˣ → ℝ) {p : ↥(torusClass (K := K) S) × ℝ} (hp : d036 S f p ≠ ⊤) :
    HasSum (fun β : {β : Kˣ // IsSUnit K S β} => max (f (d035 S p β)) 0) (d036 S f p).toReal := by
  have hsum : Summable fun β : {β : Kˣ // IsSUnit K S β} => max (f (d035 S p β)) 0 := by
    rw [d036, t0320] at hp
    exact (ENNReal.summable_toReal hp).congr fun β => ENNReal.toReal_ofReal (le_max_right _ _)
  have hval : (d036 S f p).toReal = ∑' β : {β : Kˣ // IsSUnit K S β}, max (f (d035 S p β)) 0 := by
    rw [d036, t0320, ENNReal.tsum_toReal_eq fun _ => ENNReal.ofReal_ne_top]
    exact tsum_congr fun β => ENNReal.toReal_ofReal (le_max_right _ _)
  rw [hval]
  exact hsum.hasSum

private theorem t0329 (a : ℝ) : max a 0 - max (-a) 0 = a := by
  rcases le_total 0 a with h | h
  · rw [max_eq_left h, max_eq_right (neg_nonpos.2 h), sub_zero]
  · rw [max_eq_right h, max_eq_left (neg_nonneg.2 h), zero_sub, neg_neg]

private theorem t0330 (w : ℂ) :
    w = ((max w.re 0 - max (-w.re) 0 : ℝ) : ℂ) + ((max w.im 0 - max (-w.im) 0 : ℝ) : ℂ) * Complex.I := by
  rw [t0329, t0329, Complex.re_add_im]

private noncomputable def d037 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℂ)
    (p : ↥(torusClass (K := K) S) × ℝ) : ℂ :=
  (((d036 S (fun z => (F z).re) p).toReal - (d036 S (fun z => -(F z).re) p).toReal : ℝ) : ℂ)
    + (((d036 S (fun z => (F z).im) p).toReal - (d036 S (fun z => -(F z).im) p).toReal : ℝ) : ℂ)
      * Complex.I

private theorem t0331 (S : Finset (HeightOneSpectrum (𝓞 K))) (F : (AdeleRing (𝓞 K) K)ˣ → ℂ)
    {p : ↥(torusClass (K := K) S) × ℝ} (h₁ : d036 S (fun z => (F z).re) p ≠ ⊤)
    (h₂ : d036 S (fun z => -(F z).re) p ≠ ⊤) (h₃ : d036 S (fun z => (F z).im) p ≠ ⊤)
    (h₄ : d036 S (fun z => -(F z).im) p ≠ ⊤) :
    HasSum (fun β : {β : Kˣ // IsSUnit K S β} => F (d035 S p β)) (d037 S F p) := by
  have hre := (t0328 S _ h₁).sub (t0328 S _ h₂)
  have him := (t0328 S _ h₃).sub (t0328 S _ h₄)
  have h := (Complex.hasSum_ofReal.2 hre).add ((Complex.hasSum_ofReal.2 him).mul_right Complex.I)
  have hfun : (fun β : {β : Kˣ // IsSUnit K S β} => F (d035 S p β))
      = fun β => ((max (F (d035 S p β)).re 0 - max (-(F (d035 S p β)).re) 0 : ℝ) : ℂ)
          + ((max (F (d035 S p β)).im 0 - max (-(F (d035 S p β)).im) 0 : ℝ) : ℂ) * Complex.I :=
    funext fun β => t0330 (F (d035 S p β))
  rw [hfun]
  exact h

private theorem t0332 (S : Finset (HeightOneSpectrum (𝓞 K))) {F : (AdeleRing (𝓞 K) K)ˣ → ℂ}
    (hF : Continuous F) (hFi : IntegrableOn F (d020 S) (NumberField.Idele.idelicHaar K)) :
    (Continuous fun z => (F z).re) ∧ (Continuous fun z => -(F z).re) ∧ (Continuous fun z => (F z).im)
        ∧ (Continuous fun z => -(F z).im)
      ∧ IntegrableOn (fun z => (F z).re) (d020 S) (NumberField.Idele.idelicHaar K)
      ∧ IntegrableOn (fun z => -(F z).re) (d020 S) (NumberField.Idele.idelicHaar K)
      ∧ IntegrableOn (fun z => (F z).im) (d020 S) (NumberField.Idele.idelicHaar K)
      ∧ IntegrableOn (fun z => -(F z).im) (d020 S) (NumberField.Idele.idelicHaar K) := by
  have hre : IntegrableOn (fun z => (F z).re) (d020 S) (NumberField.Idele.idelicHaar K) := hFi.re
  have him : IntegrableOn (fun z => (F z).im) (d020 S) (NumberField.Idele.idelicHaar K) := hFi.im
  exact ⟨Complex.continuous_re.comp hF, (Complex.continuous_re.comp hF).neg, Complex.continuous_im.comp hF,
    (Complex.continuous_im.comp hF).neg, hre, hre.neg, him, him.neg⟩

private theorem t0333 (S : Finset (HeightOneSpectrum (𝓞 K))) {F : (AdeleRing (𝓞 K) K)ˣ → ℂ}
    (hF : Continuous F) (hFi : IntegrableOn F (d020 S) (NumberField.Idele.idelicHaar K)) :
    Integrable (fun p : ↥(torusClass (K := K) S) × ℝ => ∑' β : {β : Kˣ // IsSUnit K S β},
        F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β.1
          * ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K p.2))
        (d012 S)
      ∧ ∫ p, (∑' β : {β : Kˣ // IsSUnit K S β},
          F (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) β.1
            * ((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) * Ideles.archScale K p.2))
          ∂(d012 S)
        = ((d034 S).toReal : ℂ) * ∫ y in d020 S, F y ∂(NumberField.Idele.idelicHaar K) := by
  obtain ⟨hc₁, hc₂, hc₃, hc₄, hi₁, hi₂, hi₃, hi₄⟩ := t0332 S hF hFi

  have hae : (fun p : ↥(torusClass (K := K) S) × ℝ => ∑' β : {β : Kˣ // IsSUnit K S β}, F (d035 S p β))
      =ᵐ[d012 S] d037 S F := by
    filter_upwards [t0325 S hc₁ hi₁, t0325 S hc₂ hi₂,
      t0325 S hc₃ hi₃, t0325 S hc₄ hi₄] with p hp₁ hp₂ hp₃ hp₄
    exact (t0331 S F hp₁.ne hp₂.ne hp₃.ne hp₄.ne).tsum_eq

  have hT₁ := t0326 S hc₁ hi₁
  have hT₂ := t0326 S hc₂ hi₂
  have hT₃ := t0326 S hc₃ hi₃
  have hT₄ := t0326 S hc₄ hi₄
  have hTre : Integrable (fun p => (((d036 S (fun z => (F z).re) p).toReal
      - (d036 S (fun z => -(F z).re) p).toReal : ℝ) : ℂ)) (d012 S) := (hT₁.sub' hT₂).ofReal
  have hTim : Integrable (fun p => (((d036 S (fun z => (F z).im) p).toReal
      - (d036 S (fun z => -(F z).im) p).toReal : ℝ) : ℂ) * Complex.I) (d012 S) :=
    (hT₃.sub' hT₄).ofReal.mul_const Complex.I
  have hint : Integrable (d037 S F) (d012 S) := hTre.add hTim

  have hP₁ := hi₁.pos_part
  have hP₂ := hi₂.pos_part
  have hP₃ := hi₃.pos_part
  have hP₄ := hi₄.pos_part
  have hCre : Integrable (fun y => ((max (F y).re 0 - max (-(F y).re) 0 : ℝ) : ℂ))
      ((NumberField.Idele.idelicHaar K).restrict (d020 S)) := (hP₁.sub' hP₂).ofReal
  have hCim : Integrable (fun y => ((max (F y).im 0 - max (-(F y).im) 0 : ℝ) : ℂ) * Complex.I)
      ((NumberField.Idele.idelicHaar K).restrict (d020 S)) := (hP₃.sub' hP₄).ofReal.mul_const Complex.I
  have hcut : ∫ y in d020 S, F y ∂(NumberField.Idele.idelicHaar K)
      = (((∫ y in d020 S, max (F y).re 0 ∂(NumberField.Idele.idelicHaar K))
            - ∫ y in d020 S, max (-(F y).re) 0 ∂(NumberField.Idele.idelicHaar K) : ℝ) : ℂ)
        + (((∫ y in d020 S, max (F y).im 0 ∂(NumberField.Idele.idelicHaar K))
            - ∫ y in d020 S, max (-(F y).im) 0 ∂(NumberField.Idele.idelicHaar K) : ℝ) : ℂ) * Complex.I := by
    rw [integral_congr_ae (Filter.Eventually.of_forall fun y => t0330 (F y)), integral_add hCre hCim,
      integral_mul_const, integral_complex_ofReal, integral_complex_ofReal, integral_sub hP₁ hP₂, integral_sub hP₃ hP₄]
  refine ⟨hint.congr hae.symm, ?_⟩
  show ∫ p, (∑' β : {β : Kˣ // IsSUnit K S β}, F (d035 S p β)) ∂(d012 S) = _
  rw [integral_congr_ae hae, hcut]
  unfold d037
  rw [integral_add hTre hTim, integral_mul_const, integral_complex_ofReal, integral_complex_ofReal,
    integral_sub hT₁ hT₂, integral_sub hT₃ hT₄, t0327 S hc₁ hi₁,
    t0327 S hc₂ hi₂,
    t0327 S hc₃ hi₃, t0327 S hc₄ hi₄]
  push_cast
  ring

