variable {n : ℕ}

theorem GlobalTheory.CompanionTheory.GamDomProof.card_fst (ε : Fin n → Bool) (a : Fin n) :
    ((A1 ε).filter fun i => i.1.1 = a).card =
      if ε a = true then (univ.filter fun b => b < a ∧ ε b ≠ ε a).card else 0 := by sorry
