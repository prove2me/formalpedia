set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-! ## Stage facts -/

section Lab

variable {ch : Ch} {N : ℕ} (h : EOK ch N)
include h

/-! ## Block two -/

omit h in
theorem cw_lt {s j : ℕ} (hs : s < 1771) : cw s j < 45413 := by
  unfold cw wU; simp only [wY, wX, Nat.add_eq]; split_ifs <;> omega

omit h in
theorem cw_inj {s s' j j' : ℕ} (hs : s < 1771) (hs' : s' < 1771) (hj : j < 3) (hj' : j' < 3)
    (e : cw s j = cw s' j') : s = s' ∧ j = j' := by
  unfold cw wU at e; simp only [wY, wX, Nat.add_eq] at e; split_ifs at e <;> omega

omit h in
theorem cw0 (s : ℕ) : cw s 0 = wU s := rfl
omit h in
theorem cw1 (s : ℕ) : cw s 1 = wY s := rfl
omit h in
theorem cw2 (s : ℕ) : cw s 2 = wX s := rfl

omit h in
theorem nUY {a s : ℕ} (ha : a < 1771) (hs : s < 1771) : ι2 a (wU s) ≠ ι2 a (wY s) := by
  intro e
  have := (ι2_inj ha ha (by simp only [wU]; omega) (by simp only [wY, Nat.add_eq]; omega) e).2
  simp only [wU, wY, Nat.add_eq] at this; omega

omit h in
theorem nUX {a s : ℕ} (ha : a < 1771) (hs : s < 1771) : ι2 a (wU s) ≠ ι2 a (wX s) := by
  intro e
  have := (ι2_inj ha ha (by simp only [wU]; omega) (by simp only [wX]; omega) e).2
  simp only [wU, wX] at this; omega

