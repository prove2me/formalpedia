import Definitions.Def_GaussianLattice
set_option autoImplicit true
open GaussianParity

theorem GaussianParity.even_binary_conversion (q : Nat) (z : GInt) :
    repeatPi (2*q) (repeatNegI q z) = scale ((2 : Int)^q) z := by sorry
