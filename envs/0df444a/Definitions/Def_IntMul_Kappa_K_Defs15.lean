-- Source module: Solutions.KFGPair
/-!
# KFG: a pointwise `2 × 2` scaled operation on two arbitrary role streams

On the data stack `pre ++ u ++ gap ++ v ++ rest` (Gaussian streams, `|u| = |v| = L`),
`pairP M` replaces `(u, v)` by `(M₀₀ u + M₀₁ v, M₁₀ u + M₁₁ v)` entrywise, with scaled
coefficients `c · 2^d`.  The prefix and the gap are parked on `qP`, `qQ`; the two streams are
distributed to the four register stacks and zipped (`zipRS`); the outputs are moved back.  Every
entry is touched `O(1)` times; the loop counters are unary (`fcode`).

* `pairP_fsp`: the program with its counts in registers (`rB = L`, `rB2 = 2L`, `rP = 2|pre|`,
  `rQ = 2|gap|`).
* `pairW M L i j`: the self-contained wrapper on roles `i < j` of a role-major array with role
  length `L` (`pairW_fsp`, list semantics `pairL`, `getD_pairL`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFG

open IntMul RS AModel KIL KFD KFB Complex

abbrev qQ : Fin HS := 41
abbrev rQ : Fin HS := 54

/-- The pair pass (counts in registers). -/
def pairP (M : M2S) : RS :=
  .seq (NLogN.mvK 0 qP NLogN.KFB.c1 (.reg NLogN.KFB.rP)) (.seq (NLogN.mvK 0 qT NLogN.KFB.c1 (.reg rB2)) (.seq (distB rUr rUi)
  (.seq (NLogN.mvK 0 qQ NLogN.KFB.c1 (.reg rQ)) (.seq (NLogN.mvK 0 qT NLogN.KFB.c1 (.reg rB2)) (.seq (distB rVr rVi)
  (.seq (zipRS M) (.seq (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg rB2)) (.seq (NLogN.mvK qQ 0 NLogN.KFB.c1 (.reg rQ))
  (.seq (NLogN.mvK qA 0 NLogN.KFB.c1 (.reg rB2)) (NLogN.mvK qP 0 NLogN.KFB.c1 (.reg NLogN.KFB.rP)))))))))))

/-- Cost of the pair pass. -/
def cPair (w D L P Q : ℕ) : ℕ :=
  4 * (P + Q) * (250 * w + 2600) +
    L * (cZS w D + 2 * cD w + 8 * (250 * (w + D + 2) + 2600) + 10000) + 30000

/-- The registers of the pair pass hold the counts. -/
structure PCnt (s : IState HS) (f : Fin HS → List ℤ) (L P Q : ℕ) : Prop where
  b : ∃ R, (encK s f).G NLogN.KFB.rB = .int (L : ℤ) :: R
  b2 : ∃ R, (encK s f).G rB2 = .int ((2 * L : ℕ) : ℤ) :: R
  p : ∃ R, (encK s f).G NLogN.KFB.rP = .int ((2 * P : ℕ) : ℤ) :: R
  q : ∃ R, (encK s f).G rQ = .int ((2 * Q : ℕ) : ℤ) :: R

end NLogN.KFG

end

