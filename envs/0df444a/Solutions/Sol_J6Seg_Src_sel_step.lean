open J6Seg.Slab (srcTab)

/-! ## Rebasing -/

/-! ## The table loop -/

theorem tlT_pred {src : ℕ → Option ℕ} {argOf : ℕ → ℤ} {n' j : ℕ} (hj : j < n') :
    tlT src argOf n' j = J6Seg.Slab.code (src j) :: argOf j :: tlT src argOf n' (j + 1) := by
  simp [tlT, drp_pred hj]

/-! ## Pass 1 -/

theorem selE_regs (iS iT : Fin HS) : ∀ r ∈ (selE iS iT).regs, r = iS ∨ r = iT ∨ r = 43 := by
  intro r hr
  simp only [selE, rrE, jB, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, List.append_nil] at hr
  repeat' rcases hr with hr | hr
  all_goals simp

theorem selE_poly (iS iT : Fin HS) : PreT.Poly (selE iS iT) = true ∧
    J6Seg.PreT.dg (selE iS iT) ≤ DD ∧ (selE iS iT).size ≤ 25 := by
  refine ⟨?_, ?_, ?_⟩
  · simp +decide [selE, rrE, jB, J6Seg.PreT.Poly]
  · simp +decide [selE, rrE, jB, J6Seg.PreT.dg]
  · simp +decide [selE, rrE, jB, Ex.size]

theorem sel_step_sol_aux (s0 : IState HS) (G : Fin HS → List ℤ) {iS iT iK : Fin HS} (fS : Free iS)
    (fT : Free iT) (fK : Free iK) {s t A : ℕ} {K : ℤ} {LS LT LK : List ℤ}
    (hGS : G iS = (s : ℤ) :: LS) (hGT : G iT = (t : ℤ) :: LT) (hGK : G iK = K :: LK)
    (hs : 0 < s) (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A) (hKA : |K| ≤ 2 ^ A) (hA : 2 ≤ A)
    {n' j : ℕ} (hj : j < n') (hjA : j + 1 ≤ 2 ^ A) :
    Sp (selB iS iT iK)
      (encK s0 (tbS G [(j : ℤ) + 1] (tlT (J6Seg.selSrc s t) (fun _ => K) n' (j + 1) ++ G 44)))
      (encK s0 (tbS G [(j : ℤ) + 1] (tlT (J6Seg.selSrc s t) (fun _ => K) n' j ++ G 44)))
      (30 * uC A DD) := by
