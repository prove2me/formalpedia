/-!
# B3 (chunk kernel), part 1: the Gaussian stages as list maps

The chunk kernel on a Gaussian row is `liftG (chunkK q)`. Here it is rewritten in the form the
IL computes:

* `liftG_comp`, `liftG_append`: `liftG` commutes with composition / concatenation of
  length-preserving maps;
* `dgG c z`: the diagonal stage on pairs (`liftG (dgL P c) = dgG P c`);
* **`kmulD_toep`**: the zero-padded Kronecker record product with `Δ = 0` gives the exact
  lower-triangular Toeplitz sums `convL` of both parts (`2 n ≤ r + 1`);
* `lwG`, `upG`: the Toeplitz stages on pairs from `kmulD` (`liftG (lwL P c) = lwG`, …);
* `blkG`, `chunkG`: the block solve and the chunk kernel on pairs (`liftG (chunkL …) = chunkG …`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg

open IntMul NLogN NLogN.KFV

/-! ## `liftG` algebra -/

/-! ## The diagonal stage -/

section stages
variable (P : ℕ)

/-! ## Toeplitz sums by one record product -/

lemma reF_padG (r : ℕ) (z : List (ℤ × ℤ)) (i : ℕ) :
    reF (padG r z) i = if i < z.length then (z.getD i (0, 0)).1 else 0 := by
  unfold reF padG
  split_ifs with h
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_left h, ← List.getD_eq_getElem?_getD]; rfl
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega)]
    simp only [List.getElem?_replicate]
    split_ifs <;> rfl

lemma imF_padG (r : ℕ) (z : List (ℤ × ℤ)) (i : ℕ) :
    imF (padG r z) i = if i < z.length then (z.getD i (0, 0)).2 else 0 := by
  unfold imF padG
  split_ifs with h
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_left h, ← List.getD_eq_getElem?_getD]; rfl
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega)]
    simp only [List.getElem?_replicate]
    split_ifs <;> rfl

lemma reF_realG (r n : ℕ) (c : List ℤ) (hc : n ≤ c.length) (i : ℕ) :
    reF (realG r n c) i = if i < n then c.getD i 0 else 0 := by
  unfold reF realG
  have hl : ((c.take n).map fun a => (a, (0 : ℤ))).length = n := by simp; omega
  split_ifs with h
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by rw [hl]; exact h),
      List.getElem?_map, List.getElem?_take, if_pos h, List.getD_eq_getElem?_getD]
    generalize (getElem? c i) = o; cases o <;> rfl
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by rw [hl]; omega)]
    simp only [List.getElem?_replicate]
    split_ifs <;> rfl

lemma imF_realG (r n : ℕ) (c : List ℤ) (hc : n ≤ c.length) (i : ℕ) : imF (realG r n c) i = 0 := by
  unfold imF realG
  have hl : ((c.take n).map fun a => (a, (0 : ℤ))).length = n := by simp; omega
  by_cases h : i < n
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by rw [hl]; exact h),
      List.getElem?_map, List.getElem?_take, if_pos h]
    generalize (getElem? c i) = o; cases o <;> rfl
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by rw [hl]; omega)]
    simp only [List.getElem?_replicate]
    split_ifs <;> rfl

/-- `cnv` of an `n`-supported sequence with an `n`-supported table. -/
lemma cnv_supp {r n : ℕ} {a c : ℕ → ℤ} (ha : ∀ i, n ≤ i → a i = 0) (hc : ∀ k, n ≤ k → c k = 0)
    (hr : n ≤ r) (j : ℕ) :
    Synth.cnv r a c j = ∑ k ∈ range (min (j + 1) n), c (j - k) * a k := by
  unfold Synth.cnv
  rw [sum_congr rfl fun i _ => Synth.inner_eq r i j (fun k => a i * c k)]
  have e1 : ∀ i ∈ range r, (if i ≤ j ∧ j - i < r then a i * c (j - i) else 0) =
      if i < min (j + 1) n then c (j - i) * a i else 0 := by
    intro i hi
    rw [mem_range] at hi
    by_cases h1 : i < n
    · by_cases h2 : i ≤ j
      · by_cases h3 : j - i < r
        · rw [if_pos ⟨h2, h3⟩, if_pos (by omega)]; ring
        · rw [if_neg (by tauto), if_pos (by omega), hc (j - i) (by omega), zero_mul]
      · rw [if_neg (by tauto), if_neg (by omega)]
    · rw [ha i (by omega), zero_mul, if_neg (show ¬ (i < min (j + 1) n) by omega), ite_self]
  rw [sum_congr rfl e1, ← sum_filter]
  apply sum_congr _ (fun _ _ => rfl)
  ext i; simp only [mem_filter, mem_range]; omega

/-- **The zero-padded record product with `Δ = 0` gives the Toeplitz sums.** -/
theorem kmulD_toep_sol_aux {r : ℕ} (c : List ℤ) (z : List (ℤ × ℤ)) (hc : z.length ≤ c.length)
    (hr : 2 * z.length ≤ r + 1) {j : ℕ} (hj : j < z.length) :
    (kmulD r 0 (padG r z) (realG r z.length c)).getD j (0, 0) =
      ((convL c (z.map Prod.fst)).getD j 0, (convL c (z.map Prod.snd)).getD j 0) := by
  set n := z.length with hn
  have hnr : n ≤ r := by omega
  have hjr : j < r := by omega
  have haR : ∀ i, n ≤ i → reF (padG r z) i = 0 := fun i hi => by rw [reF_padG, if_neg (by omega)]
  have haI : ∀ i, n ≤ i → imF (padG r z) i = 0 := fun i hi => by rw [imF_padG, if_neg (by omega)]
  have hcR : ∀ k, n ≤ k → reF (realG r n c) k = 0 := fun k hk => by
    rw [reF_realG r n c hc, if_neg (by omega)]
  have hcI : ∀ k, imF (realG r n c) k = 0 := fun k => imF_realG r n c hc k
  have cnvI : ∀ a : ℕ → ℤ, ∀ m, Synth.cnv r a (imF (realG r n c)) m = 0 := by
    intro a m; unfold Synth.cnv; simp [hcI]
  -- the high halves vanish
  have hi0 : ∀ (a : ℕ → ℤ), (∀ i, n ≤ i → a i = 0) →
      Synth.cnv r a (reF (realG r n c)) (j + r) = 0 := by
    intro a ha
    rw [cnv_supp ha hcR hnr]
    apply sum_eq_zero
    intro k hk
    rw [mem_range] at hk
    rw [hcR _ (by omega), zero_mul]
  -- the low halves are the Toeplitz sums
  have hlo : ∀ (a : ℕ → ℤ) (x : List ℤ), x.length = n → (∀ i, a i = if i < n then x.getD i 0 else 0) →
      Synth.cnv r a (reF (realG r n c)) j = (convL c x).getD j 0 := by
    intro a x hx ha
    rw [cnv_supp (fun i hi => by rw [ha, if_neg (by omega)]) hcR hnr]
    unfold convL
    rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range,
      Nat.min_eq_left (by omega)]
    refine sum_congr rfl fun k hk => ?_
    rw [mem_range] at hk
    rw [reF_realG r n c hc, if_pos (by omega), ha, if_pos (by omega)]
  have hxR : ∀ i, reF (padG r z) i = if i < n then (z.map Prod.fst).getD i 0 else 0 := by
    intro i; rw [reF_padG]
    split_ifs with h
    · rw [getD_fst]
    · rfl
  have hxI : ∀ i, imF (padG r z) i = if i < n then (z.map Prod.snd).getD i 0 else 0 := by
    intro i; rw [imF_padG]
    split_ifs with h
    · rw [getD_snd]
    · rfl
  unfold kmulD
  rw [← default_GI, getD_zip_of_lt (by simp; omega) (by simp; omega)]
  rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range,
    List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map, List.getElem_range]
  unfold fdt hRe hIm
  simp only [cnvI, sub_zero, add_zero, zero_add, hi0 _ haR, hi0 _ haI, pow_zero, Int.tdiv_one]
  rw [hlo _ _ (by simp [hn]) hxR, hlo _ _ (by simp [hn]) hxI]

/-! ## Toeplitz stages on pairs -/

/-! ## The block solve and the chunk kernel on pairs -/

end stages

end J6Seg

