    have hqpow : q * (q ^ 2) ^ k = q ^ (2 * k + 1) := by
      rw [← pow_mul]
      rw [show 2 * k + 1 = 1 + 2 * k by omega, pow_add]
      simp
    rw [show c * q * (q ^ 2) ^ k = c * (q * (q ^ 2) ^ k) by ring, hqpow]]
