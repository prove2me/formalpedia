-- title:
--   Translated normalized jets equal derivatives at the shifted parameter
-- statement:
--   Let $A$ be the given local analytic subgroup of an embedded commutative group product over a complete nontrivially normed field. Fix translation points $g,g'$, a point $x$, a normalized coordinate chart, a polynomial $P$, and an ordered coordinate derivative of any finite order. As a germ at $z=0$, evaluating that normalized derivative at $g+x+A(z)$ equals taking the same derivative of the orbit pullback for $g+g'+x$ at parameter $z$. The local parameter ball is respected; extending the left side by zero outside it does not affect the germ. No homogeneity of $P$ is needed. This is the analytic shift identity used in the two-parameter calculation on printed p. 374.
-- source:
--   Philippon (1986), Lemmes de zéros dans les groupes algébriques commutatifs, proof of Proposition 4.3, printed pp. 373–374, especially the two-parameter formula and the ideal generated by it on p. 374: https://numdam.org/articles/10.24033/bsmf.2060/ .

import Definitions.Def_PhilipponMultiplicity_SectionFour
set_option autoImplicit false
open scoped BigOperators Topology
open PhilipponMultiplicity
attribute [local instance] Classical.propDecidable

theorem PhilipponMultiplicity.normalized_jet_translation_germ
    (K : Type*) [NontriviallyNormedField K] [CompleteSpace K]
    (G : EmbeddedGroupProduct K) (A : AnalyticSubgroup G)
    (g g' x : G.Point) (b : CoordinateChart G) (P : G.CoordinateRing)
    (T : ℕ) (j : JetIndex A.parameterDimension T) :
    (fun z : A.ParameterSpace => if hz : z ∈ A.domain then
      normalizedJet A g' b P j (g + x + A.map ⟨z,hz⟩) else 0) =ᶠ[𝓝 0]
      (fun z => iteratedFDeriv K j.order (normalizedPullback A (g+g') b P x) z
        (fun i => Pi.single (j.directions i) 1)) := by sorry
