-- Source module: Solutions.R6IL3FAddr
/-!
# Round six, item language (I3): `KFRAddr` for an arbitrary slot width `F`

Copies of the frozen `KFRLay`/`KFRAddr` row-geometry lemmas (stated there for `f = m ^ k`) for any
slot width `F ≥ 1` (`[NeZero F]`): `shR_volF`, `shR_weightF`, `encode_rowAddAddrF`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3F

open IntMul NLogN RS AModel NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH Complex P8Lift Butterfly
  NLogN.KFN NLogN.KFR

variable {K m F e : ℕ} [NeZero F] {pos : Fin m × Fin F → ℕ}

theorem rowE_leF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (r : Fin m) :
    K * (F * (r.val + 1) - 1) ≤ e := by
  have hf : 1 ≤ F := Nat.one_le_iff_ne_zero.2 (NeZero.ne F)
  have := he (r, ⟨F - 1, by omega⟩)
  simp only at this
  have e1 : F - 1 + F * r.val = F * (r.val + 1) - 1 := by
    rw [Nat.mul_succ]; omega
  rw [e1] at this
  omega

theorem sR_addF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (r : Fin m) :
    sR K (F) e r + e % K = e - K * (F * (r.val + 1) - 1) := by
  have h1 := rowE_leF he r
  set E := K * (F * (r.val + 1) - 1)
  have h2 : (e - E) % K = e % K := by
    simp only [E]; rw [Nat.sub_mul_mod h1]
  have h3 : (e - E) % K ≤ e - E := Nat.mod_le _ _
  unfold sR
  omega

/-- **Bit `f-1-u` of row `r` sits at `sR r + ρ' + uK`.** -/
theorem pos_eq_sRF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (r : Fin m) {u : ℕ}
    (hu : u < F) : pos (r, ⟨F - 1 - u, by omega⟩) = sR K (F) e r + e % K + u * K := by
  have h0 := sR_addF he r
  have h1 : pos (r, ⟨F - 1 - u, by omega⟩) + K * (F - 1 - u + F * r.val) = e := he _
  have e1 : F - 1 - u + F * r.val = (F * (r.val + 1) - 1) - u := by
    rw [Nat.mul_succ]; omega
  have e2 : K * u ≤ K * (F * (r.val + 1) - 1) :=
    Nat.mul_le_mul_left _ (by rw [Nat.mul_succ]; omega)
  rw [e1, Nat.mul_sub] at h1
  rw [Nat.mul_comm u K]
  have h2 := rowE_leF he r
  omega

/-- Rows further down start lower by `fK` per row. -/
theorem sR_ltF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) {r r' : Fin m}
    (h : r < r') : sR K (F) e r' + F * K * (r'.val - r.val) = sR K (F) e r := by
  have h0 := sR_addF he r
  have h1 := sR_addF he r'
  have hf : 1 ≤ F := Nat.one_le_iff_ne_zero.2 (NeZero.ne F)
  have hlt : r.val < r'.val := h
  have e1 : F * (r'.val + 1) - 1 = (F * (r.val + 1) - 1) + F * (r'.val - r.val) := by
    have : F * (r'.val + 1) = F * (r.val + 1) + F * (r'.val - r.val) := by
      rw [← Nat.mul_add]; congr 1; omega
    have : 1 ≤ F * (r.val + 1) := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (NeZero.ne F) (by omega))
    omega
  have e2 : K * (F * (r'.val + 1) - 1) =
      K * (F * (r.val + 1) - 1) + F * K * (r'.val - r.val) := by
    rw [e1, Nat.mul_add]; ring
  have h2 := rowE_leF he r'
  omega

theorem sR_topF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (r : Fin m) :
    sR K (F) e r + F * K ≤ e - e % K + K := by
  have h0 := sR_addF he r
  have h1 := rowE_leF he r
  have hf : 1 ≤ F := Nat.one_le_iff_ne_zero.2 (NeZero.ne F)
  have a1 : K * (F - 1) ≤ K * (F * (r.val + 1) - 1) :=
    Nat.mul_le_mul_left _ (by rw [Nat.mul_succ]; omega)
  have a2 : K * (F - 1) + K = F * K := by
    rw [Nat.mul_comm (F) K, ← Nat.mul_succ]; congr 1; omega
  have a3 := Nat.mod_le e K
  omega

theorem sR_gapF (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) {r r' : Fin m}
    (h : r < r') : sR K (F) e r' + F * K ≤ sR K (F) e r := by
  have h1 := sR_ltF he h
  have : F * K ≤ F * K * (r'.val - r.val) :=
    Nat.le_mul_of_pos_right _ (by have : r.val < r'.val := h; omega)
  omega

/-- The rectangle of the rows `σ 0 < σ 1 < σ 2`. -/

theorem pow_mul_pow_mul' (x y S : ℕ) : 2 ^ x * (2 ^ y * S) = 2 ^ (x + y) * S := by
  rw [← mul_assoc, ← pow_add]

section Shape

variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + F * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ

theorem shR_weightF (τ : Fin 3) :
    vol ((shR K (F) e t S0 B σ).drop (slotF τ + 1)) = 2 ^ sR K (F) e (σ τ) * S0 := by
  have g1 := sR_gapF he hσ.1
  have g2 := sR_gapF he hσ.2
  fin_cases τ <;>
  · simp only [shR, rect, slotF, Fin.isValue, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.mk_one,
      Fin.zero_eta, Fin.reduceFinMk, Fin.val_mk, mul_zero, mul_one, zero_add,
      List.drop_succ_cons, List.drop_zero, vol_cons, vol_nil]
    repeat rw [pow_mul_pow_mul']
    try (congr 2; omega)

theorem shR_volF : vol (shR K (F) e t S0 B σ) = B * 2 ^ t * S0 := by
  have g1 := sR_gapF he hσ.1
  have g2 := sR_gapF he hσ.2
  have g0 := sR_topF he (σ 0)
  simp only [shR, rect, vol_cons, vol_nil, mul_one]
  repeat rw [pow_mul_pow_mul']
  rw [mul_assoc B, mul_assoc B, pow_mul_pow_mul']
  congr 3; omega

theorem shR_fieldF (τ : Fin 3) : (shR K (F) e t S0 B σ).getD (slotF τ) 0 = 2 ^ (F * K) := by
  fin_cases τ <;> simp [shR, rect, slotF]

theorem shR_lengthF : (shR K (F) e t S0 B σ).length = 7 := by simp [shR, rect]

theorem shR_digitF {q : ℕ} (hq : q < B * 2 ^ t * S0) (τ : Fin 3) :
    (decode (shR K (F) e t S0 B σ) q).getD (slotF τ) 0 =
      q / (2 ^ sR K (F) e (σ τ) * S0) % 2 ^ (F * K) := by
  have hq' : q < vol (shR K (F) e t S0 B σ) := by rw [shR_volF he htop hσ]; exact hq
  have hv := valid_decode hq'
  rw [getD_digit _ _ _ hv (by rw [hv.length_eq, shR_lengthF he htop hσ]; fin_cases τ <;> simp [slotF]),
    encode_decode hq', shR_weightF he htop hσ, shR_fieldF he htop hσ]

/-- **The packed row addition is the selected-bit address map of `rowAddr`.** -/
theorem encode_rowAddAddrF (hK : 1 ≤ K) {q : ℕ} (hq : q < B * 2 ^ t * S0) {px py : Fin 3}
    {i j : Fin m} (hi : σ px = i) (hj : σ py = j) (hij : i ≠ j) :
    ((encode (shR K (F) e t S0 B σ)
        (rowAddAddr K (e % K) (F) px py (decode (shR K (F) e t S0 B σ) q)) : ℕ) : ℤ) =
      fsetZ (fun p => 2 ^ pos p * S0) q (rowAddr i j (fbit (fun p => 2 ^ pos p * S0) q)) := by
  subst hi hj
  have hq' : q < vol (shR K (F) e t S0 B σ) := by rw [shR_volF he htop hσ]; exact hq
  have hv := valid_decode hq'
  have hlen : (decode (shR K (F) e t S0 B σ) q).length = 7 := by
    rw [hv.length_eq, shR_lengthF he htop hσ]
  unfold rowAddAddr
  rw [encode_set _ _ _ _ (by rw [hlen]; fin_cases py <;> simp [slotF])
      (by rw [hlen, shR_lengthF he htop hσ]), encode_decode hq',
    shR_digitF he htop hσ hq px, shR_digitF he htop hσ hq py, shR_weightF he htop hσ,
    xor_mask_sub hK (Nat.mod_lt _ (by omega)) le_rfl (Nat.mod_lt _ (by positivity))
      (Nat.mod_lt _ (by positivity)),
    fsetZ_rowAddr _ q _ _ hij, Finset.sum_mul]
  congr 1
  refine Finset.sum_congr rfl fun u hu => ?_
  have hu : u < F := Finset.mem_range.1 hu
  have hl : e % K + u * K < F * K := by
    have := Nat.mod_lt e (show 0 < K by omega)
    have : (u + 1) * K ≤ F * K := Nat.mul_le_mul_right _ hu
    rw [Nat.succ_mul] at this; omega
  rw [bitZ_xor_digit hl, bitZ_digit hl]
  unfold rowTerm
  rw [dif_pos (by omega)]
  have hW : ∀ r : Fin m, 2 ^ sR K (F) e r * S0 * 2 ^ (e % K + u * K) =
      2 ^ pos (r, ⟨F - 1 - u, by omega⟩) * S0 := fun r => by
    rw [pos_eq_sRF he r hu, add_assoc, pow_add]; ring
  rw [hW, hW, mul_assoc]
  congr 1
  simp only []; rw [← hW (σ py)]; push_cast; ring

end Shape

end IntMul.Kappa.R6.IL3F

end

