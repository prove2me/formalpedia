theorem foldl_val (a : ℕ) (l : List Bool) :
    l.foldl (fun a b => 2 * a + b.toNat) a =
      2 ^ l.length * a + l.foldl (fun a b => 2 * a + b.toNat) 0 := by
  induction l generalizing a with
  | nil => simp
  | cons b l ih =>
    rw [List.foldl_cons, List.foldl_cons, ih, ih (2 * 0 + b.toNat), List.length_cons, pow_succ]
    ring

theorem val_cons (b : Bool) (l : List Bool) : val (b :: l) = 2 ^ l.length * b.toNat + val l := by
  simp only [val, List.foldl_cons]
  rw [foldl_val]; ring

theorem val_lt (l : List Bool) : val l < 2 ^ l.length := by
