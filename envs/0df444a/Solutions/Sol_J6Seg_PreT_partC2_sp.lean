    ⟨isInt_encK fL, trivial, ok_RF iln rfl⟩
  have cA : (accE L).Clean := clean_add (clean_reg hL5) (clean_add (clean_lit 1) (clean_of_inRg iln))
  have bA : (accE L).Bnd (encK s (RF W c9)) (BW A) := by
    apply bnd_of_mg _ (fun _ => 2 ^ A) (BW A) (accE L)
    · intro i hi
