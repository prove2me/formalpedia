/-! ### Section 2: Localized Subring `LocK5 ⊆ K5`, `evLoc`, and `isCoprime_of_evLoc_monic` -/

instance instFactPrime1009 : Fact (Nat.Prime 1009) := ⟨by norm_num⟩

abbrev Poly3Z := MvPolynomial (Fin 3) ℤ

def ι3 : Poly3Z →+* K5 :=
  k4ToK5.comp ((algebraMap Poly4 K4).comp (poly3ToPoly4.comp (MvPolynomial.map (Int.castRingHom ℂ))))

lemma ι3_injective : Function.Injective ι3 := by
  have h1 : Function.Injective (MvPolynomial.map (Int.castRingHom ℂ) : Poly3Z →+* Poly3) :=
    MvPolynomial.map_injective (Int.castRingHom ℂ) Int.cast_injective
  have h2 : Function.Injective (algebraMap K4 K5) := RingHom.injective (algebraMap K4 K5)
  exact h2.comp ((IsFractionRing.injective Poly4 K4).comp (poly3ToPoly4_injective.comp h1))

lemma ι3_X0 : ι3 (MvPolynomial.X 0) = S_K := by
  simp [ι3, S_K, S_4, k4ToK5, poly3ToPoly4]
lemma ι3_X1 : ι3 (MvPolynomial.X 1) = Q_K := by
  simp [ι3, Q_K, Q_4, k4ToK5, poly3ToPoly4]
lemma ι3_X2 : ι3 (MvPolynomial.X 2) = T_K := by
  simp [ι3, T_K, T_4, k4ToK5, poly3ToPoly4]

def evZ : Poly3Z →+* ZMod 1009 :=
  MvPolynomial.eval₂Hom (Int.castRingHom (ZMod 1009)) ![2, 3, 5]

/-- Subring of `K5` generated by rational functions in `(S_K, Q_K, T_K)` over `ℤ` whose
denominators do not vanish at `(2, 3, 5) mod 1009`. -/
def LocK5 : Subring K5 where
  carrier := {z : K5 | ∃ n d : Poly3Z, evZ d ≠ 0 ∧ z = ι3 n / ι3 d}
  zero_mem' := ⟨0, 1, by simp, by simp⟩
  one_mem' := ⟨1, 1, by simp, by simp⟩
  add_mem' := by
    rintro _ _ ⟨n1, d1, hd1, rfl⟩ ⟨n2, d2, hd2, rfl⟩
    refine ⟨n1 * d2 + n2 * d1, d1 * d2, by simp [hd1, hd2], ?_⟩
    have h1 : ι3 d1 ≠ 0 := fun h => hd1 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
    have h2 : ι3 d2 ≠ 0 := fun h => hd2 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
    simp only [map_add, map_mul]
    field_simp [h1, h2]
  neg_mem' := by
    rintro _ ⟨n, d, hd, rfl⟩
    exact ⟨-n, d, hd, by simp [neg_div]⟩
  mul_mem' := by
    rintro _ _ ⟨n1, d1, hd1, rfl⟩ ⟨n2, d2, hd2, rfl⟩
    refine ⟨n1 * n2, d1 * d2, by simp [hd1, hd2], ?_⟩
    simp only [map_mul, mul_div_mul_comm]

lemma evZ_div_eq {n1 d1 n2 d2 : Poly3Z} (hd1 : evZ d1 ≠ 0) (hd2 : evZ d2 ≠ 0)
    (heq : ι3 n1 / ι3 d1 = ι3 n2 / ι3 d2) : evZ n1 / evZ d1 = evZ n2 / evZ d2 := by
  have h1 : ι3 d1 ≠ 0 := fun h => hd1 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
  have h2 : ι3 d2 ≠ 0 := fun h => hd2 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
  have hmul : ι3 (n1 * d2) = ι3 (n2 * d1) := by
    simp only [map_mul]
    have := congrArg (· * (ι3 d1 * ι3 d2)) heq
    field_simp [h1, h2] at this
    linear_combination this
  have hpoly : n1 * d2 = n2 * d1 := ι3_injective hmul
  have hev := congrArg evZ hpoly
  simp only [map_mul] at hev
  field_simp [hd1, hd2]
  exact hev.trans (mul_comm _ _)

private def evLocFun (x : LocK5) : ZMod 1009 :=
  let h := x.2
  evZ h.choose / evZ h.choose_spec.choose

lemma evLocFun_spec {x : LocK5} {n d : Poly3Z} (hd : evZ d ≠ 0) (hx : (x : K5) = ι3 n / ι3 d) :
    evLocFun x = evZ n / evZ d := by
  dsimp only [evLocFun]
  exact evZ_div_eq x.2.choose_spec.choose_spec.1 hd (x.2.choose_spec.choose_spec.2.symm.trans hx)

def evLoc : LocK5 →+* ZMod 1009 where
  toFun := evLocFun
  map_one' := by
    rw [evLocFun_spec (n := 1) (d := 1) (by simp) (by simp)]; simp
  map_zero' := by
    rw [evLocFun_spec (n := 0) (d := 1) (by simp) (by simp)]; simp
  map_add' x y := by
    obtain ⟨n1, d1, hd1, hx⟩ := x.2
    obtain ⟨n2, d2, hd2, hy⟩ := y.2
    have h1 : ι3 d1 ≠ 0 := fun h => hd1 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
    have h2 : ι3 d2 ≠ 0 := fun h => hd2 (by rw [ι3_injective (h.trans (map_zero ι3).symm), map_zero])
    rw [evLocFun_spec hd1 hx, evLocFun_spec hd2 hy]
    rw [evLocFun_spec (n := n1 * d2 + n2 * d1) (d := d1 * d2) (by simp [hd1, hd2])]
    · simp only [map_add, map_mul]; field_simp [hd1, hd2]
    · change (x : K5) + (y : K5) = _
      rw [hx, hy]; simp only [map_add, map_mul]; field_simp [h1, h2]
  map_mul' x y := by
    obtain ⟨n1, d1, hd1, hx⟩ := x.2
    obtain ⟨n2, d2, hd2, hy⟩ := y.2
    rw [evLocFun_spec hd1 hx, evLocFun_spec hd2 hy]
    rw [evLocFun_spec (n := n1 * n2) (d := d1 * d2) (by simp [hd1, hd2])]
    · simp only [map_mul, mul_div_mul_comm]
    · change (x : K5) * (y : K5) = _
      rw [hx, hy]; simp only [map_mul, mul_div_mul_comm]

lemma evLoc_eq_of_div {x : LocK5} {n d : Poly3Z} (hd : evZ d ≠ 0) (hx : (x : K5) = ι3 n / ι3 d) :
    evLoc x = evZ n / evZ d := evLocFun_spec hd hx

def LocK5.invOfNe (x : LocK5) (hx : evLoc x ≠ 0) : LocK5 :=
  ⟨(x : K5)⁻¹, by
    obtain ⟨n, d, hd, hxn⟩ := x.2
    have hn : evZ n ≠ 0 := by
      intro h0
      apply hx
      rw [evLoc_eq_of_div hd hxn, h0, zero_div]
    exact ⟨d, n, hn, by rw [hxn, inv_div]⟩⟩

lemma LocK5.mul_invOfNe (x : LocK5) (hx : evLoc x ≠ 0) : x * LocK5.invOfNe x hx = 1 := by
  apply Subtype.ext
  have hx0 : (x : K5) ≠ 0 := fun h => hx (by rw [show x = 0 from Subtype.ext h, map_zero])
  change (x : K5) * (x : K5)⁻¹ = 1
  exact mul_inv_cancel₀ hx0

lemma LocK5.invOfNe_mul (x : LocK5) (hx : evLoc x ≠ 0) : LocK5.invOfNe x hx * x = 1 := by
  rw [mul_comm, LocK5.mul_invOfNe]

lemma LocK5.evLoc_invOfNe (x : LocK5) (hx : evLoc x ≠ 0) :
    evLoc (LocK5.invOfNe x hx) = (evLoc x)⁻¹ := by
  have h := congrArg evLoc (LocK5.mul_invOfNe x hx)
  rw [map_mul, map_one] at h
  exact eq_inv_of_mul_eq_one_right h

lemma LocK5.val_invOfNe (x : LocK5) (hx : evLoc x ≠ 0) :
    ((LocK5.invOfNe x hx : LocK5) : K5) = (x : K5)⁻¹ := rfl

lemma LocK5.ne_zero_of_evLoc {x : LocK5} (hx : evLoc x ≠ 0) : (x : K5) ≠ 0 :=
  fun h => hx (by rw [show x = 0 from Subtype.ext h, map_zero])

def S_loc : LocK5 := ⟨S_K, MvPolynomial.X 0, 1, by simp, by simp [ι3_X0]⟩
def Q_loc : LocK5 := ⟨Q_K, MvPolynomial.X 1, 1, by simp, by simp [ι3_X1]⟩
def T_loc : LocK5 := ⟨T_K, MvPolynomial.X 2, 1, by simp, by simp [ι3_X2]⟩

lemma evLoc_S : evLoc S_loc = 2 := by
  rw [evLoc_eq_of_div (n := MvPolynomial.X 0) (d := 1) (by simp) (by simp [S_loc, ι3_X0])]
  simp [evZ]
lemma evLoc_Q : evLoc Q_loc = 3 := by
  rw [evLoc_eq_of_div (n := MvPolynomial.X 1) (d := 1) (by simp) (by simp [Q_loc, ι3_X1])]
  simp [evZ]
lemma evLoc_T : evLoc T_loc = 5 := by
  rw [evLoc_eq_of_div (n := MvPolynomial.X 2) (d := 1) (by simp) (by simp [T_loc, ι3_X2])]
  simp [evZ]

-- Monic-modulus multiplication matrix and coprimality lifting theorem!
def mulModMat {R : Type*} [CommRing R] (P Q : R[X]) (n : ℕ) : Matrix (Fin n) (Fin n) R :=
  fun i j => ((X ^ (j : ℕ) * Q) %ₘ P).coeff i

lemma map_mulModMat {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    {P : R[X]} (hP : P.Monic) (Q : R[X]) (n : ℕ) :
    (mulModMat P Q n).map f = mulModMat (P.map f) (Q.map f) n := by
  ext i j
  simp only [Matrix.map_apply, mulModMat]
  rw [← Polynomial.coeff_map, Polynomial.map_modByMonic f hP]
  simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_X]

lemma sum_modByMonic {R ι : Type*} [CommRing R] (s : Finset ι) (f : ι → R[X]) (P : R[X]) :
    (∑ j ∈ s, f j) %ₘ P = ∑ j ∈ s, (f j %ₘ P) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, Polynomial.add_modByMonic, ih]

lemma modByMonic_eq_of_dvd_sub {R : Type*} [CommRing R] {P A B : R[X]}
    (hP : P.Monic) (h : P ∣ A - B) : A %ₘ P = B %ₘ P := by
  rcases h with ⟨q, hq⟩
  have hA : A = B + P * q := by linear_combination hq
  rw [hA, Polynomial.add_modByMonic,
    (Polynomial.modByMonic_eq_zero_iff_dvd hP).mpr ⟨q, rfl⟩, add_zero]

lemma C_mul_modByMonic {R : Type*} [CommRing R] [Nontrivial R] {P : R[X]} (hP : P.Monic)
    (a : R) (f : R[X]) : (C a * f) %ₘ P = C a * (f %ₘ P) := by
  by_cases ha : a = 0
  · subst ha; simp
  · have hdiv := Polynomial.modByMonic_add_div f P
    have hdvd : P ∣ C a * f - C a * (f %ₘ P) :=
      ⟨C a * (f /ₘ P), by linear_combination -C a * hdiv⟩
    rw [modByMonic_eq_of_dvd_sub hP hdvd]
    apply (Polynomial.modByMonic_eq_self_iff hP).mpr
    have hle : (C a * (f %ₘ P)).degree ≤ (f %ₘ P).degree := by
      calc (C a * (f %ₘ P)).degree ≤ (C a).degree + (f %ₘ P).degree := Polynomial.degree_mul_le _ _
        _ = 0 + (f %ₘ P).degree := by rw [Polynomial.degree_C ha]
        _ = (f %ₘ P).degree := zero_add _
    exact hle.trans_lt (Polynomial.degree_modByMonic_lt f hP)

lemma mulModMat_mulVec {R : Type*} [CommRing R] [Nontrivial R] {P : R[X]} (hP : P.Monic) (Q : R[X])
    (n : ℕ) (v : Fin n → R) (i : Fin n) :
    (mulModMat P Q n).mulVec v i =
      (((∑ j : Fin n, C (v j) * X ^ (j : ℕ)) * Q) %ₘ P).coeff i := by
  simp only [Matrix.mulVec, dotProduct, mulModMat]
  rw [Finset.sum_mul]
  have hmod : (∑ j : Fin n, C (v j) * X ^ (j : ℕ) * Q) %ₘ P =
      ∑ j : Fin n, C (v j) * ((X ^ (j : ℕ) * Q) %ₘ P) := by
    rw [sum_modByMonic]
    apply Finset.sum_congr rfl; intro j _
    rw [mul_assoc, C_mul_modByMonic hP]
  rw [hmod]
  change _ = Polynomial.lcoeff R i (∑ j : Fin n, C (v j) * (X ^ (j : ℕ) * Q %ₘ P))
  rw [map_sum]
  apply Finset.sum_congr rfl; intro j _
  simp only [Polynomial.lcoeff_apply, Polynomial.coeff_C_mul]
  ring

lemma poly_eq_sum_fin {R : Type*} [CommRing R] {f : R[X]} {n : ℕ} (hf : f.degree < n) :
    f = ∑ k : Fin n, C (f.coeff k) * X ^ (k : ℕ) := by
  ext m
  change f.coeff m = Polynomial.lcoeff R m (∑ k : Fin n, C (f.coeff k) * X ^ (k : ℕ))
  rw [map_sum]
  simp only [Polynomial.lcoeff_apply]
  by_cases hm : m < n
  · rw [Finset.sum_eq_single ⟨m, hm⟩]
    · simp
    · intro k _ hkm
      have hne : m ≠ k.val := fun h => hkm (Fin.ext h.symm)
      simp [hne]
    · intro h; exact (h (Finset.mem_univ _)).elim
  · rw [Polynomial.coeff_eq_zero_of_degree_lt (lt_of_lt_of_le hf (by exact_mod_cast le_of_not_gt hm))]
    symm
    apply Finset.sum_eq_zero; intro k _
    have hne : m ≠ k.val := by omega
    simp [hne]

lemma mulModMat_mul {R : Type*} [CommRing R] [Nontrivial R] {n : ℕ} {P : R[X]} (hP : P.Monic) (hn : P.natDegree = n)
    (A B : R[X]) :
    mulModMat P A n * mulModMat P B n = mulModMat P (A * B) n := by
  ext i j
  rw [Matrix.mul_apply]
  have hcol : ∑ k : Fin n, mulModMat P A n i k * mulModMat P B n k j =
      (mulModMat P A n).mulVec (fun k => mulModMat P B n k j) i := rfl
  rw [hcol, mulModMat_mulVec hP A n]
  have hdeg : ((X ^ (j : ℕ) * B) %ₘ P).degree < n := by
    have hlt := Polynomial.degree_modByMonic_lt (X ^ (j : ℕ) * B) hP
    rw [Polynomial.degree_eq_natDegree hP.ne_zero, hn] at hlt
    exact hlt
  have heq : ∑ k : Fin n, C (mulModMat P B n k j) * X ^ (k : ℕ) = (X ^ (j : ℕ) * B) %ₘ P :=
    (poly_eq_sum_fin hdeg).symm
  rw [heq]
  have hmod2 : (((X ^ (j : ℕ) * B) %ₘ P) * A) %ₘ P = (X ^ (j : ℕ) * (A * B)) %ₘ P := by
    apply modByMonic_eq_of_dvd_sub hP
    have hdiv := Polynomial.modByMonic_add_div (X ^ (j : ℕ) * B) P
    exact ⟨-(((X ^ (j : ℕ) * B) /ₘ P) * A), by linear_combination A * hdiv⟩
  rw [hmod2]; rfl

lemma mulModMat_one {R : Type*} [CommRing R] [Nontrivial R] {n : ℕ} {P : R[X]} (hP : P.Monic) (hn : P.natDegree = n) :
    mulModMat P 1 n = 1 := by
  ext i j
  simp only [mulModMat, mul_one, Matrix.one_apply]
  have hdeg : (X ^ (j : ℕ) : R[X]).degree < P.degree := by
    rw [Polynomial.degree_X_pow, Polynomial.degree_eq_natDegree hP.ne_zero, hn]
    exact WithBot.coe_lt_coe.mpr j.isLt
  rw [(Polynomial.modByMonic_eq_self_iff hP).mpr hdeg, Polynomial.coeff_X_pow]
  by_cases h : i = j
  · subst h; simp
  · have hne : (i : ℕ) ≠ (j : ℕ) := fun he => h (Fin.ext he)
    simp [h, hne]

lemma mulModMat_eq_of_mod {R : Type*} [CommRing R] {P : R[X]} (hP : P.Monic)
    {A B : R[X]} (h : P ∣ A - B) (n : ℕ) :
    mulModMat P A n = mulModMat P B n := by
  ext i j
  simp only [mulModMat]
  congr 1
  apply modByMonic_eq_of_dvd_sub hP
  rcases h with ⟨q, hq⟩
  exact ⟨X ^ (j : ℕ) * q, by linear_combination X ^ (j : ℕ) * hq⟩

/-- **Coprimality Lifting Theorem**: If `P : LocK5[X]` is monic and `evLoc(P)` is coprime to
`evLoc(Q)` in `(ZMod 1009)[X]`, then `P` and `Q` are coprime in `K5[X]` (with NO degree bound on `Q`). -/
theorem isCoprime_of_evLoc_monic {P Q : LocK5[X]} (hPm : P.Monic)
    (hcop : IsCoprime (P.map evLoc) (Q.map evLoc)) :
    IsCoprime (P.map LocK5.subtype) (Q.map LocK5.subtype) := by
  set n := P.natDegree
  have hP_ev_m : (P.map evLoc).Monic := hPm.map evLoc
  have hP_K_m : (P.map LocK5.subtype).Monic := hPm.map LocK5.subtype
  have hP_ev_deg : (P.map evLoc).natDegree = n := hPm.natDegree_map evLoc
  have hP_K_deg : (P.map LocK5.subtype).natDegree = n := hPm.natDegree_map LocK5.subtype
  by_cases hn0 : n = 0
  · have hP1 : P.map LocK5.subtype = 1 :=
      Polynomial.eq_one_of_monic_natDegree_zero hP_K_m (hP_K_deg.trans hn0)
    rw [hP1]; exact isCoprime_one_left
  · obtain ⟨A, B, hAB⟩ := hcop
    have hmul_ev : mulModMat (P.map evLoc) B n * mulModMat (P.map evLoc) (Q.map evLoc) n = 1 := by
      rw [mulModMat_mul hP_ev_m hP_ev_deg]
      have hdvd : P.map evLoc ∣ B * Q.map evLoc - 1 := ⟨-A, by linear_combination hAB⟩
      rw [mulModMat_eq_of_mod hP_ev_m hdvd n, mulModMat_one hP_ev_m hP_ev_deg]
    have hdet_ev_ne : (mulModMat (P.map evLoc) (Q.map evLoc) n).det ≠ 0 := by
      intro h0
      have hd := congrArg Matrix.det hmul_ev
      rw [Matrix.det_mul, h0, mul_zero, Matrix.det_one] at hd
      exact zero_ne_one hd
    have hdet_loc : evLoc (mulModMat P Q n).det ≠ 0 := by
      rw [RingHom.map_det]
      change ((mulModMat P Q n).map evLoc).det ≠ 0
      rw [map_mulModMat evLoc hPm]
      exact hdet_ev_ne
    have hdet_K_ne : (mulModMat (P.map LocK5.subtype) (Q.map LocK5.subtype) n).det ≠ 0 := by
      rw [← map_mulModMat LocK5.subtype hPm]
      change (LocK5.subtype.mapMatrix (mulModMat P Q n)).det ≠ 0
      rw [← RingHom.map_det]
      exact LocK5.ne_zero_of_evLoc hdet_loc
    let MK := mulModMat (P.map LocK5.subtype) (Q.map LocK5.subtype) n
    have hunit : IsUnit MK.det := isUnit_iff_ne_zero.mpr hdet_K_ne
    let e0 : Fin n → K5 := Pi.single ⟨0, Nat.pos_of_ne_zero hn0⟩ 1
    let v : Fin n → K5 := MK⁻¹.mulVec e0
    have hv : MK.mulVec v = e0 := by
      simp only [v, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv MK hunit, Matrix.one_mulVec]
    let B_K : K5[X] := ∑ j : Fin n, C (v j) * X ^ (j : ℕ)
    have hmod1 : (B_K * Q.map LocK5.subtype) %ₘ (P.map LocK5.subtype) = 1 := by
      have hdeg_lt : ((B_K * Q.map LocK5.subtype) %ₘ (P.map LocK5.subtype)).degree < n := by
        have hlt := Polynomial.degree_modByMonic_lt (B_K * Q.map LocK5.subtype) hP_K_m
        rw [Polynomial.degree_eq_natDegree hP_K_m.ne_zero, hP_K_deg] at hlt
        exact hlt
      ext m
      by_cases hm : m < n
      · have hci := congrFun hv ⟨m, hm⟩
        rw [mulModMat_mulVec hP_K_m (Q.map LocK5.subtype) n v ⟨m, hm⟩] at hci
        change ((B_K * Q.map LocK5.subtype) %ₘ (P.map LocK5.subtype)).coeff m = e0 ⟨m, hm⟩ at hci
        rw [hci]
        simp only [e0, Polynomial.coeff_one]
        by_cases hm0 : m = 0
        · subst hm0; simp
        · simp [hm0]
      · rw [Polynomial.coeff_eq_zero_of_degree_lt (lt_of_lt_of_le hdeg_lt (by exact_mod_cast le_of_not_gt hm))]
        have hm0 : m ≠ 0 := by omega
        simp [Polynomial.coeff_one, hm0]
    have hdiv := Polynomial.modByMonic_add_div (B_K * Q.map LocK5.subtype) (P.map LocK5.subtype)
    rw [hmod1] at hdiv
    refine ⟨-((B_K * Q.map LocK5.subtype) /ₘ (P.map LocK5.subtype)), B_K, ?_⟩
    linear_combination -hdiv

/-! ### Section 3: Polymorphic Symbolic Cover Equations in `R[X]` and `PairAlg (R[X])` -/

/-- Ring parameters `(S, Q, T, inv2, inv3, inv7, invT3)` enabling identical symbolic definitions
over `LocK5`, `ZMod 1009`, `K5`, and any finite extension `L / K5`. -/
structure CoverParams (R : Type*) where
  S : R
  Q : R
  T : R
  inv2 : R
  inv3 : R
  inv7 : R
  invT3 : R

namespace CoverParams

def map {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) (p : CoverParams R) : CoverParams S :=
  ⟨f p.S, f p.Q, f p.T, f p.inv2, f p.inv3, f p.inv7, f p.invT3⟩

section PolyDefs
variable {R : Type*} [CommRing R] (p : CoverParams R)

def inv4 : R := p.inv2 ^ 2
def inv9 : R := p.inv3 ^ 2
def inv27 : R := p.inv3 ^ 3
def inv81 : R := p.inv3 ^ 4
def inv243 : R := p.inv3 ^ 5

def Av0 : R := -4 * p.inv243 * (p.T - 3) ^ 3
def Av0_inv : R := -243 * p.inv4 * p.invT3 ^ 3
def Cv0 : R := -25 * p.inv243 * p.T * (5 * p.T - 9) ^ 2

def Bv0 : R := -25 * p.inv243 * p.S * (5 * p.S - 9 * p.Q) ^ 2
def Bv1 : R :=
  143 * p.inv243 * p.S ^ 3 - 92 * p.inv27 * p.S ^ 2 * p.Q + 52 * p.inv9 * p.S * p.Q ^ 2 -
  22 * p.inv9 * p.Q ^ 3 + 143 * p.inv243 * p.T ^ 3 - 92 * p.inv27 * p.T ^ 2 +
  52 * p.inv9 * p.T - 22 * p.inv9 + 5 * p.inv7 * p.Q ^ 2 + 10 * p.inv7 * p.Q
def Bv2 : R := -4 * p.inv243 * (p.S - 3 * p.Q) ^ 3

def quadU (a0 a1 a2 : R) : R[X] := C a0 + C a1 * X + C a2 * X ^ 2

def Bv : R[X] := quadU p.Bv0 p.Bv1 p.Bv2
def bW : R[X] := C p.Av0_inv * p.Bv
def cW : R[X] := C (p.Cv0 * p.Av0_inv) * X ^ 2

def ca_h : R[X] :=
  quadU (-625 * p.inv81 * p.S ^ 2 + 500 * p.inv27 * p.S * p.Q - 25 * p.inv3 * p.Q ^ 2)
        (143 * p.inv81 * p.S ^ 2 - 184 * p.inv27 * p.S * p.Q + 52 * p.inv9 * p.Q ^ 2)
        (-4 * p.inv81 * p.S ^ 2 + 8 * p.inv27 * p.S * p.Q - 4 * p.inv9 * p.Q ^ 2)

def cb_h : R[X] :=
  quadU (250 * p.inv27 * p.S ^ 2 - 50 * p.inv3 * p.S * p.Q)
        (-92 * p.inv27 * p.S ^ 2 + 104 * p.inv9 * p.S * p.Q - 22 * p.inv3 * p.Q ^ 2 +
          10 * p.inv7 * p.Q + 10 * p.inv7)
        (4 * p.inv27 * p.S ^ 2 - 8 * p.inv9 * p.S * p.Q + 4 * p.inv3 * p.Q ^ 2)

def c0_V2 : R := -4 * p.inv81 * (p.T - 3) ^ 2
def c0_V1 : R := 143 * p.inv81 * p.T ^ 2 - 184 * p.inv27 * p.T + 52 * p.inv9
def c0_V0 : R := -25 * p.inv81 * (5 * p.T - 9) * (5 * p.T - 3)

def k2_V2 : R := -4 * p.inv81 * (p.T - 3)
def k2_V1 : R := 143 * p.inv81 * p.T - 92 * p.inv27
def k2_V0 : R := -125 * p.inv81 * (5 * p.T - 6)

def k3_V2 : R := -4 * p.inv243
def k3_V1 : R := 143 * p.inv243
def k3_V0 : R := -625 * p.inv243

/-- Lift `U * (v2 * U * V^2 + v1 * U * V + v0 * U) = v2 * W^2 + v1 * U * W + v0 * U^2`
into `PairAlg (R[X])` modulo `W^2 + bW * W + cW = 0`. -/
def toUW (v0 v1 v2 : R) : PairAlg R[X] :=
  ⟨C v0 * X ^ 2 - C v2 * p.cW, C v1 * X - C v2 * p.bW⟩

def c0W : PairAlg R[X] := p.toUW p.c0_V0 p.c0_V1 p.c0_V2
def k2W : PairAlg R[X] := p.toUW p.k2_V0 p.k2_V1 p.k2_V2
def k3W : PairAlg R[X] := p.toUW p.k3_V0 p.k3_V1 p.k3_V2

def q20 : R[X] :=
  quadU (-625 * p.inv81 * p.S + 250 * p.inv27 * p.Q)
        (143 * p.inv81 * p.S - 92 * p.inv27 * p.Q)
        (-4 * p.inv81 * p.S + 4 * p.inv27 * p.Q)

def q11 : R[X] :=
  quadU (500 * p.inv27 * p.S - 50 * p.inv3 * p.Q)
        (-184 * p.inv27 * p.S + 104 * p.inv9 * p.Q)
        (8 * p.inv27 * p.S - 8 * p.inv9 * p.Q)

def q02 : R[X] :=
  quadU (-25 * p.inv3 * p.S)
        (52 * p.inv9 * p.S - 22 * p.inv3 * p.Q + 5 * p.inv7)
        (-4 * p.inv9 * p.S + 4 * p.inv3 * p.Q)

def c30 : R[X] := quadU (-625 * p.inv243) (143 * p.inv243) (-4 * p.inv243)
def c21 : R[X] := quadU (250 * p.inv27) (-92 * p.inv27) (4 * p.inv27)
def c12 : R[X] := quadU (-25 * p.inv3) (52 * p.inv9) (-4 * p.inv9)
def c03 : R[X] := quadU 0 (-22 * p.inv9) (4 * p.inv9)

def Q5_z : R[X] := p.q20 * p.cb_h ^ 2 - p.q11 * p.ca_h * p.cb_h + p.q02 * p.ca_h ^ 2
def Q7_z : R[X] :=
  p.c30 * p.cb_h ^ 3 - p.c21 * p.ca_h * p.cb_h ^ 2 +
  p.c12 * p.ca_h ^ 2 * p.cb_h - p.c03 * p.ca_h ^ 3

def pmul (x y : PairAlg R[X]) : PairAlg R[X] := PairAlg.mul p.bW p.cW x y
def pnm (x : PairAlg R[X]) : R[X] := PairAlg.nm p.bW p.cW x

def d2_2 : PairAlg R[X] := PairAlg.ofScalar p.Q5_z
def d2_1 : PairAlg R[X] := PairAlg.smul (-p.q11 * p.cb_h + 2 * p.q02 * p.ca_h) p.c0W
def d2_0 : PairAlg R[X] :=
  PairAlg.add (PairAlg.smul p.q02 (p.pmul p.c0W p.c0W))
              (PairAlg.smul (p.cb_h ^ 2) (p.pmul PairAlg.W p.k2W))

def d3_3 : PairAlg R[X] := PairAlg.ofScalar p.Q7_z
def d3_2 : PairAlg R[X] :=
  PairAlg.smul (-p.c21 * p.cb_h ^ 2 + 2 * p.c12 * p.ca_h * p.cb_h - 3 * p.c03 * p.ca_h ^ 2) p.c0W
def d3_1 : PairAlg R[X] :=
  PairAlg.smul (p.c12 * p.cb_h - 3 * p.c03 * p.ca_h) (p.pmul p.c0W p.c0W)
def d3_0 : PairAlg R[X] :=
  PairAlg.add (PairAlg.smul (-p.c03) (p.pmul p.c0W (p.pmul p.c0W p.c0W)))
              (PairAlg.smul (p.cb_h ^ 3) (p.pmul (p.pmul PairAlg.W PairAlg.W) p.k3W))

def res_z : PairAlg R[X] :=
  syl5Pair p.bW p.cW p.d2_2 p.d2_1 p.d2_0 p.d3_3 p.d3_2 p.d3_1 p.d3_0

def nm_z : R[X] := p.pnm p.res_z

-- Mirror a-elimination (eliminating z = -(cb_h * w + c0W) / ca_h) for cb_h^12 divisibility
def e2_2 : PairAlg R[X] := PairAlg.ofScalar p.Q5_z
def e2_1 : PairAlg R[X] := PairAlg.smul (-p.q11 * p.ca_h + 2 * p.q20 * p.cb_h) p.c0W
def e2_0 : PairAlg R[X] :=
  PairAlg.add (PairAlg.smul p.q20 (p.pmul p.c0W p.c0W))
              (PairAlg.smul (p.ca_h ^ 2) (p.pmul PairAlg.W p.k2W))

def e3_3 : PairAlg R[X] :=
  PairAlg.ofScalar (-p.c30 * p.cb_h ^ 3 + p.c21 * p.ca_h * p.cb_h ^ 2 -
    p.c12 * p.ca_h ^ 2 * p.cb_h + p.c03 * p.ca_h ^ 3)
def e3_2 : PairAlg R[X] :=
  PairAlg.smul (-3 * p.c30 * p.cb_h ^ 2 + 2 * p.c21 * p.ca_h * p.cb_h - p.c12 * p.ca_h ^ 2) p.c0W
def e3_1 : PairAlg R[X] :=
  PairAlg.smul (-3 * p.c30 * p.cb_h + p.c21 * p.ca_h) (p.pmul p.c0W p.c0W)
def e3_0 : PairAlg R[X] :=
  PairAlg.add (PairAlg.smul (-p.c30) (p.pmul p.c0W (p.pmul p.c0W p.c0W)))
              (PairAlg.smul (p.ca_h ^ 3) (p.pmul (p.pmul PairAlg.W PairAlg.W) p.k3W))

def res_w : PairAlg R[X] :=
  syl5Pair p.bW p.cW p.e2_2 p.e2_1 p.e2_0 p.e3_3 p.e3_2 p.e3_1 p.e3_0

def nm_w : R[X] := p.pnm p.res_w

-- Auxiliary nondegeneracy objects (d1_z, d0_z, disc_E2z, nm_WU, disc_E0, detM_W)
def d1_z : PairAlg R[X] :=
  let t2 := PairAlg.sub (p.pmul p.d2_2 p.d3_2) (p.pmul p.d2_1 p.d3_3)
  let t1 := PairAlg.sub (p.pmul p.d2_2 p.d3_1) (p.pmul p.d2_0 p.d3_3)
  PairAlg.sub (p.pmul p.d2_2 t1) (p.pmul p.d2_1 t2)

def d0_z : PairAlg R[X] :=
  let t2 := PairAlg.sub (p.pmul p.d2_2 p.d3_2) (p.pmul p.d2_1 p.d3_3)
  let t0 := p.pmul p.d2_2 p.d3_0
  PairAlg.sub (p.pmul p.d2_2 t0) (p.pmul p.d2_0 t2)

def disc_E2z : PairAlg R[X] :=
  PairAlg.sub (p.pmul p.d2_1 p.d2_1) (PairAlg.smul 4 (p.pmul p.d2_2 p.d2_0))

def nm_WU : R[X] := p.pnm ⟨-X, 1⟩
def disc_E0 : R[X] := p.bW ^ 2 - 4 * p.cW

-- Homogenized `S_ab_mat_W` determinant via `-(d20^2 - d21*d10)`
def A_sub : PairAlg R[X] := PairAlg.smul (-p.cb_h) p.d0_z
def B_sub : PairAlg R[X] := PairAlg.sub (PairAlg.smul p.ca_h p.d0_z) (p.pmul p.c0W p.d1_z)
def C_sub : PairAlg R[X] := p.pmul PairAlg.W (PairAlg.smul p.cb_h p.d1_z)

def dH_dS_hom (s q : PairAlg R[X]) : PairAlg R[X] :=
  let s_3q := PairAlg.sub s (PairAlg.smul 3 q)
  let t1 := PairAlg.smul (C (-4 * p.inv81) * X ^ 2) (p.pmul s_3q s_3q)
  let s2 := p.pmul s s; let sq := p.pmul s q; let q2 := p.pmul q q
  let mid := PairAlg.add
    (PairAlg.sub (PairAlg.smul (C (143 * p.inv81)) s2) (PairAlg.smul (C (184 * p.inv27)) sq))
    (PairAlg.smul (C (52 * p.inv9)) q2)
  let t2 := PairAlg.smul X mid
  let f1 := PairAlg.sub (PairAlg.smul 5 s) (PairAlg.smul 9 q)
  let f2 := PairAlg.sub (PairAlg.smul 15 s) (PairAlg.smul 9 q)
  let t3 := PairAlg.smul (C (-25 * p.inv243)) (p.pmul f1 f2)
  PairAlg.add (PairAlg.add t1 t2) t3

def dH_dQ_hom (s q v0 : PairAlg R[X]) : PairAlg R[X] :=
  let s_3q := PairAlg.sub s (PairAlg.smul 3 q)
  let t1 := PairAlg.smul (C (4 * p.inv27) * X ^ 2) (p.pmul s_3q s_3q)
  let s2 := p.pmul s s; let sq := p.pmul s q; let q2 := p.pmul q q
  let qv := p.pmul q v0; let v2 := p.pmul v0 v0
  let mid := PairAlg.add
    (PairAlg.add
      (PairAlg.sub
        (PairAlg.add (PairAlg.smul (C (-92 * p.inv27)) s2) (PairAlg.smul (C (104 * p.inv9)) sq))
        (PairAlg.smul (C (22 * p.inv3)) q2))
      (PairAlg.smul (C (10 * p.inv7)) qv))
    (PairAlg.smul (C (10 * p.inv7)) v2)
  let t2 := PairAlg.smul X mid
  let f1 := PairAlg.sub (PairAlg.smul 5 s) (PairAlg.smul 9 q)
  let t3 := PairAlg.smul (C (50 * p.inv27)) (p.pmul s f1)
  PairAlg.add (PairAlg.add t1 t2) t3

def detM_W : PairAlg R[X] :=
  let A := p.A_sub; let B := p.B_sub; let Cc := p.C_sub
  let xS := PairAlg.sub (PairAlg.smul (C p.S) Cc) (PairAlg.smul (C p.T) A)
  let xQ := PairAlg.sub (PairAlg.smul (C p.Q) Cc) (PairAlg.smul (C p.T) B)
  let a2 := p.dH_dS_hom A B
  let a0 := p.dH_dS_hom xS xQ
  let a1 := PairAlg.sub (PairAlg.sub (p.dH_dS_hom (PairAlg.add A xS) (PairAlg.add B xQ)) a2) a0
  let b2 := p.dH_dQ_hom A B PairAlg.zero
  let b0 := p.dH_dQ_hom xS xQ Cc
  let b1 := PairAlg.add
    (PairAlg.sub (PairAlg.sub (p.dH_dQ_hom (PairAlg.add A xS) (PairAlg.add B xQ) PairAlg.zero) b2)
      (p.dH_dQ_hom xS xQ PairAlg.zero))
    (PairAlg.smul (C (10 * p.inv7) * X) (p.pmul B Cc))
  let d20 := PairAlg.sub (p.pmul a2 b0) (p.pmul a0 b2)
  let d21 := PairAlg.sub (p.pmul a2 b1) (p.pmul a1 b2)
  let d10 := PairAlg.sub (p.pmul a1 b0) (p.pmul a0 b1)
  PairAlg.sub (p.pmul d20 d20) (p.pmul d21 d10)

-- Homomorphism naturality for all CoverParams objects!
section MapLemmas
variable {S : Type*} [CommRing S] (f : R →+* S)

private abbrev fX : R[X] →+* S[X] := Polynomial.mapRingHom f

lemma map_quadU (a0 a1 a2 : R) :
    (quadU a0 a1 a2).map f = quadU (f a0) (f a1) (f a2) := by
  simp [quadU]

lemma map_bW : p.bW.map f = (p.map f).bW := by
  rw [bW, Polynomial.map_mul, Polynomial.map_C, Bv, map_quadU]
  simp only [bW, Bv, Av0_inv, Bv0, Bv1, Bv2, inv4, inv9, inv27, inv243, map,
    map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat]

lemma map_cW : p.cW.map f = (p.map f).cW := by
  rw [cW, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
  simp only [cW, Cv0, Av0_inv, inv4, inv243, map,
    map_sub, map_mul, map_pow, map_neg, map_ofNat]

lemma map_ca_h : p.ca_h.map f = (p.map f).ca_h := by
