noncomputable def gCtl (lam : ℝ) : Metric 4
  | 0, 0 => fun _ => -1
  | 1, 1 => fun _ => 1
  | 2, 2 => fun x => 1 + lam ^ 2 * (cos (x 2) ^ 2 * sin (x 2) ^ 2)
