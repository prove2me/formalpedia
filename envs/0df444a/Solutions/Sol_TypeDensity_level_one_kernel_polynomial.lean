    exact ⟨r, hr, hrlen⟩
  choose m hmult hm using hpow
  refine ⟨φ, m, fun s => ⟨hmon s, hirr s⟩, hinj, hslope, hlen, hm, ?_⟩
  set J : ι → Ideal (TypeDensity.BlowupChart R t x) := fun s =>
    TypeDensity.contractedLocalCurveIdeal (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) (g s) 1
  have hJt : ∀ s, TypeDensity.chartBase R t x t ∈ J s := by
    intro s
    change TypeDensity.completedPointMap (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) ∈
