-- title:
--   Every cusp form on $\Gamma_1(M)$ is a combination of shifted newforms
-- statement:
--   Every $g \in S_k(\Gamma_1(M))$ can be written as a finite sum $$g = \sum_i c_i\, \iota_{d_i} F_i,$$ where each $F_i$ is a newform of level $L_i$ with nebentypus $\chi_i$ and $d_iL_i \mid M$. The proof splits $S_k = S_k^{\mathrm{old}} \oplus S_k^{\mathrm{new}}$ and inducts on the level.
--
--   **Formalization note.** This file is a library module of a formalization of the Ramanujan-Petersson conjecture for holomorphic cusp forms on $\Gamma_1(M)$. It contains definitions together with proved lemmas (no `sorry`), so that later solution files can import them.
-- source:
--   F. Diamond and J. Shurman, A First Course in Modular Forms, GTM 228, Springer 2005, doi:10.1007/978-0-387-27226-9, Theorem 5.8.3

import Mathlib
import Definitions.Def_RPLib_S1_Newforms

/-!
# S1-DECOMP: `S_k(Γ₁(M))` is spanned by shifted newforms (DS Thm 5.8.3, spanning form)

Every `g ∈ S_k(Γ₁(M))` is a finite combination `Σ_i c_i · ι_{d_i}(F_i)` with `F_i` a normalised newform
(`RP.Newforms.IsNewform`) of level `L_i`, nebentypus `χ_i` mod `L_i`, and `d_i L_i ∣ M`.
Proof: `S = S^old ⊕ S^new` (Petersson complement, finite dimension); `S^new` is spanned by newforms
(`exists_newform_span` + nebentypus projections); `S^old` is generated by `incl` and `ι_p` of level `M/p` forms,
handled by strong induction on `M` using `ι_d ∘ ι_e = ι_{de}` and `incl ∘ ι_d = ι_d`.

Main results (namespace `RP.Decomposition`):
* `shiftSet M k`, `mem_span_shiftSet` : `g ∈ span (shiftSet M k)`;
* `exists_shift_decomp` : coefficient form with `IsNewform` data;
* `exists_shift_decomp_N2` : coefficient form with the N2 clauses written out (nebentypus on `Γ₀(L_i)`,
  `a_1 = 1`, the recursion at every prime), plus `IsNewform`.
-/

set_option autoImplicit false

open UpperHalfPlane ModularForm CongruenceSubgroup
open scoped MatrixGroups

noncomputable section

namespace RP.Decomposition

open RamanujanPetersson RamanujanPetersson.Diamond RamanujanPetersson.HeckeAlgebra
  RP.Petersson RP.Adjoint RP.Eigenbasis RP.Newforms

/-- The shifted normalised newforms `ι_d F ∈ S_k(Γ₁(M))`, `F` a newform of level `L`, `d L ∣ M`. -/
def shiftSet (M : ℕ) (k : ℤ) : Set (S1 M k) :=
  {h | ∃ (L d : ℕ) (_ : NeZero L) (_ : NeZero d) (hdL : d * L ∣ M) (χ : DirichletCharacter ℂ L)
      (F : S1 L k), IsNewform χ F ∧ h = Level.iotaCF d hdL k F}

variable {M : ℕ} {k : ℤ}

/-! ## `S = S^old + S^new` -/

theorem exists_old_add_new [NeZero M] (g : S1 M k) :
    ∃ go ∈ oldSpace M k, ∃ gn ∈ newSpace M k, g = go + gn := by
  have := finiteDimensional_PS (M := M) k
  have hK : (oldSpace M k).map (toPS M k).toLinearMap ⊔ ((oldSpace M k).map (toPS M k).toLinearMap)ᗮ = ⊤ :=
    Submodule.sup_orthogonal_of_hasOrthogonalProjection
  have hg : toPS M k g ∈ (oldSpace M k).map (toPS M k).toLinearMap ⊔
      ((oldSpace M k).map (toPS M k).toLinearMap)ᗮ := by
    rw [hK]; exact Submodule.mem_top
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.1 hg
  obtain ⟨f, hf, rfl⟩ := Submodule.mem_map.1 hy
  refine ⟨f, hf, (toPS M k).symm z, ?_, ?_⟩
  · rw [newSpace, mem_perp]
    intro f' hf'
    have h0 := (Submodule.mem_orthogonal _ _).1 hz ((toPS M k).toLinearMap f')
      (Submodule.mem_map_of_mem hf')
    rw [← inner_toPS, LinearEquiv.apply_symm_apply]
    exact h0
  · apply (toPS M k).injective
    rw [map_add, LinearEquiv.apply_symm_apply]
    exact hyz.symm

theorem oldSpace_sup_newSpace [NeZero M] : oldSpace M k ⊔ newSpace M k = ⊤ := by
  refine eq_top_iff.2 fun g _ => ?_
  obtain ⟨go, hgo, gn, hgn, rfl⟩ := exists_old_add_new g
  exact Submodule.add_mem_sup hgo hgn

/-! ## Generators -/

lemma mem_shiftSet_of_isNewform [NeZero M] {χ : DirichletCharacter ℂ M} {F : S1 M k}
    (hF : IsNewform χ F) : F ∈ shiftSet M k := by
  refine ⟨M, 1, inferInstance, inferInstance, by rw [one_mul], χ, F, hF, ?_⟩
  rw [Level.iotaCF_one (dvd_refl M) k, Level.inclCF_refl, LinearMap.id_apply]

lemma inclP_mem_shiftSet {p : ℕ} (hp : p ∈ M.primeFactors) {h : S1 (M / p) k}
    (hh : h ∈ shiftSet (M / p) k) : inclP M k p h ∈ shiftSet M k := by
  obtain ⟨L, d, hL, hd, hdL, χ, F, hF, rfl⟩ := hh
  have hpM : p ∣ M := Nat.dvd_of_mem_primeFactors hp
  refine ⟨L, d, hL, hd, hdL.trans (Nat.div_dvd_of_dvd hpM), χ, F, hF, ?_⟩
  rw [inclP_eq M k hpM, ← LinearMap.comp_apply, Level.inclCF_comp_iotaCF]

lemma iotaP_mem_shiftSet {p : ℕ} (hp : p ∈ M.primeFactors) {h : S1 (M / p) k}
    (hh : h ∈ shiftSet (M / p) k) : MainLemma.iotaP M p k h ∈ shiftSet M k := by
  obtain ⟨L, d, hL, hd, hdL, χ, F, hF, rfl⟩ := hh
  have hpr : p.Prime := Nat.prime_of_mem_primeFactors hp
  have hpM : p ∣ M := Nat.dvd_of_mem_primeFactors hp
  have : NeZero p := ⟨hpr.ne_zero⟩
  refine ⟨L, p * d, hL, inferInstance,
    Level.mul_mul_dvd_of_dvd hdL (MainLemmaA.mul_div_dvd_self hpM), χ, F, hF, ?_⟩
  rw [MainLemma.iotaP_eq M k hpr hpM, ← LinearMap.comp_apply, Level.iotaCF_comp_iotaCF]

/-- The new space is spanned by newforms of level `M` (`d = 1`). -/
theorem newSpace_le_span [NeZero M] : newSpace M k ≤ Submodule.span ℂ (shiftSet M k) := by
  intro f hf
  have hsum := (newSpace_eq_sum_proj hf).1
  rw [hsum]
  refine Submodule.sum_mem _ fun χ _ => ?_
  obtain ⟨s, -, hs, hspan⟩ := exists_newform_span (k := k) χ
  have h := (newSpace_eq_sum_proj hf).2 χ
  rw [← hspan] at h
  exact Submodule.span_mono (fun F hF => mem_shiftSet_of_isNewform (hs F hF)) h

/-- The old space is spanned by shifted newforms, given the result at the levels `M / p`. -/
theorem oldSpace_le_span [NeZero M]
    (ih : ∀ p ∈ M.primeFactors, ∀ h : S1 (M / p) k, h ∈ Submodule.span ℂ (shiftSet (M / p) k)) :
    oldSpace M k ≤ Submodule.span ℂ (shiftSet M k) := by
  refine iSup₂_le fun p hp => sup_le ?_ ?_
  · rintro _ ⟨h, rfl⟩
    have h1 := Submodule.mem_map_of_mem (f := inclP M k p) (ih p hp h)
    rw [Submodule.map_span] at h1
    have hsub : (inclP M k p : S1 (M / p) k → S1 M k) '' shiftSet (M / p) k ⊆ shiftSet M k := by
      rintro _ ⟨x, hx, rfl⟩
      exact inclP_mem_shiftSet hp hx
    exact Submodule.span_mono hsub h1
  · rintro _ ⟨h, rfl⟩
    have h1 := Submodule.mem_map_of_mem (f := MainLemma.iotaP M p k) (ih p hp h)
    rw [Submodule.map_span] at h1
    have hsub : (MainLemma.iotaP M p k : S1 (M / p) k → S1 M k) '' shiftSet (M / p) k ⊆ shiftSet M k := by
      rintro _ ⟨x, hx, rfl⟩
      exact iotaP_mem_shiftSet hp hx
    exact Submodule.span_mono hsub h1

/-! ## Main theorem -/

theorem mem_span_shiftSet_aux (k : ℤ) :
    ∀ M : ℕ, 0 < M → ∀ g : S1 M k, g ∈ Submodule.span ℂ (shiftSet M k) := by
  intro M
  induction M using Nat.strong_induction_on with
  | _ M ih =>
    intro hM g
    have : NeZero M := ⟨hM.ne'⟩
    obtain ⟨go, hgo, gn, hgn, rfl⟩ := exists_old_add_new g
    refine Submodule.add_mem _ (oldSpace_le_span (fun p hp h => ?_) hgo) (newSpace_le_span hgn)
    have hpM := Nat.dvd_of_mem_primeFactors hp
    have hpr := Nat.prime_of_mem_primeFactors hp
    exact ih (M / p) (Nat.div_lt_self hM hpr.one_lt)
      (Nat.div_pos (Nat.le_of_dvd hM hpM) hpr.pos) h

/-- **Spanning by shifted newforms**: `S_k(Γ₁(M)) = span {ι_d F}`. -/
theorem mem_span_shiftSet (M : ℕ) [NeZero M] (k : ℤ) (g : S1 M k) :
    g ∈ Submodule.span ℂ (shiftSet M k) :=
  mem_span_shiftSet_aux k M (Nat.pos_of_ne_zero (NeZero.ne M)) g

/-- **Coefficient form**: `a_n(g) = Σ_i c_i · a_{n/d_i}(F_i)` with newforms `F_i`. -/
theorem exists_shift_decomp (M : ℕ) [NeZero M] (k : ℤ) (g : S1 M k) :
    ∃ (r : ℕ) (c : Fin r → ℂ) (d L : Fin r → ℕ) (χ : (i : Fin r) → DirichletCharacter ℂ (L i))
      (F : (i : Fin r) → S1 (L i) k),
      (∀ i, 0 < d i ∧ 0 < L i ∧ d i * L i ∣ M) ∧
      (∀ i, ∃ _ : NeZero (L i), IsNewform (χ i) (F i)) ∧
      ∀ n : ℕ, (qExpansion 1 g).coeff n =
        ∑ i, c i * (if d i ∣ n then (qExpansion 1 (F i)).coeff (n / d i) else 0) := by
  obtain ⟨r, c, h, hsum⟩ := Submodule.mem_span_set'.1 (mem_span_shiftSet M k g)
  have hmem : ∀ i, ∃ (L d : ℕ) (_ : NeZero L) (_ : NeZero d) (hdL : d * L ∣ M)
      (χ : DirichletCharacter ℂ L) (F : S1 L k),
      IsNewform χ F ∧ (h i : S1 M k) = Level.iotaCF d hdL k F := fun i => (h i).2
  choose L d hL hd hdL χ F hF hhF using hmem
  refine ⟨r, c, d, L, χ, F, fun i => ⟨Nat.pos_of_ne_zero (hd i).out, Nat.pos_of_ne_zero (hL i).out, hdL i⟩,
    fun i => ⟨hL i, hF i⟩, fun n => ?_⟩
  conv_lhs => rw [← hsum, ← csL_apply]
  rw [map_sum, Finset.sum_apply]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, Pi.smul_apply, csL_apply, hhF i, Level.coeff_iotaCF, smul_eq_mul]

/-- **N2 shape**: every clause of the N2 statement except Li's bad-prime bound, with the nebentypus on
`Γ₀(L_i)` written exactly as in N2, plus `IsNewform` (for the bad-prime bound). -/
theorem exists_shift_decomp_N2 (M : ℕ) (hM : 0 < M) (k : ℤ)
    (g : CuspForm ((CongruenceSubgroup.Gamma1 M : Subgroup SL(2, ℤ)) : Subgroup (GL (Fin 2) ℝ)) k) :
    ∃ (r : ℕ) (c : Fin r → ℂ) (d L : Fin r → ℕ) (χ : (i : Fin r) → DirichletCharacter ℂ (L i))
      (F : (i : Fin r) → CuspForm ((CongruenceSubgroup.Gamma1 (L i) : Subgroup SL(2, ℤ)) :
        Subgroup (GL (Fin 2) ℝ)) k),
      (∀ i, 0 < d i ∧ 0 < L i ∧ d i * L i ∣ M) ∧
      (∀ i, ∀ γ ∈ CongruenceSubgroup.Gamma0 (L i),
        (⇑(F i) ∣[k] γ) = χ i ((γ 1 1 : ℤ) : ZMod (L i)) • ⇑(F i)) ∧
      (∀ i, (qExpansion 1 (F i)).coeff 1 = 1) ∧
      (∀ i, ∀ p n : ℕ, p.Prime →
        (qExpansion 1 (F i)).coeff (p * n) =
          (qExpansion 1 (F i)).coeff p * (qExpansion 1 (F i)).coeff n -
            (if p ∣ L i then 0 else
              χ i (p : ZMod (L i)) * (p : ℂ) ^ (k - 1) *
                (if p ∣ n then (qExpansion 1 (F i)).coeff (n / p) else 0))) ∧
      (∀ i, ∃ _ : NeZero (L i), IsNewform (χ i) (F i)) ∧
      ∀ n : ℕ, (qExpansion 1 g).coeff n =
        ∑ i, c i * (if d i ∣ n then (qExpansion 1 (F i)).coeff (n / d i) else 0) := by
  have : NeZero M := ⟨hM.ne'⟩
  obtain ⟨r, c, d, L, χ, F, hdL, hNF, hco⟩ := exists_shift_decomp M k g
  refine ⟨r, c, d, L, χ, F, hdL, fun i => ?_, fun i => ?_, fun i => ?_, hNF, hco⟩
  · obtain ⟨_, hF⟩ := hNF i
    exact hF.mem_chi
  · obtain ⟨_, hF⟩ := hNF i
    exact hF.coeff_one
  · obtain ⟨_, hF⟩ := hNF i
    exact hF.recursion

end RP.Decomposition


