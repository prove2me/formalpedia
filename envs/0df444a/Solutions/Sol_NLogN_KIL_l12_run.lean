  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18⟩ :=
    binBounds hP hg hS hT hTQ
  simp +decide only [PadE, RegsIn, NE.regs, NE.OK, NE.val, NLogN.KIL.xA, bA, NLogN.KIL.zA, NLogN.KIL.tA, yB, NLogN.KIL.bB, NLogN.KIL.zB, tB, tUB, tUA,
    vP, vG, vS, vT, vQ, FP, FG, FS, List.mem_cons, List.mem_append, List.not_mem_nil, or_false,
    forall_eq_or_imp, forall_eq, List.cons.injEq, true_and, exists_eq', and_true, or_true,
    not_false_eq_true]
  simp +decide only [or_assoc, forall_eq_or_imp, forall_eq, true_or, true_and, vP, vG, vS, vT, vQ,
    FP, FG, FS, List.cons.injEq, exists_eq', and_true, or_true]
  and_intros <;> omega

