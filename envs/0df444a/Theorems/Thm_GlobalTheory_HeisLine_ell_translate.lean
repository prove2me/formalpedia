theorem GlobalTheory.HeisLine.ell_translate
    (h1 : ∀ (a a' b b' : SB (n → k)) (t : n → k), (∀ y, a'.1 y = (χ (t ⬝ᵥ y) : ℂ) * a.1 y) →
      (∀ η, b'.1 η = b.1 (η - t)) → B a' b = B a b')
    (g : SB (n → k)) (u : n → k) (hg' : (fun x => g.1 (x + u)) ∈ SB (n → k)) :
    ell χ μ B ⟨_, hg'⟩ = ell χ μ B g := by sorry
