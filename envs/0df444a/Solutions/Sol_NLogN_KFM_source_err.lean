open Complex
variable {ι κ : Type*} [Fintype ι] [Fintype κ]
theorem solution (p : ℕ) (γ : ℕ) {A : (κ → ℂ) → (ι → ℂ)} {QF : (ι → ℂ) → (ι → ℂ)}
    {B0 : (ι → ℂ) → (κ → ℂ)} (hA : NLogN.KFM.LinC A) (hQF : NLogN.KFM.LinC QF) (hB : NLogN.KFM.LinC B0)
    {At : (κ → ℂ) → (ι → ℂ)} {Ct : (ι → ℂ) → (ι → ℂ)} {B0t : (ι → ℂ) → (κ → ℂ)}
    (εA Ec εB : ℝ)
    (hAt : ∀ u, NLogN.KFM.Grid p u → ‖u‖ ≤ 1 / 2 → ‖At u - A u‖ ≤ εA * NLogN.KFM.hp p ∧ NLogN.KFM.Grid p (At u))
    (hCt : ∀ x, NLogN.KFM.Grid p x → ‖x‖ ≤ 6 / 10 → ‖Ct x - QF x‖ ≤ Ec * NLogN.KFM.hp p ∧ ‖Ct x‖ ≤ 1 ∧ NLogN.KFM.Grid p (Ct x))
    (hBt : ∀ y, NLogN.KFM.Grid p y → ‖y‖ ≤ 1 → ‖B0t y - B0 y‖ ≤ εB * NLogN.KFM.hp p)
    (hεA : εA * NLogN.KFM.hp p ≤ 1 / 10)
    {u : κ → ℂ} (hu : NLogN.KFM.Grid p u) (hu1 : ‖u‖ ≤ 1 / 2) :
    ‖(2 : ℂ) ^ γ • B0t (Ct (At u)) - (2 : ℂ) ^ γ • B0 (QF (A u))‖ ≤
      2 ^ γ * ((εA + Ec + εB) * NLogN.KFM.hp p) := by
  obtain ⟨eA, gA⟩ := hAt u hu hu1
  have nA : ‖At u‖ ≤ 6 / 10 := by
    have := norm_sub_norm_le (At u) (A u)
    have := hA.le u
    linarith
  obtain ⟨eC, nC, gC⟩ := hCt (At u) gA nA
  have eB := hBt (Ct (At u)) gC nC
  rw [← smul_sub, norm_smul, norm_pow, Complex.norm_ofNat]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  have e1 : B0t (Ct (At u)) - B0 (QF (A u)) = (B0t (Ct (At u)) - B0 (Ct (At u))) +
      (B0 (Ct (At u)) - B0 (QF (At u))) + (B0 (QF (At u)) - B0 (QF (A u))) := by abel
  rw [e1]
  have t2 : ‖B0 (Ct (At u)) - B0 (QF (At u))‖ ≤ Ec * NLogN.KFM.hp p := (hB.err _ _).trans eC
  have t3 : ‖B0 (QF (At u)) - B0 (QF (A u))‖ ≤ εA * NLogN.KFM.hp p :=
    (hB.err _ _).trans ((hQF.err _ _).trans eA)
  calc _ ≤ _ := norm_add₃_le
    _ ≤ εB * NLogN.KFM.hp p + Ec * NLogN.KFM.hp p + εA * NLogN.KFM.hp p := add_le_add (add_le_add eB t2) t3
    _ = (εA + Ec + εB) * NLogN.KFM.hp p := by ring
end
