open J6Seg J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ}

theorem J6Seg.Ax.arr_lens (h : AxReg P n src D k) (L : List GI)
    (hL : L.length = axpre6 P n D k * (axnc6 P n k * axl6 P n * axpost6 P n D k)) :
    let pre := axpre6 P n D k; let post := axpost6 P n D k; let N := axnc6 P n k * axl6 P n
    let G := axG6 P n src k
    (arrS6 P n src D k L).length = pre * (N * post) ∧
    (arrY6 P n src D k L).length = pre * (N * post) ∧
    (arrJ6 P n src D k L).length = pre * (G * post) ∧
    (arrW6 P n src D k L).length = pre * (G * post) ∧
    (arrWp6 P n src D k L).length = pre * (N * post) ∧
    (arrY26 P n src D k L).length = pre * (N * post) := by sorry
