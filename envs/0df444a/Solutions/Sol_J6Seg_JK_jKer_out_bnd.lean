section
-- Source module: Solutions.J6SegPart
/-!
# Segmented inverse (S2): the block-partition constructor

`mkBlocks s t lam w`: cut `[0, s)` at `0`, at every multiple of `lam`, and after every wrap step
(`bOf (l+1) ≠ bOf l + (t - s)`); the block of `i` starts at the last cut `≤ i` (`Nat.findGreatest`)
and ends before the next cut (`Nat.find`). All computable.

* `mkBlocks_ok`: `BlocksOK s t (mkBlocks s t lam w)` for `1 ≤ lam`, `w ≤ s`;
* `mkBlocks_len`: every block has length `≤ lam`;
* `Jlist_length_le`: `|J| ≤ s`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf

section part
variable (s t lam : ℕ)

variable {s t lam}

lemma cutP_zero : cutP s t lam 0 := Or.inl rfl

lemma stF_le (i : ℕ) : stF s t lam i ≤ i := Nat.findGreatest_le i

lemma stF_cut (i : ℕ) : cutP s t lam (stF s t lam i) :=
  Nat.findGreatest_spec (Nat.zero_le i) cutP_zero

lemma not_cut_of_lt_en {c k : ℕ} (hk : k < enF s t lam c) :
    ¬ cutP s t lam (c + 1 + k) ∧ c + 1 + k < s := by
  have := Nat.find_min (enF_ex s t lam c) hk
  push Not at this
  exact ⟨this.1, this.2⟩

lemma en_ge {c i : ℕ} (hci : c ≤ i) (hi : i < s)
    (hnc : ∀ j, c < j → j ≤ i → ¬ cutP s t lam j) : i - c ≤ enF s t lam c := by
  by_contra h
  push Not at h
  have := Nat.find_spec (enF_ex s t lam c)
  rcases this with h1 | h1
  · exact hnc _ (by omega) (by unfold enF at h; omega) h1
  · unfold enF at h; omega

lemma en_le_s {c : ℕ} (hc : c < s) : c + 1 + enF s t lam c ≤ s := by
  have := Nat.find_min' (enF_ex s t lam c) (show cutP s t lam (c + 1 + (s - c - 1)) ∨
    s ≤ c + 1 + (s - c - 1) from Or.inr (by omega))
  unfold enF; omega

lemma en_le_lam (hl : 1 ≤ lam) (c : ℕ) : enF s t lam c ≤ lam - 1 := by
  have hm : (c + 1 + (lam - c % lam - 1)) % lam = 0 := by
    have h1 : c % lam < lam := Nat.mod_lt _ (by omega)
    have h2 : c + 1 + (lam - c % lam - 1) = lam * (c / lam + 1) := by
      have := Nat.div_add_mod c lam
      rw [Nat.mul_add, mul_one]; omega
    rw [h2, Nat.mul_mod_right]
  have := Nat.find_min' (enF_ex s t lam c) (Or.inl (Or.inr (Or.inl hm)))
  unfold enF; omega

/-- **The constructed blocks are valid.** -/
theorem mkBlocks_ok (hs : 0 < s) (w : ℕ) (hw : w ≤ s) : BlocksOK s t (mkBlocks s t lam w) := by
  have hstart : ∀ i, i < s → ∀ j, stF s t lam i < j → j ≤ i → ¬ cutP s t lam j :=
    fun i _ j h1 h2 => Nat.findGreatest_is_greatest h1 h2
  have hcov : ∀ i < s, stF s t lam i ≤ i ∧ i < stF s t lam i + (1 + enF s t lam (stF s t lam i)) ∧
      stF s t lam i + (1 + enF s t lam (stF s t lam i)) ≤ s := by
    intro i hi
    have h1 := stF_le (s := s) (t := t) (lam := lam) i
    have h2 := en_ge h1 hi (hstart i hi)
    have h3 := en_le_s (s := s) (t := t) (lam := lam) (show stF s t lam i < s by omega)
    refine ⟨h1, by omega, by omega⟩
  refine ⟨rfl, hcov, ?_, ?_, hw⟩
  · intro i hi k hk1 hk2
    simp only [mkBlocks] at hk1 hk2 ⊢
    set c := stF s t lam i
    have hsk : stF s t lam k = c := by
      unfold stF
      rw [Nat.findGreatest_eq_iff]
      refine ⟨hk1, fun _ => stF_cut i, fun j hj hjk hcj => ?_⟩
      have := (not_cut_of_lt_en (s := s) (t := t) (lam := lam) (c := c) (k := j - c - 1)
        (by omega)).1
      rw [show c + 1 + (j - c - 1) = j by omega] at this
      exact this hcj
    exact ⟨hsk, by rw [hsk]⟩
  · intro i hi j hj
    simp only [mkBlocks] at hj ⊢
    set c := stF s t lam i
    have h := (not_cut_of_lt_en (s := s) (t := t) (lam := lam) (c := c) (k := j) (by omega)).1
    unfold cutP at h
    push Not at h
    have h2 := h.2.2
    rw [show c + 1 + j - 1 = c + j by omega] at h2
    unfold stepOK at h2
    have e1 : ((c : ℤ) + j + 1) = ((c + j : ℕ) : ℤ) + 1 := by push_cast; ring
    have e2 : ((c : ℤ) + j) = ((c + j : ℕ) : ℤ) := by push_cast; ring
    rw [e1, e2]; exact h2

theorem mkBlocks_len (hl : 1 ≤ lam) (w i : ℕ) : (mkBlocks s t lam w).len i ≤ lam := by
  simp only [mkBlocks]
  have := en_le_lam (s := s) (t := t) hl (stF s t lam i)
  omega

lemma Jlist_length_le (B : Blocks) : (Jlist B).length ≤ B.s := by
  unfold Jlist
  exact (List.length_filter_le _ _).trans (by simp)

end part

end J6Seg

