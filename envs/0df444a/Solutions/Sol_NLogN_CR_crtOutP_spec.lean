    apply List.map_congr_left
    intro q hq
    have := hK q (List.mem_range.1 hq)
    rw [List.getD_eq_getElem _ _ (by simpa using this), List.getD_eq_getElem _ _ this]
    simp
  rw [e, flatten_map_single]

theorem invL_length (s : List ℕ) : (invL s).length = s.prod := by simp [invL]

theorem invL_nodup {s : List ℕ} (h : CrtOK s) : (invL s).Nodup := by
  refine List.Nodup.map_on ?_ List.nodup_range
  intro x hx y hy hxy
  rw [← crtKey_crtIdx h x (List.mem_range.1 hx), ← crtKey_crtIdx h y (List.mem_range.1 hy), hxy]

theorem invL_perm {s : List ℕ} (h : CrtOK s) : (invL s).Perm (List.range s.prod) := by
  have := perm_range_of_nodup (invL_nodup h) (fun x hx => by
    rw [invL_length]
    simp only [invL, List.mem_map] at hx
    obtain ⟨k, _, rfl⟩ := hx
    exact crtIdx_lt h.2 _)
