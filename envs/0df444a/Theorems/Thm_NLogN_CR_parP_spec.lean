theorem NLogN.CR.parP_spec (K N nb : ℕ) (hK : 1 ≤ K) (hN : 1 ≤ N) (hnb : N < 2 ^ nb) (s : IState HS)
    (LN LNb : List Item) (hsN : s.G rN = .int N :: LN) (hsNb : s.G rNb = .int nb :: LNb) :
    (parP K).ok s ∧ (parP K).run s = parOut s K N := by sorry
