-- Source module: Solutions.KFHRec
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

/-- Disk outputs truncate to numerators of at most `p + 1` bits. -/
theorem GB_trunc_disk {r p : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r p zs xs)
    (hd : ∀ j (hj : j < xs.length) c, ‖xs[j] c‖ ≤ 1) : NLogN.KFB.GB (p + 1) zs := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hr : 0 < r := by
    have h1 : zs.length = xs.length * r := h.1
    have : xs.length * r ≠ 0 := by omega
    exact Nat.pos_of_ne_zero (right_ne_zero_of_mul this)
  set j := i / r
  have hj : j < xs.length := by
    rw [h.1] at hi; exact (Nat.div_lt_iff_lt_mul hr).2 hi
  set c : Fin r := ⟨i % r, Nat.mod_lt _ hr⟩
  have hi' : i = j * r + c := by simp [j, c, Nat.div_add_mod']
  have e := h.2 j c hj
  rw [← hi', List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj] at e
  have hn := hd j hj c
  have hz : ‖NLogN.KFB.toC zs[i]‖ ≤ 2 ^ p := by
    rw [e, norm_mul]; simp only [norm_pow, Complex.norm_ofNat]
    calc (2 : ℝ) ^ p * ‖xs[j] c‖ ≤ 2 ^ p * 1 := by gcongr
      _ = 2 ^ p := mul_one _
  have k : ∀ a : ℤ, |(a : ℝ)| ≤ 2 ^ p → zsz a ≤ p + 1 := by
    intro a ha
    apply zsz_le_of_lt
    have : (a.natAbs : ℝ) ≤ 2 ^ p := by rw [Nat.cast_natAbs]; exact_mod_cast ha
    have : a.natAbs ≤ 2 ^ p := by exact_mod_cast this
    rw [pow_succ]; have := Nat.one_le_two_pow (n := p); omega
  have hre : (NLogN.KFB.toC zs[i]).re = zs[i].1 := by simp [NLogN.KFB.toC]
  have him : (NLogN.KFB.toC zs[i]).im = zs[i].2 := by simp [NLogN.KFB.toC]
  constructor
  · apply k; rw [← hre]; exact (Complex.abs_re_le_norm _).trans hz
  · apply k; rw [← him]; exact (Complex.abs_im_le_norm _).trans hz

end NLogN.KFH

end

