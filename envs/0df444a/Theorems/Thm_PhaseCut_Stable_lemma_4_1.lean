-- title:
--   Lemma 4.1, p. 10 — for V ⪰ 0, Tr(V(I − AA†)) = d₁(V, F)
-- statement:
--   Let $A \in \mathbb{C}^{n\times p}$, let $AA^\dagger$ be the orthogonal projector onto $\mathcal{R}(A)$, let $\mathcal{F} = \{V \in \mathbf{H}_n : x^*Vx = 0 \ \forall x \in \mathcal{R}(A)^\perp\}$, and let $d_1$ be the distance generated by the trace norm $\|X\|_1 = \operatorname{Tr}\sqrt{X^*X}$. Then for every Hermitian positive semidefinite $V \in \mathbf{H}_n$,
--   $$\operatorname{Tr}\big(V(I - AA^\dagger)\big) = d_1(V, \mathcal{F}). \tag{12}$$
--
--   This identity turns the PhaseCut objective $\operatorname{Tr}(V(I - AA^\dagger))$ into a distance, so that PhaseCut becomes the projection problem (13) of the positive semidefinite section $\mathbf{H}_n^+ \cap \mathcal{H}_b$ onto the face $\mathcal{F}$.
--
--   **Formalization Note.** The identity is stated in $\mathbb{C}$: the trace on the left equals the real number $d_1(V,\mathcal{F})$ cast to $\mathbb{C}$, so the statement also asserts that this trace is real. No injectivity of $A$ is assumed.
-- source:
--   Waldspurger, d'Aspremont & Mallat, arXiv:1206.0102v3, Lemma 4.1, Eq. (12), p. 10

import Mathlib
import Definitions.Def_PhaseCut_Stable_Defs

namespace PhaseCut.Stable

open Matrix
open scoped ComplexOrder


/-- **Lemma 4.1** (p. 10). For every `V ∈ 𝐇ₙ` with `V ⪰ 0`, `Tr(V(I − AA†)) = d₁(V, F)`, where `d₁`
is the distance generated by the trace norm. Stated in `ℂ`, so the trace is also asserted to be real. -/
theorem lemma_4_1 {n p : ℕ} (A : Matrix (Fin n) (Fin p) ℂ) (V : Matrix (Fin n) (Fin n) ℂ)
    (hV : V.PosSemidef) :
    (V * (1 - projRange A)).trace = ((d1 A V : ℝ) : ℂ) := by sorry
end PhaseCut.Stable
