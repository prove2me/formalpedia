-- title:
--   Proof of Theorem 3.2, p. 6 — ‖x_n − z‖² + 2λ⟨F(z), x_{n−1} − z⟩ converges for every z ∈ S
-- statement:
--   Under the assumptions of Theorem 3.2, let $(x_n),(y_n)$ be generated by Algorithm 3.1. Then for every $z\in S$ the real sequence
--   $$\|x_n-z\|^2+2\lambda\langle F(z),x_{n-1}-z\rangle\qquad(n\ge1)$$
--   converges.
--
--   This replaces the convergence of $\|x_n-z\|$ in the classical Opial argument: the extra term $2\lambda\langle F(z),x_{n-1}-z\rangle$ is what makes the Lyapunov quantity monotone.
--
--   **Formalization Note.** The sequence is indexed by $n+1$, $n\ge0$, so that no natural-number subtraction occurs; an index shift does not change convergence.
-- source:
--   Malitsky, Projected Reflected Gradient Methods for Monotone Variational Inequalities, arXiv:1502.04968v1, p. 6, proof of Theorem 3.2

import Mathlib
import Definitions.Def_ProjReflGrad_Weak_Setting

namespace ProjReflGrad.Weak

/-- Proof of Theorem 3.2 (Malitsky 2015, p. 6): for every `z ∈ S` the sequence
`‖x_n - z‖² + 2λ⟨F(z), x_{n-1} - z⟩` converges (indexed here by `n + 1`). -/
theorem energy_converges {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H]
    (C : Set H) (hCcl : IsClosed C) (hCcv : Convex ℝ C) (F : H → H) (L lam : ℝ)
    (hC1 : (solSet C F).Nonempty) (hC2 : IsMonotoneMap F) (hL : 0 < L) (hC3 : IsLipschitzMap F L)
    (hlam0 : 0 < lam) (hlam1 : lam < (Real.sqrt 2 - 1) / L)
    (x y : ℕ → H) (hrun : IsPRGRun C F lam x y) :
    ∀ z ∈ solSet C F, ∃ l : ℝ,
      Filter.Tendsto (fun n => ‖x (n + 1) - z‖ ^ 2 + 2 * lam * inner ℝ (F z) (x n - z))
        Filter.atTop (nhds l) := by sorry

end ProjReflGrad.Weak
