theorem sizeReduce_foldl_size_reduced {n m : Nat}
    (k : Nat) (hk : k < n) :
    ∀ (xs : List (Fin k)),
      xs.Pairwise (fun a b : Fin k => b.val < a.val) →
      ∀ (s' : LLLState n m), s'.Valid → s'.b.independent →
        ∀ e ∈ xs,
          2 * Int.natAbs
              (((xs.foldl
                  (fun state j =>
                    let jFin : Fin n := ⟨j.val, Nat.lt_trans j.isLt hk⟩
                    state.sizeReduceColumn jFin ⟨k, hk⟩ j.isLt)
                  s').ν.getRow ⟨k, hk⟩).get
                ⟨e.val, Nat.lt_trans e.isLt hk⟩) ≤
            s'.d.get ⟨e.val + 1, Nat.succ_lt_succ (Nat.lt_trans e.isLt hk)⟩ := by sorry
