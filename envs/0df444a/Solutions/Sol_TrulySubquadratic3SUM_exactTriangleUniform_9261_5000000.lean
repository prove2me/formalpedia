    (done : ∀ μ' : ℕ → ℤ, I n μ' → Q ⟨Light.frame (setLocal l i n), μ'⟩)
    (bound : ∀ (j : ℕ) (μ' : ℕ → ℤ), j ≤ n → I j μ' →
