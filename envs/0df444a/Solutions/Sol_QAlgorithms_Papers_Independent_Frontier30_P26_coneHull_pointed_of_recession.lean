variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

lemma rec_nat {C : Set E} {v : E} (hv : v ∈ recession C) {c : E} (hc : c ∈ C) :
    ∀ n : ℕ, c + (n : ℝ) • v ∈ C := by
  intro n
  induction n with
  | zero => simpa using hc
  | succ k ih =>
    have := hv _ ih
    convert this using 1
    push_cast; rw [add_smul, one_smul, add_assoc]

lemma rec_smul {C : Set E} (hconv : Convex ℝ C) {v : E} (hv : v ∈ recession C) {c : E}
    (hc : c ∈ C) {s : ℝ} (hs : 0 ≤ s) : c + s • v ∈ C := by
  obtain ⟨n, hn⟩ := exists_nat_ge s
  rcases hs.eq_or_lt with h0 | hpos
  · rw [← h0, zero_smul, add_zero]; exact hc
  have hnpos : (0 : ℝ) < n := lt_of_lt_of_le hpos hn
  have h1 := rec_nat hv hc n
  have h2 := hconv.add_smul_mem hc (y := (n : ℝ) • v) h1 (t := s / n)
    ⟨div_nonneg hs hnpos.le, (div_le_one hnpos).mpr hn⟩
  convert h2 using 2
  rw [smul_smul, div_mul_cancel₀ _ hnpos.ne']

/-- the cone generated by C -/
def coneOf (C : Set E) : Set E := {x | ∃ t : ℝ, 0 ≤ t ∧ ∃ c ∈ C, x = t • c}

lemma closure_coneOf {C : Set E} (hcl : IsClosed C) (hconv : Convex ℝ C) (h0 : (0 : E) ∉ C)
    {x : E} (hx : x ∈ closure (coneOf C)) : x ∈ coneOf C ∨ x ∈ recession C := by
  obtain ⟨u, huA, hu⟩ := mem_closure_iff_seq_limit.mp hx
  choose t ht c hc hut using huA
  obtain ⟨f, s, hf0, hfC⟩ := geometric_hahn_banach_point_closed hconv hcl h0
  rw [map_zero] at hf0
  have hfu : Tendsto (fun n => f (u n)) atTop (𝓝 (f x)) := (f.continuous.tendsto x).comp hu
  obtain ⟨B, hB⟩ := hfu.bddAbove_range
  have htB : ∀ n, t n ∈ Icc 0 (B / s) := by
    intro n
    refine ⟨ht n, ?_⟩
    rw [le_div_iff₀ hf0]
    have h1 : f (u n) ≤ B := hB ⟨n, rfl⟩
    have h2 : f (u n) = t n * f (c n) := by rw [hut n, map_smul, smul_eq_mul]
    have h3 := hfC _ (hc n)
    nlinarith [ht n]
  obtain ⟨t0, ht0, φ, hφ, htφ⟩ := isCompact_Icc.tendsto_subseq htB
  have huφ : Tendsto (u ∘ φ) atTop (𝓝 x) := hu.comp hφ.tendsto_atTop
  rcases ht0.1.eq_or_lt with h00 | hpos
  · right
    intro c' hc'
    have htφ0 : Tendsto (fun n => t (φ n)) atTop (𝓝 0) := h00 ▸ htφ
    have hw : Tendsto (fun n => (1 - t (φ n)) • c' + u (φ n)) atTop (𝓝 (((1:ℝ) - 0) • c' + x)) := by
      apply Tendsto.add _ huφ
      exact ((tendsto_const_nhds.sub htφ0).smul tendsto_const_nhds)
    rw [sub_zero, one_smul] at hw
    apply hcl.mem_of_tendsto hw
    have hev : ∀ᶠ n in atTop, t (φ n) < 1 := by
      exact htφ0.eventually (gt_mem_nhds (by norm_num))
    filter_upwards [hev] with n hn
    rw [hut (φ n)]
    exact hconv hc' (hc (φ n)) (by linarith) (ht _) (by ring)
  · left
    have hcφ : Tendsto (fun n => (t (φ n))⁻¹ • u (φ n)) atTop (𝓝 (t0⁻¹ • x)) :=
      ((htφ.inv₀ hpos.ne').smul huφ)
    have hmem : t0⁻¹ • x ∈ C := by
      apply hcl.mem_of_tendsto hcφ
      have hev : ∀ᶠ n in atTop, 0 < t (φ n) := htφ.eventually (lt_mem_nhds hpos)
      filter_upwards [hev] with n hn
      rw [hut (φ n), smul_smul, inv_mul_cancel₀ hn.ne', one_smul]
      exact hc _
    exact ⟨t0, hpos.le, _, hmem, by rw [smul_smul, mul_inv_cancel₀ hpos.ne', one_smul]⟩

lemma coneOf_convex {C : Set E} (hconv : Convex ℝ C) : Convex ℝ (coneOf C) := by
  rintro x ⟨t, ht, c, hc, rfl⟩ y ⟨t', ht', c', hc', rfl⟩ a b ha hb hab
  rcases (add_nonneg (mul_nonneg ha ht) (mul_nonneg hb ht')).eq_or_lt with h0 | hpos
  · refine ⟨0, le_rfl, c, hc, ?_⟩
    have h1 : a * t = 0 := by nlinarith [mul_nonneg ha ht, mul_nonneg hb ht']
    have h2 : b * t' = 0 := by nlinarith [mul_nonneg ha ht, mul_nonneg hb ht']
    rw [smul_smul, smul_smul, h1, h2, zero_smul, zero_smul, add_zero]
  · set T := a * t + b * t'
    refine ⟨T, hpos.le, (a * t / T) • c + (b * t' / T) • c', ?_, ?_⟩
    · exact hconv hc hc' (div_nonneg (mul_nonneg ha ht) hpos.le)
        (div_nonneg (mul_nonneg hb ht') hpos.le) (by rw [← add_div]; exact div_self hpos.ne')
    · rw [smul_add, smul_smul, smul_smul, smul_smul, smul_smul, mul_div_cancel₀ _ hpos.ne',
        mul_div_cancel₀ _ hpos.ne']

lemma closure_coneOf_closedCone {C : Set E} (hconv : Convex ℝ C) (hne : C.Nonempty) :
    ClosedCone (closure (coneOf C)) := by
  obtain ⟨c0, hc0⟩ := hne
  refine ⟨isClosed_closure, (coneOf_convex hconv).closure, subset_closure ⟨0, le_rfl, c0, hc0, by simp⟩, ?_⟩
  intro r hr x hx
  have hmaps : MapsTo (fun y : E => r • y) (coneOf C) (coneOf C) := by
    rintro y ⟨t, ht, c, hc, rfl⟩
    exact ⟨r * t, mul_nonneg hr ht, c, hc, by show r • (t • c) = _; rw [smul_smul]⟩
  exact map_mem_closure (continuous_const_smul r) hx hmaps

lemma subset_closure_coneOf (C : Set E) : C ⊆ closure (coneOf C) :=
  fun c hc => subset_closure ⟨1, zero_le_one, c, hc, by simp⟩

end G53Cone

