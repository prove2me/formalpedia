  · have := hs j h1; omega
  · exact hs j h1
  · exact le_refl _

theorem sP_pos (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (j : ℕ) : 1 ≤ sP d sF j := by
  unfold sP; split_ifs with h1
  · exact hs j h1
  · omega

theorem mzP_pos (d h : ℕ) (j : ℕ) : 1 ≤ mzP d h j := by
  unfold mzP; split_ifs
  · exact Nat.one_le_two_pow
  · omega

theorem le_SR (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ 2 ^ h) :
    List.Forall₂ (· ≤ ·) (shR d (sP d sF)) (shR d (NLogN.KFU.tP d h bL)) :=
  forall₂_map_le (fun j _ => sP_le_tP d h bL sF hs j)

theorem le_SK (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ 2 ^ h) :
    List.Forall₂ (· ≤ ·) (shK d (sP d sF)) (shK d (NLogN.KFU.tP d h bL)) :=
  forall₂_map_le (fun j _ => sP_le_tP d h bL sF hs j)

theorem pos_shR (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) : ∀ a ∈ shR d (sP d sF), 1 ≤ a := by
  intro a ha; simp only [shR, List.mem_map] at ha; obtain ⟨j, -, rfl⟩ := ha; exact sP_pos d sF hs j

theorem pos_shK (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) : ∀ a ∈ shK d (sP d sF), 1 ≤ a := by
  intro a ha; simp only [shK, List.mem_map] at ha; obtain ⟨j, -, rfl⟩ := ha; exact sP_pos d sF hs j

theorem shR_split (d : ℕ) (sF : ℕ → ℕ) {i : ℕ} (hi : i < d) :
    shR d (sP d sF) = (List.range i).map sF ++ sF i ::
      (((List.range d).drop (i + 1) ++ [d]).map (sP d sF)) := by
  have e : List.range d = List.range i ++ i :: (List.range d).drop (i + 1) := by
    conv_lhs => rw [← List.take_append_drop i (List.range d)]
    rw [List.take_range, min_eq_left hi.le, List.drop_eq_getElem_cons (by simpa using hi),
      List.getElem_range]
  unfold shR
  conv_lhs => rw [e]
  simp only [List.append_assoc, List.cons_append, List.map_append, List.map_cons]
  congr 1
  · apply List.map_congr_left; intro j hj; simp at hj; simp [sP, show j < d by omega]
  · simp [sP, hi]

theorem valid_rotG {A C : Shape} {Q : ℕ} (hQ : 1 ≤ Q) (f : List ℕ → ℕ) {b : List ℕ}
    (hb : Valid (A ++ Q :: C) b) : Valid (A ++ Q :: C) (NLogN.KFU.rotG A.length Q f b) := by
  have hl : (b.take A.length).length = A.length := by
    have := hb.length_eq; simp at this ⊢; omega
  rw [← List.take_append_drop A.length b] at hb
  obtain ⟨h1, h2⟩ := (KIL.valid_append_iff hl).1 hb
  obtain ⟨y, rest, hd⟩ : ∃ y rest, b.drop A.length = y :: rest := by
    cases e : b.drop A.length with
    | nil => rw [e] at h2; cases h2
    | cons y rest => exact ⟨y, rest, rfl⟩
  rw [hd] at h2
  have hr : b.drop (A.length + 1) = rest := by
    rw [← List.drop_drop, hd]; rfl
  unfold NLogN.KFU.rotG
  rw [hr]
  exact valid_append h1 (.cons (Nat.mod_lt _ (by omega)) (by cases h2; assumption))

theorem valid_gRot (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ) {i : ℕ}
    (hi : i < d) {b : List ℕ} (hb : Valid (shR d (sP d sF)) b) :
    Valid (shR d (sP d sF)) (gRot sF cs i b) := by
  rw [shR_split d sF hi] at hb ⊢
  have := valid_rotG (A := (List.range i).map sF) (hs i hi) (fun a => KIL.lf (cs i) a % sF i) hb
  simpa [gRot] using this

theorem rotI_spec (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ)
    (hcs : ∀ i < d, (cs i).length = i ∧ ∀ c ∈ cs i, c < sF i) (w Bb : ℕ)
    (hBb : zsz ((2 * vol (shR d (sP d sF)) : ℕ) : ℤ) ≤ Bb) {i : ℕ} (hi : i < d)
    (xs : List ℤ) (hlen : xs.length = vol (shR d (sP d sF))) (hb : Bnd w xs)
    (t : IState HS) (R : List Item) (h0 : t.G 0 = ints xs ++ R) :
    IRuns I iprog (rotI d sF cs i) t
      (t.upd 0 (ints (AModel.pull (shR d (sP d sF)) (shR d (sP d sF)) (gRot sF cs i) 0 xs) ++ R))
      (cRb d w (vol (shR d (sP d sF))) (vol ((List.range (d - 1)).map sF)) Bb) := by
  set A := (List.range i).map sF
  set C := ((List.range d).drop (i + 1) ++ [d]).map (sP d sF)
  have hsp := shR_split d sF hi
  have hA : ∀ a ∈ A, 1 ≤ a := by
    intro a ha; simp only [A, List.mem_map, List.mem_range] at ha
    obtain ⟨j, hj, rfl⟩ := ha; exact hs j (by omega)
  have hC : 1 ≤ vol C := one_le_vol _ (fun a ha => by
    simp only [C, List.mem_map] at ha; obtain ⟨j, -, rfl⟩ := ha; exact sP_pos d sF hs j)
  have hVe : vol (shR d (sP d sF)) = vol A * (sF i * vol C) := by rw [hsp, vol_append, vol_cons]
  have hA1 : 1 ≤ vol A := one_le_vol _ hA
  have hAl : A.length = i := by simp [A]
  have H := rotStep_spec (I := I) (iprog := iprog) A C (sF i) (cs i) (by rw [(hcs i hi).1, hAl])
    (hcs i hi).2 hA (hs i hi) w Bb
    (le_trans (KIL.zsz_nat_le (show vol A ≤ 2 * vol (shR d (sP d sF)) by
      have h1 : 1 ≤ sF i * vol C := Nat.mul_pos (hs i hi) hC
      rw [hVe]; nlinarith [Nat.mul_le_mul_left (vol A) h1])) hBb)
    (le_trans (KIL.zsz_nat_le (show 2 * sF i ≤ 2 * vol (shR d (sP d sF)) by
      rw [hVe]; nlinarith [Nat.le_mul_of_pos_right (sF i) hC])) hBb)
    xs (by rw [hlen, hsp]) hb t R h0
  rw [← hsp, hAl] at H
  refine H.mono ?_
  have hc := cRot_le (vol A) (sF i) (vol C) w Bb A.length hA1 (hs i hi) hC
  rw [hAl] at hc
  have hP : vol A ≤ vol ((List.range (d - 1)).map sF) :=
    vol_rangeMap_mono sF (by omega) (fun j hj => hs j (by omega))
  have e1 : vol A * sF i * vol C = vol (shR d (sP d sF)) := by rw [hVe]; ring
  rw [e1] at hc
  unfold cRb
  have : 400000 * (i + 1) * vol A * (Bb + 2) ≤ 400000 * d * vol ((List.range (d - 1)).map sF) * (Bb + 2) := by
    have h1 : i + 1 ≤ d := hi
    have := Nat.mul_le_mul h1 hP
    nlinarith
  omega

theorem rotsBC_spec (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) (cs : ℕ → List ℕ)
    (hcs : ∀ i < d, (cs i).length = i ∧ ∀ c ∈ cs i, c < sF i) (w Bb : ℕ)
    (hBb : zsz ((2 * vol (shR d (sP d sF)) : ℕ) : ℤ) ≤ Bb) :
    ∀ k ≤ d, ∀ (xs : List ℤ), xs.length = vol (shR d (sP d sF)) → Bnd w xs →
      ∀ (t : IState HS) (R : List Item), t.G 0 = ints xs ++ R →
      IRuns I iprog (rotsBC d sF cs k) t
        (t.upd 0 (ints (AModel.pull (shR d (sP d sF)) (shR d (sP d sF)) (Gb sF cs k) 0 xs) ++ R))
        (k * cRb d w (vol (shR d (sP d sF))) (vol ((List.range (d - 1)).map sF)) Bb + 1)
  | 0, _, xs, hlen, _, t, R, h0 => by
    refine (IRuns.skip t).mono' ?_ (by simp)
    simp only [Gb]; rw [pull_id 0 hlen, ← h0]; simp
  | k + 1, hk, xs, hlen, hb, t, R, h0 => by
    have H1 := rotsBC_spec d sF hs cs hcs w Bb hBb k (by omega) xs hlen hb t R h0
    have H2 := rotI_spec (I := I) (iprog := iprog) d sF hs cs hcs w Bb hBb (i := k) (by omega)
      (AModel.pull (shR d (sP d sF)) (shR d (sP d sF)) (Gb sF cs k) 0 xs) (by simp) (bnd_pull _ _ _ hb)
      (t.upd 0 (ints (AModel.pull (shR d (sP d sF)) (shR d (sP d sF)) (Gb sF cs k) 0 xs) ++ R)) R (by simp)
    rw [pull_comp _ _ (fun b hb => valid_gRot d sF hs cs (by omega) hb)] at H2
    refine (H1.seq H2).mono' (by simp [Gb]) ?_
    nlinarith

theorem csB_ok (d : ℕ) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) :
    ∀ i < d, (csB sF μ i).length = i ∧ ∀ c ∈ csB sF μ i, c < sF i := by
  intro i hi
  refine ⟨by simp [csB], fun c hc => ?_⟩
  simp only [csB, List.mem_map] at hc
  obtain ⟨j, -, rfl⟩ := hc
  exact Nat.mod_lt _ (hs i hi)

end NLogN.KFU

end

