-- title:
--   Fact 1.2 Part 5, p. 7 — Σ_i λ_i(1 − λ_i)‖T_PRS z^i − z^i‖² ≤ ‖z⁰ − z*‖²
-- statement:
--   Let $f, g : \mathcal H \to (-\infty,\infty]$ be closed, proper and convex, $\gamma > 0$, let $(\lambda_k)_{k\ge0} \subset (0,1]$, let $(z^k)_{k \ge 0}$ be generated by relaxed PRS (Algorithm 1), and let $z^*$ be a fixed point of $T_{\mathrm{PRS}}$. With $\tau_k = \lambda_k(1 - \lambda_k)$, the series $\sum_i \tau_i\|T_{\mathrm{PRS}} z^i - z^i\|^2$ converges and
--   $$\sum_{i=0}^\infty \tau_i \|T_{\mathrm{PRS}} z^i - z^i\|^2 \le \|z^0 - z^*\|^2.$$
--
--   This summability of the fixed-point residual is what turns the bound of Proposition 3.1 into a summable bound on the objective errors.
-- source:
--   Davis & Yin, Faster convergence rates of relaxed Peaceman-Rachford and ADMM under regularity assumptions, arXiv:1407.5210v3, p. 7, Fact 1.2 Part 5

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_MoreauProx_Characterization_GammaZero
import Definitions.Def_RelaxedPRS_BestIter_Setting
open ThreeOpSplitting.ConvexRates MoreauProx.Characterization Filter

namespace RelaxedPRS.BestIter

theorem fact_1_2_part5 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f g : H → EReal) (hf : IsProperClosedConvex f) (hg : IsProperClosedConvex g)
    (γ : ℝ) (hγ : 0 < γ) (Pf Pg : H → H) (hPf : IsProx γ f Pf) (hPg : IsProx γ g Pg)
    (lam : ℕ → ℝ) (hlam : ∀ k, 0 < lam k ∧ lam k ≤ 1)
    (z : ℕ → H) (hz : RelaxedPRS.StrongCvx.IsPRSRun Pf Pg lam z) (zs : H) (hzs : RelaxedPRS.StrongCvx.TPRS Pf Pg zs = zs) :
    Summable (fun i => lam i * (1 - lam i) * ‖RelaxedPRS.StrongCvx.TPRS Pf Pg (z i) - z i‖ ^ 2) ∧
    ∑' i, lam i * (1 - lam i) * ‖RelaxedPRS.StrongCvx.TPRS Pf Pg (z i) - z i‖ ^ 2 ≤ ‖z 0 - zs‖ ^ 2 := by sorry

end RelaxedPRS.BestIter
