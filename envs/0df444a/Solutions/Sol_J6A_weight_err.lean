  have hA : |(A : ℝ) - 2 ^ P * ea| ≤ 1 := ha
  have hG : |(G : ℝ) - 2 ^ P * eg| ≤ 1 := hg
  have hE : |(E : ℝ) - 2 ^ P * ((2 ^ σ)⁻¹ * ec)| ≤ 1 := hc
