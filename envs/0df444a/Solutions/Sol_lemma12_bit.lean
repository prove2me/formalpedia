-- Source module: Solutions.NetProp7Alg
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NetProp7

open Matrix Finset NetLabels
open scoped Kronecker

section Ring

variable {R : Type*} [Ring R]

lemma idem_mul_comm {X Y : R} (hX : X * X = X) (hY : Y * Y = Y) (hc : Commute X Y) :
    X * Y * (X * Y) = X * Y := by
  rw [hc.symm.mul_mul_mul_comm X Y, hX, hY]

lemma comm_one_sub {X Y : R} (h : Commute X Y) : Commute X (1 - Y) :=
  (Commute.one_right X).sub_right h

lemma idem_add {X Y : R} (hX : X * X = X) (hY : Y * Y = Y) (h1 : X * Y = 0) (h2 : Y * X = 0) :
    (X + Y) * (X + Y) = X + Y := by
  simp only [add_mul, mul_add, hX, hY, h1, h2, add_zero, zero_add]

lemma idem_one_sub {X : R} (hX : X * X = X) : (1 - X) * (1 - X) = 1 - X := by
  simp only [sub_mul, mul_sub, one_mul, mul_one, hX, sub_self, sub_zero]

lemma idem_sub {X Y : R} (hX : X * X = X) (hY : Y * Y = Y) (h1 : X * Y = Y) (h2 : Y * X = Y) :
    (X - Y) * (X - Y) = X - Y := by
  simp only [sub_mul, mul_sub, hX, hY, h1, h2, sub_self, sub_zero]

end Ring

section Rank

variable {n : Type*} [Fintype n] [DecidableEq n]

lemma rk_idem {E : Matrix n n ℚ} (hE : E * E = E) : rk E = trace E :=
  rank_eq_trace_of_idem E hE

lemma rank_smul_ne {E : Matrix n n ℚ} {c : ℚ} (hc : c ≠ 0) : (c • E).rank = E.rank := by
  have : c • E = E * (c • (1 : Matrix n n ℚ)) := by rw [Matrix.mul_smul, mul_one]
  rw [this, rank_mul_eq_left_of_det_ne_zero]
  rw [det_smul, det_one, mul_one]
  exact pow_ne_zero _ hc

lemma rk_neg (E : Matrix n n ℚ) : rk (-E) = rk E := by
  unfold rk
  rw [show -E = (-1 : ℚ) • E by simp, rank_smul_ne (by norm_num)]

lemma rk_two (E : Matrix n n ℚ) : rk (E + E) = rk E := by
  unfold rk
  rw [show E + E = (2 : ℚ) • E by rw [two_smul], rank_smul_ne (by norm_num)]

lemma rk_zero : rk (0 : Matrix n n ℚ) = 0 := by simp [rk]

end Rank

section Stage

variable {n : Type*} [Fintype n] [DecidableEq n] {ι : Type*}

variable {α A : Matrix n n ℚ} {τ : ι → Matrix n n ℚ} {Nb : ι → ι → Prop} {h a : ℚ}

namespace SRel

variable (S : SRel α A τ Nb h a)
include S

lemma ββ : (A - α) * (A - α) = A - α := idem_sub S.AA S.αα S.Aα S.αA
lemma αβ : α * (A - α) = 0 := by rw [mul_sub, S.αA, S.αα, sub_self]
lemma βα : (A - α) * α = 0 := by rw [sub_mul, S.Aα, S.αα, sub_self]
lemma τβ (t : ι) : Commute (τ t) (A - α) := (S.τA t).sub_right (S.τα t)
lemma one_sub_τ (t : ι) : (1 - τ t) * (1 - τ t) = 1 - τ t := idem_one_sub (S.ττ t)

/-- `E1 = (B ⊗ t^⊥) ⊗ Q`: rank `(a − 1)(h − 1)`. -/
lemma rk_E1 (t : ι) : rk ((A - α) * (1 - τ t)) = a * h - h - a + 1 := by
  rw [rk_idem (idem_mul_comm S.ββ (S.one_sub_τ t) (comm_one_sub (S.τβ t).symm))]
  rw [show (A - α) * (1 - τ t) = A - α - A * τ t + α * τ t by noncomm_ring]
  simp only [trace_add, trace_sub, S.trA, S.trα, S.trAτ, S.trατ]

/-- `E2 = P ⊗ t^⊥ ⊗ Q`: rank `h − 1`. -/
lemma rk_E2 (t : ι) : rk (α * (1 - τ t)) = h - 1 := by
  rw [rk_idem (idem_mul_comm S.αα (S.one_sub_τ t) (comm_one_sub (S.τα t).symm))]
  rw [mul_sub, mul_one, trace_sub, S.trα, S.trατ]

lemma rk_β : rk (A - α) = a * h - h := by
  rw [rk_idem S.ββ, trace_sub, S.trA, S.trα]

lemma rk_α : rk α = h := by rw [rk_idem S.αα, S.trα]

lemma rk_one_sub_A : rk (1 - A) = Fintype.card n - a * h := by
  rw [rk_idem (idem_one_sub S.AA), trace_sub, trace_one, S.trA]

lemma rk_E6 (t : ι) : rk ((A - α) * τ t) = a - 1 := by
  rw [rk_idem (idem_mul_comm S.ββ (S.ττ t) (S.τβ t).symm), sub_mul, trace_sub, S.trAτ, S.trατ]

lemma rk_E9 (t : ι) : rk (α * τ t) = 1 := by
  rw [rk_idem (idem_mul_comm S.αα (S.ττ t) (S.τα t).symm), S.trατ]

lemma rk_E7 (s t : ι) : rk ((A - α) * (1 - τ s) + α * τ t) = a * h - h - a + 1 + 1 := by
  have h1 := idem_mul_comm S.ββ (S.one_sub_τ s) (comm_one_sub (S.τβ s).symm)
  have h2 := idem_mul_comm S.αα (S.ττ t) (S.τα t).symm
  have c1 : (A - α) * (1 - τ s) * (α * τ t) = 0 := by
    rw [((Commute.one_left α).sub_left (S.τα s)).mul_mul_mul_comm, S.βα, zero_mul]
  have c2 : α * τ t * ((A - α) * (1 - τ s)) = 0 := by
    rw [(S.τβ t).mul_mul_mul_comm, S.αβ, zero_mul]
  rw [rk_idem (idem_add h1 h2 c1 c2), trace_add,
    show (A - α) * (1 - τ s) = A - α - A * τ s + α * τ s by noncomm_ring]
  simp only [trace_add, trace_sub, S.trA, S.trα, S.trAτ, S.trατ]

lemma rk_E8 (s t : ι) (hst : Nb s t) (hts : Nb t s) : rk (α * (1 - (τ s + τ t))) = h - 2 := by
  have hp := idem_add (S.ττ s) (S.ττ t) (S.nb s t hst) (S.nb t s hts)
  have hc : Commute α (1 - (τ s + τ t)) :=
    (Commute.one_right α).sub_right (((S.τα s).symm).add_right (S.τα t).symm)
  rw [rk_idem (idem_mul_comm S.αα (idem_one_sub hp) hc), mul_sub, mul_one, mul_add]
  simp only [trace_add, trace_sub, S.trα, S.trατ]
  ring

end SRel

namespace SRel

variable (S : SRel α A τ Nb h a)
include S

/-- **`X` data wire in stage `j ≥ 2`** (incoming label `A ⊗ ⟨t⟩ ⊗ Q = A τ`). -/
lemma chainX (t : ι) (L z3 z6 : Matrix n n ℚ) (hL : L = A * τ t) (R : ℚ) :
    rk (labK α A (τ t) 2 - L) + (rk (labK α A z3 3 - labK α A (τ t) 2) +
      (rk (labK α A z6 6 - labK α A z3 3) + (rk (labK α A (τ t) 7 - labK α A z6 6) + R)))
      = (a * h - a) + R := by
  simp only [labK, hL]
  rw [show A - α + α * τ t - A * τ t = (A - α) * (1 - τ t) by noncomm_ring,
    show A - (A - α + α * τ t) = α * (1 - τ t) by noncomm_ring, sub_self, S.rk_E1, S.rk_E2,
    rk_zero]
  ring

/-- **`X` data wire in stage 1**: the source matrix is `−u = −α τ`, and `A = α` (`B = 0`). -/
lemma chainX0 (hA : A = α) (t : ι) (L z3 z6 : Matrix n n ℚ) (hL : L = -(α * τ t)) (R : ℚ) :
    rk (labK α A (τ t) 2 - L) + (rk (labK α A z3 3 - labK α A (τ t) 2) +
      (rk (labK α A z6 6 - labK α A z3 3) + (rk (labK α A (τ t) 7 - labK α A z6 6) + R)))
      = h + R := by
  simp only [labK, hL]
  rw [show A - α + α * τ t - -(α * τ t) = α * τ t + α * τ t by rw [hA]; abel,
    show A - (A - α + α * τ t) = α * (1 - τ t) by noncomm_ring, sub_self, rk_two, S.rk_E9,
    S.rk_E2, rk_zero]
  ring

/-- **`Y` data wire** (incoming label `B ⊗ ⟨t⟩ ⊗ Q = (A − α) τ`). -/
lemma chainY (t : ι) (L z1 z4 : Matrix n n ℚ) (hL : L = (A - α) * τ t) (R : ℚ) :
    rk (labK α A (τ t) 0 - L) + (rk (labK α A z1 1 - labK α A (τ t) 0) +
      (rk (labK α A z4 4 - labK α A z1 1) + (rk (labK α A (τ t) 5 - labK α A z4 4) + R)))
      = (a * h - a) + R := by
  simp only [labK, hL]
  rw [show A - α - (A - α) * τ t = (A - α) * (1 - τ t) by noncomm_ring,
    show A - α * τ t - (A - α) = α * (1 - τ t) by noncomm_ring, sub_self, sub_self, S.rk_E1,
    S.rk_E2, rk_zero]
  ring

/-- **Central wire**: source `0`, gates at times 1, 3, 4, 6, sink `1`; total `m + 2h`. -/
lemma chainC (z : Matrix n n ℚ) :
    rk (labK α A z 1 - 0) + (rk (labK α A z 3 - labK α A z 1) +
      (rk (labK α A z 4 - labK α A z 3) + (rk (labK α A z 6 - labK α A z 4) +
        rk (1 - labK α A z 6)))) = Fintype.card n + 2 * h := by
  simp only [labK]
  rw [sub_zero, sub_sub_cancel, show A - α - A = -α by abel, rk_neg, S.rk_β, S.rk_α,
    S.rk_one_sub_A]
  ring

/-- **Side wire** joining the `Y`-triple `s` and the `X`-triple `t` (neighbours):
source `0`, gates at times 0, 2, 5, 7, sink `1`; total `m`. -/
lemma chainS (s t : ι) (hst : Nb s t) (hts : Nb t s) :
    rk (labK α A (τ s) 0 - 0) + (rk (labK α A (τ t) 2 - labK α A (τ s) 0) +
      (rk (labK α A (τ s) 5 - labK α A (τ t) 2) + (rk (labK α A (τ t) 7 - labK α A (τ s) 5) +
        rk (1 - labK α A (τ t) 7)))) = Fintype.card n := by
  simp only [labK]
  rw [sub_zero, show A - α + α * τ t - (A - α) * τ s = (A - α) * (1 - τ s) + α * τ t by
      noncomm_ring,
    show A - α * τ s - (A - α + α * τ t) = α * (1 - (τ s + τ t)) by noncomm_ring,
    sub_sub_cancel, S.rk_E6, S.rk_E7, S.rk_E8 s t hst hts, S.rk_E9, S.rk_one_sub_A]
  ring

end SRel

end Stage

section Concrete

variable {h : ℕ}

lemma piM_mul (S T : Finset (Fin h)) : piM S * piM T =
    ((2 : ℚ)⁻¹ * bf (bitGram ℚ h) (NetLabels.ind ℚ T) (NetLabels.ind ℚ S)) •
      ((2 : ℚ)⁻¹ • vecMulVec (NetLabels.ind ℚ S) (bitGram ℚ h *ᵥ NetLabels.ind ℚ T)) := by
  unfold piM
  rw [smul_mul_smul_comm, vecMulVec_mul_vecMulVec, smul_smul]
  have e : (bitGram ℚ h *ᵥ NetLabels.ind ℚ S) ⬝ᵥ NetLabels.ind ℚ T =
      bf (bitGram ℚ h) (NetLabels.ind ℚ T) (NetLabels.ind ℚ S) := by
    rw [bf, dotProduct_comm]
  rw [e]
  ext i k
  simp only [Matrix.smul_apply, vecMulVec_apply, Pi.smul_apply, smul_eq_mul]
  ring

lemma piM_idem {S : Finset (Fin h)} (hS : S.card = 3) : piM S * piM S = piM S := by
  rw [piM_mul, bf_triple_self S hS, smul_smul, piM]; norm_num

lemma piM_orth {S T : Finset (Fin h)} (hS : S.card = 3) (hT : T.card = 3)
    (hST : (T ∩ S).card = 1) : piM S * piM T = 0 := by
  rw [piM_mul, bf_triple_neighbors T S hT hS hST]; simp

lemma trace_piM {S : Finset (Fin h)} (hS : S.card = 3) : trace (piM S) = 1 := by
  unfold piM
  rw [trace_smul, trace_vecMulVec, ← bf, bf_triple_self S hS]; norm_num

lemma kr3_mul (X Y Z X' Y' Z' : Matrix (Fin h) (Fin h) ℚ) :
    kr3 X Y Z * kr3 X' Y' Z' = kr3 (X * X') (Y * Y') (Z * Z') := by
  simp only [kr3, ← mul_kronecker_mul]

lemma trace_kr3 (X Y Z : Matrix (Fin h) (Fin h) ℚ) :
    trace (kr3 X Y Z) = trace X * (trace Y * trace Z) := by
  simp only [kr3, trace_kronecker]

lemma kr3_one : kr3 (1 : Matrix (Fin h) (Fin h) ℚ) 1 1 = 1 := by
  simp only [kr3, one_kronecker_one]

variable {T : Type*} (ind : T → Finset (Fin h))

/-- **The stage relations hold for the concrete projections.** -/
theorem srel (hcard : ∀ t, (ind t).card = 3) (j : Fin 3) (p : T × T) :
    SRel (αM j (ind p.1) (ind p.2)) (AM j (ind p.1) (ind p.2)) (fun t => τM j (ind t))
      (fun s t => (ind s ∩ ind t).card = 1) (h : ℚ) ((h : ℚ) ^ (j : ℕ)) := by
  have I := fun t => piM_idem (hcard t)
  have tr := fun t => trace_piM (hcard t)
  have O : ∀ s t, (ind s ∩ ind t).card = 1 → piM (ind s) * piM (ind t) = 0 := fun s t hst =>
    piM_orth (hcard s) (hcard t) (by rw [Finset.inter_comm]; exact hst)
  fin_cases j <;>
  refine ⟨?_, ?_, ?_, ?_, fun t => ?_, fun t => ?_, fun t => ?_, fun s t hst => ?_, ?_, ?_,
    fun t => ?_, fun t => ?_⟩ <;>
  simp only [αM, AM, τM, Fin.isValue, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.reduceEq,
    if_true, if_false, Commute, SemiconjBy, kr3_mul, trace_kr3, I, tr, mul_one,
    one_mul, trace_one, Fintype.card_fin, Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero,
    pow_one] <;>
  first
  | ring
  | simp only [O s t hst, kr3, kronecker_zero, zero_kronecker]

section Boundary

variable (S₁ S₂ S₃ : Finset (Fin h))

lemma AM_zero_eq : AM 0 S₂ S₃ = αM 0 S₂ S₃ := by simp [AM, αM]

lemma source_X : αM 0 S₂ S₃ * τM 0 S₁ = uM S₁ S₂ S₃ := by
  simp [αM, τM, uM, kr3_mul]

lemma boundX01 : AM 0 S₂ S₃ = AM 1 S₁ S₃ * τM 1 S₂ := by
  simp [AM, τM, kr3_mul]

lemma boundX12 : AM 1 S₁ S₃ = AM 2 S₁ S₂ * τM 2 S₃ := by
  simp [AM, τM, kr3_mul]

lemma boundY01 : AM 0 S₂ S₃ - αM 0 S₂ S₃ * τM 0 S₁ = (AM 1 S₁ S₃ - αM 1 S₁ S₃) * τM 1 S₂ := by
  simp [AM, αM, τM, kr3_mul, sub_mul]

lemma boundY12 : AM 1 S₁ S₃ - αM 1 S₁ S₃ * τM 1 S₂ = (AM 2 S₁ S₂ - αM 2 S₁ S₂) * τM 2 S₃ := by
  simp [AM, αM, τM, kr3_mul, sub_mul]

lemma sink_X : AM 2 S₁ S₂ = 1 := by simp [AM, kr3_one]

lemma sink_Y : AM 2 S₁ S₂ - αM 2 S₁ S₂ * τM 2 S₃ = 1 - uM S₁ S₂ S₃ := by
  simp [AM, αM, τM, uM, kr3_mul, kr3_one]

lemma source_Y : (0 : Matrix (Cube h) (Cube h) ℚ) = (AM 0 S₂ S₃ - αM 0 S₂ S₃) * τM 0 S₁ := by
  rw [AM_zero_eq, sub_self, zero_mul]

end Boundary

end Concrete

end NetProp7

end

