section
-- Source module: Solutions.KFUURev2
/-!
# KFUU §2b: the layouts of the uniform reversal

The axes are `L = range n` with sizes `2^(u + b_j)` (`bs = [b_0, …]`), the inner block is the
atom `cid = n` of size `cz`: `mzB u n cz`, `bgB bs`. Phase 1 runs through `lay1 i`
(`i = n, …, 0`): `layA (L.take i) ++ mains (L.drop i) ++ bitsR (L.drop i) ++ [2n]`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFC KFT KFU AModel AModelL12

/-- Main sizes `2^u` on the axes `j < n`, `cz` for the inner block. -/
def mzB (u n cz : ℕ) (j : ℕ) : ℕ := if j < n then 2 ^ u else cz

/-- The extra bits. -/
def bgB (bs : List Bool) (j : ℕ) : Bool := bs.getD j false

/-- The size list. -/
abbrev shP (u : ℕ) (bs : List Bool) : Shape := KFM.shPad u bs

/-! ## Phase 1 layouts -/

/-- The layout after phase 1 has treated the axes `i, …, n-1`. -/
def lay1 (bg : ℕ → Bool) (n i : ℕ) : List ℕ :=
  layA bg ((List.range n).take i) ++ mains ((List.range n).drop i) ++
    bitsR bg ((List.range n).drop i) ++ [2 * n]

/-! ## Volumes -/

/-! ## One step of phase 1 -/

abbrev rU2 : Fin HS := 37
abbrev tq2 : Fin HS := 42

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- `tq := S_i - 2^u` (zero, or positive for an axis with an extra bit). -/
def bitT : IStmt HS P :=
  .seq (.op (.dup tS tq)) (.seq (.op (.dup rU2 tq2)) (.seq (.op (.neg tq2)) (.op (.add tq tq2 tq))))

/-- `qB := S_i · qB`. -/
def accB (pM : Fin P) : IStmt HS P :=
  .seq (mulC pM NLogN.KFUU.qB tS tq) (.seq (.op (.drop NLogN.KFUU.qB)) (.op (.mv tq NLogN.KFUU.qB)))

def isPos (c : Cls) : Bool := decide (c = .pos)

/-- One step of phase 1. -/
def p1B (pM : Fin P) : IStmt HS P :=
  .seq (mulC pM pV rU2 NLogN.KFUU.qX) (.seq bitT (.seq (.ite tq NLogN.KFUU.isPos mvFU .skip) (.seq (.op (.drop tq))
    (.seq (accB pM) (.seq (.op (.drop NLogN.KFUU.qX)) (.op (.drop pV)))))))

end Gen

theorem len_shP (u : ℕ) (bs : List Bool) : (shP u bs).length = bs.length := by simp [KFM.shPad]

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

end Gen

end NLogN.KFUU

