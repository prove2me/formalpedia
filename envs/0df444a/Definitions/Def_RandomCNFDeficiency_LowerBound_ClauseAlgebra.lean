-- title:
--   Clause polynomials and their Boolean ideals
-- statement:
--   For any field $K$ and signed clause $C$, the ordinary input polynomial is
--
--   $$p_C=\prod_{x_i\in C}(1-x_i)\prod_{\neg x_i\in C}x_i.$$
--
--   Its Boolean-cube value is one precisely on assignments falsifying $C$ and zero on assignments satisfying $C$. For a finite clause set $A$, define $J_A$ as the ideal in the Boolean algebra generated by the multilinearizations of its clause polynomials and set $R_A=R_{J_A}$. These constructions connect the signed clause model to the independent normal-form algebra.
-- source:
--   Jonas Conneryd, STOC 2027 submission #332 (October 2026), Equation (3), Section 2.1, printed p. 6, PDF p. 8; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/332.pdf

import Definitions.Def_RandomCNFDeficiency_LowerBound_Clause
import Definitions.Def_RandomCNFDeficiency_LowerBound_BooleanAlgebra
set_option autoImplicit false
open scoped BigOperators

namespace RandomCNFDeficiency.LowerBound

/-- Equation (3), in ordinary polynomials: true literals contribute 1-X. -/
noncomputable def clausePolynomial {n : ℕ} {K : Type*} [Field K]
    (C : Clause n) : MvPolynomial (Fin n) K :=
  ∏ i : Fin n, match C i with
    | none => 1
    | some true => 1 - MvPolynomial.X i
    | some false => MvPolynomial.X i

def clauseIdeal {n : ℕ} {K : Type*} [Field K] (A : CNF n) :
    Ideal (BooleanAlgebra n K) :=
  Ideal.span {p | ∃ C ∈ A, p = multilinearize (clausePolynomial C)}

noncomputable def localReduction {n : ℕ} {K : Type*} [Field K]
    (A : CNF n) (f : BooleanAlgebra n K) : BooleanAlgebra n K :=
  reduction (clauseIdeal A) f

end RandomCNFDeficiency.LowerBound


