def cPushTo (W : ℕ) : List (Fin HS × E) → ℕ
  | [] => 1
  | (_, e) :: l => cT e.ex W + cPushTo W l

/-- The stacks after `pushTo`. -/
def pushToC (v : Vr) : List (Fin HS × E) → Cs → Cs
  | [], c => c
  | (X, e) :: l, c => pushToC v l (update c X (e.den v :: c X))

/-! ## The values -/

/-- The first block of assignments. -/
def asgA (pkA pkC bA bC : ℕ) : List (Fin HS × E) :=
  [(10, .mul (.r 10) (.k 8)), (1, .mul (.k 2) (.r 5)), (2, .dv (.r 5) (.k 2)),
   (7, .mul (.mul (.mul (.r 4) (.r 4)) (.r 4)) (.mul (.r 6) (.r 6))),
