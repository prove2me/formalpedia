/-- An `NPFamily` whose `ε = 0` member is the Kerr–Newman background (class B). -/
structure KNFam (M a Q : ℝ) (g gi : ℝ → Metric 4) (F : ℝ → TwoForm 4) (E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ)
    (W : Set (ℝ × Pt 4)) : Prop where
  fam : NPFamily g gi F E Θ W
  g0 : g 0 = gKN M a Q
  gi0 : gi 0 = giKN M a Q
  F0 : F 0 = faradayKN a Q
  E0 : E 0 = knE M a Q
  Θ0 : Θ 0 = knTh M a Q
  slice : ∀ y, ((0 : ℝ), y) ∈ W → y ∈ domReg M a Q

