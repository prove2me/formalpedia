-- title:
--   Theorem 5.4(2), p. 15 — point-hitting probabilities $\mathbb P_x(T_y<\zeta)$ of an MBI
-- statement:
--   Let $(X,\mathbb P)$ be a Markov branching process with immigration (MBI) with parameters $(\alpha,\mu,p,\beta,\nu,q)$ on $E=\{0,1,2,\dots\}$, with Q-matrix (5.1), branching mechanism $\psi$, immigration mechanism $\phi$, root $s_0$, and the sequences $W,\pi,\varpi$ of Lemma 5.1 (with $W(z)=0$ for $z\le -1$). For $x,y\ge 0$ let
--   $$\mathscr H^{[y}(x)=\sum_{l=0}^{y-x-1}\pi(y-x-1-l)\,\frac{(W\star\varpi)(l)}{l+x+1}\qquad(=0\text{ if }y\le x),$$
--   and $I(x)=\int_0^{s_0}\frac{v^x}{\psi(v)}\exp\big(-\int_0^v\frac{\phi(u)}{\psi(u)}\,du\big)\,dv\in[0,\infty]$. Write $G$ for the resolvent of $X$ and $T_A$ for the first entrance time of $A$, $\zeta$ for the lifetime.
--
--   1. If all states are transient, then for $x,y\ge0$
--   $$\mathbb P_x(T_y<\zeta)=\frac{\pi(y)I(x)-\mathscr H^{[y}(x)}{\pi(y)I(y)}.$$
--   2. If the MBI is an MBP ($\beta=q=0$), then for $x\ge0$
--   $$\mathbb P_x(T_y<\zeta)=\begin{cases}\dfrac{s_0^xW(y-1)-W(y-x-1)}{s_0^yW(y-1)},& y\ge1,\\[4pt] s_0^x,& y=0.\end{cases}$$
--   3. If all states are recurrent, then $\mathbb P_x(T_y<\zeta)=1$ for all $x,y\ge0$.
--
--   This is item (2) of Theorem 5.4.
--
--   **Formalization Note** This is one item of `SkipFreeFluct.MBI.theorem_5_4`, stated verbatim with the same encodings (the MBI is the chain generated by `mbiQ P` on `Set.Ici (0 : ℤ)`; probabilities and the resolvent are $\mathbb R_{\ge0}\cup\{\infty\}$-valued path sums compared through `.toReal`; transience is $G(x,x)<\infty$ for all $x$, recurrence $G(x,x)=\infty$; MBP means $\beta=q=0$).
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, pp. 15–16, Theorem 5.4(2)

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
import Definitions.Def_SkipFreeFluct_MBI_Model
open scoped ENNReal Topology
open Filter MeasureTheory

namespace SkipFreeFluct.MBI

theorem theorem_5_4_2 (P : MBIParams) (hP : P.Valid) :
    (AllTransient (Set.Ici 0) (mbiQ P) → ∀ x y : ℕ,
      (hitProb (Set.Ici 0) (mbiQ P) {(y : ℤ)} x).toReal =
        (piSeq P y * (IntI P x).toReal - calH P y x) / (piSeq P y * (IntI P y).toReal)) ∧
    (IsMBP P → ∀ x y : ℕ,
      (hitProb (Set.Ici 0) (mbiQ P) {(y : ℤ)} x).toReal =
        if 1 ≤ y then
          (s0 P ^ x * W P (y - 1) - Wz P ((y : ℤ) - x - 1)) / (s0 P ^ y * W P (y - 1))
        else s0 P ^ x) ∧
    (AllRecurrent (Set.Ici 0) (mbiQ P) → ∀ x y : ℕ,
      hitProb (Set.Ici 0) (mbiQ P) {(y : ℤ)} x = 1) := by sorry

end SkipFreeFluct.MBI
