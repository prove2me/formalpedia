open NumberField NumberField.InfinitePlace MeasureTheory
open scoped WithZero Classical

variable {K : Type} [Field K] [NumberField K]

variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0551 (a : ZMod 2) {y : ℝ} (hy : y ≠ 0) :
    (((y : ℝ) : ℂ) / ((|y| : ℝ) : ℂ)) ^ (a.val : ℤ) = if a = 0 then 1 else ((SignType.sign y : ℝ) : ℂ) := by
  have hdiv : ((y : ℝ) : ℂ) / ((|y| : ℝ) : ℂ) = ((SignType.sign y : ℝ) : ℂ) := by
    have hyc : ((y : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 hy
    rcases hy.lt_or_gt with h | h
    · simp [abs_of_neg h, sign_neg h, div_neg, div_self hyc]
    · simp [abs_of_pos h, sign_pos h, div_self hyc]
  by_cases ha : a = 0
  · subst ha
    rw [if_pos rfl, ZMod.val_zero, Nat.cast_zero, zpow_zero]
  · have ha1 : a = 1 := by
      revert a
      decide
    subst ha1
    have h1 : (1 : ZMod 2).val = 1 := by decide
    rw [if_neg ha, hdiv, h1, Nat.cast_one, zpow_one]

private theorem t0552 {y : ℝ} (hy : y ≠ 0) (s : ℂ) :
    ((Real.sqrt |y| : ℝ) : ℂ)⁻¹ * ((|y| : ℝ) : ℂ) ^ (s - 1) = ((|y| : ℝ) : ℂ) ^ (s - 1 / 2 - 1) := by
  have hne : ((|y| : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 (abs_pos.2 hy).ne'
  have hsqrt : ((Real.sqrt |y| : ℝ) : ℂ) = ((|y| : ℝ) : ℂ) ^ ((1 : ℂ) / 2) := by
    rw [Real.sqrt_eq_rpow, Complex.ofReal_cpow (abs_nonneg y)]
    norm_num
  rw [hsqrt, ← Complex.cpow_neg, ← Complex.cpow_add _ _ hne]
  congr 1
  ring

private theorem t0553 {z : ℂ} (hz : z ≠ 0) (s : ℂ) :
    ((‖z‖ : ℝ) : ℂ)⁻¹ * ((‖z‖ ^ 2 : ℝ) : ℂ) ^ (s - 1) = ((‖z‖ ^ 2 : ℝ) : ℂ) ^ (s - 1 / 2 - 1) := by
  have hpos : 0 < ‖z‖ := norm_pos_iff.2 hz
  have hne : ((‖z‖ ^ 2 : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 (pow_pos hpos 2).ne'
  have he : ((1 : ℂ) / 2) = (((((2 : ℕ) : ℝ)⁻¹ : ℝ)) : ℂ) := by
    norm_num
  have hsq : ((‖z‖ : ℝ) : ℂ) = ((‖z‖ ^ 2 : ℝ) : ℂ) ^ ((1 : ℂ) / 2) := by
    rw [he, ← Complex.ofReal_cpow (pow_nonneg hpos.le 2), Real.pow_rpow_inv_natCast hpos.le two_ne_zero]
  rw [hsq, ← Complex.cpow_neg, ← Complex.cpow_add _ _ hne]
  congr 1
  ring

private theorem t0554 (w : InfinitePlace K) (hw : w.IsReal) (g₀ : AdelicGL2 (𝓞 K) K) (u : ℂ)
    (a : ZMod 2) (s : ℂ) (y : ℝ) :
    d050 archR dR hw g₀ u (a.val : ℤ) s y * ((|y| : ℝ) : ℂ)⁻¹ =
      ((Real.sqrt |(realComponent w hw g₀).det| : ℝ) : ℂ)⁻¹ *
        ArchR.zetaIntegrand (dR w hw).W (realComponent w hw g₀) u a (s - 1 / 2) y := by
  by_cases hy : y = 0
  · subst hy
    unfold d050 ArchR.zetaIntegrand
    simp
  · have hm : w.mult = 1 := mult_isReal ⟨w, hw⟩
    unfold d050 ArchR.zetaIntegrand ArchR.quasiChar
    rw [hm, Nat.cast_one, one_mul, pow_one, t0551 a hy, ← t0552 hy]
    ring1

private theorem t0555 (w : InfinitePlace K) (hw : w.IsComplex) (g₀ : AdelicGL2 (𝓞 K) K)
    (u : ℂ) (k : ℤ) (s : ℂ) (z : ℂ) :
    d051 archC dC hw g₀ u k s z * ((‖z‖ ^ 2 : ℝ) : ℂ)⁻¹ =
      ((‖(complexComponent w hw g₀).det‖ : ℝ) : ℂ)⁻¹ *
        ArchC.zetaIntegrand (dC w hw).W (complexComponent w hw g₀) u k (s - 1 / 2) z := by
  by_cases hz : z = 0
  · subst hz
    unfold d051 ArchC.zetaIntegrand
    simp
  · have hm : w.mult = 2 := mult_isComplex ⟨w, hw⟩
    unfold d051 ArchC.zetaIntegrand ArchC.quasiChar
    rw [hm, Nat.cast_ofNat, ← t0553 hz]
    ring1

private theorem t0556 (w : InfinitePlace K) (hw : w.IsReal) (g₀ : AdelicGL2 (𝓞 K) K)
    (u : ℂ) (a : ZMod 2) {s : ℂ} (hs : (dR w hw).zeta_abscissa < (s - 1 / 2).re + u.re) :
    ∫ y : ℝ, d050 archR dR hw g₀ u (a.val : ℤ) s y * ((|y| : ℝ) : ℂ)⁻¹ =
