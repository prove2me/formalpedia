def badPrimes : Finset Nat.Primes := ((M * q') * s).primeFactors.subtype Nat.Prime

theorem mem_badPrimes_iff (ℓ : Nat.Primes) : ℓ ∈ badPrimes M s q' ↔ (ℓ : ℕ) ∣ (M * q') * s := by
  have h1 : ℓ ∈ badPrimes M s q' ↔ (ℓ : ℕ) ∈ ((M * q') * s).primeFactors := Finset.mem_subtype
  rw [h1, Nat.mem_primeFactors]
  have hne : (M * q') * s ≠ 0 :=
    Nat.mul_ne_zero (Nat.mul_ne_zero (NeZero.ne M) (Fact.out : q'.Prime).ne_zero) (NeZero.ne s)
  exact ⟨fun h => h.2.1, fun h => ⟨ℓ.2, h, hne⟩⟩

theorem s_mem_badPrimes : (⟨s, hs⟩ : Nat.Primes) ∈ badPrimes M s q' :=
  (mem_badPrimes_iff M s q' _).2 (dvd_mul_left s _)

theorem q'_mem_badPrimes : (⟨q', Fact.out⟩ : Nat.Primes) ∈ badPrimes M s q' :=
  (mem_badPrimes_iff M s q' _).2 ((dvd_mul_left q' M).mul_right s)

include hs in
theorem mem_badPrimes_cases (ℓ : Nat.Primes) (h : ℓ ∈ badPrimes M s q') :
    (ℓ : ℕ) ∣ M ∨ (ℓ : ℕ) = q' ∨ (ℓ : ℕ) = s := by
  rw [mem_badPrimes_iff] at h
  rcases ℓ.2.dvd_mul.1 h with h | h
  · rcases ℓ.2.dvd_mul.1 h with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl ((Nat.prime_dvd_prime_iff_eq ℓ.2 Fact.out).1 h))
  · exact Or.inr (Or.inr ((Nat.prime_dvd_prime_iff_eq ℓ.2 hs).1 h))

theorem not_dvd_of_not_mem_badPrimes (ℓ : Nat.Primes) (h : ℓ ∉ badPrimes M s q') :
    ¬ (ℓ : ℕ) ∣ (M * q') * s := fun h' => h ((mem_badPrimes_iff M s q' ℓ).2 h')

theorem not_dvd_Mq'_of_not_mem_badPrimes (ℓ : Nat.Primes) (h : ℓ ∉ badPrimes M s q') :
    ¬ (ℓ : ℕ) ∣ M * q' := fun h' => h ((mem_badPrimes_iff M s q' ℓ).2 (h'.mul_right s))

theorem ne_q'_of_not_mem_badPrimes (ℓ : Nat.Primes) (h : ℓ ∉ badPrimes M s q') : (ℓ : ℕ) ≠ q' := by
  intro e
  apply h
  rw [mem_badPrimes_iff, e]
  exact (dvd_mul_left q' M).mul_right s

theorem ne_s_of_not_mem_badPrimes (ℓ : Nat.Primes) (h : ℓ ∉ badPrimes M s q') : (ℓ : ℕ) ≠ s := by
  intro e
  apply h
  rw [mem_badPrimes_iff, e]
  exact dvd_mul_left s _

theorem not_dvd_Ms_of_not_mem_badPrimes (ℓ : Nat.Primes) (h : ℓ ∉ badPrimes M s q') :
    ¬ (ℓ : ℕ) ∣ M * s := fun h' =>
  h ((mem_badPrimes_iff M s q' ℓ).2 (h'.trans ⟨q', by ring⟩))

include hs hsq' hq'M in
theorem not_q'_dvd_Ms : ¬ q' ∣ M * s := by
