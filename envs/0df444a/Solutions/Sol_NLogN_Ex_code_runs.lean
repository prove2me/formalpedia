  have hY5 : sm.G Y = .int 0 :: s.G Y := by simp [sm, ss, schoolSt, hYQ, hYW, hz, sg_zero]
  have h5 := IRuns.drop (I := I) (iprog := iprog) hY5
  have h6 := IRuns.drop (I := I) (iprog := iprog) (s := sm.upd Y (s.G Y)) (i := X)
    (a := x * 2 ^ m) (L := s.G X) (by simp [sm, ss, schoolSt, hXY, hXW, hXQ])
  have h7 := IRuns.drop (I := I) (iprog := iprog) (s := (sm.upd Y (s.G Y)).upd X (s.G X)) (i := Q)
    (a := 2) (L := s.G Q) (by simp [sm, ss, schoolSt, hYQ', hXQ'])
  have h8 := IRuns.mv (I := I) (iprog := iprog)
    (s := ((sm.upd Y (s.G Y)).upd X (s.G X)).upd Q (s.G Q)) (i := W) (j := A)
    (a := x * sg y (y.natAbs % 2 ^ m)) (L := s.G W) hAW'
