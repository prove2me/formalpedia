    ∀ (Ps : List (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) c)), corr t F Ps ≅ corr t F' Ps
  | [] => Iso.refl _
  | P :: Ps => h P ⊗ᵢ corrCongr t F F' h Ps

