/-- The actual congruence premise on a set `U`: `V` is `C¹` on `U` and at every point of `U` it is
nonzero, `g`-null, `Ric`-null and pregeodesic (actual `g`, `ginv`, `ricciOf`, `accel`). -/
structure RicciNullPregeodesicField (g ginv : Metric 5) (U : Set (Pt 5))
    (V : Pt 5 → Fin 5 → ℝ) : Prop where
  smooth : ∀ i, ContDiffOn ℝ 1 (fun x => V x i) U
  ne_zero : ∀ x ∈ U, V x ≠ 0
  null : ∀ x ∈ U, contract2 g x (V x) = 0
  ricci_null : ∀ x ∈ U, contract2 (ricciOf g ginv) x (V x) = 0
  pregeodesic : ∀ x ∈ U, PregeodesicAt g ginv V x

