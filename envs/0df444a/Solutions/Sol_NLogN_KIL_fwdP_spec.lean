theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (P q M B Bb : ℕ) (R L1 L2 L3 L4 : List NLogN.Item)
    (hlen : xs.length = P * q * M * B) (hb : NLogN.Bnd Bb xs)
    (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) (hP1 : 1 ≤ P)
    (hV : NLogN.zsz ((P * (q * (M * B)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int q :: L2)
    (h3 : t.G 3 = .int M :: L3) (h4 : t.G 4 = .int B :: L4) :
    NLogN.KIL.fwdP.ok t ∧ NLogN.KIL.fwdP.run t = t.upd 0 (NLogN.ints (AModel.pull [P, q, M, B] [P, M, q, B] NLogN.KIL.gS 0 xs) ++ R) ∧
      NLogN.KIL.fwdP.cost t ≤ NLogN.KIL.cMove P q M B Bb := by
  have H := NLogN.KIL.fwdP_sp (NLogN.KIL.baseOf t R L1 L2 L3 L4) (NLogN.KIL.recOf xs q M B) P q M B Bb
    (fun _ _ _ => NLogN.KIL.length_recOf xs q M B _ _ _)
    (fun _ _ _ a ha => by
      simp only [NLogN.KIL.recOf, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact NLogN.KIL.bnd_getD hb _) hB1 hM1 hq1 hP1 hV
  rw [NLogN.KIL.inp_recOf hlen, NLogN.KIL.outF_recOf, NLogN.KIL.encK_fIn_eq' t xs P q M B R L1 L2 L3 L4 h0 h1 h2 h3 h4,
    NLogN.KIL.encK_fIn_eq t xs _ P q M B R L1 L2 L3 L4 h1 h2 h3 h4] at H
  refine ⟨H.1, H.2.1, le_trans H.2.2 (le_trans (NLogN.KIL.cFwd_le hB1 hM1 hq1) ?_)⟩
  unfold NLogN.KIL.cMove; gcongr <;> norm_num
