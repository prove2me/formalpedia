section
-- Source module: Solutions.J6SegAxBud7
/-!
# B-line axis budget 7: **`chunkBudget6_all`**

* `cY_le`: `cY ≤ Kch · p · (log lg n + 1)²`;
* `chunk_budget_at`: `ChunkBudgetAt P ap n src D k (Kch · cU6 P n 2 / (D+1))` on every axis with
  `AxNum` and `TabAt`;
* **`chunkBudget6_all P hP ap (hc : ChunkPlan6 ap) (hcb : ChunkPlanB ap) : ChunkBudget6 P ap`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxNum P n src D k)
include h

/-- **The chunk budget on one axis.** -/
theorem chunk_budget_at (hT : J6Seg.Ax.TabAt P n src k) (hc : AxCh.ChunkPlan6 ap) (hcb : ChunkPlanB ap)
    (hD : dP6 P n = D + 1) :
    ChunkBudgetAt P ap n src D k (Kch P ap * cU6 P n 2 / (D + 1)) := by
  refine ⟨_, _, _, _, _, chunk_facts ap h hT hc hcb, ?_⟩
  have hN := chunk_cost_nat ap h
  have hY := cY_le ap h
  have hNR := (Nat.cast_le (α := ℝ)).2 hN
  push_cast at hNR
  have hdR : ((D : ℝ) + 1) = (dP6 P n : ℝ) := by rw [hD]; push_cast; ring
  have hcU : cU6 P n 2 = ((TP6 P n : ℝ) * pP6 P n) * Ncost6 P n *
      (Real.log (IntMul.lg n) + 1) ^ 2 := rfl
  rw [hdR, hcU]
  have hd0 : (0 : ℝ) < dP6 P n := by have := h.d1; exact_mod_cast this
  rw [le_div_iff₀ hd0]
  have hdl := Side.dl_le_Ncost6 P n
  have hℓ0 : (0 : ℝ) ≤ ℓP6 P n := Nat.cast_nonneg _
  have hNcd : (dP6 P n : ℝ) ≤ Ncost6 P n := by linarith
  have hT0 : (0 : ℝ) ≤ TP6 P n := Nat.cast_nonneg _
  have hY0 : (0 : ℝ) ≤ (cY P n src k ap : ℝ) := Nat.cast_nonneg _
  have hK0 := Kch_nonneg P ap
  have hp0 : (0 : ℝ) ≤ pP6 P n := Nat.cast_nonneg _
  set X := (kerC (cCk P n src k ap) (cBk P n src k ap) (2 ^ axfC6 P n) (axpost6 P n D k) (cLc P n)
      (axnc6 P n k) (tabsT (axTC6 P n src k ap) (axnc6 P n k)).length (axpre6 P n D k)
      (2 * (axpre6 P n D k * axnc6 P n k * axpost6 P n D k * 2 ^ axfC6 P n)) : ℝ) with hX
  have h1 : X ≤ (TP6 P n : ℝ) * (Kch P ap * ((pP6 P n : ℝ) * (Real.log (IntMul.lg n) + 1) ^ 2)) :=
    hNR.trans (mul_le_mul_of_nonneg_left hY hT0)
  have hQ0 : (0 : ℝ) ≤ (TP6 P n : ℝ) * (Kch P ap * ((pP6 P n : ℝ) * (Real.log (IntMul.lg n) + 1) ^ 2)) :=
    mul_nonneg hT0 (mul_nonneg hK0 (mul_nonneg hp0 (sq_nonneg _)))
  calc X * (dP6 P n : ℝ) ≤ ((TP6 P n : ℝ) * (Kch P ap * ((pP6 P n : ℝ) *
        (Real.log (IntMul.lg n) + 1) ^ 2))) * Ncost6 P n :=
        mul_le_mul h1 hNcd hd0.le hQ0
    _ = Kch P ap * (((TP6 P n : ℝ) * pP6 P n) * Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ 2) := by
        ring

end ax

/-- **`ChunkBudget6`** for every plan with `ChunkPlan6` and `ChunkPlanB`. -/
theorem chunkBudget6_all (P : Prm) (hP : P.Ok) (ap : AxPlan6) (hc : AxCh.ChunkPlan6 ap)
    (hcb : ChunkPlanB ap) : ChunkBudget6 P ap := by
  obtain ⟨n₀, hN⟩ := Side.axNum_ev P hP
  obtain ⟨n₁, hT⟩ := J6Seg.Ax.tabAt_of P (TabBnd.chunkTabBnd6_all P hP)
  exact ⟨Kch P ap, 2, max n₀ n₁, Kch_nonneg P ap, fun n hn src hs D hD k hk =>
    chunk_budget_at ap (hN n (le_of_max_le_left hn) src hs D hD k hk)
      (hT n (le_of_max_le_right hn) src hs D hD k hk) hc hcb hD⟩

end J6Seg.ChB
end

end

section
-- Source module: Solutions.J6SegJCost6
/-!
# J cost 6: **`jBudget6_all`**

With `W2 = 3 kA + kC`, `W3 = W + W2 + bcC + 16`, `C1 = Cfm (W2+10)(W2+x+14)²`, the `J` pass costs
`≤ KJ · cU6 P n 2 / (D+1)`, `KJ = 4·10^5 (487500 C1 + 3·10^6 (3 W2 + 12) + 3·10^9 (10+bcC)²) +
6·10^11 W3`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

open Finset

namespace J6Seg.Side
open IntMul NLogN NLogN.KIL IntMul.Kappa.R6 J6Seg

theorem KJc_nonneg (P : Prm) (ap : AxPlan6) : 0 ≤ KJc P ap := by unfold KJc; positivity

/-- **`JBudget6`** for every plan satisfying `ValCond6`. -/
theorem jBudget6_all (P : Prm) (hP : P.Ok) (ap : AxPlan6) (hc : Val.ValCond6 ap)
    (hc' : AxCh.ChunkPlan6 ap) : JBudget6 P ap := by
  obtain ⟨n₁, hN⟩ := axJ_ev P hP
  exact ⟨KJc P ap, 2, n₁, KJc_nonneg P ap, fun n hn src hsrc D hD k hk =>
    jbudget_at ap (hN n hn src hsrc D hD k hk) hc hD⟩

end J6Seg.Side
end

end

