open scoped Pointwise
variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
variable {K : Set X}

theorem OAI.ReflexiveFixedPoints.pairwiseDifferences_subset_closure {X : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X] {K : Set X} (z : ℕ → K) (hz : DenseRange z) :
    K - K ⊆ closure (Set.range (fun ij : ℕ × ℕ => (z ij.1 : X) - (z ij.2 : X))) := by sorry
