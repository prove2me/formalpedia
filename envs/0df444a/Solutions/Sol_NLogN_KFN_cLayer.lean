    rcases hx with hx | hx
    · exact ⟨(c, r), List.mem_cons_self, tmE_regs c r x hx⟩
    · obtain ⟨t, ht, e⟩ := lcE_regs l x hx
      exact ⟨t, List.mem_cons_of_mem _ ht, e⟩

