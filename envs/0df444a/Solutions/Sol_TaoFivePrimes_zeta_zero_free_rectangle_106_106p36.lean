lemma complex_identity (x y : ℝ) :
    (∑ n ∈ Finset.range 40, (c n:ℂ)*((y:ℂ)-Complex.I*x)^n)-
      (CertifiedLocalPolynomial.bivariatePowerValue 8 16 a
        (4*x^2) ((25/9)*(y-1/2)):ℂ)=Complex.I*(imaginaryValue x y:ℂ) := by
  norm_num [c,TaoFivePrimes_RH105To106RoundedCoefficients,Finset.sum_range_succ,
    CertifiedLocalPolynomial.bivariatePowerValue,
    a,entry,powerMatrix,Fin.sum_univ_succ,imaginaryValue]
  push_cast
  ring_nf
  norm_num [Complex.I_pow_eq_pow_mod]
  try simp only [Complex.I_sq,Complex.I_pow_three,pow_zero,pow_one]
  apply Complex.ext <;>
    simp [←Complex.ofReal_pow,Complex.mul_re,Complex.mul_im] <;> ring

lemma power_identity (s : ℂ) :
    (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH105To106RoundedCoefficients
      40 (211/2) s).re =
      CertifiedLocalPolynomial.bivariatePowerValue 8 16 a
        (4*(s.re-1/2)^2) ((25/9)*(s.im-106)) := by
  have h := complex_identity (s.re-1/2) (s.im-211/2)
  have hw : -Complex.I*(s-RH1000Analytic.CertifiedLocalXi.center (211/2)) =
      ((s.im-211/2:ℝ):ℂ)-Complex.I*((s.re-1/2:ℝ):ℂ) := by
    apply Complex.ext <;> simp [RH1000Analytic.CertifiedLocalXi.center] <;> ring
  unfold TaoFivePrimes_RHLocalRoundedPolynomial
  simp only [hw]
  have hr := congrArg Complex.re h
  simp only [Complex.sub_re,Complex.ofReal_re,Complex.mul_re,
    Complex.I_re,Complex.I_im,Complex.ofReal_im,zero_mul,mul_zero,sub_zero] at hr
  have he : (25/9:ℝ)*(s.im-211/2-1/2) = (25/9)*(s.im-106) := by ring
  rw [he] at hr
  simp only [c,Complex.ofReal_div,Complex.ofReal_intCast] at hr
  simp only [Complex.ofReal_intCast]
  linarith only [hr]

open scoped unitInterval
attribute [local irreducible] a r b
lemma polynomial_positive (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : 106 ≤ s.im) (hb : s.im ≤ (2659/25:ℝ)) :
    200 ≤ (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH105To106RoundedCoefficients
      40 (211/2) s).re := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(25/9)*(s.im-106),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 16 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 8
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, (200:ℝ)≤(b i j:ℝ) := by
    intro i j
    exact_mod_cast bernstein_checked.2.2 i j
  have hh := CertifiedLocalPolynomial.bivariate_bernstein_lower 8 16 a r b hr hc 200 hl x y
  rw [power_identity]
  exact hh

lemma rectangle_norm (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : 106 ≤ s.im) (hb : s.im ≤ (2659/25:ℝ)) :
    ‖s-RH1000Analytic.CertifiedLocalXi.center (211/2)‖ ≤ 1 := by
  have hx : |s.re-1/2|≤1/2 := abs_le.mpr ⟨by linarith,by linarith⟩
  have hy : |s.im-211/2|≤43/50 := abs_le.mpr ⟨by linarith,by linarith⟩
  have hx2 : (s.re-1/2)^2 ≤ (1/2:ℝ)^2 := by nlinarith [abs_nonneg (s.re-1/2),sq_abs (s.re-1/2)]
  have hy2 : (s.im-211/2)^2 ≤ (43/50:ℝ)^2 := by nlinarith [abs_nonneg (s.im-211/2),sq_abs (s.im-211/2)]
  have hn : ‖s-RH1000Analytic.CertifiedLocalXi.center (211/2)‖^2 =
      (s.re-1/2)^2 + (s.im-211/2)^2 := by
    rw [←Complex.normSq_eq_norm_sq]
    simp [Complex.normSq_apply,RH1000Analytic.CertifiedLocalXi.center,pow_two]
  nlinarith [norm_nonneg (s-RH1000Analytic.CertifiedLocalXi.center (211/2))]

lemma xi_nonzero_implies_zeta {s : ℂ} (h0 : 0< s.re) (h1 : s.re<1)
    (hXi : RH1000Analytic.CertifiedLocalXi.xi s≠0) : riemannZeta s≠0 := by
  have hs0 : s≠0 := fun h => by simp [h] at h0
  have hs1 : s≠1 := fun h => by simp [h] at h1
  have h1s : (1:ℂ)-s≠0 := sub_ne_zero.mpr hs1.symm
  rw [riemannZeta_def_of_ne_zero hs0]
  intro hz
  rcases div_eq_zero_iff.mp hz with hz | hz
  · apply hXi
    have hh := completedRiemannZeta_eq s
    rw [hz] at hh
    have hsum : completedRiemannZeta₀ s=1/s+1/(1-s) := by linear_combination -hh
    unfold RH1000Analytic.CertifiedLocalXi.xi
    rw [hsum]
    field_simp
    ring
  · exact Complex.Gammaℝ_ne_zero_of_re_pos h0 hz
end Slice106

theorem solution (s : ℂ) (h0 : 0 < s.re) (h1 : s.re < 1)
    (ha : 106 ≤ s.im) (hb : s.im ≤ (2659/25:ℝ)) : riemannZeta s ≠ 0 := by
  apply Slice106.xi_nonzero_implies_zeta h0 h1
  have he := TaoFivePrimes.rh105to106_xi_approximation s
    (Slice106.rectangle_norm s h0.le h1.le ha hb)
  have hp := Slice106.polynomial_positive s h0.le h1.le ha hb
  intro hz
  rw [hz,mul_zero,zero_sub,norm_neg] at he
  have hreal := Complex.abs_re_le_norm
    (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH105To106RoundedCoefficients 40 (211/2) s)
  have hle : (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH105To106RoundedCoefficients
    40 (211/2) s).re ≤ |(TaoFivePrimes_RHLocalRoundedPolynomial
      TaoFivePrimes_RH105To106RoundedCoefficients 40 (211/2) s).re| := le_abs_self _
  linarith
