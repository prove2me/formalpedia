  have u := uCDD A
  have c := cU_le (A + 1)
  have e1 : (A + 1 + 3) = A + 4 := by ring
  rw [e1] at c
  have p26 : (A + 2) ^ 2 ≤ (A + 4) ^ 6 := by
    calc (A + 2) ^ 2 ≤ (A + 4) ^ 2 := Nat.pow_le_pow_left (by omega) 2
      _ ≤ (A + 4) ^ 6 := Nat.pow_le_pow_right (by omega) (by omega)
  have p1 : 1 ≤ (A + 4) ^ 6 := Nat.one_le_pow _ _ (by omega)
  set X := (A + 4) ^ 6
  set u0 := J6Seg.Src.uC A J6Seg.Src.DD
  have hu : u0 ≤ 10 ^ 10 * X := le_trans u (Nat.mul_le_mul_left _ p26)
  have hK : 30 * NLogN.KFUU.cU (A + 1) + 20000 ≤ (30 * Kf + 20000) * X := by linarith
  have hn1 : (n' + 1) * (3 * u0 + u0) ≤ (n + n' + 1) * (4 * 10 ^ 10 * X) :=
    Nat.mul_le_mul (by omega) (by omega)
  have hc : (n + n' + 1) * (30 * NLogN.KFUU.cU (A + 1) + 20000) ≤
      (n + n' + 1) * ((30 * Kf + 20000) * X) := Nat.mul_le_mul_left _ hK
  have h6 : 6 * u0 ≤ (n + n' + 1) * (6 * 10 ^ 10 * X) := by
    have : 6 * u0 ≤ 6 * 10 ^ 10 * X := by omega
    exact le_trans this (Nat.le_mul_of_pos_left _ (by omega))
  have hsum : (30 * Kf + 20000) * X + 4 * 10 ^ 10 * X + 6 * 10 ^ 10 * X ≤ Kc * X := by
    unfold Kc; linarith
  have hm := Nat.mul_le_mul_left (n + n' + 1) hsum
  linarith [hm, hc, hn1, h6]

theorem cTail_le (W : ℕ) : J6A.SL.cTail W ≤ 10 ^ 12 * (W + 2) ^ 2 := by
  unfold J6A.SL.cTail
  have := uCDD W
  have h : W + 2 ≤ (W + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  generalize (W + 2) ^ 2 = U at *
  generalize J6Seg.Src.uC W J6Seg.Src.DD = u at *
  linarith

theorem cDn_le (W n n' : ℕ) :
    (n + n' + 1) * ((2 + 1) * J6Seg.Src.uC W J6Seg.Src.DD + J6Seg.Src.uC W J6Seg.Src.DD) +
      (4 + 1) * J6Seg.Src.uC W J6Seg.Src.DD ≤ (n + n' + 1) * (10 ^ 11 * (W + 2) ^ 2) := by
  have := uCDD W
  have h : (n + n' + 1) * (4 * J6Seg.Src.uC W J6Seg.Src.DD) ≤
      (n + n' + 1) * (4 * (10 ^ 10 * (W + 2) ^ 2)) := Nat.mul_le_mul_left _ (by omega)
  have h2 : 5 * J6Seg.Src.uC W J6Seg.Src.DD ≤ (n + n' + 1) * (5 * (10 ^ 10 * (W + 2) ^ 2)) :=
    le_trans (by omega) (Nat.le_mul_of_pos_left _ (by omega))
  generalize (W + 2) ^ 2 = U at *
  generalize J6Seg.Src.uC W J6Seg.Src.DD = u at *
  linarith

theorem cG1_le (W p m n' : ℕ) :
    J6A.SL.cG1 W p m n' ≤ 10 ^ 16 * (n' + p + m + 1) * (W + 2) ^ 2 := by
  unfold J6A.SL.cG1
  have a := cParA_le W p m
  have b := cT_le' J6A.SL.nPG (by simp [J6A.SL.nPG, Ex.size]) W
  have c := cT_le' J6A.SL.nG (by simp [J6A.SL.nG, Ex.size]) W
  have u1 := uC32 W
  have u2 := uCDD W
  have h : 1 ≤ (W + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  set U := (W + 2) ^ 2
  have hl : (n' + 1) * (303 * J6Seg.Src.uC W 32 + J6Seg.Src.uC W J6Seg.Src.DD) ≤
      (n' + 1) * (10 ^ 13 * U) := Nat.mul_le_mul_left _ (by omega)
  clear_value U
  generalize (n' + 1) * (303 * J6Seg.Src.uC W 32 + J6Seg.Src.uC W J6Seg.Src.DD) = q at *
  linarith [Nat.zero_le (n' * U), Nat.zero_le (p * U), Nat.zero_le (m * U)]

theorem cC1_le (W p m t : ℕ) :
    J6A.SL.cC1 W p m t ≤ 10 ^ 16 * (t + p + m + 1) * (W + 2) ^ 2 := by
  unfold J6A.SL.cC1
  have a := cParA_le W p m
  have b := cT_le' J6A.SL.nC (by simp [J6A.SL.nC, Ex.size]) W
  have u1 := uC32 W
  have u2 := uCDD W
  have h : 1 ≤ (W + 2) ^ 2 := Nat.one_le_pow _ _ (by omega)
  set U := (W + 2) ^ 2
  have hl : (t + 1) * (203 * J6Seg.Src.uC W 32 + J6Seg.Src.uC W J6Seg.Src.DD) ≤
      (t + 1) * (10 ^ 13 * U) := Nat.mul_le_mul_left _ (by omega)
  clear_value U
  generalize (t + 1) * (203 * J6Seg.Src.uC W 32 + J6Seg.Src.uC W J6Seg.Src.DD) = q at *
  linarith [Nat.zero_le (t * U), Nat.zero_le (p * U), Nat.zero_le (m * U)]

/-! ## The fine pieces -/

theorem cFsR_le (W p m : ℕ) {ea ey : Ex HS} (ha : ea.size ≤ 60) (hy : ey.size ≤ 60) (fl : ℕ) :
    J6A.FS.cFsR W p m ea ey fl ≤ 10 ^ 16 * (p + m + 1) * (W + 2) ^ 2 := by
  unfold J6A.FS.cFsR
  have a := cParA_le W p m
