variable {d : ℕ}

/-- The literal statement of Lemma 3.4, with `x, y ∈ ℤ^d` for arbitrary `h > 0`,
is false. -/
theorem solution :
    ¬ ∀ (d : ℕ) (h : ℝ), 0 < h → ∀ x y s t : EuclideanSpace ℝ (Fin d),
        x ∈ QFS.lattice d → y ∈ QFS.lattice d → Real.sqrt d * h < ‖x - y‖ →
        s ∈ QFS.cube h x → t ∈ QFS.cube h y →
        1 / (2 * Real.sqrt d) * ‖x - y‖ < ‖s - t‖ := by
  intro H
  have hlat : ∀ n : ℤ, QFS.pt (n : ℝ) ∈ QFS.lattice 1 := by
    intro n
    rw [QFS.mem_lattice_iff]
    exact fun i => ⟨n, by simp [QFS.pt]⟩
  have h1 : Real.sqrt (1 : ℕ) = 1 := by simp
  have hxy : Real.sqrt (1 : ℕ) * (3 / 2 : ℝ) < ‖QFS.pt 0 - QFS.pt 2‖ := by
    rw [QFS.norm_pt_sub, h1]; norm_num
  have hs : QFS.pt (7 / 10) ∈ QFS.cube (3 / 2 : ℝ) (QFS.pt 0) := by
    rw [QFS.mem_cube_iff, QFS.infNorm_pt_sub]; norm_num
  have ht : QFS.pt (13 / 10) ∈ QFS.cube (3 / 2 : ℝ) (QFS.pt 2) := by
    rw [QFS.mem_cube_iff, QFS.infNorm_pt_sub]; norm_num
  have := H 1 (3 / 2) (by norm_num) (QFS.pt 0) (QFS.pt 2) (QFS.pt (7 / 10)) (QFS.pt (13 / 10))
    (by simpa using hlat 0) (by simpa using hlat 2) hxy hs ht
  rw [QFS.norm_pt_sub, QFS.norm_pt_sub, h1] at this
  norm_num at this
