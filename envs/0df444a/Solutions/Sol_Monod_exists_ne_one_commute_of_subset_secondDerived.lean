section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

theorem exists_ne_one_commute_of_subset_secondDerived' (A : Subring ℝ) (S : Finset (H A))
    (hS : ∀ s ∈ S, s ∈ derivedSeries (H A) 2) :
    ∃ h : H A, h ≠ 1 ∧ ∀ s ∈ S, Commute h s := by
  have hev : ∀ᶠ x in 𝓝 (∞ : OnePoint ℝ), ∀ s ∈ S, (s : OnePoint ℝ ≃ₜ OnePoint ℝ) x = x :=
    (eventually_all_finset S).2 (fun s hs => derived2_trivial (hS s hs))
  obtain ⟨M, hM⟩ := eventually_atTop.1 (Filter.mem_map.1 (atTop_le_coe_nhds_infty hev))
  obtain ⟨n, hn⟩ := exists_nat_ge (M + 1)
  have hdet : ((n : ℤ) + 2) * (1 - n) - (1 - n - n ^ 2) * 1 = 1 := by ring
  set h0 := mkSL A ((n : ℤ) + 2) (1 - n - n ^ 2) 1 (1 - n) hdet with hh0
  obtain ⟨e00, e01, e10, e11⟩ := ent_mkSL (A := A) ((n : ℤ) + 2) (1 - n - n ^ 2) 1 (1 - n) hdet
  have hyp : IsHyperbolic h0 := by
    unfold IsHyperbolic
    rw [trace_ent, e00, e11]
    push_cast
    ring_nf
    norm_num
  have hc : 0 < ent h0 1 0 := by rw [e10]; norm_num
  have hQ : ∀ t : ℝ, Qf h0 t = (t - n) ^ 2 - (t - n) - 1 := by
    intro t; unfold Qf; rw [e00, e01, e10, e11]; push_cast; ring
  obtain ⟨f, hfG, hfin, hfout, hfinf⟩ := glue_in h0 hyp hc
  -- the region where `f` acts
  let inR : OnePoint ℝ → Prop := fun x => ∃ t : ℝ, x = t ∧ Qf h0 t < 0
  have hR_M : ∀ t : ℝ, Qf h0 t < 0 → M ≤ t := by
    intro t ht
    by_contra hlt
    push_neg at hlt
    rw [hQ] at ht
    have h1 : t - n ≤ -1 := by linarith
    nlinarith
  have hfix_not : ∀ x, ¬ inR x → f x = x := by
    intro x hx
    cases x with
    | infty => exact hfinf
    | coe t => exact hfout t (not_lt.1 fun h => hx ⟨t, rfl, h⟩)
  have hR_inv : ∀ x, inR x → inR (f x) := by
    rintro _ ⟨t, rfl, ht⟩
    have := (Qf_sign_invariant h0 hc (fun r => r < 0)
      (fun r s hs => ⟨fun h => by
        by_contra h'
        have := div_nonneg (not_lt.1 h') hs.le
        linarith, fun h => div_neg_of_neg_of_pos h hs⟩)
      (not_lt.2 (by positivity)) (t : OnePoint ℝ)).2 ⟨t, ht, rfl⟩
    obtain ⟨t', ht', he⟩ := this
    rw [hfin t ht]
    exact ⟨t', he.symm, ht'⟩
  have hs_R : ∀ s ∈ S, ∀ x, inR x → (s : OnePoint ℝ ≃ₜ OnePoint ℝ) x = x := by
    rintro s hs _ ⟨t, rfl, ht⟩
    exact hM t (hR_M t ht) s hs
  refine ⟨⟨f, H_of_G_infty hfG hfinf⟩, ?_, ?_⟩
  · intro h1
    have h2 : f = 1 := congrArg Subtype.val h1
    set t : ℝ := n + 1 / 2 with ht
    have hQt : Qf h0 t < 0 := by rw [hQ, ht]; ring_nf; norm_num
    have h3 : mob h0 (t : OnePoint ℝ) = t := by
      rw [← hfin t hQt, h2]; rfl
    have h4 := fixed_eq h0 h3
    have h5 : Qf h0 t = 0 := by unfold Qf; linarith
    linarith
  · intro s hs
    apply Subtype.ext
    apply Homeomorph.ext
    intro x
    show f ((s : OnePoint ℝ ≃ₜ OnePoint ℝ) x) = (s : OnePoint ℝ ≃ₜ OnePoint ℝ) (f x)
    by_cases hx : inR x
    · rw [hs_R s hs x hx, hs_R s hs (f x) (hR_inv x hx)]
    · rw [hfix_not x hx]
      apply hfix_not
      intro hy
      apply hx
      have h1 := hs_R s hs _ hy
      have h2 := (s : OnePoint ℝ ≃ₜ OnePoint ℝ).injective h1
      rw [h2] at hy
      exact hy

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set


end Monod.Dev.Dyn
end

open Monod in
open OnePoint Filter Topology in
theorem solution (A : Subring ℝ) (S : Finset (H A))
    (hS : ∀ s ∈ S, s ∈ derivedSeries (H A) 2) :
    ∃ h : H A, h ≠ 1 ∧ ∀ s ∈ S, Commute h s := by
  exact Dev.Dyn.exists_ne_one_commute_of_subset_secondDerived' A S hS
