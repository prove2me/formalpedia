theorem Rn.phaseK_sol_aux {W p s t α pkA pkC bA bC : ℕ} {v8 : Vr} {c1 : Cs}
    (hv : V2 p s t α (pkA * p + pkC) (bA * p + bC) v8) (hBv : BV W v8)
    (hB : PBnd W p t α pkA pkC bA bC)
    (hrW : 2 * (4 * J6A.WA p α (HAx p α) + 4 * HAx p α) < 2 ^ W) (hc : c1 cLC = []) :
    Rn phaseK v8 c1
      (fun v' => LV p s t α (pkA * p + pkC) (bA * p + bC) v' ∧ v' 10 = ncA p t α ∧ BV W v') c1
      (cPhaseK W (4 * J6A.WA p α (HAx p α) + 4 * HAx p α)) := by
  have hW32 := hB.w32
  have hbig := hB.hbig
  set b := bA * p + bC with hbd
  set pk := pkA * p + pkC with hpkd
  set r := 4 * J6A.WA p α (HAx p α) + 4 * HAx p α with hrd
  have hr2 : 2 ≤ r := by have := HAx_pos p α; omega
  -- `23 := b · r`
  have e23 : ((b : ℕ) : ℤ) * ((r : ℕ) : ℤ) = ((b * r : ℕ) : ℤ) := by push_cast; ring
  have s9 := Rn.asgs (W := W) (c := c1) [(23, .mul (.r 22) (.r 24))] (by decide)
    (by simp only [lbA, E.lb, max_le_iff]; omega) hBv
    ⟨by simp only [E.den, hv.a22, hv.a24]; rw [e23]; exact nat_le_W' hbig, trivial⟩
  refine Rn.seq s9 (fun v9 ⟨e9, hB9⟩ => ?_)
  subst e9
  simp only [runA, E.den, hv.a22, hv.a24] at hB9 ⊢
  set u0 := update v8 23 ((b : ℤ) * (r : ℤ)) with hu0
  have h24 : u0 24 = r := by
    rw [hu0, update_of_ne (by decide)]; exact hv.a24
  -- `22 := 0; 26 := 1`
  have s11 := Rn.asgs (W := W) (c := c1) [(22, .k 0), (26, .k 1)] (by decide)
    (by simp only [lbA, E.lb, nA0, nA1, max_le_iff]; omega) hB9
    ⟨zero_le_W, one_le_W hW32, trivial⟩
  refine Rn.seq s11 (fun v10 ⟨e10, hB10⟩ => ?_)
  subst e10
  simp only [runA, E.den] at hB10 ⊢
  have hcr := clog_le_self' r
  have hpc := pow_clog_le r hr2
  -- the `clog` loop
  have s12 := PJ.Rn.loopA (c := c1) (C := cLC) (rN := 24) (l := [(22, eClC), (26, eClY)]) nrg48
    (by decide) (by decide) (by decide) (W := W)
    (by simp only [lbA, eClC, eClY, E.lb, nA1, nA2, max_le_iff]; omega) (N := r) (by omega)
    (Iv := fun k w => w = update (update u0 22 ((min k (Nat.clog 2 r) : ℕ) : ℤ)) 26
      ((2 ^ min k (Nat.clog 2 r) : ℕ) : ℤ))
    (fun k hk w hI hBw => by
      subst hI
      obtain ⟨e1, e2⟩ := clg_step u0 r k h24
      have b1 : min (k + 1) (Nat.clog 2 r) ≤ r := le_trans (min_le_right _ _) hcr
      have b2 : 2 ^ min (k + 1) (Nat.clog 2 r) ≤ 2 * r :=
        le_trans (Nat.pow_le_pow_right (by norm_num) (min_le_right _ _)) hpc
      refine ⟨⟨by rw [e1]; exact nat_le_W' (by omega), by rw [e1, e2]; exact nat_le_W' (by omega),
        trivial⟩, ?_⟩
      simp only [runA]; rw [e1, e2, upd4])
    hc (by simp) hB10
    (by simp only [update_apply, Fin.isValue, Fin.reduceEq, if_false]; exact h24)
  refine s12.mono (fun v12 ⟨e12, hB12⟩ => ⟨?_, ?_, hB12⟩) le_rfl
  · subst e12
    rw [Nat.min_eq_right hcr]
    have ej : KR.AK.jA (2 * J6A.WA p α (HAx p α)) (2 * HAx p α) = Nat.clog 2 r := by
      unfold KR.AK.jA; rw [hrd]; congr 1; ring
    have er : b * (2 * (2 * J6A.WA p α (HAx p α) + 2 * HAx p α)) = b * r := by rw [hrd]; ring
    constructor <;> simp only [update_apply, hu0, Fin.isValue, Fin.reduceEq, if_false, if_true,
      ↓reduceIte, ej, er]
