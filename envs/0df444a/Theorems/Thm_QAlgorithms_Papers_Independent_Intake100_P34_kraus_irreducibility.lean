/-- PDF p.3: complex linear superoperators. -/
local notation "GeneratorMap" => fun d : ℕ => MatrixMap (Fin d) (Fin d)

/-- PDF p.4, Theorem 2.1: no star closure, no Kraus normalization, and no trace condition. -/
theorem kraus_irreducibility {d : ℕ} (hd : 0 < d) {J : Type*} [Fintype J]
    (Phi : GeneratorMap d) (V : J → Mat d)
    (hCP : QAlgorithms.Entanglement.IsCompletelyPositive Phi)
    (hKraus : ∀ X, Phi X = ∑ j, (V j)ᴴ * X * V j) :
    DaviesIrreducible Phi ↔ ∀ psi : Fin d → ℂ, psi ≠ 0 →
      ∀ chi : Fin d → ℂ, ∃ A : Mat d,
        A ∈ Algebra.adjoin ℂ (Set.range V) ∧ A *ᵥ psi = chi := by sorry

end QAlgorithms.Papers.Independent.Intake100.P34

