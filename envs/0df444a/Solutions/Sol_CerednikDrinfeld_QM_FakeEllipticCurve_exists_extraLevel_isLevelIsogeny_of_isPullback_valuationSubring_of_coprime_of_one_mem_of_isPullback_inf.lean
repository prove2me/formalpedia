theorem CerednikDrinfeld.QM.FakeEllipticCurve.hom_eq_of_isPullback_valuationSubring_of_comp_eq
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 𝒟 : FakeEllipticCurve Λ N ↥O) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (gE : E.A ⟶ 𝒜.A) (hgE : CategoryTheory.IsPullback gE E.f 𝒜.f (Spec.map (CommRingCat.ofHom O.subtype)))
    (Φ Φ' : 𝒜.A ⟶ 𝒟.A) (hΦ : Φ ≫ 𝒟.f = 𝒜.f) (hΦ' : Φ' ≫ 𝒟.f = 𝒜.f) (h : gE ≫ Φ = gE ≫ Φ') :
    Φ = Φ' := by
  haveI : Smooth 𝒜.f := 𝒜.bundle.smooth
  haveI : IsProper 𝒟.f := 𝒟.bundle.proper

  haveI hι₀ : IsDominant (Spec.map (CommRingCat.ofHom O.subtype)) := by
    refine ⟨?_⟩
    show DenseRange (PrimeSpectrum.comap (CommRingCat.ofHom O.subtype).hom)
    rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
    have hk : RingHom.ker (CommRingCat.ofHom O.subtype).hom = ⊥ :=
      (RingHom.injective_iff_ker_eq_bot _).mp (fun a b hab => Subtype.ext hab)
    rw [hk]
    exact bot_le
  haveI : IsSchemeTheoreticallyDominant (Spec.map (CommRingCat.ofHom O.subtype)) :=
    IsSchemeTheoreticallyDominant.of_isDominant _
  haveI hgEdom : IsSchemeTheoreticallyDominant gE := IsSchemeTheoreticallyDominant.of_isPullback hgE.flip

  let Z : Scheme.{0} := Spec (CommRingCat.of ↥O)
  let X' : Over Z := Over.mk 𝒜.f
  let Y' : Over Z := Over.mk 𝒟.f
  let U' : Over Z := Over.mk (gE ≫ 𝒜.f)
  let f' : X' ⟶ Y' := Over.homMk Φ hΦ
  let g' : X' ⟶ Y' := Over.homMk Φ' hΦ'
  let ι' : U' ⟶ X' := Over.homMk gE rfl
  haveI : IsSeparated Y'.hom := (inferInstance : IsSeparated 𝒟.f)
  have hfg : ι' ≫ f' = ι' ≫ g' := by ext1; exact h
  have hl : equalizer.lift ι' hfg ≫ equalizer.ι f' g' = ι' := equalizer.lift_ι _ _
  have hker : (equalizer.ι f' g').left.ker = ⊥ := by
    apply le_bot_iff.mp
    have h1 := (equalizer.lift ι' hfg).left.le_ker_comp (equalizer.ι f' g').left
    rw [← Over.comp_left, hl] at h1
    exact h1.trans (le_of_eq (IsSchemeTheoreticallyDominant.ker_eq_bot gE))
  haveI : IsIso (equalizer.ι f' g').left := IsClosedImmersion.isIso_iff_ker_eq_bot.mpr hker
  apply (cancel_epi (equalizer.ι f' g').left).mp
  have hc := congrArg (fun k => k.left) (equalizer.condition f' g')
  simp only [Over.comp_left] at hc
  exact hc

