-- title:
--   Lemma 16 — one-step inequality of composite mirror descent (quadratic proximal functions)
-- statement:
--   Let $\mathcal X\subseteq\mathbb R^d$ be closed and convex, $f_t$ and $\varphi$ convex, $\eta>0$, and let $x_1,x_2,\dots$ be generated by the composite mirror descent update (4) with quadratic proximal functions $\psi_t(x)=\tfrac12\langle x,H_tx\rangle$. Fix a round $t\in\{1,\dots,T\}$ in which $H_t$ is positive semidefinite and the subgradient $g_t=f_t'(x_t)$ lies in the range of $H_t$. Then for every $x^*\in\mathcal X$,
--   $$\eta\big(f_t(x_t)-f_t(x^*)\big)+\eta\big(\varphi(x_{t+1})-\varphi(x^*)\big)\le B_{\psi_t}(x^*,x_t)-B_{\psi_t}(x^*,x_{t+1})+\frac{\eta^2}{2}\|g_t\|_{\psi_t^*}^2,$$
--   where $B_{\psi_t}(x,y)=\tfrac12\langle x-y,H_t(x-y)\rangle$ and $\|g\|_{\psi_t^*}^2=\langle g,H_t^\dagger g\rangle$.
--
--   This is the per-round inequality whose sum is Proposition 3.
--
--   **Formalization Note** Specialised to quadratic proximal functions: the paper's hypothesis that $B_{\psi_t}$ is strongly convex with respect to $\|\cdot\|_{\psi_t}$ holds with equality for $\|x\|_{\psi_t}^2=\langle x,H_tx\rangle$. The dual (semi)norm is written with the pseudo-inverse, which is the dual norm exactly when $g_t$ is in the range of $H_t$ (otherwise the paper's dual norm is $+\infty$); this range condition is therefore a hypothesis. The comparator is required to lie in $\mathcal X$ (the proof applies the optimality condition (32), valid for $x\in\mathcal X$, at $x=x^*$).
-- source:
--   Duchi, Hazan, Singer, Adaptive Subgradient Methods for Online Learning and Stochastic Optimization, JMLR 12 (2011), p. 2154, Lemma 16

import Mathlib
import Definitions.Def_AdaGrad_Full_Algorithm2
open scoped MatrixOrder InnerProductSpace

namespace AdaGrad.Full

/-- Lemma 16 (p. 2154), specialised to quadratic proximal functions `ψ_t(x) = ½⟨x, H_t x⟩` with
`H_t` positive semidefinite and `g_t` in the range of `H_t`. -/
theorem lemma_16 {d : ℕ} (η : ℝ) (hη : 0 < η) (X : Set (EuclideanSpace ℝ (Fin d)))
    (hXc : Convex ℝ X) (hXcl : IsClosed X)
    (f : ℕ → EuclideanSpace ℝ (Fin d) → ℝ) (hf : ∀ t, ConvexOn ℝ Set.univ (f t))
    (ϕ : EuclideanSpace ℝ (Fin d) → ℝ) (hϕ : ConvexOn ℝ Set.univ ϕ)
    (H : ℕ → Matrix (Fin d) (Fin d) ℝ) (x g : ℕ → EuclideanSpace ℝ (Fin d)) (T : ℕ)
    (hrun : IsQuadMirrorDescentRun η X ϕ f H x g T) (t : ℕ) (ht : t ∈ Finset.Icc 1 T)
    (hH : (H t).PosSemidef) (hrange : g t ∈ LinearMap.range (Matrix.toEuclideanLin (H t)))
    (xstar : EuclideanSpace ℝ (Fin d)) (hstar : xstar ∈ X) :
    η * (f t (x t) - f t xstar) + η * (ϕ (x (t + 1)) - ϕ xstar) ≤
      bregman (H t) xstar (x t) - bregman (H t) xstar (x (t + 1))
        + η ^ 2 / 2 * dualNormSq (H t) (g t) := by sorry

end AdaGrad.Full
