          (NLogN.KFW.zszN (n := 3 * NLogN.KFW.mC ^ k % 4) (by push_cast; ring) (by omega) hBz)).congr ?_
        push_cast; ring
      have hcl2 : (NLogN.Ex.nmod (.mul (.lit 3) (.reg NLogN.KFW.vF)) (.lit 4) : NLogN.Ex NLogN.HS).Clean :=
        NLogN.KFW.clean_of_lt (fun j hj => by
          simp only [NLogN.Ex.regs, List.nil_append, List.append_nil, List.mem_singleton] at hj
