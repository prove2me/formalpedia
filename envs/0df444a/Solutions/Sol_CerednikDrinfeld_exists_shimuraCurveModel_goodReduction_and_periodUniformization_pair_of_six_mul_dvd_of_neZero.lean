private theorem exists_e (hinj : Function.Injective ιT)
    (hrange : ∀ t : T, IsOfFinAddOrder t → t ∈ ιT.range) :
    ∃ e : ↥𝒰.P.U →+ J, ∀ u : ↥𝒰.P.U, ιT (e u) = 𝒰.eFull (u : 𝒰.P.TorusPoints) := by
  have hfr : ∀ u : ↥𝒰.P.U, (𝒰.eFull.comp 𝒰.P.U.subtype.toAddMonoidHom) u ∈ ιT.range := fun u =>
    hrange _ ((EquivariantUniformization.eFull_restrict_U_torsion_and_equiv 𝒰).2.1 u)
  refine ⟨(AddMonoidHom.ofInjective hinj).symm.toAddMonoidHom.comp
    ((𝒰.eFull.comp 𝒰.P.U.subtype.toAddMonoidHom).codRestrict ιT.range hfr), fun u => ?_⟩
  exact AddMonoidHom.apply_ofInjective_symm hinj ⟨_, hfr u⟩

variable (e : ↥𝒰.P.U →+ J) (he : ∀ u : ↥𝒰.P.U, ιT (e u) = 𝒰.eFull (u : 𝒰.P.TorusPoints))

include he in
