open NLogN
open NLogN.KIL
open IntMul AModel AModelL12
variable {sh : Shape} {m Q : ℕ} (Λ : Layout sh (m + m) Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem NLogN.KIL.edgeSteps_il {Rg : Type*} [CommRing Rg] {W : ℕ} (C : Circuit Rg m W) (X : IMat m)
    [NeZero Q] (hQ : 1 < Q) (hX : FacAt Q C.fac X)
    (jOf : Fin (m + m) → Fin (m + m) → Fin Pp)
    (child : Fin (m + m) → Fin (m + m) → List ℤ → List ℤ) (hpos : ∀ a ∈ sh, 1 ≤ a)
    (t : IState HS) (R : List Item) (Bb : ℕ) (hV : zsz ((AModel.vol sh : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (c0 : ℕ)
    (hU : ∀ i u c, Step.shift i u c ∈ AModel.edgeSteps C Q X → SmallUnit2 Q u)
    (hC : ∀ a b, Step.swap a b ∈ AModel.edgeSteps C Q X → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints (child a b ys) ++ R)) c0 ∧
      child a b ys = (Step.swap a b).arr Λ 0 ys)
    (xs : List ℤ) (hx : DOK sh Bb xs) :
    IRuns I iprog (runCode (scodeU2 Λ) jOf (AModel.edgeSteps C Q X)) (t.upd 0 (ints xs ++ R))
      (t.upd 0 (ints (AModel.runArr Λ 0 (AModel.edgeSteps C Q X) xs) ++ R))
      ((4 * m + 2 * pivRank C X) * cShiftU sh.length (AModel.vol sh) Bb + pivRank C X * (c0 + 2) + 1) := by sorry
