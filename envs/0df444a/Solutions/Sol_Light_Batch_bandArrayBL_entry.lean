theorem Par.sizes_le_S7 (p : Par) :
    p.L.choose p.m ≤ p.S7 ∧ p.K0 ≤ p.S7 ∧ p.N0 ≤ p.S7 ∧ p.L < p.S7 := by
  have hchoose : p.L.choose p.m ≤ 2 ^ p.L := Nat.choose_le_two_pow _ _
  have hpow : 2 ^ p.L ≤ 7 ^ p.L := Nat.pow_le_pow_left (by omega) _
