open Polynomial ModularCurve ModularCurve.HpoolLevelRing
open scoped TensorProduct

theorem ModularCurve.HpoolLevelRing.exists_forall_etale_rat_tensorProduct_quotient_span_aeval_jChartFin
    (p : ℕ) [Fact p.Prime] [NeZero p] :
    ∃ c₀ : ℤ[X], c₀ ≠ 0 ∧ ∀ g : ℤ[X], g.Monic → Irreducible (g.map (Int.castRingHom ℚ)) → ¬ g ∣ c₀ →
      Algebra.Etale ℚ ((ℚ ⊗[ℤ] Afin p) ⧸
        Ideal.span {(1 : ℚ) ⊗ₜ[ℤ] Polynomial.aeval (AlgebraicCurve.TwoChartIntegralModel.jChartFin ℤ ↥(modularFunctionFieldFull p) (IgusaScheme.jFull p)) g}) := by sorry
