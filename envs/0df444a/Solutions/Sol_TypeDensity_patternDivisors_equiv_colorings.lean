theorem solution (k : Type) [Field k] [Finite k] (s : TypeDensity.State)
    (P : TypeDensity.TangentPattern s.degree) (hP : P.rt.val + P.rx.val + TypeDensity.patternWeight P.other = P.d.val)
    (hrx : ∀ a c, s = TypeDensity.State.single a c → P.rx.val = 0) :
    Nonempty (TypeDensity.patternDivisors k s P ≃ ∀ i : Fin s.degree,
      {f : {Q : TypeDensity.ClosedDirection k // Q ∉ TypeDensity.boundaryDirections k s ∧
          TypeDensity.directionDegree k Q = i.val + 1} → Option (Fin s.degree) //
        ∀ j : Fin s.degree, Nat.card {Q // f Q = some j} = (P.other (i, j)).val}) :=
  ⟨{ toFun := TypeDensity.toCol k s P
     invFun := fun F ↦ ⟨TypeDensity.toDiv k s P F, TypeDensity.toDiv_hasPattern k s P hP hrx F⟩
     left_inv := fun D ↦ Subtype.ext (TypeDensity.toDiv_toCol k s P D)
     right_inv := fun F ↦ TypeDensity.toCol_toDiv k s P hP hrx F }⟩
