theorem algebraMap_mem_igusaRing_iff
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ)) (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (ℓ : CuspidalType.ProjLine q) (c : AlgebraicClosure ℚ) :
    algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c ∈ OIg ℓ ↔ c ∈ A := by

  obtain ⟨γ, -, -, hℓ⟩ := hIg ℓ
  have hfix : (levelAutBar q M' ζ γ).toAlgHom.toRingHom
      (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c :=
    (levelAutBar q M' ζ γ).toAlgHom.commutes _
  rw [hℓ, ValuationSubring.mem_comap, hfix, hIg_inf]
  have hcoe : ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c : ↥(fieldBar q M')) :
      LaurentSeries (AlgebraicClosure ℚ)) = HahnSeries.single 0 c := by
    rw [← algebraMap_laurentSeries_eq_single]; rfl
  constructor
  · rintro ⟨x, y, hy, hxy⟩

    obtain ⟨n, hn⟩ : ∃ n : ℤ, (coeffMap (IsLocalRing.residue ↥A) y).coeff n ≠ 0 := by
      by_contra h
      push Not at h
      exact hy (HahnSeries.ext (funext h))
    rw [coeffMap_coeff] at hn
    have hunit : IsUnit (y.coeff n) := by
      by_contra hu
      exact hn ((IsLocalRing.residue_eq_zero_iff _).mpr (by rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]))

    have hcoeff := congrArg (fun z : LaurentSeries (AlgebraicClosure ℚ) => z.coeff n) hxy
    simp only [hcoe, HahnSeries.single_zero_mul_eq_smul] at hcoeff
    rw [HahnSeries.coeff_smul, coeffMap_coeff, coeffMap_coeff, smul_eq_mul] at hcoeff

    change c * ((y.coeff n : ↥A) : AlgebraicClosure ℚ) = ((x.coeff n : ↥A) : AlgebraicClosure ℚ) at hcoeff
    obtain ⟨u, hu⟩ := hunit
    have hc : c = (x.coeff n : AlgebraicClosure ℚ) * ((u⁻¹ : (↥A)ˣ) : ↥A) := by
      have hyu : ((y.coeff n : ↥A) : AlgebraicClosure ℚ) = ((u : ↥A) : AlgebraicClosure ℚ) := by rw [hu]
      have hne : ((u : ↥A) : AlgebraicClosure ℚ) ≠ 0 := by
        intro h0
        apply u.ne_zero
        exact Subtype.ext h0
      have : c * ((u : ↥A) : AlgebraicClosure ℚ) = (x.coeff n : AlgebraicClosure ℚ) := by rw [← hyu]; exact hcoeff
      have hinv : (((u⁻¹ : (↥A)ˣ) : ↥A) : AlgebraicClosure ℚ) = (((u : ↥A) : AlgebraicClosure ℚ))⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        have h1 : ((u⁻¹ : (↥A)ˣ) : ↥A) * (u : ↥A) = 1 := u.inv_mul
        have h2 := congrArg (Subtype.val : ↥A → AlgebraicClosure ℚ) h1
        rw [Subring.coe_mul] at h2
        exact h2
      rw [hinv, ← this, mul_inv_cancel_right₀ hne]
    rw [hc]
    exact A.toSubring.mul_mem (x.coeff n).2 ((u⁻¹ : (↥A)ˣ) : ↥A).2
  · intro hc
    refine ⟨HahnSeries.single 0 ⟨c, hc⟩, 1, ?_, ?_⟩
    · rw [map_one]; exact one_ne_zero
    · rw [map_one, mul_one, coeffMap_single, hcoe]
      rfl

