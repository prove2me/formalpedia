import Mathlib
import Definitions.Def_LasserreFC_FinConv_Setting
import Theorems.Thm_SemialgebraicSDP_Psatz_theorem_4_6_positivstellensatz

open MvPolynomial LasserreFC.FinConv SemialgebraicSDP.Psatz

theorem solution {n m1 m2 : ℕ} (P : POP n m1 m2) (p : MvPolynomial (Fin n) ℝ)
    (hp : p ∈ vanishingIdeal ℝ (realVariety P)) :
    ∃ e : ℕ, ∃ σ2 : MvPolynomial (Fin n) ℝ,
      IsSumSq σ2 ∧ p ^ (2 * e) + σ2 ∈ Ideal.span (Set.range P.h) := by
  -- the set {x : h(x) = 0, p(x) ≠ 0} is empty
  have hempty : psatzSet (Fin.elim0 : Fin 0 → MvPolynomial (Fin n) ℝ) ![p] P.h = ∅ := by
    ext x
    simp only [psatzSet, Set.mem_empty_iff_false, iff_false]
    rintro ⟨-, hg, hh⟩
    have hx : x ∈ realVariety P := hh
    have := (mem_vanishingIdeal_iff.1 hp) x hx
    exact hg 0 (by simpa using this)
  obtain ⟨F, hF, G, hG, H, hH, hsum⟩ := theorem_4_6_positivstellensatz _ _ _ hempty
  -- the cone generated by the empty family consists of sums of squares
  have hFsos : IsSumSq F := by
    have gen : ∀ a, InCone (Set.range (Fin.elim0 : Fin 0 → MvPolynomial (Fin n) ℝ)) a →
        IsSumSq a := by
      intro a ha
      induction ha with
      | of_mem h => obtain ⟨i, -⟩ := h; exact i.elim0
      | sq a => rw [sq, ← add_zero (a * a)]; exact IsSumSq.sq_add a IsSumSq.zero
      | add _ _ iha ihb => exact iha.add ihb
      | mul _ _ iha ihb => exact iha.mul ihb
    exact gen F hF
  -- the multiplicative monoid generated by p consists of powers of p
  have hrange : Set.range ![p] = {p} := by
    ext q; simp [eq_comm]
  rw [hrange, Submonoid.mem_closure_singleton] at hG
  obtain ⟨k, rfl⟩ := hG
  refine ⟨k, F, hFsos, ?_⟩
  have : p ^ (2 * k) + F = -H := by
    rw [mul_comm, pow_mul]; linear_combination hsum
  rw [this]
  exact (Ideal.neg_mem_iff _).2 hH
