  ext i j'
  rw [hgk]
  simp only [Units.val_mul, coe_unipotent, coe_diagZ, coe_scalarPi_zpow, scalar_fin_two, hD]
  fin_cases i <;> fin_cases j' <;>
    simp [Matrix.mul_apply, Fin.sum_univ_two, zpow_sub₀ hπ0, hu₁0] <;>
    (try field_simp)

end LocalIwasawa
