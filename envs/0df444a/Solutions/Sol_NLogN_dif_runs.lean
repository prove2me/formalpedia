      (by decide) (by decide) (by decide) (by decide) (by decide) s7 tops.reverse (s.G NLogN.P1)
      (s.G NLogN.HH) (n + 1) (by simp +decide [s7, s6, s5, s4, NLogN.ints_reverse])
      (by simp +decide [s7, s6, s5, s4, htl])
      (fun a ha => NLogN.canon_bnd hct a (List.mem_reverse.mp ha))
    set s8 := (s7.upd NLogN.P1 (s.G NLogN.P1)).upd NLogN.DX ((NLogN.ints tops.reverse).reverse ++ s7.G NLogN.DX) with hs8
    have hc2 := ih s8 tops (NLogN.ints db ++ R) (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF
      (2 * E) (by rw [htl, hh]) (by right; rw [← hh]; linarith) hct
      (by simp +decide [s8, s7, NLogN.ints_reverse])
      (by have e3 : ((h : ℕ) : ℤ) = 2 ^ j := by rw [hh]; push_cast; rfl
          simp +decide [s8, s7, s6, s5, e3])
      (by simp +decide [s8, s7, s6, s5])
      (by simp +decide [s8, s7, s6, s5, s4, hN]) (by simp +decide [s8, s7, s6, s5, s4, hF])
    set dt := NLogN.difZ (2 ^ n + 1) (2 * E) j tops with hdt
    set s9 := s8.upd NLogN.DX (NLogN.ints dt ++ (NLogN.ints db ++ R)) with hs9
    -- segment H
    have hH : NLogN.IRuns I iprog NLogN.difSegH s9 (s.upd NLogN.DX (NLogN.ints (NLogN.difZ (2 ^ n + 1) E (j + 1) A) ++ R))
        (1000 * (n + 3)) := by
      apply NLogN.IRuns.of_runsTo 0
      simp +decide [NLogN.difSegH, NLogN.IStmt.run, NLogN.IOp.run, s9, s8, s7, s6, s5, NLogN.zsz_two_pow]
      refine ⟨?_, ?_⟩
      · have e4 : NLogN.difZ (2 ^ n + 1) E (j + 1) A = dt ++ db := by
