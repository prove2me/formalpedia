/-- `t ↦ b_s(1/t)/(1/t)`, with the limiting value `sigma_b` at `0`. -/
noncomputable def betaratio (j : ℝ) (q : ℝ → ℝ) (t : ℝ) : ℝ :=
  if t = 0 then sigmaB j q else (1 / t) * bfun j q (1 / t)

/-- `h(t) = 6·(b_s(1/t)/(1/t)) - r(t)`, the second-order coefficient of the rotation shift. -/
noncomputable def hfun (j : ℝ) (q r : ℝ → ℝ) (t : ℝ) : ℝ :=
  6 * betaratio j q t - r t

