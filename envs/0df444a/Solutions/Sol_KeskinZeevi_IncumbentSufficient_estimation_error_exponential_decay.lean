/-- Chernoff step for one sign: `P(s·M_t ≥ δ Ĵ_t-type event) ≤ exp(-c m)` via Markov. -/
lemma markov_Z {M : Model} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ) (hε : LightTailedNoise P ε σ)
    (K l₀ : ℝ)
    (hK : ∀ t (l : ℝ), |l| ≤ l₀ → Integrable (fun ω => Real.exp (l * ε t ω)) P ∧
        ∫ ω, Real.exp (l * ε t ω) ∂P ≤ Real.exp (K * l ^ 2))
    (π : Policy M) (β z : ℝ) (hz : |z| * (M.u - M.l) ≤ l₀) (n : ℕ) (a : ℝ) :
    P {ω | ENNReal.ofReal (Real.exp a) ≤
      ENNReal.ofReal (Real.exp (z * noiseSum π β ε n ω - K * z ^ 2 * Jhat π β ε n ω))} ≤
      ENNReal.ofReal (Real.exp (-a)) := by
  have hm := hε.measurable
  have hmeas : AEMeasurable (fun ω => ENNReal.ofReal
      (Real.exp (z * noiseSum π β ε n ω - K * z ^ 2 * Jhat π β ε n ω))) P := by
    have h1 : Measurable (fun ω => noiseSum π β ε n ω) :=
      (noiseSum_measF π β ε n).mono (F_le ε hm n) le_rfl
    have h2 : Measurable (fun ω => Jhat π β ε n ω) :=
      (Jhat_measF π β ε n).mono (F_le ε hm n) le_rfl
    exact (ENNReal.measurable_ofReal.comp
      ((measurable_const.mul h1).sub (measurable_const.mul h2)).exp).aemeasurable
  have hmk := mul_meas_ge_le_lintegral₀ hmeas (ENNReal.ofReal (Real.exp a))
  have hZ := Z_bound P ε σ hε K l₀ hK π β z hz n
  set E := {ω | ENNReal.ofReal (Real.exp a) ≤
      ENNReal.ofReal (Real.exp (z * noiseSum π β ε n ω - K * z ^ 2 * Jhat π β ε n ω))}
  have hone : ENNReal.ofReal (Real.exp (-a)) * ENNReal.ofReal (Real.exp a) = 1 := by
    rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, neg_add_cancel, Real.exp_zero,
      ENNReal.ofReal_one]
  calc P E = ENNReal.ofReal (Real.exp (-a)) * (ENNReal.ofReal (Real.exp a) * P E) := by
        rw [← mul_assoc, hone, one_mul]
    _ ≤ ENNReal.ofReal (Real.exp (-a)) * 1 := by gcongr; exact hmk.trans hZ
    _ = ENNReal.ofReal (Real.exp (-a)) := mul_one _

end Aux_KZI_L5

open KeskinZeevi.IncumbentSufficient Aux_KZI_L5 in
theorem solution (M : Model) {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (ε : ℕ → Ω → ℝ) (σ : ℝ)
    (hε : LightTailedNoise P ε σ) :
    ∃ ρ : ℝ, 0 < ρ ∧
      ∀ (π : Policy M) (β : ℝ), β ∈ M.B →
      ∀ δ m : ℝ, 0 < δ → 0 < m → ∀ t : ℕ, 2 ≤ t →
        P {ω | δ < |betaHat π β ε t ω - β| ∧ m ≤ Jhat π β ε t ω} ≤
          ENNReal.ofReal (2 * Real.exp (-(ρ * min δ (δ ^ 2) * m))) := by
  obtain ⟨K, hK0, l₀, hl₀, hK⟩ := mgf_bound P ε σ hε
  have hBpos : 0 < M.u - M.l := by linarith [M.l_lt_u]
  have hz₁ : 0 < l₀ / (M.u - M.l) := div_pos hl₀ hBpos
  refine ⟨min (l₀ / (M.u - M.l) / 2) (1 / (4 * K)), lt_min (by positivity) (by positivity), ?_⟩
  intro π β hβ δ m hδ hm t _
  obtain ⟨z, hz⟩ : ∃ z, z = min (l₀ / (M.u - M.l)) (δ / (2 * K)) := ⟨_, rfl⟩
  have hzpos : 0 < z := by rw [hz]; exact lt_min hz₁ (by positivity)
  have hzle : z ≤ l₀ / (M.u - M.l) := by rw [hz]; exact min_le_left _ _
  have hzB : |z| * (M.u - M.l) ≤ l₀ := by
    rw [abs_of_pos hzpos]
    calc z * (M.u - M.l) ≤ l₀ / (M.u - M.l) * (M.u - M.l) :=
          mul_le_mul_of_nonneg_right hzle hBpos.le
      _ = l₀ := div_mul_cancel₀ _ hBpos.ne'
  have hzB' : |-z| * (M.u - M.l) ≤ l₀ := by rwa [abs_neg]
  have hKz : K * z ≤ δ / 2 := by
    have : z ≤ δ / (2 * K) := by rw [hz]; exact min_le_right _ _
    calc K * z ≤ K * (δ / (2 * K)) := mul_le_mul_of_nonneg_left this hK0.le
      _ = δ / 2 := by field_simp
  set c₀ := z * δ / 2 with hc₀def
  have hc₀ : min (l₀ / (M.u - M.l) / 2) (1 / (4 * K)) * min δ (δ ^ 2) ≤ c₀ := by
    rcases min_cases (l₀ / (M.u - M.l)) (δ / (2 * K)) with ⟨h1, _⟩ | ⟨h1, _⟩
    · calc min (l₀ / (M.u - M.l) / 2) (1 / (4 * K)) * min δ (δ ^ 2)
          ≤ (l₀ / (M.u - M.l) / 2) * δ :=
            mul_le_mul (min_le_left _ _) (min_le_left _ _) (by positivity) (by positivity)
        _ = c₀ := by rw [hc₀def, hz, h1]; ring
    · calc min (l₀ / (M.u - M.l) / 2) (1 / (4 * K)) * min δ (δ ^ 2)
          ≤ (1 / (4 * K)) * δ ^ 2 :=
            mul_le_mul (min_le_right _ _) (min_le_right _ _) (by positivity) (by positivity)
        _ = c₀ := by rw [hc₀def, hz, h1]; field_simp; ring
  have hc₀pos : 0 < c₀ := by positivity
  -- the two one-sided events
  set Ep := {ω | ENNReal.ofReal (Real.exp (c₀ * m)) ≤
      ENNReal.ofReal (Real.exp (z * noiseSum π β ε t ω - K * z ^ 2 * Jhat π β ε t ω))}
  set En := {ω | ENNReal.ofReal (Real.exp (c₀ * m)) ≤
      ENNReal.ofReal (Real.exp (-z * noiseSum π β ε t ω - K * (-z) ^ 2 * Jhat π β ε t ω))}
  have hsub : {ω | δ < |betaHat π β ε t ω - β| ∧ m ≤ Jhat π β ε t ω} ⊆ Ep ∪ En := by
    intro ω hω
    obtain ⟨h1, h2⟩ := hω
    set J := Jhat π β ε t ω
    set Ms := noiseSum π β ε t ω
    have hJpos : 0 < J := lt_of_lt_of_le hm h2
    have hratio := ls_error_eq_ratio M π β ε t ω hJpos.ne'
    rw [hratio, abs_div, abs_of_pos hJpos, lt_div_iff₀ hJpos] at h1
    -- generic one-sided bound
    have key : ∀ w : ℝ, δ * J < w → c₀ * m ≤ z * w - K * z ^ 2 * J := by
      intro w hw
      have e1 : z * (δ * J) ≤ z * w := mul_le_mul_of_nonneg_left hw.le hzpos.le
      have e2 : K * z ^ 2 * J ≤ δ / 2 * z * J := by
        have : K * z ^ 2 * J = (K * z) * z * J := by ring
        rw [this]
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hKz hzpos.le) hJpos.le
      have e3 : c₀ * m ≤ c₀ * J := mul_le_mul_of_nonneg_left h2 hc₀pos.le
      have e4 : c₀ * J = z * (δ * J) - δ / 2 * z * J := by rw [hc₀def]; ring
      linarith
    rcases abs_cases Ms with ⟨hM, _⟩ | ⟨hM, _⟩
    · left
      rw [hM] at h1
      show ENNReal.ofReal (Real.exp (c₀ * m)) ≤ ENNReal.ofReal (Real.exp (z * Ms - K * z ^ 2 * J))
      exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr (key Ms h1))
    · right
      rw [hM] at h1
      show ENNReal.ofReal (Real.exp (c₀ * m)) ≤
        ENNReal.ofReal (Real.exp (-z * Ms - K * (-z) ^ 2 * J))
      have := key (-Ms) h1
      have e : -z * Ms - K * (-z) ^ 2 * J = z * -Ms - K * z ^ 2 * J := by ring
      rw [e]
      exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr this)
  have hp := markov_Z P ε σ hε K l₀ hK π β z hzB t (c₀ * m)
  have hn := markov_Z P ε σ hε K l₀ hK π β (-z) hzB' t (c₀ * m)
  have hexp : Real.exp (-(c₀ * m)) ≤
      Real.exp (-(min (l₀ / (M.u - M.l) / 2) (1 / (4 * K)) * min δ (δ ^ 2) * m)) := by
    apply Real.exp_le_exp.mpr
    have := mul_le_mul_of_nonneg_right hc₀ hm.le
    linarith
  calc P {ω | δ < |betaHat π β ε t ω - β| ∧ m ≤ Jhat π β ε t ω}
      ≤ P (Ep ∪ En) := measure_mono hsub
    _ ≤ P Ep + P En := measure_union_le _ _
    _ ≤ ENNReal.ofReal (Real.exp (-(c₀ * m))) + ENNReal.ofReal (Real.exp (-(c₀ * m))) :=
        add_le_add hp hn
    _ = ENNReal.ofReal (2 * Real.exp (-(c₀ * m))) := by
        rw [← ENNReal.ofReal_add (Real.exp_pos _).le (Real.exp_pos _).le, two_mul]
    _ ≤ _ := ENNReal.ofReal_le_ofReal (by linarith)
