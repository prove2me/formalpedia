-- title:
--   Wealth generated by decision rules of the filtered model
-- statement:
--   Let $f_k:E_X\times\mathbb P(E_Y)\to\mathbb R^d$, $k=0,1,\dots$, be decision rules of the filtered model. Starting from wealth $x_0=x$ and belief $\mu_0=\rho$, along an observed return path $(z_1,\dots,z_n)$ they generate the wealth
--   $$
--   x_{k+1}=(1+i_{k+1})\big(x_k+f_k(x_k,\mu_k)\cdot z_{k+1}\big),
--   $$
--   where $\mu_k$ is the filter started at $\rho$ along $(z_1,\dots,z_k)$. This is the state process of the filtered Markov Decision Model under the Markov policy $(f_k)$, and also the wealth of the strategy $f_k(h_k):=f_k(x_k,\mu_k(\cdot\mid h_k))$ of the original problem.
-- source:
--   Bäuerle & Rieder (2011), §5.3, p.158 (PDF 171); Theorem 6.1.1 d), p.177 (PDF 190)

import Mathlib
import Definitions.Def_BauerleRiederMDP_PartialObs_Market_filter

open MeasureTheory ProbabilityTheory
open scoped ENNReal Matrix

namespace BauerleRiederMDP.PartialObs

/-- **The wealth generated by decision rules of the filtered model.**
Bäuerle & Rieder (2011), §5.3, p.158 (PDF 171): a Markov policy `(f'_0, …, f'_{N−1})` of the
filtered model, `f'_k : E_X × IP(E_Y) → A`, induces the policy `f_k(h_k) := f'_k(x_k, μ_k(·|h_k))`
of the partially observed problem; Theorem 6.1.1 d), p.177 (PDF 190), uses it with
`f'_k = f*_{N−k}`.

`markovWealth M i x ρ f n r` is the wealth `x_n` reached from `x_0 = x` along the observed
return path `r = (z_1, …, z_n)` when at each time `k` the amount `f k (x_k, μ_k)` is invested,
`μ_k = M.filter ρ k (z_1, …, z_k)` being the filter started from `ρ`:
`x_{k+1} = (1 + i_{k+1})(x_k + f_k(x_k, μ_k) · z_{k+1})`.

**Formalization Note.** Paths are 0-indexed (`r k = z_{k+1}`); `i (k+1)` is `i_{k+1}`. -/
noncomputable def markovWealth {EY : Type*} [MeasurableSpace EY] {d : ℕ} (M : Market EY d)
    (i : ℕ → ℝ) (x : ℝ) (ρ : ProbabilityMeasure EY)
    (f : ℕ → ℝ × ProbabilityMeasure EY → Fin d → ℝ) : (n : ℕ) → (Fin n → Fin d → ℝ) → ℝ
  | 0, _ => x
  | n + 1, r =>
      (1 + i (n + 1)) * (markovWealth M i x ρ f n (Fin.init r) +
        f n (markovWealth M i x ρ f n (Fin.init r), M.filter ρ n (Fin.init r)) ⬝ᵥ
          r (Fin.last n))

end BauerleRiederMDP.PartialObs


