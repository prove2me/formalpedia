section
-- Source module: Solutions.R6Final
/-!
# Round six: the platform target `IntMul.Kappa.jain_round6_framework` (T0)

**`jain_round6_framework_of`**: the exact statement of `IntMul.Kappa.jain_round6_framework`,
assuming the three stack interfaces not yet proved (`FineNeed6`, `LineNeed6`, `P14Need6`) at
every admissible parameter record. Everything else is plugged in:

* `r6_normalize` (the hypotheses → a parameter record `P` with `P.Ok`, `κ < P.gap`, the two
  moment bounds and the guard bound);
* `kappa_final6` (the assembly; it moves to a rational `ε` internally via `rat_eps`);
* `setupNeed6`, `crtNeed6_all`, `p18IL6` (the proved stack interfaces);
* `Bit.NB.bitNetR6_mom` (the bit network) and `Cx.cxNetR6G` (the complex network in the gate
  class `IL3H.GClassH`), and `IL3H.p14Need6_all` (`P14Need6`, in `jain_round6_framework_of'`).

`jain_round6_framework_of'` discharges `FineNeed6` by `fineNeed6_all`. Once the remaining interfaces are proved, the target follows by applying this theorem to
them.
-/

namespace IntMul.Kappa.R6

open IntMul.Kappa

/-- **The round-six target, modulo `FineNeed6`, `LineNeed6`, `P14Need6`.** -/
theorem jain_round6_framework_of
    (hFine : ∀ P : Prm, P.Ok → FineNeed6 P) (hLine : ∀ P : Prm, P.Ok → LineNeed6 P)
    (hP14 : ∀ P : Prm, P.Ok → P14Need6 P)
    (ab ac ε x C₁ κ : ℝ) (hab : 0 ≤ ab) (hac : 0 ≤ ac)
    (hbit : histMoment Jain.bitR6 529 (1 - ab) < 148225616)
    (hcx : histMoment Jain.cxR6 576 (1 - ac) < 207387136)
    (hasm : CrudeAssembly ab ac (1 / 1000) ε x C₁ κ 576 (histRankSum Jain.cxR6)) :
    KappaBound κ := by
  obtain ⟨P, hP, hκ, hb, hc, hC⟩ := r6_normalize ab ac ε x C₁ κ hab hac hbit hcx hasm
  exact kappa_final6 κ setupNeed6 crtNeed6_all hFine hLine hP14 p18IL6 P hP hκ hb hc hC
    (Bit.NB.bitNetR6_mom_exp : Bit.BitNetR6MomStmt) Cx.cxNetR6G

/-- **The round-six target, modulo `LineNeed6`** (`FineNeed6` is
`NLogN.KFUU.R6Fine.fineNeed6_all`, `P14Need6` is `IL3H.p14Need6_all`). -/
theorem jain_round6_framework_of'
    (hLine : ∀ P : Prm, P.Ok → LineNeed6 P)
    (ab ac ε x C₁ κ : ℝ) (hab : 0 ≤ ab) (hac : 0 ≤ ac)
    (hbit : histMoment Jain.bitR6 529 (1 - ab) < 148225616)
    (hcx : histMoment Jain.cxR6 576 (1 - ac) < 207387136)
    (hasm : CrudeAssembly ab ac (1 / 1000) ε x C₁ κ 576 (histRankSum Jain.cxR6)) :
    KappaBound κ :=
  jain_round6_framework_of NLogN.KFUU.R6Fine.fineNeed6_all hLine IL3H.p14Need6_all ab ac ε x C₁ κ hab hac
    hbit hcx hasm

end IntMul.Kappa.R6

end

