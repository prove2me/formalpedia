  obtain ⟨w3, hw3⟩ : ∃ w3 : Vr, w3 = update (update w2 29 ((lam - 1 - k : ℕ) : ℤ)) 12
      ((D SGM).getD (lam - 1 - k) 0) := ⟨_, rfl⟩
  have q3 : ∀ j : Fin HS, j ≠ 29 → j ≠ 5 → j ≠ 11 → j ≠ 12 → w3 j = u j := fun j a b c' d' => by
    rw [hw3, update_of_ne d', update_of_ne a, q2 j a b c']
