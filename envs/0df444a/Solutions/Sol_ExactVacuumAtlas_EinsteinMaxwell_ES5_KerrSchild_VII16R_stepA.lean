      = (1 - h * x) ^ 2 * F * A + 2 * Q * F * b ^ 2 * x ^ 2 * (J + 2 * Q * A) := by
    linear_combination h0
  rw [eq_div_of_mul_eq (by positivity) key]
  field_simp

