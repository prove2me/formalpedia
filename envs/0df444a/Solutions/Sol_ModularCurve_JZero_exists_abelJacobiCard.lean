open ModularCurve.JZeroAbelJacobiCardViaPeriods in
theorem solution (N : ℕ) [NeZero N] : ∃ g : ℕ, ∀ (p : ℕ) [Fact p.Prime], AbelJacobiCard (AlgebraicClosure ℚ) (modularFunctionFieldBar N) p g := by
  refine ⟨Module.finrank ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2), fun p _ n => ?_⟩
  have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  rw [natCard_torsion_jZero_eq_pow_finrank N (p ^ n) (pow_ne_zero n hp),
    finrank_periodLattice_eq N, ← pow_mul, Nat.mul_comm n]

