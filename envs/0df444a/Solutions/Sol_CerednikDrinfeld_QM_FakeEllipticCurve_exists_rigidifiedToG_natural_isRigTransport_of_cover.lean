    (htr₂ : FakeEllipticCurve.Rigidification.IsRigTransport θ₀ κ β₀ x₂.2 θ₂ j₂ t₂)
    (hadm₂ : t₂.IsAdmissible ι ((frobTwist Onr Fr (-(j₂ : ℤ)) (φ₂.comp ψ) : Onr →ₐ[𝒪] L₂) : Onr →+* L₂)) :
