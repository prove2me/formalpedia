  have hbz : ∀ x : ℕ, x ≤ k + 1 + e + NLogN.KFW.mC + K * NLogN.KFW.mC ^ k + NLogN.KFW.ES (k + 1) + P8Lift.sc + NLogN.KFW.cL + Bn +
      4 * NLogN.KFW.mC ^ k + 4 → NLogN.zsz (x : ℤ) ≤ Bz := fun x hx => le_trans (NLogN.zsz_natCast_le hx) hBz
