theorem scanBody_spec (w : IState HS) (k0 a b ca cb : ℤ) (hk0 : 0 ≤ k0) (Rst LA LB : List Item)
    (h0 : w.G 0 = .int k0 :: .int a :: .int b :: Rst) (hA : w.G hCa = .int ca :: LA)
