theorem solution (mu beta : ℝ) {x : Pt 5} (hx : x ∈ domU5) :
    ∀ i, i ≠ 0 → 0 < diagEF5 mu beta x i := by
  intro i hi
  have hr := domU5_r_pos hx
  have hu := domU5_u_pos hx
  have h1u := domU5_1mu_pos hx
  have hr2 : 0 < x 1 ^ 2 := sq_pos_of_ne_zero hr.ne'
  fin_cases i
  · exact absurd rfl hi
  · simp only [diagEF5]; norm_num
  · simp only [diagEF5]; exact div_pos hr2 (mul_pos (mul_pos (by norm_num) hu) h1u)
  · simp only [diagEF5]; exact mul_pos hr2 hu
  · simp only [diagEF5]; exact mul_pos hr2 h1u
