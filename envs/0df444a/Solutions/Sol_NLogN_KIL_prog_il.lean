variable {m W : ℕ} [NeZero W] (C : Circuit (ZMod 2) m W) (N : ℕ) [NeZero N] (A B Cs : Shape)

theorem cShiftD_le (D n V Bb : ℕ) :
    cShiftD D n V Bb ≤ (2 * (D + 1) ^ 2 * 10 ^ 6 + 2 * 10 ^ 8 + 10 ^ 6 * (n + 1)) *
      ((V + 1) * (Bb + 2) ^ 2) := by
  have h1 := cShiftU_le n V Bb
  have h2 : cShift n V Bb ≤ cShiftU n V Bb := by unfold cShiftU; omega
  set X := (V + 1) * (Bb + 2) ^ 2 with hX
  have hb1 : (V + 1) * (Bb + 2) ≤ X := by
    rw [hX, pow_two, ← mul_assoc]; exact Nat.le_mul_of_pos_right _ (by omega)
  have e : 2 * (D + 1) ^ 2 * 10 ^ 6 * (V + 1) * (Bb + 2) =
      2 * (D + 1) ^ 2 * 10 ^ 6 * ((V + 1) * (Bb + 2)) := by ring
  have h3 := Nat.mul_le_mul_left (2 * (D + 1) ^ 2 * 10 ^ 6) hb1
  unfold cShiftD
  rw [e]
  nlinarith

/-- **One level, explicit code**: `levelC` with the shift code `scodeF` computes `levelR` with
cost `Kf C D nB · (V + 1) · (Bb + 2)² + rankSum C · (c₀ + 2)`. -/
theorem levelF_run (D : ℕ) (hN : 1 < N)
    (hfr : FramesOK (FrOK C N (ShFrac N D)) C.gates C.Min C.Mout) (P L' : ℕ)
    (hpos : ∀ a ∈ P :: L' :: hdShape A B Cs m N, 1 ≤ a) {Pp : ℕ} (I : List Sym)
    (iprog : Fin Pp → IStmt HS Pp) (jOf : Fin (m + m) → Fin (m + m) → Fin Pp)
    (child : Fin (m + m) → Fin (m + m) → List (ZMod 2) → List (ZMod 2)) (c0 Bb : ℕ)
    (hcall : ∀ (i j : Fin m) (t : IState HS) (R : List Item) (ys : List (ZMod 2)),
      ys.length = vol (P :: L' :: hdShape A B Cs m N) →
      IRuns I iprog (iprog (jOf (Fin.castAdd m i) (Fin.natAdd m j)))
        (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child (Fin.castAdd m i) (Fin.natAdd m j) ys)) ++ R)) c0 ∧
      (child (Fin.castAdd m i) (Fin.natAdd m j) ys).length =
        vol (P :: L' :: hdShape A B Cs m N))
    (hV : zsz ((vol (P :: W * L' :: hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * N : ℕ) : ℤ) ≤ Bb) (t : IState HS) (R : List Item) (xs : List (ZMod 2))
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    IRuns I iprog (levelC C N P L' A B Cs (scodeF ((hdLayout A B Cs m N).cons2 P L') (repOf D N))
        jOf) (t.upd 0 (ints (enc2 xs) ++ R))
      (t.upd 0 (ints (enc2 (levelR C N P L' A B Cs child xs)) ++ R))
      (Kf C D ((hdShape A B Cs m N).length + 2) *
          ((vol (P :: W * L' :: hdShape A B Cs m N) + 1) * (Bb + 2) ^ 2) +
        rankSum C * (c0 + 2)) := by
  set nB := (hdShape A B Cs m N).length + 2
  set ΛS := (hdLayout A B Cs m N).cons2 P L'
  set v := vol (P :: L' :: hdShape A B Cs m N)
  set V := vol (P :: W * L' :: hdShape A B Cs m N)
  have hVv : V = W * v := vol_big N P L' A B Cs
  have hvV : v ≤ V := by rw [hVv]; exact Nat.le_mul_of_pos_left v (NeZero.pos W)
  have hVS : zsz ((v : ℕ) : ℤ) ≤ Bb := le_trans (zsz_natCast_le' hvV) hV
  have H := levelR_run C N P L' A B Cs (I := I) (iprog := iprog) hN hpos
    (scodeF ΛS (repOf D N)) (ShFrac N D)
    (cShiftD D (P :: L' :: hdShape A B Cs m N).length v Bb) c0 Bb
    (fun s hs t R ys hy => by
      cases s with
      | shift i u c =>
        exact shiftF_runs ΛS D (repOf D N) hpos t R Bb hVS hQ2 i u (repOf_ok hN hs.1) c hs.2 ys hy
      | swap a b => exact absurd hs (by simp [ShFrac]))
    hfr jOf child hcall hV hQ2 t R xs hxs
  refine H.mono (le_trans (levelCI_le C N P L' A B Cs hN hpos
    (framesOK_mono (fun X hX => hX.1) _ _ _ hfr) _ c0 Bb) ?_)
  have hn : (P :: W * L' :: hdShape A B Cs m N).length = nB := by simp [nB]
  have hn' : (P :: L' :: hdShape A B Cs m N).length = nB := by simp [nB]
  rw [hn, hn']
  have h1 := cShiftD_le D nB v Bb
  have h2 : (v + 1) * (Bb + 2) ^ 2 ≤ (V + 1) * (Bb + 2) ^ 2 := Nat.mul_le_mul_right _ (by omega)
  have h3 := Nat.mul_le_mul_left (nShift C) (le_trans h1 (Nat.mul_le_mul_left _ h2))
  unfold Kf
  nlinarith

end LevelF

end NLogN.KIL

