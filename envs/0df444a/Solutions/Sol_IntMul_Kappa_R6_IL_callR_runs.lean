-- Source module: Solutions.KIL6NE
/-!
# KIL6: natural-number expressions

`NE` is a small language of natural-number expressions over registers (`+`, `-` (truncation
excluded by hypothesis), `*`, `/`, `%`, `if a < b then x else y`), compiled to `Ex HS`.
`NE.good`: on a state whose registers hold the naturals `v i`, if every intermediate value is
`≤ M` and `zsz M ≤ B`, then the compiled expression is clean, well defined, `B`-bounded and
evaluates to the natural value.  This turns every descriptor computation into arithmetic.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

namespace NE

theorem regs_toEx : ∀ e : NE, e.toEx.regs = e.regs
  | reg _ | lit _ => rfl
  | add a b | mul a b | div a b | mod a b => by
      simp only [toEx, Ex.regs, regs, regs_toEx a, regs_toEx b]
  | sub a b => by simp only [toEx, Ex.regs, regs, regs_toEx a, regs_toEx b]
  | lt a b x y => by
      simp only [toEx, Ex.regs, regs, regs_toEx a, regs_toEx b, regs_toEx x, regs_toEx y,
        List.append_assoc]

theorem clean {e : NE} (h : e.RegsLt) : e.toEx.Clean := by
  intro i hi
  rw [regs_toEx] at hi
  exact clean_of_lt (h i hi) i (by simp [Ex.regs])

end NE

