-- title:
--   Unnumbered canonical restriction decomposition (1.2)–(1.3)
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Fix a simple module $V^\lambda$ at level $n$. For each path $T$ ending at $\lambda$, define $V_T=\epsilon_TV^\lambda$. These are canonical lines and
--
--   $$V^\lambda=\bigoplus_{T\mapsto\lambda}V_T,\qquad\dim_k V_T=1.$$
--
--   For $0\le i\le n$, the $A_i$-submodule generated by $V_T$ equals $\epsilon(\lambda_i)\cdots\epsilon(\lambda_n)V^\lambda$ and is isomorphic to the simple $V^{\lambda_i}$. Choosing any nonzero $v_T\in V_T$ gives a basis of $V^\lambda$; any two such choices differ by independent nonzero scalar multiples.
--
--   This constructs the GT basis from successive isotypic restriction, independently of any JM sequence.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 4, Unnumbered canonical restriction decomposition (1.2)–(1.3)

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Canonical restriction decomposition (1.2)–(1.3), source PDF p. 4. Includes
cyclic submodules and their simple types, arbitrary choices of basis vectors, and
uniqueness up to independent nonzero scalar factors. -/
theorem canonical_restriction_decomposition (D : Tower k AA) (n : ℕ)
    (lam : (D.split n).Label) :
    DirectSum.IsInternal (fun t : TowerPathsTo D n lam => gtLine D lam t.val) ∧
    (∀ t : TowerPathsTo D n lam, Module.finrank k (gtLine D lam t.val) = 1) ∧
    (∀ t : TowerPathsTo D n lam, ∀ i (hi : i ≤ n),
      cyclicSpan D lam t.val i hi =
        LinearMap.range (simpleAction (D.split n) lam (tailProjector D t.val i hi)) ∧
      ∃ e : cyclicSpan D lam t.val i hi ≃ₗ[k]
          SimpleSpace (D.split i) (towerVertex D t.val i hi),
        ∀ a : AA i, ∀ w,
          simpleAction (D.split n) lam (D.inc i n hi a) (e.symm w : SimpleSpace (D.split n) lam) =
            (e.symm (simpleAction (D.split i) (towerVertex D t.val i hi) a w) :
              SimpleSpace (D.split n) lam)) ∧
    (∀ v : TowerPathsTo D n lam → SimpleSpace (D.split n) lam, IsGTChoice D lam v →
      ∃ b : Module.Basis (TowerPathsTo D n lam) k (SimpleSpace (D.split n) lam), ∀ t, b t = v t) ∧
    (∀ v w : TowerPathsTo D n lam → SimpleSpace (D.split n) lam,
      IsGTChoice D lam v → IsGTChoice D lam w →
      ∃ c : TowerPathsTo D n lam → k, ∀ t, c t ≠ 0 ∧ w t = c t • v t) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
