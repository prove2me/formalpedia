      have := hDr.lb; omega
    · exact zc _ (by omega)
  have s1 := hdr_in (s := s) (F := F0) (h := jHdr P k K G fs bs cc) (body := body) (B := Bx) rfl
    (by rw [hT]; rfl) (fun X hX => by
      simp only [hdrRegs, List.mem_cons, List.not_mem_nil, or_false] at hX
      rcases hX with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
