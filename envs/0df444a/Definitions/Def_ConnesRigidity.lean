    have hratio : δ / κ < 1 := (div_lt_one hκ).mpr hδκ
    linarith
  have hpbig : 1 - δ / κ < ‖p‖ := by
    have htriangle : ‖ξ‖ ≤ ‖(p : W)‖ + ‖z‖ := by
      calc
        ‖ξ‖ = ‖(p : W) + z‖ := by
          congr 1
          dsimp [p, z]
          abel
