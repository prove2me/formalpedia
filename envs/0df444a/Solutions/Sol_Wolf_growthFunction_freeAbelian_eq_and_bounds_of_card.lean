import Definitions.Def_Chou_Growth
import Mathlib
import Definitions.Def_MilnorWolf_Growth

/-!
# Chou §3, p. 399: the growth rate of a finitely generated group

Milnor's observation that `|B(n)|^{1/n}` converges, and Wolf's observation that exponential
growth does not depend on the choice of finite generating set.  Both come from Fekete's lemma
applied to the subadditive sequence `n ↦ log |B(n)|`: Mathlib's `Subadditive.lim` is *defined*
as the infimum of `u n / n` over `n ≥ 1`, so the limit `v` satisfies `v ^ n ≤ |B(n)|` for
**every** `n`, not merely eventually — which is what the `∀ n` in `HasExponentialGrowth` needs.
-/

namespace Chou
namespace Lib

open Chou

variable {G : Type*} [Group G]

/-! ### Elementary properties of word balls -/

lemma one_mem_wordBall (S : Set G) (n : ℕ) : (1 : G) ∈ wordBall S n :=
  ⟨[], by simp, by simp, by simp⟩

lemma wordBall_mono (S : Set G) {m n : ℕ} (h : m ≤ n) : wordBall S m ⊆ wordBall S n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen.trans h, hmem, rfl⟩

lemma mul_mem_wordBall {S : Set G} {a b : G} {m n : ℕ} (ha : a ∈ wordBall S m)
    (hb : b ∈ wordBall S n) : a * b ∈ wordBall S (m + n) := by
  obtain ⟨l₁, h₁, hm₁, rfl⟩ := ha
  obtain ⟨l₂, h₂, hm₂, rfl⟩ := hb
  refine ⟨l₁ ++ l₂, ?_, ?_, ?_⟩
  · simpa using Nat.add_le_add h₁ h₂
  · intro x hx
    rcases List.mem_append.1 hx with h | h
    · exact hm₁ x h
    · exact hm₂ x h
  · simp

lemma inv_mem_wordBall {S : Set G} {a : G} {n : ℕ} (ha : a ∈ wordBall S n) :
    a⁻¹ ∈ wordBall S n := by
  obtain ⟨l, hlen, hmem, rfl⟩ := ha
  refine ⟨(l.map fun x => x⁻¹).reverse, ?_, ?_, (List.prod_inv_reverse l).symm⟩
  · simpa using hlen
  · intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rcases hmem y hy with h | h
    · exact Or.inr (by simpa using h)
    · exact Or.inl h

/-- Every element of the subgroup generated by `T` lies in some `T`-ball. -/
lemma exists_mem_wordBall_of_mem_closure {T : Set G} {g : G} (hg : g ∈ Subgroup.closure T) :
    ∃ m : ℕ, g ∈ wordBall T m := by
  induction hg using Subgroup.closure_induction with
  | mem x hx => exact ⟨1, [x], by simp, by simpa using Or.inl hx, by simp⟩
  | one => exact ⟨0, one_mem_wordBall T 0⟩
  | mul x y _ _ ihx ihy =>
      obtain ⟨m, hm⟩ := ihx
      obtain ⟨n, hn⟩ := ihy
      exact ⟨m + n, mul_mem_wordBall hm hn⟩
  | inv x _ ih =>
      obtain ⟨m, hm⟩ := ih
      exact ⟨m, inv_mem_wordBall hm⟩

/-- Comparison of balls for two generating sets: if every element of `T` is an `S`-word of
length at most `k`, then the `T`-ball of radius `n` sits inside the `S`-ball of radius `k * n`. -/
lemma wordBall_subset_wordBall_of_forall_mem {S T : Set G} {k : ℕ}
    (h : ∀ t ∈ T, t ∈ wordBall S k) (n : ℕ) : wordBall T n ⊆ wordBall S (k * n) := by
  have hstep : ∀ x : G, (x ∈ T ∨ x⁻¹ ∈ T) → x ∈ wordBall S k := by
    rintro x (hx | hx)
    · exact h x hx
    · simpa using inv_mem_wordBall (h _ hx)
  have main : ∀ l : List G, (∀ x ∈ l, x ∈ wordBall S k) →
      l.prod ∈ wordBall S (k * l.length) := by
    intro l
    induction l with
    | nil => intro _; simpa using one_mem_wordBall S 0
    | cons a t ih =>
        intro hl
        have harith : k * (a :: t).length = k + k * t.length := by
          simp only [List.length_cons]; ring
        rw [List.prod_cons, harith]
        exact mul_mem_wordBall (hl a (by simp)) (ih fun x hx => hl x (List.mem_cons_of_mem _ hx))
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact wordBall_mono S (Nat.mul_le_mul le_rfl hlen) (main l fun x hx => hstep x (hmem x hx))

/-! ### Finiteness and cardinality of balls -/

/-- For a finite generating set the balls are finite. -/
lemma finite_wordBall (S : Finset G) (n : ℕ) : (wordBall (S : Set G) n).Finite := by
  classical
  set T : Finset G := S ∪ S.image (fun x => x⁻¹) with hT
  have key : wordBall (S : Set G) n ⊆
      (fun l : List T => (l.map Subtype.val).prod) '' {l : List T | l.length ≤ n} := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    have hmemT : ∀ x ∈ l, x ∈ T := by
      intro x hx
      rcases hmem x hx with h | h
      · exact Finset.mem_union_left _ h
      · exact Finset.mem_union_right _ (Finset.mem_image.2 ⟨x⁻¹, h, by simp⟩)
    refine ⟨l.attach.map (fun x => (⟨x.1, hmemT x.1 x.2⟩ : T)), ?_, ?_⟩
    · simpa using hlen
    · simp
  exact Set.Finite.subset (Set.Finite.image _ (List.finite_length_le _ n)) key

lemma one_le_card_wordBall (S : Finset G) (n : ℕ) : 1 ≤ Nat.card (wordBall (S : Set G) n) := by
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_pos (finite_wordBall S n)).2 ⟨1, one_mem_wordBall _ _⟩

lemma card_wordBall_pos (S : Finset G) (n : ℕ) :
    (0 : ℝ) < (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  exact_mod_cast one_le_card_wordBall S n

/-- Submultiplicativity of the ball sizes: a word of length `≤ m + n` splits as a word of
length `≤ m` times a word of length `≤ n`. -/
lemma card_wordBall_add_le (S : Finset G) (m n : ℕ) :
    Nat.card (wordBall (S : Set G) (m + n)) ≤
      Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
  have hfin : (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n).Finite :=
    (finite_wordBall S m).prod (finite_wordBall S n)
  have hsub : wordBall (S : Set G) (m + n) ⊆
      (fun p : G × G => p.1 * p.2) ''
        (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
    rintro g ⟨l, hlen, hmem, rfl⟩
    refine ⟨((l.take m).prod, (l.drop m).prod), ⟨⟨l.take m, ?_, ?_, rfl⟩,
      ⟨l.drop m, ?_, ?_, rfl⟩⟩, ?_⟩
    · simp
    · exact fun x hx => hmem x (List.mem_of_mem_take hx)
    · have hd : (l.drop m).length = l.length - m := List.length_drop ..
      omega
    · exact fun x hx => hmem x (List.mem_of_mem_drop hx)
    · simp [← List.prod_append, List.take_append_drop]
  calc Nat.card (wordBall (S : Set G) (m + n))
      ≤ Nat.card ((fun p : G × G => p.1 * p.2) ''
          (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n)) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_le_ncard hsub (hfin.image _)
    _ ≤ Nat.card (wordBall (S : Set G) m ×ˢ wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_image_le hfin
    _ = Nat.card (wordBall (S : Set G) m) * Nat.card (wordBall (S : Set G) n) := by
        simp only [Nat.card_coe_set_eq]
        exact Set.ncard_prod

lemma card_wordBall_le_of_subset {S T : Finset G} {m n : ℕ}
    (h : wordBall (S : Set G) m ⊆ wordBall (T : Set G) n) :
    Nat.card (wordBall (S : Set G) m) ≤ Nat.card (wordBall (T : Set G) n) := by
  simp only [Nat.card_coe_set_eq]
  exact Set.ncard_le_ncard h (finite_wordBall T n)

/-! ### Fekete's lemma applied to `log |B(n)|` -/

/-- The logarithm of the size of the ball of radius `n`. -/
noncomputable def logBall (S : Finset G) (n : ℕ) : ℝ :=
  Real.log (Nat.card (wordBall (S : Set G) n))

lemma logBall_nonneg (S : Finset G) (n : ℕ) : 0 ≤ logBall S n :=
  Real.log_nonneg (by exact_mod_cast one_le_card_wordBall S n)

lemma exp_logBall (S : Finset G) (n : ℕ) :
    Real.exp (logBall S n) = (Nat.card (wordBall (S : Set G) n) : ℝ) :=
  Real.exp_log (card_wordBall_pos S n)

lemma subadditive_logBall (S : Finset G) : Subadditive (logBall S) := by
  intro m n
  have h1 := card_wordBall_pos S m
  have h2 := card_wordBall_pos S n
  have hle : (Nat.card (wordBall (S : Set G) (m + n)) : ℝ) ≤
      (Nat.card (wordBall (S : Set G) m) : ℝ) * (Nat.card (wordBall (S : Set G) n) : ℝ) := by
    exact_mod_cast card_wordBall_add_le S m n
  calc logBall S (m + n)
      ≤ Real.log ((Nat.card (wordBall (S : Set G) m) : ℝ) *
          (Nat.card (wordBall (S : Set G) n) : ℝ)) :=
        Real.log_le_log (card_wordBall_pos S (m + n)) hle
    _ = logBall S m + logBall S n := Real.log_mul h1.ne' h2.ne'

lemma bddBelow_logBall_div (S : Finset G) :
    BddBelow (Set.range fun n : ℕ => logBall S n / n) := by
  refine ⟨0, ?_⟩
  rintro x ⟨n, rfl⟩
  exact div_nonneg (logBall_nonneg S n) (Nat.cast_nonneg n)

/-- The growth rate of `G` with respect to the finite generating set `S`:
`exp` of Fekete's limit of `log |B(n)| / n`. -/
noncomputable def growthRate (S : Finset G) : ℝ := Real.exp (subadditive_logBall S).lim

lemma growthRate_eq (S : Finset G) : growthRate S = Real.exp (subadditive_logBall S).lim := rfl

lemma growthRate_pos (S : Finset G) : 0 < growthRate S := Real.exp_pos _

lemma tendsto_logBall_div (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => logBall S n / n) Filter.atTop
      (nhds (subadditive_logBall S).lim) :=
  (subadditive_logBall S).tendsto_lim (bddBelow_logBall_div S)

lemma card_wordBall_rpow_eq_exp (S : Finset G) (n : ℕ) :
    (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) = Real.exp (logBall S n / n) := by
  rw [Real.rpow_def_of_pos (card_wordBall_pos S n), mul_one_div]
  rfl

/-- Milnor, p. 399: `|B(n)|^{1/n}` converges to `growthRate S`. -/
theorem tendsto_card_wordBall_rpow_inv (S : Finset G) :
    Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds (growthRate S)) := by
  refine Filter.Tendsto.congr (fun n => (card_wordBall_rpow_eq_exp S n).symm) ?_
  exact (Real.continuous_exp.tendsto _).comp (tendsto_logBall_div S)

/-- **The infimum characterisation.**  `Subadditive.lim` is an infimum, so the growth rate is a
*lower* bound for every `|B(n)|^{1/n}` with `n ≥ 1`, not merely a limit. -/
theorem growthRate_le_card_wordBall_rpow_inv (S : Finset G) {n : ℕ} (hn : n ≠ 0) :
    growthRate S ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)) := by
  rw [card_wordBall_rpow_eq_exp]
  exact Real.exp_le_exp.2 ((subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn)

/-- The form in which the infimum characterisation is used: `v ^ n ≤ |B(n)|` for **every** `n`. -/
theorem growthRate_pow_le_card_wordBall (S : Finset G) (n : ℕ) :
    growthRate S ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simpa using (by exact_mod_cast one_le_card_wordBall S 0 :
      (1 : ℝ) ≤ (Nat.card (wordBall (S : Set G) 0) : ℝ))
  · have hn' : (0 : ℝ) < n := by exact_mod_cast hn
    have hle := (subadditive_logBall S).lim_le_div (bddBelow_logBall_div S) hn.ne'
    rw [le_div_iff₀ hn'] at hle
    have h1 : growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) :=
      (Real.exp_nat_mul _ n).symm
    calc growthRate S ^ n = Real.exp ((n : ℝ) * (subadditive_logBall S).lim) := h1
      _ ≤ Real.exp (logBall S n) := Real.exp_le_exp.2 (by linarith)
      _ = (Nat.card (wordBall (S : Set G) n) : ℝ) := exp_logBall S n

/-! ### The two theorems -/

/-- p. 399, Milnor's theorem as Chou states it: for a finite generating set `S`, the growth rate
`lim |B(n)|^{1/n}` exists. -/
theorem exists_tendsto_card_wordBall_rpow_inv' {G : Type*} [Group G] (S : Finset G)
    (hS : Subgroup.closure (S : Set G) = ⊤) :
    ∃ v : ℝ, Filter.Tendsto (fun n : ℕ => (Nat.card (wordBall (S : Set G) n) : ℝ) ^ (1 / (n : ℝ)))
      Filter.atTop (nhds v) :=
  ⟨growthRate S, tendsto_card_wordBall_rpow_inv S⟩

/-- Every `S`-ball sits inside a `T`-ball of a uniformly rescaled radius, when `T` generates. -/
lemma exists_wordBall_subset (S T : Finset G) (hT : Subgroup.closure (T : Set G) = ⊤) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (S : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  classical
  have H : ∀ s ∈ S, ∃ m : ℕ, s ∈ wordBall (T : Set G) m := fun s _ =>
    exists_mem_wordBall_of_mem_closure (by rw [hT]; trivial)
  choose f hf using H
  refine ⟨(S.attach.sup fun s => f s.1 s.2) + 1, Nat.succ_pos _, fun n => ?_⟩
  refine wordBall_subset_wordBall_of_forall_mem (fun s hs => ?_) n
  have hs' : s ∈ S := hs
  refine wordBall_mono _ ?_ (hf s hs')
  have hsup : f s hs' ≤ S.attach.sup fun s : {x // x ∈ S} => f s.1 s.2 :=
    Finset.le_sup (f := fun s : {x // x ∈ S} => f s.1 s.2) (Finset.mem_attach S ⟨s, hs'⟩)
  omega

/-- p. 399 (Wolf): exponential growth does not depend on the choice of the finite generating
set. -/
theorem hasExponentialGrowth_iff_forall' {G : Type*} [Group G] [Group.FG G] :
    HasExponentialGrowth G ↔
      ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ →
        ∃ c : ℝ, 1 < c ∧ ∀ n : ℕ, c ^ n ≤ (Nat.card (wordBall (S : Set G) n) : ℝ) := by
  constructor
  · rintro ⟨S, -, c, hc, hcn⟩ T hT
    obtain ⟨k, hk, hkn⟩ := exists_wordBall_subset S T hT
    have hkR : (0 : ℝ) < k := by exact_mod_cast hk
    -- the `T`-balls of radius `k * n` are at least as big as the `S`-balls of radius `n`
    have hball : ∀ n : ℕ, (c : ℝ) ^ n ≤ (Nat.card (wordBall (T : Set G) (k * n)) : ℝ) := by
      intro n
      refine (hcn n).trans ?_
      exact_mod_cast card_wordBall_le_of_subset (hkn n)
    -- hence `log c / k` is a lower bound along the subsequence `k * n`
    have hdiv : ∀ n : ℕ, 1 ≤ n → Real.log c / k ≤ logBall T (k * n) / ((k * n : ℕ) : ℝ) := by
      intro n hn
      have hnR : (0 : ℝ) < n := by exact_mod_cast hn
      have h1 : (n : ℝ) * Real.log c ≤ logBall T (k * n) := by
        have hlog := Real.log_le_log (by positivity : (0 : ℝ) < c ^ n) (hball n)
        rwa [Real.log_pow] at hlog
      rw [div_le_div_iff₀ hkR (by push_cast; positivity)]
      have h2 : (k : ℝ) * ((n : ℝ) * Real.log c) ≤ (k : ℝ) * logBall T (k * n) :=
        mul_le_mul_of_nonneg_left h1 hkR.le
      push_cast
      linarith
    -- Fekete's limit is at least `log c / k`
    have hmul : Filter.Tendsto (fun n : ℕ => k * n) Filter.atTop Filter.atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_mul_of_pos_left n hk) Filter.tendsto_id
    have hsubseq : Filter.Tendsto (fun n : ℕ => logBall T (k * n) / ((k * n : ℕ) : ℝ))
        Filter.atTop (nhds (subadditive_logBall T).lim) := (tendsto_logBall_div T).comp hmul
    have hge : Real.log c / k ≤ (subadditive_logBall T).lim :=
      ge_of_tendsto hsubseq (Filter.eventually_atTop.2 ⟨1, fun n hn => hdiv n hn⟩)
    refine ⟨growthRate T, ?_, growthRate_pow_le_card_wordBall T⟩
    have hpos : (0 : ℝ) < Real.log c / k := div_pos (Real.log_pos hc) hkR
    calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
      _ < Real.exp (subadditive_logBall T).lim := Real.exp_lt_exp.2 (lt_of_lt_of_le hpos hge)
      _ = growthRate T := (growthRate_eq T).symm
  · intro h
    obtain ⟨-, S, -, hS⟩ := Group.fg_iff'.mp ‹Group.FG G›
    obtain ⟨c, hc, hcn⟩ := h S hS
    exact ⟨S, hS, c, hc, hcn⟩

end Lib
end Chou

/-!
# Word balls: images under a homomorphism, and comparison against a non-generating set

Two additions to the ball API of the Chou development.  A ball on the image of a set is the
image of the ball, which is what identifies the balls of a subgroup with the balls of its image
in the ambient group; and balls can be compared against a set that generates only a subgroup,
which is the form needed when the comparison happens inside a finite-index subgroup rather than
in the whole group.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {G : Type*} [Group G]

/-- A ball on the image of a set is the image of the ball: a word on `f '' V` is `f` of the
corresponding word on `V`. -/
theorem wordBall_image {K : Type*} [Group K] (f : G →* K) (V : Set G) (n : ℕ) :
    wordBall (f '' V) n = f '' wordBall V n := by
  have lift : ∀ l : List K, (∀ x ∈ l, x ∈ f '' V ∨ x⁻¹ ∈ f '' V) →
      ∃ p : G, p ∈ wordBall V l.length ∧ f p = l.prod := by
    intro l
    induction l with
    | nil => exact fun _ => ⟨1, one_mem_wordBall V 0, by simp⟩
    | cons a t ih =>
        intro hmem
        obtain ⟨p, hp, hfp⟩ := ih (fun x hx => hmem x (List.mem_cons_of_mem _ hx))
        obtain ⟨b, hb, hfb⟩ : ∃ b : G, (b ∈ V ∨ b⁻¹ ∈ V) ∧ f b = a := by
          rcases hmem a (by simp) with ⟨v, hv, hva⟩ | ⟨v, hv, hva⟩
          · exact ⟨v, Or.inl hv, hva⟩
          · exact ⟨v⁻¹, Or.inr (by simpa using hv), by rw [map_inv, hva, inv_inv]⟩
        obtain ⟨lp, hlp, hmp, rfl⟩ := hp
        refine ⟨b * lp.prod, ⟨b :: lp, by simpa using hlp, ?_, by simp⟩, ?_⟩
        · intro x hx
          rcases List.mem_cons.1 hx with rfl | hx
          · exact hb
          · exact hmp x hx
        · rw [List.prod_cons, map_mul, hfb, hfp]
  apply Set.eq_of_subset_of_subset
  · rintro y ⟨l, hlen, hmem, rfl⟩
    obtain ⟨p, hp, hfp⟩ := lift l hmem
    exact ⟨p, wordBall_mono V hlen hp, hfp⟩
  · rintro y ⟨x, ⟨l, hlen, hmem, rfl⟩, rfl⟩
    refine ⟨l.map f, by simpa using hlen, ?_, by rw [← map_list_prod f l]⟩
    intro z hz
    obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    rcases hmem w hw with h | h
    · exact Or.inl ⟨w, h, rfl⟩
    · exact Or.inr ⟨w⁻¹, h, by simp⟩

theorem wordBall_mono_set {A B : Set G} (h : A ⊆ B) (n : ℕ) :
    wordBall A n ⊆ wordBall B n := by
  rintro g ⟨l, hlen, hmem, rfl⟩
  exact ⟨l, hlen, fun x hx => (hmem x hx).imp (fun hh => h hh) (fun hh => h hh), rfl⟩

theorem mem_wordBall_one {U : Set G} {u : G} (hu : u ∈ U) : u ∈ wordBall U 1 :=
  ⟨[u], by simp, by simpa using Or.inl hu, by simp⟩

/-- Finitely many elements of a generated subgroup are words of a single bounded length. -/
theorem exists_forall_mem_wordBall (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ u ∈ U, u ∈ wordBall (T : Set G) k := by
  classical
  have H : ∀ u ∈ U, ∃ m : ℕ, u ∈ wordBall (T : Set G) m := fun u hu =>
    exists_mem_wordBall_of_mem_closure (hU u hu)
  choose f hf using H
  refine ⟨(U.attach.sup fun u => f u.1 u.2) + 1, Nat.succ_pos _, fun u hu => ?_⟩
  have hu' : u ∈ U := hu
  refine wordBall_mono _ ?_ (hf u hu')
  have hsup : f u hu' ≤ U.attach.sup fun u : {x // x ∈ U} => f u.1 u.2 :=
    Finset.le_sup (f := fun u : {x // x ∈ U} => f u.1 u.2) (Finset.mem_attach U ⟨u, hu'⟩)
  omega

/-- If every element of `U` lies in the subgroup generated by `T`, the `U`-balls sit inside the
`T`-balls at a linear cost.  Unlike `Chou.Lib.exists_wordBall_subset`, `T` is not required to
generate the ambient group. -/
theorem exists_wordBall_subset_of_mem_closure (U T : Finset G)
    (hU : ∀ u ∈ U, u ∈ Subgroup.closure (T : Set G)) :
    ∃ k : ℕ, 0 < k ∧ ∀ n : ℕ, wordBall (U : Set G) n ⊆ wordBall (T : Set G) (k * n) := by
  obtain ⟨k, hk, hmem⟩ := exists_forall_mem_wordBall U T hU
  exact ⟨k, hk, fun n => wordBall_subset_wordBall_of_forall_mem (fun u hu => hmem u hu) n⟩

end Lib
end Wolf

/-!
# Wolf's Lemma 3.4 (p. 426): rescaling a polynomial lower bound

Two upgrades of a lower bound on the growth function, both of which Theorem 3.2 uses.  A bound
`c (m - r)^q` becomes `c' m^q`, because `(m - r)/m ≥ 1/(r+1)` once `m ≥ r + 1`, and below that the
ball already has at least one element.  A bound along the multiples of `l` becomes a bound for
every `m`, by dropping from `m` to the largest multiple `l ⌊m/l⌋` below it, which is at least
`m / l` once `m ≥ l`.

Wolf takes the constant to be a minimum over the finitely many small values of the growth
function; since every ball contains the identity, `min c 1` divided by `(r+1)^q`, resp. `l^q`,
serves in both ranges at once.  The second half is proved directly rather than, as Wolf does, by
reducing it to the first.
-/

namespace Wolf
namespace Lib

open Chou Chou.Lib

variable {Γ : Type*} [Group Γ]

theorem one_le_growthFunction (S : Finset Γ) (m : ℕ) :
    (1 : ℝ) ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  exact_mod_cast one_le_card_wordBall S m

theorem growthFunction_mono (S : Finset Γ) {a b : ℕ} (h : a ≤ b) :
    (MilnorWolf.growthFunction S a : ℝ) ≤ (MilnorWolf.growthFunction S b : ℝ) := by
  exact_mod_cast card_wordBall_le_of_subset (wordBall_mono (S : Set Γ) h)

/-- **Wolf's Lemma 3.4, first half.**  A lower bound shifted by `r` upgrades to an unshifted one:
for `m ≥ r + 1` the ratio `(m - r)/m` is at least `1/(r+1)`, and below that the ball already has
at least one element. -/
theorem exists_const_of_le_sub (S : Finset Γ) (r q : ℕ) (c : ℝ) (hc : 0 < c)
    (h : ∀ m : ℕ, 1 ≤ m → c * ((m : ℝ) - (r : ℝ)) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) :
    ∃ c' : ℝ, 0 < c' ∧ ∀ m : ℕ, 1 ≤ m →
      c' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  have hr1 : (0 : ℝ) < (r : ℝ) + 1 := by positivity
  refine ⟨min c 1 / ((r : ℝ) + 1) ^ q, by positivity, ?_⟩
  intro m hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  by_cases hcase : r + 1 ≤ m
  · -- the main range
    have hmr : (m : ℝ) / ((r : ℝ) + 1) ≤ (m : ℝ) - (r : ℝ) := by
      rw [div_le_iff₀ hr1]
      have : (r : ℝ) + 1 ≤ (m : ℝ) := by exact_mod_cast hcase
      nlinarith [Nat.cast_nonneg (α := ℝ) r]
    have hpow : ((m : ℝ) / ((r : ℝ) + 1)) ^ q ≤ ((m : ℝ) - (r : ℝ)) ^ q :=
      pow_le_pow_left₀ (by positivity) hmr q
    calc min c 1 / ((r : ℝ) + 1) ^ q * (m : ℝ) ^ q
        = min c 1 * ((m : ℝ) / ((r : ℝ) + 1)) ^ q := by rw [div_pow]; ring
      _ ≤ c * ((m : ℝ) - (r : ℝ)) ^ q := by
          refine mul_le_mul (min_le_left _ _) hpow (by positivity) hc.le
      _ ≤ (MilnorWolf.growthFunction S m : ℝ) := h m hm
  · -- the small range: the ball already has at least one element
    have hmr : (m : ℝ) ≤ (r : ℝ) + 1 := by
      have : m ≤ r + 1 := by omega
      exact_mod_cast this
    have hpow : (m : ℝ) ^ q ≤ ((r : ℝ) + 1) ^ q := pow_le_pow_left₀ hm0 hmr q
    have hle : min c 1 / ((r : ℝ) + 1) ^ q * (m : ℝ) ^ q ≤ 1 := by
      rw [div_mul_eq_mul_div, div_le_one (by positivity)]
      calc min c 1 * (m : ℝ) ^ q ≤ 1 * ((r : ℝ) + 1) ^ q := by
            refine mul_le_mul (min_le_right _ _) hpow (by positivity) zero_le_one
        _ = ((r : ℝ) + 1) ^ q := one_mul _
    exact hle.trans (one_le_growthFunction S m)

/-- **Wolf's Lemma 3.4, second half.**  A lower bound along the multiples of `l` upgrades to all
`m`: drop from `m` to `l ⌊m/l⌋`, which is at least `m / l` once `m ≥ l`. -/
theorem exists_const_of_le_mul (S : Finset Γ) (l q : ℕ) (c : ℝ) (hl : 0 < l) (hc : 0 < c)
    (h : ∀ m : ℕ, 1 ≤ m →
      c * ((l * m : ℕ) : ℝ) ^ q ≤ (MilnorWolf.growthFunction S (l * m) : ℝ)) :
    ∃ c'' : ℝ, 0 < c'' ∧ ∀ m : ℕ, 1 ≤ m →
      c'' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ) := by
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast hl
  refine ⟨min c 1 / (l : ℝ) ^ q, by positivity, ?_⟩
  intro m hm
  have hm0 : (0 : ℝ) ≤ (m : ℝ) := by positivity
  by_cases hcase : l ≤ m
  · -- drop to the largest multiple of `l` below `m`
    set a : ℕ := m / l with ha
    have ha1 : 1 ≤ a := (Nat.one_le_div_iff hl).2 hcase
    have hal : l * a ≤ m := by rw [ha]; exact Nat.mul_div_le m l
    have h1 : m + 1 ≤ a * l + l := by
      have h2 : m / l < a + 1 := by rw [← ha]; exact Nat.lt_succ_self a
      have h3 : m < (a + 1) * l := (Nat.div_lt_iff_lt_mul hl).1 h2
      rw [add_one_mul] at h3
      omega
    have hbig : (m : ℝ) / (l : ℝ) ≤ ((l * a : ℕ) : ℝ) := by
      have hb : (m : ℝ) + 1 ≤ (a : ℝ) * (l : ℝ) + (l : ℝ) := by exact_mod_cast h1
      have hlm : (l : ℝ) ≤ (m : ℝ) := by exact_mod_cast hcase
      have hl1 : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
      rw [div_le_iff₀ hl0]
      push_cast
      nlinarith [mul_nonneg (sub_nonneg.2 hl1) (sub_nonneg.2 hlm),
        mul_le_mul_of_nonneg_left hb hl0.le]
    have hpow : ((m : ℝ) / (l : ℝ)) ^ q ≤ ((l * a : ℕ) : ℝ) ^ q :=
      pow_le_pow_left₀ (by positivity) hbig q
    calc min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q
        = min c 1 * ((m : ℝ) / (l : ℝ)) ^ q := by rw [div_pow]; ring
      _ ≤ c * ((l * a : ℕ) : ℝ) ^ q := by
          refine mul_le_mul (min_le_left _ _) hpow (by positivity) hc.le
      _ ≤ (MilnorWolf.growthFunction S (l * a) : ℝ) := h a ha1
      _ ≤ (MilnorWolf.growthFunction S m : ℝ) := growthFunction_mono S hal
  · -- the small range
    have hml : (m : ℝ) ≤ (l : ℝ) := by
      have : m ≤ l := by omega
      exact_mod_cast this
    have hpow : (m : ℝ) ^ q ≤ (l : ℝ) ^ q := pow_le_pow_left₀ hm0 hml q
    have hle : min c 1 / (l : ℝ) ^ q * (m : ℝ) ^ q ≤ 1 := by
      rw [div_mul_eq_mul_div, div_le_one (by positivity)]
      calc min c 1 * (m : ℝ) ^ q ≤ 1 * (l : ℝ) ^ q := by
            refine mul_le_mul (min_le_right _ _) hpow (by positivity) zero_le_one
        _ = (l : ℝ) ^ q := one_mul _
    exact hle.trans (one_le_growthFunction S m)

/-- **Wolf's Lemma 3.4** (p. 426), both halves. -/
theorem exists_const_pow_le_growthFunction_of_le_sub_and_of_le_mul' (S : Finset Γ) :
    (∀ (r q : ℕ) (c : ℝ), 0 < c →
        (∀ m : ℕ, 1 ≤ m → c * ((m : ℝ) - (r : ℝ)) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) →
        ∃ c' : ℝ, 0 < c' ∧ ∀ m : ℕ, 1 ≤ m →
          c' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) ∧
      (∀ (l q : ℕ) (c : ℝ), 0 < l → 0 < c →
        (∀ m : ℕ, 1 ≤ m →
          c * ((l * m : ℕ) : ℝ) ^ q ≤ (MilnorWolf.growthFunction S (l * m) : ℝ)) →
        ∃ c'' : ℝ, 0 < c'' ∧ ∀ m : ℕ, 1 ≤ m →
          c'' * (m : ℝ) ^ q ≤ (MilnorWolf.growthFunction S m : ℝ)) :=
  ⟨fun r q c hc h => exists_const_of_le_sub S r q c hc h,
   fun l q c hl hc h => exists_const_of_le_mul S l q c hl hc h⟩

/-- **Wolf's Lemma 3.5** (p. 427): two-sided polynomial bounds on the growth function transfer
between finite generating sets.  Each generating set is a bounded-length word in the other, which
rescales the upper bound directly and the lower bound along the multiples of `l`, where Lemma 3.4
takes over. -/
theorem exists_const_polynomial_bounds_of_generating' (S T : Finset Γ)
    (hS : Subgroup.closure (S : Set Γ) = ⊤) (hT : Subgroup.closure (T : Set Γ) = ⊤)
    (b₁ b₂ : ℝ) (hb₁ : 0 < b₁) (hb : b₁ ≤ b₂) (p q : ℕ) (hpq : p ≤ q)
    (hbounds : ∀ m : ℕ, 1 ≤ m →
      b₁ * (m : ℝ) ^ p ≤ (MilnorWolf.growthFunction T m : ℝ) ∧
        (MilnorWolf.growthFunction T m : ℝ) ≤ b₂ * (m : ℝ) ^ q) :
    ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
      c₁ * (m : ℝ) ^ p ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
        (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ q := by
  obtain ⟨k, hk, hkball⟩ := exists_wordBall_subset S T hT
  obtain ⟨l, hl, hlball⟩ := exists_wordBall_subset T S hS
  have hb₂ : 0 < b₂ := lt_of_lt_of_le hb₁ hb
  have hk0 : (0 : ℝ) < (k : ℝ) := by exact_mod_cast hk
  have hl0 : (0 : ℝ) < (l : ℝ) := by exact_mod_cast hl
  -- the upper bound
  set c₂ : ℝ := b₂ * (k : ℝ) ^ q with hc₂
  have hc₂pos : 0 < c₂ := by positivity
  have hupper : ∀ m : ℕ, 1 ≤ m →
      (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ q := by
    intro m hm
    have hsub : (MilnorWolf.growthFunction S m : ℝ) ≤
        (MilnorWolf.growthFunction T (k * m) : ℝ) := by
      exact_mod_cast card_wordBall_le_of_subset (hkball m)
    have hkm : 1 ≤ k * m := Nat.one_le_iff_ne_zero.2 (by positivity)
    refine hsub.trans (((hbounds (k * m) hkm).2).trans (le_of_eq ?_))
    push_cast
    rw [hc₂, mul_pow]
    ring
  -- the lower bound, along the multiples of `l`, then Lemma 3.4
  have hlow : ∀ m : ℕ, 1 ≤ m →
      (b₁ / (l : ℝ) ^ p) * ((l * m : ℕ) : ℝ) ^ p ≤
        (MilnorWolf.growthFunction S (l * m) : ℝ) := by
    intro m hm
    have hsub : (MilnorWolf.growthFunction T m : ℝ) ≤
        (MilnorWolf.growthFunction S (l * m) : ℝ) := by
      exact_mod_cast card_wordBall_le_of_subset (hlball m)
    refine le_trans (le_of_eq ?_) (le_trans (hbounds m hm).1 hsub)
    push_cast
    rw [mul_pow]
    field_simp
  obtain ⟨c'', hc''pos, hc''⟩ :=
    exists_const_of_le_mul S l p (b₁ / (l : ℝ) ^ p) hl (by positivity) hlow
  refine ⟨min c'' c₂, c₂, lt_min hc''pos hc₂pos, min_le_right _ _, fun m hm => ?_⟩
  refine ⟨?_, hupper m hm⟩
  exact le_trans (mul_le_mul_of_nonneg_right (min_le_left _ _) (by positivity)) (hc'' m hm)

end Lib
end Wolf

/-!
# The Delannoy count, combinatorial core

`delannoy n m = ∑_{l=0}^{n} 2^l C(n,l) C(m,l)` is the closed form Wolf's Proposition 3.6 asserts
for the growth function of a free abelian group of rank `n` on a basis.  Proved here: the
hockey-stick identity, and the recurrence in `n`, then that the `ℓ¹`-ball of radius `m` in `ℤⁿ` has exactly
`delannoy n m` elements, and finally that this ball is the word ball on the standard basis, so
that the growth function of `ℤⁿ` on that basis is Wolf's closed form.
-/

namespace Wolf
namespace Lib

open Finset Chou Chou.Lib

/-- Wolf's closed form. -/
def delannoy (n m : ℕ) : ℕ := ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m.choose l

/-- **Hockey stick.**  `∑_{j<m} C(j,l) = C(m,l+1)`. -/
theorem sum_range_choose_eq (l : ℕ) : ∀ m : ℕ, ∑ j ∈ range m, j.choose l = m.choose (l + 1) := by
  intro m
  induction m with
  | zero => simp
  | succ m ih =>
      rw [Finset.sum_range_succ, ih, Nat.choose_succ_succ' m l]
      ring

/-- **The recurrence in `n`.**  `D(n+1, m) = D(n, m) + 2 ∑_{j<m} D(n, j)`, which is the identity
matching the decomposition of an `ℓ¹`-ball in `ℤ^{n+1}` by its last coordinate. -/
theorem delannoy_succ (n m : ℕ) :
    delannoy (n + 1) m = delannoy n m + 2 * ∑ j ∈ range m, delannoy n j := by
  have hswap : ∑ j ∈ range m, delannoy n j
      = ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m.choose (l + 1) := by
    simp only [delannoy]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [← Finset.mul_sum, sum_range_choose_eq l m]
  rw [hswap, delannoy, delannoy]
  -- expand `C(n+1, l)` by Pascal
  rw [Finset.sum_range_succ' (fun l => 2 ^ l * (n + 1).choose l * m.choose l) (n + 1)]
  have hpascal : ∀ l ∈ range (n + 1),
      2 ^ (l + 1) * (n + 1).choose (l + 1) * m.choose (l + 1)
        = 2 ^ (l + 1) * n.choose l * m.choose (l + 1)
          + 2 ^ (l + 1) * n.choose (l + 1) * m.choose (l + 1) := by
    intro l _
    rw [Nat.choose_succ_succ n l]
    ring
  rw [Finset.sum_congr rfl hpascal, Finset.sum_add_distrib]
  have h0 : (2 : ℕ) ^ 0 * (n + 1).choose 0 * m.choose 0 = 2 ^ 0 * n.choose 0 * m.choose 0 := by
    simp
  have h1 : ∑ l ∈ range (n + 1), 2 ^ (l + 1) * n.choose l * m.choose (l + 1)
      = 2 * ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m.choose (l + 1) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun l _ => by ring
  have h2 : ∑ l ∈ range (n + 1), 2 ^ (l + 1) * n.choose (l + 1) * m.choose (l + 1)
      + 2 ^ 0 * n.choose 0 * m.choose 0
      = ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m.choose l := by
    rw [Finset.sum_range_succ' (fun l => 2 ^ l * n.choose l * m.choose l) n]
    simp only [Finset.sum_range_succ]
    rw [Nat.choose_eq_zero_of_lt (by omega : n < n + 1)]
    ring
  rw [h0, h1]
  omega

/-! ### The `ℓ¹`-ball in `ℤⁿ` and its count -/

/-- The `ℓ¹` norm of an integer vector. -/
def l1 {n : ℕ} (x : Fin n → ℤ) : ℕ := ∑ i, (x i).natAbs

/-- The `ℓ¹`-ball of radius `m`, as a `Finset`. -/
noncomputable def ball (n m : ℕ) : Finset (Fin n → ℤ) :=
  (Fintype.piFinset fun _ => Finset.Icc (-(m : ℤ)) (m : ℤ)).filter (fun x => l1 x ≤ m)

theorem l1_le_of_mem {n m : ℕ} {x : Fin n → ℤ} (h : l1 x ≤ m) (i : Fin n) :
    (x i).natAbs ≤ m :=
  le_trans (Finset.single_le_sum (f := fun i => (x i).natAbs)
    (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)) h

theorem mem_ball {n m : ℕ} {x : Fin n → ℤ} : x ∈ ball n m ↔ l1 x ≤ m := by
  classical
  simp only [ball, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_Icc]
  refine ⟨fun h => h.2, fun h => ⟨fun i => ?_, h⟩⟩
  have := l1_le_of_mem h i
  omega

/-- Splitting the norm off the last coordinate. -/
theorem l1_eq_init {n : ℕ} (x : Fin (n + 1) → ℤ) :
    l1 x = l1 (Fin.init x) + (x (Fin.last n)).natAbs := by
  simp [l1, Fin.sum_univ_castSucc, Fin.init]

theorem l1_snoc {n : ℕ} (y : Fin n → ℤ) (j : ℤ) :
    l1 (Fin.snoc y j : Fin (n + 1) → ℤ) = l1 y + j.natAbs := by
  rw [l1_eq_init]
  simp

/-- Counting the ball in `ℤ^{n+1}` by its last coordinate. -/
theorem card_ball_succ (n m : ℕ) :
    (ball (n + 1) m).card
      = ∑ j ∈ Finset.Icc (-(m : ℤ)) (m : ℤ), (ball n (m - j.natAbs)).card := by
  classical
  rw [Finset.card_eq_sum_card_fiberwise
    (f := fun x : Fin (n + 1) → ℤ => x (Fin.last n)) (t := Finset.Icc (-(m : ℤ)) (m : ℤ))
    (fun x hx => by
      rw [Finset.mem_coe, mem_ball] at hx
      have := l1_le_of_mem hx (Fin.last n)
      simp only [Finset.mem_coe, Finset.mem_Icc]
      omega)]
  refine Finset.sum_congr rfl fun j hj => ?_
  simp only [Finset.mem_Icc] at hj
  refine Finset.card_nbij' (fun x => Fin.init x) (fun y => Fin.snoc y j) ?_ ?_ ?_ ?_
  · intro x hx
    simp only [Finset.coe_filter, Set.mem_setOf_eq] at hx
    obtain ⟨hx1, hx2⟩ := hx
    rw [mem_ball] at hx1
    have hsplit := l1_eq_init x
    rw [hx2] at hsplit
    simp only [Finset.mem_coe]
    rw [mem_ball]
    omega
  · intro y hy
    simp only [Finset.mem_coe] at hy
    rw [mem_ball] at hy
    simp only [Finset.coe_filter, Set.mem_setOf_eq]
    refine ⟨mem_ball.2 ?_, by simp⟩
    rw [l1_snoc]
    have : j.natAbs ≤ m := by omega
    omega
  · intro x hx
    simp only [Finset.coe_filter, Set.mem_setOf_eq] at hx
    rw [← hx.2]
    exact Fin.snoc_init_self x
  · intro y _
    simp

/-- A symmetric sum over `Icc (-m) m` of a function of `m - |j|` folds to a `range` sum: reindex
`j ↦ j + m` onto `range (2m+1)`, where the summand becomes `G k` below the midpoint and
`G (2m - k)` above it. -/
theorem sum_Icc_natAbs (G : ℕ → ℕ) (m : ℕ) :
    ∑ j ∈ Finset.Icc (-(m : ℤ)) (m : ℤ), G (m - j.natAbs)
      = G m + 2 * ∑ k ∈ Finset.range m, G k := by
  classical
  have hre : ∑ j ∈ Finset.Icc (-(m : ℤ)) (m : ℤ), G (m - j.natAbs)
      = ∑ k ∈ Finset.range (m + 1 + m), G (m - ((k : ℤ) - (m : ℤ)).natAbs) := by
    refine Finset.sum_nbij' (fun j => (j + (m : ℤ)).toNat) (fun k => (k : ℤ) - (m : ℤ))
      ?_ ?_ ?_ ?_ ?_
    · intro j hj
      simp only [Finset.mem_Icc] at hj
      simp only [Finset.mem_range]
      omega
    · intro k hk
      simp only [Finset.mem_range] at hk
      simp only [Finset.mem_Icc]
      omega
    · intro j hj
      simp only [Finset.mem_Icc] at hj
      omega
    · intro k hk
      simp only [Finset.mem_range] at hk
      omega
    · intro j hj
      simp only [Finset.mem_Icc] at hj
      congr 1
      omega
  rw [hre, Finset.sum_range_add]
  have h1 : ∑ k ∈ Finset.range (m + 1), G (m - ((k : ℤ) - (m : ℤ)).natAbs)
      = ∑ k ∈ Finset.range (m + 1), G k := by
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    congr 1
    omega
  have h2 : ∑ k ∈ Finset.range m, G (m - (((m + 1 + k : ℕ) : ℤ) - (m : ℤ)).natAbs)
      = ∑ k ∈ Finset.range m, G (m - 1 - k) := by
    refine Finset.sum_congr rfl fun k hk => ?_
    simp only [Finset.mem_range] at hk
    congr 1
    omega
  rw [h1, h2, Finset.sum_range_reflect (fun k => G k) m, Finset.sum_range_succ]
  omega

/-- **The `ℓ¹`-ball count.**  Wolf's closed form is the number of integer vectors of `ℓ¹` norm at
most `m`. -/
theorem card_ball (n m : ℕ) : (ball n m).card = delannoy n m := by
  induction n generalizing m with
  | zero =>
      have : ball 0 m = {fun i => (Fin.elim0 i : ℤ)} := by
        ext x
        simp only [mem_ball, Finset.mem_singleton]
        constructor
        · intro _; funext i; exact Fin.elim0 i
        · intro h; subst h; simp [l1]
      rw [this, delannoy]
      simp
  | succ n ih =>
      rw [card_ball_succ]
      simp only [ih]
      rw [sum_Icc_natAbs (fun t => delannoy n t) m, delannoy_succ]

variable {n : ℕ}

/-! ### The word ball on the standard basis -/

theorem l1_add_le (x y : Fin n → ℤ) : l1 (x + y) ≤ l1 x + l1 y := by
  simp only [l1, ← Finset.sum_add_distrib]
  exact Finset.sum_le_sum fun i _ => by simpa using Int.natAbs_add_le (x i) (y i)

theorem l1_neg (x : Fin n → ℤ) : l1 (-x) = l1 x := by
  simp [l1]

theorem l1_zero : l1 (0 : Fin n → ℤ) = 0 := by simp [l1]

theorem l1_eq_zero {x : Fin n → ℤ} (h : l1 x = 0) : x = 0 := by
  funext i
  have h0 : ∀ j ∈ (Finset.univ : Finset (Fin n)), (x j).natAbs = 0 :=
    Finset.sum_eq_zero_iff.1 h
  simpa using Int.natAbs_eq_zero.1 (h0 i (Finset.mem_univ i))

theorem l1_single (i : Fin n) (s : ℤ) : l1 (Pi.single i s) = s.natAbs := by
  classical
  simp [l1, Pi.single_apply, apply_ite Int.natAbs]

/-- The standard generating set, as elements of the multiplicative copy of `ℤⁿ`. -/
noncomputable def stdGen (n : ℕ) : Finset (Multiplicative (Fin n → ℤ)) :=
  (Finset.univ : Finset (Fin n)).image fun i => Multiplicative.ofAdd (Pi.single i (1 : ℤ))

theorem l1_eq_one_of_mem {h' : Multiplicative (Fin n → ℤ)}
    (hh : h' ∈ (stdGen n : Set (Multiplicative (Fin n → ℤ)))) :
    l1 (Multiplicative.toAdd h') = 1 := by
  classical
  rw [Finset.mem_coe, stdGen, Finset.mem_image] at hh
  obtain ⟨i, -, hi⟩ := hh
  have hx : Multiplicative.toAdd h' = Pi.single i (1 : ℤ) := by rw [← hi]; rfl
  rw [hx, l1_single]
  simp

theorem l1_toAdd_of_mem {g : Multiplicative (Fin n → ℤ)}
    (h : g ∈ (stdGen n : Set (Multiplicative (Fin n → ℤ))) ∨
      g⁻¹ ∈ (stdGen n : Set (Multiplicative (Fin n → ℤ)))) :
    l1 (Multiplicative.toAdd g) ≤ 1 := by
  rcases h with h | h
  · exact le_of_eq (l1_eq_one_of_mem h)
  · have h1 := l1_eq_one_of_mem h
    have hneg : Multiplicative.toAdd g = -(Multiplicative.toAdd g⁻¹) := by simp
    rw [hneg, l1_neg, h1]

/-- A word of length at most `m` on the standard generators has `ℓ¹` norm at most `m`. -/
theorem l1_le_of_mem_wordBall {m : ℕ} {g : Multiplicative (Fin n → ℤ)}
    (hg : g ∈ wordBall ((stdGen n : Finset (Multiplicative (Fin n → ℤ))) :
      Set (Multiplicative (Fin n → ℤ))) m) :
    l1 (Multiplicative.toAdd g) ≤ m := by
  obtain ⟨l, hlen, hmem, rfl⟩ := hg
  have key : ∀ l : List (Multiplicative (Fin n → ℤ)),
      (∀ x ∈ l, x ∈ (stdGen n : Set (Multiplicative (Fin n → ℤ))) ∨
        x⁻¹ ∈ (stdGen n : Set (Multiplicative (Fin n → ℤ)))) →
      l1 (Multiplicative.toAdd l.prod) ≤ l.length := by
    intro l
    induction l with
    | nil => intro _; simpa using l1_zero
    | cons a t ih =>
        intro hl
        have h1 := l1_toAdd_of_mem (hl a (by simp))
        have h2 := ih fun x hx => hl x (List.mem_cons_of_mem _ hx)
        have hsum : Multiplicative.toAdd (a :: t).prod
            = Multiplicative.toAdd a + Multiplicative.toAdd t.prod := by
          rw [List.prod_cons]; rfl
        rw [hsum]
        have h3 := l1_add_le (Multiplicative.toAdd a) (Multiplicative.toAdd t.prod)
        simp only [List.length_cons]
        omega
  exact le_trans (key l hmem) hlen

theorem mem_wordBall_one_or {G : Type*} [Group G] {U : Set G} {u : G}
    (hu : u ∈ U ∨ u⁻¹ ∈ U) : u ∈ wordBall U 1 :=
  ⟨[u], by simp, by simpa using hu, by simp⟩

/-- Peeling one unit off a nonzero coordinate drops the `ℓ¹` norm by exactly one. -/
theorem l1_sub_single {x : Fin n → ℤ} {i : Fin n} (hi : x i ≠ 0) :
    l1 (x - Pi.single i (if 0 < x i then 1 else -1)) + 1 = l1 x := by
  classical
  set s : ℤ := if 0 < x i then 1 else -1 with hs
  have hsplit : ∀ z : Fin n → ℤ,
      l1 z = (z i).natAbs + ∑ j ∈ (Finset.univ : Finset (Fin n)).erase i, (z j).natAbs := by
    intro z
    rw [l1, ← Finset.add_sum_erase _ _ (Finset.mem_univ i)]
  have hoff : ∀ j ∈ (Finset.univ : Finset (Fin n)).erase i,
      (((x - Pi.single i s : Fin n → ℤ)) j).natAbs = (x j).natAbs := by
    intro j hj
    have hne : j ≠ i := (Finset.mem_erase.1 hj).1
    simp [Pi.single_eq_of_ne hne]
  have e1 := hsplit (x - Pi.single i s : Fin n → ℤ)
  have e2 := hsplit x
  have e3 : ∑ j ∈ (Finset.univ : Finset (Fin n)).erase i,
      (((x - Pi.single i s : Fin n → ℤ)) j).natAbs
      = ∑ j ∈ (Finset.univ : Finset (Fin n)).erase i, (x j).natAbs :=
    Finset.sum_congr rfl hoff
  have hval : ((x - Pi.single i s : Fin n → ℤ)) i = x i - s := by simp
  rw [hval] at e1
  have key : (x i - s).natAbs + 1 = (x i).natAbs := by
    rw [hs]
    rcases lt_or_gt_of_ne hi with h | h
    · rw [if_neg (by omega)]; omega
    · rw [if_pos h]; omega
  omega

/-- Every vector of `ℓ¹` norm at most `m` is a word of length at most `m` on the standard
generators. -/
theorem mem_wordBall_of_l1_le :
    ∀ (m : ℕ) (x : Fin n → ℤ), l1 x ≤ m →
      (Multiplicative.ofAdd x) ∈
        wordBall ((stdGen n : Finset (Multiplicative (Fin n → ℤ))) :
          Set (Multiplicative (Fin n → ℤ))) m := by
  classical
  intro m
  induction m with
  | zero =>
      intro x hx
      have : x = 0 := l1_eq_zero (Nat.le_zero.1 hx)
      subst this
      simpa using one_mem_wordBall _ 0
  | succ m ih =>
      intro x hx
      by_cases hz : l1 x = 0
      · have : x = 0 := l1_eq_zero hz
        subst this
        simpa using one_mem_wordBall _ (m + 1)
      · obtain ⟨i, -, hi⟩ : ∃ i ∈ (Finset.univ : Finset (Fin n)), (x i).natAbs ≠ 0 := by
          by_contra hcon
          push_neg at hcon
          exact hz (Finset.sum_eq_zero fun j hj => hcon j hj)
        have hi' : x i ≠ 0 := fun h => hi (by simp [h])
        set s : ℤ := if 0 < x i then 1 else -1 with hs
        set y : Fin n → ℤ := x - Pi.single i s with hy
        have hdrop : l1 y + 1 = l1 x := l1_sub_single hi'
        have hyle : l1 y ≤ m := by omega
        have hgen : (Multiplicative.ofAdd (Pi.single i s)) ∈
            wordBall ((stdGen n : Finset (Multiplicative (Fin n → ℤ))) :
              Set (Multiplicative (Fin n → ℤ))) 1 := by
          refine mem_wordBall_one_or ?_
          rcases eq_or_ne s 1 with h1 | h1
          · left
            rw [h1]
            simp only [Finset.mem_coe, stdGen, Finset.mem_image]
            exact ⟨i, Finset.mem_univ i, rfl⟩
          · right
            have hs' : s = -1 := by rw [hs]; split <;> simp_all
            rw [hs']
            simp only [Finset.mem_coe, stdGen, Finset.mem_image]
            refine ⟨i, Finset.mem_univ i, ?_⟩
            have hpi : (Pi.single i (1 : ℤ) : Fin n → ℤ)
                = -(Pi.single i (-1 : ℤ) : Fin n → ℤ) := by
              funext j
              simp only [Pi.single_apply, Pi.neg_apply]
              split_ifs <;> simp
            rw [hpi, ofAdd_neg]
        have hxy : Multiplicative.ofAdd x
            = Multiplicative.ofAdd y * Multiplicative.ofAdd (Pi.single i s) := by
          rw [← ofAdd_add, hy]
          congr 1
          abel
        rw [hxy]
        have := mul_mem_wordBall (ih y hyle) hgen
        simpa [Nat.add_comm] using this

/-- The word ball on the standard generators is exactly the `ℓ¹`-ball. -/
theorem wordBall_stdGen (n m : ℕ) :
    wordBall ((stdGen n : Finset (Multiplicative (Fin n → ℤ))) :
      Set (Multiplicative (Fin n → ℤ))) m
      = Multiplicative.ofAdd '' ((ball n m : Finset (Fin n → ℤ)) : Set (Fin n → ℤ)) := by
  ext g
  constructor
  · intro hg
    refine ⟨Multiplicative.toAdd g, ?_, rfl⟩
    simp only [Finset.mem_coe, mem_ball]
    exact l1_le_of_mem_wordBall hg
  · rintro ⟨x, hx, rfl⟩
    simp only [Finset.mem_coe, mem_ball] at hx
    exact mem_wordBall_of_l1_le m x hx

/-- **Wolf's closed form, on the standard basis.**  The growth function of `ℤⁿ` with respect to
the standard generating set is `∑_{l} 2^l C(n,l) C(m,l)`. -/
theorem growthFunction_stdGen (n m : ℕ) :
    MilnorWolf.growthFunction (stdGen n) m = delannoy n m := by
  classical
  rw [MilnorWolf.growthFunction, wordBall_stdGen]
  have hinj : Function.Injective (Multiplicative.ofAdd : (Fin n → ℤ) → Multiplicative (Fin n → ℤ)) :=
    Multiplicative.ofAdd.injective
  simp only [Nat.card_coe_set_eq]
  rw [Set.ncard_image_of_injective _ hinj, Set.ncard_coe_finset, card_ball]


/-! ### From an arbitrary generating set of `n` elements -/

/-- `n` generators of `ℤⁿ` are a basis, so any generating set of `n` elements is carried to the
standard basis by an automorphism.  This is where `T.card = n` is used: over a commutative ring a
spanning family of `finrank` many vectors is automatically independent. -/
theorem exists_mulEquiv_stdGen (n : ℕ) (T : Finset (Multiplicative (Fin n → ℤ)))
    (hT : Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))) = ⊤) (hcard : T.card = n) :
    ∃ f : Multiplicative (Fin n → ℤ) ≃* Multiplicative (Fin n → ℤ),
      (f : Multiplicative (Fin n → ℤ) → Multiplicative (Fin n → ℤ)) ''
        (stdGen n : Set (Multiplicative (Fin n → ℤ))) = (T : Set (Multiplicative (Fin n → ℤ))) := by
  classical
  -- enumerate `T` by `Fin n`
  set e : Fin n ≃ {x // x ∈ T} := (T.equivFin.trans (finCongr hcard)).symm with he
  set w : Fin n → Multiplicative (Fin n → ℤ) := fun i => (e i : Multiplicative (Fin n → ℤ))
    with hw
  have hrange : Set.range w = (T : Set (Multiplicative (Fin n → ℤ))) := by
    rw [hw, show (fun i => ((e i : Multiplicative (Fin n → ℤ)))) =
      (Subtype.val ∘ e) from rfl, Set.range_comp, e.range_eq_univ, Set.image_univ,
      Subtype.range_coe_subtype]
    rfl
  set v : Fin n → (Fin n → ℤ) := fun i => Multiplicative.toAdd (w i) with hv
  -- the enumeration spans, because it generates as a group
  have hspan : ⊤ ≤ Submodule.span ℤ (Set.range v) := by
    rintro x -
    have hx : Multiplicative.ofAdd x ∈ Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))) := by
      rw [hT]; trivial
    have key : ∀ g ∈ Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))),
        Multiplicative.toAdd g ∈ Submodule.span ℤ (Set.range v) := by
      intro g hg
      induction hg using Subgroup.closure_induction with
      | mem y hy =>
          rw [← hrange] at hy
          obtain ⟨i, rfl⟩ := hy
          exact Submodule.subset_span ⟨i, rfl⟩
      | one => simp
      | mul a b _ _ ha hb => exact Submodule.add_mem _ ha hb
      | inv a _ ha => exact Submodule.neg_mem _ ha
    exact key _ hx
  have hcard' : Fintype.card (Fin n) = Module.finrank ℤ (Fin n → ℤ) := by
    simp
  set B : Module.Basis (Fin n) ℤ (Fin n → ℤ) := basisOfTopLeSpanOfCardEqFinrank v hspan hcard' with hBdef
  have hB : ⇑B = v := coe_basisOfTopLeSpanOfCardEqFinrank v hspan hcard'
  set E : (Fin n → ℤ) ≃ₗ[ℤ] (Fin n → ℤ) :=
    (Pi.basisFun ℤ (Fin n)).equiv B (Equiv.refl (Fin n)) with hE
  have hEapply : ∀ i : Fin n, E (Pi.single i (1 : ℤ)) = v i := by
    intro i
    have h1 : (Pi.basisFun ℤ (Fin n)) i = (Pi.single i (1 : ℤ) : Fin n → ℤ) := by
      simp [Pi.basisFun_apply]
    rw [hE, ← h1, Module.Basis.equiv_apply, hB]
    rfl
  refine ⟨AddEquiv.toMultiplicative E.toAddEquiv, ?_⟩
  have hstd : (stdGen n : Set (Multiplicative (Fin n → ℤ)))
      = Set.range (fun i : Fin n => Multiplicative.ofAdd (Pi.single i (1 : ℤ) : Fin n → ℤ)) := by
    rw [stdGen]
    ext g
    simp [Set.mem_range]
  rw [hstd, ← hrange, ← Set.range_comp]
  refine congrArg Set.range (funext fun i => ?_)
  show Multiplicative.ofAdd (E (Pi.single i (1 : ℤ))) = w i
  rw [hEapply i, hv]
  rfl

/-- **Wolf's closed form, for any generating set of `n` elements.**  Any such set is a basis, and
the automorphism carrying it to the standard basis carries word balls to word balls. -/
theorem growthFunction_eq_delannoy (n : ℕ) (T : Finset (Multiplicative (Fin n → ℤ)))
    (hT : Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))) = ⊤) (hcard : T.card = n)
    (m : ℕ) : MilnorWolf.growthFunction T m = delannoy n m := by
  classical
  obtain ⟨f, hf⟩ := exists_mulEquiv_stdGen n T hT hcard
  have himg : wordBall (T : Set (Multiplicative (Fin n → ℤ))) m
      = (f : Multiplicative (Fin n → ℤ) → Multiplicative (Fin n → ℤ)) ''
        wordBall ((stdGen n : Finset (Multiplicative (Fin n → ℤ))) :
          Set (Multiplicative (Fin n → ℤ))) m := by
    rw [← hf]
    exact Wolf.Lib.wordBall_image f.toMonoidHom _ _
  rw [MilnorWolf.growthFunction, himg]
  rw [← growthFunction_stdGen n m, MilnorWolf.growthFunction]
  exact Nat.card_image_of_injective f.injective _

/-! ### Two-sided polynomial bounds on the Delannoy number

`delannoy n m` is squeezed between `m ^ n / n ^ n` and `3 ^ n m ^ n`.  The upper bound is the
crude estimate `C(m,l) ≤ m ^ l ≤ m ^ n` on each term; the lower bound counts the cube of side
`⌊m/n⌋ + 1` sitting inside the `ℓ¹`-ball, which is where the factor `n ^ n` comes from. -/

/-- Upper bound: `delannoy n m ≤ 3 ^ n m ^ n` for `m ≥ 1`. -/
theorem delannoy_le (n m : ℕ) (hm : 1 ≤ m) : delannoy n m ≤ 3 ^ n * m ^ n := by
  have hsum : ∑ l ∈ range (n + 1), 2 ^ l * n.choose l = 3 ^ n := by
    have h : (3 : ℕ) ^ n = ∑ l ∈ range (n + 1), 2 ^ l * 1 ^ (n - l) * n.choose l := by
      rw [show (3 : ℕ) = 2 + 1 from rfl, add_pow]
      simp
    simpa using h.symm
  have hstep : ∀ l ∈ range (n + 1),
      2 ^ l * n.choose l * m.choose l ≤ 2 ^ l * n.choose l * m ^ n := by
    intro l hl
    have hl' : l ≤ n := Nat.lt_succ_iff.1 (Finset.mem_range.1 hl)
    exact Nat.mul_le_mul_left _ ((Nat.choose_le_pow m l).trans (Nat.pow_le_pow_right hm hl'))
  calc delannoy n m = ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m.choose l := rfl
    _ ≤ ∑ l ∈ range (n + 1), 2 ^ l * n.choose l * m ^ n := Finset.sum_le_sum hstep
    _ = (∑ l ∈ range (n + 1), 2 ^ l * n.choose l) * m ^ n := by rw [Finset.sum_mul]
    _ = 3 ^ n * m ^ n := by rw [hsum]

/-- Lower bound, in the form that avoids division: the cube `{0,…,⌊m/n⌋}ⁿ` sits inside the
`ℓ¹`-ball of radius `m`, and `m ≤ n (⌊m/n⌋ + 1)`. -/
theorem pow_le_delannoy (n m : ℕ) : m ^ n ≤ n ^ n * delannoy n m := by
  classical
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [delannoy]
  have hmaps : ∀ x : Fin n → Fin (m / n + 1),
      (fun i => ((x i : ℕ) : ℤ)) ∈ ball n m := by
    intro x
    rw [mem_ball]
    have hl1 : l1 (fun i => ((x i : ℕ) : ℤ)) = ∑ i, (x i : ℕ) := by simp [l1]
    rw [hl1]
    calc ∑ i, (x i : ℕ) ≤ ∑ _i : Fin n, m / n :=
          Finset.sum_le_sum fun i _ => Nat.lt_succ_iff.1 (x i).isLt
      _ = m / n * n := by simp [mul_comm]
      _ ≤ m := Nat.div_mul_le_self m n
  have hinj : Function.Injective
      (fun x : Fin n → Fin (m / n + 1) => (fun i => ((x i : ℕ) : ℤ))) := by
    intro x y hxy
    funext i
    have h := congrFun hxy i
    simp only at h
    exact Fin.ext (by exact_mod_cast h)
  have hbox : (m / n + 1) ^ n ≤ (ball n m).card := by
    calc (m / n + 1) ^ n = (Finset.univ : Finset (Fin n → Fin (m / n + 1))).card := by simp
      _ ≤ (ball n m).card :=
          Finset.card_le_card_of_injOn _ (fun x _ => hmaps x) (fun x _ y _ h => hinj h)
  have hlt : m < n * (m / n + 1) := by
    have h1 : n * (m / n) + m % n = m := Nat.div_add_mod m n
    have h2 : m % n < n := Nat.mod_lt _ hn
    have h3 : n * (m / n + 1) = n * (m / n) + n := by ring
    omega
  calc m ^ n ≤ (n * (m / n + 1)) ^ n := Nat.pow_le_pow_left hlt.le n
    _ = n ^ n * (m / n + 1) ^ n := by rw [mul_pow]
    _ ≤ n ^ n * (ball n m).card := Nat.mul_le_mul_left _ hbox
    _ = n ^ n * delannoy n m := by rw [card_ball]

/-- **Wolf's Proposition 3.6** (p. 427).  For a free abelian group of rank `n` and a generating
set of exactly `n` elements the growth function is Wolf's closed form, and for *every* finite
generating set the growth function is bounded above and below by constant multiples of `mⁿ`. -/
theorem growthFunction_freeAbelian_eq_and_bounds_of_card' (n : ℕ)
    (T : Finset (Multiplicative (Fin n → ℤ)))
    (hT : Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))) = ⊤)
    (hcard : T.card = n) :
    (∀ m : ℕ, MilnorWolf.growthFunction T m
        = ∑ l ∈ Finset.range (n + 1), 2 ^ l * n.choose l * m.choose l) ∧
      ∀ S : Finset (Multiplicative (Fin n → ℤ)),
        Subgroup.closure (S : Set (Multiplicative (Fin n → ℤ))) = ⊤ →
        ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
          c₁ * (m : ℝ) ^ n ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
            (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ n := by
  have hpart1 : ∀ m : ℕ, MilnorWolf.growthFunction T m = delannoy n m :=
    fun m => growthFunction_eq_delannoy n T hT hcard m
  refine ⟨hpart1, ?_⟩
  intro S hS
  -- `nⁿ ≥ 1`, so `1 / nⁿ` is a legitimate positive constant even at `n = 0`
  have hnnat : 1 ≤ n ^ n := by
    rcases Nat.eq_zero_or_pos n with rfl | h
    · simp
    · exact Nat.one_le_pow _ _ h
  have hnn : (1 : ℝ) ≤ (n : ℝ) ^ n := by exact_mod_cast hnnat
  have hnpos : (0 : ℝ) < (n : ℝ) ^ n := lt_of_lt_of_le zero_lt_one hnn
  have hb₁ : (0 : ℝ) < 1 / (n : ℝ) ^ n := by positivity
  have hb : (1 : ℝ) / (n : ℝ) ^ n ≤ 3 ^ n := by
    have h1 : (1 : ℝ) / (n : ℝ) ^ n ≤ 1 := by
      rw [div_le_one hnpos]; exact hnn
    have h2 : (1 : ℝ) ≤ 3 ^ n := one_le_pow₀ (by norm_num)
    exact h1.trans h2
  have hbounds : ∀ m : ℕ, 1 ≤ m →
      (1 : ℝ) / (n : ℝ) ^ n * (m : ℝ) ^ n ≤ (MilnorWolf.growthFunction T m : ℝ) ∧
        (MilnorWolf.growthFunction T m : ℝ) ≤ (3 : ℝ) ^ n * (m : ℝ) ^ n := by
    intro m hm
    rw [hpart1 m]
    constructor
    · have h := pow_le_delannoy n m
      have h' : (m : ℝ) ^ n ≤ (n : ℝ) ^ n * (delannoy n m : ℝ) := by exact_mod_cast h
      rw [one_div, inv_mul_eq_div, div_le_iff₀ hnpos, mul_comm]
      exact h'
    · have h := delannoy_le n m hm
      have h' : (delannoy n m : ℝ) ≤ (3 : ℝ) ^ n * (m : ℝ) ^ n := by exact_mod_cast h
      exact h'
  exact Wolf.Lib.exists_const_polynomial_bounds_of_generating' S T hS hT _ _ hb₁ hb n n le_rfl
    hbounds

end Lib
end Wolf

open Wolf

theorem solution (n : ℕ)
    (T : Finset (Multiplicative (Fin n → ℤ)))
    (hT : Subgroup.closure (T : Set (Multiplicative (Fin n → ℤ))) = ⊤)
    (hcard : T.card = n) :
    (∀ m : ℕ, MilnorWolf.growthFunction T m = ∑ l ∈ Finset.range (n + 1), 2 ^ l * n.choose l * m.choose l) ∧
      ∀ S : Finset (Multiplicative (Fin n → ℤ)),
        Subgroup.closure (S : Set (Multiplicative (Fin n → ℤ))) = ⊤ →
        ∃ c₁ c₂ : ℝ, 0 < c₁ ∧ c₁ ≤ c₂ ∧ ∀ m : ℕ, 1 ≤ m →
          c₁ * (m : ℝ) ^ n ≤ (MilnorWolf.growthFunction S m : ℝ) ∧
            (MilnorWolf.growthFunction S m : ℝ) ≤ c₂ * (m : ℝ) ^ n :=
  Wolf.Lib.growthFunction_freeAbelian_eq_and_bounds_of_card' n T hT hcard
