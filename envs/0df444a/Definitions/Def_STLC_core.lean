-- title:
--   Simply typed lambda calculus: syntax, set-valued semantics, renaming, substitution, $\beta\eta$
-- statement:
--   The simply typed lambda calculus over countably many base types, with intrinsically typed terms in de Bruijn style, together with its **set-valued semantics**.
--
--   Types are built from base types $b_0, b_1, \dots$ and the arrow constructor: $\sigma, \tau ::= b_n \mid \sigma \to \tau$. Terms are nameless (de Bruijn), so a term is indexed by its typing context $\Gamma$ (a list of types) and its type $\tau$; a variable is a de Bruijn index, and $\Gamma \vdash t : \tau$ is a *type*, not a proposition, so the term carries its derivation.
--
--   An **interpretation** assigns a set $X_n$ to each base type $n$, and is extended to all types by
--
--   $$
--   \llbracket b_n \rrbracket = X_n, \qquad \llbracket \sigma \to \tau \rrbracket = \llbracket \sigma \rrbracket \to \llbracket \tau \rrbracket .
--   $$
--
--   An **environment** $\rho$ for $\Gamma$ assigns an element of $\llbracket \tau \rrbracket$ to every variable of $\Gamma$ of type $\tau$, and evaluation
--
--   $$
--   \llbracket t \rrbracket_\rho \in \llbracket \tau \rrbracket
--   $$
--
--   is defined by recursion on the term: variables are looked up, abstraction is the function $v \mapsto \llbracket t \rrbracket_{(v,\rho)}$ on the extended environment, and application is function application.
--
--   Two further syntactic operations are defined: **renaming** $t \mapsto t[m]$ along a context morphism $m : \Gamma \to \Delta$ (a map sending every variable of $\Gamma$ to a variable of $\Delta$ of the same type), and **substitution** $t \mapsto t[s]$ along a substitution $s : \Gamma \to \Delta$ (a map sending every variable of $\Gamma$ to a *term* of $\Delta$ of the same type), with the derived operations $\mathrm{wk}$ (weakening), $\mathrm{lift}$ (pushing a renaming or substitution under a binder) and $\mathrm{single}(a)$ (the substitution that replaces the head variable by the term $a$).
--
--   Finally, $\beta\eta$**-equivalence** is the least congruence on terms of a fixed type generated by
--
--   $$
--   (\lambda x.\, t)\, a \;\equiv\; t[a/x], \qquad \lambda x.\, t\, x \;\equiv\; t .
--   $$
--
--   These are the definitions on which the soundness and completeness statements of the metatheory are stated.
--
--   **Formalization Note** Everything is stated for a fixed interpretation `X : Nat → Type`, so a "model" is literally a family of Lean types; the ordinary set-theoretic reading is obtained by taking `X` to be a family of sets. Terms are intrinsically typed, so no separate typing relation and no inversion lemmas are needed.
-- source:
--   Pierce, Types and Programming Languages (MIT Press, 2002), ch. 9; Barendregt, The Lambda Calculus: Its Syntax and Semantics (1984), ch. 2; de Bruijn, Lambda calculus notation with nameless dummies (1972)

set_option autoImplicit false

/-!
# Core syntax and semantics of the simply typed lambda calculus

Types over countably many base types, intrinsically typed terms in de Bruijn style,
their set-valued interpretation, renaming and substitution.

Reference: Barendregt, *The Lambda Calculus*, and Pierce, *Types and Programming
Languages*, ch. 9 (simply typed lambda calculus), with de Bruijn's nameless
representation.
-/

namespace STLC

/-- Simple types over countably many base types. -/
inductive Ty : Type where
  | base : Nat → Ty
  | arr : Ty → Ty → Ty
  deriving DecidableEq

infixr:70 " ⇒ " => Ty.arr

/-- De Bruijn variables, intrinsically scoped. -/
inductive Var : List Ty → Ty → Type where
  | z {Γ : List Ty} {σ : Ty} : Var (σ :: Γ) σ
  | s {Γ : List Ty} {σ τ : Ty} : Var Γ τ → Var (σ :: Γ) τ

/-- Intrinsically typed terms: the term carries its typing derivation. -/
inductive Tm : List Ty → Ty → Type where
  | var {Γ : List Ty} {τ : Ty} : Var Γ τ → Tm Γ τ
  | lam {Γ : List Ty} {σ τ : Ty} : Tm (σ :: Γ) τ → Tm Γ (σ ⇒ τ)
  | app {Γ : List Ty} {σ τ : Ty} : Tm Γ (σ ⇒ τ) → Tm Γ σ → Tm Γ τ

/-- Set-valued interpretation of a type, for a given interpretation of the base types. -/
def interp (X : Nat → Type) : Ty → Type
  | .base n => X n
  | σ ⇒ τ => interp X σ → interp X τ

/-- An environment assigns a value to every variable of the context. -/
def Env (X : Nat → Type) (Γ : List Ty) : Type :=
  (τ : Ty) → Var Γ τ → interp X τ

namespace Env

variable {X : Nat → Type}

/-- Lookup in an environment. -/
def get {Γ : List Ty} {τ : Ty} (ρ : Env X Γ) (x : Var Γ τ) : interp X τ := ρ τ x

/-- Extend an environment by a value for the head variable. -/
def cons {Γ : List Ty} {σ : Ty} (v : interp X σ) (ρ : Env X Γ) : Env X (σ :: Γ) :=
  fun _τ x => match x with
    | .z => v
    | .s y => ρ _ y

/-- Forget the head variable of an environment. -/
def tail {Γ : List Ty} {σ : Ty} (ρ : Env X (σ :: Γ)) : Env X Γ :=
  fun _τ y => ρ _ (.s y)

theorem cons_get_z {Γ : List Ty} {σ : Ty} (v : interp X σ) (ρ : Env X Γ) :
    get (cons v ρ) (.z : Var (σ :: Γ) σ) = v := rfl

theorem cons_get_s {Γ : List Ty} {σ : Ty} (v : interp X σ) (ρ : Env X Γ) {τ : Ty}
    (y : Var Γ τ) : get (cons v ρ) (.s y : Var (σ :: Γ) τ) = get ρ y := rfl

theorem tail_cons {Γ : List Ty} {σ : Ty} (v : interp X σ) (ρ : Env X Γ) :
    tail (cons v ρ) = ρ := rfl

end Env

/-- Evaluation of a term in an environment. -/
def Tm.eval {X : Nat → Type} : {Γ : List Ty} → {τ : Ty} → Tm Γ τ → Env X Γ → interp X τ
  | _, _, .var x, ρ => Env.get ρ x
  | _, _, .lam t, ρ => fun v => Tm.eval t (Env.cons v ρ)
  | _, _, .app f a, ρ => Tm.eval f ρ (Tm.eval a ρ)

/-- A context morphism: a variable of the target context for each variable of the source. -/
structure CtxMap (Γ Δ : List Ty) where
  map : {τ : Ty} → Var Γ τ → Var Δ τ

namespace CtxMap

/-- The identity context morphism. -/
def id (Γ : List Ty) : CtxMap Γ Γ := ⟨fun x => x⟩

/-- Weakening by one variable. -/
def wk {Γ : List Ty} (σ : Ty) : CtxMap Γ (σ :: Γ) := ⟨fun x => .s x⟩

/-- Composition of context morphisms. -/
def comp {Γ Δ Ε : List Ty} (m : CtxMap Γ Δ) (n : CtxMap Δ Ε) : CtxMap Γ Ε :=
  ⟨fun x => n.map (m.map x)⟩

/-- Lifting a context morphism under a binder. -/
def lift {Γ Δ : List Ty} {σ : Ty} (m : CtxMap Γ Δ) : CtxMap (σ :: Γ) (σ :: Δ) :=
  ⟨fun {τ} x => match τ, x with
    | _, .z => .z
    | _, .s y => .s (m.map y)⟩

theorem wk_map {Γ : List Ty} {σ τ : Ty} (y : Var Γ τ) :
    (wk (Γ := Γ) σ).map y = (.s y : Var (σ :: Γ) τ) := rfl

theorem lift_z {Γ Δ : List Ty} {σ : Ty} (m : CtxMap Γ Δ) :
    (lift m).map (.z : Var (σ :: Γ) σ) = .z := rfl

theorem lift_s {Γ Δ : List Ty} {σ τ : Ty} (m : CtxMap Γ Δ) (y : Var Γ τ) :
    (lift m).map (.s y : Var (σ :: Γ) τ) = .s (m.map y) := rfl

end CtxMap

/-- Renaming of a term along a context morphism. -/
def Tm.ren {Γ Δ : List Ty} (m : CtxMap Γ Δ) : {τ : Ty} → Tm Γ τ → Tm Δ τ
  | _, .var x => .var (m.map x)
  | _, .lam t => .lam (Tm.ren (CtxMap.lift m) t)
  | _, .app f a => .app (Tm.ren m f) (Tm.ren m a)

/-- A substitution: a term of the target context for each variable of the source. -/
structure Sub (Γ Δ : List Ty) where
  sub : {τ : Ty} → Var Γ τ → Tm Δ τ

namespace Sub

/-- The identity substitution. -/
def id (Γ : List Ty) : Sub Γ Γ := ⟨fun x => .var x⟩

/-- Lifting a substitution under a binder. -/
def lift {Γ Δ : List Ty} {σ : Ty} (s : Sub Γ Δ) : Sub (σ :: Γ) (σ :: Δ) :=
  ⟨fun {τ} x => match τ, x with
    | _, .z => .var .z
    | _, .s y => Tm.ren (CtxMap.wk σ) (s.sub y)⟩

/-- The substitution replacing the head variable by `a` and keeping the rest. -/
def single {Γ : List Ty} {σ : Ty} (a : Tm Γ σ) : Sub (σ :: Γ) Γ :=
  ⟨fun {τ} x => match τ, x with
    | _, .z => a
    | _, .s y => .var y⟩

theorem lift_z {Γ Δ : List Ty} {σ : Ty} (s : Sub Γ Δ) :
    (lift s).sub (.z : Var (σ :: Γ) σ) = .var .z := rfl

theorem lift_s {Γ Δ : List Ty} {σ τ : Ty} (s : Sub Γ Δ) (y : Var Γ τ) :
    (lift s).sub (.s y : Var (σ :: Γ) τ) = Tm.ren (CtxMap.wk σ) (s.sub y) := rfl

theorem single_z {Γ : List Ty} {σ : Ty} (a : Tm Γ σ) :
    (single a).sub (.z : Var (σ :: Γ) σ) = a := rfl

theorem single_s {Γ : List Ty} {σ τ : Ty} (a : Tm Γ σ) (y : Var Γ τ) :
    (single a).sub (.s y : Var (σ :: Γ) τ) = .var y := rfl

end Sub

/-- Substitution of terms for variables. -/
def Tm.subst {Γ Δ : List Ty} (s : Sub Γ Δ) : {τ : Ty} → Tm Γ τ → Tm Δ τ
  | _, .var x => s.sub x
  | _, .lam t => .lam (Tm.subst (Sub.lift s) t)
  | _, .app f a => .app (Tm.subst s f) (Tm.subst s a)

/-- The environment on the source context induced by a substitution and an
environment on the target context. -/
def Env.subst {X : Nat → Type} {Γ Δ : List Ty} (s : Sub Γ Δ) (ρ : Env X Δ) : Env X Γ :=
  fun _τ x => Tm.eval (s.sub x) ρ

/-- beta-eta equivalence: the least congruence generated by beta and eta. -/
inductive BE : {Γ : List Ty} → {τ : Ty} → Tm Γ τ → Tm Γ τ → Prop where
  | refl {Γ : List Ty} {τ : Ty} (t : Tm Γ τ) : BE t t
  | symm {Γ : List Ty} {τ : Ty} {t u : Tm Γ τ} : BE t u → BE u t
  | trans {Γ : List Ty} {τ : Ty} {t u v : Tm Γ τ} : BE t u → BE u v → BE t v
  | lam_congr {Γ : List Ty} {σ τ : Ty} {t u : Tm (σ :: Γ) τ} :
      BE t u → BE (.lam t) (.lam u)
  | app_congr {Γ : List Ty} {σ τ : Ty} {f g : Tm Γ (σ ⇒ τ)} {a b : Tm Γ σ} :
      BE f g → BE a b → BE (.app f a) (.app g b)
  | beta {Γ : List Ty} {σ τ : Ty} (t : Tm (σ :: Γ) τ) (a : Tm Γ σ) :
      BE (.app (.lam t) a) (Tm.subst (Sub.single a) t)
  | eta {Γ : List Ty} {σ τ : Ty} (t : Tm Γ (σ ⇒ τ)) :
      BE (.lam (.app (Tm.ren (CtxMap.wk σ) t) (.var .z))) t

end STLC


