    RM.PrcOK I iprog pc ditPrc := by
  intro s ⟨n, j, E, A, R, LL, LE, LN, LF, hn, hA, hjE, hc, hX, hL, hE, hN, hF⟩
  obtain ⟨e1, e2⟩ := ditF_eq s n j E A R LL LE LN LF hA hX hL hE hN hF
  rw [e1, e2]
  exact hdit_runs (pc 2) hT n hn j s A R LL LE LN LF E hA hjE hc hX hL hE hN hF

end prc

end NLogN.FW

end

