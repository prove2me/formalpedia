section s392
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CutQualityNative
open Structured
lemma cutLogHeight_le_size (m : ℕ) (hm : 2 ≤ m) : cutLogHeight m ≤ m := by
  simp only [cutLogHeight,max_eq_right hm]
  exact Exact.height_le m.lt_two_pow_self
lemma cutRoot_powers_linear (m : ℕ) (hm : 2 ≤ m) :
    cutRoot m ≤ 4096*m ∧ (cutRoot m)^11 ≤ 4096*m := by
  have hroot : 1 ≤ cutRoot m := (by norm_num : 1 ≤ 2).trans (cutRoot_ge_two m)
  have hp12 : (cutRoot m)^12 ≤ 4096*cutLogHeight m := by exact_mod_cast cutRoot_power_upper m
  have ht := cutLogHeight_le_size m hm
  have hpmax : (cutRoot m)^12 ≤ 4096*m := hp12.trans (Nat.mul_le_mul_left 4096 ht)
  exact ⟨(le_self_pow₀ hroot (by norm_num : (12 : ℕ) ≠ 0)).trans hpmax,
    (pow_le_pow_right₀ hroot (by norm_num : (11 : ℕ) ≤ 12)).trans hpmax⟩
lemma code_eval_linear (N m : ℕ) (hm : 2 ≤ m) (s : Data) (hsize : s.natReg 64 = m) (hunit : s.natReg 26 = 1) :
    ∃ t cost, Eval (code N) s cost t ∧ t.realReg 442 = computableCutQuality N m ∧
      cost ≤ (40000*(N+1))*m ∧ t.realMem = s.realMem ∧ t.natMem = s.natMem := by
  obtain ⟨t,cost,he,hout,hcost,hr,hn⟩ := code_eval N m hm s hsize hunit
  have ht := cutLogHeight_le_size m hm
  have hb := cutRoot_powers_linear m hm
  have hprod := Nat.mul_le_mul_left N hb.2
  refine ⟨t,cost,he,hout,?_,hr,hn⟩
  nlinarith only [hcost,ht,hb.1,hprod,hm]
end DecrAlmostLinearSSSP.Decremental.CutQualityNative
