variable {rest : Shape} {m Q : ℕ} {M : Type*} [AddCommGroup M]

variable (Λ : Layout rest (m + m) Q) (φ : M →+ Matrix (Fin m) (Fin m) (ZMod Q))

/-- Hypothesis `hπv` of `network_interchange_shear`. -/
lemma shearπ_valid [NeZero Q] (a : M) (x : List ℕ) (hx : Valid rest x) :
    Valid rest (shearπ Λ φ a x) :=
  valid_amap Λ _ hx

/-- Hypothesis `hπadd` of `network_interchange_shear`. -/
lemma shearπ_add [NeZero Q] (a b : M) (x : List ℕ) (hx : Valid rest x) :
    shearπ Λ φ (a + b) x = shearπ Λ φ a (shearπ Λ φ b x) := by
  simp only [shearπ]
  rw [amap_shear_comp Λ _ _ hx, map_add, neg_add_rev]

/-- Hypothesis `hπ0` of `network_interchange_shear`. -/
lemma shearπ_zero (x : List ℕ) (hx : Valid rest x) : shearπ Λ φ 0 x = x := by
  simp only [shearπ, map_zero, neg_zero]
  exact amap_shear_zero Λ hx

/-- **The row-split shear network (Prop. 11, the shear `H ← H + D`).** Split the rows into `W`
role streams, run the gate network with the physical frame changes `Φ_a` = pull by the shear
`-φ a` on the `rest` digits of every stream, and merge back undoing `ρ`. If every gate is OK, the
scalar circuit routes `w` to `ρ w`, and `Mout (ρ w) - Min w = I0` with `φ I0 = 1`, the result is
the pull of the whole array by the shear by `-1` (on every row, prefix and row digits fixed),
i.e. the array permutation realizing `H ← H + D` (see `pull_shear_moves`). -/
theorem shear_network {R : Type*} [CommRing R] [NeZero Q] (P W L : ℕ) [NeZero W]
    (gates : List (NGate (Fin W) R M)) (hg : ∀ g ∈ gates, g.OK)
    (ρ : Fin W → Fin W) (hρ : ∀ (v : Fin W → R) w, scalarRun gates v (ρ w) = v w)
    (Min Mout : Fin W → M) (I0 : M) (hI : ∀ w, Mout (ρ w) - Min w = I0) (hφ : φ I0 = 1)
    (xs : List R) :
    rowMerge P W L rest 0 (fun w => List.ofFn
      (netRun (streamΦ P L rest (shearπ Λ φ) (shearπ_valid Λ φ)) gates Min Mout
        (fun w' i => (rowSplit P W L rest w' 0 xs).getD (i : ℕ) 0) (ρ w))) =
      pull (P :: W * L :: rest) (P :: W * L :: rest) (amap (Λ.cons2 P (W * L)) (shearMat (-1)))
        0 xs := by
  rw [network_interchange_shear P W L rest (shearπ Λ φ) (shearπ_valid Λ φ) (shearπ_add Λ φ)
    (shearπ_zero Λ φ) gates hg ρ hρ Min Mout I0 hI xs]
  apply pull_congr
  intro a ha
  rw [shearπ, hφ, rowLift_amap Λ _ ha]

end ShearAction

