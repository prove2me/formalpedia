def baseNine {I : Type} (g : (I → Bool) → Bool) (i : Fin 9) := base g (baseIndex i)

theorem baseNine_nested {I : Type} (g : (I → Bool) → Bool) : NestedFamily (baseNine g) := by
  constructor
  intro i j x hij hx
  exact (base_nested g).accepts_of_le (baseIndex_mono hij) hx

theorem baseNine_bounds {I : Type} [Fintype I] (g : (I → Bool) → Bool) (u : ℕ)
    (h0 : ∀ x, g x = false → sensitivityAt g x ≤ u)
    (h1 : ∀ x, g x = true → sensitivityAt g x ≤ rho*u) :
    PairBound (baseNine g) false (fun i j => (prefixProfiles 0).1 i j*u) ∧
    PairBound (baseNine g) true (fun i j => (prefixProfiles 0).2 i j*u) := by
  constructor
  · intro i j hij x hx hx'
    by_cases he : baseIndex i = baseIndex j
    · have hh := base_side g false u h0 (baseIndex j) x hx'
      simpa only [baseNine, he, joint_self, (prefix_base_profiles i j hij).1,
        if_pos he, Bool.false_eq_true, ↓reduceIte] using hh
    · have hlt : baseIndex i < baseIndex j := lt_of_le_of_ne (baseIndex_mono hij) he
      rw [show jointSensitivityAt (baseNine g i) (baseNine g j) x = 0 from
        base_joint_zero g _ _ hlt x false hx hx']
      exact Nat.zero_le _
  · intro i j hij x hx hx'
    by_cases he : baseIndex i = baseIndex j
    · have hh := base_side g true (rho*u) h1 (baseIndex j) x hx'
      simpa only [baseNine, he, joint_self, (prefix_base_profiles i j hij).2,
        if_pos he, ↓reduceIte, Nat.mul_assoc] using hh
    · have hlt : baseIndex i < baseIndex j := lt_of_le_of_ne (baseIndex_mono hij) he
      rw [show jointSensitivityAt (baseNine g i) (baseNine g j) x = 0 from
        base_joint_zero g _ _ hlt x true hx hx']
      exact Nat.zero_le _

def prefixTournament (d : ℕ) : Tournament (prefixK d) := cyclicTournament (prefixD d)

theorem prefix_valid_nat (d : ℕ) : (prefixRecipe d).Valid := by
  rcases d with _ | _ | _ | d
  · exact prefix_recipe_valid 0
  · exact prefix_recipe_valid 1
  · exact prefix_recipe_valid 2
  · exact prefix_recipe_valid 3

theorem prefix_labeling_nonempty_fin (d : Fin 4) :
    Nonempty (Labeling (prefixTournament d.val) 2 (prefixT d.val)) :=
  Sensitivity205.labeling_exists_choose _ (by decide) (prefix_label_conditions d)

theorem prefix_labeling_nonempty (d : ℕ) : Nonempty (Labeling (prefixTournament d) 2 (prefixT d)) := by
  rcases d with _ | _ | _ | d
  · exact prefix_labeling_nonempty_fin 0
  · exact prefix_labeling_nonempty_fin 1
  · exact prefix_labeling_nonempty_fin 2
  · exact prefix_labeling_nonempty_fin 3

def prefixLabeling (d : ℕ) : Labeling (prefixTournament d) 2 (prefixT d) :=
  Classical.choice (prefix_labeling_nonempty d)

def prefixStep {I : Type} (d : ℕ) (F : Fin 9 → (I → Bool) → Bool) :=
  stage (prefixTournament d) (prefixLabeling d).label (prefixRecipe d) F

theorem prefixStep_nested {I : Type} (d : ℕ) {F : Fin 9 → (I → Bool) → Bool}
    (hF : NestedFamily F) : NestedFamily (prefixStep d F) :=
  stage_nested (prefixTournament d) (prefixLabeling d).label (prefixRecipe d) (prefix_valid_nat d) F hF

theorem prefixStep_bounds {I : Type} [Fintype I]
    (F : Fin 9 → (I → Bool) → Bool) (hF : NestedFamily F)
    (d u : ℕ) (hd : d < 4)
    (hz : PairBound F false (fun i j => (prefixProfiles d).1 i j*u))
    (hy : PairBound F true (fun i j => (prefixProfiles d).2 i j*u)) :
    PairBound (prefixStep d F) false (fun i j => (prefixProfiles (d+1)).1 i j*u) ∧
    PairBound (prefixStep d F) true (fun i j => (prefixProfiles (d+1)).2 i j*u) := by
  have hc : Compatible (prefixRecipe d) (fun i j => (prefixProfiles d).1 i j*u)
      (fun i j => (prefixProfiles d).2 i j*u) := by
    intro i j hij hi
    have hh := prefix_compatible ⟨d,hd⟩ i j hij hi
    exact ⟨Nat.mul_le_mul_right u hh.1, Nat.mul_le_mul_right u hh.2⟩
  have hsn := prefixStep_nested d hF
  constructor
  · apply pairBound_containment (prefixStep d F) hsn false
      (Sensitivity2075.rawZero (prefixK d) (prefixT d) (prefixRecipe d)
        (fun i j => (prefixProfiles d).1 i j*u) (fun i j => (prefixProfiles d).2 i j*u)) _
      (Sensitivity2075.stage_zero (prefixTournament d) (prefixLabeling d) (prefix_threshold_ge_four ⟨d,hd⟩)
        (prefixRecipe d) (prefix_valid_nat d) F hF _ _ hz hy hc)
    intro i j hij
    have hh := prefix_certificate_zero ⟨d,hd⟩ i j hij
    refine ⟨(prefixWitnessZ d i j).1, (prefixWitnessZ d i j).2, hh.1, hh.2.1, hh.2.2.1, ?_⟩
    rw [Sensitivity2075.rawZero_mul]
    exact Nat.mul_le_mul_right u hh.2.2.2
  · apply pairBound_containment (prefixStep d F) hsn true
      (Sensitivity2075.rawOne (prefixD d) (prefixRecipe d)
        (fun i j => (prefixProfiles d).1 i j*u) (fun i j => (prefixProfiles d).2 i j*u)) _
      (Sensitivity2075.stage_one (prefixTournament d) (prefixLabeling d).label (prefixD d) (cyclicTournament_outdegree (prefixD d))
        (prefixRecipe d) (prefix_valid_nat d) F hF _ _ hz hy)
    intro i j hij
    have hh := prefix_certificate_one ⟨d,hd⟩ i j hij
    refine ⟨(prefixWitnessY d i j).1, (prefixWitnessY d i j).2, hh.1, hh.2.1, hh.2.2.1, ?_⟩
    rw [Sensitivity2075.rawOne_mul]
    exact Nat.mul_le_mul_right u hh.2.2.2

abbrev PrefixCoord (I : Type) : ℕ → Type
  | 0 => Fin 3 × I
  | d+1 => (Fin (prefixK d) × Fin 2) × PrefixCoord I d

instance prefixFintype (I : Type) [Fintype I] (d : ℕ) : Fintype (PrefixCoord I d) := by
  induction d with
  | zero => exact inferInstanceAs (Fintype (Fin 3 × I))
  | succ d ih => exact inferInstanceAs (Fintype ((Fin (prefixK d) × Fin 2) × PrefixCoord I d))

def prefixFamily {I : Type} (g : (I → Bool) → Bool) :
    (d : ℕ) → Fin 9 → (PrefixCoord I d → Bool) → Bool
  | 0 => baseNine g
  | d+1 => prefixStep d (prefixFamily g d)

theorem prefixFamily_nested {I : Type} (g : (I → Bool) → Bool) (d : ℕ) : NestedFamily (prefixFamily g d) := by
  induction d with
  | zero => exact baseNine_nested g
  | succ d ih => exact prefixStep_nested d ih

theorem prefixFamily_bounds {I : Type} [Fintype I] (g : (I → Bool) → Bool) (u : ℕ)
    (h0 : ∀ x, g x = false → sensitivityAt g x ≤ u)
    (h1 : ∀ x, g x = true → sensitivityAt g x ≤ rho*u)
    (d : ℕ) (hd : d ≤ 4) :
    PairBound (prefixFamily g d) false (fun i j => (prefixProfiles d).1 i j*u) ∧
    PairBound (prefixFamily g d) true (fun i j => (prefixProfiles d).2 i j*u) := by
  induction d with
  | zero => exact baseNine_bounds g u h0 h1
  | succ d ih =>
    have hh := ih (by omega)
    exact prefixStep_bounds (prefixFamily g d) (prefixFamily_nested g d) d u (by omega) hh.1 hh.2

abbrev InitialCoord : Type := PrefixCoord (Fin 1) 4
def initial (i : Fin 15) : (InitialCoord → Bool) → Bool :=
  prefixFamily (fun x : Fin 1 → Bool => x 0) 4 (initialStateMap i)
theorem initial_nested : NestedFamily initial := by
  constructor
  intro i j x hij hx
  exact (prefixFamily_nested (fun x : Fin 1 → Bool => x 0) 4).accepts_of_le
    (initialStateMap_mono hij) hx
theorem initial_bounds : PairBound initial false VZ ∧ PairBound initial true VY := by
  have h0 : ∀ x : Fin 1 → Bool, x 0 = false → sensitivityAt (fun y : Fin 1 → Bool => y 0) x ≤ 1 := by
    intro x hx
    exact (sensitivityAt_le_card _ _).trans (by simp)
  have h1 : ∀ x : Fin 1 → Bool, x 0 = true → sensitivityAt (fun y : Fin 1 → Bool => y 0) x ≤ rho*1 := by
    intro x hx
    exact (sensitivityAt_le_card _ _).trans (by norm_num [rho])
  have hh := prefixFamily_bounds (fun x : Fin 1 → Bool => x 0) 1 h0 h1 4 (by omega)
  constructor
  · intro i j hij x hi hj
    have hz := hh.1 (initialStateMap i) (initialStateMap j) (initialStateMap_mono hij) x hi hj
    simp only [Nat.mul_one] at hz
    exact hz.trans (initial_domination i j hij).1
  · intro i j hij x hi hj
    have hy := hh.2 (initialStateMap i) (initialStateMap j) (initialStateMap_mono hij) x hi hj
    simp only [Nat.mul_one] at hy
    exact hy.trans (initial_domination i j hij).2

def prefixGain : ℕ → ℕ
  | 0 => 1
  | d+1 => prefixK d*prefixGain d
theorem prefixGain_depth : prefixGain 4 = B0 := by decide

def step0 {I : Type} (F : Fin 15 → (I → Bool) → Bool) :
    Fin 15 → (((Fin K0 × Fin 2) × I) → Bool) → Bool :=
  SensitivityNQ.stage periodTournament0 periodLabeling0.label periodRecipe0 F
theorem step0_nested {I : Type} {F : Fin 15 → (I → Bool) → Bool}
    (hF : NestedFamily F) : NestedFamily (step0 F) :=
  SensitivityNQ.stage_nested periodTournament0 periodLabeling0.label periodRecipe0 period_valid0 F hF

def step1 {I : Type} (F : Fin 15 → (I → Bool) → Bool) :
    Fin 15 → (((Fin K1 × Fin 2) × I) → Bool) → Bool :=
  SensitivityNQ.stage periodTournament1 periodLabeling1.label periodRecipe1 F
theorem step1_nested {I : Type} {F : Fin 15 → (I → Bool) → Bool}
    (hF : NestedFamily F) : NestedFamily (step1 F) :=
  SensitivityNQ.stage_nested periodTournament1 periodLabeling1.label periodRecipe1 period_valid1 F hF

def doubleStep {I : Type} (F : Fin 15 → (I → Bool) → Bool) := step1 (step0 F)
theorem double_nested {I : Type} {F : Fin 15 → (I → Bool) → Bool}
    (hF : NestedFamily F) : NestedFamily (doubleStep F) := step1_nested (step0_nested hF)
theorem double_bounds {I : Type} [Fintype I]
    (F : Fin 15 → (I → Bool) → Bool) (hF : NestedFamily F) (u : ℕ)
    (hz : PairBound F false (fun i j => VZ i j*u))
    (hy : PairBound F true (fun i j => VY i j*u)) :
    PairBound (doubleStep F) false (fun i j => VZ i j*(R*u)) ∧
    PairBound (doubleStep F) true (fun i j => VY i j*(R*u)) := by
  have hfirst : PairBound (step0 F) false (fun i j => WZ i j*u) ∧
      PairBound (step0 F) true (fun i j => WY i j*u) := by
    apply profile_step_bounds_q_0 (periodTournament0) (periodLabeling0) (by decide) v0
      (cyclicTournament_outdegree D0) periodRecipe0 period_valid0 period_defect0
      VZ VY WZ WY period_compatible0 _ _ F hF u hz hy
    · intro i j hij
      exact ⟨(periodWitnessZ0 i j).1,(periodWitnessZ0 i j).2,period_certificate_zero_0 i j hij⟩
    · intro i j hij
      exact ⟨(periodWitnessY0 i j).1,(periodWitnessY0 i j).2,period_certificate_one_0 i j hij⟩
  have hsecond : PairBound (step1 (step0 F)) false (fun i j => (VZ i j*R)*u) ∧
      PairBound (step1 (step0 F)) true (fun i j => (VY i j*R)*u) := by
    apply profile_step_bounds_q_1 (periodTournament1) (periodLabeling1) (by decide) v1
      (cyclicTournament_outdegree D1) periodRecipe1 period_valid1 period_defect1
      WZ WY (fun i j => VZ i j*R) (fun i j => VY i j*R) period_compatible1 _ _ (step0 F) (step0_nested hF) u hfirst.1 hfirst.2
    · intro i j hij
      exact ⟨(periodWitnessZ1 i j).1,(periodWitnessZ1 i j).2,period_certificate_zero_1 i j hij⟩
    · intro i j hij
      exact ⟨(periodWitnessY1 i j).1,(periodWitnessY1 i j).2,period_certificate_one_1 i j hij⟩
  simpa only [doubleStep,Nat.mul_assoc] using hsecond

end
