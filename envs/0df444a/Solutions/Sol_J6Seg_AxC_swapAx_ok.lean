theorem count_eq (P : Prm) (n : ℕ) (D k : ℕ) (hk : k ≤ D) :
    2 * (((preT P n D k : ℕ) : ℤ) * ((tF6 P n k : ℤ) * (postT P n D k : ℕ))) =
      ((2 * (List.ofFn (tD6 P n D)).prod : ℕ) : ℤ) := by
  rw [← pre_t_post P n D k hk]; push_cast; ring

/-- The count on any managed state with the descriptor on `dA`. -/
theorem cnt_desc {dA : Fin HS} (hA : DAok dA) (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k B : ℕ)
    (hk : k ≤ D) (hB : DescB P n src D k B) (s : IState HS) (f : Fin HS → List ℤ)
    (hd : f dA = descAx6 P n src D k) (hu : f cU = []) (h1 : f cA1 = []) (h2 : f cA2 = [])
    (h3 : f cA3 = []) (hn : f cN = []) :
    Sp (cntRS dA) (encK s f)
      (encK s (update f cN [((2 * (List.ofFn (tD6 P n D)).prod : ℕ) : ℤ)])) (cCnt B) := by
  rw [← count_eq P n D k hk]
  exact sp_cnt hA s f _ _ _ _ _ _ (by rw [hd]; rfl) hu h1 h2 h3 hn B hB.bk hB.bpre hB.bpost hB.bs
    hB.bt hB.m1 hB.m2 hB.m3 hB.two

