-- title:
--   Example 3.2 — G_ω acts level transitively; its isotropy groups of germs are trivial off 1^∞·G_ω, and Z/2Z or {id, b, c, d} on it
-- statement:
--   Let $\omega \in \{\mathbf 0, \mathbf 1, \mathbf 2\}^{\mathbb N}$, $o = 1^\infty$, and let $L$ be the group of finitary automorphisms (`finitary`). Then:
--
--   1. $G_\omega$ acts transitively on each level: for words $u, v$ of the same length there is $g \in G_\omega$ with $u \cdot g = v$;
--   2. for every ray $x$ not cofinal with $1^\infty$, the isotropy group $(\mathcal G_\omega)_x$ (`isotropy (grigorchuk ω) x`) is trivial;
--   3. if $\omega$ is eventually constant, equal to the letter $i$ from some point on, then the generator $\kappa_\omega$ on which $i$ vanishes ($d_\omega$, $c_\omega$ or $b_\omega$ for $i = \mathbf 0, \mathbf 1, \mathbf 2$) has trivial germ at $o$, the other two generators have the same germ at $o$, and $(\mathcal G_\omega)_x$ has two elements, $(\mathcal G_\omega)_x \cong \mathbb Z/2\mathbb Z$, for every $x$ cofinal with $1^\infty$;
--   4. if $\omega$ is not eventually constant, then for every $x$ cofinal with $1^\infty$: $(\hat{\mathcal G}_\omega)_x = (\mathcal G_\omega)_x$, where $\hat{\mathcal G}_\omega$ is the groupoid of germs of $\langle G_\omega, L \rangle$; the germ at $x$ of every $g \in G_\omega$ fixing $x$ is trivial or a $\gamma$-germ for some $\gamma \in \{b, c, d\}$ (`HasGermAt`); each $\gamma$ occurs; $\gamma$-germs are non-trivial; and two such germs are equal exactly when their letters are; and $(\mathcal G_\omega)_x$ is isomorphic to the Klein four-group $\mathbb Z/2\mathbb Z \times \mathbb Z/2\mathbb Z$; at $o$, $(\mathcal G_\omega)_o$ is the set $\{(id, o), (b_\omega, o), (c_\omega, o), (d_\omega, o)\}$ of the germs at $o$ of $id, b_\omega, c_\omega, d_\omega$; moreover the subgroup $\langle b \rangle$ generated by the germ of $b_\omega$ at $o$ (`germLetterSubgroup ω .b`) is a proper subgroup of $\hat{\mathcal G}_o$.
--
--   Erschler and Zheng, p. 18, Example 3.2: “Let $G_\omega$ be a Grigorchuk group and $o = 1^\infty$. For any $\omega$, $G_\omega$ acts level transitively. Use the finitary automorphisms $L$ as the auxiliary group. From the definition of the group we have that if $x \notin o \cdot G_\omega$, that is $x$ is not cofinal with $1^\infty$, then the isotropy group $(\mathcal G_\omega)_x$ is trivial. For $\omega$ eventually constant, say eventually constant $\mathbf 0$, we have that $(d_\omega, o) = (id, o)$ and $(b_\omega, o) = (c_\omega, o)$ in $(\mathcal G_\omega)_o$. In this case for $x$ cofinal with $1^\infty$, $(\mathcal G_\omega)_x \simeq \mathbb Z/2\mathbb Z$. For $\omega$ not eventually constant then $(\hat{\mathcal G}_\omega)_x = (\mathcal G_\omega)_x = \{id, b, c, d\}$ for $x$ cofinal with $1^\infty$. In this case a group element $g$ has $\gamma$-germ at $x$, where $\gamma \in \{b, c, d\}$, if there is a finite level $n$ such that the section of $g$ at $x_1 \ldots x_n$ is $\gamma_{\mathfrak s^n\omega}$. When $\omega$ is not eventually constant, the subgroup $\langle b \rangle = \{id, b\}$ is a proper subgroup of $\hat{\mathcal G}_o$.”
--
--   The case “say eventually constant $\mathbf 0$” is stated for whichever letter $\omega$ is eventually equal to. The equality “$= \{id, b, c, d\}$” is stated literally at $o$, as the set of the germs there of $id, b_\omega, c_\omega, d_\omega$, and at every $x$ cofinal with $1^\infty$ by the claims for $x$ in conjunct 4: the germs at $x$ are the trivial germ and the $b$-, $c$- and $d$-germs, which are four distinct elements, and they form the Klein four-group $\mathbb Z/2\mathbb Z \times \mathbb Z/2\mathbb Z$, as $\{id, b, c, d\}$ does, not $\mathbb Z/4\mathbb Z$. The $\gamma$-germ is the bundle's (the level $n$ is taken past the last $0$ of $x$, which the sentence leaves implicit; see the bundle note).
-- source:
--   Erschler, A. and Zheng, T., Growth of periodic Grigorchuk groups, Invent. Math. 219 (2020) 1069–1155, https://doi.org/10.1007/s00222-019-00922-0 (arXiv:1802.09077v2, whose page numbers are used), p. 18, Example 3.2

import Mathlib
import Definitions.Def_ErschlerZheng_Grigorchuk
open scoped RightActions

namespace ErschlerZheng

theorem isLevelTransitive_and_isotropy_grigorchuk (ω : ℕ → Fin 3) :
    (∀ u v : List Bool, u.length = v.length → ∃ g ∈ grigorchuk ω, u <• g = v) ∧
    (∀ x : Ray, ¬ IsCofinal x → isotropy (grigorchuk ω) x = ⊥) ∧
    (∀ i : Fin 3, (∀ᶠ k in Filter.atTop, ω k = i) →
      germ oneRay (gen ω (BCD.killedBy i)) = 1 ∧
        (∀ γ γ' : BCD, γ ≠ BCD.killedBy i → γ' ≠ BCD.killedBy i →
          germ oneRay (gen ω γ) = germ oneRay (gen ω γ')) ∧
        ∀ x : Ray, IsCofinal x → Nonempty (isotropy (grigorchuk ω) x ≃* Multiplicative (ZMod 2))) ∧
    ((¬ ∃ i : Fin 3, ∀ᶠ k in Filter.atTop, ω k = i) →
      (∀ x : Ray, IsCofinal x →
        isotropy (grigorchuk ω ⊔ finitary) x = isotropy (grigorchuk ω) x ∧
          (∀ g ∈ grigorchuk ω, x <• g = x → germ x g = 1 ∨ ∃ γ : BCD, HasGermAt ω γ g x) ∧
          (∀ γ : BCD, ∃ g ∈ grigorchuk ω, x <• g = x ∧ HasGermAt ω γ g x) ∧
          (∀ (γ : BCD) (g : Garrido.BinaryTreeAut), g ∈ grigorchuk ω → x <• g = x →
            HasGermAt ω γ g x → germ x g ≠ 1) ∧
          (∀ (γ γ' : BCD) (g g' : Garrido.BinaryTreeAut), g ∈ grigorchuk ω → g' ∈ grigorchuk ω →
            x <• g = x → x <• g' = x → HasGermAt ω γ g x → HasGermAt ω γ' g' x →
              (germ x g = germ x g' ↔ γ = γ')) ∧
          Nonempty (isotropy (grigorchuk ω) x ≃* Multiplicative (ZMod 2 × ZMod 2))) ∧
      (isotropy (grigorchuk ω) oneRay : Set (GermGroup (H := Garrido.BinaryTreeAut) oneRay)) =
        {germ oneRay (1 : Garrido.BinaryTreeAut), germ oneRay (gen ω .b), germ oneRay (gen ω .c),
          germ oneRay (gen ω .d)} ∧
      germLetterSubgroup ω .b < isotropy (grigorchuk ω ⊔ finitary) oneRay) := by
  sorry

end ErschlerZheng
