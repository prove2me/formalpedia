  rw [e]
  have : SmoothOfRelativeDimension (0 + (0 + 1)) (inv (i₁ ∣_ Ω) ≫ (i₁ ⁻¹ᵁ Ω).ι ≫ c₁) := inferInstance
  simpa using this

