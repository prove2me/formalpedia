        φ (AlgebraicCurve.TwoChartIntegralModel.jChartFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j) ∈ ModularCurve.ssJSet q Ω)
    (h : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j))

    (hcoeff : ∀ n : ℤ, ∃ a : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))), a ∈ maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ∧
      (a : ↥k₀) = (((h : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥K) j)) : ↥K) : LaurentSeries ↥k₀).coeff n) :
    h ∈ y'.1 := by
  classical
