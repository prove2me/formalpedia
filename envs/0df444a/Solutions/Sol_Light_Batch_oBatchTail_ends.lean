  rw [Function.update_of_ne (by rintro rfl; exact hb hc)]; exact h c hc

variable {dst j : ℕ} {f : ℕ → ℤ}

/-- Nothing has been written yet. -/
theorem wrote_zero : wrote μ dst f 0 = μ := by
  funext a
  unfold wrote
  rw [if_neg (by omega)]

/-- A cell that has been written. -/
