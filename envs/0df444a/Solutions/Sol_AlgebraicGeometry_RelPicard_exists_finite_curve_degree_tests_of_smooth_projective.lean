/-- A finitely generated span is generated by finitely many members of the original family. -/
lemma finite_subfamily {A E ι : Type*} [Semiring A] [AddCommMonoid E] [Module A E]
    (f : ι → E) (hf : (Submodule.span A (Set.range f)).FG) :
    ∃ s : Finset ι, Submodule.span A (f '' (s : Set ι)) =
      Submodule.span A (Set.range f) := by
  classical
  obtain ⟨a, ha, hspan⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset (Set.range f)).mp hf
  obtain ⟨s, _, hs, heq⟩ := a.finite_toSet.exists_subset_finite_image_eq
    (s := Set.univ) (by simpa using ha)
  refine ⟨hs.toFinset, ?_⟩
  simpa only [hs.coe_toFinset, heq] using hspan.symm

/-- Finitely many coordinates detect zero on a finite-dimensional space of functions. -/
lemma finite_coordinate_detection {F ι : Type*} [Field F]
    (V : Submodule F (ι → F)) [Module.Finite F V] :
    ∃ s : Finset ι, ∀ v : V, (∀ i ∈ s, v.val i = 0) → v = 0 := by
  classical
  let e (i : ι) : Module.Dual F V := (LinearMap.proj i).comp V.subtype
  have hfg : (Submodule.span F (Set.range e)).FG := IsNoetherian.noetherian _
  obtain ⟨s, hs⟩ := finite_subfamily e hfg
  refine ⟨s, ?_⟩
  intro v hv
  have hzero : ∀ g ∈ Submodule.span F (e '' (s : Set ι)), g v = 0 := by
    intro g hg
    induction hg using Submodule.span_induction with
    | mem g hg =>
        obtain ⟨i, hi, rfl⟩ := hg
        exact hv i hi
    | zero => simp
    | add g h hg hh ihg ihh => simp [ihg, ihh]
    | smul a g hg ih => simp [ih]
  apply Subtype.ext
  funext i
  change e i v = 0
  apply hzero
  rw [hs]
  exact Submodule.subset_span (Set.mem_range_self i)

lemma finite_profile_detection {F α ι : Type*} [Field F]
    (p : α → ι → F) (h : Module.Finite F (Submodule.span F (Set.range p))) :
    ∃ s : Finset ι, ∀ a : α, (∀ i ∈ s, p a i = 0) → ∀ i, p a i = 0 := by
  let V := Submodule.span F (Set.range p)
  let : Module.Finite F V := h
  obtain ⟨s, hs⟩ := finite_coordinate_detection V
  refine ⟨s, ?_⟩
  intro a ha i
  let v : V := ⟨p a, Submodule.subset_span (Set.mem_range_self a)⟩
  have hv : v = 0 := hs v ha
  exact congrArg (fun w : V => w.val i) hv

