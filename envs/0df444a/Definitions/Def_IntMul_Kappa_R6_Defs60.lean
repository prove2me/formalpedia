/-!
# Stable radix sort of fixed-width records on a register stack

* `mvK X Y C n`: move `n` integers from `X` to `Y` (reversed); `mvK_spec`, `mvK_cost`.
* `radixPass k`, `radixSort kb`: the pure stable partition pass / LSD radix sort on the first
  component (the key) of each record; `radixSort_keys`: for keys forming a permutation of
  `0, …, N-1` (with `N ≤ 2^kb`) the record with key `q` ends up at position `q`.
* `passP w`, `sortP w`: the register programs (records of width `w ≥ 1` on stack `0`, record
  count on `1`, key bits `kb` on `2`; scratch `46 … 53`); `sortP_spec`, `sortP_cost`.
All per-element code uses `Ex.Lin` expressions only; costs are bounded with the linear lemmas.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

theorem mvK_cost {X Y C : Fin HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (n : Ex HS)
    (s : IState HS) (L : List ℤ) (R : List Item) (hX : s.G X = ints L ++ R)
    (hn : n.eval s = L.length) (B : ℕ) (hL : Bnd B L) (hnl : n.Lin) (hnb : n.Bnd s B) :
    (mvK X Y C n).cost s ≤ (n.size + 1) * 2000 * (B + 2) + L.length * (14000 * (B + 2)) + 32 := by
  have H := mvK_states hXY hXC hYC n s L R hX hn
  have := H.cost_le_lin B (4000 * (B + 2) + 2 * B + 2) hnl hnb ?_
  · rw [hn, Int.toNat_natCast] at this
    have h2 : L.length * (4000 * (B + 2) + 2 * B + 2 + 8000 * (B + 2) + 30) ≤
        L.length * (14000 * (B + 2)) := Nat.mul_le_mul_left _ (by omega)
    exact le_trans this (by omega)
  intro k hk
  rw [hn, Int.toNat_natCast] at hk
  have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
  have e1 : (withCtr C s (n.eval s).toNat k (mvSt_s X Y s L R k)).G X =
      .int L[k] :: (ints (L.drop (k + 1)) ++ R) := by
    simp only [withCtr, mvSt_s, IState.upd_G, if_neg hXY, if_neg hXC, ite_true]
    rw [hd]; rfl
  have hb : zsz L[k] ≤ B := hL _ (List.getElem_mem hk)
  have h1 := pushCost_le_lin (.reg X) (withCtr C s (n.eval s).toNat k (mvSt_s X Y s L R k)) B
    (by simp [Ex.Lin]) (by simpa [Ex.Bnd, IState.top_eq_r6c e1] using hb)
  simp only [RS.cost, run_seq]
  have e2 : ((push Y (.reg X)).run (withCtr C s (n.eval s).toNat k (mvSt_s X Y s L R k))).top X =
      L[k] := IState.top_eq_r6c (L := ints (L.drop (k + 1)) ++ R)
        (by simp only [run_push_G, if_neg hXY, e1])
  rw [e2]
  have : (Ex.reg (S := HS) X).size = 1 := rfl
  rw [this] at h1
  omega

