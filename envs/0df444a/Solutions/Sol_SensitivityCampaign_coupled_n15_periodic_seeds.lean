    (h : k.descFactorial t * r ^ t < t.factorial * r ^ (t.choose 2)) :
    k.choose t * r ^ t < r ^ (t.choose 2) := by
  rw [Nat.descFactorial_eq_factorial_mul_choose, mul_assoc] at h
  exact Nat.lt_of_mul_lt_mul_left h


