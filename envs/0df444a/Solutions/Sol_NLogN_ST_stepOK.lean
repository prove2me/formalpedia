theorem solution (K n₀ : ℕ) (hK : 20 ≤ K) (h0 : NLogN.ST.n0K K ≤ n₀) (hnum : ∀ N, n₀ ≤ N → NLogN.ST.NumOK K N) :
    NLogN.Top.StepOK (NLogN.ST.stepP K) n₀ (NLogN.ST.lin K) (NLogN.ST.calls K) where
  run := by
    intro s a b N LA LB LN hN ha hb hsA hsB hsN
    exact (NLogN.ST.stepP_spec NLogN.ST.M0 (NLogN.ST.stepArgs_of NLogN.ST.M0 K N a b 0 0 hK (h0.trans hN) (hnum N hN) ha hb (NLogN.ST.M0_bnd _)
      (NLogN.ST.M0_bnd _)) s LA LB LN hsA hsB hsN).2.1
  okc := by
    intro M Φ s a b N LA LB LN hN ha hb hsA hsB hsN hc
    have hMf : NLogN.MulBnd M ((mkParams K N).fn + 1) (Φ ((mkParams K N).fn + 1)) :=
      hc (NLogN.ST.cntF K N, (mkParams K N).fn + 1) (by simp [NLogN.ST.calls])
    have hMm : NLogN.MulBnd M (NLogN.ST.mmK K N) (Φ (NLogN.ST.mmK K N)) := hc (NLogN.ST.cntM K N, NLogN.ST.mmK K N) (by simp [NLogN.ST.calls])
    have S := NLogN.ST.stepP_spec M (NLogN.ST.stepArgs_of M K N a b _ _ hK (h0.trans hN) (hnum N hN) ha hb hMf hMm)
      s LA LB LN hsA hsB hsN
    refine ⟨S.1, S.2.2.trans (le_of_eq ?_)⟩
    have h1 : NLogN.ST.stepCost K N (Φ ((mkParams K N).fn + 1)) (Φ (NLogN.ST.mmK K N)) (NLogN.ST.BsK K N) (NLogN.ST.CSK K N (Φ (NLogN.ST.mmK K N)))
        (NLogN.ST.CBK K N (Φ (NLogN.ST.mmK K N))) (NLogN.ST.BxK K N) (NLogN.ST.QK K N) (NLogN.ST.BcK K N) (NLogN.ST.BdK K N) =
        NLogN.ST.GK K N (Φ ((mkParams K N).fn + 1)) (Φ (NLogN.ST.mmK K N)) := rfl
    rw [h1, NLogN.ST.GK_eq, NLogN.ST.calls_sum]
  smaller := by
    intro N hN q hq
    simp only [NLogN.ST.calls, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl
    · exact (hnum N hN).smallF
    · exact (hnum N hN).smallM
  prc := fun I iprog h2 h3 h4 => NLogN.ST.stepP_prcOK K h2 h3 h4
end
