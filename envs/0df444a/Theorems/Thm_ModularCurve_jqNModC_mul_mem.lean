open ModularCurve

theorem ModularCurve.jqNModC_mul_mem (K : Type*) [Field K] (N : ℕ) [NeZero N] {ℓ : ℕ} [Fact ℓ.Prime] [CharP K ℓ] :
    jqNModC K (N * ℓ) ∈ modularFunctionFieldC K N := by sorry
