theorem zl_length (S : Shape) : (zl S).length = S.length := by unfold zl; rw [List.length_map]

theorem mem_le_vol {S : Shape} (hS : ∀ a ∈ S, 1 ≤ a) {a : ℕ} (ha : a ∈ S) : a ≤ vol S := by
  induction S with
  | nil => simp at ha
  | cons b S ih =>
    rw [vol_cons]
    have h1 := one_le_vol S (fun x hx => hS x (by simp [hx]))
    have hb := hS b (by simp)
    rcases List.mem_cons.1 ha with rfl | ha
    · nlinarith
