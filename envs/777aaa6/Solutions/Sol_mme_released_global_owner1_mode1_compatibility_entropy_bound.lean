private def rowMass (s : Fin 45) (w : Word) : ℚ :=
  ((alpha 1 s * ((jointRows 1 s).map
    (fun a => if atom a.1 1 = w then a.2 else 0)).sum : ℕ) : ℚ) / (denominator : ℚ) ^ 5
private def actual (a : Rows) (w : Word) : ℚ :=
  match a with
  | Sum.inl s => if yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 0 ⟨0, shape s⟩ then rowMass s w else 0
  | Sum.inr j => ∑ s : Fin 45,
      if ¬ yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 0 ⟨0, shape s⟩ ∧ (shape s).val 1 = j then rowMass s w else 0

private theorem log_bounds (a : Rows) (w : Word)
    (hp : 0 < x a w / ∑ v, x a v) :
    (lower a w : ℝ) ≤ Real.log ((x a w / ∑ v, x a v : ℚ) : ℝ) ∧
      Real.log ((x a w / ∑ v, x a v : ℚ) : ℝ) ≤ (upper a w : ℝ) := by
