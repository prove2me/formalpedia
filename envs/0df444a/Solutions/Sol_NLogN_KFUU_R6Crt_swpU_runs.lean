-- Source module: Solutions.R6CrtSet
/-!
# CRT reversal §5: one rotation set (`lsU`) and one composite swap (`swpU`) in IL

* `lsU sig neg`: push `Q`, `μ = Q-1` (`neg`) or `1`, and the start values from the global
  registers; run `m` iterations of `rotIt sig` (`rptX` on `rH`); pop.
  **`lsU_runs`**: the data `xs` (shape `SH n Q T`) becomes `pull … (lsetK Q n m sig μ m) xs`.
* `swpU`: the composite Lemma 12 swap of the first and the last `m` digits (`swS` with
  `u' = u·m`, `2^{u'} = Q^m`). **`swpU_runs`**: the data becomes `pull … (bsw n m) xs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

/-! ## The composite swap -/

set_option maxHeartbeats 16000000 in
theorem swpU_runs_sol_aux {eSw : Fin P} {dS : Fin HS} {K : ℝ} (hK : SwOKτ τ I iprog eSw dS K)
    (hdS : dS ≠ 0) {Dsc : Fin HS} (hD : Dsc = 18 ∨ Dsc = 19) (hDd : Dsc ≠ dS)
    (Q u n m : ℕ) (hQd : Q = 2 ^ u) (T : Shape) (hu : 1 ≤ u) (hm : 1 ≤ m)
    (hmn : 2 * m ≤ n) (hT : ∀ a ∈ T, 1 ≤ a) (c2 : ℕ) (hc2 : vol T = c2 * 2) (w Z : ℕ)
    (hZ3 : 3 ≤ Z) (zw : zsz (w : ℤ) ≤ Z) (hVZ : zsz ((vol (SH n Q T) : ℕ) : ℤ) ≤ Z)
    (xs : List ℤ) (hlen : xs.length = vol (SH n Q T)) (hb : Bnd w xs)
    (t : IState HS) (R : List Item) (h0 : t.G 0 = ints xs ++ R)
    {LUm LQm LMd LB LW : List Item}
    (hUm : t.G gUm = .int ((u * m : ℕ) : ℤ) :: LUm)
    (hQm : t.G gQm = .int ((Q ^ m : ℕ) : ℤ) :: LQm)
    (hMd : t.G gMd = .int ((Q ^ (n - 2 * m) : ℕ) : ℤ) :: LMd)
    (hB : t.G rB = .int ((c2 : ℕ) : ℤ) :: LB) (hW : t.G rW = .int (w : ℤ) :: LW) :
    ∃ c : ℕ, IRuns I iprog (swpU eSw dS Dsc) t
      (t.upd 0 (ints (pull (SH n Q T) (SH n Q T) (bsw n m) 0 xs) ++ R)) c ∧
      (c : ℝ) ≤ cSwNτ τ K w (u * m) [1, Q ^ m, Q ^ (n - 2 * m), Q ^ m, c2] + 40 * cU Z := by
  have hQ2 : 2 ≤ Q := by
    have : 2 ^ 1 ≤ 2 ^ u := Nat.pow_le_pow_right (by norm_num) hu
    rw [hQd]; simpa using this
  have hQ1 : 1 ≤ Q := by omega
  set V := vol (SH n Q T) with hV
  have hvT : 1 ≤ vol T := vol_le_of_pos T hT
  have hVe : V = Q ^ n * vol T := vol_SH n Q T
  have hQn : ∀ e ≤ n, Q ^ e ≤ V := fun e he => by
    rw [hVe]; exact le_trans (Nat.pow_le_pow_right hQ1 he) (Nat.le_mul_of_pos_right _ hvT)
  have hle : ∀ x : ℕ, x ≤ V → zsz (x : ℤ) ≤ Z := fun x hx => le_trans (zsz_natCast_le hx) hVZ
  have hQmV : Q ^ m ≤ V := hQn _ (by omega)
  have hMdV : Q ^ (n - 2 * m) ≤ V := hQn _ (by omega)
  have hum : u * m ≤ V := by
    have h1 : u * m < 2 ^ (u * m) := Nat.lt_two_pow_self
    have h2 : 2 ^ (u * m) = Q ^ m := by rw [hQd, pow_mul]
    omega
  have hc2V : c2 ≤ V := by
    rw [hVe]; exact le_trans (by omega) (Nat.le_mul_of_pos_left _ (Nat.one_le_pow _ _ (by omega)))
  have e2 : 2 ^ (u * m) = Q ^ m := by rw [hQd, pow_mul]
  -- pushes
  have R1 := IRuns.dup (I := I) (iprog := iprog) (s := t) (i := gUm) (j := rU) (by decide) hUm
  set S1 := t.upd rU (.int ((u * m : ℕ) : ℤ) :: t.G rU) with hS1
  have R2 := IRuns.const (I := I) (iprog := iprog) (s := S1) rA (1 : ℤ)
  set S2 := S1.upd rA (.int 1 :: S1.G rA) with hS2
  have R3 := IRuns.dup (I := I) (iprog := iprog) (s := S2) (i := gQm) (j := rU2) (by decide)
    (a := ((Q ^ m : ℕ) : ℤ)) (L := LQm) (by simp +decide [S2, S1, hQm])
  set S3 := S2.upd rU2 (.int ((Q ^ m : ℕ) : ℤ) :: S2.G rU2) with hS3
  have R4 := IRuns.dup (I := I) (iprog := iprog) (s := S3) (i := gMd) (j := rM) (by decide)
    (a := ((Q ^ (n - 2 * m) : ℕ) : ℤ)) (L := LMd) (by simp +decide [S3, S2, S1, hMd])
  set S4 := S3.upd rM (.int ((Q ^ (n - 2 * m) : ℕ) : ℤ) :: S3.G rM) with hS4
  -- the swap
  have hlen' : xs.length = vol [1, 2 ^ (u * m), Q ^ (n - 2 * m), 2 ^ (u * m), c2] * 2 := by
    rw [hlen, hVe, e2]; simp only [vol_cons, vol_nil]
    rw [show Q ^ n = Q ^ m * Q ^ (n - 2 * m) * Q ^ m by
      rw [← pow_add, ← pow_add]; congr 1; omega, hc2]; ring
  obtain ⟨c, RS, hc⟩ := swSτ_runs (I := I) (iprog := iprog) hK hdS hD hDd (u := u * m) (w := w)
    (a := 1) (m := Q ^ (n - 2 * m)) (c2 := c2) (Z := Z)
    (Nat.one_le_iff_ne_zero.mpr (by positivity)) le_rfl (Nat.one_le_pow _ _ (by omega))
    (by omega) hZ3 zw (hle _ hum) (by rw [Nat.cast_one, zsz_one]; omega) (hle _ hMdV) (hle _ hc2V)
    (by rw [e2]; exact hle _ hQmV) S4 xs R (by simp +decide [S4, S3, S2, S1, h0]) hlen' hb
    (LW := LW) (LU := t.G rU) (LA := t.G rA) (L2 := t.G rU2) (LM := t.G rM) (LB := LB)
    (by simp +decide [S4, S3, S2, S1, hW]) (by simp +decide [S4, S3, S2, S1])
    (by simp +decide [S4, S3, S2, S1]) (by simp +decide [S4, S3, S2, S1, e2])
    (by simp +decide [S4, S3, S2, S1]) (by simp +decide [S4, S3, S2, S1, hB])
  rw [e2, ← hc2, pull_bsw hmn hQ1 hT] at RS
  set S5 := S4.upd 0 (ints (pull (SH n Q T) (SH n Q T) (bsw n m) 0 xs) ++ R) with hS5
  have D1 := IRuns.drop (I := I) (iprog := iprog) (s := S5) (i := rU)
    (a := ((u * m : ℕ) : ℤ)) (L := t.G rU) (by simp +decide [S5, S4, S3, S2, S1])
  have D2 := IRuns.drop (I := I) (iprog := iprog) (s := S5.upd rU (t.G rU)) (i := rA)
    (a := 1) (L := t.G rA) (by simp +decide [S5, S4, S3, S2, S1])
  have D3 := IRuns.drop (I := I) (iprog := iprog) (s := (S5.upd rU (t.G rU)).upd rA (t.G rA))
    (i := rU2) (a := ((Q ^ m : ℕ) : ℤ)) (L := t.G rU2) (by simp +decide [S5, S4, S3, S2, S1])
  have D4 := IRuns.drop (I := I) (iprog := iprog)
    (s := ((S5.upd rU (t.G rU)).upd rA (t.G rA)).upd rU2 (t.G rU2))
    (i := rM) (a := ((Q ^ (n - 2 * m) : ℕ) : ℤ)) (L := t.G rM) (by simp +decide [S5, S4, S3, S2, S1])
  refine ⟨_, (R1.seq (R2.seq (R3.seq (R4.seq (RS.seq (D1.seq (D2.seq (D3.seq D4)))))))).mono'
    ?_ le_rfl, ?_⟩
  · simp only [S5, S4, S3, S2, S1]
    ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
  · have c1 := dup_le_cU (Z := Z) (hle _ hum)
    have c2' := const_le_cU (Z := Z) (x := 1) (by rw [zsz_one]; omega)
    have c3 := dup_le_cU (Z := Z) (hle _ hQmV)
    have c4 := dup_le_cU (Z := Z) (hle _ hMdV)
    have d1 := drop_le_cU (Z := Z) (hle _ hum)
    have d2 := drop_le_cU (Z := Z) (x := 1) (by rw [zsz_one]; omega)
    have d3 := drop_le_cU (Z := Z) (hle _ hQmV)
    have d4 := drop_le_cU (Z := Z) (hle _ hMdV)
    rw [e2] at hc
    push_cast
    have h1c : (10 ^ 4 : ℝ) ≤ (cU Z : ℝ) := by exact_mod_cast one_le_cU Z
    have e : ((dupCost (zsz ((u * m : ℕ) : ℤ)) + 17 + (zsz (1 : ℤ) + 2) +
      (dupCost (zsz ((Q ^ m : ℕ) : ℤ)) + 17) + (dupCost (zsz ((Q ^ (n - 2 * m) : ℕ) : ℤ)) + 17) +
      (2 * zsz ((u * m : ℕ) : ℤ) + 2) + (2 * zsz (1 : ℤ) + 2) + (2 * zsz ((Q ^ m : ℕ) : ℤ) + 2) +
      (2 * zsz ((Q ^ (n - 2 * m) : ℕ) : ℤ) + 2) : ℕ) : ℝ) ≤ 8 * (cU Z : ℝ) := by
      exact_mod_cast (by omega)
    push_cast at e
    linarith

end Gen

end NLogN.KFUU.R6Crt

