lemma ratFacQ_spec (A : QMat m) : RatFacSpec A (ratFacQ A) := (exists_ratFacQ A).choose_spec

lemma goodAtQ_of_lt (A : QMat m) {q : ℕ} (hq : q.Prime) (hlt : facBoundQ A < q) :
    GoodAtQ q A := by
  obtain ⟨-, hd₁, -, hd₂, -⟩ := ratFacQ_spec A
  have h1 : ∀ i j, ((ratFacQ A).1 i j).den + ((ratFacQ A).2.2 i j).den + (A i j).den ≤
      facBoundQ A := by
    intro i j
    unfold facBoundQ
    refine le_trans ?_ (Nat.le_add_right _ _)
    refine le_trans ?_ (Finset.single_le_sum
      (f := fun i => ∑ j, (((ratFacQ A).1 i j).den + ((ratFacQ A).2.2 i j).den + (A i j).den))
      (fun i _ => Nat.zero_le _) (Finset.mem_univ i))
    exact Finset.single_le_sum
      (f := fun j => ((ratFacQ A).1 i j).den + ((ratFacQ A).2.2 i j).den + (A i j).den)
      (fun j _ => Nat.zero_le _) (Finset.mem_univ j)
  have h2 : ∀ i, ((ratFacQ A).1 i i).num.natAbs + ((ratFacQ A).2.2 i i).num.natAbs ≤
      facBoundQ A := by
    intro i
    unfold facBoundQ
    refine le_trans ?_ (Nat.le_add_left _ _)
    exact Finset.single_le_sum
      (f := fun i => ((ratFacQ A).1 i i).num.natAbs + ((ratFacQ A).2.2 i i).num.natAbs)
      (fun i _ => Nat.zero_le _) (Finset.mem_univ i)
  refine ⟨fun i j => coprime_of_lt hq (Rat.den_pos _) (by have := h1 i j; omega),
    fun i j => coprime_of_lt hq (Rat.den_pos _) (by have := h1 i j; omega),
    fun i j => coprime_of_lt hq (Rat.den_pos _) (by have := h1 i j; omega),
    fun i => coprime_of_lt hq (Int.natAbs_pos.2 (Rat.num_ne_zero.2 (hd₁ i)))
      (by have := h2 i; omega),
    fun i => coprime_of_lt hq (Int.natAbs_pos.2 (Rat.num_ne_zero.2 (hd₂ i)))
      (by have := h2 i; omega)⟩

lemma piQ_spec (A : QMat m) : (ratFacQ A).2.1 = ratM (piQ A) := by
  ext i j
  rcases (ratFacQ_spec A).2.2.2.2.1 i j with h | h <;> simp [ratM, piQ, h]

lemma piQ_01 (A : QMat m) (i j : Fin m) : piQ A i j = 0 ∨ piQ A i j = 1 := by
  unfold piQ; split_ifs <;> simp

lemma card_piQ (A : QMat m) :
    (Finset.univ.filter fun p : Fin m × Fin m => piQ A p.1 p.2 = 1).card = A.rank := by
  rw [← (ratFacQ_spec A).2.2.2.2.2.2.2.1]
  congr 1
  apply Finset.filter_congr
  intro p _
  unfold piQ; split_ifs with h <;> simp [h]

lemma redQ_mul {N : ℕ} {a b : ℚ} (ha : Nat.Coprime a.den N) (hb : Nat.Coprime b.den N) :
    redQ N (a * b) = redQ N a * redQ N b := by
  have hab : Nat.Coprime (a * b).den N := (goodSub N).mul_mem ha hb
  have e : toGood N (a * b) = toGood N a * toGood N b := Subtype.ext (by
    simp only [Subring.coe_mul, toGood_val hab, toGood_val ha, toGood_val hb])
  simp only [redQ, e, map_mul]

/-- **The bridge.** If `X = D • A` over `ℚ`, `q` is a prime coprime to `D` and good for `A`, then
for every `N ∣ q ^ b` the data `facD (q ^ b) D` satisfies `FacAtφ N (phiD N D)` at `X`. -/
theorem facAtφ_facD {q b N D : ℕ} (hq : q.Prime) (hN : N ∣ q ^ b) (hD : Nat.Coprime D q)
    (hD0 : 0 < D) {A : QMat m} (hg : GoodAtQ q A) {X : IMat m} (hX : ratM X = (D : ℚ) • A) :
    FacAtφ N (phiD N D) (facD (q ^ b) D) X := by
  have : NeZero (q ^ b) := ⟨pow_ne_zero _ hq.ne_zero⟩
  have hXA : (D : ℚ)⁻¹ • ratM X = A := by
    rw [hX, smul_smul, inv_mul_cancel₀ (by exact_mod_cast hD0.ne'), one_smul]
  have hfac : facD (q ^ b) D X = facQ (q ^ b) A := by rw [facD, hXA]
  unfold FacAtφ
  rw [hfac]
  obtain ⟨hl₁, -, hl₂, -, -, -, -, -, hA⟩ := ratFacQ_spec A
  obtain ⟨hcA, hc₁, hc₂, hn₁, hn₂⟩ := hg
  have cop : ∀ {d : ℕ}, Nat.Coprime d q → Nat.Coprime d (q ^ b) := fun h => h.pow_right b
  refine ⟨fun i j hij => ?_, fun i j hij => ?_, fun i => ?_, fun i => ?_, piQ_01 A, ?_⟩
  · simp [facQ, hl₁ i j hij, liftZ_zero]
  · simp [facQ, hl₂ i j hij, liftZ_zero]
  · simp only [facQ, Matrix.map_apply]
    rw [cast_liftZ hN]
    exact (isUnit_redQ (cop (hc₁ i i)) (cop (hn₁ i))).map _
  · simp only [facQ, Matrix.map_apply]
    rw [cast_liftZ hN]
    exact (isUnit_redQ (cop (hc₂ i i)) (cop (hn₂ i))).map _
  · have hint : ∀ Y : IMat m, ∀ i j, Nat.Coprime ((ratM Y) i j).den (q ^ b) := fun Y i j => by
      simp [ratM]
    have key := redQ_matrix_identity (N := q ^ b) (fun i j => cop (hcA i j))
      (fun i j => cop (hc₁ i j)) (by rw [piQ_spec]; exact hint _) (fun i j => cop (hc₂ i j)) hA
    have := congrArg (fun Y => Y.map (ZMod.castHom hN (ZMod N))) key
    simp only [Matrix.map_mul] at this
    simp only [facQ]
    rw [castM_liftZ hN, castM_liftZ hN, castM_eq_redQ hN (piQ A), ← piQ_spec, ← this]
    have hDN : Nat.Coprime D N := Nat.Coprime.coprime_dvd_right hN (hD.pow_right b)
    ext i j
    have hXij : ((X i j : ℤ) : ℚ) = (D : ℚ) * A i j := by
      have := congrFun (congrFun hX i) j
      simpa [ratM] using this
    have hDq : redQ (q ^ b) (D : ℚ) = (D : ZMod (q ^ b)) := by
      have := redQ_intCast (q ^ b) (D : ℤ)
      push_cast at this
      exact this
    have h1 : ((X i j : ℤ) : ZMod (q ^ b)) = (D : ZMod (q ^ b)) * redQ (q ^ b) (A i j) := by
      rw [← redQ_intCast, hXij, redQ_mul (by simp) (cop (hcA i j)), hDq]
    have h2 := congrArg (ZMod.castHom hN (ZMod N)) h1
    rw [map_intCast, map_mul, map_natCast] at h2
    simp only [phiD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Matrix.smul_apply, castM,
      Matrix.map_apply, smul_eq_mul, eq_intCast]
    rw [h2, ← mul_assoc, ZMod.inv_mul_of_unit _ ((ZMod.isUnit_iff_coprime D N).2 hDN), one_mul]

end RatFac

