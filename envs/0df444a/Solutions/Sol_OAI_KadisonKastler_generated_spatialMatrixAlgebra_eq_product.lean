-- module Solutions.OAIQ075_KS.KadisonKastler_SpatialMatrixDensity
attribute [-instance] _root_.OAI.KadisonKastler.hilbertULiftInner _root_.OAI.KadisonKastler.instNonemptyMatrixSiteBlockIndex _root_.OAI.KadisonKastler.matrixSiteBlockIndexDecidableEq _root_.OAI.KadisonKastler.matrixSiteBlockIndexFintype _root_.OAI.KadisonKastler.normUltraproductCStarAlgebra _root_.OAI.KadisonKastler.spatialHilbert_nontrivial _root_.OAI.KadisonKastler.spatialHilbert_separable _root_.OAI.KadisonKastler.instMeasurableSpaceListNat_solutions
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option synthInstance.maxHeartbeats 200000
set_option maxHeartbeats 800000

namespace OAI

/-! # Increasing finite spatial matrix images are weakly dense -/

namespace KadisonKastler

open UnitalTomsWinter Generator Filter
open scoped Topology

noncomputable section

universe u

variable {H K : Type u} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]

variable {s : ℕ → ℕ} (M : VonNeumannAlgebra H)
  (E : ∀ n, MatrixUnitSystem (Fin (s n)) (K →L[ℂ] K))

/-- The increasing finite spatial images generate the actual spatial
product with the von Neumann algebra generated by the right stages. -/
theorem generated_spatialMatrixAlgebra_eq_product_oai
    (hK : PublishedKaplanskyDensity.{u})
    (hE : Monotone (fun n => (E n).algebra)) :
    generatedVonNeumannAlgebra (⨆ n, spatialMatrixAlgebra M (E n)) =
      spatialProductAlgebra M (generatedVonNeumannAlgebra (⨆ n, (E n).algebra)) := by
  let A := ⨆ n, spatialMatrixAlgebra M (E n)
  let B := ⨆ n, (E n).algebra
  have hBA : ∀ b ∈ B, spatialRight (H := H) b ∈ A := by
    intro b hb
    change b ∈ (B : Set (K →L[ℂ] K)) at hb
    dsimp only [B] at hb
    rw [StarSubalgebra.coe_iSup_of_directed hE.directed_le] at hb
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hb
    exact (le_iSup (fun n => spatialMatrixAlgebra M (E n)) n)
      (spatialRight_mem_matrixAlgebra M (E n) hn)
  apply le_antisymm
  · apply generatedVonNeumannAlgebra_le_of_le
    apply iSup_le
    intro n
    apply spatialMatrixAlgebra_le_product
    intro i j
    exact subset_generatedVonNeumannAlgebra B
      ((le_iSup (fun n => (E n).algebra) n) ((E n).entry_mem i j))
  · apply generatedVonNeumannAlgebra_le_of_le
    apply sup_le
    · rintro _ ⟨a, ha, rfl⟩
      exact subset_generatedVonNeumannAlgebra A
        ((le_iSup (fun n => spatialMatrixAlgebra M (E n)) 0)
          (spatialLeft_mem_matrixAlgebra M (E 0) ha))
    · rintro _ ⟨b, hb, rfl⟩
      exact spatialRight_mem_generated hK B A hBA b hb

end

end KadisonKastler

end OAI
end

theorem solution.{u} : type_of% @OAI.KadisonKastler.generated_spatialMatrixAlgebra_eq_product_oai.{u} := @OAI.KadisonKastler.generated_spatialMatrixAlgebra_eq_product_oai.{u}
