section R05Seg5
/-! # Locality and linearity of the explicit first-variation operators (ATLAS-IV-03)

* Locality (`*_congr`): on an open set `V`, the operators only depend on the background `(g, ginv, F)`
  and the perturbation `(h, f)` on `V` (every coordinate derivative is local, `pd_congr_of_eqOn`).
* Linearity on the admissible class (open `U`, background and perturbations `C^∞` on `U`, order `∞`):
  `linEinstein`, `linMaxwell`, `linFaraday` of `lcomb c₁ h₁ c₂ h₂`, `lcomb c₁ f₁ c₂ f₂` are the same real
  linear combinations of the values (`*_lcomb`); additivity (`*_add`) and real homogeneity (`*_smul`) are
  the special cases. Perturbations are arbitrary `C^∞` functions of all four coordinates (no symmetry,
  stationarity or analyticity assumption). Stated for the physical dimension `4`. -/

open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.Variation

/-! ## Locality -/

section congr

variable {n : ℕ} {V : Set (Pt n)} {g g' ginv ginv' h h' : Metric n} {F F' f f' : TwoForm n}

end congr

section congr4

variable {V : Set (Pt 4)} {g g' ginv ginv' h h' : Metric 4} {F F' f f' : TwoForm 4}

end congr4

/-! ## Linearity (4D, admissible `C^∞` class) -/

theorem pd_lcomb {n : ℕ} {U : Set (Pt n)} (hU : IsOpen U) {u v : Pt n → ℝ} (hu : ContDiffOn ℝ ∞ u U)
    (hv : ContDiffOn ℝ ∞ v U) (c₁ c₂ : ℝ) {y : Pt n} (hy : y ∈ U) (i : Fin n) :
    pd i (fun z => c₁ * u z + c₂ * v z) y = c₁ * pd i u y + c₂ * pd i v y := by
  rw [pd_add_of hU hy i (contDiffOn_const.mul hu) (contDiffOn_const.mul hv),
    pd_const_mul_of hU hy i c₁ hu, pd_const_mul_of hU hy i c₂ hv]

section lin

variable {U : Set (Pt 4)} {g ginv h₁ h₂ : Metric 4} {F f₁ f₂ : TwoForm 4} (c₁ c₂ : ℝ)

theorem invVar_lcomb (a b : Fin 4) (y : Pt 4) :
    invVar ginv (lcomb c₁ h₁ c₂ h₂) a b y = c₁ * invVar ginv h₁ a b y + c₂ * invVar ginv h₂ a b y := by
  simp only [invVar, lcomb, Fin.sum_univ_four]
  ring

variable (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U) (hgi : ∀ i j, ContDiffOn ℝ ∞ (ginv i j) U)
include hU hg hgi

omit hU hg in
theorem contDiffOn_invVar {h : Metric 4} (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (a b : Fin 4) :
    ContDiffOn ℝ ∞ (invVar ginv h a b) U := by
  unfold invVar
  exact (ContDiffOn.sum fun c _ => ContDiffOn.sum fun d _ => ((hgi a c).mul (hh c d)).mul (hgi d b)).neg

theorem contDiffOn_chrVar {h : Metric 4} (hh : ∀ i j, ContDiffOn ℝ ∞ (h i j) U) (a b c : Fin 4) :
    ContDiffOn ℝ ∞ (chrVar g ginv h a b c) U := by
  unfold chrVar
  apply ContDiffOn.div_const
  refine ContDiffOn.sum fun k _ => ?_
  exact ((contDiffOn_invVar hgi hh a k).mul (((contDiffOn_pd hU (hg k b) c).add
    (contDiffOn_pd hU (hg k c) b)).sub (contDiffOn_pd hU (hg b c) k))).add
    ((hgi a k).mul (((contDiffOn_pd hU (hh k b) c).add (contDiffOn_pd hU (hh k c) b)).sub
      (contDiffOn_pd hU (hh b c) k)))

variable {c₁ c₂} (hh₁ : ∀ i j, ContDiffOn ℝ ∞ (h₁ i j) U) (hh₂ : ∀ i j, ContDiffOn ℝ ∞ (h₂ i j) U)
include hh₁ hh₂

omit hg hgi in
theorem chrVar_lcomb {y : Pt 4} (hy : y ∈ U) (a b c : Fin 4) :
    chrVar g ginv (lcomb c₁ h₁ c₂ h₂) a b c y = c₁ * chrVar g ginv h₁ a b c y + c₂ * chrVar g ginv h₂ a b c y := by
  have e : ∀ k i j, pd k (lcomb c₁ h₁ c₂ h₂ i j) y = c₁ * pd k (h₁ i j) y + c₂ * pd k (h₂ i j) y :=
    fun k i j => pd_lcomb hU (hh₁ i j) (hh₂ i j) c₁ c₂ hy k
  simp only [chrVar, invVar_lcomb, e]
  simp only [Fin.sum_univ_four]
  ring

theorem pd_chrVar_lcomb {x : Pt 4} (hx : x ∈ U) (i a b c : Fin 4) :
    pd i (chrVar g ginv (lcomb c₁ h₁ c₂ h₂) a b c) x =
      c₁ * pd i (chrVar g ginv h₁ a b c) x + c₂ * pd i (chrVar g ginv h₂ a b c) x := by
  rw [pd_congr_of_eqOn hU hx (fun y hy => chrVar_lcomb hU hh₁ hh₂ hy a b c) i]
  exact pd_lcomb hU (contDiffOn_chrVar hU hg hgi hh₁ a b c) (contDiffOn_chrVar hU hg hgi hh₂ a b c) c₁ c₂ hx i

theorem ricciVar_lcomb {x : Pt 4} (hx : x ∈ U) (b d : Fin 4) :
    ricciVar g ginv (lcomb c₁ h₁ c₂ h₂) b d x =
      c₁ * ricciVar g ginv h₁ b d x + c₂ * ricciVar g ginv h₂ b d x := by
  have e1 := fun a b c => chrVar_lcomb hU hh₁ hh₂ (g := g) (ginv := ginv) (c₁ := c₁) (c₂ := c₂) hx a b c
  have e2 := fun i a b c => pd_chrVar_lcomb hU hg hgi hh₁ hh₂ (c₁ := c₁) (c₂ := c₂) hx i a b c
  simp only [ricciVar, ricciLin, e1, e2]
  simp only [Fin.sum_univ_four]
  ring

theorem scalarVar_lcomb {x : Pt 4} (hx : x ∈ U) :
    scalarVar g ginv (lcomb c₁ h₁ c₂ h₂) x = c₁ * scalarVar g ginv h₁ x + c₂ * scalarVar g ginv h₂ x := by
  have e1 := fun b d => ricciVar_lcomb hU hg hgi hh₁ hh₂ (c₁ := c₁) (c₂ := c₂) hx b d
  simp only [scalarVar, invVar_lcomb, e1]
  simp only [Fin.sum_univ_four]
  ring

variable (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U) (hf₁ : ∀ i j, ContDiffOn ℝ ∞ (f₁ i j) U)
  (hf₂ : ∀ i j, ContDiffOn ℝ ∞ (f₂ i j) U)
include hF

end lin

