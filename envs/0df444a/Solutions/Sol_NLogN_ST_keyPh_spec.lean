theorem prod_drop_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : (s.drop i).prod ≤ s.prod := by
  conv_rhs => rw [← List.prod_take_mul_prod_drop s i]
  have : 0 < (s.take i).prod := List.prod_pos (fun x hx => hs x (List.mem_of_mem_take hx))
  exact Nat.le_mul_of_pos_left _ this

theorem sw_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : s.getD i 1 * wgt s i ≤ s.prod := by
  rcases lt_or_ge i s.length with hi | hi
  · have : s.getD i 1 * wgt s i = (s.drop i).prod := by
      rw [wgt, List.getD_eq_getElem _ _ hi, List.drop_eq_getElem_cons hi, List.prod_cons]
    rw [this]; exact prod_drop_le s hs i
  · rw [List.getD_eq_default _ _ hi, wgt, List.drop_eq_nil_of_le (by omega)]
    simp; exact List.prod_pos hs

theorem getD_le_prod (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : s.getD i 1 ≤ s.prod := by
  have := sw_le s hs i
  have h2 : 0 < wgt s i := List.prod_pos (fun x hx => hs x (List.mem_of_mem_drop hx))
  exact le_trans (Nat.le_mul_of_pos_right _ h2) this

theorem wgt_le (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (i : ℕ) : wgt s i ≤ s.prod := by
  have := sw_le s hs i
  have h2 := getD_pos hs i
  exact le_trans (Nat.le_mul_of_pos_left _ h2) this

theorem recI_bnd (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k i : ℕ) :
    ∀ x ∈ recI s k i, 0 ≤ x ∧ x ≤ s.prod := by
  intro x hx
  simp only [recI, List.mem_cons, List.not_mem_nil, or_false] at hx
  have h1 := Nat.mod_lt k (getD_pos hs i)
  have h2 := getD_le_prod s hs i
  have h3 := wgt_le s hs i
  have h4 := sw_le s hs i
  rcases hx with rfl | rfl | rfl | rfl
  · exact ⟨by positivity, by exact_mod_cast (by omega : k % s.getD i 1 ≤ s.prod)⟩
  · exact ⟨by positivity, by exact_mod_cast h2⟩
  · exact ⟨by positivity, by exact_mod_cast h3⟩
  · exact ⟨by positivity, by exact_mod_cast h4⟩

theorem zsz_le_of_bnd {x : ℤ} {M B : ℕ} (h0 : 0 ≤ x) (h1 : x ≤ M) (hB : M < 2 ^ B) : zsz x ≤ B :=
  zsz_le_of_abs (by rw [abs_of_nonneg h0]; exact lt_of_le_of_lt h1 (by exact_mod_cast hB))

theorem natCast_lt_pow {x B : ℕ} (h : x < 2 ^ B) : zsz (x : ℤ) ≤ B :=
  zsz_le_of_bnd (by positivity) le_rfl h

theorem recL_flat_bnd (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (k : ℕ) :
    ∀ x ∈ (recL s k).flatten, 0 ≤ x ∧ x ≤ s.prod := by
  intro x hx
  simp only [recL, List.mem_flatten, List.mem_map, List.mem_range] at hx
  obtain ⟨l, ⟨i, _, rfl⟩, hx⟩ := hx
  exact recI_bnd s hs k i x hx

/-- **Cost of key generation**: `O(S · K · B)` for `S = ∏ sᵢ`, `K` axes, `B`-bit counters. -/
theorem keyGen_cost (s0 : IState HS) (s : List ℕ) (hs : ∀ x ∈ s, 0 < x) (Rst LS LK L4 : List Item)
