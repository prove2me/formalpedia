variable {F E : Type} [NontriviallyNormedField F] [NontriviallyNormedField E] [NormedAlgebra F E] [StarRing E]

theorem GlobalTheory.JR.WeilProd.psiK_split [Unram F E] (A A₁ A₂ : Et F E) (eK : A.K ≃ₐ[F] A₁.K × A₂.K) (eL : A.L ≃ₐ[F] A₁.L × A₂.L)
    (hS : IsSplitting A A₁ A₂ eK eL) (ψ : AddChar F ℂ) (z x : A.K) (y : A.L) :
    A.psiK ψ (z * x * A.NL y) = A₁.psiK ψ ((eK z).1 * (eK x).1 * A₁.NL (eL y).1) *
      A₂.psiK ψ ((eK z).2 * (eK x).2 * A₂.NL (eL y).2) := by sorry
