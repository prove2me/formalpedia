theorem cDig_le (b e M S : ℕ) : cDig b e M S ≤ 10 ^ 5 * ((M + 1) * (b + e + 1) + S + 1) := by
  have h1 := cRpt_le M
  have h2 := cRpt_le (2 * (S - M))
  have h3 : S - M ≤ S := Nat.sub_le _ _
  simp only [cDig, splitCost, shlCost, moveCost, takeCost, zipCost]
