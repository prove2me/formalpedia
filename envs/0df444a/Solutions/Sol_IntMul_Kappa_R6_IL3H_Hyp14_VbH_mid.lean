  have hs2 : 2 ^ (zsz (p : ℤ) + 1) = 2 * 2 ^ zsz (p : ℤ) := by rw [pow_succ']
  have hX : Zl c P K D S r w + 3 ≤ 2 ^ (zsz (p : ℤ) + c.Wr + 4) := by omega
