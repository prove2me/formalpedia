  rw [GL.exactConvL_eq, List.length_map, GL.fwdL_eq]
  have hAl : (GL.fwdAxB (mkParams K N)).length = K := by simp [GL.fwdAxB]; rfl
  rw [tensorGo_len _ _ _ (by
      intro h; have := congrArg List.length h; rw [hAl] at this; simp at this; omega)
    (by rw [hAl, EX.tdims_length]; rfl)
    (by intro n hn; simp only [Params.tdims, List.mem_map] at hn; obtain ⟨i, -, rfl⟩ := hn; positivity)
    (by
      intro a ha
      simp only [GL.fwdAxB, List.mem_map] at ha
      obtain ⟨i, -, rfl⟩ := ha
      exact ⟨CR.getD_pos hsp.2.2.1 i, fun X => BD.bapL_length _ _ _ _ X⟩)]
  have hdl : (mkParams K N).tdims.length ≤ K := by rw [EX.tdims_length]; rfl
  rw [hAl, List.drop_eq_nil_of_le hdl, List.prod_nil, one_mul]
  simp only [GL.fwdAxB, List.map_map]
  rw [Params.S]
  conv_rhs => rw [s_eq_map K N hK1 hN]
  rfl

