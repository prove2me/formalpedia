    intro x hx E
    have hz : (((AlgebraicCurve.TwoChartIntegralModel A (↥K) j).presheaf.germ ⊤ ((pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base x) trivial).hom ((AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom ϖ))) ∈ IsLocalRing.maximalIdeal ((AlgebraicCurve.TwoChartIntegralModel A (↥K) j).presheaf.stalk ((pullback.fst (AlgebraicCurve.TwoChartIntegralModel.toBase A (↥K) j) (Spec.map (CommRingCat.ofHom (algebraMap A k)))).base x)) := by
      have key' : ∀ z : ↥(AlgebraicCurve.TwoChartIntegralModel A (↥K) j), z = ι.base ((Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := ↥S) (B := k)))).base q) →
