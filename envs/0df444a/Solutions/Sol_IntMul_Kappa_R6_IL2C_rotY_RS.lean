/-!
# KFL §1: index arithmetic of chunked arrays

The Lemma 13 rectangle (records of `B` items) is the flat array of shape
`sh8 = [N0, Q, N1, Q, N2, Q, N3, B]` with three chunk fields of size `Q = 2^L`
(slots `0, 1, 2` at list positions `1, 3, 5`).  Chunk `t` has item stride `S_t`
(`S2 = N3 B`, `S1 = Q S2 N2`, `S0 = Q S1 N1`, `V = Q S0 N0`).

* `gc Q S n = n / S % Q` (the chunk value) and `sc Q S v n` (the index with that chunk set to `v`),
  with the integer formula `sc_int` and the independence lemmas `gc_sc_self/hi/lo`.
* `rix V φ d xs` reindexes an array (`out[j] = xs[φ j]`); `rix_rix` composes.
* A triple map `F : Tr → Tr` (on the three chunk values) induces the index map `phi g F`;
  `phi_phi : phi F ∘ phi G = phi (F ∘ G)`, so `rixT G (rixT F xs) = rixT (F ∘ G) xs`.
* The array operations used by Lemma 13 as triple maps: the Lemma 12 swaps
  (`pull sh8 sh8 (swapPos 1 3 | 3 5 | 1 5)`, `pull_swap*`), the block rotation of `rotF` on the
  view `[P, Q, S2]` (`pull_rot`), and the rotation of one bit field (`[P', 2, D S1]`, `pull_bit`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open AModel

/-! ## Chunk get / set -/

theorem sc_lt {Q S m v n : ℕ} (hS : 0 < S) (hv : v < Q) (hn : n < Q * S * m) :
    sc Q S v n < Q * S * m := by
  have hQS : 0 < Q * S := Nat.mul_pos (by omega) hS
  have h1 : n / (Q * S) < m := by
    rw [Nat.div_lt_iff_lt_mul hQS]; linarith
  have hr : v * S + n % S < Q * S := by
    have := Nat.mod_lt n hS
    have : v * S + S ≤ Q * S := by nlinarith
    omega
  unfold sc
  have : n / (Q * S) * (Q * S) + (Q * S) ≤ Q * S * m := by nlinarith
  omega

/-! ## Reindexing -/

@[simp] theorem length_rix {α : Type*} (V : ℕ) (φ : ℕ → ℕ) (d : α) (xs : List α) :
    (rix V φ d xs).length = V := by simp [rix]

theorem getD_rix {α : Type*} {V : ℕ} (φ : ℕ → ℕ) (d : α) (xs : List α) {j : ℕ} (hj : j < V) :
    (rix V φ d xs).getD j d = xs.getD (φ j) d := by
  simp [rix, List.getD_eq_getElem?_getD, hj]

theorem rix_congr {α : Type*} {V : ℕ} {φ φ' : ℕ → ℕ} (h : ∀ j < V, φ j = φ' j) (d : α)
    (xs : List α) : rix V φ d xs = rix V φ' d xs := by
  apply List.ext_getElem (by simp)
  intro j h1 h2
  simp only [length_rix] at h1
  simp [rix, h j h1]

/-! ## Geometry and triple maps -/

namespace Geo

variable (g : Geo)

variable {g}

end Geo

/-! ## Lemma 12 swaps as triple maps -/

/-! ## Block rotations (`rotF` views) -/

/-- The rotation pull of `rotF` on `[P, Q, S]` as an index map. -/
theorem pull_rotAddr (P Q S : ℕ) (hQ : 0 < Q) (hS : 0 < S) (as : ℕ → ℕ) (xs : List ℤ) :
    pull [P, Q, S] [P, Q, S] (KIL.rotAddr Q as) 0 xs =
      rix (P * Q * S) (fun j => sc Q S ((gc Q S j + Q - as (j / (Q * S))) % Q) j) 0 xs := by
  apply List.ext_getElem (by simp [vol]; ring)
  intro j h1 h2
  simp only [length_pull, vol, List.prod_cons, List.prod_nil, mul_one] at h1
  rw [getElem_pull]
  simp only [rix, List.getElem_map, List.getElem_range]
  congr 1
  have hQS : 0 < Q * S := Nat.mul_pos hQ hS
  have hjp : j / (Q * S) < P := by
    rw [Nat.div_lt_iff_lt_mul hQS]; linarith
  simp only [decode, encode, KIL.rotAddr, vol, List.prod_cons, List.prod_nil, mul_one,
    List.getD_cons_zero, List.getD_cons_succ, List.headD_cons, List.tail_cons, Nat.div_one,
    List.getD_cons_zero]
  rw [Nat.mod_eq_of_lt hjp]
  unfold sc gc
  have e1 : j % (Q * S) / S % Q = j / S % Q := by
    rw [mul_comm Q S, Nat.mod_mul_right_div_self, Nat.mod_mod]
  have e2 : j % (Q * S) % S = j % S := by
    rw [Nat.mod_mul_left_mod]
  rw [Nat.mod_eq_of_lt (Nat.mod_lt _ hS)] at *
  simp only [e1, e2, Nat.mod_mod]
  ring_nf

