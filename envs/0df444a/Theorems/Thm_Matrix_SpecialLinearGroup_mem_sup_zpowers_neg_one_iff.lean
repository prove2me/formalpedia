open scoped MatrixGroups

theorem Matrix.SpecialLinearGroup.mem_sup_zpowers_neg_one_iff
    (Γ : Subgroup SL(2, ℤ)) (g : SL(2, ℤ)) :
    g ∈ Γ ⊔ Subgroup.zpowers (-1 : SL(2, ℤ)) ↔ g ∈ Γ ∨ -g ∈ Γ := by sorry
