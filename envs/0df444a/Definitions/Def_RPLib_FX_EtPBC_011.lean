-- ===== S4.Def_RP_EtPBC_A_CovPr11 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3k): the residue map of an approximated presentation

Setting: a square system `gC` over `Cc`, pushed to `S` (the completed side, `fh`) and to `S'` (the approximated
side, `f'`); `θh : Pres (gmap fh gC) → Q` a ring map (in the application surjective, kernel `p · Pres`).
* `pres_eval_self`: a ring map out of `Pres g` evaluates polynomials through its values on constants and variables.
* **`resid fh f' gC θh κ' hκ : Pres (gmap f' gC) →+* Q`**: coefficients by `κ'`, variables to `θh (Z j)`; it exists
  as soon as `κ' ∘ f' = θh ∘ algebraMap ∘ fh` (`resid_hz`). `resid_algebraMap`, `resid_X`, `resid_comp_presMap`.
* **`resid_surj`**: surjective if `θh` is and `κ'` reaches the constants of `θh`.
* **`resid_ker`** (headline): `ker (resid ..) = J · Pres (gmap f' gC)` from a map `q` out of `Pres (gmap f' gC)` with
  kernel in `J · Pres`, a coefficient map `lam : S → T` killing `I` (`ker θh = I · Pres (gmap fh gC)`) and sections.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Gen

end Gen

variable {Cc S S' : Type u} [CommRing Cc] [CommRing S] [CommRing S'] {r : ℕ} {Q : Type u} [CommRing Q]

theorem resid_hz (fh : Cc →+* S) (f' : Cc →+* S') (gC : Fin r → MvPolynomial (Fin r) Cc)
    (θh : Pres (gmap fh gC) →+* Q) (κ' : S' →+* Q)
    (hκ : κ'.comp f' = (θh.comp (algebraMap S (Pres (gmap fh gC)))).comp fh) (j : Fin r) :
    MvPolynomial.eval₂ κ' (fun i => θh (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gmap f' gC j) = 0 := by
  have h0 : Ideal.Quotient.mk (Ideal.span (Set.range (gmap fh gC))) (gmap fh gC j) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
  calc MvPolynomial.eval₂ κ' (fun i => θh (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gmap f' gC j)
      = MvPolynomial.eval₂ (κ'.comp f') (fun i => θh (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gC j) :=
        eval₂_gmap f' gC κ' _ j
    _ = MvPolynomial.eval₂ ((θh.comp (algebraMap S (Pres (gmap fh gC)))).comp fh)
          (fun i => θh (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gC j) := by rw [hκ]
    _ = MvPolynomial.eval₂ (θh.comp (algebraMap S (Pres (gmap fh gC))))
          (fun i => θh (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gmap fh gC j) :=
        (eval₂_gmap fh gC _ _ j).symm
    _ = θh (Ideal.Quotient.mk _ (gmap fh gC j)) := pres_eval_self θh _
    _ = 0 := by
        first
          | exact (congrArg θh h0).trans (map_zero θh)
          | rw [h0, map_zero]

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovPr13 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3m): the residue data on tensor charts (no presentations)

Over `A` with `χ : A →+* K`: `Ah` (the completion, residue `res`), `R'` (residue `χ'`, a section `s : K →+* R'`), a
chart `B`, a target `Q` with `ν : K →+* Q`, `βQ : B →+* Q` (`βQ ∘ algebraMap = ν ∘ χ`).
* `Jt B χ' = (ker χ') (R' ⊗ B)`; `tmul_mem_Jt`;
* **`kap`** `: R' ⊗[A] B →+* Q`, `r ⊗ b ↦ ν (χ' r) * βQ b` (`kap_tmul`), `Jt_le_ker_kap`;
* **`lamQ`** `: Ah ⊗[A] B →+* (R' ⊗[A] B) ⧸ Jt`, `â ⊗ b ↦ s (res â) ⊗ b` (`lamQ_tmul`), `lamQ_map`, `I_le_ker_lamQ`;
* `kap_map` (the two residues agree on `C ⊗ B`), **`exists_sec`** (the section for `resid_ker_pm`).
-/

set_option autoImplicit false

open TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Tens

end Tens

section Lam

variable {K A R' B Ah : Type u} [Field K] [CommRing A] [CommRing R'] [Algebra A R'] [CommRing B] [Algebra A B]
  [CommRing Ah] [Algebra A Ah] (χ : A →+* K) (χ' : R' →+* K) (res : Ah →+* K) (s : K →+* R')
  (hres : ∀ a, res (algebraMap A Ah a) = χ a) (hχ' : ∀ a, χ' (algebraMap A R' a) = χ a) (hs : ∀ k, χ' (s k) = k)

/-- `â ↦ s (res â) ⊗ 1` modulo `Jt` (an `A`-algebra map since `s ∘ χ ≡ algebraMap` mod `ker χ'`). -/
def lamL : Ah →ₐ[A] (R' ⊗[A] B) ⧸ Jt B χ' where
  toRingHom := (Ideal.Quotient.mk (Jt B χ')).comp
    ((Algebra.TensorProduct.includeLeftRingHom : R' →+* R' ⊗[A] B).comp (s.comp res))
  commutes' a := by
    change Ideal.Quotient.mk (Jt B χ') (s (res (algebraMap A Ah a)) ⊗ₜ[A] (1 : B)) =
      Ideal.Quotient.mk (Jt B χ') (algebraMap A (R' ⊗[A] B) a)
    rw [Algebra.TensorProduct.algebraMap_apply, Ideal.Quotient.eq, hres, ← sub_tmul]
    exact tmul_mem_Jt χ' _ (by rw [map_sub, hs, hχ', sub_self]) 1

end Lam

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs2 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As2): the level-0 cover over generic charts, and the fibre kernel

* `eqvG J β hs hk : B ⧸ J ^ (0 + 1) ≃+* F` for `β` surjective with `ker β = J` (`eqvG_mk`), `eqvG_comm`;
* **`baseG`**: a fibre cover `Eᵢ` over `Fᵢ` gives a level-0 two-chart cover `LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ 0`
  (CovL4 `base` with generic ideals);
* **`ker_kap`**: for `χ` surjective and `ker βQ = (ker χ) B`, `ker kap = (ker χ') (R' ⊗ B)`.
-/

set_option autoImplicit false

open TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section EqvG

end EqvG

section BaseG

end BaseG

section KerKap

variable {K A R' B Q : Type u} [Field K] [CommRing A] [CommRing R'] [Algebra A R'] [CommRing B] [Algebra A B]
  [CommRing Q] (χ : A →+* K) (ν : K →+* Q) (βQ : B →+* Q) (hβ : ∀ a, βQ (algebraMap A B a) = ν (χ a))
  (χ' : R' →+* K) (hχ' : ∀ a, χ' (algebraMap A R' a) = χ a)

include hχ' in
/-- Modulo `Jt`, every element of `R' ⊗ B` is `1 ⊗ b` (for `χ` surjective). -/
theorem exists_one_tmul (hχs : Function.Surjective χ) (z : R' ⊗[A] B) :
    ∃ b : B, z - (1 : R') ⊗ₜ[A] b ∈ Jt B χ' := by
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, by rw [TensorProduct.tmul_zero, sub_zero]; exact zero_mem _⟩
  | tmul r b =>
    obtain ⟨a, ha⟩ := hχs (χ' r)
    refine ⟨algebraMap A B a * b, ?_⟩
    rw [one_tmul_algebraMap_mul, ← sub_tmul]
    exact tmul_mem_Jt χ' _ (by rw [map_sub, hχ', ha, sub_self]) b
  | add x y hx hy =>
    obtain ⟨b, hb⟩ := hx
    obtain ⟨b', hb'⟩ := hy
    refine ⟨b + b', ?_⟩
    have e : x + y - (1 : R') ⊗ₜ[A] (b + b') = (x - (1 : R') ⊗ₜ[A] b) + (y - (1 : R') ⊗ₜ[A] b') := by
      rw [TensorProduct.tmul_add]
      ring
    rw [e]
    exact add_mem hb hb'

include hχ' in
theorem one_tmul_mem_Jt (b : B) (hb : b ∈ (RingHom.ker χ).map (algebraMap A B)) :
    (1 : R') ⊗ₜ[A] b ∈ Jt B χ' := by
  have hle : (RingHom.ker χ).map (algebraMap A B) ≤ (Jt B χ').comap
      (Algebra.TensorProduct.includeRight.toRingHom : B →+* R' ⊗[A] B) := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, Ideal.mem_comap]
    have e : (Algebra.TensorProduct.includeRight.toRingHom : B →+* R' ⊗[A] B) (algebraMap A B a) =
        algebraMap A R' a ⊗ₜ[A] (1 : B) := by
      rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Algebra.TensorProduct.includeRight_apply, ← mul_one
        (algebraMap A B a), one_tmul_algebraMap_mul]
    rw [e]
    exact tmul_mem_Jt χ' _ (by rw [hχ']; exact RingHom.mem_ker.mp ha) 1
  exact hle hb

end KerKap

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovG1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2a): sections of `O(d)` of a two-chart cover and their lifting along transitions

* `TwoCov.u` (the coordinate `t` on the overlap), **`TwoCov.sec C d`**: the pairs `(x₀, x₁)` with
  `ψ₀ x₀ = u^d ψ₁ x₁` (global sections of `O(d)`);
* `TwoCovHom.u_map`, **`TwoCovHom.secMap`**: a transition maps sections to sections;
* **`TwoCovHom.secMap_surj`**: if every element of `ker ρ` is `ψ₀ k₀ - u^d ψ₁ k₁` with `kᵢ ∈ ker ρᵢ`, sections lift;
* **`TwoCovHom.hker_of_gens`**: that hypothesis from generators `ψ₀ (g j)` of `ker ρ` whose multiples split.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Sec

variable {b₀ b₁ n : Type u} [CommRing b₀] [CommRing b₁] [CommRing n] {φb₀ : b₀ →+* n} {φb₁ : b₁ →+* n}
  {τ₀ : b₀} {τ₁ : b₁} (C : TwoCov φb₀ φb₁ τ₀ τ₁)

/-- The coordinate `t` on the overlap. -/
abbrev TwoCov.u : C.E := C.ψ₀ (C.a₀ τ₀)

/-- **Global sections of `O(d)`**: pairs `(x₀, x₁)` with `ψ₀ x₀ = u^d ψ₁ x₁`. -/
def TwoCov.sec (d : ℕ) : AddSubgroup (C.E₀ × C.E₁) where
  carrier := {x | C.ψ₀ x.1 = C.u ^ d * C.ψ₁ x.2}
  add_mem' := by
    intro x y hx hy
    simp only [Set.mem_setOf_eq, Prod.fst_add, Prod.snd_add, map_add, mul_add] at *
    rw [hx, hy]
  zero_mem' := by simp
  neg_mem' := by
    intro x hx
    simp only [Set.mem_setOf_eq, Prod.fst_neg, Prod.snd_neg, map_neg, mul_neg] at *
    rw [hx]

end Sec

section Hom

end Hom

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovG2 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2b): Serre vanishing modulo an ideal, uniformly along transitions

For a two-chart cover `C` with ring maps `ιᵢ : R → Eᵢ` (agreeing on the overlap) and an ideal `I` of the overlap:
* **`TwoCov.Good C ι₀ I m y e`**: `E₀` is generated over `R[t]` by `m` modulo `ψ₀⁻¹ I`, and `ψ₀ mᵢ ≡ u^{eᵢ} ψ₁ yᵢ`
  modulo `I` (transition exponents `eᵢ`);
* **`TwoCov.h1_mod`**: then `H¹(O(d)) = 0` modulo `I` for `d ≥ max eᵢ`;
* **`TwoCov.good_zero`**: `Good` holds (any `I`, `I = ⊥` included) when `E₀` is finite over `R[t]`;
* **`TwoCovHom.good_lift`**: `Good` lifts along a transition with the SAME exponents (so `d` is uniform);
* **`TwoCovHom.hker_of_h1`**, **`TwoCovHom.secMap_surj_of_h1`**: `H¹ = 0` modulo `I'` and a kernel generated by
  `q` with `q · I' = 0` give the kernel hypothesis of `secMap_surj`: sections lift.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Good

variable {b₀ b₁ n : Type u} [CommRing b₀] [CommRing b₁] [CommRing n] {φb₀ : b₀ →+* n} {φb₁ : b₁ →+* n}
  {τ₀ : b₀} {τ₁ : b₁} (C : TwoCov φb₀ φb₁ τ₀ τ₁) {R : Type u} [CommRing R] (ι₀ : R →+* C.E₀) (I : Ideal C.E)

/-- **Generators with transition exponents** modulo `I`. -/
def TwoCov.Good {r : ℕ} (m : Fin r → C.E₀) (y : Fin r → C.E₁) (e : Fin r → ℕ) : Prop :=
  (∀ x : C.E₀, ∃ c : Fin r → R[X], C.ψ₀ (x - ∑ i, eval₂ ι₀ (C.a₀ τ₀) (c i) * m i) ∈ I) ∧
  (∀ i, C.ψ₀ (m i) - C.u ^ e i * C.ψ₁ (y i) ∈ I)

/-- The predicate behind Serre vanishing: `v^k ψ₀ x` is a coboundary modulo `I` for every `k`. -/
def TwoCov.PI (d : ℕ) (x : C.E₀) : Prop :=
  ∀ k : ℕ, ∃ (x₀ : C.E₀) (x₁ : C.E₁),
    C.ψ₁ (C.a₁ τ₁) ^ k * C.ψ₀ x - (C.ψ₀ x₀ - C.u ^ d * C.ψ₁ x₁) ∈ I

variable {C I} {d : ℕ}

theorem TwoCov.PI_of_mem {x : C.E₀} (hx : C.ψ₀ x ∈ I) : C.PI I d x := by
  intro k
  refine ⟨0, 0, ?_⟩
  simp only [map_zero, mul_zero, sub_zero]
  exact I.mul_mem_left _ hx

theorem TwoCov.PI_add {x x' : C.E₀} (h : C.PI I d x) (h' : C.PI I d x') : C.PI I d (x + x') := by
  intro k
  obtain ⟨x₀, x₁, hx⟩ := h k
  obtain ⟨y₀, y₁, hy⟩ := h' k
  refine ⟨x₀ + y₀, x₁ + y₁, ?_⟩
  have := I.add_mem hx hy
  rw [map_add, map_add, map_add]
  convert this using 1
  ring

variable (ι₁ : R →+* C.E₁) (hι : C.ψ₀.comp ι₀ = C.ψ₁.comp ι₁)
include hι

theorem TwoCov.PI_C (a : R) {x : C.E₀} (h : C.PI I d x) : C.PI I d (ι₀ a * x) := by
  intro k
  obtain ⟨x₀, x₁, hx⟩ := h k
  refine ⟨ι₀ a * x₀, ι₁ a * x₁, ?_⟩
  have e : C.ψ₀ (ι₀ a) = C.ψ₁ (ι₁ a) := RingHom.congr_fun hι a
  have := I.mul_mem_left (C.ψ₀ (ι₀ a)) hx
  rw [map_mul, map_mul, map_mul]
  convert this using 1
  rw [e]
  ring

omit hι in
theorem TwoCov.PI_gen (hv : C.u * C.ψ₁ (C.a₁ τ₁) = 1) {m : C.E₀} {y : C.E₁} {e : ℕ}
    (hm : C.ψ₀ m - C.u ^ e * C.ψ₁ y ∈ I) (hd : e ≤ d) : C.PI I d m := by
  intro k
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hd
  refine ⟨0, -(C.a₁ τ₁ ^ (j + k) * y), ?_⟩
  have := I.mul_mem_left (C.ψ₁ (C.a₁ τ₁) ^ k) hm
  have hp : (C.u * C.ψ₁ (C.a₁ τ₁)) ^ j = 1 := by rw [hv, one_pow]
  rw [map_zero, map_neg, map_mul, map_pow]
  convert this using 1
  linear_combination (-(C.u ^ e * C.ψ₁ (C.a₁ τ₁) ^ k * C.ψ₁ y)) * hp

end Good

section Zero

end Zero

section Lift

end Lift

section Ker

end Ker

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovG3 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2b): sections of `O(d)` lift along the whole tower, for one `d₀`

Charts `Bᵢ` with ring maps `ιBᵢ : R → Bᵢ` (agreeing in `N`) and `Jᵢ = p Bᵢ`, `JN = p N`:
* level maps **`lι₀`**, **`lι₁`** (`R → Eᵢ` at level `k`), **`lI`** (the ideal `p E`), `lι_compat`, `lhv`;
* along a transition: `lρι₀`, **`ker_ρ`** (`ker ρ = p^(k+1) E'`), `lq₀`, `lq₁`, `lqI` (`p^(k+1) · p E' = 0`), `lI_comap`;
* **`good_tower`**: generators with the same exponents at every level of `tower`;
* **`secMap_surj_tower`**: one `d₀` such that `secMap (towerHom k) d` is surjective for all `k` and `d ≥ d₀`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Lv

variable {B₀ B₁ N R : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing R] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (ιB₀ : R →+* B₀) (ιB₁ : R →+* B₁) (p : Ideal R)

/-- `R → E₀` at level `k`. -/
def lι₀ {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) : R →+* C.E₀ :=
  C.a₀.comp ((Ideal.Quotient.mk (J₀ ^ (k + 1))).comp ιB₀)

/-- `R → E₁` at level `k`. -/
def lι₁ {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) : R →+* C.E₁ :=
  C.a₁.comp ((Ideal.Quotient.mk (J₁ ^ (k + 1))).comp ιB₁)

/-- The ideal `p E` of the overlap at level `k`. -/
def lI {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) : Ideal C.E :=
  p.map (C.ψ₀.comp (lι₀ ιB₀ C))

theorem lι_compat (hιB : φ₀.comp ιB₀ = φ₁.comp ιB₁) {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) :
    C.ψ₀.comp (lι₀ ιB₀ C) = C.ψ₁.comp (lι₁ ιB₁ C) := by
  ext α
  have e₀ := RingHom.congr_fun C.hψ₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) (ιB₀ α))
  have e₁ := RingHom.congr_fun C.hψ₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) (ιB₁ α))
  simp only [RingHom.comp_apply, Ideal.quotientMap_mk] at e₀ e₁
  simp only [lι₀, lι₁, RingHom.comp_apply, e₀, e₁]
  rw [show φ₀ (ιB₀ α) = φ₁ (ιB₁ α) from RingHom.congr_fun hιB α]

theorem lhv (hts : φ₀ t₀ * φ₁ t₁ = 1) {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) :
    C.u * C.ψ₁ (C.a₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) t₁)) = 1 := by
  have e₀ := RingHom.congr_fun C.hψ₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) t₀)
  have e₁ := RingHom.congr_fun C.hψ₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) t₁)
  simp only [RingHom.comp_apply, Ideal.quotientMap_mk] at e₀ e₁
  change C.ψ₀ (C.a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) t₀)) * _ = 1
  rw [e₀, e₁, ← map_mul, ← map_mul, hts, map_one, map_one]

variable {k : ℕ} {C' : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ (k + 1)} {C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k}
  (H : TwoCovHom (down J₀ k) (down J₁ k) (down JN k) C' C)

theorem lρι₀ : H.ρ₀.comp (lι₀ ιB₀ C') = lι₀ ιB₀ C := by
  ext α
  have := RingHom.congr_fun H.c₀ (Ideal.Quotient.mk (J₀ ^ (k + 1 + 1)) (ιB₀ α))
  simpa only [lι₀, RingHom.comp_apply, Ideal.Quotient.factor_mk] using this

theorem lqI (hJ₀ : J₀ = p.map ιB₀) : ∀ α ∈ p ^ (k + 1), ∀ i ∈ lI ιB₀ p C',
    C'.ψ₀ (lι₀ ιB₀ C' α) * i = 0 := by
  intro α hα i hi
  have hm : C'.ψ₀ (lι₀ ιB₀ C' α) * i ∈ (p ^ (k + 1) * p).map (C'.ψ₀.comp (lι₀ ιB₀ C')) := by
    rw [Ideal.map_mul]
    exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ hα) hi
  have hb : (p ^ (k + 1) * p).map (C'.ψ₀.comp (lι₀ ιB₀ C')) = ⊥ := by
    rw [Ideal.map_eq_bot_iff_le_ker]
    intro β hβ
    have hm : ιB₀ β ∈ J₀ ^ (k + 1 + 1) := by
      rw [hJ₀, ← Ideal.map_pow, pow_succ]
      exact Ideal.mem_map_of_mem _ hβ
    have h0 : Ideal.Quotient.mk (J₀ ^ (k + 1 + 1)) (ιB₀ β) = 0 := Ideal.Quotient.eq_zero_iff_mem.2 hm
    rw [RingHom.mem_ker]
    simp only [lι₀, RingHom.comp_apply]
    rw [h0, map_zero, map_zero]
  rw [hb] at hm
  exact hm

end Lv

section Tower

end Tower

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovH1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-1a): `H¹` of `p^n O(d)` vanishes, and overlap relations come from chart 0

For a two-chart cover `C` with ring maps `ιᵢ : R → Eᵢ` agreeing on the overlap:
* **`TwoCov.Spl ι₀ ι₁ 𝔞 d z`**: `z = ψ₀ x₀ - u^d ψ₁ x₁` with `xᵢ ∈ 𝔞 Eᵢ`; `Spl.add`, `Spl.zero`, `Spl.mono`, `Spl.mul`;
* **`TwoCov.spl_pow`**: `H¹ = 0` modulo `p E` and `p^N E = 0` give `Spl (p^n)` on all of `p^n E`;
* **`TwoCov.to_chart0`**: a relation vector on the overlap with entries in `𝔞 E` is `u^{-e} ψ₀` of one on chart 0;
* **`spl_tower`**: one `d₀` with `Spl (p^n) d` on `p^n E` at every level of the tower, all `n`, all `d ≥ d₀`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Spl

variable {b₀ b₁ n : Type u} [CommRing b₀] [CommRing b₁] [CommRing n] {φb₀ : b₀ →+* n} {φb₁ : b₁ →+* n}
  {τ₀ : b₀} {τ₁ : b₁} (C : TwoCov φb₀ φb₁ τ₀ τ₁) {R : Type u} [CommRing R] (ι₀ : R →+* C.E₀) (ι₁ : R →+* C.E₁)

/-- `z` splits as `ψ₀ x₀ - u^d ψ₁ x₁` with `xᵢ ∈ 𝔞 Eᵢ`. -/
def TwoCov.Spl (𝔞 : Ideal R) (d : ℕ) (z : C.E) : Prop :=
  ∃ x₀ ∈ 𝔞.map ι₀, ∃ x₁ ∈ 𝔞.map ι₁, z = C.ψ₀ x₀ - C.u ^ d * C.ψ₁ x₁

variable {C ι₀ ι₁}

theorem TwoCov.Spl.add {𝔞 : Ideal R} {d : ℕ} {z z' : C.E} (h : C.Spl ι₀ ι₁ 𝔞 d z)
    (h' : C.Spl ι₀ ι₁ 𝔞 d z') : C.Spl ι₀ ι₁ 𝔞 d (z + z') := by
  obtain ⟨x₀, hx₀, x₁, hx₁, rfl⟩ := h
  obtain ⟨y₀, hy₀, y₁, hy₁, rfl⟩ := h'
  refine ⟨x₀ + y₀, Ideal.add_mem _ hx₀ hy₀, x₁ + y₁, Ideal.add_mem _ hx₁ hy₁, ?_⟩
  rw [map_add, map_add]
  ring

theorem TwoCov.Spl.zero (𝔞 : Ideal R) (d : ℕ) : C.Spl ι₀ ι₁ 𝔞 d 0 :=
  ⟨0, Ideal.zero_mem _, 0, Ideal.zero_mem _, by simp⟩

theorem TwoCov.Spl.mono {𝔞 𝔟 : Ideal R} (h𝔞 : 𝔞 ≤ 𝔟) {d : ℕ} {z : C.E} (h : C.Spl ι₀ ι₁ 𝔞 d z) :
    C.Spl ι₀ ι₁ 𝔟 d z := by
  obtain ⟨x₀, hx₀, x₁, hx₁, rfl⟩ := h
  exact ⟨x₀, Ideal.map_mono h𝔞 hx₀, x₁, Ideal.map_mono h𝔞 hx₁, rfl⟩

theorem TwoCov.Spl.mul (hι : C.ψ₀.comp ι₀ = C.ψ₁.comp ι₁) {𝔞 𝔟 : Ideal R} {d : ℕ} {z : C.E}
    (h : C.Spl ι₀ ι₁ 𝔞 d z) {π : R} (hπ : π ∈ 𝔟) : C.Spl ι₀ ι₁ (𝔟 * 𝔞) d (C.ψ₀ (ι₀ π) * z) := by
  obtain ⟨x₀, hx₀, x₁, hx₁, rfl⟩ := h
  have e : C.ψ₀ (ι₀ π) = C.ψ₁ (ι₁ π) := RingHom.congr_fun hι π
  refine ⟨ι₀ π * x₀, ?_, ι₁ π * x₁, ?_, ?_⟩
  · rw [Ideal.map_mul]; exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ hπ) hx₀
  · rw [Ideal.map_mul]; exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem _ hπ) hx₁
  · rw [map_mul, map_mul, ← e]
    ring

theorem TwoCov.spl_top {d : ℕ} {z : C.E} (x₀ : C.E₀) (x₁ : C.E₁) (h : z = C.ψ₀ x₀ - C.u ^ d * C.ψ₁ x₁) :
    C.Spl ι₀ ι₁ ⊤ d z :=
  ⟨x₀, by rw [Ideal.map_top]; exact Submodule.mem_top, x₁, by rw [Ideal.map_top]; exact Submodule.mem_top, h⟩

/-- **Overlap relations come from chart 0**: a vector `w` on the overlap with entries in `𝔞 E` and
`∑ ψ₀ (ι₀ αᵢ) wᵢ = 0` is `u^{-e} ψ₀ w'` with `w'` a relation on chart 0 with entries in `𝔞 E₀`. -/
theorem TwoCov.to_chart0 (hv : C.u * C.ψ₁ (C.a₁ τ₁) = 1) (𝔞 : Ideal R) {g : ℕ} (α : Fin g → R)
    (w : Fin g → C.E) (hw : ∀ i, w i ∈ 𝔞.map (C.ψ₀.comp ι₀)) (hμ : ∑ i, C.ψ₀ (ι₀ (α i)) * w i = 0) :
    ∃ (e : ℕ) (w' : Fin g → C.E₀), (∀ i, w' i ∈ 𝔞.map ι₀) ∧ ∑ i, ι₀ (α i) * w' i = 0 ∧
      ∀ i, C.u ^ e * w i = C.ψ₀ (w' i) := by
  letI := C.ψ₀.toAlgebra
  haveI : IsLocalization.Away (C.a₀ τ₀) C.E :=
    isLocalization_of_isAwayMap C.ψ₀ _ C.aw₀ (IsUnit.of_mul_eq_one _ hv)
  have hloc : ∀ i, ∃ (k : ℕ) (a : C.E₀), a ∈ 𝔞.map ι₀ ∧ C.u ^ k * w i = C.ψ₀ a := by
    intro i
    have hi : w i ∈ (𝔞.map ι₀).map (algebraMap C.E₀ C.E) := by
      rw [Ideal.map_map]
      exact hw i
    obtain ⟨⟨⟨a, ha⟩, ⟨_, k, rfl⟩⟩, hx⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers (C.a₀ τ₀)) C.E).1 hi
    refine ⟨k, a, ha, ?_⟩
    have hx' : w i * C.ψ₀ (C.a₀ τ₀ ^ k) = C.ψ₀ a := hx
    rw [map_pow] at hx'
    rw [mul_comm]
    exact hx'
  choose k a ha hka using hloc
  set K := ∑ i, k i with hK
  have hkK : ∀ i, k i ≤ K := fun i => Finset.single_le_sum (fun j _ => Nat.zero_le (k j)) (Finset.mem_univ i)
  have hw'' : ∀ i, C.u ^ K * w i = C.ψ₀ (C.a₀ τ₀ ^ (K - k i) * a i) := by
    intro i
    rw [map_mul, map_pow, ← hka i, ← mul_assoc]
    change _ = (C.u ^ (K - k i) * C.u ^ k i) * w i
    rw [← pow_add, Nat.sub_add_cancel (hkK i)]
  have h0 : C.ψ₀ (∑ i, ι₀ (α i) * (C.a₀ τ₀ ^ (K - k i) * a i)) = 0 := by
    rw [map_sum]
    have e : ∀ i, C.ψ₀ (ι₀ (α i) * (C.a₀ τ₀ ^ (K - k i) * a i)) = C.u ^ K * (C.ψ₀ (ι₀ (α i)) * w i) := by
      intro i
      rw [map_mul, ← hw'' i]
      ring
    simp only [e]
    rw [← Finset.mul_sum, hμ, mul_zero]
  obtain ⟨k', hk'⟩ := C.aw₀.2 _ h0
  refine ⟨k' + K, fun i => C.a₀ τ₀ ^ k' * (C.a₀ τ₀ ^ (K - k i) * a i), fun i => ?_, ?_, fun i => ?_⟩
  · exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (ha i))
  · rw [Finset.mul_sum] at hk'
    refine (Finset.sum_congr rfl fun i _ => ?_).trans hk'
    ring
  · rw [pow_add, mul_assoc, hw'' i]
    change C.ψ₀ (C.a₀ τ₀) ^ k' * _ = _
    rw [← map_pow C.ψ₀, ← map_mul C.ψ₀]

end Spl

section Tower

variable {B₀ B₁ N R : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing R] (φ₀ : B₀ →+* N)
  (φ₁ : B₁ →+* N) (J₀ : Ideal B₀) (J₁ : Ideal B₁) (JN : Ideal N) (h₀ : J₀.map φ₀ = JN) (h₁ : J₁.map φ₁ = JN)
  (t₀ : B₀) (t₁ : B₁) (hφ₀ : IsAwayMap φ₀ t₀) (hφ₁ : IsAwayMap φ₁ t₁) (hu₀ : IsUnit (φ₀ t₀))
  (hu₁ : IsUnit (φ₁ t₁)) (C₀ : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ 0) (ιB₀ : R →+* B₀) (ιB₁ : R →+* B₁)
  (p : Ideal R)

/-- `p^(k+1)` vanishes at level `k`, on chart 0. -/
theorem lpow_bot₀ (hJ₀ : J₀ = p.map ιB₀) {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) {j : ℕ}
    (hj : k + 1 ≤ j) : (p ^ j).map (lι₀ ιB₀ C) = ⊥ := by
  rw [Ideal.map_eq_bot_iff_le_ker]
  intro β hβ
  have hm : ιB₀ β ∈ J₀ ^ (k + 1) := by
    rw [hJ₀, ← Ideal.map_pow]
    exact Ideal.map_mono (Ideal.pow_le_pow_right hj) (Ideal.mem_map_of_mem _ hβ)
  rw [RingHom.mem_ker]
  simp only [lι₀, RingHom.comp_apply]
  rw [Ideal.Quotient.eq_zero_iff_mem.2 hm, map_zero]

/-- `p^(k+1)` vanishes at level `k`, on chart 1. -/
theorem lpow_bot₁ (hJ₁ : J₁ = p.map ιB₁) {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) {j : ℕ}
    (hj : k + 1 ≤ j) : (p ^ j).map (lι₁ ιB₁ C) = ⊥ := by
  rw [Ideal.map_eq_bot_iff_le_ker]
  intro β hβ
  have hm : ιB₁ β ∈ J₁ ^ (k + 1) := by
    rw [hJ₁, ← Ideal.map_pow]
    exact Ideal.map_mono (Ideal.pow_le_pow_right hj) (Ideal.mem_map_of_mem _ hβ)
  rw [RingHom.mem_ker]
  simp only [lι₁, RingHom.comp_apply]
  rw [Ideal.Quotient.eq_zero_iff_mem.2 hm, map_zero]

include hφ₀ hφ₁ hu₀ hu₁

end Tower

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovFil1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-1d): overlap relations with entries in `p^j` split into chart relations

For a level-`k` cover `C` (charts `Bᵢ ⧸ Jᵢ^(k+1)`, `Jᵢ = p Bᵢ`):
* `decomp_succ`: an element of `p^(j+1) B` is `∑ αᵢ yᵢ` with `yᵢ ∈ p^j B`;
* `lψθ₀`, `lψθ₁`, `mem_lι₀`, `mem_lι₁`: bookkeeping for the level-`k` charts;
* `chart0_decomp`: a chart-0 relation with entries in `p^j` is `∑ cₗ ρ0ₗ + v` (base relations, flatness);
* `split_rel`: such a decomposition splits on the two charts (uniform `H¹` vanishing);
* **`lift_rel`**: an overlap relation `w` with entries in `p^j` is `ψ₀ a - u^d ψ₁ b` with `a`, `b` chart relations
  with entries in `p^j`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Lv

variable {B₀ B₁ N R : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing R] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (ιB₀ : R →+* B₀) (ιB₁ : R →+* B₁) (p : Ideal R)

theorem lψθ₁ {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) (b : B₁) :
    C.ψ₁ (C.a₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) b)) = C.a (Ideal.Quotient.mk (JN ^ (k + 1)) (φ₁ b)) := by
  have e := RingHom.congr_fun C.hψ₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) b)
  simp only [RingHom.comp_apply, Ideal.quotientMap_mk] at e
  exact e

theorem mem_lι₀ {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) {n : ℕ} {b : B₀}
    (hb : b ∈ (p ^ n).map ιB₀) : C.a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) b) ∈ (p ^ n).map (lι₀ ιB₀ C) := by
  have h := Ideal.mem_map_of_mem (C.a₀.comp (Ideal.Quotient.mk (J₀ ^ (k + 1)))) hb
  rw [Ideal.map_map] at h
  exact h

theorem mem_lι₁ {k : ℕ} (C : LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k) {n : ℕ} {b : B₁}
    (hb : b ∈ (p ^ n).map ιB₁) : C.a₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) b) ∈ (p ^ n).map (lι₁ ιB₁ C) := by
  have h := Ideal.mem_map_of_mem (C.a₁.comp (Ideal.Quotient.mk (J₁ ^ (k + 1)))) hb
  rw [Ideal.map_map] at h
  exact h

end Lv

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovLim2 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-2b): `R`-combinations of compatible families at each level

For families `σ : Fin r → (∀ k, E₀ k) × (∀ k, E₁ k)`:
* **`lev C ιB₀ ιB₁ σ m c`** `= ∑ cᵢ σᵢ` at level `m`; `lev_fst`, `lev_snd`, `lev_add`, `lev_sub`, `lev_zero`, `lev_comb`;
* `lev_mem`: it is a section of `O(d)` when the `σᵢ` are in `Gam`; `lev_ρ₀`, `lev_ρ₁`: compatibility;
* `lev_congr`: coefficients congruent modulo `p^(m+1)` give the same level-`m` combination;
* **`levF`**, `levF_mem`: the family of all levels lies in `Gam`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Lev

variable {B₀ B₁ N R : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing R] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k)) (ιB₀ : R →+* B₀)
  (ιB₁ : R →+* B₁) (p : Ideal R) {r : ℕ} (σ : Fin r → (∀ k, (C k).E₀) × (∀ k, (C k).E₁))

/-- The level-`m` combination `∑ cᵢ σᵢ`. -/
def lev (m : ℕ) (c : Fin r → R) : (C m).E₀ × (C m).E₁ :=
  ∑ i, (lι₀ ιB₀ (C m) (c i) * (σ i).1 m, lι₁ ιB₁ (C m) (c i) * (σ i).2 m)

theorem lev_snd (m : ℕ) (c : Fin r → R) :
    (lev C ιB₀ ιB₁ σ m c).2 = ∑ i, lι₁ ιB₁ (C m) (c i) * (σ i).2 m := by
  simp only [lev, Prod.snd_sum]

/-- The compatible family of all levels of `∑ cᵢ σᵢ`. -/
def levF (c : Fin r → R) : (∀ k, (C k).E₀) × (∀ k, (C k).E₁) :=
  (fun k => (lev C ιB₀ ιB₁ σ k c).1, fun k => (lev C ιB₀ ιB₁ σ k c).2)

end Lev

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_Z1Two =====
section

/-!
# S4-EtPBC-A, (Z1): sections over the two charts of `P¹_A` form a finite `A`-module

Algebraic form of "`H⁰(P¹_A, 𝓕)` is finite over `A` for a coherent `𝓕`" (`A` noetherian), with `𝓕` given by
a finite `A[t]`-module `M₀`, a finite `A[s]`-module `M₁` (both written as `A[X]`-modules) and `A`-linear maps
`φ₀ : M₀ → N`, `φ₁ : M₁ → N` into the module over the overlap, where `X` acts on `N` as `t` and
`t • φ₁ (s • m) = φ₁ m`.

* `xTors M`: the `X`-power torsion; **`xTors_fg`**: it is finite over `A` for `M` finite over `A[X]`.
* `pow_smul_iter`, **`exists_refl`**: `X^D • φ₁ (c • w) = q • φ₁ w` with `deg q ≤ D` when `deg c ≤ D`.
* `twoChart φ₀ φ₁ := {(a, b) | φ₀ a = φ₁ b}` and **`twoChart_fg`**: it is finite over `A`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Z1

universe u v w w'

variable {A : Type u} [CommRing A]

theorem mem_xTors {M : Type v} [AddCommGroup M] [Module A[X] M] {m : M} :
    m ∈ xTors (A := A) M ↔ ∃ k : ℕ, (X ^ k : A[X]) • m = 0 := Iff.rfl

/-- A common torsion exponent for finitely many torsion elements. -/
theorem exists_pow_smul_eq_zero {M : Type v} [AddCommGroup M] [Module A[X] M] (G : Finset M)
    (hG : ∀ g ∈ G, g ∈ xTors (A := A) M) : ∃ k : ℕ, ∀ g ∈ G, (X ^ k : A[X]) • g = 0 := by
  classical
  induction G using Finset.induction_on with
  | empty => exact ⟨0, fun g hg => absurd hg (Finset.notMem_empty g)⟩
  | insert a s _ ih =>
    obtain ⟨k, hk⟩ := ih fun g hg => hG g (Finset.mem_insert_of_mem hg)
    obtain ⟨l, hl⟩ := hG a (Finset.mem_insert_self a s)
    refine ⟨k + l, fun g hg => ?_⟩
    rcases Finset.mem_insert.1 hg with rfl | hg
    · rw [pow_add, mul_smul, hl, smul_zero]
    · rw [pow_add, mul_comm, mul_smul, hk g hg, smul_zero]

section TwoChart

variable {M₁ : Type w} {N : Type w'} [AddCommGroup M₁] [Module A[X] M₁] [Module A M₁] [IsScalarTower A A[X] M₁]
  [AddCommGroup N] [Module A[X] N] [Module A N] [IsScalarTower A A[X] N]

omit [Module A[X] M₁] [IsScalarTower A A[X] M₁] in
theorem mem_twoChart {M₀ : Type v} [AddCommGroup M₀] [Module A[X] M₀] [Module A M₀] [IsScalarTower A A[X] M₀]
    (φ₀ : M₀ →ₗ[A[X]] N) (φ₁ : M₁ →ₗ[A] N) (x : M₀ × M₁) : x ∈ twoChart φ₀ φ₁ ↔ φ₀ x.1 = φ₁ x.2 :=
  LinearMap.mem_eqLocus

end TwoChart

end RamanujanPetersson.EtPBC.Z1

end

end

-- ===== S4.Def_RP_EtPBC_A_CovLim5 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-2f): multiplication by `T₀`, `T₁` on compatible families; completed generation

* `mT₀`, `mT₁`: multiplication of a family by `T₀ = (1, s)` and `T₁ = (t, 1)`; `ρ₀_t`, `ρ₁_s`; `mT₀_mem`, `mT₁_mem`;
* **`gam_struct`**: finitely many `τⱼ ∈ Gam (e+1)` such that every `x ∈ Gam (e+2)` is
  `T₀ (∑ aⱼ τⱼ) + T₁ (∑ a'ⱼ τⱼ)` (`R` noetherian and `p`-precomplete, `H¹(O(e)) = 0` at level `0`).
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section T

variable {B₀ B₁ N : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k))

/-- Multiplication of a family by `T₀ = (1, s)`. -/
def mT₀ (x : (∀ k, (C k).E₀) × (∀ k, (C k).E₁)) : (∀ k, (C k).E₀) × (∀ k, (C k).E₁) :=
  (x.1, fun k => (C k).a₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) t₁) * x.2 k)

/-- Multiplication of a family by `T₁ = (t, 1)`. -/
def mT₁ (x : (∀ k, (C k).E₀) × (∀ k, (C k).E₁)) : (∀ k, (C k).E₀) × (∀ k, (C k).E₁) :=
  (fun k => (C k).a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) t₀) * x.1 k, x.2)

theorem ρ₀_t (k : ℕ) : (H k).ρ₀ ((C (k + 1)).a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1 + 1)) t₀)) =
    (C k).a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) t₀) := by
  have e := RingHom.congr_fun (H k).c₀ (Ideal.Quotient.mk (J₀ ^ (k + 1 + 1)) t₀)
  simp only [RingHom.comp_apply] at e
  rw [e]
  exact congrArg (C k).a₀ (Ideal.Quotient.factor_mk _ _)

end T

section Struct

end Struct

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovHat1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-3a): the completed chart rings as subrings of products of localizations

For a tower `C`, `H` of level covers:
* `fB₀`, `fB₁`: `Bᵢ → ∏ₖ Eᵢ(k)`; `tFm = fB₀ t₀`, `sFm = fB₁ t₁`; `L₀ = (∏ E₀(k))[1/t]`, `L₁ = (∏ E₁(k))[1/s]`;
* `gam_cast`, `gam_one`, `gam_mul`, `gam_pow`; `gT₀ = (1, s)`, `gT₁ = (t, 1)` with `gT₀_mem`, `gT₁_mem`;
* **`hE₀`** `⊆ ∏ E₀(k) × L₁` (fractions `x / T₀ᵈ`), **`hE₁`** `⊆ L₀ × ∏ E₁(k)` (fractions `x / T₁ᵈ`),
  **`hE`** `⊆ L₀ × L₁` (fractions `x / T₁ᵃ T₀ᵇ`); **`hψ₀ : hE₀ →+* hE`**, **`hψ₁ : hE₁ →+* hE`**.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Hat

variable {B₀ B₁ N : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k))

/-- `B₀ → ∏ₖ E₀(k)`. -/
def fB₀ : B₀ →+* ∀ k, (C k).E₀ := Pi.ringHom fun k => (C k).a₀.comp (Ideal.Quotient.mk (J₀ ^ (k + 1)))

/-- `B₁ → ∏ₖ E₁(k)`. -/
def fB₁ : B₁ →+* ∀ k, (C k).E₁ := Pi.ringHom fun k => (C k).a₁.comp (Ideal.Quotient.mk (J₁ ^ (k + 1)))

theorem fB₀_apply (b : B₀) (k : ℕ) : fB₀ C b k = (C k).a₀ (Ideal.Quotient.mk (J₀ ^ (k + 1)) b) := rfl

theorem fB₁_apply (b : B₁) (k : ℕ) : fB₁ C b k = (C k).a₁ (Ideal.Quotient.mk (J₁ ^ (k + 1)) b) := rfl

/-- The family `t = (a₀ t₀)ₖ`. -/
abbrev tFm : ∀ k, (C k).E₀ := fB₀ C t₀

/-- The family `s = (a₁ t₁)ₖ`. -/
abbrev sFm : ∀ k, (C k).E₁ := fB₁ C t₁

/-- `(∏ E₀(k))[1/t]`. -/
abbrev L₀ := Localization.Away (tFm C)

/-- `(∏ E₁(k))[1/s]`. -/
abbrev L₁ := Localization.Away (sFm C)

/-- `∏ E₀(k) → L₀`. -/
abbrev jL₀ : (∀ k, (C k).E₀) →+* L₀ C := algebraMap _ _

/-- `∏ E₁(k) → L₁`. -/
abbrev jL₁ : (∀ k, (C k).E₁) →+* L₁ C := algebraMap _ _

/-- `T₀ = (1, s)`. -/
def gT₀ : (∀ k, (C k).E₀) × (∀ k, (C k).E₁) := (1, sFm C)

/-- `T₁ = (t, 1)`. -/
def gT₁ : (∀ k, (C k).E₀) × (∀ k, (C k).E₁) := (tFm C, 1)

end Hat

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovHat2 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-3b): the completed overlap ring and the maps from the base charts

* **`hE`** `⊆ L₀ × L₁` (fractions `x / T₁ᵃ T₀ᵇ`, `x ∈ Gam (a + b)`); **`hψ₀ : hE₀ →+* hE`**, **`hψ₁ : hE₁ →+* hE`**;
* `ρ₀_fB`, `ρ₁_fB`, **`famB_mem`**: `(fB₀ b₀, fB₁ b₁) ∈ Gam d` when `φ₀ b₀ = φ₀ t₀ ^ d * φ₁ b₁`;
* **`liftN₀ : N →+* L₀`**, **`liftN₁ : N →+* L₁`** (from `N = B₀[1/t₀] = B₁[1/t₁]`), `liftN₀_φ₀`, `liftN₁_φ₁`,
  `liftN₀_inv`, `liftN₁_inv`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Hat2

variable {B₀ B₁ N : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k))

/-- **`N = B₀[1/t₀] → L₀`.** -/
def liftN₀ (hφ₀ : IsAwayMap φ₀ t₀) (hu₀ : IsUnit (φ₀ t₀)) : N →+* L₀ C :=
  letI := φ₀.toAlgebra
  haveI := isLocalization_of_isAwayMap φ₀ t₀ hφ₀ hu₀
  IsLocalization.Away.lift t₀ (g := (jL₀ C).comp (fB₀ C)) (IsLocalization.Away.algebraMap_isUnit (tFm C))

end Hat2

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovHat4 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-3d): fractions `x / T₀ᵈ`, `x / T₁ᵈ` in the completed charts

* **`frac₀ d x hx : hE₀`**, `frac₀_val`, `frac₀_spec`, `hE₀_ext`, **`eq_frac₀`**, `frac₀_congr`, **`frac₀_T₀`**,
  `frac₀_add`, `frac₀_mul`; chart 1: `frac₁`, `frac₁_spec`, `hE₁_ext`, `eq_frac₁`, `frac₁_congr`, `frac₁_T₁`, `frac₁_add`,
  `frac₁_mul`;
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Frac

variable {B₀ B₁ N : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k))
  (hts : φ₀ t₀ * φ₁ t₁ = 1)

variable {C H}

variable (C) in
theorem isUnit_jL₀ (d : ℕ) : IsUnit (jL₀ C (tFm C ^ d)) := by
  rw [map_pow]
  exact (IsLocalization.Away.algebraMap_isUnit (tFm C)).pow d

end Frac

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovHat5 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-3e): fractions of `R`-combinations

* `ιP : R →+* ∏E₀ × ∏E₁`, `ιh₀ = β₀ ∘ ιB₀`, `ιh₁ = β₁ ∘ ιB₁`, **`levF_eq`** (`levF σ a = ∑ ιP (aᵢ) σᵢ`),
  **`frac₀_lin`**, **`frac₁_lin`**: fractions of `R`-combinations are combinations of fractions.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Lin

variable {B₀ B₁ N R : Type u} [CommRing B₀] [CommRing B₁] [CommRing N] [CommRing R] {φ₀ : B₀ →+* N}
  {φ₁ : B₁ →+* N} {J₀ : Ideal B₀} {J₁ : Ideal B₁} {JN : Ideal N} {h₀ : J₀.map φ₀ = JN} {h₁ : J₁.map φ₁ = JN}
  {t₀ : B₀} {t₁ : B₁} (C : ∀ k, LCov φ₀ φ₁ J₀ J₁ JN h₀ h₁ t₀ t₁ k)
  (H : ∀ k, TwoCovHom (down J₀ k) (down J₁ k) (down JN k) (C (k + 1)) (C k)) (ιB₀ : R →+* B₀)
  (ιB₁ : R →+* B₁) (hts : φ₀ t₀ * φ₁ t₁ = 1) (hφ₀ : IsAwayMap φ₀ t₀) (hu₀ : IsUnit (φ₀ t₀))
  (hφ₁ : IsAwayMap φ₁ t₁) (hu₁ : IsUnit (φ₁ t₁))

/-- `R → ∏E₀ × ∏E₁`. -/
def ιP : R →+* (∀ k, (C k).E₀) × (∀ k, (C k).E₁) := ((fB₀ C).comp ιB₀).prod ((fB₁ C).comp ιB₁)

end Lin

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_LocFlat =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-5, E3b1): the local criterion for flatness (finite modules over a local ring)

For a local ring `(A, 𝔪)` and a finite `A`-module `M`:
* `lf_li_flat`: over a local ring, a family in a flat module whose combinations with a coefficient outside `𝔪`
  never lie in `𝔪 • M` is linearly independent (Mathlib's `linearIndependent_of_flat`, residue field form removed);
* `lf_coef_mem`: if `M ⧸ I M` is flat over `A ⧸ I` (`I ≠ ⊤`), a relation `∑ gᵢ vᵢ = 0` among lifts of a residue
  basis has all `gᵢ ∈ I`;
* **`free_of_quot_flat'`**: `M ⧸ Iₖ M` flat over `A ⧸ Iₖ` for a family `Iₖ ≠ ⊤` with `⋂ Iₖ = 0` ⇒ `M` free;
* **`free_of_quot_flat`** (`A` noetherian, `J ≠ ⊤`): `M ⧸ J^(k+1) M` flat over `A ⧸ J^(k+1)` for all `k` ⇒ `M` free.
-/

set_option autoImplicit false

noncomputable section

open TensorProduct IsLocalRing

namespace RamanujanPetersson.EtPBC.Cov

universe u

section LocFlat

theorem lf_li_res {R N : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup N] [Module R N] {ι : Type*}
    (v : ι → N)
    (h : ∀ (s : Finset ι) (c : ι → R), ∑ i ∈ s, c i • v i ∈ (maximalIdeal R) • (⊤ : Submodule R N) →
      ∀ i ∈ s, c i ∈ maximalIdeal R) :
    LinearIndependent (ResidueField R) (TensorProduct.mk R (ResidueField R) N 1 ∘ v) := by
  rw [linearIndependent_iff']
  intro s g hg i hi
  choose c hc using fun j => residue_surjective (R := R) (g j)
  have e : ∑ j ∈ s, g j • (TensorProduct.mk R (ResidueField R) N 1 ∘ v) j
      = ∑ j ∈ s, residue R (c j) • TensorProduct.mk R (ResidueField R) N 1 (v j) :=
    Finset.sum_congr rfl fun j _ => by rw [hc j, Function.comp_apply]
  rw [e, lf_res_sum v s c, lf_mk_eq_zero_iff] at hg
  rw [← hc i, residue_eq_zero_iff]
  exact h s c hg i hi

end LocFlat

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_LocFree =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-5, E3b2): the primes over `J` lie in the free locus

For a noetherian ring `A`, an ideal `J` and a finite `A`-module `M` with `M ⧸ J^(k+1) M` flat over `A ⧸ J^(k+1)` for
all `k`:
* `lf_flat_quot_iff`: flatness of `M ⧸ I M` over `A ⧸ I` is flatness of `(A ⧸ I) ⊗ M`;
* `lf_flat_loc`: it passes to any `A`-algebra `Rₚ` (`Rₚ ⊗ M` modulo `I Rₚ`);
* **`lf_mem_freeLocus`**: every prime `𝔮 ⊇ J` lies in `Module.freeLocus A M`.
-/

set_option autoImplicit false

noncomputable section

open TensorProduct IsLocalRing

namespace RamanujanPetersson.EtPBC.Cov

universe u

section LocFree

theorem lf_flat_loc {A M : Type u} [CommRing A] [AddCommGroup M] [Module A M] (I : Ideal A)
    (Rₚ : Type u) [CommRing Rₚ] [Algebra A Rₚ]
    (hfl : Module.Flat (A ⧸ I) (M ⧸ (I • ⊤ : Submodule A M))) :
    Module.Flat (Rₚ ⧸ I.map (algebraMap A Rₚ))
      ((Rₚ ⊗[A] M) ⧸ (I.map (algebraMap A Rₚ) • ⊤ : Submodule Rₚ (Rₚ ⊗[A] M))) := by
  rw [lf_flat_quot_iff] at hfl ⊢
  have h1 : Module.Flat (Rₚ ⧸ I.map (algebraMap A Rₚ)) ((Rₚ ⧸ I.map (algebraMap A Rₚ)) ⊗[A] M) :=
    Module.Flat.of_linearEquiv (TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I)
      (Rₚ ⧸ I.map (algebraMap A Rₚ)) (Rₚ ⧸ I.map (algebraMap A Rₚ)) M).symm
  exact Module.Flat.of_linearEquiv (TensorProduct.AlgebraTensorModule.cancelBaseChange A Rₚ
    (Rₚ ⧸ I.map (algebraMap A Rₚ)) (Rₚ ⧸ I.map (algebraMap A Rₚ)) M)

end LocFree

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovSp =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2, properness input): `1` is not an `m`-polynomial in both `x` and `x⁻¹`

**`not_top_and_top`** (the lemma in Atiyah-Macdonald 5.21): for an ideal `m ≤ jacobson ⊥` of `R`, a ring map
`ι : R → S` to a nontrivial ring and `x y = 1` in `S`, the element `1` is not both `P(x)` and `Q(y)` with `P`, `Q`
having coefficients in `m`. Geometrically: every point of `P¹` over a base with `m ≤ jacobson ⊥` specializes into
the closed fibre `V(m)` of one of the two charts (used for flatness and unramifiedness away from the closed fibre).
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {R S : Type u} [CommRing R] [CommRing S] (ι : R →+* S) (m : Ideal R)

/-- **Atiyah-Macdonald 5.21's lemma.** -/
theorem not_top_and_top [Nontrivial S] (hm : m ≤ Ideal.jacobson ⊥) (x y : S) (hxy : x * y = 1) (P Q : R[X])
    (hPm : ∀ i, P.coeff i ∈ m) (hQm : ∀ i, Q.coeff i ∈ m) (hP : P.eval₂ ι x = 1) (hQ : Q.eval₂ ι y = 1) :
    False := by
  letI := ι.toAlgebra
  set n := Q.natDegree with hn
  let M : Submodule R S := Submodule.span R ((fun i => x ^ i) '' Set.Iic n)
  have hmem : ∀ i ≤ n, x ^ i ∈ M := fun i hi => Submodule.subset_span ⟨i, hi, rfl⟩
  have hsm : ∀ (r : R) (z : S), ι r * z = r • z := fun _ _ => rfl
  -- `1 - q₀` is a unit
  obtain ⟨w, hw⟩ : ∃ w : R, w * (1 - Q.coeff 0) = 1 := by
    have h := (Ideal.mem_jacobson_bot.1 (hm (hQm 0))) (-1)
    have e : Q.coeff 0 * -1 + 1 = 1 - Q.coeff 0 := by ring
    rw [e] at h
    exact ⟨(h.unit⁻¹ : Rˣ), h.val_inv_mul⟩
  -- `x^(n+1) ∈ M`
  have hrel := pow_mul_eval₂_inv ι x y hxy Q
  rw [hQ, mul_one, Finset.sum_range_succ'] at hrel
  set Z := ∑ j ∈ Finset.range n, ι (Q.coeff (j + 1)) * x ^ (n + 1 - (j + 1)) with hZ
  have hZM : Z ∈ M := by
    refine Submodule.sum_mem _ fun j hj => ?_
    rw [hsm]
    refine Submodule.smul_mem _ _ (hmem _ ?_)
    have := Finset.mem_range.1 hj
    omega
  have htop : x ^ (n + 1) ∈ M := by
    have e1 : ι w * (1 - ι (Q.coeff 0)) = 1 := by rw [← map_one ι, ← map_sub, ← map_mul, hw]
    have e : x ^ (n + 1) = ι w * Z := by
      rw [Nat.sub_zero] at hrel
      linear_combination (ι w) * hrel - x ^ (n + 1) * e1
    rw [e, hsm]
    exact Submodule.smul_mem _ _ hZM
  -- `M` is stable under multiplication by `x`, hence contains all powers and is a subring
  have hxM : ∀ z ∈ M, x * z ∈ M := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, hi, rfl⟩ := hz
      rw [← pow_succ']
      rcases Nat.lt_or_ge i n with h | h
      · exact hmem _ h
      · have : i = n := le_antisymm hi h
        rw [this]
        exact htop
    | zero => rw [mul_zero]; exact M.zero_mem
    | add a b _ _ ha hb => rw [mul_add]; exact M.add_mem ha hb
    | smul r a _ ha => rw [mul_smul_comm]; exact M.smul_mem r ha
  have hpowM : ∀ i, ∀ z ∈ M, x ^ i * z ∈ M := by
    intro i
    induction i with
    | zero => intro z hz; rwa [pow_zero, one_mul]
    | succ i ih => intro z hz; rw [pow_succ', mul_assoc]; exact hxM _ (ih z hz)
  have hpow : ∀ i, x ^ i ∈ M := fun i => by
    have := hpowM i 1 (by simpa using hmem 0 (Nat.zero_le n))
    rwa [mul_one] at this
  have hmul : ∀ z ∈ M, ∀ z' ∈ M, z * z' ∈ M := by
    intro z hz z' hz'
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨i, _, rfl⟩ := hz
      exact hpowM i z' hz'
    | zero => rw [zero_mul]; exact M.zero_mem
    | add a b _ _ ha hb => rw [add_mul]; exact M.add_mem ha hb
    | smul r a _ ha => rw [smul_mul_assoc]; exact M.smul_mem r ha
  -- `1 ∈ m • M`, hence `M ≤ m • M`
  have h1 : (1 : S) ∈ m • M := by
    rw [← hP, eval₂_eq_sum_range]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [hsm]
    exact Submodule.smul_mem_smul (hPm i) (hpow i)
  have hle : M ≤ m • M := by
    intro z hz
    have hz1 : LinearMap.mulLeft R z 1 ∈ (m • M).map (LinearMap.mulLeft R z) := Submodule.mem_map_of_mem h1
    rw [Submodule.map_smul''] at hz1
    have hmap : M.map (LinearMap.mulLeft R z) ≤ M := by
      rintro _ ⟨z', hz', rfl⟩
      exact hmul z hz z' hz'
    have := smul_mono_right m hmap hz1
    rwa [LinearMap.mulLeft_apply, mul_one] at this
  have hfg : M.FG := Submodule.fg_span ((Set.finite_Iic n).image _)
  have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot m M hfg hle hm
  have h0 : (1 : S) ∈ M := by simpa using hmem 0 (Nat.zero_le n)
  rw [hbot, Submodule.mem_bot] at h0
  exact one_ne_zero h0

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovEtL =====
section

/-!
# S4-EtPBC-A, R4-T2 (A2c-5, E4b1): etale on `P¹` from etale near the closed fibre (generic)

* `etK B M`: the ideal of the (closed) non-etale locus of a finitely presented `B`-algebra `M`;
  `etK_of_away` (`M[1/s]` etale gives `s ∈ etK`), `etK_le_iff` (`etK ≤ q` iff `M` is not etale at `q`),
  `etale_of_etK` (`etK = ⊤` gives `M` etale).
* `loc_compat`: along `ψ ∘ β₀ = β ∘ φ` with `φ`, `ψ` away maps at `t`, `β₀ t`, etale-at transports (`loc_etaleAt`).
* **`glob_etale`**: finite covers `βᵢ : Bᵢ → Eᵢ` of the two charts of `P¹_R`, glued over `N`, that are etale on a basic
  open `D(sᵢ)` with `sᵢ ≡ 1 mod m Eᵢ` (`m ≤ jac R`) are etale (`glob` on the non-etale ideals).
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section EtK

end EtK

/-- Etale-at transports along `ψ ∘ β₀ = β ∘ φ` (`φ`, `ψ` away maps). -/
theorem loc_compat {B E N F : Type u} [CommRing B] [CommRing E] [CommRing N] [CommRing F]
    (β₀ : B →+* E) (φ : B →+* N) (β : N →+* F) (ψ : E →+* F) (hc : ψ.comp β₀ = β.comp φ) (t : B)
    (hφ : IsAwayMap φ t) (hu : IsUnit (φ t)) (hψ : IsAwayMap ψ (β₀ t)) (hψu : IsUnit (ψ (β₀ t)))
    (Q : Ideal F) [Q.IsPrime] :
    letI := β₀.toAlgebra
    letI := β.toAlgebra
    Algebra.IsEtaleAt B (Q.comap ψ) ↔ Algebra.IsEtaleAt N Q := by
  letI := β₀.toAlgebra
  letI := β.toAlgebra
  letI := φ.toAlgebra
  letI := ψ.toAlgebra
  letI : Algebra B F := (β.comp φ).toAlgebra
  haveI : IsScalarTower B N F := IsScalarTower.of_algebraMap_eq (R := B) (S := N) (A := F) (fun _ => rfl)
  haveI : IsScalarTower B E F := IsScalarTower.of_algebraMap_eq (R := B) (S := E) (A := F)
    (fun x => (RingHom.congr_fun hc x).symm)
  haveI : IsLocalization.Away t N := isLocalization_of_isAwayMap φ t hφ hu
  haveI : IsLocalization.Away (algebraMap B E t) F := isLocalization_of_isAwayMap ψ (β₀ t) hψ hψu
  exact loc_etaleAt t Q

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs4b =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As4b): presentations of the two charts and of their overlap

* `exists_presN`: if `E` is presented as `Pres g` over `P`, `f : P → P'` is a localization away from `t` with `f t` a
  unit, and `q : E → E'` is a localization away from `t` compatible with `bN : P' → E'`, then `E' ≅ Pres (gmap f g)`
  (via `presN`, bijective by `away_bij`).
* `exists_subst`: a `P`-isomorphism `Pres g ≅ Pres g'` is `presIso` of substitution data `u v` (with all four
  membership witnesses).
* `chart_pres`: a finite etale `b : P → E` is presented by a square system with etale and finite witnesses.
* **`two_chart_pres`**: the two charts `E₀, E₁` of a cover glued along `E`, their base changes to the overlap and
  substitution data between the two overlap presentations, all in one package.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section PresN

variable {P P' E' : Type u} [CommRing P] [CommRing P'] [CommRing E'] {r : ℕ}
  (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) (bN : P' →+* E') (θ : Pres g →+* E')

theorem presN_hz (hθ : θ.comp (algebraMap P (Pres g)) = bN.comp f) (j : Fin r) :
    MvPolynomial.eval₂ bN (fun i => θ (Ideal.Quotient.mk _ (MvPolynomial.X i))) (gmap f g j) = 0 := by
  rw [eval₂_gmap, ← hθ, pres_eval_self, presRel_zero g j, map_zero]

/-- The map `Pres (gmap f g) → E'` determined by `θ : Pres g → E'` and `bN` on coefficients. -/
def presN (hθ : θ.comp (algebraMap P (Pres g)) = bN.comp f) : Pres (gmap f g) →+* E' :=
  presLift (gmap f g) bN (fun i => θ (Ideal.Quotient.mk _ (MvPolynomial.X i))) (presN_hz f g bN θ hθ)

end PresN

section Subst

end Subst

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_CovAs6c =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3 assembly, As6c): residue maps of the approximated overlap, generic identities

* `resid_mk_map`: `resid` on the class of `map f' w` is `θh` on the class of `map fh w`.
* `comp_presMap_X`: from `θ' ∘ presMap f' = θh ∘ presMap fh`, the values on the variables agree.
* `kap_comp_tsC`: the coefficient hypothesis of `resid` for `fh = tvC B C`, `f' = tsC σ B`, `κ' = kap`.
* `phib_K`, `fib_coeff`: the fibre gluing maps are `K`-linear, and the coefficient identity of `ctheta0`/`ctheta1`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open TensorProduct

universe u

section ResidMap

end ResidMap

section CompX

end CompX

section Kap

variable {K A S R' B : Type u} [Field K] [CommRing A] [CommRing S] [Algebra A S] [CommRing R'] [Algebra A R']
  [CommRing B] [Algebra A B] {Q : Type u} [CommRing Q] (χ : A →+* K) (ν : K →+* Q) (βQ : B →+* Q)
  (hβ : ∀ a, βQ (algebraMap A B a) = ν (χ a))

theorem kap_comp_tsC {C : Subalgebra A S} (σ : C →ₐ[A] R') (χ' : R' →+* K)
    (hχ' : ∀ a, χ' (algebraMap A R' a) = χ a) (res : S →+* K) (hσ : ∀ c, χ' (σ c) = res (c : S))
    (κh : S ⊗[A] B →+* Q) (hκh : ∀ (x : S) (b : B), κh (x ⊗ₜ b) = ν (res x) * βQ b) :
    (kap χ ν βQ hβ χ' hχ').comp (tsC σ B) = κh.comp (tvC B C) := by
  refine RingHom.ext fun x => ?_
  induction x using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | tmul c b =>
    change kap χ ν βQ hβ χ' hχ' (σ c ⊗ₜ b) = κh ((c : S) ⊗ₜ b)
    rw [kap_tmul, hκh, hσ]
  | add x y hx hy => rw [map_add, map_add, hx, hy]

end Kap

section Fib

variable {K A R' B N : Type u} [Field K] [CommRing A] [CommRing R'] [Algebra A R'] [CommRing B] [Algebra A B]
  [CommRing N] [Algebra A N] {F F' : Type u} [CommRing F] [CommRing F'] [Algebra K F] [Algebra K F']

theorem fib_coeff {G G' : Type u} [CommRing G] [CommRing G'] [Algebra F G] [Algebra F' G'] (χ' : R' →+* K)
    (φ : B →ₐ[A] N) (β : B →+* F) (β' : N →+* F') (φb : F →+* F') (p : G →+* G')
    (hp : ∀ y, p (algebraMap F G y) = algebraMap F' G' (φb y)) (hρ : ∀ b, φb (β b) = β' (φ b))
    (hK : ∀ k, φb (algebraMap K F k) = algebraMap K F' k) (θ : R' ⊗[A] B →+* G)
    (hθ : ∀ (r : R') (b : B), θ (r ⊗ₜ b) = algebraMap F G (algebraMap K F (χ' r) * β b))
    (κ : R' ⊗[A] N →+* G') (hκ : ∀ (r : R') (n : N), κ (r ⊗ₜ n) = algebraMap F' G' (algebraMap K F' (χ' r) * β' n))
    (x : R' ⊗[A] B) : p (θ x) = κ (bcS R' φ x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp only [map_zero]
  | tmul r b => rw [hθ, bc_tmul, hκ, hp, map_mul φb, hK, hρ]
  | add x y hx hy => rw [map_add, map_add, map_add, map_add, hx, hy]

end Fib

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_Z3Chart =====
section

/-!
# S4-EtPBC-A, (Z) geometric layer 6 (G-b): the charts of `P¹_V = P¹_K ×_K V` are generated by one coordinate

* `PV K gV = P¹_K ×_K V`, `pr`, `qV`; charts `Qc i = pr⁻¹ D₊(Xᵢ)`, coordinates `tc i j = pr^* (Xⱼ/Xᵢ)`,
  structure maps `ac i : Γ(V) → Γ(P_V, Qᵢ)`.
* `Wc i = P_V ×_{P¹} Spec K[X₀,X₁]_(Xᵢ)`, `jW i` (open immersion with image `Qᵢ`: `image_jW`), `isPullback_W`,
  `isPushout_W` (`V` affine: `Γ(Wᵢ) = K[X₀,X₁]_(Xᵢ) ⊗_K Γ(V)` as a pushout).
* **`surj_chart`**: `Γ(V)[X] → Γ(P_V, Qᵢ)`, `X ↦ tc i j`, is surjective (`V` affine, `i ≠ j`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite TopologicalSpace MvPolynomial HomogeneousLocalization
open RamanujanPetersson.EtCompact

attribute [local instance] MvPolynomial.gradedAlgebra

noncomputable section

namespace RamanujanPetersson.EtPBC.Z3

universe u

section Bundle

variable (K : Type u) [Field K] {V : Scheme.{u}} (gV : V ⟶ Spec (CommRingCat.of K))

/-- `P¹_V = P¹_K ×_K V`. -/
abbrev PV : Scheme.{u} := pullback (P1.toSpecK K) gV

/-- `P¹_V ⟶ P¹_K`. -/
abbrev pr : PV K gV ⟶ P1 K := pullback.fst (P1.toSpecK K) gV

/-- `P¹_V ⟶ V`. -/
abbrev qV : PV K gV ⟶ V := pullback.snd (P1.toSpecK K) gV

/-- The chart `Qᵢ = pr⁻¹ D₊(Xᵢ)` of `P¹_V`. -/
abbrev Qc (i : Fin 2) : (PV K gV).Opens := pr K gV ⁻¹ᵁ chU K i

/-- The chart coordinate `Xⱼ/Xᵢ` on `Qᵢ`. -/
abbrev tc (i j : Fin 2) : Γ(PV K gV, Qc K gV i) := (pr K gV).app (chU K i) (coord K i j)

/-- The structure map `Γ(V) → Γ(P_V, Qᵢ)`. -/
abbrev ac (i : Fin 2) : Γ(V, ⊤) ⟶ Γ(PV K gV, Qc K gV i) := (qV K gV).appLE ⊤ (Qc K gV i)
  (le_top.trans (Scheme.Hom.preimage_top _).ge)

/-- `Wᵢ = P_V ×_{P¹} Spec K[X₀,X₁]_(Xᵢ)`. -/
abbrev Wc (i : Fin 2) : Scheme.{u} := pullback (pr K gV) (ch K i)

/-- `Wᵢ ⟶ P_V` (an open immersion onto `Qᵢ`). -/
abbrev jW (i : Fin 2) : Wc K gV i ⟶ PV K gV := pullback.fst (pr K gV) (ch K i)

theorem image_jW (i : Fin 2) : jW K gV i ''ᵁ ⊤ = Qc K gV i := by
  rw [Scheme.Hom.image_top_eq_opensRange, Scheme.Hom.opensRange_pullbackFst,
    ← Scheme.Hom.image_top_eq_opensRange]

theorem top_le_jW (i : Fin 2) : (⊤ : (Wc K gV i).Opens) ≤ jW K gV i ⁻¹ᵁ Qc K gV i := by
  have h := (Scheme.Hom.preimage_image_eq (jW K gV i) ⊤).ge
  rwa [image_jW] at h

theorem isPullback_W (i : Fin 2) :
    IsPullback (pullback.snd (pr K gV) (ch K i)) (jW K gV i ≫ qV K gV) (ch K i ≫ P1.toSpecK K) gV :=
  (IsPullback.of_hasPullback (pr K gV) (ch K i)).flip.paste_vert (IsPullback.of_hasPullback (P1.toSpecK K) gV)

theorem isPushout_W [IsAffine V] (i : Fin 2) :
    IsPushout (ch K i ≫ P1.toSpecK K).appTop gV.appTop (pullback.snd (pr K gV) (ch K i)).appTop
      (jW K gV i ≫ qV K gV).appTop :=
  isPushout_appTop_of_isPullback (isPullback_W K gV i)

theorem ch_toSpecK (i : Fin 2) : ch K i ≫ P1.toSpecK K =
    Spec.map (CommRingCat.ofHom
      ((fromZeroRingHom (gr K) (Submonoid.powers (X i))).comp (algebraMap K (gr K 0)))) := by
  rw [P1.toSpecK, ← Category.assoc, ch, Proj.awayι_toSpecZero, ← Spec.map_comp]
  rfl

end Bundle

end RamanujanPetersson.EtPBC.Z3

