section Slp

variable {F : Type} [Field F]

/-- The value produced by one SLP instruction on the current list of values. -/
def opVal (vals : List F) (o : Bool × ℕ × ℕ) : F :=
  if o.1 then vals.getD o.2.1 0 * vals.getD o.2.2 0
  else vals.getD o.2.1 0 + vals.getD o.2.2 0

/-- The list of instructions after `n` rounds of the update chain, and the position of the last
computed odd power `a^{2n+1}`. -/
def slpAux (t : ℕ) : ℕ → List (Bool × ℕ × ℕ) × ℕ
  | 0 => ([(true, 0, 0)], 0)
  | n + 1 =>
      let p := slpAux t n
      (p.1 ++ [(false, n + 1, p.2), (true, t + 1, p.2)], t + 3 + 2 * n)

/-- The instruction list of the first `n` rounds. -/
def opN (t n : ℕ) : List (Bool × ℕ × ℕ) := (slpAux t n).1

/-- The index of `a^{2n+1}` in the value list after `n` rounds. -/
def pwN (t n : ℕ) : ℕ := (slpAux t n).2

/-- The invariant maintained by the chain: the running list has the right length, its input part is
unchanged, it holds `a²` and `a^{2n+1}`, and all earlier outputs are correct. -/
def SlpInv (t : ℕ) (a : F) (s : Fin t → F) (n : ℕ) (vals : List F) : Prop :=
  vals.length = t + 2 + 2 * n ∧
  (∀ m : Fin t, vals.getD ((m : ℕ) + 1) 0 = s m) ∧
  vals.getD (t + 1) 0 = a ^ 2 ∧
  vals.getD (pwN t n) 0 = a ^ (2 * n + 1) ∧
  (∀ j : Fin t, (j : ℕ) < n →
    vals.getD (t + 2 + 2 * (j : ℕ)) 0 = s j + a ^ (2 * (j : ℕ) + 1))

end Slp

