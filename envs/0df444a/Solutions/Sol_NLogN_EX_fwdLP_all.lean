    (NLogN.EX.fwdLP fw).run s = s.upd NLogN.GL.gD (NLogN.gints (fwdL q U) ++ R) ∧
    (NLogN.EX.fwdLP fw).ok M s ∧
    (NLogN.EX.fwdLP fw).cost M s ≤ NLogN.EX.fwdLCost q CS CB Bx CW Q Φm ∧
    (fwdL q U).length = q.S ∧ NLogN.GL.GB (BB q.K) (fwdL q U) := by
  obtain ⟨RS0, hS⟩ := hE.xs
  obtain ⟨LM, hPM⟩ := hE.pm
  obtain ⟨r1, o1, c1, l1, b1⟩ := NLogN.EX.sPhase_all M q kb mm Φ Bacc Qa Bq Bx CS BS hcfg.hM hcfg.hsl
    hcfg.hst hcfg.hBx hcfg.sax hcfg.cS U s R RS0 LM hE.glob hU hin.len hin.b hS hPM
  set X := NLogN.GL.fwdX q U with hX
  set s1 := s.upd NLogN.GL.gD (NLogN.gints X ++ R) with hs1
  have E1 := hE.updW fw hfw NLogN.GL.gD (Or.inl rfl) (NLogN.gints X ++ R)
  obtain ⟨RC, hRC⟩ := E1.ch
  obtain ⟨LN, hN⟩ := E1.pn
  obtain ⟨LT, hT⟩ := E1.pt
  obtain ⟨LP, hP⟩ := E1.pp
  obtain ⟨r2, o2, c2⟩ := NLogN.GL.ftlP_all fw hfw hMm s1 E1.ctx X R RC LN LT LP (NLogN.EX.TT q) Q (by simp [hs1])
    hRC l1 hcfg.chl hN hT hP (b1.mono hcfg.Sm) hcfg.chb hin.pre hin.wl hin.wb hin.cb hcfg.mQ
    hcfg.k hcfg.NQ
  rw [hs1, NLogN.IState.upd_upd_same] at r2
  have E2 := hE.updW fw hfw NLogN.GL.gD (Or.inl rfl) (NLogN.gints (FtL q X) ++ R)
  obtain ⟨RS2, hS2⟩ := E2.xs
  obtain ⟨LN2, hN2⟩ := E2.pn
  obtain ⟨r3, o3, c3, l3, b3⟩ := NLogN.EX.bPhase_all M q kb mm Φ Bacc Qa Bq Bx CB BB hcfg.hM hcfg.hsl
    hcfg.hst hcfg.hα hcfg.hBx hcfg.bax hcfg.cB (FtL q X) _ R RS2 LN2 E2.glob (by simp)
    (NLogN.GL.FtL_length q X (NLogN.EX.TT q) hcfg.chl hin.wl) hin.yb hS2 hN2
  rw [← NLogN.GL.fwdL_eq, NLogN.IState.upd_upd_same] at r3
  rw [← NLogN.GL.fwdL_eq] at l3 b3
  have A := NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r1, o1, c1⟩
    (NLogN.GL.seq_all (M := M) _ _ _ _ _ _ _ ⟨r2, o2, c2⟩ ⟨r3, o3, c3⟩)
  refine ⟨A.1, A.2.1, ?_, l3, b3⟩
  have := A.2.2
  unfold NLogN.EX.fwdLCost
  calc _ ≤ _ := this
    _ ≤ _ := by omega
end
