/-! ### The 3-form `H = dF` in the frame -/

theorem fdir_FfrF (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    {x : Pt 4} (hx : x ∈ U) (A B C : Fin 4) :
    fdir E A (FfrF F E B C) x
      = ∑ μ, ∑ ν, ∑ l, E A μ x * (pd μ (F ν l) x : ℂ) * E B ν x * E C l x
        + ∑ ν, ∑ l, (F ν l x : ℂ) * fdir E A (E B ν) x * E C l x
        + ∑ ν, ∑ l, (F ν l x : ℂ) * E B ν x * fdir E A (E C l) x := by
  have hU := hF.isOpen
  have hfun : FfrF F E B C = fun z => ∑ ν, ∑ l, (F ν l z : ℂ) * E B ν z * E C l z := by
    funext z; simp only [FfrF, ccontr, fvec]
  have hd : ∀ μ, cpdC μ (FfrF F E B C) x = ∑ ν, ∑ l, ((pd μ (F ν l) x : ℂ) * E B ν x * E C l x
      + (F ν l x : ℂ) * cpdC μ (E B ν) x * E C l x + (F ν l x : ℂ) * E B ν x * cpdC μ (E C l) x) := by
    intro μ
    rw [hfun, cpdC_sum_of hU hx μ Finset.univ fun ν _ => ContDiffOn.sum fun l _ =>
      ((contDiffOn_ofReal (hFs ν l)).mul (hF.smooth_E B ν)).mul (hF.smooth_E C l)]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [cpdC_sum_of hU hx μ Finset.univ fun l _ =>
      ((contDiffOn_ofReal (hFs ν l)).mul (hF.smooth_E B ν)).mul (hF.smooth_E C l)]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [cpdC_mul_of hU hx μ ((contDiffOn_ofReal (hFs ν l)).mul (hF.smooth_E B ν)) (hF.smooth_E C l),
      cpdC_mul_of hU hx μ (contDiffOn_ofReal (hFs ν l)) (hF.smooth_E B ν), cpdC_ofReal]
    ring
  simp only [fdir, hd, Fin.sum_univ_four]
  ring

theorem sum_cfr_FfrF (hF : FrameData g gi E Θ U) (F : TwoForm 4) {x : Pt 4} (hx : x ∈ U) (A B C : Fin 4) :
    ∑ K, cfr E Θ K A B x * FfrF F E K C x = ∑ ν, ∑ l, (F ν l x : ℂ) * brk E A B ν x * E C l x := by
  simp only [FfrF, ccontr, fvec, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun ν _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun l _ => ?_
  rw [← hF.sum_coeff hx (fun ρ => brk E A B ρ x) ν, Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun K _ => ?_
  unfold cfr
  ring

