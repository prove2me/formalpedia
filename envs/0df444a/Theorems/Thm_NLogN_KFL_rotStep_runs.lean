    (hd0 : 0 < d0) (hd1 : 0 < d1) (hQe : Q = 2 ^ (f * K)) (l : Line) (hs : l.sgn = 1 ∨ l.sgn = -1)
    (hb : l.b = 0 ∨ l.b = 1) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * 2 ^ (f * K) < 2 ^ Bb)
    (zd0 : zsz (d0 : ℤ) ≤ Bb) (zd1 : zsz (d1 : ℤ) ≤ Bb)
    (P B w : ℕ) (zP : zsz (P : ℤ) ≤ Bb) (zB : zsz (B : ℤ) ≤ Bb)
    (t : IState HS) (xs : List ℤ) (R : List Item) (hlen : xs.length = P * Q * B) (hbw : Bnd w xs)
    (h0 : t.G 0 = ints xs ++ R) :
    IRuns I iprog (NLogN.KFL.rotStep K ρ f d0 d1 Q P B l.sgn l.b) t
      (t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (KIL.rotAddr Q (tabA K ρ f d0 d1 Q l)) 0 xs) ++ R))
