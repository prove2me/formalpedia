section Lattice

variable (W : Type*) [Fintype W]

private abbrev supLattice : Submodule ℤ (W → ℝ) := Submodule.span ℤ (Set.range (Pi.basisFun ℝ W))

private theorem finrank_supLattice : Module.finrank ℤ (supLattice W) = Fintype.card W := by
  rw [ZLattice.rank ℝ, Module.finrank_fintype_fun_eq_card]

private def latticeConst (k : ℕ) : ℝ := ∑' x : supLattice W, ‖x‖⁻¹ ^ k

private theorem summable_inv_norm_pow_supLattice {k : ℕ} (hk : Fintype.card W < k) :
    Summable fun x : supLattice W => ‖x‖⁻¹ ^ k :=
  ZLattice.summable_norm_pow_inv _ k (by rwa [finrank_supLattice])

private theorem latticeConst_nonneg (k : ℕ) : 0 ≤ latticeConst W k :=
  tsum_nonneg fun _ => by positivity

private theorem intCast_mem_supLattice (z : W → ℤ) : (fun w => (z w : ℝ)) ∈ supLattice W := by
  rw [Basis.mem_span_iff_repr_mem]
  intro w
  exact ⟨z w, by simp⟩

end Lattice
