                                                                                                                                  | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil,
                                                                                                                                          List.sum_cons, List.sum_nil, ])
                                                                                                                                      (first
                                                                                                                                        | omega
                                                                                                                                        | ((ring_nf); (omega))))
                                                                                                                                  | omega
                                                                                                                                  |
                                                                                                                                    (simp [] <;>
                                                                                                                                        first
                                                                                                                                        | omega
                                                                                                                                        | ((ring_nf); (omega)))))
  · replace hc : t % X.chunkCount + 1 ≠ X.chunkCount := fun h => hc (by simp; exact_mod_cast h)
    rw [if_neg hc] at hsucc
    rw [hsucc]
    exact Ends.skip rfl

/-- **One round of the loop.** -/
theorem oRound_spec (C : OCtx P₀ R pS pWriteX pWriteY pScat Tn need)
    (S : OSetting lim d X U A need cnt μ₀) (ht : t < X.m) {σ : State}
    (hσ : OInv X A cnt μ₀ t σ) :
    Ends lim (P₀ ++ R) d (oRound pS pWriteX pWriteY pScat) σ (tORound Tn X)
      (OInv X A cnt μ₀ (t + 1)) := by
  obtain ⟨len, rho, lo, w, res, μ, rfl, hM⟩ := hσ
  have SH := S.host hM.1
  have hv := S.ok.valid
  have hT : tOCalls Tn X t + 57 ≤ tORound Tn X := by
    have h1 : tWriteX X.n X.D (X.len t) ≤ tWriteX X.n X.D X.q := by
      unfold tWriteX; have := X.len_le t; gcongr
    have h2 : tWriteY X.n X.D (X.len t) ≤ tWriteY X.n X.D X.q := by
      unfold tWriteY; have := X.len_le t; gcongr
    have h3 := le_oSupTime Tn X.n X.D (X.w_le_cap ht)
    have h4 : tOScatter (X.w t) ≤ tOScatter X.cap := by
      unfold tOScatter; have := X.w_le_cap ht; omega
    unfold tOCalls tORound
    omega
  unfold oRound
  -- the parameters of the instance
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (hostParams_spec SH ht _ len rho lo w res) ?_ ?_
       | refine Light.Ends.pieceLast (hostParams_spec SH ht _ len rho lo w res) ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro _ rfl))
  -- the four calls
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (oCalls_spec C S ht hM _ res) ?_ ?_
       | refine Light.Ends.pieceLast (oCalls_spec C S ht hM _ res) ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 =>
         rintro _
           ⟨res', μ', rfl, hM'⟩
               -- the place of the next counts
               ))
  -- the place of the next counts
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (oBase_spec S ht _ _ _ _ res' μ') ?_ ?_
       | refine Light.Ends.pieceLast (oBase_spec S ht _ _ _ _ res' μ') ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro _ rfl))
  -- the counters
  have SH' := S.host hM'.1
  (focus
     (repeat
         with_unfolding_none
           first
           | refine Light.Ends.seqAssoc ?_
           | refine Light.Ends.skipThen ?_)
     (first
       | refine Light.Ends.pieceThen (hostNext_spec SH' ht _ _ _ _ _ res') ?_ ?_
       | refine Light.Ends.pieceLast (hostNext_spec SH' ht _ _ _ _ _ res') ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 => rintro _ rfl))
  exact ⟨_, _, _, _, _, μ', rfl, hM'⟩

/-- **The loop over the instances**: every one of the `h n²` cells from `cnt` holds the count of its
candidate, and no other cell below `x` has changed. -/
theorem oLoop_spec (C : OCtx P₀ R pS pWriteX pWriteY pScat Tn need)
    (S : OSetting lim d X U A need cnt μ₀) :
    Ends lim (P₀ ++ R) d (oLoopBody pS pWriteX pWriteY pScat) ⟨Light.frame (oLoopArgs X A cnt), μ₀⟩
      (tOLoop Tn X) fun σ' => (∀ e < oLen X, σ'.mem (cnt + e) = oCnt X e) ∧
        SameOn (fun a => a < A.x ∧ Outside cnt (oLen X) a) μ₀ σ'.mem := by
  have hw := S.fits.space
  have hcount := S.fits.count
  have hv := S.ok.valid
  unfold oLoopBody tOLoop oLoopArgs hostLoopArgs
  -- t := 0; ch := 0; c0 := 0
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (refine Light.Ends.setToThen (0 : ℕ) ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (try with_unfolding_none refine Light.Ends.skip ?_))
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (refine Light.Ends.setToThen (0 : ℕ) ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (try with_unfolding_none refine Light.Ends.skip ?_))
  (focus
     ((first
         | refine Light.Ends.seqSelf ?_
         | refine Light.Ends.skipLast ?_);
       (repeat
           with_unfolding_none
             first
             | refine Light.Ends.seqAssoc ?_
             | refine Light.Ends.skipThen ?_))
     (refine
         Light.Ends.setToThen
           (0 : ℕ)
             -- while t < m
             
           ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
         |
           (simp [] <;>
               first
               | omega
               | ((ring_nf); (omega))))
     (on_goal -1 =>
         ( (try have := Light.Std.space_le (by assumption))
           (try have := Light.Std.const_le (by assumption))
           (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)))
     (try with_unfolding_none refine Light.Ends.skip ?_))
  -- while t < m
  refine (Ends.whileConst (OInv X A cnt μ₀) X.m (tORound Tn X) ?start ?round ?done le_rfl).mono
    (by simp only [Cond.cost, Expr.cost, Nat.reduceAdd]; omega) fun _ h => h
  case start =>
    refine ⟨0, 0, 0, 0, 0, μ₀, ?_, fun _ _ => rfl, fun e _ ⟨t', ht', _⟩ => absurd ht' (by omega)⟩
    rw [hostState, ← frame_append_zeros _ 5]
    simp [HostData.c0, oBaseAt]
  case round =>
    intro t σ ht hσ
    obtain ⟨len, rho, lo, w, res, μ', rfl, -⟩ := id hσ
    exact ⟨⟨trivial, trivial⟩, by simpa using ht, oRound_spec C S ht hσ⟩
  case done =>
    rintro _ ⟨len, rho, lo, w, res, μ', rfl, hM⟩
    refine ⟨⟨trivial, trivial⟩, by simp, fun e he => hM.2 e he ?_, hM.1⟩
    obtain ⟨t, ht, i, hi, rfl⟩ := oCover hv he
    exact ⟨t, ht, i, hi, rfl⟩

end Light.Filter
end
end

