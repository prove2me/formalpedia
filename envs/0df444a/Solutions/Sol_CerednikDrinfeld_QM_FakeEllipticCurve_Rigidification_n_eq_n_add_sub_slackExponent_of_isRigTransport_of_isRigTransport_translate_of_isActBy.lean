    (hβ₀'β₀ : β₀'.comp β₀ = Φ.act ((r : Zp2 r) ^ Nβ)) (hβ₀β₀' : β₀.comp β₀' = (X₀.map κ).act ((r : Zp2 r) ^ Nβ))
    (hEXE₀ : ∀ εX : ↥(Subring.centralizer (Set.range X₀.actEnd ∪ {X₀.varpiEnd})),
        ∃ eΦ : ↥(Subring.centralizer (Set.range Φ.actEnd ∪ {Φ.varpiEnd})),
