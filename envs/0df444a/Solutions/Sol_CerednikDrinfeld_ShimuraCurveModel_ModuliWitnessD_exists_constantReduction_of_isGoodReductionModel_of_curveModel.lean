  haveI := hgi₀

  have hℓ0 : ((ℓ : ℕ) : O₀) ≠ 0 := by
    intro h
    have := congrArg i₀ h
    rw [map_natCast, map_zero] at this
    exact (Nat.cast_ne_zero.mpr hℓ.ne_zero) this
  have hℓnu : ¬ IsUnit (j (ℓ : O₀)) := by
    have hmem : (j (ℓ : O₀) : AlgebraicClosure ℚ) ∈ 𝔅.nonunits := by
