theorem FSp.sel {r : Fin HS} (hr5 : r.val < 56) (br : ℕ → RS) {s t : IState HS} {v : ℕ}
    {L : List Item} (hrv : s.G r = .int v :: L) {Bb cv : ℕ} (hb : FSp (br v) s t cv)
    (hz : ∀ x : ℕ, x ≤ v + 1 → zsz (x : ℤ) ≤ Bb) :
    ∀ m k, k ≤ v → v < k + m → FSp (sel r br k m) s t (m * cSel Bb + cv)
  | 0, k, h1, h2 => absurd h2 (by omega)
  | 1, k, h1, h2 => by
    obtain rfl : k = v := by omega
    exact hb.mono (by omega)
  | m + 2, k, h1, h2 => by
    have hc : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).Clean :=
      clean_add_r6c (clean_reg_r6c hr5) (clean_lit_r6c _)
    have ho : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).ok s := ⟨IState.isInt_of_r6c hrv, trivial⟩
    have hev : (Ex.add (.reg r) (.lit (-((k : ℤ) + 1)))).eval s = (v : ℤ) - (k + 1) := by
