theorem qcQL : l.QC ≤ l.QL := by rw [hV.qc, hV.ql]; exact hV.hCL

theorem zl {v : ℤ} (h : |v| ≤ 3 * (M : ℤ)) : zsz v ≤ Bb := by
  have : ((8 * M : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hV.hbig
  push_cast at this
