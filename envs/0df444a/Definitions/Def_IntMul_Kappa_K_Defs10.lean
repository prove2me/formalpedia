-- Source module: Solutions.KILMove
/-!
# Paper Lemma 3 (field move), forward direction: `[P, q, M, B] → [P, M, q, B]`

`fwdP` reads the array `inp r P q M` (records `r p y m` of length `B`, order `(p, y, m)`) from
stack `0` and leaves `outF r P q M` (order `(p, m, y)`), with `P, q, M, B` on stacks `1 … 4`.
Per block `p` it zips the rows `y = 0, …, q-1` one at a time into an accumulator of `M`
groups (stacks `10`, `11`), so the cost is `O(q · V)` item moves.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

namespace KIL

open IntMul RS

/-! ## The program -/

def fBody : RS := .seq (NLogN.mvK 10 11 33 (.reg 6)) (NLogN.mvK 0 11 33 (.reg 4))

def fStep : RS :=
  .seq (.rep 32 (.reg 3) fBody) (.seq (.asg 6 (.add (.reg 6) (.reg 4)))
    (.seq (.asg 7 (.add (.reg 7) (.reg 5))) (NLogN.mvK 11 10 33 (.reg 7))))

def fBlock : RS :=
  .seq (.rep 31 (.reg 2) fStep) (.seq (NLogN.mvK 10 12 33 (.reg 7))
    (.seq (.asg 6 (.lit 0)) (.asg 7 (.lit 0))))

def fwdP : RS :=
  .seq (.push 5 (.mul (.reg 3) (.reg 4))) (.seq (.push 8 (.mul (.reg 1) (.mul (.reg 2) (.reg 5))))
    (.seq (.push 6 (.lit 0)) (.seq (.push 7 (.lit 0)) (.seq (.rep 30 (.reg 1) fBlock)
      (.seq (NLogN.mvK 12 0 33 (.reg 8)) (.seq (.pop 7) (.seq (.pop 6) (.seq (.pop 8) (.pop 5)))))))))

/-! ## Lists describing the intermediate states -/

section Lists
variable (r : ℕ → ℕ → ℕ → List ℤ)

/-- Rest of row `k` of block `p`, from column `m0`. -/
def rowR (p k m0 M : ℕ) : List ℤ := (List.range' m0 (M - m0)).flatMap (r p k)
/-- Group `m` of the accumulator after `k` rows. -/
def grp (p k m : ℕ) : List ℤ := (List.range k).flatMap fun y => r p y m
/-- Accumulator groups from `m0` on. -/
def Tp (p k m0 M : ℕ) : List ℤ := (List.range' m0 (M - m0)).flatMap (grp r p k)
/-- Reversed new accumulator groups `< m0`. -/
def Cp (p k m0 : ℕ) : List ℤ := ((List.range m0).flatMap (grp r p (k + 1))).reverse
/-- Rows `k, …, q-1` of block `p`. -/
def rowsR (p k q M : ℕ) : List ℤ := (List.range' k (q - k)).flatMap fun y =>
  (List.range M).flatMap (r p y)
/-- Blocks `p, …, P-1`. -/
def blksR (p P q M : ℕ) : List ℤ := (List.range' p (P - p)).flatMap (blkIn r q M)
/-- Reversed output of blocks `< p`. -/
def Ob (q M p : ℕ) : List ℤ := ((List.range p).flatMap (blkOut r q M)).reverse

end Lists

/-! ## States -/

/-- The managed state of `fwdP` inside the main loop. -/
def St (P q M B : ℕ) (x a c o : List ℤ) (u z : ℤ) (k0 k1 k2 : List ℤ) : KS :=
  { x := x, P := [(P : ℤ)], q := [(q : ℤ)], M := [(M : ℤ)], B := [(B : ℤ)],
    MB := [(M : ℤ) * B], V := [(P : ℤ) * ((q : ℤ) * ((M : ℤ) * B))], u := [u], z := [z],
    a := a, c := c, o := o, k0 := k0, k1 := k1, k2 := k2 }

section Proof

variable (s : IState HS) (r : ℕ → ℕ → ℕ → List ℤ) (P q M B Bb : ℕ)

/-- Inner loop state: column `m` of step `k` of block `p`. -/
def innSt (p k m : ℕ) (k2 : List ℤ) : KS :=
  St P q M B (rowR r p k m M ++ (rowsR r p (k + 1) q M ++ blksR r (p + 1) P q M))
    (Tp r p k m M) (Cp r p k m) (Ob r q M p) ((k * B : ℕ) : ℤ) ((k * (M * B) : ℕ) : ℤ)
    [(P : ℤ) - p] [(q : ℤ) - k] k2

/-- State before step `k` of block `p`. -/
def stepSt (p k : ℕ) (k1 : List ℤ) : KS :=
  St P q M B (rowsR r p k q M ++ blksR r (p + 1) P q M) (Tp r p k 0 M) [] (Ob r q M p)
    ((k * B : ℕ) : ℤ) ((k * (M * B) : ℕ) : ℤ) [(P : ℤ) - p] k1 []

/-- Cost bound of one step. -/
def cStep (q M B Bb : ℕ) : ℕ :=
  2 * 2000 * (Bb + 2) + M * (2 * (2 * 2000 * (Bb + 2) + 32) + (q * B) * (14000 * (Bb + 2)) +
    8000 * (Bb + 2) + 30) + 32 + 2 * (4 * 2000 * (Bb + 2)) +
    (2 * 2000 * (Bb + 2) + q * (M * B) * (14000 * (Bb + 2)) + 32)

/-- Cost bound of one block. -/
def cBlk (q M B Bb : ℕ) : ℕ :=
  (1 + 1) * 2000 * (Bb + 2) + q * (NLogN.KIL.cStep q M B Bb + 8000 * (Bb + 2) + 30) + 32 +
    ((1 + 1) * 2000 * (Bb + 2) + q * (M * B) * (14000 * (Bb + 2)) + 32 +
      ((1 + 1) * 2000 * (Bb + 2) + (1 + 1) * 2000 * (Bb + 2)))

/-- State at the start of block `p`. -/
def blkSt (p : ℕ) (k0 : List ℤ) : KS :=
  St P q M B (blksR r p P q M) [] [] (Ob r q M p) 0 0 k0 [] []

/-- Cost bound of the whole forward move. -/
def cFwd (P q M B Bb : ℕ) : ℕ :=
  (3 + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + (5 + 1) * 10 ^ 7 * (Bb + 2) ^ 2 + (1 + 1) * 2000 * (Bb + 2) +
    (1 + 1) * 2000 * (Bb + 2) +
    ((1 + 1) * 2000 * (Bb + 2) + P * (NLogN.KIL.cBlk q M B Bb + 8000 * (Bb + 2) + 30) + 32) +
    ((1 + 1) * 2000 * (Bb + 2) + P * (q * (M * B)) * (14000 * (Bb + 2)) + 32) +
    4 * (2 * Bb + 2)

/-- The input record of `fwdP`: the array on `0`, `P, q, M, B` on `1 … 4`. -/
def fIn (x : List ℤ) (P q M B : ℕ) : KS :=
  { x := x, P := [(P : ℤ)], q := [(q : ℤ)], M := [(M : ℤ)], B := [(B : ℤ)] }

/-- Prologue states of `fwdP`. -/
def pre (x : List ℤ) (P q M B : ℕ) (V u z : List ℤ) : KS :=
  { x := x, P := [(P : ℤ)], q := [(q : ℤ)], M := [(M : ℤ)], B := [(B : ℤ)], MB := [(M : ℤ) * B],
    V := V, u := u, z := z }

end Proof

end KIL

end NLogN

