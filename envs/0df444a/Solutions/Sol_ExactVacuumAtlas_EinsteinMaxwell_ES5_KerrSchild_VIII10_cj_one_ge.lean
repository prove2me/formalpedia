open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII09

/-! ## The constant reference source -/

/-- The comparison source `q ≡ -5/384` is `C¹` on the compact window. -/
theorem contDiffOn_const_neg : ContDiffOn ℝ 1 (fun _ : ℝ => (-5 / 384 : ℝ)) UG :=
  contDiffOn_const

/-- Its sharp magnitude bound. -/
theorem abs_const_neg_le : ∀ x ∈ KG, |(-5 / 384 : ℝ)| ≤ 5 / 384 := by
  intro x _
  rw [abs_of_neg (by norm_num)]
  norm_num

/-- **The exact constant-source response**: `bfun 0 (const (-5/384)) R = 5/(3072 R)`. -/
theorem bfun_const_neg {R : ℝ} (hR : 3 < R) :
    bfun 0 (fun _ : ℝ => (-5 / 384 : ℝ)) R = 5 / (3072 * R) := by
  have h := bfun_const_mul (c := (-5 / 384 : ℝ)) (j := (0:ℝ)) (q := fun _ : ℝ => (1:ℝ))
    continuousOn_const hR
  rw [mul_zero,
    show (fun y : ℝ => (-5 / 384 : ℝ) * (fun _ : ℝ => (1:ℝ)) y)
      = (fun _ : ℝ => (-5 / 384 : ℝ)) from by funext y; ring] at h
  rw [h, bfun_one_eq R hR]
  field_simp
  ring

