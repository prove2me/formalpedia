  {Hs : Type} [NormedAddCommGroup Hs] [InnerProductSpace ℂ Hs]
def IsTensAbs (σ : ∀ v, G v → (H v →L[ℂ] H v)) (σs : (∀ v, G v) → (Hs →L[ℂ] Hs))
    (tens : (∀ v, H v) → Hs) : Prop :=
