theorem cstar_algebra_increasing_approximate_unit_6b (A : Type*) [NonUnitalCStarAlgebra A] [PartialOrder A] [StarOrderedRing A] :
    (CStarAlgebra.approximateUnit A).IsIncreasingApproximateUnit := by sorry

