theorem parkOK_of {dA Z Z1 Cm : Fin HS} (hf : SlabFree dA) (h56 : dA.val < 56)
    (hc : Z.val < 56 ∧ Z1.val < 56 ∧ Cm.val < 56 ∧ Z ≠ Z1 ∧ Z ≠ Cm ∧ Z1 ≠ Cm ∧ Z ∉ rg ∧ Z1 ∉ rg ∧
      Cm ∉ rg ∧ Z ≠ 15 ∧ Z ≠ 47 ∧ Z ≠ 48 ∧
      (∀ j ∈ [Z, Z1, Cm], j ≠ 0 ∧ j ≠ sZ ∧ ∀ i, ρS i ≠ j))
    (hd : dA ≠ Z ∧ dA ≠ Z1 ∧ dA ≠ Cm) : ParkOK dA Z Z1 Cm := by
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13⟩ := hc
  obtain ⟨f0, fZ, fρ, -⟩ := hf
  exact ⟨⟨h56, c1, c2, c3⟩, ⟨hd.1, hd.2.1, hd.2.2, c4, c5, c6⟩, ⟨c7, c8, c9⟩, ⟨c10, c11, c12⟩, c13,
    ⟨f0, fZ, fρ⟩⟩

theorem park_ok {dA : Fin HS} (hf : SlabFree dA) (h56 : dA.val < 56) :
    ParkOK dA (zOf dA) (z1Of dA) (cmOf dA) ∧ ZOK (zOf dA) ∧ CmOK (cmOf dA) := by
  have zk : ZOK (zOf dA) := by
    unfold zOf ZOK; split_ifs <;> decide
  have ck : CmOK (cmOf dA) := by
    unfold cmOf CmOK; split_ifs <;> decide
  refine ⟨?_, zk, ck⟩
  by_cases a : dA = 49
  · rw [zOf, if_pos a, z1Of, if_neg (by rw [a]; decide), cmOf, if_neg (by rw [a]; decide)]
    exact parkOK_of hf h56 (by decide) (by rw [a]; decide)
  by_cases b : dA = 50
  · rw [zOf, if_neg a, z1Of, if_pos b, cmOf, if_neg (by rw [b]; decide)]
    exact parkOK_of hf h56 (by decide) (by rw [b]; decide)
  by_cases c : dA = 51
  · rw [zOf, if_neg a, z1Of, if_neg b, cmOf, if_pos c]
    exact parkOK_of hf h56 (by decide) (by rw [c]; decide)
  rw [zOf, if_neg a, z1Of, if_neg b, cmOf, if_neg c]
  exact parkOK_of hf h56 (by decide) ⟨a, b, c⟩

/-- The regime of axis `k`. -/
theorem reg_of {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (hD : dP6 P n = D + 1) (hk : k ≤ D)
    (an : AxNum P n src D k)
    (hN : 0 < src k ∧ src k < tF6 P n k ∧ 2 ≤ αN6 P n ∧
      3 * src k ≤ αN6 P n ^ 2 * (tF6 P n k - src k) ∧ 6 * dP6 P n ≤ src k ∧
      48 * dP6 P n ^ 2 ≤ αN6 P n ^ 2 ∧ αN6 P n ^ 2 ≤ pP6 P n ∧
      pP6 P n < 48 * dP6 P n * (αN6 P n + 1) ^ 2 ∧ 3072 ≤ b'P6 P n ∧ 1 ≤ dP6 P n) :
    Reg k (preT P n D k) (postT P n D k) (src k) (tF6 P n k) (pP6 P n) (αN6 P n) (dP6 P n)
      (TP6 P n) := by
  obtain ⟨hs0, hst, hα2, -, -, hdα, hαp, -, hb', hd1⟩ := hN
  have hpe : pP6 P n = 6 * b'P6 P n := rfl
  have hdd : dP6 P n ≤ dP6 P n ^ 2 := by nlinarith
  have hαα : αN6 P n ≤ αN6 P n ^ 2 := by nlinarith
  exact {
    tot := an.tot
    pre1 := an.pre1
    post1 := an.post1
    hs := hs0
    hst := hst
    h2T := (Nat.lt_size_self _).trans_le (Nat.pow_le_pow_right (by norm_num) an.sizeT)
    pQ := an.pQ
    Qp := an.Qp
    p0 := by omega
    dp := by omega
    d1 := hd1
    α1 := by omega
    αp := by omega
    kT := by have := an.dT; omega
    pT := an.pT
    dT := an.dT }

