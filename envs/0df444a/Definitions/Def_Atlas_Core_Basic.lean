import Mathlib
/-!
# Exact Vacuum Atlas — coordinate geometry core

Dimension-parametric (`Fin n`) coordinate objects. Nothing here is a manifold: a metric is a
matrix of real functions on points of `ℝⁿ`, and every theorem about these objects states its
coordinate domain explicitly.

* `pd i f x` is the partial derivative `∂ᵢ f (x)`, defined as Mathlib's `deriv` of the
  one-variable slice `u ↦ f (x with xᵢ := u)`. Where the slice is not differentiable `deriv`
  returns the junk value `0`; certificates therefore carry explicit smoothness hypotheses, and
  `Atlas.Core.Pd` proves that under them every `pd` used is a genuine derivative.
* `christoffel g ginv a b c = Γᵃ_{bc} = ½ Σ_k ginv^{ak} (∂_c g_{kb} + ∂_b g_{kc} − ∂_k g_{bc})`.
* `ricci Γ b d = R_{bd} = Σ_i (∂_i Γⁱ_{bd} − ∂_d Γⁱ_{bi} + Σ_j (Γⁱ_{ij} Γʲ_{bd} − Γⁱ_{dj} Γʲ_{bi}))`.

Formulas, index order and signs are those of the specification layer `KerrBL_CoordGeometry`
of the earlier Kerr mission; `Atlas.Compat.KerrBL` proves they coincide for `n = 4`.
-/

namespace ExactVacuumAtlas

/-- A coordinate point of `ℝⁿ`. -/
abbrev Pt (n : ℕ) := Fin n → ℝ

/-- Components `g_{ij}` of a coordinate metric (or any rank-2 field) as functions of the point. -/
abbrev Metric (n : ℕ) := Fin n → Fin n → Pt n → ℝ

/-- Partial derivative `∂ᵢ f (x)` as the derivative of the slice through `x` along `xᵢ`. -/
noncomputable def pd {n : ℕ} (i : Fin n) (f : Pt n → ℝ) (x : Pt n) : ℝ :=
  deriv (fun u : ℝ => f (Function.update x i u)) (x i)

/-- Coordinate Christoffel symbols `Γᵃ_{bc}` of `g` with candidate inverse `ginv`. -/
noncomputable def christoffel {n : ℕ} (g ginv : Metric n) (a b c : Fin n) (x : Pt n) : ℝ :=
  (∑ k : Fin n, ginv a k x * (pd c (g k b) x + pd b (g k c) x - pd k (g b c) x)) / 2

/-- Coordinate Ricci tensor `R_{bd}` built from a family of Christoffel symbols. -/
noncomputable def ricci {n : ℕ} (Γ : Fin n → Fin n → Fin n → Pt n → ℝ) (b d : Fin n)
    (x : Pt n) : ℝ :=
  ∑ i : Fin n, (pd i (Γ i b d) x - pd d (Γ i b i) x
    + ∑ j : Fin n, (Γ i i j x * Γ j b d x - Γ i d j x * Γ j b i x))

/-- Ricci tensor of a metric `g` with candidate inverse `ginv`. -/
noncomputable def ricciOf {n : ℕ} (g ginv : Metric n) : Fin n → Fin n → Pt n → ℝ :=
  ricci (christoffel g ginv)

/-- The matrix `(g_{ij}(x))`. -/
def metricMatrix {n : ℕ} (g : Metric n) (x : Pt n) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i j => g i j x

/-- Minkowski form `diag(-1, 1, …, 1)` in dimension `n+1`. -/
def eta (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ :=
  Matrix.diagonal fun i => if i = 0 then -1 else 1

/-- Lorentzian signature `(-,+,…,+)`: congruent to `eta n` through an invertible frame matrix
`E` (columns = an orthonormal frame). By Sylvester's law of inertia this is the usual notion;
the law itself is not needed for, and not used by, the certificates. -/
def IsLorentzian {n : ℕ} (G : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ) : Prop :=
  ∃ E : Matrix (Fin (n + 1)) (Fin (n + 1)) ℝ, IsUnit E.det ∧ E.transpose * G * E = eta n

end ExactVacuumAtlas


