          (((sh.length + 1) * (Nat.size (AModel.vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ)) := by
  obtain ⟨q₀, H⟩ := NLogN.KFW.swWU_spec
  refine ⟨q₀, fun q' hq' hq₀ => ?_⟩
  obtain ⟨K, hK, HK⟩ := H q' hq' hq₀
