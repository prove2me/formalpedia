    · exact mgB hA (by simp [accE, lnE, lenE, Poly]) (by simp [accE, lnE, lenE, dg])
  have P10 := Sp.asg (i := L) (e := accE L) (B := BW A) s (RF W c9) hL5 fL (zsz_of_VB hℓ) cA okA
    (by simp [accE, lnE, lenE, Ex.Lin]) bA
  have eA : (accE L).eval (encK s (RF W c9)) = ℓ + (1 + LN) := by
