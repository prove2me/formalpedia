  obtain ⟨a1, a2, a3⟩ := mvG_fwd M NLogN.GL.gD gZT ax.rn t x r Ln Q ax.n (by decide) (by decide)
    (by decide) (by decide) (by decide) (by omega) hD hx tn hr.bn hxQ
