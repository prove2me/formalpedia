        1 (count + 1) _ _ _ hfirst ih
      simpa [List.replicate_succ, Nat.add_assoc,
        Nat.add_comm, Nat.add_left_comm] using hfull
noncomputable def sourceCanonicalUnaryGridIndexTimePolynomial : Polynomial ℕ :=
