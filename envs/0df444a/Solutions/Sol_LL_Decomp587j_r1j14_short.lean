        ⟨le_trans (div_le_div_of_nonneg_right (by exact_mod_cast Nat.le_add_right _ _) (le_of_lt hDout_pos)) (le_of_lt ht.1),
         le_trans ht.2 (div_le_div_of_nonneg_right (by exact_mod_cast hhi0_le) (le_of_lt hDout_pos))⟩
      exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hlo_le_hi).mpr (hint_all.mono_set hsub)
    have hint_inv : IntervalIntegrable (fun x0 : ℝ => Mf * (1 / x0)) volume
