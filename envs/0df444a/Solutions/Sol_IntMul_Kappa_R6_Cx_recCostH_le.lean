-- Source module: Solutions.R6CxCost
/-!
# R2: cost of the recursive C-layer through a `Prop8IfaceH` network (moment recurrence)

Cost model (§5.3, as `Butterfly.recCost`, now on any number of axes `e = m f + r`): a node on
`e ≥ m` axes and data volume `V` costs `Lloc · V` for the local steps of one network invocation
(`locWork_le_vol`: `Lloc = nloc (W+T)²/W` bounds the actual entry operations), `r · V` for the
`r = e mod m` leftover individual kernels, and one recursive call on `|S| f` axes and volume
`V / W` per child; a leaf (`e < m`) costs `e · V` (individual kernels).

* `recCostH_lin`: `recCostH e V = V · recCostH e 1`.
* `recCostH_unit_node`: the per-volume recurrence `c(e) = Lloc + r + (1/W) ∑_w n_w c(w f)`.
* **`recCostH_le`**: if `∑_w n_w (w/m)^σ < W` (`histMoment h m σ < W`), then
  `recCostH e V ≤ K · V · e^σ` for all `e, V ≥ 0` (via `moment_recurrence_bound` applied to the
  running maximum of `c`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

variable {W T m : ℕ} {h : List (ℕ × ℕ)} [NeZero W]

lemma recCostH_node (J : Prop8IfaceH W T m h) (Lloc : ℝ) {e : ℕ} (hme : 0 < m ∧ m ≤ e) (V : ℝ) :
    recCostH J Lloc e V = Lloc * V + ((e % m : ℕ) : ℝ) * V +
      (J.widths.map fun w => recCostH J Lloc (w * (e / m)) (V / W)).sum := by
  rw [recCostH, dif_pos hme]
  congr 1
  conv_rhs => rw [← List.attach_map_subtype_val J.widths, List.map_map]
  rfl

lemma recCostH_leaf (J : Prop8IfaceH W T m h) (Lloc : ℝ) {e : ℕ} (hme : ¬ (0 < m ∧ m ≤ e))
    (V : ℝ) : recCostH J Lloc e V = (e : ℝ) * V := by
  rw [recCostH, dif_neg hme]

/-- **Linearity in the volume.** -/
theorem recCostH_lin (J : Prop8IfaceH W T m h) (Lloc : ℝ) :
    ∀ e V, recCostH J Lloc e V = V * recCostH J Lloc e 1 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro V
  by_cases hme : 0 < m ∧ m ≤ e
  · rw [recCostH_node J Lloc hme, recCostH_node J Lloc hme]
    have hs : ∀ U : ℝ, (J.widths.map fun w => recCostH J Lloc (w * (e / m)) U) =
        J.widths.map fun w => U * recCostH J Lloc (w * (e / m)) 1 := by
      intro U
      refine List.map_congr_left fun w hw => ?_
      exact ih _ (child_lt hme (J.small w hw)) U
    rw [hs, hs, List.sum_map_mul_left, List.sum_map_mul_left]
    ring
  · rw [recCostH_leaf J Lloc hme, recCostH_leaf J Lloc hme]; ring

/-- The per-volume recurrence, with the child sum in histogram form. -/
theorem recCostH_unit_node (J : Prop8IfaceH W T m h) (Lloc : ℝ) {e : ℕ} (hme : 0 < m ∧ m ≤ e) :
    recCostH J Lloc e 1 = Lloc + ((e % m : ℕ) : ℝ) +
      (h.map fun p => (p.2 : ℝ) * recCostH J Lloc (p.1 * (e / m)) 1).sum / W := by
  rw [recCostH_node J Lloc hme]
  have hs : (J.widths.map fun w => recCostH J Lloc (w * (e / m)) (1 / W)) =
      J.widths.map fun w => (1 / (W : ℝ)) * recCostH J Lloc (w * (e / m)) 1 := by
    refine List.map_congr_left fun w _ => ?_
    exact recCostH_lin J Lloc _ _
  rw [hs, List.sum_map_mul_left, J.sum_widths (fun w => recCostH J Lloc (w * (e / m)) 1)]
  simp only [nsmul_eq_mul, mul_one]
  ring

theorem recCostH_unit_nonneg (J : Prop8IfaceH W T m h) {Lloc : ℝ} (hL : 0 ≤ Lloc) :
    ∀ e, 0 ≤ recCostH J Lloc e 1 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  by_cases hme : 0 < m ∧ m ≤ e
  · rw [recCostH_node J Lloc hme]
    have : 0 ≤ (J.widths.map fun w => recCostH J Lloc (w * (e / m)) (1 / W)).sum := by
      apply List.sum_nonneg
      intro x hx
      obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hx
      rw [recCostH_lin]
      exact mul_nonneg (by positivity) (ih _ (child_lt hme (J.small w hw)))
    have : (0 : ℝ) ≤ ((e % m : ℕ) : ℝ) := Nat.cast_nonneg _
    nlinarith
  · rw [recCostH_leaf J Lloc hme]; simp

/-- **§5.3 cost bound on arbitrary widths.** If the network's child-width histogram satisfies
`∑_w n_w (w/m)^σ < W`, the recursive C-layer on `e` axes and volume `V` costs `≤ K V e^σ`. -/
theorem recCostH_le_sol_aux (J : Prop8IfaceH W T m h) {Lloc : ℝ} (hL : 0 ≤ Lloc) {σ : ℝ}
    (hm : 2 ≤ m) (hσ0 : 0 < σ) (hσ1 : σ ≤ 1) (hw : ∀ p ∈ h, 0 < p.1 ∧ p.1 < m)
    (hmom : histMoment h m σ < W) :
    ∃ K : ℝ, ∀ (e : ℕ) (V : ℝ), 0 ≤ V → recCostH J Lloc e V ≤ K * V * (e : ℝ) ^ σ := by
  have hW : 0 < W := Nat.pos_of_ne_zero (NeZero.ne W)
  have hWR : (0 : ℝ) < W := by exact_mod_cast hW
  set c : ℕ → ℝ := fun e => recCostH J Lloc e 1 with hc
  have c0 : ∀ e, 0 ≤ c e := recCostH_unit_nonneg J hL
  -- running maximum
  let ct : ℕ → ℝ := fun x => (Finset.range (x + 1)).sup' ⟨0, by simp⟩ c
  have hle : ∀ x y, y ≤ x → c y ≤ ct x := fun x y hy =>
    Finset.le_sup' c (Finset.mem_range.2 (by omega))
  have hmono : Monotone ct := by
    intro x y hxy
    exact Finset.sup'_le _ _ fun z hz => hle y z (by rw [Finset.mem_range] at hz; omega)
  have ct0 : ∀ x, 0 ≤ ct x := fun x => (c0 x).trans (hle x x le_rfl)
  have hrec : ∀ f : ℕ, 1 ≤ f →
      ct (m * f) ≤ (h.map fun p => (p.2 : ℝ) * ct (p.1 * f)).sum / W + (Lloc + m) := by
    intro f hf
    have hS0 : 0 ≤ (h.map fun p => (p.2 : ℝ) * ct (p.1 * f)).sum / W := by
      apply div_nonneg _ hWR.le
      apply List.sum_nonneg
      intro x hx
      obtain ⟨p, _, rfl⟩ := List.mem_map.1 hx
      exact mul_nonneg (Nat.cast_nonneg _) (ct0 _)
    apply Finset.sup'_le
    intro y hy
    rw [Finset.mem_range] at hy
    by_cases hme : 0 < m ∧ m ≤ y
    · show recCostH J Lloc y 1 ≤ _
      rw [recCostH_unit_node J Lloc hme]
      have hyf : y / m ≤ f := by
        apply Nat.div_le_of_le_mul; linarith
      have hsum : (h.map fun p => (p.2 : ℝ) * recCostH J Lloc (p.1 * (y / m)) 1).sum ≤
          (h.map fun p => (p.2 : ℝ) * ct (p.1 * f)).sum := by
        apply List.sum_le_sum
        intro p _
        exact mul_le_mul_of_nonneg_left (hle _ _ (Nat.mul_le_mul_left _ hyf)) (Nat.cast_nonneg _)
      have hr : ((y % m : ℕ) : ℝ) ≤ m := by exact_mod_cast (Nat.mod_lt y hme.1).le
      have := div_le_div_of_nonneg_right hsum hWR.le
      linarith
    · show recCostH J Lloc y 1 ≤ _
      rw [recCostH_leaf J Lloc hme, mul_one]
      have hy : (y : ℝ) ≤ m := by
        have : y < m := by omega
        exact_mod_cast this.le
      linarith
  obtain ⟨A, hA⟩ := _root_.R6.MomentRec.moment_recurrence_bound h m W σ (Lloc + m) ct hm hσ0 hσ1
    hw hW hmom hmono hrec
  refine ⟨max A 0, fun e V hV => ?_⟩
  rw [recCostH_lin]
  rcases Nat.eq_zero_or_pos e with rfl | he
  · have : ¬ (0 < m ∧ m ≤ 0) := by omega
    rw [recCostH_leaf J Lloc this]; push_cast; rw [Real.zero_rpow hσ0.ne']; simp
  · have h1 : c e ≤ A * (e : ℝ) ^ σ := (hle e e le_rfl).trans (hA e he)
    have h2 : A * (e : ℝ) ^ σ ≤ max A 0 * (e : ℝ) ^ σ :=
      mul_le_mul_of_nonneg_right (le_max_left _ _) (by positivity)
    calc V * recCostH J Lloc e 1 = V * c e := rfl
      _ ≤ V * (max A 0 * (e : ℝ) ^ σ) := mul_le_mul_of_nonneg_left (h1.trans h2) hV
      _ = _ := by ring

