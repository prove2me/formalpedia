-- Source module: Solutions.J6SegILPreJK23
/-!
# B5 `J` side, part K23: the head `parP; jS1; jS2; jK`

From the descriptor on `Z` (`49` or `55`, everything else empty): parameters, stash, line,
tables, capacitance matrix, coupling rows; then the block and table stacks are cleared
(`Rn.jHead`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

def jHead (kA kC wA wC : ℕ) (Z : Fin HS) : RS := .seq (parP kA kC wA wC Z) (.seq jS1 (.seq jS2 jK))

def cJHead (kA kC wA wC W N d s p : ℕ) (m : ℕ) : ℕ :=
  cPar kA kC wA wC W d (NF d s) (segPF p d s) (kA * segPF p d s + kC) +
    (cJS1 W N s + (cJS2 W N (segPF p d s) (p / 7) (lamP d) (wF d) m +
      cJK W N s (lamP d)))

/-- The numeric side conditions of the `J` tables (all at width `W`). -/
structure JB (Q R W s t α lam w : ℕ) : Prop where
  gb : GlobBnd Q W s t α lam
  bgm : ∀ i < lam, |(mkTables Q R s t α).gam i| ≤ 2 ^ W
  bgi : ∀ i < lam, |(mkTables Q R s t α).gi i| ≤ 2 ^ W
  bdd : ∀ i < lam, |(mkTables Q R s t α).dd i| ≤ 2 ^ W
  bdi : ∀ i < lam, |(mkTables Q R s t α).di i| ≤ 2 ^ W
  rb : ∀ a < s, RowBnd Q R W s t α lam (mkBlocks s t lam w) a
  cb : ∀ r < (Jlist (mkBlocks s t lam w)).length,
    CcBnd W s t α (mkTables Q R s t α) (mkBlocks s t lam w) (Lg (Jlist (mkBlocks s t lam w)) r)

/-- The stacks after the head. -/
def headSt (Q R s t lam w α : ℕ) (a3 a4 a7 a11 a12 : ℤ) (c : Cs) : Cs :=
  let L := Jlist (mkBlocks s t lam w)
  let c1 := update (update (update (update (update c sSt [a12, a11, a7, a4, a3]) 30
    (L.map (fun j : ℕ => (j : ℤ)))) 31 [(L.length : ℤ)]) 32 (Src.STL s t lam)) 33 (Src.LNL s t lam)
  let c2 := update (update (tabSt Q R s t lam α c1) 14
    (matL (fun i k => capI Q (mkTables Q R s t α) (mkBlocks s t lam w) (Lg L i) (Lg L k))
      L.length)) 41
    (JK.flatT (ccRows (mkTables Q R s t α) (mkBlocks s t lam w) L L.length) ++ c1 41)
  update (update (update (update (update (update c2 32 []) 33 []) SDI []) SDD []) SGM []) SGI []

end J6Seg.PJ

end

