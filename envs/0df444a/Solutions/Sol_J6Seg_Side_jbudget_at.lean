    s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, le_rfl, ?_⟩
  clear s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13
  -- real facts
  have hdl := dl_le_Ncost6 P n
  have hℓ0 : (0 : ℝ) ≤ ℓP6 P n := Nat.cast_nonneg _
  have hd0 : (0 : ℝ) < dP6 P n := by have := h.base.d1; exact_mod_cast this
  have hNcd : (dP6 P n : ℝ) ≤ Ncost6 P n := by linarith
  have hNcl : (ℓP6 P n : ℝ) ≤ Ncost6 P n := by linarith
  have hL := lgn_ge n
  have hL2 : 1 ≤ (Real.log (IntMul.lg n) + 1) ^ 2 := one_le_pow₀ hL
  have r1 : ((axw6 P n : ℝ) + 1) ≤ 15 * dP6 P n := by exact_mod_cast w1_le h
  have r2 : ((axw6 P n : ℝ) + 1) * ((axBc6 P n src k ap : ℝ) + 2) ^ 2 ≤
      30 * (10 + (ap.bcC : ℝ)) ^ 2 * ((pP6 P n : ℝ) * ℓP6 P n) := by exact_mod_cast n_Bc ap h
  have r3 : ((axw6 P n : ℝ) + 1) * (3 * (axkJ6 P n src k ap : ℝ) + 10 + 2) ≤
      15 * (3 * (W2c ap : ℝ) + 12) * ((dP6 P n : ℝ) * pP6 P n) := by exact_mod_cast n_Bx ap h
  have r4 : ((BkJ6 P n src k ap : ℝ) + 2) * ((axw6 P n : ℝ) + 1) ≤
      15 * (W3c ap : ℝ) * ((dP6 P n : ℝ) * pP6 P n) := by exact_mod_cast n_B ap h
  have r5 := r5_lem ap h
  have hu : ((JK.uC (mulSup (2 * (axkJ6 P n src k ap + 2))) (3 * axkJ6 P n src k ap + 10)
      (axBc6 P n src k ap) : ℕ) : ℝ) = (mulSup (2 * (axkJ6 P n src k ap + 2)) : ℝ) +
      2 * 10 ^ 5 * (3 * (axkJ6 P n src k ap : ℝ) + 10 + 2) +
      10 ^ 8 * ((axBc6 P n src k ap : ℝ) + 2) ^ 2 := by
    unfold JK.uC; push_cast; ring
  have hN := jcost_ax ap h (JK.uC (mulSup (2 * (axkJ6 P n src k ap + 2)))
