section castPoint
variable {F : Type} [Field F]

def castPoint {V V' : WeierstrassCurve F} (h : V = V') : V.toAffine.Point → V'.toAffine.Point := fun x => h ▸ x

theorem castPoint_heq {V V' : WeierstrassCurve F} (h : V = V') (x : V.toAffine.Point) : HEq (castPoint h x) x := by
  subst h; rfl

theorem addOrderOf_castPoint [DecidableEq F] {V V' : WeierstrassCurve F} (h : V = V') (x : V.toAffine.Point) :
    addOrderOf (castPoint h x) = addOrderOf x := by
  subst h; rfl

theorem castPoint_nsmul [DecidableEq F] {V V' : WeierstrassCurve F} (h : V = V') (n : ℕ) (x : V.toAffine.Point) :
    castPoint h (n • x) = n • castPoint h x := by
  subst h; rfl

theorem castPoint_zero {V V' : WeierstrassCurve F} (h : V = V') : castPoint h (0 : V.toAffine.Point) = 0 := by
  subst h; rfl

theorem castPoint_some {V V' : WeierstrassCurve F} (h : V = V') {a b : F} (p : V.toAffine.Nonsingular a b) :
    castPoint h (.some a b p) = .some a b (h ▸ p) := by
  subst h; rfl

theorem mapPoint_castPoint_heq {F' : Type} [Field F'] (σ : F →+* F') {V V' : WeierstrassCurve F} (h : V = V')
    (x : V.toAffine.Point) : HEq (WeierstrassCurve.mapPoint σ (castPoint h x)) (WeierstrassCurve.mapPoint σ x) := by
  subst h; rfl

theorem mapPoint_heq_of_eq {F' : Type} [Field F'] {σ τ : F →+* F'} (h : σ = τ) {V : WeierstrassCurve F}
    (x : V.toAffine.Point) : HEq (WeierstrassCurve.mapPoint σ x) (WeierstrassCurve.mapPoint τ x) := by
  subst h; rfl

theorem addOrderOf_eq_of_heq [DecidableEq F] {V V' : WeierstrassCurve F} (h : V = V') {a : V.toAffine.Point} {b : V'.toAffine.Point}
    (hab : HEq a b) : addOrderOf a = addOrderOf b := by
  subst h; cases hab; rfl

theorem cyclicQuotientJ_congr [DecidableEq F] {V V' : WeierstrassCurve F} (h : V = V')
    {a : V.toAffine.Point} {b : V'.toAffine.Point} (hab : HEq a b) (d : ℕ) :
    V.cyclicQuotientJ (AddSubgroup.zmultiples a) d = V'.cyclicQuotientJ (AddSubgroup.zmultiples b) d := by
  subst h; cases hab; rfl

end castPoint
