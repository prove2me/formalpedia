        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
    _ = 3600000000 * (T * p) := by ring
    _ ≤ 8000000000 * (T * p) := Nat.mul_le_mul_right _ (by norm_num)
    _ = _ := by ring

theorem n45 :
    cSlabId (axpre6 P n D k) (axnc6 P n k * axl6 P n) (axG6 P n src k) (axpost6 P n D k)
        (axwd6 P n src k ap) ≤ 2 * 10 ^ 9 * (Wc ap + 1) * (TP6 P n * pP6 P n) ∧
    cSlabId (axpre6 P n D k) (axG6 P n src k) (axnc6 P n k * axl6 P n) (axpost6 P n D k)
        (axwd6 P n src k ap) ≤ 2 * 10 ^ 9 * (Wc ap + 1) * (TP6 P n * pP6 P n) := by
  have hw := wd_le ap h
  have h1 := slabId_le (t := axt6 P n k) (wd := axwd6 P n src k ap) h.pre1 h.post1 h.t1
    (n := axnc6 P n k * axl6 P n) (n' := axG6 P n src k) (by have := h.ncl; omega) h.Gt
  have h2 := slabId_le (t := axt6 P n k) (wd := axwd6 P n src k ap) h.pre1 h.post1 h.t1
    (n' := axnc6 P n k * axl6 P n) (n := axG6 P n src k) h.Gt (by have := h.ncl; omega)
  rw [h.tot] at h1 h2
