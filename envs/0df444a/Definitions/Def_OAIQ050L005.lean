namespace OAI

namespace Laughlin.Certificate
open scoped BigOperators
open Polynomial

noncomputable def weightedIntegerCouplingPolynomial (c z n : ℕ) : Polynomial ℤ :=
  (Polynomial.X-1)^z * (C (c : ℤ)*Polynomial.X+1)^n

end Laughlin.Certificate

end OAI
