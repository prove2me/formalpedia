/-- **`bapP` is defined and its cost is bounded by `bapCost`.** The bounds on the intermediate
lists (`vL`, `accL`, `japL` of `L2 = cselL s t (ptL s t V)`) and on the tables are hypotheses. -/
theorem bapP_okc (M : MulSpec) (mm Φ B : ℕ) (hM : MulBnd M mm Φ) (p s t α kb : ℕ) (hs : 0 < s)
    (hst : s ≤ t) (hco : Nat.Coprime s t) (hkb : t ≤ 2 ^ kb) (V : List (ℤ × ℤ))
    (hV : V.length = t) (s0 : IState HS) (RU : List Item)
    (hU : s0.G CU = gints V ++ RU) (hP : BParams s0 p s t α kb)
    (hVm : ∀ z ∈ V, zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm) (hmm : 1 ≤ mm) (hmB : 2 * mm ≤ B)
    (hAcc : (2 * HvdH.eWidth p α + 2) * 2 ^ (2 * mm) ≤ 2 ^ B) (hpB : p + 1 ≤ B)
    (hT : zsz ((t + 1 : ℕ) : ℤ) ≤ B)
    (hSW : zsz (((s + 1) * (2 * HvdH.eWidth p α + 1) : ℕ) : ℤ) ≤ B)
    (hJ : zsz (HvdH.jIter p s t α : ℤ) ≤ B)
    (hWE : ∀ W ∈ eTab p s t α, ∀ y ∈ W, zsz y ≤ mm)
    (hWD : ∀ W ∈ dTab p s t α, ∀ y ∈ W, zsz y ≤ mm)
    (hv : ∀ j ≤ HvdH.jIter p s t α, ∀ z ∈ vL p s t α (cselL s t (ptL s t V)) j,
      zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm)
    (hac : ∀ j ≤ HvdH.jIter p s t α, ∀ z ∈ accL p s t α (cselL s t (ptL s t V)) j,
      zsz z.1 ≤ B ∧ zsz z.2 ≤ B)
    (hJm : ∀ z ∈ japL p s t α (cselL s t (ptL s t V)), zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm) :
    bapP.ok M s0 ∧ bapP.cost M s0 ≤ bapCost p s t α kb mm Φ B := by
  have ht : 0 < t := by omega
  have he := eWidth_pos p α
  set E := HvdH.eWidth p α with hE
  set L1 := ptL s t V with hL1
  set L2 := cselL s t L1 with hL2
  set L3 := japL p s t α L2 with hL3
  set L4 := dapL p s t α L3 with hL4
  have hAcc2 : 2 * 2 ^ (2 * mm) ≤ 2 ^ B :=
    le_trans (Nat.mul_le_mul_right _ (by omega)) hAcc
  have hS : zsz ((s + 1 : ℕ) : ℤ) ≤ B := le_trans (zsz_natCast_le' (by omega)) hT
  have zs : zsz (s : ℤ) ≤ B := le_trans (zsz_natCast_le' (by omega)) hT
  have hle : ∀ a : ℕ, a ≤ (s + 1) * (2 * E + 1) → zsz (a : ℤ) ≤ B :=
    fun a ha => le_trans (zsz_natCast_le' ha) hSW
  have hm1 : ∀ z ∈ V, zsz z.1 ≤ B ∧ zsz z.2 ≤ B := fun z hz =>
    ⟨le_trans (hVm z hz).1 (by omega), le_trans (hVm z hz).2 (by omega)⟩
  have hL1m : ∀ z ∈ L1, zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm := fun z hz => hVm z (mem_ptL s t ht V hV z hz)
  have hL2m : ∀ z ∈ L2, zsz z.1 ≤ mm ∧ zsz z.2 ≤ mm := fun z hz =>
    hL1m z (mem_cselL s t hs hst L1 (ptL_length s t V) z hz)
  have o1 := ptP_run s t kb ht hco hkb V hV s0 RU hU hP.pt hP.pk hP.kt B hm1
  have hP1 := hP.upd_CU (gints L1 ++ RU)
  have o2 := cStage_okc M mm Φ B hM s t kb p α hs hst L1 (ptL_length s t V) _ RU (by simp) hP1
    hL1m hmm hAcc2 hmB hT
  have r2 := cStage_run s t kb p α hs hst L1 (ptL_length s t V) _ RU (by simp) hP1
  have hP2 := hP.upd_CU (gints L2 ++ RU)
  have o3 := JP_okc M mm Φ B hM p s t α (HvdH.jIter p s t α) hs L2 (cselL_length s t _) _ RU _ _
    hP2.e (by simp) hP2.jl.choose_spec hP2.jn.choose_spec
    (fun z hz => ⟨le_trans (hL2m z hz).1 (by omega), le_trans (hL2m z hz).2 (by omega)⟩)
    hv hac hWE hAcc hmB (hle _ (by nlinarith)) hpB (hle _ (by nlinarith)) zs
    (hle _ (by nlinarith)) hJ (by omega)
  have r3 := JP_run p s t α (HvdH.jIter p s t α) hs L2 (cselL_length s t _) _ RU _ _ hP2.e
    (by simp) hP2.jl.choose_spec hP2.jn.choose_spec
  rw [accL_japL p s t α hs L2 (cselL_length s t _)] at r3
  have hP3 := hP.upd_CU (gints L3 ++ RU)
  have o4 := dStage_okc M mm Φ B hM s t kb p α hs L3 (japL_length p s t α _) _ RU (by simp) hP3
    hJm hWD hAcc2 hmB hS hpB
  have r4 := dStage_run s t kb p α hs L3 (japL_length p s t α _) _ RU (by simp) hP3
  have hP4 := hP.upd_CU (gints L4 ++ RU)
  have o5 := psP_run s t kb hs hco.symm (le_trans hst hkb) L4 (dapL_length p s t α _) _ RU
    (by simp) hP4.pk hP4.ks hP4.ps B o4.2.2 zs
  have e1 : ptP.run s0 = s0.upd CU (gints L1 ++ RU) := o1.2.1
  have e2 : ((stageP Ac).ren σc).run (s0.upd CU (gints L1 ++ RU)) = s0.upd CU (gints L2 ++ RU) := by
    rw [r2, IState.upd_upd_same]
  have e3 : JP.run (s0.upd CU (gints L2 ++ RU)) = s0.upd CU (gints L3 ++ RU) := by
    rw [r3, IState.upd_upd_same]
  have e4 : ((stageP Ad).ren σd).run (s0.upd CU (gints L3 ++ RU)) = s0.upd CU (gints L4 ++ RU) := by
    rw [r4, IState.upd_upd_same]
  have k1 := o1.2.2; have k2 := o2.2.1; have k3 := o3.2; have k4 := o4.2.1; have k5 := o5.2.2
  clear_value L1 L2 L3 L4 E
  refine ⟨?_, ?_⟩
  · simp only [bapP, RM.seqL, RM.ok, RM.run_seq, RM.run_rs, RM.ok_rs, e1, e2, e3, e4]
    exact ⟨o1.1, o2.1, o3.1, o4.1, o5.1⟩
  · simp only [bapP, RM.seqL, RM.cost_seq', RM.cost_rs', RM.run_seq, RM.run_rs, e1, e2, e3, e4]
    unfold bapCost
    rw [← hE]; rw [← hE] at k3
    omega

end NLogN.Rsp

