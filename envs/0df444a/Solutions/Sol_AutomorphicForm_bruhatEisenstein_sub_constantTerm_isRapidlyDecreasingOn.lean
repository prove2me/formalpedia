    (γ : ℝ →+ A) (c : ι → ℝ) (hγ : ∀ t, Θ (γ t) = dirFlow c t) (a : A) :
    (fun t : ℝ => torusLift Θ hΘs H (Θ a + dirFlow c t)) = fun t : ℝ => H (a + γ t) :=
