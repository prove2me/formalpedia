/-- The natural coverage value, viewed in the real-valued mission interface. -/
noncomputable def valueR (i : Fin 3) (S : Finset (Fin 8)) : ℝ :=
  (valueN i S : ℝ)

/-- Natural feature weights give the exact required nonnegative real weights. -/
theorem weighted_coverage (i : Fin 3) :
    EFXCounterex.Submodular.IsWeightedCoverage (valueR i) := by
  refine ⟨11, (fun f => (weight f : ℝ)), cov i, ?_, ?_⟩
  · intro f
    exact Nat.cast_nonneg _
  · intro S
    simp only [valueR, valueN, Nat.cast_sum]

end S02EFX

