  · exact TypeDensity.Tests.rank_lt_of_degree_lt s z.2 hlt
  obtain ⟨hch, hz1⟩ := TypeDensity.Tests.children_eq_singleton s hs P hP z hz heq
  have hw : ∀ u : TypeDensity.State, s.weight < u.weight → z.2 = u → z.2.rank < s.rank := by
    rintro u hwu rfl
    exact TypeDensity.Tests.rank_lt_of_weight_lt s z.2 hs hv heq hwu
  cases s with
  | single a c =>
    simp only [TypeDensity.children, TypeDensity.otherChildren, List.mem_append, List.mem_flatMap,
