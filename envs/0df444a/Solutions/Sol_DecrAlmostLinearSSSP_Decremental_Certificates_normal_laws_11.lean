    have huvalid := adapterTrace_pointer_valid i a (events i B j g (bankAddress B j.val logical)) hp
    obtain ⟨cr,t,zs,ht,hcr,htm,htlen,htenv,htq,htframe⟩ := ih hencodedRest _ ys u (offset+1) hum huenv huvalid huq
    have htest : (Test.natLess 56 214).holds s := by
