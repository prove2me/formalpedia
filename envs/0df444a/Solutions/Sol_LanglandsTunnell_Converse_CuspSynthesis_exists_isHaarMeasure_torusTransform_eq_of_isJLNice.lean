private theorem s002.t0913 (d : JLData K S epsS ω) (D : s002 (S := S) b)
    {v : HeightOneSpectrum (𝓞 K)} (h : ¬ D.d109 d v) : D.d108 d v < D.combExp d v := by
  have h' := h
  rw [s002.d109, D.t0911 d (D.t0912 d h), not_le, WithZero.exp_lt_exp]
    at h'
  omega

private noncomputable def s002.xT (d : JLData K S epsS ω) (D : s002 (S := S) b)
    (v : HeightOneSpectrum (𝓞 K)) : v.adicCompletion K :=
