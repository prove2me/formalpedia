    (hVl : ∀ j ≤ k, NLogN.zsz ((NLogN.KFW.Vb K (K * (D - q0)) S r H j Bp : ℕ) : ℤ) ≤ Zr)
    (hMb : NLogN.zsz (Mb : ℤ) ≤ Bz) (hM : NLogN.KFW.MbB K P D w k q0 Bp ≤ Mb)
    (hEZ : NLogN.zsz (((q0 + NLogN.KFW.lowF NLogN.KFW.ES k (D - q0) + (D / 2 + D % 2)) : ℕ) : ℤ) ≤ Z)
    (hp : NLogN.zsz (p : ℤ) ≤ Z) (hwZ : w < 2 ^ Z)
    (st : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (xs : List (Fin r → ℂ)) (hx : NLogN.KFH.RecRep r p zs xs)
    (hl : xs.length = AModel.vol (Butterfly.layerShape P K D S)) (h0 : f 0 = NLogN.KFB.gflat zs ++ l)
    (h36 : f 36 = [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ), (Z : ℤ)])
    (hfree : ∀ j : Fin NLogN.HS, j ≠ 0 → j ≠ 36 → j.val < 50 → f j = [])
    (hb : NLogN.KFB.GB w zs) (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1)
    (hex : ∃ zs', NLogN.KFH.RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)) :
    NLogN.IRuns Isym tbl (NLogN.KFW.p14C jG) (NLogN.KIL.encK st f)
      (NLogN.KIL.encK st (Function.update f 0 (NLogN.KFB.gflat (Classical.choose hex) ++ l)))
      (8 * (2 * NLogN.moveCost Z + 19) + (NLogN.KFW.cChain Kc K S r H P D k q0 Bp Z Zr Bz w +
        8 * (2 * NLogN.moveCost Z + 19))) := by
  set X := NLogN.KFB.gflat (Classical.choose hex) ++ l with hX
  have hreg : ∀ j : Fin NLogN.HS, j ∈ [(21 : Fin NLogN.HS), 1, 22, 3, 23, 4, 26, 25] → f j = [] := by
    intro j hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact hfree _ (by (try dsimp only); decide) (by (try dsimp only); decide) (by (try dsimp only); decide)
  obtain ⟨b1, b2, b3, b4, b5⟩ := NLogN.KFW.layer_bounds (K := K) (D := D) hS hP hr
  set N := P * 2 ^ (K * D) * S * r with hN
  have zb : ∀ x : ℕ, x ≤ 32 * N → NLogN.zsz (x : ℤ) ≤ Z := fun x hx => le_trans (NLogN.zsz_natCast_le hx) hZ32
  have hKN : K ≤ N := by have : K ≤ K * D := Nat.le_mul_of_pos_right _ hD; omega
  have hDN : D ≤ N := by have : D ≤ K * D := Nat.le_mul_of_pos_left _ (by omega); omega
  have hSN : S ≤ N := by have : S ≤ S * r := Nat.le_mul_of_pos_right _ hr; omega
  have hrN : r ≤ N := by have : r ≤ S * r := Nat.le_mul_of_pos_left _ hS; omega
  have hB : ∀ x ∈ [(P : ℤ), (K : ℤ), (D : ℤ), (S : ℤ), (ρ : ℤ), (r : ℤ), (p : ℤ), (w : ℤ)],
      NLogN.zsz x ≤ Z := by
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact zb P (by omega)
    · exact zb K (by omega)
    · exact zb D (by omega)
    · exact zb S (by omega)
    · exact zb ρ (by omega)
    · exact zb r (by omega)
    · exact hp
    · exact NLogN.KFW.zszN_lt hwZ
  have R1 := NLogN.KFW.dIn_run (Isym := Isym) (tbl := tbl) (Pp := Pp) st f P K D S ρ r p w [(Z : ℤ)] h36
    hreg hB
  set F1 := NLogN.KFW.fIn f (P : ℤ) (K : ℤ) (D : ℤ) (S : ℤ) (ρ : ℤ) (r : ℤ) (p : ℤ) (w : ℤ) [(Z : ℤ)]
    with hF1
  set B := Function.update F1 0 [] with hBd
  set f0 : Fin NLogN.HS → List ℤ := Function.update (fun _ => []) 0 (f 0) with hf0
  have hF10 : F1 0 = f 0 := by simp [hF1, NLogN.KFW.fIn, Function.update_apply]
  have hsplit : NLogN.KIL.encK st F1 = NLogN.KIL.encK (NLogN.KIL.encK st B) f0 := by
    rw [NLogN.KFW.encK_encK']
    congr 1
    funext j
    by_cases hj : j = 0
