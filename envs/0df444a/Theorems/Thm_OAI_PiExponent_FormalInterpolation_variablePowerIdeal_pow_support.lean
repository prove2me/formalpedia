-- title:
--   Support exponents in powers of variable-power ideals dominate generator multiplicities
-- statement:
--   For a polynomial in the nth power of the ideal generated by variable powers X_i^(e_i), every exponent with nonzero coefficient dominates the exponent of a product of exactly n generators. The multiplicities of those generators sum to n. This holds over any commutative semiring, including zero generator exponents.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.variablePowerIdeal_pow_support
    {σ : Type*} [Fintype σ] {k : Type*} [CommSemiring k]
    (e : σ → Nat) (n : Nat) (p : MvPolynomial σ k)
    (hp : p ∈ (Ideal.span (Set.range
      (fun i : σ => (MvPolynomial.X i : MvPolynomial σ k) ^ e i))) ^ n)
    (d : σ →₀ Nat) (hd : p.coeff d ≠ 0) :
    ∃ b : σ → Nat, (∑ i, b i) = n ∧ ∀ i, e i * b i ≤ d i := by sorry
