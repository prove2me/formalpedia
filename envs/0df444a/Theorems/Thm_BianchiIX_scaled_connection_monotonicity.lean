theorem BianchiIX.scaled_connection_monotonicity {β : ℝ → ProjectiveState} {a : ℝ → ℝ}
    {I : Set ℝ} {μ : ℝ} (hI : Convex ℝ I) (hμ : 4 ≤ μ)
    (ha : ∀ u ∈ I, 0 < a u)
    (hβ : ∀ u ∈ I, HasDerivAt β (a u • projectiveField (β u)) u)
    (hy : ∀ u ∈ I, connectionRegion μ (β u))
    (hv : ∀ u ∈ I, 0 < β u 2) (hw : ∀ u ∈ I, 0 < β u 3) :
    StrictAntiOn (fun u => β u 2) I ∧ StrictMonoOn (fun u => β u 3) I := by sorry
