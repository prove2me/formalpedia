    (w : HeightOneSpectrum (𝓞 (↥(_root_.LanglandsTunnell.P0.fixFld H)))) (hw : w.asIdeal = Q.under (𝓞 (↥(_root_.LanglandsTunnell.P0.fixFld H)))) :
    (liftTraceSeed e H).b w = M.det := by
  have _ := hℓ
  haveI : Q.LiesOver w.asIdeal := ⟨hw⟩
  haveI : (_root_.LanglandsTunnell.P2.primeOver H w).LiesOver w.asIdeal := ⟨(under_primeOver H w).symm⟩
  obtain ⟨τ, hτ⟩ := Ideal.exists_smul_eq_of_isGaloisGroup w.asIdeal (_root_.LanglandsTunnell.P2.primeOver H w) Q H
  have hτ' : ((τ : L ≃ₐ[ℚ] L)) • _root_.LanglandsTunnell.P2.primeOver H w = Q := hτ
  subst hτ'
  have hI₀ : (_root_.LanglandsTunnell.P2.primeOver H w).inertia (L ≃ₐ[ℚ] L) = ⊥ := by
    have h := inertia_smul_eq_bot ((τ : L ≃ₐ[ℚ] L))⁻¹ (((τ : L ≃ₐ[ℚ] L)) • _root_.LanglandsTunnell.P2.primeOver H w) hI
