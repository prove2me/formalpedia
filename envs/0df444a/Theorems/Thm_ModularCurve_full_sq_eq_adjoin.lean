open ModularCurve

theorem ModularCurve.full_sq_eq_adjoin (p : ℕ) [hp : Fact (Nat.Prime p)] : modularFunctionFieldFull (p * p) = IntermediateField.adjoin ℚ ({jq, jqN p, jqN (p * p)} : Set (LaurentSeries ℚ)) := by sorry
