def threeRowFactor (t z i : ℕ) : ℚ :=
  if z ≤ t+i then (2:ℚ)^z * t.factorial * i.factorial /
    ((3:ℚ)^(t+i)*(2:ℚ)^t*z.factorial*(t+i-z).factorial) else 0

end LaughlinGap.RealOccupation

