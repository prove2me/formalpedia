open BraidsLinksMCG BraidsLinksMCG.P2MAlias in
theorem solution {c : ℂ} {r : ℝ} (hr : 0 < r) (δ : Path (circleBase c r hr) (circleBase c r hr)) :
    ∃ k : ℤ, δ.Homotopic (circleWind c r k hr) := by
  have hpi : (0:ℝ) < 2 * Real.pi := by positivity
  have hδ : ∀ t, ‖(δ t).1 - c‖ = r := fun t => (δ t).2
  have hne : ∀ t, (δ t).1 - c ≠ 0 := by
    intro t h
    have := hδ t
    rw [h, norm_zero] at this
    linarith
  have hcontδ : Continuous fun t => (δ t).1 := continuous_subtype_val.comp δ.continuous
  let γ : C(unitInterval, {z : ℂ // z ≠ 0}) :=
    ⟨fun t => ⟨(δ t).1 - c, hne t⟩, (hcontδ.sub continuous_const).subtype_mk _⟩
  have hδ0 : (δ 0).1 = c + r := by rw [δ.source]
  have hδ1 : (δ 1).1 = c + r := by rw [δ.target]
  have h0 : γ 0 = (fun z : ℂ ↦ (⟨_, z.exp_ne_zero⟩ : {z : ℂ // z ≠ 0})) (Real.log r : ℂ) := by
    apply Subtype.ext
    show (δ 0).1 - c = Complex.exp (Real.log r)
    rw [hδ0, ← Complex.ofReal_exp, Real.exp_log hr]
    ring
  set Γ := Complex.isCoveringMap_exp.liftPath γ _ h0 with hΓ
  have hlift : ∀ t, Complex.exp (Γ t) = (δ t).1 - c := by
    intro t
    have := congrFun (Complex.isCoveringMap_exp.liftPath_lifts γ _ h0) t
    exact congrArg Subtype.val this
  have hΓ0 : Γ 0 = Real.log r := Complex.isCoveringMap_exp.liftPath_zero γ _ h0
  have hre : ∀ t, (Γ t).re = Real.log r := by
    intro t
    have h1 := hδ t
    rw [← hlift t, Complex.norm_exp] at h1
    rw [← h1, Real.log_exp]
  let L : C(unitInterval, ℝ) :=
    ⟨fun t => (Γ t).im / (2 * Real.pi), (Complex.continuous_im.comp Γ.continuous).div_const _⟩
  have hcov : ∀ t, circleCover hr (L t) = δ t := by
    intro t
    apply Subtype.ext
    show c + (r:ℂ) * Complex.exp (2 * (Real.pi:ℂ) * ((((Γ t).im / (2 * Real.pi) : ℝ)) : ℂ)
      * Complex.I) = (δ t).1
    have e1 : 2 * (Real.pi:ℂ) * ((((Γ t).im / (2 * Real.pi) : ℝ)) : ℂ) = ((Γ t).im : ℂ) := by
      have : (Real.pi:ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
      push_cast
      field_simp
    have e2 : (r:ℂ) * Complex.exp ((Γ t).im * Complex.I) = Complex.exp (Γ t) := by
      conv_rhs => rw [← Complex.re_add_im (Γ t)]
      rw [Complex.exp_add, hre t, ← Complex.ofReal_exp, Real.exp_log hr]
    rw [e1, e2, hlift t]
    ring
  have hL0 : L 0 = 0 := by
    show (Γ 0).im / (2 * Real.pi) = 0
    rw [hΓ0]
    simp
  have hexp1 : Complex.exp (2 * (Real.pi:ℂ) * ((L 1 : ℝ) : ℂ) * Complex.I) = 1 := by
    have h := congrArg Subtype.val (hcov 1)
    rw [hδ1] at h
    change c + (r:ℂ) * Complex.exp (2 * (Real.pi:ℂ) * ((L 1 : ℝ) : ℂ) * Complex.I) = c + r at h
    have hr0 : (r:ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
    have h2 : (r:ℂ) * Complex.exp (2 * (Real.pi:ℂ) * ((L 1 : ℝ) : ℂ) * Complex.I) = r * 1 := by
      rw [mul_one]
      linear_combination h
    exact mul_left_cancel₀ hr0 h2
  obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp hexp1
  have hL1 : L 1 = n := by
    have h := congrArg Complex.im hn
    simp at h
    apply mul_left_cancel₀ hpi.ne'
    linarith
  refine ⟨n, ?_⟩
  let P1 : Path (0:ℝ) (n:ℝ) := { toContinuousMap := L, source' := hL0, target' := hL1 }
  let P2 : Path (0:ℝ) (n:ℝ) :=
    { toFun := fun t => (n:ℝ) * (t:ℝ), continuous_toFun := by fun_prop,
      source' := by simp, target' := by simp }
  obtain ⟨F⟩ := SimplyConnectedSpace.paths_homotopic P1 P2
  let C : C(ℝ, circleSet c r) := ⟨circleCover hr, by
    unfold circleCover
    exact Continuous.subtype_mk (by fun_prop) _⟩
  have G := F.compContinuousMap C
  have e1 : C.comp P1.toContinuousMap = δ.toContinuousMap :=
    ContinuousMap.ext fun t => hcov t
  have e2 : C.comp P2.toContinuousMap = (circleWind c r n hr).toContinuousMap := by
    refine ContinuousMap.ext fun t => Subtype.ext ?_
    show c + (r:ℂ) * Complex.exp (2 * (Real.pi:ℂ) * ((((n:ℝ) * (t:ℝ) : ℝ)) : ℂ) * Complex.I)
      = c + r * Complex.exp (2 * Real.pi * ((n : ℝ) : ℂ) * (t.1 : ℂ) * Complex.I)
    push_cast
    ring_nf
  rw [e1, e2] at G
  exact ⟨G⟩
