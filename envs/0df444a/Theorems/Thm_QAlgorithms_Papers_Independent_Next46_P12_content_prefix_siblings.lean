-- title:
--   Proposition 3.6: prefix compatibility and sibling separation
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Let $(J_i)$ be separating, meaning $J_i\in X_i$ and $k[J_1,\ldots,J_n]=X_n$ for every level. For $n\ge1$, write $\bar T$ for the length-$(n-1)$ prefix and $c_T(i)$ for the content of $J_i$. Then
--
--   $$c_T(i)=c_{\bar T}(i)\quad(1\le i<n),\qquad \bar S=\bar T,\ S\ne T\ \Longrightarrow\ c_S(n)\ne c_T(n).$$
--
--   Prefix contents agree, and the final content distinguishes sibling paths.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 13, Proposition 3.6: prefix compatibility and sibling separation

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Proposition 3.6(a,b), source PDF p. 13. Bars on both prefixes are restored.
The finite coordinates compare only J_1,...,J_n with the length-(n+1) path. -/
theorem content_prefix_siblings (D : Tower k AA) (J : (i : ℕ) → AA (i + 1))
    (hJ : IsSeparating D J) (n : ℕ) :
    (∀ t : TowerPath D (n + 1), ∀ i : Fin n,
      contentVector D (initialSequence J (n + 1)) t ⟨i.val, by omega⟩ =
        contentVector D (initialSequence J n) (towerPrefix D t n (by omega)) i) ∧
    (∀ s t : TowerPath D (n + 1), towerPrefix D s n (by omega) = towerPrefix D t n (by omega) →
      s ≠ t → lastContent D J s ≠ lastContent D J t) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
