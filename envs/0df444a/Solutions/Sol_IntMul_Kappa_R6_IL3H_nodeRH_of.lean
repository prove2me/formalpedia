theorem nodeVL1_keys (c : Cfg) (K S0 r E B : ℕ) (p : Fin HS × ℤ) (hp : p ∈ nodeVL1 c K S0 r E B) :
    p.1 ∈ [wF, wB, wR0, wKF, w1, vF] := by
  simp only [nodeVL1, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem nodeVL2_keys (c : Cfg) (t S0 r E B : ℕ) (p : Fin HS × ℤ) (hp : p ∈ nodeVL2 c t S0 r E B) :
    p.1 ∈ [(26 : Fin HS), wL, wV, 21, 23, 25] := by
  simp only [nodeVL2, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem nodeVL1_nodup (c : Cfg) (K S0 r E B : ℕ) : ((nodeVL1 c K S0 r E B).map Prod.fst).Nodup := by
  simp only [nodeVL1, List.map_cons, List.map_nil]; decide

theorem nodeVL2_nodup (c : Cfg) (t S0 r E B : ℕ) : ((nodeVL2 c t S0 r E B).map Prod.fst).Nodup := by
  simp only [nodeVL2, List.map_cons, List.map_nil]; decide

theorem σNodeH_ne {σ : Fin HS → Option ℤ} {c : Cfg} {K t S0 r E B : ℕ} {i : Fin HS}
    (hi : i ∉ [wF, wB, wR0, wKF, w1, vF, (26 : Fin HS), wL, wV, 21, 23, 25]) :
    σNodeH σ c K t S0 r E B i = σ i := by
  unfold σNodeH
  rw [σPush_ne _ _ _ (fun p hp hpi => hi (by
      have := nodeVL2_keys c t S0 r E B p hp; rw [hpi] at this
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this ⊢; tauto)),
    σPush_ne _ _ _ (fun p hp hpi => hi (by
      have := nodeVL1_keys c K S0 r E B p hp; rw [hpi] at this
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this ⊢; tauto))]

theorem σNodeH_val2 {σ : Fin HS → Option ℤ} {c : Cfg} {K t S0 r E B : ℕ} {i : Fin HS} {v : ℤ}
    (hv : (i, v) ∈ nodeVL2 c t S0 r E B) : σNodeH σ c K t S0 r E B i = some v :=
  σPush_mem _ _ _ _ (nodeVL2_nodup c t S0 r E B) hv

theorem σNodeH_val1 {σ : Fin HS → Option ℤ} {c : Cfg} {K t S0 r E B : ℕ} {i : Fin HS} {v : ℤ}
    (hv : (i, v) ∈ nodeVL1 c K S0 r E B) (hi : i ∉ [(26 : Fin HS), wL, wV, 21, 23, 25]) :
    σNodeH σ c K t S0 r E B i = some v := by
  unfold σNodeH
  rw [σPush_ne _ _ _ (fun p hp hpi => hi (by
      have := nodeVL2_keys c t S0 r E B p hp; rw [hpi] at this; exact this))]
  exact σPush_mem _ _ _ _ (nodeVL1_nodup c K S0 r E B) hv

