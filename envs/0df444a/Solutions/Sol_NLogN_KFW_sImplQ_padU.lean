theorem mv_fsp {X Y : Fin HS} (hXY : X ≠ Y) (hX : X.val < 56) (hY : Y.val < 56)
    (hXc : X ≠ c1) (hYc : Y ≠ c1) (s : IState HS)
    (f : Fin HS → List ℤ) (L l : List ℤ) (hf : f X = L ++ l) (w : ℕ) (hL : Bnd w L) :
    FSp (NLogN.mvK X Y c1 (.lit (L.length : ℤ))) (encK s f)
      (encK s (Function.update (Function.update f X l) Y (L.reverse ++ f Y))) (cMv L.length w) := by
  have H := FSp.mvK (X := X) (Y := Y) (C := c1) hXY hXc hYc hX hY (by decide) s f
    (.lit (L.length : ℤ)) (clean_lit _) trivial L l hf rfl w hL
  refine H.mono (le_of_eq ?_)
  unfold cMv
  simp [Ex.cost]

theorem gflat_zeros (k : ℕ) : gflat (List.replicate k ((0, 0) : GI)) = List.replicate (2 * k) 0 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [List.replicate_succ, gflat_cons, ih, show 2 * (k + 1) = 2 * k + 1 + 1 by ring,
      List.replicate_succ, List.replicate_succ]

end NLogN.KFN

