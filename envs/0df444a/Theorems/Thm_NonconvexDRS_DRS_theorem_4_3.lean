-- title:
--   Theorem 4.3, p. 13 — DRS residuals vanish at rate o(1/√k); u^k, v^k share stationary cluster points with φ = lim φ^DR_γ(s^k); level-bounded φ gives bounded iterates
-- statement:
--   Suppose Assumption I holds: $\varphi_1:\mathbb R^p\to\mathbb R$ is $L$-smooth ($L>0$) and $\sigma$-hypoconvex with $\sigma\in[-L,L]$, $\varphi_2:\mathbb R^p\to\overline{\mathbb R}$ is proper and lower semicontinuous, and $\varphi=\varphi_1+\varphi_2$ has a minimizer. Let the stepsize $\gamma>0$ and relaxation $\lambda$ lie in the ranges of Theorem 4.1: either $\lambda\in(0,2)$ and $\gamma<\min\{\frac{2-\lambda}{2[\sigma]_-},\frac1L\}$, or $\sigma>0$, $2\le\lambda<\frac4{1+\sqrt{1-p}}$ and $\frac{p\lambda-\delta}{4\sigma}<\gamma<\frac{p\lambda+\delta}{4\sigma}$, with $p=\sigma/L$ and $\delta=\sqrt{(p\lambda)^2-8p(\lambda-2)}$. Let $(s^k,u^k,v^k)_{k\in\mathbb N}$ be any sequence generated by DRS,
--   $$u^k\in\operatorname{prox}_{\gamma\varphi_1}(s^k),\qquad v^k\in\operatorname{prox}_{\gamma\varphi_2}(2u^k-s^k),\qquad s^{k+1}=s^k+\lambda(v^k-u^k),$$
--   from an arbitrary $s^0\in\mathbb R^p$. Then:
--
--   1. the residual vanishes with rate $\min_{i\le k}\|u^i-v^i\|=o(1/\sqrt k)$;
--   2. $(u^k)$ and $(v^k)$ have the same cluster points; every such cluster point $u'$ is stationary for $\varphi$, i.e. $0\in\hat\partial\varphi(u')$; and the limit $\varphi_\star=\lim_k\varphi^{\mathrm{DR}}_\gamma(s^k)$ exists, is finite, and equals $\varphi(u')$ for every cluster point $u'$;
--   3. if $\varphi$ is level bounded, then $(s^k)$, $(u^k)$ and $(v^k)$ are bounded.
--
--   This is the paper's convergence result for nonconvex DRS: it holds for every relaxation $\lambda\in(0,2)$ and, when $\varphi_1$ is strongly convex, beyond $\lambda=2$, under stepsize bounds that Theorem 4.7 shows to be tight.
--
--   **Formalization Note** Rate (i) is $\sqrt k\cdot\min_{i\le k}\|u^i-v^i\|\to0$. "Stationary" is $0\in\hat\partial\varphi(u')$ in the regular (Fréchet) subdifferential of $\varphi$ as an $\overline{\mathbb R}$-valued function, which is what the proof establishes and is stronger than limiting stationarity. Cluster points are `MapClusterPt` points. The page's closing sentence of (ii), "In fact, for each $k$ one has $\operatorname{dist}(0,\hat\partial\varphi(v^k))\le\frac{1-\gamma\sigma}{2\gamma}\|u^k-v^k\|$", is false as printed (for $\varphi_1\equiv0$, $\varphi_2=\frac a2x^2$ the distance is $\|u^k-v^k\|/\gamma$) and is not part of this statement; the separate item `theorem_4_3_ii_dist` states it with the constant $\frac{1-\gamma\sigma}{\gamma}$. Reciprocal bounds are multiplied out. The added hypothesis $L>0$ is needed for $p=\sigma/L$; $L=0$ makes $\varphi_1$ affine. No a-priori decrease, summability or boundedness is assumed.
-- source:
--   Themelis & Patrinos, Douglas-Rachford splitting and ADMM for nonconvex optimization: tight convergence results, arXiv:1709.05747v4, p. 13, Theorem 4.3 (without the "In fact" sentence of (ii))

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexDRS_DRS_Setting

open NonconvexSplitting.Shared
open Filter Topology
open scoped InnerProductSpace

namespace NonconvexDRS.DRS

/-- Theorem 4.3 (Subsequential convergence), p. 13, without the "In fact" sentence of (ii)
(see `theorem_4_3_ii_dist`). -/
theorem theorem_4_3 {p : ℕ} (φ₁ : EuclideanSpace ℝ (Fin p) → ℝ) (φ₂ : EuclideanSpace ℝ (Fin p) → EReal)
    (L σ : ℝ) (hL : 0 < L) (hσ : -L ≤ σ ∧ σ ≤ L)
    (hsmooth : IsLSmooth φ₁ L) (hhypo : IsHypoconvex φ₁ σ)
    (hprop : IsProper φ₂) (hlsc : LowerSemicontinuous φ₂)
    (hsol : ∃ xs, ∀ x, (φ₁ xs : EReal) + φ₂ xs ≤ (φ₁ x : EReal) + φ₂ x)
    (γ lam : ℝ) (hγ : 0 < γ) (hrange : StepRange L σ γ lam)
    (s u v : ℕ → EuclideanSpace ℝ (Fin p)) (hrun : IsDRSRun φ₁ φ₂ γ lam s u v) :
    Tendsto (fun k : ℕ => Real.sqrt (k : ℝ) *
        (Finset.range (k + 1)).inf' Finset.nonempty_range_add_one (fun i => ‖u i - v i‖))
      atTop (𝓝 0) ∧
    ({y | MapClusterPt y atTop u} = {y | MapClusterPt y atTop v} ∧
      (∀ y, MapClusterPt y atTop u → IsRegularSubgrad (phi φ₁ φ₂) y 0) ∧
      ∃ φstar : ℝ, Tendsto (fun k => dre φ₁ φ₂ γ (s k)) atTop (𝓝 (φstar : EReal)) ∧
        ∀ y, MapClusterPt y atTop u → phi φ₁ φ₂ y = φstar) ∧
    (LevelBounded (phi φ₁ φ₂) →
      Bornology.IsBounded (Set.range s) ∧ Bornology.IsBounded (Set.range u) ∧
        Bornology.IsBounded (Set.range v)) := by sorry

end NonconvexDRS.DRS
