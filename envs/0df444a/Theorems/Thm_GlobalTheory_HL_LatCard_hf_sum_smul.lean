theorem GlobalTheory.HL.LatCard.hf_sum_smul (L : LocE F E) {n k : ℕ} (Hm : Matrix (Fin n) (Fin n) E)
    (c : Fin k → E) (b : Fin k → Fin n → E) (y : Fin n → E) :
    hf L Hm (∑ i, c i • b i) y = ∑ i, c i * hf L Hm (b i) y := by sorry
