    Function.Injective
      (algebraMap K[X] (integralClosure K[X] E)) := by
  intro x y h
  apply functionFieldPolynomial_algebraMap_injective (K := K) (E := E)
  calc
    algebraMap K[X] E x =
        algebraMap (integralClosure K[X] E) E
