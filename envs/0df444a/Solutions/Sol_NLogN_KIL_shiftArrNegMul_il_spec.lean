    (hx0 : 0 ≤ x.eval t) (hx1 : x.eval t < Q) (hy0 : 0 ≤ y.eval t) (hy1 : y.eval t < Q)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) : (mAdd Q x y).Bnd t Bb := by
  have e1 : zsz (x.eval t + y.eval t) ≤ Bb := NLogN.KIL.zsz_le_of_abs (by omega) hQ
  have e2 : zsz (-(Q : ℤ)) ≤ Bb := NLogN.KIL.zsz_le_of_abs (by omega) hQ
  have e3 : zsz (x.eval t + y.eval t + -(Q : ℤ)) ≤ Bb := NLogN.KIL.zsz_le_of_abs (by omega) hQ
  refine ⟨⟨⟨hx, hy, e1⟩, e2, e3⟩, ?_⟩
  split_ifs
  · exact ⟨hx, hy, e1⟩
  · exact ⟨⟨hx, hy, e1⟩, e2, e3⟩

theorem mAdd_size (Q : ℕ) (i j : Fin HS) : (mAdd Q (.reg i) (.reg j)).size = 14 := rfl
theorem mAdd_size' (Q : ℕ) (i : Fin HS) (c : ℤ) : (mAdd Q (.reg i) (.lit c)).size = 14 := rfl

section Proofs

variable (s : IState HS) {Q Bb : ℕ}

theorem zsz_lt_Q {v : ℤ} (h0 : 0 ≤ v) (h1 : v < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) :
    zsz v ≤ Bb := NLogN.KIL.zsz_le_of_abs (by omega) hQ

theorem gInner_sp (K : NLogN.KIL.KS) (v sv : ℤ) (rest A0 Z0 O0 : List ℤ) (hv0 : 0 ≤ v) (hv1 : v < Q)
    (hs0 : 0 ≤ sv) (hs1 : sv < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) :
    Sp (gInner Q) (NLogN.KIL.encK s (toF {K with w := v :: rest, a := A0, c := Z0, o := sv :: O0}))
      (NLogN.KIL.encK s (toF {K with w := rest, a := v :: A0, c := ((v + sv) % Q) :: Z0, o := sv :: O0}))
      (cInner Bb) := by
  set R : KS := {K with w := v :: rest, a := A0, c := Z0, o := sv :: O0}
  have h14 : toF R 14 = v :: rest := rfl
  have h12 : toF R 12 = sv :: O0 := rfl
  have hc : (mAdd Q (.reg 14) (.reg 12)).Clean :=
    mAdd_clean Q (clean_reg (by decide)) (clean_reg (by decide))
  have p1 := Sp.push s (toF R) (i := 11) (e := mAdd Q (.reg 14) (.reg 12)) (B := Bb) (by decide) hc
    (mAdd_ok (ok_reg h14) (ok_reg h12)) (mAdd_lin Q trivial trivial)
    (mAdd_bnd (bnd_reg h14 (zsz_lt_Q hv0 hv1 hQ)) (bnd_reg h12 (zsz_lt_Q hs0 hs1 hQ))
      (by rw [eval_reg h14]; exact hv0) (by rw [eval_reg h14]; exact hv1)
      (by rw [eval_reg h12]; exact hs0) (by rw [eval_reg h12]; exact hs1) hQ)
  have ev : (mAdd Q (.reg 14) (.reg 12)).eval (NLogN.KIL.encK s (toF R)) = (v + sv) % Q := by
    rw [mAdd_eval, eval_reg h14, eval_reg h12]; exact mod_of_sel hv0 hv1 hs0 hs1
  rw [ev, upd_c] at p1
  set R1 : KS := {R with c := (v + sv) % Q :: toF R 11}
  have h14' : toF R1 14 = v :: rest := rfl
  have p2 := Sp.push s (toF R1) (i := 10) (e := .reg 14) (B := Bb) (by decide)
    (clean_reg (by decide)) (ok_reg h14') trivial (bnd_reg h14' (zsz_lt_Q hv0 hv1 hQ))
  rw [eval_reg h14', upd_a] at p2
  set R2 : KS := {R1 with a := v :: toF R1 10}
  have p3 := Sp.pop s (toF R2) (i := 14) (l := rest) (B := Bb) (by decide) rfl
    (zsz_lt_Q hv0 hv1 hQ)
  rw [upd_w] at p3
  exact (p1.seq (p2.seq p3)).mono (by simp only [cInner, Ex.size, mAdd_size]; omega)

theorem gInnerL_sp (K : NLogN.KIL.KS) (T W A0 Z0 O0 : List ℤ) (sv : ℤ) (hT : InR Q T) (hs0 : 0 ≤ sv)
    (hs1 : sv < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) :
    Sp (.rep 31 (.lit T.length) (gInner Q))
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := A0, c := Z0, o := sv :: O0, k1 := []}))
      (NLogN.KIL.encK s (toF {K with w := W, a := T.reverse ++ A0, c := (shT Q sv T).reverse ++ Z0, o := sv :: O0, k1 := []}))
      (cInnerL T.length Bb) := by
  have H := Sp.rep (C := 31) (n := .lit (T.length : ℤ)) (b := gInner Q) (s := s)
    (F := fun k => toF {K with w := T.drop k ++ W, a := (T.take k).reverse ++ A0, c := (shT Q sv (T.take k)).reverse ++ Z0, o := sv :: O0, k1 := []})
    (N := T.length) (B := Bb) (c := cInner Bb) (by decide) (fun _ => rfl)
    (by simp [gInner, RS.writes])
    (clean_lit _) trivial trivial hM rfl (fun k hk => by
      rw [upd_k1, upd_k1]
      dsimp only
      have hd := List.drop_eq_getElem_cons hk
      have hv := hT _ (List.getElem_mem hk)
      have := gInner_sp s ({K with k1 := [(T.length : ℤ) - k]} : NLogN.KIL.KS) (T[k]) sv (T.drop (k+1) ++ W)
        ((T.take k).reverse ++ A0) ((shT Q sv (T.take k)).reverse ++ Z0) O0 hv.1 hv.2 hs0 hs1 hQ
      have e1 : T.drop k ++ W = T[k] :: (T.drop (k + 1) ++ W) := by rw [hd]; rfl
      have e2 : (T.take (k + 1)).reverse ++ A0 = T[k] :: ((T.take k).reverse ++ A0) := by
        rw [List.take_succ_eq_append_getElem hk, List.reverse_append]; rfl
      have e3 : (shT Q sv (T.take (k + 1))).reverse ++ Z0 =
          ((T[k] + sv) % Q) :: ((shT Q sv (T.take k)).reverse ++ Z0) := by
        rw [List.take_succ_eq_append_getElem hk, shT, shT, List.map_append, List.reverse_append]; rfl
      rw [e1, e2, e3]
      exact this)
  simpa [cInnerL, Ex.size, shT] using H

theorem bnd_InR {T : List ℤ} (hT : InR Q T) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) : Bnd Bb T :=
  fun v hv => zsz_lt_Q (hT v hv).1 (hT v hv).2 hQ

theorem gBody_sp (K : NLogN.KIL.KS) (T W A0 Z0 O0 : List ℤ) (sv : ℤ) (c : ℕ) (hc : c < Q) (hT : InR Q T)
    (hs0 : 0 ≤ sv) (hs1 : sv < Q) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb)
    (hM : zsz (T.length : ℤ) ≤ Bb) :
    Sp (gBody Q c T.length)
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := A0, c := Z0, o := sv :: O0, k1 := []}))
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := A0, c := (shT Q sv T).reverse ++ Z0, o := ((sv + c) % Q) :: O0, k1 := []}))
      (cBody T.length Bb) := by
  have L1 := gInnerL_sp s K T W A0 Z0 O0 sv hT hs0 hs1 hQ hM
  set K1 : KS := {K with w := W, a := T.reverse ++ A0, c := (shT Q sv T).reverse ++ Z0, o := sv :: O0, k1 := []}
  have L2 := Sp.mvK (X := 10) (Y := 14) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF K1) (.lit (T.length : ℤ)) (clean_lit _) trivial T.reverse A0 rfl
    (by simp [Ex.eval]) Bb (NLogN.KIL.bnd_reverse (bnd_InR hT hQ)) trivial hM
  rw [upd_a, upd_w, List.reverse_reverse] at L2
  set K2 : KS := {{K1 with a := A0} with w := T ++ toF {K1 with a := A0} 14}
  have h12 : toF K2 12 = sv :: O0 := rfl
  have hcQ : zsz (c : ℤ) ≤ Bb := zsz_lt_Q (by positivity) (by exact_mod_cast hc) hQ
  have L3 := Sp.asg (i := 12) (e := mAdd Q (.reg 12) (.lit (c : ℤ))) s (toF K2) (by decide) h12
    (zsz_lt_Q hs0 hs1 hQ) (mAdd_clean Q (clean_reg (by decide)) (clean_lit _))
    (mAdd_ok (ok_reg h12) trivial) (mAdd_lin Q trivial trivial)
    (mAdd_bnd (bnd_reg h12 (zsz_lt_Q hs0 hs1 hQ)) hcQ (by rw [eval_reg h12]; exact hs0)
      (by rw [eval_reg h12]; exact hs1) (by simp [Ex.eval]) (by simp [Ex.eval]; exact hc) hQ)
  have ev : (mAdd Q (.reg 12) (.lit (c : ℤ))).eval (NLogN.KIL.encK s (toF K2)) = (sv + c) % Q := by
    rw [mAdd_eval, eval_reg h12]; simp only [Ex.eval]; exact mod_of_sel hs0 hs1 (by positivity) (by exact_mod_cast hc)
  rw [ev, upd_o] at L3
  refine (L1.seq (L2.seq L3)).mono ?_
  simp only [cBody, Ex.size, mAdd_size', List.length_reverse]
  omega

theorem gOuter_sp (K : NLogN.KIL.KS) (T W O0 : List ℤ) (a c : ℕ) (hc : c < Q) (hT : InR Q T)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) (ha : zsz (a : ℤ) ≤ Bb) :
    Sp (.rep 30 (.lit a) (gBody Q c T.length))
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := [], c := [], o := 0 :: O0, k0 := [], k1 := []}))
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := [], c := (stg Q a c T).reverse, o := (((c : ℤ) * a) % Q) :: O0, k0 := [], k1 := []}))
      (cOuter a T.length Bb) := by
  have hQ0 : (0 : ℤ) < Q := by exact_mod_cast (show 0 < Q by omega)
  have H := Sp.rep (C := 30) (n := .lit (a : ℤ)) (b := gBody Q c T.length) (s := s)
    (F := fun d => toF {K with w := T ++ W, a := [], c := (stgP Q c T d).reverse, o := (((c : ℤ) * d) % Q) :: O0, k0 := [], k1 := []})
    (N := a) (B := Bb) (c := cBody T.length Bb) (by decide) (fun _ => rfl)
    (by simp [gBody, gInner, RS.writes, NLogN.mvK])
    (clean_lit _) trivial trivial ha rfl (fun d hd => by
      rw [upd_k0, upd_k0]
      dsimp only
      have h0 : 0 ≤ ((c : ℤ) * d) % Q := Int.emod_nonneg _ (by omega)
      have h1 : ((c : ℤ) * d) % Q < Q := Int.emod_lt_of_pos _ hQ0
      have := gBody_sp s ({K with k0 := [(a : ℤ) - d]} : NLogN.KIL.KS) T W [] (stgP Q c T d).reverse O0
        (((c : ℤ) * d) % Q) c hc hT h0 h1 hQ hM
      have e1 : (shT Q (((c : ℤ) * d) % Q) T).reverse ++ (stgP Q c T d).reverse =
          (stgP Q c T (d + 1)).reverse := by
        rw [stgP, stgP, List.range_succ, List.flatMap_append, List.reverse_append]; simp
      have e2 : (((c : ℤ) * d) % Q + c) % Q = ((c : ℤ) * ((d + 1 : ℕ) : ℤ)) % Q := by
        rw [Int.emod_add_emod]; push_cast; ring_nf
      rw [e1, e2] at this
      exact this)
  simpa [stgP, stg, cOuter, Ex.size] using H

theorem popL_sp (K : NLogN.KIL.KS) (T W : List ℤ) (hT : Bnd Bb T) (hM : zsz (T.length : ℤ) ≤ Bb) :
    Sp (.rep 31 (.lit T.length) (.pop 14)) (NLogN.KIL.encK s (toF {K with w := T ++ W, k1 := []}))
      (NLogN.KIL.encK s (toF {K with w := W, k1 := []}))
      ((1 + 1) * 2000 * (Bb + 2) + T.length * ((2 * Bb + 2) + 8000 * (Bb + 2) + 30) + 32) := by
  have H := Sp.rep (C := 31) (n := .lit (T.length : ℤ)) (b := .pop 14) (s := s)
    (F := fun k => toF {K with w := T.drop k ++ W, k1 := []})
    (N := T.length) (B := Bb) (c := 2 * Bb + 2) (by decide) (fun _ => rfl) (by decide)
    (clean_lit _) trivial trivial hM rfl (fun k hk => by
      rw [upd_k1, upd_k1]
      dsimp only
      have hd := List.drop_eq_getElem_cons hk
      have := Sp.pop (i := 14) s (toF {K with w := T.drop k ++ W, k1 := [(T.length : ℤ) - k]})
        (a := T[k]) (l := T.drop (k + 1) ++ W) (B := Bb) (by decide)
        (by show T.drop k ++ W = _; rw [hd]; rfl) (hT _ (List.getElem_mem hk))
      rw [upd_w] at this
      exact this)
  simpa [Ex.size] using H

theorem InR_shT {T : List ℤ} (sv : ℤ) (hQ : 0 < Q) : InR Q (shT Q sv T) := by
  intro v hv
  simp only [shT, List.mem_map] at hv
  obtain ⟨w, -, rfl⟩ := hv
  exact ⟨Int.emod_nonneg _ (by omega), Int.emod_lt_of_pos _ (by omega)⟩

theorem InR_stg (a c : ℕ) (T : List ℤ) (hQ : 0 < Q) : InR Q (stg Q a c T) := by
  intro v hv
  simp only [stg, List.mem_flatMap] at hv
  obtain ⟨d, -, hv⟩ := hv
  exact InR_shT _ hQ v hv

theorem length_stg (a c : ℕ) (T : List ℤ) : (stg Q a c T).length = a * T.length := by
  rw [stg, length_fm_const _ _ T.length (fun d _ => by simp [shT])]; simp

theorem gStage_sp (K : NLogN.KIL.KS) (T W : List ℤ) (a c : ℕ) (hc : c < Q) (hT : InR Q T)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hM : zsz (T.length : ℤ) ≤ Bb) (ha : zsz (a : ℤ) ≤ Bb)
    (haM : zsz ((a * T.length : ℕ) : ℤ) ≤ Bb) :
    Sp (gStage Q a c T.length)
      (NLogN.KIL.encK s (toF {K with w := T ++ W, a := [], c := [], k0 := [], k1 := []}))
      (NLogN.KIL.encK s (toF {K with w := stg Q a c T ++ W, a := [], c := [], k0 := [], k1 := []}))
      (cStage a T.length Bb) := by
  have hQ0 : 0 < Q := by omega
  set K0 : KS := {K with w := T ++ W, a := [], c := [], k0 := [], k1 := []}
  have L1 := Sp.push s (toF K0) (i := 12) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial
    trivial (by simp [Ex.Bnd, zsz_zero])
  rw [upd_o] at L1
  have L2 := gOuter_sp s K T W K.o a c hc hT hQ hM ha
  have h0 : 0 ≤ ((c : ℤ) * a) % Q := Int.emod_nonneg _ (by omega)
  have h1 : ((c : ℤ) * a) % Q < Q := Int.emod_lt_of_pos _ (by omega)
  set K2 : KS := {K with w := T ++ W, a := [], c := (stg Q a c T).reverse, o := (((c : ℤ) * a) % Q) :: K.o, k0 := [], k1 := []}
  have L3 := Sp.pop (i := 12) s (toF K2) (a := ((c : ℤ) * a) % Q) (l := K.o) (B := Bb) (by decide)
    rfl (zsz_lt_Q h0 h1 hQ)
  rw [upd_o] at L3
  have L4 := popL_sp s {K2 with o := K.o} T W (bnd_InR hT hQ) hM
  set K4 : KS := {K2 with o := K.o, w := W, k1 := []}
  have L5 := Sp.mvK (X := 11) (Y := 14) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF K4) (.lit ((a * T.length : ℕ) : ℤ)) (clean_lit _) trivial
    (stg Q a c T).reverse [] (by simp [K4, K2]) (by simp [Ex.eval, length_stg]) Bb
    (NLogN.KIL.bnd_reverse (bnd_InR (InR_stg a c T hQ0) hQ)) trivial haM
  rw [upd_c, upd_w, List.reverse_reverse] at L5
  refine (L1.seq (L2.seq (L3.seq (L4.seq L5)))).mono ?_
  simp only [cStage, Ex.size, List.length_reverse, length_stg]
  omega

theorem length_tbl : ∀ ac : List (ℕ × ℕ), (NLogN.KIL.tbl Q ac).length = AModel.vol (ac.map Prod.fst)
  | [] => rfl
  | (a, c) :: ac => by
    rw [NLogN.KIL.tbl, length_stg, length_tbl ac]; simp [vol_cons]

theorem InR_tbl (hQ : 0 < Q) : ∀ ac : List (ℕ × ℕ), InR Q (NLogN.KIL.tbl Q ac)
  | [] => by intro v hv; simp [NLogN.KIL.tbl] at hv; subst hv; exact ⟨le_rfl, by exact_mod_cast hQ⟩
  | (a, c) :: ac => InR_stg a c _ hQ

theorem vol_le_of_pos : ∀ (A : Shape), (∀ a ∈ A, 1 ≤ a) → 1 ≤ AModel.vol A
  | [], _ => le_rfl
  | a :: A, h => by
    rw [vol_cons]
    exact Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by have := h a (by simp); omega)
      (by have := vol_le_of_pos A (fun b hb => h b (by simp [hb])); omega))

theorem genP_sp (K : NLogN.KIL.KS) (W : List ℤ) (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hQ0 : 0 < Q) :
    ∀ ac : List (ℕ × ℕ), (∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q) →
      zsz ((AModel.vol (ac.map Prod.fst) : ℕ) : ℤ) ≤ Bb →
      Sp (genP Q ac)
        (NLogN.KIL.encK s (toF {K with w := W, a := [], c := [], k0 := [], k1 := []}))
        (NLogN.KIL.encK s (toF {K with w := NLogN.KIL.tbl Q ac ++ W, a := [], c := [], k0 := [], k1 := []}))
        (genCost Bb ac)
  | [], _, _ => by
    have := Sp.push s (toF {K with w := W, a := [], c := [], k0 := [], k1 := []}) (i := 14)
      (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial trivial (by simp [Ex.Bnd, zsz_zero])
    rw [upd_w] at this
    rw [show NLogN.KIL.tbl Q [] = [0] from rfl]
    exact this
  | (a, c) :: ac, hac, hV => by
    have h1 : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q := fun p hp => hac p (by simp [hp])
    have ha := hac (a, c) (by simp)
    have hv1 : 1 ≤ AModel.vol (ac.map Prod.fst) :=
      vol_le_of_pos _ (fun b hb => by
        simp only [List.mem_map] at hb; obtain ⟨p, hp, rfl⟩ := hb; exact (h1 p hp).1)
    have hvol : AModel.vol (((a, c) :: ac).map Prod.fst) = a * AModel.vol (ac.map Prod.fst) := by
      simp [vol_cons]
    rw [hvol] at hV
    have hV' : zsz ((AModel.vol (ac.map Prod.fst) : ℕ) : ℤ) ≤ Bb :=
      le_trans (NLogN.KIL.zsz_nat_le (Nat.le_mul_of_pos_left _ (by omega))) hV
    have ha' : zsz (a : ℤ) ≤ Bb := le_trans (NLogN.KIL.zsz_nat_le (Nat.le_mul_of_pos_right _ (by omega))) hV
    have L1 := genP_sp K W hQ hQ0 ac h1 hV'
    have L2 := gStage_sp s K (NLogN.KIL.tbl Q ac) W a c ha.2 (InR_tbl hQ0 ac) hQ
      (by rw [NLogN.KIL.length_tbl]; exact hV') ha' (by rw [NLogN.KIL.length_tbl]; exact hV)
    rw [NLogN.KIL.length_tbl] at L2
    exact L1.seq L2

theorem cStage_le (a M Bb : ℕ) :
    cStage a M Bb ≤ 100000 * (a * M + a + M + 1) * (Bb + 2) := by
  simp only [cStage, cOuter, cBody, cInnerL, cInner]
  nlinarith [Nat.zero_le (a * M * Bb), Nat.zero_le (a * Bb), Nat.zero_le (M * Bb)]

theorem genCost_le (Bb : ℕ) : ∀ ac : List (ℕ × ℕ), (∀ p ∈ ac, 1 ≤ p.1) →
    genCost Bb ac ≤ 400000 * (ac.length + 1) * AModel.vol (ac.map Prod.fst) * (Bb + 2)
  | [], _ => by simp [genCost, AModel.vol]
  | (a, c) :: ac, h => by
    have h1 : ∀ p ∈ ac, 1 ≤ p.1 := fun p hp => h p (by simp [hp])
    have ha : 1 ≤ a := h (a, c) (by simp)
    have IH := genCost_le Bb ac h1
    have hv1 : 1 ≤ AModel.vol (ac.map Prod.fst) :=
      vol_le_of_pos _ (fun b hb => by
        simp only [List.mem_map] at hb; obtain ⟨p, hp, rfl⟩ := hb; exact h1 p hp)
    have hS := cStage_le a (AModel.vol (ac.map Prod.fst)) Bb
    simp only [genCost, List.map_cons, vol_cons, List.length_cons]
    set M := AModel.vol (ac.map Prod.fst)
    set n := ac.length
    have e1 : a * M + a + M + 1 ≤ 4 * (a * M) := by nlinarith
    have e2 : M ≤ a * M := Nat.le_mul_of_pos_left _ ha
    have e3 : 100000 * (a * M + a + M + 1) * (Bb + 2) ≤ 400000 * (a * M) * (Bb + 2) := by
      have := Nat.mul_le_mul_right (Bb + 2) (Nat.mul_le_mul_left 100000 e1); nlinarith
    have e4 : 400000 * (n + 1) * M * (Bb + 2) ≤ 400000 * (n + 1) * (a * M) * (Bb + 2) := by
      gcongr
    nlinarith

end Proofs

theorem toF_empty : toF ({} : NLogN.KIL.KS) = fun _ => [] := by
  funext j; fin_cases j <;> rfl

theorem encK_empty (s : IState HS) : NLogN.KIL.encK s (toF ({} : NLogN.KIL.KS)) = s := by
  rw [toF_empty, encK_nil]

theorem encK_w (s : IState HS) (L : List ℤ) :
    NLogN.KIL.encK s (toF ({ w := L } : NLogN.KIL.KS)) = s.upd 14 (ints L ++ s.G 14) := by
  rw [show ({ w := L } : NLogN.KIL.KS) = { ({} : NLogN.KIL.KS) with w := L } from rfl, ← upd_w, ← encK_upd,
    encK_empty]

/-- **The offset-table generator**, stack form. -/
theorem genP_spec (t : IState HS) (Q Bb : ℕ) (ac : List (ℕ × ℕ)) (hQ0 : 0 < Q)
    (hQ : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < Q)
    (hV : zsz ((AModel.vol (ac.map Prod.fst) : ℕ) : ℤ) ≤ Bb) :
    (genP Q ac).ok t ∧ (genP Q ac).run t = t.upd 14 (ints (NLogN.KIL.tbl Q ac) ++ t.G 14) ∧
      (genP Q ac).cost t ≤ 400000 * (ac.length + 1) * AModel.vol (ac.map Prod.fst) * (Bb + 2) := by
  have H := genP_sp t (Q := Q) (Bb := Bb) ({} : NLogN.KIL.KS) [] hQ hQ0 ac hac hV
  have e1 : ({ ({} : NLogN.KIL.KS) with w := [], a := [], c := [], k0 := [], k1 := [] } : NLogN.KIL.KS) = {} := rfl
  have e2 : ({ ({} : NLogN.KIL.KS) with w := NLogN.KIL.tbl Q ac ++ [], a := [], c := [], k0 := [], k1 := [] } : NLogN.KIL.KS) =
      { w := NLogN.KIL.tbl Q ac } := by simp
  rw [e1, e2, encK_empty, encK_w] at H
  exact ⟨H.1, H.2.1, le_trans H.2.2 (genCost_le Bb ac (fun p hp => (hac p hp).1))⟩

theorem div_mod_aux {d j M a : ℕ} (hd : d < a) (hj : j < M) :
    (d * M + j) / M % a = d ∧ (d * M + j) % M = j := by
  have hM : 0 < M := by omega
  constructor
  · rw [Nat.add_comm, Nat.add_mul_div_right _ _ hM, Nat.div_eq_of_lt hj, zero_add,
      Nat.mod_eq_of_lt hd]
  · rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hj]

theorem tbl_zip {Q : ℕ} : ∀ (A cs : List ℕ), A.length = cs.length →
    NLogN.KIL.tbl Q (A.zip cs) = (List.range (AModel.vol A)).map fun p => ((lf cs (decode A p) : ℕ) : ℤ) % Q
  | [], [], _ => by simp [NLogN.KIL.tbl, AModel.vol, decode, lf]
  | a :: A, c :: cs, h => by
    have IH := tbl_zip (Q := Q) A cs (by simpa using h)
    simp only [List.zip_cons_cons, NLogN.KIL.tbl, IH, vol_cons, range_mul, List.map_flatMap, stg]
    refine fm_congr fun d hd => ?_
    rw [List.mem_range] at hd
    simp only [shT, List.map_map]
    refine List.map_congr_left fun j hj => ?_
    rw [List.mem_range] at hj
    obtain ⟨e1, e2⟩ := div_mod_aux (M := AModel.vol A) hd hj
    simp only [Function.comp_apply, decode, e1, e2, lf]
    push_cast
    rw [Int.emod_add_emod, add_comm, Int.emod_add_emod]

theorem lf_eq_sum : ∀ (cs D : List ℕ), cs.length = D.length →
    lf cs D = ∑ k ∈ Finset.range cs.length, cs.getD k 0 * D.getD k 0
  | [], [], _ => by simp [lf]
  | c :: cs, d :: D, h => by
    rw [lf, lf_eq_sum cs D (by simpa using h), List.length_cons, Finset.sum_range_succ']
    simp [add_comm]

