/-- The high-second LP family needs exactly the ratio eta clipped to [1,R].
The expression uses only additions, negations and the available positive part. -/
def clipEta {d : ℕ} (R : ℚ) (b : Expr d) : Expr d :=
  .add (.const 1) (.pos (.add (.add b (.neg (.pos (.add b (.neg (.const R)))))) (.neg (.const 1))))

def peakSecond (m : Regime) (R : ℚ) : Expr 3 :=
  let p := Expr.coord 0
  let z := Expr.add p (.mul (.coord 2) (.add (.const 1) (.neg p)))
  fourth p (.mul (.coord 1) p) z
    (match m with | .canonical => .const 1 | _ => clipEta R (coefficients m p).b)
    (coefficients m p)

theorem eval_clipEta {d : ℕ} (φ : ℝ → ℝ) (R : ℚ) (v : Expr d) (t : Fin d → ℝ) :
    eval φ t (clipEta R v)=max 1 (min (R:ℝ) (eval φ t v)) := by
  let x := eval φ t v
  change ((1:ℚ):ℝ)+max (x+ -(max (x+ -(R:ℝ)) 0)+ -((1:ℚ):ℝ)) 0=_
  norm_num only [Rat.cast_one]
  change 1+max (x+ -(max (x+ -(R:ℝ)) 0)+ -1) 0=max 1 (min (R:ℝ) x)
  have inner : x+ -(max (x+ -(R:ℝ)) 0)=min (R:ℝ) x := by
    rcases le_total x (R:ℝ) with h|h
    · rw [max_eq_right (by linarith),min_eq_right h];ring
    · rw [max_eq_left (by linarith),min_eq_left h];ring
  rw [inner]
  rcases le_total (min (R:ℝ) x) 1 with h|h
  · rw [max_eq_right (by linarith),max_eq_left h];ring
  · rw [max_eq_left (by linarith),max_eq_right h];ring

def peakRatio (m : Regime) (φ : ℝ → ℝ) (R : ℚ) (p : ℝ) : ℝ :=
  match m with | .canonical => 1 | _ => max 1 (min (R:ℝ) (realCoeff m φ p).b)

theorem eval_peakSecond (φ : ℝ → ℝ) (m : Regime) (R : ℚ) (p u v : ℝ) :
    let c := realCoeff m φ p
    eval φ ![p,u,v] (peakSecond m R) =
      highSecond PaperMiddle.lam φ c.beta c.a c.b p (u*p) (p+v*(1-p)) (peakRatio m φ R p) := by
  cases m with
  | canonical =>
    change eval φ ![p,u,v] (reducedSecond .canonical R .one)=_
    exact eval_reducedSecond φ .canonical R .one p u v
  | lp | constant =>
    rw [peakSecond,eval_fourth]
    simp only [eval_clipEta,(eval_coeff φ ![p,u,v] (.coord 0) _).2.2,peakRatio]
    change highSecond _ _ _ _ _ _ _ (p+v*(((1:ℚ):ℝ)+ -p)) _=_
    norm_num only [Rat.cast_one,sub_eq_add_neg]
    rfl
    all_goals decide

private theorem scaled_unit {p u : ℝ} (hp : p∈Icc (0:ℝ) 1) (hu : u∈Icc (0:ℝ) 1) :
    u*p ∈ Icc (0:ℝ) p := ⟨mul_nonneg hu.1 hp.1,by simpa using mul_le_mul_of_nonneg_right hu.2 hp.1⟩

/-- All six high-family ratio checks are implied by just these two functions of
(p,u) and (p,u,v), respectively. -/
theorem high_of_peaks {φ : ℝ → ℝ} {R : ℚ} {p : ℝ} (m : Regime)
    (hs : IsScoreFunction PaperMiddle.lam φ) (hp : p∈Icc (0:ℝ) 1)
    (h₁ : ∀ u∈Icc (0:ℝ) 1,eval φ ![p,u] (reducedFirst m R .maximum) ≤ 0)
    (h₂ : ∀ u∈Icc (0:ℝ) 1,∀ v∈Icc (0:ℝ) 1,eval φ ![p,u,v] (peakSecond m R) ≤ 0) :
    (∀ k,ratioValue m φ R p k ∈ Icc 1 (R:ℝ) →
      ∀ u∈Icc (0:ℝ) 1,eval φ ![p,u] (reducedFirst m R k) ≤ 0) ∧
    (∀ k,ratioValue m φ R p k ∈ Icc 1 (R:ℝ) →
      ∀ u∈Icc (0:ℝ) 1,∀ v∈Icc (0:ℝ) 1,eval φ ![p,u,v] (reducedSecond m R k) ≤ 0) := by
  constructor
  · intro k hr u hu
    have e := h₁ u hu
    rw [eval_reducedFirst] at e ⊢
    have hq := scaled_unit hp hu
    exact (highFirst_at_max hs ⟨hq.1,hq.2.trans hp.2⟩ _ _ _ _
      (by cases m <;> simp [realCoeff]) hr.2).trans e
  · intro k hr u hu v hv
    have e := h₂ u hu v hv
    rw [eval_peakSecond] at e
    rw [eval_reducedSecond]
    have hq := scaled_unit hp hu
    have hv' := scaled_unit (p:=1-p) ⟨sub_nonneg.mpr hp.2,by linarith only [hp.1]⟩ hv
    have hz : p+v*(1-p) ∈ Icc (0:ℝ) 1 := ⟨add_nonneg hp.1 hv'.1,by linarith only [hv'.2]⟩
    have hqz : u*p ≤ p+v*(1-p) := le_trans hq.2 (by linarith only [hv'.1])
    have hl : u*p ∈ Icc (0:ℝ) 1 := ⟨hq.1,hq.2.trans hp.2⟩
    cases m with
    | constant => exact (highSecond_lp_at_clip hs hl hz hqz _ _ _ hr).trans e
    | lp => exact (highSecond_lp_at_clip hs hl hz hqz _ _ _ hr).trans e
    | canonical => exact (highSecond_canonical_at_min hs hl hz hqz _ _ _ hr.1).trans e

structure PeakHigh (m : Regime) (R : ℚ) (p : ℝ) : Prop where
  first : ∀ u∈Icc (0:ℝ) 1,eval PaperCurve.score ![p,u] (reducedFirst m R .maximum) ≤ 0
  second : ∀ u∈Icc (0:ℝ) 1,∀ v∈Icc (0:ℝ) 1,eval PaperCurve.score ![p,u,v] (peakSecond m R) ≤ 0

/-- Canonical masses require only the two high tests, since their first low
family follows from the first high test and their second low family is empty. -/
theorem canonical_of_peaks {R : ℚ} (hR : 1 ≤ R) {p : ℝ} (hp : p∈Icc PaperMiddle.pC PaperMiddle.p1)
    (hh : PeakHigh .canonical R p) : ReducedBoxes PaperCurve.score .canonical .above R p := by
  have hnum : PaperMiddle.lam < PaperMiddle.pC ∧ 0 ≤ PaperMiddle.pC ∧ PaperMiddle.p1 ≤ 1 := by
    norm_num [PaperMiddle.lam,PaperMiddle.pC,PaperMiddle.p1]
  have hss : IsScoreFunction PaperMiddle.lam PaperCurve.score := by
    simpa only [PaperMiddle.lam,PaperCurve.lam,PaperCurve.lamQ,Rat.cast_div,Rat.cast_ofNat] using PaperCurve.score_isScoreFunction
  have high := high_of_peaks .canonical hss ⟨hnum.2.1.trans hp.1,hp.2.trans hnum.2.2⟩ hh.first hh.second
  exact ⟨PaperAnalytic.canonical_L1_of_highFirst hp R
    (high.1 .one ⟨le_rfl,by change (1:ℝ) ≤ (R:ℝ);exact_mod_cast hR⟩),
    fun hl => ((hnum.1.trans_le hp.1).not_ge hl).elim,high.1,high.2⟩

end
end StableVotingDistortion.PaperFamilies
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Set
noncomputable section

/-- Below the crossing at q, the two-variable potential and positive ratio
penalty combine into a single coefficient on the negative part of the score. -/
theorem highSecond_low_form {φ : ℝ → ℝ} {L q z : ℝ} (hs : IsScoreFunction L φ)
    (hq : q ≤ L) (hz : z∈Icc (0:ℝ) 1) (β a b p r : ℝ) :
    highSecond L φ β a b p q z r =
      q+β*KP φ p q z+max (z-L) 0 -loss φ z*(r+max (a*r+b) 0) := by
  have off : offset L z= -max (z-L) 0 := by
    by_cases h : z≤L
    · simp [offset,h,max_eq_right (sub_nonpos.mpr h)]
    · rw [offset,if_neg h,max_eq_left (sub_nonneg.mpr (le_of_not_ge h))];ring
  rw [highSecond,potential_linear_loss hs hz r,off,show potential L φ r q=0 from if_pos hq]
  unfold loss;ring

/-- For every ratio in [1,R] the LP penalty dominates max(1,eta).
At the clipped ratio its value is exactly this number. -/
theorem highSecond_lp_low_peak {φ : ℝ → ℝ} {L q z : ℝ} (hs : IsScoreFunction L φ)
    (hq : q ≤ L) (hz : z∈Icc (0:ℝ) 1) (β b p R : ℝ) (hR : 1 ≤ R) :
    highSecond L φ β (-1) b p q z (max 1 (min R b)) =
      q+β*KP φ p q z+max (z-L) 0 -loss φ z*max 1 b := by
  rw [highSecond_low_form hs hq hz]
  have id (r : ℝ) : r+max (-1*r+b) 0=max r b := by
    rcases le_total b r with h|h
    · rw [max_eq_right (by linarith),max_eq_left h];ring
    · rw [max_eq_left (by linarith),max_eq_right h];ring
  rw [id,max_assoc,max_eq_right (min_le_right R b)]

/-- For the canonical family the worst ratio is one, and the remaining
coefficient depends only on p and the canonical beta. -/
theorem highSecond_canonical_low_peak {φ : ℝ → ℝ} {L q z : ℝ} (hs : IsScoreFunction L φ)
    (hq : q ≤ L) (hz : z∈Icc (0:ℝ) 1) (β p : ℝ) :
    highSecond L φ β 1 (-(β*(1-p))) p q z 1 =
      q+β*KP φ p q z+max (z-L) 0 -loss φ z*(1+max (1-β*(1-p)) 0) := by
  simpa [sub_eq_add_neg] using highSecond_low_form hs hq hz β 1 (-(β*(1-p))) p 1

end
end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set PaperBox PaperBox.Bounds
open PaperCurve (totalPrimitive totalPrimitiveBox totalPrimitiveSlope totalScore totalScoreBox totalScoreSlope)
noncomputable section

def penaltyBox (i : Bounds) : Bounds := (point 1).plus (((entryBox Knot.eta i).minus (point 1)).posPart)
def penaltySlope (i : Bounds) : Bounds :=
  (clipSlope ((entryBox Knot.eta i).minus (point 1))).times (entrySlope Knot.eta i)

theorem penaltyBox_holds {i : Bounds} {p : ℝ} (hp : i.Holds p) : (penaltyBox i).Holds (penaltyLP p) := by
  simpa only [penaltyBox,penaltyLP,Rat.cast_one] using
    plus_holds (point_holds 1) (posPart_holds (minus_holds (entryBox_holds Knot.eta hp) (point_holds 1)))

theorem penaltySlope_secant {i : Bounds} {p t : ℝ} (hp : i.Holds p) (ht : i.Holds t) :
    Secants penaltyLP p t (penaltySlope i) := by
  obtain ⟨s,hs,es⟩ := entrySlope_secant Knot.eta hp ht
  have pre (x : ℝ) (h : i.Holds x) : ((entryBox Knot.eta i).minus (point 1)).Holds (entry Knot.eta x-1) := by
    simpa using minus_holds (entryBox_holds Knot.eta h) (point_holds 1)
  obtain ⟨m,hm,em⟩ := clipSlope_sound (pre p hp) (pre t ht)
  refine ⟨m*s,times_holds hm hs,?_⟩
  dsimp only [penaltyLP] at em ⊢
  linear_combination em + m * es

def physicalKBox (p q z : Bounds) : Bounds :=
  ((totalPrimitiveBox (physicalXBox p q z)).minus (totalPrimitiveBox z)).minus (totalPrimitiveBox q)

theorem physicalX_holds {p q z : ℝ} {i j k : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (hz : k.Holds z) :
    (physicalXBox i j k).Holds (z-p+q) := plus_holds (minus_holds hz hp) hq

theorem physicalK_holds {p q z : ℝ} {i j k : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (hz : k.Holds z) :
    (physicalKBox i j k).Holds (physicalK p q z) :=
  minus_holds (minus_holds (PaperCurve.totalPrimitiveBox_holds (physicalX_holds hp hq hz))
    (PaperCurve.totalPrimitiveBox_holds hz)) (PaperCurve.totalPrimitiveBox_holds hq)

def physicalP (i j k : Bounds) : Bounds :=
  (((entrySlope Knot.beta i).times (physicalKBox i j k)).minus
    ((entryBox Knot.beta i).times (totalPrimitiveSlope (physicalXBox i j k)))).plus
    ((penaltySlope i).times (totalScoreBox k))
def physicalQ (i j k : Bounds) : Bounds :=
  (point 1).plus ((entryBox Knot.beta i).times
    ((totalPrimitiveSlope (physicalXBox i j k)).minus (totalPrimitiveSlope j)))
def physicalZ (i j k : Bounds) : Bounds :=
  ((point 1).plus ((entryBox Knot.beta i).times
    ((totalPrimitiveSlope (physicalXBox i j k)).minus (totalPrimitiveSlope k)))).plus
    ((penaltyBox i).times (totalScoreSlope k))

theorem physicalP_sound {p t q z : ℝ} {i j k : Bounds}
    (hp : i.Holds p) (ht : i.Holds t) (hq : j.Holds q) (hz : k.Holds z) :
    Secants (fun a => physicalResidual a q z) p t (physicalP i j k) := by
  obtain ⟨d,hd,ed⟩ := entrySlope_secant Knot.beta hp ht
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds ht hq hz)
  obtain ⟨s,hs,es⟩ := penaltySlope_secant hp ht
  let B := entry Knot.beta t
  let K := physicalK p q z
  refine ⟨d*K-B*f+s*totalScore z,plus_holds (minus_holds (times_holds hd (physicalK_holds hp hq hz))
    (times_holds (entryBox_holds Knot.beta ht) hf)) (times_holds hs (PaperCurve.totalScoreBox_holds hz)),?_⟩
  dsimp [physicalResidual,B,K,physicalK]
  linear_combination (totalPrimitive (z-p+q)-totalPrimitive z-totalPrimitive q)*ed +
    (entry Knot.beta t)*ef + (totalScore z)*es

theorem physicalQ_sound {p q t z : ℝ} {i j k : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (ht : j.Holds t) (hz : k.Holds z) :
    Secants (fun a => physicalResidual p a z) q t (physicalQ i j k) := by
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds hp ht hz)
  obtain ⟨g,hg,eg⟩ := PaperCurve.totalPrimitive_secant hq ht
  refine ⟨1+entry Knot.beta p*(f-g),plus_holds (by simpa using point_holds 1)
    (times_holds (entryBox_holds Knot.beta hp) (minus_holds hf hg)),?_⟩
  dsimp [physicalResidual,physicalK];linear_combination (entry Knot.beta p)*(ef-eg)

theorem physicalZ_sound {p q z t : ℝ} {i j k : Bounds}
    (hp : i.Holds p) (hq : j.Holds q) (hz : k.Holds z) (ht : k.Holds t) :
    Secants (fun a => physicalResidual p q a) z t (physicalZ i j k) := by
  obtain ⟨f,hf,ef⟩ := PaperCurve.totalPrimitive_secant (physicalX_holds hp hq hz) (physicalX_holds hp hq ht)
  obtain ⟨g,hg,eg⟩ := PaperCurve.totalPrimitive_secant hz ht
  obtain ⟨s,hs,es⟩ := PaperCurve.totalScore_secant hz ht
  refine ⟨1+entry Knot.beta p*(f-g)+penaltyLP p*s,plus_holds (plus_holds (by simpa using point_holds 1)
    (times_holds (entryBox_holds Knot.beta hp) (minus_holds hf hg))) (times_holds (penaltyBox_holds hp) hs),?_⟩
  dsimp [physicalResidual,physicalK];linear_combination (entry Knot.beta p)*(ef-eg)+(penaltyLP p)*es

end
end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperBox
open Bounds

theorem midpoint_inside {b : Bounds} {x : ℝ} (hx : b.Holds x) : b.Holds (midpoint b) := by
  have ho := hx.1.trans hx.2
  simp only [midpoint,Holds,Rat.cast_div,Rat.cast_add,Rat.cast_ofNat]
  constructor <;> linarith

theorem centered_deviation {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    m*(x-(midpoint b:ℝ)) ≤ (((radius b)*max (-s.lo) s.hi:ℚ):ℝ) := by
  have da : |x-(midpoint b:ℝ)| ≤ (radius b:ℝ) := by
    simp only [midpoint,radius,Rat.cast_div,Rat.cast_add,Rat.cast_sub,Rat.cast_ofNat,abs_le]
    constructor <;> linarith only [hx.1,hx.2]
  have ma : |m| ≤ ((max (-s.lo) s.hi:ℚ):ℝ) := by
    rw [Rat.cast_max,Rat.cast_neg,abs_le]
    exact ⟨(neg_le_neg (le_max_left _ _)).trans (by simpa using hm.1),hm.2.trans (le_max_right _ _)⟩
  rw [Rat.cast_mul,mul_comm (radius b:ℝ)]
  exact (le_abs_self _).trans ((abs_mul _ _).le.trans
    (mul_le_mul ma da (abs_nonneg _) ((abs_nonneg _).trans ma)))

end StableVotingDistortion.PaperBox
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox PaperBox.Bounds Set
noncomputable section

def massE : ℚ := 1+1/20000
def baseResidual (p q : ℝ) : ℝ :=
  (massE:ℝ)*p*(J score (1-p+q)-J score q)-(lam-q)*J score p

def rankArg (b c : Bounds) : Bounds := ((point 1).minus b).plus c
def slopeP (b c : Bounds) : Bounds :=
  let x := rankArg b c
  (((point massE).times ((primitiveBox x).minus (primitiveBox c))).minus
     (((point massE).times b).times (scoreBox x))).minus (((point lamQ).minus c).times (scoreBox b))
def slopeQ (b c : Bounds) : Bounds :=
  (((point massE).times b).times ((scoreBox (rankArg b c)).minus (scoreBox c))).plus (primitiveBox b)

def validRectangle (b c : Bounds) : Prop :=
  (16/25:ℚ) ≤ b.lo ∧ b.hi ≤ (99/100:ℚ) ∧ 0 ≤ c.lo ∧ c.hi ≤ lamQ
  deriving Decidable

private theorem domains {b c : Bounds} (d : validRectangle b c)
    {p q : ℝ} (hp : b.Holds p) (hq : c.Holds q) :
    p∈Icc 0 1 ∧ q∈Icc 0 1 ∧ 1-p+q∈Icc 0 1 := by
  obtain ⟨pl,ph,ql,qh⟩ := d
  have h₁ : (16/25:ℝ) ≤ b.lo := by simpa only [Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr pl
  have h₂ : (b.hi:ℝ) ≤ 99/100 := by simpa only [Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr ph
  have h₃ : (0:ℝ) ≤ c.lo := by exact_mod_cast ql
  have h₄ : (c.hi:ℝ) ≤ 703/1250 := by simpa only [lamQ,Rat.cast_div,Rat.cast_ofNat] using (Rat.cast_le (K:=ℝ)).mpr qh
  exact ⟨⟨by linarith [hp.1],by linarith [hp.2]⟩,⟨by linarith [hq.1],by linarith [hq.2]⟩,
    ⟨by linarith [hp.2,hq.1],by linarith [hp.1,hq.2]⟩⟩

private theorem arg_holds {b c : Bounds} {p q : ℝ} (hp : b.Holds p) (hq : c.Holds q) :
    (rankArg b c).Holds (1-p+q) := by
  simpa only [rankArg,Rat.cast_one] using plus_holds (minus_holds (point_holds 1) hp) hq

theorem slopeP_sound {b c : Bounds} (d : validRectangle b c)
    {p t q : ℝ} (hp : b.Holds p) (ht : b.Holds t) (hq : c.Holds q) :
    Secants (fun u => baseResidual u q) p t (slopeP b c) := by
  obtain ⟨pd,qd,xd⟩ := domains d hp hq
  obtain ⟨td,_,yd⟩ := domains d ht hq
  obtain ⟨a,ha,ea⟩ := primitive_secant (arg_holds hp hq) (arg_holds ht hq) xd yd
  obtain ⟨k,hk,ek⟩ := primitive_secant hp ht pd td
  let Δ := J score (1-p+q)-J score q
  have hΔ := minus_holds (primitiveBox_holds (arg_holds hp hq) xd) (primitiveBox_holds hq qd)
  have hL : ((point lamQ).minus c).Holds (lam-q) := minus_holds (point_holds _) hq
  refine ⟨(massE:ℝ)*Δ-(massE:ℝ)*t*a-(lam-q)*k,minus_holds (minus_holds
    (times_holds (point_holds massE) hΔ) (times_holds (times_holds (point_holds massE) ht) ha))
    (times_holds hL hk),?_⟩
  dsimp [baseResidual,Δ]
  linear_combination (massE:ℝ)*t*ea-(lam-q)*ek

theorem slopeQ_sound {b c : Bounds} (d : validRectangle b c)
    {p q t : ℝ} (hp : b.Holds p) (hq : c.Holds q) (ht : c.Holds t) :
    Secants (baseResidual p) q t (slopeQ b c) := by
  obtain ⟨pd,qd,xd⟩ := domains d hp hq
  obtain ⟨_,td,yd⟩ := domains d hp ht
  obtain ⟨a,ha,ea⟩ := primitive_secant (arg_holds hp hq) (arg_holds hp ht) xd yd
  obtain ⟨k,hk,ek⟩ := primitive_secant hq ht qd td
  refine ⟨(massE:ℝ)*p*(a-k)+J score p,plus_holds
    (times_holds (times_holds (point_holds massE) hp) (minus_holds ha hk)) (primitiveBox_holds hp pd),?_⟩
  unfold baseResidual
  linear_combination (massE:ℝ)*p*(ea-ek)

private theorem anchor_spec {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    b.Holds (anchor b s) ∧ m*(x-(anchor b s:ℝ)) ≤ (deviation b s:ℝ) := by
  have ord := hx.1.trans hx.2
  by_cases h : 0 ≤ s.lo
  · have h0 : (0:ℝ) ≤ s.lo := by exact_mod_cast h
    simpa [anchor,deviation,h,Holds] using And.intro (And.intro ord (le_refl (b.hi:ℝ)))
      (mul_nonpos_of_nonneg_of_nonpos (h0.trans hm.1) (sub_nonpos.mpr hx.2))
  by_cases n : s.hi ≤ 0
  · have h0 : (s.hi:ℝ) ≤ 0 := by exact_mod_cast n
    simpa [anchor,deviation,n,h,Holds] using And.intro (And.intro (le_refl (b.lo:ℝ)) ord)
      (mul_nonpos_of_nonpos_of_nonneg (hm.2.trans h0) (sub_nonneg.mpr hx.1))
  exact ⟨by simpa [anchor,h,n] using midpoint_inside hx,by simpa [anchor,deviation,h,n] using centered_deviation hx hm⟩

def qResidual (p q : ℚ) : ℚ :=
  massE*p*(qprimitive (1-p+q)-qprimitive q)-(lamQ-q)*qprimitive p

private theorem qResidual_cast {p q : ℚ} (hp : (p:ℝ)∈Icc 0 1)
    (hq : (q:ℝ)∈Icc 0 1) (hx : 1-(p:ℝ)+(q:ℝ)∈Icc 0 1) :
    (qResidual p q:ℝ)=baseResidual p q := by
  simp [qResidual,baseResidual,qprimitive_exact,← J_score hp,← J_score hq,← J_score hx,lam]

def boxAccept (b c : Bounds) : Bool :=
  let s := slopeP b c
  let t := slopeQ b c
  decide (validRectangle b c ∧ qResidual (anchor b s) (anchor c t)+deviation b s+deviation c t ≤ 0)

theorem boxAccept_sound {b c : Bounds} (yes : boxAccept b c = true) {p q : ℝ}
    (hp : b.Holds p) (hq : c.Holds q) : baseResidual p q ≤ 0 := by
  let s := slopeP b c
  let t := slopeQ b c
  let a := anchor b s
  let k := anchor c t
  have h : validRectangle b c ∧ qResidual a k+deviation b s+deviation c t ≤ 0 := of_decide_eq_true yes
  have anchor_in {i : Bounds} {x : ℝ} (hi : i.Holds x) (z : Bounds) : i.Holds (anchor i z) := by
    unfold anchor;split_ifs
    · exact ⟨hi.1.trans hi.2,le_rfl⟩
    · exact ⟨le_rfl,hi.1.trans hi.2⟩
    · exact midpoint_inside hi
  have ha : b.Holds (a:ℝ) := anchor_in hp s
  have hk : c.Holds (k:ℝ) := anchor_in hq t
  obtain ⟨m,hm,he⟩ := slopeP_sound h.1 ha hp hk
  obtain ⟨v,hv,ve⟩ := slopeQ_sound h.1 hp hk hq
  have h₁ := (anchor_spec hp hm).2
  have h₂ := (anchor_spec hq hv).2
  obtain ⟨ad,kd,xd⟩ := domains h.1 ha hk
  have top : (qResidual a k:ℝ)+(deviation b s:ℝ)+(deviation c t:ℝ) ≤ 0 := by exact_mod_cast h.2
  rw [qResidual_cast ad kd xd] at top
  dsimp only at he ve
  change m*(p-(a:ℝ)) ≤ (deviation b s:ℝ) at h₁
  change v*(q-(k:ℝ)) ≤ (deviation c t:ℝ) at h₂
  linarith only [h₁,h₂,he,ve,top]

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open PaperBox PaperBox.Bounds Set
noncomputable section

/-- Physical-coordinate residual for the canonical, low-q, ratio-one branch. The
primitive uses its clipped extension for boxes crossing z=p; on z≥p it is exact. -/
def secondResidual (p q z : ℝ) : ℝ :=
  (q+z+totalScore z-lam)*totalPrimitive p +
    (massE:ℝ)*p*(totalPrimitive (z-p+q)-totalPrimitive z-totalPrimitive q)

def secondX (p q z : Bounds) := (z.minus p).plus q
def secondK (p q z : Bounds) := (((totalPrimitiveBox (secondX p q z)).minus (totalPrimitiveBox z)).minus (totalPrimitiveBox q))
def secondA (q z : Bounds) := ((q.plus z).plus (totalScoreBox z)).minus (point lamQ)
def secondP (p q z : Bounds) :=
  (((secondA q z).times (totalPrimitiveSlope p)).plus ((point massE).times (secondK p q z))).minus
    (((point massE).times p).times (totalPrimitiveSlope (secondX p q z)))
def secondQ (p q z : Bounds) :=
  (totalPrimitiveBox p).plus (((point massE).times p).times
    ((totalPrimitiveSlope (secondX p q z)).minus (totalPrimitiveSlope q)))
def secondZ (p q z : Bounds) :=
  ((totalPrimitiveBox p).times ((point 1).plus (totalScoreSlope z))).plus
    (((point massE).times p).times ((totalPrimitiveSlope (secondX p q z)).minus (totalPrimitiveSlope z)))

private theorem xholds {p q z : ℝ} {b c d : Bounds} (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z) :
    (secondX b c d).Holds (z-p+q) := plus_holds (minus_holds hz hp) hq
private theorem kholds {p q z : ℝ} {b c d : Bounds} (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z) :
    (secondK b c d).Holds (totalPrimitive (z-p+q)-totalPrimitive z-totalPrimitive q) :=
  minus_holds (minus_holds (totalPrimitiveBox_holds (xholds hp hq hz)) (totalPrimitiveBox_holds hz)) (totalPrimitiveBox_holds hq)
private theorem aholds {q z : ℝ} {c d : Bounds} (hq : c.Holds q) (hz : d.Holds z) :
    (secondA c d).Holds (q+z+totalScore z-lam) := minus_holds (plus_holds (plus_holds hq hz) (totalScoreBox_holds hz)) (point_holds _)

theorem secondP_sound {p t q z : ℝ} {b c d : Bounds} (hp : b.Holds p) (ht : b.Holds t)
    (hq : c.Holds q) (hz : d.Holds z) : Secants (fun x => secondResidual x q z) p t (secondP b c d) := by
  obtain ⟨m,hm,em⟩ := totalPrimitive_secant hp ht
  obtain ⟨n,hn,en⟩ := totalPrimitive_secant (xholds hp hq hz) (xholds ht hq hz)
  let A := q+z+totalScore z-lam
  let K := totalPrimitive (z-p+q)-totalPrimitive z-totalPrimitive q
  refine ⟨A*m+(massE:ℝ)*K-(massE:ℝ)*t*n,minus_holds (plus_holds
    (times_holds (aholds hq hz) hm) (times_holds (point_holds massE) (kholds hp hq hz)))
    (times_holds (times_holds (point_holds massE) ht) hn),?_⟩
  dsimp [secondResidual,A,K]
  linear_combination (q+z+totalScore z-lam)*em + (massE:ℝ)*t*en

theorem secondQ_sound {p q t z : ℝ} {b c d : Bounds} (hp : b.Holds p) (hq : c.Holds q)
    (ht : c.Holds t) (hz : d.Holds z) : Secants (fun x => secondResidual p x z) q t (secondQ b c d) := by
  obtain ⟨m,hm,em⟩ := totalPrimitive_secant hq ht
  obtain ⟨n,hn,en⟩ := totalPrimitive_secant (xholds hp hq hz) (xholds hp ht hz)
  refine ⟨totalPrimitive p+(massE:ℝ)*p*(n-m),plus_holds (totalPrimitiveBox_holds hp)
    (times_holds (times_holds (point_holds massE) hp) (minus_holds hn hm)),?_⟩
  dsimp [secondResidual]; linear_combination (massE:ℝ)*p*(en-em)

theorem secondZ_sound {p q z t : ℝ} {b c d : Bounds} (hp : b.Holds p) (hq : c.Holds q)
    (hz : d.Holds z) (ht : d.Holds t) : Secants (secondResidual p q) z t (secondZ b c d) := by
  obtain ⟨a,ha,ea⟩ := totalScore_secant hz ht
  obtain ⟨m,hm,em⟩ := totalPrimitive_secant hz ht
  obtain ⟨n,hn,en⟩ := totalPrimitive_secant (xholds hp hq hz) (xholds hp hq ht)
  refine ⟨totalPrimitive p*(1+a)+(massE:ℝ)*p*(n-m),plus_holds
    (times_holds (totalPrimitiveBox_holds hp) (plus_holds (by simpa using point_holds 1) ha))
    (times_holds (times_holds (point_holds massE) hp) (minus_holds hn hm)),?_⟩
  unfold secondResidual
  linear_combination totalPrimitive p*ea + (massE:ℝ)*p*(en-em)

def qtScore (p : ℚ) : ℚ := qscore (qclamp p)
def qtJ (p : ℚ) : ℚ := qprimitive (qclamp p)
private theorem qclamp_cast (p : ℚ) : ((qclamp p):ℝ)=clamp p := by simp [qclamp,clamp]
private theorem qtScore_cast (p : ℚ) : (qtScore p:ℝ)=totalScore p := by simp [qtScore,qscore_exact,totalScore,qclamp_cast]
private theorem qtJ_cast (p : ℚ) : (qtJ p:ℝ)=totalPrimitive p := by simp [qtJ,qprimitive_exact,totalPrimitive,qclamp_cast,J_score (clamp_mem _)]
def qSecond (p q z : ℚ) : ℚ :=
  (q+z+qtScore z-lamQ)*qtJ p + massE*p*(qtJ (z-p+q)-qtJ z-qtJ q)
private theorem qSecond_cast (p q z : ℚ) : (qSecond p q z:ℝ)=secondResidual p q z := by
  simp [qSecond,secondResidual,lam,qtScore_cast,qtJ_cast]

private theorem anchor_in {b : Bounds} {x : ℝ} (hx : b.Holds x) (s : Bounds) : b.Holds ((anchor b s):ℝ) := by
  unfold anchor;split_ifs
  · exact ⟨hx.1.trans hx.2,le_rfl⟩
  · exact ⟨le_rfl,hx.1.trans hx.2⟩
  · exact midpoint_inside hx

private theorem dev_upper {s b : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    m*(x-(anchor b s:ℝ)) ≤ (deviation b s:ℝ) := by
  by_cases h : 0 ≤ s.lo
  · have hs : (0:ℝ) ≤ s.lo := by exact_mod_cast h
    simpa [anchor,deviation,h] using mul_nonpos_of_nonneg_of_nonpos (hs.trans hm.1) (sub_nonpos.mpr hx.2)
  by_cases n : s.hi ≤ 0
  · have hs : (s.hi:ℝ) ≤ 0 := by exact_mod_cast n
    simpa [anchor,deviation,h,n] using mul_nonpos_of_nonpos_of_nonneg (hm.2.trans hs) (sub_nonneg.mpr hx.1)
  simpa [anchor,deviation,h,n] using centered_deviation hx hm

def secondAccept (b c d : Bounds) : Bool :=
  let s := secondP b c d
  let t := secondQ b c d
  let v := secondZ b c d
  decide (d.hi<b.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨
    qSecond (anchor b s) (anchor c t) (anchor d v)+deviation b s+deviation c t+deviation d v ≤ 0)

theorem secondAccept_sound {b c d : Bounds} {p q z : ℝ} (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z)
    (hpz : p ≤ z) (base : secondResidual p q 1 ≤ 0) (yes : secondAccept b c d = true) : secondResidual p q z ≤ 0 := by
  let s := secondP b c d
  let t := secondQ b c d
  let v := secondZ b c d
  let a := anchor b s
  let k := anchor c t
  let l := anchor d v
  have h : d.hi<b.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨ qSecond a k l+deviation b s+deviation c t+deviation d v ≤ 0 :=
    of_decide_eq_true yes
  rcases h with skip|⟨hd,hv⟩|high
  · have hh : (d.hi:ℝ)<b.lo := by exact_mod_cast skip
    exact False.elim ((not_lt.mpr hpz) (hz.2.trans_lt (hh.trans_le hp.1)))
  · have hz₁ : (d.hi:ℝ)=1 := by exact_mod_cast hd
    obtain ⟨m,hm,em⟩ := secondZ_sound hp hq hz (show d.Holds 1 from ⟨(hz.1.trans hz.2).trans_eq hz₁,hz₁.ge⟩)
    have nn : (0:ℝ) ≤ v.lo := by exact_mod_cast hv
    have order := mul_nonneg (nn.trans hm.1) (sub_nonneg.mpr (hz.2.trans_eq hz₁))
    linarith only [base,em,order]
  · have ha : b.Holds (a:ℝ) := anchor_in hp s
    have hk : c.Holds (k:ℝ) := anchor_in hq t
    have hl : d.Holds (l:ℝ) := anchor_in hz v
    obtain ⟨u,hu,eu⟩ := secondP_sound ha hp hk hl
    obtain ⟨w,hw,ew⟩ := secondQ_sound hp hk hq hl
    obtain ⟨m,hm,em⟩ := secondZ_sound hp hq hl hz
    have h₁ := dev_upper hp hu
    have h₂ := dev_upper hq hw
    have h₃ := dev_upper hz hm
    have top : (qSecond a k l:ℝ)+(deviation b s:ℝ)+(deviation c t:ℝ)+(deviation d v:ℝ) ≤ 0 := by exact_mod_cast high
    rw [qSecond_cast] at top
    change u*(p-(a:ℝ)) ≤ (deviation b s:ℝ) at h₁
    change w*(q-(k:ℝ)) ≤ (deviation c t:ℝ) at h₂
    change m*(z-(l:ℝ)) ≤ (deviation d v:ℝ) at h₃
    dsimp only at eu ew em
    linarith only [h₁,h₂,h₃,eu,ew,em,top]

end
end StableVotingDistortion.PaperCurve
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set PaperBox PaperBox.Bounds
open PaperCurve (anchor deviation qtScore qtJ)
noncomputable section

def rationalRay (col : Knot → ℕ) (p : ℚ) (k l : Knot) : ℚ :=
  let t := max 0 (min 1 ((p-qRank k)/(qRank l-qRank k)))
  (1-t)*qValue col k+t*qValue col l

def rationalLookup (col : Knot → ℕ) (p : ℚ) (k : Knot) : List Knot → ℚ
  | [] => qValue col k
  | l::ks => if p ≤ qRank l then rationalRay col p k l else rationalLookup col p l ks

def rationalEntry (col : Knot → ℕ) (p : ℚ) : ℚ := rationalLookup col p knots.head! knots.tail

theorem rationalEntry_exact (col : Knot → ℕ) (p : ℚ) :
    (rationalEntry col p:ℝ)=entry col (p:ℝ) := by
  have hh (ks : List Knot) (k : Knot) : (rationalLookup col p k ks:ℝ)=lookup col (p:ℝ) k ks := by
    induction ks generalizing k with
    | nil => exact qValue_cast _ _
    | cons l tail ih =>
      by_cases h : p ≤ qRank l
      · have h' : (p:ℝ) ≤ rank l := (by exact_mod_cast h : (p:ℝ) ≤ qRank l).trans_eq (qRank_cast l)
        simp only [rationalLookup,lookup,if_pos h,if_pos h',rationalRay,interpolate,fraction]
        push_cast
        simp only [qRank_cast,qValue_cast]
      · have h' : ¬(p:ℝ) ≤ rank l := by rw [← qRank_cast];exact_mod_cast h
        simpa only [rationalLookup,lookup,if_neg h,if_neg h'] using ih l
  exact hh _ _

def rationalPhysical (p q z : ℚ) : ℚ :=
  q+rationalEntry Knot.beta p*(qtJ (z-p+q)-qtJ z-qtJ q)+z-PaperCurve.lamQ+
    (1+max (rationalEntry Knot.eta p-1) 0)*qtScore z

theorem rationalPhysical_exact (p q z : ℚ) : (rationalPhysical p q z:ℝ)=physicalResidual p q z := by
  have ca (v : ℚ) : ((PaperCurve.qclamp v):ℝ)=PaperCurve.clamp v := by simp [PaperCurve.qclamp,PaperCurve.clamp]
  have cs (v : ℚ) : (qtScore v:ℝ)=PaperCurve.totalScore v := by simp [qtScore,PaperCurve.totalScore,PaperCurve.qscore_exact,ca]
  have cj (v : ℚ) : (qtJ v:ℝ)=PaperCurve.totalPrimitive v := by
    simp [qtJ,PaperCurve.totalPrimitive,PaperCurve.qprimitive_exact,ca,PaperCurve.J_score (PaperCurve.clamp_mem _)]
  simp [rationalPhysical,physicalResidual,physicalK,penaltyLP,PaperCurve.lam,cs,cj,rationalEntry_exact]

/-- A slope sign chooses the corresponding box endpoint, while a box
whose slope changes sign uses its midpoint and a certified centered error. -/
private theorem anchor_upper {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    b.Holds (anchor b s:ℝ) ∧ m*(x-(anchor b s:ℝ)) ≤ (deviation b s:ℝ) := by
  by_cases h : 0 ≤ s.lo
  · have hn : (0:ℝ) ≤ s.lo := by exact_mod_cast h
    simpa [anchor,deviation,h,Holds] using And.intro (And.intro (hx.1.trans hx.2) (le_refl (b.hi:ℝ)))
      (mul_nonpos_of_nonneg_of_nonpos (hn.trans hm.1) (sub_nonpos.mpr hx.2))
  by_cases n : s.hi ≤ 0
  · have hn : (s.hi:ℝ) ≤ 0 := by exact_mod_cast n
    simpa [anchor,deviation,h,n,Holds] using And.intro (And.intro (le_refl (b.lo:ℝ)) (hx.1.trans hx.2))
      (mul_nonpos_of_nonpos_of_nonneg (hm.2.trans hn) (sub_nonneg.mpr hx.1))
  exact ⟨by simpa [anchor,h,n] using midpoint_inside hx,by simpa [anchor,deviation,h,n] using centered_deviation hx hm⟩

private theorem anchor_mem {b : Bounds} {x : ℝ} (hx : b.Holds x) (s : Bounds) : b.Holds (anchor b s:ℝ) := by
  unfold anchor
  split_ifs
  · exact ⟨hx.1.trans hx.2,le_rfl⟩
  · exact ⟨le_rfl,hx.1.trans hx.2⟩
  · exact midpoint_inside hx

def physicalAccept (b c d : Bounds) : Bool :=
  let s := physicalP b c d
  let t := physicalQ b c d
  let v := physicalZ b c d
  decide (d.hi < b.lo ∨ b.hi < c.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨
    rationalPhysical (anchor b s) (anchor c t) (anchor d v)+deviation b s+deviation c t+deviation d v ≤ 0)

theorem physicalAccept_sound {b c d : Bounds} {p q z : ℝ} (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z)
    (hqp : q ≤ p) (hpz : p ≤ z) (base : physicalResidual p q 1 ≤ 0) (yes : physicalAccept b c d=true) :
    physicalResidual p q z ≤ 0 := by
  let s := physicalP b c d
  let t := physicalQ b c d
  let v := physicalZ b c d
  let a := anchor b s
  let k := anchor c t
  let l := anchor d v
  have h : d.hi < b.lo ∨ b.hi < c.lo ∨ (d.hi=1 ∧ 0 ≤ v.lo) ∨
      rationalPhysical a k l+deviation b s+deviation c t+deviation d v ≤ 0 := of_decide_eq_true yes
  rcases h with skip|skip|⟨hd,hv⟩|top
  · have hh : (d.hi:ℝ) < b.lo := by exact_mod_cast skip
    exact False.elim (hpz.not_gt (hz.2.trans_lt (hh.trans_le hp.1)))
  · have hh : (b.hi:ℝ) < c.lo := by exact_mod_cast skip
    exact False.elim (hqp.not_gt (hp.2.trans_lt (hh.trans_le hq.1)))
  · have h₁ : (d.hi:ℝ)=1 := by exact_mod_cast hd
    obtain ⟨m,hm,em⟩ := physicalZ_sound hp hq hz (show d.Holds 1 from ⟨(hz.1.trans hz.2).trans_eq h₁,h₁.ge⟩)
    have nn : (0:ℝ) ≤ v.lo := by exact_mod_cast hv
    have hn := mul_nonneg (nn.trans hm.1) (sub_nonneg.mpr (hz.2.trans_eq h₁))
    dsimp only at em;linarith only [base,em,hn]
  · have ha : b.Holds (a:ℝ) := anchor_mem hp _
    have hk : c.Holds (k:ℝ) := anchor_mem hq _
    have hl : d.Holds (l:ℝ) := anchor_mem hz _
    obtain ⟨s₁,hs₁,e₁⟩ := physicalP_sound ha hp hk hl
    obtain ⟨s₂,hs₂,e₂⟩ := physicalQ_sound hp hk hq hl
    obtain ⟨s₃,hs₃,e₃⟩ := physicalZ_sound hp hq hl hz
    have a₁ := (anchor_upper hp hs₁).2
    have a₂ := (anchor_upper hq hs₂).2
    have a₃ := (anchor_upper hz hs₃).2
    have bound : (rationalPhysical a k l:ℝ)+(deviation b s:ℝ)+(deviation c t:ℝ)+(deviation d v:ℝ) ≤ 0 := by exact_mod_cast top
    rw [rationalPhysical_exact] at bound
    change s₁*(p-(a:ℝ)) ≤ (deviation b s:ℝ) at a₁
    change s₂*(q-(k:ℝ)) ≤ (deviation c t:ℝ) at a₂
    change s₃*(z-(l:ℝ)) ≤ (deviation d v:ℝ) at a₃
    dsimp only at e₁ e₂ e₃
    linarith only [a₁,a₂,a₃,e₁,e₂,e₃,bound]

end
end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperCurve
open Set



def RowTree.covers (inside : Piece → Prop) : RowTree → ℚ → ℚ → Prop
  | .leaf p, a, b => inside p ∧ p.lo=a ∧ p.hi=b
  | .branch t l r,a,b => l.covers inside a t ∧ r.covers inside t b

theorem RowTree.lookup_correct (inside : Piece → Prop) (tree : RowTree) {a b x : ℚ}
    (ok : tree.covers inside a b) (ha : a≤x) (hb : x≤b) :
    inside (tree.lookup x) ∧ (tree.lookup x).lo≤x ∧ x≤(tree.lookup x).hi := by
  induction tree generalizing a b with
  | leaf p =>
    obtain ⟨hp,le,re⟩ := ok
    exact ⟨hp,le ▸ ha,re ▸ hb⟩
  | branch pivot left right ihL ihR =>
    by_cases e : x≤pivot
    · simpa only [lookup,if_pos e] using ihL ok.1 ha e
    · simpa only [lookup,if_neg e] using ihR ok.2 (le_of_not_ge e) hb

theorem tree_score_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qvalue x=qscore x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qvalue,qscore_exact,score_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

theorem tree_primitive_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qprimitive x=qprimitive x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qprimitive,qprimitive_exact,primitive_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

end StableVotingDistortion.PaperCurve
end

