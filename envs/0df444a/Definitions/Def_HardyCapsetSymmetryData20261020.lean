def CoverageMatches (q t : ℕ) : Prop :=
  let r := coverageRecords[(q - 1) * 3 + t]!
  r.representative < representativeNormals.size ∧
  r.representative < representativeLevels.size ∧
  r.groupIndex < groupWords.size ∧
  (r.factor : ZMod 3) ≠ 0 ∧
  decode q = (r.factor : ZMod 3) •
    wordMap generators groupWords[r.groupIndex]! (decode (entry representativeNormals r.representative)) ∧
  (t : ZMod 3) = (r.factor : ZMod 3) * (entry representativeLevels r.representative : ZMod 3)

instance (q t : ℕ) : Decidable (CoverageMatches q t) := by
  unfold CoverageMatches
  infer_instance

end HardyCapset20261020.Cert


