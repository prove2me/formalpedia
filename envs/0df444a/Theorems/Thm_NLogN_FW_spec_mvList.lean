theorem NLogN.FW.spec_mvList (M : MulSpec) (i j c : Fin HS) (n : Ex HS) (s : IState HS) (l : List ℤ)
    (Ri : List Item) (hij : i ≠ j) (hci : c ≠ i) (hcj : c ≠ j) (hi : s.G i = ints l ++ Ri)
    (hn : n.eval s = l.length) (hi55 : i.val < 55) (hj55 : j.val < 55) (hc55 : c.val < 55)
    (hnc : n.Clean) (hno : n.ok s) (B : ℕ) (hl : n.Lin) (hnB : n.Bnd s B)
    (hB : ∀ x ∈ l, zsz x ≤ B) :
    Spec M (RM.rs (mvList i j c n)) s ((s.upd i Ri).upd j (ints l.reverse ++ s.G j))
      ((n.size + 1) * 2000 * (B + 2) + l.length * (14000 * (B + 2) + 30) + 32) := by sorry
