-- title:
--   §III pitfalls: a universal parametrization can symmetrize to no nontrivial gates
-- statement:
--   For the order-two representation $\{I,X\}$ on one qubit, let $T(A)=(A+XAX)/2$. Then
--   $$T(Y)=T(Z)=0,\qquad T(X)=X.$$
--   Every finite ordered product of real-angle evolutions generated by twirls of $Y$ or $Z$ is therefore identity. In contrast, $e^{-i\theta X}$ commutes with $X$ for every real $\theta$, and $e^{-i\pi X/4}\ne I$. This is the source's concrete collapse example for the $Z$-$Y$-$Z$ parametrization, without asserting a general expressivity or generalization theorem.
-- source:
--   Exploiting symmetry in variational quantum machine learning, arXiv:2205.06217v1, PDF p. 10, §III pitfalls: a universal parametrization can symmetrize to no nontrivial gates

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P01

noncomputable section

open scoped Matrix Kronecker ComplexConjugate Matrix.Norms.L2Operator Manifold ContDiff

open MeasureTheory

namespace QAlgorithms.Papers.Independent.Extend50.P01

attribute [local instance] Classical.propDecidable Classical.decEq

-- PDF pp.3,8: reuse the accepted operator type, exp(-itH), and A X A†.
-- Notation specializes the imported interfaces without introducing duplicate declarations.

local notation "Op" => (fun n : ℕ => QAlgorithms.Papers.Independent.Information100.P21.Op (Qubits n))

local notation "evolve" => QAlgorithms.Papers.Independent.Information100.P32.evolution

local notation "conjugate" => QAlgorithms.conjSuperop

-- PDF pp.3,10–11: the imported quadratic form is Re(psi† A psi).

local notation "expectation" => QAlgorithms.Papers.Independent.Information100.P21.quad

-- PDF pp.5,16–19: accepted active-wire operator, with identities on all spectators.

local notation "onWire" => QAlgorithms.Papers.Independent.Advance50.P49.onWire

-- PDF p.5: the imported phase-free Pauli tensor uses 0=I,1=X,2=Y,3=Z.

local notation "pauliWord" => QAlgorithms.Papers.Independent.Gap48.P33.pauliWord

/-- PDF pp.9–10: the concrete collapse of the Y,Z generator parametrization under {I,X}. -/
theorem twirl_collapse :
    involutionTwirl pauliX pauliY = 0 ∧ involutionTwirl pauliX pauliZ = 0 ∧
    involutionTwirl pauliX pauliX = pauliX ∧
    (∀ (k : ℕ) (G : Fin k → Matrix Bool Bool ℂ),
      (∀ j, G j = pauliY ∨ G j = pauliZ) → ∀ theta : Fin k → ℝ,
      orderedProd (fun j => evolve (involutionTwirl pauliX (G j)) (theta j)) = 1) ∧
    (∀ theta : ℝ, Commute (evolve pauliX theta) pauliX) ∧
    evolve pauliX (Real.pi / 4) ≠ 1 := by sorry

end QAlgorithms.Papers.Independent.Extend50.P01

end
