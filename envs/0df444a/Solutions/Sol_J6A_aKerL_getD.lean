/-!
# B3 (chunk kernel), part 1: the Gaussian stages as list maps

The chunk kernel on a Gaussian row is `liftG (chunkK q)`. Here it is rewritten in the form the
IL computes:

* `liftG_comp`, `liftG_append`: `liftG` commutes with composition / concatenation of
  length-preserving maps;
* `dgG c z`: the diagonal stage on pairs (`liftG (dgL P c) = dgG P c`);
* **`kmulD_toep`**: the zero-padded Kronecker record product with `Δ = 0` gives the exact
  lower-triangular Toeplitz sums `convL` of both parts (`2 n ≤ r + 1`);
* `lwG`, `upG`: the Toeplitz stages on pairs from `kmulD` (`liftG (lwL P c) = lwG`, …);
* `blkG`, `chunkG`: the block solve and the chunk kernel on pairs (`liftG (chunkL …) = chunkG …`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg

open IntMul NLogN NLogN.KFV

/-! ## `liftG` algebra -/

lemma getD_map_of_lt {α β : Type*} {l : List α} {f : α → β} {k : ℕ} (h : k < l.length) (d : β)
    (d' : α) : (l.map f).getD k d = f (l.getD k d') := by
  rw [List.getD_eq_getElem _ _ (by simpa using h), List.getElem_map, List.getD_eq_getElem _ _ h]

/-! ## The diagonal stage -/

section stages
variable (P : ℕ)

lemma length_dgG {c : List ℤ} {z : List (ℤ × ℤ)} (h : z.length ≤ c.length) :
    (dgG P c z).length = z.length := by simp [dgG]; omega

/-! ## Toeplitz sums by one record product -/

/-! ## Toeplitz stages on pairs -/

lemma length_kmulD (r Δ : ℕ) (zx zy : List (ℤ × ℤ)) : (kmulD r Δ zx zy).length = r := by
  simp [kmulD]

lemma length_lwG {r : ℕ} {c : List ℤ} {z : List (ℤ × ℤ)} (hr : z.length ≤ r) :
    (lwG P r c z).length = z.length := by
  simp [lwG, length_kmulD]; omega

theorem liftG_lwL {r : ℕ} (c : List ℤ) (z : List (ℤ × ℤ)) (hc : z.length ≤ c.length)
    (hr : 2 * z.length ≤ r + 1) : liftG (lwL P c) z = lwG P r c z := by
  have hzr : z.length ≤ r := by omega
  apply ext_getD' (by
    rw [length_lwG P hzr, length_liftG _ z.length (fun y hy => by rw [length_lwL, hy]) z rfl])
  intro k hk
  rw [length_liftG _ z.length (fun y hy => by rw [length_lwL, hy]) z rfl] at hk
  unfold liftG
  rw [getD_zip_of_lt (by simp [length_lwL]; exact hk) (by simp [length_lwL]; exact hk)]
  rw [List.getD_eq_getElem (lwG P r c z) _ (by rw [length_lwG P hzr]; exact hk)]
  unfold lwG
  simp only [List.getElem_map, List.getElem_take]
  have e := kmulD_toep (r := r) c z hc hr hk
  rw [List.getD_eq_getElem _ _ (by simp [length_kmulD]; omega)] at e
  rw [e]
  unfold lwL
  rw [getD_map_of_lt (l := convL c (z.map Prod.fst)) (by rw [length_convL]; simpa using hk) _ 0,
    getD_map_of_lt (l := convL c (z.map Prod.snd)) (by rw [length_convL]; simpa using hk) _ 0]

/-! ## The block solve and the chunk kernel on pairs -/

end stages

end J6Seg

