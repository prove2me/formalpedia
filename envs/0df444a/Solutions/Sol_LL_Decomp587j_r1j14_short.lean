  have hint_inv : IntegrableOn (fun x0 : ℝ => (1 / x0 : ℝ))
      (Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out)) volume := by
    apply ContinuousOn.integrableOn_compact isCompact_Icc
    exact continuousOn_const.div continuousOn_id (fun t ht => ne_of_gt (lt_of_lt_of_le hA0 ht.1))
  have hmono : ∫ x0 in Icc ((A0_num : ℝ) / D_out) ((B0_num : ℝ) / D_out), (1 / x0) * F_fn ω (φ - x0) ≤
      ((F_tail_val : ℝ) / S_scale) *
      ∫ x0 in ((A0_num : ℝ) / D_out)..((B0_num : ℝ) / D_out), (1 / x0 : ℝ) := by
    rw [intervalIntegral.integral_of_le (by unfold A0_num B0_num D_out; norm_num),
        ← MeasureTheory.integral_Icc_eq_integral_Ioc, ← integral_const_mul]
    exact setIntegral_mono_on hint_all (hint_inv.const_mul _) measurableSet_Icc hpt
  -- Split the 1D integral into 32 intervals
  set h0 := (B0_num - A0_num) / 32
  have hh0_eq : 32 * h0 = B0_num - A0_num := by unfold h0 A0_num B0_num; decide
  have hI0 : ∫ x0 in ((A0_num : ℝ) / D_out)..((B0_num : ℝ) / D_out), (1 / x0 : ℝ) ≤
      (sumUpTo 32 (fun i => wInv (A0_num + i * h0) (A0_num + i * h0 + h0)) : ℝ) / W_scale := by
    have h0eq : ((A0_num + 0 * h0 : ℕ) : ℝ) / D_out = (A0_num : ℝ) / D_out := by simp
    have h32nat : A0_num + 32 * h0 = B0_num := by rw [hh0_eq]; unfold A0_num B0_num; omega
    have h32eq : ((A0_num + 32 * h0 : ℕ) : ℝ) / D_out = (B0_num : ℝ) / D_out := by rw [h32nat]
    have hadj : ∑ i ∈ Finset.range 32,
        ∫ t in (((A0_num + i * h0 : ℕ) : ℝ) / D_out)..(((A0_num + (i + 1) * h0 : ℕ) : ℝ) / D_out), (1 / t : ℝ) =
        ∫ t in ((A0_num : ℝ) / D_out)..((B0_num : ℝ) / D_out), (1 / t : ℝ) := by
      rw [← h0eq, ← h32eq]
      apply intervalIntegral.sum_integral_adjacent_intervals
      intro i _
      have hcont : ContinuousOn (fun t : ℝ => 1 / t)
          (Icc (((A0_num + i * h0 : ℕ) : ℝ) / D_out) (((A0_num + (i + 1) * h0 : ℕ) : ℝ) / D_out)) :=
        continuousOn_const.div continuousOn_id (fun t ht => by
          have : (0 : ℝ) < ((A0_num + i * h0 : ℕ) : ℝ) / D_out :=
            div_pos (by exact_mod_cast (by unfold A0_num; omega : 0 < A0_num + i * h0)) hDout_pos
