section FullLatticeRestrict

variable {O : Type*} [CommRing O]
variable {K : Type*} [Field K] [Algebra O K]
variable {V : Type*} [AddCommGroup V] [Module K V] [Module O V] [IsScalarTower O K V]
variable {M : Submodule O V}

private def fullLatticeRestrict (f : V →ₗ[K] V) (hf : ∀ x ∈ M, f x ∈ M) : ↥M →ₗ[O] ↥M :=
  (f.restrictScalars O).restrict hf

@[scoped simp]
private theorem fullLatticeRestrict_coe_apply (f : V →ₗ[K] V) (hf : ∀ x ∈ M, f x ∈ M) (m : ↥M) :
    ((fullLatticeRestrict f hf m : ↥M) : V) = f (m : V) :=
  rfl

end FullLatticeRestrict
