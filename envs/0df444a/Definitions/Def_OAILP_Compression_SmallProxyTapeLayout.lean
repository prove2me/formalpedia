/-- The three scratch cells and the interleaved augmented coefficient/grid row. -/
def smallProxyScalarTape {n : ℕ} (D : ℕ) (c : ℤ) (a grid : Fin n → ℤ) : List ℚ :=
  0 :: 0 :: 0 :: affineInputPairs (smallProxyLeft D a) (smallProxyRight c grid)

