omit [FiniteDimensional (RatFunc K) E]
  [Algebra.IsSeparable (RatFunc K) E] in
theorem exists_functionFieldPlace_heightOne (a : K) :
    ∃ P : HeightOneSpectrum (integralClosure K[X] E),
