theorem Ideal.span_le_pow_of_forall_isIdempotentElem_of_subset
    {R : Type u} [CommRing R] (S : Set R) (hS : ∀ e ∈ S, IsIdempotentElem e)
    (𝔭 : Ideal R) (hS𝔭 : S ⊆ 𝔭) (n : ℕ) : Ideal.span S ≤ 𝔭 ^ n := by sorry
