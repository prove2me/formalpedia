namespace GlueError

open Finset Butterfly AModel Synth GlueLayout GlueP14

variable {R : Type*} [CommRing R] [Algebra ℂ R] {y : Rˣ} {r : ℕ}

variable (C : CoeffModel y r)

variable {C}

lemma dist_carr {N : ℕ} (u v : CArr C N) :
    dist u v = ‖(fun j => C.co (u j)) - (fun j => C.co (v j))‖ := by
  rw [dist_eq_norm]
  show ‖coHom C N (u - v)‖ = _
  rw [map_sub]; rfl

lemma dist_carr_le {N : ℕ} {u v : CArr C N} {B : ℝ} (hB : 0 ≤ B)
    (h : ∀ j, ‖C.co ((u : Fin N → R) j - (v : Fin N → R) j)‖ ≤ B) : dist u v ≤ B := by
  rw [dist_carr]
  refine (pi_norm_le_iff_of_nonneg hB).2 fun j => ?_
  simpa [map_sub] using h j

lemma dist_carr_lt {N : ℕ} {u v : CArr C N} {B : ℝ} (hB : 0 < B)
    (h : ∀ j, ‖C.co ((u : Fin N → R) j - (v : Fin N → R) j)‖ < B) : dist u v < B := by
  rw [dist_carr]
  refine (pi_norm_lt_iff hB).2 fun j => ?_
  simpa [map_sub] using h j

lemma norm_le_dist_carr {N : ℕ} (u v : CArr C N) (j : Fin N) :
    ‖C.co ((u : Fin N → R) j - (v : Fin N → R) j)‖ ≤ dist u v := by
  rw [dist_carr, map_sub]
  exact norm_le_pi_norm ((fun j => C.co (u j)) - (fun j => C.co (v j))) j

lemma getD_ofA {N : ℕ} (u : CArr C N) (k : ℕ) :
    (ofA u).getD k 0 = if h : k < N then (u : Fin N → R) ⟨k, h⟩ else 0 := by
  unfold ofA
  split_ifs with h
  · rw [List.getD_eq_getElem _ _ (by simpa using h)]; simp
  · rw [List.getD_eq_default _ _ (by simp; omega)]

lemma ofA_toA {N : ℕ} {xs : List R} (h : xs.length = N) : ofA (toA C N xs) = xs := by
  apply List.ext_getElem (by simp [ofA, h])
  intro k h1 h2
  simp [ofA, toA, List.getElem?_eq_getElem h2]

variable {D : ℕ} {sh : Shape} {ι : Type} [Fintype ι] [DecidableEq ι]

lemma length_twL (Ex : ℕ → ℤ) (zs : List R) : (twL y sh Ex zs).length = vol sh := by simp [twL]

lemma getD_twL (Ex : ℕ → ℤ) (zs : List R) {j : ℕ} (hj : j < vol sh) :
    (twL y sh Ex zs).getD j 0 = yp y (Ex j) * zs.getD j 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa [twL] using hj)]; simp [twL]

/-- `H0^{⊗}` does not increase the coefficient sup distance. -/
lemma layer_lip (Sb : SelBits sh ι) (xs xs' : List R) {B : ℝ} (hB0 : 0 ≤ B)
    (hB : ∀ k, ‖C.co (xs.getD k 0 - xs'.getD k 0)‖ ≤ B) (j : ℕ) :
    ‖C.co ((selOp Sb (Butterfly.tens H0) xs).getD j 0 - (selOp Sb (Butterfly.tens H0) xs').getD j 0)‖ ≤ B := by
  by_cases hj : j < vol sh
  · rw [List.getD_eq_getElem _ _ (by simpa using hj), List.getD_eq_getElem _ _ (by simpa using hj),
      getElem_selOp, getElem_selOp, ← sum_sub_distrib, map_sum]
    calc ‖∑ b, C.co ((Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) b •
            xs.getD (encode sh (Sb.set (decode sh j) b)) 0 -
            (Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) b •
            xs'.getD (encode sh (Sb.set (decode sh j) b)) 0)‖
        ≤ ∑ b, ‖(Butterfly.tens H0 : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (Sb.bits (decode sh j)) b‖ * B := by
          refine (norm_sum_le _ _).trans (sum_le_sum fun b _ => ?_)
          rw [← smul_sub, map_smul, norm_smul]
          exact mul_le_mul_of_nonneg_left (hB _) (norm_nonneg _)
      _ = B := by rw [← sum_mul, tens_H0_row_sum, one_mul]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      sub_zero, map_zero, norm_zero]
    exact hB0

/-- `H0^{⊗}` maps disk arrays into the disk. -/
lemma layer_disk (Sb : SelBits sh ι) (xs : List R) (hB : ∀ k, ‖C.co (xs.getD k 0)‖ ≤ 1) (j : ℕ) :
    ‖C.co ((selOp Sb (Butterfly.tens H0) xs).getD j 0)‖ ≤ 1 := by
  have := layer_lip (C := C) Sb xs [] zero_le_one (fun k => by simpa using hB k) j
  have h0 : (selOp Sb (Butterfly.tens H0) ([] : List R)).getD j 0 = 0 := by
    by_cases hj : j < vol sh
    · rw [List.getD_eq_getElem _ _ (by simpa using hj), getElem_selOp]; simp
    · exact List.getD_eq_default _ _ (by simp; omega)
  rw [h0, sub_zero] at this; exact this

section Maps

variable (C) (p : ℕ) (Sb : SelBits sh ι) (Ex : ℕ → ℤ)

variable {C}

lemma ofA_getD_sub (u v : CArr C (vol sh)) (k : ℕ) :
    ‖C.co ((ofA u).getD k 0 - (ofA v).getD k 0)‖ ≤ dist u v := by
  rw [getD_ofA, getD_ofA]
  split_ifs with h
  · exact norm_le_dist_carr u v ⟨k, h⟩
  · simp

/-- The exact round is a contraction. -/
theorem round_contract (u v : CArr C (vol sh)) :
    dist (Emap C Sb Ex u) (Emap C Sb Ex v) ≤ dist u v := by
  apply dist_carr_le dist_nonneg
  intro j
  show ‖C.co ((exactR y Sb Ex (ofA u)).getD j 0 - (exactR y Sb Ex (ofA v)).getD j 0)‖ ≤ _
  unfold exactR
  rw [getD_twL _ _ j.isLt, getD_twL _ _ j.isLt, ← mul_sub, norm_co_yp]
  exact layer_lip Sb _ _ dist_nonneg (ofA_getD_sub u v) j

lemma ofA_disk {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) (k : ℕ) :
    ‖C.co ((ofA u).getD k 0)‖ ≤ 1 := by
  rw [getD_ofA]; split_ifs with h
  · exact hu ⟨k, h⟩
  · simp

/-- The exact round maps the disk into itself. -/
theorem round_disk {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) :
    Emap C Sb Ex u ∈ disk C (vol sh) := by
  intro j
  show ‖C.co ((exactR y Sb Ex (ofA u)).getD j 0)‖ ≤ 1
  unfold exactR
  rw [getD_twL _ _ j.isLt, norm_co_yp]
  exact layer_disk Sb _ (ofA_disk hu) j

lemma getD_layerQ (xs : List R) (j : ℕ) :
    (layerQ C p Sb xs).getD j 0 = QpR C p ((selOp Sb (Butterfly.tens H0) xs).getD j 0) := by
  unfold layerQ
  by_cases hj : j < vol sh
  · rw [List.getD_eq_getElem _ _ (by simpa using hj), List.getD_eq_getElem _ _ (by simpa using hj),
      List.getElem_map]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega)]
    have h := norm_co_QpR_le C p (0 : R)
    rw [map_zero, norm_zero] at h
    exact (C.inj ((norm_le_zero_iff.1 h).trans (map_zero C.co).symm)).symm

/-- The computed round maps the disk into itself. -/
theorem comp_disk {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) :
    Amap C p Sb Ex u ∈ disk C (vol sh) := by
  intro j
  show ‖C.co ((compR C p Sb Ex (ofA u)).getD j 0)‖ ≤ 1
  unfold compR
  rw [getD_twL _ _ j.isLt, norm_co_yp, getD_layerQ]
  exact (norm_co_QpR_le C p _).trans (layer_disk Sb _ (ofA_disk hu) j)

/-- The computed round is within `√2·2^{-p}` of the exact one (Proposition 14). -/
theorem comp_err (u : CArr C (vol sh)) :
    dist (Amap C p Sb Ex u) (Emap C Sb Ex u) < Real.sqrt 2 * 2⁻¹ ^ p := by
  apply dist_carr_lt (by positivity)
  intro j
  show ‖C.co ((compR C p Sb Ex (ofA u)).getD j 0 - (exactR y Sb Ex (ofA u)).getD j 0)‖ < _
  unfold compR exactR
  rw [getD_twL _ _ j.isLt, getD_twL _ _ j.isLt, getD_layerQ, ← mul_sub, norm_co_yp]
  exact norm_co_QpR_sub_lt C p _

end Maps

lemma runDown_eq_foldl {α : Type*} (F : ℕ → α → α) :
    ∀ n x, runDown F n x = (List.range n).foldl (fun u k => F (n - 1 - k) u) x
  | 0, x => rfl
  | n + 1, x => by
    rw [runDown, runDown_eq_foldl F n, List.range_succ_eq_map, List.foldl_cons, List.foldl_map]
    congr 1
    · funext u k; congr 1; omega

lemma toA_foldl {N : ℕ} (G : ℕ → List R → List R) (hG : ∀ k zs, (G k zs).length = N) :
    ∀ (l : List ℕ) (xs : List R), xs.length = N →
      toA C N (l.foldl (fun u k => G k u) xs) =
        l.foldl (fun u k => toA C N (G k (ofA u))) (toA C N xs)
  | [], _, _ => rfl
  | k :: l, xs, h => by
    simp only [List.foldl_cons]
    rw [toA_foldl G hG l _ (hG k xs), ofA_toA h]

lemma procL_eq_runDown {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) :
    ∀ n (xs : List R), procL y L ℓ P Sb n xs =
      runDown (fun h => exactR y (Sb h) (roundEx L ℓ h (P h))) n xs
  | 0, _ => rfl
  | n + 1, xs => by rw [procL, runDown, procL_eq_runDown L ℓ P Sb n]; rfl

/-- **Lemma 16, error part (any layout).** For an input array in the unit disk, the computed
procedure (`n ≥ 1` rounds) stays in the disk and differs from the exact procedure `procL` by
less than `n · √2 · 2^{-p}` in every coefficient of every record. -/
theorem lemma16_error (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) (ℓ : ℕ)
    (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (n : ℕ) (hn : 1 ≤ n)
    {xs : List R} (hlen : xs.length = vol sh) (hdisk : ∀ k, ‖C.co (xs.getD k 0)‖ ≤ 1) :
    (∀ j, ‖C.co ((procQ C p L ℓ P Sb n xs).getD j 0 - (procL y L ℓ P Sb n xs).getD j 0)‖ <
      n * (Real.sqrt 2 * 2⁻¹ ^ p)) ∧
    ∀ j, ‖C.co ((procQ C p L ℓ P Sb n xs).getD j 0)‖ ≤ 1 := by
  set E : ℕ → CArr C (vol sh) → CArr C (vol sh) := fun k =>
    Emap C (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))) with hE
  set A : ℕ → CArr C (vol sh) → CArr C (vol sh) := fun k =>
    Amap C p (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))) with hA
  have hx : toA C (vol sh) xs ∈ disk C (vol sh) := fun j => hdisk j
  have hchain := error_chain (disk C (vol sh)) E A (Real.sqrt 2 * 2⁻¹ ^ p)
    (fun k u _ v _ => round_contract _ _ u v) (fun k u hu => round_disk _ _ hu)
    (fun k u hu => comp_disk p _ _ hu) (fun k u _ => comp_err p _ _ u) n _ hx hn
  -- identify the folds with the procedures
  have hQ : toA C (vol sh) (procQ C p L ℓ P Sb n xs) =
      (List.range n).foldl (fun u k => A k u) (toA C (vol sh) xs) := by
    unfold procQ
    rw [runDown_eq_foldl, toA_foldl (N := vol sh)
      (fun k => compR C p (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))))
      (fun k zs => length_twL _ _) _ _ hlen]
    rfl
  have hL : toA C (vol sh) (procL y L ℓ P Sb n xs) =
      (List.range n).foldl (fun u k => E k u) (toA C (vol sh) xs) := by
    rw [procL_eq_runDown, runDown_eq_foldl, toA_foldl (N := vol sh)
      (fun k => exactR y (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))))
      (fun k zs => length_twL _ _) _ _ hlen]
    rfl
  rw [← hQ, ← hL] at hchain
  have hlenQ : (procQ C p L ℓ P Sb n xs).length = vol sh := by
    unfold procQ
    rw [runDown_eq_foldl]
    have : ∀ (l : List ℕ) (zs : List R), zs.length = vol sh →
        (l.foldl (fun u k => compR C p (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))) u)
          zs).length = vol sh := by
      intro l; induction l with
      | nil => intro zs h; exact h
      | cons k l ih => intro zs _; exact ih _ (length_twL _ _)
    exact this _ _ hlen
  have hlenL : (procL y L ℓ P Sb n xs).length = vol sh := by
    rw [procL_eq_runDown, runDown_eq_foldl]
    have : ∀ (l : List ℕ) (zs : List R), zs.length = vol sh →
        (l.foldl (fun u k => exactR y (Sb (n - 1 - k)) (roundEx L ℓ (n - 1 - k) (P (n - 1 - k))) u)
          zs).length = vol sh := by
      intro l; induction l with
      | nil => intro zs h; exact h
      | cons k l ih => intro zs _; exact ih _ (length_twL _ _)
    exact this _ _ hlen
  have hpos : 0 < (n : ℝ) * (Real.sqrt 2 * 2⁻¹ ^ p) := by
    have : (1 : ℝ) ≤ n := by exact_mod_cast hn
    positivity
  -- the disk part: the fold of `A` stays in the disk
  have hdiskA : ∀ m, (List.range m).foldl (fun u k => A k u) (toA C (vol sh) xs) ∈ disk C (vol sh) := by
    intro m
    induction m with
    | zero => exact hx
    | succ m ih =>
      rw [List.range_succ, List.foldl_append]
      exact comp_disk p _ _ ih
  refine ⟨fun j => ?_, fun j => ?_⟩
  · by_cases hj : j < vol sh
    · have := norm_le_dist_carr (toA C (vol sh) (procQ C p L ℓ P Sb n xs))
        (toA C (vol sh) (procL y L ℓ P Sb n xs)) ⟨j, hj⟩
      exact lt_of_le_of_lt this hchain
    · rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega), sub_zero,
        map_zero, norm_zero]
      exact hpos
  · by_cases hj : j < vol sh
    · have := hdiskA n ⟨j, hj⟩
      rw [← hQ] at this
      exact this
    · rw [List.getD_eq_default _ _ (by omega), map_zero, norm_zero]; exact zero_le_one

/-- **Lemma 16 (error, any compatible layout).** With selected bits compatible with the layout
for every round, the computed forward procedure returns, at every valid address `v`, a record
within `ℓ √2 2^{-p}` (every coefficient) of `(F^- z)(rev (coord v))`, `z` the input array. -/
theorem lemma16_error_Fm (p : ℕ) {a : Fin D → ℕ} (L : CoordLayout sh a) {ℓ : ℕ}
    (hy : y ^ (2 ^ ℓ) = -1) (ha : ∀ i, a i ≤ ℓ) (hℓ : 1 ≤ ℓ)
    {Sb : (h : ℕ) → SelBits sh {i // i ∈ partAxes a h}}
    (hc : ∀ h < ℓ, SelCompat L h (partAxes a h) (Sb h))
    {xs : List R} (hlen : xs.length = vol sh) (hdisk : ∀ k, ‖C.co (xs.getD k 0)‖ ≤ 1)
    {v : List ℕ} (hv : Valid sh v) :
    ‖C.co ((procQ C p L ℓ (partAxes a) Sb ℓ xs).getD (encode sh v) 0 -
        Fm y ℓ a (fn L xs) (revV a (L.coord v)))‖ < ℓ * (Real.sqrt 2 * 2⁻¹ ^ p) := by
  rw [← synth_forward_list y L hy ha hc hlen hv]
  exact (lemma16_error p L ℓ (partAxes a) Sb ℓ hℓ hlen hdisk).1 _

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

end Paper

