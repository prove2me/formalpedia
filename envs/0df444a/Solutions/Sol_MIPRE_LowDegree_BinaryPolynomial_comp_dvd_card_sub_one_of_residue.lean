  have hf : f ∣ X ^ ((Fintype.card K - 1) / q) - 1 :=
    (hi.dvd_iff_aeval_eq_zero ha).mp (by simp [hp])
  have hc := map_dvd (compRingHom (X ^ q)) hf
  simpa only [coe_compRingHom_apply, sub_comp, pow_comp, X_comp, one_comp,
