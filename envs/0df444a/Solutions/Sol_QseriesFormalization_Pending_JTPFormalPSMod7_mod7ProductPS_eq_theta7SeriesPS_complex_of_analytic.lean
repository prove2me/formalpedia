lemma norm_lt_one_of_mem_emetric_unit_ball {q : ℂ}
    (hq : q ∈ Metric.eball (0 : ℂ) (1 : ENNReal)) :
    ‖q‖ < 1 := by
  have h1 : (1 : ENNReal) = ENNReal.ofReal 1 := by simp
  have h_ball : q ∈ Metric.ball (0 : ℂ) 1 := by
    rw [h1, Metric.emetric_ball] at hq
