section
-- Source module: Solutions.KFV6Math
/-!
# KFV §10: the arithmetic of one Kronecker record product

The pointwise step of Proposition 18 replaces records `x, z` by `Q_p(x z / r)` (`QQ ∘ PP` of
`GlueProp18`). On coefficient vectors:

* `ncv u v`: the negacyclic convolution (`co (X Z) = ncv (co X) (co Z)`, `KFV.co_mul`),
  `ppq r p u v = Q_p(ncv u v / r)`; **`co_ppq`**: `co (Q_p(r⁻¹ (X Z))) = ppq r p (co X) (co Z)`.
* `ncv_gauss`: with `u = s (a + i b)`, `v = s (c + i e)`, the Gaussian numerators are the folded
  integer convolutions `(H^{ac} - H^{be}) + i (H^{ae} + H^{bc})` (as `co_mul_gauss`).
* `kmul r p ρ zx zy`: the integer output record, `((hRe_j - hRe_{j+r}).tdiv 2^{p+ρ}, …)` with
  `hRe = cnv(re, re) - cnv(im, im)`, `hIm = cnv(re, im) + cnv(im, re)`; **`toC_kmul`**: for
  `r = 2^ρ` it is the numerator record (scale `2^p`) of `ppq r p u v`.
* **`extract_digits`**: for `Z = ∑_{j<J} h_j B^j` with `B = 2^b`, `h_j ∈ [-B/2, B/2)`, the
  shifted value `zfix B J Z = Z + [Z < 0] B^J` lies in `[0, B^J)`, and the centered carry pass
  over its base-`B` digits (`qd`) recovers every `h_j` (Lemma 17's extraction, `Synth.extract`).
* `rho_succ_eq`: the carry step is `ρ_{j+1} = (q_j + ρ_j + H) / (2H)` (one ruler `quo`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open Finset Butterfly Synth GlueError GlueProp18 KFB

/-! ## 1. Coefficients of the normalized truncated product -/

section NC

variable {r : ℕ}

/-- The negacyclic convolution of two coefficient vectors. -/
def ncv (u v : Fin r → ℂ) (j : Fin r) : ℂ :=
  ∑ i : Fin r, u i * (if h : (i : ℕ) ≤ j then v ⟨j - i, by omega⟩
    else - v ⟨j + r - i, by have := j.isLt; omega⟩)

/-- `Q_p (u v / r)` on coefficient vectors. -/
noncomputable def ppq (r p : ℕ) (u v : Fin r → ℂ) : Fin r → ℂ :=
  fun j => Qp p ((r : ℂ)⁻¹ * ncv u v j)

end NC

/-! ## 2. The integer output record -/

section Rec

/-- Real parts of a record. -/
def reF (zs : List GI) (i : ℕ) : ℤ := (zs.getD i 0).1

/-- Imaginary parts of a record. -/
def imF (zs : List GI) (i : ℕ) : ℤ := (zs.getD i 0).2

/-- Unfolded real numerators `cnv(a, c) - cnv(b, e)`. -/
def hRe (r : ℕ) (zx zy : List GI) (j : ℕ) : ℤ :=
  cnv r (reF zx) (reF zy) j - cnv r (imF zx) (imF zy) j

/-- Unfolded imaginary numerators `cnv(a, e) + cnv(b, c)`. -/
def hIm (r : ℕ) (zx zy : List GI) (j : ℕ) : ℤ :=
  cnv r (reF zx) (imF zy) j + cnv r (imF zx) (reF zy) j

/-- The output record: fold modulo `y^r + 1`, then truncate by `2^{p+ρ}`. -/
def kmul (r p ρ : ℕ) (zx zy : List GI) : List GI :=
  (List.range r).map fun j => ((hRe r zx zy j - hRe r zx zy (j + r)).tdiv (2 ^ (p + ρ)),
    (hIm r zx zy j - hIm r zx zy (j + r)).tdiv (2 ^ (p + ρ)))

end Rec

/-! ## 3. Extraction from the base-`2^b` digits -/

section Ext

/-- `Z + [Z < 0] B^J`. -/
def zfix (B : ℤ) (J : ℕ) (Z : ℤ) : ℤ := if Z < 0 then Z + B ^ J else Z

/-- Digit `j` of `x` in base `2^b`. -/
def qd (b x : ℕ) (j : ℕ) : ℤ := ((x / 2 ^ (b * j) % 2 ^ b : ℕ) : ℤ)

end Ext

end NLogN.KFV

end

section
-- Source module: Solutions.KFV6Loop
/-!
# KFV §10: the four register loops of one Kronecker record product

All on managed states `encK s f`, with the loop counter `vL`:

* **`unzP_fsp`**: split a record `gflat zs` (from stack `X`) into the offset real parts
  `(z.1 + c, 0)` (on `SA`) and offset imaginary parts `(z.2 + c, 0)` (on `SB`), each reversed, ready
  for KFT's packer `carI` after one `mvK`.
* **`carL_fsp`**: the centered carry pass over base-`2^b` digits `(q_j, 0)` on stack `0`:
  pushes `cent H (q_j + ρ_j)` on `vT` (`H = 2^{b-1}`), the carry `ρ` on `vRH` (two ruler ops).
* **`fldP_fsp`**: `(x - y).tdiv 2^Δ` of two equal-length stacks (the fold `h_j - h_{j+r}` and the
  truncation of Lemma 17 / `Q_p`).
* **`ilvP_fsp`**: interleave two stacks into Gaussian pairs.

Every loop step costs `O(w)` for `w`-bit values: the cost is linear in the record length.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 200000

namespace NLogN.KFV

open IntMul RS KIL KFD KFB Synth

/-! ## Stacks of the product phase (all below `26`, outside the KFN scratch) -/

abbrev vX : Fin HS := 1
abbrev vY : Fin HS := 2
abbrev vO : Fin HS := 3
abbrev vA : Fin HS := 4
abbrev vB : Fin HS := 5
abbrev vC : Fin HS := 6
abbrev vE : Fin HS := 7
abbrev vPA : Fin HS := 8
abbrev vPB : Fin HS := 9
abbrev vPC : Fin HS := 10
abbrev vPE : Fin HS := 11
abbrev vM1 : Fin HS := 12
abbrev vM2 : Fin HS := 13
abbrev vM3 : Fin HS := 14
abbrev vM4 : Fin HS := 15
abbrev vZ : Fin HS := 16
abbrev vRH : Fin HS := 17
abbrev vT : Fin HS := 18
abbrev vT2 : Fin HS := 19
abbrev vT4 : Fin HS := 20
abbrev vOR : Fin HS := 21
abbrev vOI : Fin HS := 22
abbrev vL : Fin HS := 23

/-! ## 1. Splitting a record into offset real and imaginary parts -/

/-- `(z.1 + c, 0)`. -/
def offG (c : ℤ) (z : GI) : GI := (z.1 + c, 0)

def unzB (X SA SB : Fin HS) (c : ℤ) : RS :=
  .seq (.push SA (.add (.reg X) (.lit c))) (.seq (.push SA (.lit 0)) (.seq (.pop X)
    (.seq (.push SB (.add (.reg X) (.lit c))) (.seq (.push SB (.lit 0)) (.pop X)))))

def unzP (X SA SB C : Fin HS) (c : ℤ) (n : ℕ) : RS := .rep C (.lit n) (unzB X SA SB c)

/-! ## 2. The centered carry pass -/

def xHE (H : ℤ) : Ex HS := .add (.add (.reg 0) (.reg vRH)) (.lit H)

def carB (H B : ℤ) : RS :=
  .seq (.push NLogN.KFV.vT (.add (.rem (xHE H) (.lit B)) (.lit (-H))))
    (.seq (.asg vRH (.quo (xHE H) (.lit B))) (.seq (.pop 0) (.pop 0)))

def carL (H B : ℤ) (J : ℕ) : RS :=
  .seq (.push vRH (.lit 0)) (.seq (.rep NLogN.KFV.vL (.lit J) (carB H B)) (.pop vRH))

/-- The extracted (centered) digit `j`. -/
def cdig (H : ℤ) (q : ℕ → ℤ) (j : ℕ) : ℤ := cent H (q j + rho H q j)

/-- The digit list as Gaussian pairs `(q, 0)`. -/
def dpair (qs : List ℤ) : List GI := qs.map fun x => (x, 0)

/-! ## 3. Fold and truncate: `(x - y).tdiv 2^Δ` of two stacks -/

def fldB (O : Fin HS) (Δ : ℕ) : RS :=
  .seq (.push O (.quo (.add (.reg NLogN.KFV.vT) (.neg (.reg vT4))) (.lit (2 ^ Δ)))) (.seq (.pop NLogN.KFV.vT) (.pop vT4))

def fldP (O : Fin HS) (Δ n : ℕ) : RS := .rep NLogN.KFV.vL (.lit n) (fldB O Δ)

/-- The fold-and-truncate of one pair. -/
def fdt (Δ : ℕ) (x y : ℤ) : ℤ := (x - y).tdiv (2 ^ Δ)

/-! ## 4. Interleaving two stacks into Gaussian pairs -/

def ilvB : RS := .seq (.push vO (.reg vOR)) (.seq (.push vO (.reg vOI)) (.seq (.pop vOR) (.pop vOI)))

def ilvP (n : ℕ) : RS := .rep NLogN.KFV.vL (.lit n) ilvB

end NLogN.KFV

end

section
-- Source module: Solutions.KFV6Pack
/-!
# KFV §10: packing, the four ring products, and the extraction of one record product

* `carE`, `digE`, `mvE`, `mulE`: KFT's packer `carI` and digit cutter `digI`, an `mv`, and one
  `MulOK` product (`KFM.mulC`) on managed states `encK s f`.
* **`packI_runs`**: `mvK` a reversed offset record onto stack `0`, `carI`, subtract the offset
  constant: the signed Kronecker integer `∑_h a_h 2^{b h}` on stack `P` (Lemma 17's packing).
* **`extI_runs`**: from two products `m₁, m₂` with `m₁ ± m₂ = ∑_{j<2r} h_j 2^{b j}`
  (`h_j ∈ [-2^{b-1}, 2^{b-1})`): `zfix`, `digI`, the centered carry pass `carL`, two `mvK`, and the
  fold-and-truncate `fldP`; pushes `((h_j - h_{j+r}).tdiv 2^Δ)_{j<r}` on stack `O`
  (`KFV6Math.extract_digits`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFT Synth

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## 1. IState-level pieces on managed states -/

/-! ## 2. Packing one offset part -/

/-- The packed value of an offset part, minus the offset constant. -/
def packI (S P : Fin HS) (b r : ℕ) (KG : ℤ) : IStmt HS Pp :=
  .seq (fcode (NLogN.mvK S 0 NLogN.KFV.vL (.lit ((2 * r : ℕ) : ℤ))))
    (.seq (carI b r) (fcode (.seq (.push P (.add (.reg 0) (.lit (-KG)))) (.pop 0))))

def cPack (r w b Bp : ℕ) : ℕ :=
  cLp (2 * r) (250 * (w + 2)) Bp + cCar b w r + (8000 * (Bp + 2) + (2 * Bp + 2))

/-! ## 3. Extraction of one Gaussian component -/

/-- `Z + [Z < 0] B^J` as an expression. -/
def zfE (e : Ex HS) (BJ : ℤ) : Ex HS := .sel e (.add e (.lit BJ)) e

/-- Extract one component: `zfix`, digits, centered carries, fold, truncate. -/
def extI (e : Ex HS) (O : Fin HS) (b r Δ : ℕ) : IStmt HS Pp :=
  .seq (fcode (.push vZ (zfE e ((2 ^ b) ^ (2 * r))))) <|
  .seq (.op (.mv vZ tX)) <|
  .seq (digI b 0 (2 * r) (2 * r)) <|
  .seq (fcode (carL (2 ^ (b - 1)) (2 ^ b) (2 * r))) <|
  .seq (fcode (NLogN.mvK NLogN.KFV.vT vT2 NLogN.KFV.vL (.lit (r : ℤ)))) <|
  .seq (fcode (NLogN.mvK vT2 vT4 NLogN.KFV.vL (.lit (r : ℤ)))) <|
  fcode (fldP O Δ r)

def cExt (esz r b Δ Bz Bb : ℕ) : ℕ :=
  (3 * esz + 4) * 2000 * (Bz + 2) + 110 * (Bz + 1) + cDig b 0 (2 * r) (2 * r) +
    (4000 * (b + 4) + cLp (2 * r) (40000 * (b + 4)) Bb + (2 * (b + 2) + 2)) +
    cLp r (250 * (b + 4)) Bb + cLp r (250 * (b + 4)) Bb + cLp r (20000 * (b + 2 + Δ + 3)) Bb

end NLogN.KFV

end

section
-- Source module: Solutions.KFV6Rec
/-!
# KFV §10: one Kronecker record product in IL

**`recI pM b r Δ c KG`** consumes record `x` (stack `vX`) and record `z` (stack `vY`) and pushes the
reversed output record on `vO`:

1. `unzP` twice: offset real / imaginary parts (`+ c`, `c = 2^p`);
2. `packI` four times: `A = ∑ a_h B^h`, `Bi = ∑ b_h B^h`, `C`, `E` (`B = 2^b`, Lemma 17 packing);
3. four `MulOK` products `CA, EB, EA, CB` (FM in `kTable`);
4. `extI` on `CA - EB` and on `EA + CB`: the folded, truncated numerators;
5. `ilvP`, then drop the scratch integers.

**`recI_runs`**: the result is `kmul r p ρ zx zy` (`KFV6Math`), whose `toC` is `2^p` times
`Q_p(x z / r)` when `r = 2^ρ` (`toC_kmul`). The cost is `O(r (b + p))` plus four products of
`(b r + 2)`-bit integers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFT Synth

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The scratch stacks of the record product are empty. -/
structure Tmp (f : Fin HS → List ℤ) : Prop where
  a : f vA = []
  b : f NLogN.KFV.vB = []
  c : f vC = []
  e : f NLogN.KFV.vE = []
  pa : f vPA = []
  pb : f vPB = []
  pc : f vPC = []
  pe : f vPE = []
  m1 : f vM1 = []
  m2 : f vM2 = []
  m3 : f vM3 = []
  m4 : f vM4 = []
  z : f vZ = []
  x : f tX = []
  rh : f vRH = []
  t : f NLogN.KFV.vT = []
  t2 : f vT2 = []
  t4 : f vT4 = []
  or : f vOR = []
  oi : f vOI = []
  l : f NLogN.KFV.vL = []

def dropsP : RS := .seq (.pop vPA) (.seq (.pop vPB) (.seq (.pop vPC) (.seq (.pop vPE)
  (.seq (.pop vM1) (.seq (.pop vM2) (.seq (.pop vM3) (.pop vM4)))))))

def subE : Ex HS := .add (.reg vM1) (.neg (.reg vM2))
def addE : Ex HS := .add (.reg vM3) (.reg vM4)

/-- The offset constant `c ∑_{h<r} B^h`. -/
def kG (b r : ℕ) (c : ℤ) : ℤ := ∑ h ∈ Finset.range r, c * (2 ^ b : ℤ) ^ h

/-- Cost of one record product (`φ` bounds one product of `(b r + 2)`-bit factors). -/
def cRec (r p b Δ φ : ℕ) : ℕ :=
  2 * cLp r (30000 * (p + 4)) (zsz ((2 * r : ℕ) : ℤ)) + 4 * cPack r (p + 2) b (b * r + 2) +
    4 * (φ + 1000 * (b * r + 3)) +
    cExt 4 r b Δ (b * (2 * r) + 2) (zsz ((2 * r : ℕ) : ℤ)) +
    cExt 3 r b Δ (b * (2 * r) + 2) (zsz ((2 * r : ℕ) : ℤ)) +
    cLp r (10000 * (b + 4)) (zsz ((2 * r : ℕ) : ℤ)) + 8 * (2 * (b * (2 * r) + 2) + 2)

end NLogN.KFV

end


