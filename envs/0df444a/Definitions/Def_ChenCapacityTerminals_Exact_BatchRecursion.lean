-- title:
--   Operational bisection recursion for conditioned terminal batching
-- statement:
--   $BatchCalls$ records the precise fixed-pair trace of the recursion in Theorem 3.2. A singleton gives one ordinary pair query. A larger list is split into two deterministic nearly equal halves; each half first uses the Lemma 3.1 augmented query, erases the auxiliary sink from its returned shore, and recurses exactly when its active intersection is nonempty, on the corresponding root restriction. Empty active child calls have empty traces. The auxiliary sink is the canonical fresh natural label $\max V+1$. $BatchRecursionCorrect$ adds the same output, network-volume and outside-work guarantees as $BatchAlgorithm$, but before choosing the concrete instruction program. $TerminalGroupProperty$ is exactly Lemma 3.1's full formal conclusion.
-- source:
--   Paper #665, Lemma 3.1 and Theorem 3.2, PDF pp. 8–9, especially the three-line proof procedure and the singleton, volume and scan bounds.

import Definitions.Def_ChenCapacityTerminals_Exact_Specifications

set_option autoImplicit false

namespace ChenCapacityTerminals.Exact

/-- The complete assertion of Lemma 3.1, packaged for use by the recursive batching proof. -/
def TerminalGroupProperty : Prop :=
  ∀ (G : Network) (r : ℕ) (J : Finset ℕ) (U : ℝ)
    (b : ℕ → ℕ), G.Valid → r ∈ G.vertices →
    J ⊆ G.vertices \ {r} → J.Nonempty → 0 < U →
    (∀ v ∈ G.vertices \ {r}, 1 + indegree G v ≤ b v) →
    (∀ B, Enclosure G r J U B →
      (∀ t ∈ J \ B, ∀ X, PairSide G r t X → U ≤ cut G X) ∧
      (∀ t ∈ J ∩ B, ∃ X, OptimalPair G r t X ∧ X ⊆ B) ∧
      cut G B ≤ U * (J ∩ B).card ∧
      (∀ η : ℝ, 0 < η → Conditioned G r b η →
        (mass b B : ℝ) ≤ U / η * (J ∩ B).card)) ∧
    (∀ z, z ∉ G.vertices →
      (∃ X, OptimalPair (enclosureNetwork G J U z) r z X) ∧
      ∀ X, OptimalPair (enclosureNetwork G J U z) r z X →
        Enclosure G r J U (X.erase z)) ∧
    (∃ O, LawfulExactOracle O) ∧
    (∀ O, LawfulExactOracle O → ∀ z, z ∉ G.vertices →
      Enclosure G r J U ((O ⟨enclosureNetwork G J U z, r, z⟩).shore.erase z))

/-- A canonical label fresh for the network and all of its augmented enclosure networks. -/
def batchFresh (G : Network) : ℕ := G.vertices.sup id + 1

/-- The first and second nearly equal halves, in the deterministic terminal-list order. -/
noncomputable def batchLeft (J : Finset ℕ) : Finset ℕ := (J.toList.take (J.card / 2)).toFinset

noncomputable def batchRight (J : Finset ℕ) : Finset ℕ := (J.toList.drop (J.card / 2)).toFinset

/-- The enclosure returned by the augmented fixed-pair call for one half. -/
noncomputable def batchEnclosure (O : ExactQuery → ExactAnswer) (G : Network)
    (r : ℕ) (J : Finset ℕ) (U : ℝ) : Finset ℕ :=
  (O ⟨enclosureNetwork G J U (batchFresh G), r, batchFresh G⟩).shore.erase (batchFresh G)

/-- The exact sequence of fixed-pair calls generated by the bisection recursion in Theorem 3.2.
An empty active list is only the skipped child of a split; the root call has a nonempty list.
The two enclosure calls precede the calls made by their nonempty children. -/
inductive BatchCalls (O : ExactQuery → ExactAnswer) :
    Network → ℕ → Finset ℕ → ℝ → List ExactQuery → Prop where
  | empty (G : Network) (r : ℕ) (U : ℝ) :
      BatchCalls O G r ∅ U []
  | singleton (G : Network) (r t : ℕ) (U : ℝ) :
      BatchCalls O G r {t} U [⟨G, r, t⟩]
  | split (G : Network) (r : ℕ) (J : Finset ℕ) (U : ℝ)
      (hcard : 2 ≤ J.card) (leftCalls rightCalls : List ExactQuery)
      (leftRec : BatchCalls O (restrict G r (batchEnclosure O G r (batchLeft J) U)) r
        (batchLeft J ∩ batchEnclosure O G r (batchLeft J) U) U leftCalls)
      (rightRec : BatchCalls O (restrict G r (batchEnclosure O G r (batchRight J) U)) r
        (batchRight J ∩ batchEnclosure O G r (batchRight J) U) U rightCalls) :
      BatchCalls O G r J U
        ([⟨enclosureNetwork G (batchLeft J) U (batchFresh G), r, batchFresh G⟩,
          ⟨enclosureNetwork G (batchRight J) U (batchFresh G), r, batchFresh G⟩] ++
          leftCalls ++ rightCalls)

/-- Semantic correctness and resource accounting for the concrete bisection call relation.
This isolates the inductive proof on the recursion tree from compilation of its scans,
restrictions, comparisons and output writes into the exact instruction language. -/
def BatchRecursionCorrect (C : ℝ) (k B : ℕ) : Prop :=
  ∀ (G : Network) (r : ℕ) (b : ℕ → ℕ) (J : Finset ℕ) (U η : ℝ),
    BatchParameters G r b J U η →
    ∀ W ≥ B * (Nat.log2 (2 + G.size) + 1),
      ∀ O, LawfulExactOracle O → ∃ time trace out,
        BatchCalls O G r J U trace ∧
        batchingOutput G r J U out ∧
        (exactVolume trace : ℝ) ≤ C * batchBudget G J U η ∧
        (time + 4 + 3 * G.arcs.length + 3 * J.card + G.vertices.card : ℕ) ≤
          C * batchBudget G J U η *
          (Real.log (2 + batchBudget G J U η)) ^ k

end ChenCapacityTerminals.Exact


