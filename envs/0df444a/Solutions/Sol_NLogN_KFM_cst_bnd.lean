variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution (Δ n : ℕ) (c h : NLogN.KFB.GI) (C H : ℂ) (hC : ‖C‖ ≤ 1) (hH : ‖H‖ ≤ 1)
    (hc : ‖NLogN.KFM.vP Δ c - C‖ ≤ (2 : ℝ)⁻¹ ^ Δ) (hh : ‖NLogN.KFM.vP Δ h - H‖ ≤ (2 : ℝ)⁻¹ ^ Δ)
    (hu : (4 * (n : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1) :
    ∀ k ≤ n, NLogN.KFM.GBnd (Δ + 2) (NLogN.KFM.cst Δ c h (NLogN.KFM.oneP Δ) k).1 ∧ NLogN.KFM.GBnd (Δ + 2) (NLogN.KFM.cst Δ c h (NLogN.KFM.oneP Δ) k).2 := by
  intro k hk
  have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ Δ := by positivity
  have hkn : (k : ℝ) ≤ n := by exact_mod_cast hk
  have hk0 : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  have hkk : (k : ℝ) ≤ (k : ℝ) ^ 2 := by exact_mod_cast Nat.le_self_pow two_ne_zero k
  have hsk : (4 * (k : ℝ) ^ 2 + 1) * (2 : ℝ)⁻¹ ^ Δ ≤ 1 := by
    refine le_trans (mul_le_mul_of_nonneg_right ?_ hu0) hu; nlinarith
  obtain ⟨e1, e2⟩ := NLogN.KFM.cst_err Δ c h (NLogN.KFM.oneP Δ) C H 1 hC hH (by simp) hc hh (by simp [NLogN.KFM.vP_oneP]) k hsk
  have b1 := NLogN.KFM.zsz_of_near Δ _ _ (NLogN.KFM.norm_mul_le_one hH (NLogN.KFM.norm_pow_le_one hC k))
    (e1.trans (le_trans (mul_le_mul_of_nonneg_right (by linarith) hu0) hsk))
  have b2 := NLogN.KFM.zsz_of_near Δ _ _ (NLogN.KFM.norm_mul_le_one (NLogN.KFM.norm_mul_le_one (by simp) (NLogN.KFM.norm_pow_le_one hH k))
    (NLogN.KFM.norm_pow_le_one hC _)) (e2.trans (by nlinarith))
  exact ⟨b1, b2⟩
end
