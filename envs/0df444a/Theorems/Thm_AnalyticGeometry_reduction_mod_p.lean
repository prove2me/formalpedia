-- title:
--   $\mathbb{Z}((T))_{>r}/p \;\cong\; \mathbb{F}_p((T))$
-- statement:
--   Let $0 < r < 1$ and let $p$ be a prime. Coefficientwise reduction modulo $p$ induces an
--   isomorphism
--   $$\mathbb{Z}((T))_{>r}\,/\,p \;\xrightarrow{\ \sim\ }\; \mathbb{F}_p((T)).$$
--   Concretely, two assertions: every $g \in \mathbb{F}_p((T))$ lifts to an overconvergent integral
--   Laurent series, and every overconvergent series all of whose coefficients are divisible by $p$ is
--   $p$ times an overconvergent series.
--
--   This is case (2) of Theorem 7.1 of the source: "we use that there is a set-theoretic section
--   $\mathbb{F}_p \to \mathbb{Z}$ with image $\{0, 1, \dots, p-1\}$, so we can always lift to a power
--   series with bounded coefficients $a_n$. But any power series with bounded coefficients lies in
--   $\mathbb{Z}((T))_{>r}$." Injectivity, stated here as the description of the kernel, is the easy
--   direction. Together with principality of $(p)$ this identifies the ideals $(p)$ as maximal.
-- source:
--   Peter Scholze (all results joint with Dustin Clausen), Lectures on Analytic Geometry, Lecture VII, pp. 42-44, Theorem 7.1 (attributed there to D. Harbater, Convergent arithmetic power series, Amer. J. Math. 106 (1984), 801-846). https://www.math.uni-bonn.de/people/scholze/Analytic.pdf

import Mathlib
import Definitions.Def_AnalyticGeometry_ZLaurentGT

namespace AnalyticGeometry

/-- Coefficientwise reduction modulo a prime `p` identifies `ℤ((T))_{>r}/p` with `𝔽_p((T))`:
it is surjective, and its kernel is the ideal generated by `p`. -/
theorem reduction_mod_p (r : ℝ) (hr0 : 0 < r) (hr1 : r < 1) (p : ℕ) (hp : p.Prime) :
    (∀ g : LaurentSeries (ZMod p), ∃ f ∈ zLaurentGT r,
        ∀ n : ℤ, ((f.coeff n : ZMod p)) = g.coeff n) ∧
      (∀ f ∈ zLaurentGT r, (∀ n : ℤ, ((f.coeff n : ZMod p)) = 0) →
        ∃ h ∈ zLaurentGT r, f = (p : LaurentSeries ℤ) * h) := by
  sorry

end AnalyticGeometry
