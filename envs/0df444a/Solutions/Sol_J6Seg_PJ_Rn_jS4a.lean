        ((l1 + m * (2 * w + 2) + 9) :: c sLn))
      (cJS4a W N m) := by
  unfold PJ.jS4a cJS4a
  set bl := l1 + m * (2 * w + 2) with hbl_def
  set u1 := update (update (update (update v 23 bl) 24 (m : ℤ)) 5 1) 6 0 with hu1
  have s1 : Ins.run (.a 23 blE) (v, c) = (update v 23 bl, c) := by
    simp only [Ins.run, blE, E.den, h23, h28, h26, hbl_def] <;> ring_nf
  have s2 : Ins.run (.a 24 (.r 28)) (update v 23 bl, c) = (update (update v 23 bl) 24 (m : ℤ), c) := by
    simp only [Ins.run, E.den]; rw [update_of_ne (by decide), h28]
  have eD : runL jD (v, c) = (u1, c) := by
    simp only [jD, runL]; rw [s1, s2]; simp only [Ins.run, E.den, hu1]
  have RD := Rn.insL (c := c) hN jD hv (by
    simp only [jD, OkL, s1, s2]
    refine ⟨?_, ?_, ?_, ?_, trivial⟩ <;> simp only [Ins.ok]
    · refine ⟨by decide, rfl, by simp only [blE, E.lb]; norm_num; omega, ?_⟩
      rw [show blE.den v = bl by simp only [blE, E.den, h23, h28, h26, hbl_def] <;> ring]
      rw [abs_of_nonneg hbl.1]; exact hbl.2
    · refine ⟨by decide, rfl, Nat.one_le_two_pow, ?_⟩
      simp only [E.den]; rw [update_of_ne (by decide), h28, abs_of_nonneg (by positivity)]
      exact_mod_cast (by omega : m ≤ 2 ^ W)
    · refine ⟨by decide, rfl, by simp only [E.lb]; norm_num <;> exact Nat.one_le_two_pow, ?_⟩
      simp only [E.den]; norm_num <;> exact one_le_pow₀ (by norm_num)
    · refine ⟨by decide, rfl, by simp only [E.lb]; norm_num <;> exact Nat.one_le_two_pow, ?_⟩
      simp only [E.den]; norm_num <;> exact one_le_pow₀ (by norm_num))
  rw [eD] at RD
  dsimp only at RD
  refine Rn.seq RD (fun w1 ⟨e1, b1⟩ => ?_)
  subst w1
  have RL := clL (W := W) (c := c) (vb := u1) (m := m) b1 (by simp (disch := decide) [hu1])
    (by simp [hu1]) (by simp (disch := decide) [hu1]) hm hcL
  refine Rn.seq RL (fun w2 ⟨e2, b2⟩ => ?_)
  subst w2
  set u2 := update (update u1 6 (Nat.clog 2 m : ℤ)) 5 ((2 ^ Nat.clog 2 m : ℕ) : ℤ) with hu2
  have g2 : ∀ j : Fin HS, j ≠ 5 → j ≠ 6 → j ≠ 23 → j ≠ 24 → u2 j = v j := fun j a b c' d => by
    rw [hu2, update_of_ne a, update_of_ne b, hu1, update_of_ne b, update_of_ne a, update_of_ne d,
      update_of_ne c']
  have r23 : u2 23 = bl := by
    rw [hu2, update_of_ne (by decide), update_of_ne (by decide), hu1, update_of_ne (by decide),
      update_of_ne (by decide), update_of_ne (by decide), update_self]
  have r5 : u2 5 = ((2 ^ Nat.clog 2 m : ℕ) : ℤ) := by rw [hu2, update_self]
  have r6 : u2 6 = Nat.clog 2 m := by rw [hu2, update_of_ne (by decide), update_self]
