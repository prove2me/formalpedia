/-!
# KIL2: the Lemma 10 controlled shift, self-contained

`shP` = offset-table generator `genP` (stack `14`), then the size parameters
`vol A, Q, vol C` pushed on stacks `1, 2, 4`, then `rotP`, then the parameters popped.

* `Sp.pushLit`, `Sp.popI`: pushes of literals and pops on arbitrary states.
* `shiftArr_il_spec`: `shP` computes `shiftArr Λ i 1 c 0 xs` (Lemma 10 case: unit coefficient
  `1`, controls before the target), stack disciplined, cost
  `O((|A| + 1) · (V + 1) · (Bb + 2) + (Bb + 2)^2)`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KIL

open IntMul RS AModel

theorem Sp.popI (u : IState HS) {i : Fin HS} (hi : i.val < 56) {a : ℤ} {L : List Item}
    (h : u.G i = .int a :: L) {Bb : ℕ} (ha : zsz a ≤ Bb) :
    Sp (.pop i) u (u.upd i L) (2 * Bb + 2) :=
  ⟨⟨hi, IState.isInt_of_r6c h⟩, by simp [RS.run, h], by
    simp only [RS.cost, IState.top_eq_r6c h]; omega⟩

end NLogN.KIL

