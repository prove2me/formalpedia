    have H3 := FSp.of_norep rfl (h1.seq (h2.seq h3))
    refine FSp.mono (FSp.congr H3 ?_) (by simp only [Ex.size]; omega)
    congr 1
    funext j
    simp only [hG2, hG1, hG, dupSt, Function.update_apply]
    by_cases h1 : j = X
    · simp only [h1, if_true, if_neg hXY, if_neg hXZ, if_neg hXC]
    by_cases h2 : j = Y
    · simp only [h2, if_true, if_neg hXY.symm, if_neg hYZ, if_neg hYC, if_neg hYZ.symm, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
