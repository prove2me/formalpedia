theorem solution (O V : Type) [CommRing O] [AddCommGroup V] [Module O V]
    (I : Ideal O) [MeasurableSpace V] (hgen : ‹MeasurableSpace V› = TypeDensity.adicCylinderSpace I V)
    (F : V → V) (honto : Function.Surjective F)
    (hcong : ∀ j x y, TypeDensity.adicCongr I j (F x) (F y) ↔ TypeDensity.adicCongr I j x y) :
    Measurable F := by
  rw [hgen]
  let _ : MeasurableSpace V := TypeDensity.adicCylinderSpace I V
  refine measurable_generateFrom fun s hs => ?_
  rcases hs with rfl | ⟨j, a, rfl⟩
  · simp
  · obtain ⟨b, rfl⟩ := honto a
    have : F ⁻¹' {y | adicCongr I j y (F b)} = {y | adicCongr I j y b} := by
      ext y; simp [hcong]
    exact this ▸ MeasurableSpace.measurableSet_generateFrom (Or.inr ⟨j, b, rfl⟩)
