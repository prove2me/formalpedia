namespace DecrAlmostLinearSSSP.Decremental.CoreDegree
open Structured
attribute [local instance] Classical.propDecidable
lemma eval_code (vertex : ℕ) (s : Data) : Eval (code vertex) s 5 (result vertex s) := eval_sequence_atoms (atoms vertex) s
lemma values (vertex base v : ℕ) (s : Data) (hb : s.natReg 554 = base) (hv : s.natReg vertex = v) (h1 : s.natReg 26 = 1) :
    (result vertex s).natMem = Function.update s.natMem (base+2*v) (s.natMem (base+2*v)+1) ∧
    (result vertex s).realMem = s.realMem := by
  simp [result,atoms,Atom.effect,instructionEffect,data,Data.machine,hb,hv,h1,two_mul]
lemma Image.increment {n : ℕ} (vertex base : ℕ) (v : Fin n) (heads : List (Fin n)) (s : Data)
    (h : Image base heads s) (hb : s.natReg 554 = base) (hv : s.natReg vertex = v.val) (h1 : s.natReg 26 = 1) :
    Image base (v::heads) (result vertex s) := by
  constructor
  intro w
  rw [(values vertex base v.val s hb hv h1).1]
  by_cases hw : w = v
  · subst w
    simp [h.entries,List.count_cons]
  · have hne : base+2*w.val ≠ base+2*v.val := by intro hh;apply hw;apply Fin.ext;omega
    rw [Function.update_of_ne hne,h.entries w]
    simp [List.count_cons,hw,Ne.symm hw]
lemma nat_frame (vertex k : ℕ) (h620 : k ≠ 620) (h662 : k ≠ 662) : NatFrame (code vertex) k := by
  simp [code,atoms,Structured.sequence,NatFrame,writesNat,Ne.symm h620,Ne.symm h662]
