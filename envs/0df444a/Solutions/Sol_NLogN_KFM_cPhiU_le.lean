  set T := IntMul.OpenAI.Glue.TP n
  set p := IntMul.OpenAI.Glue.pP n
  set d := IntMul.OpenAI.Glue.dP n
  set h := IntMul.OpenAI.Glue.ℓP n - 1
  set Bb := NLogN.zsz ((2 * VS : ℕ) : ℤ)
  -- the three parts of `cPhi`
  have hA : 3 * (((d + 1) * NLogN.KFU.cScan VT (p + 2) + 1 : ℕ)) ≤ 10 ^ 7 * (d * (T * p)) := by
