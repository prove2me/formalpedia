variable {α : Type*} [DecidableEq α]

/-- Normalize the partner at `u` to the distinguished right endpoint `w`. -/
def normalizePartner (π : Equiv.Perm α) (u w : α) : Equiv.Perm α :=
  π.trans (Equiv.swap (π u) w)

/-- Reinsert a normalized left-to-right path at the chosen new partner. -/
def shiftPartner (π : Equiv.Perm α) (u w v : α) : Equiv.Perm α :=
  (normalizePartner π u w).trans (Equiv.swap w v)

@[simp] theorem normalizePartner_apply (π : Equiv.Perm α) (u w : α) :
    normalizePartner π u w u = w := by simp [normalizePartner]

@[simp] theorem shiftPartner_apply (π : Equiv.Perm α) (u w v : α) :
    shiftPartner π u w v u = v := by simp [shiftPartner]

@[simp] theorem normalizePartner_shift (π : Equiv.Perm α) (u w v : α) :
    normalizePartner (shiftPartner π u w v) u w = normalizePartner π u w := by
  change (shiftPartner π u w v).trans (Equiv.swap (shiftPartner π u w v u) w) = _
  rw [shiftPartner_apply]
  change ((normalizePartner π u w).trans (Equiv.swap w v)).trans (Equiv.swap v w) = _
  ext x
  simp only [Equiv.trans_apply]
  rw [Equiv.swap_comm v w, Equiv.swap_apply_self]

@[simp] theorem shiftPartner_shift (π : Equiv.Perm α) (u w v v' : α) :
    shiftPartner (shiftPartner π u w v) u w v' = shiftPartner π u w v' := by
  change (normalizePartner (shiftPartner π u w v) u w).trans (Equiv.swap w v') = _
  rw [normalizePartner_shift]
  rfl

@[simp] theorem shiftPartner_original (π : Equiv.Perm α) (u w : α) :
    shiftPartner π u w (π u) = π := by
  ext x
  simp only [shiftPartner, normalizePartner, Equiv.trans_apply]
  rw [Equiv.swap_comm w (π u), Equiv.swap_apply_self]

theorem shiftPartner_fixed (π : Equiv.Perm α) (u w v d : α)
    (hdu : d ≠ u) (hdw : π d ≠ w) (hdv : π d ≠ v) :
    shiftPartner π u w v d = π d := by
  have hdu' : π d ≠ π u := π.injective.ne hdu
  simp only [shiftPartner, normalizePartner, Equiv.trans_apply,
    Equiv.swap_apply_of_ne_of_ne hdu' hdw,
    Equiv.swap_apply_of_ne_of_ne hdw hdv]

