-- Source module: Solutions.KFV6Math
/-!
# KFV §10: the arithmetic of one Kronecker record product

The pointwise step of Proposition 18 replaces records `x, z` by `Q_p(x z / r)` (`QQ ∘ PP` of
`GlueProp18`). On coefficient vectors:

* `ncv u v`: the negacyclic convolution (`co (X Z) = ncv (co X) (co Z)`, `KFV.co_mul`),
  `ppq r p u v = Q_p(ncv u v / r)`; **`co_ppq`**: `co (Q_p(r⁻¹ (X Z))) = ppq r p (co X) (co Z)`.
* `ncv_gauss`: with `u = s (a + i b)`, `v = s (c + i e)`, the Gaussian numerators are the folded
  integer convolutions `(H^{ac} - H^{be}) + i (H^{ae} + H^{bc})` (as `co_mul_gauss`).
* `kmul r p ρ zx zy`: the integer output record, `((hRe_j - hRe_{j+r}).tdiv 2^{p+ρ}, …)` with
  `hRe = cnv(re, re) - cnv(im, im)`, `hIm = cnv(re, im) + cnv(im, re)`; **`toC_kmul`**: for
  `r = 2^ρ` it is the numerator record (scale `2^p`) of `ppq r p u v`.
* **`extract_digits`**: for `Z = ∑_{j<J} h_j B^j` with `B = 2^b`, `h_j ∈ [-B/2, B/2)`, the
  shifted value `zfix B J Z = Z + [Z < 0] B^J` lies in `[0, B^J)`, and the centered carry pass
  over its base-`B` digits (`qd`) recovers every `h_j` (Lemma 17's extraction, `Synth.extract`).
* `rho_succ_eq`: the carry step is `ρ_{j+1} = (q_j + ρ_j + H) / (2H)` (one ruler `quo`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open Finset Butterfly Synth GlueError GlueProp18 KFB

/-! ## 1. Coefficients of the normalized truncated product -/

/-! ## 2. The integer output record -/

/-! ## 3. Extraction from the base-`2^b` digits -/

section Ext

theorem abs_sum_lt {H : ℤ} (hH : 1 ≤ H) {h : ℕ → ℤ} :
    ∀ J, (∀ j < J, |h j| ≤ H) → |∑ j ∈ range J, h j * (2 * H) ^ j| < (2 * H) ^ J
  | 0, _ => by simp
  | J + 1, hh => by
    rw [sum_range_succ]
    have ih := abs_sum_lt hH J (fun j hj => hh j (by omega))
    have h1 := hh J (by omega)
    have hp : (0 : ℤ) < (2 * H) ^ J := pow_pos (by omega) _
    calc |∑ j ∈ range J, h j * (2 * H) ^ j + h J * (2 * H) ^ J|
        ≤ |∑ j ∈ range J, h j * (2 * H) ^ j| + |h J * (2 * H) ^ J| := abs_add_le _ _
      _ < (2 * H) ^ J + H * (2 * H) ^ J := by
        rw [abs_mul, abs_of_pos hp]
        have := mul_le_mul_of_nonneg_right h1 hp.le
        linarith
      _ ≤ (2 * H) ^ (J + 1) := by rw [pow_succ]; nlinarith

theorem two_pow_pred {b : ℕ} (hb : 1 ≤ b) : (2 : ℤ) ^ b = 2 * 2 ^ (b - 1) := by
  rw [← pow_succ']; congr 1; omega

end Ext

end NLogN.KFV

end

