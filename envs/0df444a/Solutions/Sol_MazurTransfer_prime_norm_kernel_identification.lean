Design boundary: order a prime-cardinality norm-kernel dichotomy and
identify its cyclic factor using one checked element of prime order.
Named downstream consumer: the SAME order-thirteen represented Picard
rational norm kernels, generated by the infinity point.
-/
import Mathlib

theorem solution (G : Type) [Group G] (f g : G →* G) (p : ℕ)
    (hp : Nat.Prime p) (x : G) (hx : x ∈ g.ker) (ho : orderOf x = p)
    (hc : (Nat.card f.ker = p ∧ Nat.card g.ker = 1) ∨
      (Nat.card f.ker = 1 ∧ Nat.card g.ker = p)) :
    f.ker = ⊥ ∧ g.ker = Subgroup.zpowers x := by
  have hxne : x ≠ 1 := by
    intro h
    rw [h, orderOf_one] at ho
    exact hp.ne_one ho.symm
  obtain ⟨hf, hg⟩ : Nat.card f.ker = 1 ∧ Nat.card g.ker = p := by
    rcases hc with h | h
    · haveI : Subsingleton g.ker := (Nat.card_eq_one_iff_unique.mp h.2).1
      have he : (⟨x, hx⟩ : g.ker) = 1 := Subsingleton.elim _ _
      exact False.elim (hxne (congrArg Subtype.val he))
    · exact h
  refine ⟨Subgroup.eq_bot_of_card_eq f.ker hf, ?_⟩
  letI : Finite g.ker := Nat.finite_of_card_ne_zero (by rw [hg]; exact hp.ne_zero)
  apply Eq.symm
  apply Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le_of_mem hx)
  rw [hg, Nat.card_zpowers, ho]

#print axioms solution
