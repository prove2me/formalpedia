/-- Summability (plain): `Summable (fun n => q^n · cubeConvolution n)` for `‖q‖ < 1`. -/
theorem summable_qpow_cubeConvolution (q : ℂ) (hq : ‖q‖ < 1) :
    Summable (fun n : ℕ => q^n * ((cubeConvolution n : ℤ) : ℂ)) :=
