theorem sp_rgP_sol_aux {A Y C R : Fin HS} (hAY : A ≠ Y) (hAC : A ≠ C) (hYC : Y ≠ C) (hRC : R ≠ C)
    (hRA : R ≠ A) (hRY : R ≠ Y) (hA5 : A.val < 56) (hY5 : Y.val < 56) (hC5 : C.val < 56)
    (hR5 : R.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L la lr : List ℤ)
    (hA : f A = L ++ la) (hC : f C = []) (hR : f R = (L.length : ℤ) :: lr) (B : ℕ)
    (hL : Bnd B L) (hn : zsz (L.length : ℤ) ≤ B) :
    Sp (rgP A Y C R) (encK s f)
      (encK s (Function.update (Function.update f A la) Y
        (gflat (L.reverse.map fun v => (v, 0)) ++ f Y))) (cMvP L.length B) := by
  set N := L.length with hN
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update f A
    (L.drop k ++ la)) Y (gflat ((L.take k).reverse.map fun v => (v, 0)) ++ f Y)
  have hF0 : F 0 = f := by
    funext j; simp only [F, Function.update_apply, List.drop_zero, List.take_zero, List.reverse_nil,
      List.map_nil, gflat_nil, List.nil_append]
    split_ifs with h1 h2 <;> (try subst h1) <;> (try subst h2) <;> simp_all
  have hFN : F N = Function.update (Function.update f A la) Y
      (gflat (L.reverse.map fun v => (v, 0)) ++ f Y) := by
    simp only [F, hN, List.drop_length, List.take_length, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by
    simp only [F, Function.update_apply, if_neg hAC.symm, if_neg hYC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (.seq (.push Y (.lit 0)) (.seq (.push Y (.reg A)) (.pop A)))
      (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (30000 * (B + 2)) := by
    intro k hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : L.take (k + 1) = L.take k ++ [L[k]] := (List.take_concat_get' L k hk).symm
    have hb := hL _ (List.getElem_mem hk)
    set G := Function.update (F k) C [(N : ℤ) - k] with hG
    have gA : G A = L[k] :: (L.drop (k + 1) ++ la) := by
      simp only [hG, F, Function.update_apply, if_neg hAC, if_neg hAY, if_true, hd, List.cons_append]
    have s1 := sp_pushL (s := s) G (i := Y) 0 (B := B) hY5 (by simp [zsz_zero])
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G Y (0 :: G Y) := ⟨_, rfl⟩
    rw [← hG1] at s1
    have s2 := sp_pushR (s := s) G1 (i := Y) hY5 hA5 (by rw [hG1, Function.update_apply, if_neg hAY, gA]) hb
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 Y (L[k] :: G1 Y) := ⟨_, rfl⟩
    rw [← hG2] at s2
    have s3 := sp_pop (s := s) G2 (i := A) hA5
      (by rw [hG2, Function.update_apply, if_neg hAY, hG1, Function.update_apply, if_neg hAY, gA]) hb
    refine ((s1.seq (s2.seq s3)).congr ?_).mono (by omega)
    congr 1; funext j
    simp only [hG2, hG1, hG, F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hAC.symm, hYC.symm]
    by_cases h2 : j = A
    · subst h2; simp [hAC, hAY]
    by_cases h3 : j = Y
    · subst h3; simp only [hAY.symm, hYC, if_false, if_true, ↓reduceIte, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.map_cons, gflat_cons, List.cons_append]
    · simp [h1, h2, h3]
  have H := Sp.rep (C := C) (n := .reg R) (b := .seq (.push Y (.lit 0)) (.seq (.push Y (.reg A))
    (.pop A))) (s := s) (F := F) (N := N) (B := B) (c := 30000 * (B + 2)) hC5 hFC
    (by simp [RS.writes, hAC.symm, hYC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0, hFN] at H
  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

