-- title:
--   Lemma A.9, (45), p. 19 — contraction of the lower-level error ‖ȳ − y*(x̄)‖
-- statement:
--   Under Assumptions 2.1 and 2.2, let $y^*(x)$ minimize $f(x,\cdot)$ for every $x$, and let the sequences be generated by Algorithm 1 from BOX 1 with $\alpha,\eta>0$ and $0<\beta<1/L_{f,1}$. For every $k\ge0$,
--   $$\|\bar y^{k+1}-y^*(\bar x^k)\|^2\le\Big(1-\frac{\beta\sigma}2\Big)\|\bar y^k-y^*(\bar x^k)\|^2+\frac{3\beta L_{f,1}^2}{n\sigma}\sum_{i=1}^n\big(\|\bar x^k-x^k_i\|^2+\|\bar y^k-y^k_i\|^2\big).$$
--
--   The averaged lower-level iterate approaches the solution at a linear rate, up to consensus errors.
--
--   **Formalization Note.** The step-size bound $\beta<1/L_{f,1}$ is one of the bounds of (62), p. 24, which the proof uses through $\beta\le2/(\sigma+L_{f,1})$ and $\beta\sigma\le1$. It is written $\beta L_{f,1}<1$, which is the same condition when $L_{f,1}>0$ (always the case when $q\ge1$, since then $\sigma\le L_{f,1}$).
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 19, Lemma A.9, (45); β < 1/Lf,1 from (62), p. 24

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_9 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0)
    (ystar : E p → E q) (hystar : ∀ x, IsMinOn (avgf f x) Set.univ (ystar x)) (hβL : β * Lf1 < 1) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    ‖avg (s (k + 1)).y - ystar (avg (s k).x)‖ ^ 2 ≤
      (1 - β * σ / 2) * ‖avg (s k).y - ystar (avg (s k).x)‖ ^ 2 +
      3 * β * Lf1 ^ 2 / (n * σ) *
        ∑ i, (‖avg (s k).x - (s k).x i‖ ^ 2 + ‖avg (s k).y - (s k).y i‖ ^ 2) := by sorry

end DecBilevel.SLDBO
