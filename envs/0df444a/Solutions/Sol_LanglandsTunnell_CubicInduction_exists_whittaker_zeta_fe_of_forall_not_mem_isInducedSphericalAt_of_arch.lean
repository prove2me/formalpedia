    (W : AdelicGL 3 (𝓞 ℚ) ℚ → ℂ)
    (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (hgT : ∀ w ∉ T, componentAt3 (𝓞 ℚ) ℚ w g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ w)
    (hχT : ∀ w ∉ T, NumberField.TateGlobal.IsUnramifiedCharAt χ w)
    (hvS : ∀ v, v ∉ T → v ∉ S)
    (χT : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm)
    (hfacW : ∀ (g : AdelicGL 3 (𝓞 ℚ) ℚ) (T : Finset (HeightOneSpectrum (𝓞 ℚ))), S ⊆ T →
