theorem pow4_le (x : ℕ) : x ^ 4 ≤ 32 * 2 ^ x := by
  induction x with
  | zero => norm_num
  | succ n ih =>
    by_cases hn : n < 9
    · interval_cases n <;> norm_num
    · push_neg at hn
      have h1 : (n + 1) ^ 4 ≤ 2 * n ^ 4 := by
        have : 9 * n ^ 3 ≤ n ^ 4 := by
          have := Nat.mul_le_mul_right (n ^ 3) hn; nlinarith [this]
        nlinarith [Nat.zero_le n, sq_nonneg n]
      calc (n + 1) ^ 4 ≤ 2 * n ^ 4 := h1
        _ ≤ 2 * (32 * 2 ^ n) := by omega
        _ = 32 * 2 ^ (n + 1) := by ring

theorem zsz_le_self (n : ℕ) : zsz (n : ℤ) ≤ n :=
  zsz_le_of_lt (by simpa using Nat.lt_two_pow_self)

theorem sq_add_le (a b : ℕ) : (a + b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := by
  zify; nlinarith [sq_nonneg ((a : ℤ) - b)]

theorem vol_range_ge (f : ℕ → ℕ) (hf : ∀ j, 2 ≤ f j) :
    ∀ d, 2 ^ d ≤ vol ((List.range d).map f)
  | 0 => by simp [vol]
  | d + 1 => by
    rw [List.range_succ, List.map_append, vol_append]
    have ih := vol_range_ge f hf d
    simp only [List.map_cons, List.map_nil, vol, List.prod_cons, List.prod_nil, mul_one] at ih ⊢
    rw [pow_succ]; exact Nat.mul_le_mul ih (hf d)

theorem VT_ge (d h : ℕ) (bL : ℕ → Bool) (hh : 1 ≤ h) : 2 ^ (d + 1) ≤ vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) := by
  have e : (List.range d).map (NLogN.KFU.tP d h bL) =
      (List.range d).map (fun j => 2 ^ h * (if bL j then 2 else 1)) :=
    List.map_congr_left fun j hj => by
      rw [tP_eq, if_pos (List.mem_range.1 hj)]; split_ifs <;> simp [*]
  rw [shR_eq_app, vol_append, e]
  have := vol_range_ge (fun j => 2 ^ h * (if bL j then 2 else 1)) (fun j => by
    have := Nat.one_le_two_pow (n := h)
    have : 2 ≤ 2 ^ h := by
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ h := Nat.pow_le_pow_right (by norm_num) hh
    split_ifs <;> omega) d
  have e2 : vol [NLogN.KFU.tP d h bL d] = 2 := by rw [tP_eq]; simp [vol]
  rw [e2, pow_succ]; exact Nat.mul_le_mul_right 2 this

theorem VS_le_VT (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ)
    (hst : ∀ j < d, sF j ≤ 2 ^ (h + if bL j then 1 else 0)) :
    vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) ≤ vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) := by
  apply vol_le_of_forall₂
  refine forall₂_map_le (fun j _ => ?_)
  rw [tP_eq]; unfold NLogN.KFU.sP
  by_cases h1 : j < d
  · have := hst j h1
    simp only [h1, if_true]
    cases hb : bL j <;> simp_all [pow_succ]
  · simp [h1]

theorem PM_le (d : ℕ) (sF : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j) :
    1 ≤ vol ((List.range (d - 1)).map sF) ∧
      vol ((List.range (d - 1)).map sF) ≤ vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) := by
  have hP := Pv_pos sF hs
  refine ⟨hP (d - 1) (by omega), ?_⟩
  have h1 : vol ((List.range (d - 1)).map sF) = Pv sF (d - 1) := rfl
  have h2 := Pv_mono sF hs (show d - 1 ≤ d by omega)
  have e : vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) = Pv sF d * 2 := by
    have e : (List.range d).map (NLogN.KFU.sP d sF) = (List.range d).map sF :=
      List.map_congr_left fun j hj => by simp [NLogN.KFU.sP, List.mem_range.1 hj]
    rw [shR_eq_app, vol_append, e]
    simp [Pv, vol, NLogN.KFU.sP]
  rw [h1, e]; omega

theorem swq_le (w h d VT VS V' : ℕ) (hd : 2 ^ (d + 1) ≤ VT) (hST : VS ≤ VT) (hV' : V' ≤ VT) :
    (d + 1) * (Nat.size V' + w + h + 1) ^ 2 ≤
      130 * ((d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2) := by
  set L := Nat.size VT with hL
  set H := h + w + Nat.size VS + 1 with hH
  have hLd : d + 2 ≤ L := by
    have : d + 1 < Nat.size VT := Nat.lt_size.2 hd
    omega
  have hL4 : L ^ 4 ≤ 64 * VT := by
    have h1 := pow4_le L
    have h2 : 2 ^ (L - 1) ≤ VT := Nat.lt_size.1 (by omega)
    have h3 : 2 ^ L = 2 * 2 ^ (L - 1) := by rw [← pow_succ']; congr 1; omega
    omega
  have hL3 : (d + 1) * L ^ 2 ≤ L ^ 4 := by
    have : (d + 1) * L ^ 2 ≤ L * L ^ 2 := Nat.mul_le_mul_right _ (by omega)
    have : L * L ^ 2 ≤ L ^ 4 := by
      have : L ≤ L ^ 2 := by nlinarith
      nlinarith
    omega
  have hs : Nat.size V' ≤ L := Nat.size_le_size hV'
  have a : Nat.size V' + w + h + 1 ≤ L + H := by omega
  have b : (d + 1) * (Nat.size V' + w + h + 1) ^ 2 ≤ (d + 1) * (2 * L ^ 2 + 2 * H ^ 2) :=
    Nat.mul_le_mul_left _ (le_trans (Nat.pow_le_pow_left a 2) (sq_add_le L H))
  have c : VT ≤ (d + 1) * cScan VT w := by
    have : VT ≤ cScan VT w := by unfold cScan; nlinarith
    nlinarith
  have e : (d + 1) * (2 * L ^ 2 + 2 * H ^ 2) = 2 * ((d + 1) * L ^ 2) + 2 * ((d + 1) * H ^ 2) := by
    ring
  omega

end NLogN.KFUU

