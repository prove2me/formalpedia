theorem solution {E : Type*} [Ring E] {a A b : ℕ → E} (ha : a = nabla A) {n : ℕ} :
    cumsum (a * b) (n + 1) = A (n + 1) * b n - A 0 * b 0 -
    cumsum (shift A * fun i => (b (i + 1) - b i)) n := by
  subst a
  induction n with
  | zero =>
      simp [cumsum, nabla]
      noncomm_ring
  | succ n ih =>
      simp only [cumsum, Finset.sum_range_succ, Pi.mul_apply, nabla, shift] at ih ⊢
      rw [ih]
      noncomm_ring
