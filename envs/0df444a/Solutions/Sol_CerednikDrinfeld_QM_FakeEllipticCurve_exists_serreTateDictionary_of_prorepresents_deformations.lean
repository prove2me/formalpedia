theorem Rig.isSpecial_and_hasHeight (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} {X : FormalODModule q A}
    {θ : RelativeGroupLaw.FormalCoordinates E.f 2} {w : (X.map resA).Hom X₀.toFormalODModule}
