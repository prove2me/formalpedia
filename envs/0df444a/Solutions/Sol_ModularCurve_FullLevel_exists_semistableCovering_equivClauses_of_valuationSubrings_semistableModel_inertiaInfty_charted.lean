theorem chartSpec_of_G (hA : A.LiesOverPrime q) {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A (fieldBar q M') Fbar) (O : ValuationSubring (fieldBar q M')) (hRO : R.integers = O)
    (htr : ∃ t : Fbar, Transcendental (ResidueField A) t)
    (hrat : ∀ P : Place (AlgebraicClosure ℚ) (fieldBar q M'), P.IsRational)
    (N : Finset (Place (ResidueField A) Fbar))
    (disc : Place (ResidueField A) Fbar → Set (Place (AlgebraicClosure ℚ) (fieldBar q M'))) (coord : Place (ResidueField A) Fbar → (fieldBar q M'))
    (hfam : R.DiscFamily N disc coord)
    (hNstab : ∀ τ ∈ LevelAuts q M', ∀ (hτ : ∀ f : (fieldBar q M'), τ f ∈ R.integers ↔ f ∈ R.integers) (Q : Place (ResidueField A) Fbar),
      R.resAut τ hτ • Q ∈ N ↔ Q ∈ N)
    (hdiscstab : ∀ τ ∈ LevelAuts q M', ∀ (hτ : ∀ f : (fieldBar q M'), τ f ∈ R.integers ↔ f ∈ R.integers) (Q : Place (ResidueField A) Fbar),
      Q ∉ N → RegularProlongation.smulDisc τ (disc Q) = disc (R.resAut τ hτ • Q))
    (n : ℕ) (hcard : N.card = n) (hn : 0 < n) :
    ∃ C : ComponentChart A (fieldBar q M') Fbar,
      ChartSpec q M' A C O n ∧ C.nodes = N ∧
      (∀ P, P ∈ C.dom ↔ ∃ Q, Q ∉ N ∧ P ∈ disc Q) ∧
      (∀ P Q, Q ∉ N → P ∈ disc Q → C.placeMap P = Q) ∧
      (∀ (f : (fieldBar q M')) (hC : f ∈ C.integers) (hR : f ∈ R.integers), C.residue ⟨f, hC⟩ = R.residue ⟨f, hR⟩) ∧
      (∀ P P', P ∉ C.dom → P' ∉ C.dom → C.placeMap P = C.placeMap P') := by
  have hne : Nonempty (Place (ResidueField A) Fbar) := by
    obtain ⟨Q, -⟩ := Finset.card_pos.mp (hcard ▸ hn)
    exact ⟨Q⟩
  obtain ⟨C, h1, h2, h3, h4, h5, h6⟩ := R.G_shape_family N hne disc coord hfam.1 hfam.2
  obtain ⟨hPD, hratbar, hcurve, hfin⟩ := reducedField_facts q M' A hA C htr
  refine ⟨C, ⟨h1.trans hRO, by rw [h3, hcard], ?_, hPD, hratbar, hcurve, hfin, ?_⟩, h3, h4, h5, h2, h6⟩
  · intro τ hτm hτ
    have hτ' : ∀ f : (fieldBar q M'), τ f ∈ R.integers ↔ f ∈ R.integers := fun f => by
      have e := SetLike.ext_iff.mp hτ f
      rwa [ComponentChart.mem_comap_integers, h1] at e
    ext P
    rw [ComponentChart.mem_comap_dom, h4, h4]
    constructor
    · rintro ⟨Q, hQN, hQP⟩
      have hQ'N : (R.resAut τ hτ')⁻¹ • Q ∉ N := by rwa [← hNstab τ hτm hτ', smul_inv_smul]
      refine ⟨(R.resAut τ hτ')⁻¹ • Q, hQ'N, ?_⟩
      rw [← RegularProlongation.smul_mem_smulDisc_iff τ, hdiscstab τ hτm hτ' _ hQ'N, smul_inv_smul]
      exact hQP
    · rintro ⟨Q, hQN, hQP⟩
      refine ⟨R.resAut τ hτ' • Q, fun h => hQN ((hNstab τ hτm hτ' Q).mp h), ?_⟩
      rw [← hdiscstab τ hτm hτ' Q hQN, RegularProlongation.smul_mem_smulDisc_iff]
      exact hQP
  · intro Q hQ
    rw [h3] at hQ
    exact R.discFibre_body_of_family N C disc coord hfam h1 h2 h4 h5 hQ

