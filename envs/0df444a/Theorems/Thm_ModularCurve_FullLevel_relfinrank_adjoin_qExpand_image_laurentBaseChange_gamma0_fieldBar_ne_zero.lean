open ModularCurve ModularCurve.FullLevel CongruenceSubgroup

theorem ModularCurve.FullLevel.relfinrank_adjoin_qExpand_image_laurentBaseChange_gamma0_fieldBar_ne_zero
    (q : ℕ) [Fact q.Prime] (M : ℕ) [NeZero M] (hqM : ¬ q ∣ M) :
    (IntermediateField.adjoin (AlgebraicClosure ℚ)
        (qExpand (AlgebraicClosure ℚ) q ''
          (laurentBaseChange (AlgebraicClosure ℚ) (qExpFunctionFieldC ℚ (Gamma0 (q * M))) :
            Set (LaurentSeries (AlgebraicClosure ℚ))))).relfinrank (fieldBar q M) ≠ 0 := by sorry
