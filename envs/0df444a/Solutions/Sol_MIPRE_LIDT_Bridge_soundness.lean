theorem decP_extendLam (j : Fin m) (v : Fin (j.val + 1) → F) :
    decP (fun k : Fin m => if h : k.val ≤ j.val then enc (v ⟨k.val, Nat.lt_succ_of_le h⟩)
      else zeroCoord (params := lidtParams F m d)) = Sample.extend v := by
