-- source:
--   Philippon 1986, §§2–5; 1987 corrections/addenda. https://numdam.org/articles/10.24033/bsmf.2060/

import Definitions.Def_PhilipponMultiplicity_Geometry

set_option autoImplicit false
open scoped BigOperators Topology
open Filter
noncomputable section

namespace PhilipponMultiplicity

universe u

variable {K : Type u} [NontriviallyNormedField K]

/-- A local analytic group homomorphism, with genuine analytic homogeneous
coordinate lifts of every translate. No injectivity is assumed. -/
structure AnalyticSubgroup (G : EmbeddedGroupProduct K) where
  parameterDimension : ℕ
  parameterDimension_pos : 0 < parameterDimension
  radius : ℝ
  radius_pos : 0 < radius
  domain : Set (Fin parameterDimension → K)
  domain_eq_ball : domain = Metric.ball 0 radius
  domain_open : IsOpen domain
  zero_mem : 0 ∈ domain
  map : domain → G.Point
  map_zero : map ⟨0, zero_mem⟩ = 0
  map_add : ∀ x y : domain, ∀ h : x.val + y.val ∈ domain,
    map ⟨x.val + y.val, h⟩ = map x + map y
  lift : G.Point → (Fin parameterDimension → K) → G.ambient.Variable → K
  lift_analytic : ∀ g v, AnalyticAt K (fun z => lift g z v) 0
  base_series : ∀ v,
    ∃ p : FormalMultilinearSeries K (Fin parameterDimension → K) K,
      HasFPowerSeriesOnBall (fun z => lift 0 z v) p 0 (ENNReal.ofReal radius)
  base_represents : ∀ z : domain, ∀ i : G.FactorIndex,
    ∃ h : (fun j => lift 0 z.val ⟨i, j⟩) ≠ 0,
      Projectivization.mk K (fun j => lift 0 z.val ⟨i, j⟩) h = G.embedding (map z) i
  lift_represents : ∀ g : G.Point,
    ∀ᶠ z in 𝓝 (0 : Fin parameterDimension → K),
      ∃ hz : z ∈ domain, ∀ i : G.FactorIndex,
        ∃ h : (fun j => lift g z ⟨i, j⟩) ≠ 0,
          Projectivization.mk K (fun j => lift g z ⟨i, j⟩) h =
            G.embedding (g + map ⟨z, hz⟩) i

namespace AnalyticSubgroup

variable {G : EmbeddedGroupProduct K}

abbrev ParameterSpace (A : AnalyticSubgroup G) := Fin A.parameterDimension → K

/-- The subgroup generated by the image of the local parametrization. -/
def carrier (A : AnalyticSubgroup G) : Set G.Point :=
  AddSubgroup.closure (Set.range A.map)

def pullback (A : AnalyticSubgroup G) (P : G.CoordinateRing) (g : G.Point)
    (z : A.ParameterSpace) : K :=
  MvPolynomial.eval (A.lift g z) P

/-- Tangent directions mapped into the tangent space of an algebraic set
through zero, expressed by the differentials of its actual defining ideal. -/
def tangentKernel (A : AnalyticSubgroup G) (V : Set G.Point) : Submodule K A.ParameterSpace :=
  ⨅ P : {P : G.CoordinateRing // P ∈ G.vanishingIdeal V},
    LinearMap.ker (fderiv K (A.pullback P.val 0) 0).toLinearMap

def dimension (A : AnalyticSubgroup G) : ℕ :=
  A.parameterDimension - Module.finrank K (A.tangentKernel {0})

end AnalyticSubgroup

def vanishingOrder {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (P : G.CoordinateRing) (g : G.Point) : WithTop ℕ :=
  sInf ((fun n : ℕ => (n : WithTop ℕ)) ''
    {n | iteratedFDeriv K n (A.pullback P g) 0 ≠ 0})

def analyticCodimension {G : EmbeddedGroupProduct K} (A : AnalyticSubgroup G)
    (H : Set G.Point) : ℕ :=
  A.parameterDimension - Module.finrank K (A.tangentKernel H)

end PhilipponMultiplicity


