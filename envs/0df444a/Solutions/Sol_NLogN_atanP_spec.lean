        simp (config := {decide := true}) [g40, g41, g42, g43, g44, gj 45 (by decide) (by decide) (by decide) (by decide) (by decide), hK, atanSum]
      intro j hj
      have : j ≠ 40 ∧ j ≠ 41 ∧ j ≠ 42 ∧ j ≠ 43 ∧ j ≠ 44 ∧ j ≠ 45 := by
