theorem Arr.congr {μ μ' : ℕ → ℤ} {a L : ℕ} {f : ℕ → ℤ} (h : Light.Filter2.Arr μ a L f)
    (he : ∀ i < L, μ' (a + i) = μ (a + i)) : Light.Filter2.Arr μ' a L f := fun i hi => (he i hi).trans (h i hi)

theorem bitB_nonneg (b : Bool) : 0 ≤ Light.Filter2.bitB b := by cases b <;> simp
theorem bitB_le_one (b : Bool) : Light.Filter2.bitB b ≤ 1 := by cases b <;> simp
theorem bitB_eq_zero {b : Bool} : Light.Filter2.bitB b = 0 ↔ b = false := by cases b <;> simp

theorem ellOf_pos (n : ℕ) : 1 ≤ Light.Filter2.ellOf n := by unfold Light.Filter2.ellOf; omega

theorem RR_two_le (n : ℕ) : 2 ≤ Light.Filter2.RR n := by
  unfold Light.Filter2.RR
  calc 2 = 2 ^ 1 := rfl
    _ ≤ 2 ^ Light.Filter2.ellOf n := Nat.pow_le_pow_right (by norm_num) (ellOf_pos n)

theorem dOf_pos (n : ℕ) : 1 ≤ Light.Filter2.dOf n := by
  unfold Light.Filter2.dOf Light.Filter2.bOf
  have h1 := ellOf_pos n
  have h2 : Light.Filter2.ellOf n * (Nat.sqrt (Light.Filter2.ellOf n) + 1) ≥ 1 * 2 :=
    Nat.mul_le_mul h1 (by have := Nat.sqrt_pos.2 h1; omega)
  omega

theorem sOf_pos (n : ℕ) : 1 ≤ Light.Filter2.sOf n := Nat.one_le_two_pow

theorem sOf_le {n : ℕ} (hn : 1 ≤ n) : Light.Filter2.sOf n ≤ n := by
  have hk : 1 ≤ Light.Filter2.kOf n := Nat.size_pos.2 hn
  have he : 336175 * Light.Filter2.kOf n / 10 ^ 7 < Light.Filter2.kOf n := by
    rw [Nat.div_lt_iff_lt_mul (by norm_num)]
    omega
  unfold Light.Filter2.sOf
  calc 2 ^ (336175 * Light.Filter2.kOf n / 10 ^ 7) ≤ 2 ^ (Light.Filter2.kOf n - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
    _ ≤ n := by
      have := Nat.lt_size.1 (show Light.Filter2.kOf n - 1 < Nat.size n from by unfold Light.Filter2.kOf at hk ⊢; omega)
      exact this

theorem mOf_le (n : ℕ) : Light.Filter2.mOf n ≤ n := by
  unfold Light.Filter2.mOf
  have hs := sOf_pos n
  have : (n + Light.Filter2.sOf n - 1) / Light.Filter2.sOf n < n + 1 := by
    rw [Nat.div_lt_iff_lt_mul (by omega)]
    have : n ≤ n * Light.Filter2.sOf n := Nat.le_mul_of_pos_right n hs
    rw [Nat.add_mul, Nat.one_mul]
    omega
  omega

