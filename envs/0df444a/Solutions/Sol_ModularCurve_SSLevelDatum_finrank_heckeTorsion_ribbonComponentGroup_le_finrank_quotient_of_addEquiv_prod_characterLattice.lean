def restrictCL {ι : Type} [Fintype ι] (A : Matrix ι ι ℤ)
    (h : ∀ x : ι → ℤ, x ∈ characterLattice ι → A.mulVec x ∈ characterLattice ι) :
    ↥(characterLattice ι) →ₗ[ℤ] ↥(characterLattice ι) :=
  A.mulVecLin.restrict (fun x hx => h x hx)

def tV (ℓ : Nat.Primes) : ↥(characterLattice V) →ₗ[ℤ] ↥(characterLattice V) := restrictCL (Q.TV ℓ) (Q.degV ℓ)

def tVadj (ℓ : Nat.Primes) : ↥(characterLattice V) →ₗ[ℤ] ↥(characterLattice V) := restrictCL (Q.adjV ℓ) (Q.degAdjV ℓ)

def tE (ℓ : Nat.Primes) : ↥(characterLattice E) →ₗ[ℤ] ↥(characterLattice E) := restrictCL (Q.TE ℓ) (Q.degE ℓ)

def tEadj (ℓ : Nat.Primes) : ↥(characterLattice E) →ₗ[ℤ] ↥(characterLattice E) := restrictCL (Q.adjE ℓ) (Q.degAdjE ℓ)

def tY (ℓ : Nat.Primes) : ↥(ribbonKernel Q.D) →ₗ[ℤ] ↥(ribbonKernel Q.D) :=
  (Q.TE ℓ).mulVecLin.restrict (fun x hx => Q.kerE ℓ x hx)

def tYadj (ℓ : Nat.Primes) : ↥(ribbonKernel Q.D) →ₗ[ℤ] ↥(ribbonKernel Q.D) :=
  (Q.adjE ℓ).mulVecLin.restrict (fun x hx => Q.kerAdjE ℓ x hx)

def compS : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] (↥(characterLattice V) × ↥(characterLattice V)) :=
  LinearMap.prod
    ((Q.tV Q.s).comp (LinearMap.fst ℤ _ _) - LinearMap.snd ℤ _ _)
    (((Q.s : ℕ) : ℤ) • LinearMap.fst ℤ _ _)

def compSadj : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] (↥(characterLattice V) × ↥(characterLattice V)) :=
  LinearMap.prod
    ((Q.tVadj Q.s).comp (LinearMap.fst ℤ _ _) + ((Q.s : ℕ) : ℤ) • LinearMap.snd ℤ _ _)
    (-(LinearMap.fst ℤ _ _))

def tX (ℓ : Nat.Primes) : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] (↥(characterLattice V) × ↥(characterLattice V)) :=
  if ℓ = Q.s then Q.compS else LinearMap.prodMap (Q.tV ℓ) (Q.tV ℓ)

def tXadj (ℓ : Nat.Primes) : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] (↥(characterLattice V) × ↥(characterLattice V)) :=
  if ℓ = Q.s then Q.compSadj else LinearMap.prodMap (Q.tVadj ℓ) (Q.tVadj ℓ)

