section R05Seg2
/-! # Equal-spin D = 5, generic radial data (ATLAS-VI-02/02, part D)

`ESData R B D A H W Φ Ψ`: the radial functions are `C^∞` on an open set of radii `R`, and the
metric functions `B, D, A, H` do not vanish on `R`. No sign or field equation is assumed. The
jet lemmas `d0*`/`d1*` give the genuine first and second derivatives used by the generated
generic modules (`Atlas/EinsteinMaxwell/ES5/Generic/*`). -/

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5

theorem hasDerivAt_of_cd {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) {s : ℝ}
    (hs : s ∈ R) : HasDerivAt f (deriv f s) s :=
  ((h.contDiffAt (hR.mem_nhds hs)).differentiableAt (by simp)).hasDerivAt

theorem cd_deriv {R : Set ℝ} {f : ℝ → ℝ} (hR : IsOpen R) (h : ContDiffOn ℝ ∞ f R) :
    ContDiffOn ℝ ∞ (deriv f) R :=
  h.deriv_of_isOpen hR (by simp)

namespace ESData

variable {R : Set ℝ} {B D A H W Φ Ψ : ℝ → ℝ} {x : Pt 5}

theorem d0B (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt B (deriv B (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cB hx.1

theorem d0D (hE : ESData R B D A H W Φ Ψ) (hx : x ∈ esDomain R) : HasDerivAt D (deriv D (x 1)) (x 1) :=
  hasDerivAt_of_cd hE.isOpen hE.cD hx.1

