    [TopologicalSpace O] [IsTopologicalRing O] [CompactSpace O] [T2Space O]
    [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (n : ℕ)
    (G : Polynomial (IsLocalRing.ResidueField O)) (hG : G.Monic) (hGn : G.natDegree = n) :
    MeasurableSet (TypeDensity.residueCell O n G) ∧ TypeDensity.coefficientMeasure O n (TypeDensity.residueCell O n G) =
      (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ^ n ∧ MeasureTheory.IsProbabilityMeasure
      (TypeDensity.cellMeasure O n (TypeDensity.residueCell O n G)) := by
  obtain ⟨hcyl, hne, -⟩ := TypeDensity.residue_cell_cylinder O n G
  obtain ⟨a, ha⟩ := hne hG hGn
  have hS := hcyl a ha
  have hmeas : MeasurableSet (TypeDensity.residueCell O n G) := by
    have e := TypeDensity.finite_coordinate_borel_cylinders O (IsLocalRing.maximalIdeal O) htop n
    have h2 : @MeasurableSet _ (TypeDensity.adicCylinderSpace (IsLocalRing.maximalIdeal O) (Fin n → O))
        (TypeDensity.residueCell O n G) := by
      apply MeasurableSpace.measurableSet_generateFrom
      refine Or.inr ⟨1, a, ?_⟩
      rw [hS]
      ext b
      simp only [Set.mem_ofPred_eq]
      rw [TypeDensity.finite_coordinate_adic_congruence]
      simp
    rwa [← e] at h2
  have hmass : TypeDensity.coefficientMeasure O n (TypeDensity.residueCell O n G)
      = (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ^ n := by
    rw [hS]
    have := TypeDensity.coefficient_cylinder_mass O htop n 1 a
    simpa using this
  refine ⟨hmeas, hmass, ⟨?_⟩⟩
  have hq : (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞) ≠ 0 := by
    have : 0 < Nat.card (IsLocalRing.ResidueField O) := Nat.card_pos
    exact_mod_cast this.ne'
