open QseriesFormalization QseriesFormalization.PartIV QseriesFormalization.PartIV.Ch19
open PowerSeries
theorem solution (R : Type*) [CommSemiring R] (k r n : ℕ)
    (φ : PowerSeries R) :
    PowerSeries.coeff (R := R) n (section_kr R k r φ) =
      PowerSeries.coeff (R := R) (k * n + r) φ := by
  unfold section_kr
  exact PowerSeries.coeff_mk n _
