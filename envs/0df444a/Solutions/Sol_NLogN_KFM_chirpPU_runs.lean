theorem oprodPU_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
