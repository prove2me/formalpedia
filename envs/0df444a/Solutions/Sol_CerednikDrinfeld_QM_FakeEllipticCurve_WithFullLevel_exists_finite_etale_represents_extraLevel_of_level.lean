theorem finrank_piece_transfer {R' : Type} [CommRing R'] {X' : Scheme.{0}} (p' : X' ⟶ Spec (CommRingCat.of R'))
    (k : X' ⟶ X) (β : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)) (hk : IsPullback k p' p β)
    (W : X.Opens) (hW : IsClosed (W : Set ↥X)) (t : ↥(Spec (CommRingCat.of R'))) :
    ((k ⁻¹ᵁ W).ι ≫ p').finrank t = (W.ι ≫ p).finrank (β t) := by
  haveI := isFinite_piece p W hW
  have sq := (isPullback_morphismRestrict k W).paste_vert hk
  exact Scheme.Hom.finrank_of_isPullback _ _ _ _ sq t

theorem rankLoc_transfer {R' : Type} [CommRing R'] {X' : Scheme.{0}} (p' : X' ⟶ Spec (CommRingCat.of R'))
    [IsFinite p'] [Etale p']
    (k : X' ⟶ X) (β : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)) (hk : IsPullback k p' p β)
    (W : X.Opens) (hW : IsClosed (W : Set ↥X)) (c : ℕ) :
    β.base ⁻¹' rankLoc p W c = rankLoc p' (k ⁻¹ᵁ W) c := by
  ext t
  simp only [rankLoc, Set.mem_preimage, Set.mem_setOf_eq]
  rw [finrank_piece_transfer p p' k β hk W hW t]

