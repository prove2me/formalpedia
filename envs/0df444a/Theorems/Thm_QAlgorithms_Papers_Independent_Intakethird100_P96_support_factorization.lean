-- title:
--   Coefficient supports factor every finite-dimensional subalgebra
-- statement:
--   Let $B_1,B_2$ be finite-dimensional complex C*-algebras and $A\subseteq B_1\otimes B_2$ a star subalgebra, not required to contain the ambient identity. Let $s_i$ be the linear span of all contractions of elements of $A$ by complex-linear functionals on the other factor. Let $S_i$ be the star algebra generated by $s_i$, and interpret each tensor product of subspaces as its canonical embedded image. Then
--
--   $$A\subseteq s_1\otimes s_2\subseteq S_1\otimes S_2\subseteq B_1\otimes B_2.$$
--
--   Thus the coefficient supports and their generated algebras retain every element of the original subalgebra.
-- source:
--   Reversible quantum cellular automata, arXiv:quant-ph/0405174v1, PDF p. 10, §IV.C, (21)–(22): factorization through coefficient supports

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P96

noncomputable section

open scoped TensorProduct Kronecker BigOperators

namespace QAlgorithms.Papers.Independent.Intakethird100.P96

open QAlgorithms.Papers.Independent.Information100.P26 (Mat)

section SupportAlgebras

variable {B1 B2 B3 : Type*} [CStarAlgebra B1] [CStarAlgebra B2] [CStarAlgebra B3]

/-- §IV.C, equations (21)--(22), PDF p.10: coefficient and generated-support factorization. -/
theorem support_factorization
    [FiniteDimensional ℂ B1] [FiniteDimensional ℂ B2]
    (A : NonUnitalStarSubalgebra ℂ (B1 ⊗[ℂ] B2)) :
    A.toSubmodule ≤ tensorSpan (coefficientLeft (A : Set (B1 ⊗[ℂ] B2)))
      (coefficientRight (A : Set (B1 ⊗[ℂ] B2))) ∧
    tensorSpan (coefficientLeft (A : Set (B1 ⊗[ℂ] B2))) (coefficientRight (A : Set (B1 ⊗[ℂ] B2))) ≤
      tensorSpan (supportLeft (A : Set (B1 ⊗[ℂ] B2))).toSubmodule
        (supportRight (A : Set (B1 ⊗[ℂ] B2))).toSubmodule := by sorry

end SupportAlgebras

end QAlgorithms.Papers.Independent.Intakethird100.P96

end
