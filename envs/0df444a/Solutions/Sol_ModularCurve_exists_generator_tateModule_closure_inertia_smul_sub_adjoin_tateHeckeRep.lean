def displacement : AddSubgroup J :=
  AddSubgroup.closure {w : J | ∃ σ ∈ I, ∃ M : ℕ, ∃ x ∈ E M, w = σ • x - x}

def lam : Submodule ℤ_[2] T where
  carrier := {s | ∀ n, (s : ℕ → J) n ∈ displacement I E}
  add_mem' {s t} hs ht n := by
    rw [TateModule.coe_add, Pi.add_apply]; exact add_mem (hs n) (ht n)
  zero_mem' n := by rw [TateModule.coe_zero, Pi.zero_apply]; exact zero_mem _
  smul_mem' a s hs n := by
    rw [TateModule.smul_apply]; exact AddSubgroup.zsmul_mem _ (hs n) _

