section
-- Source module: Solutions.R6ILSwapU
/-!
# Round six, item language: `SwapNeedτ` from fine Lemma 12 (parametric copy of KFW's chain)

`KFW.swIU_spec`, `KFW.swWU_spec`, `KFW.swGU_spec` and `KFW.swapNeed` with the OpenAI Lemma 12
(`KFB.lemma12_fine_canon`, table `KFL.l12prog`, code `KFL.l12C q`, `τS`) replaced by any
`L12Canon tab l12 τ`. The register programs (`toBitsU`, `fromBitsU`, `descP`, `popP`) are the
frozen ones.

**`swapNeedτ_of_l12Canon : L12Canon tab l12 τ → SwapNeedτ tab τ`** (`0 ≤ τ`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFS NLogN.KFL NLogN.KFW AModel AModelL12

section Chain

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

theorem swIUP_spec_sol_aux (hτ : 0 ≤ τ) (h : L12Canon tab l12 τ) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List Sym) (t : IState HS) (xs : List (ZMod 2)) (R : List Item),
      t.G 0 = ints (enc2 xs) ++ R →
      xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      ∀ {L1 L2 L3 L4 : List Item}, t.G sP = .int (vol Pre : ℤ) :: L1 →
      t.G sG = .int (vol G : ℤ) :: L2 → t.G sS = .int (vol Suf : ℤ) :: L3 →
      t.G sU = .int (u : ℤ) :: L4 →
      ∃ c : ℕ, IRuns I tab (swIUP l12) t
        (t.upd 0 (ints (pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
          (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)) ++ R)) c ∧
        (c : ℝ) ≤ K * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ := by
  obtain ⟨K, hK, HK⟩ := h
  obtain ⟨D, hD0, hD⟩ := overhead_le 0 0
  refine ⟨K + 10 ^ 8 * D, by positivity,
    fun u Pre G Suf hu hPre hG hS I t xs R h0 hxs L1 L2 L3 L4 r1 r2 r3 r4 => ?_⟩
  set V := vol (binShape Pre G Suf (2 ^ u)) with hVdef
  have hV1 : 1 ≤ V := le_trans Nat.one_le_two_pow (KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  have hzV := KFE.succ_le_zsz_vol (u := u) Pre G Suf hPre hG hS
  set Bb := zsz (V : ℤ)
  have hP1 := one_le_vol hPre
  have hG1 := one_le_vol hG
  have hS1 := one_le_vol hS
  have hVe : V = vol Pre * (2 ^ u * (vol G * (2 ^ u * vol Suf))) := vol_binShape _ _ _ _
  have hpu : 1 ≤ 2 ^ u := Nat.one_le_two_pow
  have lP : vol Pre ≤ V := by
    rw [hVe]; exact Nat.le_mul_of_pos_right _ (by positivity)
  have lG : vol G ≤ V := by
    rw [hVe]
    calc vol G ≤ 2 ^ u * (vol G * (2 ^ u * vol Suf)) := by
          have : vol G ≤ vol G * (2 ^ u * vol Suf) := Nat.le_mul_of_pos_right _ (by positivity)
          exact le_trans this (Nat.le_mul_of_pos_left _ (by positivity))
      _ ≤ _ := Nat.le_mul_of_pos_left _ (by omega)
  have lS : vol Suf ≤ V := by
    rw [hVe]
    calc vol Suf ≤ 2 ^ u * (vol G * (2 ^ u * vol Suf)) := by
          have : vol Suf ≤ 2 ^ u * vol Suf := Nat.le_mul_of_pos_left _ (by positivity)
          have : 2 ^ u * vol Suf ≤ vol G * (2 ^ u * vol Suf) := Nat.le_mul_of_pos_left _ (by omega)
          exact le_trans ‹vol Suf ≤ _› (le_trans this (Nat.le_mul_of_pos_left _ (by positivity)))
      _ ≤ _ := Nat.le_mul_of_pos_left _ (by omega)
  have lu : u ≤ V := le_trans (le_of_lt Nat.lt_two_pow_self)
    (KFE.two_pow_le_vol Pre G Suf hPre hG hS)
  set s := t.upd 0 R
  set F := Fsw (enc2 xs) (vol Pre) (vol G) (vol Suf) u
  obtain ⟨c, Hc, hc⟩ := HK u Pre G Suf hu hPre hG hS I s F xs [] [] [] []
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw])
    (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) (by simp +decide [F, Fsw]) hxs
  set ys := pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
    (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)
  rw [update_Fsw, enc2_pull] at Hc
  have ev : evalP t swLU =
      [(KIL.kP, ((vol Pre : ℕ) : ℤ)), (KIL.kG, ((vol G : ℕ) : ℤ)), (KIL.kS, ((vol Suf : ℕ) : ℤ)),
        (aU, (u : ℤ))] := by
    simp only [evalP, swLU, List.map_cons, List.map_nil, Ex.eval, IState.top_eq r1,
      IState.top_eq r2, IState.top_eq r3, IState.top_eq r4]
  have eIn : encK s F = pushSt t (evalP t swLU) := by
    rw [ev, encK_Fsw]
    conv_rhs => rw [← upd_self (pushSt _ _) 0]
    congr 1
    rw [pushSt_G_of_not_mem _ _ _ (by simp +decide), h0]
  have eOut : encK s (Fsw ys (vol Pre) (vol G) (vol Suf) u) =
      (pushSt t (evalP t swLU)).upd 0 (ints ys ++ R) := by
    rw [ev, encK_Fsw]
  rw [eIn, eOut] at Hc
  have hz : ∀ x : ℕ, x ≤ V → zsz (x : ℤ) ≤ Bb := fun x hx => zsz_nat_le hx
  have hl : PushOK t Bb swLU := by
    intro p hp
    simp only [swLU, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact ⟨by decide, clean_reg (by decide), by simp +decide [Ex.regs, swLU],
        IState.isInt_of r1, by simp only [Ex.Bnd, IState.top_eq r1]; exact hz _ lP⟩
    · exact ⟨by decide, clean_reg (by decide), by simp +decide [Ex.regs, swLU],
        IState.isInt_of r2, by simp only [Ex.Bnd, IState.top_eq r2]; exact hz _ lG⟩
    · exact ⟨by decide, clean_reg (by decide), by simp +decide [Ex.regs, swLU],
        IState.isInt_of r3, by simp only [Ex.Bnd, IState.top_eq r3]; exact hz _ lS⟩
    · exact ⟨by decide, clean_reg (by decide), by simp +decide [Ex.regs, swLU],
        IState.isInt_of r4, by simp only [Ex.Bnd, IState.top_eq r4]; exact hz _ lu⟩
  have hv : ∀ p ∈ swLU, zsz (p.2.eval t) ≤ Bb := by
    intro p hp
    simp only [swLU, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> simp only [Ex.eval, IState.top_eq r1,
      IState.top_eq r2, IState.top_eq r3, IState.top_eq r4] <;> apply hz <;> assumption
  have W := IRuns.withPushI (I := I) (iprog := tab) _ l12 t Bb hl hv (by simp +decide [swLU])
    ys R c Hc
  refine ⟨_, W, ?_⟩
  have hpc : pushCost Bb swLU = 8 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 := by
    rw [pushCost]; simp only [swLU, List.map_cons, List.map_nil, Ex.size]
    rw [List.sum_cons, List.sum_cons, List.sum_cons, List.sum_cons, List.sum_nil]; ring
  have hl4 : swLU.length = 4 := rfl
  rw [hpc, hl4]
  have hov := hD 0 V Bb hV1 (by omega) (by omega)
  rw [← hVdef] at hc
  clear_value Bb V
  exact cost_absorbτ hτ hu hK hD0 (by simpa using hov) hc
where
  cost_absorbτ {u c Bb V : ℕ} {K D : ℝ} (hτ : 0 ≤ τ) (hu : 1 ≤ u) (hK : 0 ≤ K) (hD0 : 0 ≤ D)
      (hov : ((Bb : ℝ) + 2) ^ 2 ≤ D * V)
      (hc : (c : ℝ) ≤ K * ((V : ℝ) + 1) * (u : ℝ) ^ τ) :
      (((8 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 + c + (4 * (2 * Bb + 2) + 1) : ℕ)) : ℝ)
        ≤ (K + 10 ^ 8 * D) * ((V : ℝ) + 1) * (u : ℝ) ^ τ := by
    set x := (u : ℝ) ^ τ
    have hx : (1 : ℝ) ≤ x := Real.one_le_rpow (by exact_mod_cast hu) hτ
    have hB : (0 : ℝ) ≤ Bb := Nat.cast_nonneg _
    have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg _
    have h1 : D * V ≤ D * (((V : ℝ) + 1) * x) := by
      apply mul_le_mul_of_nonneg_left _ hD0; nlinarith
    push_cast
    have e : (K + 10 ^ 8 * D) * ((V : ℝ) + 1) * x =
        K * ((V : ℝ) + 1) * x + 10 ^ 8 * (D * (((V : ℝ) + 1) * x)) := by ring
    rw [e]
    have hBB : 8 * 10 ^ 7 * ((Bb : ℝ) + 2) ^ 2 + 4 * (2 * (Bb : ℝ) + 2) + 2 ≤
        10 ^ 8 * ((Bb : ℝ) + 2) ^ 2 := by
      have : 4 * (2 * (Bb : ℝ) + 2) + 2 ≤ 10 * ((Bb : ℝ) + 2) ^ 2 := by nlinarith
      linarith
    have h2 : 10 ^ 8 * ((Bb : ℝ) + 2) ^ 2 ≤ 10 ^ 8 * (D * (((V : ℝ) + 1) * x)) := by
      have := le_trans hov h1
      linarith
    linarith

end Chain

end IntMul.Kappa.R6.IL

