theorem NetComplex.complex_exchange_net {M : Type*} [AddGroup M] (hcard : ∀ t, #(ind t) = 3)
    (hinj : Function.Injective ind) (lab : GName T → M) :
    (∀ g ∈ cxGatesL R ind lab, g.OK) ∧
      ∀ (v : Wr ind → R) w, scalarRun (cxGatesL R ind lab) v (NetComplex.ρ ind w) = NetComplex.ε R ind w * v w := by sorry
