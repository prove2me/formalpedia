-- title:
--   §2.1, pp. 5–6 — nearly unstable Hawkes setting; §2.3, p. 7 — resolvent
-- statement:
--   Let $N^T$ be a simple counting process with baseline intensity $\mu>0$ and excitation kernel $\phi^T=a_T\phi$. The **Hawkes intensity** is
--
--   $$\lambda_t^T=\mu+\int_0^t\phi^T(t-s)\,dN_s^T.$$
--
--   Its intensity property is the paper's conditional first-moment identity relative to the natural filtration generated by $N^T$. The **compensated process** is $M_t^T=N_t^T-\int_0^t\lambda_s^T\,ds$. The **resolvent** is $\psi^T=\sum_{k\ge1}(\phi^T)^{*k}$, where convolution integrates over nonnegative time.
--
--   Assumption 1 says that $\phi$ is nonnegative and measurable, has integral one and finite first moment $m=\int_0^\infty s\phi(s)\,ds$, and has a bounded, integrable derivative. These definitions also name the pathwise suprema in the $L^2$ limit.
--
--   **Formalization Note** Stieltjes integrals against $N^T$ are finite sums over jumps in $(0,t]$. The value at a jump gives the cadlag intensity; it agrees almost everywhere in time with the predictable left-limit version. The intensity identity uses lower Lebesgue integrals in $\mathbb R_{\ge0}\cup\{\infty\}$. `convPow f k` denotes the $(k+1)$-fold power, so the resolvent begins with $f$. The kernel derivative at zero is one-sided.
-- source:
--   Jaisson and Rosenbaum, Limit theorems for nearly unstable Hawkes processes, arXiv:1310.2033v2, p. 5, §2.1, Assumption 1; p. 7, §2.3

import Mathlib
import Definitions.Def_NearlyUnstableHawkes_Deterministic_CountingProcess

noncomputable section

namespace NearlyUnstableHawkes.Deterministic

open MeasureTheory Filter Topology
open scoped ENNReal

/-- The nonnegative-time convolution used in the paper. -/
def conv (f g : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..t, f (t - s) * g s

/-- `convPow f k` is the `(k+1)`-fold convolution power of `f`. -/
def convPow (f : ℝ → ℝ) : ℕ → ℝ → ℝ
  | 0 => f
  | k + 1 => conv (convPow f k) f

/-- The resolvent `ψ = ∑_{k≥1} f^{∗k}`. -/
def psi (f : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∑' k : ℕ, convPow f k t

/-- The `L¹` mass of the resolvent on positive time. -/
def psiNorm (f : ℝ → ℝ) : ℝ :=
  ∫ s in Set.Ioi (0 : ℝ), psi f s

/-- The natural filtration generated by counts through time `t`. -/
def natFiltration {Ω : Type*} [MeasurableSpace Ω]
    (N : ℝ → Ω → ℕ) (t : ℝ) : MeasurableSpace Ω :=
  ⨆ s ∈ Set.Icc (0 : ℝ) t, MeasurableSpace.comap (N s) inferInstance

/-- The jump in the count at time `s`. -/
def jump {Ω : Type*} (N : ℝ → Ω → ℕ) (s : ℝ) (ω : Ω) : ℝ :=
  (N s ω : ℝ) - Function.leftLim (fun u => (N u ω : ℝ)) s

/-- The Stieltjes sum `∫₀ᵗ f(s) dN_s`, with jumps in `(0,t]`. -/
def stieltjesN {Ω : Type*} (f : ℝ → ℝ) (N : ℝ → Ω → ℕ)
    (t : ℝ) (ω : Ω) : ℝ :=
  ∑ᶠ s ∈ {s : ℝ | 0 < s ∧ s ≤ t ∧ jump N s ω ≠ 0}, jump N s ω * f s

/-- The cadlag intensity, including the excitation from a jump at `t`. -/
def intensity {Ω : Type*} (μ : ℝ) (φT : ℝ → ℝ)
    (N : ℝ → Ω → ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  μ + stieltjesN (fun s => φT (t - s)) N t ω

/-- The natural-filtration Hawkes condition from §2.1, p. 5. -/
structure IsHawkes {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (μ : ℝ) (φT : ℝ → ℝ)
    (Tend : ℝ) (N : ℝ → Ω → ℕ) : Prop where
  baseline_pos : 0 < μ
  kernel_nonnegative : ∀ s, 0 ≤ s → 0 ≤ φT s
  kernel_measurable : Measurable (fun s : Set.Ici (0 : ℝ) => φT s)
  kernel_integrable : IntegrableOn φT (Set.Ici (0 : ℝ))
  counting : IsCountingProcess Tend N
  intensity_id : ∀ a b : ℝ, 0 ≤ a → a < b → b ≤ Tend →
    ∀ A : Set Ω, MeasurableSet[natFiltration N a] A →
      (∫⁻ ω in A, ((N b ω - N a ω : ℕ) : ℝ≥0∞) ∂P) =
      (∫⁻ ω in A, ∫⁻ s in Set.Ioc a b,
        ENNReal.ofReal (intensity μ φT N s ω) ∂(volume : Measure ℝ) ∂P)

/-- The compensated counting process `Mᵀ = Nᵀ - ∫ λᵀ`. -/
def compensated {Ω : Type*} (μ : ℝ) (φT : ℝ → ℝ)
    (N : ℝ → Ω → ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  (N t ω : ℝ) - ∫ s in (0 : ℝ)..t, intensity μ φT N s ω

/-- `∫₀ᵗ f(s) dM_s`, a jump sum minus its compensator. -/
def stieltjesM {Ω : Type*} (f : ℝ → ℝ) (μ : ℝ) (φT : ℝ → ℝ)
    (N : ℝ → Ω → ℕ) (t : ℝ) (ω : Ω) : ℝ :=
  stieltjesN f N t ω - ∫ s in (0 : ℝ)..t, f s * intensity μ φT N s ω

/-- The normalized kernel `φᵀ = a_T φ`. -/
def scaledKernel (a : ℝ) (φ : ℝ → ℝ) (s : ℝ) : ℝ := a * φ s

/-- Assumption 1's hypotheses on the common kernel. -/
structure KernelAssumption (φ φ' : ℝ → ℝ) (m : ℝ) : Prop where
  nonnegative : ∀ s, 0 ≤ s → 0 ≤ φ s
  measurable : Measurable (fun s : Set.Ici (0 : ℝ) => φ s)
  integrable : IntegrableOn φ (Set.Ici (0 : ℝ))
  mass : (∫ s in Set.Ici (0 : ℝ), φ s) = 1
  moment_integrable : IntegrableOn (fun s => s * φ s) (Set.Ici (0 : ℝ))
  moment : (∫ s in Set.Ici (0 : ℝ), s * φ s) = m
  derivative : ∀ s, 0 ≤ s → HasDerivWithinAt φ (φ' s) (Set.Ici (0 : ℝ)) s
  derivative_bounded : ∃ C : ℝ, ∀ s, 0 ≤ s → |φ' s| ≤ C
  derivative_integrable : IntegrableOn φ' (Set.Ici (0 : ℝ))

/-- The absolute pathwise maximum of the compensated process on `[0,T]`. -/
def martingaleMax {Ω : Type*} (μ : ℝ) (φT : ℝ → ℝ)
    (N : ℝ → Ω → ℕ) (Tend : ℝ) (ω : Ω) : ℝ≥0∞ :=
  ⨆ t ∈ Set.Icc (0 : ℝ) Tend,
    ENNReal.ofReal |compensated μ φT N t ω|

/-- The pathwise supremum in Theorem 2.1, before squaring and averaging. -/
def scaledDeviation {Ω : Type*} [MeasurableSpace Ω] (a T : ℝ)
    (N : ℝ → Ω → ℕ) (P : Measure Ω) (ω : Ω) : ℝ≥0∞ :=
  ⨆ v ∈ Set.Icc (0 : ℝ) 1,
    ENNReal.ofReal ((1 - a) / T *
      |(N (T * v) ω : ℝ) - ∫ ω', (N (T * v) ω' : ℝ) ∂P|)

end NearlyUnstableHawkes.Deterministic


