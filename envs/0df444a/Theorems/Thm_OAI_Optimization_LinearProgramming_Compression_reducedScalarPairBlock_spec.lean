theorem reducedScalarPairBlock_spec (m : Memory ℚ) (p : ℤ) (q k : ℕ) {P : ℚ → Prop}
    (hm : m.AllData P) (hp : m.data 0 = (p : ℚ)) (hqv : m.data 1 = (q : ℚ))
