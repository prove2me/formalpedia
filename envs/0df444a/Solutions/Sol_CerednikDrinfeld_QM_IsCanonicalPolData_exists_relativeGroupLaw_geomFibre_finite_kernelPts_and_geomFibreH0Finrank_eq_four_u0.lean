theorem solution
    {S : Type} [CommRing S] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of S)) (L : RelativeGroupLaw S f)
    (hA : AbelianSchemePropertyBundle S f)
    (hdim : ∀ s : ↥(Spec (CommRingCat.of S)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = 2)
    {I : Type} (act : I → (A ⟶ A)) (act_over : ∀ x : I, act x ≫ f = f) (star : I → I)
    (𝓛 : A.Modules) (h𝓛 : IsCanonicalPolData f L act act_over star 𝓛)
    (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k) :
    ∃ Lk : RelativeGroupLaw k (pullback.snd f (Spec.map (CommRingCat.ofHom sk))),
      Lk.IsCommutative ∧
      AbelianSchemePropertyBundle k (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) ∧
      SmoothOfRelativeDimension 2 (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) ∧
      Scheme.Modules.IsInvertible
        ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛) ∧
      (kernelPts (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) Lk
        ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛)).Finite ∧
      Scheme.Modules.geomFibreH0Finrank f 𝓛 k sk = 4 := by
  have hdat := h𝓛
  obtain ⟨hinv, hsymm, hK2, -, hpos, -⟩ := h𝓛

  haveI : Smooth f := hA.smooth
  have hAk : AbelianSchemePropertyBundle k (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) :=
    hA.of_isPullback (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom sk)))
  have hck : (L.baseChange (Spec.map (CommRingCat.ofHom sk))).IsCommutative :=
    hAk.isCommutative (L.baseChange (Spec.map (CommRingCat.ofHom sk)))
  haveI : Smooth (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) := hAk.smooth
  have hdimk : ∀ s' : ↥(Spec (CommRingCat.of k)),
      topologicalKrullDim ↥((pullback.snd f (Spec.map (CommRingCat.ofHom sk))).base ⁻¹' {s'}) = 2 :=
    AlgebraicGeometry.topologicalKrullDim_preimage_pullback_snd_eq_of_smooth_of_isConnected sk f hA.connectedFibres 2 hdim
  haveI hsm : SmoothOfRelativeDimension 2 (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) :=
    (L.baseChange (Spec.map (CommRingCat.ofHom sk))).smoothOfRelativeDimension_of_forall_topologicalKrullDim_eq 2 hdimk
  have hinvk : Scheme.Modules.IsInvertible
      ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛) :=
    hinv.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))

  have hsymk : IsSymmetric (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) (L.baseChange (Spec.map (CommRingCat.ofHom sk)))
      ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛) := by
    refine AlgebraicGeometry.Polarisation.IsSymmetric.pullback_of_isPullback sk
      (IsPullback.of_hasPullback f (Spec.map (CommRingCat.ofHom sk))) L (L.baseChange (Spec.map (CommRingCat.ofHom sk))) ?_ 𝓛 hsymm
    intro T t' P Q
    rw [RelativeGroupLaw.baseChange_mul, RelativeGroupLaw.baseChangePointOfBase_coe, pullback.lift_fst]
    rfl

  have hK2k : KernelIsTwoTorsion (pullback.snd f (Spec.map (CommRingCat.ofHom sk)))
      (L.baseChange (Spec.map (CommRingCat.ofHom sk)))
      ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛) :=
    AlgebraicGeometry.Polarisation.kernelIsTwoTorsion_baseChange_of_isInvertible
      (Spec.map (CommRingCat.ofHom sk)) f L 𝓛 hinv hK2

  obtain ⟨hκci, hκfin, hκpts⟩ :=
    AlgebraicGeometry.Polarisation.isClosedImmersion_and_isFinite_and_forall_exists_comp_eq_iff_isInStabilizer_of_kernelIsTwoTorsion
      k (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) (L.baseChange (Spec.map (CommRingCat.ofHom sk))) hck hAk 2
      ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛) hinvk hK2k

  have hKfin : (kernelPts (pullback.snd f (Spec.map (CommRingCat.ofHom sk))) (L.baseChange (Spec.map (CommRingCat.ofHom sk)))
      ((Scheme.Modules.pullback (pullback.fst f (Spec.map (CommRingCat.ofHom sk)))).obj 𝓛)).Finite := by
    haveI := hκfin
    haveI hF := AlgebraicGeometry.finite_schemeHomOver_of_isFinite
      (pullback.fst ((L.baseChange (Spec.map (CommRingCat.ofHom sk))).schemeNsmul 2)
          ((L.baseChange (Spec.map (CommRingCat.ofHom sk))).one (𝟙 (Spec (CommRingCat.of k)))).1 ≫
        pullback.snd f (Spec.map (CommRingCat.ofHom sk))) k (𝟙 (Spec (CommRingCat.of k)))
    refine (Set.finite_range (fun x₀ : SchemeHomOver (𝟙 (Spec (CommRingCat.of k)))
        (pullback.fst ((L.baseChange (Spec.map (CommRingCat.ofHom sk))).schemeNsmul 2)
