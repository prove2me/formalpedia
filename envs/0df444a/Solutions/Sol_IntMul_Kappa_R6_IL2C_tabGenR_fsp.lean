theorem tabGenR_fsp_sol_aux {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ} (hT : SegTR T tf Bb Tm Rv)
    (sgn : ℤ) (hs : sgn = 1 ∨ sgn = -1) {Q d1 d2 n : ℕ} {ru rv rw w0 : ℤ}
    (hv : TVal Q d1 d2 ru rv rw w0 Tm n Bb)
    (s : IState HS) (F : Fin HS → List ℤ) (hp : TPar (encK s F) Q d1 d2 ru rv rw w0 Rv n)
    (P : ℕ) {L1 : List Item} (hP1 : (encK s F).G 1 = .int (P : ℤ) :: L1) (zP : zsz (P : ℤ) ≤ Bb)
    (hq : F rq = []) (hc : F rC = []) :
    FSp (tabGenR sgn T) (encK s F)
      (encK s (Function.update F 14
        ((List.range P).map (fun p => (tabE sgn tf ru rv rw w0 d1 d2 Q n p : ℤ)) ++ F 14)))
      (cTabGenR T Bb n P) := by
  have hB2 := hv.hB2
  set as := tabE sgn tf ru rv rw w0 d1 d2 Q n
  have nq : KFL.rP ≠ rq := by decide
  have n14 : (14 : Fin HS) ≠ rq := by decide
  have n14P : (14 : Fin HS) ≠ KFL.rP := by decide
  have E0 : ESp (.reg 1) (encK s F) Bb (P : ℤ) := ESp.ofG' hP1 (by decide) zP
  have S0 := Sp.pushQ s F (i := KFL.rP) (by decide) E0.clean E0.ok E0.bnd
  rw [E0.ev] at S0
  set F0 := Function.update F KFL.rP ((P : ℤ) :: F KFL.rP)
  set Fk : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update F0 14 (tabL as P k ++ F 14)) KFL.rP
      (((P - k : ℕ) : ℤ) :: F KFL.rP)
  have lk : ∀ k, LowEq (Fk k) F := fun k =>
    (((LowEq.refl F).upd (by decide) _).upd (by decide) _).upd (by decide) _
  have H := FSp.repReg (C := rq) (r := 1) (b := tabBodyR sgn T) (s := s)
    (F := Fk) (N := P) (c := cTabR T Bb n) (Bb := Bb) (by decide) (by decide)
    (fun k => by simp only [Fk, F0]; rw [upd_ne nq.symm, upd_ne n14.symm, upd_ne nq.symm]; exact hq)
    (by simp +decide [tabBodyR, segLoopR, segBodyR, RS.writes]) (L := L1)
    (by rw [encK_G_eq (lk 0 1 (by decide))]; exact hP1) zP (fun k hk => ?_)
  · have e0 : Fk 0 = F0 := by
      funext j
      simp only [Fk, F0, tabL, List.range_zero, List.map_nil, List.nil_append, Nat.sub_zero]
      by_cases h : j = KFL.rP
      · subst h; rw [Function.update_self, Function.update_self]
      rw [upd_ne h, upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self]
      rw [upd_ne h', upd_ne h]
    rw [e0] at H
    have fP : Fk P KFL.rP = 0 :: F KFL.rP := by simp only [Fk]; rw [Function.update_self]; simp
    have S2 := Sp.pop s (Fk P) (B := Bb) (by decide) fP (by rw [zsz_zero]; omega)
    have T' := (FSp.of_norep rfl S0).seq (H.seq (FSp.of_norep rfl S2))
    refine (T'.congr ?_).mono ?_
    · congr 1
      funext j
      simp only [Fk, F0]
      by_cases h : j = KFL.rP
      · subst h; rw [Function.update_self, upd_ne n14P.symm]
      rw [upd_ne h, upd_ne h]
      by_cases h' : j = 14
      · subst h'; rw [Function.update_self, Function.update_self, tabL_full]
      rw [upd_ne h', upd_ne h', upd_ne h]
    · simp only [cTabGenR, Ex.size]
      have : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
      omega
  · have hN : ((P : ℤ) - k) = ((P - k : ℕ) : ℤ) := by omega
    rw [hN]
    have T' := tabBodyR_fsp hT sgn hs hv s (Function.update (Fk k) rq [((P - k : ℕ) : ℤ)])
      (hp.of (((lk k).upd (by decide) _))) (P - k) (by omega)
      (le_trans (KIL.zsz_nat_le (Nat.sub_le _ _)) zP)
      (LP := F KFL.rP) (by rw [upd_ne nq]; simp only [Fk]; rw [Function.update_self])
      (by rw [upd_ne (by decide)]; simp only [Fk, F0]
          rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact hc)
    refine T'.congr ?_
    congr 1
    funext j
    simp only [Fk]
    by_cases hr : j = rq
    · subst hr; simp +decide [Function.update_apply]
    by_cases h : j = KFL.rP
    · subst h
      simp +decide only [Function.update_apply, if_true]
      congr 1; push_cast [Nat.cast_sub hk.le, Nat.cast_sub (Nat.succ_le_of_lt hk)]; ring
    by_cases h' : j = 14
    · subst h'
      simp +decide only [Function.update_apply, if_true, if_false]
      rw [tabL_succ as P k hk]
      have e : P - k - 1 = P - (k + 1) + 0 := by omega
      simp only [as, List.cons_append]
    simp only [Function.update_apply, hr, h, h', if_false]

/-! ## The rotation -/

end IntMul.Kappa.R6.IL2C

