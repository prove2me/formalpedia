variable {R : Type*} [Field R]

/-- Ramanujan's third-order mock theta `f(q) := ∑_{n=0}^N q^{n²} / (-q;q)_n²`,
finite truncation. -/
noncomputable def ramanujanMockF_trunc (q : R) (N : Nat) : R :=
  natSum (fun n => q ^ (n * n) / (qPoch (-q) q n) ^ 2) N

