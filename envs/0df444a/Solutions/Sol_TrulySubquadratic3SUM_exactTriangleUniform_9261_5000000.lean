/-- **The time of allInstancesP in the regime.** -/
theorem allInstancesTimeP_le (c : ℕ) : ∃ C : ℝ, ∀ N D₀ w U : ℕ, 1 ≤ D₀ → D₀ ^ 91 ≤ N ^ 5 →
    (allInstancesTimeP c [N, D₀, w, U] : ℝ)
      ≤ C * ((w : ℝ) * queryBoundP D₀ + preBoundP N D₀) := by
  obtain ⟨C, hC, hreg⟩ := regimeP
  obtain ⟨A, hA⟩ := exists_tOffline32_le_p ratParamsP hC c 2000
  refine ⟨A, fun N D₀ w U hD hN => ?_⟩
  have htime : (allInstancesTimeP c [N, D₀, w, U] : ℝ)
      = (tOffline32P c ratParamsP N D₀ w : ℝ) + (2000 : ℕ) := by
    simp only [allInstancesTimeP, if_pos hN]
    push_cast
    ring
  rw [htime]
  refine (hA w (hreg N D₀ hD hN)).trans (le_of_eq ?_)
  ring

private theorem allInstancesTimeP_mono (c N D₀ : ℕ) {w w' : ℕ} (U U' : ℕ) (hw : w ≤ w') :
    allInstancesTimeP c [N, D₀, w, U] ≤ allInstancesTimeP c [N, D₀, w', U'] := by
  change 2000 + (if D₀ ^ 91 ≤ N ^ 5 then tOffline32P c ratParamsP N D₀ w
      else 40 * ((w + 1) * (D₀ + 1)))
    ≤ 2000 + (if D₀ ^ 91 ≤ N ^ 5 then tOffline32P c ratParamsP N D₀ w'
      else 40 * ((w' + 1) * (D₀ + 1)))
