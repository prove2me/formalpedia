      let y:=worldOf x.k H x.dist t;Ready y t ∧ y.mem 1=x.mem 1 ∧ denotes y g roots := by
  let H (x : World):=2+5*(1+3*x.rows*x.n*x.n)
  have fm : NF (fun x _=>H x):=plus (.const 2) (mulC 5 (plus (.const 1) (timesAxis .points (timesAxis .points (mulC 3 (.size .rows))))))
  obtain ⟨A,engine⟩:=bounded_oracle_expression_compiler _ fm
  obtain ⟨make,alloc⟩:=engine 3 (fun _=>0) (by decide) (fun _=>by decide)
  obtain ⟨P,pack,exec⟩:=native_circuit_record_emitter
  refine ⟨A+1+P.comp limitP,make.seq ((Cmd.atom (.pointerCopy 2 3)).seq pack),?_⟩
  intro x s g roots hk hn lo ready input
  obtain ⟨s',l,ea,keep,res,timeA⟩:=alloc x s (fun _=>x.n) ready (fun _=>ready.1 .points)
  let y:World:={x with rows:=H x};let a:=(Op.pointerCopy 2 3).eval x.dist s'
  have p0 : s'.ptrs 0=(x.n:ℤ):=(keep.1 0 (by decide)).1.trans (ready.1 .points)
  have p1 : s'.ptrs 1=(x.k:ℤ):=(keep.1 1 (by decide)).1.trans (ready.1 .blocks)
  have p3 : s'.ptrs 3=(H x:ℤ):=congrArg Prod.fst res
  have ar : Ready y a:=by
    refine ⟨?_,fun i=>(congrFun keep.2 _).trans (ready.2 i)⟩
    intro ax;cases ax <;> simp [a,Op.eval,World.size,Axis.reg,Function.update,p0,p1,p3,y]
  have m:=Nat.mul_le_mul_right x.n (Nat.mul_le_mul_right x.n (Nat.mul_le_mul_left 3 lo))
  have room : 1+5*(1+3*g.size*y.n*y.n)< y.rows:=by change 1+5*(1+3*g.size*x.n*x.n)<2+5*(1+3*x.rows*x.n*x.n);omega
  obtain ⟨t,j,ep,timeP,rd,header,done⟩:=exec y a g roots hk hn room ar input
  refine ⟨t,_,.seq ea (.seq (.atom _ _) ep),?_,rd,header,done⟩
  have nc : x.n≤ x.cap:=by unfold World.cap;omega
  have rc : x.rows≤ x.cap:=by unfold World.cap;omega
  have orig : x.n+x.k+1≤ x.cap:=by unfold World.cap;omega
  have prod:=Nat.mul_le_mul (Nat.mul_le_mul rc nc) nc
  have ht : H x=7+15*(x.rows*x.n*x.n):=by dsimp [H];ring
  have up : y.cap≤ limitP.eval x.cap:=by
    simp only [limitP,eval_pow,eval_mul,eval_add,eval_C,eval_X]
    rw [show x.cap^3=x.cap*x.cap*x.cap by ring]
    change x.n+x.k+H x+1≤_;rw [ht];omega
  have major:=(monoP P up)
  simp only [eval_add,eval_one,eval_comp];omega
