variable {S : Set ℕ} {a b c : ℕ} {u v : Word Bool}
namespace BalanceSpecification.GapRead
theorem _root_.solution (a n : ℕ) :
    GapRead S (a + n) (List.replicate n false) a := by
  induction n with
  | zero => simpa only [Nat.add_zero, List.replicate_zero] using GapRead.nil a
  | succ n ih =>
    simpa only [Nat.add_assoc, List.replicate_succ] using GapRead.zero ih
end BalanceSpecification.GapRead
