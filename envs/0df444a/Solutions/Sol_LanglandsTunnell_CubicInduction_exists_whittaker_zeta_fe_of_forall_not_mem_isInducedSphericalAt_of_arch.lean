private theorem unitsAt_eq_finiteUnitsComponent (v : HeightOneSpectrum (𝓞 ℚ)) (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) :
    unitsAt v a = finiteUnitsComponent (𝓞 ℚ) ℚ v a :=
  Units.ext (by rw [unitsAt_val, val_finiteUnitsComponent])

private theorem unitsAtInfinity_eq_archPart (a : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : unitsAtInfinity a = archPart a :=
  rfl

private theorem finPlace_eq_localIdele (v : HeightOneSpectrum (𝓞 ℚ)) : finPlace v = localIdele v :=
  rfl

private theorem apply_finPlace
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (u : (v.adicCompletion ℚ)ˣ) :
    χ (finPlace v u) = TateGlobal.localChar χ v u := by
  rw [finPlace_eq_localIdele, localChar_eq]

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))

private theorem unitsAt_embHom_of_mem (t : TorusProduct T) (v : T) : unitsAt v (embHom T t) = t.1 v := by
  rw [unitsAt_eq_finiteUnitsComponent, finiteUnitsComponent_embHom_of_mem]

private theorem unitsAt_embHom_of_not_mem (t : TorusProduct T) {w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ∉ T) :
    unitsAt w (embHom T t) = 1 := by
  rw [unitsAt_eq_finiteUnitsComponent, finiteUnitsComponent_embHom_of_not_mem T t hw]

private theorem unitsAtInfinity_embHom (t : TorusProduct T) : unitsAtInfinity (embHom T t) = t.2 := by
  rw [unitsAtInfinity_eq_archPart, archPart_embHom]

end
