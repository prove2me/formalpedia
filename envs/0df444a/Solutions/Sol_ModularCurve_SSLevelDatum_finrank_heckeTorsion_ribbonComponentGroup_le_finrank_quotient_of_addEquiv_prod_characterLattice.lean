theorem asEnd_commute {M : Type} [AddCommGroup M] (f g : M →+ M) (h : ∀ x, f (g x) = g (f x)) :
    Commute (asEnd f) (asEnd g) :=
  LinearMap.ext fun x => h x

theorem tE_comm (ℓ ℓ' : Nat.Primes) (x : ↥(characterLattice E)) : Q.tE ℓ (Q.tE ℓ' x) = Q.tE ℓ' (Q.tE ℓ x) := by
  apply Subtype.ext
  show (Q.TE ℓ).mulVec ((Q.TE ℓ').mulVec x.1) = (Q.TE ℓ').mulVec ((Q.TE ℓ).mulVec x.1)
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (Q.commE ℓ ℓ').eq]
theorem tEadj_comm (ℓ ℓ' : Nat.Primes) (x : ↥(characterLattice E)) : Q.tEadj ℓ (Q.tEadj ℓ' x) = Q.tEadj ℓ' (Q.tEadj ℓ x) := by
  apply Subtype.ext
  show (Q.adjE ℓ).mulVec ((Q.adjE ℓ').mulVec x.1) = (Q.adjE ℓ').mulVec ((Q.adjE ℓ).mulVec x.1)
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (Q.commAdjE ℓ ℓ').eq]
theorem tY_comm (ℓ ℓ' : Nat.Primes) (x : ↥(ribbonKernel Q.D)) : Q.tY ℓ (Q.tY ℓ' x) = Q.tY ℓ' (Q.tY ℓ x) := by
