theorem shalom_normalized_restriction_variation_bound
    {ε : ℝ} (hε : 0 ≤ ε) (hsmall : ε ≤ (1 / 10 : ℝ)) :
    (2 * ε + ε ^ 2) / (1 - ε ^ 2) ≤ (7 / 33 : ℝ) := by
  have hden : 0 < 1 - ε ^ 2 := by nlinarith
  apply (div_le_iff₀ hden).2
  nlinarith
