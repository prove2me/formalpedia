    Nat.add_mul_div_right _ _ hpos, mul_assoc, Nat.add_mul_mod_self_left]

theorem fsetZ_block {st : ι → ℕ} {n : ℕ} (ha : ∀ i, 2 * st i ∣ n) (v j : ℕ) (y : ι → Fin 2) :
    fsetZ st (v * n + j) y = (v * n : ℕ) + fsetZ st j y := by
  simp only [fsetZ, fbit_block ha]; push_cast; ring

theorem fset_block {st : ι → ℕ} {n : ℕ} (hs : SLaws st n) (ha : ∀ i, 2 * st i ∣ n) (v : ℕ)
    {j : ℕ} (hj : j < n) (y : ι → Fin 2) : fset st (v * n + j) y = v * n + fset st j y := by
  unfold fset
  rw [fsetZ_block ha]
