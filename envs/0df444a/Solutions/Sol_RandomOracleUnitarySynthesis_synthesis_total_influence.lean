theorem solution {n m m₀ k : ℕ}
    (C : synthesis_Circuit n m m₀ k) (f : synthesis_Oracle m₀) :
    (∑ x, synthesis_influence C f x) = 2 * (k : ℝ) * (2 : ℝ)^n :=
  InfluenceProof.synthesis_total_influence C f
