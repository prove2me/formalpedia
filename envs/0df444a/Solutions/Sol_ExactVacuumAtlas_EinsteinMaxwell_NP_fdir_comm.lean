    fdir E A (fdir E B f) x - fdir E B (fdir E A f) x = ∑ C, cfr E Θ C A B x * fdir E C f x := by
  rw [fdir_fdir hF hx A B hf, fdir_fdir hF hx B A hf]
  have hsym : ∑ μ, ∑ ν, E B μ x * E A ν x * cpdC μ (cpdC ν f) x
      = ∑ μ, ∑ ν, E A μ x * E B ν x * cpdC μ (cpdC ν f) x := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ => by
      rw [cpdC_cpdC_symm hF.isOpen hf hx ν μ]; ring
  have hR : ∑ C, cfr E Θ C A B x * fdir E C f x = ∑ ν, brk E A B ν x * cpdC ν f x := by
    simp only [cfr, fdir, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [← hF.sum_coeff hx (fun ρ => brk E A B ρ x) ν, Finset.sum_mul]
    exact Finset.sum_congr rfl fun C _ => by ring
  rw [hsym, hR]
  simp only [brk, sub_mul, Finset.sum_sub_distrib]
  ring
