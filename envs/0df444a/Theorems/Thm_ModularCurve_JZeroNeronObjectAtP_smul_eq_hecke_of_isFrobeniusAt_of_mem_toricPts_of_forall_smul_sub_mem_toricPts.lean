theorem ModularCurve.JZeroNeronObjectAtP.smul_eq_hecke_of_isFrobeniusAt_of_mem_toricPts_of_forall_smul_sub_mem_toricPts
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (hIU : ∀ (m : ℕ), m.Coprime p →
      ∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ x ∈ jZeroTorsion (N₀ * p) m, σ • x - x ∈ O.toricPts m) :
    HeckeInputsAll (N₀ * p) → HeckeOperatorsCommuteBar (N₀ * p) →
      ∀ (m : ℕ), 0 < m → m.Coprime p →
        ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, A.IsFrobeniusAt σ p →
          ∀ x ∈ O.toricPts m,
            σ • x = (letI := heckeModuleBar (N₀ * p); (((p : ℕ) : HeckeAlg) * heckeGen ⟨p, Fact.out⟩) • x) := by sorry
