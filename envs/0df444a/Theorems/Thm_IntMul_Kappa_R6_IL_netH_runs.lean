open IntMul IntMul.Kappa IntMul.Kappa.R6 IntMul.Kappa.R6.IL
open IntMul NLogN NLogN.RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset
variable {W T m : ℕ}
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem IntMul.Kappa.R6.IL.netH_runs {G0 : Fin HS → List Item} {v : ℕ} (E : Bit.Edge m → IStmt HS Pp)
    (impl : Bit.Edge m → List (ZMod 2) → List (ZMod 2)) (cE : Bit.Edge m → ℕ)
    (s : IState HS) (hs : Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : TabB (T + W) v Bb)
    (hv1 : 1 ≤ v) :
    ∀ (prog : List (Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m)),
      (∀ e ∈ Bit.progEdges prog, ∀ ys : List (ZMod 2), ys.length = v → (impl e ys).length = v) →
      (∀ e ∈ Bit.progEdges prog, ∀ ys : List (ZMod 2), ys.length = v →
        ∀ (t : IState HS) (R : List Item), Inv G0 t →
        IRuns I iprog (E e) (t.upd 0 (ints (enc2 ys) ++ R)) (t.upd 0 (ints (enc2 (impl e ys)) ++ R))
          (cE e)) →
      ∀ (st : Fin W ⊕ Fin T → List (ZMod 2)) (f : Fin HS → List ℤ), (∀ x, (st x).length = v) →
      (∀ r, Prot r → f r = []) → RegS s f (T + W) v →
      f 0 = tabR 0 (T + W) (tabS st) ++ rest → f 21 = [] →
      IRuns I iprog (netH E prog) (encK s f)
        (encK s (Function.update f 0 (tabR 0 (T + W) (tabS (Bit.netRunH v impl prog st)) ++ rest)))
        ((prog.map (instrHC cE ((T + W) * v) Bb)).sum + 1) := by sorry
