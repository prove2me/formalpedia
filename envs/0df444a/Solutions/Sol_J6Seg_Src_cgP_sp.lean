/-!
# B-line IL, source-table producers, part 9: pass 3 (`jSrc`, the gather)

`gthP iN`: with a list `L` (`= LJ`) on `30` (head = index 0) and `|L|` on `31` (as left by `ljP`),
and `n'` (`= G ≥ |L|`) on `iN` (`Free`): move `L` reversed onto `15` (`mvK 30 15 43 (reg 31)`),
then for `j = n' - 1, …, 0` push `0` and `code (src j)` on `44`, with
`src j = if j < |L| then some L[j] else none` (`jSrc` for `L = LJ`), moving `L[j]` back from `15`
to `30`. Output: `44 := srcTab src (fun _ => 0) n' ++ F 44`, everything else (in particular
`15, 30, 31`) unchanged. Theorem `gthP_sp`, cost `(|L| + n' + 2) * (40 * uC A DD)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT J6Seg
open J6Seg.Slab (srcTab)

/-- A loop counting down on `43`, for any state family. -/
theorem loopDown (s0 : IState HS) (S : ℕ → Fin HS → List ℤ) {iN : Fin HS} (hi : iN.val < 56)
    {n' A c : ℕ} {LN : List ℤ} (h43 : ∀ j, S j 43 = []) (hN : S n' iN = (n' : ℤ) :: LN)
    (hnA : n' ≤ 2 ^ A) {b : RS} (hw : (43 : Fin HS) ∉ b.writes)
    (hb : ∀ j < n', Sp b (encK s0 (update (S (j + 1)) 43 [(j : ℤ) + 1]))
      (encK s0 (update (S j) 43 [(j : ℤ) + 1])) c) :
    Sp (.rep 43 (.reg iN) b) (encK s0 (S n')) (encK s0 (S 0)) ((n' + 1) * (c + uC A DD)) := by
  have H := repP (C := 43) (i := iN) (b := b) (s0 := s0) (F := fun k => S (n' - k)) (N := n')
    (A := A) (D := DD) (c := c) (by decide) (fun k => h43 _) hw hi (by simpa using hN) hnA
    (by decide) (fun k hk => by
      obtain ⟨j, hj⟩ : ∃ j, n' - k = j + 1 := ⟨n' - k - 1, by omega⟩
      have e2 : n' - (k + 1) = j := by omega
      have e3 : (n' : ℤ) - k = (j : ℤ) + 1 := by omega
      simp only [hj, e2, e3]
      exact hb j (by omega))
  simpa using H

theorem lit_sp (s0 : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} (hi : i.val < 56) (z : ℤ)
    {A : ℕ} (hz : |z| ≤ 2 ^ A) (h4 : z.natAbs ≤ 4) (hA : 2 ≤ A) :
    Sp (.push i (.lit z)) (encK s0 F) (encK s0 (update F i (z :: F i))) (2 * uC A DD) := by
  have h := pushP s0 F (i := i) (e := .lit z) (v := z) (A := A) (D := DD) hi
    (fun r hr => by simp [Ex.regs] at hr) trivial rfl (fun r hr => by simp [Ex.regs] at hr) hA
    (by simp [J6Seg.PreT.Poly, h4]) (by simp [J6Seg.PreT.dg, DD])
  exact h.mono (by simp [Ex.size])

/-- A conditional on a linear expression, both branches bounded by `C`. -/
theorem iteG (s0 : IState HS) (F : Fin HS → List ℤ) {e : Ex HS} {A : ℕ} (hcl : e.Clean)
    (hok : e.ok (encK s0 F)) (hl : e.Lin) (hR : RB (encK s0 F) A e) (hA : 2 ≤ A)
    (hp : J6Seg.PreT.Poly e = true) (hd : J6Seg.PreT.dg e ≤ DD) {a b : RS} {t : IState HS} {C : ℕ}
    (ha : e.eval (encK s0 F) < 0 → Sp a (encK s0 F) t C)
    (hb : ¬ e.eval (encK s0 F) < 0 → Sp b (encK s0 F) t C) (hC : e.size * uC A DD ≤ C) :
    Sp (.ite e a b) (encK s0 F) t (2 * C + 200 * (A * DD + 1 + 1)) := by
  have hcc := lin_cost_le (D := DD) hl hR hA hp hd
  have hz := Ex.zsz_eval_le _ _ _ (bnd_P (D := DD) hR hA hp hd)
  by_cases h : e.eval (encK s0 F) < 0
  · exact Sp.ite_neg hcl hok h (ha h) hz (hcc.trans hC)
  · exact Sp.ite_nn hcl hok h (hb h) hz (hcc.trans hC)

end J6Seg.Src

