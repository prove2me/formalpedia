    ∃ G : ℝ → ℝ, ∃ δ > 0, ContDiffOn ℝ k G (Ioo (-δ) δ) ∧ EqOn G g (Ioo 0 δ) ∧ G 0 = L := by
  obtain ⟨G, hG, he, hv⟩ := h
  obtain ⟨u, hu, hGu⟩ := hG.contDiffOn le_rfl (by simp)
  obtain ⟨δ₁, hδ₁, hball⟩ := Metric.mem_nhds_iff.1 hu
  obtain ⟨δ₂, hδ₂, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 he
  refine ⟨G, min δ₁ δ₂, lt_min hδ₁ hδ₂, hGu.mono ?_,
    fun x hx => hsub ⟨hx.1, lt_of_lt_of_le hx.2 (min_le_right _ _)⟩, hv⟩
  intro x hx
  apply hball
  rw [Metric.mem_ball, Real.dist_eq, sub_zero, abs_lt]
  constructor <;> linarith [hx.1, hx.2, min_le_left δ₁ δ₂]

