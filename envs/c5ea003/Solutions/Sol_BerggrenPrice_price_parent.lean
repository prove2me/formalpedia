open BerggrenPrice in
theorem solution(v : Node) (hv : IsNode v) (hr : v ≠ root) :
    ∃ i u, IsNode u ∧ price i u = v := by
  obtain ⟨h1, h2, hc, ho⟩ := hv
  obtain ⟨x, y, hxy⟩ := hc
  rw [Int.odd_iff] at ho
  rcases Int.even_or_odd v.1 with hev | hodd
  · obtain ⟨k, hk⟩ := hev
    have hk2 : v.1 = 2 * k := by omega
    have hNodd : v.2 % 2 = 1 := by omega
    obtain ⟨t, ht⟩ : ∃ t : ℤ, v.2 = 2 * t + 1 := ⟨(v.2 - 1) / 2, by omega⟩
    rcases lt_trichotomy v.2 k with hlt | heq | hgt
    · refine ⟨0, (k, k - v.2), ⟨by simp; omega, by simp; omega,
        ⟨2 * x + y, -y, by simp; linear_combination hxy - x * hk2⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff]; simp; omega
      · show pA _ = v
        refine Prod.ext ?_ ?_ <;> (simp [pA]; try omega)
    · exfalso
      have hd : v.2 ∣ 1 := ⟨2 * x + y, by rw [hk2, ← heq] at hxy; linarith⟩
      have := Int.le_of_dvd one_pos hd
      have hn : v.2 = 1 := by omega
      have hm : v.1 = 2 := by omega
      exact hr (Prod.ext hm hn)
    · refine ⟨1, (k, v.2 - k), ⟨by simp; omega, by simp; omega,
        ⟨2 * x + y, y, by simp; linear_combination hxy - x * hk2⟩, ?_⟩, ?_⟩
      · rw [Int.odd_iff]; simp; omega
      · show pB _ = v
        refine Prod.ext ?_ ?_ <;> (simp [pB]; try omega)
  · obtain ⟨k, hk⟩ := hodd
    have hNev : v.2 % 2 = 0 := by omega
    obtain ⟨t, ht⟩ : ∃ t : ℤ, v.2 = 2 * t := ⟨v.2 / 2, by omega⟩
    refine ⟨2, (v.1 - t, t), ⟨by simp; omega, by simp; omega,
      ⟨x, x + 2 * y, by simp; linear_combination hxy - y * ht⟩, ?_⟩, ?_⟩
    · rw [Int.odd_iff]; simp; omega
    · show pC _ = v
      refine Prod.ext ?_ ?_ <;> (simp [pC]; try omega)
