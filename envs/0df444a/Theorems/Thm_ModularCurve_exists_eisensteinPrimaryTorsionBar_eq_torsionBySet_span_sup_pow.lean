open ModularCurve

theorem ModularCurve.exists_eisensteinPrimaryTorsionBar_eq_torsionBySet_span_sup_pow
    (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] :
    letI := heckeModuleBar p
    ∃ c : ℕ, 0 < c ∧ ∀ m : ℕ,
      eisensteinPrimaryTorsionBar p q m =
        (Submodule.torsionBySet HeckeAlg (JZero p)
          (↑((Ideal.span {(q : HeckeAlg)} ⊔ eisensteinMaximalIdeal p q ^ c) ^ m) :
            Set HeckeAlg)).toAddSubgroup := by sorry
