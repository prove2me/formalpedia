-- title:
--   Seeded prime Galois data, rebased
-- statement:
--   Galois-theoretic data used to construct seeded orderly primes: a p-adic place for the eigenform and seed character, cyclotomic and seed-character data, Chebotarev prime classes, residual eigenform representations, and simultaneous orderly Frobenius classes. This version imports the shared horizontal auxiliary definitions directly and has no dependency on the superseded V2 interpolation bundle.
-- source:
--   Kriz–Nordentoft, Horizontal p-adic L-functions, arXiv:2310.20678v3, Sections 4–5.

import Definitions.Def_KN_HorizontalPadicLAux
import Definitions.Def_LanglandsTunnell_TowerCounting

set_option autoImplicit false
noncomputable section

namespace HorizontalPadicL

/-- A chosen `p`-adic place of the coefficient field generated by an eigenform
and a seed character, together with the integrality needed for reduction. -/
structure SeededEigenformPadicPlaceData
    {N k p : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (η : DirichletCharacterWithLevel) where
  embedding : MTT.Qbar →+* ℂ_[p]
  coeff_integral : ∀ n : ℕ, ‖embedding (f.coeff n)‖ ≤ 1
  character_integral : ∀ a : ℕ, ‖embedding (η.2 a)‖ ≤ 1

/-- The two finite abelian Galois characters used in the orderly-prime
argument: the cyclotomic character modulo `p ^ m * N`, and the character cut
out by the seed Dirichlet character. -/
structure SeedCyclotomicGaloisData
    (N p m : ℕ) (η : DirichletCharacterWithLevel) where
  modulus : ℕ
  modulus_eq : modulus = Nat.lcm (p ^ m * N) η.2.conductor
  seedGenerator : MTT.Qbar
  seedGenerator_order : orderOf seedGenerator = orderOf η.2

/-- A rational-prime set represented by a single conjugacy class in a finite
Galois extension, up to deleting finitely many primes. -/
inductive IsChebotarevPrimeClass (A : Set ℕ) : Prop
  | ofFiniteGalois
      (L : Type) [Field L] [NumberField L] [IsGalois ℚ L]
      (σ : L ≃ₐ[ℚ] L) (S : Finset ℕ)
      (realizes : A = {ℓ : ℕ |
        ℓ ∉ S ∧ LanglandsTunnell.classIndicator σ ℓ = 1}) :
      IsChebotarevPrimeClass A

/-- A finite residual representation attached to an eigenform, together with
the rational primes whose Frobenius maps to the identity.  The constructor
records that this is an actual representation of a finite Galois group, that
the identity locus is a Chebotarev class, and that trace compatibility makes
the Hecke coefficient congruent to `2` there. -/
inductive ResidualEigenformRepresentationData
    {N k p : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (η : DirichletCharacterWithLevel)
    (V : SeededEigenformPadicPlaceData (p := p) f η) : Type 2
  | ofRepresentation
      (L 𝕜 : Type) [Field L] [NumberField L] [IsGalois ℚ L]
      [Field 𝕜] [Fintype 𝕜]
      (ρ : TaylorWiles.ResidualRep L 𝕜)
      (identityFrobeniusPrimes : Set ℕ)
      (identity_isChebotarev : IsChebotarevPrimeClass identityFrobeniusPrimes)
      (prime_of_mem : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ identityFrobeniusPrimes → ℓ.Prime)
      (coeff_near_two : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ identityFrobeniusPrimes →
        ‖V.embedding (f.coeff ℓ - 2)‖ < 1)
      (unramified_away : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ identityFrobeniusPrimes →
        Nat.Coprime ℓ (N * p)) :
      ResidualEigenformRepresentationData f η V

/-- The simultaneous Frobenius class required by the horizontal construction.
It imposes identity Frobenius on the residual representation and cyclotomic
part, and a generator on the seed-character part. -/
structure SeededOrderlyFrobeniusClassData
    {N k p : ℕ} {ι : MTT.Qbar →+* ℂ} [Fact p.Prime]
    (f : MTT.Eigenform N k ι) (η : DirichletCharacterWithLevel)
    (m B : ℕ) (V : SeededEigenformPadicPlaceData (p := p) f η) where
  primes : Set ℕ
  chebotarevClass : IsChebotarevPrimeClass primes
  prime_of_mem : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes → ℓ.Prime
  avoids : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes → Nat.Coprime ℓ B
  congruent_one_mod_pm : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes → Nat.ModEq (p ^ m) ℓ 1
  coprime_level_seed : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes →
    Nat.Coprime ℓ (N * η.2.conductor)
  coeff_near_two : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes →
    ‖V.embedding (f.coeff ℓ - 2)‖ < 1
  nebentype_near_one : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes →
    ‖V.embedding (f.epsilon ℓ - 1)‖ < 1
  seed_value_has_full_order : ∀ ⦃ℓ : ℕ⦄, ℓ ∈ primes →
    orderOf (η.2 ℓ) = orderOf η.2

end HorizontalPadicL


