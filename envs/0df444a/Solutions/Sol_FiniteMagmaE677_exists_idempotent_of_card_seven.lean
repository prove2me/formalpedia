  decide

/-- Every element of `Fin 7` is a numeral; the value `6` is the last case. -/
theorem cv6 (w : Fin 7) : w = 0 ∨ w = 1 ∨ w = 2 ∨ w = 3 ∨ w = 4 ∨ w = 5 ∨ w = 6 := by
  revert w
  decide

/-- The relabelling of `op` by a permutation `σ`. -/
def conj (op : Op) (σ : Equiv.Perm (Fin 7)) : Op := fun a b => σ (op (σ.symm a) (σ.symm b))

/-- The swap of two labels. -/
abbrev sw (a b : Fin 7) : Equiv.Perm (Fin 7) := Equiv.swap a b

/-- A relabelling keeps the hypotheses. -/
theorem H.cj {op : Op} (h : H op) (σ : Equiv.Perm (Fin 7)) : H (conj op σ) where
  e x y := by
    simp only [conj, Equiv.symm_apply_apply]
    rw [← h.e (σ.symm x) (σ.symm y), Equiv.apply_symm_apply]
  ni x hx := by
    apply h.ni (σ.symm x)
    have hx' := congrArg σ.symm hx
    simp only [conj, Equiv.symm_apply_apply] at hx'
    exact hx'

/-- A cell of a relabelled operation. -/
theorem cc {op : Op} {σ : Equiv.Perm (Fin 7)} {a b w : Fin 7} (hab : op a b = w)
    {a' b' w' : Fin 7} (ha : σ a = a' := by decide) (hb : σ b = b' := by decide)
    (hw : σ w = w' := by decide) : conj op σ a' b' = w' := by
  subst ha hb hw
  simp only [conj, Equiv.symm_apply_apply, hab]

/-- Rule R1: equation 677 at `x y` with `op y x = a`, `op a y = b`, `op x b = c`. -/
theorem r1 {op : Op} (h : H op) {x y a b c : Fin 7} (h1 : op y x = a) (h2 : op a y = b)
    (h3 : op x b = c) : op y c = x := by
  subst h1 h2 h3
  exact (h.e x y).symm

/-- Rule R1 with a different value in the cell `op y c`. -/
theorem k1 {op : Op} (h : H op) {x y a b c d : Fin 7} (h1 : op y x = a)
    (h2 : op a y = b) (h3 : op x b = c) (h4 : op y c = d) (hne : x ≠ d := by decide) : False :=
  hne ((r1 h h1 h2 h3).symm.trans h4)

/-- Rule R3: equation 677 at `x y` and the injectivity of row `y` give the cell `op x b`. -/
theorem r3 {op : Op} (h : H op) {x y a b c : Fin 7} (h1 : op y x = a) (h2 : op a y = b)
    (h3 : op y c = x) : op x b = c := by
  apply h.inj y
  rw [h3]
  subst h1 h2
  exact (h.e x y).symm

/-- Rule R4: equation 677 at `x y` and the injectivity of rows `y`, `x` give the cell
`op a y`. -/
theorem r4 {op : Op} (h : H op) {x y a b c : Fin 7} (h1 : op y x = a) (h3 : op y c = x)
    (h4 : op x b = c) : op a y = b := by
  apply h.inj x
  rw [h4]
  apply h.inj y
  rw [h3]
  subst h1
  exact (h.e x y).symm

/-- Two cells of one row with the same value. -/
theorem kr {op : Op} (h : H op) {y a b v : Fin 7} (e1 : op y a = v) (e2 : op y b = v)
    (hab : a ≠ b := by decide) : False :=
  hab (h.inj y (e1.trans e2.symm))

/-- Rule RC: the last open cell `op y c` of a row whose other values are known has the
value `0`. -/
theorem rc0 {op : Op} (h : H op) {y : Fin 7} (c : Fin 7) {j1 j2 j3 j4 j5 j6 : Fin 7}
    (e1 : op y j1 = 1) (e2 : op y j2 = 2) (e3 : op y j3 = 3) (e4 : op y j4 = 4) (e5 : op y j5 = 5)
