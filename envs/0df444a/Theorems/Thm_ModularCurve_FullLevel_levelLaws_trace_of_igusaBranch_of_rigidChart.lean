        ∀ i, p.coeff i ∈ maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) :
    ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
