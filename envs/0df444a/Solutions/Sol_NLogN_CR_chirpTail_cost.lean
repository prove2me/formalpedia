  · exact ⟨_, _, _, rfl, by positivity⟩
  · exact ⟨_, _, _, rfl, by positivity⟩

theorem mergeL_width (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) (r : List ℤ)
    (h : r ∈ mergeL v κ R T) : r.length = 3 := by
  obtain ⟨_, _, _, rfl, _⟩ := mergeL_rec3 v κ R T r h; rfl

theorem outRev_rev (E : List (ℤ × (ℤ × ℤ))) :
    (ints (outRev E)).reverse = ints ((E.map fun e => [e.2.1, e.2.2]).flatten) := by
  rw [outRev, ints_reverse, List.reverse_reverse]

