theorem solution (O R : Type) [CommRing O] [CommRing R] [Algebra O R]
    (n : ℕ) (pi : O) (b : Fin n → R) (E : R ≃ₗ[O] ((Fin n → O) × R)) :
    TypeDensity.RaisesAdicOrder (Ideal.span {pi}) (TypeDensity.coordinateRemainder pi b E) := by
  set I : Ideal O := Ideal.span {pi}
  have key : ∀ (j : ℕ) {M N : Type} [AddCommGroup M] [Module O M] [AddCommGroup N] [Module O N]
      (f : M →ₗ[O] N) (x : M), x ∈ (I ^ j • ⊤ : Submodule O M) →
        f x ∈ (I ^ j • ⊤ : Submodule O N) := by
    intro j M N _ _ _ _ f x hx
    have hle : (I ^ j • ⊤ : Submodule O M) ≤ (I ^ j • ⊤ : Submodule O N).comap f := by
      rw [Submodule.smul_le]
      intro r hr m _
      simpa using Submodule.smul_mem_smul hr Submodule.mem_top
    exact hle hx
  intro j x y hxy
  unfold TypeDensity.adicCongr at hxy ⊢
  have h2 : x.2 - y.2 ∈ (I ^ j • ⊤ : Submodule O R) := by
    simpa using key j (LinearMap.snd O (Fin n → O) R) _ hxy
  have hL : TypeDensity.coordinateLift b x.1 - TypeDensity.coordinateLift b y.1 ∈ (I ^ j • ⊤ : Submodule O R) := by
    simpa [TypeDensity.coordinateLift, Fintype.linearCombination_apply, sub_smul, Finset.sum_sub_distrib]
      using key j ((Fintype.linearCombination O b).comp (LinearMap.fst O (Fin n → O) R)) _ hxy
  have hprod : x.2 * TypeDensity.coordinateLift b x.1 - y.2 * TypeDensity.coordinateLift b y.1
      ∈ (I ^ j • ⊤ : Submodule O R) := by
    rw [show x.2 * TypeDensity.coordinateLift b x.1 - y.2 * TypeDensity.coordinateLift b y.1
        = x.2 * (TypeDensity.coordinateLift b x.1 - TypeDensity.coordinateLift b y.1)
          + (x.2 - y.2) * TypeDensity.coordinateLift b y.1 by ring]
    exact Submodule.add_mem _ (key j (LinearMap.mulLeft O x.2) _ hL)
      (key j (LinearMap.mulRight O (TypeDensity.coordinateLift b y.1)) _ h2)
  have hE := key j E.toLinearMap _ hprod
  simp only [LinearEquiv.coe_coe, map_sub] at hE
  unfold TypeDensity.coordinateRemainder
  rw [← smul_sub, pow_succ', Submodule.mul_smul]
  exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self pi) hE
