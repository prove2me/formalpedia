section TateL

variable {J : Type} [AddCommGroup J] (D : AddSubgroup J)

theorem mem_L_iff {s : ℕ → J} :
    s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D) ↔
      (∀ n, ((2 ^ n : ℕ) : ℤ) • s n = 0 ∧ ((2 : ℕ) : ℤ) • s (n + 1) = s n) ∧ ∀ n, s n ∈ D :=
  ⟨fun h => ⟨h.1, fun n => h.2 n (Set.mem_univ n)⟩, fun h => ⟨h.1, fun n _ => h.2 n⟩⟩

theorem exists_eq_nsmul_of_apply_eq_zero {s : ℕ → J}
    (hs : s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) (m : ℕ) (h0 : s m = 0) :
    ∃ u ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D), s = 2 ^ m • u := by
  have hsL := (mem_L_iff D).1 hs
  let S : _root_.TateModule 2 J := ⟨s, hs.1⟩
  have hS0 : _root_.TateModule.proj 2 J m S = 0 := h0
  refine ⟨fun n => s (n + m), (mem_L_iff D).2 ⟨fun n => ?_, fun n => hsL.2 (n + m)⟩, ?_⟩
  · exact (_root_.TateModule.shiftOfProjEqZero m S hS0).2 n
  · funext n
    rw [Pi.smul_apply, ← natCast_zsmul]
    exact (_root_.TateModule.compat_pow S n m).symm

theorem pow_nsmul_apply_eq_zero {s : ℕ → J}
    (hs : s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) (m : ℕ) :
    2 ^ m • s m = 0 := by
  have h := ((mem_L_iff D).1 hs).1 m
  rw [natCast_zsmul] at h
  exact h.1

theorem eq_of_pow_nsmul_eq {s s' : ℕ → J}
    (hs : s ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D))
    (hs' : s' ∈ _root_.TateModule 2 J ⊓ AddSubgroup.pi Set.univ (fun _ => D)) (k : ℕ)
    (h : 2 ^ k • s = 2 ^ k • s') : s = s' := by
  funext n
  have e1 := _root_.TateModule.compat_pow (⟨s, hs.1⟩ : _root_.TateModule 2 J) n k
  have e2 := _root_.TateModule.compat_pow (⟨s', hs'.1⟩ : _root_.TateModule 2 J) n k
  change ((2 ^ k : ℕ) : ℤ) • s (n + k) = s n at e1
  change ((2 ^ k : ℕ) : ℤ) • s' (n + k) = s' n at e2
  have hc := congrFun h (n + k)
  rw [Pi.smul_apply, Pi.smul_apply] at hc
  rw [← e1, ← e2, natCast_zsmul, natCast_zsmul, hc]

end TateL

section ModuleAlgebra

variable {A V : Type*} [CommRing A] [AddCommGroup V] [Module A V]

theorem smul_sub_smul_eq_of_repr {t t' : A} {x s₀ l l' : V} {P : ℕ}
    (h : x - t • s₀ = P • l) (h' : x - t' • s₀ = P • l') :
    t • s₀ - t' • s₀ = P • (l' - l) := by
  rw [nsmul_sub, ← h, ← h']
  abel

theorem nsmul_sub_smul_eq_of_repr {t t' τ : A} {s s₀ l l₁ : V} {a P Q : ℕ} (hP : P = 2 ^ a * Q)
    (e : 2 ^ a • s - τ • s₀ = P • l₁) (h : t • s₀ - t' • s₀ = P • l) :
    2 ^ a • ((t - t') • s) = 2 ^ a • (Q • (τ • l + (t - t') • l₁)) := by
  have e' : 2 ^ a • s = τ • s₀ + P • l₁ := sub_eq_iff_eq_add'.1 e
  have hd : (t - t') • s₀ = P • l := by rw [sub_smul]; exact h
  rw [smul_comm (2 ^ a) (t - t') s, e', smul_add, ← mul_smul, mul_comm (t - t') τ, mul_smul, hd,
    smul_comm τ P l, smul_comm (t - t') P l₁, ← nsmul_add, hP, mul_nsmul']

theorem repr_add {τ₁ τ₂ : A} {s₁ s₂ s₀ l₁ l₂ : V} {a P : ℕ}
    (h₁ : 2 ^ a • s₁ - τ₁ • s₀ = P • l₁) (h₂ : 2 ^ a • s₂ - τ₂ • s₀ = P • l₂) :
    2 ^ a • (s₁ + s₂) - (τ₁ + τ₂) • s₀ = P • (l₁ + l₂) := by
  rw [nsmul_add, add_smul, nsmul_add, ← h₁, ← h₂]
  abel

theorem repr_double {τ : A} {s s₀ l : V} {a P Q : ℕ} (hP : P = Q * 2)
    (h : 2 ^ a • s - τ • s₀ = P • l) : 2 ^ a • s - τ • s₀ = Q • (2 • l) := by
  rw [h, hP, mul_nsmul']

theorem repr_smul (t : A) {τ : A} {s s₀ l : V} {a P : ℕ} (h : 2 ^ a • s - τ • s₀ = P • l) :
    2 ^ a • (t • s) - (t * τ) • s₀ = P • (t • l) := by
  rw [smul_comm (2 ^ a) t s, mul_smul, ← smul_sub, h, smul_comm t P l]

theorem repr_of_ker {te τ v : A} {s s₀ l₁ l₃ : V} {a m P Q : ℕ} (hP : P = 2 ^ m * Q)
    (hact : (te * τ - v * ((2 : ℕ) : A) ^ m) • s₀ = 0)
    (e₃ : te • (τ • s₀) - τ • s₀ = 2 ^ m • l₃) (e : 2 ^ a • s - τ • s₀ = P • l₁) :
    2 ^ a • s = 2 ^ m • (v • s₀ - l₃ + Q • l₁) := by
  rw [sub_smul, sub_eq_zero, mul_smul, mul_smul, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul] at hact
  have e' : 2 ^ a • s = τ • s₀ + P • l₁ := sub_eq_iff_eq_add'.1 e
  have e₃' : τ • s₀ = 2 ^ m • (v • s₀) - 2 ^ m • l₃ := by
    rw [← e₃, smul_comm (2 ^ m) v s₀, ← hact]
    abel
  rw [e', e₃', hP, mul_nsmul', nsmul_add, nsmul_sub]

end ModuleAlgebra

section ModuleAlgebraSeq

variable {J : Type} [AddCommGroup J] {A : Type*} [CommRing A] [Module A J]

theorem smul_sub_smul_eq_of_repr_seq {t t' : A} {x s₀ l l' : ℕ → J} {P : ℕ}
    (h : x - t • s₀ = P • l) (h' : x - t' • s₀ = P • l') :
    t • s₀ - t' • s₀ = P • (l' - l) := by
  funext n
  have hn := congrFun h n
  have hn' := congrFun h' n
  simp only [Pi.smul_apply, Pi.sub_apply] at hn hn' ⊢
  exact smul_sub_smul_eq_of_repr hn hn'

theorem nsmul_sub_smul_eq_of_repr_seq {t t' τ : A} {s s₀ l l₁ : ℕ → J} {a P Q : ℕ}
    (hP : P = 2 ^ a * Q) (e : 2 ^ a • s - τ • s₀ = P • l₁) (h : t • s₀ - t' • s₀ = P • l) :
    2 ^ a • ((t - t') • s) = 2 ^ a • (Q • (τ • l + (t - t') • l₁)) := by
  funext n
  have en := congrFun e n
  have hn := congrFun h n
  simp only [Pi.smul_apply, Pi.sub_apply, Pi.add_apply] at en hn ⊢
  exact nsmul_sub_smul_eq_of_repr hP en hn

theorem repr_add_seq {τ₁ τ₂ : A} {s₁ s₂ s₀ l₁ l₂ : ℕ → J} {a P : ℕ}
    (h₁ : 2 ^ a • s₁ - τ₁ • s₀ = P • l₁) (h₂ : 2 ^ a • s₂ - τ₂ • s₀ = P • l₂) :
    2 ^ a • (s₁ + s₂) - (τ₁ + τ₂) • s₀ = P • (l₁ + l₂) := by
  funext n
  have h₁n := congrFun h₁ n
  have h₂n := congrFun h₂ n
  simp only [Pi.smul_apply, Pi.sub_apply, Pi.add_apply] at h₁n h₂n ⊢
  exact repr_add h₁n h₂n

theorem repr_double_seq {τ : A} {s s₀ l : ℕ → J} {a P Q : ℕ} (hP : P = Q * 2)
    (h : 2 ^ a • s - τ • s₀ = P • l) : 2 ^ a • s - τ • s₀ = Q • (2 • l) := by
  funext n
  have hn := congrFun h n
  simp only [Pi.smul_apply, Pi.sub_apply] at hn ⊢
  exact repr_double hP hn

theorem repr_smul_seq (t : A) {τ : A} {s s₀ l : ℕ → J} {a P : ℕ}
    (h : 2 ^ a • s - τ • s₀ = P • l) : 2 ^ a • (t • s) - (t * τ) • s₀ = P • (t • l) := by
  funext n
  have hn := congrFun h n
  simp only [Pi.smul_apply, Pi.sub_apply] at hn ⊢
  exact repr_smul t hn

theorem repr_of_ker_seq {te τ v : A} {s s₀ l₁ l₃ : ℕ → J} {a m P Q : ℕ} (hP : P = 2 ^ m * Q)
    (hact : ∀ n, (te * τ - v * ((2 : ℕ) : A) ^ m) • s₀ n = 0)
    (e₃ : te • (τ • s₀) - τ • s₀ = 2 ^ m • l₃) (e : 2 ^ a • s - τ • s₀ = P • l₁) :
    2 ^ a • s = 2 ^ m • (v • s₀ - l₃ + Q • l₁) := by
  funext n
  have e₃n := congrFun e₃ n
  have en := congrFun e n
  simp only [Pi.smul_apply, Pi.sub_apply, Pi.add_apply] at e₃n en ⊢
  exact repr_of_ker hP (hact n) e₃n en

end ModuleAlgebraSeq

section Count

theorem natCard_quotient_le {Lt J : Type*} [AddCommGroup Lt] [AddCommGroup J]
    (K : AddSubgroup Lt) (π : Lt →+ J) (c : ℤ) (F : Set J) [Finite ↥F]
    (hπ : ∀ z ∈ K, π z ∈ F) (hshift : ∀ z : Lt, π z = 0 → ∃ u : Lt, z = c • u)
    (htors : ∀ u : Lt, π (c • u) = 0) :
    Nat.card (↥K ⧸ (zsmulAddGroupHom c).range.addSubgroupOf K) ≤ Nat.card ↥F := by
  have hS : (zsmulAddGroupHom c).range.addSubgroupOf K = (π.comp K.subtype).ker := by
    ext k
    rw [AddSubgroup.mem_addSubgroupOf, AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
    constructor
    · rintro ⟨u, hu⟩
      show π (k : Lt) = 0
      rw [← hu, zsmulAddGroupHom_apply, htors]
    · intro hk
      obtain ⟨u, hu⟩ := hshift (k : Lt) hk
      exact ⟨u, by rw [zsmulAddGroupHom_apply, ← hu]⟩
  rw [hS]
  have hmem : ∀ q, QuotientAddGroup.kerLift (π.comp K.subtype) q ∈ F := fun q => by
    induction q using QuotientAddGroup.induction_on with
    | H z =>
      rw [QuotientAddGroup.kerLift_mk]
      exact hπ (z : Lt) z.2
  exact Nat.card_le_card_of_injective (fun q => (⟨_, hmem q⟩ : ↥F))
    (fun q₁ q₂ h => QuotientAddGroup.kerLift_injective (π.comp K.subtype) (congrArg Subtype.val h))

end Count

