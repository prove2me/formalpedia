  have hγ : γP n ≤ (bP n : ℝ) / 4 := by
    have hαle : (αP n : ℝ) ≤ 2 * (12 * (IntMul.OpenAI.R154.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
      have := Nat.ceil_lt_add_one (show 0 ≤ (12 * (IntMul.OpenAI.R154.dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) by
        positivity)
      unfold αP; linarith
    have hd0 : (0 : ℝ) < IntMul.OpenAI.R154.dP n := by exact_mod_cast hd1
    have := RP.gamma_bound (IntMul.OpenAI.R154.dP n) (bP n) (αP n) hd0 (by linarith) (Nat.cast_nonneg _) hαle
    unfold γP; linarith [gamma_room hn]
  -- factorial bound
  have hfact : 64 * IntMul.OpenAI.R154.dP n ^ 2 * (256 * IntMul.OpenAI.R154.dP n ^ 2).factorial ≤ IntMul.OpenAI.R154.rP n := by
    refine (fact_bound (IntMul.OpenAI.R154.dP n)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    have h5 := b_ge_d5 hn
    have hd0 : (0 : ℝ) < IntMul.OpenAI.R154.dP n := by exact_mod_cast hd1
    have : ((2 ^ 17 * IntMul.OpenAI.R154.dP n ^ 4 : ℕ) : ℝ) ≤ ℓP n := by
      refine le_trans ?_ hl1
      push_cast
      rw [le_div_iff₀ (by positivity)]
