  set CL := cornerSubmodule (M := H1 (M * r) ⊤ 𝒪) (Sp'.e i') with hCL
  set CM := cornerSubmodule (M := H1 M ⊤ 𝒪) (Sp₀.e i₀) with hCM
  let G : (↥CM × ↥CM) → ↥CL := fun ab =>
    ⟨iDegL M (M * r) ⊤ ⊤ 1 𝒪 𝒪 h1 (ab.1 : H1 M ⊤ 𝒪) + iDegL M (M * r) ⊤ ⊤ r 𝒪 𝒪 hr' (ab.2 : H1 M ⊤ 𝒪),
