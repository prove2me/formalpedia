theorem QEC.Coding.BDL26FiniteEmbeddingExperiment.stageCost_prefix {L : ℝ} (p : GeometricParameters L) {m n : ℕ}
    (h : m ≤ n) (i : Fin m) (z : Experiment p n) :
    stageCost p m i (experimentPrefix p m n h z) =
      stageCost p n (i.castLE h) z := by sorry
