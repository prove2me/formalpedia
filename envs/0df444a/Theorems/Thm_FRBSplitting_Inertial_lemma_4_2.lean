-- title:
--   Lemma 4.2, p. 12 — the energy inequality of the relaxed inertial scheme
-- statement:
--   Let $H$ be a real inner product space, $A:H\rightrightarrows H$ monotone with resolvents $J_{\gamma A}$ ($\gamma>0$), and $B:H\to H$ monotone. Let $\alpha\ge0$ and $\beta,\lambda>0$, put $B':=B-\frac{\alpha}{\lambda}I$, and suppose $B'$ is $L'$-Lipschitz. Let $x\in(A+B)^{-1}(0)$ and let $(x_k)$, $(z_k)$ be generated by the relaxed inertial scheme (34) (equivalently (35)) from arbitrary $x_0,x_{-1}$. Define
--
--   $$b_k:=2\lambda\langle B(x)-B(x_k),x-x_k\rangle .$$
--
--   Then $b_k\ge0$ for all $k$, and for every $k\in\mathbb N$
--
--   $$\begin{aligned}(1-\alpha)\|x_{k+1}-x\|^2&+2\lambda\langle B'(x_{k+1})-B'(x_k),x-x_{k+1}\rangle+b_{k+1}\\ &\le(1-\alpha)\|x_k-x\|^2+2\lambda\langle B'(x_k)-B'(x_{k-1}),x-x_k\rangle+b_k\\ &\quad+\frac{\lambda L'}{\beta}\|x_k-x_{k-1}\|^2-\Big(\frac{2-\beta-\lambda L'}{\beta}-\alpha\Big)\|x_{k+1}-x_k\|^2.\end{aligned}$$
--
--   This is the Lyapunov-type inequality from which boundedness of the iterates and $\|x_{k+1}-x_k\|\to0$ follow in Theorem 4.3.
--
--   **Formalization Note.** Indices are shifted by one (`x j` is $x_{j-1}$), so the paper's $b_k$ is `b (k+1)`; $b$ is written out in place. "$L'$ is the Lipschitz constant of $B'$" is the hypothesis that $B'$ is $L'$-Lipschitz. $A$ is only assumed monotone and $H$ need not be complete (neither maximality nor completeness is used). No upper bounds on $\alpha$ or $\beta$ are assumed, as on the page.
-- source:
--   Malitsky & Tam, A Forward-Backward Splitting Method for Monotone Inclusions Without Cocoercivity, arXiv:1808.04162v4, p. 12, Lemma 4.2

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_MonotoneOperators
import Definitions.Def_FRBSplitting_Inertial_Setting
open InnerProductSpace ThreeOpSplitting.Accel

namespace FRBSplitting.Inertial

theorem lemma_4_2 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    (A : H → Set H) (B : H → H) (J : ℝ → H → H) (α β lam L' : ℝ)
    (hA : IsMonotoneOp A)
    (hJ : IsResolventFamily A J)
    (hBm : IsMonotoneFun B)
    (hα : 0 ≤ α) (hβ : 0 < β) (hlam : 0 < lam)
    (hL' : IsLipschitzOp L' (shiftOp B (α / lam)))
    (x z : ℕ → H) (hrun : IsRelaxedInertialRun J B α β lam x z)
    (xs : H) (hxs : xs ∈ FRBSplitting.Weak.zeroSet A B) :
    (∀ j : ℕ, 0 ≤ 2 * lam * ⟪B xs - B (x j), xs - x j⟫_ℝ) ∧
    ∀ k : ℕ,
      (1 - α) * ‖x (k + 2) - xs‖ ^ 2
          + 2 * lam * ⟪shiftOp B (α / lam) (x (k + 2)) - shiftOp B (α / lam) (x (k + 1)),
              xs - x (k + 2)⟫_ℝ
          + 2 * lam * ⟪B xs - B (x (k + 2)), xs - x (k + 2)⟫_ℝ ≤
        (1 - α) * ‖x (k + 1) - xs‖ ^ 2
          + 2 * lam * ⟪shiftOp B (α / lam) (x (k + 1)) - shiftOp B (α / lam) (x k),
              xs - x (k + 1)⟫_ℝ
          + 2 * lam * ⟪B xs - B (x (k + 1)), xs - x (k + 1)⟫_ℝ
          + lam * L' / β * ‖x (k + 1) - x k‖ ^ 2
          - ((2 - β - lam * L') / β - α) * ‖x (k + 2) - x (k + 1)‖ ^ 2 := by sorry

end FRBSplitting.Inertial
