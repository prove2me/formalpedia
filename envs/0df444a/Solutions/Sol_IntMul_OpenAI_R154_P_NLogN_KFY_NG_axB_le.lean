theorem bigpow (x : ℕ) (hx : 2 ^ 16 ≤ x) : x ^ 32 * 2 ^ 512 ≤ 2 ^ x := by
  have hx0 : x ≠ 0 := by omega
  have h1 : 2 ^ Nat.log 2 x ≤ x := Nat.pow_log_le_self 2 hx0
  have h2 : x < 2 ^ (Nat.log 2 x + 1) := Nat.lt_pow_succ_log_self (by norm_num) x
  have hj : 16 ≤ Nat.log 2 x := Nat.le_log_of_pow_le (by norm_num) hx
  have hl := lin_le_two_pow _ hj
  calc x ^ 32 * 2 ^ 512 ≤ (2 ^ (Nat.log 2 x + 1)) ^ 32 * 2 ^ 512 := by gcongr
    _ = 2 ^ (32 * Nat.log 2 x + 544) := by rw [← pow_mul, ← pow_add]; congr 1; ring
    _ ≤ 2 ^ (2 ^ Nat.log 2 x) := Nat.pow_le_pow_right (by norm_num) hl
