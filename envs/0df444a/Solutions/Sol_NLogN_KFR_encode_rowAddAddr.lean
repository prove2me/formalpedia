variable {K m k e : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ}

theorem sR_top (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) (r : Fin m) :
    sR K (m ^ k) e r + m ^ k * K ≤ e - e % K + K := by
  have h0 := sR_add he r
  have h1 := rowE_le he r
  have hf : 1 ≤ m ^ k := Nat.one_le_pow _ _ (by have := r.isLt; omega)
  have a1 : K * (m ^ k - 1) ≤ K * (m ^ k * (r.val + 1) - 1) :=
    Nat.mul_le_mul_left _ (by rw [Nat.mul_succ]; omega)
  have a2 : K * (m ^ k - 1) + K = m ^ k * K := by
    rw [Nat.mul_comm (m ^ k) K, ← Nat.mul_succ]; congr 1; omega
  have a3 := Nat.mod_le e K
  omega

theorem sR_gap (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) {r r' : Fin m}
    (h : r < r') : sR K (m ^ k) e r' + m ^ k * K ≤ sR K (m ^ k) e r := by
  have h1 := sR_lt he h
  have : m ^ k * K ≤ m ^ k * K * (r'.val - r.val) :=
    Nat.le_mul_of_pos_right _ (by have : r.val < r'.val := h; omega)
  omega

theorem pow_mul_pow_mul' (x y S : ℕ) : 2 ^ x * (2 ^ y * S) = 2 ^ (x + y) * S := by
  rw [← mul_assoc, ← pow_add]

section Shape

variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ

theorem shR_weight (τ : Fin 3) :
    vol ((NLogN.KFR.shR K (m ^ k) e t S0 B σ).drop (slotF τ + 1)) = 2 ^ sR K (m ^ k) e (σ τ) * S0 := by
  have g1 := sR_gap he hσ.1
  have g2 := sR_gap he hσ.2
  fin_cases τ <;>
  · simp only [NLogN.KFR.shR, rect, slotF, Fin.isValue, Fin.val_zero, Fin.val_one, Fin.val_two, Fin.mk_one,
      Fin.zero_eta, Fin.reduceFinMk, Fin.val_mk, mul_zero, mul_one, zero_add,
      List.drop_succ_cons, List.drop_zero, vol_cons, vol_nil]
    repeat rw [pow_mul_pow_mul']
    try (congr 2; omega)

theorem shR_vol : vol (NLogN.KFR.shR K (m ^ k) e t S0 B σ) = B * 2 ^ t * S0 := by
  have g1 := sR_gap he hσ.1
  have g2 := sR_gap he hσ.2
  have g0 := sR_top he (σ 0)
  simp only [NLogN.KFR.shR, rect, vol_cons, vol_nil, mul_one]
  repeat rw [pow_mul_pow_mul']
  rw [mul_assoc B, mul_assoc B, pow_mul_pow_mul']
  congr 3; omega

theorem shR_field (τ : Fin 3) : (NLogN.KFR.shR K (m ^ k) e t S0 B σ).getD (slotF τ) 0 = 2 ^ (m ^ k * K) := by
  fin_cases τ <;> simp [NLogN.KFR.shR, rect, slotF]

theorem shR_length : (NLogN.KFR.shR K (m ^ k) e t S0 B σ).length = 7 := by simp [NLogN.KFR.shR, rect]

theorem shR_digit {q : ℕ} (hq : q < B * 2 ^ t * S0) (τ : Fin 3) :
    (decode (NLogN.KFR.shR K (m ^ k) e t S0 B σ) q).getD (slotF τ) 0 =
      q / (2 ^ sR K (m ^ k) e (σ τ) * S0) % 2 ^ (m ^ k * K) := by
  have hq' : q < vol (NLogN.KFR.shR K (m ^ k) e t S0 B σ) := by rw [shR_vol he htop hσ]; exact hq
  have hv := valid_decode hq'
  rw [getD_digit _ _ _ hv (by rw [hv.length_eq, shR_length he htop hσ]; fin_cases τ <;> simp [slotF]),
    encode_decode hq', shR_weight he htop hσ, shR_field he htop hσ]

end Shape

end NLogN.KFR

