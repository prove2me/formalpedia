        rgD [(d : ℤ)]) rgS [(bs.sum : ℤ)])
        tD (descA 1 (axD h bs ss) ++ (2 * 2 ^ NLogN.KFZ.eS h bs d : ℤ) :: F0 tD)))
      (10 ^ 10 * (d + 1) * (B + 2) ^ 2) := by
  have e0 : ∀ j ∈ setupRegs, F0 j = [] := h0
  have e0' := h0
  simp only [setupRegs, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp,
    forall_eq] at e0'
  obtain ⟨u1, u2, u3, u4, u5, u6, u7, u8, u9, u10, u11, u12⟩ := e0'
  have zh : zsz (h : ℤ) ≤ B := zszS (by omega)
  have zd : zsz (d : ℤ) ≤ B := zszS (by omega)
  have hsum : bs.sum ≤ d := by
    have := List.sum_le_card_nsmul bs 1 hb1; simp at this <;> omega
  have hdh : d * h + bs.sum = NLogN.KFZ.eS h bs d := by
