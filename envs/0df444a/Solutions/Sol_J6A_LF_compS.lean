-- Source module: Solutions.J6SegILPreJ3
/-!
# B-line IL, `J` pre-table (B5-J), part 3: entering and leaving the register file; list reads

* `initP l` / `finiP l`: push `0` on / pop every register of `l` (`rg` at the end): from a state
  with empty registers to `RF 0 c` and back (`initP_sp`, `finiP_sp`, plain `Sp` statements);
* `rdK X j dst`: `dst := (list on X)[j]` through register `9`, temp stack `15`, counter `47`
  (`Rn.rdK`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS

/-! ## Entering and leaving -/

theorem initP_sp (s : IState HS) : ∀ (l : List (Fin HS)) (c : Cs), l.Nodup → (∀ j ∈ l, j.val < 56) →
    Sp (initP l) (encK s c) (encK s (pushL l (fun _ => 0) c)) (l.length * 8001 + 1)
  | [], c, _, _ => by
    have : pushL [] (fun _ => 0) c = c := by funext j; simp [pushL]
    rw [this]; exact Sp.skip _
  | j :: l, c, hnd, hl => by
    rw [List.nodup_cons] at hnd
    have h1 := Sp.push (i := j) (e := .lit 0) (B := 0) s c (hl j (by simp)) (by
      intro i hi; simp [Ex.regs] at hi) trivial trivial (by simp [Ex.Bnd, zsz_zero])
    have h2 := initP_sp s l (Function.update c j ((Ex.lit 0).eval (encK s c) :: c j)) hnd.2
      (fun i hi => hl i (by simp [hi]))
    have e : pushL l (fun _ => 0) (Function.update c j ((Ex.lit 0).eval (encK s c) :: c j)) =
        pushL (j :: l) (fun _ => 0) c := by
      funext i
      simp only [pushL, Ex.eval, List.mem_cons]
      by_cases hij : i = j
      · subst hij; simp [hnd.1]
      · simp [Function.update_of_ne hij, hij]
    rw [e] at h2
    refine (h1.seq h2).mono ?_
    simp only [Ex.size, List.length_cons]; ring_nf; omega

theorem rg_nodup : rg.Nodup := by decide

theorem rg_lt56 : ∀ j ∈ rg, j.val < 56 := fun j hj => rg_lt hj

theorem pushL_rg (a : Fin HS → ℤ) (c : Cs) (hc : ∀ j ∈ rg, c j = []) : pushL rg a c = RF a c := by
  funext j
  by_cases h : j ∈ rg
  · simp [pushL, RF_in h, h, hc j h]
  · simp [pushL, RF_out h, h]

/-- **Entering the register file.** -/
theorem init_sp (s : IState HS) (c : Cs) (hc : ∀ j ∈ rg, c j = []) :
    Sp (initP rg) (encK s c) (encK s (RF (fun _ => 0) c)) (21 * 8001 + 1) := by
  have h := initP_sp s rg c rg_nodup rg_lt56
  rw [pushL_rg _ c hc] at h
  exact h

/-! ## Reading a list entry -/

end J6Seg.PJ

