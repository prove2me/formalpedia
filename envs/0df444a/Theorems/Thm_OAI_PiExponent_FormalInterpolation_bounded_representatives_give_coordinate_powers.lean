-- title:
--   Extract coordinate powers from bounded representatives at a fixed degree
-- statement:
--   For any polynomial representative bound strictly below D and common degree witnesses for the coordinate weights, each coordinate has a positive power in the ideal generated by degree-D weighted components of elements of I^s with support weights at most D.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.bounded_representatives_give_coordinate_powers
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (s : Nat) (D : Real)
    (rho : Rat) (eps C : Real)
    (hDcut : (s : Real) * ((rho : Real) + eps) + C < D)
    (hrepr : ∀ q : MvPolynomial (Fin d) Complex, ∃ p : MvPolynomial (Fin d) Complex,
      q - p ∈ I ^ s ∧
      ∀ a ∈ p.support,
        ∑ k, (w k : Real) * (a k : Real) ≤
          (s : Real) * ((rho : Real) + eps) + C)
    (hweights : ∀ i : Fin d, ∃ e : Nat, 0 < e ∧ (w i : Real) * (e : Real) = D) :
    ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
      MvPolynomial.X i ^ e ∈
        Ideal.span (Set.range (fun f :
          {p : MvPolynomial (Fin d) Complex //
            p ∈ I ^ s ∧
            ∀ a ∈ p.support,
              ∑ k, (w k : Real) * (a k : Real) ≤ D} =>
          MvPolynomial.weightedHomogeneousComponent
            (fun k => (w k : Real)) D f.1)) := by sorry
