      (E2 * G) * W = (-PowerSeries.X^2 * W * H) * W := by
    calc
      (E2 * G) * W = (W * G) * E2 := by ring
      _ = (E0 * H) * E2 := by rw [← hE0']
      _ = (E0 * E2) * H := by ring
      _ = (-PowerSeries.X^2 * W^2) * H := by rw [h02]
