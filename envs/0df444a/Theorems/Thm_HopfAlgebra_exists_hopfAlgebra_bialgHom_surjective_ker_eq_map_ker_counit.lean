-- title:
--   Hopf quotient of B by the ideal generated by φ(kerε_A)
-- statement:
--   Let $R$ be a commutative ring, let $A$ and $B$ be commutative rings carrying Hopf algebra structures over $R$, and let $\varphi\colon A \to B$ be a bialgebra homomorphism over $R$. The assertion is the existence of a type $H$ in the same universe as $B$, equipped with a commutative ring structure and a Hopf algebra structure over $R$, together with a bialgebra homomorphism $q\colon B \to H$ over $R$ such that: $q$ is surjective; the kernel of $q$, taken as a ring homomorphism, equals the ideal of $B$ generated by the image under $\varphi$ (viewed as an $R$-algebra homomorphism) of the kernel of the counit $\varepsilon_A\colon A \to R$ regarded as an $R$-algebra homomorphism, i.e. $\ker q = \varphi(\ker\varepsilon_A)B$; if the comultiplication of $B$ is cocommutative then so is that of $H$; and if $B$ is finite as an $R$-module then so is $H$.
--
--   Dually this constructs the scheme-theoretic kernel of the homomorphism $\operatorname{Spec} B \to \operatorname{Spec} A$ of commutative affine group schemes over $R$ as a closed subgroup scheme of $\operatorname{Spec} B$, cut out by the ideal generated by the augmentation ideal of $A$. It is used in the rank computations for finite flat commutative Hopf algebras ([`HopfAlgebra.finrank_eq_finrank_quotient_map_ker_counit_mul_finrank_range`](thm.html#HopfAlgebra.finrank_eq_finrank_quotient_map_ker_counit_mul_finrank_range) and the cotangent-space rank formula) and in the construction of $p$-divisible towers in the deformation-theoretic part of the argument.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_HopfAlgebra_exists_hopfAlgebra_bialgHom_surjective_ker_eq_map_ker_counit.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u v w

theorem HopfAlgebra.exists_hopfAlgebra_bialgHom_surjective_ker_eq_map_ker_counit
    {R : Type u} [CommRing R] {A : Type v} [CommRing A] [HopfAlgebra R A]
    {B : Type w} [CommRing B] [HopfAlgebra R B] (φ : A →ₐc[R] B) :
    ∃ (H : Type w) (_ : CommRing H) (_ : HopfAlgebra R H) (q : B →ₐc[R] H),
      Function.Surjective q ∧
      RingHom.ker (q : B →+* H) =
        Ideal.map (φ : A →ₐ[R] B) (RingHom.ker (Bialgebra.counitAlgHom R A)) ∧
      (Coalgebra.IsCocomm R B → Coalgebra.IsCocomm R H) ∧
      (Module.Finite R B → Module.Finite R H) := by sorry
