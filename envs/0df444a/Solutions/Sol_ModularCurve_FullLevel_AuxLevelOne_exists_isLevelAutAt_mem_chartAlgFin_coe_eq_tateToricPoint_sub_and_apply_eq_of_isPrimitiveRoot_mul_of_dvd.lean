namespace H34A

noncomputable def pmap {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) :
    W.toAffine.Point →+ (W.map (algebraMap K F)).toAffine.Point :=
  WeierstrassCurve.Affine.Point.baseChange (W' := W) K F

theorem pmap_zero {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) :
    pmap (F := F) W 0 = 0 := map_zero _

theorem pmap_some {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) {x y : K}
    (h : W.toAffine.Nonsingular x y) :
    pmap (F := F) W (WeierstrassCurve.Affine.Point.some x y h) =
      WeierstrassCurve.Affine.Point.some (algebraMap K F x) (algebraMap K F y)
        ((WeierstrassCurve.Affine.map_nonsingular W (algebraMap K F).injective x y).mpr h) := rfl

theorem pmap_injective {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) :
    Function.Injective (pmap (F := F) W) :=
  WeierstrassCurve.Affine.Point.map_injective (W' := W) (Algebra.ofId K F)

theorem toPoint_baseChange {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) (x y : K) :
    toPoint (W.map (algebraMap K F)) (algebraMap K F x) (algebraMap K F y) = pmap W (toPoint W x y) := by
  by_cases h : W.toAffine.Nonsingular x y
  · have h' : (W.map (algebraMap K F)).toAffine.Nonsingular (algebraMap K F x) (algebraMap K F y) :=
      (WeierstrassCurve.Affine.map_nonsingular W (algebraMap K F).injective x y).mpr h
    have e1 : toPoint W x y = WeierstrassCurve.Affine.Point.some x y h := dif_pos h
    have e2 : toPoint (W.map (algebraMap K F)) (algebraMap K F x) (algebraMap K F y) =
        WeierstrassCurve.Affine.Point.some _ _ h' := dif_pos h'
    rw [e1, e2]
    rfl
  · have h' : ¬ (W.map (algebraMap K F)).toAffine.Nonsingular (algebraMap K F x) (algebraMap K F y) :=
      fun h' => h ((WeierstrassCurve.Affine.map_nonsingular W (algebraMap K F).injective x y).mp h')
    have e1 : toPoint W x y = 0 := dif_neg h
    have e2 : toPoint (W.map (algebraMap K F)) (algebraMap K F x) (algebraMap K F y) = 0 := dif_neg h'
    rw [e1, e2, pmap_zero]

theorem ofPoint_baseChange {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K) (P : W.toAffine.Point) :
    ofPoint (W.map (algebraMap K F)) (pmap W P) = (algebraMap K F (ofPoint W P).1, algebraMap K F (ofPoint W P).2) := by
  rcases P with _ | ⟨x, y, h⟩
  · show ofPoint (W.map (algebraMap K F)) (pmap W 0) = (algebraMap K F 0, algebraMap K F 0)
    rw [pmap_zero, map_zero]; rfl
  · rfl

theorem relabel_map_eq {K F : Type} [Field K] [Field F] [Algebra K F] (W : WeierstrassCurve K)
    (g : Matrix (Fin 2) (Fin 2) ℤ) (D : LevelPData K) :
    (LevelPData.relabel W g D).map (algebraMap K F) =
      LevelPData.relabel (W.map (algebraMap K F)) g (D.map (algebraMap K F)) := by
  have key : ∀ (a b : ℤ),
      (algebraMap K F (ofPoint W (a • toPoint W D.xP D.yP + b • toPoint W D.xQ D.yQ)).1,
        algebraMap K F (ofPoint W (a • toPoint W D.xP D.yP + b • toPoint W D.xQ D.yQ)).2) =
      ofPoint (W.map (algebraMap K F))
        (a • toPoint (W.map (algebraMap K F)) (algebraMap K F D.xP) (algebraMap K F D.yP) +
          b • toPoint (W.map (algebraMap K F)) (algebraMap K F D.xQ) (algebraMap K F D.yQ)) := by
    intro a b
    rw [toPoint_baseChange, toPoint_baseChange, ← map_zsmul (pmap (F := F) W), ← map_zsmul (pmap (F := F) W),
      ← map_add (pmap (F := F) W),
      ofPoint_baseChange]
  unfold LevelPData.relabel
  refine LevelPData.ext ?_ ?_ ?_ ?_
  · exact congrArg Prod.fst (key (g 0 0) (g 1 0))
  · exact congrArg Prod.snd (key (g 0 0) (g 1 0))
  · exact congrArg Prod.fst (key (g 0 1) (g 1 1))
  · exact congrArg Prod.snd (key (g 0 1) (g 1 1))

end H34A

namespace WRTate

def g₁ : Matrix (Fin 2) (Fin 2) ℤ := !![1, 0; 1, 1]

@[scoped simp] theorem g₁_00 : g₁ 0 0 = 1 := rfl
@[scoped simp] theorem g₁_10 : g₁ 1 0 = 1 := rfl
@[scoped simp] theorem g₁_01 : g₁ 0 1 = 0 := rfl
@[scoped simp] theorem g₁_11 : g₁ 1 1 = 1 := rfl

theorem toPoint_of_nonsingular {T : Type} [Field T] (W : WeierstrassCurve T) (x y : T) (h : W.toAffine.Nonsingular x y) :
    toPoint W x y = WeierstrassCurve.Affine.Point.some x y h := dif_pos h

theorem relabel_g₁_xP_yP {T : Type} [Field T] (W : WeierstrassCurve T) (D : ModularCurve.LevelPData T) (x y : T)
    (hxy : W.toAffine.Nonsingular x y)
    (h : toPoint W D.xP D.yP + toPoint W D.xQ D.yQ = WeierstrassCurve.Affine.Point.some x y hxy) :
    (LevelPData.relabel W g₁ D).xP = x ∧ (LevelPData.relabel W g₁ D).yP = y := by
  have e : ofPoint W (g₁ 0 0 • toPoint W D.xP D.yP + g₁ 1 0 • toPoint W D.xQ D.yQ) = (x, y) := by
    rw [g₁_00, g₁_10, one_smul, one_smul, h]; rfl
  refine ⟨?_, ?_⟩ <;> simp only [LevelPData.relabel, e]

theorem variableChange_inv_variableChange {T : Type} [CommRing T] (C : WeierstrassCurve.VariableChange T)
    (D : ModularCurve.LevelPData T) : (D.variableChange C⁻¹).variableChange C = D := by
  rw [← ModularCurve.LevelPData.variableChange_mul, mul_inv_cancel, ModularCurve.LevelPData.variableChange_one]

theorem variableChange_variableChange_inv {T : Type} [CommRing T] (C : WeierstrassCurve.VariableChange T)
    (D : ModularCurve.LevelPData T) : (D.variableChange C).variableChange C⁻¹ = D := by
  rw [← ModularCurve.LevelPData.variableChange_mul, inv_mul_cancel, ModularCurve.LevelPData.variableChange_one]

theorem eq_variableChange_cuspData_add
    (L : Type) [Field L] [CharZero L] (N : ℕ) [NeZero N] (ξ : L) (hξ : IsPrimitiveRoot ξ N)
    (Cy : WeierstrassCurve.VariableChange (LaurentSeries L))
    (W₂ : WeierstrassCurve (LaurentSeries L)) [W₂.IsElliptic] (hW₂ : W₂ = Cy • ModularCurve.tateBase L N)
    (vR vP : Fin 2 → ZMod N) (hvR : vR ≠ 0) (hvP : vP ≠ 0) (hsum : vR + vP ≠ 0)
    (E₂ : ModularCurve.LevelPData (LaurentSeries L))
    (hE₂ : E₂ = (ModularCurve.cuspData L N (hξ.isUnit (NeZero.ne N)).unit vR vP).variableChange Cy)
    (hP : W₂.toAffine.Nonsingular E₂.xP E₂.yP) (hQ : W₂.toAffine.Nonsingular E₂.xQ E₂.yQ)
    (X₂ Y₂ : LaurentSeries L) (hXY : W₂.toAffine.Nonsingular X₂ Y₂)
    (h : toPoint W₂ E₂.xP E₂.yP + toPoint W₂ E₂.xQ E₂.yQ = WeierstrassCurve.Affine.Point.some X₂ Y₂ hXY) :
    X₂ = ((ModularCurve.cuspData L N (hξ.isUnit (NeZero.ne N)).unit (vR + vP) vP).variableChange Cy).xP ∧
    Y₂ = ((ModularCurve.cuspData L N (hξ.isUnit (NeZero.ne N)).unit (vR + vP) vP).variableChange Cy).yP := by
  obtain ⟨hx, hy⟩ := relabel_g₁_xP_yP W₂ E₂ X₂ Y₂ hXY h

  have h₁ : g₁ 0 0 • toPoint W₂ E₂.xP E₂.yP + g₁ 1 0 • toPoint W₂ E₂.xQ E₂.yQ ≠ 0 := by
    rw [g₁_00, g₁_10, one_smul, one_smul, h]; exact WeierstrassCurve.Affine.Point.some_ne_zero _
  have h₂ : g₁ 0 1 • toPoint W₂ E₂.xP E₂.yP + g₁ 1 1 • toPoint W₂ E₂.xQ E₂.yQ ≠ 0 := by
    rw [g₁_01, g₁_11, zero_smul, one_smul, zero_add, toPoint_of_nonsingular W₂ _ _ hQ]
    exact WeierstrassCurve.Affine.Point.some_ne_zero _
  have key := ModularCurve.LevelRelabelling.relabel_smul_variableChange W₂ Cy⁻¹ g₁ E₂ hP.left hQ.left h₁ h₂

  have hW : Cy⁻¹ • W₂ = ModularCurve.tateBase L N := by rw [hW₂, inv_smul_smul]
  have hE : E₂.variableChange Cy⁻¹ = ModularCurve.cuspData L N (hξ.isUnit (NeZero.ne N)).unit vR vP := by
    rw [hE₂, variableChange_variableChange_inv]
  rw [hW, hE, ModularCurve.LevelRelabelling.relabel_tateBase_cuspData_eq_cuspData_zsmul_add_zsmul L N ξ hξ vR vP g₁ hvR hvP
    (by simpa using hsum) (by simpa using hvP)] at key

  have key' := congrArg (fun D => D.variableChange Cy) key
  simp only [variableChange_inv_variableChange] at key'
  simp only [g₁_00, g₁_10, g₁_01, g₁_11, one_smul, zero_smul, zero_add] at key'
  rw [← key'] at hx hy
  exact ⟨hx.symm, hy.symm⟩

theorem some_congr {T : Type} [Field T] {W : WeierstrassCurve T} {x₁ y₁ x₂ y₂ : T} (hx : x₁ = x₂) (hy : y₁ = y₂)
    {h₁ : W.toAffine.Nonsingular x₁ y₁} {h₂ : W.toAffine.Nonsingular x₂ y₂} :
    WeierstrassCurve.Affine.Point.some x₁ y₁ h₁ = WeierstrassCurve.Affine.Point.some x₂ y₂ h₂ := by subst hx hy; rfl

theorem index_R_ne_zero (q ℓ : ℕ) [hq : Fact q.Prime] [hℓ : Fact ℓ.Prime] :
    haveI : NeZero (q * ℓ) := ⟨Nat.mul_ne_zero hq.out.ne_zero hℓ.out.ne_zero⟩
    (![0, -(q : ZMod (q * ℓ))] : Fin 2 → ZMod (q * ℓ)) ≠ 0 := by
  haveI : NeZero (q * ℓ) := ⟨Nat.mul_ne_zero hq.out.ne_zero hℓ.out.ne_zero⟩
  intro h0
  have h1 : (q : ZMod (q * ℓ)) = 0 := by simpa using congrFun h0 1
  rw [ZMod.natCast_eq_zero_iff] at h1
  have := Nat.le_of_dvd hq.out.pos h1
  have h2 : 2 ≤ ℓ := hℓ.out.two_le
  nlinarith [hq.out.pos]

