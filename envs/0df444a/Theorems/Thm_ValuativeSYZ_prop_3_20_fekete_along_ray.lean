-- title:
--   Proposition 3.20 (1), Fekete step: normalised limits of a subadditive function along a ray
-- statement:
--   **Proposition 3.20 (1), Fekete step.** Lemma 3.19 shows that, for a valuatively independent basis,
--   the function
--   $$F_x \colon \Gamma_y \to \mathbb{R}, \qquad (l, p(\alpha)) \;\longmapsto\;
--   \log\lVert\theta^l_\alpha\rVert(x) - \log\lVert\theta^l_\alpha\rVert(y)$$
--   is subadditive on the semigroup $\Gamma_y \subseteq \mathbb{N} \times \mathbb{Z}^n$. Proposition
--   3.20 then extracts the cost function $c(x,p;y)$ as an asymptotic limit of $l^{-1}F_x$.
--
--   This milestone isolates the underlying Fekete-type statement along a fixed ray of the semigroup: a
--   subadditive function on $\mathbb{N} \times \mathbb{Z}^n$ which is bounded below linearly along the
--   ray generated by $(l,q)$ has a well-defined normalised limit
--   $$g \;=\; \lim_{m \to \infty} \frac{F(ml, mq)}{ml},$$
--   and the limit is the infimum of the normalised values, so each finite stage is an upper bound for
--   the limit.
-- source:
--   Yang Li, *Valuative independence and metric SYZ conjecture*, arXiv:2605.00516v1 (1 May 2026), https://arxiv.org/abs/2605.00516, pp. 21, Lemma 3.19 and Proposition 3.20 item 1

import Mathlib
import Definitions.Def_ValuativeSYZ_cost_transform
import Definitions.Def_ValuativeSYZ_degeneration

set_option autoImplicit false

open MeasureTheory

namespace ValuativeSYZ

/-- **Proposition 3.20 (1), Fekete step.** Along a fixed ray of the semigroup `Γ_y`, a
subadditive function bounded below linearly has a well-defined normalised limit, equal to the
infimum of the normalised values. -/
theorem prop_3_20_fekete_along_ray {n : ℕ} (F : ℕ → (Fin n → ℤ) → ℝ)
    (hsub : ∀ (l l' : ℕ) (q q' : Fin n → ℤ), F (l + l') (q + q') ≤ F l q + F l' q')
    (l : ℕ) (hl : 0 < l) (q : Fin n → ℤ) (C : ℝ)
    (hC : ∀ m : ℕ, -(C * m) ≤ F (m * l) (m • q)) :
    ∃ g : ℝ, Filter.Tendsto (fun m : ℕ => F (m * l) (m • q) / (m * l)) Filter.atTop (nhds g) ∧
      ∀ m : ℕ, 0 < m → g ≤ F (m * l) (m • q) / (m * l) := by sorry

end ValuativeSYZ
