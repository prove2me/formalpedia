    (by omega) hwe hcapPos hQB hlo1 hQWord hword1 hroom.2.1 hdisj1 hgs4 hstored1 hG1 hm484 hm490 hp4.capacity h971
  obtain ⟨_, k5, z5, hRun5, hPc5, hCost5, hRegs5, hCount5, hQueue5, hf45raw⟩ := hKeep1
