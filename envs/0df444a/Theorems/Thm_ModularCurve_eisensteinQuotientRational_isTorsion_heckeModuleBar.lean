theorem ModularCurve.eisensteinQuotientRational_isTorsion_heckeModuleBar (p : ℕ) [Fact p.Prime]
    (hcomm : HeckeOperatorsCommuteBar p) :
    letI := heckeModuleBar p
    ∀ z ∈ eisensteinQuotientRational p (heckeModuleBar p), ∃ n : ℕ, 0 < n ∧ n • z = 0 := by sorry
