theorem solution {j : ℝ} {q : ℝ → ℝ} (hq : ContinuousOn q UG) :
    Tendsto (Bfun j q) (𝓝[Ioo (0:ℝ) aG] aG) (𝓝 (sfun j q aG / 9)) := by
  have ha : aG = 1 / 3 := rfl
  have hF : ContinuousOn (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q) (Icc (0:ℝ) aG) := continuousOn_Ffun hq
  have hFa : ContinuousWithinAt (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q) (Icc (0:ℝ) aG) aG :=
    hF aG ⟨by rw [ha]; norm_num, le_rfl⟩
  have hAa : AcK aG = 1 / 3 := by rw [ha, AcK_third]
  have hval : ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG / 3 = sfun j q aG / 9 := by
    unfold ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun
    rw [hAa]
    ring
  rw [← hval]
  rw [Metric.tendsto_nhdsWithin_nhds]
  intro ε hε
  rw [Metric.continuousWithinAt_iff] at hFa
  obtain ⟨δ, hδ, hb⟩ := hFa (ε / 3) (by linarith)
  refine ⟨min δ (1 / 12), lt_min hδ (by norm_num), ?_⟩
  intro x hx hxdist
  obtain ⟨hx0, hxa⟩ := hx
  have hxlt : aG - x < min δ (1 / 12) := by
    rw [Real.dist_eq, abs_of_neg (by linarith : x - aG < 0)] at hxdist
    linarith
  have hmem : ∀ t ∈ Icc x aG, ‖ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q t - ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG‖ ≤ ε / 3 := by
    intro t ht
    have hmemI : t ∈ Icc (0:ℝ) aG := ⟨le_trans (le_of_lt hx0) ht.1, ht.2⟩
    have hdt : dist t aG < δ := by
      rw [Real.dist_eq, abs_of_nonpos (by linarith [ht.2])]
      linarith [ht.1, hxlt, min_le_left δ (1/12 : ℝ)]
    have hb1 := hb hmemI hdt
    rw [Real.dist_eq] at hb1
    rw [Real.norm_eq_abs]
    linarith
  have hne : (0:ℝ) < 1 - 3 * x := by
    have : x < 1 / 3 := by rw [ha] at hxa; linarith
    linarith
  have hcont : ContinuousOn (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q) (Icc (0:ℝ) aG) := continuousOn_Ffun hq
  have hint1 : IntervalIntegrable (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q) volume x aG :=
    (hcont.mono (fun y hy => ⟨le_trans (le_of_lt hx0) hy.1, hy.2⟩)).intervalIntegrable_of_Icc
      (le_of_lt hxa)
  have hint2 : IntervalIntegrable (fun t => ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q t - ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG) volume x aG :=
    hint1.sub intervalIntegrable_const
  have hmemIoc : ∀ t ∈ Ι x aG, ‖ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q t - ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG‖ ≤ ε / 3 := by
    intro t ht
    rw [uIoc_of_le (le_of_lt hxa)] at ht
    exact hmem t ⟨le_of_lt ht.1, ht.2⟩
  have hbound := intervalIntegral.norm_integral_le_of_norm_le_const (a := x) (b := aG)
    (C := ε / 3) (E := ℝ) (f := fun t => ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q t - ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG) hmemIoc
  rw [Real.norm_eq_abs] at hbound
  have hlen : |aG - x| = aG - x := by
    rw [abs_of_pos]; linarith
  rw [hlen] at hbound
  rw [Real.dist_eq, Bfun_sub_third hq (le_of_lt hx0) hxa]
  rw [abs_div, abs_of_pos hne]
  have hratio : |∫ t in x..aG, (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q t - ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Ffun j q aG)| / (1 - 3 * x)
      ≤ (ε / 3 * (aG - x)) / (1 - 3 * x) :=
    div_le_div_of_nonneg_right hbound (le_of_lt hne)
  have hthird : (ε / 3 * (aG - x)) / (1 - 3 * x) < ε := by
    have h13 : 1 - 3 * x = 3 * (aG - x) := by rw [ha]; ring
    rw [h13]
    have hpos : (0:ℝ) < aG - x := by rw [ha]; linarith
    have hxne : aG - x ≠ 0 := ne_of_gt hpos
    have hval : ε / 3 * (aG - x) / (3 * (aG - x)) = ε / 9 := by
      rw [div_eq_div_iff (by positivity) (by norm_num : (9:ℝ) ≠ 0)]
      ring
    rw [hval]
    linarith
  linarith
