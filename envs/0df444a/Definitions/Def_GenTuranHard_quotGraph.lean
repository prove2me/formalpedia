-- title:
--   The quotient graph $Q_I$
-- statement:
--   Let $Q$ be a graph and $I \subseteq V(Q)$. The graph $Q_I$ is constructed from $Q$ as follows (§4.1, pp.12–13):
--
--   1. delete the vertices of $I$;
--   2. for each nonisolated vertex $v \in I$, identify all vertices of $N_Q(v)$ to form a single vertex $v'$, taking the transitive closure of these identifications (the vertices $v'$ need not be distinct);
--   3. for each isolated vertex $v \in I$, add one new isolated vertex $v'$.
--
--   Identifying a vertex set (p.4) replaces it by one new vertex adjacent to every vertex adjacent to one of the identified vertices; edges inside the set are discarded and parallel edges merged. Concretely, $Q_I$ has vertex set $\big((V(Q) \setminus I)/\!\approx\big) \sqcup \{v' : v \in I \text{ isolated}\}$, where $\approx$ is the equivalence relation generated by "$a, b \in N_Q(v)$ for some $v \in I$", and two classes are adjacent iff they are distinct and have adjacent representatives in $Q$.
--
--   $Q_I$ is the graph of homomorphisms of $Q$ into $L_x(G)$ that send exactly $I$ to the leaves (Lemma 4.1).
--
--   **Formalization Note** The vertices are renumbered on $\{0,\dots,v(Q_I)-1\}$ by a fixed bijection; vertex counts, homomorphism counts, $p(\cdot)$, edges and bipartiteness do not depend on it. A variant takes $I$ as a set of vertex indices (indices outside $\{0,\dots,v(Q)-1\}$ are ignored), for the sequences of (4.1). The verification file checks the construction on $P_3$ with $I$ its middle vertex (one vertex) and on $K_2 \cup K_1$ with $I$ the isolated vertex (three vertices).
-- source:
--   Chen, He, Li, Ma, Xie, NP-hardness of additive approximation for generalized Turán problems, arXiv:2610.16358 (sha256 dc85633a…), §4.1, pp.12–13 (Q_I); p.4 (identifying vertices)

import Mathlib
import Definitions.Def_GenTuranHard_FinGraph

set_option autoImplicit false

namespace GenTuranHard

/-- The identifications of the quotient `Q_I` (§4.1, p.13): two remaining vertices `a, b ∉ I` are
identified when both lie in the neighbourhood `N_Q(v)` of some vertex `v ∈ I` (only nonisolated `v`
contribute, since an isolated `v` has no neighbours). -/
def quotRel (Q : FinGraph) (I : Finset (Fin Q.1)) (a b : {v : Fin Q.1 // v ∉ I}) : Prop :=
  ∃ v ∈ I, Q.2.Adj v a.1 ∧ Q.2.Adj v b.1

/-- The vertex type of `Q_I`: the classes of the remaining vertices `V(Q) ∖ I` under the transitive
closure (the equivalence relation generated by `quotRel`), together with one new isolated vertex `v′`
for each isolated vertex `v ∈ I`. -/
def QuotV (Q : FinGraph) (I : Finset (Fin Q.1)) : Type :=
  Quotient (Relation.EqvGen.setoid (quotRel Q I)) ⊕ {v : Fin Q.1 // v ∈ I ∧ ∀ w, ¬ Q.2.Adj v w}

/-- Adjacency in `Q_I` ("identifying" a vertex set, p.4: the new vertex is adjacent to every vertex
adjacent to some identified vertex; edges inside the identified set are discarded and parallel edges
merged): two distinct classes are adjacent iff some representatives are adjacent in `Q`; the new
isolated vertices have no neighbours. -/
def quotAdj (Q : FinGraph) (I : Finset (Fin Q.1)) : SimpleGraph (QuotV Q I) where
  Adj
    | Sum.inl A, Sum.inl B => A ≠ B ∧ ∃ a b : {v : Fin Q.1 // v ∉ I},
        Quotient.mk _ a = A ∧ Quotient.mk _ b = B ∧ Q.2.Adj a.1 b.1
    | _, _ => False
  symm := ⟨by
    intro x y h
    match x, y, h with
    | Sum.inl A, Sum.inl B, ⟨hne, a, b, ha, hb, hab⟩ => exact ⟨hne.symm, b, a, hb, ha, hab.symm⟩⟩
  loopless := ⟨by
    intro x h
    match x, h with
    | Sum.inl A, ⟨hne, _⟩ => exact hne rfl⟩

noncomputable instance (Q : FinGraph) (I : Finset (Fin Q.1)) : Fintype (QuotV Q I) := by
  classical unfold QuotV; infer_instance

/-- The **quotient graph `Q_I`** of `Q` with respect to a vertex set `I` (Chen, He, Li, Ma, Xie,
arXiv:2610.16358, sha256 dc85633a…, §4.1, pp.12–13): delete the vertices of `I`; for each nonisolated
`v ∈ I` identify all vertices of `N_Q(v)` into a single vertex `v′`, taking the transitive closure of
these identifications; for each isolated `v ∈ I` add one new isolated vertex `v′`. It is renumbered on
`Fin v(Q_I)`.

**Formalization Note** The vertex set is `((V(Q) ∖ I)/≈) ⊔ {v ∈ I : v isolated}`, `≈` the equivalence
relation generated by "`a, b ∈ N_Q(v)` for some `v ∈ I`"; two classes are adjacent iff they are
distinct and have adjacent representatives. The paper applies it to independent `I` in bipartite `Q`,
where no class contains an edge. The numbering on `Fin _` is an arbitrary fixed one
(`Fintype.equivFin`); every quantity used (vertex count, homomorphism counts, `p(·)`, edges,
bipartiteness, sums over all vertex subsets) is invariant under it. -/
noncomputable def quotGraph (Q : FinGraph) (I : Finset (Fin Q.1)) : FinGraph :=
  ⟨Fintype.card (QuotV Q I), (quotAdj Q I).comap (Fintype.equivFin (QuotV Q I)).symm⟩

open scoped Classical in
/-- `Q_I` for a set of vertex indices `I ⊆ ℕ`, read against the vertices `Fin v(Q)` (indices outside
`{0, …, v(Q) − 1}` are ignored). Used for the sequences `(I₁, …, I_s)` of (4.1), whose entries refer to
successive graphs. -/
noncomputable def quotN (Q : FinGraph) (I : Finset ℕ) : FinGraph :=
 quotGraph Q (Finset.univ.filter (fun v : Fin Q.1 => v.val ∈ I))

end GenTuranHard


