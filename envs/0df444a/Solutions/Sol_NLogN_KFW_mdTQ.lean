      ((Ex.sub σ e).ok s ↔ (Ex.sub σ e).ok (stOf σ)) ∧
      (∀ B, (Ex.sub σ e).Bnd s B ↔ (Ex.sub σ e).Bnd (stOf σ) B) ∧
      (Ex.sub σ e).cost s = (Ex.sub σ e).cost (stOf σ) :=
    fun s => Ex.congrG (Ex.sub σ e) (by rw [hr]; simp)
