variable {O R : Type} [CommRing O] [CommRing R] [Algebra O R]

/-- The lift `∑ i, zᵢ • bᵢ` of coordinates `z ∈ O^n` along representatives `b`. -/
def coordinateLift {n : ℕ} (b : Fin n → R) (z : Fin n → O) : R := ∑ i, z i • b i

/-- The division map `(z, v) ↦ ∑ zᵢ bᵢ + f v`. -/
def divisionMap {n : ℕ} (f : R) (b : Fin n → R) (s : (Fin n → O) × R) : R :=
  coordinateLift b s.1 + f * s.2

/-- The generator `f + ∑ zᵢ bᵢ`. -/
def normalizedGenerator {n : ℕ} (f : R) (b : Fin n → R) (z : Fin n → O) : R :=
  f + coordinateLift b z

/-- The remainder map `(z, v) ↦ π • E (v · ∑ zᵢ bᵢ)` of the normalization fixed-point problem. -/
def coordinateRemainder {n : ℕ} (pi : O) (b : Fin n → R)
    (E : R ≃ₗ[O] ((Fin n → O) × R)) (s : (Fin n → O) × R) : (Fin n → O) × R :=
  pi • E (s.2 * coordinateLift b s.1)

/-- The residue cell of `f`: principal ideals whose image modulo `π` is `(f mod π)`. -/
def residueIdealCell (pi f : R) : Set (Ideal R) :=
  {J | (∃ g : R, J = Ideal.span {g}) ∧
    Ideal.map (Ideal.Quotient.mk (Ideal.span {pi})) J =
      Ideal.span {Ideal.Quotient.mk (Ideal.span {pi}) f}}

/-- The principal ideal `(f + ∑ zᵢ bᵢ)`. -/
def normalizedIdeal {n : ℕ} (f : R) (b : Fin n → R) (z : Fin n → O) : Ideal R :=
  Ideal.span {normalizedGenerator f b z}

/-- The normal form of `h`: the solution `s` of `s + coordinateRemainder s = E h` (by choice). -/
def generatorNormalForm {n : ℕ} (pi : O) (b : Fin n → R)
    (E : R ≃ₗ[O] ((Fin n → O) × R)) (h : R) : (Fin n → O) × R :=
  Function.invFun (adicPerturb (coordinateRemainder pi b E)) (E h)

/-- The curve ideal `(f + π ∑ zᵢ bᵢ)` of the chart `(f, b)` at the coordinates `z`. -/
def coordinateIdeal {n : ℕ} (pi : O) (f : R) (b : Fin n → R) (z : Fin n → O) : Ideal R :=
  normalizedIdeal f b (pi • z)

/-- The transition map between two charts with the same residue cell. -/
def idealTransition {n : ℕ} (pi : O) (b c : Fin n → R)
    (F : R ≃ₗ[O] ((Fin n → O) × R)) (h0 : R) (z : Fin n → O) : Fin n → O :=
  (generatorNormalForm pi c F (h0 + coordinateLift b z)).1

end

