/-! ### Monotonicity of `G` and `H` in the ring -/

lemma mob_map_inclusion {A B : Subring ℝ} (h : A ≤ B) (g : Matrix.SpecialLinearGroup (Fin 2) A)
    (x : OnePoint ℝ) : mob (Matrix.SpecialLinearGroup.map (Subring.inclusion h) g) x = mob g x := by
  cases x with
  | infty => rw [mob_infty, mob_infty]; rfl
  | coe t => rw [mob_coe, mob_coe]; rfl

lemma P_mono {A B : Subring ℝ} (h : A ≤ B) : P A ⊆ P B := by
  rintro x ⟨g, hg, hx⟩
  refine ⟨Matrix.SpecialLinearGroup.map (Subring.inclusion h) g, ?_, ?_⟩
  · unfold IsHyperbolic at hg ⊢
    rw [trace_ent] at hg ⊢
    exact hg
  · rw [mob_map_inclusion]; exact hx

lemma G_mono {A B : Subring ℝ} (h : A ≤ B) : G A ≤ G B := by
  simp only [Monod.Dev.GMono.G_eq_closure_isPiecewiseProj]
  apply Subgroup.closure_mono
  rintro f ⟨S, hSP, hloc⟩
  refine ⟨S, hSP.trans (P_mono h), fun x hx => ?_⟩
  obtain ⟨g, hg⟩ := hloc x hx
  exact ⟨Matrix.SpecialLinearGroup.map (Subring.inclusion h) g, hg.mono fun y hy => by
    rw [hy, mob_map_inclusion]⟩

lemma H_mono {A B : Subring ℝ} (h : A ≤ B) : H A ≤ H B := fun _ hf =>
  Subgroup.mem_inf.2 ⟨G_mono h (Subgroup.mem_inf.1 hf).1, (Subgroup.mem_inf.1 hf).2⟩

/-! ### Affine germs at `±∞` -/

/-- `f` is eventually `t ↦ lam * t + μ` along `l` -/
def AG (l : Filter ℝ) (f : OnePoint ℝ → OnePoint ℝ) (lam μ : ℝ) : Prop :=
  0 < lam ∧ ∀ᶠ t : ℝ in l, f (t : OnePoint ℝ) = ((lam * t + μ : ℝ) : OnePoint ℝ)

/-- filters preserved by increasing affine maps -/
def GoodL (l : Filter ℝ) : Prop :=
  ∀ lam μ : ℝ, 0 < lam → Tendsto (fun t => lam * t + μ) l l

lemma goodL_atBot : GoodL atBot := fun _ μ h =>
  tendsto_atBot_add_const_right _ μ (tendsto_id.const_mul_atBot h)

lemma goodL_atTop : GoodL atTop := fun _ μ h =>
  tendsto_atTop_add_const_right _ μ (tendsto_id.const_mul_atTop h)

lemma AG_comp {l : Filter ℝ} (hl : GoodL l) {f1 f2 : OnePoint ℝ → OnePoint ℝ} {l1 m1 l2 m2 : ℝ}
    (h1 : AG l f1 l1 m1) (h2 : AG l f2 l2 m2) : AG l (f1 ∘ f2) (l1 * l2) (l1 * m2 + m1) := by
  refine ⟨mul_pos h1.1 h2.1, ?_⟩
  filter_upwards [h2.2, (hl l2 m2 h2.1).eventually h1.2] with t ht1 ht2
  simp only [Function.comp_apply]
  rw [ht1, ht2]
  congr 1; ring

lemma AG_symm {l : Filter ℝ} (hl : GoodL l) (f : OnePoint ℝ ≃ₜ OnePoint ℝ) {lam μ : ℝ}
    (h : AG l f lam μ) : AG l f.symm lam⁻¹ (-μ / lam) := by
  refine ⟨inv_pos.2 h.1, ?_⟩
  have ht : Tendsto (fun s => lam⁻¹ * s + -μ / lam) l l := hl _ _ (inv_pos.2 h.1)
  filter_upwards [ht.eventually h.2] with s hs
  have : lam * (lam⁻¹ * s + -μ / lam) + μ = s := by have := h.1.ne'; field_simp; ring
  rw [this] at hs
  rw [← hs, f.symm_apply_apply]

lemma AG_congr {l : Filter ℝ} {f : OnePoint ℝ → OnePoint ℝ} {lam μ lam' μ' : ℝ}
    (h : AG l f lam μ) (h1 : lam = lam') (h2 : μ = μ') : AG l f lam' μ' := by
  subst h1; subst h2; exact h

lemma AG_id (l : Filter ℝ) : AG l id 1 0 :=
  ⟨one_pos, Eventually.of_forall fun t => by simp⟩

/-- elements of `H A` have affine germs at `-∞` and `+∞` -/
lemma AG_of_H {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ H A) :
    (∃ lam μ, AG atBot f lam μ) ∧ (∃ lam μ, AG atTop f lam μ) := by
  have hG := (Subgroup.mem_inf.1 hf).1
  have hinf : f ∞ = ∞ := (Subgroup.mem_inf.1 hf).2
  have key : ∀ g : Matrix.SpecialLinearGroup (Fin 2) A, f ∞ = mob g ∞ →
      ∃ lam μ, 0 < lam ∧ ∀ t : ℝ, mob g (t : OnePoint ℝ) = ((lam * t + μ : ℝ) : OnePoint ℝ) := by
    intro g hg
    have hdet := det_ent g
    have hc : ent g 1 0 = 0 := by
      rw [hinf, mob_infty] at hg
      split_ifs at hg with h
      · exact h
      · exact absurd hg.symm (coe_ne_infty _)
    have hd : ent g 1 1 ≠ 0 := by intro h; rw [h, hc] at hdet; simp at hdet
    have had : ent g 0 0 * ent g 1 1 = 1 := by rw [hc] at hdet; linarith
    refine ⟨ent g 0 0 / ent g 1 1, ent g 0 1 / ent g 1 1, ?_, fun t => ?_⟩
    · have h2 : ent g 0 0 / ent g 1 1 = ent g 0 0 * ent g 1 1 / (ent g 1 1 * ent g 1 1) := by
        field_simp
      rw [h2, had]; exact div_pos one_pos (mul_self_pos.2 hd)
    · rw [mob_coe, hc, zero_mul, zero_add, if_neg hd]
      congr 1; field_simp
  constructor
  · obtain ⟨g, hg⟩ := germR_of_mem_G hG ∞
    obtain ⟨lam, μ, hl, hm⟩ := key g (germ_value RF_le_nhds f.continuous hg)
    refine ⟨lam, μ, hl, ?_⟩
    have := Filter.eventually_map.1 hg
    filter_upwards [this] with t ht
    rw [ht, hm]
  · obtain ⟨g, hg⟩ := germL_of_mem_G hG ∞
    obtain ⟨lam, μ, hl, hm⟩ := key g (germ_value LF_le_nhds f.continuous hg)
    refine ⟨lam, μ, hl, ?_⟩
    have := Filter.eventually_map.1 hg
    filter_upwards [this] with t ht
    rw [ht, hm]

lemma coe_commutator (a b : H A) :
    ((⁅a, b⁆ : H A) : OnePoint ℝ ≃ₜ OnePoint ℝ) =
      (a : OnePoint ℝ ≃ₜ OnePoint ℝ) * b * (a : OnePoint ℝ ≃ₜ OnePoint ℝ)⁻¹ * (b : OnePoint ℝ ≃ₜ OnePoint ℝ)⁻¹ := by
  rw [commutatorElement_def]; rfl

lemma coeFn_commutator (a b : H A) :
    (((⁅a, b⁆ : H A) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
      (a : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (b : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘
        (a : OnePoint ℝ ≃ₜ OnePoint ℝ).symm ∘ (b : OnePoint ℝ ≃ₜ OnePoint ℝ).symm := by
  rw [coe_commutator]; rfl

section level

variable {l : Filter ℝ} (hl : GoodL l)
  (h0 : ∀ f : OnePoint ℝ ≃ₜ OnePoint ℝ, f ∈ H A → ∃ lam μ, AG l f lam μ)

include hl h0 in
lemma level1 {w : H A} (hw : w ∈ derivedSeries (H A) 1) :
    ∃ μ, AG l ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) 1 μ := by
  rw [derivedSeries_succ, derivedSeries_zero, Subgroup.commutator_def] at hw
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, -, b, -, rfl⟩ := hx
    obtain ⟨la, ma, ha⟩ := h0 a a.2
    obtain ⟨lb, mb, hb⟩ := h0 b b.2
    have ha' := AG_symm hl _ ha
    have hb' := AG_symm hl _ hb
    have := AG_comp hl ha (AG_comp hl hb (AG_comp hl ha' hb'))
    rw [coeFn_commutator]
    exact ⟨_, AG_congr this (by field_simp [ha.1.ne', hb.1.ne']) rfl⟩
  | one => exact ⟨0, AG_id l⟩
  | mul x y _ _ hx hy =>
    obtain ⟨m1, h1⟩ := hx
    obtain ⟨m2, h2⟩ := hy
    have e : ((↑(x * y) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
        (x : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (y : OnePoint ℝ ≃ₜ OnePoint ℝ) := rfl
    rw [e]
    exact ⟨_, AG_congr (AG_comp hl h1 h2) (by ring) rfl⟩
  | inv x _ hx =>
    obtain ⟨m1, h1⟩ := hx
    exact ⟨_, AG_congr (AG_symm hl _ h1) (by simp) rfl⟩

include hl h0 in
lemma level2 {w : H A} (hw : w ∈ derivedSeries (H A) 2) :
    AG l ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) 1 0 := by
  rw [derivedSeries_succ, Subgroup.commutator_def] at hw
  induction hw using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, ha1, b, hb1, rfl⟩ := hx
    obtain ⟨ma, ha⟩ := level1 hl h0 ha1
    obtain ⟨mb, hb⟩ := level1 hl h0 hb1
    have ha' := AG_symm hl _ ha
    have hb' := AG_symm hl _ hb
    have := AG_comp hl ha (AG_comp hl hb (AG_comp hl ha' hb'))
    rw [coeFn_commutator]
    exact AG_congr this (by simp) (by simp)
  | one => exact AG_id l
  | mul x y _ _ hx hy =>
    have e : ((↑(x * y) : OnePoint ℝ ≃ₜ OnePoint ℝ) : OnePoint ℝ → OnePoint ℝ) =
        (x : OnePoint ℝ ≃ₜ OnePoint ℝ) ∘ (y : OnePoint ℝ ≃ₜ OnePoint ℝ) := rfl
    rw [e]
    exact AG_congr (AG_comp hl hx hy) (by ring) (by ring)
  | inv x _ hx => exact AG_congr (AG_symm hl _ hx) (by simp) (by simp)

end level

/-- elements of the second derived subgroup of `H A` are trivial near `∞` -/
theorem derived2_trivial {w : H A} (hw : w ∈ derivedSeries (H A) 2) :
    ∀ᶠ x in 𝓝 (∞ : OnePoint ℝ), (w : OnePoint ℝ ≃ₜ OnePoint ℝ) x = x := by
  have hbot := level2 goodL_atBot (fun f hf => (AG_of_H hf).1) hw
  have htop := level2 goodL_atTop (fun f hf => (AG_of_H hf).2) hw
  have hinf : (w : OnePoint ℝ ≃ₜ OnePoint ℝ) ∞ = ∞ := (Subgroup.mem_inf.1 w.2).2
  rw [nhds_infty_eq, eventually_sup, coclosedCompact_eq_cocompact, cocompact_eq_atBot_atTop,
    eventually_map, eventually_sup, eventually_pure]
  refine ⟨⟨?_, ?_⟩, hinf⟩
  · filter_upwards [hbot.2] with t ht; rw [ht]; simp
  · filter_upwards [htop.2] with t ht; rw [ht]; simp

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open Filter Set
open scoped ENNReal

/-! ### Means from ultrafilters of point masses -/

/-- the point-mass mean along an ultrafilter -/
noncomputable def pm {ι X : Type*} (U : Ultrafilter ι) (x : ι → X) (S : Set X) : ℝ≥0∞ :=
  by classical exact if x ⁻¹' S ∈ U then 1 else 0

lemma pm_fa {ι X : Type*} (U : Ultrafilter ι) (x : ι → X) :
    Garrido.IsFinitelyAdditiveMeasure (pm U x) := by
  classical
  refine ⟨?_, ?_⟩
  · simp [pm, Ultrafilter.empty_notMem]
  · intro S T hST
    have hd : Disjoint (x ⁻¹' S) (x ⁻¹' T) := hST.preimage x
    unfold pm
    rw [preimage_union]
    by_cases hS : x ⁻¹' S ∈ U
    · have hT : x ⁻¹' T ∉ U := fun hT => by
        have := U.eventually_and.2 ⟨hS, hT⟩
        obtain ⟨i, hi1, hi2⟩ := this.exists
        exact hd.ne_of_mem hi1 hi2 rfl
      simp [hS, hT, U.union_mem_iff]
    · by_cases hT : x ⁻¹' T ∈ U
      · simp [hS, hT, U.union_mem_iff]
      · simp [hS, hT, U.union_mem_iff]

lemma pm_univ {ι X : Type*} (U : Ultrafilter ι) (x : ι → X) : pm U x univ = 1 := by
  classical
  have : (univ : Set ι) ∈ U := Filter.univ_mem (f := (U : Filter ι))
  simp [pm, this]

lemma pm_congr {ι X : Type*} (U : Ultrafilter ι) (x : ι → X) {S T : Set X}
    (h : ∀ᶠ i in (U : Filter ι), (x i ∈ S ↔ x i ∈ T)) : pm U x S = pm U x T := by
  classical
  unfold pm
  have : x ⁻¹' S ∈ U ↔ x ⁻¹' T ∈ U := by
    constructor
    · intro hS
      filter_upwards [hS, h] with i h1 h2 using h2.1 h1
    · intro hT
      filter_upwards [hT, h] with i h1 h2 using h2.2 h1
  simp only [this]

/-! ### Averaging over an amenable quotient -/

section average

variable {J : Type*} [Group J] {X : Type*} (act : J → X → X)
  (hmul : ∀ a b x, act (a * b) x = act a (act b x)) (hone : ∀ x, act 1 x = x)

include hmul in
lemma img_img (a b : J) (S : Set X) : act a '' (act b '' S) = act (a * b) '' S := by
  rw [image_image]; congr 1; funext x; rw [hmul]

include hmul hone in
lemma act_inj (a : J) : Function.Injective (act a) := fun x y h => by
  have := congrArg (act a⁻¹) h
  rwa [← hmul, ← hmul, inv_mul_cancel, hone, hone] at this

include hmul hone in
lemma img_univ (a : J) : act a '' univ = univ := by
  apply image_univ_of_surjective
  intro x; exact ⟨act a⁻¹ x, by rw [← hmul, mul_inv_cancel, hone]⟩

lemma fa_le_one {Y : Type*} {m : Set Y → ℝ≥0∞} (hm : Garrido.IsFinitelyAdditiveMeasure m)
    (hu : m univ = 1) (S : Set Y) : m S ≤ 1 := by
  rw [← hu, ← union_compl_self S, hm.2 _ _ disjoint_compl_right]
  exact le_self_add

include hmul hone in
theorem average (N : Subgroup J) [N.Normal] (hQ : Garrido.HasInvariantMean (J ⧸ N))
    (m0 : Set X → ℝ≥0∞) (hm0 : Garrido.IsFinitelyAdditiveMeasure m0) (hm0u : m0 univ = 1)
    (hN : ∀ n ∈ N, ∀ S, m0 (act n '' S) = m0 S) :
    ∃ m : Set X → ℝ≥0∞, Garrido.IsFinitelyAdditiveMeasure m ∧ m univ = 1 ∧
      (∀ g S, m (act g '' S) = m S) ∧ (∀ S, (∀ g, act g '' S = S) → m S = m0 S) := by
  obtain ⟨ν, hνpos, hνone, hνinv⟩ := hQ
  have hle : ∀ S, m0 S ≤ 1 := fa_le_one hm0 hm0u
  have hne : ∀ S, m0 S ≠ ⊤ := fun S => ne_top_of_le_ne_top ENNReal.one_ne_top (hle S)
  let F : Set X → J → ℝ := fun S h => (m0 (act h⁻¹ '' S)).toReal
  have hF : ∀ S (a b : J), a⁻¹ * b ∈ N → F S a = F S b := by
    intro S a b hab
    simp only [F]
    have : b⁻¹ = (a⁻¹ * b)⁻¹ * a⁻¹ := by group
    rw [this, ← img_img act hmul, hN _ (inv_mem hab)]
  let FQ : Set X → J ⧸ N → ℝ := fun S q =>
    Quotient.liftOn' q (F S) (fun a b hab => hF S a b (QuotientGroup.leftRel_apply.1 hab))
  have hFQ : ∀ S (h : J), FQ S (h : J ⧸ N) = F S h := fun _ _ => rfl
  have hbd : ∀ S q, ‖FQ S q‖ ≤ 1 := by
    intro S q
    induction q using QuotientGroup.induction_on with
    | H h =>
      rw [hFQ, Real.norm_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
      simpa using ENNReal.toReal_mono ENNReal.one_ne_top (hle _)
  let vec : Set X → lp (fun _ : J ⧸ N => ℝ) ⊤ := fun S =>
    ⟨FQ S, memℓp_infty_iff.2 ⟨1, by rintro _ ⟨q, rfl⟩; exact hbd S q⟩⟩
  have hvec : ∀ S (h : J), (vec S : J ⧸ N → ℝ) (h : J ⧸ N) = F S h := fun _ _ => rfl
  have hνnn : ∀ S, 0 ≤ ν (vec S) := fun S => hνpos _ (fun q => by
    induction q using QuotientGroup.induction_on with
    | H h => rw [hvec]; exact ENNReal.toReal_nonneg)
  refine ⟨fun S => ENNReal.ofReal (ν (vec S)), ⟨?_, ?_⟩, ?_, ?_, ?_⟩
  · -- empty set
    have : vec ∅ = 0 := by
      apply lp.ext; funext q
      induction q using QuotientGroup.induction_on with
      | H h => rw [hvec]; simp [F, hm0.1]
    simp only [this, map_zero, ENNReal.ofReal_zero]
  · -- additivity
    intro S T hST
    have : vec (S ∪ T) = vec S + vec T := by
      apply lp.ext; funext q
      induction q using QuotientGroup.induction_on with
      | H h =>
        rw [lp.coeFn_add, Pi.add_apply, hvec, hvec, hvec]
        simp only [F]
        rw [image_union, hm0.2 _ _ ((disjoint_image_iff (act_inj act hmul hone _)).2 hST),
          ENNReal.toReal_add (hne _) (hne _)]
    simp only [this, map_add]
    exact ENNReal.ofReal_add (hνnn S) (hνnn T)
  · -- normalization
    have : ν (vec univ) = 1 := hνone _ (fun q => by
      induction q using QuotientGroup.induction_on with
      | H h => rw [hvec]; simp [F, img_univ act hmul hone, hm0u])
    simp [this]
  · -- invariance
    intro g S
    have : vec (act g '' S) = Garrido.lshift (g : J ⧸ N) (vec S) := by
      apply lp.ext; funext q
      induction q using QuotientGroup.induction_on with
      | H h =>
        rw [hvec]
        show F (act g '' S) h = (vec S : J ⧸ N → ℝ) ((g : J ⧸ N)⁻¹ * (h : J ⧸ N))
        rw [← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul, hvec]
        simp only [F]
        rw [img_img act hmul, mul_inv_rev, inv_inv]
    show ENNReal.ofReal (ν (vec (act g '' S))) = ENNReal.ofReal (ν (vec S))
    rw [this, hνinv]
  · -- invariant sets
    intro S hS
    have : vec S = (m0 S).toReal • vec univ := by
      apply lp.ext; funext q
      induction q using QuotientGroup.induction_on with
      | H h =>
        rw [lp.coeFn_smul, Pi.smul_apply, hvec, hvec]
        simp [F, hS, img_univ act hmul hone, hm0u]
    have h1 : ν (vec univ) = 1 := hνone _ (fun q => by
      induction q using QuotientGroup.induction_on with
      | H h => rw [hvec]; simp [F, img_univ act hmul hone, hm0u])
    show ENNReal.ofReal (ν (vec S)) = m0 S
    rw [this, map_smul, h1, smul_eq_mul, mul_one, ENNReal.ofReal_toReal (hne S)]

end average

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

/-- `J / J''` is metabelian, hence amenable (Garrido), hence has an invariant mean. -/
lemma hasInvariantMean_quot_derived2 (J : Type*) [Group J] :
    Garrido.HasInvariantMean (J ⧸ derivedSeries J 2) := by
  have hsolv : Group.IsSolvable (J ⧸ derivedSeries J 2) := by
    rw [Group.isSolvable_def]
    refine ⟨2, ?_⟩
    rw [← map_derivedSeries_eq (QuotientGroup.mk'_surjective (derivedSeries J 2)) 2]
    exact QuotientGroup.map_mk'_self _
  have ham : Garrido.IsAmenable (J ⧸ derivedSeries J 2) :=
    Garrido.isAmenable_of_isSolvable_of_finiteIndex (⊤ : Subgroup (J ⧸ derivedSeries J 2))
      inferInstance
  exact ((Garrido.isAmenable_tfae (J ⧸ derivedSeries J 2)).out 0 1).mp ham

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

theorem fixSubgroup_eq_bot_or_isCoamenable' (A : Subring ℝ) (E : Set (OnePoint ℝ)) :
    (Dense E → fixSubgroup (H A) E = ⊥) ∧ (¬ Dense E → IsCoamenable (fixSubgroup (H A) E)) := by
  constructor
  · intro hE
    rw [eq_bot_iff]
    intro h hh
    rw [Subgroup.mem_bot]
    have : ⇑(h : OnePoint ℝ ≃ₜ OnePoint ℝ) = id :=
      Continuous.ext_on hE (h : OnePoint ℝ ≃ₜ OnePoint ℝ).continuous continuous_id
        (fun x hx => hh x hx)
    apply Subtype.ext
    apply Homeomorph.ext
    intro x
    exact congrFun this x
  · intro hE
    classical
    set J := H A
    set K := fixSubgroup J E
    -- a real point outside the closure of `E`
    have hcl : closure E ≠ univ := fun h => hE (dense_iff_closure_eq.2 h)
    obtain ⟨p, hp⟩ : ∃ p : ℝ, (p : OnePoint ℝ) ∉ closure E := by
      have hne : ((closure E)ᶜ).Nonempty := by rw [nonempty_compl]; exact hcl
      obtain ⟨_, hx, ⟨p, rfl⟩⟩ := (denseRange_coe (X := ℝ)).inter_open_nonempty _
        isClosed_closure.isOpen_compl hne
      exact ⟨p, hx⟩
    obtain ⟨g, hg⟩ := exists_tendsto_infty_H_bot' p
    let g' : ℕ → J := fun n => ⟨g n, H_mono bot_le (g n).2⟩
    let x : ℕ → J ⧸ K := fun n => ((g' n : J) : J ⧸ K)
    let U : Ultrafilter ℕ := Filter.hyperfilter ℕ
    have hU : (U : Filter ℕ) ≤ atTop := by
      rw [← Nat.cofinite_eq_atTop]; exact Filter.hyperfilter_le_cofinite
    let act : J → J ⧸ K → J ⧸ K := fun a y => a • y
    have hmul : ∀ a b y, act (a * b) y = act a (act b y) := fun a b y => mul_smul a b y
    have hone : ∀ y, act 1 y = y := fun y => one_smul J y
    have hN : ∀ w ∈ derivedSeries J 2, ∀ S, pm U x (act w '' S) = pm U x S := by
      intro w hw S
      have hV := derived2_trivial hw
      have hev := hg (closure E) isClosed_closure.isCompact hp _ hV
      have hfix : ∀ᶠ n in (U : Filter ℕ), act w (x n) = x n := by
        filter_upwards [hU hev] with n hn
        show ((w * g' n : J) : J ⧸ K) = ((g' n : J) : J ⧸ K)
        rw [QuotientGroup.eq]
        intro y hy
        have h1 : (w : OnePoint ℝ ≃ₜ OnePoint ℝ) ((g n : OnePoint ℝ ≃ₜ OnePoint ℝ) y) =
            (g n : OnePoint ℝ ≃ₜ OnePoint ℝ) y := hn y (subset_closure hy)
        show ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) * (g n : OnePoint ℝ ≃ₜ OnePoint ℝ)).symm
          ((g n : OnePoint ℝ ≃ₜ OnePoint ℝ) y) = y
        rw [← h1]
        exact ((w : OnePoint ℝ ≃ₜ OnePoint ℝ) * (g n : OnePoint ℝ ≃ₜ OnePoint ℝ)).symm_apply_apply y
      apply pm_congr
      filter_upwards [hfix] with n hn
      constructor
      · rintro ⟨s, hs, hse⟩
        have : s = x n := by
          have := congrArg (act w⁻¹) hse
          rwa [← hmul, inv_mul_cancel, hone, ← hn, ← hmul, inv_mul_cancel, hone] at this
        rwa [← this]
      · intro h
        exact ⟨x n, h, hn⟩
    obtain ⟨m, hm, hmu, hminv, -⟩ := average act hmul hone (derivedSeries J 2)
      (hasInvariantMean_quot_derived2 J) (pm U x) (pm_fa U x) (pm_univ U x) hN
    refine ⟨m, hm, hmu, fun a s => ?_⟩
    rw [← Set.image_smul]
    exact hminv a s

end Monod.Dev.Dyn
end

