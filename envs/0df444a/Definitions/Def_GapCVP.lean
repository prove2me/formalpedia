  have hallowed' := hallowed
  simp only [AcceptanceAnchoredPhaseAllowed, decide_eq_true_eq] at hallowed'
  exact ⟨hallowed'.1, hallowed'.2.1,
    fun _ haccept => hallowed'.2.2 haccept⟩
