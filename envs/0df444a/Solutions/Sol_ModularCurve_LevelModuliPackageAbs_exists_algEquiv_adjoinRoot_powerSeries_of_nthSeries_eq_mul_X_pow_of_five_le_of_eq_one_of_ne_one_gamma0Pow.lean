  have hxkc : (((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve).map resR = xk.curve := by
    obtain ⟨hcι, -⟩ := h𝒯.2 P₀.B₀ R ι x.level.2.2
    rw [x.isLevel.2.2.1] at hcι
    show ((𝒯.map ι x.level.2.2).curve).map resR = x.curve.map ρ.toRingHom
    rw [hcι]
