    (seed : ExactRemainingSeed D)
    (outcome outcome' : ExactOutcome X Y A B n)
    (same_context :
      exactReverseAliceMarkedHistoryContext
          G n S D default seed outcome =
        exactReverseAliceMarkedHistoryContext
          G n S D default seed outcome') :
    outcome.1 seed.coordinate.val =
        outcome'.1 seed.coordinate.val ∧
