    (hWl : (fermatW q (ftlV q U) (chirpL q)).length = T)
    (hWb : GB Q (fermatW q (ftlV q U) (chirpL q))) (hCb : GB m (convL q (ftlV q U) (chirpL q)))
    (hmQ : 2 * m + 1 ≤ Q) (hk : q.p + q.logT + 1 ≤ Q) (hNQ : zsz ((2 * T : ℕ) : ℤ) ≤ Q) :
