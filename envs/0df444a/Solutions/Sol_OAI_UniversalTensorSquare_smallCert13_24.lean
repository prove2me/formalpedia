def chIdx : EdgeChoices → Option ℕ
  | .node i _ => some i
  | .fallback => none

def chNext : EdgeChoices → (ℕ × ℕ × ℕ) → EdgeChoices
  | .node _ n, v => n v
  | .fallback, _ => .fallback

theorem solveChoices_step {rsT rsA rsB : List ℕ} (ch : EdgeChoices) (i : ℕ) (D : CompactDomains rsT) (E : CompactDomains rsA)
    (F : CompactDomains rsB) (edges : List (Edge rsT rsA rsB)) (flag : Finset (ℕ × ℕ × ℕ))
    (c : Edge rsT rsA rsB) (cs : List (Edge rsT rsA rsB))
    (hch : chIdx ch = some i)
    (hv : (D.vanished || E.vanished || F.vanished) = false)
    (ho : edges.rotate i = c :: cs) :
    solveChoices ch D E F edges flag = ∑ v ∈ compactEdgeOptions D E F c flag,
      solveChoices (chNext ch v) (D.atValue c.1 v.1) (E.atValue c.2.1 v.2.1) (F.atValue c.2.2 v.2.2) cs flag := by
  cases ch with
  | fallback => simp [chIdx] at hch
  | node j n =>
    simp only [chIdx, Option.some.injEq] at hch
    subst hch
    rw [solveChoices]; simp only [hv, ho]; rfl

