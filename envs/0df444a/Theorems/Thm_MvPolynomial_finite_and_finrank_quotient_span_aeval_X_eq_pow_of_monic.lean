-- title:
--   Dimension of k[Xᵢ]/(f(Xᵢ)) for monic f
-- statement:
--   Let $k$ be a field, let $\iota$ be a finite type, and let $f \in k[T]$ be a monic polynomial. Inside the polynomial ring $\mathrm{MvPolynomial}\ \iota\ k = k[X_i : i \in \iota]$ consider the ideal generated by the set of elements obtained by evaluating $f$ at the variables, i.e. by $\{f(X_i) : i \in \iota\}$, where $f(X_i)$ denotes the image of $f$ under the $k$-algebra map $\mathrm{Polynomial.aeval}$ sending $T \mapsto X_i$. The assertion is the conjunction of two statements about the quotient algebra $A = k[X_i : i \in \iota]/(f(X_i) : i \in \iota)$: first, that $A$ is a finite $k$-module, i.e. a finite-dimensional $k$-vector space; and second, that its $k$-dimension, in the sense of `Module.finrank`, equals $(\deg f)^{\,\lvert\iota\rvert}$, where $\deg f$ is `Polynomial.natDegree` of $f$ and $\lvert\iota\rvert$ is `Nat.card ι`. Both the type $\iota$ and the field $k$ may live in arbitrary universes. Note that the degenerate cases are included: if $f = 1$ and $\iota$ is non-empty the quotient is the zero ring, of dimension $0 = 0^{\lvert\iota\rvert}$, and for $\iota$ empty both sides equal $1$.
--
--   This is the standard computation that adjoining to $k$ a root of a fixed monic polynomial $f$ once for each index $i \in \iota$ produces an algebra free of rank $(\deg f)^{\lvert\iota\rvert}$, the $\lvert\iota\rvert$-fold tensor power of $k[T]/(f)$. It is used in the deformation-theoretic part of the development, in the analysis of Witt vector kernels, where the relevant $f$ is of the form $T^{q} - T$-type and finiteness of the corresponding quotient algebra is needed.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPolynomial_finite_and_finrank_quotient_span_aeval_X_eq_pow_of_monic.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u v

theorem MvPolynomial.finite_and_finrank_quotient_span_aeval_X_eq_pow_of_monic
    (k : Type u) [Field k] (ι : Type v) [Finite ι] (f : Polynomial k) (hf : f.Monic) :
    Module.Finite k (MvPolynomial ι k ⧸
        Ideal.span (Set.range fun i : ι => Polynomial.aeval (MvPolynomial.X i : MvPolynomial ι k) f)) ∧
      Module.finrank k (MvPolynomial ι k ⧸
        Ideal.span (Set.range fun i : ι => Polynomial.aeval (MvPolynomial.X i : MvPolynomial ι k) f)) =
        f.natDegree ^ Nat.card ι := by sorry
