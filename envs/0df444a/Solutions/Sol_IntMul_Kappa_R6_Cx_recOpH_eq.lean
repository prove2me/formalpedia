-- Source module: Solutions.R6CxRec
/-!
# R2: the recursive C-layer through a `Prop8IfaceH` network on any number of axes

`recOpH J e : Op (Fin e)` computes `C^{⊗e}` on `e` selected bits:

* if `0 < m ≤ e`: write `e = m f + r` (`f = e / m`, `r = e % m`) and split the axes as
  `Fin e ≃ (Fin m × Fin f) ⊕ Fin r` (`axSplit`). On the first block run one invocation of the
  network `J` with columns `Fin f`; a child `child w S neg` runs `recOpH J (|S| f)` on the bits
  `S × Fin f` (embedded through `Fin (|S| f) ≃ S × Fin f`), which is a strictly smaller
  instance since `|S| < m`. The parent result is read off the data role `inl 0`. The `r`
  leftover axes get their individual kernels (25) (`leafOp`).
* otherwise (`e < m`): the individual kernels (`leafOp e`).

`recOpH_eq`: `recOpH J e = tens Cm` for every `e` (strong induction on `e`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

/-! ## Reindexing and sum-type tensor products -/

section Reindex

variable {α β ι : Type} [Fintype α] [Fintype β] [Fintype ι] [DecidableEq α] [DecidableEq β]
  [DecidableEq ι]

theorem reindex_opSum_tens (φ : ι ≃ α ⊕ β) (A : M2) :
    reindexOp φ (opSum (tens A : Op α) (tens A : Op β)) = (tens A : Op ι) := by
  ext x y
  simp only [reindexOp, opSum, tens, tensF, Function.comp_apply]
  rw [← Fintype.prod_sum_type (fun s => A (x (φ.symm s)) (y (φ.symm s)))]
  exact Fintype.prod_equiv φ.symm _ _ (fun s => rfl)

end Reindex

lemma blockFam_prod {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] (S : Finset (Fin m)) (A : M2) :
    blockFam (S ×ˢ (univ : Finset κ)) A = setFam (κ := κ) S A := by
  funext p; simp [blockFam, setFam, Finset.mem_product]

lemma blk_dataCorrect {W T m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
    {N : ROp (Fin W ⊕ Fin T) m κ} (hN : DataCorrect N) (w : Fin W) :
    blk N (Sum.inl w) = tens Cm := by
  ext x y; rw [blk, hN w w x y, if_pos rfl]

/-! ## The recursion -/

variable {W T m : ℕ} {h : List (ℕ × ℕ)} [NeZero W]

lemma recOpH_node (J : Prop8IfaceH W T m h) {e : ℕ} (hme : 0 < m ∧ m ≤ e) :
    recOpH J e = reindexOp (axSplit m e)
      (opSum (blk (denListH (chRec J e) J.net) (Sum.inl 0)) (leafOp (e % m))) := by
  rw [recOpH, dif_pos hme]
  rfl

lemma recOpH_leaf (J : Prop8IfaceH W T m h) {e : ℕ} (hme : ¬ (0 < m ∧ m ≤ e)) :
    recOpH J e = leafOp e := by
  rw [recOpH, dif_neg hme]

/-- **Correctness of the recursion**: `recOpH J e = C^{⊗e}` for every number of axes `e`. -/
theorem recOpH_eq_sol_aux (J : Prop8IfaceH W T m h) : ∀ e, recOpH J e = tens Cm := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  by_cases hme : 0 < m ∧ m ≤ e
  · have hch : chRec J e = chEx (κ := Fin (e / m)) := by
      funext S
      unfold chRec chEx
      split_ifs with hS
      · rw [ih _ (child_lt hme hS), embed_tens, blockFam_prod]
      · rw [leafOp_eq, embed_tens, blockFam_prod]
    rw [recOpH_node J hme, hch, blk_dataCorrect (J.correct _), leafOp_eq, reindex_opSum_tens]
  · rw [recOpH_leaf J hme, leafOp_eq]

end IntMul.Kappa.R6.Cx

end

