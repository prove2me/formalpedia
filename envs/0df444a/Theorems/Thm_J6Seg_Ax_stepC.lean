variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA dF : Fin HS}
  {ρ : Fin 19 → Fin HS} {eF eB eUp eDn e pM : Fin Pp}
  {P : Prm} {ap : AxPlan6} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} {C₀ Cp Cc : ℝ}

theorem J6Seg.Ax.stepC (hMul : MulOK Isym tbl pM NLogN.KFUU.MS) (hK : tbl e = KR.chunkI2 pM)
    (hFine : FineBody6 Isym tbl eF eB dF C₀) (hC0 : 0 ≤ C₀) (hR : RegOK ρ KR.dT dF)
    (hρA : ∀ i, ρ i ≠ dA) (hA0 : dA ≠ 0) (hTA : KR.dT ≠ dA)
    (hS : SetupBody6 Isym tbl eUp eDn ρ dA (descAx6 P n src D k) (chunkRegs6 P n src D k ap.pl) Cp)
    (hReg : AxReg P n src D k) (hTab : TabAt P n src k) (hgC : ChunkOutAt P ap n src k)
    (hBud : AxBudgetAt P ap n src D k Cc) :
    PassOK Isym tbl (kpSt eUp eDn ρ KR.dT dF eF eB e) dA (descAx6 P n src D k)
      (fun L => L.length = axpre6 P n D k * axnc6 P n k * (2 ^ axfC6 P n * axpost6 P n D k) ∧
        GB (axwd6 P n src k ap) L ∧ ∀ b < axpre6 P n D k * axnc6 P n k, ∀ c < axpost6 P n D k,
          (lineAt (2 ^ axfC6 P n) (axpost6 P n D k) L b c).length = axl6 P n ∧
          KR.AB (axX6 P n src k ap) (lineAt (2 ^ axfC6 P n) (axpost6 P n D k) L b c))
      (gY6 P n src D k) (2 * Cp + (2 * C₀ * Cc + Cc)) := by sorry
