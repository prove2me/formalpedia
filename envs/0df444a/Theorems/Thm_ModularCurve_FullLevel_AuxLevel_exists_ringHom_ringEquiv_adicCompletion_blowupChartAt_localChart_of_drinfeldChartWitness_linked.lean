          (∀ (x : ↥K) (hx : x ∈ Ba) (i : ↥(chartAlgFin A (↥K) j)), i ∈ J → x * ((a : ↥(chartAlgFin A (↥K) j)) : ↥K) = ((i : ↥(chartAlgFin A (↥K) j)) : ↥K) →
