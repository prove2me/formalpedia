open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable {M a Q : ℝ} {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
  {W : Set (ℝ × Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}
local notation "gK" => gKN M a Q
local notation "giK" => giKN M a Q
local notation "EK" => knE M a Q
local notation "ΘK" => knTh M a Q
theorem solution (hK : KNFam M a Q g gi F E Θ W) (ht : NPTangent g F E W h f B) {x : Pt 4}
    (hx0 : ((0 : ℝ), x) ∈ W) :
    fdir EK 1 (psi0Var gK giK h EK B) x - fdir EK 2 (psi1Var gK giK h EK B) x
        + (1/2) * fdir EK 0 (ricFVar gK giK h EK B 2 2) x - (1/2) * fdir EK 2 (ricFVar gK giK h EK B 0 2) x
      = (-2 * npBeta gK giK EK ΘK x - 4 * npTau gK giK EK ΘK x) * psi1Var gK giK h EK B x
        + (4 * npGamma gK giK EK ΘK x - npMu gK giK EK ΘK x) * psi0Var gK giK h EK B x
        + (3 * psi2 gK giK EK x + (1/2) * ricF gK giK EK 0 1 x + (1/2) * ricF gK giK EK 2 3 x)
          * sigmaVar gK h EK B x
        + (npPiB gK giK EK ΘK x - npBeta gK giK EK ΘK x) * ricFVar gK giK h EK B 0 2 x
        + (1/2) * npRhoB gK giK EK ΘK x * ricFVar gK giK h EK B 2 2 x := by
  have hF := hK.fam
  have hx := hK.slice x hx0
  have f1 := hK.hasDerivAt_fdir_zero ht hx0 1 hF.j_psi0 (fun y hy => NPFamily.hasDerivAt_psi0 hF ht hy)
    (fun y hy => by simp only [hK.g0, hK.gi0, hK.E0, hK.Θ0]; exact psi0_KN hy)
  have f2 := hK.hasDerivAt_fdir_zero ht hx0 2 hF.j_psi1 (fun y hy => NPFamily.hasDerivAt_psi1 hF ht hy)
    (fun y hy => by simp only [hK.g0, hK.gi0, hK.E0, hK.Θ0]; exact psi1_KN hy)
  have f3 := hK.hasDerivAt_fdir_zero ht hx0 0 (hF.j_ricF 2 2) (fun y hy => NPFamily.hasDerivAt_ricF hF ht hy 2 2)
    (fun y hy => by simp only [hK.g0, hK.gi0, hK.E0, hK.Θ0]; exact (ricF_KN_zero hy).2.2.2.1)
  have f4 := hK.hasDerivAt_fdir_zero ht hx0 2 (hF.j_ricF 0 2) (fun y hy => NPFamily.hasDerivAt_ricF hF ht hy 0 2)
    (fun y hy => by simp only [hK.g0, hK.gi0, hK.E0, hK.Θ0]; exact (ricF_KN_zero hy).2.1)
  simp only [hK.g0, hK.gi0, hK.E0] at f1 f2 f3 f4
  have hL : HasDerivAt (fun ε => (1) * fdir (E ε) 1 (psi0 (g ε) (gi ε) (E ε)) x + (-1) * fdir (E ε) 2 (psi1 (g ε) (gi ε) (E ε)) x
      + (1/2) * fdir (E ε) 0 (ricF (g ε) (gi ε) (E ε) 2 2) x + (-1/2) * fdir (E ε) 2 (ricF (g ε) (gi ε) (E ε) 0 2) x)
      (fdir EK 1 (psi0Var gK giK h EK B) x - fdir EK 2 (psi1Var gK giK h EK B) x
        + (1/2) * fdir EK 0 (ricFVar gK giK h EK B 2 2) x - (1/2) * fdir EK 2 (ricFVar gK giK h EK B 0 2) x) 0 := by
    apply HasDerivAt.congr_deriv
    · ( repeat' (first
  | with_reducible exact hd_const _
  | with_reducible apply hd_add | with_reducible apply hd_sub | with_reducible apply hd_mul
  | with_reducible apply hd_neg | with_reducible apply hd_div_const))
      ( all_goals first
  | with_reducible assumption
  | with_reducible exact NPFamily.hasDerivAt_omL hF ht hx0 _ _ _
  | with_reducible exact NPFamily.hasDerivAt_psi0 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi1 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi3 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi4 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi2' hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_ricF hF ht hx0 _ _
  | with_reducible exact NPFamily.hasDerivAt_FfrF hF ht hx0 _ _)
    · ring
  have hR : HasDerivAt (fun ε =>
      (-2) * psi1 (g ε) (gi ε) (E ε) x * npBeta (g ε) (gi ε) (E ε) (Θ ε) x +
        (-4) * psi1 (g ε) (gi ε) (E ε) x * npTau (g ε) (gi ε) (E ε) (Θ ε) x +
        (4) * psi0 (g ε) (gi ε) (E ε) x * npGamma (g ε) (gi ε) (E ε) (Θ ε) x +
        (-1) * psi0 (g ε) (gi ε) (E ε) x * npMu (g ε) (gi ε) (E ε) (Θ ε) x +
        (3) * psi2 (g ε) (gi ε) (E ε) x * npSigma (g ε) (gi ε) (E ε) (Θ ε) x +
        (-1) * npBeta (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 0 2 x +
        (1) * npEps (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 2 2 x +
        (-1) * npEpsB (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 2 2 x +
        (-1) * npKappa (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 1 2 x +
        (-1/2) * npLambdaB (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 0 0 x +
        (1) * npPiB (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 0 2 x +
        (1/2) * npRhoB (g ε) (gi ε) (E ε) (Θ ε) x * ricF (g ε) (gi ε) (E ε) 2 2 x +
        (1/2) * ricF (g ε) (gi ε) (E ε) 0 1 x * npSigma (g ε) (gi ε) (E ε) (Θ ε) x +
        (1/2) * ricF (g ε) (gi ε) (E ε) 2 3 x * npSigma (g ε) (gi ε) (E ε) (Θ ε) x)
      ((-2 * npBeta gK giK EK ΘK x - 4 * npTau gK giK EK ΘK x) * psi1Var gK giK h EK B x
        + (4 * npGamma gK giK EK ΘK x - npMu gK giK EK ΘK x) * psi0Var gK giK h EK B x
        + (3 * psi2 gK giK EK x + (1/2) * ricF gK giK EK 0 1 x + (1/2) * ricF gK giK EK 2 3 x)
          * sigmaVar gK h EK B x
        + (npPiB gK giK EK ΘK x - npBeta gK giK EK ΘK x) * ricFVar gK giK h EK B 0 2 x
        + (1/2) * npRhoB gK giK EK ΘK x * ricFVar gK giK h EK B 2 2 x) 0 := by
    apply HasDerivAt.congr_deriv
    · simp only [npBeta, npEps, npEpsB, npGamma, npKappa, npLambdaB, npMu, npPiB, npRhoB, npSigma, npTau]
      ( repeat' (first
  | with_reducible exact hd_const _
  | with_reducible apply hd_add | with_reducible apply hd_sub | with_reducible apply hd_mul
  | with_reducible apply hd_neg | with_reducible apply hd_div_const))
      ( all_goals first
  | with_reducible assumption
  | with_reducible exact NPFamily.hasDerivAt_omL hF ht hx0 _ _ _
  | with_reducible exact NPFamily.hasDerivAt_psi0 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi1 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi3 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi4 hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_psi2' hF ht hx0
  | with_reducible exact NPFamily.hasDerivAt_ricF hF ht hx0 _ _
  | with_reducible exact NPFamily.hasDerivAt_FfrF hF ht hx0 _ _)
    · obtain ⟨r00, r02, r03, r22, r11, r13, r33, r12⟩ := ricF_KN_zero hx
      simp only [hK.g0, hK.gi0, hK.E0, hK.Θ0, psi0_KN hx, psi1_KN hx, psi3_KN hx, psi4_KN hx, r00, r02, r03, r22,
        r11, r13, r33, r12, kappaVar, sigmaVar, nuVar, lambdaVar, npBeta, npEps, npEpsB, npGamma, npKappa, npLambdaB, npMu, npPiB, npRhoB, npSigma, npTau]
      ( (
  have hN := nullFrameData_KN M a Q
  obtain ⟨o001, o002, o003, o102, o103, o203⟩ := omL_KN_l hx
  obtain ⟨o011, o012, o013, o112, o113, o213⟩ := omL_KN_n hx
  obtain ⟨o021, o022, o023, o122, o123, o223⟩ := omL_KN_m hx
  obtain ⟨o031, o032, o033, o132, o133, o233⟩ := omL_KN_mbar hx
  have p001 := omL_rev hN hx o001; have p002 := omL_rev hN hx o002; have p003 := omL_rev hN hx o003
  have p102 := omL_rev hN hx o102; have p103 := omL_rev hN hx o103; have p203 := omL_rev hN hx o203
  have p011 := omL_rev hN hx o011; have p012 := omL_rev hN hx o012; have p013 := omL_rev hN hx o013
  have p112 := omL_rev hN hx o112; have p113 := omL_rev hN hx o113; have p213 := omL_rev hN hx o213
  have p021 := omL_rev hN hx o021; have p022 := omL_rev hN hx o022; have p023 := omL_rev hN hx o023
  have p122 := omL_rev hN hx o122; have p123 := omL_rev hN hx o123; have p223 := omL_rev hN hx o223
  have p031 := omL_rev hN hx o031; have p032 := omL_rev hN hx o032; have p033 := omL_rev hN hx o033
  have p132 := omL_rev hN hx o132; have p133 := omL_rev hN hx o133; have p233 := omL_rev hN hx o233
  have odg : ∀ C A, omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q) C A C x = 0 :=
    fun C A => omL_diag hN hx C A))
      ( (
  simp only [odg, o001, o002, o003, o102, o103, o203, o011, o012, o013, o112, o113, o213, o021, o022, o023,
    o122, o123, o223, o031, o032, o033, o132, o133, o233, p001, p002, p003, p102, p103, p203, p011, p012, p013,
    p112, p113, p213, p021, p022, p023, p122, p123, p223, p031, p032, p033, p132, p133, p233]
  try (clear o001 o002 o003 o102 o103 o203 o011 o012 o013 o112 o113 o213 o021 o022 o023 o122 o123 o223 o031
          o032 o033 o132 o133 o233 p001 p002 p003 p102 p103 p203 p011 p012 p013 p112 p113 p213 p021 p022 p023
          p122 p123 p223 p031 p032 p033 p132 p133 p233 odg hN)))
      ring
  exact eq_of_hasDerivAt_slice hF.isOpen hx0 hL hR fun ε hε => np_bianchi_b (hF.null ε) hε
