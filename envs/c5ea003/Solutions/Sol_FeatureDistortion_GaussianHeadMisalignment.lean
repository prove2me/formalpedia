theorem OODRiskIdentity :
    ∀ (d k : ℕ) (D : OODLaw d) (w : Vec d) (v : Vec k) (B : Features d k),
      oodLoss D w v B =
        inner ℝ (weights B v - w) (secondMoment D.measure (weights B v - w)) ∧
      (oodLoss D w v B = 0 ↔ weights B v = w) ∧
      (0 < oodLoss D w v B ↔ weights B v ≠ w) := by
  intro d k D w v B
  have hmoment : Integrable (fun x : Vec d ↦ InnerProductSpace.rankOne ℝ x x)
      D.measure := by
    apply D.finiteSecondMoment.mono'
      ((InnerProductSpace.rankOne ℝ).continuous.clm_apply continuous_id).aestronglyMeasurable
    filter_upwards [] with x
    change ‖InnerProductSpace.rankOne ℝ x x‖ ≤ ‖x‖ ^ 2
    simp only [InnerProductSpace.norm_rankOne, pow_two, le_refl]
  let e := weights B v - w
  let L : (Vec d →L[ℝ] Vec d) →L[ℝ] ℝ :=
    (innerSL ℝ e).comp (ContinuousLinearMap.apply ℝ (Vec d) e)
  have hid : oodLoss D w v B = inner ℝ e (secondMoment D.measure e) := by
    change (∫ x, (inner ℝ e x) ^ 2 ∂D.measure) =
      inner ℝ e ((∫ x, InnerProductSpace.rankOne ℝ x x ∂D.measure) e)
    have h := L.integral_comp_comm hmoment
    change (∫ x, inner ℝ e (InnerProductSpace.rankOne ℝ x x e) ∂D.measure) =
      inner ℝ e ((∫ x, InnerProductSpace.rankOne ℝ x x ∂D.measure) e) at h
    simpa only [InnerProductSpace.rankOne_apply, real_inner_smul_right,
      real_inner_comm, pow_two] using h
  refine ⟨hid, ?_, ?_⟩
  · constructor
    · intro hzero
      by_contra hne
      have hpos := D.positiveSecondMoment e (sub_ne_zero.mpr hne)
      rw [← hid, hzero] at hpos
      exact (lt_irrefl 0) hpos
    · intro heq
      simp [oodLoss, heq]
  · constructor
    · intro hpos heq
      simp [oodLoss, heq] at hpos
    · intro hne
      rw [hid]
      exact D.positiveSecondMoment e (sub_ne_zero.mpr hne)

theorem GaussianHeadMisalignment :
    ∀ (k : ℕ) (u : Vec k) (σ : ℝ), u ≠ 0 → 0 < σ →
      ∀ᵐ v₀ ∂gaussianHead k σ, 0 < alignmentError v₀ u := by
  intro k u σ hu hσ
  let L : StrongDual ℝ (Vec k) := σ • innerSL ℝ u
  have hnorm : 0 < ‖L‖ := by
    simp only [L, norm_smul, Real.norm_eq_abs, abs_of_pos hσ, innerSL_apply_norm]
    exact mul_pos hσ (norm_pos_iff.mpr hu)
  haveI : NoAtoms ((stdGaussian (Vec k)).map L) := by
    rw [IsGaussian.map_eq_gaussianReal, variance_dual_stdGaussian]
    exact noAtoms_gaussianReal (ne_of_gt (Real.toNNReal_pos.mpr (sq_pos_of_pos hnorm)))
  have hplus := ae_of_ae_map L.continuous.aemeasurable
    (((stdGaussian (Vec k)).map L).ae_ne (inner ℝ u u))
  have hminus := ae_of_ae_map L.continuous.aemeasurable
    (((stdGaussian (Vec k)).map L).ae_ne (-inner ℝ u u))
  have hcont : Continuous (fun v₀ : Vec k ↦ alignmentError v₀ u) := by
    unfold alignmentError
    fun_prop
  unfold gaussianHead
  apply (ae_map_iff (by fun_prop) (isOpen_lt continuous_const hcont).measurableSet).2
  filter_upwards [hplus, hminus] with z hzplus hzminus
  have hLz : L z = inner ℝ (σ • z) u := by
    simp [L, real_inner_smul_right, real_inner_comm]
  unfold alignmentError
  apply abs_pos.mpr
  apply sub_ne_zero.mpr
  intro heq
  rcases sq_eq_sq_iff_eq_or_eq_neg.mp heq with h | h
  · exact hzplus (hLz.trans h)
  · exact hzminus (hLz.trans h)

