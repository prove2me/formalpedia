variable {R : Type} [CommRing R] {X Y : Type} [AddCommGroup X] [AddCommGroup Y]
variable {I J : Type} [Fintype I] [Fintype J]

theorem GlobalTheory.Diag.toMatrix_transpose [DecidableEq I] [DecidableEq J] (b : Module.Basis I ℤ X)
    (b' : Module.Basis J ℤ Y) (u : Y →+ X) :
    LinearMap.toMatrix (dualBasis R b) (dualBasis R b') (transpose R u) =
      ((LinearMap.toMatrix b' b u.toIntLinearMap).map (Int.castRingHom R)).transpose := by sorry
