lemma QFS.closedCube_subset_closedBall {h : ℝ} (_hh : 0 ≤ h) (u : EuclideanSpace ℝ (Fin d)) :
    closedCube h u ⊆ closedBall u (h / 2 * Real.sqrt d) := by sorry
