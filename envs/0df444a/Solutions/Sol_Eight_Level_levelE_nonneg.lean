namespace Eight.Level
theorem _root_.solution (ℓ : ℕ) : 0 ≤ levelE ℓ := by
  induction ℓ with
  | zero => norm_num [levelE]
  | succ ℓ ih =>
    have hK := levelK_pos ℓ
    have hρ := rho_pos
    simp only [levelE]
    positivity
end Eight.Level
