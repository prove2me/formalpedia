variable {R : Type*} [CommRing R]
theorem solution (q : R) :
    mbiLHSTrunc q 2 =
      (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2 := by
  rw [mbiLHSTrunc, natSum_succ, natSum_succ, natSum_zero]
  change (Ch01.partitionCount 4 : R) * q ^ 0 +
      (Ch01.partitionCount 9 : R) * q ^ 1 +
      (Ch01.partitionCount 14 : R) * q ^ 2 =
    (5 : R) + (30 : R) * q + (Ch01.partitionCount 14 : R) * q ^ 2
  rw [pow_zero, pow_one, mul_one, Ch01.partitionCount_four, Ch01.partitionCount_nine]
  simp only [Nat.cast_ofNat]
