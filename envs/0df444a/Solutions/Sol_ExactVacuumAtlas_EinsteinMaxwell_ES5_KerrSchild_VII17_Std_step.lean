  exact ⟨G, hG.of_le (by exact_mod_cast Nat.le_succ k), hGf, hv⟩
theorem ExtV.add (hf : ExtV k f a) (hg : ExtV k g c) : ExtV k (fun x => f x + g x) (a + c) := by
  obtain ⟨F, hF, hFf, rfl⟩ := hf; obtain ⟨G, hG, hGg, rfl⟩ := hg
  exact ⟨fun x => F x + G x, hF.add hG, hFf.add hGg, rfl⟩
theorem ExtV.sub (hf : ExtV k f a) (hg : ExtV k g c) : ExtV k (fun x => f x - g x) (a - c) := by
  obtain ⟨F, hF, hFf, rfl⟩ := hf; obtain ⟨G, hG, hGg, rfl⟩ := hg
  exact ⟨fun x => F x - G x, hF.sub hG, hFf.sub hGg, rfl⟩
theorem ExtV.mul (hf : ExtV k f a) (hg : ExtV k g c) : ExtV k (fun x => f x * g x) (a * c) := by
  obtain ⟨F, hF, hFf, rfl⟩ := hf; obtain ⟨G, hG, hGg, rfl⟩ := hg
  exact ⟨fun x => F x * G x, hF.mul hG, hFf.mul hGg, rfl⟩
theorem ExtV.div (hf : ExtV k f a) (hg : ExtV k g c) (hc : c ≠ 0) :
    ExtV k (fun x => f x / g x) (a / c) := by
  obtain ⟨F, hF, hFf, rfl⟩ := hf; obtain ⟨G, hG, hGg, rfl⟩ := hg
  exact ⟨fun x => F x / G x, hF.div hG hc, hFf.div hGg, rfl⟩

theorem ExtV.const : ExtV k (fun _ => c) c := ⟨fun _ => c, contDiffAt_const, EventuallyEq.rfl, rfl⟩

end Closure

/-- `ExtV` from right limits of derivatives (VII16 glue). -/
theorem extV_of_RL {k : ℕ} {g : ℝ → ℝ} (hg : PS g) (hR : RL k g) {L : ℝ}
    (hL : Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) : ExtV k g L := by
  obtain ⟨δ, hδ, hc⟩ := hg.contDiffOn
  choose! Lf hLf using RL_iter hR
  have hglue := VII16.contDiffOn_glue k hδ (hc.of_le (by exact_mod_cast le_top)) hLf
  refine ⟨VII16.glue Lf k g, hglue.contDiffAt (Ioo_mem_nhds (by linarith) hδ), ?_, ?_⟩
  · filter_upwards [VII16.Ioo_mem_nhdsGT' hδ] with x hx using VII16.glue_of_pos hx.1
  · rw [VII16.glue_zero]
    have h0 := hLf 0 (Nat.zero_le _)
    rw [iteratedDeriv_zero] at h0
    exact tendsto_nhds_unique h0 hL

theorem extV_succ {k : ℕ} {g : ℝ → ℝ} (hg : PS g) (hd : RL k (deriv g)) {L : ℝ}
    (hL : Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) : ExtV (k + 1) g L :=
  extV_of_RL hg (RL_succ.2 ⟨⟨L, hL⟩, hd⟩) hL

