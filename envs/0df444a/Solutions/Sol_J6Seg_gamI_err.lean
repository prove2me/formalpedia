-- Source module: Solutions.J6SegTab
/-!
# Segmented inverse (S2): construction of the constant tables

`mkTables P R s t α` (computable) fills the tables of `J6SegAlg` with
* `di u = expNeg P s (α²(t-s)u²)` (`≈ 2^P e^{-πα²θu²}`),
* `dd u = expPos (P+R) s (α²(t-s)u²) R` (`≈ 2^P e^{πα²θu²}`, needs `e^{πα²θu²} ≤ 2^R`),
* `gam`: `(q;q)_u` by the recurrence `Γ_{u+1} = Γ_u (1 - q^{u+1})` (`q^k` by `expNeg`),
* `gi u = 2^P / Γ_u` (`fdiv`), `ap/am c h = (-1)^h e^{-πα²(σ ± 2β_c)h} / Γ_h`,
* `cpl i h = expNeg P s² (α² K_{i,h})` (the entries of `E`, as in `Eapprox`).

`mkTables_ok`: `TabOK` with `E = 3λ + 3` and `Dm = D_{λ-1}`, for blocks of length `≤ λ`, as soon as
`200 (3λ+1) ≤ 2^P` and `D_{λ-1} ≤ 2^R`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section tab
variable {P R s t α : ℕ}

lemma expNeg_err (hk : 0 < s) (j : ℕ) {x : ℝ} (hx : x = π * j / s) :
    |(expNeg P s j : ℝ) - 2 ^ P * exp (-x)| ≤ 1 := by
  rw [hx]; exact expNeg_bound P s j hk

lemma sigma_ge (hs : 0 < s) (hst : s ≤ t) : 1 ≤ (t : ℝ) / s := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst

lemma qpow_eq (hs : 0 < s) (k : ℕ) :
    qR (α : ℝ) ((t : ℝ) / s) ^ k = exp (-(π * ((2 * α ^ 2 * t * k : ℕ) : ℝ) / s)) := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [qR, ← Real.exp_nat_mul]; congr 1; push_cast; field_simp

lemma qN_err (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) {k : ℕ} (hk : 1 ≤ k) :
    |(qN P s t α k : ℝ) - 2 ^ P * qR (α : ℝ) ((t : ℝ) / s) ^ k| ≤ 1 ∧ (qN P s t α k : ℝ) ≤ 2 ^ P ∧
      0 ≤ (qN P s t α k : ℝ) := by
  have h := expNeg_err (P := P) hs (2 * α ^ 2 * t * k) rfl
  rw [← qpow_eq hs] at h
  have hq0 : 0 ≤ qR (α : ℝ) ((t : ℝ) / s) ^ k := pow_nonneg (qR_pos _ _).le k
  have hql := qR_le (α : ℝ) ((t : ℝ) / s) (by exact_mod_cast hα) (sigma_ge hs hst)
  have hq2 : qR (α : ℝ) ((t : ℝ) / s) ^ k ≤ 1 / 2 ^ 24 :=
    (pow_le_of_le_one (qR_pos _ _).le (by linarith) (by omega)).trans hql
  have hS : (2 : ℝ) ≤ 2 ^ P := by
    have := pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hP; simpa using this
  unfold qN
  push_cast
  rw [abs_le] at h
  refine ⟨?_, ?_, le_max_right _ _⟩
  · rw [abs_le]; constructor
    · have := le_max_left (expNeg P s (2 * α ^ 2 * t * k) : ℝ) 0; linarith
    · rcases le_total (expNeg P s (2 * α ^ 2 * t * k) : ℝ) 0 with h1 | h1
      · rw [max_eq_right h1]; nlinarith
      · rw [max_eq_left h1]; linarith
  · apply max_le _ (by positivity)
    have : 2 ^ P * qR (α : ℝ) ((t : ℝ) / s) ^ k ≤ 2 ^ P * (1 / 2 ^ 24) :=
      mul_le_mul_of_nonneg_left hq2 (by positivity)
    linarith

/-- `|gamI u - 2^P (q;q)_u| ≤ 2u`. -/
theorem gamI_err_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) (u : ℕ) :
    |(gamI P s t α u : ℝ) - 2 ^ P * gamR (α : ℝ) ((t : ℝ) / s) u| ≤ 2 * u := by
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  induction u with
  | zero => simp [gamI, gamR, qpoch]
  | succ u ih =>
    obtain ⟨q1, q2, q3⟩ := qN_err (P := P) hs hst hα hP (k := u + 1) (by omega)
    have hS := two_pow_pos' P
    set g := (gamI P s t α u : ℝ)
    set Γ := gamR (α : ℝ) ((t : ℝ) / s) u
    set F : ℝ := 2 ^ P - (qN P s t α (u + 1) : ℝ)
    set q := qR (α : ℝ) ((t : ℝ) / s)
    have hΓ0 := (gamR_pos hα' hσ u).le
    have hΓ1 := gamR_le_one hα' hσ u
    have hΓs : gamR (α : ℝ) ((t : ℝ) / s) (u + 1) = Γ * (1 - q ^ (u + 1)) := by
      simp only [Γ, gamR, qpoch, prod_range_succ, q]
    have hF0 : 0 ≤ F := by simp only [F]; linarith
    have hF1 : F / 2 ^ P ≤ 1 := by rw [div_le_one hS]; simp only [F]; linarith
    have hr := rs_err P (gamI P s t α u * (2 ^ P - qN P s t α (u + 1)))
    have hdef : gamI P s t α (u + 1) = rs P (gamI P s t α u * (2 ^ P - qN P s t α (u + 1))) := rfl
    rw [hdef, hΓs]
    push_cast at hr ⊢
    rw [show ((gamI P s t α u : ℝ) * (2 ^ P - (qN P s t α (u + 1) : ℝ))) = g * F from rfl] at hr
    have e : g * F / 2 ^ P - 2 ^ P * (Γ * (1 - q ^ (u + 1))) =
        (g - 2 ^ P * Γ) * (F / 2 ^ P) + Γ * (F - 2 ^ P * (1 - q ^ (u + 1))) := by
      field_simp; ring
    have h1 : |(g - 2 ^ P * Γ) * (F / 2 ^ P)| ≤ 2 * u := by
      rw [abs_mul, abs_of_nonneg (div_nonneg hF0 hS.le)]
      exact (mul_le_mul ih hF1 (div_nonneg hF0 hS.le) (by positivity)).trans (by simp)
    have h2 : |Γ * (F - 2 ^ P * (1 - q ^ (u + 1)))| ≤ 1 := by
      rw [abs_mul, abs_of_nonneg hΓ0]
      have : F - 2 ^ P * (1 - q ^ (u + 1)) = -((qN P s t α (u + 1) : ℝ) - 2 ^ P * q ^ (u + 1)) := by
        simp only [F]; ring
      rw [this, abs_neg]
      exact (mul_le_mul hΓ1 q1 (abs_nonneg _) zero_le_one).trans (by simp)
    have := abs_add_le ((g - 2 ^ P * Γ) * (F / 2 ^ P)) (Γ * (F - 2 ^ P * (1 - q ^ (u + 1))))
    have := abs_sub_le ((rs P (gamI P s t α u * (2 ^ P - qN P s t α (u + 1))) : ℝ))
      (g * F / 2 ^ P) (2 ^ P * (Γ * (1 - q ^ (u + 1))))
    rw [e] at this
    push_cast
    linarith

end tab

