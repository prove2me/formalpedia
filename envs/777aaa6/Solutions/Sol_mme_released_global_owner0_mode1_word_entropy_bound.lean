/-- Actual coarse-coordinate pools of released outer words have a
certified total homogeneous entropy lower bound. -/
theorem solution :
    (1619445912 / 1000000000 : ℝ) ≤ (profile 0).words 1 0 := by
  have hx : ∀ j w, 0 ≤ x j w := by decide +kernel
  have hc : (1619445912 / 1000000000 : ℚ) ≤
      ∑ j, (∑ w, x j w) * (-(∑ w, (x j w / ∑ v, x j v) * upper j w)) := by
    decide +kernel
  have h := mme_rational_scaled_mass_entropy_sum_certificate x hx lower upper log_bounds
    1 (by norm_num) (1619445912 / 1000000000) hc
  have hid : ∀ j w, x j w = ∑ s : Fin 45,
      if (shape s).val 1 = j then
        ((alpha 0 s * ((jointRows 0 s).map
          (fun a => if atom a.1 1 = w then a.2 else 0)).sum : ℕ) : ℚ) /
            (denominator : ℚ) ^ 5 else 0 := by
    intro j w
    fin_cases j
    · exact mme_released_global_owner0_mode1_word_mass_row0 w
    · exact mme_released_global_owner0_mode1_word_mass_row1 w
    · exact mme_released_global_owner0_mode1_word_mass_row2 w
    · exact mme_released_global_owner0_mode1_word_mass_row3 w
    · exact mme_released_global_owner0_mode1_word_mass_row4 w
    · exact mme_released_global_owner0_mode1_word_mass_row5 w
    · exact mme_released_global_owner0_mode1_word_mass_row6 w
    · exact mme_released_global_owner0_mode1_word_mass_row7 w
    · exact mme_released_global_owner0_mode1_word_mass_row8 w
  have he (j : Fin 9) (w : Word) : (x j w : ℝ) =
      ∑ c : Shape, if c.val 1 = j then (profile 0).2 1 ⟨0, c⟩ w else 0 := by
    rw [hid, Rat.cast_sum, ← shapeEquiv.sum_comp]
    apply Finset.sum_congr rfl
    intro s hs
    change ((if (shape s).val 1 = j then _ else 0 : ℚ) : ℝ) =
      if (shape s).val 1 = j then (profile 0).2 1 ⟨0, shapeEquiv s⟩ w else 0
    split_ifs with hshape
    · exact (mme_released_global_profile_word_row 0 1 s w).symm
    · simp
  simp only [one_mul] at h
  simp_rw [he] at h
  simpa only [Rat.cast_div, Rat.cast_ofNat, GlobalCW.EntropyProfile.words] using h


