open IntMul NLogN NLogN.KIL Function

/-! ## Specifications -/

section msp
variable {M : MulSpec}

theorem MSp.mono {p : RM} {s t : IState HS} {c c' : ℕ} (h : MSp M p s t c) (hc : c ≤ c') :
    MSp M p s t c' := ⟨h.1, h.2.1, le_trans h.2.2 hc⟩

theorem MSp.congr {p : RM} {s t t' : IState HS} {c : ℕ} (h : MSp M p s t c) (e : t = t') :
    MSp M p s t' c := e ▸ h

theorem MSp.seq {a b : RM} {s t u : IState HS} {c1 c2 : ℕ} (ha : MSp M a s t c1)
    (hb : MSp M b t u c2) : MSp M (.seq a b) s u (c1 + c2) := by
  obtain ⟨ha1, ha2, ha3⟩ := ha
  obtain ⟨hb1, hb2, hb3⟩ := hb
  subst ha2
  refine ⟨⟨ha1, hb1⟩, ?_, ?_⟩
  · simp only [RM.run, hb2]
  · simp only [RM.cost]; omega

theorem MSp.rs {p : RS} {s t : IState HS} {c : ℕ} (h : Sp p s t c) : MSp M (.rs p) s t c :=
  ⟨h.1, h.2.1, h.2.2⟩

theorem MSp.mul {X Φm : ℕ} (hMB : MulBnd M X Φm) {s : IState HS} {F : Fin HS → List ℤ}
    {k i j : Fin HS} (hk : k.val < 55) (hi : i.val < 55) (hj : j.val < 55) {a b : ℤ}
    {li lj : List ℤ} (hFi : F i = a :: li) (hFj : F j = b :: lj) (ha : zsz a ≤ X)
    (hb : zsz b ≤ X) :
    MSp M (.mul k i j) (encK s F) (encK s (update F k (b * a :: F k))) (Φm + 1000 * (X + 2)) := by
  have hti := top_encK (s := s) hFi
  have htj := top_encK (s := s) hFj
  obtain ⟨hd, hΦ⟩ := hMB b a hb ha
  refine ⟨⟨hk, hi, hj, isInt_encK hFi, isInt_encK hFj, by rw [hti, htj]; exact hd⟩, ?_, ?_⟩
  · simp only [RM.run]
    rw [← encK_upd]; congr 1; simp [ints, hti, htj]
  · simp only [RM.cost, RM.mulCost, hti, htj, dupCost, zipCost, moveCost]
    have := zsz_mul_le b a
    omega

end msp

/-! ## The rounding as linear work -/

theorem floorDivE_eval (e d : Ex HS) (t : IState HS) (hd : 0 < d.eval t) :
    (floorDivE e d).eval t = e.eval t / d.eval t := by
  simp only [floorDivE, Ex.eval]
  rw [← ediv_of_tdiv _ _ hd]
  split_ifs with h <;> simp [h]

end J6Seg.JK

