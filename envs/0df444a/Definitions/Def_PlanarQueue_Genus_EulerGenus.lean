-- title:
--   Footnote 2, p. 3 — Euler genus of a graph through embedding schemes (rotation system and edge signature)
-- statement:
--   The paper defines (p. 3, footnote 2): the Euler genus of the orientable surface with $h$ handles is $2h$, that of the non-orientable surface with $c$ cross-caps is $c$, and the **Euler genus** of a graph $G$ is the least $k$ such that $G$ embeds in a surface of Euler genus $k$. This file gives the standard combinatorial form of that notion (Mohar–Thomassen, *Graphs on Surfaces*, §3.3).
--
--   A **dart** of $G$ is an edge with a chosen direction. An **embedding scheme** of $G$ consists of
--
--   1. a **local rotation**: a permutation $\rho$ of the darts that maps each dart leaving a vertex $v$ to another dart leaving $v$, and cycles through all the darts leaving $v$;
--   2. a **signature** $\lambda$, which marks each edge as twisted or untwisted.
--
--   **Face tracing.** A state is a dart $d$ together with an orientation bit $s$. One step traverses $d = (u, w)$; if the edge is twisted the bit flips; at $w$ the walk continues with $\rho(w,u)$ if the bit is now $0$, and with $\rho^{-1}(w,u)$ if it is $1$. The orbits of this step come in pairs (every facial walk is traced once in each direction), and the number of **faces** of the scheme is
--   $$f = \tfrac12\,\#\{\text{orbits}\} + \#\{\text{isolated vertices}\}.$$
--   With $n$ vertices, $m$ edges and $c$ connected components, the **Euler genus of the scheme** is the integer
--   $$\operatorname{eg}(S) = 2c - n + m - f,$$
--   and $G$ **has Euler genus at most $g$** if some embedding scheme $S$ of $G$ has $\operatorname{eg}(S) \le g$.
--
--   This is the hypothesis of Lemma 21 and Theorem 2.
--
--   **Formalization Note** Mathlib has no surfaces of higher genus, so the topological definition of footnote 2 is replaced by this combinatorial one. Their equivalence is the Heffter–Edmonds–Ringel rotation principle and its non-orientable extension (Mohar–Thomassen, Theorems 3.2.4 and 3.3.1), together with additivity of Euler genus over connected components; it is not proved here. The halving of the orbit count is exact, since the orbits pair up. The value is computed in $\mathbb Z$ so that no truncation can hide a negative value. An isolated vertex is a sphere component with one face and contributes $0$. Checked by hand in a sorry-free sanity file: the planar scheme of $K_3$ has $4$ orbits, $2$ faces and Euler genus $0$; the same rotation with one twisted edge has $2$ orbits, $1$ face and Euler genus $1$ (the projective plane); two isolated vertices have Euler genus $0$. Planarity of the paper is a different, published notion (`RobertsonSeymour1986.GM5.IsPlanar`, a plane drawing); "Euler genus $0$ iff planar" is a theorem and is not built into either definition.
-- source:
--   Dujmović, Joret, Micek, Morin, Ueckerdt, Wood, Planar graphs have bounded queue-number, arXiv:1904.04791v5, p. 3, footnote 2 (Euler genus); combinatorial form after Mohar–Thomassen, Graphs on Surfaces (2001), §3.2–§3.3, cited as [87]

import Mathlib

namespace PlanarQueue.Genus

variable {V : Type} [Fintype V] [DecidableEq V]

/-- A general embedding scheme of `G` (Mohar–Thomassen, *Graphs on Surfaces*, §3.3): a local
rotation, which cyclically orders the darts leaving each vertex, together with a signature, which
marks each edge as twisted (`true`) or untwisted (`false`). -/
structure EmbeddingScheme (G : SimpleGraph V) [DecidableRel G.Adj] where
  /-- the local rotation: the next dart around the tail of `d` -/
  rot : Equiv.Perm G.Dart
  rot_fst : ∀ d, (rot d).fst = d.fst
  /-- the rotation at each vertex is a single cycle through all darts leaving it -/
  rot_cyclic : ∀ d d' : G.Dart, d.fst = d'.fst → ∃ n : ℕ, (rot ^ n) d = d'
  /-- the signature of each edge (`true` = twisted) -/
  sig : G.Dart → Bool
  sig_symm : ∀ d, sig d.symm = sig d

namespace EmbeddingScheme

variable {G : SimpleGraph V} [DecidableRel G.Adj]

/-- One step of face tracing (Mohar–Thomassen §3.3): traverse the dart `d` with current local
orientation `s`; a twisted edge flips the orientation; at the head, continue with the
rotation-successor (orientation `false`) or rotation-predecessor (orientation `true`) of the
reversed dart. -/
def faceStep (S : EmbeddingScheme G) : G.Dart × Bool → G.Dart × Bool := fun p =>
  let s' := xor p.2 (S.sig p.1)
  ((if s' then S.rot.symm else S.rot) p.1.symm, s')

/-- The face-tracing orbits: the classes of the equivalence relation generated by
`x ~ faceStep^[n] x`. -/
def FaceOrbit (S : EmbeddingScheme G) : Type :=
  Quot (fun x y : G.Dart × Bool => ∃ n : ℕ, S.faceStep^[n] x = y)

/-- The number of faces of the scheme: every facial walk is traced by exactly two orbits (once in
each direction), and every isolated vertex is a component with a single face. -/
noncomputable def faces (S : EmbeddingScheme G) : ℕ :=
  Nat.card S.FaceOrbit / 2 + (Finset.univ.filter (fun v => G.degree v = 0)).card

/-- The Euler genus of the scheme, summed over the `c` connected components of `G`:
`2c − n + m − f`, computed in `ℤ`. -/
noncomputable def eulerGenus (S : EmbeddingScheme G) : ℤ :=
  2 * (Nat.card G.ConnectedComponent : ℤ) - (Fintype.card V : ℤ) + (G.edgeFinset.card : ℤ)
    - (S.faces : ℤ)

end EmbeddingScheme

/-- `G` has Euler genus at most `g`: some embedding scheme of `G` has Euler genus at most `g`. -/
def EulerGenusLE (G : SimpleGraph V) [DecidableRel G.Adj] (g : ℕ) : Prop :=
  ∃ S : EmbeddingScheme G, S.eulerGenus ≤ (g : ℤ)

end PlanarQueue.Genus


