theorem countP_range_block (M base i : ℕ) :
    ∀ q : ℕ, ((List.range q).map fun c => base + c * M).countP (fun o => decide (o ≤ i ∧ i < o + M)) =
      if base ≤ i ∧ i < base + q * M then 1 else 0
  | 0 => by simp
  | q + 1 => by
    rw [List.range_succ, List.map_append, List.countP_append, countP_range_block M base i q]
    simp only [List.map_cons, List.map_nil, List.countP_singleton, decide_eq_true_eq]
    have e : (q + 1) * M = q * M + M := by ring
    rw [e]
    split_ifs <;> omega

/-- **Each bit of the range is covered exactly once.** -/
theorem countP_pcs (m : ℕ) (hm : 1 ≤ m) (i : ℕ) :
    ∀ k base R, (NLogN.KFN.pcs m k base R).countP (covers m i) = if base ≤ i ∧ i < base + R then 1 else 0
  | 0, base, R => by
    simp only [NLogN.KFN.pcs, List.countP_map]
    have e1 : (covers m i ∘ fun c => (0, base + c)) =
        ((fun o => decide (o ≤ i ∧ i < o + 1)) ∘ fun c => base + c * 1) := by
      funext c; simp [covers]
    rw [e1]
    have := countP_range_block 1 base i R
    rw [List.countP_map] at this
    rw [this, mul_one]
  | k + 1, base, R => by
    simp only [NLogN.KFN.pcs, List.countP_append]
    have h1 := countP_range_block (m ^ (k + 1)) base i (R / m ^ (k + 1))
    rw [List.countP_map] at h1 ⊢
    have e1 : (covers m i ∘ fun c => (k + 1, base + c * m ^ (k + 1))) =
        ((fun o => decide (o ≤ i ∧ i < o + m ^ (k + 1))) ∘ fun c => base + c * m ^ (k + 1)) := by
      funext c; simp [covers]
    rw [e1, h1, countP_pcs m hm i k]
    have hdm := Nat.div_add_mod R (m ^ (k + 1))
    set q := R / m ^ (k + 1)
    set M := m ^ (k + 1)
    have e2 : q * M = M * q := by ring
    rw [e2]
    by_cases ha : base ≤ i ∧ i < base + M * q
    · rw [if_pos ha, if_neg (by omega), if_pos (by omega)]
    · rw [if_neg ha]
      by_cases hb : base + M * q ≤ i ∧ i < base + M * q + R % M
      · rw [if_pos hb, if_pos (by omega)]
      · rw [if_neg hb, if_neg (by omega)]

/-- The pieces lie in the range, at levels `≤ k`. -/
theorem mem_pcs (m : ℕ) (hm : 1 ≤ m) :
    ∀ k base R p, p ∈ NLogN.KFN.pcs m k base R → p.1 ≤ k ∧ base ≤ p.2 ∧ p.2 + m ^ p.1 ≤ base + R
  | 0, base, R, p, hp => by
    simp only [NLogN.KFN.pcs, List.mem_map, List.mem_range] at hp
    obtain ⟨c, hc, rfl⟩ := hp
    simp; omega
  | k + 1, base, R, p, hp => by
    simp only [NLogN.KFN.pcs, List.mem_append, List.mem_map, List.mem_range] at hp
    have hdm := Nat.div_add_mod R (m ^ (k + 1))
    rcases hp with ⟨c, hc, rfl⟩ | hp
    · refine ⟨le_rfl, by simp, ?_⟩
      simp only
      have : (c + 1) * m ^ (k + 1) ≤ R / m ^ (k + 1) * m ^ (k + 1) := Nat.mul_le_mul_right _ hc
      have e : (c + 1) * m ^ (k + 1) = c * m ^ (k + 1) + m ^ (k + 1) := by ring
      have e2 : R / m ^ (k + 1) * m ^ (k + 1) = m ^ (k + 1) * (R / m ^ (k + 1)) := by ring
      have z1 := Nat.zero_le (R % m ^ (k + 1))
      linarith
    · obtain ⟨h1, h2, h3⟩ := mem_pcs m hm k _ _ p hp
      have e2 : R / m ^ (k + 1) * m ^ (k + 1) = m ^ (k + 1) * (R / m ^ (k + 1)) := by ring
      have z1 := Nat.zero_le (R / m ^ (k + 1) * m ^ (k + 1))
      refine ⟨by omega, by linarith, by linarith⟩

/-- The number of pieces. -/
theorem length_pcs (m : ℕ) (hm : 1 ≤ m) :
    ∀ k base R, (NLogN.KFN.pcs m k base R).length ≤ R / m ^ k + k * m
  | 0, base, R => by simp [NLogN.KFN.pcs]
  | k + 1, base, R => by
    simp only [NLogN.KFN.pcs, List.length_append, List.length_map, List.length_range]
    have ih := length_pcs m hm k (base + R / m ^ (k + 1) * m ^ (k + 1)) (R % m ^ (k + 1))
    have hpos : 0 < m ^ k := pow_pos (by omega : 0 < m) k
    have h1 : R % m ^ (k + 1) / m ^ k < m := by
      rw [Nat.div_lt_iff_lt_mul hpos, ← pow_succ']
      exact Nat.mod_lt _ (pow_pos (by omega : 0 < m) _)
    nlinarith

section Ops

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- **A tensor power on a subfamily is the tensor product of an indicator.** -/
theorem subOp_tens {g : κ → ι} (hg : Function.Injective g) (A : Butterfly.M2) :
    subOp g (Butterfly.tens A : Matrix (κ → Fin 2) (κ → Fin 2) ℂ) =
      tensF (fun i => if ∃ k, g k = i then A else 1) := by
  classical
  ext x y
  simp only [subOp, tensF, Butterfly.tens]
  rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun i => ∃ k, g k = i)]
  have hR : (Finset.univ.filter fun i => ∃ k, g k = i) = Finset.univ.image g := by
    ext i; simp
  rw [hR, Finset.prod_image (fun a _ b _ h => hg h)]
  have hin : ∀ k, (if ∃ k', g k' = g k then A else 1) = A := fun k => if_pos ⟨k, rfl⟩
  simp_rw [hin]
  by_cases hc : ∀ i, (∀ k, g k ≠ i) → x i = y i
  · rw [if_pos hc]
    have : ∏ i ∈ Finset.univ.filter (fun i => ¬ ∃ k, g k = i),
        (if ∃ k, g k = i then A else 1) (x i) (y i) = 1 := by
      refine Finset.prod_eq_one fun i hi => ?_
      simp only [Finset.mem_filter] at hi
      rw [if_neg hi.2, Matrix.one_apply, if_pos (hc i (fun k hk => hi.2 ⟨k, hk⟩))]
    rw [this, mul_one]; rfl
  · rw [if_neg hc]
    push Not at hc
    obtain ⟨i, hi, hxy⟩ := hc
    have hni : ¬ ∃ k, g k = i := fun ⟨k, hk⟩ => hi k hk
    have : ∏ i ∈ Finset.univ.filter (fun i => ¬ ∃ k, g k = i),
        (if ∃ k, g k = i then A else 1) (x i) (y i) = 0 := by
      refine Finset.prod_eq_zero (i := i) (by simpa using hi) ?_
      rw [if_neg hni, Matrix.one_apply, if_neg hxy]
    rw [this, mul_zero]

theorem prod_ind (A : Butterfly.M2) {α : Type*} (P : α → Bool) :
    ∀ l : List α, (l.map fun a => if P a then A else 1).prod = A ^ l.countP P
  | [] => by simp
  | a :: l => by
    rw [List.map_cons, List.prod_cons, prod_ind A P l, List.countP_cons]
    by_cases h : P a
    · simp only [h, if_true]; rw [pow_succ']
    · simp [h]

end Ops

