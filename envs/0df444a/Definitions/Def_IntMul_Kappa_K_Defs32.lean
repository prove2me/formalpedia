-- Source module: Solutions.KFWC13
/-!
# KFW C-layer 13: the core registers from the descriptor and the level loop

After `LOGp` (`k = log_m D` on `11`, `G^k` on `12`, `W^k` on `13`, `m^k` on `14`, `ES k` on `15`),
`coreC jE` pushes

* `27 k`, `32 m^k`, `19 ES k`, `28 q₀ = min(D, 71 k)`, `5 H = w + EwB(A₀, D)` (frame `core1`),
* `29 D' = D - q₀`, `20 B' = padB (P 2^{K q₀}) (W^k)` (expression frame `core2`),
* the entry registers of the scale loop (`lowIn`),

and calls the scale loop.  **`coreQ`**: the result is a `CoreR`/`LowR` assignment.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- `q₀ = min(D, 71 k)`. -/
def q0f (D k : ℕ) : ℕ := if D ≤ 71 * k then D else 71 * k

/-- `EwB(A₀, D)` from `D` (22), `k` (11), `G^k` (12), with the constant `G`. -/
def ewbG (G : ℕ) : NE :=
  .add (.add (.add (.mul (.lit 2) (.reg 22))
      (.mul (.mul (.add (.reg 11) (.lit 1)) (.lit mC))
        (.mul (.mul (.lit 4) (.mul (.add (.reg 11) (.lit 1)) (.add (.reg 11) (.lit 1))))
          (.mul (.mul (.reg 12) (.lit G)) (.lit G)))))
    (.mul (.mul (.lit 20) (.mul (.add (.reg 11) (.lit 1))
        (.mul (.add (.reg 11) (.lit 1)) (.add (.reg 11) (.lit 1)))))
      (.mul (.mul (.reg 12) (.lit G)) (.lit G)))) (.lit 2)

/-- `q₀` from `D` (22), `k` (11). -/
def q0E : NE :=
  .lt (.reg 22) (.add (.mul (.lit 71) (.reg 11)) (.lit 1)) (.reg 22) (.mul (.lit 71) (.reg 11))

/-- The first core frame. -/
def core1G (G : ℕ) : List (Fin HS × NE) :=
  [(27, .reg 11), (32, .reg 14), (19, .reg 15), (28, q0E), (5, .add (.reg 25) (ewbG G))]

/-- The first core frame. -/
noncomputable def core1 : List (Fin HS × NE) := core1G Gc

/-- `D - q₀`. -/
def eDq : Ex HS := .add (.reg 22) (.neg (.reg 28))

/-- `padB (P 2^{K q₀}) (W^k)`. -/
def eBp : Ex HS :=
  .mul (.reg 13) (.ndiv (.add (.mul (.reg 21) (.pow2 (.mul (.reg 1) (.reg 28))))
    (.add (.reg 13) (.lit (-1)))) (.reg 13))

/-- The second core frame (values). -/
def core2 (D q0 Bp : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(29, eDq, ((D - q0 : ℕ) : ℤ)), (20, NLogN.KFW.eBp, (Bp : ℤ))]

def core2E : List (Fin HS × Ex HS) := [(29, eDq), (20, NLogN.KFW.eBp)]

/-- The core stage. -/
noncomputable def coreC {Pp : ℕ} (jE : Fin Pp) : IStmt HS Pp :=
  withPushI (fr core1) (withPushI core2E (withPushI (fr lowIn) (.call jE)))

/-- The cost of the core stage. -/
def cCore (cc Z Bz : ℕ) : ℕ :=
  cFrame 5 64 Bz + (cFrame 2 32 Z + (cFrame 5 12 Bz + (cc + 2) + (5 * (2 * Bz + 2) + 1)) +
    (2 * (2 * Z + 2) + 1)) + (5 * (2 * Bz + 2) + 1)

section Core

