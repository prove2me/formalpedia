    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => by ring
  simp only [this, hD.lower_covD_null hx, mul_zero, Finset.sum_const_zero]

theorem k_dot_accL {x : Pt 5} (hx : x ∈ U) : ∑ d, k x d * accL b bi k x d = 0 := by
  rw [← hD.lower_dot_accel hx]
  unfold accL
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [← hD.sum_k_mul_b hx j, Finset.sum_mul]
