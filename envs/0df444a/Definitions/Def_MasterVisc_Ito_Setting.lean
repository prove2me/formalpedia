-- title:
--   §2.2, §2.4 — Ω, the càdlàg space Ω̂, Skorokhod distance (2.6), 𝒫̂₂, W₂ (2.1) with d_SK, 𝒲₂ (2.5), and 𝒫̂_L
-- statement:
--   This module fixes the canonical setup of §2.2 and the class $\widehat{\mathcal P}_L$ of §2.4 of Wu and Zhang.
--
--   Fix a dimension $d$ and a horizon $T\ge 0$.
--
--   1. **Continuous paths.** $\Omega=C([0,T],\mathbb R^d)$ with the uniform norm $\|\omega\|=\sup_{t\in[0,T]}|\omega_t|$ and its Borel $\sigma$-algebra; the canonical process is $X_s(\omega)=\omega_{s\wedge T}$.
--   2. **Càdlàg paths.** $\widehat\Omega=\mathbb D([0,T],\mathbb R^d)$ is the set of paths $\hat\omega:[0,\infty)\to\mathbb R^d$ that are right-continuous with left limits and constant after $T$. It carries the $\sigma$-algebra generated by the evaluations $\hat\omega\mapsto\hat\omega_r$, and $\widehat{\mathcal F}_t=\sigma(\widehat X_s:s\le t)$ is the natural filtration. The stopped path is $\hat\omega_{t\wedge\cdot}$, the bump is $\hat\omega+x\mathbf 1_{[t,T]}$, and $\Omega\subset\widehat\Omega$ by extending a continuous path flat after $T$.
--   3. **Skorokhod distance** (2.6):
--   $$
--   d_{SK}(\hat\omega,\hat\omega')=\inf_\lambda\sup_{0\le t\le T}\big[|t-\lambda(t)|+|\hat\omega_t-\hat\omega'_{\lambda(t)}|\big],
--   $$
--   the infimum over $\lambda:[0,T]\to[0,T]$ continuous, strictly increasing, with $\lambda(0)=0$, $\lambda(T)=T$; and $\|\hat\omega\|=\sup_{0\le t\le T}|\hat\omega_t|$.
--   4. **Laws.** $\widehat{\mathcal P}_2$ is the set of probability measures $\mu$ on $\widehat\Omega$ with $\mathbb E^\mu[\|\widehat X\|^2]<\infty$. The 2-Wasserstein distance is (2.1) with $d_{SK}$ in place of the norm,
--   $$
--   \mathcal W_2(\mu,\nu)=\Big(\inf_{\pi}\int d_{SK}^2(\hat\omega,\hat\omega')\,\pi(d\hat\omega,d\hat\omega')\Big)^{1/2},
--   $$
--   the infimum over couplings $\pi$ of $\mu$ and $\nu$, and the pseudometric (2.5) on $\widehat\Theta=[0,T]\times\widehat{\mathcal P}_2$ is
--   $$
--   \mathcal W_2\big((t,\mu),(t',\nu)\big)=\big(|t-t'|+\mathcal W_2^2(\mu_{[0,t]},\nu_{[0,t']})\big)^{1/2},
--   $$
--   where $\mu_{[0,t]}$ is the law of $\widehat X_{t\wedge\cdot}$ under $\mu$.
--   5. **Semimartingale representations and $\widehat{\mathcal P}_L$.** A representation is a filtered probability space $(\tilde\Omega,\tilde{\mathbb F},\tilde{\mathbb P})$ carrying a $d$-dimensional $(\tilde{\mathbb F},\tilde{\mathbb P})$-Brownian motion $\tilde B$, $\tilde{\mathbb F}$-progressively measurable bounded $\tilde b$ (vector) and $\tilde\sigma$ (matrix), and an adapted continuous process $\tilde X$ with $\tilde X_s=\tilde X_t+\int_t^s\tilde b_r\,dr+\int_t^s\tilde\sigma_r\,d\tilde B_r$ for $s\in[t,T]$. The characteristics are bounded by $L$ if $|\tilde b|\le L$ and $\tfrac12|\tilde\sigma|^2\le L$. A law $\mu\in\widehat{\mathcal P}_2$ belongs to $\widehat{\mathcal P}_L$ (witnessed by a representation) if $\mu=\tilde{\mathbb P}\circ\tilde X^{-1}$ for such a representation from time $0$, with characteristics bounded by $L$ and $\tilde X_0\in\mathbb L^2(\tilde{\mathcal F}_0)$.
--
--   The module also records $|\sigma|^2=\sum_{ij}\sigma_{ij}^2$ and the trace product $A:B=\sum_{ij}A_{ij}B_{ij}$. Every statement of the mission is phrased on these objects.
--
--   **Formalization Note** The printed $\mathbb D([0,T),\mathbb R^d)$ is read as $\mathbb D([0,T],\mathbb R^d)$, since (2.6) evaluates paths at $T$. Paths live on $[0,\infty)$ and are constant after $T$, which encodes the interval $[0,T]$; the time changes are required to be continuous and strictly increasing on $[0,T]$ only. Distances, $\|\hat\omega\|$ and $\mathcal W_2$ take values in $[0,\infty]$ (they are finite on càdlàg paths and $\widehat{\mathcal P}_2$). The evaluation $\sigma$-algebra on $\widehat\Omega$ is the Borel $\sigma$-algebra of the Skorokhod topology (a classical fact, not proved here). The stochastic integral $\int_t^s\tilde\sigma\,d\tilde B$ is $J(s)-J(t)$ for Itô integrals $J_{ij}$ of $\tilde\sigma_{ij}$ against $\tilde B_j$ in the sense of the published `EthierKurtz.HasBrownianItoIntegral`; the Brownian motion is `EthierKurtz.IsStandardBrownian`, adapted, with increments after $s$ independent of $\tilde{\mathcal F}_s$. A law of $\widehat{\mathcal P}_L$ is the push-forward to $\widehat\Omega$ of the law of $\tilde X$ on $\Omega$ (the page's "$\mathrm{supp}(\mu)\subset\Omega\subset\widehat\Omega$").
-- source:
--   Wu, Zhang, Viscosity solutions to parabolic master equations and McKean–Vlasov SDEs with closed-loop controls, Ann. Appl. Probab. 30(2) (2020), §2.1 (2.1), p. 939; §2.2 (2.5)–(2.6), pp. 940–941; §2.4, p. 944 (definition of 𝒫̂_L)

import Mathlib
import Definitions.Def_EthierKurtz_SDEState
import Definitions.Def_EthierKurtz_IsStandardBrownian
import Definitions.Def_EthierKurtz_HasBrownianItoIntegral
import Definitions.Def_MasterVisc_Comparison_Setting

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace MasterVisc.Ito

open EthierKurtz

/-! ### The continuous canonical space Ω = C([0, T], ℝ^d) (§2.2, p. 940) -/

instance instBorelSpacePath (d : ℕ) (T : ℝ≥0) : BorelSpace (MasterVisc.Comparison.Path d T) := ⟨rfl⟩

/-! ### Semimartingale representations (§2.4, p. 944) -/

/-- The data of a representation μ = ℙ̃ ∘ X̃⁻¹ of a semimartingale law: a filtered
probability space (Ω̃, 𝔽̃, ℙ̃), a d-dimensional process B̃ (the Brownian motion), drift and
diffusion coefficients b̃, σ̃, and the process X̃ as a path-valued random variable `Y`. -/
structure Rep (d : ℕ) (T : ℝ≥0) where
  /-- the sample space Ω̃ -/
  Ω : Type
  /-- its σ-algebra -/
  [instMS : MeasurableSpace Ω]
  /-- the probability ℙ̃ -/
  P : Measure Ω
  /-- the filtration 𝔽̃ -/
  F : Filtration ℝ≥0 instMS
  /-- the Brownian motion B̃ -/
  B : ℝ≥0 → Ω → SDEState d
  /-- the drift b̃ -/
  b : ℝ≥0 → Ω → SDEState d
  /-- the diffusion σ̃ -/
  σ : ℝ≥0 → Ω → Matrix (Fin d) (Fin d) ℝ
  /-- the process X̃, as a random continuous path -/
  Y : Ω → MasterVisc.Comparison.Path d T

attribute [instance] Rep.instMS

/-- `R` represents the law `P` on Ω as a semimartingale on [t, T]:
ℙ̃ is a probability, `Y` is measurable with law `P`, B̃ is a standard d-dimensional
(𝔽̃, ℙ̃)-Brownian motion (adapted, with increments after `s` independent of 𝔽̃_s),
b̃ and σ̃ are 𝔽̃-progressively measurable and bounded, X̃ is 𝔽̃-adapted, and ℙ̃-a.s.
X̃_s = X̃_t + ∫_t^s b̃_r dr + ∫_t^s σ̃_r dB̃_r for all s ∈ [t, T], where the stochastic
integral is `J(s) − J(t)` for Itô integrals `J i j` of σ̃ᵢⱼ against B̃ⱼ. -/
noncomputable def IsRepFrom {d : ℕ} {T : ℝ≥0} (t : ℝ≥0) (P : Measure (MasterVisc.Comparison.Path d T)) (R : Rep d T) : Prop :=
  IsProbabilityMeasure R.P ∧
  Measurable R.Y ∧
  R.P.map R.Y = P ∧
  IsStandardBrownian R.P R.B ∧
  (∀ s, Measurable[R.F s] (R.B s)) ∧
  (∀ s, Indep (R.F s)
    (MeasurableSpace.comap (fun ω (r : Set.Ici s) => R.B r.val ω - R.B s ω) inferInstance) R.P) ∧
  IsStronglyProgressive R.F R.b ∧
  IsStronglyProgressive R.F R.σ ∧
  (∃ C : ℝ, ∀ s ω, ‖R.b s ω‖ ≤ C ∧ MasterVisc.Comparison.frob2 (R.σ s ω) ≤ C) ∧
  (∀ s, Measurable[R.F s] (fun ω => MasterVisc.Comparison.evalAt s (R.Y ω))) ∧
  ∃ J : Fin d → Fin d → ℝ≥0 → R.Ω → ℝ,
    (∀ i j, HasBrownianItoIntegral R.P (fun s => R.F s)
      (fun s ω => R.B s ω j) (fun s ω => R.σ s ω i j) (J i j)) ∧
    ∀ᵐ ω ∂(R.P), ∀ s : ℝ≥0, t ≤ s → s ≤ T → ∀ i,
      MasterVisc.Comparison.evalAt s (R.Y ω) i = MasterVisc.Comparison.evalAt t (R.Y ω) i
        + (∫ r in (t : ℝ)..(s : ℝ), R.b r.toNNReal ω i)
        + ∑ j, (J i j s ω - J i j t ω)

/-- The characteristics are bounded by `L`: |b̃| ≤ L and ½|σ̃|² ≤ L. -/
noncomputable def RepBound {d : ℕ} {T : ℝ≥0} (L : ℝ) (R : Rep d T) : Prop :=
  ∀ s ω, ‖R.b s ω‖ ≤ L ∧ MasterVisc.Comparison.frob2 (R.σ s ω) / 2 ≤ L

/-! ### The càdlàg space Ω̂ = 𝔻([0, T], ℝ^d) (§2.2, p. 941) -/

/-- Right-continuous at every time, with a left limit at every positive time. -/
noncomputable def IsCadlag {d : ℕ} (ω : ℝ≥0 → SDEState d) : Prop :=
  (∀ r, ContinuousWithinAt ω (Set.Ici r) r) ∧
  (∀ r : ℝ≥0, 0 < r → ∃ l, Tendsto ω (𝓝[<] r) (𝓝 l))

/-- Ω̂: càdlàg paths on [0, T], extended flat after `T`. Its σ-algebra (the subtype of the
product σ-algebra) is the one generated by the evaluations ω̂ ↦ ω̂_r. -/
noncomputable abbrev DPath (d : ℕ) (T : ℝ≥0) : Type :=
  {ω : ℝ≥0 → SDEState d // IsCadlag ω ∧ ∀ r, T ≤ r → ω r = ω T}

/-- The natural filtration 𝔽̂ of the canonical process on Ω̂: F̂_t = σ(X̂_s : s ≤ t). -/
noncomputable abbrev FD {d : ℕ} {T : ℝ≥0} (t : ℝ≥0) : MeasurableSpace (DPath d T) :=
  ⨆ (s : ℝ≥0) (_ : s ≤ t), MeasurableSpace.comap (fun ω : DPath d T => ω.1 s) inferInstance

lemma isCadlag_comp_min {d : ℕ} {ω : ℝ≥0 → SDEState d} (h : IsCadlag ω) (t : ℝ≥0) :
    IsCadlag (fun r => ω (min r t)) := by
  refine ⟨fun r => ?_, fun r hr => ?_⟩
  · have hc : ContinuousWithinAt (fun r : ℝ≥0 => min r t) (Set.Ici r) r :=
      (continuous_id.min continuous_const).continuousWithinAt
    exact ContinuousWithinAt.comp (h.1 (min r t)) hc
      (fun s hs => min_le_min_right t (Set.mem_Ici.mp hs))
  · rcases le_or_gt r t with hrt | hrt
    · obtain ⟨l, hl⟩ := h.2 r hr
      refine ⟨l, hl.congr' ?_⟩
      filter_upwards [self_mem_nhdsWithin] with s hs
      rw [min_eq_left ((Set.mem_Iio.mp hs).le.trans hrt)]
    · refine ⟨ω t, tendsto_const_nhds.congr' ?_⟩
      filter_upwards [Ioo_mem_nhdsLT hrt] with s hs
      rw [min_eq_right hs.1.le]

lemma isCadlag_add {d : ℕ} {ω ω' : ℝ≥0 → SDEState d} (h : IsCadlag ω) (h' : IsCadlag ω') :
    IsCadlag (fun r => ω r + ω' r) := by
  refine ⟨fun r => (h.1 r).add (h'.1 r), fun r hr => ?_⟩
  obtain ⟨l, hl⟩ := h.2 r hr
  obtain ⟨l', hl'⟩ := h'.2 r hr
  exact ⟨l + l', hl.add hl'⟩

lemma isCadlag_step {d : ℕ} (a : ℝ≥0) (p : Prop) [Decidable p] (x : SDEState d) :
    IsCadlag (fun r => if a ≤ r ∧ p then x else 0) := by
  refine ⟨fun r => ?_, fun r hr => ?_⟩
  · rcases le_or_gt a r with har | har
    · refine (continuousWithinAt_const (b := if p then x else 0)).congr (fun s hs => ?_) ?_
      · simp only [har.trans (Set.mem_Ici.mp hs), true_and]
      · simp only [har, true_and]
    · refine (continuousWithinAt_const (b := (0 : SDEState d))).congr_of_eventuallyEq ?_ ?_
      · have : Set.Iio a ∈ 𝓝[Set.Ici r] r :=
          nhdsWithin_le_nhds (Iio_mem_nhds har)
        filter_upwards [this] with s hs
        simp [not_le.mpr (Set.mem_Iio.mp hs)]
      · simp [not_le.mpr har]
  · rcases le_or_gt r a with hra | hra
    · refine ⟨0, tendsto_const_nhds.congr' ?_⟩
      filter_upwards [self_mem_nhdsWithin] with s hs
      simp [not_le.mpr ((Set.mem_Iio.mp hs).trans_le hra)]
    · refine ⟨if p then x else 0, tendsto_const_nhds.congr' ?_⟩
      filter_upwards [Ioo_mem_nhdsLT hra] with s hs
      simp [hs.1.le]

/-- The stopped path ω̂_{t∧·}. -/
noncomputable def stopD {d : ℕ} {T : ℝ≥0} (t : ℝ≥0) (ω : DPath d T) : DPath d T :=
  ⟨fun r => ω.1 (min r t), isCadlag_comp_min ω.2.1 t, by
    intro r hr
    rcases le_or_gt t T with htT | htT
    · show ω.1 (min r t) = ω.1 (min T t)
      rw [min_eq_right (htT.trans hr), min_eq_right htT]
    · show ω.1 (min r t) = ω.1 (min T t)
      rw [min_eq_left htT.le, ω.2.2 _ (le_min hr htT.le)]⟩

/-- The bumped path ω̂ + x 1_{[t,T]} (for `t > T` the interval is empty and the path is unchanged). -/
noncomputable def bumpD {d : ℕ} {T : ℝ≥0} (t : ℝ≥0) (ω : DPath d T) (x : SDEState d) : DPath d T :=
  ⟨fun r => ω.1 r + (if t ≤ r ∧ t ≤ T then x else 0),
    isCadlag_add ω.2.1 (isCadlag_step t (t ≤ T) x), by
    intro r hr
    by_cases htT : t ≤ T
    · simp [htT, htT.trans hr, ω.2.2 r hr]
    · simp [htT, ω.2.2 r hr]⟩

/-- The embedding Ω ⊂ Ω̂: a continuous path on [0, T], extended flat after `T`. -/
noncomputable def embed {d : ℕ} {T : ℝ≥0} (ω : MasterVisc.Comparison.Path d T) : DPath d T :=
  ⟨fun r => MasterVisc.Comparison.evalAt r ω, by
    have hc : Continuous (fun r : ℝ≥0 => MasterVisc.Comparison.evalAt r ω) :=
      ω.continuous.comp ((continuous_id.min continuous_const).subtype_mk _)
    exact ⟨fun r => hc.continuousWithinAt, fun r _ => ⟨_, hc.continuousAt.tendsto.mono_left
      nhdsWithin_le_nhds⟩⟩, by
    intro r hr
    simp only [MasterVisc.Comparison.evalAt, min_eq_right hr, min_self]⟩

/-! ### Norms and the Skorokhod distance (2.6) -/

/-- ‖ω̂‖ = sup_{0 ≤ r ≤ T} |ω̂_r|. -/
noncomputable def supD {d : ℕ} {T : ℝ≥0} (ω : DPath d T) : ℝ≥0∞ :=
  ⨆ (r : ℝ≥0) (_ : r ≤ T), ‖ω.1 r‖ₑ

/-- The time changes of (2.6): λ continuous and strictly increasing on [0, T], λ(0) = 0, λ(T) = T. -/
noncomputable def TimeChanges (T : ℝ≥0) : Set (ℝ≥0 → ℝ≥0) :=
  {l | ContinuousOn l (Set.Icc 0 T) ∧ StrictMonoOn l (Set.Icc 0 T) ∧ l 0 = 0 ∧ l T = T}

/-- The Skorokhod distance (2.6): d_SK(ω̂, ω̂′) = inf_λ sup_{0≤r≤T} [|r − λ(r)| + |ω̂_r − ω̂′_{λ(r)}|]. -/
noncomputable def dSK {d : ℕ} {T : ℝ≥0} (ω ω' : DPath d T) : ℝ≥0∞ :=
  ⨅ l ∈ TimeChanges T, ⨆ (r : ℝ≥0) (_ : r ≤ T),
    (ENNReal.ofReal |(r : ℝ) - (l r : ℝ)| + ‖ω.1 r - ω'.1 (l r)‖ₑ)

/-! ### Laws on Ω̂: 𝒫̂₂, the Wasserstein distance (2.1) with d_SK, and (2.5) on Θ̂ -/

/-- μ ∈ 𝒫̂₂: a probability measure on Ω̂ with 𝔼^μ[‖X̂‖²] < ∞. -/
noncomputable def IsP2D {d : ℕ} {T : ℝ≥0} (μ : Measure (DPath d T)) : Prop :=
  IsProbabilityMeasure μ ∧ ∫⁻ ω, supD ω ^ 2 ∂μ < ⊤

/-- (2.1) on Ω̂ with the metric replaced by d_SK:
W₂(μ, ν) = (inf over couplings π of μ and ν of ∫ d_SK² dπ)^{1/2}. -/
noncomputable def W2SK {d : ℕ} {T : ℝ≥0} (μ ν : Measure (DPath d T)) : ℝ≥0∞ :=
  (⨅ (π : Measure (DPath d T × DPath d T)) (_ : π.map Prod.fst = μ ∧ π.map Prod.snd = ν),
      ∫⁻ z, dSK z.1 z.2 ^ 2 ∂π) ^ (1 / 2 : ℝ)

/-- The pseudometric (2.5) on Θ̂: 𝒲₂((t, μ), (t′, ν)) = (|t − t′| + W₂²(μ_{[0,t]}, ν_{[0,t′]}))^{1/2}. -/
noncomputable def W2ΘD {d : ℕ} {T : ℝ≥0} (t : ℝ≥0) (μ : Measure (DPath d T)) (t' : ℝ≥0)
    (ν : Measure (DPath d T)) : ℝ≥0∞ :=
  (ENNReal.ofReal |(t : ℝ) - (t' : ℝ)|
    + W2SK (μ.map (stopD t)) (ν.map (stopD t')) ^ 2) ^ (1 / 2 : ℝ)

/-! ### 𝒫̂_L (§2.4, p. 944) -/

/-- μ ∈ 𝒫̂_L, witnessed by the representation `R`: μ ∈ 𝒫̂₂ is the law (pushed from Ω into Ω̂)
of X̃ = X̃₀ + ∫₀^· b̃ ds + ∫₀^· σ̃ dB̃ with X̃₀ ∈ 𝕃²(F̃₀) and |b̃|, ½|σ̃|² ≤ L. -/
noncomputable def InPLhat {d : ℕ} {T : ℝ≥0} (L : ℝ) (μ : Measure (DPath d T)) (R : Rep d T) : Prop :=
  IsP2D μ ∧
  IsRepFrom 0 (R.P.map R.Y) R ∧
  RepBound L R ∧
  Measurable[R.F 0] (fun ω => MasterVisc.Comparison.evalAt 0 (R.Y ω)) ∧
  ∫⁻ (ω : R.Ω), ‖MasterVisc.Comparison.evalAt 0 (R.Y ω)‖ₑ ^ 2 ∂(R.P) < ⊤ ∧
  μ = (R.P.map R.Y).map embed

end MasterVisc.Ito


