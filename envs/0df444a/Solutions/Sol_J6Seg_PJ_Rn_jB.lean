theorem den_kzE2 (h5 : v 5 = j) (h7 : v 7 = l) (h26 : v 26 = w) (h22 : v 22 = s) (h23 : v 23 = t) :
    kzE2.den v = HvdH.eKz s t (l : ℤ) ((j : ℤ) - w) := by
  simp only [kzE2, hE2, E.den, den_bOfE h22 h23, h5, h7, h26, h23, HvdH.eKz]
  ring

theorem den_xE2 (h5 : v 5 = j) (h7 : v 7 = l) (h26 : v 26 = w) (h22 : v 22 = s) (h23 : v 23 = t)
    (h25 : v 25 = α) :
    xE2.den v = ((α ^ 2 * (HvdH.eKz s t (l : ℤ) ((j : ℤ) - w)).toNat : ℕ) : ℤ) := by
  simp only [xE2, E.den, den_mx0E, den_kzE2 h5 h7 h26 h22 h23, h25]
  push_cast; ring

theorem den_cdE2 {B : Blocks} {b : ℕ} (h1 : v 1 = B.st l) (h2 : v 2 = B.len l) (h4 : v 4 = b)
    (h5 : v 5 = j) (h7 : v 7 = l) (h26 : v 26 = B.w) (h22 : v 22 = B.s) (hs : 0 < B.s) :
    cdE2.den v = if hcT B l j ∧ col B.s l ((j : ℤ) - B.w) = b then 1 else 0 := by
  have hz : (0 : ℤ) ≤ ((l : ℤ) + ((j : ℤ) - B.w)) % (B.s : ℤ) :=
    Int.emod_nonneg _ (by exact_mod_cast hs.ne')
  have key : col B.s l ((j : ℤ) - B.w) = b ↔ ((l : ℤ) + ((j : ℤ) - B.w)) % (B.s : ℤ) = b := by
    unfold col
    constructor
    · intro e; rw [← e, Int.toNat_of_nonneg hz]
    · intro e; rw [e]; simp
  simp only [cdE2, c1E2, c2E2, colE2, pE2, hE2, E.den, den_eqE, den_ltE, h1, h2, h4, h5, h7, h22, h26]
  unfold hcT
  simp only [key]
  generalize ((l : ℤ) + ((j : ℤ) - B.w)) % (B.s : ℤ) = z at hz ⊢
  split_ifs <;> omega

