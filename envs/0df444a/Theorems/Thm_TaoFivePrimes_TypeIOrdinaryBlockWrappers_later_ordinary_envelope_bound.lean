theorem later_ordinary_envelope_bound
    (x : ℝ) (a q k : ℕ) (gamma beta : ℝ)
    (hx : 1 ≤ x) (hq : 4 ≤ q) (haq : Nat.Coprime a q)
    (hgamma : 2 * gamma = (a : ℝ) / (q : ℝ) + beta)
    (hbeta : |beta| ≤ 1 / (q : ℝ) ^ 2) :
    (∑ d ∈ laterOddDivisors q k,
      safeCap (ordinaryDivisorCap x (d : ℝ))
        (ordinaryReciprocalBudget x)
        (Real.pi * gamma * (d : ℝ))) ≤
      (x * Real.log x) / (2 * (q : ℝ)) *
          (1 / ((k : ℝ) + 5 / 4)) +
        ordinaryReciprocalBudget x * oddVinogradovBlockConstant q := by sorry
end TaoFivePrimes.TypeIOrdinaryBlockWrappers
