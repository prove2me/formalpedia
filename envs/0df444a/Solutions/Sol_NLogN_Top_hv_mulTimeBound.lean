    (h3' : ∀ i, T.head (tst i) = (c.σ.stk i).length) : T = NLogN.enc inp c := by
  apply Tapes.ext' <;> funext l <;> rcases fin_cases3 l with rfl | rfl | rfl | ⟨i, rfl⟩ <;>
    simp_all [enc_cells_tst, enc_head_tst]

theorem Reach.trans {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q₁ q₂ q₃ : P.Q} {T₁ T₂ T₃ : Tapes Γ' k} {m n : ℕ}
    (h₁ : Reach st P q₁ T₁ m q₂ T₂) (h₂ : Reach st P q₂ T₂ n q₃ T₃) : Reach st P q₁ T₁ (m + n) q₃ T₃ := by
  induction h₁ with
  | refl => simpa using h₂
  | step h _ ih => rw [Nat.add_right_comm]; exact Reach.step h (ih h₂)

theorem Reach.halts {Γ' : Type} [DecidableEq Γ'] {k : ℕ} {st : Γ'} {P : Prog Γ' k}
    {q₁ q₂ : P.Q} {T₁ T₂ T₃ : Tapes Γ' k} {m n : ℕ}
