/-- Weak charged-tail output, with no rotation, G or KS premise. -/
def ChargedTailOutput (I : Set ℝ) (s ε : ℝ) (f m N w p a : ℝ → ℝ) : Prop :=
  ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧ ∀ R : ℝ, s + δ⁻¹ < R →
    R ∈ I ∧ 0 < f R ∧ 0 < m R ∧ 0 < N R ∧ 0 < alphaSq f m N w p a R

/-- Arbitrarily-far actual G defect and failure of both actual principal fields to be
pregeodesic there. This does not assert positivity for every pointwise vector at that R. -/
def PrincipalDefectOutput (I : Set ℝ) (f m N w p a : ℝ → ℝ) : Prop :=
  ∀ B : ℝ, ∃ R : ℝ, B < R ∧ R ∈ I ∧ Gfun p a R ≠ 0 ∧
    ∀ x : Pt 5, x 1 = R → 0 < x 2 → x 2 < 1 →
      ¬ PregeodesicAt (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
        (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (kPlus f m N w p a) x ∧
      ¬ PregeodesicAt (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
        (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (kMinus f m N w p a) x

/-- No distant actual candidate tail carries a C1 nonzero/null/Ricci-null/pregeodesic
field. Ricci-nullity is not assumed by the later general-background positive root. -/
def NoCongruenceOutput (I : Set ℝ) (f m N w : ℝ → ℝ) : Prop :=
  ¬ ∃ T : ℝ, ∃ V : Pt 5 → Fin 5 → ℝ,
    RicciNullPregeodesicField (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esDomain I ∩ {x : Pt 5 | T < x 1}) V

/-- Positive witnesses for the actual given background and K, fixed before every cutoff.
The point/patch may depend on those data and the cutoff; no uniform or whole-tail
strict lower bound is asserted. -/
def BackgroundPositiveOutput (I : Set ℝ) (f m N w p a : ℝ → ℝ) (T : ℝ)
    (gb gbi : Metric 5) (K : Pt 5 → Fin 5 → ℝ) : Prop :=
  let U := esDomain I ∩ {x : Pt 5 | T < x 1}
  (∀ B : ℝ, ∃ x ∈ U, B < x 1 ∧
    0 < contract2 (ricciOf gb gbi) x (K x) ∧ 0 < misalign f m N w p a x (K x) ∧
    ¬ ∃ t : ℝ, K x = t • kPlus f m N w p a x ∨ K x = t • kMinus f m N w p a x) ∧
  (∀ B : ℝ, ∃ V : Set (Pt 5), IsOpen V ∧ V.Nonempty ∧
    V ⊆ U ∩ {x : Pt 5 | B < x 1} ∧
    ∀ x ∈ V, 0 < contract2 (ricciOf gb gbi) x (K x))

/-- Full arbitrary-K family, with the same old raw KSData, actual representation,
nonzero field and background pregeodesicity. No plane, rescaling or curvature-sign input. -/
def GeneralPositiveFamily (I : Set ℝ) (f m N w p a : ℝ → ℝ) : Prop :=
  ∀ (T : ℝ) (gb gbi : Metric 5) (v : Pt 5 → ℝ) (K : Pt 5 → Fin 5 → ℝ),
    KSData gb gbi v K (esDomain I ∩ {x : Pt 5 | T < x 1}) →
    (∀ i j, Set.EqOn (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w i j)
      (ksMetric gb v K i j) (esDomain I ∩ {x : Pt 5 | T < x 1})) →
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, K x ≠ 0) →
    (∀ x ∈ esDomain I ∩ {x : Pt 5 | T < x 1}, PregeodesicAt gb gbi K x) →
    BackgroundPositiveOutput I f m N w p a T gb gbi K

/-- The candidate's own certificate yields one common actual Q/J pair and BVP, with
the complete finite-branch tail, principal defect, no-congruence, general-background
positive family and nonpositive/Einstein-form exclusions. -/
def OwnFiniteKSOutput (I : Set ℝ) (f m N w p a : ℝ → ℝ) (r₀ s ε : ℝ) : Prop :=
  ∃ Q J : ℝ, Q = -qFun f N w p a r₀ ∧ J = -ellFun f m N w p a r₀ / 2 ∧
    PaperBVP I f m N w p a Q J ∧ Q ≠ 0 ∧ J ≠ 0 ∧
    ChargedTailOutput I s ε f m N w p a ∧
    PrincipalDefectOutput I f m N w p a ∧ NoCongruenceOutput I f m N w ∧
    GeneralPositiveFamily I f m N w p a ∧
    (¬ ∃ T : ℝ, NonposBackgroundKSTail I f m N w T) ∧
    (¬ ∃ T : ℝ, EinsteinBackgroundKSTail I f m N w T)

