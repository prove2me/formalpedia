        (s.upd m (.int (min k μ : ℕ) :: s.G m)) with hw
      have wm : w.G m = .int (min k μ : ℕ) :: s.G m := by
        simp [hw, withCtr, IState.upd_G, hmC]
      have e1 : c.eval w = c.eval (s.upd m (.int (min k μ : ℕ) :: s.G m)) := by
        rw [hw, withCtr]; exact Ex.eval_upd _ _ _ c hcC
      have b1 : c.Bnd w B := by
        rw [hw, withCtr, Ex.bnd_upd _ _ _ _ c hcC]; exact hcB _ (min_le_right _ _)
      have := asgCost_le m (.add (.reg m) (.sel c (.lit 0) (.lit 1))) w B (by
        simp only [Ex.Bnd, Ex.eval, IState.top_eq wm, e1]
        refine ⟨zb _ (by omega), ⟨b1, by split_ifs <;> simp [Ex.Bnd, zsz_zero, zsz_one, hB1]⟩, ?_⟩
        by_cases h : μ ≤ min k μ
        · rw [if_pos ((hc _).2 h)]; simpa using zb (min k μ) (by omega)
