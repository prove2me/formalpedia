    obtain ⟨h₂, ⟨hg₁', hres⟩, hunit⟩ := key.2 h0'
    have hg₁ : genericPoint (𝔛.Mfib A hA ρ hρ).C ∈ (𝔛.efib A hA ρ hρ ≫ 𝔛.comp A hA ρ hρ 1 ≫ bcMap (ΓM M H) hj ρO toκ htoκ) ⁻¹ᵁ V := by
