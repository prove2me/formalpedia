variable {E : Type} [Field E] [NumberField E] {n nb : ℕ}
variable (X : PT E) {bs : Fin nb → Block E n X.dim}

theorem ReciprocityTheory.ChartRestriction.G.I2.filter_positions (hD : Disj bs) (T : Choice bs) (p : Σ j : Fin nb, Fin (bs j).i) :
    (Multiset.map (letter bs T) Finset.univ.val).filter (fun l => l.1 = colB bs p) =
      Multiset.map (fun r : Fin (bs p.1).c => letter bs T ⟨p.1, (r, p.2)⟩) Finset.univ.val := by sorry
