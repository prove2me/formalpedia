    MvPowerSeries.map_frobenius_expand p hp
  have hfrob : frobenius (ZMod p) p = RingHom.id (ZMod p) := by
    ext x; simp [ZMod.pow_card]
  rw [hfrob, PowerSeries.map_id] at h
  simpa using h

