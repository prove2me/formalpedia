-- title:
--   Stopped feedback history is measurable from deterministic primitive prefixes
-- statement:
--   Consider a controlled system with a deterministic state feedback $F$ satisfying $F(x)_i\le x_i$. Fix a calendar time $T\ge0$, one arrival index $d_i$ per class, and deterministic bounds $p_i,q_i$ for the service and abandonment clocks. Let $\mathcal H_{d,p,q}$ be the sigma algebra generated by the interarrivals through index $d_i$ and by each service or abandonment counting path up to its respective bound. Write $D$ for the event that every $d_i$-th arrival epoch is at least $T$ and the two controlled clocks at $T$ are at most $p_i$ and $q_i$, respectively. Then for every event $B$ in the feedback history up to $T$,
--   $$B\cap D\in\mathcal H_{d,p,q}.$$
--   This is the deterministic-prefix measurability needed before applying the independent-increments argument to random operational clocks.
-- source:
--   Atar, Mandelbaum and Reiman, Scheduling a multi class queue with many exponential servers: asymptotic optimality in heavy traffic, https://arxiv.org/pdf/math/0407058#page=49, Appendix A.3, deterministic clock observation in the proof of Proposition 1

import Definitions.Def_ManyServerQED_Scheduling_Policy
open MeasureTheory Set
open scoped NNReal
open ManyServerQED.Scheduling

theorem ManyServerQED.Scheduling.feedback_past_restricted_to_primitive_cut {Ω : Type*} [mΩ : MeasurableSpace Ω] {k : ℕ}
    (M : SystemSequence Ω k) (n : ℕ) (X0 : Fin k → ℕ) (F : (Fin k → ℕ) → Fin k → ℕ)
    (hF : ∀ v i, F v i ≤ v i) (X : Ω → ℝ → Fin k → ℕ)
    (hC : M.IsControlled n X0 (fun ω t i => (X ω t i : ℝ)) (fun ω t i => (F (X ω t) i : ℝ)))
    (d : Fin k → ℕ) (p q : Fin k → ℝ≥0) (T : ℝ) (hT : 0 ≤ T) (B : Set Ω) :
    let Xr : Ω → ℝ → Fin k → ℝ := fun ω t i => (X ω t i : ℝ)
    let Ψ : Ω → ℝ → Fin k → ℝ := fun ω t i => (F (X ω t) i : ℝ)
    let G : MeasurableSpace Ω :=
      (⨆ (i : Fin k) (j : ℕ) (_ : j < d i), MeasurableSpace.comap (M.U i (j+1)) inferInstance) ⊔
        (⨆ (i : Fin k) (u : ℝ≥0) (_ : u ≤ p i), MeasurableSpace.comap (fun ω => M.S n i ω u) inferInstance) ⊔
        (⨆ (i : Fin k) (u : ℝ≥0) (_ : u ≤ q i), MeasurableSpace.comap (fun ω => M.R n i ω u) inferInstance)
    MeasurableSet[@SystemSequence.pastInfo Ω mΩ k M n Xr Ψ T] B →
      MeasurableSet[G] (B ∩ {ω | (∀ i, T ≤ @SystemSequence.arrivalEpoch Ω mΩ k M n i ω (d i)) ∧
        (∀ i, busyTime Ψ ω i T ≤ p i ∧ queueTime Xr Ψ ω i T ≤ q i)}) := by sorry
