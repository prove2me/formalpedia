-- Source module: R6Pk.R6CxNetG
/-!
# The round-six complex network in the item-language gate class (`GClassH`)

`R6CxNetFinal.net` uses `mergedChunk` (an opaque `Classical.choose` of `merge_chunk`) for its frame
changes; its steps cannot be inspected. `netG` is the same network with every merged chunk replaced by
the explicit `chunkH` (row additions, one child, row additions) chosen from `merge_identity`: same
denotation, same child widths. Its only gates are the chunk gates `GOp.mat`:

* `z_d += (k/2) z_s` with `d ≠ s` (all local ops, `C1`, `C2`): `|k|` KFG atoms `(d, s, sign k, h = 1)`;
* `z_X += -2 z_X` (`C3`): the `±1` diagonal `-1` at `X`.

**`cxNetR6G : ∃ T (J : Prop8IfaceH 207387136 T 576 Jain.cxR6) A, GClassH J A`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

attribute [local irreducible] G1 G2 cs1 cs2 E4mv S1 E4s S2 KK PL CH

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw Complex Butterfly P8Lift

/-! ## Local ops act on two distinct wires -/

/-! ## Explicit merged chunks -/

lemma mcG_den {κ : Type} [Fintype κ] [DecidableEq κ] (w : Rl) (L : List (ℤ × (Fin 576 → ZMod 2))) :
    denListH (chEx (κ := κ)) (mcG w L) = denListH (chEx (κ := κ)) (mergedChunk w L) := by
  by_cases hc : MC L
  · rw [mcG, dif_pos hc, den_chunkH, (Classical.choose_spec (merge_ex L hc)).2 κ,
      mergedChunk_den w L hc.2.1 hc.2.2]
  · rw [mcG, dif_neg hc]; unfold mergedChunk; rw [dif_neg (show ¬(L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L) from hc)]

lemma mcG_widths (w : Rl) (L : List (ℤ × (Fin 576 → ZMod 2))) :
    (mcG w L).filterMap HStep.width = (mergedChunk w L).filterMap HStep.width := by
  by_cases hc : MC L
  · rw [mcG, dif_pos hc, widths_chunkH, mergedChunk_widths w L hc.2.1 hc.2.2, if_neg hc.1,
      (Classical.choose_spec (merge_ex L hc)).1]
  · rw [mcG, dif_neg hc]; unfold mergedChunk; rw [dif_neg (show ¬(L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L) from hc)]

lemma rowAddsL_nogate (w : Rl) (js : List (Fin 576 × Fin 576)) (G : Matrix Rl Rl ℂ) :
    HStep.gate G ∉ rowAddsL w js := by
  intro h
  obtain ⟨p, _, hp⟩ := List.mem_flatMap.1 h
  split_ifs at hp <;> simp at hp

lemma mcG_nogate (w : Rl) (L : List (ℤ × (Fin 576 → ZMod 2))) (G : Matrix Rl Rl ℂ) :
    HStep.gate G ∉ mcG w L := by
  unfold mcG
  split_ifs
  · intro h
    rw [chunkH] at h
    rcases List.mem_append.1 h with h | h
    · rcases List.mem_append.1 h with h | h
      · exact rowAddsL_nogate _ _ G h
      · simp at h
    · exact rowAddsL_nogate _ _ G h
  · simp

/-! ## The network with explicit merged chunks -/

lemma den_flatMap_congr {α : Type} {κ : Type} [Fintype κ] [DecidableEq κ] (l : List α)
    (f g : α → List (HStep Rl 576)) (h : ∀ a, denListH (chEx (κ := κ)) (f a) = denListH (chEx (κ := κ)) (g a)) :
    denListH (chEx (κ := κ)) (l.flatMap f) = denListH (chEx (κ := κ)) (l.flatMap g) := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.flatMap_cons, List.flatMap_cons, denListH_append, denListH_append, ih, h]

lemma wid_flatMap_congr {α : Type} (l : List α) (f g : α → List (HStep Rl 576))
    (h : ∀ a, (f a).filterMap HStep.width = (g a).filterMap HStep.width) :
    (l.flatMap f).filterMap HStep.width = (l.flatMap g).filterMap HStep.width := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [List.flatMap_cons, List.flatMap_cons, List.filterMap_append, List.filterMap_append, ih, h]

lemma stepsG_den {κ : Type} [Fintype κ] [DecidableEq κ] (C : GChunk Rl 576) :
    denListH (chEx (κ := κ)) (stepsG C) = denListH (chEx (κ := κ)) C.steps := by
  rw [stepsG, GChunk.steps, mvSteps, denListH_append, denListH_append,
    den_flatMap_congr C.mv _ (fun p => edgeStepsM p.1 C.V p.2) (fun p => by rw [edgeStepsM, mcG_den])]

lemma stepsG_widths (C : GChunk Rl 576) :
    (stepsG C).filterMap HStep.width = C.steps.filterMap HStep.width := by
  rw [stepsG, GChunk.steps, mvSteps, List.filterMap_append, List.filterMap_append,
    wid_flatMap_congr C.mv _ (fun p => edgeStepsM p.1 C.V p.2) (fun p => by rw [edgeStepsM, mcG_widths])]

lemma netG_den {κ : Type} [Fintype κ] [DecidableEq κ] :
    denListH (chEx (κ := κ)) netG = denListH (chEx (κ := κ)) net := by
  rw [netG, net, denListH_append, denListH_append, denListH_append, denListH_append, denListH_append,
    denListH_append, progStepsG, progSteps, den_flatMap_congr CH stepsG GChunk.steps stepsG_den]

lemma netG_widths : netG.filterMap HStep.width = net.filterMap HStep.width := by
  rw [netG, net, List.filterMap_append, List.filterMap_append, List.filterMap_append,
    List.filterMap_append, List.filterMap_append, List.filterMap_append, progStepsG, progSteps,
    wid_flatMap_congr CH stepsG GChunk.steps stepsG_widths]

/-- The interface with explicit merged chunks (existence form: the interface's proof fields stay in this
theorem, so no definition carries the network proofs). -/
theorem JG_ex : ∃ J : Prop8IfaceH 207387136 Tn 576 IntMul.Kappa.Jain.cxR6, J.net = netG :=
  ⟨{ net := netG
     small := fun w hw => CH_small w (by rw [← net_widths, ← netG_widths]; exact hw)
     hist := (congrArg (fun l : List ℕ => (l : Multiset ℕ)) (netG_widths.trans net_widths)).trans CH_hist
     correct := fun κ _ _ => by
       intro w w' x y
       have h := net_correct (κ := κ) w w' x y
       rw [← netG_den] at h
       exact h }, rfl⟩

/-! ## The gates of `netG` -/

lemma ofR_phases {S : Rl → List (RStep Rl 576)} (hS : ∀ r, ∀ st ∈ S r, ∀ G, st ≠ RStep.gate G)
    (G : Matrix Rl Rl ℂ) : HStep.gate G ∉ ((univ : Finset Rl).toList.flatMap S).map HStep.ofR := by
  intro h
  obtain ⟨st, hst, he⟩ := List.mem_map.1 h
  obtain ⟨r, _, hr⟩ := List.mem_flatMap.1 hst
  cases st with
  | gate G' => exact hS r _ hr G' rfl
  | rowAdd => simp [HStep.ofR] at he
  | phase => simp [HStep.ofR] at he
  | perm => simp [HStep.ofR] at he
  | child => simp [HStep.ofR] at he

lemma preR_ng (r : Rl) : ∀ st ∈ preR r, ∀ G, st ≠ RStep.gate G := by
  intro st hst G; unfold preR at hst; split_ifs at hst <;> simp at hst; subst hst; simp

lemma postR_ng (r : Rl) : ∀ st ∈ postR r, ∀ G, st ≠ RStep.gate G := by
  intro st hst G; unfold postR at hst; split_ifs at hst <;> simp at hst; subst hst; simp

theorem netG_gate {G : Matrix Rl Rl ℂ} (h : HStep.gate G ∈ netG) : ∃ o ∈ progOps CH, G = o.mat := by
  rw [netG] at h
  rcases List.mem_append.1 h with h | h
  · rcases List.mem_append.1 h with h | h
    · rcases List.mem_append.1 h with h | h
      · exact absurd h (ofR_phases preR_ng G)
      · obtain ⟨C, hC, h⟩ := List.mem_flatMap.1 h
        rcases List.mem_append.1 h with h | h
        · obtain ⟨p, _, hp⟩ := List.mem_flatMap.1 h
          exact absurd hp (mcG_nogate _ _ G)
        · obtain ⟨o, ho, he⟩ := List.mem_map.1 h
          exact ⟨o, List.mem_flatMap.2 ⟨C, hC, ho⟩, (HStep.gate.inj he).symm⟩
    · exact absurd h (ofR_phases postR_ng G)
  · simp at h

