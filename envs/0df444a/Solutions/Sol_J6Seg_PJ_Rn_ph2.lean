namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E Function

/-- `R`, `kF`, `λF`, `w`, `λ`. -/
theorem Rn.ph2_sol_aux {s t p α d W : ℕ} {c : Cs} (hcL : c cLC = []) {vb : Vr} (hb : BV W vb)
    (h1 : vb 1 = p) (h2 : vb 2 = d) (hp : p < 2 ^ W) (hd : 2 * d + 8 < 2 ^ W)
    (hl : 2 * lamF d + 8 < 2 ^ W) (hw : wF d < 2 ^ W) :
    Rn ph2 vb c (fun v => v = update (update (update (update (update (update vb 21 ((p / 7 : ℕ) : ℤ))
      5 (kF d)) 6 (lamF d)) 26 (wF d)) 24 1) 24 (lamP d) ∧ BV W v) c (cPh2 W d) := by
  have hdl : d ≤ lamF d := by unfold lamF kF; nlinarith
  have hsq : Nat.sqrt d ≤ d := Nat.sqrt_le_self d
  have hp7 : p / 7 ≤ p := Nat.div_le_self _ _
  have hwF : (7 : ℤ) * ((Nat.sqrt d : ℤ) + 1) = ((wF d : ℕ) : ℤ) := by simp [wF, kF]
  have hlF : (d : ℤ) * ((Nat.sqrt d : ℤ) + 1) = ((lamF d : ℕ) : ℤ) := by simp [lamF, kF]
  refine Rn.seq (Rn.asgs pA1 (by decide) (by simp [pA1, lbA, E.lb]; omega) hb (by
    simp only [pA1, BndA, E.den, update_apply]
    simp [h1, h2]
    refine ⟨?_, ?_⟩
    · rw [abs_of_nonneg (by positivity)]
      have : ((p : ℤ) / 7) = ((p / 7 : ℕ) : ℤ) := by push_cast; rfl
      rw [this]; exact_mod_cast (by omega)
    · rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine Rn.seq (sqL (d := d) b1 (by simp [pA1, runA, E.den, update_apply])
    (by simp [pA1, runA, E.den, update_apply, h2]) (by simp [pA1, runA, E.den, update_apply, h2])
    (by omega) hcL) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine Rn.seq (Rn.asgs pA2 (by decide) (by simp [pA2, lbA, E.lb]; omega) b1 (by
    simp only [pA2, pA1, BndA, runA, E.den, update_apply]
    simp [h2]
    refine ⟨?_, ?_, ?_⟩
    · rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)
    · rw [abs_of_nonneg (by positivity), hlF]; exact_mod_cast (by omega)
    · rw [abs_of_nonneg (by positivity), hwF]; exact_mod_cast (by omega))) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  refine (lgL (x := lamF d) b1 (by simp [pA2, runA, E.den, update_apply])
    (by simp [pA2, pA1, runA, E.den, update_apply, h2, hlF]) (by omega) hcL).mono
    (fun v1 ⟨e1, b1⟩ => ⟨?_, b1⟩) le_rfl
  subst e1
  have e : (p : ℤ) / 7 = ((p / 7 : ℕ) : ℤ) := by push_cast; rfl
  simp only [pA2, pA1, runA, E.den, update_apply]
  funext q
  simp only [update_apply, h1, h2, e, hlF, hwF]
  split_ifs <;> simp_all [kF, lamP]

end J6Seg.PJ

