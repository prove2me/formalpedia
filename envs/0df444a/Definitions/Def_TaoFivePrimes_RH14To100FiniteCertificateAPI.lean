open CertifiedFixedPoint CertifiedHighPrecisionPi

def piBox : Box := ⟨piFloor310,piFloor310+1⟩
def centerExpBox (i : Fin 16) : Box := repeatedSquare scale310 3 (cachedPointExp i)
def lambdaBox (i : Fin 16) (n : Fin 8) : Box :=
  scaleBox ((n.val+1)^2) (mulDivBox scale310 1 piBox (centerExpBox i))

def active (i : Fin 16) (n : Fin 8) : Prop := (lambdaBox i n).lo < 800*scale310

end CertifiedThetaPoints

