section S5_sec

open IsLocalRing Polynomial

theorem glue_S5
    (q : ℕ) (W₀ : Type) [CommRing W₀] [IsLocalRing W₀]
    (S : Type) [CommRing S] [IsLocalRing S] [Algebra W₀ S]
    (e : PowerSeries W₀ ≃ₐ[W₀] S)
    (gS : S[X]) (hm : gS.Monic) (hdeg : gS.natDegree = q - 1)
    (hcoef : ∀ i < q - 1, gS.coeff i ∈ maximalIdeal S)
    (hc0 : ∃ w : S, IsUnit w ∧ gS.coeff 0 = (q : S) * w)
    (R : Type) [CommRing R] [Algebra W₀ R] (hR : Nonempty (R ≃ₐ[W₀] AdjoinRoot gS)) :
    ∃ g : Polynomial (PowerSeries W₀), g.Monic ∧ g.natDegree = q - 1 ∧
      (∀ i < q - 1, g.coeff i ∈ maximalIdeal (PowerSeries W₀)) ∧
      (∃ u : PowerSeries W₀, IsUnit u ∧ g.coeff 0 = (q : PowerSeries W₀) * u) ∧
      Nonempty (R ≃ₐ[W₀] AdjoinRoot g) := by
  classical
  obtain ⟨eR⟩ := hR
  set f : S ≃+* PowerSeries W₀ := e.symm.toRingEquiv with hf
  refine ⟨gS.map f.toRingHom, hm.map _, ?_, ?_, ?_, ?_⟩
  · rw [Polynomial.natDegree_map_eq_of_injective f.injective, hdeg]
  · intro i hi
    rw [Polynomial.coeff_map]
    have h := hcoef i hi
    rw [mem_maximalIdeal, mem_nonunits_iff] at h ⊢
    intro hu
    exact h ((MulEquiv.isUnit_map f).mp hu)
  · obtain ⟨w, hw, h0⟩ := hc0
    refine ⟨f w, hw.map f, ?_⟩
    rw [Polynomial.coeff_map, h0]
    simp
  ·
    have hI : Ideal.span {gS.map f.toRingHom} = (Ideal.span {gS}).map (Polynomial.mapEquiv f : S[X] →+* (PowerSeries W₀)[X]) := by
      rw [Ideal.map_span, Set.image_singleton]; rfl
    let ψ : AdjoinRoot gS ≃+* AdjoinRoot (gS.map f.toRingHom) :=
      Ideal.quotientEquiv (Ideal.span {gS}) (Ideal.span {gS.map f.toRingHom}) (Polynomial.mapEquiv f) hI
    have hψ : ∀ w : W₀, ψ (algebraMap W₀ (AdjoinRoot gS) w) = algebraMap W₀ (AdjoinRoot (gS.map f.toRingHom)) w := by
      intro w
      rw [IsScalarTower.algebraMap_apply W₀ S (AdjoinRoot gS),
        IsScalarTower.algebraMap_apply W₀ (PowerSeries W₀) (AdjoinRoot (gS.map f.toRingHom))]
      change ψ (Ideal.Quotient.mk _ (Polynomial.C (algebraMap W₀ S w))) =
        Ideal.Quotient.mk _ (Polynomial.C (algebraMap W₀ (PowerSeries W₀) w))
      rw [show ψ (Ideal.Quotient.mk _ (Polynomial.C (algebraMap W₀ S w))) =
          Ideal.Quotient.mk _ (Polynomial.mapEquiv f (Polynomial.C (algebraMap W₀ S w))) from
        Ideal.quotientEquiv_mk _ _ _ _ _]
      congr 1
      rw [Polynomial.mapEquiv_apply, Polynomial.map_C]
      congr 1
      exact e.symm.commutes w
    exact ⟨eR.trans (AlgEquiv.ofRingEquiv (f := ψ) hψ)⟩

end S5_sec

section ActOne_sec

open ModularCurve WeierstrassCurve.DrinfeldGlobal WeierstrassProjModel AlgebraicGeometry CategoryTheory

theorem glue_act_one
    {A : Type} [CommRing A] (𝒢 : GroupLaws A) (h𝒢O : 𝒢.IsOriginIdentity) (q : ℕ)
    (𝒯 : LevelTransport A 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    {T : Type} [CommRing T] [Algebra A T] (C : WeierstrassCurve.VariableChange T) (y : RawDrinfeldPair T)
    (hΔ : IsUnit y.curve.Δ) (hΔ' : IsUnit (𝒯.act C y).curve.Δ) :
    (y.P = (𝒢 T y.curve hΔ).one (𝟙 (base (T := T))) →
      (𝒯.act C y).P = (𝒢 T (𝒯.act C y).curve hΔ').one (𝟙 (base (T := T)))) ∧
    (y.Q ≠ (𝒢 T y.curve hΔ).one (𝟙 (base (T := T))) →
      (𝒯.act C y).Q ≠ (𝒢 T (𝒯.act C y).curve hΔ').one (𝟙 (base (T := T)))) := by
  classical
  obtain ⟨hc, hpin⟩ := h𝒯.1 T C y
  obtain ⟨φ, hφ, hvc, hiso, -⟩ := WeierstrassProjModel.exists_isVariableChangeHom_isIso_projMap y.curve C
  obtain ⟨hPpin, hQpin⟩ := hpin φ hφ hvc

  have hO : ((𝒢 T y.curve hΔ).one (𝟙 (base (T := T)))).1 = (kwZeroSect T y.curve).1 :=
    (WeierstrassProjModel.RelativeGroupLaw.exists_isOriginChartSection_iff_one_eq_kwZeroSect y.curve
      (𝒢 T y.curve hΔ)).mp (h𝒢O T y.curve hΔ)
  have hO' : ((𝒢 T (𝒯.act C y).curve hΔ').one (𝟙 (base (T := T)))).1 = (kwZeroSect T (𝒯.act C y).curve).1 :=
    (WeierstrassProjModel.RelativeGroupLaw.exists_isOriginChartSection_iff_one_eq_kwZeroSect (𝒯.act C y).curve
      (𝒢 T (𝒯.act C y).curve hΔ')).mp (h𝒢O T (𝒯.act C y).curve hΔ')

  have key : ∀ (W' : WeierstrassCurve.Projective T) (hW' : W' = C • y.curve) (P' : Section W'),
      (P'.1 ≫ eqToHom (congrArg projModelCR hW') ≫ Proj.map φ hφ = (kwZeroSect T y.curve).1 ↔
        P'.1 = (kwZeroSect T W').1) := by
    intro W' hW' P'
    subst hW'
    rw [eqToHom_refl, Category.id_comp,
      ← WeierstrassProjModel.kwZeroSect_comp_projMap_of_isVariableChangeHom y.curve C φ hφ hvc]
    haveI := hiso
    exact cancel_mono (Proj.map φ hφ)
  refine ⟨fun hP => ?_, fun hQ h => hQ ?_⟩
  · apply Subtype.ext
    rw [hO']
    exact (key _ hc _).mp (hPpin.trans (by rw [hP]; exact hO))
  · apply Subtype.ext
    rw [hO, ← hQpin]
    have : (𝒯.act C y).Q.1 = (kwZeroSect T (𝒯.act C y).curve).1 := by rw [h]; exact hO'
    exact (key _ hc _).mpr this

end ActOne_sec

section Torsion_sec

p2m_open "AlgebraicGeometry CategoryTheory CategoryTheory.Limits NeronModelInfra~schemeHomOverComp~schemeHomOverComp_coe WeierstrassProjModel"

theorem glue_nsmul_eq_one_of_comp_fst_schemeKer
    {R : Type u} [CommRing R] {V : WeierstrassCurve.Projective R}
    (G : WeierstrassProjModel.RelativeGroupLaw R (projModelStrCR V)) (n : ℕ)
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (Q : SchemeHomOver t (projModelStrCR V))
    (p : T ⟶ G.schemeKer n)
    (hp : p ≫ pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 = Q.1) :
    G.nsmul t n Q = G.one t := by
  have hQ : schemeHomOverComp Q.1 Q.2 (RelativeGroupLaw.idPoint (f := projModelStrCR V)) = Q :=
    Subtype.ext (by rw [schemeHomOverComp_coe]; exact Category.comp_id _)

  have h1 : pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ projModelStrCR V =
      pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1 := by
    calc pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ projModelStrCR V
        = pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ (G.schemeNsmul n ≫ projModelStrCR V) := by
          rw [RelativeGroupLaw.schemeNsmul_over]
      _ = (pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ G.schemeNsmul n) ≫ projModelStrCR V :=
          (Category.assoc _ _ _).symm
      _ = (pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ (G.one (𝟙 _)).1) ≫ projModelStrCR V := by
          rw [pullback.condition]
      _ = pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ ((G.one (𝟙 _)).1 ≫ projModelStrCR V) :=
          Category.assoc _ _ _
      _ = pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1 := by
          rw [(G.one (𝟙 _)).2, Category.comp_id]
  have hsnd : (p ≫ pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1) ≫ 𝟙 _ = t := by
    rw [Category.comp_id, ← h1, ← Category.assoc, hp]; exact Q.2
  apply Subtype.ext
  have hnat := congrArg Subtype.val
    (G.nsmul_natural (projModelStrCR V) t Q.1 Q.2 n (RelativeGroupLaw.idPoint (f := projModelStrCR V)))
  rw [hQ, schemeHomOverComp_coe] at hnat

  rw [← hnat]
  have h2 := congrArg Subtype.val (G.one_natural (𝟙 _) t (p ≫ pullback.snd (G.schemeNsmul n) (G.one (𝟙 _)).1) hsnd)
  rw [schemeHomOverComp_coe] at h2
  rw [← h2, ← hp, Category.assoc, Category.assoc]
  show p ≫ pullback.fst (G.schemeNsmul n) (G.one (𝟙 _)).1 ≫ G.schemeNsmul n = _
  rw [pullback.condition]

end Torsion_sec

section S1c_sec

p2m_open "ModularCurve WeierstrassCurve.DrinfeldGlobal WeierstrassProjModel IsLocalRing FormalGroup AlgebraicGeometry CategoryTheory CategoryTheory.Limits NeronModelInfra~schemeHomOverComp~schemeHomOverComp_coe"

theorem glue_rel_of_quot_mk_eq {A : Type} [CommRing A] (Rg : ModularCurve.RigidWeierstrassData A)
    {T : Type} [CommRing T] [Algebra A T] {a b : Rg.Raw T}
    (h : (Quot.mk _ a : Rg.Pt T) = Quot.mk _ b) : Rg.Rel a b := by
  have hE : Equivalence (Rg.Rel (T := T)) :=
    { refl := fun x => ModularCurve.RigidWeierstrassData.Rel.refl Rg x
      symm := by
        rintro x y ⟨C, rfl⟩
        exact ⟨C⁻¹, by rw [← Rg.act_mul, inv_mul_cancel, Rg.act_one]⟩
      trans := fun h h' => ModularCurve.RigidWeierstrassData.Rel.trans Rg h h' }
  exact hE.eqvGen_iff.mp (Quot.eqvGen_exact h)

theorem glue_kwZeroSect_comp_eqToHom {T : Type} [CommRing T] {V V' : WeierstrassCurve T} (h : V = V') :
    (kwZeroSect T V).1 ≫ eqToHom (congrArg projModelCR (show V.toProjective = V'.toProjective from h)) =
      (kwZeroSect T V').1 := by
  subst h; simp

theorem glue_S1c
    (q : ℕ) [Fact q.Prime] (ℓ M' : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) [NeZero M']
    (A₀ : Type) [CommRing A₀]
    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
