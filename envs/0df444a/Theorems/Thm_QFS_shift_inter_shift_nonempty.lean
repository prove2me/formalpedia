open Real Set Metric
open RealInnerProductSpace

open QFS

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

theorem QFS.shift_inter_shift_nonempty (V : DCone E) (x y : E) :
    (shift V.carrier x ∩ shift V.carrier y).Nonempty := by sorry
