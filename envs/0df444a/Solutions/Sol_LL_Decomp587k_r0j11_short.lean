/-! ### Part 3: Analytic Soundness of the `K = 256` Buchstab Upper Envelope -/

noncomputable section

private lemma buchstab_integral_eq {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) :
    b * ω b - a * ω a = ∫ s in (a - 1)..(b - 1), ω s := by
  rcases hω with ⟨hcont, _, hderiv⟩
  have hsub : Icc a b ⊆ Ici (1 : ℝ) := fun x hx => le_trans (by linarith) hx.1
  have hcont_mul : ContinuousOn (fun v => v * ω v) (Icc a b) :=
    continuousOn_id.mul (hcont.mono hsub)
  have hderiv_open : ∀ x ∈ Ioo a b, HasDerivAt (fun v => v * ω v) (ω (x - 1)) x :=
    fun x hx => hderiv x (by linarith [hx.1])
  have hcont_shift : ContinuousOn (fun t => ω (t - 1)) (Icc a b) := by
    refine hcont.comp (continuousOn_id.sub continuousOn_const) ?_
    intro x hx; change 1 ≤ x - 1; linarith [hx.1]
  have hint : IntervalIntegrable (fun t => ω (t - 1)) volume a b :=
    hcont_shift.intervalIntegrable_of_Icc hab
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab hcont_mul hderiv_open hint
  rw [← hftc, intervalIntegral.integral_comp_sub_right]

private lemma buchstab_nonneg_on_Icc {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ n : ℕ, ∀ u : ℝ, 1 ≤ u → u ≤ (n : ℝ) + 2 → 0 ≤ ω u := by
  intro n
  induction n with
  | zero =>
    intro u hu1 hu2
    push_cast at hu2
    rw [hω.2.1 u hu1 (by linarith)]
    positivity
  | succ n ih =>
    intro u hu1 hu2
    by_cases hle : u ≤ (n : ℝ) + 2
    · exact ih u hu1 hle
    · push Not at hle
      set b : ℝ := (n : ℝ) + 2
      have hb2 : 2 ≤ b := by dsimp only [b]; linarith [Nat.cast_nonneg (α := ℝ) n]
      have hbu : b ≤ u := le_of_lt hle
      have heq := buchstab_integral_eq hω hb2 hbu
      have hwb : 0 ≤ ω b := ih b (by linarith) (le_refl b)
      have hint_nn : 0 ≤ ∫ s in (b - 1)..(u - 1), ω s := by
        apply intervalIntegral.integral_nonneg (by linarith)
        intro s hs
        exact ih s (by linarith [hs.1]) (by push_cast at hu2; linarith [hs.2])
      have hu_pos : 0 < u := by linarith
      have hmul : 0 ≤ u * ω u := by nlinarith
      exact nonneg_of_mul_nonneg_right hmul hu_pos

private lemma buchstab_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (u : ℝ) : 0 ≤ ω u := by
  by_cases h1 : u < 1
  · rw [hz u h1]
  · push Not at h1
    exact buchstab_nonneg_on_Icc hω (Nat.ceil u) u h1 (by linarith [Nat.le_ceil u])

private lemma integral_inv_le_trapezoid {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / s : ℝ) ≤ (b - a) / 2 * (1 / a + 1 / b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont1 : ContinuousOn (fun s : ℝ => 1 / s) (Icc a b) :=
    continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hcont2 : ContinuousOn (fun s : ℝ => (a + b - s) / (a * b)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div_const (a * b)
  have hmono : ∫ s in a..b, (1 / s : ℝ) ≤ ∫ s in a..b, (a + b - s) / (a * b) := by
    apply intervalIntegral.integral_mono_on hab
      (hcont1.intervalIntegrable_of_Icc hab) (hcont2.intervalIntegrable_of_Icc hab)
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le ha hs.1
    rw [div_le_div_iff₀ hs_pos (mul_pos ha hb)]
    nlinarith [hs.1, hs.2]
  have heval : ∫ s in a..b, (a + b - s) / (a * b) = (b - a) / 2 * (1 / a + 1 / b) := by
    have hderiv : ∀ x ∈ uIcc a b,
        HasDerivAt (fun s : ℝ => ((a + b) * s - s ^ 2 / 2) / (a * b)) ((a + b - x) / (a * b)) x := by
      intro x _
      have h1 : HasDerivAt (fun s : ℝ => (a + b) * s) (a + b) x := by
        simpa using (hasDerivAt_id x).const_mul (a + b)
      have h2 : HasDerivAt (fun s : ℝ => s ^ 2 / 2) x x := by
        simpa [mul_comm] using ((hasDerivAt_pow 2 x).div_const 2)
      exact (h1.sub h2).div_const (a * b)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont2.intervalIntegrable_of_Icc hab)]
    field_simp; ring
  linarith

private lemma integral_inv_sq_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / (s * s) : ℝ) = 1 / a - 1 / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => 1 / (s * s)) (Icc a b) :=
    continuousOn_const.div (continuousOn_id.mul continuousOn_id)
      (fun s hs => mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1)))
  have hderiv : ∀ x ∈ uIcc a b, HasDerivAt (fun s : ℝ => -1 / s) (1 / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    have h : HasDerivAt (fun s : ℝ => -(s⁻¹)) (-(-(x ^ 2)⁻¹)) x := (hasDerivAt_inv hx_ne).neg
    have hfun : (fun s : ℝ => (-1 : ℝ) / s) = (fun s : ℝ => -(s⁻¹)) := by
      funext s; rw [neg_div, one_div]
    have hval : (1 : ℝ) / (x * x) = -(-(x ^ 2)⁻¹) := by rw [neg_neg, ← one_div, sq]
    rw [hfun, hval]; exact h
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  ring

private lemma integral_sub_div_cube_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, ((b - s) / (s * s * s) : ℝ) = (b - a) ^ 2 / (2 * a * a * b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => (b - s) / (s * s * s)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div
      ((continuousOn_id.mul continuousOn_id).mul continuousOn_id)
      (fun s hs => by
        have hp : 0 < s := lt_of_lt_of_le ha hs.1
        positivity)
  have hderiv : ∀ x ∈ uIcc a b,
      HasDerivAt (fun s : ℝ => -b / (2 * s ^ 2) + 1 / s) ((b - x) / (x * x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    have hsq : HasDerivAt (fun s : ℝ => s ^ 2) (2 * x) x := by
      simpa using hasDerivAt_pow 2 x
    have h1 : HasDerivAt (fun s : ℝ => (2 * s ^ 2 : ℝ)) (4 * x) x := by
      have := hsq.const_mul (2 : ℝ)
      rwa [show (2 : ℝ) * (2 * x) = 4 * x by ring] at this
    have h2x2 : (2 * x ^ 2 : ℝ) ≠ 0 := mul_ne_zero two_ne_zero (pow_ne_zero 2 hx_ne)
    have hq1 := (hasDerivAt_const x (-b)).div h1 h2x2
    have hq2 := (hasDerivAt_const x (1 : ℝ)).div (hasDerivAt_id x) hx_ne
    have hadd : HasDerivAt (fun s : ℝ => -b / (2 * s ^ 2) + 1 / s)
        ((0 * (2 * x ^ 2) - -b * (4 * x)) / (2 * x ^ 2) ^ 2 + (0 * x - 1 * 1) / x ^ 2) x :=
      hq1.add hq2
    have hval : (0 * (2 * x ^ 2) - -b * (4 * x)) / (2 * x ^ 2) ^ 2 +
        (0 * x - 1 * 1) / x ^ 2 = (b - x) / (x * x * x) := by
      field_simp [hx_ne]; ring
    rwa [hval] at hadd
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  field_simp; ring

private lemma buchstab_max_propagate {ω : ℝ → ℝ} (hω : IsBuchstab ω) {a M : ℝ}
    (ha : 1 ≤ a) (hbase : ∀ u ∈ Icc a (a + 1), ω u ≤ M) :
    ∀ u : ℝ, a ≤ u → ω u ≤ M := by
  have hstep : ∀ n : ℕ, ∀ u ∈ Icc a (a + 1 + n), ω u ≤ M := by
    intro n
    induction n with
    | zero => intro u hu; exact hbase u (by simpa using hu)
    | succ n ih =>
      intro u hu
      by_cases hle : u ≤ a + 1 + n
      · exact ih u ⟨hu.1, hle⟩
      · push Not at hle
        set b : ℝ := a + 1 + n
        have hn_nn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
        have hb2 : 2 ≤ b := by dsimp only [b]; linarith
        have hbu : b ≤ u := le_of_lt hle
        have heq := buchstab_integral_eq hω hb2 hbu
        have hwb : ω b ≤ M := ih b ⟨by dsimp only [b]; linarith, le_refl b⟩
        have hcont_sub : ContinuousOn ω (Icc (b - 1) (u - 1)) :=
          hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
        have hint_le : ∫ s in (b - 1)..(u - 1), ω s ≤ (u - b) * M := by
          have h1 : ∫ s in (b - 1)..(u - 1), ω s ≤ ∫ _ in (b - 1)..(u - 1), M := by
            apply intervalIntegral.integral_mono_on (by linarith)
              (hcont_sub.intervalIntegrable_of_Icc (by linarith))
              intervalIntegrable_const
            intro s hs
            exact ih s ⟨by dsimp only [b] at hs; linarith [hs.1],
              by dsimp only [b]; push_cast at hu; linarith [hs.2, hu.2]⟩
          rw [intervalIntegral.integral_const, smul_eq_mul] at h1
          linarith
        have hu_pos : 0 < u := by linarith
        have hmul : u * ω u ≤ u * M := by nlinarith
        exact le_of_mul_le_mul_left hmul hu_pos
  intro u hu
  exact hstep (Nat.ceil (u - a)) u ⟨hu, by linarith [Nat.le_ceil (u - a)]⟩

private lemma affine_div_le_of_endpoints {a b u c va M : ℝ} (hab : a < b)
    (hau : a ≤ u) (hub : u ≤ b)
    (h1 : va ≤ c * a) (h2 : va + (b - a) * M ≤ c * b) :
    va + (u - a) * M ≤ c * u := by
  have hba : 0 < b - a := sub_pos.mpr hab
  have hlam0 : 0 ≤ (u - a) / (b - a) := div_nonneg (sub_nonneg.mpr hau) (le_of_lt hba)
  have hlam1 : 0 ≤ (b - u) / (b - a) := div_nonneg (sub_nonneg.mpr hub) (le_of_lt hba)
  have hcomb : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      ≤ ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b) := by
    nlinarith
  have hlhs : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      = va + (u - a) * M := by field_simp; ring
  have hrhs : ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b)
      = c * u := by field_simp; ring
  linarith

private def tk (k : Nat) : ℝ := 1 + (k : ℝ) / 256

private lemma buchstab_table_sound_aux {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    (gV gU : ℕ → ℕ)
    (hV256 : S_scale ≤ gV 256)
    (hall : ∀ k < 1024, checkBuchstabStepWith gV gU k = true) :
    (∀ k ≤ 1024, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
    (∀ k < 1024, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hmain : ∀ m : ℕ, m ≤ 1024 →
      (∀ k ≤ m, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
      (∀ k < m, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
    intro m
    induction m with
    | zero =>
      intro _
      refine ⟨?_, fun k hk => by omega⟩
      intro k hk
      have hk0 : k = 0 := by omega
      subst hk0
      have hstep0 := hall 0 (by omega)
      simp only [checkBuchstabStepWith, (by omega : 0 < 256), ↓reduceIte, Bool.and_eq_true,
        decide_eq_true_eq] at hstep0
      have htk0 : tk 0 = 1 := by unfold tk; norm_num
      rw [htk0, hω.2.1 1 (le_refl 1) (by norm_num)]
      have hV0 : (S_scale : ℝ) ≤ (gV 0 : ℝ) := by exact_mod_cast hstep0.1
      rw [le_div_iff₀ hSpos]; linarith
    | succ m ih =>
      intro hm
      have ⟨ihV, ihU⟩ := ih (by omega)
      have hstep := hall m (by omega)
      have hUm : ∀ u ∈ Icc (tk m) (tk (m + 1)), ω u ≤ (gU m : ℝ) / S_scale := by
        intro u hu
        by_cases hm1 : m < 256
        · simp only [checkBuchstabStepWith, hm1, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hstep
          have hu1 : 1 ≤ u := by unfold tk at hu; linarith [hu.1, (show (0 : ℝ) ≤ (m : ℝ) / 256 by positivity)]
          have hu2 : u ≤ 2 := by
            unfold tk at hu
            have hm_le : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
            have htk_le : 1 + ((m + 1 : ℕ) : ℝ) / 256 ≤ 2 := by push_cast; linarith
            linarith [hu.2]
          rw [hω.2.1 u hu1 hu2]
          have htk_pos : 0 < tk m := by unfold tk; positivity
          have hinv : 1 / u ≤ 1 / tk m := one_div_le_one_div_of_le htk_pos hu.1
          have hnat : (S_scale : ℝ) * K_grid ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by
            exact_mod_cast hstep.2
          have htk_eq : tk m = ((K_grid : ℝ) + m) / K_grid := by
            unfold tk K_grid; push_cast; ring
          have hKm_pos : (0 : ℝ) < (K_grid : ℝ) + m := by unfold K_grid; positivity
          have h2 : 1 / tk m ≤ (gU m : ℝ) / S_scale := by
            rw [htk_eq, one_div_div, div_le_div_iff₀ hKm_pos hSpos]; linarith
          linarith
        · by_cases hm2 : m < 512
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨_, _⟩, hU1⟩, hU2⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub_pos : (0 : ℝ) < tk m - 1 := by linarith
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤ (u - tk m) * (1 / (tk m - 1)) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), (1 / (tk m - 1) : ℝ) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                have hs1 : 1 ≤ s := by linarith [hs.1]
                have hs2 : s ≤ 2 := by
                  unfold tk at hu
                  have : (m : ℝ) + 1 ≤ 512 := by exact_mod_cast (by omega : m + 1 ≤ 512)
                  have : u ≤ 3 := by push_cast at hu; linarith [hu.2]
                  linarith [hs.2]
                rw [hω.2.1 s hs1 hs2]
                exact one_div_le_one_div_of_le htm_sub_pos hs.1
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1; linarith
            have huw_le : u * ω u ≤ (gV m : ℝ) / S_scale + (u - tk m) * (1 / (tk m - 1)) := by linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (256 : ℝ) * gV m ≤ (gU m : ℝ) * (256 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (256 : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                (m : ℝ) * (256 + (m : ℝ) + 1) * gU m := by
              have : (K_grid : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                  (m : ℝ) * ((K_grid : ℝ) + m + 1) * gU m := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk; rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * (1 / (tk m - 1)) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
              have hdiff : tk (m + 1) - tk m = 1 / 256 := by unfold tk; push_cast; ring
              have hsub1 : tk m - 1 = (m : ℝ) / 256 := by unfold tk; ring
              rw [hdiff, hsub1]
              have hterm : (1 / 256 : ℝ) * (1 / ((m : ℝ) / 256)) = 1 / m := by field_simp
              rw [hterm]
              unfold tk; push_cast; rw [div_mul_eq_mul_div]
              have hS_ne : (S_scale : ℝ) ≠ 0 := ne_of_gt hSpos
              have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
              rw [div_add_div _ _ hS_ne hm_ne, div_le_div_iff₀ (mul_pos hSpos hm_pos) hSpos]
              nlinarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, hU1⟩, hU2⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (512 : ℝ) ≤ m := by exact_mod_cast (by omega : 512 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 256) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 256 + 1) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                (u - tk m) * ((gU (m - 256) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), ((gU (m - 256) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 256) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, hu.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1; linarith
            have huw_le : u * ω u ≤
                (gV m : ℝ) / S_scale + (u - tk m) * ((gU (m - 256) : ℝ) / S_scale) := by linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (256 : ℝ) * gV m ≤ (gU m : ℝ) * (256 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (256 : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * (256 + (m : ℝ) + 1) := by
              have : (K_grid : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * ((K_grid : ℝ) + m + 1) := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have hVstepr : (gU (m - 256) : ℝ) ≤ (256 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 256) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; unfold K_grid at h1; norm_num at h1; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk; rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * ((gU (m - 256) : ℝ) / S_scale) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hdiff : tk (m + 1) - tk m = 1 / 256 := by unfold tk; push_cast; ring
              rw [hdiff]; unfold tk; push_cast
              have h1 : (gV m : ℝ) / S_scale + 1 / 256 * ((gU (m - 256) : ℝ) / S_scale) ≤
                  (gV (m + 1) : ℝ) / S_scale := by
                rw [← mul_div_assoc, ← add_div, div_le_div_iff_of_pos_right hSpos]; linarith
              have h2 : (gV (m + 1) : ℝ) / S_scale ≤
                  (gU m : ℝ) / S_scale * (1 + ((m : ℝ) + 1) / 256) := by
                rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]; linarith
              linarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
      have hVm1 : tk (m + 1) * ω (tk (m + 1)) ≤ (gV (m + 1) : ℝ) / S_scale := by
        by_cases hm1 : m < 256
        · have htk_le2 : tk (m + 1) ≤ 2 := by
            unfold tk; have : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
            push_cast; linarith
          have htk_ge1 : 1 ≤ tk (m + 1) := by unfold tk; linarith [Nat.cast_nonneg (α := ℝ) (m + 1)]
          rw [hω.2.1 (tk (m + 1)) htk_ge1 htk_le2]
          have htk_ne : tk (m + 1) ≠ 0 := ne_of_gt (by linarith)
          rw [mul_one_div_cancel htk_ne]
          have hVge : S_scale ≤ gV (m + 1) := by
            by_cases hm255 : m + 1 < 256
            · have hs := hall (m + 1) (by omega)
              simp only [checkBuchstabStepWith, hm255, ↓reduceIte, Bool.and_eq_true,
                decide_eq_true_eq] at hs
              exact hs.1
            · have : m + 1 = 256 := by omega
              rw [this]; exact hV256
          have hVr : (S_scale : ℝ) ≤ gV (m + 1) := by exact_mod_cast hVge
          rw [le_div_iff₀ hSpos]; linarith
        · by_cases hm2 : m < 512
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have hint_eq : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s =
                ∫ s in (tk m - 1)..(tk (m + 1) - 1), (1 / s : ℝ) := by
              apply intervalIntegral.integral_congr
              intro s hs
              rw [uIcc_of_le (by linarith)] at hs
              have hs1 : 1 ≤ s := by linarith [hs.1]
              have hs2 : s ≤ 2 := by
                unfold tk at hs; have : (m : ℝ) + 1 ≤ 512 := by exact_mod_cast (by omega : m + 1 ≤ 512)
                push_cast at hs; linarith [hs.2]
              exact hω.2.1 s hs1 hs2
            have htrap := integral_inv_le_trapezoid (a := tk m - 1) (b := tk (m + 1) - 1)
              (by linarith) (by linarith)
            have hsub0 : tk m - 1 = (m : ℝ) / 256 := by unfold tk; ring
            have hsub1 : tk (m + 1) - 1 = ((m : ℝ) + 1) / 256 := by unfold tk; push_cast; ring
            have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
            have htrap_simp : (tk (m + 1) - 1 - (tk m - 1)) / 2 *
                (1 / (tk m - 1) + 1 / (tk (m + 1) - 1)) =
                (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) := by
              rw [hsub0, hsub1]; field_simp; ring
            have hVstepr : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                  2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; exact h1
            have hstep_r : (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [div_le_div_iff₀ (by positivity) hSpos]; linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk; have : (512 : ℝ) ≤ m := by exact_mod_cast (by omega : 512 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 256) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 256 + 1) := by
              unfold tk; have hm256 : 256 ≤ m := by omega
              have hcast : ((m - 256 : ℕ) : ℝ) = (m : ℝ) - 256 := by rw [Nat.cast_sub hm256, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                (1 / 256 : ℝ) * ((gU (m - 256) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (tk (m + 1) - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(tk (m + 1) - 1), ((gU (m - 256) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith)
                  (hcont_w.intervalIntegrable_of_Icc (by linarith))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 256) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1
              have hdiff : tk (m + 1) - 1 - (tk m - 1) = 1 / 256 := by unfold tk; push_cast; ring
              rw [hdiff] at h1; exact h1
            have hVstepr : (gU (m - 256) : ℝ) ≤ (256 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 256) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; unfold K_grid at h1; norm_num at h1; linarith
            have hstep_r : (1 / 256 : ℝ) * ((gU (m - 256) : ℝ) / S_scale) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [← mul_div_assoc, div_le_div_iff_of_pos_right hSpos]; linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
      refine ⟨?_, ?_⟩
      · intro k hk
        by_cases hkm : k ≤ m
        · exact ihV k hkm
        · have : k = m + 1 := by omega
          subst this; exact hVm1
      · intro k hk
        by_cases hkm : k < m
        · exact ihU k hkm
        · have : k = m := by omega
          subst this; exact hUm
  exact hmain 1024 (le_refl 1024)

private lemma buchstab_table_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    (∀ k ≤ 1024, tk k * ω (tk k) ≤ (getV k : ℝ) / S_scale) ∧
    (∀ k < 1024, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (getU k : ℝ) / S_scale) :=
  buchstab_table_sound_aux hω getV getU validBuchstab_V256 (fun _ hk => validBuchstab_all hk)

private lemma buchstab_le_M4 {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu : 4 ≤ u) :
    ω u ≤ (M4_val : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  apply buchstab_max_propagate hω (a := 4) (by norm_num) _ u hu
  intro x hx
  have hx_le5 : x ≤ 5 := by linarith [hx.2]
  by_cases hx5 : x = 5
  · subst hx5
    have hx_in : (5 : ℝ) ∈ Icc (tk 1023) (tk 1024) := by unfold tk; constructor <;> norm_num
    have h1 := hU 1023 (by omega) 5 hx_in
    have hle : (getU 1023 : ℝ) ≤ M4_val := by exact_mod_cast getU1023_le_M4
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))
  · have hx_lt5 : x < 5 := lt_of_le_of_ne hx_le5 hx5
    set k : ℕ := Nat.floor ((x - 1) * 256)
    have hk_ge : 768 ≤ k := Nat.le_floor (by push_cast; linarith [hx.1])
    have hk_lt : k < 1024 := (Nat.floor_lt (by linarith [hx.1])).mpr (by push_cast; linarith)
    have hfl1 : (k : ℝ) ≤ (x - 1) * 256 := Nat.floor_le (by linarith [hx.1])
    have hfl2 : (x - 1) * 256 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
    have hx_in : x ∈ Icc (tk k) (tk (k + 1)) := by unfold tk; push_cast; constructor <;> linarith
    have h1 := hU k hk_lt x hx_in
    have hst := validBuchstab_all hk_lt
    have hn1 : ¬ k < 256 := by omega
    have hn2 : ¬ k < 512 := by omega
    simp only [checkBuchstabStepWith, hn1, hn2, hk_ge, ↓reduceIte, Bool.and_eq_true,
      decide_eq_true_eq] at hst
    have hle : (getU k : ℝ) ≤ M4_val := by exact_mod_cast hst.2
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))

private lemma getU_le_buchstabUB {k0 k1 k : ℕ} (h0 : k0 ≤ k) (h1 : k ≤ k1) (hk : k < 768) :
    getU k ≤ buchstabUB k0 k1 := by
  have hm0 : ∀ i j, i ≤ j → j ≤ 255 → getU j ≤ getU i := by
    intro i j hij hj
    exact mono_dec_le (f := getU) (a := 0) (b := 255) (fun t _ ht => monoU_0_spec ht) (Nat.zero_le i) hij hj
  have hm1 : ∀ i j, 256 ≤ i → i ≤ j → j ≤ 450 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 256) (b := 450) (fun t ht1 ht2 => monoU_1_spec ht1 ht2) hi hij hj
  have hm2 : ∀ i j, 450 ≤ i → i ≤ j → j ≤ 631 → getU j ≤ getU i := by
    intro i j hi hij hj
    exact mono_dec_le (f := getU) (a := 450) (b := 631) (fun t ht1 ht2 => monoU_2_spec ht1 ht2) hi hij hj
  have hm3 : ∀ i j, 631 ≤ i → i ≤ j → j ≤ 767 → getU i ≤ getU j := by
    intro i j hi hij hj
    exact mono_inc_le (f := getU) (a := 631) (b := 767) (fun t ht1 ht2 => monoU_3_spec ht1 ht2) hi hij hj
  unfold buchstabUB
  have hk0_lt : Nat.ble 768 k0 = false := by rw [ble_false_iff]; omega
  rw [hk0_lt]; dsimp only
  split
  · rename_i h; rw [Nat.ble_eq] at h; exact hm0 k0 k h0 (by omega)
  · split
    · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm1 k k1 (by omega) h1 (by omega)
    · split
      · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm2 k0 k (by omega) h0 (by omega)
      · split
        · rename_i ha hb; rw [Nat.ble_eq] at ha hb; exact hm3 k k1 (by omega) h1 (by omega)
        · exact getU_le_buchstabUB_fallback hm0 hm1 hm2 hm3 h0 h1 hk

private lemma M4_le_buchstabUB {k0 k1 : ℕ} (hk1 : 768 ≤ k1) :
    M4_val ≤ buchstabUB k0 k1 := by
  have hfb : M4_val ≤ buchstabUB_fallback k0 k1 := by
    unfold buchstabUB_fallback; dsimp only
    have h768 : Nat.ble 768 k1 = true := by rw [Nat.ble_eq]; omega
    rw [h768]; dsimp only
    exact le_trans (le_trans (le_trans (le_max2_right _ _) (le_max2_right _ _)) (le_max2_right _ _)) (le_max2_right _ _)
  unfold buchstabUB
  split
  · exact le_refl _
  · split
    · rename_i h; rw [Nat.ble_eq] at h; omega
    · split
      · rename_i _ h; rw [Nat.ble_eq] at h; omega
      · split
        · rename_i _ h; rw [Nat.ble_eq] at h; omega
        · split
          · rename_i _ h; rw [Nat.ble_eq] at h; omega
          · exact hfb

private lemma buchstab_le_buchstabUB {ω : ℝ → ℝ} (hω : IsBuchstab ω) {k0 k1 : ℕ}
    (hk01 : k0 ≤ k1) {u : ℝ} (hlo : tk k0 ≤ u) (hhi : u ≤ tk (k1 + 1)) :
    ω u ≤ (buchstabUB k0 k1 : ℝ) / S_scale := by
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  by_cases hu4 : 4 < u
  · have hk1_ge : 768 ≤ k1 := by
      unfold tk at hhi; push_cast at hhi
      have : (768 : ℝ) < (k1 : ℝ) + 1 := by linarith
      have : (768 : ℕ) < k1 + 1 := by exact_mod_cast this
      omega
    exact le_trans (buchstab_le_M4 hω (le_of_lt hu4))
      (div_le_div_of_nonneg_right (by exact_mod_cast M4_le_buchstabUB hk1_ge) (le_of_lt hSpos))
  · push Not at hu4
    by_cases hu4eq : u = 4
    · subst hu4eq
      by_cases hk0_ge : 768 ≤ k0
      · have hM : M4_val ≤ buchstabUB k0 k1 := by
          unfold buchstabUB; have : Nat.ble 768 k0 = true := by rw [Nat.ble_eq]; omega
          rw [this]
        exact le_trans (buchstab_le_M4 hω (le_refl 4))
          (div_le_div_of_nonneg_right (by exact_mod_cast hM) (le_of_lt hSpos))
      · have hk1_ge : 767 ≤ k1 := by
          unfold tk at hhi; push_cast at hhi
          have : (768 : ℝ) ≤ (k1 : ℝ) + 1 := by linarith
          have : (768 : ℕ) ≤ k1 + 1 := by exact_mod_cast this
          omega
        have hx_in : (4 : ℝ) ∈ Icc (tk 767) (tk 768) := by unfold tk; constructor <;> norm_num
        have h1 := hU 767 (by omega) 4 hx_in
        have h2 : getU 767 ≤ buchstabUB k0 k1 := getU_le_buchstabUB (by omega) hk1_ge (by omega)
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hu_lt4 : u < 4 := lt_of_le_of_ne hu4 hu4eq
      have hu1 : 1 ≤ u := by unfold tk at hlo; linarith [(show (0 : ℝ) ≤ (k0 : ℝ) / 256 by positivity)]
      by_cases heq : u = tk (k1 + 1)
      · have hk1_lt : k1 < 768 := by
          rw [heq] at hu_lt4; unfold tk at hu_lt4; push_cast at hu_lt4
          have : (k1 : ℝ) + 1 < 768 := by linarith
          have : k1 + 1 < 768 := by exact_mod_cast this
          omega
        have hx_in : u ∈ Icc (tk k1) (tk (k1 + 1)) := by
          rw [heq]; unfold tk; push_cast; constructor <;> linarith
        have h1 := hU k1 (by omega) u hx_in
        have h2 : getU k1 ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk01 (le_refl k1) hk1_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
      · have hu_lt : u < tk (k1 + 1) := lt_of_le_of_ne hhi heq
        set k : ℕ := Nat.floor ((u - 1) * 256)
        have hk0_le : k0 ≤ k := Nat.le_floor (by unfold tk at hlo; linarith)
        have hk_le1 : k ≤ k1 := by
          have hlt : (u - 1) * 256 < ((k1 + 1 : ℕ) : ℝ) := by unfold tk at hu_lt; push_cast at *; linarith
          have := (Nat.floor_lt (by linarith)).mpr hlt; omega
        have hk_lt : k < 768 := (Nat.floor_lt (by linarith)).mpr (by push_cast; linarith)
        have hx_in : u ∈ Icc (tk k) (tk (k + 1)) := by
          unfold tk; push_cast
          constructor <;> linarith [Nat.floor_le (a := (u - 1) * 256) (by linarith),
                                    Nat.lt_floor_add_one ((u - 1) * 256)]
        have h1 := hU k (by omega) u hx_in
        have h2 : getU k ≤ buchstabUB k0 k1 := getU_le_buchstabUB hk0_le hk_le1 hk_lt
        exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))

/-! ### Part 4: Exact Elementary Weight Integrals & Unified `BoxTree` Soundness -/

private lemma setIntegral_union_le_of_nonneg {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B : Set α} {f : α → ℝ} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hnnB : ∀ x ∈ B, 0 ≤ f x) (hintA : IntegrableOn f A μ) (hintB : IntegrableOn f B μ) :
    ∫ x in A ∪ B, f x ∂μ ≤ (∫ x in A, f x ∂μ) + (∫ x in B, f x ∂μ) := by
  have hAB : A ∪ B = A ∪ (B \ A) := (Set.union_sdiff_self).symm
  rw [hAB, setIntegral_union disjoint_sdiff_self_right (hB.diff hA) hintA
    (hintB.mono_set Set.sdiff_subset)]
  have hle : ∫ x in B \ A, f x ∂μ ≤ ∫ x in B, f x ∂μ :=
    setIntegral_mono_set hintB
      (ae_restrict_of_forall_mem hB hnnB)
      (Filter.Eventually.of_forall Set.sdiff_subset)
  linarith

/-! ### Part 4: Exact Elementary Weight Integrals & Unified `BoxTree` Soundness -/

private lemma integral_inv_eq_log_div {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / s : ℝ) = Real.log (b / a) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => (1 / s : ℝ)) (Icc a b) :=
    continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hderiv : ∀ x ∈ uIcc a b, HasDerivAt Real.log (1 / x) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    simpa [one_div] using Real.hasDerivAt_log hne
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab),
      ← Real.log_div (ne_of_gt hb) (ne_of_gt ha)]

private lemma log_div_le_simpson {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    Real.log (b / a) ≤ (b - a) * ((a + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  set t : ℝ := b / a
  have ht1 : 1 ≤ t := (one_le_div ha).mpr hab
  have haux : ∀ x : ℝ, 1 ≤ x →
      Real.log x ≤ (x - 1) * ((x + 1) ^ 2 + 8 * x) / (6 * x * (x + 1)) := by
    intro x hx
    let f : ℝ → ℝ := fun u =>
      (u - 1) * ((u + 1) ^ 2 + 8 * u) / (6 * u * (u + 1)) - Real.log u
    have hderiv : ∀ u ∈ Ici (1 : ℝ),
        HasDerivAt f ((u - 1) ^ 4 / (6 * u ^ 2 * (u + 1) ^ 2)) u := by
      intro u hu
      have hu0 : 0 < u := lt_of_lt_of_le zero_lt_one hu
      have hu1 : 0 < u + 1 := by linarith
      have hnum : HasDerivAt (fun s : ℝ => (s - 1) * ((s + 1) ^ 2 + 8 * s))
          (1 * ((u + 1) ^ 2 + 8 * u) + (u - 1) * (2 * (u + 1) ^ 1 * 1 + 8)) u := by
        have h1 : HasDerivAt (fun s : ℝ => s - 1) 1 u := (hasDerivAt_id u).sub_const 1
        have h2 : HasDerivAt (fun s : ℝ => (s + 1) ^ 2) (2 * (u + 1) ^ 1 * 1) u :=
          ((hasDerivAt_id u).add_const 1).pow 2
        have h3 : HasDerivAt (fun s : ℝ => 8 * s) 8 u := by
          simpa using (hasDerivAt_id u).const_mul 8
        exact h1.mul (h2.add h3)
      have hden : HasDerivAt (fun s : ℝ => 6 * s * (s + 1)) (6 * (u + 1) + 6 * u * 1) u := by
        have h1 : HasDerivAt (fun s : ℝ => 6 * s) 6 u := by
          simpa using (hasDerivAt_id u).const_mul 6
        have h2 : HasDerivAt (fun s : ℝ => s + 1) 1 u := (hasDerivAt_id u).add_const 1
        exact h1.mul h2
      have hq := hnum.div hden (by positivity)
      have hsub := hq.sub (Real.hasDerivAt_log (ne_of_gt hu0))
      have hu0' : u ≠ 0 := ne_of_gt hu0
      have hu1' : u + 1 ≠ 0 := ne_of_gt hu1
      refine hsub.congr_deriv ?_
      field_simp
      ring
    have hmono : MonotoneOn f (Ici 1) := by
      apply monotoneOn_of_deriv_nonneg (convex_Ici 1)
      · exact fun u hu => (hderiv u hu).continuousAt.continuousWithinAt
      · exact fun u hu => (hderiv u (interior_subset hu)).differentiableAt.differentiableWithinAt
      · intro u hu
        rw [(hderiv u (interior_subset hu)).deriv]
        have hu0 : 0 < u := lt_of_lt_of_le zero_lt_one (interior_subset hu)
        positivity
    have hf1 : f 1 = 0 := by simp [f]
    have hle := hmono (Set.mem_Ici.mpr (le_refl 1)) (Set.mem_Ici.mpr hx) hx
    rw [hf1] at hle
    dsimp only [f] at hle
    linarith
  have h := haux t ht1
  have heq : (t - 1) * ((t + 1) ^ 2 + 8 * t) / (6 * t * (t + 1)) =
      (b - a) * ((a + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) := by
    dsimp only [t]
    have ha' : a ≠ 0 := ne_of_gt ha
    have hb' : b ≠ 0 := ne_of_gt hb
    have hab' : a + b ≠ 0 := by linarith
    field_simp
    ring
  linarith

private lemma pade_le_log_div {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    3 * (b ^ 2 - a ^ 2) / (a ^ 2 + 4 * a * b + b ^ 2) ≤ Real.log (b / a) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  set t : ℝ := b / a
  have ht1 : 1 ≤ t := (one_le_div ha).mpr hab
  have haux : ∀ x : ℝ, 1 ≤ x →
      3 * (x ^ 2 - 1) / (x ^ 2 + 4 * x + 1) ≤ Real.log x := by
    intro x hx
    let g : ℝ → ℝ := fun u =>
      Real.log u - 3 * (u ^ 2 - 1) / (u ^ 2 + 4 * u + 1)
    have hderiv : ∀ u ∈ Ici (1 : ℝ),
        HasDerivAt g ((u - 1) ^ 4 / (u * (u ^ 2 + 4 * u + 1) ^ 2)) u := by
      intro u hu
      have hu0 : 0 < u := lt_of_lt_of_le zero_lt_one hu
      have hden_pos : 0 < u ^ 2 + 4 * u + 1 := by positivity
      have hnum : HasDerivAt (fun s : ℝ => 3 * (s ^ 2 - 1)) (3 * (2 * u ^ 1)) u :=
        ((hasDerivAt_pow 2 u).sub_const 1).const_mul 3
      have hden : HasDerivAt (fun s : ℝ => s ^ 2 + 4 * s + 1) (2 * u ^ 1 + 4) u := by
        have h1 := hasDerivAt_pow 2 u
        have h2 : HasDerivAt (fun s : ℝ => 4 * s) 4 u := by
          simpa using (hasDerivAt_id u).const_mul 4
        exact (h1.add h2).add_const 1
      have hsub := (Real.hasDerivAt_log (ne_of_gt hu0)).sub (hnum.div hden (ne_of_gt hden_pos))
      have hu0' : u ≠ 0 := ne_of_gt hu0
      have hden' : u ^ 2 + 4 * u + 1 ≠ 0 := ne_of_gt hden_pos
      refine hsub.congr_deriv ?_
      field_simp
      ring
    have hmono : MonotoneOn g (Ici 1) := by
      apply monotoneOn_of_deriv_nonneg (convex_Ici 1)
      · exact fun u hu => (hderiv u hu).continuousAt.continuousWithinAt
      · exact fun u hu => (hderiv u (interior_subset hu)).differentiableAt.differentiableWithinAt
      · intro u hu
        rw [(hderiv u (interior_subset hu)).deriv]
        have hu0 : 0 < u := lt_of_lt_of_le zero_lt_one (interior_subset hu)
        positivity
    have hg1 : g 1 = 0 := by simp [g]
    have hle := hmono (Set.mem_Ici.mpr (le_refl 1)) (Set.mem_Ici.mpr hx) hx
    rw [hg1] at hle
    dsimp only [g] at hle
    linarith
  have h := haux t ht1
  have heq : 3 * (t ^ 2 - 1) / (t ^ 2 + 4 * t + 1) =
      3 * (b ^ 2 - a ^ 2) / (a ^ 2 + 4 * a * b + b ^ 2) := by
    dsimp only [t]
    have ha' : a ≠ 0 := ne_of_gt ha
    have hpos : a ^ 2 + 4 * a * b + b ^ 2 ≠ 0 := by positivity
    field_simp
    ring
  linarith

private lemma integral_log_div_a_div_sq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, Real.log (s / a) / (s * s) = (b - a) / (a * b) - Real.log (b / a) / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => Real.log (s / a) / (s * s)) (Icc a b) := by
    refine ContinuousOn.div ?_ (continuousOn_id.mul continuousOn_id) ?_
    · exact (Real.continuousOn_log.comp (continuousOn_id.div_const a)
        (fun s hs => ne_of_gt (div_pos (lt_of_lt_of_le ha hs.1) ha)))
    · intro s hs; exact mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hderiv : ∀ x ∈ uIcc a b,
      HasDerivAt (fun s : ℝ => -(Real.log (s / a) + 1) / s) (Real.log (x / a) / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx0 : 0 < x := lt_of_lt_of_le ha hx.1
    have hlog : HasDerivAt (fun s : ℝ => Real.log (s / a)) ((x / a)⁻¹ * (1 / a)) x := by
      have hd : HasDerivAt (fun s : ℝ => s / a) (1 / a) x := by
        simpa using (hasDerivAt_id x).div_const a
      exact (Real.hasDerivAt_log (ne_of_gt (div_pos hx0 ha))).comp x hd
    have hnum : HasDerivAt (fun s : ℝ => -(Real.log (s / a) + 1)) (-((x / a)⁻¹ * (1 / a))) x :=
      (hlog.add_const 1).neg
    have hq := hnum.div (hasDerivAt_id x) (ne_of_gt hx0)
    have ha' : a ≠ 0 := ne_of_gt ha
    have hx' : x ≠ 0 := ne_of_gt hx0
    refine hq.congr_deriv ?_
    simp only [id_eq]
    field_simp
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  rw [div_self (ne_of_gt ha), Real.log_one]
  have ha' : a ≠ 0 := ne_of_gt ha
  have hb' : b ≠ 0 := ne_of_gt hb
  field_simp
  ring

private lemma integral_log_b_div_div_sq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, Real.log (b / s) / (s * s) = Real.log (b / a) / a - (b - a) / (a * b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => Real.log (b / s) / (s * s)) (Icc a b) := by
    refine ContinuousOn.div ?_ (continuousOn_id.mul continuousOn_id) ?_
    · refine Real.continuousOn_log.comp
        (continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1)))
        (fun s hs => ne_of_gt (div_pos hb (lt_of_lt_of_le ha hs.1)))
    · intro s hs; exact mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hderiv : ∀ x ∈ uIcc a b,
      HasDerivAt (fun s : ℝ => (-Real.log (b / s) + 1) / s) (Real.log (b / x) / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx0 : 0 < x := lt_of_lt_of_le ha hx.1
    have hb' : b ≠ 0 := ne_of_gt hb
    have hx' : x ≠ 0 := ne_of_gt hx0
    have hdiv : HasDerivAt (fun s : ℝ => b / s) (-(b / x ^ 2)) x := by
      have h := (hasDerivAt_const x b).div (hasDerivAt_id x) hx'
      refine h.congr_deriv ?_; simp only [id_eq]; field_simp; ring
    have hlog : HasDerivAt (fun s : ℝ => Real.log (b / s)) ((b / x)⁻¹ * (-(b / x ^ 2))) x :=
      (Real.hasDerivAt_log (ne_of_gt (div_pos hb hx0))).comp x hdiv
    have hnum : HasDerivAt (fun s : ℝ => -Real.log (b / s) + 1) (-((b / x)⁻¹ * (-(b / x ^ 2)))) x :=
      hlog.neg.add_const 1
    have hq := hnum.div (hasDerivAt_id x) hx'
    refine hq.congr_deriv ?_
    simp only [id_eq]
    field_simp
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  rw [div_self (ne_of_gt hb), Real.log_one]
  have ha' : a ≠ 0 := ne_of_gt ha
  have hb' : b ≠ 0 := ne_of_gt hb
  field_simp
  ring

private lemma integral_log_prod_div_sq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, Real.log (s / a) * Real.log (b / s) / (s * s) =
      (Real.log (b / a) - 2) / a + (Real.log (b / a) + 2) / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => Real.log (s / a) * Real.log (b / s) / (s * s)) (Icc a b) := by
    refine ContinuousOn.div ?_ (continuousOn_id.mul continuousOn_id) ?_
    · refine ContinuousOn.mul ?_ ?_
      · exact Real.continuousOn_log.comp (continuousOn_id.div_const a)
          (fun s hs => ne_of_gt (div_pos (lt_of_lt_of_le ha hs.1) ha))
      · exact Real.continuousOn_log.comp
          (continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1)))
          (fun s hs => ne_of_gt (div_pos hb (lt_of_lt_of_le ha hs.1)))
    · intro s hs; exact mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hderiv : ∀ x ∈ uIcc a b,
      HasDerivAt
        (fun s : ℝ => -(Real.log (s / a) * Real.log (b / s) + Real.log (b / s) - Real.log (s / a) - 2) / s)
        (Real.log (x / a) * Real.log (b / x) / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx0 : 0 < x := lt_of_lt_of_le ha hx.1
    have ha' : a ≠ 0 := ne_of_gt ha
    have hb' : b ≠ 0 := ne_of_gt hb
    have hx' : x ≠ 0 := ne_of_gt hx0
    have hlog1 : HasDerivAt (fun s : ℝ => Real.log (s / a)) (1 / x) x := by
      have hd : HasDerivAt (fun s : ℝ => s / a) (1 / a) x := by
        simpa using (hasDerivAt_id x).div_const a
      have h := (Real.hasDerivAt_log (ne_of_gt (div_pos hx0 ha))).comp x hd
      refine h.congr_deriv ?_; field_simp
    have hlog2 : HasDerivAt (fun s : ℝ => Real.log (b / s)) (-(1 / x)) x := by
      have hd : HasDerivAt (fun s : ℝ => b / s) (-(b / x ^ 2)) x := by
        have h := (hasDerivAt_const x b).div (hasDerivAt_id x) hx'
        refine h.congr_deriv ?_; simp only [id_eq]; field_simp; ring
      have h := (Real.hasDerivAt_log (ne_of_gt (div_pos hb hx0))).comp x hd
      refine h.congr_deriv ?_; field_simp
    have hnum : HasDerivAt
        (fun s : ℝ => -(Real.log (s / a) * Real.log (b / s) + Real.log (b / s) - Real.log (s / a) - 2))
        (-((1 / x * Real.log (b / x) + Real.log (x / a) * (-(1 / x))) + (-(1 / x)) - 1 / x)) x :=
      ((((hlog1.mul hlog2).add hlog2).sub hlog1).sub_const 2).neg
    have hq := hnum.div (hasDerivAt_id x) hx'
    refine hq.congr_deriv ?_
    simp only [id_eq]
    field_simp
    ring
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  rw [div_self (ne_of_gt ha), div_self (ne_of_gt hb), Real.log_one]
  ring

private lemma wInv_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) ≤ (wInv a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hsimp : ((b : ℝ) / D_den) / ((a : ℝ) / D_den) = (b : ℝ) / a := by
    have : (D_den : ℝ) ≠ 0 := ne_of_gt hDpos; field_simp
  rw [hsimp]
  have hlog := log_div_le_simpson har habr
  have hden_pos : 0 < 6 * a * b * (a + b) := by positivity
  have hceil := le_mul_ceilDiv (a := W_scale * (b - a) * ((a + b) * (a + b) + 8 * a * b)) hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * ((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) ≤
      (6 * (a : ℝ) * b * (a + b)) * (wInv a b : ℝ) := by
    have h1 : ((W_scale * (b - a) * ((a + b) * (a + b) + 8 * a * b) : ℕ) : ℝ) ≤
        ((6 * a * b * (a + b) * wInv a b : ℕ) : ℝ) := by exact_mod_cast hceil
    push_cast [hsub] at h1
    linarith
  have hle : ((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b)) ≤
      (wInv a b : ℝ) / W_scale := by
    rw [div_le_div_iff₀ (by positivity) hWpos]
    linarith
  linarith

private lemma wInvSq_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    1 / ((a : ℝ) / D_den) - 1 / ((b : ℝ) / D_den) ≤ (wInvSq a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have hsimp : 1 / ((a : ℝ) / D_den) - 1 / ((b : ℝ) / D_den) =
      (D_den : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by field_simp
  rw [hsimp]
  have hab_pos : 0 < a * b := Nat.mul_pos ha hb
  have hceil : W_scale * D_den * (b - a) ≤ (a * b) * wInvSq a b := le_mul_ceilDiv hab_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * D_den * ((b : ℝ) - a) ≤ (a : ℝ) * b * (wInvSq a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  rw [div_le_div_iff₀ (by positivity) hWpos]
  linarith

private lemma wDiag01_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) -
      Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) / ((b : ℝ) / D_den) ≤
      (wDiag01 a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hlog := pade_le_log_div har habr
  have hstep1 :
      ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) -
        Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) / ((b : ℝ) / D_den) ≤
      (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * ((b : ℝ) + 2 * a) /
        ((a : ℝ) * b * ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) := by
    have hD' : (D_den : ℝ) ≠ 0 := ne_of_gt hDpos
    have hdiv_eq : ((b : ℝ) / D_den) / ((a : ℝ) / D_den) = (b : ℝ) / a := by field_simp
    rw [hdiv_eq]
    have h1 : (D_den : ℝ) * (3 * ((b : ℝ) ^ 2 - a ^ 2) / ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) / b ≤
        Real.log ((b : ℝ) / a) / ((b : ℝ) / D_den) := by
      rw [div_div_eq_mul_div, mul_comm (Real.log _)]
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hlog (le_of_lt hDpos)) (le_of_lt hbr)
    have h2 :
        ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) -
          (D_den : ℝ) * (3 * ((b : ℝ) ^ 2 - a ^ 2) / ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) / b =
        (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * ((b : ℝ) + 2 * a) /
          ((a : ℝ) * b * ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) := by
      have ha' : (a : ℝ) ≠ 0 := ne_of_gt har
      have hb' : (b : ℝ) ≠ 0 := ne_of_gt hbr
      have hpos : (a : ℝ) ^ 2 + 4 * a * b + b ^ 2 ≠ 0 := by positivity
      field_simp
      ring
    linarith
  have hden_pos : 0 < a * b * (a * a + 4 * a * b + b * b) := by positivity
  have hceil := le_mul_ceilDiv
    (a := W_scale * W_scale * D_den * (b - a) * (b - a) * (b + 2 * a)) hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * W_scale * D_den * ((b : ℝ) - a) ^ 2 * ((b : ℝ) + 2 * a) ≤
      ((a : ℝ) * b * ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) * (wDiag01 a b : ℝ) := by
    have h1 : ((W_scale * W_scale * D_den * (b - a) * (b - a) * (b + 2 * a) : ℕ) : ℝ) ≤
        ((a * b * (a * a + 4 * a * b + b * b) * wDiag01 a b : ℕ) : ℝ) := by exact_mod_cast hceil
    push_cast [hsub] at h1
    linarith
  have hstep2 :
      (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * ((b : ℝ) + 2 * a) /
        ((a : ℝ) * b * ((a : ℝ) ^ 2 + 4 * a * b + b ^ 2)) ≤
      (wDiag01 a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    linarith
  linarith

private lemma wDiag12_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) / ((a : ℝ) / D_den) -
      ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) ≤
      (wDiag12 a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hlog := log_div_le_simpson har habr
  have hstep1 :
      Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) / ((a : ℝ) / D_den) -
        ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) ≤
      (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * (5 * a + b) /
        (6 * (a : ℝ) ^ 2 * b * (a + b)) := by
    have hD' : (D_den : ℝ) ≠ 0 := ne_of_gt hDpos
    have hdiv_eq : ((b : ℝ) / D_den) / ((a : ℝ) / D_den) = (b : ℝ) / a := by field_simp
    rw [hdiv_eq]
    have h1 : Real.log ((b : ℝ) / a) / ((a : ℝ) / D_den) ≤
        (D_den : ℝ) * (((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b))) / a := by
      rw [div_div_eq_mul_div, mul_comm (Real.log _)]
      exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left hlog (le_of_lt hDpos)) (le_of_lt har)
    have h2 :
        (D_den : ℝ) * (((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b))) / a -
          ((b : ℝ) / D_den - (a : ℝ) / D_den) / (((a : ℝ) / D_den) * ((b : ℝ) / D_den)) =
        (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * (5 * a + b) /
          (6 * (a : ℝ) ^ 2 * b * (a + b)) := by
      have ha' : (a : ℝ) ≠ 0 := ne_of_gt har
      have hb' : (b : ℝ) ≠ 0 := ne_of_gt hbr
      have hab' : (a : ℝ) + b ≠ 0 := by positivity
      field_simp
      ring
    linarith
  have hden_pos : 0 < 6 * a * a * b * (a + b) := by positivity
  have hceil := le_mul_ceilDiv
    (a := W_scale * W_scale * D_den * (b - a) * (b - a) * (5 * a + b)) hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * W_scale * D_den * ((b : ℝ) - a) ^ 2 * (5 * a + b) ≤
      (6 * (a : ℝ) ^ 2 * b * (a + b)) * (wDiag12 a b : ℝ) := by
    have h1 : ((W_scale * W_scale * D_den * (b - a) * (b - a) * (5 * a + b) : ℕ) : ℝ) ≤
        ((6 * a * a * b * (a + b) * wDiag12 a b : ℕ) : ℝ) := by exact_mod_cast hceil
    push_cast [hsub] at h1
    linarith
  have hstep2 :
      (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * (5 * a + b) /
        (6 * (a : ℝ) ^ 2 * b * (a + b)) ≤
      (wDiag12 a b : ℝ) / ((W_scale : ℝ) * W_scale) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    linarith
  linarith

private lemma wDiag012_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    (Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) - 2) / ((a : ℝ) / D_den) +
      (Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) + 2) / ((b : ℝ) / D_den) ≤
      (wDiag012 a b : ℝ) / ((W_scale : ℝ) * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) ≤ b := by exact_mod_cast hab
  have hlog := log_div_le_simpson har habr
  have hstep1 :
      (Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) - 2) / ((a : ℝ) / D_den) +
        (Real.log (((b : ℝ) / D_den) / ((a : ℝ) / D_den)) + 2) / ((b : ℝ) / D_den) ≤
      (D_den : ℝ) * ((b : ℝ) - a) ^ 3 / (6 * (a : ℝ) ^ 2 * (b : ℝ) ^ 2) := by
    have hD' : (D_den : ℝ) ≠ 0 := ne_of_gt hDpos
    have ha' : (a : ℝ) ≠ 0 := ne_of_gt har
    have hb' : (b : ℝ) ≠ 0 := ne_of_gt hbr
    have hab' : (a : ℝ) + b ≠ 0 := by positivity
    have hdiv_eq : ((b : ℝ) / D_den) / ((a : ℝ) / D_den) = (b : ℝ) / a := by field_simp
    rw [hdiv_eq]
    have hrew :
        (Real.log ((b : ℝ) / a) - 2) / ((a : ℝ) / D_den) +
          (Real.log ((b : ℝ) / a) + 2) / ((b : ℝ) / D_den) =
        (D_den : ℝ) * ((a : ℝ) + b) / ((a : ℝ) * b) * Real.log ((b : ℝ) / a) -
          2 * (D_den : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by
      field_simp
      ring
    rw [hrew]
    have h1 := mul_le_mul_of_nonneg_left hlog
      (show (0 : ℝ) ≤ (D_den : ℝ) * ((a : ℝ) + b) / ((a : ℝ) * b) by positivity)
    have h2 :
        (D_den : ℝ) * ((a : ℝ) + b) / ((a : ℝ) * b) *
          (((b : ℝ) - a) * (((a : ℝ) + b) ^ 2 + 8 * a * b) / (6 * a * b * (a + b))) -
          2 * (D_den : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) =
        (D_den : ℝ) * ((b : ℝ) - a) ^ 3 / (6 * (a : ℝ) ^ 2 * (b : ℝ) ^ 2) := by
      field_simp
      ring
    linarith
  have hden_pos : 0 < 6 * a * a * b * b := by positivity
  have hceil := le_mul_ceilDiv
    (a := W_scale * W_scale * W_scale * D_den * (b - a) * (b - a) * (b - a)) hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * W_scale * W_scale * D_den * ((b : ℝ) - a) ^ 3 ≤
      (6 * (a : ℝ) ^ 2 * (b : ℝ) ^ 2) * (wDiag012 a b : ℝ) := by
    have h1 : ((W_scale * W_scale * W_scale * D_den * (b - a) * (b - a) * (b - a) : ℕ) : ℝ) ≤
        ((6 * a * a * b * b * wDiag012 a b : ℕ) : ℝ) := by exact_mod_cast hceil
    push_cast [hsub] at h1
    linarith
  have hstep2 :
      (D_den : ℝ) * ((b : ℝ) - a) ^ 3 / (6 * (a : ℝ) ^ 2 * (b : ℝ) ^ 2) ≤
      (wDiag012 a b : ℝ) / ((W_scale : ℝ) * W_scale * W_scale) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    linarith
  linarith

/-! ### Geometric Cells and 3D Fubini Weight Reductions -/

private def cellSet (knd : CellKind) (a0 b0 a1 b1 a2 b2 : ℝ) : Set (Fin 3 → ℝ) :=
  match knd with
  | .box   => {x | x 0 ∈ Icc a0 b0 ∧ x 1 ∈ Icc a1 b1 ∧ x 2 ∈ Icc a2 b2}
  | .tri01 => {x | x 0 ∈ Icc a0 b0 ∧ x 1 ∈ Icc a0 b0 ∧ x 2 ∈ Icc a2 b2 ∧ x 0 ≤ x 1}
  | .tri12 => {x | x 0 ∈ Icc a0 b0 ∧ x 1 ∈ Icc a1 b1 ∧ x 2 ∈ Icc a1 b1 ∧ x 1 ≤ x 2}
  | .simp  => {x | x 0 ∈ Icc a0 b0 ∧ x 1 ∈ Icc a0 b0 ∧ x 2 ∈ Icc a0 b0 ∧ x 0 ≤ x 1 ∧ x 1 ≤ x 2}

private lemma cellSet_isClosed (knd : CellKind) (a0 b0 a1 b1 a2 b2 : ℝ) :
    IsClosed (cellSet knd a0 b0 a1 b1 a2 b2) := by
  have hc0 : ∀ l r : ℝ, IsClosed {x : Fin 3 → ℝ | x 0 ∈ Icc l r} := fun l r =>
    isClosed_Icc.preimage (continuous_apply 0)
  have hc1 : ∀ l r : ℝ, IsClosed {x : Fin 3 → ℝ | x 1 ∈ Icc l r} := fun l r =>
    isClosed_Icc.preimage (continuous_apply 1)
  have hc2 : ∀ l r : ℝ, IsClosed {x : Fin 3 → ℝ | x 2 ∈ Icc l r} := fun l r =>
    isClosed_Icc.preimage (continuous_apply 2)
  have hle01 : IsClosed {x : Fin 3 → ℝ | x 0 ≤ x 1} :=
    isClosed_le (continuous_apply 0) (continuous_apply 1)
  have hle12 : IsClosed {x : Fin 3 → ℝ | x 1 ≤ x 2} :=
    isClosed_le (continuous_apply 1) (continuous_apply 2)
  cases knd with
  | box => exact (hc0 a0 b0).inter ((hc1 a1 b1).inter (hc2 a2 b2))
  | tri01 => exact (hc0 a0 b0).inter ((hc1 a0 b0).inter ((hc2 a2 b2).inter hle01))
  | tri12 => exact (hc0 a0 b0).inter ((hc1 a1 b1).inter ((hc2 a1 b1).inter hle12))
  | simp => exact (hc0 a0 b0).inter ((hc1 a0 b0).inter ((hc2 a0 b0).inter (hle01.inter hle12)))

private lemma cellSet_measurable (knd : CellKind) (a0 b0 a1 b1 a2 b2 : ℝ) :
    MeasurableSet (cellSet knd a0 b0 a1 b1 a2 b2) :=
  (cellSet_isClosed knd a0 b0 a1 b1 a2 b2).measurableSet

private lemma cellSet_isCompact (knd : CellKind) (a0 b0 a1 b1 a2 b2 : ℝ) :
    IsCompact (cellSet knd a0 b0 a1 b1 a2 b2) := by
  have hbox_comp : ∀ l0 r0 l1 r1 l2 r2 : ℝ,
      IsCompact (Set.univ.pi ![Icc l0 r0, Icc l1 r1, Icc l2 r2]) := fun l0 r0 l1 r1 l2 r2 =>
    isCompact_univ_pi fun j => by fin_cases j <;> exact isCompact_Icc
  cases knd with
  | box =>
    refine (hbox_comp a0 b0 a1 b1 a2 b2).of_isClosed_subset (cellSet_isClosed .box _ _ _ _ _ _) ?_
    intro x hx j _; fin_cases j
    · simpa using hx.1
    · simpa using hx.2.1
    · simpa using hx.2.2
  | tri01 =>
    refine (hbox_comp a0 b0 a0 b0 a2 b2).of_isClosed_subset (cellSet_isClosed .tri01 _ _ _ _ _ _) ?_
    intro x hx j _; fin_cases j
    · simpa using hx.1
    · simpa using hx.2.1
    · simpa using hx.2.2.1
  | tri12 =>
    refine (hbox_comp a0 b0 a1 b1 a1 b1).of_isClosed_subset (cellSet_isClosed .tri12 _ _ _ _ _ _) ?_
    intro x hx j _; fin_cases j
    · simpa using hx.1
    · simpa using hx.2.1
    · simpa using hx.2.2.1
  | simp =>
    refine (hbox_comp a0 b0 a0 b0 a0 b0).of_isClosed_subset (cellSet_isClosed .simp _ _ _ _ _ _) ?_
    intro x hx j _; fin_cases j
    · simpa using hx.1
    · simpa using hx.2.1
    · simpa using hx.2.2.1

private lemma box_weight_integral {a0 b0 a1 b1 a2 b2 : ℝ}
    (ha0 : 0 < a0) (ha1 : 0 < a1) (ha2 : 0 < a2)
    (h0 : a0 ≤ b0) (h1 : a1 ≤ b1) (h2 : a2 ≤ b2) :
    ∫ x in cellSet .box a0 b0 a1 b1 a2 b2, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      Real.log (b0 / a0) * (1 / a1 - 1 / b1) * Real.log (b2 / a2) := by
  have hset : cellSet .box a0 b0 a1 b1 a2 b2 =
      Set.univ.pi ![Icc a0 b0, Icc a1 b1, Icc a2 b2] := by
    ext x
    simp only [cellSet, mem_ofPred_eq, mem_univ_pi]
    constructor
    · rintro ⟨h0x, h1x, h2x⟩ j; fin_cases j <;> simpa
    · intro h; exact ⟨by simpa using h 0, by simpa using h 1, by simpa using h 2⟩
  rw [hset]
  have hfun : (fun x : Fin 3 → ℝ => (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ)) =
      (fun x : Fin 3 → ℝ => ∏ j : Fin 3,
        (![fun t : ℝ => 1 / t, fun t : ℝ => 1 / (t * t), fun t : ℝ => 1 / t] j) (x j)) := by
    ext x; simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]; ring
  rw [hfun]
  have hvol : (volume : Measure (Fin 3 → ℝ)).restrict (Set.univ.pi ![Icc a0 b0, Icc a1 b1, Icc a2 b2]) =
      Measure.pi (fun j : Fin 3 => (volume : Measure ℝ).restrict (![Icc a0 b0, Icc a1 b1, Icc a2 b2] j)) :=
    Measure.restrict_pi_pi (fun _ : Fin 3 => (volume : Measure ℝ)) _
  rw [hvol, MeasureTheory.integral_fintype_prod_eq_prod]
  simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h0,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h1,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h2,
      integral_inv_eq_log_div ha0 h0, integral_inv_sq_eq ha1 h1, integral_inv_eq_log_div ha2 h2]

private def equivFin3_1 : (Fin 3 → ℝ) ≃ᵐ ℝ × (ℝ × ℝ) :=
  (MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) 1).trans
    (MeasurableEquiv.prodCongr (MeasurableEquiv.refl ℝ) (MeasurableEquiv.finTwoArrow))

private lemma volume_preserving_equivFin3_1 :
    MeasurePreserving equivFin3_1 (volume : Measure (Fin 3 → ℝ))
      ((volume : Measure ℝ).prod ((volume : Measure ℝ).prod (volume : Measure ℝ))) := by
  unfold equivFin3_1
  exact (MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) 1).trans
    ((MeasurePreserving.id volume).prod (MeasureTheory.volume_preserving_finTwoArrow ℝ))

private lemma equivFin3_1_apply (x : Fin 3 → ℝ) :
    equivFin3_1 x = (x 1, (x 0, x 2)) := rfl

private lemma weight_integral_via_x1 {S : Set (Fin 3 → ℝ)} {T : Set (ℝ × (ℝ × ℝ))}
    (hST : S = equivFin3_1 ⁻¹' T) :
    ∫ x in S, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      ∫ p in T, (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ) ∂((volume : Measure ℝ).prod ((volume : Measure ℝ).prod (volume : Measure ℝ))) := by
  have hfun : (fun x : Fin 3 → ℝ => (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ)) =
      (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) ∘ equivFin3_1 := by
    ext x
    simp only [Function.comp_apply, equivFin3_1_apply, Fin.prod_univ_three]
  rw [hST, hfun]
  exact volume_preserving_equivFin3_1.setIntegral_preimage_emb equivFin3_1.measurableEmbedding
    (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) T

private lemma tri01_weight_integral {a b a2 b2 : ℝ}
    (ha : 0 < a) (ha2 : 0 < a2) (hab : a ≤ b) (h2 : a2 ≤ b2) :
    ∫ x in cellSet .tri01 a b a b a2 b2, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      ((b - a) / (a * b) - Real.log (b / a) / b) * Real.log (b2 / a2) := by
  let T : Set (ℝ × (ℝ × ℝ)) :=
    {p | p.1 ∈ Icc a b ∧ p.2.1 ∈ Icc a b ∧ p.2.2 ∈ Icc a2 b2 ∧ p.2.1 ≤ p.1}
  have hST : cellSet .tri01 a b a b a2 b2 = equivFin3_1 ⁻¹' T := by
    ext x; simp only [cellSet, T, mem_preimage, mem_ofPred_eq, equivFin3_1_apply]; tauto
  rw [weight_integral_via_x1 hST]
  let B : Set (ℝ × (ℝ × ℝ)) := Icc a b ×ˢ (Icc a b ×ˢ Icc a2 b2)
  let P : Set (ℝ × (ℝ × ℝ)) := {p | p.2.1 ≤ p.1}
  have hT_eq : T = B ∩ P := by
    ext ⟨x1, x0, x2⟩; simp only [T, B, P, mem_inter_iff, mem_prod, mem_ofPred_eq]; tauto
  have hP_meas : MeasurableSet P :=
    (isClosed_le (continuous_fst.comp continuous_snd) continuous_fst).measurableSet
  rw [hT_eq, ← setIntegral_indicator hP_meas]
  have hint_ind : IntegrableOn
      (P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ))) B
      (volume.prod (volume.prod volume)) := by
    refine IntegrableOn.indicator ?_ hP_meas
    apply ContinuousOn.integrableOn_compact
      (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
    refine continuousOn_const.div ?_ ?_
    · exact (((continuous_fst.comp continuous_snd).mul continuous_fst).mul
        (continuous_snd.comp continuous_snd)).mul continuous_fst |>.continuousOn
    · rintro ⟨x1, x0, x2⟩ ⟨hx1, hx0, hx2⟩
      have h0p : 0 < x0 := lt_of_lt_of_le ha hx0.1
      have h1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
      have h2p : 0 < x2 := lt_of_lt_of_le ha2 hx2.1
      positivity
  dsimp only [B]
  rw [MeasureTheory.setIntegral_prod _ hint_ind]
  have hinner : ∀ x1 ∈ Icc a b,
      ∫ q in Icc a b ×ˢ Icc a2 b2,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) ∂(volume.prod volume) =
      (Real.log (x1 / a) / (x1 * x1)) * Real.log (b2 / a2) := by
    intro x1 hx1
    have hx1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
    have hEq_ind : ∀ q : ℝ × ℝ,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) =
        ({q : ℝ × ℝ | q.1 ≤ x1}).indicator
          (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) q := by
      intro q; by_cases hq : q.1 ≤ x1 <;> simp [P, hq]
    simp_rw [hEq_ind]
    have hQm : MeasurableSet {q : ℝ × ℝ | q.1 ≤ x1} :=
      (isClosed_le continuous_fst continuous_const).measurableSet
    rw [setIntegral_indicator hQm]
    have hS_eq : (Icc a b ×ˢ Icc a2 b2) ∩ {q : ℝ × ℝ | q.1 ≤ x1} = Icc a x1 ×ˢ Icc a2 b2 := by
      ext ⟨x0, x2⟩
      simp only [mem_inter_iff, mem_prod, mem_Icc, mem_ofPred_eq]
      constructor
      · rintro ⟨⟨⟨h1, _⟩, h2⟩, h3⟩; exact ⟨⟨h1, h3⟩, h2⟩
      · rintro ⟨⟨h1, h3⟩, h2⟩; exact ⟨⟨⟨h1, le_trans h3 hx1.2⟩, h2⟩, h3⟩
    rw [hS_eq]
    have hfun : (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) =
        (fun q : ℝ × ℝ => (1 / (x1 * x1)) * ((1 / q.1) * (1 / q.2))) := by
      ext ⟨x0, x2⟩; ring
    rw [hfun, integral_const_mul, MeasureTheory.setIntegral_prod_mul,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.1,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h2,
        integral_inv_eq_log_div ha hx1.1, integral_inv_eq_log_div ha2 h2]
    ring
  rw [setIntegral_congr_fun measurableSet_Icc hinner,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab,
      intervalIntegral.integral_mul_const, integral_log_div_a_div_sq ha hab]

private lemma tri12_weight_integral {a0 b0 a b : ℝ}
    (ha0 : 0 < a0) (ha : 0 < a) (h0 : a0 ≤ b0) (hab : a ≤ b) :
    ∫ x in cellSet .tri12 a0 b0 a b a b, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      Real.log (b0 / a0) * (Real.log (b / a) / a - (b - a) / (a * b)) := by
  let T : Set (ℝ × (ℝ × ℝ)) :=
    {p | p.1 ∈ Icc a b ∧ p.2.1 ∈ Icc a0 b0 ∧ p.2.2 ∈ Icc a b ∧ p.1 ≤ p.2.2}
  have hST : cellSet .tri12 a0 b0 a b a b = equivFin3_1 ⁻¹' T := by
    ext x; simp only [cellSet, T, mem_preimage, mem_ofPred_eq, equivFin3_1_apply]; tauto
  rw [weight_integral_via_x1 hST]
  let B : Set (ℝ × (ℝ × ℝ)) := Icc a b ×ˢ (Icc a0 b0 ×ˢ Icc a b)
  let P : Set (ℝ × (ℝ × ℝ)) := {p | p.1 ≤ p.2.2}
  have hT_eq : T = B ∩ P := by
    ext ⟨x1, x0, x2⟩; simp only [T, B, P, mem_inter_iff, mem_prod, mem_ofPred_eq]; tauto
  have hP_meas : MeasurableSet P :=
    (isClosed_le continuous_fst (continuous_snd.comp continuous_snd)).measurableSet
  rw [hT_eq, ← setIntegral_indicator hP_meas]
  have hint_ind : IntegrableOn
      (P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ))) B
      (volume.prod (volume.prod volume)) := by
    refine IntegrableOn.indicator ?_ hP_meas
    apply ContinuousOn.integrableOn_compact
      (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
    refine continuousOn_const.div ?_ ?_
    · exact (((continuous_fst.comp continuous_snd).mul continuous_fst).mul
        (continuous_snd.comp continuous_snd)).mul continuous_fst |>.continuousOn
    · rintro ⟨x1, x0, x2⟩ ⟨hx1, hx0, hx2⟩
      have h0p : 0 < x0 := lt_of_lt_of_le ha0 hx0.1
      have h1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
      have h2p : 0 < x2 := lt_of_lt_of_le ha hx2.1
      positivity
  dsimp only [B]
  rw [MeasureTheory.setIntegral_prod _ hint_ind]
  have hinner : ∀ x1 ∈ Icc a b,
      ∫ q in Icc a0 b0 ×ˢ Icc a b,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) ∂(volume.prod volume) =
      Real.log (b0 / a0) * (Real.log (b / x1) / (x1 * x1)) := by
    intro x1 hx1
    have hx1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
    have hEq_ind : ∀ q : ℝ × ℝ,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) =
        ({q : ℝ × ℝ | x1 ≤ q.2}).indicator
          (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) q := by
      intro q; by_cases hq : x1 ≤ q.2 <;> simp [P, hq]
    simp_rw [hEq_ind]
    have hQm : MeasurableSet {q : ℝ × ℝ | x1 ≤ q.2} :=
      (isClosed_le continuous_const continuous_snd).measurableSet
    rw [setIntegral_indicator hQm]
    have hS_eq : (Icc a0 b0 ×ˢ Icc a b) ∩ {q : ℝ × ℝ | x1 ≤ q.2} = Icc a0 b0 ×ˢ Icc x1 b := by
      ext ⟨x0, x2⟩
      simp only [mem_inter_iff, mem_prod, mem_Icc, mem_ofPred_eq]
      constructor
      · rintro ⟨⟨h0x, ⟨_, h2b⟩⟩, h3⟩; exact ⟨h0x, ⟨h3, h2b⟩⟩
      · rintro ⟨h0x, ⟨h3, h2b⟩⟩; exact ⟨⟨h0x, ⟨le_trans hx1.1 h3, h2b⟩⟩, h3⟩
    rw [hS_eq]
    have hfun : (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) =
        (fun q : ℝ × ℝ => (1 / (x1 * x1)) * ((1 / q.1) * (1 / q.2))) := by
      ext ⟨x0, x2⟩; ring
    rw [hfun, integral_const_mul, MeasureTheory.setIntegral_prod_mul,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h0,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.2,
        integral_inv_eq_log_div ha0 h0, integral_inv_eq_log_div hx1p hx1.2]
    ring
  rw [setIntegral_congr_fun measurableSet_Icc hinner,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab,
      intervalIntegral.integral_const_mul, integral_log_b_div_div_sq ha hab]

private lemma simp_weight_integral {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ x in cellSet .simp a b a b a b, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      (Real.log (b / a) - 2) / a + (Real.log (b / a) + 2) / b := by
  let T : Set (ℝ × (ℝ × ℝ)) :=
    {p | p.1 ∈ Icc a b ∧ p.2.1 ∈ Icc a b ∧ p.2.2 ∈ Icc a b ∧ p.2.1 ≤ p.1 ∧ p.1 ≤ p.2.2}
  have hST : cellSet .simp a b a b a b = equivFin3_1 ⁻¹' T := by
    ext x; simp only [cellSet, T, mem_preimage, mem_ofPred_eq, equivFin3_1_apply]; tauto
  rw [weight_integral_via_x1 hST]
  let B : Set (ℝ × (ℝ × ℝ)) := Icc a b ×ˢ (Icc a b ×ˢ Icc a b)
  let P : Set (ℝ × (ℝ × ℝ)) := {p | p.2.1 ≤ p.1 ∧ p.1 ≤ p.2.2}
  have hT_eq : T = B ∩ P := by
    ext ⟨x1, x0, x2⟩; simp only [T, B, P, mem_inter_iff, mem_prod, mem_ofPred_eq]; tauto
  have hP_meas : MeasurableSet P :=
    ((isClosed_le (continuous_fst.comp continuous_snd) continuous_fst).inter
      (isClosed_le continuous_fst (continuous_snd.comp continuous_snd))).measurableSet
  rw [hT_eq, ← setIntegral_indicator hP_meas]
  have hint_ind : IntegrableOn
      (P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ))) B
      (volume.prod (volume.prod volume)) := by
    refine IntegrableOn.indicator ?_ hP_meas
    apply ContinuousOn.integrableOn_compact
      (isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc))
    refine continuousOn_const.div ?_ ?_
    · exact (((continuous_fst.comp continuous_snd).mul continuous_fst).mul
        (continuous_snd.comp continuous_snd)).mul continuous_fst |>.continuousOn
    · rintro ⟨x1, x0, x2⟩ ⟨hx1, hx0, hx2⟩
      have h0p : 0 < x0 := lt_of_lt_of_le ha hx0.1
      have h1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
      have h2p : 0 < x2 := lt_of_lt_of_le ha hx2.1
      positivity
  dsimp only [B]
  rw [MeasureTheory.setIntegral_prod _ hint_ind]
  have hinner : ∀ x1 ∈ Icc a b,
      ∫ q in Icc a b ×ˢ Icc a b,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) ∂(volume.prod volume) =
      Real.log (x1 / a) * Real.log (b / x1) / (x1 * x1) := by
    intro x1 hx1
    have hx1p : 0 < x1 := lt_of_lt_of_le ha hx1.1
    have hEq_ind : ∀ q : ℝ × ℝ,
        P.indicator (fun p : ℝ × (ℝ × ℝ) => (1 / (p.2.1 * p.1 * p.2.2 * p.1) : ℝ)) (x1, q) =
        ({q : ℝ × ℝ | q.1 ≤ x1 ∧ x1 ≤ q.2}).indicator
          (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) q := by
      intro q; by_cases hq : q.1 ≤ x1 ∧ x1 ≤ q.2 <;> simp [P, hq]
    simp_rw [hEq_ind]
    have hQm : MeasurableSet {q : ℝ × ℝ | q.1 ≤ x1 ∧ x1 ≤ q.2} :=
      ((isClosed_le continuous_fst continuous_const).inter
        (isClosed_le continuous_const continuous_snd)).measurableSet
    rw [setIntegral_indicator hQm]
    have hS_eq : (Icc a b ×ˢ Icc a b) ∩ {q : ℝ × ℝ | q.1 ≤ x1 ∧ x1 ≤ q.2} = Icc a x1 ×ˢ Icc x1 b := by
      ext ⟨x0, x2⟩
      simp only [mem_inter_iff, mem_prod, mem_Icc, mem_ofPred_eq]
      constructor
      · rintro ⟨⟨⟨h0a, _⟩, ⟨_, h2b⟩⟩, h01, h12⟩; exact ⟨⟨h0a, h01⟩, ⟨h12, h2b⟩⟩
      · rintro ⟨⟨h0a, h01⟩, ⟨h12, h2b⟩⟩
        exact ⟨⟨⟨h0a, le_trans h01 hx1.2⟩, ⟨le_trans hx1.1 h12, h2b⟩⟩, h01, h12⟩
    rw [hS_eq]
    have hfun : (fun q : ℝ × ℝ => (1 / (q.1 * x1 * q.2 * x1) : ℝ)) =
        (fun q : ℝ × ℝ => (1 / (x1 * x1)) * ((1 / q.1) * (1 / q.2))) := by
      ext ⟨x0, x2⟩; ring
    rw [hfun, integral_const_mul, MeasureTheory.setIntegral_prod_mul,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.1,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.2,
        integral_inv_eq_log_div ha hx1.1, integral_inv_eq_log_div hx1p hx1.2]
    ring
  rw [setIntegral_congr_fun measurableSet_Icc hinner,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab,
      integral_log_prod_div_sq ha hab]

private def cellValid (knd : CellKind) (x0a x0b x1a x1b x2a x2b : ℕ) : Prop :=
  0 < x0a ∧ x0a ≤ x0b ∧ 0 < x1a ∧ x1a ≤ x1b ∧ 0 < x2a ∧ x2a ≤ x2b ∧
  (knd = .tri01 → x0a = x1a ∧ x0b = x1b) ∧
  (knd = .tri12 → x1a = x2a ∧ x1b = x2b) ∧
  (knd = .simp → x0a = x1a ∧ x0b = x1b ∧ x1a = x2a ∧ x1b = x2b)

private lemma integrand_integrableOn_cell {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} {knd : CellKind} {pa_n x0a x0b x1a x1b x2a x2b : ℕ}
    (hv : cellValid knd x0a x0b x1a x1b x2a x2b)
    (hsum : x0b + 2 * x1b + x2b ≤ pa_n)
    (hφ_lo : (pa_n : ℝ) / D_den ≤ φ) :
    IntegrableOn
      (fun x : Fin 3 → ℝ => ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩))
      (cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                   ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                   ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den)) volume := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  rcases hv with ⟨h0p, h0le, h1p, h1le, h2p, h2le, ht01, ht12, hts⟩
  apply ContinuousOn.integrableOn_compact (cellSet_isCompact knd _ _ _ _ _ _)
  have hxmem : ∀ x ∈ cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                                 ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                                 ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      x 0 ∈ Icc ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den) ∧
      x 1 ∈ Icc ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ∧
      x 2 ∈ Icc ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) := by
    intro x hx
    cases knd with
    | box => exact hx
    | tri01 =>
      rcases ht01 rfl with ⟨rfl, rfl⟩
      exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | tri12 =>
      rcases ht12 rfl with ⟨rfl, rfl⟩
      exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | simp =>
      rcases hts rfl with ⟨rfl, rfl, rfl, rfl⟩
      exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
  have hxpos : ∀ x ∈ cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                                 ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                                 ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      0 < x 0 ∧ 0 < x 1 ∧ 0 < x 2 ∧ 1 ≤ (φ - ∑ j, x j) / x 1 := by
    intro x hx
    rcases hxmem x hx with ⟨hx0, hx1, hx2⟩
    have h0' : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) hx0.1
    have h1' : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast h1p) hDpos) hx1.1
    have h2' : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) hx2.1
    refine ⟨h0', h1', h2', ?_⟩
    rw [le_div_iff₀ h1', Fin.sum_univ_three]
    have hsum_r : (x0b : ℝ) / D_den + 2 * ((x1b : ℝ) / D_den) + (x2b : ℝ) / D_den ≤ (pa_n : ℝ) / D_den := by
      have h1 : ((x0b : ℝ) + 2 * x1b + x2b) / D_den ≤ (pa_n : ℝ) / D_den :=
        div_le_div_of_nonneg_right (by exact_mod_cast hsum) (le_of_lt hDpos)
      have h2 : (x0b : ℝ) / D_den + 2 * ((x1b : ℝ) / D_den) + (x2b : ℝ) / D_den =
          ((x0b : ℝ) + 2 * x1b + x2b) / D_den := by ring
      linarith
    linarith [hx0.2, hx1.2, hx2.2, hφ_lo]
  have harg_cont : ContinuousOn (fun x : Fin 3 → ℝ => (φ - ∑ j, x j) / x 1)
      (cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                   ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                   ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den)) := by
    refine ContinuousOn.div ?_ (continuous_apply 1).continuousOn ?_
    · exact continuousOn_const.sub (continuousOn_finsetSum _ fun j _ => (continuous_apply j).continuousOn)
    · intro x hx; exact ne_of_gt (hxpos x hx).2.1
  have hnum_cont := hω.1.comp harg_cont (fun x hx => (hxpos x hx).2.2.2)
  have hden_cont : ContinuousOn (fun x : Fin 3 → ℝ => (∏ j : Fin 3, x j) * x 1)
      (cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                   ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                   ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den)) :=
    (continuousOn_finsetProd _ fun j _ => (continuous_apply j).continuousOn).mul
      (continuous_apply 1).continuousOn
  refine hnum_cont.div hden_cont ?_
  intro x hx
  rcases hxpos x hx with ⟨h0', h1', h2', _⟩
  rw [Fin.prod_univ_three]
  positivity

private lemma cell_leaf_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    (ub : ℕ → ℕ → ℕ)
    (hub : ∀ k0 k1 : ℕ, k0 ≤ k1 → ∀ u : ℝ, tk k0 ≤ u → u ≤ tk (k1 + 1) → ω u ≤ (ub k0 k1 : ℝ) / S_scale)
    {φ : ℝ} {pa_n pb_n x0a x0b x1a x1b x2a x2b : ℕ} {knd : CellKind}
    (hv : cellValid knd x0a x0b x1a x1b x2a x2b)
    (hsum : x0b + 2 * x1b + x2b ≤ pa_n) (hpab : pa_n ≤ pb_n)
    (hφ_lo : (pa_n : ℝ) / D_den ≤ φ) (hφ_hi : φ ≤ (pb_n : ℝ) / D_den) :
    ∫ x in cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                       ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                       ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) ≤
      (evalTreeWith ub pa_n pb_n knd .lf x0a x0b x1a x1b x2a x2b : ℝ) /
        ((S_scale : ℝ) * W_scale * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  rcases hv with ⟨h0p, h0le, h1p, h1le, h2p, h2le, ht01, ht12, hts⟩
  have hhi1_pos : 0 < x1b := lt_of_lt_of_le h1p h1le
  set num_lo := pa_n - x0b - 2 * x1b - x2b
  set num_hi := pb_n - x0a - 2 * x1a - x2a
  set k0 := (num_lo * K_grid) / x1b
  set k1 := (num_hi * K_grid) / x1a
  have hk01 : k0 ≤ k1 := by
    have hnum_le : num_lo ≤ num_hi := by dsimp only [num_lo, num_hi]; omega
    have h1 : num_lo * K_grid ≤ num_hi * K_grid := Nat.mul_le_mul_right K_grid hnum_le
    exact le_trans (Nat.div_le_div_left h1le h1p) (Nat.div_le_div_right h1)
  set M : ℝ := (ub k0 k1 : ℝ) / S_scale
  have hM_nn : 0 ≤ M := div_nonneg (Nat.cast_nonneg _) (le_of_lt hSpos)
  set C := cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                       ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                       ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den)
  have hxmem : ∀ x ∈ C,
      x 0 ∈ Icc ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den) ∧
      x 1 ∈ Icc ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ∧
      x 2 ∈ Icc ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) := by
    intro x hx
    cases knd with
    | box => exact hx
    | tri01 => rcases ht01 rfl with ⟨rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | tri12 => rcases ht12 rfl with ⟨rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | simp => rcases hts rfl with ⟨rfl, rfl, rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
  have hpt : ∀ x ∈ C,
      ω ((φ - ∑ d, x d) / x ⟨1, by omega⟩) / ((∏ d, x d) * x ⟨1, by omega⟩) ≤
        M * (1 / ((∏ d : Fin 3, x d) * x 1)) := by
    intro x hx
    rcases hxmem x hx with ⟨hx0, hx1, hx2⟩
    have h0' : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) hx0.1
    have h1' : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast h1p) hDpos) hx1.1
    have h2' : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) hx2.1
    have hden_pos : 0 < (∏ d : Fin 3, x d) * x 1 := by rw [Fin.prod_univ_three]; positivity
    set u : ℝ := (φ - ∑ d, x d) / x 1
    have hu_lo : tk k0 ≤ u := by
      unfold tk u
      rw [Fin.sum_univ_three]
      have hdiv : (k0 : ℝ) * (x1b : ℝ) ≤ (num_lo : ℝ) * 256 := by
        have := Nat.div_mul_le_self (num_lo * K_grid) x1b
        unfold K_grid at this; exact_mod_cast this
      have hnum_eq : (num_lo : ℝ) = (pa_n : ℝ) - x0b - 2 * x1b - x2b := by
        have : num_lo + (x0b + 2 * x1b + x2b) = pa_n := by omega
        have hcast : (num_lo : ℝ) + ((x0b : ℝ) + 2 * x1b + x2b) = (pa_n : ℝ) := by exact_mod_cast this
        linarith
      have h1 : (pa_n : ℝ) - x0b - x1b - x2b ≤ (φ - (x 0 + x 1 + x 2)) * D_den := by
        have hp := (div_le_iff₀ hDpos).mp hφ_lo
        have h0b := (le_div_iff₀ hDpos).mp hx0.2
        have h1b := (le_div_iff₀ hDpos).mp hx1.2
        have h2b := (le_div_iff₀ hDpos).mp hx2.2
        linarith
      have h2 : x 1 * D_den ≤ x1b := (le_div_iff₀ hDpos).mp hx1.2
      rw [le_div_iff₀ h1']
      have h3 : (1 + (k0 : ℝ) / 256) * (x1b : ℝ) ≤ (pa_n : ℝ) - x0b - x1b - x2b := by linarith
      have h4 : (1 + (k0 : ℝ) / 256) * (x 1 * D_den) ≤ (1 + (k0 : ℝ) / 256) * x1b := by
        have : (0 : ℝ) ≤ 1 + (k0 : ℝ) / 256 := by positivity
        nlinarith
      have h5 : (1 + (k0 : ℝ) / 256) * x 1 * D_den ≤ (φ - (x 0 + x 1 + x 2)) * D_den := by linarith
      exact le_of_mul_le_mul_right h5 hDpos
    have hu_hi : u ≤ tk (k1 + 1) := by
      unfold tk u
      rw [Fin.sum_univ_three]
      have hdiv : (num_hi : ℝ) * 256 < ((k1 : ℝ) + 1) * (x1a : ℝ) := by
        have hlt : num_hi * K_grid < (k1 + 1) * x1a := by
          dsimp only [k1]; rw [Nat.add_mul, Nat.one_mul]
          exact Nat.lt_div_mul_add (a := num_hi * K_grid) h1p
        unfold K_grid at hlt; exact_mod_cast hlt
      have hnum_eq : (num_hi : ℝ) = (pb_n : ℝ) - x0a - 2 * x1a - x2a := by
        have : num_hi + (x0a + 2 * x1a + x2a) = pb_n := by omega
        have hcast : (num_hi : ℝ) + ((x0a : ℝ) + 2 * x1a + x2a) = (pb_n : ℝ) := by exact_mod_cast this
        linarith
      have h1 : (φ - (x 0 + x 1 + x 2)) * D_den ≤ (pb_n : ℝ) - x0a - x1a - x2a := by
        have hp := (le_div_iff₀ hDpos).mp hφ_hi
        have h0b := (div_le_iff₀ hDpos).mp hx0.1
        have h1b := (div_le_iff₀ hDpos).mp hx1.1
        have h2b := (div_le_iff₀ hDpos).mp hx2.1
        linarith
      have h2 : (x1a : ℝ) ≤ x 1 * D_den := (div_le_iff₀ hDpos).mp hx1.1
      rw [div_le_iff₀ h1']; push_cast
      have h3 : (pb_n : ℝ) - x0a - x1a - x2a ≤ (1 + ((k1 : ℝ) + 1) / 256) * (x1a : ℝ) := by linarith
      have h4 : (1 + ((k1 : ℝ) + 1) / 256) * (x1a : ℝ) ≤ (1 + ((k1 : ℝ) + 1) / 256) * (x 1 * D_den) := by
        have : (0 : ℝ) ≤ 1 + ((k1 : ℝ) + 1) / 256 := by positivity
        nlinarith
      have h5 : (φ - (x 0 + x 1 + x 2)) * D_den ≤ (1 + ((k1 : ℝ) + 1) / 256) * x 1 * D_den := by linarith
      exact le_of_mul_le_mul_right h5 hDpos
    have hw_le : ω u ≤ M := hub k0 k1 hk01 u hu_lo hu_hi
    change ω u / ((∏ d : Fin 3, x d) * x 1) ≤ M * (1 / ((∏ d : Fin 3, x d) * x 1))
    rw [mul_one_div]
    exact div_le_div_of_nonneg_right hw_le (le_of_lt hden_pos)
  have hint_w : IntegrableOn (fun x : Fin 3 → ℝ => (1 / ((∏ d : Fin 3, x d) * x 1) : ℝ)) C volume := by
    apply ContinuousOn.integrableOn_compact (cellSet_isCompact knd _ _ _ _ _ _)
    refine continuousOn_const.div ?_ ?_
    · exact (continuousOn_finsetProd _ fun d _ => (continuous_apply d).continuousOn).mul
        (continuous_apply 1).continuousOn
    · intro x hx
      rcases hxmem x hx with ⟨hx0, hx1, hx2⟩
      have h0' : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) hx0.1
      have h1' : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast h1p) hDpos) hx1.1
      have h2' : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) hx2.1
      rw [Fin.prod_univ_three]; positivity
  have hint_f := integrand_integrableOn_cell hω ⟨h0p, h0le, h1p, h1le, h2p, h2le, ht01, ht12, hts⟩ hsum hφ_lo
  have hmono : ∫ x in C, ω ((φ - ∑ d, x d) / x ⟨1, by omega⟩) / ((∏ d, x d) * x ⟨1, by omega⟩) ≤
      M * ∫ x in C, (1 / ((∏ d : Fin 3, x d) * x 1) : ℝ) := by
    rw [← integral_const_mul]
    exact setIntegral_mono_on hint_f (hint_w.const_mul M) (cellSet_measurable knd _ _ _ _ _ _) hpt
  have h0r : (0 : ℝ) < (x0a : ℝ) / D_den := div_pos (by exact_mod_cast h0p) hDpos
  have h1r : (0 : ℝ) < (x1a : ℝ) / D_den := div_pos (by exact_mod_cast h1p) hDpos
  have h2r : (0 : ℝ) < (x2a : ℝ) / D_den := div_pos (by exact_mod_cast h2p) hDpos
  have h0ler : (x0a : ℝ) / D_den ≤ (x0b : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast h0le) (le_of_lt hDpos)
  have h1ler : (x1a : ℝ) / D_den ≤ (x1b : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast h1le) (le_of_lt hDpos)
  have h2ler : (x2a : ℝ) / D_den ≤ (x2b : ℝ) / D_den := div_le_div_of_nonneg_right (by exact_mod_cast h2le) (le_of_lt hDpos)
  have hweight : ∫ x in C, (1 / ((∏ d : Fin 3, x d) * x 1) : ℝ) ≤
      (match knd with
       | .box   => ((wInv x0a x0b * wInvSq x1a x1b * wInv x2a x2b : ℕ) : ℝ)
       | .tri01 => ((wDiag01 x0a x0b * wInv x2a x2b : ℕ) : ℝ)
       | .tri12 => ((wInv x0a x0b * wDiag12 x1a x1b : ℕ) : ℝ)
       | .simp  => ((wDiag012 x0a x0b : ℕ) : ℝ)) / ((W_scale : ℝ) * W_scale * W_scale) := by
    cases knd with
    | box =>
      dsimp only [C]
      rw [box_weight_integral h0r h1r h2r h0ler h1ler h2ler]
      have hw0 := wInv_bound h0p h0le
      have hw1 := wInvSq_bound h1p h1le
      have hw2 := wInv_bound h2p h2le
      have h1nn : 0 ≤ 1 / ((x1a : ℝ) / D_den) - 1 / ((x1b : ℝ) / D_den) :=
        sub_nonneg.mpr (one_div_le_one_div_of_le h1r h1ler)
      have h2nn : 0 ≤ Real.log (((x2b : ℝ) / D_den) / ((x2a : ℝ) / D_den)) :=
        Real.log_nonneg ((one_le_div h2r).mpr h2ler)
      have hp := mul_le_mul (mul_le_mul hw0 hw1 h1nn (by positivity)) hw2 h2nn (by positivity)
      refine le_trans hp (le_of_eq ?_)
      push_cast; ring
    | tri01 =>
      rcases ht01 rfl with ⟨rfl, rfl⟩
      dsimp only [C]
      rw [tri01_weight_integral h0r h2r h0ler h2ler]
      have hw01 := wDiag01_bound h0p h0le
      have hw2 := wInv_bound h2p h2le
      have h2nn : 0 ≤ Real.log (((x2b : ℝ) / D_den) / ((x2a : ℝ) / D_den)) :=
        Real.log_nonneg ((one_le_div h2r).mpr h2ler)
      have hp := mul_le_mul hw01 hw2 h2nn (by positivity)
      refine le_trans hp (le_of_eq ?_)
      push_cast; ring
    | tri12 =>
      rcases ht12 rfl with ⟨rfl, rfl⟩
      dsimp only [C]
      rw [tri12_weight_integral h0r h1r h0ler h1ler]
      have hw0 := wInv_bound h0p h0le
      have hw12 := wDiag12_bound h1p h1le
      have h12nn : 0 ≤ Real.log (((x1b : ℝ) / D_den) / ((x1a : ℝ) / D_den)) / ((x1a : ℝ) / D_den) -
          ((x1b : ℝ) / D_den - (x1a : ℝ) / D_den) / (((x1a : ℝ) / D_den) * ((x1b : ℝ) / D_den)) := by
        rw [← integral_log_b_div_div_sq h1r h1ler]
        apply intervalIntegral.integral_nonneg h1ler
        intro s hs
        exact div_nonneg (Real.log_nonneg ((one_le_div (lt_of_lt_of_le h1r hs.1)).mpr hs.2))
          (mul_self_nonneg s)
      have hp := mul_le_mul hw0 hw12 h12nn (by positivity)
      refine le_trans hp (le_of_eq ?_)
      push_cast; ring
    | simp =>
      rcases hts rfl with ⟨rfl, rfl, rfl, rfl⟩
      dsimp only [C]
      rw [simp_weight_integral h0r h0ler]
      exact wDiag012_bound h0p h0le
  have hmul := mul_le_mul_of_nonneg_left hweight hM_nn
  refine le_trans hmono (le_trans hmul ?_)
  apply le_of_eq
  dsimp only [M, evalTreeWith, k0, k1, num_lo, num_hi]
  cases knd <;> (push_cast; ring)

private lemma cell_integrand_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {φ : ℝ} {knd : CellKind} {x0a x0b x1a x1b x2a x2b : ℕ}
    (hv : cellValid knd x0a x0b x1a x1b x2a x2b) :
    ∀ x ∈ cellSet knd ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                      ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                      ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
      0 ≤ ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  rcases hv with ⟨h0p, _, h1p, _, h2p, _, ht01, ht12, hts⟩
  intro x hx
  have hmem : x 0 ∈ Icc ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den) ∧
      x 1 ∈ Icc ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den) ∧
      x 2 ∈ Icc ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) := by
    cases knd with
    | box => exact hx
    | tri01 => rcases ht01 rfl with ⟨rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | tri12 => rcases ht12 rfl with ⟨rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
    | simp => rcases hts rfl with ⟨rfl, rfl, rfl, rfl⟩; exact ⟨hx.1, hx.2.1, hx.2.2.1⟩
  have h0' : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) hmem.1.1
  have h1' : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast h1p) hDpos) hmem.2.1.1
  have h2' : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) hmem.2.2.1
  have hden : 0 < (∏ j : Fin 3, x j) * x ⟨1, by omega⟩ := by rw [Fin.prod_univ_three]; positivity
  exact div_nonneg (buchstab_nonneg hω hz _) (le_of_lt hden)

private lemma setIntegral_le_sum2 {A B D : Set (Fin 3 → ℝ)} {f : (Fin 3 → ℝ) → ℝ}
    (hD : D ⊆ A ∪ B) (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hnnA : ∀ x ∈ A, 0 ≤ f x) (hnnB : ∀ x ∈ B, 0 ≤ f x)
    (hintA : IntegrableOn f A volume) (hintB : IntegrableOn f B volume) :
    ∫ x in D, f x ≤ (∫ x in A, f x) + (∫ x in B, f x) := by
  have hun_nn : ∀ x ∈ A ∪ B, 0 ≤ f x := by rintro x (hx | hx); exact hnnA x hx; exact hnnB x hx
  have h1 : ∫ x in D, f x ≤ ∫ x in A ∪ B, f x :=
    setIntegral_mono_set (hintA.union hintB)
      (ae_restrict_of_forall_mem (hA.union hB) hun_nn) (Filter.Eventually.of_forall hD)
  exact le_trans h1 (setIntegral_union_le_of_nonneg hA hB hnnB hintA hintB)

private lemma setIntegral_le_sum3 {A B C D : Set (Fin 3 → ℝ)} {f : (Fin 3 → ℝ) → ℝ}
    (hD : D ⊆ A ∪ B ∪ C) (hA : MeasurableSet A) (hB : MeasurableSet B) (hC : MeasurableSet C)
    (hnnA : ∀ x ∈ A, 0 ≤ f x) (hnnB : ∀ x ∈ B, 0 ≤ f x) (hnnC : ∀ x ∈ C, 0 ≤ f x)
    (hintA : IntegrableOn f A volume) (hintB : IntegrableOn f B volume) (hintC : IntegrableOn f C volume) :
    ∫ x in D, f x ≤ (∫ x in A, f x) + (∫ x in B, f x) + (∫ x in C, f x) := by
  have hAB_nn : ∀ x ∈ A ∪ B, 0 ≤ f x := by rintro x (hx | hx); exact hnnA x hx; exact hnnB x hx
  have h1 := setIntegral_le_sum2 (A := A ∪ B) (B := C) hD (hA.union hB) hC hAB_nn hnnC (hintA.union hintB) hintC
  have h2 := setIntegral_union_le_of_nonneg hA hB hnnB hintA hintB
  linarith

private lemma setIntegral_le_sum4 {A B C E D : Set (Fin 3 → ℝ)} {f : (Fin 3 → ℝ) → ℝ}
    (hD : D ⊆ (A ∪ B) ∪ (C ∪ E))
    (hA : MeasurableSet A) (hB : MeasurableSet B) (hC : MeasurableSet C) (hE : MeasurableSet E)
    (hnnA : ∀ x ∈ A, 0 ≤ f x) (hnnB : ∀ x ∈ B, 0 ≤ f x) (hnnC : ∀ x ∈ C, 0 ≤ f x) (hnnE : ∀ x ∈ E, 0 ≤ f x)
    (hintA : IntegrableOn f A volume) (hintB : IntegrableOn f B volume)
    (hintC : IntegrableOn f C volume) (hintE : IntegrableOn f E volume) :
    ∫ x in D, f x ≤ (∫ x in A, f x) + (∫ x in B, f x) + (∫ x in C, f x) + (∫ x in E, f x) := by
  have hAB_nn : ∀ x ∈ A ∪ B, 0 ≤ f x := by rintro x (hx | hx); exact hnnA x hx; exact hnnB x hx
  have hCE_nn : ∀ x ∈ C ∪ E, 0 ≤ f x := by rintro x (hx | hx); exact hnnC x hx; exact hnnE x hx
  have h1 := setIntegral_le_sum2 hD (hA.union hB) (hC.union hE) hAB_nn hCE_nn (hintA.union hintB) (hintC.union hintE)
  have h2 := setIntegral_union_le_of_nonneg hA hB hnnB hintA hintB
  have h3 := setIntegral_union_le_of_nonneg hC hE hnnE hintC hintE
  linarith

private lemma evalTree_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (ub : ℕ → ℕ → ℕ)
