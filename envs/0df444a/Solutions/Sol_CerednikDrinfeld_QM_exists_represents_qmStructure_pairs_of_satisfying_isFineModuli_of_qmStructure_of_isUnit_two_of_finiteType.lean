    (Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme 2 36 m S → Prop)
    (hQ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪))
