    ∀ c ∈ Ref.chunkL n L, c.length = n := by
  intro c hc
  simp only [Ref.chunkL, List.mem_map, List.mem_range] at hc
  obtain ⟨i, hi, rfl⟩ := hc
  rw [hL, show k * n + n - 1 = (n - 1) + k * n by omega, Nat.add_mul_div_right _ _ hn,
    Nat.div_eq_of_lt (by omega)] at hi
  simp only [List.length_take, List.length_drop, hL]
  have : (i + 1) * n ≤ k * n := Nat.mul_le_mul_right _ (by omega)
  rw [min_eq_left]; rw [Nat.add_mul] at this; omega

