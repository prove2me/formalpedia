    heckeGen ⟨q', hq'⟩ ^ 2 - 1 ∈ eigenIdeal (fun ℓ => φ ⟨ModularFormClass.qCoeff g ℓ, h𝒪 ℓ⟩) := by

  have hsq : (⟨ModularFormClass.qCoeff g q', h𝒪 ⟨q', hq'⟩⟩ : 𝒪) ^ 2 = 1 := by
    apply Subtype.ext
    show ModularFormClass.qCoeff g q' ^ 2 = 1
    exact hgq'
  rw [mem_eigenIdeal_iff, map_sub, map_pow, aeval_heckeGen, map_one]

  rw [← map_pow, hsq, map_one, sub_self]

theorem ne_two_of_not_dvd_sub_one {p q' : ℕ} (hq' : q'.Prime) (hq'p : q' ≠ p)
