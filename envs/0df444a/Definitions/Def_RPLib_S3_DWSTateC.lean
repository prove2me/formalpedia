-- title:
--   Weight-two Ramanujan-Petersson library: `G`-invariant functions lie in any field generated by suitable `X, Y`
-- statement:
--   `G`-invariant functions lie in any field generated by suitable `X, Y`.
--
--   Generalisation of `DWSIsog_N` (`invG_mem_qR`) from the Vélu functions `qx G, qy G` to ANY `X, Y ∈ L(E)` that are
--   `G`-invariant, regular off `G`, with poles of order exactly `2` and `3` at `O`, lying in a subalgebra `R` closed under
--   inverses. Used in part D with `X = [N]^* x`, `Y = [N]^* y`, `R = [N]^* L(E)`.
--   * `goodQ_mem_of_XY` : a `GoodQ G` function lies in `R`.
--   * `clrX`, `invG_mem_of_XY` : every `G`-invariant function lies in `R`.
--
--   **Formalization note.** Library module of a formalization of the Ramanujan-Petersson conjecture in weight two (Eichler-Shimura-Ihara route: the Eichler-Selberg trace formula on $S_2(\Gamma_1(M))$, the Deuring-Waterhouse-Schoof count of elliptic curves over $\mathbb F_q$ with level structure by Hurwitz class numbers, conditional on Tate's isogeny theorem in prime-to-$p$ form, the Kronecker-Hurwitz class number relation, and the Hasse-Weil bound for the components of $Y_1(M)$ by the Stepanov-Bombieri method). It contains definitions together with proved lemmas (no `sorry`; where Tate's theorem is used it is an explicit hypothesis), so that later solution files can import them.
-- source:
--   M. Deuring, Die Typen der Multiplikatorenringe elliptischer Funktionenkörper, Abh. Math. Sem. Univ. Hamburg 14 (1941), 197-272; W. C. Waterhouse, Abelian varieties over finite fields, Ann. Sci. École Norm. Sup. (4) 2 (1969), 521-560; R. Schoof, Nonsingular plane cubic curves over finite fields, J. Combin. Theory Ser. A 46 (1987), 183-211; J. Tate, Endomorphisms of abelian varieties over finite fields, Invent. Math. 2 (1966), 134-144; J. Vélu, Isogénies entre courbes elliptiques, C. R. Acad. Sci. Paris Sér. A 273 (1971), 238-241; J. H. Silverman, The Arithmetic of Elliptic Curves, 2nd ed., GTM 106, Springer 2009, Chapters III and V

import Mathlib
import Definitions.Def_RPLib_S3_DWSTateB

/-!
# S3-DWS-Tate, part C: `G`-invariant functions lie in any field generated by suitable `X, Y`

Generalisation of `DWSIsog_N` (`invG_mem_qR`) from the Vélu functions `qx G, qy G` to ANY `X, Y ∈ L(E)` that are
`G`-invariant, regular off `G`, with poles of order exactly `2` and `3` at `O`, lying in a subalgebra `R` closed under
inverses. Used in part D with `X = [N]^* x`, `Y = [N]^* y`, `R = [N]^* L(E)`.
* `goodQ_mem_of_XY` : a `GoodQ G` function lies in `R`.
* `clrX`, `invG_mem_of_XY` : every `G`-invariant function lies in `R`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Polynomial WeierstrassCurve WeierstrassCurve.Affine WeierstrassCurve.Affine.CoordinateRing
open IsDedekindDomain
open scoped nonZeroDivisors

namespace RPLib.DWS

open RPLib.Weil RPLib.Isog RPLib.Hasse

section GenRange

variable {F : Type*} [Field F] [Fintype F] {W : WeierstrassCurve F} [W.IsElliptic]
  {L : Type*} [Field L] [Algebra F L] [IsAlgClosed L] [DecidableEq L]

attribute [local instance] finite_coordinateRing decEqFF

variable {G : AddSubgroup (Pt W L)} [Fintype G]

/-- **Invariant functions regular off `G` lie in `R`** (any `R ∋ X, Y` with `ord_O X = -2`, `ord_O Y = -3`). -/
theorem goodQ_mem_of_XY (hG : (Fintype.card G : L) ≠ 0) {R : Subalgebra L (FF W L)} {X Y : FF W L}
    (hX : GoodQ G X) (hY : GoodQ G Y) (hX0 : X ≠ 0) (hY0 : Y ≠ 0) (oX : ord W L X 0 = -2)
    (oY : ord W L Y 0 = -3) (mX : X ∈ R) (mY : Y ∈ R) {f : FF W L} (hf : GoodQ G f) : f ∈ R := by
  have hconst : ∀ c : L, algebraMap L (FF W L) c ∈ R := fun c => Subalgebra.algebraMap_mem _ c
  have key : ∀ n : ℕ, ∀ f : FF W L, GoodQ G f → Ge (-(n : ℤ)) f 0 → f ∈ R := by
    intro n
    induction n with
    | zero =>
      intro f hf h0
      obtain ⟨c, rfl⟩ := hf.eq_const (by simpa using h0)
      exact hconst c
    | succ n ih =>
      intro f hf hfn
      by_cases hf0 : f = 0
      · rw [hf0]; exact zero_mem _
      by_cases hn : n = 0
      · subst hn
        have h1 := hfn.resolve_left hf0
        have h2 := hf.ord_ne_neg_one hG hf0
        push_cast at h1
        obtain ⟨c, rfl⟩ := hf.eq_const (Or.inr (by omega))
        exact hconst c
      obtain ⟨a, b, hab⟩ : ∃ a b : ℕ, 2 * a + 3 * b = n + 1 := by
        rcases Nat.even_or_odd (n + 1) with ⟨k, hk⟩ | ⟨k, hk⟩
        · exact ⟨k, 0, by omega⟩
        · exact ⟨k - 1, 1, by omega⟩
      have hM : GoodQ G (X ^ a * Y ^ b) := (hX.pow a).mul (hY.pow b)
      have hxa : X ^ a ≠ 0 := pow_ne_zero _ hX0
      have hyb : Y ^ b ≠ 0 := pow_ne_zero _ hY0
      have hMn : ord W L (X ^ a * Y ^ b) 0 = -((n + 1 : ℕ) : ℤ) := by
        rw [ord_mul hxa hyb, ord_pow, ord_pow, oX, oY]
        push_cast; omega
      obtain ⟨c, hc, hcn⟩ := hf.lead hM (mul_ne_zero hxa hyb) hMn hfn
      have h1 := ih _ hc (hcn.mono (by push_cast; omega))
      have h2 : f = (f - algebraMap L (FF W L) c * (X ^ a * Y ^ b)) +
          algebraMap L (FF W L) c * (X ^ a * Y ^ b) := by ring
      rw [h2]
      exact add_mem h1 (mul_mem (hconst c) (mul_mem (pow_mem mX a) (pow_mem mY b)))
  by_cases hf0 : f = 0
  · rw [hf0]; exact zero_mem _
  exact key (-ord W L f 0).toNat f hf (Or.inr (by have := Int.self_le_toNat (-ord W L f 0); omega))

open scoped Classical in
/-- `X - X(P)` for `P ∉ G` (and `1` on `G`). -/
noncomputable def clrX {X : FF W L} (hX : GoodQ G X) (P : Pt W L) : FF W L :=
  if hP : P ∈ G then 1 else X - algebraMap L (FF W L)
    (Classical.choose (exists_HV_of_ge (ne_zero_of_nmem hP) (hX.2 P hP)))

lemma clrX_mem {X : FF W L} (hX : GoodQ G X) {R : Subalgebra L (FF W L)} (mX : X ∈ R) (P : Pt W L) :
    clrX hX P ∈ R := by
  unfold clrX
  split_ifs
  · exact one_mem _
  · exact sub_mem mX (Subalgebra.algebraMap_mem _ _)

lemma clrX_inv {X : FF W L} (hX : GoodQ G X) (P : Pt W L) : InvG G (clrX hX P) := by
  intro S hS
  unfold clrX
  split_ifs
  · exact map_one _
  · rw [map_sub, AlgEquiv.commutes, hX.1 S hS]

lemma sub_const_ne_zero {X : FF W L} (hX0 : X ≠ 0) (oX : ord W L X 0 = -2) (c : L) :
    X - algebraMap L (FF W L) c ≠ 0 := by
  intro h
  rw [sub_eq_zero] at h
  by_cases hc : c = 0
  · rw [hc, map_zero] at h; exact hX0 h
  · rw [h, ord_alg hc] at oX; omega

lemma clrX_ne_zero {X : FF W L} (hX : GoodQ G X) (hX0 : X ≠ 0) (oX : ord W L X 0 = -2) (P : Pt W L) :
    clrX hX P ≠ 0 := by
  unfold clrX
  split_ifs
  · exact one_ne_zero
  · exact sub_const_ne_zero hX0 oX _

lemma clrX_ge {X : FF W L} (hX : GoodQ G X) {Q : Pt W L} (hQ : Q ∉ G) (P : Pt W L) : Ge 0 (clrX hX P) Q := by
  unfold clrX
  split_ifs
  · rw [← map_one (algebraMap L (FF W L))]; exact Ge.const 1 Q
  · exact (hX.2 Q hQ).sub (Ge.const _ Q)

lemma clrX_ge_one {X : FF W L} (hX : GoodQ G X) {P : Pt W L} (hP : P ∉ G) : Ge 1 (clrX hX P) P := by
  unfold clrX
  rw [dif_neg hP]
  exact ge_one_of_HV0 (HV_sub_self (Classical.choose_spec
    (exists_HV_of_ge (ne_zero_of_nmem hP) (hX.2 P hP))))

/-- **Every `G`-invariant function lies in `R`.** -/
theorem invG_mem_of_XY (hG : (Fintype.card G : L) ≠ 0) {R : Subalgebra L (FF W L)} {X Y : FF W L}
    (hX : GoodQ G X) (hY : GoodQ G Y) (hX0 : X ≠ 0) (hY0 : Y ≠ 0) (oX : ord W L X 0 = -2)
    (oY : ord W L Y 0 = -3) (mX : X ∈ R) (mY : Y ∈ R) (hinv : ∀ g ∈ R, g⁻¹ ∈ R)
    {f : FF W L} (hf : InvG G f) : f ∈ R := by
  by_cases hf0 : f = 0
  · rw [hf0]; exact zero_mem _
  set Z := (ord_finite hf0).toFinset with hZ
  set m : ℕ := ∑ P ∈ Z, (ord W L f P).natAbs with hm
  set h : FF W L := ∏ P ∈ Z, clrX hX P ^ m with hh
  have hhR : h ∈ R := prod_mem fun P _ => pow_mem (clrX_mem hX mX P) m
  have hh0 : h ≠ 0 := Finset.prod_ne_zero_iff.mpr fun P _ => pow_ne_zero _ (clrX_ne_zero hX hX0 oX P)
  have hinvG : InvG G (f * h) := by
    intro S hS
    rw [map_mul, hf S hS, hh, map_prod]
    congr 1
    exact Finset.prod_congr rfl fun P _ => by rw [map_pow, clrX_inv hX P S hS]
  have hoff : ∀ Q : Pt W L, Q ∉ G → Ge 0 (f * h) Q := by
    intro Q hQ
    by_cases hQZ : Q ∈ Z
    · rw [hh, ← Finset.mul_prod_erase Z _ hQZ]
      have hle : (ord W L f Q).natAbs ≤ m := by
        rw [hm]
        exact Finset.single_le_sum (f := fun P => (ord W L f P).natAbs) (fun _ _ => Nat.zero_le _) hQZ
      have h1 : Ge (ord W L f Q) f Q := Or.inr le_rfl
      have h2 := (clrX_ge_one hX hQ).pow m
      have h3 : Ge 0 (∏ P ∈ Z.erase Q, clrX hX P ^ m) Q :=
        Ge.prod0 fun P _ => ((clrX_ge hX hQ P).pow m).mono (by simp)
      exact (h1.mul (h2.mul h3)).mono (by omega)
    · have hz : ord W L f Q = 0 := by
        by_contra hz
        exact hQZ ((Set.Finite.mem_toFinset _).mpr hz)
      exact Ge.mul0 (Or.inr hz.symm.le)
        (Ge.prod0 fun P _ => ((clrX_ge hX hQ P).pow m).mono (by simp))
  have hmem := goodQ_mem_of_XY hG hX hY hX0 hY0 oX oY mX mY ⟨hinvG, hoff⟩
  have e : f = (f * h) * h⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hh0, mul_one]
  rw [e]
  exact mul_mem hmem (hinv _ hhR)

end GenRange

end RPLib.DWS


