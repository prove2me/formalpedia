section
-- Source module: NLogN.HEx1
/-!
# The full `fwdL` / `exactConvL` programs, part 1: generic tools (namespace `NLogN.EX`)

* `tensorGo_snoc`: `tensorGo` over `As ++ [a]` is one more single-axis step after `As`
  (`tgD As dims` = the axis list after `As`).
* `pushes l` / `pops rs`: sequences of register pushes and pops; `pushV s vs` is the state with
  the values `vs` pushed; `PushOK` is the per-push side condition (each expression evaluated in
  the state after the previous pushes).
* `invP X C Sr Tr`: pushes `((s : ZMod t)⁻¹).val` on `X` by summing `x · [s x ≡ 1 (mod t)]`
  over `x < t` (a counted loop on `C`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.EX

open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref

/-! ## `tensorGo` one axis at a time -/

/-- The axis list after applying the maps `As` (as in `tensorGo`). -/
def tgD {α : Type*} : List (ℕ × (List α → List α)) → List ℕ → List ℕ
  | [], d => d
  | (n', _) :: As, _ :: rest => tgD As (rest ++ [n'])
  | _ :: _, [] => []

/-! ## Sequences of pushes and pops -/

def pushes : List (Fin HS × Ex HS) → RS
  | [] => .skip
  | (r, e) :: l => .seq (.push r e) (pushes l)

/-- Pops in reverse order: `pops [r₁, …, rₙ]` pops `rₙ` first. -/
def pops : List (Fin HS) → RS
  | [] => .skip
  | r :: l => .seq (pops l) (.pop r)

/-- The state with the values `vs` pushed (in order). -/
def pushV (s : IState HS) : List (Fin HS × ℤ) → IState HS
  | [] => s
  | (r, v) :: l => pushV (s.upd r (.int v :: s.G r)) l

/-- Side conditions of `pushes l` producing the values `vs`. -/
def PushOK (B : ℕ) : IState HS → List (Fin HS × Ex HS) → List (Fin HS × ℤ) → Prop
  | _, [], [] => True
  | s, (r, e) :: l, (r', v) :: vs => r' = r ∧ r.val < 56 ∧ e.Clean ∧ e.ok s ∧ e.Bnd s B ∧
      e.eval s = v ∧ PushOK B (s.upd r (.int v :: s.G r)) l vs
  | _, _, _ => False

/-- Cost weight of a push list. -/
def pwt (l : List (Fin HS × Ex HS)) : ℕ := (l.map fun x => x.2.size + 1).sum

/-! ## The inverse modulo `t` by a counted sum -/

/-- `s x mod t = 1` test (negative iff true), `x = ctr - 1`. -/
def invX (C : Fin HS) : Ex HS := .add (.reg C) (.lit (-1))

def invY (C Sr Tr : Fin HS) : Ex HS := .nmod (.mul (.reg Sr) (invX C)) (.reg Tr)

def invC (C Sr Tr : Fin HS) : Ex HS :=
  .add (.mul (.add (invY C Sr Tr) (.lit (-1))) (.add (invY C Sr Tr) (.lit (-1)))) (.lit (-1))

def invB (X C Sr Tr : Fin HS) : RS :=
  .asg X (.add (.reg X) (.sel (invC C Sr Tr) (invX C) (.lit 0)))

/-- `X : R ↦ ((s : ZMod t)⁻¹).val :: R` (`s` on `Sr`, `t` on `Tr`). -/
def invP (X C Sr Tr : Fin HS) : RS := .seq (.push X (.lit 0)) (.rep C (.reg Tr) (invB X C Sr Tr))

/-- The summand. -/
def invF (s t x : ℕ) : ℕ := if s * x % t = 1 then x else 0

/-- The partial sums (candidates `t-1, t-2, …`). -/
def invAcc (s t k : ℕ) : ℕ := ∑ j ∈ Finset.range k, invF s t (t - 1 - j)

section inv

variable (X C Sr Tr : Fin HS)

/-- The states of the inverse loop. -/
def invSt (w : IState HS) (s t k : ℕ) : IState HS := w.upd X (.int (invAcc s t k) :: w.G X)

end inv

end NLogN.EX

end

