    intro b
    obtain ⟨p, hp, hpb⟩ := RingOfIntegers.isIntegral b
    refine ⟨p.map (Int.castRingHom (intAd F)), hp.map _, ?_⟩
    rw [Polynomial.eval₂_map,
      RingHom.ext_int ((algebraMap (intAd F) (IntAf F E)).comp (Int.castRingHom (intAd F)))
