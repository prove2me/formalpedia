/-! ## Size of the near-boundary line -/

theorem LJ_length_ge {s t lam w : ℕ} (hw1 : 1 ≤ w) (hwl : w ≤ lam) (hls : lam + w < s) :
    2 * w + 1 ≤ (LJ s t lam w).length := by
  set S : Finset ℕ := (Finset.range w ∪ Finset.Ico (s - w) s) ∪ {lam} with hS
  have hmem : ∀ x ∈ S, x ∈ LJ s t lam w := by
    intro x hx
    unfold LJ Jlist
    rw [List.mem_filter, List.mem_range]
    simp only [hS, Finset.mem_union, Finset.mem_range, Finset.mem_Ico, Finset.mem_singleton] at hx
    have hxs : x < s := by omega
    refine ⟨hxs, ?_⟩
    simp only [BB, mkBlocks, nearB]
    refine decide_eq_true ?_
    rcases hx with (hx | hx) | hx
    · left; have := stF_le (s := s) (t := t) (lam := lam) x; omega
    · right
      have h1 := stF_le (s := s) (t := t) (lam := lam) x
      have h2 := en_le_s (s := s) (t := t) (lam := lam) (c := stF s t lam x) (by omega)
      omega
    · left
      rw [hx]
      have : stF s t lam lam = lam := Nat.findGreatest_eq (Or.inr (Or.inl (Nat.mod_self lam)))
      rw [this]; omega
  have hsub : S ⊆ (LJ s t lam w).toFinset := fun x hx => List.mem_toFinset.2 (hmem x hx)
  have hcard : S.card = 2 * w + 1 := by
    rw [hS, Finset.card_union_of_disjoint, Finset.card_union_of_disjoint]
    · simp only [Finset.card_range, Nat.card_Ico, Finset.card_singleton]; omega
    · rw [Finset.disjoint_left]; intro a ha hb
      simp only [Finset.mem_range, Finset.mem_Ico] at ha hb; omega
    · rw [Finset.disjoint_left]; intro a ha hb
      simp only [Finset.mem_union, Finset.mem_range, Finset.mem_Ico, Finset.mem_singleton] at ha hb
      omega
  have := Finset.card_le_card hsub
  have h2 := List.toFinset_card_le (LJ s t lam w)
  omega

/-! ## The round-six statement -/

lemma pow2_dvd_tF6 (P : Prm) (n j e : ℕ) (he : 2 ^ e ≤ tF6 P n j) : 2 ^ e ∣ tF6 P n j := by
  unfold tF6 at he ⊢
  split_ifs at he ⊢
  · rw [← pow_succ] at he ⊢
    exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)
  · exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)

set_option maxHeartbeats 1000000 in
/-- **The `B₀` pass of the machine in the round-six regime.** -/
theorem r6_passB_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
