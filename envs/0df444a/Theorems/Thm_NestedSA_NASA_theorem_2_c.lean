-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-09T10:40:13.366625+00:00
-- url     : https://prove2.me/theorems/3fba82c5-83b6-42c2-90c5-cad7d125ca4b
-- title:
--   Theorem 2(c) — NASA with τ_k = 1/√N drives E[V(x^R, z^R)] below C/(√N − 1)
-- statement:
--   Consider problem (1.1), $\min_{x\in X}f(g(x))$, with $X\subseteq\mathbb R^n$ closed and convex, $f,g$ satisfying Assumption 2 with $L_{\nabla f}>0$, and $F=f\circ g$ bounded below on $X$. Run Algorithm 1 (NASA) with $a=b=1$, an oracle satisfying Assumption 1, and, for some $\alpha>0$ and horizon $N\ge2$,
--   $$\beta_k\equiv\beta=\Big(\frac{(1+\alpha)^2}{\alpha}L_g^2+\frac\alpha4\Big)L_{\nabla f},\qquad \tau_0=1,\quad \tau_k=\frac1{\sqrt N}\ (k\ge1).$$
--   Let $R$ be uniform on $\{1,\dots,N-1\}$, independent of the run. Then every $V(x^k,z^k)$ is integrable and
--   $$\mathbb E\big[V(x^R,z^R)\big]\le\frac4{\sqrt N-1}\Big(\frac2{\alpha L_{\nabla f}}\big[\max(L_1,L_2)+\max(1,\beta^2)\big]\big[W(x^0,z^0,u^0)+\hat\sigma^2\big]+\sigma_J^2\sigma_s^2\Big),$$
--   where $V$ is the optimality measure (2.10), $L_1=2L_{\nabla F}^2+4L_g^4L_{\nabla f}^2$ and $L_2=4L_g^2L_{\nabla f}^2$, $W$ is the merit function (3.15) with $a=1$ and $\gamma=\alpha L_{\nabla f}$, and $\hat\sigma^2$ is the noise constant of Proposition 1(b) with $a=b=1$ and $\gamma=\alpha L_{\nabla f}$.
--
--   This is the main result of Ghadimi, Ruszczyński and Wang: with one sample per iteration and a single time scale, NASA reaches $\mathbb E[V]\le\varepsilon$ after $O(1/\varepsilon^2)$ iterations for constrained nonconvex two-level stochastic problems, the sample complexity of stochastic gradient descent for single-level smooth problems.
--
--   **Formalization Note** The paper prints $\alpha L_{\nabla F}$ in the denominator; its proof uses $c=\alpha L_{\nabla f}/4$ (from the choice $\gamma=4c=\alpha L_{\nabla f}$), which gives $\alpha L_{\nabla f}$, and $L_{\nabla F}$ and $L_{\nabla f}$ are not comparable in general. $\hat\sigma^2$ replaces the printed $\sigma^2$ of (3.26) (see Proposition 1(b)); $\gamma=\alpha L_{\nabla f}$ is fixed by the proof (p. 17) and enters $W$ and $\hat\sigma^2$. The paper defines $\tau_k$ for $k\le N-1$; the stepsize is taken equal to $1/\sqrt N$ for every $k\ge1$, which only affects iterates after $x^N$. $\mathbb E[V(x^R,z^R)]$ is written as the $\tau$-weighted average of $\mathbb E[V(x^k,z^k)]$ over $k=1,\dots,N-1$, which is the uniform average since these $\tau_k$ are equal. The second claim of Theorem 2(c), (3.38), is not part of this statement.
-- source:
--   Ghadimi, Ruszczyński, Wang, A Single Time-Scale Stochastic Approximation Method for Nested Stochastic Optimization, arXiv:1812.01094v2, pp. 14–15, Theorem 2(c), (3.35)–(3.37)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_NestedSA_NASA_Basic
import Definitions.Def_NestedSA_NASA_Model

open MeasureTheory ProbabilityTheory

namespace NestedSA.NASA

/-- Theorem 2(c), (3.37) (pp. 14–15), with `L_∇f` for the printed `L_∇F` and the corrected constant `σ̂²`.
Let `x, z, u` be generated by Algorithm 1 with `a = b = 1` under Assumptions 1 and 2, `F = f ∘ g` bounded below
on `X`, `L_∇f > 0`, `α > 0`, constant `β = ((1 + α)²/α · L_g² + α/4) L_∇f` (3.35), and stepsizes `τ₀ = 1`,
`τ_k = 1/√N` for `k ≥ 1` (3.36), `N ≥ 2`. With `γ = αL_∇f` (the proof's choice, entering `W` and `σ̂²`) and
`R` uniform on `{1, …, N−1}` (so `E[V(x^R, z^R)]` is the `τ`-weighted average below):
`E[V(x^R, z^R)] ≤ 4/(√N − 1) · ((2/(αL_∇f)) [max(L₁, L₂) + max(1, β²)] [W(x⁰, z⁰, u⁰) + σ̂²] + σ_J²σ_s²)`,
with every `V(x^k, z^k)` integrable. -/
theorem theorem_2_c {n m : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ)
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX_cl : IsClosed X) (hX_cvx : Convex ℝ X)
    (P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hP : SpectralProjGrad.Shared.IsProjOnto X P)
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (Lf Lg Ldf Ldg : ℝ) (hA2 : Assumption2 f g Lf Lg Ldf Ldg)
    (hF_bdd : BddBelow ((fun x => f (g x)) '' X))
    (hLdf : 0 < Ldf) (α : ℝ) (hα : 0 < α) (N : ℕ) (hN : 2 ≤ N)
    (β : ℝ) (hβ : β = ((1 + α) ^ 2 / α * Lg ^ 2 + α / 4) * Ldf)
    (τ : ℕ → ℝ) (hτ0 : τ 0 = 1) (hτ : ∀ k, 1 ≤ k → τ k = 1 / Real.sqrt N)
    (x0 z0 : EuclideanSpace ℝ (Fin n)) (u0 : EuclideanSpace ℝ (Fin m))
    (x z : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (u G s : ℕ → Ω → EuclideanSpace ℝ (Fin m))
    (J : ℕ → Ω → (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)))
    (hrun : IsStochRun X P 1 1 β τ x0 z0 u0 x z u G s J)
    (σG σJ σs : ℝ) (hA1 : Assumption1 μ ℱ f g x z u G s J σG σJ σs) :
    (∀ k, Integrable (fun ω => V P f g (x k ω) (z k ω)) μ) ∧
    (∑ k ∈ Finset.Icc 1 (N - 1), τ k * ∫ ω, V P f g (x k ω) (z k ω) ∂μ) /
        (∑ k ∈ Finset.Icc 1 (N - 1), τ k) ≤
      4 / (Real.sqrt N - 1) *
        (2 / (α * Ldf) * (max (L1 1 Lf Lg Ldf Ldg) (L2 Lg Ldf) + max 1 (β ^ 2)) *
            (W P f g X 1 (α * Ldf) β x0 z0 u0 +
              sigmaHatSq 1 1 (α * Ldf) β Lf Lg Ldf Ldg σG σJ σs z0)
          + σJ ^ 2 * σs ^ 2) := by sorry

end NestedSA.NASA
