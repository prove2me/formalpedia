theorem h50i_invChain_valid {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) : ∀ (steps : List (Step n Q)),
    (∀ s ∈ steps, ∀ a, Valid sh a → Valid sh (s.inv Λ a)) → ∀ a, Valid sh a → Valid sh (invChain Λ steps a)
  | [], _, a, ha => ha
  | s :: ss, h, a, ha => by
    show Valid sh (s.inv Λ (invChain Λ ss a))
