-- title:
--   Example 2.5 — the hitting time of a level by a $d_\infty$-continuous field lies in $\mathcal T$
-- statement:
--   Let $u \in C^0(\Lambda)$, i.e. $u$ is $\mathbb F$-progressively measurable and continuous on $\Lambda = [0,T]\times\Omega$ under $d_\infty$, and let $c\in\mathbb R$. Then
--   $$\tau := \inf\{t : u(t,\omega)\ge c\}\wedge T$$
--   is in $\mathcal T$: it is an $\mathbb F$-stopping time with values in $[0,T]$, and for every $t\in[0,T)$ the set $\{\omega : \tau(\omega) > t\}$ is open in $(\Omega,\|\cdot\|_T)$.
--
--   Such hitting times are the standard way the paper localises test functions and solutions; the openness of $\{\tau>t\}$ is what lets the viscosity property be checked locally.
--
--   **Formalization Note** The infimum runs over $t\in[0,T]$ and is read as $+\infty$ when no such $t$ exists, so then $\tau = T$; the hitting time is a definition `hitTime` in the Calculus file. The filtration is the raw one generated by the canonical process.
-- source:
--   Ekren, Keller, Touzi, Zhang, On viscosity solutions of path dependent PDEs, arXiv:1109.5971v2, Example 2.5, p. 6

import Mathlib
import Definitions.Def_ViscosityPPDE_Comparison_Perron
import Definitions.Def_ViscosityPPDE_Comparison_Standing

open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal

namespace ViscosityPPDE.Comparison

theorem example_2_5 {d : ℕ} {T : ℝ≥0} (u : ℝ≥0 → Omega d T 0 → ℝ) (hu : IsC0 T 0 u)
    (c : ℝ) : IsStopT T 0 (hitTime T u c) := by sorry

end ViscosityPPDE.Comparison
