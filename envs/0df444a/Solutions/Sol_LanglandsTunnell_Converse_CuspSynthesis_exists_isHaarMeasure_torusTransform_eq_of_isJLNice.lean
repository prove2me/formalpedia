  rw [t0535 η b, Units.coe_prod]
  rfl

private theorem t0538 (w : InfinitePlace K) (hw : w.IsReal) (a : (AdeleRing (𝓞 K) K)ˣ)
    (g : AdelicGL2 (𝓞 K) K) :
    realComponent w hw (diagOne a * g) =
