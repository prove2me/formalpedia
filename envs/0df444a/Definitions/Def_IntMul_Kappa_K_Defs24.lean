section
-- Source module: Solutions.KFMPhiW
/-!
# KFM: `Φ` / `Φ⁻¹` with `s_j ≤ t_j`, and as arrays of the chain

KFU states the pointwise denotations of `Φ`/`Φ⁻¹` under `s_j ≤ 2^h`; the parameters have
`s_j ≤ t_j = 2^{h+b_j}` (`PhiNeed`, as corrected). The proofs only use `sP ≤ tP`:

* `sP_le_tPW`, `le_SRW`, **`PhiD_atW`**, **`PhiInvD_atW`**, **`PhiD_eqW`** (copies with the weak
  hypothesis `hsw : ∀ j < d, sF j ≤ tP d h bL j`).

As arrays of the chain (box `t_i = tP d h bL i`, source `s_i = sF i`, last axis = component):

* `encode_snoc2`: `enc (sh ++ [2]) (v ++ [c]) = 2·enc sh v + c`.
* `pairL ys`: the Gaussian items of an integer list; `gflat (pairL ys) = ys` for even length.
* **`phiD_pad`**: `pairL (PhiD xs)` vanishes off the source points (`PadZ`) and holds the item
  `(xs[2κ], xs[2κ+1])`, `κ = (Φ⁻¹ k).val`, at source point `k`.
* **`phiInvD_read`**: `(PhiInvD (gflat ws))[2m + c]` is component `c` of `ws` at the point
  `Φ(m)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul AModel AModelL12 NLogN.KFU KFB

noncomputable section

variable {d : ℕ}

/-! ## Arrays -/

section Arr

variable (h : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (H : CrtOK d sF μ)

/-- The padded box. -/
def tBox (d h : ℕ) (bL : ℕ → Bool) : Fin d → ℕ := fun i => tP d h bL i

/-- The source box. -/
def sBox (d : ℕ) (sF : ℕ → ℕ) : Fin d → ℕ := fun i => sF i

include H in
theorem sBox_ne (i : Fin d) : NeZero (sBox d sF i) := ⟨by have := H.pos i i.2; simp [sBox]; omega⟩

include H in
theorem sBox_cop : Pairwise (Function.onFun Nat.Coprime (sBox d sF)) := fun i j hij =>
  H.cop i j i.2 j.2 (fun e => hij (Fin.ext e))

include H in
theorem sBox_mu : ∀ i : Fin d, Nat.Coprime (μ i) (sBox d sF i) := fun i => H.coprime i.2

/-- The CRT map for the source box. -/
noncomputable def eB : ZMod (∏ i, sBox d sF i) ≃+ ((i : Fin d) → ZMod (sBox d sF i)) :=
  haveI := sBox_ne sF μ H
  IntMul.OpenAI.RCRT.PhiEquiv (sBox d sF) (sBox_cop sF μ H) (fun i => μ i) (sBox_mu sF μ H)

end Arr

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig2
/-!
# KFM Big2: the interface calls of `bigE`

Every interface call is `callW bld X Y dS e` (KFMCall) with the descriptor builder `bld` (KFMSB,
KFMSF) on the builder stack `X = bX dS` and the scratch `Y = bY dS` (both differ from the
interface's descriptor stack `dS`). A run of the interface in its own table `kTable ext` is a run
in the merged table (`IRuns.relabel`).

* **`callW_I`**: the generic call in the merged table.
* **`lineA_phase`**, **`chirp_phase`**, **`lineB_phase`**, **`phiF_phase`**, **`phiB_phase`**:
  each call from a state with `BaseOK`, its output and its cost.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

/-! ## Builder stacks -/

/-- The builder stack for an interface with descriptor stack `dS`. -/
def bX (dS : Fin HS) : Fin HS := if dS = 36 then 37 else 36

/-- The transfer scratch. -/
def bY (dS : Fin HS) : Fin HS := if dS = 38 then 39 else 38

/-! ## The generic call -/

section Call

variable {P P' : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {iprog' : Fin P' → IStmt HS P'}
  {g : Fin P' → Fin P}

/-- The cost of a call. -/
def cCallW (cb len B c : ℕ) : ℕ := 1 + cb + (2 * len * cMv B + 70) + c + (len * cMv B + 31)

end Call

/-! ## The phases -/

section Phases

variable {P P' : ℕ} {Isym : List Sym} {iprog : Fin P → IStmt HS P}
  {ext : Fin P' → IStmt HS (7 + P')} {g : Fin (7 + P') → Fin P}
  (hprog : ∀ j, iprog (g j) = (kTable ext j).ren id g)
  {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)

/-- The cost bound of a line call. -/
def kLine (n Bd : ℕ) (C₀ : ℝ) (A : ℕ) : ℝ :=
  1 + 2 * 10 ^ 12 * (bP n + 1) ^ 3 + 3 * (descLineN n).length * cMv Bd + 101 + C₀ * cLineU n A

/-- The cost bound of a chirp call. -/
def kChirp (n Bd : ℕ) (C₀ : ℝ) (A : ℕ) : ℝ :=
  1 + 3 * 10 ^ 12 * (bP n + 1) ^ 3 + 3 * (descChirpN n).length * cMv Bd + 101 + C₀ * cLineU n A

/-- The chirp guarantee for fixed tables (the body of `ChirpNeedR` after the tables). -/
def chirpGN (Isym : List Sym) (ext : Fin P' → IStmt HS (7 + P')) (eC : Fin (7 + P')) (dS : Fin HS)
    (C₀ : ℝ) (A n D : ℕ) [∀ i, NeZero (tBD n D i)]
    (θt θit at' bt : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descChirpN n →
    ∀ (xs : List GI) (x : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ),
      f 0 = gflat xs ++ l → RepFull (pP n) (tBD n D) xs x → ‖x‖ ≤ 6 / 10 →
      ∃ (Mrt : (((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ) →
          (((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ) →
          (((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ)),
        (∀ f g, Grid (pP n) f → Grid (pP n) g → ‖f‖ ≤ 1 → ‖g‖ ≤ 1 →
          ‖Mrt f g - mrX (tBD n D) f g‖ ≤ ErC n D * hp (pP n)) ∧
      ∃ (ys : List GI) (c : ℕ),
        IRuns Isym (kTable ext) (.call eC) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (gflat ys ++ l))) c ∧
        RepFull (pP n) (tBD n D) ys (chirpT (pP n) (mcT (pP n) Mrt θt θit) bt at' x) ∧
        NLogN.KFB.GB (pP n + 2) ys ∧
        (c : ℝ) ≤ C₀ * cLineU n A

/-- The `Φ` guarantee for fixed parameters (the body of `PhiNeed`). -/
def phiG (Isym : List Sym) (ext : Fin P' → IStmt HS (7 + P')) (eF eB : Fin (7 + P')) (dS : Fin HS)
    (C₀ : ℝ) (w h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = descPhi w h d bL sF μ →
    (∀ xs : List ℤ, f 0 = xs ++ l → xs.length = vol (KFU.shK d (KFU.sP d sF)) → Bnd w xs →
      ∃ c : ℕ, IRuns Isym (kTable ext) (.call eF) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (KFU.PhiD h d bL sF μ xs ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cPhiU w h d bL sF) ∧
    (∀ ys : List ℤ, f 0 = ys ++ l → ys.length = vol (KFU.shR d (KFU.tP d h bL)) → Bnd w ys →
      ∃ c : ℕ, IRuns Isym (kTable ext) (.call eB) (NLogN.KIL.encK s f)
          (NLogN.KIL.encK s (Function.update f 0 (KFU.PhiInvD h d bL sF μ ys ++ l))) c ∧
        (c : ℝ) ≤ C₀ * cPhiU w h d bL sF)

/-- The descriptor of `Φ` for `n`. -/
def descPhiN (n : ℕ) : List ℤ :=
  descPhi (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n) (muN n)

/-- The cost bound of a `Φ` call. -/
def kPhi (n Bd : ℕ) (C₀ : ℝ) : ℝ :=
  1 + 2 * 10 ^ 13 * (bP n + 1) ^ 3 * (bP n + IntMul.OpenAI.Glue.rP n + 5) + 3 * (descPhiN n).length * cMv Bd + 101 +
    C₀ * cPhiU (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n)

end Phases

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSizesNeed
/-!
# KFM: the numeric interface `ChainSizes` (hypothesis of the assembly)

All parameter inequalities the assembly needs for large `n`. Pure arithmetic and analysis (no IL).
For `n ≥ n₂` (and `n ≥ n0`), `d = dP n = D + 1`, `s = sBD n D` (source lengths),
`t = tBD n D` (padded lengths `r/2` below `d'`, `r` from `d'` on), `b = bP n`, `p = pP n = 6b`,
`α = αP n`, `γ = 2(D+1)α²`, `S = ∏ s_i`:

* axes: `2 ≤ s_i < t_i`, `t_i` even, `s_i ⊥ t_i`, the `s_i` pairwise coprime;
* the hypotheses of `axisMaps_exists` (Lemma 19 per axis);
* the size hypotheses `hεA`, `hEr`, `hEs`, `hB2` of `chain_concrete`, with `εA = epsA`,
  `Er = ErC`, `εB = epsB` (the constants of `LineNeed` / `ChirpNeed`);
* digits: `b + 2 ≤ p`, and `M = ⌈n/b⌉` digits fit twice into the source box (`2M ≤ S`, so the
  cyclic convolution of two digit sequences has no wrap-around).

Expected sources: `params_ok` (`γP n ≤ b/4`, `2dp² < TL`, `12d²b ≤ α⁴`, …), `src_facts`,
`srcS_ok_n` (windows `(4d−2)t < 4d·s ≤ (4d−1)t`), `sWidth = ⌈√p⌉α`, `eWidth`, `jIter`.
-/

namespace NLogN.KFM

open IntMul KIL KFB IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue

noncomputable section

/-- **The parameter sizes** (hypothesis of the assembly). -/
def ChainSizes : Prop :=
  ∃ n₂ : ℕ, ∀ n, IntMul.OpenAI.Glue.n0 ≤ n → n₂ ≤ n → ∀ D, IntMul.OpenAI.Glue.dP n = D + 1 →
    -- axes
    (∀ i, 2 ≤ sBD n D i) ∧ (∀ i, sBD n D i < tBD n D i) ∧ (∀ i, Even (tBD n D i)) ∧
    (∀ i, Nat.Coprime (sBD n D i) (tBD n D i)) ∧
    (∀ i j, i ≠ j → Nat.Coprime (sBD n D i) (sBD n D j)) ∧
    -- Lemma 19 per axis (`axisMaps_exists`)
    2 ≤ αP n ∧ αP n ^ 2 ≤ pP n ∧
    (∀ i, sBD n D i ≤ αP n ^ 2 * (tBD n D i - sBD n D i)) ∧
    (∀ i, 100 * (jIter (pP n) (sBD n D i) (tBD n D i) (αP n) *
      (10 * eWidth (pP n) (αP n) + 12) + 1) ≤ 2 ^ pP n) ∧
    4 * (6 * sWidth (pP n) (αP n) + 4) ≤ 2 ^ pP n ∧
    -- `chain_concrete`
    epsA (pP n) (αP n) (D + 1) * hp (pP n) ≤ 1 / 10 ∧
    ErC n D * hp (pP n) ≤ 1 / 10 ∧
    (2 : ℝ) ^ (2 * (D + 1) * αP n ^ 2) * ((epsA (pP n) (αP n) (D + 1) + (ErC n D + 22) +
      epsB (pP n) (αP n) (sBD n D) (tBD n D)) * hp (pP n)) ≤ 1 / 100 ∧
    2 * (2 : ℝ) ^ (2 * bP n + 4) * (∏ i, (sBD n D i : ℝ)) ^ 2 *
      (3 * ((2 : ℝ) ^ (2 * (D + 1) * αP n ^ 2) * (epsA (pP n) (αP n) (D + 1) + (ErC n D + 22) +
        epsB (pP n) (αP n) (sBD n D) (tBD n D))) + 2) * hp (pP n) < 1 ∧
    -- digits
    bP n + 2 ≤ pP n ∧ 2 * ((n + bP n - 1) / bP n) ≤ ∏ i, sBD n D i

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig4
/-!
# KFM Big4: the source transform `F̃` of `bigE`

`ftilP = A-lines; chirp; B₀-lines; ×2^γ`. From a padded array `RepPad zs u` with `‖u‖ ≤ 1/2`
it leaves `RepPad zs' U` with `‖U − R F_s u‖ ≤ Es · 2^{−p}`,
`Es = 2^γ (εA + (Er + 22) + εB)` (`source_call`). Its cost is the sum of the three call bounds
and the shift pass.

* `BaseOK.upd`: writes to non-register stacks keep `BaseOK`.
* `gflat_map`, `len_box`: list facts.
* **`ftil_phase`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

/-- The shift by `2^γ` of a Gaussian item. -/
def gshl (γ : ℕ) (z : GI) : GI := (z.1 * 2 ^ γ, z.2 * 2 ^ γ)

/-- The error constant of one source transform. -/
def EsN (n D : ℕ) : ℝ :=
  (2 : ℝ) ^ (2 * (D + 1) * αP n ^ 2) * (epsA (pP n) (αP n) (D + 1) + (ErC n D + 22) +
    epsB (pP n) (αP n) (sBD n D) (tBD n D))

/-- The cost bound of the shift pass. -/
def kShl (n D : ℕ) : ℕ :=
  cItem (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (1000 * (pP n + 2 + 2 * (D + 1) * αP n ^ 2 + 2))
      (pP n + 2 + 2 * (D + 1) * αP n ^ 2 + 1) + 2 * cCnt (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) +
    cW (2 ^ (2 * (D + 1) * αP n ^ 2)) + cW ((2 ^ (IntMul.OpenAI.Glue.LP n + 1) : ℕ) : ℤ)

section Ftil

variable {P P₂ P₃ : ℕ} {Isym : List Sym} {iprog : Fin P → IStmt HS P}
  {ext₂ : Fin P₂ → IStmt HS (7 + P₂)} {g₂ : Fin (7 + P₂) → Fin P}
  {ext₃ : Fin P₃ → IStmt HS (7 + P₃)} {g₃ : Fin (7 + P₃) → Fin P}

/-- The source transform. -/
def ftilP (g₂ : Fin (7 + P₂) → Fin P) (g₃ : Fin (7 + P₃) → Fin P) (eA eB : Fin (7 + P₂))
    (eC : Fin (7 + P₃)) (dSL dSC : Fin HS) : IStmt HS P :=
  .seq (callW (descLineP (bX dSL)) (bX dSL) (bY dSL) dSL (g₂ eA))
    (.seq (callW (descChirpP (bX dSC)) (bX dSC) (bY dSC) dSC (g₃ eC))
      (.seq (callW (descLineP (bX dSL)) (bX dSL) (bY dSL) dSL (g₂ eB)) (shlW rG)))

end Ftil

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig5
/-!
# KFM Big5: the context of `bigE`, and one input

* `Ix P`: the fixed (size-independent) data of the program: the table maps of the three
  interfaces, their entries and descriptor stacks.
* `BigCtx ix Isym iprog n D`: everything the run for `n` uses: the interface guarantees in the
  merged table, the phase tables of the chirp, the sizes (`ChainSizes`), the axis maps `M`.
* **`digW_runs`**: the digit cut of `x` (registers copied from `rB2, rM, rZ, rE2`).
* **`inP_phase`**: `mv ARGM tX; digits; Φ; F̃` takes the top of `ARGM` to an array `U` with
  `‖U − R F_s(2^{−(b+2)} ū)‖ ≤ Es hp`, `ū_k = dgt_{Φ⁻¹ k}(x)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

/-- The fixed data of the program. -/
structure Ix (P : ℕ) where
  P₁ : ℕ
  P₂ : ℕ
  P₃ : ℕ
  g₁ : Fin (7 + P₁) → Fin P
  g₂ : Fin (7 + P₂) → Fin P
  g₃ : Fin (7 + P₃) → Fin P
  eF : Fin (7 + P₁)
  eI : Fin (7 + P₁)
  eA : Fin (7 + P₂)
  eB : Fin (7 + P₂)
  eC : Fin (7 + P₃)
  dSΦ : Fin HS
  dSL : Fin HS
  dSC : Fin HS

/-- Everything the run for `n` uses. -/
structure BigCtx {E : ℕ} (ix : Ix (7 + E)) (Isym : List Sym) (extM : Fin E → IStmt HS (7 + E))
    (n D : ℕ) [∀ i, NeZero (sBD n D i)] [∀ i, NeZero (tBD n D i)] where
  hn : IntMul.OpenAI.Glue.n0 ≤ n
  hD : IntMul.OpenAI.Glue.dP n = D + 1
  -- `Φ`
  ext₁ : Fin ix.P₁ → IStmt HS (7 + ix.P₁)
  hp₁ : ∀ j, kTable extM (ix.g₁ j) = (kTable ext₁ j).ren id ix.g₁
  CΦ : ℝ
  hdΦ : ix.dSΦ ≠ 0
  hΦ : phiG Isym ext₁ ix.eF ix.eI ix.dSΦ CΦ (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n) (muN n)
  BΦ : ℕ
  hBΦ : ∀ x ∈ descPhiN n, zsz x ≤ BΦ
  -- lines
  ext₂ : Fin ix.P₂ → IStmt HS (7 + ix.P₂)
  hp₂ : ∀ j, kTable extM (ix.g₂ j) = (kTable ext₂ j).ren id ix.g₂
  CL : ℝ
  AL : ℕ
  hdL : ix.dSL ≠ 0
  hL : lineG Isym ext₂ ix.eA ix.eB ix.dSL CL AL n (D + 1)
  BL : ℕ
  hBL : ∀ x ∈ descLineN n, zsz x ≤ BL
  -- chirp
  ext₃ : Fin ix.P₃ → IStmt HS (7 + ix.P₃)
  hp₃ : ∀ j, kTable extM (ix.g₃ j) = (kTable ext₃ j).ren id ix.g₃
  CC : ℝ
  AC : ℕ
  hdC : ix.dSC ≠ 0
  θt : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ
  θit : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ
  at' : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ
  bt : ((i : Fin (D + 1)) → ZMod (tBD n D i)) → ℂ
  ζ : ℂ
  hζ : ζ ^ tBD n D (Fin.last D) = -1
  hθ : Phases (pP n) (twX (tBD n D) ζ) θt
  hθi : Phases (pP n) (fun j => (twX (tBD n D) ζ j)⁻¹) θit
  ha : Phases (pP n) (fun j => (starRingEnd ℂ) (chirp (sBD n D) (tBD n D) j)) at'
  hb' : Phases (pP n) (chirp (sBD n D) (tBD n D)) bt
  hbg : Grid (pP n) bt
  hC : chirpGN Isym ext₃ ix.eC ix.dSC CC AC n D θt θit at' bt
  BC : ℕ
  hBC : ∀ x ∈ descChirpN n, zsz x ≤ BC
  -- sizes
  hlt : ∀ i, sBD n D i < tBD n D i
  ht : ∀ i, Even (tBD n D i)
  hcop : ∀ i, Nat.Coprime (sBD n D i) (tBD n D i)
  hpair : ∀ i j, i ≠ j → Nat.Coprime (sBD n D i) (sBD n D j)
  M : AxisMaps (d := D + 1) (pP n) (αP n) (sBD n D) (tBD n D)
  hεA : epsA (pP n) (αP n) (D + 1) * hp (pP n) ≤ 1 / 10
  hEr : ErC n D * hp (pP n) ≤ 1 / 10
  hEs : EsN n D * hp (pP n) ≤ 1 / 100
  hB2 : 2 * (2 : ℝ) ^ (2 * bP n + 4) * (∏ i, (sBD n D i : ℝ)) ^ 2 * (3 * EsN n D + 2) *
    hp (pP n) < 1
  hbp : bP n + 2 ≤ pP n
  hMS : 2 * ((n + bP n - 1) / bP n) ≤ ∏ i, sBD n D i
  H : CrtOK (D + 1) (srcN n) (muN n)

/-! ## Facts -/

/-! ## The digit cut -/

/-- The digit cut with its registers. -/
def digW {P : ℕ} : IStmt HS P := withD rB2 uB2 (withD NLogN.KFM.rM uM (withD rZ uZ (withD rE2 NLogN.KFM.uE digIU)))

/-- `M = ⌈n/b⌉`. -/
def mN (n : ℕ) : ℕ := (n + bP n - 1) / bP n

/-- The digit scale `e = p − b − 2`. -/
def eN (n : ℕ) : ℕ := pP n - bP n - 2

/-- The cost of the digit cut. -/
def kDig (n : ℕ) : ℕ :=
  cDigU (bP n) (NLogN.KFM.eN n) (NLogN.KFM.mN n) (sCmp n) + cW (2 ^ NLogN.KFM.eN n) + cW (((2 * (sCmp n - NLogN.KFM.mN n) : ℕ) : ℤ)) +
    cW (NLogN.KFM.mN n : ℤ) + cW (2 ^ bP n)

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig6
/-!
# KFM Big6: one input

`inP = mv ARGM tX; digits; Φ; F̃` takes the top `x` of `ARGM` to an array `U` with
`‖U − R F_s(2^{−(b+2)} ū)‖ ≤ Es hp`, where `ū_k = dgt_{Φ⁻¹ k}(x)` (`ubar`).

* list facts: `vol_shK`, `length_PhiD`, `length_PhiInvD`, `digG_GB`;
* `norm_dgt_le`: `‖2^{−(b+2)} ū‖ ≤ 1/4`;
* **`inP_phase`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue
  IntMul.OpenAI.RCost

noncomputable section

/-! ## List facts -/

/-! ## Scales -/

/-! ## Sizes -/

/-! ## The input phase -/

variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

/-- One input: the top of `ARGM` to the array `U`. -/
def inP (ix : Ix (7 + E)) : IStmt HS (7 + E) :=
  .seq (.op (.mv ARGM tX)) (.seq digW
    (.seq (callW (descPhiP (bX ix.dSΦ) rPw) (bX ix.dSΦ) (bY ix.dSΦ) ix.dSΦ (ix.g₁ ix.eF))
      (ftilP ix.g₂ ix.g₃ ix.eA ix.eB ix.eC ix.dSL ix.dSC)))

/-- The digits `ū` of `x` on the box. -/
def ubar (C : BigCtx ix Isym extM n D) (x : ℕ) : ((i : Fin (D + 1)) → ZMod (sBD n D i)) → ℂ :=
  fun k => (dgt (bP n) (NLogN.KFM.mN n) x ((NLogN.KFM.eB (srcN n) (muN n) C.H).symm k).val : ℂ)

/-- The cost bound of one input. -/
def kIn (C : BigCtx ix Isym extM n D) : ℝ :=
  ((2 * moveCost (n + 1) + 19 + kDig n : ℕ) : ℝ) + kPhi n C.BΦ C.CΦ +
    (kLine n C.BL C.CL C.AL + kChirp n C.BC C.CC C.AC + kLine n C.BL C.CL C.AL + kShl n D)

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig7
/-!
# KFM Big7: the product `Z`

`mulP = inP; mv² 0 → pW; inP; gmul; conj; F̃`. From `ARGM = [y, x]` it leaves on stack `0` an array
`Z` with `‖Z − R F_s(cnj Q_p(U_x U_y))‖ ≤ Es hp`, where `U_x, U_y` are the transforms of the two
inputs (`inP_phase`).

* `GB.mono`, **`gb_of_rep`**: a represented array of norm `≤ 1` has `p + 1`-bit numerators.
* `len_T`: a `t`-box array has `T = 2^L` items.
* **`mul_phase`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFM

open AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC
  IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-! ## The product phase -/

variable {E : ℕ} {ix : Ix (7 + E)} {Isym : List Sym} {extM : Fin E → IStmt HS (7 + E)} {n D : ℕ}
  [instS : ∀ i, NeZero (sBD n D i)] [instT : ∀ i, NeZero (tBD n D i)]

/-- The width of the transform outputs. -/
def wU (n D : ℕ) : ℕ := pP n + 2 + (2 * (D + 1) * αP n ^ 2 + 1)

/-- The product program. -/
def mulP (ix : Ix (7 + E)) : IStmt HS (7 + E) :=
  .seq (inP ix) (.seq (.seq (mvNU rT2 0 pO) (mvNU rT2 pO pW)) (.seq (inP ix) (.seq NLogN.KFM.gmulW
    (.seq conjW (ftilP ix.g₂ ix.g₃ ix.eA ix.eB ix.eC ix.dSL ix.dSC)))))

/-- The cost of the Gaussian product pass. -/
def kGm (n D : ℕ) : ℕ :=
  2 ^ IntMul.OpenAI.Glue.LP n * (4 * fmB (2 * NLogN.KFM.wU n D)) + 10 ^ 6 * (2 ^ IntMul.OpenAI.Glue.LP n + 1) * (NLogN.KFM.wU n D + pP n + 1) +
    2 * cCnt (2 * 2 ^ IntMul.OpenAI.Glue.LP n) + cW (2 ^ pP n) + cW ((2 * 2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℤ) + cW ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℤ)

/-- The cost of a conjugation pass at width `B`. -/
def kCj (n B : ℕ) : ℕ :=
  cConj (2 ^ IntMul.OpenAI.Glue.LP n) B + cW ((2 * 2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℤ) + cW ((2 ^ IntMul.OpenAI.Glue.LP n : ℕ) : ℤ)

/-- The cost bound of one source transform. -/
def kFt (C : BigCtx ix Isym extM n D) : ℝ :=
  kLine n C.BL C.CL C.AL + kChirp n C.BC C.CC C.AC + kLine n C.BL C.CL C.AL + kShl n D

/-- The cost bound of the product phase. -/
def kMul (C : BigCtx ix Isym extM n D) : ℝ :=
  kIn C + ((2 * cMvN (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (NLogN.KFM.wU n D) : ℕ) : ℝ) + kIn C + (kGm n D : ℝ) +
    (kCj n (pP n + 1) : ℝ) + kFt C

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMBig8
/-!
# KFM Big8: the rounding passes

After `Z` (`mulP`), `conj; ×S; ×S; ×2^{2b+4}; round_p` maps each numerator `v` of `cnj Z` to
`rndV v = round((S·(S·v))·2^{2b+4} / 2^p)`.

* **`round_pt`**: if `2^{2b+4} S (S · cnj Z_k)` is within `1/2` of the natural `c`, the two rounded
  numerators at `k` are `c` and `0`.
* `gR_zero`: zeros stay zero (the padding).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open Complex AModel AModelL12 IntMul KIL KFB KFT KFU RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-- The four passes on one numerator. -/
def rndV (p b S : ℕ) (v : ℤ) : ℤ :=
  (((S : ℤ) * (((S : ℤ) * v).tdiv (2 ^ 0))).tdiv (2 ^ 0) * 2 ^ (2 * b + 4) + 2 ^ (p - 1)).tdiv
    (2 ^ p)

/-! ## The passes -/

/-- The width of the rounding passes. -/
def wFR (n D : ℕ) : ℕ := NLogN.KFM.wU n D + 4 * bP n + 5

/-- The passes `conj; ×S; ×S; ×2^{2b+4}; round_p`. -/
def finA {E : ℕ} : IStmt HS (7 + E) :=
  .seq conjW (.seq (smulW NLogN.KFM.rS rOne) (.seq (smulW NLogN.KFM.rS rOne) (.seq (shlW rF) NLogN.KFM.roundW)))

/-- The cost of one `×S` pass. -/
def kSm (n D : ℕ) : ℕ :=
  cItem (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (fmB (2 * wFR n D) + 5000 * (wFR n D + 0 + 3)) (2 * wFR n D) +
    2 * cCnt (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) + cW (sCmp n : ℤ) + cW (2 ^ 0) + cW ((2 ^ (IntMul.OpenAI.Glue.LP n + 1) : ℕ) : ℤ)

/-- The cost of the `×2^{2b+4}` pass. -/
def kShF (n D : ℕ) : ℕ :=
  cItem (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (1000 * (wFR n D + (2 * bP n + 4) + 2)) (wFR n D + (2 * bP n + 4) + 1) +
    2 * cCnt (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) + cW (2 ^ (2 * bP n + 4)) + cW ((2 ^ (IntMul.OpenAI.Glue.LP n + 1) : ℕ) : ℤ)

/-- The cost of the rounding pass. -/
def kRd (n D : ℕ) : ℕ :=
  cItem (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (3000 * (wFR n D + pP n + 3)) (2 * wFR n D + 1) +
    2 * cCnt (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) + cW (2 ^ (pP n - 1)) + cW (2 ^ pP n) +
    cW ((2 ^ (IntMul.OpenAI.Glue.LP n + 1) : ℕ) : ℤ)

/-- The cost of `finA`. -/
def kFinA (n D : ℕ) : ℕ := kCj n (NLogN.KFM.wU n D) + (kSm n D + (kSm n D + (kShF n D + kRd n D)))

end

end NLogN.KFM

end


