open LonelyRunner.CollectiveFibreNormalForm

theorem solution {n r m q : ℕ}
    (hr : 0 < r) (hrn : r < n) (hm : 0 < m) (hqp : m*r < q)
    (hnot : ¬ r ∣ q) (hcop : ¬ Nat.Coprime r q)
    (hactive : ∃ b ∈ CollectiveUnits.units r,
      CollectiveBoundary.Blocks (n:ℤ) r m q b) :
    Nonempty (ActiveFibre n r m q) := by
  obtain ⟨b, hb, D, hD, hDb⟩ := hactive
  have hbc := (CollectiveUnits.mem_units.mp hb).2
  have hri : (0:ℤ) < r := by exact_mod_cast hr
  have hrni : (r:ℤ) < n := by exact_mod_cast hrn
  have hmi : (0:ℤ) < m := by exact_mod_cast hm
  have hqpi : (m:ℤ)*r < q := by exact_mod_cast hqp
  have hnm : (0:ℤ) < n*m := mul_pos (lt_trans hri hrni) hmi
  have hDpos : 0 < D := by
    have hlow := (abs_le.mp hD).1
    by_contra! hn
    have hmul := mul_nonpos_of_nonneg_of_nonpos hnm.le hn
    nlinarith only [hlow, hmul, hqpi]
  let d := Nat.gcd r q
  have hdpos : 0 < d := Nat.gcd_pos_of_pos_left q hr
  have hdi : (0:ℤ) < d := by exact_mod_cast hdpos
  obtain ⟨h, U, hcU, hrh, hqU⟩ := Nat.exists_coprime r q
  have hrEq : r = d*h := by simpa [d, Nat.mul_comm] using hrh
  have hqEq : q = d*U := by simpa [d, Nat.mul_comm] using hqU
  have hrEi : (r:ℤ) = (d:ℤ)*h := by exact_mod_cast hrEq
  have hqEi : (q:ℤ) = (d:ℤ)*U := by exact_mod_cast hqEq
  have htwo : 2 ≤ h := by
    by_contra! hh
    have hh1 : h = 1 := by nlinarith only [hrEq, hr, hh]
    apply hnot
    rw [hrEq, hqEq, hh1, Nat.mul_one]
    exact dvd_mul_right d U
  obtain ⟨x, y, hxy⟩ := CollectiveBoundary.determinant_in_ideal hbc.isCoprime hDb
  have hdd : (d:ℤ) ∣ D := by
    rw [← hxy, hrEi, hqEi]
    refine ⟨x*h+y*U, ?_⟩
    ring
  have hcastD : (D.toNat:ℤ) = D := Int.toNat_of_nonneg hDpos.le
  have hddNat : d ∣ D.toNat := by
    apply Int.natCast_dvd_natCast.mp
    simpa only [hcastD] using hdd
  obtain ⟨V, hV⟩ := hddNat
  have hDE : D = (d:ℤ)*V := by
    rw [← hcastD]
    exact_mod_cast hV
  have hVpos : 0 < V := by
    by_contra! hv
    have : V = 0 := by omega
    simp [this] at hDE
    omega
  have hdiv_iff : ∀ c : ℕ,
      (r:ℤ) ∣ D*c-q ↔ (h:ℤ) ∣ (V:ℤ)*c-U := by
    intro c
    rw [hrEi, hqEi, hDE]
    have heq : (d:ℤ)*V*c-d*U = (d:ℤ)*((V:ℤ)*c-U) := by ring
    rw [heq, Int.mul_dvd_mul_iff_left hdi.ne']
  have hcV : Nat.Coprime h V := by
    exact (CollectiveBoundary.determinant_coprime hcU.isCoprime
      ((hdiv_iff b).mp hDb)).natCoprime
  have hwindow : |(n:ℤ)*m*V-U| ≤ (h:ℤ)*m := by
    have heq : (n:ℤ)*m*D-q = (d:ℤ)*((n:ℤ)*m*V-U) := by
      rw [hDE, hqEi]
      ring
    change |(n:ℤ)*m*D-q| ≤ (m:ℤ)*r at hD
    rw [heq, abs_mul, abs_of_pos hdi, hrEi] at hD
    nlinarith only [hD, hdi]
  refine ⟨⟨d, h, U, V, hdpos, htwo, hVpos, hrEq, hqEq, hcU, hcV,
    hwindow, ?_⟩⟩
  intro c hc
  constructor
  · rintro ⟨E, hE, hEc⟩
    have hDE' : D = E := CollectiveBoundary.same_det_of_not_coprime
      hri hrni hmi (fun hh => hcop hh.natCoprime) hbc.isCoprime
      (CollectiveUnits.mem_units.mp hc).2.isCoprime hD hE hDb hEc
    exact (hdiv_iff c).mp (by simpa only [hDE'] using hEc)
  · intro hh
    exact ⟨D, hD, (hdiv_iff c).mpr hh⟩
