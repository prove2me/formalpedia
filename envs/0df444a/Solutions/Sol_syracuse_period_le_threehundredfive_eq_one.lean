theorem margin_of (a Kb B : ℕ) (hlow : 2 ^ Kb ≤ 3 ^ a)
    (hnum : (3 * B + 1) ^ a < 2 ^ (Kb + 1) * B ^ a) :
    ∀ K : ℕ, 3 ^ a < 2 ^ K → (3 * B + 1) ^ a < 2 ^ K * B ^ a := by
  intro K hK
  have hKb : Kb + 1 ≤ K := by
    by_contra hcon
    push Not at hcon
    have h2 : (2:ℕ) ^ K ≤ 2 ^ Kb := Nat.pow_le_pow_right (by norm_num) (by omega)
    omega
  have h3 : (2:ℕ) ^ (Kb + 1) ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) hKb
  calc (3 * B + 1) ^ a < 2 ^ (Kb + 1) * B ^ a := hnum
    _ ≤ 2 ^ K * B ^ a := Nat.mul_le_mul_right _ h3

