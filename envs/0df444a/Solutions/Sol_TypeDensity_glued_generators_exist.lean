theorem solution (R : Type) [CommRing R] (t x : R) (beta : TypeDensity.BlowupRestriction R t x)
    (hreg : TypeDensity.RegularParameterPair R t x) (d : ℕ)
    (gA : ℕ → TypeDensity.BlowupChart R t x) (gB : ℕ → TypeDensity.BlowupChart R x t)
    (hA : ∀ j : ℕ, Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (gA (j+1))} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (gA j)})
    (hB : ∀ j : ℕ, Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (gB (j+1))} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (gB j)})
    (hregA : ∀ j : ℕ, Function.Injective (fun c : TypeDensity.BlowupChart R t x ⧸ (TypeDensity.chartExceptional R t x)^j =>
      Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (gA j) * c))
    (hregBc : ∀ j : ℕ, Function.Injective (fun c : TypeDensity.BlowupChart R x t ⧸ (TypeDensity.chartExceptional R x t)^j =>
      Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (gB j) * c))
    (hoverlap : ∀ j : ℕ, Ideal.span {Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j)
      ((algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (gA j))} =
      Ideal.span {Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j) (beta.right (gB j))})
    (hregC : ∀ j : ℕ, Function.Injective (fun c : TypeDensity.BlowupOverlap R t x ⧸
      (Ideal.span {TypeDensity.overlapException R t x})^j =>
      Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j) (beta.right (gB j)) * c))
    (hnorm : ∃ u : Rˣ, (algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (gA 1) - algebraMap
      R (TypeDensity.BlowupOverlap R t x) (u : R) * ((TypeDensity.overlapSlope R t x)^d * beta.right (gB 1)) ∈
      (Ideal.span {TypeDensity.overlapException R t x})) :
    ∃ G : TypeDensity.GluedGenerators R t x beta d, ∀ j : ℕ,
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (G.left j)} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (gA j)} ∧
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (G.right j)} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (gB j)} := by
  let A := TypeDensity.BlowupChart R t x
  let B := TypeDensity.BlowupChart R x t
  let Inv : ℕ → A × B → Prop := fun j p =>
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) p.1} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (gA j)} ∧
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) p.2} =
      Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (gB j)} ∧
    algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) p.1 - (TypeDensity.overlapSlope R t x)^d *
      beta.right p.2 ∈ (Ideal.span {TypeDensity.overlapException R t x})^j
  have hstep : ∀ n : ℕ, ∀ p : {p : A × B // Inv (n+1) p}, ∃ q : A × B,
      (q.1 - p.1.1 ∈ (TypeDensity.chartExceptional R t x)^(n+1) ∧
        q.2 - p.1.2 ∈ (TypeDensity.chartExceptional R x t)^(n+1)) ∧ Inv (n+2) q := by
    intro n p
    obtain ⟨FA', FB', h1, h2, h3⟩ := TypeDensity.glued_generators_succ R t x beta hreg d gA gB hA hB hregA
      hregBc hoverlap hregC (n+1) (by omega) p.1.1 p.1.2 p.2.1 p.2.2.1 p.2.2.2
    exact ⟨(FA', FB'), ⟨h1, h2⟩, h3⟩
  obtain ⟨FA1, FB1, h1⟩ := TypeDensity.glued_generators_level_one R t x beta d (gA 1) (gB 1) hnorm
  choose next hnext using hstep
  let seq : ∀ n : ℕ, {p : A × B // Inv (n+1) p} := fun n =>
    Nat.rec ⟨(FA1, FB1), h1⟩ (fun n p => ⟨next n p, (hnext n p).2⟩) n
  let left : ℕ → A := fun j => match j with | 0 => gA 0 | n+1 => (seq n).1.1
  let right : ℕ → B := fun j => match j with | 0 => gB 0 | n+1 => (seq n).1.2
  refine ⟨⟨left, right, ?_, ?_, ?_⟩, ?_⟩ <;> rintro (_ | n)
  · simp
  · exact (hnext n (seq n)).1.1
  · simp
  · exact (hnext n (seq n)).1.2
  · simp
  · exact (seq n).2.2.2
  · exact ⟨rfl, rfl⟩
  · exact ⟨(seq n).2.1, (seq n).2.2.1⟩
