-- title:
--   Theorem 2.14 (Markovian projection, Gyöngy / Brunick–Shreve)
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb F,\mathbb P)$ be a filtered probability space supporting the following:
--   - a continuous $\mathbb F$-adapted process $X$ with values in $\mathbb R^d$;
--   - an $\mathbb F$-Brownian motion $W$;
--   - a bounded $\mathbb F$-progressively measurable process $b=(b_t)$ such that, almost surely,
--   $$X_t=X_0+\int_0^tb_s\,ds+W_t,\qquad t\in[0,T].$$
--
--   Then there exists a bounded Borel function $\hat b:[0,T]\times\mathbb R^d\to\mathbb R^d$ with the following properties.
--   1. For every $t\in[0,T]$, $\hat b(t,X_t)=\mathbb E[b_t\mid X_t]$ almost surely.
--   2. The SDE $dY_t=\hat b(t,Y_t)\,dt+dW_t$, $Y_0=X_0$, has a strong solution on the same space, adapted to the completed filtration generated by $(X_0,W)$.
--   3. Every such strong solution satisfies $Y_t\overset{d}{=}X_t$ for each $t\in[0,T]$.
--
--   The Markovian projection replaces a non-Markovian drift by a Markovian one with the same one-dimensional marginals. In the paper's proof of Theorem 3.10 it identifies the value of a limiting deviation.
--
--   **Formalization Note** The paper writes "the unique strong solution". Here existence is part of the conclusion, and the marginal identity is asserted for every strong solution, which is what uniqueness (Veretennikov) makes equivalent. The process $b$ is indexed by $[0,\infty)$ and required progressively measurable and bounded at all times. A process on $[0,T]$ extends by $0$, so every instance of the paper is covered. The conditional expectation is with respect to $\sigma(X_t)$, which lies below the ambient $\sigma$-field because $X$ is measurable.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, p. 12, Theorem 2.14 (quoting Gyöngy 1986, Theorem 4.6, and Brunick–Shreve 2013, Corollary 3.7)

import Mathlib
import Definitions.Def_ClosedLoopMFG_Converse_Model
import Definitions.Def_ClosedLoopMFG_Converse_Game
import Definitions.Def_ClosedLoopMFG_Converse_Equilibrium

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace ClosedLoopMFG.Converse

theorem theorem_2_14 {d : ℕ} {T : ℝ≥0} (hT : 0 < T) {Ω : Type} [mΩ : MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (𝓕 : Filtration ℝ≥0 mΩ)
    (X : Ω → ClosedLoopMFG.Limit.Path d T) (hX : Measurable X)
    (hXad : ∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => X ω s))
    (W : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d) (hW : IsFBrownian 𝓕 P W)
    (bp : ℝ≥0 → Ω → ClosedLoopMFG.Limit.E d) (hbp : IsStronglyProgressive 𝓕 bp) (hbd : ∃ C : ℝ, ∀ t ω, ‖bp t ω‖ ≤ C)
    (heq : ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
      X ω t = ev (X ω) 0 + (∫ s in (0 : ℝ)..t, bp s.toNNReal ω) + W (t : ℝ).toNNReal ω) :
    ∃ bh : ℝ → ClosedLoopMFG.Limit.E d → ClosedLoopMFG.Limit.E d, Measurable (Function.uncurry bh) ∧
      (∃ C : ℝ, ∀ t x, ‖bh t x‖ ≤ C) ∧
      (∀ t : Set.Icc (0 : ℝ) T, (fun ω => bh t (X ω t)) =ᵐ[P]
        P[bp (t : ℝ).toNNReal | MeasurableSpace.comap (fun ω => X ω t) inferInstance]) ∧
      (∃ Y : Ω → ClosedLoopMFG.Limit.Path d T, IsStrongSol P (fun ω => ev (X ω) 0) W bh Y) ∧
      ∀ Y : Ω → ClosedLoopMFG.Limit.Path d T, IsStrongSol P (fun ω => ev (X ω) 0) W bh Y →
        ∀ t : Set.Icc (0 : ℝ) T, P.map (fun ω => Y ω t) = P.map (fun ω => X ω t) := by sorry

end ClosedLoopMFG.Converse
