  have hg := expNeg_bound P (t ^ 3 * α ^ 2) (gNum s t H k j) hk1
  have hcσ : Real.exp (Real.pi * (cNum s t H k : ℕ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ)) ≤ 2 ^ σ := hec
  have hc := expPos_bound P (t ^ 2 * α ^ 2) (cNum s t H k) σ hk2 hcσ hσP
  set A := aT P s t α H k j
  set G := gT P s t α H k j
