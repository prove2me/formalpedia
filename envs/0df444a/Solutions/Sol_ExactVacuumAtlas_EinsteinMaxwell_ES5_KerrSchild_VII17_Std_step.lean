theorem hadamard' {k : ℕ} {G : ℝ → ℝ} (hG : PS G) (hE : ExtV (k + 1) G 0) :
    ∃ L, ExtV k (fun x => G x / x) L := by
  obtain ⟨L, hL⟩ := RL_exists (RL_succ.1 hE.RL).2
