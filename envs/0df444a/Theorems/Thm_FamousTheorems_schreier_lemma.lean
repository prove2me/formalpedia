-- title:
--   Schreier's lemma
-- statement:
--   **Schreier's lemma.** Let $H$ be a subgroup of a group $G$ generated by a set $S$, and let $R$ be a right transversal of $H$ in $G$ with $1\in R$. For $g\in G$ write $\overline g$ for the representative in $R$ of the coset $Hg$. Then $H$ is generated by the Schreier generators
--   $$\{\,rs\,\overline{rs}^{\,-1} : r\in R,\ s\in S\,\}.$$
--
--   In particular a subgroup of finite index in a finitely generated group is finitely generated, with at most $[G:H]\cdot|S|$ generators. The lemma is the basis of the Schreier–Sims algorithm in computational group theory and of the Nielsen–Schreier rank formula for subgroups of free groups.
--
--   **Formalization note.** Mathlib's `Subgroup.closure_mul_image_eq`. `Subgroup.IsComplement (H : Set G) R` says every element of $G$ factors uniquely as $h\,r$ with $h\in H$, $r\in R$ (so $R$ is a right transversal), and `hR.toRightFun g` is the representative $\overline g\in R$. `R * S` is the pointwise product set.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `Subgroup.closure_mul_image_eq`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

open scoped Pointwise

theorem schreier_lemma {G : Type*} [Group G] {H : Subgroup G} {R S : Set G} (hR : Subgroup.IsComplement (H : Set G) R)
    (hR1 : (1 : G) ∈ R) (hS : Subgroup.closure S = ⊤) :
    Subgroup.closure ((R * S).image fun g => g * (hR.toRightFun g : G)⁻¹) = H := by sorry

end FamousTheorems
