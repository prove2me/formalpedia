      have hp : 0 < c ^ s * c ^ s := Nat.mul_pos (Nat.pow_pos hc0) (Nat.pow_pos hc0)
      have h4 : 4 ≤ c ^ 2 := by nlinarith
      have : c ^ (2 * s + 2) = (c ^ s * c ^ s) * c ^ 2 := by rw [← pow_add, ← pow_add]; congr 1; ring
      rw [this]; nlinarith
    have h3 : c ^ (2 * s + 2) ≤ c ^ (2 * s + 2) * a := Nat.le_mul_of_pos_right _ ha
    omega
  have hex : ∃ i, c ^ s * b < c ^ (2 * i + 2) * a := ⟨s, hPs⟩
  set i₀ := Nat.find hex with hi₀def
  have hi₀ : c ^ s * b < c ^ (2 * i₀ + 2) * a := Nat.find_spec hex
  have hi₀s : i₀ ≤ s := Nat.find_min' hex hPs
  have hlow : c ^ (2 * i₀) * a ≤ c ^ s * b := by
    rcases Nat.eq_zero_or_pos i₀ with h0 | hpos
    · rw [h0]; simp only [Nat.mul_zero, pow_zero, one_mul]
      calc a ≤ c ^ d := had
