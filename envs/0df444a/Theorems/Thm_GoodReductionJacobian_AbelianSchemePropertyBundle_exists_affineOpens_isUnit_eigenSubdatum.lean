theorem GoodReductionJacobian.AbelianSchemePropertyBundle.exists_affineOpens_isUnit_eigenSubdatum
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (n : ℕ) (hn : (n : K) ≠ 0)
    (hG : ∀ x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n, L.translate x ≫ L.schemeNsmul n = L.schemeNsmul n)
    (χ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K) (hχ : L.IsNsmulCharacter n χ) (y : A) :
    ∃ V : A.affineOpens, y ∈ V.1 ∧
      ∃ s : (L.eigenSubdatum n hG χ).obj V.1,
        IsUnit (show Γ(A, (L.schemeNsmul n) ⁻¹ᵁ V.1) from s.1) := by sorry
