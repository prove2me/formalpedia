open Matrix

namespace ExactVacuumAtlas

/-- `toQuadraticForm'` of a congruent matrix is the composition with `toLin' P`. -/
theorem toQuadraticForm_prime_congr {n : ℕ} (G P : Matrix (Fin n) (Fin n) ℝ) :
    (Pᵀ * G * P).toQuadraticForm' = G.toQuadraticForm'.comp (Matrix.toLin' P) := by
  ext v
  simp only [Matrix.toQuadraticForm', LinearMap.BilinMap.toQuadraticMap_apply,
    QuadraticMap.comp_apply, Matrix.toLinearMap₂'_apply', Matrix.toLin'_apply]
  rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    Matrix.vecMul_transpose, Matrix.dotProduct_mulVec, Matrix.dotProduct_mulVec]

/-- The weights of `eta n`. -/
theorem eta_toQuadraticForm_prime (n : ℕ) :
    (eta n).toQuadraticForm' =
      QuadraticMap.weightedSumSquares ℝ (fun i : Fin (n + 1) => if i = 0 then (-1 : ℝ) else 1) := by
  ext v
  simp only [Matrix.toQuadraticForm', LinearMap.BilinMap.toQuadraticMap_apply,
    Matrix.toLinearMap₂'_apply', QuadraticMap.weightedSumSquares_apply, eta,
    Matrix.mulVec_diagonal, dotProduct, smul_eq_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

theorem ncard_pos_weights (n : ℕ) :
    {i : Fin (n + 1) | 0 < (if i = 0 then (-1 : ℝ) else 1)}.ncard = n := by
  have h : {i : Fin (n + 1) | 0 < (if i = 0 then (-1 : ℝ) else 1)} = ({0} : Set (Fin (n + 1)))ᶜ := by
    ext i; by_cases hi : i = 0 <;> simp [hi]
  rw [h, Set.ncard_compl, Set.ncard_singleton, Nat.card_eq_fintype_card, Fintype.card_fin]
  simp

theorem ncard_neg_weights (n : ℕ) :
    {i : Fin (n + 1) | (if i = 0 then (-1 : ℝ) else 1) < 0}.ncard = 1 := by
  have h : {i : Fin (n + 1) | (if i = 0 then (-1 : ℝ) else 1) < 0} = ({0} : Set (Fin (n + 1))) := by
    ext i; by_cases hi : i = 0 <;> simp [hi]
  rw [h, Set.ncard_singleton]

end ExactVacuumAtlas

