variable {P X : Type*} [Group P] [MulAction P X]

def setOfEquiv {Δ Δ' : Subgroup P} (hle : Δ' ≤ Δ) (x : X) :
    ↥{g : P | g ∈ Δ' ∧ g • x = x} ≃ ↥(MulAction.stabilizer ↥Δ x ⊓ Δ'.subgroupOf Δ) where
  toFun g := ⟨⟨g.1, hle g.2.1⟩, Subgroup.mem_inf.mpr
    ⟨by rw [MulAction.mem_stabilizer_iff, Subgroup.mk_smul]; exact g.2.2,
     Subgroup.mem_subgroupOf.mpr g.2.1⟩⟩
  invFun k := ⟨(k.1 : P), by
    refine ⟨Subgroup.mem_subgroupOf.mp (Subgroup.mem_inf.mp k.2).2, ?_⟩
    have h := MulAction.mem_stabilizer_iff.mp (Subgroup.mem_inf.mp k.2).1
    rwa [Subgroup.smul_def] at h⟩
  left_inv g := rfl
  right_inv k := rfl

theorem natCard_setOf_dvd {Δ Δ' : Subgroup P} (hle : Δ' ≤ Δ) (x : X) :
    Nat.card ↥{g : P | g ∈ Δ' ∧ g • x = x} ∣ Nat.card ↥(MulAction.stabilizer ↥Δ x) := by
  rw [Nat.card_congr (setOfEquiv hle x)]
  exact Subgroup.card_dvd_of_le inf_le_left

end Stab

section Val

theorem valuation_natCast_eq_one_of_not_dvd (r : ℕ) [hr : Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    (hA : A.LiesOverPrime r) {n : ℕ} (hn : ¬ r ∣ n) :
    A.valuation ((n : ℕ) : AlgebraicClosure ℚ) = 1 := by
  have hle : A.valuation ((n : ℕ) : AlgebraicClosure ℚ) ≤ 1 :=
    (A.valuation_le_one_iff _).mpr (natCast_mem A n)
  refine le_antisymm hle ?_
  by_contra hlt
  rw [not_le] at hlt
  have hr1 : A.valuation ((r : ℕ) : AlgebraicClosure ℚ) < 1 := (A.mem_nonunits_iff).mp hA
  have hcop : IsCoprime (r : ℤ) (n : ℤ) := by
    rw [Nat.isCoprime_iff_coprime]
    exact (Nat.Prime.coprime_iff_not_dvd hr.out).mpr hn
  obtain ⟨s, t, hst⟩ := hcop
  have hcast := congrArg (Int.cast : ℤ → AlgebraicClosure ℚ) hst
  push_cast at hcast
  have hs : A.valuation ((s : ℤ) : AlgebraicClosure ℚ) ≤ 1 := (A.valuation_le_one_iff _).mpr (intCast_mem A s)
  have ht : A.valuation ((t : ℤ) : AlgebraicClosure ℚ) ≤ 1 := (A.valuation_le_one_iff _).mpr (intCast_mem A t)
  have h1 : A.valuation ((s : AlgebraicClosure ℚ) * (r : AlgebraicClosure ℚ)) < 1 := by
    rw [map_mul]
    calc A.valuation ((s : ℤ) : AlgebraicClosure ℚ) * A.valuation ((r : ℕ) : AlgebraicClosure ℚ)
        ≤ 1 * A.valuation ((r : ℕ) : AlgebraicClosure ℚ) := mul_le_mul_left hs _
      _ = A.valuation ((r : ℕ) : AlgebraicClosure ℚ) := one_mul _
      _ < 1 := hr1
  have h2 : A.valuation ((t : AlgebraicClosure ℚ) * (n : AlgebraicClosure ℚ)) < 1 := by
    rw [map_mul]
    calc A.valuation ((t : ℤ) : AlgebraicClosure ℚ) * A.valuation ((n : ℕ) : AlgebraicClosure ℚ)
        ≤ 1 * A.valuation ((n : ℕ) : AlgebraicClosure ℚ) := mul_le_mul_left ht _
      _ = A.valuation ((n : ℕ) : AlgebraicClosure ℚ) := one_mul _
      _ < 1 := hlt
  have h3 := Valuation.map_add_lt A.valuation h1 h2
  rw [hcast, map_one] at h3
  exact lt_irrefl _ h3

theorem valued_natCast_eq_one_of_not_dvd (r : ℕ) [hr : Fact r.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    (hA : A.LiesOverPrime r) {n : ℕ} (hn : ¬ r ∣ n) :
    Valued.v ((n : ℕ) : A.valuation.Completion) = 1 := by
  have h1 : ((n : ℕ) : A.valuation.Completion) =
      ((WithVal.toVal A.valuation ((n : ℕ) : AlgebraicClosure ℚ) : WithVal A.valuation) : A.valuation.Completion) := by
    rw [WithVal.toVal_natCast]
    exact (map_natCast (UniformSpace.Completion.coeRingHom : WithVal A.valuation →+* A.valuation.Completion) n).symm
  rw [h1, Valued.valuedCompletion_apply, WithVal.valued_toVal]
  exact valuation_natCast_eq_one_of_not_dvd r A hA hn

end Val

section Residue

theorem finite_residueField_of_card_quotient {𝒪₀ : Type*} [CommRing 𝒪₀] [IsDomain 𝒪₀] [IsDiscreteValuationRing 𝒪₀]
    (π : 𝒪₀) (hπ : Irreducible π) {q : ℕ} (hq : q ≠ 0) (hres : Nat.card (𝒪₀ ⧸ Ideal.span {π}) = q) :
    Finite (IsLocalRing.ResidueField 𝒪₀) := by
  have hmax : IsLocalRing.maximalIdeal 𝒪₀ = Ideal.span {π} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
  have hfin : Finite (𝒪₀ ⧸ Ideal.span {π}) := Nat.finite_of_card_ne_zero (by rw [hres]; exact hq)
  exact Finite.of_equiv (𝒪₀ ⧸ Ideal.span {π}) (Ideal.quotEquivOfEq hmax.symm).toEquiv

end Residue

