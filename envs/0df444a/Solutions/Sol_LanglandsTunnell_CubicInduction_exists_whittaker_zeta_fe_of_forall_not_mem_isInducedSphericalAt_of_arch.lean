variable {v : HeightOneSpectrum (𝓞 ℚ)}

private def localIntegrand (W : LocalGL3 v → ℂ) (k : LocalGL3 v) (χv : (v.adicCompletion ℚ)ˣ →* ℂˣ) (s : ℂ) :
    (v.adicCompletion ℚ)ˣ → ℂ :=
  fun a => W (iotaGL (diagUnitGL2 a) * k) * ((χv a : ℂˣ) : ℂ) *
    ((TateLocal.modulus (a : v.adicCompletion ℚ) : ℝ) : ℂ) ^ (s - 1)

private def archIntegrand (W : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (k : GL (Fin 3) (InfiniteAdeleRing ℚ))
    (σ : (InfiniteAdeleRing ℚ)ˣ →* ℂˣ) (s : ℂ) : (InfiniteAdeleRing ℚ)ˣ → ℂ :=
  fun a => W (iotaGL (diagUnitGL2 a) * k) * ((σ a : ℂˣ) : ℂ) * ((‖(a : InfiniteAdeleRing ℚ)‖ : ℝ) : ℂ) ^ (s - 1)

end
