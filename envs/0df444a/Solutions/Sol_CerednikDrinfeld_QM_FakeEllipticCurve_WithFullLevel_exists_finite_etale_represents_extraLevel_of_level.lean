variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S : Type} [CommRing S]
  {E : FakeEllipticCurve Λ N₀ S} {N : ℕ} [NeZero N] [Fact (IsUnit ((N : ℕ) : S))] [Fact (IsUnit ((N₀ : ℕ) : S))]
  (D : L1aData E N)
  {T : Type} [CommRing T] (φ : S →+* T) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
  (hg : FakeEllipticCurve.IsPullbackVia φ E E' g)

def z₀ (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    Spec (CommRingCat.of T) ⟶ D.Z₀ :=
  D.pt T φ _ (E'.L.schemeKerStr N) (kN φ E E' g hg N) (kN_isPullback φ E E' g hg N) U' hU'

def zC (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of (C D.ζ₀)) :=
  z₀ D φ E' g hg U' hU' ≫ (Aff.eX D.ζ₀).hom

def θ (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) : C D.ζ₀ →+* T :=
  (Spec.preimage (zC D φ E' g hg U' hU')).hom

theorem spec_θ (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    Spec.map (CommRingCat.ofHom (θ D φ E' g hg U' hU')) = zC D φ E' g hg U' hU' := by
  rw [θ, CommRingCat.ofHom_hom, Spec.map_preimage]

theorem θ_comp (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    (θ D φ E' g hg U' hU').comp (algebraMap S (C D.ζ₀)) = φ := by
  have h : Spec.map (CommRingCat.ofHom ((θ D φ E' g hg U' hU').comp (algebraMap S (C D.ζ₀)))) =
      Spec.map (CommRingCat.ofHom φ) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, spec_θ]
    show (z₀ D φ E' g hg U' hU' ≫ (Aff.eX D.ζ₀).hom) ≫ Aff.pQ D.ζ₀ = _
    rw [Category.assoc, Aff.eX_hom_pQ]
    exact D.h1 T φ _ _ _ _ U' hU'
  have := Spec.map_injective h
  exact congrArg CommRingCat.Hom.hom this

theorem z₀_eq (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    z₀ D φ E' g hg U' hU' = Spec.map (CommRingCat.ofHom (θ D φ E' g hg U' hU')) ≫ zU D := by
  rw [spec_θ, zC, Category.assoc, Iso.hom_inv_id, Category.comp_id]

abbrev kN' (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    E'.L.schemeKer N ⟶ (EC E D.ζ₀).L.schemeKer N :=
  kN (θ D φ E' g hg U' hU') (EC E D.ζ₀) E' (kA E D.ζ₀ φ E' g hg _ (θ_comp D φ E' g hg U' hU'))
    (kA_via E D.ζ₀ φ E' g hg _ (θ_comp D φ E' g hg U' hU')) N

theorem kN'_preimage_𝒰 (U' : (E'.L.schemeKer N).Opens) (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) :
    kN' D φ E' g hg U' hU' ⁻¹ᵁ 𝒰 D = U' :=
  key_transfer D φ E' g hg U' hU' _ (θ_comp D φ E' g hg U' hU') (z₀_eq D φ E' g hg U' hU')

theorem admSet_preimage [IsFinite (E'.L.schemeKerStr N)] [Etale (E'.L.schemeKerStr N)]
    (s : Finset ↥Λ) (U' : (E'.L.schemeKer N).Opens)
    (hU' : IsClosed (U' : Set ↥(E'.L.schemeKer N))) (t : ↥(Spec (CommRingCat.of T))) :
    Spec.map (CommRingCat.ofHom (θ D φ E' g hg U' hU')) t ∈ admSet D s ↔
      t ∈ admOf (N := N) E' s U' (VC (N := N) E' (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ)) := by
  set θ' := θ D φ E' g hg U' hU'
  have hθ' := θ_comp D φ E' g hg U' hU'
  set k := kN' D φ E' g hg U' hU'
  have hk : IsPullback k (E'.L.schemeKerStr N) ((EC E D.ζ₀).L.schemeKerStr N) (Spec.map (CommRingCat.ofHom θ')) :=
    kN_isPullback θ' (EC E D.ζ₀) E' _ (kA_via E D.ζ₀ φ E' g hg _ hθ') N
  have hkι : k ≫ KerOps.ι (EC E D.ζ₀).L N = KerOps.ι E'.L N ≫ kA E D.ζ₀ φ E' g hg θ' hθ' :=
    kN_ι θ' (EC E D.ζ₀) E' _ (kA_via E D.ζ₀ φ E' g hg _ hθ') N
  have hhom : Transfer.IsHom θ' (EC E D.ζ₀).L E'.L (kA E D.ζ₀ φ E' g hg θ' hθ')
      (kA_isPullback E D.ζ₀ φ E' g hg θ' hθ') := kA_isHom E D.ζ₀ φ E' g hg θ' hθ'
  have hU : (k ⁻¹ᵁ 𝒰 D) = U' := kN'_preimage_𝒰 D φ E' g hg U' hU'
  have hUset : k.base ⁻¹' (𝒰 D : Set _) = (U' : Set _) := by rw [← hU]; rfl

  have m1 := Set.ext_iff.mp (Loci.locOne_transfer θ' _ _ _ _ hhom N k hk hkι (𝒰 D : Set _)) t
  have m2 := Set.ext_iff.mp (Loci.locInv_transfer θ' _ (EC E D.ζ₀).comm _ E'.comm _ _ hhom N k hk hkι (𝒰 D : Set _)) t
  have m3 := Set.ext_iff.mp (Loci.locMul_transfer θ' _ (EC E D.ζ₀).comm _ E'.comm _ _ hhom N k hk hkι (𝒰 D : Set _)) t
  have m4 : ∀ x : ↥Λ, _ := fun x => Set.ext_iff.mp (Loci.locEnd_transfer θ' _ _ _ N k hk hkι _ _ (isHomPt_act _ x)
    _ _ (isHomPt_act _ x) (kA_act E D.ζ₀ φ E' g hg θ' hθ' x) (𝒰 D : Set _)) t
  have m5 := Set.ext_iff.mp (rankLoc_transfer _ _ k _ hk (𝒰 D) (𝒰_closed D) (N ^ 2)) t
  have hWc : ∀ d, IsClosed ((𝒰 D ⊓ Td (EC E D.ζ₀).L (EC E D.ζ₀).comm N d : ((EC E D.ζ₀).L.schemeKer N).Opens) :
      Set ↥((EC E D.ζ₀).L.schemeKer N)) := fun d => by
    rw [TopologicalSpace.Opens.coe_inf]; exact (𝒰_closed D).inter (Td_closed _ (EC E D.ζ₀).comm N d)
  have m6 : ∀ d : ℕ, _ := fun d => Set.ext_iff.mp
    (rankLoc_transfer _ _ k _ hk (𝒰 D ⊓ Td (EC E D.ζ₀).L (EC E D.ζ₀).comm N d) (hWc d) (d ^ 2)) t
  have hTd : ∀ d, k ⁻¹ᵁ (𝒰 D ⊓ Td (EC E D.ζ₀).L (EC E D.ζ₀).comm N d) = U' ⊓ Td E'.L E'.comm N d := fun d => by
    rw [Scheme.Hom.preimage_inf, hU, Td_transfer θ' _ _ _ _ hhom N k hk hkι (EC E D.ζ₀).comm E'.comm]

  have hVC : k ⁻¹ᵁ VC (N := N) (EC E D.ζ₀) (hMC (N₀ := N₀) D) = VC (N := N) E' (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ) :=
    VC_transfer (N := N) (EC E D.ζ₀) (hMC (N₀ := N₀) D) θ' E' _ (kA E D.ζ₀ φ E' g hg θ' hθ') (kA_via E D.ζ₀ φ E' g hg θ' hθ') k hk hkι
  have hVCset : k.base ⁻¹' (VC (N := N) (EC E D.ζ₀) (hMC (N₀ := N₀) D) : Set _) =
      (VC (N := N) E' (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ) : Set _) := by rw [← hVC]; rfl
  have m7 := Set.ext_iff.mp (locDisj_transfer _ N θ' _ k hk
    (Transfer.kN_oneK θ' _ _ _ _ hhom N k hk hkι) (𝒰 D : Set _) (VC (N := N) (EC E D.ζ₀) (hMC (N₀ := N₀) D) : Set _)) t
  simp only [Set.mem_preimage] at m1 m2 m3 m4 m5 m6 m7
  rw [hUset] at m1 m2 m3 m4
  rw [hU] at m5
  simp only [hTd] at m6
  rw [hUset, hVCset] at m7
  rw [mem_admOf, mem_admOf, m1, m2, m3, m5, m7]
  constructor
  · rintro ⟨a1, a2, a3, a4, a5, a6, a7⟩
    exact ⟨a1, a2, a3, fun x hx => (m4 x).mp (a4 x hx), a5, fun d hd => (m6 d).mp (a6 d hd), a7⟩
  · rintro ⟨a1, a2, a3, a4, a5, a6, a7⟩
    exact ⟨a1, a2, a3, fun x hx => (m4 x).mpr (a4 x hx), a5, fun d hd => (m6 d).mpr (a6 d hd), a7⟩

end PerDatum
