variable {D : ℕ}
theorem solution (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    NLogN.KFM.mrL (t (Fin.last D)) (NLogN.KFM.tsOf t) (NLogN.KFM.recL t f) (NLogN.KFM.recL t g) = NLogN.KFM.recL t (NLogN.KFM.mrX t f g) := by
  have hpos := NLogN.KFM.tsOf_pos t
  set r := t (Fin.last D) with hr
  have hr0 : 0 < r := Nat.pos_of_ne_zero (NeZero.ne _)
  set N := (NLogN.KFM.tsOf t).prod with hN
  apply List.ext_getElem (by simp [NLogN.KFM.mrL, NLogN.KFM.recL_length])
  intro j h1 _
  simp only [NLogN.KFM.mrL, List.length_map, List.length_range] at h1
  simp only [NLogN.KFM.mrL, List.getElem_map, List.getElem_range]
  rw [NLogN.KFM.recL_getElem]
  funext c
  -- the two normalizers
  have hT : ((r * N : ℕ) : ℂ) = ∏ i, (t i : ℂ) := by
    rw [hN, NLogN.KFM.tsOf_prod, Fin.prod_univ_castSucc]; push_cast; ring
  rw [Pi.smul_apply, smul_eq_mul, Finset.sum_apply, NLogN.KFM.mrX, hT]
  congr 1
  -- left: sum over (k, a)
  have hL : ∑ k ∈ Finset.range N, NLogN.KFM.ncm ((NLogN.KFM.recL t f).getD k 0) ((NLogN.KFM.recL t g).getD (NLogN.KFM.rmSub (NLogN.KFM.tsOf t) j k) 0) c =
      ∑ x : Fin N × Fin r, f (NLogN.KFM.phiB t x) * g (NLogN.KFM.fullIdx t (NLogN.KFM.rmSub (NLogN.KFM.tsOf t) j x.1) ((c.val + r - x.2.val) % r)) *
        (if x.2.val ≤ c.val then 1 else -1) := by
    rw [Finset.sum_range (fun k => NLogN.KFM.ncm ((NLogN.KFM.recL t f).getD k 0) ((NLogN.KFM.recL t g).getD (NLogN.KFM.rmSub (NLogN.KFM.tsOf t) j k) 0) c),
      Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [NLogN.KFM.recL_getD t f k.2, NLogN.KFM.recL_getD t g (NLogN.KFM.rmSub_lt _ hpos _ _), NLogN.KFM.ncm_eq]
    rfl
  rw [hL]
  -- right: reindex the box sum by `phiB`
  rw [← Fintype.sum_bijective (NLogN.KFM.phiB t) (NLogN.KFM.phiB_bij t) _ _ (fun _ => rfl)]
  refine Finset.sum_congr rfl fun x _ => ?_
  have hc := c.2
  have ha := x.2.2
  -- `J - K` is the box point of `rmSub`
  have hsub : NLogN.KFM.fullIdx t j c - NLogN.KFM.phiB t x =
      NLogN.KFM.fullIdx t (NLogN.KFM.rmSub (NLogN.KFM.tsOf t) j x.1) ((c.val + r - x.2.val) % r) := by
    funext i
    simp only [Pi.sub_apply, NLogN.KFM.phiB, NLogN.KFM.fullIdx]
    by_cases hi : i.val < D
    · simp only [hi, if_true]
      have hil : i.val < (NLogN.KFM.tsOf t).length := by rw [NLogN.KFM.tsOf_length]; exact hi
      rw [NLogN.KFM.digL_rmSub _ hpos _ _ _ hil, NLogN.KFM.tsOf_get]
      have hti : t ⟨i.val, by omega⟩ = t i := rfl
      rw [hti]
      have hk := NLogN.KFM.digL_lt _ hpos x.1.val i.val hil
      rw [NLogN.KFM.tsOf_get, hti] at hk
      exact (NLogN.KFM.cast_sub_mod hk).symm
    · have hiL : i = Fin.last D := Fin.ext (by have := i.2; simp; omega)
      subst hiL
      simp only [Fin.val_last, lt_irrefl, if_false]
      exact (NLogN.KFM.cast_sub_mod ha).symm
  have hlast : (NLogN.KFM.phiB t x (Fin.last D)).val = x.2.val := by
    simp only [NLogN.KFM.phiB, NLogN.KFM.fullIdx_last]; exact NLogN.KFM.val_cast_lt ha
  have hlastJ : (NLogN.KFM.fullIdx t j c (Fin.last D)).val = c.val := by
    rw [NLogN.KFM.fullIdx_last]; exact NLogN.KFM.val_cast_lt hc
  rw [hsub, hlast, hlastJ]
