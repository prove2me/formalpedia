/-- final condition: `2 ^ bb ≤ m ^ j` and `Cb / 2 ^ 40 ≤ C / 2 ^ 40 + (bb + e j) / j * 0.6931471803` -/
def finOK (C Cb m e j bb : ℕ) : Bool :=
