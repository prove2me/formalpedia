theorem solution (U : TypeDensity.SurfaceUniverse) (i : U.ι) (hnt : (U.M i).s.terminal = false)
    (σ : TypeDensity.FactorType) :
    (∀ a c : ℕ, (U.M i).s = TypeDensity.State.single a c → U.termTypeEvent i σ = ⋃ k, U.exitEvent σ k i ∧
        Pairwise (fun k k' : ℕ => Disjoint (U.exitEvent σ k i) (U.exitEvent σ k' i)) ∧
        U.terminatingSet i = ⋃ k, U.termExitEvent k i) ∧
    (∀ a b c h : ℕ, (U.M i).s = TypeDensity.State.crossing a b c h → U.termTypeEvent i σ = U.exitEvent σ 0 i ∧
        U.terminatingSet i = U.termExitEvent 0 i) := by
  have hA : U.termTypeEvent i σ = ⋃ k, U.exitEvent σ k i := by
    apply Set.Subset.antisymm
    · intro J hJ
      obtain ⟨k, hk⟩ := TypeDensity.term_sub_exit U σ i J hJ.2 hnt hJ.1
      exact Set.mem_iUnion.mpr ⟨k, hk⟩
    · exact Set.iUnion_subset fun k => TypeDensity.exit_sub U σ k i hnt
  have hB : U.terminatingSet i = ⋃ k, U.termExitEvent k i := by
    apply Set.Subset.antisymm
    · intro J hJ
      obtain ⟨k, hk⟩ := TypeDensity.term_sub_texit U i J hJ hnt
      exact Set.mem_iUnion.mpr ⟨k, hk⟩
    · exact Set.iUnion_subset fun k => TypeDensity.term_exit_sub U k i hnt
  refine ⟨fun _ _ _ => ⟨hA, fun k k' hk => TypeDensity.exit_disj U σ k k' i hnt hk, hB⟩, ?_⟩
  intro a b c h hs
  have noself : ∀ c' : (U.M i).cellIndex, ¬ (U.M i).IsSelfCell c' := by
    intro c' hc'
    obtain ⟨a', c'', hs', _⟩ := hc'
    rw [hs] at hs'; cases hs'
  constructor
  · rw [hA]
    apply Set.Subset.antisymm
    · intro J hJ
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hJ
      cases k with
      | zero => exact hk
      | succ k =>
        simp only [TypeDensity.SurfaceUniverse.exitEvent, Set.mem_iUnion] at hk
        obtain ⟨c', _⟩ := hk
        exact absurd c'.2 (noself c'.1)
    · exact Set.subset_iUnion (fun k => U.exitEvent σ k i) 0
  · rw [hB]
    apply Set.Subset.antisymm
    · intro J hJ
      obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hJ
      cases k with
      | zero => exact hk
      | succ k =>
        simp only [TypeDensity.SurfaceUniverse.termExitEvent, Set.mem_iUnion] at hk
        obtain ⟨c', _⟩ := hk
        exact absurd c'.2 (noself c'.1)
    · exact Set.subset_iUnion (fun k => U.termExitEvent k i) 0
