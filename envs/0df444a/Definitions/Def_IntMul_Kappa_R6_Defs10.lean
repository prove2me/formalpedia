  have : ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) := by push_cast; rfl
  rw [this, zsz, zbits_two_pow]; simp

theorem zsz_neg_r6c (z : ℤ) : zsz (-z) = zsz z := by simp [zsz, zbits_neg]

theorem zsz_zero_r6c : zsz 0 = 0 := by simp [zsz, zbits, nbits_zero]

theorem zsz_one_r6c : zsz 1 = 1 := by
  simp [zsz, zbits]; rw [nbits_pos (by norm_num)]; simp [nbits_zero]

theorem zsz_mono_r6c {a b : ℤ} (h : a.natAbs ≤ b.natAbs) : zsz a ≤ zsz b :=
