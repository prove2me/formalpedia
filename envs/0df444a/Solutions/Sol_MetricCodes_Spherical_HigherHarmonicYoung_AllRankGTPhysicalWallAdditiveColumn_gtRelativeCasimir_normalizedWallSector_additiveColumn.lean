    _ = ⟪A q, A (A.toLinearMap.adjoint x)⟫_ℝ :=
      (A.inner_map_map q (A.toLinearMap.adjoint x)).symm
    _ = ⟪C p, A (A.toLinearMap.adjoint x)⟫_ℝ := by rw [hq]
    _ = ⟪p, C.adjoint (A (A.toLinearMap.adjoint x))⟫_ℝ :=
