-- name    : ErrBoundCplx.ISTA.l1_ball_bound
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:09:11.975838+00:00
-- url     : https://prove2.me/theorems/ca99390b-6412-4bd8-8714-1c6f77adc6e4
-- title:
--   §5.3 — with R = max(f(x₀)/μ, 1 + ‖d‖²/(2μ)), R > ‖d‖²/(2μ) and every ISTA iterate satisfies ‖x_k‖₁ ≤ R
-- statement:
--   Let $\mu > 0$, $A \in \mathbb R^{m\times n}$, $d \in \mathbb R^m$, $f(x) = \mu\|x\|_1 + \frac12\|Ax - d\|^2$, and $L = \|A^TA\|$ (spectral norm). Let the stepsizes satisfy $0 < \lambda^- \le \lambda_k \le \lambda^+ < 2/L$ for all $k$, and let $(x_k)$ be generated by ISTA from an arbitrary $x_0 \in \mathbb R^n$. Set
--   $$R = \max\Big(\frac{f(x_0)}{\mu},\ 1 + \frac{\|d\|^2}{2\mu}\Big).$$
--   Then $R > \|d\|^2/(2\mu)$ and
--   $$\|x_k\|_1 \le R \qquad \text{for all } k \in \mathbb N.$$
--
--   The ISTA iterates therefore stay in an $\ell_1$ ball on which the error bound of Lemma 10 holds, the stability condition required by Corollary 19.
--
--   **Formalization Note** $\lambda^+ < 2/L$ is written $\lambda^+ L < 2$ so that $A = 0$ ($L = 0$) is covered.
-- source:
--   arXiv:1510.08234v3, §5.3, p. 24

import Mathlib
import Definitions.Def_BoydADMM_Prox_Basic
import Definitions.Def_ErrBoundCplx_ISTA_Lasso
open BoydADMM.Prox
open scoped Matrix

namespace ErrBoundCplx.ISTA

/-- arXiv:1510.08234v3, §5.3, p. 24 (the ℓ1-ball bound for ISTA). Let `μ > 0`, `L = ‖AᵀA‖`
(spectral norm), stepsizes `0 < λ₋ ≤ λ_k ≤ λ₊` with `λ₊ L < 2`, and `(x_k)` an ISTA sequence
from an arbitrary `x₀`. With `R = max(f(x₀)/μ, 1 + ‖d‖²/(2μ))` one has `R > ‖d‖²/(2μ)` and
`‖x_k‖₁ ≤ R` for all `k`. -/
theorem l1_ball_bound {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (d : EuclideanSpace ℝ (Fin m)) (μ : ℝ) (hμ : 0 < μ)
    (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hlm : 0 < lamMinus)
    (hlo : ∀ k, lamMinus ≤ lam k) (hhi : ∀ k, lam k ≤ lamPlus)
    (hLp : lamPlus * specNorm (Aᵀ * A) < 2)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsISTASeq A d μ lam x) :
    let R : ℝ := max (lassoObj A d μ (x 0) / μ) (1 + ‖d‖ ^ 2 / (2 * μ))
    ‖d‖ ^ 2 / (2 * μ) < R ∧ ∀ k, l1Norm (x k) ≤ R := by sorry

end ErrBoundCplx.ISTA
