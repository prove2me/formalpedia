        qvalQ (fun k ↦ ∑ i, E i (c.val i) k)) - 2 +
      ∑ c : RecursiveThinSplit.Split (2 * 2 ^ (2 - 1)) (parent3 0 r),
        (alphaG (n3 0) (m3 0) r c) ^ 2 /
          qvalQ (fun k ↦ ∑ i, E i (c.val i) k)) ≤ ((nn : ℕ) : ℚ)/10^30) :
    Real.log 2 * RecursiveThinSplit.entropyPenalty
        (fun c ↦ ((alphaG (n3 0) (m3 0) r c : ℚ) : ℝ)) ≤
      ((nn : ℕ) : ℝ)/10^30 := by
  refine le_trans (mme_certified_entropy_penalty_rational (alphaG (n3 0) (m3 0) r)
    (alpha_nonneg r) (alpha_sum r) E) ?_
  have hcv : (((((nn : ℕ) : ℚ)/10^30 : ℚ)) : ℝ) = ((nn : ℕ) : ℝ)/10^30 := by
    push_cast; ring
  exact le_of_le_of_eq (by exact_mod_cast h) hcv

