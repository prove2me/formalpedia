      rw [hc2]
      have hzz : NLogN.zsz ((2 : ℤ) ^ j) ≤ n := by rw [NLogN.zsz_two_pow]; omega
      have hb : NLogN.zsz ((2 : ℤ) ^ (j + 1) + -1) ≤ n + 2 :=
        le_trans this (by rw [NLogN.zsz_two_pow]; exact Nat.add_le_add_right (max_le (by omega) (by omega)) 1)
      clear * - hb hzz hjn hz2
      simp only [NLogN.moveCost, NLogN.addIntCost, NLogN.addMagCost, NLogN.subMagCost, NLogN.dupCost, NLogN.zipCost, NLogN.splitCost,
