theorem WeierstrassCurve.exists_mem_rationalHomSet_sub_smul_id_eq_char_smul_of_dvd_of_sq_dvd {k : Type*} [Field k] [IsAlgClosed k] [DecidableEq k] (p : ℕ) [Fact p.Prime] [CharP k p] (W : WeierstrassCurve k) [W.IsElliptic] {β : W.toAffine.Point →+ W.toAffine.Point} (hβ : β ∈ WeierstrassCurve.rationalHomSet k W W) (t q : ℤ) (hchar : β.comp β + q • AddMonoidHom.id _ = t • β) (k₀ : ℤ) (h₁ : (p : ℤ) ∣ t - 2 * k₀) (h₂ : (p : ℤ) ^ 2 ∣ k₀ ^ 2 - t * k₀ + q) : ∃ γ ∈ WeierstrassCurve.rationalHomSet k W W, β - k₀ • AddMonoidHom.id _ = (p : ℤ) • γ := by sorry
