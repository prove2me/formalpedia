lemma vol_qShape_split (Pre G Suf : Shape) (q ρ n : ℕ) :
    vol (qShape Pre G Suf q (ρ + n)) = vol Pre * q ^ (ρ + ρ) * vol (restShape G Suf q n) := by
  rw [← vol_joinShape, joinShape_eq_append, vol_append, vol_append, vol_replicate]

/-- The padded volume is at most twice the volume (`R' < R + W^Kp ≤ 2R`). -/
lemma vol_padded_le {W Kp q ρ : ℕ} (hW : 1 ≤ W) (hWq : W ^ Kp ≤ q ^ (ρ + ρ))
    (Pre G Suf : Shape) (n : ℕ) :
    vol (rowShape (vol Pre) (padRows W Kp (q ^ (ρ + ρ))) G Suf q n) ≤
      2 * vol (qShape Pre G Suf q (ρ + n)) := by
  rw [vol_rowShape, vol_qShape_split]
  have h1 := padRows_lt (K := Kp) (R := q ^ (ρ + ρ)) hW
  have h2 : padRows W Kp (q ^ (ρ + ρ)) ≤ 2 * q ^ (ρ + ρ) := by omega
  calc vol Pre * padRows W Kp (q ^ (ρ + ρ)) * vol (restShape G Suf q n)
      ≤ vol Pre * (2 * q ^ (ρ + ρ)) * vol (restShape G Suf q n) := by gcongr
    _ = 2 * (vol Pre * q ^ (ρ + ρ) * vol (restShape G Suf q n)) := by ring

/-- **Lemma 12, radix-`q` layer: cost `O(V e^τ)`.** -/
theorem l12qCost_le {m : ℕ} {τ K₀ c D : ℝ} (hm : 2 ≤ m) (hτ : 0 < τ) (hK₀ : 0 ≤ K₀)
    (hc : 0 ≤ c) (hD : 0 ≤ D) :
    ∃ K'' : ℝ, 0 ≤ K'' ∧ ∀ (Tc : ℕ → ℝ → ℝ) (W q Kp ρ : ℕ) (Pre G Suf : Shape) (e : ℕ),
      1 ≤ e → 1 ≤ W → (∀ j V, 0 ≤ V → Tc j V ≤ K₀ * V * ((m : ℝ) ^ j) ^ τ) →
      W ^ Kp ≤ q ^ (ρ + ρ) → (ρ : ℝ) ≤ D * (e : ℝ) ^ τ →
      l12qCost Tc c W m q Kp ρ Pre G Suf e ≤
        K'' * (vol (qShape Pre G Suf q e) : ℝ) * (e : ℝ) ^ τ := by
  obtain ⟨K', hK'0, hK'⟩ := arbitrary_width_sum m τ hm hτ
  refine ⟨3 * c * D + 4 * c + 2 * K₀ * K', by positivity, ?_⟩
  intro Tc W q Kp ρ Pre G Suf e he hW hT hWq hρ
  unfold l12qCost
  set V : ℝ := (vol (qShape Pre G Suf q e) : ℝ) with hVdef
  have hV : 0 ≤ V := Nat.cast_nonneg _
  have heτ : 1 ≤ (e : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast he) hτ.le
  have hVe : V ≤ V * (e : ℝ) ^ τ := le_mul_of_one_le_right hV heτ
  have f1 : c * V * ρ ≤ c * D * V * (e : ℝ) ^ τ := by
    have := mul_le_mul_of_nonneg_left hρ (mul_nonneg hc hV)
    linarith
  split_ifs with hρe
  · obtain ⟨n, rfl⟩ : ∃ n, e = ρ + n := ⟨e - ρ, by omega⟩
    simp only [Nat.add_sub_cancel_left]
    set V' : ℝ := (vol (rowShape (vol Pre) (padRows W Kp (q ^ (ρ + ρ))) G Suf q n) : ℝ)
    have hV'0 : 0 ≤ V' := Nat.cast_nonneg _
    have hV' : V' ≤ 2 * V := by
      have := vol_padded_le hW hWq Pre G Suf n
      simp only [V', hVdef]; exact_mod_cast this
    have hsum : ((pieceLevels m n).map fun j => Tc j V').sum ≤
        K₀ * V' * (K' * ((ρ + n : ℕ) : ℝ) ^ τ) := by
      rw [pieceLevels, sum_flatMap_replicate (M := ℝ)]
      have hS : ∑ j ∈ range (Nat.digits m n).length, (digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ ≤
          K' * ((ρ + n : ℕ) : ℝ) ^ τ := by
        rcases Nat.eq_zero_or_pos n with h0 | hn
        · subst h0; simp only [Nat.digits_zero, List.length_nil, range_zero, sum_empty]
          positivity
        · refine (hK' n hn).trans (mul_le_mul_of_nonneg_left ?_ hK'0)
          exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast (by omega : n ≤ ρ + n))
            hτ.le
      calc ∑ j ∈ range (Nat.digits m n).length, (digit m n j : ℝ) * Tc j V'
          ≤ ∑ j ∈ range (Nat.digits m n).length,
              (digit m n j : ℝ) * (K₀ * V' * ((m : ℝ) ^ j) ^ τ) :=
            sum_le_sum fun j _ => mul_le_mul_of_nonneg_left (hT j V' hV'0) (Nat.cast_nonneg _)
        _ = K₀ * V' * ∑ j ∈ range (Nat.digits m n).length,
              (digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ := by
            rw [mul_sum]; apply sum_congr rfl; intro j _; ring
        _ ≤ K₀ * V' * (K' * ((ρ + n : ℕ) : ℝ) ^ τ) :=
            mul_le_mul_of_nonneg_left hS (mul_nonneg hK₀ hV'0)
    have f2 : c * V' ≤ 2 * c * V * ((ρ + n : ℕ) : ℝ) ^ τ := by
      have := mul_le_mul_of_nonneg_left hV' hc
      nlinarith
    have f3 : K₀ * V' * (K' * ((ρ + n : ℕ) : ℝ) ^ τ) ≤
        2 * K₀ * K' * V * ((ρ + n : ℕ) : ℝ) ^ τ := by
      have := mul_le_mul_of_nonneg_left hV' (mul_nonneg (mul_nonneg hK₀ hK'0)
        (le_trans zero_le_one heτ))
      nlinarith
    nlinarith
  · have he' : (e : ℝ) ≤ ρ := by exact_mod_cast (by omega : e ≤ ρ)
    have := mul_le_mul_of_nonneg_left he' (mul_nonneg hc hV)
    have : 0 ≤ (4 * c + 2 * K₀ * K') * V * (e : ℝ) ^ τ := by positivity
    have : 0 ≤ c * D * V * (e : ℝ) ^ τ := by positivity
    nlinarith

/-- `⌈log_m e⌉ ≤ C e^τ` (Bernoulli: `(2^τ)^(k-1) ≥ 1 + (k-1)(2^τ-1)`). -/
theorem clog_le_rpow {m : ℕ} (hm : 2 ≤ m) {τ : ℝ} (hτ : 0 < τ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ e : ℕ, 1 ≤ e → (Nat.clog m e : ℝ) ≤ C * (e : ℝ) ^ τ := by
  set b : ℝ := (2 : ℝ) ^ τ
  have hb : 1 < b := Real.one_lt_rpow (by norm_num) hτ
  have hb1 : 0 < b - 1 := by linarith
  refine ⟨1 + 1 / (b - 1), by positivity, fun e he => ?_⟩
  have heτ : 1 ≤ (e : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast he) hτ.le
  rcases Nat.lt_or_ge 1 e with he1 | he1
  · set k := Nat.clog m e
    have hk : 0 < k := Nat.clog_pos (by omega) he1
    have hlt : m ^ k.pred < e := Nat.pow_pred_clog_lt_self (by omega) he1
    have h2 : 2 ^ (k - 1) < e := lt_of_le_of_lt (Nat.pow_le_pow_left hm _) hlt
    have h3 : ((2 : ℝ) ^ (k - 1)) ^ τ ≤ (e : ℝ) ^ τ :=
      Real.rpow_le_rpow (by positivity) (by exact_mod_cast h2.le) hτ.le
    have h4 : ((2 : ℝ) ^ (k - 1)) ^ τ = b ^ (k - 1) := by
      have := pow_rpow_eq 2 (k - 1) τ
      simpa using this
    have h5 := one_add_mul_le_pow (show (-2 : ℝ) ≤ b - 1 by linarith) (k - 1)
    rw [show 1 + (b - 1) = b by ring] at h5
    have h6 : ((k - 1 : ℕ) : ℝ) * (b - 1) ≤ (e : ℝ) ^ τ := by linarith
    have h7 : ((k - 1 : ℕ) : ℝ) ≤ (e : ℝ) ^ τ / (b - 1) := by
      rw [le_div_iff₀ hb1]; exact h6
    have h8 : (k : ℝ) = ((k - 1 : ℕ) : ℝ) + 1 := by
      rw [Nat.cast_sub (by omega)]; simp
    rw [h8, add_mul, one_mul, div_mul_eq_mul_div, one_mul]
    linarith
  · rw [Nat.clog_of_right_le_one he1]
    simp only [Nat.cast_zero]
    positivity

lemma vol_binShape (Pre G Suf : Shape) (F : ℕ) :
    vol (binShape Pre G Suf F) = vol Pre * vol G * vol Suf * F ^ 2 := by
  simp [binShape, vol_append]; ring

end Cost

