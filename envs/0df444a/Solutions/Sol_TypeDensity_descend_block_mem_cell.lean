theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) (r : ℕ) (b : Fin r → AdjoinRoot Φ)
    (hb : b ∈ TypeDensity.blockCell O Φ r) :
    TypeDensity.descendBlock O Φ r b ∈ TypeDensity.residueCell O (Φ.natDegree * r) (TypeDensity.residuePoly O Φ ^ r) ∧
      (TypeDensity.monicPolyO (TypeDensity.descendBlock O Φ r b)).map (AdjoinRoot.of Φ) =
        TypeDensity.conjugateProduct O Φ (TypeDensity.monicPolyO b) := by
  obtain ⟨_, hdesc, hPm, hPdeg, hPred⟩ := TypeDensity.conjugate_product_invariant O Φ hΦ r b hb
  obtain ⟨hcompat, hinj, _, _, hfac, _⟩ := TypeDensity.conjugate_roots_distinct O Φ hΦ
  obtain ⟨hFm, hFdeg, hFcoeff, _⟩ :=
    TypeDensity.monic_poly_reconstruct O (Φ.natDegree * r) (TypeDensity.descendBlock O Φ r b)
  set P := TypeDensity.conjugateProduct O Φ (TypeDensity.monicPolyO b)
  set F := TypeDensity.monicPolyO (TypeDensity.descendBlock O Φ r b)
  have hlift : F.map (AdjoinRoot.of Φ) = P := by
    ext j
    rw [Polynomial.coeff_map]
    by_cases hj : j < Φ.natDegree * r
    · rw [show F.coeff j = _ from hFcoeff ⟨j, hj⟩]
      change (AdjoinRoot.of Φ) (TypeDensity.descendCoeff O Φ (P.coeff j)) = P.coeff j
      unfold TypeDensity.descendCoeff
      rw [dif_pos (hdesc j)]
      exact Classical.choose_spec (hdesc j)
    · rcases (not_lt.mp hj).eq_or_lt with h | h
      · subst h
        have h1 : F.coeff (Φ.natDegree * r) = 1 := by
          have := hFm.coeff_natDegree; rwa [hFdeg] at this
        have h2 : P.coeff (Φ.natDegree * r) = 1 := by
          have := hPm.coeff_natDegree; rwa [hPdeg] at this
        rw [h1, h2, map_one]
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hFdeg]; exact h),
          Polynomial.coeff_eq_zero_of_natDegree_lt (by rw [hPdeg]; exact h), map_zero]
  refine ⟨?_, hlift⟩
  change F.map (IsLocalRing.residue O) = TypeDensity.residuePoly O Φ ^ r
  apply Polynomial.map_injective _ hinj
  have hcomp : (TypeDensity.residueEmbed O Φ).comp (IsLocalRing.residue O)
      = (TypeDensity.baseReduce O Φ).comp (AdjoinRoot.of Φ) := by
    ext c; exact hcompat c
  rw [Polynomial.map_map, hcomp, ← Polynomial.map_map, hlift, hPred, Polynomial.map_pow, hfac,
    Finset.prod_pow]
