lemma finish_eval (s : Data) : Eval finish s 23 (finished s) := eval_sequence_atoms finishAtoms s
lemma finish_no_memory : NoMemory finish := by simp [finish,finishAtoms,Structured.sequence,NoMemory,NoStore]
lemma finished_values (b : Core) (K : ℝ) (s : Data) (h : InputCapture.Captured b.input s)
    (hH : s.realReg 500 = H b) (hQ : s.realReg 502 = Q b) (hA : s.realReg 526 = A b)
    (hK : s.realReg 442 = K) : Values b K (finished s) := by
  constructor
  all_goals simp only [finished,finishAtoms,List.foldl_cons,List.foldl_nil]
  all_goals simp (disch := decide) [Atom.real_read,Atom.nat_read,primitiveRealRead,primitiveNatRead]
  all_goals simp only [h.zeroR,h.size,h.vertices,h.edges,h.accuracy,h.unit,hH,hQ,hA,hK,
    Rat.cast_one,Rat.cast_ofNat,add_zero,kappa,zpow_neg,zpow_ofNat,one_div,pow_two,logicalCount]
  all_goals try ring_nf
  all_goals try simp only [inv_inv]
  all_goals first | rfl | ring | omega | trivial
end DecrAlmostLinearSSSP.Decremental.CoreParameters
