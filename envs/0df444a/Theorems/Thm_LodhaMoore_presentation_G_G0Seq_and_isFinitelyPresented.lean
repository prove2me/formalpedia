-- title:
--   Theorem 3.3 — R presents G, R₀ presents G₀, and both are finitely presented
-- statement:
--   The generators $S$ and relations $R$ present $G$, and the generators $S_0$ and relations $R_0$ present `G0Seq` (in each case the homomorphism from the presented group sending each generator to its function is injective with image the group); and $G$ and `G0Seq` are finitely presented.
--
--   **Formalization Note.** $G_0$ is taken here as the group `G0Seq` generated by $X \cup Y_0$, following the paper's identification just before the theorem (p. 6: "we will identify $a$, $b$, and $c$ with $x$, $x_1$, and $y_{10}$, respectively and suppress all mention of $\Phi$", and then "The group $G_0$ defined in the introduction is therefore generated by the (redundant) generating set $S_0 = X \cup Y_0$"); the milestone `exists_mulEquiv_G0_G0Seq_and_semiconj_Phi` carries the identification, and the goal states finite presentability for $\langle a, b, c\rangle$ itself.
-- source:
--   Lodha, Y. and Moore, J. T., A nonamenable finitely presented group of piecewise projective homeomorphisms, Groups Geom. Dyn. 10 (2016) 177–200, https://doi.org/10.4171/GGD/347 (arXiv:1308.4250v3, whose page numbers are used), p. 6, Theorem 3.3

import Mathlib
import Definitions.Def_LodhaMoore

namespace LodhaMoore

theorem presentation_G_G0Seq_and_isFinitelyPresented :
    (∃ phi : PresentedGroup R →* SeqGroup, (∀ g, phi (PresentedGroup.of g) = g.val) ∧
      Function.Injective phi ∧ phi.range = G) ∧
    (∃ phi : PresentedGroup R0S →* SeqGroup, (∀ g, phi (PresentedGroup.of g) = g.1.val) ∧
      Function.Injective phi ∧ phi.range = G0Seq) ∧
    Group.IsFinitelyPresented G ∧ Group.IsFinitelyPresented G0Seq := by
  sorry

end LodhaMoore
