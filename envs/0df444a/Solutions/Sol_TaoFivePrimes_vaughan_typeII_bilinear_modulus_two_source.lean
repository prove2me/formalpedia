  have hT0 : 0 ≤ Real.log (x / U) := Real.log_nonneg hXone
  have hQ0 : 0 ≤ x / Real.sqrt (q : ℝ) := by positivity
  have hDQ0 : 0 ≤ x / Real.sqrt (x / (q : ℝ)) := by positivity
