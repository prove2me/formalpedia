open ThreeSumApsp
namespace Light

theorem Ends.setTo' {lim : Limits} {P : Program} {d : ℕ} {l : List ℤ} {μ : ℕ → ℤ} {T : ℕ}
    {Q : State → Prop} {x : ℕ} {e : Expr} (z : ℤ) (h : Q ⟨frame (setLocal l x z), μ⟩)
    (he : e.Gives lim ⟨frame l, μ⟩ z) (hT : e.cost + 1 ≤ T) :
    Ends lim P d (.set x e) ⟨frame l, μ⟩ T Q := by
  refine Ends.set he.1 hT ?_
  rw [he.2]
  simp only [update_frame_setLocal]
  exact h

theorem Ends.setToThen' {lim : Limits} {P : Program} {d : ℕ} {l : List ℤ} {μ : ℕ → ℤ} {T : ℕ}
    {Q : State → Prop} {x : ℕ} {e : Expr} {s : Stmt} (z : ℤ)
    (h : Ends lim P d s ⟨frame (setLocal l x z), μ⟩ (T - (e.cost + 1)) Q)
    (he : e.Gives lim ⟨frame l, μ⟩ z) (hT : e.cost + 1 ≤ T) :
    Ends lim P d (.set x e ;; s) ⟨frame l, μ⟩ T Q :=
  Ends.next _ (Ends.setTo' z h he le_rfl) hT

theorem Solves.meets' {task : Task} {P₀ : Program} {p : ℕ} {T₀ : ℕ → ℕ → ℕ} {need : ℕ → ℕ → Need}
    (h : Solves task P₀ p T₀ need) (R : Program) {lim : Limits} {d : ℕ} (x : task.Inst) {μ : ℕ → ℤ}
    (fr : ℕ) (hpre : task.Pre x μ fr) (hok : (need (task.size x) (task.bound x)).Ok lim fr d) :
    Meets lim (P₀ ++ R) p d (task.args x ++ [(fr : ℤ)]) μ (T₀ (task.size x) (task.bound x))
      (task.Post x μ fr) := by
  obtain ⟨body, hp, hb⟩ := h
  exact ⟨body, getElem?_append_of_eq_some hp R, hb R lim d x μ fr hpre hok⟩

theorem SolvedIn.mono' {task : Task} {T T' : ℕ → ℝ → ℝ} (h : SolvedIn task T)
    (hT : ∀ (n : ℕ) (u : ℝ), 1 ≤ n → 1 ≤ u → T n u ≤ T' n u) : SolvedIn task T' := by
  obtain ⟨P, p, Tn, need, h1, h2, h3⟩ := h
  refine ⟨P, p, Tn, need, h1, h2, fun n U u hn hU hu => (h3 n U u hn hU hu).trans (hT n u hn ?_)⟩
  exact le_trans (by exact_mod_cast hU) hu

theorem IsHost.solvedIn' {lower upper : Task} {time : (ℕ → ℕ → ℕ) → ℕ → ℕ → ℕ}
    {need : (ℕ → ℕ → Need) → ℕ → ℕ → Need} (h : IsHost lower upper time need) {T T' : ℕ → ℝ → ℝ}
    (hs : SolvedIn lower T)
    (hb : ∀ Tn : ℕ → ℕ → ℕ, (∀ (n U : ℕ) (u : ℝ), 1 ≤ n → 1 ≤ U → (U : ℝ) ≤ u → (Tn n U : ℝ) ≤
    T n u) → ∀ (n U : ℕ) (u : ℝ), 1 ≤ n → 1 ≤ U → (U : ℝ) ≤ u → (time Tn n U : ℝ) ≤ T' n u) :
    SolvedIn upper T' := by
  obtain ⟨P, p, Tn, r, hr, hsol, hT⟩ := hs
  obtain ⟨R, p', hsol'⟩ := h.1 P p Tn r hsol
  exact ⟨P ++ R, p', time Tn, need r, h.2 r hr, hsol', hb Tn hT⟩

end Light

namespace Light.Sec3

open ThreeSumApsp.Spec

theorem flag_congr' {p q : Prop} (h : p ↔ q) : flag p = flag q := by
  rw [propext h]

theorem flag_eq_bit' (b : Bool) : flag (b = true) = bit b := by
  cases b
  · simp [bit, flag_of_not]
  · simp [bit, flag_of]

theorem hasZero_iff' (n : ℕ) (AB BC AC : List ℤ) :
    hasZero n AB BC AC = true ↔ (triOf n AB BC AC).HasZeroTriangle := by
  unfold hasZero TriangleInstance.HasZeroTriangle TriangleInstance.IsZeroTriangle TriangleInstance.S
  simp only [List.any_eq_true, List.mem_range, scanHit, decide_eq_true_eq]
  constructor
  · rintro ⟨a, ha, b, hb, c, hc, h⟩
    exact ⟨⟨a, ha⟩, ⟨b, hb⟩, ⟨c, hc⟩, by simpa [triOf] using h⟩
  · rintro ⟨a, b, c, h⟩
    exact ⟨a, a.2, b, b.2, c, c.2, by simpa [triOf] using h⟩

theorem aeHit_iff' {n : ℕ} {AB BC AC : List ℤ} {q : ℕ} (hq : q < n * n) :
    aeHit n AB BC AC q = true ↔
      ∃ c < n, AB.getD q 0 + BC.getD (q % n * n + c) 0 + AC.getD (q / n * n + c) 0 = 0 := by
  have hq' : q / n * n + q % n = q := Nat.div_add_mod' q n
  simp [aeHit, scanHit, hq']

theorem getElem_aeFlags' {n : ℕ} {AB BC AC : List ℤ} {q : ℕ}
    (hq : q < (aeFlags n AB BC AC).length) :
    (aeFlags n AB BC AC)[q] = bit (aeHit n AB BC AC q) := by
  have hq' : q < n * n := by simpa [aeFlags] using hq
  rw [← flag_eq_bit']
  simp only [aeFlags, List.getElem_map, List.getElem_range]
  exact flag_congr' (aeHit_iff' hq').symm

theorem length_aeFlags' (n : ℕ) (AB BC AC : List ℤ) : (aeFlags n AB BC AC).length = n * n := by
  simp [aeFlags]

end Light.Sec3
end

section
-- Exact Triangle from all-edges Exact Triangle, and the milestone
open ThreeSumApsp
namespace Light.Sec3
open ThreeSumApsp.Spec ThreeSumApsp.WordRam

/-! ## The text -/

namespace EaHost

abbrev Verts : ℕ := 0
abbrev Bound : ℕ := 1
abbrev AdrAB : ℕ := 2
abbrev AdrBC : ℕ := 3
abbrev AdrAC : ℕ := 4
abbrev Free : ℕ := 5
abbrev Cells : ℕ := 6
abbrev SolverFree : ℕ := 7
abbrev Res : ℕ := 8
abbrev Cnt : ℕ := 9
abbrev Hit : ℕ := 10

end EaHost

open EaHost

/-- One flag: if it is 1, then hit := 1. -/
def eaRound : Stmt := .ite (M (v Free +' v Cnt) =' k 1) (.set Hit (k 1)) .skip

/-- ea(n, U, ab, bc, ac, fr); the parameter is the procedure number of the solver of all-edges
Exact Triangle. -/
def eaBody (pAE : ℕ) : Stmt :=
  .set Cells (v Verts *' v Verts) ;;
  .set SolverFree (v Free +' v Cells) ;;
  .call pAE [v Verts, v Bound, v AdrAB, v AdrBC, v AdrAC, v Free, v SolverFree] Res ;;
  .set Hit (k 0) ;;
  Stmt.for Cnt (v Cells) eaRound ;;
  .set 0 (v Hit)

/-- The time of ea, if the solver of all-edges Exact Triangle takes T n U steps. -/
def eaTime (T : ℕ → ℕ → ℕ) (n U : ℕ) : ℕ := T n U + 30 * (n * n) + 100

/-- The need of ea, if the solver needs r n U. -/
def eaNeed (r : ℕ → ℕ → Need) (n U : ℕ) : Need where
  word := n * n + 2 + (r n U).word
  cells := n * n + (r n U).cells
  depth := (r n U).depth + 1

/-! ## The flags -/

/-- Some place below `j` has its flag. -/
def eaAny (n : ℕ) (AB BC AC : List ℤ) (j : ℕ) : Bool := (List.range j).any (aeHit n AB BC AC)

theorem eaAny_succ (n : ℕ) (AB BC AC : List ℤ) (j : ℕ) :
    eaAny n AB BC AC (j + 1) = (eaAny n AB BC AC j || aeHit n AB BC AC j) := by
  simp [eaAny, List.range_succ, List.any_append]

/-- All places together: there is a zero triangle. -/
theorem eaAny_all (n : ℕ) (AB BC AC : List ℤ) :
    eaAny n AB BC AC (n * n) = hasZero n AB BC AC := by
  rw [Bool.eq_iff_iff]
  simp only [eaAny, hasZero, List.any_eq_true, List.mem_range, aeHit]
  constructor
  · rintro ⟨q, hq, h⟩
    have hn : 0 < n := Nat.pos_of_ne_zero (by rintro rfl; simp at hq)
    exact ⟨q / n, Nat.div_lt_of_lt_mul hq, q % n, Nat.mod_lt _ hn, h⟩
  · rintro ⟨a, ha, b, hb, h⟩
    refine ⟨a * n + b, by nlinarith, ?_⟩
    have hdiv : (a * n + b) / n = a := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hb, Nat.zero_add]
    have hmod : (a * n + b) % n = b := by
      rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hb]
    rwa [hdiv, hmod]

/-! ## The question to the solver -/

/-- The instance of all-edges Exact Triangle: the flags go to the free pointer. -/
def eaQ (x : TriInst) (fr : ℕ) : AEInst := { x with out := fr }

theorem eaQ_pre {x : TriInst} {μ : ℕ → ℤ} {fr : ℕ} (hpre : x.Pre μ fr) :
    (eaQ x fr).Pre μ (fr + x.n * x.n) where
  toPre :=
    { hpre with
      belowAB := by have := hpre.belowAB; simp only [eaQ]; omega
      belowBC := by have := hpre.belowBC; simp only [eaQ]; omega
      belowAC := by have := hpre.belowAC; simp only [eaQ]; omega }
  belowOut := by simp [eaQ]
  apartAB := Or.inl (by have := hpre.belowAB; simp only [eaQ]; omega)
  apartBC := Or.inl (by have := hpre.belowBC; simp only [eaQ]; omega)
  apartAC := Or.inl (by have := hpre.belowAC; simp only [eaQ]; omega)

section

variable {P₀ R' : Program} {p : ℕ} {T : ℕ → ℕ → ℕ} {r : ℕ → ℕ → Need} {lim : Limits} {d : ℕ}

/-- The loop over the flags. -/
theorem eaLoop_spec {x : TriInst} {fr : ℕ} {μ₁ : ℕ → ℤ} {l : List ℤ}
    (hflags : Seg μ₁ fr (aeFlags x.n x.AB x.BC x.AC))
    (hl : l = [(x.n : ℤ), x.U, x.ab, x.bc, x.ac, fr, (x.n * x.n : ℕ), (fr + x.n * x.n : ℕ)])
    (res : ℤ) (hsp : fr + x.n * x.n ≤ lim.space) (hsw : (lim.space : ℤ) ≤ lim.word) :
    Ends lim (P₀ ++ R') d (Stmt.for Cnt (v Cells) eaRound)
      ⟨frame (l ++ [res, 0, 0]), μ₁⟩ (x.n * x.n * 20 + 10) fun σ' =>
        ∃ c, σ' = ⟨frame (l ++ [res, c, bit (eaAny x.n x.AB x.BC x.AC (x.n * x.n))]), μ₁⟩ := by
  subst hl
  have hlen := length_aeFlags' x.n x.AB x.BC x.AC
  refine Ends.for (fun j σ => σ = ⟨frame ([(x.n : ℤ), x.U, x.ab, x.bc, x.ac, fr,
    (x.n * x.n : ℕ), (fr + x.n * x.n : ℕ)] ++ [res, (j : ℤ), bit (eaAny x.n x.AB x.BC x.AC j)]),
      μ₁⟩) (x.n * x.n) 12 ?start ?round ?done ?bound (hn := by omega)
    (hT := by first | omega | (simp; omega) | simp)
  case start =>
    simp [update_frame_setLocal, eaAny, bit]
  case bound =>
    rintro j _ - - rfl
    simp
  case round =>
    rintro j _ hj - rfl
    have hm : μ₁ (fr + j) = bit (aeHit x.n x.AB x.BC x.AC j) := by
      rw [hflags j (by omega), getElem_aeFlags']
    unfold eaRound
    refine Ends.iteLast (fun hc => ?_) (fun hc => ?_) (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega))) (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
    · refine Ends.setTo' 1 ⟨by simp, ?_⟩ (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega))) (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
      have hh : aeHit x.n x.AB x.BC x.AC j = true := by
        by_contra hne
        simp [Cond.Holds, hm, bit, hne] at hc
      simp [update_frame_setLocal, eaAny_succ, hh, bit]
    · refine Ends.skip ⟨by simp, ?_⟩
      have hh : aeHit x.n x.AB x.BC x.AC j = false := by
        by_contra hne
        simp [Cond.Holds, hm, bit, hne] at hc
      simp [update_frame_setLocal, eaAny_succ, hh]
  case done =>
    rintro _ - rfl
    exact ⟨_, rfl⟩

/-- **ea is correct**, in every program that begins with the solver's program. -/
theorem ea_spec (hsol : Solves aeTask P₀ p T r) (x : TriInst) (μ : ℕ → ℤ) (fr : ℕ)
    (hpre : x.Pre μ fr) (hok : (eaNeed r x.n x.U).Ok lim fr d) :
    Ends lim (P₀ ++ R') d (eaBody p) ⟨frame [x.n, x.U, x.ab, x.bc, x.ac, fr], μ⟩
      (eaTime T x.n x.U) fun σ' => etTask.Post x μ fr (σ'.loc 0) σ'.mem := by
  have hw := hok.word
  have hc := hok.cells
  have hs := hok.space
  have hd := hok.depth
  simp only [eaNeed] at hw hc hd
  have hn1 := hpre.n_pos
  have hqn : (eaQ x fr).n = x.n := rfl
  have hqo : (eaQ x fr).out = fr := rfl
  have hTq : T (aeTask.size (eaQ x fr)) (aeTask.bound (eaQ x fr)) = T x.n x.U := rfl
  unfold eaBody eaTime
  -- cells := n n
  refine Ends.setToThen' (x.n * x.n : ℕ) ?_ (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega))) (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
  -- solverFree := fr + cells
  refine Ends.setToThen' (fr + x.n * x.n : ℕ) ?_ (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega))) (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
  -- res := ae(n, U, ab, bc, ac, fr, fr + n n)
  refine Ends.callToThen (Solves.meets' hsol R' (eaQ x fr) (fr + x.n * x.n) (eaQ_pre hpre)
    { word := by simp only [aeTask, eaQ]; omega
      cells := by simp only [aeTask, eaQ]; omega
      space := hs
      depth := by simp only [aeTask, eaQ]; omega }) ?_ (by simp [aeTask, eaQ]) (by omega)
    (by simp only [hTq]; simp; omega)
  rintro res μ₁ ⟨hflags, hk⟩
  -- hit := 0
  refine Ends.setToThen' 0 ?_ (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega))) (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
  -- the loop
  refine Ends.next _ ((eaLoop_spec (P₀ := P₀) (R' := R') (d := d) (x := x) hflags rfl res
    (by omega) hs).mono le_rfl ?_) (by simp only [hTq]; simp; omega)
  rintro _ ⟨c, rfl⟩
  -- return hit
  refine Ends.setTo' (bit (eaAny x.n x.AB x.BC x.AC (x.n * x.n))) ⟨?_, ?_⟩ (by ((try have := Light.Std.space_le (by assumption)); (try have := Light.Std.const_le (by assumption)); (simp [Light.Limits.Addr, abs_le, -abs_mul] <;> omega)))
    (by (first | (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]; first | omega | (ring_nf; omega)) | omega | (simp <;> first | omega | (ring_nf; omega))))
  · simp only [frame_setLocal]
    simp [eaAny_all, ← flag_eq_bit', hasZero_iff']
  · intro b hb
    rw [hqo, hqn] at hk
    exact hk b ⟨by omega, Or.inl hb⟩

end

/-- The need of ea is polynomially bounded if the need of the solver is. -/
theorem polyNeed_eaNeed {r : ℕ → ℕ → Need} (h : PolyNeed r) : PolyNeed (eaNeed r) := by
  obtain ⟨s, k, hle⟩ := h
  refine ⟨s + 2, k + 2, fun n U => ?_⟩
  obtain ⟨hw, hc, hd⟩ := hle n U
  simp only [Light.polyBound, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    mul_one] at hw hc hd ⊢
  set A := (n + 1) * (U + 1) with hA
  have hA1 : 1 ≤ A := Nat.one_le_iff_ne_zero.2 (by positivity)
  have hnA : n ≤ A := by rw [hA]; nlinarith
  have hAk : A ^ k ≤ A ^ (k + 2) := Nat.pow_le_pow_right hA1 (by omega)
  have hA2 : A * A ≤ A ^ (k + 2) := by
    rw [← pow_two]; exact Nat.pow_le_pow_right hA1 (by omega)
  have hnn : n * n ≤ A ^ (k + 2) := le_trans (Nat.mul_le_mul hnA hnA) hA2
  have h1 : 1 ≤ A ^ (k + 2) := Nat.one_le_pow _ _ hA1
  have hs1 : 1 ≤ 2 ^ s := Nat.one_le_two_pow
  have hsk : 2 ^ s * A ^ k ≤ 2 ^ s * A ^ (k + 2) := Nat.mul_le_mul_left _ hAk
  have hsA : A ^ (k + 2) ≤ 2 ^ s * A ^ (k + 2) := Nat.le_mul_of_pos_left _ (by omega)
  have h4 : 2 ^ (s + 2) * A ^ (k + 2) = 4 * (2 ^ s * A ^ (k + 2)) := by ring
  simp only [eaNeed]
  refine ⟨?_, ?_, ?_⟩ <;> omega

/-- **Exact Triangle from all-edges Exact Triangle.** -/
theorem isHost_ea : IsHost aeTask etTask eaTime eaNeed := by
  refine ⟨fun P p T r hsol => ⟨[eaBody p], P.length, eaBody p, by simp,
    fun R lim d x μ fr hpre hok => ?_⟩, fun r => polyNeed_eaNeed⟩
  rw [List.append_assoc]
  exact ea_spec hsol x μ fr hpre hok

/-- A time for all-edges Exact Triangle that is at least `n²` gives a time for Exact Triangle. -/
theorem et_solvedIn_of_ae {T : ℕ → ℝ → ℝ} (hT : SolvedIn aeTask T)
    (hsq : ∀ (n : ℕ) (u : ℝ), 1 ≤ n → (n : ℝ) ^ 2 ≤ T n u) :
    SolvedIn etTask fun n u => 131 * T n u := by
  refine IsHost.solvedIn' isHost_ea hT fun Tn hTn n U u hn hU hu => ?_
  have h1 := hTn n U u hn hU hu
  have h2 := hsq n u hn
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hsq' : (n : ℝ) * n = (n : ℝ) ^ 2 := by ring
  have h1' : (1 : ℝ) ≤ (n : ℝ) ^ 2 := one_le_pow₀ hn1
  simp only [eaTime]
  push_cast
  rw [hsq']
  linarith

/-- **The uniform bound for Exact Triangle from the one for all-edges Exact Triangle.** -/
theorem exactTriangleUniform_of_ae {δ : ℝ} {e : ℕ} (hδ : δ ≤ 1)
    (hu : Claim.ExactTriangleUniform aeModel δ e) :
    Claim.ExactTriangleUniform lightModel δ e := by
  obtain ⟨K, hK, hex⟩ := hu
  have hgood := goodTime_uniformTime e hK hδ
  have hsq : ∀ (n : ℕ) (u : ℝ), 1 ≤ n → (n : ℝ) ^ 2 ≤ uniformTime K δ e n u := fun n u hn =>
    (le_mul_of_one_le_right (by positivity) (one_le_one_add_logU u)).trans (hgood.1 n u hn)
  refine ⟨131 * K, by linarith, ?_⟩
  have h := et_solvedIn_of_ae hex hsq
  have hfun : (fun n u => 131 * uniformTime K δ e n u) = uniformTime (131 * K) δ e := by
    funext n u
    simp only [uniformTime]
    ring
  rw [hfun] at h
  exact h


/-- The uniform bound for Exact Triangle with saving `143/68400`. -/
theorem claim_etUniform_mid : Claim.ExactTriangleUniform lightModel (143 / 68400) 2 :=
  exactTriangleUniform_of_ae (by norm_num) (claim_aeUniform_mid claim_lopDetectP)

/-- A log factor is absorbed by a power: `(log n + 1)² n^{3-δ} ≤ (1/(δ-δ') + 1) (log n + 1) n^{3-δ'}`. -/
theorem uniformTime_two_le_one {K δ δ' : ℝ} (hK : 0 ≤ K) (hδ : δ' < δ) {n : ℕ} (hn : 1 ≤ n)
    (u : ℝ) : uniformTime K δ 2 n u ≤ uniformTime (K * (1 / (δ - δ') + 1)) δ' 1 n u := by
  have hε : 0 < δ - δ' := by linarith
  have hn0 : (0 : ℝ) < n := Nat.cast_pos.2 hn
  have hx : 0 ≤ Real.log n := Real.log_natCast_nonneg n
  set x := Real.log (n : ℝ) with hxdef
  -- `x + 1 ≤ (1/ε + 1) n^ε`
  have hexp : (n : ℝ) ^ (δ - δ') = Real.exp ((δ - δ') * x) := by
    rw [Real.rpow_def_of_pos hn0, mul_comm]
  have hge1 : 1 ≤ Real.exp ((δ - δ') * x) := Real.one_le_exp (by positivity)
  have hlin : (δ - δ') * x + 1 ≤ Real.exp ((δ - δ') * x) := by
    have := Real.add_one_le_exp ((δ - δ') * x)
    linarith
  have habs : x + 1 ≤ (1 / (δ - δ') + 1) * (n : ℝ) ^ (δ - δ') := by
    rw [hexp]
    have hxle : x ≤ Real.exp ((δ - δ') * x) / (δ - δ') := by
      rw [le_div_iff₀ hε]
      nlinarith
    have : x ≤ 1 / (δ - δ') * Real.exp ((δ - δ') * x) := by
      rw [one_div_mul_eq_div]; exact hxle
    nlinarith
  have hpow : (n : ℝ) ^ (3 - δ) * (n : ℝ) ^ (δ - δ') = (n : ℝ) ^ (3 - δ') := by
    rw [← Real.rpow_add hn0]; ring_nf
  have hw : 0 ≤ (1 + logU u) ^ 2 := by positivity
  have hp : 0 ≤ (n : ℝ) ^ (3 - δ) := by positivity
  simp only [uniformTime]
  have hx1 : 0 ≤ x + 1 := by linarith
  calc K * ((n : ℝ) ^ (3 - δ) * (x + 1) ^ 2 * (1 + logU u) ^ 2)
      = K * ((n : ℝ) ^ (3 - δ) * (x + 1) * (1 + logU u) ^ 2) * (x + 1) := by ring
    _ ≤ K * ((n : ℝ) ^ (3 - δ) * (x + 1) * (1 + logU u) ^ 2) *
        ((1 / (δ - δ') + 1) * (n : ℝ) ^ (δ - δ')) :=
        mul_le_mul_of_nonneg_left habs (by positivity)
    _ = K * (1 / (δ - δ') + 1) * (((n : ℝ) ^ (3 - δ) * (n : ℝ) ^ (δ - δ')) * (x + 1) ^ 1 *
        (1 + logU u) ^ 2) := by ring
    _ = K * (1 / (δ - δ') + 1) * ((n : ℝ) ^ (3 - δ') * (x + 1) ^ 1 * (1 + logU u) ^ 2) := by
        rw [hpow]

/-- **The uniform bound for Exact Triangle with saving `9261/5000000` and one log factor.** -/
theorem exactTriangleUniform_9261_5000000 :
    Claim.ExactTriangleUniform lightModel (9261 / 5000000) 1 := by
  obtain ⟨K, hK, h⟩ := claim_etUniform_mid
  refine ⟨K * (1 / (143 / 68400 - 9261 / 5000000) + 1), ?_, ?_⟩
  · have : (1 : ℝ) ≤ 1 / (143 / 68400 - 9261 / 5000000) + 1 := by norm_num
    nlinarith
  · exact SolvedIn.mono' h fun n u hn _ =>
      uniformTime_two_le_one (by linarith) (by norm_num) hn u


end Light.Sec3
end

section
