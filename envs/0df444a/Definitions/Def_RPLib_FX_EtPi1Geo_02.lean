section Piece_EtPi1Geo_DescM


/-!
# S4-EtPi1Geo, G3b (DescM): descent of unramified extensions along a constant field extension

`F = Frac A'` of characteristic `p`, `FK ⊇ F` generated by constants, `FK` acting on `F̄ = AlgebraicClosure F`.
**`mem_maxUnram_of_unrIn_const`**: every finite Galois `L/FK` inside `F̄`, unramified over `A'`, lies in
`maxUnram A' F`.
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh GalCover Lefschetz

noncomputable section

theorem isIntegral_of_algebraMap_comp {R S T : Type} [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
    [Algebra S T] [Algebra R T] (h : ∀ r, algebraMap S T (algebraMap R S r) = algebraMap R T r) {x : T}
    (hx : IsIntegral R x) : IsIntegral S x := by
  have : IsScalarTower R S T := IsScalarTower.of_algebraMap_eq fun r => (h r).symm
  exact hx.tower_top

section Descent

variable (p : ℕ) [hp : Fact p.Prime] (A' F FK : Type) [CommRing A'] [IsDomain A'] [Field F] [Algebra A' F]
  [IsFractionRing A' F] [CharP F p] [Field FK] [Algebra F FK] [Algebra A' FK] [IsScalarTower A' F FK]
  [Algebra FK (AlgebraicClosure F)] [IsScalarTower F FK (AlgebraicClosure F)]

instance isScalarTower_A'_FK : IsScalarTower A' FK (AlgebraicClosure F) :=
  IsScalarTower.of_algebraMap_eq fun a => by
    rw [IsScalarTower.algebraMap_apply A' F FK a, ← IsScalarTower.algebraMap_apply F FK (AlgebraicClosure F),
      IsScalarTower.algebraMap_apply A' F (AlgebraicClosure F) a]

set_option maxHeartbeats 1000000 in
/-- **Descent**: a finite Galois extension of `FK` unramified over `A'` lies in `maxUnram A' F`. -/
theorem mem_maxUnram_of_unrIn_const (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x})
    (L : IntermediateField FK (AlgebraicClosure F)) (hL : UnrIn A' FK (AlgebraicClosure F) L)
    {z : AlgebraicClosure F} (hz : z ∈ L) : z ∈ maxUnram A' F := by
  classical
  have hcF : CharP FK p := charP_of_injective_algebraMap (algebraMap F FK).injective p
  have hcW : CharP (AlgebraicClosure F) p := charP_of_injective_algebraMap (algebraMap F _).injective p
  obtain ⟨hfd, hgal, hunr⟩ := hL
  obtain ⟨α, rfl⟩ := exists_eq_adjoin_simple L
  have hαi : IsIntegral FK α :=
    (isIntegral_iff (S := FK⟮α⟯) (x := AdjoinSimple.gen FK α)).1 (Algebra.IsIntegral.isIntegral _)
  -- roots of the minimal polynomial lie in `FK⟮α⟯`
  have hroots : ∀ β, β ∈ (minpoly FK α).aroots (AlgebraicClosure F) → β ∈ FK⟮α⟯ := fun β hβ => by
    let τ0 := (algHomAdjoinIntegralEquiv FK hαi).symm ⟨β, hβ⟩
    have h1 : τ0 (AdjoinSimple.gen FK α) = β := algHomAdjoinIntegralEquiv_symm_apply_gen FK hαi _
    have h2 : τ0.fieldRange = FK⟮α⟯ := AlgHom.fieldRange_of_normal τ0
    have h3 : β ∈ τ0.fieldRange := AlgHom.mem_fieldRange.2 ⟨_, h1⟩
    rwa [h2] at h3
  have hrep : ∀ y, y ∈ FK⟮α⟯ → ∃ h : FK[X], aeval α h = y := fun y hy => exists_aeval_eq hαi hy
  choose! hpol hhpol using hrep
  set R0 := ((minpoly FK α).aroots (AlgebraicClosure F)).toFinset with hR0
  set T : Finset FK := (minpoly FK α).coeffs ∪ (hpol z).coeffs ∪ R0.biUnion (fun β => (hpol β).coeffs) with hT
  obtain ⟨ζ, hζ, hTζ⟩ := exists_const_of_finset p hgen T
  set E : IntermediateField F (AlgebraicClosure F) := F⟮algebraMap FK (AlgebraicClosure F) ζ⟯ with hE
  obtain ⟨n, hn, hpow⟩ := hζ.map (algebraMap FK (AlgebraicClosure F))
  have hEc : ∀ c ∈ T, algebraMap FK (AlgebraicClosure F) c ∈ E := fun c hc => algebraMap_mem_adjoin (hTζ c hc)
  have hEmax : E ≤ maxUnram A' F := adjoin_simple_le_iff.2
    (Kummer.mem_maxUnram_of_isConst A' (K := F) (p := p) one_pos (by rw [pow_one]; exact ⟨n, hn, hpow⟩))
  have hEfd : FiniteDimensional F E := adjoin.finiteDimensional (isIntegral_of_pow_eq_self p hn hpow)
  have hEFK : ∀ e ∈ E, ∃ c : FK, algebraMap FK (AlgebraicClosure F) c = e := fun e he => by
    have hle : E ≤ (⊥ : IntermediateField FK (AlgebraicClosure F)).restrictScalars F :=
      adjoin_simple_le_iff.2 (mem_bot.2 ⟨ζ, rfl⟩)
    exact mem_bot.1 (hle he)
  have hEL : E ≤ (FK⟮α⟯).restrictScalars F := fun e he => by
    obtain ⟨c, rfl⟩ := hEFK e he
    exact (FK⟮α⟯).algebraMap_mem c
  -- the minimal polynomial over `E`
  obtain ⟨μ', hμ'⟩ := exists_map_eq E (minpoly FK α) fun c hc => hEc c (by simp [hT, hc])
  have haev : ∀ (h : FK[X]) (h' : Polynomial E), h'.map (algebraMap E (AlgebraicClosure F)) =
      h.map (algebraMap FK (AlgebraicClosure F)) → ∀ y : AlgebraicClosure F, aeval y h' = aeval y h :=
      fun h h' hh y => by
    rw [aeval_def, eval₂_eq_eval_map, hh, ← eval₂_eq_eval_map, ← aeval_def]
  have hμ'α : aeval α μ' = 0 := by rw [haev _ μ' hμ' α, minpoly.aeval]
  have hμ'0 : μ' ≠ 0 := fun h => by
    have h1 := hμ'
    rw [h, Polynomial.map_zero, eq_comm, Polynomial.map_eq_zero] at h1
    exact minpoly.ne_zero hαi h1
  have hαE : IsIntegral E α := (show IsAlgebraic E α from ⟨μ', hμ'0, hμ'α⟩).isIntegral
  have hmemE : ∀ y, y ∈ FK⟮α⟯ → (∀ c ∈ (hpol y).coeffs, c ∈ T) → y ∈ E⟮α⟯ := fun y hy hc => by
    rw [← hhpol y hy]
    exact aeval_mem_of_coeffs (E⟮α⟯) (mem_adjoin_simple_self E α) _ fun c hc' =>
      (E⟮α⟯).algebraMap_mem ⟨_, hEc c (hc c hc')⟩
  have hzE : z ∈ E⟮α⟯ := hmemE z hz fun c hc => by simp [hT, hc]
  have hrootE : ∀ β ∈ R0, β ∈ E⟮α⟯ := fun β hβ =>
    hmemE β (hroots β (Multiset.mem_toFinset.1 hβ)) fun c hc => by
      simp only [hT, Finset.mem_union, Finset.mem_biUnion]
      exact Or.inr ⟨β, hβ, hc⟩
  -- `E⟮α⟯ / E` is Galois
  have hsepμ : (minpoly FK α).Separable := by
    rw [← minpoly_gen]; exact IsGalois.separable FK _
  have hsep : μ'.Separable := by
    rw [← separable_map (algebraMap E (AlgebraicClosure F)), hμ', separable_map]; exact hsepμ
  have hroot' : μ'.rootSet (AlgebraicClosure F) ⊆ E⟮α⟯ := fun β hβ => by
    obtain ⟨-, hβ0⟩ := (mem_rootSet.1 hβ)
    rw [haev _ μ' hμ' β] at hβ0
    exact hrootE β (Multiset.mem_toFinset.2 (mem_aroots.2 ⟨minpoly.ne_zero hαi, hβ0⟩))
  have hadj : adjoin E (μ'.rootSet (AlgebraicClosure F)) = E⟮α⟯ :=
    le_antisymm (adjoin_le_iff.2 hroot') (adjoin_simple_le_iff.2 (subset_adjoin _ _ (mem_rootSet.2 ⟨hμ'0, hμ'α⟩)))
  have hspl : (μ'.map (algebraMap E (AlgebraicClosure F))).Splits := IsAlgClosed.splits _
  have := adjoin_rootSet_isSplittingField hspl
  have hg0 : IsGalois E (adjoin E (μ'.rootSet (AlgebraicClosure F))) := IsGalois.of_separable_splitting_field hsep
  have hg : IsGalois E (E⟮α⟯) := hadj ▸ hg0
  refine le_maxUnram_of_unrIn A' F E hEmax (E⟮α⟯) ⟨adjoin.finiteDimensional hαE, hg, ?_⟩ z hzE
  -- unramified: an inertia element `σ` extends to an inertial `τ ∈ Gal(FK⟮α⟯/FK)`
  have hL'L : ∀ y ∈ E⟮α⟯, y ∈ FK⟮α⟯ := by
    have h1 : E⟮α⟯ ≤ extendScalars hEL :=
      adjoin_simple_le_iff.2 ((mem_extendScalars hEL).2 (mem_adjoin_simple_self FK α))
    exact fun y hy => (mem_extendScalars hEL).1 (h1 hy)
  intro Q' hQ'
  rw [eq_bot_iff]
  intro σ hσ
  rw [Subgroup.mem_bot]
  let B := integralClosure A' (FK⟮α⟯)
  let B' := integralClosure A' (E⟮α⟯)
  let ι' : B' →+* B :=
    { toFun := fun b => ⟨⟨((b : E⟮α⟯) : AlgebraicClosure F), hL'L _ (b : E⟮α⟯).2⟩,
        (isIntegral_coe_iff (FK⟮α⟯) _).2 ((isIntegral_coe_iff (E⟮α⟯) _).1 b.2)⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  have hι'inj : Function.Injective ι' := fun x y h =>
    Subtype.ext (Subtype.ext (congrArg (fun b : B => ((b : FK⟮α⟯) : AlgebraicClosure F)) h))
  letI : Algebra B' B := ι'.toAlgebra
  haveI : Algebra.IsIntegral B' B :=
    ⟨fun x => isIntegral_of_algebraMap_comp (R := A') (S := B') (T := B) (fun _ => rfl) (integralClosure.isIntegral x)⟩
  obtain ⟨Q, -, hQ, hQc⟩ := Ideal.exists_ideal_over_prime_of_isIntegral Q' (⊥ : Ideal B) (by
    rw [Ideal.comap_bot_of_injective (algebraMap B' B) hι'inj]; exact bot_le)
  -- `β = σ α` and the extension `τ`
  set g' := AdjoinSimple.gen E α
  set β : AlgebraicClosure F := ((σ g' : E⟮α⟯) : AlgebraicClosure F) with hβdef
  have hβ : aeval β (minpoly FK α) = 0 := by
    have h0 : aeval g' μ' = 0 := by
      apply Subtype.val_injective
      rw [ZeroMemClass.coe_zero]
      show (E⟮α⟯).val (aeval g' μ') = 0
      rw [← aeval_algHom_apply]
      exact hμ'α
    have h1 : aeval (σ g') μ' = 0 := by
      rw [show σ g' = σ.toAlgHom g' from rfl, aeval_algHom_apply, h0, map_zero]
    have h2 : aeval β μ' = 0 := by
      rw [hβdef, show ((σ g' : E⟮α⟯) : AlgebraicClosure F) = (E⟮α⟯).val (σ g') from rfl, aeval_algHom_apply, h1,
        map_zero]
    rwa [haev _ μ' hμ' β] at h2
  have hβm : β ∈ (minpoly FK α).aroots (AlgebraicClosure F) := mem_aroots.2 ⟨minpoly.ne_zero hαi, hβ⟩
  let τ0 : FK⟮α⟯ →ₐ[FK] AlgebraicClosure F := (algHomAdjoinIntegralEquiv FK hαi).symm ⟨β, hβm⟩
  have hτ0g : τ0 (AdjoinSimple.gen FK α) = β := algHomAdjoinIntegralEquiv_symm_apply_gen FK hαi _
  let τ : FK⟮α⟯ ≃ₐ[FK] FK⟮α⟯ := τ0.restrictNormal' (FK⟮α⟯)
  have hτ : ∀ y, ((τ y : FK⟮α⟯) : AlgebraicClosure F) = τ0 y := fun y =>
    AlgHom.restrictNormal_commutes τ0 (FK⟮α⟯) y
  -- `τ0` and `σ` agree on `E⟮α⟯`
  let incl : E⟮α⟯ →+* FK⟮α⟯ := ((E⟮α⟯).val : E⟮α⟯ →+* AlgebraicClosure F).codRestrict (FK⟮α⟯)
    fun y => hL'L _ y.2
  have hEfix : ∀ e : E, τ0 (incl (algebraMap E (E⟮α⟯) e)) = algebraMap E (AlgebraicClosure F) e := fun e => by
    obtain ⟨c, hc⟩ := hEFK e e.2
    have h1 : incl (algebraMap E (E⟮α⟯) e) = algebraMap FK (FK⟮α⟯) c := Subtype.ext hc.symm
    rw [h1, AlgHom.commutes]
    exact hc
  let φ2 : E⟮α⟯ →ₐ[E] AlgebraicClosure F :=
    { (τ0 : FK⟮α⟯ →+* AlgebraicClosure F).comp incl with commutes' := hEfix }
  have hφ : (E⟮α⟯).val.comp (σ : E⟮α⟯ →ₐ[E] E⟮α⟯) = φ2 := by
    refine (adjoin.powerBasis hαE).algHom_ext ?_
    rw [adjoin.powerBasis_gen]
    show ((σ g' : E⟮α⟯) : AlgebraicClosure F) = τ0 (incl g')
    rw [show incl g' = AdjoinSimple.gen FK α from Subtype.ext rfl, hτ0g]
  have hagree : ∀ y : E⟮α⟯, τ0 (incl y) = ((σ y : E⟮α⟯) : AlgebraicClosure F) := fun y =>
    (DFunLike.congr_fun hφ y).symm
  -- `τ` is inertial at `Q`
  have hτQ : τ ∈ Q.inertia (FK⟮α⟯ ≃ₐ[FK] FK⟮α⟯) := by
    refine AddSubgroup.mem_inertia.2 fun x => ?_
    have hyL : ((x : FK⟮α⟯) : AlgebraicClosure F) ∈ FK⟮α⟯ := (x : FK⟮α⟯).2
    set y := ((x : FK⟮α⟯) : AlgebraicClosure F) with hydef
    have hy := hhpol y hyL
    obtain ⟨ζx, hζx, hTx⟩ := exists_const_of_finset p hgen (hpol y).coeffs
    obtain ⟨m, hm, hpowx⟩ := hζx.map (algebraMap FK (AlgebraicClosure F))
    have hyM : y ∈ adjoin (E⟮α⟯) {algebraMap FK (AlgebraicClosure F) ζx} := by
      set M := adjoin (E⟮α⟯) {algebraMap FK (AlgebraicClosure F) ζx}
      have hFM : ∀ f : F, algebraMap F (AlgebraicClosure F) f ∈ M := fun f =>
        M.algebraMap_mem (⟨algebraMap F (AlgebraicClosure F) f, (E⟮α⟯).algebraMap_mem (algebraMap F E f)⟩ : E⟮α⟯)
      have hζM : algebraMap FK (AlgebraicClosure F) ζx ∈ M := mem_adjoin_simple_self _ _
      have hζi : IsIntegral F ζx := isIntegral_of_pow_eq_self p (R := F) hm
        ((algebraMap FK (AlgebraicClosure F)).injective (by rw [map_pow]; exact hpowx))
      rw [← hy]
      refine aeval_mem_of_coeffs M ((adjoin (E⟮α⟯) _).algebraMap_mem g') _ fun c hc => ?_
      obtain ⟨r, hr⟩ := exists_aeval_eq hζi (hTx c hc)
      rw [← hr, ← IsScalarTower.toAlgHom_apply F FK (AlgebraicClosure F), ← aeval_algHom_apply,
        IsScalarTower.toAlgHom_apply]
      exact aeval_mem_of_coeffs M hζM r fun f _ => hFM f
    haveI : FiniteDimensional E (E⟮α⟯) := adjoin.finiteDimensional hαE
    haveI : FiniteDimensional F (E⟮α⟯) := Module.Finite.trans E (E⟮α⟯)
    haveI : IsScalarTower A' F (E⟮α⟯) := IsScalarTower.of_algebraMap_eq fun a =>
      Subtype.ext (IsScalarTower.algebraMap_apply A' F (AlgebraicClosure F) a)
    haveI : IsIntegrallyClosed B' := integralClosure.isIntegrallyClosedOfFiniteExtension F
    haveI : IsFractionRing B' (E⟮α⟯) := integralClosure.isFractionRing_of_finite_extension F _
    haveI : CharP (E⟮α⟯) p := charP_of_injective_algebraMap (algebraMap F (E⟮α⟯)).injective p
    have hyi : IsIntegral B' y := isIntegral_of_algebraMap_comp (R := A') (S := B') (T := AlgebraicClosure F)
      (fun a => (IsScalarTower.algebraMap_apply A' (E⟮α⟯) (AlgebraicClosure F) a).symm)
      ((isIntegral_coe_iff (FK⟮α⟯) _).1 x.2)
    have hyB' := mem_adjoin_of_pow_eq_self p (L' := E⟮α⟯) (R := B') hm hpowx hyM hyi
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hyB'
    obtain ⟨f, hf⟩ := (AlgHom.mem_range _).1 hyB'
    let ζB : B := ⟨⟨algebraMap FK (AlgebraicClosure F) ζx, (FK⟮α⟯).algebraMap_mem ζx⟩,
      (isIntegral_coe_iff (FK⟮α⟯) _).2 (isIntegral_of_pow_eq_self p hm hpowx)⟩
    let cB : B →+* AlgebraicClosure F := ((FK⟮α⟯).val : FK⟮α⟯ →+* AlgebraicClosure F).comp
      (B.val : B →+* FK⟮α⟯)
    have hx : x = (f.map ι').eval ζB := by
      apply Subtype.ext; apply Subtype.ext
      show y = cB ((f.map ι').eval ζB)
      rw [eval_map, hom_eval₂, ← hf, aeval_def]
      rfl
    rw [hx]
    refine sub_mem_of_eval_map ι' (MulSemiringAction.toRingHom _ B τ) (MulSemiringAction.toRingHom _ B' σ)
      (fun b => ?_) Q (fun b => ?_) f ζB ?_
    · apply Subtype.ext; apply Subtype.ext
      show ((τ (incl (b : E⟮α⟯)) : FK⟮α⟯) : AlgebraicClosure F) = ((σ (b : E⟮α⟯) : E⟮α⟯) : AlgebraicClosure F)
      rw [hτ, hagree]
    · have h1 : σ • b - b ∈ Q' := AddSubgroup.mem_inertia.1 hσ b
      rw [← hQc] at h1
      exact h1
    · apply Subtype.ext; apply Subtype.ext
      show ((τ (algebraMap FK (FK⟮α⟯) ζx) : FK⟮α⟯) : AlgebraicClosure F) = algebraMap FK (AlgebraicClosure F) ζx
      rw [hτ, AlgHom.commutes]
  have hτ1 : τ = 1 := by
    rw [hunr Q hQ] at hτQ
    exact Subgroup.mem_bot.1 hτQ
  have hβα : β = α := by
    rw [← hτ0g, ← hτ (AdjoinSimple.gen FK α), hτ1]
    rfl
  have hσg : σ g' = g' := Subtype.ext hβα
  apply AlgEquiv.coe_toAlgHom_injective
  refine (adjoin.powerBasis hαE).algHom_ext ?_
  rw [adjoin.powerBasis_gen]
  exact hσg

end Descent

