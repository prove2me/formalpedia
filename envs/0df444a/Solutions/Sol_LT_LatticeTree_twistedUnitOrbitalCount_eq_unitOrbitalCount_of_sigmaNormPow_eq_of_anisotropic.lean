section Gates

variable {R : Type*} [CommRing R] {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]

example {ϖ : R} {c d : R} (hcd : ¬ (ϖ ∣ c ∧ ϖ ∣ d)) :
    stdLattice R K ≠ interLattice R K ϖ c d :=
  (interLattice_lt_stdLattice hcd).ne'

example {ϖ : R} (hϖ : ϖ ≠ 0) {c d : R} (hcd : ¬ (ϖ ∣ c ∧ ϖ ∣ d)) :
    latticeMap (scalarGL (unitOfNeZero (K := K) hϖ)) (stdLattice R K) ≠
      interLattice R K ϖ c d :=
  (latticeMap_scalarGL_lt_interLattice hϖ hcd).ne

end Gates
