theorem sp_cnt_sol_aux {dA : Fin HS} (hA : DAok dA) (s : IState HS) (f : Fin HS → List ℤ)
    (x1 x2 x3 x4 x5 : ℤ) (r : List ℤ) (hd : f dA = x1 :: x2 :: x3 :: x4 :: x5 :: r)
    (hu : f cU = []) (h1 : f cA1 = []) (h2 : f cA2 = []) (h3 : f cA3 = []) (hn : f cN = [])
    (B : ℕ) (b1 : zsz x1 ≤ B) (b2 : zsz x2 ≤ B) (b3 : zsz x3 ≤ B) (b4 : zsz x4 ≤ B)
    (b5 : zsz x5 ≤ B) (bm1 : zsz (x5 * x3) ≤ B) (bm2 : zsz (x2 * (x5 * x3)) ≤ B)
    (bm : zsz (2 * (x2 * (x5 * x3))) ≤ B) (hB2 : 2 ≤ B) :
    Sp (cntRS dA) (encK s f) (encK s (update f cN [2 * (x2 * (x5 * x3))])) (cCnt B) := by
  have hdl : dA.val < 56 := hA.lt
  have E0 : f = CF dA f [] [] [] [] [] (x1 :: x2 :: x3 :: x4 :: x5 :: r) := by
    funext j; simp only [CF]; split_ifs <;> simp_all
  rw [E0]
  -- the pushes / pops
  have s1 := sp_pushR (s := s) (CF dA f [] [] [] [] [] (x1 :: x2 :: x3 :: x4 :: x5 :: r)) (i := cU)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b1
  rw [CF_u _ hA, CFu_u _ hA] at s1
  have s2 := sp_pop (s := s) (CF dA f [x1] [] [] [] [] (x1 :: x2 :: x3 :: x4 :: x5 :: r)) (i := dA)
    (B := B) hdl (CF_d f hA) b1
  rw [CFu_d _ hA] at s2
  have s3 := sp_pushR (s := s) (CF dA f [x1] [] [] [] [] (x2 :: x3 :: x4 :: x5 :: r)) (i := cA1)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b2
  rw [CF_a1 _ hA, CFu_a1 _ hA] at s3
  have s4 := sp_pushR (s := s) (CF dA f [x1] [x2] [] [] [] (x2 :: x3 :: x4 :: x5 :: r)) (i := cU)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b2
  rw [CF_u _ hA, CFu_u _ hA] at s4
  have s5 := sp_pop (s := s) (CF dA f [x2, x1] [x2] [] [] [] (x2 :: x3 :: x4 :: x5 :: r)) (i := dA)
    (B := B) hdl (CF_d f hA) b2
  rw [CFu_d _ hA] at s5
  have s6 := sp_pushR (s := s) (CF dA f [x2, x1] [x2] [] [] [] (x3 :: x4 :: x5 :: r)) (i := cA2)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b3
  rw [CF_a2 _ hA, CFu_a2 _ hA] at s6
  have s7 := sp_pushR (s := s) (CF dA f [x2, x1] [x2] [x3] [] [] (x3 :: x4 :: x5 :: r)) (i := cU)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b3
  rw [CF_u _ hA, CFu_u _ hA] at s7
  have s8 := sp_pop (s := s) (CF dA f [x3, x2, x1] [x2] [x3] [] [] (x3 :: x4 :: x5 :: r)) (i := dA)
    (B := B) hdl (CF_d f hA) b3
  rw [CFu_d _ hA] at s8
  have s9 := sp_pushR (s := s) (CF dA f [x3, x2, x1] [x2] [x3] [] [] (x4 :: x5 :: r)) (i := cU)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b4
  rw [CF_u _ hA, CFu_u _ hA] at s9
  have s10 := sp_pop (s := s) (CF dA f [x4, x3, x2, x1] [x2] [x3] [] [] (x4 :: x5 :: r)) (i := dA)
    (B := B) hdl (CF_d f hA) b4
  rw [CFu_d _ hA] at s10
  have s11 := sp_pushR (s := s) (CF dA f [x4, x3, x2, x1] [x2] [x3] [] [] (x5 :: r)) (i := cA3)
    (j := dA) (B := B) (by decide) hdl (CF_d f hA) b5
  rw [CF_a3 _ hA, CFu_a3 _ hA] at s11
  -- the product
  set G := CF dA f [x4, x3, x2, x1] [x2] [x3] [x5] [] (x5 :: r) with hG
  have g1 : G cA1 = [x2] := CF_a1 f hA
  have g2 : G cA2 = [x3] := CF_a2 f hA
  have g3 : G cA3 = [x5] := CF_a3 f hA
  have s12 := Sp.pushQ s G (i := cN)
    (e := .mul (.lit 2) (.mul (.reg cA1) (.mul (.reg cA3) (.reg cA2)))) (B := B) (by decide)
    (by decide)
    ⟨trivial, ok_reg g1, ok_reg g3, ok_reg g2⟩
    (by
      simp only [Ex.Bnd, Ex.eval, top_encK g1, top_encK g2, top_encK g3]
      exact ⟨by rw [show (2 : ℤ) = 2 ^ 1 by norm_num, zsz_two_pow]; omega,
        ⟨b2, ⟨b5, b3, bm1⟩, bm2⟩, bm⟩)
  simp only [Ex.eval, top_encK g1, top_encK g2, top_encK g3, Ex.size, hG, CF_cn _ hA, CFu_cn _ hA] at s12
  set m := 2 * (x2 * (x5 * x3)) with hm
  have s13 := sp_pop (s := s) (CF dA f [x4, x3, x2, x1] [x2] [x3] [x5] [m] (x5 :: r)) (i := cA1)
    (B := B) (by decide) (CF_a1 f hA) b2
  rw [CFu_a1 _ hA] at s13
  have s14 := sp_pop (s := s) (CF dA f [x4, x3, x2, x1] [] [x3] [x5] [m] (x5 :: r)) (i := cA2)
    (B := B) (by decide) (CF_a2 f hA) b3
  rw [CFu_a2 _ hA] at s14
  have s15 := sp_pop (s := s) (CF dA f [x4, x3, x2, x1] [] [] [x5] [m] (x5 :: r)) (i := cA3)
    (B := B) (by decide) (CF_a3 f hA) b5
  rw [CFu_a3 _ hA] at s15
  have r1 := sp_pushR (s := s) (CF dA f [x4, x3, x2, x1] [] [] [] [m] (x5 :: r)) (i := dA)
    (j := cU) (B := B) hdl (by decide) (CF_u f hA) b4
  rw [CF_d _ hA, CFu_d _ hA] at r1
  have r2 := sp_pop (s := s) (CF dA f [x4, x3, x2, x1] [] [] [] [m] (x4 :: x5 :: r)) (i := cU)
    (B := B) (by decide) (CF_u f hA) b4
  rw [CFu_u _ hA] at r2
  have r3 := sp_pushR (s := s) (CF dA f [x3, x2, x1] [] [] [] [m] (x4 :: x5 :: r)) (i := dA)
    (j := cU) (B := B) hdl (by decide) (CF_u f hA) b3
  rw [CF_d _ hA, CFu_d _ hA] at r3
  have r4 := sp_pop (s := s) (CF dA f [x3, x2, x1] [] [] [] [m] (x3 :: x4 :: x5 :: r)) (i := cU)
    (B := B) (by decide) (CF_u f hA) b3
  rw [CFu_u _ hA] at r4
  have r5 := sp_pushR (s := s) (CF dA f [x2, x1] [] [] [] [m] (x3 :: x4 :: x5 :: r)) (i := dA)
    (j := cU) (B := B) hdl (by decide) (CF_u f hA) b2
  rw [CF_d _ hA, CFu_d _ hA] at r5
  have r6 := sp_pop (s := s) (CF dA f [x2, x1] [] [] [] [m] (x2 :: x3 :: x4 :: x5 :: r)) (i := cU)
    (B := B) (by decide) (CF_u f hA) b2
  rw [CFu_u _ hA] at r6
  have r7 := sp_pushR (s := s) (CF dA f [x1] [] [] [] [m] (x2 :: x3 :: x4 :: x5 :: r)) (i := dA)
    (j := cU) (B := B) hdl (by decide) (CF_u f hA) b1
  rw [CF_d _ hA, CFu_d _ hA] at r7
  have r8 := sp_pop (s := s) (CF dA f [x1] [] [] [] [m] (x1 :: x2 :: x3 :: x4 :: x5 :: r)) (i := cU)
    (B := B) (by decide) (CF_u f hA) b1
  rw [CFu_u _ hA] at r8
  rw [CFu_cn _ hA]
  refine (s1.seq (s2.seq (s3.seq (s4.seq (s5.seq (s6.seq (s7.seq (s8.seq (s9.seq (s10.seq (s11.seq
    (s12.seq (s13.seq (s14.seq (s15.seq (r1.seq (r2.seq (r3.seq (r4.seq (r5.seq (r6.seq (r7.seq
    r8)))))))))))))))))))))).mono ?_
  unfold cCnt
  nlinarith

