/-- From `Y ≤ c · T p (β+1)` to the per-axis budget. -/
theorem toU (P : Prm) {n D : ℕ} (hD : dP6 P n = D + 1) {Y c : ℕ}
    (hY : Y ≤ c * (TP6 P n * pP6 P n * (Nat.log 2 (bP6 n) + 1)))
