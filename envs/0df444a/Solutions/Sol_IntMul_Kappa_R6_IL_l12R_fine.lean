open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

lemma instrCost_lin {Wr : Type*} (child : ℕ × ℕ × ℕ → ℝ → ℝ)
    (hc : ∀ ρ v, child ρ v = v * child ρ 1) (V : ℝ) (i : Instr Wr R m) :
    instrCost child (V / W) i = V * instrCost child (1 / W) i := by
  cases i with
  | gate g S => simp only [instrCost]; ring
  | edge w e =>
    simp only [instrCost]
    rw [List.map_congr_left (fun ρ _ => hc ρ (V / W)), List.sum_map_mul_left,
      List.map_congr_left (l := e.runs) (fun ρ _ => hc ρ (1 / W)), List.sum_map_mul_left]
    ring

lemma sum_map_mul {α : Type*} (l : List α) (f : α → ℝ) (V : ℝ) :
    (l.map fun a => V * f a).sum = V * (l.map f).sum := List.sum_map_mul_left _ _ _

/-- The cost is linear in the volume. -/
theorem costH_lin (C : QHNet R W T m) : ∀ e V, costH C e V = V * costH C e 1 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro V
  rw [costH, costH]
  split_ifs with he
  · have hc : ∀ (ρ : ℕ × ℕ × ℕ) (v : ℝ),
        (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) v else 0) =
          v * (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) 1 else 0) := by
      intro ρ v
      split_ifs with h
      · exact ih _ h v
      · ring
    rw [List.map_congr_left (fun i _ => instrCost_lin _ hc V i), sum_map_mul]
    ring
  · ring

lemma width_lt {m e w : ℕ} (he : m ≤ e) (hw : w < m) : w * (e / m) < e := by
  have h1 : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  have h2 : e / m * m ≤ e := Nat.div_mul_le_self e m
  nlinarith

lemma cH_lt (C : QHNet R W T m) {e : ℕ} (he : ¬ m ≤ e) : cH C e = e := by
  rw [cH, costH, if_neg he]; ring

lemma K0_nonneg (C : QHNet R W T m) : 0 ≤ K0 C := by
  unfold K0; positivity

lemma cH_nonneg (C : QHNet R W T m) (hruns : C.RunsOK) : ∀ e, 0 ≤ cH C e := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  by_cases he : m ≤ e
  · rw [cH_rec C hruns he]
    have : 0 ≤ (C.widths.map fun w => cH C (w * (e / m))).sum := by
      apply List.sum_nonneg
      intro x hx
      obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hx
      obtain ⟨e', he', ρ, hρ, rfl⟩ := QHNet.mem_widths hw
      exact ih _ (width_lt he (hruns e' he' ρ hρ).2.1)
    have := K0_nonneg C
    positivity
  · rw [cH_lt C he]; positivity

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6IL12
/-!
# Round six, item language: fine Lemma 12 for any bit network, from the item-language Prop. 11

The frozen Lemma 12 wrapper `KFE.l12F q m W` (binary embedding, `min (W·Kp) e` high-digit swaps,
row padding to a multiple of `W ^ Kp`, the Prop. 11 oracle on the base-`m` pieces of the remaining
digits, extraction) is generic in its procedure table: it only needs `CallSpec` for the oracle
calls at the levels `m ^ j`. Here it is used with

* the table `tab` of an **item-language Prop. 11** for the round-six network `C`
  (`ILProp11 tab C q T₀ c₁ K₁ K₂`: at every level `k`, with the KIL5 calling convention `DescIn`,
  `tab 0` computes `progH C q (m ^ k)` at cost
  `⌈K₁ costH C (m^k) V + K₂ (m^k + 1)^c₁ (Bb + 2)²⌉`), and
* the row-padding base `W' = W ^ cW`, where `depH m (m ^ k) ≤ cW k` (`depH_pow_le`), so that the
  padded rows are divisible by `W ^ depH` as `progH_correct` requires.

Results.
* `l12R_fine`: `ILProp11 → ` fine Lemma 12 with cost `K ((V+1) u^τ + (u+1)^(c₁+1) (Bb+2)²)`.
* **`l12Canon_of_IL`**: `ILProp11 → L12Canon tab (l12F q m W') τ` (canonical item size).
* `l12Canon_of_net'`: from `ilProp11_of_net` (R6ILProp).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

