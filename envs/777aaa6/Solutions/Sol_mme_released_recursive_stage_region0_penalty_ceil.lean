    rw [mul_assoc, hcast]
    have h2 : (0 : ℝ) ≤ ((n3 0 r : ℕ) : ℝ) := by positivity
    calc ((n3 0 r : ℕ) : ℝ) * (Real.log 2 * RecursiveThinSplit.entropyPenalty _)
        ≤ ((n3 0 r : ℕ) : ℝ) * (((L3Agg.pgn r : ℕ) : ℝ)/10^30) :=
          mul_le_mul_of_nonneg_left (L3Agg.hpen r) h2
      _ = ((n3 0 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by push_cast; ring
  refine le_trans (Finset.sum_le_sum (fun r _ ↦ hterm r)) (le_of_eq ?_)
  rw [← Finset.sum_div, ← Nat.cast_sum, L3Agg.psum]
