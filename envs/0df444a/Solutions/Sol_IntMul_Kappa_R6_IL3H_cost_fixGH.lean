/-!
# Round six, item language (I3): cost bounds of the steps of a node

`KFWCost2` with the literal `W_c`, `A0`, `mC` replaced by variables: with
`P = (W n) · Yu r Z H` (`n` records per role, `W` roles, at most `A` atoms per gate, `m` slots):

* `cost_gateH`, `cost_permH`, `cost_phaseH`, `cost_fixGH`, `cost_rowH`: every local step costs
  `≤ MlocH W A m · P` (plus the row body);
* `cost_childH`: the child wrapper adds `≤ MlocH W A m · P` to the (constant) child cost, for
  `gsSz c + 6 ≤ A`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- **A `±1` role diagonal** (at most `W` phase steps). -/
theorem cost_fixGH_sol_aux {W A m Bn t S0 r Z H F x : ℕ} (hW : 1 ≤ W) (hS : 1 ≤ S0) (hBn : 1 ≤ Bn)
    (hZ : 3 ≤ Z) (U : Finset (Fin W))
    (hx : x + ((negSteps (m := m) U.toList).map (fun _ => 0 + (0 + 2) * W)).sum ≤ H) :
    costL (phCostFH W m Z Bn t S0 r F) (fun _ => 0 + (0 + 2) * W) (negSteps (m := m) U.toList)
      x ≤ MlocH W A m * ((W * nN Bn t S0) * Yu r Z H) := by
  set P := (W * nN Bn t S0) * Yu r Z H with hP
  have H1 := costL_win (phCostFH W m Z Bn t S0 r F) (fun _ => 0 + (0 + 2) * W)
    (fun _ => MphH W m * P)
    H (negSteps (m := m) U.toList) (fun a ha x hx => by
      simp only [negSteps, List.mem_map] at ha
      obtain ⟨w, -, rfl⟩ := ha
      simp only [phCostFH]
      refine cost_phaseH hW hS hBn _ ?_ _ ?_ (by omega)
      · have : (((2 + 0 * F) % 4 : ℕ) : ℤ) = 2 := by norm_num
        rw [this, zsz_two]; omega
      · rw [εTab_size, List.length_ofFn]; exact le_of_eq (by ring)) x hx
  refine H1.trans ?_
  have hlen : (negSteps (m := m) U.toList).length ≤ W := by
    simp only [negSteps, List.length_map, Finset.length_toList]
    exact (Finset.card_le_univ U).trans (by simp)
  simp only [List.map_const', List.sum_replicate, smul_eq_mul]
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hP1 : 1 ≤ P := by
    have h8 := yu_8 r Z H
    have h1 : 1 ≤ W * nN Bn t S0 := by
      have := Nat.mul_le_mul hW hn
      simpa using this
    have := Nat.mul_le_mul h1 (le_trans (by norm_num) h8 : 1 ≤ Yu r Z H)
    rw [hP]; simpa using this
  unfold MlocH MphH
  generalize (negSteps (m := m) U.toList).length = q at hlen ⊢
  have k1 : q * (10 ^ 12 * (12 * m + 30) * (W + 3) * P) ≤
      W * (10 ^ 12 * (12 * m + 30) * (W + 3) * P) := Nat.mul_le_mul_right _ hlen
  have k2 : W * (10 ^ 12 * (12 * m + 30) * (W + 3) * P) + 1 ≤
      10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 * P := by
    have a : W * (W + 3) + 1 ≤ (W + A + 10) ^ 2 := by
      have h := Nat.pow_le_pow_left (show W + 10 ≤ W + A + 10 by omega) 2
      nlinarith [h]
    have : W * (10 ^ 12 * (12 * m + 30) * (W + 3) * P) + 1 ≤
        10 ^ 12 * (12 * m + 30) * (W * (W + 3) + 1) * P := by
      have e : 10 ^ 12 * (12 * m + 30) * (W * (W + 3) + 1) * P =
          W * (10 ^ 12 * (12 * m + 30) * (W + 3) * P) + 10 ^ 12 * (12 * m + 30) * P := by ring
      have : 1 ≤ 10 ^ 12 * (12 * m + 30) * P := by
        have : 0 < 10 ^ 12 * (12 * m + 30) := by positivity
        have := Nat.mul_le_mul (this : 1 ≤ 10 ^ 12 * (12 * m + 30)) hP1
        simpa using this
      omega
    refine this.trans ?_
    have := Nat.mul_le_mul_left (10 ^ 12 * (12 * m + 30)) a
    have e : 10 ^ 13 * (12 * m + 30) * (W + A + 10) ^ 2 =
        10 * (10 ^ 12 * (12 * m + 30) * (W + A + 10) ^ 2) := by ring
    rw [e]
    have : 10 ^ 12 * (12 * m + 30) * (W * (W + 3) + 1) ≤
        10 * (10 ^ 12 * (12 * m + 30) * (W + A + 10) ^ 2) := by omega
    exact Nat.mul_le_mul_right _ this
  omega

end IntMul.Kappa.R6.IL3H

