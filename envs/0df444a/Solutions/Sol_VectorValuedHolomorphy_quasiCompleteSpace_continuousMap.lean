namespace Sol_VectorValuedHolomorphy_quasiCompleteSpace_continuousMap

open Set UniformSpace

open scoped ComplexOrder in
/-- The compact-open topology on continuous maps into a real or complex polynormable space
is generated by continuous seminorms. -/
theorem polynormableSpace_continuousMap (𝕜 X E : Type*) [RCLike 𝕜] [TopologicalSpace X]
    [AddCommGroup E] [Module 𝕜 E] [TopologicalSpace E] [IsTopologicalAddGroup E]
    [ContinuousSMul 𝕜 E] [PolynormableSpace 𝕜 E] : PolynormableSpace 𝕜 C(X, E) := by
  let : Module ℝ E := Module.restrictScalars ℝ 𝕜 E
  let : IsScalarTower ℝ 𝕜 E := IsScalarTower.restrictScalars ℝ 𝕜 E
  let : ContinuousSMul ℝ E := IsScalarTower.continuousSMul 𝕜
  let : LocallyConvexSpace ℝ E := (PolynormableSpace.withSeminorms 𝕜 E).toLocallyConvexSpace
  let : LocallyConvexSpace 𝕜 E := LocallyConvexSpace.ofBasisZero 𝕜 E id _
    (LocallyConvexSpace.convex_basis_zero ℝ E)
    (fun _ h ↦ convex_RCLike_iff_convex_real.mpr h.2)
  infer_instance

/-- A closed set of continuous maps is complete for compact convergence if the closure
of its image under evaluation at each point is complete. -/
theorem isComplete_continuousMap_of_isComplete_eval
    {X E : Type*} [TopologicalSpace X] [CompactlyCoherentSpace X] [UniformSpace E]
    {s : Set C(X, E)} (hs : IsClosed s)
    (heval : ∀ x : X, IsComplete (closure ((fun f : C(X, E) ↦ f x) '' s))) :
    IsComplete s := by
  let j : C(E, Completion E) := ⟨(↑), Completion.continuous_coe E⟩
  have hj : IsUniformInducing j := Completion.isUniformInducing_coe E
  let J : C(X, E) → C(X, Completion E) := j.comp
  have hJ : IsUniformInducing J := ContinuousMap.isUniformInducing_comp j hj
  apply hJ.isComplete_iff.mp
  apply IsClosed.isComplete
  rw [← closure_subset_iff_isClosed]
  intro f hf
  -- Point evaluations of a limit still lie in the image of the original target.
  have lifts (x : X) : ∃ y : E, j y = f x := by
    let A := closure ((fun g : C(X, E) ↦ g x) '' s)
    have hA : IsClosed (j '' A) := (hj.isComplete_iff.mpr (heval x)).isClosed
    have hx : f x ∈ j '' A := by
      apply closure_minimal (t := (fun g : C(X, Completion E) ↦ g x) ⁻¹' (j '' A))
        _ (hA.preimage (continuous_eval_const x)) hf
      rintro _ ⟨g, hg, rfl⟩
      exact ⟨g x, subset_closure ⟨g, hg, rfl⟩, rfl⟩
    obtain ⟨y, _, hy⟩ := hx
    exact ⟨y, hy⟩
  choose g hg using lifts
  let G : C(X, E) := ⟨g, hj.isInducing.continuous_iff.mpr (by
    convert f.continuous using 1
    exact funext hg)⟩
  have hG : J G = f := ContinuousMap.ext hg
  refine ⟨G, ?_, hG⟩
  rw [← hs.closure_eq, hJ.isInducing.closure_eq_preimage_closure_image]
  change J G ∈ closure (J '' s)
  rwa [hG]

end Sol_VectorValuedHolomorphy_quasiCompleteSpace_continuousMap

open Sol_VectorValuedHolomorphy_quasiCompleteSpace_continuousMap in
theorem solution (X : Type*) [TopologicalSpace X] [LocallyCompactSpace X]
    [T2Space X] (E : Type*) [AddCommGroup E] [Module ℂ E] [UniformSpace E] [IsUniformAddGroup E]
    [ContinuousSMul ℂ E] [PolynormableSpace ℂ E] [T2Space E] [QuasiCompleteSpace ℂ E] :
    PolynormableSpace ℂ C(X, E) ∧ QuasiCompleteSpace ℂ C(X, E) := by
  refine ⟨polynormableSpace_continuousMap ℂ X E, ⟨fun {s} hb hs ↦ ?_⟩⟩
  refine isComplete_continuousMap_of_isComplete_eval hs fun x ↦ ?_
  exact QuasiCompleteSpace.quasiComplete
    (hb.image (ContinuousMap.evalCLM ℂ x)).closure isClosed_closure
