            (∀ A ∈ W.oddOrderSummingSet (Point.some x₀ y₀ h₀) ((p - 1) / 2), r ≠ A.1) →
            W.veluDeficitCrossQuadBetaOnly
                (W.oddOrderSummingSet (Point.some x₀ y₀ h₀) ((p - 1) / 2)) r s
              * (∏ A ∈ W.oddOrderSummingSet (Point.some x₀ y₀ h₀) ((p - 1) / 2),
                    (r - A.1)) ^ 4
              = M.eval r

variable {F}

