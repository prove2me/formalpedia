-- Source module: Solutions.AModelShear
/-!
# Shears and interchanges in the array model (Lemma 10 / end of Prop. 11)

Active fields are indexed by `Fin (m + m)`: the `H` fields are `Fin.castAdd m i` (the first `m`),
the `D` fields are `Fin.natAdd m j` (the last `m`). With a `Layout` (strictly increasing
positions) every `H` field therefore precedes every `D` field.
-/

namespace AModel

open Matrix

section Blocks

variable {m Q : ℕ}

lemma blk_mul (P B C D P' B' C' D' : Matrix (Fin m) (Fin m) (ZMod Q)) :
    blk P B C D * blk P' B' C' D' =
      blk (P * P' + B * C') (P * B' + B * D') (C * P' + D * C') (C * B' + D * D') := by
  simp only [blk, reindex_apply]
  rw [submatrix_mul_equiv, fromBlocks_multiply]

theorem shearMat_zero : shearMat (0 : Matrix (Fin m) (Fin m) (ZMod Q)) = 1 := by
  simp [shearMat, blk, fromBlocks_one]

end Blocks

/-! ## Inverse steps -/

/-! ## Lower triangular transforms of one block -/

/-! ## The pivot gadget: `H_i ← H_i + D_j` with one interchange -/

/-! ## Lemma 10: the shear through Bruhat-type factors -/

/-! ## Interchange from a shear (end of Prop. 11) -/

section Interchange

variable {m Q : ℕ}

lemma swapMat_mul_self : (swapMat : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod Q)) * swapMat = 1 := by
  rw [swapMat, blk_mul]
  simpa [shearMat] using (shearMat_zero (m := m) (Q := Q))

