    (a value : OAI.EditApproximation.BinaryFraction) (query : OAI.EditApproximation.TargetInterval ny) (draw : OAI.EditApproximation.CountedCellGroupDraws M F Q) :
    List (Fin M × OAI.EditApproximation.TargetInterval ny) × ℕ :=
