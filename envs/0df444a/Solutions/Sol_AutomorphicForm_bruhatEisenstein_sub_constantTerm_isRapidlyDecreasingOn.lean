    ∃ C : ℝ, 0 ≤ C ∧ ∀ (w₀ : 𝔸) (t₁ t₂ αb : 𝔸ˣ) (q : Fˣ) (t : ℝ) (kpt : AdelicGL2 (𝓞 F) F), kpt ∈ K →
