-- title:
--   §3.2 — Accepted history, decreasing elimination stages and conditional probabilities
-- statement:
--   Fix a query root $v$ and the forced-root law. Let $W=R_G(v,r)\setminus(I_G(r)\cup\{v\})$ be the evaluated rejected nonroot vertices. Reveal every accepted vertex and its rank, including accepted vertices outside the query trace. For each distinct elimination time of a rejected nonroot vertex, set
--
--   $$D_t=\{x\notin I_G(r)\cup\{v\}:\tau(x)=t\}.$$
--
--   List the nonempty stages in decreasing time. Before stage $i$, the sigma-algebra $\mathcal G_i$ is generated by the accepted history and ranks in the preceding stages; the root rank is also known. For $x\in D_t$ at the current time, put
--
--   $$m_x=\max(\{t\}\cup\{\tau(u):u\in P_t\cap N_G(x)\}),\qquad \pi_x=\frac{m_x-t}{1-t}.$$
--
--   The maximum includes $t$ and is never empty. These objects describe exactly the revelation used in Lemma 3.5, without imposing any conditional law on the original ranks.
--
--   **Formalization Note** The accepted history is encoded as a labeled vector of pairs (rank, presence flag), which generates the same sigma-algebra as its increasing-rank list. Stages start at zero; stages past the last one are empty. The functions $m_x,\pi_x$ are set to zero outside the current random $D_t$. `stagePattern` is the indicator of any Boolean pattern of the whole masked family, and `patternMass` is the corresponding product of Bernoulli factors. Conditional expectations are taken under the actual forced-root measure.
-- source:
--   Peter Kiss, Yuichi Yoshida, The Local Probe Complexity of Maximal Independent Set, STOC 2027 submission #871 (October 2026), p. 13, PDF p. 15, §3.2, accepted history and D_t; Lemma 3.5 (PDF p.16); https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/871.pdf

import Definitions.Def_LocalProbeMIS871_Greedy_Elimination

open MeasureTheory
open scoped BigOperators Classical
noncomputable section
set_option autoImplicit false

namespace LocalProbeMIS871.Greedy

def W {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (r : Fin n → ℝ) : Finset (Fin n) :=
  R G v r \ (insert v (I G r))

def rejected {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (r : Fin n → ℝ) : Finset (Fin n) :=
  Finset.univ \ (insert v (I G r))

/-- Labeled accepted-rank vector, equivalent to the increasing-rank list h; no accepted vertex omitted. -/
def history {n : ℕ} (G : SimpleGraph (Fin n)) (r : Fin n → ℝ) : Fin n → ℝ × ℝ :=
  fun u => if u ∈ I G r then (r u, 1) else (0, 0)

/-- Distinct elimination times of all nonroot rejected vertices, in decreasing order. -/
def times {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (r : Fin n → ℝ) : List ℝ :=
  ((rejected G v r).image (tau G r)).sort (· ≥ ·)

def stageTime {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ) (r : Fin n → ℝ) : ℝ :=
  (times G v r)[i]?.getD 0

/-- Stage indices start at zero; padding gives the empty stage. -/
def stage {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ)
    (r : Fin n → ℝ) : Finset (Fin n) :=
  if i < (times G v r).length then
    (rejected G v r).filter (fun x => tau G r x = stageTime G v i r)
  else ∅

/-- Precisely the ranks known before stage i: root, accepted vertices and earlier stages. -/
def revealed {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ)
    (r : Fin n → ℝ) : Fin n → ℝ × ℝ :=
  fun x => if x = v ∨ (x ∈ rejected G v r ∧ tau G r x ∈ (times G v r).take i)
    then (r x, 1) else (0, 0)

/-- Generated observation sigma-algebra. The history also determines all elimination times. -/
def stageSigma {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ) : MeasurableSpace (Fin n → ℝ) :=
  MeasurableSpace.comap (fun r => (history G r, revealed G v i r)) inferInstance

/-- max({t} ∪ {τ(u) : u ∈ P_t ∩ N(x)}), totalized by a finite nonempty supremum. -/
def mAt {n : ℕ} (G : SimpleGraph (Fin n)) (v x : Fin n) (r : Fin n → ℝ) (t : ℝ) : ℝ :=
  (insert t (((P G v r t).filter (fun u => G.Adj x u)).image (tau G r))).max'
    (Finset.insert_nonempty _ _)

/-- Masking outside the current random D_t expresses a family on a fixed carrier. -/
def stageM {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ) (x : Fin n)
    (r : Fin n → ℝ) : ℝ :=
  if x ∈ stage G v i r then mAt G v x r (stageTime G v i r) else 0

def stagePi {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ) (x : Fin n)
    (r : Fin n → ℝ) : ℝ :=
  if x ∈ stage G v i r then
    (stageM G v i x r - stageTime G v i r) / (1 - stageTime G v i r)
  else 0

/-- All finite Boolean patterns determine the full conditional joint Bernoulli law. -/
def stagePattern {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ)
    (b : Fin n → Bool) (r : Fin n → ℝ) : ℝ :=
  if ∀ x, decide (x ∈ W G v r ∩ stage G v i r) = b x then 1 else 0

def patternMass {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) (i : ℕ)
    (b : Fin n → Bool) (r : Fin n → ℝ) : ℝ :=
  ∏ x, if b x then stagePi G v i x r else 1 - stagePi G v i x r

end LocalProbeMIS871.Greedy


