-- Source module: Solutions.KFV8Sim
/-!
# KFV §12: literal-to-register simulation of item-language code

`ISim π c c'`: `c'` is `c` with some literal pushes `.const j v` replaced by copies `.dup i j` of a
parameter stack `i` holding `v` (`π i = some v`). It is the `IStmt`-level analogue of
`KIL.RSim` and covers compiled register programs (`Ex.code` compiles `.lit v` to `.const` and
`.reg i` to `.dup`) as well as hand-written codes such as KFT's `carI`/`digI`.

**`ISim.runs`**: if `c` does not write any parameter stack and makes no calls (`NW π c`), every
run of `c` from a state with the parameters on top (`PV π s`) is matched by a run of `c'` with
the same final state and at most `2000 ×` the cost. This turns old codes whose *shape* does not
depend on `n` into uniform codes reading their sizes from stacks.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem ISim.refl (π : PMap) : ∀ c : IStmt HS Pp, ISim I iprog π c c
  | .skip => .skip
  | .op o => .op o
  | .call j => .call j
  | .seq a b => .seq (refl π a) (refl π b)
  | .ite _ _ a b => .ite (refl π a) (refl π b)
  | .loop _ _ a => .loop (refl π a)

theorem dup_cost_le (m : ℕ) : dupCost m + 17 ≤ 135 * (m + 2) := by
  simp only [dupCost, zipCost, moveCost]; omega

/-! ## Compiled register programs -/

theorem ISim.ecode {π : PMap} (hπ : PLow π) {e e' : Ex HS} (h : ESim π e e') :
    ISim I iprog π (e.code NLogN.zX : IStmt HS Pp) (e'.code NLogN.zX) := by
  induction h with
  | reg i => exact .op _
  | lit c => exact .op _
  | par hv =>
    rename_i i v
    refine .par hv ?_
    intro he
    have := hπ _ _ hv
    rw [he] at this
    simp [HS] at this
  | add _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | neg _ ih => exact .seq ih (.op _)
  | mul _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | shl _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | quo _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | rem _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | pow2 _ ih => exact .seq ih (ISim.refl π _)
  | sel _ _ _ ih1 ih2 ih3 =>
    exact .seq ih1 (.seq (.op _) (.ite (.seq (.op _) ih2) (.seq (.op _) ih3)))
  | ndiv _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))
  | nmod _ _ ih1 ih2 => exact .seq ih1 (.seq ih2 (ISim.refl π _))

/-- **Compiled register programs**: an `RSim` gives an `ISim` of the fine compilations. -/
theorem ISim.fcode {π : PMap} (hπ : PLow π) {p p' : RS} (h : RSim π p p') :
    ISim I iprog π (KFD.fcode p : IStmt HS Pp) (KFD.fcode p') := by
  induction h with
  | skip => exact .skip
  | asg i he => exact .seq (ISim.ecode hπ he) (ISim.refl π _)
  | push i he => exact .seq (ISim.ecode hπ he) (ISim.refl π _)
  | pop i => exact .op _
  | seq _ _ ih1 ih2 => exact .seq ih1 ih2
  | ite hc _ _ ih1 ih2 =>
    exact .seq (ISim.ecode hπ hc) (.seq (.op _) (.ite (.seq (.op _) ih1) (.seq (.op _) ih2)))
  | rep i hn _ ih =>
    exact .seq (.seq (ISim.ecode hπ hn) (.op _)) (.seq (ISim.refl π _)
      (.seq (.loop (.seq (.op _) ih)) (.op _)))

end NLogN.KFV

end


