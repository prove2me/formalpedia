-- Source module: Solutions.J6AIL13
/-!
# A lines, IL side 13: the fine-descriptor set-ups

For a fine descriptor `descFine w f a y` with `w = p + 2`, `f` a literal and `a`, `y` expressions in
the registers of `parAX X`:

* `fsR X ea ey fl Q`: enter the register file, `parAX X`, push `w, f, a, y` on four temporaries
  `Q 0 … Q 3` (outside `rg`, away from `dF`), leave the register file;
* `fsUp`: then copy `y, a, f, w` onto `dF` and drop the temporaries; `fsDn`: drop four from `dF`.

**`fsUp_runs`** / **`fsDn_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.FS

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function J6A.PA IntMul.Kappa.R6

theorem Q_val (dF : Fin HS) (i : Fin 4) : (Q dF i).val = qb dF + i.val := rfl

theorem Q_facts (dF : Fin HS) (i : Fin 4) :
    Q dF i ∉ rg ∧ (Q dF i).val < 56 ∧ Q dF i ≠ dF ∧ (Q dF i).val ≠ 0 ∧ (Q dF i).val ≠ 53 ∧
    (Q dF i).val ≠ 30 ∧ (Q dF i).val ≠ 31 ∧ Q dF i ≠ sTmp ∧ Q dF i ≠ cRdC ∧ Q dF i ≠ cL := by
  have hi := i.isLt
  have hv := Q_val dF i
  have nrg : ∀ j : Fin HS, (16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35) → j ∉ rg := by
    intro j hj hm
    have : ∀ j ∈ rg, ¬ ((16 ≤ j.val ∧ j.val ≤ 19) ∨ (32 ≤ j.val ∧ j.val ≤ 35)) := by decide
    exact this j hm hj
  have vne : ∀ (j : Fin HS) (n : ℕ), j.val = n → (qb dF + i.val ≠ n) → Q dF i ≠ j :=
    fun j n hj hn e => hn (by rw [← hv, e, hj])
  have e15 : (sTmp : Fin HS).val = 15 := rfl
  have e47 : (cRdC : Fin HS).val = 47 := rfl
  have e13 : (cL : Fin HS).val = 13 := rfl
  rcases qb_cases dF with h | h
  · refine ⟨nrg _ (Or.inr (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩
  · refine ⟨nrg _ (Or.inl (by omega)), by omega, vne dF dF.val rfl (by omega), by omega,
      by omega, by omega, by omega, vne _ 15 e15 (by omega), vne _ 47 e47 (by omega),
      vne _ 13 e13 (by omega)⟩

theorem Q_inj (dF : Fin HS) {i j : Fin 4} (h : Q dF i = Q dF j) : i = j := by
  rw [Fin.ext_iff, Q_val, Q_val] at h; exact Fin.ext (by omega)

section il
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem fsI_runs_sol_aux (s : IState HS) (F : Fin HS → List ℤ) (dF : Fin HS) (hQ : ∀ i, F (Q dF i) = [])
    (w f a y : ℤ) :
    IRuns I iprog (.seq (.op (.dup (Q dF 3) dF)) (.seq (.op (.dup (Q dF 2) dF))
      (.seq (.op (.dup (Q dF 1) dF)) (.seq (.op (.dup (Q dF 0) dF))
      (.seq (.op (.drop (Q dF 0))) (.seq (.op (.drop (Q dF 1))) (.seq (.op (.drop (Q dF 2)))
        (.op (.drop (Q dF 3))))))))))
      (encK s (fsG F dF w f a y)) (encK s (update F dF (w :: f :: a :: y :: F dF)))
      (cFsI w f a y) := by
  have qd : ∀ i, Q dF i ≠ dF := fun i => (Q_facts dF i).2.2.1
  have qn : ∀ i j : Fin 4, i ≠ j → Q dF i ≠ Q dF j := fun i j h e => h (Q_inj dF e)
  set G0 := fsG F dF w f a y with hG0
  have g3 : G0 (Q dF 3) = y :: [] := by simp [hG0, fsG]
  have g2 : G0 (Q dF 2) = a :: [] := by
    simp only [hG0, fsG]; rw [update_of_ne (qn 2 3 (by decide)), update_self]
  have g1 : G0 (Q dF 1) = f :: [] := by
    simp only [hG0, fsG]; rw [update_of_ne (qn 1 3 (by decide)), update_of_ne (qn 1 2 (by decide)),
      update_self]
  have g0 : G0 (Q dF 0) = w :: [] := by
    simp only [hG0, fsG]; rw [update_of_ne (qn 0 3 (by decide)), update_of_ne (qn 0 2 (by decide)),
      update_of_ne (qn 0 1 (by decide)), update_self]
  have gd : G0 dF = F dF := by
    simp only [hG0, fsG]; rw [update_of_ne (qd 3).symm, update_of_ne (qd 2).symm,
      update_of_ne (qd 1).symm, update_of_ne (qd 0).symm]
  have d1 := J6Seg.IRuns.dupK (I := I) (iprog := iprog) s (G := G0) (qd 3) g3
  have d2 := J6Seg.IRuns.dupK (I := I) (iprog := iprog) s (G := update G0 dF (y :: G0 dF)) (qd 2)
    (by rw [update_of_ne (qd 2), g2])
  simp only [update_self, update_idem] at d2
  have d3 := J6Seg.IRuns.dupK (I := I) (iprog := iprog) s (G := update G0 dF (a :: y :: G0 dF)) (qd 1)
    (by rw [update_of_ne (qd 1), g1])
  simp only [update_self, update_idem] at d3
  have d4 := J6Seg.IRuns.dupK (I := I) (iprog := iprog) s (G := update G0 dF (f :: a :: y :: G0 dF))
    (qd 0) (by rw [update_of_ne (qd 0), g0])
  simp only [update_self, update_idem] at d4
  set H0 := update G0 dF (w :: f :: a :: y :: G0 dF) with hH0
  have e0 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s (G := H0) (i := Q dF 0)
    (by rw [hH0, update_of_ne (qd 0), g0])
  have e1 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s (G := update H0 (Q dF 0) []) (i := Q dF 1)
    (by rw [update_of_ne (qn 1 0 (by decide)), hH0, update_of_ne (qd 1), g1])
  have e2 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s
    (G := update (update H0 (Q dF 0) []) (Q dF 1) []) (i := Q dF 2)
    (by rw [update_of_ne (qn 2 1 (by decide)), update_of_ne (qn 2 0 (by decide)), hH0,
      update_of_ne (qd 2), g2])
  have e3 := J6Seg.IRuns.dropK (I := I) (iprog := iprog) s
    (G := update (update (update H0 (Q dF 0) []) (Q dF 1) []) (Q dF 2) []) (i := Q dF 3)
    (by rw [update_of_ne (qn 3 2 (by decide)), update_of_ne (qn 3 1 (by decide)),
      update_of_ne (qn 3 0 (by decide)), hH0, update_of_ne (qd 3), g3])
  refine (d1.seq (d2.seq (d3.seq (d4.seq (e0.seq (e1.seq (e2.seq e3))))))).mono' ?_ ?_
  · congr 1
    funext j
    simp only [hH0, hG0, fsG, update_apply]
    by_cases h3 : j = Q dF 3
    · subst h3; simp [qd 3, hQ 3]
    by_cases h2 : j = Q dF 2
    · subst h2; simp [qd 2, hQ 2, qn 2 3 (by decide)]
    by_cases h1 : j = Q dF 1
    · subst h1; simp [qd 1, hQ 1, qn 1 3 (by decide), qn 1 2 (by decide)]
    by_cases h0 : j = Q dF 0
    · subst h0; simp [qd 0, hQ 0, qn 0 3 (by decide), qn 0 2 (by decide), qn 0 1 (by decide)]
    simp [h0, h1, h2, h3, (qd 0).symm, (qd 1).symm, (qd 2).symm, (qd 3).symm]
  · unfold cFsI; omega

end il

end J6A.FS

