        (((n - w : ℕ) : ℝ) - (j : ℝ)) *
        ((w : ℝ) - (j : ℝ) - (p : ℝ) + (q : ℝ)) *
        (((n - w : ℕ) : ℝ) - (j : ℝ) +
          (p : ℝ) - (q : ℝ)) *
        ((j : ℝ) - (p : ℝ) - (q : ℝ) + 1) *
        ((n : ℝ) - (p : ℝ) - (q : ℝ) - (j : ℝ) + 1) := by
  unfold MetricCodes.johnsonJ MetricCodes.johnsonM
    MetricCodes.johnsonDelta MetricCodes.johnsonSigma
    MetricCodes.johnsonJ1 MetricCodes.johnsonJ2
  rw [Nat.cast_sub hwn]
  ring
