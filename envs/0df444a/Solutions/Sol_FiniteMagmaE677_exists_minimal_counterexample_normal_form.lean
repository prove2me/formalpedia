import Definitions.Def_FiniteMagmaE677
import Mathlib

/-!
# Normal form of a finite counterexample

Let `op` be a finite `E677` magma that fails `E255` at `x`, and write
`q z = ((z ◇ z) ◇ z) ◇ z`.  Take the least `n` such that some `E677` operation on `Fin n`
fails `E255` at some point, and such an operation `opB` with a point `z`, `q z ≠ z`.

## Proof

* `n ≤ |α|`: `op` transports to an `E677` operation on `Fin |α|` that fails `E255`
  (`exists_fin_counterexample`).
* Every `E677` operation on `Fin m` with `m < n` satisfies `E255`, by the choice of `n`.
  So every finite `E677` magma with fewer than `n` elements satisfies `E255`
  (`e255_of_card_lt`).
* `opB` is generated by `z` (`generatedBy_of_minimal`): the submagma generated by `z` is an
  `E677` magma that fails `E255` at `z`, so it is not smaller than `Fin n`.  A set that
  contains `z` and is closed under `opB` contains every `opB`-term in `z`, so it is all of
  `Fin n`.
* A congruence `r` of `opB` that relates two distinct elements has a smaller quotient
  (`card_quotient_lt`).  The quotient is an `E677` magma (`e677_quotOp`), so it satisfies
  `E255`; at the class of `z` this says `r z (q z)`.

This is the usual minimal-counterexample argument of universal algebra.  The helpers are
those of the solution of Counterexample structure (b), with `exists_fin_counterexample`
added.  Ported from `lean/E677/MonolithReduction.lean` and `lean/E677/CriticalCore.lean` of a
private repo (Adam McKenna).
-/

universe u
open FiniteMagmaE677

namespace NormalFormHelpers

/-! ### Quotients by a compatible reflexive, symmetric and transitive relation -/

section Quot

variable {α : Type*} {r : α → α → Prop}

/-- The setoid of a reflexive, symmetric and transitive relation. -/
abbrev setoidOf (hr : Equivalence r) : Setoid α := ⟨r, hr⟩

/-- The operation induced on the quotient by a compatible reflexive, symmetric and transitive
relation. -/
def quotOp (op : α → α → α) (hr : Equivalence r)
    (hcompat : ∀ a a' b b' : α, r a a' → r b b' → r (op a b) (op a' b')) :
    Quotient (setoidOf hr) → Quotient (setoidOf hr) → Quotient (setoidOf hr) :=
  Quotient.map₂ op fun _ _ ha _ _ hb => hcompat _ _ _ _ ha hb

/-- `E677` passes to the quotient. -/
theorem e677_quotOp {op : α → α → α} (h : E677 op) (hr : Equivalence r)
    (hcompat : ∀ a a' b b' : α, r a a' → r b b' → r (op a b) (op a' b')) :
    E677 (quotOp op hr hcompat) := by
  refine Quotient.ind₂ fun a b => ?_
  exact congrArg (Quotient.mk (setoidOf hr)) (h a b)

/-- A relation identifying two distinct elements has a strictly smaller quotient. -/
theorem card_quotient_lt [Finite α] (hr : Equivalence r) {a b : α} (hab : a ≠ b)
    (hrab : r a b) : Nat.card (Quotient (setoidOf hr)) < Nat.card α := by
  classical
  have hnotinj : ¬ Function.Injective (Quotient.mk (setoidOf hr)) :=
    fun hinj => hab (hinj (Quotient.sound hrab))
  have : Fintype α := Fintype.ofFinite α
  have : Fintype (Quotient (setoidOf hr)) := Fintype.ofFinite _
  have hlt : Fintype.card (Quotient (setoidOf hr)) < Fintype.card α :=
    Fintype.card_lt_of_surjective_not_injective _ Quotient.mk_surjective hnotinj
  simpa only [Nat.card_eq_fintype_card] using hlt

end Quot

/-! ### Minimality and transport to `Fin n` -/

/-- Push an operation forward along a bijection of carriers. -/
def transportOp {β γ : Type*} (e : β ≃ γ) (op : β → β → β) : γ → γ → γ :=
  fun a b => e (op (e.symm a) (e.symm b))

/-- `E677` is invariant under transport of the carrier. -/
theorem e677_transportOp {β γ : Type*} (e : β ≃ γ) {op : β → β → β} (h : E677 op) :
    E677 (transportOp e op) := by
  intro i j
  have hij := congrArg e (h (e.symm i) (e.symm j))
  simpa [transportOp] using hij

/-- If every `E677` operation on `Fin n` with `n < N` satisfies `E255`, then every finite
`E677` magma with fewer than `N` elements satisfies `E255`. -/
theorem e255_of_card_lt {N : ℕ}
    (hmin : ∀ n : ℕ, n < N → ∀ op' : Fin n → Fin n → Fin n, E677 op' → E255 op')
    {β : Type*} [Finite β] (op : β → β → β) (h : E677 op) (hcard : Nat.card β < N) :
    E255 op := by
  intro x
  let e : β ≃ Fin (Nat.card β) := Finite.equivFin β
  have hx := hmin _ hcard (transportOp e op) (e677_transportOp e h) (e x)
  exact e.injective (by simpa [transportOp] using hx)

/-- A finite `E677` magma that fails `E255` at `x` gives an `E677` operation on
`Fin |β|` that fails `E255`. -/
theorem exists_fin_counterexample {β : Type*} [Finite β] {op : β → β → β} (h : E677 op)
    {x : β} (hx : op (op (op x x) x) x ≠ x) :
    ∃ op' : Fin (Nat.card β) → Fin (Nat.card β) → Fin (Nat.card β),
      E677 op' ∧ ∃ z : Fin (Nat.card β), op' (op' (op' z z) z) z ≠ z := by
  let e : β ≃ Fin (Nat.card β) := Finite.equivFin β
  refine ⟨transportOp e op, e677_transportOp e h, e x, fun hEq => hx (e.injective ?_)⟩
  simpa [transportOp] using hEq

/-- `GeneratedBy op z a` holds when `a` is an `op`-term in the single generator `z`. -/
inductive GeneratedBy {α : Type*} (op : α → α → α) (z : α) : α → Prop
  | base : GeneratedBy op z z
  | mul {a b : α} : GeneratedBy op z a → GeneratedBy op z b → GeneratedBy op z (op a b)

/-- The operation of the submagma generated by `z`. -/
def genOp {α : Type*} (op : α → α → α) (z : α) :
    {a : α // GeneratedBy op z a} → {a : α // GeneratedBy op z a} →
      {a : α // GeneratedBy op z a} :=
  fun a b => ⟨op a.1 b.1, GeneratedBy.mul a.2 b.2⟩

/-- A finite `E677` magma failing `E255` at `z`, all of whose smaller relatives satisfy
`E255`, is generated by `z`. -/
theorem generatedBy_of_minimal {α : Type*} [Finite α] {op : α → α → α} (h : E677 op)
    (hmin : ∀ n : ℕ, n < Nat.card α → ∀ op' : Fin n → Fin n → Fin n, E677 op' → E255 op')
    {z : α} (hz : op (op (op z z) z) z ≠ z) (w : α) : GeneratedBy op z w := by
  by_contra hw
  have hS : E677 (genOp op z) := fun a b => Subtype.ext (h a.1 b.1)
  have h255 := e255_of_card_lt hmin (genOp op z) hS (Finite.card_subtype_lt hw)
  exact hz (congrArg Subtype.val (h255 ⟨z, GeneratedBy.base⟩)).symm

end NormalFormHelpers

theorem solution
{α : Type u} [Finite α] (op : α → α → α) (h : FiniteMagmaE677.E677 op)
(x : α) (hx : op (op (op x x) x) x ≠ x) :
∃ (n : ℕ) (opB : Fin n → Fin n → Fin n) (z : Fin n),
  FiniteMagmaE677.E677 opB ∧ opB (opB (opB z z) z) z ≠ z ∧
  (∀ S : Fin n → Prop, S z → (∀ a b : Fin n, S a → S b → S (opB a b)) → ∀ a : Fin n, S a) ∧
  (∀ r : Fin n → Fin n → Prop, Equivalence r →
    (∀ a a' b b' : Fin n, r a a' → r b b' → r (opB a b) (opB a' b')) →
    ∀ a b : Fin n, a ≠ b → r a b → r z (opB (opB (opB z z) z) z)) ∧
  (∀ m : ℕ, m < Nat.card (Fin n) → ∀ op' : Fin m → Fin m → Fin m,
    FiniteMagmaE677.E677 op' → FiniteMagmaE677.E255 op') ∧
  Nat.card (Fin n) ≤ Nat.card α := by
  classical
  -- The least order of an `E677` operation on some `Fin n` that fails `E255`.
  have hex : ∃ n : ℕ, ∃ opB : Fin n → Fin n → Fin n,
      E677 opB ∧ ∃ z : Fin n, opB (opB (opB z z) z) z ≠ z :=
    ⟨Nat.card α, NormalFormHelpers.exists_fin_counterexample h hx⟩
  obtain ⟨opB, hB, z, hz⟩ := Nat.find_spec hex
  have hcard : Nat.card (Fin (Nat.find hex)) = Nat.find hex := by
    simp only [Nat.card_eq_fintype_card, Fintype.card_fin]
  -- Every `E677` operation on a smaller `Fin m` satisfies `E255`.
  have hmin : ∀ m : ℕ, m < Nat.card (Fin (Nat.find hex)) → ∀ op' : Fin m → Fin m → Fin m,
      E677 op' → E255 op' := by
    intro m hm op' h' w
    rw [hcard] at hm
    by_contra hw
    exact Nat.find_min hex hm ⟨op', h', w, fun hEq => hw hEq.symm⟩
  refine ⟨Nat.find hex, opB, z, hB, hz, ?_, ?_, hmin, ?_⟩
  · -- `Fin n` is generated by `z`.
    intro S hSz hSop a
    induction NormalFormHelpers.generatedBy_of_minimal hB hmin hz a with
    | base => exact hSz
    | mul _ _ iha ihb => exact hSop _ _ iha ihb
  · -- A congruence that relates two distinct elements relates `z` and `q z`.
    intro r hr hcompat a b hab hrab
    have hQ255 : E255 (NormalFormHelpers.quotOp opB hr hcompat) :=
      NormalFormHelpers.e255_of_card_lt hmin _ (NormalFormHelpers.e677_quotOp hB hr hcompat)
        (NormalFormHelpers.card_quotient_lt hr hab hrab)
    exact Quotient.exact (a := z) (b := opB (opB (opB z z) z) z)
      (hQ255 (Quotient.mk (NormalFormHelpers.setoidOf hr) z))
  · -- `n ≤ |α|`.
    rw [hcard]
    exact Nat.find_min' hex (NormalFormHelpers.exists_fin_counterexample h hx)

#print axioms solution
