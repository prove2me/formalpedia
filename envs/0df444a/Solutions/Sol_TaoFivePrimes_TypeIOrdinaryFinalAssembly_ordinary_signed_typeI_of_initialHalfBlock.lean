theorem typeI_vinogradov_scalar_absorption
    (q : ℕ) (hq : 1 ≤ q) :
    (2 / Real.pi) * (q : ℝ) * Real.log (4 * q) + 4 * q ≤
      (2 / Real.pi) * (q : ℝ) * (8 + Real.log q) := by
  have hqne : (q : ℝ) ≠ 0 := by exact_mod_cast (Nat.ne_of_gt (Nat.zero_lt_of_lt hq))
  have hlogmul : Real.log (4 * (q : ℝ)) = Real.log 4 + Real.log q := by
    rw [Real.log_mul (by norm_num : (4 : ℝ) ≠ 0) hqne]
  have hlog4 : Real.log 4 = 2 * Real.log 2 := Real.log_four_eq
  have hcore : Real.log 4 + 2 * Real.pi ≤ 8 := by
    rw [hlog4]
    nlinarith [Real.log_two_lt_d9, Real.pi_lt_d2]
  have hscale0 : 0 ≤ 2 * (q : ℝ) / Real.pi := by positivity
  have hscaled := mul_le_mul_of_nonneg_left hcore hscale0
  rw [hlogmul]
  calc
    (2 / Real.pi) * (q : ℝ) * (Real.log 4 + Real.log q) + 4 * q =
        (2 / Real.pi) * (q : ℝ) * Real.log q +
          (2 * (q : ℝ) / Real.pi) * (Real.log 4 + 2 * Real.pi) := by
      field_simp [Real.pi_ne_zero]
      ring
    _ ≤ (2 / Real.pi) * (q : ℝ) * Real.log q +
          (2 * (q : ℝ) / Real.pi) * 8 := by linarith
    _ = (2 / Real.pi) * (q : ℝ) * (8 + Real.log q) := by ring
theorem typeI_log_two_rounding :
    (0.5 : ℝ) * (2 / Real.pi) * 4 * Real.log 2 ≤ 0.89 := by
  have hcore : 4 * Real.log 2 ≤ (0.89 : ℝ) * Real.pi := by
    nlinarith [Real.log_two_lt_d9, Real.pi_gt_d4]
  have hdiv : 4 * Real.log 2 / Real.pi ≤ (0.89 : ℝ) :=
    (div_le_iff₀ Real.pi_pos).2 (by simpa [mul_comm] using hcore)
  convert hdiv using 1 <;> ring
end TaoFivePrimes
