-- title:
--   Theorem 4.A.5 (increasing concave case) — supermartingale-coupling characterization of the increasing concave order
-- statement:
--   Let $X$ on $(\Omega,\mu)$ and $Y$ on $(\Omega',\nu)$ be random variables. Then
--
--   $$X \le_{icv} Y \iff \exists\,(\Omega'',\rho),\ \hat X,\hat Y:\Omega''\to\mathbb{R} \text{ with }
--     \hat X =_{st} X,\ \hat Y =_{st} Y,\ \text{and } \{\hat Y,\hat X\} \text{ a supermartingale},$$
--
--   i.e. $E[\hat X \mid \hat Y] \le \hat Y$ a.s. — note the *swapped* roles of $\hat X$ and $\hat
--   Y$ in the conditioning, relative to the increasing convex case: it is $\hat X$'s conditional
--   expectation given $\hat Y$ that is bounded, not the other way around. **Furthermore**, $\hat
--   X$ and $\hat Y$ can be selected such that $[\hat X \mid \hat Y = x]$ is increasing in $x$ in
--   the usual stochastic order $\le_{st}$. This is the companion half of Theorem 4.A.5, stated
--   here as its own Lean theorem for the reason given in `icx_submartingale_coupling_iff`'s
--   Formalization Note.
--
--   **Formalization Note** "$\{\hat Y,\hat X\}$ a supermartingale" is `ρ[X̂ | m'] ≤ᵐ[ρ] Ŷ` with
--   `m'` the σ-algebra generated by `Ŷ` (not `X̂`) — the conditioning variable is deliberately
--   swapped relative to the icx case, matching the book's own bracket "$[\{\hat Y,\hat X\}$ is a
--   supermartingale$]$" (the pair is listed in the opposite order from the icx case's `{X̂,Ŷ}`).
--   The "Furthermore" clause is symmetric to the icx case's, with `condDistrib X̂ Ŷ` (not `condDistrib
--   Ŷ X̂`) as the kernel whose survival function is monotone in the conditioning value.
-- source:
--   Shaked & Shanthikumar, Stochastic Orders, Springer 2007, p. 183, Theorem 4.A.5

import Mathlib
import Definitions.Def_StochasticOrders_MonotoneConvex_IcvOrder

namespace StochasticOrders.MonotoneConvex

open MeasureTheory ProbabilityTheory

/-- Theorem 4.A.5 (Shaked & Shanthikumar, *Stochastic Orders*, Springer 2007, p. 183), increasing
concave case: `X ≤icv Y` if, and only if, there exist two random variables `X̂` and `Ŷ`, defined on
the same probability space, such that `X̂ =st X`, `Ŷ =st Y`, and `{Ŷ, X̂}` is a supermartingale,
that is, `E[X̂ | Ŷ] ≤ Ŷ` a.s. (note the swapped roles of `X̂` and `Ŷ` in the conditioning relative
to the increasing convex case). Furthermore, `X̂` and `Ŷ` can be selected such that `[X̂ | Ŷ = x]`
is increasing in `x` in the usual stochastic order `≤st`. -/
theorem icv_supermartingale_coupling_iff {Ω Ω' : Type*} [MeasurableSpace Ω] [MeasurableSpace Ω']
    (μ : Measure Ω) (ν : Measure Ω') [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (X : Ω → ℝ) (Y : Ω' → ℝ) :
    IcvOrder μ ν X Y ↔
      ∃ (Ω'' : Type) (_ : MeasurableSpace Ω'') (ρ : Measure Ω'') (_ : IsProbabilityMeasure ρ)
        (Xhat Yhat : Ω'' → ℝ),
        IdentDistrib Xhat X ρ μ ∧ IdentDistrib Yhat Y ρ ν ∧
        ρ[Xhat | MeasurableSpace.comap Yhat inferInstance] ≤ᵐ[ρ] Yhat ∧
        (∀ y₁ y₂ : ℝ, y₁ ≤ y₂ → ∀ t : ℝ,
          (condDistrib Xhat Yhat ρ y₁) {x : ℝ | t < x} ≤
            (condDistrib Xhat Yhat ρ y₂) {x : ℝ | t < x}) := by sorry

end StochasticOrders.MonotoneConvex
