theorem GlueP14.prop14_unconditional {P K D S ρ r : ℕ} (hρ : ρ < K) (p : ℕ)
    (xs : List (Fin r → ℂ)) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    prop14Proc (P := P) (S := S) hρ p (cRecC D) xs = QpArr p (layerH P K D S ρ hρ xs) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p (cRecC D) xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p (cRecC D) xs)[j] c‖ ≤ 1) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p (cRecC D) xs).length)
