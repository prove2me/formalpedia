namespace NLogN.KIL

open IntMul RS AModel AModelL12 AModelFac

theorem coprime_mod {Q k : ℕ} (h : Nat.Coprime Q k) : Nat.Coprime Q (k % Q) := by
  unfold Nat.Coprime at *
  rw [Nat.gcd_comm, ← Nat.gcd_rec, h]

theorem one_le_mod {Q k : ℕ} (hQ : 2 ≤ Q) (h : Nat.Coprime Q k) : 1 ≤ k % Q := by
  by_contra h0
  have h1 : k % Q = 0 := by omega
  have h2 := coprime_mod h
  rw [h1] at h2
  unfold Nat.Coprime at h2
  rw [Nat.gcd_zero_right] at h2
  omega

theorem repOK_of_frac {D Q : ℕ} (hQ : 2 ≤ Q) {u : ZMod Q} (h : FracUnit D Q u) :
    ∃ r, RepOK D Q r u := by
  obtain ⟨k, d, neg, hk1, hkD, hd1, hdD, hQk, hQd, rfl⟩ := h
  refine ⟨(k % Q, d % Q, neg), one_le_mod hQ hQk, le_trans (Nat.mod_le _ _) hkD,
    (Nat.mod_lt _ (by omega)).le, one_le_mod hQ hQd, le_trans (Nat.mod_le _ _) hdD,
    (Nat.mod_lt _ (by omega)).le, coprime_mod hQk, coprime_mod hQd, ?_⟩
  simp only [fracU, ZMod.natCast_mod]

theorem repOf_ok {D Q : ℕ} (hQ : 2 ≤ Q) {u : ZMod Q} (h : FracUnit D Q u) :
    RepOK D Q (repOf D Q u) u := by
  have h' := repOK_of_frac hQ h
  unfold repOf
  rw [dif_pos h']
  exact Classical.choose_spec h'

section RunF

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {Pp : ℕ} {I : List Sym}
  {iprog : Fin Pp → IStmt HS Pp}

theorem shiftF_runs [NeZero Q] (D : ℕ) (rep : ZMod Q → ℕ × ℕ × Bool) (hpos : ∀ a ∈ sh, 1 ≤ a)
    (t : IState HS) (R : List Item)
    (Bb : ℕ) (hV : zsz ((vol sh : ℕ) : ℤ) ≤ Bb) (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb)
    (i : Fin n) (u : ZMod Q) (hu : RepOK D Q (rep u) u) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (ys : List ℤ) (hy : DOK sh Bb ys) :
    IRuns I iprog (scodeF Λ rep (.shift i u c)) (t.upd 0 (ints ys ++ R))
      (t.upd 0 (ints ((Step.shift i u c).arr Λ 0 ys) ++ R)) (cShiftD D sh.length (vol sh) Bb) := by
  obtain ⟨hk1, hkD, hkQ, hd1, hdD, hdQ, hQk, hQd, hu⟩ := hu
  set k := (Λ.pos i : ℕ)
  have hk : k < sh.length := (Λ.pos i).2
  set A := sh.take k
  set C := sh.drop (k + 1)
  have hsh : sh = A ++ Q :: C := by
    have h1 := Λ.size i
    rw [List.get_eq_getElem] at h1
    conv_lhs => rw [← List.take_append_drop k sh, List.drop_eq_getElem_cons hk]
    rw [h1]
  have hA : (Λ.pos i : ℕ) = A.length := by simp [A, k, List.length_take]
  have hposA : ∀ a ∈ A, 1 ≤ a := fun a ha => hpos a (List.mem_of_mem_take ha)
  have hposC : ∀ a ∈ C, 1 ≤ a := fun a ha => hpos a (List.mem_of_mem_drop ha)
  have hvol : vol A * (Q * vol C) = vol sh := by
    conv_rhs => rw [hsh]
    rw [vol_append, vol_cons]
  have hQ1 : 1 ≤ Q := Nat.one_le_iff_ne_zero.2 (NeZero.ne Q)
  have hlA : A.length ≤ sh.length := by simp [A]
  have H := shiftArr_il_unit Λ i c hc A C hsh hA (rep u).1 (rep u).2.1 (rep u).2.2 hk1 hkQ hd1 hdQ
    hQk hQd (t.upd 0 (ints ys ++ R)) ys Bb R hy.1 hy.2 (vol_pos_of hposC) hQ1
    (vol_pos_of hposA) (by rw [hvol]; exact hV) hQ2 (by simp)
  rw [IState.upd_upd_same, ← hu] at H
  have HR := RS.code_runs (I := I) (iprog := iprog) _ _ H.1
  rw [H.2.1] at HR
