namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem frm_trans {A B C : List (Fin HS)} {u w w' : Vr} (h1 : ∀ i ∉ A, w i = u i)
    (h2 : ∀ i ∉ B, w' i = w i) (hA : ∀ i ∈ A, i ∈ C) (hB : ∀ i ∈ B, i ∈ C) :
    ∀ i ∉ C, w' i = u i := fun i hi => by
  rw [h2 i (fun h => hi (hB i h)), h1 i (fun h => hi (hA i h))]

theorem frm_upd {A : List (Fin HS)} {u w : Vr} (h : ∀ i ∉ A, w i = u i) {j : Fin HS} (hj : j ∈ A)
    (a : ℤ) : ∀ i ∉ A, update w j a i = u i := fun i hi => by
  rw [update_of_ne (by rintro rfl; exact hi hj)]; exact h i hi

theorem Fx.frm {Q kk m mw cB : ℕ} {A : List (Fin HS)} {u w : Vr} (h : Fx Q kk m mw cB u)
    (hf : ∀ i ∉ A, w i = u i) (hA : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), j ∉ A) :
    Fx Q kk m mw cB w := h.of (fun j hj => hf j (hA j hj))

theorem StS.upd {m : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {c : Cs} (h : StS m L Mf c) {j : Fin HS}
    (hj : j ≠ 14 ∧ j ≠ 30) (l : List ℤ) : StS m L Mf (update c j l) :=
  ⟨by rw [update_of_ne (Ne.symm hj.1)]; exact h.1, by rw [update_of_ne (Ne.symm hj.2)]; exact h.2⟩

theorem cnt_lt_le (p : ℕ → Prop) [DecidablePred p] {r : ℕ} (hp : ∀ q, p q → q < r) :
    ∀ m, ((List.range m).filter (fun q => p q)).length ≤ r
  | 0 => by simp
  | m + 1 => by
    have ih := cnt_lt_le p hp m
    rw [List.range_succ, List.filter_append, List.length_append]
    by_cases h : p m
    · have := hp m h
      have h2 : ((List.range m).filter (fun q => p q)).length ≤ m := by
        have := List.length_filter_le (fun q => decide (p q)) (List.range m); simpa using this
      simp [h]; omega
    · simp [h]; omega

theorem cwN_le (m mw cB : ℕ) (L : List ℕ) (r : ℕ) : cwN m mw cB L r ≤ r := by
  unfold cwN; split_ifs
  · exact le_rfl
  · exact cnt_lt_le _ (fun q h => h.1) m

section loops2
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **The forward push** of row `r`. -/
theorem Rn.fsL_sol_aux {u : Vr} {D : Cs} (hF : Fx Q kk m mw cB u) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W u) {r : ℕ} (h5 : u 5 = r) (hr : r < m)
    (h4 : u 4 = Lg L r) (h3 : u 3 = cwN m mw cB L r) (hD51 : D 51 = []) (hmW : m + 1 ≤ 2 ^ W) :
    Rn (PJ.forL 51 3 2 (progL fsI)) u D (fun u' =>
      (∀ i ∉ ([2, 6, 7, 8, 29] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update D 41 ((fsP Q m mw cB L Mf r).reverse ++ D 41))
      (cFor W (cwN m mw cB L r) (costL W (m * m + m) fsI)) := by
  set cw := cwN m mw cB L r with hcw
  have hcl : cw ≤ r := cwN_le m mw cB L r
  set ck : ℕ → List ℤ := fun k => (List.range k).map (fsF Q mw cB L Mf r cw) with hck
  set Iv : ℕ → Vr → Prop := fun _ w => ∀ i ∉ ([2, 6, 7, 8, 29] : List (Fin HS)), w i = u i with hIv
  have hWlt : cw < 2 ^ W := by omega
  have H := Rn.forL (C := 51) (rN := 3) (ix := 2) (b := progL fsI) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := cw) (W := W) (Iv := Iv)
    (cf := fun k => update D 41 ((ck k).reverse ++ D 41)) (cb := costL W (m * m + m) fsI)
    (fun k => by simp [hD51]) hWlt
    (fun k hk w hfw hw2 hbw => by
      set c' := update (update D 41 ((ck k).reverse ++ D 41)) 51 [(cw : ℤ) - k]
      have hFw : Fx Q kk m mw cB w := hF.frm hfw (by decide)
      have hS' : StS m L Mf c' := (hS.upd (by decide) _).upd (by decide) _
      have hw5 : w 5 = r := by rw [hfw 5 (by decide), h5]
      have hw3 : w 3 = cw := by rw [hfw 3 (by decide), h3]
      have hw4 : w 4 = Lg L r := by rw [hfw 4 (by decide), h4]
      have H1 := Rn.fsIs hFw hS' hB hLm hbw hw5 hw3 hw2 hk hcl hr hw4
      have hst : update c' 41 ((if bandS mw cB (Lg L r) (Lg L (r - cw + k)) then
          fdiv Q (Mf r (r - cw + k)) (Mf (r - cw + k) (r - cw + k)) else 0) :: c' 41) =
          update (update D 41 ((ck (k + 1)).reverse ++ D 41)) 51 [(cw : ℤ) - k] := by
        have : ck (k + 1) = ck k ++ [fsF Q mw cB L Mf r cw k] := by
          simp only [hck, List.range_succ, List.map_append, List.map_cons, List.map_nil]
        rw [this]; funext j; simp only [c', update_apply]; split_ifs <;> simp_all [fsF]
      refine (H1.mono (fun w' hw' => ?_) le_rfl).congr hst
      obtain ⟨hf1, hb1⟩ := hw'
      exact ⟨frm_upd (frm_trans (C := [2, 6, 7, 8, 29]) hfw hf1 (by decide) (by decide)) (by decide) _,
        by rw [hf1 2 (by decide), hw2], hb1⟩)
    hv (by rw [h3]) (frm_upd (fun i _ => rfl) (by decide) _)
  have e0 : update D 41 ((ck 0).reverse ++ D 41) = D := by
    simp only [hck, List.range_zero, List.map_nil, List.reverse_nil, List.nil_append]
    exact update_eq_self _ _
  rw [e0] at H
  exact H.mono (fun u' ⟨hf, _, hb⟩ => ⟨hf, hb⟩) le_rfl

end loops2

