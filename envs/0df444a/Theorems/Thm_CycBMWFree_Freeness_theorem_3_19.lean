-- title:
--   Theorem 3.19, p. 31 — universal admissible ring and universal admissible integral domain
-- statement:
--   For $r\ge1$, there are an admissible ground ring $\overline R_0$ and an admissible integral ground ring $\overline R_+$ such that: (1) there is a morphism of ground rings $\psi:\overline R_0\to\overline R_+$; (2) each is generated as a unital ring by its parameters $q^{\pm1},ρ^{\pm1},δ_0^{\pm1},δ_1,\ldots,δ_{r-1},u_1^{\pm1},\ldots,u_r^{\pm1}$; (3) in each, $q,u_1,\ldots,u_r$ are algebraically independent over $\mathbb Z$; (4) every ring $S$ with admissible parameters receives a morphism of ground rings $\varphi_0:\overline R_0\to S$, which, when $S$ is an integral domain, factors as $\varphi\circ\psi$ with $\varphi:\overline R_+\to S$ a morphism of ground rings; (5) $\overline R_+[(q-q^{-1})^{-1}]$ is isomorphic, by an isomorphism of ground rings, to the universal $u$-admissible ring $\overline S$ of §3.4:
--   $$
--   \overline R_+[(q-q^{-1})^{-1}]\;\cong\;\overline S=\mathbb Z[q^{\pm1},u_1^{\pm1},\ldots,u_r^{\pm1}][(q^{-1}-q)^{-1}][δ_0^{-1}]\subseteq\mathbb Q(q,u_1,\ldots,u_r).
--   $$
--   The universal domain carries the generic result of §4 to arbitrary admissible integral domains. **Formalization Note** Part (5) is stated inside $F=\mathbb Q(q,u_1,\ldots,u_r)$: an injective morphism of ground rings $\varphi:\overline R_+\to F$ onto the §3.4 generic parameters, whose image together with $(\varphi(q)-\varphi(q)^{-1})^{-1}$ generates the same subring as $q^{\pm1},(q^{-1}-q)^{-1},δ_0^{-1},u_i^{\pm1}$ (Lemma 3.18 (2)); since $\overline R_+$ is a domain this subring is $\overline R_+[(q-q^{-1})^{-1}]$. The rings are taken in `Type`, and $S$ in (4) ranges over `Type`.
-- source:
--   Goodman & Hauschild Mosley, Cyclotomic BMW algebras II, arXiv:math/0612065v5, p. 31, Theorem 3.19

import Mathlib
import Definitions.Def_CycBMWFree_Freeness_Setting

noncomputable section
open scoped BigOperators

namespace CycBMWFree.Freeness
open QAlgorithms.Papers.Independent.Support21.P14

/-- The universal admissible ring `R̄₀` and universal admissible integral domain `R̄₊`,
Theorem 3.19 (1)–(5), p. 31. Part (5) is stated inside `ℚ(q, u₁, …, u_r)`: `R̄₊` embeds by a
morphism of ground rings onto the generic parameters, and the subring generated by its image and
`(q − q⁻¹)⁻¹` is the universal u-admissible ring `S̄ = ℤ[q^{±1}, u^{±1}][(q⁻¹ − q)⁻¹][δ₀⁻¹]`
of §3.4 / Lemma 3.18. -/
theorem theorem_3_19 (r : ℕ) (hr : 0 < r) :
    ∃ (R0 : Type) (ring0 : CommRing R0),
      letI : CommRing R0 := ring0
      ∃ (R : Type) (ringR : CommRing R),
        letI : CommRing R := ringR
        ∃ (domainR : IsDomain R),
          letI : IsDomain R := domainR
          ∃ (P0 : GroundParameters R0 r) (P : GroundParameters R r),
            BMWAdmissible P0 ∧ BMWAdmissible P ∧
            -- (2) for R̄₀
            Subring.closure
              ({(P0.q : R0), ((P0.q⁻¹ : R0ˣ) : R0), (P0.rho : R0), ((P0.rho⁻¹ : R0ˣ) : R0),
                (P0.deltaZero : R0), ((P0.deltaZero⁻¹ : R0ˣ) : R0)} ∪
                P0.delta '' Set.Icc 1 (r - 1) ∪
                Set.range (fun i => (P0.u i : R0)) ∪
                Set.range (fun i => (((P0.u i)⁻¹ : R0ˣ) : R0))) = ⊤ ∧
            -- (2) for R̄₊
            Subring.closure
              ({(P.q : R), ((P.q⁻¹ : Rˣ) : R), (P.rho : R), ((P.rho⁻¹ : Rˣ) : R),
                (P.deltaZero : R), ((P.deltaZero⁻¹ : Rˣ) : R)} ∪
                P.delta '' Set.Icc 1 (r - 1) ∪
                Set.range (fun i => (P.u i : R)) ∪
                Set.range (fun i => (((P.u i)⁻¹ : Rˣ) : R))) = ⊤ ∧
            -- (3) for R̄₊ and R̄₀
            AlgebraicIndependent ℤ
              (fun o : Option (Fin r) => o.elim (P.q : R) (fun i => (P.u i : R))) ∧
            AlgebraicIndependent ℤ
              (fun o : Option (Fin r) => o.elim (P0.q : R0) (fun i => (P0.u i : R0))) ∧
            -- (1) and (4)
            (∃ ψ : R0 →+* R, IsGroundRingMorphism P0 P ψ ∧
              ∀ (S : Type) (ringS : CommRing S),
                letI : CommRing S := ringS
                ∀ P' : GroundParameters S r, BMWAdmissible P' →
                  ∃ φ0 : R0 →+* S, IsGroundRingMorphism P0 P' φ0 ∧
                    ∀ (_ : IsDomain S), ∃ φ : R →+* S,
                      IsGroundRingMorphism P P' φ ∧ φ0 = φ.comp ψ) ∧
            -- (5), read inside ℚ(q, u₁, …, u_r)
            ∃ (PK : GroundParameters (GenericField r) r) (φ : R →+* GenericField r),
              IsGenericParameters PK ∧ Function.Injective φ ∧
                IsGroundRingMorphism P PK φ ∧
                Subring.closure (Set.range φ ∪ {(φ (P.q : R) - φ ((P.q⁻¹ : Rˣ) : R))⁻¹}) =
                  Subring.closure
                    ({genQ r, (genQ r)⁻¹, ((genQ r)⁻¹ - genQ r)⁻¹, (genDelta r 0)⁻¹} ∪
                      Set.range (genU r) ∪ Set.range (fun j => (genU r j)⁻¹)) := by sorry

end CycBMWFree.Freeness
