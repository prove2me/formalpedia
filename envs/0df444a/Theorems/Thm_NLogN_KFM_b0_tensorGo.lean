theorem NLogN.KFM.b0_tensorGo (p α K : ℕ) (ts ss : List ℕ) (ht : ts.length = K) (hs : ss.length = K)
    (hpos : ∀ i < K, 0 < ts.getD i 1) (g : (Fin K → ℕ) → ℤ × ℤ) :
    Ref.tensorGo ((List.range K).map fun i => (ss.getD i 1, fun X : List (ℤ × ℤ) =>
        (List.range (ss.getD i 1)).map (B0P p (ss.getD i 1) (ts.getD i 1) α fun j =>
          X.getD j (0, 0)))) ts
      (Ref.listOf ts fun j => g fun i => j i) =
    Ref.listOf ss fun j =>
      tensorMapZ (fun i : Fin K => B0P p (ss.getD i 1) (ts.getD i 1) α) g fun i => j i := by sorry
