  have hc : (Ex.neg (.reg sFL) : Ex HS).Clean := clean_neg (clean_reg (by decide))
  have hok : (Ex.neg (.reg sFL) : Ex HS).ok (NLogN.KIL.encK s G) := ok_reg gF
  have hbd : (Ex.neg (.reg sFL) : Ex HS).Bnd (NLogN.KIL.encK s G) Bb := bnd_reg gF zF
  have hev : (Ex.neg (.reg sFL) : Ex HS).eval (NLogN.KIL.encK s G) = -flagV κ k := by
    simp only [Ex.eval]; rw [top_encK gF]
  have h0 : G 0 = restR (fun d => recs (γ d)) M (k + 1) ++ G0 0 := by
    simp +decide [G, P3, Function.update_apply]
  by_cases hm : κ k ≠ k
  · -- a moved destination: the sorted record of `γ k`
    have gB : G sKB = (recs (γ k)).reverse ++ (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k ++ G0 sKB) := by
      simp +decide [G, P3, Function.update_apply, stkF_succ, mvP, hm]
    have S1 := FSp.mvL (X := sKB) (Y := 0) (C := NLogN.KFL.cMv) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s G _ _ gB 1 Bb (by intro a ha; exact hbits _ a (by simpa using ha))
      (by rw [List.length_reverse, hlen]; exact zB)
    rw [List.length_reverse, hlen, List.reverse_reverse] at S1
    set G1 := Function.update (Function.update G sKB (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k
