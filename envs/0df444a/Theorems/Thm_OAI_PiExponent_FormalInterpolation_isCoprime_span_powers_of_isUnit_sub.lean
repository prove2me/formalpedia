-- title:
--   Powers of polynomials with unit difference are comaximal
-- statement:
--   In a commutative ring, if the difference of two elements is a unit, then the ideals generated by any powers of those elements are comaximal, including zero powers.

import Mathlib.RingTheory.Ideal.Operations

theorem OAI.PiExponent.FormalInterpolation.isCoprime_span_powers_of_isUnit_sub
    {R : Type} [CommRing R] {x y : R} (h : IsUnit (x - y)) (n p : Nat) :
    IsCoprime (Ideal.span ({x ^ n} : Set R)) (Ideal.span ({y ^ p} : Set R)) := by sorry
