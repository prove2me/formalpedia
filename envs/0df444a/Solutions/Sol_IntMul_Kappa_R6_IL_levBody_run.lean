theorem tabR_shift (F : ℕ → List ℤ) : ∀ n a, tabR a n F = tabR 0 n (fun k => F (a + k))
  | 0, a => by simp [tabR]
  | n + 1, a => by
    rw [tabR_succ, tabR_succ, tabR_shift F n (a + 1), tabR_shift (fun k => F (a + k)) n 1]
    simp only [Nat.add_zero, Nat.zero_add]
    congr 2
    funext k
    congr 1
    omega

