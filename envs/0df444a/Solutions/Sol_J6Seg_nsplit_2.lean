      by_cases h0 : h = 0
      · exact h1 (mem_union_left _ (mem_image.2 ⟨i, by rw [mem_blS]; omega, by rw [h0]; ring⟩))
      by_cases hin : (B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i
      · exact h1 (mem_union_left _ (mem_image.2 ⟨(i + h).toNat, by rw [mem_blS]; omega,
          by omega⟩))
      · exact h1 (mem_union_right _ (mem_Hset_of (by rw [not_lt, abs_le] at h2; omega)
          (by rw [not_lt, abs_le] at h2; omega) h0 hin))
  have ht := tail_sum s t α hs hst hα (i : ℤ) B.w
  have hS2 : Summable (fun h : ℤ => (if (B.w : ℤ) < |h| then eEx s t α i h else 0) * X) :=
    ht.1.mul_right X
  have hgs : Summable g := hS2.of_norm_bounded hgb
  have hgn : Summable (fun h => ‖g h‖) := hS2.of_nonneg_of_le (fun _ => norm_nonneg _) hgb
  have hfirst : Summable (fun h => if h ∈ S then f h else 0) := by
    have e : (fun h => if h ∈ S then f h else 0) = fun h => f h - g h := by
      funext h; simp only [g]; split_ifs <;> ring
    rw [e]; exact hfs.sub hgs
  have hsplit : ∑' h, f h = ∑ h ∈ S, f h + ∑' h, g h := by
    have e : f = fun h => (if h ∈ S then f h else 0) + g h := by
      funext h; simp only [g]; split_ifs <;> ring
    conv_lhs => rw [e]
    rw [hfirst.tsum_add hgs, tsum_eq_sum (s := S) (fun h hh => if_neg hh)]
    congr 1
    exact sum_congr rfl fun h hh => if_pos hh
  have hFb : ∑ h ∈ Fb, f h = ∑ k ∈ blS B i, eEx s t α i ((k : ℤ) - i) * x k := by
    rw [sum_image (fun a _ b _ hab => by simpa using hab)]
    refine sum_congr rfl fun k hk => ?_
    have hks := blS_lt hB hi hk
    simp only [hf]
    congr 2
    rw [show (i : ℤ) + ((k : ℤ) - i) = k by ring,
      Int.emod_eq_of_lt (by omega) (by exact_mod_cast hks)]
    simp
  have hMv : Mv (blS B) (MxG s t α) x i = x i + ∑ k ∈ blS B i, eEx s t α i ((k : ℤ) - i) * x k := by
    unfold Mv MxG
    simp only [add_mul, sum_add_distrib, kd, ite_mul, one_mul, zero_mul]
    rw [sum_ite_eq]; simp [blS_self hB hi]
  have hDv : Dv (Hset B) (col B.s) (cfG s t α) x i = ∑ h ∈ Hset B i, f h := by
    unfold Dv cfG col; rw [hB.hs]
  have hN : NxR s t α x i = x i + ∑' h, f h := rfl
  rw [hN, hMv, hDv, hsplit, sum_union hdisj, hFb]
  have : x i + (∑ k ∈ blS B i, eEx s t α i ((k : ℤ) - i) * x k + ∑ h ∈ Hset B i, f h +
      ∑' h, g h) - (x i + ∑ k ∈ blS B i, eEx s t α i ((k : ℤ) - i) * x k +
      ∑ h ∈ Hset B i, f h) = ∑' h, g h := by ring
  rw [this]
  calc |∑' h, g h| = ‖∑' h, g h‖ := (Real.norm_eq_abs _).symm
    _ ≤ ∑' h, ‖g h‖ := norm_tsum_le_tsum_norm hgn
    _ ≤ ∑' h : ℤ, (if (B.w : ℤ) < |h| then eEx s t α i h else 0) * X := hgn.tsum_le_tsum hgb hS2
    _ = (∑' h : ℤ, if (B.w : ℤ) < |h| then eEx s t α i h else 0) * X := tsum_mul_right
    _ ≤ 4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1)))) * X :=
        mul_le_mul_of_nonneg_right ht.2 hX0

end glob

end J6Seg

