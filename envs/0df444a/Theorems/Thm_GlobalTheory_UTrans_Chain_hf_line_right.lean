variable {E : Type} [Field E] [CharZero E] {n : ℕ}

theorem GlobalTheory.UTrans.Chain.hf_line_right (σ : E →+* E) (G : Matrix (Fin n) (Fin n) E) (x w z : Fin n → E) (t : E) :
    hf σ G z (x + t • w) = hf σ G z x + σ t * hf σ G z w := by sorry
