  hBP : B0 ≤ Pgood
  hwidthP : Pwidth ≤ Pgood
  hg : 0 ≤ gainLog
  hgP : gainLog + 8 ≤ Pgood
  hgain : Real.exp (-gainLog) ≤ gain
  hstrideWidth : Qstride ≤ Pwidth
