import Mathlib
import Definitions.Def_QAlgorithms_Papers_Independent_Claimed50_P10
import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P13

/-!
Keyl--Kiukas--Werner, arXiv:1503.04086v1, Schwartz operators.
Paper-local definitions use the canonical Lebesgue L2 space, actual Schwartz
functions, P = -i d/dq, and bounded sesquilinear forms (Definition 3.1).
The range characterization is a theorem, not the definition of Schwartzness.
Only the items listed in items.json are stated; all other planned nodes have
individual HARD.md/GAPS.json entries. Compilation and independent review pending.
-/

noncomputable section

open MeasureTheory Filter
open QAlgorithms.Papers.Independent.Claimed50.P10 (Configuration)
open QAlgorithms.Papers.Independent.Dependency50.P13 (IsTraceClass)

open scoped BigOperators ENNReal ComplexOrder

namespace QAlgorithms.Papers.Independent.Next46.P16

/-- The canonical Hilbert space consists of L2 equivalence classes, PDF p.3. -/
abbrev CanonicalHilbert (n : ℕ) := Lp ℂ 2 (volume : Measure (Configuration n))

/-- Smooth rapidly decreasing functions with the full Schwartz topology, PDF p.4. -/
abbrev Schwartz (n : ℕ) := SchwartzMap (Configuration n) ℂ

/-- Bounded complex-linear operators on the full canonical Hilbert space, PDF p.3. -/
abbrev CanonicalOperator (n : ℕ) := CanonicalHilbert n →L[ℂ] CanonicalHilbert n

/-- Instantiate Mathlib's proved complex calculus on canonical bounded operators.
The operator C-star algebra comes from the complete complex L2 Hilbert space. -/
local instance canonicalComplexCalculus (n : ℕ) :
    ContinuousFunctionalCalculus ℂ (CanonicalOperator n) IsStarNormal :=
  IsStarNormal.instContinuousFunctionalCalculus

/-- Restrict the canonical operator calculus to real self-adjoint elements.
This is Mathlib's proved scalar restriction, with no additional source hypothesis. -/
local instance canonicalRealCalculus (n : ℕ) :
    ContinuousFunctionalCalculus ℝ (CanonicalOperator n) IsSelfAdjoint :=
  IsSelfAdjoint.instContinuousFunctionalCalculus

/-- Restrict the real unital calculus to functions vanishing at zero, as required
by CFC.abs and CFC.sqrt. No operator or state restriction is added. -/
local instance canonicalRealNonUnitalCalculus (n : ℕ) :
    NonUnitalContinuousFunctionalCalculus ℝ (CanonicalOperator n) IsSelfAdjoint :=
  ContinuousFunctionalCalculus.toNonUnital

/-- Nonnegative multi-indices, including the zero index, PDF p.4. -/
abbrev MultiIndex (n : ℕ) := Fin n → ℕ

/-- The actual Schwartz-to-L2 inclusion; no representative is chosen, PDF p.4. -/
def schwartzToHilbert {n : ℕ} (f : Schwartz n) : CanonicalHilbert n := f.toLp 2 volume

/-- Existence of a genuine Schwartz representative of an L2 class, PDF p.4. -/
def IsSchwartzVector {n : ℕ} (v : CanonicalHilbert n) : Prop :=
  ∃ f : Schwartz n, schwartzToHilbert f = v

/-- Position restricted to Schwartz functions, multiplication by q_i, PDF p.3. -/
def position {n : ℕ} (i : Fin n) : Schwartz n →L[ℂ] Schwartz n :=
  SchwartzMap.smulLeftCLM ℂ (fun x : Configuration n => (x i : ℂ))

/-- Momentum restricted to Schwartz functions, -i times the directional derivative,
PDF p.3. The standard real coordinate vector is Pi.single i 1. -/
def momentum {n : ℕ} (i : Fin n) : Schwartz n →L[ℂ] Schwartz n :=
  (-Complex.I) •
    ((SchwartzMap.evalCLM ℂ (Configuration n) ℂ (Pi.single i 1)).comp
      (SchwartzMap.fderivCLM ℂ (Configuration n) ℂ))

/-- Ordered coordinate powers A_1^a_1 ... A_n^a_n on Schwartz functions,
PDF p.4, (10); the rightmost operator acts first. -/
def multiAction {n : ℕ} (A : Fin n → Schwartz n →L[ℂ] Schwartz n)
    (a : MultiIndex n) (f : Schwartz n) : Schwartz n :=
  (List.finRange n).foldr (fun i g => ((A i : Schwartz n → Schwartz n)^[a i]) g) f

/-- The order P^b Q^a in the test vector of (11) and (18), PDF pp.4,11. -/
def testAction {n : ℕ} (a b : MultiIndex n) (f : Schwartz n) : Schwartz n :=
  multiAction momentum b (multiAction position a f)

/-- The order Q^a P^b in the vector seminorm (9), PDF p.4. -/
def vectorAction {n : ℕ} (a b : MultiIndex n) (f : Schwartz n) : Schwartz n :=
  multiAction position a (multiAction momentum b f)

/-- Values on the Schwartz unit ball in (11), PDF p.4. -/
def vectorFormValues {n : ℕ} (v : CanonicalHilbert n) (a b : MultiIndex n) : Set ℝ :=
  {r | ∃ f : Schwartz n, ‖schwartzToHilbert f‖ ≤ 1 ∧
    r = ‖inner ℂ (schwartzToHilbert (testAction a b f)) v‖}

/-- The supremum in (11). Statements always supply boundedness explicitly;
unbounded sets are never interpreted as having finite real supremum. -/
def vectorFormBound {n : ℕ} (v : CanonicalHilbert n) (a b : MultiIndex n) : ℝ :=
  sSup (vectorFormValues v a b)

/-- Values of the four-index sesquilinear form on the two unit balls, (18),
PDF p.11. The two primed indices are the right indices. -/
def operatorFormValues {n : ℕ} (T : CanonicalOperator n)
    (a ar b br : MultiIndex n) : Set ℝ :=
  {r | ∃ f g : Schwartz n,
    ‖schwartzToHilbert f‖ ≤ 1 ∧ ‖schwartzToHilbert g‖ ≤ 1 ∧
    r = ‖inner ℂ (schwartzToHilbert (testAction a b f))
      (T (schwartzToHilbert (testAction ar br g)))‖}

/-- The form seminorm, PDF p.11, (18); used on the bounded-form domain. -/
def operatorFormBound {n : ℕ} (T : CanonicalOperator n)
    (a ar b br : MultiIndex n) : ℝ :=
  sSup (operatorFormValues T a ar b br)

/-- Definition 3.1, PDF p.11: CanonicalHilbert boundedness of every form. This does not
assume the range theorem, a Schwartz kernel, or a Frechet topology. -/
def IsSchwartzOperator {n : ℕ} (T : CanonicalOperator n) : Prop :=
  ∀ a ar b br : MultiIndex n, BddAbove (operatorFormValues T a ar b br)

/-- The complex vector space underlying Definition 3.1, PDF pp.11--12.
Only closure under the vector operations is built here; no topological or
completeness property is built into this submodule. -/
def schwartzSubmodule (n : ℕ) : Submodule ℂ (CanonicalOperator n) where
  carrier := {T | IsSchwartzOperator T}
  zero_mem' := by
    intro a ar b br
    refine ⟨0, ?_⟩
    rintro r ⟨f, g, hf, hg, rfl⟩
    simp
  add_mem' := by
    intro T S hT hS a ar b br
    obtain ⟨C, hC⟩ := hT a ar b br
    obtain ⟨D, hD⟩ := hS a ar b br
    refine ⟨C + D, ?_⟩
    rintro r ⟨f, g, hf, hg, rfl⟩
    have h1 : ‖inner ℂ (schwartzToHilbert (testAction a b f))
        (T (schwartzToHilbert (testAction ar br g)))‖ ≤ C :=
      hC ⟨f, g, hf, hg, rfl⟩
    have h2 : ‖inner ℂ (schwartzToHilbert (testAction a b f))
        (S (schwartzToHilbert (testAction ar br g)))‖ ≤ D :=
      hD ⟨f, g, hf, hg, rfl⟩
    simpa only [ContinuousLinearMap.add_apply, inner_add_right] using
      (norm_add_le
        (inner ℂ (schwartzToHilbert (testAction a b f))
          (T (schwartzToHilbert (testAction ar br g))))
        (inner ℂ (schwartzToHilbert (testAction a b f))
          (S (schwartzToHilbert (testAction ar br g))))).trans (add_le_add h1 h2)
  smul_mem' := by
    intro c T hT a ar b br
    obtain ⟨C, hC⟩ := hT a ar b br
    refine ⟨‖c‖ * C, ?_⟩
    rintro r ⟨f, g, hf, hg, rfl⟩
    have h1 : ‖inner ℂ (schwartzToHilbert (testAction a b f))
        (T (schwartzToHilbert (testAction ar br g)))‖ ≤ C :=
      hC ⟨f, g, hf, hg, rfl⟩
    simpa only [ContinuousLinearMap.smul_apply, inner_smul_right, norm_mul] using
      mul_le_mul_of_nonneg_left h1 (norm_nonneg c)

/-- Schwartz operators as a vector space, with topology defined separately,
PDF p.11. The inherited operator norm topology is never used for source claims. -/
abbrev SchwartzOperator (n : ℕ) := schwartzSubmodule n

/-- The original topology generated by all translated form-seminorm balls,
PDF pp.11--12. Centers range over Schwartz operators; ambient operator norm
is not substituted for the Schwartz topology. -/
def schwartzOperatorTopology (n : ℕ) : TopologicalSpace (SchwartzOperator n) :=
  TopologicalSpace.generateFrom
    {U | ∃ (S : SchwartzOperator n) (a ar b br : MultiIndex n) (eps : ℝ),
      0 < eps ∧ U = {T | operatorFormBound (T.val - S.val) a ar b br < eps}}

/-- The topology generated by just the left and right one-sided form seminorms,
PDF p.17. Equality with the original topology is a conclusion of Theorem 3.12. -/
def oneSidedTopology (n : ℕ) : TopologicalSpace (SchwartzOperator n) :=
  TopologicalSpace.generateFrom
    {U | ∃ (S : SchwartzOperator n) (a ar b br : MultiIndex n) (eps : ℝ),
      0 < eps ∧ ((ar = 0 ∧ br = 0) ∨ (a = 0 ∧ b = 0)) ∧
      U = {T | operatorFormBound (T.val - S.val) a ar b br < eps}}

/-- Noncommutative polynomial expressions in the canonical generators, PDF
p.12. Each term is a coefficient and an ordered word; redundant expressions
are permitted, and every source polynomial has such a finite presentation. -/
abbrev CanonicalPolynomial (n : ℕ) := List (ℂ × List (Fin n ⊕ Fin n))

/-- Canonical words acting on Schwartz functions, PDF pp.3,12. -/
def wordAction {n : ℕ} : List (Fin n ⊕ Fin n) → Schwartz n →L[ℂ] Schwartz n
  | [] => ContinuousLinearMap.id ℂ (Schwartz n)
  | .inl i :: w => (position i).comp (wordAction w)
  | .inr i :: w => (momentum i).comp (wordAction w)

/-- Evaluation of a canonical polynomial on Schwartz functions, PDF p.12. -/
def canonicalAction {n : ℕ} (p : CanonicalPolynomial n) : Schwartz n →L[ℂ] Schwartz n :=
  (p.map (fun term => term.1 • wordAction term.2)).sum

/-- Formal adjoint on the common Schwartz domain, PDF pp.3,12: conjugate
coefficients and reverse word order; Q_i and P_i are symmetric there. -/
def canonicalAdjoint {n : ℕ} (p : CanonicalPolynomial n) : CanonicalPolynomial n :=
  p.map (fun term => (star term.1, term.2.reverse))

/-- Weak form of f_L T f_R on Schwartz unit balls, PDF p.12. -/
def polynomialFormValues {n : ℕ} (T : CanonicalOperator n)
    (pL pR : CanonicalPolynomial n) : Set ℝ :=
  {r | ∃ f g : Schwartz n,
    ‖schwartzToHilbert f‖ ≤ 1 ∧ ‖schwartzToHilbert g‖ ≤ 1 ∧
    r = ‖inner ℂ (schwartzToHilbert (canonicalAction (canonicalAdjoint pL) f))
      (T (schwartzToHilbert (canonicalAction pR g)))‖}

/-- Topology generated by translated polynomial-form seminorm balls, PDF p.12.
Proposition 3.4 identifies these finite bounds with actual extension norms. -/
def polynomialTopology (n : ℕ) : TopologicalSpace (SchwartzOperator n) :=
  TopologicalSpace.generateFrom
    {U | ∃ (S : SchwartzOperator n) (pL pR : CanonicalPolynomial n) (eps : ℝ),
      0 < eps ∧ U = {T | sSup (polynomialFormValues (T.val - S.val) pL pR) < eps}}

/-- Values of the supremum of vector seminorms over the full CanonicalHilbert unit ball,
PDF p.17. Finiteness is asserted before using its real supremum. -/
def rangeSeminormValues {n : ℕ} (T : CanonicalOperator n) (a b : MultiIndex n) : Set ℝ :=
  {r | ∃ v : CanonicalHilbert n, ‖v‖ ≤ 1 ∧ r = vectorFormBound (T v) a b}

/-- The usual extended trace of a positive bounded operator: supremum of its
finite orthonormal diagonal sums, PDF p.7 (the trace used in Schatten norms).
Only positive operators are passed to this definition in the ideal predicates.
The ENNReal codomain retains infinity and avoids a default-valued real sum. -/
def positiveFrameTrace {n : ℕ} (A : CanonicalOperator n) : ℝ≥0∞ :=
  ⨆ (m : ℕ) (v : Fin m → CanonicalHilbert n) (_hv : Orthonormal ℂ v),
    ∑ i : Fin m, ENNReal.ofReal (inner ℂ (v i) (A (v i))).re

/-- Schatten p membership for positive integer p, Tr(|T|^p) finite, PDF p.7.
The absolute value and positive square root use the actual operator CFC. -/
def IsSchatten {n : ℕ} (p : ℕ) (T : CanonicalOperator n) : Prop :=
  1 ≤ p ∧ positiveFrameTrace ((CFC.abs T) ^ p) < ⊤

/-- The p-norm as an extended nonnegative real, PDF p.7. Used only for p >= 1;
on the Schatten class this is exactly the ordinary finite norm. -/
def integerSchattenNorm {n : ℕ} (p : ℕ) (T : CanonicalOperator n) : ℝ≥0∞ :=
  (positiveFrameTrace ((CFC.abs T) ^ p)).rpow ((p : ℝ)⁻¹)

/-- Finite sums of Schwartz rank-one operators, PDF p.7, (16). -/
def finiteSchwartzSum {n m : ℕ} (f g : Fin m → Schwartz n) : CanonicalOperator n :=
  ∑ k : Fin m, InnerProductSpace.rankOne ℂ (schwartzToHilbert (f k))
    (schwartzToHilbert (g k))

/-- Finite expressions in closed operators with scalar constants, sums, scalar
multiplication and ordered products, Lemma 3.9, PDF p.15. Closedness is required
only of the leaves, never of an arbitrary product. -/
inductive ClosedOperatorPolynomial (n : ℕ) where
  | atom (A : CanonicalHilbert n →ₗ.[ℂ] CanonicalHilbert n)
      (closedGraph : IsClosed (A.graph : Set (CanonicalHilbert n × CanonicalHilbert n)))
  | scalar (c : ℂ)
  | add (p q : ClosedOperatorPolynomial n)
  | smul (c : ℂ) (p : ClosedOperatorPolynomial n)
  | mul (p q : ClosedOperatorPolynomial n)

/-- Graph semantics of a polynomial on its natural domain, PDF p.15.
Sums require both summands to exist; pq requires qx to be in dom(p).
No zero-times-undefined or cancellation extension is made. -/
def closedPolynomialGraph {n : ℕ} : ClosedOperatorPolynomial n → CanonicalHilbert n → CanonicalHilbert n → Prop
  | .atom A _, x, y => (x, y) ∈ A.graph
  | .scalar c, x, y => y = c • x
  | .add p q, x, y => ∃ u v, closedPolynomialGraph p x u ∧ closedPolynomialGraph q x v ∧ y = u + v
  | .smul c p, x, y => ∃ u, closedPolynomialGraph p x u ∧ y = c • u
  | .mul p q, x, y => ∃ u, closedPolynomialGraph q x u ∧ closedPolynomialGraph p u y

/-- Phase coordinates (q,p), conceptually distinct from double configuration,
PDF pp.2--3,7. -/
abbrev CanonicalPhase (n : ℕ) := Configuration n × Configuration n

/-- The source's scaled phase measure dx=(2 pi)^(-n) dq dp, PDF p.3. -/
def phaseMeasure (n : ℕ) : Measure (CanonicalPhase n) :=
  ENNReal.ofReal ((2 * Real.pi) ^ n : ℝ)⁻¹ • volume

/-- The n-dimensional Gaussian ground-state wavefunction, PDF pp.5,22.
The one-dimensional h_0 in the prose is tensored over all modes. -/
def vacuumWave (n : ℕ) (q : Configuration n) : ℂ :=
  ((Real.rpow Real.pi (-(n : ℝ) / 4) *
    Real.exp (-(∑ i, q i ^ 2) / 2) : ℝ) : ℂ)

/-- Kernel of the actual rank-one dyad |psi><phi|, PDF pp.9,21. -/
def rankOneKernel {n : ℕ} (psi phi : Configuration n → ℂ)
    (q qr : Configuration n) : ℂ := psi q * star (phi qr)

/-- Tr(W(q,p)|psi><phi|)=<phi,W(q,p)psi>, directly using (2),(4),
PDF p.3. Intended for Schwartz wavefunctions, including vacuumWave. -/
def rankOneCharacteristic {n : ℕ} (psi phi : Configuration n → ℂ)
    (q p : Configuration n) : ℂ :=
  ∫ u : Configuration n,
    star (phi u) *
      Complex.exp (Complex.I * ((∑ i, p i * u i) - (∑ i, q i * p i) / 2 : ℝ)) *
      psi (u - q)

/-- Source-normalized rank-one Wigner function, PDF p.21: the integral has
no (2 pi)^(-n) factor; that factor belongs to phaseMeasure. -/
def rankOneWigner {n : ℕ} (psi phi : Configuration n → ℂ)
    (q p : Configuration n) : ℂ :=
  ∫ y : Configuration n,
    Complex.exp (Complex.I * ((∑ i, y i * p i : ℝ) : ℂ)) *
      star (phi (q + (1 / 2 : ℝ) • y)) * psi (q - (1 / 2 : ℝ) • y)

/-- Scaled symbols epsilon^(-2n) g(x/epsilon), PDF p.38; epsilon>0 in every use. -/
def scaledSymbol {n : ℕ} (g : SchwartzMap (CanonicalPhase n) ℂ) (eps : ℝ)
    (x : CanonicalPhase n) : ℂ :=
  (((eps ^ (2 * n))⁻¹ : ℝ) : ℂ) * g (eps⁻¹ • x)

/-- Positive dilation parameters, tending to zero from the right, PDF p.38. -/
abbrev PositiveScale := {eps : ℝ // 0 < eps}

/-- The epsilon->0+ filter on positive scale parameters, PDF p.38. -/
def scalesToZero : Filter PositiveScale :=
  Filter.comap (fun eps : PositiveScale => eps.val) (nhdsWithin 0 (Set.Ioi 0))

/-! Sanity examples for the local constructions; no source theorem is proved. -/

example {n : ℕ} : IsSchwartzVector (schwartzToHilbert (0 : Schwartz n)) :=
  ⟨0, rfl⟩

example {n : ℕ} (i : Fin n) :
    (fun x : Configuration n => (x i : ℂ)).HasTemperateGrowth := by
  exact (Complex.ofRealCLM.comp
    (ContinuousLinearMap.proj i : Configuration n →L[ℝ] ℝ)).hasTemperateGrowth

example {n : ℕ} (i : Fin n) (f : Schwartz n) (x : Configuration n) :
    position i f x = (x i : ℂ) * f x := by
  have hg : (fun q : Configuration n => (q i : ℂ)).HasTemperateGrowth :=
    (Complex.ofRealCLM.comp
      (ContinuousLinearMap.proj i : Configuration n →L[ℝ] ℝ)).hasTemperateGrowth
  simp [position, SchwartzMap.smulLeftCLM_apply_apply hg, smul_eq_mul]

example {n : ℕ} (i : Fin n) (f : Schwartz n) (x : Configuration n) :
    momentum i f x = -Complex.I *
      (fderiv ℝ (f : Configuration n → ℂ) x) (Pi.single i 1) := by
  rfl

example {n : ℕ} : IsSchwartzOperator (0 : CanonicalOperator n) := by
  intro a ar b br
  refine ⟨0, ?_⟩
  rintro r ⟨f, g, hf, hg, rfl⟩
  simp

example {n : ℕ} (f : Schwartz n) : canonicalAction [(1, [])] f = f := by
  simp [canonicalAction, wordAction]

example {n : ℕ} : positiveFrameTrace (0 : CanonicalOperator n) = 0 := by
  simp [positiveFrameTrace]

example {n : ℕ} (f g : Fin 0 → Schwartz n) : finiteSchwartzSum f g = 0 := by
  simp [finiteSchwartzSum]

example {n : ℕ} (x : CanonicalHilbert n) :
    closedPolynomialGraph (.mul (.scalar 2) (.scalar 3)) x ((6 : ℂ) • x) := by
