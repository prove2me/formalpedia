variable (F : Type) [Field F] [NumberField F]

local notation "𝔸" => AdeleRing (𝓞 F) F
local notation "ι" => algebraMap F (AdeleRing (𝓞 F) F)
local notation "ιf" => algebraMap F (FiniteAdeleRing (𝓞 F) F)

section Arithmetic

variable {F}

private theorem adele_fst_add (t t' : 𝔸) : (t + t').1 = t.1 + t'.1 := rfl
private theorem adele_snd_add (t t' : 𝔸) : (t + t').2 = t.2 + t'.2 := rfl
private theorem adele_fst_sub (t t' : 𝔸) : (t - t').1 = t.1 - t'.1 := rfl
private theorem adele_snd_sub (t t' : 𝔸) : (t - t').2 = t.2 - t'.2 := rfl
private theorem adele_fst_zero : (0 : 𝔸).1 = 0 := rfl
private theorem adele_snd_zero : (0 : 𝔸).2 = 0 := rfl
private theorem snd_mkAdele (y : InfiniteAdeleRing F) (u : FiniteAdeleRing (𝓞 F) F) : (mkAdele F y u).2 = u := rfl

private theorem exists_eq_mul_of_forall_valued_le {s : 𝓞 F} (hs : s ≠ 0) {u : FiniteAdeleRing (𝓞 F) F}
    (hu : ∀ v : HeightOneSpectrum (𝓞 F),
      Valued.v (u v) ≤ Valued.v (algebraMap F (v.adicCompletion F) (algebraMap (𝓞 F) F s))) :
    ∃ o ∈ integralFiniteAdeles (𝓞 F) F, u = ιf (s : F) * o := by
  have hsu : IsUnit (ιf (s : F)) := (IsUnit.mk0 (s : F) (by exact_mod_cast hs)).map _
  obtain ⟨w, hw⟩ := hsu
  refine ⟨↑w⁻¹ * u, fun v => ?_, by rw [← mul_assoc, ← hw, Units.mul_inv, one_mul]⟩
  rw [HeightOneSpectrum.mem_adicCompletionIntegers]
  calc Valued.v ((↑w⁻¹ * u) v)
      = Valued.v ((↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) v) * Valued.v (u v) := by
        rw [show (↑w⁻¹ * u) v = (↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) v * u v from rfl, map_mul]
    _ ≤ Valued.v ((↑w⁻¹ : FiniteAdeleRing (𝓞 F) F) v) * Valued.v ((ιf (s : F)) v) := by
        gcongr
        exact hu v
    _ = Valued.v ((↑w⁻¹ * ↑w : FiniteAdeleRing (𝓞 F) F) v) := by
        rw [hw, ← map_mul]; rfl
    _ = 1 := by rw [Units.inv_mul, show (1 : FiniteAdeleRing (𝓞 F) F) v = 1 from rfl, map_one]

private theorem exists_sub_eq_mul {s : 𝓞 F} (hs : s ≠ 0) {u : FiniteAdeleRing (𝓞 F) F} (hu : u ∈ integralFiniteAdeles (𝓞 F) F) :
    ∃ a : 𝓞 F, ∃ o ∈ integralFiniteAdeles (𝓞 F) F, u - ιf (a : F) = ιf (s : F) * o := by
  obtain ⟨a, ha⟩ := exists_forall_valued_sub_le (𝓞 F) F hu hs
  obtain ⟨o, ho, he⟩ := exists_eq_mul_of_forall_valued_le hs (u := u - ιf (a : F)) fun v => ha v
  exact ⟨a, o, ho, he⟩

private theorem exists_sub_eq_mul' {s : 𝓞 F} (hs : s ≠ 0) (u : FiniteAdeleRing (𝓞 F) F) :
    ∃ k : F, ∃ o ∈ integralFiniteAdeles (𝓞 F) F, u - ιf k = ιf (s : F) * o := by
  obtain ⟨k₀, hk₀⟩ := exists_algebraMap_add_mem_integralFiniteAdeles (𝓞 F) F u
  obtain ⟨a, o, ho, he⟩ := exists_sub_eq_mul hs hk₀
  refine ⟨(a : F) - k₀, o, ho, ?_⟩
  rw [← he, map_sub]
  abel

private theorem exists_eq_mul_coe {s : 𝓞 F} (hs : s ≠ 0) {k : F} {o : FiniteAdeleRing (𝓞 F) F}
    (ho : o ∈ integralFiniteAdeles (𝓞 F) F) (h : ιf k = ιf (s : F) * o) : ∃ a : 𝓞 F, k = (a : F) * s := by
  have hs' : (s : F) ≠ 0 := by exact_mod_cast hs
  have hsu : IsUnit (ιf (s : F)) := (IsUnit.mk0 (s : F) hs').map _
  have hk : ιf (k / (s : F)) ∈ integralFiniteAdeles (𝓞 F) F := by
    have e : ιf (k / (s : F)) = o :=
      hsu.mul_right_inj.mp (by rw [← map_mul, mul_comm, div_mul_cancel₀ k hs', h])
    rw [e]
    exact ho
  obtain ⟨a, ha⟩ := exists_coe_eq_of_mem_integralFiniteAdeles F hk
  exact ⟨a, by rw [ha, div_mul_cancel₀ k hs']⟩

end Arithmetic
