/-- The complete outer compatibility potential has a certified upper bound,
with separate boundary classes and coarse-coordinate interior pools. -/
theorem solution :
    (profile 1).compat 1 0 ≤ (1605002989 / 1000000000 : ℝ) := by
  have hx : ∀ a w, 0 ≤ x a w := by decide +kernel
  have h := mme_rational_scaled_mass_entropy_sum_upper_certificate x hx lower upper log_bounds
    1 (by norm_num) (1605002989 / 1000000000) (by decide +kernel)
  have hid : ∀ a w, x a w = actual a w := by
    intro a w
    cases a with
    | inl s => exact mme_released_global_owner1_mode2_compatibility_boundary_mass_rows s w
    | inr j =>
      fin_cases j
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row0 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row1 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row2 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row3 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row4 w
