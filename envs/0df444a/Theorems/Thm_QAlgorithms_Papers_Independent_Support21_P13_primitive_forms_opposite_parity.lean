-- title:
--   Opposite parities of the primitive quadratic forms
-- statement:
--   Let $a_0,a_1,a_2,a_3\in\mathbb Z$ and $x=a_0+a_1\omega+a_2\omega^2+a_3\omega^3$. Define $P=a_0^2+a_1^2+a_2^2+a_3^2$ and $Q=a_0(a_1-a_3)+a_2(a_1+a_3)$. If the $\sqrt2$ dividing exponent of $x$ is zero, then
--
--   $$
--   (P\text{ even}\ \wedge\ Q\text{ odd})\ \vee\ (P\text{ odd}\ \wedge\ Q\text{ even}).
--   $$
--
--   This classifies the parity of the two quadratic forms for primitive cyclotomic numerators.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 20, Proposition 3: opposite parity of P and Q

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Proposition 3, PDF p.20: P and Q have opposite parity in the primitive case. -/
theorem primitive_forms_opposite_parity (a : Fin 4 → ℤ)
    (hprimitive : gde (coordinateValue a) = 0) :
    (Even (formP a) ∧ Odd (formQ a)) ∨
      (Odd (formP a) ∧ Even (formQ a)) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
