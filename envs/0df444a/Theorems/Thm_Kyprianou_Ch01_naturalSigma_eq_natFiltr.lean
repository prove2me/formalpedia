-- title:
--   The Chapter 1 natural filtration coincides with the established generated filtration
-- statement:
--   For every real-valued process on a nonnegative time index and every observation horizon, the natural sigma-algebra of the process defined in Chapter 1 is the established filtration generated by observations through that horizon.
-- source:
--   Kyprianou (2006), Chapter 1, natural filtration for stopping times; original formal definitions and PerfCorrMSQ.natFiltr.

import Mathlib
import Definitions.Def_Kyprianou_Ch01_McKeanBrownianStopping
import Definitions.Def_PerfCorrMSQ_NaturalFiltration
open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch01.naturalSigma_eq_natFiltr
    {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) :
    Kyprianou.Ch01.naturalSigma X t = PerfCorrMSQ.natFiltr X t := by sorry
