  have mF1 : ∀ x ∈ F1, ∃ y, x = r p y := by
    intro x hx; simp only [F1, NLogN.KIL.FR, List.mem_map] at hx; obtain ⟨y, -, rfl⟩ := hx; exact ⟨y, rfl⟩
  have mS2 : ∀ x ∈ S2, ∃ y, x = r p y := by
    intro x hx; simp only [S2, SR, List.mem_map] at hx; obtain ⟨y, -, rfl⟩ := hx; exact ⟨y, rfl⟩
  have bF1 : Bnd w F1.flatten := bL F1 mF1
  have bS2 : Bnd w S2.flatten := bL S2 mS2
  have bF1r : Bnd w F1.reverse.flatten := bL _ (fun x hx => mF1 x (List.mem_reverse.1 hx))
  have bS2r : Bnd w S2.reverse.flatten := bL _ (fun x hx => mS2 x (List.mem_reverse.1 hx))
  have lF1 : F1.length = a + 1 := by simp [F1, NLogN.KIL.FR, a]
  have lS2 : S2.length = Q - (a + 1) := by simp [S2, SR, a]
  have za : zsz (a : ℤ) ≤ Q := le_trans (NLogN.KIL.zsz_nat_le haQ.le) zQ
  have hA : ∀ k : NLogN.KIL.KS, k.q = [(Q : ℤ)] → k.w = (a : ℤ) :: wr →
      a1E.eval (encK s (toF k)) = (F1.length : ℤ) ∧ a1E.ok (encK s (toF k)) ∧
        a1E.cost (encK s (toF k)) ≤ 6000 * (Q + 2) := fun k hq hw' => by
    have hBd : a1E.Bnd (encK s (toF k)) Q := by
      refine ⟨bnd_reg (l := wr) hw' za, ?_, ?_⟩
      · simp only [Ex.Bnd]; exact le_trans (zsz_one_le (by omega)) zQ
      · simp only [Ex.eval]; rw [top_encK (l := wr) hw']
        exact le_trans (by exact_mod_cast NLogN.KIL.zsz_nat_le (show a + 1 ≤ Q by omega)) zQ
    refine ⟨?_, ⟨ok_reg (l := wr) hw', trivial⟩, ?_⟩
    · simp only [a1E, Ex.eval]; rw [top_encK (l := wr) hw', lF1]; push_cast; ring
    · have := Ex.cost_le_lin (encK s (toF k)) Q a1E ⟨trivial, trivial⟩ hBd
      simpa [a1E, Ex.size] using this
  have hB' : ∀ k : NLogN.KIL.KS, k.q = [(Q : ℤ)] → k.w = (a : ℤ) :: wr →
      qa1E.eval (encK s (toF k)) = (S2.length : ℤ) ∧ qa1E.ok (encK s (toF k)) ∧
        qa1E.cost (encK s (toF k)) ≤ 12000 * (Q + 2) := fun k hq hw' => by
    have e1 : (Q : ℤ) + -(a : ℤ) = ((Q - a : ℕ) : ℤ) := by push_cast [haQ.le]; ring
    have e2 : (Q : ℤ) + -(a : ℤ) + -1 = ((Q - (a + 1) : ℕ) : ℤ) := by
      push_cast [show a + 1 ≤ Q by omega]; ring
    have hBd : qa1E.Bnd (encK s (toF k)) Q := by
      refine ⟨⟨bnd_reg (l := []) hq zQ, bnd_reg (l := wr) hw' za, ?_⟩, ?_, ?_⟩
      · simp only [Ex.eval]; rw [top_encK (l := []) hq, top_encK (l := wr) hw', e1]
        exact le_trans (NLogN.KIL.zsz_nat_le (Nat.sub_le _ _)) zQ
      · simp only [Ex.Bnd]; rw [zsz_neg]; exact le_trans (zsz_one_le (by omega)) zQ
      · simp only [Ex.eval]; rw [top_encK (l := []) hq, top_encK (l := wr) hw', e2]
        exact le_trans (NLogN.KIL.zsz_nat_le (Nat.sub_le _ _)) zQ
    refine ⟨?_, ⟨⟨ok_reg (l := []) hq, ok_reg (l := wr) hw'⟩, trivial⟩, ?_⟩
    · simp only [qa1E, Ex.eval]; rw [top_encK (l := []) hq, top_encK (l := wr) hw', lS2, e2]
    · have := Ex.cost_le_lin (encK s (toF k)) Q qa1E ⟨⟨trivial, trivial⟩, trivial⟩ hBd
      simpa [qa1E, Ex.size] using this
  have cA : a1E.Clean := clean_add (clean_reg (by decide)) (clean_lit _)
  have cB : qa1E.Clean :=
    clean_add (clean_add (clean_reg (by decide)) (clean_neg (clean_reg (by decide)))) (clean_lit _)
  set k0' := nSt r P Q B as p [(P : ℤ) - p] with hk0'
  have hw0 : k0'.w = (a : ℤ) :: wr := hw
  obtain ⟨eA, oA, cA0⟩ := hA k0' rfl hw0
  have L1 := FSp.repMv2 (n := a1E) s (toF k0') F1 (S2.flatten ++ rest) B w hF1
    (by simp only [toF_x, k0', nSt]; exact hx) [] rfl rfl cA oA eA bF1
  set s1 : KS := { k0' with x := S2.flatten ++ rest, c := F1.reverse.flatten }
  have E1 : Function.update (Function.update (toF k0') 0 (S2.flatten ++ rest)) 11
      (F1.reverse.flatten ++ toF k0' 11) = toF s1 := by
    rw [show toF k0' 11 = [] from rfl, List.append_nil, upd_x, upd_c]
  rw [E1] at L1
  obtain ⟨eA1, oA1, cA1⟩ := hA s1 rfl hw0
  have hF1r : ∀ x ∈ F1.reverse, x.length = B := fun x hx => hF1 x (List.mem_reverse.1 hx)
  have L2 := FSp.repMv (Ctr := 31) (X := 11) (Y := 12) (C' := 33) (Br := 4) (n := a1E)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s
    (toF s1) F1.reverse [] B w hF1r (by simp [s1]) [] rfl rfl cA oA1
    (by rw [eA1, List.length_reverse]) bF1r
  set s2 : KS := { k0' with x := S2.flatten ++ rest, o := F1.reverse.flatten.reverse ++ o0 }
  have E2 : Function.update (Function.update (toF s1) 11 []) 12
      (F1.reverse.flatten.reverse ++ toF s1 12) = toF s2 := by rw [upd_c, upd_o]; rfl
  rw [E2] at L2
  obtain ⟨eB2, oB2, cB2⟩ := hB' s2 rfl hw0
  have L3 := FSp.repMv2 (n := qa1E) s (toF s2) S2 rest B w hS2 rfl [] rfl rfl cB oB2 eB2 bS2
  set s3 : KS := { s2 with x := rest, c := S2.reverse.flatten }
  have E3 : Function.update (Function.update (toF s2) 0 rest) 11
      (S2.reverse.flatten ++ toF s2 11) = toF s3 := by
    rw [show toF s2 11 = [] from rfl, List.append_nil, upd_x, upd_c]
  rw [E3] at L3
  obtain ⟨eB3, oB3, cB3⟩ := hB' s3 rfl hw0
  have hS2r : ∀ x ∈ S2.reverse, x.length = B := fun x hx => hS2 x (List.mem_reverse.1 hx)
  have L4 := FSp.repMv (Ctr := 31) (X := 11) (Y := 12) (C' := 33) (Br := 4) (n := qa1E)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s
    (toF s3) S2.reverse [] B w hS2r (by simp [s3]) [] rfl rfl cB oB3
    (by rw [eB3, List.length_reverse]) bS2r
  set s4 : KS := { k0' with x := rest, o := S2.reverse.flatten.reverse ++ (F1.reverse.flatten.reverse ++ o0) }
  have E4 : Function.update (Function.update (toF s3) 11 []) 12
      (S2.reverse.flatten.reverse ++ toF s3 12) = toF s4 := by rw [upd_c, upd_o]; rfl
  rw [E4] at L4
  have L5 := Sp.pop (i := 14) s (toF s4) (by decide) (show toF s4 14 = (a : ℤ) :: wr from hw0) za
  have E5 : Function.update (toF s4) 14 wr = toF (nSt r P Q B as (p + 1) [(P : ℤ) - p]) := by
    rw [upd_w]
    congr 1
    simp only [s4, k0', nSt, o0, List.range_succ, List.flatMap_append, List.flatMap_singleton,
      List.reverse_append, refBlk, List.append_assoc, rest, wr]
    rfl
  rw [E5] at L5
  refine (L1.seq (L2.seq (L3.seq (L4.seq (FSp.of_norep rfl L5))))).mono ?_
  rw [List.length_reverse, List.length_reverse, lF1, lS2]
  have c1 := cRep_le_lin (a + 1)
  have c2 := cRep_le_lin (Q - (a + 1))
  have K1 : ∀ m ≤ Q, ∀ c, m * c ≤ Q * c := fun m hm c => Nat.mul_le_mul_right _ hm
  have k1 := K1 (a + 1) (by omega) (2 * cRecF B w)
  have k2 := K1 (Q - (a + 1)) (Nat.sub_le _ _) (2 * cRecF B w)
  have k3 := K1 (a + 1) (by omega) (cRecF B w)
  have k4 := K1 (Q - (a + 1)) (Nat.sub_le _ _) (cRecF B w)
  unfold cNBlkF
  omega

theorem negP_fsp (hr : ∀ p y, (r p y).length = B) (hb : ∀ p y, Bnd w (r p y))
    (has : ∀ p, as p < Q) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P) (Bb : ℕ)
    (hV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb) :
    FSp NLogN.KIL.negP (encK s (toF (rIO (KIL.inR r Q P) ((List.range P).map (fun p => (as p : ℤ))) P Q B)))
      (encK s (toF (rIO (outN r Q as P) [] P Q B))) (cNegF P Q B w Bb) := by
  have hle : ∀ n : ℕ, n ≤ P * (Q * B) → zsz (n : ℤ) ≤ Bb := fun n hn => le_trans (NLogN.KIL.zsz_nat_le hn) hV
  have zP := hle P (Nat.le_mul_of_pos_right _ (Nat.mul_pos hQ1 hB1))
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ hB1) (Nat.le_mul_of_pos_left _ hP1))
  have zB := hle B (le_trans (Nat.le_mul_of_pos_left _ hQ1) (Nat.le_mul_of_pos_left _ hP1))
  have zQB : zsz ((Q : ℤ) * B) ≤ Bb := by
    have := hle (Q * B) (Nat.le_mul_of_pos_left _ hP1); push_cast at this; exact this
  have zV : zsz ((P : ℤ) * ((Q : ℤ) * B)) ≤ Bb := by push_cast at hV; exact hV
  set rin := rIO (KIL.inR r Q P) ((List.range P).map (fun p => (as p : ℤ))) P Q B
  have p1 := Sp.pushQ s (toF rin) (i := 8) (e := .mul (.reg 1) (.mul (.reg 2) (.reg 4))) (B := Bb)
    (by decide) (clean_mul (clean_reg (by decide)) (clean_mul (clean_reg (by decide))
      (clean_reg (by decide))))
    ⟨ok_reg (l := []) rfl, ok_reg (l := []) rfl, ok_reg (l := []) rfl⟩
    ⟨bnd_reg (l := []) rfl zP, ⟨bnd_reg (l := []) rfl zQ, bnd_reg (l := []) rfl zB, by
      simp only [Ex.eval, top_encK', toF_q, toF_B, List.headD_cons, rin, rIO]; exact zQB⟩, by
      simp only [Ex.eval, top_encK', toF_q, toF_B, toF_P, List.headD_cons, rin, rIO]; exact zV⟩
  have e1 : Function.update (toF rin) 8 (Ex.eval (encK s (toF rin))
      (.mul (.reg 1) (.mul (.reg 2) (.reg 4))) :: toF rin 8) = toF (nSt r P Q B as 0 []) := by
    simp only [Ex.eval, top_encK', toF_q, toF_B, toF_P, List.headD_cons, rin, rIO, toF_V, upd_V]
    congr 1
    simp [nSt, KIL.inR, List.range_eq_range']
  rw [e1] at p1
  have hP : (toF (nSt r P Q B as 0 [])) 1 = (P : ℤ) :: [] := rfl
  have hloop := FSp.repReg (C := 30) (r := 1) (b := nBlk) (s := s)
    (F := fun p => toF (nSt r P Q B as p [])) (N := P) (Bb := Bb)
    (c := cNBlkF Q B w) (by decide) (by decide)
    (fun _ => rfl) (by decide) (L := s.G 1) (by simp [hP, ints]) zP (fun p hp => by
      rw [upd_k0, upd_k0]
      exact nBlk_fsp s r P Q B w as hr hb has p hp)
  have hlen := length_outN r P Q B as hr has
  have m1 := FSp.mvK (X := 12) (Y := 0) (C := 33) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (toF (nSt r P Q B as P [])) (.reg 8) (clean_reg (by decide))
    (ok_reg (l := []) rfl) (outN r Q as P).reverse [] (by rw [List.append_nil]; rfl)
    (by rw [eval_reg (l := []) rfl, List.length_reverse, hlen]; push_cast; ring) w
    (NLogN.KIL.bnd_reverse (bnd_flatMap fun p => bnd_refBlk r Q w as hb p))
  rw [upd_o, upd_x] at m1
  have r8 := cost_reg_le (encK s (toF (nSt r P Q B as P []))) 8
  rw [top_encK (l := []) rfl] at r8
  refine FSp.mono (FSp.congr ((FSp.of_norep rfl p1).seq (hloop.seq (m1.seq
    (FSp.of_norep rfl (Sp.pop (i := 8) (l := []) (B := Bb) s _ (by decide) rfl zV))))) ?_) ?_
  · rw [upd_V]
    congr 2
    simp [nSt, rIO, toF_x, outN]
  · rw [List.length_reverse, hlen]
    have c1 := cRep_le_lin (P * (Q * B))
    unfold cLp at *
    simp only [cNegF, Ex.size]
    have zV' : zsz ((P : ℤ) * ((Q : ℤ) * (B : ℤ))) ≤ Bb := zV
    omega

theorem cNegF_le {P Q B w Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    cNegF P Q B w Bb ≤ 10 ^ 6 * (P * (Q * B) + 1) * (w + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  unfold cNegF cNBlkF cRecF
  have hQB : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB1
  have h1 : P * Q ≤ P * (Q * B) := Nat.mul_le_mul_left _ hQB
  have h2 : P * (Q * (B + 1)) ≤ 2 * (P * (Q * B)) := by nlinarith
  have hw : 2 ≤ w + 2 := by omega
  set V := P * (Q * B)
  have e1 : P * (2 * (10000 * (Q + 2) + (1500 * Q + 1200) + Q * (2 * (3000 * (B + 1) * (w + 2)))) +
      2 * (12000 * (Q + 2) + (1500 * Q + 1200) + Q * (3000 * (B + 1) * (w + 2))) + (2 * Q + 2) +
      1100) = 4 * 11000 * (P * Q) + 4 * 22000 * P + 4 * 1500 * (P * Q) + 4 * 1200 * P +
      18000 * (P * (Q * (B + 1))) * (w + 2) + 2 * (P * Q) + 2 * P + 1100 * P := by ring
  have hPV : P ≤ V := le_trans (Nat.le_mul_of_pos_right _ hQ1) h1
  have hB2 : Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  rw [e1]
  have h4 : 18000 * (P * (Q * (B + 1))) * (w + 2) ≤ 36000 * V * (w + 2) := by
    have := Nat.mul_le_mul_right (w + 2) (Nat.mul_le_mul_left 18000 h2); nlinarith
  have h5 : V * (w + 2) ≥ V * 2 := Nat.mul_le_mul_left _ hw
  have h6 : V * (250 * (w + 2)) = 250 * (V * (w + 2)) := by ring
  have e2 : 10 ^ 6 * (V + 1) * (w + 2) = 10 ^ 6 * (V * (w + 2)) + 10 ^ 6 * (w + 2) := by ring
  rw [h6, e2]
  nlinarith

end Proof

