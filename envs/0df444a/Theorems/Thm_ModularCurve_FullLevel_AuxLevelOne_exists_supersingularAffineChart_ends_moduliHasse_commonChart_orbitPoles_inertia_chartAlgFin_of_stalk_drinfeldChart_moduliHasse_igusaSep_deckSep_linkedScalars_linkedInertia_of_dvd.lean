                    (b : ↥B) (hb : τ (b : ↥K) ∈ B),
                    ρ ⟨τ (b : ↥K), hb⟩ = DrinfeldCurve.hAction q (ResidueField A) ⟨_, hmem⟩ (ρ b))) := by sorry
