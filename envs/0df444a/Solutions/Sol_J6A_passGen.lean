lemma supLip_liftL {a b : ℕ} [NeZero a] [NeZero b] (L : (ZMod a → ℂ) →L[ℂ] (ZMod b → ℂ))
    (hL : ‖L‖ ≤ 1) : IntMul.HvdH.SupLip (liftL L) := by
  intro x y δ h j
  have hδ : 0 ≤ δ := le_trans (norm_nonneg _) (h 0)
  set x' : ZMod a → ℂ := fun k => x k.val
  set y' : ZMod a → ℂ := fun k => y k.val
  have hxy : ‖x' - y'‖ ≤ δ :=
    (pi_norm_le_iff_of_nonneg hδ).2 fun k => by simp only [x', y', Pi.sub_apply]; exact h _
  calc ‖L x' (j : ZMod b) - L y' (j : ZMod b)‖ = ‖L (x' - y') (j : ZMod b)‖ := by
        rw [map_sub]; rfl
    _ ≤ ‖L (x' - y')‖ := norm_le_pi_norm _ _
    _ ≤ ‖L‖ * ‖x' - y'‖ := L.le_opNorm _
    _ ≤ 1 * δ := mul_le_mul hL hxy (norm_nonneg _) zero_le_one
    _ = δ := one_mul _

