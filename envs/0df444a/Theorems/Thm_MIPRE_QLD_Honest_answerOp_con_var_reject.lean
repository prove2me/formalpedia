open Matrix Finset MIPRE.Weyl MIPRE.LCS MIPRE.Introspection Classical
open scoped Kronecker
variable {F : Type*} [Field F] [Fintype F] [DecidableEq F] [Algebra (ZMod 2) F]
  {m d : ℕ} [NeZero m]

theorem MIPRE.QLD.Honest.answerOp_con_var_reject (hm : m ∣ Fintype.card F) (ω : Omega F m)
    (c : Fin LCS.MagicSquare.layout.r) (j : Fin LCS.MagicSquare.layout.s)
    (hj : j ∈ LCS.MagicSquare.layout.V c) (a b : Answer F m d)
    (hr : accepts hm (.con c ω) (.var j ω) a b = false) :
    answerOp hm (.con c ω) a * answerOp hm (.var j ω) b = 0 := by sorry
