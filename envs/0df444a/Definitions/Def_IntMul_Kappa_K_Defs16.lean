-- Source module: Solutions.KFLRec
/-!
# KFL §9: records, bad records and their number

* `Geo.recG g` is the record geometry (`B = 1`): record ranks `m < g.recG.V`, bit index `m B + b`.
  `phi_mul`: `phi g F (m B + b) = phi g.recG F m · B + b`; `rixT_flR`: a triple map acts on the
  bit array `flR recs M` record-wise.
* `badR`, the records with a failing guard; `corrR`/`keyR` (the correction and its inverse on
  ranks), `badR_corrR`, `corrR_keyR`, `keyR_corrR`, `corrR_good`.
* `card_badR_le`: `#bad · 2^K ≤ 80 (f-1) M` (from `card_bad_le`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open AModel Butterfly

/-- The record geometry. -/
def Geo.recG (g : Geo) : Geo := { g with B := 1 }

namespace Geo
variable (g : Geo)
@[simp] theorem recG_Q : g.recG.Q = g.Q := rfl
@[simp] theorem recG_N0 : g.recG.N0 = g.N0 := rfl
@[simp] theorem recG_N1 : g.recG.N1 = g.N1 := rfl
@[simp] theorem recG_N2 : g.recG.N2 = g.N2 := rfl
@[simp] theorem recG_N3 : g.recG.N3 = g.N3 := rfl
@[simp] theorem recG_B : g.recG.B = 1 := rfl

end Geo

/-! ## Record arrays -/

/-- The bit array of `M` records. -/
def flR (recs : ℕ → List ℤ) (M : ℕ) : List ℤ := (List.range M).flatMap recs

/-! ## Bad records -/

section Bad

variable {K ρ f : ℕ}

/-- Record `m` is bad. -/
def badR (K ρ f : ℕ) (g : Geo) (m : ℕ) : Prop := ¬ good K ρ f (trOf g.recG m)

/-- The correction on ranks: destination `m` receives source `corrR m`. -/
def corrR (K ρ f : ℕ) (g : Geo) (m : ℕ) : ℕ := phi g.recG (corrc K ρ f) m

/-- The destination of source `m`. -/
def keyR (K ρ f : ℕ) (g : Geo) (m : ℕ) : ℕ := phi g.recG (keyc K ρ f) m

variable {g : Geo} (hg : g.Pos) (hQe : g.Q = 2 ^ (f * K))
include hg hQe

variable (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f)
include hK hρK hf

end Bad
end NLogN.KFL
end

section
-- Source module: Solutions.KFLKey
/-!
# KFL §10: the destination key of a record, in registers

* `segStep`: push `u, v, w, a` on `rU, rV, rW, rA`, run the segment loop, assign a function of
  the accumulator to a target register, pop.  `segStep_fsp` is the generic specification.
* `lineR l`: one packed line (22) on the registers `rX, rY, rZ` (`lineP` on the triple).
* `t0R`: the ideal map `T0` on `rY` (an XOR with `x ∧ selM (f-1)`).
* `keyProg`: from the rank `m` on `rm` push the key `keyR m` on `rK`
  (`x, y, z` by division, the eight lines in `foldr` order, `T0`, and the rank update).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## Expression specifications -/

/-- An expression is executable on `t`, bounded by `Bb` bits and has value `v`. -/
structure ESp (e : Ex HS) (t : IState HS) (Bb : ℕ) (v : ℤ) : Prop where
  clean : e.Clean
  ok : e.ok t
  bnd : e.Bnd t Bb
  ev : e.eval t = v

/-- Reads no register of the segment loop. -/
def NoSeg (e : Ex HS) : Prop := ∀ i ∈ e.regs, i ≠ rA ∧ i ≠ NLogN.KFL.rU ∧ i ≠ rV ∧ i ≠ rW

/-! ## The generic segment step -/

def segStep (K n : ℕ) (w : ℤ) (eu ev ea T : Ex HS) (tgt : Fin HS) (efin : Ex HS) : RS :=
  .seq (.push NLogN.KFL.rU eu) (.seq (.push rV ev) (.seq (.push rW (.lit w)) (.seq (.push rA ea)
  (.seq (segLoop K n T) (.seq (.asg tgt efin) (.seq (.pop rA) (.seq (.pop rW)
  (.seq (.pop rV) (.pop NLogN.KFL.rU)))))))))

def cStep (K n : ℕ) (T : Ex HS) (Bb c : ℕ) : ℕ := cLp n (cSegIt T Bb) Bb + (c + 20) * 10 ^ 7 * (Bb + 2) ^ 2

/-! ## Expression combinators -/

section ESpC

variable {t : IState HS} {Bb : ℕ}

end ESpC

/-! ## Registers of the key computation -/

abbrev rm : Fin HS := 33
abbrev rX : Fin HS := 34
abbrev rY : Fin HS := 35
abbrev rZ : Fin HS := 36
abbrev rK : Fin HS := 37
abbrev rY0 : Fin HS := 38
abbrev rZ0 : Fin HS := 39

/-- The triple `c` on top of `rX, rY, rZ` over the base `H`. -/
def trF (H : Fin HS → List ℤ) (c : Tr) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update H rX ((c.1 : ℤ) :: H rX))
    rY ((c.2.1 : ℤ) :: H rY)) rZ ((c.2.2 : ℤ) :: H rZ)

/-! ## Size facts -/

/-! ## One packed line on the registers -/

def tgtR (l : Line) : Fin HS := if l.tgtY then rY else rZ
def othR (l : Line) : Fin HS := if l.tgtY then rZ else rY

def lineR (K ρ f : ℕ) (l : Line) : RS :=
  segStep K (f - 1) (2 ^ ρ) (.ndiv (.reg rX) (.lit (2 ^ ρ))) (.ndiv (.reg (othR l)) (.lit (2 ^ ρ)))
    (.lit 0) (offE l.b) (tgtR l)
    (.nmod (.add (.add (.reg (tgtR l)) (.lit (2 ^ (f * K)))) (.neg (.mul (.lit l.sgn) (.reg rA))))
      (.lit (2 ^ (f * K))))

def cLine (K f : ℕ) (b : ℤ) (Bb : ℕ) : ℕ := cStep K (f - 1) (offE b) Bb 17

/-! ## The ideal map `T0` on the registers -/

/-- Segment term of `T0`: `[u odd] (1 - 2 [v odd])`. -/
def tf0 (u v : ℤ) : ℤ := (u % 2) * (1 - 2 * (v % 2))

def t0E : Ex HS :=
  .mul (.nmod (.reg NLogN.KFL.rU) (.lit 2)) (.add (.lit 1) (.neg (.mul (.lit 2) (.nmod (.reg rV) (.lit 2)))))

def t0R (K ρ f : ℕ) : RS :=
  segStep K (f - 1) (2 ^ ρ) (.ndiv (.reg rX) (.lit (2 ^ ρ))) (.ndiv (.reg rY) (.lit (2 ^ ρ)))
    (.reg rY) t0E rY (.reg rA)

def cT0 (K f Bb : ℕ) : ℕ := cStep K (f - 1) t0E Bb 8

/-! ## The eight lines -/

def progL (K ρ f : ℕ) : List Line → RS
  | [] => .skip
  | l :: ls => .seq (progL K ρ f ls) (lineR K ρ f l)

/-! ## The key of a rank -/

/-- `(m / S) % Q` from the rank register. -/
def gcE (S Q : ℕ) : Ex HS := .nmod (.ndiv (.reg NLogN.KFL.rm) (.lit (S : ℤ))) (.lit (Q : ℤ))

def keyE (S1 S2 : ℕ) : Ex HS :=
  .add (.reg NLogN.KFL.rm) (.add (.mul (.add (.reg rY) (.neg (.reg rY0))) (.lit (S1 : ℤ)))
    (.mul (.add (.reg rZ) (.neg (.reg rZ0))) (.lit (S2 : ℤ))))

def keyProg (K ρ f : ℕ) (g : Geo) : RS :=
  .seq (.push rY0 (gcE g.S1 g.Q)) (.seq (.push rZ0 (gcE g.S2 g.Q)) (.seq (.push rX (gcE g.S0 g.Q))
  (.seq (.push rY (gcE g.S1 g.Q)) (.seq (.push rZ (gcE g.S2 g.Q)) (.seq (progL K ρ f lines)
  (.seq (t0R K ρ f) (.seq (.push NLogN.KFL.rK (keyE g.S1 g.S2)) (.seq (.pop rX) (.seq (.pop rY)
  (.seq (.pop rZ) (.seq (.pop rY0) (.pop rZ0))))))))))))

def cKey (K f Bb : ℕ) : ℕ := 1 + 8 * cLine K f 0 Bb + cT0 K f Bb + 200 * 10 ^ 7 * (Bb + 2) ^ 2

end NLogN.KFL

end

section
-- Source module: Solutions.KFLSort
/-!
# KFL §11: the list model of the radix sort

Entries are pairs `(key, record)`.  `rpass i` is one stable LSD pass on bit `i`, *ones first*
(this is what two stacks give: the 0-bucket is moved back first, the 1-bucket on top of it);
`rsort A` runs the passes `0, …, A-1`.  `rsort_eq`: with keys below `2^A` and distinct, the
result is the unique list sorted by strictly decreasing key.

`sort_moved`: the entries extracted by the first pass of the correction (the moved records
`κ m ≠ m`, keyed by their destination `κ m`) sort into destination order, i.e. the record of
source `γ d` for every moved destination `d`, in decreasing `d`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

/-- An entry: destination key and record. -/
abbrev Ent := ℕ × List ℤ

def bitP (i : ℕ) (e : Ent) : Bool := decide (e.1 / 2 ^ i % 2 = 1)

/-- One radix pass: the entries with bit `i` set first, both parts in their old order. -/
def rpass (i : ℕ) (E : List Ent) : List Ent := E.filter (bitP i) ++ E.filter (fun e => !bitP i e)

def rsort : ℕ → List Ent → List Ent
  | 0, E => E
  | i + 1, E => rpass i (rsort i E)

/-- Order on the low `i` bits of the keys (decreasing). -/
def RO (i : ℕ) (a b : Ent) : Prop := b.1 % 2 ^ i ≤ a.1 % 2 ^ i

/-! ## The moved records -/

section Moved

variable (κ γ : ℕ → ℕ) (M : ℕ)

/-- The moved ranks below `M`, in decreasing order. -/
def mvL : List ℕ := (List.range M).reverse.filter fun m => decide (κ m ≠ m)

/-- The extracted entries (top first): destination key and the (reversed) record. -/
def ent0 (recs : ℕ → List ℤ) : List Ent := (NLogN.KFL.mvL κ M).map fun m => (κ m, (recs m).reverse)

/-- The sorted entries: for every moved destination `d` (decreasing), the record of `γ d`. -/
def ent1 (recs : ℕ → List ℤ) : List Ent := (NLogN.KFL.mvL κ M).map fun d => (d, (recs (γ d)).reverse)

variable {κ γ M}

end Moved

end NLogN.KFL

end

section
-- Source module: Solutions.KFLCorr1
/-!
# KFL §12: the correction, pass 1 (extraction of the moved records)

The bit array `flR recs M` (record `m` = `recs m`, `B` bits) is on stack `0`, record `0` on top.
For `m = 0, …, M-1` the pass computes the key `κ m = keyR m` (`keyProg`), and moves the record
* to `sKB` (and pushes `κ m` on `sKK`) if `κ m ≠ m` (a *moved* record),
* to `sT` otherwise,
and pushes the flag `[κ m ≠ m]` on `sFL`; `rNB` counts the moved records.
`p1_fsp`: the whole pass, as the list state `P1 … M`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## Stacks and registers of the correction -/

abbrev sT : Fin HS := 16
abbrev sKB : Fin HS := 17
abbrev sKK : Fin HS := 18
abbrev sFL : Fin HS := 19
abbrev sZ0B : Fin HS := 20
abbrev sZ0K : Fin HS := 21
abbrev sZ1B : Fin HS := 22
abbrev sZ1K : Fin HS := 23
abbrev rNB : Fin HS := 40
abbrev cMv : Fin HS := 41
abbrev c1 : Fin HS := 42
abbrev c2 : Fin HS := 43
abbrev c3 : Fin HS := 44
abbrev c4 : Fin HS := 47
abbrev rn0 : Fin HS := 48
abbrev rn1 : Fin HS := 49
abbrev rn0B : Fin HS := 53
abbrev rn1B : Fin HS := 54

/-! ## List helpers -/

/-- The records `F m` of the ranks `m < k` with `p m`, the largest on top. -/
def stkF (p : ℕ → Bool) (F : ℕ → List ℤ) (k : ℕ) : List ℤ :=
  ((List.range k).reverse.filter p).flatMap F

/-- The keys `G m` of the ranks `m < k` with `p m`, the largest on top. -/
def stkK (p : ℕ → Bool) (G : ℕ → ℤ) (k : ℕ) : List ℤ := ((List.range k).reverse.filter p).map G

/-- The rest of the input after `k` records. -/
def restR (recs : ℕ → List ℤ) (M k : ℕ) : List ℤ := ((List.range M).drop k).flatMap recs

/-! ## The pass-1 state -/

section P1

variable (κ : ℕ → ℕ) (recs : ℕ → List ℤ) (M : ℕ)

/-- `κ m ≠ m`: record `m` is moved. -/
def mvP (m : ℕ) : Bool := decide (κ m ≠ m)

def flagV (m : ℕ) : ℤ := if κ m ≠ m then 1 else 0

/-- The flags of the ranks `< k`, the largest on top. -/
def flL (k : ℕ) : List ℤ := (List.range k).reverse.map (flagV κ)

/-- The number of moved ranks `< k`. -/
def nMv (k : ℕ) : ℕ := ((List.range k).filter (mvP κ)).length

/-- The state after `k` records of pass 1. -/
def P1 (G0 : Fin HS → List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
  (Function.update (Function.update G0
    0 (restR recs M k))
    sT (stkF (fun m => !mvP κ m) (fun m => (recs m).reverse) k ++ G0 sT))
    sKB (stkF (mvP κ) (fun m => (recs m).reverse) k ++ G0 sKB))
    sKK (stkK (mvP κ) (fun m => (κ m : ℤ)) k ++ G0 sKK))
    sFL (flL κ k ++ G0 sFL))
    NLogN.KFL.rm ((k : ℤ) :: G0 NLogN.KFL.rm))
    rNB ((nMv κ k : ℤ) :: G0 rNB)

end P1

/-! ## The branches -/

def badB (B : ℕ) : RS :=
  .seq (NLogN.mvK 0 sKB NLogN.KFL.cMv (.lit (B : ℤ))) (.seq (.push sKK (.reg NLogN.KFL.rK))
    (.seq (.push sFL (.lit 1)) (.asg rNB (.add (.reg rNB) (.lit 1)))))

def goodB (B : ℕ) : RS := .seq (NLogN.mvK 0 sT NLogN.KFL.cMv (.lit (B : ℤ))) (.push sFL (.lit 0))

def cBr (B Bb : ℕ) : ℕ := cLp B (250 * (1 + 2)) Bb + 10 ^ 9 * (Bb + 2) ^ 2

/-! ## One record of pass 1 -/

def e1E : Ex HS := .add (.reg NLogN.KFL.rK) (.neg (.reg NLogN.KFL.rm))
def e2E : Ex HS := .add (.reg NLogN.KFL.rm) (.neg (.reg NLogN.KFL.rK))

def brB (B : ℕ) : RS := .ite e1E (badB B) (.ite e2E (badB B) (goodB B))

def p1B (K ρ f : ℕ) (g : Geo) : RS :=
  .seq (keyProg K ρ f g.recG) (.seq (brB g.B) (.seq (.pop NLogN.KFL.rK) (.asg NLogN.KFL.rm (.add (.reg NLogN.KFL.rm) (.lit 1)))))

def cIte (Bb : ℕ) : ℕ := 5 * 2000 * (Bb + 2) + (2 * Bb + 2) + 25

def cP1 (K f B Bb : ℕ) : ℕ := cKey K f Bb + 2 * cIte Bb + cBr B Bb + 10 ^ 4 * (Bb + 2) ^ 2

def p1Prog (K ρ f : ℕ) (g : Geo) : RS := .rep NLogN.KFL.c1 (.lit (g.recG.V : ℤ)) (p1B K ρ f g)

end NLogN.KFL

end

section
-- Source module: Solutions.KFLCorr2
/-!
# KFL §13: the correction, the radix sort on the stacks

The extracted entries `E` (keys on `sKK`, records on `sKB`, entry `0` on top) are sorted by
`A` LSD passes.  A pass pops every entry and pushes it on the bucket of its low key bit
(`sZ0K/sZ0B` or `sZ1K/sZ1B`, the key halved), then moves bucket 0 and then bucket 1 back:
the result is `rpass i E` (`passB_fsp`).  `radix_fsp`: `A` passes give `rsort A E`.
All per-entry work is linear in the word size (`Sp.push`, `Sp.asg` on linear expressions).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## One entry -/

def bucket (ZK ZB n nB : Fin HS) (B : ℕ) : RS :=
  .seq (.push ZK (.quo (.reg sKK) (.lit 2))) (.seq (.pop sKK) (.seq (NLogN.mvK sKB ZB NLogN.KFL.cMv (.lit B))
    (.seq (.asg n (.add (.reg n) (.lit 1))) (.asg nB (.add (.reg nB) (.lit (B : ℤ)))))))

def cBk (B Bb : ℕ) : ℕ := cLp B (250 * (1 + 2)) Bb + 30000 * (Bb + 2)

def condE : Ex HS := .neg (.rem (.reg sKK) (.lit 2))

def entB (B : ℕ) : RS :=
  .ite condE (bucket sZ1K sZ1B rn1 rn1B B) (bucket sZ0K sZ0B rn0 rn0B B)

def cEnt (B Bb : ℕ) : ℕ := cBk B Bb + 2 * 10 ^ 4 * (Bb + 2)

/-- The key part on `sKK` during pass `i`. -/
def kh (i : ℕ) (e : Ent) : ℤ := ((e.1 / 2 ^ i : ℕ) : ℤ)

/-- The pass state: the rest `X` of the entries on `sKK/sKB`, the buckets `Y1, Y0` (last pushed
first) with their counts. -/
def RP (G : Fin HS → List ℤ) (B i : ℕ) (X Y1 Y0 : List Ent) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
  (Function.update (Function.update (Function.update (Function.update (Function.update G
    sKK (X.map (kh i) ++ G sKK))
    sKB (X.flatMap Prod.snd ++ G sKB))
    sZ1K (Y1.map (kh (i + 1)) ++ G sZ1K))
    sZ1B (Y1.flatMap (fun e => e.2.reverse) ++ G sZ1B))
    sZ0K (Y0.map (kh (i + 1)) ++ G sZ0K))
    sZ0B (Y0.flatMap (fun e => e.2.reverse) ++ G sZ0B))
    rn1 ((Y1.length : ℤ) :: G rn1))
    rn1B (((Y1.length * B : ℕ) : ℤ) :: G rn1B))
    rn0 ((Y0.length : ℤ) :: G rn0))
    rn0B (((Y0.length * B : ℕ) : ℤ) :: G rn0B)

/-! ## The entry loop of a pass -/

def Yb (i : ℕ) (E : List Ent) (k : ℕ) (b : Bool) : List Ent :=
  ((E.take k).filter (fun e => bitP i e == b)).reverse

def entLoop (B : ℕ) : RS := .rep c3 (.reg rNB) (entB B)

/-! ## One pass -/

def passB (B : ℕ) : RS :=
  .seq (.push rn0 (.lit 0)) (.seq (.push rn1 (.lit 0)) (.seq (.push rn0B (.lit 0))
  (.seq (.push rn1B (.lit 0)) (.seq (entLoop B)
  (.seq (NLogN.mvK sZ0B sKB NLogN.KFL.cMv (.reg rn0B)) (.seq (NLogN.mvK sZ0K sKK NLogN.KFL.cMv (.reg rn0))
  (.seq (NLogN.mvK sZ1B sKB NLogN.KFL.cMv (.reg rn1B)) (.seq (NLogN.mvK sZ1K sKK NLogN.KFL.cMv (.reg rn1))
  (.seq (.pop rn0) (.seq (.pop rn1) (.seq (.pop rn0B) (.pop rn1B))))))))))))

def cPass (B N Bb : ℕ) : ℕ :=
  cLp N (cEnt B Bb) Bb + 2 * cLp (N * B) (250 * (1 + 2)) Bb + 2 * cLp N (250 * (Bb + 2)) Bb +
    10 ^ 5 * (Bb + 2)

/-! ## The sort -/

def radixProg (B A : ℕ) : RS := .rep c2 (.lit (A : ℤ)) (passB B)

