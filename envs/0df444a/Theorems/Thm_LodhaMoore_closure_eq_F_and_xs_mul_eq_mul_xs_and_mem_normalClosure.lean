theorem closure_eq_F_and_xs_mul_eq_mul_xs_and_mem_normalClosure (g : SeqGroup) (hg : g ∈ F) (s t : Seq)
    (h : FinAct g s t) :
    Subgroup.closure ({xs [], xs [true]} : Set SeqGroup) = F ∧ xs s * g = g * xs t ∧
    ∀ wg ws wt : FreeGroup Bool,
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) wg = g →
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) ws = xs s →
      FreeGroup.lift (fun d : Bool => if d then xs [true] else xs []) wt = xs t →
      FreeGroup.map (fun d : Bool => if d then [true] else []) (ws * wg * (wg * wt)⁻¹) ∈
        Subgroup.normalClosure RX := by
  sorry

end LodhaMoore
