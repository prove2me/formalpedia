      (x y : ↥(ModularCurve.TateModule lam (JZero (N * q)))),
      (y : ℕ → JZero (N * q)) = σ • (x : ℕ → JZero (N * q)) →
        ∀ a : O'', ρM σ (a ⊗ₜ[ℤ_[lam]] x) = a ⊗ₜ[ℤ_[lam]] y)
    (TM : HeckeAlg →+* Module.End O'' (O'' ⊗[ℤ_[lam]] ↥(ModularCurve.TateModule lam (JZero (N * q)))))
    (hT : ∀ (t : HeckeAlg) (a : O'') (x : ↥(ModularCurve.TateModule lam (JZero (N * q)))),
