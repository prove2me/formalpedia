-- title:
--   Proof of Theorem 4.1, case 2, pp. 9–10 — with bounded ρ_k, Λ^k − Λ̂^k → 0 and {Λ^k} is bounded
-- statement:
--   Let $(x^k,\hat\Lambda^k,\rho_k)_{k\in\mathbb N}$ be generated by Algorithm 1 for (NCP), and let $\Lambda^k=\rho_k\Pi_{\mathcal K^\circ}(G(x^k)+\hat\Lambda^k/\rho_k)$ be the multipliers (22). If the penalty parameters $\{\rho_k\}$ are bounded, then
--   $$\Lambda^k-\hat\Lambda^k\to0,$$
--   and the sequence $\{\Lambda^k\}_{k\in\mathbb N}$ is bounded.
--
--   This is the step of the bounded-penalty case used in both Theorem 4.1 and Theorem 4.2.
-- source:
--   Andreani, Gómez, Haeser, Mito & Ramos, On Optimality Conditions for Nonlinear Conic Programming, author's manuscript (revised 2021-04-20; Math. Oper. Res. doi:10.1287/moor.2021.1203), proof of Theorem 4.1, case 2, pp. 9–10, "By Step 4 of Algorithm 1, we see that V^k converges to zero"

import Mathlib
import Definitions.Def_MoreauProx_Decomposition_Cones
import Definitions.Def_NCPSeqOpt_AugLag_Setting

namespace NCPSeqOpt.AugLag

open MoreauProx.Decomposition
open scoped InnerProductSpace
open Filter Topology

theorem proof_4_1_bounded_multipliers {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (G : EuclideanSpace ℝ (Fin n) → E) (hG : ContDiff ℝ 1 G)
    (K : Set E) (hK : IsClosedConvexCone K)
    (ε : ℕ → ℝ) (B : Set E) (τ σ ρ₀ : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n))
    (Λhat : ℕ → E) (ρ : ℕ → ℝ) (hrun : IsALRun f G K ε B τ σ ρ₀ x Λhat ρ)
    (hρ : BddAbove (Set.range ρ)) :
    Tendsto (fun k => mult K G ρ x Λhat k - Λhat k) atTop (𝓝 0) ∧
      Bornology.IsBounded (Set.range (mult K G ρ x Λhat)) := by sorry

end NCPSeqOpt.AugLag
