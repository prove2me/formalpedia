      simp only [T, cf, e2, bitN, pow_one]
      ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide)))
  have e0 : cf (T 0) cCw cDw (marks w ++ LC) LD = s := by
    simp only [T, cf, pow_zero, Nat.div_one, List.range_zero, List.map_nil, List.reverse_nil]
    rw [← hC, ← hD]; simp only [ints]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
