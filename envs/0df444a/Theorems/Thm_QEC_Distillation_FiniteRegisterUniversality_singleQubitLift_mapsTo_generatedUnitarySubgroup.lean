set_option autoImplicit false
noncomputable section
universe u
open QEC
open QEC.Distillation
open QEC.Distillation.FiniteRegisterUniversality
open Semantics Semantics.Qubit
open GeneratedUniversality
open scoped Kronecker
variable {Wire : Type u} [Fintype Wire] [DecidableEq Wire]

theorem QEC.Distillation.FiniteRegisterUniversality.singleQubitLift_mapsTo_generatedUnitarySubgroup
    (generators : Set (UnitaryGate (Fin 2))) (wire : Wire) :
    Set.MapsTo (singleQubitLift wire)
      (generatedUnitarySubgroup generators)
      (generatedUnitarySubgroup (finiteRegisterGenerators (Wire := Wire) generators)) := by sorry
