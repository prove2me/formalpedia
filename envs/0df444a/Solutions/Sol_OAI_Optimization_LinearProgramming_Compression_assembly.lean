    {l : ι → ℝ} {f : ι → ℚ} (hf : ValidMinorAssignment N l f) (u : ι) :
    RAM.ratBits (f u) ≤ 3+2*onlineMinorBitPolynomial.eval N :=
  reply_ratBits_le (hf.1 u).2.1 (hf.1 u).2.2

