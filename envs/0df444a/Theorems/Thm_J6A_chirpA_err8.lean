theorem J6A.chirpA_err8 (P σ W s t α H p ex k : ℕ) (he : 8 * ex ≤ p) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hαp : α ^ 2 ≤ p) (hH : 1 ≤ H) (hW : H + sWidth p α + 3 ≤ W) (hP : 2 ≤ P) (hσP : σ ≤ 2 * P)
    (hσ : Real.exp (Real.pi * (s * (t - s) * H ^ 2 : ℕ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ)) ≤ 2 ^ σ)
    (U : ℕ → ℤ × ℤ) (hU : ∀ i, ‖toC (U i)‖ ≤ 2 ^ p * 2 ^ ex) :
    ‖toC (chirpA P σ W s t α H U k) - 2 ^ p * Sexact s t α (fun i => toC (U i) / 2 ^ p) k‖
      ≤ 2 * W * (6 * 2 ^ (2 * P) * (2 ^ p * 2 ^ ex) / 2 ^ (3 * P - σ)) + 2 := by sorry
