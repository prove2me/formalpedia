-- title:
--   Postnikov generator systems are $\delta$-closed
-- statement:
--   For an $L_\infty$-structure $\delta$: $\tau_{<n}\le\tau_{\le n}\le\tau_{<n+1}$, and the subalgebras generated by $\tau_{\le n}$, $\tau_{<n}$ and $\top$ are closed under $\delta$ on generators: $$\xi\in S_i\implies \delta(\xi)\in A_S\quad(S=\tau_{\le n}L^*,\ \tau_{<n}L^*,\ L^*).$$
--
--   Role: the inclusions and $\delta$-closedness that make the Postnikov pieces sub-DGAs (Definition 5.6).
-- source:
--   Henriques, Integrating L-infinity algebras, Compositio Math. 144 (2008), arXiv:math/0603563v2, https://arxiv.org/abs/math/0603563, proof of Theorem 5.10 (Section 5, pp. 15-17)

import Mathlib
import Definitions.Def_IntLInfty_Kan_CE
import Definitions.Def_IntLInfty_Kan_Forms
import Definitions.Def_IntLInfty_Kan_Manifold
import Definitions.Def_IntLInfty_Kan_Integ

set_option autoImplicit false

open scoped ContDiff

namespace IntLInfty.Kan

theorem postnikov_genAlg_delta_closed (L : ℕ → Type) [∀ i, AddCommGroup (L i)]
    [∀ i, Module ℝ (L i)] [∀ i, FiniteDimensional ℝ (L i)] (δ : LInfty L) :
    (∀ n i, tauLt δ n i ≤ tauLe δ n i) ∧ (∀ n i, tauLe δ n i ≤ tauLt δ (n + 1) i) ∧
    (∀ n i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLe δ n i → δ.δ (gen L i ξ) ∈ genAlg L (tauLe δ n)) ∧
    (∀ n i (ξ : Module.Dual ℝ (L i)), ξ ∈ tauLt δ n i → δ.δ (gen L i ξ) ∈ genAlg L (tauLt δ n)) ∧
    (∀ i (ξ : Module.Dual ℝ (L i)), δ.δ (gen L i ξ) ∈ genAlg L (⊤ : GenSys L)) := by sorry

end IntLInfty.Kan
