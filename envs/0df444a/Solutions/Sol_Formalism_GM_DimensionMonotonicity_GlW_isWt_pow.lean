variable {K V : Type} [Field K] [CharZero K] [AddCommGroup V] [Module K V] {r : ℕ} (G : GlW K V r)
namespace Formalism.GM.DimensionMonotonicity.GlW
theorem _root_.solution {ν : Fin r → ℤ} {x : V} (h : G.IsWt ν x) (a b : Fin r) (k : ℕ) :
    G.IsWt (ν + (k : ℤ) • dl a b) ((G.E a b ^ k) x) := by
  induction k with
  | zero => simpa using h
  | succ k ih =>
    have hE : (G.E a b ^ (k + 1)) x = G.E a b ((G.E a b ^ k) x) := by
      rw [pow_succ', Module.End.mul_apply]
    rw [hE]
    have h2 := G.isWt_E ih a b
    have e : ν + ((k + 1 : ℕ) : ℤ) • dl a b = ν + (k : ℤ) • dl a b + dl a b := by
      push_cast
      rw [add_smul, one_smul, add_assoc]
    rw [e]
    exact h2
end Formalism.GM.DimensionMonotonicity.GlW
