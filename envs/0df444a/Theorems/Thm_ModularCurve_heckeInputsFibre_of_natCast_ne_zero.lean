theorem ModularCurve.heckeInputsFibre_of_natCast_ne_zero (k : Type*) [Field k] (N q : ℕ) [NeZero N] [NeZero q]
    [HasPrincipalDivisors k (charLDegeneracyRoof k N q)] [Fact q.Prime]
    (hqk : (q : k) ≠ 0) :
    HeckeInputsFibre k N q := by sorry
