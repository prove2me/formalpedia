        (∀ i, i₁.base (M₁.placeEquiv.symm (RationalFunctionField.placeOfPoint k (a i : k))).1 ∉
          (pullback.fst (baseChange R c A) s' ⁻¹ᵁ (pullback.fst c (specMap R A) ⁻¹ᵁ U) : (pullback (baseChange R c A) s').Opens)) ∧
        (∀ y : ↥(pullback (baseChange R c A) s'),
          (∀ i, y ≠ i₁.base (M₁.placeEquiv.symm (RationalFunctionField.placeOfPoint k (a i : k))).1) →
            y ∈ (pullback.fst (baseChange R c A) s' ⁻¹ᵁ (pullback.fst c (specMap R A) ⁻¹ᵁ U) : (pullback (baseChange R c A) s').Opens)) ∧
        (∃ W₁ : (pullback (baseChange R c A) s').Opens, (W₁ : Set ↥(pullback (baseChange R c A) s')) = (Set.range i₂.base)ᶜ ∧
