open Fpy
variable {L : Signature} {D : FormatDomain}
variable {X : Set Var}
namespace Fpy
namespace Outcome.Agree
theorem _root_.solution {Y : Set Var} {o o' : Outcome} (h : o.Agree X o') (hXY : X ⊆ Y) :
    o.Agree Y o' := by
  cases o <;> cases o' <;> simp only [Outcome.Agree] at *
  all_goals first | exact h.mono hXY | exact h
end Outcome.Agree
end Fpy
