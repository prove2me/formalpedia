theorem cAK2_le_sol_aux {w2 bk win pk b φ1 φ2 B BH J Z : ℕ} (hw2 : w2 ≤ win) (hbk : bk ≤ win)
    (hJ : jA w2 bk ≤ J) (hZ : zsz ((b * (2 * (w2 + bk)) : ℕ) : ℤ) ≤ Z) :
    cAK2 w2 bk win pk b φ1 φ2 B BH ≤
      10 ^ 13 * (win + 1) * (BH + B + b + pk + 10) + 4 * (win + 1) * φ1 + 8000 * φ2 +
        2 * 10 ^ 6 * (J + 1) * (BkA w2 bk b + 2) + 2000 * (b * (2 * (w2 + bk)) + 1) * (Z + 4) := by
  obtain ⟨X, hX⟩ : ∃ X, X = BH + B + b + pk + 10 := ⟨_, rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y, Y = (win + 1) * X := ⟨_, rfl⟩
  have hB : B + 2 ≤ X := by omega
  have hBH : BH + 2 ≤ X := by omega
  have hbp : b + 0 + pk + 10 ≤ X := by omega
  have hXY : X ≤ Y := by rw [hY]; exact Nat.le_mul_of_pos_left X (by omega)
  have g : ∀ u c : ℕ, u + 1 ≤ c * (win + 1) → ∀ v, v ≤ X → (u + 1) * v ≤ c * Y := by
    intro u c hu v hv
    rw [hY]
    calc (u + 1) * v ≤ (c * (win + 1)) * X := Nat.mul_le_mul hu hv
      _ = c * ((win + 1) * X) := by ring
  have t1 : (w2 + 1) * (400000 * (B + 2)) ≤ 400000 * Y := by
    have := g w2 1 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t1' : (bk + 1) * (400000 * (B + 2)) ≤ 400000 * Y := by
    have := g bk 1 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t2 : ∀ u, u ≤ 2 * win → (u + 1) * 40000 * (B + 2) ≤ 80000 * Y := by
    intro u hu; have := g u 2 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t3 : w2 * (14000 * (B + 2)) ≤ 14000 * Y := by
    have := g w2 1 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t4 : (w2 + bk + w2) * (14000 * (B + 2)) ≤ 42000 * Y := by
    have := g (w2 + bk + w2) 3 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t5 : (2 * (w2 + bk) + 1) * (b + 0 + pk + 10) ≤ 5 * Y := by
    have := g (2 * (w2 + bk)) 5 (by omega) _ hbp; linarith only [this, Nat.zero_le B]
  have t6 : (w2 + bk + 1) * 200000 * (B + 2) ≤ 600000 * Y := by
    have := g (w2 + bk) 3 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have t7 : 4000 * (BH + 2) ≤ 4000 * Y := by omega
  have t8 : 2 * BH + 2 ≤ 2 * Y := by omega
  have t9 : 5000 * (BH + 2) ≤ 5000 * Y := by omega
  have t10 : 2000 * (B + 2) ≤ 2000 * Y := by omega
  have f1 : (w2 + 1) * (2 * φ1) ≤ 2 * (win + 1) * φ1 := by
    have := Nat.mul_le_mul_right φ1 (show w2 + 1 ≤ win + 1 by omega); linarith only [this]
  have f1' : (bk + 1) * (2 * φ1) ≤ 2 * (win + 1) * φ1 := by
    have := Nat.mul_le_mul_right φ1 (show bk + 1 ≤ win + 1 by omega); linarith only [this]
  have m1 := t2 (2 * (win - w2)) (by omega)
  have m2 := t2 (2 * bk) (by omega)
  have m3 := t2 (2 * w2) (by omega)
  have m4 := t2 (2 * (win - bk)) (by omega)
  have m5 := t2 bk (by omega)
  have m6 : (2 * (w2 + bk) + 1) * 40000 * (B + 2) ≤ 200000 * Y := by
    have := g (2 * (w2 + bk)) 5 (by omega) (B + 2) hB; linarith only [this, Nat.zero_le B]
  have hY1 : 1 ≤ Y := by omega
  have hJB : 2 * (2 * BkA w2 bk b + 2) ≤ 10 ^ 6 * (J + 1) * (BkA w2 bk b + 2) := by
    have := Nat.mul_le_mul_right (BkA w2 bk b + 2) (show 4 ≤ 10 ^ 6 * (J + 1) by
      have : 1 ≤ J + 1 := by omega
      calc 4 ≤ 10 ^ 6 * 1 := by norm_num
        _ ≤ 10 ^ 6 * (J + 1) := Nat.mul_le_mul_left _ this)
    linarith only [this]
  have e10 : (10 : ℕ) ^ 13 * (win + 1) * (BH + B + b + pk + 10) = 10 ^ 13 * Y := by
