    (F : Fin n → (I → Bool) → Bool) (hF : NestedFamily F)
    (hr : 0 < r) (Z : Fin n → Fin n → ℕ) (hZ : PairBound F false Z)
    (Ai Aj Gi Gj : Fin n) (hA : Ai ≤ Aj) (hG : Gj ≤ Gi) (hGA : Gi ≤ Ai)
