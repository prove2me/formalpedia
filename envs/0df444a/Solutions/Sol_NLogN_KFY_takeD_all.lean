theorem RSAll.seq {a b : RS} {s t u : IState HS} {Ca Cb : ℕ} (ha : RSAll a s t Ca)
    (hb : RSAll b t u Cb) : RSAll (.seq a b) s u (Ca + Cb) := by
  obtain ⟨o1, r1, c1⟩ := ha
  obtain ⟨o2, r2, c2⟩ := hb
  refine ⟨⟨o1, by rw [r1]; exact o2⟩, by show b.run (a.run s) = u; rw [r1, r2], ?_⟩
  show a.cost s + b.cost (a.run s) ≤ _
  rw [r1]; omega

theorem RSAll.push (r : Fin HS) (e : Ex HS) (s : IState HS) (B : ℕ) (hr : r.val < 56)
    (hc : e.Clean) (hok : e.ok s) (hB : e.Bnd s B) :
    RSAll (.push r e) s (s.upd r (.int (e.eval s) :: s.G r)) ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) :=
  ⟨⟨hr, hc, hok⟩, rfl, RS.pushCost_le e s B hB⟩

end NLogN.KFY

