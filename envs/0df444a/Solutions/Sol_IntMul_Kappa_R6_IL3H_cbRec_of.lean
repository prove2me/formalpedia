theorem PhiH_nonneg {m : ℕ} {Cc D0 θ : ℝ} (hC : 0 ≤ Cc) (hD : 0 ≤ D0) (x : ℕ) :
    0 ≤ PhiH m Cc D0 θ x := by
  unfold PhiH; split_ifs <;> positivity

theorem PhiH_le {m : ℕ} {Cc D0 θ : ℝ} (hC : 0 ≤ Cc) (hD : (10 : ℝ) ^ 14 * (2 * m + 1) ≤ D0)
    (x : ℕ) : PhiH m Cc D0 θ x ≤ Cc * (x : ℝ) ^ θ + D0 := by
  unfold PhiH
  split_ifs with h
  · have : (x : ℝ) + 1 ≤ 2 * m + 1 := by
      have : (x : ℝ) ≤ 2 * m := by exact_mod_cast h.le
      linarith
    have h0 : 0 ≤ Cc * (x : ℝ) ^ θ := by positivity
    nlinarith
  · exact le_rfl

theorem sum_aff {α : Type*} (u v : ℝ) (g : α → ℝ) : ∀ l : List α,
    (l.map fun s => u * g s + v).sum = u * (l.map g).sum + (l.length : ℝ) * v
  | [] => by simp
  | a :: l => by
    simp only [List.map_cons, List.sum_cons, List.length_cons, sum_aff u v g l]
    push_cast; ring

/-- **The closed form satisfies the cost recursion.** -/
theorem cbRec_of_sol_aux {c : Cfg} (hc : CfgOK c) {aK : ℕ → ℝ} {τ θ : ℝ} {K : ℕ} (haK : 0 ≤ aK K)
    (hτ : 0 ≤ τ) (hτθ : τ ≤ θ) (Cc D0 : ℝ) (hCc0 : 0 ≤ Cc)
    (hD0 : D0 = 10 ^ 14 * (2 * c.m + 1))
    (hCc : ((chWs c).length : ℝ) * D0 + 18 * c.Wr * c.net.length * 2 ^ τ + C1H c ≤
      Cc * ((c.W : ℝ) - momH c θ)) :
    CBRec c aK τ K (CBH c.m (aK K + 1) Cc D0 θ) := by
  have hm := hc.m1
  have ha1 : (1 : ℝ) ≤ aK K + 1 := by linarith
  have hD0' : (10 : ℝ) ^ 14 * (2 * c.m + 1) ≤ D0 := le_of_eq hD0.symm
  have hD0p : 0 ≤ D0 := by rw [hD0]; positivity
  have hmR : (1 : ℝ) ≤ c.m := by exact_mod_cast hm
  refine ⟨fun E => mul_nonneg (by linarith) (PhiH_nonneg hCc0 hD0p E), ?_, ?_, ?_⟩
  · -- the empty level
    unfold CBH PhiH
    rw [if_pos (by omega)]
    push_cast
    nlinarith
  · -- the chain levels
    intro E hE1 hE2
    unfold CBH PhiH
    rw [if_pos (by omega), if_pos hE2]
    have : ((E - 1 : ℕ) : ℝ) = (E : ℝ) - 1 := by
      rw [Nat.cast_sub hE1]; simp
    rw [this]
    nlinarith
  · -- the node levels
    intro E hE2
    set a := aK K + 1 with ha
    set F := E / c.m with hFd
    set R := E % c.m with hRd
    set X : ℝ := (E : ℝ) ^ θ with hX
    have hE1 : (1 : ℝ) ≤ E := by exact_mod_cast (show 1 ≤ E by omega)
    have hX1 : 1 ≤ X := Real.one_le_rpow hE1 (by linarith)
    have hF1 : 1 ≤ F := by rw [hFd, Nat.le_div_iff_mul_le (by omega)]; omega
    have hmF : c.m * F ≤ E := Nat.mul_div_le E c.m
    have hRm : R < c.m := Nat.mod_lt E (by omega)
    -- the children
    have hch : ∀ s ∈ chWs c, CBH c.m a Cc D0 θ (s * F) ≤
        a * (Cc * X * ((s : ℝ) / c.m) ^ θ + D0) := by
      intro s hs
      unfold CBH
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      refine (PhiH_le hCc0 hD0' _).trans ?_
      have hsF : ((s * F : ℕ) : ℝ) ≤ ((s : ℝ) / c.m) * E := by
        have : ((c.m * F : ℕ) : ℝ) ≤ E := by exact_mod_cast hmF
        push_cast at this ⊢
        rw [div_mul_eq_mul_div, le_div_iff₀ (by linarith)]
        nlinarith
      have hp : ((s * F : ℕ) : ℝ) ^ θ ≤ (((s : ℝ) / c.m) * E) ^ θ :=
        Real.rpow_le_rpow (by positivity) hsF (by linarith)
      rw [Real.mul_rpow (by positivity) (by positivity)] at hp
      nlinarith [mul_le_mul_of_nonneg_left hp hCc0]
    have hsum : ((chWs c).map fun s => CBH c.m a Cc D0 θ (s * F)).sum ≤
        a * (Cc * X) * momH c θ + ((chWs c).length : ℝ) * (a * D0) := by
      calc ((chWs c).map fun s => CBH c.m a Cc D0 θ (s * F)).sum
          ≤ ((chWs c).map fun s : ℕ => a * (Cc * X) * ((s : ℝ) / c.m) ^ θ + a * D0).sum :=
            List.sum_le_sum (f := fun s => CBH c.m a Cc D0 θ (s * F))
              (g := fun s : ℕ => a * (Cc * X) * ((s : ℝ) / c.m) ^ θ + a * D0)
              (fun s hs => (hch s hs).trans (le_of_eq (by ring)))
        _ = _ := by rw [sum_aff (g := fun s : ℕ => ((s : ℝ) / c.m) ^ θ)]; unfold momH; rfl
    -- the leftover
    have hR : CBH c.m a Cc D0 θ R ≤ a * (10 ^ 14 * c.m) := by
      unfold CBH PhiH
      rw [if_pos (by omega)]
      apply mul_le_mul_of_nonneg_left _ (by linarith)
      have : (R : ℝ) + 1 ≤ c.m := by exact_mod_cast hRm
      linarith
    have hE : CBH c.m a Cc D0 θ E = a * (Cc * X + D0) := by
      unfold CBH PhiH; rw [if_neg (by omega)]
    -- the local terms
    have hG : ((F : ℝ) + 1) ^ τ ≤ 2 ^ τ * X := by
      have h1 : (F : ℝ) + 1 ≤ 2 * E := by
        have : (F : ℝ) ≤ E := by exact_mod_cast (Nat.div_le_self E c.m)
        linarith
      have h2 : ((F : ℝ) + 1) ^ τ ≤ (2 * (E : ℝ)) ^ τ :=
        Real.rpow_le_rpow (by positivity) h1 hτ
      rw [Real.mul_rpow (by norm_num) (by positivity)] at h2
      have h3 : (E : ℝ) ^ τ ≤ X := Real.rpow_le_rpow_of_exponent_le hE1 hτθ
      have h4 : (0 : ℝ) ≤ 2 ^ τ := by positivity
      nlinarith
    have hMH : (0 : ℝ) ≤ (MH c : ℝ) := Nat.cast_nonneg _
    have hCn : (0 : ℝ) ≤ (CnN c : ℝ) := Nat.cast_nonneg _
    have hC1e : C1H c = (c.Wr : ℝ) * ((c.net.length : ℝ) * (MH c : ℝ) + (CnN c : ℝ) + 10 ^ 12) := rfl
    have hL : (0 : ℝ) ≤ c.net.length := Nat.cast_nonneg _
    have hWr : (0 : ℝ) ≤ c.Wr := Nat.cast_nonneg _
    have hW : (1 : ℝ) ≤ c.W := by exact_mod_cast hc.W1
    have hnC : (0 : ℝ) ≤ (chWs c).length := Nat.cast_nonneg _
    have hmom := hCc
    have hG0 : 0 ≤ ((F : ℝ) + 1) ^ τ := by positivity
    have ht20 : (0 : ℝ) ≤ 2 ^ τ := by positivity
    have haK' : aK K ≤ a := by linarith
    have ha0 : 0 ≤ a := by linarith
    rw [hE]
    generalize (MH c : ℝ) = mh at *
    generalize (CnN c : ℝ) = cn at *
    generalize C1H c = C1 at *
    generalize ((F : ℝ) + 1) ^ τ = G at *
    generalize momH c θ = α at *
    generalize ((chWs c).map fun s => CBH c.m a Cc D0 θ (s * F)).sum = SC at *
    generalize CBH c.m a Cc D0 θ R = CR at *
    generalize ((chWs c).length : ℝ) = nC at *
    generalize (c.net.length : ℝ) = L at *
    generalize (c.Wr : ℝ) = Wr at *
    generalize (c.W : ℝ) = W at *
    generalize (2 : ℝ) ^ τ = t2 at *
    generalize (c.m : ℝ) = mR at *
    generalize aK K = b at *
    have hC1 : 0 ≤ C1 := by rw [hC1e]; positivity
    have hX0 : 0 ≤ X := by linarith
    have p1 := mul_le_mul_of_nonneg_left hmom (mul_nonneg ha0 hX0)
    have p2 : 0 ≤ (X - 1) * (a * (nC * D0 + C1)) :=
      mul_nonneg (by linarith) (mul_nonneg ha0 (by positivity))
    have p3 : b * G ≤ a * (t2 * X) := mul_le_mul haK' hG (by linarith) ha0
    have p4 : Wr * L * 18 * (b * G) ≤ Wr * L * 18 * (a * (t2 * X)) :=
      mul_le_mul_of_nonneg_left p3 (by positivity)
    have p5 : C1 ≤ a * C1 := le_mul_of_one_le_left hC1 ha1
    have p6 : W * CR ≤ W * (a * (10 ^ 14 * mR)) := mul_le_mul_of_nonneg_left hR (by linarith)
    have hD : 10 ^ 14 * mR ≤ D0 := by rw [hD0]; linarith
    have p7 : W * (a * (10 ^ 14 * mR)) ≤ W * (a * D0) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hD ha0) (by linarith)
    linarith

