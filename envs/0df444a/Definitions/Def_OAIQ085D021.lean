    (Fin q × (Bool × MachineCloudSelect.Phase)))) × Option Bool

def selectExtraMemory (j v k offset m : Nat)
    (savedLeft savedRight localWork sizeWork : List Bool) :
    SelectExtraTape → List Bool
  | .localIndex => encodeWord j
