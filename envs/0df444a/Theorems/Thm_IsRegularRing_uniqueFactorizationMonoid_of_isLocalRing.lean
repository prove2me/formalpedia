theorem IsRegularRing.uniqueFactorizationMonoid_of_isLocalRing
    (R : Type*) [CommRing R] [IsDomain R] [IsLocalRing R] [IsRegularRing R] :
    UniqueFactorizationMonoid R := by sorry
