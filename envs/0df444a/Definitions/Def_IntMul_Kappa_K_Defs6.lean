/-! ## 0. Per-wire regrouping for pair functions -/

section Chain2

variable {M β : Type*} [AddCommMonoid β]

/-- `F (x₁, s) + F (x₂, x₁) + ⋯ + F (e, xₙ)` (head label first). -/
def chain2 (F : M → M → β) : M → List M → M → β
  | s, [], e => F e s
  | s, x :: xs, e => F x s + chain2 F x xs e

/-- All consecutive pairs `(head, tail)` satisfy `P`. -/
def chainOK (P : M → M → Prop) : M → List M → M → Prop
  | s, [], e => P e s
  | s, x :: xs, e => P x s ∧ chainOK P x xs e

variable {Wr R : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

theorem frameSum2_eq_chain (F : M → M → β) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum2 F gates lab Mout = ∑ w, chain2 F (lab w) (labelsOn w gates) (Mout w) := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum2, labelsOn, chain2]
  | cons g gs ih =>
    intro lab Mout
    rw [frameSum2, ih]
    simp only [labelsOn_cons]
    have e : ∀ x, chain2 F (lab x) (if x ∈ g.2.1 then g.2.2 :: labelsOn x gs else labelsOn x gs)
        (Mout x) = (if x ∈ g.2.1 then F g.2.2 (lab x) else 0) +
          chain2 F (labStep lab g x) (labelsOn x gs) (Mout x) := by
      intro x
      by_cases hx : x ∈ g.2.1 <;> simp [hx, labStep, chain2]
    simp only [e, Finset.sum_add_distrib, Finset.sum_ite_mem, Finset.univ_inter]

theorem framesOK2_iff_chain (P : M → M → Prop) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      FramesOK2 P gates lab Mout ↔ ∀ w, chainOK P (lab w) (labelsOn w gates) (Mout w) := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [FramesOK2, labelsOn, chainOK]
  | cons g gs ih =>
    intro lab Mout
    simp only [FramesOK2, ih, labelsOn_cons]
    constructor
    · rintro ⟨h1, h2⟩ w
      by_cases hw : w ∈ g.2.1
      · simp only [hw, if_true, chainOK]
        refine ⟨h1 w hw, ?_⟩
        have := h2 w
        simpa [labStep, hw] using this
      · simp only [hw, if_false]
        have := h2 w
        simpa [labStep, hw] using this
    · intro h
      refine ⟨fun w hw => ?_, fun w => ?_⟩
      · have := h w
        simp only [hw, if_true, chainOK] at this
        exact this.1
      · have := h w
        by_cases hw : w ∈ g.2.1
        · simp only [hw, if_true, chainOK] at this
          simpa [labStep, hw] using this.2
        · simp only [hw, if_false] at this
          simpa [labStep, hw] using this

end Chain2

/-! ## 1. Names of the gates touching a wire -/

section Gen

variable {N N' R W : Type*} [DecidableEq W]

/-- Names of the gates touching `w`, in order. -/
def namesOn (w : W) (l : List (N × (Matrix W W R × Finset W))) : List N :=
  (l.filter fun g => decide (w ∈ g.2.2)).map Prod.fst

lemma namesOn_append (w : W) (l₁ l₂ : List (N × (Matrix W W R × Finset W))) :
    namesOn w (l₁ ++ l₂) = namesOn w l₁ ++ namesOn w l₂ := by
  simp [namesOn, List.filter_append]

lemma namesOn_reverse (w : W) (l : List (N × (Matrix W W R × Finset W))) :
    namesOn w l.reverse = (namesOn w l).reverse := by
  simp [namesOn, List.filter_reverse, List.map_reverse]

lemma namesOn_flatMap {ι : Type*} (w : W) (L : List ι) (F : ι → List (N × (Matrix W W R × Finset W))) :
    namesOn w (L.flatMap F) = L.flatMap fun i => namesOn w (F i) := by
  induction L with
  | nil => simp [namesOn]
  | cons i L ih => simp only [List.flatMap_cons, namesOn_append, ih]

lemma namesOn_rename (w : W) (f : N → N') (l : List (N × (Matrix W W R × Finset W))) :
    namesOn w (l.map fun g => (f g.1, g.2)) = (namesOn w l).map f := by
  simp [namesOn, List.filter_map, List.map_map, Function.comp_def]

lemma namesOn_single (w : W) (n : N) (g : Matrix W W R × Finset W) :
    namesOn w [(n, g)] = if w ∈ g.2 then [n] else [] := by
  by_cases hw : w ∈ g.2 <;> simp [namesOn, hw]

lemma namesOn_row {T : Type*} [Fintype T] [DecidableEq T] (w : W) (k : Fin 8)
    (g : T → Matrix W W R × Finset W) (o : Option T) (hP : ∀ S, w ∈ (g S).2 ↔ some S = o) :
    namesOn w ((univ : Finset T).toList.map fun S => (((k, some S) : NetScalar.IName T), g S)) =
      o.toList.map fun S => ((k, some S) : NetScalar.IName T) := by
  unfold namesOn
  rw [List.filter_map, List.map_map]
  have : (fun x : T => decide (w ∈ ((fun S => (((k, some S) : NetScalar.IName T), g S)) x).2.2)) =
      fun x => decide (some x = o) := by
    funext x; simp only [hP]
  simp only [Function.comp_def, this]
  cases o with
  | none => simp
  | some t =>
    simp only [Option.some.injEq]
    rw [show (fun x : T => decide (x = t)) = fun x => decide (x = t) from rfl,
      NetProp7.filter_eq_toList t _ (Finset.nodup_toList _)]
    simp

lemma namesOn_invNamed [CommRing R] (w : W) (l : List (N × (Matrix W W R × Finset W))) :
    namesOn w (invNamed l) = (namesOn w l).reverse := by
  unfold invNamed
  rw [namesOn_reverse]
  congr 1
  simp [namesOn, List.filter_map, List.map_map, Function.comp_def, invG]

end Gen

/-! ## 2. One invocation -/

section Invocation

variable {R : Type*} [CommRing R] [Invertible (2 : R)]
variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
variable {W : Type*} [Fintype W] [DecidableEq W] (I : NetComplex.Inv ind W)

lemma mem_sideG (s : R) (w : W) (S : T) :
    w ∈ (I.sideG R s S).2 ↔ w = I.tgt S ∨ ∃ n : Nb ind, n.1.1 = S ∧ I.side n = w := by
  simp [NetComplex.Inv.sideG]

lemma mem_copyG (s : R) (w : W) (t : T) :
    w ∈ (I.copyG R s t).2 ↔ w = I.src t ∨ ∃ n : Nb ind, n.1.2 = t ∧ I.side n = w := by
  simp [NetComplex.Inv.copyG]

lemma mem_scatG (s : R) (w : W) :
    w ∈ (I.scatG R s).2 ↔ (∃ t, I.tgt t = w) ∨ ∃ i, I.cen i = w := by
  simp [NetComplex.Inv.scatG]

lemma mem_gathG (s : R) (w : W) :
    w ∈ (I.gathG R s).2 ↔ (∃ t, I.src t = w) ∨ ∃ i, I.cen i = w := by
  simp [NetComplex.Inv.gathG]

lemma namesOn_named (w : W) (oS oC : Option T) (bS bG : Prop) [Decidable bS] [Decidable bG]
    (hS : ∀ S, w ∈ (I.sideG R 1 S).2 ↔ some S = oS) (hC : ∀ t, w ∈ (I.copyG R 1 t).2 ↔ some t = oC)
    (hsc : w ∈ (I.scatG R 1).2 ↔ bS) (hga : w ∈ (I.gathG R 1).2 ↔ bG) :
    namesOn w (I.named R) =
      (oS.toList.map fun S => ((0, some S) : NetScalar.IName T)) ++
      (if bS then [(1, none)] else []) ++
      (oC.toList.map fun S => ((2, some S) : NetScalar.IName T)) ++
      (if bG then [(3, none)] else []) ++
      (if bS then [(4, none)] else []) ++
      (oS.toList.map fun S => ((5, some S) : NetScalar.IName T)) ++
      (if bG then [(6, none)] else []) ++
      (oC.toList.map fun S => ((7, some S) : NetScalar.IName T)) := by
  have hS' : ∀ s S, w ∈ (I.sideG R s S).2 ↔ some S = oS := fun s S => by
    rw [← hS S]; simp [mem_sideG]
  have hC' : ∀ s t, w ∈ (I.copyG R s t).2 ↔ some t = oC := fun s t => by
    rw [← hC t]; simp [mem_copyG]
  have hsc' : ∀ s, w ∈ (I.scatG R s).2 ↔ bS := fun s => by rw [← hsc]; simp [mem_scatG]
  have hga' : ∀ s, w ∈ (I.gathG R s).2 ↔ bG := fun s => by rw [← hga]; simp [mem_gathG]
  unfold NetComplex.Inv.named
  simp only [namesOn_append, namesOn_single, namesOn_row w _ _ _ (hS' _),
    namesOn_row w _ _ _ (hC' _), hsc', hga']

variable {I} (hG : I.Good)
include hG

lemma names_src (t₀ : T) :
    namesOn (I.src t₀) (I.named R) = [(2, some t₀), (3, none), (6, none), (7, some t₀)] := by
  rw [namesOn_named I _ none (some t₀) False True]
  · simp
  · intro S; simp only [mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨hG.st _ _, fun n _ e => hG.ss _ _ e.symm⟩
  · intro t; simp only [mem_copyG, Option.some.injEq, hG.src_inj.eq_iff]
    constructor
    · rintro (e | ⟨n, -, e⟩)
      · exact e.symm
      · exact absurd e.symm (hG.ss _ _)
    · rintro rfl; exact Or.inl rfl
  · simp only [mem_scatG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.st _ _ e.symm, fun i e => hG.sc _ _ e.symm⟩
  · simp only [mem_gathG, iff_true]; exact Or.inl ⟨t₀, rfl⟩

lemma names_tgt (t₀ : T) :
    namesOn (I.tgt t₀) (I.named R) = [(0, some t₀), (1, none), (4, none), (5, some t₀)] := by
  rw [namesOn_named I _ (some t₀) none True False]
  · simp
  · intro t; simp only [mem_sideG, Option.some.injEq, hG.tgt_inj.eq_iff]
    constructor
    · rintro (e | ⟨n, -, e⟩)
      · exact e.symm
      · exact absurd e.symm (hG.ts _ _)
    · rintro rfl; exact Or.inl rfl
  · intro S; simp only [mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.st _ _ e.symm, fun n _ e => hG.ts _ _ e.symm⟩
  · simp only [mem_scatG, iff_true]; exact Or.inl ⟨t₀, rfl⟩
  · simp only [mem_gathG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.st _ _ e, fun i e => hG.tc _ _ e.symm⟩

lemma names_cen (i₀ : Option (Fin h)) :
    namesOn (I.cen i₀) (I.named R) = [(1, none), (3, none), (4, none), (6, none)] := by
  rw [namesOn_named I _ none none True True]
  · simp
  · intro S; simp only [mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.tc _ _ e.symm, fun n _ e => hG.sic _ _ e⟩
  · intro S; simp only [mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => hG.sc _ _ e.symm, fun n _ e => hG.sic _ _ e⟩
  · simp only [mem_scatG, iff_true]; exact Or.inr ⟨i₀, rfl⟩
  · simp only [mem_gathG, iff_true]; exact Or.inr ⟨i₀, rfl⟩

lemma names_side (n₀ : Nb ind) :
    namesOn (I.side n₀) (I.named R) =
      [(0, some n₀.1.1), (2, some n₀.1.2), (5, some n₀.1.1), (7, some n₀.1.2)] := by
  rw [namesOn_named I _ (some n₀.1.1) (some n₀.1.2) False False]
  · simp
  · intro S; simp only [mem_sideG, Option.some.injEq]
    constructor
    · rintro (e | ⟨n, hn, e⟩)
      · exact absurd e.symm (hG.ts _ _)
      · rw [hG.side_inj e] at hn; exact hn.symm
    · rintro rfl; exact Or.inr ⟨n₀, rfl, rfl⟩
  · intro t; simp only [mem_copyG, Option.some.injEq]
    constructor
    · rintro (e | ⟨n, hn, e⟩)
      · exact absurd e.symm (hG.ss _ _)
      · rw [hG.side_inj e] at hn; exact hn.symm
    · rintro rfl; exact Or.inr ⟨n₀, rfl, rfl⟩
  · simp only [mem_scatG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.ts _ _ e, fun i e => hG.sic _ _ e.symm⟩
  · simp only [mem_gathG, iff_false, not_or, not_exists]
    exact ⟨fun t e => hG.ss _ _ e, fun i e => hG.sic _ _ e.symm⟩

omit hG in
lemma names_none (w : W) (h1 : ∀ t, I.src t ≠ w) (h2 : ∀ t, I.tgt t ≠ w)
    (h3 : ∀ n, I.side n ≠ w) (h4 : ∀ i, I.cen i ≠ w) : namesOn w (I.named R) = [] := by
  rw [namesOn_named I _ none none False False]
  · simp
  · intro S; simp only [mem_sideG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => h2 _ e.symm, fun n _ e => h3 _ e⟩
  · intro S; simp only [mem_copyG, reduceCtorEq, iff_false, not_or, not_exists, not_and]
    exact ⟨fun e => h1 _ e.symm, fun n _ e => h3 _ e⟩
  · simp only [mem_scatG, iff_false, not_or, not_exists]; exact ⟨h2, h4⟩
  · simp only [mem_gathG, iff_false, not_or, not_exists]; exact ⟨h1, h4⟩

end Invocation

/-! ## 3. The complex network -/

section Complex

variable {R : Type*} [CommRing R] [Invertible (2 : R)]
variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}

open NetScalar (emb emb_inj)

/-- The bank of `a` at stage `j` (the two other coordinates). -/
def pj (j : Fin 3) (a : T × T × T) : T × T := ((NetScalar.embEquiv j).symm a).1
/-- The varying (`j`th) coordinate of `a`. -/
def cj (j : Fin 3) (a : T × T × T) : T := ((NetScalar.embEquiv j).symm a).2

lemma emb_eq_iff (j : Fin 3) (p : T × T) (t : T) (a : T × T × T) :
    emb j p t = a ↔ p = pj j a ∧ t = cj j a := by
  rw [show emb j p t = NetScalar.embEquiv j (p, t) from rfl, ← Equiv.eq_symm_apply,
    Prod.ext_iff]
  rfl

lemma emb_pj_cj (j : Fin 3) (a : T × T × T) : emb j (pj j a) (cj j a) = a :=
  (emb_eq_iff j _ _ a).2 ⟨rfl, rfl⟩

variable (R ind)

/-- The named block of invocation `(j, p)` inside `cxNamed`. -/
noncomputable def blkC (j : Fin 3) (p : T × T) : List (GName T × CGate R (Wr ind)) :=
  (schedJ R ind j p).map fun g => ((j, p, g.1), g.2)

variable {R ind}

lemma namesOn_blkC (w : Wr ind) (j : Fin 3) (p : T × T) :
    namesOn w (blkC R ind j p) =
      if j = 1 then ((namesOn w ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R)).map
          fun n => (j, p, n)).reverse
      else (namesOn w ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R)).map fun n => (j, p, n) := by
  unfold blkC schedJ
  split_ifs
  · rw [namesOn_rename w (fun n => ((j, p, n) : GName T)), namesOn_invNamed, List.map_reverse]
  · rw [namesOn_rename w (fun n => ((j, p, n) : GName T))]

lemma namesOn_cxNamed (w : Wr ind) :
    namesOn w (cxNamed R ind) = ([0, 1, 2] : List (Fin 3)).flatMap fun j =>
      (univ : Finset (T × T)).toList.flatMap fun p => namesOn w (blkC R ind j p) := by
  unfold cxNamed
  rw [namesOn_flatMap]
  congr 1
  funext j
  rw [namesOn_flatMap]
  rfl

lemma inv_src (j : Fin 3) (p : T × T) (t : T) :
    (NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).src t = srcW j (emb j p t) := rfl
lemma inv_tgt (j : Fin 3) (p : T × T) (t : T) :
    (NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).tgt t = tgtW j (emb j p t) := rfl
lemma inv_side (j : Fin 3) (p : T × T) (n : Nb ind) :
    (NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).side n = wS j p n := rfl
lemma inv_cen (j : Fin 3) (p : T × T) (i : Option (Fin h)) :
    (NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).cen i = wC j p i := rfl

lemma namesInv_X (j : Fin 3) (p : T × T) (a : T × T × T) :
    namesOn (wX a) ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R) =
      if p = pj j a then
        (if j = 1 then [(0, some (cj j a)), (1, none), (4, none), (5, some (cj j a))]
          else [(2, some (cj j a)), (3, none), (6, none), (7, some (cj j a))])
      else [] := by
  by_cases hp : p = pj j a
  · subst hp
    by_cases hj : j = 1
    · have : (wX a : Wr ind) = (NetComplex.inv j (pj j a) : NetComplex.Inv ind (Wr ind)).tgt (cj j a) := by
        rw [inv_tgt, emb_pj_cj]; simp [tgtW, hj]
      rw [this, names_tgt (inv_good _ _)]; simp [hj]
    · have : (wX a : Wr ind) = (NetComplex.inv j (pj j a) : NetComplex.Inv ind (Wr ind)).src (cj j a) := by
        rw [inv_src, emb_pj_cj]; simp [srcW, hj]
      rw [this, names_src (inv_good _ _)]; simp [hj]
  · rw [if_neg hp]
    apply names_none
    · intro t e
      rw [inv_src] at e
      unfold srcW at e
      split_ifs at e
      · simp [wX, wY] at e
      · simp only [wX, Sum.inl.injEq] at e
        exact hp ((emb_eq_iff j p t a).1 e).1
    · intro t e
      rw [inv_tgt] at e
      unfold tgtW at e
      split_ifs at e
      · simp only [wX, Sum.inl.injEq] at e
        exact hp ((emb_eq_iff j p t a).1 e).1
      · simp [wX, wY] at e
    · intro n e; simp [inv_side, wS, wX] at e
    · intro i e; simp [inv_cen, wC, wX] at e

lemma namesInv_Y (j : Fin 3) (p : T × T) (a : T × T × T) :
    namesOn (wY a) ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R) =
      if p = pj j a then
        (if j = 1 then [(2, some (cj j a)), (3, none), (6, none), (7, some (cj j a))]
          else [(0, some (cj j a)), (1, none), (4, none), (5, some (cj j a))])
      else [] := by
  by_cases hp : p = pj j a
  · subst hp
    by_cases hj : j = 1
    · have : (wY a : Wr ind) = (NetComplex.inv j (pj j a) : NetComplex.Inv ind (Wr ind)).src (cj j a) := by
        rw [inv_src, emb_pj_cj]; simp [srcW, hj]
      rw [this, names_src (inv_good _ _)]; simp [hj]
    · have : (wY a : Wr ind) = (NetComplex.inv j (pj j a) : NetComplex.Inv ind (Wr ind)).tgt (cj j a) := by
        rw [inv_tgt, emb_pj_cj]; simp [tgtW, hj]
      rw [this, names_tgt (inv_good _ _)]; simp [hj]
  · rw [if_neg hp]
    apply names_none
    · intro t e
      rw [inv_src] at e
      unfold srcW at e
      split_ifs at e
      · simp only [wY, Sum.inr.injEq, Sum.inl.injEq] at e
        exact hp ((emb_eq_iff j p t a).1 e).1
      · simp [wX, wY] at e
    · intro t e
      rw [inv_tgt] at e
      unfold tgtW at e
      split_ifs at e
      · simp [wX, wY] at e
      · simp only [wY, Sum.inr.injEq, Sum.inl.injEq] at e
        exact hp ((emb_eq_iff j p t a).1 e).1
    · intro n e; simp [inv_side, wS, wY] at e
    · intro i e; simp [inv_cen, wC, wY] at e

lemma namesInv_S (j j' : Fin 3) (p p' : T × T) (n : Nb ind) :
    namesOn (wS j' p' n) ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R) =
      if j = j' ∧ p = p' then
        [(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)]
      else [] := by
  by_cases hp : j = j' ∧ p = p'
  · obtain ⟨rfl, rfl⟩ := hp
    rw [if_pos ⟨rfl, rfl⟩, ← inv_side j p n, names_side (inv_good _ _)]
  · rw [if_neg hp]
    apply names_none
    · intro t e; rw [inv_src] at e; unfold srcW at e; split_ifs at e <;> simp [wS, wX, wY] at e
    · intro t e; rw [inv_tgt] at e; unfold tgtW at e; split_ifs at e <;> simp [wS, wX, wY] at e
    · intro n' e; simp only [inv_side, wS, Sum.inr.injEq, Sum.inl.injEq, Prod.mk.injEq] at e
      exact hp ⟨e.1, e.2.1⟩
    · intro i e; simp [inv_cen, wC, wS] at e

lemma namesInv_C (j j' : Fin 3) (p p' : T × T) (i : Option (Fin h)) :
    namesOn (wC j' p' i) ((NetComplex.inv j p : NetComplex.Inv ind (Wr ind)).named R) =
      if j = j' ∧ p = p' then [(1, none), (3, none), (4, none), (6, none)] else [] := by
  by_cases hp : j = j' ∧ p = p'
  · obtain ⟨rfl, rfl⟩ := hp
    rw [if_pos ⟨rfl, rfl⟩, ← inv_cen j p i, names_cen (inv_good _ _)]
  · rw [if_neg hp]
    apply names_none
    · intro t e; rw [inv_src] at e; unfold srcW at e; split_ifs at e <;> simp [wC, wX, wY] at e
    · intro t e; rw [inv_tgt] at e; unfold tgtW at e; split_ifs at e <;> simp [wC, wX, wY] at e
    · intro n' e; simp [inv_side, wS, wC] at e
    · intro i' e; simp only [inv_cen, wC, Sum.inr.injEq, Prod.mk.injEq] at e
      exact hp ⟨e.1, e.2.1⟩

theorem names_X (a : T × T × T) :
    namesOn (wX a) (cxNamed R ind) =
      (([(2, some (cj 0 a)), (3, none), (6, none), (7, some (cj 0 a))] :
          List (NetScalar.IName T)).map fun n => ((0 : Fin 3), pj 0 a, n)) ++
      ((([(0, some (cj 1 a)), (1, none), (4, none), (5, some (cj 1 a))] :
          List (NetScalar.IName T)).map fun n => ((1 : Fin 3), pj 1 a, n)).reverse ++
      ((([(2, some (cj 2 a)), (3, none), (6, none), (7, some (cj 2 a))] :
          List (NetScalar.IName T)).map fun n => ((2 : Fin 3), pj 2 a, n)))) := by
  rw [namesOn_cxNamed]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
  have st : ∀ j : Fin 3, ((univ : Finset (T × T)).toList.flatMap fun p =>
      namesOn (wX a) (blkC R ind j p)) = namesOn (wX a) (blkC R ind j (pj j a)) := fun j =>
    NetProp7.flatMap_univ_single _ _ fun p hp => by rw [namesOn_blkC, namesInv_X, if_neg hp]; simp
  rw [st, st, st]
  simp only [namesOn_blkC, namesInv_X, if_true]
  simp

theorem names_Y (a : T × T × T) :
    namesOn (wY a) (cxNamed R ind) =
      (([(0, some (cj 0 a)), (1, none), (4, none), (5, some (cj 0 a))] :
          List (NetScalar.IName T)).map fun n => ((0 : Fin 3), pj 0 a, n)) ++
      ((([(2, some (cj 1 a)), (3, none), (6, none), (7, some (cj 1 a))] :
          List (NetScalar.IName T)).map fun n => ((1 : Fin 3), pj 1 a, n)).reverse ++
      ((([(0, some (cj 2 a)), (1, none), (4, none), (5, some (cj 2 a))] :
          List (NetScalar.IName T)).map fun n => ((2 : Fin 3), pj 2 a, n)))) := by
  rw [namesOn_cxNamed]
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
  have st : ∀ j : Fin 3, ((univ : Finset (T × T)).toList.flatMap fun p =>
      namesOn (wY a) (blkC R ind j p)) = namesOn (wY a) (blkC R ind j (pj j a)) := fun j =>
    NetProp7.flatMap_univ_single _ _ fun p hp => by rw [namesOn_blkC, namesInv_Y, if_neg hp]; simp
  rw [st, st, st]
  simp only [namesOn_blkC, namesInv_Y, if_true]
  simp

lemma stages_single {β : Type*} (F : Fin 3 → List β) (j : Fin 3)
    (hF : ∀ j', j' ≠ j → F j' = []) : ([0, 1, 2] : List (Fin 3)).flatMap F = F j :=
  NetProp7.flatMap_single F j _ (by decide) (by fin_cases j <;> simp) (fun p _ hp => hF p hp)

theorem names_S (j : Fin 3) (p : T × T) (n : Nb ind) :
    namesOn (wS j p n) (cxNamed R ind) =
      if j = 1 then
        (([(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)] :
          List (NetScalar.IName T)).map fun k => (j, p, k)).reverse
      else ([(0, some n.1.1), (2, some n.1.2), (5, some n.1.1), (7, some n.1.2)] :
          List (NetScalar.IName T)).map fun k => (j, p, k) := by
  rw [namesOn_cxNamed, stages_single _ j]
  · rw [NetProp7.flatMap_univ_single _ p]
    · simp only [namesOn_blkC, namesInv_S, and_self, if_true]
    · intro p' hp'
      simp [namesOn_blkC, namesInv_S, hp']
  · intro j' hj'
    apply NetProp7.flatMap_univ_nil
    intro p'
    simp [namesOn_blkC, namesInv_S, hj']

theorem names_C (j : Fin 3) (p : T × T) (i : Option (Fin h)) :
    namesOn (wC j p i) (cxNamed R ind) =
      if j = 1 then
        (([(1, none), (3, none), (4, none), (6, none)] : List (NetScalar.IName T)).map
          fun k => (j, p, k)).reverse
      else ([(1, none), (3, none), (4, none), (6, none)] : List (NetScalar.IName T)).map
          fun k => (j, p, k) := by
  rw [namesOn_cxNamed, stages_single _ j]
  · rw [NetProp7.flatMap_univ_single _ p]
    · simp only [namesOn_blkC, namesInv_C, and_self, if_true]
    · intro p' hp'
      simp [namesOn_blkC, namesInv_C, hp']
  · intro j' hj'
    apply NetProp7.flatMap_univ_nil
    intro p'
    simp [namesOn_blkC, namesInv_C, hj']

/-- Names on the corrected network: the names on `cxNamed`, then the sign gate on `X` wires. -/
theorem namesOn_cxFix (w : Wr ind) :
    namesOn w (cxFixNamed R ind) = (namesOn w (cxNamed R ind)).map some ++
      (match w with | Sum.inl _ => [none] | Sum.inr _ => []) := by
  unfold cxFixNamed
  rw [namesOn_append, namesOn_rename w (some : GName T → Option (GName T)), namesOn_single]
  congr 1
  rcases w with a | b
  · simp [fixG, wX]
  · simp [fixG, wX]

/-- Labels along a wire of a labelled named list. -/
lemma labelsOn_labelled {N M : Type*} [AddGroup M] {W : Type*} [Fintype W] [DecidableEq W]
    (lab : N → M) (w : W) (l : List (N × CGate R W)) :
    labelsOn w (labelled lab l) = (namesOn w l).map lab := by
  induction l with
  | nil => rfl
  | cons g l ih =>
    simp only [labelled, List.map_cons, labelsOn_cons] at ih ⊢
    rw [ih]
    by_cases hw : w ∈ g.2.2 <;> simp [namesOn, hw, List.filter_cons]

end Complex

