import Mathlib
import Definitions.Def_Atlas_Core_Basic
import Definitions.Def_Atlas_Kerr_InDefs
set_option maxHeartbeats 4000000

/-!
# Ingoing Kerr: symmetry, inverse, `C^∞`, Lorentz signature on `domIn a`

The Lorentz frame avoids `Δ` entirely, so it is valid on the horizons `Δ = 0`. With
`ℓ = dv + a sin²θ dφ`, `m = dr + a sin²θ dφ`, the metric is
`−F ℓ² + 2 ℓ m + Σ dθ² + Σ (sin θ dφ)²`, `F = 1 − 2Mr/Σ`; the null block `[[−F, 1], [1, 0]]` is
diagonalised by `(1, (F−1)/2)`, `(1, (F+1)/2)` exactly as for Schwarzschild EF. Pulling back
through the coframe gives the columns of `frameIn`, with `frameInᵀ g frameIn = diag(−1, 1, Σ, Σ)`.
-/

open Real
open scoped ContDiff

namespace ExactVacuumAtlas.Kerr.In

/-- `F = 1 − 2Mr/Σ` at a point. -/
noncomputable def Fk (M a : ℝ) (x : Pt 4) : ℝ := 1 - 2 * M * x 1 / (x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2)

/-- Frame (columns) for the ingoing Kerr metric; no `Δ`, no square roots. -/
noncomputable def frameIn (M a : ℝ) (x : Pt 4) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![1, 1, 0, -(a * sin (x 2));
     (Fk M a x - 1) / 2, (Fk M a x + 1) / 2, 0, -(a * sin (x 2));
     0, 0, 1, 0;
     0, 0, 0, 1 / sin (x 2)]

/-! Generated (inline, ATLAS-B3-01): `C^∞` of every component on `domIn a`. -/

end ExactVacuumAtlas.Kerr.In


