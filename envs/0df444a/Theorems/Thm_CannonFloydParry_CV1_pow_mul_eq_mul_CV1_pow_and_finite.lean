-- title:
--   Lemma 6.8 — $C_n^m\pi = \pi'C_n^{m'}$, and $\langle \Pi(n), C_n\rangle$ is finite
-- statement:
--   In $V_1$: i) if $m, n$ are positive integers with $m < n + 2$ and $\pi \in \Pi(n)$, then $C_n^m\pi = \pi'C_n^{m'}$ for some $\pi' \in \Pi(n)$ and some positive integer $m' < n + 2$; ii) for every positive integer $n$, the subgroup of $V_1$ generated by $\Pi(n)$ and $C_n$ is finite.
--
--   **Formalization Note.** The source's $\mathbf{N}$ in ii) is read as the positive integers, the range on which it defines $\Pi(n)$.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathématique (2) 42 (1996) 215–256, https://doi.org/10.5169/seals-87877, section 6, p. 247, Lemma 6.8

import Mathlib
import Definitions.Def_CannonFloydParry_V

namespace CannonFloydParry

theorem CV1_pow_mul_eq_mul_CV1_pow_and_finite :
    (∀ m n : ℕ, 0 < m → 0 < n → m < n + 2 → ∀ π ∈ PiSub n,
      ∃ π' ∈ PiSub n, ∃ m' : ℕ, 0 < m' ∧ m' < n + 2 ∧ CV1 n ^ m * π = π' * CV1 n ^ m') ∧
      ∀ n : ℕ, 0 < n → Finite (Subgroup.closure (insert (CV1 n) (PiSub n : Set V1))) := by
  sorry

end CannonFloydParry
