theorem PushOK.bounds (B : ℕ) : ∀ (s : IState HS) (l : List (Fin HS × Ex HS))
    (vs : List (Fin HS × ℤ)), PushOK B s l vs → ∀ x ∈ vs, x.1.val < 56 ∧ zsz x.2 ≤ B
