variable {R : Type} [CommRing R] {ι : Type}

private theorem coeff_prod_sum_of_natDegree_le (s : Finset ι) (g : ι → R[X]) (d : ι → ℕ)
    (h : ∀ i ∈ s, (g i).natDegree ≤ d i) :
    (∏ i ∈ s, g i).coeff (∑ i ∈ s, d i) = ∏ i ∈ s, (g i).coeff (d i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih =>
    rw [prod_insert hi, sum_insert hi, prod_insert hi,
      coeff_mul_add_eq_of_natDegree_le (h i (mem_insert_self i s))
        ((natDegree_prod_le s g).trans (sum_le_sum fun j hj => h j (mem_insert_of_mem hj))),
      ih fun j hj => h j (mem_insert_of_mem hj)]

end

section

variable {F : Type} [Field F] [NumberField F]

private theorem norm_localChar_apply_eq_one {ξ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} (hξ : IsUnitaryChar (𝓞 F) F ξ)
    (v : HeightOneSpectrum (𝓞 F)) (t : (v.adicCompletion F)ˣ) : ‖((localChar ξ v t : ℂˣ) : ℂ)‖ = 1 :=
  hξ _

end

