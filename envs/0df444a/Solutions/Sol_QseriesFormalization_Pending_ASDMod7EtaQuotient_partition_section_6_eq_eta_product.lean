private theorem map_theta7SeriesPS_int
    (c : ℤ) (R : Type*) [CommRing R] :
    PowerSeries.map (Int.castRingHom R) (theta7SeriesPS c ℤ) =
      theta7SeriesPS c R := by
  ext n
