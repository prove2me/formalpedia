-- title:
--   Equality of amplitude exponents and primitive norm valuations
-- statement:
--   Let $z,w\in R$ satisfy $|z|^2+|w|^2=1$. Suppose at least one amplitude has a finite smallest denominator exponent at least one. Then both amplitudes have the same finite signed exponent $d$. Define $x=z(\sqrt2)^d$ and $y=w(\sqrt2)^d$. They belong to $\mathbb Z[\omega]$ and
--
--   $$
--   \operatorname{sde}(z)=\operatorname{sde}(w)=d,\qquad
--   \operatorname{gde}(|x|^2)=\operatorname{gde}(|y|^2)\le1.
--   $$
--
--   Here unqualified dividing exponents have base $\sqrt2$ in the cyclotomic integer ring. The numerators are constructed from the amplitudes, providing the primitive norm interface used in denominator reduction.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 9, Lemma 4: equal amplitude exponents and primitive norm valuations

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Lemma 4, PDF p.9: the exponents here belong to amplitudes, not squared
moduli. The primitive numerators are constructed from the common exponent. -/
theorem amplitude_exponents_equal (z w : ℂ)
    (hz : z ∈ synthesisRing) (hw : w ∈ synthesisRing)
    (hstate : Complex.normSq z + Complex.normSq w = 1)
    (hpositive : (∃ d : ℤ, IsSDE z d ∧ 1 ≤ d) ∨
      (∃ d : ℤ, IsSDE w d ∧ 1 ≤ d)) :
    ∃ d : ℤ, IsSDE z d ∧ IsSDE w d ∧
      let x := z * ((Real.sqrt 2 : ℝ) : ℂ) ^ d
      let y := w * ((Real.sqrt 2 : ℝ) : ℂ) ^ d
      x ∈ integralRing ∧ y ∈ integralRing ∧
      gde (normSquared x) = gde (normSquared y) ∧ gde (normSquared x) ≤ 1 := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
