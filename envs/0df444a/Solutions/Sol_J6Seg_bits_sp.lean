theorem zsz_le_one {b : ℤ} (h : b = 0 ∨ b = 1) {B : ℕ} (hB : 1 ≤ B) : zsz b ≤ B := by
  rcases h with rfl | rfl
  · simp [zsz_zero]
  · exact le_trans (by simpa using zsz_natCast_le_self 1) hB

section hdr
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
include hW

/-- The bit loop. -/
theorem bits_sp_sol_aux (s : IState HS) (F : Fin HS → List ℤ) (z sv : List ℤ) (v : Fin 19 → List ℤ)
    (bs : List ℤ) (B : ℕ) (hB : 1 ≤ B) (h01 : ∀ b ∈ bs, b = 0 ∨ b = 1)
    (hd : v 3 = [(bs.length : ℤ)]) (hdB : zsz (bs.length : ℤ) ≤ B) (hbB : bs.length + 1 ≤ B)
    (h4 : v 4 = [0]) (h12 : v 12 = []) (h16 : v 16 = []) :
    Sp (.rep (σ 16) (.reg (σ 3)) (bitB σ dS)) (encK s (SS σ dS F z (bs ++ sv) v))
      (encK s (SS σ dS F z sv (update (update v 12 bs.reverse) 4 [bs.sum])))
      ((1 + 1) * 2000 * (B + 2) + bs.length * (20000 * (B + 2) + 8000 * (B + 2) + 30) + 32) := by
  set N := bs.length with hN
  set Fk : ℕ → Fin HS → List ℤ := fun k =>
    SS σ dS F z (bs.drop k ++ sv) (update (update v 12 (bs.take k).reverse) 4 [(bs.take k).sum])
    with hFk
  have h0 : Fk 0 = SS σ dS F z (bs ++ sv) v := by
    simp only [hFk, List.drop_zero, List.take_zero, List.reverse_nil, List.sum_nil]
    congr 1; rw [← h4, ← h12]; ((funext i; fin_cases i <;> simp [Function.update_apply]))
  have hNN : Fk N = SS σ dS F z sv (update (update v 12 bs.reverse) 4 [bs.sum]) := by
    simp [hFk, hN]
  have hd' : (Ex.reg (σ 3)).eval (encK s (Fk 0)) = N := by
    rw [eval_reg (l := []) (by rw [h0, SS_at hW, hd])]
  have H := Sp.rep (C := σ 16) (n := .reg (σ 3)) (b := bitB σ dS) (s := s) (F := Fk) (N := N)
    (B := B) (c := 20000 * (B + 2)) (hW.lt 16)
    (fun k => by simp only [hFk, SS_at hW]; simp [Function.update_apply, h16])
    (by simp (config := { decide := true }) [bitB, RS.writes, hW.inj.eq_iff, hW.neS 16])
    (clean_reg (hW.lt 3)) (ok_reg (l := []) (by rw [h0, SS_at hW, hd]))
    trivial (bnd_reg (l := []) (by rw [h0, SS_at hW, hd]) hdB) hd' (by
      intro k hk
      have hb := List.drop_eq_getElem_cons hk
      set b := bs[k] with hbdef
      have hb01 := h01 b (List.getElem_mem hk)
      have hbz : zsz b ≤ B := zsz_le_one hb01 hB
      set w := update (update (update v 12 (bs.take k).reverse) 4 [(bs.take k).sum]) 16
        [(N : ℤ) - k] with hw
      have e1 : update (Fk k) (σ 16) [(N : ℤ) - k] = SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w
        := by rw [hFk]; simp only []; rw [SS_v hW, hb, List.cons_append]
      rw [e1]
      have hS : SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w dS = b :: (bs.drop (k + 1) ++ sv) :=
        SS_atS hW ..
      have S1 := Sp.push s (SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w) (i := σ 12)
        (e := .reg dS) (B := B) (hW.lt 12) (clean_reg hW.Slt) (ok_reg hS) trivial (bnd_reg hS hbz)
      rw [eval_reg hS, SS_at hW, SS_v hW] at S1
      set w1 := update w 12 (b :: w 12) with hw1
      have h4' : SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w1 (σ 4) = [(bs.take k).sum] := by
        rw [SS_at hW, hw1, hw]; simp [Function.update_apply]
      have hS' : SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w1 dS = b :: (bs.drop (k + 1) ++ sv) :=
        SS_atS hW ..
      have hsum : (bs.take (k + 1)).sum = (bs.take k).sum + b := by
        rw [List.take_succ_eq_append_getElem hk, List.sum_append]; simp [hbdef]
      have hsB : zsz ((bs.take k).sum) ≤ B := by
        have : (bs.take k).sum = (((bs.take k).sum).toNat : ℤ) := by
          have : 0 ≤ (bs.take k).sum := List.sum_nonneg (fun x hx => by
            rcases h01 x (List.mem_of_mem_take hx) with rfl | rfl <;> norm_num)
          omega
        rw [this]
        refine le_trans (zsz_natCast_le_self _) ?_
        have : (bs.take k).sum ≤ ((bs.take k).length : ℤ) := by
          have := List.sum_le_card_nsmul (bs.take k) 1 (fun x hx => by
            rcases h01 x (List.mem_of_mem_take hx) with rfl | rfl <;> norm_num)
          simpa using this
        have : (bs.take k).length ≤ N := by rw [List.length_take, hN]; exact Nat.min_le_right _ _
        omega
      have hs1B : zsz ((bs.take k).sum + b) ≤ B := by
        rw [← hsum]
        have : (bs.take (k + 1)).sum = (((bs.take (k + 1)).sum).toNat : ℤ) := by
          have : 0 ≤ (bs.take (k + 1)).sum := List.sum_nonneg (fun x hx => by
            rcases h01 x (List.mem_of_mem_take hx) with rfl | rfl <;> norm_num)
          omega
        rw [this]
        refine le_trans (zsz_natCast_le_self _) ?_
        have : (bs.take (k + 1)).sum ≤ ((bs.take (k + 1)).length : ℤ) := by
          have := List.sum_le_card_nsmul (bs.take (k + 1)) 1 (fun x hx => by
            rcases h01 x (List.mem_of_mem_take hx) with rfl | rfl <;> norm_num)
          simpa using this
        have : (bs.take (k + 1)).length ≤ N := by
          rw [List.length_take, hN]; exact Nat.min_le_right _ _
        omega
      have S2 := Sp.asg s (SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w1) (i := σ 4)
        (e := .add (.reg (σ 4)) (.reg dS)) (a := (bs.take k).sum) (l := []) (B := B) (hW.lt 4)
        h4' hsB (clean_add (clean_reg (hW.lt 4)) (clean_reg hW.Slt)) ⟨ok_reg h4', ok_reg hS'⟩
        ⟨trivial, trivial⟩ ⟨bnd_reg h4' hsB, bnd_reg hS' hbz, by
          rw [eval_reg h4', eval_reg hS']; exact hs1B⟩
      rw [Ex.eval, Ex.eval, top_encK h4', eval_reg hS', SS_v hW] at S2
      set w2 := update w1 4 [(bs.take k).sum + b] with hw2
      have S3 := Sp.pop s (SS σ dS F z (b :: (bs.drop (k + 1) ++ sv)) w2) (i := dS) (a := b)
        (l := bs.drop (k + 1) ++ sv) (B := B) hW.Slt (SS_atS hW ..) hbz
      rw [SS_ds hW] at S3
      have e2 : SS σ dS F z (bs.drop (k + 1) ++ sv) w2 = update (Fk (k + 1)) (σ 16) [(N : ℤ) - k]
        := by
        rw [hFk]; simp only []; rw [SS_v hW]
        congr 1
        rw [hw2, hw1, hw, hsum, List.take_succ_eq_append_getElem hk]
        simp only [List.reverse_append, List.reverse_cons, List.reverse_nil,
          List.nil_append, List.singleton_append, ← hbdef]
        have : update v 12 (bs.take k).reverse 12 = (bs.take k).reverse := by simp
        ((funext i; fin_cases i <;> simp [Function.update_apply]))
      rw [e2] at S3
      refine (S1.seq (S2.seq S3)).mono ?_
      simp only [Ex.size]; ring_nf; omega)
  rw [h0, hNN] at H
  simpa only [Ex.size] using H

end hdr

