theorem OAI.CompletedGauss.completed_outer_row_sum_bound (S : Finset (Ideal O)) (Q : Ideal O) (hQ : Q≠0)
    (f : Ideal O→ℝ) (C : ℝ) (hC : 0≤C)
    (hblocks : ∀A∈S.image rowPowerfulPart,∀T∈S.image (fun I => rowMaskPart I Q),
      (∑I∈completedRowFiber S Q A T,f I)≤C/(Ideal.absNorm A:ℝ)) :
    (∑I∈S,f I)≤1048576*((idealDivisors Q).card:ℝ)*C := by sorry
