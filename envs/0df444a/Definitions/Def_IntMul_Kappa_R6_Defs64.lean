-- Source module: Solutions.J6SegKr2
/-!
# B3 (chunk kernel), part 2: register loops on managed states

Counted register loops (`RS.rep` with the count on top of a register) on `encK` states:

* `mvP X Y T C R`: move `n` Gaussian pairs from `X` to `Y`, keeping each pair's orientation
  (`gflat z ++ lx` on `X` ↦ `gflat z.reverse` on top of `Y`);
* `rdP V O C R`: round pairs (`rs P` on both parts) from a reversed flat list on `V` to `O`
  (`gsw u ++ lv` ↦ `gflat ((u.reverse).map rsG)` on top of `O`);
* `rgP A Y C R`: a real table as Gaussian pairs (`a ++ la` on `A` ↦ `gflat (a.reverse.map (·, 0))`
  on top of `Y`);
* `zeroR`, `dropR`, `dupR`: push zeros, drop, duplicate-move with a register count.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB

/-! ## Flat lists -/

/-- Pairs flattened with the parts swapped. -/
def gsw (u : List GI) : List ℤ := u.flatMap fun z => [z.2, z.1]

@[simp] lemma gsw_nil : gsw [] = [] := rfl
@[simp] lemma gsw_cons (z : GI) (u : List GI) : gsw (z :: u) = z.2 :: z.1 :: gsw u := rfl

@[simp] lemma length_gsw (u : List GI) : (gsw u).length = 2 * u.length := by
  induction u with
  | nil => rfl
  | cons z u ih => simp [ih]; ring

/-! ## Single steps -/

/-! ## Moving pairs -/

/-- One pair from `X` to `Y` (through `T`). -/
def mvPB (X Y T : Fin HS) : RS :=
  .seq (.push T (.reg X)) (.seq (.pop X) (.seq (.push Y (.reg X)) (.seq (.pop X)
    (.seq (.push Y (.reg T)) (.pop T)))))

/-- `n` pairs from `X` to `Y` (count on `R`, loop counter `C`). -/
def mvP (X Y T C R : Fin HS) : RS := .rep C (.reg R) (mvPB X Y T)

/-- Cost of `mvP`. -/
def cMvP (n B : ℕ) : ℕ := (n + 1) * 40000 * (B + 2)

/-! ## Zeros, drops, duplicating moves -/

/-- Push `n` zeros on `Y`. -/
def zeroR (Y C R : Fin HS) : RS := .rep C (.reg R) (.push Y (.lit 0))

/-- Drop `n` integers from `X`. -/
def dropR (X C R : Fin HS) : RS := .rep C (.reg R) (.pop X)

/-- Move `n` integers from `X` to both `Y` and `Z` (each reversed). -/
def dupR (X Y Z C R : Fin HS) : RS :=
  .rep C (.reg R) (.seq (.push Y (.reg X)) (.seq (.push Z (.reg X)) (.pop X)))

/-- A real list `a` (reversed on `A`) as Gaussian pairs `(a_i, 0)` on top of `Y`. -/
def rgP (A Y C R : Fin HS) : RS :=
  .rep C (.reg R) (.seq (.push Y (.lit 0)) (.seq (.push Y (.reg A)) (.pop A)))

/-! ## Rounding pairs -/

/-- `2^P`. -/
abbrev rP : Fin HS := 31
/-- `2^{P+1}`. -/
abbrev rP1 : Fin HS := 32

/-- `rs P (top V)`: `⌊(2x + 2^P) / 2^{P+1}⌋` by `tdiv`/`tmod` and a sign test. -/
def rsE (V : Fin HS) : Ex HS :=
  .add (.quo (.add (.add (.reg V) (.reg V)) (.reg rP)) (.reg rP1))
    (.sel (.rem (.add (.add (.reg V) (.reg V)) (.reg rP)) (.reg rP1)) (.lit (-1)) (.lit 0))

/-- Pairs of `rs P` values. -/
def rsG (P : ℕ) (w : GI) : GI := (J6Seg.rs P w.1, J6Seg.rs P w.2)

/-- Round the pairs of a swapped flat list `gsw u` from `V` onto `O`. -/
def rdP (V O C R : Fin HS) : RS :=
  .rep C (.reg R) (.seq (.push O (rsE V)) (.seq (.pop V) (.seq (.push O (rsE V)) (.pop V))))

end J6Seg.KR

end

