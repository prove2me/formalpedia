private theorem finprod_stdRootNumberAt_twist_eq_prod_mul_prod (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (hμu : IsUnitaryChar (𝓞 K) K μ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ)
    (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hST : S ⊆ T) (hχT : ∀ v ∉ T, IsUnramifiedCharAt χ v)
    (aT : HeightOneSpectrum (𝓞 ℚ) → ℕ) (haT : ∀ v ∈ T \ S, HasConductorExponentAt ℚ v (localChar χ v) (aT v)) :
    ∏ᶠ 𝔓 : HeightOneSpectrum (𝓞 K), stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓)
      = (∏ v ∈ S, ∏ᶠ 𝔓 ∈ primeFibre ℚ K v,
            stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓))
        * ∏ v ∈ T \ S, inducedE3 ℚ (inducedCoeff K μ) v ^ aT v * stdRootNumberAt ℚ v (localChar χ v) ^ 3 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hoff : ∀ 𝔓 : HeightOneSpectrum (𝓞 K), 𝔓.under (𝓞 ℚ) ∉ T →
      stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) = 1 := by
    intro 𝔓 hvT
    have hnb : ¬ IsBadPlace K μ (𝔓.under (𝓞 ℚ)) := fun hb => hvT (hST ((hS _).mpr hb))
    have hmem : 𝔓 ∈ primeFibre ℚ K (𝔓.under (𝓞 ℚ)) := rfl
    have he : ∀ 𝔔 ∈ primeFibre ℚ K (𝔓.under (𝓞 ℚ)), (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔔.asIdeal = 1 :=
      fun 𝔔 h𝔔 => by
        by_contra hne
        exact hnb (Or.inl ⟨𝔔, h𝔔, hne⟩)
    have hμ𝔓 : IsUnramifiedCharAt μ 𝔓 := by
      by_contra h
      exact hnb (Or.inr ⟨𝔓, hmem, h⟩)
    have ha0 := LanglandsTunnell.Converse.hasConductorExponentAt_localChar_zero_of_isUnramifiedCharAt ℚ χ _
      (hχT _ hvT)
    have hχ1 : stdRootNumberAt ℚ (𝔓.under (𝓞 ℚ)) (localChar χ (𝔓.under (𝓞 ℚ))) = 1 :=
      stdRootNumberAt_eq_one_of_hasConductorExponentAt_zero ℚ _ _ ha0
        (TwistFibre.norm_localChar_apply_eq_one hχu _ _) (addCharLevel_psiLocal_rat _) (psiLocal_ne_one ℚ _)
    rw [TwistFibre.stdRootNumberAt_twist_eq K μ χ _ 𝔓 rfl (he 𝔓 hmem)
      (TwistFibre.inertiaDeg_le_three_of_mem K hdeg _ he 𝔓 hmem)
      (FibreDegree.inertiaDeg_pos_of_mem_primeFibre K _ 𝔓 hmem) hμ𝔓 hμu hχu 0 ha0, hχ1]
    simp
  have hfs : Function.HasFiniteMulSupport
      (fun 𝔓 : HeightOneSpectrum (𝓞 K) =>
        stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓)) := by
    refine (T.finite_toSet.biUnion fun v _ => FibreDegree.primeFibre_finite K v).subset ?_
    intro 𝔓 h𝔓
    refine Set.mem_biUnion (x := 𝔓.under (𝓞 ℚ)) ?_ rfl
    by_contra hvT
    exact h𝔓 (hoff 𝔓 (by simpa using hvT))
  rw [FibreRegroup.finprod_eq_finprod_finprod_primeFibre ℚ K _ hfs]
  have hsub : Function.mulSupport
      (fun v : HeightOneSpectrum (𝓞 ℚ) => ∏ᶠ 𝔓 ∈ primeFibre ℚ K v,
        stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓)) ⊆ ↑T := by
    intro v hv
    by_contra hvT
    apply hv
    refine finprod_mem_of_eqOn_one fun 𝔓 h𝔓 => hoff 𝔓 ?_
    rw [show 𝔓.under (𝓞 ℚ) = v from h𝔓]
    simpa using hvT
  rw [finprod_eq_prod_of_mulSupport_subset _ hsub, ← Finset.prod_sdiff hST, mul_comm]
  congr 1
  exact Finset.prod_congr rfl fun v hv =>
    TwistFibre.prod_stdRootNumberAt_twist_of_not_isBadPlace K μ χ hdeg v
      (fun hb => (Finset.mem_sdiff.mp hv).2 ((hS v).mpr hb)) hμu hχu (aT v) (haT v hv)

private theorem pinnedExp_mul_comp_idelicNorm_eq_of_isUnramifiedCharAt_under (K : Type) [Field K] [NumberField K]
    [i : Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (𝔓 : HeightOneSpectrum (𝓞 K)) (hχ : IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ))) :
    LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      LanglandsTunnell.Converse.pinnedExp K μ 𝔓 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K i
  have hloc := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
  have h0 := hasConductorExponentAt_comp_norm_zero ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ (localChar χ (𝔓.under (𝓞 ℚ)))
    (LanglandsTunnell.Converse.hasConductorExponentAt_localChar_zero_of_isUnramifiedCharAt ℚ χ _ hχ)
  have hinv : ∀ B : (𝔓.adicCompletion K)ˣ →* ℂˣ, HasConductorExponentAt K 𝔓 B 0 →
      HasConductorExponentAt K 𝔓 B⁻¹ 0 := by
    intro B hB
    rw [hasConductorExponentAt_zero_iff] at hB ⊢
    intro u hu
    rw [MonoidHom.inv_apply, hB u hu, inv_one]
  have hset : {c : ℕ | HasConductorExponentAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) c} =
      {c : ℕ | HasConductorExponentAt K 𝔓 (localChar μ 𝔓) c} := by
    ext c
    constructor
    · intro hc
      rw [hloc] at hc
      have key : ∀ A X : (𝔓.adicCompletion K)ˣ →* ℂˣ, HasConductorExponentAt K 𝔓 (A * X) c →
          HasConductorExponentAt K 𝔓 X 0 → HasConductorExponentAt K 𝔓 A c := by
        intro A X hAX hX
        exact (congrArg (fun φ : (𝔓.adicCompletion K)ˣ →* ℂˣ => HasConductorExponentAt K 𝔓 φ c)
          (mul_inv_cancel_right A X)).mp
          (hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K 𝔓 _ _ c hAX (hinv X hX))
      exact key _ _ hc h0
    · intro hc
      rw [hloc]
      exact hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K 𝔓 _ _ c hc h0
  simp only [LanglandsTunnell.Converse.pinnedExp, conductorExponentAt, hset]

private theorem finprod_primeFibre_absNorm_pow_pinnedExp_twist_eq (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) :
    ∏ᶠ 𝔓 ∈ primeFibre ℚ K v, (Ideal.absNorm 𝔓.asIdeal : ℝ) ^
        LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      (Ideal.absNorm v.asIdeal : ℝ) ^ ∑ᶠ 𝔓 ∈ primeFibre ℚ K v, (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) *
        LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hq : (Ideal.absNorm v.asIdeal : ℝ) ≠ 0 := by
    rw [Ne, Nat.cast_eq_zero, Ideal.absNorm_eq_zero_iff]
    exact v.ne_bot
  have hpow : ∀ s : Finset (HeightOneSpectrum (𝓞 K)), ∀ g : HeightOneSpectrum (𝓞 K) → ℤ,
      ∏ 𝔓 ∈ s, (Ideal.absNorm v.asIdeal : ℝ) ^ g 𝔓 = (Ideal.absNorm v.asIdeal : ℝ) ^ ∑ 𝔓 ∈ s, g 𝔓 := by
    intro s g
    induction s using Finset.induction_on with
    | empty => rw [Finset.prod_empty, Finset.sum_empty, zpow_zero]
    | insert 𝔓 s h𝔓 ih => rw [Finset.prod_insert h𝔓, Finset.sum_insert h𝔓, zpow_add₀ hq, ih]
  have hnorm : ∀ 𝔓 ∈ primeFibre ℚ K v, (Ideal.absNorm 𝔓.asIdeal : ℝ) = (Ideal.absNorm v.asIdeal : ℝ) ^
      (v.asIdeal.inertiaDeg' 𝔓.asIdeal : ℤ) := by
    intro 𝔓 h𝔓
    obtain rfl : 𝔓.under (𝓞 ℚ) = v := h𝔓
    haveI : 𝔓.asIdeal.LiesOver (𝔓.under (𝓞 ℚ)).asIdeal := ⟨rfl⟩
    rw [zpow_natCast, ← Nat.cast_pow, Ideal.absNorm_eq_pow_inertiaDeg_of_liesOver 𝔓.asIdeal _
      (𝔓.under (𝓞 ℚ)).isPrime (𝔓.under (𝓞 ℚ)).ne_bot]
  rw [finprod_mem_eq_finite_toFinset_prod _ (FibreDegree.primeFibre_finite K v),
    finsum_mem_eq_finite_toFinset_sum _ (FibreDegree.primeFibre_finite K v), ← hpow]
  refine Finset.prod_congr rfl fun 𝔓 h𝔓 => ?_
  rw [hnorm 𝔓 ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓), ← zpow_mul]

private theorem heckeConductor_twist_eq_prod_mul_prod (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hST : S ⊆ T) (hχT : ∀ v ∉ T, IsUnramifiedCharAt χ v)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v)
    (aS bS : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ) (hH5 : ∀ v ∈ S, ∀ i, aS v i = bS v i)
    (hsum : ∀ v ∈ S, (∑ i, (bS v i : ℤ)) =
      ∑ᶠ w ∈ primeFibre ℚ K v, (v.asIdeal.inertiaDeg' w.asIdeal : ℤ) * LanglandsTunnell.Converse.pinnedExp K μ w)
    (aT : HeightOneSpectrum (𝓞 ℚ) → ℕ) (haT : ∀ v ∈ T \ S, HasConductorExponentAt ℚ v (localChar χ v) (aT v)) :
    LanglandsTunnell.HeckeTate.heckeConductor K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)
      = (∏ v ∈ S, (Ideal.absNorm v.asIdeal : ℝ) ^ (∑ i, aS v i))
        * ∏ v ∈ T \ S, (Ideal.absNorm v.asIdeal : ℝ) ^ (3 * aT v) := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hoff : ∀ 𝔓 : HeightOneSpectrum (𝓞 K), 𝔓.under (𝓞 ℚ) ∉ T →
      LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = 0 := by
    intro 𝔓 hvT
    have hnb : ¬ IsBadPlace K μ (𝔓.under (𝓞 ℚ)) := fun hb => hvT (hST ((hS _).mpr hb))
    have hmem : 𝔓 ∈ primeFibre ℚ K (𝔓.under (𝓞 ℚ)) := rfl
    have hμ𝔓 : IsUnramifiedCharAt μ 𝔓 := by
      by_contra h
      exact hnb (Or.inr ⟨𝔓, hmem, h⟩)
    rw [TwistConstants.pinnedExp_mul_comp_idelicNorm K μ χ 𝔓 hμ𝔓
      (by
        by_contra hne
        exact hnb (Or.inl ⟨𝔓, hmem, hne⟩)) 0
      (LanglandsTunnell.Converse.hasConductorExponentAt_localChar_zero_of_isUnramifiedCharAt ℚ χ _ (hχT _ hvT)),
      addCharLevel_psiLocal_rat]
    simp
  unfold LanglandsTunnell.HeckeTate.heckeConductor
  have hsupp : Function.mulSupport (fun 𝔓 : HeightOneSpectrum (𝓞 K) => (Ideal.absNorm 𝔓.asIdeal : ℝ) ^
      LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) ⊆
      ⋃ v ∈ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))), primeFibre ℚ K v := by
    intro 𝔓 h𝔓
    refine Set.mem_biUnion (x := 𝔓.under (𝓞 ℚ)) ?_ rfl
    by_contra hvT
    apply h𝔓
    beta_reduce
    rw [hoff 𝔓 (by simpa using hvT), zpow_zero]
  have hdisj : (↑T : Set (HeightOneSpectrum (𝓞 ℚ))).PairwiseDisjoint (primeFibre ℚ K) := by
    intro v _ v' _ hne
    exact Set.disjoint_left.mpr fun 𝔓 h h' => hne ((h : 𝔓.under (𝓞 ℚ) = v).symm.trans h')
  have hreg : ∏ᶠ 𝔓 : HeightOneSpectrum (𝓞 K), (Ideal.absNorm 𝔓.asIdeal : ℝ) ^
        LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      ∏ᶠ 𝔓 ∈ ⋃ v ∈ (↑T : Set (HeightOneSpectrum (𝓞 ℚ))), primeFibre ℚ K v, (Ideal.absNorm 𝔓.asIdeal : ℝ) ^
        LanglandsTunnell.Converse.pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 := by
    rw [finprod_mem_def, Set.mulIndicator_eq_self.mpr hsupp]
  rw [hreg, finprod_mem_biUnion hdisj T.finite_toSet (fun v _ => FibreDegree.primeFibre_finite K v),
    finprod_mem_coe_finset, ← Finset.prod_sdiff hST, mul_comm]
  congr 1
  · refine Finset.prod_congr rfl fun v hv => ?_
    rw [finprod_primeFibre_absNorm_pow_pinnedExp_twist_eq K μ χ v,
      finsum_mem_congr rfl fun 𝔓 h𝔓 => by
        rw [pinnedExp_mul_comp_idelicNorm_eq_of_isUnramifiedCharAt_under K μ χ 𝔓
          (by rw [show 𝔓.under (𝓞 ℚ) = v from h𝔓]; exact hχS v hv)],
      ← hsum v hv]
    have hab : (∑ i, (bS v i : ℤ)) = ((∑ i, aS v i : ℕ) : ℤ) := by
      push_cast
      exact Finset.sum_congr rfl fun i _ => by rw [hH5 v hv i]
    rw [hab, zpow_natCast]
  · refine Finset.prod_congr rfl fun v hv => ?_
    rw [finprod_primeFibre_absNorm_pow_pinnedExp_twist_eq K μ χ v,
      TwistFibre.finsum_inertiaDeg_mul_pinnedExp_twist_of_not_isBadPlace K μ χ hdeg v
        (fun hb => (Finset.mem_sdiff.mp hv).2 ((hS v).mpr hb)) (aT v) (haT v hv),
      show (3 : ℤ) * (aT v : ℤ) = ((3 * aT v : ℕ) : ℤ) by push_cast; ring, zpow_natCast]

private theorem ofReal_prod_pow_cpow_eq_prod_cpow_mul {X : Type} (s : Finset X) (N n : X → ℕ) (z : ℂ) :
    (((∏ x ∈ s, (N x : ℝ) ^ n x : ℝ)) : ℂ) ^ z = ∏ x ∈ s, (N x : ℂ) ^ ((n x : ℂ) * z) := by
  induction s using Finset.induction_on with
  | empty => rw [Finset.prod_empty, Finset.prod_empty, Complex.ofReal_one, Complex.one_cpow]
  | insert x s hx ih =>
    rw [Finset.prod_insert hx, Finset.prod_insert hx, Complex.ofReal_mul,
      Complex.mul_cpow_ofReal_nonneg (pow_nonneg (Nat.cast_nonneg _) _)
        (Finset.prod_nonneg fun _ _ => pow_nonneg (Nat.cast_nonneg _) _), ih, ← Real.rpow_natCast,
      ← Complex.cpow_mul_ofReal_nonneg (Nat.cast_nonneg _)]
    norm_cast

private theorem column_prod_eq_heckeRootNumber_mul_heckeConductor_cpow (K : Type) [Field K] [NumberField K]
    [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)] (hdeg : Module.finrank ℚ K = 3)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (hμu : IsUnitaryChar (𝓞 K) K μ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχu : IsUnitaryChar (𝓞 ℚ) ℚ χ)
    (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (hS : ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∈ S ↔ IsBadPlace K μ v)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hST : S ⊆ T) (hχT : ∀ v ∉ T, IsUnramifiedCharAt χ v)
    (hχS : ∀ v ∈ S, IsUnramifiedCharAt χ v)
    (ν : (v : HeightOneSpectrum (𝓞 ℚ)) → Fin 3 → (v.adicCompletion ℚ)ˣ →* ℂˣ)
    (hH4 : (∏ v ∈ S, ∏ i, stdRootNumberAt ℚ v (ν v i * localChar χ v)) * (∏ w : InfinitePlace K, lambdaArch K w)
      = ∏ v ∈ S, ∏ᶠ 𝔓 ∈ primeFibre ℚ K v,
          stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓))
    (aS bS : HeightOneSpectrum (𝓞 ℚ) → Fin 3 → ℕ) (hH5 : ∀ v ∈ S, ∀ i, aS v i = bS v i)
    (hsum : ∀ v ∈ S, (∑ i, (bS v i : ℤ)) =
      ∑ᶠ w ∈ primeFibre ℚ K v, (v.asIdeal.inertiaDeg' w.asIdeal : ℤ) * LanglandsTunnell.Converse.pinnedExp K μ w)
    (aT : HeightOneSpectrum (𝓞 ℚ) → ℕ) (haT : ∀ v ∈ T \ S, HasConductorExponentAt ℚ v (localChar χ v) (aT v))
    (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (α : ∀ v : HeightOneSpectrum (𝓞 ℚ), (v.adicCompletion ℚ)ˣ)
    (a : ℚ) (ha : a = 1 ∨ a = -1)
    (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ) (aInf : (InfiniteAdeleRing ℚ)ˣ)
    (hcol : ω (E aInf) * χ (E aInf) ^ 3 * (∏ v ∈ S, (localChar ω v (α v) * localChar χ v (α v) ^ 3))
        * ∏ v ∈ T \ S, localChar χ v (α v) ^ 3
      = 1)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR' : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC' : ∀ w : InfinitePlace K, w.IsComplex → ℤ) :
    ∀ s : ℂ,
      (∏ v ∈ S, (∏ i, stdRootNumberAt ℚ v (ν v i * localChar χ v)) *
          (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (aS v i : ℂ)) * (1 / 2 - s)) *
          (((localChar ω v (α v) : ℂˣ) : ℂ) * ((localChar χ v (α v) : ℂˣ) : ℂ) ^ 3)) *
        (∏ v ∈ T \ S, inducedE3 ℚ (inducedCoeff K μ) v ^ aT v * stdRootNumberAt ℚ v (localChar χ v) ^ 3 *
          (Ideal.absNorm v.asIdeal : ℂ) ^ ((3 * aT v : ℂ) * (1 / 2 - s)) * ((localChar χ v (α v) : ℂˣ) : ℂ) ^ 3) *
        ((((Finset.univ : Finset {w : InfinitePlace K // w.IsReal}).prod fun w => signEpsilon (aR' w.1 w.2)) *
            ((Finset.univ : Finset {w : InfinitePlace K // w.IsComplex}).prod
              fun w => Complex.I ^ (kC' w.1 w.2).natAbs) *
            ∏ w : InfinitePlace K, lambdaArch K w) *
          (((ω (E aInf) : ℂˣ) : ℂ) * ((χ (E aInf) : ℂˣ) : ℂ) ^ 3) *
          (((|a| : ℝ) : ℂ) ^ (3 * (s - 1 / 2))))
      = LanglandsTunnell.HeckeTate.heckeRootNumber K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) aR' kC' *
          (LanglandsTunnell.HeckeTate.heckeConductor K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) : ℂ) ^
            (((LanglandsTunnell.HeckeTate.heckeDatum K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)
                uR aR' uC kC').center : ℂ) - s) := by
  intro s
  have hε := finprod_stdRootNumberAt_twist_eq_prod_mul_prod K hdeg μ hμu χ hχu S hS T hST hχT aT haT
  have hN := heckeConductor_twist_eq_prod_mul_prod K hdeg μ χ S hS T hST hχT hχS aS bS hH5 hsum aT haT
  have habs : ((|a| : ℝ) : ℂ) = 1 := by
    rcases ha with rfl | rfl <;> norm_num
  have hc := congrArg Units.val hcol
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, Units.coe_prod, Units.val_one, Finset.prod_mul_distrib] at hc
  have hcen : (((LanglandsTunnell.HeckeTate.heckeDatum K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm)
      uR aR' uC kC').center : ℂ) - s) = 1 / 2 - s := by
    norm_num [LanglandsTunnell.HeckeTate.heckeDatum]
  unfold LanglandsTunnell.HeckeTate.heckeRootNumber
  rw [hε, ← hH4, hcen, hN, Complex.ofReal_mul,
    Complex.mul_cpow_ofReal_nonneg (Finset.prod_nonneg fun _ _ => pow_nonneg (Nat.cast_nonneg _) _)
      (Finset.prod_nonneg fun _ _ => pow_nonneg (Nat.cast_nonneg _) _),
    ofReal_prod_pow_cpow_eq_prod_cpow_mul, ofReal_prod_pow_cpow_eq_prod_cpow_mul, habs, Complex.one_cpow]
  simp only [Finset.prod_mul_distrib]
  push_cast
  linear_combination
    ((∏ v ∈ S, ∏ i, stdRootNumberAt ℚ v (ν v i * localChar χ v)) *
        (∏ v ∈ S, (Ideal.absNorm v.asIdeal : ℂ) ^ ((∑ i, (aS v i : ℂ)) * (1 / 2 - s))) *
        (∏ v ∈ T \ S, inducedE3 ℚ (inducedCoeff K μ) v ^ aT v) *
        (∏ v ∈ T \ S, stdRootNumberAt ℚ v (localChar χ v) ^ 3) *
        (∏ v ∈ T \ S, (Ideal.absNorm v.asIdeal : ℂ) ^ ((3 * (aT v : ℂ)) * (1 / 2 - s))) *
        (((Finset.univ : Finset {w : InfinitePlace K // w.IsReal}).prod fun w => signEpsilon (aR' w.1 w.2)) *
          ((Finset.univ : Finset {w : InfinitePlace K // w.IsComplex}).prod
            fun w => Complex.I ^ (kC' w.1 w.2).natAbs) *
          ∏ w : InfinitePlace K, lambdaArch K w)) * hc

end LanglandsTunnell.CubicInduction.TwistAssembly
