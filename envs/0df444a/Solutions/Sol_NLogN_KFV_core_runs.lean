/-- The Gaussian numerators of `ncv` (as `Synth.co_mul_gauss`). -/
theorem ncv_gauss (s : ℝ) (a b c e : ℕ → ℤ) (u v : Fin r → ℂ)
    (hf : ∀ i : Fin r, u i = (s : ℂ) * ⟨a i, b i⟩)
    (hg : ∀ i : Fin r, v i = (s : ℂ) * ⟨c i, e i⟩) (j : Fin r) :
    ncv u v j = (s : ℂ) ^ 2 *
      ⟨((cnv r a c j - cnv r a c (j + r)) - (cnv r b e j - cnv r b e (j + r)) : ℤ),
       ((cnv r a e j - cnv r a e (j + r)) + (cnv r b c j - cnv r b c (j + r)) : ℤ)⟩ := by
  unfold ncv
  rw [fold_formula r _ _ j.isLt, fold_formula r _ _ j.isLt, fold_formula r _ _ j.isLt,
    fold_formula r _ _ j.isLt]
  rw [← Fin.sum_univ_eq_sum_range (fun i => if i ≤ (j : ℕ) then a i * c (j - i)
      else -(a i * c (j + r - i))),
    ← Fin.sum_univ_eq_sum_range (fun i => if i ≤ (j : ℕ) then b i * e (j - i)
      else -(b i * e (j + r - i))),
    ← Fin.sum_univ_eq_sum_range (fun i => if i ≤ (j : ℕ) then a i * e (j - i)
      else -(a i * e (j + r - i))),
    ← Fin.sum_univ_eq_sum_range (fun i => if i ≤ (j : ℕ) then b i * c (j - i)
      else -(b i * c (j + r - i)))]
  rw [← sum_sub_distrib, ← sum_add_distrib]
  apply Complex.ext
  · simp only [Complex.re_sum, Complex.mul_re]
    rw [show ((s : ℂ) ^ 2).re = s ^ 2 by norm_cast, show ((s : ℂ) ^ 2).im = 0 by norm_cast]
    simp only [Int.cast_sum, zero_mul, mul_zero, sum_const_zero, sub_zero, add_zero, mul_sum]
    refine sum_congr rfl fun i _ => ?_
    split_ifs with h <;> simp [hf, hg, Complex.mul_re, Complex.mul_im] <;> ring
  · simp only [Complex.im_sum, Complex.mul_im]
    rw [show ((s : ℂ) ^ 2).re = s ^ 2 by norm_cast, show ((s : ℂ) ^ 2).im = 0 by norm_cast]
    simp only [Int.cast_sum, zero_mul, mul_zero, sum_const_zero, sub_zero, add_zero, mul_sum]
    refine sum_congr rfl fun i _ => ?_
    split_ifs with h <;> simp [hf, hg, Complex.mul_re, Complex.mul_im] <;> ring

