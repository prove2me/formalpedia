/-! # Gauge directions of the linearised Einstein–Maxwell operator (ATLAS-IV-03)

**Diffeomorphism gauge** (`linearized_lie_eq_zero`). Background `(g, gi, F)` with a full
`EinsteinMaxwellCertificate` on an open `U` (4D); `ξ` an **arbitrary** coordinate vector field with
`C^∞` components on `U` (not Killing, not constant, not zero). Then for the coordinate Lie derivatives

  `h = L_ξ g`, `f = L_ξ F`  (`lieCov2`, `(L_ξ T)_{ab} = Σ_c (ξ^c ∂_c T_{ab} + T_{cb} ∂_a ξ^c + T_{ac} ∂_b ξ^c)`)

`LE = 0`, `LJ = 0`, `LH = 0` at every point of `U`. Route: the genuine real family of coordinate changes
`Φ_ε(y) = y + ε ξ(y)` (class B `shiftMap`) with Jacobian `J_ε = 1 + ε Dξ` and inverse `K_ε = J_ε⁻¹`, on the
open set `shiftDom U ξ = {(ε, y) | y ∈ U, Φ_ε y ∈ U, det J_ε(y) ≠ 0}` (it contains `{0} × U`; no uniform
`ε`-interval over `U` is claimed). The pulled-back family `(J_εᵀ g(Φ_ε) J_ε, K_ε gi(Φ_ε) K_εᵀ, J_εᵀ F(Φ_ε) J_ε)`
is jointly `C^∞`, has a true inverse, solves `E = J = H = 0` on `shiftDom` by the covariance laws of
`Covariance.lean` (proved, not assumed), and its genuine tangent at `ε = 0` is `(L_ξ g, L_ξ F)`; the off-shell
bridge then gives the claim.

**Electromagnetic-potential gauge** (`extD_gradCo`, `linEinstein_potential_gauge`, …): for a `C^∞` scalar `χ`
on an open `U`, `d(dχ) = 0` on `U`, so the field variation `f = d(dχ)` changes none of `LE`, `LJ`, `LH`
(for any background and any `(h, f)`); in particular `L(0, d(dχ)) = 0`. -/

open Filter Topology
open scoped ContDiff
open Matrix
open ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.Variation

variable {n : ℕ}

/-! ## The coordinate-change family -/

theorem shiftMap_zero (ξ : Fin n → Pt n → ℝ) (y : Pt n) : shiftMap ξ 0 y = y := by
  funext k; simp [shiftMap]

theorem shiftJac_zero (ξ : Fin n → Pt n → ℝ) (y : Pt n) : shiftJac ξ 0 y = 1 := by
  simp [shiftJac]

theorem shiftJac_apply (ξ : Fin n → Pt n → ℝ) (ε : ℝ) (y : Pt n) (k i : Fin n) :
    shiftJac ξ ε y k i = (1 : Matrix (Fin n) (Fin n) ℝ) k i + ε * pd i (ξ k) y := by
  simp [shiftJac, Matrix.add_apply]

theorem pullCov_zero (ξ : Fin n → Pt n → ℝ) (T : Fin n → Fin n → Pt n → ℝ) : pullCov ξ T 0 = T := by
  funext a b y
  simp [pullCov, shiftJac_zero, shiftMap_zero, metricMatrix]

theorem pullInv_zero (ξ : Fin n → Pt n → ℝ) (gi : Metric n) : pullInv ξ gi 0 = gi := by
  funext a b y
  simp [pullInv, shiftJac_zero, shiftMap_zero, metricMatrix]

theorem pullCov_apply (ξ : Fin n → Pt n → ℝ) (T : Fin n → Fin n → Pt n → ℝ) (ε : ℝ) (a b : Fin n) (y : Pt n) :
    pullCov ξ T ε a b y = ∑ p, ∑ q, shiftJac ξ ε y p a * shiftJac ξ ε y q b * T p q (shiftMap ξ ε y) := by
  rw [pullCov, congr_entry]
  rfl

theorem zero_mem_shiftDom {U : Set (Pt n)} {ξ : Fin n → Pt n → ℝ} {y : Pt n} (hy : y ∈ U) :
    ((0 : ℝ), y) ∈ shiftDom U ξ := by
  refine ⟨hy, ?_, ?_⟩
  · simpa [shiftMap_zero] using hy
  · simp [shiftJac_zero]

section regularity

variable {U : Set (Pt n)} (hU : IsOpen U) {ξ : Fin n → Pt n → ℝ} (hξ : ∀ k, ContDiffOn ℝ ∞ (ξ k) U)
include hU hξ

omit hU in
theorem contDiffOn_shiftMap_joint :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => shiftMap ξ p.1 p.2) {p | p.2 ∈ U} := by
  refine contDiffOn_pi.mpr fun k => ?_
  exact ((contDiff_apply ℝ ℝ k).comp contDiff_snd).contDiffOn.add
    (contDiffOn_fst.mul ((hξ k).comp contDiffOn_snd fun p hp => hp))

theorem contDiffOn_shiftJac_joint (k i : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => shiftJac ξ p.1 p.2 k i) {p | p.2 ∈ U} := by
  simp only [shiftJac_apply]
  exact contDiffOn_const.add (contDiffOn_fst.mul
    ((contDiffOn_pd hU (hξ k) i).comp contDiffOn_snd fun p hp => hp))

theorem contDiffOn_pullCov_joint {T : Fin n → Fin n → Pt n → ℝ} (hT : ∀ i j, ContDiffOn ℝ ∞ (T i j) U)
    (a b : Fin n) : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => pullCov ξ T p.1 a b p.2) (shiftDom U ξ) := by
  have hsub : shiftDom U ξ ⊆ {p | p.2 ∈ U} := fun p hp => hp.1
  simp only [pullCov_apply]
  exact ContDiffOn.sum fun p _ => ContDiffOn.sum fun q _ =>
    (((contDiffOn_shiftJac_joint hU hξ p a).mono hsub).mul ((contDiffOn_shiftJac_joint hU hξ q b).mono hsub)).mul
      ((hT p q).comp ((contDiffOn_shiftMap_joint hξ).mono hsub) fun p hp => hp.2.1)

end regularity

