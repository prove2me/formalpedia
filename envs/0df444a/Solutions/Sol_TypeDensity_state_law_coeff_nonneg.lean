theorem solution (Q : ℕ) (hQ : TypeDensity.PrimePower Q) (s : TypeDensity.State) (hs : s.Valid)
    (σ : TypeDensity.FactorType) :
    0 ≤ (TypeDensity.lawCoeff (TypeDensity.stateLaw s) σ).eval Q ∧
      ∀ δ : ℕ, 0 < δ → 0 ≤ (TypeDensity.lawCoeff (TypeDensity.lawDescend δ (TypeDensity.stateLaw s)) σ).eval Q := by
  refine ⟨TypeDensity.stateLawFuel_coeff_nonneg _ s hs Q hQ σ, fun δ hδ ↦ ?_⟩
  refine (TypeDensity.law_coeff_nonneg_closure (Q : ℚ)).2.2.2.2.1 δ hδ _ (fun σ ↦ ?_) σ
  exact_mod_cast TypeDensity.stateLawFuel_coeff_nonneg (s.rank + 1) s hs (Q ^ δ) (TypeDensity.primePower_pow Q hQ δ hδ) σ
