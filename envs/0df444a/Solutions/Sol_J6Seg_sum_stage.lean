section stage
variable (P : ℕ)

lemma sum_stage_sol_aux {I : Finset ℕ} {ct xt : ℕ → ℤ} {c x : ℕ → ℝ} {ec δ X C : ℝ}
    (hc : ∀ k ∈ I, |(ct k : ℝ) / 2 ^ P - c k| ≤ ec) (hC : ∑ k ∈ I, |c k| ≤ C)
    (hx : ∀ k ∈ I, |(xt k : ℝ) / 2 ^ P - x k| ≤ δ) (hX : ∀ k ∈ I, |(xt k : ℝ) / 2 ^ P| ≤ X)
    (hec : 0 ≤ ec) (hδ : 0 ≤ δ) :
    |(rs P (∑ k ∈ I, ct k * xt k) : ℝ) / 2 ^ P - ∑ k ∈ I, c k * x k| ≤
      1 / (2 * 2 ^ P) + I.card * ec * X + C * δ := by
  have hS := two_pow_pos' P
  have h1 := rs_err P (∑ k ∈ I, ct k * xt k)
  have h1' : |(rs P (∑ k ∈ I, ct k * xt k) : ℝ) / 2 ^ P -
      ∑ k ∈ I, (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P)| ≤ 1 / (2 * 2 ^ P) := by
    have e : (rs P (∑ k ∈ I, ct k * xt k) : ℝ) / 2 ^ P -
        ∑ k ∈ I, (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P) =
        ((rs P (∑ k ∈ I, ct k * xt k) : ℝ) - ((∑ k ∈ I, ct k * xt k : ℤ) : ℝ) / 2 ^ P) / 2 ^ P := by
      push_cast; rw [sub_div, sum_div, sum_div]; congr 1
      exact sum_congr rfl fun k _ => by field_simp
    rw [e, abs_div, abs_of_pos hS, div_le_iff₀ hS]
    have : 1 / (2 * 2 ^ P) * (2 : ℝ) ^ P = 1 / 2 := by field_simp
    linarith
  have h2 : |∑ k ∈ I, (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P) - ∑ k ∈ I, c k * x k| ≤
      I.card * ec * X + C * δ := by
    rw [← sum_sub_distrib]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    have hb : ∀ k ∈ I, |(ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P) - c k * x k| ≤
        ec * X + |c k| * δ := by
      intro k hk
      have e : (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P) - c k * x k =
          ((ct k : ℝ) / 2 ^ P - c k) * ((xt k : ℝ) / 2 ^ P) +
            c k * ((xt k : ℝ) / 2 ^ P - x k) := by ring
      rw [e]
      refine (abs_add_le _ _).trans (add_le_add ?_ ?_) <;> rw [abs_mul]
      · exact mul_le_mul (hc k hk) (hX k hk) (abs_nonneg _) hec
      · exact mul_le_mul_of_nonneg_left (hx k hk) (abs_nonneg _)
    refine (sum_le_sum hb).trans ?_
    rw [sum_add_distrib, sum_const, nsmul_eq_mul, ← sum_mul]
    have := mul_le_mul_of_nonneg_right hC hδ
    linarith [show (I.card : ℝ) * (ec * X) = I.card * ec * X by ring]
  calc _ ≤ |(rs P (∑ k ∈ I, ct k * xt k) : ℝ) / 2 ^ P -
        ∑ k ∈ I, (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P)| +
        |∑ k ∈ I, (ct k : ℝ) / 2 ^ P * ((xt k : ℝ) / 2 ^ P) - ∑ k ∈ I, c k * x k| :=
        abs_sub_le _ _ _
    _ ≤ _ := by linarith

end stage

