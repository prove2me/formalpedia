-- title:
--   Proof of Theorem 8 — every predictor–corrector iterate lies in N(2β), and θᵏ ≤ 1
-- statement:
--   Work with (HLP) under the choice (7) and $\beta=1/4$. Let $(z^k)_{k\ge0}$, $z^k=(y^k,x^k,\tau^k,\theta^k,s^k,\kappa^k)$, be a predictor–corrector sequence. Then for every $k$,
--
--   $$
--   z^k\in\mathcal N(2\beta)\qquad\text{and}\qquad \theta^k\le 1 .
--   $$
--
--   The first part is the opening sentence of the proof of Theorem 8 ("the sequence generated by the predictor-corrector algorithm is in $\mathcal N(2\beta)$"). Both facts feed every inequality in Theorem 8: membership in $\mathcal N(2\beta)$ gives $(1-2\beta)\mu^k\le\tau^k\kappa^k\le(1+2\beta)\mu^k$, and $\theta^k\le1$ gives the upper bound $\kappa^k\le 2(n+1)$.
--
--   **Formalization Note** The second conjunct is not printed as a separate sentence; it is read from the step ratios on p. 62 ($\theta^{k+1}/\theta^k\le 1-8^{-1/4}/\sqrt{n+1}$ for predictor steps, $=1$ for corrector steps) together with $\theta^0=1$, and it is the inequality $(n+1)\theta^k\le n+1$ used on p. 63.
-- source:
--   Ye, Todd, Mizuno, An O(√nL)-Iteration Homogeneous and Self-Dual Linear Programming Algorithm, Math. Oper. Res. 19(1) (1994), p. 63, proof of Theorem 8 (first sentence); p. 62, step ratios; DOI 10.1287/moor.19.1.53

import Mathlib
import Definitions.Def_SelfDualLP_Complexity_LPData
import Definitions.Def_SelfDualLP_Output_HLP
import Definitions.Def_SelfDualLP_Output_Neighborhood
import Definitions.Def_SelfDualLP_Output_PCSequence

open Matrix

namespace SelfDualLP.Output

/-- Proof of Theorem 8, first sentence (p. 63): every iterate of the predictor–corrector
algorithm lies in `𝒩(2β)`, `2β = 1/2`. The second conjunct, `θᵏ ≤ 1 = θ⁰`, is the monotonicity
of `θᵏ` given by the step ratios of p. 62 (`θᵏ⁺¹/θᵏ ≤ 1 − 8^{−1/4}/√(n+1)` on predictor steps,
`= 1` on corrector steps); the proof of Theorem 8 uses it in `κᵏ ≤ (n+1) + (n+1)θᵏ ≤ 2(n+1)`. -/
theorem sequence_in_neighborhood {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ)
    (c : Fin n → ℝ) (z : ℕ → HLPPoint m n) (hz : IsPCSequence A b c z) :
    ∀ k, Nbhd A b c (2 * beta) (z k) ∧ (z k).θ ≤ 1 := by sorry
end SelfDualLP.Output
