section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

/-- The cost bound of one `SwapNeedτ` call. -/
noncomputable def cSwNτ (τ K : ℝ) (w u : ℕ) (sh : Shape) : ℝ :=
  K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ +
    (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ))

/-- What `IL.SwapNeedτ` provides, in the table `iprog` at the entry `eSw`. -/
def SwOKτ (τ : ℝ) (I : List Sym) (iprog : Fin P → IStmt HS P) (eSw : Fin P) (dS : Fin HS) (K : ℝ) : Prop :=
  ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) →
    p < q → q < sh.length → sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    (∀ j, j ≠ 0 → j ≠ dS → f j = []) →
    f dS = KFM.descSw w u p q sh →
    f 0 = gflat zs ++ l → zs.length = vol sh → GB w zs →
    ∃ c : ℕ, IRuns I iprog (.call eSw) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
      (c : ℝ) ≤ cSwNτ τ K w u sh

/-! ## Moving and dropping a fixed number of items -/

end Gen

