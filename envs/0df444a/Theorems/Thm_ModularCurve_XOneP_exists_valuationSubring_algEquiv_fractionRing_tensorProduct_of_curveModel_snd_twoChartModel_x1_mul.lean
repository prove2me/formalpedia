        (algV : Algebra A ↥V) (_ : ∀ a : A, ((algebraMap A ↥V a : ↥V) : ↥K) = algebraMap A ↥K a)
        (𝔮 : Ideal (TensorProduct A k ↥V)) (_ : 𝔮 ∈ minimalPrimes (TensorProduct A k ↥V)),
        Nonempty (F ≃ₐ[k] FractionRing (TensorProduct A k ↥V ⧸ 𝔮)) := by sorry
