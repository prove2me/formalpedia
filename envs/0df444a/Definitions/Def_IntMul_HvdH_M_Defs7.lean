def sapSlC (p s t α mm Φ Bacc Q : ℕ) : ℕ :=
  gresCost s (2 * HvdH.sWidth p α + 1) t mm Φ Bacc 1 + (16000 * (Q + 2) + t * 60000 * (Q + 2) + 64)

end NLogN.AX

