-- title:
--   Canonical polynomial generator of elliptic contact conditions
-- statement:
--   Fix the elliptic-extension geometry of the mission. Let $m,n,U\ge0$, let $X\subset\mathbb C$ be finite and contain zero, and let $Q$ be a polynomial in the seven homogeneous coordinates. Assume the existing chart certificates for $X,Q,m,n,U$. Let $Y\subseteq X$ be any finite subset, and put $N=3U+1$.
--
--   Use the regular affine chart with coordinates $(z,\wp(z),\wp'(z),\zeta(z))$. In the ring $R=\mathbb C[T_0,T_1,T_2,T_3]$, let
--
--   $$I=\bigcap_{z\in Y\setminus\Lambda} I_{z,N},$$
--
--   where $I_{z,N}$ is the chart contact ideal: its elements and their first $N-1$ derivatives along the chart flow vanish at $z$. Let $A=R/I$, and let $x\in A$ be the class of $T_1$, the elliptic coordinate. Then there exists a monic polynomial $p\in\mathbb C[T]$ such that
--
--   $$\deg p=\dim_{\mathbb C}\mathbb C[x]$$
--
--   and, for every $q\in\mathbb C[T]$,
--
--   $$p\mid q\quad\Longleftrightarrow\quad
--   \left.\frac{d^j}{dw^j}q(\wp(w))\right|_{w=z}=0
--   \quad\text{for all }z\in Y\setminus\Lambda,\ 0\le j<N.$$
--
--   Thus $p$ is the unique monic generator of the polynomial contact conditions and has the least degree among their nonzero solutions. The theorem proves that the relevant quotient is finite dimensional from the existing chart certificates; finiteness is not an extra assumption. It includes an empty nonlattice subset, where the contact conditions are vacuous and the generator is $1$.
--
--   **Formalization Note.** The geometry and chart certificates are the existing stable records. `Algebra.adjoin` denotes the subalgebra generated by the elliptic coordinate; its dimension counts independent coordinate powers, not the dimension of the whole contact quotient. No new interface fields or general zero-estimate hypotheses are introduced.
-- source:
--   Derived algebraic reduction for https://prove2.me/theorems/c9f70c21-a452-4c12-aa1e-5a4861562a6d. Mission context: Senthil Kumar K (2026), Algebraic independence of values of Weierstrass elliptic and zeta functions, Appendix A.2, Theorem A.3 and Proposition A.1; https://doi.org/10.1017/S001309152610145X. This is an independent canonical generator construction in the already formalized contact quotient. It connects analytic vanishing to minimal-polynomial divisibility and identifies the optimal degree with the dimension of the subalgebra generated by the elliptic coordinate. Primary Lean sources: Mathlib RingTheory/Adjoin/PowerBasis.lean, FieldTheory/Minpoly/Field.lean, RingTheory/Ideal/Quotient/Operations.lean, and Analysis/Calculus/IteratedDeriv/Lemmas.lean, revision 0df444a360eaa60ab8c11dca51a86af692955474. The new dimension estimate remains open. It is equivalent to the selected polynomial-construction frontier with the same uniform constant, not a claim that the paper zero estimate has been proved.

import Definitions.Def_WeierstrassEllipticZeta_InterfaceGeometry
import Mathlib.RingTheory.Adjoin.PowerBasis
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.Analysis.Analytic.Polynomial

noncomputable section
open WeierstrassEllipticZeta
open scoped Pointwise Classical Topology

theorem WeierstrassEllipticZeta.wp_contact_minpoly_generator
    (G : Frontier.Geometry) (m n U : ℕ) (X : Finset ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (hX : 0 ∈ X)
    (hcharts : Frontier.HasChartCertificates G m n U X Q)
    (Y : Finset ℂ) (hYX : Y ⊆ X) :
    let Z := Y.filter (fun z => z ∉ G.L.lattice)
    let I : Ideal (MvPolynomial (Fin 4) ℂ) :=
      ⨅ z : Z, extensionChartContactIdeal G.L.g₂ G.L.g₃ 0
        (extensionChartCoordinates G.S 0 z.val) (3 * U + 1)
    let x := Ideal.Quotient.mk I (MvPolynomial.X (1 : Fin 4))
    ∃ p : Polynomial ℂ, p.Monic ∧
      p.natDegree = Module.finrank ℂ (Algebra.adjoin ℂ ({x} : Set _)) ∧
      ∀ q : Polynomial ℂ, p ∣ q ↔ ∀ z ∈ Y, z ∉ G.L.lattice → ∀ j < 3 * U + 1,
        iteratedDeriv j (fun w => q.eval (G.L.weierstrassP w)) z = 0 := by sorry
