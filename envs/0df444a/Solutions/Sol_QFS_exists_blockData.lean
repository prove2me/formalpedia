          + ‖(Δ:ℝ) ^ (m + 1) • w - q‖ := by
      have hde : (Δ:ℝ) ^ (m + 1) • z - q
          = ((Δ:ℝ) ^ (m + 1) • z - (Δ:ℝ) ^ (m + 1) • w)
            + ((Δ:ℝ) ^ (m + 1) • w - q) := by abel
      rw [hde]; exact norm_add_le _ _
    have h4 : ‖(Δ:ℝ) ^ (m + 1) • w - q‖ ≤ (Δ:ℝ) ^ m / 2 * Real.sqrt d := by
      rw [norm_sub_rev]; exact h1
    rw [h2] at htri
    nlinarith [hh, hsd, hℓh]
  -- the two hashes
  have hadmfin : {x | QFS.AdmissiblePt (Δ:ℝ) m z x}.Finite :=
    (QFS.lattice_inter_closedBall_finite ((Δ:ℝ) ^ (m + 1) • z)
      (2 * Real.sqrt d * (Δ:ℝ) ^ (m + 1))).subset
      (fun x hx => ⟨hx.1, by rw [Metric.mem_closedBall, dist_eq_norm]; exact hx.2⟩)
  have hAcard : hadmfin.toFinset.card
      ≤ ((2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L) * QFS.schemeIndex Δ L d m := by
    have h1 := QFS.encard_admissiblePt_le (d := d) hΔ1 m z
    rw [← hadmfin.cast_ncard_eq] at h1
    have h2 : {x | QFS.AdmissiblePt (Δ:ℝ) m z x}.ncard
        ≤ (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * Δ ^ (m * d) := by exact_mod_cast h1
    rw [← Set.ncard_eq_toFinset_card _ hadmfin]
    calc {x | QFS.AdmissiblePt (Δ:ℝ) m z x}.ncard
        ≤ (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * Δ ^ (m * d) := h2
      _ ≤ (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * (L * QFS.schemeIndex Δ L d m) :=
          Nat.mul_le_mul_left _ (QFS.pow_le_mul_schemeIndex hL hΔL hd m)
      _ = ((2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L) * QFS.schemeIndex Δ L d m := by
          rw [Nat.mul_assoc]
  obtain ⟨hfun, hfbal⟩ := QFS.exists_hash
    (K := (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L) hadmfin.toFinset hAcard
  obtain ⟨gfun, hgbal⟩ := QFS.exists_hash
    (K := (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L) hadmfin.toFinset hAcard
  have hbal : ∀ F : EuclideanSpace ℝ (Fin d) → ZMod (QFS.schemeIndex Δ L d m),
      (∀ γ, (hadmfin.toFinset.filter fun x => F x = γ).card
        ≤ (2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L) →
      ∀ γ, {y | QFS.AdmissiblePt (Δ:ℝ) m z y ∧ F y = γ}.encard
        ≤ (((2 * ⌈2 * Real.sqrt d * (Δ : ℝ)⌉₊ + 1) ^ d * L : ℕ) : ℕ∞) := by
    intro F hF γ
    have hset : {y | QFS.AdmissiblePt (Δ:ℝ) m z y ∧ F y = γ}
        = ↑(hadmfin.toFinset.filter fun x => F x = γ) := by
      ext y
      simp [Set.Finite.mem_toFinset]
    rw [hset, Set.encard_coe_eq_coe_finsetCard]
    exact_mod_cast hF γ
  have hjs : Jmp ⊆ Blk := by rw [hJmp, hBlk]; exact QFS.townBall_mono _ _ z hRcr
  refine ⟨?_⟩
  exact
    { W := W
      Blk := Blk
      Jmp := Jmp
      jmp_sub := hjs
      rep := rep
      rep_mem := hrepmem
      rep_lat := hreplat
      idx := idx
      idx_rep := hidx
      walk := hwalk
      jump := hjmp
      sep := hsep
      near := hnear
      hf := hfun
      hg := gfun
      hf_bal := hbal hfun hfbal
      hg_bal := hbal gfun hgbal }
