variable {h Q J x : ℝ} {F b A : ℝ → ℝ}
theorem solution (hx : x ≠ 0) (hb : b x ≠ 0) (hu : 1 - h * x ≠ 0)
    (cb : ContDiffAt ℝ ∞ b x) (cA : ContDiffAt ℝ ∞ A x) (hPA : realPA h Q J F b A x = 0) :
    deriv (fun y => Vf A y + Wf b A y) x
      = c1E h Q x (F x) (b x) ((F x / b x - 1) / x) * Vf A x + (1 / b x - 1) / x * Wf b A x
        + d1E h Q J x (F x) (b x) ∧
    x * deriv (fun y => Vf A y - Wf b A y) x + 2 * (Vf A x - Wf b A x)
      = x * ((1 / b x - 1) / x * Wf b A x - c1E h Q x (F x) (b x) ((F x / b x - 1) / x) * Vf A x
        - d1E h Q J x (F x) (b x)) := by
  have hV : HasDerivAt (Vf A) ((deriv A x * x - A x * 1) / x ^ 2) x :=
    (hd1' cA).div (hasDerivAt_id' x) hx
  have hW : HasDerivAt (Wf b A) (deriv b x * deriv A x + b x * deriv (deriv A) x) x :=
    (hd1' cb).mul (hd2' cA)
  have key := maxwell_id x h Q J (F x) (deriv F x) (deriv (deriv F) x) (b x) (deriv b x)
    (deriv (deriv b) x) (A x) (deriv A x) (deriv (deriv A) x) hx hb hu hPA
  have hS : HasDerivAt (fun y => Vf A y + Wf b A y) _ x := hV.add hW
  have hT : HasDerivAt (fun y => Vf A y - Wf b A y) _ x := hV.sub hW
  rw [hS.deriv, hT.deriv]
  unfold Vf Wf
  constructor
  · rw [← key.1]; field_simp
  · rw [← key.2]; field_simp
