/-- **The pointwise parameter conditions of §8–9 hold for `n ≥ n₀`.** -/
theorem params_ok {n : ℕ} (hn : n0 ≤ n) :
    -- thresholds
    2 ≤ (bP n : ℝ) ^ IntMul.OpenAI.RCost.ε ∧ 2 ≤ (dP n : ℝ) ^ c ∧ 8192 ≤ bP n ∧ 1 ≤ dP n ∧ dP n ≤ bP n ∧
    -- box exponent and volume
    bP n ≤ 2 * LP n ∧ LP n < bP n ∧ TP n < 2 ^ bP n ∧
    24 * (n : ℝ) ≤ VP n ∧ VP n ≤ 48 * n ∧
    -- axis exponent, factorial bound, source lengths
    (pP n : ℝ) / (12 * dP n) ≤ ℓP n ∧ (ℓP n : ℝ) ≤ (pP n : ℝ) / (3 * dP n) ∧
    64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ rP n ∧ 2 ∣ rP n ∧
    -- resampling / error budget
    2 * dP n * pP n ^ 2 < TP n * LP n ∧ 12 * (dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 ∧
    γP n ≤ (bP n : ℝ) / 4 ∧
    -- the hypotheses of `kappaBound_of_table`
    (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε / 12 ≤ dP n ∧ (dP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε ∧
    (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c) / 24 ≤ KP n ∧ (KP n : ℝ) ≤ (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c) ∧
    (ℓP n : ℝ) ≤ 6 * (IntMul.lg n : ℝ) / (3 * dP n) ∧
    (αP n : ℝ) ≤ 4 * (6 * (IntMul.lg n : ℝ)) ^ (1 / 4 + IntMul.OpenAI.RCost.ε / 2) := by
  obtain ⟨hT1, hT2, hLb, h2L⟩ := L_facts hn
  have hbe := two_le_beps hn
  have hdc := two_le_dc hn
  have hd1 := d_pos hn
  have hdb := d_le_b hn
  have hb8 : 8192 ≤ bP n := le_trans (by norm_num) ((b0_ge 13 (by norm_num)).trans (b_ge hn))
  have hb1 : (1 : ℝ) ≤ bP n := by exact_mod_cast bP_pos n
  -- d and K bounds
  obtain ⟨hD1, hD2⟩ := concrete_d_bounds (bP n : ℝ) hb1 hbe
  have hp1 : (1 : ℝ) ≤ 6 * bP n := by linarith
  obtain ⟨hK1, hK2⟩ := concrete_K_bounds (6 * bP n) (dP n) hp1 hD1 hD2 hdc
  -- ℓ bounds
  obtain ⟨hl1, hl2⟩ := RP.ell_bounds (LP n) (dP n) (bP n) (by omega) hdb h2L hLb.le
  -- α
  have hX1 : (1 : ℝ) ≤ (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
    apply Real.one_le_rpow _ (by norm_num)
    have : (1 : ℝ) ≤ dP n := by exact_mod_cast hd1
    nlinarith
  have hα := concrete_alpha_bound (bP n) (dP n) hb1 (Nat.cast_nonneg _) hD2 hX1
  have hα4 : 12 * (dP n : ℝ) ^ 2 * bP n ≤ (αP n : ℝ) ^ 4 := by
    have h0 : 0 ≤ 12 * (dP n : ℝ) ^ 2 * bP n := by positivity
    have hc : (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) ≤ αP n := Nat.le_ceil _
    have : ((12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4)) ^ 4 = 12 * (dP n : ℝ) ^ 2 * bP n := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul h0]; norm_num
    rw [← this]; gcongr
  -- γ
  have hγ : γP n ≤ (bP n : ℝ) / 4 := by
    have hαle : (αP n : ℝ) ≤ 2 * (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) := by
      have := Nat.ceil_lt_add_one (show 0 ≤ (12 * (dP n : ℝ) ^ 2 * bP n) ^ ((1 : ℝ) / 4) by
        positivity)
      unfold αP; linarith
    have hd0 : (0 : ℝ) < dP n := by exact_mod_cast hd1
    have := RP.gamma_bound (dP n) (bP n) (αP n) hd0 (by linarith) (Nat.cast_nonneg _) hαle
    unfold γP; linarith [gamma_room hn]
  -- factorial bound
  have hfact : 64 * dP n ^ 2 * (256 * dP n ^ 2).factorial ≤ rP n := by
    refine (fact_bound (dP n)).trans (Nat.pow_le_pow_right (by norm_num) ?_)
    have h5 := b_ge_d5 hn
    have hd0 : (0 : ℝ) < dP n := by exact_mod_cast hd1
    have : ((2 ^ 17 * dP n ^ 4 : ℕ) : ℝ) ≤ ℓP n := by
      refine le_trans ?_ hl1
      push_cast
      rw [le_div_iff₀ (by positivity)]
      nlinarith
    exact_mod_cast this
  have hr2 : 2 ∣ rP n := by
    have hℓ1 : 1 ≤ ℓP n := by
      have : (1 : ℝ) ≤ ℓP n := by
        refine le_trans ?_ hl1
        rw [le_div_iff₀ (by positivity)]
        have h5 := b_ge_d5 hn
        have hd' : (1 : ℝ) ≤ dP n := by exact_mod_cast hd1
        have : (dP n : ℝ) ≤ (dP n : ℝ) ^ 5 := le_self_pow₀ hd' (by norm_num)
        nlinarith
      exact_mod_cast this
    exact dvd_pow_self 2 (by omega)
  -- 2 d p² < T L
  have hdp : 2 * dP n * pP n ^ 2 < TP n * LP n := by
    have hcube := cube_lt_pow (bP n) (by omega)
    have h1 : 2 * dP n * pP n ^ 2 ≤ 72 * bP n ^ 3 := by
      unfold pP; nlinarith
    have hgt := n_gt hn
    have hpow : 2 ^ bP n = 2 * 2 ^ (bP n - 1) := by rw [← pow_succ']; congr 1; omega
    have h2 : 2 ^ bP n < TP n * LP n * 2 := by nlinarith
    have h3 : 2 ^ bP n ≤ TP n * LP n := by
      have : TP n * bP n ≤ TP n * (2 * LP n) := Nat.mul_le_mul_left _ h2L
      nlinarith
    omega
  -- volume
  have hV1 : 24 * (n : ℝ) ≤ VP n := by
    unfold VP pP; push_cast
    have : ((4 * n : ℕ) : ℝ) ≤ ((TP n * bP n : ℕ) : ℝ) := by exact_mod_cast hT1
    push_cast at this; nlinarith
  have hV2 : VP n ≤ 48 * n := by
    unfold VP pP; push_cast
    have : ((TP n * bP n : ℕ) : ℝ) ≤ ((8 * n : ℕ) : ℝ) := by exact_mod_cast hT2.le
    push_cast at this; nlinarith
  have hTlt : TP n < 2 ^ bP n := Nat.pow_lt_pow_right (by norm_num) hLb
  refine ⟨hbe, hdc, hb8, hd1, hdb, h2L, hLb, hTlt, hV1, hV2, ?_, ?_, hfact, hr2, hdp, hα4, hγ,
    hD1, hD2, ?_, ?_, ?_, hα⟩
  · unfold pP; push_cast; exact hl1
  · unfold pP; push_cast; exact hl2
  · exact hK1
  · exact hK2
  · exact hl2

end

