section FeatureDistortionBundleModule2
noncomputable section
open scoped InnerProductSpace Topology
open Set Filter

namespace FeatureDistortion

private abbrev Columns (d k : ℕ) := PiLp 2 (fun _ : Fin d => Vec k)
private abbrev FlowSpace (d k : ℕ) := WithLp 2 (Vec k × Columns d k)

private def columnsMap (d k : ℕ) : Features d k →L[ℝ] Columns d k :=
  LinearMap.toContinuousLinearMap
    { toFun := fun B => WithLp.toLp 2 (fun j => B (EuclideanSpace.single j 1))
      map_add' := by intros; rfl
      map_smul' := by intros; rfl }

private def featuresMap (d k : ℕ) : Columns d k →L[ℝ] Features d k :=
  LinearMap.toContinuousLinearMap
    { toFun := fun c => ∑ j, InnerProductSpace.rankOne ℝ (c j) (EuclideanSpace.single j 1)
      map_add' := by
        intros c e
        simp only [PiLp.add_apply, map_add, ContinuousLinearMap.add_apply,
          Finset.sum_add_distrib]
      map_smul' := by
        intros a c
        simp only [PiLp.smul_apply, map_smul, ContinuousLinearMap.smul_apply,
          Finset.smul_sum, RingHom.id_apply] }

private theorem featuresMap_apply {d k : ℕ} (c : Columns d k) (x : Vec d) :
    featuresMap d k c x = ∑ j, x j • c j := by
  simp [featuresMap, InnerProductSpace.rankOne_apply, EuclideanSpace.inner_single_left]

private theorem featuresMap_columnsMap {d k : ℕ} (B : Features d k) :
    featuresMap d k (columnsMap d k B) = B := by
  apply ContinuousLinearMap.ext
  intro x
  rw [featuresMap_apply]
  change (∑ j, x j • B (EuclideanSpace.single j 1)) = B x
  simp only [← map_smul, ← map_sum]
  congr 1
  ext i
  simp [Finset.sum_apply, Pi.single_apply]

private theorem columnsMap_featuresMap {d k : ℕ} (c : Columns d k) :
    columnsMap d k (featuresMap d k c) = c := by
  apply WithLp.ofLp_injective 2
  funext j
  change featuresMap d k c (EuclideanSpace.single j 1) = c j
  simp [featuresMap_apply, PiLp.single_apply]

private def flowEquiv (d k : ℕ) : FlowSpace d k ≃L[ℝ] (Vec k × Features d k) :=
  LinearEquiv.toContinuousLinearEquiv
    { toFun := fun z => (z.fst, featuresMap d k z.snd)
      invFun := fun z => WithLp.toLp 2 (z.1, columnsMap d k z.2)
      left_inv := by
        intro z
        apply WithLp.ofLp_injective 2
        exact Prod.ext rfl (columnsMap_featuresMap _)
      right_inv := by intro z; exact Prod.ext rfl (featuresMap_columnsMap _)
      map_add' := by intros; simp
      map_smul' := by intros; simp }

private def ftField {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (z : Vec k × Features d k) : Vec k × Features d k :=
  (-headGradient X Y z.1 z.2, -featureGradient X Y z.1 z.2)

set_option backward.isDefEq.respectTransparency false in
private theorem ftField_contDiff {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n) :
    ContDiff ℝ 1 (ftField (k := k) X Y) := by
  have hW : ContDiff ℝ 1 (fun z : Vec k × Features d k => z.2.adjoint z.1) :=
    ((ContinuousLinearMap.adjoint : Features d k ≃ₗᵢ[ℝ] (Vec k →L[ℝ] Vec d)).contDiff.comp
      contDiff_snd).clm_apply contDiff_fst
  have hq : ContDiff ℝ 1 (fun z : Vec k × Features d k =>
      X.adjoint (X (z.2.adjoint z.1) - Y)) :=
    X.adjoint.contDiff.comp ((X.contDiff.comp hW).sub contDiff_const)
  let rank : Vec k →L[ℝ] Vec d →L[ℝ] Features d k := InnerProductSpace.rankOne ℝ
  have hRq : ContDiff ℝ 1 (fun z : Vec k × Features d k =>
      rank z.1 (X.adjoint (X (z.2.adjoint z.1) - Y))) :=
    rank.isBoundedBilinearMap.contDiff.comp₂ contDiff_fst hq
  unfold ftField headGradient featureGradient residual weights
  apply ContDiff.prodMk
  · exact ((contDiff_snd.clm_apply hq).const_smul (2 : ℝ)).neg
  · exact (hRq.const_smul (2 : ℝ)).neg

private theorem columns_inner_rankOne {d k : ℕ} (B : Features d k)
    (v : Vec k) (q : Vec d) :
    inner ℝ (columnsMap d k B) (columnsMap d k (InnerProductSpace.rankOne ℝ v q)) =
      inner ℝ (B q) v := by
  have hs : (∑ j, q j • B (EuclideanSpace.single j 1)) = B q := by
    simpa [featuresMap_columnsMap] using (featuresMap_apply (columnsMap d k B) q).symm
  rw [← hs, sum_inner, PiLp.inner_apply]
  apply Finset.sum_congr rfl
  intro j _
  simp [columnsMap, InnerProductSpace.rankOne_apply, EuclideanSpace.inner_single_right,
    inner_smul_left, inner_smul_right]

private theorem inner_residual_lower_bound {n : ℕ} (p Y : Vec n) :
    -(4 : ℝ) * inner ℝ p (p - Y) ≤ ‖Y‖ ^ 2 := by
  have h : 0 ≤ inner ℝ ((2 : ℝ) • p - Y) ((2 : ℝ) • p - Y) := real_inner_self_nonneg
  simp only [inner_sub_left, inner_sub_right, real_inner_smul_left,
    real_inner_smul_right, real_inner_self_eq_norm_sq, norm_smul] at h
  norm_num only [Real.norm_ofNat] at h
  rw [real_inner_comm p Y] at h
  rw [inner_sub_right, real_inner_self_eq_norm_sq]
  nlinarith

private def hilbertField {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (z : FlowSpace d k) : FlowSpace d k :=
  (flowEquiv d k).symm (ftField X Y (flowEquiv d k z))

private theorem hilbertField_contDiff {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n) :
    ContDiff ℝ 1 (hilbertField (k := k) X Y) :=
  (flowEquiv d k).symm.contDiff.comp ((ftField_contDiff X Y).comp (flowEquiv d k).contDiff)

private theorem hilbertField_radial {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (z : FlowSpace d k) :
    2 * inner ℝ z (hilbertField X Y z) ≤ 2 * ‖Y‖ ^ 2 := by
  let v := z.fst
  let B := featuresMap d k z.snd
  let q := X.adjoint (residual X Y v B)
  have hc : z.snd = columnsMap d k B := (columnsMap_featuresMap z.snd).symm
  have h1 : inner ℝ v (B q) = inner ℝ (X (weights B v)) (residual X Y v B) := by
    rw [← B.adjoint_inner_left]
    exact X.adjoint_inner_right (weights B v) (residual X Y v B)
  have h2 : inner ℝ (B q) v = inner ℝ (X (weights B v)) (residual X Y v B) := by
    rw [real_inner_comm]
    exact h1
  change 2 * (inner ℝ v (-((2 : ℝ) • B q)) +
    inner ℝ z.snd (columnsMap d k (-((2 : ℝ) • InnerProductSpace.rankOne ℝ v q)))) ≤ _
  simp only [hc, map_neg, map_smul, inner_neg_right, inner_smul_right,
    columns_inner_rankOne, h1, h2]
  have h := inner_residual_lower_bound (X (weights B v)) Y
  dsimp [residual] at *
  nlinarith

/-- The polynomial fine-tuning vector field has a unique forward trajectory. -/
theorem fineTuning_unique {n d k : ℕ} {X : Vec d →L[ℝ] Vec n} {Y : Vec n}
    {v₀ : Vec k} {B₀ : Features d k} {γ₁ γ₂ : Trajectory d k}
    (h₁ : IsFineTuningFlow X Y v₀ B₀ γ₁) (h₂ : IsFineTuningFlow X Y v₀ B₀ γ₂)
    {t : ℝ} (ht : 0 ≤ t) :
    γ₁.head t = γ₂.head t ∧ γ₁.features t = γ₂.features t := by
  let f := fun s => (γ₁.head s, γ₁.features s)
  let g := fun s => (γ₂.head s, γ₂.features s)
  have hf' : ∀ s ∈ Ici 0, HasDerivWithinAt f (ftField X Y (f s)) (Ici 0) s :=
    fun s hs => (h₁.2.2 s hs).1.prodMk (h₁.2.2 s hs).2
  have hg' : ∀ s ∈ Ici 0, HasDerivWithinAt g (ftField X Y (g s)) (Ici 0) s :=
    fun s hs => (h₂.2.2 s hs).1.prodMk (h₂.2.2 s hs).2
  have hfg := ode_unique_Icc (ftField_contDiff X Y)
    (show ContinuousOn f (Icc 0 t) from fun s hs =>
      (hf' s hs.1).continuousWithinAt.mono (fun _ hx => hx.1))
    (show ContinuousOn g (Icc 0 t) from fun s hs =>
      (hg' s hs.1).continuousWithinAt.mono (fun _ hx => hx.1))
    (fun s hs => (hf' s hs.1).mono (Ici_subset_Ici.mpr hs.1))
    (fun s hs => (hg' s hs.1).mono (Ici_subset_Ici.mpr hs.1))
    (show f 0 = g 0 by simp [f, g, h₁.1, h₂.1, h₁.2.1, h₂.2.1])
  exact Prod.mk.inj (hfg ⟨ht, le_rfl⟩)

private theorem lpField_contDiff {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (B : Features d k) : ContDiff ℝ 1 (fun v => -headGradient X Y v B) := by
  unfold headGradient residual weights
  exact ((B.contDiff.comp (X.adjoint.contDiff.comp
    ((X.contDiff.comp B.adjoint.contDiff).sub contDiff_const))).const_smul (2 : ℝ)).neg

private theorem lpField_radial {n d k : ℕ} (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (B : Features d k) (v : Vec k) :
    2 * inner ℝ v (-headGradient X Y v B) ≤ ‖Y‖ ^ 2 := by
  simp only [headGradient, inner_neg_right, inner_smul_right]
  rw [← B.adjoint_inner_left, X.adjoint_inner_right]
  have h := inner_residual_lower_bound (X (weights B v)) Y
  dsimp [residual, weights] at *
  linarith

private theorem trajectory_of_hilbert_flow {n d k : ℕ} (X : Vec d →L[ℝ] Vec n)
    (Y : Vec n) (v₀ : Vec k) (B₀ : Features d k) (γ : ℝ → FlowSpace d k)
    (h₀ : γ 0 = (flowEquiv d k).symm (v₀, B₀))
    (hγ : ∀ t : ℝ, 0 ≤ t →
      HasDerivWithinAt γ (hilbertField X Y (γ t)) (Ici 0) t) :
    ∃ δ : Trajectory d k, IsFineTuningFlow X Y v₀ B₀ δ := by
  let e := flowEquiv d k
  let f := fun t => e (γ t)
  have hf : ∀ t : ℝ, 0 ≤ t →
      HasDerivWithinAt f (ftField X Y (f t)) (Ici 0) t := by
    intro t ht
    simpa [f, e, hilbertField] using
      e.toContinuousLinearMap.hasFDerivAt.comp_hasDerivWithinAt t (hγ t ht)
  refine ⟨{ head := fun t => (f t).1, features := fun t => (f t).2 }, ?_, ?_, ?_⟩
  · simp [f, e, h₀]
  · simp [f, e, h₀]
  · intro t ht
    constructor
    · exact (ContinuousLinearMap.fst ℝ (Vec k) (Features d k)).hasFDerivAt.comp_hasDerivWithinAt
        t (hf t ht)
    · exact (ContinuousLinearMap.snd ℝ (Vec k) (Features d k)).hasFDerivAt.comp_hasDerivWithinAt
        t (hf t ht)

/-- Global forward existence for the two gradient flows, and uniqueness for fine-tuning. -/
theorem GradientFlowWellPosed :
  ∀ (n d k : ℕ) (X : Vec d →L[ℝ] Vec n) (Y : Vec n)
    (v₀ : Vec k) (B₀ : Features d k),
    (∃ γ : Trajectory d k, IsFineTuningFlow X Y v₀ B₀ γ) ∧
    (∀ γ₁ γ₂ : Trajectory d k,
      IsFineTuningFlow X Y v₀ B₀ γ₁ → IsFineTuningFlow X Y v₀ B₀ γ₂ →
      ∀ t : ℝ, 0 ≤ t → γ₁.head t = γ₂.head t ∧ γ₁.features t = γ₂.features t) ∧
    (∃ v : ℝ → Vec k, IsLinearProbingFlow X Y v₀ B₀ v) := by
  intro n d k X Y v₀ B₀
  refine ⟨?_, ?_, ?_⟩
  · obtain ⟨γ, h₀, hγ⟩ := exists_forward_solution_of_radial_bound
      (hilbertField (k := k) X Y) (hilbertField_contDiff X Y)
      (2 * ‖Y‖ ^ 2) (by positivity) (hilbertField_radial X Y)
      ((flowEquiv d k).symm (v₀, B₀))
    exact trajectory_of_hilbert_flow X Y v₀ B₀ γ h₀ hγ
  · intro γ₁ γ₂ h₁ h₂ t ht
    exact fineTuning_unique h₁ h₂ ht
  · obtain ⟨v, h₀, hv⟩ := exists_forward_solution_of_radial_bound
      (fun v => -headGradient X Y v B₀) (lpField_contDiff X Y B₀)
      (‖Y‖ ^ 2) (sq_nonneg _) (lpField_radial X Y B₀) v₀
    exact ⟨v, h₀, hv⟩

end FeatureDistortion
