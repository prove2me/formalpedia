theorem jKerG_out_bnd (h : SegReg P R s t lam w α) (hG : (LJ s t lam w).length ≤ G)
    (x : List GI) (hx : x.length = G) (h1 : Bnd Bv (x.map Prod.fst))
    (h2 : Bnd Bv (x.map Prod.snd)) :
    ∀ y ∈ liftG (jKer P R s t lam w α K G) x, |y.1| ≤ jWb P w K Bv ∧ |y.2| ≤ jWb P w K Bv := by
