            intro htop
            have hmem : ((c₁ : ↥F₀))⁻¹ ∈ V := by rw [htop]; exact ValuationSubring.mem_top _
            obtain ⟨b', c', hc'P, e⟩ := (hV _).mp hmem
            apply hc'P
            have hc₁F : (c₁ : ↥F₀) ≠ 0 := fun h => hc₁0 (Subtype.ext h)
