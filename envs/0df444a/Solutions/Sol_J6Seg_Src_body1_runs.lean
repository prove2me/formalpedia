      rw [e2] at h
      have e : update (update (S (j + 1)) 43 [(j : ℤ) + 1]) Y (((2 ^ (m - j) : ℕ) : ℤ) :: F Y) =
          update (S j) 43 [(j : ℤ) + 1] := by
