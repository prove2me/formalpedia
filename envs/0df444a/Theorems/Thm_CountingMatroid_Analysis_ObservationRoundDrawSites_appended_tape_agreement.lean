theorem CountingMatroid.Analysis.ObservationRoundDrawSites.appended_tape_agreement (pref suffix other : List Bool) (stop : ℕ)
    (hlen : suffix.length = other.length)
    (hp : suffix.take (stop - pref.length) <+: other) :
    ∀ i < stop, ((pref ++ suffix)[i]?).getD false =
      ((pref ++ other)[i]?).getD false := by sorry
