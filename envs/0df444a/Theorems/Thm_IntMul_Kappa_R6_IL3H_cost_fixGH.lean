--       (hx : x + ((negSteps (m := m) U.toList).map (fun _ => 0 + (0 + 2) * W)).sum ≤ H) :
--       costL (phCostFH W m Z Bn t S0 r F) (fun _ => 0 + (0 + 2) * W) (negSteps (m := m) U.toList)
