    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (fun e => Sym2.ind (fun u v hu => by simpa using h u v (by simpa using hu)) e))
    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (fun e => Sym2.ind (fun u v hu => by simpa using h (by simpa using hu)) e))
