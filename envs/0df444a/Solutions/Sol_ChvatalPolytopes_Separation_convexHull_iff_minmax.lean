open Classical

/-- the cone generated by a finite family -/
def chm_cone {ι E : Type*} [Fintype ι] [AddCommGroup E] [Module ℝ E] (v : ι → E) : Set E :=
  {x | ∃ l : ι → ℝ, (∀ i, 0 ≤ l i) ∧ x = ∑ i, l i • v i}

def chm_Ls {ι E : Type*} [AddCommGroup E] [Module ℝ E] (v : ι → E) (s : Finset ι) :
    (s → ℝ) →ₗ[ℝ] E where
  toFun μ := ∑ i, μ i • v i
  map_add' a b := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c a := by simp [Finset.smul_sum, smul_smul]

lemma chm_sum_sub {ι E : Type*} [Fintype ι] [AddCommGroup E] (s : Finset ι) (f : ι → E)
    (h : ∀ i, i ∉ s → f i = 0) : ∑ i : s, f i = ∑ i, f i := by
  rw [Finset.sum_coe_sort s f]
  exact Finset.sum_subset (Finset.subset_univ _) (fun i _ hi => h i hi)

lemma chm_carath {ι E : Type*} [Fintype ι] [AddCommGroup E] [Module ℝ E] (v : ι → E) :
    ∀ n : ℕ, ∀ l : ι → ℝ, (∀ i, 0 ≤ l i) → (Finset.univ.filter (fun i => l i ≠ 0)).card = n →
      ∃ s : Finset ι, LinearIndependent ℝ (fun i : s => v i) ∧
        ∃ μ : s → ℝ, (∀ i, 0 ≤ μ i) ∧ ∑ i, l i • v i = ∑ i, μ i • v i := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro l hl hn
  set s := Finset.univ.filter (fun i => l i ≠ 0) with hs
  have hsum_s : ∑ i, l i • v i = ∑ i : s, l i • v i := by
    symm
    apply chm_sum_sub s (fun i => l i • v i)
    intro i hi
    have : l i = 0 := by
      by_contra h; exact hi (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
    simp [this]
  by_cases hli : LinearIndependent ℝ (fun i : s => v i)
  · exact ⟨s, hli, fun i => l i, fun i => hl i, hsum_s⟩
  rw [Fintype.not_linearIndependent_iff] at hli
  obtain ⟨g0, hg0, i0, hi0⟩ := hli
  -- make some coefficient positive
  obtain ⟨g, hg, j0, hj0⟩ : ∃ g : s → ℝ, ∑ i, g i • v i = 0 ∧ ∃ j, 0 < g j := by
    rcases lt_or_gt_of_ne hi0 with h | h
    · refine ⟨fun i => -g0 i, ?_, i0, by linarith⟩
      simp only [neg_smul, Finset.sum_neg_distrib, hg0, neg_zero]
    · exact ⟨g0, hg0, i0, h⟩
  let μ : ι → ℝ := fun i => if h : i ∈ s then g ⟨i, h⟩ else 0
  have hμsum : ∑ i, μ i • v i = 0 := by
    rw [← hg]
    have : ∑ i : s, g i • v i = ∑ i : s, μ i • v i := by
      apply Finset.sum_congr rfl; intro i _; simp [μ, i.2]
    rw [this]
    exact (chm_sum_sub s (fun i => μ i • v i) (fun i hi => by simp [μ, hi])).symm
  have hμoff : ∀ i, i ∉ s → μ i = 0 := by intro i hi; simp [μ, hi]
  set P := s.filter (fun i => 0 < μ i) with hP
  have hPne : P.Nonempty := ⟨j0, Finset.mem_filter.2 ⟨j0.2, by simp [μ, j0.2, hj0]⟩⟩
  obtain ⟨i1, hi1P, hmin⟩ := P.exists_min_image (fun i => l i / μ i) hPne
  rw [Finset.mem_filter] at hi1P
  set θ := l i1 / μ i1 with hθ
  have hθnn : 0 ≤ θ := div_nonneg (hl i1) hi1P.2.le
  let l' : ι → ℝ := fun i => l i - θ * μ i
  have hl' : ∀ i, 0 ≤ l' i := by
    intro i
    simp only [l']
    by_cases hμ : 0 < μ i
    · by_cases his : i ∈ s
      · have := hmin i (Finset.mem_filter.2 ⟨his, hμ⟩)
        rw [le_div_iff₀ hμ] at this
        linarith
      · rw [hμoff i his] at hμ; exact absurd hμ (lt_irrefl 0)
    · push_neg at hμ
      have := hl i
      nlinarith
  have hl'sum : ∑ i, l' i • v i = ∑ i, l i • v i := by
    simp only [l', sub_smul, Finset.sum_sub_distrib, mul_smul, ← Finset.smul_sum, hμsum,
      smul_zero, sub_zero]
  have hsub : Finset.univ.filter (fun i => l' i ≠ 0) ⊆ s.erase i1 := by
    intro i hi
    rw [Finset.mem_filter] at hi
    rw [Finset.mem_erase]
    constructor
    · rintro rfl
      apply hi.2
      simp only [l', hθ]
      rw [div_mul_cancel₀ _ hi1P.2.ne', sub_self]
    · by_contra his
      apply hi.2
      simp only [l']
      have h1 : l i = 0 := by
        by_contra h; exact his (Finset.mem_filter.2 ⟨Finset.mem_univ _, h⟩)
      rw [h1, hμoff i his]; ring
  have hlt : (Finset.univ.filter (fun i => l' i ≠ 0)).card < n := by
    calc _ ≤ (s.erase i1).card := Finset.card_le_card hsub
      _ < s.card := Finset.card_erase_lt_of_mem hi1P.1
      _ = n := hn
  obtain ⟨s', h1, μ', h2, h3⟩ := ih _ hlt l' hl' rfl
  exact ⟨s', h1, μ', h2, hl'sum ▸ h3⟩

lemma chm_cone_closed {ι E : Type*} [Fintype ι] [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] (v : ι → E) : IsClosed (chm_cone v) := by
  have heq : chm_cone v = ⋃ s ∈ (Finset.univ.filter
      (fun s : Finset ι => LinearIndependent ℝ (fun i : s => v i)) : Set (Finset ι)),
      (chm_Ls v s) '' {μ | ∀ i, 0 ≤ μ i} := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_image, Finset.coe_filter, Set.mem_setOf_eq,
      Finset.mem_univ, true_and]
    constructor
    · rintro ⟨l, hl, rfl⟩
      obtain ⟨s, hs, μ, hμ, he⟩ := chm_carath v _ l hl rfl
      exact ⟨s, hs, μ, hμ, he.symm⟩
    · rintro ⟨s, _, μ, hμ, rfl⟩
      refine ⟨fun i => if h : i ∈ s then μ ⟨i, h⟩ else 0, ?_, ?_⟩
      · intro i; dsimp only; split_ifs
        · exact hμ _
        · exact le_rfl
      · show ∑ i, μ i • v i = _
        have : ∑ i : s, μ i • v i =
            ∑ i : s, (fun j => (if h : j ∈ s then μ ⟨j, h⟩ else 0) • v j) i := by
          apply Finset.sum_congr rfl; intro i _; simp [i.2]
        rw [this]
        exact chm_sum_sub s (fun j => (if h : j ∈ s then μ ⟨j, h⟩ else 0) • v j)
          (fun i hi => by simp [hi])
  rw [heq]
  apply Set.Finite.isClosed_biUnion (Set.toFinite _)
  intro s hs
  simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hs
  have hker : LinearMap.ker (chm_Ls v s) = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro μ hμ
    rw [Fintype.linearIndependent_iff] at hs
    funext i
    exact hs μ hμ i
  have hemb := LinearMap.isClosedEmbedding_of_injective hker
  apply hemb.isClosedMap
  have : {μ : s → ℝ | ∀ i, 0 ≤ μ i} = ⋂ i, {μ : s → ℝ | 0 ≤ μ i} := by ext; simp
  rw [this]
  exact isClosed_iInter (fun i => isClosed_le continuous_const (continuous_apply i))

lemma chm_hull_le {V : Type*} [Fintype V] (S : Finset (V → ℝ)) (hS : S.Nonempty) (c : V → ℝ)
    (x : V → ℝ) (hx : x ∈ convexHull ℝ (S : Set (V → ℝ))) :
    ∑ u, c u * x u ≤ S.sup' hS (fun x => ∑ u, c u * x u) := by
  suffices hsub : convexHull ℝ (S : Set (V → ℝ)) ⊆
      {x | ∑ u, c u * x u ≤ S.sup' hS (fun x => ∑ u, c u * x u)} from hsub hx
  apply convexHull_min
  · intro y hy
    exact Finset.le_sup' (fun x => ∑ u, c u * x u) (Finset.mem_coe.1 hy)
  · intro y hy z hz s t hs ht hst
    simp only [Set.mem_setOf_eq, Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add,
      Finset.sum_add_distrib] at hy hz ⊢
    have e1 : ∑ u, c u * (s * y u) = s * ∑ u, c u * y u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    have e2 : ∑ u, c u * (t * z u) = t * ∑ u, c u * z u := by
      rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro u _; ring
    rw [e1, e2]
    have := mul_le_mul_of_nonneg_left hy hs
    have := mul_le_mul_of_nonneg_left hz ht
    have : S.sup' hS (fun x => ∑ u, c u * x u) =
      s * S.sup' hS (fun x => ∑ u, c u * x u) + t * S.sup' hS (fun x => ∑ u, c u * x u) := by
      rw [← add_mul, hst, one_mul]
    linarith

lemma chm_weak {V J : Type*} [Fintype V] [Fintype J] (a : J → V → ℝ) (b : J → ℝ) (c : V → ℝ)
    (x : V → ℝ) (hx0 : ∀ u, 0 ≤ x u) (hx : ∀ i, ∑ u, a i u * x u ≤ b i)
    (lam : J → ℝ) (hl0 : ∀ i, 0 ≤ lam i) (hl : ∀ u, c u ≤ ∑ i, lam i * a i u) :
    ∑ u, c u * x u ≤ ∑ i, lam i * b i := by
  calc ∑ u, c u * x u ≤ ∑ u, (∑ i, lam i * a i u) * x u :=
        Finset.sum_le_sum (fun u _ => mul_le_mul_of_nonneg_right (hl u) (hx0 u))
    _ = ∑ i, lam i * ∑ u, a i u * x u := by
        simp only [Finset.sum_mul, Finset.mul_sum]
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl; intro i _
        apply Finset.sum_congr rfl; intro u _
        ring
    _ ≤ ∑ i, lam i * b i :=
        Finset.sum_le_sum (fun i _ => mul_le_mul_of_nonneg_left (hx i) (hl0 i))

/-- generators of the dual cone, living in `Option V → ℝ` -/
def chm_gen {V J : Type*} [DecidableEq V] (a : J → V → ℝ) (b : J → ℝ) :
    J ⊕ V ⊕ Unit → Option V → ℝ
  | Sum.inl i => fun o => match o with
      | none => b i
      | some u => a i u
  | Sum.inr (Sum.inl u) => fun o => match o with
      | none => 0
      | some u' => if u' = u then -1 else 0
  | Sum.inr (Sum.inr _) => fun o => match o with
      | none => 1
      | some _ => 0

lemma chm_dual {V J : Type*} [Fintype V] [Fintype J] [DecidableEq V]
    (a : J → V → ℝ) (b : J → ℝ) (S : Finset (V → ℝ)) (hS : S.Nonempty)
    (hP : {x : V → ℝ | (∀ u, 0 ≤ x u) ∧ ∀ i, ∑ u, a i u * x u ≤ b i} = convexHull ℝ (S : Set (V → ℝ)))
    (c : V → ℝ) :
    ∃ lam : J → ℝ, (∀ i, 0 ≤ lam i) ∧ (∀ u, c u ≤ ∑ i, lam i * a i u) ∧
      ∑ i, lam i * b i ≤ S.sup' hS (fun x => ∑ u, c u * x u) := by
  set M := S.sup' hS (fun x => ∑ u, c u * x u) with hM
  let t : Option V → ℝ := fun o => match o with
    | none => M
    | some u => c u
  by_cases ht : t ∈ chm_cone (chm_gen a b)
  · obtain ⟨l, hl0, hl⟩ := ht
    refine ⟨fun i => l (Sum.inl i), fun i => hl0 _, ?_, ?_⟩
    · intro u
      have := congrFun hl (some u)
      simp only [t, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Fintype.sum_sum_type,
        chm_gen, Fintype.sum_unique] at this
      simp only [mul_ite, mul_neg, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
        Finset.mem_univ, if_true, add_zero] at this
      have := hl0 (Sum.inr (Sum.inl u))
      show c u ≤ ∑ i, l (Sum.inl i) * a i u
      linarith
    · have := congrFun hl none
      simp only [t, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Fintype.sum_sum_type,
        chm_gen, Fintype.sum_unique, mul_zero, Finset.sum_const_zero, mul_one] at this
      have := hl0 (Sum.inr (Sum.inr ()))
      linarith
  · exfalso
    have hconv : Convex ℝ (chm_cone (chm_gen a b)) := by
      rintro x ⟨l1, h1, rfl⟩ y ⟨l2, h2, rfl⟩ p q hp hq _
      refine ⟨fun i => p * l1 i + q * l2 i, fun i => by have := h1 i; have := h2 i; positivity, ?_⟩
      simp only [Finset.smul_sum, smul_smul, add_smul, Finset.sum_add_distrib]
    obtain ⟨f, u0, hfu, hfc⟩ := geometric_hahn_banach_point_closed hconv
      (chm_cone_closed (chm_gen a b)) ht
    have h0 : (0 : Option V → ℝ) ∈ chm_cone (chm_gen a b) :=
      ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
    have hu0 : u0 < 0 := by simpa using hfc 0 h0
    have hgen : ∀ k, 0 ≤ f (chm_gen a b k) := by
      intro k
      by_contra hneg
      push_neg at hneg
      set r := u0 / f (chm_gen a b k) with hr
      have hrpos : 0 < r := div_pos_of_neg_of_neg hu0 hneg
      have hmem : r • chm_gen a b k ∈ chm_cone (chm_gen a b) := by
        refine ⟨fun k' => if k' = k then r else 0, fun k' => by show 0 ≤ (if k' = k then r else 0); split_ifs <;> linarith, ?_⟩
        simp
      have := hfc _ hmem
      rw [map_smul, smul_eq_mul, hr, div_mul_cancel₀ _ hneg.ne] at this
      exact lt_irrefl _ this
    set φ : Option V → ℝ := fun o => f (fun j => if o = j then 1 else 0) with hφ
    have hf : ∀ w, f w = ∑ o, w o * φ o := by
      intro w
      have := f.toLinearMap.pi_apply_eq_sum_univ w
      simpa [smul_eq_mul] using this
    set s := φ none
    set y : V → ℝ := fun u => φ (some u)
    have hgi : ∀ i, 0 ≤ b i * s + ∑ u, a i u * y u := by
      intro i
      have := hgen (Sum.inl i)
      rw [hf, Fintype.sum_option] at this
      simpa [chm_gen] using this
    have hgu : ∀ u, y u ≤ 0 := by
      intro u
      have := hgen (Sum.inr (Sum.inl u))
      rw [hf, Fintype.sum_option] at this
      simp [chm_gen] at this
      simpa [y] using this
    have hgs : 0 ≤ s := by
      have := hgen (Sum.inr (Sum.inr ()))
      rw [hf, Fintype.sum_option] at this
      simpa [chm_gen] using this
    have hft : M * s + ∑ u, c u * y u < 0 := by
      have := hfu.trans hu0
      rw [hf, Fintype.sum_option] at this
      simpa [t] using this
    rcases hgs.lt_or_eq with hspos | hs0
    · -- x = -y/s is feasible with objective > M
      set x : V → ℝ := fun u => -y u / s
      have hxP : x ∈ convexHull ℝ (S : Set (V → ℝ)) := by
        rw [← hP]
        refine ⟨fun u => div_nonneg (by linarith [hgu u]) hspos.le, fun i => ?_⟩
        have : ∑ u, a i u * x u = -(∑ u, a i u * y u) / s := by
          simp only [x, Finset.sum_div, ← Finset.sum_neg_distrib]
          apply Finset.sum_congr rfl; intro u _; ring
