open ModularCurve AlgebraicCurve AlgebraicGeometry AlgebraicGeometry.Scheme Opposite

set_option autoImplicit false

noncomputable section

private def gammaTermEquivInt : Γ((fppfTerminal specInt).left, ⊤) ≃+* ℤ :=
  (Scheme.ΓSpecIso (CommRingCat.of ℤ)).commRingCatIsoToRingEquiv

private def gammaTermToQbar : Γ((fppfTerminal specInt).left, ⊤) →+* AlgebraicClosure ℚ :=
  (Int.castRingHom (AlgebraicClosure ℚ)).comp gammaTermEquivInt.toRingHom

private lemma gammaTermToQbar_injective : Function.Injective gammaTermToQbar := by
  intro a b h
  apply gammaTermEquivInt.injective
  apply (Int.cast_injective : Function.Injective (Int.cast : ℤ → AlgebraicClosure ℚ))
  simpa [gammaTermToQbar, RingHom.comp_apply] using h

private def gammaTermToQbarAlg : Γ((fppfTerminal specInt).left, ⊤) →ₐ[ℤ] AlgebraicClosure ℚ where
  toRingHom := gammaTermToQbar
  commutes' := fun n => by
    rw [eq_intCast (algebraMap ℤ (Γ((fppfTerminal specInt).left, ⊤))) n,
        eq_intCast (algebraMap ℤ (AlgebraicClosure ℚ)) n]
    exact map_intCast gammaTermToQbar n

section Chain

variable {p q : ℕ} [Fact p.Prime] [Fact q.Prime]
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime p}

private def h0Point (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ)
    (s : fppfCohomology specInt (S.core.𝒥 m) 0) : S.core.H m →ₐ[ℤ] AlgebraicClosure ℚ :=
  gammaTermToQbarAlg.comp (WithConv.ofConv (Additive.toMul
    ((S.core.sectionsEquiv m (fppfTerminal specInt))
      ((fppfCohomologySpecIntZeroAddEquiv (S.core.𝒥 m)) s))))

private def h0J (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ)
    (s : fppfCohomology specInt (S.core.𝒥 m) 0) : JZero p :=
  ((S.core.genericPoints m (WithConv.toConv (h0Point S m s)) :
    ↥(eisensteinPrimaryTorsionBar p q m)) : JZero p)

private lemma h0J_injective (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ) :
    Function.Injective (h0J S m) := by
  intro s t h
  have h1 : WithConv.toConv (h0Point S m s) = WithConv.toConv (h0Point S m t) :=
    (S.core.genericPoints m).injective (Subtype.coe_injective h)
  have h2 : h0Point S m s = h0Point S m t := WithConv.toConv_injective h1
  have h4 : WithConv.ofConv (Additive.toMul ((S.core.sectionsEquiv m (fppfTerminal specInt))
        ((fppfCohomologySpecIntZeroAddEquiv (S.core.𝒥 m)) s)))
      = WithConv.ofConv (Additive.toMul ((S.core.sectionsEquiv m (fppfTerminal specInt))
        ((fppfCohomologySpecIntZeroAddEquiv (S.core.𝒥 m)) t))) :=
    AlgHom.ext fun x => gammaTermToQbar_injective (DFunLike.congr_fun h2 x)
  have h5 := WithConv.ofConv_injective h4
  have h6 := Additive.toMul.injective h5
  have h7 := (S.core.sectionsEquiv m (fppfTerminal specInt)).injective h6
  exact (fppfCohomologySpecIntZeroAddEquiv (S.core.𝒥 m)).injective h7

private lemma h0J_fixed (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ)
    (s : fppfCohomology specInt (S.core.𝒥 m) 0)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    σ • h0J S m s = h0J S m s := by
  refine (S.core.genericGalois m σ (WithConv.toConv (h0Point S m s))
    (WithConv.toConv (h0Point S m s)) ?_).symm
  intro x
  exact (map_intCast σ (gammaTermEquivInt (WithConv.ofConv (Additive.toMul
    ((S.core.sectionsEquiv m (fppfTerminal specInt))
      ((fppfCohomologySpecIntZeroAddEquiv (S.core.𝒥 m)) s))) x))).symm

private lemma h0J_qpow_smul (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ)
    (s : fppfCohomology specInt (S.core.𝒥 m) 0) :
    (q ^ m) • h0J S m s = 0 := by

  have hmem : h0J S m s ∈ eisensteinPrimaryTorsionBar p q m :=
    (S.core.genericPoints m (WithConv.toConv (h0Point S m s))).2
  have h1 : ((q : ℤ) ^ m) • h0J S m s = 0 := by
    simpa using (AddMonoidHom.mem_ker.mp hmem.1)
  rw [← natCast_zsmul, Nat.cast_pow]
  exact h1

end Chain

section Target

variable (p : ℕ) [NeZero p]

private abbrev mwGroup : AddSubgroup (JZero p) :=
  FixedPoints.addSubgroup ((AlgebraicClosure ℚ) ≃ₐ[ℚ] (AlgebraicClosure ℚ)) (JZero p)

private abbrev mwTorsion : Submodule ℤ ↥(mwGroup p) :=
  Submodule.torsion ℤ ↥(mwGroup p)

private lemma mwTorsion_finite [Fact p.Prime] : Finite ↥(mwTorsion p) := by
  by_cases hp5 : 5 ≤ p
  · haveI : Module.Finite ℤ ↥(mwGroup p) :=
      Module.Finite.iff_addGroup_fg.mpr
        (ModularCurve.JZero.addGroup_fg_invariants_rat_of_prime_of_five_le p Fact.out hp5)
    haveI : Module.Finite ℤ ↥(mwTorsion p) :=
      Module.Finite.iff_fg.mpr (IsNoetherian.noetherian _)
    exact Module.finite_of_fg_torsion _ Submodule.torsion_isTorsion
  · haveI : Subsingleton (JZero p) := ModularCurve.subsingleton_jZero_of_lt_five p (by omega)
    infer_instance

end Target

section Theta

variable {p q : ℕ} [Fact p.Prime] [Fact q.Prime]
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime p}

private def theta (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ)
    (s : fppfCohomology specInt (S.core.𝒥 m) 0) : ↥(mwTorsion p) :=
  ⟨⟨h0J S m s, by rw [FixedPoints.mem_addSubgroup]; exact h0J_fixed S m s⟩, by
    rw [Submodule.mem_torsion_iff]
    refine ⟨⟨(q : ℤ) ^ m, mem_nonZeroDivisors_of_ne_zero (pow_ne_zero m ?_)⟩, ?_⟩
    · exact_mod_cast (Fact.out : q.Prime).ne_zero
    · apply Subtype.ext
      show ((q : ℤ) ^ m) • h0J S m s = (0 : JZero p)
      rw [← Nat.cast_pow, natCast_zsmul]
      exact h0J_qpow_smul S m s⟩

private lemma theta_injective (S : JZeroNeronPrimaryTorsionSheaf p q A hA) (m : ℕ) :
    Function.Injective (theta S m) := by
  intro s t h
  exact h0J_injective S m
    (congrArg (fun z : ↥(mwTorsion p) => ((z : ↥(mwGroup p)) : JZero p)) h)

end Theta

theorem solution (p : ℕ) [Fact p.Prime]
    (hcomm : HeckeOperatorsCommuteBar p) (q : ℕ) [Fact q.Prime]
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (S : JZeroNeronPrimaryTorsionSheaf p q A hA) :
    ∃ H₀ : ℕ, ∀ m : ℕ, (S.invPins.inv m).h0 ≤ H₀ := by
  have _ := hcomm
  haveI : Finite ↥(mwTorsion p) := mwTorsion_finite p
  refine ⟨Nat.card ↥(mwTorsion p), fun m => ?_⟩
  have hcard : Nat.card (fppfCohomology specInt (S.core.𝒥 m) 0) ≤ Nat.card ↥(mwTorsion p) :=
    Nat.card_le_card_of_injective (theta S m) (theta_injective S m)
  rw [S.invPins.h0_pin m] at hcard
  exact le_of_lt (lt_of_lt_of_le (Nat.lt_pow_self (Fact.out : q.Prime).one_lt) hcard)

end

