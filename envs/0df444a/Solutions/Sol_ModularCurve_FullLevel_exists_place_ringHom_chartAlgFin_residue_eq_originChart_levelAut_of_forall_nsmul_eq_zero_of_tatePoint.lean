open IsLocalRing

theorem natCast_mem_maximalIdeal_comap (q : ℕ)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    ((q : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  obtain ⟨u, hu⟩ := hu.exists_right_inv
  have hqA : ((q : ℕ) : AlgebraicClosure ℚ) ∈ A := natCast_mem A q
  have huA : (((u : ↥k₀)) : AlgebraicClosure ℚ) ∈ A := ValuationSubring.mem_comap.mp u.2
  have h1 : (⟨(q : AlgebraicClosure ℚ), hqA⟩ : ↥A) * ⟨_, huA⟩ = 1 := by
    apply Subtype.ext
    have := congrArg (fun z : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) => (((z : ↥k₀)) : AlgebraicClosure ℚ)) hu
    simpa using this
  have hunit : IsUnit (⟨(q : AlgebraicClosure ℚ), hqA⟩ : ↥A) := isUnit_iff_exists_inv.mpr ⟨_, h1⟩
  have hmax : (⟨(q : AlgebraicClosure ℚ), hqA⟩ : ↥A) ∈ maximalIdeal ↥A :=
    (ValuationSubring.coe_mem_nonunits_iff).mp hA
  exact ((IsLocalRing.mem_maximalIdeal _).mp hmax) hunit

theorem charP_residueField_of_natCast_mem (R : Type*) [CommRing R] [IsLocalRing R] (q : ℕ) [hq : Fact q.Prime]
    (h : (q : R) ∈ maximalIdeal R) : CharP (ResidueField R) q := by
  have h0 : ((q : ℕ) : ResidueField R) = 0 := by
    rw [← map_natCast (IsLocalRing.residue R), IsLocalRing.residue_eq_zero_iff]; exact h
  exact (CharP.charP_iff_prime_eq_zero hq.out).mpr h0

theorem isUnit_natCast_of_not_dvd (R : Type*) [CommRing R] [IsLocalRing R] (q : ℕ) [hq : Fact q.Prime]
    (h : (q : R) ∈ maximalIdeal R) (n : ℕ) (hn : ¬ q ∣ n) : IsUnit (n : R) := by
  haveI := charP_residueField_of_natCast_mem R q h
  by_contra hnu
  have hmem : (n : R) ∈ maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
  have h0 : ((n : ℕ) : ResidueField R) = 0 := by
    rw [← map_natCast (IsLocalRing.residue R), IsLocalRing.residue_eq_zero_iff]; exact hmem
  exact hn ((CharP.cast_eq_zero_iff (ResidueField R) q n).mp h0)

theorem exists_coe_eq_of_pow_eq_one
    (A : ValuationSubring (AlgebraicClosure ℚ)) (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ))
    (ξ : ↥k₀) (n : ℕ) (hn : n ≠ 0) (hξ : ξ ^ n = 1) :
    ∃ x : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))), (x : ↥k₀) = ξ := by
  have hmem : ((ξ : ↥k₀) : AlgebraicClosure ℚ) ∈ A := by
    rw [← A.valuation_le_one_iff]
    have hpow : A.valuation ((ξ : ↥k₀) : AlgebraicClosure ℚ) ^ n = 1 := by
      rw [← map_pow]
      have : ((ξ : ↥k₀) : AlgebraicClosure ℚ) ^ n = (((ξ ^ n : ↥k₀)) : AlgebraicClosure ℚ) := by push_cast; rfl
      rw [this, hξ]; simp
    exact ((pow_eq_one_iff.mp hpow).resolve_right hn).le
  exact ⟨⟨ξ, ValuationSubring.mem_comap.mpr hmem⟩, rfl⟩

