    refine ⟨(if χ₂ τ = 1 then (1 : (ℍ[ℚ, a₁, b₁])ˣ) else w₂ j) * ((w₂ j * w₂ j) * w₂ j ^ u) * ((w₂ j * w₂ j) * wbar₂ j ^ v),
