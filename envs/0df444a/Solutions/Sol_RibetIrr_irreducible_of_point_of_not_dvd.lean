      = (((p : ℤ_[p]) ^ k) • ⊤ : Submodule ℤ_[p] (O ⊗[ℤ_[p]] T)) := by
  have hsc : ∀ m : O ⊗[ℤ_[p]] T, (p : O) ^ k • m = ((p : ℤ_[p]) ^ k) • m := by
    intro m
    have : ((p : O) ^ k) = algebraMap ℤ_[p] O ((p : ℤ_[p]) ^ k) := by
      rw [map_pow, map_natCast]
    rw [this, algebraMap_smul]
  ext m
  simp only [Submodule.restrictScalars_mem, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and]
  constructor
  · rintro ⟨b, hb⟩
    exact ⟨b, by rw [← hsc b, hb]⟩
  · rintro ⟨b, hb⟩
    exact ⟨b, by rw [hsc b, hb]⟩

