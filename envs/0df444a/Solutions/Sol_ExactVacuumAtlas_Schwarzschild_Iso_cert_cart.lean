  rw [← pd_reflX x k i]
  exact hasDerivAt_pd hU ((contDiffOn_pi.mp (contDiffOn_reflX U)) k) hx i
theorem hasDerivAt_pd_rotC {U : Set (Pt 4)} (hU : IsOpen U) {x : Pt 4} (hx : x ∈ U) (k i : Fin 4) :
    HasDerivAt (fun u => rotC (Function.update x i u) k) (jacRotC k i) (x i) := by
  rw [← pd_rotC x k i]
  exact hasDerivAt_pd hU ((contDiffOn_pi.mp (contDiffOn_rotC U)) k) hx i

theorem pullback_reflX (M : ℝ) (x : Pt 4) :
    jacReflXᵀ * metricMatrix (gIsoCart M) (reflX x) * jacReflX = metricMatrix (gIsoCart M) x := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_four,
    metricMatrix, gIsoCart, jacReflX, rho_reflX]
theorem pullback_rotC (M : ℝ) (x : Pt 4) :
    jacRotCᵀ * metricMatrix (gIsoCart M) (rotC x) * jacRotC = metricMatrix (gIsoCart M) x := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_four,
    metricMatrix, gIsoCart, jacRotC, rho_rotC]

theorem isOpen_domRefl (M : ℝ) : IsOpen (domRefl M) :=
  (isOpen_domCartSlit M).preimage continuous_reflX
theorem isOpen_domRot (M : ℝ) : IsOpen (domRot M) :=
  (isOpen_domCartSlit M).preimage continuous_rotC

variable {M : ℝ}

theorem relation_reflX (M : ℝ) :
    CoordRelation (gIsoCart M) (gIsoCart M) (domRefl M) (domCartSlit M) reflX reflX
      (fun _ => jacReflX) where
  left_inv x _ := reflX_reflX x
  right_inv y _ := reflX_reflX y
  bijOn := Set.InvOn.bijOn ⟨fun x _ => reflX_reflX x, fun y _ => reflX_reflX y⟩
    (fun _ hx => hx) (fun y hy => by show reflX (reflX y) ∈ domCartSlit M; rw [reflX_reflX]; exact hy)
  smooth := contDiffOn_reflX _
  smooth_inv := contDiffOn_reflX _
  jacobian _ hx k i := hasDerivAt_pd_reflX (isOpen_domRefl M) hx k i
  pullback x _ := pullback_reflX M x

theorem relation_rotC (M : ℝ) :
    CoordRelation (gIsoCart M) (gIsoCart M) (domRot M) (domCartSlit M) rotC rotCInv
      (fun _ => jacRotC) where
  left_inv x _ := rotCInv_rotC x
  right_inv y _ := rotC_rotCInv y
  bijOn := Set.InvOn.bijOn ⟨fun x _ => rotCInv_rotC x, fun y _ => rotC_rotCInv y⟩
    (fun _ hx => hx) (fun y hy => by show rotC (rotCInv y) ∈ domCartSlit M; rw [rotC_rotCInv]; exact hy)
  smooth := contDiffOn_rotC _
  smooth_inv := contDiffOn_rotCInv _
  jacobian _ hx k i := hasDerivAt_pd_rotC (isOpen_domRot M) hx k i
  pullback x _ := pullback_rotC M x

/-- `giIsoCart · gIsoCart = 1` wherever `ρ > 0`, `ρ ≠ M/2` (`M ≥ 0`). -/
theorem giIsoCart_mul_gIsoCart_prime (hM : 0 ≤ M) {y : Pt 4} (hρ : 0 < rho y) (hne : rho y ≠ M / 2) :
    metricMatrix (giIsoCart M) y * metricMatrix (gIsoCart M) y = 1 := by
  have h2 : 2 * rho y + M ≠ 0 := by positivity
  have hA : Af M (rho y) ≠ 0 := by
    rw [Af_eq M _ hρ.ne' h2]; exact div_ne_zero (fun h => hne (by linarith)) h2
  have hB : Bf M (rho y) ≠ 0 := by
    rw [Bf_eq M _ hρ.ne']; exact div_ne_zero h2 (by positivity)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, metricMatrix, gIsoCart, giIsoCart] <;>
    field_simp

theorem domRefl_nonempty (hM : 0 ≤ M) : (domRefl M).Nonempty := by
  obtain ⟨p, hp⟩ := domCartSlit_nonempty hM
  exact ⟨reflX p, by show reflX (reflX p) ∈ domCartSlit M; rw [reflX_reflX]; exact hp⟩
theorem domRot_nonempty (hM : 0 ≤ M) : (domRot M).Nonempty := by
  obtain ⟨p, hp⟩ := domCartSlit_nonempty hM
  exact ⟨rotCInv p, by show rotC (rotCInv p) ∈ domCartSlit M; rw [rotC_rotCInv]; exact hp⟩

theorem cert_domRefl (hM : 0 ≤ M) : VacuumCertificate (gIsoCart M) (giIsoCart M) (domRefl M) :=
  VacuumCertificate.transport_of_relation (cert_cart_slit hM) (relation_reflX M) (isOpen_domRefl M)
    (domRefl_nonempty hM) (K := fun _ => jacReflX) (fun _ _ => jacReflX_mul_self)
    (fun y hy => giIsoCart_mul_gIsoCart_prime hM (by rw [← rho_reflX]; exact hy.1)
      (by rw [← rho_reflX]; exact hy.2.1))

theorem cert_domRot (hM : 0 ≤ M) : VacuumCertificate (gIsoCart M) (giIsoCart M) (domRot M) :=
  VacuumCertificate.transport_of_relation (cert_cart_slit hM) (relation_rotC M) (isOpen_domRot M)
    (domRot_nonempty hM) (K := fun _ => jacRotCInv) (fun _ _ => jacRotC_mul_inv)
    (fun y hy => giIsoCart_mul_gIsoCart_prime hM (by rw [← rho_rotC]; exact hy.1)
      (by rw [← rho_rotC]; exact hy.2.1))

end ExactVacuumAtlas.Schwarzschild.Iso

-- ==== solution ====
open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable {M : ℝ}
theorem solution (hM : 0 ≤ M) : VacuumCertificate (gIsoCart M) (giIsoCart M) (domIsoCart M) := by
  rw [domIsoCart_eq_union M]
  exact (cert_cart_slit hM).union ((cert_domRefl hM).union (cert_domRot hM))
