section
-- Source module: Solutions.KFV6Rec
/-!
# KFV §10: one Kronecker record product in IL

**`recI pM b r Δ c KG`** consumes record `x` (stack `vX`) and record `z` (stack `vY`) and pushes the
reversed output record on `vO`:

1. `unzP` twice: offset real / imaginary parts (`+ c`, `c = 2^p`);
2. `packI` four times: `A = ∑ a_h B^h`, `Bi = ∑ b_h B^h`, `C`, `E` (`B = 2^b`, Lemma 17 packing);
3. four `MulOK` products `CA, EB, EA, CB` (FM in `kTable`);
4. `extI` on `CA - EB` and on `EA + CB`: the folded, truncated numerators;
5. `ilvP`, then drop the scratch integers.

**`recI_runs`**: the result is `kmul r p ρ zx zy` (`KFV6Math`), whose `toC` is `2^p` times
`Q_p(x z / r)` when `r = 2^ρ` (`toC_kmul`). The cost is `O(r (b + p))` plus four products of
`(b r + 2)`-bit integers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFT Synth

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem fok_unzP (X SA SB C : Fin HS) (c : ℤ) (n : ℕ) (h1 : C ≠ X) (h2 : C ≠ SA) (h3 : C ≠ SB)
    (h4 : C ∉ scr) : fok (unzP X SA SB C c n) = true := by
  simp [unzP, unzB, fok, touch, Ex.regs, h1, h2, h3, h4, List.contains_iff_mem]

theorem fok_ilvP (n : ℕ) : fok (ilvP n) = true := by
  simp +decide [ilvP, ilvB, fok, touch, Ex.regs, scr]

/-- `|∑_{h<r} a_h B^h| < B^r` for `|a_h| ≤ B/2`. -/
theorem abs_pack_lt {b r : ℕ} (hb : 1 ≤ b) {a : ℕ → ℤ} (ha : ∀ h < r, |a h| ≤ 2 ^ (b - 1)) :
    |∑ h ∈ Finset.range r, a h * (2 ^ b : ℤ) ^ h| < (2 ^ b) ^ r := by
  rw [two_pow_pred hb]
  exact abs_sum_lt (one_le_pow₀ (by norm_num)) r ha

theorem getD_mem_bnd {zs : List GI} {P : GI → Prop} (h : ∀ z ∈ zs, P z) (h0 : P 0) (i : ℕ) :
    P (zs.getD i 0) := by
  rcases lt_or_ge i zs.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ hi]; exact h0

end NLogN.KFV

end

section
-- Source module: Solutions.KFV10Rec
/-!
# KFV §14: the uniform record product `recU`

`recU pM` is `recI pM b r Δ c KG` (`KFV6Rec`) with every size read at run time from six
parameter stacks (`kc = 50 … kD = 55`):

| stack | value |
|---|---|
| `kc = 50` | `c = 2^p` |
| `kr = 51` | `r` |
| `kK = 52` | `KG = kG b r c` |
| `kB = 53` | `2^b` |
| `kJ = 54` | `(2^b)^(2r)` |
| `kD = 55` | `2^Δ` |

Derived literals are expressions over them: `2r = r + r`, `-KG`, `H = 2^b / 2`, `-H`.
The pieces are related to those of `recI` by `ISim` (`KFV8Sim`/`KFV9Gen`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Parameters -/

theorem πR_low (c r KG B BJ D2 : ℤ) : PLow (πR c r KG B BJ D2) :=
  PLow.of_list (by simp [HS])

theorem πR_none {c r KG B BJ D2 : ℤ} {i : Fin HS} (h : i.val < 50 ∨ 55 < i.val) :
    πR c r KG B BJ D2 i = none := by
  unfold πR
  simp only [pmOf]
  split_ifs with h1 h2 h3 h4 h5 h6 <;> first | rfl | (subst_vars; revert h; decide)

theorem πR_some {c r KG B BJ D2 : ℤ} {i : Fin HS} {v : ℤ} (h : πR c r KG B BJ D2 i = some v) :
    50 ≤ i.val ∧ i.val ≤ 55 := by
  by_contra hc
  rw [πR_none (by omega)] at h
  simp at h

/-- The parameters sit in the frame. -/
theorem PV_encK {π : PMap} {s : IState HS} (hs : PV π s) {f : Fin HS → List ℤ}
    (hf : ∀ i v, π i = some v → f i = []) : PV π (encK s f) := by
  intro i v hv
  obtain ⟨L, hL⟩ := hs i v hv
  exact ⟨L, by simp [hf i v hv, hL]⟩

/-! ## Literal expressions -/

/-! ## Write conditions -/

theorem GSim.refl (π : PMap) : ∀ p : RS, GSim π p p
  | .skip => .skip
  | .asg i e => .asg i (.refl e)
  | .push i e => .push i (.refl e)
  | .pop i => .pop i
  | .seq a b => .seq (refl π a) (refl π b)
  | .ite c a b => .ite (.refl c) (refl π a) (refl π b)
  | .rep i n b => .rep i (.refl n) (refl π b)

theorem NW_fcodeR {c r KG B BJ D2 : ℤ} {p : RS} (h : ∀ j ∈ p.writes, j.val < 50) :
    NW (πR c r KG B BJ D2) (fcode p : IStmt HS Pp) := by
  refine NW_fcode fun i v hv => ?_
  have := πR_some hv
  refine ⟨fun hm => by have := h i hm; omega, by omega, ?_⟩
  unfold ulS; omega

/-! ## Uniform pieces -/

theorem gsim_unz {π : PMap} (hπ : PLow π) {c : ℤ} {r : ℕ} (hc : π kc = some c)
    (hr : π kr = some (r : ℤ)) (X SA SB C : Fin HS) :
    GSim π (unzP X SA SB C c r) (unzU X SA SB C) :=
  .rep _ (.lit (LitOK.reg hπ hr)) (.seq (.push _ (.add (.refl _) (.lit (LitOK.reg hπ hc))))
    (.seq (.push _ (.refl _)) (.seq (.pop _) (.seq (.push _ (.add (.refl _) (.lit (LitOK.reg hπ hc))))
      (.seq (.push _ (.refl _)) (.pop _))))))

/-! ## Packing, extraction and interleaving -/

section Sims

variable {c KG : ℤ} {b r : ℕ} {BJ D2 : ℤ}

theorem πr_c : πr c KG b r BJ D2 kc = some c := by simp +decide [πR, pmOf]
theorem πr_r : πr c KG b r BJ D2 kr = some (r : ℤ) := by simp +decide [πR, pmOf]

theorem isim_ilv : ISim I iprog (πr c KG b r BJ D2) (fcode (ilvP r)) (fcode ilvU) :=
  ISim.fcodeG (.rep _ (.lit (LitOK.reg (πR_low _ _ _ _ _ _) πr_r)) (GSim.refl _ _))

theorem isim_unz (X SA SB C : Fin HS) :
    ISim I iprog (πr c KG b r BJ D2) (fcode (unzP X SA SB C c r)) (fcode (unzU X SA SB C)) :=
  ISim.fcodeG (gsim_unz (πR_low _ _ _ _ _ _) πr_c πr_r X SA SB C)

end Sims

/-! ## The run -/

theorem PZ.upd {c r KG B BJ D2 : ℤ} {g : Fin HS → List ℤ} (h : PZ (πR c r KG B BJ D2) g)
    {j : Fin HS} {L : List ℤ} (hj : j.val < 50) : PZ (πR c r KG B BJ D2) (Function.update g j L) := by
  intro i v hv
  have := πR_some hv
  rw [Function.update_of_ne (by rintro rfl; omega)]
  exact h i v hv

theorem NW_fcodeL {c r KG B BJ D2 : ℤ} {p : RS} (h : lowW p = true) :
    NW (πR c r KG B BJ D2) (fcode p : IStmt HS Pp) :=
  NW_fcodeR fun j hj => by unfold lowW at h; rw [List.all_eq_true] at h; simpa using h j hj

end NLogN.KFV

end

section
-- Source module: Solutions.J6SegKr0
/-!
# B3 (chunk kernel), part 0: one uniform Kronecker record product with general truncation

`KFV10Rec.recU_runs` with the truncation `Δ` free (there `Δ = p + ρ`; the program `recU` reads
`2^Δ` from the parameter stack `kD`): on records `zx, zy` of length `r` (entries `|·| ≤ 2^p`,
digit width `b` with `2 r 2^{2p} < 2^{b-1}`), `recU` leaves the reversed record
`kmulD r Δ zx zy`, entry `j` = the `y^r + 1`-folded numerators truncated by `2^Δ`.
With `Δ = 0` and zero-padded records this is the exact Gaussian polynomial product
(the Toeplitz stages of the chunk kernel).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 10000

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

open J6Seg Synth in
set_option maxHeartbeats 8000000 in
/-- **`recU_runs` with a general truncation `Δ`**: `vO` receives the reversed `kmulD r Δ zx zy`. -/
theorem _root_.J6Seg.recU_runsD_sol_aux {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {b r p Δ φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ b * r + 2 → zsz y ≤ b * r + 2 → M.Φ x y ≤ φ)
    (hb : 1 ≤ b) (hr : 1 ≤ r) (hbig : 2 * r * 2 ^ (2 * p) < 2 ^ (b - 1))
    (s : IState HS) (f : Fin HS → List ℤ) (zx zy : List GI) (lx ly : List ℤ)
    (hX : f vX = gflat zx ++ lx) (hY : f vY = gflat zy ++ ly) (hlx : zx.length = r)
    (hly : zy.length = r)
    (hzx : ∀ z ∈ zx, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p) (hzy : ∀ z ∈ zy, |z.1| ≤ 2 ^ p ∧ |z.2| ≤ 2 ^ p)
    (hT : Tmp f)
    (hP : PV (πr (2 ^ p) (kG b r (2 ^ p)) b r ((2 ^ b) ^ (2 * r)) (2 ^ Δ)) s)
    (hF : PZ (πr (2 ^ p) (kG b r (2 ^ p)) b r ((2 ^ b) ^ (2 * r)) (2 ^ Δ)) f) :
    IRuns I iprog (recU pM) (encK s f)
      (encK s (Function.update (Function.update (Function.update f vX lx) vY ly) vO
        ((gflat (kmulD r Δ zx zy)).reverse ++ f vO)))
      (2000 * cRec r p b Δ φ) := by
  set c : ℤ := 2 ^ p with hc
  set KG := kG b r c with hKG
  set Bb := zsz ((2 * r : ℕ) : ℤ) with hBb
  set H : ℤ := 2 ^ (b - 1) with hHdef
  have hBH : (2 : ℤ) ^ b = 2 * H := two_pow_pred hb
  have hbigZ : (2 : ℤ) * r * 2 ^ (2 * p) < H := by rw [hHdef]; exact_mod_cast hbig
  have hrZ : (1 : ℤ) ≤ r := by exact_mod_cast hr
  have hcp : (0 : ℤ) < c := by positivity
  have hcH : c ≤ H := by
    have h1 : c ≤ 2 ^ (2 * p) := pow_le_pow_right₀ (by norm_num) (by omega)
    nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (2 * p)]
  have hc2 : c * c = 2 ^ (2 * p) := by rw [hc, ← pow_add]; ring_nf
  -- widths
  have zw : ∀ x : ℤ, |x| ≤ 2 * c → zsz x ≤ p + 2 := fun x hx =>
    zsz_le_of_abs (by
      have : (2 : ℤ) * c < 2 ^ (p + 2) := by rw [hc, pow_add]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) p]
      linarith)
  have hzc : zsz c ≤ p + 2 := zw c (by rw [abs_of_pos hcp]; linarith)
  have hwx : ∀ z ∈ zx, zsz z.1 ≤ p + 2 ∧ zsz z.2 ≤ p + 2 ∧ zsz (z.1 + c) ≤ p + 2 ∧
      zsz (z.2 + c) ≤ p + 2 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hzx z hz
    refine ⟨zw _ (by linarith), zw _ (by linarith), zw _ ?_, zw _ ?_⟩ <;>
      (rw [abs_le] at h1 h2 ⊢; constructor <;> linarith)
  have hwy : ∀ z ∈ zy, zsz z.1 ≤ p + 2 ∧ zsz z.2 ≤ p + 2 ∧ zsz (z.1 + c) ≤ p + 2 ∧
      zsz (z.2 + c) ≤ p + 2 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hzy z hz
    refine ⟨zw _ (by linarith), zw _ (by linarith), zw _ ?_, zw _ ?_⟩ <;>
      (rw [abs_le] at h1 h2 ⊢; constructor <;> linarith)
  have hrBb : zsz (r : ℤ) ≤ Bb := zsz_natCast_le' (by omega)
  -- unzip both records
  have u1 := unzP_fsp (X := vX) (SA := vA) (SB := vB) (C := vL) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s f zx lx c
    (p + 2) Bb hX hT.l hwx hzc (by rw [hlx]; exact hrBb)
  rw [hlx, hT.a, hT.b, List.append_nil, List.append_nil] at u1
  set zA := zx.map (offG c) with hzA
  set zB := zx.map (fun z => offG c z.swap) with hzB
  set zC := zy.map (offG c) with hzC
  set zE := zy.map (fun z => offG c z.swap) with hzE
  set f1 := Function.update (Function.update (Function.update f vX lx) vA (gflat zA).reverse) vB
    (gflat zB).reverse with hf1
  have u2 := unzP_fsp (X := vY) (SA := vC) (SB := vE) (C := vL) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s f1 zy ly c
    (p + 2) Bb (by simp +decide [hf1, hY]) (by simp +decide [hf1, hT.l]) hwy hzc (by rw [hly]; exact hrBb)
  rw [hly, show f1 vC = [] by simp +decide [hf1, hT.c], show f1 vE = [] by simp +decide [hf1, hT.e],
    List.append_nil, List.append_nil] at u2
  set f2 := Function.update (Function.update (Function.update f1 vY ly) vC (gflat zC).reverse) vE
    (gflat zE).reverse with hf2
  -- packing
  have hBr : ∀ x : ℤ, |x| < 2 * (2 ^ b) ^ r → zsz x ≤ b * r + 2 := fun x hx =>
    zsz_le_of_abs (by
      have : (2 : ℤ) * (2 ^ b) ^ r < 2 ^ (b * r + 2) := by
        rw [← pow_mul, pow_add]; nlinarith [pow_pos (two_pos : (0 : ℤ) < 2) (b * r)]
      linarith)
  have hBrn : zsz ((2 * r : ℕ) : ℤ) ≤ b * r + 2 := by
    apply zsz_le_of_abs
    have h1 : r < 2 ^ r := Nat.lt_two_pow_self
    have h2 : (2 : ℕ) ^ (r + 1) ≤ 2 ^ (b * r + 2) := Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    have h3 : 2 * r < 2 ^ (b * r + 2) := by rw [pow_succ] at h2; omega
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast h3
  have hKGb : |KG| < (2 ^ b) ^ r := abs_pack_lt hb (a := fun _ => c) (fun h _ => by
    rw [abs_of_pos hcp]; exact hcH)
  have hBpos : (0 : ℤ) < (2 ^ b) ^ r := by positivity
  have hAb : ∀ (zs : List GI) (g : GI → ℤ), (∀ z ∈ zs, |g z| ≤ c) → g 0 = 0 →
      |∑ h ∈ Finset.range r, g (zs.getD h 0) * (2 ^ b : ℤ) ^ h| < (2 ^ b) ^ r := by
    intro zs g hg h0
    refine abs_pack_lt hb (a := fun h => g (zs.getD h 0)) (fun h _ => ?_)
    exact le_trans (getD_mem_bnd (P := fun z => |g z| ≤ c) hg (by simp [h0]; positivity) h) hcH
  set VA := ∑ h ∈ Finset.range r, reF zx h * (2 ^ b : ℤ) ^ h with hVA
  set VB := ∑ h ∈ Finset.range r, imF zx h * (2 ^ b : ℤ) ^ h with hVB
  set VC := ∑ h ∈ Finset.range r, reF zy h * (2 ^ b : ℤ) ^ h with hVC
  set VE := ∑ h ∈ Finset.range r, imF zy h * (2 ^ b : ℤ) ^ h with hVE
  have bVA : |VA| < (2 ^ b) ^ r := hAb zx (fun z => z.1) (fun z hz => (hzx z hz).1) rfl
  have bVB : |VB| < (2 ^ b) ^ r := hAb zx (fun z => z.2) (fun z hz => (hzx z hz).2) rfl
  have bVC : |VC| < (2 ^ b) ^ r := hAb zy (fun z => z.1) (fun z hz => (hzy z hz).1) rfl
  have bVE : |VE| < (2 ^ b) ^ r := hAb zy (fun z => z.2) (fun z hz => (hzy z hz).2) rfl
  have packStep : ∀ (S P : Fin HS), S ≠ 0 → S ≠ vL → P ≠ 0 → P ≠ S → S.val < 56 → P.val < 56 →
      fok (NLogN.mvK S 0 vL (.lit ((2 * r : ℕ) : ℤ))) = true →
      ∀ (zs0 : List GI) (V : ℤ) (ff : Fin HS → List ℤ), zs0.length = r →
      ff S = (gflat zs0).reverse → ff vL = [] → (∀ z ∈ zs0, 0 ≤ z.1) → GB (p + 2) zs0 →
      (carOut b zs0 : ℤ) - KG = V → |V| < (2 ^ b) ^ r →
      IRuns I iprog (packI S P b r KG) (encK s ff)
        (encK s (Function.update (Function.update ff S []) P (V :: ff P)))
        (cPack r (p + 2) b (b * r + 2)) := by
    intro S P h1 h2 h3 h4 h5 h6 hfk zs0 V ff hl hS hL hre hw hV hVb
    have hco : (carOut b zs0 : ℤ) = V + KG := by rw [← hV]; ring
    have := packI_runs (I := I) (iprog := iprog) h1 h2 h3 h4 h5 h6 hb KG s ff zs0 [] hl (by rw [hS, List.append_nil]) hL hre hw
      (hBr _ (by rw [hco]; have := abs_add_le V KG; linarith))
      (hBr _ (by linarith))
      (hBr _ (by rw [hV]; linarith)) hBrn hfk
    rw [hV] at this
    exact this
  have reA : ∀ z ∈ zA, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzx w hw).1; simp only [offG]; linarith
  have reB : ∀ z ∈ zB, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzx w hw).2; simp only [offG, Prod.fst_swap]; linarith
  have reC : ∀ z ∈ zC, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzy w hw).1; simp only [offG]; linarith
  have reE : ∀ z ∈ zE, 0 ≤ z.1 := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    have := abs_le.1 (hzy w hw).2; simp only [offG, Prod.fst_swap]; linarith
  have gA : GB (p + 2) zA := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwx w hw).2.2.1, by simp [offG, zsz_zero]⟩
  have gB : GB (p + 2) zB := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwx w hw).2.2.2, by simp [offG, zsz_zero]⟩
  have gC : GB (p + 2) zC := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwy w hw).2.2.1, by simp [offG, zsz_zero]⟩
  have gE : GB (p + 2) zE := by
    intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz
    exact ⟨(hwy w hw).2.2.2, by simp [offG, zsz_zero]⟩
