section
-- Source module: Solutions.R6CxNetEff
/-!
# The scalar effect of the two stage programs

For the local wires (`x_t = t`, `y_S = 2024 + S`, `a_q = 4048 + q`, `m_j = 53256 + j`) and any state
`Λ` with clean temporaries (`Λ (m_j) = 0`), the ops of `specs1` give `y_S ↦ y_S + x_S` and those of
`specs2` give `y_S ↦ y_S − x_S`, while `x` and the dirty scratch `a` are restored. The data enter
through `DatOK` (checked by the kernel) and the mask identity `MaskOK` (`R6CxNetMaskAll`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetEff

open NetSpec NetMask NetScal NetLoc Finset

/-! ## List sums -/

/-! ## Wires -/

/-! ## Placement -/

/-! ## Gate ops on coefficient vectors -/

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

lemma Lops_eq (gs : List Gate) : Lops gs = slotOps (gs.flatMap gq) := by
  unfold Lops slotOps
  rw [List.map_flatMap]
  congr 1; funext g; exact gops_eq g

/-! ## Readouts -/

variable (d : Dat)

lemma zip_range_eq {α : Type*} (ps : List α) (n : ℕ) (h : ps.length = n) (z : α) :
    (List.range n).zip ps = (List.range n).map fun i => (i, ps.getD i z) := by
  subst h
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp only [List.getElem_zip, List.getElem_map, List.getElem_range, List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_getElem (by simp at h1; omega)]; rfl

/-! ## Junk functions and the gate block -/

lemma slotOps_mem {gl : List (ℕ × ℕ)} {o : ℕ × ℕ × ℤ} (h : o ∈ slotOps gl) :
    ∃ p ∈ gl, o = (aw p.1, aw p.2, 2) := by
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h; exact ⟨p, hp, rfl⟩

lemma negOps_mem {l : List (ℕ × ℕ × ℤ)} {o : ℕ × ℕ × ℤ} (h : o ∈ negOps l) :
    ∃ o' ∈ l, o = (o'.1, o'.2.1, -o'.2.2) := by
  unfold negOps at h
  obtain ⟨o', ho', rfl⟩ := List.mem_map.1 (List.mem_reverse.1 h); exact ⟨o', ho', rfl⟩

/-! ## Parallel blocks -/

/-! ## The blocks of the stage programs -/

lemma centreOps_mem {sg : ℤ} {srcw : ℕ → ℕ} {o : ℕ × ℕ × ℤ} (h : o ∈ centreOps d sg srcw) :
    ∃ S < NV, ∃ c ∈ centreL (d.tv S), o = (yw S, srcw c.1, sg * c.2) := by
  unfold centreOps at h
  obtain ⟨S, hS, h⟩ := List.mem_flatMap.1 h
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 h
  exact ⟨S, List.mem_range.1 hS, c, hc, rfl⟩

lemma injOps_mem (hlen : d.pieces.length = NV) {sg : ℤ} {o : ℕ × ℕ × ℤ} (h : o ∈ injOps d sg) :
    ∃ S < NV, ∃ p ∈ d.pieces.getD S [], o = (yw S, aw p.1, sg * p.2) := by
  unfold injOps at h
  rw [zip_range_eq _ _ hlen []] at h
  obtain ⟨x, hx, h⟩ := List.mem_flatMap.1 h
  obtain ⟨S, hS, rfl⟩ := List.mem_map.1 hx
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h
  exact ⟨S, List.mem_range.1 hS, p, hp, rfl⟩

lemma centreL_lt (tv : ℕ) : ∀ c ∈ centreL tv, c.1 < 24 := by
  intro c hc
  unfold centreL at hc
  cases h : tv.testBit 23 <;> rw [h] at hc <;> simp at hc <;>
    rcases hc with rfl | ⟨i, hi, _, rfl⟩ <;> simp <;> omega

/-! ## Facts about the blocks -/

/-! ## The op lists of the stages -/

/-! ## Stage effects -/

end IntMul.Kappa.R6.Cx.NetEff

end

section
-- Source module: Solutions.R6CxNetRaw
/-!
# Raw-primitive forms of the label checkers (for kernel evaluation)

The checkers of `NetF2` / `NetSpec` written with `Nat.land`, `Nat.shiftRight`, ... directly
(no type-class instances to unfold), with equality lemmas to the originals.
-/

namespace IntMul.Kappa.R6.Cx.NetRaw

open NetF2 NetSpec

lemma tbR_eq (m n : ℕ) : tbR m n = m.testBit n := by
  unfold tbR Nat.testBit
  cases h : Nat.beq (Nat.land 1 (Nat.shiftRight m n)) 0
  · have : Nat.land 1 (Nat.shiftRight m n) ≠ 0 := fun e => by rw [e] at h; cases h
    simp only [Bool.not_false]
    exact (bne_iff_ne.2 this).symm
  · have : Nat.land 1 (Nat.shiftRight m n) = 0 := Nat.eq_of_beq_eq_true h
    simp only [Bool.not_true]
    exact (bne_eq_false_iff_eq.2 this).symm

lemma memR_eq (c : Code) (w : ℕ) : memR c w = memB c w := by
  cases c <;> simp only [memR, memB, tbR_eq] <;> rfl

lemma orthR_eq (w : ℕ) (c : Code) : orthR w c = orthB w c := by
  cases c <;> simp only [orthR, orthB, tbR_eq] <;> rfl

lemma leR_eq (U V : Code) : leR U V = leB U V := by
  cases U <;> cases V <;> simp only [leR, leB, tbR_eq, memR_eq] <;> rfl

lemma okR_eq (c : Code) : okR c = okC c := by
  cases c <;> simp only [okR, okC, tbR_eq] <;> rfl

lemma dimR_eq (c : Code) : dimR c = dimC c := by cases c <;> rfl

lemma candR_eq (U V : Code) : candR U V = cand U V := by
  cases U <;> cases V <;> rfl

lemma witR_eq (U V : Code) (w : ℕ) : witR U V w = witOK U V w := by
  simp only [witR, witOK, memR_eq, orthR_eq]; rfl

lemma edgeR_eq (V U : Code) : edgeR V U = edgeB V U := by
  simp only [edgeR, edgeB, okR_eq, leR_eq, witR_eq, candR_eq]

lemma ofNatR_eq (c : ℕ) : ofNatR c = Code.ofNat c := rfl

variable (d : Dat)

lemma mvOK2R_eq : mvOK2R d = mvOK2 d := by
  funext w o V; simp only [mvOK2R, mvOK2, edgeR_eq, ofNatR_eq]; rfl

lemma wd2R_eq : wd2R = wd2 := by
  funext w o V; simp only [wd2R, wd2, wd1R, dimR_eq, ofNatR_eq]; rfl

end IntMul.Kappa.R6.Cx.NetRaw

end

section
-- Source module: Solutions.R6CxNetOps
/-!
# Every spec's ops act on its own wires (`OpsIn`)

`progK_sound` needs `OpsIn s` for every spec of a checked segment; here it is derived from the
data facts `DataOK` (gate slots in range, readout slots in range, gates with inputs).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetEff

open NetSpec NetMask NetScal NetLoc NetFast

variable (d : Dat)

lemma mem_allA {q : ℕ} (hq : q < NR) : aw q ∈ allA := List.mem_map.2 ⟨q, List.mem_range.2 hq, rfl⟩
lemma mem_allY {S : ℕ} (hS : S < NV) : yw S ∈ allY := List.mem_map.2 ⟨S, List.mem_range.2 hS, rfl⟩
lemma mem_allM {j : ℕ} (hj : j < 24) : mw j ∈ allM := List.mem_map.2 ⟨j, List.mem_range.2 hj, rfl⟩

lemma gops_mem {g : Gate} {o : ℕ × ℕ × ℤ} (hg : g.ins ≠ []) (ho : o ∈ gops g) :
    o.1 ∈ (g.ins ++ g.outs).map aw ∧ o.2.1 ∈ (g.ins ++ g.outs).map aw := by
  unfold gops at ho
  rcases List.mem_append.1 ho with h | h
  · obtain ⟨c, ins, outs⟩ := g
    rcases ins with _ | ⟨p, _ | ⟨i, _ | ⟨j, l⟩⟩⟩ <;> simp at h
    subst h
    simp
  · obtain ⟨o', ho', rfl⟩ := List.mem_map.1 h
    refine ⟨List.mem_map.2 ⟨o', List.mem_append_right _ (List.mem_of_mem_tail ho'), rfl⟩,
      List.mem_map.2 ⟨g.ins.headD 0, List.mem_append_left _ ?_, rfl⟩⟩
    cases h' : g.ins with
    | nil => exact absurd h' hg
    | cons a l => simp

lemma opsIn_gateInv (g : Gate) (hg : g.ins ≠ []) : OpsIn (gateSpecInv g) := fun o ho => by
  obtain ⟨o', ho', rfl⟩ := negOps_mem ho
  exact gops_mem (o := o') hg ho'

lemma opsIn_gates2 (gD : List ℕ) (h : ∀ g ∈ gatesOf gD, g.ins ≠ []) : ∀ s ∈ gates2 gD, OpsIn s := by
  intro s hs
  obtain ⟨g, hg, rfl⟩ := List.mem_map.1 hs
  exact opsIn_gateInv g (h g (List.mem_reverse.1 hg))

lemma opsIn_xSpec (lab : ℕ → ℕ) (k : ℤ) (t : ℕ) : OpsIn (xSpec d lab k t) := by
  intro o ho
  simp only [xSpec, List.mem_singleton] at ho
  subst ho; simp [xSpec]

lemma opsIn_xSpecs (lab : ℕ → ℕ) (k : ℤ) : ∀ s ∈ (List.range NV).map (xSpec d lab k), OpsIn s := by
  intro s hs
  obtain ⟨t, _, rfl⟩ := List.mem_map.1 hs
  exact opsIn_xSpec d lab k t

lemma opsIn_copy : ∀ s ∈ copySpecs d, OpsIn s := by
  intro s hs
  obtain ⟨j, _, rfl⟩ := List.mem_map.1 hs
  intro o ho
  simp only [List.mem_singleton] at ho
  subst ho; simp

lemma opsIn_pieces (hlen : d.pieces.length = NV) (sg : ℤ) : ∀ s ∈ pieceSpecs d sg, OpsIn s := by
  intro s hs
  unfold pieceSpecs at hs
  rw [zip_range_eq _ _ hlen []] at hs
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hs
  obtain ⟨S, _, rfl⟩ := List.mem_map.1 hx
  intro o ho
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 ho
  exact ⟨List.mem_cons_self, List.mem_cons_of_mem _ (List.mem_map.2 ⟨p, hp, rfl⟩)⟩

lemma Lops_wires (hD : DataOK d) {o : ℕ × ℕ × ℤ} (ho : o ∈ Lops d.gates) : o.1 ∈ allA ∧ o.2.1 ∈ allA := by
  rw [Lops_eq] at ho
  obtain ⟨p, hp, rfl⟩ := slotOps_mem ho
  exact ⟨mem_allA (hD.gok p hp).1, mem_allA (hD.gok p hp).2.1⟩

lemma negLops_wires (hD : DataOK d) {o : ℕ × ℕ × ℤ} (ho : o ∈ negOps (Lops d.gates)) :
    o.1 ∈ allA ∧ o.2.1 ∈ allA := by
  obtain ⟨o', ho', rfl⟩ := negOps_mem ho
  exact Lops_wires (o := o') d hD ho'

lemma centre_wires (sg : ℤ) (srcw : ℕ → ℕ) (W : List ℕ) (hW : ∀ j < 24, srcw j ∈ W)
    {o : ℕ × ℕ × ℤ} (ho : o ∈ centreOps d sg srcw) : o.1 ∈ allY ∧ o.2.1 ∈ W := by
  obtain ⟨S, hS, c, hc, rfl⟩ := centreOps_mem d ho
  exact ⟨mem_allY hS, hW _ (centreL_lt _ c hc)⟩

lemma inj_wires (hD : DataOK d) (sg : ℤ) {o : ℕ × ℕ × ℤ} (ho : o ∈ injOps d sg) :
    o.1 ∈ allY ∧ o.2.1 ∈ allA := by
  obtain ⟨S, hS, p, hp, rfl⟩ := injOps_mem d hD.len ho
  exact ⟨mem_allY hS, mem_allA (hD.rd.2 S hS p hp)⟩

lemma rsA (hD : DataOK d) : ∀ j < 24, aw (d.rs j) ∈ allA ++ allY := fun j hj =>
  List.mem_append_left _ (mem_allA (hD.rd.1 j hj))

lemma gates_sub (gD : List ℕ) (h : gatesOf gD ⊆ d.gates) (hD : DataOK d) :
    ∀ g ∈ gatesOf gD, g.ins ≠ [] := fun g hg => hD.ins g (h hg)

/-! ## The segments -/

lemma opsIn_pre2a (hD : DataOK d) : ∀ s ∈ pre2a d, OpsIn s := by
  intro s hs
  rcases List.mem_append.1 hs with h | h
  · exact opsIn_xSpecs d _ _ s h
  · rw [List.mem_singleton] at h; subst h
    intro o ho; simp only [ws_mk, ops_mk] at ho ⊢; exact Lops_wires d hD ho

lemma opsIn_pre2b (hD : DataOK d) : ∀ s ∈ pre2b d, OpsIn s := by
  intro s hs
  unfold pre2b at hs
  rcases List.mem_append.1 hs with h | h
  rcases List.mem_append.1 h with h | h
  · exact opsIn_pieces d hD.len _ s h
  · exact opsIn_copy d s h
  · rw [List.mem_singleton] at h
    subst h
    intro o ho
    simp only [ws_mk, ops_mk] at ho ⊢
    have := centre_wires d _ _ allM (fun j hj => mem_allM hj) ho
    exact ⟨List.mem_append_right _ this.1, List.mem_append_left _ this.2⟩

lemma opsIn_post2 (hD : DataOK d) : ∀ s ∈ post2 d, OpsIn s := by
  intro s hs
  rcases List.mem_append.1 hs with h | h
  · exact opsIn_xSpecs d _ _ s h
  · rw [List.mem_singleton] at h
    subst h
    intro o ho
    simp only [ws_mk, ops_mk] at ho ⊢
    simp only [List.mem_append] at ho
    rcases ho with ((h1 | h1) | h1) | h1
    · have := Lops_wires d hD h1
      exact ⟨List.mem_append_left _ this.1, List.mem_append_left _ this.2⟩
    · have := inj_wires d hD _ h1
      exact ⟨List.mem_append_right _ this.1, List.mem_append_left _ this.2⟩
    · have := centre_wires d _ _ _ (rsA d hD) h1
      exact ⟨List.mem_append_right _ this.1, this.2⟩
    · have := negLops_wires d hD h1
      exact ⟨List.mem_append_left _ this.1, List.mem_append_left _ this.2⟩

end IntMul.Kappa.R6.Cx.NetEff

end

section
-- Source module: Solutions.R6CxNetSeg
/-!
# Chaining the kernel label checks of the two stage programs

`stage1Seg` / `stage2Seg`: the checked programs `specs1 dat` / `specs2 dat` from the snapshot
states `S1_0` / `S2_0` are valid (`progChk … = true`), with the summed packed histograms and move
counts, ending in `S1_14` / `S2_14`.
-/

set_option maxRecDepth 100000
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetSeg

open NetBT NetLoc NetSpec NetFast NetRaw NetData NetEff

variable {nl : ℕ} {mvOK : ℕ → ℕ → ℕ → Bool} {wd : ℕ → ℕ → ℕ → ℕ}

lemma progChk_append (a b : List Spec) (t : BT) :
    progChk nl mvOK wd (a ++ b) t =
      ((progChk nl mvOK wd a t).1 && (progChk nl mvOK wd b (progRun a t).2).1,
        (progChk nl mvOK wd a t).2.1 + (progChk nl mvOK wd b (progRun a t).2).2.1,
        (progChk nl mvOK wd a t).2.2.1 + (progChk nl mvOK wd b (progRun a t).2).2.2.1,
        (progChk nl mvOK wd b (progRun a t).2).2.2.2) := by
  induction a generalizing t with
  | nil => simp [progChk, progRun]
  | cons s a ih =>
    simp only [List.cons_append, progChk, progRun, ih, Bool.and_assoc, add_assoc]

lemma progRun_append (a b : List Spec) (t : BT) :
    progRun (a ++ b) t = ((progRun a t).1 ++ (progRun b (progRun a t).2).1, (progRun b (progRun a t).2).2) := by
  induction a generalizing t with
  | nil => rfl
  | cons s a ih => simp only [List.cons_append, progRun, ih, List.cons_append]

lemma Seg.append {a b : List Spec} {t t' t'' : BT} {H C H' C' : ℕ} (h1 : Seg nl mvOK wd a t t' H C)
    (h2 : Seg nl mvOK wd b t' t'' H' C') : Seg nl mvOK wd (a ++ b) t t'' (H + H') (C + C') := by
  obtain ⟨a1, a2, a3, a4⟩ := h1
  obtain ⟨b1, b2, b3, b4⟩ := h2
  rw [Seg, progChk_append, progRun_append, a4]
  simp only [a1, b1, a2, b2, a3, b3, b4, Bool.true_and, and_self]

lemma seg_of {ss : List Spec} {t S : BT} {H C : ℕ} (hnl : nl ≤ CAP) (hwf : t.wf 8 = true)
    (hops : ∀ s ∈ ss, OpsIn s) (hk : progK nl mvOK wd (finK H C S) ss t 0 0 = true) :
    Seg nl mvOK wd ss t S H C ∧ S.wf 8 = true := by
  obtain ⟨p1, p2⟩ := progK_sound nl mvOK wd _ hnl ss t 0 0 hwf hops hk
  obtain ⟨e1, e2, e3⟩ := finK_spec p2
  refine ⟨⟨p1, by simpa using e1, by simpa using e2, e3⟩, ?_⟩
  rw [← e3]; exact progRun_wf ss t hwf

lemma gatesOf_sub {a b : List ℕ} (h : ∀ x ∈ a, x ∈ b) : gatesOf a ⊆ gatesOf b := by
  intro g hg
  obtain ⟨x, hx, hg⟩ := List.mem_flatMap.1 hg
  exact List.mem_flatMap.2 ⟨x, h x hx, hg⟩

lemma sub_gD0 : gatesOf gD0 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD1 : gatesOf gD1 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD2 : gatesOf gD2 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD3 : gatesOf gD3 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD4 : gatesOf gD4 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD5 : gatesOf gD5 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD6 : gatesOf gD6 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD7 : gatesOf gD7 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD8 : gatesOf gD8 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD9 : gatesOf gD9 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])
lemma sub_gD10 : gatesOf gD10 ⊆ dat.gates := gatesOf_sub (fun x hx => by simp [Dat.gates, dat, gD, hx])

lemma gates2_append (a b : List ℕ) : gates2 (a ++ b) = gates2 b ++ gates2 a := by
  simp [gates2, gatesOf, List.flatMap_append]

lemma specs2_split : specs2 dat = pre2a dat ++ pre2b dat ++ gates2 gD10 ++ gates2 gD9 ++ gates2 gD8 ++ gates2 gD7 ++ gates2 gD6 ++ gates2 gD5 ++ gates2 gD4 ++ gates2 gD3 ++ gates2 gD2 ++ gates2 gD1 ++ gates2 gD0 ++ post2 dat := by
  simp only [specs2, pre2, show dat.gD = gD from rfl, gD, gates2_append, List.append_assoc]

/-- **Stage two, checked.** -/
theorem stage2Seg_sol_aux (hD : DataOK dat) (hw : S2_0.wf 8 = true) :
    Seg NL (mvOK2 dat) wd2 (specs2 dat) S2_0 S2_14 (H2_0 + H2_1 + H2_2 + H2_3 + H2_4 + H2_5 + H2_6 + H2_7 + H2_8 + H2_9 + H2_10 + H2_11 + H2_12 + H2_13) (51232 + 24335 + 9328 + 7228 + 8554 + 8886 + 8436 + 8309 + 7634 + 7034 + 6335 + 10138 + 18629 + 51232) ∧ S2_14.wf 8 = true := by
  rw [specs2_split, ← mvOK2R_eq, ← wd2R_eq]
  obtain ⟨s0, w1⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) hw (opsIn_pre2a _ hD) (by exact chk2_0)
  obtain ⟨s1, w2⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w1 (opsIn_pre2b _ hD) (by exact chk2_1)
  obtain ⟨s2, w3⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w2 (opsIn_gates2 gD10 (gates_sub _ _ (sub_gD10) hD)) (by exact chk2_2)
  obtain ⟨s3, w4⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w3 (opsIn_gates2 gD9 (gates_sub _ _ (sub_gD9) hD)) (by exact chk2_3)
  obtain ⟨s4, w5⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w4 (opsIn_gates2 gD8 (gates_sub _ _ (sub_gD8) hD)) (by exact chk2_4)
  obtain ⟨s5, w6⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w5 (opsIn_gates2 gD7 (gates_sub _ _ (sub_gD7) hD)) (by exact chk2_5)
  obtain ⟨s6, w7⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w6 (opsIn_gates2 gD6 (gates_sub _ _ (sub_gD6) hD)) (by exact chk2_6)
  obtain ⟨s7, w8⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w7 (opsIn_gates2 gD5 (gates_sub _ _ (sub_gD5) hD)) (by exact chk2_7)
  obtain ⟨s8, w9⟩ := seg_of (show NL ≤ CAP by norm_num [NL, CAP]) w8 (opsIn_gates2 gD4 (gates_sub _ _ (sub_gD4) hD)) (by exact chk2_8)
