    (hTU : T ≠ U) (hTY : T ≠ Y) (hTC : T ≠ CN) (hTK : T ≠ CC) (hTN : T ≠ N)
    (hUY : U ≠ Y) (hUC : U ≠ CN) (hUK : U ≠ CC) (hUN : U ≠ N)
    (hYC : Y ≠ CN) (hYK : Y ≠ CC) (hYN : Y ≠ N) (hCK : CN ≠ CC) (hCNe : CN ≠ N) (hKN : CC ≠ N)
    (hM1 : ∀ j ∈ [X, T, U, Y, CN, CC, N, rP, rP1], j ≠ dM1)
    (hM2 : ∀ j ∈ [X, T, U, Y, CN, CC, N, rP, rP1], j ≠ dM2)
    (hP1 : ∀ j ∈ [X, T, U, Y, CN, CC, N], j ≠ rP)
    (hP2 : ∀ j ∈ [X, T, U, Y, CN, CC, N], j ≠ rP1)
    (h5 : ∀ j ∈ [X, T, U, Y, CN, CC, N], j.val < 55)
    (P : ℕ) (s : IState HS) (F : Fin HS → List ℤ) (z : List GI) (cs lx lt ln l1 l2 : List ℤ)
    (hX : F X = gflat z ++ lx) (hT : F T = cs ++ lt) (hcz : z.length ≤ cs.length)
    (hCN : F CN = []) (hCC : F CC = []) (hm1 : F dM1 = []) (hm2 : F dM2 = [])
    (hN : F N = (z.length : ℤ) :: ln) (hP : F rP = 2 ^ P :: l1) (hQ : F rP1 = 2 ^ (P + 1) :: l2)
    (Bz : ℕ) (hz : GB Bz z) (hc : Bnd Bz cs) (hBz : 2 * Bz + 2 ≤ B) (hPB : P + 3 ≤ B)
    (hn : zsz (z.length : ℤ) ≤ B) :
    IRuns I iprog (dgI pM X T U Y CN CC N) (encK s F)
      (encK s (Function.update (Function.update F X lx) Y (gflat (dgG P cs z).reverse ++ F Y)))
      (cDG z.length φ B) := by
  set n := z.length with hn_def
  set w := dgG P cs z with hw_def
  have hwl : w.length = n := length_dgG P hcz
  have hX5 := h5 X (by simp); have hT5 := h5 T (by simp); have hU5 := h5 U (by simp)
  have hY5 := h5 Y (by simp); have hC5 := h5 CN (by simp); have hK5 := h5 CC (by simp)
  have hN5 := h5 N (by simp)
  have aX := hM1 X (by simp); have aT := hM1 T (by simp); have aU := hM1 U (by simp)
  have aY := hM1 Y (by simp); have aC := hM1 CN (by simp); have aK := hM1 CC (by simp)
  have aN := hM1 N (by simp); have aP := hM1 rP (by simp); have aQ := hM1 rP1 (by simp)
  have bX := hM2 X (by simp); have bT := hM2 T (by simp); have bU := hM2 U (by simp)
  have bY := hM2 Y (by simp); have bC := hM2 CN (by simp); have bK := hM2 CC (by simp)
  have bN := hM2 N (by simp); have bP := hM2 rP (by simp); have bQ := hM2 rP1 (by simp)
  have pX := hP1 X (by simp); have pT := hP1 T (by simp); have pU := hP1 U (by simp)
  have pY := hP1 Y (by simp); have pC := hP1 CN (by simp)
  have qX := hP2 X (by simp); have qT := hP2 T (by simp); have qU := hP2 U (by simp)
  have qY := hP2 Y (by simp); have qC := hP2 CN (by simp)
  have hBzB : Bz ≤ B := by omega
  -- the loop states
  let Fk : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update
    (Function.update (Function.update F X (gflat (z.drop k) ++ lx)) T (cs.drop k ++ lt)) U
    ((cs.take k).reverse ++ F U)) Y (gflat (w.take k).reverse ++ F Y)) CN [(n : ℤ) - k]
  -- push the counter
  have i0 := Sp.ir (I := I) (iprog := iprog) (sp_pushR (s := s) F (i := CN) (B := B)
    (by omega) (by omega) hN hn)
  have e0 : Function.update F CN ((n : ℤ) :: F CN) = Fk 0 := by
    funext j; simp only [Fk, Function.update_apply, List.drop_zero, List.take_zero,
      List.reverse_nil, gflat_nil, List.nil_append, Nat.cast_zero, sub_zero, hCN]
    by_cases h1 : j = CN
    · subst h1; simp
    by_cases h2 : j = Y
    · subst h2; simp [h1]
    by_cases h3 : j = U
    · subst h3; simp [h1, h2]
    by_cases h4 : j = T
    · subst h4; simp [h1, h2, h3, hT]
    by_cases h5' : j = X
    · subst h5'; simp [h1, h2, h3, h4, hX]
    · simp [h1, h2, h3, h4, h5']
  rw [e0] at i0
  -- one item
  have hb : ∀ k < n, IRuns I iprog (dgBody pM X T U Y CN) (encK s (Fk k)) (encK s (Fk (k + 1)))
      (2 * φ + 100000 * (B + 2)) := by
    intro k hk
    have hkc : k < cs.length := lt_of_lt_of_le hk hcz
    have hdz : z.drop k = z[k] :: z.drop (k + 1) := List.drop_eq_getElem_cons hk
    have hdc : cs.drop k = cs[k] :: cs.drop (k + 1) := List.drop_eq_getElem_cons hkc
    have htc : cs.take (k + 1) = cs.take k ++ [cs[k]] := (List.take_concat_get' cs k hkc).symm
    have hkw : k < w.length := by rw [hwl]; exact hk
    have htw : w.take (k + 1) = w.take k ++ [w[k]] := (List.take_concat_get' w k hkw).symm
    have hwk : w[k] = (fmul P cs[k] z[k].1, fmul P cs[k] z[k].2) := by
      simp only [hw_def, dgG, List.getElem_zipWith]
    have hzk := hz _ (List.getElem_mem hk)
    have hck := hc _ (List.getElem_mem hkc)
    have hpr1 : zsz (cs[k] * z[k].1) ≤ 2 * Bz := (zsz_mul_le _ _).trans (by omega)
    have hpr2 : zsz (cs[k] * z[k].2) ≤ 2 * Bz := (zsz_mul_le _ _).trans (by omega)
    set G := Fk k with hG
    have gX : G X = z[k].1 :: z[k].2 :: (gflat (z.drop (k + 1)) ++ lx) := by
      simp only [hG, Fk, Function.update_apply, if_neg hXC, if_neg hXY, if_neg hXU, if_neg hXT,
        if_true, hdz, gflat_cons, List.cons_append]
    have gT : G T = cs[k] :: (cs.drop (k + 1) ++ lt) := by
      simp only [hG, Fk, Function.update_apply, if_neg hTC, if_neg hTY, if_neg hTU, if_true, hdc,
        List.cons_append]
    have g1 : G dM1 = [] := by
      simp only [hG, Fk, Function.update_apply, if_neg aC.symm, if_neg aY.symm, if_neg aU.symm,
        if_neg aT.symm, if_neg aX.symm, hm1]
    have g2 : G dM2 = [] := by
      simp only [hG, Fk, Function.update_apply, if_neg bC.symm, if_neg bY.symm, if_neg bU.symm,
        if_neg bT.symm, if_neg bX.symm, hm2]
    have gP : G rP = 2 ^ P :: l1 := by
      simp only [hG, Fk, Function.update_apply, if_neg pC.symm, if_neg pY.symm, if_neg pU.symm,
        if_neg pT.symm, if_neg pX.symm, hP]
    have gQ : G rP1 = 2 ^ (P + 1) :: l2 := by
      simp only [hG, Fk, Function.update_apply, if_neg qC.symm, if_neg qY.symm, if_neg qU.symm,
        if_neg qT.symm, if_neg qX.symm, hQ]
    have gC : G CN = [(n : ℤ) - k] := by simp only [hG, Fk, Function.update_apply, if_true]
    -- first product
    have i1 := mulE (I := I) (iprog := iprog) hM dM1 X T (by decide) (by omega) (by omega) s G
      z[k].1 cs[k] _ _ gX gT (hdom _ _)
    rw [g1] at i1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G dM1 [cs[k] * z[k].1] := ⟨_, rfl⟩
    rw [← hG1] at i1
    have i2 := Sp.ir (I := I) (iprog := iprog) (sp_pop (s := s) G1 (i := X) (B := B) (by omega)
      (by rw [hG1, Function.update_apply, if_neg aX, gX]) (by omega))
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 X (z[k].2 :: (gflat (z.drop (k + 1)) ++ lx)) :=
      ⟨_, rfl⟩
    rw [← hG2] at i2
    have g2X : G2 X = z[k].2 :: (gflat (z.drop (k + 1)) ++ lx) := by
      rw [hG2, Function.update_apply, if_pos rfl]
    have g2T : G2 T = cs[k] :: (cs.drop (k + 1) ++ lt) := by
      rw [hG2, Function.update_apply, if_neg hXT.symm, hG1, Function.update_apply, if_neg aT, gT]
    have i3 := mulE (I := I) (iprog := iprog) hM dM2 X T (by decide) (by omega) (by omega) s G2
      z[k].2 cs[k] _ _ g2X g2T (hdom _ _)
    have g22 : G2 dM2 = [] := by
      rw [hG2, Function.update_apply, if_neg bX.symm, hG1, Function.update_apply,
        if_neg (by decide : (dM2 : Fin HS) ≠ dM1), g2]
    rw [g22] at i3
    obtain ⟨G3, hG3⟩ : ∃ G3, G3 = Function.update G2 dM2 [cs[k] * z[k].2] := ⟨_, rfl⟩
    rw [← hG3] at i3
    -- the register part
    have g3X : G3 X = z[k].2 :: (gflat (z.drop (k + 1)) ++ lx) := by
      rw [hG3, Function.update_apply, if_neg bX, g2X]
    have r1 := sp_pop (s := s) G3 (i := X) (B := B) (by omega) g3X (by omega)
    obtain ⟨H1, hH1⟩ : ∃ H1, H1 = Function.update G3 X (gflat (z.drop (k + 1)) ++ lx) := ⟨_, rfl⟩
    rw [← hH1] at r1
    have h1M2 : H1 dM2 = [cs[k] * z[k].2] := by
      rw [hH1, Function.update_apply, if_neg bX.symm, hG3, Function.update_apply, if_pos rfl]
    have h1M1 : H1 dM1 = [cs[k] * z[k].1] := by
      rw [hH1, Function.update_apply, if_neg aX.symm, hG3, Function.update_apply,
        if_neg (by decide : (dM1 : Fin HS) ≠ dM2), hG2, Function.update_apply, if_neg aX.symm, hG1,
        Function.update_apply, if_pos rfl]
    have h1P : H1 rP = 2 ^ P :: l1 := by
      rw [hH1, Function.update_apply, if_neg pX.symm, hG3, Function.update_apply, if_neg bP,
        hG2, Function.update_apply, if_neg pX.symm, hG1, Function.update_apply, if_neg aP, gP]
    have h1Q : H1 rP1 = 2 ^ (P + 1) :: l2 := by
      rw [hH1, Function.update_apply, if_neg qX.symm, hG3, Function.update_apply, if_neg bQ,
        hG2, Function.update_apply, if_neg qX.symm, hG1, Function.update_apply, if_neg aQ, gQ]
    have r2 := Sp.push s H1 (i := Y) (e := rsE dM2) (B := B) (by omega) (rsE_clean (by decide))
      (rsE_ok h1M2 h1P h1Q) rsE_lin (rsE_bnd h1M2 h1P h1Q (by omega) hPB)
    rw [rsE_eval h1M2 h1P h1Q, show (rsE dM2).size = 18 from rfl] at r2
    obtain ⟨H2, hH2⟩ : ∃ H2, H2 = Function.update H1 Y (J6Seg.rs P (cs[k] * z[k].2) :: H1 Y) :=
      ⟨_, rfl⟩
    rw [← hH2] at r2
    have h2M1 : H2 dM1 = [cs[k] * z[k].1] := by rw [hH2, Function.update_apply, if_neg aY.symm, h1M1]
    have h2P : H2 rP = 2 ^ P :: l1 := by rw [hH2, Function.update_apply, if_neg pY.symm, h1P]
    have h2Q : H2 rP1 = 2 ^ (P + 1) :: l2 := by rw [hH2, Function.update_apply, if_neg qY.symm, h1Q]
    have r3 := Sp.push s H2 (i := Y) (e := rsE dM1) (B := B) (by omega) (rsE_clean (by decide))
      (rsE_ok h2M1 h2P h2Q) rsE_lin (rsE_bnd h2M1 h2P h2Q (by omega) hPB)
    rw [rsE_eval h2M1 h2P h2Q, show (rsE dM1).size = 18 from rfl] at r3
    obtain ⟨H3, hH3⟩ : ∃ H3, H3 = Function.update H2 Y (J6Seg.rs P (cs[k] * z[k].1) :: H2 Y) :=
      ⟨_, rfl⟩
    rw [← hH3] at r3
    have r4 := sp_pop (s := s) H3 (i := dM1) (B := B) (by decide)
      (by rw [hH3, Function.update_apply, if_neg aY.symm, h2M1]) (by omega)
    obtain ⟨H4, hH4⟩ : ∃ H4, H4 = Function.update H3 dM1 [] := ⟨_, rfl⟩
    rw [← hH4] at r4
    have r5 := sp_pop (s := s) H4 (i := dM2) (B := B) (by decide)
      (by rw [hH4, Function.update_apply, if_neg (by decide : (dM2 : Fin HS) ≠ dM1), hH3,
        Function.update_apply, if_neg bY.symm, hH2, Function.update_apply, if_neg bY.symm, h1M2])
      (by omega)
    obtain ⟨H5, hH5⟩ : ∃ H5, H5 = Function.update H4 dM2 [] := ⟨_, rfl⟩
    rw [← hH5] at r5
    have h5T : H5 T = cs[k] :: (cs.drop (k + 1) ++ lt) := by
      rw [hH5, Function.update_apply, if_neg bT, hH4, Function.update_apply, if_neg aT,
        hH3, Function.update_apply, if_neg hTY, hH2, Function.update_apply, if_neg hTY, hH1,
        Function.update_apply, if_neg hXT.symm, hG3, Function.update_apply, if_neg bT, g2T]
    have r6 := sp_pushR (s := s) H5 (i := U) (B := B) (by omega) (by omega) h5T (by omega)
    obtain ⟨H6, hH6⟩ : ∃ H6, H6 = Function.update H5 U (cs[k] :: H5 U) := ⟨_, rfl⟩
    rw [← hH6] at r6
    have r7 := sp_pop (s := s) H6 (i := T) (B := B) (by omega)
      (by rw [hH6, Function.update_apply, if_neg hTU, h5T]) (by omega)
    obtain ⟨H7, hH7⟩ : ∃ H7, H7 = Function.update H6 T (cs.drop (k + 1) ++ lt) := ⟨_, rfl⟩
    rw [← hH7] at r7
    have h7C : H7 CN = [(n : ℤ) - k] := by
      simp only [hH7, hH6, hH5, hH4, hH3, hH2, hH1, hG3, hG2, hG1, Function.update_apply,
        if_neg hTC.symm, if_neg hUC.symm, if_neg bC, if_neg aC, if_neg hYC.symm, if_neg hXC.symm,
        gC]
    have hnk : zsz ((n : ℤ) - k) ≤ B := le_trans (zsz_mono (by omega)) hn
    have r8 := Sp.asg s H7 (i := CN) (e := .add (.reg CN) (.lit (-1))) (B := B) (by omega) h7C hnk
      (clean_add (clean_reg (by omega)) (clean_lit _)) ⟨ok_reg h7C, trivial⟩ ⟨trivial, trivial⟩
      ⟨bnd_reg h7C hnk, by show zsz (-1 : ℤ) ≤ B; rw [zsz_neg, zsz_one]; omega, by
        simp only [Ex.eval, top_encK h7C]
        have e : ((n : ℤ) - k + -1) = ((n - (k + 1) : ℕ) : ℤ) := by
          rw [Nat.cast_sub (by omega)]; push_cast; ring
        rw [e]; exact (zsz_nat_le (by omega)).trans hn⟩
    simp only [Ex.eval, top_encK h7C] at r8
    have R := Sp.ir (I := I) (iprog := iprog) (r1.seq (r2.seq (r3.seq (r4.seq (r5.seq (r6.seq
      (r7.seq r8)))))))
    have k1 := KFM.cMulC_le (M := M) hΦ (show zsz z[k].1 ≤ B by omega) (show zsz cs[k] ≤ B by omega)
    have k2 := KFM.cMulC_le (M := M) hΦ (show zsz z[k].2 ≤ B by omega) (show zsz cs[k] ≤ B by omega)
    refine (i1.seq (i2.seq (i3.seq R))).mono' ?_ ?_
    · congr 1; funext j
      simp only [hH7, hH6, hH5, hH4, hH3, hH2, hH1, hG3, hG2, hG1, hG, Fk, Function.update_apply]
      by_cases j1 : j = CN
      · subst j1; simp [hXC.symm, hTC.symm, hUC.symm, hYC.symm, aC, bC]; push_cast; ring
      by_cases j2 : j = Y
      · subst j2
        simp only [j1, hXY.symm, hTY.symm, hUY.symm, aY, bY, if_false, if_true, ↓reduceIte, htw,
          List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
          List.singleton_append, gflat_cons, List.cons_append, hwk, J6Seg.fmul, Ne.symm aY,
          Ne.symm bY]
      by_cases j3 : j = U
      · subst j3
        simp only [j1, j2, hXU.symm, hTU.symm, hUY, aU, bU, if_false, if_true, ↓reduceIte, htc,
          List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
          List.singleton_append, List.cons_append]
      by_cases j4 : j = T
      · subst j4; simp [j1, j2, j3, hXT.symm, aT, bT, Ne.symm aT, Ne.symm bT]
      by_cases j5 : j = X
      · subst j5; simp [j1, j2, j3, j4, aX, bX, Ne.symm aX, Ne.symm bX]
      by_cases j6 : j = dM1
      · subst j6; simp [j1, j2, j3, j4, j5, hm1]
      by_cases j7 : j = dM2
      · subst j7; simp [j1, j2, j3, j4, j5, j6, hm2]
      · simp [j1, j2, j3, j4, j5, j6, j7]
    · simp only [Ex.size]; omega
  have L := IRuns.loop' (I := I) (iprog := iprog) (i := CN) (f := isPos) (p := dgBody pM X T U Y CN)
    (fun k => encK s (Fk k)) (2 * φ + 100000 * (B + 2)) n
    (fun k hk => by
      rw [cl_encK (show Fk k CN = [(n : ℤ) - k] by simp [Fk]), isPos_cls]
      simp only [decide_eq_true_eq]; omega)
    (by rw [cl_encK (show Fk n CN = [(n : ℤ) - n] by simp [Fk]), isPos_cls]; simp) hb
  -- pop the counter, return the used table entries
  have fn : Fk n CN = [0] := by simp [Fk]
  have j1 := Sp.ir (I := I) (iprog := iprog) (sp_pop (s := s) (Fk n) (i := CN) (B := B) (by omega)
    fn (by rw [zsz_zero]; omega))
  have hLt : ((cs.take n).reverse).length = n := by simp; omega
  have fU : Function.update (Fk n) CN [] U = (cs.take n).reverse ++ F U := by
    simp [Fk, Function.update_apply, hUC, hUY]
  have fNn : (encK s (Function.update (Fk n) CN [])).G N = .int (n : ℤ) :: (ints ln ++ s.G N) := by
    simp [Fk, Function.update_apply, hCNe.symm, hYN.symm, hUN.symm, hTN.symm, hXN.symm, hN]
  have j2 := Sp.ir (I := I) (iprog := iprog) (Sp.mvK (X := U) (Y := T) (C := CC) hTU.symm hUK hTK
    (by omega) (by omega) (by omega) s (Function.update (Fk n) CN []) (.reg N) (clean_reg (by omega))
    (IState.isInt_of fNn) ((cs.take n).reverse) (F U) fU
    (by simp only [Ex.eval]; rw [IState.top_eq fNn, hLt]) B
    (KIL.bnd_reverse (fun a ha => (hc a (List.mem_of_mem_take ha)).trans hBzB)) trivial
    (by simp only [Ex.Bnd]; rw [IState.top_eq fNn]; exact hn))
  refine (i0.seq (L.seq (j1.seq j2))).mono' ?_ ?_
  · congr 1; funext j
    simp only [Fk, Function.update_apply]
    by_cases e1 : j = T
    · subst e1
      simp [hTU, hTC, hTY, hXT.symm, ← List.append_assoc, List.take_append_drop, hT]
    by_cases e2 : j = U
    · subst e2; simp [e1, hUC, hUY, hXU.symm]
    by_cases e3 : j = CN
    · subst e3; simp [e1, e2, hYC.symm, hXC.symm, hCN]
    by_cases e4 : j = Y
    · subst e4
      simp [e1, e2, e3, hXY.symm, List.take_of_length_le (le_of_eq hwl)]
    by_cases e5 : j = X
    · subst e5; simp [e1, e2, e3, e4, hn_def]
    · simp [e1, e2, e3, e4, e5]
  · unfold cDG; simp only [Ex.size, hLt]; nlinarith

end J6Seg.KR

end

theorem solution : type_of% @J6Seg.KR.dgI_runs_sol_aux := @J6Seg.KR.dgI_runs_sol_aux
