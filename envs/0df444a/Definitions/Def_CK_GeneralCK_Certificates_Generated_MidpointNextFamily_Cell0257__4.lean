theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨225399883694,225949639508⟩ ⟨750403085270,750488185037⟩ ⟨107051200859,118623560742⟩ := rfl
noncomputable def centerUpper : ℝ := (238885745279 / 549755813888)
