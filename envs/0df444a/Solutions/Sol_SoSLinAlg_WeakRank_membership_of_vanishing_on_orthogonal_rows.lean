section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartT
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
/-- Exponent of the term of `det Dmat` indexed by `π`. -/
def nuP {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) (π : Equiv.Perm J) :
    Var n r →₀ ℕ :=
  ∑ j : J, Finsupp.single (Sum.inr ((π j).1, dcol I J hIJ j)) 1

theorem det_eq {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) :
    D I J hIJ = ∑ π : Equiv.Perm J, monomial (nuP I J hIJ π) (Equiv.Perm.sign π • (1 : ℝ)) := by
  rw [D, Matrix.det_apply]
  refine Finset.sum_congr rfl fun π _ => ?_
  rw [← smul_monomial, nuP, monomial_sum_one]
  rfl

theorem weight_nuP {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r)
    (π : Equiv.Perm J) :
    Finsupp.weight (wt I J r) (nuP I J hIJ π) =
      ∑ j : J, 2 * pos J (π j).1 * (I.card + pos J j.1) := by
  rw [nuP, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finsupp.weight_single]
  simp [wt, (π j).2, dcol]

theorem key_ineq {m : ℕ} {J : Type*} [Fintype J] (q : J → ℕ) (hq : Function.Injective q)
    (π : Equiv.Perm J) (hπ : π ≠ 1) :
    ∑ j, 2 * q (π j) * (m + q j) < ∑ j, 2 * q j * (m + q j) := by
  have hpos : (0 : ℤ) < ∑ j, (((q (π j) : ℤ)) - q j) ^ 2 := by
    obtain ⟨j, hj⟩ : ∃ j, π j ≠ j := by
      by_contra h
      push Not at h
      exact hπ (Equiv.ext h)
    apply Finset.sum_pos' (fun i _ => sq_nonneg _)
    refine ⟨j, Finset.mem_univ _, ?_⟩
    have : (q (π j) : ℤ) - q j ≠ 0 := by
      intro h
      exact hj (hq (by omega))
    positivity
  have e1 : ∑ j, ((q (π j) : ℤ)) = ∑ j, (q j : ℤ) := Equiv.sum_comp π (fun j => (q j : ℤ))
  have e2 : ∑ j, ((q (π j) : ℤ)) ^ 2 = ∑ j, (q j : ℤ) ^ 2 :=
    Equiv.sum_comp π (fun j => (q j : ℤ) ^ 2)
  have ex : ∑ j, (((q (π j) : ℤ)) - q j) ^ 2 =
      ∑ j, ((q (π j) : ℤ)) ^ 2 + ∑ j, (q j : ℤ) ^ 2 - 2 * ∑ j, (q (π j) : ℤ) * q j := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  have l1 : ((∑ j, 2 * q (π j) * (m + q j) : ℕ) : ℤ) =
      2 * m * ∑ j, (q (π j) : ℤ) + 2 * ∑ j, (q (π j) : ℤ) * q j := by
    push_cast
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  have l2 : ((∑ j, 2 * q j * (m + q j) : ℕ) : ℤ) =
      2 * m * ∑ j, (q j : ℤ) + 2 * ∑ j, (q j : ℤ) ^ 2 := by
    push_cast
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [← Nat.cast_lt (α := ℤ), l1, l2, e1]
  linarith

theorem pos_inj' {n : ℕ} (J : Finset (Fin n)) : Function.Injective fun j : J => pos J j.1 :=
  fun a b h => Subtype.ext (pos_inj a.2 b.2 h)

theorem weight_lt {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r)
    (π : Equiv.Perm J) (hπ : π ≠ 1) :
    Finsupp.weight (wt I J r) (nuP I J hIJ π) < Finsupp.weight (wt I J r) (nuP I J hIJ 1) := by
  rw [weight_nuP, weight_nuP]
  exact key_ineq (fun j : J => pos J j.1) (pos_inj' J) π hπ

theorem D_top {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) :
    ∃ (ν : Var n r →₀ ℕ) (c : ℝ), c ≠ 0 ∧
      DegLE (wt I J r) (Finsupp.weight (wt I J r) ν) (D I J hIJ) ∧
      weightedHomogeneousComponent (wt I J r) (Finsupp.weight (wt I J r) ν) (D I J hIJ) =
        monomial ν c ∧
      ∀ l, Disjoint ν.support (mu I J hIJ l).support := by
  classical
  refine ⟨nuP I J hIJ 1, 1, one_ne_zero, ?_, ?_, ?_⟩
  · intro s hs
    rw [det_eq] at hs
    have hs' := support_sum hs
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and] at hs'
    obtain ⟨π, hπ⟩ := hs'
    rw [Finset.mem_singleton.mp (support_monomial_subset hπ)]
    by_cases h1 : π = 1
    · rw [h1]
    · exact (weight_lt I J hIJ π h1).le
  · ext m
    rw [coeff_weightedHomogeneousComponent, det_eq, coeff_sum]
    simp only [coeff_monomial]
    split_ifs with hm h2 h2
    · rw [Finset.sum_eq_single 1]
      · simp [h2]
      · intro π _ hπ
        rw [if_neg]
        rintro rfl
        exact (weight_lt I J hIJ π hπ).ne hm
      · simp
    · rw [Finset.sum_eq_zero]
      intro π _
      rw [if_neg]
      rintro rfl
      by_cases h1 : π = 1
      · exact h2 (by rw [h1])
      · exact (weight_lt I J hIJ π h1).ne hm
    · exact absurd (by rw [← h2]) hm
    · rfl
  · intro l
    rw [Finset.disjoint_left]
    intro v h1 h2
    have h1' := Finsupp.support_finsetSum h1
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and] at h1'
    obtain ⟨j, hj⟩ := h1'
    rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hj)] at h2
    obtain ⟨⟨i', j'⟩, hi', hj'⟩ := l
    dsimp only at hi' hj'
    simp only [mu, col] at h2
    rcases mem_two h2 with h | h <;>
      simp only [Sum.inr.injEq, Prod.mk.injEq, Fin.ext_iff, reduceCtorEq] at h
    obtain ⟨h3, h4⟩ := h
    simp only [dcol, Equiv.Perm.coe_one, id] at h3 h4
    have := pos_lt hi'
    have h5 := Fin.ext h3
    subst h5
    omega

end SoSLinAlg.WeakRank.Dev.Leaf.PartT
end
end

