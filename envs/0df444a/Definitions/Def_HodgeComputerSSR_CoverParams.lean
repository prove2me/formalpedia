lemma locParams_map_evLoc : locParams.map evLoc = Poly1009.params1009 := by
  simp only [locParams, CoverParams.map, Poly1009.params1009, evLoc_S, evLoc_Q, evLoc_T,
    LocK5.evLoc_invOfNe, map_sub, map_ofNat, Poly1009.p1009_inv2, Poly1009.p1009_inv3,
    Poly1009.p1009_inv7, Poly1009.p1009_invT3]
  have h2 : (2 : ZMod 1009)⁻¹ = 505 := (eq_inv_of_mul_eq_one_right (by decide : (2 : ZMod 1009) * 505 = 1)).symm
  have h3 : (3 : ZMod 1009)⁻¹ = 673 := (eq_inv_of_mul_eq_one_right (by decide : (3 : ZMod 1009) * 673 = 1)).symm
  have h7 : (7 : ZMod 1009)⁻¹ = 865 := (eq_inv_of_mul_eq_one_right (by decide : (7 : ZMod 1009) * 865 = 1)).symm
  have h53 : ((5 : ZMod 1009) - 3)⁻¹ = 505 := (eq_inv_of_mul_eq_one_right (by decide : ((5 : ZMod 1009) - 3) * 505 = 1)).symm
  rw [h2, h3, h7, h53]

lemma k5Params_S : k5Params.S = S_K := rfl
