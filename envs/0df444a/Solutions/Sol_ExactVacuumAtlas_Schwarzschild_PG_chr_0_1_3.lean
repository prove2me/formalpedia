open Real
open scoped ContDiff

namespace ExactVacuumAtlas.Schwarzschild.PG

theorem qf_sq {M r : ℝ} (hM : 0 ≤ M) (hr : 0 < r) : qf M r ^ 2 = 2 * M / r :=
  Real.sq_sqrt (by positivity)

@[simp] theorem qf_zero (r : ℝ) : qf 0 r = 0 := by simp [qf]

namespace D

variable {M r : ℝ}

theorem const_mul_qf (K : ℝ) (hM : 0 ≤ M) (hr : 0 < r) :
    HasDerivAt (fun u => K * qf M u) (-K * qf M r / (2 * r)) r := by
  refine ((hasDerivAt_qf hM hr).const_mul K).congr_deriv ?_
  ring

end D

end ExactVacuumAtlas.Schwarzschild.PG

