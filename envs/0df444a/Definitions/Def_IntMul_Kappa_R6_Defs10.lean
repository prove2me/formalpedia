section
-- Source module: NLogN.IEval
/-!
# A functional evaluator for item-language programs

`IOp.run` and `IStmt.run` compute the result state and cost of a program (with fuel for loops and
calls).  A successful evaluation gives an execution (`IStmt.run_exec`), so straight-line code can
be checked by `simp` evaluation instead of step-by-step reasoning.  Input and output operations
are not evaluated (`none`).
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

@[simp] theorem rulerExp_two_pow (m : ℕ) : rulerExp ((2 : ℤ) ^ m) = some m := by
  have h : ((2 : ℤ) ^ m).toNat = 2 ^ m := by
    rw [show ((2 : ℤ) ^ m) = ((2 ^ m : ℕ) : ℤ) by push_cast; rfl, Int.toNat_natCast]
  simp [rulerExp, h, Nat.log2_two_pow]

theorem rulerExp_eq {r : ℤ} {m : ℕ} (h : rulerExp r = some m) : r = 2 ^ m := by
  unfold rulerExp at h; split_ifs at h with h1
  · cases h; exact h1

theorem IOp.run_step {I : List Sym} {o : IOp S} {s s' : IState S} {c : ℕ}
    (h : o.run s = some (s', c)) : o.Step I s s' c := by
  cases o with
  | add i j k =>
    simp only [IOp.run] at h
    split at h
    · rename_i a Li b Lj hi hj
      split_ifs at h with hij
      simp only [Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl⟩ := h; exact .add hij hi hj
    · simp at h
  | neg i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨rfl, rfl⟩ := h; exact .neg hi
  | dup i j =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨hij, rfl, rfl⟩ := h; exact .dup hij hi
  | drop i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨rfl, rfl⟩ := h; exact .drop hi
  | mv i j =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i a L hi; obtain ⟨hij, rfl, rfl⟩ := h; exact .mv hij hi
  | const i c => simp only [IOp.run, Option.some.injEq, Prod.mk.injEq] at h
                 obtain ⟨rfl, rfl⟩ := h; exact .const c
  | mark i => simp only [IOp.run, Option.some.injEq, Prod.mk.injEq] at h
              obtain ⟨rfl, rfl⟩ := h; exact .mark
  | unmark i =>
    simp only [IOp.run] at h; split at h <;> simp at h
    rename_i L hi; obtain ⟨rfl, rfl⟩ := h; exact .unmark hi
  | shl i j =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj hi hj
      split at h
      · rename_i m hm
        simp at h; obtain ⟨hij, rfl, rfl⟩ := h
        exact .shl hij hi (by rw [hj, rulerExp_eq hm])
      · simp at h
    · simp at h
  | split i j k =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj hi hj
      split at h
      · rename_i m hm
        simp at h; obtain ⟨⟨h1, h2, h3⟩, rfl, rfl⟩ := h
        exact .split h1 h2 h3 hi (by rw [hj, rulerExp_eq hm])
      · simp at h
    · simp at h
  | cat i j k =>
    simp only [IOp.run] at h; split at h
    · rename_i a Li r Lj b Lk hi hj hk
      split at h
      · rename_i m hm
        simp at h; obtain ⟨⟨h1, h2, h3, h4, h5, h6⟩, rfl, rfl⟩ := h
        have hb : b = ((b.toNat : ℕ) : ℤ) := by omega
        have e2 : ((2 ^ m : ℕ) : ℤ) = (2 : ℤ) ^ m := by push_cast; rfl
        refine .cat (b := b.toNat) h1 h2 h3 h4 (by omega) hi (by rw [hj, rulerExp_eq hm])
          (by rw [hk, ← hb])
      · simp at h
    · simp at h
  | read => simp [IOp.run] at h
  | write => simp [IOp.run] at h

theorem IStmt.run_exec {I : List Sym} {iprog : Fin P → IStmt S P} :
    ∀ (n : ℕ) (p : IStmt S P) (s s' : IState S) (c : ℕ), IStmt.run iprog n p s = some (s', c) →
      IExec I iprog p s s' c := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ihn =>
  intro p
  induction p with
  | skip => intro s s' c h; simp [IStmt.run] at h; obtain ⟨rfl, rfl⟩ := h; exact .skip s
  | op o => intro s s' c h; simp only [IStmt.run] at h; exact .op (IOp.run_step h)
  | seq p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split at h <;> try simp at h
    rename_i s₁ c₁ h₁
    split at h <;> try simp at h
    rename_i s₂ c₂ h₂
    obtain ⟨rfl, rfl⟩ := h
    exact .seq (ihp _ _ _ h₁) (ihq _ _ _ h₂)
  | ite i f p q ihp ihq =>
    intro s s' c h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteT hf (ihp _ _ _ h₁)
    · obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
      simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
      exact .iteF (by simpa using hf) (ihq _ _ _ h₁)
  | loop i f p ihp =>
    intro s s' c h
    rcases n with _ | n
    · simp [IStmt.run] at h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · split at h <;> try simp at h
      rename_i s₁ c₁ h₁
      split at h <;> try simp at h
      rename_i s₂ c₂ h₂
      obtain ⟨rfl, rfl⟩ := h
      exact .loopT hf (ihp _ _ _ h₁) (ihn n (by omega) _ _ _ _ h₂)
    · simp at h; obtain ⟨rfl, rfl⟩ := h; exact .loopF (by simpa using hf)
  | call j =>
    intro s s' c h
    rcases n with _ | n
    · simp [IStmt.run] at h
    simp only [IStmt.run] at h
    obtain ⟨⟨s₁, c₁⟩, h₁, he⟩ := Option.map_eq_some_iff.mp h
    simp only [Prod.mk.injEq] at he; obtain ⟨rfl, rfl⟩ := he
    exact .call (ihn n (by omega) _ _ _ _ h₁)

theorem IRuns.of_run {I : List Sym} {iprog : Fin P → IStmt S P} {p : IStmt S P} {s t : IState S}
    {c : ℕ} (n : ℕ) {r : IState S × ℕ} (h : IStmt.run iprog n p s = some r) (ht : r.1 = t)
    (hc : r.2 ≤ c) : IRuns I iprog p s t c :=
  ⟨r.2, hc, ht ▸ IStmt.run_exec n p s r.1 r.2 (by rw [h])⟩

end NLogN

end

section
-- Source module: NLogN.SSBase
/-!
# Schönhage–Strassen in the item language: stack layout and Fermat-ring arithmetic

The program uses `NS` item stacks with fixed roles, so that stack (in)equalities are decided by
`simp`.  The current ring `ℤ/(2^n+1)` is given by the ruler `2^n` on top of `RN` and the modulus
`2^n+1` on top of `RF`.
-/

namespace NLogN

open IntMul

@[simp] theorem runsTo_some {S : ℕ} (r : IState S × ℕ) (t : IState S) (c : ℕ) :
    runsTo (some r) t c ↔ r.1 = t ∧ r.2 ≤ c := Iff.rfl

theorem IRuns.of_runsTo_r6c {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P} {p : IStmt S P}
    {s t : IState S} {c : ℕ} (n : ℕ) (h : runsTo (IStmt.run iprog n p s) t c) :
    IRuns I iprog p s t c := by
  unfold runsTo at h
  split at h
  · rename_i r hr; exact IRuns.of_run n hr h.1 h.2
  · exact h.elim

theorem cls_int (z : ℤ) : cls (some (.int z)) =
    if z = 0 then .zero else if z < 0 then .neg else .pos := rfl

@[simp] theorem cls_int_neg (z : ℤ) : cls (some (.int z)) = .neg ↔ z < 0 := by
  rw [cls_int]; split_ifs <;> simp_all <;> omega

@[simp] theorem IState.self_eq_upd {S : ℕ} (s : IState S) (i : Fin S) (L : List Item) :
    s = s.upd i L ↔ s.G i = L := by
  constructor
  · intro h; rw [h]; simp
  · intro h; rw [← h]; simp

@[simp] theorem IState.upd_eq_self {S : ℕ} (s : IState S) (i : Fin S) (L : List Item) :
    s.upd i L = s ↔ s.G i = L := by
  rw [eq_comm]; exact IState.self_eq_upd s i L

