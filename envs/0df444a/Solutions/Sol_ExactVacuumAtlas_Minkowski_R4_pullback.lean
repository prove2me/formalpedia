@[simp] theorem toCart_1 (x : Pt 4) : toCart x 1 = x 1 * sin (x 2) * cos (x 3) := rfl
@[simp] theorem toCart_2 (x : Pt 4) : toCart x 2 = x 1 * sin (x 2) * sin (x 3) := rfl
@[simp] theorem toCart_3 (x : Pt 4) : toCart x 3 = x 1 * cos (x 2) := rfl
@[simp] theorem fromCart_0 (y : Pt 4) : fromCart y 0 = y 0 := rfl
@[simp] theorem fromCart_1 (y : Pt 4) : fromCart y 1 = √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := rfl
@[simp] theorem fromCart_2 (y : Pt 4) :
    fromCart y 2 = arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) := rfl
@[simp] theorem fromCart_3 (y : Pt 4) :
    fromCart y 3 = π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) := rfl

