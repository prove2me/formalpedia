-- title:
--   Regular dlog forces orders divisible by p
-- statement:
--   Let $K$ and $F$ be fields with $F$ a $K$-algebra satisfying [`AlgebraicCurve.IsCurveOver K F`](def/AlgebraicCurve_IsCurveOver.html#L15), i.e. every nonzero $f \in F$ has a divisor of degree $0$ whose value at each place is $\operatorname{ord}_v f$, every place has residue field finite over $K$, and $\Omega_{F/K}$ is free of rank $1$ over $F$; here a place is a valuation subring of $F$ containing the image of $K$, different from $F$ itself, and a principal ideal ring, and $\operatorname{ord}_v$ is the associated normalised additive valuation. Let $p$ be a prime, assume $K$ has characteristic $p$ and is perfect, and fix $x \in F$ such that $F$ is finite-dimensional over the intermediate field $K(x)$ generated by $x$. Let $g \in F$ be such that the logarithmic differential $g^{-1} \cdot d g \in \Omega_{F/K}$ satisfies [`AlgebraicCurve.IsRegularDiff`](def/AlgebraicCurve_Differentials.html#L48), that is, for every place $v$ the coefficient of $g^{-1}\,dg$ with respect to $d t_v$, for the chosen uniformiser $t_v$ at $v$, has nonnegative order at $v$. The conclusion is that $p$ divides $\operatorname{ord}_v g$ in $\mathbb{Z}$ for every place $v$ of $F/K$ (the case $g = 0$ being covered by $\operatorname{ord}_v 0 = 0$).
--
--   This is the converse half of the classical criterion that $\mathrm{dlog}\, g = dg/g$ is a regular differential exactly when $\operatorname{div}(g)$ lies in $p \cdot \operatorname{Div}(F/K)$, the statement underlying the description of the $p$-torsion of $\operatorname{Pic}^0$ by Cartier-fixed regular differentials. It is used in the identification of the image of the map $[D] \mapsto \mathrm{dlog}\, g$ (for $pD = \operatorname{div} g$) with the Cartier-fixed regular differentials, and in the characterisation of when $g^{-1}\,dg$ vanishes.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_dvd_ord_of_isRegularDiff_dlog.lean

import Definitions.Def_AlgebraicCurve_IsCurveOver
import Definitions.Def_AlgebraicCurve_Differentials

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

open KaehlerDifferential

theorem AlgebraicCurve.dvd_ord_of_isRegularDiff_dlog
    {K : Type u} {F : Type v} [Field K] [Field F] [Algebra K F]
    [AlgebraicCurve.IsCurveOver K F] (p : ℕ) [Fact p.Prime]
    [CharP K p] [PerfectField K]
    (x : F) [FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F]
    {g : F} (hreg : AlgebraicCurve.IsRegularDiff K F (g⁻¹ • D K F g)) :
    ∀ v : AlgebraicCurve.Place K F, (p : ℤ) ∣ v.ord g := by sorry
