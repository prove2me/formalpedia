  congr 1; unfold linZ; (((try clear * -); funext x; simp only [update_apply]; split_ifs <;> (try subst_vars) <;> simp_all +decide))

/-- **The identity units.** -/
theorem unitsI (Bu : ℕ) : UnitsOK (I := I) (iprog := iprog) linZ (fun u => zsz u ≤ Bu)
    (fun _ => True) (fun _ => True) (fun _ u => u) (.op (.drop 0)) (.op (.mv 0 rT)) itI
    (.op (.mv rT 0)) (2 * Bu + 2) (2 * moveCost Bu + 19) (300 * (Bu + 1)) (2 * moveCost Bu + 19) :=
  ⟨linZ_ok, drZ_ok Bu, rdZ_ok Bu, itI_ok Bu, bkZ_ok Bu⟩

end units

