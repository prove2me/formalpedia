        (by omega) hpab hφ2 hφ_lo hφ_hi
        (hcell_sub (i, j, k) (by simp [idxSet, hi, hj, hk]))
    refine le_trans hsum_step ?_
    simp only [← Finset.sum_div]
    have hden_nn : 0 ≤ (S_scale : ℝ) * W_scale * W_scale * W_scale :=
      mul_nonneg (mul_nonneg (mul_nonneg (le_of_lt hSpos) (le_of_lt hWpos)) (le_of_lt hWpos)) (le_of_lt hWpos)
    apply div_le_div_of_nonneg_right _ hden_nn
    unfold pieceSumWith
    dsimp only
    rw [sumUpTo_eq_finset_sum]
    apply le_of_eq
    apply Finset.sum_congr rfl; intro i _
    rw [Nat.cast_mul, sumUpTo_eq_finset_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl; intro j _
    rw [Nat.cast_mul, sumUpTo_eq_finset_sum, Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl; intro k _
    rw [Nat.cast_mul]; ring
  have hcert_r : (pieceSumWith ub pa_n pb_n N : ℝ) ≤ (targetBoundNat : ℝ) := by exact_mod_cast hcert
  have hfinal : (pieceSumWith ub pa_n pb_n N : ℝ) / ((S_scale : ℝ) * W_scale * W_scale * W_scale) ≤
