-- Source module: Solutions.KFLCorr3
/-!
# KFL §14: the correction, pass 3 (merge) and the whole correction

Pass 3 rebuilds stack `0` from the bottom: for `d = M-1, …, 0` it pops the flag of `d` and moves
the top record of `sKB` (a moved destination: the sorted entries are in decreasing destination
order) or of `sT` (an unmoved record) to stack `0`.

`corrRS` = pass 1 + radix sort + pass 3; `corrRS_fsp`: on `flR recs M` it produces
`flR (recs ∘ corrR) M`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## Pass 3 -/

set_option maxHeartbeats 2000000 in
theorem p3B_fsp_sol_aux {κ γ : ℕ → ℕ} (hγκ : ∀ m, γ (κ m) = m) {recs : ℕ → List ℤ} {M A B Bb : ℕ}
    (hB2 : 2 ≤ Bb) (hlen : ∀ m, (recs m).length = B) (hbits : ∀ m, Bnd 1 (recs m))
    (zB : zsz (B : ℤ) ≤ Bb) (zK : ∀ d < M, zsz ((d / 2 ^ A : ℕ) : ℤ) ≤ Bb)
    (s : IState HS) (G0 : Fin HS → List ℤ) {k : ℕ} (hk : k < M) :
    FSp (p3B B) (encK s (P3 κ γ recs M A G0 (k + 1))) (encK s (P3 κ γ recs M A G0 k)) (cP3 B Bb) := by
  set G := P3 κ γ recs M A G0 (k + 1) with hG
  have gF : G sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
    simp +decide [G, P3, Function.update_apply, flL_succ]
  have z1 : zsz (1 : ℤ) ≤ Bb := by rw [zsz_one]; omega
  have zF : zsz (flagV κ k) ≤ Bb := by
    unfold flagV; split_ifs
    · exact z1
    · rw [zsz_zero]; omega
  have hc : (Ex.neg (.reg sFL) : Ex HS).Clean := clean_neg (clean_reg (by decide))
  have hok : (Ex.neg (.reg sFL) : Ex HS).ok (encK s G) := ok_reg gF
  have hbd : (Ex.neg (.reg sFL) : Ex HS).Bnd (encK s G) Bb := bnd_reg gF zF
  have hev : (Ex.neg (.reg sFL) : Ex HS).eval (encK s G) = -flagV κ k := by
    simp only [Ex.eval]; rw [top_encK gF]
  have h0 : G 0 = restR (fun d => recs (γ d)) M (k + 1) ++ G0 0 := by
    simp +decide [G, P3, Function.update_apply]
  by_cases hm : κ k ≠ k
  · -- a moved destination: the sorted record of `γ k`
    have gB : G sKB = (recs (γ k)).reverse ++ (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k ++ G0 sKB) := by
      simp +decide [G, P3, Function.update_apply, stkF_succ, mvP, hm]
    have S1 := FSp.mvL (X := sKB) (Y := 0) (C := cMv) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s G _ _ gB 1 Bb (by intro a ha; exact hbits _ a (by simpa using ha))
      (by rw [List.length_reverse, hlen]; exact zB)
    rw [List.length_reverse, hlen, List.reverse_reverse] at S1
    set G1 := Function.update (Function.update G sKB (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k
      ++ G0 sKB)) 0 (recs (γ k) ++ G 0)
    have g1K : G1 sKK = ((k / 2 ^ A : ℕ) : ℤ) :: (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k
        ++ G0 sKK) := by
      simp +decide [G1, G, P3, Function.update_apply, stkK_succ, mvP, hm]
    have S2 := Sp.pop s G1 (B := Bb) (by decide) g1K (zK k hk)
    set G2 := Function.update G1 sKK (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k ++ G0 sKK)
    have T := S1.seq (FSp.of_norep rfl S2)
    have gF2 : G2 sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
      simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact gF
    have S3 := Sp.pop s G2 (B := Bb) (by decide) gF2 zF
    have I := FSp.iteT hc hok trivial hbd (by rw [hev]; simp [flagV, hm]) T
      (b := NLogN.mvK sT 0 cMv (.lit (B : ℤ)))
    refine ((I.seq (FSp.of_norep rfl S3)).congr ?_).mono ?_
    · congr 1
      funext r
      simp only [G2, G1, G, P3]
      by_cases a1 : r = sFL
      · subst a1; simp +decide
      by_cases a2 : r = sKK
      · subst a2; simp +decide
      by_cases a3 : r = sKB
      · subst a3; simp +decide
      by_cases a4 : r = sT
      · subst a4; simp +decide [stkF_succ, mvP, hm]
      by_cases a5 : r = 0
      · subst a5; simp +decide [restR_succ _ hk]
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    · simp only [cP3, Ex.size]; omega
  · -- an unmoved record: `γ k = k`
    push_neg at hm
    have hγ : γ k = k := by have := hγκ k; rwa [hm] at this
    have gT : G sT = (recs k).reverse ++ (stkF (fun m => !mvP κ m) (fun m => (recs m).reverse) k
        ++ G0 sT) := by
      simp +decide [G, P3, Function.update_apply, stkF_succ, mvP, hm]
    have S1 := FSp.mvL (X := sT) (Y := 0) (C := cMv) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) s G _ _ gT 1 Bb (by intro a ha; exact hbits _ a (by simpa using ha))
      (by rw [List.length_reverse, hlen]; exact zB)
    rw [List.length_reverse, hlen, List.reverse_reverse] at S1
    set G1 := Function.update (Function.update G sT (stkF (fun m => !mvP κ m)
      (fun m => (recs m).reverse) k ++ G0 sT)) 0 (recs k ++ G 0)
    have gF1 : G1 sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
      simp only [G1]; rw [upd_ne (by decide), upd_ne (by decide)]; exact gF
    have S3 := Sp.pop s G1 (B := Bb) (by decide) gF1 zF
    have I := FSp.iteF hc hok trivial hbd (by rw [hev]; simp [flagV, hm]) S1
      (a := .seq (NLogN.mvK sKB 0 cMv (.lit (B : ℤ))) (.pop sKK))
    refine ((I.seq (FSp.of_norep rfl S3)).congr ?_).mono ?_
    · congr 1
      funext r
      simp only [G1, G, P3]
      by_cases a1 : r = sFL
      · subst a1; simp +decide
      by_cases a2 : r = sKK
      · subst a2; simp +decide [stkK_succ, mvP, hm]
      by_cases a3 : r = sKB
      · subst a3; simp +decide [stkF_succ, mvP, hm]
      by_cases a4 : r = sT
      · subst a4; simp +decide
      by_cases a5 : r = 0
      · subst a5; simp +decide [restR_succ _ hk, hγ]
      simp [Function.update_apply, a1, a2, a3, a4, a5]
    · simp only [cP3, Ex.size]; omega

/-! ## The whole correction -/

end NLogN.KFL

end

