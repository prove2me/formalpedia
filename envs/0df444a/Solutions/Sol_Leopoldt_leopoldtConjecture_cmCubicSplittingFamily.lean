open NumberField Polynomial Algebra

namespace Leopoldt.FamilyCM

variable (t : ℕ) [Fact (2 ≤ t)]

noncomputable def gaussianPolynomial : (CubicK t)[X] := X ^ 2 + 1

private theorem gaussianPolynomial_natDegree : (gaussianPolynomial t).natDegree = 2 := by
  unfold gaussianPolynomial
  compute_degree!

theorem gaussianPolynomial_irreducible : Irreducible (gaussianPolynomial t) := by
  apply irreducible_of_degree_le_three_of_not_isRoot
  · rw [(gaussianPolynomial_natDegree t)]
    decide
  · intro x hx
    have hs : x ^ 2 + 1 = 0 := by simpa [Polynomial.IsRoot, gaussianPolynomial] using hx
    have hr : ((cubicRealEmbedding t) x)^2 + 1 = 0 := by
      simpa only [map_add, map_pow, map_one, map_zero] using congrArg (cubicRealEmbedding t) hs
    nlinarith [sq_nonneg ((cubicRealEmbedding t) x)]

instance : Fact (Irreducible (gaussianPolynomial t)) := ⟨(gaussianPolynomial_irreducible t)⟩

/-- The field obtained by adjoining a root of `X² + 1` to the cubic splitting field. -/
abbrev CMFamily := AdjoinRoot (gaussianPolynomial t)

instance : FiniteDimensional (CubicK t) (CMFamily t) :=
  (AdjoinRoot.powerBasis (gaussianPolynomial_irreducible t).ne_zero).finite

instance : NumberField (CMFamily t) where
  to_charZero := charZero_of_injective_algebraMap (algebraMap (CubicK t) (CMFamily t)).injective
  to_finiteDimensional := Module.Finite.trans (CubicK t) (CMFamily t)

instance : IsQuadraticExtension (CubicK t) (CMFamily t) where
  finrank_eq_two' := finrank_quotient_span_eq_natDegree.trans (gaussianPolynomial_natDegree t)

theorem gaussianRoot_sq_add_one : (AdjoinRoot.root (gaussianPolynomial t))^2 + 1 = 0 := by
  have h := AdjoinRoot.mk_self (f := (gaussianPolynomial t))
  change AdjoinRoot.mk (gaussianPolynomial t) (X ^ 2 + 1) = 0 at h
  simpa only [map_add, map_pow, map_one, AdjoinRoot.mk_X] using h

instance : IsTotallyComplex (CMFamily t) where
  isComplex w := InfinitePlace.not_isReal_iff_isComplex.mp fun hw => by
    let f := InfinitePlace.embedding_of_isReal hw
    have h : (f (AdjoinRoot.root (gaussianPolynomial t))) ^ 2 + 1 = 0 := by
      simpa only [map_add, map_pow, map_one, map_zero] using congrArg f (gaussianRoot_sq_add_one t)
    nlinarith [sq_nonneg (f (AdjoinRoot.root (gaussianPolynomial t)))]

instance : IsCMField (CMFamily t) := IsCMField.ofCMExtension (CubicK t) (CMFamily t)

theorem cmFamily_degree : Module.finrank ℚ (CMFamily t) = 12 := by
  have hc : Module.finrank ℚ (CubicK t) = 6 := by
    rw [← IsGalois.card_aut_eq_finrank, ← Fintype.card_eq_nat_card, card_cubicGalois_eq_six]
  rw [← Module.finrank_mul_finrank ℚ (CubicK t) (CMFamily t), hc,
    IsQuadraticExtension.finrank_eq_two (CubicK t) (CMFamily t)]

instance : IsSplittingField (CubicK t) (CMFamily t) (gaussianPolynomial t) where
  splits' := by
    let i := AdjoinRoot.root (gaussianPolynomial t)
    have hi : i^2 = -1 := eq_neg_of_add_eq_zero_left (gaussianRoot_sq_add_one t)
    have hm : (gaussianPolynomial t).map (algebraMap (CubicK t) (CMFamily t)) = X^2 + 1 := by
      change (X^2 + 1 : (CubicK t)[X]).map (algebraMap (CubicK t) (CMFamily t)) = _
      simp only [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_one]
    rw [hm, show (X^2 + 1 : (CMFamily t)[X]) = (X - C i) * (X - C (-i)) by
      calc
        X^2 + 1 = X^2 - C (i^2) := by simp [hi]
        _ = _ := by simp only [map_neg, map_pow]; ring]
    exact (Splits.X_sub_C _).mul (Splits.X_sub_C _)
  adjoin_rootSet' := by
    apply le_antisymm le_top
    rw [← AdjoinRoot.adjoinRoot_eq_top (f := (gaussianPolynomial t))]
    apply Algebra.adjoin_mono
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact mem_rootSet.mpr ⟨(gaussianPolynomial_irreducible t).ne_zero,
      by rw [aeval_def, AdjoinRoot.algebraMap_eq, AdjoinRoot.eval₂_root]⟩

/-- The polynomial whose splitting field is the composite of `(CubicK t)` and `ℚ(i)`. -/
noncomputable def cmFamilyPolynomial : ℚ[X] := cubicPolynomial t ℚ * (X^2 + 1)

instance : IsSplittingField ℚ (CMFamily t) (cmFamilyPolynomial t) := by
  let _ : IsSplittingField ℚ (CubicK t) (cubicPolynomial t ℚ) :=
    Polynomial.IsSplittingField.splittingField (cubicPolynomial t ℚ)
  have hmap : ((X^2 + 1 : ℚ[X]).map (algebraMap ℚ (CubicK t))) = (gaussianPolynomial t) := by
    simp only [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_one]
    rfl
  let _ : IsSplittingField (CubicK t) (CMFamily t) ((X^2 + 1 : ℚ[X]).map (algebraMap ℚ (CubicK t))) := by
    rw [hmap]
    infer_instance
  have hq : (X^2 + 1 : ℚ[X]) ≠ 0 := by
    have hdeg : (X^2 + 1 : ℚ[X]).natDegree = 2 := by compute_degree!
    intro h
    rw [h, natDegree_zero] at hdeg
    exact (by decide : ¬ (0 : ℕ) = 2) hdeg
  exact IsSplittingField.mul (K := (CubicK t)) (L := (CMFamily t)) (cubicPolynomial t ℚ) (X^2 + 1)
    (cubicPolynomial_monic t ℚ).ne_zero hq

abbrev CMFamilySplitting := (cmFamilyPolynomial t).SplittingField

instance : NumberField (CMFamilySplitting t) where
  to_charZero := inferInstance
  to_finiteDimensional := inferInstance


noncomputable def cmFamilySplittingEquiv : (CMFamilySplitting t) ≃ₐ[ℚ] (CMFamily t) :=
  (IsSplittingField.algEquiv (CMFamily t) (cmFamilyPolynomial t)).symm

instance : IsTotallyComplex (CMFamilySplitting t) where
  isComplex w := InfinitePlace.not_isReal_iff_isComplex.mp fun hw => by
    let f := (InfinitePlace.embedding_of_isReal hw).comp (cmFamilySplittingEquiv t).symm.toRingHom
    have h : (f (AdjoinRoot.root (gaussianPolynomial t))) ^ 2 + 1 = 0 := by
      simpa only [map_add, map_pow, map_one, map_zero] using congrArg f (gaussianRoot_sq_add_one t)
    nlinarith [sq_nonneg (f (AdjoinRoot.root (gaussianPolynomial t)))]

theorem cmFamilySplitting_isCMField : IsCMField (CMFamilySplitting t) := by
  let F := CubicK t
  let L := CMFamilySplitting t
  let e := cmFamilySplittingEquiv t
  let _ : Algebra F L := (e.symm.toRingHom.comp (algebraMap F (CMFamily t))).toAlgebra
  let eF : L ≃ₐ[F] CMFamily t :=
    { e.toRingEquiv with commutes' := fun x => e.apply_symm_apply (algebraMap F (CMFamily t) x) }
  let _ : IsQuadraticExtension F L :=
    ⟨eF.toLinearEquiv.finrank_eq.trans (IsQuadraticExtension.finrank_eq_two F (CMFamily t))⟩
  exact IsCMField.ofCMExtension F L

theorem cmFamilySplitting_degree : Module.finrank ℚ (CMFamilySplitting t) = 12 :=
  (cmFamilySplittingEquiv t).toLinearEquiv.finrank_eq.trans (cmFamily_degree t)

instance : IsGalois ℚ (CMFamily t) where
  to_isSeparable := inferInstance
  to_normal := Normal.of_isSplittingField (cmFamilyPolynomial t)

theorem cmFamily_noncommutative : ¬ IsMulCommutative ((CMFamily t) ≃ₐ[ℚ] (CMFamily t)) := by
  intro hcomm
  apply cubicGalois_not_commutative t
  refine ⟨⟨fun x y => ?_⟩⟩
  obtain ⟨a, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := ℚ) (CMFamily t) x
  obtain ⟨b, rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := ℚ) (CMFamily t) y
  simpa only [map_mul] using congrArg
    (AlgEquiv.restrictNormalHom (CubicK t) :
      ((CMFamily t) ≃ₐ[ℚ] (CMFamily t)) →* ((CubicK t) ≃ₐ[ℚ] (CubicK t)))
    (hcomm.is_comm.comm a b)

end Leopoldt.FamilyCM

end

section

open NumberField Polynomial Algebra

namespace Leopoldt

/-- Transport a zero Leopoldt defect across an isomorphism of number fields. -/
theorem conjecture_of_ringEquiv (p : ℕ) [Fact p.Prime]
    (F L : Type*) [Field F] [NumberField F] [Field L] [NumberField L]
    (e : F ≃+* L) (hL : LeopoldtConjecture p L) : LeopoldtConjecture p F := by
  let _ : Algebra F L := e.toRingHom.toAlgebra
  let _ : FiniteDimensional F L :=
    Module.Finite.of_surjective (Algebra.linearMap F L) e.surjective
  by_contra h
  exact (Nat.ne_of_gt (defect_pos_of_defect_pos p F L (Nat.pos_of_ne_zero h))) hL

/-- A CM extension inherits Leopoldt from its totally real base. -/
theorem conjecture_of_CMExtension (p : ℕ) [Fact p.Prime]
    (F L : Type*) [Field F] [NumberField F] [IsTotallyReal F]
    [Field L] [NumberField L] [IsTotallyComplex L] [Algebra F L]
    [IsQuadraticExtension F L] (hF : LeopoldtConjecture p F) :
    LeopoldtConjecture p L := by
  let _ : IsCMField L := IsCMField.ofCMExtension F L
  exact (leopoldtConjecture_iff_maximalRealSubfield p L).2
    (conjecture_of_ringEquiv p (maximalRealSubfield L) F
      (CMExtension.equivMaximalRealSubfield F L).symm hF)

end Leopoldt

end

open NumberField

theorem solution
    (t : ℕ) (ht : 2 ≤ t) (p : ℕ) [Fact p.Prime] (hodd : p ≠ 2) (hdiv : p ∣ t) :
    let K := ((Polynomial.X ^ 3 - Polynomial.C ((t : ℚ) ^ 2) * Polynomial.X - 1) * (Polynomial.X ^ 2 + 1)).SplittingField
    letI : NumberField K := { to_charZero := inferInstance, to_finiteDimensional := inferInstance }
    Leopoldt.LeopoldtConjecture p K := by
  letI : Fact (2 ≤ t) := ⟨ht⟩
  let F := Leopoldt.FamilyCM.CubicK t
  let K := Leopoldt.FamilyCM.CMFamily t
  change Leopoldt.LeopoldtConjecture p (Leopoldt.FamilyCM.CMFamilySplitting t)
  have hF : Leopoldt.LeopoldtConjecture p F :=
    Leopoldt.leopoldtConjecture_cubicSplittingFamily t ht p hodd hdiv
  exact Leopoldt.conjecture_of_ringEquiv p (Leopoldt.FamilyCM.CMFamilySplitting t) K
    (Leopoldt.FamilyCM.cmFamilySplittingEquiv t).toRingEquiv
    (Leopoldt.conjecture_of_CMExtension p F K hF)
