set_option autoImplicit false

/-!
Composition of the parity generator with the historical orbit construction.

The equality below is an equality of finite families of entire H-orbits,
not equality of representatives or their iteration order. Deduplication is
applied to an explicit list enumeration of the parity representatives. The
list and its anchors are inputs with stated representation contracts; no
classical `Finset.toList` is hidden in an executable definition.
-/

namespace Couret.STROBO2TORS

variable {G : Type*} [AddCommGroup G] [DecidableEq G] [Fintype G]

/-- The compact generator and historical edge generator represent precisely
the same quotient of the realized fibre by two-torsion translations. -/
theorem recoh_parity_orbit_families_eq_legacy
    (U : Finset G) (R : G → ℕ) (half : G → Option G)
    (hhalf : RecohHalfSolverSpec half) (hR : ∀ z, R z ≠ 0 → z ∈ U) :
    (recohParityRepresentatives U R half).image torsionOrbit =
      (recohSquareRepresentatives U R half).image torsionOrbit := by
  obtain ⟨hsound, hcomplete⟩ := recoh_parity_representatives_cover U R half hhalf hR
  exact recoh_orbit_families_eq_of_sound_complete R
    (recohParityRepresentatives U R half) (recohSquareRepresentatives U R half)
    hsound hcomplete
    (recoh_square_representatives_sound U R half hR)
    (recoh_square_representatives_complete U R half hhalf hR)





section Cyclic

variable {d : ℕ} (q : Fin d → ℕ) [∀ i, NeZero (q i)]

/-- The compact generator instantiated with the existing cyclic square
interpretation and the verified product half-solver. -/
def recohCyclicParityRepresentatives
    (entries : List (((i : Fin d) → ZMod (q i)) × ℕ)) :
    Finset (Finset ((i : Fin d) → ZMod (q i))) :=
  recohParityRepresentatives (recohSelectedSquareSupport q entries)
    (recohTypedSquareValue entries) (recohProductHalf q)

theorem recoh_cyclic_parity_representatives_cover
    (entries : List (((i : Fin d) → ZMod (q i)) × ℕ)) :
    RecohParityCover (recohTypedSquareValue entries)
      (recohCyclicParityRepresentatives q entries) := by
  exact recoh_parity_representatives_cover
    (recohSelectedSquareSupport q entries) (recohTypedSquareValue entries)
    (recohProductHalf q) (recoh_product_half_spec q)
    (recoh_selected_square_support_covered q entries)



/-- All half-solver and square-support contracts are discharged by their
historical cyclic proofs; the conclusion has no abstract solver hypothesis. -/
theorem recoh_cyclic_parity_orbit_families_eq_legacy
    (entries : List (((i : Fin d) → ZMod (q i)) × ℕ)) :
    (recohCyclicParityRepresentatives q entries).image torsionOrbit =
      (recohCyclicSquareRepresentatives q entries).image torsionOrbit := by
  exact recoh_parity_orbit_families_eq_legacy
    (recohSelectedSquareSupport q entries) (recohTypedSquareValue entries)
    (recohProductHalf q) (recoh_product_half_spec q)
    (recoh_selected_square_support_covered q entries)

end Cyclic

end Couret.STROBO2TORS


