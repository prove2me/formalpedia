-- Source module: Solutions.KFBPhase
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel KIL KFD Complex

theorem Sm_ipw (k : ℕ) : Sm (ipw k) := by
  unfold ipw Sm; split_ifs <;> simp

theorem Sm_zero : Sm (0 : GI) := by simp [Sm]

theorem sum_bits_lt (d : ℕ → ℕ) (hd : ∀ p, d p < 2) :
    ∀ K, ∑ p ∈ Finset.range K, d p * 2 ^ p < 2 ^ K
  | 0 => by simp
  | K + 1 => by
    rw [Finset.sum_range_succ, pow_succ]
    have := sum_bits_lt d hd K
    have : d K * 2 ^ K ≤ 1 * 2 ^ K := Nat.mul_le_mul_right _ (by have := hd K; omega)
    omega

theorem sum_bits_div (d : ℕ → ℕ) (hd : ∀ p, d p < 2) :
    ∀ K q, q < K → (∑ p ∈ Finset.range K, d p * 2 ^ p) / 2 ^ q % 2 = d q
  | 0, q, h => absurd h (Nat.not_lt_zero _)
  | K + 1, q, h => by
    rw [Finset.sum_range_succ]
    rcases Nat.lt_succ_iff_lt_or_eq.1 h with h | h
    · obtain ⟨t, rfl⟩ : ∃ t, K = q + 1 + t := ⟨K - q - 1, by omega⟩
      rw [show d (q + 1 + t) * 2 ^ (q + 1 + t) = 2 ^ q * (2 * (d (q + 1 + t) * 2 ^ t)) by ring,
        Nat.add_mul_div_left _ _ (by positivity), Nat.add_mul_mod_self_left]
      exact sum_bits_div d hd _ q h
    · subst h
      have hl := sum_bits_lt d hd q
      rw [Nat.add_mul_div_right _ _ (by positivity), Nat.div_eq_of_lt hl, zero_add,
        Nat.mod_eq_of_lt (hd q)]

theorem adig_lt {m n : ℕ} (b : Fin m × Fin n → Fin 2) (i : ℕ) : adig b i < 2 := by
  unfold adig; split_ifs
  · exact (b _).isLt
  · norm_num

theorem aidx_eq {m n : ℕ} (b : Fin m × Fin n → Fin 2) :
    aidx b = ∑ i ∈ Finset.range (m * n), adig b i * 2 ^ i := by
  unfold aidx
  rw [← Equiv.sum_comp finProdFinEquiv.symm, ← Fin.sum_univ_eq_sum_range
    (fun i => adig b i * 2 ^ i)]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [adig, i.isLt, dif_pos, Fin.eta, Equiv.apply_symm_apply]

theorem aidx_lt {m n : ℕ} (b : Fin m × Fin n → Fin 2) : aidx b < 2 ^ (m * n) := by
  rw [aidx_eq]; exact sum_bits_lt _ (adig_lt b) _

theorem aidx_bit {m n : ℕ} (b : Fin m × Fin n → Fin 2) (i : ℕ) (hi : i < m * n) :
    aidx b / 2 ^ i % 2 = adig b i := by
  rw [aidx_eq]; exact sum_bits_div _ (adig_lt b) _ _ hi

theorem length_segApply (off : ℕ) (Ms : List M2G) (B1 G : ℕ) (zs : List GI)
    (h : off + G * (2 * B1 * Ms.length) ≤ zs.length) :
    (segApply off Ms B1 G zs).length = zs.length := by
  unfold segApply
  rw [List.length_append, List.length_append, length_qopL _ _ _ _ (by simp; omega)]
  simp; omega

theorem GB_getD {w : ℕ} {zs : List GI} :
    NLogN.KFB.GB w zs ↔ ∀ i < zs.length, zsz (zs.getD i 0).1 ≤ w ∧ zsz (zs.getD i 0).2 ≤ w := by
  constructor
  · intro h i hi
    rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · intro h z hz
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
    have := h i hi
    rwa [List.getD_eq_getElem _ _ hi] at this

theorem seg_iff {N w w' j : ℕ} (hj : j < N) :
    (w * N ≤ w' * N + j ∧ w' * N + j < w * N + N) ↔ w' = w := by
  constructor
  · rintro ⟨h1, h2⟩
    rcases lt_trichotomy w' w with h | h | h
    · have : (w' + 1) * N ≤ w * N := Nat.mul_le_mul_right _ h
      rw [Nat.succ_mul] at this; omega
    · exact h
    · have : (w + 1) * N ≤ w' * N := Nat.mul_le_mul_right _ h
      rw [Nat.succ_mul] at this; omega
  · rintro rfl; omega

theorem Cl.upd0 {f : Fin HS → List ℤ} (h : Cl f) (v : List ℤ) : Cl (Function.update f 0 v) :=
  ⟨⟨by simp +decide [h.scr.t], by simp +decide [h.scr.o], by simp +decide [h.scr.ur],
    by simp +decide [h.scr.ui], by simp +decide [h.scr.vr], by simp +decide [h.scr.vi],
    by simp +decide [h.scr.c]⟩, by simp +decide [h.a], by simp +decide [h.g], by simp +decide [h.b],
    by simp +decide [h.b2], by simp +decide [h.b4], by simp +decide [h.rg], by simp +decide [h.rn],
    by simp +decide [h.rp], by simp +decide [h.p]⟩

end NLogN.KFB

