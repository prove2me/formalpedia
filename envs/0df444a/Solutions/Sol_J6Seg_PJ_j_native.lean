-- Source module: Solutions.J6SegVal7
/-!
# B-line value bounds 7: the `J`-kernel facts in the round-six regime, and `ValNeed6`

* `w_le_LJ`: the first `w` positions are near-boundary, so `w ≤ |LJ s t λ w|` when `w ≤ s`.
* `jNeed6_of`: `P.Ok → JNeed6 P` (from B4: `r6_segReg`, `JK.jPre_line`, `JK.jKerG_out_bnd`).
* **`valNeed6_all`**: `P.Ok → ChunkTabBnd6 P → ∀ ap, ValCond6 ap → ValNeed6 P ap`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

/-- **`w ≤ |LJ|`** (the positions `j < w` are near the left boundary of their block). -/
theorem w_le_LJ {s t lam w : ℕ} (hw : w ≤ s) : w ≤ (LJ s t lam w).length := by
  unfold LJ Jlist
  have hs : (mkBlocks s t lam w).s = s := rfl
  have e : List.range s = List.range w ++ (List.range (s - w)).map (w + ·) := by
    rw [← List.range_add]; congr 1; omega
  rw [hs, e, List.filter_append, List.length_append]
  have : (List.range w).filter (nearB (mkBlocks s t lam w)) = List.range w := by
    rw [List.filter_eq_self]
    intro j hj
    rw [List.mem_range] at hj
    have h1 : (mkBlocks s t lam w).st j ≤ j := stF_le j
    have h2 : (mkBlocks s t lam w).w = w := rfl
    unfold nearB
    rw [h2]
    simp only [decide_eq_true_eq]
    left; omega
  rw [this, List.length_range]
  omega

end J6Seg.Val
end

