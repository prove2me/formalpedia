theorem nz_eq {α : Type} (x : Nat) (a : α) (f : Nat → α) : nz x a f = if x = 0 then a else f x := by
  cases x <;> rfl

theorem force_eq {α : Type} (x : Nat) (k : Nat → α) : force x k = k x := by cases x <;> rfl

theorem brec_eq {α : Type} (b : Bool) (f t : α) : (Bool.rec f t b : α) = if b = true then t else f := by
  cases b <;> rfl

theorem n_land (a b : Nat) : Nat.land a b = a &&& b := rfl
theorem n_lor (a b : Nat) : Nat.lor a b = a ||| b := rfl
theorem n_xor (a b : Nat) : Nat.xor a b = a ^^^ b := rfl
theorem n_shr (a b : Nat) : Nat.shiftRight a b = a / 2 ^ b := Nat.shiftRight_eq_div_pow a b
theorem n_shl (a b : Nat) : Nat.shiftLeft a b = a <<< b := rfl
theorem n_add (a b : Nat) : Nat.add a b = a + b := rfl
theorem n_mul (a b : Nat) : Nat.mul a b = a * b := rfl
theorem n_sub (a b : Nat) : Nat.sub a b = a - b := rfl
theorem n_div (a b : Nat) : Nat.div a b = a / b := rfl
theorem n_mod (a b : Nat) : Nat.mod a b = a % b := rfl
theorem n_ble (a b : Nat) : (Nat.ble a b = true) = (a ≤ b) := by simp
theorem n_beq (a b : Nat) : (Nat.beq a b = true) = (a = b) := by simp
theorem m25 (x : Nat) : x &&& 33554431 = x % 2 ^ 25 := Nat.and_two_pow_sub_one_eq_mod x 25
theorem m50 (x : Nat) : x &&& 1125899906842623 = x % 2 ^ 50 := Nat.and_two_pow_sub_one_eq_mod x 50

