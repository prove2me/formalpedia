        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u047 hγ hstate
  have s1 := sol_u048 hγ (by simpa [gu047, gu048] using s0.1)
  have s2 := sol_u049 hγ (by simpa [gu048, gu049] using s1.1)
  have s3 := sol_u050 hγ (by simpa [gu049, gu050] using s2.1)
  have s4 := sol_u051 hγ (by simpa [gu050, gu051] using s3.1)
  refine ⟨s4.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu047.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu048.lo : ℝ) < x := by
        have hb : (gu047.top : ℝ) = (gu048.lo : ℝ) := by simp [gu047, gu048]
        linarith
    by_cases h1 : x ≤ (gu048.top : ℝ)
