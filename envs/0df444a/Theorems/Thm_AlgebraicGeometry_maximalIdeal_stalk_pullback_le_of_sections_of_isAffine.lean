-- title:
--   Maximal ideal at a rational point of an affine fibre product
-- statement:
--   Let $k$ be a field and let $Y$ and $Z$ be schemes (in a fixed universe) that are affine, equipped with morphisms $p_Y : Y \to \operatorname{Spec} k$ and $p_Z : Z \to \operatorname{Spec} k$. Suppose given $k$-points $y : \operatorname{Spec} k \to Y$ and $z : \operatorname{Spec} k \to Z$ which are sections, that is $y$ followed by $p_Y$ is the identity of $\operatorname{Spec} k$ and likewise $z$ followed by $p_Z$ is the identity. Let $w$ be a point of the underlying space of the fibre product $Y \times_{\operatorname{Spec} k} Z$, and assume $w$ is the image of the closed point of $\operatorname{Spec} k$ under the morphism $\operatorname{Spec} k \to Y \times_{\operatorname{Spec} k} Z$ obtained from $y$ and $z$ by the universal property (the two composites agreeing by the section hypotheses). Then the maximal ideal of the local ring of $Y \times_{\operatorname{Spec} k} Z$ at $w$ is contained in the join of the ideal generated by the image of the maximal ideal of the stalk at the first projection's image of $w$ under the stalk map of $\mathrm{pr}_1$ and the corresponding ideal for $\mathrm{pr}_2$.
--
--   This is the affine case of the statement that the local ring of a fibre product of two $k$-schemes at a pair of $k$-rational points has its maximal ideal generated by the images of the maximal ideals of the two factors; since the reverse inclusion is automatic, the conclusion is in fact an equality. It is cited by [`AlgebraicGeometry.maximalIdeal_stalk_pullback_le_of_sections`](thm.html#AlgebraicGeometry.maximalIdeal_stalk_pullback_le_of_sections), the version without affineness hypotheses, which reduces to it by passing to affine open neighbourhoods of the two points.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicGeometry_maximalIdeal_stalk_pullback_le_of_sections_of_isAffine.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing

universe u

theorem AlgebraicGeometry.maximalIdeal_stalk_pullback_le_of_sections_of_isAffine
    {k : Type u} [Field k] {Y Z : Scheme.{u}} [IsAffine Y] [IsAffine Z]
    (pY : Y ⟶ Spec (.of k)) (pZ : Z ⟶ Spec (.of k))
    (y : Spec (.of k) ⟶ Y) (hy : y ≫ pY = 𝟙 _) (z : Spec (.of k) ⟶ Z) (hz : z ≫ pZ = 𝟙 _)
    (w : ↑(pullback pY pZ)) (hw : w = (pullback.lift y z (hy.trans hz.symm)) (closedPoint k)) :
    maximalIdeal ((pullback pY pZ).presheaf.stalk w) ≤
      (maximalIdeal _).map ((pullback.fst pY pZ).stalkMap w).hom ⊔
        (maximalIdeal _).map ((pullback.snd pY pZ).stalkMap w).hom := by sorry
