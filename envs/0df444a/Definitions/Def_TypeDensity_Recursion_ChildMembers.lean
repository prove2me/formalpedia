section

variable (U : SurfaceUniverse)

theorem self_list {i : U.ι} {c : (U.M i).cellIndex} (h : (U.M i).IsSelfCell c) :
    (U.M i).childList c = [(1, (U.M i).s)] :=
  h.choose_spec.choose_spec.2

theorem self_len {i : U.ι} {c : (U.M i).cellIndex} (h : (U.M i).IsSelfCell c) :
    ((U.M i).childList c).length = 1 := by
  rw [self_list U h]; rfl

def selfChildIdx {i : U.ι} {c : (U.M i).cellIndex} (h : (U.M i).IsSelfCell c) :
    (U.M i).childIdx c := ⟨0, by rw [self_len U h]; omega⟩

end

