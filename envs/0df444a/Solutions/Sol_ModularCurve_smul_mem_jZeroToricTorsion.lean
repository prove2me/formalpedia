  obtain ⟨hxm, y, hy, rfl⟩ := hx
  refine ⟨?_, t • y, ?_, ?_⟩
  ·
    change t • eisensteinNumerator p • y ∈ (Submodule.torsionBy ℤ (JZero p) (m : ℤ)).toAddSubgroup
    change eisensteinNumerator p • y ∈ (Submodule.torsionBy ℤ (JZero p) (m : ℤ)).toAddSubgroup at hxm
