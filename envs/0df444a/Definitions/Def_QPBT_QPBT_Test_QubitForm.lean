/-!
# Qubit form of Pauli basis test soundness

The fixed self-dual normal basis converts the qudit EPR register and generalized
Pauli projectors into qubit coordinates. The conversion uses only the basis
stored in the canonical `FixedFieldModel`.

`PauliSoundnessWitness.toQubit` transports supplied existential data, and the
three `qubit_*_to_qubit` identities preserve its comparison quantities exactly.
These are Lean-only transport results, not soundness existence theorems. This
module derives `pauli_soundness_qubit` from `pauli_soundness` using those identities.
`pauli_soundness` itself is now proved, so the corollary is complete: its
axiom closure is `propext`, `Classical.choice` and `Quot.sound`. The
composition that discharged it is recorded in issue Dengnifer/MIPStarRE-QPBT-bak#614, under the
umbrella issue Dengnifer/MIPStarRE-QPBT-bak#529.

## References

The conversion is blueprint
`lem:pauli-binary`, from
`references/qpbt-paper/04_preliminaries.tex:1163-1208`. The resulting
statement is blueprint `cor:pauli-binary`,
from `references/qpbt-paper/08_classical_and_quantum_low_degree_tests.tex:1450-1491`.
-/

@[expose] public section

open scoped BigOperators Matrix

namespace MIPStarRE.QPBT

open LIDT.MIPStarRE.LDT LIDT.MIPStarRE.Quantum

noncomputable section

/-- The bit register obtained by expanding every Pauli-register field element
in the basis stored by `P.model`. -/
abbrev QubitRegister (P : _root_.MIPStarRE.QPBT.AdmissibleParams) :=
  _root_.MIPStarRE.QPBT.Cube P.m × Fin P.model.basisDim → ZMod 2

/-- The ideal auxiliary state tensored with the qubit EPR register, in the
local-player ordering used by `cor:pauli-binary`. -/
noncomputable def idealQubitState (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    {ιA' ιB' : Type*} [Fintype ιA'] [DecidableEq ιA']
    [Fintype ιB'] [DecidableEq ιB']
    (aux : EuclideanSpace ℂ (ιA' × ιB')) :
    EuclideanSpace ℂ
      ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  (EuclideanSpace.equiv
      ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) ℂ).symm
    (fun p =>
      (EuclideanSpace.equiv (ιA' × ιB') ℂ aux (p.1.1, p.2.1)) *
        (EuclideanSpace.equiv (_root_.MIPStarRE.QPBT.QubitRegister P × _root_.MIPStarRE.QPBT.QubitRegister P) ℂ
          (_root_.MIPStarRE.QPBT.eprState (_root_.MIPStarRE.QPBT.QubitRegister P)) (p.1.2, p.2.2)))

/-- The local isometries, auxiliary spaces, and unit auxiliary state in
`cor:pauli-binary`; this structure introduces no hypothesis beyond the paper
theorem. -/
structure QubitSoundnessWitness (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)) where
  ιA' : Type
  ιB' : Type
  [ιAFintype : Fintype ιA']
  [ιBFintype : Fintype ιB']
  [ιADecidableEq : DecidableEq ιA']
  [ιBDecidableEq : DecidableEq ιB']
  φA : EuclideanSpace ℂ S.ιA →ₗᵢ[ℂ]
    EuclideanSpace ℂ (ιA' × _root_.MIPStarRE.QPBT.QubitRegister P)
  φB : EuclideanSpace ℂ S.ιB →ₗᵢ[ℂ]
    EuclideanSpace ℂ (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)
  aux : EuclideanSpace ℂ (ιA' × ιB')
  aux_norm : ‖aux‖ = 1

attribute [instance] _root_.MIPStarRE.QPBT.QubitSoundnessWitness.ιAFintype
  _root_.MIPStarRE.QPBT.QubitSoundnessWitness.ιBFintype _root_.MIPStarRE.QPBT.QubitSoundnessWitness.ιADecidableEq
  _root_.MIPStarRE.QPBT.QubitSoundnessWitness.ιBDecidableEq

/-- Alice's ideal qubit projector placed on the joint target space. -/
noncomputable def qubitProjOnA'' (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    {ιA' ιB' : Type*} [Fintype ιA'] [DecidableEq ιA']
    [Fintype ιB'] [DecidableEq ιB'] (W : _root_.MIPStarRE.QPBT.PauliKind)
    (u : _root_.MIPStarRE.QPBT.PauliRegister P) :
    _root_.LIDT.MIPStarRE.Quantum.Op ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  fun p q =>
    if p.1.1 = q.1.1 ∧ p.2 = q.2 then
      _root_.MIPStarRE.QPBT.qubitPauliProj W (_root_.MIPStarRE.QPBT.kappaVec P.model u) p.1.2 q.1.2
    else 0

/-- Bob's ideal qubit projector placed on the joint target space. -/
noncomputable def qubitProjOnB'' (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    {ιA' ιB' : Type*} [Fintype ιA'] [DecidableEq ιA']
    [Fintype ιB'] [DecidableEq ιB'] (W : _root_.MIPStarRE.QPBT.PauliKind)
    (u : _root_.MIPStarRE.QPBT.PauliRegister P) :
    _root_.LIDT.MIPStarRE.Quantum.Op ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  fun p q =>
    if p.1 = q.1 ∧ p.2.1 = q.2.1 then
      _root_.MIPStarRE.QPBT.qubitPauliProj W (_root_.MIPStarRE.QPBT.kappaVec P.model u) p.2.2 q.2.2
    else 0

/-- Lift a conjugated Alice effect to the full qubit target space. -/
noncomputable def liftedQubitAEffect {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {G : _root_.MIPStarRE.QPBT.Game}
    (S : _root_.MIPStarRE.QPBT.Strategy G) {ιA' ιB' : Type*} [Fintype ιA'] [DecidableEq ιA']
    [Fintype ιB'] [DecidableEq ιB']
    (φA : EuclideanSpace ℂ S.ιA →ₗᵢ[ℂ]
      EuclideanSpace ℂ (ιA' × _root_.MIPStarRE.QPBT.QubitRegister P))
    (M : _root_.LIDT.MIPStarRE.Quantum.Op S.ιA) :
    _root_.LIDT.MIPStarRE.Quantum.Op ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  _root_.MIPStarRE.QPBT.heteroKron (_root_.MIPStarRE.QPBT.conjIsometry φA M) 1

/-- Lift a conjugated Bob effect to the full qubit target space. -/
noncomputable def liftedQubitBEffect {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {G : _root_.MIPStarRE.QPBT.Game}
    (S : _root_.MIPStarRE.QPBT.Strategy G) {ιA' ιB' : Type*} [Fintype ιA'] [DecidableEq ιA']
    [Fintype ιB'] [DecidableEq ιB']
    (φB : EuclideanSpace ℂ S.ιB →ₗᵢ[ℂ]
      EuclideanSpace ℂ (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P))
    (M : _root_.LIDT.MIPStarRE.Quantum.Op S.ιB) :
    _root_.LIDT.MIPStarRE.Quantum.Op ((ιA' × _root_.MIPStarRE.QPBT.QubitRegister P) × (ιB' × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  _root_.MIPStarRE.QPBT.heteroKron 1 (_root_.MIPStarRE.QPBT.conjIsometry φB M)

/-- Alice's qubit-projector family distance in `cor:pauli-binary`. -/
noncomputable def qubitOperatorDistanceA
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  ∑ u : _root_.MIPStarRE.QPBT.PauliRegister P,
    ‖_root_.MIPStarRE.QPBT.applyOperatorToState
      (_root_.MIPStarRE.QPBT.liftedQubitAEffect S w.φA
          ((S.A (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)) -
        _root_.MIPStarRE.QPBT.qubitProjOnA'' P W u)
      (_root_.MIPStarRE.QPBT.idealQubitState P w.aux)‖ ^ 2

/-- Bob's qubit-projector family distance in `cor:pauli-binary`. -/
noncomputable def qubitOperatorDistanceB
    (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P))
    (w : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S) (W : _root_.MIPStarRE.QPBT.PauliKind) : ℝ :=
  ∑ u : _root_.MIPStarRE.QPBT.PauliRegister P,
    ‖_root_.MIPStarRE.QPBT.applyOperatorToState
      (_root_.MIPStarRE.QPBT.liftedQubitBEffect S w.φB
          ((S.B (_root_.MIPStarRE.QPBT.pauliQuestion P W)).effect (.pauliOutcome u)) -
        _root_.MIPStarRE.QPBT.qubitProjOnB'' P W u)
      (_root_.MIPStarRE.QPBT.idealQubitState P w.aux)‖ ^ 2

namespace BinaryWitnessTransport















/-- The local label equivalence leaves the auxiliary coordinate unchanged. -/
noncomputable def localEquiv (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (auxIndex : Type*) :
    (auxIndex × _root_.MIPStarRE.QPBT.PauliRegister P) ≃ (auxIndex × _root_.MIPStarRE.QPBT.QubitRegister P) :=
  Equiv.prodCongr (Equiv.refl auxIndex) (_root_.MIPStarRE.QPBT.quditQubitLabelEquiv P.model)

/-- The two local coordinate equivalences, in the existing player ordering. -/
noncomputable def jointEquiv (P : _root_.MIPStarRE.QPBT.AdmissibleParams) (auxA auxB : Type*) :
    ((auxA × _root_.MIPStarRE.QPBT.PauliRegister P) × (auxB × _root_.MIPStarRE.QPBT.PauliRegister P)) ≃
      ((auxA × _root_.MIPStarRE.QPBT.QubitRegister P) × (auxB × _root_.MIPStarRE.QPBT.QubitRegister P)) :=
  Equiv.prodCongr (_root_.MIPStarRE.QPBT.BinaryWitnessTransport.localEquiv P auxA) (_root_.MIPStarRE.QPBT.BinaryWitnessTransport.localEquiv P auxB)











end BinaryWitnessTransport

/-- Convert a supplied Pauli witness by post-composing each extraction map with
the fixed binary coordinate permutation. The auxiliary spaces, vector, and
normalization proof are unchanged. This is the exact given-witness construction
in the proof of `cor:pauli-binary`, not a proof of soundness existence. -/
noncomputable def PauliSoundnessWitness.toQubit
    {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {S : _root_.MIPStarRE.QPBT.Strategy (_root_.MIPStarRE.QPBT.pauliBasisTest P)}
    (w : _root_.MIPStarRE.QPBT.PauliSoundnessWitness P S) : _root_.MIPStarRE.QPBT.QubitSoundnessWitness P S where
  ιA' := w.ιA'
  ιB' := w.ιB'
  φA := (LinearIsometryEquiv.piLpCongrLeft 2 ℂ ℂ
    (_root_.MIPStarRE.QPBT.BinaryWitnessTransport.localEquiv P w.ιA')).toLinearIsometry.comp w.φA
  φB := (LinearIsometryEquiv.piLpCongrLeft 2 ℂ ℂ
    (_root_.MIPStarRE.QPBT.BinaryWitnessTransport.localEquiv P w.ιB')).toLinearIsometry.comp w.φB
  aux := w.aux
  aux_norm := w.aux_norm











end

end MIPStarRE.QPBT


