open scoped WithZero Classical

variable {K : Type} [Field K] [NumberField K]
variable {S : Finset (HeightOneSpectrum (𝓞 K))}

private theorem t0558 (v : HeightOneSpectrum (𝓞 K)) (t₁ t₂ : (v.adicCompletion K)ˣ) :
    d004 v (t₁ * t₂) = d004 v t₁ * d004 v t₂ :=
  map_mul (d008 v) t₁ t₂

private theorem t0559 {M : Type} [CommMonoid M] (f : (AdeleRing (𝓞 K) K)ˣ →* M)
    {z : (AdeleRing (𝓞 K) K)ˣ} (hz : ∀ v ∈ S, ((z : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1) :
    ∏ v : ↥S, f (d004 v.1 (unitAt v.1 z)) = 1 := by
  refine Finset.prod_eq_one fun v _ => ?_
  have h1 : unitAt v.1 z = 1 := Units.ext (hz v.1 v.2)
  rw [h1, ← t0075, map_one, map_one]

private theorem t0560 {M : Type} [CommMonoid M] (f : (AdeleRing (𝓞 K) K)ˣ →* M)
    (z : (AdeleRing (𝓞 K) K)ˣ) :
    f z = f (NumberField.Idele.partAt K ∅ z) * (∏ v : ↥S, f (d004 v.1 (unitAt v.1 z))) *
      f (z / NumberField.Idele.partAt K S z) := by
  let P : (AdeleRing (𝓞 K) K)ˣ → Prop := fun z =>
    f z = f (NumberField.Idele.partAt K ∅ z) * (∏ v : ↥S, f (d004 v.1 (unitAt v.1 z))) *
      f (z / NumberField.Idele.partAt K S z)
  refine t0057 S P ?_ ?_ ?_ ?_ z
  ·
    intro z₁ z₂ h₁ h₂
    show f (z₁ * z₂) = _
    rw [map_mul f, h₁, h₂]
    simp only [map_mul, unitAt_mul, t0558, Finset.prod_mul_distrib, mul_div_mul_comm]
    ac_rfl
  ·
    intro w t
    show f (archUnitHom w t) = _
    rw [t0379 (S := ∅), t0379, div_self', map_one, mul_one,
      t0559 f (fun v _ => t0038 w t v), mul_one]
  ·
    intro v t
    show f (d004 v t) = _
    rw [t0384 (S := ∅) (Finset.notMem_empty v), map_one, one_mul]
    by_cases hv : v ∈ S
    · rw [t0380 hv, div_self', map_one, mul_one, Finset.prod_eq_single ⟨v, hv⟩]
      · rw [show unitAt v (d004 v t) = t from Units.ext (t0034 v t)]
      · intro w _ hw
        have hwv : w.1 ≠ v := fun h => hw (Subtype.ext h)
        rw [show unitAt w.1 (d004 v t) = 1 from Units.ext (t0035 v t hwv), ← t0075,
          map_one, map_one]
      · intro h
        exact absurd (Finset.mem_univ _) h
    · rw [t0384 hv, div_one,
        t0559 f (fun w hw => t0035 v t fun h => hv (h ▸ hw)), one_mul]
  ·
    intro u hu
    show f u = _
    rw [t0383 (S := ∅) hu.arch (fun v hv => absurd hv (Finset.notMem_empty v)),
      map_one, one_mul, t0559 f hu.trivial_on, one_mul,
      t0383 hu.arch hu.trivial_on, div_one]

private theorem t0561 (b : (AdeleRing (𝓞 K) K)ˣ) :
    NumberField.Idele.partAt K ∅ (NumberField.Idele.partAt K S b) = NumberField.Idele.partAt K ∅ b := by
  refine Units.ext (Prod.ext ?_ (IsDedekindDomain.FiniteAdeleRing.ext K fun w => ?_))
  · rw [NumberField.Idele.partAt_fst, NumberField.Idele.partAt_fst, NumberField.Idele.partAt_fst]
  · rw [NumberField.Idele.partAt_snd_of_not_mem K ∅ _ (Finset.notMem_empty w),
      NumberField.Idele.partAt_snd_of_not_mem K ∅ _ (Finset.notMem_empty w)]

private theorem t0562 {M : Type} [CommMonoid M] (f : (AdeleRing (𝓞 K) K)ˣ →* M)
    (hf : ∀ v ∈ S, ∀ u : (v.adicCompletion K)ˣ, Valued.v (u : v.adicCompletion K) = 1 → f (d004 v u) = 1)
    {b : (AdeleRing (𝓞 K) K)ˣ} (hb : NumberField.Idele.partAt K S b ∈ unitIdelesAt S) :
    f (NumberField.Idele.partAt K S b) = f (NumberField.Idele.partAt K ∅ b) := by
  have hprod : ∏ v : ↥S, f (d004 v.1 (unitAt v.1 (NumberField.Idele.partAt K S b))) = 1 := by
    refine Finset.prod_eq_one fun v _ => ?_
    have hv := t0137.1 hb v
    exact hf v.1 v.2 (unitAt v.1 (NumberField.Idele.partAt K S b)) hv
  rw [t0560 (S := S) f (NumberField.Idele.partAt K S b), t0397, div_self',
    map_one, mul_one, t0561, hprod, mul_one]

private theorem t0563 {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hη : d048 S η) {b : (AdeleRing (𝓞 K) K)ˣ} (hb : NumberField.Idele.partAt K S b ∈ unitIdelesAt S) :
    η (NumberField.Idele.partAt K S b) = η (NumberField.Idele.partAt K ∅ b) :=
  t0562 η (fun v hv u hu => hη v hv u hu) hb

private theorem t0564 {b : (AdeleRing (𝓞 K) K)ˣ}
    (hb : NumberField.Idele.partAt K S b ∈ unitIdelesAt S) :
    ideleNorm K (NumberField.Idele.partAt K S b) = ideleNorm K (NumberField.Idele.partAt K ∅ b) :=
  t0562 (d019 K)
    (fun v _ u hu => by rw [t0260, t0261, hu, WithZero.log_one, zpow_zero]) hb

private theorem t0565 (z : (AdeleRing (𝓞 K) K)ˣ) :
    glArch (𝓞 K) K (diagOne z) = glArch (𝓞 K) K (diagOne (NumberField.Idele.partAt K ∅ z)) := by
  let P : (AdeleRing (𝓞 K) K)ˣ → Prop := fun z =>
    glArch (𝓞 K) K (diagOne z) = glArch (𝓞 K) K (diagOne (NumberField.Idele.partAt K ∅ z))
  refine t0057 ∅ P ?_ ?_ ?_ ?_ z
  · intro z₁ z₂ h₁ h₂
    show glArch (𝓞 K) K (diagOne (z₁ * z₂)) = _
    simp only [map_mul]
    rw [h₁, h₂]
  · intro w t
    show glArch (𝓞 K) K (diagOne (archUnitHom w t)) = _
    rw [t0379 (S := ∅)]
  · intro v t
    show glArch (𝓞 K) K (diagOne (d004 v t)) = _
    rw [t0392, t0019, t0384 (S := ∅) (Finset.notMem_empty v), map_one,
      map_one]
  · intro u hu
    show glArch (𝓞 K) K (diagOne u) = _
    rw [t0353 (funext hu.arch),
      t0383 (S := ∅) hu.arch (fun v hv => absurd hv (Finset.notMem_empty v)), map_one,
      map_one]

private theorem t0566 {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g)
    {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hη : d048 S η) (s : ℂ) (b : (AdeleRing (𝓞 K) K)ˣ) :
    zetaIntegrand (fun g => cutS S g * A g) η s (NumberField.Idele.partAt K S b) =
      if NumberField.Idele.partAt K S b ∈ unitIdelesAt S then
        A (diagOne (NumberField.Idele.partAt K ∅ b)) * ((η (NumberField.Idele.partAt K ∅ b) : ℂˣ) : ℂ) *
          ((ideleNorm K (NumberField.Idele.partAt K ∅ b) : ℝ) : ℂ) ^ (s - 1)
      else 0 := by
  unfold zetaIntegrand
  split_ifs with hb
  · have h6 := t0565 (NumberField.Idele.partAt K S b)
    rw [t0561] at h6
    show cutS S (diagOne (NumberField.Idele.partAt K S b)) * A (diagOne (NumberField.Idele.partAt K S b)) *
        ((η (NumberField.Idele.partAt K S b) : ℂˣ) : ℂ) *
        ((ideleNorm K (NumberField.Idele.partAt K S b) : ℝ) : ℂ) ^ (s - 1) = _
    rw [(t0417 _).2 hb, one_mul, hA _ _ h6, t0563 hη hb,
      t0564 hb]
  · have h01 := t0390 (S := S) (NumberField.Idele.partAt K S b)
    rcases h01 with h0 | h1
    · show cutS S (diagOne (NumberField.Idele.partAt K S b)) * A (diagOne (NumberField.Idele.partAt K S b)) *
          ((η (NumberField.Idele.partAt K S b) : ℂˣ) : ℂ) *
          ((ideleNorm K (NumberField.Idele.partAt K S b) : ℝ) : ℂ) ^ (s - 1) = 0
      rw [h0, zero_mul, zero_mul, zero_mul]
    · exact absurd ((t0417 _).1 h1) hb

