theorem AvramDividend.Classical.chat04_shifted_countable_path_independent_of_all_finite_prefixes
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕)
    (s : ℝ≥0) (τ : ℕ → ℝ≥0)
    (hFinite : ∀ n : ℕ,
      Indep (⨆ i : Fin n, MeasurableSpace.comap
        (fun ω => X.X (s + τ i.val) ω - X.X s ω) inferInstance)
        (𝓕 s) P) :
    Indep
      (MeasurableSpace.comap
        (fun ω : Ω => fun j : ℕ => X.X (s + τ j) ω - X.X s ω)
        inferInstance)
      (𝓕 s) P := by sorry
