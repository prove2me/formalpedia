theorem writeI_spec {A W : Fin HS} (hAW : A ≠ W) (s : IState HS) (v m : ℕ) (hv : v < 2 ^ m)
    (LA LW : List Item) (hA : s.G A = .int (v : ℤ) :: LA) (hW : s.G W = .int (2 ^ m) :: LW) :
    IRuns I iprog (writeI A W) s { (s.upd A LA).upd W LW with out := s.out ++ bin m v }
      (outRCost m) :=
  IRuns.op (IOp.Step.write hAW hv hA hW)

