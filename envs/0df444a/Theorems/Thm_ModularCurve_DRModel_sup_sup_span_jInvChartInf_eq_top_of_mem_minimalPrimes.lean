theorem ModularCurve.DRModel.sup_sup_span_jInvChartInf_eq_top_of_mem_minimalPrimes
    (q : ℕ) [Fact q.Prime]
    (𝔮 𝔮' : Ideal ↥(TwoChartIntegralModel.chartAlgInf ℤ ↥(modularFunctionFieldFull q) (IgusaScheme.jFull q)))
    (h𝔮 : 𝔮 ∈ (Ideal.span {((q : ℕ) : ↥(TwoChartIntegralModel.chartAlgInf ℤ ↥(modularFunctionFieldFull q) (IgusaScheme.jFull q)))}).minimalPrimes)
    (h𝔮' : 𝔮' ∈ (Ideal.span {((q : ℕ) : ↥(TwoChartIntegralModel.chartAlgInf ℤ ↥(modularFunctionFieldFull q) (IgusaScheme.jFull q)))}).minimalPrimes) (hne : 𝔮 ≠ 𝔮') :
    𝔮 ⊔ 𝔮' ⊔ Ideal.span {TwoChartIntegralModel.jInvChartInf ℤ ↥(modularFunctionFieldFull q) (IgusaScheme.jFull q)} = ⊤ := by sorry
