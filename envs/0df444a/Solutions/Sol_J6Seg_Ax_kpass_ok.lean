-- Source module: Solutions.J6SegAxis2
/-!
# B-line axis program (`AxisU6`), part 2: a kernel pass as a `PassOK` step

`kpSt eUp eDn ρ dT dF eF eB e = call eUp; kerW ρ dT dF eF eB e; call eDn`: the set-up of the
register file `kerRegs …` from the descriptor (`SetupBody6`, B5), the kernel-pass wrapper
(`kerW_run`, B2) with a row kernel (`RowBody6`), the tear-down.

**`kpass_ok`**: under the hypotheses of `kerW_run` (the row facts given by `lineAt`, the rows of
the array), the step is `PassOK` for `kerPass (2^f) post (pre·nc) (fun b => g (b % nc))`, at
cost `2 Cp + (the kerW_run bound)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem extend_upd0 {ρ : Fin 19 → Fin HS} (h0 : ∀ i, ρ i ≠ 0) (V : Fin 19 → List ℤ)
    (F : Fin HS → List ℤ) (v : List ℤ) :
    extend ρ V (update F 0 v) = update (extend ρ V F) 0 v := by
  funext j
  by_cases hj : j = 0
  · subst hj
    have hn : ¬ ∃ a, ρ a = 0 := fun ⟨a, ha⟩ => h0 a ha
    rw [extend_apply' _ _ _ hn]; simp
  · rw [update_of_ne hj]
    by_cases hx : ∃ a, ρ a = j
    · simp only [extend_def]; rw [dif_pos hx, dif_pos hx]
    · rw [extend_apply' _ _ _ hx, extend_apply' _ _ _ hx, update_of_ne hj]

theorem extend_out {ρ : Fin 19 → Fin HS} {j : Fin HS} (hj : ∀ i, ρ i ≠ j) (V : Fin 19 → List ℤ)
    (F : Fin HS → List ℤ) : extend ρ V F j = F j :=
  extend_apply' _ _ _ (fun ⟨a, ha⟩ => hj a ha)

theorem kerRegs_get (w w' f pre nc post : ℕ) (T : List ℤ) :
    kerRegs w w' f pre nc post T 0 = [(w : ℤ)] ∧ kerRegs w w' f pre nc post T 1 = [(w' : ℤ)] ∧
    kerRegs w w' f pre nc post T 2 = [(f : ℤ)] ∧
    kerRegs w w' f pre nc post T 3 = [((pre * nc : ℕ) : ℤ)] ∧
    kerRegs w w' f pre nc post T 4 = [(post : ℤ)] ∧ kerRegs w w' f pre nc post T 5 = [(pre : ℤ)] ∧
    kerRegs w w' f pre nc post T 6 = [(nc : ℤ)] ∧
    kerRegs w w' f pre nc post T 7 = [((2 * 2 ^ f : ℕ) : ℤ)] ∧
    kerRegs w w' f pre nc post T 8 = [((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ)] ∧
    kerRegs w w' f pre nc post T 9 = [(T.length : ℤ)] ∧ kerRegs w w' f pre nc post T 10 = T ∧
    ∀ i : Fin 19, 11 ≤ i.val → kerRegs w w' f pre nc post T i = [] := by
  refine ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, fun i hi => ?_⟩
  simp only [kerRegs]
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
    if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
    if_neg (by omega), if_neg (by omega), if_neg (by omega)]

/-- **A kernel pass is a `PassOK` step.** -/
theorem kpass_ok_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eF eB e eUp eDn : Fin Pp}
    {ρ : Fin 19 → Fin HS} {dT dF dA : Fin HS} {C₀ Cp : ℝ} {tabOf : ℕ → List ℤ}
    {Pre : List GI → Prop} {g : ℕ → List GI → List GI} {Ck : ℝ} {desc : List ℤ}
    (hR : RegOK ρ dT dF) (hFine : FineBody6 Isym tbl eF eB dF C₀)
    (hRow : RowBody6 Isym tbl e dT tabOf Pre g Ck)
    (w w' f pre nc post B Lmax : ℕ)
    (hSet : SetupBody6 Isym tbl eUp eDn ρ dA desc
      (kerRegs w w' f pre nc post (tabsT tabOf nc)) Cp)
    (hρA : ∀ i, ρ i ≠ dA) (hA0 : dA ≠ 0) (hTA : dT ≠ dA)
    (hB : 1 ≤ B) (hpost : 1 ≤ post)
    (hzw : zsz (w : ℤ) ≤ B) (hzw' : zsz (w' : ℤ) ≤ B) (hzf : zsz (f : ℤ) ≤ B)
    (hzA : zsz ((pre * nc : ℕ) : ℤ) ≤ B) (hzp : zsz (post : ℤ) ≤ B)
    (hzpre : zsz (pre : ℤ) ≤ B) (hznc : zsz (nc : ℤ) ≤ B)
    (hzm : zsz ((2 * 2 ^ f : ℕ) : ℤ) ≤ B) (hzN : zsz ((2 * (pre * nc * post * 2 ^ f) : ℕ) : ℤ) ≤ B)
    (hzT : zsz ((tabsT tabOf nc).length : ℤ) ≤ B) (hzL : zsz (Lmax : ℤ) ≤ B) (hw'B : w' ≤ B)
    (hg : ∀ q < nc, ∀ x, Pre x → x.length = 2 ^ f → (g q x).length = 2 ^ f ∧ GB w' (g q x))
    (hTB : ∀ q < nc, Bnd B (tabOf q)) (hTL : ∀ q < nc, (tabOf q).length ≤ Lmax) :
    PassOK Isym tbl (kpSt eUp eDn ρ dT dF eF eB e) dA desc
      (fun L => L.length = pre * nc * (2 ^ f * post) ∧ GB w L ∧
        ∀ b < pre * nc, ∀ c < post, Pre (lineAt (2 ^ f) post L b c))
      (kerPass (2 ^ f) post (pre * nc) (fun b => g (b % nc)))
      (2 * Cp + (C₀ * cFine w f (pre * nc) post + C₀ * cFine w' f (pre * nc) post +
        (kerC ⌊Ck⌋₊ B (2 ^ f) post Lmax nc (tabsT tabOf nc).length pre
          (2 * (pre * nc * post * 2 ^ f)) : ℝ))) := by
  intro s F L l hF hd h0 ⟨hlen, hGB, hrows⟩
  set V := kerRegs w w' f pre nc post (tabsT tabOf nc) with hV
  obtain ⟨g0, g1, g2, g3, g4, g5, g6, g7, g8, g9, g10, gS⟩ :=
    kerRegs_get w w' f pre nc post (tabsT tabOf nc)
  have hρ0 : ∀ i, ρ i ≠ 0 := hR.ne0
  -- the state without stack `0`
  set F0 := update F 0 [] with hF0d
  have hE0 : ∀ j, j ≠ dA → (∀ i, ρ i ≠ j) → F0 j = [] := by
    intro j hj hr
    by_cases h : j = 0
    · subst h; simp [hF0d]
    · rw [hF0d, update_of_ne h]; exact hF j h hj
  have hR0 : ∀ i, F0 (ρ i) = [] := fun i => by
    rw [hF0d, update_of_ne (hρ0 i)]; exact hF _ (hρ0 i) (hρA i)
  have hd0 : F0 dA = desc := by rw [hF0d, update_of_ne hA0]; exact hd
  set s0 := encK s (update (fun _ => []) 0 (F 0)) with hs0
  obtain ⟨⟨cu, ru, ku⟩, -⟩ := hSet s0 F0 hE0 hR0 hd0
  set F' := extend ρ V F with hF'
  have hinj := hR.inj
  have eρ : ∀ i, F' (ρ i) = V i := fun i => hinj.extend_apply V F i
  have hF'0 : F' 0 = gflat L ++ l := by
    rw [hF', extend_out (fun i => hρ0 i), h0]
  have eu1 : encK s F = encK s0 F0 := encK_rebase' s F 0
  have eu2 : encK s F' = encK s0 (extend ρ V F0) := by
    rw [encK_rebase' s F' 0, hF0d, extend_upd0 hρ0, hF'0, hs0, h0]
  rw [← eu1, ← eu2] at ru
  -- the wrapper
  have hF'T : F' dT = [] := by
    rw [hF', extend_out (fun i => hR.neT i)]; exact hF dT hR.T0 hTA
  have hLR := LRep_lineAt (pre := pre * nc) (n := 2 ^ f) (post := post) (L := L)
    (by rw [hlen])
  obtain ⟨ck, rk, kk⟩ := kerW_run hR hFine hRow w w' f pre nc post B Lmax hB hpost s F' L l []
    (fun b c => lineAt (2 ^ f) post L b c) hF'0 hF'T
    ((eρ _).trans g0) ((eρ _).trans g1) ((eρ _).trans g2) ((eρ _).trans g3) ((eρ _).trans g4)
    ((eρ _).trans g5) ((eρ _).trans g6) ((eρ _).trans g7) ((eρ _).trans g8) ((eρ _).trans g9)
    (((eρ _).trans g10).trans (List.append_nil _).symm)
    (fun i h1 h2 => (eρ _).trans (gS i h1))
    hzw hzw' hzf hzA hzp hzpre hznc hzm hzN hzT hzL hw'B hLR hrows hg hGB hTB hTL
  -- the tear-down
  set X := gflat (kerPass (2 ^ f) post (pre * nc) (fun b => g (b % nc)) L) ++ l with hX
  set s1 := encK s (update (fun _ => []) 0 X) with hs1
  obtain ⟨-, ⟨cd, rd, kd⟩⟩ := hSet s1 F0 hE0 hR0 hd0
  have ed1 : encK s (update F' 0 X) = encK s1 (extend ρ V F0) := by
    rw [encK_rebase' s (update F' 0 X) 0, update_self, update_idem, hF0d, extend_upd0 hρ0]
  have ed2 : encK s (update F 0 X) = encK s1 F0 := by
    rw [encK_rebase' s (update F 0 X) 0, update_self, update_idem]
  rw [← ed1, ← ed2] at rd
  refine ⟨cu + (ck + cd), ?_, ?_⟩
  · exact ru.seq (rk.seq rd)
  · have hu : (cu : ℝ) ≤ Cp := ku
    have hd' : (cd : ℝ) ≤ Cp := kd
    push_cast
    linarith

end J6Seg.Ax

end

