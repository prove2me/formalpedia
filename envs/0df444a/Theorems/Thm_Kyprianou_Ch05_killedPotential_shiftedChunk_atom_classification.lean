-- title:
--   Atoms of a finite-activity subordinator marginal lie in the drift plus the semigroup of Lévy atoms
-- statement:
--   Let $Y$ be a killed subordinator with Laplace triplet $(\eta, d, \Pi, \Phi)$ and finite Lévy measure $\Pi((0,\infty)) < \infty$. Then for every $t \ge 0$ and every $x \in \mathbb{R}$, if $P(Y_t = x) \ne 0$ then $x = dt + y_1 + \dots + y_k$ for some finite list of atoms $y_i$ of $\Pi$ (each $\Pi(\{y_i\}) \ne 0$); the empty sum $0$ is allowed. In other words, the atoms of the marginal law of a finite-activity subordinator lie in the drift shift of the additive semigroup generated by the atoms of its Lévy measure.
-- source:
--   Kyprianou, Fluctuations of Lévy Processes with Applications (2006), Ch. 5, Theorem 5.4 — supporting atom-classification step for the lattice bad-times countability lemma.

import Mathlib
import Mathlib.MeasureTheory.Group.Convolution
import Definitions.Def_Kyprianou_Ch03_IsSubordinator
import Definitions.Def_Kyprianou_Ch03_EntryAndHittingTimes
import Definitions.Def_Kyprianou_Ch05_RenewalMeasure
import Definitions.Def_Kyprianou_Ch05_KilledSubordinatorPotential
open MeasureTheory Filter ProbabilityTheory
open scoped NNReal ENNReal
set_option autoImplicit false

namespace Kyprianou.Ch05

/-- Atom classification for a finite-activity killed subordinator marginal:
every atom of the law of $Y_t$ lies in the drift shift $dt$ plus the additive
semigroup generated by the atoms of the Lévy measure $\Pi$ (finite sums of
atoms of $\Pi$, the empty sum $0$ included). -/
theorem killedPotential_shiftedChunk_atom_classification
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (Y : NNReal → Omega → Real)
    (death : Omega → WithTop NNReal)
    (eta d : Real) (Pi : Measure Real) (Phi : Real → Real)
    (hKilled : IsKilledSubordinator P Y death eta)
    (hTriplet : IsKilledLaplaceTriplet eta d Pi Phi)
    (hLaplaceLaw : ∀ (t : NNReal) (theta : Real), 0 ≤ theta →
      (∫ omega, Real.exp (-theta * Y t omega) ∂P) =
        Real.exp (-(t : Real) * (Phi theta - eta)))
    (U : Real → Measure Real)
    (hPotential : IsKilledPotentialFamily P Y death U) :
  (Pi (Set.Ioi (0 : Real)) < ⊤ →
    ∀ t : NNReal, ∀ x : Real,
      P {omega : Omega | Y t omega = x} ≠ 0 →
        ∃ l : List Real, (∀ y ∈ l, Pi {y} ≠ 0) ∧
          x = d * (t : Real) + l.sum)
 := by
  sorry

end Kyprianou.Ch05
