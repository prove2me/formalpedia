theorem isAlgClosed_residueField_of_forall_monic {O : Type} [CommRing O] [IsLocalRing O]
    (I : Ideal O) (hI : I.IsMaximal)
    (hclosed : ∀ p : Polynomial O, p.Monic → 0 < p.natDegree → ∃ x : O, Polynomial.eval x p ∈ I) :
    IsAlgClosed (ResidueField O) := by
  have hIm : I = maximalIdeal O := IsLocalRing.eq_maximalIdeal hI
  apply IsAlgClosed.of_exists_root
  intro P hPmonic hPirr
  have hlifts : P ∈ Polynomial.lifts (residue O) := by
    rw [Polynomial.mem_lifts]
    exact Polynomial.map_surjective _ residue_surjective P
  obtain ⟨Q, hQmap, hQdeg, hQmonic⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hPmonic
  have hQpos : 0 < Q.natDegree := by
    rw [hQdeg]
    exact hPirr.natDegree_pos
  obtain ⟨x, hx⟩ := hclosed Q hQmonic hQpos
  refine ⟨residue O x, ?_⟩
  rw [← hQmap, Polynomial.eval_map, Polynomial.eval₂_hom, residue_eq_zero_iff, ← hIm]
  exact hx

theorem padicInt_ringHom_ext_of_isNilpotent {q : ℕ} [Fact q.Prime] {A : Type*} [CommRing A]
    (hq : IsNilpotent ((q : ℕ) : A)) (f g : ℤ_[q] →+* A) : f = g := by
  obtain ⟨n, hn⟩ := hq
  have key : ∀ (h : ℤ_[q] →+* A) (z : ℤ_[q]), h z = (PadicInt.appr z n : A) := by
    intro h z
    have hz := PadicInt.appr_spec n z
    rw [Ideal.mem_span_singleton'] at hz
    obtain ⟨w, hw⟩ := hz
    have e := congrArg h hw
    rw [map_mul, map_pow, map_natCast, hn, mul_zero, map_sub, map_natCast] at e
    exact (sub_eq_zero.mp e.symm)
  ext z
  rw [key f z, key g z]

theorem specHom_padicInt_eq {q : ℕ} [Fact q.Prime] {A : Type} [CommRing A]
    (hq : IsNilpotent ((q : ℕ) : A))
    (s₁ s₂ : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of ℤ_[q])) : s₁ = s₂ := by
  obtain ⟨φ₁, rfl⟩ := Spec.map_surjective s₁
  obtain ⟨φ₂, rfl⟩ := Spec.map_surjective s₂
  have : φ₁.hom = φ₂.hom := padicInt_ringHom_ext_of_isNilpotent hq _ _
  rw [CommRingCat.hom_ext this]

