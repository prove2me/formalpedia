theorem orbit_shape_lifts (m : ℕ) (hm : 0 < m)
    (S T : Finset (ZMod (2*m))) (ho : OrbitShape m S T) :
    TwoLift m S T ∨ FourLift m S T := by
  obtain ⟨a,b,c,d,hU,hV,hcd,hC,hca,hcb,hda,hdb,hshape⟩ := ho
  rcases hshape with ⟨h2,he⟩|⟨h4,he|he⟩
  · exact Or.inl (two_orbit_lift m hm S T a b c d hU hV hC h2 he)
  · exact Or.inr (four_orbit_lift m hm S T a b c d hU hV hC h4 he.1 he.2)
  · apply Or.inr
    exact four_orbit_lift m hm S T a b d c hU hV (by rw [pair_comm]; exact hC) h4 he.2 he.1



theorem collision_lifted_shapes (m : ℕ) (hm : 0 < m)
    (S T : Finset (ZMod (2*m))) (hS : S.card=4) (hT : T.card=4)
    (hsq : ∀ z, orderedSquare S z=orderedSquare T z)
    (hnaff : ¬ Couret.InterIA.NormalForm.AffineEquivalent S T) :
    ∃ t : ZMod (2*m), (t=0 ∨ t=m) ∧
      (TwoLift m S (T.image (fun x => x+t)) ∨ FourLift m S (T.image (fun x => x+t))) := by
  obtain ⟨t,ht,ho⟩ := collision_orbit_shapes m hm S T hS hT hsq hnaff
  exact ⟨t,ht,orbit_shape_lifts m hm S (T.image (fun x => x+t)) ho⟩

theorem p2m_local_collision_translated_shapes (m : ℕ) (hm : 0 < m)
    (S T : Finset (ZMod (2*m))) (hS : S.card=4) (hT : T.card=4)
    (hsq : ∀ z, orderedSquare S z=orderedSquare T z)
    (hnaff : ¬ Couret.InterIA.NormalForm.AffineEquivalent S T) :
    ∃ t : ZMod (2*m), (t=0 ∨ t=m) ∧
      (TwoTranslated m S (T.image (fun x => x+t)) ∨ FourTranslated m S (T.image (fun x => x+t))) := by
  obtain ⟨t,ht,ho⟩ := collision_lifted_shapes m hm S T hS hT hsq hnaff
  refine ⟨t,ht,?_⟩
  rcases ho with h|h
  · exact Or.inl (two_lift_translation m S (T.image (fun x => x+t)) h)
  · exact Or.inr (four_lift_translation m S (T.image (fun x => x+t)) h)

