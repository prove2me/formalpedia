-- title:
--   Nestedness and crossing of separations and of $r$-local separations, the relation $\succcurlyeq$, canonical sets
-- statement:
--   1. For oriented separations, $(A,B)\geqslant(C,D)$ if $A\subseteq C$ and $B\supseteq D$. Two separations are **nested** if they have comparable orientations, and **cross** otherwise; a set is nested if its elements are pairwise nested. A set $S$ of separations is **$\Gamma$-canonical**, for a subgroup $\Gamma\le\operatorname{Aut}(G)$, if it is invariant under $\{A,B\}\mapsto\{\varphi(A),\varphi(B)\}$, $\varphi\in\Gamma$.
--   2. A cycle **alternates** between $X$ and $Y$ if it contains distinct $x,x'\in X$ and $y,y'\in Y$ in the cyclic order $x,y,x',y'$. $X$ and $Y$ are **$r$-coupled** if they meet or some cycle of length $\le r$ alternates between them.
--   3. For an $r$-local separation $\{F_1,Y,F_2\}$, the **$X$-link for $F_i$** is the set of $x\in X\setminus Y$ such that some walk in $W_r(X)$ starts at $x$, visits $Y$, and has its first edge in $\partial Y$ in $F_i$.
--   4. Two $r$-local separations $\{E_1,X,E_2\}$ and $\{F_1,Y,F_2\}$ **cross** if $X$ and $Y$ are $r$-coupled and for all $i,j\in[2]$ one of the $X$-link for $F_j$, the $Y$-link for $E_i$, and $E_i\cap F_j\cap\partial(X\cap Y)$ is non-empty; otherwise they are **nested**.
--   5. $(E_1,X,E_2)\succcurlyeq(F_1,Y,F_2)$ if $X,Y$ are $r$-coupled and the $X$-link for $F_2$, the $Y$-link for $E_1$ and $E_1\cap F_2\cap\partial(X\cap Y)$ are all empty; $s\succ t$ means $s\succcurlyeq t$ and $s\neq t$.
--   6. A set of $r$-local separations is $\Gamma$-canonical if it is invariant under $\{E_1,X,E_2\}\mapsto\{\varphi(E_1),\varphi(X),\varphi(E_2)\}$.
--
--   These local notions are modelled on the link characterisation of crossing (Lemma 2.2) and agree with the global ones in graphs whose cycle space is generated by short cycles.
--
--   **Formalization Note** The paper defines crossing and $\succcurlyeq$ for $r$-local separations with $r$-tomic separators; the conditions are defined here for all pairs, and the statements only use them in the paper's setting.
-- source:
--   Jacobs, Knappe, Kurkofka, Canonical Graph Decompositions via Local Separations, preprint (STOC 2027 submission, arXiv:2501.16170; sha256 9a11d48d…), §2.2 (p.14), §6.1 (pp.37–38), §7.3 (p.46), §8.2 (p.51)

import Mathlib
import Definitions.Def_LocalSepDecomp_Covering

set_option autoImplicit false

namespace LocalSepDecomp

/-! # Nestedness and crossing, global and r-local; the relation `≽`; canonical sets

R. W. Jacobs, P. Knappe, J. Kurkofka, *Canonical Graph Decompositions via Local Separations*,
preprint (STOC 2027 submission, arXiv:2501.16170; sha256 9a11d48d…), §2.2 (p.14), §6.1
(pp.37–38), §7.3 (p.46), §8.2 (p.51).

**Formalization Note.** The paper defines crossing and `≽` for `r`-local separations with
`r`-tomic separators. The displayed conditions are defined here for all pairs; every statement
of the mission applies them to `r`-local separations with `r`-tomic separators only. The strict
relation `s ≻ t` is the strict part of `≽`: `s ≽ t` and `s ≠ t` (the paper uses `≻` without a
separate definition, as `>` for `⩾` in §8.1). -/

open SimpleGraph

variable {V : Type*}

/-! ## Global separations -/

/-- The partial order on oriented separations (p.14, 6th-edition convention):
`(A, B) ⩾ (C, D) :⇔ A ⊆ C and B ⊇ D`. -/
def sepGe (p q : Set V × Set V) : Prop := p.1 ⊆ q.1 ∧ q.2 ⊆ p.2

/-- Two unoriented separations are **nested** (p.14): they have `⩾`-comparable orientations. -/
def USepNested (u v : Sym2 (Set V)) : Prop :=
  ∃ p q : Set V × Set V, unorientSep p = u ∧ unorientSep q = v ∧ (sepGe p q ∨ sepGe q p)

/-- Two unoriented separations **cross** (p.14): they are not nested. -/
def USepCrosses (u v : Sym2 (Set V)) : Prop := ¬ USepNested u v

/-- A set of separations is **nested** (p.14): its elements are pairwise nested. -/
def USepSetNested (S : Set (Sym2 (Set V))) : Prop :=
  ∀ u ∈ S, ∀ v ∈ S, USepNested u v

/-- The action `{A, B} ↦ {φ(A), φ(B)}` of an automorphism on unoriented separations (p.14). -/
def usepMap {V' : Type*} (f : V → V') (u : Sym2 (Set V)) : Sym2 (Set V') :=
  Sym2.map (fun A => f '' A) u

/-- A set `S` of separations of `G` is **`Γ`-canonical** for a subgroup `Γ ≤ Aut(G)` (p.14):
`S` is invariant under the action of `Γ`. -/
def IsCanonicalUSepSet (G : SimpleGraph V) (Γ : Subgroup (G ≃g G)) (S : Set (Sym2 (Set V))) :
    Prop :=
  ∀ φ ∈ Γ, ∀ u ∈ S, usepMap φ u ∈ S

/-! ## r-local crossing (§6.1) -/

/-- The cycle `c` (a closed walk once around it) **alternates** between `X` and `Y` (p.37):
there are four distinct vertices `x, x' ∈ X`, `y, y' ∈ Y` on it, visited in the cyclic order
`x, y, x', y'`. -/
def Alternates (G : SimpleGraph V) {u : V} (c : G.Walk u u) (X Y : Set V) : Prop :=
  ∃ x ∈ X, ∃ x' ∈ X, ∃ y ∈ Y, ∃ y' ∈ Y, [x, y, x', y'].Nodup ∧
    ∃ n : ℕ, [x, y, x', y'].Sublist (c.support.tail.rotate n)

/-- `X` and `Y` are **`r`-coupled** (p.37): they share a vertex, or some short cycle alternates
between them. -/
def IsRCoupled (G : SimpleGraph V) (r : ℕ) (X Y : Set V) : Prop :=
  (X ∩ Y).Nonempty ∨ ∃ (u : V) (c : G.Walk u u), IsShortCycle G r c ∧ Alternates G c X Y

/-- The first edge of the walk `Wk` that lies in `∂Y` exists and lies in `F`. -/
def FirstBoundaryEdgeIn (G : SimpleGraph V) (Y : Set V) (F : Set (Sym2 V)) {x y : V}
    (Wk : G.Walk x y) : Prop :=
  ∃ (l₁ : List (Sym2 V)) (e : Sym2 V) (l₂ : List (Sym2 V)), Wk.edges = l₁ ++ e :: l₂ ∧
    (∀ f ∈ l₁, f ∉ boundary G Y) ∧ e ∈ boundary G Y ∧ e ∈ F

/-- The **`X`-link for `F`** in an `r`-local separation with separator `Y` and side `F` (p.38):
the vertices `x ∈ X ∖ Y` such that some walk in `W_r(X)` starts at `x`, visits `Y`, and has its
first edge in `∂Y` in `F`. -/
def xLink (G : SimpleGraph V) (r : ℕ) (X Y : Set V) (F : Set (Sym2 V)) : Set V :=
  {x | x ∈ X ∧ x ∉ Y ∧ ∃ (y : V) (Wk : G.Walk x y), InWr G r X Wk ∧
    (∃ v ∈ Wk.support, v ∈ Y) ∧ FirstBoundaryEdgeIn G Y F Wk}

/-- The two sides `E₁, E₂` of `(E₁, X, E₂)`, indexed by `Fin 2`. -/
def LSep.side (s : LSep V) : Fin 2 → Set (Sym2 V) := ![s.E₁, s.E₂]

/-- `{E₁, X, E₂}` and `{F₁, Y, F₂}` **cross** (p.38): `X` and `Y` are `r`-coupled, and for every
`i, j ∈ [2]` at least one of the `X`-link for `F_j`, the `Y`-link for `E_i`, and
`E_i ∩ F_j ∩ ∂(X ∩ Y)` is non-empty. -/
def LCrosses (G : SimpleGraph V) (r : ℕ) (s t : LSep V) : Prop :=
  IsRCoupled G r s.X t.X ∧ ∀ i j : Fin 2,
    (xLink G r s.X t.X (t.side j)).Nonempty ∨ (xLink G r t.X s.X (s.side i)).Nonempty ∨
      (s.side i ∩ t.side j ∩ boundary G (s.X ∩ t.X)).Nonempty

/-- Two unoriented `r`-local separations cross (the condition does not depend on the chosen
orientations). -/
def ULCrosses (G : SimpleGraph V) (r : ℕ) (u v : ULSep V) : Prop :=
  ∃ s t : LSep V, s.unorient = u ∧ t.unorient = v ∧ LCrosses G r s t

/-- Two unoriented `r`-local separations are **nested** (p.38): they do not cross. -/
def ULNested (G : SimpleGraph V) (r : ℕ) (u v : ULSep V) : Prop := ¬ ULCrosses G r u v

/-- A set of `r`-local separations is **nested**: its elements are pairwise nested. -/
def ULSetNested (G : SimpleGraph V) (r : ℕ) (N : Set (ULSep V)) : Prop :=
  ∀ u ∈ N, ∀ v ∈ N, ULNested G r u v

/-- `s ≽ t` for `s = (E₁, X, E₂)`, `t = (F₁, Y, F₂)` (p.51): `X` and `Y` are `r`-coupled, and the
`X`-link for `F₂`, the `Y`-link for `E₁` and `E₁ ∩ F₂ ∩ ∂(X ∩ Y)` are all empty. -/
def LSucceq (G : SimpleGraph V) (r : ℕ) (s t : LSep V) : Prop :=
  IsRCoupled G r s.X t.X ∧ xLink G r s.X t.X t.E₂ = ∅ ∧ xLink G r t.X s.X s.E₁ = ∅ ∧
    s.E₁ ∩ t.E₂ ∩ boundary G (s.X ∩ t.X) = ∅

/-- `s ≻ t`: `s ≽ t` and `s ≠ t`. -/
def LSucc (G : SimpleGraph V) (r : ℕ) (s t : LSep V) : Prop := LSucceq G r s t ∧ s ≠ t

/-- A set `S` of `r`-local separations of `G` is **`Γ`-canonical** (p.46): invariant under
`{E₁, X, E₂} ↦ {φ(E₁), φ(X), φ(E₂)}` for `φ ∈ Γ`. -/
def IsCanonicalULSepSet (G : SimpleGraph V) (Γ : Subgroup (G ≃g G)) (S : Set (ULSep V)) :
    Prop :=
  ∀ φ ∈ Γ, ∀ u ∈ S, ULSep.map φ u ∈ S

end LocalSepDecomp


