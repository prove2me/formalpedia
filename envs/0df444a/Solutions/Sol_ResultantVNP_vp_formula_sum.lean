namespace CircuitCompactFormula

open ResultantVNP PermanentFoundation CircuitReferenceBound CircuitCompactCorrect
  CircuitFormulaUnfold CircuitFormulaRecurrence CircuitNormalizedFormula CircuitFixedCodes

variable {σ : Type}

/-- Compaction preserves the full unfolded formula at every relevant node,
    not merely its polynomial value. -/
theorem compactFormulaValues_preserved (C : Circuit σ) (k : Fin (relevantPositions C).card) :
    (formulaValues (compactCircuit C)).getD k.val (.const 0) =
      (formulaValues C).getD (relevantAt C k) (.const 0) := by
  have hmain : ∀ i, ∀ hi : i < (relevantPositions C).card,
      (formulaValues (compactCircuit C)).getD i (.const 0) =
        (formulaValues C).getD (relevantAt C ⟨i,hi⟩) (.const 0) := by
    intro i
    induction i using Nat.strong_induction_on with
    | h i ih =>
      intro hi
      let k : Fin (relevantPositions C).card := ⟨i,hi⟩
      have hc : i < (compactCircuit C).nodes.length := by simp [compactCircuit,hi]
      have ho : relevantAt C k < C.nodes.length :=
        relevantPositions_lt_length C _ (relevantAt_mem C k)
      rw [formulaValues_step_full (compactCircuit C) i hc,
        formulaValues_step_full C (relevantAt C k) ho]
      have hn : (compactCircuit C).nodes[i]'hc = compactNode C k := by
        simp [compactCircuit,k]
      rw [hn]
      have hchild (j : ℕ) (hj : j ∈ nodeReferences (C.nodes[relevantAt C k]'ho)) :
          (formulaValues (compactCircuit C)).getD (compactIndex C j) (.const 0) =
            (formulaValues C).getD j (.const 0) := by
        obtain ⟨hmem,hlt⟩ := compact_gate_inputs C k j hj
        have hh := ih (relevantRank C j hmem).val hlt (relevantRank C j hmem).isLt
        simpa [compactIndex,hmem,relevantAt_rank] using hh
      unfold compactNode
      cases h : C.nodes[relevantAt C k]'ho with
      | var x => rfl
      | const a => rfl
      | add x y =>
        have hx := hchild x (by simp [h,nodeReferences])
        have hy := hchild y (by simp [h,nodeReferences])
        simpa [nodeFormula] using congrArg₂ Formula.add hx hy
      | mul x y =>
        have hx := hchild x (by simp [h,nodeReferences])
        have hy := hchild y (by simp [h,nodeReferences])
        simpa [nodeFormula] using congrArg₂ Formula.mul hx hy
  exact hmain k.val k.isLt

private theorem getD_last {α : Type} (l : List α) (d : α) :
    l.getD (l.length - 1) d = l.getLastD d := by
  simp only [List.getD_eq_getElem?_getD, List.getLastD_eq_getLast?,
    List.getLast?_eq_getElem?]

theorem compactCircuit_formula (C : Circuit σ) :
    circuitFormula (compactCircuit C) = circuitFormula C := by
  have hm : 0 < (relevantPositions C).card := by
    apply Finset.card_pos.mpr
    exact ⟨C.nodes.length - 1, output_mem_relevant C⟩
  let k : Fin (relevantPositions C).card := ⟨(relevantPositions C).card - 1, by omega⟩
  have h := compactFormulaValues_preserved C k
  have hp : relevantAt C k = C.nodes.length - 1 := compact_last_position C hm
  rw [hp] at h
  have hc : (formulaValues (compactCircuit C)).length = (relevantPositions C).card := by
    rw [formulaValues_length]
    simp [compactCircuit]
  have ho := formulaValues_length C
  unfold circuitFormula
  rw [← getD_last, ← getD_last, hc, ho]
  exact h

/-- The full normalized decoder input and all its decoded weights are
    unchanged by compaction, for any fixed witness-code length. -/
theorem compactCircuit_normalized (C : Circuit σ) (d : ℕ) :
    boundedCircuitFormula (compactCircuit C) d = boundedCircuitFormula C d := by
  simp only [boundedCircuitFormula, compactCircuit_formula]

theorem compactCircuit_decoder (C : Circuit σ) (d n : ℕ) (z : Fin n → Bool) :
    decodedWeight (boundedCircuitFormula (compactCircuit C) d) n z =
      decodedWeight (boundedCircuitFormula C d) n z := by
  rw [compactCircuit_normalized]


end CircuitCompactFormula

-- From Solutions.CircuitDecoderBridge

/-! This file isolates the remaining, unproved certificate construction. The
conditional bridge is checked; it is not a proof of that construction. -/

namespace CircuitDecoderBridge

open ResultantVNP PermanentFoundation VNPNestedBooleanSum CircuitFixedCodes
  PermanentFormulaBooleanSum

def codeLength (s d : ℕ) : ℕ :=
  2 * ((s + 1) * d + 1) * ((s + 1) * (d + 3) + d + 2)

/-- The remaining certificate obligation. Extra witness bits may describe
    a computation transcript, so the decoder need not itself have a small
    deterministic Boolean formula. Both the transcript length and the
    arithmetic witness size must be uniformly polynomial in gates and degree. -/
def DecoderFormulaProperty : Prop :=
  ∃ k : ℕ, ∀ (a : ℕ) (C : Circuit (Fin a)) (d : ℕ),
    C.value.totalDegree ≤ d →
    ∃ r : ℕ, r ≤ (C.size + d + 2)^k ∧
      ∃ F : Formula (Fin (a + (codeLength C.size d + r))),
        F.size ≤ (C.size + d + 2)^k ∧
        ∀ z : Fin (codeLength C.size d) → Fin 2,
          (∑ y : Fin r → Fin 2,
            witnessEval a (codeLength C.size d + r) (Fin.append z y) F.value) =
          decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d)
            (codeLength C.size d) (fun i => finTwoEquiv (z i))

theorem codeLength_polyBounded {s d : ℕ → ℕ} (hs : PolyBounded s) (hd : PolyBounded d) :
    PolyBounded (fun n => codeLength (s n) (d n)) := by
  have h1 : PolyBounded (fun n => s n + 1) := polyBounded_add hs (polyBounded_const 1)
  have h2 : PolyBounded (fun n => d n + 3) := polyBounded_add hd (polyBounded_const 3)
  have h3 : PolyBounded (fun n => (s n + 1) * d n + 1) :=
    polyBounded_add (polyBounded_mul h1 hd) (polyBounded_const 1)
  have h4 : PolyBounded (fun n => (s n + 1) * (d n + 3) + d n + 2) :=
    polyBounded_add (polyBounded_add (polyBounded_mul h1 h2) hd) (polyBounded_const 2)
  simpa [codeLength] using polyBounded_mul (polyBounded_mul (polyBounded_const 2) h3) h4

/-- If the remaining decoder certificate is constructed, it supplies exactly
    the formula-sum property used by the accepted permanent reduction. -/
theorem vpFormulaSum_of_decoder (hdecoder : DecoderFormulaProperty) : VPFormulaSumProperty := by
  classical
  obtain ⟨k,hdecoder⟩ := hdecoder
  intro f hf
  obtain ⟨_,hdegree,c,hcircuits⟩ := hf
  choose C hval hsize using hcircuits
  let s : ℕ → ℕ := fun n => (C n).size
  let d : ℕ → ℕ := fun n => (f.p n).totalDegree
  have hs : PolyBounded s := ⟨c,hsize⟩
  have hd : PolyBounded d := hdegree
  let N : ℕ → ℕ := fun n => codeLength (s n) (d n)
  have hN : PolyBounded N := codeLength_polyBounded hs hd
  have hconstruct : ∀ n, ∃ r : ℕ, r ≤ (s n + d n + 2)^k ∧
      ∃ F : Formula (Fin (f.nvars n + (N n + r))),
        F.size ≤ (s n + d n + 2)^k ∧
        ∀ z : Fin (N n) → Fin 2,
          (∑ y : Fin r → Fin 2, witnessEval (f.nvars n) (N n + r) (Fin.append z y) F.value) =
          decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula (C n) (d n))
            (N n) (fun i => finTwoEquiv (z i)) := by
    intro n
    apply hdecoder (f.nvars n) (C n) (d n)
    simp [d,hval n]
  choose r hr F hF hcorrect using hconstruct
  have hbase : PolyBounded (fun n => s n + d n + 2) :=
    polyBounded_add (polyBounded_add hs hd) (polyBounded_const 2)
  have hpow : PolyBounded (fun n => (s n + d n + 2)^k) := polyBounded_pow hbase k
  have hrbound : PolyBounded r := polyBounded_mono hpow hr
  have hFbound : PolyBounded (fun n => (F n).size) := polyBounded_mono hpow hF
  refine ⟨fun n => N n + r n, polyBounded_add hN hrbound, F, hFbound, ?_⟩
  intro n
  let e : (Fin (N n) → Fin 2) ≃ (Fin (N n) → Bool) :=
    Equiv.piCongrRight (fun _ => finTwoEquiv)
  have hsum : (∑ z : Fin (N n) → Fin 2,
      decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula (C n) (d n))
        (N n) (e z)) = (C n).value := by
    rw [e.sum_comp]
    exact boundedCircuit_decodedWeight_sum (C n) (d n) (by simp [d,hval n])
  calc
    f.p n = (C n).value := (hval n).symm
    _ = ∑ z : Fin (N n) → Fin 2,
        decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula (C n) (d n))
          (N n) (e z) := hsum.symm
    _ = ∑ z : Fin (N n) → Fin 2, ∑ y : Fin (r n) → Fin 2,
        witnessEval (f.nvars n) (N n + r n) (Fin.append z y) (F n).value := by
      apply Finset.sum_congr rfl
      intro z _
      exact (hcorrect n z).symm
    _ = ∑ z : Fin (N n + r n) → Fin 2,
        witnessEval (f.nvars n) (N n + r n) z (F n).value := by
      calc
        _ = ∑ zy : (Fin (N n) → Fin 2) × (Fin (r n) → Fin 2),
            witnessEval (f.nvars n) (N n + r n) (Fin.append zy.1 zy.2) (F n).value := by
              rw [Fintype.sum_prod_type]
        _ = _ := by
          apply Fintype.sum_equiv (Fin.appendEquiv (α := Fin 2) (N n) (r n))
          intro ⟨z,y⟩
          rfl


end CircuitDecoderBridge

-- From Solutions.CompactDecoderBridge

/-! The decoder certificate only needs to handle circuits with a linear
bound on their total number of nodes. This is an exact reduction, because
compaction preserves the unfolded formula and hence the decoder. -/

namespace CompactDecoderBridge

open ResultantVNP PermanentFoundation VNPNestedBooleanSum CircuitFixedCodes
  CircuitDecoderBridge CircuitReferenceBound CircuitCompactCorrect CircuitCompactFormula

/-- Remaining compiler obligation restricted to compact circuit data. The
parameter `s` is an upper bound supplied by the original gate-counted circuit;
the code length remains based on that original bound. -/
def CompactDecoderCompiler : Prop :=
  ∃ k : ℕ, ∀ (a : ℕ) (D : Circuit (Fin a)) (s d : ℕ),
    D.nodes.length ≤ 2 * s + 1 → D.size ≤ 2 * s + 1 → D.value.totalDegree ≤ d →
    ∃ r : ℕ, r ≤ (s + d + 2)^k ∧
      ∃ F : Formula (Fin (a + (codeLength s d + r))),
        F.size ≤ (s + d + 2)^k ∧
        ∀ z : Fin (codeLength s d) → Fin 2,
          (∑ y : Fin r → Fin 2,
            witnessEval a (codeLength s d + r) (Fin.append z y) F.value) =
          decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula D d)
            (codeLength s d) (fun i => finTwoEquiv (z i))

theorem decoder_of_compact_compiler (hcompact : CompactDecoderCompiler) :
    DecoderFormulaProperty := by
  obtain ⟨k,hcompact⟩ := hcompact
  refine ⟨k, ?_⟩
  intro a C d hdegree
  have hd : (compactCircuit C).value.totalDegree ≤ d := by
    rw [compactCircuit_value]
    exact hdegree
  obtain ⟨r,hr,F,hF,hFvalue⟩ := hcompact a (compactCircuit C) C.size d
    (compactCircuit_node_bound C) (compactCircuit_size_bound C) hd
  refine ⟨r,hr,F,hF,?_⟩
  intro z
  rw [← compactCircuit_decoder C d (codeLength C.size d) (fun i => finTwoEquiv (z i))]
  exact hFvalue z

theorem vpFormulaSum_of_compact_compiler (h : CompactDecoderCompiler) :
    VPFormulaSumProperty := vpFormulaSum_of_decoder (decoder_of_compact_compiler h)


end CompactDecoderBridge

-- From Solutions.CompactTranscriptBridge

/-! Conditional bridge from a compact circuit's unique Boolean transcript
    verifier to the exact open formula-sum property. -/

namespace CompactTranscriptBridge

open ResultantVNP PermanentFoundation VNPNestedBooleanSum CircuitFixedCodes CircuitDecoderBridge
  CompactDecoderBridge BooleanVerifierFormula

def accept {q : ℕ} (verifier : BoolFormula (Fin q)) (w : Fin q → Fin 2) : Bool :=
  verifier.test (fun i => witnessBool (w i))

/-- Remaining construction, restricted to compact circuit data. The
    verifier may be any Boolean formula, and must admit exactly one extra
    transcript per code. -/
def CompactTranscriptProperty : Prop :=
  ∃ k : ℕ, ∀ (a : ℕ) (D : Circuit (Fin a)) (s d : ℕ),
    D.nodes.length ≤ 2*s+1 → D.size ≤ 2*s+1 → D.value.totalDegree ≤ d →
    ∃ r : ℕ, r ≤ (s+d+2)^k ∧
      ∃ verifier : BoolFormula (Fin (codeLength s d+r)), verifier.nodes ≤ (s+d+2)^k ∧
      ∃ payload : Formula (Fin (a+(codeLength s d+r))), payload.size ≤ (s+d+2)^k ∧
      ∀ z : Fin (codeLength s d) → Fin 2,
        (∃! y : Fin r → Fin 2, accept verifier (Fin.append z y) = true) ∧
        ∀ y : Fin r → Fin 2, accept verifier (Fin.append z y) = true →
          witnessEval a (codeLength s d+r) (Fin.append z y) payload.value =
            decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula D d)
              (codeLength s d) (fun i => finTwoEquiv (z i))

theorem unique_filter_sum (a q r : ℕ) (verifier : BoolFormula (Fin (q+r)))
    (payload : Formula (Fin (a+(q+r)))) (z : Fin q → Fin 2) (y : Fin r → Fin 2)
    (hy : accept verifier (Fin.append z y) = true)
    (huniq : ∀ y', accept verifier (Fin.append z y') = true → y' = y) :
    (∑ y' : Fin r → Fin 2, witnessEval a (q+r) (Fin.append z y')
      (Formula.mul (witnessFormula a (q+r) verifier) payload).value) =
      witnessEval a (q+r) (Fin.append z y) payload.value := by
  classical
  calc
    _ = witnessEval a (q+r) (Fin.append z y)
        (Formula.mul (witnessFormula a (q+r) verifier) payload).value := by
      apply Finset.sum_eq_single y
      · intro y' _ hne
        rw [witness_filter]
        have hf : accept verifier (Fin.append z y') = false := by
          cases he : accept verifier (Fin.append z y') with
          | false => rfl
          | true => exact (hne (huniq y' he)).elim
        unfold accept at hf
        simp [hf]
      · intro hy'
        exact (hy' (Finset.mem_univ y)).elim
    _ = _ := by
      rw [witness_filter]
      unfold accept at hy
      simp [hy]

theorem compiler_of_transcripts (htranscript : CompactTranscriptProperty) : CompactDecoderCompiler := by
  classical
  obtain ⟨k,htranscript⟩ := htranscript
  refine ⟨k+4,?_⟩
  intro a D s d hnodes hsize hdegree
  obtain ⟨r,hr,verifier,hv,payload,hp,hvalid⟩ := htranscript a D s d hnodes hsize hdegree
  let B := s+d+2
  change r ≤ B^k at hr
  change verifier.nodes ≤ B^k at hv
  change payload.size ≤ B^k at hp
  have hB : 2 ≤ B := by dsimp [B]; omega
  have hpow : 1 ≤ B^k := Nat.one_le_pow k B (by omega)
  have hpow4 : 16 ≤ B^4 := by
    have hh := Nat.pow_le_pow_left hB 4
    norm_num at hh ⊢
    exact hh
  have hbig : B^k ≤ B^(k+4) := Nat.pow_le_pow_right (by omega) (by omega)
  have hbound : 7*B^k+B^k+1 ≤ B^(k+4) := by
    have hm := Nat.mul_le_mul_right (B^k) (show 9 ≤ B^4 by omega)
    rw [pow_add]
    nlinarith
  refine ⟨r,hr.trans hbig,Formula.mul (witnessFormula a _ verifier) payload,?_,?_⟩
  · have hh := witness_filter_size a _ verifier payload
    exact hh.trans (by change 7*verifier.nodes+payload.size+1 ≤ B^(k+4); omega)
  · intro z
    obtain ⟨⟨y,hy,huniq⟩,hpayload⟩ := hvalid z
    rw [unique_filter_sum a _ r verifier payload z y hy huniq]
    exact hpayload y hy

theorem vpFormulaSum_of_compact_transcripts (h : CompactTranscriptProperty) : VPFormulaSumProperty :=
  vpFormulaSum_of_compact_compiler (compiler_of_transcripts h)


end CompactTranscriptBridge

-- From Solutions.FinalTranscriptPayload

/-! Connect the final transcript word to the checked arithmetic payload. -/

namespace FinalTranscriptPayload

open ResultantVNP PermanentFoundation BooleanVerifierFormula IndexedFactorMachine IndexedStateEncoding
  IndexedPlanControl WiredTranscript TranscriptInitialControl DecoderInitialState StatePaddingPayload
  VNPNestedBooleanSum CircuitFixedCodes

def transcriptSize {α : Type} (C : Circuit α) (d q : ℕ) : ℕ :=
  width (stateWidth C.nodes.length (d+1) (q+1)) (planWidth C.nodes.length (d+1)) q

def finalWire {α : Type} (C : Circuit α) (d q : ℕ) :
    Fin (stateWidth C.nodes.length (d+1) (q+1)) → Fin (q+transcriptSize C d q) :=
  fun j => Fin.natAdd q (stateCoord _ _ _ (Fin.last q) j)

noncomputable def verifier {α : Type} (C : Circuit α) (d q : ℕ) :
    BoolFormula (Fin (q+transcriptSize C d q)) :=
  fullChecker C (d+1) (q+1) q q (by omega) (source C.nodes.length (d+1) q) (reference C d q)

noncomputable def payload (a : ℕ) (C : Circuit (Fin a)) (d q : ℕ) :
    Formula (Fin (a+(q+transcriptSize C d q))) :=
  statePayload a _ (d+1) (q+1) C (finalWire C d q)

noncomputable def compiledFormula (a : ℕ) (C : Circuit (Fin a)) (d q : ℕ) :
    Formula (Fin (a+(q+transcriptSize C d q))) :=
  .mul (witnessFormula a _ (verifier C d q)) (payload a C d q)

theorem witnessBool_append (q r : ℕ) (z : Fin q → Fin 2) (y : Fin r → Fin 2) :
    (fun i => witnessBool ((Fin.append z y) i)) =
      Fin.append (fun i => witnessBool (z i)) (fun i => witnessBool (y i)) := by
  funext i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp

theorem witnessBool_eq_equiv (b : Fin 2) : witnessBool b = finTwoEquiv b := by
  fin_cases b <;> rfl

theorem witnessBool_injective : Function.Injective witnessBool := by
  intro a b h
  apply finTwoEquiv.injective
  simpa only [← witnessBool_eq_equiv] using h

set_option backward.isDefEq.respectTransparency false in
theorem payload_sound (a : ℕ) (C : Circuit (Fin a)) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)) → Fin 2)
    (y : Fin (transcriptSize C d (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2))) → Fin 2)
    (haccept : (verifier C d _).test (fun i => witnessBool ((Fin.append z y) i)) = true) :
    witnessEval a _ (Fin.append z y) (payload a C d _).value =
      decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) _ (fun i => witnessBool (z i)) := by
  let q := 2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)
  let zb : Fin q → Bool := fun i => witnessBool (z i)
  let yb : Fin (transcriptSize C d q) → Bool := fun i => witnessBool (y i)
  obtain ⟨last,hfinal,_,_,hweight⟩ := SentinelExecution.sentinel_run C d hdegree zb
  obtain ⟨states,plans,hruns,hunique⟩ := sentinel_transcript C d q zb last hfinal
  have hzero : states 0 = initialState C d q zb := by
    apply Subtype.ext
    have h := hruns 0
    simp only [Fin.val_zero,run] at h
    exact (Option.some.inj h).symm
  have hlast : (states (Fin.last q)).val = last := by
    have h := hruns (Fin.last q)
    simp only [Fin.val_last] at h
    rw [hfinal] at h
    exact (Option.some.inj h).symm
  have hcanonical : yb = encode _ _ _ (fun t => stateWord C.nodes.length (d+1) (q+1) (states t)) plans := by
    apply (hunique yb).mp
    have hh := haccept
    change (fullChecker C (d+1) (q+1) q q (by omega)
      (source C.nodes.length (d+1) q) (reference C d q)).test _ = true at hh
    rw [witnessBool_append] at hh
    rw [fullChecker_correct] at hh
    dsimp only [q,transcriptSize] at hh
    simp only [Fin.append_left,Fin.append_right] at hh
    refine ⟨?_,hh.2⟩
    rw [hzero,initial_word]
    exact funext hh.1
  have hwire : ∀ j, witnessBool ((Fin.append z y) (finalWire C d q j)) =
      stateWord C.nodes.length (d+1) (q+1) (states (Fin.last q)) j := by
    intro j
    change (fun i => witnessBool ((Fin.append z y) i)) (finalWire C d q j) = _
    rw [witnessBool_append]
    dsimp only [finalWire,q,transcriptSize]
    simp only [Fin.append_right]
    change yb (stateCoord _ _ _ (Fin.last q) j) = _
    change stateAt _ _ _ yb (Fin.last q) j = _
    rw [hcanonical,stateAt_encode]
  rw [payload,statePayload_eval a _ (d+1) (q+1) C (states (Fin.last q)) (finalWire C d q)
    (Fin.append z y) hwire]
  rw [hlast]
  exact hweight.symm

set_option backward.isDefEq.respectTransparency false in
theorem verifier_unique (a : ℕ) (C : Circuit (Fin a)) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)) → Fin 2) :
    ∃! y : Fin (transcriptSize C d (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2))) → Fin 2,
      (verifier C d _).test (fun i => witnessBool ((Fin.append z y) i)) = true := by
  let q := 2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)
  let zb : Fin q → Bool := fun i => witnessBool (z i)
  obtain ⟨yb,hyb,huniq⟩ := decoder_verifier_unique C d hdegree zb
  let y : Fin (transcriptSize C d q) → Fin 2 := fun i => finTwoEquiv.symm (yb i)
  have hyword : (fun i => witnessBool (y i)) = yb := by
    funext i
    simp only [witnessBool_eq_equiv,y,Equiv.apply_symm_apply]
  refine ⟨y,?_,?_⟩
  · change (fullChecker C (d+1) (q+1) q q (by omega)
      (source C.nodes.length (d+1) q) (reference C d q)).test _ = true
    rw [witnessBool_append,hyword]
    exact hyb
  · intro y' hy'
    apply funext
    intro i
    apply witnessBool_injective
    have h' : (fun i => witnessBool (y' i)) = yb := by
      apply huniq
      change (fullChecker C (d+1) (q+1) q q (by omega)
        (source C.nodes.length (d+1) q) (reference C d q)).test _ = true at hy'
      rw [witnessBool_append] at hy'
      exact hy'
    exact (congrFun h' i).trans (congrFun hyword i).symm

/-- The verifier-gated payload sums to the decoder weight over all
    transcripts, without requiring any extra uniqueness assumption. -/
theorem compiled_decoder (a : ℕ) (C : Circuit (Fin a)) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)) → Fin 2) :
    let q := 2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)
    (∑ y : Fin (transcriptSize C d q) → Fin 2,
      witnessEval a (q+transcriptSize C d q) (Fin.append z y)
        (Formula.mul (witnessFormula a _ (verifier C d q)) (payload a C d q)).value) =
      decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) q (fun i => finTwoEquiv (z i)) := by
  classical
  dsimp only
  obtain ⟨y,hy,huniq⟩ := verifier_unique a C d hdegree z
  rw [CompactTranscriptBridge.unique_filter_sum _ _ _ _ _ z y hy huniq]
  rw [payload_sound a C d hdegree z y hy]
  congr 1
  funext i
  exact witnessBool_eq_equiv (z i)


end FinalTranscriptPayload

-- From Solutions.DecoderCompilerBounds

/-! Explicit polynomial bounds for the transcript verifier and its
    arithmetic formula, in the compact circuit's node count and degree. -/

namespace DecoderCompilerBounds

open ResultantVNP PermanentFoundation PermanentFormulaBooleanSum BooleanVerifierFormula
  IndexedNormalizedAddresses IndexedStateEncoding IndexedPlanControl IndexedTagControl
  WiredTranscript FinalTranscriptPayload

def transitionBound (m D N : ℕ) : ℕ :=
  (2 * planWidth m D * (2 * tagLookupBound m D + 8) + 8) +
  (38 * ((N+1)*(tagWordLength m D+1)) + 1) +
  (24 * (N*((3+(m+1))+1)) + 1) + (24 * (N*(1+1)) + 1) + 3

def verifierBound (m D N T : ℕ) : ℕ :=
  10 * stateWidth m D N + 2 +
    (T * (transitionBound m D N + 10*stateWidth m D N + 10*planWidth m D + 10) + 1)

theorem verifier_nodes_bound {α : Type} (C : Circuit α) (d q : ℕ) :
    (verifier C d q).nodes ≤ verifierBound C.nodes.length (d+1) (q+1) q := by
  have ht := WiredTransitionControl.checker_nodes C (d+1) (q+1) (by omega)
  have hu := WiredTotalTransition.checker_nodes C (d+1) (q+1) (by omega)
  have hv := TranscriptInitialControl.fullChecker_nodes C (d+1) (q+1) q q (by omega)
    (DecoderInitialState.source C.nodes.length (d+1) q) (DecoderInitialState.reference C d q)
  rw [WiredTranscript.checker_nodes] at hv
  have hm : q * ((WiredTotalTransition.checker C (d+1) (q+1) (by omega)).nodes + 1) ≤
      q * (transitionBound C.nodes.length (d+1) (q+1) +
        10*stateWidth C.nodes.length (d+1) (q+1) + 10*planWidth C.nodes.length (d+1) + 10) := by
    apply Nat.mul_le_mul_left
    dsimp [transitionBound]
    omega
  change (TranscriptInitialControl.fullChecker C (d+1) (q+1) q q (by omega)
    (DecoderInitialState.source C.nodes.length (d+1) q) (DecoderInitialState.reference C d q)).nodes ≤ _
  dsimp [verifierBound]
  omega

theorem compiledFormula_size_bound (a : ℕ) (C : Circuit (Fin a)) (d q : ℕ) :
    (compiledFormula a C d q).size ≤ 7*verifierBound C.nodes.length (d+1) (q+1) q +
      (7*(3*(q+1)+1) + (q+1)*(50*(C.nodes.length+1)+21)+1) + 1 := by
  have h := witness_filter_size a (q+transcriptSize C d q) (verifier C d q) (payload a C d q)
  have hv := verifier_nodes_bound C d q
  have hp := StatePaddingPayload.statePayload_size a (q+transcriptSize C d q) (d+1) (q+1) C (finalWire C d q)
  change (compiledFormula a C d q).size ≤ _ at h
  change (payload a C d q).size ≤ _ at hp
  omega

set_option maxHeartbeats 2000000 in
theorem circuitWidths_polyBounded (m D N T : ℕ → ℕ)
    (hm : PolyBounded m) (hD : PolyBounded D) (hN : PolyBounded N) (hT : PolyBounded T) :
    PolyBounded (fun n => width (stateWidth (m n) (D n) (N n)) (planWidth (m n) (D n)) (T n)) ∧
    PolyBounded (fun n => verifierBound (m n) (D n) (N n) (T n)) := by
  have hm1 := polyBounded_add hm (polyBounded_const 1)
  have hD1 := polyBounded_add hD (polyBounded_const 1)
  have hN1 := polyBounded_add hN (polyBounded_const 1)
  have hT1 := polyBounded_add hT (polyBounded_const 1)
  have htag : PolyBounded (fun n => tagWordLength (m n) (D n)) := by
    exact polyBounded_add (polyBounded_const 8)
      (polyBounded_add hm1 (polyBounded_add hm1 (polyBounded_add hD1 hD1)))
  have htag1 := polyBounded_add htag (polyBounded_const 1)
  have hfactor := polyBounded_add (polyBounded_add (polyBounded_const 3) hm1) (polyBounded_const 1)
  have hplan : PolyBounded (fun n => planWidth (m n) (D n)) := by
    exact polyBounded_add (polyBounded_mul (polyBounded_const 2) htag1)
      (polyBounded_add (polyBounded_mul (polyBounded_const 1) hfactor) (polyBounded_const 1))
  have hstate : PolyBounded (fun n => stateWidth (m n) (D n) (N n)) := by
    exact polyBounded_add (polyBounded_mul hN1 htag1)
      (polyBounded_add (polyBounded_mul hN hfactor) (polyBounded_mul hN (polyBounded_const 2)))
  have htagcount := polyBounded_mul (polyBounded_mul (polyBounded_const 8) (polyBounded_pow hm1 2))
    (polyBounded_pow hD1 2)
  have hlookup : PolyBounded (fun n => tagLookupBound (m n) (D n)) := by
    exact polyBounded_add
      (polyBounded_add (polyBounded_mul (polyBounded_const 3) (polyBounded_mul htagcount htag))
        (polyBounded_mul (polyBounded_const 2) htagcount)) (polyBounded_const 1)
  have htrans : PolyBounded (fun n => transitionBound (m n) (D n) (N n)) := by
    exact polyBounded_add
      (polyBounded_add (polyBounded_add (polyBounded_add
        (polyBounded_add
          (polyBounded_mul (polyBounded_mul (polyBounded_const 2) hplan)
            (polyBounded_add (polyBounded_mul (polyBounded_const 2) hlookup) (polyBounded_const 8)))
          (polyBounded_const 8))
        (polyBounded_add (polyBounded_mul (polyBounded_const 38) (polyBounded_mul hN1 htag1)) (polyBounded_const 1)))
        (polyBounded_add (polyBounded_mul (polyBounded_const 24) (polyBounded_mul hN hfactor)) (polyBounded_const 1)))
        (polyBounded_add (polyBounded_mul (polyBounded_const 24)
          (polyBounded_mul hN (polyBounded_const 2))) (polyBounded_const 1))) (polyBounded_const 3)
  constructor
  · exact polyBounded_add (polyBounded_mul hT1 hstate) (polyBounded_mul hT hplan)
  · exact polyBounded_add (polyBounded_add (polyBounded_mul (polyBounded_const 10) hstate) (polyBounded_const 2))
      (polyBounded_add (polyBounded_mul hT
        (polyBounded_add (polyBounded_add (polyBounded_add htrans
          (polyBounded_mul (polyBounded_const 10) hstate))
          (polyBounded_mul (polyBounded_const 10) hplan)) (polyBounded_const 10))) (polyBounded_const 1))

theorem compiled_family_polyBounded (a : ℕ → ℕ) (C : ∀ n, Circuit (Fin (a n)))
    (d : ℕ → ℕ) (hsize : PolyBounded (fun n => (C n).size))
    (hnodes : PolyBounded (fun n => (C n).nodes.length)) (hd : PolyBounded d) :
    let q := fun n => CircuitDecoderBridge.codeLength (C n).size (d n)
    PolyBounded q ∧ PolyBounded (fun n => transcriptSize (C n) (d n) (q n)) ∧
      PolyBounded (fun n => (compiledFormula (a n) (C n) (d n) (q n)).size) := by
  dsimp only
  let q := fun n => CircuitDecoderBridge.codeLength (C n).size (d n)
  have hq : PolyBounded q := CircuitDecoderBridge.codeLength_polyBounded hsize hd
  have hd1 := polyBounded_add hd (polyBounded_const 1)
  have hq1 := polyBounded_add hq (polyBounded_const 1)
  have hwidths := circuitWidths_polyBounded (fun n => (C n).nodes.length) (fun n => d n+1)
    (fun n => q n+1) q hnodes hd1 hq1 hq
  have hr : PolyBounded (fun n => transcriptSize (C n) (d n) (q n)) := hwidths.1
  have hv := hwidths.2
  have hm1 := polyBounded_add hnodes (polyBounded_const 1)
  have hpayload := polyBounded_add
    (polyBounded_add
      (polyBounded_mul (polyBounded_const 7)
        (polyBounded_add (polyBounded_mul (polyBounded_const 3) hq1) (polyBounded_const 1)))
      (polyBounded_mul hq1 (polyBounded_add (polyBounded_mul (polyBounded_const 50) hm1) (polyBounded_const 21))))
    (polyBounded_const 1)
  have hbound := polyBounded_add (polyBounded_add (polyBounded_mul (polyBounded_const 7) hv) hpayload)
    (polyBounded_const 1)
  refine ⟨hq,hr,polyBounded_mono hbound ?_⟩
  intro n
  exact compiledFormula_size_bound (a n) (C n) (d n) (q n)


end DecoderCompilerBounds

-- From Solutions.VPFormulaSumComplete

/-! A polynomial-size circuit family has polynomial-size formula witnesses:
    compact each circuit, compile its decoder transcript, and sum over the
    code and its unique accepting transcript. -/

namespace VPFormulaSumComplete

open ResultantVNP PermanentFoundation PermanentFormulaBooleanSum VNPNestedBooleanSum
  CircuitFixedCodes CircuitDecoderBridge CircuitReferenceBound CircuitCompactCorrect
  FinalTranscriptPayload DecoderCompilerBounds

theorem vpFormulaSum : VPFormulaSumProperty := by
  classical
  intro f hf
  obtain ⟨_,hdegree,c,hcircuits⟩ := hf
  choose C hval hsize using hcircuits
  let D : ∀ n, Circuit (Fin (f.nvars n)) := fun n => compactCircuit (C n)
  let d : ℕ → ℕ := fun n => (f.p n).totalDegree
  have hd : PolyBounded d := hdegree
  have hs : PolyBounded (fun n => (C n).size) := ⟨c,hsize⟩
  have hnodeBound : PolyBounded (fun n => 2 * (C n).size + 1) :=
    polyBounded_add (polyBounded_mul (polyBounded_const 2) hs) (polyBounded_const 1)
  have hnodes : PolyBounded (fun n => (D n).nodes.length) :=
    polyBounded_mono hnodeBound (fun n => compactCircuit_node_bound (C n))
  have hdsize : PolyBounded (fun n => (D n).size) :=
    polyBounded_mono hnodes (fun n => List.countP_le_length)
  have hdegreeD : ∀ n, (D n).value.totalDegree ≤ d n := by
    intro n
    change (compactCircuit (C n)).value.totalDegree ≤ (f.p n).totalDegree
    rw [compactCircuit_value,hval n]
  let q : ℕ → ℕ := fun n => codeLength (D n).size (d n)
  let r : ℕ → ℕ := fun n => transcriptSize (D n) (d n) (q n)
  let F : ∀ n, Formula (Fin (f.nvars n+(q n+r n))) :=
    fun n => compiledFormula (f.nvars n) (D n) (d n) (q n)
  have hb := compiled_family_polyBounded f.nvars D d hdsize hnodes hd
  have hq : PolyBounded q := hb.1
  have hr : PolyBounded r := hb.2.1
  have hF : PolyBounded (fun n => (F n).size) := hb.2.2
  refine ⟨fun n => q n+r n,polyBounded_add hq hr,F,hF,?_⟩
  intro n
  let e : (Fin (q n) → Fin 2) ≃ (Fin (q n) → Bool) :=
    Equiv.piCongrRight (fun _ => finTwoEquiv)
  have hsum : (∑ z : Fin (q n) → Fin 2,
      decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula (D n) (d n))
        (q n) (e z)) = (D n).value := by
    rw [e.sum_comp]
    exact boundedCircuit_decodedWeight_sum (D n) (d n) (hdegreeD n)
  calc
    f.p n = (D n).value := by dsimp [D]; rw [compactCircuit_value,hval n]
    _ = ∑ z : Fin (q n) → Fin 2,
        decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula (D n) (d n))
          (q n) (e z) := hsum.symm
    _ = ∑ z : Fin (q n) → Fin 2, ∑ y : Fin (r n) → Fin 2,
        witnessEval (f.nvars n) (q n+r n) (Fin.append z y) (F n).value := by
      apply Finset.sum_congr rfl
      intro z _
      exact (compiled_decoder (f.nvars n) (D n) (d n) (hdegreeD n) z).symm
    _ = ∑ z : Fin (q n+r n) → Fin 2, witnessEval (f.nvars n) (q n+r n) z (F n).value := by
      calc
        _ = ∑ zy : (Fin (q n) → Fin 2) × (Fin (r n) → Fin 2),
            witnessEval (f.nvars n) (q n+r n) (Fin.append zy.1 zy.2) (F n).value := by
              rw [Fintype.sum_prod_type]
        _ = _ := by
          apply Fintype.sum_equiv (Fin.appendEquiv (α := Fin 2) (q n) (r n))
          intro ⟨z,y⟩
          rfl


end VPFormulaSumComplete

theorem solution : VNPNestedBooleanSum.VPFormulaSumProperty :=
  VPFormulaSumComplete.vpFormulaSum

#print axioms solution
