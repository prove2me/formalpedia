variable {K : Type} [Field K] [NumberField K]

private theorem t0583 (R : Matrix (Fin 2) (Fin 2) ℝ) :
    Continuous fun y : ℝ => ArchR.diagOne y * R := by
  unfold ArchR.diagOne
  exact ((continuous_id.matrixVecCons continuous_const).matrixVecCons continuous_const).matrix_mul continuous_const

private theorem t0584 (C : Matrix (Fin 2) (Fin 2) ℂ) :
    Continuous fun z : ℂ => ArchC.diagOne z * C := by
  unfold ArchC.diagOne
  exact ((continuous_id.matrixVecCons continuous_const).matrixVecCons continuous_const).matrix_mul continuous_const

private theorem t0585 {P : RealArchParam} (D : ArchDatumR P) {R : Matrix (Fin 2) (Fin 2) ℝ}
    (hR : R.det ≠ 0) : ContinuousOn (fun y : ℝ => D.W (ArchR.diagOne y * R)) {y : ℝ | y ≠ 0} := by
  have hcoord : Continuous fun y : ℝ => Matrix.of.symm (ArchR.diagOne y * R) := t0583 R
  refine D.smooth.continuousOn.comp hcoord.continuousOn fun y hy => ?_
  show (ArchR.diagOne y * R).det ≠ 0
  rw [t0211]
  exact mul_ne_zero hy hR

private theorem t0586 {P : ComplexArchParam} (D : ArchDatumC P)
    {C : Matrix (Fin 2) (Fin 2) ℂ} (hC : C.det ≠ 0) :
    ContinuousOn (fun z : ℂ => D.W (ArchC.diagOne z * C)) {z : ℂ | z ≠ 0} := by
  have hcoord : Continuous fun z : ℂ => Matrix.of.symm (ArchC.diagOne z * C) := t0584 C
  refine D.smooth.continuousOn.comp hcoord.continuousOn fun z hz => ?_
  show (ArchC.diagOne z * C).det ≠ 0
  rw [t0212]
  exact mul_ne_zero hz hC

variable (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0587 {w : InfinitePlace K} (hw : w.IsReal) (g₀ : AdelicGL2 (𝓞 K) K) (u : ℂ)
    (a : ℤ) (s : ℂ) : ContinuousOn (fun y : ℝ => d050 archR dR hw g₀ u a s y) {y : ℝ | y ≠ 0} := by
  have habs : Continuous fun y : ℝ => ((|y| : ℝ) : ℂ) := Complex.continuous_ofReal.comp continuous_abs
  have hW := t0585 (dR w hw) (t0144 w hw g₀)
  have hsqrt : ContinuousOn (fun y : ℝ => ((Real.sqrt |y| : ℝ) : ℂ)⁻¹) {y : ℝ | y ≠ 0} :=
    (Complex.continuous_ofReal.comp (Real.continuous_sqrt.comp continuous_abs)).continuousOn.inv₀ fun y hy =>
      Complex.ofReal_ne_zero.2 (Real.sqrt_pos.2 (abs_pos.2 hy)).ne'
  have hchar : ContinuousOn (fun y : ℝ => ((|y| : ℝ) : ℂ) ^ ((w.mult : ℂ) * u)) {y : ℝ | y ≠ 0} :=
    habs.continuousOn.cpow_const fun y hy => Complex.ofReal_mem_slitPlane.2 (abs_pos.2 hy)
  have hsign : ContinuousOn (fun y : ℝ => (((y : ℝ) : ℂ) / ((|y| : ℝ) : ℂ)) ^ a) {y : ℝ | y ≠ 0} :=
    (Complex.continuous_ofReal.continuousOn.div₀ habs.continuousOn fun y hy =>
      Complex.ofReal_ne_zero.2 (abs_pos.2 hy).ne').zpow₀ a fun y hy =>
        Or.inl (div_ne_zero (Complex.ofReal_ne_zero.2 hy) (Complex.ofReal_ne_zero.2 (abs_pos.2 hy).ne'))
  have hnorm : ContinuousOn (fun y : ℝ => ((|y| ^ w.mult : ℝ) : ℂ) ^ (s - 1)) {y : ℝ | y ≠ 0} :=
    (Complex.continuous_ofReal.comp (continuous_abs.pow w.mult)).continuousOn.cpow_const fun y hy =>
      Complex.ofReal_mem_slitPlane.2 (pow_pos (abs_pos.2 hy) _)
  unfold d050
  exact (((hW.mul hsqrt).mul continuousOn_const).mul (hchar.mul hsign)).mul hnorm

private theorem t0588 {w : InfinitePlace K} (hw : w.IsComplex) (g₀ : AdelicGL2 (𝓞 K) K)
    (u : ℂ) (k : ℤ) (s : ℂ) : ContinuousOn (fun z : ℂ => d051 archC dC hw g₀ u k s z) {z : ℂ | z ≠ 0} := by
  have hnrm : Continuous fun z : ℂ => ((‖z‖ : ℝ) : ℂ) := Complex.continuous_ofReal.comp continuous_norm
  have hW := t0586 (dC w hw) (t0145 w hw g₀)
  have hinv : ContinuousOn (fun z : ℂ => ((‖z‖ : ℝ) : ℂ)⁻¹) {z : ℂ | z ≠ 0} :=
    hnrm.continuousOn.inv₀ fun z hz => Complex.ofReal_ne_zero.2 (norm_pos_iff.2 hz).ne'
  have hchar : ContinuousOn (fun z : ℂ => ((‖z‖ : ℝ) : ℂ) ^ ((w.mult : ℂ) * u)) {z : ℂ | z ≠ 0} :=
    hnrm.continuousOn.cpow_const fun z hz => Complex.ofReal_mem_slitPlane.2 (norm_pos_iff.2 hz)
  have hk : ContinuousOn (fun z : ℂ => (z / ((‖z‖ : ℝ) : ℂ)) ^ k) {z : ℂ | z ≠ 0} :=
    (continuousOn_id.div₀ hnrm.continuousOn fun z hz => Complex.ofReal_ne_zero.2 (norm_pos_iff.2 hz).ne').zpow₀ k
      fun z hz => Or.inl (div_ne_zero hz (Complex.ofReal_ne_zero.2 (norm_pos_iff.2 hz).ne'))
  have hnorm : ContinuousOn (fun z : ℂ => ((‖z‖ ^ w.mult : ℝ) : ℂ) ^ (s - 1)) {z : ℂ | z ≠ 0} :=
    (Complex.continuous_ofReal.comp (continuous_norm.pow w.mult)).continuousOn.cpow_const fun z hz =>
      Complex.ofReal_mem_slitPlane.2 (pow_pos (norm_pos_iff.2 hz) _)
  unfold d051
  exact (((hW.mul hinv).mul continuousOn_const).mul (hchar.mul hk)).mul hnorm

private def d056 : Set (mixedEmbedding.mixedSpace K) :=
  {z | (∀ v : {w : InfinitePlace K // w.IsReal}, z.1 v ≠ 0) ∧ ∀ v : {w : InfinitePlace K // w.IsComplex}, z.2 v ≠ 0}

private theorem t0589 : IsOpen (d056 (K := K)) := by
  have h₁ : IsOpen {z : mixedEmbedding.mixedSpace K | ∀ v : {w : InfinitePlace K // w.IsReal}, z.1 v ≠ 0} := by
    rw [Set.setOf_forall]
    exact isOpen_iInter_of_finite fun v => isOpen_ne_fun ((continuous_apply v).comp continuous_fst) continuous_const
  have h₂ : IsOpen {z : mixedEmbedding.mixedSpace K | ∀ v : {w : InfinitePlace K // w.IsComplex}, z.2 v ≠ 0} := by
    rw [Set.setOf_forall]
    exact isOpen_iInter_of_finite fun v => isOpen_ne_fun ((continuous_apply v).comp continuous_snd) continuous_const
  unfold d056
  rw [Set.setOf_and]
  exact h₁.inter h₂

private theorem t0590 :
    ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)), z ∈ d056 := by
  have hre : ∀ v : {w : InfinitePlace K // w.IsReal},
      ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)), z.1 v ≠ 0 := by
    intro v
    rw [ae_iff]
    have hset : {z : mixedEmbedding.mixedSpace K | ¬ z.1 v ≠ 0} =
        {x : {w : InfinitePlace K // w.IsReal} → ℝ | x v = 0} ×ˢ Set.univ := by
      ext z
      simp
    rw [hset, Measure.volume_eq_prod, Measure.prod_prod, volume_pi, Measure.pi_hyperplane, zero_mul]
  have hco : ∀ v : {w : InfinitePlace K // w.IsComplex},
      ∀ᵐ z ∂(volume : Measure (mixedEmbedding.mixedSpace K)), z.2 v ≠ 0 := by
    intro v
    rw [ae_iff]
    have hset : {z : mixedEmbedding.mixedSpace K | ¬ z.2 v ≠ 0} =
        Set.univ ×ˢ {y : {w : InfinitePlace K // w.IsComplex} → ℂ | y v = 0} := by
      ext z
      simp
    rw [hset, Measure.volume_eq_prod, Measure.prod_prod]
    simp only [volume_pi]
    rw [Measure.pi_hyperplane, mul_zero]
  exact (ae_all_iff.2 hre).and (ae_all_iff.2 hco)

private theorem t0591 (g₀ : AdelicGL2 (𝓞 K) K)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) (s : ℂ) :
    ContinuousOn (d052 (d054 archR dR g₀ uR aR s) (d055 archC dC g₀ uC kC s))
      d056 := by
  show ContinuousOn (fun z : mixedEmbedding.mixedSpace K =>
    (∏ v : {w : InfinitePlace K // w.IsReal}, d054 archR dR g₀ uR aR s v (z.1 v)) *
      ∏ v : {w : InfinitePlace K // w.IsComplex}, d055 archC dC g₀ uC kC s v (z.2 v)) d056
  refine ContinuousOn.mul (continuousOn_finsetProd _ fun v _ => ?_) (continuousOn_finsetProd _ fun v _ => ?_)
  · refine (t0587 archR dR v.2 g₀ (uR v.1 v.2) ((aR v.1 v.2).val : ℤ) s).comp
      ((continuous_apply v).comp continuous_fst).continuousOn fun z hz => ?_
    obtain ⟨h₁, -⟩ := hz
    exact h₁ v
  · refine (t0588 archC dC v.2 g₀ (uC v.1 v.2) (kC v.1 v.2) s).comp
      ((continuous_apply v).comp continuous_snd).continuousOn fun z hz => ?_
    obtain ⟨-, h₂⟩ := hz
    exact h₂ v

private theorem t0592 (g₀ : AdelicGL2 (𝓞 K) K)
    (uR : ∀ w : InfinitePlace K, w.IsReal → ℂ) (aR : ∀ w : InfinitePlace K, w.IsReal → ZMod 2)
    (uC : ∀ w : InfinitePlace K, w.IsComplex → ℂ) (kC : ∀ w : InfinitePlace K, w.IsComplex → ℤ) (s : ℂ) :
    AEStronglyMeasurable (d052 (d054 archR dR g₀ uR aR s) (d055 archC dC g₀ uC kC s))
      (volume : Measure (mixedEmbedding.mixedSpace K)) := by
  have h : AEStronglyMeasurable
      (d052 (d054 archR dR g₀ uR aR s) (d055 archC dC g₀ uC kC s))
      ((volume : Measure (mixedEmbedding.mixedSpace K)).restrict (d056 (K := K))) :=
    (t0591 archR archC dR dC g₀ uR aR uC kC s).aestronglyMeasurable
      t0589.measurableSet
  rwa [Measure.restrict_eq_self_of_ae_mem t0590] at h

