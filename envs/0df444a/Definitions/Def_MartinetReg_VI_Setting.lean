-- title:
--   §2.1–§2.2: monotone and hemicontinuous T : H → H′ on C, the variational inequality (1), its solution set M and the regularization step (2)
-- statement:
--   This file fixes the objects of §2.1–§2.2 of Martinet's note.
--
--   Let $H$ be a real Hilbert space with inner product $\langle\cdot,\cdot\rangle$ and norm $\|\cdot\|$, let $H'$ be its (topological) dual, and write $(\varphi, y)$ for the value of $\varphi\in H'$ at $y\in H$. Let $T : H\to H'$ and let $C\subseteq H$.
--
--   1. **Monotone on $C$.** $T$ is monotone on $C$ if $(Tx - Ty,\, x - y)\ge 0$ for all $x,y\in C$.
--   2. **Hemicontinuous on $C$.** $T$ is hemicontinuous on $C$ if for all $x,y\in C$ the map $t\mapsto T((1-t)x+ty)$, $t\in[0,1]$, is continuous into $H'$ with its weak topology; that is, for every $z\in H$ the real function $t\mapsto (T((1-t)x+ty), z)$ is continuous on $[0,1]$.
--   3. **Standing hypotheses of §2.1.** $C$ is convex, closed and bounded, and $T$ is monotone and hemicontinuous on $C$.
--   4. **The variational inequality (1) and its solution set $M$.** $M$ is the set of $\bar x\in C$ such that
--   $$
--   (T\bar x,\, x-\bar x)\ge 0\qquad\forall x\in C .
--   $$
--   5. **The regularization step (2).** Given $x^n$, a point $y\in C$ is a regularized successor of $x^n$ if
--   $$
--   (Ty,\, x-y)+\langle y-x^n,\, x-y\rangle\ge 0\qquad\forall x\in C .
--   $$
--   6. **Regularized sequences.** A sequence $(x^n)_{n\ge0}$ is generated by the algorithm of §2.2 if $x^0\in C$ and, for every $n$, $x^{n+1}$ is a regularized successor of $x^n$ (so $x^n\in C$ for all $n$).
--   7. **Weak cluster point.** $\tilde x\in H$ is a weak cluster point (*valeur d'adhérence faible*) of $(x^n)$ if it is a cluster point of the sequence in the weak topology of $H$: every weak neighbourhood of $\tilde x$ contains $x^n$ for infinitely many $n$.
--
--   These are the objects on which Martinet's Théorème 1 and its lemmas are stated: the regularized iteration (2) is the original form of the proximal point algorithm for a monotone variational inequality.
--
--   **Formalization Note.** $H$ is a real Hilbert space (`InnerProductSpace ℝ H`, `CompleteSpace H`); the paper only says "espace de Hilbert", and its inequalities force real scalars. $H'$ is `StrongDual ℝ H`, and the duality $(\varphi,y)$ is function application `φ y`; $T$ is not identified with a map $H\to H$. The paper puts the weak topology $\sigma(H',H'')$ on $H'$; since $H$ is reflexive this is the weak-* topology, whose continuity is tested against each $z\in H$, which is how hemicontinuity is encoded. The algorithm is a relation (`IsRegSeq`): any sequence satisfying (2) at every step qualifies; existence and uniqueness of the step are a separate statement of the mission. The initial point $x^0\in C$ is part of the sequence predicate. Weak cluster points are `MapClusterPt` in `WeakSpace ℝ H`, not limits of weakly convergent subsequences (the two agree for bounded sequences).
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 155, §2.1–§2.2 (displays (1), (2))

import Mathlib

namespace MartinetReg.VI

open Filter Topology

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- §2.1: `T` is monotone on `C`: `(Tx − Ty, x − y) ≥ 0` for all `x, y ∈ C`. -/
def MonotoneOnSet (T : H → StrongDual ℝ H) (C : Set H) : Prop :=
  ∀ x ∈ C, ∀ y ∈ C, 0 ≤ (T x - T y) (x - y)

/-- §2.1: `T` is hemicontinuous on `C`: for `x, y ∈ C` the map `t ↦ T((1 − t)x + ty)`,
`t ∈ [0, 1]`, is continuous into `H′` with its weak(-*) topology, i.e. for every `z ∈ H`
the real function `t ↦ (T((1 − t)x + ty), z)` is continuous on `[0, 1]`. -/
def HemicontinuousOn (T : H → StrongDual ℝ H) (C : Set H) : Prop :=
  ∀ x ∈ C, ∀ y ∈ C, ∀ z : H,
    ContinuousOn (fun t : ℝ => T ((1 - t) • x + t • y) z) (Set.Icc 0 1)

/-- The standing hypotheses of §2.1: `C` convex, closed and bounded; `T` monotone and
hemicontinuous on `C`. -/
structure Standing (T : H → StrongDual ℝ H) (C : Set H) : Prop where
  convex : Convex ℝ C
  closed : IsClosed C
  bounded : Bornology.IsBounded C
  mono : MonotoneOnSet T C
  hemi : HemicontinuousOn T C

/-- `M`, the set of solutions of the variational inequality (1):
`x̄ ∈ C` with `(Tx̄, x − x̄) ≥ 0` for all `x ∈ C`. -/
def solSet (T : H → StrongDual ℝ H) (C : Set H) : Set H :=
  {xbar | xbar ∈ C ∧ ∀ x ∈ C, 0 ≤ T xbar (x - xbar)}

/-- (2): `y ∈ C` is a regularized successor of `xn`:
`(Ty, x − y) + ⟨y − xn, x − y⟩ ≥ 0` for all `x ∈ C`. -/
def IsRegStep (T : H → StrongDual ℝ H) (C : Set H) (xn y : H) : Prop :=
  y ∈ C ∧ ∀ x ∈ C, 0 ≤ T y (x - y) + inner ℝ (y - xn) (x - y)

/-- A sequence `{xⁿ} ⊂ C` generated by the algorithm of §2.2: `x⁰ ∈ C` and every
`xⁿ⁺¹` satisfies (2) with respect to `xⁿ`. -/
def IsRegSeq (T : H → StrongDual ℝ H) (C : Set H) (x : ℕ → H) : Prop :=
  x 0 ∈ C ∧ ∀ n, IsRegStep T C (x n) (x (n + 1))

/-- `xt` is a weak cluster point ("valeur d'adhérence faible") of the sequence `x`:
a cluster point of `n ↦ x n` in the weak topology of `H`. -/
def IsWeakClusterPt (xt : H) (x : ℕ → H) : Prop :=
  MapClusterPt (toWeakSpace ℝ H xt) atTop (fun n => toWeakSpace ℝ H (x n))

end MartinetReg.VI


