    (gu065.lfin : ℝ) ≤ (S : ℝ) * logProd gu065.top ∧
      (∀ x : ℝ, (gu061.lo : ℝ) < x → x ≤ (gu065.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u061 hγ hstate
  have s1 := sol_u062 hγ (by simpa [gu061, gu062] using s0.1)
  have s2 := sol_u063 hγ (by simpa [gu062, gu063] using s1.1)
  have s3 := sol_u064 hγ (by simpa [gu063, gu064] using s2.1)
  have s4 := sol_u065 hγ (by simpa [gu064, gu065] using s3.1)
  refine ⟨s4.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu061.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu062.lo : ℝ) < x := by
        have hb : (gu061.top : ℝ) = (gu062.lo : ℝ) := by simp [gu061, gu062]
        linarith
    by_cases h1 : x ≤ (gu062.top : ℝ)
    · exact s1.2 x hx1 h1
    · have hx2 : (gu063.lo : ℝ) < x := by
          have hb : (gu062.top : ℝ) = (gu063.lo : ℝ) := by simp [gu062, gu063]
          linarith
      by_cases h2 : x ≤ (gu063.top : ℝ)
      · exact s2.2 x hx2 h2
      · have hx3 : (gu064.lo : ℝ) < x := by
            have hb : (gu063.top : ℝ) = (gu064.lo : ℝ) := by simp [gu063, gu064]
            linarith
        by_cases h3 : x ≤ (gu064.top : ℝ)
        · exact s3.2 x hx3 h3
        · have hx4 : (gu065.lo : ℝ) < x := by
              have hb : (gu064.top : ℝ) = (gu065.lo : ℝ) := by simp [gu064, gu065]
              linarith
          exact s4.2 x hx4 htop

theorem solution (hγ : Real.eulerMascheroniConstant < (RosserLower.gammaUpS : ℝ) / (RosserLower.S : ℝ))
    (hstate : (3428432446423729 : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd 32888396) :
    (3433232788381885 : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd 35748293 ∧
      (∀ x : ℝ, (32888396 : ℝ) < x → x ≤ (35748293 : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < RosserProductCertificate.eulerProduct ⌊x⌋₊) := by
  have hs : (gu061.lin : ℝ) ≤ (RosserLower.S : ℝ) * RosserLower.logProd gu061.lo := by
    simpa only [gu061, Nat.cast_ofNat] using hstate
  simpa only [gu061, gu065, Nat.cast_ofNat] using child13_solution hγ hs
