variable {R₁ R₂ : Type u} [CommRing R₁] [CommRing R₂] (ψ : R₁ →+* R₂)
  {A₁ : Scheme.{u}} {f₁ : A₁ ⟶ Spec (CommRingCat.of R₁)} (L₁ : RelativeGroupLaw R₁ f₁) (hc₁ : L₁.IsCommutative)
  {A₂ : Scheme.{u}} {f₂ : A₂ ⟶ Spec (CommRingCat.of R₂)} (L₂ : RelativeGroupLaw R₂ f₂) (hc₂ : L₂.IsCommutative)
