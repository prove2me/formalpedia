-- title:
--   Proposition 7 — constant stepsize $\alpha$, randomized order: a.s. $\inf_k F(x_k)=F^*$ if $F^*=-\infty$, else $\le F^*+\alpha\beta mc^2/2$, $\beta=5$
-- statement:
--   Let $x_k$ be generated by one of the randomized incremental methods (42)–(44) for problem (5)–(6) ($X$ nonempty closed convex, $f_i,h_i$ convex), with the stepsize fixed at a positive constant $\alpha$, under Assumption 3 (for (42), (43)) or Assumption 4 (for (44)) with constant $c$.
--   1. If $F^*=-\infty$, then with probability 1
--   $$\inf_{k\ge0}F(x_k)=F^*.$$
--   2. If $F^*>-\infty$, then with probability 1
--   $$\inf_{k\ge0}F(x_k)\le F^*+\frac{\alpha\beta mc^2}{2},\qquad\beta=5.$$
--
--   Compared with the cyclic order (Proposition 4(b)), the error bound is smaller by a factor of $m$.
--
--   **Formalization Note** $F^*$ and the infimum are taken in the extended reals (`EReal`), so the case $F^*=-\infty$ is represented exactly. The setting hypotheses are those of the definition file: $\omega_k$ is independent of the $\sigma$-algebra generated by the past history, the would-be step at $k$ is measurable with respect to it, the iterates are measurable, and $x_0$ is a fixed vector. Components are indexed $0,\dots,m-1$.
-- source:
--   Bertsekas, Incremental Proximal Methods for Large Scale Convex Optimization, LIDS-P-2847 (rev. March 2011), p. 16, Proposition 7

import Mathlib
import Definitions.Def_IncProx_Randomized_Basic

namespace IncProx.Randomized

open Filter Topology MeasureTheory

/-- Proposition 7 (p. 16): for the randomized methods (42)–(44) with constant stepsize α > 0,
(a) if F* = −∞ then with probability 1 inf_{k≥0} F(x_k) = F*;
(b) if F* > −∞ then with probability 1 inf_{k≥0} F(x_k) ≤ F* + αβmc²/2, with β = 5. -/
theorem proposition7 {Ω : Type*} [MeasurableSpace Ω] {n m : ℕ} [NeZero m]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (P : Problem n m) (hP : P.Standing) (A : Alg)
    (α : ℝ) (hα : 0 < α) (ω : ℕ → Ω → Fin m) (x : ℕ → Ω → Vec n)
    (zc gFc gHc xc : ℕ → Fin m → Ω → Vec n) (x₀ : Vec n) (c : ℝ)
    (hR : RandHyp μ P A (fun _ => α) ω x zc gFc gHc xc x₀ c) :
    (P.Fstar = ⊥ → ∀ᵐ s ∂μ, ⨅ k, ((P.F (x k s) : ℝ) : EReal) = P.Fstar) ∧
      (P.Fstar ≠ ⊥ → ∀ᵐ s ∂μ,
        ⨅ k, ((P.F (x k s) : ℝ) : EReal) ≤ P.Fstar + ((α * 5 * m * c ^ 2 / 2 : ℝ) : EReal)) := by sorry

end IncProx.Randomized
