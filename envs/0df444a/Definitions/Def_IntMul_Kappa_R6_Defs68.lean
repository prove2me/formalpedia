section
-- Source module: Solutions.J6SegILPre5
/-!
# B-line IL, pre-tables (B5), part 5: the fixed-point expressions

Register conventions (all in `rg`): `20 = P`, `21 = R`, `22 = s`, `23 = t`, `24 = λ`, `25 = α`,
`9 = 2^P`, `10 = 2^{P+1}`; `1 = c` (block start), `2 = n` (block length); work `4 = Γ`, `5 = ±1`,
`11 = X`, `12 = U` (loop index).

* `fmE x y` evaluates to `fmul P x y`, `fdE x y` to `fdiv P x y`;
* `jDE` (`α²(t-s)U²`), `jQE` (`2α²t(U+1)`), `jME`/`jPE` (`α²(t ∓ 2β_c)⁺U`) the exponent arguments
  of the tables of `mkTables` (`J6SegTab`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- `max x 0`. -/
def mx0 (x : Ex HS) : Ex HS := .sel x (.lit 0) x

/-- `fmul P x y` (`2^P` on `9`, `2^{P+1}` on `10`). -/
def fmE (x y : Ex HS) : Ex HS :=
  NLogN.Ex.ediv (.add (.mul (.lit 2) (.mul x y)) (.reg 9)) (.reg 10)

/-- `fdiv P x y`. -/
def fdE (x y : Ex HS) : Ex HS :=
  NLogN.Ex.ediv (.add (.mul (.lit 2) (.mul x (.reg 9))) y) (.mul (.lit 2) y)

/-- `α²(t-s)⁺ U²`. -/
def jDE : Ex HS :=
  .mul (.mul (.mul (.reg 25) (.reg 25)) (mx0 (.add (.reg 23) (.neg (.reg 22)))))
    (.mul (.reg 12) (.reg 12))

/-- `2 α² t (U+1)`. -/
def jQE : Ex HS :=
  .mul (.mul (.lit 2) (.mul (.reg 25) (.reg 25))) (.mul (.reg 23) (.add (.reg 12) (.lit 1)))

/-- `bOf s t c` with `c` on `1`. -/
def bOE : Ex HS :=
  .add (.mul (.reg 23) (.reg 1)) (.neg (.mul (.reg 22)
    (NLogN.Ex.ediv (.add (.mul (.lit 2) (.mul (.reg 23) (.reg 1))) (.reg 22))
      (.mul (.lit 2) (.reg 22)))))

/-- `α² (t - 2β_c)⁺ U`. -/
def jME : Ex HS :=
  .mul (.mul (.reg 25) (.reg 25)) (.mul (mx0 (.add (.reg 23) (.neg (.mul (.lit 2) bOE)))) (.reg 12))

/-- `α² (t + 2β_c)⁺ U`. -/
def jPE : Ex HS :=
  .mul (.mul (.reg 25) (.reg 25)) (.mul (mx0 (.add (.reg 23) (.mul (.lit 2) bOE))) (.reg 12))

/-! ## Evaluation -/

/-! ## Side conditions -/

/-- Expressions whose `ok` only needs integer registers. -/
def Safe : Ex HS → Bool
  | .reg _ | .lit _ => true
  | .add a b | .mul a b => Safe a && Safe b
  | .neg a => Safe a
  | .sel c x y => Safe c && Safe x && Safe y
  | _ => false

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre6
/-!
# B-line IL, pre-tables (B5), part 6: the call loop

`cLoop O cl` = `U := 0; repeat N = v 24 times { cl; push X on O; U := U + 1 }` where the call `cl`
sets `X = v 11 := f U`. `cLoop_sp`: it pushes `f 0, …, f (N-1)` onto `O` (so `O` gains `rv f N`);
the registers end as `wS v f N` (only `11, 12` change).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The loop counter of the table loops. -/
abbrev Cu : Fin HS := 52

/-- The body: call, push, step. -/
def cBody (O : Fin HS) (cl : RS) : RS :=
  .seq cl (.seq (.push O (.reg 11)) (.asg 12 (.add (.reg 12) (.lit 1))))

/-- The call loop over `U < v r`. -/
def cLoopR (O : Fin HS) (cl : RS) (r : Fin HS) : RS :=
  .seq (.asg 12 (.lit 0)) (.rep Cu (.reg r) (cBody O cl))

/-- The call loop over `U < v 24` (`λ`). -/
def cLoop (O : Fin HS) (cl : RS) : RS := cLoopR O cl 24

/-- The registers after `k` steps. -/
def wS (v : Fin HS → ℤ) (f : ℕ → ℤ) : ℕ → Fin HS → ℤ
  | 0 => Function.update v 12 0
  | k + 1 => Function.update (Function.update (wS v f k) 11 (f k)) 12 (k + 1)

/-- All registers bounded by `2^A`. -/
def VB (v : Fin HS → ℤ) (A : ℕ) : Prop := ∀ j ∈ rg, |v j| ≤ 2 ^ A

/-- Uniform width of the pre-table expressions. -/
def BW (A : ℕ) : ℕ := A * 40 + 1

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre7
/-!
# B-line IL, pre-tables (B5), part 7: the stage tables `di`, `dd`

`stDI O` / `stDD O` push `(mkTables P R s t α).di u` / `.dd u` for `u = 0, …, λ-1` onto `O`
(so `O` gains `(diL …).reverse` / `(ddL …).reverse`, the layout of `tabK`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The `di` call. -/
def clDI : RS := enC 11 (.reg 20) (.reg 22) jDE
/-- The `dd` call. -/
def clDD : RS := epC 11 (.add (.reg 20) (.reg 21)) (.reg 22) jDE (.reg 21)

def stDI (O : Fin HS) : RS := cLoop O clDI
def stDD (O : Fin HS) : RS := cLoop O clDD

/-- The register assumptions of the stage loops. -/
structure StIn (v : Fin HS → ℤ) (P R sN tN lam aN A : ℕ) : Prop where
  vb : VB v A
  h20 : v 20 = P
  h21 : v 21 = R
  h22 : v 22 = sN
  h23 : v 23 = tN
  h24 : v 24 = lam
  h25 : v 25 = aN
  lam : lam ≤ 2 ^ A
  A2 : 2 ≤ A

/-- Cost of a stage loop with call cost `Cc`. -/
def cSt (A N Cc : ℕ) : ℕ :=
  cE (.lit 0) (BW A) + (2 * 2000 * (BW A + 2) + N * (Cc + cE (.reg 11) (BW A) +
    cE (.add (.reg 12) (.lit 1)) (BW A) + 8000 * (BW A + 2) + 30) + 32)

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre8
/-!
# B-line IL, pre-tables (B5), part 8: the stage tables `gam`, `gi`

`stG O eF = Γ := 2^P; loop U < λ { q := expNeg P s (2α²t(U+1)); X := eF(Γ); Γ := fmul P Γ (2^P - q⁺);
push X; U++ }`: with `eF = Γ` (`stGam`) it pushes `gamI 0 … gamI (λ-1)`, with `eF = fdiv P 2^P Γ`
(`stGi`) the values `giI u`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The `Γ` update. -/
def gUpE : Ex HS := fmE (.reg 4) (.add (.reg 9) (.neg (mx0 (.reg 5))))

/-- The call of the `Γ` loops. -/
def clG (eF : Ex HS) : RS := .seq (enC 5 (.reg 20) (.reg 22) jQE) (.seq (.asg 11 eF) (.asg 4 gUpE))

def stG (O : Fin HS) (eF : Ex HS) : RS := .seq (.asg 4 (.reg 9)) (cLoop O (clG eF))

/-- `gi` expression. -/
def giE : Ex HS := fdE (.reg 9) (.reg 4)

def stGam (O : Fin HS) : RS := stG O (.reg 4)
def stGi (O : Fin HS) : RS := stG O giE

/-- The registers of the `Γ` loops. -/
def gS (v : Fin HS → ℤ) (q F G : ℕ → ℤ) : ℕ → Fin HS → ℤ
  | 0 => Function.update v 12 0
  | k + 1 => Function.update (Function.update (Function.update (Function.update (gS v q F G k) 5 (q k))
      11 (F k)) 4 (G (k + 1))) 12 (k + 1)

/-- After the call of step `k`. -/
def gS' (v : Fin HS → ℤ) (q F G : ℕ → ℤ) (k : ℕ) : Fin HS → ℤ :=
  Function.update (Function.update (Function.update (gS v q F G k) 5 (q k)) 11 (F k)) 4 (G (k + 1))

/-- The registers of the `Γ` loops need `2^P`, `2^{P+1}` on `9`, `10`. -/
structure StIn2 (v : Fin HS → ℤ) (P R sN tN lam aN A : ℕ) extends StIn v P R sN tN lam aN A : Prop where
  h9 : v 9 = 2 ^ P
  h10 : v 10 = 2 ^ (P + 1)

/-- Cost of a `Γ` loop. -/
def cStG (A lam : ℕ) (eF : Ex HS) : ℕ :=
  cE (.reg 9) (BW A) + cSt A lam (cCall (.reg 20) (.reg 22) jQE (.lit 0) (BW A)
    (expNegCost (BW A) (BW A) (BW A)) + cE eF (BW A) + cE gUpE (BW A))

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre10
/-!
# B-line IL, pre-tables (B5), part 10: the block-length scan

`scan Cs`: with the block start `st` on `1`, sets `2 := 1 + enF s t λ st` (the block length) and
`5 := 1`, by `λ` rounds (counter `Cs`) of `if flag = 0 then (if g(st + n) > 0 then n++ else flag := 1)`,
where `g(j) = (j mod λ)·[b_j - b_{j-1} = t - s]·[j < s]` is positive iff `j` is not a cut
(`gV_spec`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

def zI (D : ℤ) : ℤ := if D < 0 then 0 else if -D < 0 then 0 else 1

def gV (s t lam : ℕ) (x : ℤ) : ℤ :=
  x % (lam : ℤ) * zI (bOf s t x + -bOf s t (x + -1) + -((t : ℤ) + -(s : ℤ))) *
    (if x + -(s : ℤ) < 0 then 1 else 0)

/-- `bOf s t l` for an expression `l`. -/
def bOX (l : Ex HS) : Ex HS :=
  .add (.mul (.reg 23) l) (.neg (.mul (.reg 22)
    (NLogN.Ex.ediv (.add (.mul (.lit 2) (.mul (.reg 23) l)) (.reg 22)) (.mul (.lit 2) (.reg 22)))))

def jE : Ex HS := .add (.reg 1) (.reg 2)

def dE : Ex HS :=
  .add (.add (bOX jE) (.neg (bOX (.add jE (.lit (-1)))))) (.neg (.add (.reg 23) (.neg (.reg 22))))

/-- The continuation indicator. -/
def gE : Ex HS :=
  .mul (.mul (NLogN.Ex.emod jE (.reg 24)) (.sel dE (.lit 0) (.sel (.neg dE) (.lit 0) (.lit 1))))
    (.sel (.add jE (.neg (.reg 22))) (.lit 1) (.lit 0))

/-! ## Conditionals on the register file -/

/-! ## The scan -/

def fE : Ex HS := .add (.reg 5) (.lit (-1))

def scB : RS := .ite fE (.ite (.neg gE) (.asg 2 (.add (.reg 2) (.lit 1))) (.asg 5 (.lit 1))) .skip

def scan (Cs : Fin HS) : RS := .seq (.asg 2 (.lit 1)) (.seq (.asg 5 (.lit 0)) (.rep Cs (.reg 24) scB))

/-- Cost of one scan round. -/
def cScB (A : ℕ) : ℕ :=
  cE fE (BW A) + (2 * BW A + 2) + 25 + (cE (.neg gE) (BW A) + (2 * BW A + 2) + 25 +
    (cE (.add (.reg 2) (.lit 1)) (BW A) + cE (.lit 1) (BW A) + 1))

def cScan (A lam : ℕ) : ℕ :=
  cE (.lit 1) (BW A) + cE (.lit 0) (BW A) +
    ((Ex.reg (S := HS) 24).size + 1) * 2000 * (BW A + 2) + lam * (cScB A + 8000 * (BW A + 2) + 30) + 32

/-- The scan registers after `i` rounds. -/
def scS (v : Fin HS → ℤ) (e i : ℕ) : Fin HS → ℤ :=
  Function.update (Function.update v 2 ((1 + min i e : ℕ) : ℤ)) 5 (if e < i then 1 else 0)

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre11
/-!
# B-line IL, pre-tables (B5), part 11: block headers and clearing the work registers

* `hdrP K` pushes `blkHdr n pk b` (in reading order, i.e. `K` gains its reverse) for `n` on `2`,
  `pk` on `26`, `b` on `28`, at width `BH M = 8(M+3)²` (`n, pk, b ≤ M`);
* `clr` zeroes the work registers `2, 3, 4, 5, 11, 12` (`zr v`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## The header -/

def hE1 : Ex HS := .reg 2
def hE2 : Ex HS := .add (.reg 2) (.reg 2)

/-! ## Clearing the work registers -/

def clr : RS :=
  .seq (.asg 2 (.lit 0)) (.seq (.asg 3 (.lit 0)) (.seq (.asg 4 (.lit 0)) (.seq (.asg 5 (.lit 0))
    (.seq (.asg 11 (.lit 0)) (.asg 12 (.lit 0))))))

/-- The registers with the work registers zeroed. -/
def zr (v : Fin HS → ℤ) : Fin HS → ℤ := fun j =>
  if j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 11 ∨ j = 12 then 0 else v j

/-- Work registers. -/
def Wk (j : Fin HS) : Prop := j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 11 ∨ j = 12

def cClr (A : ℕ) : ℕ := 6 * cE (.lit 0) (BW A)

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre9
/-!
# B-line IL, pre-tables (B5), part 9: the block tables `am`, `ap`

`stA O eJ = Γ := 2^P; S := 1; loop U < n { X := expNeg P s (eJ); X := S·fmul P X (fdiv P 2^P Γ);
S := -S; q := expNeg P s (2α²t(U+1)); Γ := fmul P Γ (2^P - q⁺); push X; U++ }` (count on `2`).
With `eJ = jME` (`amP`) it pushes `(mkTables …).am c 0, …, am c (n-1)` (block start `c` on `1`),
with `eJ = jPE` (`apP`) the `ap c h`. Clobbers `3, 4, 5, 11, 12`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The uniform cost of an `expNeg` call into a register. -/
def cEN (A : ℕ) (eJ : Ex HS) : ℕ :=
  cCall (.reg 20) (.reg 22) eJ (.lit 0) (BW A) (expNegCost (BW A) (BW A) (BW A))

/-- The pushed value of the block tables. -/
def aVE : Ex HS := .mul (.reg 3) (fmE (.reg 11) giE)

/-- One step of the block-table loop. -/
def clA (eJ : Ex HS) : RS :=
  .seq (enC 11 (.reg 20) (.reg 22) eJ) (.seq (.asg 11 aVE) (.seq (.asg 3 (.neg (.reg 3)))
    (.seq (enC 5 (.reg 20) (.reg 22) jQE) (.asg 4 gUpE))))

/-- The block-table loop, `n` on `2`. -/
def stA (O : Fin HS) (eJ : Ex HS) : RS :=
  .seq (.asg 4 (.reg 9)) (.seq (.asg 3 (.lit 1)) (cLoopR O (clA eJ) 2))

def amP (O : Fin HS) : RS := stA O jME
def apP (O : Fin HS) : RS := stA O jPE

/-- Cost of one step. -/
def cClA (A : ℕ) (eJ : Ex HS) : ℕ :=
  cEN A eJ + cE aVE (BW A) + cE (.neg (.reg 3)) (BW A) + cEN A jQE + cE gUpE (BW A)

/-- The registers of the block-table loop. -/
def aS (v : Fin HS → ℤ) (q F G S : ℕ → ℤ) : ℕ → Fin HS → ℤ
  | 0 => Function.update v 12 0
  | k + 1 => Function.update (Function.update (Function.update (Function.update (Function.update
      (aS v q F G S k) 11 (F k)) 3 (S (k + 1))) 5 (q k)) 4 (G (k + 1))) 12 (k + 1)

/-- After the body of step `k`. -/
def aS' (v : Fin HS → ℤ) (q F G S : ℕ → ℤ) (k : ℕ) : Fin HS → ℤ :=
  Function.update (Function.update (Function.update (Function.update
      (aS v q F G S k) 11 (F k)) 3 (S (k + 1))) 5 (q k)) 4 (G (k + 1))

/-- Cost of a block-table loop. -/
def cStA (A lam : ℕ) (eJ : Ex HS) : ℕ :=
  cE (.reg 9) (BW A) + cE (.lit 1) (BW A) + cSt A lam (cClA A eJ)

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre12
/-!
# B-line IL, pre-tables (B5), part 12: one block

`blkB K Cs`: for the block starting at `st` (on `1`): scan its length `n = 1 + enF st` (`2`),
push its descriptor `encD pk b (n, am_st, ap_st)` in reading order onto the scratch stack `K`,
advance `1 += n`, count `7 += 1` (blocks) and `8 += n` (entries), and zero the work registers.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- Bounds of all table values (and of the `expNeg` intermediates) by `2^A`. -/
structure TabB (P R sN tN aN lam A : ℕ) : Prop where
  en : ∀ j, |expNeg P sN j| ≤ 2 ^ A
  di : ∀ k < lam, |(mkTables P R sN tN aN).di k| ≤ 2 ^ A
  dd : ∀ k < lam, |(mkTables P R sN tN aN).dd k| ≤ 2 ^ A
  gam : ∀ k ≤ lam, |gamI P sN tN aN k| ≤ 2 ^ A
  gi : ∀ k < lam, |giI P sN tN aN k| ≤ 2 ^ A
  am : ∀ c, ∀ k < lam, |(mkTables P R sN tN aN).am c k| ≤ 2 ^ A
  ap : ∀ c, ∀ k < lam, |(mkTables P R sN tN aN).ap c k| ≤ 2 ^ A

def e7 : Ex HS := .add (.reg 7) (.lit 1)
def e8 : Ex HS := .add (.reg 8) (.reg 2)
def e1 : Ex HS := .add (.reg 1) (.reg 2)

/-- The descriptor of the block starting at `st`. -/
def dscOf (P R sN tN lam aN st : ℕ) : ℕ × List ℤ × List ℤ :=
  (1 + J6Seg.enF sN tN lam st,
    (List.range (1 + J6Seg.enF sN tN lam st)).map ((mkTables P R sN tN aN).am st),
    (List.range (1 + J6Seg.enF sN tN lam st)).map ((mkTables P R sN tN aN).ap st))

end J6Seg.PreT

end

