/-!
# The exact physical band-owner record order

There is one four-cell record for every owner-table cell, in BC, AB, AC
rectangle order. A zero flag is a lookup miss. Successful records retain
their physical owner slot even when several owners produce the same triple.
-/

namespace ThreeSum.BandCandidateRows

open BandEnumeration

set_option maxHeartbeats 1400000
set_option maxRecDepth 7000



















































theorem rect_length (m n : ℕ) (F : ℕ → ℕ → Record) : (rect m n F).length=m*n := by
  simp [rect,List.length_flatMap]

theorem records_length (A B C : Family) :
    (records A B C).length=LightBandEnumeration.count A.size B.size C.size := by
  simp only [records,List.length_append,rect_length,LightBandEnumeration.count]
  omega

theorem cells_length (rs : List Record) : (cells rs).length=4*rs.length := by
  induction rs with
  | nil => simp [cells]
  | cons r rs ih => simp only [cells,List.flatMap_cons,List.length_append,Record.cells,
      List.length_cons,List.length_nil] at *; omega












































































































































end ThreeSum.BandCandidateRows

end

section


/-! # List and memory interfaces for the exact candidate record array -/

namespace ThreeSum.BandCandidateRows

open Light BandEnumeration

set_option maxHeartbeats 1300000















theorem records_sound {A B C : Family} {r : Record}
    (hr : r ∈ records A B C) (hf : r.flag=1) :
    r.a < A.size ∧ r.b < B.size ∧ r.c < C.size ∧
      Bands.Relevant A.lower A.upper B.lower B.upper C.lower C.upper (r.a,r.b,r.c) := by
  obtain ⟨o,rfl⟩ := mem_records_owner hr
  exact fromOwner_sound A B C o hf






theorem getD_sound {A B C : Family} {s : ℕ} (hs : s < (records A B C).length)
    (hf : ((records A B C).getD s default).flag=1) :
    let r := (records A B C).getD s default
    r.a < A.size ∧ r.b < B.size ∧ r.c < C.size ∧
      Bands.Relevant A.lower A.upper B.lower B.upper C.lower C.upper (r.a,r.b,r.c) := by
  apply records_sound _ hf
  rw [List.getD_eq_getElem _ _ hs]
  exact List.getElem_mem hs














































end ThreeSum.BandCandidateRows

end

section


/-!
# Problems, solvers, and the interpretation of "is solved in time T" in the light language

A *task* is a problem together with a calling convention: which arguments a procedure gets, what the
memory holds when it is called, and what the result and the memory have to be when it returns.
`Solves task P p T need` says that procedure number `p` of the program `P` solves the task within
`T` steps, if the limits of the run allow for `need`.  A reduction of the paper is a *host*: a
procedure that calls an arbitrary solver of another task.

Conventions.

* A solver gets sizes, a bound `U` on the absolute values of the numbers, the addresses of its
  arrays, and as last argument the free pointer `fr`.  All inputs and outputs lie below `fr`.  The
  solver may write its output segments and any cell from `fr` on, and no other cell.  Nothing is
  assumed about the cells from `fr` on, so a solver can be called again and again.
* A solver has to be correct for every valid bound `U` that it is given.
* A solver is a pair of a program and a procedure number.  What is proved about it holds for every
  program that begins with this program, so a host appends its own procedures.

A `Task` is a problem whose time and need depend on a size and a bound.  `TaskN` and `SolvesN` are
the same notions with a list of parameters.
-/

@[expose] public section

namespace Light

open ThreeSumApsp

/-! ## Limits -/






























/-! ## Specifications of single routines -/

/-- A list below fr stays where it is if nothing below fr changes. -/
theorem Seg.of_kept {μ μ' : ℕ → ℤ} {a fr : ℕ} {l : List ℤ} (h : Seg μ a l) (hk : Kept μ μ' fr)
    (hle : a + l.length ≤ fr) : Seg μ' a l :=
  h.of_sameOn hk fun i hi => show a + i < fr by omega

/-! ## Tasks and solvers -/
























































































/-! ## Hosts -/






















/-! ## Tasks with a list of parameters -/














































end Light

end
end

section


/-!
# The actual flattened A-incidence catalog

The loop reads each four-cell owner record once. Successful records append
only their actual truncated A band. Parallel value, owner-slot, and sorted
position arrays are packed using capacity g times the owner count.
-/

namespace ThreeSum.LightBandRawA

open Light BandCandidateRows BandRawA

set_option maxHeartbeats 2200000
set_option maxRecDepth 8000







































variable {lim : Limits} {P : Program} {d : ℕ} {μ : ℕ → ℤ}
    {records src n g vals : ℕ} {rs : List Record} {f : ℕ → ℤ}































































































































/-- The physical candidate list supplies every successful A-index validity
fact required by the actual incidence loop. -/
theorem Procs.meets_candidates {pMain : ℕ} (S : Procs P pMain)
    (A B C : BandEnumeration.Family) (hA : A.size=BandPartition.size n g)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+2 < lim.depth) (hg : 0 < g)
    (hrecords : records+4*(BandCandidateRows.records A B C).length ≤ vals)
    (hsrc : src+n ≤ vals)
    (hspace : space vals (BandCandidateRows.records A B C).length g ≤ lim.space)
    (hword : (word n g (BandCandidateRows.records A B C).length : ℤ) ≤ lim.word)
    (hrecordRead : Seg μ records (cells (BandCandidateRows.records A B C)))
    (hread : ∀ j < n, μ (src+j)=f j) :
    Meets lim P pMain d [records,(BandCandidateRows.records A B C).length,src,n,g,vals]
      μ (time (BandCandidateRows.records A B C).length g)
      (fun r ν => r=((items n g (BandCandidateRows.records A B C)).length : ℤ) ∧
        Stored ν vals (ownerBase vals (BandCandidateRows.records A B C).length g)
          (positionBase vals (BandCandidateRows.records A B C).length g)
          f (items n g (BandCandidateRows.records A B C)) ∧ Kept μ ν vals) := by
  apply S.meets hw hd hg hrecords hsrc hspace hword _ hrecordRead hread
  intro i hi hf
  simpa only [hA] using (getD_sound hi hf).1





end ThreeSum.LightBandRawA

end

section


/-!
# Read the retained headers, build owner records, and extract A incidences

The fixed program reads the actual sorted-A length and all three actual
band counts from the retained headers. It constructs the exact physical
BC, AB, AC records, then copies their flagged A bands into the three packed
value/owner/position arrays. No supplied enumeration or hidden input list
is used by either machine loop.
-/

namespace ThreeSum.LightBandRawACatalog

open Light BandEnumeration BandCandidateRows BandRawA

set_option maxHeartbeats 2100000
set_option maxRecDepth 8000


























variable {lim : Limits} {P : Program} {d : ℕ} {μ : ℕ → ℤ}
    {tables rec src headerA headerB headerC nA nB nC g vals : ℕ} {f : ℕ → ℤ}

theorem Procs.meets_sourceProof {pMain : ℕ} (S : Procs P pMain) (A B C : Family)
    (hA : A.size=BandPartition.size nA g)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+3 < lim.depth) (hg : 0 < g)
    (htable : tables+LightBandEnumeration.count A.size B.size C.size ≤ rec)
    (hsrc : src+nA ≤ rec) (hheadA : headerA+2 ≤ rec)
    (hheadB : headerB+2 ≤ rec) (hheadC : headerC+2 ≤ rec)
    (hrec : rec+4*LightBandEnumeration.count A.size B.size C.size ≤ vals)
    (hspace : space vals A.size B.size C.size g ≤ lim.space)
    (hword : (word nA A.size B.size C.size g : ℤ) ≤ lim.word)
    (hheaderA : LightHeaderBands.At μ headerA nA A)
    (hheaderB : LightHeaderBands.At μ headerB nB B)
    (hheaderC : LightHeaderBands.At μ headerC nC C)
    (htables : LightBandEnumeration.Tables μ tables A B C)
    (hread : ∀ j < nA, μ (src+j)=f j) :
    Meets lim P pMain d [tables,rec,src,headerA,headerB,headerC,g,vals]
      μ (time A.size B.size C.size g)
      (fun r ν => r=((items nA g (records A B C)).length : ℤ) ∧
        Seg ν rec (cells (records A B C)) ∧
        Stored ν vals (LightBandRawA.ownerBase vals (LightBandEnumeration.count A.size B.size C.size) g)
          (LightBandRawA.positionBase vals (LightBandEnumeration.count A.size B.size C.size) g)
          f (items nA g (records A B C)) ∧ Kept μ ν rec) := by
  have hvals : vals ≤ lim.space := by
    unfold space LightBandRawA.space LightBandRawA.positionBase LightBandRawA.ownerBase at hspace
    omega
  have hcandidateSpace : LightBandCandidates.space rec A.size B.size C.size ≤ lim.space := by
    unfold LightBandCandidates.space
    omega
  have hcandidateWord : (LightBandCandidates.word A.size B.size C.size : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr (by unfold word; omega :
      LightBandCandidates.word A.size B.size C.size ≤ word nA A.size B.size C.size g)).trans hword
  have hrawWord : (LightBandRawA.word nA g (LightBandEnumeration.count A.size B.size C.size) : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr (by unfold word; omega :
      LightBandRawA.word nA g (LightBandEnumeration.count A.size B.size C.size) ≤
        word nA A.size B.size C.size g)).trans hword
  have h1Word : (1 : ℤ) ≤ lim.word := by
    have hh : 1 ≤ word nA A.size B.size C.size g := by unfold word; omega
    exact (Int.ofNat_le.mpr hh).trans hword
  have hnRead := hheaderA.1
  have haRead := hheaderA.2.1
  have hbRead := hheaderB.2.1
  have hcRead := hheaderC.2.1
  have haAddr : ((headerA : ℤ)+1).toNat=headerA+1 := by omega
  have hbAddr : ((headerB : ℤ)+1).toNat=headerB+1 := by omega
  have hcAddr : ((headerC : ℤ)+1).toNat=headerC+1 := by omega
  apply Meets.of_body S.main
  unfold body time
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (nA : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                hnRead]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hnRead] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hnRead] <;> omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (A.size : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, haAddr,
                haRead]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [haAddr, haRead] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, haAddr, haRead] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (B.size : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hbAddr,
                hbRead]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hbAddr, hbRead] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hbAddr, hbRead] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (C.size : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hcAddr,
                hcRead]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hcAddr, hcRead] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hcAddr, hcRead] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      |
        refine
          Light.Ends.callToThen
            ((S.candidates.meets (d := d + 1) A B C hw (by omega) htable
                hcandidateSpace hcandidateWord htables)
              _ (by omega))
            ?_ ?_ ?_ ?_
      |
        refine
          Light.Ends.callToThen
            (S.candidates.meets (d := d + 1) A B C hw (by omega) htable
              hcandidateSpace hcandidateWord htables)
            ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, ]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega)));
    (on_goal -1 =>
        ((rintro countResult ν₁ ⟨hcount, hrecords, hkeepCandidates⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  have hsource : ∀ j < nA, ν₁ (src+j)=f j := by
    intro j hj
    rw [hkeepCandidates _ (Or.inl (by omega))]
    exact hread j hj
  have hraw := S.raw.meets_candidates (d := d+1) (records := rec) (src := src)
    (vals := vals) (n := nA) (g := g) (f := f) A B C hA hw (by omega) hg
    (by simpa only [records_length] using hrec) (by omega)
    (by simpa only [records_length,space] using hspace)
    (by simpa only [records_length] using hrawWord) hrecords hsource
  have hraw' : Meets lim P S.pRaw (d+1)
      [rec,LightBandEnumeration.count A.size B.size C.size,src,nA,g,vals] ν₁
      (LightBandRawA.time (LightBandEnumeration.count A.size B.size C.size) g)
      (fun r ν => r=((items nA g (records A B C)).length : ℤ) ∧
        Stored ν vals (LightBandRawA.ownerBase vals (LightBandEnumeration.count A.size B.size C.size) g)
          (LightBandRawA.positionBase vals (LightBandEnumeration.count A.size B.size C.size) g)
          f (items nA g (records A B C)) ∧ Kept ν₁ ν vals) := by
    simpa only [records_length] using hraw
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (hraw' _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen hraw' ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                hcount]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [hcount] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, hcount] <;> omega)));
    (on_goal -1 =>
        ((rintro result ν₂ ⟨hresult, hstored, hkeepRaw⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  refine ⟨hresult,?_,hstored,?_⟩
  · exact hrecords.of_kept hkeepRaw (by simpa only [cells_length,records_length] using hrec)
  · intro addr ha
    change ν₂ addr=μ addr
    rw [hkeepRaw addr (by omega),hkeepCandidates addr (Or.inl ha)]














































end ThreeSum.LightBandRawACatalog

end


theorem solution : ∀ {lim : Light.Limits} {P : Light.Program} {d : Nat} {μ : Nat → Int}
  {tables rec src headerA headerB headerC nA nB nC g vals : Nat} {f : Nat → Int} {pMain : Nat}
  (S : ThreeSum.LightBandRawACatalog.Procs P pMain) (A B C : ThreeSum.BandEnumeration.Family),
  @Eq.{1} Nat A.size (ThreeSum.BandPartition.size nA g) →
    @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt lim.space) lim.word →
      @LT.lt.{0} Nat instLTNat
          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) d
            (@OfNat.ofNat.{0} Nat (nat_lit 3) (instOfNatNat (nat_lit 3))))
          lim.depth →
        @LT.lt.{0} Nat instLTNat (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) g →
          @LE.le.{0} Nat instLENat
              (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) tables
                (ThreeSum.LightBandEnumeration.count A.size B.size C.size))
              rec →
            @LE.le.{0} Nat instLENat (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) src nA) rec →
              @LE.le.{0} Nat instLENat
                  (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) headerA
                    (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                  rec →
                @LE.le.{0} Nat instLENat
                    (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) headerB
                      (@OfNat.ofNat.{0} Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                    rec →
