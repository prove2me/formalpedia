-- title:
--   Proposition 13 — for 0 < λ₋ ≤ λ_k ≤ λ₊ < 2/L, forward-backward satisfies (H1), (H2) with a = 1/λ₊ − L/2, b = 1/λ₋ + L
-- statement:
--   Let $H$ be a real Hilbert space, $g : H \to (-\infty, +\infty]$ proper, lower semicontinuous and convex, and $h : H \to \mathbb R$ convex and differentiable whose gradient is Lipschitz continuous with constant $L \ge 0$. Let $(\lambda_k)$ be stepsizes with
--   $$0 < \lambda^- \le \lambda_k \le \lambda^+ < 2/L \qquad \text{for all } k \in \mathbb N,$$
--   and let $(x_k)$ be generated from an arbitrary $x_0 \in H$ by the forward-backward method (17). Then $(x_k)$ satisfies (H1) and (H2) for $f = g + h$ with
--   $$a = \frac{1}{\lambda^+} - \frac{L}{2} \qquad\text{and}\qquad b = \frac{1}{\lambda^-} + L,$$
--   that is, for every $k \ge 1$, $f(x_k) + a\|x_k - x_{k-1}\|^2 \le f(x_{k-1})$, and there is $\omega_k \in \partial f(x_k)$ with $\|\omega_k\| \le b\|x_k - x_{k-1}\|$.
--
--   The proposition makes the forward-backward method a subgradient descent sequence (once $x_0 \in \operatorname{dom} g$), so that the complexity theory of §4 applies to it, in particular to ISTA.
--
--   **Formalization Note** The condition $\lambda^+ < 2/L$ is written $\lambda^+ L < 2$, which is the same for $L > 0$ and remains meaningful for $L = 0$ (Lean's $2/0 = 0$ would make the hypothesis unsatisfiable). $x_0$ need not lie in $\operatorname{dom} g$; (H1) at $k = 1$ then holds with $+\infty$ on the right. Values are in `EReal`, $f = g + h$ is `g z + (h z : EReal)`, and "smooth" is read as differentiable (the Lipschitz gradient is a separate hypothesis).
-- source:
--   arXiv:1510.08234v3, Proposition 13, p. 15, with Example 2, pp. 14–15, (17), (18)

import Mathlib
import Definitions.Def_MoreauProx_Characterization_GammaZero
import Definitions.Def_ErrBoundCplx_ISTA_DescentSeq
import Definitions.Def_ErrBoundCplx_ISTA_ForwardBackward
open MoreauProx.Characterization

namespace ErrBoundCplx.ISTA

/-- arXiv:1510.08234v3, Proposition 13, p. 15 (with the setting of Example 2, pp. 14–15). Let `H`
be a real Hilbert space, `g : H → (−∞, +∞]` proper lsc convex, `h : H → ℝ` convex and
differentiable with `∇h` Lipschitz with constant `L ≥ 0`. Let `0 < λ₋ ≤ λ_k ≤ λ₊` with
`λ₊ L < 2` for all `k`, and let `(x_k)` be generated by the forward-backward method (17) from an
arbitrary `x₀`. Then (H1) and (H2) hold for `f = g + h` with `a = 1/λ₊ − L/2` and
`b = 1/λ₋ + L`. -/
theorem proposition_13 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
    [CompleteSpace H] (g : H → EReal) (hg : GammaZero g) (h : H → ℝ)
    (hconv : ConvexOn ℝ Set.univ h) (hdiff : Differentiable ℝ h)
    (L : ℝ) (hL : 0 ≤ L) (hLip : ∀ u v : H, ‖gradient h u - gradient h v‖ ≤ L * ‖u - v‖)
    (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hlm : 0 < lamMinus)
    (hlo : ∀ k, lamMinus ≤ lam k) (hhi : ∀ k, lam k ≤ lamPlus) (hLp : lamPlus * L < 2)
    (x : ℕ → H) (hx : IsForwardBackwardSeq g h lam x) :
    SatisfiesH1 (fun z => g z + (h z : EReal)) (1 / lamPlus - L / 2) x ∧
      SatisfiesH2 (fun z => g z + (h z : EReal)) (1 / lamMinus + L) x := by sorry

end ErrBoundCplx.ISTA
