variable {α : Type*} [Fintype α] [DecidableEq α] {s : ℕ}

omit [DecidableEq α] in
theorem OAI.TalagrandThreshold.prod_profile_eq_prod_changes (a z : Coloring α s)
    (F : Color s → Color s → ℝ) :
    (∏ i : Fin s, ∏ h : Color s, F i.castSucc h ^ profile a z i h) =
      ∏ x ∈ changes a z, F (z x) (a x) := by sorry
