namespace IState

@[simp] theorem rn_G (s : IState HS) (i : Fin HS) : (s.rn σ).G (σ i) = s.G i := by
  simp [NLogN.IState.rn]

theorem rn_upd (s : IState HS) (i : Fin HS) (L : List Item) :
    (s.upd i L).rn σ = (s.rn σ).upd (σ i) L := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp only [rn_G', upd_G, Equiv.symm_apply_eq]

@[simp] theorem rn_top (s : IState HS) (i : Fin HS) : (s.rn σ).top (σ i) = s.top i := by
  simp [IState.top]

@[simp] theorem rn_isInt (s : IState HS) (i : Fin HS) : (s.rn σ).IsInt (σ i) ↔ s.IsInt i := by
  simp [IState.IsInt]

@[simp] theorem rn_rn (τ : Equiv.Perm (Fin HS)) (s : IState HS) :
    (s.rn τ).rn σ = s.rn (τ.trans σ) := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp [rn_G', Equiv.symm_trans_apply]

/-- Every state is a relocated state. -/
theorem rn_rn_inv (t : IState HS) : (t.rn σ⁻¹).rn σ = t := by
  refine IState.ext' (fun y => ?_) rfl rfl
  simp [rn_G', Equiv.Perm.inv_def]

end IState

variable {σ}

theorem FixHi.ge_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    m ≤ (σ i).val ↔ m ≤ i.val := by
  constructor
  · intro h
    have h1 : σ (σ i) = σ i := hσ _ (by omega)
    have := σ.injective h1
    rw [this] at h; exact h
  · intro h; rw [hσ i (by omega)]; exact h

theorem FixHi.lt_iff (hσ : FixHi σ) (m : ℕ) (hm : 55 ≤ m) (i : Fin HS) :
    (σ i).val < m ↔ i.val < m := by
  have := hσ.ge_iff m hm i; omega

theorem FixHi.lt56 (hσ : FixHi σ) (i : Fin HS) : (σ i).val < 56 ↔ i.val < 56 := hσ.lt_iff 56 (by omega) i

theorem FixHi.mem_zX (hσ : FixHi σ) (i : Fin HS) : σ i ∈ zX.all ↔ i ∈ zX.all := by
  have key : ∀ j : Fin HS, j ∈ zX.all ↔ 56 ≤ j.val := by
    rw [zX_all]; decide
  rw [key, key]; exact hσ.ge_iff 56 (by omega) i

