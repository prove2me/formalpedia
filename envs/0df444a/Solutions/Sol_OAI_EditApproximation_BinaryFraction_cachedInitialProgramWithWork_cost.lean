theorem initialCenterGuardWithWork_cost (b U B : ℕ) (A : BinaryFraction)
    (hB : 8 ≤ B) (hb : Nat.size b + 2 ≤ B) (hU : Nat.size U + 2 ≤ B) (hA : A.width ≤ B) :
