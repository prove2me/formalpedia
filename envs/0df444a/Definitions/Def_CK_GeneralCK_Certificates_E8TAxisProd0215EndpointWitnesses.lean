    centerALowerYBox.Contains (Y (lower E8TAxisProd0215PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0215PaddedInputs.centerAInput.alpha = ((4590335763975281399345081579386246932603809519 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
