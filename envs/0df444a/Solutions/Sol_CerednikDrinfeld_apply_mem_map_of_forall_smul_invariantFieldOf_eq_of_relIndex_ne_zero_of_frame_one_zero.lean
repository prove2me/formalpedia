theorem finite_stabilizer_of_le {G' X : Type} [Group G'] [MulAction G' X] {H K : Subgroup G'} (hHK : H ≤ K) (x : X)
    (hK : Finite (MulAction.stabilizer (↥K) x)) : Finite (MulAction.stabilizer (↥H) x) := by
  refine Finite.of_injective
    (fun s : MulAction.stabilizer (↥H) x =>
      (⟨⟨((s : ↥H) : G'), hHK (s : ↥H).2⟩, show (⟨((s : ↥H) : G'), hHK (s : ↥H).2⟩ : ↥K) • x = x from s.2⟩ :
        MulAction.stabilizer (↥K) x)) ?_
  intro a b h
  apply Subtype.ext; apply Subtype.ext
  exact congrArg (fun t : MulAction.stabilizer (↥K) x => ((t : ↥K) : G')) h

theorem finite_orbitQuotient_of_relIndex_ne_zero {G' W : Type} [Group G'] [MulAction G' W]
    (H K : Subgroup G') (hHK : H ≤ K) (hidx : H.relIndex K ≠ 0)
    (hK : Finite (MulAction.orbitRel.Quotient (↥K) W)) : Finite (MulAction.orbitRel.Quotient (↥H) W) := by
  classical
  haveI : (H.subgroupOf K).FiniteIndex := ⟨hidx⟩
  haveI : Finite (↥K ⧸ H.subgroupOf K) := Subgroup.finite_quotient_of_finiteIndex
  haveI := hK
  refine Finite.of_surjective
    (fun p : MulAction.orbitRel.Quotient (↥K) W × (↥K ⧸ H.subgroupOf K) =>
      (Quotient.mk (MulAction.orbitRel (↥H) W) ((((p.2.out : ↥K) : G'))⁻¹ • p.1.out) :
        MulAction.orbitRel.Quotient (↥H) W)) ?_
  intro y
  obtain ⟨x, rfl⟩ := @Quotient.exists_rep _ (MulAction.orbitRel (↥H) W) y
  let O : MulAction.orbitRel.Quotient (↥K) W := Quotient.mk (MulAction.orbitRel (↥K) W) x
  have hO : O.out ∈ MulAction.orbit (↥K) x := Quotient.mk_out (s := MulAction.orbitRel (↥K) W) x
  obtain ⟨k, hk⟩ := MulAction.mem_orbit_iff.1 hO
  let c : ↥K ⧸ H.subgroupOf K := QuotientGroup.mk k
  have hc : (c.out)⁻¹ * k ∈ H.subgroupOf K := by
    rw [← QuotientGroup.eq]; exact Quotient.out_eq c
  refine ⟨(O, c), ?_⟩
  apply Quotient.sound
  refine MulAction.mem_orbit_iff.2 ⟨⟨((c.out : ↥K) : G')⁻¹ * (k : G'), Subgroup.mem_subgroupOf.1 hc⟩, ?_⟩
  show (((c.out : ↥K) : G')⁻¹ * (k : G')) • x = ((c.out : ↥K) : G')⁻¹ • O.out
  rw [mul_smul, ← hk]
  rfl

theorem finite_orbitQuotient_map_of_smul_eq {G' H W : Type} [Group G'] [Group H] [MulAction G' W] [MulAction H W]
    (ρ : G' →* H) (hact : ∀ (g : G') (w : W), g • w = ρ g • w) (Δ : Subgroup G')
    (hΔ : Finite (MulAction.orbitRel.Quotient (↥Δ) W)) : Finite (MulAction.orbitRel.Quotient (↥(Δ.map ρ)) W) := by
  haveI := hΔ
  refine Finite.of_surjective
    (@Quotient.map' W W (MulAction.orbitRel (↥Δ) W) (MulAction.orbitRel (↥(Δ.map ρ)) W) id ?_) ?_
  · intro a b hab
    obtain ⟨δ, hδ⟩ := MulAction.mem_orbit_iff.1 hab
    refine MulAction.mem_orbit_iff.2 ⟨⟨ρ (δ : G'), Subgroup.mem_map_of_mem ρ δ.2⟩, ?_⟩
    show ρ (δ : G') • b = a
    rw [← hact]; exact hδ
  · intro y
    obtain ⟨x, rfl⟩ := @Quotient.exists_rep _ (MulAction.orbitRel (↥(Δ.map ρ)) W) y
    exact ⟨Quotient.mk _ x, rfl⟩

