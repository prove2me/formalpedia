-- title:
--   pp. 1–5 — BiCay(H, R, L, S), R(H) and its normaliser, σ_{α,g}, δ_{α,x,y}, F, I, transitivity and semisymmetry
-- statement:
--   Let $H$ be a finite group and let $R, L, S \subseteq H$ satisfy $R = R^{-1}$, $L = L^{-1}$, $1 \notin R \cup L$ and $|R| = |L|$. The **bi-Cayley graph** $\Gamma = \mathrm{BiCay}(H, R, L, S)$ has vertex set $H_0 \cup H_1$, two disjoint copies $\{h_0\}$ and $\{h_1\}$ of $H$, and edge set
--
--   $$
--   \{h_0,(xh)_0\}\ (x\in R),\qquad \{h_1,(yh)_1\}\ (y\in L),\qquad \{h_0,(zh)_1\}\ (z\in S),\qquad h \in H.
--   $$
--
--   The **valency** of a vertex is its degree in this graph.
--
--   For $g \in H$, **right multiplication** $R(g) : h_i \mapsto (hg)_i$ ($i = 0, 1$) is an automorphism of $\Gamma$; $R(H) = \{R(g) : g \in H\}$, and $N_{\mathrm{Aut}(\Gamma)}(R(H))$ is its normaliser in the full automorphism group. For $\alpha \in \mathrm{Aut}(H)$ and $x, y, g \in H$ the permutations (2.1) of $V(\Gamma)$ are
--
--   $$
--   \delta_{\alpha,x,y} : h_0 \mapsto (x h^\alpha)_1,\ h_1 \mapsto (y h^\alpha)_0, \qquad \sigma_{\alpha,g} : h_0 \mapsto (h^\alpha)_0,\ h_1 \mapsto (g h^\alpha)_1,
--   $$
--
--   and (2.2) singles out the pairs with $\sigma_{\alpha,g} \in \mathrm F$, namely $R^\alpha = R$, $L^\alpha = g^{-1}Lg$, $S^\alpha = g^{-1}S$, and the triples with $\delta_{\alpha,x,y} \in \mathrm I$, namely $R^\alpha = x^{-1}Lx$, $L^\alpha = y^{-1}Ry$, $S^\alpha = y^{-1}S^{-1}x$.
--
--   A subgroup $K \le \mathrm{Aut}(\Gamma)$ is **vertex-transitive** if it is transitive on $V(\Gamma)$, and **edge-transitive** if it is transitive on the set of (unordered) edges. A graph is vertex- or edge-transitive when $\mathrm{Aut}(\Gamma)$ is, and **semisymmetric** when it has constant valency and is edge-transitive but not vertex-transitive.
--
--   These are the objects of the whole paper; every statement of this mission is about them.
--
--   **Formalization Note** The vertex set $H_0 \cup H_1$ is `H ⊕ H`, with `Sum.inl h` $= h_0$ and `Sum.inr h` $= h_1$. The conditions on $R$ and $L$ are fields of the data, used to prove symmetry and looplessness; nothing symmetrises an invalid set. The paper's automorphisms act on the right, as exponents; in Lean $h^\alpha$ is `α h` and $S^\alpha$ is `S.image α`. $R(H)$ is the subgroup of `D.graph ≃g D.graph` generated by the $R(g)$ (its carrier is exactly $\{R(g)\}$). $\sigma_{\alpha,g}$ and $\delta_{\alpha,x,y}$ are permutations of `H ⊕ H`; membership in $\mathrm F$ and $\mathrm I$ is a predicate on $(\alpha, g)$ and $(\alpha, x, y)$. Edge-transitivity is stated on `Sym2` edges, so either orientation of the target edge is allowed.
-- source:
--   Conder, Zhou, Feng and Zhang, Edge-transitive bi-Cayley graphs, arXiv:1606.04625v1, pp. 1–5, §1 (definition of BiCay) and §2.1–§2.2 (transitivity, semisymmetric, (2.1), (2.2))

import Mathlib
open Pointwise

namespace EdgeTransBiCayley.BiDihedrant

/-- The data of `BiCay(H,R,L,S)` in §1, p. 1. -/
structure BiCayData (H : Type*) [Group H] [DecidableEq H] where
  R : Finset H
  L : Finset H
  S : Finset H
  inv_R : R⁻¹ = R
  inv_L : L⁻¹ = L
  one_notMem_R : (1 : H) ∉ R
  one_notMem_L : (1 : H) ∉ L
  card_R_eq_card_L : R.card = L.card

private theorem inv_mem_iff {H : Type*} [Group H] [DecidableEq H]
    (A : Finset H) (hA : A⁻¹ = A) (x : H) : x⁻¹ ∈ A ↔ x ∈ A := by
  calc
    x⁻¹ ∈ A ↔ x⁻¹ ∈ A⁻¹ := by rw [hA]
    _ ↔ x ∈ A := by simp

/-- The two copies of `H` have internal edges from `R,L` and cross edges from `S`. -/
def BiCayData.graph {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    SimpleGraph (H ⊕ H) where
  Adj
    | .inl h, .inl h' => h' * h⁻¹ ∈ D.R
    | .inr h, .inr h' => h' * h⁻¹ ∈ D.L
    | .inl h, .inr h' => h' * h⁻¹ ∈ D.S
    | .inr h, .inl h' => h * h'⁻¹ ∈ D.S
  symm := by
    constructor
    intro a b hab
    cases a with
    | inl a =>
      cases b with
      | inl b =>
        change a * b⁻¹ ∈ D.R
        change b * a⁻¹ ∈ D.R at hab
        rw [← inv_mem_iff D.R D.inv_R (b * a⁻¹)] at hab
        simpa only [mul_inv_rev, inv_inv] using hab
      | inr b => exact hab
    | inr a =>
      cases b with
      | inl b => exact hab
      | inr b =>
        change a * b⁻¹ ∈ D.L
        change b * a⁻¹ ∈ D.L at hab
        rw [← inv_mem_iff D.L D.inv_L (b * a⁻¹)] at hab
        simpa only [mul_inv_rev, inv_inv] using hab
  loopless := by
    constructor
    intro a haa
    cases a with
    | inl a =>
      change a * a⁻¹ ∈ D.R at haa
      exact D.one_notMem_R (by simpa using haa)
    | inr a =>
      change a * a⁻¹ ∈ D.L at haa
      exact D.one_notMem_L (by simpa using haa)

instance {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    DecidableRel D.graph.Adj := by
  intro a b
  cases a <;> cases b <;> dsimp [BiCayData.graph] <;> infer_instance

/-- Right multiplication by `g`, the paper's `R(g)`. -/
def rightMulPerm {H : Type*} [Group H] (g : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inl (h * g)
    | .inr h => .inr (h * g)
  invFun := fun v => match v with
    | .inl h => .inl (h * g⁻¹)
    | .inr h => .inr (h * g⁻¹)
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- `R(g)` as an automorphism of the bi-Cayley graph. -/
def rightMul {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) (g : H) :
    D.graph ≃g D.graph where
  toEquiv := rightMulPerm g
  map_rel_iff' := by
    intro a b
    cases a <;> cases b <;>
      simp only [BiCayData.graph, rightMulPerm, Equiv.coe_fn_mk] <;>
      group

/-- The right regular subgroup `R(H)`. -/
def RH {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    Subgroup (D.graph ≃g D.graph) := Subgroup.closure (Set.range (rightMul D))

/-- The normaliser `N_{Aut(Γ)}(R(H))`. -/
def normRH {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H) :
    Subgroup (D.graph ≃g D.graph) := Subgroup.normalizer (RH D : Set (D.graph ≃g D.graph))

/-- The permutation `σ_{α,g}` from (2.1). -/
def sigmaPerm {H : Type*} [Group H] (α : MulAut H) (g : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inl (α h)
    | .inr h => .inr (g * α h)
  invFun := fun v => match v with
    | .inl h => .inl (α.symm h)
    | .inr h => .inr (α.symm (g⁻¹ * h))
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- The permutation `δ_{α,x,y}` from (2.1). -/
def deltaPerm {H : Type*} [Group H] (α : MulAut H) (x y : H) : Equiv.Perm (H ⊕ H) where
  toFun := fun v => match v with
    | .inl h => .inr (x * α h)
    | .inr h => .inl (y * α h)
  invFun := fun v => match v with
    | .inl h => .inr (α.symm (y⁻¹ * h))
    | .inr h => .inl (α.symm (x⁻¹ * h))
  left_inv := by intro v; cases v <;> simp
  right_inv := by intro v; cases v <;> simp

/-- The condition defining membership in `F` in (2.2). -/
def IsF {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H)
    (α : MulAut H) (g : H) : Prop :=
  D.R.image α = D.R ∧
  D.L.image α = (g⁻¹ • D.L) * ({g} : Finset H) ∧
  D.S.image α = g⁻¹ • D.S

/-- The condition defining membership in `I` in (2.2). -/
def IsI {H : Type*} [Group H] [DecidableEq H] (D : BiCayData H)
    (α : MulAut H) (x y : H) : Prop :=
  D.R.image α = (x⁻¹ • D.L) * ({x} : Finset H) ∧
  D.L.image α = (y⁻¹ • D.R) * ({y} : Finset H) ∧
  D.S.image α = (y⁻¹ • D.S⁻¹) * ({x} : Finset H)

/-- A subgroup acts transitively on the vertices. -/
def IsVertexTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  ∀ u v : V, ∃ φ ∈ K, φ u = v

/-- A subgroup acts transitively on the undirected edges. -/
def IsEdgeTransitiveOn {V : Type*} (G : SimpleGraph V)
    (K : Subgroup (G ≃g G)) : Prop :=
  ∀ e ∈ G.edgeSet, ∀ e' ∈ G.edgeSet, ∃ φ ∈ K, Sym2.map φ e = e'

/-- Vertex-transitivity of `G` (§2.1, p. 4): the full group `Aut(G)` is transitive on vertices. -/
def IsVertexTransitive {V : Type*} (G : SimpleGraph V) : Prop :=
  IsVertexTransitiveOn G ⊤

/-- Edge-transitivity of `G` (§2.1, p. 4): `Aut(G)` is transitive on the undirected edges. -/
def IsEdgeTransitive {V : Type*} (G : SimpleGraph V) : Prop :=
  IsEdgeTransitiveOn G ⊤

/-- `G` is semisymmetric (§2.1, p. 4): it has constant valency and is edge- but not
vertex-transitive. -/
def IsSemisymmetric {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=
  (∃ d : ℕ, ∀ v : V, G.degree v = d) ∧ IsEdgeTransitive G ∧ ¬ IsVertexTransitive G

end EdgeTransBiCayley.BiDihedrant


