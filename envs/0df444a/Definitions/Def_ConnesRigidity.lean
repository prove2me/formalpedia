        ((Finset.univ : Finset (BinaryPolynomialVector N)).filter
          (fun y ↦ z.2 (diagonal (polynomialVectorVal y)) ≠ 0)) ⊆
        ((Finset.univ : Finset (BinaryPolynomialVector N)).filter
          (fun y ↦ z.1 (polynomialVectorVal y) ≠ 0 ∨
