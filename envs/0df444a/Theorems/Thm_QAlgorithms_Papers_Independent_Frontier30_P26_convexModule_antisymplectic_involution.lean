variable {L V : Type*} [LieRing L] [LieAlgebra ℝ L] [FiniteDimensional ℝ L]
  [NormedAddCommGroup V] [NormedSpace ℝ V] [FiniteDimensional ℝ V]
  [LieRingModule L V] [LieModule ℝ L V]

/-- Lemma 4.6, PDF pp. 21–22. The subalgebra S is not assumed to be an ideal.
The involution and antisymplectic identities are stated on the effective submodule only. -/
theorem convexModule_antisymplectic_involution [LieAlgebra.HasCentralRadical ℝ L]
    (hq : ∀ I : LieIdeal ℝ L, LieAlgebra.IsSimple ℝ I →
      CompactlyEmbedded (Set.univ : Set I) ∨ Hermitian (G := I))
    (T S : LieSubalgebra ℝ L) (ht : CompactCartan T)
    (hnormal : ∀ t ∈ T, ∀ x ∈ S, ⁅t, x⁆ ∈ S)
    (hs : LieAlgebra.IsSemisimple ℝ S)
    (htube : ∀ I : LieIdeal ℝ S, LieAlgebra.IsSimple ℝ I → Hermitian (G := I) ∧ TubeType (G := I))
    (M : ConvexSymplecticModule (L := L) (V := V)) :
    IsCompl (effectiveSpace (V := V) S) (fixedModuleSpace (V := V) S) ∧
    StableUnder S (effectiveSpace (V := V) S) ∧ StableUnder S (fixedModuleSpace (V := V) S) ∧
    (∀ v ∈ effectiveSpace (V := V) S, ∀ w ∈ fixedModuleSpace (V := V) S, M.omega v w = 0) ∧
    (∀ v ∈ effectiveSpace (V := V) S,
      (∀ w ∈ effectiveSpace (V := V) S, M.omega v w = 0) → v = 0) ∧
    (∃ x ∈ S, ∀ v ∈ effectiveSpace (V := V) S, v ≠ 0 → 0 < M.omega ⁅x, v⁆ v) ∧
    (∀ h : S, EulerElement h →
      LieSubalgebra.lieSpan ℝ L {x | x ∈ S ∧ (⁅(h : L), x⁆ = x ∨ ⁅(h : L), x⁆ = -x)} = S →
      (∀ v ∈ effectiveSpace (V := V) S, (4 : ℝ) • ⁅(h : L), ⁅(h : L), v⁆⁆ = v) ∧
      (∀ v ∈ effectiveSpace (V := V) S, ∀ w ∈ effectiveSpace (V := V) S,
        M.omega ((2 : ℝ) • ⁅(h : L), v⁆) ((2 : ℝ) • ⁅(h : L), w⁆) = -M.omega v w)) := by sorry

end SymplecticModules

