theorem NLogN.KIL.rowMerge_spec (t : IState HS) {W : ℕ} (s : Fin W → List ℤ) (P L : ℕ) [NeZero W] (rest : Shape)
    (Bb : ℕ) (R L1 L2 L3 L4 : List Item)
    (hs : ∀ w, (s w).length = P * L * AModel.vol rest) (hb : ∀ w, Bnd Bb (s w))
    (hB1 : 1 ≤ AModel.vol rest) (hPL : 1 ≤ P * L)
    (hV : zsz ((1 * (W * (P * L * AModel.vol rest)) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints ((List.finRange W).flatMap s) ++ R)
    (h1 : t.G 1 = .int ((1 : ℕ) : ℤ) :: L1)
    (h2 : t.G 2 = .int (W : ℤ) :: L2) (h3 : t.G 3 = .int ((P * L : ℕ) : ℤ) :: L3)
    (h4 : t.G 4 = .int (AModel.vol rest : ℤ) :: L4) :
    fwdP.ok t ∧ fwdP.run t = t.upd 0 (ints (rowMerge P W L rest 0 s) ++ R) ∧
      fwdP.cost t ≤ cMove 1 W (P * L) (AModel.vol rest) Bb := by sorry
