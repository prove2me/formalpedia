variable {k : Type} [Field k] {P : Scheme.{0}} (c : A1 k ⟶ P) [IsOpenImmersion c] {g₀ G : k[X]} (hG₀ : g₀ ∣ G)

/-- `D_G ⟶ D_{g₀}` over `P`. -/
def toDG : chEt c (locF (B := CommRingCat.of k[X]) G) ⟶ chEt c (locF (B := CommRingCat.of k[X]) g₀) :=
  MorphismProperty.Over.homMk (Spec.map (liftG hG₀)) (by
    show Spec.map (liftG hG₀) ≫ Spec.map (locF (B := CommRingCat.of k[X]) g₀) ≫ c =
      Spec.map (locF (B := CommRingCat.of k[X]) G) ≫ c
    rw [← Category.assoc, ← Spec.map_comp, locF_liftG])

variable {a : k} {Uo : P.Opens}
  (hg₀ : ∀ v : (chEt c (locF (B := CommRingCat.of k[X]) g₀)).left,
    (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v ∈ Uo ∨ (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom v = c (A1pt k a))
  (hGt : X - C a ∣ G)

include hG₀ hg₀ hGt in
/-- `D_G` lies over `U₀`. -/
theorem chG_mem (v : Spec (CommRingCat.of (Localization.Away G))) :
    (chEt c (locF (B := CommRingCat.of k[X]) G)).hom v ∈ Uo := by
  have e : (chEt c (locF (B := CommRingCat.of k[X]) G)).hom v =
      (chEt c (locF (B := CommRingCat.of k[X]) g₀)).hom ((toDG c hG₀).left v) :=
    (congrArg (fun F => F v) (MorphismProperty.Over.w (toDG c hG₀))).symm
  rcases hg₀ ((toDG c hG₀).left v) with h1 | h1
  · rw [e]; exact h1
  · exfalso
    have hcu : (chEt c (locF (B := CommRingCat.of k[X]) G)).hom v = c (Spec.map (locF (B := CommRingCat.of k[X]) G) v) := rfl
    have h2 : Spec.map (locF (B := CommRingCat.of k[X]) G) v = A1pt k a :=
      c.isOpenEmbedding.injective (hcu.symm.trans (e.trans h1))
    have h3 : X - C a ∈ (Spec.map (locF (B := CommRingCat.of k[X]) G) v).asIdeal := by
      rw [h2]; exact Ideal.mem_span_singleton_self _
    exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.1 h3) (isUnit_locF_of_dvd hGt))

