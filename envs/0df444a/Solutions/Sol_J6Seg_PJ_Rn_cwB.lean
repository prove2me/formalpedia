section body
variable {W N NN b y : ℕ} {gv gc : ℕ → ℤ} {u : Vr} {D : Cs}

theorem Rn.cwB_sol_aux (hN : N ≤ 2 ^ W) (hW2 : 2 ≤ W) (hu : BV W u)
    (h4 : u 4 = b) (h8 : u 8 = y) (h11 : u 11 = NN) (hy : y < NN) (hNN : NN ≤ N)
    (hSC : D SC = ((List.range NN).map gc).reverse) (hSV : D SV = ((List.range NN).map gv).reverse)
    (bc : ∀ i < NN, |gc i| ≤ 2 ^ W) (bv : ∀ i < NN, |gv i| ≤ 2 ^ W)
    (bS : |u 5 + cTm gv gc b y| ≤ 2 ^ W) :
    Rn (progL PJ.cwB) u D (fun v' => v' 5 = u 5 + cTm gv gc b y ∧ Fxk [1, 5, 12, 29] u v' ∧ BV W v') D
      (costL W N PJ.cwB) := by
  have d1 : ixYE.den u = ((NN - 1 - y : ℕ) : ℤ) := by
    simp only [ixYE, E.den, h11, h8]; omega
  obtain ⟨w1, hw1⟩ : ∃ w1 : Vr, w1 = update (update u 29 ((NN - 1 - y : ℕ) : ℤ)) 12 (gc y) :=
    ⟨_, rfl⟩
  have q1 : ∀ j : Fin HS, j ≠ 29 → j ≠ 12 → w1 j = u j := fun j a b => by
    rw [hw1, update_of_ne b, update_of_ne a]
  have d2 : (eqE (.r 12) (.r 4)).den w1 = if gc y = b then 1 else 0 := by
    rw [den_eqE]; simp only [E.den]
    have a1 : w1 12 = gc y := by rw [hw1, update_self]
    have a2 : w1 4 = (b : ℤ) := by rw [q1 4 (by decide) (by decide), h4]
    simp only [a1, a2]
  obtain ⟨w2, hw2⟩ : ∃ w2 : Vr, w2 = update w1 12 (if gc y = b then 1 else 0) := ⟨_, rfl⟩
  have q2 : ∀ j : Fin HS, j ≠ 29 → j ≠ 12 → w2 j = u j := fun j a b => by
    rw [hw2, update_of_ne b, q1 j a b]
  have d3 : ixYE.den w2 = ((NN - 1 - y : ℕ) : ℤ) := by
    simp only [ixYE, E.den]
    rw [q2 11 (by decide) (by decide), q2 8 (by decide) (by decide), h11, h8]; omega
  obtain ⟨w3, hw3⟩ : ∃ w3 : Vr, w3 = update (update w2 29 ((NN - 1 - y : ℕ) : ℤ)) 1 (gv y) :=
    ⟨_, rfl⟩
  have q3 : ∀ j : Fin HS, j ≠ 29 → j ≠ 12 → j ≠ 1 → w3 j = u j := fun j a b c' => by
    rw [hw3, update_of_ne c', update_of_ne a, q2 j a b]
  have d4 : (E.add (.r 5) (.mul (.r 12) (.r 1))).den w3 = u 5 + cTm gv gc b y := by
    simp only [E.den]
    rw [q3 5 (by decide) (by decide) (by decide), hw3, update_self, update_of_ne (by decide),
      update_of_ne (by decide), hw2, update_self, cTm]
    split_ifs <;> ring
  have g1 : (D SC).getD (NN - 1 - y) 0 = gc y := by rw [hSC, rev_getD _ hy]
  have g2 : (D SV).getD (NN - 1 - y) 0 = gv y := by rw [hSV, rev_getD _ hy]
  have s1 : Ins.run (.rd SC ixYE 12) (u, D) = (w1, D) := by
    simp only [Ins.run, d1, Int.toNat_natCast, g1, hw1]
  have s2 : Ins.run (.a 12 (eqE (.r 12) (.r 4))) (w1, D) = (w2, D) := by
    simp only [Ins.run, d2, hw2]
  have s3 : Ins.run (.rd SV ixYE 1) (w2, D) = (w3, D) := by
    simp only [Ins.run, d3, Int.toNat_natCast, g2, hw3]
  have s4 : Ins.run (.a 5 (.add (.r 5) (.mul (.r 12) (.r 1)))) (w3, D) =
      (update w3 5 (u 5 + cTm gv gc b y), D) := by
    simp only [Ins.run, d4]
  have e : runL PJ.cwB (u, D) = (update w3 5 (u 5 + cTm gv gc b y), D) := by
    simp only [PJ.cwB, runL]; rw [s1, s2, s3, s4]
  have h2W : (4 : ℕ) ≤ 2 ^ W := by
    calc 4 = 2 ^ 2 := by norm_num
      _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) hW2
  have hok : OkL W N PJ.cwB (u, D) := by
    have l1 : (D SC).length = NN := by rw [hSC]; simp
    have l2 : (D SV).length = NN := by rw [hSV]; simp
    have b1 := rev_mem_bnd bc; rw [← hSC] at b1
    have b2 := rev_mem_bnd bv; rw [← hSV] at b2
    simp only [PJ.cwB, OkL, s1, s2, s3]
    refine ⟨?_, ?_, ?_, ?_, trivial⟩ <;> simp only [Ins.ok]
    · refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl, ?_, ?_,
        ?_, by rw [l1]; exact hNN, b1⟩
      · simp only [ixYE, E.lb]; norm_num; omega
      · rw [d1]; positivity
      · rw [d1, l1]; omega
    · refine ⟨by decide, rfl, by simp only [eqE, ltE, E.lb]; norm_num; omega, ?_⟩
      have h2Wz : (4 : ℤ) ≤ 2 ^ W := by exact_mod_cast h2W
      rw [d2]; split_ifs <;> norm_num <;> omega
    · refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl, ?_, ?_,
        ?_, by rw [l2]; exact hNN, b2⟩
      · simp only [ixYE, E.lb]; norm_num; omega
      · rw [d3]; positivity
      · rw [d3, l2]; omega
    · exact ⟨by decide, rfl, by simp only [E.lb]; norm_num; omega, by rw [d4]; exact bS⟩
  have R := Rn.insL hN PJ.cwB hu hok
  rw [e] at R
  dsimp only at R
  refine R.mono (fun v' ⟨ev, bv⟩ => ⟨by rw [ev, update_self], fun j hj => ?_, bv⟩) le_rfl
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
  obtain ⟨j1, j5, j12, j29⟩ := hj
  rw [ev, update_of_ne j5, q3 j j29 j12 j1]

end body

