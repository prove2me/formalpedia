def precision : ℕ := 160
def endpointLogTwo : DyadicInterval precision := ⟨1013035739299659071135698605846798551586536899314, 1013035739299659071135698605846798551586536901381⟩
def fastLogWitness : FastLogBoxWitness := ⟨0, 1024, 0, 1024⟩

theorem endpointLogTwo_checked :
    logBoxCheck (ofInt precision 2) endpointLogTwo fastLogWitness = true := by decide +kernel

def centerBLowerAlpha : DyadicInterval precision := ⟨2053851729919731661891122160470191123854139503309, 2053851729919731661891122160470191123854139503309⟩
def centerBLowerExp : DyadicInterval precision := ⟨87936498323453739023942818534544665008268174074, 87936498323453739023942818534544665008268305147⟩
