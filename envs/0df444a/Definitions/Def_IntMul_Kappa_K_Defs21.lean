-- Source module: Solutions.KFRAddr
/-!
# KFR: the packed rectangle of three rows, and the row addition as `rowAddAddr`

For a stride-`K` family `pos` (`pos (r, c) + K (c + f r) = e`, `f = m^k`) and three rows
`σ 0 < σ 1 < σ 2`, `shR` is the rectangle `rect N0 N1 N2 N3 (fK)` whose chunk slot `τ` is the
field of row `σ τ` (weight `2^{sR (σ τ)} S₀`).  **`encode_rowAddAddr`**: on this rectangle, the
address map `rowAddAddr K (e mod K) f px py` is `fset (rowAddr (σ px) (σ py))`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFR

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly KFN

variable {K m k e : ℕ} {pos : Fin m × Fin (m ^ k) → ℕ}

/-- The rectangle of the rows `σ 0 < σ 1 < σ 2`. -/
def shR (K f e t S0 B : ℕ) (σ : Fin 3 → Fin m) : Shape :=
  rect (B * 2 ^ (t - sR K f e (σ 0) - f * K)) (2 ^ (sR K f e (σ 0) - sR K f e (σ 1) - f * K))
    (2 ^ (sR K f e (σ 1) - sR K f e (σ 2) - f * K)) (2 ^ sR K f e (σ 2) * S0) (f * K)

section Shape

variable {t S0 B : ℕ} {σ : Fin 3 → Fin m}
  (he : ∀ p, pos p + K * (p.2.val + m ^ k * p.1.val) = e) (htop : e - e % K + K ≤ t)
  (hσ : σ 0 < σ 1 ∧ σ 1 < σ 2)
include he htop hσ

end Shape

end NLogN.KFR

end

section
-- Source module: Solutions.KFRPerm
/-!
# KFR: `permRecs` realises the row operator `Pm i j`, and the statement `Lem13ILP`

* `permRecs_recRep`, `permRecs_GB`: permuting records by an address map `π` represents
  `q ↦ xs[encode (π (decode q))]` with the same scale and the same entry bound.
* `selOpF_Pm`: `selOpF st n (Pm i j) xs = q ↦ xs[fset q (rowAddr i j (fbit q))]`.
* `slots3`: two distinct rows `i ≠ j` of `m ≥ 3` are two of three sorted rows `σ 0 < σ 1 < σ 2`.
* `Lem13ILP iprog`: the statement of `NLogN.KFL.lem13_il` (`Solutions/KFL_WIP.lean`), copied with
  `l12prog` replaced by a parameter `iprog` (so `Lem13ILP l12prog` is `lem13_il`).
* **`rowImpl_of_lem13`**: under `Lem13Body`, the row operator `Pm i j` of a stride-`K` family has an
  `SImplI` implementation (scale and bound unchanged) whose cost is the Lemma 13 bound `bnd`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFR

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly KFN

/-! ## Records permuted by an address map -/

/-! ## Three sorted rows -/

/-! ## The Lemma 13 statement -/

/-- The body of `NLogN.KFL.lem13_il` for a given program table, code family and constant. -/
def Lem13Body (iprog : Fin 1 → IStmt HS 1)
    (code : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Fin 3 → Fin 3 → IStmt HS 1) (Kc : ℝ) : Prop :=
  ∀ {I : List Sym} (N0 N1 N2 N3 K f ρ R w : ℕ) (px py : Fin 3), px ≠ py → 6 ≤ K → ρ < K →
    1 ≤ f → 1 ≤ N0 → 1 ≤ N1 → 1 ≤ N2 → 1 ≤ N3 → 1 ≤ R →
    ∀ (s : IState HS) (g : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
    g 0 = gflat zs ++ l → zs.length = vol (rect N0 N1 N2 N3 (f * K)) * R → NLogN.KFB.GB w zs →
    ∃ c, IRuns I iprog (code N0 N1 N2 N3 K f ρ R w px py) (encK s g)
        (encK s (Function.update g 0 (gflat (permRecs (rect N0 N1 N2 N3 (f * K))
          (rowAddAddr K ρ f px py) R zs) ++ l))) c ∧
      (c : ℝ) ≤ Kc * ((zs.length : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + 1) +
        (vol (rect N0 N1 N2 N3 (f * K)) : ℝ) * ((zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) ^ 3 +
        min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (vol (rect N0 N1 N2 N3 (f * K)) : ℝ) *
          ((zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1) * ((R : ℝ) * (w + 1) +
            (zsz (2 * zs.length * (w + 1) : ℤ) : ℝ) + 1))

/-- **The statement of `NLogN.KFL.lem13_il`**, with `l12prog` as the parameter `iprog`. -/
def Lem13ILP (iprog : Fin 1 → IStmt HS 1) : Prop :=
  ∃ (code : ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → ℕ → Fin 3 → Fin 3 → IStmt HS 1) (Kc : ℝ), 0 < Kc ∧
    Lem13Body iprog code Kc

/-- The Lemma 13 cost for `n` records of `r` entries, `f` bits per row. -/
noncomputable def bnd (Kc : ℝ) (K f n r w : ℕ) : ℝ :=
  Kc * (((n * r : ℕ) : ℝ) * (w + 1) * (((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + 1) +
    (n : ℝ) * ((zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1) ^ 3 +
    min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * (n : ℝ) *
      ((zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1) * ((r : ℝ) * (w + 1) +
        (zsz (2 * ((n * r : ℕ) : ℤ) * ((w : ℤ) + 1)) : ℝ) + 1))

end NLogN.KFR

end

