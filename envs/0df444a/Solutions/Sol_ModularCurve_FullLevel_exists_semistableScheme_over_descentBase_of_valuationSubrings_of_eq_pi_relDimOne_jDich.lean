theorem algebraMap_mem_igusaRing_iff
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ)) (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (ℓ : CuspidalType.ProjLine q) (c : AlgebraicClosure ℚ) :
    algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c ∈ OIg ℓ ↔ c ∈ A := by

  obtain ⟨γ, -, -, hℓ⟩ := hIg ℓ
  have hfix : (levelAutBar q M' ζ γ).toAlgHom.toRingHom
      (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c) = algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c :=
    (levelAutBar q M' ζ γ).toAlgHom.commutes _
  rw [hℓ, ValuationSubring.mem_comap, hfix, hIg_inf]
  have hcoe : ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') c : ↥(fieldBar q M')) :
      LaurentSeries (AlgebraicClosure ℚ)) = HahnSeries.single 0 c := by
    rw [← algebraMap_laurentSeries_eq_single]; rfl
  constructor
  · rintro ⟨x, y, hy, hxy⟩

    obtain ⟨n, hn⟩ : ∃ n : ℤ, (coeffMap (IsLocalRing.residue ↥A) y).coeff n ≠ 0 := by
      by_contra h
      push_neg at h
      exact hy (HahnSeries.ext (funext h))
    rw [coeffMap_coeff] at hn
    have hunit : IsUnit (y.coeff n) := by
      by_contra hu
      exact hn ((IsLocalRing.residue_eq_zero_iff _).mpr (by rwa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]))

    have hcoeff := congrArg (fun z : LaurentSeries (AlgebraicClosure ℚ) => z.coeff n) hxy
    simp only [hcoe, HahnSeries.single_zero_mul_eq_smul] at hcoeff
    rw [HahnSeries.coeff_smul, coeffMap_coeff, coeffMap_coeff, smul_eq_mul] at hcoeff

    change c * ((y.coeff n : ↥A) : AlgebraicClosure ℚ) = ((x.coeff n : ↥A) : AlgebraicClosure ℚ) at hcoeff
    obtain ⟨u, hu⟩ := hunit
    have hc : c = (x.coeff n : AlgebraicClosure ℚ) * ((u⁻¹ : (↥A)ˣ) : ↥A) := by
      have hyu : ((y.coeff n : ↥A) : AlgebraicClosure ℚ) = ((u : ↥A) : AlgebraicClosure ℚ) := by rw [hu]
      have hne : ((u : ↥A) : AlgebraicClosure ℚ) ≠ 0 := by
        intro h0
        apply u.ne_zero
        exact Subtype.ext h0
      have : c * ((u : ↥A) : AlgebraicClosure ℚ) = (x.coeff n : AlgebraicClosure ℚ) := by rw [← hyu]; exact hcoeff
      have hinv : (((u⁻¹ : (↥A)ˣ) : ↥A) : AlgebraicClosure ℚ) = (((u : ↥A) : AlgebraicClosure ℚ))⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        have h1 : ((u⁻¹ : (↥A)ˣ) : ↥A) * (u : ↥A) = 1 := u.inv_mul
        have h2 := congrArg (Subtype.val : ↥A → AlgebraicClosure ℚ) h1
        rw [Subring.coe_mul] at h2
        exact h2
      rw [hinv, ← this, mul_inv_cancel_right₀ hne]
    rw [hc]
    exact A.toSubring.mul_mem (x.coeff n).2 ((u⁻¹ : (↥A)ˣ) : ↥A).2
  · intro hc
    refine ⟨HahnSeries.single 0 ⟨c, hc⟩, 1, ?_, ?_⟩
    · rw [map_one]; exact one_ne_zero
    · rw [map_one, mul_one, coeffMap_single, hcoe]
      rfl

end ConstTrace

section Algebraic

theorem isAlgebraic_of_subfield_span
    {L F : Type} [Field L] [Field F] [Algebra L F] (F₀ : Subfield F)
    (hL : ∀ c : L, IsAlgebraic ↥F₀ (algebraMap L F c))
    (hspan : ∀ f : F, ∃ (n : ℕ) (c : Fin n → L) (g : Fin n → ↥F₀) (d : Fin n → L) (g' : Fin n → ↥F₀),
      (∑ i, d i • (g' i : F)) ≠ 0 ∧ f * (∑ i, d i • (g' i : F)) = ∑ i, c i • (g i : F))
    (f : F) : IsAlgebraic ↥F₀ f := by
  classical
  let K : IntermediateField ↥F₀ F := algebraicClosure ↥F₀ F
  have hK : ∀ x : F, x ∈ K ↔ IsAlgebraic ↥F₀ x := fun x => mem_algebraicClosure_iff
  have hsum : ∀ (n : ℕ) (c : Fin n → L) (g : Fin n → ↥F₀), (∑ i, c i • (g i : F)) ∈ K := by
    intro n c g
    refine Subalgebra.sum_mem _ (fun i _ => ?_)
    rw [Algebra.smul_def]
    refine mul_mem ((hK _).mpr (hL (c i))) ?_
    have : ((g i : ↥F₀) : F) = algebraMap ↥F₀ F (g i) := rfl
    rw [this]
    exact IntermediateField.algebraMap_mem K (g i)
  obtain ⟨n, c, g, d, g', hne, hf⟩ := hspan f
  have hfK : f ∈ K := by
    have : f = (∑ i, c i • (g i : F)) * (∑ i, d i • (g' i : F))⁻¹ := by
      rw [← hf, mul_inv_cancel_right₀ hne]
    rw [this]
    exact mul_mem (hsum n c g) (inv_mem (hsum n d g'))
  exact (hK f).mp hfK

end Algebraic

section LocalConst

theorem mem_maximalIdeal_of_inv_not_mem {F : Type} [Field F] (O : ValuationSubring F)
    (y : F) (hy : y ∈ O) (hinv : y⁻¹ ∉ O) : (⟨y, hy⟩ : ↥O) ∈ IsLocalRing.maximalIdeal ↥O := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  apply hinv
  have hy0 : y ≠ 0 := by
    intro h0; apply hinv; rw [h0, inv_zero]; exact zero_mem O
  obtain ⟨u, hu⟩ := hu
  have h1 : ((u⁻¹ : (↥O)ˣ) : ↥O) * (u : ↥O) = 1 := u.inv_mul
  have h2 := congrArg (Subtype.val : ↥O → F) h1
  rw [Subring.coe_mul, hu] at h2
  have h3 : y⁻¹ = (((u⁻¹ : (↥O)ˣ) : ↥O) : F) := (eq_inv_of_mul_eq_one_left h2).symm
  rw [h3]
  exact ((u⁻¹ : (↥O)ˣ) : ↥O).2

theorem inv_not_mem_of_pow_mem_maximalIdeal {L : Type} [Field L] (A : ValuationSubring L)
    (π : L) (hπ0 : π ≠ 0) (hπA : π ∈ A) (e : ℕ)
    (hm : (⟨π, hπA⟩ : ↥A) ^ e ∈ IsLocalRing.maximalIdeal ↥A) : π⁻¹ ∉ A := by
  intro hinv
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm
  apply hm
  have hu : IsUnit (⟨π, hπA⟩ : ↥A) := by
    refine ⟨⟨⟨π, hπA⟩, ⟨π⁻¹, hinv⟩, ?_, ?_⟩, rfl⟩
    · ext; simp [mul_inv_cancel₀ hπ0]
    · ext; simp [inv_mul_cancel₀ hπ0]
  exact hu.pow e

theorem exists_sub_mem_maximalIdeal_of_residue_surjective
    {L : Type} [Field L] (A : ValuationSubring L)
    {A₀ : Type} [CommRing A₀] (ι : A₀ →+* ↥A)
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι)) (a : ↥A) :
    ∃ a₀ : A₀, a - ι a₀ ∈ IsLocalRing.maximalIdeal ↥A := by
  obtain ⟨a₀, ha₀⟩ := hres (IsLocalRing.residue ↥A a)
  refine ⟨a₀, ?_⟩
  rw [← Ideal.Quotient.eq]
  exact ha₀.symm

theorem exists_eval_mem_maximalIdeal_of_monic
    {L : Type} [Field L] (A : ValuationSubring L) [IsAlgClosed (IsLocalRing.ResidueField ↥A)]
    {A₀ : Type} [CommRing A₀] [Nontrivial A₀] (ι : A₀ →+* ↥A)
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι))
    (p : Polynomial A₀) (hp : p.Monic) (hd : 0 < p.natDegree) :
    ∃ a₀ : A₀, ι (p.eval a₀) ∈ IsLocalRing.maximalIdeal ↥A := by
  have hmonic : (p.map ((IsLocalRing.residue ↥A).comp ι)).Monic := hp.map _
  have hdeg : (p.map ((IsLocalRing.residue ↥A).comp ι)).degree ≠ 0 := by
    rw [Polynomial.Monic.degree_map hp, Polynomial.degree_eq_natDegree hp.ne_zero]
    exact_mod_cast hd.ne'
  obtain ⟨r, hr⟩ := IsAlgClosed.exists_root _ hdeg
  obtain ⟨a₀, ha₀⟩ := hres r
  refine ⟨a₀, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff]
  have : (IsLocalRing.residue ↥A) (ι (p.eval a₀)) = (p.map ((IsLocalRing.residue ↥A).comp ι)).eval r := by
    rw [← ha₀, Polynomial.eval_map, Polynomial.eval₂_at_apply]
    rfl
  rw [this]
  exact hr

end LocalConst

