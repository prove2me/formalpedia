p2m_open "CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry NeronModelInfra~schemeHomOverComp GoodReductionJacobian AlgebraicGeometry.Polarisation AlgebraicGeometry.PolarisedAbelianScheme"

namespace SplitEtKit

section grp

variable {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)

theorem nsmul_natural {T T' : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (t' : T' ⟶ Spec (CommRingCat.of S))
    (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (n : ℕ) (x : SchemeHomOver t f) :
    schemeHomOverComp ψ hψ (L.nsmul t n x) = L.nsmul t' n (schemeHomOverComp ψ hψ x) := by
  induction n with
  | zero => rw [RelativeGroupLaw.nsmul_zero, RelativeGroupLaw.nsmul_zero]; exact L.one_natural t t' ψ hψ
  | succ k ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, L.mul_natural, ih]

@[reducible] def commGroup (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) :
    CommGroup (SchemeHomOver t f) :=
  { L.pointGroup t with mul_comm := hc t }

theorem nsmul_eq_pow (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (n : ℕ)
    (x : SchemeHomOver t f) :
    letI := commGroup L hc t
    L.nsmul t n x = x ^ n := by
  letI := commGroup L hc t
  induction n with
  | zero => rw [pow_zero]; rfl
  | succ k ih => rw [RelativeGroupLaw.nsmul_succ, pow_succ, ← ih]; rfl

theorem finComb_eq_prod (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) {m : ℕ}
    (x : Fin m → SchemeHomOver t f) (c : Fin m → ℕ) :
    letI := commGroup L hc t
    L.finComb t x c = ∏ i, x i ^ c i := by
  letI := commGroup L hc t
  show (List.ofFn fun i => x i ^ c i).prod = ∏ i, x i ^ c i
  exact List.prod_ofFn

theorem finComb_zero (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) {m : ℕ}
    (x : Fin m → SchemeHomOver t f) (c : Fin m → ℕ) (h0 : ∀ i, c i = 0) :
    L.finComb t x c = L.one t := by
  letI := commGroup L hc t
  rw [finComb_eq_prod L hc]
  show ∏ i, x i ^ c i = (1 : SchemeHomOver t f)
  exact Finset.prod_eq_one fun i _ => by rw [h0 i, pow_zero]

theorem nsmul_finComb_eq_one (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) {m : ℕ} (n : ℕ)
    (x : Fin m → SchemeHomOver t f) (hx : ∀ i, L.nsmul t n (x i) = L.one t) (c : Fin m → ℕ) :
    L.nsmul t n (L.finComb t x c) = L.one t := by
  letI := commGroup L hc t
  have hx' : ∀ i, x i ^ n = 1 := fun i => by rw [← nsmul_eq_pow L hc]; exact hx i
  rw [nsmul_eq_pow L hc, finComb_eq_prod L hc]
  show (∏ i, x i ^ c i) ^ n = (1 : SchemeHomOver t f)
  rw [← Finset.prod_pow]
  exact Finset.prod_eq_one fun i _ => by rw [← pow_mul, mul_comm, pow_mul, hx' i, one_pow]

theorem finComb_add_mod (hc : L.IsCommutative) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) {m n : ℕ}
    (x : Fin m → SchemeHomOver t f) (hx : ∀ i, L.nsmul t n (x i) = L.one t) (a b : Fin m → Fin n) :
    L.finComb t x (fun i => ((a i + b i : Fin n) : ℕ)) =
      L.mul t (L.finComb t x (fun i => (a i : ℕ))) (L.finComb t x (fun i => (b i : ℕ))) := by
  letI := commGroup L hc t
  have hx' : ∀ i, x i ^ n = 1 := fun i => by rw [← nsmul_eq_pow L hc]; exact hx i
  rw [finComb_eq_prod L hc, finComb_eq_prod L hc, finComb_eq_prod L hc]
  show ∏ i, x i ^ ((a i + b i : Fin n) : ℕ) = (∏ i, x i ^ (a i : ℕ)) * ∏ i, x i ^ (b i : ℕ)
  rw [← Finset.prod_mul_distrib]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [← pow_add, Fin.val_add]
  conv_rhs => rw [← Nat.mod_add_div ((a i : ℕ) + (b i : ℕ)) n, pow_add, pow_mul, hx' i, one_pow, mul_one]

end grp

section coords

def coords {g n : ℕ} (hn : 0 < n) (h : (Fin g → ZMod n) × (Fin g → ZMod n)) : Fin (2 * g) → Fin n :=
  haveI : NeZero n := ⟨Nat.pos_iff_ne_zero.mp hn⟩
  fun i => if hi : (i : ℕ) < g then ⟨(h.1 ⟨i, hi⟩).val, ZMod.val_lt _⟩
    else ⟨(h.2 ⟨(i : ℕ) - g, by omega⟩).val, ZMod.val_lt _⟩

def ofCoords {g n : ℕ} (c : Fin (2 * g) → Fin n) : (Fin g → ZMod n) × (Fin g → ZMod n) :=
  (fun j => ((c ⟨j, by omega⟩ : Fin n) : ℕ), fun j => ((c ⟨g + j, by omega⟩ : Fin n) : ℕ))

theorem coords_ofCoords {g n : ℕ} (hn : 0 < n) (c : Fin (2 * g) → Fin n) : coords hn (ofCoords c) = c := by
  haveI : NeZero n := ⟨Nat.pos_iff_ne_zero.mp hn⟩
  funext i
  unfold coords ofCoords
  split_ifs with hi
  · apply Fin.ext
    simp only
    rw [ZMod.val_cast_of_lt (Fin.is_lt _)]
  · apply Fin.ext
    simp only
    rw [ZMod.val_cast_of_lt (Fin.is_lt _)]
    congr 2
    apply Fin.ext
    simp only
    omega

theorem coords_injective {g n : ℕ} (hn : 0 < n) : Function.Injective (coords (g := g) hn) := by
  haveI : NeZero n := ⟨Nat.pos_iff_ne_zero.mp hn⟩
  intro h h' H
  apply Prod.ext
  · funext j
    have := congrFun H ⟨j, by omega⟩
    unfold coords at this
    rw [dif_pos (show ((⟨j, by omega⟩ : Fin (2 * g)) : ℕ) < g from j.is_lt),
      dif_pos (show ((⟨j, by omega⟩ : Fin (2 * g)) : ℕ) < g from j.is_lt)] at this
    exact ZMod.val_injective n (congrArg Fin.val this)
  · funext j
    have := congrFun H ⟨g + j, by omega⟩
    unfold coords at this
    rw [dif_neg (show ¬ ((⟨g + j, by omega⟩ : Fin (2 * g)) : ℕ) < g by simp),
      dif_neg (show ¬ ((⟨g + j, by omega⟩ : Fin (2 * g)) : ℕ) < g by simp)] at this
    have h2 := ZMod.val_injective n (congrArg Fin.val this)
    have hj : (⟨((⟨g + j, by omega⟩ : Fin (2 * g)) : ℕ) - g, by simp⟩ : Fin g) = j := Fin.ext (by simp)
    simpa only [hj] using h2

theorem coords_add {g n : ℕ} (hn : 0 < n) (h h' : (Fin g → ZMod n) × (Fin g → ZMod n)) (i : Fin (2 * g)) :
    coords hn (h + h') i = coords hn h i + coords hn h' i := by
  haveI : NeZero n := ⟨Nat.pos_iff_ne_zero.mp hn⟩
  unfold coords
  split_ifs with hi
  · apply Fin.ext
    rw [Fin.val_add]
    simp only [Prod.fst_add, Pi.add_apply]
    exact ZMod.val_add _ _
  · apply Fin.ext
    rw [Fin.val_add]
    simp only [Prod.snd_add, Pi.add_apply]
    exact ZMod.val_add _ _

theorem coords_zero {g n : ℕ} (hn : 0 < n) (i : Fin (2 * g)) :
    ((coords hn (0 : (Fin g → ZMod n) × (Fin g → ZMod n)) i : Fin n) : ℕ) = 0 := by
  haveI : NeZero n := ⟨Nat.pos_iff_ne_zero.mp hn⟩
  unfold coords
  split_ifs with hi
  · simp only [Prod.fst_zero, Pi.zero_apply, ZMod.val_zero]
  · simp only [Prod.snd_zero, Pi.zero_apply, ZMod.val_zero]

end coords

