variable {d : ℕ}

/-! ## Lattice points are `√d/2`-dense

"Any closed ball of radius `√d/2` contains a lattice point." -/

theorem QFS.exists_lattice_mem_closedBall (z : EuclideanSpace ℝ (Fin d)) :
    ∃ y ∈ lattice d, ‖y - z‖ ≤ Real.sqrt d / 2 := by sorry
