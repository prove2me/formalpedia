open CategoryTheory AlgebraicGeometry CerednikDrinfeld.QM

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}

theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : GoodReductionJacobian.RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (P Q : SchemeHomOver t₁ f) (P' Q' : SchemeHomOver t₂ f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t₁ P Q).1 = (L.mul t₂ P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem isPullbackVia_id {B : Type} [CommRing B] (E : FakeEllipticCurve Λ N B) :
    FakeEllipticCurve.IsPullbackVia (RingHom.id B) E E (𝟙 E.A) := by
  have hS : Spec.map (CommRingCat.ofHom (RingHom.id B)) = 𝟙 _ := by rw [CommRingCat.ofHom_id, Spec.map_id]
  haveI : IsIso (Spec.map (CommRingCat.ofHom (RingHom.id B))) := by rw [hS]; infer_instance
  have sq : IsPullback (𝟙 E.A) E.f E.f (Spec.map (CommRingCat.ofHom (RingHom.id B))) :=
    IsPullback.of_horiz_isIso ⟨by rw [hS, Category.id_comp, Category.comp_id]⟩
  refine ⟨sq, ?_, ?_, ?_⟩
  · intro T t' P Q
    rw [Category.comp_id]
    exact mul_val_congr E.L (by rw [hS, Category.comp_id]) P Q _ _
      (Category.comp_id _).symm (Category.comp_id _).symm
  · intro x; rw [Category.comp_id, Category.id_comp]
  · intro T t' P hP
    obtain ⟨P₀, h⟩ := hP
    exact ⟨P₀, by rw [Category.comp_id]; exact h⟩

