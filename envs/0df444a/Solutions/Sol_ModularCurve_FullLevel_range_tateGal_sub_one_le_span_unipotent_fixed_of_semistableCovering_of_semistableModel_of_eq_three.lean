theorem unipotent_fix (lam : ℕ) [Fact lam.Prime] (hGL : GL2Laws q M') {ζ₀ : Idx q}
    (vc : CuspidalType.ProjLine q × ↥W → V₁ q M' lam)
    (hnat : ∀ (γ : SL(2, ℤ)), γ ∈ CongruenceSubgroup.Gamma0 M' → ∀ ℓ s,
      ρ₁ q M' lam (SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹)) (vc (ℓ, s)) = vc ((redQ q γ) • ℓ, s))
    (s : ↥W) (t : ZMod q) :
    (tateGL2 q M' lam (CuspidalType.unipotent q t)).baseChange ℚ_[lam] (ιQ q M' lam ζ₀ (vc (lineInfty q, s))) =
      ιQ q M' lam ζ₀ (vc (lineInfty q, s)) := by
  obtain ⟨γ, hγ, hγt⟩ := exists_redQ_eq_unipotent M' t
  have hGLγ : tateGL2 q M' lam (redQ q γ) = tateEnd q M' lam (slJac q M' γ) := by
    show tateEnd q M' lam (gl2Jac q M' (redQ q γ)) = _
    rw [gl2Jac_redQ hGL γ hγ]
  rw [← hγt, hGLγ, tateEnd_slJac_baseChange_ιQ, hnat γ hγ, hγt, unipotent_smul_lineInfty]

set_option maxHeartbeats 1600000 in

theorem exists_translate (hqM' : ¬ q ∣ M') (lam : ℕ) [Fact lam.Prime] (hGL : GL2Laws q M') {ζ₀ : Idx q}
    (vc : CuspidalType.ProjLine q × ↥W → V₁ q M' lam)
    (hnat : ∀ (γ : SL(2, ℤ)), γ ∈ CongruenceSubgroup.Gamma0 M' → ∀ ℓ s,
      ρ₁ q M' lam (SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹)) (vc (ℓ, s)) = vc ((redQ q γ) • ℓ, s))
    (ζ : Idx q) (ℓ : CuspidalType.ProjLine q) (s : ↥W) :
    ∃ g : CuspidalType.GL2 q,
      (tateGL2 q M' lam g).baseChange ℚ_[lam] (ιQ q M' lam ζ₀ (vc (lineInfty q, s))) = ιQ q M' lam ζ (vc (ℓ, s)) := by
  obtain ⟨d, rfl⟩ := exists_pow_eq ζ₀ ζ
  obtain ⟨γ, hγ, hγℓ⟩ := ModularCurve.FullLevel.exists_mem_gamma0_redQ_inv_smul_eq q M' hqM' ℓ (lineInfty q)
  rw [inv_smul_eq_iff] at hγℓ
  have hGLγ : tateGL2 q M' lam (redQ q γ) = tateEnd q M' lam (slJac q M' γ) := by
    show tateEnd q M' lam (gl2Jac q M' (redQ q γ)) = _
    rw [gl2Jac_redQ hGL γ hγ]
  have hGLd : tateGL2 q M' lam (diagOneElem q d) = tateEnd q M' lam (diagJac q M' d) := by
    show tateEnd q M' lam (gl2Jac q M' (diagOneElem q d)) = _
    rw [gl2Jac_diagOneElem hGL d]
  refine ⟨diagOneElem q d * redQ q γ, ?_⟩
  rw [map_mul, baseChange_mul_apply, hGLγ, tateEnd_slJac_baseChange_ιQ, hnat γ hγ, ← hγℓ, hGLd,
    tateEnd_diagJac_baseChange_ιQ]

