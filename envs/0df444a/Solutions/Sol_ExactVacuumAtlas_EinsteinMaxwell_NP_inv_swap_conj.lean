open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
theorem solution {T : Matrix (Fin 4) (Fin 4) ℂ} (hT : ∀ μ A, T μ (swap23 A) = conj (T μ A))
    (hdet : T.det ≠ 0) (C μ : Fin 4) : T⁻¹ (swap23 C) μ = conj (T⁻¹ C μ) := by
  have hTi : T⁻¹ * T = 1 := Matrix.nonsing_inv_mul T (isUnit_iff_ne_zero.mpr hdet)
  set Θ' : Matrix (Fin 4) (Fin 4) ℂ := Matrix.of fun C μ => conj (T⁻¹ (swap23 C) μ) with hΘ'
  have hL : Θ' * T = 1 := by
    ext C A
    have e := congrFun (congrFun hTi (swap23 C)) (swap23 A)
    simp only [Matrix.mul_apply] at e
    simp only [Matrix.mul_apply, hΘ', Matrix.of_apply]
    have e2 : ∀ μ, conj (T⁻¹ (swap23 C) μ) * T μ A = conj (T⁻¹ (swap23 C) μ * T μ (swap23 A)) := by
      intro μ; rw [map_mul, hT μ A, Complex.conj_conj]
    simp only [e2, ← map_sum, e]
    simp only [Matrix.one_apply, (Function.Involutive.injective swap23_swap23).eq_iff]
    split_ifs <;> simp
  have hinv : T⁻¹ = Θ' := Matrix.inv_eq_left_inv hL
  have := congrFun (congrFun hinv (swap23 C)) μ
  rw [this, hΘ', Matrix.of_apply, swap23_swap23]
