section
-- Source module: Solutions.R6ILProp
/-!
# Round six, item language: the item-language Prop. 11 for a round-six bit network

**`ilProp11_of_net`**: the table `tabG C q (adS m)` (generic procedure `genP C q`, adapter `adS m`
from the KIL5 descriptor) satisfies `ILProp11` with `T₀ = m + q + T + W + 16`,
`K₁ = 2 cq q + Kv C`, `K₂ = KA C q + KAd m` and `c₁ = 1 + (S + 1) c` (`S` runs, `c` the
`depH` slope of `depH_pow_le`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

theorem absAd (s1 cr c0 cR k b B X : ℕ) (hb : b = B + 2) (hbX : b ≤ X) (hX1 : 1 ≤ X)
    (hR : cR ≤ cr * ((k + 1) * X)) :
    (1 * 4000 * b + 1) + (s1 * 10 ^ 7 * X + (cR + ((1 + 1) * 2000 * b + ((1 * (2 * B + 2) + 1) +
      (1 + 1) * 2000 * b)))) + ((c0 + 2) + ((2 * B + 2) + (2 * B + 2))) + 25 ≤
      c0 + (s1 * 10 ^ 7 + cr + 20000) * ((k + 1) * X) := by
  have hXZ : X ≤ (k + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have h1 : s1 * 10 ^ 7 * X ≤ s1 * 10 ^ 7 * ((k + 1) * X) := Nat.mul_le_mul_left _ hXZ
  have e1 : (s1 * 10 ^ 7 + cr + 20000) * ((k + 1) * X) =
      s1 * 10 ^ 7 * ((k + 1) * X) + cr * ((k + 1) * X) + 20000 * ((k + 1) * X) := by ring
  rw [e1]
  omega

theorem cAd_le (m k Bb c0 : ℕ) :
    cAd m k Bb c0 + 25 ≤ c0 + KAd m * ((k + 1) * (Bb + 2) ^ 2) := by
  unfold cAd KAd
  exact absAd _ _ c0 _ k (Bb + 2) Bb _ rfl (Nat.le_self_pow (n := 2) (by norm_num) _)
    (Nat.one_le_pow _ _ (by omega)) (cRep_le _ _ _ _)

variable {W T m : ℕ} [NeZero W]

/-- The overhead exponent bound. -/
theorem ov_pow_le {S c k : ℕ} (hm : 2 ≤ m) (d : ℕ) (hd : d ≤ c * k) :
    (m ^ k + 1) * (S + 1) ^ d ≤ (m ^ k + 1) ^ (1 + (S + 1) * c) := by
  have h1 : S + 1 ≤ m ^ (S + 1) := (Nat.lt_pow_self (by omega)).le
  have h2 : (S + 1) ^ d ≤ (S + 1) ^ (c * k) := Nat.pow_le_pow_right (by omega) hd
  have h3 : (S + 1) ^ (c * k) ≤ (m ^ (S + 1)) ^ (c * k) := Nat.pow_le_pow_left h1 _
  have h4 : (m ^ (S + 1)) ^ (c * k) = (m ^ k) ^ ((S + 1) * c) := by
    rw [← pow_mul, ← pow_mul]; ring_nf
  have h5 : (m ^ k) ^ ((S + 1) * c) ≤ (m ^ k + 1) ^ ((S + 1) * c) :=
    Nat.pow_le_pow_left (by omega) _
  rw [pow_add, pow_one]
  exact Nat.mul_le_mul_left _ (le_trans h2 (le_trans h3 (h4 ▸ h5)))

set_option maxHeartbeats 4000000 in
/-- **The item-language Prop. 11 program for a round-six bit network.** -/
theorem ilProp11_of_net_sol_aux (C : Bit.QHNet (ZMod 2) W T m) (hC : NetIL C) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ (tab : Fin 1 → IStmt HS 1) (T₀ c₁ : ℕ) (K₁ K₂ : ℝ),
      0 ≤ K₁ ∧ 0 ≤ K₂ ∧ ILProp11 tab C q T₀ c₁ K₁ K₂ := by
  have hm := hC.m2
  have hruns := hC.runs
  obtain ⟨q₁, hq₁⟩ := hC.ok
  obtain ⟨c, hc1, hdepc⟩ := depH_pow_le hm
  refine ⟨max q₁ (qBound C), fun q hq hlt => ?_⟩
  have hqB : qBound C < q := lt_of_le_of_lt (le_max_right _ _) hlt
  have hOK : ∀ f, C.EdgesOK (q ^ f) := fun f => (hq₁ q hq (lt_of_le_of_lt (le_max_left _ _) hlt) f).1
  set S := (runsL C).length
  refine ⟨tabG C q (adS m), m + q + T + W + 16, 1 + (S + 1) * c, (2 * cq q + Kv C : ℝ),
    ((KA C q + KAd m : ℕ) : ℝ), by positivity, Nat.cast_nonneg _, ?_⟩
  intro Bb k P L A B Cs hP hdep hL hA hB hCs hBb I t R xs hD hxs
  have hm1 : 1 ≤ m := by omega
  set e := m ^ k with he
  set V := vol (P :: L :: swShape A B Cs (q ^ m ^ k)) with hV
  have hVh : vol (P :: L :: hdShape A B Cs e q) = V := by
    rw [hV]; simp only [vol_cons, vol_hdShape, he]
  set M := (m + q + T + W + 16) * (V + 1) ^ 2 with hMd
  have hM : zsz (M : ℤ) ≤ Bb := hBb
  -- bounds
  have he1 : 1 ≤ e := Nat.one_le_pow _ _ (by omega)
  have hVq : q ^ e ≤ V := by
    rw [← hVh, vol_hd_cons]
    have ha := vol_pos_of hA
    have hb := vol_pos_of hB
    have hc := vol_pos_of hCs
    have hX1 : 1 ≤ q ^ e := Nat.one_le_pow _ _ hq.pos
    exact Nat.le_of_dvd (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos
      (Nat.mul_pos hP hL) ha) hX1) hb) hX1) hc) ⟨P * L * vol A * vol B * q ^ e * vol Cs, by ring⟩
  have heq : e < q ^ e := Nat.lt_pow_self hq.one_lt
  have hkm : k < m ^ k := Nat.lt_pow_self (by omega)
  have hV1 : V + 1 ≤ (V + 1) ^ 2 := Nat.le_self_pow (n := 2) (by norm_num) _
  have hVM : (m + q + T + W + 16) * (V + 1) ≤ M := Nat.mul_le_mul_left _ hV1
  have hTV : V + 1 ≤ (m + q + T + W + 16) * (V + 1) := Nat.le_mul_of_pos_left _ (by omega)
  have hmT : m ≤ (m + q + T + W + 16) * (V + 1) := by
    have : m + q + T + W + 16 ≤ (m + q + T + W + 16) * (V + 1) := Nat.le_mul_of_pos_right _ (by omega)
    omega
  -- the descriptor
  obtain ⟨R1, hJ⟩ := hD.j
  have hcl : (fun c => c == Cls.neg) ((t.upd 0 (ints (enc2 xs) ++ R)).cl dJ) = false := by
    rw [cl_int _ _ _ _ (by rw [IState.upd_G, if_neg (by decide)]; exact hJ)]
    have : ¬ ((k : ℤ) < 0) := by omega
    rw [if_neg this]
    split_ifs <;> rfl
  have hG := gen_correct C q (adS m) hm hq hqB hOK hruns M Bb hM e
  have H := ad_runs (I := I) (tab := tabG C q (adS m)) m k M Bb hM (by omega) (by omega) hm1
    (by omega) t R1 hJ (ints (enc2 xs) ++ R)
    (ints (enc2 (Bit.progH C q e P L A B Cs xs)) ++ R)
    (costN C q Bb e (vol (P :: L :: hdShape A B Cs e q))) (by
      intro t' h1 h2 h3
      have hDG : DescG t' e P L (vol A) (vol B) (vol Cs) := by
        obtain ⟨Rp, hp⟩ := hD.p
        obtain ⟨Rl, hl⟩ := hD.l
        obtain ⟨Ra, ha⟩ := hD.a
        obtain ⟨Rb, hb⟩ := hD.b
        obtain ⟨Rc, hc⟩ := hD.c
        exact ⟨⟨_, h1⟩, ⟨_, h2⟩, ⟨Rp, by rw [h3 dP (by decide) (by decide)]; exact hp⟩,
          ⟨Rl, by rw [h3 dL (by decide) (by decide)]; exact hl⟩,
          ⟨Ra, by rw [h3 dA (by decide) (by decide)]; exact ha⟩,
          ⟨Rb, by rw [h3 dB (by decide) (by decide)]; exact hb⟩,
          ⟨Rc, by rw [h3 dC (by decide) (by decide)]; exact hc⟩⟩
      exact hG P L A B Cs hP hL hA hB hCs hdep (by rw [hVh]; exact hVM) I t' R xs hDG
        (by rw [hVh]; exact hxs))
  have H2 := IRuns.iteF (i := dJ) (f := fun c => c == Cls.neg) (p := genP C q) hcl H
  refine H2.mono ?_
  -- the cost
  rw [hVh]
  have c1 := cAd_le m k Bb (costN C q Bb e V)
  have c2 := costN_real C q Bb hm hruns e he1 V
  have c3 := ovN_le C hm hruns e
  have c4 : (e + 1) * (S + 1) ^ Bit.depH m e ≤ (e + 1) ^ (1 + (S + 1) * c) :=
    ov_pow_le hm _ (hdepc k)
  have c5 : k + 1 ≤ (e + 1) ^ (1 + (S + 1) * c) :=
    le_trans (by omega : k + 1 ≤ e + 1) (Nat.le_self_pow (by omega) _)
  have hcost : Bit.costH C e (V : ℝ) = (V : ℝ) * Bit.cH C e := Bit.costH_lin C e V
  unfold ilCostR
  rw [← he, hcost]
  apply (Nat.cast_le (α := ℝ)).1
  refine le_trans ?_ (Nat.le_ceil _)
  set X : ℝ := ((Bb : ℝ) + 2) ^ 2 with hX
  have hX0 : 0 ≤ X := by positivity
  have r1 : ((cAd m k Bb (costN C q Bb e V) + 25 : ℕ) : ℝ) ≤
      (costN C q Bb e V : ℝ) + (KAd m : ℝ) * (((k + 1 : ℕ) : ℝ) * X) := by
    rw [hX]; exact_mod_cast c1
  have r3 : ((ovN C e : ℕ) : ℝ) ≤ (((e + 1) ^ (1 + (S + 1) * c) : ℕ) : ℝ) := by
    exact_mod_cast le_trans c3 c4
  have r4 : (((k + 1 : ℕ)) : ℝ) ≤ (((e + 1) ^ (1 + (S + 1) * c) : ℕ) : ℝ) := by exact_mod_cast c5
  have hKA : (0 : ℝ) ≤ KA C q := Nat.cast_nonneg _
  have hKAd : (0 : ℝ) ≤ KAd m := Nat.cast_nonneg _
  have r5 : (KA C q : ℝ) * (ovN C e : ℝ) * X ≤
      (KA C q : ℝ) * (((e + 1) ^ (1 + (S + 1) * c) : ℕ) : ℝ) * X :=
    mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left r3 hKA) hX0
  have r6 : (KAd m : ℝ) * (((k + 1 : ℕ) : ℝ) * X) ≤
      (KAd m : ℝ) * ((((e + 1) ^ (1 + (S + 1) * c) : ℕ) : ℝ) * X) :=
    mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right r4 hX0) hKAd
  have r7 : ((((e + 1) ^ (1 + (S + 1) * c) : ℕ) : ℝ)) = (((e : ℕ) : ℝ) + 1) ^ (1 + (S + 1) * c) := by
    push_cast; ring
  rw [r7] at r5 r6
  push_cast at r1 r6 ⊢
  nlinarith [r1, r5, r6, c2]

end

end IntMul.Kappa.R6.IL

