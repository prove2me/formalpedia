open AffineTrace

/-- A residue and explicit finite affine trace, not an asserted theorem. -/
structure Certificate where
  residue : ℕ
  endA : ℕ
  endB : ℕ
  trace : List Step
  deriving DecidableEq, Repr

/-- Each accepted certificate proves eleven-step descent on its entire progression. -/
def Accepted (c : Certificate) : Prop :=
  Valid 262144 c.residue c.endA c.endB c.trace ∧
  c.trace.length = 11 ∧ c.endA ≤ 262144 ∧ c.endB < c.residue

instance (c : Certificate) : Decidable (Accepted c) := by
  unfold Accepted
  infer_instance

def residues (cs : List Certificate) : List ℕ := cs.map Certificate.residue

theorem descent_of_accepted {c : Certificate} (h : Accepted c) (k : ℕ) :
    syracuseStep^[11] (262144 * k + c.residue) < 262144 * k + c.residue := by
  rcases h with ⟨hvalid, hlength, ha, hb⟩
  simpa only [hlength] using AffineTrace.strict_descent hvalid ha hb k

theorem descent_of_residue {c : Certificate} (h : Accepted c)
    (n : ℕ) (hn : n % 262144 = c.residue) : syracuseStep^[11] n < n := by
  have hform : n = 262144 * (n / 262144) + c.residue := by omega
  rw [hform]
  exact descent_of_accepted h (n / 262144)

/-- The proof consumes finite, kernel-checked certificate acceptance, not search output. -/
theorem descent_of_mem (cs : List Certificate) (hchecked : ∀ c ∈ cs, Accepted c)
    (n : ℕ) (h : n % 262144 ∈ residues cs) : syracuseStep^[11] n < n := by
  obtain ⟨c, hc, hr⟩ := List.mem_map.mp h
  exact descent_of_residue (hchecked c hc) n hr.symm

-- A purported exact nonfinal quotient with parameter-dependent parity is rejected.
example : ¬ Valid 4 3 27 25 [⟨1, 6, 5⟩, ⟨1, 9, 8⟩, ⟨0, 27, 25⟩] := by decide

-- The same kind of quotient is sound as a final upper bound, not as an exact step.
example : Valid 6 5 9 8 [⟨1, 9, 8⟩] := by decide

-- An empty trace cannot certify this claimed strict descent.
example : ¬ Accepted ⟨511, 177147, 346, []⟩ := by decide


