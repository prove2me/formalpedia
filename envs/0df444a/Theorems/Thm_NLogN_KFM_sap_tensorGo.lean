theorem NLogN.KFM.sap_tensorGo (p α K : ℕ) (ss ts : List ℕ) (hs : ss.length = K) (ht : ts.length = K)
    (hpos : ∀ i < K, 0 < ss.getD i 1) (g : (Fin K → ℕ) → ℤ × ℤ) :
    Ref.tensorGo ((List.range K).map fun i =>
        (ts.getD i 1, Ref.sapL p (ss.getD i 1) (ts.getD i 1) α)) ss
      (Ref.listOf ss fun j => g fun i => j i) =
    Ref.listOf ts fun j =>
      tensorMapZ (fun i : Fin K => Sapprox p (ss.getD i 1) (ts.getD i 1) α) g fun i => j i := by sorry
