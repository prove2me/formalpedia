    (.seq (.op (.dup rCZ NLogN.KFUU.qZ)) (.seq (rptX nR NLogN.KFUU.lA lC lD (.seq (p1B pM) (.op (.mv tS pS))))
      (.seq (.op (.drop NLogN.KFUU.qB)) (.op (.drop NLogN.KFUU.qZ))))))))

/-- The phase-1 loop alone. -/
def p1L (pM : Fin P) (pS : Fin HS) : IStmt HS P :=
  rptX nR NLogN.KFUU.lA lC lD (.seq (p1B pM) (.op (.mv tS pS)))

