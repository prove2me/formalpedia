variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}
theorem solution (hP : PaperData I f m N w p a) {U : Set (Pt 5)} (hU : IsOpen U)
    (hUI : U ⊆ esDomain I)
    (hpos : ∀ y ∈ U, 0 < f (y 1) ∧ 0 < m (y 1) ∧ 0 < N (y 1) ∧ 0 < alphaSq f m N w p a (y 1))
    (hEin : ∀ y ∈ U, ∀ i j, einsteinMaxwellD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) i j y = 0)
    {V : Pt 5 → Fin 5 → ℝ} (hV : ∀ i, ContDiffOn ℝ 1 (fun y => V y i) U)
    (hNZ : ∀ y ∈ U, V y ≠ 0)
    (hnull : ∀ y ∈ U, contract2 (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y (V y) = 0)
    (hRic : ∀ y ∈ U, contract2 (ricciOf (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w)) y (V y) = 0)
    {x : Pt 5} (hx : x ∈ U) :
    f (x 1) * V x 0 / eFun w p a (x 1) ≠ 0 ∧ V x 1 ≠ 0 ∧
      deriv p (x 1) *
          ((metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x *ᵥ
              accel (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
                (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) V x) 3 +
            (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x *ᵥ
              accel (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
                (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) V x) 4) -
        deriv a (x 1) *
          (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) x *ᵥ
            accel (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
              (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) V x) 0 =
      f (x 1) * V x 0 / eFun w p a (x 1) * V x 1 * Gfun p a (x 1) := by
  have hcls : ∀ y ∈ U, _ := fun y hy =>
    classified_momenta hP (hUI hy) (hpos y hy).1 (hpos y hy).2.1 (hpos y hy).2.2.1
      (hpos y hy).2.2.2 (hEin y hy) (hNZ y hy) (hnull y hy) (hRic y hy)
  have hxD := hUI hx
  have hx1 := hxD.1
  have hE := hP.toESData
  have hg := esMetric_differentiableAt hE hxD
  have hinv := esMetric_mul_inverse hE hxD
  have he := eFun_ne_zero_of_alphaSq_pos (hpos x hx).1 (hpos x hx).2.2.2
  have hVd : ∀ i, DifferentiableAt ℝ (fun y => V y i) x := fun i =>
    ((hV i).contDiffAt (hU.mem_nhds hx)).differentiableAt one_ne_zero
  set ρ : Pt 5 → ℝ := fun y => f (y 1) / eFun w p a (y 1) * V y 0 with hρdef
  have hρd : DifferentiableAt ℝ ρ x :=
    (radial_differentiableAt (x := x) ((hP.df hx1).differentiableAt.div
      (hasDerivAt_eFun hP hx1).differentiableAt he)).mul (hVd 0)
  have hφ0 : DifferentiableAt ℝ (liftRU fun r _ => -deriv p r) x :=
    radial_differentiableAt (hP.d2p hx1).differentiableAt.neg
  have hu : DifferentiableAt ℝ (fun y : Pt 5 => y 2) x := differentiableAt_apply (𝕜 := ℝ) 2 x
  have hφ3 : DifferentiableAt ℝ (liftRU fun r u => -(u * deriv a r)) x :=
    (hu.mul (radial_differentiableAt (hP.d2a hx1).differentiableAt)).neg
  have hφ4 : DifferentiableAt ℝ (liftRU fun r u => -((1 - u) * deriv a r)) x :=
    (((differentiableAt_const (1 : ℝ)).sub hu).mul
      (radial_differentiableAt (hP.d2a hx1).differentiableAt)).neg
  have E0 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ V y) 0)
      (fun y => ρ y * liftRU (fun r _ => -deriv p r) y) U := fun y hy => by
    simp only [(hcls y hy).2.2.1, liftRU_apply, hρdef]; ring
  have E3 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ V y) 3)
      (fun y => ρ y * liftRU (fun r u => -(u * deriv a r)) y) U := fun y hy => by
    simp only [(hcls y hy).2.2.2.1, liftRU_apply, hρdef]; ring
  have E4 : Set.EqOn
      (fun y => (metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ V y) 4)
      (fun y => ρ y * liftRU (fun r u => -((1 - u) * deriv a r)) y) U := fun y hy => by
    simp only [(hcls y hy).2.2.2.2, liftRU_apply, hρdef]; ring
  have c0 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 0) (by decide) (by decide) x (V x)
  have c3 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 3) (by decide) (by decide) x (V x)
  have c4 := sum_pd_esMetric_of_ne f (Dfun f m N) (Afun f m) (Hfun m N) w
    (b := 4) (by decide) (by decide) x (V x)
  have r0 := lower_accel hinv hg hVd 0
  rw [sum_pd_congr (V x) hU hx E0, sum_pd_mul (V x) hρd hφ0, sum_pd_liftRU_gen, c0] at r0
  have r3 := lower_accel hinv hg hVd 3
  rw [sum_pd_congr (V x) hU hx E3, sum_pd_mul (V x) hρd hφ3, sum_pd_liftRU_gen, c3] at r3
  have r4 := lower_accel hinv hg hVd 4
  rw [sum_pd_congr (V x) hU hx E4, sum_pd_mul (V x) hρd hφ4, sum_pd_liftRU_gen, c4] at r4
  have d0r : deriv (fun s => -deriv p s) (x 1) = -deriv (deriv p) (x 1) := (hP.d2p hx1).neg.deriv
  have d3r : deriv (fun s => -(x 2 * deriv a s)) (x 1) = -(x 2 * deriv (deriv a) (x 1)) :=
    ((hP.d2a hx1).const_mul (x 2)).neg.deriv
  have d3u : deriv (fun s => -(s * deriv a (x 1))) (x 2) = -deriv a (x 1) := by simp
  have d4r : deriv (fun s => -((1 - x 2) * deriv a s)) (x 1) =
      -((1 - x 2) * deriv (deriv a) (x 1)) := ((hP.d2a hx1).const_mul (1 - x 2)).neg.deriv
  have d4u : deriv (fun s => -((1 - s) * deriv a (x 1))) (x 2) = deriv a (x 1) := by simp
  simp only [liftRU_apply, d0r, d3r, d3u, d4r, d4u, deriv_const', mul_zero, add_zero] at r0 r3 r4
  refine ⟨(hcls x hx).1, (hcls x hx).2.1, ?_⟩
  rw [r0, r3, r4]
  simp only [Gfun]
  ring
