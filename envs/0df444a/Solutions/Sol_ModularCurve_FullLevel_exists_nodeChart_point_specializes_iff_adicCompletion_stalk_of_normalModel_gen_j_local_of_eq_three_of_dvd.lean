    obtain ⟨hc0, hinv⟩ := (hchar ℓ₂ c).mp h'
    exact (hchar ℓ₁ c).mpr ⟨hc0, key.mpr hinv⟩ h
  · intro h; by_contra h'
    obtain ⟨hc0, hinv⟩ := (hchar ℓ₁ c).mp h'
    exact (hchar ℓ₂ c).mpr ⟨hc0, key.mp hinv⟩ h

