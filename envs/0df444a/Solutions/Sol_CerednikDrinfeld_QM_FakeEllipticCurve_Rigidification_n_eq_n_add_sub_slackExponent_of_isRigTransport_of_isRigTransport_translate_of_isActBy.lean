    (gX : Matrix.GeneralLinearGroup (Fin 2) K₀)
    (εγ : ↥Γt → ↥(Subring.centralizer (Set.range X₀.actEnd ∪ {X₀.varpiEnd}))) (kγ : ↥Γt → ℤ)
    (hεk : ∀ γ : ↥Γt,
      (∀ (B' : Type) [CommRing B'] [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'] (J : Ideal B') (m : ℕ),
          J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B', (∀ i, s i ∈ J) →
