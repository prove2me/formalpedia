theorem G_le_s : axG6 P n src k ≤ 2 * axs6 src k + 1 := by
  have h1 := Val.pow_clog_le (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length
  have h2 := LJ_length_le_s (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)
  show 2 ^ Nat.clog 2 (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length ≤ _
  omega

theorem bc_ax : axBc6 P n src k ap ≤ axQ6 P n src k + ap.bcC ∧
    axBc6 P n src k ap ≤ 2 * ℓP6 P n + 6 + ap.bcC := by
  have hG := G_le_s h
  have hws := h.seg.hw
  have hp3 : 3 ≤ pP6 P n := by have := b'P6_pos P n; unfold pP6; omega
  have hQ : Nat.size (axG6 P n src k + 2 * axw6 P n + 3 * axs6 src k ^ 2 +
      2 * axw6 P n * axs6 src k + 10 * axs6 src k) ≤ axQ6 P n src k :=
    Val.bc_le' hG hws (Val.s_sq16 hp3)
  have hl : 16 * (axs6 src k + 1) ^ 2 < 2 ^ (2 * ℓP6 P n + 6) := by
    have h1 : axs6 src k + 1 < 2 ^ (ℓP6 P n + 1) := by
      have := h.st; have := h.tl; rw [pow_succ]
      have : 2 ^ 1 ≤ 2 ^ ℓP6 P n := Nat.pow_le_pow_right (by norm_num) h.ℓ1
      omega
    have h2 : (axs6 src k + 1) ^ 2 < (2 ^ (ℓP6 P n + 1)) ^ 2 := Nat.pow_lt_pow_left h1 (by norm_num)
    have e : 2 ^ (2 * ℓP6 P n + 6) = 16 * (2 ^ (ℓP6 P n + 1)) ^ 2 := by
      rw [← pow_mul, show 16 = 2 ^ 4 by norm_num, ← pow_add]; ring_nf
    omega
  have hL := Val.bc_le' hG hws hl
  constructor
  · show Nat.size _ + ap.bcC ≤ _; omega
  · show Nat.size _ + ap.bcC ≤ _; omega

end ax

