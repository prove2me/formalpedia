theorem phiK_pack (N₀ q : ℕ) [NeZero N₀] [Fact q.Prime] (hqN : ¬ q ∣ N₀) (𝔓 : DRModelPackageLevel N₀ q hqN)
    (κ : Type) [Field κ] [CharP κ q] [IsAlgClosed κ] [DecidableEq κ] (toκ : DRLevel.R q →+* κ) :
    ∃ (_ : IsFinite (𝔓.comp κ toκ 1 ≫ DRLevel.fibreMap0 𝔓.π toκ))
      (_ : Flat (𝔓.comp κ toκ 1 ≫ DRLevel.fibreMap0 𝔓.π toκ))
      (_ : LocallyOfFinitePresentation (𝔓.comp κ toκ 1 ≫ DRLevel.fibreMap0 𝔓.π toκ)),
      (𝔓.comp κ toκ 1 ≫ DRLevel.fibreMap0 𝔓.π toκ) ≫ pullback.snd (DRLevel.toBase0 N₀ q) (Spec.map (CommRingCat.ofHom toκ)) =
        pullback.snd (DRLevel.toBase0 N₀ q) (Spec.map (CommRingCat.ofHom toκ)) ∧
      ∀ y, (𝔓.comp κ toκ 1 ≫ DRLevel.fibreMap0 𝔓.π toκ).finrank y = q := by
  obtain ⟨hfin, hlfp, hflat, hrk⟩ := ModularCurve.DRModelPackageLevel.isFinite_flat_finrank_comp_one_pi N₀ q hqN 𝔓 κ toκ
  refine ⟨hfin, hflat, hlfp, ?_, hrk⟩
  rw [Category.assoc, DRLevel.fibreMap0, pullback.lift_snd, ← Category.assoc, 𝔓.comp_over κ toκ 1, Category.comp_id]

