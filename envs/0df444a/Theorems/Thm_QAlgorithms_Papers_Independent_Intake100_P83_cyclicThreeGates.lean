-- title:
--   Explicit cyclic synthesis retains exchange and p-excitation flips
-- statement:
--   Let $p\ge2$ and $n\ge p$, and use the qubit action $u(a)=\operatorname{diag}(1,e^{2\pi i a/p})$ of $\mathbb Z_p$. Start with $S$, all four phase gates $I-2|ab\rangle\langle ab|$, and the exchange rotations $e^{i\theta(XX+YY)}$ on arbitrary sites. Add the rotations generated by the $p$-excitation flip
--
--   $$
--   X_p=|0^p\rangle\langle1^p|+|1^p\rangle\langle0^p|.
--   $$
--
--   Let $\mathcal F_p$ be this full family, with every continuous angle in $[0,2\pi)$. If $\mathcal H_\mu$ are the full sectors of Hamming weight modulo $p$, then
--
--   $$
--   \bigoplus_\mu SU(\mathcal H_\mu)\subseteq\langle\mathcal F_p\rangle_{\mathrm{finite}}
--   \subseteq\mathcal V^{\mathbb Z_p}_{n,p}.
--   $$
--
--   The exchange and simultaneous-flip operations together redistribute charge within each cyclic sector.
-- source:
--   Theory of Quantum Circuits with Abelian Symmetries, arXiv:2302.12466v3, PDF p. 9, V example, unnumbered: explicit Zp gate synthesis

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P83

noncomputable section

open scoped BigOperators ComplexConjugate Matrix Kronecker Manifold ContDiff

attribute [local instance] Classical.propDecidable

open QAlgorithms.Papers.Independent.Information100.P21 (Op)

namespace QAlgorithms.Papers.Independent.Intake100.P83

variable {A G : Type*} [Fintype A] [DecidableEq A]

/-- PDF p.9: add the p-excitation flip to the complete U(1) family to obtain
Z_p semi-universality; both exchange and flip families are retained. -/
theorem cyclicThreeGates (p n : ℕ) (hp : 2 ≤ p) (hpn : p ≤ n) :
    blockSpecial (sameCharge (cyclicPhases p) n) ⊆ finiteGateProducts (cyclicSynthesisGates p n) ∧
    finiteGateProducts (cyclicSynthesisGates p n) ⊆ symmetricLocalGroup (cyclicPhases p) n p := by sorry

end QAlgorithms.Papers.Independent.Intake100.P83

end
