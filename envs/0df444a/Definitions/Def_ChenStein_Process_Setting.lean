-- title:
--   §2, p. 10 — dependent Bernoulli family, p_α, p_{αβ}, b₁, b₂, b₃, block sums W_j, λ_j; §6, p. 22 — the coordinatewise operators S_i, T_i, P_i, Δ_i
-- statement:
--   This file fixes the objects of Arratia, Goldstein and Gordon (1989), §2 and §6, used in the process version of the Chen–Stein bound.
--
--   **Bernoulli family.** Let $(\Omega,\mathcal F,P)$ be a probability space, $I$ an index set, and $(X_\alpha)_{\alpha\in I}$ a family of $\{0,1\}$-valued random variables. Write
--   $$p_\alpha = P(X_\alpha = 1),\qquad p_{\alpha\beta} = E(X_\alpha X_\beta).$$
--
--   **Neighbourhoods of dependence.** For each $\alpha$ a set $B_\alpha\subseteq I$ is chosen. The three dependence coefficients are
--   $$b_1=\sum_{\alpha\in I}\sum_{\beta\in B_\alpha}p_\alpha p_\beta,\qquad b_2=\sum_{\alpha\in I}\sum_{\alpha\ne\beta\in B_\alpha}p_{\alpha\beta},\qquad b_3=\sum_{\alpha\in I}s_\alpha,$$
--   where
--   $$s_\alpha = E\bigl|E\{X_\alpha-p_\alpha\mid\sigma(X_\beta:\beta\in I-B_\alpha)\}\bigr|.$$
--   The coefficients take values in $[0,\infty]$; a divergent series gives the value $+\infty$.
--
--   **Processes and block sums.** The process $\mathbf X=(X_\alpha)_{\alpha\in I}$ is viewed as one random element of $\mathbb Z_+^I$ (product σ-algebra). For a partition of $I$ into blocks $I(1),\dots,I(d)$, given by a map $\mathrm{part}:I\to\{1,\dots,d\}$, the block sums and their means are
--   $$W_j=\sum_{\alpha\in I(j)}X_\alpha,\qquad \lambda_j=\sum_{\alpha\in I(j)}p_\alpha = EW_j,$$
--   and $(W_1,\dots,W_d)$ is one random element of $\mathbb Z_+^d$. The same constructions applied to another family (the Poisson family $Y$, or an independent copy $X'$) give $\mathbf Y$ and $(Z_1,\dots,Z_d)$.
--
--   **Coordinatewise Stein operators** (§6). For functions $f,h:\mathbb Z_+^d\to\mathbb R$, a coordinate $i$, a parameter $\lambda_i\ge0$, a Poisson variable $Z_i$ with mean $\lambda_i$, and the unit vector $e_i$:
--   $$(T_if)(j)=j_if(j)-\lambda_if(j+e_i),$$
--   $$(S_ih)(j+e_i)=-\bigl(\lambda_iP(Z_i=j_i)\bigr)^{-1}E\{h(j_1,\dots,Z_i,\dots,j_d)\,1(Z_i\le j_i)\},$$
--   $$(P_ih)(j)=E\,h(j_1,\dots,Z_i,\dots,j_d),\qquad (\Delta_if)(j)=f(j+e_i)-f(j).$$
--   The value of $S_ih$ at points with $j_i=0$ is set to $0$, as the paper does for the one-variable operator $S$ in §4.
--
--   These objects are the vocabulary of Theorems 2 and 3 and of the proof of Theorem 2 in §6.
--
--   **Formalization Note** The index set is a type, the variables are $\mathbb N$-valued, and $p_\alpha$ is `P.real {X α = 1}`. $b_1,b_2,b_3$ and $s_\alpha$ are $[0,\infty]$-valued (ENNReal sums and a lower Lebesgue integral of $\|\cdot\|_e$), so no divergent series silently becomes $0$. The σ-algebra $\sigma(X_\beta:\beta\notin B_\alpha)$ is the supremum of the pullbacks of the discrete σ-algebra along the $X_\beta$. $W_j$ is an $\mathbb N$-valued `tsum`; it equals the true sum almost surely whenever $\sum p_\alpha<\infty$ (only finitely many $X_\alpha=1$), and differs only on a null set. $\lambda_j$ is a real `tsum`, a genuine sum whenever $p$ is summable. The process of a second family is `Xproc Y` and its block sums `Wvec Y part`; no separate `Yproc`/`Zvec` is declared. Coordinates run over `Fin d`, so the paper's coordinate $1$ is Lean's `0`. $P(Z_i = n)$ is `(poissonMeasure λ_i).real {n}`, and $S_ih$ is written at a point whose $i$-th coordinate is $n+1$, with $j_i = n$ and $h(j_1,\dots,k,\dots,j_d)$ read as `h (Function.update j i k)`.
-- source:
--   Arratia, Goldstein and Gordon, Two moments suffice for Poisson approximations: the Chen-Stein method, Ann. Probab. 17 (1989), p. 10, §2 (definitions of p_α, p_{αβ}, b₁, b₂, b₃, s_α); p. 11, Theorem 2 display (2); p. 22, §6 (S_i, T_i, P_i, Δ_i)

import Mathlib
import Definitions.Def_TotalVariationDist

namespace ChenStein.Process

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

variable {Ω : Type*} [MeasurableSpace Ω] {I : Type*}

/-- `p_α = P(X_α = 1)`, the success probability of the Bernoulli variable `X_α`. -/
noncomputable def p (P : Measure Ω) (X : I → Ω → ℕ) (α : I) : ℝ :=
  P.real {ω | X α ω = 1}

/-- `p_{αβ} = E(X_α X_β)`. -/
noncomputable def pab (P : Measure Ω) (X : I → Ω → ℕ) (α β : I) : ℝ :=
  ∫ ω, ((X α ω : ℝ) * (X β ω : ℝ)) ∂P

/-- `σ(X_β : β ∈ I − B_α)`, the σ-algebra generated by the variables outside the
neighbourhood of dependence `B_α`. -/
@[instance_reducible]
noncomputable def farSigma (X : I → Ω → ℕ) (B : I → Set I) (α : I) : MeasurableSpace Ω :=
  ⨆ β ∈ (B α)ᶜ, MeasurableSpace.comap (X β) inferInstance

/-- `s_α = E|E{X_α − p_α | σ(X_β : β ∈ I − B_α)}|`, valued in `ℝ≥0∞`. -/
noncomputable def s (P : Measure Ω) (X : I → Ω → ℕ) (B : I → Set I) (α : I) : ℝ≥0∞ :=
  ∫⁻ ω, ‖(condExp (farSigma X B α) P (fun ω => (X α ω : ℝ) - p P X α)) ω‖ₑ ∂P

/-- `b₁ = Σ_{α ∈ I} Σ_{β ∈ B_α} p_α p_β`, valued in `ℝ≥0∞`. -/
noncomputable def b1 (P : Measure Ω) (X : I → Ω → ℕ) (B : I → Set I) : ℝ≥0∞ :=
  ∑' α, ∑' β : B α, ENNReal.ofReal (p P X α * p P X β)

/-- `b₂ = Σ_{α ∈ I} Σ_{α ≠ β ∈ B_α} p_{αβ}`, valued in `ℝ≥0∞`. -/
noncomputable def b2 (P : Measure Ω) (X : I → Ω → ℕ) (B : I → Set I) : ℝ≥0∞ :=
  ∑' α, ∑' β : {β // β ∈ B α ∧ β ≠ α}, ENNReal.ofReal (pab P X α β)

/-- `b₃ = Σ_{α ∈ I} s_α`, valued in `ℝ≥0∞`. -/
noncomputable def b3 (P : Measure Ω) (X : I → Ω → ℕ) (B : I → Set I) : ℝ≥0∞ :=
  ∑' α, s P X B α

/-- The process `(X_α)_{α ∈ I}` as one random element of `ℕ^I`. -/
def Xproc (X : I → Ω → ℕ) : Ω → (I → ℕ) := fun ω α => X α ω

/-- The block sums `W_j = Σ_{α ∈ I(j)} X_α` of a partition `I(j) = part⁻¹{j}`,
as one random element of `ℕ^d` (ℕ-valued `tsum`). -/
noncomputable def Wvec {d : ℕ} (X : I → Ω → ℕ) (part : I → Fin d) : Ω → (Fin d → ℕ) :=
  fun ω j => ∑' α : {α // part α = j}, X α ω

/-- `λ_j = Σ_{α ∈ I(j)} p_α = E W_j`. -/
noncomputable def lamj {d : ℕ} (P : Measure Ω) (X : I → Ω → ℕ) (part : I → Fin d)
    (j : Fin d) : ℝ :=
  ∑' α : {α // part α = j}, p P X α

/-! ### Coordinatewise Stein operators on functions `(ℤ⁺)^d → ℝ` (§6, p. 22) -/

/-- The unit vector `e_i`. -/
def e {d : ℕ} (i : Fin d) : Fin d → ℕ := Pi.single i 1

/-- `(T_i f)(j) = j_i f(j) − λ_i f(j + e_i)`. -/
noncomputable def Ti {d : ℕ} (i : Fin d) (lj : ℝ≥0) (f : (Fin d → ℕ) → ℝ)
    (j : Fin d → ℕ) : ℝ :=
  (j i : ℝ) * f j - (lj : ℝ) * f (j + e i)

/-- `(S_i h)(j + e_i) = −(λ_i P(Z_i = j_i))^{−1} E{h(j₁,…,Z_i,…,j_d) 1(Z_i ≤ j_i)}`,
read at a point whose `i`-th coordinate is `n + 1`; the value at a point whose
`i`-th coordinate is `0` is fixed to `0`, as for `S` in §4. -/
noncomputable def Si {d : ℕ} (i : Fin d) (lj : ℝ≥0) (h : (Fin d → ℕ) → ℝ)
    (j : Fin d → ℕ) : ℝ :=
  match j i with
  | 0 => 0
  | n + 1 => -((lj : ℝ) * (poissonMeasure lj).real {n})⁻¹ *
      ∑ k ∈ Finset.range (n + 1), h (Function.update j i k) * (poissonMeasure lj).real {k}

/-- `(P_i h)(j) = E h(j₁,…,Z_i,…,j_d)` with `Z_i ~ Poisson(λ_i)`. -/
noncomputable def Pi_ {d : ℕ} (i : Fin d) (lj : ℝ≥0) (h : (Fin d → ℕ) → ℝ)
    (j : Fin d → ℕ) : ℝ :=
  ∫ k, h (Function.update j i k) ∂(poissonMeasure lj)

/-- `(Δ_i f)(j) = f(j + e_i) − f(j)`. -/
def Δi {d : ℕ} (i : Fin d) (f : (Fin d → ℕ) → ℝ) (j : Fin d → ℕ) : ℝ :=
  f (j + e i) - f j

end ChenStein.Process


