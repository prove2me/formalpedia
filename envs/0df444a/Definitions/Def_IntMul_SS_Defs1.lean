section
-- Source module: NLogNP.Flat
/-!
# Flat code with jumps, and compilation of structured programs into it

Instructions carry absolute addresses. `ret` with an empty control stack halts.
`exec_flat`: a structured run of cost `c` is `c` flat steps.
-/

namespace NLogN

inductive Instr (S : ℕ) where
  | jmp (e : ℕ)
  | push (i : Fin S) (a : Sym) (e : ℕ)
  | pop (i : Fin S) (e : ℕ)
  | inRd (i : Fin S) (e : ℕ)
  | out (b : Bool) (e : ℕ)
  | br (i : Fin S) (f : Option Sym → Bool) (y n : ℕ)
  | call (t e : ℕ)
  | ret

/-- Flat configuration: program counter, state, control stack of return addresses. -/
structure Cfg (S : ℕ) where
  pc : ℕ
  σ : St S
  ctl : List ℕ

variable {S P : ℕ}

/-- One step; `none` when halted (`ret` on an empty control stack). -/
def fstep (I : List Sym) (code : ℕ → Instr S) (c : Cfg S) : Option (Cfg S) :=
  match code c.pc with
  | .jmp e => some ⟨e, c.σ, c.ctl⟩
  | .push i a e => some ⟨e, c.σ.push i a, c.ctl⟩
  | .pop i e => some ⟨e, c.σ.pop i, c.ctl⟩
  | .inRd i e => some ⟨e, c.σ.inRd I i, c.ctl⟩
  | .out b e => some ⟨e, c.σ.outB b, c.ctl⟩
  | .br i f y n => some ⟨if f (c.σ.top i) then y else n, c.σ, c.ctl⟩
  | .call t e => some ⟨t, c.σ, e :: c.ctl⟩
  | .ret => match c.ctl with
    | [] => none
    | e :: l => some ⟨e, c.σ, l⟩

/-- `n` steps from one configuration to another. -/
inductive Steps (I : List Sym) (code : ℕ → Instr S) : Cfg S → ℕ → Cfg S → Prop
  | refl (c) : Steps I code c 0 c
  | step {c c' c'' n} : fstep I code c = some c' → Steps I code c' n c'' → Steps I code c (n + 1) c''

/-! ## Layout -/

/-- Number of instructions of a statement. -/
def Stmt.size : Stmt S P → ℕ
  | .skip => 1
  | .push _ _ => 1
  | .pop _ => 1
  | .inRd _ => 1
  | .out _ => 1
  | .seq p q => p.size + q.size
  | .ite _ _ p q => 1 + p.size + q.size
  | .loop _ _ p => 1 + p.size
  | .call _ => 1

/-- `Placed code s a e ent`: the code of `s` sits at `[a, a + s.size)` and exits to `e`;
procedure `j` starts at `ent j`. -/
def Placed (code : ℕ → Instr S) (ent : Fin P → ℕ) : Stmt S P → ℕ → ℕ → Prop
  | .skip, a, e => code a = .jmp e
  | .push i x, a, e => code a = .push i x e
  | .pop i, a, e => code a = .pop i e
  | .inRd i, a, e => code a = .inRd i e
  | .out b, a, e => code a = .out b e
  | .seq p q, a, e => Placed code ent p a (a + p.size) ∧ Placed code ent q (a + p.size) e
  | .ite i f p q, a, e => code a = .br i f (a + 1) (a + 1 + p.size) ∧
      Placed code ent p (a + 1) e ∧ Placed code ent q (a + 1 + p.size) e
  | .loop i f p, a, e => code a = .br i f (a + 1) e ∧ Placed code ent p (a + 1) a
  | .call j, a, e => code a = .call (ent j) e

/-- The procedures are placed at their entries, each followed by `ret`. -/
def ProgPlaced (code : ℕ → Instr S) (prog : Fin P → Stmt S P) (ent : Fin P → ℕ) : Prop :=
  ∀ j, Placed code ent (prog j) (ent j) (ent j + (prog j).size) ∧
    code (ent j + (prog j).size) = .ret

/-! ## A concrete layout -/

/-- The instruction at address `x` of `s` placed at `a` with exit `e`, if `x` is inside. -/
def Stmt.instrAt (ent : Fin P → ℕ) : Stmt S P → ℕ → ℕ → ℕ → Option (Instr S)
  | .skip, a, e, x => if x = a then some (.jmp e) else none
  | .push i y, a, e, x => if x = a then some (.push i y e) else none
  | .pop i, a, e, x => if x = a then some (.pop i e) else none
  | .inRd i, a, e, x => if x = a then some (.inRd i e) else none
  | .out b, a, e, x => if x = a then some (.out b e) else none
  | .seq p q, a, e, x =>
    if x < a + p.size then p.instrAt ent a (a + p.size) x else q.instrAt ent (a + p.size) e x
  | .ite i f p q, a, e, x =>
    if x = a then some (.br i f (a + 1) (a + 1 + p.size))
    else if x < a + 1 + p.size then p.instrAt ent (a + 1) e x
    else q.instrAt ent (a + 1 + p.size) e x
  | .loop i f p, a, e, x =>
    if x = a then some (.br i f (a + 1) e) else p.instrAt ent (a + 1) a x
  | .call j, a, e, x => if x = a then some (.call (ent j) e) else none

/-- Entry of procedure `j`: procedures are laid out one after another, each followed by `ret`. -/
def entryOf (prog : Fin P → Stmt S P) (j : ℕ) : ℕ :=
  ((List.range j).map fun i => if h : i < P then (prog ⟨i, h⟩).size + 1 else 0).sum

theorem entryOf_succ (prog : Fin P → Stmt S P) (j : Fin P) :
    entryOf prog (j.val + 1) = entryOf prog j + (prog j).size + 1 := by
  simp [entryOf, List.range_succ, j.isLt, Nat.add_assoc]

theorem entryOf_mono (prog : Fin P → Stmt S P) {i j : ℕ} (h : i ≤ j) :
    entryOf prog i ≤ entryOf prog j := by
  induction h with
  | refl => exact le_refl _
  | step _ ih =>
    refine ih.trans ?_
    simp [entryOf, List.range_succ]

/-- Total code length. -/
def codeLen (prog : Fin P → Stmt S P) : ℕ := entryOf prog P

/-- The procedure whose code contains address `x`. -/
def procAt (prog : Fin P → Stmt S P) (x : ℕ) : Option (Fin P) :=
  (List.finRange P).find? (fun j : Fin P => decide (entryOf prog j ≤ x ∧
    x < entryOf prog j + (prog j).size))

/-- The flat code of a program. Addresses outside the code hold `ret`. -/
def codeOf (prog : Fin P → Stmt S P) (x : ℕ) : Instr S :=
  match procAt prog x with
  | some j => ((prog j).instrAt (fun j => entryOf prog j) (entryOf prog j)
      (entryOf prog j + (prog j).size) x).getD .ret
  | none => .ret

/-- Addresses used by the code are below `codeLen`. -/
theorem entryOf_le_codeLen (prog : Fin P → Stmt S P) (j : Fin P) :
    entryOf prog j + (prog j).size + 1 ≤ codeLen prog := by
  rw [← entryOf_succ]; exact entryOf_mono prog j.isLt

end NLogN

end

section
-- Source module: NLogNP.Basic
/-!
# A relaxed machine layer over `IntMul.MultitapeTM`

`Prog Γ k` is a deterministic `k`-tape machine over an arbitrary alphabet whose transition
function returns `none` to halt.  Its step semantics silently enforce the platform rules
(`▷` is kept and never written elsewhere, no left move from `▷`, tape `0` is read-only), so
`compile` turns any program into a `MultitapeTM` with one extra step.
-/

namespace IntMul.Mach

open IntMul

variable {Γ : Type} {k : ℕ}

/-- Tape contents and head positions. -/
structure Tapes (Γ : Type) (k : ℕ) where
  cells : Fin k → ℕ → Γ
  head : Fin k → ℕ

/-- Head movement, in the same shape as `MultitapeTM.step`. -/
def moveHead (m : Move) (h : ℕ) : ℕ :=
  match m with
  | Move.left => h - 1
  | Move.stay => h
  | Move.right => h + 1

namespace Tapes

/-- The scanned symbols. -/
def read (T : Tapes Γ k) : Fin k → Γ := fun i => T.cells i (T.head i)

/-- Write and move on every tape. -/
def write (T : Tapes Γ k) (w : Fin k → Γ × Move) : Tapes Γ k where
  cells i := Function.update (T.cells i) (T.head i) (w i).1
  head i := moveHead (w i).2 (T.head i)

end Tapes

/-- The action actually performed: `▷` is kept and never moved left from, `▷` is never written
elsewhere, and tape `0` is read-only. -/
def fix [DecidableEq Γ] (st : Γ) (a : Fin k → Γ) (w : Fin k → Γ × Move) : Fin k → Γ × Move :=
  fun i =>
    if a i = st then (st, if (w i).2 = Move.left then Move.stay else (w i).2)
    else ((if i.val = 0 ∨ (w i).1 = st then a i else (w i).1), (w i).2)

/-- A relaxed program: `δ` returns `none` to halt. -/
structure Prog (Γ : Type) (k : ℕ) where
  Q : Type
  [fintypeQ : Fintype Q]
  q0 : Q
  δ : Q → (Fin k → Γ) → Option (Q × (Fin k → Γ × Move))

attribute [instance] Prog.fintypeQ

section Sem

variable [DecidableEq Γ] (st : Γ)

/-- `Halts st P q T t T'`: started in state `q` on tapes `T`, the program halts after exactly
`t` steps with tapes `T'`. -/
inductive Halts (P : Prog Γ k) : P.Q → Tapes Γ k → ℕ → Tapes Γ k → Prop
  | done {q : P.Q} {T : Tapes Γ k} : P.δ q T.read = none → Halts P q T 0 T
  | step {q q' : P.Q} {T T' : Tapes Γ k} {w : Fin k → Γ × Move} {t : ℕ} :
      P.δ q T.read = some (q', w) → Halts P q' (T.write (fix st T.read w)) t T' →
        Halts P q T (t + 1) T'

/-- Run from the start state. -/
def Runs (P : Prog Γ k) (T : Tapes Γ k) (t : ℕ) (T' : Tapes Γ k) : Prop :=
  Halts st P P.q0 T t T'

variable {st}

end Sem

/-! ## Combinators -/

section CombSem

variable [DecidableEq Γ] {st : Γ}

end CombSem

/-! ## Compilation to the platform model -/

/-- The five distinguished symbols of the platform model. -/
structure Syms (Γ : Type) where
  blank : Γ
  st : Γ
  zero : Γ
  one : Γ
  sep : Γ
  nodup : [blank, st, zero, one, sep].Nodup

variable [DecidableEq Γ] [Fintype Γ]

/-- The platform machine running `P`; one extra step moves to `HALT`. -/
def compile (S : Syms Γ) (hk : 2 ≤ k) (P : Prog Γ k) : MultitapeTM where
  Sym := Γ
  blank := S.blank
  startSym := S.st
  zero := S.zero
  one := S.one
  sep := S.sep
  syms_distinct := S.nodup
  K := Option P.Q
  qStart := some P.q0
  qHalt := none
  start_ne_halt := by simp
  k := k
  two_le_k := hk
  δ q a := match q with
    | none => (none, fun i => (a i, Move.stay))
    | some q => match P.δ q a with
      | none => (none, fun i => (a i, Move.stay))
      | some r => (some r.1, fix S.st a r.2)
  start_preserved := by
    intro q a i hi
    rcases q with _ | q
    · simp [hi]
    · rcases h : P.δ q a with _ | r <;> simp only [h]
      · simp [hi]
      · simp only [fix, hi, if_true]
        split_ifs with hm <;> simp_all
  start_only_at_start := by
    intro q a i hi
    rcases q with _ | q
    · simpa using hi
    · rcases h : P.δ q a with _ | r <;> simp only [h]
      · simpa using hi
      · simp only [fix, hi, if_false]
        split_ifs with h'
        · exact hi
        · simp_all
  halt_fixed := fun _ => rfl
  input_readonly := by
    intro q a
    rcases q with _ | q
    · rfl
    · rcases h : P.δ q a with _ | r <;> simp only [h]
      simp only [fix]
      split_ifs <;> simp_all

/-- A configuration of the compiled machine. -/
def toCfg (S : Syms Γ) (hk : 2 ≤ k) (P : Prog Γ k) (q : Option P.Q) (T : Tapes Γ k) :
    (IntMul.Mach.compile S hk P).Cfg :=
  ⟨q, T.cells, T.head⟩

/-- The platform's initial tapes on input `x#y`. -/
def initTapes (S : Syms Γ) (hk : 2 ≤ k) (x y : List Bool) : Tapes Γ k :=
  ⟨fun i => if i.val = 0 then
      (fun p => match p with
        | 0 => S.st
        | p + 1 => ((x.map (fun b => if b then S.one else S.zero)) ++
            S.sep :: y.map (fun b => if b then S.one else S.zero)).getD p S.blank)
      else (fun p => match p with
        | 0 => S.st
        | _ + 1 => S.blank),
   fun _ => 0⟩

/-- The tape `▷ w □ □ …`. -/
def tapeOf (S : Syms Γ) (w : List Γ) : ℕ → Γ
  | 0 => S.st
  | p + 1 => w.getD p S.blank

/-- Encoding of a bit. -/
def bitSym (S : Syms Γ) (b : Bool) : Γ := if b then S.one else S.zero

end IntMul.Mach

end

