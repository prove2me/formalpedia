  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have hℓNrp : ¬ ℓ ∣ N * r * p := fun h => hℓM (h.mul_right _)
  have hℓNr : ¬ ℓ ∣ N * r := fun h => hℓNrp (h.mul_right _)
