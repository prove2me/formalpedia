      rw [morphismRestrict_base_coe]
      exact hw
    · exact absurd ⟨w, hw⟩ hz
  haveI := hsurj
  haveI : IsReduced (Ω : Scheme) := isReduced_of_isOpenImmersion Ω.ι
  haveI : IsIso (i₁ ∣_ Ω) := isIso_of_isClosedImmersion_of_surjective _
