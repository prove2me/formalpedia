-- title:
--   Equal fibre ranks at a finite point and at ∞
-- statement:
--   Fix a field $K$ and three commutative rings $D$, $E$, $O$ in a common universe, with $D$ and $E$ integral domains, each of the three a $K$-algebra, and let $\varphi : D \to O$ and $\psi : E \to O$ be $K$-algebra homomorphisms. Let $a \in D$ and $b \in E$. Assume that, when $O$ is viewed as a $D$-algebra through $\varphi$, it is a localisation of $D$ away from $a$ (that is, $O = D[1/a]$), and that, when viewed as an $E$-algebra through $\psi$, it is a localisation of $E$ away from $b$ (that is, $O = E[1/b]$); assume moreover that $\varphi(a)\,\psi(b) = 1$ in $O$. Assume that the $K$-algebra map $K[X] \to D$ sending $X \mapsto a$ is a finite ring homomorphism, i.e. $D$ is module-finite over $K[X]$ via $a$, and likewise that $K[X] \to E$, $X \mapsto b$, is finite; assume finally that $K[X] \to D$, $X \mapsto a$, is injective, i.e. $a$ is transcendental over $K$. Then for every $x \in K$ the two quotients have the same dimension as $K$-vector spaces: $\dim_K D/(a - x) = \dim_K E/(b)$, where the ideals are those generated by $a - x\cdot 1_D$ and by $b$ respectively. No transcendence hypothesis is imposed on $b$.
--
--   This is the purely algebraic statement behind the equality of fibre degrees of a finite map to $\mathbb{P}^1_K$ presented by two affine charts $\operatorname{Spec} D \to \mathbb{A}^1$ and $\operatorname{Spec} E \to \mathbb{A}^1$ glued along $\mathbb{G}_m$ by $b = 1/a$: the fibre over a finite point $x \in K$ and the fibre over $\infty$ have equal $K$-dimension. It is used in the computation of the $K$-dimension of level sets attached to a two-chart pole datum on a smooth proper curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Algebra_finrank_quotient_span_sub_eq_of_isLocalization_away_of_mul_eq_one.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u

open Polynomial

theorem Algebra.finrank_quotient_span_sub_eq_of_isLocalization_away_of_mul_eq_one
    {K : Type u} [Field K] {D E O : Type u} [CommRing D] [CommRing E] [CommRing O]
    [IsDomain D] [IsDomain E] [Algebra K D] [Algebra K E] [Algebra K O]
    (φ : D →ₐ[K] O) (ψ : E →ₐ[K] O) (a : D) (b : E)
    (hφ : letI := φ.toRingHom.toAlgebra; IsLocalization.Away a O)
    (hψ : letI := ψ.toRingHom.toAlgebra; IsLocalization.Away b O)
    (hab : φ a * ψ b = 1)
    (hfinD : (Polynomial.aeval a : K[X] →ₐ[K] D).toRingHom.Finite)
    (hfinE : (Polynomial.aeval b : K[X] →ₐ[K] E).toRingHom.Finite)
    (hinj : Function.Injective (Polynomial.aeval a : K[X] →ₐ[K] D))
    (x : K) :
    Module.finrank K (D ⧸ Ideal.span {a - algebraMap K D x}) =
      Module.finrank K (E ⧸ Ideal.span {b}) := by sorry
