-- title:
--   Theorem 5.1 — exp(−itA) is a strongly continuous unitary group generated by A
-- statement:
--   Let $A$ be a self-adjoint operator in a complex Hilbert space $\mathfrak H$ and $U(t) = \mathrm e^{-\mathrm itA}$, $t \in \mathbb R$. Then:
--
--   (i) $U(t)$ is a strongly continuous one-parameter unitary group: each $U(t)$ is unitary, $U(0) = \mathbb I$, $U(t+s) = U(t)U(s)$, and $t \mapsto U(t)\psi$ is continuous for every $\psi \in \mathfrak H$.
--
--   (ii) The limit $\lim_{t\to 0} \frac1t (U(t)\psi - \psi)$ exists if and only if $\psi \in \mathfrak D(A)$, in which case
--   $$\lim_{t\to 0} \frac1t \big(U(t)\psi - \psi\big) = -\mathrm i A\psi .$$
--
--   (iii) $U(t)\mathfrak D(A) = \mathfrak D(A)$ and $AU(t) = U(t)A$.
--
--   This makes $\psi(t) = \mathrm e^{-\mathrm itA}\psi$ the solution of the Schrödinger equation and identifies $A$ as the generator of the group.
--
--   **Formalization Note.** $A$ is a self-adjoint `LinearPMap`, and $\mathrm e^{-\mathrm itA}$ is defined through a projection-valued measure $P$ taken as data with $A = \int\lambda\, dP(\lambda)$ (the form the spectral theorem provides). Unitarity is membership in `unitary (H →L[ℂ] H)`. The limit $t \to 0$ is over $t \neq 0$. $AU(t) = U(t)A$ is stated on $\mathfrak D(A)$: for $\psi \in \mathfrak D(A)$, $A U(t)\psi = U(t) A\psi$, together with $U(t)\mathfrak D(A) = \mathfrak D(A)$.
-- source:
--   Teschl, Mathematical Methods in Quantum Mechanics, AMS GSM 99, 2009, pp. 123–124, Theorem 5.1

import Mathlib
import Definitions.Def_TeschlQM_Shared_IsProjValuedMeasure
import Definitions.Def_TeschlQM_Shared_IsSpectralIntegral
import Definitions.Def_TeschlQM_Shared_timeEvolution

open Filter Topology

namespace TeschlQM.Dynamics

/-- Teschl, Theorem 5.1, pp. 123–124: let `A` be self-adjoint, `A = ∫ λ dP(λ)`, and
`U(t) = exp(−itA)`. (i) `U(t)` is a strongly continuous one-parameter unitary group (2.9)–(2.10):
each `U(t)` is unitary, `U(0) = 𝕀`, `U(t + s) = U(t)U(s)` and `t ↦ U(t)ψ` is continuous for every
`ψ`. (ii) `lim_{t→0} (1/t)(U(t)ψ − ψ)` exists iff `ψ ∈ 𝔇(A)`, and then it equals `−iAψ`.
(iii) `U(t)𝔇(A) = 𝔇(A)` and `AU(t) = U(t)A` on `𝔇(A)`. -/
theorem timeEvolution_group {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    [CompleteSpace H] (A : H →ₗ.[ℂ] H) (hA : IsSelfAdjoint A)
    (P : Set ℝ → (H →L[ℂ] H)) (hP : TeschlQM.Shared.IsProjValuedMeasure P)
    (hAP : TeschlQM.Shared.IsSpectralIntegral P (fun x : ℝ => (x : ℂ)) A) :
    ((∀ t : ℝ, TeschlQM.Shared.timeEvolution P t ∈ unitary (H →L[ℂ] H)) ∧ TeschlQM.Shared.timeEvolution P 0 = 1 ∧
      (∀ t s : ℝ, TeschlQM.Shared.timeEvolution P (t + s) = TeschlQM.Shared.timeEvolution P t * TeschlQM.Shared.timeEvolution P s) ∧
      ∀ ψ : H, Continuous (fun t : ℝ => TeschlQM.Shared.timeEvolution P t ψ)) ∧
    (∀ ψ : H, (∃ φ : H, Tendsto (fun t : ℝ => (t : ℂ)⁻¹ • (TeschlQM.Shared.timeEvolution P t ψ - ψ))
        (𝓝[≠] (0 : ℝ)) (𝓝 φ)) ↔ ψ ∈ A.domain) ∧
    (∀ ψ : A.domain, Tendsto (fun t : ℝ => (t : ℂ)⁻¹ • (TeschlQM.Shared.timeEvolution P t ψ - ψ))
        (𝓝[≠] (0 : ℝ)) (𝓝 (-(Complex.I • A ψ)))) ∧
    (∀ t : ℝ, A.domain.map (TeschlQM.Shared.timeEvolution P t : H →ₗ[ℂ] H) = A.domain) ∧
    ∀ (t : ℝ) (ψ : A.domain) (h : TeschlQM.Shared.timeEvolution P t ψ ∈ A.domain),
      A ⟨TeschlQM.Shared.timeEvolution P t ψ, h⟩ = TeschlQM.Shared.timeEvolution P t (A ψ) := by sorry

end TeschlQM.Dynamics
