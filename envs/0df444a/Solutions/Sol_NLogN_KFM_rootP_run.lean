theorem filter_Icc_eq (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    (Finset.Icc 1 N).filter P = Finset.Icc 1 (Nat.findGreatest P N) := by
  ext x
  simp only [Finset.mem_filter, Finset.mem_Icc]
  constructor
  · rintro ⟨⟨h1, h2⟩, h3⟩
    exact ⟨h1, Nat.le_findGreatest h2 h3⟩
  · rintro ⟨h1, h2⟩
    have hle : Nat.findGreatest P N ≤ N := Nat.findGreatest_le N
    have hpos : 0 < Nat.findGreatest P N := by omega
    have hP : P (Nat.findGreatest P N) := Nat.findGreatest_of_ne_zero rfl (by omega)
    exact ⟨⟨h1, by omega⟩, hdc x _ h1 h2 hP⟩

theorem count_eq_findGreatest (P : ℕ → Prop) [DecidablePred P] (N : ℕ)
    (hdc : ∀ x y, 1 ≤ x → x ≤ y → P y → P x) :
    ∑ x ∈ Finset.Icc 1 N, (if P x then (1 : ℤ) else 0) = (Nat.findGreatest P N : ℤ) := by
  rw [← Finset.sum_filter, filter_Icc_eq P N hdc]
  simp

theorem clean_reg {rv : Fin HS} (hv : rv.val < 56) (j : Fin HS) (hj : j = rv ∨ j = sY) :
