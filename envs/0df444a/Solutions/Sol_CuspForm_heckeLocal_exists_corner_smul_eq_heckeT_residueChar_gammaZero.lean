  have hN := IharaLemma.exists_pow_smul_corner_mem_maximalIdeal_smul (𝒪 := 𝒪)
    (TpN.localSplitting (Sp.CornerRing i)) (TpN.idx0 (Sp.CornerRing i))
    (eB.symm tpB - algebraMap 𝒪 (Sp.CornerRing i) a) hz (V := ↥(cornerSubmodule (M := H1 N ⊤ 𝒪) (Sp.e i))) k
