        (((n - w : ℕ) : ℝ) - 2 * (q : ℝ) -
          (source.val : ℝ) + 1)) /
        (((w : ℝ) - 2 * (p : ℝ)) +
          (((n - w : ℕ) : ℝ) - 2 * (q : ℝ)) -
