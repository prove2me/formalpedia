/-- All padding quantities are bounded by the padded volume `P·Q·g·Q·S`. -/
theorem binBounds {P g S T Q : ℕ} (hP : 1 ≤ P) (hg : 1 ≤ g) (hS : 1 ≤ S) (hT : 1 ≤ T)
    (hTQ : T ≤ Q) :
    let V := P * (Q * (g * (Q * S)))
    P ≤ V ∧ g ≤ V ∧ S ≤ V ∧ T ≤ V ∧ Q ≤ V ∧ T * g ≤ V ∧ P * (T * g) ≤ V ∧ T * S ≤ V ∧
      Q * S ≤ V ∧ (Q - T) * S ≤ V ∧ P * (T * g) * (Q * S) ≤ V ∧ g * (Q * S) ≤ V ∧
      T * (g * (Q * S)) ≤ V ∧ (Q - T) * (g * (Q * S)) ≤ V ∧ Q * (g * (Q * S)) ≤ V ∧
      P * (T * (g * (Q * S))) ≤ V ∧ T * S ≤ V ∧ P * (T * g) * (T * S) ≤ V := by
  intro V
  have hQ : 1 ≤ Q := le_trans hT hTQ
  have hQT : Q - T ≤ Q := Nat.sub_le _ _
  have a1 : 1 ≤ Q * S := Nat.mul_pos hQ hS
  have a2 : 1 ≤ g * (Q * S) := Nat.mul_pos hg a1
  have a3 : 1 ≤ Q * (g * (Q * S)) := Nat.mul_pos hQ a2
  have hVg : Q * (g * (Q * S)) ≤ V := Nat.le_mul_of_pos_left _ hP
  have hgQS : g * (Q * S) ≤ Q * (g * (Q * S)) := Nat.le_mul_of_pos_left _ hQ
  have hQS : Q * S ≤ g * (Q * S) := Nat.le_mul_of_pos_left _ hg
  have hS' : S ≤ Q * S := Nat.le_mul_of_pos_left _ hQ
  have hg' : g ≤ g * (Q * S) := Nat.le_mul_of_pos_right _ a1
  have hQ' : Q ≤ Q * S := Nat.le_mul_of_pos_right _ hS
  have hTg : T * g ≤ Q * (g * (Q * S)) := by
    calc T * g ≤ Q * (g * 1) := by rw [mul_one]; exact Nat.mul_le_mul_right _ hTQ
      _ ≤ Q * (g * (Q * S)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ a1)
  have hPTg : P * (T * g) * (Q * S) ≤ V := by
    calc P * (T * g) * (Q * S) = P * (T * (g * (Q * S))) := by ring
      _ ≤ P * (Q * (g * (Q * S))) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hTQ)
  have hPTT : P * (T * g) * (T * S) ≤ V := by
    calc P * (T * g) * (T * S) = P * (T * (g * (T * S))) := by ring
      _ ≤ P * (Q * (g * (Q * S))) := Nat.mul_le_mul_left _ (Nat.mul_le_mul hTQ
          (Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hTQ)))
  have hPTgV : P * (T * g) ≤ V := le_trans (Nat.le_mul_of_pos_right _ a1) hPTg
  have hPT : P * (T * (g * (Q * S))) ≤ V := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hTQ)
  have hTS : T * S ≤ V := le_trans (Nat.mul_le_mul_right _ hTQ) (by omega)
  refine ⟨Nat.le_mul_of_pos_right _ a3, by omega, by omega, by omega, by omega, by omega,
    hPTgV, hTS, by omega, le_trans (Nat.mul_le_mul_right _ hQT) (by omega), hPTg, by omega,
    le_trans (Nat.mul_le_mul_right _ hTQ) hVg,
    le_trans (Nat.mul_le_mul_right _ hQT) hVg, hVg, hPT, hTS, hPTT⟩

/-- The padding-register expressions are evaluable. -/
theorem padE_all {F : Fin HS → List ℤ} {v : Fin HS → ℕ} {M P g S T Q : ℕ} {LP LG LS : List ℤ}
