  haveI : Finite (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₂ n₂))) :=
    finite_classSet_of_isOrder hdef₂.neg_left hdef₂.neg_right _ hS₂.isOrder
  haveI : Finite (ClassSet (Submodule.finiteIdeleStabilizer R₂)) :=
    finite_classSet_of_isOrder hdef₂.neg_left hdef₂.neg_right _ hR₂.isOrder
  letI := Fintype.ofFinite (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₂ n₂)))
  letI := Fintype.ofFinite (ClassSet (Submodule.finiteIdeleStabilizer R₂))
  have hcl₂ : ClassSetHeckeLaws N q' Λ₂ R₂ n₂ :=
    CerednikDrinfeld.classSetHeckeLaws_of_isEichlerOrder_meetOrder N q' q (Ne.symm hqq') hq'N hqN hdef₂ Λ₂ R₂ hΛ₂
      hR₂ hRΛ₂ n₂ hS₂ hn₂

  obtain ⟨a₁, b₁, hdef₁, R₁, hR₁⟩ :=
    QuaternionAlgebra.exists_isDefiniteRamifiedExactlyAt_isEichlerOrder q' hq'P N hN0 hq'N
  obtain ⟨Λ₁, hΛ₁, hRΛ₁, -⟩ := hR₁.exists_le_isMaximalOrder
  obtain ⟨n₁, hS₁, hn₁, hnorm₁, hsq₁, -⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_finiteIdele_meetOrder_isEichlerOrder_mul_of_not_dvd
      hq'P hdef₁ hR₁ q hqP (Ne.symm hqq') hqN
  haveI : Finite (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₁ n₁))) :=
    finite_classSet_of_isOrder hdef₁.neg_left hdef₁.neg_right _ hS₁.isOrder
  haveI : Finite (ClassSet (Submodule.finiteIdeleStabilizer R₁)) :=
    finite_classSet_of_isOrder hdef₁.neg_left hdef₁.neg_right _ hR₁.isOrder
  letI := Fintype.ofFinite (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₁ n₁)))
  letI := Fintype.ofFinite (ClassSet (Submodule.finiteIdeleStabilizer R₁))
  have hcl₁ : ClassSetHeckeLaws N q Λ₁ R₁ n₁ :=
    CerednikDrinfeld.classSetHeckeLaws_of_isEichlerOrder_meetOrder N q q' hqq' hqN hq'N hdef₁ Λ₁ R₁ hΛ₁
