variable {p : ℕ} [Fact p.Prime]

theorem PI.FglChordFactor.Wk.omega_mul {W : WeierstrassCurve ℂ_[p]} {wq : PowerSeries ℂ_[p]} (h : IsWq W wq) :
    omegaW W wq * (wq * (algebraMap ℂ_[p] (PowerSeries ℂ_[p]) W.a₁ * PowerSeries.X +
      algebraMap ℂ_[p] (PowerSeries ℂ_[p]) W.a₃ * PowerSeries.X ^ 3 * wq - 2)) =
      -2 * wq - PowerSeries.X * PowerSeries.derivative ℂ_[p] wq := by sorry
