/-- The test at the start of `FM`. -/
theorem fmTest_runs (s : IState NS) (N : ℕ) (LP : List Item) (hP : s.G PRM = .int N :: LP) :
    IRuns I iprog (.seq (blenS PRM ZZ) (.seq (.op (.const T4 (-(fmThr : ℤ)))) (.op (.add T4 ZZ ZZ))))
      s (s.upd ZZ (.int (-(fmThr : ℤ) + fmL N) :: s.G ZZ))
      (1000 * (fmL N + 1) ^ 2 + 1000 * (fmL N + 15)) := by
  have h1 := blenS_runs (I := I) (iprog := iprog) (X := PRM) (C := ZZ) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) s N LP hP
  have h2 : IRuns I iprog (.seq (.op (.const T4 (-(fmThr : ℤ)))) (.op (.add T4 ZZ ZZ)))
      (s.upd ZZ (.int (zsz (N : ℤ)) :: s.G ZZ)) (s.upd ZZ (.int (-(fmThr : ℤ) + fmL N) :: s.G ZZ))
      (1000 * (fmL N + 15)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, fmL]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have h12 : zsz (-(fmThr : ℤ)) ≤ 12 := by
      rw [zsz_neg]; exact zsz_le_of_abs (by norm_num [fmThr])
    have := zsz_natCast_le_self (zsz (N : ℤ))
    have := addIntCost_le (12 + zsz (N : ℤ))
    have := addIntCost_mono (show zsz (-(fmThr : ℤ)) + zsz ((zsz (N : ℤ) : ℕ) : ℤ) ≤
      12 + zsz (N : ℤ) by omega)
    simp only [fmThr] at *
    omega
  exact (IRuns.seq h1 h2).mono (by simp only [fmL]; omega)

/-- The cost of the small case. -/
theorem fmBase_cost (N : ℕ) (hN1 : 1 ≤ N) (hl : fmL N < fmThr) :
    1000 * (fmL N + 1) ^ 2 + 1000 * (fmL N + 15) + 25 + (2 * (fmL N + 13) + 2) +
      (smulCost (2 * N + 2) + 20000 * (N + 3)) + 2 ≤ fmPhi N := by
  have hNlt : N < 2 ^ 2048 := by
    have : zsz (N : ℤ) ≤ 2048 := by simp only [fmL, fmThr] at hl; omega
    rw [zsz_le_iff] at this; simpa using this
  have hl1 : 1 ≤ fmL N := one_le_zsz (by omega)
  have hlam : 1 ≤ fmLam N := one_le_zsz (by
    have : 1 ≤ fmL N ^ 4 := Nat.one_le_pow _ _ hl1
    omega)
  have hlN : fmL N ≤ N := le_trans (zsz_natCast_le_self N) le_rfl
  simp only [fmThr] at hl
  have hPhi : fmA * N ≤ fmPhi N := by
    unfold fmPhi
    calc fmA * N = fmA * N * 1 * 1 := by ring
      _ ≤ fmA * N * fmL N * fmLam N := by gcongr
  refine le_trans ?_ hPhi
  generalize hX : (2 : ℕ) ^ 2048 = X at hNlt
  have hA : fmA = 2 ^ 52 * X := by rw [fmA, ← hX, ← pow_add]
  rw [hA]
  simp only [smulCost]
  have hNN : N * N ≤ X * N := Nat.mul_le_mul_right _ hNlt.le
  have h52 : (2 : ℕ) ^ 52 ≥ 10 ^ 9 := by norm_num
  nlinarith

theorem fm_spec (pF pD pT pP : Fin P) (hPF : iprog pF = fmBody pF pD pT pP)
    (hPD : iprog pD = difBody pD) (hPT : iprog pT = ditBody pT) (hPP : iprog pP = pow2Body pP)
    (Hpar : ∀ N, 2048 ≤ fmL N → 2 ^ fmK N ∣ N →
      1 ≤ N ∧ fmB N ≤ fmL N / 2 ∧ 2 ^ fmK N * fmM N = N ∧ 1 ≤ fmM N ∧
      2 * fmM N + 2 * fmK N + 4 ≤ fmN' N ∧ fmN' N < N ∧ fmL N ≤ N ∧
      2 ^ fmK (fmN' N) ∣ fmN' N)
    (Hcost : ∀ N, 2048 ≤ fmL N → 2 ^ fmK N ∣ N →
      2 ^ fmK N * fmPhi (fmN' N) + fmLevelCost N + 1000 * (fmL N + 1) ^ 2 +
        10000 * (fmL N + 1) ≤ fmPhi N) :
    ∀ N, 1 ≤ N → (fmL N < fmThr ∨ 2 ^ fmK N ∣ N) → FMSpec pF iprog I N (fmPhi N) := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro hN1 hcase s a b LA LP LN LF ha hb hA hP hN hF
  have ht := fmTest_runs (I := I) (iprog := iprog) s N LP hP
  set v : ℤ := -(fmThr : ℤ) + fmL N with hv
  set s1 := s.upd ZZ (.int v :: s.G ZZ) with hs1
  have hzv : zsz v ≤ fmL N + 13 := by
    rw [hv]
    have := zsz_add_le (-(fmThr : ℤ)) (fmL N : ℤ)
    have h12 : zsz (-(fmThr : ℤ)) ≤ 12 := by
      rw [zsz_neg]; exact zsz_le_of_abs (by norm_num [fmThr])
    have := zsz_natCast_le_self (fmL N)
    omega
  have hdrop : IRuns I iprog (.op (.drop ZZ)) s1 s (2 * (fmL N + 13) + 2) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hs1]
    omega
  by_cases hl : fmL N < fmThr
  · -- schoolbook
    have hcl : (fun c => c == Cls.neg) (s1.cl ZZ) = true := by
      simp [hs1, hv]; simp only [fmThr] at hl ⊢; omega
    have hzab : zsz a + zsz b ≤ 2 * N + 2 := by
      have h1n : (1 : ℤ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
      have := zsz_le_of_abs (z := a) (m := N + 1) (by
        rw [abs_lt, pow_succ]; constructor <;> linarith)
      have := zsz_le_of_abs (z := b) (m := N + 1) (by
        rw [abs_lt, pow_succ]; constructor <;> linarith)
      omega
    have hsm := smul_runs (I := I) (iprog := iprog) (A := ARG) (X := XA) (Y := QS) (W := W)
      (Q := CC) (R := U) (T := V) (by decide) s a b LA hA
    have hfr := fred_runs (I := I) (iprog := iprog) (X := ARG) (by decide) (by decide) (by decide)
      (by decide) (s.upd ARG (.int (a * b) :: LA)) (a * b) N LA LN LF (by simp)
      (by simp +decide [hN]) (by simp +decide [hF]) (by
        have hab : |a * b| < 2 ^ (2 * N + 1) := by
          rw [abs_of_nonneg (mul_nonneg ha.1 hb.1), pow_succ, pow_mul']
          have : a * b ≤ 2 ^ N * 2 ^ N := mul_le_mul ha.2 hb.2 hb.1 (by positivity)
          nlinarith [pow_pos (show (0 : ℤ) < 2 by norm_num) N]
        have : ((a * b).natAbs : ℤ) < 2 ^ (2 * N + 1) := by rw [Int.natCast_natAbs]; exact hab
        exact_mod_cast this)
    have hbody := IRuns.seq ht (IRuns.iteT (i := ZZ) (f := fun c => c == Cls.neg) (q := .seq (.op (.drop ZZ)) (fmMain pF pD pT pP)) hcl (IRuns.seq hdrop (IRuns.seq hsm hfr)))
    have hsc : smulCost (zsz a + zsz b) ≤ smulCost (2 * N + 2) := by
      simp only [smulCost]; gcongr
    have hbc := fmBase_cost N hN1 hl
    have hb2 : IRuns I iprog (iprog pF) s (s.upd ARG (.int ((a * b) % (2 ^ N + 1)) :: LA))
        (fmPhi N - 2) := by
      rw [hPF]
      refine hbody.mono' ?_ ?_
      · clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
      · clear * - hbc hsc; generalize fmPhi N = Φ at *; generalize smulCost (zsz a + zsz b) = s1 at *; generalize smulCost (2 * N + 2) = s2 at *; generalize (fmL N + 1) ^ 2 = q at *; generalize fmL N = l at *; apply Nat.le_sub_of_add_le; linarith
    exact (IRuns.call hb2).mono (by clear * - hbc; generalize fmPhi N = Φ at *; omega)
  · -- recursion
    have hl' : 2048 ≤ fmL N := by simp only [fmThr] at hl; omega
    have hdiv : 2 ^ fmK N ∣ N := by
      rcases hcase with h | h
      · exact absurd h hl
      · exact h
    obtain ⟨_, hB, hKM, hM1, hnt, hnN, hℓ, hdiv'⟩ := Hpar N hl' hdiv
    have hFMn := ih (fmN' N) hnN (by omega) (Or.inr hdiv')
    have hm := fmMain_runs (I := I) (iprog := iprog) pF pD pT pP hPD hPT hPP N (fmPhi (fmN' N)) hFMn
      hN1 hB hKM hM1 hnt hnN.le hℓ s a b LA LP LN LF ha hb hA hP hN hF
    have hcl : (fun c => c == Cls.neg) (s1.cl ZZ) = false := by
      simp [hs1, hv]; simp only [fmThr] at hl ⊢; omega
    have hbody := IRuns.seq ht (IRuns.iteF (i := ZZ) (f := fun c => c == Cls.neg) (p := .seq (.op (.drop ZZ)) fmBase) hcl (IRuns.seq hdrop hm))
    have hc := Hcost N hl' hdiv
    have hb2 : IRuns I iprog (iprog pF) s (s.upd ARG (.int ((a * b) % (2 ^ N + 1)) :: LA))
        (fmPhi N - 2) := by
      rw [hPF]; refine hbody.mono ?_
      clear * - hc hzv hl'; generalize fmPhi N = Φ at *; generalize fmPhi (fmN' N) = Φ' at *; omega
    exact (IRuns.call hb2).mono (by
      clear * - hc; generalize fmPhi N = Φ at *; generalize fmPhi (fmN' N) = Φ' at *; omega)

theorem fm_spec' (pF pD pT pP : Fin P) (hPF : iprog pF = fmBody pF pD pT pP)
    (hPD : iprog pD = difBody pD) (hPT : iprog pT = ditBody pT) (hPP : iprog pP = pow2Body pP) :
    ∀ N, 1 ≤ N → (fmL N < fmThr ∨ 2 ^ fmK N ∣ N) → FMSpec pF iprog I N (fmPhi N) :=
  fm_spec pF pD pT pP hPF hPD hPT hPP fm_params fm_cost

end NLogN

end

