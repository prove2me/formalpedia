/-! ## List lemmas -/

theorem filter_take_length {α : Type*} (p : α → Bool) :
    ∀ (l : List α) (k : ℕ), ((l.take k).filter p).length = ((l.map p).take k).count true
  | [], k => by simp
  | y :: l, 0 => by simp
  | y :: l, k + 1 => by
    rw [List.take_succ_cons, List.map_cons, List.take_succ_cons, List.filter_cons, List.count_cons]
    by_cases hy : p y = true
    · simp only [hy, if_true, List.length_cons, filter_take_length p l k]; simp
    · simp only [hy, Bool.false_eq_true, if_false, filter_take_length p l k]; simp

