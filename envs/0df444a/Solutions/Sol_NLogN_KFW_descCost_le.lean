  have hZ2 : Z ^ 2 ≤ 4 * L := NLogN.KFW.zsz_sq_le L
  have hZL : Z ≤ L := NLogN.zsz_natCast_le_self' L
  have q1 : (Q + 7 + 2) ^ 2 ≤ 100 * Q ^ 2 := by nlinarith
