                linarith [hdi]
              have hns : (normSq c₁ : ℂ) ≠ 0 := by
                exact_mod_cast (normSq_pos.2 hc₁).ne'
              have hc₀ : c₀ * conj c₁ = ((c₀ * conj c₁).re : ℂ) := by
                apply Complex.ext
                · simp
                · simp [hre]
              have hkey : c₀ * (normSq c₁ : ℂ) = ((c₀ * conj c₁).re : ℂ) * c₁ := by
