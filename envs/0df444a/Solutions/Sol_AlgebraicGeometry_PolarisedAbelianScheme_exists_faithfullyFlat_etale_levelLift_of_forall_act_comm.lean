namespace LS3Aux

open Opposite

variable {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
  {R R' : Type} [CommRing R] [CommRing R'] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S)) (ψ : R →+* R')
  (bb : pullback u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) ⟶ pullback u.f t)
  (cc : (Scheme.Modules.pullback bb).obj ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol) ≅
    (Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t))).obj u.pol)

noncomputable def m (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)) : Γ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t))).obj u.pol, ⊤) :=
  cc.hom.app ⊤ (Scheme.Modules.pullbackLocalSection bb s :
    Γ((Scheme.Modules.pullback bb).obj ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol), ⊤))

theorem m_baseScalar_smul
    (hbb₁ : bb ≫ pullback.fst u.f t = pullback.fst u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t))
    (hbb₂ : bb ≫ pullback.snd u.f t = pullback.snd u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) ≫ Spec.map (CommRingCat.ofHom ψ))
    (r : R) (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)) :
    m u t ψ bb cc (baseScalar u.f t r • s) = baseScalar u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) (ψ r) • m u t ψ bb cc s := by
  have key : (bb.app ⊤).hom (baseScalar u.f t r) = baseScalar u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) (ψ r) := by
    have e1 := Scheme.Hom.comp_app bb (pullback.snd u.f t) ⊤
    rw [hbb₂, Scheme.Hom.comp_app] at e1
    have e4 := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) e1
    have e2 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ)
    have e3 := congrArg (fun k => k.hom r) e2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e3
    show (bb.app ⊤).hom ((pullback.snd u.f t).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) =
      (pullback.snd u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t)).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom (ψ r))
    refine e4.symm.trans ?_
    rw [e3]
    rfl
  unfold m
  rw [Scheme.Modules.pullbackLocalSection_smul]
  refine (Scheme.Modules.Hom.app_smul _ _ _).trans ?_
  rw [key]

theorem act_eq_of_forall_act_m_eq
    (hbb₁ : bb ≫ pullback.fst u.f t = pullback.fst u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t))
    (hbb₂ : bb ≫ pullback.snd u.f t = pullback.snd u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) ≫ Spec.map (CommRingCat.ofHom ψ))
    (θ₁ θ₂ : ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom ψ) ≫ t))
    (h : ∀ s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤), θ₁.act (m u t ψ bb cc s) = θ₂.act (m u t ψ bb cc s)) :
    ∀ s' : Γ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t))).obj u.pol, ⊤), θ₁.act s' = θ₂.act s' := by
  classical
  intro s'

  let t' : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of S) := Spec.map (CommRingCat.ofHom ψ) ≫ t
  let fR : pullback u.f t ⟶ Spec (CommRingCat.of R) := pullback.snd u.f t
  let fR' : pullback u.f t' ⟶ Spec (CommRingCat.of R') := pullback.snd u.f t'
  let 𝓛R : (pullback u.f t).Modules := (Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol
  have hAR : AbelianSchemePropertyBundle R fR :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.of_isPullback u.bundle (IsPullback.of_hasPullback u.f t)
  have hinvR : Scheme.Modules.IsInvertible 𝓛R := u.pol_isInvertible.pullback _

  let φ₀ : S →+* R := (Spec.preimage t).hom
  have ht : Spec.map (CommRingCat.ofHom φ₀) = t := by
    show Spec.map (CommRingCat.ofHom (Spec.preimage t).hom) = t
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hcart₀ : IsPullback (pullback.fst u.f t) fR u.f (Spec.map (CommRingCat.ofHom φ₀)) := by
    rw [ht]; exact IsPullback.of_hasPullback u.f t
  have hvaR : Scheme.Modules.ClosedImmersionBySections 𝓛R fR :=
    AlgebraicGeometry.Scheme.Modules.ClosedImmersionBySections.pullback_of_isPullback φ₀ (pullback.fst u.f t) hcart₀ u.pol_veryAmple

  have hbig : IsPullback (bb ≫ pullback.fst u.f t) fR' u.f (Spec.map (CommRingCat.ofHom ψ) ≫ t) := by
    rw [hbb₁]; exact IsPullback.of_hasPullback u.f t'
  have hgA : IsPullback bb fR' fR (Spec.map (CommRingCat.ofHom ψ)) :=
    IsPullback.of_right hbig hbb₂ (IsPullback.of_hasPullback u.f t)

  letI instR : Module R Γ(𝓛R, ⊤) := Module.compHom _ ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ fR.appTop).hom
  letI instR' : Module R' Γ((Scheme.Modules.pullback bb).obj 𝓛R, bb ⁻¹ᵁ ⊤) :=
    Module.compHom _ ((Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ fR'.appLE ⊤ (bb ⁻¹ᵁ ⊤) le_top).hom
  letI : Algebra R R' := ψ.toAlgebra

  obtain ⟨⟨hfin, -⟩, -, -, -⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.sections_finite_projective_and_isSectionBasisOn_pullback_type0
      (u.L.baseChange t) hAR 𝓛R hinvR hvaR
  obtain ⟨nσ, σ, hσ⟩ := @Module.Finite.exists_fin R Γ(𝓛R, ⊤) _ _ instR hfin

  have hbc := GoodReductionJacobian.AbelianSchemePropertyBundle.exists_linearEquiv_tensorProduct_sections_pullback_type0
      (u.L.baseChange t) hAR 𝓛R hinvR hvaR R' ψ (pullback u.f t') fR' bb hgA
  let tt : Γ((Scheme.Modules.pullback bb).obj 𝓛R, bb ⁻¹ᵁ ⊤) := cc.inv.app ⊤ s'
  obtain ⟨coef, hcoef⟩ :=
    AlgebraicGeometry.Scheme.Modules.forall_exists_eq_sum_smul_pullbackLocalSection_of_span_eq_top_of_linearEquiv_tensorProduct
      fR 𝓛R σ hσ R' ψ (pullback u.f t') fR' bb hgA hbc tt

  have hs' : s' = cc.hom.app ⊤ tt := by
    show s' = (cc.inv.app ⊤ ≫ cc.hom.app ⊤) s'
    rw [← Scheme.Modules.Hom.comp_app, cc.inv_hom_id, Scheme.Modules.Hom.id_app]
    rfl

  have hscal : ∀ r : R', ((Scheme.ΓSpecIso (CommRingCat.of R')).inv ≫ fR'.appLE ⊤ (bb ⁻¹ᵁ ⊤) le_top).hom r =
      baseScalar u.f t' r := by
    intro r
    show (fR'.appLE ⊤ (bb ⁻¹ᵁ ⊤) le_top).hom ((Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom r) =
      (pullback.snd u.f t').appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R')).inv.hom r)
    congr 2
    exact (Scheme.Hom.app_eq_appLE fR' (U := ⊤)).symm
  have hdec : s' = ∑ i, baseScalar u.f t' (coef i) • m u t ψ bb cc (σ i) := by
    rw [hs', hcoef]
    refine (map_sum (ConcreteCategory.hom (Scheme.Modules.Hom.app cc.hom ⊤)) _ _).trans ?_
    refine Finset.sum_congr rfl fun i _ => ?_
    refine (Scheme.Modules.Hom.app_smul cc.hom (U := ⊤) _ _).trans ?_
    exact congrArg (fun a : Γ(pullback u.f t', ⊤) =>
      a • (ConcreteCategory.hom (Scheme.Modules.Hom.app cc.hom ⊤)) (Scheme.Modules.pullbackLocalSection bb (σ i))) (hscal (coef i))

  have hlin : ∀ (θ : ThetaPt u.f u.L u.pol t') (c : Fin nσ → R')
      (v : Fin nσ → Γ((Scheme.Modules.pullback (pullback.fst u.f t')).obj u.pol, ⊤)),
      θ.act (∑ i, baseScalar u.f t' (c i) • v i) = ∑ i, baseScalar u.f t' (c i) • θ.act (v i) := by
    intro θ c v
    obtain ⟨hadd, hsmul⟩ := AlgebraicGeometry.Polarisation.ThetaPt.act_add_and_act_baseScalar_smul u.f u.L u.pol t' θ
    have h0 : θ.act 0 = 0 := by
      have h2 : θ.act 0 + θ.act 0 = θ.act 0 + 0 := by rw [add_zero, ← hadd, add_zero]
      exact add_left_cancel h2
    induction (Finset.univ : Finset (Fin nσ)) using Finset.induction_on with
    | empty => simp [h0]
    | insert i s hi ih => rw [Finset.sum_insert hi, Finset.sum_insert hi, hadd, hsmul, ih]
  rw [hdec, hlin θ₁, hlin θ₂]
  exact Finset.sum_congr rfl fun i _ => by rw [h]

end LS3Aux

set_option maxHeartbeats 3200000 in
theorem solution
    {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    {R : Type} [CommRing R] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))
    {K₁ : Type} [AddCommGroup K₁] [Fintype K₁] (hK : IsUnit ((Fintype.card K₁ : ℕ) : R))
    (x : K₁ → SchemeHomOver t u.f) (hx0 : x 0 = u.L.one t) (hx : ∀ k k' : K₁, x (k + k') = u.L.mul t (x k) (x k'))
    (θ₀ : K₁ → ThetaPt u.f u.L u.pol t) (hθ₀ : ∀ k : K₁, (θ₀ k).pt = x k)
    (hcomm : ∀ (k k' : K₁) (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)),
      (θ₀ k).act ((θ₀ k').act s) = (θ₀ k').act ((θ₀ k).act s)) :
    ∃ (R' : Type) (_ : CommRing R') (_ : Algebra R R'), Module.FaithfullyFlat R R' ∧ Algebra.Etale R R' ∧
      ∃ lift : K₁ → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t),
        lift 0 = 1 ∧ (∀ k k' : K₁, lift (k + k') = lift k * lift k') ∧
        (∀ k : K₁, (lift k).pt.1 = Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ (x k).1) := by
  classical
  obtain ⟨c, hc, hsymm, hcoc⟩ :=
    AlgebraicGeometry.PolarisedAbelianScheme.exists_symmCocycle_forall_mul_act_eq_smul_act_of_forall_act_comm u t x hx0 hx θ₀ hθ₀ hcomm
  obtain ⟨R', _, _, hff, het, b, hb⟩ :=
    CommRing.exists_etale_faithfullyFlat_units_eq_mul_inv_mul_inv_of_symm_of_cocycle_of_isUnit_card R hK c hsymm hcoc
  obtain ⟨bb, hbb₁, hbb₂, cc, β, hβpt, hβact, hβsc⟩ :=
    ThetaPt.exists_comparison_monoidHom_of_ringHom u.L u.pol t (algebraMap R R')

  have hsm' : ∀ (θ : ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t)) (r : R') (s : Γ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t))).obj u.pol, ⊤)),
      θ.act (baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) r • s) = baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) r • θ.act s :=
    fun θ => (ThetaPt.act_add_and_act_baseScalar_smul u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) θ).2
  have hbmul' : ∀ a₁ a₂ : R', baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) (a₁ * a₂) = baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) a₁ * baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t) a₂ := fun a₁ a₂ => by
    rw [← baseScalarHom_apply, ← baseScalarHom_apply, ← baseScalarHom_apply, map_mul]
  have hβm : ∀ (θ : ThetaPt u.f u.L u.pol t) (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)),
      (β θ).act (LS3Aux.m u t (algebraMap R R') bb cc s) = LS3Aux.m u t (algebraMap R R') bb cc (θ.act s) := fun θ s => hβact θ s

  have hkey : ∀ k k' : K₁, ((b k' : R'ˣ) : R') * ((b k : R'ˣ) : R') * algebraMap R R' ((c k k' : Rˣ) : R) = ((b (k + k') : R'ˣ) : R') := by
    intro k k'
    have h : algebraMap R R' ((c k k' : Rˣ) : R) = ((b (k + k') : R'ˣ) : R') * ((b k)⁻¹ : R'ˣ) * ((b k')⁻¹ : R'ˣ) := by
      have := congrArg Units.val (hb k k'); simpa using this
    rw [h]
    have e1 : ((b k' : R'ˣ) : R') * ((b k : R'ˣ) : R') * (((b (k + k') : R'ˣ) : R') * ((b k)⁻¹ : R'ˣ) * ((b k')⁻¹ : R'ˣ)) =
        ((b (k + k') : R'ˣ) : R') * (((b k : R'ˣ) : R') * ((b k)⁻¹ : R'ˣ)) * (((b k' : R'ˣ) : R') * ((b k')⁻¹ : R'ˣ)) := by ring
    rw [e1, Units.mul_inv, Units.mul_inv, mul_one, mul_one]

  have hl : ∀ k : K₁, (ThetaPt.ofScalar (b k) * β (θ₀ k)).pt = schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) rfl (x k) := by
    intro k
    apply Subtype.ext
    rw [ThetaPt.mul_pt, ThetaPt.ofScalar_pt, u.L.one_mul, hβpt, hθ₀, GoodReductionJacobian.schemeHomOverComp_coe]

  have hmul : ∀ k k' : K₁, (ThetaPt.ofScalar (b (k + k')) * β (θ₀ (k + k'))) =
      (ThetaPt.ofScalar (b k) * β (θ₀ k)) * (ThetaPt.ofScalar (b k') * β (θ₀ k')) := by
    intro k k'
    apply AlgebraicGeometry.PolarisedAbelianScheme.thetaPt_eq_of_pt_eq_of_forall_act_eq u (Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ t)
    · rw [hl (k + k'), ThetaPt.mul_pt, hl k, hl k', ← u.L.mul_natural, ← hx]
    · refine LS3Aux.act_eq_of_forall_act_m_eq u t (algebraMap R R') bb cc hbb₁ hbb₂ _ _ (fun s => ?_)

      rw [ThetaPt.mul_act (ThetaPt.ofScalar (b (k + k'))) (β (θ₀ (k + k'))), hβm, ThetaPt.ofScalar_act]

      rw [ThetaPt.mul_act (ThetaPt.ofScalar (b k) * β (θ₀ k)) (ThetaPt.ofScalar (b k') * β (θ₀ k')),
        ThetaPt.mul_act (ThetaPt.ofScalar (b k')) (β (θ₀ k')), hβm, ThetaPt.ofScalar_act, hsm',
        ThetaPt.mul_act (ThetaPt.ofScalar (b k)) (β (θ₀ k)), hβm, ThetaPt.ofScalar_act, ← ThetaPt.mul_act (θ₀ k) (θ₀ k') s, hc k k',
        LS3Aux.m_baseScalar_smul u t (algebraMap R R') bb cc hbb₁ hbb₂, ← mul_smul, ← mul_smul, ← hbmul', ← hbmul', hkey]
  refine ⟨R', inferInstance, inferInstance, hff, het, fun k => ThetaPt.ofScalar (b k) * β (θ₀ k), ?_, hmul, ?_⟩
  · have h := hmul 0 0
    simp only [add_zero] at h
    exact (mul_left_cancel (h.symm.trans (mul_one _).symm))
  · intro k
    rw [hl, GoodReductionJacobian.schemeHomOverComp_coe]

