      t.G A = e x ++ r → t.G B1 = o1 ++ s.G B1 → t.G B2 = o2 ++ s.G B2 →
      b.run t = ((t.upd A r).upd B1 ((d1 (f1 x)).reverse ++ t.G B1)).upd B2
