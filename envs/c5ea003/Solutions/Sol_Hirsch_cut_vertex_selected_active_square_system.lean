/-- Every actual cut vertex receives a positive support from the generating
set, independent active-cut images and unique barycentric recovery. No support
or injectivity certificate is assumed. -/
theorem accepted_positive_support
    (m d : ℕ) (S : Set (Fin d → ℝ))
    (C : Fin m → (Fin d → ℝ) →ₗ[ℝ] ℝ) (b : Fin m → ℝ)
    (x : Fin d → ℝ)
    (hx : x ∈ (convexHull ℝ S ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ) :
    ∃ (n : ℕ) (v : Fin n → Fin d → ℝ) (w : Fin n → ℝ),
      (∀ i, v i ∈ S) ∧ (∀ i, 0 < w i) ∧ (∑ i, w i) = 1 ∧
      (∑ i, w i • v i) = x ∧
      LinearIndependent ℝ (fun i => ((1 : ℝ), v i)) ∧
      LinearIndependent ℝ
        (fun i => ((1 : ℝ), fun j : {j : Fin m // C j x = b j} => C j.val (v i))) ∧
      n ≤ d + 1 ∧ n ≤ Nat.card {j : Fin m // C j x = b j} + 1 ∧
      (∀ u : Fin n → ℝ, (∑ i, u i) = 1 →
        (∀ j, C j x = b j → (∑ i, u i * C j (v i)) = b j) → u = w) := by
  classical
  obtain ⟨n, v, w, hvS, hwpos, hw1, hwx, hvind⟩ :=
    Hirsch.ConstructedCutSupport.positive_support d S x hx.1.1
  have hvin : ∀ i, v i ∈ convexHull ℝ S :=
    fun i => subset_convexHull ℝ S (hvS i)
  have hext : (∑ i, w i • v i) ∈
      (convexHull ℝ S ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ := by
    rw [hwx]
    exact hx
  have hactive := Hirsch.CutActiveSupport.active_image_independent n m d
    (convexHull ℝ S) (convex_convexHull ℝ S) v hvin w hwpos hw1 C b hext hvind
  dsimp only at hactive
  rw [hwx] at hactive
  obtain ⟨himage, hcount⟩ := hactive
  have hambient : n ≤ d + 1 := by
    have hcard := hvind.fintype_card_le_finrank
    simpa only [Fintype.card_fin, Module.finrank_prod, Module.finrank_self,
      Module.finrank_pi, Nat.add_comm] using hcard
  exact ⟨n, v, w, hvS, hwpos, hw1, hwx, hvind, himage, hambient, hcount,
    Hirsch.ConstructedCutSupport.weights_unique n m d v w C b x hw1 hwx himage⟩

