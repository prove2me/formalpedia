theorem bitsR_cons (j : ℕ) (L : List ℕ) :
    bitsR bg (j :: L) = bitsR bg L ++ (if bg j then [2 * j + 1] else []) := by
  simp only [bitsR, bitsF, List.reverse_cons, List.filter_append, List.map_append]
  congr 1
  by_cases h : bg j <;> simp [h]

theorem bitsF_cons (j : ℕ) (L : List ℕ) :
    bitsF bg (j :: L) = (if bg j then [2 * j + 1] else []) ++ bitsF bg L := by
  simp only [bitsF, List.filter_cons]
  by_cases h : bg j <;> simp [h]

theorem perm_layA_F : ∀ L : List ℕ, List.Perm (layA bg L) (mains L ++ bitsF bg L)
  | [] => by simp [layA, mains, bitsF]
  | j :: L => by
    rw [layA_cons, bitsF_cons]
    simp only [atm, mains, List.map_cons, List.cons_append]
    refine List.Perm.cons _ ?_
    have IH := perm_layA_F L
    set bj : List ℕ := if bg j = true then [2 * j + 1] else []
    have h1 : List.Perm (bj ++ layA bg L) (bj ++ (mains L ++ bitsF bg L)) := IH.append_left _
    have h2 : List.Perm (bj ++ (mains L ++ bitsF bg L)) (mains L ++ (bj ++ bitsF bg L)) := by
      rw [← List.append_assoc, ← List.append_assoc]; exact List.perm_append_comm.append_right _
    simpa [mains] using h1.trans h2

theorem perm_layA_R (L : List ℕ) : List.Perm (layA bg L) (mains L ++ bitsR bg L) := by
  refine (perm_layA_F bg L).trans (List.Perm.append_left _ ?_)
  simp only [bitsR, bitsF, List.filter_reverse, List.map_reverse]
  exact (List.reverse_perm _).symm

theorem asz_pos (hmz : ∀ j, 1 ≤ mz j) (l : ℕ) : 1 ≤ asz mz l := by
  unfold asz; split_ifs
  · exact hmz _
  · omega

theorem vol_pos (hmz : ∀ j, 1 ≤ mz j) (L : List ℕ) : 1 ≤ AModel.vol (L.map (asz mz)) :=
  NLogN.KFU.one_le_vol _ (fun a ha => by
    simp only [List.mem_map] at ha; obtain ⟨l, -, rfl⟩ := ha; exact asz_pos mz hmz l)

theorem vol_perm {L M : List ℕ} (h : List.Perm L M) : AModel.vol (L.map (asz mz)) = AModel.vol (M.map (asz mz)) :=
  (h.map _).prod_eq

theorem vol_le_app (hmz : ∀ j, 1 ≤ mz j) (L M : List ℕ) :
    AModel.vol (L.map (asz mz)) ≤ AModel.vol ((L ++ M).map (asz mz)) := by
  rw [List.map_append, vol_append]
  exact Nat.le_mul_of_pos_right _ (vol_pos mz hmz M)

theorem vol_le_app' (hmz : ∀ j, 1 ≤ mz j) (L M : List ℕ) :
    AModel.vol (M.map (asz mz)) ≤ AModel.vol ((L ++ M).map (asz mz)) := by
  rw [List.map_append, vol_append]
  exact Nat.le_mul_of_pos_left _ (vol_pos mz hmz L)

/-- Volumes of the four blocks are at most the total. -/
theorem vol4_le (hmz : ∀ j, 1 ≤ mz j) (A F G C : List ℕ) :
    AModel.vol (A.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (F.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (G.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) ∧
    AModel.vol (C.map (asz mz)) ≤ AModel.vol ((A ++ F ++ G ++ C).map (asz mz)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [List.append_assoc]; exact vol_le_app mz hmz _ _
  · refine le_trans ?_ (vol_le_app mz hmz (A ++ F ++ G) C)
    refine le_trans ?_ (vol_le_app mz hmz (A ++ F) G)
    exact vol_le_app' mz hmz A F
  · refine le_trans ?_ (vol_le_app mz hmz (A ++ F ++ G) C)
    exact vol_le_app' mz hmz (A ++ F) G
  · exact vol_le_app' mz hmz _ C

