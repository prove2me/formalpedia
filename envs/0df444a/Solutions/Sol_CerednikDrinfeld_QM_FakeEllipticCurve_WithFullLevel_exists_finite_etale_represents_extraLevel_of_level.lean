variable {R₁ R₂ : Type} [CommRing R₁] [CommRing R₂] (ψ : R₁ →+* R₂)
  {A₁ : Scheme.{0}} {f₁ : A₁ ⟶ Spec (CommRingCat.of R₁)} (L₁ : RelativeGroupLaw R₁ f₁)
  {A₂ : Scheme.{0}} {f₂ : A₂ ⟶ Spec (CommRingCat.of R₂)} (L₂ : RelativeGroupLaw R₂ f₂)
  (kA : A₂ ⟶ A₁) (hkA : IsPullback kA f₂ f₁ (Spec.map (CommRingCat.ofHom ψ)))
  (hk : Transfer.IsHom ψ L₁ L₂ kA hkA)

theorem nsmul_coe_congr {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f)
    {T : Scheme.{0}} {t t' : T ⟶ Spec (CommRingCat.of R)} (h : t = t') (d : ℕ)
    (x : SchemeHomOver t f) (x' : SchemeHomOver t' f) (hx : x.1 = x'.1) :
    (L.nsmul t d x).1 = (L.nsmul t' d x').1 := by
  subst h; obtain rfl : x = x' := Subtype.ext hx; rfl

include hk in
theorem push_nsmul {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R₂)) (d : ℕ) (P : SchemeHomOver t f₂) :
    Transfer.push ψ kA hkA (L₂.nsmul t d P) = L₁.nsmul _ d (Transfer.push ψ kA hkA P) := by
  induction d with
  | zero => simp only [RelativeGroupLaw.nsmul_zero]; exact Transfer.push_one ψ L₁ L₂ kA hkA hk t
  | succ d ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, hk, ih]

include hk in

theorem kA_schemeNsmul (d : ℕ) : L₂.schemeNsmul d ≫ kA = kA ≫ L₁.schemeNsmul d := by
  have h1 : L₂.schemeNsmul d ≫ kA = (Transfer.push ψ kA hkA (L₂.nsmul f₂ d RelativeGroupLaw.idPoint)).1 := rfl
  have h2 : kA ≫ L₁.schemeNsmul d = (schemeHomOverComp kA rfl (L₁.nsmul f₁ d RelativeGroupLaw.idPoint)).1 := rfl
  rw [h1, h2, push_nsmul ψ L₁ L₂ kA hkA hk, L₁.nsmul_natural f₁ (kA ≫ f₁) kA rfl]
  apply nsmul_coe_congr L₁ hkA.w.symm
  simp only [Transfer.push_coe, schemeHomOverComp_coe]
  show 𝟙 _ ≫ kA = kA ≫ 𝟙 _
  simp

variable (n : ℕ) (kN : L₂.schemeKer n ⟶ L₁.schemeKer n)
  (hkN : IsPullback kN (L₂.schemeKerStr n) (L₁.schemeKerStr n) (Spec.map (CommRingCat.ofHom ψ)))
  (hkNι : kN ≫ KerOps.ι L₁ n = KerOps.ι L₂ n ≫ kA)
  (hc₁ : L₁.IsCommutative) (hc₂ : L₂.IsCommutative)
  [IsFinite (L₁.schemeKerStr n)] [Etale (L₁.schemeKerStr n)]
  [IsFinite (L₂.schemeKerStr n)] [Etale (L₂.schemeKerStr n)]

include hk hkN hkNι in
theorem kN_mulBy (d : ℕ) : kN ≫ mulBy L₁ hc₁ n d = mulBy L₂ hc₂ n d ≫ kN :=
  Transfer.kN_endK ψ L₁ L₂ kA n kN hkN hkNι _ _ (isHomPt_schemeNsmul L₁ hc₁ d) _ _ (isHomPt_schemeNsmul L₂ hc₂ d)
    (kA_schemeNsmul ψ L₁ L₂ kA hkA hk d)

omit [IsFinite (L₁.schemeKerStr n)] [Etale (L₁.schemeKerStr n)]
  [IsFinite (L₂.schemeKerStr n)] [Etale (L₂.schemeKerStr n)] in

theorem mem_iff_range_fromSpecResidueField {X : Scheme.{0}} (W : Set ↥X) (x : ↥X) :
    x ∈ W ↔ Set.range (X.fromSpecResidueField x) ⊆ W := by
  rw [Scheme.range_fromSpecResidueField, Set.singleton_subset_iff]

omit [IsFinite (L₁.schemeKerStr n)] [Etale (L₁.schemeKerStr n)]
  [IsFinite (L₂.schemeKerStr n)] [Etale (L₂.schemeKerStr n)] in

theorem mem_iff_range_comp {X Y : Scheme.{0}} (k : X ⟶ Y) (W : Set ↥Y) (x : ↥X) :
    k x ∈ W ↔ Set.range (X.fromSpecResidueField x ≫ k) ⊆ W := by
  have hpt : ∀ p, (X.fromSpecResidueField x) p = x := fun p => by
    have : (X.fromSpecResidueField x) p ∈ Set.range (X.fromSpecResidueField x) := ⟨p, rfl⟩
    rw [Scheme.range_fromSpecResidueField] at this
    exact this
  constructor
  · rintro h y ⟨p, rfl⟩
    show (X.fromSpecResidueField x ≫ k) p ∈ W
    rw [Scheme.Hom.comp_apply, hpt]; exact h
  · intro h
    have := h ⟨IsLocalRing.closedPoint _, rfl⟩
    change (X.fromSpecResidueField x ≫ k) _ ∈ W at this
    rw [Scheme.Hom.comp_apply, hpt] at this
    exact this

include hk hkN hkNι in
theorem Td_transfer (d : ℕ) : kN ⁻¹ᵁ Td L₁ hc₁ n d = Td L₂ hc₂ n d := by
  ext x
  show kN x ∈ (Td L₁ hc₁ n d : Set _) ↔ x ∈ (Td L₂ hc₂ n d : Set _)
  rw [mem_iff_range_fromSpecResidueField (Td L₂ hc₂ n d : Set _) x, range_subset_Td_iff,
    mem_iff_range_comp kN (Td L₁ hc₁ n d : Set _) x, range_subset_Td_iff]
  set ι := (L₂.schemeKer n).fromSpecResidueField x
  have e1 : (ι ≫ kN) ≫ mulBy L₁ hc₁ n d = (ι ≫ mulBy L₂ hc₂ n d) ≫ kN := by
    rw [Category.assoc, kN_mulBy ψ L₁ L₂ kA hkA hk n kN hkN hkNι hc₁ hc₂ d, Category.assoc]
  have e2 : (ι ≫ kN) ≫ L₁.schemeKerStr n ≫ KerOps.oneK L₁ n = (ι ≫ L₂.schemeKerStr n ≫ KerOps.oneK L₂ n) ≫ kN := by
    rw [Category.assoc, ← Category.assoc kN, hkN.w, Category.assoc,
      Transfer.kN_oneK ψ L₁ L₂ kA hkA hk n kN hkN hkNι, Category.assoc, Category.assoc]
  rw [e1, e2]
  constructor
  · intro h
    apply hkN.hom_ext
    · exact h
    · rw [Category.assoc, KerOps.endK_str L₂ n _ _ (isHomPt_schemeNsmul L₂ hc₂ d), Category.assoc, Category.assoc,
        KerOps.oneK_str, Category.comp_id]
  · intro h; rw [h]

end TorsionTransfer
