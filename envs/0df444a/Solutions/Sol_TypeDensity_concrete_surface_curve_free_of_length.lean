theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O] (pi : O)
    (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ) (a b : ℕ) (ha : 0 < a)
    (f : TypeDensity.ConcreteSurface O pi u a b)
    (hf : Function.Injective
      (fun w : TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span
      {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi} => Ideal.Quotient.mk
      (Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi}) f * w)) (N : ℕ)
    (hN : Module.length (TypeDensity.ConcreteSurface O pi u a b)
      (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f}) =
      N) :
    Module.Free O (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {f}) ∧ Module.Finite O
      (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {f}) ∧ Module.finrank O
      (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {f}) = N := by
  have : IsLocalRing (TypeDensity.ConcreteSurface O pi u a b) :=
      TypeDensity.concrete_surface_isLocalRing O pi u a b hpi.not_isUnit ha
  obtain ⟨e, he⟩ := TypeDensity.concrete_surface_residueField_equiv O pi hpi u a b ha
  have hsurj : ∀ r : (TypeDensity.ConcreteSurface O pi u a b), ∃ c : O,
      r - algebraMap O (TypeDensity.ConcreteSurface O pi u a b) c ∈ IsLocalRing.maximalIdeal
      (TypeDensity.ConcreteSurface O pi u a b) := by
    intro r
    obtain ⟨k, hk⟩ := e.surjective (IsLocalRing.residue (TypeDensity.ConcreteSurface O pi u a b) r)
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective k
    exact ⟨c, by rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← he, hk, sub_self]⟩
  have hker : ∀ c : O,
      algebraMap O (TypeDensity.ConcreteSurface O pi u a b) c ∈ IsLocalRing.maximalIdeal
      (TypeDensity.ConcreteSurface O pi u a b) → pi ∣ c := by
    intro c hc
    rwa [← IsLocalRing.residue_eq_zero_iff, ← he, map_eq_zero_iff e e.injective,
      IsLocalRing.residue_eq_zero_iff, hpi.maximalIdeal_eq, Ideal.mem_span_singleton] at hc
  have hsm : ∀ (I : Ideal (TypeDensity.ConcreteSurface O pi u a b)) (r : TypeDensity.ConcreteSurface O pi u a b),
      pi • Ideal.Quotient.mk I r = Ideal.Quotient.mk I (algebraMap O _ pi * r) :=
    fun I r ↦ congrArg (Ideal.Quotient.mk I) (Algebra.smul_def pi r)
  have hpiM : ∀ m :
      (TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f}),
      pi • m = 0 := by
    intro m
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective m
    rw [hsm, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert _ _))
  obtain ⟨γ, hγ⟩ := TypeDensity.residue_basis_family_of_length O (TypeDensity.ConcreteSurface O pi u a b)
      ((TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f}))
      pi hsurj hker hpiM N hN
  have hle : Ideal.span {f} ≤ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f} :=
      Ideal.span_mono (by simp)
  let q : ((TypeDensity.ConcreteSurface O pi u a b) ⧸ Ideal.span {f}) →ₗ[O]
      ((TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f}))
      := (Ideal.Quotient.factorₐ O hle).toLinearMap
  have hq : Function.Surjective q := Ideal.Quotient.factor_surjective hle
  obtain ⟨β₀, -, hβ₀⟩ :=
    TypeDensity.residue_basis_family_lift_along_reduction O ((TypeDensity.ConcreteSurface O pi u a b) ⧸ Ideal.span {f})
        ((TypeDensity.ConcreteSurface O pi u a b ⧸ Ideal.span
          {algebraMap O (TypeDensity.ConcreteSurface O pi u a b) pi, f})) pi q hq
          (TypeDensity.factor_span_pair_eq_zero_iff pi f hle) γ hγ
  choose β hβ using fun i ↦ Ideal.Quotient.mk_surjective (β₀ i)
  have hfun : (fun i ↦ Ideal.Quotient.mk (Ideal.span {f}) (β i)) = β₀ := funext hβ
  exact TypeDensity.concrete_surface_curve_free_finrank O pi hpi u a b ha f hf β (hfun ▸ hβ₀)
