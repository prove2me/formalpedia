-- title:
--   Strict weighted generators for a power of logarithmic centers
-- statement:
--   Under the logarithmic interpolation numerical hypotheses and coordinatewise injectivity, some power of the canonical logarithmic centers ideal is generated by elements in that power whose support has weighted degree at most D, with D strictly less than the power index times R.

import Definitions.Def_OAI_PiExponent_TruncatedPolynomialJets
import Definitions.Def_OAI_PiExponent_LogarithmicInterpolationNumerics

open scoped BigOperators
open OAI.PiExponent OAI.PiExponent.DeterminantContradiction OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.logarithmicCentersIdeal_strict_power_generators
    {m K : Nat} (c : Fin K → Fin m → Complex)
    (hc : ∀ i : Fin m, Function.Injective (fun j : Fin K => c j i))
    (w v : Fin (m + 1) → Rat) (sigma : Rat)
    (hnum : LogarithmicInterpolationNumerics m K w v sigma)
    (R : Rat) (e : Fin (m + 1) → Nat)
    (hR : 0 < R) (he : ∀ i, 0 < e i)
    (hscale : ∀ i, (R : Real) = (e i : Real) * (v i : Real)) :
    ∃ s : Nat, ∃ D : Rat,
      (D : Real) < (s : Real) * (R : Real) ∧
      logarithmicCentersIdeal c (fun _ => e 0) e ^ s =
        Ideal.span {p : MvPolynomial (Fin (m + 1)) Complex |
          p ∈ logarithmicCentersIdeal c (fun _ => e 0) e ^ s ∧
          ∀ a ∈ p.support, ∑ i, (w i : Real) * (a i : Real) ≤ (D : Real)} := by sorry
