  · have hle : 3328 ≤ q := by omega
    simpa only [Nat.add_sub_of_le hle] using
      case001_blockers1 ⟨q-3328,by omega⟩
private theorem rows_check : certificate001.rows.toList.all (rowB certificate001) = true := by
  decide_cbv
private theorem covers_check : (List.range certificate001.pool.size).all (localCoverB certificate001) = true := by
  decide_cbv
private theorem cost_check : decide (cost certificate001 < certificate001.denominator * (deletedCount certificate001+1)) = true := by
  decide_cbv
theorem solution : CompletionBound (decode 1) (1 : ZMod 3) := by
  have hs : certificate001.blockers.size = 6561 := by
    simp only [certificate001, binaryBlockers, Array.size_ofFn]
  have hb : CompletionBound (decode certificate001.normal) certificate001.level := by
