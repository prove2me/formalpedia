/-! ## Partial sums and the fixed point -/

/-- Partial sums of the Picard series. -/
noncomputable def SN (N : ℕ) (t : ℝ) : ℝ := ∑ i ∈ Finset.range N, Yfun i t

/-! ## The factorial tail -/

/-- The `N`-th factorial tail `∑' k, (R-3)^(k+N)/(k+N)!`. -/
noncomputable def tail (N : ℕ) (R : ℝ) : ℝ :=
  ∑' k : ℕ, (R - 3) ^ (k + N) / (Nat.factorial (k + N) : ℝ)

