variable (src : ℕ → ℕ)

theorem chF_ge {t y : ℕ} (h : t ≤ y) : ∀ m, chF src t m y = y
  | 0 => rfl
  | m + 1 => by simp only [chF, if_neg (Nat.not_lt.2 h)]; exact chF_ge h m

theorem chF_FH {t : ℕ} : ∀ (m y z k : ℕ), src^[k] y = z → t ≤ z → (∀ i < k, src^[i] y < t) →
    k ≤ m → chF src t m y = z
  | 0, y, z, k, h1, _, _, hk => by
    have : k = 0 := by omega
    subst this; exact h1
  | m + 1, y, z, k, h1, h2, h3, hk => by
    simp only [chF]
    by_cases hy : y < t
    · rw [if_pos hy]
      cases k with
      | zero => simp at h1; omega
      | succ k =>
        rw [Function.iterate_succ_apply] at h1
        exact chF_FH m (src y) z k h1 h2 (fun i hi => by
          have := h3 (i + 1) (by omega); rwa [Function.iterate_succ_apply] at this) (by omega)
    · rw [if_neg hy]
      cases k with
      | zero => simp at h1; subst h1; exact chF_ge src (by omega) m
      | succ k => exact absurd (h3 0 (by omega)) (by simpa using hy)

variable {N : ℕ} (hsrc : ∀ x < N, src x < N)
  (hinj : ∀ x < N, ∀ y < N, src x = src y → x = y)
include hsrc

theorem iter_lt : ∀ k, ∀ x < N, src^[k] x < N
  | 0, x, hx => hx
  | k + 1, x, hx => by rw [Function.iterate_succ_apply]; exact iter_lt k _ (hsrc x hx)

include hinj

theorem iter_inj : ∀ k, ∀ x < N, ∀ y < N, src^[k] x = src^[k] y → x = y
  | 0, _, _, _, _, h => h
  | k + 1, x, hx, y, hy, h => by
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply] at h
    exact hinj x hx y hy (iter_inj k _ (hsrc x hx) _ (hsrc y hy) h)

/-- Every point of `[0, N)` returns within `N` steps. -/
theorem period {u : ℕ} (hu : u < N) : ∃ m, 1 ≤ m ∧ m ≤ N ∧ src^[m] u = u := by
  have hN : 0 < N := by omega
  let f : Fin (N + 1) → Fin N := fun k => ⟨src^[k] u, iter_lt src hsrc k u hu⟩
  obtain ⟨i, j, hij, he⟩ := Fintype.exists_ne_map_eq_of_card_lt f (by simp)
  have he' : src^[i] u = src^[j] u := congrArg Fin.val he
  rcases Nat.lt_or_gt_of_ne (Fin.val_ne_of_ne hij) with h | h
  · refine ⟨j - i, by omega, by have := j.isLt; omega, ?_⟩
    apply iter_inj src hsrc hinj i _ (iter_lt src hsrc _ u hu) _ hu
    rw [← Function.iterate_add_apply, show i + (j - i) = (j : ℕ) by omega]; exact he'.symm
  · refine ⟨i - j, by omega, by have := i.isLt; omega, ?_⟩
    apply iter_inj src hsrc hinj j _ (iter_lt src hsrc _ u hu) _ hu
    rw [← Function.iterate_add_apply, show j + (i - j) = (i : ℕ) by omega]; exact he'

/-- The first hit from `src u` (`t ≤ u`) is within `N` steps. -/
theorem FH_bound {t u k : ℕ} (hu : u < N) (htu : t ≤ u) (h3 : ∀ i < k, src^[i] (src u) < t) :
    k < N := by
  obtain ⟨m, hm1, hmN, hm⟩ := period src hsrc hinj hu
  have e : src^[m - 1] (src u) = u := by
    rw [← Function.iterate_succ_apply, show (m - 1).succ = m by omega]; exact hm
  by_contra hk
  have := h3 (m - 1) (by omega)
  omega

