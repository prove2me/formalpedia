section LocalHeight

variable {K : Type*} [NormedField K]

private theorem rowNormSq_unipotent_mul {n : GL (Fin 2) K} (g : GL (Fin 2) K)
    (h0 : (n : Matrix (Fin 2) (Fin 2) K) 1 0 = 0)
    (h1 : (n : Matrix (Fin 2) (Fin 2) K) 1 1 = 1) :
    rowNormSq ((n * g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K)
      = rowNormSq (g : Matrix (Fin 2) (Fin 2) K) := by
  have hcoe : ((n * g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K)
      = (n : Matrix (Fin 2) (Fin 2) K) * (g : Matrix (Fin 2) (Fin 2) K) := rfl
  have hbot : ∀ j : Fin 2, ((n : Matrix (Fin 2) (Fin 2) K) * (g : Matrix (Fin 2) (Fin 2) K)) 1 j
      = (g : Matrix (Fin 2) (Fin 2) K) 1 j := by
    intro j
    rw [Matrix.mul_apply, Fin.sum_univ_two, h0, h1, zero_mul, one_mul, zero_add]
  unfold rowNormSq
  rw [hcoe, hbot 0, hbot 1]

private theorem localHeight_unipotent_mul {n : GL (Fin 2) K} (g : GL (Fin 2) K)
    (h0 : (n : Matrix (Fin 2) (Fin 2) K) 1 0 = 0)
    (h1 : (n : Matrix (Fin 2) (Fin 2) K) 1 1 = 1)
    (h2 : (n : Matrix (Fin 2) (Fin 2) K) 0 0 = 1) :
    localHeight (n * g) = localHeight g := by
  have hdetn : (n : Matrix (Fin 2) (Fin 2) K).det = 1 := by
    rw [Matrix.det_fin_two, h0, h1, h2]
    ring
  have hcoe : ((n * g : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K)
      = (n : Matrix (Fin 2) (Fin 2) K) * (g : Matrix (Fin 2) (Fin 2) K) := rfl
  unfold localHeight
  rw [rowNormSq_unipotent_mul g h0 h1, hcoe, Matrix.det_mul, hdetn, one_mul]

end LocalHeight
