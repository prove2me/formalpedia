    (hsw : ∀ X, Pr X → ∀ a b, NLogN.KIL.TStep.sw a b ∈ tpl X → ∀ (t : NLogN.IState NLogN.HS) (R : List NLogN.Item)
      (ys : List (ZMod 2)), NLogN.KIL.Inv G0 t → ys.length = AModel.vol (P :: L' :: AModel.hdShape A B Cs m N) →
      NLogN.IRuns I iprog (NLogN.KIL.swC m j0 (a : ℕ) (b : ℕ)) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R))
