variable {k : Type} [Field k] {P : Scheme.{0}} (c : A1 k ⟶ P) [IsOpenImmersion c] {a : k} {Uo Uz : P.Opens}
  (h : Uo ≤ Uz) (hz : ∀ x : P, x ∈ Uz ↔ x ≠ c (A1pt k a))

include h hz in
/-- **`hD₂`**: `D₂ ×_P U₀` lies over `c(D(g₀ c₀' t))`. -/
theorem mem_opnDg_prd {B₂ : CommRingCat.{0}} (φ₂ : CommRingCat.of k[X] ⟶ B₂) [Etale (Spec.map φ₂ ≫ c)] {g₀ c₀' : k[X]}
    (hg : IsUnit (φ₂.hom g₀)) (hc : IsUnit (φ₂.hom c₀')) (v : (prd (chEt c φ₂) (opEt Uo)).left) :
    (prd (chEt c φ₂) (opEt Uo)).hom v ∈ opnDg c (g₀ * c₀' * (X - C a)) := by
  let w : Spec B₂ := pullback.fst (chEt c φ₂).hom (opEt Uo).hom v
  have e1 : (prd (chEt c φ₂) (opEt Uo)).hom v = (opEt Uo).hom (pullback.snd (chEt c φ₂).hom (opEt Uo).hom v) := rfl
  have e2 : (chEt c φ₂).hom w = (opEt Uo).hom (pullback.snd (chEt c φ₂).hom (opEt Uo).hom v) :=
    congrArg (fun F => F v) (pullback.condition (f := (chEt c φ₂).hom) (g := (opEt Uo).hom))
  have hUo : (prd (chEt c φ₂) (opEt Uo)).hom v ∈ Uo := by
    rw [e1]
    show (Uo.ι ≫ 𝟙 P) _ ∈ Uo
    rw [Category.comp_id]
    exact opnι_mem (etId P) Uo _
  have hx : (prd (chEt c φ₂) (opEt Uo)).hom v = c (Spec.map φ₂ w) := e1.trans e2.symm
  refine mem_opnDg c hx fun hG => ?_
  rcases (Spec.map φ₂ w).isPrime.mem_or_mem hG with h12 | ht
  · rcases (Spec.map φ₂ w).isPrime.mem_or_mem h12 with hg0 | hc0
    · exact w.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.1 hg0) hg)
    · exact w.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_comap.1 hc0) hc)
  · have h1 : Spec.map φ₂ w = A1pt k a := eq_A1pt_of_mem ht
    exact (hz _).1 (h hUo) (hx.trans (congrArg (fun y => c y) h1))

end Pts

