-- Source module: Solutions.KFWSwapG
/-!
# KFW: uniform Lemma 12 on Gaussian arrays (`SwapNeed`)

`swGU q = descP ; swWU q ; popP`: read the descriptor `descSw w u p q sh` on `dS` into the
registers of `swWU` (`descP`), run the register-driven integer swap on the shape `sh ++ [2]`,
and pop the registers again.  **`swGU_spec`**, and **`swapNeed : KFM.SwapNeed`** with the table
`kTable (fun _ => (swGU q).ren id (gL 1))` (one fixed prime `q`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KIL KFD KFB KFS KFL AModel AModelL12

theorem fok_descP : fok descP = true := by decide

theorem fok_popP : fok popP = true := by decide

theorem popP_fsp (s : IState HS) (f : Fin HS → List ℤ) (D : List ℤ) (a1 a2 a3 a4 a5 a6 : ℤ) {B : ℕ}
    (h1 : zsz a1 ≤ B) (h2 : zsz a2 ≤ B) (h3 : zsz a3 ≤ B) (h4 : zsz a4 ≤ B) (h5 : zsz a5 ≤ B)
    (h6 : zsz a6 ≤ B) :
    FSp popP (encK s (stD f D [] [a1] [a2] [a3] [a4] [a5] [a6] [] [] [] []))
      (encK s (stD f D [] [] [] [] [] [] [] [] [] [] [])) (6 * (2 * B + 2)) := by
  have P1 := Sp.pop (s := s) (f := stD f D [] [a1] [a2] [a3] [a4] [a5] [a6] [] [] [] []) (i := sN)
    (a := a6) (l := []) (B := B) (by decide) rfl h6
  have P2 := Sp.pop (s := s) (f := stD f D [] [a1] [a2] [a3] [a4] [a5] [] [] [] [] []) (i := sS)
    (a := a5) (l := []) (B := B) (by decide) rfl h5
  have P3 := Sp.pop (s := s) (f := stD f D [] [a1] [a2] [a3] [a4] [] [] [] [] [] []) (i := sG)
    (a := a4) (l := []) (B := B) (by decide) rfl h4
  have P4 := Sp.pop (s := s) (f := stD f D [] [a1] [a2] [a3] [] [] [] [] [] [] []) (i := sP)
    (a := a3) (l := []) (B := B) (by decide) rfl h3
  have P5 := Sp.pop (s := s) (f := stD f D [] [a1] [a2] [] [] [] [] [] [] [] []) (i := sU)
    (a := a2) (l := []) (B := B) (by decide) rfl h2
  have P6 := Sp.pop (s := s) (f := stD f D [] [a1] [] [] [] [] [] [] [] [] []) (i := sW)
    (a := a1) (l := []) (B := B) (by decide) rfl h1
  simp only [stD_upd_sN, stD_upd_sS, stD_upd_sG, stD_upd_sP, stD_upd_sU, stD_upd_sW] at P1 P2 P3 P4 P5 P6
  refine ((FSp.of_norep rfl P1).seq ((FSp.of_norep rfl P2).seq ((FSp.of_norep rfl P3).seq
    ((FSp.of_norep rfl P4).seq ((FSp.of_norep rfl P5).seq (FSp.of_norep rfl P6)))))).mono ?_
  omega

/-- The register values of `regsSw` are `< 2^B`. -/
theorem regs_bnd {w u p q : ℕ} {sh : List ℕ} (hsh : ∀ a ∈ sh, 1 ≤ a) :
    let B := Nat.size sh.prod + w + u + 8
    zsz (w : ℤ) ≤ B ∧ zsz (u : ℤ) ≤ B ∧ zsz (((preS sh p).prod : ℕ) : ℤ) ≤ B ∧
      zsz (((midS sh p q).prod : ℕ) : ℤ) ≤ B ∧
      zsz ((((sufS sh q).prod * 2 * (w + 1) : ℕ)) : ℤ) ≤ B ∧ zsz (((2 * sh.prod : ℕ)) : ℤ) ≤ B := by
  intro B
  have hV := Nat.lt_size_self sh.prod
  have hw := Nat.lt_two_pow_self (n := w)
  have hu := Nat.lt_two_pow_self (n := u)
  have hle : ∀ m, m ≤ B → 2 ^ m ≤ 2 ^ B := fun m hm => Nat.pow_le_pow_right (by norm_num) hm
  have z : ∀ n : ℕ, n < 2 ^ B → zsz (n : ℤ) ≤ B := fun n hn => zsz_le_of_lt (by simpa using hn)
  have hP : (preS sh p).prod ≤ sh.prod := prod_take_le hsh p
  have hG : (midS sh p q).prod ≤ sh.prod :=
    le_trans (prod_take_le (fun a ha => hsh a (List.mem_of_mem_drop ha)) _) (prod_drop_le hsh _)
  have hS : (sufS sh q).prod ≤ sh.prod := prod_drop_le hsh _
  have e1 : 2 ^ (Nat.size sh.prod + 1 + w) = 2 ^ Nat.size sh.prod * 2 * 2 ^ w := by
    rw [pow_add, pow_add, pow_one]
  refine ⟨z _ (lt_of_lt_of_le hw (hle _ (by omega))), z _ (lt_of_lt_of_le hu (hle _ (by omega))),
    z _ (lt_of_le_of_lt hP (lt_of_lt_of_le hV (hle _ (by omega)))),
    z _ (lt_of_le_of_lt hG (lt_of_lt_of_le hV (hle _ (by omega)))), z _ ?_, z _ ?_⟩
  · have h1 : (sufS sh q).prod * 2 * (w + 1) < 2 ^ Nat.size sh.prod * 2 * 2 ^ w :=
      Nat.mul_lt_mul_of_lt_of_le (Nat.mul_lt_mul_of_pos_right (lt_of_le_of_lt hS hV) (by norm_num))
        hw (by positivity)
    rw [← e1] at h1
    exact lt_of_lt_of_le h1 (hle _ (by omega))
  · have h1 : 2 * sh.prod < 2 ^ (Nat.size sh.prod + 1) := by rw [pow_succ]; omega
    exact lt_of_lt_of_le h1 (hle _ (by omega))

theorem stD_self (g : Fin HS → List ℤ)
    (hg : ∀ j ∈ [sT, sW, sU, sP, sG, sS, sN, xp, xq, xL, aS], g j = []) :
    stD g (g dS) [] [] [] [] [] [] [] [] [] [] [] = g := by
  funext j
  by_cases hj : j ∈ [dS, sT, sW, sU, sP, sG, sS, sN, xp, xq, xL, aS]
  · simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rfl
    all_goals exact (hg _ (by decide)).symm
  · rw [stD_other _ _ _ _ _ _ _ _ _ _ _ _ _ hj]

theorem stD_upd0 (g : Fin HS → List ℤ) (D T W U P G S N X Y Lr A X0 : List ℤ) :
    Function.update (stD g D T W U P G S N X Y Lr A) 0 X0 =
      stD (Function.update g 0 X0) D T W U P G S N X Y Lr A := by
  funext j
  by_cases hj : j ∈ [dS, sT, sW, sU, sP, sG, sS, sN, xp, xq, xL, aS]
  · have h0 : j ≠ 0 := by
      intro h; subst h; revert hj; decide
    rw [Function.update_of_ne h0]
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> rfl
  · rw [stD_other _ _ _ _ _ _ _ _ _ _ _ _ _ hj]
    by_cases h0 : j = 0
    · subst h0; simp
    · rw [Function.update_of_ne h0, Function.update_of_ne h0, stD_other _ _ _ _ _ _ _ _ _ _ _ _ _ hj]

end NLogN.KFW

end

section
-- Source module: Solutions.R6ILSwapU
/-!
# Round six, item language: `SwapNeedτ` from fine Lemma 12 (parametric copy of KFW's chain)

`KFW.swIU_spec`, `KFW.swWU_spec`, `KFW.swGU_spec` and `KFW.swapNeed` with the OpenAI Lemma 12
(`KFB.lemma12_fine_canon`, table `KFL.l12prog`, code `KFL.l12C q`, `τS`) replaced by any
`L12Canon tab l12 τ`. The register programs (`toBitsU`, `fromBitsU`, `descP`, `popP`) are the
frozen ones.

**`swapNeedτ_of_l12Canon : L12Canon tab l12 τ → SwapNeedτ tab τ`** (`0 ≤ τ`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFS NLogN.KFL NLogN.KFW AModel AModelL12

section Chain

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

theorem swGUP_spec_sol_aux (hτ : 0 ≤ τ) (h : L12Canon tab l12 τ) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q → q < sh.length →
      sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
      ∀ (I : List Sym) (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
      (∀ j, j ≠ 0 → j ≠ dS → f j = []) → f dS = KFM.descSw w u p q sh →
      f 0 = gflat zs ++ l → zs.length = vol sh → GB w zs →
      ∃ c : ℕ, IRuns I tab (swGUP l12) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
        (c : ℝ) ≤ K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ +
          (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ)) := by
  obtain ⟨K, hK, HK⟩ := swWUP_spec hτ h
  refine ⟨2 * K + 10 ^ 14, by positivity,
    fun u w sh p q hu hsh hpq hq hpu hqu I s f zs l hf hfD hf0 hzl hGB => ?_⟩
  have hp : p < sh.length := by omega
  have hfe : ∀ j ∈ [KFW.sT, sW, sU, sP, sG, sS, sN, xp, xq, xL, aS, cC], f j = [] := by
    intro j hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact hf _ (by decide) (by decide)
  -- 1. the descriptor
  have D1 := descP_run s f w u p q sh [] hsh hpq hq hpu hqu
    (by rw [hfD, KFM.descSw]; simp [List.map_eq_flatMap]) hfe
  have S1 := FSp.irun (I := I) (iprog := tab) fok_descP D1
  -- 2. the integer swap on `sh ++ [2]`
  set sh' := sh ++ [2] with hsh'
  have hsh2 : ∀ a ∈ sh', 1 ≤ a := by
    intro a ha; simp only [hsh', List.mem_append, List.mem_singleton] at ha
    rcases ha with ha | rfl
    · exact hsh a ha
    · omega
  have hq' : q < sh'.length := by simp [hsh']; omega
  have gp : sh'.getD p 0 = 2 ^ u := by rw [hsh', List.getD_append _ _ _ _ hp, hpu]
  have gq : sh'.getD q 0 = 2 ^ u := by rw [hsh', List.getD_append _ _ _ _ hq, hqu]
  have eS := binShape_split sh' hpq hq' gp gq
  obtain ⟨h1, h2, h3⟩ := pos_sub hsh2 p q
  have vP' : vol (preS sh' p) = (preS sh p).prod := by
    simp only [vol, preS, hsh', List.take_append_of_le_length (show p ≤ sh.length by omega)]
  have vG' : vol (midS sh' p q) = (midS sh p q).prod := by
    simp only [vol, midS, hsh', List.drop_append_of_le_length (show p + 1 ≤ sh.length by omega)]
    rw [List.take_append_of_le_length (by simp; omega)]
  have vS' : vol (sufS sh' q) = (sufS sh q).prod * 2 := by
    simp only [vol, sufS, hsh', List.drop_append_of_le_length (show q + 1 ≤ sh.length by omega),
      List.prod_append, List.prod_singleton]
  have vN : vol (binShape (preS sh' p) (midS sh' p q) (sufS sh' q) (2 ^ u)) = 2 * sh.prod := by
    rw [eS, hsh', vol_append]; simp [vol]; ring
  set t := encK s (regsSw f w u p q sh) with ht
  set R0 := ints l ++ s.G 0 with hR0
  have ht0 : t.G 0 = ints (gflat zs) ++ R0 := by
    simp [ht, regsSw, hf0, ints_append, hR0]
  obtain ⟨c2, Hc, hc⟩ := HK u w (preS sh' p) (midS sh' p q) (sufS sh' q) hu h1 h2 h3 I t
    (gflat zs) R0 ht0 (by rw [eS, length_gflat, hzl, hsh', vol_append]; simp [vol]; ring)
    (zsz_gflat' hGB)
    (L1 := s.G sN) (L2 := s.G sW) (L3 := s.G sP) (L4 := s.G sG) (L5 := s.G sS) (L6 := s.G sU)
    (by rw [vN, ht, encK_G]; rfl) (by rw [ht, encK_G]; rfl) (by rw [vP', ht, encK_G]; rfl)
    (by rw [vG', ht, encK_G]; rfl) (by rw [vS', ht, encK_G]; rfl) (by rw [ht, encK_G]; rfl)
  rw [eS, len_midS sh' hpq hq', len_preS sh' (by omega)] at Hc
  have hs : sh.getD p 0 = sh.getD q 0 := by rw [hpu, hqu]
  rw [← gflat_pull_swapPos sh hp hq hs 0 zs hzl] at Hc
  set Y := gflat (pull sh sh (swapPos p q) 0 zs) with hY
  have eT : t.upd 0 (ints Y ++ R0) =
      encK s (stD (Function.update f 0 (Y ++ l)) (f dS) [] [(w : ℤ)] [(u : ℤ)]
        [((preS sh p).prod : ℤ)] [((midS sh p q).prod : ℤ)]
        [(((sufS sh q).prod * 2 * (w + 1) : ℕ) : ℤ)] [((2 * sh.prod : ℕ) : ℤ)] [] [] [] []) := by
    rw [ht, hR0, show ints Y ++ (ints l ++ s.G 0) = ints (Y ++ l) ++ s.G 0 by
      rw [ints_append, List.append_assoc], encK_upd, regsSw, stD_upd0]
  have S2 := Hc.mono' eT le_rfl
  -- 3. pop the registers
  set g := Function.update f 0 (Y ++ l) with hg
  have hgD : g dS = f dS := Function.update_of_ne (by decide) _ _
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := regs_bnd (w := w) (u := u) (p := p) (q := q) hsh
  have P3 := popP_fsp s g (f dS) _ _ _ _ _ _ b1 b2 b3 b4 b5 b6
  have eG : stD g (f dS) [] [] [] [] [] [] [] [] [] [] [] = g := by
    rw [← hgD]; refine stD_self g (fun j hj => ?_)
    have hj0 : j ≠ 0 := by
      intro h; subst h; revert hj; decide
    rw [hg, Function.update_of_ne hj0]; exact hfe j (by simp only [List.mem_cons] at hj ⊢; tauto)
  rw [eG] at P3
  have S3 := FSp.irun (I := I) (iprog := tab) fok_popP P3
  refine ⟨_, S1.seq (S2.seq S3), ?_⟩
  -- 4. the cost
  have hdc := descCost_le sh.length sh.prod w u
  rw [vN] at hc
  set X : ℝ := ((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ with hX
  set Yc : ℕ := (sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 with hYc
  have hX0 : 0 ≤ X := by positivity
  have hc2 : (c2 : ℝ) ≤ 2 * K * X := by
    refine le_trans hc ?_
    have hu0 : (0 : ℝ) ≤ (u : ℝ) ^ τ := by positivity
    have hV : ((2 * sh.prod : ℕ) : ℝ) + 1 ≤ 2 * ((vol sh : ℝ) + 1) := by
      push_cast; simp only [vol]; push_cast; linarith
    rw [hX]
    have := mul_le_mul_of_nonneg_left hV (show (0 : ℝ) ≤ K * ((w : ℝ) + 1) by positivity)
    nlinarith
  have hdc' : ((25 * xD sh.length (Nat.size sh.prod + w + u + 8)
      (Nat.size sh.prod + w + u + 8 + zsz (sh.length : ℤ)) +
      6 * (2 * (Nat.size sh.prod + w + u + 8) + 2) : ℕ) : ℝ) ≤ 10 ^ 14 * (Yc : ℝ) := by
    rw [hYc]; exact_mod_cast hdc
  have hY0 : (0 : ℝ) ≤ Yc := Nat.cast_nonneg _
  push_cast at hdc' ⊢
  nlinarith

end Chain

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.swGUP_spec_sol_aux := @IntMul.Kappa.R6.IL.swGUP_spec_sol_aux
