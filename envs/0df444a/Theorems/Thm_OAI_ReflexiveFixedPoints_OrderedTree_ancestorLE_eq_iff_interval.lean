open OAI OAI.ReflexiveFixedPoints OAI.ReflexiveFixedPoints.OrderedTree
variable (T : OrderedTree) {i j : ℕ}

theorem OAI.ReflexiveFixedPoints.OrderedTree.ancestorLE_eq_iff_interval (h : i ≤ j) (v : T.Node i) (s : T.Node j) :
    T.ancestorLE h s = v ↔
      T.descendantLo h v ≤ s.val ∧ s.val < T.descendantHi h v := by sorry
