theorem solution
    (p ℓ : ℕ) [Fact p.Prime] [Fact ℓ.Prime] :
    letI := heckeModuleBar p
    IsReduced ↥(rationalHeckeAlgebra ℓ (JZero p)) := by

  letI := heckeModuleBar p
  have hp : p.Prime := Fact.out
  haveI : NeZero p := ⟨hp.ne_zero⟩

  let ψ : HeckeAlg →+* ↥(heckeLatticeAlgebra p ∅) := (latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)
  have hψ : Function.Surjective ψ :=
    (latticeRestrictHom_surjective p ∅).comp (RingHom.range_eq_top.mp (CuspForm.heckeEvalForms_range_eq_top p 2))
  have hker : RingHom.ker ψ ≤ RingHom.ker (rationalHeckeRep ℓ (JZero p)) := by
    intro t ht
    have h0 : heckeEvalBar (ModularCurve.heckeOperatorsCommuteBar p) t = 0 := by
      have := (ModularCurve.ker_heckeEvalForms_latticeRestrict_eq_ker_heckeEvalBar p
        (ModularCurve.heckeOperatorsCommuteBar p)).le ht
      exact RingHom.mem_ker.mp this
    have hJ : ∀ x : JZero p, t • x = 0 := fun x => by
      rw [heckeModuleBar_smul_def (ModularCurve.heckeOperatorsCommuteBar p), h0]
      rfl
    have hT : tateHeckeRep ℓ (JZero p) t = 0 := by
      refine LinearMap.ext fun x => Subtype.ext (funext fun n => ?_)
      rw [coe_tateHeckeRep_apply_apply, hJ]
      rfl
    rw [RingHom.mem_ker, rationalHeckeRep_apply, hT, LinearMap.baseChange_zero]

  let φ : ↥(heckeLatticeAlgebra p ∅) →+* Module.End ℚ_[ℓ] (RationalTateModule ℓ (JZero p)) :=
    ψ.liftOfSurjective hψ ⟨rationalHeckeRep ℓ (JZero p), hker⟩
  have hφ : ∀ t : HeckeAlg, φ (ψ t) = rationalHeckeRep ℓ (JZero p) t := fun t =>
    ψ.liftOfRightInverse_comp_apply _ _ ⟨rationalHeckeRep ℓ (JZero p), hker⟩ t

  let Φ : TensorProduct ℤ ℚ_[ℓ] ↥(heckeLatticeAlgebra p ∅) →ₐ[ℚ_[ℓ]] Module.End ℚ_[ℓ] (RationalTateModule ℓ (JZero p)) :=
    Algebra.TensorProduct.lift (Algebra.ofId ℚ_[ℓ] _) φ.toIntAlgHom
      (fun a s => Algebra.commutes a (φ.toIntAlgHom s))
  have hΦ : ∀ (a : ℚ_[ℓ]) (s : ↥(heckeLatticeAlgebra p ∅)), Φ (a ⊗ₜ s) = a • φ s := fun a s => by
    rw [Algebra.TensorProduct.lift_tmul, Algebra.ofId_apply, Algebra.smul_def]
    rfl

  have hrange : Φ.range = rationalHeckeAlgebra ℓ (JZero p) := by
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Subalgebra.zero_mem _
      | tmul a s =>
          obtain ⟨t, rfl⟩ := hψ s
          show Φ (a ⊗ₜ ψ t) ∈ _
          rw [hΦ, hφ]
          exact Subalgebra.smul_mem _ (rationalHeckeRep_mem_rationalHeckeAlgebra ℓ (JZero p) t) a
      | add x y hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    · refine Algebra.adjoin_le ?_
      rintro _ ⟨t, rfl⟩
      exact ⟨(1 : ℚ_[ℓ]) ⊗ₜ ψ t, by show Φ ((1 : ℚ_[ℓ]) ⊗ₜ ψ t) = _; rw [hΦ, hφ, one_smul]⟩

  haveI : IsReduced ↥(heckeLatticeAlgebra p ∅) := CuspForm.isReduced_heckeLatticeAlgebra p
  haveI : IsReduced (TensorProduct ℤ ℚ_[ℓ] ↥(heckeLatticeAlgebra p ∅)) := IsReduced.padic_tensorProduct_of_moduleFinite_int _ ℓ
  have hred : IsReduced ↥Φ.range := IsReduced.range_of_finiteDimensional Φ
  rw [hrange] at hred
  exact hred

end S_ModularCurve_isReduced_rationalHeckeAlgebra
