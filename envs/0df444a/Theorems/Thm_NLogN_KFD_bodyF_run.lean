      (child a b ys).length = vol (P :: L' :: hdShape A B Cs m N))
    (t : IState HS) (ht : NLogN.KIL.Inv G0 t) (R : List Item) (xs : List (ZMod 2))
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    IRuns I iprog (bodyF C tpl j0) (t.upd 0 (ints (enc2 xs) ++ R))
      (t.upd 0 (ints (enc2 (levelR C N P L' A B Cs child xs)) ++ R))
