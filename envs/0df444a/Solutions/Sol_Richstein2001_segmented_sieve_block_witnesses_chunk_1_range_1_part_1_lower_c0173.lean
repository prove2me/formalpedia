def SPM3 : ℕ := 

theorem SPM3_eq : mkSPM 5570 0 >>> 3 = SPM3 := by decide +kernel

theorem SPM3_bit (i : ℕ) (h : SPM3.testBit i = true) : (i + 3).Prime ∧ i + 3 ≤ 5569 := by
  rw [← SPM3_eq] at h
  rw [Nat.testBit_shiftRight] at h
  rcases mkSPM_bit 5570 0 (3 + i) h with h' | h'
  · simp at h'
  · rw [Nat.add_comm]
    exact spOK_prime _ h'

/-! ## Even-position masks -/

def ev : ℕ → ℕ
  | 0 => 1
  | j + 1 => let e := ev j; e ||| (e <<< 2 ^ (j + 1))

theorem ev_bit : ∀ j i : ℕ, i < 2 ^ (j + 1) → i % 2 = 0 → (ev j).testBit i = true := by
  intro j
  induction j with
  | zero =>
    intro i h1 h2
    have : i = 0 := by omega
    subst this
    rfl
  | succ j ih =>
    intro i h1 h2
    simp only [ev]
    rw [Nat.testBit_or, Nat.testBit_shiftLeft, Bool.or_eq_true]
    by_cases hi : i < 2 ^ (j + 1)
    · exact Or.inl (ih i hi h2)
    · right
      have hp : 2 ^ (j + 2) = 2 * 2 ^ (j + 1) := by ring
      have hev : 2 ^ (j + 1) % 2 = 0 := by
        rw [pow_succ]; simp
      simp only [Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨by omega, ih _ (by omega) (by omega)⟩

/-- the even positions `0, 2, ..., 32766` -/
def EV : ℕ := ev 14

/-- the even positions in `[lo, d)` (for `d ≤ 32768`) -/
def emask (d lo : ℕ) : ℕ := ((EV % 2 ^ d) >>> lo) <<< lo

theorem emask_bit (d lo i : ℕ) (hd : d ≤ 32768) (h1 : lo ≤ i) (h2 : i < d) (h3 : i % 2 = 0) :
    (emask d lo).testBit i = true := by
  unfold emask
  rw [Nat.testBit_shiftLeft, Nat.testBit_shiftRight, Nat.testBit_mod_two_pow]
  have hEV : EV.testBit i = true := by
    unfold EV
    exact ev_bit 14 i (by norm_num; omega) h3
  have : lo + (i - lo) = i := by omega
  rw [this, hEV]
  simp [h1, h2]

theorem land_bit (M E i : ℕ) (h : Nat.beq (Nat.land M E) E = true) (hE : E.testBit i = true) :
    M.testBit i = true := by
  have h' : M &&& E = E := Nat.eq_of_beq_eq_true h
  have := congrArg (fun x => x.testBit i) h'
  simp only [Nat.testBit_and, hE, Bool.and_true] at this
  exact this

/-! ## The coverage walk

`Cov n`: the even number `n` is `p + q` with `p` an odd prime `≤ 5569` and `q` prime.
State `(pos, M)`: every even `n ∈ [start, pos)` is covered, and bit `i` of `M` means `pos + i` is
covered. A record proves the prime `q = pos + d - 3`, checks that the even positions of `[pos, pos + d)`
at or above `start` are covered by `M`, and moves to `pos + d = q + 3`, adding `q + p` for all `p`. -/

def Cov (n : ℕ) : Prop := ∃ p : ℕ, p.Prime ∧ p ≤ 5569 ∧ p ≤ n ∧ (n - p).Prime

def Inv (start pos M : ℕ) : Prop :=
  (∀ n, start ≤ n → n < pos → n % 2 = 0 → Cov n) ∧ (∀ i, M.testBit i = true → Cov (pos + i)) ∧
    pos % 2 = 0

def stepOK (start pos M d q a R : ℕ) (ps : List (ℕ × ℕ)) : Bool :=
  Nat.ble 3 (Nat.add pos d) && Nat.ble d 32768 &&
    Nat.beq (Nat.land M (emask d (Nat.sub start pos))) (emask d (Nat.sub start pos)) &&
    Nat.beq (Nat.mod q 2) 1 && certOK q a R ps

theorem step_sound (start pos M d q a R : ℕ) (ps : List (ℕ × ℕ))
    (hq : q = Nat.sub (Nat.add pos d) 3)
    (h : stepOK start pos M d q a R ps = true) (hI : Inv start pos M) :
    Inv start (Nat.add pos d) (Nat.lor (Nat.shiftRight M d) SPM3) := by
  simp only [stepOK, Bool.and_eq_true] at h
  obtain ⟨⟨⟨⟨h3, hd⟩, hm⟩, hodd⟩, hc⟩ := h
  have h3' := Nat.le_of_ble_eq_true h3
  have hd' := Nat.le_of_ble_eq_true hd
  have hodd' : q % 2 = 1 := Nat.eq_of_beq_eq_true hodd
  have hqp : q.Prime := certOK_prime q a R ps hc
  have hq' : q = pos + d - 3 := hq
  obtain ⟨hI1, hI2, hI3⟩ := hI
  refine ⟨?_, ?_, ?_⟩
  · intro n hn1 hn2 hn3
    by_cases hn : n < pos
    · exact hI1 n hn1 hn hn3
    · have hb := emask_bit d (Nat.sub start pos) (n - pos) hd'
        (by show start - pos ≤ n - pos; omega) (by show n - pos < d; change n < pos + d at hn2; omega)
        (by omega)
      have := hI2 (n - pos) (land_bit M _ _ hm hb)
      have e : pos + (n - pos) = n := by omega
      rw [e] at this
      exact this
  · intro i hi
    have e1 : Nat.lor (Nat.shiftRight M d) SPM3 = (M >>> d) ||| SPM3 := rfl
    rw [e1, Nat.testBit_or, Bool.or_eq_true, Nat.testBit_shiftRight] at hi
    rcases hi with hi | hi
    · have := hI2 (d + i) hi
      have e : pos + (d + i) = Nat.add pos d + i := by show _ = pos + d + i; omega
      rw [e] at this
      exact this
    · obtain ⟨hp, hp5⟩ := SPM3_bit i hi
      refine ⟨i + 3, hp, hp5, ?_, ?_⟩
      · show i + 3 ≤ pos + d + i; omega
      · have e : Nat.add pos d + i - (i + 3) = q := by show pos + d + i - (i + 3) = q; omega
        rw [e]
        exact hqp
  · show (pos + d) % 2 = 0
    omega

def pairs : ℕ → ℕ → List (ℕ × ℕ)
  | 0, _ => []
  | k + 1, G => (Nat.land G 8388607, Nat.land (Nat.shiftRight G 23) 31) ::
      pairs k (Nat.shiftRight G 28)

/-- the walk over packed record groups (`G ≤ 1` ends a group; a record is `d` (14 bits), `a - 2`
(1 bit), `k` (2 bits), `R` (23 bits), then `k` pairs `(f, e)` of 23 + 5 bits); `f` is fuel -/
def seg (start pe Me : ℕ) : ℕ → ℕ → List ℕ → ℕ → Bool
  | pos, M, [], _ => Nat.beq pos pe && Nat.beq M Me
  | _, _, _ :: _, 0 => false
  | pos, M, G :: l, f + 1 =>
    cond (Nat.ble G 1) (seg start pe Me pos M l f)
      (stepOK start pos M (Nat.land G 16383) (Nat.sub (Nat.add pos (Nat.land G 16383)) 3)
          (Nat.add 2 (Nat.land (Nat.shiftRight G 14) 1)) (Nat.land (Nat.shiftRight G 17) 8388607)
          (pairs (Nat.land (Nat.shiftRight G 15) 3) (Nat.shiftRight G 40)) &&
        seg start pe Me (Nat.add pos (Nat.land G 16383))
          (Nat.lor (Nat.shiftRight M (Nat.land G 16383)) SPM3)
          (Nat.shiftRight (Nat.shiftRight G 40) (Nat.mul 28 (Nat.land (Nat.shiftRight G 15) 3)) :: l) f)

theorem seg_sound (start pe Me : ℕ) :
    ∀ (f pos M : ℕ) (l : List ℕ), seg start pe Me pos M l f = true → Inv start pos M →
      Inv start pe Me := by
  intro f
  induction f with
  | zero =>
    intro pos M l h hI
    cases l with
    | nil =>
      simp only [seg, Bool.and_eq_true] at h
      rw [← Nat.eq_of_beq_eq_true h.1, ← Nat.eq_of_beq_eq_true h.2]
      exact hI
    | cons G l => simp [seg] at h
  | succ f ih =>
    intro pos M l h hI
    cases l with
    | nil =>
      simp only [seg, Bool.and_eq_true] at h
      rw [← Nat.eq_of_beq_eq_true h.1, ← Nat.eq_of_beq_eq_true h.2]
      exact hI
    | cons G l =>
      simp only [seg] at h
      cases hG : Nat.ble G 1
      · rw [hG, cond_false, Bool.and_eq_true] at h
        exact ih _ _ _ h.2 (step_sound start pos M _ _ _ _ _ rfl h.1 hI)
      · rw [hG, cond_true] at h
        exact ih _ _ _ h hI

/-- the end check: the even positions of `[pos, end)` at or above `start` are covered by `M` -/
def finOK (start fin pos M : ℕ) : Bool :=
  Nat.ble pos fin && Nat.ble (Nat.sub fin pos) 32768 &&
    Nat.beq (Nat.land M (emask (Nat.sub fin pos) (Nat.sub start pos))) (emask (Nat.sub fin pos) (Nat.sub start pos))

theorem fin_sound (start fin pos M : ℕ) (h : finOK start fin pos M = true) (hI : Inv start pos M) :
    ∀ n, start ≤ n → n < fin → n % 2 = 0 → Cov n := by
  simp only [finOK, Bool.and_eq_true] at h
  obtain ⟨⟨h1, h2⟩, hm⟩ := h
  have h1' := Nat.le_of_ble_eq_true h1
  have h2' := Nat.le_of_ble_eq_true h2
  obtain ⟨hI1, hI2, hI3⟩ := hI
  intro n hn1 hn2 hn3
  by_cases hn : n < pos
  · exact hI1 n hn1 hn hn3
  · have hb := emask_bit (Nat.sub fin pos) (Nat.sub start pos) (n - pos) h2'
      (by show start - pos ≤ n - pos; omega) (by show n - pos < fin - pos; omega) (by omega)
    have := hI2 (n - pos) (land_bit M _ _ hm hb)
    have e : pos + (n - pos) = n := by omega
    rw [e] at this
    exact this

theorem inv_init (start pos : ℕ) (h : pos ≤ start) (h2 : pos % 2 = 0) : Inv start pos 0 :=
  ⟨fun n h1 h3 _ => by omega, fun i hi => by simp at hi, h2⟩

/-! ## From coverage to the block statement -/

theorem block_of_cov (X Y : ℕ)
    (hcov : ∀ n, X * 1000000 ≤ n → n < Y * 1000000 → n % 2 = 0 → Cov n)
    (b : Nat) (hb : b < 400000001) (hlo : X <= b) (hhi : b < Y) :
    forall (n : Nat), Membership.mem ((Finset.Icc (max 4 (b * 1000000))
      (min (4 * 10 ^ 14) ((b + 1) * 1000000 - 1))).filter (fun n => Even n)) n ->
      exists (p : Nat), Membership.mem ((Finset.Icc 2 5569).filter Nat.Prime) p /\
        exists (q : Nat), Membership.mem (GoldbachSieve.survivors (b * 1000000 - 5569)
          (min (4 * 10 ^ 14) ((b + 1) * 1000000 - 1)) 20000000) q /\
          n = p + q := by
  intro n hn
  have hn' : n ∈ (Finset.Icc (max 4 (b * 1000000))
      (min (4 * 10 ^ 14) ((b + 1) * 1000000 - 1))).filter (fun n => Even n) := hn
  rw [Finset.mem_filter, Finset.mem_Icc] at hn'
  obtain ⟨⟨h1, h2⟩, he⟩ := hn'
  have hb1 : b * 1000000 ≤ n := le_trans (le_max_right _ _) h1
  have hb2 : n ≤ (b + 1) * 1000000 - 1 := le_trans h2 (min_le_right _ _)
  have hn2 : n % 2 = 0 := Nat.even_iff.mp he
  have hX : X * 1000000 ≤ n := le_trans (Nat.mul_le_mul_right _ hlo) hb1
  have hY : n < Y * 1000000 := by
    have : (b + 1) * 1000000 ≤ Y * 1000000 := Nat.mul_le_mul_right _ hhi
    clear h1 h2 he hn hcov
    omega
  obtain ⟨p, hp, hp5, hpn, hq⟩ := hcov n hX hY hn2
  have hsum : n = p + (n - p) := by clear h1 h2 he hn hcov; omega
  have hlow : b * 1000000 - 5569 ≤ n - p := by clear h1 h2 he hn hcov; omega
  refine ⟨p, ?_, n - p, ?_, hsum⟩
  · show p ∈ (Finset.Icc 2 5569).filter Nat.Prime
    rw [Finset.mem_filter, Finset.mem_Icc]
    exact ⟨⟨hp.two_le, hp5⟩, hp⟩
  · show n - p ∈ GoldbachSieve.survivors (b * 1000000 - 5569)
      (min (4 * 10 ^ 14) ((b + 1) * 1000000 - 1)) 20000000
    unfold GoldbachSieve.survivors
    simp only [Finset.mem_filter, Finset.mem_Icc]
    refine ⟨⟨max_le hq.two_le hlow, le_trans (Nat.sub_le n p) h2⟩, ?_⟩
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff]
    intro r hr hrd
    rw [Finset.mem_filter] at hr
    exact hrd.2 ((Nat.prime_dvd_prime_iff_eq hr.2 hq).1 hrd.1)

