open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
theorem solution {U : Set (Pt 4)} (hU : IsOpen U) {f₁ f₂ : TwoForm 4}
    (hf₁ : ∀ i j, ContDiffOn ℝ ∞ (f₁ i j) U) (hf₂ : ∀ i j, ContDiffOn ℝ ∞ (f₂ i j) U) (c₁ c₂ : ℝ)
    {x : Pt 4} (hx : x ∈ U) (a b c : Fin 4) :
    linFaraday (lcomb c₁ f₁ c₂ f₂) a b c x = c₁ * linFaraday f₁ a b c x + c₂ * linFaraday f₂ a b c x := by
  have e : ∀ k i j, pd k (lcomb c₁ f₁ c₂ f₂ i j) x = c₁ * pd k (f₁ i j) x + c₂ * pd k (f₂ i j) x :=
    fun k i j => pd_lcomb hU (hf₁ i j) (hf₂ i j) c₁ c₂ hx k
  simp only [linFaraday, e]
  ring
