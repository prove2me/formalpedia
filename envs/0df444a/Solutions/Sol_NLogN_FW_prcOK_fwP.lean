    have e2 := length_ditZ F n j (2 * E) _ h2
    simp only [ditZ, List.length_append]
    rw [length_dcomX _ _ _ _ _ _ (by rw [e1, e2]), length_dcomY _ _ _ _ _ _ (by rw [e1, e2]), e1,
      pow_succ]
    ring

theorem canon_ditZ {F : ℤ} (hF : 0 < F) (n : ℕ) : ∀ (j E : ℕ) (B : List ℤ), Canon F B →
    Canon F (ditZ F n E j B)
  | 0, E, B, h => by simpa [ditZ] using h
  | j + 1, E, B, _ => by
    intro x hx
    simp only [ditZ, List.mem_append] at hx
    rcases hx with hx | hx
    · exact canon_dcomX hF n E 0 _ _ x hx
    · exact canon_dcomY hF n E 0 _ _ x hx

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem two_pow_add_div' (e E : ℕ) : sg ((2 : ℤ) ^ (e + E)) (2 ^ (e + E) / 2 ^ E) = 2 ^ e := by
  have h2 : (2 : ℕ) ^ (e + E) / 2 ^ E = 2 ^ e := by
    rw [pow_add]; exact Nat.mul_div_cancel _ (by positivity)
  have h3 : ¬ (2 : ℤ) ^ (e + E) < 0 := not_lt.mpr (by positivity)
  rw [h2]; unfold sg; rw [if_neg h3]; push_cast; rfl

theorem two_pow_add_mod' (e E : ℕ) : sg ((2 : ℤ) ^ (e + E)) (2 ^ (e + E) % 2 ^ E) = 0 := by
  have h2 : (2 : ℕ) ^ (e + E) % 2 ^ E = 0 := by rw [pow_add]; exact Nat.mul_mod_left _ _
  rw [h2]; exact sg_zero _

theorem ditStep_runs (s : IState NLogN.NS) (n e E : ℕ) (t b : ℤ) (c : ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (he : e + E ≤ n)
    (ht : 0 ≤ t ∧ t < 2 ^ n + 1) (hb : 0 ≤ b ∧ b < 2 ^ n + 1) (hc : zsz c ≤ n)
    (hV : s.G NLogN.V = .int t :: RV) (hX : s.G DX = .int b :: RX) (hW : s.G NLogN.W = .int (2 ^ (e + E)) :: LW)
    (hC : s.G CC = .int c :: LC) (hE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog ditStep s
      (((((((s.upd NLogN.V RV).upd DX RX).upd P1
        (.int ((t + -((b * 2 ^ (e + E)) % (2 ^ n + 1))) % (2 ^ n + 1)) :: s.G P1)).upd P2
        (.int ((t + (b * 2 ^ (e + E)) % (2 ^ n + 1)) % (2 ^ n + 1)) :: s.G P2)).upd NLogN.W
          (.int (2 ^ e) :: LW)).upd CC (.int (c + -1) :: LC)))
      (150000 * (n + 3)) := by
  have hp : (0 : ℤ) < 2 ^ n := by positivity
  have hp2 : (2 : ℤ) ^ (2 * n + 1) = 2 * 2 ^ n * 2 ^ n := by ring
  have hpn : (2 : ℤ) ≤ 2 ^ n := by
    calc (2 : ℤ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) hn
  have bt : zsz t ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  have bb : zsz b ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  set x := (b * 2 ^ (e + E)) % (2 ^ n + 1) with hxdef
  have hx0 : 0 ≤ x := Int.emod_nonneg _ (by omega)
  have hx1 : x < 2 ^ n + 1 := Int.emod_lt_of_pos _ (by omega)
  have bx : zsz x ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  have heE : zsz ((2 : ℤ) ^ (e + E)) ≤ n + 1 := by rw [NLogN.zsz_two_pow]; omega
  -- piece 1
  have h1 : IRuns I iprog (.seq (.op (.mv DX T4)) (.op (.shl T4 NLogN.W))) s
      ((s.upd DX RX).upd T4 (.int (b * 2 ^ (e + E)) :: s.G T4)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hX, hW]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s1 := (s.upd DX RX).upd T4 (.int (b * 2 ^ (e + E)) :: s.G T4) with hs1
  have h2 := fred_runs (I := I) (iprog := iprog) (X := T4) (by decide) (by decide) (by decide)
    (by decide) s1 (b * 2 ^ (e + E)) n (s.G T4) LN LF (by simp [s1])
    (by simp +decide [s1, hN]) (by simp +decide [s1, hF])
    (by
      have hev : (2 : ℤ) ^ (e + E) ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) he
      have he0 : (0 : ℤ) < 2 ^ (e + E) := by positivity
      have : |b * 2 ^ (e + E)| < 2 ^ (2 * n + 1) := by
        rw [abs_mul, abs_of_pos he0, hp2, abs_of_nonneg hb.1]
        nlinarith
      have : (((b * 2 ^ (e + E)).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by
        push_cast; exact this
      exact_mod_cast this)
  set s2 := s1.upd T4 (.int x :: s.G T4) with hs2
  -- piece 3
  have h3 : IRuns I iprog (.seq (.op (.dup T4 P1)) (.seq (.op (.neg P1)) (.seq (.op (.dup NLogN.V T3))
      (.op (.add T3 P1 P1))))) s2 (s2.upd P1 (.int (t + -x) :: s.G P1)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s2, s1, hV, zsz_neg]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s3 := s2.upd P1 (.int (t + -x) :: s.G P1) with hs3
  have h4 := fred_runs (I := I) (iprog := iprog) (X := P1) (by decide) (by decide) (by decide)
    (by decide) s3 (t + -x) n (s.G P1) LN LF (by simp [s3])
    (by simp +decide [s3, s2, s1, hN]) (by simp +decide [s3, s2, s1, hF])
    (by
      have : |t + -x| < 2 ^ (2 * n + 1) := by rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((t + -x).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s4 := s3.upd P1 (.int ((t + -x) % (2 ^ n + 1)) :: s.G P1) with hs4
  -- piece 5
  have h5 : IRuns I iprog (.seq (.op (.mv T4 P2)) (.seq (.op (.mv NLogN.V T3)) (.op (.add T3 P2 P2)))) s4
      (((s4.upd T4 (s.G T4)).upd NLogN.V RV).upd P2 (.int (t + x) :: s.G P2)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s4, s3, s2, s1, hV]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s5 := ((s4.upd T4 (s.G T4)).upd NLogN.V RV).upd P2 (.int (t + x) :: s.G P2) with hs5
  have h6 := fred_runs (I := I) (iprog := iprog) (X := P2) (by decide) (by decide) (by decide)
    (by decide) s5 (t + x) n (s.G P2) LN LF (by simp [s5])
    (by simp +decide [s5, s4, s3, s2, s1, hN]) (by simp +decide [s5, s4, s3, s2, s1, hF])
    (by
      have : |t + x| < 2 ^ (2 * n + 1) := by rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((t + x).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s6 := s5.upd P2 (.int ((t + x) % (2 ^ n + 1)) :: s.G P2) with hs6
  -- piece 7
  have h7g : ∀ s' : IState NLogN.NS, s'.G NLogN.W = .int (2 ^ (e + E)) :: LW → s'.G NLogN.DE = .int (2 ^ E) :: LE →
      s'.G CC = .int c :: LC →
      IRuns I iprog (.seq (.op (.split NLogN.W NLogN.DE T3)) (.seq (.op (.drop T3)) (decC CC))) s'
        ((s'.upd NLogN.W (.int (2 ^ e) :: LW)).upd CC (.int (c + -1) :: LC)) (2000 * (n + 3)) := by
    intro s' hW' hE' hC'
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, hW', hE', hC', zsz_neg_one,
      two_pow_add_div', two_pow_add_mod', zsz_zero]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  have h7 := h7g s6 (by simp +decide [s6, s5, s4, s3, s2, s1, hW])
    (by simp +decide [s6, s5, s4, s3, s2, s1, hE]) (by simp +decide [s6, s5, s4, s3, s2, s1, hC])
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq h5
    (IRuns.seq h6 h7)))))).mono' ?_ (by omega)
  simp only [hs6, hs5, hs4, hs3, hs2, hs1]
  clear * - hV hX
  ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))

theorem ditLoop_runs (s : IState NLogN.NS) (n E : ℕ) (lo hi : List ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (hlen : lo.length = hi.length)
    (hE : lo.length * E = n) (hcz : zsz (lo.length : ℤ) ≤ n)
    (hlo : Canon (2 ^ n + 1) lo) (hhi : Canon (2 ^ n + 1) hi)
    (hV : s.G NLogN.V = ints lo ++ RV) (hX : s.G DX = ints hi ++ RX) (hW : s.G NLogN.W = .int (2 ^ n) :: LW)
    (hC : s.G CC = .int lo.length :: LC) (hDE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) ditStep) s
      (((((((s.upd NLogN.V RV).upd DX RX).upd P1
        ((ints (dcomX (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G P1)).upd P2
        ((ints (dcomY (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G P2)).upd NLogN.W
          (.int 1 :: LW)).upd CC (.int 0 :: LC)))
      (lo.length * (150000 * (n + 3) + 30) + 30) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set L0 := lo.zip hi with hL0
  have hm1 : L0.map Prod.fst = lo := by simp [L0, List.map_fst_zip, hlen]
  have hm2 : L0.map Prod.snd = hi := by simp [L0, List.map_snd_zip, hlen]
  have hl0 : L0.length = lo.length := by simp [L0, hlen]
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → IState NS := fun D R =>
    ((((((s.upd NLogN.V (ints (R.map Prod.fst) ++ RV)).upd DX (ints (R.map Prod.snd) ++ RX)).upd P1
      ((ints (dcomX F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P1)).upd P2
      ((ints (dcomY F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P2)).upd NLogN.W
        (.int (2 ^ (n - D.length * E)) :: LW)).upd CC (.int (R.length : ℤ) :: LC))
  have h0 : St [] L0 = s := by
    apply IState.ext' <;> intros <;> simp [St, hm1, hm2, hV, hX, hW, hC, hl0, dcomX, dcomY] <;>
      split_ifs <;> simp_all
  have hk : St L0 [] = (((((((s.upd NLogN.V RV).upd DX RX).upd P1
        ((ints (dcomX F n E 0 lo hi)).reverse ++ s.G P1)).upd P2
        ((ints (dcomY F n E 0 lo hi)).reverse ++ s.G P2)).upd NLogN.W
          (.int 1 :: LW)).upd CC (.int 0 :: LC))) := by
    simp [St, hm1, hm2, hl0, hE]
  have := IRuns.loopList (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := ditStep) L0 St (150000 * (n + 3))
    (by intro D x R _; simp [St]; omega)
    (by simp [St])
    (by
      intro D x R hD
      have hmem : x ∈ L0 := by rw [← hD]; simp
      have hx1 : x.1 ∈ lo := by rw [← hm1]; exact List.mem_map_of_mem hmem
      have hx2 : x.2 ∈ hi := by rw [← hm2]; exact List.mem_map_of_mem hmem
      have hlD : D.length + 1 + R.length = lo.length := by
        rw [← hl0, ← hD]; simp; omega
      have hc : zsz ((R.length + 1 : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hcz
      have hDE1 : (D.length + 1) * E ≤ n := by rw [← hE]; exact Nat.mul_le_mul_right _ (by omega)
      have e7 : n - D.length * E = (n - (D.length + 1) * E) + E := by
        have : (D.length + 1) * E = D.length * E + E := by ring
        omega
      have hst := ditStep_runs (I := I) (iprog := iprog) (St D (x :: R)) n
        (n - (D.length + 1) * E) E x.1 x.2 ((R.length + 1 : ℕ) : ℤ) (ints (R.map Prod.fst) ++ RV)
        (ints (R.map Prod.snd) ++ RX) LW LC LE LN LF hn (by omega) (hlo _ hx1) (hhi _ hx2) hc
        (by simp +decide [St]) (by simp +decide [St]) (by simp +decide [St, e7])
        (by simp +decide [St]) (by simp +decide [St, hDE]) (by simp +decide [St, hN])
        (by simp +decide [St, hF, hFdef])
      refine hst.mono' ?_ le_rfl
      have e4 := dcomX_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      have e5 := dcomY_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      simp only [List.length_map, zero_add] at e4 e5
      rw [e7] at e4 e5
      simp only [St, List.map_append, List.map_cons, List.map_nil, e4, e5, List.length_append,
        List.length_singleton]
      apply IState.ext' <;> intros <;> simp [ints_append] <;> split_ifs <;> simp_all)
  rw [h0, hk, hl0] at this
  exact this

theorem dit_runs (pT : Fin P) (hP : iprog pT = ditBody pT) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (s : IState NLogN.NS) (B : List ℤ) (R LL LE LN LF : List Item) (E : ℕ),
      B.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) B →
      s.G DX = ints B ++ R → s.G DL = .int (2 ^ j) :: LL → s.G NLogN.DE = .int (2 ^ E) :: LE →
      s.G RN = .int (2 ^ n) :: LN → s.G RF = .int (2 ^ n + 1) :: LF →
      IRuns I iprog (.call pT) s (s.upd DX (ints (ditZ (2 ^ n + 1) n E j B) ++ R))
        (ditCost n j) := by
  intro j
  induction j with
  | zero =>
    intro s B R LL LE LN LF E hB _ _ hX hL _ _ _
    refine IRuns.mono (IRuns.call (c := 6030) ?_) (by simp only [ditCost]; omega)
    rw [hP]
    have h1 := difTest_runs (I := I) (iprog := iprog) s 1 LL 1 (by simpa using hL) (by simp [zsz_one])
    have h2 : IRuns I iprog (.ite CC (fun c => c == .zero) (.op (.drop CC))
        (.seq (.op (.drop CC)) (ditMain pT))) (s.upd CC (.int (1 + -1) :: s.G CC)) s 30 := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, zsz_zero]
    exact (IRuns.seq h1 h2).mono' (by simp [ditZ, hX]) (by omega)
  | succ j ih =>
    intro s B R LL LE LN LF E hB hjE hcB hX hL hDE hN hF
    have hjE' : 2 ^ j * E = n := by
      rcases hjE with h | h
      · omega
      · rw [pow_succ] at h; linarith
    obtain ⟨h, hh⟩ : ∃ h, h = 2 ^ j := ⟨_, rfl⟩
    have hB2 : B.length = 2 * h := by rw [hB, hh, pow_succ, mul_comm]
    rw [← hh] at hjE'
    have hE1 : 1 ≤ E := by
      rcases Nat.eq_zero_or_pos E with h0 | h0
      · rw [h0] at hjE'; omega
      · exact h0
    have hhn : h ≤ n := by nlinarith
    have hEn : E ≤ n := by
      rw [← hjE']; exact Nat.le_mul_of_pos_left _ (by rw [hh]; exact Nat.one_le_two_pow)
    have hjn : j + 1 ≤ n := by
      have : j < 2 ^ j := Nat.lt_two_pow_self
      omega
    have hh1 : 1 ≤ h := by rw [hh]; exact Nat.one_le_two_pow
    have e3 : ((h : ℕ) : ℤ) = 2 ^ j := by rw [hh]; push_cast; rfl
    have hF0 : (0 : ℤ) < 2 ^ n + 1 := by positivity
    set top := B.take h with htop
    set bot := B.drop h with hbot
    have hBlh : B = top ++ bot := (List.take_append_drop h B).symm
    have htopl : top.length = h := by rw [List.length_take, hB2]; omega
    have hbotl : bot.length = h := by rw [List.length_drop, hB2]; omega
    have hctop : Canon (2 ^ n + 1) top := fun a ha => hcB a (List.mem_of_mem_take ha)
    have hcbot : Canon (2 ^ n + 1) bot := fun a ha => hcB a (List.mem_of_mem_drop ha)
    have hzh : zsz (h : ℤ) ≤ n := le_trans (zsz_natCast_le_self h) hhn
    set dt := ditZ (2 ^ n + 1) n (2 * E) j top with hdt
    set db := ditZ (2 ^ n + 1) n (2 * E) j bot with hdb
    have hdtl : dt.length = h := by rw [hdt, length_ditZ _ _ j _ _ (by rw [htopl, hh]), hh]
    have hdbl : db.length = h := by rw [hdb, length_ditZ _ _ j _ _ (by rw [hbotl, hh]), hh]
    have hcdt : Canon (2 ^ n + 1) dt := canon_ditZ hF0 n j _ _ hctop
    have hcdb : Canon (2 ^ n + 1) db := canon_ditZ hF0 n j _ _ hcbot
    set X := dcomX (2 ^ n + 1) n E 0 dt db with hXd
    set Y := dcomY (2 ^ n + 1) n E 0 dt db with hYd
    have hXl : X.length = h := by rw [hXd, length_dcomX _ _ _ _ _ _ (by rw [hdtl, hdbl]), hdtl]
    have hYl : Y.length = h := by rw [hYd, length_dcomY _ _ _ _ _ _ (by rw [hdtl, hdbl]), hdtl]
    have hcX : Canon (2 ^ n + 1) X := canon_dcomX hF0 n E 0 dt db
    have hcY : Canon (2 ^ n + 1) Y := canon_dcomY hF0 n E 0 dt db
    -- test and branch
    have hz2 : zsz ((2 : ℤ) ^ (j + 1)) ≤ n + 1 := by rw [NLogN.zsz_two_pow]; omega
    have h1 := difTest_runs (I := I) (iprog := iprog) s (2 ^ (j + 1)) LL (n + 1) hL hz2
    have hne : (2 : ℤ) ^ (j + 1) + -1 ≠ 0 := by
      have : (2 : ℤ) ≤ 2 ^ (j + 1) := by
        calc (2 : ℤ) = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (j + 1) := pow_le_pow_right₀ (by norm_num) (by omega)
      linarith
    -- segment A
    set s1 := s.upd HH (.int (h : ℤ) :: s.G HH) with hs1
    have hA' : IRuns I iprog (.seq (.op (.drop CC)) difSegA)
        (s.upd CC (.int (2 ^ (j + 1) + -1) :: s.G CC)) s1 (10000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
