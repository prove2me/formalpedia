/-!
# Segmented inverse (S2), machine side 8: one real line of `segInvS` by list kernels

The real part of the segmented inverse on one line, as the machine computes it, on a padded
line `x` of `N = n_c λ` positions (`s ≤ N`):

1. `Y = applyL x`: the chunk kernel on each `λ`-chunk (`M⁻¹`);
2. the values of `Y` on the line `L = Jlist B`, the two capacitance kernels (`jsolve_eq`);
3. the coupling window kernel on the cyclic extension (`couple_window`), scattered back to the
   positions (zero off `L`);
4. `Y₂ = applyL` of the scattered coupling; the output is `Y - Y₂`.

**`segLineC_eq`**: entry `u < N` of the result is `segInvS … u` for `u < s` and `0` beyond.
-/

open Finset

namespace J6Seg

section lens
variable (P : ℕ)

lemma length_blkL {di gi gam dd am ap y : List ℤ} (h1 : y.length ≤ di.length)
    (h2 : y.length ≤ gi.length) (h3 : y.length ≤ gam.length) (h4 : y.length ≤ dd.length) :
    (blkL P di gi gam dd am ap y).length = y.length := by
  simp only [blkL, dgL, upL, lwL, List.length_zipWith, List.length_reverse, List.length_map,
    length_convL]
  omega

lemma length_chunkL {di gi gam dd : List ℤ} {lam : ℕ} (h1 : di.length = lam) (h2 : gi.length = lam)
    (h3 : gam.length = lam) (h4 : dd.length = lam) :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)) (x : List ℤ), (∀ d ∈ ds, d.1 ≤ lam) →
      (chunkL P di gi gam dd ds x).length = x.length
  | [], x, _ => by simp [chunkL]
  | (n, am, ap) :: ds, x, hds => by
    simp only [chunkL, List.length_append]
    have hn := hds (n, am, ap) (List.mem_cons_self ..)
    rw [length_blkL P (by simp; omega) (by simp; omega) (by simp; omega) (by simp; omega),
      length_chunkL h1 h2 h3 h4 ds _ (fun d hd => hds d (List.mem_cons_of_mem _ hd))]
    simp only [List.length_take, List.length_drop]
    omega

lemma blFrom_snd (s t lam e : ℕ) : ∀ (f st : ℕ), ∀ b ∈ blFrom s t lam e f st,
    b.2 = 1 + enF s t lam b.1
  | 0, _, b, hb => by simp [blFrom] at hb
  | f + 1, st, b, hb => by
    simp only [blFrom] at hb
    split_ifs at hb with h
    · rcases List.mem_cons.1 hb with he | he
      · rw [he]
      · exact blFrom_snd s t lam e f _ b he
    · simp at hb

lemma length_chunkK {R s t lam α : ℕ} (hl : 1 ≤ lam) (c : ℕ) (x : List ℤ) :
    (chunkK P R s t lam α c x).length = x.length := by
  unfold chunkK
  refine length_chunkL P (lam := lam) (by simp [diL]) (by simp [giL]) (by simp [gamL]) (by simp [ddL]) _ _ ?_
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  rw [blFrom_snd s t lam _ _ _ b hb]
  have := en_le_lam (s := s) (t := t) hl b.1
  omega

end lens

