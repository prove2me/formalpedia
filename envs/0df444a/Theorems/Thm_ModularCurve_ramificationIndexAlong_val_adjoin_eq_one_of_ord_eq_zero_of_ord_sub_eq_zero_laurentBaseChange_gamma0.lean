theorem ModularCurve.ramificationIndexAlong_val_adjoin_eq_one_of_ord_eq_zero_of_ord_sub_eq_zero_laurentBaseChange_gamma0
    (M' : ℕ) [NeZero M']
    (L : Type) [Field L] [CharZero L] [Algebra.IsAlgebraic ℚ L]
    (K₀ : IntermediateField L (LaurentSeries L))
    (hK₀ : K₀ = ModularCurve.laurentBaseChange L (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma0 M')))
    (j₀ : ↥K₀) (hj₀ : ((j₀ : LaurentSeries L)) = ModularCurve.coeffEmb L ModularCurve.jq)
    (w : AlgebraicCurve.Place L ↥K₀) (hw0 : w.ord j₀ = 0) (hw1728 : w.ord (j₀ - 1728) = 0) :
    AlgebraicCurve.Place.ramificationIndexAlong (IntermediateField.adjoin L ({j₀} : Set ↥K₀)).val w = 1 := by sorry
