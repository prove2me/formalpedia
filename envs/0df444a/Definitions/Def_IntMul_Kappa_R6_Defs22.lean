section
-- Source module: Solutions.R6IL3Steps
/-!
# Round six, item language (I3): the local steps of a node

A node on `E` bits (`F = E / m`) acts on `W + T` role streams of `nN (B/W) t S₀` records, bits
`Fin m × Fin F` at the positions `IL3F.posR m K e F`, strides `stH`.  Parametric copies of the
frozen `KFWStep1/2/3/5` step lemmas (`P8Lift.Wc → W + T`, `mC → m`, `mC^k → F`):

* `stepH_gate` (atoms), `stepH_perm` (role permutation), `stepH_phase` (with `epsOK_tabM`,
  the `m`-generic `epsOK_tab`), `stepH_fixG` (a `±1` role diagonal as phase steps),
  `stepH_row` (from `RowUCG`, a row interface with a general coefficient `aK K`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-- The strides of a node. -/
def stH (m K e F S0 : ℕ) : Fin m × Fin F → ℕ := fun p => 2 ^ IL3F.posR m K e F p * S0

section Steps

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem NodeRH.cl (hN : NodeRH c σ K t S0 r H E e B) : SClean σ := sclean_of_lt hN.lev.lt

theorem NodeRH.zero (hN : NodeRH c σ K t S0 r H E e B) : σ 0 = none := hN.lev.off 0 (by decide)

/-- The overhead of a uniform gate. -/
def xGateH (W' : ℕ) (as : List KFG.Atom) (Z : ℕ) : ℕ :=
  as.length * Xp Z + (levOf W' as).length * Xp Z

/-- The cost of a phase step, as a function of the step. -/
def phCostFH (W' m Z Bn t S0 r F : ℕ) : RStep (Fin W') m → ℕ → ℕ
  | .phase _ k0 k1 a => cWrapQ W' (nN Bn t S0 * r) Z 0 0
      (cPhStep Z (((k0 + k1 * F) % 4 : ℕ) : ℤ) (εTab vE vK vF wF (List.ofFn a)) Bn t S0 r)
  | _ => fun _ => 0

/-! ## The row-addition step -/

/-- The row-parameter values. -/
noncomputable def rowValsLH (K t S0 r H F e Bn G : ℕ) (i j : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(36, .reg wF, ((F : ℕ) : ℤ)), (37, .reg vK, (K : ℤ)), (38, .reg vE, (e : ℤ)),
    (39, .reg vT, (t : ℤ)), (40, .reg vS, (S0 : ℤ)), (41, .reg wB, (Bn : ℤ)),
    (42, .reg vR, (r : ℤ)), (43, .reg vH, (H : ℤ)), (44, .lit (i : ℤ), (i : ℤ)),
    (45, .lit (j : ℤ), (j : ℤ)), (46, .reg vG, (G : ℤ)), (47, .lit 1, 1), (48, .lit 1, 1)]

/-- The registers of a compact-controls row addition: the ten `rowσ` registers and
`46 = G`, `47 = Bf = 1`, `48 = Sb = 1`. -/
def rowσC (m F K e t S0 B r H G : ℕ) (i j : Fin m) : Fin HS → Option ℤ := fun x =>
  if x.val = 46 then some (G : ℤ) else if x.val = 47 ∨ x.val = 48 then some 1
  else IL3F.rowσ m F K e t S0 B r H i j x

/-- The background holds the compact-controls row parameters. -/
def rowQC (m F K e t S0 B r H G : ℕ) (i j : Fin m) (s : IState HS) : Prop :=
  Agree (rowσC m F K e t S0 B r H G i j) s

/-- **Uniform compact-controls row additions with a general coefficient**, field width `G`
(`Bf = Sb = 1`): `IL3F.RowUCF` with the precondition `rowQC` (registers `46 … 48`), the field
hypotheses `2^{2(F-1)G} ∣ B`, `2^{(F-1)G} ∣ S₀`, the guards `4 Z (Z+2) ≤ 2^G`,
`16 Z (Z+2) 2^G ≤ 2^K` in place of `80 Z (Z+2) ≤ 2^K`, and the factor `aK K`. -/
def RowUCG {Pp : ℕ} (m : ℕ) (τ : ℝ) (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp)
    (rowC : IStmt HS Pp) (aK : ℕ → ℝ) (G : ℕ) : Prop :=
  ∀ (F K e t S0 B r Z H : ℕ) (i j : Fin m), i ≠ j → 6 ≤ K → 1 ≤ r →
    4 * Z * (Z + 2) ≤ 2 ^ G → 16 * Z * (Z + 2) * 2 ^ G ≤ 2 ^ K →
    1 ≤ S0 → 1 ≤ B → 1 ≤ F → K * ((F * m) - 1) ≤ e → e - e % K + K ≤ t →
    2 ^ (2 * ((F - 1) * G)) ∣ B → 2 ^ ((F - 1) * G) ∣ S0 →
    zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z →
    ∃ cost : ℕ → ℕ,
      SImplQ Isym tbl (rowQC m F K e t S0 B r H G i j) 0 H r
        (fun p => 2 ^ IL3F.posR m K e F p * S0)
        (B * 2 ^ t * S0) (Pm i j : Butterfly.Op (Fin m × Fin (F))) rowC 0 0 cost ∧
      ∀ w, w ≤ H → (cost w : ℝ) ≤ aK K * ((B * 2 ^ t * S0 : ℕ) : ℝ) *
        ((r : ℝ) * (H + 1) * ((F : ℝ) + 1) ^ τ + (KFR.PsiR r Z H : ℝ))

/-- **The compact-controls row interface** (`RowUCF'` of `jain6/compact/DESIGN.md` with
`Bf = Sb = 1`): for every field width `G ≥ 1`, a `RowUCG` with the factor `Kc (G + 2) + 1`. -/
def RowUCC {Pp : ℕ} (m : ℕ) (τ : ℝ) (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp)
    (rowC : IStmt HS Pp) (Kc : ℝ) : Prop :=
  ∀ G : ℕ, 1 ≤ G → RowUCG m τ Isym tbl rowC (fun _ => Kc * (G + 2) + 1) G

end Steps

end IntMul.Kappa.R6.IL3H

end

