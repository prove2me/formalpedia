theorem upd_inv (i : ℕ) (x : ℕ → ℕ) : updInv s μ i (IntMul.OpenAI.RCRT.upd s μ i x) = x := by
  unfold IntMul.OpenAI.RCRT.upd
  split_ifs with h
  · have hs : 0 < s i := lt_of_le_of_lt (Nat.zero_le _) (h i le_rfl)
    have hv : (x i + IntMul.OpenAI.RCRT.offset s μ x i) % s i < s i := Nat.mod_lt _ hs
    unfold updInv
    rw [if_pos (valid_update s x i _ h hv), offset_update]
    simp only [Function.update_self, Function.update_idem]
    rw [mod_sub_cancel _ _ _ (h i le_rfl)]
