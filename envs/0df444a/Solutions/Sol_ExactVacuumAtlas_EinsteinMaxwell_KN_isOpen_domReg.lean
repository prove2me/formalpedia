open Real
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.KN
open ExactVacuumAtlas.Kerr.In (Ui Wi)
theorem solution (M a Q : ℝ) : IsOpen (domReg M a Q) := by
  have h1 : Continuous fun x : Pt 4 => Sig a (x 1) (x 2) := by unfold Sig; fun_prop
  have h2 : Continuous fun x : Pt 4 => Del M a Q (x 1) := by unfold Del; fun_prop
  have h3 : Continuous fun x : Pt 4 => sin (x 2) := by fun_prop
  have e : domReg M a Q = ((fun x : Pt 4 => Sig a (x 1) (x 2)) ⁻¹' {0}ᶜ ∩
      (fun x : Pt 4 => Del M a Q (x 1)) ⁻¹' {0}ᶜ) ∩ (fun x : Pt 4 => sin (x 2)) ⁻¹' {0}ᶜ := by
    ext x; simp [domReg, and_assoc]
  rw [e]
  exact ((isOpen_compl_singleton.preimage h1).inter (isOpen_compl_singleton.preimage h2)).inter
    (isOpen_compl_singleton.preimage h3)
