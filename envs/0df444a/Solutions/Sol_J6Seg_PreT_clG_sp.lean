section
-- Source module: Solutions.J6SegILPre1
/-!
# B-line IL, pre-tables (B5), part 1: magnitude bounds for register expressions

`mg V e`: a crude magnitude bound of the expression `e` when every register `i` it reads holds a
value of absolute value `≤ V i`. It dominates every subterm, so `mg V e < 2^B` gives `e.Bnd s B`
(`bnd_of_mg`): the cost bounds of all pushes/assignments of the pre-table programs reduce to one
numeric inequality per expression.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL

theorem zsz_of_le {z : ℤ} {M B : ℕ} (h : |z| ≤ M) (hM : M < 2 ^ B) : zsz z ≤ B :=
  zsz_le_of_abs (lt_of_le_of_lt h (by exact_mod_cast hM))

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre2
/-!
# B-line IL, pre-tables (B5), part 2: the register file and the basic steps

The pre-table programs keep their values in the registers `rg` (one integer each) and write
their outputs onto stacks outside `rg`. The managed state is `RF v c`: register `j ∈ rg` holds
`[v j]`, every other stack `j` holds `c j`.

* congruence of expressions: `eval`, `ok`, `cost`, `Bnd` only see the tops of the registers read;
* `spA` (assignment to a register of `rg`), `spU` (push onto a stack outside `rg`), `spO` (pop);
* `enC d eN eK eJ` / `epC d eN eK eJ eS`: `v d := expNeg n k j` / `expPos n k j σ` through the
  library programs `expNegP` / `expPosP` (inputs on `16, 17, 18, 27`, output on `19`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

/-! ## Congruence -/

/-! ## The register file -/

theorem top_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (encK s (RF v c)).top j = v j := top_encK (RF_in h)

theorem isInt_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (encK s (RF v c)).IsInt j := isInt_encK (RF_in h)

theorem RF_bnd {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} {V : Fin HS → ℕ}
    (he : InRg e) (hv : ∀ i ∈ e.regs, |v i| ≤ V i) : ∀ i ∈ e.regs, |(encK s (RF v c)).top i| ≤ V i :=
  fun i hi => by rw [top_RF (he i hi)]; exact hv i hi

/-- Clean for expressions reading only `rg`. -/
theorem clean_of_inRg {e : Ex HS} (he : InRg e) : e.Clean := by
  intro i hi
  have h := he i hi
  simp only [rg, List.mem_cons, List.not_mem_nil, or_false] at h
  simp only [zX_all, List.mem_cons, List.not_mem_nil, or_false]
  rcases h with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
    (subst h; decide)

/-! ## Basic steps -/

/-- Assignment to a register of `rg`. -/
theorem spA (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {i : Fin HS} (hi : i ∈ rg)
    {e : Ex HS} (he : InRg e) (hok : e.ok (encK s (RF v c))) {V : Fin HS → ℕ} {B : ℕ}
    (hv : ∀ j ∈ e.regs, |v j| ≤ V j) (hvi : |v i| ≤ V i) (hm : mg V e < 2 ^ B) (hVB : V i < 2 ^ B) :
    Sp (.asg i e) (encK s (RF v c)) (encK s (RF (Function.update v i (e.eval (encK s (RF v c)))) c))
      (cE e B) := by
  have hi5 : i.val < 56 := by
    simp only [rg, List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
      (subst h; decide)
  refine ⟨⟨hi5, clean_of_inRg he, hok, isInt_RF hi⟩, ?_, ?_⟩
  · simp only [run]
    have : (encK s (RF v c)).G i = ints [v i] ++ s.G i := by simp [RF_in hi]
    rw [this, ← upd_RF_in hi, ← encK_upd]; simp [ints]
  · have := asgCost_le i e (encK s (RF v c)) B (bnd_of_mg _ V B e (RF_bnd he hv) hm)
      (by rw [top_RF hi]; exact zsz_of_le hvi hVB)
    exact this

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre3
/-!
# B-line IL, pre-tables (B5), part 3: calls of the library number programs

`callC d e16 e17 e18 e27 prog`: push the four inputs on `16, 17, 18, 27`, run `prog` (which pushes
its result on `19` and leaves everything else), move the result into register `d ∈ rg`, pop.
`callC_sp`: generic; `enC_sp` / `epC_sp`: `v d := expNeg n k j` / `expPos n k j σ`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem zsz_eval {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} {V : Fin HS → ℕ} {B : ℕ}
    (he : InRg e) (hv : ∀ j ∈ e.regs, |v j| ≤ V j) (hm : mg V e < 2 ^ B) :
    zsz (e.eval (encK s (RF v c))) ≤ B :=
  zsz_of_le (eval_le_mg _ V e (RF_bnd he hv)) hm

theorem expNeg_prog (n k j : ℕ) : ∀ (t : IState HS) (L16 L17 L18 L27 : List Item),
    t.G 16 = .int n :: L16 → t.G 17 = .int k :: L17 → t.G 18 = .int j :: L18 →
    t.G 27 = .int (0 : ℕ) :: L27 →
    expNegP.ok t ∧ expNegP.run t = t.upd 19 (.int (expNeg n k j) :: t.G 19) ∧
      expNegP.cost t ≤ expNegCost n (zsz (k : ℤ)) (zsz (j : ℤ)) := by
  intro t L16 L17 L18 L27 g16 g17 g18 _
  obtain ⟨h1, h2⟩ := expNegP_spec n k j t L16 L17 L18 g16 g17 g18
  exact ⟨h1, h2, expNegP_cost n k j t L16 L17 L18 g16 g17 g18⟩

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre4
/-!
# B-line IL, pre-tables (B5), part 4: polynomial expressions and the push loop

* `Poly e`: no `pow2`/`shl`, literals of absolute value `≤ 4`; `dg e` its degree;
  `mg_le_dg`: with every register value `≤ 2^A` (`A ≥ 2`), `mg e ≤ 2^(A·dg e)`. Every expression of
  the pre-table loops is polynomial (the powers `2^P`, `2^{P+1}` sit in registers `9`, `10`), so
  all cost conditions reduce to `dg e ≤ D` (by `decide`) and one uniform width `B = A·D + 1`.
* `pushLoop`: a counted loop whose body pushes `f k` onto `O` leaves `rv f N ++ O`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

theorem pow_le_pow' {A a b : ℕ} (h : a ≤ b) : 2 ^ (A * a) ≤ 2 ^ (A * b) :=
  Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ h)

/-- The uniform width: `dg e ≤ D` gives `mg e < 2^(A·D + 1)`. -/
theorem mg_lt {V : Fin HS → ℕ} {A D : ℕ} (hV : ∀ j, V j ≤ 2 ^ A) (hA : 2 ≤ A) {e : Ex HS}
    (hp : Poly e = true) (hd : dg e ≤ D) : mg V e < 2 ^ (A * D + 1) := by
  have h1 := (mg_le_dg hV hA e hp).trans (pow_le_pow' hd)
  have : 2 ^ (A * D) < 2 ^ (A * D + 1) := Nat.pow_lt_pow_right (by norm_num) (by omega)
  omega

/-! ## The push loop -/

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre5
/-!
# B-line IL, pre-tables (B5), part 5: the fixed-point expressions

Register conventions (all in `rg`): `20 = P`, `21 = R`, `22 = s`, `23 = t`, `24 = λ`, `25 = α`,
`9 = 2^P`, `10 = 2^{P+1}`; `1 = c` (block start), `2 = n` (block length); work `4 = Γ`, `5 = ±1`,
`11 = X`, `12 = U` (loop index).

* `fmE x y` evaluates to `fmul P x y`, `fdE x y` to `fdiv P x y`;
* `jDE` (`α²(t-s)U²`), `jQE` (`2α²t(U+1)`), `jME`/`jPE` (`α²(t ∓ 2β_c)⁺U`) the exponent arguments
  of the tables of `mkTables` (`J6SegTab`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## Evaluation -/

theorem ev_reg {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {j : Fin HS} (h : j ∈ rg) :
    (Ex.reg j).eval (encK s (RF v c)) = v j := top_RF h

theorem mx0_eval (t : IState HS) (x : Ex HS) : (mx0 x).eval t = max (x.eval t) 0 := by
  simp only [mx0, Ex.eval]; split_ifs with h
  · rw [max_eq_right h.le]
  · rw [max_eq_left (by omega)]

section ev
variable {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {P : ℕ}

theorem fmE_eval (h9 : v 9 = 2 ^ P) (h10 : v 10 = 2 ^ (P + 1)) (x y : Ex HS) :
    (fmE x y).eval (encK s (RF v c)) =
      J6Seg.fmul P (x.eval (encK s (RF v c))) (y.eval (encK s (RF v c))) := by
  simp only [fmE, NLogN.Ex.ediv_eval, Ex.eval, top_RF (show (9 : Fin HS) ∈ rg by decide),
    top_RF (show (10 : Fin HS) ∈ rg by decide), h9, h10, J6Seg.fmul, J6Seg.rs, J6Seg.rq, pow_succ]
  ring_nf

theorem jQE_eval {tN aN u : ℕ} (h23 : v 23 = tN) (h25 : v 25 = aN) (h12 : v 12 = u) :
    jQE.eval (encK s (RF v c)) = ((2 * aN ^ 2 * tN * (u + 1) : ℕ) : ℤ) := by
  simp only [jQE, Ex.eval, top_RF (show (23 : Fin HS) ∈ rg by decide),
    top_RF (show (25 : Fin HS) ∈ rg by decide), top_RF (show (12 : Fin HS) ∈ rg by decide),
    h23, h25, h12]
  push_cast; ring

end ev

/-! ## Side conditions -/

/-- `ok` on the register file for expressions reading `rg` only. -/
theorem ok_RF {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} (he : InRg e)
    (hs : Safe e = true) : e.ok (encK s (RF v c)) := by
  -- only the registers of `e` matter
  have : ∀ e : Ex HS, InRg e → Safe e = true → e.ok (encK s (RF v c)) := by
    intro e
    induction e with
    | reg j => intro h _; exact isInt_RF (h j (by simp [Ex.regs]))
    | lit _ => intro _ _; trivial
    | add a b iha ihb | mul a b iha ihb =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      exact ⟨iha (fun i hi => h i (by simp [Ex.regs, hi])) hs.1,
        ihb (fun i hi => h i (by simp [Ex.regs, hi])) hs.2⟩
    | neg a ih => intro h hs; exact ih (fun i hi => h i (by simpa [Ex.regs] using hi)) hs
    | sel c x y ihc ihx ihy =>
      intro h hs
      simp only [Safe, Bool.and_eq_true] at hs
      refine ⟨ihc (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.1, ?_⟩
      split_ifs
      · exact ihx (fun i hi => h i (by simp [Ex.regs, hi])) hs.1.2
      · exact ihy (fun i hi => h i (by simp [Ex.regs, hi])) hs.2
    | _ => intro _ hs; simp [Safe] at hs
  exact this e he hs

theorem ok_ediv {t : IState HS} {a b : Ex HS} (ha : a.ok t) (hb : b.ok t) :
    (NLogN.Ex.ediv a b).ok t := NLogN.Ex.ediv_ok ha hb

end J6Seg.PreT

