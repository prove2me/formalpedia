theorem posL_lt {K D ρ : ℕ} (hρ : ρ < K) (i : Fin D) : posL K D ρ i < K * D := by
  have hi := i.isLt
  unfold posL
  have : K * (D - 1 - i) + K ≤ K * D := by
    rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
  omega

theorem stT_posL {K D S ρ : ℕ} (i : Fin D) : KFH.stT K D S ρ i = 2 ^ posL K D ρ i * S := by
  simp only [posL, KFH.stT]
  rw [KFH.stS_eq K D S _ i.isLt, ← pow_mul, pow_add]
  have : D - (i + 1) = D - 1 - i := by omega
  rw [this]; ring

theorem vol_layer_eq (P K D S : ℕ) : vol (Butterfly.layerShape P K D S) = P * 2 ^ (K * D) * S := by
  rw [KFH.vol_layer, pow_mul]

theorem SD_eq_diag {D : ℕ} :
    (SD : Matrix (Fin D → Fin 2) (Fin D → Fin 2) ℂ) =
      Matrix.diagonal fun x => I ^ (0 + ∑ i, (fun _ : Fin D => 1) i * (x i).val) := by
  simp [SD, wt]

