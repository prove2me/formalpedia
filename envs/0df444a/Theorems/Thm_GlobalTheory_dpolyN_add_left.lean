variable {R : Type} [CommRing R] {d n : ℕ}
variable {ι : Type} [Fintype ι]

theorem GlobalTheory.dpolyN_add_left (F : Fin d → PS R 2 d) (cp : ι → Fin n) (u : ι → Fin d → R)
    (P Q : MvPolynomial ι R) (f : PS R n d) :
    DpolyN F cp u (P + Q) f = DpolyN F cp u P f + DpolyN F cp u Q f := by sorry
