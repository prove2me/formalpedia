open Structured
lemma eval_code (s : Data) : Eval code s 11 (result s) :=
  Eval.seq (eval_sequence_atoms addressAtoms s) (eval_sequence_atoms loadAtoms _)
lemma address_values (s : Data) (h2 : s.natReg 14 = 2) :
    (addressed s).natReg 568 = s.natReg 568 ∧
    (addressed s).natReg 574 = s.natReg 568+2 ∧
    (addressed s).natReg 576 = s.natReg 568+4 ∧
    (addressed s).natReg 578 = s.natReg 568+6 ∧
    (addressed s).natReg 580 = s.natReg 568+8 := by
  simp only [addressed,addressAtoms,List.foldl_cons,List.foldl_nil]
  simp (disch := decide) [Atom.nat_read,primitiveNatRead,h2]
lemma values (s : Data) (h2 : s.natReg 14 = 2) :
    (result s).realReg 600 = s.realMem (s.natReg 568) ∧
    (result s).realReg 602 = s.realMem (s.natReg 568+2) ∧
    (result s).realReg 604 = s.realMem (s.natReg 568+4) ∧
    (result s).realReg 606 = s.realMem (s.natReg 568+8) ∧
    (result s).natReg 626 = s.natMem (s.natReg 568+4) ∧
    (result s).natReg 628 = s.natMem (s.natReg 568+6) ∧
    (result s).natReg 648 = s.natMem (s.natReg 568+8) := by
  obtain ⟨h0,h1,h2',h3,h4⟩ := address_values s h2
  simp only [result,loaded,loadAtoms,List.foldl_cons,List.foldl_nil]
  simp (disch := decide) [Atom.real_read,Atom.nat_read,primitiveRealRead,primitiveNatRead]
  simp only [h0,h1,h2',h3,h4]
  simp [addressed,addressAtoms,Atom.effect,instructionEffect,data,Data.machine]
