  have hJ'A : JA = Ideal.map ((eT : A ⊗[Z₀] Pz.B₀ ≃ₐ[A] PA.B₀).toRingEquiv : A ⊗[Z₀] Pz.B₀ →+* PA.B₀) (RingHom.ker π ⊔ Ideal.span {g}) := by
