private theorem mFourierCoeff_zero (f : UnitAddTorus ι → ℂ) : UnitAddTorus.mFourierCoeff f 0 = ∫ θ, f θ ∂(torusMeasure ι) := by
  unfold UnitAddTorus.mFourierCoeff
