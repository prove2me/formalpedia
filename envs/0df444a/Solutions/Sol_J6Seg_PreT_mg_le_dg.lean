/-!
# B-line IL, pre-tables (B5), part 4: polynomial expressions and the push loop

* `Poly e`: no `pow2`/`shl`, literals of absolute value `≤ 4`; `dg e` its degree;
  `mg_le_dg`: with every register value `≤ 2^A` (`A ≥ 2`), `mg e ≤ 2^(A·dg e)`. Every expression of
  the pre-table loops is polynomial (the powers `2^P`, `2^{P+1}` sit in registers `9`, `10`), so
  all cost conditions reduce to `dg e ≤ D` (by `decide`) and one uniform width `B = A·D + 1`.
* `pushLoop`: a counted loop whose body pushes `f k` onto `O` leaves `rv f N ++ O`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS

theorem pow_le_pow' {A a b : ℕ} (h : a ≤ b) : 2 ^ (A * a) ≤ 2 ^ (A * b) :=
  Nat.pow_le_pow_right (by norm_num) (Nat.mul_le_mul_left _ h)

theorem two_le_pow {A d : ℕ} (hA : 2 ≤ A) (hd : 1 ≤ d) : 4 ≤ 2 ^ (A * d) := by
  have : 2 ≤ A * d := le_trans hA (Nat.le_mul_of_pos_right _ hd)
  calc 4 = 2 ^ 2 := by norm_num
    _ ≤ _ := Nat.pow_le_pow_right (by norm_num) this

theorem dg_pos : ∀ e : Ex HS, 1 ≤ dg e
  | .reg _ | .lit _ => le_rfl
  | .add a b | .ndiv a b | .nmod a b | .quo a b | .rem a b => by simp only [dg]; omega
  | .mul a b | .shl a b => by simp only [dg]; omega
  | .neg a | .pow2 a => by simp only [dg]; exact dg_pos a
  | .sel c x y => by simp only [dg]; omega

/-- **Magnitudes of polynomial expressions.** -/
theorem mg_le_dg_sol_aux {V : Fin HS → ℕ} {A : ℕ} (hV : ∀ j, V j ≤ 2 ^ A) (hA : 2 ≤ A) :
    ∀ e : Ex HS, Poly e = true → mg V e ≤ 2 ^ (A * dg e)
  | .reg i, _ => by simp only [mg, dg, mul_one]; exact hV i
  | .lit c, h => by
    simp only [Poly, decide_eq_true_eq] at h
    simp only [mg, dg, mul_one]
    have : 4 ≤ 2 ^ A := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hA
    omega
  | .neg a, h => by simp only [Poly] at h; simp only [mg, dg]; exact mg_le_dg_sol_aux hV hA a h
  | .add a b, h | .ndiv a b, h | .nmod a b, h | .quo a b, h | .rem a b, h => by
    simp only [Poly, Bool.and_eq_true] at h
    have ha := (mg_le_dg_sol_aux hV hA a h.1).trans (pow_le_pow' (le_max_left (dg a) (dg b)))
    have hb := (mg_le_dg_sol_aux hV hA b h.2).trans (pow_le_pow' (le_max_right (dg a) (dg b)))
    simp only [mg, dg]
    have e : 2 ^ (A * (max (dg a) (dg b) + 1)) = 2 ^ (A * max (dg a) (dg b)) * 2 ^ A := by
      rw [Nat.mul_add, mul_one, pow_add]
    have : 4 ≤ 2 ^ A := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hA
    rw [e]; nlinarith
  | .mul a b, h => by
    simp only [Poly, Bool.and_eq_true] at h
    have ha := mg_le_dg_sol_aux hV hA a h.1
    have hb := mg_le_dg_sol_aux hV hA b h.2
    simp only [mg, dg]
    have e : 2 ^ (A * (dg a + dg b + 1)) = 2 ^ (A * dg a) * 2 ^ (A * dg b) * 2 ^ A := by
      rw [Nat.mul_add, Nat.mul_add, mul_one, pow_add, pow_add]
    have h4 : 4 ≤ 2 ^ A := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hA
    have h1 := two_le_pow hA (dg_pos a)
    have h2 := two_le_pow hA (dg_pos b)
    rw [e]
    have t1 : mg V a * mg V b ≤ 2 ^ (A * dg a) * 2 ^ (A * dg b) := Nat.mul_le_mul ha hb
    have t2 : 2 ^ (A * dg a) ≤ 2 ^ (A * dg a) * 2 ^ (A * dg b) := Nat.le_mul_of_pos_right _ (by omega)
    have t3 : 2 ^ (A * dg b) ≤ 2 ^ (A * dg a) * 2 ^ (A * dg b) := Nat.le_mul_of_pos_left _ (by omega)
    have t4 : 2 ^ (A * dg a) * 2 ^ (A * dg b) * 4 ≤ 2 ^ (A * dg a) * 2 ^ (A * dg b) * 2 ^ A :=
      Nat.mul_le_mul_left _ h4
    omega
  | .shl a b, h => by simp [Poly] at h
  | .pow2 a, h => by simp [Poly] at h
  | .sel c x y, h => by
    simp only [Poly, Bool.and_eq_true] at h
    set m := max (dg c) (max (dg x) (dg y))
    have hc := (mg_le_dg_sol_aux hV hA c h.1.1).trans (pow_le_pow' (show dg c ≤ m by omega))
    have hx := (mg_le_dg_sol_aux hV hA x h.1.2).trans (pow_le_pow' (show dg x ≤ m by omega))
    have hy := (mg_le_dg_sol_aux hV hA y h.2).trans (pow_le_pow' (show dg y ≤ m by omega))
    simp only [mg, dg]
    have e : 2 ^ (A * (m + 1)) = 2 ^ (A * m) * 2 ^ A := by rw [Nat.mul_add, mul_one, pow_add]
    have : 4 ≤ 2 ^ A := by
      calc 4 = 2 ^ 2 := by norm_num
        _ ≤ _ := Nat.pow_le_pow_right (by norm_num) hA
    rw [e]; nlinarith

/-! ## The push loop -/

