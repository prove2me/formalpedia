theorem mul_val_congr {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

theorem paste_exposed {S₀ S₁ S₂ : Type u} [CommRing S₀] [CommRing S₁] [CommRing S₂]
    (φ : S₀ →+* S₁) (ψ : S₁ →+* S₂)
    (E₀ : FakeEllipticCurve Λ N S₀) (E₁ : FakeEllipticCurve Λ N S₁) (E₂ : FakeEllipticCurve Λ N S₂)
    (g : E₁.A ⟶ E₀.A) (hg : CategoryTheory.IsPullback g E₁.f E₀.f (Spec.map (CommRingCat.ofHom φ)))
    (hg_mul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P Q : SchemeHomOver t' E₁.f),
        (E₁.L.mul t' P Q).1 ≫ g =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)
    (hg_act : ∀ x : ↥Λ, E₁.act x ≫ g = g ≫ E₀.act x)
    (hg_lev' : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        (∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) → FactorsThrough E₁.lev P)
    (g₀ : E₂.A ⟶ E₀.A) (hg₀ : CategoryTheory.IsPullback g₀ E₂.f E₀.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))))
    (h₀mul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P Q : SchemeHomOver t' E₂.f),
        (E₂.L.mul t' P Q).1 ≫ g₀ =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ψ.comp φ)))
            ⟨P.1 ≫ g₀, by rw [Category.assoc, hg₀.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g₀, by rw [Category.assoc, hg₀.w, ← Category.assoc, Q.2]⟩).1)
    (h₀act : ∀ x : ↥Λ, E₂.act x ≫ g₀ = g₀ ≫ E₀.act x)
    (h₀lev : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P : SchemeHomOver t' E₂.f),
        FactorsThrough E₂.lev P → ∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g₀) :
    ∃ (e : E₂.A ⟶ E₁.A) (he : CategoryTheory.IsPullback e E₂.f E₁.f (Spec.map (CommRingCat.ofHom ψ))),
      e ≫ g = g₀ ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P Q : SchemeHomOver t' E₂.f),
        (E₂.L.mul t' P Q).1 ≫ e =
          (E₁.L.mul (t' ≫ Spec.map (CommRingCat.ofHom ψ))
            ⟨P.1 ≫ e, by rw [Category.assoc, he.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ e, by rw [Category.assoc, he.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E₂.act x ≫ e = e ≫ E₁.act x) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P : SchemeHomOver t' E₂.f),
        FactorsThrough E₂.lev P → ∃ P₁ : T ⟶ E₁.C, P₁ ≫ E₁.lev = P.1 ≫ e) := by
  have hcomp : Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have hw : g₀ ≫ E₀.f = (E₂.f ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [hg₀.w, hcomp, Category.assoc]
  let e : E₂.A ⟶ E₁.A := hg.lift g₀ (E₂.f ≫ Spec.map (CommRingCat.ofHom ψ)) hw
  have he₁ : e ≫ g = g₀ := hg.lift_fst _ _ _
  have he₂ : e ≫ E₁.f = E₂.f ≫ Spec.map (CommRingCat.ofHom ψ) := hg.lift_snd _ _ _
  have hsq : CategoryTheory.IsPullback e E₂.f E₁.f (Spec.map (CommRingCat.ofHom ψ)) := by
    refine CategoryTheory.IsPullback.of_right ?_ he₂ hg
    rw [he₁, ← hcomp]
    exact hg₀
  refine ⟨e, hsq, he₁, ?_, ?_, ?_⟩
  · intro T t' P Q
    apply hg.hom_ext
    · rw [Category.assoc, he₁, h₀mul t' P Q, hg_mul]
      apply mul_val_congr E₀.L
      · rw [Category.assoc, hcomp]
      · show P.1 ≫ g₀ = (P.1 ≫ e) ≫ g
        rw [Category.assoc, he₁]
      · show Q.1 ≫ g₀ = (Q.1 ≫ e) ≫ g
        rw [Category.assoc, he₁]
    · conv_lhs => rw [Category.assoc, he₂, ← Category.assoc, (E₂.L.mul t' P Q).2]
      exact ((E₁.L.mul _ _ _).2).symm
  · intro x
    apply hg.hom_ext
    · rw [Category.assoc, he₁, h₀act x, Category.assoc, hg_act x, ← Category.assoc, he₁]
    · rw [Category.assoc, he₂, ← Category.assoc, E₂.act_over x, Category.assoc, E₁.act_over x, he₂]
  · intro T t' P hP
    obtain ⟨P₀, hP₀⟩ := h₀lev t' P hP
    exact hg_lev' (t' ≫ Spec.map (CommRingCat.ofHom ψ))
      ⟨P.1 ≫ e, by rw [Category.assoc, he₂, ← Category.assoc, P.2]⟩ ⟨P₀, by rw [hP₀, Category.assoc, he₁]⟩

theorem exists_baseChange_paste {S₀ S₁ S₂ : Type u} [CommRing S₀] [CommRing S₁] [CommRing S₂]
    (φ : S₀ →+* S₁) (ψ : S₁ →+* S₂) (E₀ : FakeEllipticCurve Λ N S₀) (E₂ : FakeEllipticCurve Λ N S₂)
    (h₀₂ : FakeEllipticCurve.IsPullback (ψ.comp φ) E₀ E₂) :
    ∃ (E₁ : FakeEllipticCurve Λ N S₁) (g : E₁.A ⟶ E₀.A)
      (hg : CategoryTheory.IsPullback g E₁.f E₀.f (Spec.map (CommRingCat.ofHom φ))),
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P Q : SchemeHomOver t' E₁.f),
        (E₁.L.mul t' P Q).1 ≫ g =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E₁.act x ≫ g = g ≫ E₀.act x) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        FactorsThrough E₁.lev P → ∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        (∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) → FactorsThrough E₁.lev P) ∧
      FakeEllipticCurve.IsPullback φ E₀ E₁ ∧ FakeEllipticCurve.IsPullback ψ E₁ E₂ := by
  obtain ⟨E₁, g, hg, hmul, hact, hlev, hlev'⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff φ E₀
  obtain ⟨g₀, hg₀, h₀mul, h₀act, h₀lev⟩ := h₀₂
  obtain ⟨e, he, -, hemul, heact, helev⟩ :=
    paste_exposed φ ψ E₀ E₁ E₂ g hg hmul hact hlev' g₀ hg₀ h₀mul h₀act h₀lev
  exact ⟨E₁, g, hg, hmul, hact, hlev, hlev', ⟨g, hg, hmul, hact, hlev⟩, ⟨e, he, hemul, heact, helev⟩⟩

theorem isPullback_comp {S₀ S₁ S₂ : Type u} [CommRing S₀] [CommRing S₁] [CommRing S₂]
    (φ : S₀ →+* S₁) (ψ : S₁ →+* S₂)
    (E₀ : FakeEllipticCurve Λ N S₀) (E₁ : FakeEllipticCurve Λ N S₁) (E₂ : FakeEllipticCurve Λ N S₂)
    (h₀₁ : FakeEllipticCurve.IsPullback φ E₀ E₁) (h₁₂ : FakeEllipticCurve.IsPullback ψ E₁ E₂) :
    FakeEllipticCurve.IsPullback (ψ.comp φ) E₀ E₂ := by
  obtain ⟨g₁, hg₁, hmul₁, hact₁, hlev₁⟩ := h₀₁
  obtain ⟨g₂, hg₂, hmul₂, hact₂, hlev₂⟩ := h₁₂
  have hcomp : Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  have hsq : CategoryTheory.IsPullback (g₂ ≫ g₁) E₂.f E₀.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))) := by
    rw [hcomp]
    exact hg₂.paste_horiz hg₁
  refine ⟨g₂ ≫ g₁, hsq, ?_, ?_, ?_⟩
  · intro T t' P Q
    rw [← Category.assoc, hmul₂ t' P Q, hmul₁]
    apply mul_val_congr E₀.L
    · rw [Category.assoc, hcomp]
    · exact Category.assoc _ _ _
    · exact Category.assoc _ _ _
  · intro x
    rw [← Category.assoc, hact₂ x, Category.assoc, hact₁ x, Category.assoc]
  · intro T t' P hP
    obtain ⟨P₁, hP₁⟩ := hlev₂ t' P hP
    obtain ⟨P₀, hP₀⟩ := hlev₁ (t' ≫ Spec.map (CommRingCat.ofHom ψ))
      ⟨P.1 ≫ g₂, by rw [Category.assoc, hg₂.w, ← Category.assoc, P.2]⟩ ⟨P₁, hP₁⟩
    exact ⟨P₀, by rw [hP₀, Category.assoc]⟩

section Arithmetic

def toField (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    ↥(B.toSubring ⊓ K'.toSubring) →+* ↥K' where
  toFun x := ⟨x.1, x.2.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem toField_apply_coe (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ))
    (x : ↥(B.toSubring ⊓ K'.toSubring)) : ((toField B K' x : ↥K') : AlgebraicClosure ℚ) = (x : AlgebraicClosure ℚ) :=
  rfl

theorem toField_injective (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    Function.Injective (toField B K') := by
  intro x y h
  apply Subtype.ext
  have := congrArg (fun z : ↥K' => (z : AlgebraicClosure ℚ)) h
  exact this

theorem algebraMap_comp_toField (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    (algebraMap (↥K') (AlgebraicClosure ℚ)).comp (toField B K') = (B.toSubring ⊓ K'.toSubring).subtype :=
  RingHom.ext fun _ => rfl

theorem isFractionRing_toField (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    letI := (toField B K').toAlgebra
    IsFractionRing ↥(B.toSubring ⊓ K'.toSubring) ↥K' := by
  letI := (toField B K').toAlgebra
  have halg : ∀ x, algebraMap ↥(B.toSubring ⊓ K'.toSubring) ↥K' x = toField B K' x := fun _ => rfl
  refine ⟨?_, ?_, ?_⟩
  ·
    rintro ⟨s, hs⟩
    have hs0 : s ≠ 0 := nonZeroDivisors.ne_zero hs
    refine isUnit_iff_ne_zero.mpr ?_
    rw [halg]
    intro h
    exact hs0 (toField_injective B K' (by rw [h, map_zero]))
  ·
    intro y
    rcases B.mem_or_inv_mem (y : AlgebraicClosure ℚ) with hy | hy
    · refine ⟨⟨⟨(y : AlgebraicClosure ℚ), ⟨hy, y.2⟩⟩, 1⟩, ?_⟩
      simp only [OneMemClass.coe_one, map_one, mul_one]
      rw [halg]
      exact Subtype.ext rfl
    · by_cases hy0 : y = 0
      · refine ⟨⟨0, 1⟩, ?_⟩
        simp [hy0]
      have hyinv : ((y : AlgebraicClosure ℚ))⁻¹ ∈ B.toSubring ⊓ K'.toSubring :=
        ⟨hy, by simpa using (y⁻¹).2⟩
      have hne : (⟨(y : AlgebraicClosure ℚ)⁻¹, hyinv⟩ : ↥(B.toSubring ⊓ K'.toSubring)) ≠ 0 := by
        intro h
        have := congrArg (fun z : ↥(B.toSubring ⊓ K'.toSubring) => (z : AlgebraicClosure ℚ)) h
        simp only [ZeroMemClass.coe_zero, inv_eq_zero] at this
        exact hy0 (Subtype.ext this)
      refine ⟨⟨1, ⟨⟨(y : AlgebraicClosure ℚ)⁻¹, hyinv⟩, mem_nonZeroDivisors_of_ne_zero hne⟩⟩, ?_⟩
      simp only [map_one]
      rw [halg]
      apply Subtype.ext
      change (y : AlgebraicClosure ℚ) * (y : AlgebraicClosure ℚ)⁻¹ = 1
      exact mul_inv_cancel₀ fun h => hy0 (Subtype.ext h)
  ·
    intro x y h
    rw [halg, halg] at h
    exact ⟨1, by rw [toField_injective B K' h]⟩

theorem mem_of_isIntegral_int (B : ValuationSubring (AlgebraicClosure ℚ)) {x : AlgebraicClosure ℚ}
    (hx : IsIntegral ℤ x) : x ∈ B := by

  have hv := Valuation.valuationSubring.integers (v := B.valuation)

  have hx' : IsIntegral ↥(B.valuation.valuationSubring) x := by
    obtain ⟨p, hp, hpx⟩ := hx
    refine ⟨p.map (Int.castRingHom _), hp.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have : (algebraMap (↥B.valuation.valuationSubring) (AlgebraicClosure ℚ)).comp (Int.castRingHom _) =
        algebraMap ℤ (AlgebraicClosure ℚ) := RingHom.ext_int _ _
    rw [this]
    exact hpx
  have hle := (hv.isIntegral_iff_v_le_one).mp hx'
  exact (B.valuation_le_one_iff x).mp hle

theorem exists_prime_natCast_mem_maximalIdeal (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B ≠ ⊤) :
    ∃ p : ℕ, p.Prime ∧ ((p : ℕ) : ↥B) ∈ IsLocalRing.maximalIdeal ↥B := by
  classical

  obtain ⟨x, hx⟩ : ∃ x : AlgebraicClosure ℚ, x ∉ B := by
    by_contra h
    push Not at h
    exact hB (top_unique fun y _ => h y)

  have hxQ : IsIntegral ℚ x := by

    have h := ((AlgebraicClosure.isAlgebraic ℚ).isAlgebraic x).isIntegral
    convert h
    rfl
    rfl
  obtain ⟨⟨m, hm⟩, hmx⟩ := IsIntegral.exists_multiple_integral_of_isLocalization (nonZeroDivisors ℤ) x hxQ
  have hm0 : (m : ℤ) ≠ 0 := nonZeroDivisors.ne_zero hm
  have hmx' : IsIntegral ℤ ((m : AlgebraicClosure ℚ) * x) := by
    have e : (⟨m, hm⟩ : nonZeroDivisors ℤ) • x = (m : AlgebraicClosure ℚ) * x := by
      rw [Submonoid.mk_smul, zsmul_eq_mul]
    rw [← e]; exact hmx
  have hmxB : (m : AlgebraicClosure ℚ) * x ∈ B := mem_of_isIntegral_int B hmx'

  have hvx : ¬ B.valuation x ≤ 1 := fun h => hx ((B.valuation_le_one_iff x).mp h)
  have hvm : B.valuation (m : AlgebraicClosure ℚ) < 1 := by
    have h1 : B.valuation ((m : AlgebraicClosure ℚ) * x) ≤ 1 := (B.valuation_le_one_iff _).mpr hmxB
    rw [map_mul] at h1
    by_contra hge
    push Not at hge hvx
    have hm1 : B.valuation (m : AlgebraicClosure ℚ) ≤ 1 :=
      (B.valuation_le_one_iff _).mpr (by exact_mod_cast (intCast_mem B m))
    have hm1' : B.valuation (m : AlgebraicClosure ℚ) = 1 := le_antisymm hm1 hge
    rw [hm1', one_mul] at h1
    exact (not_le.mpr hvx) h1

  let I : Ideal ℤ := (IsLocalRing.maximalIdeal ↥B).comap (Int.castRingHom ↥B)
  have hIprime : I.IsPrime := Ideal.IsPrime.comap _
  have hmI : m ∈ I := by
    change (Int.castRingHom ↥B m) ∈ IsLocalRing.maximalIdeal ↥B
    rw [ValuationSubring.valuation_lt_one_iff]
    simpa using hvm
  have hI0 : I ≠ ⊥ := fun h => hm0 (by rw [h] at hmI; exact (Submodule.mem_bot ℤ).mp hmI)

  haveI : I.IsPrincipal := IsPrincipalIdealRing.principal I
  have hg : Prime (Submodule.IsPrincipal.generator I) := Submodule.IsPrincipal.prime_generator_of_isPrime I hI0
  set g := Submodule.IsPrincipal.generator I with hg_def
  refine ⟨g.natAbs, Int.prime_iff_natAbs_prime.mp hg, ?_⟩
  have hgI : g ∈ I := Submodule.IsPrincipal.generator_mem I
  have hpI : ((g.natAbs : ℕ) : ℤ) ∈ I := by
    rcases Int.natAbs_eq g with h | h
    · rw [← h]; exact hgI
    · have h' : ((g.natAbs : ℕ) : ℤ) = -g := by omega
      rw [h']
      exact I.neg_mem hgI
  have : (Int.castRingHom ↥B ((g.natAbs : ℕ) : ℤ)) ∈ IsLocalRing.maximalIdeal ↥B := hpI
  simpa using this

theorem isDiscreteValuationRing_of_ringEquiv {R₁ R₂ : Type*} [CommRing R₁] [IsDomain R₁] [CommRing R₂] [IsDomain R₂]
    [IsDiscreteValuationRing R₁] (e : R₁ ≃+* R₂) : IsDiscreteValuationRing R₂ := by
  haveI : IsPrincipalIdealRing R₂ := IsPrincipalIdealRing.of_surjective e.toRingHom e.surjective
  haveI : IsLocalRing R₂ := IsLocalRing.of_surjective' e.toRingHom e.surjective
  refine { not_a_field' := ?_ }
  intro h
  have hF : IsField R₂ := (IsLocalRing.isField_iff_maximalIdeal_eq).mpr h
  have hF₁ : IsField R₁ := MulEquiv.isField hF e.toMulEquiv
  exact IsDiscreteValuationRing.not_isField R₁ hF₁

theorem isDiscreteValuationRing_inf (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B ≠ ⊤)
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥K'] :
    IsDiscreteValuationRing ↥(B.toSubring ⊓ K'.toSubring) := by

  let O : ValuationSubring ↥K' := B.comap (algebraMap ↥K' (AlgebraicClosure ℚ))
  have hO : ∀ y : ↥K', y ∈ O ↔ (y : AlgebraicClosure ℚ) ∈ B := fun _ => ValuationSubring.mem_comap

  obtain ⟨p, hp, hpB⟩ := exists_prime_natCast_mem_maximalIdeal B hB
  have hOtop : O ≠ ⊤ := by
    intro h
    have hmem : ((p : ↥K'))⁻¹ ∈ O := by rw [h]; exact ValuationSubring.mem_top _
    rw [hO] at hmem
    have hp0 : ((p : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by exact_mod_cast hp.ne_zero

    have hunit : IsUnit (((p : ℕ) : ↥B)) := by
      refine ⟨⟨(p : ↥B), ⟨((p : AlgebraicClosure ℚ))⁻¹, by simpa using hmem⟩, ?_, ?_⟩, rfl⟩
      · apply Subtype.ext
        change ((p : ℕ) : AlgebraicClosure ℚ) * ((p : ℕ) : AlgebraicClosure ℚ)⁻¹ = 1
        exact mul_inv_cancel₀ hp0
      · apply Subtype.ext
        change ((p : ℕ) : AlgebraicClosure ℚ)⁻¹ * ((p : ℕ) : AlgebraicClosure ℚ) = 1
        exact inv_mul_cancel₀ hp0
    exact (IsLocalRing.mem_maximalIdeal _).mp hpB hunit

  have hDVR : IsDiscreteValuationRing ↥O :=
    ValuationSubring.isDiscreteValuationRing_of_algebraMap_mem_of_finite (A := ℤ) (K := ℚ) (L := ↥K') O
      (fun a => by rw [hO]; simpa using intCast_mem B a) hOtop

  let e : ↥O ≃+* ↥(B.toSubring ⊓ K'.toSubring) :=
    { toFun := fun y => ⟨(y.1 : AlgebraicClosure ℚ), ⟨(hO y.1).mp y.2, y.1.2⟩⟩
      invFun := fun z => ⟨⟨z.1, z.2.2⟩, (hO _).mpr z.2.1⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl
      map_add' := fun _ _ => rfl }
  exact isDiscreteValuationRing_of_ringEquiv e

theorem natCast_mem_maximalIdeal_inf (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) [IsLocalRing ↥(B.toSubring ⊓ K'.toSubring)]
    {p : ℕ} (hpB : ((p : ℕ) : ↥B) ∈ IsLocalRing.maximalIdeal ↥B) :
    ((p : ℕ) : ↥(B.toSubring ⊓ K'.toSubring)) ∈ IsLocalRing.maximalIdeal ↥(B.toSubring ⊓ K'.toSubring) := by
  rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  intro hu
  apply (IsLocalRing.mem_maximalIdeal _).mp hpB
  obtain ⟨u, hu⟩ := hu
  refine ⟨⟨(p : ↥B), ⟨((↑u⁻¹ : ↥(B.toSubring ⊓ K'.toSubring)) : AlgebraicClosure ℚ), (↑u⁻¹ : ↥(B.toSubring ⊓ K'.toSubring)).2.1⟩, ?_, ?_⟩, rfl⟩
  · apply Subtype.ext
    have h := congrArg (fun z : ↥(B.toSubring ⊓ K'.toSubring) => (z : AlgebraicClosure ℚ)) u.mul_inv
    simp only [Subring.coe_mul, hu, OneMemClass.coe_one] at h
    simpa using h
  · apply Subtype.ext
    have h := congrArg (fun z : ↥(B.toSubring ⊓ K'.toSubring) => (z : AlgebraicClosure ℚ)) u.inv_mul
    simp only [Subring.coe_mul, hu, OneMemClass.coe_one] at h
    simpa using h

theorem isUnit_natCast_inf (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) {n : ℕ} (hn : IsUnit ((n : ℤ) : ↥B)) :
    IsUnit ((n : ℕ) : ↥(B.toSubring ⊓ K'.toSubring)) := by
  obtain ⟨u, hu⟩ := hn
  have hinvB : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) ∈ B := (↑u⁻¹ : ↥B).2

  have hval : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) = ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ := by
    have h := congrArg (fun z : ↥B => (z : AlgebraicClosure ℚ)) u.inv_mul
    simp only [Subring.coe_mul, hu, OneMemClass.coe_one] at h

    have h' : ((↑u⁻¹ : ↥B) : AlgebraicClosure ℚ) * ((n : ℕ) : AlgebraicClosure ℚ) = 1 := by simpa using h
    have hn0 : ((n : ℕ) : AlgebraicClosure ℚ) ≠ 0 := by
      intro h0; rw [h0, mul_zero] at h'; exact zero_ne_one h'
    exact (eq_inv_of_mul_eq_one_left h')
  have hinvK : ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ K'.toSubring := by
    have : ((n : ℕ) : AlgebraicClosure ℚ)⁻¹ ∈ K' := inv_mem (natCast_mem K' n)
    exact this
