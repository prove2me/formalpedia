-- Source module: Solutions.R6BitNet
/-!
# Round six, bit side: interchange networks with general frames (`QHNet`)

The array-model notion of network needed by S. Jain's round six (ARCH.md §2 R1, design
decision 2). Compared with `AModel.Circuit` (OpenAI Prop. 11):

* there is no `unit` restriction and no shear structure: every **edge** is an explicit frame
  change on one stream, given by Bruhat data `E₁ · σ · E₂` with rational `2m × 2m` lower
  triangular factors (reduced mod the field size `N`) and a permutation `σ` that is a product of
  field transpositions `H_{i+k} ↔ D_{j+k}`, grouped into **runs** `(i, j, r)` (`k < r`);
  each run is executed as **one** recursive child interchange of width `r` fields (so child widths
  are arbitrary `0 < r < m`, as in the partial-swap Bruhat run decomposition);
* **gates** are arbitrary pointwise linear maps on a set of wires (copies, XORs, the copy
  correction, the scalar word);
* wires are `Fin W ⊕ Fin T`: `W` roles (one per row residue of the row split) and `T`
  temporaries (initialised to `0`, discarded at the end);
* correctness (`QHNet.IdealOK N`) is stated for the **ideal** execution, in which every edge runs
  its Bruhat steps exactly (`runArr`), on streams of *any* shape with *any* layout of `2m` active
  fields of size `N`: role `ρ w` ends with the chunk interchange `amap swapMat` of the input
  stream `w`. This is the hypothesis later workers prove for the real network (e.g. from
  `AModel.linear_via_bruhat_array` and a frame-label invariant);
* `hist`: the child-width histogram `[(r, 1)]`, one entry per run of every edge.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

/-- Rational `2m × 2m` matrices (the Bruhat factors of a frame change). -/
abbrev QMat2 (m : ℕ) := Matrix (Fin (m + m)) (Fin (m + m)) ℚ

/-- Reduction mod `N` of a rational matrix (`redQ`, total). -/
def redM {m : ℕ} (N : ℕ) (E : QMat2 m) : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N) :=
  E.map (redQ N)

/-- Frame-change data of one edge: the frame change is `E₁ · σ · E₂` where `σ` is the product of
the transpositions `H_{i+k} ↔ D_{j+k}` (`k < r`) over the runs `(i, j, r) ∈ runs`. -/
structure Edge (m : ℕ) where
  E₁ : QMat2 m
  runs : List (ℕ × ℕ × ℕ)
  E₂ : QMat2 m

/-- The pivots `(H_{i+k}, D_{j+k})`, `k < r`, of a run (out-of-range ones dropped). -/
def runPiv (m : ℕ) (ρ : ℕ × ℕ × ℕ) : List (Fin (m + m) × Fin (m + m)) :=
  (List.range ρ.2.2).filterMap fun k =>
    if h : ρ.1 + k < m ∧ ρ.2.1 + k < m then
      some (Fin.castAdd m ⟨ρ.1 + k, h.1⟩, Fin.natAdd m ⟨ρ.2.1 + k, h.2⟩)
    else none

/-- The Bruhat steps of an edge at field size `N`: shifts for `E₂`, the transpositions, shifts
for `E₁` (`AModel.bruhatSteps`). -/
def Edge.steps {m : ℕ} (e : Edge m) (N : ℕ) : List (Step (m + m) N) :=
  bruhatSteps (redM N e.E₁) (e.runs.flatMap (runPiv m)) (redM N e.E₂)

/-- A run is valid: nonempty, narrower than `m`, and inside both chunks. -/
def RunOK (m : ℕ) (ρ : ℕ × ℕ × ℕ) : Prop :=
  0 < ρ.2.2 ∧ ρ.2.2 < m ∧ ρ.1 + ρ.2.2 ≤ m ∧ ρ.2.1 + ρ.2.2 ≤ m

/-- One instruction of the network. -/
inductive Instr (Wr R : Type*) (m : ℕ) where
  /-- Pointwise linear gate on the wires of `S`: `x_w ← Σ_{w' ∈ S} g w w' x_{w'}`. -/
  | gate (g : Matrix Wr Wr R) (S : Finset Wr)
  /-- Frame change `e` on wire `w`. -/
  | edge (w : Wr) (e : Edge m)

namespace Instr

variable {Wr R : Type*} {m : ℕ}

/-- The edge of an instruction, if any. -/
def edgeOf : Instr Wr R m → Option (Edge m)
  | gate _ _ => none
  | edge _ e => some e

/-- The number of touched wires of a gate (`0` for an edge). -/
def gateWork : Instr Wr R m → ℕ
  | gate _ S => S.card
  | edge _ _ => 0

end Instr

/-- **Round-six bit interchange network.** `W` roles, `T` temporaries, frames on `2m` fields.
`ρ`: output role `ρ w` carries input role `w` (the merge undoes `ρ`). -/
structure QHNet (R : Type*) (W T m : ℕ) where
  prog : List (Instr (Fin W ⊕ Fin T) R m)
  ρ : Fin W → Fin W

/-! ## Execution of a network on streams (generic in the edge implementation) -/

section Run

variable {Wr R : Type*} [Fintype Wr] [DecidableEq Wr] [CommRing R] {m : ℕ}

/-- A pointwise gate on streams of length `n`. -/
def gateApply (n : ℕ) (g : Matrix Wr Wr R) (S : Finset Wr) (st : Wr → List R) : Wr → List R :=
  fun w => if w ∈ S then List.ofFn (fun i : Fin n => ∑ w' ∈ S, g w w' * (st w').getD i 0)
    else st w

/-- One instruction, with edges executed by `impl`. -/
def instrRun (n : ℕ) (impl : Edge m → List R → List R) (st : Wr → List R) :
    Instr Wr R m → Wr → List R
  | .gate g S => gateApply n g S st
  | .edge w e => Function.update st w (impl e (st w))

/-- Run a program, with edges executed by `impl`. -/
def netRunH (n : ℕ) (impl : Edge m → List R → List R) (prog : List (Instr Wr R m))
    (st : Wr → List R) : Wr → List R :=
  prog.foldl (instrRun n impl) st

/-- The edges of a program. -/
def progEdges (prog : List (Instr Wr R m)) : List (Edge m) := prog.filterMap Instr.edgeOf

end Run

/-! ## The network data: edges, histogram, hypotheses -/

namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

/-- All edges of the network. -/
def edges (C : QHNet R W T m) : List (Edge m) := progEdges C.prog

/-- All child widths (one per run of every edge). -/
def widths (C : QHNet R W T m) : List ℕ := C.edges.flatMap fun e => e.runs.map fun ρ => ρ.2.2

/-- The child-width histogram `[(w, n_w)]` (here with `n_w = 1` per child). -/
def hist (C : QHNet R W T m) : List (ℕ × ℕ) := C.widths.map fun w => (w, 1)

/-- Number of edges. -/
def numEdges (C : QHNet R W T m) : ℕ := C.edges.length

/-- Total gate work: the number of (gate, touched wire) pairs. -/
def gateWork (C : QHNet R W T m) : ℕ := (C.prog.map Instr.gateWork).sum

/-- Initial wires: roles from the input streams, temporaries zero. -/
def initH (n : ℕ) (ins : Fin W → List R) : Fin W ⊕ Fin T → List R
  | .inl w => ins w
  | .inr _ => List.replicate n 0

/-- **Ideal execution** on streams of shape `sh` with layout `Λ` of the `2m` active fields
(field size `N`): every edge runs its Bruhat steps exactly. The value is the final content of
role `w`. -/
def idealOut (C : QHNet R W T m) (N : ℕ) {sh : Shape} (Λ : Layout sh (m + m) N)
    (ins : Fin W → List R) (w : Fin W) : List R :=
  netRunH (vol sh) (fun e => runArr Λ 0 (e.steps N)) C.prog (initH (vol sh) ins) (.inl w)

/-- All runs are valid (`0 < r < m`, inside the chunks). -/
def RunsOK (C : QHNet R W T m) : Prop := ∀ e ∈ C.edges, ∀ ρ ∈ e.runs, RunOK m ρ

/-- **Correctness of the ideal network at field size `N`.** For every stream shape and layout
of the `2m` active fields, role `ρ w` ends with the chunk interchange `(H, D) ↦ (D, H)` of input
stream `w`. -/
def IdealOK (C : QHNet R W T m) (N : ℕ) : Prop :=
  ∀ (sh : Shape) (Λ : Layout sh (m + m) N) (ins : Fin W → List R),
    (∀ w, (ins w).length = vol sh) →
      ∀ w, C.idealOut N Λ ins (C.ρ w) = pull sh sh (amap Λ swapMat) 0 (ins w)

/-- The hypotheses of the generalized Prop. 11 at field size `N`. -/
structure OK (C : QHNet R W T m) (N : ℕ) : Prop where
  runs : C.RunsOK
  ideal : C.IdealOK N

end QHNet

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitLevel
/-!
# Round six, bit side: one level of the generalized Prop. 11

On the shape `P :: (W L') :: hdShape A B Cs m N` (two chunks of `m` fields of size `N`):
split the rows into `W` role streams (plus `T` zero temporaries), run the network with every
edge implemented by its shifts and **one child call per run** (`realEdge`), merge back undoing
`ρ`. With correct children and `C.OK N` this is the chunk interchange (`levelH_correct`).

1. `realEdge_eq`: with children equal to the exact run transpositions, the implemented edge is
   the ideal one (`runArr` of the Bruhat steps).
2. `runArr_runPiv`: on the stream layout, the transpositions of a run `(i, j, r)` are the block
   swap of the field runs `H_i … H_{i+r-1}` and `D_j … D_{j+r-1}`.
3. `levelH_correct`.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {m : ℕ}

/-! ## 1. Implemented edges -/

section Edge

variable {sh : Shape} {N : ℕ} (Λ : Layout sh (m + m) N)

/-- **Implemented edge**: shifts for `E₂` (passes), one child call per run, shifts for `E₁`. -/
def realEdge (child : ℕ × ℕ × ℕ → List R → List R) (e : Edge m) (ys : List R) : List R :=
  runArr Λ 0 (shiftSteps (redM N e.E₁))
    (e.runs.foldl (fun ys ρ => child ρ ys) (runArr Λ 0 (shiftSteps (redM N e.E₂)) ys))

end Edge

/-! ## 2. Runs on the stream layout are block swaps of field runs -/

/-! ## 3. One level -/

section Level

variable {W T : ℕ} [NeZero W] (C : QHNet R W T m) (N P L' : ℕ) (A B Cs : Shape)

/-- **One level of the generalized Prop. 11** on `P :: (W L') :: hdShape A B Cs m N`: row split
into `W` role streams and `T` zero temporaries; the network, every edge implemented by
`realEdge` with the run interchanges delegated to `child`; merge undoing `ρ`. -/
def levelH (child : ℕ × ℕ × ℕ → List R → List R) (xs : List R) : List R :=
  rowMerge P W L' (hdShape A B Cs m N) 0 (fun w =>
    netRunH (vol (P :: L' :: hdShape A B Cs m N))
      (realEdge ((hdLayout A B Cs m N).cons2 P L') child) C.prog
      (QHNet.initH (T := T) (vol (P :: L' :: hdShape A B Cs m N))
        (fun w' => rowSplit P W L' (hdShape A B Cs m N) w' 0 xs)) (.inl (C.ρ w)))

/-- The child hypothesis: for every valid run `(i, j, r)`, `child` interchanges the field runs
`H_i … H_{i+r-1}` and `D_j … D_{j+r-1}` of a stream. -/
def ChildOKH (child : ℕ × ℕ × ℕ → List R → List R) : Prop :=
  ∀ ρ, RunOK m ρ → ∀ ys : List R, ys.length = vol (P :: L' :: hdShape A B Cs m N) →
    child ρ ys = pull (P :: L' :: hdShape A B Cs m N) (P :: L' :: hdShape A B Cs m N)
      (blockSwap (A.length + 2 + ρ.1) (A.length + B.length + m + 2 + ρ.2.1) ρ.2.2) 0 ys

variable [NeZero N]

end Level

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitProg
/-!
# Round six, bit side: the recursive interchange program for every width `e`

`progH C q e P L A B Cs` interchanges the two chunks of `e` radix-`q` digits of
`P :: L :: hdShape A B Cs e q`, for **every** `e` (not only `e = m^k`):

* `e < m`: `e` single digit swaps (`tailSwaps`);
* `e = m f + r`, `f ≥ 1`: one level (`levelH`) on the first `m f` digits of each chunk, viewed as
  `m` fields of size `q ^ f`, every run `(i, j, r')` of every edge being a recursive call of width
  `r' f < e`; then the `r` leftover digits by single digit swaps.

`progH_correct`: the denotation is the block swap of the two digit runs, when `C.OK (q ^ f)` for
all `f` and `W ^ depH m e ∣ L` (`depH` = recursion depth).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R]

/-! ## Digit swaps -/

section Tail

/-- Swap the digit runs `[c, c+r)` and `[c', c'+r)` by `r` single digit swaps (one pass each). -/
def tailSwaps (sh : Shape) (c c' r : ℕ) (xs : List R) : List R :=
  (runPairs c c' r).foldl (fun ys pr => pull sh sh (swapPos pr.1 pr.2) 0 ys) xs

end Tail

/-! ## Digit shapes -/

/-! ## Recursion depth -/

section Depth

lemma depH_dec {m e : ℕ} (h : m ≤ e ∧ 2 ≤ m) : (m - 1) * (e / m) < e := by
  have h1 : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  have h2 : e / m * m ≤ e := Nat.div_mul_le_self e m
  have h3 : (m - 1) * (e / m) + e / m = m * (e / m) := by
    rw [← Nat.succ_mul]; congr 1; omega
  nlinarith

/-- Recursion depth of `progH`: `0` below `m`, else one more than at `(m - 1) ⌊e / m⌋`
(the widest possible child). -/
def depH (m : ℕ) (e : ℕ) : ℕ :=
  if h : m ≤ e ∧ 2 ≤ m then depH m ((m - 1) * (e / m)) + 1 else 0
termination_by e
decreasing_by exact depH_dec h

end Depth

/-! ## The program -/

section Prog

variable {W T m : ℕ} [NeZero W]

/-- **The generalized interchange program.** `progH C q e P L A B Cs` interchanges the two chunks
of `e` radix-`q` digits of `P :: L :: hdShape A B Cs e q`. For `e ≥ m`, with `f = ⌊e/m⌋`,
`r = e mod m`: one level (`levelH`, field size `q ^ f`, `L / W` stream rows) on the first `m f`
digits of each chunk, the run `(i, j, r')` of an edge being the recursive call of width `r' f`
on the stream; then the `r` leftover digit pairs are swapped one by one. For `e < m`: `e` digit
swaps. -/
def progH (C : QHNet R W T m) (q : ℕ) (e P L : ℕ) (A B Cs : Shape) (xs : List R) : List R :=
  if m ≤ e then
    tailSwaps (P :: L :: hdShape A B Cs e q) (A.length + 2 + m * (e / m))
      (A.length + B.length + e + 2 + m * (e / m)) (e % m)
      (levelH C (q ^ (e / m)) P (L / W) A (List.replicate (e % m) q ++ B)
        (List.replicate (e % m) q ++ Cs)
        (fun ρ ys => if _hρ : ρ.2.2 * (e / m) < e then
            progH C q (ρ.2.2 * (e / m)) P (L / W) (A ++ List.replicate ρ.1 (q ^ (e / m)))
              (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
                ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m))))
              (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++
                (List.replicate (e % m) q ++ Cs)) ys
          else ys) xs)
  else tailSwaps (P :: L :: hdShape A B Cs e q) (A.length + 2) (A.length + B.length + e + 2) e xs
termination_by e

end Prog

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitCost
/-!
# Round six, bit side: cost of `progH` and the generalized Prop. 11

`costH C e V`: the structural cost of `progH C q e …` on an array of volume `V`, following the
program: `e < m`: `e` digit-swap passes; `e = m f + r`: `r` digit-swap passes, the row split and
merge (`2V`), `T` zero temporaries (`T V / W`), each gate one pass per touched wire (`V / W`),
each edge `4m` shift passes (`V / W` each) plus its run children, each a recursive call of width
`r' f` on a stream of volume `V / W`.

* `costH_lin`: `costH e V = V · costH e 1`.
* `cH_rec`: `c(e) = (e mod m) + K₀ + (1/W) Σ_{children} c(w ⌊e/m⌋)` (`c = costH · 1`).
* `costH_bound`: with `histMoment C.hist m τ < W`, `costH e V ≤ K V e^τ` for all `e` (via the
  monotone majorant of `c` and `R6.MomentRec.moment_recurrence_bound`).
* `prop11H`: denotation and cost together.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

/-- Cost of one instruction on streams of volume `v`, children costed by `child`. -/
noncomputable def instrCost {Wr : Type*} (child : ℕ × ℕ × ℕ → ℝ → ℝ) (v : ℝ) :
    Instr Wr R m → ℝ
  | .gate _ S => (S.card : ℝ) * v
  | .edge _ e => (2 * (m + m) : ℝ) * v + (e.runs.map fun ρ => child ρ v).sum

/-- **Structural cost of `progH`** at width `e` on volume `V`. -/
noncomputable def costH (C : QHNet R W T m) (e : ℕ) (V : ℝ) : ℝ :=
  if m ≤ e then
    ((e % m : ℕ) : ℝ) * V + (2 * V + (T : ℝ) * (V / W) +
      (C.prog.map (instrCost (fun ρ v => if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) v
        else 0) (V / W))).sum)
  else (e : ℝ) * V
termination_by e

/-- Per-unit-volume cost. -/
noncomputable def cH (C : QHNet R W T m) (e : ℕ) : ℝ := costH C e 1

/-- The linear constant `K₀ = 2 + (T + gate work + 4m · #edges) / W`. -/
noncomputable def K0 (C : QHNet R W T m) : ℝ :=
  2 + ((T : ℝ) + C.gateWork + 2 * (m + m) * C.numEdges) / W

/-- The monotone majorant `ĉ(x) = max_{y ≤ x} c(y)`. -/
noncomputable def cHat (C : QHNet R W T m) (x : ℕ) : ℝ :=
  (Finset.range (x + 1)).sup' ⟨0, by simp⟩ (cH C)

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitLab
/-!
# Round six, bit side: `IdealOK` from frame labels and a scalar routing identity

A sufficient condition for `QHNet.IdealOK N` in the style of OpenAI's network theorem
(`AModel.network_realizes`), but with **multiplicative** (non-commuting) frames:

* every edge `e` has lower triangular rational Bruhat factors with unit diagonals mod `N`
  (`EdgesOK`); its frame matrix is `X_e = E₁ · σ_e · E₂` mod `N` (`edgeMat`);
* labels (frames) are tracked along the program: initially `1` on every wire, an edge on `w`
  multiplies the label of `w` on the left by `X_e`; every gate touches wires with equal labels,
  and the final label of every role `ρ w` is `swapMat` (`LabOK`);
* the scalar circuit (gates only; temporaries start at `0`) routes role `w` to role `ρ w`
  (`ScalarOK`).

Then `C.IdealOK N` (`idealOK_of_labels`). The physical content of each wire is the array
permutation `Φ(F) = pull (amap F⁻¹)` of its logical content (`frameArr`), `Φ` is multiplicative
(`frameArr_mul`), commutes with pointwise gates (`frameArr_gate`), and the ideal edge is
`Φ(X_e)` (`runArr_steps_eq`, from `AModel.linear_via_bruhat_array`).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {m : ℕ}

/-! ## Frames as array permutations -/

section Frame

variable {sh : Shape} {N : ℕ} [NeZero N] (Λ : Layout sh (m + m) N)

/-- The array permutation realizing the address map of `F` (pull by `amap F⁻¹`). -/
noncomputable def frameArr (F : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) (xs : List R) : List R :=
  pull sh sh (amap Λ F⁻¹) 0 xs

@[simp] lemma length_frameArr (F : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) (xs : List R) :
    (frameArr Λ F xs).length = vol sh := by simp [frameArr]

/-- The frame matrix of an edge at field size `N`. -/
noncomputable def edgeMat (N : ℕ) (e : Edge m) : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N) :=
  redM N e.E₁ * ((e.runs.flatMap (runPiv m)).map fun p => Equiv.swap p.1 p.2).prod.permMatrix
    (ZMod N) * redM N e.E₂

/-- The Bruhat data of an edge is admissible mod `N`. -/
def EdgeOK (N : ℕ) (e : Edge m) : Prop :=
  (∀ i j, i < j → e.E₁ i j = 0) ∧ (∀ i j, i < j → e.E₂ i j = 0) ∧
    (∀ i, IsUnit (redQ N (e.E₁ i i))) ∧ (∀ i, IsUnit (redQ N (e.E₂ i i)))

end Frame

/-! ## Labels and the scalar circuit -/

section Labels

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] (N : ℕ)

/-- Label update by one instruction. -/
noncomputable def labStepH (F : Wr → Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) :
    Instr Wr R m → Wr → Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)
  | .gate _ _ => F
  | .edge w e => Function.update F w (edgeMat N e * F w)

/-- Every gate touches wires with equal labels. -/
def LabGates : List (Instr Wr R m) → (Wr → Matrix (Fin (m + m)) (Fin (m + m)) (ZMod N)) → Prop
  | [], _ => True
  | i :: l, F => (match i with
      | .gate _ S => ∀ w ∈ S, ∀ w' ∈ S, F w = F w'
      | .edge _ _ => True) ∧ LabGates l (labStepH N F i)

/-- Scalar action of a gate. -/
def gateVec (g : Matrix Wr Wr R) (S : Finset Wr) (v : Wr → R) : Wr → R :=
  fun w => if w ∈ S then ∑ w' ∈ S, g w w' * v w' else v w

/-- The scalar circuit (edges act trivially on logical values). -/
def scalarStepH (v : Wr → R) : Instr Wr R m → Wr → R
  | .gate g S => gateVec g S v
  | .edge _ _ => v

end Labels

namespace QHNet

variable {W T : ℕ}

/-- Every edge has admissible Bruhat data mod `N`. -/
def EdgesOK (C : QHNet R W T m) (N : ℕ) : Prop := ∀ e ∈ C.edges, EdgeOK N e

/-- Labels: gates touch equal labels, and every role `ρ w` ends with label `swapMat`. -/
def LabOK (C : QHNet R W T m) (N : ℕ) : Prop :=
  LabGates N C.prog (fun _ => 1) ∧
    ∀ w, C.prog.foldl (labStepH N) (fun _ => 1) (.inl (C.ρ w)) = swapMat

/-- The scalar circuit (temporaries start at `0`) routes role `w` to role `ρ w`. -/
def ScalarOK (C : QHNet R W T m) : Prop :=
  ∀ (v : Fin W → R) (w : Fin W),
    C.prog.foldl scalarStepH (Sum.elim v fun _ => 0) (.inl (C.ρ w)) = v w

end QHNet

/-! ## The invariant and `idealOK_of_labels` -/

end IntMul.Kappa.R6.Bit

end

section
-- Source module: Solutions.R6BitEx
/-!
# Round six, bit side: a sanity instance of `QHNet.OK`

`exNet`: `m = 2`, one role, no temporaries, a single edge with trivial Bruhat factors and the
two runs `H₀ ↔ D₀`, `H₁ ↔ D₁` (widths `1 < m`). It satisfies `QHNet.OK N` at every field size
(`exNet_OK`), via `idealOK_of_labels`. This checks that the hypotheses of `prop11H` are
consistent (non-vacuous); of course this network has no saving (`histMoment = 2 (1/2)^τ ≥ 1`).
-/

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R]

/-- The edge: `E₁ = E₂ = 1`, runs `(0, 0, 1)` and `(1, 1, 1)`. -/
def exEdge : Edge 2 := ⟨1, [(0, 0, 1), (1, 1, 1)], 1⟩

/-- The example network. -/
def exNet : QHNet R 1 0 2 := ⟨[.edge (.inl 0) exEdge], id⟩

end IntMul.Kappa.R6.Bit

