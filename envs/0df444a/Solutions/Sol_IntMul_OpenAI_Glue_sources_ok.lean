section
open Real
open IntMul
open IntMul.OpenAI
open IntMul.OpenAI.Glue
open RCost
theorem solution {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (d' : ℕ) (hd' : d' ≤ IntMul.OpenAI.Glue.dP n) :
    ∃ s : Fin (IntMul.OpenAI.Glue.dP n) → ℕ, (∀ i, Odd (s i)) ∧ (∀ i j, i ≠ j → Nat.Coprime (s i) (s j)) ∧
      ∀ i : Fin (IntMul.OpenAI.Glue.dP n), (4 * IntMul.OpenAI.Glue.dP n - 2) * (if (i : ℕ) < d' then IntMul.OpenAI.Glue.rP n / 2 else IntMul.OpenAI.Glue.rP n) < 4 * IntMul.OpenAI.Glue.dP n * s i ∧
        4 * IntMul.OpenAI.Glue.dP n * s i ≤ (4 * IntMul.OpenAI.Glue.dP n - 1) * (if (i : ℕ) < d' then IntMul.OpenAI.Glue.rP n / 2 else IntMul.OpenAI.Glue.rP n) := by
  obtain ⟨-, -, -, hd1, -, -, -, -, -, -, -, -, hfact, hr2, -⟩ := IntMul.OpenAI.Glue.params_ok hn
  exact IntMul.OpenAI.RP.sources_exist (IntMul.OpenAI.Glue.dP n) d' (IntMul.OpenAI.Glue.rP n) hd1 hd' hr2 hfact
end
