-- Source module: NLogNP.Logic
/-!
# Program logic for stack programs

`Runs I prog s σ σ' c`: `s` takes `σ` to `σ'` with cost at most `c`.  Besides the rules for each
statement this file provides

* `caseTops`: branch on the tops of several stacks (constant cost);
* `opsStmt`: straight-line lists of primitive operations;
* `machine`: a finite-state transducer whose state lives on a dedicated stack; its correctness
  reduces to iterating a plain Lean function `mstep`.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

def Runs (I : List Sym) (prog : Fin P → Stmt S P) (s : Stmt S P) (σ σ' : St S) (c : ℕ) : Prop :=
  ∃ c' ≤ c, Exec I prog s σ σ' c'

namespace Runs

end Runs

/-! ## Branching on stack tops -/

def caseList (i : Fin S) (k : Option Sym → Stmt S P) : List Sym → Stmt S P
  | [] => .skip
  | a :: l => .ite i (fun o => decide (o = some a)) (k (some a)) (caseList i k l)

def caseTop (i : Fin S) (k : Option Sym → Stmt S P) : Stmt S P :=
  .ite i (fun o => o.isNone) (k none) (caseList i k (List.finRange 16))

/-- Branch on the tops of the stacks `w` (in order). -/
def caseTops : List (Fin S) → (List (Option Sym) → Stmt S P) → Stmt S P
  | [], k => k []
  | i :: w, k => caseTop i (fun o => caseTops w (fun os => k (o :: os)))

def St.tops (σ : St S) (w : List (Fin S)) : List (Option Sym) := w.map σ.top

/-! ## Straight-line operations -/

inductive Op (S : ℕ) where
  | push (i : Fin S) (a : Sym)
  | pop (i : Fin S)
  | inRd (i : Fin S)
  | out (b : Bool)

def Op.stmt : Op S → Stmt S P
  | .push i a => .push i a
  | .pop i => .pop i
  | .inRd i => .inRd i
  | .out b => .out b

def Op.run (I : List Sym) : Op S → St S → St S
  | .push i a, σ => σ.push i a
  | .pop i, σ => σ.pop i
  | .inRd i, σ => σ.inRd I i
  | .out b, σ => σ.outB b

def opsStmt : List (Op S) → Stmt S P
  | [] => .skip
  | o :: l => .seq o.stmt (opsStmt l)

def runOps (I : List Sym) : List (Op S) → St S → St S
  | [], σ => σ
  | o :: l, σ => runOps I l (o.run I σ)

/-! ## Finite-state transducers -/

/-- The halting state of a `machine`. -/
def hlt : Sym := 15

/-- A transducer with state stack `q`, watching stacks `w`.  Each step looks at the state and at
the tops of `w` and performs `δ (state :: tops)`, which must replace the state symbol.  It starts
by pushing `q0` and stops when the state is `hlt`, which it then pops. -/
def machine (q : Fin S) (w : List (Fin S)) (q0 : Sym)
    (δ : List (Option Sym) → List (Op S)) : Stmt S P :=
  .seq (.push q q0) (.seq (.loop q (fun o => decide (o ≠ some hlt))
    (caseTops (q :: w) fun os => opsStmt (δ os))) (.pop q))

/-- One step of a transducer, as a function. -/
def mstep (I : List Sym) (q : Fin S) (w : List (Fin S)) (δ : List (Option Sym) → List (Op S))
    (σ : St S) : St S :=
  runOps I (δ (σ.tops (q :: w))) σ

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-- `m` transducer steps lead from `σ` to `σf`, never passing through the halting state. -/
def Reaches (I : List Sym) (q : Fin S) (w : List (Fin S)) (δ : List (Option Sym) → List (Op S))
    (σ σf : St S) (m : ℕ) : Prop :=
  (mstep I q w δ)^[m] σ = σf ∧ ∀ k < m, ((mstep I q w δ)^[k] σ).top q ≠ some hlt

namespace Reaches

variable {q : Fin S} {w : List (Fin S)} {δ : List (Option Sym) → List (Op S)}

end Reaches

end NLogN

end

