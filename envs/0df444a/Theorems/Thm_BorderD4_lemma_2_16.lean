-- title:
--   Lemma 2.16: one equation for each dependent coordinate
-- statement:
--   Let $L$ be a field and $p\subseteq L[x]$ a prime ideal. Let $T\subseteq[N]$ with $|T|=\dim L[x]/p$ and $p\cap L[x_T]=\{0\}$. For every $a\notin T$, the prime ideal $p\cap L[x_T,x_a]$ is generated by one irreducible polynomial $Q$ with
--   $$\deg_{x_a}Q\ge 1,\qquad \deg Q\le\mathrm{DEG}\,p.$$
--   These are the equations of the dependent coordinates in the proof of Theorem 6.7.
--
--   Differences from the source:
--   - encoding: the variables $x_1,\dots,x_N$ → an arbitrary finite nonempty index type; reason: any such type is $[N]$ up to renaming
--   - encoding: $\mathrm{DEG}$ as a number → the predicate `HasDEG I D`, with the conclusion $\exists D$; reason: no junk value can satisfy a bound; the Hilbert polynomial is asserted to exist
-- source:
--   A. Dey, P. Dutta, Z. Guo, An Exponential Top Fan-In Hierarchy for Border Depth-4 Circuits, STOC 2027 submission (manuscript sha256 518aaf99…), Lemma 2.16, p.34

import Mathlib
import Definitions.Def_BorderD4_HasDEG
set_option autoImplicit false

open MvPolynomial
open scoped PowerSeries

namespace BorderD4

/-- Lemma 2.16: for a prime `p ⊆ L[x]` and `T` with `|T| = dim L[x]/p` and `p ∩ L[x_T] = {0}`, and for every `a ∉ T`,
the prime `p ∩ L[x_T, x_a]` is generated by one irreducible polynomial `Q` with `deg_{x_a} Q ≥ 1` and `deg Q ≤ DEG p`.
Source: Dey, Dutta, Guo, An Exponential Top Fan-In Hierarchy for Border Depth-4 Circuits, STOC 2027 submission (manuscript sha256 518aaf99…), Lemma 2.16, p.34.

**Formalization Note** `L[x_T, x_a]` is the subalgebra `supported L (T ∪ {a})`, and `Q` lives in it. Irreducibility
and generation are in that ring, as on the page. -/
theorem lemma_2_16 {L σ : Type*} [Field L] [Fintype σ] [DecidableEq σ] [Nonempty σ]
    (p : Ideal (MvPolynomial σ L)) [p.IsPrime] (T : Finset σ)
    (hdim : ringKrullDim (MvPolynomial σ L ⧸ p) = ((T.card : ℕ) : WithBot ℕ∞))
    (hind : ∀ g ∈ supported L (T : Set σ), g ∈ p → g = 0) (a : σ) (ha : a ∉ T) :
    ∃ Q : supported L (↑(insert a T) : Set σ), Irreducible Q ∧
      p.comap (supported L (↑(insert a T) : Set σ)).val = Ideal.span {Q} ∧
      1 ≤ degreeOf a (Q : MvPolynomial σ L) ∧
      ∃ D, HasDEG p D ∧ (Q : MvPolynomial σ L).totalDegree ≤ D := by sorry

end BorderD4
