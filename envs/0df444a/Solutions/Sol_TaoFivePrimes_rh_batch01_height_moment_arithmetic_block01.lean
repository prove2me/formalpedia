    refine ⟨j,by simp only [List.length_zip,List.length_range,hx];omega,?_⟩
    rw [List.getElem_zip]
    simp only [List.getElem_range]
  have he := List.all_eq_true.mp hg (j,xs[j]) hm
  simp only [decide_eq_true_eq] at he
  have hm2 : ((j,xs[j]),ys[j])∈((List.range 16).zip xs).zip ys := by
    apply List.mem_iff_getElem.mpr
    refine ⟨j,by simp only [List.length_zip,List.length_range,hx,hy];omega,?_⟩
    rw [List.getElem_zip,List.getElem_zip]
    simp only [List.getElem_range]
  have h := List.all_eq_true.mp hc ((j,xs[j]),ys[j]) hm2
  have hh := List.all_eq_true.mp h k (List.mem_range.mpr hk)
  simp only [decide_eq_true_eq] at hh
  rw [he]
  exact hh
