theorem J6Seg.aLine_math (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
    ∀ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D), FitSpec6 P n src D M →
    ∀ (zs : List GI) (u : ((i : Fin (D + 1)) → ZMod (sD6 src D i)) → ℂ),
      RepPad (pP6 P n) (sD6 src D) (tD6 P n D) zs u → ‖u‖ ≤ 1 / 2 →
      zs.length = (List.ofFn (tD6 P n D)).prod ∧ GB (pP6 P n + 2) zs ∧
      RepFull (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs)
        (NLogN.KFY.wOf (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs)) ∧
      GB (pP6 P n + 2) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs) ∧
      ‖NLogN.KFY.wOf (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs) -
        tensCLM (kerA M.A) u‖ ≤ errW6 P n * hp (pP6 P n) := by sorry
