section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedVariables false
open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel AModelL12
variable {m : ℕ}
theorem solution {N : ℕ} [NeZero N] (A B Cs : AModel.Shape) (P L : ℕ) (T : NLogN.KIL.TSh m) (rX : Fin NLogN.HS)
    (hrX : 38 ≤ rX.val ∧ rX.val < 56)
    (hpos : ∀ a ∈ P :: L :: AModel.hdShape A B Cs m N, 1 ≤ a)
    (t : NLogN.IState NLogN.HS) (xs : List ℤ) (w Bb : ℕ) (R : List NLogN.Item) (hT : NLogN.KIL.TOK T N Bb)
    (hlen : xs.length = AModel.vol (P :: L :: AModel.hdShape A B Cs m N)) (hb : NLogN.Bnd w xs)
    (hV : NLogN.zsz ((AModel.vol (P :: L :: AModel.hdShape A B Cs m N) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : NLogN.zsz ((2 * N : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = NLogN.ints xs ++ R)
    {LN LQ LX LB LC : List NLogN.Item} (hNQ : t.G NLogN.KIL.sNQ = .int (-(N : ℤ)) :: LN)
    (hQQ : t.G NLogN.KIL.sQQ = .int (N : ℤ) :: LQ)
    (hX : t.G rX = .int ((AModel.vol (P :: L :: A) : ℕ) : ℤ) :: LX)
    (hB : t.G NLogN.KIL.rVB = .int ((AModel.vol B : ℕ) : ℤ) :: LB)
    (hC : t.G NLogN.KIL.rVC = .int ((AModel.vol Cs : ℕ) : ℤ) :: LC) :
    NLogN.KFD.FSp (NLogN.KIL.stepU m rX T) t
      (t.upd 0 (NLogN.ints ((T.eval N).arr ((AModel.hdLayout A B Cs m N).cons2 P L) 0 xs) ++ R))
      (NLogN.KFD.cStepGF T.k T.d (NLogN.KIL.stgT rX T).length (AModel.vol (P :: L :: AModel.hdShape A B Cs m N)) w Bb (NLogN.KIL.paT rX T)
        (NLogN.KIL.pcT T) (NLogN.KIL.stgT rX T)) := by
  set Λ := (AModel.hdLayout A B Cs m N).cons2 P L
  set c := T.ctrl N
  have hN1 : 1 ≤ N := Nat.pos_of_ne_zero (NeZero.ne N)
  have hP : ∀ a ∈ P :: L :: A, 1 ≤ a := fun a ha => hpos a (by
    simp only [List.mem_cons, AModel.hdShape, List.mem_append] at ha ⊢; tauto)
  have hBp : ∀ a ∈ B, 1 ≤ a := fun a ha => hpos a (by simp [AModel.hdShape, ha])
  have hCp : ∀ a ∈ Cs, 1 ≤ a := fun a ha => hpos a (by simp [AModel.hdShape, ha])
  have vX := NLogN.KIL.vol_pos_of hP
  have vB := NLogN.KIL.vol_pos_of hBp
  have vC := NLogN.KIL.vol_pos_of hCp
  -- register facts
  have pX : NLogN.KIL.PosE t (.reg rX) := ⟨NLogN.IState.isInt_of hX, by rw [NLogN.IState.top_eq hX]; exact_mod_cast vX⟩
  have pQ : NLogN.KIL.PosE t (.reg NLogN.KIL.sQQ) := ⟨NLogN.IState.isInt_of hQQ, by rw [NLogN.IState.top_eq hQQ]; exact_mod_cast hN1⟩
  have pB : NLogN.KIL.PosE t (.reg NLogN.KIL.rVB) := ⟨NLogN.IState.isInt_of hB, by rw [NLogN.IState.top_eq hB]; exact_mod_cast vB⟩
  have pC : NLogN.KIL.PosE t (.reg NLogN.KIL.rVC) := ⟨NLogN.IState.isInt_of hC, by rw [NLogN.IState.top_eq hC]; exact_mod_cast vC⟩
  have rXo : ∀ r ∈ (NLogN.Ex.reg rX : NLogN.Ex NLogN.HS).regs, NLogN.KIL.RdOK r := NLogN.KIL.rd_reg (Or.inr hrX)
  have rQo : ∀ r ∈ (NLogN.Ex.reg NLogN.KIL.sQQ : NLogN.Ex NLogN.HS).regs, NLogN.KIL.RdOK r := NLogN.KIL.rd_reg (Or.inl rfl)
  have rBo : ∀ r ∈ (NLogN.Ex.reg NLogN.KIL.rVB : NLogN.Ex NLogN.HS).regs, NLogN.KIL.RdOK r := NLogN.KIL.rd_reg (Or.inr ⟨by decide, by decide⟩)
  have rCo : ∀ r ∈ (NLogN.Ex.reg NLogN.KIL.rVC : NLogN.Ex NLogN.HS).regs, NLogN.KIL.RdOK r := NLogN.KIL.rd_reg (Or.inr ⟨by decide, by decide⟩)
  have tX := NLogN.IState.top_eq hX
  have tQ := NLogN.IState.top_eq hQQ
  have tB := NLogN.IState.top_eq hB
  have tC := NLogN.IState.top_eq hC
  have eX : (NLogN.Ex.reg rX : NLogN.Ex NLogN.HS).eval t = ((AModel.vol (P :: L :: A) : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq hX]
  have eQ : (NLogN.Ex.reg NLogN.KIL.sQQ : NLogN.Ex NLogN.HS).eval t = (N : ℤ) := by
    simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq hQQ]
  have eB : (NLogN.Ex.reg NLogN.KIL.rVB : NLogN.Ex NLogN.HS).eval t = ((AModel.vol B : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq hB]
  have eC : (NLogN.Ex.reg NLogN.KIL.rVC : NLogN.Ex NLogN.HS).eval t = ((AModel.vol Cs : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq hC]
  have rM : ∀ {a b : NLogN.Ex NLogN.HS}, (∀ r ∈ a.regs, NLogN.KIL.RdOK r) → (∀ r ∈ b.regs, NLogN.KIL.RdOK r) →
      ∀ r ∈ (NLogN.Ex.mul a b).regs, NLogN.KIL.RdOK r := fun ha hb r hr => by
    simp only [NLogN.Ex.regs, List.mem_append] at hr
    rcases hr with hr | hr
    · exact ha r hr
    · exact hb r hr
  have hX0 : ((NLogN.Ex.reg rX : NLogN.Ex NLogN.HS), (NLogN.Ex.lit 0 : NLogN.Ex NLogN.HS)).1.eval t = ((AModel.vol (P :: L :: A) : ℕ) : ℤ) := eX
  have sX : NLogN.KIL.StgE t Bb (NLogN.Ex.reg rX, NLogN.Ex.lit 0) := ⟨pX, rXo, NLogN.KIL.goodE_lit0⟩
  have sB : NLogN.KIL.StgE t Bb (NLogN.Ex.reg NLogN.KIL.rVB, NLogN.Ex.lit 0) := ⟨pB, rBo, NLogN.KIL.goodE_lit0⟩
  by_cases hi : (T.i : ℕ) < m
  · -- H case
    obtain ⟨a, ha⟩ : ∃ a, (T.i : ℕ) = a := ⟨_, rfl⟩
    have hia : a < m := ha ▸ hi
    set A' := P :: L :: (A ++ List.replicate a N)
    set C' := List.replicate (m - 1 - a) N ++ (B ++ (List.replicate m N ++ Cs))
    have hrep : List.replicate m N = List.replicate a N ++ N :: List.replicate (m - 1 - a) N := by
      rw [← List.replicate_succ, ← List.replicate_add]; congr 1; omega
    have hsh : P :: L :: AModel.hdShape A B Cs m N = A' ++ N :: C' := by
      simp only [AModel.hdShape, A', C']; rw [hrep]; simp
    have hA : (Λ.pos T.i : ℕ) = A'.length := by
      rw [NLogN.KIL.posL]; simp [A', AModel.hdPos, hi]; omega
    set ac : List (ℕ × ℕ) := (AModel.vol (P :: L :: A), 0) :: (List.range a).map fun j => (N, NLogN.KIL.cv c j)
    have hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < N := by
      intro p hp
      simp only [ac, List.mem_cons, List.mem_map] at hp
      rcases hp with rfl | ⟨j, _, rfl⟩
      · exact ⟨vX, hN1⟩
      · exact ⟨hN1, NLogN.KIL.cv_lt c j⟩
    have hvol : AModel.vol (ac.map Prod.fst) = AModel.vol A' := by
      simp only [ac, A', List.map_cons, List.map_map]
      rw [show (Prod.fst ∘ fun j => (N, NLogN.KIL.cv c j)) = fun _ => N from rfl, NLogN.KIL.map_range_const]
      simp only [AModel.vol_cons, AModel.vol_append, AModel.vol_replicate]; ring
    have htbl := (NLogN.KIL.collH A B Cs P L c hia.le).symm
    have epa : (NLogN.KIL.paT rX T).eval t = ((AModel.vol A' : ℕ) : ℤ) := by
      simp only [NLogN.KIL.paT, ha, if_pos hia, NLogN.Ex.eval, NLogN.KIL.powE_eval, tX, tQ, tB, tC, eX, eQ, A', AModel.vol_cons, AModel.vol_append,
        AModel.vol_replicate]
      push_cast; ring
    have epc : (NLogN.KIL.pcT T).eval t = ((AModel.vol C' : ℕ) : ℤ) := by
      simp only [NLogN.KIL.pcT, ha, if_pos hia, NLogN.Ex.eval, NLogN.KIL.powE_eval, tX, tQ, tB, tC, eB, eQ, eC, C', AModel.vol_append,
        AModel.vol_replicate]
      push_cast; ring
    have hctl : ∀ j ∈ List.range a, NLogN.KIL.StgE t Bb (NLogN.KIL.ctE T j) ∧ (NLogN.KIL.ctE T j).1.eval t = N ∧
        (NLogN.KIL.ctE T j).2.eval t = ((NLogN.KIL.cv c j : ℕ) : ℤ) := fun j hj =>
      NLogN.KIL.ctE_facts hQQ hN1 T hT (by have := List.mem_range.1 hj; omega)
    have hsA : (NLogN.KIL.stgT rX T).map (·.1.eval t) = ac.map fun p => (p.1 : ℤ) := by
      simp only [NLogN.KIL.stgT, ha, if_pos hia, ac, List.map_cons, List.map_map, hX0, Function.comp_def]
      congr 1
      refine List.map_congr_left fun j hj => ?_
      simp [(hctl j hj).2.1]
    have hsC : (NLogN.KIL.stgT rX T).map (·.2.eval t) = ac.map fun p => (p.2 : ℤ) := by
      simp only [NLogN.KIL.stgT, ha, if_pos hia, ac, List.map_cons, List.map_map, Function.comp_def]
      congr 1
      refine List.map_congr_left fun j hj => ?_
      simp [(hctl j hj).2.2]
    have hVS : AModel.vol A' * (N * AModel.vol C') = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) := by
      rw [hsh, AModel.vol_append A' (N :: C'), AModel.vol_cons N C']
    have hstg : ∀ p ∈ NLogN.KIL.stgT rX T, NLogN.KIL.StgE t Bb p := by
      intro p hp
      simp only [NLogN.KIL.stgT, ha, if_pos hia, List.mem_cons, List.mem_map] at hp
      rcases hp with rfl | ⟨j, hj, rfl⟩
      · exact sX
      · exact (hctl j hj).1
    have hprod : ((NLogN.KIL.stgT rX T).map (·.1.eval t)).prod ≤ (AModel.vol (P :: L :: AModel.hdShape A B Cs m N) : ℤ) := by
      rw [hsA, NLogN.KIL.prod_cast_vol, hvol, ← hVS]
      exact_mod_cast Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (NLogN.KIL.vol_pos_of (by
        intro x hx; exact hpos x (by rw [hsh]; simp [hx]))))
    have hok := NLogN.KIL.pushOK_step hV hQQ hN1 (NLogN.KIL.paT rX T) (NLogN.KIL.pcT T)
      (by simp only [NLogN.KIL.paT, ha, if_pos hia]; exact ⟨pX, NLogN.KIL.powE_pos pQ _⟩)
      (by simp only [NLogN.KIL.paT, ha, if_pos hia]; exact rM rXo (NLogN.KIL.powE_regs _ _ rQo)) epa
      (by simp only [NLogN.KIL.pcT, ha, if_pos hia]; exact ⟨NLogN.KIL.powE_pos pQ _, pB, NLogN.KIL.powE_pos pQ _, pC⟩)
      (by simp only [NLogN.KIL.pcT, ha, if_pos hia]; exact rM (NLogN.KIL.powE_regs _ _ rQo) (rM rBo (rM (NLogN.KIL.powE_regs _ _ rQo) rCo)))
      epc hVS.le (NLogN.KIL.stgT rX T) hstg (by exact_mod_cast hprod)
    have S := NLogN.KFD.stepG_fspec Λ T.i c (NLogN.KIL.ctrl_zero T) A' C' hsh hA T.k T.d T.neg hT.k1 hT.kN hT.d1 hT.dN
      hT.ck hT.cd t xs w Bb R hlen hb (NLogN.KIL.vol_pos_of (by
        intro x hx; exact hpos x (by rw [hsh]; simp [hx]))) hN1
      (NLogN.KIL.vol_pos_of (by intro x hx; exact hpos x (by rw [hsh]; simp [hx]))) (by rw [hVS]; exact hV)
      hQ2 h0 (NLogN.KIL.paT rX T) (NLogN.KIL.pcT T) (NLogN.KIL.stgT rX T) ac hac hvol htbl hNQ hQQ epa epc hsA hsC hok
    rw [hVS] at S
    exact S
  · -- D case
    have hi2 := T.i.2
    obtain ⟨b, hb'⟩ : ∃ b, (T.i : ℕ) - m = b := ⟨_, rfl⟩
    have hbm : b < m := by omega
    have hb3 : m + m - 1 - (T.i : ℕ) = m - 1 - b := by omega
    set A' := P :: L :: (A ++ (List.replicate m N ++ (B ++ List.replicate b N)))
    set C' := List.replicate (m - 1 - b) N ++ Cs
    have hrep : List.replicate m N = List.replicate b N ++ N :: List.replicate (m - 1 - b) N := by
      rw [← List.replicate_succ, ← List.replicate_add]; congr 1; omega
    have hsh : P :: L :: AModel.hdShape A B Cs m N = A' ++ N :: C' := by
      have e : A ++ (List.replicate m N ++ (B ++ (List.replicate m N ++ Cs))) =
          A ++ (List.replicate m N ++ (B ++ ((List.replicate b N ++ N ::
            List.replicate (m - 1 - b) N) ++ Cs))) := by rw [← hrep]
      simp only [AModel.hdShape, A', C', e]; simp
    have hA : (Λ.pos T.i : ℕ) = A'.length := by
      rw [NLogN.KIL.posL]; simp [A', AModel.hdPos, hi]; omega
    set ac : List (ℕ × ℕ) := (AModel.vol (P :: L :: A), 0) :: ((List.range m).map fun j => (N, NLogN.KIL.cv c j)) ++
        (AModel.vol B, 0) :: (List.range b).map fun j => (N, NLogN.KIL.cv c (m + j))
    have hac : ∀ p ∈ ac, 1 ≤ p.1 ∧ p.2 < N := by
      intro p hp
      simp only [ac, List.cons_append, List.mem_cons, List.mem_append, List.mem_map] at hp
      rcases hp with rfl | ⟨j, _, rfl⟩ | rfl | ⟨j, _, rfl⟩
      · exact ⟨vX, hN1⟩
      · exact ⟨hN1, NLogN.KIL.cv_lt c j⟩
      · exact ⟨vB, hN1⟩
      · exact ⟨hN1, NLogN.KIL.cv_lt c _⟩
    have hvol : AModel.vol (ac.map Prod.fst) = AModel.vol A' := by
      simp only [ac, A', List.map_cons, List.map_append, List.map_map, List.cons_append]
      rw [show (Prod.fst ∘ fun j => (N, NLogN.KIL.cv c j)) = fun _ => N from rfl,
        show (Prod.fst ∘ fun j => (N, NLogN.KIL.cv c (m + j))) = fun _ => N from rfl, NLogN.KIL.map_range_const,
        NLogN.KIL.map_range_const]
      simp only [AModel.vol_cons, AModel.vol_append, AModel.vol_replicate]; ring
    have htbl := (NLogN.KIL.collD A B Cs P L c hbm.le).symm
    have epa : (NLogN.KIL.paT rX T).eval t = ((AModel.vol A' : ℕ) : ℤ) := by
      simp only [NLogN.KIL.paT, if_neg hi, hb', hb3, NLogN.Ex.eval, NLogN.KIL.powE_eval, tX, tQ, tB, tC, eX, eQ, eB, A', AModel.vol_cons, AModel.vol_append,
        AModel.vol_replicate]
      push_cast; ring
    have epc : (NLogN.KIL.pcT T).eval t = ((AModel.vol C' : ℕ) : ℤ) := by
      simp only [NLogN.KIL.pcT, if_neg hi, hb', hb3, NLogN.Ex.eval, NLogN.KIL.powE_eval, tX, tQ, tB, tC, eQ, eC, C', AModel.vol_append, AModel.vol_replicate]
      push_cast; ring
    have hctl : ∀ j ∈ List.range m, NLogN.KIL.StgE t Bb (NLogN.KIL.ctE T j) ∧ (NLogN.KIL.ctE T j).1.eval t = N ∧
        (NLogN.KIL.ctE T j).2.eval t = ((NLogN.KIL.cv c j : ℕ) : ℤ) := fun j hj =>
      NLogN.KIL.ctE_facts hQQ hN1 T hT (by have := List.mem_range.1 hj; omega)
    have hctl2 : ∀ j ∈ List.range b, NLogN.KIL.StgE t Bb (NLogN.KIL.ctE T (m + j)) ∧ (NLogN.KIL.ctE T (m + j)).1.eval t = N ∧
        (NLogN.KIL.ctE T (m + j)).2.eval t = ((NLogN.KIL.cv c (m + j) : ℕ) : ℤ) := fun j hj =>
      NLogN.KIL.ctE_facts hQQ hN1 T hT (by have := List.mem_range.1 hj; omega)
    have hsA : (NLogN.KIL.stgT rX T).map (·.1.eval t) = ac.map fun p => (p.1 : ℤ) := by
      simp only [NLogN.KIL.stgT, if_neg hi, hb', ac, List.map_cons, List.map_append, List.map_map,
        List.cons_append, hX0, Function.comp_def]
      congr 1
      congr 1
      · refine List.map_congr_left fun j hj => ?_
        simp [(hctl j hj).2.1]
      congr 1
      refine List.map_congr_left fun j hj => ?_
      simp [(hctl2 j hj).2.1]
    have hsC : (NLogN.KIL.stgT rX T).map (·.2.eval t) = ac.map fun p => (p.2 : ℤ) := by
      simp only [NLogN.KIL.stgT, if_neg hi, hb', ac, List.map_cons, List.map_append, List.map_map,
        List.cons_append, Function.comp_def]
      congr 1
      congr 1
      · refine List.map_congr_left fun j hj => ?_
        simp [(hctl j hj).2.2]
      congr 1
      refine List.map_congr_left fun j hj => ?_
      simp [(hctl2 j hj).2.2]
    have hVS : AModel.vol A' * (N * AModel.vol C') = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) := by
      rw [hsh, AModel.vol_append A' (N :: C'), AModel.vol_cons N C']
    have hstg : ∀ p ∈ NLogN.KIL.stgT rX T, NLogN.KIL.StgE t Bb p := by
      intro p hp
      simp only [NLogN.KIL.stgT, if_neg hi, hb', hb3, List.mem_cons, List.mem_append, List.mem_map] at hp
      rcases hp with rfl | ⟨j, hj, rfl⟩ | rfl | ⟨j, hj, rfl⟩
      · exact sX
      · exact (hctl j hj).1
      · exact sB
      · exact (hctl2 j hj).1
    have hC1 : 1 ≤ AModel.vol C' := NLogN.KIL.vol_pos_of (by
      intro x hx; exact hpos x (by rw [hsh]; simp [hx]))
    have hprod : ((NLogN.KIL.stgT rX T).map (·.1.eval t)).prod ≤ (AModel.vol (P :: L :: AModel.hdShape A B Cs m N) : ℤ) := by
      rw [hsA, NLogN.KIL.prod_cast_vol, hvol, ← hVS]
      exact_mod_cast Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) hC1)
    have hok := NLogN.KIL.pushOK_step hV hQQ hN1 (NLogN.KIL.paT rX T) (NLogN.KIL.pcT T)
      (by simp only [NLogN.KIL.paT, if_neg hi, hb', hb3]; exact ⟨pX, NLogN.KIL.powE_pos pQ _, pB, NLogN.KIL.powE_pos pQ _⟩)
      (by simp only [NLogN.KIL.paT, if_neg hi, hb', hb3]; exact rM rXo (rM (NLogN.KIL.powE_regs _ _ rQo) (rM rBo (NLogN.KIL.powE_regs _ _ rQo))))
      epa
      (by simp only [NLogN.KIL.pcT, if_neg hi, hb', hb3]; exact ⟨NLogN.KIL.powE_pos pQ _, pC⟩)
      (by simp only [NLogN.KIL.pcT, if_neg hi, hb', hb3]; exact rM (NLogN.KIL.powE_regs _ _ rQo) rCo)
      epc hVS.le (NLogN.KIL.stgT rX T) hstg (by exact_mod_cast hprod)
    have S := NLogN.KFD.stepG_fspec Λ T.i c (NLogN.KIL.ctrl_zero T) A' C' hsh hA T.k T.d T.neg hT.k1 hT.kN hT.d1 hT.dN
      hT.ck hT.cd t xs w Bb R hlen hb hC1 hN1
      (NLogN.KIL.vol_pos_of (by intro x hx; exact hpos x (by rw [hsh]; simp [hx]))) (by rw [hVS]; exact hV)
      hQ2 h0 (NLogN.KIL.paT rX T) (NLogN.KIL.pcT T) (NLogN.KIL.stgT rX T) ac hac hvol htbl hNQ hQQ epa epc hsA hsC hok
    rw [hVS] at S
    exact S
end
