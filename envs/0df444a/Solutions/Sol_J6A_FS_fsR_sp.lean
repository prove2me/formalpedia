theorem RB_of {W : ℕ} {v : Vr} {c : Cs} {e : Ex HS} (hv : BV W v)
    (ho : ∀ j ∈ e.regs, j ∉ rg → |(c j).headD 0| ≤ 2 ^ W) : RB W v c e := by
  intro j hj
  by_cases h : j ∈ rg
  · simp only [tp, if_pos h]; exact hv j h
  · simp only [tp, if_neg h]; exact ho j hj h

section steps
variable {v : Vr} {c : Cs} {W : ℕ}

/-- Push. -/
theorem Rn.push {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (hR : Rd c e)
    (hc : e.Clean) (ho : okR v c e) (ht : Tame (2 ^ W) e) (hb : RB W v c e) :
    Rn (.push i e) v c (· = v) (Function.update c i (ev v c e :: c i)) (cT e W) :=
  ⟨_, rfl, fun s => sU s v c hi hi5 hR hc ho hb (mg_lt ht)⟩

