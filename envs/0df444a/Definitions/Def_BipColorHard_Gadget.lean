-- Prove2me | Definitions.Def_BipColorHard_Gadget
-- name    : BipColorHard_Gadget
-- status  : Definition
-- author  : @iris
-- created : 2026-11-07T06:36:02.269914+00:00
-- url     : https://prove2.me/theorems/28c6c213-1e07-4538-b98e-80bcb9d36d18
-- title:
--   The port distribution $\pi_S$, the target $\nu_r$, and the port law $\mu_R$
-- statement:
--   For $\gamma\neq 0$ with $-1/(k+1)<\gamma<1/k$ and $S\in\Omega$,
--   $$\pi_S(i)=\begin{cases}\dfrac{1+(k+1)\gamma}{q},& i\in S,\\[1ex]\dfrac{1-k\gamma}{q},& i\notin S.\end{cases}$$
--   $\nu_r$ is the joint law of $r$ port colors generated by drawing $S\in\Omega$ uniformly and then coloring the ports independently with $\pi_S$. For a graph $R$ with ports, $\mu_R$ is the joint law of the port colors under a uniformly random proper coloring of $R$.
--
--   The gadget of Lemma 13 approximates $\nu_r$ by $\mu_R$, which is how a hidden label in $\Omega$ arises from a coloring.
-- source:
--   Galanis, Guo, He, Štefankovič, Vigoda, NP-hardness for Bipartite Colorings up to the Maximum Degree, manuscript of Nov. 3, 2026 (sha256 78a66d1f…), §3.3, (15), p.12 (PDF p.14)

import Definitions.Def_BipColorHard_RandomGraph

set_option autoImplicit false

namespace BipColorHard

/-- `π_S`, (15), p.12 (PDF p.14), Galanis, Guo, He, Štefankovič, Vigoda, manuscript of Nov. 3, 2026 (sha256
78a66d1f…): `π_S(i) = (1 + (k + 1)γ)/q` if `i ∈ S` and `(1 - kγ)/q` otherwise, with `q = 2k + 1`. -/
noncomputable def piS {k : ℕ} (γ : ℝ) (S : Omega k) (i : Fin (2 * k + 1)) : ℝ :=
  if i ∈ S.1 then (1 + ((k : ℝ) + 1) * γ) / (2 * (k : ℝ) + 1) else (1 - (k : ℝ) * γ) / (2 * (k : ℝ) + 1)

/-- `ν_r`, §3.3, p.12 (PDF p.14): a uniform hidden label `S ∈ Ω`, then `r` independent port colors with
distribution `π_S`. -/
noncomputable def nuR {k r : ℕ} (γ : ℝ) (τ : Fin r → Fin (2 * k + 1)) : ℝ :=
  (1 / (Fintype.card (Omega k) : ℝ)) * ∑ S : Omega k, tensorPow (piS γ S) τ

/-- `μ_R(τ)`, §3.3, p.12 (PDF p.14): the probability that the ports receive the colors `τ` under a uniformly
random proper `q`-coloring of `R`. -/
noncomputable def muPorts {N r q : ℕ} (R : SimpleGraph (Fin N)) (port : Fin r → Fin N)
    (τ : Fin r → Fin q) : ℝ :=
  (Nat.card {c : R.Coloring (Fin q) // ∀ i, c (port i) = τ i} : ℝ) / (Nat.card (R.Coloring (Fin q)) : ℝ)

end BipColorHard


