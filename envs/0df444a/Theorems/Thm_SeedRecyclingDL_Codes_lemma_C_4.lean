-- title:
--   Lemma C.4 — Selection and ranking
-- statement:
--   Let $B$ be a distinct increasing list of indices in $\{0,\ldots,Q-1\}$, and let $G$ be its complement in that order. For $1\le v\le|G|$, the actual Select scan returns the $v$-th element of $G$. Rank is defined for every index $a<Q$, returns failure exactly on $B$, and otherwise returns its one-based rank in $G$.
--   $$\operatorname{comparisons}(\operatorname{Select})=O(|B|+1),\qquad
--   \operatorname{comparisons}(\operatorname{Rank})=O(\log_2(|B|+2)).$$
--   The counts are generated by the scan and binary search, including the empty-bad-list case. Field order is recovered by taking indices through $\iota$; the theorem applies to every finite ordered index universe.
--
--   Differences from the source:
--   - generalization: field elements ordered through their binary indices → all finite integer index universes Q, including Q=0; reason: taking Q=2^b and the field index bijection gives the full source theorem
-- source:
--   Quan D. Bui, Manabu Hagiwara, Shuche Wang, Van Khu Vu, STOC 2027 submission #1449 (October 2026), Lemma C.4, printed p. 19 (PDF p. 21); https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/1449.pdf

import Definitions.Def_SeedRecyclingDL_Codes_FieldExecution

set_option autoImplicit false

namespace SeedRecyclingDL.Codes

theorem lemma_C_4 :
    ∃ C : ℝ, 0 < C ∧ ∀ (Q : ℕ) (B : List ℕ),
      B.Pairwise (· < ·) → (∀ a ∈ B, a < Q) →
      let G := (List.range Q).filter fun a => a ∉ B
      (∀ v : ℕ, 1 ≤ v → v ≤ G.length →
        G[v - 1]? = some (selectIndex B v).1 ∧
        ((selectIndex B v).2 : ℝ) ≤ C * (B.length + 1 : ℕ)) ∧
      (∀ a : ℕ, a < Q →
        ((rankIndex B a).1 = none ↔ a ∈ B) ∧
        (a ∉ B → (rankIndex B a).1 = some ((G.filter (· < a)).length + 1)) ∧
        ((rankIndex B a).2 : ℝ) ≤ C * log₂ (B.length + 2)) := by sorry

end SeedRecyclingDL.Codes
