-- title:
--   Kernel of the stalk map of a scheme fibre immersion
-- statement:
--   Let $R$ be a commutative ring, let $X$ be a scheme (in the bottom universe), let $f \colon X \to \operatorname{Spec} R$ be a morphism of schemes, let $s$ be a point of $\operatorname{Spec} R$, and let $q$ be a point of the fibre $f^{-1}(s)$ in Mathlib's sense (`f.fiber s`, the base change of $f$ along the canonical morphism from the spectrum of the residue field at $s$), with $\iota_s \colon f^{-1}(s) \to X$ the canonical morphism `f.fiberι s`. Write $x := \iota_s(q)$ for the image of $q$ in $X$ and $y := f(x)$ for its image in $\operatorname{Spec} R$. The assertion is an equality of ideals of the local ring $\mathcal{O}_{X,x}$: the kernel of the ring homomorphism $\mathcal{O}_{X,x} \to \mathcal{O}_{f^{-1}(s),q}$ obtained as the stalk map of $\iota_s$ at $q$ coincides with the ideal generated by the image of the maximal ideal $\mathfrak{m}_{\operatorname{Spec} R, y}$ of the stalk of $\operatorname{Spec} R$ at $y$ under the stalk map $\mathcal{O}_{\operatorname{Spec} R, y} \to \mathcal{O}_{X,x}$ of $f$ at $x$, i.e. with $\mathfrak{m}_{y}\,\mathcal{O}_{X,x}$.
--
--   This is the kernel form of the standard computation of the stalks of a scheme-theoretic fibre, namely $\mathcal{O}_{f^{-1}(s),q} \cong \mathcal{O}_{X,x}/\mathfrak{m}_{f(x)}\mathcal{O}_{X,x}$, the identification of the kernel being the content that is not already recorded by surjectivity of the stalk maps of $\iota_s$. It is used in the study of flatness and smoothness of morphisms fibrewise, in particular for the flatness and local structure arguments for integral models of modular curves.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicGeometry_ker_fiberIota_stalkMap_eq_maximalIdeal_map.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory AlgebraicGeometry

theorem AlgebraicGeometry.ker_fiberIota_stalkMap_eq_maximalIdeal_map
    {R : Type} [CommRing R] {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of R))
    (s : Spec (CommRingCat.of R)) (q : f.fiber s) :
    RingHom.ker ((f.fiberι s).stalkMap q).hom =
      (IsLocalRing.maximalIdeal
        ((Spec (CommRingCat.of R)).presheaf.stalk (f.base ((f.fiberι s).base q)))).map
        (f.stalkMap ((f.fiberι s).base q)).hom := by sorry
