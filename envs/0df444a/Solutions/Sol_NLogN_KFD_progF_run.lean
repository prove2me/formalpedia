      by_cases hx0 : x = 0
      · subst hx0; simp +decide [u2, u, entS]
      simp [u2, u, entS, hx, hx2, hx0]
    · simp [u2, u, entS]
    · simp [u2, u, entS]
  rw [e] at S3
  refine (S1.seq (S2.seq S3)).mono (le_of_eq ?_)
  unfold cExit; simp only [Ex.size, entV, List.length_cons, List.length_nil]; omega

section FrameLe

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

theorem frameSum_le (f g : M → ℕ) (h : ∀ a, f a ≤ g a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum f gates lab Mout ≤ frameSum g gates lab Mout
  | [], lab, Mout => Finset.sum_le_sum fun w _ => h _
  | g' :: gs, lab, Mout => by
    simp only [frameSum]
    exact Nat.add_le_add (Finset.sum_le_sum fun w _ => h _) (frameSum_le f g h gs _ Mout)

end FrameLe

