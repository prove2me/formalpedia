theorem igusa_node_of_jResidue
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    {FI : Type} [Field FI] [Algebra (ResidueField ↥A) FI] [IsCurveOver (ResidueField ↥A) FI] [Algebra.EssFiniteType (ResidueField ↥A) FI]
    (C : ComponentChart A (fieldBar q M') FI) (N : Finset (Place (ResidueField ↥A) FI))
    (j : modularFunctionFieldC (ResidueField ↥A) M' →+* FI)
    (hjκ : ∀ c : ResidueField ↥A, j (algebraMap (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M') c) = algebraMap (ResidueField ↥A) FI c)
    (hj : ∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      ∃ hC : (IntermediateField.inclusion hle f : fieldBar q M') ∈ C.integers, C.residue ⟨_, hC⟩ = j (R₀.residue ⟨f, hf⟩))
    (hN : ∀ Q : Place (ResidueField ↥A) FI, Q ∈ N ↔ ∃ s : ↥W, ∀ g' : modularFunctionFieldC (ResidueField ↥A) M',
      g' ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring ↔ j g' ∈ Q.toValuationSubring)
    (s : ↥W) (a : ↥A) (hja : (((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) -
          algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') (a : AlgebraicClosure ℚ)) ∈ R₀.integers)
    (h0 : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hja⟩ : modularFunctionFieldC (ResidueField A) M') = 0)
    (hmem : (R₀.residue ⟨_, hja⟩ : modularFunctionFieldC (ResidueField A) M') ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring)
    (Q : Place (ResidueField ↥A) FI)
    (hC : (IntermediateField.inclusion hle (((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) -
          algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') (a : AlgebraicClosure ℚ)) : ↥(fieldBar q M')) ∈ C.integers)
    (hm : C.residue ⟨_, hC⟩ ∈ Q.toValuationSubring)
    (hres0 : IsLocalRing.residue ↥Q.toValuationSubring ⟨C.residue ⟨_, hC⟩, hm⟩ = 0) :
    Q ∈ N := by
  classical
  haveI hκac : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField_of_isAlgClosed A
  haveI hκch : CharP (ResidueField ↥A) q := ValuationSubring.residueField_charP_of_liesOverPrime A (Fact.out : q.Prime) hA
  have heqF : modularFunctionFieldC (ResidueField ↥A) M' = modularFunctionFieldFullC (ResidueField ↥A) M' :=
    modularFunctionFieldC_eq_modularFunctionFieldFullC (ResidueField ↥A) q M' hqM'
  obtain ⟨hIC, hEF⟩ := transport_of_eq' (K := (ResidueField ↥A)) heqF
  haveI : IsCurveOver (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M') := hIC (isCurveOver_modularFunctionFieldFullC (ResidueField ↥A) M')
  haveI : Algebra.EssFiniteType (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M') := hEF (essFiniteType_modularFunctionFieldFullC (ResidueField ↥A) M')
  letI alg : Algebra ↥(modularFunctionFieldC (ResidueField ↥A) M') FI := j.toAlgebra
  have halg : ∀ x : ↥(modularFunctionFieldC (ResidueField ↥A) M'), algebraMap ↥(modularFunctionFieldC (ResidueField ↥A) M') FI x = j x := fun _ => rfl
  haveI hst : IsScalarTower (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M') FI := IsScalarTower.of_algebraMap_eq (fun c => by rw [halg, hjκ])
  haveI : Algebra.IsIntegral ↥(modularFunctionFieldC (ResidueField ↥A) M') FI := (isAlgebraic_of_ringHom_curve (κ := (ResidueField ↥A)) (F₀ := ↥(modularFunctionFieldC (ResidueField ↥A) M')) (F := FI)).isIntegral

  have hcoeff : coeffMap A.subtype (jqModC ↥A) = coeffEmb (AlgebraicClosure ℚ) jq := by
    ext k
    rw [coeffMap_coeff, coeffEmb_coeff, ← jqModC_rat, jqModC_eq_map_intCast ↥A, jqModC_eq_map_intCast ℚ,
      HahnSeries.map_coeff, HahnSeries.map_coeff]
    simp
  have hjmemL : coeffMap A.subtype (jqModC ↥A) ∈ modularFunctionFieldBar M' := by
    rw [hcoeff]; exact coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))
  obtain ⟨hjO', hjres'⟩ := hR₀ (jqModC ↥A) hjmemL
  have hjeq : ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) = ⟨coeffMap A.subtype (jqModC ↥A), hjmemL⟩ := Subtype.ext hcoeff.symm
  have hjO : ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) ∈ R₀.integers := by rw [hjeq]; exact hjO'
  have hjres : R₀.residue ⟨((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')), hjO⟩ = jGeomGen (ResidueField ↥A) M' := by
    have h1 : R₀.residue ⟨((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')), hjO⟩ = R₀.residue ⟨_, hjO'⟩ := by congr 1; exact Subtype.ext hjeq
    rw [h1]
    apply Subtype.ext
    rw [hjres', coe_jGeomGen, jqModC_eq_map_intCast (ResidueField ↥A), jqModC_eq_map_intCast ↥A]
    ext k
    rw [coeffMap_coeff, HahnSeries.map_coeff, HahnSeries.map_coeff]
    simp
  have haO : algebraMap (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') (a : AlgebraicClosure ℚ) ∈ R₀.integers :=
    (R₀.algebraMap_mem_iff a).mpr a.2
  set g : ↥(modularFunctionFieldC (ResidueField ↥A) M') := R₀.residue ⟨_, hja⟩ with hgdef
  have hgeq : g = jGeomGen (ResidueField ↥A) M' - algebraMap (ResidueField ↥A) _ (IsLocalRing.residue ↥A a) := by
    have : (⟨_, hja⟩ : R₀.integers) = ⟨_, hjO⟩ - ⟨_, haO⟩ := Subtype.ext rfl
    rw [hgdef, this, map_sub, hjres, R₀.residue_algebraMap]

  have hCg : C.residue ⟨_, hC⟩ = j g := by
    obtain ⟨hC', e⟩ := hj _ hja
    exact e

  set s' : Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M') := Q.restrict ↥(modularFunctionFieldC (ResidueField ↥A) M') with hs'def
  have hs'iff : ∀ g' : ↥(modularFunctionFieldC (ResidueField ↥A) M'), g' ∈ s'.toValuationSubring ↔ j g' ∈ Q.toValuationSubring := fun g' => Place.mem_restrict_iff (w := Q)
  have hgs' : g ∈ s'.toValuationSubring := (hs'iff g).mpr (by rw [← hCg]; exact hm)

  have hg𝔪 : (⟨g, hgs'⟩ : s'.toValuationSubring) ∈ maximalIdeal _ := by
    by_contra hnot
    have hu : IsUnit (⟨g, hgs'⟩ : s'.toValuationSubring) := by
      by_contra hnu; exact hnot ((IsLocalRing.mem_maximalIdeal _).mpr hnu)
    obtain ⟨v, hv⟩ := IsUnit.exists_right_inv hu
    have hvQ : j (v : ↥(modularFunctionFieldC (ResidueField ↥A) M')) ∈ Q.toValuationSubring := (hs'iff _).mp v.2
    have hprod : j g * j (v : ↥(modularFunctionFieldC (ResidueField ↥A) M')) = 1 := by rw [← map_mul, show g * (v : ↥(modularFunctionFieldC (ResidueField ↥A) M')) = 1 from congrArg Subtype.val hv, map_one]
    have huQ : IsUnit (⟨C.residue ⟨_, hC⟩, hm⟩ : Q.toValuationSubring) := by
      refine isUnit_iff_exists_inv.mpr ⟨⟨j (v : ↥(modularFunctionFieldC (ResidueField ↥A) M')), hvQ⟩, Subtype.ext ?_⟩
      show C.residue ⟨_, hC⟩ * j (v : ↥(modularFunctionFieldC (ResidueField ↥A) M')) = 1
      rw [hCg]; exact hprod
    have : (⟨C.residue ⟨_, hC⟩, hm⟩ : Q.toValuationSubring) ∈ maximalIdeal _ := (IsLocalRing.residue_eq_zero_iff _).mp hres0
    exact ((IsLocalRing.mem_maximalIdeal _).mp this) huQ
  have hresg : IsLocalRing.residue _ (⟨g, hgs'⟩ : s'.toValuationSubring) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hg𝔪

  have hjs' : jGeomGen (ResidueField ↥A) M' ∈ s'.toValuationSubring := by
    have : jGeomGen (ResidueField ↥A) M' = g + algebraMap (ResidueField ↥A) _ (IsLocalRing.residue ↥A a) := by rw [hgeq]; ring
    rw [this]; exact add_mem hgs' (s'.algebraMap_mem' _)
  have hrat' : s'.IsRational := (AlgebraicCurve.Place.isRational_iff_deg_eq_one s').mpr (IsCurveOver.deg_eq_one_of_isAlgClosed s')
  have hss : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) ∈ ssPlaces q M' (ResidueField ↥A) := (hW _).mp s.2
  have hrat : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).IsRational := hss.1
  have hjs : jGeomGen (ResidueField ↥A) M' ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring := hss.2.1.1
  have hconst : ∀ (w : Place (ResidueField ↥A) ↥(modularFunctionFieldC (ResidueField ↥A) M')) (hw : w.IsRational) (c : ResidueField ↥A),
      IsLocalRing.residue _ (⟨algebraMap (ResidueField ↥A) _ c, w.algebraMap_mem' _⟩ : w.toValuationSubring) =
        algebraMap (ResidueField ↥A) _ c := by
    intro w hw c
    rw [← Place.algebraMap_evalAt _ hw (w.algebraMap_mem' _), Place.evalAt_algebraMap_eq]

  have ha : IsLocalRing.residue ↥A a = (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (jGeomGen (ResidueField ↥A) M') := by
    apply (Place.algebraMap_residueField_injective (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    have hgms : g ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring := hmem
    have e0 := Place.algebraMap_evalAt _ hrat hgms
    rw [show (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt g = 0 from h0, map_zero] at e0
    have hsplit : (⟨g, hgms⟩ : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring) =
        ⟨jGeomGen (ResidueField ↥A) M', hjs⟩ - ⟨algebraMap (ResidueField ↥A) _ (IsLocalRing.residue ↥A a), (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).algebraMap_mem' _⟩ :=
      Subtype.ext hgeq
    rw [hsplit, map_sub, hconst _ hrat, ← Place.algebraMap_evalAt _ hrat hjs] at e0
    exact (sub_eq_zero.mp e0.symm).symm
  have hval' : s'.evalAt (jGeomGen (ResidueField ↥A) M') = IsLocalRing.residue ↥A a := by
    apply (Place.algebraMap_residueField_injective s')
    rw [Place.algebraMap_evalAt _ hrat' hjs']
    have hsplit : (⟨jGeomGen (ResidueField ↥A) M', hjs'⟩ : s'.toValuationSubring) =
        ⟨g, hgs'⟩ + ⟨algebraMap (ResidueField ↥A) _ (IsLocalRing.residue ↥A a), s'.algebraMap_mem' _⟩ :=
      Subtype.ext (by show jGeomGen (ResidueField ↥A) M' = g + _; rw [hgeq]; ring)
    rw [hsplit, map_add, hresg, zero_add, hconst _ hrat']

  have hss' : s' ∈ ssPlaces q M' (ResidueField ↥A) := by
    refine ⟨hrat', ⟨hjs', jNGeomGen_mem_of_jGeomGen_mem _ _ s' hjs'⟩, ?_⟩
    rw [hval', ha]; exact hss.2.2
  exact (hN Q).mpr ⟨⟨s', (hW s').mpr hss'⟩, fun g' => hs'iff g'⟩

