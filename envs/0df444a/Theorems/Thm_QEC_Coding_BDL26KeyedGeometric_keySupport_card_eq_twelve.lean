theorem QEC.Coding.BDL26KeyedGeometric.keySupport_card_eq_twelve (P : TannerSquarePresentation) (key : Triangle P → ℕ)
    (hk : Function.Injective key) (J : Vertex P → Space) (radius : ℝ)
    (e : KeyEvent P key hk J radius) : (keySupport P key hk J radius e).card = 12 := by sorry
