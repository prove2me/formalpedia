variable {K : Type} [Field K] [NumberField K] [StarRing K] {d : ℕ}

theorem Formalism.DivisionValues.shift_mem_smulLat (a : K) (N : Submodule (𝓞 K) (Fin d → K)) (x : Fin d → K) :
