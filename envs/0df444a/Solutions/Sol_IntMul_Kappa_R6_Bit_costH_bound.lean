-- Source module: Solutions.R6BitCost
/-!
# Round six, bit side: cost of `progH` and the generalized Prop. 11

`costH C e V`: the structural cost of `progH C q e …` on an array of volume `V`, following the
program: `e < m`: `e` digit-swap passes; `e = m f + r`: `r` digit-swap passes, the row split and
merge (`2V`), `T` zero temporaries (`T V / W`), each gate one pass per touched wire (`V / W`),
each edge `4m` shift passes (`V / W` each) plus its run children, each a recursive call of width
`r' f` on a stream of volume `V / W`.

* `costH_lin`: `costH e V = V · costH e 1`.
* `cH_rec`: `c(e) = (e mod m) + K₀ + (1/W) Σ_{children} c(w ⌊e/m⌋)` (`c = costH · 1`).
* `costH_bound`: with `histMoment C.hist m τ < W`, `costH e V ≤ K V e^τ` for all `e` (via the
  monotone majorant of `c` and `R6.MomentRec.moment_recurrence_bound`).
* `prop11H`: denotation and cost together.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W]

lemma instrCost_lin {Wr : Type*} (child : ℕ × ℕ × ℕ → ℝ → ℝ)
    (hc : ∀ ρ v, child ρ v = v * child ρ 1) (V : ℝ) (i : Instr Wr R m) :
    instrCost child (V / W) i = V * instrCost child (1 / W) i := by
  cases i with
  | gate g S => simp only [instrCost]; ring
  | edge w e =>
    simp only [instrCost]
    rw [List.map_congr_left (fun ρ _ => hc ρ (V / W)), List.sum_map_mul_left,
      List.map_congr_left (l := e.runs) (fun ρ _ => hc ρ (1 / W)), List.sum_map_mul_left]
    ring

lemma sum_map_mul {α : Type*} (l : List α) (f : α → ℝ) (V : ℝ) :
    (l.map fun a => V * f a).sum = V * (l.map f).sum := List.sum_map_mul_left _ _ _

/-- The cost is linear in the volume. -/
theorem costH_lin (C : QHNet R W T m) : ∀ e V, costH C e V = V * costH C e 1 := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro V
  rw [costH, costH]
  split_ifs with he
  · have hc : ∀ (ρ : ℕ × ℕ × ℕ) (v : ℝ),
        (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) v else 0) =
          v * (if ρ.2.2 * (e / m) < e then costH C (ρ.2.2 * (e / m)) 1 else 0) := by
      intro ρ v
      split_ifs with h
      · exact ih _ h v
      · ring
    rw [List.map_congr_left (fun i _ => instrCost_lin _ hc V i), sum_map_mul]
    ring
  · ring

lemma width_lt {m e w : ℕ} (he : m ≤ e) (hw : w < m) : w * (e / m) < e := by
  have h1 : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  have h2 : e / m * m ≤ e := Nat.div_mul_le_self e m
  nlinarith

lemma cH_lt (C : QHNet R W T m) {e : ℕ} (he : ¬ m ≤ e) : cH C e = e := by
  rw [cH, costH, if_neg he]; ring

lemma K0_nonneg (C : QHNet R W T m) : 0 ≤ K0 C := by
  unfold K0; positivity

lemma cH_nonneg (C : QHNet R W T m) (hruns : C.RunsOK) : ∀ e, 0 ≤ cH C e := by
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  by_cases he : m ≤ e
  · rw [cH_rec C hruns he]
    have : 0 ≤ (C.widths.map fun w => cH C (w * (e / m))).sum := by
      apply List.sum_nonneg
      intro x hx
      obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hx
      obtain ⟨e', he', ρ, hρ, rfl⟩ := QHNet.mem_widths hw
      exact ih _ (width_lt he (hruns e' he' ρ hρ).2.1)
    have := K0_nonneg C
    positivity
  · rw [cH_lt C he]; positivity

lemma le_cHat (C : QHNet R W T m) {x y : ℕ} (h : y ≤ x) : cH C y ≤ cHat C x :=
  Finset.le_sup' (cH C) (Finset.mem_range.2 (by omega))

lemma cHat_mono (C : QHNet R W T m) : Monotone (cHat C) := by
  intro x y hxy
  exact Finset.sup'_le _ _ fun z hz => le_cHat C (by simp at hz; omega)

lemma cHat_rec (C : QHNet R W T m) (hruns : C.RunsOK) (hm : 2 ≤ m) (f : ℕ) (_hf : 1 ≤ f) :
    cHat C (m * f) ≤ (C.hist.map fun p => (p.2 : ℝ) * cHat C (p.1 * f)).sum / W + (K0 C + m) := by
  rw [QHNet.sum_hist C (fun w => cHat C (w * f))]
  obtain ⟨y, hy, hyeq⟩ := Finset.exists_mem_eq_sup' (⟨0, by simp⟩ : (Finset.range (m * f + 1)).Nonempty) (cH C)
  rw [cHat, hyeq]
  have hy' : y ≤ m * f := by simp at hy; omega
  have hsum0 : 0 ≤ (C.widths.map fun w => cHat C (w * f)).sum := by
    apply List.sum_nonneg
    intro x hx
    obtain ⟨w, -, rfl⟩ := List.mem_map.1 hx
    exact le_trans (cH_nonneg C hruns 0) (le_cHat C (Nat.zero_le _))
  have hW : (0 : ℝ) < W := by exact_mod_cast NeZero.pos W
  have hK := K0_nonneg C
  by_cases hym : m ≤ y
  · rw [cH_rec C hruns hym]
    have hle : (C.widths.map fun w => cH C (w * (y / m))).sum ≤
        (C.widths.map fun w => cHat C (w * f)).sum := by
      apply List.sum_le_sum
      intro w _
      apply le_cHat
      exact Nat.mul_le_mul_left _ ((Nat.div_le_iff_le_mul_add_pred (by omega)).2 (by nlinarith))
    have hr : ((y % m : ℕ) : ℝ) ≤ m := by exact_mod_cast (Nat.mod_lt y (by omega)).le
    have := div_le_div_of_nonneg_right hle hW.le
    linarith
  · rw [cH_lt C hym]
    have : (y : ℝ) ≤ m := by exact_mod_cast (show y ≤ m by omega)
    have := div_nonneg hsum0 hW.le
    linarith

/-- **Generalized Prop. 11, cost.** If every run is valid and `Σ n_w (w/m)^τ < W`, the program
costs `O(V e^τ)` for **every** width `e`. -/
theorem costH_bound_sol_aux (C : QHNet R W T m) (hruns : C.RunsOK) (hm : 2 ≤ m) {τ : ℝ} (hτ0 : 0 < τ)
    (hτ1 : τ ≤ 1) (hmom : histMoment C.hist m τ < W) :
    ∃ K : ℝ, ∀ (e : ℕ) (V : ℝ), 0 ≤ V → costH C e V ≤ K * V * (e : ℝ) ^ τ := by
  obtain ⟨A, hA⟩ := R6.MomentRec.moment_recurrence_bound C.hist m W τ (K0 C + m) (cHat C) hm
    hτ0 hτ1 (QHNet.hist_bounds hruns) (NeZero.pos W) hmom (cHat_mono C)
    (fun f hf => cHat_rec C hruns hm f hf)
  refine ⟨A, fun e V hV => ?_⟩
  rw [costH_lin]
  rcases Nat.eq_zero_or_pos e with rfl | he
  · rw [show costH C 0 1 = 0 by rw [← cH, cH_lt C (by omega)]; simp]
    simp [Real.zero_rpow hτ0.ne']
  · have h1 := le_trans (le_cHat C le_rfl) (hA e he)
    rw [← cH]
    nlinarith [mul_le_mul_of_nonneg_left h1 hV]

end IntMul.Kappa.R6.Bit

end

