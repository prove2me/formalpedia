section inverse

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

theorem contDiffOn_detC_of {s : Set X} {A : X → Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) : ContDiffOn ℝ ∞ (fun p => (A p).det) s := by
