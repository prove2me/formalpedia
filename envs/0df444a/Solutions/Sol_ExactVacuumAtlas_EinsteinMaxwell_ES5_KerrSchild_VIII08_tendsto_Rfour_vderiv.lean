theorem solution {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    Tendsto (fun R : ℝ => R ^ 4 * (deriv (vfun j q r) R + 2 * j / R ^ 3)) atTop
      (𝓝 (r 0 - 6 * sigmaB j q)) := by
  have hRbfun := tendsto_Rbfun (j := j) hqc.continuousOn
  have hr0 : Tendsto (fun R : ℝ => r (1 / R)) atTop (𝓝 (r 0)) := by
    have hinv : Tendsto (fun R : ℝ => (1:ℝ) / R) atTop (𝓝[UG] (0:ℝ)) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
      · simpa [one_div] using tendsto_inv_atTop_zero (𝕜 := ℝ)
      · filter_upwards [eventually_gt_atTop (12 / 5 : ℝ)] with R hR
        have hR0 : (0:ℝ) < R := by linarith
        unfold UG
        constructor
        · rw [lt_div_iff₀ hR0]; linarith
        · rw [div_lt_iff₀ hR0]; linarith
    have hc : ContinuousWithinAt r UG 0 := hr 0 (by unfold UG; constructor <;> norm_num)
    exact hc.tendsto.comp hinv
  have hcomb : Tendsto (fun R : ℝ => r (1 / R) - 6 * (R * bfun j q R)) atTop
      (𝓝 (r 0 - 6 * sigmaB j q)) :=
    hr0.sub (hRbfun.const_mul 6)
  refine hcomb.congr' ?_
  filter_upwards [eventually_gt_atTop (3:ℝ)] with R hR
  have hR0 : (0:ℝ) < R := by linarith
  have h1R0 : (0:ℝ) < 1 / R := by positivity
  have hbeta : beta j q (1 / R) = bfun j q R := by
    rw [beta_of_ne (ne_of_gt h1R0)]
    congr 1
    field_simp
  have hd := deriv_vfun (j := j) hqc hq hAq hr hR
  unfold ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Gfun at hd
  rw [hbeta] at hd
  rw [hd]
