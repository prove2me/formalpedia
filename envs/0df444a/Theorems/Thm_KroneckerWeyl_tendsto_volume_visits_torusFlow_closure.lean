-- title:
--   Corollary B.5.2.4 (uniform distribution) — the proportion of time a linear flow on $\mathbb T^N$ spends in a set with $\mu_G$-null boundary tends to its $\mu_G$-measure
-- statement:
--   **Corollary B.5.2.4 (uniform distribution of linear flows on the torus).** Let $N\ge0$, $\mathbb T=\mathbb R/\mathbb Z$, let $\tau=(\tau_1,\dots,\tau_N)\in\mathbb R^N$ be an arbitrary vector, $\overline\gamma(t)=(t\tau_1,\dots,t\tau_N)\bmod\mathbb Z^N$ the continuous one-parameter subgroup of $\mathbb T^N$ generated by $\tau$, $G$ the closure of its image and $\mu_G$ the Haar measure of total mass $1$ on $G$. Let $\lambda$ be the Lebesgue measure on $\mathbb R$. Let $U\subset\mathbb T^N$ be a subset such that the boundary of $U\cap G$ relative to $G$ is $\mu_G$-null,
--   $$\mu_G\bigl(\partial_G(U\cap G)\bigr)=0 .$$
--   Then
--   $$\lim_{T\to+\infty}\frac{\lambda\{t\in[-T,T]:\overline\gamma(t)\in U\}}{2T}=\lim_{T\to+\infty}\frac{\lambda\{t\in[0,T]:\overline\gamma(t)\in U\}}{T}=\mu_G(U\cap G).$$
--
--   In the source it is stated as a corollary of the Kronecker–Weyl theorem (B.5.2.1). It is the form in which the theorem is used to prove the strong recurrence of reciprocal finite Euler products (Proposition B.5.3.3): the set of $t$ with $\overline\gamma(t)$ in a non-empty relatively open subset of $G$ with null boundary has positive density.
--
--   **Formalization Note.** The index set $\{1,\dots,N\}$ is an arbitrary finite type `ι` (so $N=0$ is allowed). $\mathbb T$ is Mathlib's `UnitAddCircle = AddCircle (1 : ℝ)`, the coercion `ℝ → UnitAddCircle` is the quotient map $\mathbb R\to\mathbb R/\mathbb Z$, and $\mathbb T^N$ is `ι → UnitAddCircle` (Mathlib's `UnitAddTorus ι`) with the product topology; $\overline\gamma_\tau(t)$ is written inline as `fun k => ((t * τ k : ℝ) : UnitAddCircle)`. The orbit closure is an additive subgroup `G` with hypothesis `hG`, $\mu_G$ is a measure `μ` on the subtype `G` that is an additive Haar measure and a probability measure, and $U\cap G$ is the preimage `Subtype.val ⁻¹' U : Set G`, whose `frontier` is taken in the subspace topology of $G$. The source takes $U\subset[0,1)^N$ open and $\widehat U$ its image in $\mathbb T^N$, and writes the hypothesis as $\mu_G(\partial(\widehat U\cap G))=0$; here $U$ plays the role of $\widehat U$ and is an arbitrary subset of $\mathbb T^N$ (the classical statement for sets with null boundary), and the boundary is the relative one, which is the reading under which the hypothesis does not force $\mu_G(U\cap G)=0$ when $\dim G<N$ (a subset of a proper subtorus has empty interior in $\mathbb T^N$, so its boundary in $\mathbb T^N$ is its closure). No measurability of $U$ is assumed: for a non-measurable set `volume` and `μ` are outer measures, and the statement remains true because the set of visiting times lies between those of the interior and of the closure of $U\cap G$ in $G$, which differ by a $\mu_G$-null set.
-- source:
--   A. M. Masullo, The Music of the Primes, draft of 20 November 2026, https://math216.wordpress.com/wp-content/uploads/2026/11/the-music-of-the-primes.pdf, p. 631, Corollary B.5.2.4 (Uniform distribution), eq. (B.5.2.15)

import Mathlib

open MeasureTheory Filter Topology

set_option autoImplicit false

namespace KroneckerWeyl

theorem tendsto_volume_visits_torusFlow_closure {ι : Type*} [Finite ι] (τ : ι → ℝ)
    (G : AddSubgroup (UnitAddTorus ι))
    (hG : (G : Set (UnitAddTorus ι)) =
      closure (Set.range fun t : ℝ => fun k : ι => ((t * τ k : ℝ) : UnitAddCircle)))
    (μ : Measure G) [μ.IsAddHaarMeasure] [IsProbabilityMeasure μ]
    (U : Set (UnitAddTorus ι))
    (h0 : μ (frontier (Subtype.val ⁻¹' U : Set G)) = 0) :
    Tendsto
        (fun T : ℝ =>
          (volume {t : ℝ | t ∈ Set.Icc 0 T ∧
            (fun k => ((t * τ k : ℝ) : UnitAddCircle)) ∈ U}).toReal / T)
        atTop (𝓝 (μ (Subtype.val ⁻¹' U : Set G)).toReal) ∧
      Tendsto
        (fun T : ℝ =>
          (volume {t : ℝ | t ∈ Set.Icc (-T) T ∧
            (fun k => ((t * τ k : ℝ) : UnitAddCircle)) ∈ U}).toReal / (2 * T))
        atTop (𝓝 (μ (Subtype.val ⁻¹' U : Set G)).toReal) := by sorry

end KroneckerWeyl
