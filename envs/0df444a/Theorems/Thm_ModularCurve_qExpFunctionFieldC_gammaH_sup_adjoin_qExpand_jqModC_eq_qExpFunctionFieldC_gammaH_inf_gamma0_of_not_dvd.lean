theorem ModularCurve.qExpFunctionFieldC_gammaH_sup_adjoin_qExpand_jqModC_eq_qExpFunctionFieldC_gammaH_inf_gamma0_of_not_dvd
    (K : Type*) [Field K] (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime]
    (hNℓ : ((N * ℓ : ℕ) : K) ≠ 0) (hℓN : ¬ ℓ ∣ N) (H : Subgroup (ZMod N)ˣ) :
    ModularCurve.qExpFunctionFieldC K (CohCarrier.GammaH N H) ⊔
        IntermediateField.adjoin K ({ModularCurve.qExpand K ℓ (ModularCurve.jqModC K)} : Set (LaurentSeries K)) =
      ModularCurve.qExpFunctionFieldC K (CohCarrier.GammaH N H ⊓ CongruenceSubgroup.Gamma0 (N * ℓ)) := by sorry
