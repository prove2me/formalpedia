                                                                  (first
                                                                    | omega
                                                                    | ((ring_nf); (omega))))
                                                              | omega
                                                              |
                                                                (simp [] <;>
                                                                    first
                                                                    | omega
                                                                    | ((ring_nf); (omega))))) fun _ h => h
