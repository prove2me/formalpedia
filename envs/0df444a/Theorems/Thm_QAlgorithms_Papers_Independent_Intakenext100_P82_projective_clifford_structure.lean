-- title:
--   Unnumbered §II: projective Clifford subgroup structure
-- statement:
--   All circuits are single-qubit circuits without ancillas or measurements. Products act from right to left. Let $H=i\,2^{-1/2}\begin{pmatrix}1&1\\1&-1\end{pmatrix}$, $T=\operatorname{diag}(e^{-i\pi/8},e^{i\pi/8})$, $S=T^2$, and $C=\langle H,S\rangle\subset\operatorname{PSU}(2)$. The two distinct syllable letters are $a=TH$ and $b=SH$. A normalized word is empty, or ends in $a$ with no adjacent $b$ letters. A canonical word is normalized and its first four syllables, when present, are all $a$. Write $\tau(c)$ for the number of $a$ letters in $c$; Clifford gates have zero charged cost.
--
--   The projective Clifford subgroup generated by $H$ and $S$ satisfies
--
--   $$|C|=24,\qquad C\cong\mathfrak S_4.$$
--
--   Here $\mathfrak S_4$ is the symmetric group on four letters, equivalently the classical Coxeter group of type $A_3$. This identifies the finite Clifford subgroup used for every terminal and lookup.
-- source:
--   A Depth-Optimal Canonical Form for Single-qubit Quantum Circuits, arXiv:1206.3223v1, PDF p. 2, Unnumbered §II: projective Clifford subgroup structure

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P82

noncomputable section

namespace QAlgorithms.Papers.Independent.Intakenext100.P82

open scoped BigOperators

local notation "Mat" => Matrix Bool Bool ℂ

/-- Unnumbered §II, PDF p.2. S4 means permutations of four letters
(order 24), equivalently the classical Coxeter group of type A3. -/
theorem projective_clifford_structure :
    Nat.card cliffordSubgroup = 24 ∧
      Nonempty (cliffordSubgroup ≃* Equiv.Perm (Fin 4)) := by sorry

end QAlgorithms.Papers.Independent.Intakenext100.P82

end
