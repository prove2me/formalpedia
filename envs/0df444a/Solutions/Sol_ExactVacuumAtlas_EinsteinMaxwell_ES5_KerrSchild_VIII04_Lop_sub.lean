open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
set_option maxHeartbeats 1000000
theorem solution (Rh Ri Q : ℝ) {b1 b2 : ℝ → ℝ} (hb1 : ContDiffOn ℝ 2 b1 (Ioi Rh))
    (hb2 : ContDiffOn ℝ 2 b2 (Ioi Rh)) (hRh : 0 ≤ Rh) {R : ℝ} (hR : R ∈ Ioi Rh) :
    Lop Rh Ri Q (fun s => b1 s - b2 s) R = Lop Rh Ri Q b1 R - Lop Rh Ri Q b2 R := by
  have hR0 : R ≠ 0 := (lt_of_le_of_lt hRh hR).ne'
  have hd : ∀ s ∈ Ioi Rh, deriv (fun s => b1 s - b2 s) s = deriv b1 s - deriv b2 s := fun s hs =>
    deriv_sub (diff_of_C2 isOpen_Ioi hb1 hs).1 (diff_of_C2 isOpen_Ioi hb2 hs).1
  have hev : (fun s => Pc Rh Ri s * deriv (fun s => b1 s - b2 s) s) =ᶠ[𝓝 R]
      (fun s => Pc Rh Ri s * deriv b1 s - Pc Rh Ri s * deriv b2 s) := by
    filter_upwards [isOpen_Ioi.mem_nhds hR] with s hs
    rw [hd s hs]; ring
  have hP := hasDerivAt_Pc Rh Ri hR0
  have hm1 : HasDerivAt (fun s => Pc Rh Ri s * deriv b1 s)
      (deriv (fun s => Pc Rh Ri s * deriv b1 s) R) R :=
    (hP.mul (diff_of_C2 isOpen_Ioi hb1 hR).2.hasDerivAt).differentiableAt.hasDerivAt
  have hm2 : HasDerivAt (fun s => Pc Rh Ri s * deriv b2 s)
      (deriv (fun s => Pc Rh Ri s * deriv b2 s) R) R :=
    (hP.mul (diff_of_C2 isOpen_Ioi hb2 hR).2.hasDerivAt).differentiableAt.hasDerivAt
  unfold Lop
  have hs : HasDerivAt (fun s => Pc Rh Ri s * deriv b1 s - Pc Rh Ri s * deriv b2 s)
      (deriv (fun s => Pc Rh Ri s * deriv b1 s) R - deriv (fun s => Pc Rh Ri s * deriv b2 s) R) R :=
    hm1.sub hm2
  rw [hev.deriv_eq, hs.deriv]
  ring
