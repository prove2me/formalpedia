/-
`BurauFaithful.burauRep3_det_pow`: the determinant of the unreduced Burau matrix of a braid is an
integer power of the determinant of the Burau matrix of `σ₁`.

Idea: the determinant is a homomorphism, so `β ↦ det ρ₃(β)` is a homomorphism out of `B₃`; since
`B₃` is generated by `σ₀, σ₁` and both generators have the same determinant `-t`, its image lies in
the cyclic subgroup generated by `det ρ₃(σ₀)`.

Internally the group is handled as the presented group `PresentedGroup (braidRels 3)`, which is
definitionally equal to `BraidsLinksMCG.ArtinBraidGroup 3`; the final step bridges by defeq.
-/
import Definitions.Def_BurauFaithful_UnreducedBurau

set_option autoImplicit false

open LaurentPolynomial Matrix BraidsLinksMCG

theorem solution (β : BraidsLinksMCG.ArtinBraidGroup 3) :
    ∃ k : ℤ, Matrix.GeneralLinearGroup.det (BurauFaithful.burauRep 3 β) =
      (Matrix.GeneralLinearGroup.det (BurauFaithful.burauRep 3
        (BraidsLinksMCG.sigma ⟨0, by decide⟩))) ^ k := by
  -- the Burau matrices of the generators
  have hg : ∀ i : Fin (3 - 1),
      (BurauFaithful.burauRep 3 (BraidsLinksMCG.sigma i)).1 = BurauFaithful.burauMatrix i := by
    intro i
    have hh := PresentedGroup.toGroup.of (h := BurauFaithful.burauGen_relations 3) (x := i)
    exact congrArg Units.val hh
  have hmat0 : (BurauFaithful.burauMatrix (0 : Fin 2) :
      Matrix (Fin 3) (Fin 3) (LaurentPolynomial ℤ)) =
      !![1 - T 1, T 1, 0;
         1, 0, 0;
         0, 0, 1] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [BurauFaithful.burauMatrix_apply] <;> ring
  have hmat1 : (BurauFaithful.burauMatrix (1 : Fin 2) :
      Matrix (Fin 3) (Fin 3) (LaurentPolynomial ℤ)) =
      !![1, 0, 0;
         0, 1 - T 1, T 1;
         0, 1, 0] := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [BurauFaithful.burauMatrix_apply] <;> ring
  -- both generators have the same determinant
  have hdet : Matrix.GeneralLinearGroup.det (BurauFaithful.burauRep 3
        (BraidsLinksMCG.sigma (1 : Fin 2))) =
      Matrix.GeneralLinearGroup.det (BurauFaithful.burauRep 3
        (BraidsLinksMCG.sigma (0 : Fin 2))) := by
    apply Units.ext
    rw [Matrix.GeneralLinearGroup.val_det_apply, Matrix.GeneralLinearGroup.val_det_apply,
      hg 1, hg 0, hmat1, hmat0, Matrix.det_fin_three, Matrix.det_fin_three]
    simp
  -- the determinant homomorphism `β ↦ det ρ₃(β)`, on the presented group
  let f : PresentedGroup (BraidsLinksMCG.braidRels 3) →* (LaurentPolynomial ℤ)ˣ :=
    MonoidHom.comp
      (Matrix.GeneralLinearGroup.det :
        GL (Fin 3) (LaurentPolynomial ℤ) →* (LaurentPolynomial ℤ)ˣ)
      (BurauFaithful.burauRep 3)
  -- the image lies in the cyclic subgroup generated by `det ρ₃(σ₀)`
  have hgen : Subgroup.closure (Set.range (PresentedGroup.of :
      Fin 2 → PresentedGroup (BraidsLinksMCG.braidRels 3))) = ⊤ :=
    PresentedGroup.closure_range_of (BraidsLinksMCG.braidRels 3)
  have hone : f (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)) =
      f (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)) := hdet
  have hle : Subgroup.closure (Set.range (PresentedGroup.of :
      Fin 2 → PresentedGroup (BraidsLinksMCG.braidRels 3))) ≤
      Subgroup.comap f (Subgroup.zpowers (f (PresentedGroup.of
        (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)))) := by
    rw [Subgroup.closure_le]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · refine Subgroup.mem_comap.mpr ?_
      refine Subgroup.mem_zpowers_iff.mpr ⟨1, ?_⟩
      rw [zpow_one]
      rfl
    · refine Subgroup.mem_comap.mpr ?_
      refine Subgroup.mem_zpowers_iff.mpr ⟨1, ?_⟩
      rw [zpow_one, ← hone]
      rfl
  have hmem : f ((β : PresentedGroup (BraidsLinksMCG.braidRels 3))) ∈
      Subgroup.zpowers (f (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2))) := by
    have hβ : (β : PresentedGroup (BraidsLinksMCG.braidRels 3)) ∈
        Subgroup.closure (Set.range (PresentedGroup.of :
          Fin 2 → PresentedGroup (BraidsLinksMCG.braidRels 3))) := by
      rw [hgen]
      trivial
    exact Subgroup.mem_comap.mp (hle hβ)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
  exact ⟨k, hk.symm⟩
