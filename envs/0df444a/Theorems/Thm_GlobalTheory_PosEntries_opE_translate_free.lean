    {Ψ : Matrix (n ⊕ Fin c) (n' ⊕ Fin (c + 1)) k → ℂ} {z : Matrix (n ⊕ Fin c) (n' ⊕ Fin (c + 1)) k}
    (hz : ∀ r s, ¬ Free p (r, s) → z r s = 0) (hΨ : ∀ x, Ψ (x + z) = Ψ x) (x₀ : Matrix n n' k) :
