variable {Ty : Type} {r : Ty → ℕ} {n : ℕ} {k : Type} [Field k]

theorem GlobalTheory.CombMinor.cMat_rowShift [Fintype Ty] (τ : Ty) (s : ℕ) (hs : s ≤ r τ) (B : Fin s → Fin n → k)
    (σ : Ty) (i i' : Fin (r σ)) (hii : i' < i) (t : k) :
    rowShift r n k σ i i' t (cMat τ s hs B).det = (cMat τ s hs B).det := by sorry
