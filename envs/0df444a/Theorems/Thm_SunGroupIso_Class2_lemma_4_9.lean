-- title:
--   Lemma 4.9 — exponent of F and a splitting of U/Z(G) with at most (log_p|G|)·δ/m extra factors
-- statement:
--   Let $G$ be a $p$-group of class 2, $U\le G$ with $Z(G)\le U$ and every element of $U/Z(G)$ of order at most $p^\delta$ ($\delta\ge1$), and $F$ the subgroup generated by the elements of $U$ of order at most $p^{m+\delta+1}$ ($m\ge1$). Then every element of $F$ has order at most $p^{m+\delta+1}$, and there are an integer $k\le(\log_p|G|)\cdot\delta/m$, elements $u_1,\dots,u_k\in U$ and $L\le\langle F,Z(G)\rangle/Z(G)$ with $U/Z(G)=\langle\tilde u_1\rangle\oplus\cdots\oplus\langle\tilde u_k\rangle\oplus L$.
--
--   Differences from the source:
--   - reading: 'U is ⟨ũ_1⟩ ⊕ … ⟨ũ_k⟩ ⊕ L such that L ≤ ⟨F, Z(G)⟩/Z(G)' → U/Z(G) = ⟨ũ_1⟩ ⊕ ⋯ ⊕ ⟨ũ_k⟩ ⊕ L with u_i ∈ U; reason: the summands are cosets and L is a subgroup of G/Z(G); the proof writes U/Z(G) = ⟨ũ_1⟩ ⊕ ⋯ ⊕ ⟨ũ_k⟩ ⊕ L (p. 18)
-- source:
--   Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), Lemma 4.9, p. 18 (PDF p. 20)

import Mathlib
import Definitions.Def_SunGroupIso_Class2_Basic

set_option autoImplicit false

open scoped Classical commutatorElement

namespace SunGroupIso.Class2

open ExponomialAssortment.FPTAS (encodeNat)
open GroupIsoPoly (encPair cayley)

/-- **Lemma 4.9** (Sun 2026, arXiv:2611.05920 (held version, sha256 22193308…), Lemma 4.9, p. 18, PDF p. 20). Let `G` be a `p`-group of class 2 and `U ≤ G` with
`Z(G) ≤ U` and every element of `U/Z(G)` of order at most `p^δ` (`δ ≥ 1`). Let `F` be generated by the
elements of `U` of order at most `p^{m+δ+1}` (`m ≥ 1`). Then every element of `F` has order at most
`p^{m+δ+1}`, and there is `k ≤ (log_p |G|) · δ/m` with `U/Z(G) = ⟨ũ_1⟩ ⊕ ⋯ ⊕ ⟨ũ_k⟩ ⊕ L`,
`L ≤ ⟨F, Z(G)⟩/Z(G)`. -/
theorem lemma_4_9 {p : ℕ} (hp : p.Prime) {G : Type*} [Group G] [Finite G] (hG : IsPGroupClass2 p G)
    (U : Subgroup G) (hU : Subgroup.center G ≤ U) (δ : ℕ) (hδ : 0 < δ)
    (hUδ : ∀ u ∈ U, orderOf (tl u) ≤ p ^ δ) (m : ℕ) (hm : 0 < m) :
    (∀ x ∈ Subgroup.closure {u | u ∈ U ∧ orderOf u ≤ p ^ (m + δ + 1)}, orderOf x ≤ p ^ (m + δ + 1)) ∧
    ∃ k : ℕ, (k : ℝ) ≤ Real.logb p (Nat.card G) * δ / m ∧
      ∃ u : Fin k → G, (∀ i, u i ∈ U) ∧ ∃ L : Subgroup (Qt G),
        L ≤ (Subgroup.closure {u | u ∈ U ∧ orderOf u ≤ p ^ (m + δ + 1)} ⊔ Subgroup.center G).map (qmap G) ∧
        DecompWith (U.map (qmap G)) (fun i => tl (u i)) L := by sorry

end SunGroupIso.Class2
