theorem NLogN.expNegBody_cost (n k j : ℕ) (s : IState HS) (L16 L17 L18 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) :
    expNegBody.cost s ≤ piCost 5 239 (2 * n + 10) +
      expNegFixCost n (2 * n + 10) (zsz (-(piBits (2 * n + 10) * j / k)))
        ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat +
      10 ^ 10 * (expNegBB n (zsz (-(piBits (2 * n + 10) * j / k)))
        ((-(-(piBits (2 * n + 10) * j / k))) / log2Bits (2 * n + 10)).toNat
        (zsz (j : ℤ)) (zsz (k : ℤ)) + 4) ^ 2 := by sorry
