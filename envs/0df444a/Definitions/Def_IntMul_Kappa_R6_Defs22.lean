/-! ## Splitting a tensor power -/

/-! ## The node and chain subfamilies -/

theorem gN1_lt {m F E : ℕ} (hE : m * F ≤ E) (p : Fin m × Fin F) : p.2.val + F * p.1.val < E := by
  have h1 := p.2.isLt
  have h2 : F * p.1.val + F ≤ m * F := by
    have := Nat.mul_le_mul_left F (show p.1.val + 1 ≤ m from p.1.isLt)
    rw [mul_add, mul_one, mul_comm F m] at this; exact this
  omega

/-- The slot bits of a node: `(a, q) ↦ q + F a`. -/
def gN1 {m F E : ℕ} (hE : m * F ≤ E) : Fin m × Fin F → Fin E := fun p =>
  ⟨p.2.val + F * p.1.val, gN1_lt hE p⟩

/-- The leftover bits of a node: `j ↦ m F + j`. -/
def gN2 {m F E : ℕ} (hE : m * F + E % m = E) : Fin (E % m) → Fin E := fun j =>
  ⟨m * F + j.val, by have := j.isLt; omega⟩

/-- The kernel bit of a chain. -/
def gC0 {E : ℕ} (hE : 1 ≤ E) : Fin (mC ^ 0) → Fin E := fun _ => ⟨0, hE⟩

/-- The lower bits of a chain: `j ↦ j + 1`. -/
def gC1 {E : ℕ} (hE : 1 ≤ E) : Fin (E - 1) → Fin E := fun j => ⟨j.val + 1, by have := j.isLt; omega⟩

