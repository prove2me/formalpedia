theorem fok_qopW (Ms : List M2G) (B1 G off : ℕ) : fok (qopW Ms B1 G off) = true := by
  simp only [qopW, fok, fok_qop, fok_mvK_eq, Bool.and_true, Bool.true_and]
  decide

theorem getD_pairOut (M : M2G) (B1 : ℕ) (zs : List GI) (h : 2 * B1 ≤ zs.length) (j : ℕ)
    (hj : j < 2 * B1) :
    (pairOut M (zs.take B1) ((zs.drop B1).take B1)).getD j 0 =
      if j < B1 then lin2 M.a M.b (zs.getD j 0) (zs.getD (j + B1) 0)
      else lin2 M.c M.d (zs.getD (j - B1) 0) (zs.getD j 0) := by
  simp only [List.getD_eq_getElem?_getD, pairOut]
  have l1 : (List.zipWith (lin2 M.a M.b) (zs.take B1) ((zs.drop B1).take B1)).length = B1 := by
    simp; omega
  split_ifs with h1
  · rw [List.getElem?_append_left (by omega), List.getElem?_zipWith, List.getElem?_take,
      List.getElem?_take, List.getElem?_drop, if_pos h1, if_pos h1]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    rw [show j + B1 = B1 + j by ring, List.getElem?_eq_getElem (show B1 + j < zs.length by omega)]
    simp
  · rw [List.getElem?_append_right (by rw [l1]; omega), l1, List.getElem?_zipWith, List.getElem?_take,
      List.getElem?_take, List.getElem?_drop, if_pos (by omega), if_pos (by omega)]
    rw [List.getElem?_eq_getElem (by omega), List.getElem?_eq_getElem (by omega)]
    simp only [Option.map_some, Option.bind_some, Option.getD_some]
    rw [List.getElem?_eq_getElem (show j < zs.length by omega)]; simp only [Option.getD_some]
    congr 2; omega

theorem getD_take' (zs : List GI) (k i : ℕ) (h : i < k) : (zs.take k).getD i 0 = zs.getD i 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_take, if_pos h]

theorem getD_drop' (zs : List GI) (k i : ℕ) : (zs.drop k).getD i 0 = zs.getD (k + i) 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_drop]

theorem getD_grpOut (B1 : ℕ) : ∀ (Ms : List M2G) (zs : List GI), 2 * B1 * Ms.length ≤ zs.length →
    ∀ j, j < 2 * B1 * Ms.length →
    (grpOut Ms B1 zs).getD j 0 = pent (Ms.getD (j / (2 * B1)) M0) B1 zs j
  | [], _, _, j, hj => by simp at hj
  | M :: Ms, zs, h, j, hj => by
    simp only [List.length_cons] at h hj
    have hB : 0 < B1 := by
      rcases Nat.eq_zero_or_pos B1 with e | e
      · subst e; simp at hj
      · exact e
    have hz : 2 * B1 ≤ zs.length := le_trans (by nlinarith) h
    have l1 : (pairOut M (zs.take B1) ((zs.drop B1).take B1)).length = 2 * B1 :=
      by rw [length_pairOut M (by simp; omega)]; simp; omega
    rw [grpOut]
    by_cases hj' : j < 2 * B1
    · rw [List.getD_append _ _ _ _ (by omega), getD_pairOut M B1 zs hz j hj',
        Nat.div_eq_of_lt hj']
      simp [pent, Nat.mod_eq_of_lt hj']
    · obtain ⟨j', rfl⟩ : ∃ j', j = j' + 2 * B1 := ⟨j - 2 * B1, by omega⟩
      rw [List.getD_append_right _ _ _ _ (by omega), l1, Nat.add_sub_cancel,
        getD_grpOut B1 Ms _ (by simp; rw [Nat.mul_add, mul_one] at h; omega) _
          (by rw [Nat.mul_add, mul_one] at hj; omega),
        Nat.add_div_right _ (by omega), List.getD_cons_succ]
      simp only [pent, Nat.add_mod_right, NLogN.KFB.getD_drop']
      split_ifs with hh
      · rw [show 2 * B1 + j' = j' + 2 * B1 by ring, show 2 * B1 + (j' + B1) = j' + 2 * B1 + B1 by ring]
      · have : B1 ≤ j' := le_trans (by omega) (Nat.mod_le j' (2 * B1))
        rw [show 2 * B1 + j' = j' + 2 * B1 by ring,
          show 2 * B1 + (j' - B1) = j' + 2 * B1 - B1 by omega]

theorem pent_drop (M : M2G) (B1 k : ℕ) (zs : List GI) (j : ℕ) (hk : 2 * B1 ∣ k) :
    pent M B1 (zs.drop k) j = pent M B1 zs (k + j) := by
  obtain ⟨c, rfl⟩ := hk
  simp only [pent, NLogN.KFB.getD_drop']
  have e : (2 * B1 * c + j) % (2 * B1) = j % (2 * B1) := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_left]
  rw [e]
  split_ifs with hh
  · rw [Nat.add_assoc]
  · have : B1 ≤ j := le_trans (by omega) (Nat.mod_le j (2 * B1))
    rw [show 2 * B1 * c + (j - B1) = 2 * B1 * c + j - B1 by omega]

/-- **Index semantics of `qopL`**: entry `j` is the output of its block's matrix. -/
theorem getD_qopL (Ms : List M2G) (B1 : ℕ) (zs : List GI) : ∀ (G : ℕ),
    G * (2 * B1 * Ms.length) ≤ zs.length → ∀ j, j < G * (2 * B1 * Ms.length) →
    (qopL Ms B1 G zs).getD j 0 = pent (Ms.getD (j % (2 * B1 * Ms.length) / (2 * B1)) M0) B1 zs j
  | 0, _, j, hj => by simp at hj
  | G + 1, hG, j, hj => by
    have hl := length_qopL Ms B1 G zs (le_trans (Nat.mul_le_mul_right _ (Nat.le_succ G)) hG)
    rw [qopL_succ]
    by_cases hj' : j < G * (2 * B1 * Ms.length)
    · rw [List.getD_append _ _ _ _ (by simpa [hl] using hj')]
      exact getD_qopL Ms B1 zs G (le_trans (Nat.mul_le_mul_right _ (Nat.le_succ G)) hG) j hj'
    · obtain ⟨j', rfl⟩ : ∃ j', j = G * (2 * B1 * Ms.length) + j' :=
        ⟨j - G * (2 * B1 * Ms.length), by omega⟩
      have hj2 : j' < 2 * B1 * Ms.length := by
        have e : (G + 1) * (2 * B1 * Ms.length) = G * (2 * B1 * Ms.length) + 2 * B1 * Ms.length := by
          ring
        omega
      rw [List.getD_append_right _ _ _ _ (by simp [hl]), hl, Nat.add_sub_cancel_left,
        getD_grpOut B1 Ms _ (by simp; rw [Nat.succ_mul] at hG; omega) j' hj2,
        pent_drop _ _ _ _ _ (Dvd.dvd.mul_left (Dvd.intro _ rfl) _)]
      congr 3
      rw [Nat.mul_comm, Nat.mul_add_mod, Nat.mod_eq_of_lt hj2]

end NLogN.KFB

end

