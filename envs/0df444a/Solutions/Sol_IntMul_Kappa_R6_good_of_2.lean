/-! ## 2. Elementary facts about `lg` -/

lemma two_pow_b_lt {n : ℕ} (hn : 2 ≤ n) : 2 ^ (bP6 n - 1) < n := by
  have hc : 1 ≤ Nat.clog 2 n := by
    have := Nat.clog_mono_right 2 (show 2 ^ 1 ≤ n by simpa using hn)
    rwa [Nat.clog_pow 2 1 (by norm_num)] at this
  have hb : bP6 n = Nat.clog 2 n := max_eq_left hc
  rw [hb]
  have := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (show 1 < n by omega)
  simpa [Nat.pred_eq_sub_one] using this

/-! ## 3. Facts valid as soon as `b ≥ 4` -/

lemma T_lower (P : Prm) (n : ℕ) : 4 * n ≤ TP6 P n * b'P6 P n := Nat.find_spec (LP6_exists P n)

/-! ## 4. Eventual facts (box exponent and volume) -/

theorem good_of_sol_aux (P : Prm) (hP : P.Ok) {n : ℕ} (hb : 4 ≤ bP6 n)
    (hb' : 8 * b'P6 P n ≤ 2 ^ (bP6 n / 2)) : Good P n := by
  have hn2 : 2 ≤ n := by
    have := n_le_two_pow_b n
    by_contra h
    push Not at h
    interval_cases n <;> simp [bP6, IntMul.lg] at hb
  set b := bP6 n with hbdef
  have hlt := two_pow_b_lt hn2
  rw [← hbdef] at hlt
  have hpow : 2 ^ b = 2 * 2 ^ (b - 1) := by rw [← pow_succ']; congr 1; omega
  have hhalf : 2 ^ (b / 2) ≤ 2 ^ (b - 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have spec := T_lower P n
  have hLb := L_le_b P hP (n := n) (by omega)
  -- `1 ≤ L`
  have hL1 : 1 ≤ LP6 P n := by
    by_contra h0
    have h0' : LP6 P n = 0 := by omega
    have : TP6 P n = 1 := by simp [TP6, h0']
    rw [this, one_mul] at spec
    omega
  -- `T b' < 8n`
  have hTb : TP6 P n * b'P6 P n < 8 * n := by
    have hmin : ¬ 4 * n ≤ 2 ^ (LP6 P n - 1) * b'P6 P n :=
      Nat.find_min (LP6_exists P n) (m := LP6 P n - 1) (by show LP6 P n - 1 < LP6 P n; omega)
    have : TP6 P n = 2 * 2 ^ (LP6 P n - 1) := by
      rw [TP6, ← pow_succ']; congr 1; omega
    rw [this]; push Not at hmin; nlinarith
  -- `b ≤ 2L`
  have h2L : b ≤ 2 * LP6 P n := by
    by_contra hcon
    push Not at hcon
    have hsum : LP6 P n + b / 2 ≤ b - 1 := by omega
    have h1 : 8 * (2 ^ LP6 P n * b'P6 P n) ≤ 2 ^ LP6 P n * 2 ^ (b / 2) := by
      have := Nat.mul_le_mul_left (2 ^ LP6 P n) hb'
      linarith
    have h2 : 2 ^ LP6 P n * 2 ^ (b / 2) ≤ 2 ^ (b - 1) := by
      rw [← pow_add]; exact Nat.pow_le_pow_right (by norm_num) hsum
    have : TP6 P n = 2 ^ LP6 P n := rfl
    rw [this] at spec
    omega
  have hd1 := d_pos P hP hb
  have hs := dℓ_spec P hP hb
  have hd : (0 : ℝ) < dP6 P n := by exact_mod_cast hd1
  have hℓ1 : 1 ≤ ℓP6 P n := by
    rcases Nat.eq_zero_or_pos (ℓP6 P n) with h | h
    · rw [h] at hs; omega
    · exact h
  have hℓge : (b : ℝ) / (2 * dP6 P n) ≤ ℓP6 P n := by
    rw [div_le_iff₀ (by positivity)]
    have : b ≤ 2 * (dP6 P n * ℓP6 P n) := by omega
    have : (b : ℝ) ≤ ((2 * (dP6 P n * ℓP6 P n) : ℕ) : ℝ) := by exact_mod_cast this
    push_cast at this; linarith
  have hV1 : 24 * (n : ℝ) ≤ VP6 P n := by
    unfold VP6 pP6; push_cast
    have : ((4 * n : ℕ) : ℝ) ≤ ((TP6 P n * b'P6 P n : ℕ) : ℝ) := by exact_mod_cast spec
    push_cast at this; nlinarith
  have hV2 : VP6 P n ≤ 48 * n := by
    unfold VP6 pP6; push_cast
    have : ((TP6 P n * b'P6 P n : ℕ) : ℝ) ≤ ((8 * n : ℕ) : ℝ) := by exact_mod_cast hTb.le
    push_cast at this; nlinarith
  exact ⟨hb, hb', spec, hTb, hL1, hLb, h2L, hV1, hV2, hd1, d_le_b P hP n, d_le_beps P n,
    d_half P hP hb, hs.1, hs.2, hℓ1, ell_le P hP hb, hℓge, ell_le_rpow P hP hb, gamma_le P n⟩

