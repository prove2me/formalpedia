      (((s4.upd T4 (s.G T4)).upd V RV).upd P2 (.int (t + x) :: s.G P2)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s4, s3, s2, s1, hV]
    first | exact ⟨by (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), by (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)⟩ | (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega) | (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  set s5 := ((s4.upd T4 (s.G T4)).upd V RV).upd P2 (.int (t + x) :: s.G P2) with hs5
  have h6 := fred_runs (I := I) (iprog := iprog) (X := P2) (by decide) (by decide) (by decide)
    (by decide) s5 (t + x) n (s.G P2) LN LF (by simp [s5])
    (by simp +decide [s5, s4, s3, s2, s1, hN]) (by simp +decide [s5, s4, s3, s2, s1, hF])
    (by
      have : |t + x| < 2 ^ (2 * n + 1) := by rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((t + x).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s6 := s5.upd P2 (.int ((t + x) % (2 ^ n + 1)) :: s.G P2) with hs6
  -- piece 7
  have h7g : ∀ s' : IState NS, s'.G W = .int (2 ^ (e + E)) :: LW → s'.G DE = .int (2 ^ E) :: LE →
      s'.G CC = .int c :: LC →
      IRuns I iprog (.seq (.op (.split W DE T3)) (.seq (.op (.drop T3)) (decC CC))) s'
        ((s'.upd W (.int (2 ^ e) :: LW)).upd CC (.int (c + -1) :: LC)) (2000 * (n + 3)) := by
    intro s' hW' hE' hC'
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, hW', hE', hC', zsz_neg_one,
      two_pow_add_div', two_pow_add_mod', zsz_zero]
    first | exact ⟨by (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), by (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)⟩ | (simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega) | (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  have h7 := h7g s6 (by simp +decide [s6, s5, s4, s3, s2, s1, hW])
    (by simp +decide [s6, s5, s4, s3, s2, s1, hE]) (by simp +decide [s6, s5, s4, s3, s2, s1, hC])
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 (IRuns.seq h5
    (IRuns.seq h6 h7)))))).mono' ?_ (by omega)
  simp only [hs6, hs5, hs4, hs3, hs2, hs1]
  clear * - hV hX
  (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)

theorem ditLoop_runs (s : IState NS) (n E : ℕ) (lo hi : List ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (hlen : lo.length = hi.length)
    (hE : lo.length * E = n) (hcz : zsz (lo.length : ℤ) ≤ n)
    (hlo : Canon (2 ^ n + 1) lo) (hhi : Canon (2 ^ n + 1) hi)
    (hV : s.G V = ints lo ++ RV) (hX : s.G DX = ints hi ++ RX) (hW : s.G W = .int (2 ^ n) :: LW)
    (hC : s.G CC = .int lo.length :: LC) (hDE : s.G DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) ditStep) s
      (((((((s.upd V RV).upd DX RX).upd P1
        ((ints (dcomX (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G P1)).upd P2
        ((ints (dcomY (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G P2)).upd W
          (.int 1 :: LW)).upd CC (.int 0 :: LC)))
      (lo.length * (150000 * (n + 3) + 30) + 30) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set L0 := lo.zip hi with hL0
  have hm1 : L0.map Prod.fst = lo := by simp [L0, List.map_fst_zip, hlen]
  have hm2 : L0.map Prod.snd = hi := by simp [L0, List.map_snd_zip, hlen]
  have hl0 : L0.length = lo.length := by simp [L0, hlen]
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → IState NS := fun D R =>
    ((((((s.upd V (ints (R.map Prod.fst) ++ RV)).upd DX (ints (R.map Prod.snd) ++ RX)).upd P1
      ((ints (dcomX F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P1)).upd P2
      ((ints (dcomY F n E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P2)).upd W
        (.int (2 ^ (n - D.length * E)) :: LW)).upd CC (.int (R.length : ℤ) :: LC))
  have h0 : St [] L0 = s := by
    apply IState.ext' <;> intros <;> simp [St, hm1, hm2, hV, hX, hW, hC, hl0, dcomX, dcomY] <;>
      split_ifs <;> simp_all
  have hk : St L0 [] = (((((((s.upd V RV).upd DX RX).upd P1
        ((ints (dcomX F n E 0 lo hi)).reverse ++ s.G P1)).upd P2
        ((ints (dcomY F n E 0 lo hi)).reverse ++ s.G P2)).upd W
          (.int 1 :: LW)).upd CC (.int 0 :: LC))) := by
    simp [St, hm1, hm2, hl0, hE]
  have := IRuns.loopList (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := ditStep) L0 St (150000 * (n + 3))
    (by intro D x R _; simp [St]; omega)
    (by simp [St])
    (by
      intro D x R hD
      have hmem : x ∈ L0 := by rw [← hD]; simp
      have hx1 : x.1 ∈ lo := by rw [← hm1]; exact List.mem_map_of_mem hmem
      have hx2 : x.2 ∈ hi := by rw [← hm2]; exact List.mem_map_of_mem hmem
      have hlD : D.length + 1 + R.length = lo.length := by
        rw [← hl0, ← hD]; simp; omega
      have hc : zsz ((R.length + 1 : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hcz
      have hDE1 : (D.length + 1) * E ≤ n := by rw [← hE]; exact Nat.mul_le_mul_right _ (by omega)
      have e7 : n - D.length * E = (n - (D.length + 1) * E) + E := by
        have : (D.length + 1) * E = D.length * E + E := by ring
        omega
      have hst := ditStep_runs (I := I) (iprog := iprog) (St D (x :: R)) n
        (n - (D.length + 1) * E) E x.1 x.2 ((R.length + 1 : ℕ) : ℤ) (ints (R.map Prod.fst) ++ RV)
        (ints (R.map Prod.snd) ++ RX) LW LC LE LN LF hn (by omega) (hlo _ hx1) (hhi _ hx2) hc
        (by simp +decide [St]) (by simp +decide [St]) (by simp +decide [St, e7])
        (by simp +decide [St]) (by simp +decide [St, hDE]) (by simp +decide [St, hN])
        (by simp +decide [St, hF, hFdef])
      refine hst.mono' ?_ le_rfl
      have e4 := dcomX_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      have e5 := dcomY_snoc F n E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      simp only [List.length_map, zero_add] at e4 e5
      rw [e7] at e4 e5
      simp only [St, List.map_append, List.map_cons, List.map_nil, e4, e5, List.length_append,
        List.length_singleton]
      apply IState.ext' <;> intros <;> simp [ints_append] <;> split_ifs <;> simp_all)
  rw [h0, hk, hl0] at this
  exact this

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pT : Fin P) (hP : iprog pT = ditBody pT) (n : ℕ) (hn : 1 ≤ n) :
    ∀ j (s : IState NS) (B : List ℤ) (R LL LE LN LF : List Item) (E : ℕ),
      B.length = 2 ^ j → (j = 0 ∨ 2 ^ j * E = 2 * n) → Canon (2 ^ n + 1) B →
      s.G DX = ints B ++ R → s.G DL = .int (2 ^ j) :: LL → s.G DE = .int (2 ^ E) :: LE →
      s.G RN = .int (2 ^ n) :: LN → s.G RF = .int (2 ^ n + 1) :: LF →
      IRuns I iprog (.call pT) s (s.upd DX (ints (ditZ (2 ^ n + 1) n E j B) ++ R))
        (ditCost n j) := by
  intro j
  induction j with
  | zero =>
    intro s B R LL LE LN LF E hB _ _ hX hL _ _ _
    refine IRuns.mono (IRuns.call (c := 6030) ?_) (by simp only [ditCost]; omega)
    rw [hP]
    have h1 := difTest_runs (I := I) (iprog := iprog) s 1 LL 1 (by simpa using hL) (by simp [zsz_one])
    have h2 : IRuns I iprog (.ite CC (fun c => c == .zero) (.op (.drop CC))
        (.seq (.op (.drop CC)) (ditMain pT))) (s.upd CC (.int (1 + -1) :: s.G CC)) s 30 := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, zsz_zero]
    exact (IRuns.seq h1 h2).mono' (by simp [ditZ, hX]) (by omega)
  | succ j ih =>
    intro s B R LL LE LN LF E hB hjE hcB hX hL hDE hN hF
    have hjE' : 2 ^ j * E = n := by
      rcases hjE with h | h
      · omega
      · rw [pow_succ] at h; linarith
    obtain ⟨h, hh⟩ : ∃ h, h = 2 ^ j := ⟨_, rfl⟩
    have hB2 : B.length = 2 * h := by rw [hB, hh, pow_succ, mul_comm]
    rw [← hh] at hjE'
    have hE1 : 1 ≤ E := by
      rcases Nat.eq_zero_or_pos E with h0 | h0
      · rw [h0] at hjE'; omega
      · exact h0
    have hhn : h ≤ n := by nlinarith
    have hEn : E ≤ n := by
      rw [← hjE']; exact Nat.le_mul_of_pos_left _ (by rw [hh]; exact Nat.one_le_two_pow)
    have hjn : j + 1 ≤ n := by
      have : j < 2 ^ j := Nat.lt_two_pow_self
      omega
    have hh1 : 1 ≤ h := by rw [hh]; exact Nat.one_le_two_pow
    have e3 : ((h : ℕ) : ℤ) = 2 ^ j := by rw [hh]; push_cast; rfl
    have hF0 : (0 : ℤ) < 2 ^ n + 1 := by positivity
    set top := B.take h with htop
    set bot := B.drop h with hbot
    have hBlh : B = top ++ bot := (List.take_append_drop h B).symm
    have htopl : top.length = h := by rw [List.length_take, hB2]; omega
    have hbotl : bot.length = h := by rw [List.length_drop, hB2]; omega
    have hctop : Canon (2 ^ n + 1) top := fun a ha => hcB a (List.mem_of_mem_take ha)
    have hcbot : Canon (2 ^ n + 1) bot := fun a ha => hcB a (List.mem_of_mem_drop ha)
    have hzh : zsz (h : ℤ) ≤ n := le_trans (zsz_natCast_le_self h) hhn
    set dt := ditZ (2 ^ n + 1) n (2 * E) j top with hdt
    set db := ditZ (2 ^ n + 1) n (2 * E) j bot with hdb
    have hdtl : dt.length = h := by rw [hdt, length_ditZ _ _ j _ _ (by rw [htopl, hh]), hh]
    have hdbl : db.length = h := by rw [hdb, length_ditZ _ _ j _ _ (by rw [hbotl, hh]), hh]
    have hcdt : Canon (2 ^ n + 1) dt := canon_ditZ hF0 n j _ _ hctop
    have hcdb : Canon (2 ^ n + 1) db := canon_ditZ hF0 n j _ _ hcbot
    set X := dcomX (2 ^ n + 1) n E 0 dt db with hXd
    set Y := dcomY (2 ^ n + 1) n E 0 dt db with hYd
    have hXl : X.length = h := by rw [hXd, length_dcomX _ _ _ _ _ _ (by rw [hdtl, hdbl]), hdtl]
    have hYl : Y.length = h := by rw [hYd, length_dcomY _ _ _ _ _ _ (by rw [hdtl, hdbl]), hdtl]
    have hcX : Canon (2 ^ n + 1) X := canon_dcomX hF0 n E 0 dt db
    have hcY : Canon (2 ^ n + 1) Y := canon_dcomY hF0 n E 0 dt db
    -- test and branch
    have hz2 : zsz ((2 : ℤ) ^ (j + 1)) ≤ n + 1 := by rw [zsz_two_pow]; omega
    have h1 := difTest_runs (I := I) (iprog := iprog) s (2 ^ (j + 1)) LL (n + 1) hL hz2
    have hne : (2 : ℤ) ^ (j + 1) + -1 ≠ 0 := by
      have : (2 : ℤ) ≤ 2 ^ (j + 1) := by
        calc (2 : ℤ) = 2 ^ 1 := by norm_num
          _ ≤ 2 ^ (j + 1) := pow_le_pow_right₀ (by norm_num) (by omega)
      linarith
    -- segment A
    set s1 := s.upd HH (.int (h : ℤ) :: s.G HH) with hs1
    have hA' : IRuns I iprog (.seq (.op (.drop CC)) difSegA)
        (s.upd CC (.int (2 ^ (j + 1) + -1) :: s.G CC)) s1 (10000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [difSegA, IStmt.run, IOp.run, hL, zsz_zero, two_pow_succ_div',
        two_pow_succ_mod']
      refine ⟨by rw [hs1, e3]; clear * - hL; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
      have := zsz_add_le ((2 : ℤ) ^ (j + 1)) (-1)
      rw [zsz_neg, zsz_one] at this
      have hc2 : zsz (2 : ℤ) = 2 := by rw [show (2 : ℤ) = 2 ^ 1 by norm_num, zsz_two_pow]
      rw [hc2]
      have hzz : zsz ((2 : ℤ) ^ j) ≤ n := by rw [zsz_two_pow]; omega
      have hb : zsz ((2 : ℤ) ^ (j + 1) + -1) ≤ n + 2 :=
        le_trans this (by rw [zsz_two_pow]; exact Nat.add_le_add_right (max_le (by omega) (by omega)) 1)
      clear * - hb hzz hjn hz2
      simp only [moveCost, addIntCost, addMagCost, subMagCost, dupCost, zipCost, splitCost,
        takeCost] at *
      omega
    -- segment E: child parameters
    set s2 := (s1.upd DL (.int (h : ℤ) :: .int (2 ^ (j + 1)) :: LL)).upd DE
      (.int (2 ^ (2 * E)) :: .int (2 ^ E) :: LE) with hs2
    have hE : IRuns I iprog difSegE s1 s2 (2000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      have e : (2 : ℤ) ^ E * 2 ^ E = 2 ^ (2 * E) := by ring
      simp +decide [difSegE, IStmt.run, IOp.run, s1, hL, hDE, e]
      refine ⟨by simp only [hs2, hs1]; clear * - hL hDE; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
      have := dupCost_le (zsz (h : ℤ)); have := dupCost_le (zsz ((2 : ℤ) ^ E))
      have := shlCost_le E; have := moveIntCost_le (zsz ((2 : ℤ) ^ (2 * E)))
      simp only [zsz_two_pow] at *
      have := hzh
      omega
    -- first recursive call (top half)
    have hc1 := ih s2 top (ints bot ++ R) (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF
      (2 * E) (by rw [htopl, hh]) (by right; rw [← hh]; linarith) hctop
      (by simp +decide [s2, s1, hX, hBlh, ints_append])
      (by simp +decide [s2, e3]) (by simp +decide [s2])
      (by simp +decide [s2, s1, hN]) (by simp +decide [s2, s1, hF])
    set s3 := s2.upd DX (ints dt ++ (ints bot ++ R)) with hs3
    have hB' := mvH_runs (I := I) (iprog := iprog) (X := DX) (Y := U) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s3 dt (ints bot ++ R) (s.G HH)
      (n + 1) (by simp [s3]) (by simp +decide [s3, s2, s1, hdtl]) (canon_bnd hcdt)
    set s4 := (s3.upd DX (ints bot ++ R)).upd U ((ints dt).reverse ++ s3.G U) with hs4
    -- second recursive call (bottom half)
    have hc2 := ih s4 bot R (.int (2 ^ (j + 1)) :: LL) (.int (2 ^ E) :: LE) LN LF
      (2 * E) (by rw [hbotl, hh]) (by right; rw [← hh]; linarith) hcbot
      (by simp +decide [s4])
      (by simp +decide [s4, s3, s2, e3]) (by simp +decide [s4, s3, s2])
      (by simp +decide [s4, s3, s2, s1, hN]) (by simp +decide [s4, s3, s2, s1, hF])
    set s5 := s4.upd DX (ints db ++ R) with hs5
    -- segment F: drop the child parameters
    set s6 := (s5.upd DE (s.G DE)).upd DL (s.G DL) with hs6
    have hF' : IRuns I iprog ditSegF s5 s6 (1000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [ditSegF, IStmt.run, IOp.run, s5, s4, s3, s2, zsz_two_pow]
      refine ⟨by simp only [hs6, hs5, hs4, hs3, hs2]; clear * - hL hDE; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
      omega
    -- segment C: dt from U to V
    have hC := mvH_runs (I := I) (iprog := iprog) (X := U) (Y := V) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s6 dt.reverse (s.G U) (s.G HH)
      (n + 1) (by simp +decide [s6, s5, s4, s3, s2, s1, ints_reverse])
      (by simp +decide [s6, s5, s4, s3, s2, s1, hdtl])
      (fun a ha => canon_bnd hcdt a (List.mem_reverse.mp ha))
    set s7 := (s6.upd U (s.G U)).upd V ((ints dt.reverse).reverse ++ s6.G V) with hs7
    -- segment D: butterflies
    set s7' := (s7.upd W (.int (2 ^ n) :: s.G W)).upd CC (.int (h : ℤ) :: s.G CC) with hs7'
    have hD1 : IRuns I iprog (.seq (.op (.dup RN W)) (.op (.dup HH CC))) s7 s7'
        (1000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, s7, s6, s5, s4, s3, s2, s1, hN]
      refine ⟨by simp only [hs7', hs7, hs6, hs5, hs4, hs3, hs2, hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
      have := dupCost_le (zsz (h : ℤ)); have := dupCost_le (zsz ((2 : ℤ) ^ n))
      rw [zsz_two_pow] at *
      omega
    have hD2 := ditLoop_runs (I := I) (iprog := iprog) s7' n E dt db (s.G V) R (s.G W) (s.G CC)
      LE LN LF hn (by rw [hdtl, hdbl]) (by rw [hdtl]; exact hjE') (by rw [hdtl]; exact hzh)
      hcdt hcdb
      (by simp +decide [s7', s7, s6, s5, s4, s3, s2, s1, ints_reverse])
      (by simp +decide [s7', s7, s6, s5, s4, s3, s2, s1])
      (by simp +decide [s7'])
      (by simp +decide [s7', hdtl])
      (by simp +decide [s7', s7, s6, s5, s4, s3, s2, s1, hDE])
      (by simp +decide [s7', s7, s6, s5, s4, s3, s2, s1, hN])
      (by simp +decide [s7', s7, s6, s5, s4, s3, s2, s1, hF])
    set s8 := (((s.upd HH (.int (h : ℤ) :: s.G HH)).upd DX R).upd P1
      ((ints X).reverse ++ s.G P1)).upd P2 ((ints Y).reverse ++ s.G P2) with hs8
    have hD3 : IRuns I iprog (.seq (.op (.drop CC)) (.op (.drop W)))
        (((((((s7'.upd V (s.G V)).upd DX R).upd P1
          ((ints (dcomX (2 ^ n + 1) n E 0 dt db)).reverse ++ s7'.G P1)).upd P2
          ((ints (dcomY (2 ^ n + 1) n E 0 dt db)).reverse ++ s7'.G P2)).upd W
            (.int 1 :: s.G W)).upd CC (.int 0 :: s.G CC)))
        s8 (1000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, zsz_zero, zsz_one]
      refine ⟨?_, by omega⟩
      simp only [hs8, hs7', hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXd, hYd]
      clear * -
      apply IState.ext'
      · intro x; fin_cases x <;> simp +decide [IState.upd_G] <;> rfl
      · simp
      · simp
    -- segments G, H: results back to DX
    have hG := mvH_runs (I := I) (iprog := iprog) (X := P2) (Y := DX) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s8 Y.reverse (s.G P2)
      (s.G HH) (n + 1) (by simp +decide [s8, ints_reverse]) (by simp +decide [s8, hYl])
      (fun a ha => canon_bnd hcY a (List.mem_reverse.mp ha))
    set s9 := (s8.upd P2 (s.G P2)).upd DX ((ints Y.reverse).reverse ++ s8.G DX) with hs9
    have hH := mvH_runs (I := I) (iprog := iprog) (X := P1) (Y := DX) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s9 X.reverse (s.G P1)
      (s.G HH) (n + 1) (by simp +decide [s9, s8, ints_reverse]) (by simp +decide [s9, s8, hXl])
      (fun a ha => canon_bnd hcX a (List.mem_reverse.mp ha))
    set s10 := (s9.upd P1 (s.G P1)).upd DX ((ints X.reverse).reverse ++ s9.G DX) with hs10
    have hHH : s10.G HH = .int (h : ℤ) :: s.G HH := by simp +decide [s10, s9, s8]
    have hI0 : IRuns I iprog (.op (.drop HH)) s10 (s10.upd HH (s.G HH)) (1000 * (n + 3)) := by
      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, hHH]
      omega
    have hI : IRuns I iprog (.op (.drop HH)) s10
        (s.upd DX (ints (ditZ (2 ^ n + 1) n E (j + 1) B) ++ R)) (1000 * (n + 3)) := by
      refine hI0.mono' ?_ le_rfl
      have e4 : ditZ (2 ^ n + 1) n E (j + 1) B = X ++ Y := by
        rw [hXd, hYd, hdt, hdb, htop, hbot, ditZ, hh]
      rw [e4, ints_append, List.append_assoc]
      simp only [hs10, hs9, hs8, ints_reverse, List.reverse_reverse]
      clear * -
      (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
    -- assemble
    have hDseg : IRuns I iprog ditSegD s7 s8 _ :=
      IRuns.seq_assoc (IRuns.seq_assoc (IRuns.seq (IRuns.seq hD1 hD2) hD3))
    have hMain := IRuns.seq hA' (IRuns.seq hE (IRuns.seq hc1 (IRuns.seq hB' (IRuns.seq hc2
      (IRuns.seq hF' (IRuns.seq hC (IRuns.seq hDseg (IRuns.seq hG (IRuns.seq hH hI)))))))))
    have hMain' := IRuns.seq_assoc hMain
    have hite := IRuns.iteF (i := CC) (f := fun c => c == .zero) (p := .op (.drop CC))
      (by simp [hne]) hMain'
    have hbody := IRuns.seq h1 hite
    have hlen1 : dt.reverse.length = h := by simp [hdtl]
    have hlen2 : Y.reverse.length = h := by simp [hYl]
    have hlen3 : X.reverse.length = h := by simp [hXl]
    rw [hlen1, hlen2, hlen3, hdtl] at hbody
    have hcall := IRuns.call (j := pT) (iprog := iprog) (I := I) (by rw [hP]; exact hbody)
    refine hcall.mono ?_
    · have hm1 : h * (1000 * (n + 1 + zsz (h : ℤ) + 3)) ≤ 2000 * (h * (n + 3)) :=
        calc h * (1000 * (n + 1 + zsz (h : ℤ) + 3)) ≤ h * (2000 * (n + 3)) :=
              Nat.mul_le_mul_left _ (by omega)
          _ = 2000 * (h * (n + 3)) := by ring
      have hm2 : h * (150000 * (n + 3) + 30) ≤ 150030 * (h * (n + 3)) :=
        calc h * (150000 * (n + 3) + 30) ≤ h * (150030 * (n + 3)) :=
              Nat.mul_le_mul_left _ (by omega)
          _ = 150030 * (h * (n + 3)) := by ring
      have hdc : ditCost n (j + 1) = 2 * ditCost n j + 1000000 * (h * (n + 3)) := by
        simp only [ditCost, hh, pow_succ]; ring
      have hh3 : n + 3 ≤ h * (n + 3) := Nat.le_mul_of_pos_left _ hh1
      rw [hdc]
      omega
end
