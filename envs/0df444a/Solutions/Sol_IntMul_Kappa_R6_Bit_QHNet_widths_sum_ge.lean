-- Source module: Solutions.R6BitNBObst
/-!
# Round six, bit side: the label route `prop11H_labels` admits **no saving**

`prop11H_labels` (R6BitProp11) derives `C.OK` from `EdgesOK`, `LabOK`, `ScalarOK`: every gate
touches wires with *equal* frame labels, and every role ends at label `swapMat`. This file proves
that these hypotheses force the total child width to be at least `W m`:

* the `H × D` block `hdB` of a frame matrix is subadditive in rank under products
  (`rank_hdB_mul_le`), vanishes on lower triangular Bruhat factors and on `1`, and has rank `m`
  on `swapMat`;
* an edge `E₁ σ E₂` therefore has `rank hdB ≤ #transpositions ≤ Σ run widths`
  (`rank_hdB_edgeMat_le`);
* along each role wire the labels go from `1` to `swapMat`, so each of the `W` (distinct, by
  `ScalarOK`) role wires carries edges of total width `≥ m` (`widths_sum_ge`).

Consequently `histMoment C.hist m τ ≥ W` for every `0 < τ ≤ 1` (`labels_no_saving`): the
hypotheses of `prop11H_labels` are **jointly inconsistent** (`prop11H_labels_vacuous`), and in
particular no network with the histogram `Jain.bitR6` (rank sum `W m − 1344189`) satisfies them
(`no_bitR6_labels`).

The real two-stage network escapes this because its data outputs are sums of terms at
*different* frames (`B = F x + E y`, fixed by the copy correction `T F = E`), which the
single-label invariant cannot express. See `R6BitNBFormal` for the replacement calculus.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

/-! ## Blocks of `2m × 2m` matrices -/

section Blocks

variable {K : Type*} [Field K] {m : ℕ}

lemma hdB_mul (X Y : Matrix (Fin (m + m)) (Fin (m + m)) K) :
    hdB (X * Y) = hhB X * hdB Y + hdB X * ddB Y := by
  ext i j
  simp only [hdB, hhB, ddB, Matrix.mul_apply, Matrix.add_apply, Fin.sum_univ_add]

lemma rank_add_le' {n : ℕ} (A B : Matrix (Fin n) (Fin n) K) : (A + B).rank ≤ A.rank + B.rank := by
  unfold Matrix.rank
  rw [Matrix.mulVecLin_add]
  exact (Submodule.finrank_mono (LinearMap.range_add_le _ _)).trans
    (Submodule.finrank_add_le_finrank_add_finrank _ _)

lemma rank_hdB_mul_le (X Y : Matrix (Fin (m + m)) (Fin (m + m)) K) :
    (hdB (X * Y)).rank ≤ (hdB X).rank + (hdB Y).rank := by
  rw [hdB_mul]
  refine (rank_add_le' _ _).trans ?_
  have h1 := rank_mul_le_right (hhB X) (hdB Y)
  have h2 := rank_mul_le_left (hdB X) (ddB Y)
  omega

lemma hdB_eq_zero_of_lower {M : Matrix (Fin (m + m)) (Fin (m + m)) K}
    (h : ∀ i j, i < j → M i j = 0) : hdB M = 0 := by
  ext i j; exact h _ _ (castAdd_lt_natAdd i j)

lemma hdB_one : hdB (1 : Matrix (Fin (m + m)) (Fin (m + m)) K) = 0 := by
  ext i j; simp [hdB, Matrix.one_apply_ne (castAdd_ne_natAdd i j)]

lemma rank_hdB_one : (hdB (1 : Matrix (Fin (m + m)) (Fin (m + m)) K)).rank = 0 := by
  rw [hdB_one, Matrix.rank_zero]

/-- A product of `k` transpositions has `H × D` rank at most `k`. -/
lemma rank_hdB_prod_swap_le (L : List (Fin (m + m) × Fin (m + m))) :
    (hdB ((L.map fun p => Equiv.swap p.1 p.2).prod.permMatrix K)).rank ≤ L.length := by
  induction L with
  | nil => simp [Matrix.permMatrix_one, rank_hdB_one]
  | cons p L ih =>
    simp only [List.map_cons, List.prod_cons, Matrix.permMatrix_mul, List.length_cons]
    have := rank_hdB_mul_le ((L.map fun p => Equiv.swap p.1 p.2).prod.permMatrix K)
      ((Equiv.swap p.1 p.2).permMatrix K)
    have := rank_hdB_swap_le (K := K) p.1 p.2
    omega

lemma hdB_swapMat {q : ℕ} : hdB (swapMat : Matrix (Fin (m + m)) (Fin (m + m)) (ZMod q)) = 1 := by
  ext i j
  simp [hdB, swapMat, blk, -Fin.natAdd_eq_addNat, Matrix.one_apply]

end Blocks

/-! ## Edges and label paths -/

section Paths

variable {R : Type*} [CommRing R] {m : ℕ}

lemma pivCnt_le (e : Edge m) : pivCnt e ≤ (e.runs.map fun ρ => ρ.2.2).sum := by
  unfold pivCnt
  induction e.runs with
  | nil => simp
  | cons ρ l ih =>
    simp only [List.flatMap_cons, List.length_append, List.map_cons, List.sum_cons]
    have : (runPiv m ρ).length ≤ ρ.2.2 := by
      unfold runPiv
      exact (List.length_filterMap_le _ _).trans (by simp)
    omega

variable {q : ℕ} [Fact q.Prime]

/-- The edge matrix of an admissible edge has `H × D` rank at most its number of transpositions. -/
lemma rank_hdB_edgeMat_le {e : Edge m} (he : EdgeOK q e) :
    (hdB (edgeMat q e)).rank ≤ pivCnt e := by
  obtain ⟨h1, h2, -, -⟩ := he
  unfold edgeMat
  have a := rank_hdB_mul_le (redM q e.E₁ *
    ((e.runs.flatMap (runPiv m)).map fun p => Equiv.swap p.1 p.2).prod.permMatrix (ZMod q))
    (redM q e.E₂)
  have b := rank_hdB_mul_le (redM q e.E₁)
    (((e.runs.flatMap (runPiv m)).map fun p => Equiv.swap p.1 p.2).prod.permMatrix (ZMod q))
  have c := rank_hdB_prod_swap_le (K := ZMod q) (e.runs.flatMap (runPiv m))
  rw [hdB_eq_zero_of_lower (M := redM q e.E₁) (redM_lower h1), Matrix.rank_zero] at b
  rw [hdB_eq_zero_of_lower (M := redM q e.E₂) (redM_lower h2), Matrix.rank_zero] at a
  unfold pivCnt; omega

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr]

lemma rank_label_le : ∀ (prog : List (Instr Wr R m)), (∀ e ∈ progEdges prog, EdgeOK q e) →
    ∀ (F : Wr → Matrix (Fin (m + m)) (Fin (m + m)) (ZMod q)) (w : Wr),
      (hdB (prog.foldl (labStepH q) F w)).rank ≤ (hdB (F w)).rank + edgeCnt prog w := by
  intro prog
  induction prog with
  | nil => intro _ F w; simp [edgeCnt]
  | cons i l ih =>
    intro hE F w
    have hE' : ∀ e ∈ progEdges l, EdgeOK q e :=
      fun e he => hE e (by rw [progEdges_cons]; exact List.mem_append_right _ he)
    rw [List.foldl_cons]
    refine (ih hE' _ w).trans ?_
    cases i with
    | gate g S => simp [labStepH, edgeCnt]
    | edge w' e =>
      have he : EdgeOK q e := hE e (by rw [progEdges_cons]; simp [Instr.edgeOf])
      simp only [labStepH, edgeCnt]
      by_cases h : w' = w
      · subst h
        rw [Function.update_self, if_pos rfl]
        have := rank_hdB_mul_le (edgeMat q e) (F w')
        have := rank_hdB_edgeMat_le he
        omega
      · rw [Function.update_of_ne (Ne.symm h), if_neg h]; omega

lemma sum_edgeCnt : ∀ prog : List (Instr Wr R m),
    ∑ w, edgeCnt prog w = ((progEdges prog).map pivCnt).sum := by
  intro prog
  induction prog with
  | nil => simp [edgeCnt, progEdges]
  | cons i l ih =>
    rw [progEdges_cons]
    cases i with
    | gate g S => simpa [edgeCnt, Instr.edgeOf] using ih
    | edge w' e =>
      simp only [edgeCnt, Finset.sum_add_distrib, ih, Instr.edgeOf, Option.toList_some,
        List.singleton_append, List.map_cons, List.sum_cons, Finset.sum_ite_eq, Finset.mem_univ,
        if_true]

end Paths

/-! ## The bound -/

namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

lemma widths_sum_eq (C : QHNet R W T m) :
    C.widths.sum = ((C.edges.map fun e => (e.runs.map fun ρ => ρ.2.2).sum)).sum := by
  unfold widths
  induction C.edges with
  | nil => simp
  | cons e l ih => simp [List.flatMap_cons, ih]

lemma rho_injective [Nontrivial R] {C : QHNet R W T m} (hsc : C.ScalarOK) :
    Function.Injective C.ρ := by
  intro w₁ w₂ h
  by_contra hne
  have e₁ := hsc (fun w => if w = w₁ then 1 else 0) w₁
  have e₂ := hsc (fun w => if w = w₁ then 1 else 0) w₂
  rw [h] at e₁
  rw [e₁, if_pos rfl, if_neg (Ne.symm hne)] at e₂
  exact one_ne_zero e₂

/-- **Single-label networks save nothing.** Under the hypotheses of `prop11H_labels` (at one
prime field size `q`), the total child width is at least `W m`. -/
theorem widths_sum_ge_sol_aux [Nontrivial R] (C : QHNet R W T m) {q : ℕ} (hq : q.Prime)
    (hE : C.EdgesOK q) (hlab : C.LabOK q) (hsc : C.ScalarOK) : W * m ≤ C.widths.sum := by
  have : Fact q.Prime := ⟨hq⟩
  have hinj : Function.Injective (fun w => (Sum.inl (C.ρ w) : Fin W ⊕ Fin T)) :=
    Sum.inl_injective.comp (rho_injective hsc)
  have hrole : ∀ w : Fin W, m ≤ edgeCnt C.prog (Sum.inl (C.ρ w) : Fin W ⊕ Fin T) := by
    intro w
    have h := rank_label_le (q := q) C.prog hE (fun _ => 1) (.inl (C.ρ w))
    rw [hlab.2 w, hdB_swapMat, Matrix.rank_one, Fintype.card_fin, rank_hdB_one] at h
    omega
  calc W * m = ∑ _w : Fin W, m := by simp
    _ ≤ ∑ w : Fin W, edgeCnt C.prog (Sum.inl (C.ρ w) : Fin W ⊕ Fin T) :=
        Finset.sum_le_sum fun w _ => hrole w
    _ = ∑ x ∈ Finset.univ.map ⟨_, hinj⟩, edgeCnt C.prog x := by rw [Finset.sum_map]; rfl
    _ ≤ ∑ x, edgeCnt C.prog x := Finset.sum_le_sum_of_subset (Finset.subset_univ _)
    _ = ((progEdges C.prog).map pivCnt).sum := sum_edgeCnt _
    _ ≤ C.widths.sum := by
        rw [widths_sum_eq, edges]
        exact List.sum_le_sum fun e _ => pivCnt_le e

end QHNet

end IntMul.Kappa.R6.Bit

