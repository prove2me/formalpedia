variable {ι κ : Type*} [Fintype ι] [Fintype κ]
theorem solution {κ : Type*} {X : κ → ℂ} {c : κ → ℤ}
    (h : ∀ j, ‖X j - (c j : ℂ)‖ < 1 / 2) (j : κ) : round (X j).re = c j := by
  apply IntMul.OpenAI.RF.round_recovers
  have := (Complex.abs_re_le_norm (X j - (c j : ℂ))).trans_lt (h j)
  simpa using this
end
