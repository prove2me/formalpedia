section
-- Source module: Solutions.KFV43ErrNeed
/-!
# KFV §46: the error interface of Proposition 18 (`Err18Need`)

The uniform Proposition 18 program computes, on coefficient vectors (exactly, by `layIn_ok`,
`fwdC_ok`, the Kronecker pointwise step `ppq`, `oppC_ok`, the scaling by `M = 2^{Σ a_i}` and
`layOut_ok`), the list **`pipe18c`**:

  `Lout (M • procQIc (zipWith ppq (procQc (Lin xf)) (procQc (Lin xg))))`

with `Lin` / `Lout` the `pull`s by `relabel initL tgtL` / `relabel tgtL initL` (row-major ↔ the
paper's layout `paperLayout`). **`Err18Need`** is the pure error statement: this list is within
`2 N (3ℓ + 1) 2^{-p}` of `mrL` (the bound `P18IL` asks for), and `mrL` has coefficients of
modulus `≤ 1`. It follows from
`GlueProp18.prop18_error_paper` (with `√2 ≤ 2`, `Mv = N`) through `rrModel (2^ℓ - 1)`,
`co_procQ`, `co_procQI`, `co_ppq` and the row-major / layout correspondence.
-/

namespace NLogN.KFV

open Synth AModel GlueLayout

noncomputable section

/-- The axis lengths `t_i = 2^{a_i}` of the paper's parameters. -/
def ts18 (D ℓ : ℕ) (long : Fin D → Bool) : List ℕ := List.ofFn fun i : Fin D => 2 ^ al D ℓ long i

/-- The coefficient-level Proposition 18 pipeline computed by the uniform program. -/
def pipe18c (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool) (hK : 0 < K) (hℓ : 1 ≤ ℓ) (p : ℕ)
    (xf xg : List (Fin (2 ^ ℓ) → ℂ)) : List (Fin (2 ^ ℓ) → ℂ) :=
  let n := (tgtL D ℓ K long).length
  let Lin : List (Fin (2 ^ ℓ) → ℂ) → List (Fin (2 ^ ℓ) → ℂ) :=
    pull (binSh n) (binSh n) (relabel (initL D ℓ long) (tgtL D ℓ K long)) 0
  let Lout : List (Fin (2 ^ ℓ) → ℂ) → List (Fin (2 ^ ℓ) → ℂ) :=
    pull (binSh n) (binSh n) (relabel (tgtL D ℓ K long) (initL D ℓ long)) 0
  let F := procQc (r := 2 ^ ℓ) p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long))
    (paperSel D ℓ K long hK hℓ) ℓ
  let G := procQIc (r := 2 ^ ℓ) p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long))
    (paperSel D ℓ K long hK hℓ) ℓ
  Lout ((G (List.zipWith (ppq (2 ^ ℓ) p) (F (Lin xf)) (F (Lin xg)))).map
    fun v => (Mv (al D ℓ long) : ℂ) • v)

/-- **The error interface of Proposition 18** (pure mathematics; no IL). -/
def Err18Need : Prop :=
  ∀ (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool) (hK : 0 < K) (hℓ1 : 1 ≤ ℓ), 2 ≤ ℓ →
    1 ≤ qq ℓ K → ∀ (p : ℕ) (xf xg : List (Fin (2 ^ ℓ) → ℂ)),
    xf.length = (ts18 D ℓ long).prod → xg.length = (ts18 D ℓ long).prod →
    (∀ x ∈ xf, ‖x‖ ≤ 1) → (∀ x ∈ xg, ‖x‖ ≤ 1) →
    (pipe18c D ℓ K long hK hℓ1 p xf xg).length = (ts18 D ℓ long).prod ∧
    (∀ j < (ts18 D ℓ long).prod, ∀ k : Fin (2 ^ ℓ),
      ‖(KFM.mrL (2 ^ ℓ) (ts18 D ℓ long) xf xg).getD j 0 k‖ ≤ 1) ∧
    ∀ j < (ts18 D ℓ long).prod, ∀ k : Fin (2 ^ ℓ),
      ‖(pipe18c D ℓ K long hK hℓ1 p xf xg).getD j 0 k -
          (KFM.mrL (2 ^ ℓ) (ts18 D ℓ long) xf xg).getD j 0 k‖ ≤
        2 * (ts18 D ℓ long).prod * (3 * ℓ + 1) * (2 : ℝ)⁻¹ ^ p

end

end NLogN.KFV

end

section
-- Source module: Solutions.KFV44SetupNeed
/-!
# KFV §47: the setup interface of Proposition 18 (`Setup18Need`)

The uniform Proposition 18 program starts from the descriptor `desc18 p ℓ K ts` on stack
`dS18 = 33` and data on stack `0`, all other managed stacks empty. **`Setup18Need`** asks for two
fixed codes (no calls, any table):

* `setup` reads the descriptor and builds the register frame **`regs18 p ℓ K ts`** under the data:
  `encK s f ⟶ encK (encK s (regs18 …)) (o0 (f 0))`;
* `teardown` removes it again: `encK (encK s (regs18 …)) (o0 v) ⟶ encK s (update f 0 v)`;

each with cost `≤ Cs (|ts| + ℓ + K + zsz p + 2)^4`.

The frame (`D = |ts|`, flag `i` = "axis `i` is long" = `t_i = 2^ℓ`, `b = (ℓ-1) mod K`,
`q = (ℓ-1)/K`, `nL` = number of long axes, `Lst = nL + b D`, `n = Lst + D q K`):

| stack | `gD` 40 | `gLl` 41 | `gKk` 42 | `gBb` 43 | `gQq` 44 | `gNL` 45 | `gLst` 46 | `gNn` 47 |
|---|---|---|---|---|---|---|---|---|
| value | `[D]` | `[ℓ]` | `[K]` | `[b]` | `[q]` | `[nL]` | `[Lst]` | `[n]` |

| stack | `gH` 48 | `gLG` 49 | `gMk` 53 | `gPp` 30 | `gWw` 31 | `gZz` 32 | `dS18` 33 |
|---|---|---|---|---|---|---|---|
| value | `[0]` | `fl.map fv` (`-1` long, `0` short; axis 0 on top) | `[mkOf fl]` | `[p]` | `[p+2]` | `[n+ℓ+8]` | `desc18 p ℓ K ts` |

and `[]` on every other stack.
-/

namespace NLogN.KFV

open IntMul KIL Synth

/-- The descriptor stack of Proposition 18. -/
abbrev dS18 : Fin HS := 33

/-- The long-axis flags (`t_i = 2^ℓ`). -/
def fl18 (ℓ : ℕ) (ts : List ℕ) : List Bool := ts.map fun t => decide (t = 2 ^ ℓ)

/-- Number of long axes. -/
def nL18 (ℓ : ℕ) (ts : List ℕ) : ℕ := (fl18 ℓ ts).count true

/-- `Lst = nL + b D`. -/
def lst18 (ℓ K : ℕ) (ts : List ℕ) : ℕ := nL18 ℓ ts + bb ℓ K * ts.length

/-- `n = Lst + D q K`. -/
def n18 (ℓ K : ℕ) (ts : List ℕ) : ℕ := lst18 ℓ K ts + ts.length * qq ℓ K * K

/-- The register frame built by the setup. -/
def regs18 (p ℓ K : ℕ) (ts : List ℕ) (j : Fin HS) : List ℤ :=
  if j = NLogN.KFV.gD then [(ts.length : ℤ)]
  else if j = gLl then [(ℓ : ℤ)]
  else if j = gKk then [(K : ℤ)]
  else if j = gBb then [(bb ℓ K : ℤ)]
  else if j = gQq then [(qq ℓ K : ℤ)]
  else if j = gNL then [(nL18 ℓ ts : ℤ)]
  else if j = gLst then [(lst18 ℓ K ts : ℤ)]
  else if j = gNn then [(n18 ℓ K ts : ℤ)]
  else if j = gH then [0]
  else if j = gLG then (fl18 ℓ ts).map fv
  else if j = gMk then [(mkOf (fl18 ℓ ts) : ℤ)]
  else if j = gPp then [(p : ℤ)]
  else if j = gWw then [((p + 2 : ℕ) : ℤ)]
  else if j = gZz then [((n18 ℓ K ts + ℓ + 8 : ℕ) : ℤ)]
  else if j = dS18 then KFM.desc18 p ℓ K ts
  else []

/-- **The setup interface of Proposition 18.** -/
def Setup18Need : Prop :=
  ∃ (setup teardown : (Pp : ℕ) → IStmt HS Pp) (Cs : ℕ),
  ∀ {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp) (p ℓ K : ℕ) (ts : List ℕ),
    2 ≤ ℓ → 1 ≤ K → 1 ≤ ts.length → (∀ t ∈ ts, t = 2 ^ ℓ ∨ 2 * t = 2 ^ ℓ) →
    ∀ (s : IState HS) (f : Fin HS → List ℤ),
      (∀ j, j ≠ 0 → j ≠ dS18 → f j = []) → f dS18 = KFM.desc18 p ℓ K ts →
      (∃ c, IRuns Isym tbl (setup Pp) (encK s f) (encK (encK s (regs18 p ℓ K ts)) (o0 (f 0))) c ∧
        c ≤ Cs * (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4) ∧
      ∀ v : List ℤ, ∃ c, IRuns Isym tbl (teardown Pp) (encK (encK s (regs18 p ℓ K ts)) (o0 v))
        (encK s (Function.update f 0 v)) c ∧
        c ≤ Cs * (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4

end NLogN.KFV

end

