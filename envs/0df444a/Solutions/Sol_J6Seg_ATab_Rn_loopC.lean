    (fun k hk v hI hx hB => (hb k hk v hI hx hB).mono (fun v' ⟨h1, h2, h3⟩ => ⟨fun j hj => by
        rw [update_of_ne (fun e => hj (by rw [e]; exact hixT))]; exact h1 j hj, h2, h3⟩) le_rfl)
