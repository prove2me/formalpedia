-- title:
--   A one-sided real bound for the cyclic character logarithmic derivative
-- statement:
--   Assume the Galois representation and local–global compatibility statement Row0b with reciprocity laws IsRecT. For a primitive Dirichlet character $\chi$ modulo $N$, let $F_\chi$ be the product of the Dirichlet $L$-functions at modulus $N$ over the cyclic group generated by $\chi$. For each $s$ with $1/2<\Re s\leq 0.8749570698$, prove that there is a real $C$ and arbitrarily small positive real $x$ for which
--   $$
--   \Re\bigl((F_\chi'/F_\chi)(s+x)\bigr)\leq C.
--   $$
--   Only a one-sided bound on the real part along a sequence is required.
-- source:
--   Horizontal-ray bound sufficient for https://prove2.me/theorems/3eb65d38-ff09-4446-80bd-dc26c1d8b0c0, in the cyclic-character setting of https://github.com/leanprover-community/riemann-hypothesis/blob/8f328277481a6178eb0dbbb262b2419a3c8bfe02/src/Development/AutomorphicArithmetic/CharacterBoxes/ZeroFreeAllOfTopG.lean#L30-L38.

import Definitions.Def_AlpoGeB008
import Mathlib.NumberTheory.DirichletCharacter.Orthogonality
import Mathlib.Analysis.Meromorphic.Order

open Filter
open scoped Topology Classical
set_option autoImplicit false

namespace AlpoGe
theorem cyclic_character_logDeriv_real_bounded_frequently_from_right_of_row
    (H : UpperTheory.GalStar.Row0b fun h rc => UpperTheory.Zero.LLC.IsRecT h rc) :
    ∀ (N : ℕ) [NeZero N] (χ : DirichletCharacter ℂ N), χ.IsPrimitive →
      ∀ s : ℂ, 1 / 2 < s.re → s.re ≤ (0.8749570698 : ℝ) →
        ∃ C : ℝ, ∃ᶠ x : ℝ in 𝓝[>] (0 : ℝ),
          (logDeriv (fun w => ∏ η ∈ Finset.univ.filter (· ∈ Subgroup.zpowers χ),
            DirichletCharacter.LFunction η w) (s + (x : ℂ))).re ≤ C := by sorry

end AlpoGe
