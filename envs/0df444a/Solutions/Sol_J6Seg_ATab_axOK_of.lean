-- Source module: Solutions.J6AILTab13
/-!
# A lines, table set-up, part 13: the width conditions at `W = K (p + t + 100)`

From the elementary per-axis facts `AxF` (`0 < s < t`, `1 ≤ α`, `α² ≤ p`, `k < d ≤ p`,
`pre, post, pre·t·post ≤ 2^p`), every width condition `AxOK` of the native set-up holds at
`W = Wd = (40 + pkA + pkC + bA + bC) (p + t + 100)`, `B = W + 1` (**`axOK_of`**).
Everything is `2^{O(p + t)}`: polynomial quantities are `≤ 2^{11} X⁵ ≤ 2^{5X+11}` (`X = p+t+100`),
the scaled tables are `≤ 2^{16p+35}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## Elementary bounds -/

theorem two_pow_ge (n : ℕ) : n < 2 ^ n := Nat.lt_two_pow_self

theorem pow_mono {a b : ℕ} (h : a ≤ b) : 2 ^ a ≤ 2 ^ b := Nat.pow_le_pow_right (by norm_num) h

theorem poly5 {X W C : ℕ} (hC : C ≤ 2 ^ 11) (hW : 5 * X + 11 ≤ W) : C * X ^ 5 ≤ 2 ^ W := by
  have h1 : X ^ 5 ≤ (2 ^ X) ^ 5 := Nat.pow_le_pow_left (two_pow_ge X).le 5
  rw [← pow_mul] at h1
  calc C * X ^ 5 ≤ 2 ^ 11 * 2 ^ (X * 5) := Nat.mul_le_mul hC h1
    _ = 2 ^ (11 + X * 5) := by rw [pow_add]
    _ ≤ 2 ^ W := pow_mono (by omega)

theorem natW {n W : ℕ} (h : n < 2 ^ W) : |(n : ℤ)| < 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]; exact_mod_cast h

theorem sw_le {p α : ℕ} (hαp : α ^ 2 ≤ p) : sWidth p α ≤ 2 * p := by
  rw [J6A.PA.sWidth_eq]
  have h1 : α ≤ Nat.sqrt p := Nat.le_sqrt'.mpr hαp
  have h2 := Nat.sqrt_le' p
  split_ifs <;> nlinarith

theorem sw_pos {p α : ℕ} (hp : 1 ≤ p) (hα : 1 ≤ α) : 1 ≤ sWidth p α := by
  rw [J6A.PA.sWidth_eq]
  have h1 : 1 ≤ Nat.sqrt p := Nat.le_sqrt'.mpr (by simpa using hp)
  split_ifs <;> nlinarith

section
variable {p s t α d k pre post : ℕ} (h : AxF p s t α d k pre post)
include h

theorem H_le : HAx p α ≤ 2 * p :=
  le_trans (Nat.pow_log_le_self 2 (by have := sw_pos h.p1 h.α1; omega)) (sw_le h.αp)

theorem WA_le : J6A.WA p α (HAx p α) ≤ 4 * p + 3 := by
  unfold J6A.WA; have := H_le h; have := sw_le h.αp; omega

theorem nc_le : ncA p t α ≤ t := by
  unfold ncA
  have hH := HAx_pos p α
  have := Nat.div_mul_le_self t (16 * HAx p α)
  nlinarith

theorem α_le : α ≤ p := by nlinarith [h.αp, h.α1]

/-- The block centre of a block of the line. -/
theorem kc_le {q : ℕ} (hq : q < ncA p t α) :
    J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) ≤ t + 2 * p := by
  rw [kcB_kk _ _ (HAx_pos p α)]
  have hH := HAx_pos p α
  have h1 := H_le h
  have h2 : q * (2 * HAx p α) < t := by
    unfold ncA at hq
    have := Nat.div_mul_le_self t (16 * HAx p α)
    set u := t / (16 * HAx p α)
    nlinarith
  omega

theorem jc_le {q : ℕ} (hq : q < ncA p t α) :
    J6A.jcB s t (HAx p α) (J6A.kkA (HAx p α) q) ≤ t + 2 * p + 1 := by
  have hk := kc_le h hq
  unfold J6A.jcB
  have ht : 0 < t := lt_of_le_of_lt (Nat.zero_le _) h.st
  have : (2 * s * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) + t) / (2 * t) ≤
      J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) + 1 := by
    apply Nat.div_le_of_le_mul
    have := h.st
    nlinarith
  exact_mod_cast (by omega : (2 * s * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) + t) / (2 * t) ≤
    t + 2 * p + 1)

theorem jc_nn {q : ℕ} : 0 ≤ J6A.jcB s t (HAx p α) (J6A.kkA (HAx p α) q) := by
  unfold J6A.jcB; positivity

/-- `|t j - s k_c| ≤ 43 X²` for `|j| ≤ C X`, `C ≤ 40`. -/
theorem lin_bnd {X : ℕ} (hXe : Xa p t = X) {q : ℕ} (hq : q < ncA p t α) {j : ℤ} {C : ℕ}
    (hC : C ≤ 40) (hj : |j| ≤ C * (X : ℤ)) :
    |(t : ℤ) * j - s * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q)| ≤ 43 * (X : ℤ) ^ 2 := by
  subst hXe
  have hk : (J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) : ℤ) ≤ 3 * (Xa p t) := by
    have := kc_le h hq; unfold Xa; push_cast; exact_mod_cast (by omega : _ ≤ 3 * (p + t + 100))
  have ht : (t : ℤ) ≤ Xa p t := by unfold Xa; push_cast; omega
  have hs : (s : ℤ) ≤ Xa p t := by have := h.st; unfold Xa; push_cast; omega
  have hX : (0 : ℤ) ≤ Xa p t := by positivity
  have hk0 : (0 : ℤ) ≤ J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) := by positivity
  have hC' : (C : ℤ) ≤ 40 := by exact_mod_cast hC
  calc |(t : ℤ) * j - s * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q)|
      ≤ |(t : ℤ) * j| + |(s : ℤ) * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q)| := abs_sub _ _
    _ = (t : ℤ) * |j| + (s : ℤ) * J6A.kcB (HAx p α) (J6A.kkA (HAx p α) q) := by
        rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : (0 : ℤ) ≤ t),
          abs_of_nonneg (by positivity : (0 : ℤ) ≤ s), abs_of_nonneg hk0]
    _ ≤ (Xa p t : ℤ) * (C * Xa p t) + Xa p t * (3 * Xa p t) := by
        gcongr
    _ ≤ 43 * (Xa p t : ℤ) ^ 2 := by nlinarith

end

/-! ## The conditions -/

theorem le_Wd (pkA pkC bA bC p t : ℕ) :
    Wd pkA pkC bA bC p t = 40 * Xa p t + pkA * Xa p t + pkC * Xa p t + bA * Xa p t +
      bC * Xa p t := by unfold Wd; ring

set_option maxHeartbeats 4000000 in
/-- **The width conditions.** -/
theorem axOK_of_sol_aux {p s t α d k pre post pkA pkC bA bC : ℕ} (h : AxF p s t α d k pre post) :
    AxOK (Wd pkA pkC bA bC p t) (Wd pkA pkC bA bC p t + 1) p s t α pre post k d pkA pkC bA bC := by
  have hWe := le_Wd pkA pkC bA bC p t
  generalize hWd : Wd pkA pkC bA bC p t = W at hWe ⊢
  generalize hXd : Xa p t = X at hWe
  have hX100 : 100 ≤ X := by rw [← hXd]; unfold Xa; omega
  have hpX : p ≤ X := by rw [← hXd]; unfold Xa; omega
  have htX : t ≤ X := by rw [← hXd]; unfold Xa; omega
  have hsX : s ≤ X := by have := h.st; omega
  have hαX : α ≤ X := le_trans (α_le h) hpX
  have hdX : d ≤ X := le_trans h.dp hpX
  have hkX : k ≤ X := by have := h.kd; omega
  have hW40 : 40 * X ≤ W := by rw [hWe]; omega
  have hWA : pkA * X ≤ W := by rw [hWe]; omega
  have hWC : pkC * X ≤ W := by rw [hWe]; omega
  have hWbA : bA * X ≤ W := by rw [hWe]; omega
  have hWbC : bC * X ≤ W := by rw [hWe]; omega
  have hX1 : 1 ≤ X := by omega
  have hpkA : pkA ≤ pkA * X := Nat.le_mul_of_pos_right _ hX1
  have hpkC : pkC ≤ pkC * X := Nat.le_mul_of_pos_right _ hX1
  have hbA : bA ≤ bA * X := Nat.le_mul_of_pos_right _ hX1
  have hbC : bC ≤ bC * X := Nat.le_mul_of_pos_right _ hX1
  have hpk : pkA * p + pkC ≤ pkA * X + pkC * X := by nlinarith
  have hbb : bA * p + bC ≤ bA * X + bC * X := by nlinarith
  have hWlt : W < 2 ^ W := two_pow_ge W
  have hm := sw_le h.αp
  have hH := H_le h
  have hH1 := HAx_pos p α
  have hWA' := WA_le h
  have hnc := nc_le h
  have hpoly : ∀ C, C ≤ 2 ^ 11 → C * X ^ 5 ≤ 2 ^ W := fun C hC => poly5 hC (by omega)
  have hX5 : X ≤ X ^ 5 := by
    calc X = X ^ 1 := (pow_one X).symm
      _ ≤ X ^ 5 := Nat.pow_le_pow_right hX1 (by norm_num)
  have hXlt : ∀ n, n ≤ 2 ^ 11 * X → n < 2 ^ W := fun n hn => by
    have h1 : 2 ^ 11 * X < 2 ^ 11 * 2 ^ X := Nat.mul_lt_mul_of_pos_left (two_pow_ge X) (by norm_num)
    have h2 : 2 ^ 11 * 2 ^ X ≤ 2 ^ W := by rw [← pow_add]; exact pow_mono (by omega)
    omega
  have hQ : J6A.QA p ≤ 6 * p := by unfold J6A.QA; omega
  -- the scaled tables
  have hexp : ∀ e, e ≤ 16 * p + 35 → (2 : ℤ) ^ e < 2 ^ W := fun e he =>
    pow_lt_pow_right₀ (by norm_num) (by omega)
  have h835 : (8 * (p : ℤ) + 35) < 2 ^ (8 * p + 35) := by
    have := two_pow_ge (8 * p + 35); exact_mod_cast this
  have hQp : (0 : ℤ) < 2 ^ J6A.QA p := by positivity
  have h2p : (0 : ℤ) < 2 ^ (2 * p) := by positivity
  have hsc' : ∀ y : ℤ, |y| ≤ 2 ^ J6A.QA p * ((8 * p + 35) * 2 ^ (2 * p)) → |y| < 2 ^ W :=
    fun y hy => by
    calc |y| ≤ _ := hy
      _ < 2 ^ J6A.QA p * (2 ^ (8 * p + 35) * 2 ^ (2 * p)) :=
          mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_right h835 h2p) hQp
      _ = 2 ^ (J6A.QA p + (8 * p + 35 + 2 * p)) := by rw [← pow_add, ← pow_add]
      _ < 2 ^ W := hexp _ (by omega)
  have hsc : ∀ x : ℤ, |x| ≤ (8 * p + 35) * 2 ^ (2 * p) →
      |(2 : ℤ) ^ J6A.QA p * x| < 2 ^ W := fun x hx => by
    apply hsc'
    rw [abs_mul, abs_of_pos hQp]
    exact mul_le_mul_of_nonneg_left hx hQp.le
  have hsc0 : ∀ x : ℤ, |x| ≤ (8 * p + 35) * 2 ^ (2 * p) → |x| < 2 ^ W := fun x hx => by
    apply hsc'
    have h1 : (1 : ℤ) ≤ 2 ^ J6A.QA p := by have := hQp; omega
    have h0 : (0 : ℤ) ≤ (8 * p + 35) * 2 ^ (2 * p) := mul_nonneg (by omega) h2p.le
    calc |x| ≤ (8 * p + 35) * 2 ^ (2 * p) := hx
