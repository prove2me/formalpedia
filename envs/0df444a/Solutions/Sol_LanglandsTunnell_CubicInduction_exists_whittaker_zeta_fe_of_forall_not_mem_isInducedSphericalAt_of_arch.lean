private theorem integrable_torusUnipotentTranslate_mul [SecondCountableTopology A] (μ : Measure Aˣ)
    [IsFiniteMeasureOnCompacts μ] (ν : Measure A) [IsFiniteMeasureOnCompacts ν] {W : GL (Fin 3) A → ℂ}
    (hW : Continuous W) (hWc : HasCompactSupport W) {c w : Aˣ → ℂ} (hc : Continuous c) (hw : Continuous w)
    (g : GL (Fin 3) A) :
    Integrable (fun p : Aˣ × A => W (iotaGL (diagUnitGL2 p.1) * lowerUnipotent21 p.2 * g) * c p.1 * w p.1)
      (μ.prod ν) := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · exact ((hW.comp (continuous_torusUnipotentTranslate g)).mul (hc.comp continuous_fst)).mul (hw.comp continuous_fst)
  · exact ((hasCompactSupport_torusUnipotentTranslate hWc g).mul_right).mul_right

end
