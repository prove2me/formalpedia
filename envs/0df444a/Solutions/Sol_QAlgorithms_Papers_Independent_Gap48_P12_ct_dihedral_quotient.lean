lemma c_ct10 : CTLit.map (E8.scale 5) = CT10Lit := by decide +kernel
lemma c_pw1 : PW.map Prod.fst = CTLit := by decide +kernel
lemma c_pw2 : ∀ p ∈ PW, (evG p.2).k ≤ 16 ∧ keyN 16 (evG p.2) = E8.scale 11 p.1 := by decide +kernel
lemma c_left : ∀ i : Fin 3, ∀ e ∈ CTLit, E8.mul (keyN 5 (G8 i)) e ∈ CT10Lit ∧
    E8.mul (ctE (keyN 5 (G8 i))) e ∈ CT10Lit := by decide +kernel
lemma c_one : E8.scale 5 E8.one ∈ CTLit := by decide +kernel
lemma c_gun : ∀ i : Fin 3, (G8 i).k ≤ 3 ∧
    keyN 6 ((G8 i).mul ⟨(G8 i).k, ctE (G8 i).e⟩) = keyN 6 M8.one := by decide +kernel
lemma c_gin : ∀ i : Fin 3, (G8 i).k ≤ 5 ∧ keyN 5 (G8 i) ∈ CTLit := by decide +kernel

lemma φM_star (x : M8) : star (φM x) = φM ⟨x.k, ctE x.e⟩ := star_lvl _ _

lemma G_unit (i : Fin 3) : φM (G8 i) ∈ Matrix.unitaryGroup Bool ℂ := by
  rw [Matrix.mem_unitaryGroup_iff, φM_star, ← φM_mul, φM_one.symm.trans rfl]
  obtain ⟨h1, h2⟩ := c_gun i
  exact eq_of_key 6 _ _ ⟨by simp [M8.mul]; omega, by simp [M8.one], h2⟩

noncomputable def gU (i : Fin 3) : Matrix.unitaryGroup Bool ℂ := ⟨φM (G8 i), G_unit i⟩

lemma prod_form (a e : E8) (h : E8.mul a e ∈ CT10Lit) :
    (cc ^ 5 • φE a) * (cc ^ 5 • φE e) ∈ img 5 CTLit := by
  rw [← c_ct10, List.mem_map] at h
  obtain ⟨g, hg, hge⟩ := h
  refine ⟨g, hg, ?_⟩
  rw [Matrix.smul_mul, Matrix.mul_smul, smul_smul, ← φE_mul, ← hge, ← pow_add, lvl_up]

lemma evG_spec (w : List (Fin 3)) : φM (evG w) = ((w.map gU).prod : Matrix.unitaryGroup Bool ℂ) := by
  induction w with
  | nil => simp [evG, φM_one]
  | cons i w ih =>
    show φM ((G8 i).mul (evG w)) = _
    rw [φM_mul, ih, List.map_cons, List.prod_cons]; rfl

