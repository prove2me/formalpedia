theorem ModularCurve.modularFunctionFieldC_eq_modularFunctionFieldFullC_of_charZero
    (K : Type*) [Field K] [CharZero K] (N : ℕ) [NeZero N] :
    modularFunctionFieldC K N = modularFunctionFieldFullC K N := by sorry
