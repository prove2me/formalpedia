  have eY : (cYb P n src k ap : ℝ) ≤ 10 ^ 13 * (130 * (Wt ap : ℝ) * p * L3 ^ 2) +
      10 * (32500 * C1 P ap * p * Ln ^ 2) +
      16000 * (2500 * (NLogN.KFZ.Cfm : ℝ) * (Wt ap : ℝ) * p * L3 ^ 2) := by
    have e : (cYb P n src k ap : ℝ) = 10 ^ 13 *
        (((cBH P n src k ap + cBI P n src k ap + axb6 P n src k ap + axpk6 P n src k ap + 10 : ℕ) : ℝ) *
        ((cJ P n : ℝ) + 1) * ((cZ P n src k ap : ℝ) + 5)) + 10 * (cφD P n src k ap : ℝ) +
