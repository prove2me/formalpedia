-- title:
--   Eq. (14): the SAGE E step
-- statement:
--   Let $\mathbf s_l:\mathbb C^{P_l}\to\mathbb C^M$, $l=1,\dots,K$, be the source contributions, each depending only on its own parameter block, let $\boldsymbol\theta^k$ be the current estimate, and let $\mathbf n$ be zero-mean circular complex Gaussian with positive definite covariance $\mathbf\Pi$. Fix the index set $S=\{i\}$ and take the hidden data $\mathbf x^S=\mathbf s_i(\boldsymbol\theta^k_i)+\mathbf n$, carrying all of the noise, so that the observed data are $\mathbf y=\mathbf x^S+\sum_{l\ne i}\mathbf s_l(\boldsymbol\theta^k_l)$. Then, almost surely,
--
--   $$\widehat{\mathbf x^S}=E\{\mathbf x^S\mid\mathbf y,\boldsymbol\theta^k\}=\mathbf s_i(\boldsymbol\theta^k_i)+\Big(\mathbf y-\sum_{l=1}^K\mathbf s_l(\boldsymbol\theta^k_l)\Big)=\mathbf y-\sum_{l=1,\,l\ne i}^K\mathbf s_l(\boldsymbol\theta^k_l).$$
--
--   This is the E step of the SAGE algorithm (Fessler and Hero); its M step fits $\boldsymbol\theta_i$ by minimising $\|\widehat{\mathbf x^S}-\mathbf s_i(\boldsymbol\theta_i)\|^2$.
--
--   **Formalization Note** The conditional expectation is taken with respect to the $\sigma$-algebra generated by $\mathbf y$, with the model evaluated at $\boldsymbol\theta^k$. The first equality is stated almost surely and the second, an algebraic identity, for every outcome. Mathematically the result is a measurability observation: $\mathbf x^S$ is $\mathbf y$ minus a constant, so it is $\sigma(\mathbf y)$-measurable and equals its own conditional expectation; the Gaussian hypotheses only supply integrability.
-- source:
--   Yatawatta, Zaroubi, de Bruyn, Koopmans and Noordam, Radio interferometric calibration using the SAGE algorithm, arXiv:0810.5751v1 (2008), claim c003; Section III-B (SAGE Algorithm), eqs. (12)-(14), PDF p. 3

import Mathlib
import Definitions.Def_Arxiv0810_5751_Basic

open MeasureTheory Matrix
open scoped ComplexOrder

namespace Arxiv0810_5751

theorem sage_estep_cond_mean {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
    {K M : ℕ} (P : Fin K → ℕ) (s : ∀ i : Fin K, (Fin (P i) → ℂ) → Fin M → ℂ)
    (θk : ∀ i : Fin K, Fin (P i) → ℂ)
    (Pcov : Matrix (Fin M) (Fin M) ℂ) (hPcov : Pcov.PosDef)
    (n : Ω → Fin M → ℂ) (hn : Measurable n) (hlaw : IsCircGaussian (μ.map n) Pcov) (i : Fin K) :
    μ[fun ω => s i (θk i) + n ω |
        MeasurableSpace.comap
          (fun ω => (s i (θk i) + n ω) + ∑ l ∈ Finset.univ.erase i, s l (θk l)) inferInstance] =ᵐ[μ]
      (fun ω => s i (θk i) +
        (((s i (θk i) + n ω) + ∑ l ∈ Finset.univ.erase i, s l (θk l)) - ∑ l, s l (θk l))) ∧
    ∀ ω, s i (θk i) +
        (((s i (θk i) + n ω) + ∑ l ∈ Finset.univ.erase i, s l (θk l)) - ∑ l, s l (θk l)) =
      ((s i (θk i) + n ω) + ∑ l ∈ Finset.univ.erase i, s l (θk l)) -
        ∑ l ∈ Finset.univ.erase i, s l (θk l) := by sorry

end Arxiv0810_5751
