-- title:
--   Lemma 9 — limit points along the spacer steps generated by a recurring support S
-- statement:
--   Let $X$ have unit-norm columns, $\lambda_0>0$, $\lambda_1,\lambda_2\ge0$ with $\lambda_1=0$ or $\lambda_2=0$, and when $\lambda_2=0$ assume Assumption 1 and, if $p>n$, Assumption 2. Let $\{\beta^k\}$ be the iterates of Algorithm 1 with a positive integer $C$. Let $S$ be a support that is generated infinitely often by the non-spacer steps, and let $L$ be the set of indices $l$ such that $\beta^l$ is produced by a spacer step and $\mathrm{Supp}(\beta^{l-1})=S$. Then:
--
--   1. There is $N$ such that $\mathrm{Supp}(\beta^l)=S$ for all $l\in L$ with $l\ge N$.
--   2. There is $\beta^*$ such that a subsequence of $\{\beta^l\}_{l\in L}$ converges to $\beta^*$, $\beta^*$ is a stationary solution, $\beta^*_{S^c}=0$, and $\beta^*_S$ is the unique minimizer of $\beta_S\mapsto f(\beta_S)$, that is, $\beta^*$ minimizes $f$ over $\{\beta:\beta_{S^c}=0\}$ and every minimizer there equals $\beta^*$.
--   3. Every subsequence of $\{\beta^k\}$ with support $S$ converges to $\beta^*$.
--   4. For every $j\in S$,
--   $$|\beta^*_j|\ge\sqrt{\frac{2\lambda_0}{1+2\lambda_2}} .$$
--
--   The lemma identifies the only possible limit along a recurring support and shows that it sits strictly away from zero on that support; Lemmas 10 and 11 and Theorem 2 are built on it.
--
--   **Formalization Note** "Every subsequence with support $S$ converges to $\beta^*$" is stated as convergence of $k\mapsto\beta^k$ along the filter of large $k$ with $\mathrm{Supp}(\beta^k)=S$. "Generated infinitely often by the non-spacer steps" means: for infinitely many $k$, $\beta^k$ is not the result of a spacer step and has support $S$.
-- source:
--   Hazimeh, Mazumder, Fast Best Subset Selection: Coordinate Descent and Local Combinatorial Optimization Algorithms, arXiv:1803.01454v3, Lemma 9, p. 38 (proof pp. 38–40)

import Mathlib
import Definitions.Def_FastBestSubset_CDSS_Setting

open Filter Topology

namespace FastBestSubset.CDSS

/-- Lemma 9 (p. 38). Let `S` be a support generated infinitely often by the non-spacer steps of
Algorithm 1, and let `L = {l : βˡ is a spacer step and Supp(βˡ⁻¹) = S}` be the spacer steps
generated by `S`. Then (1) eventually every `l ∈ L` has `Supp(βˡ) = S`; and there is `β*` with
(2) a subsequence of `{βˡ}_{l∈L}` converging to `β*`, `β*` stationary, `β*_{Sᶜ} = 0` and `β*_S` the
unique minimizer of `β_S ↦ f(β_S)`; (3) every subsequence of `{βᵏ}` with support `S` converges to
`β*`; (4) `|β*_j| ≥ √(2λ₀/(1+2λ₂))` for every `j ∈ S`. -/
theorem lemma_9 {n p : ℕ} [NeZero p] (D : Data n p) (hX : ∀ j, ∑ r, D.X r j ^ 2 = 1)
    (hlam0 : 0 < D.lam0) (hlam1 : 0 ≤ D.lam1) (hlam2 : 0 ≤ D.lam2)
    (hscope : D.lam1 = 0 ∨ D.lam2 = 0)
    (C : ℕ) (hC : 0 < C) (β0 : Fin p → ℝ)
    (hA : D.lam2 = 0 → (Assumption1 D ∧ (n < p → Assumption2 D β0)))
    (S : Finset (Fin p))
    (hS : ∃ᶠ k in atTop, ¬ IsSpacer D C β0 k ∧ supp (iter D C β0 k) = S) :
    let L : Set ℕ := {l | IsSpacer D C β0 l ∧ supp (iter D C β0 (l - 1)) = S}
    (∃ N : ℕ, ∀ l ∈ L, N ≤ l → supp (iter D C β0 l) = S) ∧
    ∃ βstar : Fin p → ℝ,
      -- Part 2
      (∃ φ : ℕ → ℕ, StrictMono φ ∧ (∀ j, φ j ∈ L) ∧
          Tendsto (fun j => iter D C β0 (φ j)) atTop (𝓝 βstar)) ∧
      IsStationary D βstar ∧
      (∀ i ∉ S, βstar i = 0) ∧
      (∀ β : Fin p → ℝ, (∀ i ∉ S, β i = 0) → f D βstar ≤ f D β) ∧
      (∀ β : Fin p → ℝ, (∀ i ∉ S, β i = 0) →
          (∀ γ : Fin p → ℝ, (∀ i ∉ S, γ i = 0) → f D β ≤ f D γ) → β = βstar) ∧
      -- Part 3
      Tendsto (iter D C β0) (atTop ⊓ 𝓟 {k | supp (iter D C β0 k) = S}) (𝓝 βstar) ∧
      -- Part 4
      (∀ j ∈ S, Real.sqrt (2 * D.lam0 / (1 + 2 * D.lam2)) ≤ |βstar j|) := by sorry

end FastBestSubset.CDSS
