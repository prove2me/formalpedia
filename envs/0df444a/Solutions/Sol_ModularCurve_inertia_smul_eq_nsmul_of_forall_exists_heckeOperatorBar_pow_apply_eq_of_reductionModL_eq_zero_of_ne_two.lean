      LinearMap.convOne_apply, TensorProduct.counit_tmul, CommSemiring.counit_apply,
      Algebra.TensorProduct.algebraMap_apply]
    exact ((TensorProduct.smul_tmul (Coalgebra.counit x) a (1 : H)).trans
