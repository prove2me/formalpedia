theorem J6Seg.PreT.stA_spX (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {P R sN tN lam aN A : ℕ}
    (hi : StIn2 v P R sN tN lam aN A) (hPA : P ≤ A) {cN nN : ℕ} (h1 : v 1 = cN) (h2 : v 2 = nN)
    (hn : nN ≤ lam) {eJ : Ex HS} (hiJ : InRg eJ) (hpJ : Poly eJ = true) (hdJ : J6Seg.PreT.dg eJ ≤ 40)
    (hoJ : ∀ (u : Fin HS → ℤ) (cu : Fin HS → List ℤ), eJ.ok (encK s (J6Seg.PreT.RF u cu))) (jv : ℕ → ℕ)
    (hJ : ∀ (k : ℕ) (u : Fin HS → ℤ) (cu : Fin HS → List ℤ), u 1 = cN → u 22 = sN → u 23 = tN →
      u 25 = aN → u 12 = k → eJ.eval (encK s (J6Seg.PreT.RF u cu)) = jv k)
    (bX : ∀ k < nN, |expNeg P sN (jv k)| ≤ 2 ^ A)
    (bF : ∀ k < nN, |(-1) ^ k * J6Seg.fmul P (expNeg P sN (jv k)) (giI P sN tN aN k)| ≤ 2 ^ A)
    (bq : ∀ k < lam, |expNeg P sN (2 * aN ^ 2 * tN * (k + 1))| ≤ 2 ^ A)
    (bG : ∀ k ≤ lam, |gamI P sN tN aN k| ≤ 2 ^ A) :
    (∀ j, j ≠ 3 → j ≠ 4 → j ≠ 5 → j ≠ 11 → j ≠ 12 → stAV v P sN tN aN jv nN j = v j) ∧
    VB (stAV v P sN tN aN jv nN) A ∧
    Sp (stA O eJ) (encK s (J6Seg.PreT.RF v c)) (encK s (J6Seg.PreT.RF (stAV v P sN tN aN jv nN) (Function.update c O
      (rv (fun (k : ℕ) => (-1) ^ k * J6Seg.fmul P (expNeg P sN (jv k)) (giI P sN tN aN k)) nN ++ c O))))
