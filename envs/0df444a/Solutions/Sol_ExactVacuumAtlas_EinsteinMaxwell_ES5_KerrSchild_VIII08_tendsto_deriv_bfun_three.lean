    have h := hc.tendsto.mono_left (nhdsWithin_le_nhds (s := Ioi (3:ℝ)))
    convert h using 2
    norm_num
  have hterm1 : Tendsto (fun R : ℝ => -(deriv Y R * ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Kfun j q R)) (𝓝[>] (3:ℝ))
      (𝓝 (-(1 * ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Kfun j q 3))) := (hdq.mul hK).neg
  have hquot : Tendsto (fun R : ℝ => kfun j q (1 / R) / R ^ 2) (𝓝[>] (3:ℝ))
      (𝓝 (sfun j q aG / 2 / 9)) := by
    have h := hk.div hR2 (by norm_num : (9:ℝ) ≠ 0)
    refine h.congr' ?_
    filter_upwards with R
    rfl
  have hterm2 : Tendsto (fun R : ℝ => Y R * (kfun j q (1 / R) / R ^ 2)) (𝓝[>] (3:ℝ))
      (𝓝 (1 * (sfun j q aG / 2 / 9))) := hY.mul hquot
  have hsum : Tendsto (fun R : ℝ => -(deriv Y R * ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Kfun j q R) + Y R * (kfun j q (1 / R) / R ^ 2))
      (𝓝[>] (3:ℝ)) (𝓝 (-(1 * ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Kfun j q 3) + 1 * (sfun j q aG / 2 / 9))) :=
    hterm1.add hterm2
  have hval : -(1 * ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Kfun j q 3) + 1 * (sfun j q aG / 2 / 9) = MbFun j q := by
    unfold MbFun
    ring
  rw [hval] at hsum
  refine hsum.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with R hR
  exact (bfun_deriv_eq (j := j) hqc.continuousOn hR).symm
