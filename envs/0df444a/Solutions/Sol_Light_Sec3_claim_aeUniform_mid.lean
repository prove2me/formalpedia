/-- `⌈s/g⌉ ≤ s` for `g ≥ 1`. -/
theorem pieceSizeNat_le_sqrt {D g : ℕ} (hg : 1 ≤ g) : pieceSizeNat D g ≤ Nat.sqrt D :=
  (Nat.ceilDiv_le_iff hg).2 (Nat.le_mul_of_pos_right _ hg)

/-- The middle dimension is at most `D`. -/
theorem midDim_le {D g : ℕ} (hg : 1 ≤ g) : midDim D g ≤ D :=
  (Nat.mul_le_mul_right _ (pieceSizeNat_le_sqrt hg)).trans (Nat.sqrt_le D)

/-- The middle dimension is at least 1 in the big case. -/
theorem one_le_midDim {D g : ℕ} (hD : 16 ≤ D) (hg : 1 ≤ g) : 1 ≤ midDim D g := by
  have hs : 4 ≤ Nat.sqrt D := Nat.le_sqrt'.2 (by omega)
  have hq : 1 ≤ pieceSizeNat D g := (Nat.lt_ceilDiv_iff hg).2 (by omega)
  unfold midDim
  exact Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))

