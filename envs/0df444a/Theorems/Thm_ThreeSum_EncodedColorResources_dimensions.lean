theorem ThreeSum.EncodedColorResources.dimensions : ∀ (n : Nat),
  And
    (@LE.le.{0} Nat instLENat
      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (ThreeSum.EncodedColorResources.width n)
        (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
      (ThreeSum.EncodedColorResources.scale n))
    (And
      (@LE.le.{0} Nat instLENat
        (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (ThreeSum.EncodedColorResources.blocks n)
          (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
        (ThreeSum.EncodedColorResources.scale n))
      (And
        (@LE.le.{0} Nat instLENat
          (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (ThreeSum.Scales.mu n)
            (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
          (ThreeSum.EncodedColorResources.scale n))
        (And (@LE.le.{0} Nat instLENat (ThreeSum.BandScales.bandSize n) (ThreeSum.EncodedColorResources.scale n))
          (@LE.le.{0} Nat instLENat (ThreeSum.Scales.radix n) (ThreeSum.EncodedColorResources.scale n))))) := by
  sorry
