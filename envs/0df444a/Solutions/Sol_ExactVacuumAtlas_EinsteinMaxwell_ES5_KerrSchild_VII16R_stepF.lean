/-- E2 core: quotient-rule form of `Z′`, `Z = u F′/F`, equals the explicit bounded expression
plus a residual combination of the real `pfE`, `pcE`. -/
theorem e2_core (hx : x ≠ 0) (hF : F ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0) :
    (((-h) * F₁ + (1 - h * x) * F₂) * F - (1 - h * x) * F₁ * F₁) / F ^ 2
    = x * (4 / 3 * b * A₁ ^ 2 + 4 / 3 * F * (A / x) ^ 2 / b)
      + 8 / 3 * Q ^ 2 * F / (1 - h * x)
      + 4 * F * b * x * (J + 2 * Q * A) ^ 2 / (1 - h * x) ^ 2
      + (1 - h * x) / x ^ 2 *
        (pfE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ / (3 * F ^ 2 * (1 - h * x) ^ 2 * b ^ 2)
         + pcE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂
             / (F ^ 2 * b ^ 2 * (1 - h * x) ^ 2) / (1 - h * x)) := by
  unfold pfE pcE; field_simp; ring
end

