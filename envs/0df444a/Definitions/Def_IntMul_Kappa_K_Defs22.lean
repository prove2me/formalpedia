namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

abbrev rDl : Fin HS := 24
abbrev rJ1 : Fin HS := 25
abbrev rJ2 : Fin HS := 32
abbrev rN : Fin HS := 33
abbrev rN2 : Fin HS := 34

/-! ## The chirp array over a list of axes -/

/-- `chirpArr` over a list of axes `(s, t)` (first axis outermost). -/
def chirpArrL (Δ : ℕ) (L : List (ℕ × ℕ)) : List GI :=
  L.foldl (fun A p => oprod Δ A (axTab Δ p.1 p.2)) [oneP Δ]

/-! ## The axis descriptor -/

abbrev aX : Fin HS := 20
abbrev aA : Fin HS := 21
abbrev aC : Fin HS := 22
abbrev aD : Fin HS := 23
abbrev dS : Fin HS := 35

/-- One axis record `[t, 2t, 2t − s, t − s, n, 2nt]` (top first). -/
def tupL (s t n : ℕ) : List ℤ :=
  [(t : ℤ), ((2 * t : ℕ) : ℤ), ((2 * t - s : ℕ) : ℤ), ((t - s : ℕ) : ℤ), (n : ℤ),
    ((2 * (n * t) : ℕ) : ℤ)]

/-- The axis records, `n` = the array length before each axis. -/
def descA : ℕ → List (ℕ × ℕ) → List ℤ
  | _, [] => []
  | n, p :: L => tupL p.1 p.2 n ++ descA (n * p.2) L

/-- The array length before axis `k`. -/
def nK (L : List (ℕ × ℕ)) (k : ℕ) : ℕ := ((L.take k).map Prod.snd).prod

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Repetition with per-iteration costs -/

/-! ## The root-table loop -/

/-- `chirpG` with the count on `nX`. -/
def chirpGU (pM : Fin P) : IStmt HS P :=
  .seq (rptX nX pA pC pD (chirpB pM)) (.seq (rptX nX pA pC pD (mvPB pV pW)) drop6B)

/-! ## Base roots by `twiddleP`, arguments from registers -/

/-- Copy `n, k, j` from `rn, rk, rj` onto `28, 29, 53`, run `twiddleP`, drop, and move the root
onto `X` (`re` on top). -/
def twCU (rn rk rj X : Fin HS) : IStmt HS P :=
  .seq (.op (.dup rn 28)) (.seq (.op (.dup rk 29)) (.seq (.op (.dup rj 53)) (.seq (RS.code twiddleP)
    (.seq (.op (.drop 53)) (.seq (.op (.drop 29)) (.seq (.op (.drop 28))
      (.seq (.op (.mv 52 X)) (.op (.mv 51 X)))))))))

def cTwU (n k j : ℕ) : ℕ := cTw n k j + 3 * cCnt (n + k + j)

/-! ## Axis and twist tables -/

/-- **Uniform axis table**: `Δ` on `rDl`, `2t` on `nX2`, `2t − s` on `rJ1`, `t` on `nX`, `t − s`
on `rJ2`, ruler `2^Δ` on `pR`. -/
def axGU (pM : Fin P) : IStmt HS P :=
  .seq (.seq (.op (.const 0 0)) (.op (.dup pR 0))) (.seq (twCU rDl nX2 rJ1 pH)
    (.seq (twCU rDl nX rJ2 pK) (chirpGU pM)))

def cAxU (Δ s t φ : ℕ) : ℕ :=
  cTwU Δ (2 * t) (2 * t - s) + cTwU Δ t (t - s) + (cChirpG t φ (Δ + 2) Δ + 2 * cCnt t) +
    (dupCost (Δ + 1) + 17) + 2

/-- **Uniform twist table** `twTab Δ k j n`: `Δ` on `rDl`, `k` on `rJ1`, `j` on `rJ2`, `n` on
`nX`, ruler on `pR`. -/
def twGU (pM : Fin P) : IStmt HS P :=
  .seq (.seq (.op (.const 0 0)) (.op (.dup pR 0))) (.seq (twCU rDl rJ1 rJ2 pH)
    (.seq (.seq (.op (.const pK 0)) (.op (.dup pR pK))) (chirpGU pM)))

def cTwGU (Δ k j n φ : ℕ) : ℕ :=
  cTwU Δ k j + (cChirpG n φ (Δ + 2) Δ + 2 * cCnt n) + 2 * (dupCost (Δ + 1) + 19)

/-! ## The outer-product round, loop and one level -/

/-- `obB` with the counts on `nX` (`b`) and `nX2` (`2b`). -/
def obBU (pM : Fin P) : IStmt HS P :=
  .seq (mvPB pQ1 pH) (.seq (rptX nX pA pC pD (cpyB pH 0)) (.seq (rptX nX2 pA pC pD (.op (.mv pQ2 pU)))
    (.seq (rptX nX2 pA pC pD (dmB pU pW pQ2)) (.seq (gmulPU pM)
    (.seq (rptX nX2 pA pC pD (.op (.mv 0 pQ3))) (.seq (.op (.drop pH)) (.op (.drop pH))))))))

def cObU (b w Δ φ : ℕ) : ℕ := cOb b w Δ φ + 6 * cCnt (2 * b)

/-- `oprodP` with the count `n = |A|` on `rN`. -/
def oprodPU (pM : Fin P) : IStmt HS P := rptX rN NLogN.KFM.oA NLogN.KFM.oC NLogN.KFM.oD (obBU pM)

/-- **One uniform level**: registers as for `axGU`, plus `n = |A|` on `rN` and `2nt` on `rN2`. -/
def levPU (pM : Fin P) : IStmt HS P :=
  .seq (axGU pM) (.seq (rptX nX2 pA pC pD (.op (.mv pW pU)))
    (.seq (rptX nX2 pA pC pD (.op (.mv pU pQ2))) (.seq (oprodPU pM)
    (.seq (rptX rN2 pA pC pD (.op (.mv pQ3 pQ1)))
      (rptX nX2 pA pC pD (.op (.drop pQ2)))))))

def cLevU (Δ s t n φ : ℕ) : ℕ :=
  cAxU Δ s t φ + 2 * ((2 * t) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * t)) +
    (n * (cObU t (Δ + 2) Δ φ + 64) + 60 + cRpt n + cCnt n) +
    ((2 * (n * t)) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * (n * t))) +
    ((2 * t) * (2 * (Δ + 2) + 2 + 64) + 60 + cRpt (2 * t)) + 3 * cCnt (2 * t) + cCnt (2 * (n * t))

/-! ## One axis step: load the record, run the level, drop the registers -/

def ldB : IStmt HS P :=
  .seq (.op (.mv NLogN.KFM.dS nX)) (.seq (.op (.mv NLogN.KFM.dS nX2)) (.seq (.op (.mv NLogN.KFM.dS rJ1)) (.seq (.op (.mv NLogN.KFM.dS rJ2))
    (.seq (.op (.mv NLogN.KFM.dS rN)) (.op (.mv NLogN.KFM.dS rN2))))))

def dropB6 : IStmt HS P :=
  .seq (.op (.drop rN2)) (.seq (.op (.drop rN)) (.seq (.op (.drop rJ2)) (.seq (.op (.drop rJ1))
    (.seq (.op (.drop nX2)) (.op (.drop nX))))))

/-- The size of the largest record entry. -/
def zV (t n : ℕ) : ℕ := zsz ((2 * t + 2 * (n * t) + n : ℕ) : ℤ)

def cLdV (t n : ℕ) : ℕ := 700 * (zV t n + 1)

/-- One axis step of the uniform chirp loop. -/
def levB (pM : Fin P) : IStmt HS P := .seq ldB (.seq (levPU pM) dropB6)

/-! ## The uniform chirp-array loop -/

/-- **Uniform chirp array**: `d` on `aX`, the records `descA 1 L` on `dS`, `Δ` on `rDl`, ruler on
`pR`; counters `aA, aC, aD`. -/
def chirpPU (pM : Fin P) : IStmt HS P :=
  .seq (.seq (.op (.const pQ1 0)) (.op (.dup pR pQ1))) (rptX aX aA aC NLogN.KFM.aD (levB pM))

/-- The cost of axis step `k`. -/
def cStep (Δ φ : ℕ) (L : List (ℕ × ℕ)) (k : ℕ) : ℕ :=
  cLevU Δ (L.getD k (0, 0)).1 (L.getD k (0, 0)).2 (nK L k) φ + cLdV (L.getD k (0, 0)).2 (nK L k)

def cChirpPU (Δ φ : ℕ) (L : List (ℕ × ℕ)) : ℕ :=
  2 + (dupCost (Δ + 1) + 17) + ((∑ k ∈ Finset.range L.length, (cStep Δ φ L k + 64)) + 60 +
    cRpt L.length + cCnt L.length)

/-! ## The uniform chirp table -/

/-- The axis list of `(s, t)`. -/
def axL {d : ℕ} (s t : Fin d → ℕ) : List (ℕ × ℕ) := List.ofFn fun i => (s i, t i)

/-- The chirp-table descriptor: the axis records, then `2 ∏ t_i`. -/
def descT {d : ℕ} (s t : Fin d → ℕ) : List ℤ := descA 1 (axL s t) ++ [((2 * ∏ i, t i : ℕ) : ℤ)]

/-- **Uniform chirp table** onto `pW`; consumes the descriptor on `dS`. -/
def chirpTabPU (pM : Fin P) : IStmt HS P :=
  .seq (chirpPU pM) (.seq (rptX NLogN.KFM.dS pA pC pD (.op (.mv pQ1 pU)))
    (.seq (rptX NLogN.KFM.dS pA pC pD (.op (.mv pU pW))) (.op (.drop NLogN.KFM.dS))))

def cChirpTabU (Δ φ : ℕ) (L : List (ℕ × ℕ)) (N : ℕ) : ℕ :=
  cChirpPU Δ φ L + 2 * ((2 * N) * (110 * (Δ + 2 + 1) + 64) + 60 + cRpt (2 * N)) +
    2 * cCnt (2 * N) + (2 * zsz ((2 * N : ℕ) : ℤ) + 2)

/-! ## Cost bounds -/

end IL

end NLogN.KFM

