import Definitions.Def_IntMul_Kappa_R6_Defs1
import Theorems.Thm_J6Sieve_step_core

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Sieve
open Finset

lemma j6_card_primeFactors_le_log (n : ℕ) (hn : n ≠ 0) :
    n.primeFactors.card ≤ Nat.log 2 n := by
  apply Nat.le_log_of_pow_le (by norm_num)
  calc 2 ^ n.primeFactors.card ≤ ∏ p ∈ n.primeFactors, p := by
        apply Finset.pow_card_le_prod
        intro p hp; exact (Nat.prime_of_mem_primeFactors hp).two_le
    _ ≤ n := Nat.le_of_dvd (Nat.pos_of_ne_zero hn) (Nat.prod_primeFactors_dvd n)

theorem solution (d X H : ℕ) (A : ℕ → ℕ) (hA : ∀ i < d, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∀ k ≤ d, ∃ s : ℕ → ℕ, (∀ i < k, rough (zz d X) (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      ∀ i < k, ∀ j < k, i ≠ j → Nat.Coprime (s i) (s j) := by
  intro k
  induction k with
  | zero => intro _; exact ⟨fun _ => 0, by simp, by simp⟩
  | succ k ih =>
    intro hk
    obtain ⟨s, hs1, hs2⟩ := ih (by omega)
    let Q : Finset ℕ := (Finset.range k).biUnion (fun j => (s j).primeFactors)
    have hQp : ∀ q ∈ Q, q.Prime := by
      intro q hq
      simp only [Q, Finset.mem_biUnion] at hq
      obtain ⟨j, _, hj⟩ := hq
      exact Nat.prime_of_mem_primeFactors hj
    have hQz : ∀ q ∈ Q, q ∉ P (zz d X) := by
      intro q hq hqP
      simp only [Q, Finset.mem_biUnion, Finset.mem_range] at hq
      obtain ⟨j, hj, hqj⟩ := hq
      exact (hs1 j hj).1 q hqP (Nat.dvd_of_mem_primeFactors hqj)
    have hQc : Q.card ≤ Om d X + 1 := by
      calc Q.card ≤ ∑ j ∈ Finset.range k, (s j).primeFactors.card := Finset.card_biUnion_le
        _ ≤ ∑ j ∈ Finset.range k, Nat.log 2 X := by
          apply Finset.sum_le_sum
          intro j hj
          rw [Finset.mem_range] at hj
          obtain ⟨_, h2, h3⟩ := hs1 j hj
          have hX := hA j (by omega)
          exact (j6_card_primeFactors_le_log _ (by omega)).trans
            (Nat.log_mono_right (by omega))
        _ = k * Nat.log 2 X := by simp
        _ ≤ d * (Nat.log 2 X + 1) := Nat.mul_le_mul (by omega) (by omega)
        _ ≤ Om d X + 1 := by unfold Om; omega
    obtain ⟨n, hn1, hn2, hn3, hn4⟩ := J6Sieve.step_core (zz d X) (Om d X) (kk d X) (mm d X) H
      (A k) Q rfl (Nat.lt_pow_succ_log_self (by norm_num) _) rfl hQp hQz hQc hH
    refine ⟨fun i => if i < k then s i else n, ?_, ?_⟩
    · intro i hi
      by_cases h : i < k
      · simp only [if_pos h]; exact hs1 i h
      · have : i = k := by omega
        subst this; simp only [lt_irrefl, if_false]; exact ⟨hn3, hn1, hn2⟩
    · have key : ∀ i < k, Nat.Coprime (s i) n := by
        intro i hi
        apply Nat.coprime_of_dvd
        intro p hp hpi hpn
        have hsi : s i ≠ 0 := by have := (hs1 i hi).2.1; omega
        apply hn4 p _ hpn
        simp only [Q, Finset.mem_biUnion, Finset.mem_range]
        exact ⟨i, hi, Nat.mem_primeFactors.mpr ⟨hp, hpi, hsi⟩⟩
      intro i hi j hj hij
      by_cases hi' : i < k <;> by_cases hj' : j < k
      · simp only [if_pos hi', if_pos hj']; exact hs2 i hi' j hj' hij
      · simp only [if_pos hi', if_neg hj']; exact key i hi'
      · simp only [if_neg hi', if_pos hj']; exact (key j hj').symm
      · omega
