  have ez₁ := Block.Eval.op_addrConst z 39 0 e₂.safe_end hz₁
  obtain ⟨t,e₃,tout,tbegin,ti,td⟩ := appendPowerMarker_spec z₁ 39 hz₁ (by simp [z₁,z34];omega)
