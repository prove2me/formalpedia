namespace NLogN.CR

open IntMul RS IntMul.HvdH IntMul.HvdH.Ref

/-- `|twD p n j| ≤ 2^p` componentwise. -/
theorem twD_abs (p n j : ℕ) :
    |(twD p n j).1| ≤ 2 ^ p ∧ |(twD p n j).2| ≤ 2 ^ p := by
  unfold twD scaleZ
  simp only [pow_zero, one_mul]
  set a := (twiddle p n j).1
  set b := (twiddle p n j).2
  have h4 : (4 : ℤ) ^ p = 2 ^ p * 2 ^ p := by rw [← mul_pow]; norm_num
  have hp : (0 : ℤ) < 2 ^ p := by positivity
  split_ifs with h
  · constructor
    · rw [abs_le]; constructor <;> nlinarith [sq_nonneg b, sq_nonneg (a + 2 ^ p), sq_nonneg (a - 2 ^ p)]
    · rw [abs_le]; constructor <;> nlinarith [sq_nonneg a, sq_nonneg (b + 2 ^ p), sq_nonneg (b - 2 ^ p)]
  · push_neg at h
    set x := a ^ 2 + b ^ 2 with hx
    have hx0 : 0 ≤ x := by positivity
    set m := ceilSqrt x.toNat with hm
    have hmm : x.toNat ≤ m * m := (ceilSqrt_le_iff _ _).1 le_rfl
    have hmm' : x ≤ (m : ℤ) * m := by
      have : ((x.toNat : ℕ) : ℤ) ≤ ((m * m : ℕ) : ℤ) := by exact_mod_cast hmm
      push_cast at this; rwa [Int.toNat_of_nonneg hx0] at this
    have hm0 : (0 : ℤ) < m := by
      by_contra hc
      have : (m : ℤ) = 0 := by omega
      rw [this] at hmm'; nlinarith
    have ha : |a| ≤ m := by
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg b, sq_nonneg (a + m), sq_nonneg (a - m)]
    have hb : |b| ≤ m := by
      rw [abs_le]; constructor <;> nlinarith [sq_nonneg a, sq_nonneg (b + m), sq_nonneg (b - m)]
    have key : ∀ z : ℤ, |z| ≤ m → |(z * 2 ^ p).tdiv m| ≤ 2 ^ p := by
      intro z hz
      have hz' : z.natAbs ≤ m := by
        have : ((z.natAbs : ℕ) : ℤ) ≤ m := by rw [Int.natCast_natAbs]; exact hz
        exact_mod_cast this
      rw [Int.abs_eq_natAbs, Int.natAbs_tdiv, Int.natAbs_mul, Int.natAbs_pow]
      simp only [Int.natAbs_natCast]
      have : z.natAbs * 2 ^ p / m ≤ 2 ^ p :=
        Nat.div_le_of_le_mul (Nat.mul_le_mul_right _ hz')
      exact_mod_cast this
    exact ⟨key a ha, key b hb⟩

theorem twD_zsz (p n j B : ℕ) (hB : p + 1 ≤ B) :
    zsz (twD p n j).1 ≤ B ∧ zsz (twD p n j).2 ≤ B := by
  obtain ⟨h1, h2⟩ := twD_abs p n j
  have : (2 : ℤ) ^ p < 2 ^ B := pow_lt_pow_right₀ (by norm_num) (by omega)
  exact ⟨zsz_le_of_abs (lt_of_le_of_lt h1 this), zsz_le_of_abs (lt_of_le_of_lt h2 this)⟩

theorem twB_of (p R B : ℕ) (hB : p + 1 ≤ B) : TwB p R B := fun c _ => twD_zsz p R c B hB

/-- **The chirp table** `chirpL q` (as `gints`) pushed onto stack `0`. -/
theorem chirpTab_spec (M : MulSpec) (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K)
    (s : IState HS) (hw : ChirpRegs q s) (LP : List Item) (hp : s.G hPp = .int q.p :: LP) (kb : ℕ)
    (L2 : List Item) (h2 : s.G 2 = .int kb :: L2) (hkb1 : 4 * q.r ≤ 2 ^ kb)
    (hkb2 : q.tdims.prod ≤ 2 ^ kb) :
    (chirpP twR).ok M s ∧ (chirpP twR).run s = s.upd 0 (gints (chirpL q) ++ s.G 0) :=
  chirpP_spec M q he hdh twR (twCost q.p (2 * q.r)) (twR_spec M _ _) s hw LP hp kb L2 h2 hkb1 hkb2

theorem chirpTab_cost (M : MulSpec) (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K)
    (s : IState HS) (hw : ChirpRegs q s) (LP : List Item) (hp : s.G hPp = .int q.p :: LP) (kb : ℕ)
    (L2 : List Item) (h2 : s.G 2 = .int kb :: L2) (hkb1 : 4 * q.r ≤ 2 ^ kb)
    (hkb2 : q.tdims.prod ≤ 2 ^ kb) (B : ℕ) (hB : ChirpB q B) (hpB : q.p + 1 ≤ B)
    (hBig : 8 * q.r + 3 * q.tdims.prod + 4 < 2 ^ B) (hkbB : kb + 2 ≤ B) :
    (chirpP twR).cost M s ≤ (q.tdims.prod + 1) * (q.K + 6) * (2 * 10 ^ 9) * (B + 2) ^ 2 +
      (2 * q.r + 1) * (twCost q.p (2 * q.r) + 3 * 10 ^ 9 * (B + 2) ^ 2) +
      10 ^ 7 * (kb + 1) * (2 * q.r + q.tdims.prod + 1) * (B + kb + 6) :=
  chirpP_cost M q he hdh twR (twCost q.p (2 * q.r)) (twR_spec M _ _) s hw LP hp kb L2 h2 hkb1 hkb2 B hB
    (twB_of _ _ _ hpB) hBig hkbB

