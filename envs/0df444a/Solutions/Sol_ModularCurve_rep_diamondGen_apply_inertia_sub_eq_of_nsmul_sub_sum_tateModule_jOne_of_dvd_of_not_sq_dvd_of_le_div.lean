    have ev : AlgebraicCurve.GluedPic0.toPic0Pair _ ((𝒟 I₀ hI₀ hI₀μ hI₀f).sp ⟨σ • A - A, dv⟩) =
        AlgebraicCurve.GluedPic0.toPic0Pair _ ((𝒟 I₀ hI₀ hI₀μ hI₀f).sp ⟨σ • A, dσA⟩) -
          AlgebraicCurve.GluedPic0.toPic0Pair _ ((𝒟 I₀ hI₀ hI₀μ hI₀f).sp ⟨A, dA⟩) :=
