theorem tate_torsion_free
    (hsmul : ∀ (a : ℤ_[lam]) (x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) (n : ℕ),
      ((a • x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) : ℕ → JZero (N * q)) n =
        (PadicInt.toZModPow n a).val • (x : ℕ → JZero (N * q)) n)
    (x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) (k : ℕ) (hx : (lam : ℤ_[lam]) ^ k • x = 0) : x = 0 := by
  have hcomp : ∀ n : ℕ, lam ^ k • ((x : ℕ → JZero (N * q)) n) = 0 := fun n => by
    have h1 : (((lam : ℤ_[lam]) ^ k • x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) : ℕ → JZero (N * q)) n =
        ((0 : ↥(ModularCurve.TateModule lam (JZero (N * q)))) : ℕ → JZero (N * q)) n :=
      congrArg (fun y : ↥(ModularCurve.TateModule lam (JZero (N * q))) => (y : ℕ → JZero (N * q)) n) hx
    rw [← Nat.cast_pow, hsmul, toZModPow_val_natCast_smul lam (lam ^ k) n _ (ModularCurve.TateModule.pow_smul_apply x.2 n)]
      at h1
    exact h1
  exact Subtype.ext (ModularCurve.TateModule.eq_zero_of_pow_smul_eq_zero x.2 (k := k) (funext fun n => hcomp n))

