section Galois

variable {J : Type} [AddCommGroup J] [Module HeckeAlg J] {p : ℕ} [Fact p.Prime]
variable [Module ℤ_[p] (ModularCurve.TateModule p J)]
variable [DistribMulAction (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) J]
variable (hsmul : ∀ (a : ℤ_[p]) (x : ModularCurve.TateModule p J) (n : ℕ),
  ((a • x : ModularCurve.TateModule p J) : ℕ → J) n = (PadicInt.toZModPow n a).val • (x : ℕ → J) n)

private def galTateEnd (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    ModularCurve.TateModule p J →ₗ[ℤ_[p]] ModularCurve.TateModule p J where
  toFun x := ⟨σ • (x : ℕ → J), ModularCurve.TateModule.smul_mem σ x.2⟩
  map_add' x y := Subtype.ext (smul_add σ (x : ℕ → J) (y : ℕ → J))
  map_smul' a x := by
    apply Subtype.ext
    funext n
    change σ • (((a • x : ModularCurve.TateModule p J) : ℕ → J) n) =
      ((a • (⟨σ • (x : ℕ → J), ModularCurve.TateModule.smul_mem σ x.2⟩ : ModularCurve.TateModule p J) : ModularCurve.TateModule p J) :
        ℕ → J) n
    rw [hsmul, hsmul]
    change σ • ((PadicInt.toZModPow n a).val • (x : ℕ → J) n) =
      (PadicInt.toZModPow n a).val • (σ • (x : ℕ → J) n)
    exact smul_comm _ _ _

@[scoped simp] private theorem galTateEnd_apply_coe (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (x : ModularCurve.TateModule p J) :
    ((galTateEnd hsmul σ x : ModularCurve.TateModule p J) : ℕ → J) = σ • (x : ℕ → J) :=
  rfl

private def galTate :
    (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* Module.End ℤ_[p] (ModularCurve.TateModule p J) where
  toFun := galTateEnd hsmul
  map_one' := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact one_smul _ (x : ℕ → J)
  map_mul' σ τ := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    exact mul_smul σ τ (x : ℕ → J)

variable (O : Type) [CommRing O] [Algebra ℤ_[p] O]

private def ρbc :
    (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) →* Module.End O (O ⊗[ℤ_[p]] ModularCurve.TateModule p J) :=
  (Module.End.baseChangeHom ℤ_[p] O (ModularCurve.TateModule p J)).toRingHom.toMonoidHom.comp (galTate hsmul)

private theorem ρbc_eq (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) :
    ρbc hsmul O σ = (galTateEnd hsmul σ).baseChange O := rfl

@[scoped simp] private theorem ρbc_tmul (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (a : O)
    (x : ModularCurve.TateModule p J) : ρbc hsmul O σ (a ⊗ₜ x) = a ⊗ₜ galTateEnd hsmul σ x := rfl

private theorem ρbc_tie (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x y : ModularCurve.TateModule p J)
    (h : (y : ℕ → J) = σ • (x : ℕ → J)) (a : O) :
    ρbc hsmul O σ (a ⊗ₜ[ℤ_[p]] x) = a ⊗ₜ[ℤ_[p]] y := by
  rw [ρbc_tmul]
  congr 1
  exact Subtype.ext h.symm

private theorem baseChange_baseChange_eq_smul_of_smul_eq
    (P : Submodule ℤ_[p] (ModularCurve.TateModule p J))
    (K : Type) [CommRing K] [Algebra O K]
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (c : ℤ_[p])
    (hc : ∀ x : ModularCurve.TateModule p J, x ∈ P → σ • (x : ℕ → J) = ((c • x : ModularCurve.TateModule p J) : ℕ → J))
    {v : K ⊗[O] (O ⊗[ℤ_[p]] ModularCurve.TateModule p J)}
    (hv : v ∈ (P.baseChange O).baseChange K) :
    (ρbc hsmul O σ).baseChange K v = (algebraMap O K (algebraMap ℤ_[p] O c)) • v := by
  have key : (P.baseChange O).baseChange K ≤ LinearMap.ker
      ((ρbc hsmul O σ).baseChange K - algebraMap O K (algebraMap ℤ_[p] O c) • LinearMap.id) := by
    rw [Submodule.baseChange_eq_span, Submodule.span_le]
    rintro v' ⟨u, hu, rfl⟩
    have inner : P.baseChange O ≤ LinearMap.ker
        (((ρbc hsmul O σ).baseChange K - algebraMap O K (algebraMap ℤ_[p] O c) • LinearMap.id).restrictScalars O
          ∘ₗ TensorProduct.mk O K (O ⊗[ℤ_[p]] ModularCurve.TateModule p J) 1) := by
      rw [Submodule.baseChange_eq_span, Submodule.span_le]
      rintro u' ⟨x, hx, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.comp_apply,
        LinearMap.restrictScalars_apply, TensorProduct.mk_apply, LinearMap.sub_apply,
        LinearMap.smul_apply, LinearMap.id_apply]
      have hρx := ρbc_tie hsmul O σ x (c • x) (hc x hx).symm 1
      rw [LinearMap.baseChange_tmul, hρx]
      rw [show (1 : O) ⊗ₜ[ℤ_[p]] (c • x) = c • ((1 : O) ⊗ₜ[ℤ_[p]] x) from
        (TensorProduct.tmul_smul c (1 : O) x)]
      rw [algebra_compatible_smul O c ((1 : O) ⊗ₜ[ℤ_[p]] x)]
      rw [show (1 : K) ⊗ₜ[O] (algebraMap ℤ_[p] O c • ((1 : O) ⊗ₜ[ℤ_[p]] x)) =
        algebraMap ℤ_[p] O c • ((1 : K) ⊗ₜ[O] ((1 : O) ⊗ₜ[ℤ_[p]] x)) from
        (TensorProduct.tmul_smul _ _ _)]
      rw [algebra_compatible_smul K (algebraMap ℤ_[p] O c)
        ((1 : K) ⊗ₜ[O] ((1 : O) ⊗ₜ[ℤ_[p]] x)), sub_self]
    have := inner hu
    simpa only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.comp_apply,
      LinearMap.restrictScalars_apply, TensorProduct.mk_apply] using this
  have h0 := key hv
  rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply,
    sub_eq_zero] at h0
  exact h0

private theorem adicContinuous_of_levelwise [IsLocalRing O]
    (hpO : (p : O) ∈ IsLocalRing.maximalIdeal O)
    (hlev : ∀ n : ℕ, ∃ L : IntermediateField ℚ (AlgebraicClosure ℚ), FiniteDimensional ℚ L ∧
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, (∀ x ∈ L, σ x = x) →
        ∀ x ∈ ModularCurve.TateModule p J, ∃ y ∈ ModularCurve.TateModule p J,
          (p ^ n : ℕ) • y = (fun m => σ • x m) - x) :
    GaloisActionIsAdicContinuous O (ρbc hsmul O) := by
  intro n
  obtain ⟨L, hLfd, hfix⟩ := hlev n
  refine ⟨L, hLfd, fun σ hσL v => ?_⟩
  induction v using TensorProduct.induction_on with
  | zero => rw [map_zero, sub_zero]; exact Submodule.zero_mem _
  | tmul b x =>
    obtain ⟨y, hy, hyeq⟩ := hfix σ hσL (x : ℕ → J) x.2
    have hz : σ • (x : ℕ → J) ∈ ModularCurve.TateModule p J := ModularCurve.TateModule.smul_mem σ x.2
    have hρx := ρbc_tie hsmul O σ x ⟨σ • (x : ℕ → J), hz⟩ rfl b
    rw [hρx]
    have hsub : (⟨σ • (x : ℕ → J), hz⟩ - x : ModularCurve.TateModule p J) =
        (p ^ n : ℕ) • (⟨y, hy⟩ : ModularCurve.TateModule p J) := by
      apply Subtype.ext
      first | simpa using hyeq.symm | simpa [Pi.smul_def, Pi.sub_def] using hyeq.symm | exact hyeq.symm | (simp only [Pi.smul_def] at hyeq ⊢; simpa using hyeq.symm)
    rw [← TensorProduct.tmul_sub, hsub,
      show b ⊗ₜ[ℤ_[p]] ((p ^ n : ℕ) • (⟨y, hy⟩ : ModularCurve.TateModule p J)) =
        ((p ^ n : ℕ) : ℤ_[p]) • (b ⊗ₜ[ℤ_[p]] (⟨y, hy⟩ : ModularCurve.TateModule p J)) by
        rw [← TensorProduct.tmul_smul, Nat.cast_smul_eq_nsmul]]
    rw [algebra_compatible_smul O ((p ^ n : ℕ) : ℤ_[p]), map_natCast, Nat.cast_pow]
    exact Submodule.smul_mem_smul (Ideal.pow_mem_pow hpO n) Submodule.mem_top
  | add v₁ v₂ h₁ h₂ =>
    rw [map_add, ← sub_add_sub_comm]
    exact Submodule.add_mem _ h₁ h₂

private theorem baseChange_comm_of_smul_comm
    [SMulCommClass (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) HeckeAlg J]
    (K : Type) [CommRing K] [Algebra O K] (t : HeckeAlg)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (w : K ⊗[O] (O ⊗[ℤ_[p]] ModularCurve.TateModule p J)) :
    ((heckeEndZp hsmul t).baseChange O).baseChange K ((ρbc hsmul O σ).baseChange K w) =
      (ρbc hsmul O σ).baseChange K (((heckeEndZp hsmul t).baseChange O).baseChange K w) := by
  have hT : (heckeEndZp hsmul t).comp (galTateEnd hsmul σ) =
      (galTateEnd hsmul σ).comp (heckeEndZp hsmul t) := by
    apply LinearMap.ext
    intro x
    apply Subtype.ext
    funext k
    change t • (σ • (x : ℕ → J) k) = σ • (t • (x : ℕ → J) k)
    exact (smul_comm σ t ((x : ℕ → J) k)).symm
  rw [ρbc_eq, ← LinearMap.comp_apply, ← LinearMap.comp_apply, ← LinearMap.baseChange_comp,
    ← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp, ← LinearMap.baseChange_comp, hT]

end Galois
