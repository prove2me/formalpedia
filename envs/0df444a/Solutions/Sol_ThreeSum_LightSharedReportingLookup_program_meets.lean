theorem solution : ∀ {lim : Light.Limits} {μ fB fC : Nat → Int} {free h J NB NC g s i j d : Nat} {p shift : Int},
  ThreeSum.SharedReportingBankHeader.Stored μ free h J NB NC g fB fC p shift →
    @LT.lt.{0} Nat instLTNat s (ThreeSum.LightBlockSourceCatalog.count h J) →
      @LT.lt.{0} Nat instLTNat i (ThreeSum.BandPartition.size NB g) →
        @LT.lt.{0} Nat instLTNat j (ThreeSum.BandPartition.size NC g) →
          @LE.le.{0} Int Int.instLEInt (@Nat.cast.{0} Int instNatCastInt lim.space) lim.word →
            @LE.le.{0} Nat instLENat (ThreeSum.SharedReportingBankHeader.finish free h J NB NC g) lim.space →
              Light.Meets lim ThreeSum.LightSharedReportingLookup.program
                (@OfNat.ofNat.{0} Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) d
                (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt free)
                  (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt s)
                    (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt i)
                      (@List.cons.{0} Int (@Nat.cast.{0} Int instNatCastInt j) (@List.nil.{0} Int)))))
                μ (@OfNat.ofNat.{0} Nat (nat_lit 500) (instOfNatNat (nat_lit 500)))
                fun (result : Int) (ν : Nat → Int) =>
                And
                  (@Eq.{1} Int result
                    (@Nat.cast.{0} Int instNatCastInt
                      (ThreeSum.SharedReportingBankAccess.recordAt free J NB NC g s i j)))
                  (@Eq.{1} (Nat → Int) ν μ) := by
  exact @ThreeSum.LightSharedReportingLookup.program_meets_sourceProof

