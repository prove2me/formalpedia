section R05Seg8
/-! # VII-03 (F2b): the actual reduced system is equivalent to the paper's radial BVP

`PaperBVP I f m N w p a Q J` lists the paper's seven radial field equations with one common pair of
constants `Q`, `J` on all of `I`: the two conservation laws `q = -Q`, `ℓ = -2J`, Eq. 23a `N'' = 2`,
Eqs. 24a, 24b, 24c and the constraint Eq. 25. It is a statement about the field equations only (no
regularity, no jet, no Kerr–Schild or `J³Q⁵` content).

On an open preconnected `I` with base point `r₀` and real paper data (`C^∞`, `f, m, N ≠ 0`):

  `Generic.ReducedSystem <dictionary> I ↔ ∃ Q J, Q = -q(r₀) ∧ J = -ℓ(r₀)/2 ∧ PaperBVP … Q J`.

Forward: VII-02 gives the common constants and Eq. 24c from the actual residuals; the four
forward identities give 23a, 24a, 24b, 25. Reverse: `q' = ℓ' = 0` from the conservation laws on the
open set (derivative transfer), the VII-02 residual identities give `redJ_t = redE_tσ = 0`, Eq. 24c
gives `redJ_σ = 0`, and the four inverse identities give the remaining Einstein residuals.

From `N'' = 2` on a preconnected open `I`: `N R = R² + βR + γ` with explicit real `β`, `γ`. No
statement about real roots, horizons or non-extremality is made (`N = R² + 1` satisfies `N'' = 2`). -/

open scoped ContDiff Topology
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

/-! ## The two directions -/

/-- **Forward.** The actual reduced system on a preconnected `I` gives the paper BVP with the
common constants `Q = -q(r₀)`, `J = -ℓ(r₀)/2`. -/
theorem paperBVP_of_reducedSystem (hP : PaperData I f m N w p a) (hI : IsPreconnected I)
    {r₀ : ℝ} (hr₀ : r₀ ∈ I)
    (hRS : Generic.ReducedSystem f (Dfun f m N) (Afun f m) (Hfun m N) w p a I) :
    ∃ Q J : ℝ, Q = -qFun f N w p a r₀ ∧ J = -ellFun f m N w p a r₀ / 2 ∧
      PaperBVP I f m N w p a Q J := by
  obtain ⟨Q, J, hQ, hJ, h⟩ := radial_subsystem_conservation hP hI hr₀
    (fun r hr => (hRS r hr).2.2.2.2.2.1) (fun r hr => (hRS r hr).2.1)
    (fun r hr => (hRS r hr).2.2.2.2.2.2)
  refine ⟨Q, J, hQ, hJ, fun r hr => ?_⟩
  obtain ⟨hq, hl, -, -, h24⟩ := h r hr
  obtain ⟨htt, -, hrr, huu, hss, -, -⟩ := hRS r hr
  obtain ⟨hD, hA, hB, hC⟩ := (einstein4_iff_paper4_of_eq hP hr hq hl).mp ⟨htt, hrr, huu, hss⟩
  exact ⟨hq, hl, sub_eq_zero.mp hD, hA, hB, h24, hC⟩

/-! ## `N'' = 2` gives a real quadratic (no root or horizon statement) -/

/-- The BVP's Eq. 23a on a preconnected `I` gives the real quadratic form of `N`. -/
theorem N_quadratic_of_paperBVP (hP : PaperData I f m N w p a) (hI : IsPreconnected I)
    {r₀ : ℝ} (hr₀ : r₀ ∈ I) {Q J : ℝ} (hB : PaperBVP I f m N w p a Q J) :
    ∃ β γ : ℝ, β = deriv N r₀ - 2 * r₀ ∧ γ = N r₀ - r₀ ^ 2 - β * r₀ ∧
      ∀ r ∈ I, N r = r ^ 2 + β * r + γ :=
  quadratic_of_deriv_deriv_eq_two hP.isOpen hI hP.cN hr₀ fun r hr => (hB r hr).2.2.1

/-! ## Roots and certificate layer -/

/-- **Certificate root (forward).** The candidate's own `EMCertificateD` on `esDomain I` gives the
paper BVP with common constants and the real quadratic form of `N`. -/
theorem vii03_certificate_radial_bvp (hP : PaperData I f m N w p a) (hI : IsPreconnected I)
    {r₀ : ℝ} (hr₀ : r₀ ∈ I)
    (hc : EMCertificateD (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
      (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (esFaraday p a) (esDomain I)) :
    ∃ Q J : ℝ, Q = -qFun f N w p a r₀ ∧ J = -ellFun f m N w p a r₀ / 2 ∧
      PaperBVP I f m N w p a Q J ∧
      ∃ β γ : ℝ, β = deriv N r₀ - 2 * r₀ ∧ γ = N r₀ - r₀ ^ 2 - β * r₀ ∧
        ∀ r ∈ I, N r = r ^ 2 + β * r + γ := by
  obtain ⟨Q, J, hQ, hJ, hB⟩ :=
    paperBVP_of_reducedSystem hP hI hr₀ (reducedSystem_of_certificate hP.toESData hc)
  exact ⟨Q, J, hQ, hJ, hB, N_quadratic_of_paperBVP hP hI hr₀ hB⟩

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
end R05Seg8

