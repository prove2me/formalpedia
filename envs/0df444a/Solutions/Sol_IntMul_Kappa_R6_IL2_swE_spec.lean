section
-- Source module: Solutions.KFWSub
/-!
# KFW: literals read from registers (the uniformity meta-theorem for register programs)

A uniform register program `U` reads its run-time parameters from registers (tops of stacks).
`RS.sub σ U` replaces each register `i` with `σ i = some v` by the literal `v`; the result is
the (non-uniform) program with baked-in literals, for which a spec is usually already proved.

**`FSp.of_sub`**: if `FSp (U.sub σ) s t c`, the registers of `σ` hold their values in `s`
(`Agree σ s`) and `U` never writes them, then `FSp U s t (400 c)`.  Also `fok_of_sub`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD

theorem Agree.congr {σ : Fin HS → Option ℤ} {s t : IState HS} (h : Agree σ s)
    (he : ∀ i, (σ i).isSome → t.G i = s.G i) : Agree σ t := by
  intro i v hi
  rw [he i (by simp [hi])]; exact h i v hi

end NLogN.KFW

end

section
-- Source module: Solutions.KFX1Sw
/-!
# KFX §1: the Lemma 12 swap wrapper with expression parameters

`swE q eP eG eS eU` pushes the four Lemma 12 parameters as the values of arbitrary expressions
(read from registers at run time), runs `l12F`, pops.  **`swE_spec`** is `KFL.swI_spec` with the
literals replaced by expressions (`KFL.ESp` facts), and **`swE_geo`** gives the three slot swaps
`rixT g (swT i)` on the 8-axis geometry.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL AModel AModelL12 NetProp7

theorem cost_absorbE {u c Bb V : ℕ} {K D : ℝ} (hu : 1 ≤ u) (hK : 0 ≤ K) (hD0 : 0 ≤ D)
    (hov : ((Bb : ℝ) + 2) ^ 2 ≤ D * V) (X : ℕ) (hX : X ≤ 10 ^ 9 * (Bb + 2) ^ 2 + 1)
    (hc : (c : ℝ) ≤ K * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) :
    (((X + c + (4 * (2 * Bb + 2) + 1) : ℕ)) : ℝ)
      ≤ (K + 10 ^ 10 * D) * ((V : ℝ) + 1) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  set x := (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)
  have hx : (1 : ℝ) ≤ x := Real.one_le_rpow (by exact_mod_cast hu) (by norm_num)
  have hB : (0 : ℝ) ≤ Bb := Nat.cast_nonneg _
  have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg _
  have h1 : D * V ≤ D * (((V : ℝ) + 1) * x) := by
    apply mul_le_mul_of_nonneg_left _ hD0; nlinarith
  have hXr : (X : ℝ) ≤ 10 ^ 9 * ((Bb : ℝ) + 2) ^ 2 + 1 := by exact_mod_cast hX
  push_cast
  have e : (K + 10 ^ 10 * D) * ((V : ℝ) + 1) * x =
      K * ((V : ℝ) + 1) * x + 10 ^ 10 * (D * (((V : ℝ) + 1) * x)) := by ring
  rw [e]
  have hBB : 10 ^ 9 * ((Bb : ℝ) + 2) ^ 2 + 1 + 4 * (2 * (Bb : ℝ) + 2) + 1 ≤
      10 ^ 10 * ((Bb : ℝ) + 2) ^ 2 := by nlinarith
  have h2 : 10 ^ 10 * ((Bb : ℝ) + 2) ^ 2 ≤ 10 ^ 10 * (D * (((V : ℝ) + 1) * x)) := by
    have := le_trans hov h1
    linarith
  linarith

/-! ## The three slot swaps on the 8-axis geometry -/

end NLogN.KFX

