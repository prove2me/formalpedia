    (a : ↥C) (ha0 : (a : K) ≠ 0)
    (Ba : Subalgebra A K) (hBa : Ba = (Algebra.adjoin ↥C {x : K | ∃ i ∈ J, x * (a : K) = (i : K)}).restrictScalars A)
    (P : Ideal ↥Ba) (hPmax : P.IsMaximal)
