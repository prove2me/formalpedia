private theorem tau_sq_ne_two : Q.tau ^ 2 ≠ 2 := by
  intro hsq
  have htau : Q.tau = -1 := by
    have hc := Q.tau_cubic
    rw [show Q.tau ^ 3 = Q.tau * Q.tau ^ 2 by ring, hsq] at hc
    have hadd : Q.tau + 1 = 0 := by linear_combination -hc
    linear_combination hadd
  rw [htau] at hsq
  norm_num at hsq

