section Points
variable {R : Type u} [CommRing R]

theorem mapPt_hom_inv {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (i : A ≅ A') (hi : i.hom ≫ f' = f) (hi' : i.inv ≫ f = f')
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (P : SchemeHomOver t f) :
    mapPt i.inv hi' (mapPt i.hom hi P) = P :=
  Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.hom_inv_id, Category.comp_id])

theorem mapPt_inv_hom {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (i : A ≅ A') (hi : i.hom ≫ f' = f) (hi' : i.inv ≫ f = f')
    {T : Scheme.{u}} {t : T ⟶ Spec (CommRingCat.of R)} (Q : SchemeHomOver t f') :
    mapPt i.hom hi (mapPt i.inv hi' Q) = Q :=
  Subtype.ext (by simp only [mapPt_coe, Category.assoc, Iso.inv_hom_id, Category.comp_id])

theorem mapPt_one {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    mapPt φ hφ (L.one t) = L'.one t := by
  set e := mapPt φ hφ (L.one t) with he
  have hee : L'.mul t e e = e := by
    rw [he, ← hmul, L.one_mul]
  calc e = L'.mul t (L'.one t) e := (L'.one_mul t e).symm
    _ = L'.mul t (L'.mul t (L'.inv t e) e) e := by rw [L'.inv_mul_cancel]
    _ = L'.mul t (L'.inv t e) (L'.mul t e e) := by rw [L'.mul_assoc]
    _ = L'.mul t (L'.inv t e) e := by rw [hee]
    _ = L'.one t := L'.inv_mul_cancel t e

theorem mapPt_nsmulPt {A A' : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)} {f' : A' ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (L' : RelativeGroupLaw R f') (φ : A ⟶ A') (hφ : φ ≫ f' = f)
    (hmul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (P Q : SchemeHomOver t f),
      mapPt φ hφ (L.mul t P Q) = L'.mul t (mapPt φ hφ P) (mapPt φ hφ Q))
    {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) (m : ℕ) (P : SchemeHomOver t f) :
    mapPt φ hφ (nsmulPt L t m P) = nsmulPt L' t m (mapPt φ hφ P) := by
  induction m with
  | zero => exact mapPt_one L L' φ hφ hmul t
  | succ m ih =>
    show mapPt φ hφ (L.mul t (nsmulPt L t m P) P) = L'.mul t (nsmulPt L' t m (mapPt φ hφ P)) (mapPt φ hφ P)
    rw [hmul, ih]

end Points

section Level
variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S : Type} [CommRing S]

theorem inv_over {E E' : FakeEllipticCurve Λ N S} (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f) : i.inv ≫ E.f = E'.f := by
  rw [Iso.inv_comp_eq, hi]

theorem sectionAt_mapPt {E E' : FakeEllipticCurve Λ N S} (φ : E.A ⟶ E'.A) (hφ : φ ≫ E'.f = E.f)
    (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of S))) E.f) (k : Type) [Field k] (sk : S →+* k) :
    FakeEllipticCurve.sectionAt (mapPt φ hφ P) k sk = mapPt φ hφ (FakeEllipticCurve.sectionAt P k sk) :=
  Subtype.ext (by
    show geomPoint k sk ≫ (P.1 ≫ φ) = (geomPoint k sk ≫ P.1) ≫ φ
    rw [Category.assoc])

theorem pushPt_mapPt {E E' : FakeEllipticCurve Λ N S} (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hact : ∀ x : ↥Λ, E.act x ≫ i.hom = i.hom ≫ E'.act x) (x : ↥Λ)
    {T : Scheme.{0}} {t : T ⟶ Spec (CommRingCat.of S)} (P : SchemeHomOver t E.f) :
    pushPt (E'.act x) (E'.act_over x) (mapPt i.hom hi P) = mapPt i.hom hi (pushPt (E.act x) (E.act_over x) P) :=
  Subtype.ext (by
    show (P.1 ≫ i.hom) ≫ E'.act x = (P.1 ≫ E.act x) ≫ i.hom
    rw [Category.assoc, ← hact x, Category.assoc])

theorem inv_mul {E E' : FakeEllipticCurve Λ N S} (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f),
      mapPt i.hom hi (E.L.mul t P Q) = E'.L.mul t (mapPt i.hom hi P) (mapPt i.hom hi Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E'.f) :
    mapPt i.inv (inv_over i hi) (E'.L.mul t P Q) =
      E.L.mul t (mapPt i.inv (inv_over i hi) P) (mapPt i.inv (inv_over i hi) Q) := by
  have h := hmul t (mapPt i.inv (inv_over i hi) P) (mapPt i.inv (inv_over i hi) Q)
  rw [mapPt_inv_hom, mapPt_inv_hom] at h
  rw [← h, mapPt_hom_inv]

noncomputable def mapIsoLevel (E E' : FakeEllipticCurve Λ N S) (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hiso : FakeEllipticCurve.IsoVia E E' i hi) {m : ℕ} (Pn : E.FullLevel m) : E'.FullLevel m where
  P := mapPt i.hom hi Pn.P
  torsion := by
    rw [← mapPt_nsmulPt E.L E'.L i.hom hi hiso.1, Pn.torsion, mapPt_one E.L E'.L i.hom hi hiso.1]
  generates := by
    intro k _ _ sk Q hQ
    have hQ₀ : nsmulPt E.L (geomPoint k sk) m (mapPt i.inv (inv_over i hi) Q) = E.L.one (geomPoint k sk) := by
      rw [← mapPt_nsmulPt E'.L E.L i.inv (inv_over i hi) (inv_mul i hi hiso.1), hQ,
        mapPt_one E'.L E.L i.inv (inv_over i hi) (inv_mul i hi hiso.1)]
    obtain ⟨x, hx⟩ := Pn.generates k sk (mapPt i.inv (inv_over i hi) Q) hQ₀
    refine ⟨x, ?_⟩
    rw [sectionAt_mapPt, pushPt_mapPt i hi hiso.2.1, hx, mapPt_inv_hom]
  annihilator := by
    intro k _ _ sk x
    rw [sectionAt_mapPt, pushPt_mapPt i hi hiso.2.1, ← Pn.annihilator k sk x]
    constructor
    · intro h
      have h' := congrArg (mapPt i.inv (inv_over i hi)) h
      rwa [mapPt_hom_inv, mapPt_one E'.L E.L i.inv (inv_over i hi) (inv_mul i hi hiso.1)] at h'
    · intro h
      rw [h, mapPt_one E.L E'.L i.hom hi hiso.1]

@[scoped simp] theorem mapIsoLevel_P (E E' : FakeEllipticCurve Λ N S) (i : E.A ≅ E'.A) (hi : i.hom ≫ E'.f = E.f)
    (hiso : FakeEllipticCurve.IsoVia E E' i hi) {m : ℕ} (Pn : E.FullLevel m) :
    (mapIsoLevel E E' i hi hiso Pn).P = mapPt i.hom hi Pn.P := rfl

end Level

section Omega
variable {𝒪 : Type} [CommRing 𝒪] {K : Type} [Field K] [Algebra 𝒪 K] (π : 𝒪)

theorem pullback_injective (B : Type) [CommRing B] [Algebra 𝒪 B] (g : Matrix.GeneralLinearGroup (Fin 2) K)
    {d d' : (Omega K π).obj B} (h : DeligneDatum.pullback π B g d = DeligneDatum.pullback π B g d') : d = d' := by
  have key : ∀ d : (Omega K π).obj B, (Omega.action K π).act B g ((Omega.action K π).act B g⁻¹ d) = d := fun d => by
    rw [← (Omega.action K π).act_mul, mul_inv_cancel, (Omega.action K π).act_one]
  have e : ∀ d : (Omega K π).obj B, (Omega.action K π).act B g⁻¹ d = DeligneDatum.pullback π B g d := fun d => by
    show DeligneDatum.pullback π B (g⁻¹)⁻¹ d = _
    rw [inv_inv]
  rw [← key d, ← key d', e, e, h]

end Omega

section Frob
variable {𝒪 : Type} [CommRing 𝒪] (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr] (Fr : Onr ≃ₐ[𝒪] Onr)

theorem frobTwist_neg_frobTwist (n : ℤ) {B : Type} [CommRing B] [Algebra 𝒪 B] (ψ : Onr →ₐ[𝒪] B) :
    frobTwist Onr Fr (-n) (frobTwist Onr Fr n ψ) = ψ := by
  ext x
  show ψ ((Fr ^ n) ((Fr ^ (-n)) x)) = ψ x
  congr 1
  rw [← AlgEquiv.mul_apply, ← zpow_add, add_neg_cancel, zpow_zero, AlgEquiv.one_apply]

end Frob

