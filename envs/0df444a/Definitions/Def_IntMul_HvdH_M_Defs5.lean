-- Source module: NLogN.HCrOut
/-!
# `crtOut` as a register program (namespace `NLogN.CR`)

Input: `w` (length `S = ∏ sᵢ`) on stack `0`, `S` on `1`, `kb` (`S ≤ 2^kb`) on `2`, the keys
`natInts (keyL s)` on `3`, `M ≤ S` on `cMR`.  Output: `crtOut s M w` on `0`; all else restored.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul IntMul.HvdH IntMul.HvdH.Ref RS

def crtOutP : RS :=
  NLogN.RS.seq (rangeP 0 kC1 (.reg 1)) (NLogN.RS.seq (permP 1) (NLogN.RS.seq (mvK 0 kT kC3 (.reg 1))
  (NLogN.RS.seq (mvK kT 3 kC3 (.reg 1)) (NLogN.RS.seq (permP 1) (NLogN.RS.seq (dropN 3 kC1 (.reg 1))
  (NLogN.RS.seq (mvK 0 kT kC3 (.reg cMR)) (NLogN.RS.seq (dropN 0 kC1 (.add (.reg 1) (.neg (.reg cMR))))
    (mvK kT 0 kC3 (.reg cMR)))))))))

end NLogN.CR

end

