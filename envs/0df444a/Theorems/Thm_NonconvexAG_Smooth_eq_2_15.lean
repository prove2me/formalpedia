-- title:
--   (2.15) — Ψ(x_k) ≤ Ψ(x_{k−1}) − λ_k(1 − L_Ψλ_k)‖∇Ψ(x^md_k)‖² + (L_Ψ(1−α_k)²/2)‖x^ag_{k−1} − x_{k−1}‖²
-- statement:
--   Let $\Psi:\mathbb R^n\to\mathbb R$ be differentiable with $L_\Psi$-Lipschitz gradient, $L_\Psi>0$, and let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$. Then for every $k\ge1$,
--   $$\Psi(x_k)\le\Psi(x_{k-1})-\lambda_k(1-L_\Psi\lambda_k)\|\nabla\Psi(x^{md}_k)\|^2+\frac{L_\Psi(1-\alpha_k)^2}{2}\|x^{ag}_{k-1}-x_{k-1}\|^2 .$$
--
--   This is the one-step progress of the $x$-sequence for a possibly nonconvex $\Psi$: a gradient decrease, corrected by the distance between the aggregated and the main iterate.
--
--   **Formalization Note** The statement is the outer ends of the chain (2.14)–(2.15).
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 5, (2.15)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.15), p. 5 (outer ends of the chain). -/
theorem eq_2_15 {n : ℕ} (Ψ : E n → ℝ) (g : E n → E n) (LΨ : ℝ)
    (hΨ : ConvexOptAlg.SmoothGD.IsBetaSmooth Ψ g LΨ) (hL : 0 < LΨ)
    (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k →
      Ψ (xSeq g α β lam x0 k) ≤ Ψ (xSeq g α β lam x0 (k - 1)) - lam k * (1 - LΨ * lam k) * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2
        + LΨ * (1 - α k) ^ 2 / 2 * ‖xagSeq g α β lam x0 (k - 1) - xSeq g α β lam x0 (k - 1)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
