  have hI := Complex.I_sq))
  have d3 : ∀ i μ, cpdC i (knE M a Q 3 μ) x = conj (cpdC i (knE M a Q 2 μ) x) := fun i μ => dE_3 M a Q i μ x
  refine ⟨?_, ?_, ?_, ?_⟩ <;>
  · rw [cL_KN M a Q hx]
    simp only [Fin.sum_univ_four, brk, fdir_KN, knE_2_1, knE_3_1, knE_2_2, knE_3_2, d3, d20t, d22t, d23t, d21,
      c00, c01, c02, c03, c10, c11, c12, c13, c20, c21, c22, c23, c30, c31, c32, c33, zero_mul, mul_zero, add_zero,
      zero_add, sub_zero, one_mul, map_zero]
    simp only [map_div₀, map_mul, map_sub, map_neg, map_one, Complex.conj_ofReal, Complex.conj_I, qK_conj,
      map_pow]
    clear d3
    ( (
  clear d00r d00t d03r d03t d10r d10t d11r d11t d13r d13t d20r d20t d22r d22t d23r d23t d01 d02 d12 d21
    c00 c01 c02 c03 c10 c11 c12 c13 c20 c21 c22 c23 c30 c31 c32 c33 hx))
    ( ((try simp) <;> (try push_cast) <;> (try field_simp) <;> (
  generalize Complex.cos ((x 2 : ℝ) : ℂ) = cc at *
  generalize Complex.sin ((x 2 : ℝ) : ℂ) = ss at *
  generalize ((Sig a (x 1) (x 2) : ℝ) : ℂ) = SS at *
