variable {G : Type*} [AddCommGroup G]

theorem abelianQuotient_generated_pair (a d h : G)
    (hgen : AddSubgroup.closure ({a, d, h} : Set G) = ⊤) :
    AddSubgroup.closure
      ({(a : G ⧸ AddSubgroup.zmultiples h),
        (d : G ⧸ AddSubgroup.zmultiples h)} : Set (G ⧸ AddSubgroup.zmultiples h)) = ⊤ := by sorry



