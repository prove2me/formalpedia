namespace FiniteSampleDependence.Dev.GoalA

open MvPolynomial
open scoped Classical

variable {σ : Type*}

/-- Set the variables in `Q` to zero. -/
noncomputable def killQ (Q : Finset σ) : MvPolynomial σ ℝ →ₐ[ℝ] MvPolynomial σ ℝ :=
  aeval (fun v => if v ∈ Q then 0 else X v)

/-- The ideal generated by the variables of `Q`. -/
noncomputable def Jid (Q : Finset σ) : Ideal (MvPolynomial σ ℝ) :=
  Ideal.span (X '' (Q : Set σ))

lemma killQ_X_mem (Q : Finset σ) {u : σ} (h : u ∈ Q) : killQ Q (X u) = 0 := by
  simp [killQ, h]

lemma killQ_X_not_mem (Q : Finset σ) {u : σ} (h : u ∉ Q) : killQ Q (X u) = X u := by
  simp [killQ, h]

lemma X_mem_Jid (Q : Finset σ) {u : σ} (h : u ∈ Q) : (X u : MvPolynomial σ ℝ) ∈ Jid Q :=
  Ideal.subset_span ⟨u, h, rfl⟩

lemma sub_killQ_mem (Q : Finset σ) (p : MvPolynomial σ ℝ) : p - killQ Q p ∈ Jid Q := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [killQ]
  | add p q hp hq =>
    have := Ideal.add_mem _ hp hq
    convert this using 1
    simp only [map_add]; ring
  | mul_X p u hp =>
    by_cases hu : u ∈ Q
    · rw [map_mul, killQ_X_mem Q hu, mul_zero, sub_zero]
      exact Ideal.mul_mem_left _ _ (X_mem_Jid Q hu)
    · rw [map_mul, killQ_X_not_mem Q hu, ← sub_mul]
      exact Ideal.mul_mem_right _ _ hp

lemma taylor_aux (Q : Finset σ) (p : MvPolynomial σ ℝ) :
    p - killQ Q p - ∑ v ∈ Q, killQ Q (pderiv v p) * X v ∈ Jid Q ^ 2 := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [killQ]
  | add p q hp hq =>
    have := Ideal.add_mem _ hp hq
    convert this using 1
    simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
  | mul_X p u hp =>
    by_cases hu : u ∈ Q
    · have h1 : ∀ v ∈ Q, killQ Q (pderiv v (p * X u)) * X v
          = if v = u then killQ Q p * X v else 0 := by
        intro v hv
        rw [Derivation.leibniz, pderiv_X]
        simp only [smul_eq_mul, map_add, map_mul, killQ_X_mem Q hu, mul_zero, add_zero]
        by_cases hvu : v = u
        · subst hvu; simp
        · simp [hvu, Pi.single_apply, Ne.symm hvu]
      rw [Finset.sum_congr rfl h1, Finset.sum_ite_eq' Q u, if_pos hu]
      have : p * X u - killQ Q (p * X u) - killQ Q p * X u = (p - killQ Q p) * X u := by
        rw [map_mul, killQ_X_mem Q hu]; ring
      rw [this, pow_two]
      exact Ideal.mul_mem_mul (sub_killQ_mem Q p) (X_mem_Jid Q hu)
    · have h1 : ∀ v ∈ Q, killQ Q (pderiv v (p * X u)) * X v
          = X u * (killQ Q (pderiv v p) * X v) := by
        intro v hv
        have hvu : v ≠ u := fun h => hu (h ▸ hv)
        rw [Derivation.leibniz, pderiv_X]
        simp only [smul_eq_mul, map_add, map_mul, killQ_X_not_mem Q hu, Pi.single_apply,
          Ne.symm hvu, if_false, mul_zero, zero_add]
        ring
      rw [Finset.sum_congr rfl h1, ← Finset.mul_sum, map_mul, killQ_X_not_mem Q hu]
      have : p * X u - killQ Q p * X u - X u * ∑ v ∈ Q, killQ Q (pderiv v p) * X v
          = X u * (p - killQ Q p - ∑ v ∈ Q, killQ Q (pderiv v p) * X v) := by ring
      rw [this]
      exact Ideal.mul_mem_left _ _ hp

lemma taylor (Q : Finset σ) (p : MvPolynomial σ ℝ) (h0 : killQ Q p = 0)
    (h1 : ∀ v ∈ Q, killQ Q (pderiv v p) = 0) : p ∈ Jid Q ^ 2 := by
  have := taylor_aux Q p
  rw [h0, Finset.sum_eq_zero (fun v hv => by rw [h1 v hv, zero_mul]), sub_zero, sub_zero] at this
  exact this

lemma eval_killQ (Q : Finset σ) (p : MvPolynomial σ ℝ) (x : σ → ℝ) :
    eval x (killQ Q p) = eval (fun v => if v ∈ Q then 0 else x v) p := by
  have : (eval x).comp (killQ Q : MvPolynomial σ ℝ →ₐ[ℝ] _).toRingHom
      = eval (fun v => if v ∈ Q then 0 else x v) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun v => ?_)
    · simp [killQ]
    · by_cases h : v ∈ Q <;> simp [killQ, h]
  exact congrArg (fun f => f p) this

lemma hasDerivAt_eval_update (P : MvPolynomial σ ℝ) (x : σ → ℝ) (v : σ) :
    HasDerivAt (fun s => eval (Function.update x v s) P) (eval x (pderiv v P)) (x v) := by
  induction P using MvPolynomial.induction_on with
  | C a => simpa using hasDerivAt_const (x v) a
  | add p q hp hq =>
    simp only [map_add]
    exact hp.add hq
  | mul_X p u hp =>
    have h2 : HasDerivAt (fun s => Function.update x v s u) (if u = v then 1 else 0) (x v) := by
      by_cases huv : u = v
      · subst huv
        simp only [Function.update_self, if_true]
        exact hasDerivAt_id' (x u)
      · simp only [huv, if_false, Function.update_of_ne huv]
        exact hasDerivAt_const (x v) (x u)
    simp only [map_mul, eval_X]
    refine (hp.mul h2).congr_deriv ?_
    rw [Derivation.leibniz, pderiv_X]
    simp [Pi.single_apply, eq_comm]
    split_ifs <;> simp [add_comm, mul_comm]

end FiniteSampleDependence.Dev.GoalA
