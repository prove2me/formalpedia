lemma credit_deletion (N D oldWork newWork calls reports stopped cost : ℕ)
    (hw : oldWork ≤ newWork) (hs : stopped ≤ 1)
    (hc : cost ≤ D*(newWork-oldWork)+40*N+240) :
    cost+20+nativeCredit N D oldWork calls reports stopped ≤ nativeCredit N D newWork (calls+5) reports 0 := by
  have heq : newWork = oldWork+(newWork-oldWork) := by omega
  unfold nativeCredit
  rw [heq]
  simp only [Nat.mul_add,Nat.add_mul]
