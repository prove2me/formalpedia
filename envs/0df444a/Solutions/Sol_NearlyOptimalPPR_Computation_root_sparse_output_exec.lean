lemma pruned_output_list_potential {n : ℕ} (g : InputGraph n) (α q : ℝ) (x : Fin n → ℝ)
    (vertices : List (Fin n)) (hn : vertices.Nodup)
    (hz : ∀ v ∉ vertices.toFinset, prune q x v=0) :
