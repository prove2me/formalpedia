      (∀ (u : ∀ i, PolarisedAbelianScheme g d n (B' i)),
        (∀ i, Nonempty ((Scheme.Modules.pullback ((u i).L.one (𝟙 (Spec (CommRingCat.of (B' i))))).1).obj (u i).pol ≅
            SheafOfModules.unit (Spec (CommRingCat.of (B' i))).ringCatSheaf)) →
        (∀ (i j : Fin k') (C : Type) [CommRing C] [Algebra S C] [IsLocalization.Away (r' i * r' j) C]
            (ρ₁ : B' i →ₐ[S] C) (ρ₂ : B' j →ₐ[S] C) (v₁ v₂ : PolarisedAbelianScheme g d n C),
            PolarisedAbelianScheme.IsPullback ρ₁.toRingHom (u i) v₁ →
            PolarisedAbelianScheme.IsPullback ρ₂.toRingHom (u j) v₂ →
            PolarisedAbelianScheme.Iso v₁ v₂) →
        ∃ u₀ : PolarisedAbelianScheme g d n S, ∀ (i : Fin k') (v : PolarisedAbelianScheme g d n (B' i)),
          PolarisedAbelianScheme.IsPullback (algebraMap S (B' i)) u₀ v → PolarisedAbelianScheme.Iso v (u i)))
    {k : ℕ} (r : Fin k → S) (hr : Ideal.span (Set.range r) = ⊤)
    (B : Fin k → Type) [∀ i, CommRing (B i)] [∀ i, Algebra S (B i)] [∀ i, IsLocalization.Away (r i) (B i)] :
    (∀ (u : ∀ i, PolarisedAbelianScheme g d n (B i)),
      (∀ (i j : Fin k) (C : Type) [CommRing C] [Algebra S C] [IsLocalization.Away (r i * r j) C]
          (ρ₁ : B i →ₐ[S] C) (ρ₂ : B j →ₐ[S] C) (v₁ v₂ : PolarisedAbelianScheme g d n C),
          PolarisedAbelianScheme.IsPullback ρ₁.toRingHom (u i) v₁ →
          PolarisedAbelianScheme.IsPullback ρ₂.toRingHom (u j) v₂ →
          PolarisedAbelianScheme.Iso v₁ v₂) →
      ∃ u₀ : PolarisedAbelianScheme g d n S, ∀ (i : Fin k) (v : PolarisedAbelianScheme g d n (B i)),
        PolarisedAbelianScheme.IsPullback (algebraMap S (B i)) u₀ v → PolarisedAbelianScheme.Iso v (u i)) := by
  classical
  intro u hu
  have RST := fun (T : Type) (_ : CommRing T) =>
    AlgebraicGeometry.PolarisedAbelianScheme.Iso.refl_symm_trans (g := g) (d := d) (n := n) (S := T)

  have hA : ∀ i, ∃ (kᵢ : ℕ) (s : Fin kᵢ → B i), Ideal.span (Set.range s) = ⊤ ∧
      ∀ m, Nonempty ((Scheme.Modules.pullback
          (Spec.map (CommRingCat.ofHom (algebraMap (B i) (Localization.Away (s m)))))).obj
          ((Scheme.Modules.pullback ((u i).L.one (𝟙 _)).1).obj (u i).pol) ≅
        SheafOfModules.unit (Spec (CommRingCat.of (Localization.Away (s m)))).ringCatSheaf) := by
    intro i
    obtain ⟨kᵢ, s, hs, htriv, -, -⟩ :=
      AlgebraicGeometry.Scheme.Modules.IsInvertible.exists_finite_away_cover_trivial
        ((Scheme.Modules.pullback ((u i).L.one (𝟙 _)).1).obj (u i).pol)
        (Scheme.Modules.IsInvertible.pullback _ (u i).pol_isInvertible)
    exact ⟨kᵢ, s, hs, htriv⟩
  choose kk s hs htriv using hA

  let J := Σ i : Fin k, Fin (kk i)
  let e : Fin (Fintype.card J) ≃ J := (Fintype.equivFin J).symm
  let B' : Fin (Fintype.card J) → Type := fun j => Localization.Away (s (e j).1 (e j).2)
  let a : ∀ j : Fin (Fintype.card J), S := fun j => (IsLocalization.Away.sec (r (e j).1) (s (e j).1 (e j).2)).1
  let r' : Fin (Fintype.card J) → S := fun j => r (e j).1 * a j
  haveI hB'loc : ∀ j, IsLocalization.Away (r' j) (B' j) := fun j =>
    IsLocalization.Away.mul_of_associated (S := B (e j).1) (r (e j).1) (a j) (s (e j).1 (e j).2)
      (IsLocalization.Away.associated_sec_fst (r (e j).1) _)

  have hr' : Ideal.span (Set.range r') = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hle⟩ := Ideal.exists_le_maximal _ hne

    have hi : ∃ i, r i ∉ 𝔪 := by
      by_contra hcon; simp only [not_exists, not_not] at hcon
      have : Ideal.span (Set.range r) ≤ 𝔪 := Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hcon i)
      rw [hr, top_le_iff] at this; exact h𝔪.ne_top this
    obtain ⟨i, hi⟩ := hi

    let p : PrimeSpectrum S := ⟨𝔪, h𝔪.isPrime⟩
    have hp : p ∈ Set.range (PrimeSpectrum.comap (algebraMap S (B i))) := by
      rw [PrimeSpectrum.localization_away_comap_range (B i) (r i)]; exact hi
    obtain ⟨q, hq⟩ := hp
    have hm : ∃ m, s i m ∉ q.asIdeal := by
      by_contra hcon; simp only [not_exists, not_not] at hcon
      have : Ideal.span (Set.range (s i)) ≤ q.asIdeal := Ideal.span_le.mpr (by rintro _ ⟨m, rfl⟩; exact hcon m)
      rw [hs i, top_le_iff] at this; exact q.2.ne_top this
    obtain ⟨m, hm⟩ := hm
    have ha : algebraMap S (B i) (IsLocalization.Away.sec (r i) (s i m)).1 ∉ q.asIdeal := by
      intro hmem
      obtain ⟨w, hw⟩ := (IsLocalization.Away.associated_sec_fst (S := B i) (r i) (s i m)).symm
      have hsw : s i m = algebraMap S (B i) (IsLocalization.Away.sec (r i) (s i m)).1 * ↑w⁻¹ := by
        rw [← hw, mul_assoc, Units.mul_inv, mul_one]
      exact hm (by rw [hsw]; exact q.asIdeal.mul_mem_right _ hmem)
    have ha' : (IsLocalization.Away.sec (r i) (s i m)).1 ∉ 𝔪 := by
      intro hmem; apply ha
      have : (IsLocalization.Away.sec (r i) (s i m)).1 ∈ (PrimeSpectrum.comap (algebraMap S (B i)) q).asIdeal := by
        rw [hq]; exact hmem
      exact this
    have hmem : r' (e.symm ⟨i, m⟩) ∈ 𝔪 := hle (Ideal.subset_span ⟨_, rfl⟩)
    have key : ∀ (j : Fin (Fintype.card J)) (p : J), e j = p →
        r' j = r p.1 * (IsLocalization.Away.sec (r p.1) (s p.1 p.2)).1 := by
      intro j p hp; subst hp; rfl
    rw [key (e.symm ⟨i, m⟩) ⟨i, m⟩ (e.apply_symm_apply _)] at hmem
    exact (h𝔪.isPrime.mem_or_mem hmem).elim hi ha'

  choose u' hu' using fun j => AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback (algebraMap (B (e j).1) (B' j)) (u (e j).1)

  have htriv' : ∀ j, Nonempty ((Scheme.Modules.pullback ((u' j).L.one (𝟙 (Spec (CommRingCat.of (B' j))))).1).obj (u' j).pol ≅
      SheafOfModules.unit (Spec (CommRingCat.of (B' j))).ringCatSheaf) := by
    intro j
    obtain ⟨gA, hg, hmul, -, ⟨ψ⟩⟩ := hu' j
    have hone := AlgebraicGeometry.PolarisedAbelianScheme.one_comp_eq_specMap_comp_one_of_mul (algebraMap (B (e j).1) (B' j)) (u (e j).1) (u' j) gA hg hmul
    obtain ⟨τ⟩ := htriv (e j).1 (e j).2
    exact ⟨(Scheme.Modules.pullback ((u' j).L.one (𝟙 _)).1).mapIso ψ.symm ≪≫
      (Scheme.Modules.pullbackComp ((u' j).L.one (𝟙 _)).1 gA).app (u (e j).1).pol ≪≫
      (Scheme.Modules.pullbackCongr hone).app (u (e j).1).pol ≪≫
      ((Scheme.Modules.pullbackComp _ ((u (e j).1).L.one (𝟙 _)).1).app (u (e j).1).pol).symm ≪≫ τ⟩

  have hov' : ∀ (j j' : Fin (Fintype.card J)) (C : Type) [CommRing C] [Algebra S C] [IsLocalization.Away (r' j * r' j') C]
      (ρ₁ : B' j →ₐ[S] C) (ρ₂ : B' j' →ₐ[S] C) (v₁ v₂ : PolarisedAbelianScheme g d n C),
      PolarisedAbelianScheme.IsPullback ρ₁.toRingHom (u' j) v₁ →
      PolarisedAbelianScheme.IsPullback ρ₂.toRingHom (u' j') v₂ →
      PolarisedAbelianScheme.Iso v₁ v₂ := by
    intro j j' C _ _ _ ρ₁ ρ₂ v₁ v₂ hv₁ hv₂

    let C₀ := Localization.Away (r (e j).1 * r (e j').1)
    have hunit : ∀ (c x : S) (T : Type) [CommRing T] [Algebra S T] [IsLocalization.Away x T], c ∣ x →
        ∀ y : Submonoid.powers c, IsUnit (Algebra.ofId S T y) := by
      intro c x T _ _ _ hcx y
      obtain ⟨n, hn⟩ := y.2
      show IsUnit (algebraMap S T y)
      rw [← hn, map_pow]
      exact (IsLocalization.Away.isUnit_of_dvd (x := x) hcx).pow n
    let σ₁ : B (e j).1 →ₐ[S] C₀ := IsLocalization.liftAlgHom (M := Submonoid.powers (r (e j).1)) (f := Algebra.ofId S C₀)
