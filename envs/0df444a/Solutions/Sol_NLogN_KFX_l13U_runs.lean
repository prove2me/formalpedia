theorem ESp.ofAgree {σ : Fin HS → Option ℤ} {t : IState HS} (hA : Agree σ t) {r : Fin HS} {v : ℤ}
    (h : σ r = some v) (hr : r.val < 56) {Bb : ℕ} (hb : zsz v ≤ Bb) : ESp (.reg r) t Bb v := by
  refine ⟨fun i hi => ?_, hA.isInt h, ?_, hA.top h⟩
  · simp only [Ex.regs, List.mem_singleton] at hi; subst hi; exact notMem_zX hr
  · show zsz (t.top r) ≤ Bb; rw [hA.top h]; exact hb

theorem ESp.of_eq {e : Ex HS} {t : IState HS} {Bb : ℕ} {v v' : ℤ} (h : ESp e t Bb v) (hv : v = v') :
    ESp e t Bb v' := hv ▸ h

theorem ESp.mulN {a b : Ex HS} {t : IState HS} {Bb : ℕ} {x y : ℕ} (ha : ESp a t Bb (x : ℤ))
    (hb : ESp b t Bb (y : ℤ)) (h : zsz ((x * y : ℕ) : ℤ) ≤ Bb) :
    ESp (.mul a b) t Bb ((x * y : ℕ) : ℤ) := by
  have := ESp.mul ha hb (by push_cast at h; exact h)
  push_cast; exact this

theorem ESp.ndivN {a b : Ex HS} {t : IState HS} {Bb : ℕ} {x y : ℕ} (ha : ESp a t Bb (x : ℤ))
    (hb : ESp b t Bb (y : ℤ)) (hy : 0 < y) (h : zsz ((x / y : ℕ) : ℤ) ≤ Bb) :
    ESp (.ndiv a b) t Bb ((x / y : ℕ) : ℤ) := by
  have e : ((x / y : ℕ) : ℤ) = (x : ℤ) / (y : ℤ) := Int.natCast_div x y
  rw [e] at h ⊢
  exact ESp.ndiv ha hb (by positivity) (by exact_mod_cast hy) h

theorem ESp.litN {t : IState HS} {Bb : ℕ} {x : ℕ} (h : zsz (x : ℤ) ≤ Bb) :
    ESp (.lit (x : ℤ)) t Bb (x : ℤ) := ESp.lit h

section Vals

variable {N0 N1 N2 N3 K f ρ R w : ℕ} {px py : Fin 3} {t : IState HS}

theorem PPos.geo (h : PPos N0 N1 N2 N3 K f ρ R) : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Pos :=
  geoB_pos h.n0 h.n1 h.n2 h.n3 h.r

theorem gB_V (N0 N1 N2 N3 K f R w : ℕ) : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V =
    N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))) := by
  simp only [NLogN.KFX.gB, geoB, Geo.V, Geo.S0, Geo.S1, Geo.S2]; ring

/-- Every divisor of `V` has at most `zsz V + 3` bits. -/
theorem zdvd (hp : PPos N0 N1 N2 N3 K f ρ R) {a : ℕ}
    (h : a ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    zsz (a : ℤ) ≤ zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 :=
  le_trans (NLogN.KIL.zsz_nat_le (Nat.le_of_dvd (hp.geo (w := w)).v h)) (by omega)

theorem fK_ge (hp : PPos N0 N1 N2 N3 K f ρ R) : K ≤ f * K := Nat.le_mul_of_pos_left _ hp.f

variable (hp : PPos N0 N1 N2 N3 K f ρ R) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
include hp hA

theorem zQV : 2 ^ (f * K) ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V :=
  ⟨N0 * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩

theorem sQ : ESp (.reg mQ) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) ((2 ^ (f * K) : ℕ) : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp (zQV hp hA))

theorem sN0 : ESp (.reg mN0) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (N0 : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp
    ⟨2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))),
      by rw [gB_V]; ring⟩)

theorem sN1 : ESp (.reg mN1) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (N1 : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp
    ⟨N0 * 2 ^ (f * K) * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))),
      by rw [gB_V]; ring⟩)

theorem sN2 : ESp (.reg mN2) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (N2 : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))),
      by rw [gB_V]; ring⟩)

theorem sN3 : ESp (.reg mN3) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (N3 : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (R * (2 * (w + 1))),
      by rw [gB_V]; ring⟩)

theorem sB : ESp (.reg mB) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((R * (2 * (w + 1)) : ℕ) : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * N3, by rw [gB_V]; ring⟩)

theorem sR2 : ESp (.reg mR2) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) ((2 ^ ρ : ℕ) : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp (dvd_trans (Nat.pow_dvd_pow 2
    (by have := fK_ge hp; have := hp.ρ; omega)) (zQV hp hA)))

theorem sK2 : ESp (.reg mK2) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) ((2 ^ K : ℕ) : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (zdvd hp (dvd_trans (Nat.pow_dvd_pow 2 (fK_ge hp)) (zQV hp hA)))

theorem sGx : ESp (.reg mGx) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (gxV N2 K f px : ℤ) := by
  refine ESp.ofAgree hA rfl (by decide) (zdvd hp ?_)
  unfold gxV; split_ifs
  · exact ⟨N0 * N1 * 2 ^ (f * K) * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩
  · exact one_dvd _

theorem sA : ESp (.reg mA) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (le_trans (KFE.zsz_le_self _) (by omega))

theorem fK_lt_V : f * K < (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V :=
  lt_of_lt_of_le (Nat.lt_two_pow_self) (Nat.le_of_dvd (hp.geo (w := w)).v (zQV hp hA))

theorem sF : ESp (.reg mF) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (f : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (le_trans (NLogN.KIL.zsz_nat_le (le_trans (Nat.le_mul_of_pos_right _
    (by have := hp.k; omega)) (fK_lt_V hp hA).le)) (by omega))

theorem sK : ESp (.reg mK) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) (K : ℤ) :=
  ESp.ofAgree hA rfl (by decide) (le_trans (NLogN.KIL.zsz_nat_le (le_trans (fK_ge hp)
    (fK_lt_V hp hA).le)) (by omega))

theorem sFK : ESp eFK t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) ((f * K : ℕ) : ℤ) :=
  ESp.mulN (sF hp hA) (sK hp hA) (le_trans (NLogN.KIL.zsz_nat_le (fK_lt_V hp hA).le) (by omega))

theorem sFm1 : ESp eFm1 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) ((f - 1 : ℕ) : ℤ) := by
  have h1 : zsz ((f - 1 : ℕ) : ℤ) ≤ zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 :=
    le_trans (NLogN.KIL.zsz_nat_le (le_trans (le_trans (Nat.sub_le f 1) (Nat.le_mul_of_pos_right _
      (by have := hp.k; omega))) (fK_lt_V hp hA).le)) (by omega)
  have e : ((f - 1 : ℕ) : ℤ) = (f : ℤ) + -1 := by have := hp.f; push_cast [Nat.cast_sub this]; ring
  rw [e] at h1 ⊢
  exact ESp.add (sF hp hA) (ESp.lit (by rw [zsz_neg, zsz_one]; omega)) h1

theorem dV {a : ℕ} (h : a ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    zsz (a : ℤ) ≤ zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 := zdvd hp h

theorem sS2 : ESp eS2 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N3 * (R * (2 * (w + 1))) : ℕ) : ℤ) :=
  ESp.mulN (sN3 hp hA) (NLogN.KFX.sB hp hA) (dV hp hA
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K), by rw [gB_V]; ring⟩)

theorem sP1 : ESp eP1 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N0 * 2 ^ (f * K) * N1 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sN0 hp hA) (sQ hp hA) (dV hp hA
    ⟨N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))
    (sN1 hp hA) (dV hp hA
    ⟨2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩)

theorem sGA : ESp eGA t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N1 * gxV N2 K f px : ℕ) : ℤ) := by
  refine ESp.mulN (sN1 hp hA) (sGx hp hA) (dV hp hA ?_)
  unfold gxV; split_ifs
  · exact ⟨N0 * 2 ^ (f * K) * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩
  · exact ⟨N0 * 2 ^ (f * K) * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))),
      by rw [gB_V]; ring⟩

theorem gx_pos : 0 < gxV N2 K f px := by
  unfold gxV; split_ifs
  · exact Nat.mul_pos (by positivity) (by have := hp.n2; omega)
  · exact Nat.one_pos

theorem sSA : ESp eSA t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) / gxV N2 K f px : ℕ) : ℤ) := by
  have hx : N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V :=
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K), by rw [gB_V]; ring⟩
  refine ESp.ndivN (ESp.mulN (ESp.mulN (ESp.mulN (sN2 hp hA) (sQ hp hA) (dV hp hA
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))
    (sN3 hp hA) (dV hp hA
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩))
    (NLogN.KFX.sB hp hA) (dV hp hA hx)) (sGx hp hA) (gx_pos hp hA)
    (dV hp hA (dvd_trans (Nat.div_dvd_of_dvd ?_) hx))
  unfold gxV; split_ifs
  · exact ⟨N3 * (R * (2 * (w + 1))), by ring⟩
  · exact one_dvd _

theorem sRP : ESp eRP t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sP1 hp hA) (sQ hp hA) (dV hp hA
    ⟨N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))
    (sN2 hp hA) (dV hp hA ⟨2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩)

theorem sD0 : ESp eD0 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N2 * 2 ^ (f * K) * N1 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sN2 hp hA) (sQ hp hA) (dV hp hA
    ⟨N0 * N1 * 2 ^ (f * K) * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))
    (sN1 hp hA) (dV hp hA
    ⟨N0 * 2 ^ (f * K) * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩)

/-- The exponent `j = ρ + (f-1) K` of the last bit. -/
theorem jK_eq : f * K - (ρ + (f - 1) * K) - 1 = K - ρ - 1 := by
  have hf := hp.f; have hρ := hp.ρ
  have : (f - 1) * K + K = f * K := by
    have e : f = (f - 1) + 1 := by omega
    conv_rhs => rw [e]
    ring
  omega

theorem sE : ESp NLogN.KFX.eE t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ) := by
  have hρ := hp.ρ
  have e1 : 2 * 2 ^ ρ = 2 ^ (ρ + 1) := by ring
  have e2 : 2 ^ K / (2 * 2 ^ ρ) = 2 ^ (f * K - (ρ + (f - 1) * K) - 1) := by
    have e3 : 2 ^ K / 2 ^ (ρ + 1) = 2 ^ (K - (ρ + 1)) := Nat.pow_div (by omega) (by norm_num)
    rw [e1, e3, jK_eq hp hA]; congr 1
  have hKQ : 2 ^ K ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V :=
    dvd_trans (Nat.pow_dvd_pow 2 (fK_ge hp)) (zQV hp hA)
  have h2 : ESp (.mul (.lit 2) (.reg mR2)) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
      ((2 * 2 ^ ρ : ℕ) : ℤ) :=
    ESp.mulN (ESp.litN (le_trans (NLogN.KIL.zsz_nat_le (show 2 ≤ 2 ^ K from
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) hp.k)) (dV hp hA hKQ)))
      (sR2 hp hA) (dV hp hA (dvd_trans (by rw [e1]; exact Nat.pow_dvd_pow 2 (by omega)) hKQ))
  have := ESp.ndivN (sK2 hp hA) h2 (by positivity) (by
    rw [e2]; exact dV hp hA (dvd_trans (Nat.pow_dvd_pow 2 (by rw [jK_eq hp hA]; omega)) hKQ))
  rw [e2] at this; exact this

theorem sD : ESp eD t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (ρ + (f - 1) * K) : ℕ) : ℤ) := by
  have hρ := hp.ρ; have hf := hp.f
  have hj := jK_eq hp hA
  have hfK : (f - 1) * K + K = f * K := by
    have e : f = (f - 1) + 1 := by omega
    conv_rhs => rw [e]
    ring
  have e1 : 2 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) = 2 ^ (K - ρ) := by
    rw [hj, ← pow_succ']; congr 1; omega
  have e2 : 2 ^ (f * K) / (2 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) = 2 ^ (ρ + (f - 1) * K) := by
    rw [e1, Nat.pow_div (by omega) (by norm_num)]; congr 1; omega
  have h2 : ESp (.mul (.lit 2) NLogN.KFX.eE) t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
      ((2 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ) :=
    ESp.mulN (ESp.litN (le_trans (NLogN.KIL.zsz_nat_le (show 2 ≤ 2 ^ (f * K) from
      calc 2 = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ (f * K) := Nat.pow_le_pow_right (by norm_num) (by
          have := fK_ge hp; have := hp.k; omega))) (dV hp hA (zQV hp hA))))
      (NLogN.KFX.sE hp hA) (dV hp hA (dvd_trans (by rw [e1]; exact Nat.pow_dvd_pow 2 (by omega))
        (zQV hp hA)))
  have := ESp.ndivN (sQ hp hA) h2 (by positivity) (by
    rw [e2]; exact dV hp hA (dvd_trans (Nat.pow_dvd_pow 2 (by omega)) (zQV hp hA)))
  rw [e2] at this; exact this

theorem E_dvd_Q : 2 ^ (f * K - (ρ + (f - 1) * K) - 1) ∣ 2 ^ (f * K) :=
  Nat.pow_dvd_pow 2 (by omega)

theorem D_dvd_Q : 2 ^ (ρ + (f - 1) * K) ∣ 2 ^ (f * K) := by
  have hρ := hp.ρ; have hf := hp.f
  have hfK : (f - 1) * K + K = f * K := by
    have e : f = (f - 1) + 1 := by omega
    conv_rhs => rw [e]
    ring
  exact Nat.pow_dvd_pow 2 (by omega)

theorem sXP : ESp eXP t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ) :=
  ESp.mulN (sP1 hp hA) (NLogN.KFX.sE hp hA) (dV hp hA (dvd_trans (Nat.mul_dvd_mul_left _ (E_dvd_Q hp hA))
    ⟨N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))

theorem sXd : ESp eXd t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1) : ℕ) : ℤ) :=
  ESp.mulN (sN1 hp hA) (NLogN.KFX.sE hp hA) (dV hp hA (dvd_trans (Nat.mul_dvd_mul_left _ (E_dvd_Q hp hA))
    ⟨N0 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))), by rw [gB_V]; ring⟩))

theorem sXB : ESp eXB t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (ρ + (f - 1) * K) * (2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))) * N2) : ℕ) : ℤ) := by
  have h1 : 2 ^ (f * K) * (N3 * (R * (2 * (w + 1)))) * N2 ∣ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V :=
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K), by rw [gB_V]; ring⟩
  refine ESp.mulN (sD hp hA) (ESp.mulN (ESp.mulN (sQ hp hA) (sS2 hp hA) (dV hp hA
    ⟨N0 * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K), by rw [gB_V]; ring⟩)) (sN2 hp hA) (dV hp hA h1))
    (dV hp hA (dvd_trans (Nat.mul_dvd_mul_right (D_dvd_Q hp hA) _) ?_))
  exact ⟨N0 * 2 ^ (f * K) * N1, by rw [gB_V]; ring⟩

theorem sRS1 : ESp eRS1 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (f * K) * (N3 * 1) * N2 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sQ hp hA) (ESp.mulN (sN3 hp hA) (ESp.litN (by
    rw [Nat.cast_one, zsz_one]; omega)) (dV hp hA
    ⟨N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (R * (2 * (w + 1))),
      by rw [gB_V]; ring⟩)) (dV hp hA
    ⟨N0 * N1 * 2 ^ (f * K) * N2 * 2 ^ (f * K) * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩))
    (sN2 hp hA) (dV hp hA
    ⟨N0 * N1 * 2 ^ (f * K) * 2 ^ (f * K) * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩)

theorem sRS0 : ESp eRS0 t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (f * K) * (2 ^ (f * K) * (N3 * 1) * N2) * N1 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sQ hp hA) (sRS1 hp hA) (dV hp hA
    ⟨N0 * N1 * 2 ^ (f * K) * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩))
    (sN1 hp hA) (dV hp hA ⟨N0 * 2 ^ (f * K) * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩)

theorem sRV : ESp eRV t (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)
    ((2 ^ (f * K) * (2 ^ (f * K) * (2 ^ (f * K) * (N3 * 1) * N2) * N1) * N0 : ℕ) : ℤ) :=
  ESp.mulN (ESp.mulN (sQ hp hA) (sRS0 hp hA) (dV hp hA
    ⟨N0 * (R * (2 * (w + 1))), by rw [gB_V]; ring⟩))
    (sN0 hp hA) (dV hp hA ⟨R * (2 * (w + 1)), by rw [gB_V]; ring⟩)

end Vals

end NLogN.KFX

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly

theorem preL_eq (px py : Fin 3) (h : px ≠ py) : preL px py = NLogN.KFX.lA px ++ lB px py := by
  fin_cases px <;> fin_cases py <;> simp_all [preL, NLogN.KFX.lA, lB, flB]

theorem preL_rev (px py : Fin 3) (h : px ≠ py) : (preL px py).reverse = lB px py ++ NLogN.KFX.lA px := by
  fin_cases px <;> fin_cases py <;> simp_all [preL, NLogN.KFX.lA, lB, flB]

theorem flB_le (px py : Fin 3) : flB px py ≤ 1 := by
  fin_cases px <;> fin_cases py <;> simp [flB]

theorem compL_append : ∀ (a b : List (Fin 3)), compL (a ++ b) = compL a ∘ compL b
  | [], b => rfl
  | i :: a, b => by simp only [List.cons_append, compL, compL_append a b]; rfl

theorem agree_upd0 {σ : Fin HS → Option ℤ} {t : IState HS} (hA : Agree σ t) (h0 : σ 0 = none)
    (L : List Item) : Agree σ (t.upd 0 L) := by
  refine hA.congr (fun i hi => ?_)
  have : i ≠ 0 := fun e => by subst e; rw [h0] at hi; simp at hi
  simp [IState.upd_G, this]

theorem cl_of_agree {σ : Fin HS → Option ℤ} {t : IState HS} (hA : Agree σ t) {r : Fin HS}
    {v : ℤ} (h : σ r = some v) : t.cl r = cls (some (.int v)) := by
  obtain ⟨L, hL⟩ := hA r v h
  simp [IState.cl, hL]

section Runs

variable {N0 N1 N2 N3 K f ρ R w : ℕ} {px py : Fin 3} {t : IState HS}

theorem nk_P1 : NoK eP1 := by unfold NoK; decide
theorem nk_N2 : NoK (.reg mN2) := by unfold NoK; decide
theorem nk_S2 : NoK eS2 := by unfold NoK; decide
theorem nk_FK : NoK eFK := by unfold NoK; decide
theorem nk_N0 : NoK (.reg mN0) := by unfold NoK; decide
theorem nk_GA : NoK eGA := by unfold NoK; decide
theorem nk_SA : NoK eSA := by unfold NoK; decide

theorem optA_runs {q : ℕ} {Ksw : ℝ} (hK : 0 ≤ Ksw) (HSw : SwEOK q Ksw)
    (hp : PPos N0 N1 N2 N3 K f ρ R) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (I : List Sym) (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hl : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog (optA q) t
      (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (compL (NLogN.KFX.lA px)) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 26 + Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  have hg : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Pos := hp.geo
  have hu : 1 ≤ f * K := Nat.mul_pos hp.f hp.k
  have hQ : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Q = 2 ^ (f * K) := rfl
  have hX : 0 ≤ Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by positivity
  have hfa : t.cl mFa = cls (some (.int (flA px : ℕ))) := cl_of_agree hA rfl
  have hn2 := hp.n2
  fin_cases px
  · refine ⟨1 + 25, ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    refine IRuns.iteF (by rw [hfa]; decide) ?_
    refine (IRuns.skip t).mono' ?_ le_rfl
    show t = t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) id zs) ++ R0)
    rw [rixT_id hl, ← h0, IState.upd_self]
  · obtain ⟨c, Hc, hc⟩ := HSw 0 _ hg (f * K) hu hQ I t zs R0 hb h0 hl (.reg mN0) eGA eSA eFK _
      le_rfl (by decide) nk_N0 nk_GA nk_SA nk_FK (sN0 hp hA)
      (ESp.of_eq (sGA hp hA) (by simp [gxV, svG, NLogN.KFX.gB, geoB]))
      (ESp.of_eq (sSA hp hA) (by simp [gxV, svS, vol, NLogN.KFX.gB, geoB] <;> ring)) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfa]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [NLogN.KFX.lA, compL]) le_rfl
  · have hdiv : N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) / (2 ^ (f * K) * N2) =
        N3 * (R * (2 * (w + 1))) := by
      rw [show N2 * 2 ^ (f * K) * N3 * (R * (2 * (w + 1))) =
        (2 ^ (f * K) * N2) * (N3 * (R * (2 * (w + 1)))) by ring,
        Nat.mul_div_cancel_left _ (Nat.mul_pos (by positivity) (by omega))]
    obtain ⟨c, Hc, hc⟩ := HSw 2 _ hg (f * K) hu hQ I t zs R0 hb h0 hl (.reg mN0) eGA eSA eFK _
      le_rfl (by decide) nk_N0 nk_GA nk_SA nk_FK (sN0 hp hA)
      (ESp.of_eq (sGA hp hA) (by simp [gxV, svG, vol, NLogN.KFX.gB, geoB] <;> ring))
      (ESp.of_eq (sSA hp hA) (by simp only [gxV]; rw [if_pos (by decide), hdiv]; simp [svS, vol, NLogN.KFX.gB, geoB])) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfa]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [NLogN.KFX.lA, compL]) le_rfl

theorem optB_runs {q : ℕ} {Ksw : ℝ} (hK : 0 ≤ Ksw) (HSw : SwEOK q Ksw)
    (hp : PPos N0 N1 N2 N3 K f ρ R) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (I : List Sym) (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hl : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog (optB q) t
      (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (compL (lB px py)) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 26 + Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
  have hg : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Pos := hp.geo
  have hu : 1 ≤ f * K := Nat.mul_pos hp.f hp.k
  have hQ : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Q = 2 ^ (f * K) := rfl
  have hX : 0 ≤ Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by positivity
  have hfb : t.cl mFb = cls (some (.int (flB px py : ℕ))) := cl_of_agree hA rfl
  by_cases h1 : flB px py = 1
  · obtain ⟨c, Hc, hc⟩ := HSw 1 _ hg (f * K) hu hQ I t zs R0 hb h0 hl eP1 (.reg mN2) eS2 eFK _
      le_rfl (by decide) nk_P1 nk_N2 nk_S2 nk_FK (ESp.of_eq (sP1 hp hA) (by simp [svP, vol, NLogN.KFX.gB, geoB] <;> ring))
      (sN2 hp hA) (ESp.of_eq (sS2 hp hA) (by simp [svS, vol, NLogN.KFX.gB, geoB])) (sFK hp hA)
    refine ⟨c + 25, IRuns.iteT (by rw [hfb, h1]; decide) ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    exact Hc.mono' (by simp [lB, h1, compL]) le_rfl
  · have h0' : flB px py = 0 := by have := flB_le px py; omega
    refine ⟨1 + 25, ?_, by simp only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one]; linarith⟩
    refine IRuns.iteF (by rw [hfb, h0']; decide) ?_
    refine (IRuns.skip t).mono' ?_ le_rfl
    simp only [lB, h1, if_false, compL]
    rw [rixT_id hl, ← h0, IState.upd_self]

theorem cRotU_le (K f : ℕ) (b : ℤ) (P Q B w Bb : ℕ) :
    NLogN.KFX.cRotU K f b P Q B w Bb ≤ 400 * KFL.cRot K f b P Q B w Bb := by
  unfold NLogN.KFX.cRotU KFL.cRot; omega

theorem cXorU_le (P B w Bb : ℕ) : cXorU P B w Bb ≤ 400 * cXor P B w Bb := by
  unfold cXorU cXor; omega

theorem hbigV (hp : PPos N0 N1 N2 N3 K f ρ R) :
    4 * 2 ^ (f * K) < 2 ^ (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) := by
  have hg : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Pos := hp.geo
  have h1 : 2 ^ (f * K) ≤ (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V := by
    have : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Q = 2 ^ (f * K) := rfl
    rw [← this]; unfold Geo.V
    exact (Nat.le_mul_of_pos_right _ hg.n0).trans' (Nat.le_mul_of_pos_right _ hg.s0)
  have h2 : (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V < 2 ^ zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) := by
    have := natAbs_lt_zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ); simpa using this
  have h3 : 2 ^ (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3) =
      8 * 2 ^ zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) := by rw [pow_add]; ring
  omega

/-- One line, register-driven, on the master registers. -/
theorem rotLU_runs (hp : PPos N0 N1 N2 N3 K f ρ R) (I : List Sym) (l : Line) (hl : LineOK l)
    (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t) (zs : List ℤ)
    (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    IRuns I l12prog (rotLU l) t
      (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w)
        (rot2 (NLogN.KFX.gB N0 N1 N2 N3 K f R w).Q (amt K ρ f l)) zs) ++ R0))
      (NLogN.KFX.cRotU K f l.b (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2) (2 ^ (f * K))
        (N3 * (R * (2 * (w + 1)))) 1 (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)) :=
  rotU_geo (I := I) (iprog := l12prog) hp.k hp.ρ hp.f _ hp.geo rfl l hl.1 hl.2 (by omega)
    (hbigV hp) (by omega) 1 t zs R0 hlen (bnd_bits hb) h0 (by decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide)
    (sRP hp hA) (sQ hp hA) (sS2 hp hA) (sD0 hp hA) (sN2 hp hA)
    (ESp.of_eq (sR2 hp hA) (by push_cast; rfl)) (sFm1 hp hA)
    (ESp.of_eq (sK2 hp hA) (by push_cast; rfl))

theorem swBU_runs {q : ℕ} {Ksw : ℝ} (HSw : SwEOK q Ksw) (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog (swBU q) t
      (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) sw12 zs) ++ R0)) c ∧
      (c : ℝ) ≤ Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) *
        ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) :=
  HSw 1 _ hp.geo (f * K) (Nat.mul_pos hp.f hp.k) rfl I t zs R0 hb h0 hlen eP1 (.reg mN2) eS2 eFK _
    le_rfl (by decide) nk_P1 nk_N2 nk_S2 nk_FK
    (ESp.of_eq (sP1 hp hA) (by simp [svP, vol, NLogN.KFX.gB, geoB] <;> ring))
    (sN2 hp hA) (ESp.of_eq (sS2 hp hA) (by simp [svS, vol, NLogN.KFX.gB, geoB])) (sFK hp hA)

/-- **The lines, register-driven.** -/
theorem linesU_runs {q : ℕ} {Ksw : ℝ} (hKsw : 0 ≤ Ksw) (HSw : SwEOK q Ksw)
    (hp : PPos N0 N1 N2 N3 K f ρ R) (I : List Sym) :
    ∀ (ls : List Line), (∀ l ∈ ls, LineOK l) →
    ∀ (t : IState HS) (zs : List ℤ) (R0 : List Item),
    Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t →
    KFL.Bits zs → t.G 0 = ints zs ++ R0 → zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V →
    ∃ c : ℕ, IRuns I l12prog (linesU q ls) t
        (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w)
          (fun c => ls.foldr (fun l c => lineP K ρ f l c) c) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 1 + ls.length * (2 * Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) *
        ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) +
        400 * cRotG K f (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)) := by
  set g := NLogN.KFX.gB N0 N1 N2 N3 K f R w with hgdef
  have hg : g.Pos := hp.geo
  have hQe : g.Q = 2 ^ (f * K) := rfl
  set Bb := zsz (g.V : ℤ) + 3
  set τ := (1 - (2 : ℝ)⁻¹ ^ 50)
  set Cs := 2 * Ksw * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ
  have hCs : 0 ≤ Cs := by positivity
  intro ls
  induction ls with
  | nil =>
    intro _ t zs R0 hA hb h0 hlen
    refine ⟨1, ?_, by simp⟩
    simp only [linesU]
    refine (IRuns.skip t).mono' ?_ le_rfl
    rw [show (fun c => ([] : List Line).foldr (fun l c => lineP K ρ f l c) c) = id from rfl,
      rixT_id hlen, ← h0, IState.upd_self]
  | cons l ls ih =>
    intro hls t zs R0 hA hb h0 hlen
    have hl := hls l List.mem_cons_self
    have L1 : ∃ c1 : ℕ, IRuns I l12prog (lineU q l) t
        (t.upd 0 (ints (rixT g (lineP K ρ f l) zs) ++ R0)) c1 ∧
        (c1 : ℝ) ≤ Cs + 400 * cRotG K f g Bb := by
      have hcr : NLogN.KFX.cRotU K f l.b (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2) (2 ^ (f * K))
          (N3 * (R * (2 * (w + 1)))) 1 Bb ≤ 400 * cRotG K f g Bb :=
        le_trans (cRotU_le _ _ _ _ _ _ _ _) (Nat.mul_le_mul_left _ (cRot_le_G K f g Bb l.b hl.2))
      have hcrR : (NLogN.KFX.cRotU K f l.b (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2) (2 ^ (f * K))
          (N3 * (R * (2 * (w + 1)))) 1 Bb : ℝ) ≤ 400 * cRotG K f g Bb := by exact_mod_cast hcr
      by_cases hy : l.tgtY
      · obtain ⟨c2, H2, hc2⟩ := swBU_runs (q := q) HSw hp I t hA zs R0 hb h0 hlen
        set t1 := t.upd 0 (ints (rixT g sw12 zs) ++ R0)
        have hA1 : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t1 := agree_upd0 hA rfl _
        have hb1 : KFL.Bits (rixT g sw12 zs) := bits_rixT hb
        have R2 := rotLU_runs hp I l hl t1 hA1 (rixT g sw12 zs) R0 hb1 (by simp [t1])
          (length_rixT _ _ _)
        simp only [t1, IState.upd_upd_same] at R2
        have hb2 : KFL.Bits (rixT g (rot2 g.Q (amt K ρ f l)) (rixT g sw12 zs)) := bits_rixT hb1
        obtain ⟨c3, H3, hc3⟩ := swBU_runs (q := q) HSw hp I
          (t.upd 0 (ints (rixT g (rot2 g.Q (amt K ρ f l)) (rixT g sw12 zs)) ++ R0))
          (agree_upd0 hA rfl _) _ R0 hb2 (by simp) (length_rixT _ _ _)
        rw [IState.upd_upd_same] at H3
        refine ⟨c2 + (NLogN.KFX.cRotU K f l.b (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K) * N2) (2 ^ (f * K))
          (N3 * (R * (2 * (w + 1)))) 1 Bb + c3), ?_, ?_⟩
        · have E := H2.seq (R2.seq H3)
          simp only [lineU, hy, if_true]
          refine E.mono' ?_ le_rfl
          congr 3
          rw [rixT_rixT hg (TV_sw12) (TV_rot2 hg.q _), rixT_rixT hg (F := sw12 ∘ rot2 g.Q (amt K ρ f l))
            (fun c hc => TV_sw12 _ (TV_rot2 hg.q _ c hc)) TV_sw12]
          refine rixT_congr hg (fun c hc => ?_) _
          simp [lineP, hy, rot2, sw12, hQe, NLogN.KFX.gB, geoB]
        · simp only [Nat.cast_add]
          rw [← hgdef] at hc2 hc3
          have h2' : (c2 : ℝ) ≤ Ksw * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := hc2
          have h3' : (c3 : ℝ) ≤ Ksw * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := hc3
          simp only [Cs]; linarith
      · have R1 := rotLU_runs hp I l hl t hA zs R0 hb h0 hlen
        refine ⟨_, ?_, hcrR.trans (by linarith)⟩
        simp only [lineU, hy, if_false]
        refine R1.mono' ?_ le_rfl
        congr 3
        refine rixT_congr hg (fun c hc => ?_) _
        simp [lineP, hy, rot2, hQe, NLogN.KFX.gB, geoB]
    obtain ⟨c1, H1, hc1⟩ := L1
    have hb1 : KFL.Bits (rixT g (lineP K ρ f l) zs) := bits_rixT hb
    obtain ⟨c2, H2, hc2⟩ := ih (fun l' hl' => hls l' (List.mem_cons_of_mem _ hl'))
      (t.upd 0 (ints (rixT g (lineP K ρ f l) zs) ++ R0)) _ R0 (agree_upd0 hA rfl _) hb1 (by simp)
      (length_rixT _ _ _)
    rw [IState.upd_upd_same] at H2
    refine ⟨c1 + c2, ?_, ?_⟩
    · refine (H1.seq H2).mono' ?_ le_rfl
      congr 3
      rw [rixT_rixT hg (fun c hc => hQe ▸ TV_lineP l c (hQe ▸ hc))
        (fun c hc => hQe ▸ TV_foldr ls c (hQe ▸ hc))]
      rfl
    · push_cast
      simp only [List.length_cons, Nat.cast_add, Nat.cast_one] at hc2 ⊢
      nlinarith

theorem corrLU_runs {Kc : ℝ} (HC : CorrUOK Kc) (hK6 : 6 ≤ K) (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog corrLU t
        (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (corrc K ρ f) zs) ++ R0)) c ∧
      (c : ℝ) ≤ Kc * corrB K f (NLogN.KFX.gB N0 N1 N2 N3 K f R w) +
        10 ^ 10 * (((zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 : ℕ) : ℝ) + 2) ^ 2 :=
  HC K ρ f hK6 hp.ρ hp.f _ hp.geo rfl I l12prog t zs R0 hb h0 hlen _ _ _ _ _ _ _ _ _ _ _
    (by decide) (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide)
    (ESp.of_eq (sRS0 hp hA) (by simp only [Geo.S0, Geo.S1, Geo.S2, Geo.recG, NLogN.KFX.gB, geoB]))
    (ESp.of_eq (sQ hp hA) (by push_cast; rfl))
    (ESp.of_eq (sRS1 hp hA) (by simp only [Geo.S0, Geo.S1, Geo.S2, Geo.recG, NLogN.KFX.gB, geoB]))
    (ESp.of_eq (sN3 hp hA) (by simp only [Geo.S0, Geo.S1, Geo.S2, Geo.recG, NLogN.KFX.gB, geoB, mul_one]))
    (NLogN.KFX.sB hp hA) (ESp.of_eq (sR2 hp hA) (by push_cast; rfl)) (sFm1 hp hA)
    (ESp.of_eq (sK2 hp hA) (by push_cast; rfl))
    (ESp.of_eq (sRV hp hA) (by simp only [Geo.V, Geo.S0, Geo.S1, Geo.S2, Geo.recG, NLogN.KFX.gB, geoB]))
    (sA hp hA)

theorem xorLU_runs (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    IRuns I l12prog xorLU t
      (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (XLc K ρ f) zs) ++ R0))
      (cXorU (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
        (2 ^ (ρ + (f - 1) * K) * (NLogN.KFX.gB N0 N1 N2 N3 K f R w).S1) 1
        (zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3)) :=
  xorU_geo (I := I) (iprog := l12prog) hp.ρ hp.f _ hp.geo rfl (by omega) (by omega) 1 t zs R0 hlen
    (bnd_bits hb) h0 (by decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (by unfold NoLow; decide) (by unfold NoLow; decide) (by unfold NoLow; decide)
    (sXP hp hA) (sXB hp hA) (sXd hp hA) (sQ hp hA) (ESp.of_eq (sD hp hA) (by push_cast; rfl))

theorem coreBU_runs {q : ℕ} {Ksw Kc : ℝ} (hKsw : 0 ≤ Ksw) (hKc : 0 ≤ Kc) (HSw : SwEOK q Ksw)
    (HC : CorrUOK Kc) (hK6 : 6 ≤ K) (hp : PPos N0 N1 N2 N3 K f ρ R)
    (I : List Sym) (t : IState HS) (hA : Agree (σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List ℤ) (R0 : List Item) (hb : KFL.Bits zs) (h0 : t.G 0 = ints zs ++ R0)
    (hlen : zs.length = (NLogN.KFX.gB N0 N1 N2 N3 K f R w).V) :
    ∃ c : ℕ, IRuns I l12prog (coreBU q) t
        (t.upd 0 (ints (rixT (NLogN.KFX.gB N0 N1 N2 N3 K f R w) (RAc K ρ f) zs) ++ R0)) c ∧
      (c : ℝ) ≤ 400 * NLogN.KFL.coreCost Ksw Kc K ρ f (NLogN.KFX.gB N0 N1 N2 N3 K f R w) +
        10 ^ 10 * (((zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 : ℕ) : ℝ) + 2) ^ 2 := by
  set g := NLogN.KFX.gB N0 N1 N2 N3 K f R w with hgdef
  have hg : g.Pos := hp.geo
  obtain ⟨c3, S3, hc3⟩ := linesU_runs (q := q) hKsw HSw hp I lines lines_ok t zs R0 hA hb h0 hlen
  rw [← FSc_lines] at S3
  set z3 := rixT g (FSc K ρ f) zs
  obtain ⟨c4, S4, hc4⟩ := corrLU_runs HC hK6 hp I (t.upd 0 (ints z3 ++ R0)) (agree_upd0 hA rfl _)
    z3 R0 (bits_rixT hb) (by simp) (length_rixT _ _ _)
  set z4 := rixT g (corrc K ρ f) z3
  have S5 := xorLU_runs hp I ((t.upd 0 (ints z3 ++ R0)).upd 0 (ints z4 ++ R0))
    (agree_upd0 (agree_upd0 hA rfl _) rfl _) z4 R0 (bits_rixT (bits_rixT hb)) (by simp)
    (length_rixT _ _ _)
  refine ⟨c3 + (c4 + _), (S3.seq (S4.seq S5)).mono' ?_ le_rfl, ?_⟩
  · rw [IState.upd_upd_same, IState.upd_upd_same, pipeline_rixT hp.k hp.ρ hp.f g hg rfl zs]
  · have hl8 : (lines.length : ℝ) = 8 := by simp [lines]
    rw [hl8] at hc3
    have hx : (cXorU (N0 * 2 ^ (f * K) * N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
        (2 ^ (ρ + (f - 1) * K) * g.S1) 1 (zsz (g.V : ℤ) + 3) : ℝ) ≤
        400 * cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
          (2 ^ (ρ + (f - 1) * K) * g.S1) 1 (zsz (g.V : ℤ) + 3) := by exact_mod_cast cXorU_le _ _ _ _
    have hcB : 0 ≤ Kc * corrB K f g := mul_nonneg hKc (corrB_nonneg K f hp.f g)
    have hL : 0 ≤ 2 * Ksw * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by
      positivity
    have hR0 : (0 : ℝ) ≤ cRotG K f g (zsz (g.V : ℤ) + 3) := Nat.cast_nonneg _
    have hX0 : (0 : ℝ) ≤ cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
          (2 ^ (ρ + (f - 1) * K) * g.S1) 1 (zsz (g.V : ℤ) + 3) := Nat.cast_nonneg _
    have e : NLogN.KFL.coreCost Ksw Kc K ρ f g = (1 + 8 * (2 * Ksw * ((g.V : ℝ) + 1) *
        ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) + cRotG K f g (zsz (g.V : ℤ) + 3))) +
        Kc * corrB K f g + cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
          (2 ^ (ρ + (f - 1) * K) * g.S1) 1 (zsz (g.V : ℤ) + 3) := rfl
    rw [e]
    rw [← hgdef] at hc3 hc4 ⊢
    simp only [Nat.cast_add] at hc4 ⊢
    generalize (2 * Ksw * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) = Lx
      at hc3 hL ⊢
    generalize ((cRotG K f g (zsz (g.V : ℤ) + 3) : ℕ) : ℝ) = Rr at hc3 hR0 ⊢
    generalize ((cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1))
          (2 ^ (ρ + (f - 1) * K) * g.S1) 1 (zsz (g.V : ℤ) + 3) : ℕ) : ℝ) = Xr at hx hX0 ⊢
    generalize Kc * corrB K f g = Cr at hc4 hcB ⊢
    generalize (10 : ℝ) ^ 10 * ((zsz (g.V : ℤ) : ℝ) + ((3 : ℕ) : ℝ) + 2) ^ 2 = Tr at hc4 ⊢
    linarith

end Runs

end NLogN.KFX

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFX
open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly
variable {N0 N1 N2 N3 K f ρ R w : ℕ} {px py : Fin 3} {t : IState HS}
set_option maxHeartbeats 2000000
theorem solution {q : ℕ} {Ksw Kc : ℝ} (hKsw : 0 ≤ Ksw) (hKc : 0 ≤ Kc) (HSw : NLogN.KFX.SwEOK q Ksw)
    (HC : NLogN.KFX.CorrUOK Kc) (hne : px ≠ py) (hK6 : 6 ≤ K) (hp : NLogN.KFX.PPos N0 N1 N2 N3 K f ρ R)
    (I : List NLogN.Sym) (t : NLogN.IState NLogN.HS) (hA : NLogN.KFW.Agree (NLogN.KFX.σMR N0 N1 N2 N3 K f ρ R w px py) t)
    (zs : List NLogN.KFB.GI) (R0 : List NLogN.Item) (h0 : t.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0)
    (hl : zs.length = AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R) (hGB : NLogN.KFB.GB w zs) :
    ∃ c, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFX.l13U q) t
        (t.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFH.permRecs (NLogN.KFH.rect N0 N1 N2 N3 (f * K))
          (NLogN.KFH.rowAddAddr K ρ f px py) R zs)) ++ R0)) c ∧
      (c : ℝ) ≤ 2000 * (NLogN.KFL.cTo (2 * (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) +
        4 * (26 + Ksw * (((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℝ) + 1) *
          ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50)) +
        (400 * NLogN.KFL.coreCost Ksw Kc K ρ f (NLogN.KFX.gB N0 N1 N2 N3 K f R w) +
          10 ^ 10 * (((NLogN.zsz ((NLogN.KFX.gB N0 N1 N2 N3 K f R w).V : ℤ) + 3 : ℕ) : ℝ) + 2) ^ 2) +
        2000 * (NLogN.KFL.cFrom (2 * (AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) * R)) w : ℝ) := by
  set gm := NLogN.KFX.gB N0 N1 N2 N3 K f R w with hgm
  have hg : gm.Pos := hp.geo
  set M := AModel.vol (NLogN.KFH.rect N0 N1 N2 N3 (f * K))
  set P := NLogN.KFH.permRecs (NLogN.KFH.rect N0 N1 N2 N3 (f * K)) (NLogN.KFH.rowAddAddr K ρ f px py) R zs
  set xs := NLogN.KFB.gflat zs
  have hxs : ∀ x ∈ xs, NLogN.zsz x ≤ w := NLogN.KFL.zsz_gflat hGB
  have hxl : xs.length = 2 * (M * R) := by simp only [xs, NLogN.KFB.length_gflat, hl]
  -- 1. to bits
  obtain ⟨L1, hL1⟩ := hA NLogN.KFX.mNt _ rfl
  obtain ⟨L2, hL2⟩ := hA NLogN.KFX.mW _ rfl
  have S1 := NLogN.KFW.toBitsU_spec (I := I) (iprog := NLogN.KFL.l12prog) t xs w hxs R0 h0
    (L1 := L1) (L2 := L2) (by rw [hxl]; exact hL1) hL2
  rw [hxl] at S1
  set xb := NLogN.KFL.bitsL w xs
  have hxbl : xb.length = gm.V := by
    simp only [xb, NLogN.KFL.length_bitsL, hxl, hgm, NLogN.KFX.gB, NLogN.KFL.geoB_V]; ring
  have hxbb : NLogN.KFL.Bits xb := NLogN.KFL.bits_bitsL w xs
  set t1 := t.upd 0 (NLogN.ints xb ++ R0)
  have hA1 : NLogN.KFW.Agree (NLogN.KFX.σMR N0 N1 N2 N3 K f ρ R w px py) t1 := NLogN.KFX.agree_upd0 hA rfl _
  -- 2. swaps
  obtain ⟨c2, S2, hc2⟩ := NLogN.KFX.optA_runs (q := q) hKsw HSw hp hA1 I xb R0 hxbb (by simp [t1]) hxbl
  set za := NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFX.lA px)) xb
  obtain ⟨c2', S2', hc2'⟩ := NLogN.KFX.optB_runs (q := q) hKsw HSw hp (NLogN.KFX.agree_upd0 hA1 rfl (NLogN.ints za ++ R0)) I za R0
    (NLogN.KFL.bits_rixT hxbb) (by simp) (NLogN.KFL.length_rixT _ _ _)
  have TA : ∀ l : List (Fin 3), ∀ c, NLogN.KFL.TV gm.Q c → NLogN.KFL.TV gm.Q (NLogN.KFL.compL l c) := fun l c hc => NLogN.KFL.TV_compL _ c hc
  have ez2 : NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFX.lB px py)) za = NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py)) xb := by
    simp only [za]
    rw [NLogN.KFL.rixT_rixT hg (TA _) (TA _), NLogN.KFX.preL_eq px py hne, NLogN.KFX.compL_append]
  have S2'' : NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFX.optB q) (t1.upd 0 (NLogN.ints za ++ R0))
      (t1.upd 0 (NLogN.ints (NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py)) xb) ++ R0)) c2' :=
    S2'.mono' (by rw [NLogN.IState.upd_upd_same, ez2]) le_rfl
  set z2 := NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py)) xb
  set t2 := t1.upd 0 (NLogN.ints z2 ++ R0)
  -- 3. core
  obtain ⟨c3, S3, hc3⟩ := NLogN.KFX.coreBU_runs (q := q) hKsw hKc HSw HC hK6 hp I t2
    (NLogN.KFX.agree_upd0 hA1 rfl _) z2 R0 (NLogN.KFL.bits_rixT hxbb) (by simp [t2]) (NLogN.KFL.length_rixT _ _ _)
  set z3 := NLogN.KFL.rixT gm (NLogN.KFL.RAc K ρ f) z2
  set t3 := t2.upd 0 (NLogN.ints z3 ++ R0)
  -- 4. inverse swaps
  obtain ⟨c4, S4, hc4⟩ := NLogN.KFX.optB_runs (q := q) hKsw HSw hp (NLogN.KFX.agree_upd0 (NLogN.KFX.agree_upd0 hA1 rfl _) rfl (NLogN.ints z3 ++ R0))
    I z3 R0 (NLogN.KFL.bits_rixT (NLogN.KFL.bits_rixT hxbb)) (by simp [t3]) (NLogN.KFL.length_rixT _ _ _)
  set zb := NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFX.lB px py)) z3
  obtain ⟨c4', S4', hc4'⟩ := NLogN.KFX.optA_runs (q := q) hKsw HSw hp
    (NLogN.KFX.agree_upd0 (NLogN.KFX.agree_upd0 (NLogN.KFX.agree_upd0 hA1 rfl _) rfl _) rfl (NLogN.ints zb ++ R0)) I zb R0
    (NLogN.KFL.bits_rixT (NLogN.KFL.bits_rixT (NLogN.KFL.bits_rixT hxbb))) (by simp) (NLogN.KFL.length_rixT _ _ _)
  have ez4 : NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFX.lA px)) zb = NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py).reverse) z3 := by
    simp only [zb]
    rw [NLogN.KFL.rixT_rixT hg (TA _) (TA _), NLogN.KFX.preL_rev px py hne, NLogN.KFX.compL_append]
  have S4'' : NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFX.optA q) (t3.upd 0 (NLogN.ints zb ++ R0))
      (t3.upd 0 (NLogN.ints (NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py).reverse) z3) ++ R0)) c4' :=
    S4'.mono' (by rw [NLogN.IState.upd_upd_same, ez4]) le_rfl
  set z4 := NLogN.KFL.rixT gm (NLogN.KFL.compL (NLogN.KFL.preL px py).reverse) z3
  have hz4 : z4 = NLogN.KFL.bitsL w (NLogN.KFB.gflat P) := by
    have TR : ∀ c, NLogN.KFL.TV gm.Q c → NLogN.KFL.TV gm.Q (NLogN.KFL.RAc K ρ f c) := fun c hc => NLogN.KFL.TV_RAc' c hc
    simp only [z4, z3, z2]
    rw [NLogN.KFL.rixT_rixT hg (TA _) TR, NLogN.KFL.rixT_rixT hg (F := NLogN.KFL.compL (NLogN.KFL.preL px py) ∘ NLogN.KFL.RAc K ρ f)
      (fun c hc => TA _ _ (TR c hc)) (TA _),
      NLogN.KFL.bits_permRecs (w := w) hp.n0 hp.n1 hp.n2 hp.n3 hp.r px py zs hl]
    exact NLogN.KFL.rixT_congr hg (fun c _ => (NLogN.KFL.Fpp_conj K ρ f px py hne c).symm) _
  set t4 := t3.upd 0 (NLogN.ints z4 ++ R0)
  -- 5. from bits
  have hPl : P.length = M * R := by
    have e1 := congrArg List.length hz4
    rw [NLogN.KFL.length_rixT, NLogN.KFL.length_bitsL, NLogN.KFB.length_gflat] at e1
    have e2 : gm.V = M * R * (2 * (w + 1)) := NLogN.KFL.geoB_V
    rw [e2] at e1
    have : P.length * (2 * (w + 1)) = M * R * (2 * (w + 1)) := by
      rw [e1]; ring
    exact Nat.eq_of_mul_eq_mul_right (by positivity) this
  have hPx : ∀ x ∈ NLogN.KFB.gflat P, NLogN.zsz x ≤ w := NLogN.KFL.zsz_gflat (fun z hz => hGB z (NLogN.KFL.mem_permRecs hz))
  have hA4 : NLogN.KFW.Agree (NLogN.KFX.σMR N0 N1 N2 N3 K f ρ R w px py) t4 :=
    NLogN.KFX.agree_upd0 (NLogN.KFX.agree_upd0 (NLogN.KFX.agree_upd0 hA1 rfl _) rfl _) rfl _
  obtain ⟨L3, hL3⟩ := hA4 NLogN.KFX.mNt _ rfl
  obtain ⟨L4, hL4⟩ := hA4 NLogN.KFX.mW _ rfl
  have S5 := NLogN.KFW.fromBitsU_spec (I := I) (iprog := NLogN.KFL.l12prog) t4 (NLogN.KFB.gflat P) w hPx R0
    (by simp [t4, hz4]) (L1 := L3) (L2 := L4) (by rw [NLogN.KFB.length_gflat, hPl]; exact hL3) hL4
  rw [NLogN.KFB.length_gflat, hPl] at S5
  refine ⟨_, (S1.seq (S2.seq (S2''.seq (S3.seq (S4.seq (S4''.seq S5)))))).mono' ?_ le_rfl, ?_⟩
  · simp only [t4, t3, t2, t1, NLogN.IState.upd_upd_same]
  · rw [← hgm] at hc2 hc2' hc3 hc4 hc4'
    generalize ((f * K : ℕ) : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) = Lτ at hc2 hc2' hc4 hc4' ⊢
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat] at hc3 ⊢
    linarith
end
