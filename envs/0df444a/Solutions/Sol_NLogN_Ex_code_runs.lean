    (by
      intro k hk
      have hne := div_two_pow_ne_zero (n := y.natAbs) hk
      have : (ss k).G Y = .int (sg y (y.natAbs / 2 ^ k)) :: s.G Y := by
        simp [ss, schoolSt, hYQ, hYW]
      rw [cl_int _ _ _ _ this]; simp only [sg_eq_zero, hne, if_false]; split_ifs <;> simp)
    (by
      have : (ss m).G Y = .int (sg y (y.natAbs / 2 ^ m)) :: s.G Y := by
        simp [ss, schoolSt, hYQ, hYW]
      rw [cl_int _ _ _ _ this]; simp [m, zsz, zbits, div_two_pow_zsz, sg_zero])
    (by
      intro k hk
      have hne := div_two_pow_ne_zero (n := y.natAbs) hk
      have hb : sg y (y.natAbs / 2 ^ k) ≠ 0 := by rwa [Ne, sg_eq_zero]
