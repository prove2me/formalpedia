/-! ## The frozen family and its coefficient data -/

/-- The frozen magnetic potential: `a_ε = ε b₁`, i.e. the cubic response `c` set to `0`. -/
noncomputable def aFrozen (j : ℝ) (ε : ℝ) : ℝ → ℝ := fun R => ε * b1f j R

/-- `D3ᶻ = (m0 · z b₁')'` at `R`. -/
noncomputable def D3zf (j : ℝ) (R : ℝ) : ℝ :=
  deriv (fun s => m0 3 1 s * (zA j s * deriv (b1f j) s)) R

/-- The `ε³` Maxwell coefficient of the frozen family. -/
noncomputable def MA3z (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * (zA j R * D1f j R + D3zf j R)
    - f0 3 1 R * (uA j R * b1f j R)
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
        * ((uA j R + 2 * zA j R) * (j + 2 * (3 / 2) * b1f j R))

/-- The `ε⁵` Maxwell coefficient of the frozen family. -/
noncomputable def MA5z (j : ℝ) (R : ℝ) : ℝ :=
  m0 3 1 R * (zA j R * D3zf j R)
    - (2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
        * ((zA j R ^ 2 + 2 * uA j R * zA j R) * (j + 2 * (3 / 2) * b1f j R))

/-- The `ε⁷` Maxwell coefficient of the frozen family. -/
noncomputable def MA7z (j : ℝ) (R : ℝ) : ℝ :=
  -(2 * (3 / 2) * f0 3 1 R * (m0 3 1 R) ^ 2 / (N0 3 1 R) ^ 2)
    * (uA j R * zA j R ^ 2 * (j + 2 * (3 / 2) * b1f j R))

