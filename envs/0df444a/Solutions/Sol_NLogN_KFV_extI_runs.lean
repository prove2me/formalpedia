    have z2 : zsz ((2 : ℤ) ^ Δ) ≤ w + Δ + 1 := by have := NLogN.zsz_two_pow Δ; omega
    have s1 := Sp.push s G (i := O) (e := .quo (.add (.reg NLogN.KFV.vT) (.neg (.reg vT4))) (.lit (2 ^ Δ)))
      (B := w + Δ + 1) hO5 (clean_lt (by
