private theorem isGL3PsiWhittakerFn_transported
    {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    {ψ₀ ψ₁ : AddChar (v.adicCompletion ℚ) ℂ} (hψ : ∀ x, ψ₁ x = ψ₀ (algebraMap ℚ (v.adicCompletion ℚ) a * x))
    (hW : IsGL3PsiWhittakerFn ψ₀ W) : IsGL3PsiWhittakerFn ψ₁ (transported t W) := by
  intro x y z g
  rw [transported_apply, transported_apply, ← mul_assoc, localTorus_mul_upperUnipotent3 t v ht, mul_assoc, hW, hψ,
    mul_add]

private theorem transported_mul_of_mem
    {Uv : Subgroup (LocalGL3 v)} (hW : ∀ k ∈ Uv, ∀ g : LocalGL3 v, W (g * k) = W g) :
    ∀ k ∈ Uv, ∀ g : LocalGL3 v, transported t W (g * k) = transported t W g := by
  intro k hk g
  rw [transported_apply, transported_apply, ← mul_assoc, hW k hk]

private theorem isCongruenceEquivariantAt_transported {χ : (v.adicCompletion ℚ)ˣ →* ℂˣ} {m : ℕ}
    (hW : IsCongruenceEquivariantAt v m χ W) : IsCongruenceEquivariantAt v m χ (transported t W) := by
  intro k hk u hu g
  rw [transported_apply, transported_apply, ← mul_assoc, hW k hk u hu]

private theorem hasVanishingUnipotentIntegralAt_transported (hW : HasVanishingUnipotentIntegralAt v W) :
    HasVanishingUnipotentIntegralAt v (transported t W) := by
  intro g
  simpa only [transported_apply, mul_assoc] using hW (localTorus t v * g)

private theorem transported_glScalar_mul {ω : (v.adicCompletion ℚ)ˣ →* ℂˣ}
    (hW : ∀ (z : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v),
      W (Matrix.GeneralLinearGroup.scalar (Fin 3) z * g) = ((ω z : ℂˣ) : ℂ) * W g)
    (z : (v.adicCompletion ℚ)ˣ) (g : LocalGL3 v) :
    transported t W (Matrix.GeneralLinearGroup.scalar (Fin 3) z * g) = ((ω z : ℂˣ) : ℂ) * transported t W g := by
  rw [transported_apply, transported_apply, ← mul_assoc, ← ScalarComponents.glScalar_mul_comm, mul_assoc, hW]

private theorem transported_sizes {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hn : ‖algebraMap ℚ (v.adicCompletion ℚ) a‖ = 1) (h : LocalGL3 v) :
    detSize (localTorus t v * h) = detSize h ∧ lastRowSup (localTorus t v * h) = lastRowSup h ∧
      minorSup (localTorus t v * h) = minorSup h := by
  obtain ⟨h0, h1, h2⟩ := norm_localTorus_entries v hn
  exact ⟨detSize_mul_of_coe_eq_diagonal (coe_localTorus t v ht) h0 h1 h2 h,
    lastRowSup_mul_of_coe_eq_diagonal (coe_localTorus t v ht) h2 h,
    minorSup_mul_of_coe_eq_diagonal (coe_localTorus t v ht) h1 h2 h⟩

private theorem transported_bound {a : ℚ} (ht : (t : Matrix (Fin 3) (Fin 3) ℚ) = Matrix.diagonal ![a ^ 2, a, 1])
    (hn : ‖algebraMap ℚ (v.adicCompletion ℚ) a‖ = 1) {B : ℝ} {n : ℕ} {C : ℝ}
    (hW : ∀ h : LocalGL3 v,
      (¬ (detSize h * lastRowSup h / minorSup h ^ 2 ≤ B ∧ minorSup h / lastRowSup h ^ 2 ≤ B) → W h = 0) ∧
      (detSize h * lastRowSup h / minorSup h ^ 2 ≤ B ∧ minorSup h / lastRowSup h ^ 2 ≤ B →
        ‖W h‖ ≤ C / ((detSize h * lastRowSup h / minorSup h ^ 2) * (minorSup h / lastRowSup h ^ 2)) ^ n)) :
    ∀ h : LocalGL3 v,
      (¬ (detSize h * lastRowSup h / minorSup h ^ 2 ≤ B ∧ minorSup h / lastRowSup h ^ 2 ≤ B) →
        transported t W h = 0) ∧
      (detSize h * lastRowSup h / minorSup h ^ 2 ≤ B ∧ minorSup h / lastRowSup h ^ 2 ≤ B →
        ‖transported t W h‖ ≤
          C / ((detSize h * lastRowSup h / minorSup h ^ 2) * (minorSup h / lastRowSup h ^ 2)) ^ n) := by
  intro h
  obtain ⟨e0, e1, e2⟩ := transported_sizes t ht hn h
  have := hW (localTorus t v * h)
  rw [e0, e1, e2] at this
  exact this

