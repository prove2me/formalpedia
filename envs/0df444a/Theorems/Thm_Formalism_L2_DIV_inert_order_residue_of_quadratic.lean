      Ideal.map (algebraMap (𝓞 F) (𝓞 E)) v.asIdeal = P.asIdeal * P'.asIdeal →
      ∀ n : ℕ, InertOrd ξ v n ↔ orderOf (resChar ξ P) = n := by sorry
