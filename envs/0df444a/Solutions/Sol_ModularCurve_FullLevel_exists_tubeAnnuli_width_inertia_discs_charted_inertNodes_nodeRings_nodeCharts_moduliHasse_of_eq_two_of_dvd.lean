variable {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
  {Fbar₁ : Type*} [Field Fbar₁] [Algebra (ResidueField ↥A) Fbar₁]
  {Fbar₂ : Type*} [Field Fbar₂] [Algebra (ResidueField ↥A) Fbar₂]

theorem iota_resAut (R₁ : RegularProlongation A F Fbar₁) (R₂ : RegularProlongation A F Fbar₂)
    (hint : ∀ f : F, f ∈ R₁.integers ↔ f ∈ R₂.integers)
    (ι : Fbar₁ ≃ₐ[ResidueField ↥A] Fbar₂)
    (hι : ∀ (f : F) (h₁ : f ∈ R₁.integers), ι (R₁.residue ⟨f, h₁⟩) = R₂.residue ⟨f, (hint f).mp h₁⟩)
    (τ : F ≃ₐ[L] F) (hτ₁ : ∀ f : F, τ f ∈ R₁.integers ↔ f ∈ R₁.integers)
    (hτ₂ : ∀ f : F, τ f ∈ R₂.integers ↔ f ∈ R₂.integers) (y : Fbar₁) :
    ι (R₁.resAut τ hτ₁ y) = R₂.resAut τ hτ₂ (ι y) := by
  obtain ⟨f, rfl⟩ := R₁.residue_surjective y
  rw [R₁.resAut_residue, hι, hι, R₂.resAut_residue]

theorem iota_resAut_symm (R₁ : RegularProlongation A F Fbar₁) (R₂ : RegularProlongation A F Fbar₂)
    (hint : ∀ f : F, f ∈ R₁.integers ↔ f ∈ R₂.integers)
    (ι : Fbar₁ ≃ₐ[ResidueField ↥A] Fbar₂)
    (hι : ∀ (f : F) (h₁ : f ∈ R₁.integers), ι (R₁.residue ⟨f, h₁⟩) = R₂.residue ⟨f, (hint f).mp h₁⟩)
    (τ : F ≃ₐ[L] F) (hτ₁ : ∀ f : F, τ f ∈ R₁.integers ↔ f ∈ R₁.integers)
    (hτ₂ : ∀ f : F, τ f ∈ R₂.integers ↔ f ∈ R₂.integers) (y : Fbar₁) :
    ι ((R₁.resAut τ hτ₁).symm y) = (R₂.resAut τ hτ₂).symm (ι y) := by
  apply (R₂.resAut τ hτ₂).injective
  rw [AlgEquiv.apply_symm_apply, ← iota_resAut R₁ R₂ hint ι hι τ hτ₁ hτ₂, AlgEquiv.apply_symm_apply]

theorem corr_smul {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]
    (ι : F₁ ≃ₐ[K] F₂) (corr : Place K F₂ → Place K F₁)
    (hcorr : ∀ (Q : Place K F₂) (x : F₁), x ∈ (corr Q).toValuationSubring ↔ ι x ∈ Q.toValuationSubring)
    (σ₁ : F₁ ≃ₐ[K] F₁) (σ₂ : F₂ ≃ₐ[K] F₂) (hinter : ∀ y, ι (σ₁.symm y) = σ₂.symm (ι y))
    (Q : Place K F₂) : corr (σ₂ • Q) = σ₁ • corr Q := by
  apply Place.ext
  ext y
  rw [hcorr, Place.Transport.mem_smul_iff, Place.Transport.mem_smul_iff, hcorr, hinter]

theorem ord_iota {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]
    (ι : F₁ ≃ₐ[K] F₂) (Q₁ : Place K F₁) (Q₂ : Place K F₂)
    (hQ : ∀ x : F₁, x ∈ Q₁.toValuationSubring ↔ ι x ∈ Q₂.toValuationSubring) (y : F₁) :
    Q₂.ord (ι y) = Q₁.ord y := by
  classical
  let eO : ↥Q₁.toValuationSubring ≃+* ↥Q₂.toValuationSubring :=
    { toFun := fun x => ⟨ι x, (hQ x).mp x.2⟩
      invFun := fun y => ⟨ι.symm y, by
        have h := hQ (ι.symm (y : F₂))
        rw [AlgEquiv.apply_symm_apply] at h
        exact h.mpr y.2⟩
      left_inv := fun x => Subtype.ext (ι.symm_apply_apply (x : F₁))
      right_inv := fun y => Subtype.ext (ι.apply_symm_apply (y : F₂))
      map_mul' := fun x y => Subtype.ext (map_mul ι _ _)
      map_add' := fun x y => Subtype.ext (map_add ι _ _) }
  have heO : ∀ x : ↥Q₁.toValuationSubring, ((eO x : ↥Q₂.toValuationSubring) : F₂) = ι x := fun x => rfl
  rcases eq_or_ne y 0 with rfl | hy
  · simp
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible ↥Q₁.toValuationSubring
  obtain ⟨u, hu⟩ := Q₁.exists_unit_mul_zpow hy hπ
  set n := Q₁.ord y with hn
  have hπ' : Irreducible (eO π) := (MulEquiv.irreducible_iff eO).mpr hπ
  have hu' : IsUnit (eO (u : ↥Q₁.toValuationSubring)) := u.isUnit.map eO
  have hcoeu : ((hu'.unit : ↥Q₂.toValuationSubring) : F₂) = ι ((u : ↥Q₁.toValuationSubring) : F₁) := by
    rw [IsUnit.unit_spec]
    rfl
  have key : ι y = ((hu'.unit : ↥Q₂.toValuationSubring) : F₂)
      * (((eO π : ↥Q₂.toValuationSubring) : F₂) ^ n) := by
    rw [hcoeu, heO, hu, map_mul, map_zpow₀]
  rw [key, Q₂.ord_unit_smul_zpow hu'.unit hπ' n]

theorem ord_corr {K F₁ F₂ : Type*} [Field K] [Field F₁] [Field F₂] [Algebra K F₁] [Algebra K F₂]
    (ι : F₁ ≃ₐ[K] F₂) (corr : Place K F₂ → Place K F₁)
    (hcorr : ∀ (Q : Place K F₂) (x : F₁), x ∈ (corr Q).toValuationSubring ↔ ι x ∈ Q.toValuationSubring)
    (Q : Place K F₂) (y : F₁) : Q.ord (ι y) = (corr Q).ord y :=
  ord_iota ι (corr Q) Q (hcorr Q) y

theorem attach_transport (R₁ : RegularProlongation A F Fbar₁) (R₂ : RegularProlongation A F Fbar₂)
    (hint : ∀ f : F, f ∈ R₁.integers ↔ f ∈ R₂.integers)
    (ι : Fbar₁ ≃ₐ[ResidueField ↥A] Fbar₂)
    (hι : ∀ (f : F) (h₁ : f ∈ R₁.integers), ι (R₁.residue ⟨f, h₁⟩) = R₂.residue ⟨f, (hint f).mp h₁⟩)
    (x₁ : Place (ResidueField ↥A) Fbar₁) (x₂ : Place (ResidueField ↥A) Fbar₂)
    (hx : ∀ y : Fbar₁, y ∈ x₁.toValuationSubring ↔ ι y ∈ x₂.toValuationSubring)
    (An : Annulus A F)
    (h : ∃ hz : An.param ∈ R₂.integers, x₂.ord (R₂.residue ⟨An.param, hz⟩) = 1 ∧
      ∀ (f : F) (hf : f ∈ R₂.integers), R₂.residue ⟨f, hf⟩ ≠ 0 → (∀ P ∈ An.dom, P.ord f = 0) →
        ∀ P ∈ An.dom, ∃ h : P.evalAt f * (P.evalAt An.param) ^ (-(x₂.ord (R₂.residue ⟨f, hf⟩))) ∈ A, IsUnit (⟨_, h⟩ : ↥A)) :
    ∃ hz : An.param ∈ R₁.integers, x₁.ord (R₁.residue ⟨An.param, hz⟩) = 1 ∧
      ∀ (f : F) (hf : f ∈ R₁.integers), R₁.residue ⟨f, hf⟩ ≠ 0 → (∀ P ∈ An.dom, P.ord f = 0) →
        ∀ P ∈ An.dom, ∃ h : P.evalAt f * (P.evalAt An.param) ^ (-(x₁.ord (R₁.residue ⟨f, hf⟩))) ∈ A, IsUnit (⟨_, h⟩ : ↥A) := by
  obtain ⟨hz, hord1, hlaw⟩ := h
  have hordι : ∀ (f : F) (h₁ : f ∈ R₁.integers),
      x₁.ord (R₁.residue ⟨f, h₁⟩) = x₂.ord (R₂.residue ⟨f, (hint f).mp h₁⟩) := fun f h₁ => by
    rw [← hι f h₁, ord_iota ι x₁ x₂ hx]
  refine ⟨(hint _).mpr hz, ?_, ?_⟩
  · rw [hordι]; exact hord1
  · intro f hf hne hzf P hP
    have hne₂ : R₂.residue ⟨f, (hint f).mp hf⟩ ≠ 0 := by
      rw [← hι f hf]; exact fun h0 => hne (ι.injective (by rw [h0, map_zero]))
    rw [hordι]
    exact hlaw f ((hint f).mp hf) hne₂ hzf P hP

end RedIIPress

