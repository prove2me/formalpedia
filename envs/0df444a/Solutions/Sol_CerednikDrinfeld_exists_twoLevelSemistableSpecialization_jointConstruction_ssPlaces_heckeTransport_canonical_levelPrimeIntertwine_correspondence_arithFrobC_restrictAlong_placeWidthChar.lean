          fun ℓ => splice_transport A M q' hq' D₂ h₂ ℓ,
          ?c21, ?c22, ?c23, ?c24, ?c25, ?c26,

          fun i j => splice_self A (M * s) q' hq' D₁ h₁ e₁ i j,
          fun i j => splice_self A M q' hq' D₂ h₂ e₂ i j,
          ?c29, ?c30, ?c31, ?c32, ?c33⟩

  ·

    intro ℓ ℓ'
    by_cases hoff : ¬ (ℓ : ℕ) ∣ (M * s) * q' ∧ ¬ (ℓ' : ℕ) ∣ (M * s) * q'
    · haveI : SMulCommClass (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) HeckeAlg (JZero ((M * s) * q')) :=
        ModularCurve.smulCommClass_JZero_of_heckeOperatorsCommuteBar ((M * s) * q')
