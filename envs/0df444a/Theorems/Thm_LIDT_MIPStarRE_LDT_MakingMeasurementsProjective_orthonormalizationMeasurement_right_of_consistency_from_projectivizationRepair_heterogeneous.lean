lemma LIDT.MIPStarRE.LDT.MakingMeasurementsProjective.orthonormalizationMeasurement_right_of_consistency_from_projectivizationRepair_heterogeneous
    {Outcome : Type*}
    {ιA ιB : Type*}
    [Fintype ιA] [DecidableEq ιA] [Fintype ιB] [DecidableEq ιB]
    [Fintype Outcome]
    (ψ : _root_.LIDT.MIPStarRE.LDT.QuantumState (ιA × ιB))
    (hψ : ψ.IsNormalized)
    (A : _root_.LIDT.MIPStarRE.LDT.Measurement Outcome ιA) (B : _root_.LIDT.MIPStarRE.LDT.Measurement Outcome ιB) (ζ : _root_.LIDT.MIPStarRE.LDT.Error)
    (hζ : 0 ≤ ζ) :
    _root_.LIDT.MIPStarRE.LDT.ConsRel ψ (_root_.LIDT.MIPStarRE.LDT.uniformDistribution Unit)
      (_root_.LIDT.MIPStarRE.LDT.constSubMeasFamily A.toSubMeas)
      (_root_.LIDT.MIPStarRE.LDT.constSubMeasFamily B.toSubMeas) ζ →
      ∃ P : _root_.LIDT.MIPStarRE.LDT.ProjSubMeas Outcome ιB,
        _root_.LIDT.MIPStarRE.LDT.SDDRel ψ (_root_.LIDT.MIPStarRE.LDT.uniformDistribution Unit)
          (_root_.LIDT.MIPStarRE.LDT.constSubMeasFamily (_root_.LIDT.MIPStarRE.LDT.rightPlacedSubMeas (ιA := ιA) B.toSubMeas))
          (_root_.LIDT.MIPStarRE.LDT.constSubMeasFamily (_root_.LIDT.MIPStarRE.LDT.rightPlacedSubMeas (ιA := ιA) P.toSubMeas))
          (_root_.LIDT.MIPStarRE.LDT.MakingMeasurementsProjective.orthonormalizationError ζ) := by sorry
