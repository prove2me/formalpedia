open N25
variable {p : ℕ} [Fact p.Prime] (hp : p = 2 ∨ p = 3) (R : RedDatum25 p)
include hp

theorem N25.Endgame.specialUnit_zero_finrank25 :
    Module.finrank
      (IntermediateField.adjoin (κ R.A) ({U25C (κ R.A) 0} : Set (FSpecial R.A)))
      (FSpecial R.A) = 4 := by sorry
