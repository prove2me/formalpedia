-- ===== S4.Def_RP_EtPBC_A_CovGl1 =====
section

/-!
# S4-EtPBC-A, R4-T2 (G1c, part 2a): localization squares are pushouts

`isLoc_of_away`: an `IsAwayMap ψ t` with `ψ t` a unit is a localization away from `t`. `isLoc_tmap`: its base change
`R' ⊗ B → R' ⊗ C` is a localization away from `1 ⊗ t`. **`isPushout_loc`**: a map `ψ : E → E'` of algebras over
`R' ⊗ B` and `R' ⊗ C`, compatible on pure tensors and a localization away from `1 ⊗ t`, gives a pushout square.
-/

set_option autoImplicit false

open CategoryTheory Limits TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {A B C R' E E' : Type u} [CommRing A] [CommRing B] [CommRing C] [CommRing R'] [CommRing E]
  [CommRing E'] [Algebra A B] [Algebra A C] [Algebra A R'] [Algebra (R' ⊗[A] B) E] [Algebra (R' ⊗[A] C) E']

/-- **A localization square of chart algebras is a pushout.** -/
theorem isPushout_loc (φ : B →ₐ[A] C) (t : B) (hφ : IsAwayMap φ.toRingHom t) (ht : IsUnit (φ t))
    (ψ : E →+* E') (hψ : ∀ (r : R') (b : B), ψ (algebraMap (R' ⊗[A] B) E (r ⊗ₜ b)) =
      algebraMap (R' ⊗[A] C) E' (r ⊗ₜ φ b))
    (aw : IsAwayMap ψ (algebraMap (R' ⊗[A] B) E ((1 : R') ⊗ₜ t))) :
    IsPushout (CommRingCat.ofHom (algebraMap (R' ⊗[A] B) E))
      (CommRingCat.ofHom (Algebra.TensorProduct.map (AlgHom.id A R') φ).toRingHom)
      (CommRingCat.ofHom ψ) (CommRingCat.ofHom (algebraMap (R' ⊗[A] C) E')) := by
  letI : Algebra (R' ⊗[A] B) (R' ⊗[A] C) := (Algebra.TensorProduct.map (AlgHom.id A R') φ).toRingHom.toAlgebra
  letI : Algebra E E' := ψ.toAlgebra
  haveI : IsLocalization (Submonoid.powers ((1 : R') ⊗ₜ[A] t)) (R' ⊗[A] C) := isLoc_tmap φ t hφ ht
  have hsq : (algebraMap (R' ⊗[A] C) E').comp (Algebra.TensorProduct.map (AlgHom.id A R') φ).toRingHom =
      ψ.comp (algebraMap (R' ⊗[A] B) E) := by
    refine RingHom.ext fun z => z.induction_on (by rw [map_zero, map_zero]) (fun r b => ?_)
      (fun x y hx hy => by rw [map_add, map_add, hx, hy])
    show algebraMap (R' ⊗[A] C) E' (Algebra.TensorProduct.map (AlgHom.id A R') φ (r ⊗ₜ b)) =
      ψ (algebraMap (R' ⊗[A] B) E (r ⊗ₜ b))
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, hψ]
  haveI : IsLocalization ((Submonoid.powers ((1 : R') ⊗ₜ[A] t)).map (algebraMap (R' ⊗[A] B) E)) E' := by
    rw [Submonoid.map_powers]
    refine isLoc_of_away ψ _ aw ?_
    rw [hψ]
    exact (ht.map (Algebra.TensorProduct.includeRight : C →ₐ[A] R' ⊗[A] C)).map (algebraMap (R' ⊗[A] C) E')
  exact CommRingCat.isPushout_of_isLocalization (algebraMap (R' ⊗[A] B) E) (algebraMap (R' ⊗[A] C) E') hsq
    (Submonoid.powers ((1 : R') ⊗ₜ[A] t))

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_Delta =====
section

/-!
# S4-EtPBC-A, L1e: the δ-functor lemma for base change maps on germs

Abstract setting: an exact functor `L : C ⥤ D` of abelian categories, `C` with enough injectives, a cofiltered
system `A : J ⥤ C` (the free sheaves `Λ[g⁻¹ V]` of the etale neighbourhoods `V` of a geometric point), an object
`B : D` (the unit sheaf of the fibre) and compatible maps `u j : B ⟶ L (A j)`. The base change map at `j` is
`bc j : Ext^q(A j, F) → Ext^q(B, L F)`, `α ↦ u j ∘ L α`, and `res a` restricts classes along `a : j' ⟶ j`.

**`injAt_all`**: if base change is injective on germs in degree `0` for all `F` (`InjAt 0`) and surjective on germs
in every degree for all `F` (`SurjAt q`), then it is injective on germs in every degree. The proof embeds `F` into
an injective object and uses the long exact `Ext` sequences, `Ext^(q+1)(-, I) = 0` and the compatibility of
`Ext.mapExactFunctor` with composition and extension classes.
-/

set_option autoImplicit false

open CategoryTheory Limits Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.Delta

universe w v₁ u₁ v₂ u₂ v₃ u₃

variable {C : Type u₁} [Category.{v₁} C] [Abelian C] [HasExt.{w} C]
  {D : Type u₂} [Category.{v₂} D] [Abelian D] [HasExt.{w} D]
  {J : Type u₃} [Category.{v₃} J]
  (L : C ⥤ D) [L.Additive] [PreservesFiniteLimits L] [PreservesFiniteColimits L]
  (A : J ⥤ C) (B : D) (u : ∀ j, B ⟶ L.obj (A.obj j))

variable {L A B u}

variable (L A B u)

variable {L A B u}

theorem injAt_succ [EnoughInjectives C] [IsCofiltered J]
    (hu : ∀ {j j' : J} (a : j' ⟶ j), u j' ≫ L.map (A.map a) = u j) (q : ℕ)
    (hI : ∀ F, InjAt L A B u q F) (hS : ∀ F, SurjAt L A B u q F) (F : C) : InjAt L A B u (q + 1) F :=
  injAt_of_ses (S := ShortComplex.mk (Injective.ι F) (cokernel.π (Injective.ι F)) (cokernel.condition _))
    hu { exact := ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _) } q (hI _) (hS _)

/-- **The δ-functor lemma**: injectivity in degree `0` and surjectivity in all degrees give injectivity in all
degrees. -/
theorem injAt_all [EnoughInjectives C] [IsCofiltered J]
    (hu : ∀ {j j' : J} (a : j' ⟶ j), u j' ≫ L.map (A.map a) = u j)
    (h0 : ∀ F, InjAt L A B u 0 F) (hS : ∀ q F, SurjAt L A B u q F) : ∀ q F, InjAt L A B u q F
  | 0 => h0
  | q + 1 => injAt_succ hu q (injAt_all hu h0 hS q) (hS q)

end RamanujanPetersson.EtPBC.Delta

end

end

-- ===== S4.Def_RP_EtPBC_A_DescA =====
section

/-!
# S4-EtPBC-A, R4-T1a: descent of a torsor under a finite group along a flat cover (algebra)

`A → C` an algebra, `N` a finite abelian group, and a descent datum `D : Datum A C N`: complete orthogonal
idempotents `ε ν ∈ C ⊗ C` (the indicator functions of the values `ν` of a locally constant `N`-valued cocycle on
`Spec (C ⊗ C)`), trivial on the diagonal (`diag`) and satisfying the cocycle identity
`ε¹³_ν = ∑_α ε¹²_α ε²³_(ν - α)` in `C ⊗ C ⊗ C` (`cocycle`).

* `B D`: the `A`-subalgebra of `N → C` of the `f` with `f ν ⊗ 1 = ∑_m ε_m (1 ⊗ f (ν + m))` (functions on the
  trivial torsor `N × Spec C` that descend), `mem_B_iff` (`B = ker delta`).
* `delta'`, `key1`, `eq_sum_of_delta'`, `gOf`, `lmul'_gOf`, `delta'_gOf`, `cocycle'`: the base change of `delta`
  along `C` has kernel `N → C` (multiplication `m12` gives the retraction).
* **`theta_bijective`** (`C` flat over `A`): `C ⊗[A] B ≅ (N → C)`, `c ⊗ f ↦ c f`; `thetaEquiv`.
* With `C` faithfully flat: **`finite_B`**, **`etale_B`**, and `exists_prime_over` (`Spec B → Spec A` is onto).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.DescA

universe u

open TensorProduct

section Maps

end Maps

namespace Datum

variable {A C N : Type u} [CommRing A] [CommRing C] [Algebra A C] [AddCommGroup N] [Fintype N]
  [DecidableEq N] (D : Datum A C N)

/-- The descent condition as a linear map. -/
def delta : (N → C) →ₗ[A] (N → C ⊗[A] C) where
  toFun f ν := j1 A C (f ν) - ∑ m, D.ε m * j2 A C (f (ν + m))
  map_add' f g := by
    funext ν
    simp only [Pi.add_apply, map_add, mul_add, Finset.sum_add_distrib]
    abel
  map_smul' a f := by
    funext ν
    simp only [Pi.smul_apply, RingHom.id_apply, map_smul, mul_smul_comm, ← Finset.smul_sum, smul_sub]

theorem mem_B_iff (f : N → C) : f ∈ D.B ↔ D.delta f = 0 := by
  constructor
  · intro hf
    funext ν
    exact sub_eq_zero.mpr (hf ν)
  · intro hf ν
    exact sub_eq_zero.mp (congrFun hf ν)

/-- The base change of `delta` along `C`, written on `N → C ⊗ C`. -/
def delta' : (N → C ⊗[A] C) →ₗ[A] (N → C ⊗[A] (C ⊗[A] C)) where
  toFun g ν := e12 A C (g ν) - ∑ m, e23 A C (D.ε m) * e13 A C (g (ν + m))
  map_add' f g := by
    funext ν
    simp only [Pi.add_apply, map_add, mul_add, Finset.sum_add_distrib]
    abel
  map_smul' a f := by
    funext ν
    simp only [Pi.smul_apply, RingHom.id_apply, map_smul, mul_smul_comm, ← Finset.smul_sum, smul_sub]

theorem key1 (g : N → C ⊗[A] C) (hg : D.delta' g = 0) (ν : N) :
    j1 A C (Algebra.TensorProduct.lmul' A (g ν)) = ∑ m, D.ε m * g (ν + m) := by
  have h : e12 A C (g ν) = ∑ m, e23 A C (D.ε m) * e13 A C (g (ν + m)) :=
    sub_eq_zero.mp (congrFun hg ν)
  have h2 := congrArg (m12 A C) h
  rw [m12_e12, map_sum] at h2
  rw [h2]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [map_mul, m12_e23, m12_e13]

theorem eq_sum_of_delta' (g : N → C ⊗[A] C) (hg : D.delta' g = 0) (ν : N) :
    g ν = ∑ k, D.ε k * j1 A C (Algebra.TensorProduct.lmul' A (g (ν - k))) := by
  conv_lhs => rw [← one_mul (g ν), ← D.sum_eq, Finset.sum_mul]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [D.key1 g hg (ν - k), D.eps_mul_sum, sub_add_cancel]

theorem lmul'_gOf (h : N → C) (ν : N) : Algebra.TensorProduct.lmul' A (D.gOf h ν) = h ν := by
  simp only [gOf, map_sum, map_mul, lmul'_j1, D.diag, ite_mul, one_mul, zero_mul,
    Finset.sum_ite_eq', Finset.mem_univ, if_true, sub_zero]

section Tensor

/-- `c ⊗ f ↦ c f`. -/
def theta : C ⊗[A] D.B →ₐ[C] (N → C) :=
  Algebra.TensorProduct.lift (Algebra.ofId C (N → C)) D.B.val fun _ _ => Commute.all _ _

theorem theta_tmul (c : C) (f : D.B) (ν : N) : D.theta (c ⊗ₜ f) ν = c * (f : N → C) ν := by
  simp [theta, Algebra.TensorProduct.lift_tmul]

theorem theta_eq (x : C ⊗[A] D.B) (ν : N) :
    D.theta x ν = Algebra.TensorProduct.lmul' A
      (TensorProduct.piRightHom A A C (fun _ : N => C) (D.B.val.toLinearMap.lTensor C x) ν) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul c f =>
    rw [theta_tmul]
    simp [Algebra.TensorProduct.lmul'_apply_tmul]
  | add x y hx hy => simp only [map_add, Pi.add_apply, hx, hy]

theorem exact_val : Function.Exact D.B.val.toLinearMap D.delta := by
  intro y
  constructor
  · intro hy
    exact ⟨⟨y, (D.mem_B_iff y).mpr hy⟩, rfl⟩
  · rintro ⟨f, rfl⟩
    exact (D.mem_B_iff _).mp f.2

end Tensor

section FF

variable [Module.FaithfullyFlat A C]

theorem exists_prime_over (p : Ideal A) [p.IsPrime] :
    ∃ Q : Ideal D.B, Q.IsPrime ∧ Q.comap (algebraMap A D.B) = p := by
  obtain ⟨P, hP, hPp⟩ := Ideal.exists_isPrime_liesOver_of_faithfullyFlat (B := C) p
  refine ⟨P.comap D.ev0.toRingHom, Ideal.comap_isPrime _ _, ?_⟩
  rw [Ideal.comap_comap]
  have : D.ev0.toRingHom.comp (algebraMap A D.B) = algebraMap A C := by
    ext a
    simp
  rw [this]
  exact hPp.over.symm

end FF

end Datum

end RamanujanPetersson.EtPBC.DescA

end

end

-- ===== S4.Def_RP_EtPBC_A_DescB =====
section

/-!
# S4-EtPBC-A, R4-T1b (algebra part): descent data from locally constant functions, and localization

* `fib c hc ν`: for `c : PrimeSpectrum R → N` locally constant, the idempotent of the clopen `{c = ν}`
  (`fib_not_mem`: `fib c hc ν ∉ P ↔ c P = ν`); `idem_ext` (idempotents are determined by their primes),
  `fib_mul_ne`, `fib_sum`, `fib_map` (naturality along ring maps).
* **`mkDatum c hc hdiag hcoc : Datum A C N`** from a locally constant `c` on `Spec (C ⊗[A] C)` that vanishes on the
  diagonal and satisfies the cocycle identity pointwise.
* `mapB`: the map of descended algebras induced by compatible maps; `mapB_id`, `mapB_comp`, `mapB_algebraMap`.
* `psiMap ρA φC hφC : C ⊗[A] C →+* C' ⊗[A'] C'`; `psiMap_ker` (kernel is `r`-power torsion when `A'`, `C'` are the
  localizations away from `r`).
* **`isLocalizationAway_B`**: then `D'.B` is the localization of `D.B` away from `r` (input of `Coequifibered`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.DescA

universe u

open TensorProduct

section Idem

section Orth

end Orth

end Idem

section Mk

end Mk

section Map

variable {A C A' C' A'' C'' : Type u} [CommRing A] [CommRing C] [Algebra A C] [CommRing A'] [CommRing C']
  [Algebra A' C'] [CommRing A''] [CommRing C''] [Algebra A'' C''] {N : Type u} [AddCommGroup N] [Fintype N]
  [DecidableEq N]

/-- The map of descended algebras induced by compatible maps of covers. -/
def mapB (D : Datum A C N) (D' : Datum A' C' N) (φC : C →+* C') (ψ : C ⊗[A] C →+* C' ⊗[A'] C')
    (h1 : ∀ c, ψ (j1 A C c) = j1 A' C' (φC c)) (h2 : ∀ c, ψ (j2 A C c) = j2 A' C' (φC c))
    (hε : ∀ m, ψ (D.ε m) = D'.ε m) : D.B →+* D'.B where
  toFun f := ⟨fun ν => φC (f.1 ν), (mem_B D' _).mpr fun ν => by
    rw [← h1, (mem_B D _).mp f.2 ν, map_sum]
    simp only [map_mul, hε, h2]⟩
  map_one' := Subtype.ext (funext fun _ => map_one φC)
  map_mul' _ _ := Subtype.ext (funext fun _ => map_mul φC _ _)
  map_zero' := Subtype.ext (funext fun _ => map_zero φC)
  map_add' _ _ := Subtype.ext (funext fun _ => map_add φC _ _)

theorem mapB_apply (D : Datum A C N) (D' : Datum A' C' N) (φC : C →+* C') (ψ : C ⊗[A] C →+* C' ⊗[A'] C')
    (h1 h2 hε) (f : D.B) (ν : N) : (mapB D D' φC ψ h1 h2 hε f).1 ν = φC (f.1 ν) := rfl

/-- `mapB` along `psiMap`. -/
abbrev mapBL (D : Datum A C N) (D' : Datum A' C' N) (ρA : A →+* A') (φC : C →+* C')
    (hφC : ∀ a, φC (algebraMap A C a) = algebraMap A' C' (ρA a))
    (hε : ∀ m, psiMap ρA φC hφC (D.ε m) = D'.ε m) : D.B →+* D'.B :=
  mapB D D' φC (psiMap ρA φC hφC) (psiMap_j1 ρA φC hφC) (psiMap_j2 ρA φC hφC) hε

theorem mapB_algebraMap (D : Datum A C N) (D' : Datum A' C' N) (ρA : A →+* A') (φC : C →+* C')
    (hφC : ∀ a, φC (algebraMap A C a) = algebraMap A' C' (ρA a)) (ψ : C ⊗[A] C →+* C' ⊗[A'] C')
    (h1 h2 hε) (a : A) :
    mapB D D' φC ψ h1 h2 hε (algebraMap A D.B a) = algebraMap A' D'.B (ρA a) :=
  Subtype.ext (funext fun _ => hφC a)

end Map

end RamanujanPetersson.EtPBC.DescA

end

end

-- ===== S4.Def_RP_EtPBC_A_DescG3 =====
section

/-!
# S4-EtPBC-A, R4-T1c (part 2): the glued cover `U₀ ⟶ X` is finite, etale and surjective

* Generic (any coequifibered `α : 𝒪_X ⟶ F` on affine opens): `glD H` (the relative gluing data),
  `cover_toBase` (`Spec F(U) ⟶ U₀ ⟶ X` is `Spec α_U ≫ U.fromSpec`), `prop_toBase` (a Zariski-local property holds
  for `toBase` once it holds for every `Spec α_U`), `isFinite_toBase`, `etale_toBase`, `surjective_toBase`.
* For `V` etale and surjective over `X` with `V.hom` affine: `surj_comap`, the instance
  `Module.FaithfullyFlat Γ(X, U) (CU V U)`, and for the descended presheaf `FU`:
  **`U0`**, **`toU0`** `: U0 ⟶ X` with `IsFinite`, `Etale`, `Surjective`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.DescG

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC RamanujanPetersson.EtPBC.DescA TensorProduct

universe u

section Base

variable {X : Scheme.{u}} {F : X.AffineZariskiSiteᵒᵖ ⥤ CommRingCat.{u}}
  {α : (Scheme.AffineZariskiSite.toOpensFunctor X).op ⋙ X.presheaf ⟶ F} (H : α.Coequifibered)

set_option backward.isDefEq.respectTransparency false in
theorem isFinite_toBase (hP : ∀ U : X.AffineZariskiSite, (α.app (op U)).hom.Finite) :
    IsFinite (glD H).toBase :=
  prop_toBase H @IsFinite fun U => (IsFinite.SpecMap_iff _).2 (hP U)

set_option backward.isDefEq.respectTransparency false in
theorem etale_toBase (hP : ∀ U : X.AffineZariskiSite, (α.app (op U)).hom.Etale) :
    Etale (glD H).toBase :=
  prop_toBase H @Etale fun U => HasRingHomProperty.Spec_iff.2 (hP U)

theorem surjective_toBase
    (hP : ∀ U : X.AffineZariskiSite, Function.Surjective (PrimeSpectrum.comap (α.app (op U)).hom)) :
    Surjective (glD H).toBase :=
  prop_toBase H @Surjective fun U => ⟨hP U⟩

end Base

section Cover

end Cover

end RamanujanPetersson.EtPBC.DescG

end

end

-- ===== S4.Def_RP_EtPBC_A_LshEt =====
section

/-!
# S4-EtPBC-A, T3b: `e_!` preserves monomorphisms for every etale `e`

For an etale `e : U ⟶ X`, a geometric point `x` of `X` and a module `J`, the restriction
`res e (x_* J)` of the skyscraper sheaf is assembled from the skyscraper sheaves `l_* J` at the
lifts `l` of `x` along `e` (`pr`, `assemble`, `assemble_pr`, `hom_ext_pr`). Hence:
* `injective_res_sky`: `res e (x_* J)` is injective for `J` injective;
* `res e` preserves injective objects (every injective is a retract of its god sheaf);
* **`lsh e Λ = e_!` preserves monomorphisms** (Mathlib's
  `preservesMonomorphisms_of_adjunction_of_preservesInjectiveObjects`).
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false

open AlgebraicGeometry CategoryTheory Limits Opposite
open RamanujanPetersson.EtCompact

noncomputable section

namespace RamanujanPetersson.EtSheaves.LshEt

universe u

variable {U X : Scheme.{u}} (e : U ⟶ X) [Etale e] (x : GeomPt X)

variable {Λ : Type u} [CommRing Λ] (J : ModuleCat.{u} Λ)

/-- Assembling maps into the skyscraper sheaves at all lifts. -/
def assemble {G : EtSh Λ U} (h : ∀ l, G ⟶ (liftPt e x l).point.skyscraperSheaf J) :
    G ⟶ (res e Λ).obj (x.point.skyscraperSheaf J) :=
  ObjectProperty.homMk
    { app := fun W => rLift e x J fun b =>
        (h (liftOf e x b)).hom.app W ≫ sπ J (liftPt e x (liftOf e x b)).point W (dec e x b)
      naturality := fun W W' g => r_hom_ext e x J fun b => by
        simp only [Category.assoc, rLift_π, r_map_π]
        rw [← Category.assoc, NatTrans.naturality, Category.assoc, s_map_π]
        refine app_π_congr e x J h W _ _ (Subtype.ext ?_) _ _ rfl
        change fl x b ≫ W'.unop.hom = (fl x b ≫ g.unop.left) ≫ W.unop.hom
        rw [Category.assoc]
        exact congrArg (fl x b ≫ ·) (MorphismProperty.Over.w g.unop).symm }

theorem assemble_app_π {G : EtSh Λ U} (h : ∀ l, G ⟶ (liftPt e x l).point.skyscraperSheaf J)
    (W : (U.Etale)ᵒᵖ) (b : x.point.fiber.obj ((etComp e).obj W.unop)) :
    (assemble e x J h).hom.app W ≫ rπ e x J W b =
      (h (liftOf e x b)).hom.app W ≫ sπ J (liftPt e x (liftOf e x b)).point W (dec e x b) :=
  rLift_π _ _ _ _ _

theorem assemble_pr {G : EtSh Λ U} (h : ∀ l, G ⟶ (liftPt e x l).point.skyscraperSheaf J)
    (l : Lifts e x) : assemble e x J h ≫ pr e x J l = h l := by
  refine Sheaf.hom_ext (NatTrans.ext (funext fun W => s_hom_ext J _ fun c => ?_))
  change ((assemble e x J h).hom.app W ≫ (pr e x J l).hom.app W) ≫ _ = _
  rw [Category.assoc, pr_app_π, assemble_app_π]
  refine app_π_congr e x J h W _ _ (Subtype.ext ?_) _ _ rfl
  exact fl_w (liftPt e x l) c

end RamanujanPetersson.EtSheaves.LshEt

end

end

-- ===== S4.Def_RP_EtPBC_A_DescC =====
section

/-!
# S4-EtPBC-A, R4-T1d (algebra): sheets of the descended algebra

For a descent datum `D : Datum A C N`:
* `D.evB ν : D.B →+* C` (`f ↦ f ν`, the `ν`-th sheet);
* **`exists_sheet_prime`** [FaithfullyFlat]: every prime of `D.B` is pulled back from a prime of `C` along some sheet;
* `eps_j1`, **`key_sheet`** [Flat]: if a ring map `ψ : C ⊗[A] C → R` identifies the sheets `i` (through `j1`) and `j`
  (through `j2`) and `ψ (D.ε k) ≠ 0`, then `j = i + k`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.DescA.Datum

open TensorProduct

universe u

variable {A C N : Type u} [CommRing A] [CommRing C] [Algebra A C] [AddCommGroup N] [Fintype N]
  [DecidableEq N] (D : Datum A C N)

/-- The `ν`-th sheet `D.B → C`, `f ↦ f ν`. -/
def evB (ν : N) : D.B →+* C := (Pi.evalRingHom (fun _ : N => C) ν).comp D.B.val.toRingHom

theorem evB_apply (ν : N) (f : D.B) : D.evB ν f = f.1 ν := rfl

/-- The descent condition at a sheet, cut down by an idempotent. -/
theorem eps_j1 {R : Type u} [CommRing R] (ψ : C ⊗[A] C →+* R) (k ν : N) (f : D.B) :
    ψ (D.ε k) * ψ (j1 A C (f.1 ν)) = ψ (D.ε k) * ψ (j2 A C (f.1 (ν + k))) := by
  rw [← map_mul, ← map_mul, (mem_B D f.1).mp f.2 ν, D.eps_mul_sum]

end RamanujanPetersson.EtPBC.DescA.Datum

end

end

-- ===== S4.Def_RP_EtPBC_A_EAlg =====
section

/-!
# S4-EtPBC-A, M4(E), ALG: maps out of a finitely generated sheaf via relations between germs

Fix `e : ∐ Λ[W j] ↠ F` (`J` finite). The generators `gen W e j ∈ F(W j)` are the images of the tautological
sections `taut Λ (W j) ∈ Λ[W j](W j)`. For sections `f j ∈ H(W j)` and `x : P`, `rel W H f x` is the linear map
`(Σ j, fibre of W j at x̄) →₀ Λ → H_x̄`, `l ↦ Σ l(j, a) · germ_a (f j)`.

* `free_stalk_span`, `coprod_span`, **`free_range`**: the stalk of `∐ Λ[W j]` at `x̄` is spanned by the germs of the
  tautological sections (the range of `rel` for `tg W` is everything);
* **`exists_desc`**: if at every `x` the relations of the generators `gen W e` are relations of `f`, there is
  `φ : F ⟶ H` with `φ (gen W e j) = f j`;
* **`mono_stalk`**: if at `x` the relations of `φ (gen W e j)` are relations of `gen W e`, then `φ` is injective on
  the stalk at `x̄`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenAlg

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

variable {J : Type u} [Finite J] (W : J → P.Etale)

/-- **The stalk of `∐ Λ[W j]` is spanned by the germs of the tautological sections.** -/
theorem free_range (x : P) : LinearMap.range (rel (Λ := Λ) W _ (tg W) x) = ⊤ := by
  refine eq_top_iff.2 fun v _ => ?_
  have hv := coprod_span (fun j => freeSh Λ (W j)) x v
  rw [rel, Finsupp.range_linearCombination]
  refine (show (⨆ j, LinearMap.range (((geomPtAt x).stalkF Λ).map
    (Sigma.ι (fun j => freeSh Λ (W j)) j)).hom) ≤ _ from iSup_le fun j => ?_) hv
  rintro _ ⟨w, rfl⟩
  have hw := Submodule.mem_map_of_mem (f := (((geomPtAt x).stalkF Λ).map
    (Sigma.ι (fun j => freeSh Λ (W j)) j)).hom) (free_stalk_span (W j) x w)
  rw [Submodule.map_span] at hw
  refine Submodule.span_mono ?_ hw
  rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
  exact ⟨⟨j, a⟩, (germ_natural _ x a _).symm⟩

end RamanujanPetersson.EtPBC.GenAlg

end

end

-- ===== S4.Def_RP_EtPBC_A_O2MV =====
section

/-!
# S4-EtPBC-A, O2 (MV route), MV: the Mayer-Vietoris sequence of free sheaves

For a commutative square `p₁ ≫ w = p₂ ≫ v` of `P.Etale` (`W' ⟶ W, U ⟶ Z`):
* `freeMap_comp`; `stalk_freeMap_injective`/`_surjective` (fibre map injective/surjective ⇒ stalk map so);
* `mvC`: the short complex `Λ[W'] ⟶ Λ[W] ⊞ Λ[U] ⟶ Λ[Z]` (maps `(Λ[p₁], -Λ[p₂])`, `Λ[w] + Λ[v]`);
* **`mvC_shortExact`**: short exact when every fibre of `Z` is subsingleton and at every point either the fibre of
  `W` is a singleton and `p₂` is bijective on fibres, or the fibre of `U` is a singleton and `p₁` is so;
* **`mv_exists`**: a class `β ∈ Ext^{n+1}(Λ[Z], F)` killed by `Λ[w]` and `Λ[v]` is `ε.comp κ`, `κ ∈ Ext^n(Λ[W'], F)`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtPBC.GenAlg
  RamanujanPetersson.EtPBC.FreeStk

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

theorem stalk_freeMap_surjective {W' W : P.Etale} (w : W' ⟶ W) (x : P)
    (hw : Function.Surjective ((geomPtAt x).point.fiber.map w)) :
    Function.Surjective (((geomPtAt x).stalkF Λ).map (freeMap Λ w)).hom := by
  intro v
  obtain ⟨l, rfl⟩ := freeLin_surjective (Λ := Λ) W x v
  obtain ⟨l', rfl⟩ := Finsupp.mapDomain_surjective (M := Λ) hw l
  exact ⟨freeLin Λ W' x l', freeLin_natural w x l'⟩

section Stalks

variable {W' W U Z : P.Etale} (p₁ : W' ⟶ W) (p₂ : W' ⟶ U) (w : W ⟶ Z) (v : U ⟶ Z)

theorem mvC_g_surjective (x : P)
    (hx : Function.Surjective ((geomPtAt x).point.fiber.map w) ∨
      Function.Surjective ((geomPtAt x).point.fiber.map v)) :
    Function.Surjective (((geomPtAt x).stalkF Λ).map (biprod.desc (freeMap Λ w) (freeMap Λ v))).hom := by
  intro z
  rcases hx with h1 | h2
  · obtain ⟨y, rfl⟩ := stalk_freeMap_surjective (Λ := Λ) w x h1 z
    exact ⟨(((geomPtAt x).stalkF Λ).map biprod.inl).hom y, by rw [stalk_comp_apply, biprod.inl_desc]⟩
  · obtain ⟨y, rfl⟩ := stalk_freeMap_surjective (Λ := Λ) v x h2 z
    exact ⟨(((geomPtAt x).stalkF Λ).map biprod.inr).hom y, by rw [stalk_comp_apply, biprod.inr_desc]⟩

end Stalks

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2L1 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), L1: base change of Mayer-Vietoris classes

* `mvMapHom`, **`mv_naturality`**: a morphism of MV data gives a morphism of MV complexes, so
  `ε₁ ∘ Λ[a'] = Λ[c] ∘ ε₂` in `Ext¹`.
* `mvPullHom`: `mvC(f⁻¹ data) ⟶ f^* mvC(data)` (an isomorphism), `mvPull_shortExact`;
  **`mapExact_mv`**: `f^*` of `ε.comp κ` is `ε(f⁻¹ data).comp (f^* κ)`.
* `freeToUnit_bcUnit`, **`bc_mv`**: the base change of `ε.comp κ` at a neighbourhood `j` of `s` is
  `σ_j^*(ε(ι⁻¹ data).comp (ι^* κ))`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtPBC
  RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtPBC.FreeStk

universe u

section Nat

end Nat

section Pull

variable {Λ : Type u} [CommRing Λ] {X Y : Scheme.{u}} (f : X ⟶ Y)

variable {W' W U Z : Y.Etale} (p₁ : W' ⟶ W) (p₂ : W' ⟶ U) (w : W ⟶ Z) (v : U ⟶ Z) (hsq : p₁ ≫ w = p₂ ≫ v)

variable (Λ) in
/-- **The comparison of MV complexes** `mvC(f⁻¹ data) ⟶ f^* mvC(data)`. -/
def mvPullHom : mvC Λ ((etPull f).map p₁) ((etPull f).map p₂) ((etPull f).map w) ((etPull f).map v)
      (pull_sq f p₁ p₂ w v hsq) ⟶ (mvC Λ p₁ p₂ w v hsq).map (pull f Λ) where
  τ₁ := pullFreeHom Λ f W'
  τ₂ := pullMid Λ f W U
  τ₃ := pullFreeHom Λ f Z
  comm₁₂ := by
    show pullFreeHom Λ f W' ≫ (pull f Λ).map (biprod.lift (freeMap Λ p₁) (-freeMap Λ p₂)) =
      biprod.lift (freeMap Λ ((etPull f).map p₁)) (-freeMap Λ ((etPull f).map p₂)) ≫ pullMid Λ f W U
    rw [biprod.lift_eq, biprod.lift_eq]
    simp only [Preadditive.add_comp, Preadditive.neg_comp, Preadditive.comp_neg, Category.assoc, inl_pullMid,
      inr_pullMid, CategoryTheory.Functor.map_add, CategoryTheory.Functor.map_neg, CategoryTheory.Functor.map_comp,
      Preadditive.comp_add, reassoc_of% (pullFreeHom_natural (Λ := Λ) f p₁),
      reassoc_of% (pullFreeHom_natural (Λ := Λ) f p₂)]
  comm₂₃ := by
    show pullMid Λ f W U ≫ (pull f Λ).map (biprod.desc (freeMap Λ w) (freeMap Λ v)) =
      biprod.desc (freeMap Λ ((etPull f).map w)) (freeMap Λ ((etPull f).map v)) ≫ pullFreeHom Λ f Z
    apply biprod.hom_ext'
    · rw [reassoc_of% (inl_pullMid (Λ := Λ) f W U), ← CategoryTheory.Functor.map_comp, biprod.inl_desc,
        biprod.inl_desc_assoc]
      exact (pullFreeHom_natural f w).symm
    · rw [reassoc_of% (inr_pullMid (Λ := Λ) f W U), ← CategoryTheory.Functor.map_comp, biprod.inr_desc,
        biprod.inr_desc_assoc]
      exact (pullFreeHom_natural f v).symm

instance isIso_mvPullHom : IsIso (mvPullHom Λ f p₁ p₂ w v hsq) := by
  have : IsIso (mvPullHom Λ f p₁ p₂ w v hsq).τ₁ := isIso_pullFreeHom f W'
  have : IsIso (mvPullHom Λ f p₁ p₂ w v hsq).τ₂ := isIso_pullMid f W U
  have : IsIso (mvPullHom Λ f p₁ p₂ w v hsq).τ₃ := isIso_pullFreeHom f Z
  exact ShortComplex.isIso_of_isIso _

variable {p₁ p₂ w v hsq}

/-- The pulled-back MV complex is short exact. -/
theorem mvPull_shortExact (hS : (mvC Λ p₁ p₂ w v hsq).ShortExact) :
    (mvC Λ ((etPull f).map p₁) ((etPull f).map p₂) ((etPull f).map w) ((etPull f).map v)
      (pull_sq f p₁ p₂ w v hsq)).ShortExact :=
  ShortComplex.shortExact_of_iso (asIso (mvPullHom Λ f p₁ p₂ w v hsq)).symm (hS.map_of_exact (pull f Λ))

end Pull

section BC

end BC

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2M2 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), M2: local vanishing of cohomology classes

* `exists_local_lift`: a section of the target of an epimorphism lifts on an etale neighbourhood of any point of
  the geometric fibre;
* `vanish_one`, `vanish_succ`, **`local_vanish`**: every `β ∈ Ext^{q+1}(Λ[Z], F)` dies on an etale neighbourhood
  `a : N ⟶ Z` of any point `z` of the geometric fibre of `Z` over `x` (dimension shifting along the injective
  presentation `0 → F → I → I/F → 0`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtPBC
  RamanujanPetersson.EtPBC.GenAlg

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

variable (x : P) {Z : P.Etale} (z : (geomPtAt x).point.fiber.obj Z)

/-- Local vanishing in degree `1`. -/
theorem vanish_one (F : EtSh Λ P) (β : Ext.{u} (freeSh Λ Z) F 1) :
    ∃ (N : P.Etale) (a : N ⟶ Z) (n : (geomPtAt x).point.fiber.obj N), (geomPtAt x).point.fiber.map a n = z ∧
      (Ext.mk₀ (freeMap Λ a)).comp β (zero_add 1) = 0 := by
  obtain ⟨γ, rfl⟩ := Ext.covariant_sequence_exact₁ (X := freeSh Λ Z) (hS := injPres_shortExact F) β
    (Ext.eq_zero_of_injective _) (zero_add 1)
  obtain ⟨c, rfl⟩ := (Ext.mk₀_bijective _ _).2 γ
  have : Epi (injPres F).g := (injPres_shortExact F).epi_g
  obtain ⟨N, a, n, hn, i, hi⟩ := exists_local_lift (injPres F).g x z (freeEquiv Λ Z _ c)
  refine ⟨N, a, n, hn, ?_⟩
  have hc : freeMap Λ a ≫ c = (freeEquiv Λ N _).symm i ≫ (injPres F).g := by
    apply (freeEquiv Λ N _).injective
    refine (freeEquiv_freeMap Λ a _ c).trans ?_
    refine Eq.trans ?_ (freeEquiv_comp Λ N ((freeEquiv Λ N _).symm i) ((injPres F).g)).symm
    rw [AddEquiv.apply_symm_apply]
    exact hi.symm
  calc (Ext.mk₀ (freeMap Λ a)).comp ((Ext.mk₀ c).comp (injPres_shortExact F).extClass (zero_add 1)) (zero_add 1)
      = (Ext.mk₀ (freeMap Λ a ≫ c)).comp (injPres_shortExact F).extClass (zero_add 1) :=
        Ext.mk₀_comp_mk₀_assoc _ _ _
    _ = (Ext.mk₀ ((freeEquiv Λ N _).symm i ≫ (injPres F).g)).comp
          (injPres_shortExact F).extClass (zero_add 1) := by rw [hc]
    _ = (Ext.mk₀ ((freeEquiv Λ N _).symm i)).comp ((Ext.mk₀ ((injPres F).g)).comp
          (injPres_shortExact F).extClass (zero_add 1)) (zero_add 1) := (Ext.mk₀_comp_mk₀_assoc _ _ _).symm
    _ = (Ext.mk₀ ((freeEquiv Λ N _).symm i)).comp (0 : Ext.{u} (injPres F).X₂ F 1) (zero_add 1) :=
        congrArg (fun t => (Ext.mk₀ ((freeEquiv Λ N _).symm i)).comp t (zero_add 1))
          (injPres_shortExact F).comp_extClass
    _ = 0 := Ext.comp_zero _ _ _ _ _

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2Fl2 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), Fl2: restriction along `extFree`

* `extAdjMap_mk₀_comp`: the adjunction map on `Ext` is natural in the source;
* `lshFreeHom_natural`, `lshFreeInv_natural`: `Λ[e ∘ V] ≅ e_! Λ[V]` is natural in `V`;
* `toW W V : e ∘ V ⟶ W` (`e = W.hom`, `V : W.left.Etale`), `extFreeV : Ext_P(Λ[e ∘ V], F) ≃ Ext_W(Λ[V], F|_W)`;
* **`extFreeV_restrict`**: restricting `β ∈ Ext_P(Λ[W], F)` along `toW W V` is restricting `extFree β ∈ H(W, F|_W)`
  to `V`; **`restrict_eq_zero`**: if `extFree β` dies on `V`, then `β` dies on `e ∘ V`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtPBC
  RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtPBC.FreeStk

universe w v v' u₁ u₂ u

section Adj

end Adj

variable {Λ : Type u} [CommRing Λ]

section Nat

variable {U X : Scheme.{u}} (e : U ⟶ X) [Etale e]

/-- **Naturality** of `Λ[e ∘ V] ⟶ e_! Λ[V]` in `V`. -/
theorem lshFreeHom_natural {V' V : U.Etale} (c : V' ⟶ V) :
    freeMap Λ ((etComp e).map c) ≫ lshFreeHom Λ e V = lshFreeHom Λ e V' ≫ (lsh e Λ).map (freeMap Λ c) := by
  apply (freeEquiv Λ ((etComp e).obj V') ((lsh e Λ).obj (freeSh Λ V))).injective
  rw [freeEquiv_freeMap, freeEquiv_comp, lshFreeHom, lshFreeHom, AddEquiv.apply_symm_apply,
    AddEquiv.apply_symm_apply]
  have hn : (((lshAdj e Λ).unit.app (freeSh Λ V)).hom.app (op V')).hom
        (((freeMap Λ c).hom.app (op V')).hom (taut Λ V')) =
      (((lsh e Λ).map (freeMap Λ c)).hom.app (op ((etComp e).obj V'))).hom (lshTaut Λ e V') :=
    congrArg (fun φ => (φ.hom.app (op V')).hom (taut Λ V')) ((lshAdj e Λ).unit.naturality (freeMap Λ c))
  rw [freeMap_taut] at hn
  have hu := NatTrans.naturality_apply (φ := ((lshAdj e Λ).unit.app (freeSh Λ V)).hom) c.op (taut Λ V)
  exact hu.symm.trans hn

/-- **Naturality** of `e_! Λ[V] ⟶ Λ[e ∘ V]` in `V`. -/
theorem lshFreeInv_natural {V' V : U.Etale} (c : V' ⟶ V) :
    lshFreeInv Λ e V' ≫ freeMap Λ ((etComp e).map c) = (lsh e Λ).map (freeMap Λ c) ≫ lshFreeInv Λ e V := by
  rw [← lshFreeIso_inv, ← lshFreeIso_inv, Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv, lshFreeIso_hom,
    lshFreeIso_hom]
  exact lshFreeHom_natural e c

end Nat

section Obj

end Obj

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2R1 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), M6a (1): the free sheaf on a coproduct is a biproduct; fibres of a coproduct

For a family `S : ι → P.Etale` with coproduct `cop S` (`Cech.cop`):
* `freeCop_hom_ext`: maps out of `Λ[cop S]` agree if they agree on every `Λ[S k]`;
* `copPr Λ S z : Λ[cop S] ⟶ Λ[S z]` with `copι_copPr_self`, `copι_copPr_ne`, **`sum_copPr`**
  (`Σ z, copPr z ≫ Λ[copι z] = 𝟙`);
* fibres: `fib_cop_surj` (every fibre point of `cop S` comes from some `S k`), `fib_cop_idx` (from one `k` only),
  `fib_cop_inj` (`copι k` is injective on fibres).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}} {ι : Type u} (S : ι → P.Etale)

section Fib

end Fib

variable [DecidableEq ι]

/-- **`Λ[cop S]` is the biproduct of the `Λ[S z]`.** -/
theorem sum_copPr [Fintype ι] : ∑ z, copPr Λ S z ≫ freeMap Λ (copι S z) = 𝟙 _ := by
  refine freeCop_hom_ext S (fun k => ?_)
  rw [Preadditive.comp_sum, Category.comp_id, Finset.sum_eq_single k]
  · rw [← Category.assoc, copι_copPr_self, Category.id_comp]
  · intro z _ hz
    rw [← Category.assoc, copι_copPr_ne S (Ne.symm hz), Limits.zero_comp]
  · intro hk
    exact absurd (Finset.mem_univ k) hk

end RamanujanPetersson.EtPBC.EtMV

