      rw [← map_mul, FiniteWhittaker.t0388, Units.mul_inv, map_one]
    refine le_antisymm h₁ ?_
    calc
      (1 : _) = _ := hab.symm
      _ ≤ Valued.v ((unitAt v.1 z : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K) * 1 :=
        mul_le_mul' le_rfl h₂
