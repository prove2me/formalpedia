theorem blen_call_runs {I : List Sym} {iprog : Fin 5 → IStmt HS 5} (hP : iprog 4 = blenProc)
    (t : IState HS) (x : ℕ) (LX : List Item) (hX : t.G NLogN.Top.BX = .int x :: LX) :
    IRuns I iprog (.call 4) t (t.upd NLogN.Top.BC (.int (zsz (x : ℤ)) :: t.G NLogN.Top.BC)) (blenCost x) := by
  have h := blenS_runs' (I := I) (iprog := fun _ : Fin 1 => (blenS T1 ZZ : IStmt NS 1))
    (X := T1) (C := ZZ) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (IState.pull ssH t) x LX (by simpa using hX)
  have h' := IRuns.ren ssH_injective (iprog' := iprog) (g := fun _ => (4 : Fin 5))
    (fun _ => by rw [hP]; rfl) h t
  rw [IState.embed_upd ssH_injective, IState.embed_pull ssH_injective] at h'
  have h'' : IRuns I iprog (iprog 4) t (t.upd NLogN.Top.BC (.int (zsz (x : ℤ)) :: t.G NLogN.Top.BC))
      (2000 * (zsz (x : ℤ) + 1) * (zsz (zsz (x : ℤ) : ℤ) + 2)) := by
    rw [hP]; simpa [IState.pull_G, blenProc] using h'
  exact IRuns.call h''

theorem blenRM_prcOK {I : List Sym} {iprog : Fin 5 → IStmt HS 5} (hP : iprog 4 = blenProc)
    (pc : ℕ → Fin 5) (hpc : pc 4 = 4) : RM.PrcOK I iprog pc blenRM := by
  intro s ⟨x, LX, hX⟩
  rw [hpc]
  have e : s.top NLogN.Top.BX = (x : ℤ) := by simp [IState.top, hX]
  simpa [e] using blen_call_runs hP s x LX hX

end NLogN.Top

