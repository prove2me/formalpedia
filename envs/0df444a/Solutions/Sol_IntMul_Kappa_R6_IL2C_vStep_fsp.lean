section
-- Source module: Solutions.R6IL2CLoop
/-!
# Round six, compact controls (I2C): segment loops with three radices

`segLoopR T` (`n` iterations, `n` on register `pN`):
`rA += rW · T(rU, rV); rU /= ru; rV /= rv; rW *= rw` with the radices `ru, rv, rw` on the
registers `pRu, pRv, pRw` (left untouched).  After the loop `rA = a + segSum tf ru rv rw w u v n`
(`segLoopR_fsp`).  `segStepR`: push `u, v, w, a`, loop, assign a function of the accumulator to a
target, pop (`segStepR_fsp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## Parameter registers -/

theorem ESp.ofG' {t : IState HS} {x : Fin HS} {v : ℤ} {L : List Item} {Bb : ℕ}
    (h : t.G x = .int v :: L) (hx : x.val < 56) (hb : zsz v ≤ Bb) : ESp (.reg x) t Bb v :=
  ⟨KFL.clean_all _ (by simp [Ex.regs, hx]), IState.isInt_of h,
    by show zsz (t.top x) ≤ Bb; rw [IState.top_eq h]; exact hb, IState.top_eq h⟩

/-- A register read through a managed state whose managed part does not touch it. -/
theorem encK_G_eq {s : IState HS} {F F' : Fin HS → List ℤ} {r : Fin HS} (h : F' r = F r) :
    (encK s F').G r = (encK s F).G r := by simp [h]

/-! ## The loop -/

theorem geom_le {r : ℤ} (hr : 2 ≤ r) (k : ℕ) : ∑ i ∈ Finset.range k, r ^ i ≤ r ^ k - 1 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ, pow_succ]
    have : 0 ≤ r ^ k := by positivity
    nlinarith

theorem segSum_abs {tf : ℤ → ℤ → ℤ} {Tm : ℤ} (htf : ∀ a b, |tf a b| ≤ Tm) {ru rv rw w : ℤ}
    (hrw : 2 ≤ rw) (hw : 0 ≤ w) (u v : ℤ) (k : ℕ) :
    |segSum tf ru rv rw w u v k| ≤ Tm * w * (rw ^ k - 1) := by
  unfold segSum
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
  have h1 : ∀ i ∈ Finset.range k, |w * rw ^ i * tf (u / ru ^ i) (v / rv ^ i)| ≤ Tm * w * rw ^ i := by
    intro i _
    rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ w * rw ^ i)]
    have := htf (u / ru ^ i) (v / rv ^ i)
    have hp : (0 : ℤ) ≤ w * rw ^ i := by positivity
    nlinarith
  refine le_trans (Finset.sum_le_sum h1) ?_
  rw [← Finset.mul_sum]
  have := geom_le hrw k
  have hT : 0 ≤ Tm := le_trans (abs_nonneg _) (htf 0 0)
  have h2 : 0 ≤ Tm * w := by positivity
  nlinarith

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CKey
/-!
# Round six, compact controls (I2C): the key program of the correction

`keyProgC` computes, for the record index `m` on register `rm`, the key
`κ m = l.stepP (fun x c => TlS x (Psi x c)) m` (the pull composite of the program followed by the
ideal map) and pushes it on `rK` (`keyProgC_fsp`).  The layout parameters are read from the
registers `24 … 35` and `13` (`QL`); the values `x, t, u, y` live on `4, 5, 9, 12`.
Each of the eleven value updates is one segment loop (`vStep`, `vStep_fsp`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## The segment step with register radices -/

/-! ## One value update -/

set_option maxHeartbeats 4000000 in
theorem vStep_fsp_sol_aux {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ}
    (hT : SegTR T tf Bb Tm Rv) (s : IState HS) (G : Fin HS → List ℤ) (hGc : G rC = [])
    {tgt q : Fin HS} (ht56 : tgt.val < 56) (htA : tgt ≠ rA) (htU : tgt ≠ rU) (htV : tgt ≠ rV)
    (htW : tgt ≠ rW) (htC : tgt ≠ rC) (ht6 : tgt ≠ pRu) (ht7 : tgt ≠ pRv) (ht8 : tgt ≠ pRw)
    (hq56 : q.val < 56) (hqA : q ≠ rA) (hqU : q ≠ rU) (hqV : q ≠ rV) (hqW : q ≠ rW)
    (hq6 : q ≠ pRu) (hq7 : q ≠ pRv) (hq8 : q ≠ pRw)
    {v Q : ℕ} {lt : List ℤ} (hGt : G tgt = (v : ℤ) :: lt) (hvQ : v < Q)
    {LQ : List Item} (hGq : (encK s G).G q = .int (Q : ℤ) :: LQ)
    {n : ℕ} {LR LN : List Item}
    (hRR : (encK s G).G pR = .int Rv :: LR) (hNn : (encK s G).G pN = .int (n : ℤ) :: LN)
    {eru erv erw eu ev ew : Ex HS} {ru rv rw u v' w : ℤ}
    (Eru : ESp eru (encK s G) Bb ru) (Erv : ESp erv (encK s G) Bb rv)
    (Erw : ESp erw (encK s G) Bb rw)
    (n1 : NoRad erv) (n2 : NoRad erw) (n3 : NoRad eu) (n4 : NoRad ev) (n5 : NoRad ew)
    (s2 : NoSeg ev) (s3 : NoSeg ew)
    (hsz : eru.size + erv.size + erw.size + eu.size + ev.size + ew.size ≤ 60)
    (Eu : ESp eu (encK s G) Bb u) (Ev : ESp ev (encK s G) Bb v') (Ew : ESp ew (encK s G) Bb w)
    (hru : 0 < ru) (hrv : 0 < rv) (hrw : 2 ≤ rw) (hnb : zsz (n : ℤ) ≤ Bb)
    (hu : 0 ≤ u) (hv : 0 ≤ v') (hw : 0 < w) (hTm : 1 ≤ Tm)
    (hTQ : Tm * w * rw ^ n ≤ (Q : ℤ) * Q) (h3 : 3 * ((Q : ℤ) * Q) < 2 ^ Bb)
    {c : ℤ} (hc : c = 1 ∨ c = -1) :
    FSp (vStep eru erv erw eu ev ew T tgt c q) (encK s G)
      (encK s (Function.update G tgt
        ((subM Q v (-(c * segSum tf ru rv rw w u v' n)) : ℤ) :: lt))) (cV T Bb n) := by
  have hQ0 : 0 < Q := by omega
  have hQ0' : (0 : ℤ) < Q := by exact_mod_cast hQ0
  have hQQ : (Q : ℤ) ≤ (Q : ℤ) * Q := by nlinarith
  have zl : ∀ x : ℤ, |x| ≤ 3 * ((Q : ℤ) * Q) → zsz x ≤ Bb := fun x hx => zsz_of_le h3 hx
  have hB1 : 1 ≤ Bb := by
    by_contra hc'
    have : Bb = 0 := by omega
    subst this
    have : (1 : ℤ) ≤ (Q : ℤ) * Q := by nlinarith
    norm_num at h3; linarith
  -- push the radices
  have S1 := Sp.pushQ s G (i := pRu) (by decide) Eru.clean Eru.ok Eru.bnd
  rw [Eru.ev] at S1
  set G1 := Function.update G pRu (ru :: G pRu) with hG1
  have Erv1 : ESp erv (encK s G1) Bb rv := Erv.congr (fun i hi => by
    simp only [encK_G, G1]; rw [upd_ne (n1 i hi).1])
  have S2 := Sp.pushQ s G1 (i := pRv) (by decide) Erv1.clean Erv1.ok Erv1.bnd
  rw [Erv1.ev] at S2
  set G2 := Function.update G1 pRv (rv :: G1 pRv) with hG2
  have Erw2 : ESp erw (encK s G2) Bb rw := Erw.congr (fun i hi => by
    simp only [encK_G, G2, G1]; rw [upd_ne (n2 i hi).2.1, upd_ne (n2 i hi).1])
  have S3 := Sp.pushQ s G2 (i := pRw) (by decide) Erw2.clean Erw2.ok Erw2.bnd
  rw [Erw2.ev] at S3
  set G3 := Function.update G2 pRw (rw :: G2 pRw) with hG3
  have g3o : ∀ j, j ≠ pRu → j ≠ pRv → j ≠ pRw → G3 j = G j := by
    intro j h1 h2 h3'
    simp only [G3, G2, G1]; rw [upd_ne h3', upd_ne h2, upd_ne h1]
  have e3 : ∀ j, j ≠ pRu → j ≠ pRv → j ≠ pRw → (encK s G3).G j = (encK s G).G j :=
    fun j h1 h2 h3' => encK_G_eq (g3o j h1 h2 h3')
  have tr3 : ∀ {e : Ex HS} {x : ℤ}, NoRad e → ESp e (encK s G) Bb x → ESp e (encK s G3) Bb x :=
    fun hn hE => hE.congr (fun i hi => (e3 i (hn i hi).1 (hn i hi).2.1 (hn i hi).2.2).symm)
  have g3u : G3 pRu = ru :: G pRu := by
    simp only [G3, G2]; rw [upd_ne (by decide), upd_ne (by decide)]; simp only [G1]
    rw [Function.update_self]
  have g3v : G3 pRv = rv :: G pRv := by
    simp only [G3]; rw [upd_ne (by decide)]; simp only [G2]; rw [Function.update_self]
    simp only [G1]; rw [upd_ne (by decide)]
  have g3w : G3 pRw = rw :: G pRw := by
    simp only [G3]; rw [Function.update_self]; simp only [G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide)]
  have zof : ∀ {e : Ex HS} {t : IState HS} {x : ℤ}, ESp e t Bb x → zsz x ≤ Bb :=
    fun hE => by rw [← hE.ev]; exact Ex.zsz_eval_le _ Bb _ hE.bnd
  have zru := zof Eru
  have zrv := zof Erv
  have zrw := zof Erw
  have zQ : zsz (Q : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)
  set S := segSum tf ru rv rw w u v' n with hS
  have hSabs := segSum_abs (ru := ru) (rv := rv) hT.abs hrw hw.le u v' n
  have hT0 : (0 : ℤ) ≤ Tm := by omega
  have hTw0 : (0 : ℤ) ≤ Tm * w := by positivity
  have hpn : (0 : ℤ) < rw ^ n := by positivity
  have hSQ : |S| ≤ (Q : ℤ) * Q := by
    have : Tm * w * (rw ^ n - 1) ≤ Tm * w * rw ^ n := by nlinarith
    linarith
  have hcS : |c * S| ≤ (Q : ℤ) * Q := by
    rcases hc with rfl | rfl <;> simp [abs_neg] <;> linarith
  have hv0 : (0 : ℤ) ≤ v := by positivity
  have hvQ' : (v : ℤ) < Q := by exact_mod_cast hvQ
  set r := ((v : ℤ) + c * (0 + S) + (Q : ℤ) * Q) % (Q : ℤ) with hr
  have hpos : 0 ≤ (v : ℤ) + c * (0 + S) + (Q : ℤ) * Q := by
    rw [zero_add]; have := abs_le.1 hcS; linarith
  -- the segment step
  have hGt3 : G3 tgt = (v : ℤ) :: lt := by rw [g3o tgt ht6 ht7 ht8]; exact hGt
  have hGc3 : G3 rC = [] := by rw [g3o rC (by decide) (by decide) (by decide)]; exact hGc
  have hRu3 : (encK s G3).G pRu = .int ru :: (ints (G pRu) ++ s.G pRu) := by
    rw [encK_G, g3u]; rfl
  have hRv3 : (encK s G3).G pRv = .int rv :: (ints (G pRv) ++ s.G pRv) := by
    rw [encK_G, g3v]; rfl
  have hRw3 : (encK s G3).G pRw = .int rw :: (ints (G pRw) ++ s.G pRw) := by
    rw [encK_G, g3w]; rfl
  have hRR3 : (encK s G3).G pR = .int Rv :: LR := by
    rw [e3 _ (by decide) (by decide) (by decide)]; exact hRR
  have hNn3 : (encK s G3).G pN = .int (n : ℤ) :: LN := by
    rw [e3 _ (by decide) (by decide) (by decide)]; exact hNn
  have hvz : zsz (v : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg hv0]; nlinarith)
  have SS := segStepR_fsp hT s G3 hGc3 ht56 htA htU htV htW htC hGt3 hvz hRu3 hRv3 hRw3 hRR3 hNn3
    hru hrv hrw zru zrv zrw hnb (ea := .lit 0) (a := 0) (r := r) hu hv hw (zof Eu) (zof Ev) hTm
    (by rw [abs_zero, zero_add]; linarith) s2 s3 (fun i hi => by simp [Ex.regs] at hi)
    (tr3 n3 Eu) (tr3 n4 Ev) (tr3 n5 Ew) (ESp.lit (by rw [zsz_zero]; omega)) (by
      intro G' hA' ho'
      have Et : ESp (.reg tgt) (encK s G') Bb (v : ℤ) :=
        ESp.reg ht56 (by rw [ho' tgt htA htU htV htW]; exact hGt3) hvz
      have EA : ESp (.reg rA) (encK s G') Bb (0 + S) :=
        ESp.reg (by decide) hA' (zl _ (by rw [zero_add]; linarith))
      have EQ : ESp (.reg q) (encK s G') Bb (Q : ℤ) :=
        ESp.ofG' (by rw [encK_G_eq (ho' q hqA hqU hqV hqW), e3 q hq6 hq7 hq8]; exact hGq) hq56 zQ
      have Ec : ESp (.lit c) (encK s G') Bb c :=
        ESp.lit (zl _ (by rcases hc with rfl | rfl <;> norm_num <;> nlinarith))
      have E1 := ESp.mul Ec EA (zl _ (by rw [zero_add]; linarith))
      have E2 := ESp.add Et E1 (zl _ (by
        rw [abs_le]; constructor <;> (have := abs_le.1 hcS; rw [zero_add]; linarith)))
      have E3 := ESp.add E2 (ESp.mul EQ EQ (zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)))
        (zl _ (by rw [abs_of_nonneg hpos]; have := abs_le.1 hcS; rw [zero_add]; linarith))
      exact ESp.nmod E3 EQ hpos hQ0' (zl _ (by
        have h1 := Int.emod_nonneg ((v : ℤ) + c * (0 + S) + (Q : ℤ) * Q) hQ0'.ne'
        have h2 := Int.emod_lt_of_pos ((v : ℤ) + c * (0 + S) + (Q : ℤ) * Q) hQ0'
        rw [abs_of_nonneg h1]; linarith)))
  -- pops
  set G4 := Function.update G3 tgt (r :: lt) with hG4
  have g4w : G4 pRw = rw :: G pRw := by simp only [G4]; rw [upd_ne ht8.symm]; exact g3w
  have S5 := Sp.pop s G4 (B := Bb) (by decide) g4w zrw
  set G5 := Function.update G4 pRw (G pRw) with hG5
  have g5v : G5 pRv = rv :: G pRv := by
    simp only [G5, G4]; rw [upd_ne (by decide), upd_ne ht7.symm]; exact g3v
  have S6 := Sp.pop s G5 (B := Bb) (by decide) g5v zrv
  set G6 := Function.update G5 pRv (G pRv) with hG6
  have g6u : G6 pRu = ru :: G pRu := by
    simp only [G6, G5, G4]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne ht6.symm]
    exact g3u
  have S7 := Sp.pop s G6 (B := Bb) (by decide) g6u zru
  have hrv' : r = ((subM Q v (-(c * S)) : ℕ) : ℤ) := by
    rw [subM_cast hQ0, hr, zero_add, Int.add_mul_emod_self_left]; congr 1; ring
  have hfin : Function.update G6 pRu (G pRu) =
      Function.update G tgt ((subM Q v (-(c * S)) : ℤ) :: lt) := by
    rw [← hrv']
    funext j
    by_cases a1 : j = pRu
    · subst a1; rw [Function.update_self, upd_ne ht6.symm]
    rw [upd_ne a1]; simp only [G6]
    by_cases a2 : j = pRv
    · subst a2; rw [Function.update_self, upd_ne ht7.symm]
    rw [upd_ne a2]; simp only [G5]
    by_cases a3 : j = pRw
    · subst a3; rw [Function.update_self, upd_ne ht8.symm]
    rw [upd_ne a3]; simp only [G4]
    by_cases a4 : j = tgt
    · subst a4; rw [Function.update_self, Function.update_self]
    rw [upd_ne a4, upd_ne a4]; exact g3o j a1 a2 a3
  have H := (FSp.of_norep rfl S1).seq ((FSp.of_norep rfl S2).seq ((FSp.of_norep rfl S3).seq
    (SS.seq ((FSp.of_norep rfl S5).seq ((FSp.of_norep rfl S6).seq (FSp.of_norep rfl S7))))))
  refine (H.congr (by rw [hfin])).mono ?_
  simp only [cV, cStepR, Ex.size, finE]
  have h2 : 2 * Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  generalize (Bb + 2) ^ 2 = X at *
  generalize cLp n (cSegItR T Bb) Bb = Y
  generalize eru.size = a1 at *
  generalize erv.size = a2 at *
  generalize erw.size = a3 at *
  generalize eu.size = a4 at *
  generalize ev.size = a5 at *
  generalize ew.size = a6 at *
  have hX := Nat.zero_le X
  nlinarith [Nat.mul_le_mul_right X hsz]

