-- title:
--   The CNOT group $G_n \le \mathrm{Sym}(2^n)$
-- statement:
--   $G_n$ is the group generated by all CNOT gates on $n$ qubits (§2.1, p.7). It acts on the $2^n$ computational-basis strings by permutations, so it is a subgroup of the symmetric group $\mathrm{Sym}(2^n)$ (§2.3, p.11):
--   $$
--   G_n = \big\langle\, \mathrm{CNOT}_{a,b} : a\ne b \,\big\rangle \le \mathrm{Sym}(\{0,1\}^n).
--   $$
--   By Eq. (2.10), $G_n = \Gamma(\mathrm{SL}(n;\mathbb F_2))$. The module also equips $G_n$ with its finite-type structure, the discrete topology (so every unitary representation of it is continuous), and records that every $\mathrm{CNOT}_{a,b}$ lies in it.
--
--   **Formalization Note** The generating set is $\{\mathrm{cnotPerm}(n,a,b): a,b\in\mathbb N\}$; the members with $a\equiv b$ are the identity, so the generated group is the paper's $G_n$.
-- source:
--   Anshu–Balasubramanian–Haferkamp–Harrow–Tan, Depth-1 expanders on the unitary group and applications, arXiv:2609.01605 (held version, sha256 3c3f8513…aebfd87), §2.1, p.7 and §2.3, p.11

import Mathlib
import Definitions.Def_MITMSynthesis_Gate
import Definitions.Def_DepthOneQExp_cnotPerm

namespace DepthOneQExp

/-- `G_n`, the group generated by all CNOT gates on `n` qubits, as a subgroup of the symmetric
group `Sym(2ⁿ)` of the computational basis (Anshu–Balasubramanian–Haferkamp–Harrow–Tan, *Depth-1
expanders on the unitary group and applications*, arXiv:2609.01605, held version sha256
3c3f8513…aebfd87, §2.1, p.7 ("the group generated by all CNOT gates on n qubits, for which we will
denote by G_n") and §2.3, p.11 ("G_n … is a subgroup of Sym(2ⁿ)")).

**Formalization Note** The generators are the permutations `cnotPerm n a b` for all `a, b ∈ ℕ`
(indices mod `n`); those with `a ≡ b` are the identity, so the closure is exactly the group
generated by the gates `CNOT_{a,b}`, `a ≠ b`. As a finite group, `G_n` carries the discrete topology
(every unitary representation of it is continuous) and its uniform probability measure is its Haar
measure. -/
def cnotGroup (n : ℕ) : Subgroup (Equiv.Perm (MITMSynthesis.Q n)) :=
  Subgroup.closure {σ | ∃ a b : ℕ, σ = cnotPerm n a b}

noncomputable instance cnotGroup.instFintype (n : ℕ) : Fintype (cnotGroup n) :=
  Fintype.ofFinite _

instance cnotGroup.instTopologicalSpace (n : ℕ) : TopologicalSpace (cnotGroup n) := ⊥

instance cnotGroup.instDiscreteTopology (n : ℕ) : DiscreteTopology (cnotGroup n) := ⟨rfl⟩

theorem cnotPerm_mem_cnotGroup (n a b : ℕ) : cnotPerm n a b ∈ cnotGroup n :=
  Subgroup.subset_closure ⟨a, b, rfl⟩

end DepthOneQExp


