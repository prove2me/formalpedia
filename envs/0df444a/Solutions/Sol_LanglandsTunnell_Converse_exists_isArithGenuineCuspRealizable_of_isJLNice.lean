private theorem constantTerm_mul_right (μ : Measure Q) (u : Q → G) (f : G → ℂ) (g r : G) :
    constantTerm μ u f (g * r) = constantTerm μ u (fun h => f (h * r)) g := by
  simp only [constantTerm, constantTermIntegrand, mul_assoc]

private theorem constantTerm_mul_right_eq (μ : Measure Q) (u : Q → G) {f : G → ℂ} {r : G}
    (hf : ∀ h, f (h * r) = f h) (g : G) : constantTerm μ u f (g * r) = constantTerm μ u f g := by
  rw [constantTerm_mul_right]
  simp only [hf]

private theorem constantTerm_central_mul (μ : Measure Q) (u : Q → G) {f : G → ℂ} {z : G}
    (hz : ∀ h, z * h = h * z) {c : ℂ} (hf : ∀ h, f (z * h) = c * f h) (g : G) :
    constantTerm μ u f (z * g) = c * constantTerm μ u f g := by
  have key : ∀ q, f (u q * (z * g)) = c * f (u q * g) := fun q => by
    rw [← mul_assoc, ← hz, mul_assoc, hf]
  simp only [constantTerm, constantTermIntegrand, key, integral_const_mul]

