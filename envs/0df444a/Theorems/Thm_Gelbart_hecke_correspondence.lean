-- title:
--   Theorem 1 (Hecke): automorphy ⟺ nice Dirichlet series
-- statement:
--   **Theorem 1 (Hecke).** Let $a_0, a_1, \dots$ be complex numbers with $a_n = O(n^{c})$ for some $c > 0$, and let $h > 0$, $k > 0$, $C = \pm 1$. Put $$\varphi(s) = \sum_{n\ge1}\frac{a_n}{n^{s}}, \qquad \Phi(s) = \left(\frac{2\pi}{h}\right)^{-s}\Gamma(s)\varphi(s), \qquad f(z) = \sum_{n\ge0} a_n e^{2\pi i n z/h}.$$ Then the following are equivalent.
--
--   **(A)** $\Phi(s) + \dfrac{a_0}{s} + \dfrac{C a_0}{k-s}$ extends to an entire function, bounded in every vertical strip, and $\Phi(k-s) = C\,\Phi(s)$.
--
--   **(B)** $f(-1/z) = C\left(\dfrac{z}{i}\right)^{k} f(z)$ for all $\operatorname{Im} z > 0$.
--
--   In words: $f$ is automorphic of weight $k$ for the group generated by $z \mapsto z + h$ and $z \mapsto -1/z$ precisely when its Dirichlet series is "nice". The printed source writes the correction term as $C/(k-s)$; the standard $C a_0/(k-s)$ is used here, and the two agree when $a_0 = 0$.
-- source:
--   S. Gelbart, An elementary introduction to the Langlands program, Bull. Amer. Math. Soc. (N.S.) 10 (1984), no. 2, 177-219, https://doi.org/10.1090/S0273-0979-1984-15237-6, p. 188, §II.B.2, Theorem 1 (Hecke)

import Definitions.Def_Gelbart_hecke_conditions

namespace Gelbart

theorem hecke_correspondence
    (a : ℕ → ℂ) (c h k : ℝ) (C : ℂ)
    (hc : 0 < c) (hh : 0 < h) (hk : 0 < k) (hC : C = 1 ∨ C = -1)
    (hgrowth : HeckeCoeffGrowth a c) :
    HeckeNice a h k C (c + 1) ↔ HeckeAutomorphic a h k C := by sorry

end Gelbart
