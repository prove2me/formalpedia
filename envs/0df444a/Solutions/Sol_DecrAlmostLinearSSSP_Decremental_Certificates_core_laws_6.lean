attribute [local instance] Classical.propDecidable
lemma count_update {n : ℕ} (g : Fin n → ℝ) (v : Fin n) (x : ℝ) :
    (∑ w, nonzero (Function.update g v x w)) = (∑ w, nonzero (g w))+nonzero x-nonzero (g v) := by
  have he : (∑ w ∈ Finset.univ.erase v, nonzero (Function.update g v x w)) =
      ∑ w ∈ Finset.univ.erase v, nonzero (g w) := by
    apply Finset.sum_congr rfl
    intro w hw
    simp only [Finset.mem_erase,Finset.mem_univ,and_true] at hw
    rw [Function.update_of_ne hw]
  have hsum := Finset.add_sum_erase Finset.univ (fun w => nonzero (g w)) (Finset.mem_univ v)
  have hsum' := Finset.add_sum_erase Finset.univ (fun w => nonzero (Function.update g v x w)) (Finset.mem_univ v)
  simp only [Function.update_self] at hsum'
  rw [he] at hsum'
  omega
lemma Image.updated {n : ℕ} (base : ℕ) (g : Fin n → ℝ) (v : Fin n) (delta : ℝ) (s : Data)
    (h : Image base g s) (hc : s.natReg 620 = base+2*v.val) (hd : s.realReg 626 = delta) :
    Image base (Function.update g v (g v+delta)) (result s) := by
  obtain ⟨hr,hn,hcount⟩ := values s
  refine ⟨?_,?_⟩
  · intro w
    rw [hr,hc,hd,h.entries v]
    by_cases hw : w = v
    · subst w;simp
    · have hne : base+2*w.val ≠ base+2*v.val := by intro hh;apply hw;apply Fin.ext;omega
      rw [Function.update_of_ne hne,Function.update_of_ne hw,h.entries w]
  · rw [hcount,hc,hd,h.entries v,h.count,count_update]
lemma update_two_gradient {n : ℕ} (g : Fin n → ℝ) (a z : Fin n) (delta : ℝ) :
    Function.update (Function.update g a (g a-delta)) z
      ((Function.update g a (g a-delta)) z+delta) =
      fun v => g v-(if v = a then delta else 0)+(if v = z then delta else 0) := by
  funext v
  by_cases hvz : v = z
  · subst v
    simp only [Function.update_self,if_pos rfl]
    by_cases hza : z = a
    · subst z;simp
    · simp [Function.update_of_ne hza,hza]
  · rw [Function.update_of_ne hvz]
    by_cases hva : v = a
    · subst v;simp [hvz]
    · simp [Function.update_of_ne hva,hva,hvz]
end DecrAlmostLinearSSSP.Decremental.CoreGradient
end s249
