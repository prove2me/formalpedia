/-- Conjugation: `conj ∘ F_s ∘ conj = F_s⁺`, hence an algorithm for `R F_s` gives one for
`R F_s⁺` by conjugating input and output. -/
lemma conj_dftM (u : ((i : Fin d) → ZMod (s i)) → ℂ) :
    (fun k => (starRingEnd ℂ) (dftM s (fun j => (starRingEnd ℂ) (u j)) k)) = dftP s u := by
  ext k
  simp only [dftM, dftP, map_mul, map_inv₀, map_prod, map_natCast, map_sum,
    Complex.conj_conj]
  congr 1
  refine Finset.sum_congr rfl (fun j _ => ?_)
  congr 1
  refine Finset.prod_congr rfl (fun i _ => ?_)
  rw [← AddChar.map_neg_eq_conj, neg_neg]

lemma conj_Rperm_dftM (u : ((i : Fin d) → ZMod (s i)) → ℂ) :
    (fun k => (starRingEnd ℂ) (Rperm s t (dftM s (fun j => (starRingEnd ℂ) (u j))) k)) =
      Rperm s t (dftP s u) := by
  rw [← conj_dftM]; rfl

end cancel

