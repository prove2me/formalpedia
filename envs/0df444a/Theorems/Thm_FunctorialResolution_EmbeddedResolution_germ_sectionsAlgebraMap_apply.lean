theorem FunctorialResolution.EmbeddedResolution.germ_sectionsAlgebraMap_apply (k : Type u) [CommRing k] {X : Scheme.{u}}
    (p : X ⟶ Spec (CommRingCat.of k)) (U : X.Opens) (x : X) (hx : x ∈ U) (a : k) :
