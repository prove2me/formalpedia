/-!
# Machine evaluation of compact subset addresses

The current width decreases by one in each recursive call. Its highest
power of two is read from a table, so neither division nor a loop proportional
to the numeric bit-mask value occurs. Pascal coefficients are single reads
from the constructed rectangular table.
-/

namespace ThreeSum.LightSubsetAddress

open Light ThreeSum.SubsetAddress ThreeSum.LightPascal

variable {lim : Limits} {P : Program}




theorem powers_of_segment {μ : ℕ → ℤ} {base W : ℕ}
    (h : Seg μ base (powList 2 (W+1))) : Powers μ base W := by
  intro i hi
  have hs := h i (by simp; omega)
  simpa only [getElem_powList] using hs

























































































































end ThreeSum.LightSubsetAddress

end

section


/-!
# Actual evaluation of one member of the deterministic coloring family

Two calls to the checked mask-coordinate routine inspect the selected bits
of an original array index. Four literal color arguments determine the map
from bit patterns to the three colors. The cost is linear in the binary
width and independent of the numeric index magnitude.
-/

namespace ThreeSum.LightColorIndex

open Light LightSubsetAddress

variable {lim : Limits} {P : Program}












theorem color_lt {W : ℕ} (p : Coloring.Parameter W) (m : ℕ) : color p m < 3 :=
  (p.2 _).isLt





























































































end ThreeSum.LightColorIndex

end

section


/-!
# Building the color of every original array position

The program constructs its own binary-power table and evaluates one selected
two-coordinate coloring on every index. No index-bit or coloring oracle is
part of the input. Memory outside the output colors and scratch is preserved.
-/

namespace ThreeSum.LightColorArray

open Light LightSubsetAddress

set_option maxHeartbeats 1200000


















variable {lim : Limits} {P : Program} {d : ℕ}

theorem meets_sourceProof {pMain pPowers pColor pErase W n dst work : ℕ}
    (hmain : P[pMain]? = some (body pPowers pColor))
    (hpowers : P[pPowers]? = some powTableBody)
    (hcolor : P[pColor]? = some (LightColorIndex.body pErase))
    (herase : P[pErase]? = some (LightMaskErase.body pErase))
    (μ : ℕ → ℤ) (p : Coloring.Parameter W)
    (hw : (lim.space : ℤ) ≤ lim.word) (hn : n ≤ 2^W)
    (hdst : dst+n ≤ work) (hspace : work+(W+1) ≤ lim.space)
    (hword : ((2^(W+1) : ℕ) : ℤ) ≤ lim.word) (hd : d+W+2 ≤ lim.depth) :
    Meets lim P pMain d [W,n,p.1.1.val,p.1.2.val,(p.2 (false,false)).val,
      (p.2 (false,true)).val,(p.2 (true,false)).val,(p.2 (true,true)).val,dst,work]
      μ (time W n) (fun _ ν =>
        (∀ i < n, ν (dst+i) = (LightColorIndex.color p i : ℤ)) ∧
        Powers ν work W ∧ KeptBut μ ν work dst n) := by
  have htwo : (2 : ℤ) ≤ lim.word := by
    have hh : 2^1 ≤ 2^(W+1) := Nat.pow_le_pow_right (by decide) (by omega)
    exact (by exact_mod_cast hh : (2 : ℤ) ≤ ((2^(W+1) : ℕ) : ℤ)).trans hword
  apply Meets.of_body hmain
  unfold body time
  have hp := powTable_meets (d := d+1) (μ := μ) (dst := work) (L := W+1) (b := 2)
    hpowers hw hspace (by
      intro i hi
      exact (Int.ofNat_le.mpr (Nat.pow_le_pow_right (by decide) hi)).trans hword)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (hp _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen hp ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightColorIndex.time, LightMaskErase.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightColorIndex.time, LightMaskErase.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightColorIndex.time,
                LightMaskErase.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro powRet ν₀ ⟨pow, keep₀⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  have pow₀ : Powers ν₀ work W := powers_of_segment pow
  refine Ends.for (Inv μ p n dst work powRet) n (LightColorIndex.time W+90)
    ?start ?round ?done ?bound (hT := by first
                                         |
                                           ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                                                 List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                                                 LightColorIndex.time, LightMaskErase.time]);
                                             (first
                                               | omega
                                               | ((ring_nf); (omega))))
                                         | omega
                                         |
                                           (simp [LightColorIndex.time, LightMaskErase.time] <;>
                                               first
                                               | omega
                                               | ((ring_nf); (omega))))
  case start =>
    refine ⟨0,ν₀,?_,?_,pow₀,?_⟩
    · simp [update_frame_setLocal]
      exact (frame_append_zeros _ 1).symm
    · intro i hi
      omega
    · intro a ha
      exact keep₀ a (Or.inl ha.1)
  case round =>
    rintro j _ hj _ ⟨r,ν,rfl,written,pows,kept⟩
    have hc := LightColorIndex.meets (d := d+1) (m := j) (powers := work)
      hcolor herase ν p hw hspace hword pows (by omega) (by omega)
    focus
      ((((first
              | refine Light.Ends.seqSelf ?_
              | refine Light.Ends.skipLast ?_));
          (repeat
              with_unfolding_none
                first
                | refine Light.Ends.seqAssoc ?_
                | refine Light.Ends.skipThen ?_)));
      (first
        | refine Light.Ends.callToThen (hc _ (by omega)) ?_ ?_ ?_ ?_
        | refine Light.Ends.callToThen hc ?_ ?_ ?_ ?_);
      (on_goal -1 =>
          first
          |
            ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                  List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                  LightColorIndex.time, LightMaskErase.time]);
              (first
                | omega
                | ((ring_nf); (omega))))
          | omega
          |
            (simp [LightColorIndex.time, LightMaskErase.time] <;>
                first
                | omega
                | ((ring_nf); (omega))));
      (on_goal -1 => omega);
      (on_goal -1 =>
          (((try have := Light.Std.space_le (by assumption)));
            ((try have := Light.Std.const_le (by assumption)));
            (simp [Light.Limits.Addr, abs_le, -abs_mul, LightColorIndex.time,
                  LightMaskErase.time] <;>
                omega)));
      (on_goal -1 =>
          ((rintro r' ν' ⟨hr, hmem⟩);
            (try with_unfolding_none refine Light.Ends.skip ?_)))
    subst ν'
    have hcLt := LightColorIndex.color_lt p j
    have hcWord : (LightColorIndex.color p j : ℤ) ≤ lim.word := by omega
    focus
      ((((first
              | refine Light.Ends.seqSelf ?_
              | refine Light.Ends.skipLast ?_));
          (repeat
              with_unfolding_none
                first
                | refine Light.Ends.seqAssoc ?_
                | refine Light.Ends.skipThen ?_)));
      (refine
          Light.Ends.storeToThen (dst + j) (LightColorIndex.color p j : ℕ) ?_ ?_
            ?_);
      (on_goal -1 =>
          first
          |
            ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                  List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hr,
                  LightColorIndex.time, LightMaskErase.time]);
              (first
                | omega
                | ((ring_nf); (omega))))
          | omega
          |
            (simp [hr, LightColorIndex.time, LightMaskErase.time] <;>
                first
                | omega
                | ((ring_nf); (omega))));
      (on_goal -1 =>
          (((try have := Light.Std.space_le (by assumption)));
            ((try have := Light.Std.const_le (by assumption)));
            (simp [Light.Limits.Addr, abs_le, -abs_mul, hr, LightColorIndex.time,
                  LightMaskErase.time] <;>
                omega)));
      (try with_unfolding_none refine Light.Ends.skip ?_)
    refine ⟨by simp,r',Function.update ν (dst+j) (LightColorIndex.color p j : ℤ),
      by simp [update_frame_setLocal],?_,?_,?_⟩
    · intro i hi
      rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
      · rw [Function.update_of_ne (by omega)]
        exact written i hi
      · simp
    · intro i hi
      rw [Function.update_of_ne (by omega)]
      exact pows i hi
    · intro a ha
      rw [Function.update_of_ne (by omega)]
      exact kept a ha
  case done =>
    rintro _ _ ⟨r,ν,rfl,written,pows,kept⟩
    exact ⟨written,pows,kept⟩
  case bound =>
    rintro j _ hj _ ⟨r,ν,rfl,_,_,_⟩
    (((try have := Light.Std.space_le (by assumption)));
      ((try have := Light.Std.const_le (by assumption)));
      (simp [Light.Limits.Addr, abs_le, -abs_mul, ] <;> omega))



















end ThreeSum.LightColorArray

end


