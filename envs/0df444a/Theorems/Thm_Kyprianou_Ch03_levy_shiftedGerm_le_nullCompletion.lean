-- title:
--   Shifted Lévy germ is null-trivial
-- statement:
--   Let $X$ be a Lévy process and fix $t\ge 0$. Write $Y_u=X_{t+u}-X_t$ for the post-$t$ increment process, and let $\mathcal{N}$ be the $\sigma$-algebra generated by subsets of measurable $P$-null sets.
--
--   Then the germ $\sigma$-field of $Y$ at time $0$ satisfies
--   $$
--   \mathcal{G}_{0+}(Y)\;\subseteq\;\mathcal{N}.
--   $$
--
--   This is Blumenthal's zero–one law for the shifted Lévy process (independent increments, càdlàg), and is the probabilistic half of the right-germ inclusion in Kyprianou Exercise 3.1. A reusable engine is AvramDividend's `germ_zero_one_of_shift_independence_ws01f`.
-- source:
--   Kyprianou (2006), Chapter 3, Exercise 3.1 (Blumenthal for shifted Lévy), printed p. 83; cf. Durrett §7.2 / AvramDividend germ_zero_one_of_shift_independence_ws01f

import Mathlib
import Definitions.Def_LeanLevy_Processes_LevyProcess
import Definitions.Def_DurrettProbability_Brownian
open MeasureTheory ProbabilityTheory DurrettProbability
open scoped NNReal
set_option autoImplicit false

namespace Kyprianou.Ch03
theorem levy_shiftedGerm_le_nullCompletion
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (X : NNReal -> Omega -> Real)
    (hX : ProbabilityTheory.IsLevyProcess X P)
    (t : NNReal) :
    germSigma (fun u : NNReal => fun omega : Omega => X (t + u) omega - X t omega) ≤
      MeasurableSpace.generateFrom
            {A : Set Omega |
              exists N : Set Omega,
                MeasurableSet N ∧ P N = 0 ∧ A ⊆ N} := by
  sorry

end Kyprianou.Ch03
