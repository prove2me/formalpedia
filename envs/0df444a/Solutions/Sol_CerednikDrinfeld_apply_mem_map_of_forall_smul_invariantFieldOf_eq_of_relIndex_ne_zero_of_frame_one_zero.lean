theorem v_natCast_le_one {K Γ₀ : Type} [Field K] [LinearOrderedCommGroupWithZero Γ₀] [Valued K Γ₀] (n : ℕ) :
    Valued.v (n : K) ≤ 1 := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Nat.cast_succ]
    exact (Valuation.map_add _ _ _).trans (max_le ih (le_of_eq (Valuation.map_one _)))

theorem v_natCast_eq_one_of_not_dvd {K Γ₀ : Type} [Field K] [LinearOrderedCommGroupWithZero Γ₀] [Valued K Γ₀]
    {q : ℕ} (hq : q.Prime) (hvq : Valued.v (q : K) < 1) {n : ℕ} (hqn : ¬ q ∣ n) : Valued.v (n : K) = 1 := by

  have hcop : Nat.Coprime q n := (Nat.Prime.coprime_iff_not_dvd hq).2 hqn
  obtain ⟨m, -, hm⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop.symm hq.one_lt
  have hdecomp : (n : K) * (m : K) = 1 + (q : K) * ((n * m / q : ℕ) : K) := by
    have := Nat.div_add_mod (n * m) q
    rw [hm] at this
    have : ((n * m : ℕ) : K) = ((q * (n * m / q) + 1 : ℕ) : K) := by rw [this]
    push_cast at this
    rw [this]; ring
  have h1 : Valued.v ((n : K) * (m : K)) = 1 := by
    rw [hdecomp]
    have hlt : Valued.v ((q : K) * ((n * m / q : ℕ) : K)) < 1 := by
      rw [Valuation.map_mul]
      calc Valued.v (q : K) * Valued.v ((n * m / q : ℕ) : K) ≤ Valued.v (q : K) * 1 :=
            mul_le_mul_right (v_natCast_le_one _) _
        _ = Valued.v (q : K) := mul_one _
        _ < 1 := hvq
    rw [Valuation.map_add_eq_of_lt_left]
    · exact Valuation.map_one _
    · rwa [Valuation.map_one]
  rw [Valuation.map_mul] at h1
  exact le_antisymm (v_natCast_le_one n)
    (by
      by_contra hlt
      push Not at hlt
      have : Valued.v (n : K) * Valued.v (m : K) < 1 := by
        calc Valued.v (n : K) * Valued.v (m : K) ≤ Valued.v (n : K) * 1 := mul_le_mul_right (v_natCast_le_one _) _
          _ = Valued.v (n : K) := mul_one _
          _ < 1 := hlt
      exact absurd h1 (ne_of_lt this))

theorem natCard_stabilizer_dvd_of_injective {H G X : Type} [Group H] [Group G] [MulAction H X] [MulAction G X]
    (f : H →* G) (hf : Function.Injective f) (hact : ∀ (h : H) (x : X), h • x = f h • x) (x : X)
    [Finite (MulAction.stabilizer G x)] :
    Nat.card (MulAction.stabilizer H x) ∣ Nat.card (MulAction.stabilizer G x) := by
  let φ : MulAction.stabilizer H x →* MulAction.stabilizer G x :=
    { toFun := fun s => ⟨f s, by rw [MulAction.mem_stabilizer_iff, ← hact]; exact s.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun a b => Subtype.ext (by simp) }
  have hφ : Function.Injective φ := fun a b h => Subtype.ext (hf (congrArg (fun t : MulAction.stabilizer G x => (t : G)) h))
  exact Subgroup.card_dvd_of_injective φ hφ

end CerednikDrinfeld.SqGlue

