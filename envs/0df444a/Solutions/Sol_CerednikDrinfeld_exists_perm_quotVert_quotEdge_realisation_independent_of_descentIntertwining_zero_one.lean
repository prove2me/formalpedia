    · exact Real_mul j _ _ _ _ _ _ (Real_mul j _ _ _ _ _ _ (Real_ι j τ) (Real_pow j _ _ _ (Real_σ0' j) u)) (Real_pow j _ _ _ (Real_σ1 j) v)
    · exact Q_mul j _ _ _ _ (Q_mul j _ _ _ _ (Q_ι j τ) (Qpow _ _ (Q_σ0 j) (Real_σ0' j) u)) (Qpow _ _ (Q_σ1 j) (Real_σ1 j) v)

  have RR : ∀ j n n' (t t' : Omega.IsometricAut ↥(ValuationSubring.ratClosure A₂) A₂.valuation.Completion),
      (∀ y : ↥(Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j)), n • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t) (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) =
        n' • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t') (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂))) →
      ρ₂ (n'⁻¹ * n) ∈ (Γ₂ j).map ρ₂ := by
    intro j n n' t t' h

    have ht : t = t' := by
      apply Omega.IsometricAut.ext
      apply RingEquiv.ext; intro c
      have hcmem : algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) c ∈
          Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j) :=
        (Mumford.mem_invariantFieldOf_iff _ _ _ _ _).2 fun γ _ =>
          Mumford.smul_algebraMap_const A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) γ c
      have hc := h ⟨algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) c, hcmem⟩
      change n • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t) (algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) c) =
        n' • Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t') (algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) c) at hc
      rw [Mumford.AmbientSemilinearAut.fracMap_algebraMap_const, Mumford.AmbientSemilinearAut.fracMap_algebraMap_const,
        Mumford.smul_algebraMap_const A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂),
        Mumford.smul_algebraMap_const A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂)] at hc
      exact (algebraMap A₂.valuation.Completion (FractionRing (Omega.HolRingOf ϖ₂ ρ₂))).injective hc
    subst ht

    have hfix : ∀ x ∈ Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j),
        (n'⁻¹ * n) • x = x := by
      intro x hx
      let y : ↥(Mumford.invariantFieldOf A₂.valuation.Completion (ℍ[ℚ, a₁, b₁])ˣ (Omega.HolRingOf ϖ₂ ρ₂) (Γ₂ j)) := (Mumford.AmbientSemilinearAut.invMapOf (Γ₂ j) (Omega.toAmbientOf ϖ₂ ρ₂ t)).symm ⟨x, hx⟩
      have hy : Mumford.AmbientSemilinearAut.fracMap (Omega.toAmbientOf ϖ₂ ρ₂ t) (y : FractionRing (Omega.HolRingOf ϖ₂ ρ₂)) = x := by
        have := Mumford.AmbientSemilinearAut.coe_invMapOf (Γ₂ j) (Omega.toAmbientOf ϖ₂ ρ₂ t) y
        rw [← this]
