  -- the rest
  have hfr2 : frV σ1 lowTk = [(12, ((R - mC ^ j : ℕ) : ℤ)), (13, ((o + mC ^ j : ℕ) : ℤ))] := by
    simp [frV, lowTk, NE.val, vOf_eq hLo1.h12, vOf_eq hLo1.h13, vOf_eq hLo1.h14]
  set σ2 := σPush σ1 (frV σ1 lowTk) with hσ2
  have hC2 : CoreR σ2 K S r H P D ρ k q0 Bp := by
    rw [hσ2, hfr2]
    exact hC1.push _ (fun p hp => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl <;> (dsimp only; decide))
  have hLo2 : LowR σ2 j (R - mC ^ j) (o + mC ^ j) := by
    have hnd : (([(12, ((R - mC ^ j : ℕ) : ℤ)), (13, ((o + mC ^ j : ℕ) : ℤ))] :
      List (Fin HS × ℤ)).map Prod.fst).Nodup := by simp only [List.map_cons, List.map_nil]; decide
    have hne : ∀ i ∈ [(11 : Fin HS), 14, 15], σ2 i = σ1 i := fun i hi => by
      rw [hσ2, hfr2]
      exact σPush_ne _ σ1 i (fun p hp e => by
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl <;> (subst e; revert hi; dsimp only; decide))
    exact ⟨by rw [hne _ (by simp)]; exact hLo1.h11,
      by rw [hσ2, hfr2]; exact σPush_mem _ _ _ _ hnd (by simp),
      by rw [hσ2, hfr2]; exact σPush_mem _ _ _ _ hnd (by simp),
      by rw [hne _ (by simp)]; exact hLo1.h14, by rw [hne _ (by simp)]; exact hLo1.h15⟩
  have R2 := IH σ2 hC2 hLo2
  unfold LowS at R2
  have hFr2 : FrOK σ1 Mb 12 lowTk := by
    intro x hx
    simp only [lowTk, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl
    all_goals refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of _ hnat (by decide), ?_⟩
    all_goals simp only [NE.OK, NE.val, vOf_eq hLo1.h12, vOf_eq hLo1.h13, vOf_eq hLo1.h14]
    all_goals omega
  have Hrec := sImplQ_fr hσ10 lowTk Mb Bz 12 ctx.hMb hFr2 (noRdN_of_B _ _ (by decide)) (by decide) R2
  have C := Hlev.comp (low_slaws hρ) Hrec
  have hTT : (tensF fun x : Fin D' => if o + mC ^ j ≤ x.val ∧ x.val < o + mC ^ j + (R - mC ^ j)
        then Cm else 1) *
        (tensF fun x : Fin D' => @ite _ (∃ k, g k = x) Fintype.decidableExistsFintype Cm 1) =
      tensF fun x : Fin D' => if o ≤ x.val ∧ x.val < o + R then Cm else 1 := by
    rw [← tensF_mul]
    congr 1; funext x
    have hex : (∃ k, g k = x) ↔ (o ≤ x.val ∧ x.val < o + mC ^ j) := by
      constructor
      · rintro ⟨y, hy⟩
        have := congrArg Fin.val hy; have := y.isLt; simp only [hg] at *; omega
      · intro h
        exact ⟨⟨x.val - o, by omega⟩, Fin.ext (by simp only [hg] <;> omega)⟩
    by_cases h1 : o ≤ x.val ∧ x.val < o + mC ^ j
    · rw [if_neg (by omega), if_pos (hex.2 h1), if_pos (by omega), one_mul]
    · rw [if_neg (fun h => h1 (hex.1 h)), mul_one]
      by_cases h2 : o + mC ^ j ≤ x.val ∧ x.val < o + mC ^ j + (R - mC ^ j)
      · rw [if_pos h2, if_pos (by omega)]
      · rw [if_neg h2, if_neg (by omega)]
  have C' := (C.congrT hTT).congrE (lowF_take ES j R hR).symm (lowF_take DWl j R hR).symm
  have H0 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
    (st := fun x : Fin D' => 2 ^ (ρ + K * (D' - 1 - x.val)) * S) (n := Bp * 2 ^ (K * D') * S)
    hσ0 16 (by decide) (by decide) c1 Mb Bz 12 ctx.hMb (regsLt_of_all (by decide)) (by decide)
    (natR_of _ (frOK_nat hC hLo) (by decide))
    (by simp [hc1, NE.OK, NE.val, vOf_eq hLo.h12, vOf_eq hLo.h14] <;> omega)
    (p := .seq (withPushI (fr lowFr) (.call jL)) (withPushI (fr lowTk) (.call jW)))
    (q := testC 17 (.lt (.lit 0) (.reg 11) (.lit 0) (.lit 1)) (withPushI (fr lowDn) (.call jW)) .skip)
    (by rw [if_pos hv]; exact C')
  unfold LowS
  refine ((sImplQ_call hW H0).congrC rfl).mono (fun w _ _ => ?_)
  simp only [cLowP, lowFr, lowTk, List.length_cons, List.length_nil, Nat.reduceAdd]
  omega

/-- **A step down.** -/
theorem lowDown (jW jL : Fin Pp) (hW : tbl jW = lowC jW jL)
    {K S r H P D ρ k q0 Bp Z Zr Mb Bz : ℕ}
    (ctx : LowCtx K S r H P D ρ k q0 Bp Z Zr Mb Bz) (j R o : ℕ) (σ : Fin HS → Option ℤ)
    (hj : j + 1 ≤ k) (hC : CoreR σ K S r H P D ρ k q0 Bp) (hLo : LowR σ (j + 1) R o)
    (hR : R < mC ^ (j + 1)) (c : ℕ)
    (IH : ∀ σ2, CoreR σ2 K S r H P D ρ k q0 Bp → LowR σ2 j R o →
      LowS Isym tbl jW K S r H ρ (D - q0) Bp j R o σ2 c) :
    LowS Isym tbl jW K S r H ρ (D - q0) Bp (j + 1) R o σ (c + cLowS Bz) := by
  have hσ0 : σ 0 = none := hC.base.off 0 (by decide)
  have hM := ctx.hM
  have hmk : mC ^ (j + 1) ≤ mC ^ k := Nat.pow_le_pow_right (by norm_num) hj
  have hEk : ES (j + 1) ≤ ES k := ES_mono hj
  have hkm : k < mC ^ k := Nat.lt_pow_self (by norm_num)
  set D' := D - q0 with hD'def
  set c1 : NE := .lt (.reg 12) (.reg 14) (.lit 1) (.lit 0) with hc1
  have hv : c1.val (NLogN.KFW.vOf σ) = 1 := by
    simp [hc1, NE.val, vOf_eq hLo.h12, vOf_eq hLo.h14, hR]
  set σ1 := σPush σ [(16, ((c1.val (NLogN.KFW.vOf σ) : ℕ) : ℤ))] with hσ1
  have hC1 : CoreR σ1 K S r H P D ρ k q0 Bp :=
    hC.push _ (fun p hp => by simp only [List.mem_singleton] at hp; subst hp; dsimp only; decide)
  have hLo1 : LowR σ1 (j + 1) R o := hLo.push _ _ (by decide)
  have hσ10 : σ1 0 = none := hC1.base.off 0 (by decide)
  set c2 : NE := .lt (.lit 0) (.reg 11) (.lit 0) (.lit 1) with hc2
  have hv2 : c2.val (NLogN.KFW.vOf σ1) = 0 := by
    simp [hc2, NE.val, vOf_eq hLo1.h11]
  set σ1' := σPush σ1 [(17, ((c2.val (NLogN.KFW.vOf σ1) : ℕ) : ℤ))] with hσ1'
  have hC1' : CoreR σ1' K S r H P D ρ k q0 Bp :=
    hC1.push _ (fun p hp => by simp only [List.mem_singleton] at hp; subst hp; dsimp only; decide)
  have hLo1' : LowR σ1' (j + 1) R o := hLo1.push _ _ (by decide)
  have hσ10' : σ1' 0 = none := hC1'.base.off 0 (by decide)
  have hnat := frOK_nat hC1' hLo1'
  have hes : (NLogN.KFW.cL + P8Lift.sc * ES j - NLogN.KFW.cL) / P8Lift.sc = ES j := by
    rw [Nat.add_sub_cancel_left, Nat.mul_div_cancel_left _ sc_pos]
  have hmd : mC ^ (j + 1) / mC = mC ^ j := by
    rw [pow_succ, Nat.mul_div_cancel _ (by norm_num)]
  have hfr : frV σ1' lowDn = [(11, (j : ℤ)), (14, ((mC ^ j : ℕ) : ℤ)), (15, ((ES j : ℕ) : ℤ))] := by
    simp only [frV, lowDn, List.map_cons, List.map_nil, NE.val, vOf_eq hLo1'.h11,
      vOf_eq hLo1'.h14, vOf_eq hLo1'.h15]
    rw [hmd, show ES (j + 1) = NLogN.KFW.cL + P8Lift.sc * ES j from rfl, hes, Nat.add_sub_cancel]
  set σ2 := σPush σ1' (frV σ1' lowDn) with hσ2
  have hC2 : CoreR σ2 K S r H P D ρ k q0 Bp := by
    rw [hσ2, hfr]
    exact hC1'.push _ (fun p hp => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> (dsimp only; decide))
  have hLo2 : LowR σ2 j R o := by
    have hnd : (([(11, (j : ℤ)), (14, ((mC ^ j : ℕ) : ℤ)), (15, ((ES j : ℕ) : ℤ))] :
      List (Fin HS × ℤ)).map Prod.fst).Nodup := by simp only [List.map_cons, List.map_nil]; decide
    have hne : ∀ i ∈ [(12 : Fin HS), 13], σ2 i = σ1' i := fun i hi => by
      rw [hσ2, hfr]
      exact σPush_ne _ σ1' i (fun p hp e => by
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl | rfl | rfl <;> (subst e; revert hi; dsimp only; decide))
    exact ⟨by rw [hσ2, hfr]; exact σPush_mem _ _ _ _ hnd (by simp),
      by rw [hne _ (by simp)]; exact hLo1'.h12, by rw [hne _ (by simp)]; exact hLo1'.h13,
      by rw [hσ2, hfr]; exact σPush_mem _ _ _ _ hnd (by simp),
      by rw [hσ2, hfr]; exact σPush_mem _ _ _ _ hnd (by simp)⟩
  have R2 := IH σ2 hC2 hLo2
  unfold LowS at R2
  have hFr : FrOK σ1' Mb 12 lowDn := by
    intro x hx
    simp only [lowDn, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl
    all_goals refine ⟨by decide, regsLt_of_all (by decide), by decide, natR_of _ hnat (by decide), ?_⟩
    all_goals simp only [NE.OK, NE.val, vOf_eq hLo1'.h11, vOf_eq hLo1'.h14, vOf_eq hLo1'.h15]
    · omega
    · refine ⟨by omega, by omega, by norm_num⟩
    · have h1 : ES (j + 1) = NLogN.KFW.cL + P8Lift.sc * ES j := rfl
      have h2 := sc_pos
      refine ⟨⟨by omega, by omega, by omega⟩, by omega, h2⟩
  have Hd := sImplQ_fr hσ10' lowDn Mb Bz 12 ctx.hMb hFr (noRdN_of_B _ _ (by decide)) (by decide) R2
  have Hd' := Hd.congrE (lowF_down ES j R hR).symm (lowF_down DWl j R hR).symm
  have H2 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
    (st := fun x : Fin D' => 2 ^ (ρ + K * (D' - 1 - x.val)) * S) (n := Bp * 2 ^ (K * D') * S)
    hσ10 17 (by decide) (by decide) c2 Mb Bz 12 ctx.hMb (regsLt_of_all (by decide)) (by decide)
    (natR_of _ (frOK_nat hC1 hLo1) (by decide))
    (by simp [hc2, NE.OK, NE.val, vOf_eq hLo1.h11] <;> omega)
    (p := withPushI (fr lowDn) (.call jW)) (q := .skip)
    (by rw [if_pos hv2]; exact Hd')
  have H1 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
    (st := fun x : Fin D' => 2 ^ (ρ + K * (D' - 1 - x.val)) * S) (n := Bp * 2 ^ (K * D') * S)
    hσ0 16 (by decide) (by decide) c1 Mb Bz 12 ctx.hMb (regsLt_of_all (by decide)) (by decide)
    (natR_of _ (frOK_nat hC hLo) (by decide))
    (by simp [hc1, NE.OK, NE.val, vOf_eq hLo.h12, vOf_eq hLo.h14] <;> omega)
    (p := .seq (withPushI (fr lowFr) (.call jL)) (withPushI (fr lowTk) (.call jW)))
    (by rw [if_neg (by rw [hv]; norm_num)]; exact H2)
  unfold LowS
  refine ((sImplQ_call hW H1).congrC rfl).mono (fun w _ _ => ?_)
  simp only [cLowS, lowFr, lowTk, lowDn, List.length_cons, List.length_nil, Nat.reduceAdd]
  omega

/-- **The end** (`j = 0`, `R = 0`). -/
theorem lowEnd (jW jL : Fin Pp) (hW : tbl jW = lowC jW jL)
    {K S r H P D ρ k q0 Bp Z Zr Mb Bz : ℕ}
    (ctx : LowCtx K S r H P D ρ k q0 Bp Z Zr Mb Bz) (o : ℕ) (σ : Fin HS → Option ℤ)
    (hC : CoreR σ K S r H P D ρ k q0 Bp) (hLo : LowR σ 0 0 o) :
    LowS Isym tbl jW K S r H ρ (D - q0) Bp 0 0 o σ (cLowS Bz) := by
  have hσ0 : σ 0 = none := hC.base.off 0 (by decide)
  have hM := ctx.hM
  set D' := D - q0 with hD'def
  set c1 : NE := .lt (.reg 12) (.reg 14) (.lit 1) (.lit 0) with hc1
  have hv : c1.val (NLogN.KFW.vOf σ) = 1 := by
    simp [hc1, NE.val, vOf_eq hLo.h12, vOf_eq hLo.h14]
  set σ1 := σPush σ [(16, ((c1.val (NLogN.KFW.vOf σ) : ℕ) : ℤ))] with hσ1
  have hC1 : CoreR σ1 K S r H P D ρ k q0 Bp :=
    hC.push _ (fun p hp => by simp only [List.mem_singleton] at hp; subst hp; dsimp only; decide)
  have hLo1 : LowR σ1 0 0 o := hLo.push _ _ (by decide)
  have hσ10 : σ1 0 = none := hC1.base.off 0 (by decide)
  set c2 : NE := .lt (.lit 0) (.reg 11) (.lit 0) (.lit 1) with hc2
  have hv2 : c2.val (NLogN.KFW.vOf σ1) = 1 := by
    simp [hc2, NE.val, vOf_eq hLo1.h11]
  have hone : (tensF fun x : Fin D' => if o ≤ x.val ∧ x.val < o + 0 then Cm else 1) = 1 := by
    rw [← tensF_one]; congr 1; funext x; rw [if_neg (by omega)]
  have H2 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
    (st := fun x : Fin D' => 2 ^ (ρ + K * (D' - 1 - x.val)) * S) (n := Bp * 2 ^ (K * D') * S)
    hσ10 17 (by decide) (by decide) c2 Mb Bz 12 ctx.hMb (regsLt_of_all (by decide)) (by decide)
    (natR_of _ (frOK_nat hC1 hLo1) (by decide))
    (by simp [hc2, NE.OK, NE.val, vOf_eq hLo1.h11] <;> omega)
    (p := withPushI (fr lowDn) (.call jW)) (q := .skip)
    (by rw [if_neg (by rw [hv2]; norm_num)]
        exact (sImplQ_skip _ hone).congrE (show (0 : ℕ) = lowF ES 0 0 by simp [lowF])
          (show (0 : ℕ) = lowF DWl 0 0 by simp [lowF]))
  have H1 := sImplQ_test (I := Isym) (iprog := tbl) (lo := 0) (hi := H) (r := r)
    (st := fun x : Fin D' => 2 ^ (ρ + K * (D' - 1 - x.val)) * S) (n := Bp * 2 ^ (K * D') * S)
    hσ0 16 (by decide) (by decide) c1 Mb Bz 12 ctx.hMb (regsLt_of_all (by decide)) (by decide)
    (natR_of _ (frOK_nat hC hLo) (by decide))
    (by simp [hc1, NE.OK, NE.val, vOf_eq hLo.h12, vOf_eq hLo.h14] <;> omega)
    (p := .seq (withPushI (fr lowFr) (.call jL)) (withPushI (fr lowTk) (.call jW)))
    (by rw [if_neg (by rw [hv]; norm_num)]; exact H2)
  unfold LowS
  refine ((sImplQ_call hW H1).congrC rfl).mono (fun w _ _ => ?_)
  simp only [cLowS, lowFr, lowTk, lowDn, List.length_cons, List.length_nil, Nat.reduceAdd]
  omega

end Low

end NLogN.KFW

