-- title:
--   Limit orbit of the far family at the first bad parameter
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. A state is $s=(z_1,z_2,w_1,w_2)$. Its physical position relative to the primary is $(x_1,x_2)=(2(z_1^2-z_2^2),\,4z_1z_2)$, and $(v_1,v_2)$ is its physical (Jacobi) velocity. A collision state has $z=0$. $N(r)$ and $F(r)$ are the perpendicular near and far starts at $z=(r,0)$ and $z=(0,r)$.
--
--   **Compactness at the first bad parameter (far side).** Let $b>0$. Suppose $F(r)$ admits a far shooting arc for every $0<r<b$, but $F(b)$ does not. Then there is $T>0$ with the following properties:
--
--   - $F(b)$ lies on the component with $v_2(F(b))<0$;
--   - for $0<t<T$ the forward orbit satisfies $x_2\le0$, $v_1>0$ and $z\ne0$;
--   - at time $T$ it satisfies $x_1=0$, $x_2\le0$ and $v_1\ge0$;
--   - if $x_2<0$ and $v_1=0$ at time $T$, then $v_2\ne0$ there;
--   - the far arc lengths $\tau(r)$ tend to $T$ as $r\to b^-$.
--
--   Besides compactness, this includes the strict positivity $v_1>0$ on the open interval for the limit orbit. That is the far-side monotonicity for which Birkhoff uses his identity (59).
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18 (Collected Mathematical Papers Vol. 1, pp. 731–741); Liu–Salomão, arXiv 2506.17867v2, §5, pp. 30–31

import Definitions.Def_BirkhoffShootingArcs

namespace BirkhoffGlobalSection

theorem birkhoff_far_arc_limit (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ)
    (b : ℝ) (hb : 0 < b)
    (hgood : ∀ r ∈ Set.Ioo 0 b, ∃ x : LeftEnergyState μ c, (x : Phase) = farShootingStart μ c r ∧ ∃ τ : ℝ, IsFarShootingArc φ x τ)
    (hbad : ¬ (∃ x : LeftEnergyState μ c, (x : Phase) = farShootingStart μ c b ∧ ∃ τ : ℝ, IsFarShootingArc φ x τ)) :
    ∃ xb : LeftEnergyState μ c, (xb : Phase) = farShootingStart μ c b ∧
      jacobiVelocity (leviCivitaToJacobi μ (xb : Phase)) 1 < 0 ∧ ∃ T : ℝ, 0 < T ∧
      (∀ t ∈ Set.Ioo 0 T, relativePosition μ ((φ t xb : LeftEnergyState μ c) : Phase) 1 ≤ 0) ∧
      (∀ t ∈ Set.Ioo 0 T, 0 < jacobiVelocity (leviCivitaToJacobi μ ((φ t xb : LeftEnergyState μ c) : Phase)) 0) ∧
      (∀ t ∈ Set.Ioo 0 T, 0 < zNormSq ((φ t xb : LeftEnergyState μ c) : Phase)) ∧
      relativePosition μ ((φ T xb : LeftEnergyState μ c) : Phase) 0 = 0 ∧ relativePosition μ ((φ T xb : LeftEnergyState μ c) : Phase) 1 ≤ 0 ∧
      0 ≤ jacobiVelocity (leviCivitaToJacobi μ ((φ T xb : LeftEnergyState μ c) : Phase)) 0 ∧
      (relativePosition μ ((φ T xb : LeftEnergyState μ c) : Phase) 1 < 0 → jacobiVelocity (leviCivitaToJacobi μ ((φ T xb : LeftEnergyState μ c) : Phase)) 0 = 0 → jacobiVelocity (leviCivitaToJacobi μ ((φ T xb : LeftEnergyState μ c) : Phase)) 1 ≠ 0) ∧
      ∀ η > 0, ∃ δ > 0, ∀ r ∈ Set.Ioo (b - δ) b, ∀ x : LeftEnergyState μ c, ∀ τ : ℝ,
        (x : Phase) = farShootingStart μ c r → IsFarShootingArc φ x τ → |τ - T| < η := by sorry

end BirkhoffGlobalSection
