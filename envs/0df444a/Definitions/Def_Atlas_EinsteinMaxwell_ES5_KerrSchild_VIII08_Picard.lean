/-! ## The Picard operator -/

/-- The inner segment average `∫₀¹ V(3+u(t-3)) hg(3+u(t-3)) du`. -/
noncomputable def segV (hg : ℝ → ℝ) (t : ℝ) : ℝ :=
  ∫ u in (0 : ℝ)..1, Vfun (3 + (t - 3) * u) * hg (3 + (t - 3) * u)

/-- `(T hg)(R) = ∫₃ᴿ t/(t-1) · segV hg t dt`. -/
noncomputable def T (hg : ℝ → ℝ) (R : ℝ) : ℝ :=
  ∫ t in (3 : ℝ)..R, t / (t - 1) * segV hg t

/-- The Picard iterates `Yfun 0 = 1`, `Yfun (n+1) = T (Yfun n)`. -/
noncomputable def Yfun : ℕ → ℝ → ℝ
  | 0 => fun _ => 1
  | n + 1 => T (Yfun n)

