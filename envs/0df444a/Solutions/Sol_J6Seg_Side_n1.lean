-- Source module: Solutions.J6SegSideCost4
/-!
# Side costs 4: the eight side costs of one axis, as natural-number polynomials

With `W = 3 wA + wC` (so `wd ≤ W p`), `T = TP6`, `p = pP6`, `β = log₂ lg n`, on an axis with
`AxNum`:
* `n1`: chunk fine exposure `≤ 7 (W+9)² · T p (β+1)`;
* `n2`: `d ·` (`J` fine exposure) `≤ 101 (W+12)² · T p (d + ℓ)`;
* `n3`–`n5`: the selection and the two identity slab passes `≤ 10^10 (W+1) · T p`;
* `n6`: the output slab pass `≤ 10^11 (W+11) · T p + 10^7 · T · fmB(2Z)`, `Z = wd + 2p + 8`;
* `n7`, `n8`: the copy and the swap `≤ 10^9 (W+5)² · T p`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

section ax
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxNum P n src D k)
include h

theorem wd_le : axwd6 P n src k ap ≤ Wc ap * pP6 P n := by
  have h1 : ap.pl.wA * axQ6 P n src k ≤ ap.pl.wA * (3 * pP6 P n) := Nat.mul_le_mul_left _ h.Qp
  have h2 : ap.pl.wC ≤ ap.pl.wC * pP6 P n := Nat.le_mul_of_pos_right _ h.p1
  show ap.pl.wA * axQ6 P n src k + ap.pl.wC ≤ (3 * ap.pl.wA + ap.pl.wC) * pP6 P n
  nlinarith

theorem p2 : 2 ≤ pP6 P n := by
  have h2 : 2 * TP6 P n < 2 ^ pP6 P n := Nat.size_le.1 h.sizeT
  have hT := h.p1.trans h.pT
  by_contra hc
  have : 2 ^ pP6 P n ≤ 2 ^ 1 := Nat.pow_le_pow_right (by norm_num) (by omega)
  have e : (2 : ℕ) ^ 1 = 2 := by norm_num
  omega

theorem n1_sol_aux :
    (axwd6 P n src k ap + 1) * (axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k + 1) *
        (axfC6 P n + 1) +
      (Nat.size (axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k) +
        axwd6 P n src k ap + axfC6 P n + 4) ^ 2 ≤
      7 * (Wc ap + 9) ^ 2 * (TP6 P n * pP6 P n * (Nat.log 2 (bP6 n) + 1)) := by
  have hw := wd_le ap h
  have hV : axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k ≤ TP6 P n := by
    rw [← h.lamC]; exact h.VC
  have hsz : Nat.size (axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k) ≤ pP6 P n :=
    (Nat.size_le_size (hV.trans (by omega))).trans h.sizeT
  have hf := h.fC
  have hβ := h.βp
  have hpT := h.pT
  have hp1 := h.p1
  have hp2 := p2 h
  generalize axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k = V at *
  generalize axwd6 P n src k ap = wd at *
  generalize axfC6 P n = f at *
  generalize Nat.log 2 (bP6 n) = β at *
  generalize TP6 P n = T at *
  generalize pP6 P n = p at *
  generalize Wc ap = W at *
  have eW1 : (W + 1) * p = W * p + p := by ring
  have eW9 : (W + 9) * p = W * p + 9 * p := by ring
  have a1 : (wd + 1) * (V + 1) * (f + 1) ≤ ((W + 1) * p) * (2 * T) * (3 * (β + 1)) :=
    Nat.mul_le_mul (Nat.mul_le_mul (by rw [eW1]; omega) (by omega)) (by omega)
  have a2 : (Nat.size V + wd + f + 4) ^ 2 ≤ ((W + 9) * p) ^ 2 :=
    Nat.pow_le_pow_left (by rw [eW9]; omega) 2
  have a3 : ((W + 9) * p) ^ 2 ≤ (W + 9) ^ 2 * (T * p * (β + 1)) := by
    have : p * p ≤ T * p * (β + 1) := by
      calc p * p ≤ T * p := Nat.mul_le_mul_right _ hpT
        _ ≤ T * p * (β + 1) := Nat.le_mul_of_pos_right _ (by omega)
    calc ((W + 9) * p) ^ 2 = (W + 9) ^ 2 * (p * p) := by ring
      _ ≤ _ := Nat.mul_le_mul_left _ this
  have a4 : ((W + 1) * p) * (2 * T) * (3 * (β + 1)) ≤ 6 * (W + 9) ^ 2 * (T * p * (β + 1)) := by
    have : W + 1 ≤ (W + 9) ^ 2 := le_trans (by omega) (Nat.le_self_pow (by norm_num) _)
    calc ((W + 1) * p) * (2 * T) * (3 * (β + 1)) = 6 * (W + 1) * (T * p * (β + 1)) := by ring
      _ ≤ 6 * (W + 9) ^ 2 * (T * p * (β + 1)) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
  calc _ ≤ ((W + 1) * p) * (2 * T) * (3 * (β + 1)) + ((W + 9) * p) ^ 2 := Nat.add_le_add a1 a2
    _ ≤ 6 * (W + 9) ^ 2 * (T * p * (β + 1)) + (W + 9) ^ 2 * (T * p * (β + 1)) :=
        Nat.add_le_add a4 a3
    _ = _ := by ring

end ax

end J6Seg.Side
end

