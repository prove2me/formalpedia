theorem iso_refl {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S) :
    PolarisedAbelianScheme.Iso u u := by
  refine ⟨Iso.refl u.A, Category.id_comp _, ?_, ?_, ?_⟩
  · intro T t x y
    simp only [Iso.refl_hom, Category.comp_id, Subtype.coe_eta]
  · intro i; rw [Iso.refl_hom, Category.comp_id]
  · intro s
    refine ⟨⊤, trivial, ⟨(Scheme.Modules.pullback (u.f ⁻¹ᵁ ⊤).ι).mapIso ?_⟩⟩
    rw [Iso.refl_hom]
    exact (Scheme.Modules.pullbackId u.A).app u.pol

theorem exists_isPullback {g d n : ℕ} {Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop}
    (hQbc : ∀ {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
      (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S'),
      PolarisedAbelianScheme.IsPullback φ u u' → Q S u → Q S' u')
    {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S') (X : PolarisedAbelianScheme.Satisfying g d n Q S) :
    ∃ X' : PolarisedAbelianScheme.Satisfying g d n Q S', PolarisedAbelianScheme.IsPullback φ X.val X'.val := by
  obtain ⟨u', h⟩ := PolarisedAbelianScheme.exists_isPullback_univ φ X.val
  exact ⟨⟨u', hQbc φ X.val u' h X.prop⟩, h⟩

theorem iso_of_isPullback_of_isPullback {g d n : ℕ} {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
    (u : PolarisedAbelianScheme g d n S) (v₁ v₂ : PolarisedAbelianScheme g d n S')
    (h₁ : PolarisedAbelianScheme.IsPullback φ u v₁) (h₂ : PolarisedAbelianScheme.IsPullback φ u v₂) :
    PolarisedAbelianScheme.Iso v₁ v₂ :=
  PolarisedAbelianScheme.iso_of_isPullback_of_isPullback_of_iso φ h₁ h₂ (iso_refl u)

theorem key_eq {g d n : ℕ} {Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop}
    (hQbc : ∀ {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
      (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S'),
      PolarisedAbelianScheme.IsPullback φ u u' → Q S u → Q S' u')
    (𝒪 : Type) [CommRing 𝒪] (𝒪' : Type) [CommRing 𝒪'] [Algebra 𝒪 𝒪']
    (M' : Scheme.{0}) (πM' : M' ⟶ Spec (CommRingCat.of 𝒪'))
    (pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪')),
      PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM')
    (hM' : PolarisedAbelianScheme.Satisfying.IsFineModuli g d n Q M' πM' pt')
    (M : Scheme.{0}) (q : M' ⟶ M)
    (hind : ∀ (S : Type) [CommRing S] (s₁ s₂ : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪'))
      (_ : s₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')) = s₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')))
      (X : PolarisedAbelianScheme.Satisfying g d n Q S), (pt' S s₁ X).1 ≫ q = (pt' S s₂ X).1 ≫ q)
    {S S' S'' : Type} [CommRing S] [CommRing S'] [CommRing S''] (φ : S →+* S') (iL iR : S' →+* S'')
    (hLR : iL.comp φ = iR.comp φ)
    (s' : Spec (CommRingCat.of S') ⟶ Spec (CommRingCat.of 𝒪'))
    (hs : (Spec.map (CommRingCat.ofHom iL) ≫ s') ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')) =
      (Spec.map (CommRingCat.ofHom iR) ≫ s') ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')))
    (X : PolarisedAbelianScheme.Satisfying g d n Q S)
    (X' : PolarisedAbelianScheme.Satisfying g d n Q S')
    (hX' : PolarisedAbelianScheme.IsPullback φ X.val X'.val) :
    Spec.map (CommRingCat.ofHom iL) ≫ (pt' S' s' X').1 ≫ q = Spec.map (CommRingCat.ofHom iR) ≫ (pt' S' s' X').1 ≫ q := by
  obtain ⟨X₁, hX₁⟩ := exists_isPullback hQbc iL X'
  obtain ⟨X₂, hX₂⟩ := exists_isPullback hQbc iR X'
  have e1 := hM'.pt_pullback S' S'' iL s' (Spec.map (CommRingCat.ofHom iL) ≫ s') rfl X' X₁ hX₁
  have e2 := hM'.pt_pullback S' S'' iR s' (Spec.map (CommRingCat.ofHom iR) ≫ s') rfl X' X₂ hX₂
  have h1 : PolarisedAbelianScheme.IsPullback (iL.comp φ) X.val X₁.val :=
    PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hX' hX₁
  have h2 : PolarisedAbelianScheme.IsPullback (iL.comp φ) X.val X₂.val :=
    (PolarisedAbelianScheme.IsPullback.congr_and_id).1 _ _ _ _ hLR.symm
      (PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hX' hX₂)
  have hiso : PolarisedAbelianScheme.Iso X₁.val X₂.val := iso_of_isPullback_of_isPullback _ _ _ _ h1 h2
  have e3 : pt' S'' (Spec.map (CommRingCat.ofHom iL) ≫ s') X₁ = pt' S'' (Spec.map (CommRingCat.ofHom iL) ≫ s') X₂ :=
    hM'.pt_iso S'' _ X₁ X₂ hiso
  have e4 := hind S'' _ _ hs X₂
  rw [← Category.assoc, ← e1, ← Category.assoc (Spec.map (CommRingCat.ofHom iR)), ← e2, congrArg Subtype.val e3, e4]

structure Ctx (g d n : ℕ) (Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop)
    (𝒪 : Type) [CommRing 𝒪] (𝒪' : Type) [CommRing 𝒪'] [Algebra 𝒪 𝒪']
    (M' : Scheme.{0}) (πM' : M' ⟶ Spec (CommRingCat.of 𝒪'))
    (pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪')),
      PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM')
    (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of 𝒪)) (q : M' ⟶ M) : Prop where
  hQbc : ∀ {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
      (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S'),
      PolarisedAbelianScheme.IsPullback φ u u' → Q S u → Q S' u'
  hQiso : ∀ {S : Type} [CommRing S] (u u' : PolarisedAbelianScheme g d n S),
      PolarisedAbelianScheme.Iso u u' → Q S u → Q S u'
  hM' : PolarisedAbelianScheme.Satisfying.IsFineModuli g d n Q M' πM' pt'
  hq : CategoryTheory.IsPullback q πM' πM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')))
  hind : ∀ (S : Type) [CommRing S] (s₁ s₂ : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪'))
      (_ : s₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')) = s₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')))
      (X : PolarisedAbelianScheme.Satisfying g d n Q S), (pt' S s₁ X).1 ≫ q = (pt' S s₂ X).1 ≫ q

section
variable {g d n : ℕ} {Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop}
  {𝒪 : Type} [CommRing 𝒪] {𝒪' : Type} [CommRing 𝒪'] [Algebra 𝒪 𝒪'] [Module.FaithfullyFlat 𝒪 𝒪']
  {M' : Scheme.{0}} {πM' : M' ⟶ Spec (CommRingCat.of 𝒪')}
  {pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪')),
      PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM'}
  {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of 𝒪)} {q : M' ⟶ M}

@[reducible] noncomputable def sR (𝒪 : Type) [CommRing 𝒪] (𝒪' : Type) [CommRing 𝒪'] [Algebra 𝒪 𝒪'] (S : Type) [CommRing S] [Algebra 𝒪 S] :
    Spec (CommRingCat.of (S ⊗[𝒪] 𝒪')) ⟶ Spec (CommRingCat.of 𝒪') :=
  Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : 𝒪' →ₐ[𝒪] S ⊗[𝒪] 𝒪').toRingHom)

@[reducible] noncomputable def pL (𝒪 : Type) [CommRing 𝒪] (𝒪' : Type) [CommRing 𝒪'] [Algebra 𝒪 𝒪'] (S : Type) [CommRing S] [Algebra 𝒪 S] :
    Spec (CommRingCat.of (S ⊗[𝒪] 𝒪')) ⟶ Spec (CommRingCat.of S) :=
  Spec.map (CommRingCat.ofHom (algebraMap S (S ⊗[𝒪] 𝒪')))

omit [Module.FaithfullyFlat 𝒪 𝒪'] in
theorem sR_comp (S : Type) [CommRing S] [Algebra 𝒪 S] :
    sR 𝒪 𝒪' S ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')) =
      pL 𝒪 𝒪' S ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S)) := by
  simp only [sR, pL, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
  congr 2
  exact (Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap (R := 𝒪) (A := S) (B := 𝒪')).symm

theorem existsUnique_point (H : Ctx g d n Q 𝒪 𝒪' M' πM' pt' M πM q)
    (S : Type) [CommRing S] [Algebra 𝒪 S]
    (X : PolarisedAbelianScheme.Satisfying g d n Q S) (X' : PolarisedAbelianScheme.Satisfying g d n Q (S ⊗[𝒪] 𝒪'))
    (hX' : PolarisedAbelianScheme.IsPullback (algebraMap S (S ⊗[𝒪] 𝒪')) X.val X'.val) :
    ∃! φ : Spec (CommRingCat.of S) ⟶ M, pL 𝒪 𝒪' S ≫ φ = (pt' (S ⊗[𝒪] 𝒪') (sR 𝒪 𝒪' S) X').1 ≫ q := by
  have hLR : (Algebra.TensorProduct.includeLeftRingHom : S ⊗[𝒪] 𝒪' →+* (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).comp
        (algebraMap S (S ⊗[𝒪] 𝒪')) =
      (Algebra.TensorProduct.includeRight :
        S ⊗[𝒪] 𝒪' →ₐ[S] (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).toRingHom.comp (algebraMap S (S ⊗[𝒪] 𝒪')) :=
    Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have hcov : Spec.map (CommRingCat.ofHom (R := S ⊗[𝒪] 𝒪') (S := (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪'))
        Algebra.TensorProduct.includeLeftRingHom) ≫ pL 𝒪 𝒪' S =
      Spec.map (CommRingCat.ofHom (R := S ⊗[𝒪] 𝒪') (S := (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪'))
        (Algebra.TensorProduct.includeRight : S ⊗[𝒪] 𝒪' →ₐ[S] (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).toRingHom) ≫
        pL 𝒪 𝒪' S := by
    simp only [pL, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hLR]
  refine AlgebraicGeometry.existsUnique_comp_eq_of_isPullback_of_faithfullyFlat (S := S) (S' := S ⊗[𝒪] 𝒪')
    (𝟙 _) (𝟙 _) (pL 𝒪 𝒪' S) (IsPullback.of_vert_isIso ⟨by simp⟩) (𝟙 _) _ _
    (IsPullback.of_vert_isIso ⟨by simp⟩) (IsPullback.of_vert_isIso ⟨by simp⟩) hcov _ ?_
  refine key_eq H.hQbc 𝒪 𝒪' M' πM' pt' H.hM' M q H.hind (algebraMap S (S ⊗[𝒪] 𝒪')) _ _ hLR (sR 𝒪 𝒪' S) ?_ X X' hX'
  rw [Category.assoc, Category.assoc, sR_comp, ← Category.assoc, ← Category.assoc, hcov]

end

section
variable {g d n : ℕ} {Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop}
  {𝒪 : Type} [CommRing 𝒪] {𝒪' : Type} [CommRing 𝒪'] [Algebra 𝒪 𝒪'] [Module.FaithfullyFlat 𝒪 𝒪']
  {M' : Scheme.{0}} {πM' : M' ⟶ Spec (CommRingCat.of 𝒪')}
  {pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪')),
      PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM'}
  {M : Scheme.{0}} {πM : M ⟶ Spec (CommRingCat.of 𝒪)} {q : M' ⟶ M}

omit [Module.FaithfullyFlat 𝒪 𝒪'] in

theorem pt'_comp_q_comp (H : Ctx g d n Q 𝒪 𝒪' M' πM' pt' M πM q) (S : Type) [CommRing S] [Algebra 𝒪 S]
    (X' : PolarisedAbelianScheme.Satisfying g d n Q (S ⊗[𝒪] 𝒪')) :
    (pt' (S ⊗[𝒪] 𝒪') (sR 𝒪 𝒪' S) X').1 ≫ q ≫ πM = pL 𝒪 𝒪' S ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S)) := by
  rw [H.hq.w, ← Category.assoc, (pt' (S ⊗[𝒪] 𝒪') (sR 𝒪 𝒪' S) X').2, sR_comp]

theorem cancel_pL (S : Type) [CommRing S] [Algebra 𝒪 S] {Y : Scheme.{0}} (φ₁ φ₂ : Spec (CommRingCat.of S) ⟶ Y)
    (h : pL 𝒪 𝒪' S ≫ φ₁ = pL 𝒪 𝒪' S ≫ φ₂) : φ₁ = φ₂ := by
  have hLR : (Algebra.TensorProduct.includeLeftRingHom : S ⊗[𝒪] 𝒪' →+* (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).comp
        (algebraMap S (S ⊗[𝒪] 𝒪')) =
      (Algebra.TensorProduct.includeRight :
        S ⊗[𝒪] 𝒪' →ₐ[S] (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).toRingHom.comp (algebraMap S (S ⊗[𝒪] 𝒪')) :=
    Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have hcov : Spec.map (CommRingCat.ofHom (R := S ⊗[𝒪] 𝒪') (S := (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪'))
        Algebra.TensorProduct.includeLeftRingHom) ≫ pL 𝒪 𝒪' S =
      Spec.map (CommRingCat.ofHom (R := S ⊗[𝒪] 𝒪') (S := (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪'))
        (Algebra.TensorProduct.includeRight : S ⊗[𝒪] 𝒪' →ₐ[S] (S ⊗[𝒪] 𝒪') ⊗[S] (S ⊗[𝒪] 𝒪')).toRingHom) ≫
        pL 𝒪 𝒪' S := by
    simp only [pL, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hLR]
  have hu := AlgebraicGeometry.existsUnique_comp_eq_of_isPullback_of_faithfullyFlat (S := S) (S' := S ⊗[𝒪] 𝒪')
    (𝟙 _) (𝟙 _) (pL 𝒪 𝒪' S) (IsPullback.of_vert_isIso ⟨by simp⟩) (𝟙 _) _ _
    (IsPullback.of_vert_isIso ⟨by simp⟩) (IsPullback.of_vert_isIso ⟨by simp⟩) hcov (pL 𝒪 𝒪' S ≫ φ₂)
    (by rw [← Category.assoc, hcov, Category.assoc])
  exact hu.unique h rfl

theorem exists_pt (H : Ctx g d n Q 𝒪 𝒪' M' πM' pt' M πM q)
    (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪))
    (X : PolarisedAbelianScheme.Satisfying g d n Q S) :
    letI : Algebra 𝒪 S := (Spec.preimage s).hom.toAlgebra
    ∃ φ : Spec (CommRingCat.of S) ⟶ M, φ ≫ πM = s ∧
      ∀ (X' : PolarisedAbelianScheme.Satisfying g d n Q (S ⊗[𝒪] 𝒪')),
        PolarisedAbelianScheme.IsPullback (algebraMap S (S ⊗[𝒪] 𝒪')) X.val X'.val →
        pL 𝒪 𝒪' S ≫ φ = (pt' (S ⊗[𝒪] 𝒪') (sR 𝒪 𝒪' S) X').1 ≫ q := by
  letI : Algebra 𝒪 S := (Spec.preimage s).hom.toAlgebra
  have hs : Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S)) = s := by
    change Spec.map (CommRingCat.ofHom (Spec.preimage s).hom) = s
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  obtain ⟨X', hX'⟩ := exists_isPullback H.hQbc (algebraMap S (S ⊗[𝒪] 𝒪')) X
  obtain ⟨φ, hφ, -⟩ := existsUnique_point H S X X' hX'
  refine ⟨φ, ?_, fun X'' hX'' => ?_⟩
  · apply cancel_pL (𝒪 := 𝒪) (𝒪' := 𝒪') S
    rw [← Category.assoc, hφ, Category.assoc, pt'_comp_q_comp H, hs]
  · rw [hφ]
    have hiso : PolarisedAbelianScheme.Iso X'.val X''.val := iso_of_isPullback_of_isPullback _ _ _ _ hX' hX''
    rw [H.hM'.pt_iso _ _ X' X'' hiso]

end

section
variable {g d n : ℕ}

theorem descent_datum {S : Type} [CommRing S] (S' : Type) [CommRing S'] [Algebra S S']
    (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S')
    (hu' : PolarisedAbelianScheme.IsPullback (algebraMap S S') u u')
    (v₁ v₂ : PolarisedAbelianScheme g d n (S' ⊗[S] S'))
    (h₁ : PolarisedAbelianScheme.IsPullback
      (Algebra.TensorProduct.includeLeft : S' →ₐ[S] S' ⊗[S] S').toRingHom u' v₁)
    (h₂ : PolarisedAbelianScheme.IsPullback
      (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom u' v₂) :
    PolarisedAbelianScheme.Iso v₁ v₂ := by
  have hLR : (Algebra.TensorProduct.includeLeft : S' →ₐ[S] S' ⊗[S] S').toRingHom.comp (algebraMap S S') =
      (Algebra.TensorProduct.includeRight : S' →ₐ[S] S' ⊗[S] S').toRingHom.comp (algebraMap S S') := by
    rw [AlgHom.toRingHom_eq_coe, AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap, AlgHom.comp_algebraMap]
  have k₁ := PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hu' h₁
  have k₂ := (PolarisedAbelianScheme.IsPullback.congr_and_id).1 _ _ _ _ hLR.symm
    (PolarisedAbelianScheme.IsPullback.trans _ _ _ _ _ hu' h₂)
  exact iso_of_isPullback_of_isPullback _ _ _ _ k₁ k₂

end

end D3Aux

open D3Aux

theorem solution
    (g d n : ℕ) (Q : ∀ (S : Type) [CommRing S], PolarisedAbelianScheme g d n S → Prop)
    (hQbc : ∀ {S S' : Type} [CommRing S] [CommRing S'] (φ : S →+* S')
      (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n S'),
      PolarisedAbelianScheme.IsPullback φ u u' → Q S u → Q S' u')
    (hQiso : ∀ {S : Type} [CommRing S] (u u' : PolarisedAbelianScheme g d n S),
      PolarisedAbelianScheme.Iso u u' → Q S u → Q S u')
    (hn : 3 ≤ n) (𝒪 : Type) [CommRing 𝒪] (hn' : IsUnit ((n : ℕ) : 𝒪))
    (𝒪' : Type) [CommRing 𝒪'] [Algebra 𝒪 𝒪'] [Module.FaithfullyFlat 𝒪 𝒪']
    (hQdesc : ∀ (S : Type) [CommRing S] [Algebra 𝒪 S]
      (u : PolarisedAbelianScheme g d n S) (u' : PolarisedAbelianScheme g d n (S ⊗[𝒪] 𝒪')),
      PolarisedAbelianScheme.IsPullback (algebraMap S (S ⊗[𝒪] 𝒪')) u u' → Q (S ⊗[𝒪] 𝒪') u' → Q S u)

    (M' : Scheme.{0}) (πM' : M' ⟶ Spec (CommRingCat.of 𝒪'))
    (pt' : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪')),
      PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM')
    (hM' : PolarisedAbelianScheme.Satisfying.IsFineModuli g d n Q M' πM' pt')

    (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of 𝒪)) (q : M' ⟶ M)
    (hq : CategoryTheory.IsPullback q πM' πM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪'))))

    (hind : ∀ (S : Type) [CommRing S] (s₁ s₂ : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪'))
      (_ : s₁ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')) = s₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap 𝒪 𝒪')))
      (X : PolarisedAbelianScheme.Satisfying g d n Q S), (pt' S s₁ X).1 ≫ q = (pt' S s₂ X).1 ≫ q) :
    ∃ pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
        PolarisedAbelianScheme.Satisfying g d n Q S → SchemeHomOver s πM,
      PolarisedAbelianScheme.Satisfying.IsFineModuli g d n Q M πM pt  := by
  classical
  have H : D3Aux.Ctx g d n Q 𝒪 𝒪' M' πM' pt' M πM q := ⟨hQbc, hQiso, hM', hq, hind⟩
  choose ptf hover hchar using fun (S : Type) (i : CommRing S) => @D3Aux.exists_pt g d n Q 𝒪 _ 𝒪' _ _ _ M' πM' pt' M πM q H S i
  refine ⟨fun S _ s X => ⟨ptf S _ s X, hover S _ s X⟩, ?_, ?_, ?_, ?_⟩
  ·
    intro S _ s X Y hXY
    letI : Algebra 𝒪 S := (Spec.preimage s).hom.toAlgebra
    apply Subtype.ext
    apply D3Aux.cancel_pL (𝒪 := 𝒪) (𝒪' := 𝒪') S
    obtain ⟨X', hX'⟩ := D3Aux.exists_isPullback hQbc (algebraMap S (S ⊗[𝒪] 𝒪')) X
    obtain ⟨Y', hY'⟩ := D3Aux.exists_isPullback hQbc (algebraMap S (S ⊗[𝒪] 𝒪')) Y
    have hiso : PolarisedAbelianScheme.Iso X'.val Y'.val :=
      PolarisedAbelianScheme.iso_of_isPullback_of_isPullback_of_iso _ hX' hY' hXY
    change D3Aux.pL 𝒪 𝒪' S ≫ ptf S _ s X = D3Aux.pL 𝒪 𝒪' S ≫ ptf S _ s Y
    rw [hchar S _ s X X' hX', hchar S _ s Y Y' hY', hM'.pt_iso _ _ X' Y' hiso]
  ·
    intro S T _ _ φ s t hst X Y hXY
    letI aS : Algebra 𝒪 S := (Spec.preimage s).hom.toAlgebra
    letI aT : Algebra 𝒪 T := (Spec.preimage t).hom.toAlgebra
    have hφ : φ.comp (algebraMap 𝒪 S) = algebraMap 𝒪 T := by
      have h1 : Spec.map (CommRingCat.ofHom (φ.comp (algebraMap 𝒪 S))) =
          Spec.map (CommRingCat.ofHom (algebraMap 𝒪 T)) := by
        rw [CommRingCat.ofHom_comp, Spec.map_comp]
        change Spec.map (CommRingCat.ofHom φ) ≫ Spec.map (CommRingCat.ofHom (Spec.preimage s).hom) =
          Spec.map (CommRingCat.ofHom (Spec.preimage t).hom)
        rw [CommRingCat.ofHom_hom, CommRingCat.ofHom_hom, Spec.map_preimage, Spec.map_preimage, hst]
      have h2 := congrArg CommRingCat.Hom.hom (Spec.map_injective h1)
