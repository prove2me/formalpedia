theorem ChartSpec.comap {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    {C : ComponentChart A (fieldBar q M') Fbar} {O : ValuationSubring (fieldBar q M')} {n : ℕ}
    (hC : ChartSpec q M' A C O n) (g : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M')) (hg : g ∈ LevelAuts q M') :
    ChartSpec q M' A (C.comap g) (O.comap g.toAlgHom.toRingHom) n where
  integers_eq := by
    ext f
    rw [ComponentChart.mem_comap_integers, hC.integers_eq]
    rfl
  card_nodes := by rw [ComponentChart.comap_nodes, hC.card_nodes]
  dom_canonical τ hτm hτ := comap_comap_dom_eq_of_integers_eq C hC.dom_canonical g g τ hg hg hτm hτ
  hasPrincipalDivisors := hC.hasPrincipalDivisors
  isRational := hC.isRational
  isCurveOver := hC.isCurveOver
  essFiniteType := hC.essFiniteType
  hasDiscFibres := Plumbing.HasDiscFibres.comap (Plumbing.fieldBar_isRational q M') C g hC.hasDiscFibres

