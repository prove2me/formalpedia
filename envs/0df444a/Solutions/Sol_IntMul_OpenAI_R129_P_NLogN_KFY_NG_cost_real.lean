  have hOv0 : (0 : ℝ) ≤ (((3 * IntMul.OpenAI.R129.dP n + 1) * IntMul.OpenAI.R129.P.NLogN.KFY.overN n + 2 : ℕ) : ℝ) := Nat.cast_nonneg _
