open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections (contract2)
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry.KSData
variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (d p q : Fin 5) :
    ∑ i, ksMetric b v k d i x * ksC b bi v k i p q x =
      (nablaH b bi v k x q d p + nablaH b bi v k x p d q - nablaH b bi v k x d p q) / 2 := by
  have h1 : ∑ i, ksMetric b v k d i x * ksC b bi v k i p q x =
      ∑ i, ksMetric b v k d i x * christoffel (ksMetric b v k) (ksInverse bi v k) i p q x
        - ∑ i, ksMetric b v k d i x * christoffel b bi i p q x := by
    rw [← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun i _ => by simp only [ksC, cdiffOf]; ring
  have h3 : ∑ i, ksMetric b v k d i x * christoffel b bi i p q x =
      ∑ i, b d i x * christoffel b bi i p q x + v x * lowerK b k x d * chrL b bi k x p q := by
    simp only [ksMetric, add_mul, Finset.sum_add_distrib]
    congr 1
    unfold chrL
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring
  rw [h1, lower_christoffel (hD.ks_mul_inv hx) d p q, h3, hD.lower_bchr hx]
  simp only [hD.pd_ks hx, hD.pd_lowerK_eq hx]
  rw [hD.chrL_symm hx q d, hD.chrL_symm hx q p, hD.chrL_symm hx p d]
  unfold nablaH
  ring
