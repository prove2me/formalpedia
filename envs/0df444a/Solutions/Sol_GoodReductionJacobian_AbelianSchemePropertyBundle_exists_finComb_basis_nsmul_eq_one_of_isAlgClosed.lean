theorem solution
    {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle S f)
    (g : ℕ) (hdim : ∀ s : ↥(Spec (CommRingCat.of S)), topologicalKrullDim ↥(f.base ⁻¹' {s}) = g)
    (n : ℕ) (hn : 0 < n) (hunit : IsUnit ((n : ℕ) : S))
    (k : Type) [Field k] [IsAlgClosed k] (sk : S →+* k) :
    ∃ P : Fin (2 * g) → SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f,
      (∀ i, L.nsmul (Spec.map (CommRingCat.ofHom sk)) n (P i) = L.one (Spec.map (CommRingCat.ofHom sk))) ∧
      (∀ c c' : Fin (2 * g) → Fin n,
        L.finComb (Spec.map (CommRingCat.ofHom sk)) P (fun i => (c i : ℕ)) =
          L.finComb (Spec.map (CommRingCat.ofHom sk)) P (fun i => (c' i : ℕ)) → c = c') ∧
      (∀ Q : SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f,
        L.nsmul (Spec.map (CommRingCat.ofHom sk)) n Q = L.one (Spec.map (CommRingCat.ofHom sk)) →
        ∃ c : Fin (2 * g) → Fin n, L.finComb (Spec.map (CommRingCat.ofHom sk)) P (fun i => (c i : ℕ)) = Q) := by
  classical
  haveI : NeZero n := ⟨hn.ne'⟩
  letI : Algebra S k := sk.toAlgebra
  have hsk : algebraMap S k = sk := rfl

  let t : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of S) := Spec.map (CommRingCat.ofHom sk)
  let A' : Scheme.{0} := pullback f t
  let f' : A' ⟶ Spec (CommRingCat.of k) := pullback.snd f t
  let gA : A' ⟶ A := pullback.fst f t
  have hg : IsPullback gA f' f (Spec.map (CommRingCat.ofHom (algebraMap S k))) := IsPullback.of_hasPullback f t
  obtain ⟨L', hL'mul, hL'one, hL'c⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_forall_mul_comp_eq_of_isPullback f f' gA hg L
  have hc' : L'.IsCommutative := hL'c hc
  have hA' : AbelianSchemePropertyBundle k f' := GoodReductionJacobian.AbelianSchemePropertyBundle.of_isPullback hA hg
  have hdim' : ∀ s : ↥(Spec (CommRingCat.of k)), topologicalKrullDim ↥(f'.base ⁻¹' {s}) = g := by
    intro s
    haveI : Smooth f := hA.smooth
    rw [AlgebraicGeometry.topologicalKrullDim_preimage_eq_of_isPullback_of_smooth_of_isConnected f hA.smooth _ f' gA hg s
      (hA.connectedFibres _)]
    exact hdim _

  have hnk : (n : k) ≠ 0 := by
    have := (hunit.map sk).ne_zero
    rwa [map_natCast] at this
  let M := L'.AlgPoints hc' k
  have hcard : ∀ d : ℕ, d ∣ n → Nat.card (Submodule.torsionBy ℤ M d) = d ^ (2 * g) := by
    intro d hd
    have hdk : (d : k) ≠ 0 := by
      intro h0; obtain ⟨m, rfl⟩ := hd; exact hnk (by rw [Nat.cast_mul, h0, zero_mul])
    exact GoodReductionJacobian.RelativeGroupLaw.natCard_torsionBy_algPoints_eq_pow_of_topologicalKrullDim_eq L' hc' hA' g hdim' k d hdk
  obtain ⟨e⟩ := AddCommGroup.nonempty_pi_zmod_addEquiv_torsionBy_of_card_torsionBy_eq_pow (A := M) hn.ne' (2 * g) hcard

  let t' : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of k) := Spec.map (CommRingCat.ofHom (algebraMap k k))
  have ht' : t' = 𝟙 _ := by
    show Spec.map (CommRingCat.ofHom (RingHom.id k)) = 𝟙 _
    rw [CommRingCat.ofHom_id, Spec.map_id]
  have htt : t' ≫ Spec.map (CommRingCat.ofHom (algebraMap S k)) = Spec.map (CommRingCat.ofHom sk) := by
    rw [ht', Category.id_comp]

  let ofA' : SchemeHomOver t' f' → SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f := fun Q' =>
    ⟨Q'.1 ≫ gA, by rw [Category.assoc, hg.w, ← Category.assoc, Q'.2, htt]⟩
  have ofA'_val : ∀ Q', (ofA' Q').1 = Q'.1 ≫ gA := fun _ => rfl
  let toA' : SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f → SchemeHomOver t' f' := fun Q =>
    ⟨hg.lift Q.1 t' (by rw [Q.2, htt]), hg.lift_snd _ _ _⟩
  have of_to : ∀ Q, ofA' (toA' Q) = Q := fun Q => Subtype.ext (hg.lift_fst _ _ _)
  have to_of : ∀ Q', toA' (ofA' Q') = Q' := fun Q' => by
    apply Subtype.ext
    apply hg.hom_ext
    · rw [hg.lift_fst]
    · rw [hg.lift_snd]; exact Q'.2.symm
  have ofA'_inj : Function.Injective ofA' := fun x y h => by rw [← to_of x, ← to_of y, h]
  have ofA'_mul : ∀ x y, ofA' (L'.mul t' x y) = L.mul _ (ofA' x) (ofA' y) := by
    intro x y
    apply Subtype.ext
    rw [ofA'_val, hL'mul t' x y]
    exact val_mul_congr' L htt rfl rfl
  have ofA'_one : ofA' (L'.one t') = L.one _ := by
    apply Subtype.ext
    rw [ofA'_val, hL'one t']
    exact val_one_congr L htt

  letI instG : CommGroup (SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f) := L.pointCommGroup hc _
  let χ : Multiplicative (Fin (2 * g) → ZMod n) →* SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f :=
    { toFun := fun v => ofA' (RelativeGroupLaw.AlgPoints.toPoint ((e (Multiplicative.toAdd v) : Submodule.torsionBy ℤ M n) : M))
      map_one' := by
        show ofA' (RelativeGroupLaw.AlgPoints.toPoint ((e (0 : Fin (2 * g) → ZMod n) : Submodule.torsionBy ℤ M n) : M)) = L.one _
        rw [map_zero, Submodule.coe_zero, RelativeGroupLaw.AlgPoints.toPoint_zero, ofA'_one]
      map_mul' := fun v w => by
        show ofA' (RelativeGroupLaw.AlgPoints.toPoint ((e (Multiplicative.toAdd v + Multiplicative.toAdd w) : Submodule.torsionBy ℤ M n) : M)) =
          L.mul _ (ofA' _) (ofA' _)
        rw [map_add, Submodule.coe_add, RelativeGroupLaw.AlgPoints.toPoint_add, ofA'_mul] }
  have hχ : ∀ v, χ v = ofA' (RelativeGroupLaw.AlgPoints.toPoint ((e (Multiplicative.toAdd v) : Submodule.torsionBy ℤ M n) : M)) :=
    fun v => rfl
  have χ_inj : Function.Injective χ := by
    intro v w h
    rw [hχ, hχ] at h
    have h1 := RelativeGroupLaw.AlgPoints.toPoint_injective (ofA'_inj h)
    have h2 := e.injective (Subtype.ext h1)
    exact Multiplicative.toAdd.injective h2

  let P : Fin (2 * g) → SchemeHomOver (Spec.map (CommRingCat.ofHom sk)) f := fun i => χ (Multiplicative.ofAdd (Pi.single i 1))

  have hfin : ∀ c : Fin (2 * g) → ℕ, L.finComb (Spec.map (CommRingCat.ofHom sk)) P c =
      χ (Multiplicative.ofAdd (fun i => (c i : ZMod n))) := by
    intro c
    show (List.ofFn fun i => P i ^ c i).prod = _
    rw [List.prod_ofFn]
    have hv : (fun i => (c i : ZMod n)) = ∑ i, c i • (Pi.single i (1 : ZMod n)) := by
      funext j
      rw [Finset.sum_apply]
      simp only [Pi.smul_apply, Pi.single_apply, smul_ite, smul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq',
        Finset.mem_univ, if_true, nsmul_eq_mul, mul_one]
    rw [hv, ofAdd_sum, map_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    rw [ofAdd_nsmul, map_pow]
  refine ⟨P, ?_, ?_, ?_⟩
  ·
    intro i
    have h := pow_eq_nsmul L (Spec.map (CommRingCat.ofHom sk)) (P i) n
    rw [← h]
    show (χ (Multiplicative.ofAdd (Pi.single i 1))) ^ n = L.one _
    rw [← map_pow, ← ofAdd_nsmul]
    have h0 : n • (Pi.single i (1 : ZMod n) : Fin (2 * g) → ZMod n) = 0 := by
      funext j; simp [Pi.single_apply, nsmul_eq_mul]
    rw [h0, ofAdd_zero, map_one]
    rfl
  ·
    intro c c' hcc
    rw [hfin, hfin] at hcc
    have h := Multiplicative.ofAdd.injective (χ_inj hcc)
    funext i
    have hi := congrFun h i
    apply Fin.ext
    have := (ZMod.natCast_eq_natCast_iff' (c i) (c' i) n).mp hi
    rwa [Nat.mod_eq_of_lt (c i).isLt, Nat.mod_eq_of_lt (c' i).isLt] at this
  ·
    intro Q hQ
    let Q' := toA' Q
    let x : M := RelativeGroupLaw.AlgPoints.ofPoint Q'

    have toA'_mul : ∀ X Y, toA' (L.mul _ X Y) = L'.mul t' (toA' X) (toA' Y) := by
      intro X Y
      apply ofA'_inj
      rw [of_to, ofA'_mul, of_to, of_to]
    have toA'_one : toA' (L.one _) = L'.one t' := by
      apply ofA'_inj; rw [of_to, ofA'_one]
    have toA'_nsmul : ∀ (m : ℕ) X, toA' (L.nsmul _ m X) = L'.nsmul t' m (toA' X) := by
      intro m X
      induction m with
