/-!
# B-line IL, pre-tables (B5), part 13: the block iteration (pure)

`bst e x` is the start of the block after the one at `x` (or `x` itself once `x ≥ e`);
`blFrom_succ`: one more round of fuel appends the block at `bst^[k] st` (if `< e`), and
`bst_iter_eq`: `bst^[k] st = st + Σ lengths`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.PreT

open IntMul IntMul.HvdH

section pure
variable (sN tN lam : ℕ)

theorem blFrom_succ (e : ℕ) : ∀ (k st : ℕ),
    J6Seg.blFrom sN tN lam e (k + 1) st = J6Seg.blFrom sN tN lam e k st ++ bAdd sN tN lam e st k
  | 0, st => by
    by_cases h : st < e <;> simp [J6Seg.blFrom, bAdd, h]
  | k + 1, st => by
    by_cases h : st < e
    · have ih := blFrom_succ e k (st + 1 + J6Seg.enF sN tN lam st)
      have hb : (bst sN tN lam e)^[k + 1] st =
          (bst sN tN lam e)^[k] (st + 1 + J6Seg.enF sN tN lam st) := by
        rw [Function.iterate_succ_apply]; simp [bst, h]
      rw [J6Seg.blFrom, if_pos h, ih, J6Seg.blFrom, if_pos h]
      simp only [bAdd, hb, List.cons_append]
    · have hfix : ∀ j, (bst sN tN lam e)^[j] st = st := by
        intro j
        exact Function.iterate_fixed (by simp [bst, h]) j
      rw [J6Seg.blFrom, if_neg h, J6Seg.blFrom, if_neg h]
      simp [bAdd, hfix, h]

theorem bst_iter_eq (e st : ℕ) : ∀ k,
    (bst sN tN lam e)^[k] st = st + sumL (J6Seg.blFrom sN tN lam e k st)
  | 0 => by simp [J6Seg.blFrom, sumL]
  | k + 1 => by
    have ih := bst_iter_eq e st k
    rw [blFrom_succ, Function.iterate_succ_apply']
    simp only [bAdd, sumL, List.map_append, List.sum_append] at ih ⊢
    rw [← add_assoc, ← ih]
    set x := (bst sN tN lam e)^[k] st
    simp only [bst]
    split_ifs with h <;> simp <;> omega

theorem blFrom_len (e : ℕ) : ∀ k st, (J6Seg.blFrom sN tN lam e k st).length ≤ k
  | 0, _ => by simp [J6Seg.blFrom]
  | k + 1, st => by
    simp only [J6Seg.blFrom]
    split_ifs
    · simp only [List.length_cons]; have := blFrom_len e k (st + 1 + J6Seg.enF sN tN lam st); omega
    · simp

theorem bst_iter_le {e st : ℕ} (he : e ≤ sN) : ∀ k, (bst sN tN lam e)^[k] st ≤ max st sN
  | 0 => by simp
  | k + 1 => by
    rw [Function.iterate_succ_apply']
    have ih := bst_iter_le (st := st) he k
    set x := (bst sN tN lam e)^[k] st
    simp only [bst]
    split_ifs with h
    · have := J6Seg.en_le_s (s := sN) (t := tN) (lam := lam) (c := x) (by omega)
      omega
    · exact ih

end pure

end J6Seg.PreT

