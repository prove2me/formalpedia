variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem πR_none {c r KG B BJ D2 : ℤ} {i : Fin HS} (h : i.val < 50 ∨ 55 < i.val) :
    πR c r KG B BJ D2 i = none := by
  unfold πR
  simp only [pmOf]
  split_ifs with h1 h2 h3 h4 h5 h6 <;> first | rfl | (subst_vars; revert h; decide)

theorem πR_some {c r KG B BJ D2 : ℤ} {i : Fin HS} {v : ℤ} (h : πR c r KG B BJ D2 i = some v) :
    50 ≤ i.val ∧ i.val ≤ 55 := by
  by_contra hc
  rw [πR_none (by omega)] at h
  simp at h

/-- Codes that write no stack in `50 … 55`. -/
theorem NW_R {c r KG B BJ D2 : ℤ} {cd : IStmt HS Pp} (hc : nc cd = true)
    (h : ∀ i ∈ wl cd, i.val < 50 ∨ 55 < i.val) : NW (πR c r KG B BJ D2) cd :=
  NW_of _ hc fun i hi => πR_none (h i hi)

theorem NW_fcodeR {c r KG B BJ D2 : ℤ} {p : RS} (h : ∀ j ∈ p.writes, j.val < 50) :
    NW (πR c r KG B BJ D2) (fcode p : IStmt HS Pp) := by
  refine NW_fcode fun i v hv => ?_
  have := πR_some hv
  refine ⟨fun hm => by have := h i hm; omega, by omega, ?_⟩
  unfold ulS; omega

theorem nc_rpt (A C D : Fin HS) (n : ℕ) {b : IStmt HS Pp} (hb : nc b = true) :
    nc (rpt A C D n b) = true := by
  simp [rpt, nc, pro, epi, uloop, KFC.toUL, KFC.splitL, KFC.bld, KFC.dbl, KFC.clrM, hb]

theorem nc_carI (b r : ℕ) : nc (carI b r : IStmt HS Pp) = true := by
  simp [carI, nc, nc_rpt, c1B, c2B]

theorem allLow_mem {L : List (Fin HS)} (h : allLow L = true) {i : Fin HS} (hi : i ∈ L) :
    i.val < 50 ∨ 55 < i.val := by
  unfold allLow at h; rw [List.all_eq_true] at h; simpa using h i hi

theorem NW_carI {c r' KG B BJ D2 : ℤ} (b r : ℕ) : NW (πR c r' KG B BJ D2) (carI b r : IStmt HS Pp) :=
  NW_R (nc_carI b r) fun i hi => allLow_mem (by
    simp +decide [allLow, carI, rpt, wl, opW, pro, epi, uloop, KFC.toUL, KFC.splitL, KFC.bld, KFC.dbl,
      KFC.clrM, c1B, c2B]) hi

