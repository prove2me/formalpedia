/-- **Theorem 17 for the all-edges host with the true middle dimension**, with `D := ⌊n^{a/b}⌋`
and `g := ⌈D^{c/e}⌉`. -/
theorem claim_ae_theorem_17_mid (a b c e : ℕ) (hb : 1 ≤ b) (he : 1 ≤ e) (hab : a ≤ b)
    (hce : 2 * c ≤ e) :
    Claim.Theorem_17_mid aeModel strassen (fun n => paramDr a b n)
      (fun n => paramGr c e (paramDr a b n)) := by
  have hce' : c ≤ e := by omega
  refine midClaim17_of_host strassen (fun n => paramDr a b n)
    (fun n => paramGr c e (paramDr a b n))
    (midHostTime (paramDr a b) (paramGr c e) (tDr a b) (tGr c e))
    (midHostNeed (paramDr a b) (paramGr c e) (wDr a b) (wGr c e)) (fun Q pS Tn r hr hs => ?_)
    (obeysBound17Mid_midHostTime _ _ (fun _ => rfl) (fun _ _ => rfl)
      (steps_tDr hb hab).withinBuild (steps_tGr he hce').withinBuild)
  have h := mid_solves (P₀ := Q ++ ratParamProcs a b c e Q.length) (hs.append _)
    (paramProc_dr hb Q) (paramProc_gr he Q) (fun _ hn => one_le_paramDr hb hn)
  rw [List.append_assoc] at h
  exact ⟨_, _, h, midHostNeed_poly (polyBounded_paramDr hb hab)
    (polyBounded_paramGr (polyBounded_paramDr hb hab)) (polyBounded_wDr hb hab)
    (polyBounded_wGr hb hab) hr⟩

