/-! Exact variable-certificate closing and identity stages on the prepared workspace fiber. -/
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000
open Matrix
namespace QMAPerfectCompleteness.Main.CertificateBlockCorrectness
open CertificateMasterLayout BlockCompiler BlockCoordinates BlockImplements
variable (V : Verifier gatesG2)





noncomputable def closingLogical (p : Logical V) : Logical V :=
  ((p.1.1,p.1.2.1,p.1.2.2.1,xor p.1.2.2.2
    (Layout.rangeTruth p.2.2.1.val p.2.2.2.val p.1.1.val 4 &&
      (decide (p.1.2.1.val=ell V.proofQubits) && decide (V.proofPart p.1.2.2.1=p.2.1)))),p.2)





noncomputable def identityLogical (p : Logical V) : Logical V :=
  ((p.1.1,p.1.2.1,p.1.2.2.1,xor p.1.2.2.2
    (Layout.rangeTruth p.2.2.1.val p.2.2.2.val p.1.1.val 0)),p.2)





end QMAPerfectCompleteness.Main.CertificateBlockCorrectness


