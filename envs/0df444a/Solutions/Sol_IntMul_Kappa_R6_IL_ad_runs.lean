      rw [ht', encK_G, hF3J]
      simp +decide [ints, s1, hJ])
    (by
      rw [ht', encK_G]
      simp +decide [F3, F2, ints, s1])
    (by
      intro j hj1 hj2
      rw [ht', encK_G]
      simp +decide [F3, F2, F, hj1, hj2, s1])
  rw [h1] at Spre
  -- 7. the pops
  have P1 := Sp.pop (s1.upd 0 Y) F3 (i := dJ) (B := Bb) (by decide) hF3J
    (by rw [zsz_neg]; exact le_trans (zsz_nat_le hM1) hM)
  have hF4 : (Function.update F3 dJ [(k : ℤ)]) dT = [((m ^ k : ℕ) : ℤ)] := by simp +decide [F3, F2]
  have P2 := Sp.pop (s1.upd 0 Y) (Function.update F3 dJ [(k : ℤ)]) (i := dT) (B := Bb) (by decide)
    hF4 (le_trans (zsz_nat_le hkM) hM)
  have e5 : Function.update (Function.update F3 dJ [(k : ℤ)]) dT [] = F := by
    funext j
    by_cases hj : j = dT
    · subst hj; simp +decide [F]
    by_cases hj' : j = dJ
    · subst hj'; simp +decide [F]
    · simp +decide [F3, F2, F, hj, hj']
  have P := P1.seq P2
  rw [e5, h1] at P
  rw [hT X, hT Y]
  have H := (Spre.toIRuns (I := I) (iprog := tab)).seq ((IRuns.call hC).seq
    (P.toIRuns (I := I) (iprog := tab)))
  exact H.mono' rfl (by simp only [cAd, cRep]; omega)

end

