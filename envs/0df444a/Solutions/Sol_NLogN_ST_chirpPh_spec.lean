theorem ceilSqrt_le_iff (x j : ℕ) : ceilSqrt x ≤ j ↔ x ≤ j * j := by
  have h1 := Nat.sqrt_le' x
  have h2 := Nat.lt_succ_sqrt' x
  unfold ceilSqrt
  split_ifs with h
  · constructor
    · intro hj
      have : (x.sqrt + 1) * (x.sqrt + 1) ≤ j * j := Nat.mul_le_mul hj hj
      rw [Nat.succ_eq_add_one, pow_two] at h2; omega
    · intro hj
      by_contra hc
      have : j * j ≤ x.sqrt * x.sqrt := Nat.mul_le_mul (by omega) (by omega)
      omega
  · have hx : x.sqrt * x.sqrt = x := by rw [pow_two] at h1; omega
    constructor
    · intro hj; rw [← hx]; exact Nat.mul_le_mul hj hj
    · intro hj
      by_contra hc
      have : j * j < x.sqrt * x.sqrt := Nat.mul_lt_mul'' (by omega) (by omega)
      omega

end NLogN.CR

