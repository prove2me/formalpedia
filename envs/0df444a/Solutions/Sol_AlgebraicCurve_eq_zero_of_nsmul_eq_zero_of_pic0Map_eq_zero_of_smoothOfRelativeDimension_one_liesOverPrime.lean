    · rw [Category.assoc, IsPullback.isoPullback_hom_snd, hek]
    · rw [Category.assoc, IsPullback.isoPullback_hom_fst]

  haveI := he'iso
  haveI := hek'iso
  obtain ⟨ptsQ, hptsQ_add, hptsQ_aj⟩ := hdict (AlgebraicClosure ℚ) iQ F 𝔐 e' he'snd
  obtain ⟨ptsk, hptsk_add, hptsk_aj⟩ := hdict k ik K 𝔐k ek' hek'snd

  let resQ : SchemeHomOver sO f → SchemeHomOver sQ f :=
    fun w => schemeHomOverComp (Spec.map (CommRingCat.ofHom O.subtype)) hsQ.symm w
  let redk : SchemeHomOver sO f → SchemeHomOver sk f :=
    fun w => schemeHomOverComp (Spec.map (CommRingCat.ofHom res)) hsk.symm w
  have hexu : ∀ z : SchemeHomOver sQ f, ∃! xt : SchemeHomOver sO f, Spec.map (CommRingCat.ofHom O.subtype) ≫ xt.1 = z.1 :=
    fun z => NeronModelInfra.existsUnique_schemeHomOver_comp_eq_of_isProper_valuationSubring O f sO z.1 (by rw [z.2, hsQ])
  let ext : SchemeHomOver sQ f → SchemeHomOver sO f := fun z => (hexu z).exists.choose
  have hext : ∀ z, Spec.map (CommRingCat.ofHom O.subtype) ≫ (ext z).1 = z.1 := fun z => (hexu z).exists.choose_spec
  have hext_uniq : ∀ (z : SchemeHomOver sQ f) (w : SchemeHomOver sO f),
      Spec.map (CommRingCat.ofHom O.subtype) ≫ w.1 = z.1 → w = ext z :=
    fun z w hw => (hexu z).unique hw (hext z)
  have resQ_ext : ∀ z, resQ (ext z) = z := fun z => Subtype.ext (hext z)
