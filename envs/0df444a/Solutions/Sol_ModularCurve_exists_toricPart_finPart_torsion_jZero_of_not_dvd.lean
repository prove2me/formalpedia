theorem eq_nsmul_of_mk_sub_nsmul_mk_eq_zero {M : Type*} [AddCommGroup M]
    (H : AddSubgroup M) {a b : M} (ha : a ∈ H) (hb : b ∈ H) (n : ℕ)
    (h : (⟨a, ha⟩ : ↥H) - n • ⟨b, hb⟩ = 0) : a = n • b := by
  have h' := congrArg Subtype.val h
  rw [AddSubgroup.coe_sub, AddSubgroup.coe_nsmul, AddSubgroup.coe_zero, sub_eq_zero] at h'
  exact h'

