-- Source module: Solutions.J6AMath6
/-!
# A lines (PR #5 block chirp), part 6: `ALineHyp6` from one IL obligation

* `HA6`: the half-block `H = 2^{⌊log₂ m⌋}` (`m = sWidth p α`), so `1 ≤ H ≤ m` and `2H` is a
  power of two.
* `mapsA6`: the machine's `A` line maps, `chirpC` along every axis.
* `AIL6 P tab`: a procedure `eA` turns `gflat zs ++ l` into
  `gflat (tensorGo (mapsA6 …) zs) ++ l`, exactly, at cost `≤ C₀ · cU6 P n A`.
* **`ALineHyp6_of_AIL6`**: `AIL6 P tab → ALineHyp6 P tab` (`P.Ok`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN NLogN.KIL NLogN.KFB AModel
open IntMul.Kappa.R6
open NLogN.KFB (GI gflat)

/-- `35 (2q+1)² ≤ 2^q` for `q ≥ 50`. -/
lemma sq_le_two_pow (q : ℕ) (hq : 50 ≤ q) : 35 * (2 * q + 1) ^ 2 ≤ 2 ^ q := by
  induction q, hq using Nat.le_induction with
  | base => norm_num
  | succ q hq ih =>
    have : (2 * (q + 1) + 1) ^ 2 ≤ 2 * (2 * q + 1) ^ 2 := by nlinarith
    calc 35 * (2 * (q + 1) + 1) ^ 2 ≤ 35 * (2 * (2 * q + 1) ^ 2) := Nat.mul_le_mul_left _ this
      _ = 2 * (35 * (2 * q + 1) ^ 2) := by ring
      _ ≤ 2 * 2 ^ q := by omega
      _ = 2 ^ (q + 1) := by ring

lemma sWidth_le (p α : ℕ) (hp : 1 ≤ p) (hαp : α ^ 2 ≤ p) : sWidth p α ≤ 2 * p := by
  have hc := J6A.ceilSqrt_le p hp
  unfold sWidth
  have : (ceilSqrt p * α) * (ceilSqrt p * α) ≤ (2 * p) * (2 * p) := by
    calc (ceilSqrt p * α) * (ceilSqrt p * α) = (ceilSqrt p * ceilSqrt p) * α ^ 2 := by ring
      _ ≤ (4 * p) * p := Nat.mul_le_mul hc hαp
      _ = (2 * p) * (2 * p) := by ring
  exact Nat.mul_self_le_mul_self_iff.1 this

end J6Seg

end

