/-- **Frame changes in place** on the streams of a duplicate-free list `l`. -/
theorem frames_runs {W v : ℕ} (s : IState HS) (rest : List ℤ) {Bb : ℕ} (hB : TabB W v Bb)
    (codes : Fin W → IStmt HS Pp) (cs : Fin W → ℕ) (G : Fin W → List ℤ) :
    ∀ (l : List (Fin W)) (F : ℕ → List ℤ) (f : Fin HS → List ℤ), l.Nodup → Uni W v F →
      (∀ w ∈ l, (G w).length = v ∧ NLogN.KIL.Bits (G w)) →
      (∀ w ∈ l, ∀ (t : IState HS) (R : List Item), IRuns I iprog (codes w)
        (t.upd 0 (ints (F w) ++ R)) (t.upd 0 (ints (G w) ++ R)) (cs w)) →
      f 0 = tabR 0 W F ++ rest →
      IRuns I iprog (seqL (l.map fun (w : Fin W) => applyC v (w : ℕ) (codes w))) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (tabR 0 W
          (fun n => if h : n < W then (if (⟨n, h⟩ : Fin W) ∈ l then G ⟨n, h⟩ else F n) else F n)
          ++ rest)))
        ((l.map fun (w : Fin W) => cs w + 2 * cOp (W * v) Bb).sum + 1)
  | [], F, f, _, _, _, _, hf => by
    simp only [List.map_nil, seqL, List.sum_nil, Nat.zero_add, List.not_mem_nil, if_false,
      dite_eq_ite, ite_self]
    rw [← hf, Function.update_eq_self]; exact IRuns.skip _
  | w :: l, F, f, hnd, hU, hG, hc, hf => by
    have hw := w.2
    have h1 := applyC_runs (I := I) (iprog := iprog) hU hw (hc w List.mem_cons_self) s f rest hf Bb
      hB.one hB.vol
    have hU' : Uni W v (Function.update F w (G w)) := fun n hn => by
      by_cases e : n = w
      · subst e; simpa using hG w List.mem_cons_self
      · rw [Function.update_of_ne e]; exact hU n hn
    have hnd' := (List.nodup_cons.1 hnd)
    have h2 := frames_runs s rest hB codes cs G l (Function.update F w (G w))
      (Function.update f 0 (tabR 0 W (Function.update F w (G w)) ++ rest)) hnd'.2 hU'
      (fun w' hw' => hG w' (List.mem_cons_of_mem _ hw'))
      (fun w' hw' t R => by
        have hne : (w' : ℕ) ≠ w := fun e => hnd'.1 (by rw [show w' = w from Fin.ext e] at hw'; exact hw')
        rw [Function.update_of_ne hne]
        exact hc w' (List.mem_cons_of_mem _ hw') t R)
      (by simp)
    have H := h1.seq h2
    refine H.mono' ?_ ?_
    · rw [Function.update_idem]
      congr 3
      congr 1
      funext n
      by_cases hn : n < W
      · simp only [dif_pos hn, List.mem_cons]
        by_cases e : (⟨n, hn⟩ : Fin W) ∈ l
        · simp [e]
        · by_cases e' : (⟨n, hn⟩ : Fin W) = w
          · subst e'; simp [e]
          · have : n ≠ (w : ℕ) := fun h => e' (Fin.ext h)
            simp [e, e', Function.update_of_ne this]
      · simp only [dif_neg hn]
        rw [Function.update_of_ne (show n ≠ (w : ℕ) by omega)]
    · have := cMvL_le (Bb := Bb) (show (w : ℕ) * v ≤ W * v from Nat.mul_le_mul_right v hw.le)
      simp only [List.map_cons, List.sum_cons]
      omega

