    {L : ℕ} (s : Finset (Fin L)) (j : Fin L) :
    (if h : s.Nonempty then (s.min' h).succ else
      (0 : Fin (L + 1))) = j.succ ↔
      j ∈ s ∧ ∀ i : Fin L, i < j → i ∉ s := by
  classical
