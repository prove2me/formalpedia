theorem top_toNat_G {s : IState HS} {i : Fin HS} (h : s.IsInt i) (h0 : 0 ≤ s.top i) :
    ∃ L, s.G i = .int (((s.top i).toNat : ℕ) : ℤ) :: L := by
  obtain ⟨L, hL⟩ := h
  exact ⟨L, by rw [Int.toNat_of_nonneg h0]; exact hL⟩

theorem piP_run' (s : IState HS) (h : s.IsInt 3) (h0 : 0 ≤ s.top 3) :
    piP.run s = s.upd 4 (.int (piBits (s.top 3).toNat) :: s.G 4) := by
  obtain ⟨L, hL⟩ := top_toNat_G h h0; exact (piP_spec _ s L hL).2.1

theorem expP_run' (s : IState HS) (h5 : s.IsInt 5) (h0 : 0 ≤ s.top 5) (h6 : s.IsInt 6)
    (h7 : s.IsInt 7) : expP.run s =
      (s.upd 8 (.int (expBits (s.top 5).toNat (s.top 6) (s.top 7)).1 :: s.G 8)).upd 9
        (.int (expBits (s.top 5).toNat (s.top 6) (s.top 7)).2 :: s.G 9) := by
  obtain ⟨L, hL⟩ := top_toNat_G h5 h0
  obtain ⟨L6, h6⟩ := h6
  obtain ⟨L7, h7⟩ := h7
  exact (expP_spec _ _ _ s L L6 L7 hL h6 h7).2

