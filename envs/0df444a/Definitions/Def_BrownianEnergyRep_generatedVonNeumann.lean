-- name    : BrownianEnergyRep_generatedVonNeumann
-- status  : Definition
-- author  : @iris
-- created : 2026-11-04T07:04:01.620894+00:00
-- url     : https://prove2.me/theorems/d18663d9-a964-4973-b274-60d0e8d831ff
-- title:
--   The von Neumann algebras $\mathcal M^R,\mathcal M^L$
-- statement:
--   For a family of unitaries $U_\varphi$, $\varphi\in H(G)$, on $L^2(W(G),\mu)$, this is the von Neumann algebra
--   $$
--   \big(U_\varphi,\ \varphi\in H(G)\big)''
--   $$
--   that they generate. Taking $U=U^R$ or $U=U^L$ gives $\mathcal M^R$ and $\mathcal M^L$.
--
--   **Formalization Note** The set of the $U_\varphi$ is closed under adjoints, so the double commutant in the bounded operators is the generated von Neumann algebra.
-- source:
--   Albeverio, Driver, Gordina, Vershik, Equivalence of the Brownian and energy representations, arXiv:1511.07378v1, Notation 4.5, p.13

import Mathlib
import Definitions.Def_BrownianEnergyRep_MatrixLieAlgebra
import Definitions.Def_BrownianEnergyRep_WienerGroup
import Definitions.Def_BrownianEnergyRep_FiniteEnergy

set_option autoImplicit false

open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology ContDiff RealInnerProductSpace

namespace BrownianEnergyRep

/-- The von Neumann algebra `(U_ϕ, ϕ ∈ H(G))″` generated by the operators `U_ϕ`
(arXiv:1511.07378v1, Notation 4.5, p.13), as a double commutant in the bounded operators on `L²(W(G), μ)`. -/
def generatedVonNeumann {n : ℕ} {G : Subgroup (GL (Fin n) ℝ)} {E : Type*}
    [NormedAddCommGroup E] [InnerProductSpace ℝ E] (L : MatrixLieAlgebra G E)
    {T : ℝ} [Fact (0 < T)] {μ : Measure ↥(WienerGroup G T)}
    (U : ↥(WienerGroup G T) → (Lp ℂ 2 μ ≃ₗᵢ[ℂ] Lp ℂ 2 μ)) : Set (Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ) :=
  Set.centralizer (Set.centralizer
    ((fun ϕ => ((U ϕ).toContinuousLinearEquiv : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ)) '' FiniteEnergy L T))

end BrownianEnergyRep


