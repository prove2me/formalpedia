namespace PebblingLean.Hypercube.LossRecurrence
theorem _root_.solution {next : ℕ → ℕ} {loss : ℕ → ℝ}
    (hloss : ∀ n : ℕ, 0 ≤ loss n) (k n : ℕ) :
    0 ≤ lossProduct next loss k n := by
  induction k generalizing n with
  | zero =>
      simp [lossProduct]
  | succ k ih =>
      exact mul_nonneg (add_nonneg zero_le_one (hloss n)) (ih (next n))
end PebblingLean.Hypercube.LossRecurrence
