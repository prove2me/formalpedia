theorem eq_of_hasDerivAt_slice {W : Set (ℝ × Pt 4)} (hW : IsOpen W) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
    {φ ψ : ℝ → ℂ} {L L' : ℂ} (hφ : HasDerivAt φ L 0) (hψ : HasDerivAt ψ L' 0)
    (h : ∀ ε, (ε, x) ∈ W → φ ε = ψ ε) : L = L' := by
  have hev : φ =ᶠ[𝓝 (0 : ℝ)] ψ := by
    filter_upwards [eventually_mem_of_slice hW hx] with ε hε
    exact h ε hε
  exact hφ.unique (hψ.congr_of_eventuallyEq hev)

