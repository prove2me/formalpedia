import Definitions.Def_KLSModular_FunctionalInequalities_Analysis_Semigroup_Generated_Curvature

open scoped RealInnerProductSpace
variable {H₀ H₁ : Type*} [NormedAddCommGroup H₀] [InnerProductSpace ℝ H₀] [CompleteSpace H₀]
  [NormedAddCommGroup H₁] [InnerProductSpace ℝ H₁] [CompleteSpace H₁]
  (T : H₀ →ₗ.[ℝ] H₁) (hT : T.IsClosed) (hd : Dense (T.domain : Set H₀))

theorem FunctionalInequalities.Analysis.Semigroup.Generated.hasDerivAt_inner_apply_readable (f : (adjointComp T).domain) {s : ℝ} (hs : 0 < s) :
    HasDerivAt (fun r => ⟪apply T hT hd r (adjointComp T f), apply T hT hd r f⟫)
      (-2 * ‖adjointComp T ⟨apply T hT hd s f, preserves_domain T hT hd f hs.le⟩‖ ^ 2) s := by sorry
