variable {P K D S ρ : ℕ}

theorem LImpl.mono {hρ : ρ < K} {r : ℕ} {T : Butterfly.Op (Fin D)} {code : RS} {e dw : ℕ}
    {c c' : ℕ → ℕ} (h : LImpl (P := P) (S := S) hρ r T code e dw c) (hc : ∀ w, c w ≤ c' w) :
    LImpl (P := P) (S := S) hρ r T code e dw c' := by
  intro s f zs l xs F w hC h0 hx hl hb
  obtain ⟨zs', h1, h2, h3⟩ := h s f zs l xs F w hC h0 hx hl hb
  exact ⟨zs', h1, h2, h3.mono (hc w)⟩

theorem LImpl.congrT {hρ : ρ < K} {r : ℕ} {T T' : Butterfly.Op (Fin D)} {code : RS} {e dw : ℕ}
    {c : ℕ → ℕ} (h : LImpl (P := P) (S := S) hρ r T code e dw c) (hT : T = T') :
    LImpl (P := P) (S := S) hρ r T' code e dw c := hT ▸ h

/-- Sequential composition: first `T`, then `U`. -/
theorem LImpl.comp {hρ : ρ < K} {r : ℕ} {T U : Butterfly.Op (Fin D)} {c1 c2 : RS}
    {e1 e2 d1 d2 : ℕ} {k1 k2 : ℕ → ℕ} (h1 : LImpl (P := P) (S := S) hρ r T c1 e1 d1 k1)
    (h2 : LImpl (P := P) (S := S) hρ r U c2 e2 d2 k2) :
    LImpl (P := P) (S := S) hρ r (U * T) (.seq c1 c2) (e1 + e2) (d1 + d2)
      (fun w => k1 w + k2 (w + d1)) := by
  intro s f zs l xs F w hC h0 hx hl hb
  obtain ⟨zs1, r1, b1, f1⟩ := h1 s f zs l xs F w hC h0 hx hl hb
  obtain ⟨zs2, r2, b2, f2⟩ := h2 s (Function.update f 0 (gflat zs1 ++ l)) zs1 l _ (F + e1) (w + d1)
    (hC.upd0 _) (by simp) r1 (Butterfly.length_selOp _ _ _) b1
  refine ⟨zs2, ?_, ?_, ?_⟩
  · rw [← Butterfly.selOp_mul, ← add_assoc]; exact r2
  · rw [← add_assoc]; exact b2
  · have := f1.seq f2
    rwa [Function.update_idem] at this

/-- The identity. -/
theorem limpl_skip (hρ : ρ < K) (r : ℕ) :
    LImpl (P := P) (S := S) hρ r (1 : Butterfly.Op (Fin D)) .skip 0 0 (fun _ => 1) := by
  intro s f zs l xs F w hC h0 hx hl hb
  refine ⟨zs, ?_, hb, ?_⟩
  · rw [Butterfly.selOp_one _ hl]; exact hx
  · have e : Function.update f 0 (gflat zs ++ l) = f := by rw [← h0]; exact Function.update_eq_self 0 f
    rw [e]; exact FSp.skip _

theorem ck_mono {N Z w w' : ℕ} (h : w ≤ w') : ck N Z w ≤ ck N Z w' := by
  unfold ck; gcongr

theorem stT_pos (i : ℕ) (hi : i < D) (hS : 1 ≤ S) : 1 ≤ stT K D S ρ i := by
  rw [stT, stS_eq K D S i hi]
  exact Nat.mul_pos (by positivity) (Nat.mul_pos (by positivity) hS)

theorem grpG_pos (i : ℕ) (hP : 1 ≤ P) : 1 ≤ grpG P K ρ i := by
  unfold grpG; exact Nat.mul_pos (Nat.mul_pos hP (by positivity)) (by positivity)

theorem cQopW_le_ck (G B w Z : ℕ) (hB : 1 ≤ B) : cQopW w B 1 G 0 Z ≤ ck (2 * G * B) Z w := by
  have hGB : G ≤ G * B := Nat.le_mul_of_pos_right _ hB
  unfold cQopW cQop KFB.cBlk ck
  nlinarith

theorem cKer_le (hρ : ρ < K) (i : ℕ) (hi : i < D) {r : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (w Z : ℕ) :
    cKer K D S ρ P r i w Z ≤ ck (vol (Butterfly.layerShape P K D S) * r) Z w := by
  have hG := grpG_mul (P := P) (S := S) hρ i hi
  have hB1 : 1 ≤ stT K D S ρ i * r := Nat.mul_le_mul (stT_pos i hi hS) hr
  have hN : vol (Butterfly.layerShape P K D S) * r = 2 * grpG P K ρ i * (stT K D S ρ i * r) := by
    rw [← hG]; ring
  calc cKer K D S ρ P r i w Z = cQopW w (stT K D S ρ i * r) 1 (grpG P K ρ i) 0 Z := rfl
    _ ≤ ck (2 * grpG P K ρ i * (stT K D S ρ i * r)) Z w := cQopW_le_ck _ _ _ _ hB1
    _ = ck (vol (Butterfly.layerShape P K D S) * r) Z w := by rw [hN]

/-- One kernel pass implements the kernel of `A` on bit `i`. -/
theorem limpl_ker (hρ : ρ < K) (i : Fin D) {r : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P) {M : M2G}
    (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z) :
    LImpl (P := P) (S := S) hρ r (Butterfly.tensF (Butterfly.kerAt i A)) (kerP K D S ρ P r i M) e 2
      (ck (vol (Butterfly.layerShape P K D S) * r) Z) := by
  intro s f zs l xs F w hC h0 hx hl hb
  have hlen : zs.length = vol (Butterfly.layerShape P K D S) * r := by rw [hx.1, hl]
  have hG := grpG_mul (P := P) (S := S) hρ i i.isLt
  have hZ' : zsz ((kerZ K D S ρ P r i : ℕ) : ℤ) ≤ Z := by
    refine le_trans (zsz_natCast_le' ?_) hZ
    have g1 := grpG_pos (K := K) (ρ := ρ) i hP
    have t1 := stT_pos (K := K) (ρ := ρ) i i.isLt hS
    have hB1 : stT K D S ρ i * r ≤ vol (Butterfly.layerShape P K D S) * r := by
      rw [← hG]; apply Nat.mul_le_mul_right; nlinarith
    have hG1 : grpG P K ρ i ≤ vol (Butterfly.layerShape P K D S) * r := by
      rw [← hG]; nlinarith
    have h3 : grpG P K ρ i * (2 * (stT K D S ρ i * r) * 1) = vol (Butterfly.layerShape P K D S) * r := by
      rw [← hG]; ring
    simp only [kerZ]; omega
  obtain ⟨H, hb'⟩ := kerP_fsp s hρ i hM f zs l hlen h0 hC hb Z hZ'
  exact ⟨_, ker_rep hρ i hA hx hl, hb', H.mono (cKer_le hρ i i.isLt hr hS w Z)⟩

theorem fok_kersP (K D S ρ P r : ℕ) (M : M2G) : ∀ l, NLogN.KFD.fok (kersP K D S ρ P r M l) = true
  | [] => rfl
  | i :: l => by simp [kersP, NLogN.KFD.fok, fok_kersP K D S ρ P r M l, fok_kerP]

/-- Kernels on a list of bits implement their product. -/
theorem limpl_kers (hρ : ρ < K) {r : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P) {M : M2G}
    (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z) :
    ∀ l : List (Fin D), LImpl (P := P) (S := S) hρ r
      ((l.map fun i => Butterfly.kerAt i A).map Butterfly.tensF).prod
      (kersP K D S ρ P r M (l.map Fin.val)) (e * l.length) (2 * l.length)
      (fun w => l.length * ck (vol (Butterfly.layerShape P K D S) * r) Z (w + 2 * l.length) + 1)
  | [] => by
    simp only [List.map_nil, List.prod_nil, List.length_nil, mul_zero, kersP, zero_mul, add_zero,
      zero_add]
    exact limpl_skip (P := P) (S := S) (D := D) hρ r
  | i :: l => by
    have H := (limpl_kers hρ hr hS hP hM hA Z hZ l).comp (limpl_ker hρ i hr hS hP hM hA Z hZ)
    simp only [List.map_cons, List.prod_cons, kersP, List.length_cons]
    have e1 : e * l.length + e = e * (l.length + 1) := by ring
    have e2 : 2 * l.length + 2 = 2 * (l.length + 1) := by ring
    rw [e1, e2] at H
    refine H.mono fun w => ?_
    have := ck_mono (N := vol (Butterfly.layerShape P K D S) * r) (Z := Z)
      (show w + 2 * l.length ≤ w + 2 * (l.length + 1) by omega)
    nlinarith

/-- `A^{⊗D}` by `D` kernel passes. -/
theorem limpl_tens (hρ : ρ < K) {r : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S) (hP : 1 ≤ P) {M : M2G}
    (hM : M.Ok) {A : Butterfly.M2} {e : ℕ} (hA : KerOk M A e) (Z : ℕ)
    (hZ : zsz ((12 * (vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z) :
    LImpl (P := P) (S := S) hρ r (Butterfly.tens A : Butterfly.Op (Fin D))
      (kersP K D S ρ P r M ((List.finRange D).map Fin.val)) (e * D) (2 * D)
      (fun w => D * ck (vol (Butterfly.layerShape P K D S) * r) Z (w + 2 * D) + 1) := by
  have H := limpl_kers hρ hr hS hP hM hA Z hZ (List.finRange D)
  rw [List.length_finRange] at H
  exact H.congrT (Butterfly.tens_eq_prod_kerAt A _ (List.nodup_finRange D) (List.mem_finRange)).symm

theorem MC_ok : MC.Ok := by simp [MC, M2G.Ok, KFB.Sm]

theorem kerOk_MC : KerOk MC Butterfly.Cm 1 := by
  intro x y
  rw [Butterfly.Cm_eq]
  fin_cases x <;> fin_cases y <;> simp [Ment, MC, NLogN.KFB.toC, Butterfly.ca, Butterfly.cb] <;> ring

