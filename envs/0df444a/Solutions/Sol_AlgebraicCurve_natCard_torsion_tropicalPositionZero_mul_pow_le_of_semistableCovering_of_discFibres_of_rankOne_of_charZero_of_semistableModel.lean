        rw [map_zsmul, hdegc i, smul_zero])
      (fun e P hP => by rw [← hf P, Finsupp.smul_apply, hsum_apply_ann (Dc c hc) hdomc e P hP, smul_zero])
    rw [← map_zsmul, NodalPic0.mk_eq_zero_iff]
