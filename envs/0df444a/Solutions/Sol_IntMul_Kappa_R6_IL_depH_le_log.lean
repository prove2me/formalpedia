/-! ## 1. The recursion depth of `progH` is logarithmic -/

section Depth

/-- `depH m e ≤ log e / log (m / (m - 1)) + 1`: every level shrinks the width by `(m-1)/m`. -/
theorem depH_le_log_sol_aux {m : ℕ} (hm : 2 ≤ m) : ∀ e : ℕ, 1 ≤ e →
    (Bit.depH m e : ℝ) ≤ Real.log e / Real.log ((m : ℝ) / ((m : ℝ) - 1)) + 1 := by
  have hm2 : (2 : ℝ) ≤ m := by exact_mod_cast hm
  have hm1' : (0 : ℝ) < (m : ℝ) - 1 := by linarith
  have hm1 : (1 : ℝ) < (m : ℝ) / ((m : ℝ) - 1) := by
    rw [one_lt_div hm1']; linarith
  set lam := Real.log ((m : ℝ) / ((m : ℝ) - 1)) with hlam
  have hl0 : 0 < lam := Real.log_pos hm1
  intro e
  induction e using Nat.strong_induction_on with
  | _ e ih =>
  intro he
  by_cases h : m ≤ e
  · rw [Bit.depH_of_le h hm]
    set e' := (m - 1) * (e / m) with he'
    have hdiv : 1 ≤ e / m := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
    have he'1 : 1 ≤ e' := Nat.mul_pos (by omega) hdiv
    have hlt : e' < e := Bit.depH_dec ⟨h, hm⟩
    have hih := ih e' hlt he'1
    have hkey : e' * m ≤ e * (m - 1) := by
      rw [he']
      calc (m - 1) * (e / m) * m = (m - 1) * (e / m * m) := by ring
        _ ≤ (m - 1) * e := Nat.mul_le_mul_left _ (Nat.div_mul_le_self e m)
        _ = e * (m - 1) := by ring
    have he'0 : (0 : ℝ) < e' := by exact_mod_cast he'1
    have he0 : (0 : ℝ) < e := by exact_mod_cast he
    have hkeyR : (e' : ℝ) * ((m : ℝ) / ((m : ℝ) - 1)) ≤ e := by
      rw [mul_div_assoc', div_le_iff₀ hm1']
      have h1 : ((e' * m : ℕ) : ℝ) ≤ ((e * (m - 1) : ℕ) : ℝ) := by exact_mod_cast hkey
      push_cast [Nat.cast_sub (show 1 ≤ m by omega)] at h1
      linarith
    have hlog : Real.log e' + lam ≤ Real.log e := by
      rw [hlam, ← Real.log_mul he'0.ne' (by linarith)]
      exact Real.log_le_log (by positivity) hkeyR
    have h2 : Real.log e' / lam + 1 ≤ Real.log e / lam := by
      rw [div_add_one hl0.ne', div_le_div_iff_of_pos_right hl0]; linarith
    push_cast
    linarith
  · rw [Bit.depH_of_not (by tauto)]
    have h1 : 0 ≤ Real.log e := Real.log_nonneg (by exact_mod_cast he)
    have h2 := div_nonneg h1 hl0.le
    push_cast
    linarith

end Depth

