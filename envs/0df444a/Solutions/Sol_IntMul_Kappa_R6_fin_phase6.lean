section
-- Source module: Solutions.KFMDigMath
/-!
# KFM: digits, the CRT box and the product (§9.2, §9.6)

* `dgt b M x j`: digit `j` of `x` in radix `2^b` (zero from `M` on); `sum_dgt`: `x = Σ dgt_j 2^{bj}`.
* `cN a a' m = Σ_{i ≤ m} a_i a'_{m−i}`: the product coefficients; **`sum_cN`**: for sequences
  supported below `M` with `2M ≤ P`, `Σ_{m<P} cN_m Q^m = (Σ a_i Q^i)(Σ a'_j Q^j)`.
* **`gconv_digits`**: the cyclic convolution on `ℤ/P` of two such sequences is `cN` (no wrap).
* **`cconv_digits`**: transported to the CRT box by `Φ` (`RCRT.PhiEquiv`): the box functions
  `k ↦ a_{Φ⁻¹(k)}` convolve (`cconv`) to `cN` at `Φ(m)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul Finset

noncomputable section

/-! ## Digits -/

theorem dgt_lt (b M x j : ℕ) : dgt b M x j < 2 ^ b := by
  unfold dgt; split_ifs
  · exact Nat.mod_lt _ (by positivity)
  · positivity

theorem sum_dgt_mod (b x : ℕ) : ∀ M, ∑ j ∈ range M, x / 2 ^ (b * j) % 2 ^ b * 2 ^ (b * j) =
    x % 2 ^ (b * M)
  | 0 => by simp [Nat.mod_one]
  | M + 1 => by
    rw [sum_range_succ, sum_dgt_mod b x M, show b * (M + 1) = b * M + b by ring, pow_add,
      Nat.mod_mul]
    ring

theorem sum_dgt (b M x : ℕ) (hx : x < 2 ^ (b * M)) :
    ∑ j ∈ range M, dgt b M x j * 2 ^ (b * j) = x := by
  calc ∑ j ∈ range M, dgt b M x j * 2 ^ (b * j)
      = ∑ j ∈ range M, x / 2 ^ (b * j) % 2 ^ b * 2 ^ (b * j) :=
        sum_congr rfl fun j hj => by rw [dgt, if_pos (mem_range.1 hj)]
    _ = x % 2 ^ (b * M) := sum_dgt_mod b x M
    _ = x := Nat.mod_eq_of_lt hx

/-! ## Product coefficients -/

theorem sum_cN (a a' : ℕ → ℕ) (M P Q : ℕ) (ha : ∀ i, M ≤ i → a i = 0) (ha' : ∀ j, M ≤ j → a' j = 0)
    (hMP : 2 * M ≤ P) :
    ∑ m ∈ range P, cN a a' m * Q ^ m =
      (∑ i ∈ range M, a i * Q ^ i) * (∑ j ∈ range M, a' j * Q ^ j) := by
  simp only [cN, sum_mul]
  rw [sum_comm' (s' := fun i => Ico i P) (t' := range P)
    (h := fun m i => by simp only [mem_range, mem_Ico]; omega)]
  -- restrict the outer sum to `i < M`
  have hMP' : M ≤ P := by omega
  rw [← sum_range_add_sum_Ico _ hMP']
  have z1 : ∑ i ∈ Ico M P, ∑ m ∈ Ico i P, a i * a' (m - i) * Q ^ m = 0 :=
    sum_eq_zero fun i hi => sum_eq_zero fun m _ => by
      rw [ha i (mem_Ico.1 hi).1]; ring
  rw [z1, add_zero]
  refine sum_congr rfl fun i hi => ?_
  have hiM := mem_range.1 hi
  rw [sum_Ico_eq_sum_range]
  have hPi : M ≤ P - i := by omega
  rw [← sum_range_add_sum_Ico _ hPi]
  have z2 : ∑ j ∈ Ico M (P - i), a i * a' (i + j - i) * Q ^ (i + j) = 0 :=
    sum_eq_zero fun j hj => by
      rw [show i + j - i = j by omega, ha' j (mem_Ico.1 hj).1]; ring
  rw [z2, add_zero, mul_sum]
  refine sum_congr rfl fun j _ => ?_
  rw [show i + j - i = j by omega, pow_add]; ring

/-! ## Cyclic convolution on `ℤ/P` -/

theorem sum_zmod {n : ℕ} [NeZero n] {R : Type*} [AddCommMonoid R] (f : ℕ → R) :
    ∑ k : ZMod n, f k.val = ∑ i ∈ range n, f i := by
  refine sum_nbij' (fun k => k.val) (fun i => (i : ZMod n)) (fun k _ => by simp [ZMod.val_lt])
    (fun i _ => mem_univ _) (fun k _ => by simp [ZMod.natCast_zmod_val]) (fun i hi => ?_)
    (fun k _ => rfl)
  simp only [mem_coe, mem_range] at hi
  simp [ZMod.val_natCast, Nat.mod_eq_of_lt hi]

theorem val_sub_cast {n : ℕ} [NeZero n] {m i : ℕ} (hm : m < n) (hi : i < n) :
    ((m : ZMod n) - (i : ZMod n)).val = if i ≤ m then m - i else m + n - i := by
  split_ifs with h
  · rw [← Nat.cast_sub h, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega)]
  · have e : ((m : ZMod n) - (i : ZMod n)) = ((m + n - i : ℕ) : ZMod n) := by
      rw [Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero]
    rw [e, ZMod.val_natCast, Nat.mod_eq_of_lt (by omega)]

/-- **No wrap-around**: the cyclic convolution of two sequences supported below `M`, `2M ≤ P`. -/
theorem gconv_digits {P : ℕ} [NeZero P] (a a' : ℕ → ℕ) (M : ℕ) (ha : ∀ i, M ≤ i → a i = 0)
    (ha' : ∀ j, M ≤ j → a' j = 0) (hMP : 2 * M ≤ P) {m : ℕ} (hm : m < P) :
    IntMul.OpenAI.RCRT.gconv (fun k : ZMod P => (a k.val : ℂ)) (fun k : ZMod P => (a' k.val : ℂ))
      (m : ZMod P) = (cN a a' m : ℂ) := by
  simp only [IntMul.OpenAI.RCRT.gconv]
  have e : ∀ k : ZMod P, (a k.val : ℂ) * (a' ((m : ZMod P) - k).val : ℂ) =
      (fun i => (a i : ℂ) * (a' (if i ≤ m then m - i else m + P - i) : ℂ)) k.val := by
    intro k
    simp only
    rw [← ZMod.natCast_zmod_val k, val_sub_cast hm (ZMod.val_lt k), ZMod.natCast_zmod_val]
  rw [Fintype.sum_congr _ _ e, sum_zmod (fun i => (a i : ℂ) *
    (a' (if i ≤ m then m - i else m + P - i) : ℂ))]
  rw [← sum_range_add_sum_Ico _ (show m + 1 ≤ P by omega)]
  have z : ∑ i ∈ Ico (m + 1) P, (a i : ℂ) * (a' (if i ≤ m then m - i else m + P - i) : ℂ) = 0 :=
    sum_eq_zero fun i hi => by
      obtain ⟨h1, h2⟩ := mem_Ico.1 hi
      rw [if_neg (by omega)]
      by_cases hiM : M ≤ i
      · rw [ha i hiM]; simp
      · rw [ha' _ (by omega)]; simp
  rw [z, add_zero, cN, Nat.cast_sum]
  refine sum_congr rfl fun i hi => ?_
  rw [if_pos (by simp at hi; omega)]; push_cast; rfl

/-! ## On the CRT box -/

variable {d : ℕ}

/-- **The convolution on the CRT box.** -/
theorem cconv_digits (s : Fin d → ℕ) [∀ i, NeZero (s i)] [NeZero (∏ i, s i)]
    (hcop : Pairwise (Function.onFun Nat.Coprime s)) (μ : Fin d → ℕ)
    (hμ : ∀ i, Nat.Coprime (μ i) (s i)) (a a' : ℕ → ℕ) (M : ℕ) (ha : ∀ i, M ≤ i → a i = 0)
    (ha' : ∀ j, M ≤ j → a' j = 0) (hMP : 2 * M ≤ ∏ i, s i) {m : ℕ} (hm : m < ∏ i, s i) :
    IntMul.OpenAI.RC.cconv s
      (fun K => (a ((IntMul.OpenAI.RCRT.PhiEquiv s hcop μ hμ).symm K).val : ℂ))
      (fun K => (a' ((IntMul.OpenAI.RCRT.PhiEquiv s hcop μ hμ).symm K).val : ℂ))
      (IntMul.OpenAI.RCRT.PhiEquiv s hcop μ hμ (m : ZMod (∏ i, s i))) = (cN a a' m : ℂ) := by
  have h := congrFun (IntMul.OpenAI.RCRT.Phi_conv s hcop μ hμ (fun k => (a k.val : ℂ))
    (fun k => (a' k.val : ℂ))) (IntMul.OpenAI.RCRT.PhiEquiv s hcop μ hμ (m : ZMod (∏ i, s i)))
  simp only [Function.comp_apply, AddEquiv.symm_apply_apply] at h
  rw [gconv_digits a a' M ha ha' hMP hm] at h
  exact h

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMPhiW
/-!
# KFM: `Φ` / `Φ⁻¹` with `s_j ≤ t_j`, and as arrays of the chain

KFU states the pointwise denotations of `Φ`/`Φ⁻¹` under `s_j ≤ 2^h`; the parameters have
`s_j ≤ t_j = 2^{h+b_j}` (`PhiNeed`, as corrected). The proofs only use `sP ≤ tP`:

* `sP_le_tPW`, `le_SRW`, **`PhiD_atW`**, **`PhiInvD_atW`**, **`PhiD_eqW`** (copies with the weak
  hypothesis `hsw : ∀ j < d, sF j ≤ tP d h bL j`).

As arrays of the chain (box `t_i = tP d h bL i`, source `s_i = sF i`, last axis = component):

* `encode_snoc2`: `enc (sh ++ [2]) (v ++ [c]) = 2·enc sh v + c`.
* `pairL ys`: the Gaussian items of an integer list; `gflat (pairL ys) = ys` for even length.
* **`phiD_pad`**: `pairL (PhiD xs)` vanishes off the source points (`PadZ`) and holds the item
  `(xs[2κ], xs[2κ+1])`, `κ = (Φ⁻¹ k).val`, at source point `k`.
* **`phiInvD_read`**: `(PhiInvD (gflat ws))[2m + c]` is component `c` of `ws` at the point
  `Φ(m)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul AModel AModelL12 NLogN.KFU KFB

noncomputable section

variable {d : ℕ}

theorem sP_le_tPW (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ tP d h bL j)
    (j : ℕ) : sP d sF j ≤ tP d h bL j := by
  unfold sP; split_ifs with h1
  · exact hs j h1
  · rw [tP_eq, if_neg h1]

theorem le_SRW (d h : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hs : ∀ j < d, sF j ≤ tP d h bL j) :
    List.Forall₂ (· ≤ ·) (shR d (sP d sF)) (shR d (tP d h bL)) :=
  forall₂_map_le (fun j _ => sP_le_tPW d h bL sF hs j)

theorem PhiInvD_atW (h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (hs : ∀ j < d, 1 ≤ sF j)
    (hsw : ∀ j < d, sF j ≤ tP d h bL j)
    (hμ : ∀ j < d, ((μ j * OpenAI.RCRT.Ppre sF j : ℕ) : ZMod (sF j)) = 1) (ys : List ℤ) (k c : ℕ)
    (hk : k < OpenAI.RCRT.Ppre sF d) (hc : c < 2) :
    (PhiInvD h d bL sF μ ys).getD (2 * k + c) 0 =
      ys.getD (encode (shR d (tP d h bL)) (phiAddr d sF μ k c)) 0 := by
  have hv := valid_phiAddr hs μ k hc
  have hvT := (shapeLE_of_forall₂ (le_SRW d h bL sF hsw)).valid hv
  have hda := valid_digAddr hs k hc
  have hdK := valid_revH_RK d _ hda
  have hl : d ≤ (digAddr d sF k c).length := by simp [digAddr]
  unfold PhiInvD
  rw [← encode_digAddr hs k c hk, getD_pull _ _ (encode_lt hdK), decode_encode hdK, revH_revH hl,
    getD_pull _ _ (encode_lt hda), decode_encode hda, Gb_digAddr hs hμ k hc, extract,
    getD_pull _ _ (encode_lt hv), decode_encode hv, id]

/-! ## Arrays -/

theorem encode_snoc2 : ∀ (sh v : List ℕ), v.length = sh.length → ∀ c,
    encode (sh ++ [2]) (v ++ [c]) = 2 * encode sh v + c
  | [], [], _, c => by simp [encode]
  | [], _ :: _, h, _ => by simp at h
  | _ :: _, [], h, _ => by simp at h
  | q :: sh, a :: v, h, c => by
    simp only [List.cons_append, encode, List.headD_cons, List.tail_cons, vol_cons]
    rw [encode_snoc2 sh v (by simpa using h) c]
    simp only [vol, List.prod_append, List.prod_cons, List.prod_nil]; ring

theorem shR_eq (d : ℕ) (f : ℕ → ℕ) :
    shR d f = List.ofFn (fun i : Fin d => f i) ++ [f d] := by
  simp [shR, List.map_append, List.ofFn_eq_map, List.map_map]
  rw [← List.map_coe_finRange_eq_range, List.map_map]; rfl

theorem gflat_getD_even : ∀ (zs : List GI) (x : ℕ), (gflat zs).getD (2 * x) 0 = (zs.getD x 0).1
  | [], x => by simp
  | z :: zs, 0 => by simp
  | z :: zs, x + 1 => by
    rw [gflat_cons, show 2 * (x + 1) = 2 * x + 1 + 1 by ring, List.getD_cons_succ,
      List.getD_cons_succ, gflat_getD_even zs x, List.getD_cons_succ]

theorem gflat_getD_odd : ∀ (zs : List GI) (x : ℕ), (gflat zs).getD (2 * x + 1) 0 = (zs.getD x 0).2
  | [], x => by simp
  | z :: zs, 0 => by simp
  | z :: zs, x + 1 => by
    rw [gflat_cons, show 2 * (x + 1) + 1 = 2 * x + 1 + 1 + 1 by ring, List.getD_cons_succ,
      List.getD_cons_succ, gflat_getD_odd zs x, List.getD_cons_succ]

theorem exists_gflat : ∀ (ys : List ℤ), Even ys.length → ∃ zs, gflat zs = ys
  | [], _ => ⟨[], rfl⟩
  | [a], h => by simp at h
  | a :: b :: r, h => by
    obtain ⟨zs, hz⟩ := exists_gflat r (by
      simp only [List.length_cons] at h; obtain ⟨k, hk⟩ := h; exact ⟨k - 1, by omega⟩)
    exact ⟨(a, b) :: zs, by rw [gflat_cons, hz]⟩

theorem getD_of_gflat {zs : List GI} {ys : List ℤ} (h : gflat zs = ys) (x : ℕ) :
    zs.getD x 0 = (ys.getD (2 * x) 0, ys.getD (2 * x + 1) 0) := by
  rw [← h, gflat_getD_even, gflat_getD_odd]

section Arr

variable (h : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (H : CrtOK d sF μ)

theorem shR_tBox : shR d (tP d h bL) = List.ofFn (tBox d h bL) ++ [2] := by
  rw [shR_eq, tP_eq, if_neg (lt_irrefl d)]; rfl

theorem phiAddr_kL (m c : ℕ) :
    haveI := sBox_ne sF μ H
    phiAddr d sF μ m c = kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i))) ++ [c] := by
  haveI := sBox_ne sF μ H
  unfold phiAddr
  congr 1
  apply List.ext_getElem (by simp [kL])
  intro i h1 h2
  simp only [List.length_map, List.length_range] at h1
  have e := phiAddr_eq_Phi H m c ⟨i, h1⟩
  have e1 : (phiAddr d sF μ m c).getD i 0 = μ i * m % sF i := by
    unfold phiAddr
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_left (by simpa using h1)]
    simp [h1]
  simp only at e
  rw [e1] at e
  rw [List.getElem_map, List.getElem_range, e]
  simp only [kL, List.getElem_ofFn, eB, IntMul.OpenAI.RCRT.PhiEquiv_apply]
  rfl

theorem encode_phiAddr (m c : ℕ) :
    haveI := sBox_ne sF μ H
    encode (shR d (tP d h bL)) (phiAddr d sF μ m c) =
      2 * encode (List.ofFn (tBox d h bL)) (kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i)))) + c := by
  haveI := sBox_ne sF μ H
  rw [phiAddr_kL sF μ H, shR_tBox, encode_snoc2 _ _ (by simp [kL]) c]

/-- **`Φ⁻¹` read back.** -/
theorem phiInvD_read (hsw : ∀ j < d, sF j ≤ tP d h bL j) (ws : List GI) {m c : ℕ}
    (hm : m < OpenAI.RCRT.Ppre sF d) (hc : c < 2) :
    haveI := sBox_ne sF μ H
    (PhiInvD h d bL sF μ (gflat ws)).getD (2 * m + c) 0 =
      if c = 0 then (ws.getD (encode (List.ofFn (tBox d h bL))
        (kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i))))) 0).1
      else (ws.getD (encode (List.ofFn (tBox d h bL))
        (kL (eB sF μ H (m : ZMod (∏ i, sBox d sF i))))) 0).2 := by
  haveI := sBox_ne sF μ H
  rw [PhiInvD_atW h d bL sF μ H.pos hsw H.inv _ m c hm hc, encode_phiAddr h bL sF μ H]
  rcases (by omega : c = 0 ∨ c = 1) with rfl | rfl
  · rw [add_zero, gflat_getD_even, if_pos rfl]
  · rw [gflat_getD_odd, if_neg (by norm_num)]

end Arr

end

