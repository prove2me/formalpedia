theorem DiscreteTiling.VarTileSetFunction.smul_iff {f : VarTileSetFunction Y ps Prop H} {g : G} {y : Y} {t : TileSet ps ιₜ}
    (hg : g ∈ H) : f (g • y) (g • t) ↔ f y t := by sorry
