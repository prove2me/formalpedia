theorem Submodule.ofFiniteIdele_one {D : Type*} [Ring D] [Algebra ℚ D] (Λ : Submodule ℤ D)
    (hfg : Λ.FG) (hspan : Submodule.span ℚ (Λ : Set D) = ⊤) :
    Submodule.ofFiniteIdele Λ 1 = Λ := by sorry
