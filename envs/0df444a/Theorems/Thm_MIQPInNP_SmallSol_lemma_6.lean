-- title:
--   Lemma 6, p. 5 — normalizing hyperplane of small complexity for a pointed cone
-- statement:
--   Let $C = \operatorname{cone}\{r^1,\dots,r^s\}\subseteq\mathbb R^n$ be a pointed cone generated by rational vectors $r^1,\dots,r^s$, $s\ge1$. There is a single polynomial $g$, fixed before $n$, $s$ and the generators, such that there is a hyperplane $\mathcal H = \{x : f^\top x = 1\}$ with $f\in\mathbb Q^n$ and
--
--   1. $\operatorname{size}(f)\le g\big(\max_{i}\operatorname{size}(r^i)\big)$;
--   2. for every $x\in C$ with $\|x\| = 1$ (Euclidean norm),
--   $$f^\top x \ \ge\ \frac1R,\qquad R = \max_{i\in\{1,\dots,s\}}\|r^i\|;$$
--   3. $C\cap\mathcal H$ is bounded.
--
--   Such a hyperplane meets every ray of $C$ exactly once, and it is used to compactify cones in Lemma 7 and in the proof of Theorem 1.
--
--   **Formalization Note** If all $r^i$ are zero then $R=0$, $C=\{0\}$ and item 2 is vacuous.
--
--   Differences from the source:
--   - encoding: the generators $r^1,\dots,r^s$ and the maximum over $i$ → $s\ge 1$ rational generators; reason: the index range and the maximum presuppose $s\ge1$, and complexity is defined for rational data only.
--   - encoding: "polynomially bounded", $\|\cdot\|$ → `Polynomial ℕ` quantified before the data, Schrijver's bit-size, Euclidean norm; reason: Lean conventions for the paper's notions.
-- source:
--   Del Pia, Dey & Molinaro, Mixed-integer quadratic programming is in NP, arXiv:1407.4798v1, p. 5, Lemma 6

import Mathlib
import Definitions.Def_MIQPInNP_SmallSol_Setting

namespace MIQPInNP.SmallSol

/-- Lemma 6 (normalizing hyperplane), p. 5 (Del Pia, Dey & Molinaro, arXiv:1407.4798v1). -/
theorem lemma_6 :
    ∃ g : Polynomial ℕ, ∀ (n s : ℕ) (r : Fin s → Fin n → ℚ) (hs : 0 < s),
      IsPointedCone (cone (Set.range fun i => toReal (r i))) →
      ∃ f : Fin n → ℚ,
        vecSize f ≤ g.eval (Finset.univ.sup fun i => vecSize (r i)) ∧
        (∀ x ∈ cone (Set.range fun i => toReal (r i)), euclidNorm x = 1 →
          1 / (Finset.univ.sup' ⟨⟨0, hs⟩, Finset.mem_univ _⟩
                fun i => euclidNorm (toReal (r i))) ≤ ∑ j, (f j : ℝ) * x j) ∧
        Bornology.IsBounded (cone (Set.range fun i => toReal (r i)) ∩ hyperplane f) := by sorry

end MIQPInNP.SmallSol
