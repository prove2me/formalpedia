    h22 h23 h24 Fr Finv Fstar h31 h32 h33 pb h34 δq h35 αpull degPull h20 h21 h36
    (DistribSMul.toAddMonoidHom (JH (N₀ * p) ⊤) (SemilinearAut.ofAlgAut θ)) (SemilinearAut.ofAlgAut θ) (fun _ => rfl) hwgen
