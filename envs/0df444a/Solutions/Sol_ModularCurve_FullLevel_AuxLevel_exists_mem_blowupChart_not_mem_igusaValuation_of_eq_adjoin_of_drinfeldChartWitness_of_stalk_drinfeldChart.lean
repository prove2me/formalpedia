        (ModularCurve.FullLevel.levelH (q * ℓ) M') γ⁻¹ K τ → τ jOfK = jOfK := by
    have hmem := ModularCurve.qExpand_coeffEmb_mem_laurentBaseChange_xHFunctionField_of_mem_modularFunctionFieldFull
      L 1 q (q ^ 2 * M') (by rw [one_mul, pow_two, mul_assoc]; exact dvd_mul_right q (q * M'))
