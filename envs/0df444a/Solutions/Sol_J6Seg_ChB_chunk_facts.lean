  have hnc : nc ≤ nc * lam := Nat.le_mul_of_pos_right _ hl1
  have hncT : nc ≤ T := by omega
  have hpn : pre * nc ≤ pre * nc * lam * post := by
    calc pre * nc = pre * nc * 1 * 1 := by ring
      _ ≤ pre * nc * lam * post := Nat.mul_le_mul (Nat.mul_le_mul_left _ hl1) hpost1
  have hNC : 2 * (pre * nc * post * 2 ^ axfC6 P n) ≤ 2 * T := by
    rw [← hlamC]
    have : pre * nc * post * lam = pre * nc * lam * post := by ring
