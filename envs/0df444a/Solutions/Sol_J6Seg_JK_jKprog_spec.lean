/-! ## The header -/

theorem wrH_spec {s : IState HS} {G : Fin HS → List ℤ} {X : Fin HS} (hX : X ≠ dTJ)
    (hX5 : X.val < 56) {x : ℤ} {B : ℕ} (hGX : G X = [x]) (hx : zsz x ≤ B) :
    Sp (wrH X) (encK s G) (encK s (update (update G dTJ (x :: G dTJ)) X [])) (10000 * (B + 2)) := by
  have s1 := Sp.push (s := s) (f := G) (i := dTJ) (e := .reg X) (B := B) (by decide)
    (RS.clean_of_lt hX5) (isInt_encK hGX) trivial (by simp only [Ex.Bnd, top_encK hGX]; exact hx)
  rw [show (Ex.reg X).eval (encK s G) = x from top_encK hGX] at s1
  have g1 : update G dTJ (x :: G dTJ) X = x :: [] := by rw [update_of_ne hX, hGX]
  have s2 := Sp.pop (s := s) (f := _) (B := B) hX5 g1 hx
  refine (s1.seq s2).mono ?_
  simp only [Ex.size]; omega

end J6Seg.JK

