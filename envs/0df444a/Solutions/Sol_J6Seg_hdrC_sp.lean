  rw [ev] at P8
  refine (S1.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (P0.seq (P1.seq (P2.seq (P3.seq
    (P4.seq (P5.seq (P6.seq P8))))))))))))).mono ?_
