  · obtain ⟨a, ha, hpos, hy⟩ := E8TAxisProd0271EndpointWitnesses.wholeD_covers_slope
      (s := s) ⟨hsl, hsu⟩
    have hh := E8TAxisProd0271GraphWholeD.qJetBox_contains ha hpos
    rwa [hy] at hh

