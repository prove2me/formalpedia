section
-- Source module: Solutions.J6SegTabBnd2
/-!
# Chunk-table sizes 2: `ChunkTabBnd6` in the round-six regime, and `ValNeed6` without it

* `gam_le`: `|gamI P s t α k| ≤ 2^(P+R+2)` for every `k ≤ λ` (one past the table);
* `expNeg_le`: `|expNeg P s j| ≤ 2^(P+R+2)` for every `j` (`s > 0`);
* `lam_P_le`: `200 (3λ + 1) < 2^Q` at `Q = segPF p d s`, `λ = lamP d`;
* **`chunkTabBnd6_all`**: `∀ P, P.Ok → ChunkTabBnd6 P`;
* **`valNeed6_all'`**: `P.Ok → ∀ ap, ValCond6 ap → ValNeed6 P ap`.
-/

open Finset Real

namespace J6Seg.TabBnd
open IntMul IntMul.HvdH IntMul.HvdH.JPf J6QLU J6Seg IntMul.Kappa.R6

variable {P R s t α lam : ℕ}

theorem gam_le (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P)
    (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P) {k : ℕ} (hk : k ≤ lam) :
    |gamI P s t α k| ≤ 2 ^ (P + R + 2) := by
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  have hkR : (k : ℝ) ≤ lam := by exact_mod_cast hk
  have hE : 2 * (k : ℝ) ≤ 2 ^ P := by nlinarith
  have hR1 : (1 : ℝ) ≤ 2 ^ R := one_le_pow₀ (by norm_num)
  refine abs_of_err (gamI_err hs hst hα hP k) ?_ hE hR1
  rw [abs_of_pos (gamR_pos hα' hσ k)]
  linarith [gamR_le_one hα' hσ k]

theorem expNeg_le (hs : 0 < s) (j : ℕ) : |expNeg P s j| ≤ 2 ^ (P + R + 2) := by
  have h := expNeg_err (P := P) hs j rfl
  have hR1 : (1 : ℝ) ≤ 2 ^ R := one_le_pow₀ (by norm_num)
  refine abs_of_err h ?_ (one_le_pow₀ (by norm_num)) hR1
  rw [abs_of_pos (exp_pos _)]
  have : exp (-(π * (j : ℝ) / s)) ≤ 1 := by
    rw [Real.exp_le_one_iff]
    have : 0 ≤ π * (j : ℝ) / s := by positivity
    linarith
  linarith

