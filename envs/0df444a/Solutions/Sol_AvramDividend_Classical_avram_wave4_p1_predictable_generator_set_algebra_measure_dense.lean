open MeasureTheory Set AvramDividend.Classical
open scoped ENNReal NNReal

/-- For the genuine predictable sigma algebra of the original filtration,
the finite Boolean algebra generated by adapted half-line rectangles is
measure-dense under every finite predictable-time-history measure. -/
theorem solution
    {Ω ι : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι]
    (𝓕 : Filtration ι mΩ)
    [mProd : MeasurableSpace (ι × Ω)]
    (hProd : mProd = 𝓕.predictable)
    (μ : Measure (ι × Ω)) [IsFiniteMeasure μ] :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    μ.MeasureDense (generateSetAlgebra G) := by
  classical
  let G : Set (Set (ι × Ω)) :=
    {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
              S = ({⊥} ×ˢ A)) ∨
         (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
              S = (Set.Ioi i ×ˢ A))}
  change μ.MeasureDense (generateSetAlgebra G)
  have hSigma : mProd = MeasurableSpace.generateFrom G := by
    rw [hProd]
    exact avram_wave4_p1_predictable_adapted_rectangle_sigma_generator 𝓕
  have hAlg : IsSetAlgebra (generateSetAlgebra G) :=
    isSetAlgebra_generateSetAlgebra
  have hEq : mProd = MeasurableSpace.generateFrom (generateSetAlgebra G) := by
    rw [generateFrom_generateSetAlgebra_eq]
    exact hSigma
  exact Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite μ hAlg hEq
