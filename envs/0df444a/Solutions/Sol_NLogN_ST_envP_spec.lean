theorem pushes_all (B : ℕ) : ∀ (l : List (Fin HS × Ex HS)) (vs : List (Fin HS × ℤ))
    (s : IState HS), PushOK B s l vs →
    (pushes l).run s = NLogN.EX.pushV s vs ∧ (pushes l).ok s ∧
      (pushes l).cost s ≤ pwt l * 10 ^ 7 * (B + 2) ^ 2 + 1
  | [], [], s, _ => by simp [pushes, NLogN.EX.pushV, RS.run, RS.ok, RS.cost, pwt]
  | [], _ :: _, s, h => by simp [PushOK] at h
  | _ :: _, [], s, h => by simp [PushOK] at h
  | (r, e) :: l, (r', v) :: vs, s, h => by
    obtain ⟨rfl, hr, hc, ho, hb, hv, hl⟩ := h
    have e1 : (RS.push r' e).run s = s.upd r' (.int v :: s.G r') := by simp [RS.run, hv]
    obtain ⟨a1, a2, a3⟩ := pushes_all B l vs _ hl
    have c1 := RS.pushCost_le e s B hb
    refine ⟨?_, ⟨⟨hr, hc, ho⟩, ?_⟩, ?_⟩
    · simp only [pushes, RS.run] at e1 ⊢; rw [e1, a1]; rfl
    · rw [e1]; exact a2
    · simp only [pushes, RS.cost]
      rw [e1]
      simp only [pwt, List.map_cons, List.sum_cons] at a3 ⊢
      nlinarith

