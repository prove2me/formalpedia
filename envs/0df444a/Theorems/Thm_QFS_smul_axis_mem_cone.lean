variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

lemma QFS.smul_axis_mem_cone {v : E} (hv : ‖v‖ = 1) {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2)
    {t : ℝ} (ht : 0 < t) : t • v ∈ cone v ϑ := by sorry
