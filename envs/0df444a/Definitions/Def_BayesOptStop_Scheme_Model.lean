-- title:
--   The Bayesian optimal stopping model: instances, value histories, OFF, ON and the standing assumption
-- statement:
--   An **instance** with $K$ worlds, $m$ reward values and horizon $n$ consists of non-negative reals $v_0,\dots,v_{m-1}$ (unsorted, possibly repeated), a prior $\pi$ on the worlds and, for each world $h$, a joint PMF $D^{(h)}$ of the path $\omega\in[m]^n$ of value indices (the CORREL model). The world $H\sim\pi$ is never observed; the path has the mixture law $\Pr[\omega]=\sum_h\pi_hD^{(h)}(\omega)$ and $X_t(\omega)=v_{\omega_t}$.
--
--   The natural filtration is generated by the observed **values**: two paths have the same history $h_t$ when their first $t$ values coincide. $\mathbb E[f\mid h_t]$ is the finite ratio $\mathbb E[f\,\mathbf 1_{h_t}]/\Pr[h_t]$ (taken as $0$ at a null history). $M_0=\max_tX_t$, $\mathrm{OFF}=\mathbb E[M_0]$, and $\mathrm{ON}=\sup_\tau\mathbb E[X_\tau]$ over stopping times $1\le\tau\le n$ adapted to the value filtration (a finite, nonempty index set for $n\ge1$). The **standing assumption** (p. 9) is $\mathbb E[\max_{t'}X_{t'}\mid h_t]>0$ for every reachable $h_t$, $t\in[n]$.
--
--   NON-IID data give per-world, per-time PMFs $D^{(h)}_t$ with $D^{(h)}(\omega)=\prod_tD^{(h)}_t(\omega_t)$; IID data give one PMF per world used at every time. Times are 0-based in Lean.
-- source:
--   AmaniHamedani, Aouad, Işık, Kesselheim, Saberi (2026), Bayesian Optimal Stopping: Invincible Prophets and Achievable Philosophers, held STOC 2027 submission, SHA-256 fecfa05a3285ac21a7efbed099d2afed88a382dfcc9d91836b6e5210d70c4241, §2.1, pp. 8–9, and the display on p. 10

import Mathlib

open scoped BigOperators

namespace BayesOptStop.Scheme

/-!
# The Bayesian optimal stopping model (§2.1, pp. 8–10)

AmaniHamedani, Aouad, Işık, Kesselheim, Saberi (2026), *Bayesian Optimal Stopping: Invincible
Prophets and Achievable Philosophers*, held STOC 2027 submission, SHA-256 fecfa05a…c4241,
§2.1 pp. 8–9 and the display on p. 10.

* `K` worlds, `m` reward values `v_0, …, v_{m-1}` (non-negative reals, unsorted, possibly
  repeated), horizon `n`. Times and value indices are `0`-based: the paper's `X_t`, `t ∈ [n]`,
  is `X ⟨t-1⟩`; a history `h_t` has length `t`.
* A sample path is `ω : Fin n → Fin m`, the indices of the realized values; `X_s(ω) = v (ω s)`.
* The prior `π` is a vector on `Fin K`; `law h` is the joint PMF `D^(h)` on paths.
  The mixture law is `prob ω = ∑_h π_h D^(h)(ω)`.
* **Histories are values, not indices.** The natural filtration `F_t = σ(X_1, …, X_t)` is
  generated by the observed *values*. Two paths agree up to time `t` (`Agree t`) when their
  first `t` values coincide; with repeated values two different index prefixes can be the same
  history. Every conditional expectation conditions on these value cylinders.
* Conditional expectations are finite ratios `E[f · 1_cyl] / Pr[cyl]`; on a null history the
  ratio is `0/0 = 0` (Lean's convention). Statements only use them at reachable histories.
-/

/-- An instance with `K` worlds, `m` support values and horizon `n` (§2.1, p. 8):
the reward values `v`, the prior `π` and, for each world `h`, the joint PMF `D^(h)` of the
index path. -/
structure Instance (K m n : ℕ) where
  /-- The reward values `v_0, …, v_{m-1}`. -/
  v : Fin m → ℝ
  /-- The prior `π` over worlds. -/
  prior : Fin K → ℝ
  /-- The joint PMF `D^(h)(ω)` of the path in world `h` (the CORREL model: arbitrary). -/
  law : Fin K → (Fin n → Fin m) → ℝ

namespace Instance

variable {K m n : ℕ} (I : Instance K m n)

/-- Validity: non-negative values, `π` a probability vector, every `D^(h)` a PMF. -/
def Valid : Prop :=
  (∀ q, 0 ≤ I.v q) ∧ (∀ h, 0 ≤ I.prior h) ∧ (∑ h, I.prior h = 1) ∧
    (∀ h ω, 0 ≤ I.law h ω) ∧ (∀ h, ∑ ω, I.law h ω = 1)

/-- The mixture law `Pr[ω] = ∑_h π_h D^(h)(ω)` of the path (the world `H` is never observed). -/
noncomputable def prob (ω : Fin n → Fin m) : ℝ :=
  ∑ h, I.prior h * I.law h ω

/-- The reward `X_s(ω) = v_{ω_s}` at (0-based) time `s`. -/
def X (s : Fin n) (ω : Fin n → Fin m) : ℝ :=
  I.v (ω s)

/-- The reward at a natural-number time, `0` at times `≥ n` (an algorithm that never selects
earns `0`, proof of Lemma 1, p. 13). -/
noncomputable def payoff (k : ℕ) (ω : Fin n → Fin m) : ℝ :=
  if h : k < n then I.X ⟨k, h⟩ ω else 0

/-- `ω` and `ω'` have the same history `h_t`: their first `t` observed values coincide. -/
def Agree (t : ℕ) (ω ω' : Fin n → Fin m) : Prop :=
  ∀ s : Fin n, s.val < t → I.v (ω s) = I.v (ω' s)

open Classical in
/-- `Pr[h_t]`, the probability of the history of `ω` up to time `t`. -/
noncomputable def cylProb (t : ℕ) (ω : Fin n → Fin m) : ℝ :=
  ∑ ω' ∈ Finset.univ.filter (I.Agree t ω), I.prob ω'

open Classical in
/-- `E[f | F_t](ω) = E[f | h_t]` for the history `h_t` of `ω` (`0` on a null history). -/
noncomputable def condExp (f : (Fin n → Fin m) → ℝ) (t : ℕ) (ω : Fin n → Fin m) : ℝ :=
  (∑ ω' ∈ Finset.univ.filter (I.Agree t ω), I.prob ω' * f ω') / I.cylProb t ω

/-- The expectation `E[f]` under the mixture law. -/
noncomputable def expect (f : (Fin n → Fin m) → ℝ) : ℝ :=
  ∑ ω, I.prob ω * f ω

/-- `M_0(ω) = max_{t ∈ [n]} X_t(ω)`, the offline maximum (`0` when `n = 0`; the values are
non-negative, so the fold from `0` is the maximum). -/
noncomputable def pathMax (ω : Fin n → Fin m) : ℝ :=
  Finset.univ.fold max 0 (fun s : Fin n => I.X s ω)

/-- The offline benchmark `OFF = E[max_t X_t]` (p. 9). -/
noncomputable def OFF : ℝ :=
  I.expect I.pathMax

/-- A stopping time `τ` with `1 ≤ τ ≤ n` adapted to the natural filtration: whether `τ` stops at
(0-based) time `s` depends only on the history `h_{s+1}`. -/
def IsStoppingRule (τ : (Fin n → Fin m) → Fin n) : Prop :=
  ∀ ω ω' (s : Fin n), τ ω = s → I.Agree (s.val + 1) ω ω' → τ ω' = s

/-- The Bayes-optimal online value `ON = sup_{τ stopping time, 1 ≤ τ ≤ n} E[X_τ]` (p. 10).
The index type is finite, and nonempty when `n ≥ 1` (`τ ≡ n`), so the supremum is attained. -/
noncomputable def ON : ℝ :=
  ⨆ τ : {τ : (Fin n → Fin m) → Fin n // I.IsStoppingRule τ}, I.expect (fun ω => I.X (τ.1 ω) ω)

/-- The standing assumption of p. 9: `E[max_{t'} X_{t'} | h_t] > 0` for every reachable history
`h_t`, `t ∈ [n]`. -/
def Standing : Prop :=
  ∀ t : ℕ, 1 ≤ t → t ≤ n → ∀ ω, 0 < I.cylProb t ω → 0 < I.condExp I.pathMax t ω

end Instance

/-- NON-IID data (§2.1, p. 8): for each world `h` and time `s` a PMF `D^(h)_s` on the values,
the times independent given the world. -/
structure NonIIDData (K m n : ℕ) where
  /-- The reward values. -/
  v : Fin m → ℝ
  /-- The prior over worlds. -/
  prior : Fin K → ℝ
  /-- `pmf h s q = Pr[X_s = v_q | H = h]` (index `q`). -/
  pmf : Fin K → Fin n → Fin m → ℝ

/-- Validity of NON-IID data: non-negative values, a probability prior, PMFs. -/
def NonIIDData.Valid {K m n : ℕ} (D : NonIIDData K m n) : Prop :=
  (∀ q, 0 ≤ D.v q) ∧ (∀ h, 0 ≤ D.prior h) ∧ (∑ h, D.prior h = 1) ∧
    (∀ h s q, 0 ≤ D.pmf h s q) ∧ (∀ h s, ∑ q, D.pmf h s q = 1)

/-- The instance of NON-IID data: `D^(h)(ω) = ∏_s D^(h)_s(ω_s)`. -/
noncomputable def NonIIDData.toInstance {K m n : ℕ} (D : NonIIDData K m n) : Instance K m n :=
  ⟨D.v, D.prior, fun h ω => ∏ s, D.pmf h s (ω s)⟩

/-- IID data (§2.1, p. 8): for each world one PMF `D^(h)` on the values, used at every time. -/
structure IIDData (K m : ℕ) where
  /-- The reward values. -/
  v : Fin m → ℝ
  /-- The prior over worlds. -/
  prior : Fin K → ℝ
  /-- `pmf h q = Pr[X_s = v_q | H = h]` for every time `s`. -/
  pmf : Fin K → Fin m → ℝ

/-- Validity of IID data. -/
def IIDData.Valid {K m : ℕ} (D : IIDData K m) : Prop :=
  (∀ q, 0 ≤ D.v q) ∧ (∀ h, 0 ≤ D.prior h) ∧ (∑ h, D.prior h = 1) ∧
    (∀ h q, 0 ≤ D.pmf h q) ∧ (∀ h, ∑ q, D.pmf h q = 1)

/-- The instance of IID data with horizon `n`: `D^(h)(ω) = ∏_s D^(h)(ω_s)`. -/
noncomputable def IIDData.toInstance {K m : ℕ} (D : IIDData K m) (n : ℕ) : Instance K m n :=
  ⟨D.v, D.prior, fun h ω => ∏ s, D.pmf h (ω s)⟩

end BayesOptStop.Scheme


