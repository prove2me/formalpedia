-- Source module: Solutions.J6SieveStep
/-!
# J6Sieve, part 3: one greedy step

If `Q` is a set of at most `Ω + 1` primes, all `> z = 4(Ω+1)`, and `H` exceeds the
explicit bound, then every interval `(A, A+H]` contains a `z`-rough integer
divisible by no element of `Q`.
-/

namespace J6Sieve
open Finset

/-- The greedy step. -/
theorem step (d X H A : ℕ) (Q : Finset ℕ) (hQp : ∀ q ∈ Q, q.Prime)
    (hQz : ∀ q ∈ Q, q ∉ P (zz d X)) (hQc : Q.card ≤ Om d X + 1) (hH : sieveBound d X < H) :
    ∃ n, A < n ∧ n ≤ A + H ∧ rough (zz d X) n ∧ ∀ q ∈ Q, ¬ q ∣ n :=
  step_core (zz d X) (Om d X) (kk d X) (mm d X) H A Q rfl
    (Nat.lt_pow_succ_log_self (by norm_num) _) rfl hQp hQz hQc hH

end J6Sieve

end

section
-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

lemma card_primeFactors_le_log (s : ℕ) (hs : s ≠ 0) : s.primeFactors.card ≤ Nat.log 2 s := by
  apply Nat.le_log_of_pow_le (by norm_num)
  calc 2 ^ s.primeFactors.card ≤ ∏ p ∈ s.primeFactors, p :=
        Finset.pow_card_le_prod _ _ _ fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le
    _ ≤ s := Nat.le_of_dvd (Nat.pos_of_ne_zero hs) (Nat.prod_primeFactors_dvd s)

lemma rough_odd (z n : ℕ) (hz : 2 ≤ z) (h : rough z n) : Odd n := by
  have h2 : 2 ∈ P z := mem_P.2 ⟨hz, Nat.prime_two⟩
  exact Nat.odd_iff.2 (Nat.two_dvd_ne_zero.1 (h 2 h2))

end J6Sieve

end

section
-- Source module: Solutions.R6SMath
/-!
# Round-six setup, part 1: the sources by search, and the counted parameters

The setup machine picks the source `s_j` of axis `j` by scanning the candidates
`c = A_j + x` (`A_j = t_j - 2 w_j`, `x = w_j, w_j - 1, …, 1`) and keeping the last one coprime to
`2 ∏_{i<j} s_i` (`pick`, `src6`). The sieve (`J6SieveStep.step`) shows that a coprime candidate
exists once `w_j > sieveBound d r` (**`exists_cop`**), which holds for large `n`
(**`ell_big`**: `ℓ ≥ C (log₂ b + 1)^2` eventually). Then `src6` satisfies `SrcOK6`
(**`src6_ok`**).

The parameters `d, L, α` are computed by the machine as counts (`d_count6`, `L_count6`,
`α_count6`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KFM Finset

noncomputable section

/-! ## Selection -/

theorem pickA_spec (A Q N : ℕ) : ∀ k ≤ N, (∃ x, N - k < x ∧ x ≤ N ∧ Nat.Coprime Q (A + x)) →
    A < pickA A Q N k ∧ pickA A Q N k ≤ A + N ∧ Nat.Coprime Q (pickA A Q N k)
  | 0, _, ⟨x, h1, h2, _⟩ => by omega
  | k + 1, hk, ⟨x, h1, h2, h3⟩ => by
    simp only [pickA]
    split_ifs with hc
    · exact ⟨by omega, by omega, hc⟩
    · have hx : x ≠ N - k := by rintro rfl; exact hc h3
      exact pickA_spec A Q N k (by omega) ⟨x, by omega, h2, h3⟩

theorem pick_spec (A Q N : ℕ) (h : ∃ x, 1 ≤ x ∧ x ≤ N ∧ Nat.Coprime Q (A + x)) :
    A < pick A Q N ∧ pick A Q N ≤ A + N ∧ Nat.Coprime Q (pick A Q N) := by
  obtain ⟨x, h1, h2, h3⟩ := h
  exact pickA_spec A Q N N le_rfl ⟨x, by omega, h2, h3⟩

/-! ## The sources -/

theorem PP6_succ (P : Prm) (n j : ℕ) : PP6 P n (j + 1) = PP6 P n j * src6 P n j := rfl

theorem PP6_eq (P : Prm) (n : ℕ) : ∀ j, PP6 P n j = ∏ i ∈ range j, src6 P n i
  | 0 => rfl
  | j + 1 => by rw [PP6_succ, PP6_eq P n j, prod_range_succ]

/-! ## Existence of a coprime candidate (the sieve) -/

theorem log_prod_le (d X j : ℕ) (hj : j ≤ d) (s : ℕ → ℕ) (hs : ∀ i < j, 0 < s i ∧ s i ≤ X) :
    Nat.log 2 (∏ i ∈ range j, s i) ≤ J6Sieve.Om d X := by
  have hM0 : ∏ i ∈ range j, s i ≠ 0 :=
    prod_ne_zero_iff.2 fun i hi => (hs i (mem_range.1 hi)).1.ne'
  have hX : X < 2 ^ (Nat.log 2 X + 1) := Nat.lt_pow_succ_log_self (by norm_num) X
  have h1 : ∏ i ∈ range j, s i ≤ (2 ^ (Nat.log 2 X + 1)) ^ j := by
    calc ∏ i ∈ range j, s i ≤ ∏ _i ∈ range j, 2 ^ (Nat.log 2 X + 1) :=
          prod_le_prod' fun i hi => by have := (hs i (mem_range.1 hi)).2; omega
      _ = (2 ^ (Nat.log 2 X + 1)) ^ j := by simp
  have h2 : (2 ^ (Nat.log 2 X + 1)) ^ j ≤ 2 ^ J6Sieve.Om d X := by
    rw [← pow_mul]; apply Nat.pow_le_pow_right (by norm_num)
    unfold J6Sieve.Om; rw [mul_comm]; exact Nat.mul_le_mul_right _ hj
  have h3 : ∏ i ∈ range j, s i < 2 ^ (J6Sieve.Om d X + 1) := by
    rw [pow_succ]; omega
  have := Nat.log_lt_of_lt_pow hM0 h3
  omega

/-- **A coprime candidate exists** in `(A, A + H]` once `H > sieveBound d X`. -/
theorem exists_cop (d X H A j : ℕ) (hj : j ≤ d) (s : ℕ → ℕ) (hs : ∀ i < j, 0 < s i ∧ s i ≤ X)
    (hH : J6Sieve.sieveBound d X < H) :
    ∃ x, 1 ≤ x ∧ x ≤ H ∧ Nat.Coprime (2 * ∏ i ∈ range j, s i) (A + x) := by
  set M := ∏ i ∈ range j, s i with hM
  have hM0 : M ≠ 0 := prod_ne_zero_iff.2 fun i hi => (hs i (mem_range.1 hi)).1.ne'
  set z := J6Sieve.zz d X with hz
  have hz4 : 4 ≤ z := by simp only [hz, J6Sieve.zz]; omega
  set Q := M.primeFactors.filter (fun q => z < q) with hQ
  have hQp : ∀ q ∈ Q, q.Prime := fun q hq =>
    Nat.prime_of_mem_primeFactors (mem_filter.1 hq).1
  have hQz : ∀ q ∈ Q, q ∉ J6Sieve.P z := by
    intro q hq hqP
    have := (mem_filter.1 hq).2
    have := (J6Sieve.mem_P.1 hqP).1
    omega
  have hQc : Q.card ≤ J6Sieve.Om d X + 1 := by
    calc Q.card ≤ M.primeFactors.card := card_filter_le _ _
      _ ≤ Nat.log 2 M := J6Sieve.card_primeFactors_le_log M hM0
      _ ≤ J6Sieve.Om d X := log_prod_le d X j hj s hs
      _ ≤ _ := by omega
  obtain ⟨m, hm1, hm2, hmr, hmQ⟩ := J6Sieve.step d X H A Q hQp hQz hQc hH
  refine ⟨m - A, by omega, by omega, ?_⟩
  rw [show A + (m - A) = m by omega]
  have hodd : Odd m := J6Sieve.rough_odd z m (by omega) hmr
  refine Nat.Coprime.mul_left ((Nat.coprime_two_left).2 hodd) ?_
  refine Nat.coprime_of_dvd fun k hk hkM hkm => ?_
  by_cases hkz : k ≤ z
  · exact hmr k (J6Sieve.mem_P.2 ⟨hkz, hk⟩) hkm
  · refine hmQ k (mem_filter.2 ⟨Nat.mem_primeFactors.2 ⟨hk, hkM, hM0⟩, by omega⟩) hkm

/-! ## `SrcOK6` for the selected sources -/

theorem tF6_le (P : Prm) (n j : ℕ) (hl : 1 ≤ ℓP6 P n) : tF6 P n j ≤ 2 ^ ℓP6 P n := by
  have e : 2 ^ ℓP6 P n = 2 ^ hN6 P n * 2 := by
    rw [← pow_succ]; congr 1; unfold hN6; omega
  unfold tF6; split_ifs <;> rw [e] <;> omega

theorem wnd6_le (P : Prm) (n j : ℕ) (hd : 1 ≤ dP6 P n) : 8 * wnd6 P n j ≤ tF6 P n j := by
  have h1 : wnd6 P n j * (8 * dP6 P n ^ 2) ≤ tF6 P n j := Nat.div_mul_le_self _ _
  have h2 : 8 ≤ 8 * dP6 P n ^ 2 := by nlinarith
  nlinarith

/-- The facts on the selected sources. -/
theorem src6_facts (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) (hW : WinOK6 P n) :
    ∀ j ≤ dP6 P n, ∀ i < j, wA6 P n i < src6 P n i ∧ src6 P n i ≤ wA6 P n i + wnd6 P n i ∧
      Nat.Coprime (2 * PP6 P n i) (src6 P n i) := by
  intro j
  induction j with
  | zero => intro _ i hi; omega
  | succ j ih =>
    intro hj i hi
    rcases Nat.lt_or_ge i j with h | h
    · exact ih (by omega) i h
    · have hij : i = j := by omega
      subst hij
      have hprev := ih (by omega)
      refine pick_spec _ _ _ ?_
      rw [PP6_eq]
      refine exists_cop (dP6 P n) (2 ^ ℓP6 P n) (wnd6 P n i) (wA6 P n i) i (by omega) _ ?_ (hW i hj)
      intro k hk
      obtain ⟨h1, h2, -⟩ := hprev k hk
      have h3 := wnd6_le P n k hd
      have h4 := tF6_le P n k hl
      unfold wA6 at h1 h2
      exact ⟨by omega, by omega⟩

theorem src6_ok (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) (hW : WinOK6 P n) :
    SrcOK6 P n (src6 P n) := by
  have H := src6_facts P n hd hl hW (dP6 P n) le_rfl
  refine ⟨fun j hj => ?_, fun j hj => ?_, fun j hj => ?_, fun i j hi hj hij => ?_⟩
  · have := (H j hj).2.2
    exact (Nat.coprime_two_left).1 (Nat.Coprime.coprime_mul_right this)
  · have := (H j hj).1; unfold wA6 at this; exact this
  · have h1 := (H j hj).2.1
    have h3 := wnd6_le P n j hd
    unfold wA6 at h1; omega
  · have key : ∀ a b, a < b → b < dP6 P n → Nat.Coprime (src6 P n a) (src6 P n b) := by
      intro a b hab hb
      have hc := (H b hb).2.2
      have hdv : src6 P n a ∣ 2 * PP6 P n b := by
        rw [PP6_eq]
        exact Dvd.dvd.mul_left (dvd_prod_of_mem _ (mem_range.2 hab)) 2
      exact Nat.Coprime.coprime_dvd_left hdv hc
    rcases Nat.lt_or_gt_of_ne hij with h | h
    · exact key i j h hj
    · exact (key j i h hi).symm

/-! ## Eventual growth of `ℓ` -/

/-! ## The counted parameters -/

theorem ε_rat (P : Prm) (hP : P.Ok) (q : ℚ) (hq : P.ε = q) :
    P.ε = (q.num.toNat : ℝ) / (q.den : ℝ) ∧ 0 < q.den := by
  have hq0 : (0 : ℝ) < q := by rw [← hq]; linarith [hP.eps_ge]
  have hq0' : (0 : ℚ) < q := by exact_mod_cast hq0
  have hnum : 0 < q.num := Rat.num_pos.2 hq0'
  refine ⟨?_, q.den_pos⟩
  rw [hq, Rat.cast_def]
  congr 1
  have : ((q.num.toNat : ℤ) : ℝ) = (q.num : ℝ) := by
    congr 1; exact Int.toNat_of_nonneg hnum.le
  exact_mod_cast this.symm

end

end IntMul.Kappa.R6

