theorem solution (k j : ℝ) :
    EqOn (cj (k * j)) (fun R => k ^ 3 * cj j R) (Ioi (3:ℝ))
      ∧ EqOn (dj (k * j)) (fun R => k ^ 3 * dj j R) (Ioi (3:ℝ)) := by
  have hq : ∀ R ∈ Ioi (3:ℝ), Lmag (fun s => k ^ 3 * cj j s) R = q3j (k * j) (1 / R) / R ^ 3 := by
    intro R hR
    rw [Lmag_const_mul (cj_magClass j).1 R, cj_LmagEq j R hR, q3j_smul_apply]
    ring
  have hd : ∀ R ∈ Ioi (3:ℝ),
      Dell 0 (fun s => k ^ 3 * cj j s) (fun s => k ^ 3 * dj j s) R = r3j (k * j) (1 / R) / R := by
    intro R hR
    rw [Dell_const_mul, dj_DellEq j R hR, r3j_smul_apply]
    ring
  have h1 : MagClass 3 (fun s => k ^ 3 * cj j s) := magClass_const_mul (cj_magClass j)
  have h2 : VClass 3 (fun s => k ^ 3 * dj j s) := vClass_const_mul (dj_vClass j)
  obtain ⟨hbc, hbd⟩ := pair_unique_cubic (k * j) h1 h2 hq hd
  exact ⟨hbc.symm, hbd.symm⟩
