theorem hexd (l : Q.Ld) (hl : Q.ρd l = 0) : ∃ φ : Q.Xd, Q.κd φ = l := by
  have hs : Function.Surjective Q.δ₀ := Q.δ₀_surjective
  have hker : LinearMap.ker Q.δ₀ ≤ LinearMap.ker (id l : Module.Dual ℤ ↥(characterLattice E)) := by
    intro x hx
    rw [LinearMap.mem_ker] at hx ⊢
    have h1 : (Q.δ₀ x).1 = 0 := by rw [hx]; rfl
    have h2 : (Q.δ₀ x).2 = 0 := by rw [hx]; rfl
    have ha : pushforward Q.D.a x.1 = 0 := congrArg Subtype.val h1
    have hb : pushforward Q.D.b x.1 = 0 := congrArg Subtype.val h2
    have hmem : (x.1 : E → ℤ) ∈ ribbonKernel Q.D := by
      rw [mem_ribbonKernel]
      intro i
      fin_cases i
      · simpa [jointDelta] using ha
      · simpa [jointDelta] using hb
    have hx' : (id l : Module.Dual ℤ ↥(characterLattice E)) x =
        (id (Q.ρd l) : Module.Dual ℤ ↥(ribbonKernel Q.D)) ⟨x.1, hmem⟩ := rfl
    rw [hx', hl]
    rfl
  let l' : Module.Dual ℤ (↥(characterLattice V) × ↥(characterLattice V)) :=
    ((LinearMap.ker Q.δ₀).liftQ (id l : Module.Dual ℤ ↥(characterLattice E)) hker).comp
      (LinearMap.quotKerEquivOfSurjective Q.δ₀ hs).symm.toLinearMap
