-- title:
--   Labeled hypergraphs, cuts, disconnection and all-terminal unreliability
-- statement:
--   A **labeled hypergraph** on the vertices $V=\{0,\dots,n-1\}$ is a family $(e)_{e\in E}$ of vertex subsets indexed by a finite set of labels. Distinct labels may carry the same subset; each label is one independent failure trial.
--
--   An edge **crosses** $S\subseteq V$ if $e\cap S\ne\emptyset$ and $e\setminus S\ne\emptyset$, and $\partial_H S$ is the set of crossing labels. A set $D$ of failed labels **disconnects** $H$ if some $\emptyset\ne S\subsetneq V$ is crossed by no label outside $D$; for $n\le1$ this never happens. The **components** after failures $D$ are the classes of the equivalence relation generated by membership in a common surviving edge, and $H$ is **connected** if with no failures there is one class.
--
--   Under independent failures with probabilities $p=(p_e)$, a set $D$ has probability $\prod_{e\in D}p_e\prod_{e\notin D}(1-p_e)$, and the **all-terminal unreliability** is
--   $$u_H(p)=\sum_{D\ \text{disconnecting}}\ \prod_{e\in D}p_e\prod_{e\notin D}(1-p_e).$$
--   For rates $r$ the **minimum cut** is
--   $$\min_{\emptyset\ne S\subsetneq V}\ \sum_{e\in\partial_H S}r_e,$$
--   and $\lambda$ is its value at unit rates, counting edge labels.
--
--   The standing context (2.2) of the paper, and of the quotient of §9.1, is: $n\ge2$, $H$ connected, and every retained edge with at least two vertices. This layer is shared by every statement of the mission.
--
--   **Formalization Note** The minimum cut is a minimum over a finite set, with the junk value $0$ at $n\le1$; every theorem using it assumes $n\ge2$. It is generic in the value type, and `map_minCut` identifies the rational value computed by the algorithm with the real value used in the analysis. A random failed set is represented by a finite set of labels, so the probability law is a finite sum and no measure is involved.
-- source:
--   Zhijie Zheng, STOC 2027 submission #37 (October 2026), §1.1, p. 2; §2, p. 4; (9.5), p. 13; Lemma 9.1, p. 12

import Mathlib

noncomputable section

open scoped BigOperators Classical

namespace HypergraphUnreliability.FPRAS

/-- A labeled undirected hypergraph on the vertex set `Fin n` (the source's `[n]`, relabeled
`0, …, n-1`). `E` is the type of edge labels and `inc e` is the set of vertices of the edge with
label `e`. Distinct labels may carry the same vertex set (parallel edges); each label is one
independent failure trial. Zheng, STOC 2027 submission #37, §1.1, p. 2. -/
structure LabeledHypergraph (n : ℕ) (E : Type) where
  /-- The vertices of each labeled edge. -/
  inc : E → Finset (Fin n)

namespace LabeledHypergraph

variable {n : ℕ} {E : Type}

/-- The edge `e` crosses `S`: `e ∩ S ≠ ∅` and `e \ S ≠ ∅` (§2, p. 4). -/
def Crosses (H : LabeledHypergraph n E) (e : E) (S : Finset (Fin n)) : Prop :=
  (H.inc e ∩ S).Nonempty ∧ (H.inc e \ S).Nonempty

/-- `∅ ≠ S ⊊ V`. -/
def IsNontrivialCut (S : Finset (Fin n)) : Prop :=
  S.Nonempty ∧ S ≠ Finset.univ

/-- The nontrivial vertex cuts; empty exactly when `n ≤ 1`. -/
def nontrivialCuts (n : ℕ) : Finset (Finset (Fin n)) :=
  Finset.univ.filter IsNontrivialCut

/-- The failed-label set `D` disconnects `H`: some nonempty proper vertex subset is crossed by no
surviving edge (§1.1, p. 2). For `n ≤ 1` no such subset exists, so the event is empty. -/
def Disconnected (H : LabeledHypergraph n E) (D : Finset E) : Prop :=
  ∃ S : Finset (Fin n), IsNontrivialCut S ∧ ∀ e, e ∉ D → ¬ H.Crosses e S

/-- The equivalence relation generated by membership in a common surviving edge, when the labels in
`D` have failed; its classes are the connected components after those failures (§1.1, p. 2). -/
def components (H : LabeledHypergraph n E) (D : Finset E) : Setoid (Fin n) :=
  Relation.EqvGen.setoid (fun u v => ∃ e, e ∉ D ∧ u ∈ H.inc e ∧ v ∈ H.inc e)

/-- With no failures the relation generated by common edges has a single class. -/
def IsConnected (H : LabeledHypergraph n E) : Prop :=
  ∀ u v, (H.components ∅) u v

/-- The standing context (2.2) of §§3–8, and of the connected quotient of §9.1: `n ≥ 2`, `H`
connected, and every retained edge has at least two distinct vertices (empty and singleton edges
were discarded, §1.1, p. 2). -/
structure Standing (H : LabeledHypergraph n E) : Prop where
  two_le : 2 ≤ n
  connected : H.IsConnected
  two_le_card : ∀ e, 2 ≤ (H.inc e).card

section Cuts

variable [Fintype E]

/-- `∂_H S`, as a set of edge labels (§2, p. 4). -/
def cutSet (H : LabeledHypergraph n E) (S : Finset (Fin n)) : Finset E :=
  Finset.univ.filter (fun e => H.Crosses e S)

/-- The total weight `∑_{e ∈ ∂_H S} r e` of a cut. -/
def cutWeight {R : Type} [AddCommMonoid R] (H : LabeledHypergraph n E) (r : E → R)
    (S : Finset (Fin n)) : R :=
  ∑ e ∈ H.cutSet S, r e

/-- The minimum over nontrivial vertex cuts of the total weight, (9.5), p. 13. The minimum is over
a finite set, nonempty exactly when `n ≥ 2`; the value `0` at `n ≤ 1` is a junk value and every
theorem using this definition assumes `n ≥ 2`. -/
def minCut {R : Type} [AddCommMonoid R] [LinearOrder R] (H : LabeledHypergraph n E) (r : E → R) :
    R :=
  if h : (nontrivialCuts n).Nonempty then
    (nontrivialCuts n).inf' h (H.cutWeight r)
  else 0

/-- The unit minimum cut `λ = min_{∅ ≠ S ⊊ V} |∂_H S|`, counting edge labels (§2, p. 4). -/
def minCutCount (H : LabeledHypergraph n E) : ℕ :=
  H.minCut (fun _ => (1 : ℕ))

/-- A monotone additive map carries the minimum cut to the minimum cut. It identifies the rational
value `Λ` computed by the algorithm with the real value used by the analytic process, and the unit
cut `minCut (fun _ => 1)` with the integer `λ`. -/
theorem map_minCut {R R' : Type} [AddCommMonoid R] [LinearOrder R] [AddCommMonoid R']
    [LinearOrder R'] (f : R →+ R') (hf : Monotone f) (H : LabeledHypergraph n E) (r : E → R) :
    f (H.minCut r) = H.minCut (fun e => f (r e)) := by
  have hw : ∀ S, f (H.cutWeight r S) = H.cutWeight (fun e => f (r e)) S := by
    intro S
    simp [cutWeight, map_sum]
  unfold minCut
  split
  · rename_i h
    obtain ⟨S, hS, hmin⟩ := Finset.exists_mem_eq_inf' h (H.cutWeight r)
    apply le_antisymm
    · refine Finset.le_inf' h _ (fun T hT => ?_)
      rw [← hw T]
      exact hf (Finset.inf'_le _ hT)
    · rw [hmin, hw S]
      exact Finset.inf'_le _ hS
  · simp

/-- The real unit minimum cut is the integer `λ`. -/
theorem minCut_one_real (H : LabeledHypergraph n E) :
    H.minCut (fun _ => (1 : ℝ)) = (H.minCutCount : ℝ) := by
  have := map_minCut (Nat.castAddMonoidHom ℝ) Nat.mono_cast H (fun _ => (1 : ℕ))
  simpa [minCutCount] using this.symm

/-- The probability of the failed-label set `D` when each label `e` fails independently with
probability `p e`. -/
def failureMass (p : E → ℝ) (D : Finset E) : ℝ :=
  (∏ e ∈ D, p e) * ∏ e ∈ Dᶜ, (1 - p e)

/-- The probability of an event `A` (a set of failed-label sets) under the independent product law
with failure probabilities `p`. -/
def prodProb (p : E → ℝ) (A : Finset E → Prop) : ℝ :=
  ∑ D : Finset E, if A D then failureMass p D else 0

/-- `A` is increasing in the failed-edge indicators (§9.1, p. 12). -/
def IsIncreasing (A : Finset E → Prop) : Prop :=
  ∀ D D', D ⊆ D' → A D → A D'

/-- The all-terminal unreliability `u_H(p)`: the probability, under independent label failures with
probabilities `p`, that some nonempty proper vertex subset is crossed by no surviving edge
(§1.1, p. 2). -/
def unreliability (H : LabeledHypergraph n E) (p : E → ℝ) : ℝ :=
  prodProb p H.Disconnected

end Cuts

end LabeledHypergraph

end HypergraphUnreliability.FPRAS


