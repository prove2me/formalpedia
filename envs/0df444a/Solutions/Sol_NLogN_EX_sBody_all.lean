    (hNB : zsz N ≤ B) (hsB : zsz s ≤ B) :
    (RS.seq (.asg xM e) (.seq (.push xU (.reg xS)) (.pop xS))).run w =
        ((w.upd xM (.int N' :: LM)).upd xU (.int s :: w.G xU)).upd xS LS ∧
      (RS.seq (.asg xM e) (.seq (.push xU (.reg xS)) (.pop xS))).ok w ∧
      (RS.seq (.asg xM e) (.seq (.push xU (.reg xS)) (.pop xS))).cost w ≤
