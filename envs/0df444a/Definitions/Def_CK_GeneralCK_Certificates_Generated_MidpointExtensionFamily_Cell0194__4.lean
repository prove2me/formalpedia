      unfold centerUpper secondUpper
      nlinarith
    apply hle.trans_lt
    exact lt_of_lt_of_le (by norm_num [centerUpper,secondUpper] :
      centerUpper+secondUpper*(9639/500000:ℝ)^2/24 < 2*(473/2000:ℝ)/(1-(473/2000:ℝ)^2)^2)
