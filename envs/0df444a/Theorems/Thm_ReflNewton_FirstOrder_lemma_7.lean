-- title:
--   Lemma 7, p. 206 — when α_k → 0, reflective steps satisfy f(x_{k+1}) − f(x_k) ≤ α_k g_kᵀs_k + O(α_k²)
-- statement:
--   Assume the compactness and smoothness assumption: the level set $\mathcal L=\{x\in\mathcal F: f(x)\le f(x_1)\}$ is compact and $f$ is twice continuously differentiable on an open set $D\supseteq\mathcal F$. Let $\{x_k\}$ be generated by the interior-reflective algorithm of Fig. 9 with $0<\sigma_l<\sigma_u<1$, $\rho>0$, and let the directions $\{s_k\}$ be constraint-compatible. If $\alpha_k\to0$, then there is a constant $C\ge0$ such that, for all sufficiently large $k$,
--   $$f(x_{k+1})-f(x_k)\le\alpha_k\,g_k^{T}s_k+C\alpha_k^2 .$$
--
--   The change of $f$ along the reflective path is thus governed, to first order, by the linear term $g_k^{T}s_k$ of the unreflected direction, even though the path may have bounced off some faces of the box. This is what Theorem 8 combines with condition (3.5).
--
--   **Formalization Note** The paper states Lemma 7 as the equality $f(x_{k+1})-f(x_k)=\alpha_kg_k^{T}s_k+O(\alpha_k^2)$ under the assumption $\alpha_k\to0$. Its proof ends with "$\le$" via (5.3), and Theorem 8 uses only that inequality; the equality can fail, because a component that reflects changes $g^{T}p$ by an amount of order $\alpha_k$. The Lean statement records this corrected, one-sided asymptotic conclusion. $C$ may depend on the run.
-- source:
--   Coleman & Li, On the convergence of interior-reflective Newton methods for nonlinear minimization subject to bounds, Math. Programming 67 (1994), p. 206, Lemma 7 (proof pp. 206–207, ending with (5.3))

import Mathlib
import Definitions.Def_LewisTorczon_BoundPS_Box
import Definitions.Def_ReflNewton_FirstOrder_Setting
open Filter Topology

namespace ReflNewton.FirstOrder

theorem lemma_7
    {n : ℕ} (l u : Fin n → EReal) (hl : ∀ i, l i ≠ ⊤) (hu : ∀ i, u i ≠ ⊥) (hlu : l ≤ u)
    (f : E n → ℝ) (D : Set (E n)) (hDo : IsOpen D)
    (hFD : LewisTorczon.BoundPS.box l u ⊆ D) (hf : ContDiffOn ℝ 2 f D)
    (σl σu ρ : ℝ) (hσl : 0 < σl) (hσlu : σl < σu) (hσu : σu < 1) (hρ : 0 < ρ)
    (x s : ℕ → E n) (α : ℕ → ℝ) (hrun : IsIRRun l u f σl σu ρ x s α)
    (hL : IsCompact (LewisTorczon.BoundPS.levelSet l u f (x 0)))
    (hcc : IsConstraintCompatible l u f x s)
    (hα : Tendsto α atTop (𝓝 0)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ᶠ k in atTop,
      f (x (k + 1)) - f (x k) ≤ α k * inner ℝ (gradient f (x k)) (s k) + C * α k ^ 2 := by sorry

end ReflNewton.FirstOrder
