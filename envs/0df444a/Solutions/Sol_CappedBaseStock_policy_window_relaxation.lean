section CappedPolicyUploadModule4
noncomputable section
open MeasureTheory Filter CappedBaseStock Finset
open scoped ENNReal NNReal BigOperators

namespace CappedPolicyMoments

lemma summand_ne_top_of_limsup_average_lt_top (a : ℕ → ℝ≥0∞)
    (hfin : Filter.limsup (fun T : ℕ =>
      (∑ t ∈ range (T + 1), a t) / (T + 1 : ℝ≥0∞)) atTop < ⊤) (t : ℕ) : a t ≠ ⊤ := by
  intro ht
  have hev : (fun T : ℕ => (∑ t ∈ range (T + 1), a t) / (T + 1 : ℝ≥0∞))
      =ᶠ[atTop] (fun _ => ⊤) := by
    filter_upwards [eventually_ge_atTop t] with T hT
    have hsum : (∑ s ∈ range (T + 1), a s) = ⊤ := by
      apply top_unique
      rw [← ht]
      exact Finset.single_le_sum (fun _ _ => bot_le) (mem_range.mpr (by omega))
    rw [hsum]
    exact ENNReal.top_div_of_ne_top (by simp)
  rw [Filter.limsup_congr hev, Filter.limsup_const] at hfin
  exact (lt_irrefl _ hfin)

lemma period_integral_ne_top (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    (∫⁻ ω, periodCost c (run c π ω t) (ω.1 t) ∂sampleLaw P) ≠ ⊤ := by
  exact summand_ne_top_of_limsup_average_lt_top _ hfinite t

lemma inventory_lintegral_ne_top (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    (∫⁻ ω, ((run c π ω t).1 : ℝ≥0∞) ∂sampleLaw P) ≠ ⊤ := by
  cases t with
  | zero => simp [run, initialState]
  | succ t =>
    have hcost := period_integral_ne_top P c π hfinite t
    have hle : ENNReal.ofReal c.h *
        (∫⁻ ω, ((run c π ω (t + 1)).1 : ℝ≥0∞) ∂sampleLaw P) ≤
        ∫⁻ ω, periodCost c (run c π ω t) (ω.1 t) ∂sampleLaw P := by
      rw [← lintegral_const_mul' _ _ (by simp)]
      apply lintegral_mono
      intro ω
      exact le_add_right le_rfl
    have hprod : ENNReal.ofReal c.h *
        (∫⁻ ω, ((run c π ω (t + 1)).1 : ℝ≥0∞) ∂sampleLaw P) ≠ ⊤ :=
      ne_top_of_le_ne_top hcost hle
    intro ht
    rw [ht, ENNReal.mul_top (by simpa using c.holding_pos)] at hprod
    exact hprod rfl

lemma integrable_inventory (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    Integrable (fun ω => ((run c π ω t).1 : ℝ)) (sampleLaw P) := by
  have hm : Measurable (fun ω => ((run c π ω t).1 : ℝ≥0∞)) :=
    (CappedPolicyDynamics.measurable_run c π t).fst.coe_nnreal_ennreal
  have hi := integrable_toReal_of_lintegral_ne_top hm.aemeasurable
    (inventory_lintegral_ne_top P c π hfinite t)
  simpa only [ENNReal.coe_toReal] using hi

lemma integrable_sample_demand (P : DemandLaw) (t : ℕ) :
    Integrable (fun ω : Sample => (ω.1 t : ℝ)) (sampleLaw P) :=
  (CappedJensenFinish.integrable_demand_coordinate P t).comp_fst seedLaw

lemma integral_sample_demand (P : DemandLaw) (t : ℕ) :
    (∫ ω : Sample, (ω.1 t : ℝ) ∂sampleLaw P) = mean P := by
  change (∫ ω : Sample, (fun d : DemandPath => (d t : ℝ)) ω.1
    ∂(demandPathLaw P).prod seedLaw) = mean P
  rw [integral_fun_fst (μ := demandPathLaw P) (ν := seedLaw)
    (fun d : DemandPath => (d t : ℝ))]
  simp [CappedJensenFinish.integral_demand_coordinate, measureReal_def]

lemma integrable_order (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    Integrable (fun ω => (order π t ω : ℝ)) (sampleLaw P) := by
  apply ((integrable_inventory P c π hfinite (t + c.L + 1)).add
    (integrable_sample_demand P (t + c.L))).mono'
  · exact (CappedPolicyDynamics.measurable_order π t).coe_nnreal_real.aestronglyMeasurable
  · filter_upwards [] with ω
    rw [Real.norm_of_nonneg (NNReal.coe_nonneg _)]
    exact_mod_cast CappedPolicyDynamics.order_le_future_inventory_demand c π ω t

lemma integrable_arrival (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    Integrable (fun ω => (arrival c (run c π ω t) : ℝ)) (sampleLaw P) := by
  simp_rw [CappedPolicyDynamics.arrival_run]
  by_cases ht : c.L ≤ t
  · simpa only [if_pos ht] using integrable_order P c π hfinite (t - c.L)
  · simp only [if_neg ht, NNReal.coe_zero]
    exact integrable_const 0

lemma integrable_filledDemand (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) :
    Integrable (fun ω => (filledDemand c (run c π ω t) (ω.1 t) : ℝ)) (sampleLaw P) := by
  apply (integrable_sample_demand P t).mono'
  · have hm := CappedPolicyDynamics.measurable_run c π t
    unfold filledDemand arrival
    fun_prop
  · filter_upwards [] with ω
    rw [Real.norm_of_nonneg (NNReal.coe_nonneg _)]
    exact_mod_cast CappedPolicyDynamics.filledDemand_le_demand c (run c π ω t) (ω.1 t)

lemma integrable_lostSales (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) :
    Integrable (fun ω => (lostSales c (run c π ω t) (ω.1 t) : ℝ)) (sampleLaw P) := by
  simp_rw [CappedPolicyDynamics.lostSales_eq_sub_filledDemand_real]
  exact (integrable_sample_demand P t).sub (integrable_filledDemand P c π t)

def inventoryMean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) : ℝ :=
  ∫ ω, ((run c π ω t).1 : ℝ) ∂sampleLaw P

def orderMean (P : DemandLaw) (π : AdmissiblePolicy) (t : ℕ) : ℝ :=
  ∫ ω, (order π t ω : ℝ) ∂sampleLaw P

def arrivalMean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) : ℝ :=
  ∫ ω, (arrival c (run c π ω t) : ℝ) ∂sampleLaw P

def salesMean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) : ℝ :=
  ∫ ω, (filledDemand c (run c π ω t) (ω.1 t) : ℝ) ∂sampleLaw P

def periodMean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) : ℝ :=
  c.h * inventoryMean P c π (t + 1) + c.p * (mean P - salesMean P c π t)

lemma inventoryMean_nonneg (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    0 ≤ inventoryMean P c π t := integral_nonneg (fun _ => NNReal.coe_nonneg _)

lemma orderMean_nonneg (P : DemandLaw) (π : AdmissiblePolicy) (t : ℕ) :
    0 ≤ orderMean P π t := integral_nonneg (fun _ => NNReal.coe_nonneg _)

lemma salesMean_nonneg (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    0 ≤ salesMean P c π t := integral_nonneg (fun _ => NNReal.coe_nonneg _)

lemma salesMean_le_mean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    salesMean P c π t ≤ mean P := by
  rw [← integral_sample_demand P t]
  apply integral_mono (integrable_filledDemand P c π t) (integrable_sample_demand P t)
  intro ω
  exact_mod_cast CappedPolicyDynamics.filledDemand_le_demand c (run c π ω t) (ω.1 t)

lemma orderMean_le (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    orderMean P π t ≤ inventoryMean P c π (t + c.L + 1) + mean P := by
  rw [← integral_sample_demand P (t + c.L)]
  unfold orderMean inventoryMean
  rw [← integral_add (integrable_inventory P c π hfinite _) (integrable_sample_demand P _)]
  apply integral_mono (integrable_order P c π hfinite _)
    ((integrable_inventory P c π hfinite _).add (integrable_sample_demand P _))
  intro ω
  exact_mod_cast CappedPolicyDynamics.order_le_future_inventory_demand c π ω t

lemma mean_flow (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    inventoryMean P c π (t + 1) + salesMean P c π t =
      inventoryMean P c π t + arrivalMean P c π t := by
  unfold inventoryMean salesMean arrivalMean
  rw [← integral_add (integrable_inventory P c π hfinite _) (integrable_filledDemand P c π _),
    ← integral_add (integrable_inventory P c π hfinite _) (integrable_arrival P c π hfinite _)]
  apply integral_congr_ae
  filter_upwards [] with ω
  exact CappedPolicyDynamics.inventory_flow_real c π ω t

lemma arrivalMean_eq (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    arrivalMean P c π t = if c.L ≤ t then orderMean P π (t - c.L) else 0 := by
  unfold arrivalMean orderMean
  simp_rw [CappedPolicyDynamics.arrival_run]
  split_ifs <;> simp

lemma inventoryMean_zero (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) :
    inventoryMean P c π 0 = 0 := by simp [inventoryMean, run, initialState]

lemma periodMean_nonneg (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    0 ≤ periodMean P c π t := by
  exact add_nonneg (mul_nonneg c.holding_pos.le (inventoryMean_nonneg _ _ _ _))
    (mul_nonneg c.penalty_pos.le (sub_nonneg.mpr (salesMean_le_mean _ _ _ _)))

lemma integral_lostSales (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    (∫ ω, (lostSales c (run c π ω t) (ω.1 t) : ℝ) ∂sampleLaw P) =
      mean P - salesMean P c π t := by
  simp_rw [CappedPolicyDynamics.lostSales_eq_sub_filledDemand_real]
  rw [integral_sub (integrable_sample_demand P t) (integrable_filledDemand P c π t),
    integral_sample_demand]
  rfl

lemma lintegral_periodCost_eq (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    (∫⁻ ω, periodCost c (run c π ω t) (ω.1 t) ∂sampleLaw P) =
      ENNReal.ofReal (periodMean P c π t) := by
  have heq (ω : Sample) : periodCost c (run c π ω t) (ω.1 t) =
      ENNReal.ofReal (c.h * ((run c π ω (t + 1)).1 : ℝ) +
        c.p * (lostSales c (run c π ω t) (ω.1 t) : ℝ)) := by
    rw [ENNReal.ofReal_add (mul_nonneg c.holding_pos.le (NNReal.coe_nonneg _))
      (mul_nonneg c.penalty_pos.le (NNReal.coe_nonneg _)),
      ENNReal.ofReal_mul c.holding_pos.le, ENNReal.ofReal_mul c.penalty_pos.le]
    simp only [ENNReal.ofReal_coe_nnreal, periodCost, run, step]
  simp_rw [heq]
  have hint : Integrable (fun ω => c.h * ((run c π ω (t + 1)).1 : ℝ) +
      c.p * (lostSales c (run c π ω t) (ω.1 t) : ℝ)) (sampleLaw P) :=
    ((integrable_inventory P c π hfinite (t + 1)).const_mul c.h).add
      ((integrable_lostSales P c π t).const_mul c.p)
  rw [← ofReal_integral_eq_lintegral_ofReal hint (by
        filter_upwards [] with ω
        exact add_nonneg
          (mul_nonneg c.holding_pos.le (NNReal.coe_nonneg _))
          (mul_nonneg c.penalty_pos.le (NNReal.coe_nonneg _)))]
  rw [integral_add ((integrable_inventory P c π hfinite (t + 1)).const_mul c.h)
      ((integrable_lostSales P c π t).const_mul c.p),
    integral_const_mul, integral_const_mul, integral_lostSales]
  rfl

def meanAverage (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (T : ℕ) : ℝ :=
  (∑ t ∈ range (T + 1), periodMean P c π t) / (T + 1 : ℝ)

lemma meanAverage_nonneg (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (T : ℕ) :
    0 ≤ meanAverage P c π T :=
  div_nonneg (Finset.sum_nonneg (fun _ _ => periodMean_nonneg _ _ _ _)) (by positivity)

lemma policyCost_eq_limsup_ofReal (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) :
    policyCost P c π = Filter.limsup
      (fun T => ENNReal.ofReal (meanAverage P c π T)) atTop := by
  unfold policyCost averageCost
  congr 1
  funext T
  rw [meanAverage, ENNReal.ofReal_div_of_pos (by positivity),
    ENNReal.ofReal_sum_of_nonneg (fun _ _ => periodMean_nonneg _ _ _ _)]
  simp_rw [lintegral_periodCost_eq P c π hfinite]
  norm_cast

lemma eventually_meanAverage_lt (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ T in atTop, meanAverage P c π T < (policyCost P c π).toReal + ε := by
  have hpos : 0 < (policyCost P c π).toReal + ε :=
    add_pos_of_nonneg_of_pos ENNReal.toReal_nonneg hε
  have hlt : policyCost P c π < ENNReal.ofReal ((policyCost P c π).toReal + ε) := by
    conv_lhs => rw [← ENNReal.ofReal_toReal hfinite.ne]
    apply (ENNReal.ofReal_lt_ofReal_iff hpos).mpr
    linarith
  conv_lhs at hlt => rw [policyCost_eq_limsup_ofReal P c π hfinite]
  exact (Filter.eventually_lt_of_limsup_lt hlt).mono
    (fun T hT => (ENNReal.ofReal_lt_ofReal_iff hpos).mp hT)

lemma holding_le_periodMean (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    c.h * inventoryMean P c π (t + 1) ≤ periodMean P c π t := by
  exact le_add_of_nonneg_right
    (mul_nonneg c.penalty_pos.le (sub_nonneg.mpr (salesMean_le_mean _ _ _ _)))

lemma holding_prefix_le_cost_sum (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (T : ℕ) :
    c.h * (∑ t ∈ range T, inventoryMean P c π t) ≤
      ∑ t ∈ range T, periodMean P c π t := by
  have hshift : (∑ t ∈ range T, inventoryMean P c π (t + 1)) =
      (∑ t ∈ range T, inventoryMean P c π t) + inventoryMean P c π T := by
    induction T with
    | zero => simp [inventoryMean_zero]
    | succ T ih => simp only [sum_range_succ, ih]
  calc
    _ ≤ c.h * (∑ t ∈ range T, inventoryMean P c π (t + 1)) := by
      rw [hshift]
      exact mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (inventoryMean_nonneg _ _ _ _))
        c.holding_pos.le
    _ = ∑ t ∈ range T, c.h * inventoryMean P c π (t + 1) := by rw [mul_sum]
    _ ≤ _ := Finset.sum_le_sum (fun t _ => holding_le_periodMean P c π t)

lemma eventually_inventory_prefix_le (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) :
    ∀ᶠ T in atTop, (∑ t ∈ range T, inventoryMean P c π t) ≤
      (((policyCost P c π).toReal + 1) / c.h) * (T : ℝ) := by
  have havg := eventually_meanAverage_lt P c π hfinite 1 (by norm_num)
  have hshift : ∀ᶠ T in atTop,
      meanAverage P c π (T - 1) < (policyCost P c π).toReal + 1 :=
    (tendsto_sub_atTop_nat 1).eventually havg
  filter_upwards [hshift, eventually_ge_atTop 1] with T hT hpos
  have hpred : T - 1 + 1 = T := by omega
  unfold meanAverage at hT
  rw [hpred] at hT
  have hn : 0 < (T : ℝ) := by exact_mod_cast hpos
  have hcast : (↑(T - 1) : ℝ) + 1 = (T : ℝ) := by exact_mod_cast hpred
  rw [hcast] at hT
  have hcost : (∑ t ∈ range T, periodMean P c π t) ≤
      ((policyCost P c π).toReal + 1) * (T : ℝ) := (div_lt_iff₀ hn).mp hT |>.le
  have hholding := holding_prefix_le_cost_sum P c π T
  rw [div_mul_eq_mul_div]
  apply (le_div_iff₀ c.holding_pos).mpr
  rw [mul_comm]
  exact hholding.trans hcost

end CappedPolicyMoments
end
