-- title:
--   Igusa test datum with rational N-torsion and injective reduction
-- statement:
--   Let $K$ be an algebraically closed field, let $N \ge 1$ with $N \ne 0$ in $K$, and let $x$ be a point of the moduli set $\mathrm{ModuliPoint}\ N\ K$, i.e. a class, modulo Weierstrass variable changes combined with replacing the marked point by a coprime-to-$N$ multiple of it, of pairs consisting of an elliptic Weierstrass curve over $K$ and a point of exact additive order $N$ on its affine model. The assertion is that there is a field $\Omega$ of the same universe, equipped with a $K$-algebra structure, and a datum $D : \mathrm{ModuliTestDatum}\ K\ N\ x\ \Omega$ — a place $W$ of $\Omega$ over $K$ (a proper valuation subring containing the image of $K$ and a principal ideal ring), a Weierstrass curve $D.\mathrm{curve}$ over $\mathcal O_W$ whose reduction modulo the maximal ideal has $\Delta \ne 0$, a point $D.\mathrm{gen}$ of exact order $N$ on the generic fibre, a ring retraction $\mathrm{res}$ of the residue field onto $K$ fixing $K$, the requirement that the reduction of $D.\mathrm{gen}$ again has exact order $N$ and that the reduced pair, transported by $\mathrm{res}$, is the class $x$, together with a $K$-algebra embedding $\mathrm{emb}$ of $\mathrm{modularFunctionFieldFullC}\ K\ N$ into $\Omega$ sending $\mathrm{jqNFull}\ K\ N\ d$, for each $d \mid N$, to the $j$-invariant of the quotient of the generic fibre by the subgroup generated by $(N/d) \cdot D.\mathrm{gen}$ (after base change to any algebraically closed extension) — which in addition satisfies: for every $n \mid N$ the set of points $P$ of the generic fibre $D.\mathrm{curve}$ over $\Omega$ with $n \cdot P = 0$ has exactly $n^2$ elements; and every point $P$ of the generic fibre with $N \cdot P = 0$ whose image under the reduction homomorphism $\mathrm{reduceHom}$ vanishes is itself $0$.
--
--   This is the existence of Igusa-style test data for points of the moduli set attached to $\Gamma_0(N)$, strengthened by two properties of the construction: the full $n$-torsion of the generic fibre is rational over $\Omega$ for every $n \mid N$, and reduction is injective on $N$-torsion. It feeds the construction of the Galois-equivariant comparison between places of the modular function field and cyclic subgroups of the generic curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_moduliTestDatum_natCard_torsion_eq_sq.lean

import Mathlib
import Definitions.Def_ModularCurve_ModuliPlace

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open AlgebraicCurve ModularCurve WeierstrassCurve

universe u in

theorem ModularCurve.exists_moduliTestDatum_natCard_torsion_eq_sq
    (K : Type u) [Field K] [IsAlgClosed K] [DecidableEq K] (N : ℕ) [NeZero N] (hN : (N : K) ≠ 0)
    (x : ModuliPoint N K) :
    ∃ (Ω : Type u) (_ : Field Ω) (_ : DecidableEq Ω) (_ : Algebra K Ω) (D : ModuliTestDatum K N x Ω),
      (∀ n : ℕ, n ∣ N →
        Nat.card {P : (D.curve.map D.W.toValuationSubring.subtype).toAffine.Point // n • P = 0}
          = n ^ 2) ∧
      ∀ [DecidableEq (IsLocalRing.ResidueField D.W.toValuationSubring)]
        (P : (D.curve.map D.W.toValuationSubring.subtype).toAffine.Point),
        N • P = 0 → reduceHom D.map_Δ_ne_zero P = 0 → P = 0 := by sorry
