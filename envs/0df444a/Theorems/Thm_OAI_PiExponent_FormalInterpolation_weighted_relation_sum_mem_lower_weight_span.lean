theorem OAI.PiExponent.FormalInterpolation.weighted_relation_sum_mem_lower_weight_span {d : Nat} (W : Fin d → Nat) (n : Nat) (i : Fin d) (m : Nat) (p q : Fin m → MvPolynomial (Fin d) ℂ) (hq : ∀ j, q j ∈ Submodule.span ℂ {f : MvPolynomial (Fin d) ℂ | ∃ a : Fin d →₀ Nat, (∑ k : Fin d, a k * W k) < n * W i ∧ f = MvPolynomial.monomial a (1 : ℂ)}) : (∑ j, q j * p j) ∈ Submodule.span (Algebra.adjoin ℂ (Set.range p)) {f : MvPolynomial (Fin d) ℂ | ∃ a : Fin d →₀ Nat, (∑ k : Fin d, a k * W k) < n * W i ∧ f = MvPolynomial.monomial a (1 : ℂ)} := by sorry
