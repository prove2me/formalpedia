theorem balConv_bound (B : ℤ) (hB : 0 < B) : ∀ (l : List ℤ) (c : ℤ), (∀ d ∈ l, 0 ≤ d ∧ d < B) →
    (c = 0 ∨ c = 1) → ∀ y ∈ balConv B l c, |y| ≤ B
  | [], _, _, _ => by simp [balConv]
  | d :: l, c, hd, hc => by
    have h0 := hd d (by simp)
    have ih := balConv_bound B hB l
    simp only [balConv]
    split_ifs with h
    · intro y hy
      rcases List.mem_cons.1 hy with rfl | hy
      · rw [abs_le]; constructor <;> omega
      · exact ih 1 (fun x hx => hd x (by simp [hx])) (Or.inr rfl) y hy
    · intro y hy
      rcases List.mem_cons.1 hy with rfl | hy
      · rw [abs_le]; constructor <;> omega
      · exact ih 0 (fun x hx => hd x (by simp [hx])) (Or.inl rfl) y hy

theorem chunksL_bound (b L x : ℕ) : ∀ d ∈ chunksL b L x, 0 ≤ d ∧ d < 2 ^ b := by
  intro d hd
  simp only [chunksL, List.mem_map] at hd
  obtain ⟨k, _, rfl⟩ := hd
  have : x / 2 ^ (b * k) % 2 ^ b < 2 ^ b := Nat.mod_lt _ (by positivity)
  constructor
  · positivity
  · exact_mod_cast this

