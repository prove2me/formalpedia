      primitiveRowIntegral v s freq (cosetRow x 0) (cosetRow x 1) := by
  apply integral_congr_ae
  exact Eventually.of_forall fun z => by
    dsimp only
    rw [summand_upperSection,inverse_cosetCharacter_eq_row_symbol]
    rfl
