section
-- Source module: NLogNP.SM
/-!
# A multi-stack machine language with procedures

`Stmt S P` is a structured program over `S` stacks of symbols (`Fin 16`) that may call any of
`P` procedures (recursively).  It reads the input word with `inRd` and writes output bits with
`out`.  `Exec` is its big-step semantics; the cost is the number of steps of the flat machine
the program compiles to (`NLogN.Flat`); each flat step is at most two Turing machine steps.
-/

namespace NLogN

/-- Stack symbols. -/
abbrev Sym := Fin 16

/-- Codes of input symbols. -/
def codeBit (b : Bool) : Sym := if b then 1 else 0
def codeSep : Sym := 2
def codeEnd : Sym := 3

/-- The input word `x # y` as codes. -/
def inputCodes (x y : List Bool) : List Sym := x.map codeBit ++ codeSep :: y.map codeBit

/-- Structured programs. Tests look at the top of one stack (`none` if it is empty). -/
inductive Stmt (S P : ℕ) where
  | skip
  | push (i : Fin S) (a : Sym)
  | pop (i : Fin S)
  | inRd (i : Fin S)
  | out (b : Bool)
  | seq (p q : Stmt S P)
  | ite (i : Fin S) (f : Option Sym → Bool) (p q : Stmt S P)
  | loop (i : Fin S) (f : Option Sym → Bool) (p : Stmt S P)
  | call (j : Fin P)

/-- Machine state: stacks (head of each list is the top), input position, output so far. -/
@[ext] structure St (S : ℕ) where
  stk : Fin S → List Sym
  ip : ℕ
  out : List Bool

namespace St

variable {S : ℕ}

def top (σ : St S) (i : Fin S) : Option Sym := (σ.stk i).head?

def push (σ : St S) (i : Fin S) (a : Sym) : St S :=
  { σ with stk := Function.update σ.stk i (a :: σ.stk i) }

def pop (σ : St S) (i : Fin S) : St S :=
  { σ with stk := Function.update σ.stk i (σ.stk i).tail }

/-- Read the next input code onto stack `i`. -/
def inRd (I : List Sym) (σ : St S) (i : Fin S) : St S :=
  { σ with stk := Function.update σ.stk i (I.getD σ.ip codeEnd :: σ.stk i), ip := σ.ip + 1 }

def outB (σ : St S) (b : Bool) : St S := { σ with out := σ.out ++ [b] }

end St

/-- Big-step semantics with exact cost. `I` is the input word, `prog` the procedures. -/
inductive Exec {S P : ℕ} (I : List Sym) (prog : Fin P → Stmt S P) :
    Stmt S P → St S → St S → ℕ → Prop
  | skip (σ) : Exec I prog .skip σ σ 1
  | push (σ i a) : Exec I prog (.push i a) σ (σ.push i a) 1
  | pop (σ i) : Exec I prog (.pop i) σ (σ.pop i) 1
  | inRd (σ i) : Exec I prog (.inRd i) σ (σ.inRd I i) 1
  | out (σ b) : Exec I prog (.out b) σ (σ.outB b) 1
  | seq {p q σ σ₁ σ₂ c₁ c₂} : Exec I prog p σ σ₁ c₁ → Exec I prog q σ₁ σ₂ c₂ →
      Exec I prog (.seq p q) σ σ₂ (c₁ + c₂)
  | iteT {i f p q σ σ' c} : f (σ.top i) = true → Exec I prog p σ σ' c →
      Exec I prog (.ite i f p q) σ σ' (c + 1)
  | iteF {i f p q σ σ' c} : f (σ.top i) = false → Exec I prog q σ σ' c →
      Exec I prog (.ite i f p q) σ σ' (c + 1)
  | loopT {i f p σ σ₁ σ₂ c₁ c₂} : f (σ.top i) = true → Exec I prog p σ σ₁ c₁ →
      Exec I prog (.loop i f p) σ₁ σ₂ c₂ → Exec I prog (.loop i f p) σ σ₂ (c₁ + c₂ + 1)
  | loopF {i f p σ} : f (σ.top i) = false → Exec I prog (.loop i f p) σ σ 1
  | call {j σ σ' c} : Exec I prog (prog j) σ σ' c → Exec I prog (.call j) σ σ' (c + 2)

namespace Exec

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

end Exec

end NLogN

end

