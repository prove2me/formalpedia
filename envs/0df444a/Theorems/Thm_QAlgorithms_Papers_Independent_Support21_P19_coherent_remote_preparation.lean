attribute [local instance] Classical.propDecidable Classical.decEq

/-- PDF p.3, Eq. (5): no external entanglement; startup is generated by counted cobits. -/
theorem coherent_remote_preparation : RemoteRate (cobitChannel 2) 1 0 := by sorry

end QAlgorithms.Papers.Independent.Support21.P19

