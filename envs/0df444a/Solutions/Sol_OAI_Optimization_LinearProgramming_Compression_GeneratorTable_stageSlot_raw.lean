      simpa [t,vi26,show j ≠ dst+2+2*n by omega] using eq
    · intro j h26 h27 h28 h29 h30
      exact (rv.indices j h26 h27 h28 h29 h30).trans ((rr.indices j h26 h27 h28 h29 h30).trans (cidx j h26 h27 h30))

