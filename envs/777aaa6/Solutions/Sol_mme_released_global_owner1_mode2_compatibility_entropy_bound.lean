      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row6 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row7 w
      · exact mme_released_global_owner1_mode2_compatibility_interior_mass_row8 w
  have hb (s : Fin 45) (w : Word) : (x (Sum.inl s) w : ℝ) =
      if yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, shapeEquiv s⟩ then (profile 1).2 2 ⟨0, shapeEquiv s⟩ w else 0 := by
    rw [hid]
    change ((if yzBoundary (half := 8) (parent := fun (_ : Fin 1) (_ : Fin 3) ↦ 8) 1 ⟨0, shape s⟩ then rowMass s w else 0 : ℚ) : ℝ) =
