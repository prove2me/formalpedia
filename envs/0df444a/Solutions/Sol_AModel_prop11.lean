namespace Layout

lemma actIdx_some {k : ℕ} {i : Fin n} (h : Λ.actIdx k = some i) : (Λ.pos i : ℕ) = k := by
  have := List.find?_some h
  simpa using this

lemma actIdx_pos (i : Fin n) : Λ.actIdx (Λ.pos i) = some i := by
  cases h : Λ.actIdx (Λ.pos i) with
  | none =>
    unfold actIdx at h
    rw [List.find?_eq_none] at h
    exact absurd (by simp) (h i (List.mem_finRange i))
  | some r => rw [Λ.mono.injective (Fin.ext (Λ.actIdx_some h))]

lemma actIdx_none {k : ℕ} (h : Λ.actIdx k = none) (i : Fin n) : (Λ.pos i : ℕ) ≠ k := by
  rintro rfl; rw [Λ.actIdx_pos] at h; cases h

end Layout

@[simp] lemma length_setAct (a : List ℕ) (v : Fin n → ZMod Q) :
    (setAct Λ a v).length = a.length := by simp [setAct]

lemma getElem_setAct (a : List ℕ) (v : Fin n → ZMod Q) (k : ℕ)
    (hk : k < (setAct Λ a v).length) :
    (setAct Λ a v)[k] = match Λ.actIdx k with
      | some i => (v i).val
      | none => a[k]'(by simpa using hk) := by
  simp [setAct]
  try (first | rfl | (split <;> rfl))

lemma getElem_setAct_pos (a : List ℕ) (v : Fin n → ZMod Q) (i : Fin n)
    (hk : (Λ.pos i : ℕ) < (setAct Λ a v).length) :
    (setAct Λ a v)[(Λ.pos i : ℕ)] = (v i).val := by
  rw [getElem_setAct, Λ.actIdx_pos]

lemma setAct_setAct (a : List ℕ) (v w : Fin n → ZMod Q) :
    setAct Λ (setAct Λ a v) w = setAct Λ a w := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  simp only [getElem_setAct]
  cases Λ.actIdx k <;> rfl

lemma Valid.digit_lt {a : List ℕ} (ha : Valid sh a) (i : Fin n) :
    a.getD (Λ.pos i) 0 < Q := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  have h2 : (Λ.pos i : ℕ) < sh.length := (Λ.pos i).2
  have h1 : (Λ.pos i : ℕ) < a.length := by omega
  have := hlt _ h1 h2
  have hs := Λ.size i
  simp only [List.get_eq_getElem] at hs
  rw [List.getD_eq_getElem _ _ h1]; simpa [hs] using this

lemma valid_setAct [NeZero Q] {a : List ℕ} (ha : Valid sh a) (v : Fin n → ZMod Q) :
    Valid sh (setAct Λ a v) := by
  obtain ⟨hl, hlt⟩ := (valid_iff sh a).1 ha
  refine (valid_iff _ _).2 ⟨by simp [hl], fun k h₁ h₂ => ?_⟩
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none => exact hlt _ _ _
  | some i =>
    have hk := Λ.actIdx_some h
    subst hk
    have := Λ.size i
    simp only [List.get_eq_getElem] at this
    simp only [this]
    exact ZMod.val_lt _

lemma act_setAct [NeZero Q] {a : List ℕ} (ha : Valid sh a) (v : Fin n → ZMod Q) :
    act Λ (setAct Λ a v) = v := by
  funext i
  have h1 : (Λ.pos i : ℕ) < (setAct Λ a v).length := by simp [ha.length_eq]
  rw [act, List.getD_eq_getElem _ _ h1, getElem_setAct_pos, ZMod.natCast_zmod_val]

lemma setAct_act {a : List ℕ} (ha : Valid sh a) : setAct Λ a (act Λ a) = a := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none => rfl
  | some i =>
    have hk := Λ.actIdx_some h
    have hd := ha.digit_lt Λ i
    simp only [act, ZMod.val_natCast, Nat.mod_eq_of_lt hd]
    rw [List.getD_eq_getElem _ _ (by omega)]
    simp [hk]

lemma valid_vmap [NeZero Q] (F : (Fin n → ZMod Q) → (Fin n → ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : Valid sh (vmap Λ F a) := valid_setAct Λ ha _

lemma vmap_vmap [NeZero Q] (F G : (Fin n → ZMod Q) → (Fin n → ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : vmap Λ G (vmap Λ F a) = vmap Λ (G ∘ F) a := by
  simp only [vmap, act_setAct Λ ha, setAct_setAct, Function.comp_apply]

lemma vmap_id {a : List ℕ} (ha : Valid sh a) : vmap Λ id a = a := setAct_act Λ ha

lemma amap_eq_vmap (L : Matrix (Fin n) (Fin n) (ZMod Q)) : amap Λ L = vmap Λ (L *ᵥ ·) := rfl

lemma valid_amap [NeZero Q] (L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : Valid sh (amap Λ L a) := valid_setAct Λ ha _

lemma amap_mul [NeZero Q] (M L : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : Valid sh a) : amap Λ M (amap Λ L a) = amap Λ (M * L) a := by
  rw [amap_eq_vmap, amap_eq_vmap, vmap_vmap Λ _ _ ha, amap_eq_vmap]
  congr 1; funext x; simp [Matrix.mulVec_mulVec]

lemma amap_one {a : List ℕ} (ha : Valid sh a) : amap Λ 1 a = a := by
  rw [amap_eq_vmap]; convert vmap_id Λ ha using 2; funext x; simp

section Shift

lemma sum_update_of_eq_zero (i : Fin n) (c x : Fin n → ZMod Q) (y : ZMod Q) (hc : c i = 0) :
    ∑ j, c j * Function.update x i y j = ∑ j, c j * x j := by
  refine Finset.sum_congr rfl fun j _ => ?_
  by_cases hj : j = i
  · subst hj; simp [hc]
  · simp [Function.update_of_ne hj]

lemma shiftInvVec_shiftVec {i : Fin n} {u : ZMod Q} {c : Fin n → ZMod Q} (hu : IsUnit u)
    (hc : ∀ j, i ≤ j → c j = 0) (x : Fin n → ZMod Q) :
    shiftInvVec i u c (shiftVec i u c x) = x := by
  unfold shiftInvVec shiftVec
  rw [sum_update_of_eq_zero _ _ _ _ (hc i le_rfl), Function.update_self, add_sub_cancel_right,
    ← mul_assoc, ZMod.inv_mul_of_unit _ hu, one_mul, Function.update_idem,
    Function.update_eq_self]

lemma shiftVec_shiftInvVec {i : Fin n} {u : ZMod Q} {c : Fin n → ZMod Q} (hu : IsUnit u)
    (hc : ∀ j, i ≤ j → c j = 0) (y : Fin n → ZMod Q) :
    shiftVec i u c (shiftInvVec i u c y) = y := by
  unfold shiftInvVec shiftVec
  rw [sum_update_of_eq_zero _ _ _ _ (hc i le_rfl), Function.update_self,
    ← mul_assoc, ZMod.mul_inv_of_unit _ hu, one_mul, sub_add_cancel, Function.update_idem,
    Function.update_eq_self]

end Shift

section Swap

lemma val_act [NeZero Q] {a : List ℕ} (ha : Valid sh a) (i : Fin n) :
    (act Λ a i).val = a.getD (Λ.pos i) 0 := by
  rw [act, ZMod.val_natCast, Nat.mod_eq_of_lt (ha.digit_lt Λ i)]

theorem swapMap_eq_vmap [NeZero Q] (i j : Fin n) {a : List ℕ} (ha : Valid sh a) :
    swapMap Λ i j a = vmap Λ (fun x => x ∘ Equiv.swap i j) a := by
  have hl := ha.length_eq
  apply List.ext_getElem (by simp [swapMap, vmap])
  intro k h₁ h₂
  simp only [vmap] at h₂ ⊢
  rw [getElem_setAct]
  simp only [swapMap, List.getElem_set]
  have inj : ∀ p q : Fin n, ((Λ.pos p : ℕ) = Λ.pos q) ↔ p = q := fun p q =>
    ⟨fun h => Λ.mono.injective (Fin.ext h), fun h => h ▸ rfl⟩
  cases h : Λ.actIdx k with
  | none =>
    have := Λ.actIdx_none h
    simp [this i, this j]
  | some m =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only [Function.comp_apply, val_act Λ ha, inj, Equiv.swap_apply_def]
    have hm : (Λ.pos m : ℕ) < a.length := by omega
    by_cases hmj : j = m
    · subst hmj
      by_cases hij : j = i
      · subst hij; simp
      · simp [hij]
    · by_cases hmi : i = m
      · subst hmi; simp [hmj]
      · simp [hmj, hmi, Ne.symm hmj, Ne.symm hmi, List.getElem?_eq_getElem hm]

end Swap

namespace Step

lemma invVec_vec {s : Step n Q} (hs : s.WF) (x : Fin n → ZMod Q) : s.invVec (s.vec x) = x := by
  cases s with
  | shift i u c => exact shiftInvVec_shiftVec hs.1 hs.2 x
  | swap i j => funext k; simp [vec, invVec]

variable [NeZero Q]

lemma addr_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.addr Λ a = vmap Λ s.vec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma inv_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.inv Λ a = vmap Λ s.invVec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma valid_addr (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.addr Λ a) := by
  rw [addr_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma valid_inv (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.inv Λ a) := by
  rw [inv_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma inv_addr {s : Step n Q} (hs : s.WF) {a : List ℕ} (ha : Valid sh a) :
    s.inv Λ (s.addr Λ a) = a := by
  rw [addr_eq Λ s ha, inv_eq Λ s (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
  convert vmap_id Λ ha using 2
  funext x; exact invVec_vec hs x

end Step

section Run
variable [NeZero Q]

lemma run_eq_vmap (steps : List (Step n Q)) {a : List ℕ} (ha : Valid sh a) :
    run Λ steps a = vmap Λ (runVec steps) a := by
  induction steps generalizing a with
  | nil => exact (vmap_id Λ ha).symm
  | cons s rest ih =>
    simp only [run, List.foldl_cons] at ih ⊢
    rw [Step.addr_eq Λ s ha, ih (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
    rfl

lemma valid_run (steps : List (Step n Q)) {a : List ℕ} (ha : Valid sh a) :
    Valid sh (run Λ steps a) := by
  rw [run_eq_vmap Λ steps ha]; exact valid_vmap Λ _ ha

lemma invChain_run {steps : List (Step n Q)} (hs : ∀ s ∈ steps, s.WF) {a : List ℕ}
    (ha : Valid sh a) : invChain Λ steps (run Λ steps a) = a := by
  induction steps generalizing a with
  | nil => rfl
  | cons s rest ih =>
    simp only [run, List.foldl_cons, invChain, List.foldr_cons, Function.comp_apply] at ih ⊢
    rw [ih (fun t ht => hs t (List.mem_cons_of_mem _ ht)) (Step.valid_addr Λ s ha),
      Step.inv_addr Λ (hs s List.mem_cons_self) ha]

lemma runArr_pull {α : Type*} (d : α) (steps : List (Step n Q)) (g : List ℕ → List ℕ)
    (xs : List α) :
    AModel.runArr Λ d steps (pull sh sh g d xs) = pull sh sh (g ∘ invChain Λ steps) d xs := by
  induction steps generalizing g with
  | nil => rfl
  | cons s rest ih =>
    simp only [AModel.runArr, List.foldl_cons] at ih ⊢
    rw [Step.arr, pull_comp _ _ (fun a ha => Step.valid_inv Λ s ha), ih]
    rfl

/-- The array action of a list of steps is a single pull by the composed inverse. -/
theorem runArr_eq_pull {α : Type*} (d : α) (steps : List (Step n Q)) {xs : List α}
    (hxs : xs.length = vol sh) : AModel.runArr Λ d steps xs = pull sh sh (invChain Λ steps) d xs := by
  conv_lhs => rw [← pull_id d hxs]
  rw [runArr_pull]; rfl

end Run

