-- title:
--   Scalar recurrence ledger data for the asymmetric fourth-power route
-- statement:
--   The 181-row append-only scalar ledger of the Duan-Wu-Zhou fourth-power recursion: each row lists weighted child indices, a retained floor and a claimed rate floor, together with the replay check, the comparator 155673/20000 and the final stored rate floor.
-- source:
--   Generated by replaying the exact rational fourth-power recursion of Duan-Wu-Zhou with 6-term logarithm certificates. See https://arxiv.org/html/2210.10173v5 and https://arxiv.org/html/2404.16349v2 .

import Mathlib.Tactic

set_option autoImplicit false

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace MME.DWZFourthScalarLedger

structure Node where
  children : List (Prod Nat Rat)
  retainedFloor : Rat
  rateFloor : Rat

def weightedPrior (prior : Array Rat) : List (Prod Nat Rat) -> Option Rat
  | [] => some 0
  | (index, coefficient) :: tail => do
      let value <- prior[index]?
      let rest <- weightedPrior prior tail
      pure (coefficient * value + rest)

def nodeAccepts (prior : Array Rat) (node : Node) : Bool :=
  node.children.all (fun term => decide (0 <= term.2)) &&
    match weightedPrior prior node.children with
    | none => false
    | some weighted => decide (node.rateFloor <= weighted + node.retainedFloor)

def checkAux : List Node -> Array Rat -> Bool
  | [], _ => true
  | node :: tail, prior =>
      nodeAccepts prior node && checkAux tail (prior.push node.rateFloor)

