variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalRing K] [LocallyCompactSpace K] [T1Space K]
  [MeasurableSpace K] [BorelSpace K] (μ : Measure K)

private theorem sigmaFinite_comap_mulMeasure [SigmaFinite μ] :
    SigmaFinite (Measure.comap Units.val (mulMeasure μ)) := by
  haveI hm : SigmaFinite (mulMeasure μ) := by
    unfold mulMeasure
    refine SigmaFinite.withDensity_of_ne_top ?_
    filter_upwards [ae_restrict_mem (measurableSet_singleton (0 : K)).compl] with x hx
    exact ENNReal.inv_ne_top.mpr (by exact_mod_cast modulus_ne_zero hx)
  let S := (mulMeasure μ).toFiniteSpanningSetsIn
  refine ⟨⟨⟨fun n => Units.val ⁻¹' S.set n, fun _ => trivial, fun n => ?_, ?_⟩⟩⟩
  · have hS : MeasurableSet (S.set n) := S.set_mem n
    have hpre : MeasurableSet (Units.val ⁻¹' S.set n : Set Kˣ) := comap_measurable Units.val hS
    rw [comap_val_apply _ hpre]
    exact lt_of_le_of_lt (measure_mono (Set.image_preimage_subset _ _)) (S.finite n)
  · rw [← Set.preimage_iUnion, S.spanning, Set.preimage_univ]

end
