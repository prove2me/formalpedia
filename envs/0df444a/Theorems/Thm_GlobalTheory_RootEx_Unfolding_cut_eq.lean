theorem GlobalTheory.RootEx.Unfolding.cut_eq {p : ℕ} (hp : 1 ≤ p) (hc : p < c) (χ : (n' → k) → ℂ) (y : Matrix (n ⊕ Fin c) n' k) :
    cut p χ y = χ fun s => y (Sum.inr ⟨p - 1, by omega⟩) s := by sorry
