    (hz : ∀ v, (z v : H1 _) = (locRes (extArithLoc S) M v).hom x)
    (hw : ∀ v, (w v : H1 _) = (locRes (extArithLoc S) (M.dualTwist (cycloChar p)) v).hom y) :
