          ∀ (E' : FakeEllipticCurve Λ N B) (ϱ' : FakeEllipticCurve.Rigidification r π A₀ (frobTwist Onr Fr (- Multiplicative.toAdd (vdet g₀)) ψ) E') (h : (ℍ[ℚ, a₁, b₁])ˣ) (c : ℤ),
