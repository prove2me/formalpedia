  intro e he ρ hρ
  obtain ⟨q, hq⟩ := E0_Q e (edges_E0 e he)
  exact hq.1 ρ hρ

/-! ## Good primes -/

theorem good_primes : ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f : ℕ,
    EOK ch0 (q ^ f) ∧ ∀ e ∈ E0, EdgeOK (q ^ f) e := by
  obtain ⟨q1, h1⟩ := good_edges E0 E0_Q
  obtain ⟨q2, h2⟩ := good_mats ({S0} : Finset (Matrix (Fin 529) (Pr 23) ℚ))
  obtain ⟨q3, h3⟩ := good_mats ({Si0} : Finset (Matrix (Pr 23) (Fin 529) ℚ))
  obtain ⟨q4, h4⟩ := good_mats M0
  obtain ⟨q5, h5⟩ := good_mats EM0
  refine ⟨q1 + q2 + q3 + q4 + q5, fun q hq hlt f => ⟨?_, fun e he => h1 q hq (by omega) f e he⟩⟩
  have gE : ∀ e ∈ E0, GoodM (q ^ f) e.E₁ ∧ GoodM (q ^ f) e.E₂ := by
    intro e he
    refine ⟨fun i j => (h5 q hq (by omega) f _ ?_ i j).1, fun i j => (h5 q hq (by omega) f _ ?_ i j).1⟩
    · unfold EM0; exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ he)
    · unfold EM0; exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ he)
  have mPc : ∀ c < 38286, Pc c ∈ M0 := fun c hc => by
    unfold M0; exact Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_range.2 hc))
  have mPl : ∀ b < 1771, Pl b ∈ M0 := fun b hb => by
    unfold M0; exact Finset.mem_union_right _ (Finset.mem_image_of_mem _ (Finset.mem_range.2 hb))
  have gPc : ∀ c < 38286, GoodM (q ^ f) (Pc c) := fun c hc i j =>
    (h4 q hq (by omega) f _ (mPc c hc) i j).1
  have gPl : ∀ b < 1771, GoodM (q ^ f) (Pl b) := fun b hb i j =>
    (h4 q hq (by omega) f _ (mPl b hb) i j).1
  have mE : ∀ {e : Edge 529} {Q : Matrix (Fin 529) (Fin 529) ℚ}, e ∈ E0 → EdgeQ e Q →
      edgeMat (q ^ f) e = redM (q ^ f) (pswQ Q) := fun he hQ =>
    edgeMat_eq hQ (gE _ he).1 (gE _ he).2
  exact {
    hS := S0_Si0
    hSi := Si0_S0
    gS := fun i j => (h2 q hq (by omega) f _ (Finset.mem_singleton_self _) i j).1
    gSi := fun i j => (h3 q hq (by omega) f _ (Finset.mem_singleton_self _) i j).1
    gPc := gPc
    gPl := gPl
    m1 := fun b hb o ho c hc hn => mE (e1_mem b o c) (e1_spec hb ho hc hn).1
    m2 := fun a ha o ho c hc hn => mE (e2_mem a o c) (e2_spec ha ho hc hn).1
    mx := fun b hb => mE (ex_mem b) (ex_spec hb).1
    mn := fun a ha t ht => mE (en_mem a t) (en_spec ha ht).1
    mi := fun a ha => mE (ei_mem a) (ei_spec ha).1
    mc := fun a ha s hs => mE (ec_mem a s) (ec_spec ha hs).1 }

theorem net0_ok : ∃ q₀ : ℕ, (net ch0).RunsOK ∧
    ∀ q, q.Prime → q₀ < q → ∀ f, (net ch0).EdgesOK (q ^ f) ∧ (net ch0).FormalOK (q ^ f) := by
  obtain ⟨q₀, h⟩ := good_primes
  exact ⟨q₀, runsOK0, fun q hq hlt f =>
    ⟨fun e he => (h q hq hlt f).2 e (edges_E0 e he), formalOK (h q hq hlt f).1⟩⟩

end IntMul.Kappa.R6.Bit.NB

