  have r3 := smulW_runs (I := I) extM (srcS := NLogN.KFM.rS) (srcR := rOne) (by decide) (by decide)
    (by decide) (by decide) (by decide) (wFR n D) 0 (sCmp n : ℤ) (t.upd 0 (ints L1)) L1 []
