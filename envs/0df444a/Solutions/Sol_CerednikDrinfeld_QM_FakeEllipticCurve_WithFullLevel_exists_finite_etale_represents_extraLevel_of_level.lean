theorem act_stable_of_span {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ,a,b]} {N' : ℕ} {S : Type} [CommRing S]
    (E : CerednikDrinfeld.QM.FakeEllipticCurve Λ N' S)
    (Φ : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)), SchemeHomOver t E.f → Prop)
    (hmul : ∀ {T} (t : T ⟶ Spec (CommRingCat.of S)) (P Q : SchemeHomOver t E.f), Φ t P → Φ t Q → Φ t (E.L.mul t P Q))
    (hinv : ∀ {T} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f), Φ t P → Φ t (E.L.inv t P))
    (hone : ∀ {T} (t : T ⟶ Spec (CommRingCat.of S)), Φ t (E.L.one t))
    (s : Set ↥Λ) (hs : Submodule.span ℤ s = ⊤)
    (hgen : ∀ x ∈ s, ∀ {T} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      Φ t P → Φ t (CerednikDrinfeld.QM.pushPt (E.act x) (E.act_over x) P)) :
    ∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      Φ t P → Φ t (CerednikDrinfeld.QM.pushPt (E.act x) (E.act_over x) P) := by

  have act0 : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      CerednikDrinfeld.QM.pushPt (E.act 0) (E.act_over 0) P = E.L.one t := by
    intro T t P
    have h := E.act_add 0 0 t P
    rw [add_zero] at h
    exact KerOps.eq_one_of_mul_self E.L t _ h

  have actneg : ∀ (x : ↥Λ) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t E.f),
      CerednikDrinfeld.QM.pushPt (E.act (-x)) (E.act_over (-x)) P =
        E.L.inv t (CerednikDrinfeld.QM.pushPt (E.act x) (E.act_over x) P) := by
    intro x T t P
    symm
    apply KerOps.inv_eq_of_mul_eq_one
    have h := E.act_add x (-x) t P
    rw [add_neg_cancel, act0] at h
    exact h.symm
  intro x T t P
  have hx : x ∈ AddSubgroup.closure s := by
    rw [← Submodule.span_int_eq_addSubgroupClosure, Submodule.mem_toAddSubgroup, hs]
    exact Submodule.mem_top

  refine AddSubgroup.closure_induction
    (p := fun y _ => Φ t P → Φ t (CerednikDrinfeld.QM.pushPt (E.act y) (E.act_over y) P))
    (fun y hy => hgen y hy t P) ?_ ?_ ?_ hx
  · intro _
    rw [act0]
    exact hone t
  · intro y z _ _ hy hz hP
    rw [E.act_add]
    exact hmul t _ _ (hy hP) (hz hP)
  · intro y _ hy hP
    rw [actneg]
    exact hinv t _ (hy hP)

theorem g_unique {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ}
    (hB : QuaternionAlgebra.IsIndefiniteRamifiedExactlyAt a b q q') (Λ : Submodule ℤ ℍ[ℚ,a,b])
    (hΛ : QuaternionAlgebra.IsMaximalOrder Λ) (m : ℕ) (hm : 3 ≤ m) {N₀ : ℕ}
    {S T : Type} [CommRing S] [CommRing T] (φ : S →+* T) (hmT : IsUnit ((m : ℕ) : T))
    (u : CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel Λ N₀ m S)
    (u' : CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (g₁ g₂ : u'.1.A ⟶ u.1.A)
    (h₁ : CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia φ u.1 u'.1 g₁)
    (h₂ : CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia φ u.1 u'.1 g₂)
    (hP₁ : (u'.2.P).1 ≫ g₁ = Spec.map (CommRingCat.ofHom φ) ≫ (u.2.P).1)
    (hP₂ : (u'.2.P).1 ≫ g₂ = Spec.map (CommRingCat.ofHom φ) ≫ (u.2.P).1) : g₁ = g₂ := by
  obtain ⟨H₁, hmul₁, hact₁, -⟩ := h₁
  obtain ⟨H₂, hmul₂, hact₂, -⟩ := h₂

  obtain ⟨σ, σ_g, σ_f⟩ : ∃ σ : u'.1.A ⟶ u'.1.A, σ ≫ g₂ = g₁ ∧ σ ≫ u'.1.f = u'.1.f :=
    ⟨H₂.lift g₁ u'.1.f H₁.w, H₂.lift_fst _ _ _, H₂.lift_snd _ _ _⟩
  obtain ⟨τ, τ_g, τ_f⟩ : ∃ τ : u'.1.A ⟶ u'.1.A, τ ≫ g₁ = g₂ ∧ τ ≫ u'.1.f = u'.1.f :=
    ⟨H₁.lift g₂ u'.1.f H₂.w, H₁.lift_fst _ _ _, H₁.lift_snd _ _ _⟩
  have στ : σ ≫ τ = 𝟙 _ :=
    H₁.hom_ext (by rw [Category.assoc, τ_g, σ_g, Category.id_comp])
      (by rw [Category.assoc, τ_f, σ_f, Category.id_comp])
  have τσ : τ ≫ σ = 𝟙 _ :=
    H₂.hom_ext (by rw [Category.assoc, σ_g, τ_g, Category.id_comp])
      (by rw [Category.assoc, σ_f, τ_f, Category.id_comp])

  have hmulσ : ∀ {T₀ : Scheme.{0}} (t : T₀ ⟶ Spec (CommRingCat.of T)) (P Q : SchemeHomOver t u'.1.f),
      CerednikDrinfeld.QM.mapPt σ σ_f (u'.1.L.mul t P Q) =
        u'.1.L.mul t (CerednikDrinfeld.QM.mapPt σ σ_f P) (CerednikDrinfeld.QM.mapPt σ σ_f Q) := by
    intro T₀ t P Q
    apply Subtype.ext
    apply H₂.hom_ext
    · rw [CerednikDrinfeld.QM.mapPt_coe, Category.assoc, σ_g, hmul₁, hmul₂]
      apply KerOps.mul_coe_congr u.1.L rfl <;>
        simp only [CerednikDrinfeld.QM.mapPt_coe, Category.assoc, σ_g]
    · rw [CerednikDrinfeld.QM.mapPt_coe, Category.assoc, σ_f, (u'.1.L.mul t P Q).2, (u'.1.L.mul t _ _).2]

  have hactσ : ∀ x : ↥Λ, u'.1.act x ≫ σ = σ ≫ u'.1.act x := by
    intro x
    apply H₂.hom_ext
    · rw [Category.assoc, σ_g, Category.assoc, hact₂, ← Category.assoc, σ_g, hact₁]
    · simp only [Category.assoc, σ_f, u'.1.act_over]

  have hPσ : CerednikDrinfeld.QM.mapPt σ σ_f u'.2.P = u'.2.P := by
    apply Subtype.ext
    apply H₂.hom_ext
    · rw [CerednikDrinfeld.QM.mapPt_coe, Category.assoc, σ_g, hP₁, hP₂]
    · rw [CerednikDrinfeld.QM.mapPt_coe, Category.assoc, σ_f, u'.2.P.2]
  have key := CerednikDrinfeld.QM.FakeEllipticCurve.WithFullLevel.eq_refl_of_mapPt_eq_of_three_le
    hqq' hB Λ hΛ hm hmT u' (Iso.mk σ τ στ τσ) σ_f hmulσ hactσ hPσ
  have hσ1 : σ = 𝟙 _ := congrArg Iso.hom key
  rw [← σ_g, hσ1, Category.id_comp]

