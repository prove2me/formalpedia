theorem e_smul_of_mem {𝕋 : Type} [CommRing 𝕋] {T : Type} [AddCommGroup T] [Module 𝕋 T]
    {S' : IharaLemma.IdempotentSplitting 𝕋} {i₀ : Fin S'.n} {x : T}
    (hx : x ∈ IharaLemma.cornerSubmodule (M := T) (S'.e i₀)) : S'.e i₀ • x = x := by
  obtain ⟨v, rfl⟩ := hx
  show S'.e i₀ • (S'.e i₀ • v) = S'.e i₀ • v
  rw [smul_smul, (S'.idem i₀).eq]

