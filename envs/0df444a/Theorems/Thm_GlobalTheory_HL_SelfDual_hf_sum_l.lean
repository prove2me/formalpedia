theorem GlobalTheory.HL.SelfDual.hf_sum_l (L : LocE F E) {n : ℕ} (Hm : Matrix (Fin n) (Fin n) E) {ι : Type*} [Fintype ι]
    (a : ι → E) (b : ι → Fin n → E) (y : Fin n → E) :
    hf L Hm (∑ k, a k • b k) y = ∑ k, a k * hf L Hm (b k) y := by sorry
