section RecursionGrowth

open UnramifiedWhittaker

private theorem t0683 (N lam om : ℂ) (m : ℕ) :
    ‖heckeRecursionSeq N lam om m‖ ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ m := by
  have hl : 0 ≤ ‖lam / N‖ := norm_nonneg _
  have ho : 0 ≤ ‖om / N‖ := norm_nonneg _
  have h1M : 1 ≤ 1 + ‖lam / N‖ + ‖om / N‖ := by linarith

  suffices h : ‖heckeRecursionSeq N lam om m‖ ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ m ∧
      ‖heckeRecursionSeq N lam om (m + 1)‖ ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1) from h.1
  induction m with
  | zero =>
    refine ⟨?_, ?_⟩
    · rw [show heckeRecursionSeq N lam om 0 = 1 from rfl, norm_one, pow_zero]
    · rw [show heckeRecursionSeq N lam om (0 + 1) = lam / N from rfl, zero_add, pow_one]
      linarith
  | succ m ih =>
    refine ⟨ih.2, ?_⟩
    have hrec : heckeRecursionSeq N lam om (m + 1 + 1) =
        lam / N * heckeRecursionSeq N lam om (m + 1) - om / N * heckeRecursionSeq N lam om m := by
      rw [show heckeRecursionSeq N lam om (m + 1 + 1) =
          (lam * heckeRecursionSeq N lam om (m + 1) - om * heckeRecursionSeq N lam om m) / N from rfl,
        sub_div, mul_div_right_comm, mul_div_right_comm]
    rw [hrec]
    calc ‖lam / N * heckeRecursionSeq N lam om (m + 1) - om / N * heckeRecursionSeq N lam om m‖
        ≤ ‖lam / N‖ * ‖heckeRecursionSeq N lam om (m + 1)‖ + ‖om / N‖ * ‖heckeRecursionSeq N lam om m‖ := by
          refine (norm_sub_le _ _).trans ?_
          rw [norm_mul, norm_mul]
      _ ≤ ‖lam / N‖ * (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1) +
            ‖om / N‖ * (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1) := by
          gcongr
          · exact ih.2
          · exact ih.1.trans (pow_le_pow_right₀ h1M (Nat.le_succ m))
      _ = (‖lam / N‖ + ‖om / N‖) * (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1) := by ring
      _ ≤ (1 + ‖lam / N‖ + ‖om / N‖) * (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1) := by
          gcongr
          linarith
      _ = (1 + ‖lam / N‖ + ‖om / N‖) ^ (m + 1 + 1) := by ring

private theorem t0684 (N lam om y : ℂ)
    (hy : ‖y‖ * (1 + ‖lam / N‖ + ‖om / N‖) < 1) :
    Summable fun m : ℕ => heckeRecursionSeq N lam om m * y ^ m := by
  have h0 : 0 ≤ ‖y‖ * (1 + ‖lam / N‖ + ‖om / N‖) := by positivity
  refine Summable.of_norm_bounded (summable_geometric_of_lt_one h0 hy) fun m => ?_
  calc ‖heckeRecursionSeq N lam om m * y ^ m‖ = ‖heckeRecursionSeq N lam om m‖ * ‖y‖ ^ m := by
        rw [norm_mul, norm_pow]
    _ ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ m * ‖y‖ ^ m := by
        gcongr
        exact t0683 N lam om m
    _ = (‖y‖ * (1 + ‖lam / N‖ + ‖om / N‖)) ^ m := by rw [mul_pow, mul_comm]

private theorem t0685 (N lam om : ℂ) (n : ℤ) :
    ‖torusFactor N lam om n‖ ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ n.toNat := by
  unfold torusFactor
  split_ifs with hn
  · exact t0683 N lam om n.toNat
  · rw [norm_zero]
    positivity

private theorem t0686 (N lam om z : ℂ) (ℓ : ℤ) (c : ℤ → ℂ) (C : ℝ)
    (hc : ∀ m, ‖c m‖ ≤ C) (hz : ‖z‖ * (1 + ‖lam / N‖ + ‖om / N‖) < 1) :
    Summable fun m : ℤ => ‖torusFactor N lam om (m + ℓ) * z ^ m * c m‖ := by
  have hl : 0 ≤ ‖lam / N‖ := norm_nonneg _
  have ho : 0 ≤ ‖om / N‖ := norm_nonneg _
  have h1M : 1 ≤ 1 + ‖lam / N‖ + ‖om / N‖ := by linarith
  have hC : 0 ≤ C := (norm_nonneg _).trans (hc 0)
  have h0 : 0 ≤ ‖z‖ * (1 + ‖lam / N‖ + ‖om / N‖) := by positivity

  have hG : Summable fun m : ℤ => ‖torusFactor N lam om (m + ℓ)‖ * ‖z ^ m‖ * C := by
    refine Summable.of_nat_of_neg ?_ ?_
    ·
      refine Summable.of_nonneg_of_le (fun n => mul_nonneg (mul_nonneg (norm_nonneg _) (norm_nonneg _)) hC)
        (fun n => ?_)
        ((summable_geometric_of_lt_one h0 hz).mul_left ((1 + ‖lam / N‖ + ‖om / N‖) ^ ℓ.toNat * C))
      show ‖torusFactor N lam om ((n : ℤ) + ℓ)‖ * ‖z ^ (n : ℤ)‖ * C ≤
        (1 + ‖lam / N‖ + ‖om / N‖) ^ ℓ.toNat * C * (‖z‖ * (1 + ‖lam / N‖ + ‖om / N‖)) ^ n
      have ht : ‖torusFactor N lam om ((n : ℤ) + ℓ)‖ ≤
          (1 + ‖lam / N‖ + ‖om / N‖) ^ n * (1 + ‖lam / N‖ + ‖om / N‖) ^ ℓ.toNat := by
        refine (t0685 N lam om _).trans ?_
        rw [← pow_add]
        exact pow_le_pow_right₀ h1M (by omega)
      rw [zpow_natCast, norm_pow]
      calc ‖torusFactor N lam om ((n : ℤ) + ℓ)‖ * ‖z‖ ^ n * C
          ≤ (1 + ‖lam / N‖ + ‖om / N‖) ^ n * (1 + ‖lam / N‖ + ‖om / N‖) ^ ℓ.toNat * ‖z‖ ^ n * C := by
            gcongr
        _ = (1 + ‖lam / N‖ + ‖om / N‖) ^ ℓ.toNat * C * (‖z‖ * (1 + ‖lam / N‖ + ‖om / N‖)) ^ n := by
            rw [mul_pow]; ring
    ·
      refine summable_of_ne_finset_zero (s := Finset.range (ℓ.toNat + 1)) fun n hn => ?_
      rw [Finset.mem_range, not_lt] at hn
      show ‖torusFactor N lam om (-(n : ℤ) + ℓ)‖ * ‖z ^ (-(n : ℤ))‖ * C = 0
      rw [t0676 N lam om (by omega), norm_zero, zero_mul, zero_mul]
  refine Summable.of_nonneg_of_le (fun m => norm_nonneg _) (fun m => ?_) hG
  rw [norm_mul, norm_mul]
  gcongr
  exact hc m

end RecursionGrowth
