-- title:
--   The order topology on the reals is the standard topology
-- statement:
--   The order topology on $\mathbb R$ coincides with the standard topology, the one generated by all open intervals $(a,b)$ with rational endpoints.
-- source:
--   G. Carcassi, C. A. Aidala, Assumptions of Physics, Ver. 3.0 (Dec 31, 2025), https://assumptionsofphysics.org/book — Part II, Chapter 3 (pp. 169–195), Proposition 3.55, p. 191; Definition 3.54, p. 191

import Mathlib
import Definitions.Def_AoP_ExperimentalDomains
import Definitions.Def_AoP_PropertiesQuantities

namespace AssumptionsOfPhysics
theorem real_orderTopology_eq_rational_intervals :
    Preorder.topology ℝ =
      TopologicalSpace.generateFrom {S : Set ℝ | ∃ a b : ℚ, S = Set.Ioo (a : ℝ) (b : ℝ)} := by sorry
end AssumptionsOfPhysics
