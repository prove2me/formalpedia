-- title:
--   Proof of Theorem 4.2, p. 8 — −∇f(x*) ∈ L_Ω(x*)° iff the KKT condition holds at x*
-- statement:
--   Let $x^*$ be a feasible point of (1.1) and $f:\mathbb R^n\to\mathbb R$ an objective. Then
--
--   $$
--   -\nabla f(x^*)\in L_\Omega(x^*)^\circ
--   $$
--
--   if and only if the KKT condition holds at $x^*$ for $f$: there are $\lambda\in\mathbb R^m$ and $\mu\in\mathbb R^p_+$, with $\mu_j=0$ whenever $g_j(x^*)\neq0$, such that $\nabla f(x^*)+\sum_i\lambda_i\nabla h_i(x^*)+\sum_j\mu_j\nabla g_j(x^*)=0$.
--
--   The paper reads "the KKT condition holds" as membership of $-\nabla f(x^*)$ in $L_\Omega(x^*)^\circ$ (pp. 5, 8); this theorem connects that reading with the multiplier form used throughout the mission. It is Farkas' lemma for the cone generated by the active gradients.
--
--   **Formalization Note** The gradient of $f$ at $x^*$ is Mathlib's `gradient`; no differentiability of $f$ is assumed because only the vector $\nabla f(x^*)$ enters.
-- source:
--   Andreani, Martínez, Ramos & Silva, Strict constraint qualifications and sequential optimality conditions for constrained optimization, Optimization Online 5197 (version of November 12, 2015), p. 8, proof of Theorem 4.2 (and p. 5, (3.6)–(3.8))

import Mathlib
import Definitions.Def_StrictCQ_AGP_Setting

open Filter Topology InnerProductSpace

namespace StrictCQ.AGP

/-- Proof of Theorem 4.2, p. 8: at a feasible `xs`, KKT holds for `f` iff `-∇f(xs) ∈ L_Ω(xs)°`. -/
theorem kkt_iff_neg_gradient_mem_polar {n m p : ℕ} (C : Constraints n m p)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (xs : EuclideanSpace ℝ (Fin n))
    (hxs : xs ∈ C.feasible) :
    -gradient f xs ∈ polar (C.linCone xs) ↔ C.IsKKT f xs := by sorry

end StrictCQ.AGP
