/-!
# KFR: bit arithmetic for the packed row addition

* `bitZ z l ∈ {0, 1}` (as an integer) and `bitsum`: `z = Σ_{l<N} bitZ z l · 2^l` for `z < 2^N`.
* `testBit_selMask`: the mask `Σ_{u<f} 2^{ρ + uK}` has exactly the bits `ρ + uK`, `u < f`.
* **`xor_mask_sub`**: `(Y ⊕ (X ∧ mask)) - Y = Σ_{u<f} (bit_{ρ+uK}(Y ⊕ X) - bit_{ρ+uK} Y) 2^{ρ+uK}`.
* `bitZ_digit`: bit `l` of the field `q / W mod 2^L` is `q / (W 2^l) mod 2`.
-/

namespace NLogN.KFR

/-- Bit `l` of `z`, as an integer. -/
def bitZ (z l : ℕ) : ℤ := if z.testBit l then 1 else 0

end NLogN.KFR

end

