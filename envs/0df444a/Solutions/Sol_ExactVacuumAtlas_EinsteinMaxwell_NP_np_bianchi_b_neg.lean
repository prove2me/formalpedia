        (-1) * ricF g gi E 1 3 x * npTauB g gi E Θ x := by
  have hB := bianchi_low hN hx 1 3 0 1 3
  simp only [covL, Fin.sum_univ_four, NullFrameData.Omega_eq_omL] at hB
