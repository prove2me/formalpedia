  apply pull_congr
  intro a ha
  have hl := ha.length_eq
  simp only [List.length_append, List.length_cons, List.length_nil] at hl
  unfold extA
  rw [List.take_take, min_eq_left (by simp), List.length_append, List.length_singleton,
