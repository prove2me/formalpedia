variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

lemma length_lstL : (lstL D ℓ K long).length = nLong D long + bb ℓ K * D := by
  unfold lstL nLong
  simp only [List.length_append, List.length_map, List.length_flatMap, List.length_finRange]
  congr 1
  simp [List.sum_replicate]

lemma length_lstL_le_tgt : (lstL D ℓ K long).length ≤ (tgtL D ℓ K long).length := by
  unfold tgtL; simp

lemma getD_rev_range {β : Type*} (g : ℕ → β) (d : β) {n u : ℕ} (hu : u < n) :
    ((List.range n).reverse.map g).getD u d = g (n - 1 - u) := by
  rw [List.getD_eq_getElem _ _ (by simp [hu])]
  simp only [List.getElem_map, List.getElem_reverse, List.getElem_range, List.length_range]

/-- **The prefix slot**: `(i, h)` (`h < b`) sits at position `preP h + i` of `tgtL`. -/
theorem pre_slot (i : Fin D) {h : ℕ} (hh : h < bb ℓ K) :
    (tgtL D ℓ K long).getD (NLogN.KFV.preP D ℓ K long h + i) 0 = nm D i h := by
  have hlt : NLogN.KFV.preP D ℓ K long h + i < (lstL D ℓ K long).length := by
    rw [length_lstL]; unfold NLogN.KFV.preP
    have : (bb ℓ K - 1 - h) * D + D ≤ bb ℓ K * D := by
      have : bb ℓ K - 1 - h + 1 ≤ bb ℓ K := by omega
      nlinarith
    have := i.isLt; omega
  unfold tgtL
  rw [getD_append_eq, if_pos hlt]
  unfold lstL
  have hA : (((List.finRange D).filter fun i => long i).map fun i => nm D i (ℓ - 1)).length =
      nLong D long := by simp [nLong]
  rw [getD_append_eq, hA, if_neg (by unfold NLogN.KFV.preP; omega)]
  rw [show NLogN.KFV.preP D ℓ K long h + i - nLong D long = (bb ℓ K - 1 - h) * D + i by unfold NLogN.KFV.preP; omega]
  rw [List.flatMap_def, getD_flatten_uniform 0 _ (fun c hc => by
    simp only [List.mem_map, List.mem_reverse, List.mem_range] at hc
    obtain ⟨j, -, rfl⟩ := hc; simp) _ _ i.isLt]
  rw [getD_rev_range _ _ (by omega), getD_map_finRange]
  congr 1; omega

lemma all_part_pre {h : ℕ} (hh : h < bb ℓ K) : ∀ i, i ∈ partAxes (Synth.al D ℓ long) h := by
  intro i
  have : bb ℓ K ≤ ℓ - 1 := Nat.mod_le _ _
  simp only [partAxes, Finset.mem_filter, Finset.mem_univ, true_and]
  unfold Synth.al; split_ifs <;> omega

/-- **The prefix rounds are one-bit-chunk layers.** -/
theorem pre_round_layer (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h : ℕ} (hh : h < bb ℓ K) (M : M2)
    {X : Type*} [AddCommMonoid X] [Module ℂ X] (xs : List X) :
    selOp (paperSel D ℓ K long hK hℓ h) (Butterfly.tens M) xs =
      selOp (layerSel (2 ^ NLogN.KFV.preP D ℓ K long h) 1 D (2 ^ NLogN.KFV.sufP D ℓ K long h) 0 one_pos)
        (Butterfly.tens M) xs := by
  have hall := all_part_pre D ℓ K long hh
  have hS := paperArr D ℓ K long hK hℓ
  have hlt0 : NLogN.KFV.preP D ℓ K long h + D ≤ (tgtL D ℓ K long).length := by
    have h1 := length_lstL_le_tgt D ℓ K long
    rw [length_lstL] at h1; unfold NLogN.KFV.preP
    have : (bb ℓ K - 1 - h) * D + D ≤ bb ℓ K * D := by
      have : bb ℓ K - 1 - h + 1 ≤ bb ℓ K := by omega
      nlinarith
    omega
  refine chunk_bridge (K := 1) (ρ := 0) one_pos (A := NLogN.KFV.preP D ℓ K long h) (B := NLogN.KFV.sufP D ℓ K long h)
    ?_ (slotPos hS h (partAxes (Synth.al D ℓ long) h) partAxes_lt) (Equiv.subtypeUnivEquiv hall) ?_ M xs
  · unfold NLogN.KFV.sufP; omega
  · intro i
    show spos D (tgtL D ℓ K long) i h = _
    have hslot := pre_slot D ℓ K long i hh
    have hlt : NLogN.KFV.preP D ℓ K long h + i < (tgtL D ℓ K long).length := by have := i.isLt; omega
    unfold spos
    rw [List.getD_eq_getElem _ _ hlt] at hslot
    rw [← hslot, hS.nodup.idxOf_getElem _ hlt]
    omega

/-- The long axes are the axes of the top round. -/
lemma mem_part_top (hℓ : 1 ≤ ℓ) (i : Fin D) : i ∈ partAxes (Synth.al D ℓ long) (ℓ - 1) ↔ long i = true := by
  simp only [partAxes, Finset.mem_filter, Finset.mem_univ, true_and]
  unfold Synth.al; split_ifs with h <;> simp [h] <;> omega

lemma card_part_top (hℓ : 1 ≤ ℓ) : (partAxes (Synth.al D ℓ long) (ℓ - 1)).card = nLong D long := by
  have e : partAxes (Synth.al D ℓ long) (ℓ - 1) = ((List.finRange D).filter fun i => long i).toFinset := by
    ext i; rw [mem_part_top D ℓ long hℓ]; simp
  rw [e, List.toFinset_card_of_nodup ((List.nodup_finRange D).filter _)]; rfl

/-- The top slots are the first `m` positions. -/
lemma spos_top_lt (hK : 0 < K) (hℓ : 1 ≤ ℓ) (i : Fin D) (hi : long i = true) :
    spos D (tgtL D ℓ K long) i (ℓ - 1) < nLong D long := by
  unfold spos tgtL lstL
  have hm : nm D i (ℓ - 1) ∈ ((List.finRange D).filter fun i => long i).map fun i => nm D i (ℓ - 1) := by
    simp only [List.mem_map, List.mem_filter, List.mem_finRange, true_and]; exact ⟨i, hi, rfl⟩
  rw [List.append_assoc, List.idxOf_append_of_mem hm]
  have := List.idxOf_lt_length_of_mem hm
  simpa [nLong] using this

/-- **The top round is a one-bit-chunk layer** on the first `m` bits. -/
theorem top_round_layer (hK : 0 < K) (hℓ : 1 ≤ ℓ) (M : M2)
    {X : Type*} [AddCommMonoid X] [Module ℂ X] (xs : List X) :
    selOp (paperSel D ℓ K long hK hℓ (ℓ - 1)) (Butterfly.tens M) xs =
      selOp (layerSel 1 1 (partAxes (Synth.al D ℓ long) (ℓ - 1)).card
        (2 ^ ((tgtL D ℓ K long).length - (partAxes (Synth.al D ℓ long) (ℓ - 1)).card)) 0 one_pos)
        (Butterfly.tens M) xs := by
  have hS := paperArr D ℓ K long hK hℓ
  set Pd := slotPos hS (ℓ - 1) (partAxes (Synth.al D ℓ long) (ℓ - 1)) partAxes_lt
  set m := (partAxes (Synth.al D ℓ long) (ℓ - 1)).card with hm
  have hmn : m = nLong D long := card_part_top D ℓ long hℓ
  have hlong : ∀ x : {i // i ∈ partAxes (Synth.al D ℓ long) (ℓ - 1)}, long x.1 = true :=
    fun x => (mem_part_top D ℓ long hℓ x.1).1 x.2
  have hpos : ∀ x, Pd.pos x < m := fun x => by
    rw [hmn]; exact spos_top_lt D ℓ K long hK hℓ x.1 (hlong x)
  let e0 : {i // i ∈ partAxes (Synth.al D ℓ long) (ℓ - 1)} → Fin m := fun x => ⟨Pd.pos x, hpos x⟩
  have hinj : Function.Injective e0 := by
    intro x x' hxx
    have h1 : spos D (tgtL D ℓ K long) x.1 (ℓ - 1) = spos D (tgtL D ℓ K long) x'.1 (ℓ - 1) :=
      congrArg Fin.val hxx
    have g1 := hS.getD_spos (partAxes_lt x.1 x.2)
    have g2 := hS.getD_spos (partAxes_lt x'.1 x'.2)
    rw [h1, g2] at g1
    exact Subtype.ext (nm_inj D g1).1.symm
  have hbij : Function.Bijective e0 :=
    (Fintype.bijective_iff_injective_and_card e0).2 ⟨hinj, by simp [m]⟩
  set e := Equiv.ofBijective e0 hbij
  have hlen : m ≤ (tgtL D ℓ K long).length := by
    rw [hmn]
    have := length_lstL_le_tgt D ℓ K long
    rw [length_lstL] at this; omega
  have hB := chunk_bridge (K := 1) (ρ := 0) (D := m) one_pos (A := 0)
    (B := (tgtL D ℓ K long).length - m) (by omega) Pd e (fun k => by
      have : e0 (e.symm k) = k := e.apply_symm_apply k
      have h2 := congrArg Fin.val this
      simp only [e0] at h2
      simp only [zero_add, mul_one, Nat.sub_self, add_zero]; exact h2) M xs
  exact hB

/-- **Prefix rounds, computed layer = Proposition 14 with `K = 1`.** -/
theorem pre_layerQc {r : ℕ} (p : ℕ) (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h : ℕ} (hh : h < bb ℓ K)
    (xs : List (Fin r → ℂ)) :
    layerQc p (paperSel D ℓ K long hK hℓ h) xs =
      prop14Proc (P := 2 ^ NLogN.KFV.preP D ℓ K long h) (S := 2 ^ NLogN.KFV.sufP D ℓ K long h) (D := D) one_pos p
        (Butterfly.tens Cm) xs := by
  unfold prop14Proc layerQc
  rw [pre_round_layer D ℓ K long hK hℓ hh H0 xs]
  have := layerH_eq (P := 2 ^ NLogN.KFV.preP D ℓ K long h) (K := 1) (D := D) (S := 2 ^ NLogN.KFV.sufP D ℓ K long h)
    (ρ := 0) one_pos xs
  simp only [layerH, butterflyLayer, phaseLayer, cLayer] at this
  rw [this]

/-- **Top round, computed layer = Proposition 14 with `K = 1`** on the long axes. -/
theorem top_layerQc {r : ℕ} (p : ℕ) (hK : 0 < K) (hℓ : 1 ≤ ℓ) (xs : List (Fin r → ℂ)) :
    layerQc p (paperSel D ℓ K long hK hℓ (ℓ - 1)) xs =
      prop14Proc (P := 1) (S := 2 ^ ((tgtL D ℓ K long).length -
        (partAxes (Synth.al D ℓ long) (ℓ - 1)).card)) (D := (partAxes (Synth.al D ℓ long) (ℓ - 1)).card)
        one_pos p (Butterfly.tens Cm) xs := by
  unfold prop14Proc layerQc
  rw [top_round_layer D ℓ K long hK hℓ H0 xs]
  have := layerH_eq (P := 1) (K := 1) (D := (partAxes (Synth.al D ℓ long) (ℓ - 1)).card)
    (S := 2 ^ ((tgtL D ℓ K long).length - (partAxes (Synth.al D ℓ long) (ℓ - 1)).card)) (ρ := 0) one_pos xs
  simp only [layerH, butterflyLayer, phaseLayer, cLayer] at this
  rw [this]

