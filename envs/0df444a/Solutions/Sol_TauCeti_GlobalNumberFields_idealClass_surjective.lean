/-! ### The moving lemma -/

/-- **An integral ideal prime to `𝔪` divides a principal ideal with a generator congruent to
one.**  Because the generator `a` is a unit at every prime dividing the finite part of `𝔪`, the
complementary ideal `J` with `(a) = I · J` is again prime to `𝔪`.

This is the ideal-level statement behind `exists_idealClass_mul_eq_one`; it is the analogue, for a
ray-class modulus, of `NumberField.exists_isTotallyPositive_span_eq_mul_isCoprime`. -/
theorem TauCeti.GlobalNumberFields.exists_isCongrOne_span_eq_mul {𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K} (I : _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪) :
    ∃ (J : _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪) (a : 𝓞 K) (x : Kˣ), (x : K) = a ∧ _root_.TauCeti.GlobalNumberFields.IsCongrOne 𝔪 x ∧
      _root_.Ideal.span {a} = (I : _root_.Ideal (𝓞 K)) * (J : _root_.Ideal (𝓞 K)) := by
  obtain ⟨hIbot, hsup⟩ :=
    Modulus.isCoprimeTo_iff_sup_eq_top.mp (Modulus.mem_integralIdealsPrimeTo.mp I.2)
  obtain ⟨a, x, haI, hxa, hx⟩ := _root_.TauCeti.GlobalNumberFields.exists_mem_isCongrOne hIbot hsup
  obtain ⟨J, hJ⟩ :=
    Ideal.dvd_iff_le.mpr ((_root_.Ideal.span_singleton_le_iff_mem (I := (I : _root_.Ideal (𝓞 K)))).mpr haI)
  exact ⟨⟨J, Modulus.mem_integralIdealsPrimeTo.mpr (_root_.TauCeti.GlobalNumberFields.Modulus.isCoprimeTo_of_dvd_span_singleton
    hxa (_root_.TauCeti.GlobalNumberFields.congruenceSubgroup_le_primeToSubgroup 𝔪 (mem_congruenceSubgroup.mpr hx))
    ⟨I, by rw [hJ, _root_.mul_comm]⟩)⟩, a, x, hxa, hx, hJ⟩

/-- **A product of integral ideals generated by an element congruent to one lies in the ray.** -/
theorem TauCeti.GlobalNumberFields.idealClass_mul_eq_one_of_span_eq_mul {𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K} {I J : _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪}
    {a : 𝓞 K} {x : Kˣ} (hxa : (x : K) = a) (hx : _root_.TauCeti.GlobalNumberFields.IsCongrOne 𝔪 x)
    (hJ : _root_.Ideal.span {a} = (I : _root_.Ideal (𝓞 K)) * (J : _root_.Ideal (𝓞 K))) :
    _root_.TauCeti.GlobalNumberFields.idealClass 𝔪 I * _root_.TauCeti.GlobalNumberFields.idealClass 𝔪 J = 1 := by
  rw [← _root_.map_mul, _root_.TauCeti.GlobalNumberFields.idealClass_eq_one_iff]
  exact ⟨x, hx, by
    rw [_root_.Submonoid.coe_mul, ← hJ,
      _root_.FractionalIdeal.coeIdeal_span_singleton, hxa]⟩

/-- **Every ray class of an integral ideal prime to `𝔪` is inverted by another one.**  The
principal ideal `I · J` of `exists_isCongrOne_span_eq_mul` has a generator congruent to one modulo
`𝔪`, so it lies in the ray.  This is what makes the image of `idealClass 𝔪` a subgroup. -/
theorem TauCeti.GlobalNumberFields.exists_idealClass_mul_eq_one {𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K} (I : _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪) :
    ∃ J : _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪, _root_.TauCeti.GlobalNumberFields.idealClass 𝔪 I * _root_.TauCeti.GlobalNumberFields.idealClass 𝔪 J = 1 := by
  obtain ⟨J, a, x, hxa, hx, hJ⟩ := _root_.TauCeti.GlobalNumberFields.exists_isCongrOne_span_eq_mul I
  exact ⟨J, _root_.TauCeti.GlobalNumberFields.idealClass_mul_eq_one_of_span_eq_mul hxa hx hJ⟩

/-- **The moving lemma.**  Every ray class of `𝔪` is the class of a nonzero integral ideal prime to
`𝔪`: the image of `idealClass 𝔪` is a subgroup of the ray class group by
`exists_idealClass_mul_eq_one`, and it contains the class of every prime not dividing the finite
part, which generate the ideals prime to `𝔪`. -/
theorem solution (𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K) : _root_.Function.Surjective (_root_.TauCeti.GlobalNumberFields.idealClass 𝔪) := by
  classical
  -- The image of `idealClass 𝔪`; inversion is what needs an argument.
  let G : _root_.Subgroup (_root_.TauCeti.GlobalNumberFields.RayClassGroup 𝔪) :=
    { carrier := _root_.Set.range (_root_.TauCeti.GlobalNumberFields.idealClass 𝔪)
      one_mem' := ⟨1, _root_.map_one _⟩
      mul_mem' := by
        rintro _ _ ⟨I, rfl⟩ ⟨J, rfl⟩
        exact ⟨I * J, _root_.map_mul _ _ _⟩
      inv_mem' := by
        rintro _ ⟨I, rfl⟩
        obtain ⟨J, hJ⟩ := _root_.TauCeti.GlobalNumberFields.exists_idealClass_mul_eq_one I
        exact ⟨J, (_root_.inv_eq_of_mul_eq_one_right hJ).symm⟩ }
  -- The fractional ideals prime to `𝔪` whose ray class lies in `G`, viewed in the ambient group.
  let T : _root_.Subgroup (_root_.FractionalIdeal (𝓞 K)⁰ K)ˣ :=
    (G.comap (_root_.TauCeti.GlobalNumberFields.rayClassMk 𝔪)).map (_root_.TauCeti.GlobalNumberFields.idealsPrimeTo 𝔪).subtype
  have hT : _root_.TauCeti.NumberFieldArithmetic.idealsAway (K := K) 𝔪.support ≤ T := by
    rw [_root_.TauCeti.NumberFieldArithmetic.idealsAway_eq_closure_primes 𝔪.support]
    refine (_root_.Subgroup.closure_le _).mpr ?_
    rintro P ⟨v, hv, hPv⟩
    have hvmem : v.asIdeal ∈ _root_.TauCeti.GlobalNumberFields.integralIdealsPrimeTo 𝔪 := by
      refine NumberFieldArithmetic.mem_integralIdealsAway_iff.mpr ⟨v.ne_bot, fun w hw hdvd ↦ ?_⟩
      -- A prime dividing `v` equals `v`, by maximality; so it cannot lie in the support.
      exact hv (_root_.IsDedekindDomain.HeightOneSpectrum.ext
        (v.isMaximal.eq_of_le w.isPrime.ne_top (_root_.Ideal.le_of_dvd hdvd)) ▸ hw)
    refine ⟨_root_.TauCeti.NumberFieldArithmetic.integralIdealsAwayHom 𝔪.support ⟨v.asIdeal, hvmem⟩,
      ⟨⟨v.asIdeal, hvmem⟩, _root_.TauCeti.GlobalNumberFields.idealClass_apply 𝔪 ⟨v.asIdeal, hvmem⟩⟩, _root_.Units.ext ?_⟩
    rw [_root_.Subgroup.coe_subtype, _root_.TauCeti.NumberFieldArithmetic.coe_integralIdealsAwayHom, hPv]
  intro c
  obtain ⟨I, rfl⟩ := _root_.TauCeti.GlobalNumberFields.rayClassMk_surjective 𝔪 c
  obtain ⟨I', hI', hI'I⟩ := Subgroup.mem_map.mp (hT I.2)
  obtain ⟨J, hJ⟩ := hI'
  exact ⟨J, by rw [hJ]; congr 1; exact _root_.Subtype.ext hI'I⟩

