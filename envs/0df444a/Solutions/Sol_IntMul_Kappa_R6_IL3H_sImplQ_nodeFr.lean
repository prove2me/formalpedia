* `nodeVL1`, `nodeVL2`, `σNodeH`: the node registers over a level frame;
* `frOK_nodeFr1`, `pushSeq_nodeFr2` (the `2^δ` push at linear cost);
* **`nodeRH_of`**: the node frame over a level frame on `E ≥ 2m` bits is a `NodeRH`;
* **`sImplQ_nodeFr`**: the two node frames around a statement under `Agree σNodeH`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

/-! ## The pad scale -/

/-! ## The node registers -/

theorem nodeVL1_keys (c : Cfg) (K S0 r E B : ℕ) (p : Fin HS × ℤ) (hp : p ∈ nodeVL1 c K S0 r E B) :
    p.1 ∈ [wF, wB, wR0, wKF, w1, vF] := by
  simp only [nodeVL1, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> simp

/-! ## The frames -/

section Frames

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem frV_nodeFr1 (hL : LevRH c σ K t S0 r H E e B) :
    frV σ (nodeFr1 c) = nodeVL1 c K S0 r E B := by
  simp only [frV, nodeFr1, nodeVL1, List.map_cons, List.map_nil, NE.val, vOf_eq hL.hk,
    vOf_eq hL.hB, vOf_eq hL.hS, vOf_eq hL.hr, vOf_eq hL.hK]

theorem frOK_nodeFr1 (hL : LevRH c σ K t S0 r H E e B) (hm : 1 ≤ c.m) (hW1 : 1 ≤ c.W) (M : ℕ)
    (hM : E + B + c.W + c.m + S0 + r + K + S0 * r + K * E + 1 ≤ M) : FrOK σ M 5 (nodeFr1 c) := by
  have hnat : ∀ i ∈ [vk, vB, vS, vR, vK], ∃ n : ℕ, σ i = some (n : ℤ) := by
    intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    rcases hi with rfl | rfl | rfl | rfl | rfl
    · exact ⟨_, hL.hk⟩
    · exact ⟨_, hL.hB⟩
    · exact ⟨_, hL.hS⟩
    · exact ⟨_, hL.hr⟩
    · exact ⟨_, hL.hK⟩
  have hEm : E / c.m ≤ E := Nat.div_le_self _ _
  have hmE : c.m * (E / c.m) ≤ E := Nat.mul_div_le E c.m
  have hKE : K * (E / c.m) ≤ K * E := Nat.mul_le_mul_left _ hEm
  have hBW : B / c.W ≤ B := Nat.div_le_self _ _
  intro x hx
  simp only [nodeFr1, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
  all_goals refine ⟨by simp only [] <;> decide, regsLt_of_all (by simp [NE.regs] <;> decide),
    by simp [NE.size], natR_of _ hnat (by simp [NE.regs]), ?_⟩
  all_goals simp only [NE.OK, NE.val, vOf_eq hL.hk, vOf_eq hL.hB, vOf_eq hL.hS, vOf_eq hL.hr,
    vOf_eq hL.hK]
  all_goals omega

/-- **The node frames** around a statement under the node assignment. -/
theorem sImplQ_nodeFr_sol_aux {ι : Type*} [Fintype ι] [DecidableEq ι] {lo hi : ℕ} {st : ι → ℕ} {n : ℕ}
    {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp} {e' dw : ℕ} {cost : ℕ → ℕ}
    (hL : LevRH c σ K t S0 r H E e B) (hm : 1 ≤ c.m) (hW1 : 1 ≤ c.W)
    (hA : 1 ≤ c.Aw) (hp : 1 ≤ c.p) (hS : 1 ≤ S0) (hr : 1 ≤ r) (hB1 : 1 ≤ B)
    (hBn : 1 ≤ B / c.W)
    (hδ : cLH c + ((chWs c).map fun s => c.G (s * (E / c.m))).sum + E % c.m ≤ c.G E)
    (hcw : ∀ s ∈ chWs c, s < c.m) (M Bz : ℕ)
    (hM : c.Aw * (E + 1) ^ c.p + (E + 1) ^ c.p + E + 2 * c.m + cLH c + B + c.W + S0 + r + K +
      S0 * r + K * E + 1 ≤ M)
    (hMB : zsz (M : ℤ) ≤ Bz)
    (hzA : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) + 16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Bz)
    (H : SImplQ I iprog (fun s => Agree (σNodeH σ c K t S0 r E B) s) lo hi r st n T U e' dw cost) :
    SImplQ I iprog (fun s => Agree σ s) lo hi r st n T
      (withPushI (fr (nodeFr1 c)) (withPushI (nodeFr2 c) U)) e' dw
      (fun w => cFrame 6 5 Bz + (cNF2 c Bz (δv c E) + cost w +
        (6 * (2 * (Bz + δv c E + 1) + 2) + 1)) + (6 * (2 * Bz + 2) + 1)) := by
  have hσ0 : σ 0 = none := hL.off 0 (by decide)
  set σ1 := σPush σ (nodeVL1 c K S0 r E B) with hσ1
  have hσ10 : σ1 0 = none := by
    rw [hσ1, σPush_ne _ _ _ (fun p hp hpi => by
      have := nodeVL1_keys c K S0 r E B p hp; rw [hpi] at this; revert this; decide)]
    exact hσ0
  have hP := pushSeq_nodeFr2 hL hm hW1 hA hp hS hr hB1 hBn hδ hcw M Bz (by omega) hMB hzA
  have hδE : δv c E ≤ c.G E := by unfold δv; omega
  have h1 := sImplQ_push (I := I) (iprog := iprog) (Q := fun s => Agree σ1 s) (lo := lo) (hi := hi)
    σ1 hσ10 (fun s h => h) (nodeFr2 c) (nodeVL2 c t S0 r E B) _ (Bz + δv c E + 1) hP
    (by simp only [nodeFr2, List.map_cons, List.map_nil]; decide)
    (by
      intro q hq
      simp only [nodeVL2, List.mem_cons, List.not_mem_nil, or_false] at hq
      have hzA' : ∀ x : ℕ, x ≤ 2 * (c.Wr * (nN (B / c.W) t S0 * r)) + 16 * (B * 2 ^ t * S0 * r) →
          zsz (x : ℤ) ≤ Bz + δv c E + 1 := fun x hx =>
        le_trans (le_trans (zsz_natCast_le hx) hzA) (by omega)
      have hT : c.T * (nN (B / c.W) t S0 * r) ≤ c.Wr * (nN (B / c.W) t S0 * r) :=
        Nat.mul_le_mul_right _ (by simp [Cfg.Wr])
      have hR2 : nN (B / c.W) t S0 * r ≤ B * 2 ^ t * S0 * r := by
        unfold nN
        exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _
          (Nat.div_le_self _ _)))
      rcases hq with rfl | rfl | rfl | rfl | rfl | rfl
      · simp only [NLogN.zsz_two_pow]; omega
      · exact hzA' _ (by omega)
      · exact hzA' _ (by
          have : 2 * (B / c.W * (S0 * r * 2 ^ t)) = 2 * (nN (B / c.W) t S0 * r) := by
            unfold nN; ring
          omega)
      · exact hzA' _ (by omega)
      · exact hzA' _ (by omega)
      · exact hzA' _ (by omega))
    (fun s hs => agree_pushSt' _ hs) H
  have hfr := frV_nodeFr1 hL
  have h2 := sImplQ_fr (I := I) (iprog := iprog) hσ0 (nodeFr1 c) M Bz 5 hMB
    (frOK_nodeFr1 hL hm hW1 M (by
      have : E ≤ c.Aw * (E + 1) ^ c.p := le_trans (by omega)
        (Nat.mul_le_mul hA (Nat.le_self_pow (by omega) (E + 1)))
      omega))
    (noRdN_of_B _ _ (by simp (config := {decide := true}) [noRdB, nodeFr1, NE.regs]))
    (by simp (config := {decide := true}) [nodeFr1]) (by rw [hfr]; exact h1)
  simp only [nodeVL2, List.length_cons, List.length_nil, nodeFr1] at h2
  exact h2

end Frames

end IntMul.Kappa.R6.IL3H

end

theorem solution.{u_1} : type_of% @IntMul.Kappa.R6.IL3H.sImplQ_nodeFr_sol_aux.{u_1} := @IntMul.Kappa.R6.IL3H.sImplQ_nodeFr_sol_aux.{u_1}
