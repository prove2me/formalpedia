lemma val_act [NeZero Q] {a : List ℕ} (ha : Valid sh a) (i : Fin n) :
    (act Λ a i).val = a.getD (Λ.pos i) 0 := by
  rw [act, ZMod.val_natCast, Nat.mod_eq_of_lt (ha.digit_lt Λ i)]

theorem swapMap_eq_vmap [NeZero Q] (i j : Fin n) {a : List ℕ} (ha : Valid sh a) :
    swapMap Λ i j a = vmap Λ (fun x => x ∘ Equiv.swap i j) a := by
  have hl := ha.length_eq
  apply List.ext_getElem (by simp [swapMap, vmap])
  intro k h₁ h₂
  simp only [vmap] at h₂ ⊢
  rw [getElem_setAct]
  simp only [swapMap, List.getElem_set]
  have inj : ∀ p q : Fin n, ((Λ.pos p : ℕ) = Λ.pos q) ↔ p = q := fun p q =>
    ⟨fun h => Λ.mono.injective (Fin.ext h), fun h => h ▸ rfl⟩
  cases h : Λ.actIdx k with
  | none =>
    have := Λ.actIdx_none h
    simp [this i, this j]
  | some m =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only [Function.comp_apply, val_act Λ ha, inj, Equiv.swap_apply_def]
    have hm : (Λ.pos m : ℕ) < a.length := by omega
    by_cases hmj : j = m
    · subst hmj
      by_cases hij : j = i
      · subst hij; simp
      · simp [hij]
    · by_cases hmi : i = m
      · subst hmi; simp [hmj]
      · simp [hmj, hmi, Ne.symm hmj, Ne.symm hmi, List.getElem?_eq_getElem hm]

end Swap

namespace Step

lemma invVec_vec {s : Step n Q} (hs : s.WF) (x : Fin n → ZMod Q) : s.invVec (s.vec x) = x := by
  cases s with
  | shift i u c => exact shiftInvVec_shiftVec hs.1 hs.2 x
  | swap i j => funext k; simp [vec, invVec]

variable [NeZero Q]

lemma addr_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.addr Λ a = vmap Λ s.vec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma inv_eq (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : s.inv Λ a = vmap Λ s.invVec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma valid_addr (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.addr Λ a) := by
  rw [addr_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma valid_inv (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.inv Λ a) := by
  rw [inv_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma inv_addr {s : Step n Q} (hs : s.WF) {a : List ℕ} (ha : Valid sh a) :
    s.inv Λ (s.addr Λ a) = a := by
  rw [addr_eq Λ s ha, inv_eq Λ s (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
  convert vmap_id Λ ha using 2
  funext x; exact invVec_vec hs x

end Step

section Run
variable [NeZero Q]

lemma run_eq_vmap (steps : List (Step n Q)) {a : List ℕ} (ha : Valid sh a) :
    run Λ steps a = vmap Λ (runVec steps) a := by
  induction steps generalizing a with
  | nil => exact (vmap_id Λ ha).symm
  | cons s rest ih =>
    simp only [run, List.foldl_cons] at ih ⊢
    rw [Step.addr_eq Λ s ha, ih (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
    rfl

lemma valid_run (steps : List (Step n Q)) {a : List ℕ} (ha : Valid sh a) :
    Valid sh (run Λ steps a) := by
  rw [run_eq_vmap Λ steps ha]; exact valid_vmap Λ _ ha

lemma invChain_run {steps : List (Step n Q)} (hs : ∀ s ∈ steps, s.WF) {a : List ℕ}
    (ha : Valid sh a) : invChain Λ steps (run Λ steps a) = a := by
  induction steps generalizing a with
  | nil => rfl
  | cons s rest ih =>
    simp only [run, List.foldl_cons, invChain, List.foldr_cons, Function.comp_apply] at ih ⊢
    rw [ih (fun t ht => hs t (List.mem_cons_of_mem _ ht)) (Step.valid_addr Λ s ha),
      Step.inv_addr Λ (hs s List.mem_cons_self) ha]

lemma runArr_pull {α : Type*} (d : α) (steps : List (Step n Q)) (g : List ℕ → List ℕ)
    (xs : List α) :
    AModel.runArr Λ d steps (pull sh sh g d xs) = pull sh sh (g ∘ invChain Λ steps) d xs := by
  induction steps generalizing g with
  | nil => rfl
  | cons s rest ih =>
    simp only [AModel.runArr, List.foldl_cons] at ih ⊢
    rw [Step.arr, pull_comp _ _ (fun a ha => Step.valid_inv Λ s ha), ih]
    rfl

/-- The array action of a list of steps is a single pull by the composed inverse. -/
theorem runArr_eq_pull {α : Type*} (d : α) (steps : List (Step n Q)) {xs : List α}
    (hxs : xs.length = vol sh) : AModel.runArr Λ d steps xs = pull sh sh (invChain Λ steps) d xs := by
  conv_lhs => rw [← pull_id d hxs]
  rw [runArr_pull]; rfl

end Run

