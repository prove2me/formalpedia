theorem solution
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∃ a b : ℕ,
      ∃ s₀ ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
        (∀ m : ℕ, ∀ t : HeckeAlg,
          (∀ s ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
            ∃ l ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
              t • s = 2 ^ (m + b) • l) →
          ∀ M : ℕ, ∀ x ∈ eisensteinTorsionBar p 2 M, 2 ^ m • x = 0 → t • x = 0) ∧
        (∀ m : ℕ, ∀ s ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
          ∃ t : HeckeAlg,
            t • s₀ ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) ∧
            ∃ l ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
              2 ^ a • s - t • s₀ = 2 ^ m • l) := by
  letI := heckeModuleBar p
  have hp : p.Prime := Fact.out
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI hcommJ := ModularCurve.smulCommClass_JZero_of_heckeOperatorsCommuteBar p
    (ModularCurve.heckeOperatorsCommuteBar p)
  haveI hcommJ' : SMulCommClass HeckeAlg (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (JZero p) :=
    SMulCommClass.symm _ _ _
  haveI : Module.Finite ℤ_[2] (_root_.TateModule 2 (JZero p)) :=
    ModularCurve.moduleFinite_padicInt_tateModule_jZero p 2
  haveI := noZeroSMulDivisors_tateModule p

  set Disp : Set (JZero p) := {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
    ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x} with hDisp

  have hEis : ∀ (t : HeckeAlg) (M : ℕ), ∀ x ∈ eisensteinTorsionBar p 2 M, t • x ∈ eisensteinTorsionBar p 2 M := by
    intro t M x hx
    exact Submodule.smul_mem _ t hx
  have hDstab : ∀ t : HeckeAlg, ∀ w ∈ AddSubgroup.closure Disp, t • w ∈ AddSubgroup.closure Disp := by
    intro t w hw
    have h1 : (AddSubgroup.closure Disp).map (DistribSMul.toAddMonoidHom (JZero p) t) ≤ AddSubgroup.closure Disp := by
      rw [AddMonoidHom.map_closure]
      refine AddSubgroup.closure_mono ?_
      rintro _ ⟨w, ⟨σ, hσ, M, x, hx, rfl⟩, rfl⟩
      refine ⟨σ, hσ, M, t • x, hEis t M x hx, ?_⟩
      show t • (σ • x - x) = σ • (t • x) - t • x
      rw [smul_sub, smul_comm]
    exact h1 ⟨w, hw, rfl⟩

  let Λ : Submodule ℤ_[2] (_root_.TateModule 2 (JZero p)) := tateSub p (AddSubgroup.closure Disp)

  let A₀ := Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t)
  letI : CommRing ↥A₀ := Algebra.adjoinCommRingOfComm ℤ_[2] (tateHeckeRep_comm p)
  have hA₀Λ : ∀ α ∈ A₀, ∀ s ∈ Λ, α s ∈ Λ := fun α hα s hs =>
    adjoin_apply_mem_tateSub p (fun t => hDstab t) hα hs

  haveI : IsScalarTower ℤ_[2] ↥A₀ (_root_.TateModule 2 (JZero p)) := ⟨fun _ _ _ => rfl⟩

  let res : ∀ α : Module.End ℤ_[2] (_root_.TateModule 2 (JZero p)), α ∈ A₀ → Module.End ℤ_[2] ↥Λ :=
