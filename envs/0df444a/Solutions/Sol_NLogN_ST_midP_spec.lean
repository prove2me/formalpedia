      · exact IState.isInt_of (L := s.G m) (a := (min k μ : ℕ)) (by simp [withCtr, IState.upd_G, hmC])
      · rw [withCtr, Ex.ok_upd _ _ _ c hcC]; exact (hc _).1
      · split_ifs <;> trivial
    · exact IState.isInt_of (L := s.G m) (a := (min k μ : ℕ)) (by simp [withCtr, IState.upd_G, hmC])
