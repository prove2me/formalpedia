theorem GlobalTheory.SmGL.deltaHalf_two (g : GL a k × GL b k) :
    deltaHalf k (Two a b) (leviTwo k a b g) =
      absPow k ((Fintype.card b : ℂ) / 2) (GeneralLinearGroup.det g.1) *
        absPow k (-(Fintype.card a : ℂ) / 2) (GeneralLinearGroup.det g.2) := by sorry
