import Mathlib
import Definitions.Def_Atlas_Core_Basic
import Definitions.Def_Atlas_Core_Certificate
/-!
# Minkowski space in Cartesian coordinates, any dimension `n + 1`

`ds² = -dt² + dx₁² + … + dxₙ²` (Müller–Grave, *Catalogue of Spacetimes*, eq. minkCart, `c = 1`).
Certified on all of `ℝⁿ⁺¹`. For release 0.1 the catalogue row is `n = 3`.
-/

open scoped ContDiff

namespace ExactVacuumAtlas.Minkowski

/-- Cartesian Minkowski metric, constant components `diag(-1, 1, …, 1)`. -/
def gCart (n : ℕ) : Metric (n + 1) := fun i j _ => eta n i j

/-- Its inverse (the same matrix). -/
def giCart (n : ℕ) : Metric (n + 1) := fun i j _ => eta n i j

end ExactVacuumAtlas.Minkowski


