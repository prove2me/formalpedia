-- Prove2me | Theorems.Thm_InertialAVD_Algo_eq_66
-- name    : InertialAVD.Algo.eq_66
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:08:21.043655+00:00
-- url     : https://prove2.me/theorems/e75c9346-39ac-4811-b611-6403c7926ff0
-- title:
--   (66) — perturbed energy step $\mathcal G(k+1)+2s\frac{\alpha-3}{\alpha-1}k(\Theta(x_k)-\Theta^*)\le\mathcal G(k)+2s(k+\alpha-1)\langle g_k,z_{k+1}-x^*\rangle$
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, let $\Phi:\mathcal H\to\mathbb R\cup\{+\infty\}$ be proper, lower semicontinuous and convex, and let $\Psi:\mathcal H\to\mathbb R$ be convex and continuously differentiable with $L$-Lipschitz continuous gradient; write $\Theta=\Phi+\Psi$. Let $s>0$ with $sL<1$, let $(g_k)_{k\ge 0}$ be a sequence of perturbations in $\mathcal H$, and let $(x_k)_{k\ge0},(y_k)_{k\ge0}$ be generated by the perturbed inertial forward-backward algorithm (55):
--
--   $$y_k = x_k + \frac{k-1}{k+\alpha-1}(x_k-x_{k-1})\ (k\ge 1),\qquad x_{k+1}=\operatorname{prox}_{s\Phi}\big(y_k-s(\nabla\Psi(y_k)-g_k)\big)\ (k\ge 0),$$
--
--   with $y_0\in\mathcal H$ arbitrary.
--
--   Assume $\alpha\ge 3$ and let $x^*$ be a minimizer of $\Theta$. Write $z_k=\frac{k+\alpha-1}{\alpha-1}y_k-\frac{k}{\alpha-1}x_k$ (59) and, for a minimizer $x^*$ of $\Theta$, $\mathcal G(k)=\frac{2s}{\alpha-1}(k+\alpha-2)^2\big(\Theta(x_k)-\Theta(x^*)\big)+(\alpha-1)\|z_k-x^*\|^2$. Then for every $k\ge0$,
--
--   $$\mathcal G(k+1)+2s\,\frac{\alpha-3}{\alpha-1}\,k\,\big(\Theta(x_k)-\Theta(x^*)\big)\le \mathcal G(k)+2s\,(k+\alpha-1)\,\langle g_k,\,z_{k+1}-x^*\rangle .$$
--
--   This is the one-step Lyapunov inequality behind both the rate of Theorem 5.1 and the summability in Theorem 5.3: without perturbations $\mathcal G$ is nonincreasing, and the perturbation enters only through the last inner product.
--
--   **Formalization Note.** $\Phi$ is `EReal`-valued with `IsProperClosedConvex`; $\operatorname{prox}_{s\Phi}$ is a map $P$ with `IsProx s Φ P`; $\Theta$ is the published `NesterovFB.Rates.theta Φ Ψ` (whose argument names are swapped relative to this paper: its first argument is the nonsmooth part). $L$ is a nonnegative real and "$0<s<1/L$" is written $0<s$, $sL<1$, so $L=0$ is allowed. The run is `IsPerturbedRun`. Both sides are extended reals; at $k=0$ with $\Theta(x_0)=+\infty$ the right side is $+\infty$.
-- source:
--   Attouch, Chbani, Peypouquet, Redont, Fast convergence of inertial dynamics and algorithms with asymptotic vanishing damping, Optimization Online preprint 5179 (Oct. 2015), p. 20, (66)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_InertialAVD_Algo_PerturbedRun

open Filter Topology NesterovFB.Rates

namespace InertialAVD.Algo

/-- (66), p. 20: the perturbed energy step. For `α ≥ 3`, a minimizer `x*` of `Θ = Φ + Ψ` and
every `k ≥ 0`,
`𝒢(k+1) + 2s(α−3)/(α−1)·k·(Θ(x_k) − Θ(x*)) ≤ 𝒢(k) + 2s(k+α−1)⟨g_k, z_{k+1} − x*⟩`. -/
theorem eq_66 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → EReal) (Ψ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (g : ℕ → H) (x y : ℕ → H)
    (hΦ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Φ)
    (hΨc : ConvexOn ℝ Set.univ Ψ) (hΨd : ContDiff ℝ 1 Ψ)
    (hL : LipschitzWith L (gradient Ψ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Φ P)
    (hrun : IsPerturbedRun Ψ P α s g x y)
    (hα : 3 ≤ α)
    (xstar : H) (hxstar : ∀ v : H, theta Φ Ψ xstar ≤ theta Φ Ψ v) :
    ∀ k : ℕ, energyG Φ Ψ α s x y xstar (k + 1)
        + ((2 * s * (α - 3) / (α - 1) * (k : ℝ) : ℝ) : EReal)
          * (theta Φ Ψ (x k) - theta Φ Ψ xstar)
      ≤ energyG Φ Ψ α s x y xstar k
        + ((2 * s * ((k : ℝ) + α - 1) * inner ℝ (g k) (zSeq α x y (k + 1) - xstar) : ℝ) : EReal) := by sorry

end InertialAVD.Algo
