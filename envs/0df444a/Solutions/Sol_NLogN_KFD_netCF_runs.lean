      (AModel.physStepF (NLogN.KIL.funΦ v Φ) (lab, Y) g).2
      (Function.update f 0 (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf (AModel.physStepF (NLogN.KIL.funΦ v Φ) (lab, Y) g).2) ++ rest)) hF.2
      (NLogN.KIL.prot_upd0 hfp _) (hR.upd (by decide) _) (by simp) (by simp [hf21])
    have H := h1.seq h2
    refine H.mono' ?_ le_rfl
    rw [Function.update_idem, NLogN.KIL.netRunF_cons]

theorem solution {G0 : Fin NLogN.HS → List NLogN.Item} (Φ : M → List (ZMod 2) → List (ZMod 2))
    (Pr : M → Prop)
    (hΦl : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → (Φ X ys).length = v)
    (hE : ∀ X, Pr X → ∀ ys : List (ZMod 2), ys.length = v → ∀ (t : NLogN.IState NLogN.HS) (R : List NLogN.Item),
      NLogN.KIL.Inv G0 t →
      NLogN.IRuns I iprog (E X) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 ys) ++ R)) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 (Φ X ys)) ++ R))
        (cE X))
    (s : NLogN.IState NLogN.HS) (hs : NLogN.KIL.Inv G0 s) (rest : List ℤ) {Bb : ℕ} (hB : NLogN.KIL.TabB W v Bb) (hv1 : 1 ≤ v)
    (Mout : Fin W → M) :
    ∀ (gates : List (AModel.NGate (Fin W) (ZMod 2) M)) (lab : Fin W → M) (Y : Fin W → Fin v → ZMod 2)
      (f : Fin NLogN.HS → List ℤ), AModel.FramesOK Pr gates lab Mout →
      (∀ r, NLogN.KIL.Prot r → f r = []) → NLogN.KIL.RegS s f W v →
      f 0 = NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf Y) ++ rest → f 21 = [] →
      NLogN.IRuns I iprog (NLogN.KFD.netCF E Mout lab gates) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0
          (NLogN.KIL.tabR 0 W (NLogN.KIL.tabOf (AModel.netRunF (NLogN.KIL.funΦ v Φ) gates lab Mout Y)) ++ rest)))
        (NLogN.KFD.netCIF cE (W * v) Bb Mout lab gates) := by
  first
  | exact netCF_runs_aux
  | (intros; apply netCF_runs_aux <;> assumption)
end
