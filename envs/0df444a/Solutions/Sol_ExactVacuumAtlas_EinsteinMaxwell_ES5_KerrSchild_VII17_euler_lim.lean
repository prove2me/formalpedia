open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
open Filter Set Topology
open scoped ContDiff
theorem solution {n : ℕ} {M φ : ℝ → ℝ} (hM : PS M)
    (hode : ∀ᶠ x in 𝓝[>] (0:ℝ), x * deriv M x + ((n : ℝ) + 1) * M x = φ x)
    (hxM : Tendsto (fun x => x * M x) (𝓝[>] (0:ℝ)) (𝓝 0))
    {L : ℝ} (hφ : Tendsto φ (𝓝[>] (0:ℝ)) (𝓝 L)) :
    Tendsto M (𝓝[>] (0:ℝ)) (𝓝 (L / ((n : ℝ) + 1))) := by
  obtain ⟨δ, hδ, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 (hM.and hode)
  have hf : ∀ x ∈ Ioo (0:ℝ) δ, HasDerivAt (fun y => y ^ (n + 1) * M y) (x ^ n * φ x) x := by
    intro x hx
    obtain ⟨hc, he⟩ := (show ContDiffAt ℝ ∞ M x ∧ _ from hsub hx)
    have hd : HasDerivAt M (deriv M x) x := (hc.differentiableAt (by simp)).hasDerivAt
    refine ((hasDerivAt_pow (n + 1) x).mul hd).congr_deriv ?_
    rw [← he, Nat.add_sub_cancel]; push_cast; ring
  have hg : ∀ x ∈ Ioo (0:ℝ) δ, HasDerivAt (fun y => y ^ (n + 1)) (((n : ℝ) + 1) * x ^ n) x := by
    intro x _
    simpa using hasDerivAt_pow (n + 1) x
  have hg' : ∀ x ∈ Ioo (0:ℝ) δ, ((n : ℝ) + 1) * x ^ n ≠ 0 := fun x hx =>
    mul_ne_zero (by positivity) (pow_ne_zero _ hx.1.ne')
  have hfa : Tendsto (fun y => y ^ (n + 1) * M y) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have h1 : Tendsto (fun y : ℝ => y ^ n) (𝓝[>] (0:ℝ)) (𝓝 ((0:ℝ) ^ n)) :=
      ((continuous_pow n).tendsto 0).mono_left nhdsWithin_le_nhds
    have := h1.mul hxM
    rw [mul_zero] at this
    exact this.congr' (Eventually.of_forall fun y => by ring)
  have hga : Tendsto (fun y : ℝ => y ^ (n + 1)) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    have := ((continuous_pow (n + 1)).tendsto (0:ℝ)).mono_left (nhdsWithin_le_nhds (s := Ioi 0))
    simpa using this
  have hdiv : Tendsto (fun x => x ^ n * φ x / (((n : ℝ) + 1) * x ^ n)) (𝓝[>] (0:ℝ))
      (𝓝 (L / ((n : ℝ) + 1))) := by
    refine (hφ.div_const ((n : ℝ) + 1)).congr' ?_
    filter_upwards [ev_pos] with x hx
    have : x ^ n ≠ 0 := pow_ne_zero _ (ne_of_gt hx)
    field_simp
  have := HasDerivAt.lhopital_zero_right_on_Ioo hδ hf hg hg' hfa hga hdiv
  refine this.congr' ?_
  filter_upwards [ev_pos] with x hx
  have : x ^ (n + 1) ≠ 0 := pow_ne_zero _ (ne_of_gt hx)
  field_simp
