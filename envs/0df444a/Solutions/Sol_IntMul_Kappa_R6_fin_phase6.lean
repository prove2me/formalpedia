section
-- Source module: Solutions.ResampleCRT
/-!
# §9.3 An explicit cyclic-convolution layout

* `Phi`: `ℤ/S → ∏ ℤ/s_i`, `k ↦ (μ_i k)_i` (the coordinate map of `x ↦ ∏ x_i^{μ_i}`), an additive
  equivalence for pairwise coprime `s_i` and units `μ_i` (`PhiEquiv`); every additive
  equivalence carries cyclic convolution to cyclic convolution (`conv_addEquiv`), so
  `Φ(u ∗ v) = Φu ∗ Φv` (`Phi_conv`).
* Mixed radix: `k mod P_i = Σ_{j<i} a_j P_j` (`mod_prefix_eq_sum`) and the coordinate formula
  (42): `μ_i k ≡ a_i + μ_i Σ_{j<i} a_j P_j (mod s_i)` (`coord_formula`).
* Triangular realization: the prefix-controlled cyclic shifts, processed for `i = d-1, …, 0`,
  send every valid address `a` to `b` of (42) (`shifts_realize`); each shift is a bijection of
  the padded box preserving the valid set `V` and its complement (`upd_inv`, `upd_valid`,
  `upd_invalid`).
-/

open Finset

namespace IntMul.OpenAI.RCRT

/-! ### Convolution is preserved by additive equivalences -/

section conv
variable {G H : Type*} [AddCommGroup G] [AddCommGroup H] [Fintype G] [Fintype H]
  {R : Type*} [CommRing R]

theorem conv_addEquiv (e : G ≃+ H) (u v : G → R) :
    gconv (u ∘ e.symm) (v ∘ e.symm) = gconv u v ∘ e.symm := by
  ext y
  simp only [gconv, Function.comp_apply]
  refine Fintype.sum_equiv e.symm.toEquiv _ _ (fun k => ?_)
  simp [map_sub]

end conv

/-! ### The map `Φ` -/

variable {d : ℕ}

lemma PhiEquiv_apply (s : Fin d → ℕ) [∀ i, NeZero (s i)]
    (hcop : Pairwise (Function.onFun Nat.Coprime s)) (μ : Fin d → ℕ)
    (hμ : ∀ i, Nat.Coprime (μ i) (s i)) (k : ZMod (∏ i, s i)) :
    PhiEquiv s hcop μ hμ k = Phi s μ k := by
  ext i
  simp only [PhiEquiv, Phi, AddEquiv.trans_apply, RingEquiv.toAddEquiv_eq_coe,
    RingEquiv.coe_toAddEquiv, AddEquiv.piCongrRight_apply, AddEquiv.coe_mk, Equiv.coe_fn_mk]
  rw [ZMod.prodEquivPi_apply]

/-- `Φ` preserves cyclic convolution (Agarwal–Cooley with unit exponents). -/
theorem Phi_conv (s : Fin d → ℕ) [∀ i, NeZero (s i)] [NeZero (∏ i, s i)]
    (hcop : Pairwise (Function.onFun Nat.Coprime s)) (μ : Fin d → ℕ)
    (hμ : ∀ i, Nat.Coprime (μ i) (s i)) {R : Type*} [CommRing R]
    (u v : ZMod (∏ i, s i) → R) :
    gconv (u ∘ (PhiEquiv s hcop μ hμ).symm) (v ∘ (PhiEquiv s hcop μ hμ).symm) =
      gconv u v ∘ (PhiEquiv s hcop μ hμ).symm :=
  conv_addEquiv _ u v

/-! ### Mixed radix and the coordinate formula (42) -/

lemma mod_prefix_eq_sum (s : ℕ → ℕ) (k : ℕ) :
    ∀ i, k % Ppre s i = ∑ j ∈ range i, digit s k j * Ppre s j
  | 0 => by simp [Ppre, Nat.mod_one]
  | i + 1 => by
    rw [Finset.sum_range_succ, ← mod_prefix_eq_sum s k i]
    have : Ppre s (i + 1) = Ppre s i * s i := by simp [Ppre, Finset.prod_range_succ]
    rw [this, Nat.mod_mul, digit]; ring

/-- `k = Σ_j a_j P_j` once `k < P_d`. -/
lemma mixed_radix (s : ℕ → ℕ) (k i : ℕ) (hk : k < Ppre s i) :
    k = ∑ j ∈ range i, digit s k j * Ppre s j := by
  rw [← mod_prefix_eq_sum, Nat.mod_eq_of_lt hk]

/-- **(42)**: if `μ_i P_i ≡ 1 (mod s_i)` then
`μ_i k ≡ a_i + μ_i Σ_{j<i} a_j P_j (mod s_i)`. -/
theorem coord_formula (s : ℕ → ℕ) (μ : ℕ → ℕ) (i k : ℕ)
    (hμ : ((μ i * Ppre s i : ℕ) : ZMod (s i)) = 1) :
    ((μ i * k : ℕ) : ZMod (s i)) =
      ((digit s k i + μ i * ∑ j ∈ range i, digit s k j * Ppre s j : ℕ) : ZMod (s i)) := by
  rw [← mod_prefix_eq_sum]
  have h1 : k = k % Ppre s i + Ppre s i * (k / Ppre s i) := (Nat.mod_add_div k _).symm
  have h2 : ((k / Ppre s i : ℕ) : ZMod (s i)) = ((digit s k i : ℕ) : ZMod (s i)) := by
    rw [digit, ZMod.natCast_mod]
  conv_lhs => rw [h1]
  push_cast at hμ ⊢
  rw [h2]
  linear_combination (digit s k i : ZMod (s i)) * hμ

/-! ### Realization by prefix-controlled cyclic shifts -/

section shifts
variable (s μ : ℕ → ℕ)

/-- Processing the targets `m, …, m+n-1` in descending order on a valid address updates each of
them from the original lower coordinates. -/
theorem shifts_foldr (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    ∀ n m, m + n ≤ d → (List.range' m n).foldr (upd s μ) a =
      fun j => if m ≤ j ∧ j < m + n then (a j + offset s μ a j) % s j else a j
  | 0, m, _ => by funext j; simp
  | n + 1, m, h => by
    rw [List.range'_succ, List.foldr_cons, shifts_foldr d a ha n (m + 1) (by omega)]
    set y : ℕ → ℕ := fun j => if m + 1 ≤ j ∧ j < m + 1 + n then
      (a j + offset s μ a j) % s j else a j with hy
    have hyl : ∀ j ≤ m, y j = a j := by
      intro j hj; simp only [hy]; rw [if_neg (by omega)]
    have hval : validUpTo s y m := fun j hj => by rw [hyl j hj]; exact ha j (by omega)
    have hoff : offset s μ y m = offset s μ a m := by
      unfold offset; congr 1
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [hyl j (by simp at hj; omega)]
    unfold upd
    rw [if_pos hval, hoff, hyl m le_rfl]
    funext j
    rcases eq_or_ne j m with rfl | hne
    · simp
    · rw [Function.update_of_ne hne]; simp only [hy]
      by_cases h1 : m + 1 ≤ j ∧ j < m + 1 + n
      · rw [if_pos h1, if_pos (by omega)]
      · rw [if_neg h1, if_neg (by omega)]

/-- **Triangular realization of `Φ`**: the shifts for `i = d-1, …, 0` send the valid address
`a` to `b_i = (a_i + μ_i Σ_{j<i} a_j P_j) mod s_i` (42). -/
theorem shifts_realize (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    (List.range d).foldr (upd s μ) a =
      fun j => if j < d then (a j + offset s μ a j) % s j else a j := by
  rw [List.range_eq_range', shifts_foldr s μ d a ha d 0 (by omega)]
  funext j; simp

end shifts

end IntMul.OpenAI.RCRT

end

