theorem CongruenceSubgroup.index_inf_gamma0_mul_sup_zpowers_neg_one_of_gamma1_le_of_le_gamma0
    (L : ℕ) [NeZero L] (Γ : Subgroup SL(2, ℤ))
    (hΓ₁ : CongruenceSubgroup.Gamma1 L ≤ Γ) (hΓ₀ : Γ ≤ CongruenceSubgroup.Gamma0 L)
    (ℓ : ℕ) (hℓ : ℓ.Prime) :
    ((Γ ⊓ CongruenceSubgroup.Gamma0 (L * ℓ)) ⊔ Subgroup.zpowers (-1)).index =
      (Γ ⊔ Subgroup.zpowers (-1)).index * (if ℓ ∣ L then ℓ else ℓ + 1) := by sorry
