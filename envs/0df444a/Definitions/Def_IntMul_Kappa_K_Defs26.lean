section
-- Source module: Solutions.KFV2Dbl
/-!
# KFV §2: the doubling scan (every block followed by its negation)

`dblI X m`: stack `0` holds `X` blocks of `m` integers; afterwards it holds
`dblPre m xs X` (block `b` replaced by `b ++ (-b)`).  Per block: `dup` to `zX`, `neg`, move to
the buffer `zO`; the negated copy goes `zX → zY → zO`; finally the whole buffer goes back.
Cost `≤ 10^4 (w+1)(2Xm + X + 1)` (`cDblI_le`).  Stacks: `0`, buffers `zX = 53`, `zY = 54`,
`zO = 63`, counters `57–62` (all restored).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFV

open IntMul KFC KFT KFU AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

abbrev zX : Fin HS := 53
abbrev zY : Fin HS := 54

/-- Negate every entry. -/
def negL (l : List ℤ) : List ℤ := l.map (fun a => -a)

/-- One step: `dup 0 zX; neg zX; mv 0 zO`. -/
def dnStep : IStmt HS Pp := .seq (.op (.dup 0 zX)) (.seq (.op (.neg zX)) (.op (.mv 0 zO)))

/-- The doubled prefix after `k` blocks. -/
def dblPre (m : ℕ) (xs : List ℤ) (k : ℕ) : List ℤ :=
  (List.range k).flatMap fun x => (xs.drop (x * m)).take m ++ NLogN.KFV.negL ((xs.drop (x * m)).take m)

/-- One block. -/
def dblBlk (m : ℕ) : IStmt HS Pp :=
  .seq (rpt NLogN.KFU.zA zC NLogN.KFU.zD m dnStep) (.seq (rpt NLogN.KFU.zA zC NLogN.KFU.zD m (.op (.mv zX zY)))
    (rpt NLogN.KFU.zA zC NLogN.KFU.zD m (.op (.mv zY zO))))

def cDBlk (m w : ℕ) : ℕ :=
  (m * (500 * (w + 1) + 64) + 60 + cRpt m) + 2 * (m * (76 * w + 101 + 64) + 60 + cRpt m)

/-- **The doubling scan.** -/
def dblI (X m : ℕ) : IStmt HS Pp :=
  .seq (.op (.mark zO)) (.seq (rpt NLogN.KFU.oA NLogN.KFU.oC NLogN.KFU.oD X (dblBlk m)) (.seq (mvW zO 0) (.op (.unmark zO))))

def cDblI (X m w : ℕ) : ℕ :=
  1 + ((X * (cDBlk m w + 64) + 60 + cRpt X) + (X * (2 * m) * kap w + 30 + 1))

end NLogN.KFV

end

