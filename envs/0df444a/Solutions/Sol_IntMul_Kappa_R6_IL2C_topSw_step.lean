-- Source module: Solutions.R6IL2CIdx
/-!
# Round six, compact controls (I2C): rank maps

* `rix_flR`: a reindexing of the bit array that acts record-wise is a reindexing of the records.
* `rotP`, `rot_flR`: the table rotation (`KFC.rotF`) of a field `(Q, S)` on records.
* `swP`, `sw_flR`: the Lemma 12 swap of two fields of the same size on records.
* Fields `(Q, S)` nested in each other: `gc`/`sc` commute (`fld_*`).
* `Lay`: the five fields `T, U, X, Y, Bk` of a record index; `cs m`, `xv m`, `setCS`;
  each step of the program is `m ↦ setCS (F (xv m) (cs m)) m` (`stepP`), and steps compose.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL AModel AModelL12

/-! ## Record-wise reindexing -/

theorem rix_flR {recs : ℕ → List ℤ} {B M : ℕ} (hB : 0 < B) (h : ∀ m, (recs m).length = B)
    {φ : ℕ → ℕ} (hφ : ∀ m < M, φ m < M) :
    rix (M * B) (fun j => φ (j / B) * B + j % B) 0 (flR recs M) =
      flR (fun m => recs (φ m)) M := by
  have hl' : ∀ m, ((fun m => recs (φ m)) m).length = B := fun m => h _
  apply List.ext_getElem (by rw [length_rix, length_flR hl'])
  intro j h1 h2
  rw [length_rix] at h1
  have hj : j = j / B * B + j % B := (Nat.div_add_mod' j B).symm
  have hm : j / B < M := by rw [Nat.div_lt_iff_lt_mul hB]; exact h1
  have hb : j % B < B := Nat.mod_lt _ hB
  have e1 : (rix (M * B) (fun j => φ (j / B) * B + j % B) 0 (flR recs M))[j] =
      (rix (M * B) (fun j => φ (j / B) * B + j % B) 0 (flR recs M)).getD j 0 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem]; rfl
  have e2 : (flR (fun m => recs (φ m)) M)[j] = (flR (fun m => recs (φ m)) M).getD j 0 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem]; rfl
  rw [e1, e2, getD_rix _ _ _ h1]
  conv_rhs => rw [hj]
  rw [getD_flR h (hφ _ hm) hb, getD_flR hl' hm hb]

/-! ## Fields with a record factor -/

theorem gc_mulB (Q S B j : ℕ) : gc Q (S * B) j = gc Q S (j / B) := by
  unfold gc; rw [Nat.div_div_eq_div_mul, mul_comm B S]

/-! ## Rotations on records -/

/-! ## Swaps on records -/

theorem swP_int {F S1 S2 : ℕ} (hF : 0 < F) (hS2 : 0 < S2) {k : ℕ} (hk0 : 0 < k) (hk : S1 = S2 * F * k)
    (m : ℕ) :
    (swP F S1 S2 m : ℤ) = m + ((gc F S1 m : ℤ) - gc F S2 m) * S2 +
      ((gc F S2 m : ℤ) - gc F S1 m) * S1 := by
  unfold swP
  rw [sc_int, sc_int, gc_sc_hi hS2 hk0 (by rw [hk]; ring) (gc_lt hF _) m]

theorem swP_lt {F S1 S2 M : ℕ} (hF : 0 < F) (hS1 : 0 < S1) (hS2 : 0 < S2) {k : ℕ}
    (hk : S1 = S2 * F * k) {c : ℕ} (hM : M = F * S1 * c) {m : ℕ} (hm : m < M) : swP F S1 S2 m < M := by
  have hS2M : M = F * S2 * (k * F * c) := by rw [hM, hk]; ring
  have h1 : sc F S2 (gc F S1 m) m < M := by
    rw [hS2M] at hm ⊢; exact sc_lt hS2 (gc_lt hF _) hm
  rw [hM] at h1 ⊢
  exact sc_lt hS1 (gc_lt hF _) h1

theorem sw_flR {P Mid S F B : ℕ} (hP : 0 < P) (hMid : 0 < Mid) (hS : 0 < S) (hF : 0 < F)
    (hB : 0 < B) {recs : ℕ → List ℤ} (h : ∀ m, (recs m).length = B) :
    pull (binShape [P] [Mid] [S * B] F) (binShape [P] [Mid] [S * B] F) (swapPos 1 3) 0
        (flR recs (P * F * Mid * F * S)) =
      flR (fun m => recs (swP F (Mid * F * S) S m)) (P * F * Mid * F * S) := by
  have hk : Mid * F * S = S * F * Mid := by ring
  have hMM : P * F * Mid * F * S = F * (Mid * F * S) * P := by ring
  rw [← rix_flR hB h (fun m hm => swP_lt hF (by positivity) hS hk hMM hm)]
  have hV : vol (binShape [P] [Mid] [S * B] F) = P * F * Mid * F * S * B := by
    simp [binShape, vol]; ring
  apply List.ext_getElem (by rw [length_pull, length_rix, hV])
  intro j h1 h2
  rw [getElem_pull]
  simp only [rix, List.getElem_map, List.getElem_range]
  congr 1
  rw [length_pull, hV] at h1
  set sh := binShape [P] [Mid] [S * B] F
  have hj : j < vol sh := by rw [hV]; exact h1
  have hl : (decode sh j).length = 5 := by rw [length_decode]; rfl
  have hval := valid_decode hj
  have d1 : (decode sh j).getD 1 0 = gc F (Mid * F * S * B) j := by
    rw [KFH.getD_digit sh _ 1 hval (by omega), encode_decode hj]
    simp [sh, binShape, gc, vol]; ring_nf
  have d3 : (decode sh j).getD 3 0 = gc F (S * B) j := by
    rw [KFH.getD_digit sh _ 3 hval (by omega), encode_decode hj]
    simp [sh, binShape, gc, vol]
  have e := encode_swapPos sh (decode sh j) (p := 1) (q := 3) (by norm_num) (by omega) (by omega)
    (by rw [hl]; rfl)
  rw [encode_decode hj, d1, d3] at e
  have v2 : vol (sh.drop 2) = Mid * F * S * B := by simp [sh, binShape, vol]; ring
  have v4 : vol (sh.drop 4) = S * B := by simp [sh, binShape, vol]
  rw [v2, v4] at e
  have e2 := swP_int hF hS (k := Mid) hMid (by ring) (j / B) (S1 := Mid * F * S)
  rw [gc_mulB, gc_mulB] at e
  have hjB : (j : ℤ) = ((j / B : ℕ) : ℤ) * B + ((j % B : ℕ) : ℤ) := by
    exact_mod_cast (Nat.div_add_mod' j B).symm
  have : (encode sh (swapPos 1 3 (decode sh j)) : ℤ) =
      ((swP F (Mid * F * S) S (j / B) : ℕ) : ℤ) * (B : ℤ) + ((j % B : ℕ) : ℤ) := by
    rw [e, e2, hjB]; push_cast; ring
  exact_mod_cast this

/-! ## Nested fields -/

theorem nest_trans {S1 S2 S3 Q2 Q3 k k' : ℕ} (hk : 0 < k) (hk' : 0 < k') (h1 : S1 = S2 * Q2 * k)
    (h2 : S2 = S3 * Q3 * k') (hQ2 : 0 < Q2) : ∃ k'', 0 < k'' ∧ S1 = S3 * Q3 * k'' :=
  ⟨k' * Q2 * k, by positivity, by rw [h1, h2]; ring⟩

