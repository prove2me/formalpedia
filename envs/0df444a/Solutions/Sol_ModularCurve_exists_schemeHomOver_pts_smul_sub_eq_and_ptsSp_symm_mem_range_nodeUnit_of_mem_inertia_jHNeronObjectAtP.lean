  rw [Equiv.apply_symm_apply] at hy
  refine (O'.torus_ptsSp _).1 ⟨⟨y.1 ≫ Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom (ResidueField ↥A) Mx)), ?_⟩, ?_⟩
  · rw [Category.assoc]
    have : Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom (ResidueField ↥A) Mx)) ≫ torusStr (ResidueField ↥A) O'.toricRank =
        torusStr (ResidueField ↥A) O.toricRank := by
      change Spec.map _ ≫ Spec.map _ = Spec.map _
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      exact (AddMonoidAlgebra.mapDomainAlgHom (ResidueField ↥A) (ResidueField ↥A) Mx).comp_algebraMap
