variable {h : ℕ} {T : Type} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}
theorem cxNamed_len_le :
    (NetComplex.cxNamed ℂ ind).length ≤
      3 * (Fintype.card T * Fintype.card T) * (4 * Fintype.card T + 4) := by
  have hj : ∀ j : Fin 3, ((univ : Finset (T × T)).toList.flatMap fun p =>
      (NetComplex.schedJ ℂ ind j p).map fun g => ((j, p, g.1), g.2)).length ≤
      (Fintype.card T * Fintype.card T) * (4 * Fintype.card T + 4) := by
    intro j
    have := len_flatMap_le (fun _ => false) 0 (4 * Fintype.card T + 4)
      (fun p => (NetComplex.schedJ ℂ ind j p).map fun g => ((j, p, g.1), g.2))
      (univ : Finset (T × T)).toList (fun p _ => by
        simp only [List.length_map, zero_mul, zero_add, NetComplex.schedJ]
        split_ifs
        · simp [NetComplex.invNamed, named_len]
        · simp [named_len])
    simp only [zero_mul, zero_add, Finset.length_toList, Finset.card_univ,
      Fintype.card_prod] at this
    linarith
  unfold NetComplex.cxNamed
  simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil, List.length_append]
  have := hj 0; have := hj 1; have := hj 2
  linarith

theorem prog_len_le :
    (prog ind).length ≤ 2 * Fintype.card (NetComplex.Wr ind) + 2 +
      3 * (Fintype.card T * Fintype.card T) * (4 * Fintype.card T + 4) +
      (2 * h ^ 3 + 1) * (prog ind).countP RStep.isChild := by
  have hpre := len_flatMap_le RStep.isChild 0 1 (preSteps ind)
    (univ : Finset (NetComplex.Wr ind)).toList (fun w _ => by
      rcases w with a | a | s <;> simp [preSteps])
  have hpost := len_flatMap_le RStep.isChild 0 1 (postSteps ind)
    (univ : Finset (NetComplex.Wr ind)).toList (fun w _ => by
      rcases w with a | a | (s | s) <;> simp [postSteps])
  have hnet := netSteps_len (MoutF ind) (gatesF ind) (MinF ind)
  have hg : (gatesF ind).length = (NetComplex.cxNamed ℂ ind).length + 1 := by
    unfold NetComplexP8.gatesF NetComplex.labelled NetComplex.cxFixNamed
    simp only [List.length_map, List.length_append, List.length_singleton]
  have hc := cxNamed_len_le (ind := ind)
  simp only [zero_mul, zero_add, one_mul, Finset.length_toList, Finset.card_univ] at hpre hpost
  have hcp : (netSteps (gatesF ind) (MinF ind) (MoutF ind)).countP RStep.isChild ≤
      (prog ind).countP RStep.isChild := by
    unfold prog
    simp only [List.countP_append]
    omega
  have hm := Nat.mul_le_mul_left (2 * h ^ 3 + 1) hcp
  have hl : (prog ind).length = ((univ : Finset (NetComplex.Wr ind)).toList.flatMap (preSteps ind)).length +
      (netSteps (gatesF ind) (MinF ind) (MoutF ind)).length +
      ((univ : Finset (NetComplex.Wr ind)).toList.flatMap (postSteps ind)).length + 1 := by
    unfold prog
    simp only [List.length_append, List.length_singleton]
  rw [hg] at hnet
  rw [hl]
  linarith

/-- The same with the cardinalities as parameters (keeps the kernel away from the instances of
the concrete `T₀` when instantiating). -/
theorem prog_len_le' (cW cT : ℕ) (hW : Fintype.card (NetComplex.Wr ind) = cW)
    (hT : Fintype.card T = cT) :
    (prog ind).length ≤ 2 * cW + 2 + 3 * (cT * cT) * (4 * cT + 4) +
      (2 * h ^ 3 + 1) * (prog ind).countP RStep.isChild := by
  have := prog_len_le (ind := ind); rw [hW, hT] at this; exact this

end Prog

/-- **An explicit bound on the length of the complex network.** -/
theorem net_length_le : complexIface.net.length ≤ Lb := by
  have hc : ((prog NetComplex.ind₀).map (RStep.map P8Lift.eW)).countP RStep.isChild = sc :=
    complexIface.count
  have e : (RStep.isChild ∘ RStep.map (m := 100 ^ 3) P8Lift.eW) = RStep.isChild := by
    funext st; exact RStep.isChild_map P8Lift.eW st
  rw [List.countP_map, e] at hc
  have hlen : complexIface.net.length = (prog NetComplex.ind₀).length :=
    List.length_map _
  have := prog_len_le' (ind := NetComplex.ind₀) Wc 161700 NetComplex.card_Wr₀ NetComplex.card_T₀
  rw [hc] at this
  -- no `rw` on the goal: its closing `rfl` would try to evaluate the net
  exact (le_of_eq hlen).trans (this.trans (le_of_eq (by unfold NLogN.KFAz.Lb; rfl)))

end IntMul.OpenAI.R154.P.NLogN.KFAz

