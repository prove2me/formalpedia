    (Cc (w + 2 * D)))
    (fcode (kersP K D S ρ P r MS ((List.finRange D).map Fin.val))))
    (fcode (kerP K D S ρ P r 0 (MD D))))
    (fcode (truncP (E + (D / 2 + D % 2)) (2 * (vol (Butterfly.layerShape P K D S) * r))))

