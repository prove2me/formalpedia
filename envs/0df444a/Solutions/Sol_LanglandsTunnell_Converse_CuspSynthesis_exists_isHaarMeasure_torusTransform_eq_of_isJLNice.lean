private theorem t0495 {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hμ : IsIdeleClassChar (𝓞 K) K μ)
    (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (R : SOrderReps K S) (g : AdelicGL2 (𝓞 K) K) (s : ℂ) :
    (∑' n : ↥S → ℤ, d.a (R.rep n) * d.epsChar g * ((d034 S).toReal : ℂ) *
