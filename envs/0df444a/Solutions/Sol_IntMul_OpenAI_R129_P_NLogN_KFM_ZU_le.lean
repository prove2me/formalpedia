  have h4 : 0 ≤ 325 * c * P := by positivity
  calc c * M * (A + 2) * z ≤ c * (65 * P) * (A + 2) * (5 * (A + 2)) := h1
    _ = 325 * c * P * (A + 2) ^ 2 := by ring
    _ ≤ 325 * c * P * (10 * (L + 1)) ^ 2 := mul_le_mul_of_nonneg_left h3 h4
    _ = 32500 * c * P * (L + 1) ^ 2 := by ring

