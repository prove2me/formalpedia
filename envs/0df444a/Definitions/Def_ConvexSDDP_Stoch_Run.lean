-- title:
--   Simulation, Update (21), (22), pp. 13–14, and footnote 6 — runs of the decomposition algorithm on the scenario tree
-- statement:
--   A **run** of the algorithm of pp. 13–14 for a selection path $(y^k_n)$ ($y^k_n=1$ iff the non-leaf node $n$ is selected at iteration $k$) consists of stocks $x^k_n$, controls $u^k_m$, cut values $\theta^k_n,\hat\theta^k_m$, slopes $\beta^k_n,\hat\beta^k_m$ and approximations $V^{k}_n$ of the future cost functions, such that, for every iteration $k\in\mathbb N$:
--
--   1. **Initialisation.** $V^{-1}_n\equiv-\infty$ at every non-leaf $n$, and $V^k_n=V_n$ at every leaf, for all $k$.
--   2. **Simulation.** $x^k_0=x_0$; for every $m\ne 0$, with $x=x^k_{p(m)}$, the control $u^k_m\in\tilde{\mathcal U}_m(x)$ minimises
--   $$u\mapsto C_m(x,u)+V^{k-1}_m\big(f_m(x,u)\big)\quad\text{over }\tilde{\mathcal U}_m(x),$$
--   and $x^k_m=f_m(x,u^k_m)$.
--   3. **Update (21).** For every child $m$ of a selected node $n$, $\hat\theta^k_m$ is the optimal value of (21), and $\hat\beta^k_m$ is a Lagrange multiplier of the constraint $x=x^k_n$: it lies in the direction space of $\operatorname{Aff}(\mathcal X_n)$ and for every $y\in\operatorname{Aff}(\mathcal X_n)$
--   $$\hat\theta^k_m+\langle\hat\beta^k_m,\,y-x^k_n\rangle\ \le\ \inf_{u\in\tilde{\mathcal U}_m(y)}\Big(C_m(y,u)+V^{k-1}_m\big(f_m(y,u)\big)\Big).$$
--   4. **Cut data.** At a selected node $n$, $\theta^k_n=\sum_{m\in r(n)}\frac{\Phi_m}{\Phi_n}\hat\theta^k_m$ and $\beta^k_n=\sum_{m\in r(n)}\frac{\Phi_m}{\Phi_n}\hat\beta^k_m$; at a non-selected non-leaf node, $\theta^k_n=V^{k-1}_n(x^k_n)$ and $\beta^k_n\in\partial V^{k-1}_n(x^k_n)$.
--   5. **Update (22).** At every non-leaf $n$,
--   $$V^k_n(y)=\max\Big(V^{k-1}_n(y),\ \theta^k_n+\langle\beta^k_n,\,y-x^k_n\rangle\Big).$$
--
--   Following footnote 6, p. 26, every choice (the minimiser $u^k_m$ among possibly several, the multiplier $\hat\beta^k_m$, the subgradient $\beta^k_n$) is made by a fixed rule: a deterministic function of the stage problem being solved (node, incoming stock, current approximation). With the rules fixed, the run is determined by the selection path.
--
--   **Formalization Note** Index shift: the Lean field `Vc k` is the paper's $V^{k-1}$, so `Vc 0` is $V^{-1}\equiv-\infty$ and the paper's $V^k_n$ is `Vc (k+1) n`; all other quantities keep the paper's index. A run is a predicate on the generated data, not a function. The Lagrange multiplier of (21b) is encoded by the subgradient inequality of the optimal value of (21) on $\operatorname{Aff}(\mathcal X_n)$ (p. 16, proof of Lemma 3.1 (ii)). Update (22) is stated on all of $\mathbb R^d$; the page's "$x\in\mathcal X_t$" only restricts where the approximation is used.
-- source:
--   Girardeau, Leclère & Philpott, On the Convergence of Decomposition Methods for Multistage Stochastic Convex Programs, author's version hal-01208295v1, pp. 13–14, Simulation, Update, (21), (22); p. 26, footnote 6

import Mathlib
import Definitions.Def_StochasticProg_Multistage_Tree
import Definitions.Def_ConvexSDDP_Det_Basic
import Definitions.Def_ConvexSDDP_Stoch_Tree
import Definitions.Def_ConvexSDDP_Stoch_Model

namespace ConvexSDDP.Stoch

open StochasticProg.Multistage

/-- Footnote 6, p. 26: the choices the algorithm makes are deterministic functions of the stage
problem being solved.
* `uRule m x V` is the control chosen at node `m` when the parent stock is `x` and the current
  approximation of `V_m` is `V`;
* `βhatRule m x V` is the Lagrange multiplier `β̂_m` returned for problem (21) at node `m`;
* `βsimRule n x V` is the subgradient `β_n ∈ ∂V(x)` imposed during the simulation at `n`. -/
structure Rules {H : ℕ} (T : Tree H) (d p : ℕ) where
  uRule : T.Node → EuclideanSpace ℝ (Fin d) → (EuclideanSpace ℝ (Fin d) → EReal) →
    EuclideanSpace ℝ (Fin p)
  βhatRule : T.Node → EuclideanSpace ℝ (Fin d) → (EuclideanSpace ℝ (Fin d) → EReal) →
    EuclideanSpace ℝ (Fin d)
  βsimRule : T.Node → EuclideanSpace ℝ (Fin d) → (EuclideanSpace ℝ (Fin d) → EReal) →
    EuclideanSpace ℝ (Fin d)

/-- The quantities generated by the algorithm of pp. 13–14, indexed by the iteration `k` and the
node `n`: stocks `x^k_n`, controls `u^k_n`, cut values `θ^k_n`, `θ̂^k_n`, cut slopes `β^k_n`,
`β̂^k_n`, and the approximations of the future cost functions.
**Index shift:** `Vc k n` is the paper's `V^{k-1}_n` (so `Vc 0 n` is the initial `V^{-1}_n ≡ -∞`
and the paper's `V^k_n` is `Vc (k + 1) n`); all other quantities keep the paper's index `k`. -/
structure RunData {H : ℕ} (T : Tree H) (d p : ℕ) where
  x : ℕ → T.Node → EuclideanSpace ℝ (Fin d)
  u : ℕ → T.Node → EuclideanSpace ℝ (Fin p)
  θ : ℕ → T.Node → EReal
  θhat : ℕ → T.Node → EReal
  β : ℕ → T.Node → EuclideanSpace ℝ (Fin d)
  βhat : ℕ → T.Node → EuclideanSpace ℝ (Fin d)
  Vc : ℕ → T.Node → EuclideanSpace ℝ (Fin d) → EReal

variable {H : ℕ} {T : Tree H} {d p : ℕ}

/-- `r` is a run of the algorithm of pp. 13–14 for the model `M`, the choice rules `R` and the
node selections `ys` (`ys k n = true` iff node `n` is selected at iteration `k`; only non-leaf
entries are read). With the index shift of `RunData` (`r.Vc k = V^{k-1}`):
* initialisation: `V^{-1}_n ≡ -∞` at every non-leaf `n`, and `V^k_n = V_n` at every leaf, for all `k`;
* Simulation: `x^k_root = x_0`, and for every `m ≠ root` with parent stock `x = x^k_{p(m)}`,
  `u^k_m` is the control chosen by the rule, it minimises `C_m(x, u) + V^{k-1}_m(f_m(x, u))` over
  `u ∈ 𝒰̃_m(x)`, and `x^k_m = f_m(x, u^k_m)`;
* Update (21): for every child `m` of a selected node, `θ̂^k_m` is the optimal value of (21), and
  `β̂^k_m` (chosen by the rule) is a Lagrange multiplier of the constraint `x = x^k_{p(m)}`: it
  lies in the direction space of `Aff(𝒳_{p(m)})` and
  `θ̂^k_m + ⟨β̂^k_m, y - x^k_{p(m)}⟩ ≤ inf_{u ∈ 𝒰̃_m(y)} C_m(y, u) + V^{k-1}_m(f_m(y, u))` for
  every `y ∈ Aff(𝒳_{p(m)})`;
* cut data at a non-leaf `n`: if `n` is selected, `θ^k_n = Σ (Φ_m/Φ_n) θ̂^k_m` and
  `β^k_n = Σ (Φ_m/Φ_n) β̂^k_m` over the children `m`; otherwise `θ^k_n = V^{k-1}_n(x^k_n)` and
  `β^k_n ∈ ∂V^{k-1}_n(x^k_n)` (chosen by the rule);
* update (22): `V^k_n(y) = max(V^{k-1}_n(y), θ^k_n + ⟨β^k_n, y - x^k_n⟩)` at every non-leaf `n`. -/
def IsTreeRun (M : Model T d p) (R : Rules T d p) (ys : ℕ → T.Node → Bool)
    (r : RunData T d p) : Prop :=
  (∀ n, ¬ IsLeaf T n → r.Vc 0 n = fun _ => ⊥) ∧
  (∀ k n, IsLeaf T n → r.Vc k n = M.V n) ∧
  (∀ k, r.x k T.root = M.x0) ∧
  (∀ k m, m ≠ T.root →
    r.u k m = R.uRule m (r.x k (T.anc m)) (r.Vc k m) ∧
    r.u k m ∈ M.Ut m (r.x k (T.anc m)) ∧
    (∀ v ∈ M.Ut m (r.x k (T.anc m)),
      M.C m (r.x k (T.anc m)) (r.u k m) + r.Vc k m (M.f m (r.x k (T.anc m), r.u k m)) ≤
        M.C m (r.x k (T.anc m)) v + r.Vc k m (M.f m (r.x k (T.anc m), v))) ∧
    r.x k m = M.f m (r.x k (T.anc m), r.u k m)) ∧
  (∀ k m, m ≠ T.root → ys k (T.anc m) = true →
    r.θhat k m = M.C m (r.x k (T.anc m)) (r.u k m) + r.Vc k m (r.x k m) ∧
    r.βhat k m = R.βhatRule m (r.x k (T.anc m)) (r.Vc k m) ∧
    r.βhat k m ∈ vectorSpan ℝ (M.X (T.anc m)) ∧
    ∀ y ∈ affineSpan ℝ (M.X (T.anc m)),
      r.θhat k m + ((inner ℝ (r.βhat k m) (y - r.x k (T.anc m)) : ℝ) : EReal) ≤
        ⨅ v ∈ M.Ut m y, (M.C m y v + r.Vc k m (M.f m (y, v)))) ∧
  (∀ k n, ¬ IsLeaf T n →
    (ys k n = true →
      r.θ k n = ∑ m ∈ T.children n, ((M.Φ m / M.Φ n : ℝ) : EReal) * r.θhat k m ∧
      r.β k n = ∑ m ∈ T.children n, (M.Φ m / M.Φ n) • r.βhat k m) ∧
    (ys k n = false →
      r.θ k n = r.Vc k n (r.x k n) ∧
      r.β k n = R.βsimRule n (r.x k n) (r.Vc k n) ∧
      ∀ y, r.θ k n + ((inner ℝ (r.β k n) (y - r.x k n) : ℝ) : EReal) ≤ r.Vc k n y)) ∧
  (∀ k n, ¬ IsLeaf T n →
    r.Vc (k + 1) n = fun y =>
      max (r.Vc k n y) (r.θ k n + ((inner ℝ (r.β k n) (y - r.x k n) : ℝ) : EReal)))

end ConvexSDDP.Stoch


