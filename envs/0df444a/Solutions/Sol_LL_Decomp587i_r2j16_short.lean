theorem high_range_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hlo : BuchstabArithmetic.top ≤ φ) :
    buchstabIntegral ω 2 (fun j => (r2j16_lo j : ℝ)) (fun j => (r2j16_hi j : ℝ)) φ ≤
      BuchstabArithmetic.target := by
  rw [buchstabIntegral_eq_D]
  have hp_ge2 : (2 : ℝ) ≤ BuchstabArithmetic.top := by norm_num [BuchstabArithmetic.top]
  have hint_ig : IntegrableOn (integrand4 ω φ) D_set volume := by
    apply ContinuousOn.integrableOn_compact isCompact_D
    unfold integrand4
    have hu_cont : ContinuousOn (fun x : R4 => (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1) D_set :=
      (continuous_const.sub (((c_x0.add c_x1).add c_x2).add c_x3)).continuousOn.div
        c_x2.continuousOn
        (fun x hx => ne_of_gt (lt_of_lt_of_le ha0_pos (D_subset_B hx).2.2.1.1))
    have hu_maps : MapsTo (fun x : R4 => (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1) D_set (Ici 1) := by
      intro x hx
      rcases D_subset_B hx with ⟨h0, h1, h2, h3⟩
      have hx2_pos : 0 < x.2.2.1 := lt_of_lt_of_le ha0_pos h2.1
      rw [mem_Ici, one_le_div hx2_pos]
      rw [BuchstabArithmetic.top_eq] at hlo
      linarith [h0.2, h1.2, h2.2, h3.2]
    exact (hω.1.comp hu_cont hu_maps).div
      ((((c_x0.mul c_x1).mul c_x2).mul c_x2).mul c_x3).continuousOn
      (fun x hx => by
        change x.1 * x.2.1 * x.2.2.1 * x.2.2.1 * x.2.2.2 ≠ 0
        rcases D_subset_B hx with ⟨h0, h1, h2, h3⟩
        have q0 := lt_of_lt_of_le ha0_pos h0.1; have q1 := lt_of_lt_of_le ha0_pos h1.1
        have q2 := lt_of_lt_of_le ha0_pos h2.1; have q3 := lt_of_lt_of_le ha0_pos h3.1
        positivity)
  have hf_top_int : IntegrableOn (f_smooth BuchstabArithmetic.top) D_set volume :=
    ((f_smooth_cont hp_ge2).mono D_subset_B).integrableOn_compact isCompact_D
  have hp4_int : IntegrableOn prod_inv4 D_set volume :=
    (prod_inv4_cont.mono D_subset_B).integrableOn_compact isCompact_D
  have hM_int : IntegrableOn M_hi_fn D_set volume :=
    (hf_top_int.const_mul (5 / 6)).add ((hp4_int.const_mul (1 / a0)).const_mul (1 / 6))
  have hpt : ∀ x ∈ D_set, integrand4 ω φ x ≤ M_hi_fn x := by
    intro x hx
    rcases D_subset_B hx with ⟨h0, h1, h2, h3⟩
    have q0 : 0 < x.1 := lt_of_lt_of_le ha0_pos h0.1
    have q1 : 0 < x.2.1 := lt_of_lt_of_le ha0_pos h1.1
    have q2 : 0 < x.2.2.1 := lt_of_lt_of_le ha0_pos h2.1
    have q3 : 0 < x.2.2.2 := lt_of_lt_of_le ha0_pos h3.1
    set S := x.1 + x.2.1 + x.2.2.1 + x.2.2.2
    set u0 := (BuchstabArithmetic.top - S) / x.2.2.1
    set u := (φ - S) / x.2.2.1
    have hu0_ge1 : 1 ≤ u0 := by
      dsimp [u0]; rw [one_le_div q2, BuchstabArithmetic.top_eq]
      dsimp [S]; linarith [h0.2, h1.2, h2.2, h3.2]
    have hu0_le2 : u0 ≤ 2 := by
      dsimp [u0]; rw [div_le_iff₀ q2]
      dsimp [S]; norm_num [BuchstabArithmetic.top, a0, BuchstabArithmetic.a] at h0 h1 h2 h3 ⊢
      linarith [h0.1, h1.1, h2.1, h3.1]
    have hu_ge : u0 ≤ u := div_le_div_of_nonneg_right (by linarith) (le_of_lt q2)
