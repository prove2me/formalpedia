    TV (2 ^ (f * K)) (ofP x p) := by
  refine ⟨hx, ?_, ?_⟩
  · have e := Int.toNat_of_nonneg hp.1
    have : ((p.1.toNat : ℕ) : ℤ) < 2 ^ (f * K) := by rw [e]; exact hp.2.1
    simp only [ofP]; exact_mod_cast this
  · have e := Int.toNat_of_nonneg hp.2.2.1
    have : ((p.2.toNat : ℕ) : ℤ) < 2 ^ (f * K) := by rw [e]; exact hp.2.2.2
    simp only [ofP]; exact_mod_cast this

