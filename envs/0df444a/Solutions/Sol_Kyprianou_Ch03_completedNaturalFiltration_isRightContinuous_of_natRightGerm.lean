open MeasureTheory ProbabilityTheory
open scoped NNReal
set_option autoImplicit false

namespace CompletedRightContAux

variable {Omega : Type} {m : MeasurableSpace Omega}

/-- the σ-algebra generated by subsets of measurable null sets -/
def nullSig (P : @Measure Omega m) : MeasurableSpace Omega :=
  MeasurableSpace.generateFrom
    {A : Set Omega | ∃ N : Set Omega, MeasurableSet[m] N ∧ P N = 0 ∧ A ⊆ N}

/-- sets that differ from a `G`-set by a subset of a measurable null set -/
def approxSig (P : @Measure Omega m) (G : MeasurableSpace Omega) : MeasurableSpace Omega where
  MeasurableSet' A := ∃ B, MeasurableSet[G] B ∧ ∃ M : Set Omega, MeasurableSet[m] M ∧ P M = 0 ∧
    symmDiff A B ⊆ M
  measurableSet_empty := ⟨∅, @MeasurableSet.empty _ G, ∅, @MeasurableSet.empty _ m, measure_empty,
    by simp⟩
  measurableSet_compl A := by
    rintro ⟨B, hB, M, hM, hM0, hAB⟩
    exact ⟨Bᶜ, hB.compl, M, hM, hM0, by rwa [compl_symmDiff_compl]⟩
  measurableSet_iUnion A := by
    intro h
    choose B hB M hM hM0 hAB using h
    refine ⟨⋃ i, B i, MeasurableSet.iUnion hB, ⋃ i, M i, @MeasurableSet.iUnion _ _ m _ _ hM,
      measure_iUnion_null hM0, ?_⟩
    intro x hx
    simp only [Set.mem_symmDiff, Set.mem_iUnion] at hx
    simp only [Set.mem_iUnion]
    rcases hx with ⟨⟨i, hi⟩, hn⟩ | ⟨⟨i, hi⟩, hn⟩
    · push_neg at hn
      exact ⟨i, hAB i (Or.inl ⟨hi, hn i⟩)⟩
    · push_neg at hn
      exact ⟨i, hAB i (Or.inr ⟨hi, hn i⟩)⟩

theorem le_approxSig (P : @Measure Omega m) (G : MeasurableSpace Omega) :
    G ⊔ nullSig P ≤ approxSig P G := by
  refine sup_le ?_ ?_
  · intro A hA
    exact ⟨A, hA, ∅, @MeasurableSet.empty _ m, measure_empty, by simp⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro A ⟨N, hN, hN0, hAN⟩
    refine ⟨∅, @MeasurableSet.empty _ G, N, hN, hN0, ?_⟩
    intro x hx
    rcases hx with ⟨hxA, _⟩ | ⟨hx0, _⟩
    · exact hAN hxA
    · exact absurd hx0 (Set.notMem_empty x)

theorem mem_of_symmDiff_null (P : @Measure Omega m) (G : MeasurableSpace Omega)
    {A B M : Set Omega} (hB : MeasurableSet[G ⊔ nullSig P] B) (hM : MeasurableSet[m] M)
    (hM0 : P M = 0) (hAB : symmDiff A B ⊆ M) : MeasurableSet[G ⊔ nullSig P] A := by
  have hMN : MeasurableSet[G ⊔ nullSig P] M :=
    (le_sup_right : nullSig P ≤ G ⊔ nullSig P) M
      (MeasurableSpace.measurableSet_generateFrom ⟨M, hM, hM0, subset_rfl⟩)
  have hAM : MeasurableSet[G ⊔ nullSig P] (A ∩ M) :=
    (le_sup_right : nullSig P ≤ G ⊔ nullSig P) _
      (MeasurableSpace.measurableSet_generateFrom ⟨M, hM, hM0, Set.inter_subset_right⟩)
  have hEq : A = (B \ M) ∪ (A ∩ M) := by
    ext x
    constructor
    · intro hx
      by_cases hxM : x ∈ M
      · exact Or.inr ⟨hx, hxM⟩
      · refine Or.inl ⟨?_, hxM⟩
        by_contra hxB
        exact hxM (hAB (Or.inl ⟨hx, hxB⟩))
    · rintro (⟨hxB, hxM⟩ | ⟨hx, _⟩)
      · by_contra hxA
        exact hxM (hAB (Or.inr ⟨hxB, hxA⟩))
      · exact hx
  rw [hEq]
  exact (hB.diff hMN).union hAM

end CompletedRightContAux

open CompletedRightContAux in
theorem solution
    {Omega : Type} [MeasurableSpace Omega]
    (P : Measure Omega) [IsProbabilityMeasure P]
    (X : NNReal -> Omega -> Real)
    (F : Filtration NNReal (inferInstance : MeasurableSpace Omega))
    (hCompleted : Kyprianou.Ch03.IsCompletedNaturalFiltration P X F)
    (hGerm : forall t : NNReal,
      (⨅ s : NNReal, ⨅ (_ : t < s), PerfCorrMSQ.natFiltr X s) ≤
        PerfCorrMSQ.natFiltr X t ⊔
          MeasurableSpace.generateFrom
            {A : Set Omega |
              exists N : Set Omega,
                MeasurableSet N ∧ P N = 0 ∧ A ⊆ N}) :
    F.IsRightContinuous := by
  set G : NNReal → MeasurableSpace Omega := fun s => PerfCorrMSQ.natFiltr X s with hGdef
  have hGmono : ∀ a b : NNReal, a ≤ b → G a ≤ G b := by
    intro a b hab
    simp only [hGdef, PerfCorrMSQ.natFiltr]
    exact iSup₂_le fun u hu =>
      le_iSup₂ (f := fun u (_ : u ≤ b) => MeasurableSpace.comap (X u) inferInstance) u
        (hu.trans hab)
  have hF : ∀ t, F t = G t ⊔ nullSig P := hCompleted
  refine ⟨fun t => ?_⟩
  rw [Filtration.rightCont_eq_of_neBot_nhdsGT]
  intro A hA
  rw [hF t]
  -- approximate `A` at times `t + 1/(n+1)`
  let s : ℕ → NNReal := fun n => t + 1 / ((n : NNReal) + 1)
  have hts : ∀ n, t < s n := fun n => by
    simp only [s]
    exact lt_add_of_pos_right _ (by positivity)
  have hAn : ∀ n, MeasurableSet[approxSig P (G (s n))] A := by
    intro n
    have h1 : MeasurableSet[F (s n)] A := by
      have := (MeasurableSpace.measurableSet_iInf.mp hA) (s n)
      exact MeasurableSpace.measurableSet_iInf.mp this (hts n)
    rw [hF] at h1
    exact le_approxSig P _ A h1
  choose B hB M hM hM0 hAB using hAn
  -- the limsup set
  let C : ℕ → Set Omega := fun k => ⋃ n, ⋃ (_ : k ≤ n), B n
  have hCanti : Antitone C := by
    intro k l hkl x hx
    simp only [C, Set.mem_iUnion] at hx ⊢
    obtain ⟨n, hn, hx⟩ := hx
    exact ⟨n, hkl.trans hn, hx⟩
  let L : Set Omega := ⋂ k, C k
  have hLgerm : MeasurableSet[⨅ j, ⨅ (_ : t < j), G j] L := by
    refine MeasurableSpace.measurableSet_iInf.mpr fun j => ?_
    refine MeasurableSpace.measurableSet_iInf.mpr fun htj => ?_
    obtain ⟨k0, hk0⟩ := exists_nat_one_div_lt (tsub_pos_of_lt htj)
    have hsj : ∀ n, k0 ≤ n → s n ≤ j := by
      intro n hn
      have h1 : 1 / ((n : NNReal) + 1) ≤ 1 / ((k0 : NNReal) + 1) := by
        gcongr
      have h2 : t + 1 / ((k0 : NNReal) + 1) ≤ j := by
        have := (lt_tsub_iff_left).mp hk0
        exact this.le
      exact le_trans (by simp only [s]; gcongr) h2
    have hL : L = ⋂ k, C (k + k0) := by
      ext x
      simp only [L, Set.mem_iInter]
      exact ⟨fun h k => h _, fun h k => hCanti (Nat.le_add_right k k0) (h k)⟩
    rw [hL]
    refine MeasurableSet.iInter fun k => ?_
    refine MeasurableSet.iUnion fun n => MeasurableSet.iUnion fun hn => ?_
    exact hGmono _ _ (hsj n (le_trans (Nat.le_add_left k0 k) hn)) _ (hB n)
  have hLt : MeasurableSet[G t ⊔ nullSig P] L := hGerm t L hLgerm
  refine mem_of_symmDiff_null P (G t) hLt (MeasurableSet.iUnion hM)
    (measure_iUnion_null hM0) ?_
  intro x hx
  simp only [Set.mem_iUnion]
  rcases hx with ⟨hxA, hxL⟩ | ⟨hxL, hxA⟩
  · simp only [L, Set.mem_iInter, not_forall] at hxL
    obtain ⟨k, hk⟩ := hxL
    have hxB : x ∉ B k := fun h => hk (Set.mem_iUnion₂.mpr ⟨k, le_rfl, h⟩)
    exact ⟨k, hAB k (Or.inl ⟨hxA, hxB⟩)⟩
  · have := Set.mem_iInter.mp hxL 0
    obtain ⟨n, _, hxn⟩ := Set.mem_iUnion₂.mp this
    exact ⟨n, hAB n (Or.inr ⟨hxn, hxA⟩)⟩
