variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution {X Y : Fin NLogN.NS} (hXY : X ≠ Y) (hXC : X ≠ NLogN.CC) (hYC : Y ≠ NLogN.CC) (hX3 : X ≠ NLogN.T3)
    (hY3 : Y ≠ NLogN.T3) (hXH : X ≠ NLogN.HH) (hYH : Y ≠ NLogN.HH) (s : NLogN.IState NLogN.NS) (A : List ℤ) (R LH : List NLogN.Item)
    (m : ℕ) (hX : s.G X = NLogN.ints A ++ R) (hH : s.G NLogN.HH = .int A.length :: LH) (hA : NLogN.Bnd m A) :
    NLogN.IRuns I iprog (NLogN.mvH X Y) s ((s.upd X R).upd Y ((NLogN.ints A).reverse ++ s.G Y))
      (A.length * (1000 * (m + NLogN.zsz (A.length : ℤ) + 3)) + 300 * (NLogN.zsz (A.length : ℤ) + 1) + 40) := by
  have h1 : NLogN.IRuns I iprog (.op (.dup NLogN.HH NLogN.CC)) s (s.upd NLogN.CC (.int A.length :: s.G NLogN.CC))
      (300 * (NLogN.zsz (A.length : ℤ) + 1)) := by
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, hH]
    have := NLogN.dupCost_le (NLogN.zsz (A.length : ℤ)); omega
  have h2 := NLogN.mvN_runs (I := I) (iprog := iprog) hXY hXC hYC hX3 hY3 (by decide)
    (s.upd NLogN.CC (.int A.length :: s.G NLogN.CC)) A R (s.G NLogN.CC) m (by simp [hXC, hX]) (by simp) hA
  have h3 : NLogN.IRuns I iprog (.op (.drop NLogN.CC))
      ((((s.upd NLogN.CC (.int A.length :: s.G NLogN.CC)).upd X R).upd Y
        ((NLogN.ints A).reverse ++ (s.upd NLogN.CC (.int A.length :: s.G NLogN.CC)).G Y)).upd NLogN.CC (.int 0 :: s.G NLogN.CC))
      ((s.upd X R).upd Y ((NLogN.ints A).reverse ++ s.G Y)) 2 := by
    apply NLogN.IRuns.of_runsTo 0
    simp +decide [NLogN.IStmt.run, NLogN.IOp.run, NLogN.zsz_zero]
    apply NLogN.IState.ext' <;> intros <;> simp [hYC] <;> split_ifs <;> simp_all
  exact (NLogN.IRuns.seq h1 (NLogN.IRuns.seq h2 h3)).mono (by omega)
