-- title:
--   Interior coefficients vanish in a coordinate power ideal
-- statement:
--   A polynomial in the ideal generated by coordinate powers has zero coefficient at every exponent strictly below all the corresponding power bounds.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_PolynomialLogarithmicJets

open OAI.PiExponent.LogarithmicJetIdeals

theorem OAI.PiExponent.LogarithmicJetIdeals.coeff_eq_zero_of_mem_coordinatePowerIdeal
    {n : ℕ} (b : Fin n → ℕ) (Q : MvPolynomial (Fin n) ℂ)
    (hQ : Q ∈ Ideal.span (Set.range (fun i : Fin n => MvPolynomial.X i ^ b i) : Set (MvPolynomial (Fin n) ℂ)))
    (u : Fin n →₀ ℕ) (hu : ∀ i, u i < b i) :
    MvPolynomial.coeff u Q = 0 := by sorry
