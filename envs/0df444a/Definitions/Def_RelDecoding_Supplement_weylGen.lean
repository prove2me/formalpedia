-- title:
--   Weyl operators $W_m(x,z)$, field-symbol generators $a_i(\xi)$, words $W(c)$ and the form $\Omega_m$
-- statement:
--   Let $p$ be an odd prime, $\omega=e^{2\pi i/p}$, and on $\mathbb C^p$ let $X_p|r\rangle=|r+1\bmod p\rangle$, $Z_p|r\rangle=\omega^r|r\rangle$ (eq. (225)).
--
--   1. For $(x,z)\in\mathbb F_p^m\times\mathbb F_p^m$ the **Weyl operator** on $(\mathbb C^p)^{\otimes m}$ is
--   $$W_m(x,z)=\omega^{x\cdot z/2}\bigotimes_{j=1}^m X_p^{x_j}Z_p^{z_j},$$
--   all exponents in $\mathbb F_p$, so $/2$ is multiplication by $2^{-1}\in\mathbb F_p$ (eq. (226)).
--   2. For directions $w_i\in\mathbb F_p^{2m}$ and phases $r_i\in\mathbb F_p$ the **field-symbol generators** are $a_i(\xi)=\omega^{\xi r_i}W_m(\xi w_i)$, $\xi\in\mathbb F_p$ (eq. (248)); the algebra is $\mathcal A=C^*(I,a_i(\xi):i\in[s],\xi\in\mathbb F_p)$ (eq. (253)).
--   3. The **reduced ordered word** of $c\in\mathbb F_p^s$ is $W(c)=a_1(c_1)\cdots a_s(c_s)$ (eq. (255)).
--   4. The **symplectic form** is $\Omega_m=\begin{pmatrix}0&-I_m\\ I_m&0\end{pmatrix}$ over $\mathbb F_p$ (eq. (258)).
--
--   These are the qudit (and truncated bosonic) instance of relative decoding (§6.2.2).
--
--   **Formalization Note** The basis of $(\mathbb C^p)^{\otimes m}$ is `Fin m → ZMod p`; $\omega^k$ for $k\in\mathbb F_p$ is $\omega^{k.\mathrm{val}}$. The entry of $W_m(x,z)$ in row $r'$, column $r$ is $\omega^{x\cdot z\,2^{-1}+z\cdot r}$ if $r'=r+x$, else $0$. The generated algebra of an arbitrarily indexed family is `familyAlg`, with generators `familyGen`.
-- source:
--   Shang, Stilck França, From Simple Sources to Quantum Advantage: Homomorphic Polynomial Transduction via Relative Decoding, arXiv:2609.35101 (held version, sha256 d2be7859…), eqs. (225)–(226), p.43; eqs. (248), (253), (255), p.46; eq. (258), p.47 (pdf_pages 43, 46–47)

import Mathlib

set_option autoImplicit false

namespace RelDecoding.Supplement

/-- `ω^k = e^{2πik/p}` for an exponent `k ∈ F_p`, evaluated through the representative
`k ∈ {0, …, p − 1}` (well defined since `ω^p = 1`). Shang, Stilck França, *From Simple Sources to
Quantum Advantage: Homomorphic Polynomial Transduction via Relative Decoding*, arXiv:2609.35101
(held version, sha256 d2be7859…), eqs. (225)–(226), p.43. -/
noncomputable def omegaPow (p : ℕ) (k : ZMod p) : ℂ :=
  Complex.exp (2 * Real.pi * Complex.I / p) ^ k.val

/-- The **Weyl operator** `W_m(x, z) := ω^{x·z/2} ⊗_{j=1}^m X_p^{x_j} Z_p^{z_j}` on `(ℂ^p)^{⊗m}`, where
`X_p|r⟩ = |r + 1 mod p⟩`, `Z_p|r⟩ = ω^r|r⟩`, `ω = e^{2πi/p}`, and all exponents are in `F_p` (so
`/2` is multiplication by `2⁻¹ ∈ F_p`). Eqs. (225)–(226), p.43 (and eq. (493), p.89).

**Formalization Note.** The computational basis is `Fin m → ZMod p` (site `j` is coordinate `j`,
the `j`-th tensor factor). Since `X^x Z^z |r⟩ = ω^{z·r} |r + x⟩`, the entry in row `r'`, column `r`
is `ω^{x·z·2⁻¹ + z·r}` if `r' = r + x` and `0` otherwise. A label is a pair `(x, z)`, X-part first. -/
noncomputable def weylOp {m p : ℕ} (u : (Fin m → ZMod p) × (Fin m → ZMod p)) :
    Matrix (Fin m → ZMod p) (Fin m → ZMod p) ℂ :=
  Matrix.of fun r' r =>
    if r' = r + u.1 then omegaPow p (dotProduct u.1 u.2 * (2 : ZMod p)⁻¹ + dotProduct u.2 r)
    else 0

/-- The **field-symbol generators** `aᵢ(ξ) := ω^{ξ rᵢ} W_m(ξ wᵢ)`, indexed by `(i, ξ) ∈ [s] × F_p`,
for Weyl directions `wᵢ ∈ F_p^{2m}` and phases `rᵢ ∈ F_p`. Eq. (248), p.46 (and eq. (497), p.89). -/
noncomputable def weylGen {m p s : ℕ} (r : Fin s → ZMod p)
    (w : Fin s → (Fin m → ZMod p) × (Fin m → ZMod p)) :
    Fin s × ZMod p → Matrix (Fin m → ZMod p) (Fin m → ZMod p) ℂ :=
  fun q => omegaPow p (q.2 * r q.1) • weylOp (q.2 • w q.1)

/-- The unital ∗-subalgebra `C∗(I, a_q : q ∈ ι)` of `Matrix N N ℂ` generated by an arbitrarily
indexed family; for the Weyl generators `ι = [s] × F_p`, eq. (253), p.46.

**Formalization Note.** In finite dimension the generated ∗-subalgebra is norm closed, hence the
generated C∗-algebra (App. E, proof of Lemma E.1, p.85). -/
abbrev familyAlg {N ι : Type*} [Fintype N] [DecidableEq N] (a : ι → Matrix N N ℂ) :
    StarSubalgebra ℂ (Matrix N N ℂ) :=
  StarAlgebra.adjoin ℂ (Set.range a)

/-- The generator `a_q` as an element of `familyAlg a`. -/
def familyGen {N ι : Type*} [Fintype N] [DecidableEq N] (a : ι → Matrix N N ℂ) (q : ι) :
    familyAlg a :=
  ⟨a q, StarAlgebra.subset_adjoin ℂ _ (Set.mem_range_self q)⟩

/-- The **reduced ordered field-symbol word** `W(c) := a₁(c₁) ⋯ a_s(c_s)` for `c ∈ F_p^s`, factors in
increasing index order. Eq. (255), p.46 (and eq. (501), p.89). -/
def symbolWord {N : Type*} [Fintype N] [DecidableEq N] {p s : ℕ}
    (a : Fin s × ZMod p → Matrix N N ℂ) (c : Fin s → ZMod p) : Matrix N N ℂ :=
  (List.ofFn fun i => a (i, c i)).prod

/-- The **symplectic form** `Ω_m = [[0, −I_m], [I_m, 0]]` over `F_p`, in the `(x, z)` block order.
Eq. (258), p.47 (and eq. (494), p.89). -/
def omegaForm (m p : ℕ) : Matrix (Fin m ⊕ Fin m) (Fin m ⊕ Fin m) (ZMod p) :=
  Matrix.fromBlocks 0 (-1) 1 0

end RelDecoding.Supplement


