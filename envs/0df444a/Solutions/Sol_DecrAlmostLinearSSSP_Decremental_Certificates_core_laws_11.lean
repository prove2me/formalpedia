lemma debt_deletion (b : Core) (s : State b) (e : Fin b.input.k) (calls reports offset : ℕ)
    (h : OperationDebt b s calls reports offset) (hp : s.pending = []) :
    OperationDebt b (deleteState b s e) (calls+5) reports (offset+6) := by
  have hbit : stoppedBit s ≤ 1 := by unfold stoppedBit;split <;> omega
  have hnewbit : stoppedBit (deleteState b s e) = 0 := rfl
  have hT : (deleteState b s e).toggles = s.toggles := rfl
  have hp' : (deleteState b s e).pending = [] := by
    change (s.pending.filter (fun d => d ≠ .inl e)) = []
    rw [hp]
    rfl
  unfold OperationDebt at h ⊢
  rw [hnewbit,hT,hp',List.length_nil,Nat.mul_zero,Nat.add_zero]
  rw [hp,List.length_nil,Nat.mul_zero,Nat.add_zero] at h
  omega
