theorem existsUnique_algHom_iff {B C T : Type} [CommRing B] [CommRing C] [CommRing T] [Algebra B C]
    (f : B →+* T) (P : (C →+* T) → Prop) :
    (letI : Algebra B T := f.toAlgebra; ∃! ψ : C →ₐ[B] T, P ψ.toRingHom) ↔
      ∃! ψ : C →+* T, ψ.comp (algebraMap B C) = f ∧ P ψ := by
  letI : Algebra B T := f.toAlgebra
  constructor
  · rintro ⟨ψ, hψ, huniq⟩
    refine ⟨ψ.toRingHom, ⟨?_, hψ⟩, ?_⟩
    · ext b
      show ψ (algebraMap B C b) = f b
      rw [ψ.commutes]
      rfl
    · rintro ψ' ⟨hψ'f, hψ'P⟩
      have h := huniq { toRingHom := ψ', commutes' := fun b => RingHom.congr_fun hψ'f b } hψ'P
      exact congrArg AlgHom.toRingHom h
  · rintro ⟨ψ, ⟨hψf, hψP⟩, huniq⟩
    refine ⟨{ toRingHom := ψ, commutes' := fun b => RingHom.congr_fun hψf b }, hψP, ?_⟩
    rintro ψ' hψ'
    apply AlgHom.ext
    intro c
    have h := huniq ψ'.toRingHom ⟨RingHom.ext fun b => ψ'.commutes b, hψ'⟩
    exact RingHom.congr_fun h c

theorem fst_map_smul {K : Type} [Field K] (c : K) (x : DualNumber K) :
    (TrivSqZeroExt.map (c • (LinearMap.id : K →ₗ[K] K)) x).fst = x.fst :=
  TrivSqZeroExt.fst_map _ _

theorem snd_map_smul {K : Type} [Field K] (c : K) (x : DualNumber K) :
    (TrivSqZeroExt.map (c • (LinearMap.id : K →ₗ[K] K)) x).snd = c * x.snd := by
  rw [TrivSqZeroExt.snd_map]; simp

theorem map_smul_comp_algebraMap {K : Type} [Field K] (c : K) :
    (TrivSqZeroExt.map (c • (LinearMap.id : K →ₗ[K] K))).toRingHom.comp (algebraMap K (DualNumber K)) =
      algebraMap K (DualNumber K) := by
  ext a <;> simp [TrivSqZeroExt.algebraMap_eq_inl']

theorem fstHom_comp_algebraMap (K : Type) [Field K] :
    (TrivSqZeroExt.fstHom K K K).toRingHom.comp (algebraMap K (DualNumber K)) = RingHom.id K := by
  ext a
