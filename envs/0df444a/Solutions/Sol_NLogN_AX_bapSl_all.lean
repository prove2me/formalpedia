open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp
theorem solution (M : NLogN.MulSpec) (p s t α kb Bi Bo mm Φ Bacc Q : ℕ) (hM : NLogN.MulBnd M mm Φ)
    (H : NLogN.AX.BapHyp p s t α kb Bi Bo mm Bacc Q) (st : NLogN.IState NLogN.HS) (x : List (ℤ × ℤ)) (R : List NLogN.Item)
    (hC : NLogN.AX.CtxB p s t α kb st) (hx : x.length = t ∧ NLogN.GL.GB Bi x) (hI : st.G NLogN.AX.bI = NLogN.gints x ++ R) :
    NLogN.AX.bapSlP.run st = (st.upd NLogN.AX.bI R).upd NLogN.AX.bO (NLogN.gints (bapL p s t α x) ++ st.G NLogN.AX.bO) ∧
      NLogN.AX.bapSlP.ok M st ∧ NLogN.AX.bapSlP.cost M st ≤ NLogN.AX.bapSlC p s t α kb mm Φ Bacc Q := by
  have r1 := NLogN.AX.bapR_run p s t α kb st x R H.hs H.hst H.hco H.hkb hx.1 hC hI
  obtain ⟨o1, c1⟩ := NLogN.AX.bapR_okc M mm Φ Bacc hM p s t α kb Bi Bo Q H st x R hx.1 hx.2 hC hI
  obtain ⟨LS, hLS⟩ := hC.ps
  set st1 := st.upd NLogN.AX.bI (NLogN.gints (bapL p s t α x) ++ R) with hst1
  have hyB : NLogN.GL.GB Q (bapL p s t α x) := (NLogN.AX.bapL_GB p s t α Bi Bo H.hc x hx.2).mono H.hBo
  obtain ⟨r2, o2, c2⟩ := NLogN.GL.xferG M NLogN.AX.bI NLogN.AX.bO NLogN.AX.bS st1 (bapL p s t α x) R LS Q s (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by simp [hst1]) (NLogN.BD.bapL_length p s t α x)
    (by simp (config := {decide := true}) [hst1, hLS]) H.hsQ hyB
  refine ⟨?_, ⟨o1, ?_⟩, ?_⟩
  · show (NLogN.GL.xferP NLogN.AX.bI NLogN.AX.bO (NLogN.GL.cnt2 NLogN.AX.bS)).run ((NLogN.RM.ren NLogN.AX.σP NLogN.Rsp.bapP).run st) = _
    rw [r1, r2]
    apply NLogN.IState.ext' _ (by simp [hst1]) (by simp [hst1])
    intro j
    by_cases j1 : j = NLogN.AX.bO
    · subst j1; simp (config := {decide := true}) [hst1]
    by_cases j2 : j = NLogN.AX.bI
    · subst j2; simp (config := {decide := true}) [hst1]
    simp [hst1, j1, j2]
  · rw [r1]; exact o2
  · show (NLogN.RM.ren NLogN.AX.σP NLogN.Rsp.bapP).cost M st + (NLogN.GL.xferP NLogN.AX.bI NLogN.AX.bO (NLogN.GL.cnt2 NLogN.AX.bS)).cost M ((NLogN.RM.ren NLogN.AX.σP NLogN.Rsp.bapP).run st) ≤ _
    rw [r1]; unfold NLogN.AX.bapSlC; omega
end
