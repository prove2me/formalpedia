-- Source module: Solutions.J6QLUBasic
/-!
# q-Pochhammer symbols and Gaussian binomials (algebraic core of the segmented-inverse q-LU)

Over an arbitrary field `K`:
* `qpoch q n = (q;q)_n = ∏_{i<n} (1 - q^(i+1))`,
* `qbin q n k` = Gaussian binomial `[n k]_q`, defined by the q-Pascal recurrence
  `[n+1, k+1] = [n, k] + q^(k+1) [n, k+1]`,
* `qbin_mul_qpoch` : `[n k] (q;q)_k (q;q)_{n-k} = (q;q)_n`,
* `qbin_rothe` (q-binomial theorem / Rothe):
  `∑_{j ≤ h} (-1)^j q^(j choose 2) [h j] y^j = ∏_{i<h} (1 - y q^i)`,
* `qbin_alt_sum` : `∑_{j ≤ h} (-1)^j q^(j choose 2) [h j] = δ_{h0}`,
* `qpascal_identity` (q-Newton type identity behind the LU factor):
  `∑_{k ≤ u} [u k] (q^(v-k+1);q)_k q^((u-k)(v-k)) = 1`.
-/

open Finset

namespace J6QLU

variable {K : Type*} [Field K]

lemma qpoch_succ (q : K) (n : ℕ) : qpoch q (n + 1) = qpoch q n * (1 - q ^ (n + 1)) := by
  simp [qpoch, prod_range_succ]

lemma qbin_succ_succ (q : K) (n k : ℕ) :
    qbin q (n + 1) (k + 1) = qbin q n k + q ^ (k + 1) * qbin q n (k + 1) := by simp [qbin]

lemma qbin_eq_zero_of_lt (q : K) : ∀ {n k : ℕ}, n < k → qbin q n k = 0
  | 0, k + 1, _ => by simp
  | n + 1, k + 1, h => by
    rw [qbin_succ_succ, qbin_eq_zero_of_lt q (by omega : n < k),
      qbin_eq_zero_of_lt q (by omega : n < k + 1)]
    ring

lemma qbin_mul_qpoch (q : K) : ∀ (n k : ℕ), k ≤ n →
    qbin q n k * qpoch q k * qpoch q (n - k) = qpoch q n
  | n, 0, _ => by simp
  | 0, k + 1, h => by omega
  | n + 1, k + 1, h => by
    rw [qbin_succ_succ]
    have h1 := qbin_mul_qpoch q n k (by omega)
    rcases Nat.lt_or_ge k n with hk | hk
    · have h2 := qbin_mul_qpoch q n (k + 1) hk
      have e1 : n + 1 - (k + 1) = n - k := by omega
      have e2 : n - k = (n - (k + 1)) + 1 := by omega
      have e3 : n - (k + 1) + 1 = n - k := by omega
      have hs := qpoch_succ q (n - (k + 1))
      rw [e3] at hs
      rw [e1, qpoch_succ q k, hs, qpoch_succ q n]
      rw [hs] at h1
      have e4 : q ^ (k + 1) * q ^ (n - k) = q ^ (n + 1) := by
        rw [← pow_add]; congr 1; omega
      calc (qbin q n k + q ^ (k + 1) * qbin q n (k + 1)) * (qpoch q k * (1 - q ^ (k + 1))) *
            (qpoch q (n - (k + 1)) * (1 - q ^ (n - k)))
          = (qbin q n k * qpoch q k * (qpoch q (n - (k + 1)) * (1 - q ^ (n - k)))) *
              (1 - q ^ (k + 1)) +
            q ^ (k + 1) * (qbin q n (k + 1) * (qpoch q k * (1 - q ^ (k + 1))) *
              qpoch q (n - (k + 1))) * (1 - q ^ (n - k)) := by ring
        _ = qpoch q n * (1 - q ^ (k + 1)) + q ^ (k + 1) * qpoch q n * (1 - q ^ (n - k)) := by
            rw [h1, ← qpoch_succ, h2]
        _ = qpoch q n * (1 - q ^ (n + 1)) := by rw [← e4]; ring
    · have hkn : k = n := by omega
      subst hkn
      rw [qbin_eq_zero_of_lt q (by omega : k < k + 1)]
      simp only [Nat.sub_self, qpoch_zero, mul_one] at h1
      simp only [Nat.sub_self, qpoch_zero, mul_one, qpoch_succ, mul_zero, add_zero]
      rw [← mul_assoc, h1]

/-- q-binomial theorem (Rothe). -/
lemma qbin_rothe (q : K) : ∀ (h : ℕ) (y : K),
    ∑ j ∈ range (h + 1), (-1) ^ j * q ^ (j.choose 2) * qbin q h j * y ^ j =
      ∏ i ∈ range h, (1 - y * q ^ i)
  | 0, y => by simp
  | h + 1, y => by
    have ih := qbin_rothe q h (q * y)
    set R := ∑ j ∈ range (h + 1), (-1) ^ j * q ^ (j.choose 2) * qbin q h j * (q * y) ^ j
    -- split off j = 0 and apply Pascal
    rw [sum_range_succ']
    simp only [qbin_succ_succ, mul_add, add_mul, sum_add_distrib]
    have hA : ∑ i ∈ range (h + 1), (-1) ^ (i + 1) * q ^ ((i + 1).choose 2) * qbin q h i *
        y ^ (i + 1) = -y * R := by
      rw [mul_sum]; refine sum_congr rfl fun i _ => ?_
      rw [Nat.choose_succ_succ, Nat.choose_one_right]; ring
    have hB : ∑ i ∈ range (h + 1), (-1) ^ (i + 1) * q ^ ((i + 1).choose 2) *
        (q ^ (i + 1) * qbin q h (i + 1)) * y ^ (i + 1) +
        (-1) ^ 0 * q ^ (Nat.choose 0 2) * qbin q (h + 1) 0 * y ^ 0 = R := by
      have := sum_range_succ' (fun j => (-1) ^ j * q ^ (j.choose 2) * qbin q h j * (q * y) ^ j)
        (h + 1)
      rw [sum_range_succ, qbin_eq_zero_of_lt q (by omega : h < h + 1)] at this
      simp only [mul_zero, zero_mul, add_zero] at this
      change R = _ at this
      rw [this]; simp only [qbin_zero_right]; congr 1
      · refine sum_congr rfl fun i _ => ?_; ring
      · simp
    rw [add_assoc, hB, hA, ih, prod_range_succ']
    simp only [pow_zero, mul_one]
    rw [mul_comm (∏ i ∈ range h, _)]
    have : ∀ i ∈ range h, (1 - q * y * q ^ i) = (1 - y * q ^ (i + 1)) := by
      intro i _; ring
    rw [prod_congr rfl this]; ring

/-- `∑_{j ≤ h} (-1)^j q^(j choose 2) [h j] = δ_{h0}`. -/
lemma qbin_alt_sum (q : K) (h : ℕ) :
    ∑ j ∈ range (h + 1), (-1) ^ j * q ^ (j.choose 2) * qbin q h j = if h = 0 then 1 else 0 := by
  have := qbin_rothe q h 1
  simp only [one_pow, mul_one, one_mul] at this
  rw [this]
  split_ifs with hh
  · subst hh; simp
  · exact prod_eq_zero (mem_range.2 (Nat.pos_of_ne_zero hh)) (by simp)

lemma qfall_zero (q : K) (v : ℕ) : qfall q v 0 = 1 := by simp [qfall]

lemma qfall_succ (q : K) (v k : ℕ) :
    qfall q (v + 1) (k + 1) = (1 - q ^ (v + 1)) * qfall q v k := by
  rw [qfall, prod_range_succ', mul_comm]
  congr 1
  refine prod_congr rfl fun i _ => ?_
  congr 2; omega

lemma qpoch_eq_mul_qfall (q : K) : ∀ (v k : ℕ), k ≤ v → qpoch q v = qpoch q (v - k) * qfall q v k
  | v, 0, _ => by simp [qfall_zero]
  | 0, k + 1, h => by omega
  | v + 1, k + 1, h => by
    rw [qfall_succ, Nat.add_sub_add_right, qpoch_succ, qpoch_eq_mul_qfall q v k (by omega)]
    ring

lemma qpoch_ne_zero_of_le (q : K) {m n : ℕ} (hmn : m ≤ n) (h : qpoch q n ≠ 0) :
    qpoch q m ≠ 0 := by
  have := qpoch_eq_mul_qfall q n (n - m) (by omega)
  rw [Nat.sub_sub_self hmn] at this
  intro h0; rw [h0, zero_mul] at this; exact h this

end J6QLU

end

section
-- Source module: Solutions.J6QLUToep
/-!
# Triangular Toeplitz matrices and the coefficient identities

`lowT c` (lower) and `upT c` (upper) are the triangular Toeplitz matrices of a sequence
`c : ℕ → K`; their products are triangular Toeplitz in the Cauchy convolution `conv c d`.
We define the q-LU coefficients
* `bP x z h = x^(h^2) z^h / (q;q)_h`,   (`b^+`; `b^-` is `bP x z⁻¹`)
* `aP x z h = (-(x z))^h / (q;q)_h`,    (`a^+`; `a^-` is `aP x z⁻¹`)
with `q = x^2`, and prove `conv (bP x z) (aP x z) = δ` (Euler / q-binomial).
-/

open Finset Matrix

namespace J6QLU

variable {K : Type*} [Field K]

lemma sum_fin_ite {n : ℕ} (f : ℕ → K) (lo hi : ℕ) (hhi : hi < n) :
    ∑ k : Fin n, (if lo ≤ (k : ℕ) ∧ (k : ℕ) ≤ hi then f k else 0) =
      ∑ k ∈ Ico lo (hi + 1), f k := by
  rw [Fin.sum_univ_eq_sum_range (fun k => if lo ≤ k ∧ k ≤ hi then f k else 0), ← sum_filter]
  congr 1; ext k; simp only [mem_filter, mem_range, mem_Ico]; omega

lemma upT_mul_upT {n : ℕ} (c d : ℕ → K) :
    (upT c * upT d : Matrix (Fin n) (Fin n) K) = upT (conv c d) := by
  ext i j
  simp only [mul_apply, upT]
  have : ∀ k : Fin n, ((if (i : ℕ) ≤ k then c (k - i) else 0) *
      (if (k : ℕ) ≤ j then d (j - k) else 0)) =
      if (i : ℕ) ≤ k ∧ (k : ℕ) ≤ j then c (k - i) * d (j - k) else 0 := by
    intro k; split_ifs <;> simp_all
  simp only [this]
  rw [sum_fin_ite (fun k => c (k - i) * d (j - k)) i j j.2]
  split_ifs with hij
  · rw [sum_Ico_eq_sum_range, conv]
    have e : (j : ℕ) + 1 - i = j - i + 1 := by omega
    rw [e]; refine sum_congr rfl fun m hm => ?_
    rw [mem_range] at hm; congr 2 <;> omega
  · exact sum_eq_zero fun k hk => by simp at hk; omega

lemma lowT_mul_lowT {n : ℕ} (c d : ℕ → K) :
    (lowT c * lowT d : Matrix (Fin n) (Fin n) K) = lowT (conv c d) := by
  ext i j
  simp only [mul_apply, lowT]
  have : ∀ k : Fin n, ((if (k : ℕ) ≤ i then c (i - k) else 0) *
      (if (j : ℕ) ≤ k then d (k - j) else 0)) =
      if (j : ℕ) ≤ k ∧ (k : ℕ) ≤ i then c (i - k) * d (k - j) else 0 := by
    intro k; split_ifs <;> simp_all
  simp only [this]
  rw [sum_fin_ite (fun k => c (i - k) * d (k - j)) j i i.2]
  split_ifs with hij
  · rw [sum_Ico_eq_sum_range, conv]
    have e : (i : ℕ) + 1 - j = i - j + 1 := by omega
    rw [e, ← sum_range_reflect]; refine sum_congr rfl fun m hm => ?_
    rw [mem_range] at hm; congr 2 <;> omega
  · exact sum_eq_zero fun k hk => by simp at hk; omega

lemma upT_delta0 {n : ℕ} : (upT delta0 : Matrix (Fin n) (Fin n) K) = 1 := by
  ext i j
  rcases eq_or_ne i j with rfl | h
  · simp [upT, delta0]
  · rw [one_apply_ne h]
    have := Fin.val_ne_of_ne h
    simp only [upT, delta0]
    split_ifs <;> first | rfl | omega

lemma lowT_delta0 {n : ℕ} : (lowT delta0 : Matrix (Fin n) (Fin n) K) = 1 := by
  ext i j
  rcases eq_or_ne i j with rfl | h
  · simp [lowT, delta0]
  · rw [one_apply_ne h]
    have := Fin.val_ne_of_ne h
    simp only [lowT, delta0]
    split_ifs <;> first | rfl | omega

lemma inv_qpoch_mul_inv_qpoch (q : K) {h j : ℕ} (hj : j ≤ h) (hq : qpoch q h ≠ 0) :
    (qpoch q j)⁻¹ * (qpoch q (h - j))⁻¹ = qbin q h j / qpoch q h := by
  have h1 := qpoch_ne_zero_of_le q hj hq
  have h2 := qpoch_ne_zero_of_le q (Nat.sub_le h j) hq
  rw [eq_div_iff hq]
  conv_lhs => rw [← qbin_mul_qpoch q h j hj]
  field_simp

/-- Euler/q-binomial: `∑_{j ≤ h} b^+_j a^+_{h-j} = δ_{h0}`. -/
lemma conv_bP_aP (x z : K) (h : ℕ) (hq : qpoch (x ^ 2) h ≠ 0) :
    conv (bP x z) (aP x z) h = delta0 h := by
  have key := qbin_alt_sum (x ^ 2) h
  have hterm : ∀ j ∈ range (h + 1), bP x z j * aP x z (h - j) =
      (-(x * z)) ^ h / qpoch (x ^ 2) h *
        ((-1) ^ j * (x ^ 2) ^ (j.choose 2) * qbin (x ^ 2) h j) := by
    intro j hj
    rw [mem_range] at hj
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (Nat.lt_succ_iff.1 hj)
    have hi := inv_qpoch_mul_inv_qpoch (x ^ 2) (Nat.le_add_right j m) hq
    rw [Nat.add_sub_cancel_left] at hi
    rw [bP, aP, Nat.add_sub_cancel_left, div_mul_div_comm, div_eq_mul_inv, mul_inv, hi]
    have hc : ∀ j : ℕ, j ^ 2 = 2 * j.choose 2 + j := by
      intro j
      induction j with
      | zero => simp
      | succ k ih => rw [Nat.choose_succ_succ, Nat.choose_one_right]; nlinarith [ih]
    rw [hc j, pow_add, pow_mul, pow_add (-(x * z)), neg_pow (x * z) j, mul_pow]
    have : ((-1 : K) ^ j) ^ 2 = 1 := by rw [← pow_mul, mul_comm, pow_mul]; simp
    linear_combination (-((x ^ 2) ^ j.choose 2 * x ^ j * z ^ j * (-(x * z)) ^ m *
      (qbin (x ^ 2) (j + m) j / qpoch (x ^ 2) (j + m)))) * this
  rw [conv, sum_congr rfl hterm, ← mul_sum, key, delta0]
  split_ifs with h0
  · subst h0; simp
  · simp

end J6QLU

end

section
-- Source module: Solutions.J6QLUMain
/-!
# Exact q-LU factorization and explicit inverse of the Gaussian Toeplitz matrix

For a field `K`, `x z : K` with `z ≠ 0`, `q = x^2`, and `(q;q)_i ≠ 0` for `i < n`:

* `T_{uv} = x^((v-u)^2) z^(v-u)`   (`gaussToep x z n`),
* `Γ = diag((q;q)_0, …, (q;q)_{n-1})`,
* `T = Γ L(b⁻) Γ⁻¹ U(b⁺) Γ`, `b^±_h = x^(h^2) z^(±h) / (q;q)_h`         (`qLU`),
* `T⁻¹ = Γ⁻¹ U(a⁺) Γ L(a⁻) Γ⁻¹`, `a^±_h = (-1)^h (x z^(±1))^h / (q;q)_h`  (`qLU_inv`).

With `x = e^{-πα²σ}`, `z = e^{-2πα²b}` this is the report's
`T^{(b)}_{uv} = e^{-πα²(σh²+2bh)}`, `q = e^{-2πα²σ}` (see `J6QLUReal`).
-/

open Finset Matrix

namespace J6QLU

variable {K : Type*} [Field K]

lemma GamInv_mul_Gam (q : K) (n : ℕ) (hq : ∀ i < n, qpoch q i ≠ 0) :
    GamInv q n * Gam q n = 1 := by
  rw [GamInv, Gam, diagonal_mul_diagonal, ← diagonal_one]
  congr 1; funext i; exact inv_mul_cancel₀ (hq i i.2)

lemma Gam_mul_GamInv (q : K) (n : ℕ) (hq : ∀ i < n, qpoch q i ≠ 0) :
    Gam q n * GamInv q n = 1 := by
  rw [GamInv, Gam, diagonal_mul_diagonal, ← diagonal_one]
  congr 1; funext i; exact mul_inv_cancel₀ (hq i i.2)

lemma upT_congr {n : ℕ} {c d : ℕ → K} (h : ∀ m < n, c m = d m) :
    (upT c : Matrix (Fin n) (Fin n) K) = upT d := by
  ext i j; simp only [upT]; split_ifs <;> [exact h _ (by omega); rfl]

lemma lowT_congr {n : ℕ} {c d : ℕ → K} (h : ∀ m < n, c m = d m) :
    (lowT c : Matrix (Fin n) (Fin n) K) = lowT d := by
  ext i j; simp only [lowT]; split_ifs <;> [exact h _ (by omega); rfl]

lemma upT_bP_mul_aP (x z : K) (n : ℕ) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    (upT (aP x z) * upT (bP x z) : Matrix (Fin n) (Fin n) K) = 1 := by
  rw [mul_eq_one_comm, upT_mul_upT, ← upT_delta0]
  exact upT_congr fun m hm => conv_bP_aP x z m (hq m hm)

lemma lowT_bP_mul_aP (x z : K) (n : ℕ) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    (lowT (aP x z) * lowT (bP x z) : Matrix (Fin n) (Fin n) K) = 1 := by
  rw [mul_eq_one_comm, lowT_mul_lowT, ← lowT_delta0]
  exact lowT_congr fun m hm => conv_bP_aP x z m (hq m hm)

/-- **Explicit inverse**: `T⁻¹ = Γ⁻¹ U(a⁺) Γ L(a⁻) Γ⁻¹` with `a^+ = aP x z`, `a^- = aP x z⁻¹`. -/
theorem qLU_inv_mul (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    GamInv (x ^ 2) n * upT (aP x z) * Gam (x ^ 2) n * lowT (aP x z⁻¹) * GamInv (x ^ 2) n *
      gaussToep x z n = 1 := by
  have cancel : ∀ A B X : Matrix (Fin n) (Fin n) K, A * B = 1 → A * (B * X) = X := by
    intro A B X h; rw [← Matrix.mul_assoc, h, Matrix.one_mul]
  rw [qLU x z n hz hq]
  simp only [Matrix.mul_assoc]
  rw [cancel _ _ _ (GamInv_mul_Gam _ n hq), cancel _ _ _ (lowT_bP_mul_aP x z⁻¹ n hq),
    cancel _ _ _ (Gam_mul_GamInv _ n hq), cancel _ _ _ (upT_bP_mul_aP x z n hq),
    GamInv_mul_Gam _ n hq]

theorem mul_qLU_inv (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    gaussToep x z n *
      (GamInv (x ^ 2) n * upT (aP x z) * Gam (x ^ 2) n * lowT (aP x z⁻¹) * GamInv (x ^ 2) n)
      = 1 :=
  mul_eq_one_comm.1 (qLU_inv_mul x z n hz hq)

end J6QLU

end

section
-- Source module: Solutions.J6QLUReal
/-!
# The segmented-inverse q-LU in the report's real parametrization

`T^{(b)}_{uv} = e^{-πα²(σh²+2bh)}`, `h = v - u`, `q = e^{-2πα²σ}`, `Γ = diag((q;q)_i)`:
* `T = Γ L(b⁻) Γ⁻¹ U(b⁺) Γ`,  `b^±_h = e^{-πα²(σh² ± 2bh)}/(q;q)_h`   (`realToep_qLU`)
* `T⁻¹ = Γ⁻¹ U(a⁺) Γ L(a⁻) Γ⁻¹`, `a^±_h = (-1)^h e^{-πα²(σ±2b)h}/(q;q)_h` (`realToep_inv`)
for every block size `n`, whenever `α²σ > 0`.
-/

open Finset Matrix Real

namespace J6QLU

section
variable (α σ b : ℝ)

lemma xR_sq : xR α σ ^ 2 = qR α σ := by
  rw [xR, qR, ← Real.exp_nat_mul]; congr 1; push_cast; ring

lemma realToep_eq (n : ℕ) : realToep α σ b n = gaussToep (xR α σ) (zR α b) n := by
  ext u v
  simp only [realToep, gaussToep]
  rw [zpow_sub₀ (exp_pos _).ne', zpow_natCast, zpow_natCast, ← Real.exp_nat_mul,
    ← Real.exp_nat_mul, ← Real.exp_nat_mul, ← Real.exp_sub, ← Real.exp_add]
  congr 1
  have : (((((v : ℕ) : ℤ) - ((u : ℕ) : ℤ)).natAbs ^ 2 : ℕ) : ℝ) = ((v : ℝ) - u) ^ 2 := by
    rw [Nat.cast_pow, Nat.cast_natAbs, Int.cast_abs, sq_abs]; push_cast; ring
  rw [this]; ring

lemma aplus_eq : aplus α σ b = aP (xR α σ) (zR α b) := by
  funext h
  rw [aplus, aP, xR_sq, neg_pow (exp _ * exp _), ← Real.exp_add, ← Real.exp_nat_mul]
  congr 3; ring

lemma aminus_eq : aminus α σ b = aP (xR α σ) (zR α b)⁻¹ := by
  funext h
  rw [aminus, aP, xR_sq, ← Real.exp_neg, neg_pow (exp _ * exp _), ← Real.exp_add, ← Real.exp_nat_mul]
  congr 3; ring

lemma qR_pos : 0 < qR α σ := exp_pos _

lemma qR_lt_one (h : 0 < α ^ 2 * σ) : qR α σ < 1 := by
  rw [qR, ← exp_zero]; exact exp_lt_exp.2 (by nlinarith [pi_pos])

lemma qpoch_pos {q : ℝ} (h0 : 0 ≤ q) (h1 : q < 1) (n : ℕ) : 0 < qpoch q n :=
  prod_pos fun i _ => sub_pos.2 (pow_lt_one₀ h0 h1 (by omega))

lemma qpoch_qR_ne_zero (h : 0 < α ^ 2 * σ) (n : ℕ) : ∀ i < n, qpoch (xR α σ ^ 2) i ≠ 0 :=
  fun i _ => by rw [xR_sq]; exact (qpoch_pos (qR_pos α σ).le (qR_lt_one α σ h) i).ne'

theorem realToep_mul_inv (h : 0 < α ^ 2 * σ) (n : ℕ) :
    realToep α σ b n * (GamInv (qR α σ) n * upT (aplus α σ b) * Gam (qR α σ) n *
      lowT (aminus α σ b) * GamInv (qR α σ) n) = 1 := by
  rw [realToep_eq, ← xR_sq α σ, aplus_eq, aminus_eq]
  exact mul_qLU_inv _ _ n (exp_pos _).ne' (qpoch_qR_ne_zero α σ h n)

end

end J6QLU

end

section
-- Source module: Solutions.J6SegFix
/-!
# Segmented inverse (S2): fixed-point primitives and elimination without pivoting

Fixed-point numbers of precision `P` are integers `a` standing for `a / 2^P`.
* `rq a b = ⌊a/b + 1/2⌋` (rounded quotient), `rs P a = rq a (2^P)`,
  `fmul P x y = rs P (x*y)` and `fdiv P x y = rq (x 2^P) y` (errors `≤ 1/2` ulp).
* `geSolve P L A b`: Gaussian elimination **without pivoting** in the order of the index list
  `L`, written as forward elimination of the head pivot followed by back substitution.
* `schur_row` (report L9): if every row of `A - I` has absolute sum `≤ η ≤ 1/2`, the same holds for
  the Schur complement after eliminating one pivot; hence for every Schur complement, and no
  pivoting is ever needed (any order, any sparsity pattern, cyclic borders included).
* `near_id`: `‖A - I‖_∞ ≤ η < 1` and `‖A z - r‖ ≤ ρ` give `‖z‖ ≤ (‖r‖ + ρ)/(1 - η)`.
* `geSolve_resid`: the computed solution has residual `≤ (Z+1)(|L|+1)²/2^P`;
  `geSolve_bound`: and `|z| ≤ 4B + 1`.
-/

open Finset

namespace J6Seg

lemma two_pow_pos' (P : ℕ) : (0 : ℝ) < 2 ^ P := by positivity

lemma kd_self (i : ℕ) : kd i i = 1 := by simp [kd]
lemma kd_ne {i k : ℕ} (h : i ≠ k) : kd i k = 0 := by simp [kd, h]

/-! ### Gaussian elimination without pivoting -/

/-- Near-identity bound: `‖a - I‖_∞ ≤ η < 1`, `‖a z - r‖_∞ ≤ ρ`, `‖r‖_∞ ≤ B` give
`‖z‖_∞ ≤ (B + ρ)/(1 - η)` (all on the index set `I`). -/
theorem near_id {I : Finset ℕ} {a : ℕ → ℕ → ℝ} {z r : ℕ → ℝ} {η ρ B : ℝ} (hη : η < 1)
    (hrow : ∀ i ∈ I, ∑ k ∈ I, |a i k - kd i k| ≤ η)
    (hres : ∀ i ∈ I, |∑ k ∈ I, a i k * z k - r i| ≤ ρ) (hr : ∀ i ∈ I, |r i| ≤ B) :
    ∀ i ∈ I, |z i| ≤ (B + ρ) / (1 - η) := by
  intro i hi
  obtain ⟨i0, hi0, hmax⟩ := I.exists_max_image (fun k => |z k|) ⟨i, hi⟩
  have hpos : 0 < 1 - η := by linarith
  suffices h : |z i0| ≤ (B + ρ) / (1 - η) from (hmax i hi).trans h
  have e : ∑ k ∈ I, a i0 k * z k = z i0 + ∑ k ∈ I, (a i0 k - kd i0 k) * z k := by
    have : ∑ k ∈ I, kd i0 k * z k = z i0 := by
      simp only [kd, ite_mul, one_mul, zero_mul]; rw [sum_ite_eq]; simp [hi0]
    rw [← this, ← sum_add_distrib]; exact sum_congr rfl fun k _ => by ring
  have hsum : |∑ k ∈ I, (a i0 k - kd i0 k) * z k| ≤ η * |z i0| := by
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ I, |(a i0 k - kd i0 k) * z k| ≤ ∑ k ∈ I, |a i0 k - kd i0 k| * |z i0| :=
          sum_le_sum fun k hk => by
            rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hmax k hk) (abs_nonneg _)
      _ = (∑ k ∈ I, |a i0 k - kd i0 k|) * |z i0| := by rw [sum_mul]
      _ ≤ η * |z i0| := mul_le_mul_of_nonneg_right (hrow i0 hi0) (abs_nonneg _)
  have h1 := hres i0 hi0
  have h2 := hr i0 hi0
  rw [e] at h1
  have h3 : |z i0| ≤ |z i0 + ∑ k ∈ I, (a i0 k - kd i0 k) * z k - r i0| + |r i0| +
      |∑ k ∈ I, (a i0 k - kd i0 k) * z k| := by
    have e2 : z i0 = (z i0 + ∑ k ∈ I, (a i0 k - kd i0 k) * z k - r i0) + r i0 +
        (-(∑ k ∈ I, (a i0 k - kd i0 k) * z k)) := by ring
    have := abs_add_three (z i0 + ∑ k ∈ I, (a i0 k - kd i0 k) * z k - r i0) (r i0)
      (-(∑ k ∈ I, (a i0 k - kd i0 k) * z k))
    rw [abs_neg, ← e2] at this
    exact this
  rw [le_div_iff₀ hpos]
  nlinarith

