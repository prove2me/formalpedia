-- title:
--   Span of the first coordinates of a pool
-- statement:
--   For a finite list $P$ of candidates $(a,b)\in\mathbb F_2^n\times\mathbb F_2$, its **span** is the subspace
--   $$
--   \operatorname{span}\{a : (a,b)\in P\}\le\mathbb F_2^n
--   $$
--   generated by the first coordinates of its entries. The lower bound tracks only this subspace: a policy can query the target $(x,x\cdot x)$ only after $x$ has entered the span of its live pool, or at a generation.
-- source:
--   A. Brandenberger, I. Doron-Arad, E. Mossel, Genetic Algorithms with Optimization Guided Operators, STOC 2027 submission (manuscript sha256 f89f4f770d5d05df82f0407a81287ce4ccf618727beb5415eef3ad56c36b6cbe), proof of Lemma 1, pp.9–10

import Mathlib
import Definitions.Def_GMRDiversity_Cand

namespace GMRDiversity

open ExtremalForrelation.Nonadaptive

/-- **Span of the first coordinates of a pool** (Brandenberger, Doron-Arad, Mossel, *Genetic
Algorithms with Optimization Guided Operators*, STOC 2027 submission, manuscript sha256 f89f4f77…,
proof of Lemma 1, pp.9–10: "We track only the first coordinate of each candidate … the span of the
live pool"): for a list `P` of candidates `(a, b)`, the subspace of `𝔽₂ⁿ` spanned by the vectors `a`
occurring in `P`. -/
def poolSpan {n : ℕ} (P : List (Cand n)) : Submodule (ZMod 2) (V n) :=
  Submodule.span (ZMod 2) {a | ∃ y ∈ P, y.1 = a}

end GMRDiversity


