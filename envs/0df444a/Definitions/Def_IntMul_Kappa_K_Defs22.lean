-- Source module: Solutions.KFMU5
/-!
# KFM U5: `n` in binary from the ruler `2^n`, in linear time

The IL `read` leaves `val x` and the ruler `2^n`, but not `n`. Setup needs `n` itself, for
`L = LP n` (`4n ≤ 2^L b`), the digit counts and the small-`n` test. Counting by `+1` costs
`Θ(n log n)`. `nP` works like `lgP` (KFMU4):

1. **phase 1** (`nLoop`): the rulers `R_k = 2^{2^k}` are squared up to `J = size(n+1)` while a
   copy of `2^n` is divided by them (`O(2^k)` per step). Every ruler is **kept** on `gS`, above a
   sentinel `0`;
2. **phase 2** (`nLoop2`): a second copy of `2^n` is split greedily by `R_{J-1}, …, R_0`. Each
   split by `R_k` gives bit `k` of `n` (quotient nonzero) and costs `O(2^k)`, which is independent of
   the size of the number. The bits are collected by Horner on `gJ`.

**`nP_runs`**: from `2^n` on `gN = 35`, `nP` pushes `n` on `gJ = 23`, everything else restored,
cost `≤ 10^6 (n + 1)`. Scratch `20–22`, `26`, `34`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT

abbrev gS : Fin HS := 26

/-- The kept rulers `prvK (k-1), …, prvK 0` (top first; `prvK 0 = 0` is the sentinel). -/
def rl (k : ℕ) : List ℤ := (List.range k).reverse.map fun j => (prvK j : ℤ)

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## Phase 1 -/

def nB : IStmt HS P :=
  .seq (.op (.mv gP gS)) (.seq (.op (.dup gR gP)) (.seq (.op (.split gA gR gT)) (.seq (.op (.drop gT))
    (.seq (.op (.dup gR gT)) (.seq (.op (.shl gR gT)) (.op (.drop gT)))))))

def nS1 (s : IState HS) (LA LR LP LS : List Item) (n k : ℕ) : IState HS :=
  (((s.upd gA (.int (aK n k : ℤ) :: LA)).upd gR (.int ((2 : ℤ) ^ (2 ^ k)) :: LR)).upd gP
    (.int (prvK k : ℤ) :: LP)).upd gS (ints (rl k) ++ LS)

def cNB (k : ℕ) : ℕ := 10 ^ 4 * (2 ^ k + 2)

def nLoop : IStmt HS P := .loop gA isPosC nB

/-! ## Phase 2 -/

/-- Phase-2 state at level `k` (rulers `R_{k-1}, …, R_0` and the sentinel left on `gS`):
`gA = 2^{n mod 2^k}`, `gJ = ⌊n / 2^k⌋`. -/
def nT (s : IState HS) (LA LS LJ : List Item) (n k : ℕ) : IState HS :=
  ((s.upd gA (.int ((2 : ℤ) ^ (n % 2 ^ k)) :: LA)).upd gS (ints (rl (k + 1)) ++ LS)).upd gJ
    (.int ((n / 2 ^ k : ℕ) : ℤ) :: LJ)

def nB2 : IStmt HS P :=
  .seq (.op (.mv gS gR)) (.seq (.op (.const gT 2)) (.seq (.op (.shl gJ gT)) (.seq (.op (.drop gT))
    (.seq (.op (.split gA gR gT))
      (.seq (.ite gA isPosC (.seq (.op (.drop gT)) (.seq (.op (.const gT 1)) (.op (.add gJ gT gJ))))
        (.seq (.op (.drop gA)) (.op (.mv gT gA))))
      (.op (.drop gR)))))))

def cNB2 (k J : ℕ) : ℕ := 10 ^ 4 * (2 ^ k + J + 2)

def nLoop2 : IStmt HS P := .loop gS isPosC nB2

/-! ## Init, middle, post, and the whole procedure -/

def nInit : IStmt HS P := .seq (.op (.dup gN gA)) (.seq (.op (.const gR 2)) (.op (.const gP 0)))

def nMid : IStmt HS P :=
  .seq (.op (.drop gA)) (.seq (.op (.drop gR)) (.seq (.op (.mv gP gS)) (.seq (.op (.dup gN gA))
    (.op (.const gJ 0)))))

def nPost : IStmt HS P := .seq (.op (.drop gS)) (.op (.drop gA))

/-- **`n` from the ruler `2^n` on `gN`.** -/
def nP : IStmt HS P := .seq nInit (.seq nLoop (.seq nMid (.seq nLoop2 nPost)))

end IL

end NLogN.KFM

end

section
-- Source module: Solutions.KFMS0
/-!
# KFM S0: generic counted loops of register programs (`RS.rep`) for the setup arithmetic

The setup parameters (§9.2: `d, K, α, L, ℓ, r, s_i, μ_i, …`) are small numbers (`O(log n)` bits)
computed by register programs `RS` (nlogn `HReg`; `RS.code_runs` gives the IL run). This file
proves one generic loop lemma, so that every parameter program is a short instance:

* **`genLoop_run`**: `rep i n body` with `n = N`, where on the iteration-`k` state `lpSt … k c`
  (counter `N − k` on `i`, accumulator `c` on `a`) `body` only replaces the accumulator by
  `G k c`. The result is `accSeq G a0 N` on `a`; all else unchanged.
* **`genLoop_cost`**: cost `≤ (|n|+1)·10^7(B+2)² + N·(C + 4·10^7(B+2)² + 30) + 32` when each
  body run costs `≤ C`.
* Instances: **`sumSeq`** (`G k c = c + g (N − k)`, so the result is `a0 + Σ_{x=1}^{N} g x`,
  **`accSeq_sum`**) and **`satSq`** (`G k c = min(c², cap)`, `m` squarings give
  `min(x^{2^m}, cap)`, **`accSeq_satSq`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS

/-- The accumulator sequence `a0, G 0 a0, G 1 (G 0 a0), …`. -/
def accSeq (G : ℕ → ℤ → ℤ) (a0 : ℤ) : ℕ → ℤ
  | 0 => a0
  | k + 1 => G k (accSeq G a0 k)

/-- The state at the start of iteration `k`: counter `N − k` on `i`, accumulator `c` on `a`. -/
def lpSt (s : IState HS) (i a : Fin HS) (La : List Item) (N k : ℕ) (c : ℤ) : IState HS :=
  (s.upd i (.int ((N : ℤ) - k) :: s.G i)).upd a (.int c :: La)

/-! ## Instances -/

/-- Sums: `G k c = c + g (N - k)`. -/
def sumG (g : ℕ → ℤ) (N : ℕ) : ℕ → ℤ → ℤ := fun k c => c + g (N - k)

/-- Saturated squaring `c ↦ min(c², cap)` (as `sel (cap - c²) cap c²`). -/
def satG (cap : ℤ) : ℕ → ℤ → ℤ := fun _ c => if cap - c * c < 0 then cap else c * c

end NLogN.KFM

end

section
-- Source module: Solutions.KFMS1
/-!
# KFM S1: integer roots by counting (setup of `d = ⌊b^{2^{-75}}⌋` and `K = ⌊d^{2^{-56}}⌋`)

`rootP m rv rd` pushes onto `rd` the number of `x ∈ [1, v]` with `x^{2^m} ≤ v`, where `v ≥ 1` is
the top of `rv`. Each test makes `m` saturated squarings `y ↦ min(y², v+1)` (`m` is a literal, a
true constant: `75` or `56`), so every value has `O(log v)` bits. The predicate is downward closed,
so the count is the largest such `x` (**`count_eq_findGreatest`**), i.e. the integer
`2^m`-th root of `v`.

* **`rootP_run`**: the run (`RS`), all stacks but `rd` restored.
* **`count_root_spec`**: `c^{2^m} ≤ v < (c+1)^{2^m}`.
Scratch: `sI = 20` (outer counter), `sY = 21`, `sJ = 22` (inner counter).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS

abbrev sI : Fin HS := 20
abbrev sY : Fin HS := 21
abbrev sJ : Fin HS := 22

/-! ## Counting a downward-closed predicate -/

/-! ## The program -/

/-- `min(y², v+1)` as an expression (`v` on `rv`, `y` on `sY`). -/
def satE (rv : Fin HS) : Ex HS :=
  .sel (.add (.add (.reg rv) (.lit 1)) (.neg (.mul (.reg sY) (.reg sY)))) (.add (.reg rv) (.lit 1))
    (.mul (.reg sY) (.reg sY))

/-- The root body: test one candidate `x` (the counter). -/
def rootB (m : ℕ) (rv rd : Fin HS) : RS :=
  .seq (.push sY (.reg NLogN.KFM.sI)) (.seq (.rep sJ (.lit m) (.asg sY (satE rv)))
    (.seq (.asg rd (.add (.reg rd) (.sel (.add (.reg rv) (.neg (.reg sY))) (.lit 0) (.lit 1))))
      (.pop sY)))

/-- **`rootP m rv rd`**: push `#{x ∈ [1, v] : x^{2^m} ≤ v}` onto `rd`. -/
def rootP (m : ℕ) (rv rd : Fin HS) : RS :=
  .seq (.push rd (.lit 0)) (.rep NLogN.KFM.sI (.reg rv) (rootB m rv rd))

/-- The indicator of the test. -/
def rootInd (m v : ℕ) (x : ℕ) : ℤ := if x ^ (2 ^ m) ≤ v then 1 else 0

/-- Register hypotheses of `rootP`. -/
structure RootRegs (rv rd : Fin HS) : Prop where
  v56 : rv.val < 56
  d56 : rd.val < 56
  vz : rv.val < 56
  vI : rv ≠ NLogN.KFM.sI
  vY : rv ≠ sY
  vJ : rv ≠ sJ
  dI : rd ≠ NLogN.KFM.sI
  dY : rd ≠ sY
  dJ : rd ≠ sJ
  vd : rv ≠ rd

/-! ## Runs -/

/-! ## Cost -/

/-- The bit bound of the root computation for the input `v`. -/
def Bv (v : ℕ) : ℕ := 2 * zsz ((v + 1 : ℕ) : ℤ) + 2

end NLogN.KFM

end

section
-- Source module: Solutions.KFMS2
/-!
# KFM S2: counting loops with an expression test, and products

* **`cntP n tst rd`**: push onto `rd` the number of `x ∈ [1, N]` (`N = n`) for which the test
  expression `tst` (read with the candidate `x` on top of `sI = 20`) is negative.
  **`cntP_run`**, **`cntP_cost`**.
* **`prodP n rd`**: push `∏_{x=1}^{N} x = N!` onto `rd`. **`prodP_run`**, **`prodP_cost`**.
* `Ex.Bnd_upd`: bounds are unchanged by updating a stack the expression does not read.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS

/-! ## Counting with an expression test -/

/-- The count body. -/
def cntB (tst : Ex HS) (rd : Fin HS) : RS :=
  .asg rd (.add (.reg rd) (.sel tst (.lit 1) (.lit 0)))

def cntP (n tst : Ex HS) (rd : Fin HS) : RS :=
  .seq (.push rd (.lit 0)) (.rep NLogN.KFM.sI n (cntB tst rd))

/-- The state at candidate `x`. -/
def xSt (s : IState HS) (x : ℕ) : IState HS := s.upd NLogN.KFM.sI (.int (x : ℤ) :: s.G NLogN.KFM.sI)

/-! ## Factorials -/

def prodG (N : ℕ) : ℕ → ℤ → ℤ := fun k c => c * ((N : ℤ) - k)

def prodB (rd : Fin HS) : RS := .asg rd (.mul (.reg rd) (.reg NLogN.KFM.sI))

/-- **`prodP n rd`**: push `N!` onto `rd` (`N = n`). -/
def prodP (n : Ex HS) (rd : Fin HS) : RS := .seq (.push rd (.lit 1)) (.rep NLogN.KFM.sI n (prodB rd))

end NLogN.KFM

end

section
-- Source module: Solutions.KFMS3
/-!
# KFM S3: the scalar setup parameters as counts (math side)

For `n ≥ n₀` the §9.2 parameters are the counts computed by `rootP` / `cntP`:

* **`d_count`**: `dP n = findGreatest (x^{2^75} ≤ b) b`;
* **`K_count`**: `KP n = findGreatest (x^{2^56} ≤ d) d`;
* **`α_count`**: `αP n = 1 + findGreatest (x^4 < X) X`, `X = 12 d² b`;
* **`L_count`**: `LP n = findGreatest (2^{x-1} b < 4n) b`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue

/-! ## The setup register program -/

open RS

abbrev zN : Fin HS := 23
abbrev zB : Fin HS := 24
abbrev zD : Fin HS := 25
abbrev zK : Fin HS := 26
abbrev zAl : Fin HS := 27
abbrev zL : Fin HS := 28
abbrev zEl : Fin HS := 29
abbrev zR : Fin HS := 30
abbrev zDp : Fin HS := 31
abbrev zQ : Fin HS := 32
abbrev zMh : Fin HS := 33
abbrev zMf : Fin HS := 34

/-- `X = 12 d² b`. -/
def XE : Ex HS := .mul (.mul (.lit 12) (.mul (.reg NLogN.KFM.zD) (.reg NLogN.KFM.zD))) (.reg zB)
/-- `x^4 − X` (`x` on `sI`). -/
def tstA : Ex HS := .add (.mul (.mul (.reg NLogN.KFM.sI) (.reg NLogN.KFM.sI)) (.mul (.reg NLogN.KFM.sI) (.reg NLogN.KFM.sI))) (.neg NLogN.KFM.XE)
/-- `2^{x−1} b − 4n`. -/
def tstL : Ex HS := .add (.mul (.pow2 (.add (.reg NLogN.KFM.sI) (.lit (-1)))) (.reg zB)) (.neg (.mul (.lit 4) (.reg zN)))
/-- `ℓ = ⌊(L + d − 1)/d⌋`. -/
def elE : Ex HS := .ndiv (.add (.add (.reg zL) (.reg NLogN.KFM.zD)) (.lit (-1))) (.reg NLogN.KFM.zD)
/-- `d' = dℓ − L`. -/
def dpE : Ex HS := .add (.mul (.reg NLogN.KFM.zD) (.reg zEl)) (.neg (.reg zL))
/-- `D = 256 d²`. -/
def DE : Ex HS := .mul (.lit 256) (.mul (.reg NLogN.KFM.zD) (.reg NLogN.KFM.zD))
/-- `Q = 2F(⌊r/(2FD)⌋ + 1)` (`F` on `zQ`). -/
def QE : Ex HS :=
  .mul (.mul (.lit 2) (.reg zQ)) (.add (.ndiv (.reg zR) (.mul (.mul (.lit 2) (.reg zQ)) DE)) (.lit 1))
/-- `⌊((4d−1)t − 4d)/(4dQ)⌋` for `t` given by `tE`. -/
def ME (tE : Ex HS) : Ex HS :=
  .ndiv (.add (.mul (.add (.mul (.lit 4) (.reg NLogN.KFM.zD)) (.lit (-1))) tE) (.neg (.mul (.lit 4) (.reg NLogN.KFM.zD))))
    (.mul (.mul (.lit 4) (.reg NLogN.KFM.zD)) (.reg zQ))

/-- Part A: `d`, `K`, `α`. -/
def setupA : RS :=
  .seq (rootP 75 zB NLogN.KFM.zD) (.seq (rootP 56 NLogN.KFM.zD zK) (.seq (cntP NLogN.KFM.XE tstA zAl)
    (.asg zAl (.add (.reg zAl) (.lit 1)))))

/-- Part B: `L`, `ℓ`, `r`, `d'`. -/
def setupB : RS :=
  .seq (cntP (.reg zB) tstL zL) (.seq (.push zEl elE) (.seq (.push zR (.pow2 (.reg zEl)))
    (.push zDp dpE)))

/-- Part C: `Q` (through `F = D!`), `M_{r/2}`, `M_r`. -/
def setupC : RS :=
  .seq (prodP DE zQ) (.seq (.asg zQ QE) (.seq (.push zMh (ME (.ndiv (.reg zR) (.lit 2))))
    (.push zMf (ME (.reg zR)))))

/-- **The scalar setup program** (inputs `n` on `zN`, `b` on `zB`). -/
def setupS : RS := .seq setupA (.seq setupB setupC)

end NLogN.KFM

end

section
-- Source module: Solutions.KFMSm
/-!
# KFM Sm: bit bounds for register expressions from bounds on their atoms

`exSm A s e`: every register, literal and `2^a` that `e` reads is at most `A` in absolute value,
and every divisor is positive. `exDg e` is a degree (sums add one, products add). Then
`|e.eval s| ≤ A^{exDg e}` (**`exSm_abs`**), and `A^{exDg e} < 2^B` gives `e.Bnd s B`
(**`exSm_bnd`**), which is the hypothesis of the RS cost lemmas.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul RS

/-- Atom bounds (see the module doc). -/
def exSm (A : ℕ) (s : IState HS) : Ex HS → Prop
  | .reg i => |s.top i| ≤ (A : ℤ)
  | .lit c => |c| ≤ (A : ℤ)
  | .add a b | .mul a b => exSm A s a ∧ exSm A s b
  | .neg a => exSm A s a
  | .ndiv a b | .nmod a b => exSm A s a ∧ exSm A s b ∧ 0 < b.eval s
  | .pow2 a => exSm A s a ∧ 0 ≤ a.eval s ∧ 2 ^ (a.eval s).toNat ≤ A
  | _ => False

/-- The degree. -/
def exDg : Ex HS → ℕ
  | .reg _ | .lit _ => 1
  | .add a b => max (exDg a) (exDg b) + 1
  | .mul a b => exDg a + exDg b
  | .neg a | .pow2 a => exDg a
  | .ndiv a b | .nmod a b => max (exDg a) (exDg b)
  | _ => 1

end NLogN.KFM

end

