-- title:
--   §2, pp. 5–6 — finite information design game, public device, equilibrium correspondence, and Definition 2
-- statement:
--   Fix a nonempty finite set $N$ of **information designers** and a nonempty finite set $K$ of **agents**. Designer $i$ has a nonempty finite state set $\Theta_i$; agent $j$ has a nonempty finite action set $A_j$; designer $i$ can send agent $j$ a message from a nonempty finite set $M_i^j$. Write $\Theta=\prod_i\Theta_i$, $A=\prod_j A_j$, $M_i=\prod_j M_i^j$, and $M=\prod_i M_i$. A general probability distribution $p^0$ on $\Theta$ is the common prior. The payoff functions are $u_i:A\times\Theta\to\mathbb R$ for designers and $v_j:A\times\Theta\to\mathbb R$ for agents.
--
--   A **statistical experiment** of designer $i$ is $x_i:\Theta_i\to\Delta(M_i)$; $X_i=\Delta(M_i)^{\Theta_i}$ has its finite-dimensional topology and Borel sigma algebra. After the designers simultaneously choose $x=(x_i)_i$, the agents observe $x$. Nature draws $\theta$ from $p^0$ and a uniform public signal $\omega\in[0,1]$. Conditional on $\theta_i$, designer $i$ sends message profile $m_i$ with probability $x_i(m_i\mid\theta_i)$; agent $j$ sees $\omega$ and $(m_i^j)_i$, then acts.
--
--   For fixed $x$, a device-free behavioral profile $\sigma$ assigns each agent a lottery over actions at each of his private message profiles. It is a **Bayes Nash equilibrium** when each agent maximizes ex ante expected payoff against all other lottery-valued behavioral profiles. At zero-probability messages the action lottery is unrestricted by incentives. The **equilibrium-outcome correspondence** $E_M(x)\subseteq\Delta(A)^M$ consists of the outcomes generated by Borel measurable public-signal-dependent profiles $s(\omega)$ that are Bayes Nash equilibria at almost every $\omega$:
--
--   $$y(a\mid m)=\int_0^1\prod_{j\in K}s_j(\omega)(a_j\mid m^j)\,d\omega.$$
--
--   For an outcome $y\in E_M(x)$, designer $i$ receives
--
--   $$U_i(x,y)=\sum_{\theta\in\Theta}\sum_{m\in M}\sum_{a\in A}p^0(\theta)\Bigl(\prod_{i'\in N}x_{i'}(m_{i'}\mid\theta_{i'})\Bigr)y(a\mid m)u_i(a;\theta).$$
--
--   Put $\mathcal U(x)=\{(U_i(x,y))_i:y\in E_M(x)\}$. An **equilibrium of $G_M$** (Definition 2) is a Borel measurable selection $\tau(x)\in E_M(x)$ for every experiment profile $x$, together with independent Borel probability measures $\zeta_i$ on $X_i$ such that no designer gains by changing his measure to any other Borel probability measure. The resulting payoff integrals, including those after deviations, must be integrable.
--
--   This model supplies the definitions shared by every theorem in the mission.
--
--   **Formalization Note** Finite lotteries use the published `AGT.IsLottery`. The paper does not explicitly exclude empty message sets; nonemptiness is added because a designer otherwise has no experiment. The finite index types $N$ and $K$ are also nonempty, matching their positive player counts. The public device is Lebesgue probability measure on $[0,1]$. The paper does not define Bayes Nash equilibrium formally, so the agent incentive test is stated ex ante; measurability and integrability prevent default zero values of nonintegrable Lean integrals.
-- source:
--   Koessler, Laclau & Tomala, Interactive Information Design, SSRN working paper 3171992 (version of April 25, 2018), https://ssrn.com/abstract=3171992, pp. 5–6, §2, Definitions 1–2

import Mathlib
import Definitions.Def_agt_games

namespace InfoDesignGames.Existence

open MeasureTheory
open Filter
open scoped BigOperators

structure Game where
  ι : Type
  κ : Type
  Θ : ι → Type
  A : κ → Type
  Msg : ι → κ → Type
  finDesigners : Fintype ι
  finAgents : Fintype κ
  nonemptyDesigners : Nonempty ι
  nonemptyAgents : Nonempty κ
  finStates : ∀ i, Fintype (Θ i)
  finActions : ∀ j, Fintype (A j)
  finMessages : ∀ i j, Fintype (Msg i j)
  finDesignerMessages : ∀ i, Fintype (∀ j, Msg i j)
  finAllMessages : Fintype (∀ i, ∀ j, Msg i j)
  finAllStates : Fintype (∀ i, Θ i)
  finAllActions : Fintype (∀ j, A j)
  decDesigners : DecidableEq ι
  decAgents : DecidableEq κ
  stateNonempty : ∀ i, Nonempty (Θ i)
  actionNonempty : ∀ j, Nonempty (A j)
  messageNonempty : ∀ i j, Nonempty (Msg i j)
  p0 : (∀ i, Θ i) → ℝ
  priorLottery : @AGT.IsLottery (∀ i, Θ i) finAllStates p0
  u : ι → (∀ j, A j) → (∀ i, Θ i) → ℝ
  v : κ → (∀ j, A j) → (∀ i, Θ i) → ℝ

instance (G : Game) : Fintype G.ι := G.finDesigners
instance (G : Game) : Fintype G.κ := G.finAgents
instance (G : Game) : Nonempty G.ι := G.nonemptyDesigners
instance (G : Game) : Nonempty G.κ := G.nonemptyAgents
instance (G : Game) : DecidableEq G.ι := G.decDesigners
instance (G : Game) : DecidableEq G.κ := G.decAgents
instance (G : Game) (i : G.ι) : Fintype (G.Θ i) := G.finStates i
instance (G : Game) (j : G.κ) : Fintype (G.A j) := G.finActions j
instance (G : Game) (i : G.ι) (j : G.κ) : Fintype (G.Msg i j) := G.finMessages i j
instance (G : Game) (i : G.ι) : Fintype (∀ j, G.Msg i j) := G.finDesignerMessages i
instance (G : Game) : Fintype (∀ i, ∀ j, G.Msg i j) := G.finAllMessages
instance (G : Game) : Fintype (∀ i, G.Θ i) := G.finAllStates
instance (G : Game) : Fintype (∀ j, G.A j) := G.finAllActions
instance (G : Game) (i : G.ι) : Nonempty (G.Θ i) := G.stateNonempty i
instance (G : Game) (j : G.κ) : Nonempty (G.A j) := G.actionNonempty j
instance (G : Game) (i : G.ι) (j : G.κ) : Nonempty (G.Msg i j) := G.messageNonempty i j

abbrev DesignerMessage (G : Game) (i : G.ι) := ∀ j : G.κ, G.Msg i j
abbrev Message (G : Game) := ∀ i : G.ι, DesignerMessage G i
abbrev State (G : Game) := ∀ i : G.ι, G.Θ i
abbrev Action (G : Game) := ∀ j : G.κ, G.A j
abbrev PrivateMessage (G : Game) (j : G.κ) := ∀ i : G.ι, G.Msg i j

abbrev Experiment (G : Game) (i : G.ι) :=
  {x : G.Θ i → DesignerMessage G i → ℝ // ∀ θ, AGT.IsLottery (x θ)}

abbrev Profile (G : Game) := ∀ i : G.ι, Experiment G i
abbrev Outcome (G : Game) := Message G → Action G → ℝ

def IsOutcome (G : Game) (y : Outcome G) : Prop :=
  ∀ m, AGT.IsLottery (y m)

abbrev AgentStrategy (G : Game) :=
  ∀ j : G.κ, PrivateMessage G j → G.A j → ℝ

def IsAgentStrategy (G : Game) (σ : AgentStrategy G) : Prop :=
  ∀ j t, AGT.IsLottery (σ j t)

def outcomeOf (G : Game) (σ : AgentStrategy G) : Outcome G :=
  fun m a => ∏ j, σ j (fun i => m i j) (a j)

def agentPayoff (G : Game) (x : Profile G) (σ : AgentStrategy G) (j : G.κ) : ℝ :=
  ∑ θ : State G, ∑ m : Message G, ∑ a : Action G,
    G.p0 θ * (∏ i, (x i).val (θ i) (m i)) *
      outcomeOf G σ m a * G.v j a θ

noncomputable def IsBNE (G : Game) (x : Profile G) (σ : AgentStrategy G) : Prop :=
  IsAgentStrategy G σ ∧
    ∀ j (σ' : PrivateMessage G j → G.A j → ℝ),
      (∀ t, AGT.IsLottery (σ' t)) →
        agentPayoff G x (Function.update σ j σ') j ≤ agentPayoff G x σ j

noncomputable def deviceLaw : Measure (Set.Icc (0 : ℝ) 1) :=
  volume

noncomputable def EM (G : Game) (x : Profile G) : Set (Outcome G) :=
  {y | ∃ s : Set.Icc (0 : ℝ) 1 → AgentStrategy G,
    Measurable s ∧
    (∀ᵐ ω ∂deviceLaw, IsBNE G x (s ω)) ∧
    y = fun m a => ∫ ω, outcomeOf G (s ω) m a ∂deviceLaw}

def designerPayoff (G : Game) (i : G.ι) (x : Profile G) (y : Outcome G) : ℝ :=
  ∑ θ : State G, ∑ m : Message G, ∑ a : Action G,
    G.p0 θ * (∏ i', (x i').val (θ i') (m i')) * y m a * G.u i a θ

noncomputable def payoffSet (G : Game) (x : Profile G) : Set (G.ι → ℝ) :=
  (fun y i => designerPayoff G i x y) '' EM G x

def IsUHC {X Y : Type} [TopologicalSpace X] [TopologicalSpace Y]
    (F : X → Set Y) : Prop :=
  ∀ x V, IsOpen V → F x ⊆ V → ∀ᶠ x' in nhds x, F x' ⊆ V

abbrev MixedProfile (G : Game) := ∀ i : G.ι, Measure (Experiment G i)

noncomputable def mixedPayoff (G : Game) (U : Profile G → G.ι → ℝ)
    (ζ : MixedProfile G) (i : G.ι) : ℝ :=
  ∫ x, U x i ∂Measure.pi ζ

noncomputable def IsMixedNashDesigners (G : Game) (U : Profile G → G.ι → ℝ)
    (ζ : MixedProfile G) : Prop :=
  (∀ i, IsProbabilityMeasure (ζ i)) ∧
    (∀ i, Integrable (fun x => U x i) (Measure.pi ζ)) ∧
    ∀ i (ζ' : Measure (Experiment G i)),
      IsProbabilityMeasure ζ' →
        Integrable (fun x => U x i) (Measure.pi (Function.update ζ i ζ')) ∧
          mixedPayoff G U (Function.update ζ i ζ') i ≤ mixedPayoff G U ζ i

noncomputable def IsEquilibrium (G : Game) (τ : Profile G → Outcome G)
    (ζ : MixedProfile G) : Prop :=
  Measurable τ ∧
    (∀ x, τ x ∈ EM G x) ∧
    IsMixedNashDesigners G (fun x i => designerPayoff G i x (τ x)) ζ

end InfoDesignGames.Existence


