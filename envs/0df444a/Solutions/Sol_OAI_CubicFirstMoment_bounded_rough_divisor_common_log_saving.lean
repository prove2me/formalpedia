    _ ≤ (A^(2/3:ℝ)*(Z/r)^(5/3:ℝ))*(1+Real.log Z)^d :=
      mul_le_mul (mul_le_mul_of_nonneg_right houter (by positivity)) hlog
        (pow_nonneg (by linarith [Real.log_nonneg hres]) _) (by positivity)
