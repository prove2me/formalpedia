theorem solution : IsPreconnected stripDomain := by
  have preA : IsPreconnected ({s : ℂ | 0 < s.re} ∩ {s : ℂ | s.re < 1}) :=
    ((convex_halfSpace_re_gt 0).inter (convex_halfSpace_re_lt 1)).isPreconnected
  have preB : IsPreconnected ({s : ℂ | 0 < s.re} ∩ {s : ℂ | 0 < s.im}) :=
