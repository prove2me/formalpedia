theorem nmod {a b : Ex HS} {x y : ℕ} (ha : EV st B a (x : ℤ)) (hb : EV st B b (y : ℤ)) (hy : 0 < y)
    (hv : zsz ((x % y : ℕ) : ℤ) ≤ B) : EV st B (.nmod a b) ((x % y : ℕ) : ℤ) :=
  ⟨⟨ha.1, hb.1, by rw [ha.2.1]; positivity, by rw [hb.2.1]; exact_mod_cast hy⟩,
    by simp only [Ex.eval, ha.2.1, hb.2.1]; push_cast; rfl,
    ⟨ha.2.2, hb.2.2, by rw [ha.2.1, hb.2.1]; exact_mod_cast hv⟩⟩

theorem congr {st' : IState HS} {e : Ex HS} {v : ℤ} (h : EV st B e v)
    (hG : ∀ r ∈ e.regs, st.G r = st'.G r) : EV st' B e v := by
  obtain ⟨h1, h2, h3, -⟩ := Ex.congrG e hG
  exact ⟨h2.1 h.1, h1 ▸ h.2.1, (h3 B).1 h.2.2⟩

theorem encK {s : IState HS} {f g : Fin HS → List ℤ} {e : Ex HS} {v : ℤ}
    (h : EV (encK s f) B e v) (hG : ∀ r ∈ e.regs, f r = g r) : EV (encK s g) B e v :=
  h.congr fun r hr => by simp [hG r hr]

