theorem solution {j Aq Ar : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG)
    (hrb : ∀ x ∈ KG, |r x| ≤ Ar) (hAr : 0 ≤ Ar) :
    Tendsto (vfun j q r) atTop (𝓝 0) := by
  have hC0 : (0:ℝ) ≤ (3 * |j| + Aq) / 4 + Ar / 3 := by positivity
  have hupper : ∀ᶠ R in atTop,
      |vfun j q r R| ≤ |j| * ((1:ℝ) / R) ^ 2 + ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3 := by
    filter_upwards [eventually_gt_atTop (3:ℝ)] with R hR
    have hR0 : (0:ℝ) < R := by linarith
    have hR3 : (0:ℝ) < R ^ 3 := by positivity
    have hR2 : (0:ℝ) < R ^ 2 := by positivity
    have h1 := vfun_sub_j_abs_le (j := j) hqc hq hAq hr hrb hAr hR
    have hshift : |vfun j q r R - j / R ^ 2| ≤ ((3 * |j| + Aq) / 4 + Ar / 3) / R ^ 3 := by
      have h1' : R ^ 3 * |vfun j q r R - j / R ^ 2| ≤ (3 * |j| + Aq) / 4 + Ar / 3 := by
        rw [← abs_of_pos hR3, ← abs_mul]
        exact h1
      rw [le_div_iff₀ hR3, mul_comm]
      exact h1'
    have heq3 : ((3 * |j| + Aq) / 4 + Ar / 3) / R ^ 3
        = ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3 := by
      rw [one_div, inv_pow, div_eq_mul_inv]
    have heq2 : |j| / R ^ 2 = |j| * ((1:ℝ) / R) ^ 2 := by
      rw [one_div, inv_pow, div_eq_mul_inv]
    calc |vfun j q r R| = |(vfun j q r R - j / R ^ 2) + j / R ^ 2| := by ring_nf
      _ ≤ |vfun j q r R - j / R ^ 2| + |j / R ^ 2| := abs_add_le _ _
      _ ≤ ((3 * |j| + Aq) / 4 + Ar / 3) / R ^ 3 + |j| / R ^ 2 := by
          refine add_le_add hshift ?_
          rw [abs_div, abs_of_pos hR2]
      _ = |j| * ((1:ℝ) / R) ^ 2 + ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3 := by
          rw [heq3, heq2]; ring
  have hinv : Tendsto (fun R : ℝ => (1:ℝ) / R) atTop (𝓝 0) := by
    simpa [one_div] using tendsto_inv_atTop_zero (𝕜 := ℝ)
  have hlim1 : Tendsto (fun R : ℝ => |j| * ((1:ℝ) / R) ^ 2) atTop (𝓝 0) := by
    simpa using (hinv.pow 2).const_mul |j|
  have hlim2 : Tendsto (fun R : ℝ => ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3)
      atTop (𝓝 0) := by
    simpa using (hinv.pow 3).const_mul ((3 * |j| + Aq) / 4 + Ar / 3)
  have htight : Tendsto (fun R : ℝ => |j| * ((1:ℝ) / R) ^ 2
      + ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3) atTop (𝓝 0) := by
    simpa using hlim1.add hlim2
  have hneg : Tendsto (fun R : ℝ => -(|j| * ((1:ℝ) / R) ^ 2
      + ((3 * |j| + Aq) / 4 + Ar / 3) * ((1:ℝ) / R) ^ 3)) atTop (𝓝 0) := by
    simpa using htight.neg
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le' hneg htight
    (hupper.mono fun R hR => neg_le_of_abs_le hR)
    (hupper.mono fun R hR => le_of_abs_le hR)
