theorem solution {P : ℕ} {I : List NLogN.Sym} {iprog : Fin P → NLogN.IStmt NLogN.HS P} {p : NLogN.RS} {s t : NLogN.IState NLogN.HS}
    {c : ℕ} (h : NLogN.KIL.Sp p s t c) : ∃ c' ≤ c, NLogN.IRuns I iprog p.code s t c' :=
  ⟨p.cost s, h.2.2, h.2.1 ▸ NLogN.RS.code_runs p s h.1⟩
end
