  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  simp [rcontr, Fin.sum_univ_four, lR, mRe, faradayKN]
  field_simp
  ring

theorem rF_lIm (hx : x ∈ domReg M a Q) : rcontr (faradayKN a Q) x (lR M a Q x) (mIm a x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hD : Del M a Q (x 1) ≠ 0 := domReg_D hx
  have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, lR, mIm, faradayKN]
  field_simp
  ring

theorem rF_nRe (hx : x ∈ domReg M a Q) : rcontr (faradayKN a Q) x (nR M a Q x) mRe = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx
  simp [rcontr, Fin.sum_univ_four, nR, mRe, faradayKN]
  field_simp
  ring

theorem rF_nIm (hx : x ∈ domReg M a Q) : rcontr (faradayKN a Q) x (nR M a Q x) (mIm a x) = 0 := by
  have hS : Sig a (x 1) (x 2) ≠ 0 := domReg_S hx; have hs := domReg_s hx
  simp [rcontr, Fin.sum_univ_four, nR, mIm, faradayKN]
  field_simp
  ring

end RealF

/-! ### The six independent frame components -/

section Frame
variable {M a Q : ℝ} {x : Pt 4}

private theorem fanti (a Q : ℝ) (x : Pt 4) : ∀ i j, faradayKN a Q i j x = -faradayKN a Q j i x :=
  fun i j => KN.antisymm a Q x i j

theorem ccontr_faraday_self (u : Fin 4 → ℂ) : ccontr (faradayKN a Q) x u u = 0 := by
  have h := ccontr_antisymm (fanti a Q x) u u
  linear_combination h / 2

theorem faraday_ln (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knL M a Q x) (knN M a Q x) =
    ((Q * (x 1 ^ 2 - a ^ 2 * cos (x 2) ^ 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ) := by
  rw [knL_eq, knN_eq, ccontr_ofReal, rF_ln hx]

theorem faraday_lm (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knL M a Q x) (knM a x) = 0 := by
  rw [knL_eq, knM_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rF_lRe hx, rF_lIm hx]; simp

theorem faraday_lmbar (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knL M a Q x) (knMbar a x) = 0 := by
  rw [knL_eq, knMbar_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rF_lRe hx, rF_lIm hx]; simp

theorem faraday_nm (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knN M a Q x) (knM a x) = 0 := by
  rw [knN_eq, knM_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rF_nRe hx, rF_nIm hx]; simp

theorem faraday_nmbar (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knN M a Q x) (knMbar a x) = 0 := by
  rw [knN_eq, knMbar_eq, ccontr_lin_right, ccontr_ofReal, ccontr_ofReal, rF_nRe hx, rF_nIm hx]; simp

theorem faraday_nl (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knN M a Q x) (knL M a Q x) =
    -((Q * (x 1 ^ 2 - a ^ 2 * cos (x 2) ^ 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ) := by
  rw [ccontr_antisymm (fanti a Q x), faraday_ln hx]

theorem faraday_ml (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knM a x) (knL M a Q x) = 0 := by
  rw [ccontr_antisymm (fanti a Q x), faraday_lm hx, neg_zero]

theorem faraday_mn (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knM a x) (knN M a Q x) = 0 := by
  rw [ccontr_antisymm (fanti a Q x), faraday_nm hx, neg_zero]

theorem faraday_mbarl (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knMbar a x) (knL M a Q x) = 0 := by
  rw [ccontr_antisymm (fanti a Q x), faraday_lmbar hx, neg_zero]

theorem faraday_mbarn (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knMbar a x) (knN M a Q x) = 0 := by
  rw [ccontr_antisymm (fanti a Q x), faraday_nmbar hx, neg_zero]

theorem faraday_mbarm (hx : x ∈ domReg M a Q) : ccontr (faradayKN a Q) x (knMbar a x) (knM a x) =
    2 * Complex.I * ((Q * a * x 1 * cos (x 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ) := by
  rw [ccontr_antisymm (fanti a Q x), faraday_mmbar hx, neg_neg]

end Frame

/-! ### Maxwell scalars in Hintz's convention (raw contractions) -/

section Scalars
variable {M a Q : ℝ} {x : Pt 4}

end Scalars

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg7

-- ==== solution ====
open Real
open scoped ComplexConjugate Matrix
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del faradayKN domReg domReg_S domReg_D domReg_s)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable {M a Q : ℝ} {x : Pt 4}
theorem solution (hx : x ∈ domReg M a Q) (A B : Fin 4) :
    ccontr (faradayKN a Q) x (knFrame M a Q x A) (knFrame M a Q x B) =
      (!![0, ((Q * (x 1 ^ 2 - a ^ 2 * cos (x 2) ^ 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ), 0, 0;
          -((Q * (x 1 ^ 2 - a ^ 2 * cos (x 2) ^ 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ), 0, 0, 0;
          0, 0, 0, -(2 * Complex.I * ((Q * a * x 1 * cos (x 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ));
          0, 0, 2 * Complex.I * ((Q * a * x 1 * cos (x 2) / Sig a (x 1) (x 2) ^ 2 : ℝ) : ℂ), 0] :
        Matrix (Fin 4) (Fin 4) ℂ) A B := by
  fin_cases A <;> fin_cases B <;>
    simp [knFrame, ccontr_faraday_self, faraday_ln hx, faraday_lm hx, faraday_lmbar hx, faraday_nm hx,
      faraday_nmbar hx, faraday_mmbar hx, faraday_nl hx, faraday_ml hx, faraday_mn hx, faraday_mbarl hx,
      faraday_mbarn hx, faraday_mbarm hx]
