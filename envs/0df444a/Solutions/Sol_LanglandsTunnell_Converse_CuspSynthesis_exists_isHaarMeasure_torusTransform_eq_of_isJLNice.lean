  | insert v T hv ih =>
    rw [Finset.prod_insert hv, t0020, ih, t0033, one_mul]

private theorem t0044 [DecidableEq (HeightOneSpectrum (𝓞 K))]
    (f : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ)
    (T : Finset (HeightOneSpectrum (𝓞 K))) (w : HeightOneSpectrum (𝓞 K)) :
