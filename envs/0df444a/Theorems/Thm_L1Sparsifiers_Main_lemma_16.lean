-- title:
--   Lemma 16 — $t\mapsto\mathrm{Vol}_n(K\ominus Z_t)$ is separately convex
-- statement:
--   Let $K\subseteq\mathbb R^n$ be a convex body and let $Z=\sum_{j\in[m]}[-a_j,a_j]$ be the zonotope generated by vectors $a_1,\dots,a_m\in\mathbb R^n$ (any rank, zero vectors allowed). Then
--   $$f:\mathbb R^m_{\ge0}\to\mathbb R_{\ge0},\qquad f(t)=\mathrm{Vol}_n\big(K\ominus Z_t\big),$$
--   is separately convex on the whole orthant $\mathbb R^m_{\ge0}$, where $Z_t=\sum_j t_j[-a_j,a_j]$.
--
--   This is the convexity fact behind the lower bounds on the probability that a random zonotope lies inside a convex body.
--
--   Differences from the source:
--   - encoding: Lebesgue volume Vol (a value in [0,∞]) → (volume ·).toReal; reason: every set measured here is bounded, so its volume is finite and toReal is the same number
--   - encoding: generators a_1,…,a_m ∈ ℝⁿ → the rows of a matrix A ∈ ℝ^{m×n}; reason: every finite list of vectors is the row list of a matrix
-- source:
--   Victor Reis, Thomas Rothvoss, Linear-size ℓ1 sparsifiers, STOC 2027 submission #162 (October 2026; PDF SHA-256 5137e7dee3cd303bd508f90f5f42c955632af5dc2ec978d9ef575bae4ce23710), §3.2, Lemma 16, p.9

import Mathlib
import Definitions.Def_L1Sparsifiers_Main_Zonotope
import Definitions.Def_L1Sparsifiers_Main_SeparatelyConvex
import Definitions.Def_L1Sparsifiers_Main_ConvexBodyVolumes

namespace L1Sparsifiers.Main

open MeasureTheory

/-- **Lemma 16** (p.9). "Let K ⊆ ℝⁿ be a convex body and Z = ∑_{j∈[m]} [−a_j, a_j] ⊆ ℝⁿ be a
zonotope. Then f : ℝ^m_{≥0} → ℝ_{≥0} with f(t) := Volₙ(K ⊖ Z_t) is separately convex."

The generators `a_j` are the rows of an arbitrary `A ∈ ℝ^{m×n}` (any rank, zero rows allowed), and
`Z_t = ∑_j t_j [−a_j, a_j]`. Separate convexity is on the whole orthant `ℝ^m_{≥0}`. -/
theorem lemma_16 {m n : ℕ} (K : Set (Fin n → ℝ)) (hK : IsConvexBody K)
    (A : Matrix (Fin m) (Fin n) ℝ) :
    SepConvexOn (Set.Ici (0 : ℝ))
      (fun t : Fin m → ℝ => (volume (minkowskiSub K (zonotope A t))).toReal) := by sorry

end L1Sparsifiers.Main
