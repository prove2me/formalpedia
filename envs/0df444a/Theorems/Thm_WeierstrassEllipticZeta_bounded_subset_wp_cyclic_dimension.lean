-- title:
--   Dimension bound for the elliptic coordinate in the contact quotient
-- statement:
--   Fix the elliptic-extension geometry of the frontier. There is a constant $C>0$, uniform in all the following finite data.
--
--   Keep every ambient hypothesis of [bounded_subset_wp_contact_polynomial](https://prove2.me/theorems/c9f70c21-a452-4c12-aa1e-5a4861562a6d): positive integers $m,n,U$ in the stated finite-jet range; a finite set $X$ containing zero; a bihomogeneous polynomial $Q$ of bidegree $(m,n)$; the finite, nonzero normalized chart orders, at least $3U+1$ on $X+X+X$; the degree bounds on iterated chart derivatives; and both chart certificates.
--
--   For each $Y\subseteq X$ containing zero with
--
--   $$|Y|=\left\lfloor\frac{Cm n^2}{U+1}\right\rfloor+1,$$
--
--   form the regular-chart contact quotient
--
--   $$A_Y=\mathbb C[T_0,T_1,T_2,T_3]\big/\bigcap_{z\in Y\setminus\Lambda}I_{z,3U+1}.$$
--
--   Here $I_{z,3U+1}$ records vanishing along the elliptic-extension chart flow through derivative order $3U$, at the point with coordinates $(z,\wp(z),\wp'(z),\zeta(z))$. Let $x\in A_Y$ be the class of $T_1$. Then
--
--   $$2\dim_{\mathbb C}\mathbb C[x]+(U+1)\le Cn^2.$$
--
--   The dimension concerns the subalgebra generated by the elliptic coordinate, rather than the whole quotient. Finiteness and the correspondence with the least degree of a polynomial satisfying these contact conditions are proved separately. The quantitative estimate is the remaining open geometric step.
--
--   The constant, subset-size threshold, and additive $U+1$ term are exactly those of the parent. This is a derived reformulation of that frontier, not a numbered theorem quoted from the paper. A checked converse establishes equivalence with the parent using the same constant.
-- source:
--   Derived algebraic reduction for https://prove2.me/theorems/c9f70c21-a452-4c12-aa1e-5a4861562a6d. Mission context: Senthil Kumar K (2026), Algebraic independence of values of Weierstrass elliptic and zeta functions, Appendix A.2, Theorem A.3 and Proposition A.1; https://doi.org/10.1017/S001309152610145X. This is an independent canonical generator construction in the already formalized contact quotient. It connects analytic vanishing to minimal-polynomial divisibility and identifies the optimal degree with the dimension of the subalgebra generated by the elliptic coordinate. Primary Lean sources: Mathlib RingTheory/Adjoin/PowerBasis.lean, FieldTheory/Minpoly/Field.lean, RingTheory/Ideal/Quotient/Operations.lean, and Analysis/Calculus/IteratedDeriv/Lemmas.lean, revision 0df444a360eaa60ab8c11dca51a86af692955474. The new dimension estimate remains open. It is equivalent to the selected polynomial-construction frontier with the same uniform constant, not a claim that the paper zero estimate has been proved.

import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Algebra.Order.Archimedean.Real.Basic
import Mathlib.Data.Finsupp.Interval
import Mathlib.Order.Interval.Finset.Nat
import Mathlib.RingTheory.MvPolynomial.Basic
import Definitions.Def_WeierstrassEllipticZeta_InterfaceGeometry
import Mathlib.Analysis.Analytic.Polynomial
open WeierstrassEllipticZeta
open scoped Pointwise Classical Topology

theorem WeierstrassEllipticZeta.bounded_subset_wp_cyclic_dimension (G : Frontier.Geometry) :
    ∃ C : ℝ, 0 < C ∧ ∀ m n : ℕ, ∀ U : Fin ((G.B (m + 2 * n) - 2) / 3 + 1),
          1 ≤ m → 1 ≤ n → 1 ≤ (U : ℕ) → ∀ X : Finset ℂ,
          0 ∈ X → ∀ Q : MvPolynomial (Fin 7) ℂ,
            (∀ d ∈ Q.support, d 0 + d 1 = m ∧
              d 2 + d 3 + d 4 + d 5 + d 6 = n) →
            (∀ (c : Fin 2) (z : ℂ), G.S (extensionChartDenominator c) z ≠ 0 →
              let f := fun w => MvPolynomial.eval (extensionChartCoordinates G.S c w)
                (extensionChartNormalize c Q)
              ∃! k : ℕ, k < G.B (m + 2 * n) ∧
                (z ∈ X + X + X → 3 * (U : ℕ) + 1 ≤ k) ∧
                (∀ j < k, iteratedDeriv j f z = 0) ∧ iteratedDeriv k f z ≠ 0 ∧
                ∃ g : ℂ → ℂ, AnalyticAt ℂ g z ∧ g z ≠ 0 ∧
                  f =ᶠ[𝓝 z] (fun w => (w - z) ^ k * g w)) →
            (∀ (c : Fin 2) (k : ℕ),
              ((extensionChartDerivation G.L.g₂ G.L.g₃ c)^[k] (extensionChartNormalize c Q)).totalDegree ≤
                m + 2 * n + k) →
            Frontier.HasChartCertificates G m n (U : ℕ) X Q →
            ∀ Y : Finset ℂ, Y ⊆ X → 0 ∈ Y →
              Y.card = ⌊(C * (m : ℝ) * (n : ℝ) ^ 2) /
                (((U : ℕ) + 1 : ℕ) : ℝ)⌋₊ + 1 →
              let Z := Y.filter (fun z => z ∉ G.L.lattice)
              let I : Ideal (MvPolynomial (Fin 4) ℂ) :=
                ⨅ z : Z, extensionChartContactIdeal G.L.g₂ G.L.g₃ 0
                  (extensionChartCoordinates G.S 0 z.val) (3 * (U : ℕ) + 1)
              let x := Ideal.Quotient.mk I (MvPolynomial.X (1 : Fin 4))
              ((2 * Module.finrank ℂ (Algebra.adjoin ℂ ({x} : Set _)) +
                ((U : ℕ) + 1) : ℕ) : ℝ) ≤ C * (n : ℝ) ^ 2 := by sorry
