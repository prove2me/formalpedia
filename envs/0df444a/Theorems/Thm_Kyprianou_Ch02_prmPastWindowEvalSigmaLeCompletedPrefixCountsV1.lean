-- title:
--   Past-window Poisson evaluation sigma generated by completed prefix-time counts
-- statement:
--   The sigma algebra generated by evaluations of a Poisson random measure on all measurable subsets of the past time window is contained in the join of the sigma algebra of prefix-time marked counts and the sigma algebra generated by ambient measurable P-null sets. The completion term is essential: Poisson random measure axioms control exceptional sample paths only almost surely, and without completion the statement is false for null-sample modifications. Proof should use finite-intensity conull exhaustion plus pi-lambda generation on that conull set.
-- source:
--   Kyprianou (2006), Chapter 2, Lemma 2.9, natural filtration generated by Poisson counts.

import Mathlib
import Definitions.Def_KLSModular_LevyStochCalc_Poisson_RandomMeasure
import Definitions.Def_LeanLevy_Processes_LevyProcess
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch02.prmPastWindowEvalSigmaLeCompletedPrefixCountsV1
    {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (ν : Measure ℝ) [SigmaFinite ν]
    (N : LevyStochCalc.Poisson.PoissonRandomMeasure.{0, 0, 0} P ν)
    (B : Set ℝ) (hB : MeasurableSet B) (t : ℝ≥0) :
    (⨆ C ∈ {C : Set (ℝ × ℝ) |
          C ⊆ Set.Ioc (0 : ℝ) (t : ℝ) ×ˢ B ∧ MeasurableSet C},
        MeasurableSpace.comap (fun ω => N.N ω C) inferInstance) ≤
      (⨆ (u : ℝ≥0), ⨆ (_hu : u ≤ t), ⨆ (A : Set ℝ),
        ⨆ (_hA : MeasurableSet A),
          MeasurableSpace.comap
            (fun ω => N.N ω (Set.Ioc (0 : ℝ) (u : ℝ) ×ˢ A))
            inferInstance)
      ⊔ (⨆ (S : Set Ω), ⨆ (_hSm : MeasurableSet S), ⨆ (_h0 : P S = 0),
        MeasurableSpace.generateFrom {S})
    := by sorry
