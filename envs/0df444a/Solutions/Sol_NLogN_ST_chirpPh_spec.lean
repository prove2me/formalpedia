theorem tabBody_cost (M : MulSpec) (tw : RM) (p R Ctw : ℕ) (htw : TwSpec M tw p R Ctw)
    (w : IState HS) (c : ℕ) (hc : c < R) (LQ LP LM : List Item)
    (hq : w.G hQ = .int ((c : ℤ) + 1) :: LQ) (hp : w.G hPp = .int p :: LP)
