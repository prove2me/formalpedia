private theorem t0493 (S : Finset (HeightOneSpectrum (𝓞 K))) {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hμ : IsIdeleClassChar (𝓞 K) K μ) (r : Kˣ) (s : ℂ) :
    sWeight K S μ r (s + 1 / 2) *
        (((μ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) : ℂˣ) : ℂ) *
          ((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) :
                ℝ) : ℂ) ^ s) =
      1 := by
  have hnorm : ((ideleNorm K (d018 K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K)
        K) r)) : ℝ) : ℂ) ^ s *
      ((ideleNorm K (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) :
            ℝ) : ℂ) ^ s = 1 := by
    rw [← Complex.mul_cpow_ofReal_nonneg (ideleNorm_pos _).le (ideleNorm_pos _).le, ← Complex.ofReal_mul,
      ← ideleNorm_mul, t0481, _root_.CuspRealizationCT.t0001, Complex.ofReal_one,
      Complex.one_cpow]
  have hS : (∏ v : ↥S, ((Ideal.absNorm v.1.asIdeal : ℕ) : ℂ) ^
        ((((WithZero.log (Valued.v (((localOf K v.1 r : (v.1.adicCompletion K)ˣ)) : v.1.adicCompletion K))) :
              ℤ) : ℂ) * s)) =
      ((ideleNorm K (d018 K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) :
            ℝ) : ℂ) ^ s := by
    rw [t0492,
      t0491 _ _ (fun v _ => zpow_nonneg (Nat.cast_nonneg _) _) s]
    exact Finset.prod_congr rfl fun v _ => t0490 _ _ s
  unfold sWeight
  simp only [add_sub_cancel_right]
  rw [Finset.prod_mul_distrib, t0257 S hμ r, hS]
  calc _ = ((μ (stripS K S (Units.map (algebraMap K (AdeleRing (𝓞 K) K) : K →* AdeleRing (𝓞 K) K) r)) : ℂˣ) : ℂ)⁻¹ *
