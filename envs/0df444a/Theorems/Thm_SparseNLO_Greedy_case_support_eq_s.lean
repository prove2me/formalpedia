-- title:
--   §4.2.1, proof of Theorem 3.3, case ‖x*‖₀ = s — f(x*) ≤ f(x* − x*ᵢeᵢ + teⱼ) for all i ∈ I₁(x*), j, t
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), let $0<s<n$ be an integer, and let $(x^k)$ be a sequence generated by the greedy sparse-simplex method for (P). Let $x^*$ be an accumulation point of $(x^k)$ with $\|x^*\|_0=s$. Then
--   $$f(x^*)\le f(x^*-x^*_ie_i+te_j)\qquad\text{for all } i\in I_1(x^*),\ j=1,\dots,n,\ t\in\mathbb R,$$
--   that is, $f(x^*)\le\min_{t}f(x^*-x^*_ie_i+te_j)$ for all $i\in I_1(x^*)$ and all $j$.
--
--   This is the case $\|x^*\|_0=s$ of the proof of Theorem 3.3: together with feasibility of $x^*$ it is Case II of the definition of a CW-minimum.
--
--   **Formalization Note** "Accumulation point" is `MapClusterPt xstar atTop x`: every neighbourhood of $x^*$ contains $x^k$ for infinitely many $k$, which in $\mathbb R^n$ is the existence of a subsequence converging to $x^*$. Indices are $0,\dots,n-1$ and $te_i$ is `EuclideanSpace.single i t`. Assumption 1 is the paper's standing assumption.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 29, §4.2.1, proof of Theorem 3.3, case ‖x*‖₀ = s

import Definitions.Def_SparseNLO_Greedy_Method

open Filter Topology

namespace SparseNLO.Greedy

/-- §4.2.1, proof of Theorem 3.3, case `‖x*‖₀ = s` (p. 29): if `x*` is an accumulation point
of a run of the greedy sparse-simplex method and `‖x*‖₀ = s`, then
`f(x*) ≤ f(x* − x*ᵢ eᵢ + t eⱼ)` for all `i ∈ I₁(x*)`, all `j` and all `t ∈ ℝ`. -/
theorem case_support_eq_s
    {n s : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x) (hs : 0 < s) (hsn : s < n)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsGreedyRun f s x)
    (xstar : EuclideanSpace ℝ (Fin n)) (hacc : MapClusterPt xstar atTop x)
    (hstar : SparseNLO.CWOpt.l0 xstar = s) :
    ∀ i ∈ SparseNLO.CWOpt.I1 xstar, ∀ (j : Fin n) (t : ℝ),
      f xstar ≤ f (xstar - EuclideanSpace.single i (xstar i) + EuclideanSpace.single j t) := by sorry

end SparseNLO.Greedy
