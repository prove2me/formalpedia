-- title:
--   Proposition 4.14: No nonzero Euler derivation in the solvable case
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g$ be solvable and admissible, with $\mathfrak z(\mathfrak g)\subseteq[\mathfrak g,\mathfrak g]$. Every derivation $D$ that is diagonalizable with weights in $\{-1,0,1\}$ satisfies
--
--   $$D=0.$$
--
--   The center inclusion is non-strict. The theorem permits the zero Euler derivation, exactly as the printed claim excludes only nonzero ones.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 24, Proposition 4.14: No nonzero Euler derivation in the solvable case

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Derivations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Proposition 4.14, PDF p. 24. The center inclusion is non-strict and zero D is allowed. -/
theorem solvable_eulerDerivation_zero [LieAlgebra.IsSolvable G] (ha : LieAdmissible (G := G))
    (hz : LieAlgebra.center ℝ G ≤ LieAlgebra.derivedSeries ℝ G 1)
    (D : LieDerivation ℝ G G) (he : EulerLinear D.toLinearMap) : D = 0 := by sorry

end Derivations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
