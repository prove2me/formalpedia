      (cFor W (ncA p t α) (cBlock W p α)) := by
  rw [← rvL_tabsT]
  refine Rn.pushForL (C := cO) (rN := 10) (ix := 24) (S := sS) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) hB.hnc (by decide) hcO _ ?_ hv0 h10
  intro k hk v hI hx hB'
  have hLv : LV p s t α pk b v := hL.agree (fun j hj => hI j hj)
  have hc : (update (update c0 sS (rvL (segT (aTab6 p s t α pk b)) k ++ c0 sS)) cO
      [((ncA p t α : ℕ) : ℤ) - k]) cI = [] := by
    rw [update_of_ne (by decide), update_of_ne (by decide)]; exact hcI
  have h := Rn.blockB (q := k) hB hk hLv hx hB' hc
  refine (h.congr ?_).mono (fun v' ⟨h1, h2⟩ => ⟨fun j hj => ?_, ?_, h2⟩) le_rfl
  · rw [rvL_succ, update_of_ne (by decide), update_self, List.append_assoc]
    have hne : (cO : Fin HS) ≠ sS := by decide
    funext j; simp only [update_apply]; split_ifs <;> simp_all
  · have : j ∉ TB' := by
      simp only [TB, TB', List.mem_cons, List.mem_nil_iff, or_false, not_or] at hj ⊢; tauto
    rw [h1 j this, hI j hj]
  · rw [h1 24 (by decide), hx]

end J6Seg.ATab

