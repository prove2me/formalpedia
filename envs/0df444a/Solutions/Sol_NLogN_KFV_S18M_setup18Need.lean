theorem spPopAll : ∀ (L : List (Fin HS)) (G : Fin HS → List ℤ), L.Nodup →
    (∀ i ∈ L, i.val < 56 ∧ (G i).length = 1 ∧ ∀ a ∈ G i, |a| ≤ (A : ℤ)) →
    Sp (popAll L) (encK s G) (encK s (fun j => if j ∈ L then [] else G j))
      ((L.length + 1) * U B)
  | [], G, _, _ => by
    refine Sp.congr (Sp.mono (Sp.skip _) ?_) ?_
    · have := U_ge B; simp only [List.length_nil]; omega
    · congr 1
  | i :: L, G, hnd, hG => by
    obtain ⟨hi, hlen, hab⟩ := hG i (by simp +decide)
    obtain ⟨a, ha⟩ : ∃ a, G i = [a] := by
      rcases h : G i with _ | ⟨a, _ | ⟨b, l⟩⟩
      · rw [h] at hlen; simp at hlen
      · exact ⟨a, rfl⟩
      · rw [h] at hlen; simp at hlen
    have hnd' := List.nodup_cons.1 hnd
    have h1 := spPop s hA hAB G hi ha (hab a (by simp +decide [ha]))
    have h2 := spPopAll L (update G i []) hnd'.2 (by
      intro j hj
      have hji : j ≠ i := fun e => hnd'.1 (e ▸ hj)
      obtain ⟨q1, q2, q3⟩ := hG j (by simp +decide [hj])
      exact ⟨q1, by simp +decide [hji, q2], by simpa [hji] using q3⟩)
    refine Sp.congr (Sp.mono (Sp.seq h1 h2) (le_of_eq (by simp only [List.length_cons]; ring)))
      ?_
    congr 1; funext j
    by_cases hj : j = i
    · subst hj; simp
    · by_cases hm : j ∈ L <;> simp +decide [hj, hm]

