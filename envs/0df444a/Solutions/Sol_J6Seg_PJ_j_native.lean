  Nat.findGreatest_spec (Nat.zero_le i) cutP_zero

lemma not_cut_of_lt_en {c k : ℕ} (hk : k < enF s t lam c) :
    ¬ cutP s t lam (c + 1 + k) ∧ c + 1 + k < s := by
  have := Nat.find_min (enF_ex s t lam c) hk
  push Not at this
  exact ⟨this.1, this.2⟩

lemma en_ge {c i : ℕ} (hci : c ≤ i) (hi : i < s)
    (hnc : ∀ j, c < j → j ≤ i → ¬ cutP s t lam j) : i - c ≤ enF s t lam c := by
  by_contra h
  push Not at h
  have := Nat.find_spec (enF_ex s t lam c)
  rcases this with h1 | h1
  · exact hnc _ (by omega) (by unfold enF at h; omega) h1
  · unfold enF at h; omega

lemma en_le_s {c : ℕ} (hc : c < s) : c + 1 + enF s t lam c ≤ s := by
  have := Nat.find_min' (enF_ex s t lam c) (show cutP s t lam (c + 1 + (s - c - 1)) ∨
    s ≤ c + 1 + (s - c - 1) from Or.inr (by omega))
  unfold enF; omega

lemma en_le_lam (hl : 1 ≤ lam) (c : ℕ) : enF s t lam c ≤ lam - 1 := by
  have hm : (c + 1 + (lam - c % lam - 1)) % lam = 0 := by
    have h1 : c % lam < lam := Nat.mod_lt _ (by omega)
    have h2 : c + 1 + (lam - c % lam - 1) = lam * (c / lam + 1) := by
      have := Nat.div_add_mod c lam
      rw [Nat.mul_add, mul_one]; omega
    rw [h2, Nat.mul_mod_right]
  have := Nat.find_min' (enF_ex s t lam c) (Or.inl (Or.inr (Or.inl hm)))
  unfold enF; omega

/-- **The constructed blocks are valid.** -/
theorem mkBlocks_ok (hs : 0 < s) (w : ℕ) (hw : w ≤ s) : BlocksOK s t (mkBlocks s t lam w) := by
  have hstart : ∀ i, i < s → ∀ j, stF s t lam i < j → j ≤ i → ¬ cutP s t lam j :=
    fun i _ j h1 h2 => Nat.findGreatest_is_greatest h1 h2
  have hcov : ∀ i < s, stF s t lam i ≤ i ∧ i < stF s t lam i + (1 + enF s t lam (stF s t lam i)) ∧
      stF s t lam i + (1 + enF s t lam (stF s t lam i)) ≤ s := by
    intro i hi
    have h1 := stF_le (s := s) (t := t) (lam := lam) i
    have h2 := en_ge h1 hi (hstart i hi)
    have h3 := en_le_s (s := s) (t := t) (lam := lam) (show stF s t lam i < s by omega)
    refine ⟨h1, by omega, by omega⟩
  refine ⟨rfl, hcov, ?_, ?_, hw⟩
  · intro i hi k hk1 hk2
    simp only [mkBlocks] at hk1 hk2 ⊢
    set c := stF s t lam i
    have hsk : stF s t lam k = c := by
      unfold stF
      rw [Nat.findGreatest_eq_iff]
      refine ⟨hk1, fun _ => stF_cut i, fun j hj hjk hcj => ?_⟩
      have := (not_cut_of_lt_en (s := s) (t := t) (lam := lam) (c := c) (k := j - c - 1)
        (by omega)).1
      rw [show c + 1 + (j - c - 1) = j by omega] at this
      exact this hcj
    exact ⟨hsk, by rw [hsk]⟩
  · intro i hi j hj
    simp only [mkBlocks] at hj ⊢
    set c := stF s t lam i
    have h := (not_cut_of_lt_en (s := s) (t := t) (lam := lam) (c := c) (k := j) (by omega)).1
    unfold cutP at h
    push Not at h
    have h2 := h.2.2
    rw [show c + 1 + j - 1 = c + j by omega] at h2
    unfold stepOK at h2
    have e1 : ((c : ℤ) + j + 1) = ((c + j : ℕ) : ℤ) + 1 := by push_cast; ring
    have e2 : ((c : ℤ) + j) = ((c + j : ℕ) : ℤ) := by push_cast; ring
    rw [e1, e2]; exact h2

theorem mkBlocks_len (hl : 1 ≤ lam) (w i : ℕ) : (mkBlocks s t lam w).len i ≤ lam := by
  simp only [mkBlocks]
  have := en_le_lam (s := s) (t := t) hl (stF s t lam i)
  omega

lemma Jlist_length_le (B : Blocks) : (Jlist B).length ≤ B.s := by
  unfold Jlist
  exact (List.length_filter_le _ _).trans (by simp)

end part

end J6Seg

end

section
-- Source module: Solutions.J6SegTab
/-!
# Segmented inverse (S2): construction of the constant tables

`mkTables P R s t α` (computable) fills the tables of `J6SegAlg` with
* `di u = expNeg P s (α²(t-s)u²)` (`≈ 2^P e^{-πα²θu²}`),
* `dd u = expPos (P+R) s (α²(t-s)u²) R` (`≈ 2^P e^{πα²θu²}`, needs `e^{πα²θu²} ≤ 2^R`),
* `gam`: `(q;q)_u` by the recurrence `Γ_{u+1} = Γ_u (1 - q^{u+1})` (`q^k` by `expNeg`),
* `gi u = 2^P / Γ_u` (`fdiv`), `ap/am c h = (-1)^h e^{-πα²(σ ± 2β_c)h} / Γ_h`,
* `cpl i h = expNeg P s² (α² K_{i,h})` (the entries of `E`, as in `Eapprox`).

`mkTables_ok`: `TabOK` with `E = 3λ + 3` and `Dm = D_{λ-1}`, for blocks of length `≤ λ`, as soon as
`200 (3λ+1) ≤ 2^P` and `D_{λ-1} ≤ 2^R`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section tab
variable {P R s t α : ℕ}

lemma expNeg_err (hk : 0 < s) (j : ℕ) {x : ℝ} (hx : x = π * j / s) :
    |(expNeg P s j : ℝ) - 2 ^ P * exp (-x)| ≤ 1 := by
  rw [hx]; exact expNeg_bound P s j hk

lemma sigma_ge (hs : 0 < s) (hst : s ≤ t) : 1 ≤ (t : ℝ) / s := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst

end tab

end J6Seg

end

section
-- Source module: Solutions.J6SegBand
/-!
# Segmented inverse (S2): sparse (banded + border) elimination

`geSolveS P S L A b` is the elimination of `geSolve` restricted to a pattern `S`: the Schur
update of `(i, k)` is performed only when `S i j ∧ S j k`, the right-hand side update only when
`S i j`, and the back substitution sums only over `S j k`.

`geSolveS_eq`: if `A` vanishes off `S` on `L × L`, `S` is closed under elimination in the order of
`L` (`PatOK`: `S i j → S j k → S i k` for `i, k` after the pivot `j`), and the hypotheses of
`geSolve_resid` hold (row deviation `η`, `η + |L|²/2^P ≤ 1/2`, so every pivot is positive), then
`geSolveS = geSolve`. Hence the error theorems of `geSolve` hold verbatim for the sparse version.

`bandS m c a b`: `|a - b| ≤ m` or `a ≥ c` or `b ≥ c` (band plus a border at the end, the
cyclic block-tridiagonal shape); `PatOK` holds for it along any increasing list (`bandS_patOK`).
-/

open Finset

namespace J6Seg

section band
variable (P : ℕ)

theorem bandS_patOK (m c : ℕ) : ∀ L : List ℕ, L.Pairwise (· < ·) → PatOK (bandS m c) L := by
  intro L
  induction L with
  | nil => intro _; trivial
  | cons j L ih =>
    intro hL
    rw [List.pairwise_cons] at hL
    refine ⟨fun i hi k hk h1 h2 => ?_, ih hL.2⟩
    have hi' := hL.1 i hi
    have hk' := hL.1 k hk
    unfold bandS at h1 h2 ⊢
    omega

end band

end J6Seg

end

section
-- Source module: Solutions.J6SegSparse
/-!
# Segmented inverse (S2): the sparse algorithm

`segInvS P lam T B U` is `segInv` with the capacitance solved by `geSolveS` on the pattern
`bandS (λ + w) (s - λ - w)`: a band of half-width `λ + w` (blocks of length `≤ λ`, coupling width
`w`) plus the border of positions `≥ s - λ - w` (the cyclic wrap). Per row of the capacitance
at most `2(λ+w)+1` band entries plus the border are touched.

* `capI_band`: the capacitance vanishes off the pattern;
* `segInvS_eq`: under the hypotheses of `segInv_err`, `segInvS = segInv`;
* `segInvFullS_err`: the fully instantiated sparse algorithm satisfies the bound of
  `segInvFull_err`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section sp
variable {P s t α lam : ℕ} {B : Blocks} {T : Tables}

lemma Jlist_pairwise (B : Blocks) : (Jlist B).Pairwise (· < ·) :=
  (List.pairwise_lt_range).filter _

/-- The capacitance vanishes off the band-plus-border pattern. -/
theorem capI_band (hB : BlocksOK s t B) (hs : 0 < s) (hlam : ∀ i < s, B.len i ≤ lam)
    {a b : ℕ} (ha : a < s) (hnb : ¬ bandS (lam + B.w) (B.s - lam - B.w) a b) :
    capI P T B a b = 0 := by
  have hbs := hB.hs
  have hw := hB.hw
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha
  have hla := hlam a ha
  unfold bandS at hnb
  rw [hbs] at hnb
  unfold capI
  have hab : a ≠ b := by intro h; subst h; exact hnb (Or.inl ⟨by omega, by omega⟩)
  rw [if_neg hab, zero_add]
  refine sum_eq_zero fun i hi => sum_eq_zero fun h hh => ?_
  rw [mem_Ico] at hi
  obtain ⟨hw1, hw2, _, _⟩ := mem_Hset hh
  rw [if_neg]
  intro hcol
  unfold col at hcol
  rw [hbs] at hcol
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : (((((i : ℤ) + h) % s).toNat : ℕ) : ℤ) = ((i : ℤ) + h) % s :=
    Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  rw [hcol] at hjv
  omega

end sp

end J6Seg

end

section
-- Source module: Solutions.J6SegLn3
/-!
# Segmented inverse (S2), machine side 3: the sparse elimination in closed form

For the elimination `geSolveS P S L A b` along `L = [l₀, l₁, …]` (no repetitions), with the
matrices `Aseq L A r` and right-hand sides `bseq L A b r` after `r` pivots:

* **`bseq_closed`**: `bseq r i = b i − ∑_{q < r, S i l_q} fmul (F_q i) (bt q)` where
  `F_q i = fdiv (A_q i l_q) (A_q l_q l_q)` and `bt q = bseq q l_q` (forward substitution: every
  pivot step subtracts one rounded term);
* **`geSolveS_closed`**: `z l_r = fdiv (bt r − ∑_{k ∈ tail, S l_r k} fmul (A_r l_r k) (z k)) (A_r l_r l_r)`
  (back substitution with the final values `z`);
* `geSolveS_off`: `z k = 0` off `L`.

Everything data-independent (`A_q`, hence all multipliers and pivots) can be precomputed; the
data enter only through `bt` and `z`.
-/

open Finset

namespace J6Seg

section closed
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

lemma Aseq_zero (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) : Aseq P S (j :: L) A 0 = A := rfl
lemma Aseq_succ (j : ℕ) (L : List ℕ) (A : ℕ → ℕ → ℤ) (q : ℕ) :
    Aseq P S (j :: L) A (q + 1) = Aseq P S L (stepA P S j A) q := rfl

end closed

end J6Seg

end

