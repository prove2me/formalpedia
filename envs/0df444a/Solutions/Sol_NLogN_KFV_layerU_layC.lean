/-- **A prefix round, uniform.** -/
theorem layerU_pre (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h p W B : ℕ} (hh : h < bb ℓ K) (hW : p + 1 ≤ W)
    (hB : bL D ℓ K long ≤ B) :
    LayerU (r := 2 ^ ℓ) I iprog (RCtx (pLP D ℓ K long) (flOf D long) h) (fcode preC)
      (layerQc p (paperSel D ℓ K long hK hℓ h)) (2 ^ NLogN.KFV.nB D ℓ K long) p W
      (cLeafR (ePre.size + (Ex.reg NLogN.KFV.gD : Ex HS).size + eSpre.size) (NLogN.KFV.preP D ℓ K long h) D
        (sufP D ℓ K long h) ℓ W B) := by
  intro s hs zs l xs hx hl hb hd
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hpb := pre_bounds D ℓ K long hK hℓ hh
  have hLst := length_lstL_le_tgt D ℓ K long
