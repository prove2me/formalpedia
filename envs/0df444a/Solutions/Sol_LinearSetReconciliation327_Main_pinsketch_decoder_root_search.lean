    Sem.boundary_block P E _ (copyMetaCode 75 97) m m1 hCopySourceAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 75 97 src (by omega) (by omega) hSrcWord hm75)
  have hCopyBase : Sem P E (pc + 22) (pc + 44) (boundaryState (pc + 22) m1)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 44) m2) :=
    Sem.boundary_block P E _ (copyMetaCode 83 84) m1 m2 hCopyBaseAt
      (by simp [copyMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (copyMeta_spec E _ 83 84 Q0 (by omega) (by omega) hQ0Word (by simpa [boundaryState, m1] using hm83))
  have hZero : Sem P E (pc + 44) (pc + 64) (boundaryState (pc + 44) m2)
      (fun k z => k ≤ 20 ∧ z = boundaryState (pc + 64) m3) :=
    Sem.boundary_block P E _ (setMetaCode 90 0) m2 m3 hZeroAt
      (by simp [setMetaCode, metaStoreCode, zeroRegsCode]) (setMeta_spec E _ 90 0 (by omega) (by omega))
  have hfactor3 := ((hf.meta_update hsrc 97 src (by norm_num)).meta_update hsrc 84 Q0 (by norm_num)).meta_update hsrc 90 0 (by norm_num)
  have hKeep := queueKeepProcedure_spec b P E (pc + 64) Q0 src cap t [] σ m3 hKeepAt
    (by omega) hwe hcap hQ0 hsrc hQword hSword (by intro _; simp only [List.length_nil]; omega) hdisj
    (by intro j hj; simp at hj) hfactor3 hdeg (by simp [m3, m2]) (by simp [m3])
    (by simpa [m3, m2, m1] using hm81) (by simp [m3, m2, m1])
  obtain ⟨_, k4, z4, hRun4, hPc4, hCost4, hRegs4, hCount4, hQueue4, hf34raw⟩ := hKeep
  let m4 := z4.mem
  have hz4 : z4 = boundaryState (pc + 273) m4 := by
    apply ramState_eq_of
    · exact hPc4
    · rfl
    · intro r; exact congrFun hRegs4 r
  have hf34 : MemoryFrame (rootSeedWritable Q0 cap t) m3 m4 := hf34raw.mono (by
    intro addr ha
    have hh := queue_keep_writable_le_whole Q0 t cap 0 σ.natDegree addr (by intro _; omega) ha
    dsimp [wholeQueueWritable] at hh
