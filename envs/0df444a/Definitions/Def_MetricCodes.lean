        rowPairingPolynomial (n := n) i j *
          traceOperator r n i j p := by
      simp only [rowPairingPolynomial, traceOperator_apply,
        Finset.sum_mul, Finset.mul_sum, mul_assoc]
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.sum_comm]
end
