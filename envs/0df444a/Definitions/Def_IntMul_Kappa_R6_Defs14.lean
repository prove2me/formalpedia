section
-- Source module: Solutions.KIL6Pad
/-!
# KIL6: one-field padding and extraction as IL loops

* `padP`: on stack `0` an array `xs` of `X · (F · Y)` entries (`[X, F, Y]`, row-major); it
  produces `padL X F F' Y 0 xs` (every block of `F · Y` entries followed by `(F' - F) · Y`
  zeros).  Per block: move `F · Y` entries to the buffer stack `15` (`mvK`), push the zeros;
  finally move everything back (the two reversals cancel).
* `unpadP`: the inverse scan `unpadL X F F' Y` (move `F · Y`, drop `(F' - F) · Y`).

The four counts are read from the parameter registers `16 … 19` (pushed by the caller); the
loop counters are `20`, `21`.  Both cost `O((V' + 1)(Bb + 2))`, `V'` the padded volume
(`padP_sp`, `unpadP_sp`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

/-! ## Loops with register counts -/

theorem Sp.dropR {X C r : Fin HS} (hXC : X ≠ C) (hX5 : X.val < 56) (hC5 : C.val < 56)
    (hr5 : r.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L l : List ℤ)
    (hfX : f X = L ++ l) (hfC : f C = []) {Lr : List Item}
    (hr : (encK s f).G r = .int (L.length : ℤ) :: Lr) (Bb : ℕ) (hL : Bnd Bb L)
    (hn : zsz (L.length : ℤ) ≤ Bb) :
    Sp (dropKE X C (.reg r)) (encK s f) (encK s (Function.update f X l)) (cDropR L.length Bb) := by
  have e00 : Function.update f X (L.drop 0 ++ l) = f := by
    rw [List.drop_zero, ← hfX, Function.update_eq_self]
  have H := Sp.rep (C := C) (n := .reg r) (s := s)
    (F := fun k => Function.update f X (L.drop k ++ l)) (N := L.length) (B := Bb)
    (c := 2 * Bb + 2) (b := .pop X) hC5
    (fun k => by simp [Function.update_apply, hXC.symm, hfC])
    (by simp [RS.writes, hXC.symm]) (clean_reg_r6c hr5)
    (by simp only [e00]; exact IState.isInt_of_r6c hr) trivial
    (by simp only [e00, Ex.Bnd]; rw [IState.top_eq_r6c hr]; exact hn)
