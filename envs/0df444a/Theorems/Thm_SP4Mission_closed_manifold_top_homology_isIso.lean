theorem SP4Mission.closed_manifold_top_homology_isIso (n : ℕ) (M : Type) [TopologicalSpace M]
    [T2Space M] [CompactSpace M] [SimplyConnectedSpace M]
    [ChartedSpace (EuclideanSpace ℝ (Fin n)) M] (p : M) :
