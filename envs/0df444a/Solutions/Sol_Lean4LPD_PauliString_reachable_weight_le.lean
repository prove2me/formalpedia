open Lean4LPD
open Lean4LPD.PauliString
variable {n kh : ℕ} {G H p q : PauliString n} {L : List (PauliString n)} {S T : Finset (Fin n)}
namespace Lean4LPD.PauliString
theorem _root_.solution : ∀ {Ls : List (List (PauliString n))},
    (∀ L ∈ Ls, IsLayer kh L) → 1 ≤ kh →
    ∀ {p q : PauliString n}, q ∈ reachable Ls p → weight q ≤ kh ^ Ls.length * weight p := by
  intro Ls
  induction Ls with
  | nil =>
    intro _ _ p q hq
    rw [reachable_nil, Finset.mem_singleton] at hq
    subst hq
    simp
  | cons L Ls ih =>
    intro hLs hkh p q hq
    rw [reachable_cons, Finset.mem_biUnion] at hq
    obtain ⟨p', hp', hq'⟩ := hq
    have hstep : weight p' ≤ kh * weight p :=
      layer_weight_le (hLs L List.mem_cons_self) hkh hp'
    have hrest : weight q ≤ kh ^ Ls.length * weight p' :=
      ih (fun M hM => hLs M (List.mem_cons_of_mem _ hM)) hkh hq'
    calc weight q ≤ kh ^ Ls.length * weight p' := hrest
      _ ≤ kh ^ Ls.length * (kh * weight p) := Nat.mul_le_mul_left _ hstep
      _ = kh ^ (L :: Ls).length * weight p := by
          rw [List.length_cons, pow_succ]; ring
end Lean4LPD.PauliString
