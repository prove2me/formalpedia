variable {𝒰 : Type*} [Ring 𝒰] [Algebra ℂ 𝒰] {n : ℕ} (E : Fin n → Fin n → 𝒰)

theorem ReciprocityTheory.ChartRestriction.DS.Lap.Capelli.cminor_succ_col {p : ℕ} (R C : Fin (p + 1) → Fin n) (x : ℂ) :
    cminor E R C x = ∑ i : Fin (p + 1), ((-1 : ℂ) ^ (i : ℕ)) •
      (capEntry E x (R i) (C 0) * cminor E (R ∘ i.succAbove) (C ∘ Fin.succ) (x - 1)) := by sorry
