theorem cPT_lt {T : ℕ} (hT : T < NV) : cPT T < 38286 := by simp only [cPT, NV, Nat.add_eq] at *; omega

theorem ndc : ∀ n < 36513, cND n < 38286 := fun n hn => cND_lt hn

theorem WF_segW1 : ∀ j, j ≤ 10 → WFw (segW1 j) := by
