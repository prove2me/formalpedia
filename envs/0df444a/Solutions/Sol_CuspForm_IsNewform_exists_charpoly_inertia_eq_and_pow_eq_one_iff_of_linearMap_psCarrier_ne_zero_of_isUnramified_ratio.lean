    · intro ℓ hℓ hℓS₁
      rw [Finset.mem_coe] at hℓS₁
      have h4 : ℓ ∉ S ∪ S' ∪ M.primeFactors ∪ M'.primeFactors := fun h' => hℓS₁ (Finset.mem_union_left _ h')
      have h3 : ℓ ∉ S ∪ S' ∪ M.primeFactors := fun h' => h4 (Finset.mem_union_left _ h')
      have h2 : ℓ ∉ S ∪ S' := fun h' => h3 (Finset.mem_union_left _ h')
      have hS : ℓ ∉ S := fun h' => h2 (Finset.mem_union_left _ h')
      have hS' : ℓ ∉ S' := fun h' => h2 (Finset.mem_union_right _ h')
