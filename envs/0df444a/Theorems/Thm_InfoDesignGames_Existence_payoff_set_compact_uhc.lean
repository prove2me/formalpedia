-- title:
--   Proof of Theorem 1, p. 7 — compact convex upper hemicontinuous payoff correspondence
-- statement:
--   For each experiment profile $x$, let $\mathcal U(x)=\{(U_i(x,y))_{i\in N}:y\in E_M(x)\}$ be the set of designer payoff vectors generated by agent equilibrium outcomes. For every finite information design game,
--
--   $$\forall x,\quad\mathcal U(x)\text{ is compact and convex},\qquad\mathcal U:X\rightrightarrows\mathbb R^N\text{ is upper hemicontinuous}.$$
--
--   This is the payoff correspondence to which the paper applies its equilibrium-selection result.
--
--   **Formalization Note** The payoff vector is computed from the game's prior, experiment likelihoods, outcome law, and designer utility. No payoff vector independent of these data is quantified.
-- source:
--   Koessler, Laclau & Tomala, Interactive Information Design, SSRN working paper 3171992 (version of April 25, 2018), https://ssrn.com/abstract=3171992, p. 7, proof of Theorem 1

import Definitions.Def_InfoDesignGames_Existence_Model

namespace InfoDesignGames.Existence

theorem payoff_set_compact_uhc (G : Game) :
    (∀ x : Profile G, IsCompact (payoffSet G x) ∧ Convex ℝ (payoffSet G x)) ∧
      IsUHC (payoffSet G) := by sorry

end InfoDesignGames.Existence
