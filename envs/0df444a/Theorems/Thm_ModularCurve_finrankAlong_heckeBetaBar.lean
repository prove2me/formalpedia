open ModularCurve

theorem ModularCurve.finrankAlong_heckeBetaBar (L : Type*) [Field L] [Algebra ℚ L] (A : ℕ) [NeZero A] (ℓ : ℕ) [hl : Fact (Nat.Prime ℓ)] : AlgebraicCurve.finrankAlong L (heckeBetaBar L A ℓ) = if ℓ ∣ A then ℓ else ℓ + 1 := by sorry
