theorem ModularCurve.FullLevel.exists_mem_Gamma0_redQ_eq_of_snd_eq_one (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (hqM' : ¬ q ∣ M') (h : ↥(DrinfeldCurve.hSubgroup q))
    (hh : ((h : Matrix.GeneralLinearGroup (Fin 2) (ZMod q) × (GaloisField q 2)ˣ).2 = 1)) :
    ∃ γ : Matrix.SpecialLinearGroup (Fin 2) ℤ, γ ∈ CongruenceSubgroup.Gamma0 M' ∧
      ModularCurve.FullLevel.redQ q γ = (h : Matrix.GeneralLinearGroup (Fin 2) (ZMod q) × (GaloisField q 2)ˣ).1 := by
  obtain ⟨⟨g, α⟩, hmem⟩ := h
  change α = 1 at hh
  subst hh
  have hdet : (g : Matrix (Fin 2) (Fin 2) (ZMod q)).det = 1 := by
    have h1 := (DrinfeldCurve.mem_hSubgroup_iff q _).mp hmem
    have h2 := congrArg (fun u : (GaloisField q 2)ˣ => (u : GaloisField q 2)) h1
    simp only [DrinfeldCurve.coe_hChar_apply, Units.val_one, one_pow, mul_one] at h2
    exact (algebraMap (ZMod q) (GaloisField q 2)).injective (h2.trans (map_one _).symm)
  obtain ⟨γ, hγ, hmap⟩ :=
    (CongruenceSubgroup.exists_mem_Gamma_map_eq_of_not_dvd M' q hqM').1 ⟨(g : Matrix (Fin 2) (Fin 2) (ZMod q)), hdet⟩
  refine ⟨γ, ?_, ?_⟩
  · rw [CongruenceSubgroup.Gamma0_mem]
    exact (CongruenceSubgroup.Gamma_mem.mp hγ).2.2.1
  · change Matrix.SpecialLinearGroup.toGL (Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod q)) γ) = g
    rw [hmap]
    exact Units.ext rfl

