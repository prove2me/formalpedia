/-! ## Coordinate tensors -/

theorem MIPStarRE.QPBT.inner_vecTensor {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    [DecidableEq κ] (u x : EuclideanSpace ℂ ι) (v y : EuclideanSpace ℂ κ) :
    inner ℂ (_root_.MIPStarRE.QPBT.vecTensor u v) (_root_.MIPStarRE.QPBT.vecTensor x y) = inner ℂ u x * inner ℂ v y := by sorry
