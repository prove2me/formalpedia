    (by simp [t4, t3, t2, t1, t0, IState.upd_G]) (by simp [t4, t3, t2, t1, t0, IState.upd_G])
  set t5 := t4.upd 0 (ints ys ++ R)
  have S5 : Sp p t4 t5 _ := ⟨R5.1, R5.2.1, R5.2.2⟩
  have S6 := Sp.popI t5 (i := 1) (by decide) (a := ((1 : ℕ) : ℤ)) (L := t.G 1)
