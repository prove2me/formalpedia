-- title:
--   Trace regression model (1.1), the form ⟨·,·⟩_{L₂(Π)}, the matrix M (2.2) and the estimator (1.5)–(1.6)
-- statement:
--   This file fixes the statistical setting of Koltchinskii, Lounici and Tsybakov.
--
--   Let $(\Omega, \mathcal F, \mathbb P)$ be a probability space and let $n \ge 1$, $m_1$, $m_2$ be integers. The data are $n$ pairs $(X_i, Y_i)$, $i = 1, \dots, n$, where each $X_i$ is a random $m_1 \times m_2$ real matrix and each $Y_i$ is a real random variable. For matrices $A, B \in \mathbb R^{m_1 \times m_2}$ write $\langle A, B\rangle = \operatorname{tr}(A^\top B)$. The pairs satisfy the **trace regression model**
--   $$
--   \mathbb E(Y_i \mid X_i) = \operatorname{tr}(X_i^\top A_0), \qquad i = 1, \dots, n,
--   $$
--   for an unknown matrix $A_0 \in \mathbb R^{m_1 \times m_2}$.
--
--   The objects built from the data are:
--
--   1. the bilinear form and semi-norm
--   $$
--   \langle A, B\rangle_{L_2(\Pi)} = \frac1n \sum_{i=1}^n \mathbb E\big(\langle A, X_i\rangle\langle B, X_i\rangle\big), \qquad \|A\|_{L_2(\Pi)}^2 = \frac1n\sum_{i=1}^n \mathbb E\big(\langle A, X_i\rangle^2\big),
--   $$
--   where $\Pi = \frac1n\sum_i \Pi_i$ and $\Pi_i$ is the law of $X_i$;
--   2. the random matrix
--   $$
--   \mathbf M = \frac1n \sum_{i=1}^n \big(Y_i X_i - \mathbb E(Y_i X_i)\big);
--   $$
--   3. for $\lambda > 0$, the penalized functional
--   $$
--   L_n(A) = \|A\|_{L_2(\Pi)}^2 - \Big\langle \frac2n \sum_{i=1}^n Y_i X_i, A \Big\rangle + \lambda \|A\|_1,
--   $$
--   where $\|A\|_1$ is the nuclear norm (the sum of the singular values);
--   4. the estimator $\hat A^\lambda \in \operatorname{argmin}_{A \in \mathbb A} L_n(A)$ over a set $\mathbb A$ of matrices: any matrix of $\mathbb A$ that minimizes $L_n$ over $\mathbb A$.
--
--   These are the objects in which every statement of this mission is written.
--
--   **Formalization Note** The sample is indexed by `Fin n`. Expectations of matrices are taken entrywise. The functional $L_n$, the matrix $\mathbf M$ and the estimator are defined at a fixed outcome $\omega$, because the theorems of the mission hold realization by realization. The structure `TraceRegression` collects the standing assumptions: $X_i$ and $Y_i$ are measurable, the entries of $X_i$ are square integrable (so that $\|\cdot\|_{L_2(\Pi)}$ is finite and not a junk value), $Y_i$ and the entries of $Y_iX_i$ are integrable (so that $\mathbb E(Y_i\mid X_i)$ and $\mathbb E(Y_iX_i)$ exist), and $\mathbb E(Y_i \mid \sigma(X_i)) = \langle X_i, A_0\rangle$ almost surely, with $\sigma(X_i)$ the σ-algebra generated by the entries of $X_i$. The page states these integrability conditions only implicitly. Independence of the pairs, assumed on p. 1, is not part of the structure: Theorem 2 and its proof do not use it, so omitting it makes the statements stronger.
-- source:
--   Koltchinskii, Lounici, Tsybakov, Nuclear-Norm Penalization and Optimal Rates for Noisy Low-Rank Matrix Completion, arXiv:1011.6256v4, p. 1 (1.1), p. 2 (⟨·,·⟩_{L₂(Π)}), p. 4 (1.5)–(1.6), p. 6 (2.2)

import Mathlib
import Definitions.Def_matrix_completion_tangent
import Definitions.Def_KLTNuclear_Oracle_Model

namespace KLTNuclear.RestrictedEigen

open MeasureTheory MatrixCompletion

/-! Trace regression model of Koltchinskii, Lounici and Tsybakov,
*Nuclear-Norm Penalization and Optimal Rates for Noisy Low-Rank Matrix Completion*,
arXiv:1011.6256v4, (1.1) p. 1, the bilinear form ⟨·,·⟩_{L₂(Π)} p. 2, the estimator
(1.5)–(1.6) p. 4 and the random matrix **M** (2.2) p. 6.

The sample is `n` pairs `(X i, Y i)` of random variables on a probability space
`(Ω, P)`: `X i : Ω → ℝ^{m₁×m₂}` and `Y i : Ω → ℝ`, `i : Fin n`. -/

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The matrix 𝔼(Yᵢ Xᵢ), expectation taken entrywise. -/
noncomputable def expYX (P : Measure Ω) {n m₁ m₂ : ℕ} (X : Fin n → Ω → RealMatrix m₁ m₂)
    (Y : Fin n → Ω → ℝ) (i : Fin n) : RealMatrix m₁ m₂ :=
  fun j k => ∫ ω, Y i ω * X i ω j k ∂P

/-- The penalized empirical functional (1.6) at the outcome `ω`:
L_n(A) = ‖A‖²_{L₂(Π)} − ⟨(2/n) Σᵢ Yᵢ Xᵢ, A⟩ + λ‖A‖₁. -/
noncomputable def Ln (P : Measure Ω) {n m₁ m₂ : ℕ} (X : Fin n → Ω → RealMatrix m₁ m₂)
    (Y : Fin n → Ω → ℝ) (lam : ℝ) (ω : Ω) (A : RealMatrix m₁ m₂) : ℝ :=
  KLTNuclear.Oracle.l2NormSq P X A - matrixInner ((2 / (n : ℝ)) • ∑ i, Y i ω • X i ω) A + lam * nuclearNorm A

/-- `Ahat` is an estimator Â^λ of (1.5) at the outcome `ω`: a minimizer of `L_n` over the
set `𝔸` (any minimizer; the paper's argmin). -/
def IsEstimator (P : Measure Ω) {n m₁ m₂ : ℕ} (X : Fin n → Ω → RealMatrix m₁ m₂)
    (Y : Fin n → Ω → ℝ) (𝔸 : Set (RealMatrix m₁ m₂)) (lam : ℝ) (ω : Ω)
    (Ahat : RealMatrix m₁ m₂) : Prop :=
  Ahat ∈ 𝔸 ∧ ∀ A ∈ 𝔸, Ln P X Y lam ω Ahat ≤ Ln P X Y lam ω A

/-- The σ-algebra σ(Xᵢ) generated by the entries of the random matrix `X i`. -/
abbrev sigmaX {n m₁ m₂ : ℕ} (X : Fin n → Ω → RealMatrix m₁ m₂) (i : Fin n) : MeasurableSpace Ω :=
  ⨆ (j : Fin m₁) (k : Fin m₂),
    MeasurableSpace.comap (fun ω => X i ω j k) (inferInstance : MeasurableSpace ℝ)

/-- Standing assumptions of the trace regression model (1.1), p. 1:
the `Xᵢ` and `Yᵢ` are random (measurable), the entries of `Xᵢ` are square integrable (so that
‖·‖_{L₂(Π)} is finite), `Yᵢ` and `Yᵢ Xᵢ` are integrable (so that 𝔼(Yᵢ | Xᵢ) and 𝔼(Yᵢ Xᵢ) in
(2.2) exist), and 𝔼(Yᵢ | Xᵢ) = tr(Xᵢᵀ A₀) almost surely. -/
structure TraceRegression (P : Measure Ω) {n m₁ m₂ : ℕ} (X : Fin n → Ω → RealMatrix m₁ m₂)
    (Y : Fin n → Ω → ℝ) (A₀ : RealMatrix m₁ m₂) : Prop where
  measurable_X : ∀ i j k, Measurable (fun ω => X i ω j k)
  measurable_Y : ∀ i, Measurable (Y i)
  memLp_X : ∀ i j k, MemLp (fun ω => X i ω j k) 2 P
  integrable_Y : ∀ i, Integrable (Y i) P
  integrable_YX : ∀ i j k, Integrable (fun ω => Y i ω * X i ω j k) P
  model : ∀ i, P[Y i | sigmaX X i] =ᵐ[P] fun ω => matrixInner (X i ω) A₀

end KLTNuclear.RestrictedEigen


