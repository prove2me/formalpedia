namespace Value
theorem _root_.solution {ι X : Type*} [Fintype ι] [DecidableEq ι] (P : ι → Prop) [DecidablePred P] (T : ι → Finset X) (d : X) (t : ι → X) (ht : ∀ i, P i → t i ∈ T i) :
    ∃! b : ι → X, b ∈ tuples P T d ∧ ∀ i, P i → b i = t i := by
  refine ⟨fun i => if P i then t i else d, ⟨(mem_tuples _ _ _ _).2 fun i => ⟨fun hi => ?_, fun hi => ?_⟩, fun i hi => ?_⟩, fun b hb => funext fun i => ?_⟩
  · simp only [if_pos hi]
    exact ht i hi
  · simp only [if_neg hi]
  · simp only [if_pos hi]
  · by_cases hi : P i
    · simp only [if_pos hi]
      exact hb.2 i hi
    · simp only [if_neg hi]
      exact ((mem_tuples _ _ _ _).1 hb.1 i).2 hi
end Value
