-- Source module: Solutions.R6ILGenT
/-!
# Round six, item language: the tail of the general procedure

After the level, the general procedure swaps the `r = e mod m` leftover digit pairs (KFE
`swapsF q`, the registers set by `tailA q`) and removes its register file: `gen_tail`. The digit
runs are those of `Bit.tailSwaps` in `progH`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

theorem encK_data {s : IState HS} {G : Fin HS → List ℤ} (hG : G 0 = []) (L : List ℤ)
    (R : List Item) : encK (s.upd 0 (ints L ++ R)) G = encK (s.upd 0 R) (Function.update G 0 L) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = 0
  · subst h; simp [hG]
  · simp [h]

theorem qShape_hd (P L : ℕ) (A B Cs : Shape) (q f r : ℕ) :
    qShape (P :: L :: (A ++ List.replicate f q)) (B ++ List.replicate f q) Cs q r =
      P :: L :: hdShape A B Cs (f + r) q := by
  simp only [qShape, restShape, hdShape, List.replicate_add, List.append_assoc, List.cons_append]

theorem tailSwaps_eq {α : Type*} (sh : Shape) (c c' r : ℕ) (d : α) (xs : List α) :
    (runPairs c c' r).foldl (fun ys pr => pull sh sh (swapPos pr.1 pr.2) d ys) xs =
      highSwaps sh c c' r d xs := by
  unfold runPairs highSwaps
  rw [List.foldl_map]

theorem vol_hd_cons (P L : ℕ) (A B Cs : Shape) (e q : ℕ) :
    vol (P :: L :: hdShape A B Cs e q) = P * L * vol A * q ^ e * vol B * q ^ e * vol Cs := by
  simp only [vol_cons, vol_hdShape, swShape, vol_append, vol_cons]; ring

theorem vT_vals (m q W T e P L a b c : ℕ) :
    let v := evalA (tailA q) (vEnt m q W T e P L a b c)
    v kP = P * L * a * (q ^ (e / m)) ^ m ∧ v kG = b * (q ^ (e / m)) ^ m ∧ v kS = c ∧ v kQt = 1 ∧
    v kQr = q ^ (e % m) / q ∧ v kR = e % m ∧ v sQQ = q ^ (e / m) ∧ v gR = e % m ∧
    v gQR = q ^ (e % m) ∧ v rLp = L / W ∧ v gTV = T * volE m q W e P L a b c ∧ v gA = a ∧
    v gF = e / m := by
  intro v
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19⟩ :=
    vEnt_vals m q W T e P L a b c
  simp +decide only [v, tailA, evalA, NE.val, Function.update_apply, v1, v2, v3, v4, v5, v6, v7, v8,
    v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, if_true, if_false]

set_option maxHeartbeats 2000000 in
/-- **The tail**: the `r` leftover digit interchanges, then the register file is removed. -/
theorem gen_tail_sol_aux {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp} (s : IState HS)
    {m q W T e P L M Bb : ℕ} {A B Cs : Shape} (hM : zsz (M : ℤ) ≤ Bb) (hq : 2 ≤ q)
    (hP : 1 ≤ P) (hL : 1 ≤ L)
    (hA : ∀ x ∈ A, 1 ≤ x) (hB : ∀ x ∈ B, 1 ≤ x) (hC : ∀ x ∈ Cs, 1 ≤ x)
    (hEB : EntB m q W T e P L (vol A) (vol B) (vol Cs) M)
    (hVM : vol (P :: L :: hdShape A B Cs e q) ≤ M)
    (R : List Item) (ys : List (ZMod 2)) (hys : ys.length = vol (P :: L :: hdShape A B Cs e q)) :
    IRuns I iprog (genTail q)
      (encK (s.upd 0 (ints (enc2 ys) ++ R))
        (regState (fDesc e P L (vol A) (vol B) (vol Cs))
          (vEnt m q W T e P L (vol A) (vol B) (vol Cs)) genD))
      (encK (s.upd 0 (ints (enc2 (Bit.tailSwaps (P :: L :: hdShape A B Cs e q)
          (A.length + 2 + m * (e / m)) (A.length + B.length + e + 2 + m * (e / m)) (e % m) ys)) ++ R))
        (fDesc e P L (vol A) (vol B) (vol Cs)))
      (cTail q (vol (P :: L :: hdShape A B Cs e q)) Bb (e % m)) := by
  set a := vol A with ha
  set b := vol B with hb
  set c := vol Cs with hc
  set V := vol (P :: L :: hdShape A B Cs e q) with hV
  have hbd0 := hEB.bounds
  have bK := hbd0
  simp only [genD, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at bK
  obtain ⟨b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13⟩ := bK
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19⟩ :=
    vEnt_vals m q W T e P L a b c
  have hX : P * (L / W) * a ≤ M := by rw [← v14]; exact b4
  have hvv := hEB.vv
  have hqc := hEB.qc
  have hvol : volE m q W e P L a b c ≤ (T + W) * volE m q W e P L a b c :=
    Nat.le_mul_of_pos_left _ (by have := hEB.W1; omega)
  obtain ⟨w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13⟩ := vT_vals m q W T e P L a b c
  set f := e / m with hf
  set r := e % m with hr
  have her : m * f + r = e := Nat.div_add_mod e m
  have hm1 := hEB.m1
  have ha1 : 1 ≤ a := vol_pos_of hA
  have hb1 : 1 ≤ b := vol_pos_of hB
  have hc1 : 1 ≤ c := vol_pos_of hC
  have hq1 : 1 ≤ q := by omega
  have hbd := hEB.bounds
  have hd := hEB.desc
  have hlit := hEB.lit
  have hNmM := hEB.Nm
  have hqbM := hEB.qb
  -- the volume
  have hVe : V = P * L * a * q ^ e * b * q ^ e * c := vol_hd_cons P L A B Cs e q
  have hqe1 : 1 ≤ q ^ e := Nat.one_le_pow _ _ (by omega)
  have hNm : (q ^ f) ^ m = q ^ (m * f) := by rw [← pow_mul, mul_comm]
  have hNe : (q ^ f) ^ m ≤ q ^ e := by rw [hNm]; exact Nat.pow_le_pow_right hq1 (by omega)
  have hr1 : 1 ≤ q ^ r := Nat.one_le_pow _ _ (by omega)
  have hre : q ^ r ≤ q ^ e := Nat.pow_le_pow_right hq1 (by omega)
  have hkP : P * L * a * (q ^ f) ^ m ≤ V := by
    rw [hVe]
    calc P * L * a * (q ^ f) ^ m ≤ P * L * a * q ^ e * (b * q ^ e * c) :=
          le_trans (Nat.mul_le_mul_left _ hNe) (Nat.le_mul_of_pos_right _
            (Nat.mul_pos (Nat.mul_pos hb1 hqe1) hc1))
      _ = _ := by ring
  have hkG : b * (q ^ f) ^ m ≤ V := by
    rw [hVe]
    calc b * (q ^ f) ^ m ≤ b * q ^ e * (P * L * a * q ^ e * c) :=
          le_trans (Nat.mul_le_mul_left _ hNe) (Nat.le_mul_of_pos_right _
            (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL) ha1) hqe1) hc1))
      _ = _ := by ring
  have hN1 : 1 ≤ (q ^ f) ^ m := Nat.one_le_pow _ _ (Nat.one_le_pow _ _ (by omega))
  have hPL : P * L * a ≤ P * L * a * (q ^ f) ^ m := Nat.le_mul_of_pos_right _ hN1
  have hPL' : P * L ≤ P * L * a := Nat.le_mul_of_pos_right _ ha1
  have hbG : b ≤ b * (q ^ f) ^ m := Nat.le_mul_of_pos_right _ hN1
  have hqeV : q ^ e ≤ V := by
    rw [hVe]
    have h1 : 1 ≤ P * L * a * b * q ^ e * c :=
      Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL) ha1) hb1) hqe1) hc1
    calc q ^ e ≤ q ^ e * (P * L * a * b * q ^ e * c) := Nat.le_mul_of_pos_right _ h1
      _ = _ := by ring
  have hqrq : q ^ r / q ≤ q ^ r := Nat.div_le_self _ _
  have hrM : r ≤ M := le_trans (Nat.mod_le _ _) (by omega)
  have hM1 : 1 ≤ M := by omega
  have hB1 : 1 ≤ Bb := le_trans (by simpa [zsz_one] using zsz_natCast_le' hM1) hM
  -- 1. the tail registers
  have SA := Sp.asgs (s.upd 0 (ints (enc2 ys) ++ R)) (fDesc e P L a b c) genD hM (tailA q)
    (vEnt m q W T e P L a b c) (by
    simp +decide [OKA, tailA, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, fDesc,
      regState, descD, genD, vDesc, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14,
      v15, v16, v17, v18, v19]
    and_intros <;> omega)
  set vT := evalA (tailA q) (vEnt m q W T e P L a b c) with hvT
  set G := regState (fDesc e P L a b c) vT genD with hG
  have hG0 : G 0 = [] := by simp +decide [G, regState, genD, fDesc, descD]
  rw [encK_data hG0] at SA
  -- 2. the swaps
  set Pre := P :: L :: (A ++ List.replicate (m * f) q) with hPre
  set Gs := B ++ List.replicate (m * f) q with hGs
  have hsh : qShape Pre Gs Cs q r = P :: L :: hdShape A B Cs e q := by
    rw [hPre, hGs, qShape_hd, her]
  have hvPre : vol Pre = P * L * a * (q ^ f) ^ m := by
    simp only [Pre, vol_cons, vol_append, vol_replicate, hNm]; ring
  have hvGs : vol Gs = b * (q ^ f) ^ m := by
    simp only [Gs, vol_append, vol_replicate, hNm, ← hb]
  have hreg : ∀ j : Fin HS, j ∈ genD → j ∉ descD →
      (Function.update G 0 (enc2 ys)) j = ((vT j : ℕ) : ℤ) :: [] := by
    intro j hj hjd
    have hj0 : j ≠ 0 := by rintro rfl; revert hj; decide
    rw [Function.update_of_ne hj0, hG, regState_mem hj, fDesc_free hjd]
  have S3 := swapsF_runs (I := I) (iprog := iprog) (s.upd 0 R) (Function.update G 0 (enc2 ys))
    Pre Gs Cs (q := q) (e := r) (r := r) (enc2 ys) [] hq
    (by rw [hvPre]; exact Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL) ha1) hN1)
    (by rw [hvGs]; exact Nat.mul_pos hb1 hN1) hc1 le_rfl
    (by rw [hsh, length_enc2]; exact hys) Bb (bnd_enc2 ys le_rfl) hB1
    (by rw [hsh]; exact le_trans (zsz_nat_le hVM) hM)
    (by simp) (by rw [Function.update_of_ne (by decide), hG, regState_nmem (by decide),
      fDesc_free (by decide)])
    (by rw [hreg kP (by decide) (by decide), w1, hvPre])
    (by rw [hreg kG (by decide) (by decide), w2, hvGs])
    (by rw [hreg kS (by decide) (by decide), w3])
    (by rw [hreg kQt (by decide) (by decide), w4, pow_zero])
    (by rw [hreg kQr (by decide) (by decide), w5, Nat.sub_zero])
    (by rw [hreg kR (by decide) (by decide), w6])
  rw [hsh] at S3
  -- 3. the end state
  set vT' := Function.update (Function.update vT kQt (q ^ r)) kQr (q ^ (r - r) / q) with hvT'
  set zs := highSwaps (P :: L :: hdShape A B Cs e q) Pre.length (Pre.length + r + Gs.length) r 0 ys
    with hzs
  have eS : swF (Function.update G 0 (enc2 ys)) (P :: L :: hdShape A B Cs e q) Pre.length
      (Pre.length + r + Gs.length) q r (enc2 ys) [] [] [] r =
      Function.update (regState (fDesc e P L a b c) vT' genD) 0 (enc2 zs) := by
    funext j
    simp only [swF, highSwaps_enc2, List.append_nil, Function.update_apply]
    by_cases j1 : j = kQr
    · subst j1; simp +decide [vT', regState, genD, fDesc, descD]
    by_cases j2 : j = kQt
    · subst j2; simp +decide [vT', regState, genD, fDesc, descD]
    by_cases j0 : j = 0
    · subst j0; rw [if_neg (by decide), if_neg (by decide)]; simp only [↓reduceIte]; rfl
    simp only [j1, j2, j0, if_false, hG, vT', regState, Function.update_apply]
  rw [eS, ← encK_data (G := regState (fDesc e P L a b c) vT' genD) (by simp +decide [regState, genD, fDesc, descD]) (enc2 zs) R] at S3
  -- 4. remove the file
  have hkPM : P * L * a * (q ^ f) ^ m ≤ M := le_trans hkP hVM
  have hkGM : b * (q ^ f) ^ m ≤ M := le_trans hkG hVM
  have hqfM : q ^ f ≤ M := le_trans (Nat.le_self_pow (by omega) _) hNmM
  have hqrM : q ^ r ≤ M := le_trans (Nat.le_mul_of_pos_right _ hb1) hqbM
  have h1q : q ^ (r - r) / q ≤ M := by rw [Nat.sub_self, pow_zero]; exact le_trans (Nat.div_le_self _ _) hM1
  have S4 := Sp.popD (s.upd 0 (ints (enc2 zs) ++ R)) Bb genD (fDesc e P L a b c) vT' genD_lt
    genD_nodup (by
      intro i hi
      refine le_trans (zsz_nat_le ?_) hM
      simp only [genD, List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
        simp +decide only [vT', Function.update_apply, if_true, if_false, w1, w2, w3, w4, w5, w6, w7,
          w8, w9, w10, w11, w12, w13] <;> first | omega | (simp; omega) | skip)
  have hlen1 : Pre.length = A.length + 2 + m * f := by simp [Pre]; omega
  have hlen2 : Pre.length + r + Gs.length = A.length + B.length + e + 2 + m * f := by
    simp [Pre, Gs]; omega
  have htail : Bit.tailSwaps (P :: L :: hdShape A B Cs e q) (A.length + 2 + m * f)
      (A.length + B.length + e + 2 + m * f) r ys = zs := by
    rw [hzs, hlen2, hlen1, Bit.tailSwaps, tailSwaps_eq]
  rw [htail]
  have H := (SA.toIRuns (I := I) (iprog := iprog)).seq (S3.seq S4.toIRuns)
  exact H.mono' rfl (by simp only [cTail, ← hV]; omega)

end

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.gen_tail_sol_aux := @IntMul.Kappa.R6.IL.gen_tail_sol_aux
