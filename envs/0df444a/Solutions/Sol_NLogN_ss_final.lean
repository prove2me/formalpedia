open IntMul

theorem fold_bound (N : ℕ) (x : ℤ) (hN : 1 ≤ N) (hx : 0 ≤ x ∧ x ≤ 2 ^ N) :
    |fold N x| < 2 ^ N := by
  have hp : (0 : ℤ) < 2 ^ N := by positivity
  have h2 : (2 : ℤ) ≤ 2 ^ N := by
    calc (2 : ℤ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ N := pow_le_pow_right₀ (by norm_num) hN
  unfold fold
  rcases lt_or_eq_of_le hx.2 with h | h
  · rw [Int.emod_eq_of_lt hx.1 h, Int.ediv_eq_zero_of_lt hx.1 h]
    rw [abs_lt]; constructor <;> linarith
  · rw [h, Int.emod_self, Int.ediv_self hp.ne']
    rw [abs_lt]; constructor <;> linarith

theorem cast_fold (N : ℕ) (x : ℤ) :
    ((fold N x : ℤ) : ZMod (2 ^ N + 1)) = (x : ZMod (2 ^ N + 1)) := by
  have hd := Int.emod_add_mul_ediv x (2 ^ N)
  have h2 := two_pow_eq_neg_one N
  unfold fold
  conv_rhs => rw [← hd]
  push_cast
  rw [h2]; ring

end NLogN

end

