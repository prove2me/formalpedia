theorem t_cocycle (hn : 3 ≤ n) (hnD : IsUnit ((n : ℕ) : D))
    (m : ((W S r B u i j l : (u i).A.Opens) : Scheme.{0}) ⟶ ((V S r B u j l : (u j).A.Opens) : Scheme.{0}))
    (hm : m ≫ (V S r B u j l).ι = (u i).A.homOfLE ((p S B u i).preimage_mono inf_le_left) ≫ t S r B u hover i j) :
    m ≫ t S r B u hover j l = (u i).A.homOfLE ((p S B u i).preimage_mono inf_le_right) ≫ t S r B u hover i l := by
  obtain ⟨μ, hμ, hμpb, hμmul, hμP, hμpol⟩ := exists_μ (S := S) (B := B) (u := u) (i := i) (j := j) (l := l) (incL := incL) (τi := τi) hτi₁
  obtain ⟨ν, hν, hνpb, hνmul, hνP, hνpol⟩ :=
    exists_ν (S := S) (r := r) (B := B) (u := u) (hover := hover) (i := i) (j := j) (l := l) (incL := incL) (τj := τj) hτj₁
  have hωinv : (ω S r B u i j l incL hrange).inv ≫ (W S r B u i j l).ι = gw S B u i j incL ≫ gA₁ S B u i j := by
    rw [← ω_hom_fac S r B u i j l incL hrange, Iso.inv_hom_id_assoc]
  haveI := isOpenImmersion_gA₁ S r B u i j
  haveI := isOpenImmersion_gA₁ S r B u j l
  haveI := isOpenImmersion_gA₁ S r B u i l
  have hgw : (ω S r B u i j l incL hrange).inv ≫ (u i).A.homOfLE ((p S B u i).preimage_mono inf_le_left) ≫ (θ S r B u i j).hom =
      gw S B u i j incL := by
    rw [← cancel_mono (gA₁ S B u i j), Category.assoc, Category.assoc, θ_hom_gA₁, Scheme.homOfLE_ι, hωinv]
  have hν' : (ω S r B u i j l incL hrange).inv ≫ m ≫ (θ S r B u j l).hom = ν := by
    rw [← cancel_mono (gA₁ S B u j l), Category.assoc, Category.assoc, θ_hom_gA₁, hm, hν, ← hgw]
    simp only [t, Category.assoc]
  have hμ' : (ω S r B u i j l incL hrange).inv ≫ (u i).A.homOfLE ((p S B u i).preimage_mono inf_le_right) ≫ (θ S r B u i l).hom = μ := by
    rw [← cancel_mono (gA₁ S B u i l), Category.assoc, Category.assoc, θ_hom_gA₁, Scheme.homOfLE_ι, hωinv, hμ]

  rw [← cancel_epi (ω S r B u i j l incL hrange).inv]
  simp only [t]
  rw [← Category.assoc _ (θ S r B u j l).hom, ← Category.assoc (ω S r B u i j l incL hrange).inv, ← Category.assoc, hν',
    ← Category.assoc _ (θ S r B u i l).hom, ← Category.assoc (ω S r B u i j l incL hrange).inv, hμ']

  obtain ⟨hpbⱼ, hmulⱼ, hPⱼ, hpolⱼ⟩ := (hv₂ S B u j l).choose_spec
  obtain ⟨heⱼ, hemulⱼ, helevⱼ, hepolⱼ⟩ := (iso_v S r B u hover j l).choose_spec
  obtain ⟨hpbᵢ, hmulᵢ, hPᵢ, hpolᵢ⟩ := (hv₂ S B u i l).choose_spec
  obtain ⟨heᵢ, hemulᵢ, helevᵢ, hepolᵢ⟩ := (iso_v S r B u hover i l).choose_spec
  have j₁ := comp_isPullback (gA₂ S B u j l) hpbⱼ (e S r B u hover j l) heⱼ
  have j₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B j l))) (x y : SchemeHomOver t' (v₁ S B u j l).f), _ :=
    fun t' x y => comp_mul (gA₂ S B u j l) hpbⱼ hmulⱼ (e S r B u hover j l) heⱼ hemulⱼ t' x y
  have j₃ := comp_P (gA := gA₂ S B u j l) (hP := hPⱼ) (e := e S r B u hover j l) (helev := helevⱼ)
  have j₄ : LocIsoOnBase (v₁ S B u j l).f ((Scheme.Modules.pullback ((e S r B u hover j l).hom ≫ gA₂ S B u j l)).obj (u l).pol)
      (v₁ S B u j l).pol := comp_pol (gA₂ S B u j l) hpolⱼ (e S r B u hover j l) hepolⱼ
  have i₁ := comp_isPullback (gA₂ S B u i l) hpbᵢ (e S r B u hover i l) heᵢ
  have i₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of (C S B i l))) (x y : SchemeHomOver t' (v₁ S B u i l).f), _ :=
    fun t' x y => comp_mul (gA₂ S B u i l) hpbᵢ hmulᵢ (e S r B u hover i l) heᵢ hemulᵢ t' x y
  have i₃ := comp_P (gA := gA₂ S B u i l) (hP := hPᵢ) (e := e S r B u hover i l) (helev := helevᵢ)
  have i₄ : LocIsoOnBase (v₁ S B u i l).f ((Scheme.Modules.pullback ((e S r B u hover i l).hom ≫ gA₂ S B u i l)).obj (u l).pol)
      (v₁ S B u i l).pol := comp_pol (gA₂ S B u i l) hpolᵢ (e S r B u hover i l) hepolᵢ

  have n₁ := compg_isPullback ((e S r B u hover j l).hom ≫ gA₂ S B u j l) j₁ ν hνpb
  have n₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f), _ :=
    fun t' x y => compg_mul ((e S r B u hover j l).hom ≫ gA₂ S B u j l) j₁ j₂ ν hνpb hνmul t' x y
  have n₃ := compg_P (gA := (e S r B u hover j l).hom ≫ gA₂ S B u j l) (hP := j₃) (c := ν) (hcP := hνP)
  have n₄ := pol_local_comp ((e S r B u hover j l).hom ≫ gA₂ S B u j l) ν hνpb.w j₄ hνpol
  obtain ⟨N₁, N₂, N₃⟩ := clauses_congr (ν ≫ (e S r B u hover j l).hom ≫ gA₂ S B u j l) hτj₂.symm n₁ n₂ n₃
  have m₁ := compg_isPullback ((e S r B u hover i l).hom ≫ gA₂ S B u i l) i₁ μ hμpb
  have m₂ : ∀ {T₀ : Scheme.{0}} (t' : T₀ ⟶ Spec (CommRingCat.of D)) (x y : SchemeHomOver t' (w S B u i j incL).f), _ :=
    fun t' x y => compg_mul ((e S r B u hover i l).hom ≫ gA₂ S B u i l) i₁ i₂ μ hμpb hμmul t' x y
  have m₃ := compg_P (gA := (e S r B u hover i l).hom ≫ gA₂ S B u i l) (hP := i₃) (c := μ) (hcP := hμP)
  have m₄ := pol_local_comp ((e S r B u hover i l).hom ≫ gA₂ S B u i l) μ hμpb.w i₄ (locIsoOnBase_of_iso _ hμpol.some)
  obtain ⟨M₁, M₂, M₃⟩ := clauses_congr (μ ≫ (e S r B u hover i l).hom ≫ gA₂ S B u i l) hτi₂.symm m₁ m₂ m₃
  exact AlgebraicGeometry.PolarisedAbelianScheme.eq_of_isPullback_of_isPullback_of_three_le_of_locally hn lam hnD
    (u l) (w S B u i j incL) _ _ N₁ N₂ N₃ n₄ M₁ M₂ M₃ m₄

end Triple

section Concrete

variable (i j l : Fin k)

abbrev Dc : Type := Localization.Away (algebraMap S (C S B i j) (r l))

noncomputable def lamA : B l →ₐ[S] Dc S r B i j l :=
  IsLocalization.liftAlgHom (M := Submonoid.powers (r l)) (f := Algebra.ofId S (Dc S r B i j l)) (by
    rintro ⟨y, n, rfl⟩
    simp only [Algebra.ofId_apply, map_pow]
    rw [IsScalarTower.algebraMap_apply S (C S B i j) (Dc S r B i j l)]
    exact (IsLocalization.Away.algebraMap_isUnit (algebraMap S (C S B i j) (r l))).pow n)

noncomputable def τjA : C S B j l →ₐ[S] Dc S r B i j l :=
  Algebra.TensorProduct.lift ((IsScalarTower.toAlgHom S (C S B i j) (Dc S r B i j l)).comp (ρ₂ S B i j)) (lamA S r B i j l)
    (fun _ _ => Commute.all _ _)
noncomputable def τiA : C S B i l →ₐ[S] Dc S r B i j l :=
  Algebra.TensorProduct.lift ((IsScalarTower.toAlgHom S (C S B i j) (Dc S r B i j l)).comp (ρ₁ S B i j)) (lamA S r B i j l)
    (fun _ _ => Commute.all _ _)

theorem τjA_comp_ρ₁ : (τjA S r B i j l).toRingHom.comp (ρ₁ S B j l).toRingHom =
    (algebraMap (C S B i j) (Dc S r B i j l)).comp (ρ₂ S B i j).toRingHom :=
  RingHom.ext fun x => by
    show τjA S r B i j l (x ⊗ₜ 1) = algebraMap (C S B i j) (Dc S r B i j l) (ρ₂ S B i j x)
    rw [τjA, Algebra.TensorProduct.lift_tmul, map_one, mul_one]; rfl

theorem τjA_comp_ρ₂ : (τjA S r B i j l).toRingHom.comp (ρ₂ S B j l).toRingHom = (lamA S r B i j l).toRingHom :=
  RingHom.ext fun x => by
    show τjA S r B i j l (1 ⊗ₜ x) = lamA S r B i j l x
    rw [τjA, Algebra.TensorProduct.lift_tmul, map_one, one_mul]

theorem τiA_comp_ρ₁ : (τiA S r B i j l).toRingHom.comp (ρ₁ S B i l).toRingHom =
    (algebraMap (C S B i j) (Dc S r B i j l)).comp (ρ₁ S B i j).toRingHom :=
  RingHom.ext fun x => by
    show τiA S r B i j l (x ⊗ₜ 1) = algebraMap (C S B i j) (Dc S r B i j l) (ρ₁ S B i j x)
    rw [τiA, Algebra.TensorProduct.lift_tmul, map_one, mul_one]; rfl

theorem τiA_comp_ρ₂ : (τiA S r B i j l).toRingHom.comp (ρ₂ S B i l).toRingHom = (lamA S r B i j l).toRingHom :=
  RingHom.ext fun x => by
    show τiA S r B i j l (1 ⊗ₜ x) = lamA S r B i j l x
    rw [τiA, Algebra.TensorProduct.lift_tmul, map_one, one_mul]

theorem hrange_Dc (q : PrimeSpectrum (C S B i j)) :
    q ∈ Set.range (Spec.map (CommRingCat.ofHom (algebraMap (C S B i j) (Dc S r B i j l)))).base ↔
      algebraMap S (C S B i j) (r l) ∉ q.asIdeal := by
  have hR : Set.range (PrimeSpectrum.comap (algebraMap (C S B i j) (Dc S r B i j l))) = _ :=
    PrimeSpectrum.localization_away_comap_range (Dc S r B i j l) (algebraMap S (C S B i j) (r l))
  show q ∈ Set.range (PrimeSpectrum.comap (algebraMap (C S B i j) (Dc S r B i j l))) ↔ _
  rw [hR]
  exact Iff.rfl

end Concrete

include hover in
theorem exists_glued (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S)) (hr : Ideal.span (Set.range r) = ⊤) :
    ∃ (Y : Scheme.{0}) (f : Y ⟶ Spec (CommRingCat.of S)) (ι : ∀ i, (u i).A ⟶ Y),
      (∀ i, IsOpenImmersion (ι i)) ∧ (∀ i, ι i ≫ f = p S B u i) ∧
      (∀ i, Set.range (ι i).base = (((f ⁻¹ᵁ (PrimeSpectrum.basicOpen (r i))) : Y.Opens) : Set ↥Y)) ∧
      (∀ i j, t S r B u hover i j ≫ ι j = (V S r B u i j).ι ≫ ι i) ∧
      (∀ y : ↥Y, ∃ (i : Fin k) (x : ↥(u i).A), (ι i).base x = y) := by
  have hp : ∀ (i : Fin k) (x : ↥(u i).A), (p S B u i).base x ∈ PrimeSpectrum.basicOpen (r i) := by
    intro i x
    have hx : (alg S B i).base ((u i).f.base x) ∈ Set.range (PrimeSpectrum.comap (algebraMap S (B i))) := ⟨_, rfl⟩
    rw [PrimeSpectrum.localization_away_comap_range (B i) (r i)] at hx
    exact hx
  exact AlgebraicGeometry.Scheme.exists_glued_over_Spec_of_cocycle_basicOpen r hr (fun i => (u i).A) (p S B u) hp
    (t S r B u hover) (t_over S r B u hover) (t_self S r B u hover hn hn') (t_inv S r B u hover hn hn')
    (fun i j l m hm => t_cocycle S r B u hover i j l (algebraMap (C S B i j) (Dc S r B i j l)) (hrange_Dc S r B i j l)
      (lamA S r B i j l).toRingHom (τjA S r B i j l).toRingHom (τiA S r B i j l).toRingHom
      (τjA_comp_ρ₁ S r B i j l) (τjA_comp_ρ₂ S r B i j l) (τiA_comp_ρ₁ S r B i j l) (τiA_comp_ρ₂ S r B i j l)
      hn (by simpa using hn'.map (algebraMap S (Dc S r B i j l))) m hm)

section Glued

variable {Y : Scheme.{0}} (f : Y ⟶ Spec (CommRingCat.of S)) (ι : ∀ i, (u i).A ⟶ Y) [hιopen : ∀ i, IsOpenImmersion (ι i)]
  (hιf : ∀ i, ι i ≫ f = p S B u i)
  (hιrange : ∀ i, Set.range (ι i).base = (((f ⁻¹ᵁ (PrimeSpectrum.basicOpen (r i))) : Y.Opens) : Set ↥Y))
  (hιt : ∀ i j, t S r B u hover i j ≫ ι j = (V S r B u i j).ι ≫ ι i)

include hιopen hιf hιrange in

theorem chart_isPullback (i : Fin k) : IsPullback (ι i) (u i).f f (alg S B i) := by
  haveI : IsOpenImmersion (alg S B i) := IsOpenImmersion.of_isLocalization (r i)
  refine (IsOpenImmersion.isPullback (u i).f (ι i) (alg S B i) f (hιf i) ?_).flip
  have hU : (alg S B i).opensRange = PrimeSpectrum.basicOpen (r i) :=
    TopologicalSpace.Opens.ext (PrimeSpectrum.localization_away_comap_range (B i) (r i))
  rw [hU]
  exact TopologicalSpace.Opens.ext (hιrange i).symm

