section Side

variable {h : ℕ}

theorem side_edge_of_sol_aux (C : Matrix (Pr (h + 4)) (Fin (h + 4)) ℚ)
    (A : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) (R : Matrix (Fin (h + 4)) (Pr (h + 4)) ℚ)
    (hB : ∀ i j : Fin (h + 4), i < j → (Te (h := h) * C) ⟨i.val, by have := two_k_le (h := h); omega⟩ j = 0)
    (hBd : ∀ i : Fin (h + 4), (Te (h := h) * C) ⟨i.val, by have := two_k_le (h := h); omega⟩ i ≠ 0)
    (hA : ∀ i j : Fin (h + 4), i < j → (R * Te' (h := h)) i
      ⟨(h + 4) * (h + 4) - (h + 4) + j.val, by have := two_k_le (h := h); omega⟩ = 0)
    (hAd : ∀ i : Fin (h + 4), (R * Te' (h := h)) i
      ⟨(h + 4) * (h + 4) - (h + 4) + i.val, by have := two_k_le (h := h); omega⟩ ≠ 0)
    (hM : C * A * R * (C * A * R) = C * A * R) (hAA : A * A = A) (r : ℕ) (hr : A.rank = r)
    (hrM : (qM (C * A * R)).rank = r)
    (hcor : h + 4 < 2 * r → (A.submatrix (fun l : Fin (h + 4 - r) => (⟨l.val, by omega⟩ : Fin (h + 4)))
        (fun c : Fin (h + 4 - r) => (⟨h + 4 - (h + 4 - r) + c.val, by omega⟩ : Fin (h + 4)))).det ≠ 0) :
    ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e (qM (C * A * R)) ∧ ∃ rs',
      e.runs = sideRuns (h + 4) ((h + 4) * (h + 4)) r ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
      (runPairs (sideRuns (h + 4) ((h + 4) * (h + 4)) r)).length + rs'.length = r := by
  have hk := two_k_le (h := h)
  have hq : qM (C * A * R) * qM (C * A * R) = qM (C * A * R) := qM_idem hM
  have hrn : r ≤ h + 4 := hr ▸ rank_le_width A |>.trans (by simp)
  obtain ⟨e, he, rs', h1, h2, h3⟩ : ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e (qM (C * A * R)) ∧
      ∃ rs', e.runs = sideRuns (h + 4) ((h + 4) * (h + 4)) r ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
      (runPairs (sideRuns (h + 4) ((h + 4) * (h + 4)) r)).length + rs'.length =
        (qM (C * A * R)).rank := by
    refine edge_singles (by nlinarith) _ hq _ ?_ ?_ ?_
    · intro ρ hρ
      unfold sideRuns at hρ
      split_ifs at hρ with hr2
      · simp only [List.mem_cons, List.mem_nil_iff, or_false] at hρ
        subst hρ
        refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only <;> omega
      · simp at hρ
    · unfold sideRuns
      split_ifs
      · rw [runPairs_cons, runPairs_nil, List.append_nil]; exact nodup_run _ _ _
      · exact List.nodup_nil
    · intro p hp
      unfold sideRuns at hp
      split_ifs at hp with hr2
      · rw [runPairs_cons, runPairs_nil, List.append_nil, mem_run] at hp
        obtain ⟨t, ht, rfl⟩ := hp
        have hpiv : IsPiv A (h + 4 - r + t) (h + 4 - r + t) :=
          isPiv_mid (m := h + 4) (k := h + 4 - r) (by omega) A hAA (by omega) (hcor hr2)
            (by omega) (by omega)
        have := isPiv_side (by nlinarith) (Te (h := h) * C) A (R * Te' (h := h)) hB hBd hA hAd hpiv
        rw [qM_fac]
        have key : (h + 4) * (h + 4) - r + t = (h + 4) * (h + 4) - (h + 4) + (h + 4 - r + t) := by
          generalize (h + 4) * (h + 4) = M at hk ⊢; omega
        rw [key]; exact this
      · rw [runPairs_nil] at hp; simp at hp
  exact ⟨e, he, rs', h1, h2, h3.trans hrM⟩

end Side

