    have m6 := Nat.mul_le_mul_right (NLogN.KFG.cAtom (NLogN.KFG.gateW (NLogN.KFN.levA W 0) e2 (x + dw)) 0 L W Z) hsl1
    unfold NLogN.KFN.cWrapR
    nlinarith
end
