    intro s s' c h
    rcases n with _ | n
    · simp [IStmt.run] at h
    simp only [IStmt.run] at h
    split_ifs at h with hf
    · split at h <;> try simp at h
      rename_i s₁ c₁ h₁
      split at h <;> try simp at h
      rename_i s₂ c₂ h₂
      obtain ⟨rfl, rfl⟩ := h
