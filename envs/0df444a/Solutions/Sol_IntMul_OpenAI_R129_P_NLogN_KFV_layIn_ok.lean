theorem mkOf_bit : ∀ (bs : List Bool) (i : ℕ), mkOf bs / 2 ^ i % 2 = if bs.getD i false then 1 else 0
  | [], i => by simp [mkOf]
  | b :: bs, 0 => by simp only [mkOf, pow_zero, Nat.div_one, List.getD_cons_zero]; split_ifs <;> omega
  | b :: bs, i + 1 => by
    rw [pow_succ', ← Nat.div_div_eq_div_mul]
    have : (mkOf (b :: bs)) / 2 = mkOf bs := by simp only [mkOf]; split_ifs <;> omega
    rw [this, mkOf_bit bs i]; simp

theorem mkOf_lt : ∀ bs : List Bool, mkOf bs < 2 ^ bs.length
  | [] => by simp [mkOf]
  | b :: bs => by
    have := mkOf_lt bs
    simp only [mkOf, List.length_cons, pow_succ]; split_ifs <;> omega

theorem LRg.congr {s s' : IState HS} {L : LP} {mk W : ℕ} (H : LRg s L mk W)
    (e : ∀ r ∈ lRegs, s'.G r = s.G r) : LRg s' L mk W := by
  have c : ∀ {r : Fin HS} {v : ℤ}, r ∈ lRegs → RT s r v → RT s' r v := fun hr ⟨L, hL⟩ =>
    ⟨L, by rw [e _ hr]; exact hL⟩
  exact ⟨c (by decide) H.d, c (by decide) H.l, c (by decide) H.k, c (by decide) H.b,
    c (by decide) H.q, c (by decide) H.nl, c (by decide) H.st, c (by decide) H.n,
    c (by decide) H.m, c (by decide) H.w⟩

theorem LRg.of_cf3 {s : IState HS} {L : LP} {mk W : ℕ} (H : LRg s L mk W) (LA LC LD : List Item) :
    LRg (KFT.cf3 s fA NLogN.KFV.fC fD LA LC LD) L mk W := by
  refine H.congr ?_
  intro r hr
  have : r ≠ fA ∧ r ≠ NLogN.KFV.fC ∧ r ≠ fD := by revert r hr; decide
  simp only [KFT.cf3, IState.upd_G, if_neg this.2.2, if_neg this.2.1, if_neg this.1]

