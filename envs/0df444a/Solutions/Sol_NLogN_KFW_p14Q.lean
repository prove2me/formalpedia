  have h := IRuns.mv (I := Isym) (iprog := tbl) (s := NLogN.KIL.encK s f) (a := a) (L := ints l ++ s.G X)
    hXY (by simp [hf])
  rw [encK_upd] at h
  have e2 : (NLogN.KIL.encK s f).G Y = ints (f Y) ++ s.G Y := by
    first | simp | simp [encK]
  rw [e2] at h
  have e3 : (NLogN.KIL.encK s (Function.update f X l)).upd Y (Item.int a :: (ints (f Y) ++ s.G Y)) =
      NLogN.KIL.encK s (Function.update (Function.update f X l) Y (a :: f Y)) := by
    first | exact encK_upd s (Function.update f X l) Y (a :: f Y) | simpa [ints] using encK_upd s (Function.update f X l) Y (a :: f Y)
  rw [e3] at h
  exact h.mono (by have := moveCost_mono ha; omega)

