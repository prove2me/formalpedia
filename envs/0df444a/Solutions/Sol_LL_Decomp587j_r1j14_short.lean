            have : pa - hi0 - 206 * StepPhi + (hi0 + 206 * StepPhi) = pa := by omega
            have hc : ((pa - hi0 - 206 * StepPhi : ℕ) : ℝ) + ((hi0 : ℝ) + 206 * StepPhi) = (pa : ℝ) := by
