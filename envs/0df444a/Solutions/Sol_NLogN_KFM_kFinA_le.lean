-- Source module: Solutions.KFMCost
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open Finset IntMul KIL KFB KFT KFU RS IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

section Basic

variable {n : ℕ} (hn : n0 ≤ n)
include hn

end Basic

theorem cW_le' (a : ℤ) : cW a ≤ 200 * (zsz a + 1) := by
  unfold cW; simp only [dupCost, zipCost, moveCost]; omega

theorem cW_nat (m : ℕ) : cW (m : ℤ) ≤ 200 * (m + 1) := by
  have := cW_le' (m : ℤ); have := zsz_natCast_le_self' m; omega

theorem cW_pow (k : ℕ) : cW ((2 : ℤ) ^ k) ≤ 200 * (k + 2) := by
  have := cW_le' ((2 : ℤ) ^ k); rw [NLogN.zsz_two_pow] at this; omega

theorem cConj_le (N B : ℕ) : cConj N B ≤ 10000 * (N + 1) * (B + 2) := by
  have h1 := cRpt_le N
  have h1' := cRpt_le (2 * N)
  have h2 := zsz_natCast_le_self' N
  have h2' := zsz_natCast_le_self' (2 * N)
  unfold cConj; simp only [dupCost, zipCost, moveCost]; nlinarith

section Sizes

variable {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hn hD

theorem wU_le : NLogN.KFM.wU n D ≤ 2 * pP n := by
  have h := gam_le hn
  rw [hD] at h
  have hb := (setup_facts hn).1
  unfold NLogN.KFM.wU pP; nlinarith

theorem wFR_le : wFR n D ≤ 3 * pP n := by
  have := wU_le hn hD
  have hb := (setup_facts hn).1
  unfold wFR; unfold pP at this ⊢; omega

theorem sBD_lt_tBD (i : Fin (D + 1)) : sBD n D i < tBD n D i := by
  obtain ⟨w1, w2, -⟩ := KFQ.win hn hD i
  have hd := (setup_facts hn).2.1
  have ht : 0 < tBD n D i := by obtain ⟨e, -, he⟩ := KFQ.tBD_pow hn hD i; rw [he]; positivity
  by_contra h
  push Not at h
  have : 4 * IntMul.OpenAI.Glue.dP n * tBD n D i ≤ 4 * IntMul.OpenAI.Glue.dP n * sBD n D i := Nat.mul_le_mul_left _ h
  have e : (4 * IntMul.OpenAI.Glue.dP n - 1) * tBD n D i + tBD n D i = 4 * IntMul.OpenAI.Glue.dP n * tBD n D i := by
    rw [← Nat.succ_mul]; congr 1; omega
  omega

theorem sCmp_le_T : sCmp n ≤ IntMul.OpenAI.Glue.TP n := by
  rw [sCmp_eq hn hD (sBD_lt_tBD hn hD), ← KFQ.prod_tBD hn hD]
  exact Finset.prod_le_prod (fun i _ => Nat.zero_le _) (fun i _ => (sBD_lt_tBD hn hD i).le)

end Sizes

section Passes

variable {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hn hD

theorem eT2 : 2 ^ (IntMul.OpenAI.Glue.LP n + 1) = 2 * IntMul.OpenAI.Glue.TP n := by rw [pow_succ]; unfold IntMul.OpenAI.Glue.TP; ring

theorem fmB_le8 {m : ℕ} (hm : m ≤ 8 * pP n) : fmB m ≤ fmB (8 * pP n) := fmB_mono hm

theorem kCj_le {B : ℕ} (hB : B ≤ 3 * pP n) : kCj n B ≤ 10 ^ 6 * (IntMul.OpenAI.Glue.TP n * (pP n + 1) + pP n + 1) := by
  unfold kCj
  have c1 := cConj_le (2 ^ IntMul.OpenAI.Glue.LP n) B
  have c4 := cW_nat (2 * 2 ^ IntMul.OpenAI.Glue.LP n)
  have c5 := cW_nat (2 ^ IntMul.OpenAI.Glue.LP n)
  have eT : 2 ^ IntMul.OpenAI.Glue.LP n = IntMul.OpenAI.Glue.TP n := rfl
  rw [eT] at c1 c4 c5 ⊢
  set T := IntMul.OpenAI.Glue.TP n
  set p := pP n
  have m2 := Nat.mul_le_mul_left (T + 1) hB
  have e1 : (T + 1) * (3 * p) = 3 * (T * p) + 3 * p := by ring
  have e2 : T * (p + 1) = T * p + T := by ring
  have e3 : 10000 * (T + 1) * (B + 2) = 10000 * ((T + 1) * B) + 20000 * T + 20000 := by ring
  rw [e3] at c1; rw [e1] at m2; rw [e2]
  omega

end Passes

section Desc

variable {n : ℕ} (hn : n0 ≤ n)
include hn

end Desc

end

