-- title:
--   Rule (3.7) gives $1/\gamma_{k+1}^2 = (1+2\gamma_k(\mu_B-\gamma_kL_C^2/2))/\gamma_k^2$
-- statement:
--   Let $\mu_B > 0$, $L_C > 0$ and $\gamma_0 \in (0, 2\mu_B/L_C^2)$, and let $(\gamma_k)_{k \ge 0}$ be generated by the stepsize rule (3.7). Then for every $k \ge 0$
--   $$\frac{1}{\gamma_{k+1}^2} = \frac{1 + 2\gamma_k(\mu_B - \gamma_kL_C^2/2)}{\gamma_k^2}.$$
--
--   This is the counterpart for Part 2 of the identity that makes (3.10) telescope.
-- source:
--   Davis and Yin, A Three-Operator Splitting Scheme and its Optimization Applications, Set-Valued Var. Anal. 25 (2017), https://doi.org/10.1007/s11228-017-0421-z, p. 846, Section 3.3, proof of Theorem 3.3, Part 2 (unnumbered display)

import Mathlib
import Definitions.Def_ThreeOpSplitting_Accel_Stepsizes

open Filter Topology

namespace ThreeOpSplitting.Accel

/-- Proof of Theorem 3.3, Part 2 (p. 846): the rule (3.7) ensures
`1/γ_{k+1}² = (1 + 2γ_k(μ_B - γ_kL_C²/2))/γ_k²` for all `k ≥ 0`. -/
theorem stepsize_identity_part2 (μB LC γ0 : ℝ)
    (hμB : 0 < μB) (hLC : 0 < LC) (hγ0 : 0 < γ0) (hγ0' : γ0 < 2 * μB / LC ^ 2) (k : ℕ) :
    1 / stepsPart2 μB LC γ0 (k + 1) ^ 2
      = (1 + 2 * stepsPart2 μB LC γ0 k * (μB - stepsPart2 μB LC γ0 k * LC ^ 2 / 2))
        / stepsPart2 μB LC γ0 k ^ 2 := by sorry

end ThreeOpSplitting.Accel
