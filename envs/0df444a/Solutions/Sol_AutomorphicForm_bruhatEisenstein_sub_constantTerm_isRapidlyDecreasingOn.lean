section DirGauge

variable {d : Type*} [Fintype d] {W : Type*}

private theorem dirFreq_add (m m' : d → ℤ) (c : d → ℝ) : dirFreq (m + m') c = dirFreq m c + dirFreq m' c := by
  simp only [dirFreq, Pi.add_apply, Int.cast_add, add_mul, Finset.sum_add_distrib]

private def dirGauge (c : W → d → ℝ) (a : W → ℝ) : (d → ℤ) →+ (W → ℝ) where
  toFun m := fun w => a w * (2 * π * dirFreq m (c w))
  map_zero' := by
    funext w
    simp only [dirFreq_zero_left, mul_zero, Pi.zero_apply]
  map_add' m m' := by
    funext w
    simp only [Pi.add_apply, dirFreq_add]
    ring

@[scoped simp] private theorem dirGauge_apply (c : W → d → ℝ) (a : W → ℝ) (m : d → ℤ) (w : W) :
    dirGauge c a m w = a w * (2 * π * dirFreq m (c w)) := rfl

private theorem abs_dirGauge_apply (c : W → d → ℝ) {a : W → ℝ} {w : W} (ha : 0 ≤ a w) (m : d → ℤ) :
    |dirGauge c a m w| = a w * (2 * π * |dirFreq m (c w)|) := by
  rw [dirGauge_apply, abs_mul, abs_of_nonneg ha, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * π)]

private theorem gauge_bound_of_weighted_flow_bound {f : UnitAddTorus d → ℂ} (c : W → d → ℝ) {a : W → ℝ} (ha : ∀ w, 0 ≤ a w)
    {k : ℕ} {B : ℝ} (h : ∀ m w, (a w * (2 * π * |dirFreq m (c w)|)) ^ k * ‖mFourierCoeff f m‖ ≤ B) (m : d → ℤ) (w : W) :
    |dirGauge c a m w| ^ k * ‖mFourierCoeff f m‖ ≤ B := by
  rw [abs_dirGauge_apply c (ha w)]
  exact h m w

end DirGauge
