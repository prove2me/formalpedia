open Real
open scoped ContDiff

namespace ExactVacuumAtlas.Schwarzschild.PG

theorem qf_sq {M r : ℝ} (hM : 0 ≤ M) (hr : 0 < r) : qf M r ^ 2 = 2 * M / r :=
  Real.sq_sqrt (by positivity)

@[simp] theorem qf_zero (r : ℝ) : qf 0 r = 0 := by simp [qf]

/-- `x ↦ q(M, x₁)` is `C^∞` on `domEF` for every `M ≥ 0` (for `M = 0` it is the constant `0`). -/
theorem contDiffOn_qf {M : ℝ} (hM : 0 ≤ M) :
    ContDiffOn ℝ ∞ (fun x : Pt 4 => qf M (x 1)) domEF := by
  rcases hM.lt_or_eq with hM' | rfl
  · unfold qf
    fun_prop (disch := (intro x hx; have := domEF_r_pos hx; positivity))
  · simp only [qf_zero]; exact contDiffOn_const

