/-! ## Commands -/

section cmd
variable {U : Type*}

theorem ctlAux_le (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), cur ≤ n → SrcFrom src n ls cur →
      cur ≤ (ctlAux src argOf ls cur).2 ∧ (ctlAux src argOf ls cur).2 ≤ n
  | [], cur, hc, _ => by simp [ctlAux, hc]
  | l :: ls, cur, hc, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs]
      exact ctlAux_le src argOf n ls cur hc h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      have := ctlAux_le src argOf n ls k h2.le h3
      simp only [ctlAux, hs]
      exact ⟨by omega, this.2⟩

variable [Inhabited U]

theorem srcFrom_of_mono {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    ∀ (j : ℕ) (cur : ℕ), j ≤ n' → (∀ l k, l < j → src l = some k → k ≤ cur) →
      (∀ l k, j ≤ l → l < n' → src l = some k → cur ≤ k) →
      SrcFrom src n ((List.range n').drop j) cur := by
  intro j cur hj hlo hhi
  induction hk : n' - j generalizing j cur with
  | zero =>
    rw [List.drop_of_length_le (by simp; omega)]; trivial
  | succ r ih =>
    have hjn : j < n' := by omega
    rw [List.drop_eq_getElem_cons (by simp; exact hjn)]
    simp only [List.getElem_range]
    unfold SrcFrom
    cases hs : src j with
    | none =>
      exact ih (j + 1) cur (by omega)
        (fun l k hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact hlo l k hl hlk
          · rw [hs] at hlk; cases hlk)
        (fun l k hl hln hlk => hhi l k (by omega) hln hlk) (by omega)
    | some k =>
      refine ⟨hhi j k le_rfl hjn hs, h.1 j hjn k hs, ?_⟩
      exact ih (j + 1) k (by omega)
        (fun l k' hl hlk => by
          rcases Nat.lt_succ_iff_lt_or_eq.1 hl with hl | rfl
          · exact h.2 l j k' k hl hjn hlk hs
          · rw [hs] at hlk; cases hlk; exact le_rfl)
        (fun l k' hl hln hlk => h.2 j l k k' (by omega) hln hs hlk) (by omega)

theorem srcFrom_range {n n' : ℕ} {src : ℕ → Option ℕ} (h : MonoSrc n n' src) :
    SrcFrom src n (List.range n') 0 := by
  have := srcFrom_of_mono h 0 0 (Nat.zero_le _) (fun l k hl => absurd hl (Nat.not_lt_zero _))
    (fun _ _ _ _ _ => Nat.zero_le _)
  simpa using this

theorem nDrop_append (a b : List (ℤ × ℤ)) : nDrop (a ++ b) = nDrop a + nDrop b := by
  induction a with
  | nil => simp [nDrop]
  | cons x a ih => obtain ⟨op, _⟩ := x; simp only [List.cons_append, nDrop, ih]; omega

theorem nDrop_drops (j : ℕ) : nDrop (List.replicate j dropC) = j := by
  induction j with
  | zero => rfl
  | succ j ih =>
    rw [List.replicate_succ]
    show (if (-1 : ℤ) < 0 then 1 else 0) + nDrop (List.replicate j dropC) = j + 1
    rw [ih]; simp; omega

theorem nDrop_ctlAux (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (n : ℕ) :
    ∀ (ls : List ℕ) (cur : ℕ), SrcFrom src n ls cur →
      cur + nDrop (ctlAux src argOf ls cur).1 = (ctlAux src argOf ls cur).2
  | [], cur, _ => by simp [ctlAux, nDrop]
  | l :: ls, cur, h => by
    unfold SrcFrom at h
    cases hs : src l with
    | none =>
      rw [hs] at h
      simp only [ctlAux, hs, nDrop, show ¬ (0 : ℤ) < 0 by norm_num, if_false, zero_add]
      exact nDrop_ctlAux src argOf n ls cur h
    | some k =>
      rw [hs] at h
      obtain ⟨h1, h2, h3⟩ := h
      simp only [ctlAux, hs, nDrop_append, nDrop_drops, nDrop,
        show ¬ (1 : ℤ) < 0 by norm_num, if_false, zero_add]
      have := nDrop_ctlAux src argOf n ls k h3
      omega

/-- **A block drops exactly its `n` slabs.** -/
theorem nDrop_ctlOf {n n' : ℕ} {src : ℕ → Option ℕ} (hs : MonoSrc n n' src) (argOf : ℕ → ℤ) :
    nDrop (ctlOf n n' src argOf) = n := by
  have h := nDrop_ctlAux src argOf n (List.range n') 0 (srcFrom_range hs)
  have hle := ctlAux_le src argOf n (List.range n') 0 (Nat.zero_le _) (srcFrom_range hs)
  unfold ctlOf
  rw [nDrop_append, nDrop_drops]
  omega

