open MeasureTheory

theorem levy_foundations_prmEvalSigmaGenerated
    {Ω E : Type*} [MeasurableSpace Ω] [MeasurableSpace E]
    (K : ℕ → Ω → ℕ) (X : ℕ → ℕ → Ω → E)
    (m : Measure E) (R : Set E) :
    LevyFoundations.prmEvalSigma K X m R =
      MeasurableSpace.generateFrom
        (LevyFoundations.prmEvalPiSystem K X m R) := by sorry
