theorem qbarK_qbrt (a : ℝ) (y : Pt 4) : qbarK a y = qbrt a (y 1) (y 2) := qbarK_eq a y

theorem hd_qb_r (a θ u : ℝ) : HasDerivAt (fun u => qbrt a u θ) 1 u :=
  ((hasDerivAt_id' u).ofReal_comp.sub_const (I * ((a * Real.cos θ : ℝ) : ℂ))).congr_deriv (by simp)

theorem qbrt_ne_zero (hx : x ∈ domReg M a Q) : qbrt a (x 1) (x 2) ≠ 0 := by
  rw [← qbarK_qbrt]; exact qbarK_ne_zero (domReg_S hx)

theorem fdir_omL_032 (hx : x ∈ domReg M a Q) :
    fdir (knE M a Q) 1 (omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q) 0 3 2) x
      = ((-Del M a Q (x 1) / (2 * Sig a (x 1) (x 2)) : ℝ) : ℂ) * (1 / qbarK a x ^ 2) := by
  set F : ℝ → ℝ → ℂ := fun r θ => -1 / qbrt a r θ
  have heq : Set.EqOn (omL (gKN M a Q) (giKN M a Q) (knE M a Q) (knTh M a Q) 0 3 2) (fun y => F (y 1) (y 2))
      (domReg M a Q) := fun y hy => by simp only [F]; rw [(omL_KN_mbar hy).2.1, qbarK_qbrt]
  rw [fdir_congr_of_eqOn (isOpen_domReg M a Q) hx heq, fdir_KN_rt (F := F) (fun _ => rfl), knE_1_1, knE_1_2,
    zero_mul, add_zero, qbarK_qbrt]
  congr 1
  refine cpdC_r (F := F) (fun _ => rfl) x ?_
  exact ((hasDerivAt_const (x 1) (-1 : ℂ)).div (hd_qb_r a (x 2) (x 1)) (qbrt_ne_zero hx)).congr_deriv (by ring)

