section
-- Structured compiler adapted from the accepted CNFEncComplexity.sparseRectangle_polytime proof.
-- Uses binary tapes and a fixed finite set of 64 work stacks. Provenance is recorded locally.

namespace GridProgram

open GridMachine

abbrev Work := Fin 64

abbrev Scratch := Option (Bool)
abbrev TapeId := Tape Work

/-- Structured finite-control stack operations. -/
inductive Program
  | push (t : TapeId) (value : Scratch → Gamma t)
  | pop (t : TapeId) (save : Scratch → Option (Gamma t) → Scratch)
  | peek (t : TapeId) (save : Scratch → Option (Gamma t) → Scratch)
  | branch (test : Scratch → Bool) (yes no : Program)
  | loop (t : TapeId) (body : Program)
  | seq (first next : Program)
  | skip

def Program.labels : Program → Nat
  | .push .. | .pop .. | .peek .. | .skip => 1
  | .branch _ yes no => 1 + yes.labels + no.labels
  | .loop _ body => 1 + body.labels
  | .seq first next => first.labels + next.labels

/-- Compile each block with its entry and continuation addresses fixed. -/
def Program.compile : Program → Nat → Nat → List (Cmd Work Nat Scratch)
  | .push t value, _, exit => [.push t value (fun _ => exit)]
  | .pop t save, _, exit => [.pop t save (fun _ => exit)]
  | .peek t save, _, exit => [.peek t save (fun _ => exit)]
  | .skip, _, exit => [.jump (fun _ => exit)]
  | .branch test yes no, start, exit =>
    let y := start + 1
    let n := y + yes.labels
    .jump (fun v => if test v then y else n) :: yes.compile y exit ++ no.compile n exit
  | .loop t body, start, exit =>
    .peek t (fun _ head => if head.isSome then some true else none)
      (fun v => if v.isSome then start + 1 else exit) ::
      body.compile (start + 1) start
  | .seq first next, start, exit =>
    first.compile start (start + first.labels) ++ next.compile (start + first.labels) exit

theorem Program.compile_length (p : Program) (start exit : Nat) :
    (p.compile start exit).length = p.labels := by
  induction p generalizing start exit <;> simp [Program.compile, Program.labels, *, Nat.add_assoc,
    Nat.add_comm]


end GridProgram



namespace GridProgram

open GridMachine StateTransition

/-- Data state independent of the program counter. -/
abbrev Data := Cfg Work Unit Scratch

def atAddress (d : Data) (pc : Nat) : Cfg Work Nat Scratch :=
  ⟨some pc, d.var, d.input, d.output, d.work⟩

def dataPush (d : Data) (t : TapeId) (v : Scratch → Gamma t) : Data :=
  d.set t (v d.var :: d.get t)

def dataPop (d : Data) (t : TapeId) (f : Scratch → Option (Gamma t) → Scratch) : Data :=
  { d.set t (d.get t).tail with var := f d.var (d.get t).head? }

def dataPeek (d : Data) (t : TapeId) (f : Scratch → Option (Gamma t) → Scratch) : Data :=
  { d with var := f d.var (d.get t).head? }

def loopTest (d : Data) (t : TapeId) : Data :=
  { d with var := if (d.get t).isEmpty then none else some true }

inductive Executes : Program → Data → Data → Nat → Prop
  | push (d t v) : Executes (.push t v) d (dataPush d t v) 1
  | pop (d t f) : Executes (.pop t f) d (dataPop d t f) 1
  | peek (d t f) : Executes (.peek t f) d (dataPeek d t f) 1
  | skip (d) : Executes .skip d d 1
  | seq {p q a b c t u} : Executes p a b t → Executes q b c u → Executes (.seq p q) a c (t + u)
  | yes {test p q a b t} : test a.var = true → Executes p a b t → Executes (.branch test p q) a b (1 + t)
  | no {test p q a b t} : test a.var = false → Executes q a b t → Executes (.branch test p q) a b (1 + t)
  | done {tape body d} : (d.get tape).isEmpty = true → Executes (.loop tape body) d (loopTest d tape) 1
  | again {tape body a b c t u} :
      (a.get tape).isEmpty = false → Executes body (loopTest a tape) b t →
      Executes (.loop tape body) b c u → Executes (.loop tape body) a c (1 + t + u)

abbrev MachineCode := Nat → Cmd Work Nat Scratch

def CompiledAt (prog : MachineCode) (p : Program) (start exit : Nat) : Prop :=
  ∀ i, i < p.labels → (p.compile start exit)[i]? = some (prog (start + i))

private theorem code_append_left {prog : MachineCode} {xs ys : List (Cmd Work Nat Scratch)}
    {start : Nat} (h : ∀ i, i < (xs ++ ys).length → (xs ++ ys)[i]? = some (prog (start + i))) :
    ∀ i, i < xs.length → xs[i]? = some (prog (start + i)) := by
  intro i hi
  have hh := h i (by simp; omega)
  rwa [List.getElem?_append_left hi] at hh

private theorem code_append_right {prog : MachineCode} {xs ys : List (Cmd Work Nat Scratch)}
    {start : Nat} (h : ∀ i, i < (xs ++ ys).length → (xs ++ ys)[i]? = some (prog (start + i))) :
    ∀ i, i < ys.length → ys[i]? = some (prog (start + xs.length + i)) := by
  intro i hi
  have hh := h (xs.length + i) (by simp; omega)
  rw [List.getElem?_append_right (by omega : xs.length ≤ xs.length + i)] at hh
  simpa [Nat.add_assoc] using hh

private theorem advance {prog : MachineCode} {a b c : Cfg Work Nat Scratch} {t u : Nat}
    (h : (flip bind (step prog))^[t] (some a) = some b)
    (h' : (flip bind (step prog))^[u] (some b) = some c) :
    (flip bind (step prog))^[t + u] (some a) = some c := by
  rw [Nat.add_comm, Function.iterate_add_apply, h, h']

private theorem single {prog : MachineCode} {a b : Cfg Work Nat Scratch}
    (h : step prog a = some b) : (flip bind (step prog))^[1] (some a) = some b := by
  rw [Function.iterate_one]
  exact h

theorem Executes.compile_correct {p : Program} {a b : Data} {time : Nat}
    (h : Executes p a b time) (prog : MachineCode) (start exit : Nat)
    (hp : CompiledAt prog p start exit) :
    (flip bind (step prog))^[time] (some (atAddress a start)) = some (atAddress b exit) := by
  induction h generalizing start exit with
  | push d t v =>
    have hc := (Option.some.inj (hp 0 (by simp [Program.labels]))).symm
    simp only [Nat.add_zero, Program.compile, List.getElem?_cons_zero] at hc
    apply single
    cases t <;> simp [step, atAddress, hc, dataPush, runCmd, Cfg.get, Cfg.set]
  | pop d t f =>
    have hc := (Option.some.inj (hp 0 (by simp [Program.labels]))).symm
    simp only [Nat.add_zero, Program.compile, List.getElem?_cons_zero] at hc
    apply single
    cases t <;> simp [step, atAddress, hc, dataPop, runCmd, Cfg.get, Cfg.set]
  | peek d t f =>
    have hc := (Option.some.inj (hp 0 (by simp [Program.labels]))).symm
    simp only [Nat.add_zero, Program.compile, List.getElem?_cons_zero] at hc
    apply single
    cases t <;> simp [step, atAddress, hc, dataPeek, runCmd, Cfg.get]
  | skip d =>
    have hc := (Option.some.inj (hp 0 (by simp [Program.labels]))).symm
    simp only [Nat.add_zero, Program.compile, List.getElem?_cons_zero] at hc
    exact single (by simp [step, atAddress, hc, runCmd])
  | @seq p q a b c t u hab hbc ihab ihbc =>
    unfold CompiledAt at hp
    simp only [Program.compile] at hp
    have hregion : ∀ i, i < (p.compile start (start + p.labels) ++
        q.compile (start + p.labels) exit).length →
        (p.compile start (start + p.labels) ++ q.compile (start + p.labels) exit)[i]? =
          some (prog (start + i)) := by
      intro i hi
      apply hp
      simpa [Program.labels, Program.compile_length] using hi
    have hleft : CompiledAt prog p start (start + p.labels) := by
      intro i hi
      apply code_append_left hregion
      simpa [Program.compile_length] using hi
    have hright : CompiledAt prog q (start + p.labels) exit := by
      intro i hi
      simpa only [Program.compile_length] using code_append_right hregion i
        (by simpa [Program.compile_length] using hi)
    exact advance (ihab start (start + p.labels) hleft) (ihbc (start + p.labels) exit hright)
  | @yes test p q a b t ht hab ih =>
    have hc : prog start = .jump (fun v => if test v then start + 1 else start + 1 + p.labels) := by
      have h := hp 0 (by simp [Program.labels] <;> omega)
      exact (Option.some.inj (by simpa [Program.compile] using h)).symm
    have hbody : CompiledAt prog p (start + 1) exit := by
      intro i hi
      have hh := hp (i + 1) (by simp [Program.labels] <;> omega)
      change (p.compile (start + 1) exit ++ q.compile (start + 1 + p.labels) exit)[i]? = _ at hh
      rw [List.getElem?_append_left (by simpa [Program.compile_length] using hi)] at hh
      simpa [Nat.add_assoc, Nat.add_comm i 1] using hh
    exact advance (single (by simp [step, atAddress, hc, runCmd, ht]))
      (ih (start + 1) exit hbody)
  | @no test p q a b t ht hab ih =>
    have hc : prog start = .jump (fun v => if test v then start + 1 else start + 1 + p.labels) := by
      have h := hp 0 (by simp [Program.labels] <;> omega)
      exact (Option.some.inj (by simpa [Program.compile] using h)).symm
    have hbody : CompiledAt prog q (start + 1 + p.labels) exit := by
      intro i hi
      have hh := hp (p.labels + i + 1) (by simp [Program.labels] <;> omega)
      change (p.compile (start + 1) exit ++ q.compile (start + 1 + p.labels) exit)[p.labels + i]? = _ at hh
      rw [List.getElem?_append_right (by simp [Program.compile_length])] at hh
      simpa [Program.compile_length, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hh
    exact advance (single (by simp [step, atAddress, hc, runCmd, ht]))
      (ih (start + 1 + p.labels) exit hbody)
  | @done tape body d ht =>
    have hc : prog start = .peek tape (fun _ head => if head.isSome then some true else none)
        (fun v => if v.isSome then start + 1 else exit) := by
      have h := hp 0 (by simp [Program.labels])
      exact (Option.some.inj (by simpa [Program.compile] using h)).symm
    apply single
    have he : (d.get tape).head? = none := List.head?_eq_none_iff.mpr (List.isEmpty_iff.mp ht)
    cases tape <;> simp_all [step, atAddress, runCmd, loopTest, Cfg.get]
  | @again tape body a b c t u ht hab hbc ihab ihbc =>
    have hc : prog start = .peek tape (fun _ head => if head.isSome then some true else none)
        (fun v => if v.isSome then start + 1 else exit) := by
      have h := hp 0 (by simp [Program.labels])
      exact (Option.some.inj (by simpa [Program.compile] using h)).symm
    have hbody : CompiledAt prog body (start + 1) start := by
      intro i hi
      have hh := hp (i + 1) (by simp [Program.labels] <;> omega)
      change (body.compile (start + 1) start)[i]? = _ at hh
      simpa [Nat.add_assoc, Nat.add_comm i 1] using hh
    have hone : step prog (atAddress a start) = some (atAddress (loopTest a tape) (start + 1)) := by
      have he : (a.get tape).head?.isSome = true := by simpa using ht
      cases tape <;> simp_all [step, atAddress, runCmd, loopTest, Cfg.get]
    exact advance (advance (single hone) (ihab (start + 1) start hbody)) (ihbc start exit hp)

end GridProgram

namespace GridProgram

open GridMachine StateTransition

def Cmd.mapControl {K PC PC' σ : Type} (f : PC → PC') : Cmd K PC σ → Cmd K PC' σ
  | .push t v k => .push t v (f ∘ k)
  | .pop t v k => .pop t v (f ∘ k)
  | .peek t v k => .peek t v (f ∘ k)
  | .load v k => .load v (f ∘ k)
  | .jump k => .jump (f ∘ k)
  | .halt => .halt

def Cfg.mapControl {K PC PC' σ : Type} (f : PC → PC') (c : Cfg K PC σ) : Cfg K PC' σ :=
  ⟨c.l.map f, c.var, c.input, c.output, c.work⟩

theorem mapControl_runCmd {K PC PC' σ : Type} [DecidableEq K] (f : PC → PC')
    (c : Cfg K PC σ) (cmd : Cmd K PC σ) :
    Cfg.mapControl f (runCmd c cmd) = runCmd (Cfg.mapControl f c) (Cmd.mapControl f cmd) := by
  cases cmd with
  | push k => cases k <;> rfl
  | pop k => cases k <;> rfl
  | peek k => cases k <;> rfl
  | load | jump | halt => rfl

/-- One extra label represents all out-of-bounds instruction addresses. -/
def boundedControl (length k : Nat) : Fin (length + 1) :=
  ⟨min k length, Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩

def boundedCode (code : List (Cmd Work Nat Scratch)) (k : Fin (code.length + 1)) :
    Cmd Work (Fin (code.length + 1)) Scratch :=
  Cmd.mapControl (boundedControl code.length) (code[k.val]?.getD .halt)

theorem boundedCode_lookup (code : List (Cmd Work Nat Scratch)) (k : Nat) :
    boundedCode code (boundedControl code.length k) =
      Cmd.mapControl (boundedControl code.length) (code[k]?.getD .halt) := by
  change Cmd.mapControl (boundedControl code.length) (code[min k code.length]?.getD .halt) = _
  by_cases hk : k ≤ code.length
  · rw [Nat.min_eq_left hk]
  · have hle : code.length ≤ k := by omega
    rw [Nat.min_eq_right hle, List.getElem?_eq_none (Nat.le_refl _),
      List.getElem?_eq_none hle]

theorem boundedCode_step (code : List (Cmd Work Nat Scratch)) (c : Cfg Work Nat Scratch) :
    step (boundedCode code) (Cfg.mapControl (boundedControl code.length) c) =
      (step (fun k => code[k]?.getD .halt) c).map (Cfg.mapControl (boundedControl code.length)) := by
  cases hl : c.l with
  | none => simp [step, Cfg.mapControl, hl]
  | some k =>
    have hm : (Cfg.mapControl (boundedControl code.length) c).l =
        some (boundedControl code.length k) := by simp [Cfg.mapControl, hl]
    simp only [step, hm, hl, Option.map_some]
    rw [boundedCode_lookup, ← mapControl_runCmd]

theorem boundedCode_iterate (code : List (Cmd Work Nat Scratch)) (t : Nat)
    (c : Option (Cfg Work Nat Scratch)) :
    (flip bind (step (boundedCode code)))^[t] (c.map (Cfg.mapControl (boundedControl code.length))) =
      ((flip bind (step (fun k => code[k]?.getD .halt)))^[t] c).map
        (Cfg.mapControl (boundedControl code.length)) := by
  induction t generalizing c with
  | zero => rfl
  | succ t ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
    cases c with
    | none => exact ih none
    | some c =>
      change (flip bind (step (boundedCode code)))^[t]
        (step (boundedCode code) (Cfg.mapControl (boundedControl code.length) c)) = _
      rw [boundedCode_step]
      exact ih _

/-- Exact abstract evaluations of a fixed instruction list give a finite TM2 certificate. -/
def certifyCode {α β : Type} (code : List (Cmd Work Nat Scratch))
    (encodeInput : α → List (Bool)) (encodeOutput : β → List Bool) (f : α → β)
    (time : Polynomial Nat)
    (proof : ∀ a, EvalsToInTime (step (fun k => code[k]?.getD .halt))
      (start 0 none (encodeInput a)) (some (finish none (encodeOutput (f a))))
      (time.eval (encodeInput a).length)) :
    Turing.TM2ComputableInPolyTime encodeInput encodeOutput f := by
  apply certify (boundedControl code.length 0) none (boundedCode code) encodeInput encodeOutput f time
  intro a
  let h := proof a
  refine ⟨⟨h.steps, ?_⟩, h.steps_le_m⟩
  have hi := boundedCode_iterate code h.steps (some (start 0 none (encodeInput a)))
  rw [h.evals_in_steps] at hi
  exact hi

end GridProgram


namespace GridProgram

open GridMachine StateTransition

def initialData (input : List Bool) : Data :=
  ⟨some (),none,input,[],fun _ => []⟩

def finalData (output : List Bool) : Data :=
  ⟨some (),none,[],output,fun _ => []⟩

def code (p : Program) : List (Cmd Work Nat Scratch) := p.compile 0 p.labels ++ [.halt]

theorem compiled (p : Program) : CompiledAt (fun i => (code p)[i]?.getD .halt) p 0 p.labels := by
  intro i hi
  have h : i < (p.compile 0 p.labels).length := by rwa [Program.compile_length]
  rw [Nat.zero_add]
  change (p.compile 0 p.labels)[i]? = some ((code p)[i]?.getD .halt)
  unfold code
  rw [List.getElem?_append_left h,List.getElem?_eq_getElem h]
  rfl

theorem code_halt (p : Program) : (code p)[p.labels]? = some (.halt : Cmd Work Nat Scratch) := by
  unfold code
  rw [List.getElem?_append_right (by rw [Program.compile_length]),Program.compile_length]
  simp

def executes_steps (p : Program) (input output : List Bool) (t : Nat)
    (h : Executes p (initialData input) (finalData output) t) :
    EvalsToInTime (step (fun i => (code p)[i]?.getD .halt))
      (start 0 none input) (some (finish none output)) (t+1) := by
  refine ⟨⟨t+1,?_⟩,le_rfl⟩
  rw [Nat.add_comm t 1,Function.iterate_add_apply]
  have hh := h.compile_correct _ 0 p.labels (compiled p)
  change (flip bind (step (fun i => (code p)[i]?.getD .halt)))^[t]
    (some (start 0 none input)) = _ at hh
  rw [hh,Function.iterate_one]
  change step (fun i => (code p)[i]?.getD .halt) (atAddress (finalData output) p.labels) =
    some (finish none output)
  simp [step,atAddress,finalData,runCmd,code_halt,finish]

theorem certifies {α β : Type} (p : Program) (input : α → List Bool)
    (output : β → List Bool) (f : α → β) (bound : Polynomial Nat)
    (h : ∀ a,∃ t,Executes p (initialData (input a)) (finalData (output (f a))) t ∧
      t+1 ≤ bound.eval (input a).length) :
    Nonempty (Turing.TM2ComputableInPolyTime input output f) := by
  classical
  refine ⟨certifyCode (code p) input output f bound (fun a => ?_)⟩
  let t := Classical.choose (h a)
  have ht := Classical.choose_spec (h a)
  exact weaken (executes_steps p _ _ t ht.1) ht.2

end GridProgram
end

-- Helpers from Solutions.GridRegisters
section
-- Unary register primitives adapted from the accepted CNFEncComplexity.sparseRectangle_polytime proof.
-- Binary work alphabet; register 63 is reserved as the copy buffer.
namespace GridRegisters
open GridProgram GridMachine

def buffer : Work := 63

def push (k : Work) (b : Bool := true) : Program := .push (.work k) (fun _ => b)
def pop (k : Work) : Program := .pop (.work k) (fun old _ => old)
def read (k : Work) : Program := .pop (.work k) (fun _ v => v)
def seq : List Program → Program := List.foldr Program.seq .skip
def whileWork (k : Work) (p : Program) : Program := .loop (.work k) p
def clear (k : Work) : Program := whileWork k (pop k)
def reverseWork (source dest : Work) : Program :=
  whileWork source (seq [read source, .push (.work dest) (fun v => v.getD false)])
def add (src dst : Work) : Program :=
  seq [reverseWork src buffer, whileWork buffer (seq [pop buffer,push src,push dst])]
def copy (src dst : Work) : Program := seq [clear dst,add src dst]

abbrev workSet (d : Data) (k : Work) (tape : List (Bool)) : Data :=
  {d with work := Function.update d.work k tape}

abbrev scratchSet (d : Data) (s : Scratch) : Data := {d with var := s}

private theorem workSet_twice (d : Data) (k : Work) (a b : List (Bool)) :
    workSet (workSet d k a) k b = workSet d k b := by
  simp [Function.update_idem]

private theorem workSet_swap (d : Data) (a b : Work) (ha : a ≠ b) (xs ys : List (Bool)) :
    workSet (workSet d a xs) b ys = workSet (workSet d b ys) a xs := by
  simp [Function.update_comm ha]

private theorem workSet_original (d : Data) (k : Work) :
    workSet d k (d.work k) = d := by
  simp only [workSet, Function.update_eq_self]

private theorem scratchSet_workSet (d : Data) (k : Work) (xs : List (Bool)) (s : Scratch) :
    scratchSet (workSet d k xs) s = workSet (scratchSet d s) k xs := rfl

/-- Clearing a work tape takes one loop test per iteration plus one pop. -/
theorem clear_exec (k : Work) (d : Data) :
    Executes (clear k) d (scratchSet (workSet d k []) none) (2 * (d.work k).length + 1) := by
  have run (tape : List (Bool)) (v : Scratch) :
      Executes (clear k) (scratchSet (workSet d k tape) v)
        (scratchSet (workSet d k []) none) (2 * tape.length + 1) := by
    induction tape generalizing v with
    | nil =>
      let a := scratchSet (workSet d k []) v
      have h := Executes.done (body := pop k) (d := a) (tape := .work k) (by
        simp [a, Cfg.get])
      simpa [a, clear, whileWork, loopTest, Cfg.get] using h
    | cons x xs ih =>
      let a := scratchSet (workSet d k (x :: xs)) v
      let b := scratchSet (workSet d k xs) (some true)
      have ht : (a.get (.work k)).isEmpty = false := by
        simp [a, Cfg.get]
      have hp : Executes (pop k) (loopTest a (.work k)) b 1 := by
        simpa [a, b, pop, loopTest, dataPop, Cfg.get, Cfg.set, Function.update_idem] using
          Executes.pop (loopTest a (.work k)) (.work k) (fun old _ => old)
      have h := Executes.again ht hp (ih (some true))
      have htime : 1 + 1 + (2 * xs.length + 1) = 2 * (x :: xs).length + 1 := by simp; omega
      exact htime ▸ h
  simpa only [workSet_original] using run (d.work k) d.var

/-- Reverse a binary work tape into another tape, with the other tapes unchanged. -/
theorem reverseWork_exec (src dst : Work) (hne : src ≠ dst) (d : Data) :
    Executes (reverseWork src dst) d
      (scratchSet (workSet (workSet d src []) dst ((d.work src).reverse ++ d.work dst)) none)
      (4 * (d.work src).length + 1) := by
  have run (tape dstData : List (Bool)) (v : Scratch) :
      Executes (reverseWork src dst) (scratchSet (workSet (workSet d src tape) dst dstData) v)
        (scratchSet (workSet (workSet d src []) dst (tape.reverse ++ dstData)) none)
        (4 * tape.length + 1) := by
    induction tape generalizing dstData v with
    | nil =>
      let a := scratchSet (workSet (workSet d src []) dst dstData) v
      have h := Executes.done
        (body := seq [read src, .push (.work dst) (fun s => s.getD false)])
        (d := a) (tape := .work src) (by simp [a, Cfg.get, Function.update_of_ne hne])
      simpa [a, reverseWork, whileWork, loopTest, Cfg.get, Function.update_of_ne hne] using h
    | cons x xs ih =>
      let a := scratchSet (workSet (workSet d src (x :: xs)) dst dstData) v
      let b := scratchSet (workSet (workSet d src xs) dst dstData) (some x)
      let c := scratchSet (workSet (workSet d src xs) dst (x :: dstData)) (some x)
      have ht : (a.get (.work src)).isEmpty = false := by
        simp [a, Cfg.get, Function.update_of_ne hne]
      have hp : Executes (read src) (loopTest a (.work src)) b 1 := by
        have hpop := Executes.pop (loopTest a (.work src)) (.work src) (fun _ s => s)
        change Executes (read src) (loopTest a (.work src)) (dataPop (loopTest a (.work src))
          (.work src) (fun _ s => s)) 1 at hpop
        convert hpop using 1
        simp only [a, b, loopTest, dataPop, Cfg.get, Cfg.set, Function.update_of_ne hne,
          Function.update_self, List.head?_cons, List.tail_cons]
        rw [Function.update_comm (Ne.symm hne), Function.update_idem]
      have hq : Executes (.push (.work dst) (fun s => s.getD false)) b c 1 := by
        simpa [b, c, dataPush, Cfg.get, Cfg.set, Function.update_idem] using
          Executes.push b (.work dst) (fun s => s.getD false)
      have hseq : Executes (seq [read src, .push (.work dst) (fun s => s.getD false)])
          (loopTest a (.work src)) c 3 :=
        Executes.seq hp (Executes.seq hq (Executes.skip c))
      have h := Executes.again ht hseq (ih (x :: dstData) (some x))
      have htime : 1 + 3 + (4 * xs.length + 1) = 4 * (x :: xs).length + 1 := by simp; omega
      simpa [a, List.reverse_cons, List.append_assoc] using (htime ▸ h)
  simpa only [workSet_original] using run (d.work src) (d.work dst) d.var

private def addLoop (src dst : Work) : Program :=
  whileWork buffer (seq [pop buffer, push src, push dst])

private def addState (src dst : Work) (d : Data) (buf a b : List (Bool)) (s : Scratch) : Data :=
  scratchSet (workSet (workSet (workSet d buffer buf) src a) dst b) s

private theorem addState_buf (src dst : Work) (d : Data) (buf a b : List (Bool)) (s : Scratch)
    (hsc : src ≠ buffer) (hdc : dst ≠ buffer) :
    (addState src dst d buf a b s).work buffer = buf := by
  simp [addState, Function.update_of_ne (Ne.symm hsc), Function.update_of_ne (Ne.symm hdc)]

private theorem addState_src (src dst : Work) (d : Data) (buf a b : List (Bool)) (s : Scratch)
    (hsd : src ≠ dst) :
    (addState src dst d buf a b s).work src = a := by
  simp [addState, Function.update_of_ne hsd]

private theorem addState_dst (src dst : Work) (d : Data) (buf a b : List (Bool)) (s : Scratch) :
    (addState src dst d buf a b s).work dst = b := by simp [addState]

private theorem addState_set_buf (src dst : Work) (d : Data) (buf a b buf' : List (Bool)) (s : Scratch)
    (hsc : src ≠ buffer) (hdc : dst ≠ buffer) :
    workSet (addState src dst d buf a b s) buffer buf' = addState src dst d buf' a b s := by
  unfold addState
  rw [← scratchSet_workSet, workSet_swap _ dst buffer hdc,
    workSet_swap _ src buffer hsc, workSet_twice]

private theorem addState_set_src (src dst : Work) (d : Data) (buf a b a' : List (Bool)) (s : Scratch)
    (hsd : src ≠ dst) :
    workSet (addState src dst d buf a b s) src a' = addState src dst d buf a' b s := by
  unfold addState
  rw [← scratchSet_workSet, workSet_swap _ dst src (Ne.symm hsd), workSet_twice]

private theorem addState_set_dst (src dst : Work) (d : Data) (buf a b b' : List (Bool)) (s : Scratch) :
    workSet (addState src dst d buf a b s) dst b' = addState src dst d buf a b' s := by
  unfold addState
  rw [← scratchSet_workSet, workSet_twice]

private theorem replicate_append_snoc (n : Nat) (l : List (Bool)) :
    List.replicate n (true : Bool) ++ true :: l = List.replicate (n + 1) true ++ l := by
  induction n with
  | zero => rfl
  | succ n h => simpa only [List.replicate_succ, List.cons_append] using congrArg (List.cons true) h

private theorem addLoop_exec (src dst : Work) (d : Data)
    (hsd : src ≠ dst) (hsc : src ≠ buffer) (hdc : dst ≠ buffer)
    (n : Nat) (a b : List (Bool)) (s : Scratch) :
    Executes (addLoop src dst) (addState src dst d (List.replicate n true) a b s)
      (addState src dst d [] (List.replicate n true ++ a) (List.replicate n true ++ b) none)
      (5 * n + 1) := by
  induction n generalizing a b s with
  | zero =>
    let z := addState src dst d [] a b s
    have h := Executes.done (body := seq [pop buffer, push src, push dst])
      (d := z) (tape := .work buffer) (by simp [z, Cfg.get, addState_buf, hsc, hdc])
    have he : loopTest z (.work buffer) = addState src dst d [] a b none := by
      unfold loopTest
      rw [show z.get (.work buffer) = [] from addState_buf src dst d [] a b s hsc hdc]
      rfl
    rw [he] at h
    exact h
  | succ n ih =>
    let tape := List.replicate n (true : Bool)
    let z := addState src dst d (true :: tape) a b s
    let z₁ := addState src dst d tape a b (some true)
    let z₂ := addState src dst d tape (true :: a) b (some true)
    let z₃ := addState src dst d tape (true :: a) (true :: b) (some true)
    have ht : (z.get (.work buffer)).isEmpty = false := by
      simp [z, Cfg.get, addState_buf, hsc, hdc]
    have h₁ : Executes (pop buffer) (loopTest z (.work buffer)) z₁ 1 := by
      have h := Executes.pop (loopTest z (.work buffer)) (.work buffer) (fun old _ => old)
      have hl : loopTest z (.work buffer) =
          addState src dst d (true :: tape) a b (some true) := by
        unfold loopTest
        rw [show z.get (.work buffer) = true :: tape from addState_buf src dst d (true :: tape) a b s hsc hdc]
        rfl
      rw [hl] at h ⊢
      change Executes (pop buffer) _ (dataPop _ _ (fun old _ => old)) 1 at h
      convert h using 1
      change z₁ = workSet (addState src dst d (true :: tape) a b (some true)) buffer
        ((addState src dst d (true :: tape) a b (some true)).work buffer).tail
      rw [addState_buf src dst d (true :: tape) a b (some true) hsc hdc]
      exact (addState_set_buf src dst d (true :: tape) a b tape (some true) hsc hdc).symm
    have h₂ : Executes (push src) z₁ z₂ 1 := by
      have h := Executes.push z₁ (.work src) (fun _ => (true : Bool))
      change Executes (push src) z₁ (dataPush z₁ (.work src) _) 1 at h
      convert h using 1
      change z₂ = workSet z₁ src (true :: z₁.work src)
      rw [show z₁.work src = a from addState_src src dst d tape a b (some true) hsd]
      exact (addState_set_src src dst d tape a b (true :: a) (some true) hsd).symm
    have h₃ : Executes (push dst) z₂ z₃ 1 := by
      have h := Executes.push z₂ (.work dst) (fun _ => (true : Bool))
      change Executes (push dst) z₂ (dataPush z₂ (.work dst) _) 1 at h
      convert h using 1
      change z₃ = workSet z₂ dst (true :: z₂.work dst)
      rw [show z₂.work dst = b from addState_dst src dst d tape (true :: a) b (some true)]
      exact (addState_set_dst src dst d tape (true :: a) b (true :: b) (some true)).symm
    have hbody : Executes (seq [pop buffer, push src, push dst])
        (loopTest z (.work buffer)) z₃ 4 :=
      Executes.seq h₁ (Executes.seq h₂ (Executes.seq h₃ (Executes.skip z₃)))
    have h := Executes.again ht hbody (ih (true :: a) (true :: b) (some true))
    have htime : 1 + 4 + (5 * n + 1) = 5 * (n + 1) + 1 := by omega
    rw [replicate_append_snoc, replicate_append_snoc] at h
    exact htime ▸ h

/-- Unary addition restores the source and clears its scratch tape. -/
theorem add_exec (src dst : Work) (d : Data) (n : Nat)
    (hsd : src ≠ dst) (hsc : src ≠ buffer) (hdc : dst ≠ buffer)
    (hs : d.work src = List.replicate n true) (hc : d.work buffer = []) :
    Executes (add src dst) d
      (scratchSet (workSet d dst (List.replicate n true ++ d.work dst)) none)
      (9 * n + 3) := by
  have h₁ := reverseWork_exec src buffer hsc d
  rw [hs, hc, List.reverse_replicate, List.append_nil, List.length_replicate] at h₁
  have h₂ := addLoop_exec src dst d hsd hsc hdc n [] (d.work dst) none
  have hdata : addState src dst d (List.replicate n true) [] (d.work dst) none =
      scratchSet (workSet (workSet d src []) buffer (List.replicate n true)) none := by
    unfold addState
    rw [workSet_swap _ buffer src (Ne.symm hsc)]
    have hdst : (workSet (workSet d src []) buffer (List.replicate n true)).work dst = d.work dst := by
      simp [Function.update_of_ne (Ne.symm hsd), Function.update_of_ne hdc]
    rw [← hdst, workSet_original]
  have hend : addState src dst d [] (List.replicate n true ++ []) (List.replicate n true ++ d.work dst) none =
      scratchSet (workSet d dst (List.replicate n true ++ d.work dst)) none := by
    unfold addState
    rw [List.append_nil, ← hc, workSet_original, ← hs, workSet_original]
  rw [hdata, hend] at h₂
  have h := Executes.seq h₁ (Executes.seq h₂ (Executes.skip _))
  have htime : (4 * n + 1) + ((5 * n + 1) + 1) = 9 * n + 3 := by omega
  exact htime ▸ h

/-- Unary copy clears the destination, preserves the source, and empties the scratch tape. -/
theorem copy_exec (src dst : Work) (d : Data) (n : Nat)
    (hsd : src ≠ dst) (hsc : src ≠ buffer) (hdc : dst ≠ buffer)
    (hs : d.work src = List.replicate n true) (hc : d.work buffer = []) :
    Executes (copy src dst) d
      (scratchSet (workSet d dst (List.replicate n true)) none)
      (2 * (d.work dst).length + 9 * n + 5) := by
  have h₁ := clear_exec dst d
  let e := scratchSet (workSet d dst []) none
  have hs' : e.work src = List.replicate n true := by
    simpa [e, Function.update_of_ne hsd] using hs
  have hc' : e.work buffer = [] := by
    simpa [e, Function.update_of_ne (Ne.symm hdc)] using hc
  have h₂ := add_exec src dst e n hsd hsc hdc hs' hc'
  have hend : scratchSet (workSet e dst (List.replicate n true ++ e.work dst)) none =
      scratchSet (workSet d dst (List.replicate n true)) none := by
    simp [e, Function.update_idem]
  rw [hend] at h₂
  have h := Executes.seq h₁ (Executes.seq h₂ (Executes.skip _))
  have htime : (2 * (d.work dst).length + 1) + ((9 * n + 3) + 1) =
      2 * (d.work dst).length + 9 * n + 5 := by omega
  exact htime ▸ h


end GridRegisters
end

-- Helpers from Solutions.GridNatProgram
section
namespace GridNatProgram
open GridProgram GridMachine

abbrev Reg := Fin 62
def reg (r : Reg) : Work := ⟨r.val,by omega⟩
def outputReg : Work := 62

structure State where
  regs : Reg → ℕ
  output : List Bool

def State.set (s : State) (r : Reg) (n : ℕ) : State :=
  {s with regs := Function.update s.regs r n}

def State.emit (s : State) (b : Bool) : State := {s with output := b :: s.output}

def work (s : State) (k : Work) : List Bool :=
  if h : k.val < 62 then List.replicate (s.regs ⟨k.val,h⟩) true
  else if k = outputReg then s.output else []

def repr (s : State) (v : Scratch) : Data := ⟨some (),v,[],[],work s⟩

@[simp] lemma repr_reg (s : State) (v : Scratch) (r : Reg) :
    (repr s v).work (reg r) = List.replicate (s.regs r) true := by
  simp [repr,work,reg,r.isLt]

@[simp] lemma repr_output (s : State) (v : Scratch) : (repr s v).work outputReg = s.output := by
  simp [repr,work,outputReg]

@[simp] lemma repr_buffer (s : State) (v : Scratch) : (repr s v).work GridRegisters.buffer = [] := by
  simp [repr,work,GridRegisters.buffer,outputReg]

lemma reg_injective : Function.Injective reg := by
  intro r t h
  exact Fin.ext (congrArg (fun x : Work => x.val) h)

lemma reg_ne_buffer (r : Reg) : reg r ≠ GridRegisters.buffer := by
  intro h
  have := congrArg Fin.val h
  dsimp [reg,GridRegisters.buffer] at this
  omega

lemma work_set (s : State) (r : Reg) (n : ℕ) :
    work (s.set r n) = Function.update (work s) (reg r) (List.replicate n true) := by
  funext k
  by_cases hk : k = reg r
  · subst k
    simp [work,State.set,reg,r.isLt]
  · by_cases hl : k.val < 62
    · have hr : (⟨k.val,hl⟩ : Reg) ≠ r := by
        intro h
        apply hk
        exact Fin.ext (congrArg (fun x : Reg => x.val) h)
      simp [work,State.set,hl,Function.update_of_ne hr,Function.update_of_ne hk]
    · simp [work,State.set,hl,Function.update_of_ne hk]

lemma repr_set (s : State) (v : Scratch) (r : Reg) (n : ℕ) :
    GridRegisters.workSet (repr s v) (reg r) (List.replicate n true) = repr (s.set r n) v := by
  simp only [GridRegisters.workSet,repr,work_set]

lemma repr_emit (s : State) (v : Scratch) (b : Bool) :
    GridRegisters.workSet (repr s v) outputReg (b :: s.output) = repr (s.emit b) v := by
  unfold GridRegisters.workSet repr
  congr 1
  funext k
  by_cases hk : k = outputReg
  · subst k
    simp [work,outputReg,State.emit]
  · by_cases hl : k.val < 62
    · simp [Function.update_of_ne hk,work,State.emit,hl]
    · simp [Function.update_of_ne hk,work,State.emit,hl,hk]

inductive Code
  | zero (r : Reg)
  | inc (r : Reg)
  | dec (r : Reg)
  | copy (src dst : Reg) (hne : src ≠ dst)
  | add (src dst : Reg) (hne : src ≠ dst)
  | emit (b : Bool)
  | skip
  | seq (p q : Code)
  | ifZero (r : Reg) (yes no : Code)
  | loop (r : Reg) (body : Code)

def compile : Code → Program
  | .zero r => GridRegisters.clear (reg r)
  | .inc r => GridRegisters.push (reg r)
  | .dec r => GridRegisters.pop (reg r)
  | .copy a b _ => GridRegisters.copy (reg a) (reg b)
  | .add a b _ => GridRegisters.add (reg a) (reg b)
  | .emit b => .push (.work outputReg) (fun _ => b)
  | .skip => .skip
  | .seq p q => .seq (compile p) (compile q)
  | .ifZero r yes no => .seq (.peek (.work (reg r)) (fun _ v => v))
      (.branch Option.isNone (compile yes) (compile no))
  | .loop r body => .loop (.work (reg r)) (compile body)

inductive Runs : Code → State → State → ℕ → Prop
  | zero (s r) : Runs (.zero r) s (s.set r 0) (2*s.regs r+1)
  | inc (s r) : Runs (.inc r) s (s.set r (s.regs r+1)) 1
  | dec (s r) : Runs (.dec r) s (s.set r (s.regs r-1)) 1
  | copy (s src dst h) : Runs (.copy src dst h) s (s.set dst (s.regs src))
      (2*s.regs dst+9*s.regs src+5)
  | add (s src dst h) : Runs (.add src dst h) s (s.set dst (s.regs src+s.regs dst))
      (9*s.regs src+3)
  | emit (s b) : Runs (.emit b) s (s.emit b) 1
  | skip (s) : Runs .skip s s 1
  | seq {p q a b c t u} : Runs p a b t → Runs q b c u → Runs (.seq p q) a c (t+u)
  | yes {r p q a b t} : a.regs r = 0 → Runs p a b t → Runs (.ifZero r p q) a b (2+t)
  | no {r p q a b t} : a.regs r ≠ 0 → Runs q a b t → Runs (.ifZero r p q) a b (2+t)
  | done {r body s} : s.regs r = 0 → Runs (.loop r body) s s 1
  | again {r body a b c t u} : a.regs r ≠ 0 → Runs body a b t →
      Runs (.loop r body) b c u → Runs (.loop r body) a c (1+t+u)

lemma inc_exec (s : State) (v : Scratch) (r : Reg) :
    Executes (compile (.inc r)) (repr s v) (repr (s.set r (s.regs r+1)) v) 1 := by
  have h := Executes.push (repr s v) (.work (reg r)) (fun _ => true)
  change Executes (compile (.inc r)) (repr s v)
    (GridRegisters.workSet (repr s v) (reg r) (true :: (repr s v).work (reg r))) 1 at h
  rw [repr_reg,← List.replicate_succ,repr_set] at h
  exact h

lemma dec_exec (s : State) (v : Scratch) (r : Reg) :
    Executes (compile (.dec r)) (repr s v) (repr (s.set r (s.regs r-1)) v) 1 := by
  have h := Executes.pop (repr s v) (.work (reg r)) (fun old _ => old)
  change Executes (compile (.dec r)) (repr s v)
    (GridRegisters.workSet (repr s v) (reg r) ((repr s v).work (reg r)).tail) 1 at h
  rw [repr_reg,List.tail_replicate,repr_set] at h
  exact h

lemma peek_exec (s : State) (v : Scratch) (r : Reg) :
    Executes (.peek (.work (reg r)) (fun _ x => x)) (repr s v)
      (repr s (List.replicate (s.regs r) true).head?) 1 := by
  have h := Executes.peek (repr s v) (.work (reg r)) (fun _ x => x)
  have he : dataPeek (repr s v) (.work (reg r)) (fun _ x => x) =
      repr s (List.replicate (s.regs r) true).head? := by
    simp only [dataPeek,Cfg.get,repr_reg]
    rfl
  rw [he] at h
  exact h

theorem compile_correct {p : Code} {s t : State} {steps : ℕ} (h : Runs p s t steps)
    (v : Scratch) : ∃ v',Executes (compile p) (repr s v) (repr t v') steps := by
  induction h generalizing v with
  | zero s r =>
    refine ⟨none,?_⟩
    have h := GridRegisters.clear_exec (reg r) (repr s v)
    rw [repr_reg,List.length_replicate] at h
    have hr := repr_set s v r 0
    simp only [List.replicate_zero] at hr
    rw [hr] at h
    exact h
  | inc s r => exact ⟨v,inc_exec s v r⟩
  | dec s r => exact ⟨v,dec_exec s v r⟩
  | copy s src dst hne =>
    refine ⟨none,?_⟩
    have h := GridRegisters.copy_exec (reg src) (reg dst) (repr s v) (s.regs src)
      (fun h => hne (reg_injective h)) (reg_ne_buffer _) (reg_ne_buffer _)
      (repr_reg _ _ _) (repr_buffer _ _)
    rw [repr_reg,List.length_replicate,repr_set] at h
    exact h
  | add s src dst hne =>
    refine ⟨none,?_⟩
    have h := GridRegisters.add_exec (reg src) (reg dst) (repr s v) (s.regs src)
      (fun h => hne (reg_injective h)) (reg_ne_buffer _) (reg_ne_buffer _)
      (repr_reg _ _ _) (repr_buffer _ _)
    rw [repr_reg,← List.replicate_add,repr_set] at h
    exact h
  | emit s b =>
    refine ⟨v,?_⟩
    have h := Executes.push (repr s v) (.work outputReg) (fun _ => b)
    change Executes (compile (.emit b)) (repr s v)
      (GridRegisters.workSet (repr s v) outputReg (b :: (repr s v).work outputReg)) 1 at h
    rw [repr_output,repr_emit] at h
    exact h
  | skip s => exact ⟨v,.skip _⟩
  | seq hab hbc ihab ihbc =>
    obtain ⟨w,hw⟩ := ihab v
    obtain ⟨z,hz⟩ := ihbc w
    exact ⟨z,.seq hw hz⟩
  | @yes r p q a b t hz hab ih =>
    obtain ⟨w,hw⟩ := ih none
    refine ⟨w,?_⟩
    have hp := peek_exec a v r
    simp only [hz,List.replicate_zero,List.head?_nil] at hp
    have hb : Executes (.branch Option.isNone (compile p) (compile q))
        (repr a none) (repr b w) (1+t) := .yes rfl hw
    convert Executes.seq hp hb using 1 <;> first | rfl | omega
  | @no r p q a b t hz hab ih =>
    obtain ⟨w,hw⟩ := ih (some true)
    refine ⟨w,?_⟩
    have hp := peek_exec a v r
    have hn : (List.replicate (a.regs r) true).head? = some true := by
      cases he : a.regs r <;> simp_all [List.replicate_succ]
    rw [hn] at hp
    have hb : Executes (.branch Option.isNone (compile p) (compile q))
        (repr a (some true)) (repr b w) (1+t) := .no rfl hw
    convert Executes.seq hp hb using 1 <;> first | rfl | omega
  | @done r body s hz =>
    refine ⟨none,?_⟩
    have h := Executes.done (body := compile body) (d := repr s v) (tape := .work (reg r))
      (by simp [Cfg.get,hz])
    have he : loopTest (repr s v) (.work (reg r)) = repr s none := by
      unfold loopTest
      rw [show (repr s v).get (.work (reg r)) = List.replicate (s.regs r) true from repr_reg _ _ _,hz]
      rfl
    rw [he] at h
    exact h
  | @again r body a b c t u hz hab hbc ihab ihbc =>
    obtain ⟨w,hw⟩ := ihab (some true)
    obtain ⟨z,hz'⟩ := ihbc w
    refine ⟨z,?_⟩
    have hne : ((repr a v).get (.work (reg r))).isEmpty = false := by
      simp [Cfg.get,hz]
    have htest : loopTest (repr a v) (.work (reg r)) = repr a (some true) := by
      unfold loopTest
      rw [hne]
      rfl
    exact .again hne (by simpa only [htest] using hw) hz'

end GridNatProgram
end

-- Helpers from Solutions.GridNatArithmetic
section
namespace GridNatArithmetic
open GridNatProgram

@[simp] lemma set_get (s : State) (r : Reg) (n : ℕ) : (s.set r n).regs r = n := by
  simp [State.set]

@[simp] lemma set_other (s : State) {r k : Reg} (n : ℕ) (h : k ≠ r) :
    (s.set r n).regs k = s.regs k := by simp [State.set,h]

@[simp] lemma set_output (s : State) (r : Reg) (n : ℕ) :
    (s.set r n).output = s.output := rfl

@[ext] lemma state_ext {s t : State} (h : ∀ r,s.regs r = t.regs r)
    (ho : s.output = t.output) : s = t := by
  cases s
  cases t
  congr
  exact funext h

@[simp] lemma set_self (s : State) (r : Reg) : s.set r (s.regs r) = s := by
  simp [State.set,Function.update_eq_self]

@[simp] lemma set_twice (s : State) (r : Reg) (a b : ℕ) :
    (s.set r a).set r b = s.set r b := by simp [State.set,Function.update_idem]

lemma set_comm (s : State) {r k : Reg} (a b : ℕ) (hne : r ≠ k) :
    (s.set r a).set k b = (s.set k b).set r a := by
  apply state_ext
  · intro i
    by_cases hi : i = r <;> by_cases hk : i = k <;> simp_all [State.set]
  · rfl

def subtractLoop (fuel dst : Reg) : Code := .loop fuel (.seq (.dec fuel) (.dec dst))

theorem subtractLoop_runs (s : State) (fuel dst : Reg) (hne : fuel ≠ dst) :
    Runs (subtractLoop fuel dst) s
      ((s.set dst (s.regs dst-s.regs fuel)).set fuel 0) (3*s.regs fuel+1) := by
  generalize hn : s.regs fuel = n
  induction n generalizing s with
  | zero =>
    have he : (s.set dst (s.regs dst-0)).set fuel 0 = s := by
      simp only [Nat.sub_zero,set_self]
      rw [← hn,set_self]
    rw [he]
    exact Runs.done hn
  | succ n ih =>
    let e := (s.set fuel n).set dst (s.regs dst-1)
    have hbody : Runs (.seq (.dec fuel) (.dec dst)) s e 2 := by
      have ha := Runs.dec s fuel
      have hb := Runs.dec (s.set fuel (s.regs fuel-1)) dst
      convert Runs.seq ha hb using 1 <;> simp [e,hn,hne.symm]
    have he : e.regs fuel = n := by simp [e,hne]
    have ht := ih e he
    have hend : ((e.set dst (e.regs dst-n)).set fuel 0) =
        ((s.set dst (s.regs dst-(n+1))).set fuel 0) := by
      apply state_ext
      · intro k
        by_cases hk : k = fuel
        · subst k; simp
        · by_cases hd : k = dst
          · subst k; simp [e,hne.symm]; omega
          · simp [e,hk,hd]
      · rfl
    rw [hend] at ht
    have hh := Runs.again (by omega : s.regs fuel ≠ 0) hbody ht
    convert hh using 1 <;> first | rfl | omega

def subtract (src dst fuel : Reg) (hsf : src ≠ fuel) : Code :=
  .seq (.copy src fuel hsf) (subtractLoop fuel dst)

theorem subtract_runs (s : State) (src dst fuel : Reg)
    (hsf : src ≠ fuel) (hfd : fuel ≠ dst) :
    Runs (subtract src dst fuel hsf) s
      ((s.set dst (s.regs dst-s.regs src)).set fuel 0)
      (2*s.regs fuel+12*s.regs src+6) := by
  have hc := Runs.copy s src fuel hsf
  have hl := subtractLoop_runs (s.set fuel (s.regs src)) fuel dst hfd
  have hend : (((s.set fuel (s.regs src)).set dst
      ((s.set fuel (s.regs src)).regs dst - (s.set fuel (s.regs src)).regs fuel)).set fuel 0) =
      ((s.set dst (s.regs dst-s.regs src)).set fuel 0) := by
    simp only [set_get,set_other _ _ hfd.symm]
    rw [set_comm _ _ _ hfd,set_twice]
  rw [hend] at hl
  have hh := Runs.seq hc hl
  simp only [set_get] at hh
  convert hh using 1 <;> first | rfl | omega

def addLoop (fuel src dst : Reg) (hsd : src ≠ dst) : Code :=
  .loop fuel (.seq (.dec fuel) (.add src dst hsd))

theorem addLoop_runs (s : State) (fuel src dst : Reg)
    (hfs : fuel ≠ src) (hfd : fuel ≠ dst) (hsd : src ≠ dst) :
    Runs (addLoop fuel src dst hsd) s
      ((s.set dst (s.regs dst+s.regs fuel*s.regs src)).set fuel 0)
      (s.regs fuel*(9*s.regs src+5)+1) := by
  generalize hn : s.regs fuel = n
  induction n generalizing s with
  | zero =>
    have he : (s.set dst (s.regs dst+0*s.regs src)).set fuel 0 = s := by
      simp only [Nat.zero_mul,Nat.add_zero,set_self]
      rw [← hn,set_self]
    rw [he]
    simpa only [addLoop,Nat.zero_mul,Nat.zero_add] using
      (Runs.done (body := .seq (.dec fuel) (.add src dst hsd)) hn)
  | succ n ih =>
    let e := (s.set fuel n).set dst (s.regs src+s.regs dst)
    have hbdy : Runs (.seq (.dec fuel) (.add src dst hsd)) s e (9*s.regs src+4) := by
      have ha := Runs.dec s fuel
      have hb := Runs.add (s.set fuel (s.regs fuel-1)) src dst hsd
      convert Runs.seq ha hb using 1 <;> simp [e,hn,hfs.symm,hfd.symm] <;> omega
    have he : e.regs fuel = n := by simp [e,hfd]
    have hs : e.regs src = s.regs src := by simp [e,hsd,hfs.symm]
    have ht := ih e he
    have hend : ((e.set dst (e.regs dst+n*e.regs src)).set fuel 0) =
        ((s.set dst (s.regs dst+(n+1)*s.regs src)).set fuel 0) := by
      apply state_ext
      · intro k
        by_cases hk : k = fuel
        · subst k; simp
        · by_cases hd : k = dst
          · subst k; simp [e,hfd.symm,hs]; ring
          · simp [e,hk,hd]
      · rfl
    rw [hend,hs] at ht
    have hh := Runs.again (by omega : s.regs fuel ≠ 0) hbdy ht
    convert hh using 1 <;> first | rfl | ring

def multiply (x y dst fuel : Reg) (hxf : x ≠ fuel) (hyd : y ≠ dst) : Code :=
  .seq (.zero dst) (.seq (.copy x fuel hxf) (addLoop fuel y dst hyd))

theorem multiply_runs (s : State) (x y dst fuel : Reg)
    (hxd : x ≠ dst) (hyd : y ≠ dst) (hxf : x ≠ fuel)
    (hfy : fuel ≠ y) (hfd : fuel ≠ dst) :
    Runs (multiply x y dst fuel hxf hyd) s
      ((s.set dst (s.regs x*s.regs y)).set fuel 0)
      (2*s.regs dst+2*s.regs fuel+9*s.regs x*s.regs y+14*s.regs x+7) := by
  let a := s.set dst 0
  let b := a.set fuel (a.regs x)
  have hh := Runs.seq (Runs.zero s dst) (Runs.seq (Runs.copy a x fuel hxf)
    (addLoop_runs b fuel y dst hfy hfd hyd))
  convert hh using 1
  · rfl
  · apply state_ext
    · intro k
      by_cases hk : k = fuel <;> by_cases hd : k = dst
      all_goals simp [a,b,State.set,hk,hd,hxd,hyd,hfy.symm,hfd.symm]
    · rfl
  · simp [a,b,State.set,hxd,hyd,hfy.symm,hfd]
    ring

end GridNatArithmetic
end

-- Helpers from Solutions.GridNatControl
section
namespace GridNatControl
open GridNatProgram GridNatArithmetic

def Bounded (s : State) (M : ℕ) : Prop := ∀ r,s.regs r ≤ M

lemma bounded_set {s : State} {M : ℕ} (h : Bounded s M) (r : Reg) (n : ℕ) (hn : n ≤ M) :
    Bounded (s.set r n) M := by
  intro k
  by_cases hk : k = r
  · subst k; simpa using hn
  · simpa [hk] using h k

def cleared (s : State) (rs : List Reg) : State :=
  ⟨fun r => if r ∈ rs then 0 else s.regs r,s.output⟩

def clear : List Reg → Code
  | [] => .skip
  | r :: rs => .seq (.zero r) (clear rs)

lemma cleared_cons (s : State) (r : Reg) (rs : List Reg) :
    cleared (s.set r 0) rs = cleared s (r :: rs) := by
  apply state_ext
  · intro k
    by_cases hr : k = r <;> by_cases hs : k ∈ rs <;> simp [cleared,State.set,hr,hs]
  · rfl

theorem clear_runs (rs : List Reg) (s : State) (M : ℕ) (hM : Bounded s M) :
    ∃ t,Runs (clear rs) s (cleared s rs) t ∧ t ≤ (2*M+1)*rs.length+1 := by
  induction rs generalizing s with
  | nil => exact ⟨1,Runs.skip s,by simp⟩
  | cons r rs ih =>
    obtain ⟨t,ht,hbound⟩ := ih (s.set r 0) (bounded_set hM r 0 (by omega))
    rw [cleared_cons] at ht
    refine ⟨_,Runs.seq (Runs.zero s r) ht,?_⟩
    simp only [List.length_cons]
    have hr := hM r
    nlinarith only [hbound,hr]

def highRegisters (k : ℕ) : List Reg := (List.finRange 62).filter fun r => k ≤ r.val
def clearAbove (k : ℕ) : Code := clear (highRegisters k)

lemma mem_highRegisters (k : ℕ) (r : Reg) : r ∈ highRegisters k ↔ k ≤ r.val := by
  simp [highRegisters]

lemma highRegisters_length (k : ℕ) : (highRegisters k).length ≤ 62 := by
  calc
    (highRegisters k).length ≤ (List.finRange 62).length := List.length_filter_le _ _
    _ = 62 := by simp

theorem clearAbove_runs (k : ℕ) (s : State) (M : ℕ) (hM : Bounded s M) :
    ∃ t,Runs (clearAbove k) s
      ⟨fun r => if k ≤ r.val then 0 else s.regs r,s.output⟩ t ∧ t ≤ 124*M+63 := by
  obtain ⟨t,ht,hbound⟩ := clear_runs (highRegisters k) s M hM
  have he : cleared s (highRegisters k) =
      (⟨fun r => if k ≤ r.val then 0 else s.regs r,s.output⟩ : State) := by
    simp only [cleared,mem_highRegisters]
  rw [he] at ht
  refine ⟨t,ht,?_⟩
  have hl := highRegisters_length k
  nlinarith only [hbound,hl,Nat.mul_le_mul_left (2*M+1) hl]

def increments (r : Reg) : ℕ → Code
  | 0 => .skip
  | n+1 => .seq (.inc r) (increments r n)

lemma increments_runs (r : Reg) (n : ℕ) (s : State) :
    Runs (increments r n) s (s.set r (s.regs r+n)) (n+1) := by
  induction n generalizing s with
  | zero => simpa only [increments,Nat.add_zero,set_self] using Runs.skip s
  | succ n ih =>
    have hh := Runs.seq (Runs.inc s r) (ih (s.set r (s.regs r+1)))
    simp only [set_get,set_twice] at hh
    convert hh using 1 <;> simp only [increments,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm]

def literal (r : Reg) (n : ℕ) : Code := .seq (.zero r) (increments r n)

theorem literal_runs (s : State) (r : Reg) (n : ℕ) :
    Runs (literal r n) s (s.set r n) (2*s.regs r+n+2) := by
  have hh := Runs.seq (Runs.zero s r) (increments_runs r n (s.set r 0))
  simp only [set_get,Nat.zero_add,set_twice] at hh
  convert hh using 1 <;> first | rfl | omega

/-- A fixed loop body with a per-iteration execution bound. The supplied states
    also certify the actual fuel value, so termination is part of the proof. -/
theorem loop_range (body : Code) (fuel : Reg) (N B : ℕ) (s : ℕ → State)
    (hf : ∀ i ≤ N,(s i).regs fuel = N-i)
    (hb : ∀ i < N,∃ t,Runs body (s i) (s (i+1)) t ∧ t ≤ B) :
    ∃ t,Runs (.loop fuel body) (s 0) (s N) t ∧ t ≤ (B+1)*N+1 := by
  induction N generalizing s with
  | zero => exact ⟨1,Runs.done (hf 0 (by omega)),by omega⟩
  | succ N ih =>
    have htail : ∀ i ≤ N,(s (i+1)).regs fuel = N-i := by
      intro i hi
      have h := hf (i+1) (by omega)
      simpa only [Nat.add_sub_add_right] using h
    obtain ⟨t,ht,hbound⟩ := ih (fun i => s (i+1)) htail (by
      intro i hi
      exact hb (i+1) (by omega))
    obtain ⟨u,hu,hub⟩ := hb 0 (by omega)
    have hnz : (s 0).regs fuel ≠ 0 := by have := hf 0 (by omega); omega
    refine ⟨_,Runs.again hnz hu ht,?_⟩
    nlinarith only [hbound,hub]

end GridNatControl
end

-- Helpers from Solutions.GridNatDivision
section
/-!
Unary quotient/remainder subroutine for the index decoder. Register 47 stores
the divisor, 48 and 49 the quotient and remainder, 50 the remaining input, and
51 a countdown to the next quotient increment. All other registers are preserved.
-/
namespace GridNatDivision
open GridNatProgram GridNatArithmetic

def frame (s : State) (q r f c : ℕ) : State :=
  (((s.set 48 q).set 49 r).set 50 f).set 51 c

def body : Code := .seq (.dec 50) (.seq (.dec 51) (.seq (.inc 49)
  (.ifZero 51 (.seq (.inc 48) (.seq (.zero 49) (.copy 47 51 (by decide)))) .skip)))

def tick (y q r : ℕ) : ℕ × ℕ := if r+1 = y then (q+1,0) else (q,r+1)

lemma tick_spec (y q r : ℕ) (hr : r < y) :
    (tick y q r).2 < y ∧
    (tick y q r).1*y+(tick y q r).2 = q*y+r+1 := by
  unfold tick
  split_ifs with h <;> simp only [Prod.fst,Prod.snd]
  · constructor <;> nlinarith only [h,hr]
  · constructor <;> omega

lemma body_runs (s : State) (y q r f : ℕ) (hy : s.regs 47 = y) (hr : r < y) :
    ∃ t, Runs body (frame s q r (f+1) (y-r))
      (frame s (tick y q r).1 (tick y q r).2 f (y-(tick y q r).2)) t ∧
      t ≤ 11*y+12 := by
  let z := frame s q r (f+1) (y-r)
  let a := z.set 50 f
  let b := a.set 51 (y-r-1)
  let c := b.set 49 (r+1)
  have h₁ : Runs (.dec 50) z a 1 := by
    convert Runs.dec z 50 using 1
    simp [a,z,frame]
  have h₂ : Runs (.dec 51) a b 1 := by
    convert Runs.dec a 51 using 1
    simp [b,a,z,frame]
  have h₃ : Runs (.inc 49) b c 1 := by
    convert Runs.inc b 49 using 1
    simp [c,b,a,z,frame]
  by_cases hstop : r+1 = y
  · let d := c.set 48 (q+1)
    let e := d.set 49 0
    have hc : c.regs 51 = 0 := by simp [c,b,a,z,frame]; omega
    have h₄ : Runs (.inc 48) c d 1 := by
      convert Runs.inc c 48 using 1
      simp [d,c,b,a,z,frame]
    have h₅ : Runs (.zero 49) d e (2*y+1) := by
      convert Runs.zero d 49 using 1 <;> simp [e,d,c,b,a,z,frame,hstop]
    have h₆ : Runs (.copy 47 51 (by decide)) e (e.set 51 y) (9*y+5) := by
      convert Runs.copy e 47 51 (by decide) using 1
      · simp [e,d,c,b,a,z,frame,hy]
      · simp [e,d,c,b,a,z,frame,hy]
        omega
    have hend : e.set 51 y = frame s (tick y q r).1 (tick y q r).2 f (y-(tick y q r).2) := by
      apply state_ext
      · intro k
        by_cases h₄₈ : k = 48 <;> by_cases h₄₉ : k = 49 <;>
          by_cases h₅₀ : k = 50 <;> by_cases h₅₁ : k = 51
        all_goals simp [e,d,c,b,a,z,frame,State.set,tick,hstop,h₄₈,h₄₉,h₅₀,h₅₁]
      · rfl
    have hbranch := Runs.yes (q := Code.skip) hc (Runs.seq h₄ (Runs.seq h₅ h₆))
    have hh := Runs.seq h₁ (Runs.seq h₂ (Runs.seq h₃ hbranch))
    rw [hend] at hh
    refine ⟨_,hh,?_⟩
    omega
  · have hc : c.regs 51 ≠ 0 := by simp [c,b,a,z,frame]; omega
    have hend : c = frame s (tick y q r).1 (tick y q r).2 f (y-(tick y q r).2) := by
      apply state_ext
      · intro k
        by_cases h₄₈ : k = 48 <;> by_cases h₄₉ : k = 49 <;>
          by_cases h₅₀ : k = 50 <;> by_cases h₅₁ : k = 51
        all_goals simp [c,b,a,z,frame,State.set,tick,hstop,h₄₈,h₄₉,h₅₀,h₅₁] <;> omega
      · rfl
    have hbranch := Runs.no (p := Code.seq (.inc 48) (.seq (.zero 49) (.copy 47 51 (by decide))))
      hc (Runs.skip c)
    have hh := Runs.seq h₁ (Runs.seq h₂ (Runs.seq h₃ hbranch))
    rw [hend] at hh
    exact ⟨_,hh,by omega⟩

def loop : Code := .loop 50 body

theorem loop_runs (f : ℕ) (s : State) (y q r : ℕ) (hy : s.regs 47 = y) (hr : r < y) :
    ∃ q' r' t, Runs loop (frame s q r f (y-r)) (frame s q' r' 0 (y-r')) t ∧
      r' < y ∧ q'*y+r' = q*y+r+f ∧ t ≤ (11*y+13)*f+1 := by
  induction f generalizing q r with
  | zero =>
    refine ⟨q,r,1,Runs.done (by simp [frame]),hr,by omega,by omega⟩
  | succ f ih =>
    obtain ⟨u,hu,hub⟩ := body_runs s y q r f hy hr
    have hspec := tick_spec y q r hr
    obtain ⟨q',r',t,ht,hr',he,htb⟩ := ih (tick y q r).1 (tick y q r).2 hspec.1
    have hh := Runs.again (by simp [frame] : (frame s q r (f+1) (y-r)).regs 50 ≠ 0) hu ht
    refine ⟨q',r',_,hh,hr',?_,?_⟩
    · omega
    · nlinarith only [hub,htb]

theorem loop_divmod (s : State) (x y : ℕ) (hy : s.regs 47 = y) (hpos : 0 < y) :
    ∃ t, Runs loop (frame s 0 0 x y) (frame s (x/y) (x%y) 0 (y-x%y)) t ∧
      t ≤ (11*y+13)*x+1 := by
  obtain ⟨q,r,t,ht,hr,he,hbound⟩ := loop_runs x s y 0 0 hy hpos
  simp only [Nat.zero_mul,Nat.zero_add,Nat.sub_zero] at ht he
  have hq : x/y = q := by
    rw [← he,Nat.add_comm,Nat.add_mul_div_right _ _ hpos,Nat.div_eq_of_lt hr,Nat.zero_add]
  have hm : x%y = r := by
    rw [← he,Nat.mul_add_mod_self_right,Nat.mod_eq_of_lt hr]
  rw [hq,hm]
  exact ⟨t,ht,hbound⟩

def initializeCode : Code := .seq (.zero 48) (.seq (.zero 49)
  (.seq (.copy 46 50 (by decide)) (.copy 47 51 (by decide))))

lemma initialize_runs (s : State) :
    Runs initializeCode s (frame s 0 0 (s.regs 46) (s.regs 47))
      (2*(s.regs 48+s.regs 49+s.regs 50+s.regs 51)+9*s.regs 46+9*s.regs 47+12) := by
  let a := s.set 48 0
  let b := a.set 49 0
  let c := b.set 50 (b.regs 46)
  have hh := Runs.seq (Runs.zero s 48) (Runs.seq (Runs.zero a 49)
    (Runs.seq (Runs.copy b 46 50 (by decide)) (Runs.copy c 47 51 (by decide))))
  convert hh using 1
  · rfl
  · simp [a,b,c,frame]
  · simp [a,b,c]
    ring

def zeroCase : Code := .seq (.zero 50) (.seq (.zero 51) (.copy 46 49 (by decide)))

lemma zeroCase_runs (s : State) (x : ℕ) (hx : s.regs 46 = x) :
    Runs zeroCase (frame s 0 0 x 0) (frame s 0 x 0 0) (11*x+7) := by
  let a := frame s 0 0 x 0
  let b := a.set 50 0
  let c := b.set 51 0
  have hh := Runs.seq (Runs.zero a 50) (Runs.seq (Runs.zero b 51)
    (Runs.copy c 46 49 (by decide)))
  convert hh using 1
  · rfl
  · apply state_ext
    · intro k
      by_cases h₄₈ : k = 48 <;> by_cases h₄₉ : k = 49 <;>
        by_cases h₅₀ : k = 50 <;> by_cases h₅₁ : k = 51
      all_goals simp [a,b,c,frame,State.set,hx,h₄₈,h₄₉,h₅₀,h₅₁]
    · rfl
  · simp [a,b,c,frame,hx]
    omega

def program : Code := .seq initializeCode (.ifZero 47 zeroCase (.seq loop (.zero 51)))

theorem program_runs (s : State) : ∃ t,
    Runs program s (frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0 0) t ∧
      t ≤ 2*(s.regs 48+s.regs 49+s.regs 50+s.regs 51)+
        11*s.regs 46*s.regs 47+22*s.regs 46+11*s.regs 47+30 := by
  have hi := initialize_runs s
  by_cases hz : s.regs 47 = 0
  · rw [hz] at hi
    have hb := zeroCase_runs s (s.regs 46) rfl
    have hbranch : Runs (.ifZero 47 zeroCase (.seq loop (.zero 51)))
        (frame s 0 0 (s.regs 46) 0) (frame s 0 (s.regs 46) 0 0)
        (2+(11*s.regs 46+7)) := Runs.yes (by simp [frame,hz]) hb
    rw [hz,Nat.div_zero,Nat.mod_zero]
    refine ⟨_,Runs.seq hi hbranch,?_⟩
    omega
  · obtain ⟨t,ht,hbound⟩ := loop_divmod s (s.regs 46) (s.regs 47) rfl (by omega)
    let a := frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0
      (s.regs 47-s.regs 46%s.regs 47)
    have hclear : Runs (.zero 51) a
        (frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0 0)
        (2*(s.regs 47-s.regs 46%s.regs 47)+1) := by
      simpa only [a,frame,set_get,set_twice] using Runs.zero a 51
    have hbranch := Runs.no (r := 47) (p := zeroCase) (by simpa [frame] using hz) (Runs.seq ht hclear)
    refine ⟨_,Runs.seq hi hbranch,?_⟩
    have hrem : s.regs 47-s.regs 46%s.regs 47 ≤ s.regs 47 := Nat.sub_le _ _
    nlinarith only [hbound,hrem]

theorem polynomial_bound (s : State) (M : ℕ) (hM : ∀ r,s.regs r ≤ M) :
    ∃ t, Runs program s (frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0 0) t ∧
      t ≤ 100*(M+1)^2 := by
  obtain ⟨t,ht,hbound⟩ := program_runs s
  refine ⟨t,ht,?_⟩
  have hm : s.regs 46*s.regs 47 ≤ M*M := Nat.mul_le_mul (hM 46) (hM 47)
  nlinarith only [hbound,hm,hM 46,hM 47,hM 48,hM 49,hM 50,hM 51,Nat.zero_le (M*M)]

end GridNatDivision
end

-- Helpers from Solutions.GridScratch
section
namespace GridScratch
open GridNatProgram GridNatArithmetic GridNatControl

inductive BinOp | add | sub | mul | div | mod

def BinOp.eval : BinOp → ℕ → ℕ → ℕ
  | .add,a,b => a+b
  | .sub,a,b => a-b
  | .mul,a,b => a*b
  | .div,a,b => a/b
  | .mod,a,b => a%b

def code : BinOp → Code
  | .add => .seq (.copy 46 48 (by decide)) (.add 47 48 (by decide))
  | .sub => .seq (.copy 46 48 (by decide)) (subtract 47 48 52 (by decide))
  | .mul => multiply 46 47 48 52 (by decide) (by decide)
  | .div => GridNatDivision.program
  | .mod => .seq GridNatDivision.program (.copy 49 48 (by decide))

def SameLow (s t : State) : Prop := ∀ r : Reg,r.val < 32 → t.regs r = s.regs r

lemma sameLow_refl (s : State) : SameLow s s := fun _ _ => rfl

lemma sameLow_trans {s t u : State} (hst : SameLow s t) (htu : SameLow t u) : SameLow s u :=
  fun r hr => (htu r hr).trans (hst r hr)

lemma sameLow_set (s : State) (r : Reg) (n : ℕ) (hr : 32 ≤ r.val) : SameLow s (s.set r n) := by
  intro k hk
  have hne : k ≠ r := by intro h; subst k; omega
  exact set_other s n hne

lemma bounded_mono {s : State} {M N : ℕ} (h : Bounded s M) (hle : M ≤ N) : Bounded s N :=
  fun r => (h r).trans hle

lemma basic_bound (M : ℕ) : M ≤ 2*(M+1)^2 ∧ M+M ≤ 2*(M+1)^2 ∧ M*M ≤ 2*(M+1)^2 := by
  constructor
  · nlinarith only [Nat.zero_le (M*M)]
  · constructor <;> nlinarith only [Nat.zero_le (M*M)]

lemma division_bounded (s : State) (M : ℕ) (hM : Bounded s M) :
    Bounded (GridNatDivision.frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0 0) M := by
  apply bounded_set
  · apply bounded_set
    · apply bounded_set
      · apply bounded_set hM
        exact (Nat.div_le_self _ _).trans (hM 46)
      · exact (Nat.mod_le _ _).trans (hM 46)
    · omega
  · omega

lemma division_sameLow (s : State) (q r f c : ℕ) :
    SameLow s (GridNatDivision.frame s q r f c) := by
  intro k hk
  have h₄₈ : k ≠ (48 : Reg) := by intro h; subst k; norm_num at hk
  have h₄₉ : k ≠ (49 : Reg) := by intro h; subst k; norm_num at hk
  have h₅₀ : k ≠ (50 : Reg) := by intro h; subst k; norm_num at hk
  have h₅₁ : k ≠ (51 : Reg) := by intro h; subst k; norm_num at hk
  simp [GridNatDivision.frame,h₄₈,h₄₉,h₅₀,h₅₁]

theorem runs (op : BinOp) (s : State) (M : ℕ) (hM : Bounded s M) :
    ∃ u t,Runs (code op) s u t ∧ u.regs 48 = op.eval (s.regs 46) (s.regs 47) ∧
      SameLow s u ∧ u.output = s.output ∧ Bounded u (2*(M+1)^2) ∧ t ≤ 200*(M+1)^2 := by
  have hb := basic_bound M
  have hMs := bounded_mono hM hb.1
  have hx := hM 46
  have hy := hM 47
  have hz := hM 48
  have hf := hM 52
  cases op with
  | add =>
    let u := s.set 48 (s.regs 46+s.regs 47)
    have hh : Runs (code .add) s u (2*s.regs 48+9*s.regs 46+9*s.regs 47+8) := by
      have h := Runs.seq (Runs.copy s 46 48 (by decide))
        (Runs.add (s.set 48 (s.regs 46)) 47 48 (by decide))
      simp only [set_get,set_other _ _ (by decide : (47 : Reg) ≠ 48),set_twice] at h
      convert h using 1 <;> first | rfl | (simp [u,Nat.add_comm] <;> omega)
    refine ⟨u,_,hh,by simp [u,BinOp.eval],sameLow_set _ _ _ (by decide),rfl,?_,?_⟩
    · exact bounded_set hMs 48 _ (by omega)
    · nlinarith only [hx,hy,hz,Nat.zero_le (M*M)]
  | sub =>
    let u := (s.set 48 (s.regs 46-s.regs 47)).set 52 0
    have hh : Runs (code .sub) s u (2*s.regs 48+9*s.regs 46+2*s.regs 52+12*s.regs 47+11) := by
      have h := Runs.seq (Runs.copy s 46 48 (by decide))
        (subtract_runs (s.set 48 (s.regs 46)) 47 48 52 (by decide) (by decide))
      simp only [set_get,set_other _ _ (by decide : (47 : Reg) ≠ 48),
        set_other _ _ (by decide : (52 : Reg) ≠ 48),set_twice] at h
      convert h using 1 <;> first | rfl | omega
    refine ⟨u,_,hh,by simp [u,BinOp.eval],?_,rfl,?_,?_⟩
    · exact sameLow_trans (sameLow_set _ _ _ (by decide)) (sameLow_set _ _ _ (by decide))
    · apply bounded_set
      · exact bounded_set hMs 48 _ ((Nat.sub_le _ _).trans (hx.trans hb.1))
      · omega
    · nlinarith only [hx,hy,hz,hf,Nat.zero_le (M*M)]
  | mul =>
    let u := (s.set 48 (s.regs 46*s.regs 47)).set 52 0
    have hh := multiply_runs s 46 47 48 52 (by decide) (by decide) (by decide) (by decide) (by decide)
    refine ⟨u,_,hh,by simp [u,BinOp.eval],?_,rfl,?_,?_⟩
    · exact sameLow_trans (sameLow_set _ _ _ (by decide)) (sameLow_set _ _ _ (by decide))
    · apply bounded_set
      · exact bounded_set hMs 48 _ ((Nat.mul_le_mul hx hy).trans hb.2.2)
      · omega
    · have hm := Nat.mul_le_mul hx hy
      nlinarith only [hm,hx,hz,hf,Nat.zero_le (M*M)]
  | div =>
    obtain ⟨t,ht,hbound⟩ := GridNatDivision.polynomial_bound s M hM
    refine ⟨_,t,ht,by simp [GridNatDivision.frame,BinOp.eval],division_sameLow _ _ _ _ _,rfl,?_,by omega⟩
    exact bounded_mono (division_bounded s M hM) hb.1
  | mod =>
    obtain ⟨t,ht,hbound⟩ := GridNatDivision.polynomial_bound s M hM
    let a := GridNatDivision.frame s (s.regs 46/s.regs 47) (s.regs 46%s.regs 47) 0 0
    let u := a.set 48 (a.regs 49)
    have hh := Runs.seq ht (Runs.copy a 49 48 (by decide))
    refine ⟨u,_,hh,by simp [u,a,GridNatDivision.frame,BinOp.eval],?_,rfl,?_,?_⟩
    · exact sameLow_trans (division_sameLow _ _ _ _ _) (sameLow_set _ _ _ (by decide))
    · apply bounded_set (bounded_mono (division_bounded s M hM) hb.1)
      exact ((division_bounded s M hM) 49).trans hb.1
    · have hq := (division_bounded s M hM) 48
      have hr := (division_bounded s M hM) 49
      change a.regs 48 ≤ M at hq
      change a.regs 49 ≤ M at hr
      nlinarith only [hbound,hq,hr,Nat.zero_le (M*M)]

end GridScratch
end

-- Helpers from Solutions.GridConstruction
section
open ResultantVNP Finset MvPolynomial
open scoped Classical

namespace GridConstruction

theorem side_form (n : ℕ) : ∃ r,1 ≤ r ∧ gridSide n = 3 ^ r + 1 :=
  ⟨Nat.find (gridSide_exists n),(Nat.find_spec (gridSide_exists n)).1,rfl⟩

theorem side_gt (n : ℕ) : n < gridSide n := (Nat.find_spec (gridSide_exists n)).2

theorem side_ge_four (n : ℕ) : 4 ≤ gridSide n := by
  obtain ⟨r,hr,he⟩ := side_form n
  have h := Nat.pow_le_pow_right (by omega : 1 ≤ 3) hr
  rw [he]
  norm_num at h
  omega

theorem side_linear (n : ℕ) (hn : 1 ≤ n) : gridSide n ≤ 4 * n := by
  let r := Nat.find (gridSide_exists n)
  have hr : 1 ≤ r := (Nat.find_spec (gridSide_exists n)).1
  change 3 ^ r + 1 ≤ 4 * n
  by_cases he : r = 1
  · rw [he]
    norm_num
    omega
  · have hprev : ¬ (1 ≤ r-1 ∧ n < 3 ^ (r-1) + 1) :=
      Nat.find_min (gridSide_exists n) (by omega : r-1 < r)
    have hpow : 3 ^ (r-1) ≤ n := by omega
    have hs : r = r-1+1 := by omega
    rw [hs,pow_succ]
    omega

theorem state_card : Fintype.card GridState = 5 := by decide

theorem class_card (m : ℕ) [NeZero m] (p : ZMod m × ZMod m) :
    Fintype.card {α : GridIdx m // α.1 = p} = 5 := by
  let e : {α : GridIdx m // α.1 = p} ≃ GridState :=
    { toFun := fun a => a.val.2
      invFun := fun a => ⟨(p,a),rfl⟩
      left_inv := by intro a; apply Subtype.ext; exact Prod.ext a.property.symm rfl
      right_inv := fun _ => rfl }
  exact (Fintype.card_congr e).trans state_card

theorem encoding_supported (n m : ℕ) [NeZero m] :
    SupportedOnGrid (fun α : GridIdx m => α.1) (gridEncoding n m) := by
  classical
  intro T hT
  unfold gridEncoding at hT
  obtain ⟨p,_,hp⟩ := Finset.exists_ne_zero_of_sum_ne_zero hT
  obtain ⟨a,_,ha⟩ := Finset.exists_ne_zero_of_sum_ne_zero hp
  obtain ⟨b,_,hb⟩ := Finset.exists_ne_zero_of_sum_ne_zero ha
  obtain ⟨c,_,hc⟩ := Finset.exists_ne_zero_of_sum_ne_zero hb
  by_cases ht : T = (p,a) ::ₛ (gridRight p,b) ::ₛ (gridDown p,c) ::ₛ Sym.nil ∧ gridTest m p a b c
  · exact ⟨p,(p,a),(gridRight p,b),(gridDown p,c),rfl,rfl,rfl,ht.1⟩
  · simp [ht] at hc

def triangle {m : ℕ} (p : ZMod m × ZMod m) : Sym (ZMod m × ZMod m) 3 :=
  p ::ₛ gridRight p ::ₛ gridDown p ::ₛ Sym.nil

lemma three_unit (r : ℕ) (hr : 1 ≤ r) : IsUnit (3 : ZMod (3^r+1)) := by
  apply (ZMod.isUnit_iff_coprime 3 (3^r+1)).mpr
  have h : Nat.Coprime (3^r) (3^r+1) := by simp
  exact h.of_dvd_left (dvd_pow_self 3 (by omega))

lemma triangle_injective (r : ℕ) (hr : 1 ≤ r) :
    Function.Injective (triangle (m := 3^r+1)) := by
  intro p q h
  have h1 := congrArg (fun T : Sym (ZMod (3^r+1) × ZMod (3^r+1)) 3 =>
    ((T : Multiset (ZMod (3^r+1) × ZMod (3^r+1))).map (fun p => p.1)).sum) h
  have h2 := congrArg (fun T : Sym (ZMod (3^r+1) × ZMod (3^r+1)) 3 =>
    ((T : Multiset (ZMod (3^r+1) × ZMod (3^r+1))).map (fun p => p.2)).sum) h
  have hfst : (3 : ZMod (3^r+1)) * p.1 = 3 * q.1 := by
    simp only [triangle,gridRight,gridDown,Sym.coe_cons,Sym.coe_nil,
      Multiset.map_cons,Multiset.map_zero,Multiset.sum_cons,Multiset.sum_zero] at h1
    linear_combination h1
  have hsnd : (3 : ZMod (3^r+1)) * p.2 = 3 * q.2 := by
    simp only [triangle,gridRight,gridDown,Sym.coe_cons,Sym.coe_nil,
      Multiset.map_cons,Multiset.map_zero,Multiset.sum_cons,Multiset.sum_zero] at h2
    linear_combination h2
  exact Prod.ext ((three_unit r hr).mul_left_cancel hfst) ((three_unit r hr).mul_left_cancel hsnd)


lemma triangle_injective_side (n : ℕ) : Function.Injective (triangle (m := gridSide n)) :=
  triangle_injective (Nat.find (gridSide_exists n)) (Nat.find_spec (gridSide_exists n)).1

def entryTriangle {m : ℕ} (p : ZMod m × ZMod m) (a b c : GridState) : Sym (GridIdx m) 3 :=
  (p,a) ::ₛ (gridRight p,b) ::ₛ (gridDown p,c) ::ₛ Sym.nil

lemma entryTriangle_classes {m : ℕ} (p : ZMod m × ZMod m) (a b c : GridState) :
    Sym.map Prod.fst (entryTriangle p a b c) = triangle p := by
  simp only [entryTriangle,triangle,Sym.map_cons]
  rfl

lemma positions_distinct {m : ℕ} (hm : 3 ≤ m) (p : ZMod m × ZMod m) :
    p ≠ gridRight p ∧ p ≠ gridDown p ∧ gridRight p ≠ gridDown p := by
  letI : Fact (1 < m) := ⟨by omega⟩
  constructor
  · intro h
    have h' := congrArg Prod.fst h
    simpa [gridRight] using h'
  · constructor
    · intro h
      have h' := congrArg Prod.snd h
      simpa [gridDown] using h'
    · intro h
      have h' := congrArg Prod.fst h
      simpa [gridRight,gridDown] using h'

lemma entryTriangle_states {m : ℕ} (hm : 3 ≤ m) (p : ZMod m × ZMod m)
    (a b c a' b' c' : GridState) (h : entryTriangle p a b c = entryTriangle p a' b' c') :
    a = a' ∧ b = b' ∧ c = c' := by
  obtain ⟨hpr,hpd,hrd⟩ := positions_distinct hm p
  have ha : (p,a) ∈ entryTriangle p a' b' c' := by rw [← h]; simp [entryTriangle]
  have hb : (gridRight p,b) ∈ entryTriangle p a' b' c' := by rw [← h]; simp [entryTriangle]
  have hc : (gridDown p,c) ∈ entryTriangle p a' b' c' := by rw [← h]; simp [entryTriangle]
  simp only [entryTriangle,Sym.mem_cons,Sym.notMem_nil,or_false,Prod.mk.injEq] at ha hb hc
  exact ⟨by simpa [hpr,hpd] using ha,
    by simpa [hpr.symm,hrd] using hb,
    by simpa [hpd.symm,hrd.symm] using hc⟩

theorem entryTriangle_injective (n : ℕ) :
    Function.Injective (fun u : (ZMod (gridSide n) × ZMod (gridSide n)) × GridState × GridState × GridState =>
      entryTriangle u.1 u.2.1 u.2.2.1 u.2.2.2) := by
  intro u v h
  obtain ⟨p,a,b,c⟩ := u
  obtain ⟨p',a',b',c'⟩ := v
  have hcls := congrArg (Sym.map (Prod.fst : GridIdx (gridSide n) → _)) h
  simp only [entryTriangle_classes] at hcls
  have hp := triangle_injective_side n hcls
  subst p'
  have hs := entryTriangle_states (by have := side_ge_four n; omega) p a b c a' b' c' h
  rcases hs with ⟨rfl,rfl,rfl⟩
  rfl

theorem encoding_entry (n : ℕ) (p : ZMod (gridSide n) × ZMod (gridSide n)) (a b c : GridState) :
    gridTensor n (entryTriangle p a b c) =
      if gridTest (gridSide n) p a b c then
        (if a.1.1 = 1 then paddedEntry n (gridSide n) p else 1) else 0 := by
  classical
  unfold gridTensor gridEncoding
  have heq (p' : ZMod (gridSide n) × ZMod (gridSide n)) (a' b' c' : GridState) :
      entryTriangle p a b c = entryTriangle p' a' b' c' ↔
        p = p' ∧ a = a' ∧ b = b' ∧ c = c' := by
    simpa only [Prod.mk.injEq] using (entryTriangle_injective n).eq_iff
      (a := (p,a,b,c)) (b := (p',a',b',c'))
  change (∑ p',∑ a',∑ b',∑ c',if entryTriangle p a b c = entryTriangle p' a' b' c' ∧
    gridTest (gridSide n) p' a' b' c' then
      (if a'.1.1 = 1 then paddedEntry n (gridSide n) p' else 1) else 0) = _
  simp_rw [heq]
  simp [ite_and,Finset.sum_ite_irrel]

lemma paddedEntry_cases (n m : ℕ) (p : ZMod m × ZMod m) :
    paddedEntry n m p = 0 ∨ paddedEntry n m p = 1 ∨ ∃ ij,paddedEntry n m p = X ij := by
  unfold paddedEntry
  split_ifs
  · exact Or.inr (Or.inr ⟨_,rfl⟩)
  · exact Or.inr (Or.inl rfl)
  · exact Or.inl rfl

theorem tensor_entries (n : ℕ) (T : Sym (GridIdx (gridSide n)) 3) :
    gridTensor n T = 0 ∨ gridTensor n T = 1 ∨ ∃ ij,gridTensor n T = X ij := by
  by_cases hz : gridTensor n T = 0
  · exact Or.inl hz
  obtain ⟨p,a,b,c,ha,hb,hc,hT⟩ := encoding_supported n (gridSide n) T hz
  have ha' : a = (p,a.2) := Prod.ext ha rfl
  have hb' : b = (gridRight p,b.2) := Prod.ext hb rfl
  have hc' : c = (gridDown p,c.2) := Prod.ext hc rfl
  rw [ha',hb',hc'] at hT
  change T = entryTriangle p a.2 b.2 c.2 at hT
  rw [hT,encoding_entry]
  split_ifs
  · exact paddedEntry_cases n (gridSide n) p
  · exact Or.inr (Or.inl rfl)
  · exact Or.inl rfl

theorem assignment_zero_one (n : ℕ) (Z : Matrix (Fin n) (Fin n) ℤ)
    (hZ : ∀ i j,Z i j = 0 ∨ Z i j = 1)
    (ν : ∀ p,{α : GridIdx (gridSide n) // α.1 = p}) :
    eval (fun ij => Z ij.1 ij.2) (∏ p,gridTensor n (assignTriple (fun α => α.1) ν p)) = 0 ∨
      eval (fun ij => Z ij.1 ij.2) (∏ p,gridTensor n (assignTriple (fun α => α.1) ν p)) = 1 := by
  classical
  rw [map_prod]
  have hentry (p : ZMod (gridSide n) × ZMod (gridSide n)) :
      eval (fun ij => Z ij.1 ij.2) (gridTensor n (assignTriple (fun α => α.1) ν p)) = 0 ∨
        eval (fun ij => Z ij.1 ij.2) (gridTensor n (assignTriple (fun α => α.1) ν p)) = 1 := by
    rcases tensor_entries n (assignTriple (fun α => α.1) ν p) with hz | ho | ⟨ij,hij⟩
    · left; rw [hz,map_zero]
    · right; rw [ho,map_one]
    · rw [hij,eval_X]; exact hZ ij.1 ij.2
  by_cases hz : ∃ p,eval (fun ij => Z ij.1 ij.2) (gridTensor n (assignTriple (fun α => α.1) ν p)) = 0
  · obtain ⟨p,hp⟩ := hz
    exact Or.inl (Finset.prod_eq_zero (Finset.mem_univ p) hp)
  · right
    apply Finset.prod_eq_one
    intro p _
    exact (hentry p).resolve_left (fun hp => hz ⟨p,hp⟩)

lemma count_ones_eq_sum {α : Type} [Fintype α] (f : α → ℤ) (hf : ∀ a,f a = 0 ∨ f a = 1) :
    (Fintype.card {a // f a = 1} : ℤ) = ∑ a,f a := by
  classical
  rw [Fintype.card_subtype,Finset.card_eq_sum_ones,Nat.cast_sum]
  simp only [Nat.cast_one,Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro a _
  rcases hf a with h | h <;> simp [h]

lemma permanent_count (n : ℕ) (Z : Matrix (Fin n) (Fin n) ℤ)
    (hZ : ∀ i j,Z i j = 0 ∨ Z i j = 1) :
    Z.permanent = (Fintype.card {σ : Equiv.Perm (Fin n) // ∀ i,Z i (σ i) = 1} : ℤ) := by
  classical
  have hprod (σ : Equiv.Perm (Fin n)) :
      (∏ i,Z i (σ i)) = if ∀ i,Z i (σ i) = 1 then 1 else 0 := by
    split_ifs with h
    · exact Finset.prod_eq_one (fun i _ => h i)
    · push_neg at h
      obtain ⟨i,hi⟩ := h
      exact Finset.prod_eq_zero (Finset.mem_univ i) ((hZ i (σ i)).resolve_right hi)
  rw [← Matrix.permanent_transpose Z,Matrix.permanent]
  simp only [Matrix.transpose_apply,hprod]
  rw [Fintype.card_subtype,Finset.card_eq_sum_ones,Nat.cast_sum]
  simp only [Nat.cast_one,Finset.sum_filter]

theorem count_preservation_of_identity (n : ℕ)
    (hid : gridSum (fun α : GridIdx (gridSide n) => α.1) (gridTensor n) =
      (Matrix.of fun i j : Fin n => (X (i,j) : MvPolynomial (Fin n × Fin n) ℤ)).permanent)
    (Z : Matrix (Fin n) (Fin n) ℤ) (hZ : ∀ i j,Z i j = 0 ∨ Z i j = 1) :
    Fintype.card {ν : (∀ p,{α : GridIdx (gridSide n) // α.1 = p}) //
      eval (fun ij => Z ij.1 ij.2) (∏ p,gridTensor n (assignTriple (fun α => α.1) ν p)) = 1} =
      Fintype.card {σ : Equiv.Perm (Fin n) // ∀ i,Z i (σ i) = 1} := by
  classical
  have heval := congrArg (eval (fun ij => Z ij.1 ij.2)) hid
  rw [gridSum,map_sum] at heval
  have hright : eval (fun ij => Z ij.1 ij.2)
      (Matrix.of fun i j : Fin n => (X (i,j) : MvPolynomial (Fin n × Fin n) ℤ)).permanent = Z.permanent := by
    simp [Matrix.permanent]
  rw [hright,permanent_count n Z hZ] at heval
  exact_mod_cast (count_ones_eq_sum _ (assignment_zero_one n Z hZ)).trans heval

end GridConstruction
end

-- Helpers from Solutions.GridSideAlgorithm
section
open ResultantVNP GridConstruction

namespace GridSideAlgorithm

/-- A bounded loop: start at four and replace k by 3k-2 until k exceeds n. -/
def run (n : ℕ) : ℕ → ℕ → ℕ
  | 0,k => k
  | fuel+1,k => if n < k then k else run n fuel (3*k-2)

def compute (n : ℕ) : ℕ := run n n 4

lemma run_correct (n fuel r : ℕ) (hr : 1 ≤ r)
    (hle : r ≤ Nat.find (gridSide_exists n))
    (hbound : Nat.find (gridSide_exists n) ≤ r+fuel) :
    run n fuel (3^r+1) = gridSide n := by
  induction fuel generalizing r with
  | zero =>
    have he : r = Nat.find (gridSide_exists n) := by omega
    simp [run,he,gridSide]
  | succ fuel ih =>
    simp only [run]
    split_ifs with hstop
    · have hh : Nat.find (gridSide_exists n) ≤ r := Nat.find_min' _ ⟨hr,hstop⟩
      have he : r = Nat.find (gridSide_exists n) := by omega
      simp [he,gridSide]
    · have hlt : r < Nat.find (gridSide_exists n) := by
        by_contra hn
        have he : r = Nat.find (gridSide_exists n) := by omega
        exact hstop (by simpa [he] using (Nat.find_spec (gridSide_exists n)).2)
      have hstep : 3*(3^r+1)-2 = 3^(r+1)+1 := by
        rw [pow_succ]
        omega
      rw [hstep]
      exact ih (r+1) (by omega) (by omega) (by omega)

lemma compute_eq (n : ℕ) : compute n = gridSide n := by
  have hp : n < 3^(n+1)+1 := by
    have hh : n < 3^(n+1) := by
      induction n with
      | zero => norm_num
      | succ n ih =>
        rw [pow_succ]
        omega
    omega
  have hb : Nat.find (gridSide_exists n) ≤ n+1 := Nat.find_min' _ ⟨by omega,hp⟩
  exact run_correct n n 1 (by omega) (Nat.find_spec (gridSide_exists n)).1 (by omega)

lemma compute_linear (n : ℕ) : compute n ≤ 4*(n+1) := by
  rw [compute_eq]
  by_cases hn : n = 0
  · subst n
    rw [← compute_eq]
    decide
  · have := side_linear n (by omega)
    omega

end GridSideAlgorithm
end

-- Helpers from Solutions.GridTableAlgorithm
section
open ResultantVNP GridConstruction MvPolynomial

namespace GridTableAlgorithm

abbrev Candidate (m : ℕ) := (ZMod m × ZMod m) × GridState × GridState × GridState

def candidates (m : ℕ) : List (Candidate m) :=
  (List.range m).flatMap fun (i : ℕ) => (List.range m).flatMap fun (j : ℕ) =>
    (List.range 5).flatMap fun a => (List.range 5).flatMap fun b =>
      (List.range 5).map fun c =>
        (((i : ZMod m),(j : ZMod m)),gridStateOfNat a,gridStateOfNat b,gridStateOfNat c)

instance testDecidable (m : ℕ) (p : ZMod m × ZMod m) (a b c : GridState) :
    Decidable (gridTest m p a b c) := by unfold gridTest; infer_instance

def matchesCandidate {m : ℕ} (T : Sym (GridIdx m) 3) (u : Candidate m) : Bool :=
  decide (T = entryTriangle u.1 u.2.1 u.2.2.1 u.2.2.2 ∧
    gridTest m u.1 u.2.1 u.2.2.1 u.2.2.2)

def variableBits (i j : ℕ) : List Bool :=
  true :: (List.replicate i true ++ false :: List.replicate j true ++ [false])

def localBits (n m : ℕ) (p : ZMod m × ZMod m) (a : GridState) : List Bool :=
  if a.1.1 = 1 then
    if p.1.val < n ∧ p.2.val < n then variableBits p.1.val p.2.val
    else if p.1 = p.2 then [false,true] else [false,false]
  else [false,true]

def entryBits (n m : ℕ) (T : Sym (GridIdx m) 3) : List Bool :=
  match (candidates m).find? (matchesCandidate T) with
  | none => [false,false]
  | some u => localBits n m u.1 u.2.1

def table (n m : ℕ) : List Bool :=
  (List.range (5*m^2)).flatMap fun a =>
    (List.range (5*m^2)).flatMap fun b =>
      (List.range (5*m^2)).flatMap fun c =>
        entryBits n m (gridIdxOfNat m a ::ₛ gridIdxOfNat m b ::ₛ gridIdxOfNat m c ::ₛ Sym.nil)

def compute (n : ℕ) : List Bool := table n (GridSideAlgorithm.compute n)

lemma state_exists (a : GridState) : ∃ k < 5,gridStateOfNat k = a := by
  have h : ∀ a : GridState,∃ k : Fin 5,gridStateOfNat k.val = a := by decide
  obtain ⟨k,hk⟩ := h a
  exact ⟨k.val,k.isLt,hk⟩

lemma mem_candidates {m : ℕ} [NeZero m] (u : Candidate m) : u ∈ candidates m := by
  obtain ⟨⟨i,j⟩,a,b,c⟩ := u
  obtain ⟨ka,hka,rfl⟩ := state_exists a
  obtain ⟨kb,hkb,rfl⟩ := state_exists b
  obtain ⟨kc,hkc,rfl⟩ := state_exists c
  unfold candidates
  apply List.mem_flatMap.mpr
  refine ⟨i.val,List.mem_range.mpr i.val_lt,?_⟩
  apply List.mem_flatMap.mpr
  refine ⟨j.val,List.mem_range.mpr j.val_lt,?_⟩
  apply List.mem_flatMap.mpr
  refine ⟨ka,List.mem_range.mpr hka,?_⟩
  apply List.mem_flatMap.mpr
  refine ⟨kb,List.mem_range.mpr hkb,?_⟩
  apply List.mem_map.mpr
  exact ⟨kc,List.mem_range.mpr hkc,by simp only [ZMod.natCast_zmod_val]⟩

lemma entryCode_zero (n : ℕ) : entryCode (0 : MvPolynomial (Fin n × Fin n) ℤ) = [false,false] := by
  classical
  simp [entryCode]

lemma entryCode_one (n : ℕ) : entryCode (1 : MvPolynomial (Fin n × Fin n) ℤ) = [false,true] := by
  classical
  simp [entryCode]

lemma entryCode_var {n : ℕ} (ij : Fin n × Fin n) :
    entryCode (X ij : MvPolynomial (Fin n × Fin n) ℤ) = variableBits ij.1.val ij.2.val := by
  classical
  have hone : (X ij : MvPolynomial (Fin n × Fin n) ℤ) ≠ 1 := by
    intro h
    have hh := congrArg (MvPolynomial.constantCoeff) h
    simpa using hh
  have hex : ∃ kl : Fin n × Fin n,(X ij : MvPolynomial (Fin n × Fin n) ℤ) = X kl := ⟨ij,rfl⟩
  have he : hex.choose = ij := (MvPolynomial.X_injective hex.choose_spec).symm
  simp only [entryCode,if_neg (X_ne_zero ij),if_neg hone,dif_pos hex,he,variableBits]

lemma localBits_eq {n m : ℕ} (p : ZMod m × ZMod m) (a : GridState) :
    localBits n m p a = entryCode (if a.1.1 = 1 then paddedEntry n m p else 1) := by
  classical
  unfold localBits
  by_cases ha : a.1.1 = 1
  · rw [if_pos ha,if_pos ha]
    unfold paddedEntry
    split_ifs with h
    · exact (entryCode_var (⟨p.1.val,h.1⟩,⟨p.2.val,h.2⟩)).symm
    · exact (entryCode_one _).symm
    · exact (entryCode_zero _).symm
  · rw [if_neg ha,if_neg ha,entryCode_one]

lemma entryBits_eq (n : ℕ) (T : Sym (GridIdx (gridSide n)) 3) :
    entryBits n (gridSide n) T = entryCode (gridTensor n T) := by
  classical
  unfold entryBits
  cases he : (candidates (gridSide n)).find? (matchesCandidate T) with
  | some u =>
    have hu := List.find?_some he
    have hh : T = entryTriangle u.1 u.2.1 u.2.2.1 u.2.2.2 ∧
        gridTest (gridSide n) u.1 u.2.1 u.2.2.1 u.2.2.2 := by
      simpa only [matchesCandidate,decide_eq_true_eq] using hu
    rw [hh.1,encoding_entry,if_pos hh.2]
    exact localBits_eq _ _
  | none =>
    have hz : gridTensor n T = 0 := by
      by_contra hn
      obtain ⟨p,a,b,c,ha,hb,hc,hT⟩ := encoding_supported n (gridSide n) T hn
      have ha' : a = (p,a.2) := Prod.ext ha rfl
      have hb' : b = (gridRight p,b.2) := Prod.ext hb rfl
      have hc' : c = (gridDown p,c.2) := Prod.ext hc rfl
      rw [ha',hb',hc'] at hT
      change T = entryTriangle p a.2 b.2 c.2 at hT
      have htest : gridTest (gridSide n) p a.2 b.2 c.2 := by
        by_contra hnot
        exact hn (by rw [hT,encoding_entry,if_neg hnot])
      have hnone := (List.find?_eq_none.mp he) (p,a.2,b.2,c.2) (mem_candidates _)
      apply hnone
      simpa only [matchesCandidate,decide_eq_true_eq] using And.intro hT htest
    rw [hz,entryCode_zero]

theorem compute_eq (n : ℕ) : compute n = gridTableCode n := by
  unfold compute
  rw [GridSideAlgorithm.compute_eq]
  unfold table gridTableCode
  congr 1
  funext a
  congr 1
  funext b
  congr 1
  funext c
  exact entryBits_eq n _

end GridTableAlgorithm
end

-- Helpers from Solutions.GridNatOutput
section
namespace GridNatOutput
open GridNatProgram GridNatArithmetic

def withOutput (s : State) (bits : List Bool) : State := {s with output := bits}

@[simp] lemma withOutput_regs (s : State) (bits : List Bool) (r : Reg) :
    (withOutput s bits).regs r = s.regs r := rfl

@[simp] lemma withOutput_output (s : State) (bits : List Bool) :
    (withOutput s bits).output = bits := rfl

def emitLoop (r : Reg) (b : Bool) : Code := .loop r (.seq (.dec r) (.emit b))

theorem emitLoop_runs (s : State) (r : Reg) (b : Bool) :
    Runs (emitLoop r b) s
      (withOutput (s.set r 0) (List.replicate (s.regs r) b ++ s.output))
      (3*s.regs r+1) := by
  generalize hn : s.regs r = n
  induction n generalizing s with
  | zero =>
    have he : withOutput (s.set r 0) (List.replicate 0 b ++ s.output) = s := by
      simp only [List.replicate_zero,List.nil_append]
      rw [← hn,set_self]
      rfl
    rw [he]
    exact Runs.done hn
  | succ n ih =>
    let e := (s.set r n).emit b
    have hbdy : Runs (.seq (.dec r) (.emit b)) s e 2 := by
      convert Runs.seq (Runs.dec s r) (Runs.emit (s.set r (s.regs r-1)) b) using 1
      simp [e,hn]
    have he : e.regs r = n := by simp [e,State.emit]
    have ht := ih e he
    have hend : withOutput (e.set r 0) (List.replicate n b ++ e.output) =
        withOutput (s.set r 0) (List.replicate (n+1) b ++ s.output) := by
      apply state_ext
      · intro k
        by_cases hk : k = r <;> simp [e,hk,withOutput,State.emit,State.set]
      · simp [e,withOutput,State.emit,List.replicate_succ',List.append_assoc]
    rw [hend] at ht
    have hh := Runs.again (by omega : s.regs r ≠ 0) hbdy ht
    convert hh using 1 <;> first | rfl | omega

def emitUnary (src fuel : Reg) (hne : src ≠ fuel) : Code :=
  .seq (.copy src fuel hne) (emitLoop fuel true)

theorem emitUnary_runs (s : State) (src fuel : Reg) (hne : src ≠ fuel) :
    Runs (emitUnary src fuel hne) s
      (withOutput (s.set fuel 0) (List.replicate (s.regs src) true ++ s.output))
      (2*s.regs fuel+12*s.regs src+6) := by
  have hc := Runs.copy s src fuel hne
  have hl := emitLoop_runs (s.set fuel (s.regs src)) fuel true
  simp only [set_get,set_output,set_twice] at hl
  have hh := Runs.seq hc hl
  convert hh using 1 <;> first | rfl | omega

def emitConstant (b : Bool) : Code := .seq (.emit false) (.emit b)

theorem emitConstant_runs (s : State) (b : Bool) :
    Runs (emitConstant b) s (withOutput s (b :: false :: s.output)) 2 :=
  Runs.seq (Runs.emit s false) (Runs.emit (s.emit false) b)

def emitVariable (i j fuel : Reg) (hi : i ≠ fuel) (hj : j ≠ fuel) : Code :=
  .seq (.emit true) (.seq (emitUnary i fuel hi) (.seq (.emit false)
    (.seq (emitUnary j fuel hj) (.emit false))))

theorem emitVariable_runs (s : State) (i j fuel : Reg) (hi : i ≠ fuel) (hj : j ≠ fuel) :
    Runs (emitVariable i j fuel hi hj) s
      (withOutput (s.set fuel 0)
        ((GridTableAlgorithm.variableBits (s.regs i) (s.regs j)).reverse ++ s.output))
      (2*s.regs fuel+12*s.regs i+12*s.regs j+15) := by
  let a := s.emit true
  let b := withOutput (a.set fuel 0) (List.replicate (a.regs i) true ++ a.output)
  let c := b.emit false
  let d := withOutput (c.set fuel 0) (List.replicate (c.regs j) true ++ c.output)
  have hh := Runs.seq (Runs.emit s true) (Runs.seq (emitUnary_runs a i fuel hi)
    (Runs.seq (Runs.emit b false) (Runs.seq (emitUnary_runs c j fuel hj) (Runs.emit d false))))
  convert hh using 1
  · rfl
  · apply state_ext
    · intro k
      by_cases hk : k = fuel <;> simp [a,b,c,d,withOutput,State.emit,State.set,hk]
    · simp [a,b,c,d,withOutput,State.emit,State.set,hi,hj,GridTableAlgorithm.variableBits,
        List.reverse_append,List.reverse_cons,List.reverse_replicate,List.append_assoc]
  · simp [a,b,c,d,withOutput,State.emit,State.set,hi,hj]
    omega

end GridNatOutput
end

-- Helpers from Solutions.GridStraightLine
section
namespace GridStraightLine
open GridNatProgram GridNatArithmetic GridNatControl GridScratch

abbrev Var := Fin 32
def reg (v : Var) : Reg := ⟨v.val,by omega⟩

lemma reg_lt (v : Var) : (reg v).val < 32 := v.isLt

lemma reg_ne (v : Var) (r : Reg) (hr : 32 ≤ r.val) : reg v ≠ r := by
  intro h
  have hv := reg_lt v
  rw [h] at hv
  omega

def Clean (s : State) : Prop := ∀ r : Reg,32 ≤ r.val → s.regs r = 0

def clearState (s : State) : State := ⟨fun r => if 32 ≤ r.val then 0 else s.regs r,s.output⟩

lemma clearState_clean (s : State) : Clean (clearState s) := by
  intro r hr
  simp [clearState,hr]

lemma clearState_low (s : State) : SameLow s (clearState s) := by
  intro r hr
  simp [clearState,show ¬32 ≤ r.val by omega]

lemma clearState_bounded {s : State} {M : ℕ} (hs : Bounded s M) : Bounded (clearState s) M := by
  intro r
  by_cases hr : 32 ≤ r.val
  · simp [clearState,hr]
  · simpa [clearState,hr] using hs r

lemma clean_set {s : State} (hs : Clean s) (v : Var) (n : ℕ) : Clean (s.set (reg v) n) := by
  intro r hr
  simp only [set_other s n (reg_ne v r hr).symm]
  exact hs r hr

lemma clean_ext {s t : State} (hs : Clean s) (ht : Clean t)
    (hl : SameLow s t) (ho : t.output = s.output) : t = s := by
  apply state_ext
  · intro r
    by_cases hr : 32 ≤ r.val
    · rw [hs r hr,ht r hr]
    · exact hl r (by omega)
  · exact ho

def binary (op : BinOp) (dst a b : Var) : Code :=
  .seq (.copy (reg a) 46 (reg_ne a 46 (by decide)))
    (.seq (.copy (reg b) 47 (reg_ne b 47 (by decide)))
      (.seq (GridScratch.code op)
        (.seq (.copy 48 (reg dst) (reg_ne dst 48 (by decide)).symm) (clearAbove 32))))

theorem binary_runs (op : BinOp) (dst a b : Var) (s : State) (M : ℕ)
    (hs : Clean s) (hM : Bounded s M) :
    ∃ t,Runs (binary op dst a b) s
      (s.set (reg dst) (op.eval (s.regs (reg a)) (s.regs (reg b)))) t ∧
      t ≤ 1000*(M+1)^2 ∧
      Bounded (s.set (reg dst) (op.eval (s.regs (reg a)) (s.regs (reg b)))) (2*(M+1)^2) := by
  let s₁ := s.set 46 (s.regs (reg a))
  let s₂ := s₁.set 47 (s₁.regs (reg b))
  have hb₁ : s₁.regs (reg b) = s.regs (reg b) := set_other _ _ (reg_ne b 46 (by decide))
  have hM₁ : Bounded s₁ M := bounded_set hM 46 _ (hM _)
  have hM₂ : Bounded s₂ M := bounded_set hM₁ 47 _ (hM₁ _)
  have hl₁ : SameLow s s₁ := sameLow_set _ _ _ (by decide)
  have hl₂ : SameLow s₁ s₂ := sameLow_set _ _ _ (by decide)
  obtain ⟨u,t,hu,hval,hlo,hout,hub,htb⟩ := GridScratch.runs op s₂ M hM₂
  have hv : u.regs 48 = op.eval (s.regs (reg a)) (s.regs (reg b)) := by
    simpa [s₂,s₁,reg_ne b 46 (by decide)] using hval
  let v := u.set (reg dst) (u.regs 48)
  have hvb : Bounded v (2*(M+1)^2) := bounded_set hub (reg dst) _ (hub 48)
  obtain ⟨tc,hc,hcb⟩ := clearAbove_runs 32 v (2*(M+1)^2) hvb
  change Runs (clearAbove 32) v (clearState v) tc at hc
  have he : clearState v = s.set (reg dst) (op.eval (s.regs (reg a)) (s.regs (reg b))) := by
    apply clean_ext (clean_set hs dst _) (clearState_clean v)
    · intro k hk
      rw [clearState_low v k hk]
      by_cases hkd : k = reg dst
      · subst k
        simpa only [v,set_get] using hv
      · simp only [v,set_other _ _ hkd]
        exact (hlo k hk).trans ((hl₂ k hk).trans (hl₁ k hk))
    · exact hout
  rw [he] at hc
  have hcopy := Runs.copy u 48 (reg dst) (reg_ne dst 48 (by decide)).symm
  have h₂ := Runs.copy s₁ (reg b) 47 (reg_ne b 47 (by decide))
  have h₁ := Runs.copy s (reg a) 46 (reg_ne a 46 (by decide))
  have hh := Runs.seq h₁ (Runs.seq h₂ (Runs.seq hu (Runs.seq hcopy hc)))
  refine ⟨_,hh,?_,?_⟩
  · have ha := hM (reg a)
    have h46 := hM 46
    have hb := hM₁ (reg b)
    have h47 := hM₁ 47
    have hd := hub (reg dst)
    have h48 := hub 48
    nlinarith only [htb,hcb,ha,h46,hb,h47,hd,h48,Nat.zero_le (M*M)]
  · rw [← he]
    exact clearState_bounded hvb

def copy (dst src : Var) : Code :=
  if h : reg src = reg dst then .skip else .copy (reg src) (reg dst) h

lemma copy_runs (dst src : Var) (s : State) (M : ℕ) (hM : Bounded s M) :
    ∃ t,Runs (copy dst src) s (s.set (reg dst) (s.regs (reg src))) t ∧ t ≤ 11*M+5 := by
  unfold copy
  split_ifs with h
  · rw [h,set_self]
    exact ⟨1,Runs.skip s,by omega⟩
  · exact ⟨_,Runs.copy s (reg src) (reg dst) h,by have := hM (reg src); have := hM (reg dst); omega⟩

def unary (src : Var) : Code :=
  GridNatOutput.emitUnary (reg src) 50 (reg_ne src 50 (by decide))

lemma unary_runs (src : Var) (s : State) (hs : Clean s) :
    Runs (unary src) s
      (GridNatOutput.withOutput s (List.replicate (s.regs (reg src)) true ++ s.output))
      (12*s.regs (reg src)+6) := by
  have hh := GridNatOutput.emitUnary_runs s (reg src) 50 (reg_ne src 50 (by decide))
  have hz := hs 50 (by decide)
  have he := set_self s 50
  rw [hz] at he
  simpa only [unary,he,hz,Nat.mul_zero,Nat.zero_add] using hh

lemma clean_clearState (s : State) (k : ℕ) (hs : Clean s) :
    Clean (⟨fun r => if k ≤ r.val then 0 else s.regs r,s.output⟩ : State) := by
  intro r hr
  dsimp
  split_ifs <;> first | rfl | exact hs r hr

inductive Script
  | literal (dst : Var) (n : ℕ)
  | copy (dst src : Var)
  | binary (op : BinOp) (dst a b : Var)
  | emit (b : Bool)
  | unary (src : Var)
  | clear (cutoff : ℕ)
  | skip
  | seq (p q : Script)
  | ifZero (r : Var) (yes no : Script)

def Script.eval : Script → State → State
  | .literal dst n,s => s.set (reg dst) n
  | .copy dst src,s => s.set (reg dst) (s.regs (reg src))
  | .binary op dst a b,s => s.set (reg dst) (op.eval (s.regs (reg a)) (s.regs (reg b)))
  | .emit b,s => s.emit b
  | .unary src,s => GridNatOutput.withOutput s (List.replicate (s.regs (reg src)) true ++ s.output)
  | .clear k,s => ⟨fun r => if k ≤ r.val then 0 else s.regs r,s.output⟩
  | .skip,s => s
  | .seq p q,s => q.eval (p.eval s)
  | .ifZero r p q,s => if s.regs (reg r) = 0 then p.eval s else q.eval s

def Script.compile : Script → Code
  | .literal dst n => GridNatControl.literal (reg dst) n
  | .copy dst src => GridStraightLine.copy dst src
  | .binary op dst a b => GridStraightLine.binary op dst a b
  | .emit b => .emit b
  | .unary src => GridStraightLine.unary src
  | .clear k => clearAbove k
  | .skip => .skip
  | .seq p q => .seq p.compile q.compile
  | .ifZero r p q => .ifZero (reg r) p.compile q.compile

noncomputable def Script.spaceBound : Script → Polynomial ℕ
  | .literal _ n => Polynomial.X+Polynomial.C n
  | .binary _ _ _ _ => 2*(Polynomial.X+1)^2
  | .seq p q => q.spaceBound.comp p.spaceBound
  | .ifZero _ p q => p.spaceBound+q.spaceBound
  | _ => Polynomial.X

noncomputable def Script.timeBound : Script → Polynomial ℕ
  | .literal _ n => 2*Polynomial.X+Polynomial.C n+2
  | .copy _ _ => 11*Polynomial.X+5
  | .binary _ _ _ _ => 1000*(Polynomial.X+1)^2
  | .emit _ => 1
  | .unary _ => 12*Polynomial.X+6
  | .clear _ => 124*Polynomial.X+63
  | .skip => 1
  | .seq p q => p.timeBound+q.timeBound.comp p.spaceBound
  | .ifZero _ p q => 2+p.timeBound+q.timeBound

theorem Script.correct (p : Script) (s : State) (M : ℕ) (hs : Clean s) (hM : Bounded s M) :
    ∃ t,Runs p.compile s (p.eval s) t ∧ t ≤ p.timeBound.eval M ∧
      Clean (p.eval s) ∧ Bounded (p.eval s) (p.spaceBound.eval M) := by
  induction p generalizing s M with
  | literal dst n =>
    refine ⟨_,literal_runs s (reg dst) n,?_,clean_set hs dst n,?_⟩
    · simp only [Script.timeBound,Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_X,
        Polynomial.eval_C,Polynomial.eval_ofNat]
      have := hM (reg dst)
      omega
    · simp only [Script.spaceBound,Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_C]
      exact bounded_set (bounded_mono hM (by omega)) (reg dst) n (by omega)
  | copy dst src =>
    obtain ⟨t,ht,hb⟩ := copy_runs dst src s M hM
    refine ⟨t,ht,?_,clean_set hs dst _,?_⟩
    · simpa [Script.timeBound] using hb
    · simpa only [Script.eval,Script.spaceBound,Polynomial.eval_X] using
        bounded_set hM (reg dst) _ (hM (reg src))
  | binary op dst a b =>
    obtain ⟨t,ht,hb,hsb⟩ := binary_runs op dst a b s M hs hM
    refine ⟨t,ht,?_,clean_set hs dst _,?_⟩
    · simpa [Script.timeBound] using hb
    · simpa [Script.eval,Script.spaceBound] using hsb
  | emit b =>
    refine ⟨1,Runs.emit s b,by simp [Script.timeBound],hs,?_⟩
    simpa only [Script.eval,Script.spaceBound,Polynomial.eval_X,Bounded,State.emit] using hM
  | unary src =>
    refine ⟨_,unary_runs src s hs,?_,hs,?_⟩
    · simp only [Script.timeBound,Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_X,
        Polynomial.eval_ofNat]
      have := hM (reg src)
      omega
    · simpa only [Script.eval,Script.spaceBound,Polynomial.eval_X,Bounded,GridNatOutput.withOutput] using hM
  | clear k =>
    obtain ⟨t,ht,hb⟩ := clearAbove_runs k s M hM
    refine ⟨t,ht,?_,clean_clearState s k hs,?_⟩
    · simpa [Script.timeBound] using hb
    · simp only [Script.eval,Script.spaceBound,Polynomial.eval_X]
      intro r
      change (if k ≤ r.val then 0 else s.regs r) ≤ M
      split_ifs <;> first | omega | exact hM r
  | skip =>
    refine ⟨1,Runs.skip s,by simp [Script.timeBound],hs,?_⟩
    simpa only [Script.eval,Script.spaceBound,Polynomial.eval_X] using hM
  | seq p q ihp ihq =>
    obtain ⟨tp,hp,hpb,hpc,hps⟩ := ihp s M hs hM
    obtain ⟨tq,hq,hqb,hqc,hqs⟩ := ihq (p.eval s) (p.spaceBound.eval M) hpc hps
    refine ⟨tp+tq,Runs.seq hp hq,?_,hqc,?_⟩
    · simpa only [Script.timeBound,Polynomial.eval_add,Polynomial.eval_comp] using Nat.add_le_add hpb hqb
    · simpa only [Script.eval,Script.spaceBound,Polynomial.eval_comp] using hqs
  | ifZero r p q ihp ihq =>
    by_cases hz : s.regs (reg r) = 0
    · obtain ⟨t,ht,hb,hc,hsp⟩ := ihp s M hs hM
      refine ⟨2+t,?_,?_,?_,?_⟩
      · simpa only [Script.compile,Script.eval,if_pos hz] using
          (Runs.yes (q := q.compile) hz ht)
      · simp only [Script.timeBound,Polynomial.eval_add,Polynomial.eval_ofNat]
        omega
      · simpa only [Script.eval,if_pos hz] using hc
      · simpa only [Script.eval,if_pos hz,Script.spaceBound,Polynomial.eval_add] using
          bounded_mono hsp (Nat.le_add_right _ (q.spaceBound.eval M))
    · obtain ⟨t,ht,hb,hc,hsp⟩ := ihq s M hs hM
      refine ⟨2+t,?_,?_,?_,?_⟩
      · simpa only [Script.compile,Script.eval,if_neg hz] using
          (Runs.no (p := p.compile) hz ht)
      · simp only [Script.timeBound,Polynomial.eval_add,Polynomial.eval_ofNat]
        omega
      · simpa only [Script.eval,if_neg hz] using hc
      · simpa only [Script.eval,if_neg hz,Script.spaceBound,Polynomial.eval_add] using
          bounded_mono hsp (Nat.le_add_left _ (p.spaceBound.eval M))

end GridStraightLine
end

-- Helpers from Solutions.GridConditions
section
namespace GridConditions
open GridNatProgram GridNatArithmetic GridStraightLine

abbrev Small := Fin 29
def widen (v : Small) : Var := ⟨v.val,by omega⟩
abbrev loc := GridStraightLine.reg

def TailClean (k : ℕ) (s : State) : Prop := ∀ r : Reg,k ≤ r.val → s.regs r = 0

def wipe (k : ℕ) (s : State) : State := (Script.clear k).eval s

lemma wipe_set (k : ℕ) (s : State) (r : Reg) (n : ℕ) (hr : k ≤ r.val) :
    wipe k (s.set r n) = wipe k s := by
  apply state_ext
  · intro t
    by_cases ht : k ≤ t.val
    · simp [wipe,Script.eval,ht]
    · have hne : t ≠ r := by intro h; subst t; omega
      simp [wipe,Script.eval,ht,hne]
  · rfl

lemma wipe_eq (k : ℕ) (s : State) (hs : TailClean k s) : wipe k s = s := by
  apply state_ext
  · intro r
    by_cases hr : k ≤ r.val
    · simp [wipe,Script.eval,hr,hs r hr]
    · simp [wipe,Script.eval,hr]
  · rfl

inductive Value
  | var (v : Small)
  | lit (n : ℕ)

def Value.eval : Value → State → ℕ
  | .var v,s => s.regs (loc (widen v))
  | .lit n,_ => n

def Value.load (dst : Var) : Value → Script
  | .var v => .copy dst (widen v)
  | .lit n => .literal dst n

lemma load_eval (v : Value) (dst : Var) (s : State) :
    (v.load dst).eval s = s.set (loc dst) (v.eval s) := by cases v <;> rfl

lemma value_set (v : Value) (s : State) (r : Reg) (n : ℕ) (hr : 29 ≤ r.val) :
    v.eval (s.set r n) = v.eval s := by
  cases v with
  | lit n => rfl
  | var v =>
    have hne : loc (widen v) ≠ r := by
      intro h
      have hv : (loc (widen v)).val < 29 := v.isLt
      rw [h] at hv
      omega
    exact set_other _ _ hne

def prepare (a b : Value) : Script := .seq (a.load 29) (b.load 30)

lemma prepare_eval (a b : Value) (s : State) :
    (prepare a b).eval s = (s.set (loc 29) (a.eval s)).set (loc 30) (b.eval s) := by
  simp only [prepare,Script.eval,load_eval,value_set b s (loc 29) _ (by decide)]

def finish (p : Script) : Script := .seq (.clear 29) p

lemma finish_eval (p : Script) (s : State) : (finish p).eval s = p.eval (wipe 29 s) := rfl

inductive Comparison | eq | le | lt

def Comparison.eval : Comparison → ℕ → ℕ → Bool
  | .eq,a,b => decide (a=b)
  | .le,a,b => decide (a≤b)
  | .lt,a,b => decide (a<b)

def Comparison.test (cmp : Comparison) (yes no : Script) : Script :=
  match cmp with
  | .eq => .seq (.binary .sub 31 29 30)
      (.ifZero 31 (.seq (.binary .sub 31 30 29) (.ifZero 31 (finish yes) (finish no))) (finish no))
  | .le => .seq (.binary .sub 31 29 30) (.ifZero 31 (finish yes) (finish no))
  | .lt => .seq (.binary .sub 31 30 29) (.ifZero 31 (finish no) (finish yes))

def Comparison.compile (cmp : Comparison) (a b : Value) (yes no : Script) : Script :=
  .seq (prepare a b) (cmp.test yes no)

theorem Comparison.correct (cmp : Comparison) (a b : Value) (yes no : Script)
    (s : State) (hs : TailClean 29 s) :
    (cmp.compile a b yes no).eval s =
      if cmp.eval (a.eval s) (b.eval s) then yes.eval s else no.eval s := by
  have hw (x y z : ℕ) : wipe 29
      (((s.set (loc 29) x).set (loc 30) y).set (loc 31) z) = s := by
    rw [wipe_set _ _ _ _ (by decide),wipe_set _ _ _ _ (by decide),
      wipe_set _ _ _ _ (by decide),wipe_eq _ _ hs]
  cases cmp with
  | eq =>
    simp only [Comparison.compile,Script.eval,prepare_eval,Comparison.test,
      GridScratch.BinOp.eval,set_get,finish_eval]
    simp only [set_other _ _ (by decide : loc 29 ≠ loc 30),
      set_other _ _ (by decide : loc 30 ≠ loc 31),
      set_other _ _ (by decide : loc 29 ≠ loc 31),set_get,set_twice,hw]
    by_cases hab : a.eval s = b.eval s
    · simp [Comparison.eval,hab]
    · have hh : ¬(a.eval s-b.eval s = 0 ∧ b.eval s-a.eval s = 0) := by omega
      simp only [Comparison.eval,decide_eq_true_eq,if_neg hab]
      split_ifs <;> first | rfl | omega
  | le =>
    simp only [Comparison.compile,Script.eval,prepare_eval,Comparison.test,
      GridScratch.BinOp.eval,set_get,finish_eval]
    simp only [set_other _ _ (by decide : loc 29 ≠ loc 30),set_get,hw]
    have hh : a.eval s-b.eval s = 0 ↔ a.eval s ≤ b.eval s := Nat.sub_eq_zero_iff_le
    simp only [hh,Comparison.eval,decide_eq_true_eq]
  | lt =>
    simp only [Comparison.compile,Script.eval,prepare_eval,Comparison.test,
      GridScratch.BinOp.eval,set_get,finish_eval]
    simp only [set_other _ _ (by decide : loc 29 ≠ loc 30),set_get,hw]
    by_cases hab : a.eval s < b.eval s
    · have hh : b.eval s-a.eval s ≠ 0 := by omega
      simp [Comparison.eval,hab,hh]
    · have hh : b.eval s-a.eval s = 0 := by omega
      simp [Comparison.eval,hab,hh]

inductive Test
  | compare (cmp : Comparison) (a b : Value)
  | and (p q : Test)
  | or (p q : Test)
  | not (p : Test)

def Test.eval : Test → State → Bool
  | .compare c a b,s => c.eval (a.eval s) (b.eval s)
  | .and p q,s => p.eval s && q.eval s
  | .or p q,s => p.eval s || q.eval s
  | .not p,s => !(p.eval s)

def Test.compile (p : Test) (yes no : Script) : Script :=
  match p with
  | .compare c a b => c.compile a b yes no
  | .and p q => p.compile (q.compile yes no) no
  | .or p q => p.compile yes (q.compile yes no)
  | .not p => p.compile no yes

theorem Test.correct (p : Test) (yes no : Script) (s : State) (hs : TailClean 29 s) :
    (p.compile yes no).eval s = if p.eval s then yes.eval s else no.eval s := by
  induction p generalizing yes no with
  | compare c a b => exact c.correct a b yes no s hs
  | and p q ihp ihq =>
    simp only [Test.compile,Test.eval,ihp,ihq]
    by_cases hp : p.eval s = true <;> by_cases hq : q.eval s = true <;> simp [hp,hq]
  | or p q ihp ihq =>
    simp only [Test.compile,Test.eval,ihp,ihq]
    by_cases hp : p.eval s = true <;> by_cases hq : q.eval s = true <;> simp [hp,hq]
  | not p ih =>
    simp only [Test.compile,Test.eval,ih]
    by_cases hp : p.eval s = true <;> simp [hp]

end GridConditions
end

-- Helpers from Solutions.GridEntryAlgorithm
section
namespace GridEntryAlgorithm
open ResultantVNP GridConstruction GridTableAlgorithm

abbrev Triple (α : Type) := α × α × α

def unordered {α : Type} (u : Triple α) : Sym α 3 :=
  u.1 ::ₛ u.2.1 ::ₛ u.2.2 ::ₛ Sym.nil

def orientations {α : Type} (a b c : α) : List (Triple α) :=
  [(a,b,c),(b,a,c),(c,b,a),(b,c,a),(c,a,b),(a,c,b)]

lemma mem_orientations {α : Type} (a b c : α) (u : Triple α) :
    u ∈ orientations a b c ↔ unordered u = unordered (a,b,c) := by
  obtain ⟨x,y,z⟩ := u
  have hp : [a,b,c].permutations =
      [[a,b,c],[b,a,c],[c,b,a],[b,c,a],[c,a,b],[a,c,b]] := by cbv
  have he : unordered (x,y,z) = unordered (a,b,c) ↔ [x,y,z].Perm [a,b,c] := by
    rw [← Sym.coe_inj]
    change (([x,y,z] : List α) : Multiset α) = ([a,b,c] : List α) ↔ _
    exact Multiset.coe_eq_coe
  rw [he,← List.mem_permutations,hp]
  simp [orientations]

def valid {m : ℕ} (u : Triple (GridIdx m)) : Bool :=
  decide (u.2.1.1 = gridRight u.1.1 ∧ u.2.2.1 = gridDown u.1.1 ∧
    gridTest m u.1.1 u.1.2 u.2.1.2 u.2.2.2)

def compute (n m : ℕ) (a b c : GridIdx m) : List Bool :=
  match (orientations a b c).find? valid with
  | none => [false,false]
  | some u => localBits n m u.1.1 u.1.2

theorem compute_eq (n : ℕ) (a b c : GridIdx (gridSide n)) :
    compute n (gridSide n) a b c = entryCode (gridTensor n (unordered (a,b,c))) := by
  classical
  unfold compute
  cases he : (orientations a b c).find? valid with
  | some u =>
    have hm := List.mem_of_find?_eq_some he
    have hv := List.find?_some he
    have ht : u.2.1.1 = gridRight u.1.1 ∧ u.2.2.1 = gridDown u.1.1 ∧
        gridTest (gridSide n) u.1.1 u.1.2 u.2.1.2 u.2.2.2 := by
      simpa only [valid,decide_eq_true_eq] using hv
    have hu := (mem_orientations a b c u).mp hm
    have htri : unordered u = entryTriangle u.1.1 u.1.2 u.2.1.2 u.2.2.2 := by
      obtain ⟨⟨p,x⟩,⟨q,y⟩,⟨r,z⟩⟩ := u
      simp only [Prod.fst,Prod.snd] at ht
      simp only [unordered,entryTriangle,ht.1,ht.2.1]
    rw [← hu,htri,encoding_entry,if_pos ht.2.2]
    exact localBits_eq _ _
  | none =>
    have hz : gridTensor n (unordered (a,b,c)) = 0 := by
      by_contra hn
      obtain ⟨p,x,y,z,hx,hy,hz,hT⟩ := encoding_supported n (gridSide n) _ hn
      change x.1 = p at hx
      change y.1 = gridRight p at hy
      change z.1 = gridDown p at hz
      let u : Triple (GridIdx (gridSide n)) := (x,y,z)
      have hm : u ∈ orientations a b c := (mem_orientations a b c u).mpr hT.symm
      have htri : unordered (a,b,c) = entryTriangle p x.2 y.2 z.2 := by
        rw [hT]
        have hxe : x = (p,x.2) := Prod.ext hx rfl
        have hye : y = (gridRight p,y.2) := Prod.ext hy rfl
        have hze : z = (gridDown p,z.2) := Prod.ext hz rfl
        rw [hxe,hye,hze]
        rfl
      have htest : gridTest (gridSide n) p x.2 y.2 z.2 := by
        by_contra ht
        exact hn (by rw [htri,encoding_entry,if_neg ht])
      have hv : valid u = true := by
        simp only [valid,u,Prod.fst,Prod.snd,decide_eq_true_eq]
        exact ⟨by rw [hx,hy],by rw [hx,hz],by simpa only [hx] using htest⟩
      exact (List.find?_eq_none.mp he) u hm hv
    rw [hz,entryCode_zero]

def table (n m : ℕ) : List Bool :=
  (List.range (5*m^2)).flatMap fun a =>
    (List.range (5*m^2)).flatMap fun b =>
      (List.range (5*m^2)).flatMap fun c =>
        compute n m (gridIdxOfNat m a) (gridIdxOfNat m b) (gridIdxOfNat m c)

theorem table_eq (n : ℕ) : table n (gridSide n) = gridTableCode n := by
  unfold table gridTableCode
  congr 1
  funext a
  congr 1
  funext b
  congr 1
  funext c
  exact compute_eq n _ _ _

end GridEntryAlgorithm
end

-- Helpers from Solutions.GridNatEntry
section
namespace GridNatEntry
open ResultantVNP GridConstruction GridTableAlgorithm GridEntryAlgorithm

structure Index where
  row : ℕ
  col : ℕ
  state : ℕ
  deriving DecidableEq

def WellFormed (m : ℕ) (a : Index) : Prop := a.row < m ∧ a.col < m ∧ a.state < 5

def denote (m : ℕ) (a : Index) : GridIdx m :=
  (((a.row : ZMod m),(a.col : ZMod m)),gridStateOfNat a.state)

def decode (m k : ℕ) : Index := ⟨k/5/m,k/5%m,k%5⟩

lemma decode_denote (m k : ℕ) : denote m (decode m k) = gridIdxOfNat m k := rfl

lemma decode_wellFormed {m k : ℕ} (hm : 0 < m) (hk : k < 5*m^2) :
    WellFormed m (decode m k) := by
  constructor
  · change k/5/m < m
    apply (Nat.div_lt_iff_lt_mul hm).mpr
    apply (Nat.div_lt_iff_lt_mul (by decide : 0 < 5)).mpr
    nlinarith only [hk]
  · exact ⟨Nat.mod_lt _ hm,Nat.mod_lt _ (by decide)⟩

def x (s : ℕ) : ℕ := if s = 4 then 1 else 0
def p (s : ℕ) : ℕ := if s = 2 ∨ s = 3 then 1 else 0
def q (s : ℕ) : ℕ := if s = 1 ∨ s = 3 then 1 else 0

lemma state_values (s : ℕ) (hs : s < 5) :
    (gridStateOfNat s).1.1.val = x s ∧
    (gridStateOfNat s).1.2.1.val = p s ∧
    (gridStateOfNat s).1.2.2.val = q s := by
  interval_cases s <;> decide

def next (m i : ℕ) : ℕ := if i+1 = m then 0 else i+1

lemma next_eq_mod {m i : ℕ} (hi : i < m) : next m i = (i+1)%m := by
  unfold next
  split_ifs with h
  · simp [h]
  · exact (Nat.mod_eq_of_lt (by omega)).symm

lemma cast_eq {m a b : ℕ} (ha : a < m) (hb : b < m) :
    (a : ZMod m) = (b : ZMod m) ↔ a = b := by
  rw [ZMod.natCast_eq_natCast_iff',Nat.mod_eq_of_lt ha,Nat.mod_eq_of_lt hb]

lemma cast_next {m i : ℕ} (hi : i < m) :
    ((next m i : ℕ) : ZMod m) = (i : ZMod m)+1 := by
  rw [next_eq_mod hi,ZMod.natCast_mod,Nat.cast_add,Nat.cast_one]

lemma next_lt {m i : ℕ} (hi : i < m) : next m i < m := by
  rw [next_eq_mod hi]
  exact Nat.mod_lt _ (by omega)

def valid (m : ℕ) (u : Triple Index) : Bool :=
  let a := u.1
  let b := u.2.1
  let c := u.2.2
  decide (b.row = next m a.row ∧ b.col = a.col ∧
    c.row = a.row ∧ c.col = next m a.col ∧
    (a.row = 0 → p a.state = 0) ∧ (a.col = 0 → q a.state = 0) ∧
    (a.row < m-1 → p b.state = p a.state+x a.state) ∧
    (a.col < m-1 → q c.state = q a.state+x a.state) ∧
    (a.row = m-1 → p a.state+x a.state = 1) ∧
    (a.col = m-1 → q a.state+x a.state = 1))

lemma valid_eq {m : ℕ} (a b c : Index)
    (ha : WellFormed m a) (hb : WellFormed m b) (hc : WellFormed m c) :
    valid m (a,b,c) = GridEntryAlgorithm.valid (denote m a,denote m b,denote m c) := by
  obtain ⟨ha₁,ha₂,ha₃⟩ := ha
  obtain ⟨hb₁,hb₂,hb₃⟩ := hb
  obtain ⟨hc₁,hc₂,hc₃⟩ := hc
  obtain ⟨hax,hap,haq⟩ := state_values a.state ha₃
  obtain ⟨hbx,hbp,hbq⟩ := state_values b.state hb₃
  obtain ⟨hcx,hcp,hcq⟩ := state_values c.state hc₃
  unfold valid GridEntryAlgorithm.valid denote gridRight gridDown gridTest
  simp only [Prod.mk.injEq,Prod.fst,Prod.snd,
    ZMod.val_natCast_of_lt ha₁,ZMod.val_natCast_of_lt ha₂,hax,hap,haq,hbp,hcq,
    ← cast_next ha₁,← cast_next ha₂,cast_eq hb₁ (next_lt ha₁),cast_eq hb₂ ha₂,
    cast_eq hc₁ ha₁,cast_eq hc₂ (next_lt ha₂)]
  congr 1
  apply propext
  tauto

def localBits (n : ℕ) (a : Index) : List Bool :=
  if a.state = 4 then
    if a.row < n ∧ a.col < n then variableBits a.row a.col
    else if a.row = a.col then [false,true] else [false,false]
  else [false,true]

lemma localBits_eq {m : ℕ} (n : ℕ) (a : Index) (ha : WellFormed m a) :
    localBits n a = GridTableAlgorithm.localBits n m (denote m a).1 (denote m a).2 := by
  have hstate : (gridStateOfNat a.state).1.1 = 1 ↔ a.state = 4 := by
    have hv := (state_values a.state ha.2.2).1
    constructor
    · intro h
      have he := congrArg Fin.val h
      rw [hv] at he
      simpa [x] using he
    · intro h
      simp [h,gridStateOfNat]
  simp only [localBits,GridTableAlgorithm.localBits,denote,Prod.fst,Prod.snd,hstate,
    ZMod.val_natCast_of_lt ha.1,ZMod.val_natCast_of_lt ha.2.1,cast_eq ha.1 ha.2.1]

def scan (n m : ℕ) (us : List (Triple Index)) : List Bool :=
  match us.find? (valid m) with
  | none => [false,false]
  | some u => localBits n u.1

def denoteTriple (m : ℕ) (u : Triple Index) : Triple (GridIdx m) :=
  (denote m u.1,denote m u.2.1,denote m u.2.2)

lemma scan_correct (n m : ℕ) (us : List (Triple Index))
    (hw : ∀ u ∈ us,WellFormed m u.1 ∧ WellFormed m u.2.1 ∧ WellFormed m u.2.2) :
    scan n m us =
      match (us.map (denoteTriple m)).find? GridEntryAlgorithm.valid with
      | none => [false,false]
      | some u => GridTableAlgorithm.localBits n m u.1.1 u.1.2 := by
  induction us with
  | nil => rfl
  | cons u us ih =>
    have hu := hw u (by simp)
    have ht := ih (fun v hv => hw v (by simp [hv]))
    have he := valid_eq u.1 u.2.1 u.2.2 hu.1 hu.2.1 hu.2.2
    change valid m u = GridEntryAlgorithm.valid (denoteTriple m u) at he
    simp only [scan,List.map_cons,List.find?_cons]
    rw [he]
    by_cases hv : GridEntryAlgorithm.valid (denoteTriple m u) = true
    · simp only [hv,↓reduceIte]
      exact localBits_eq n u.1 hu.1
    · simp only [Bool.eq_false_iff.mpr hv,↓reduceIte]
      exact ht

def compute (n m : ℕ) (a b c : Index) : List Bool := scan n m (orientations a b c)

lemma compute_correct {m : ℕ} (n : ℕ) (a b c : Index)
    (ha : WellFormed m a) (hb : WellFormed m b) (hc : WellFormed m c) :
    compute n m a b c = GridEntryAlgorithm.compute n m (denote m a) (denote m b) (denote m c) := by
  have h := scan_correct n m (orientations a b c) (by
    intro u hu
    simp only [orientations,List.mem_cons,List.not_mem_nil,or_false] at hu
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl
    all_goals exact ⟨by assumption,by assumption,by assumption⟩)
  exact h

def entry (n m a b c : ℕ) : List Bool :=
  compute n m (decode m a) (decode m b) (decode m c)

theorem entry_eq (n a b c : ℕ)
    (ha : a < 5*(gridSide n)^2) (hb : b < 5*(gridSide n)^2) (hc : c < 5*(gridSide n)^2) :
    entry n (gridSide n) a b c = entryCode (gridTensor n
      (gridIdxOfNat (gridSide n) a ::ₛ gridIdxOfNat (gridSide n) b ::ₛ
        gridIdxOfNat (gridSide n) c ::ₛ Sym.nil)) := by
  have hm : 0 < gridSide n := by have := side_ge_four n; omega
  rw [entry,compute_correct n _ _ _ (decode_wellFormed hm ha)
    (decode_wellFormed hm hb) (decode_wellFormed hm hc)]
  exact GridEntryAlgorithm.compute_eq n _ _ _

def table (n m : ℕ) : List Bool :=
  (List.range (5*m^2)).flatMap fun a =>
    (List.range (5*m^2)).flatMap fun b =>
      (List.range (5*m^2)).flatMap fun c => entry n m a b c

theorem table_eq (n : ℕ) : table n (gridSide n) = gridTableCode n := by
  unfold table gridTableCode
  apply List.flatMap_congr
  intro a ha
  apply List.flatMap_congr
  intro b hb
  apply List.flatMap_congr
  intro c hc
  exact entry_eq n a b c (List.mem_range.mp ha) (List.mem_range.mp hb) (List.mem_range.mp hc)

end GridNatEntry
end

-- Helpers from Solutions.GridEntryPrep
section
namespace GridEntryPrep
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions

abbrev sreg (v : Small) : Reg := loc (widen v)

lemma sreg_lt (v : Small) : (sreg v).val < 29 := v.isLt

@[simp] lemma tailClean_set (s : State) (r : Reg) (n : ℕ) (hr : r.val < 29) :
    TailClean 29 (s.set r n) ↔ TailClean 29 s := by
  have he : ∀ k : Reg,29 ≤ k.val → (s.set r n).regs k = s.regs k := by
    intro k hk
    apply set_other
    intro h
    subst k
    omega
  constructor
  · intro h k hk
    rw [← he k hk]
    exact h k hk
  · intro h k hk
    rw [he k hk]
    exact h k hk

def assignTest (dst : Small) (p : Test) : Script :=
  p.compile (.literal (widen dst) 1) (.literal (widen dst) 0)

lemma assignTest_eval (dst : Small) (p : Test) (s : State) (hs : TailClean 29 s) :
    (assignTest dst p).eval s = s.set (sreg dst) (if p.eval s then 1 else 0) := by
  rw [assignTest,Test.correct _ _ _ _ hs]
  split_ifs <;> rfl

def assignX (dst src : Small) : Script := assignTest dst (.compare .eq (.var src) (.lit 4))
def assignP (dst src : Small) : Script := assignTest dst
  (.or (.compare .eq (.var src) (.lit 2)) (.compare .eq (.var src) (.lit 3)))
def assignQ (dst src : Small) : Script := assignTest dst
  (.or (.compare .eq (.var src) (.lit 1)) (.compare .eq (.var src) (.lit 3)))

lemma assignX_eval (dst src : Small) (s : State) (hs : TailClean 29 s) :
    (assignX dst src).eval s = s.set (sreg dst) (GridNatEntry.x (s.regs (sreg src))) := by
  rw [assignX,assignTest_eval _ _ _ hs]
  dsimp +instances [Test.eval,Comparison.eval,Value.eval]
  simp [GridNatEntry.x,sreg]

lemma assignP_eval (dst src : Small) (s : State) (hs : TailClean 29 s) :
    (assignP dst src).eval s = s.set (sreg dst) (GridNatEntry.p (s.regs (sreg src))) := by
  rw [assignP,assignTest_eval _ _ _ hs]
  dsimp +instances [Test.eval,Comparison.eval,Value.eval]
  simp [GridNatEntry.p,sreg]

lemma assignQ_eval (dst src : Small) (s : State) (hs : TailClean 29 s) :
    (assignQ dst src).eval s = s.set (sreg dst) (GridNatEntry.q (s.regs (sreg src))) := by
  rw [assignQ,assignTest_eval _ _ _ hs]
  dsimp +instances [Test.eval,Comparison.eval,Value.eval]
  simp [GridNatEntry.q,sreg]

def low (i : Fin 18) : Small := ⟨i.val,by omega⟩

structure Slots where
  row : Fin 18
  col : Fin 18
  state : Fin 18

abbrev values (s : State) (a : Slots) : GridNatEntry.Index :=
  ⟨s.regs (sreg (low a.row)),s.regs (sreg (low a.col)),s.regs (sreg (low a.state))⟩

lemma low_ne (i : Fin 18) (r : Reg) (hr : 18 ≤ r.val) : sreg (low i) ≠ r := by
  intro h
  have hi : (sreg (low i)).val < 18 := i.isLt
  rw [h] at hi
  omega

@[simp] lemma values_set (s : State) (a : Slots) (r : Reg) (n : ℕ) (hr : 18 ≤ r.val) :
    values (s.set r n) a = values s a := by
  simp only [values,set_other _ _ (low_ne a.row r hr),set_other _ _ (low_ne a.col r hr),
    set_other _ _ (low_ne a.state r hr)]

def bits (a b c : Slots) : Script := .seq (assignX 18 (low a.state))
  (.seq (assignP 19 (low a.state)) (.seq (assignQ 20 (low a.state))
    (.seq (assignP 21 (low b.state)) (assignQ 22 (low c.state)))))

def bitState (s : State) (a b c : Slots) : State :=
  ((((s.set (sreg 18) (GridNatEntry.x (values s a).state)).set (sreg 19)
    (GridNatEntry.p (values s a).state)).set (sreg 20) (GridNatEntry.q (values s a).state)).set
    (sreg 21) (GridNatEntry.p (values s b).state)).set (sreg 22) (GridNatEntry.q (values s c).state)

lemma bits_eval (a b c : Slots) (s : State) (hs : TailClean 29 s) :
    (bits a b c).eval s = bitState s a b c := by
  unfold bits
  simp only [Script.eval]
  rw [assignX_eval 18 (low a.state) _ hs]
  rw [assignP_eval 19 (low a.state) _ (by simpa (disch := decide) only [tailClean_set] using hs)]
  rw [assignQ_eval 20 (low a.state) _ (by simpa (disch := decide) only [tailClean_set] using hs)]
  rw [assignP_eval 21 (low b.state) _ (by simpa (disch := decide) only [tailClean_set] using hs)]
  rw [assignQ_eval 22 (low c.state) _ (by simpa (disch := decide) only [tailClean_set] using hs)]
  simp only [set_other _ _ (low_ne a.state _ (by decide : 18 ≤ (sreg 18).val)),
    set_other _ _ (low_ne a.state _ (by decide : 18 ≤ (sreg 19).val)),
    set_other _ _ (low_ne b.state _ (by decide : 18 ≤ (sreg 18).val)),
    set_other _ _ (low_ne b.state _ (by decide : 18 ≤ (sreg 19).val)),
    set_other _ _ (low_ne b.state _ (by decide : 18 ≤ (sreg 20).val)),
    set_other _ _ (low_ne c.state _ (by decide : 18 ≤ (sreg 18).val)),
    set_other _ _ (low_ne c.state _ (by decide : 18 ≤ (sreg 19).val)),
    set_other _ _ (low_ne c.state _ (by decide : 18 ≤ (sreg 20).val)),
    set_other _ _ (low_ne c.state _ (by decide : 18 ≤ (sreg 21).val)),bitState,values]

def lit (dst : Small) (n : ℕ) : Script := .literal (widen dst) n
def bin (op : GridScratch.BinOp) (dst a b : Small) : Script :=
  .binary op (widen dst) (widen a) (widen b)

@[simp] lemma lit_eval (dst : Small) (n : ℕ) (s : State) :
    (lit dst n).eval s = s.set (sreg dst) n := rfl

@[simp] lemma bin_eval (op : GridScratch.BinOp) (dst a b : Small) (s : State) :
    (bin op dst a b).eval s = s.set (sreg dst) (op.eval (s.regs (sreg a)) (s.regs (sreg b))) := rfl

@[simp] lemma read_low_set (s : State) (i : Fin 18) (r : Reg) (n : ℕ) (hr : 18 ≤ r.val) :
    (s.set r n).regs (sreg (low i)) = s.regs (sreg (low i)) := set_other _ _ (low_ne i r hr)

def linearArithmetic (a : Slots) : Script := .seq (lit 28 1)
  (.seq (bin .add 23 19 18) (.seq (bin .add 24 20 18) (.seq (bin .sub 25 1 28)
    (.seq (bin .add 26 (low a.row) 28) (bin .add 27 (low a.col) 28)))))

def linearState (s : State) (a : Slots) : State :=
  (((((s.set (sreg 28) 1).set (sreg 23) (s.regs (sreg 19)+s.regs (sreg 18))).set
    (sreg 24) (s.regs (sreg 20)+s.regs (sreg 18))).set (sreg 25) (s.regs (sreg 1)-1)).set
    (sreg 26) ((values s a).row+1)).set (sreg 27) ((values s a).col+1)

lemma linearArithmetic_eval (a : Slots) (s : State) :
    (linearArithmetic a).eval s = linearState s a := by
  simp (disch := decide) [linearArithmetic,Script.eval,lit,bin,GridScratch.BinOp.eval,
    linearState,values,read_low_set]

lemma linearState_clean (s : State) (a : Slots) (hs : TailClean 29 s) :
    TailClean 29 (linearState s a) := by
  simpa (disch := decide) only [linearState,tailClean_set] using hs

def wrap (dst : Small) : Script :=
  (Test.compare .eq (.var dst) (.var 1)).compile (lit dst 0) .skip

lemma wrap_eval (dst : Small) (s : State) (hs : TailClean 29 s) :
    (wrap dst).eval s = s.set (sreg dst)
      (if s.regs (sreg dst) = s.regs (sreg 1) then 0 else s.regs (sreg dst)) := by
  rw [wrap,Test.correct _ _ _ _ hs]
  dsimp +instances [Test.eval,Comparison.eval,Value.eval]
  by_cases h : s.regs (sreg dst) = s.regs (sreg 1)
  · simp [h,sreg,lit,Script.eval] at *
  · simpa [h,sreg,lit,Script.eval] using (set_self s (sreg dst)).symm

def arithmetic (a : Slots) : Script := .seq (linearArithmetic a) (.seq (wrap 26) (wrap 27))

def arithState (s : State) (a : Slots) : State :=
  ((linearState s a).set (sreg 26) (GridNatEntry.next (s.regs (sreg 1)) (values s a).row)).set
    (sreg 27) (GridNatEntry.next (s.regs (sreg 1)) (values s a).col)

lemma arithmetic_eval (a : Slots) (s : State) (hs : TailClean 29 s) :
    (arithmetic a).eval s = arithState s a := by
  simp only [arithmetic,Script.eval,linearArithmetic_eval]
  rw [wrap_eval 26 _ (linearState_clean s a hs)]
  rw [wrap_eval 27 _ (by simpa (disch := decide) only [tailClean_set] using linearState_clean s a hs)]
  simp (disch := decide) [linearState,arithState,GridNatEntry.next]

def prepare (a b c : Slots) : Script := .seq (bits a b c) (arithmetic a)
def prepared (s : State) (a b c : Slots) : State := arithState (bitState s a b c) a

lemma prepare_eval (a b c : Slots) (s : State) (hs : TailClean 29 s) :
    (prepare a b c).eval s = prepared s a b c := by
  simp only [prepare,Script.eval,bits_eval a b c s hs]
  exact arithmetic_eval a _ (by simpa (disch := decide) only [bitState,tailClean_set] using hs)

end GridEntryPrep
end

-- Helpers from Solutions.GridEntryTest
section
namespace GridEntryTest
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions GridEntryPrep

def eq (a b : Value) : Test := .compare .eq a b
def lt (a b : Value) : Test := .compare .lt a b
def imp (p q : Test) : Test := .or (.not p) q

def all : List Test → Test
  | [] => eq (.lit 0) (.lit 0)
  | p :: ps => .and p (all ps)

def test (a b c : Slots) : Test := all [
  eq (.var (low b.row)) (.var 26),
  eq (.var (low b.col)) (.var (low a.col)),
  eq (.var (low c.row)) (.var (low a.row)),
  eq (.var (low c.col)) (.var 27),
  imp (eq (.var (low a.row)) (.lit 0)) (eq (.var 19) (.lit 0)),
  imp (eq (.var (low a.col)) (.lit 0)) (eq (.var 20) (.lit 0)),
  imp (lt (.var (low a.row)) (.var 25)) (eq (.var 21) (.var 23)),
  imp (lt (.var (low a.col)) (.var 25)) (eq (.var 22) (.var 24)),
  imp (eq (.var (low a.row)) (.var 25)) (eq (.var 23) (.lit 1)),
  imp (eq (.var (low a.col)) (.var 25)) (eq (.var 24) (.lit 1))]

lemma prepared_clean (a b c : Slots) (s : State) (hs : TailClean 29 s) :
    TailClean 29 (prepared s a b c) := by
  simpa (disch := decide) only [prepared,arithState,linearState,bitState,tailClean_set] using hs

lemma prepared_low (a b c : Slots) (s : State) (i : Fin 18) :
    (prepared s a b c).regs (sreg (low i)) = s.regs (sreg (low i)) := by
  simp (disch := decide) only [prepared,arithState,linearState,bitState,read_low_set]

theorem test_correct (a b c : Slots) (s : State) :
    (test a b c).eval (prepared s a b c) =
      GridNatEntry.valid (s.regs (sreg 1)) (values s a,values s b,values s c) := by
  apply Bool.eq_iff_iff.mpr
  dsimp +instances [test,all,eq,lt,imp,Test.eval,Comparison.eval,Value.eval,GridNatEntry.valid]
  simp +instances (disch := decide) [prepared_low,prepared,arithState,linearState,bitState,values,
    Bool.or_eq_true,Bool.and_eq_true,Bool.not_eq_true] <;> omega

def program (a b c : Slots) (yes no : Script) : Script :=
  .seq (GridEntryPrep.prepare a b c) ((test a b c).compile yes no)

theorem program_eval (a b c : Slots) (yes no : Script) (s : State) (hs : TailClean 29 s) :
    (program a b c yes no).eval s =
      if GridNatEntry.valid (s.regs (sreg 1)) (values s a,values s b,values s c)
      then yes.eval (prepared s a b c) else no.eval (prepared s a b c) := by
  simp only [program,Script.eval,prepare_eval a b c s hs]
  rw [Test.correct _ _ _ _ (prepared_clean a b c s hs),test_correct]

end GridEntryTest
end

-- Helpers from Solutions.GridEntryPayload
section
namespace GridEntryPayload
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions GridEntryPrep

def constant (b : Bool) : Script := .seq (.emit false) (.emit b)

lemma constant_eval (b : Bool) (s : State) :
    (constant b).eval s = GridNatOutput.withOutput s ([false,b].reverse ++ s.output) := rfl

def variableCode (i j : Small) : Script := .seq (.emit true) (.seq (.unary (widen i))
  (.seq (.emit false) (.seq (.unary (widen j)) (.emit false))))

lemma variable_eval (i j : Small) (s : State) :
    (variableCode i j).eval s = GridNatOutput.withOutput s
      ((GridTableAlgorithm.variableBits (s.regs (sreg i)) (s.regs (sreg j))).reverse ++ s.output) := by
  simp [variableCode,Script.eval,State.emit,GridNatOutput.withOutput,GridTableAlgorithm.variableBits,
    List.reverse_append,List.reverse_cons,List.reverse_replicate,List.append_assoc,sreg]

def payload (a : Slots) : Script :=
  (Test.compare .eq (.var (low a.state)) (.lit 4)).compile
    ((Test.and (.compare .lt (.var (low a.row)) (.var 0))
      (.compare .lt (.var (low a.col)) (.var 0))).compile
        (variableCode (low a.row) (low a.col))
        ((Test.compare .eq (.var (low a.row)) (.var (low a.col))).compile
          (constant true) (constant false)))
    (constant true)

theorem payload_eval (a : Slots) (s : State) (hs : TailClean 29 s) :
    (payload a).eval s = GridNatOutput.withOutput s
      ((GridNatEntry.localBits (s.regs (sreg 0)) (values s a)).reverse ++ s.output) := by
  unfold payload
  rw [Test.correct _ _ _ s hs]
  rw [Test.correct _ _ _ s hs]
  rw [Test.correct _ _ _ s hs]
  simp only [variable_eval,constant_eval]
  dsimp +instances [Test.eval,Comparison.eval,Value.eval,GridNatEntry.localBits,values]
  simp +instances only [Bool.and_eq_true,decide_eq_true_eq]
  split_ifs <;> rfl

end GridEntryPayload
end

-- Helpers from Solutions.GridEntryScan
section
namespace GridEntryScan
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions GridEntryPrep
open GridEntryAlgorithm

abbrev Orientation := Triple Slots

def indices (s : State) (u : Orientation) : Triple GridNatEntry.Index :=
  (values s u.1,values s u.2.1,values s u.2.2)

lemma values_prepared (a b c v : Slots) (s : State) :
    values (prepared s a b c) v = values s v := by
  simp only [values,GridEntryTest.prepared_low]

lemma indices_prepared (a b c : Slots) (v : Orientation) (s : State) :
    indices (prepared s a b c) v = indices s v := by
  simp only [indices,values_prepared]

@[simp] lemma prepared_output (s : State) (a b c : Slots) :
    (prepared s a b c).output = s.output := rfl

lemma nat_scan_cons (n m : ℕ) (u : Triple GridNatEntry.Index) (us : List (Triple GridNatEntry.Index)) :
    GridNatEntry.scan n m (u :: us) =
      if GridNatEntry.valid m u then GridNatEntry.localBits n u.1 else GridNatEntry.scan n m us := by
  unfold GridNatEntry.scan
  rw [List.find?_cons]
  by_cases h : GridNatEntry.valid m u = true
  · simp [h]
  · simp [h]

def script : List Orientation → Script
  | [] => GridEntryPayload.constant false
  | u :: us => GridEntryTest.program u.1 u.2.1 u.2.2 (GridEntryPayload.payload u.1) (script us)

theorem script_eval (us : List Orientation) (s : State) (hs : TailClean 29 s) :
    TailClean 29 ((script us).eval s) ∧
    (∀ i : Fin 18,((script us).eval s).regs (sreg (low i)) = s.regs (sreg (low i))) ∧
    ((script us).eval s).output =
      (GridNatEntry.scan (s.regs (sreg 0)) (s.regs (sreg 1)) (us.map (indices s))).reverse ++ s.output := by
  induction us generalizing s with
  | nil => exact ⟨hs,fun _ => rfl,rfl⟩
  | cons u us ih =>
    have hclean := GridEntryTest.prepared_clean u.1 u.2.1 u.2.2 s hs
    have hzero : (prepared s u.1 u.2.1 u.2.2).regs (sreg 0) = s.regs (sreg 0) :=
      GridEntryTest.prepared_low _ _ _ s 0
    have hone : (prepared s u.1 u.2.1 u.2.2).regs (sreg 1) = s.regs (sreg 1) :=
      GridEntryTest.prepared_low _ _ _ s 1
    have hmap : us.map (indices (prepared s u.1 u.2.1 u.2.2)) = us.map (indices s) := by
      apply List.map_congr_left
      intro v _
      exact indices_prepared _ _ _ _ _
    simp only [script,GridEntryTest.program_eval _ _ _ _ _ s hs,List.map_cons,nat_scan_cons]
    change _ ∧ _ ∧ _ =
      (if GridNatEntry.valid (s.regs (sreg 1)) (indices s u) then
        GridNatEntry.localBits (s.regs (sreg 0)) (values s u.1)
      else GridNatEntry.scan (s.regs (sreg 0)) (s.regs (sreg 1)) (us.map (indices s))).reverse ++ s.output
    by_cases hv : GridNatEntry.valid (s.regs (sreg 1)) (indices s u) = true
    · have hv' : GridNatEntry.valid (s.regs (sreg 1))
          (values s u.1,values s u.2.1,values s u.2.2) = true := hv
      simp only [hv,hv',↓reduceIte,
        GridEntryPayload.payload_eval u.1 _ hclean]
      refine ⟨hclean,?_,?_⟩
      · exact fun i => GridEntryTest.prepared_low _ _ _ s i
      · simp only [GridNatOutput.withOutput,hzero,values_prepared]
        rfl
    · have hv' : GridNatEntry.valid (s.regs (sreg 1))
          (values s u.1,values s u.2.1,values s u.2.2) ≠ true := hv
      simp only [if_neg hv,if_neg hv']
      obtain ⟨hc,hl,ho⟩ := ih (prepared s u.1 u.2.1 u.2.2) hclean
      refine ⟨hc,?_,?_⟩
      · exact fun i => (hl i).trans (GridEntryTest.prepared_low _ _ _ s i)
      · simpa only [hzero,hone,hmap,prepared_output] using ho

end GridEntryScan
end

-- Helpers from Solutions.GridEntryDecode
section
namespace GridEntryDecode
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions GridEntryPrep

def slotsA : Slots := ⟨9,10,11⟩
def slotsB : Slots := ⟨12,13,14⟩
def slotsC : Slots := ⟨15,16,17⟩

def one (src : Small) (dst : Slots) : Script := .seq (lit 18 5)
  (.seq (bin .div 19 src 18) (.seq (bin .div (low dst.row) 19 1)
    (.seq (bin .mod (low dst.col) 19 1) (bin .mod (low dst.state) src 18))))

def oneState (s : State) (src : Small) (dst : Slots) : State :=
  let d := GridNatEntry.decode (s.regs (sreg 1)) (s.regs (sreg src))
  ((((s.set (sreg 18) 5).set (sreg 19) (s.regs (sreg src)/5)).set
    (sreg (low dst.row)) d.row).set (sreg (low dst.col)) d.col).set
    (sreg (low dst.state)) d.state

lemma one_A (s : State) : (one 3 slotsA).eval s = oneState s 3 slotsA := by
  simp (disch := decide) [one,Script.eval,bin,lit,GridScratch.BinOp.eval,
    oneState,GridNatEntry.decode,slotsA,low]
lemma one_B (s : State) : (one 4 slotsB).eval s = oneState s 4 slotsB := by
  simp (disch := decide) [one,Script.eval,bin,lit,GridScratch.BinOp.eval,
    oneState,GridNatEntry.decode,slotsB,low]
lemma one_C (s : State) : (one 5 slotsC).eval s = oneState s 5 slotsC := by
  simp (disch := decide) [one,Script.eval,bin,lit,GridScratch.BinOp.eval,
    oneState,GridNatEntry.decode,slotsC,low]

def script : Script := .seq (one 3 slotsA) (.seq (one 4 slotsB) (one 5 slotsC))
def decoded (s : State) : State := oneState (oneState (oneState s 3 slotsA) 4 slotsB) 5 slotsC

theorem script_eval (s : State) : script.eval s = decoded s := by
  simp only [script,Script.eval,one_A,one_B,one_C,decoded]

abbrev base (i : Fin 9) : Small := ⟨i.val,by omega⟩

lemma base_ne (i : Fin 9) (r : Reg) (hr : 9 ≤ r.val) : sreg (base i) ≠ r := by
  intro h
  have hi : (sreg (base i)).val < 9 := i.isLt
  rw [h] at hi
  omega

@[simp] lemma read_base_set (s : State) (i : Fin 9) (r : Reg) (n : ℕ) (hr : 9 ≤ r.val) :
    (s.set r n).regs (sreg (base i)) = s.regs (sreg (base i)) :=
  set_other _ _ (base_ne i r hr)

theorem decoded_base (s : State) (i : Fin 9) :
    (decoded s).regs (sreg (base i)) = s.regs (sreg (base i)) := by
  simp (disch := decide) only [decoded,oneState,slotsA,slotsB,slotsC,read_base_set]

theorem decoded_clean (s : State) (hs : TailClean 29 s) : TailClean 29 (decoded s) := by
  simpa (disch := decide) only [decoded,oneState,slotsA,slotsB,slotsC,tailClean_set] using hs

theorem decoded_A (s : State) : values (decoded s) slotsA =
    GridNatEntry.decode (s.regs (sreg 1)) (s.regs (sreg 3)) := by
  simp (disch := decide) [decoded,oneState,values,slotsA,slotsB,slotsC,low,GridNatEntry.decode]

theorem decoded_B (s : State) : values (decoded s) slotsB =
    GridNatEntry.decode (s.regs (sreg 1)) (s.regs (sreg 4)) := by
  simp (disch := decide) [decoded,oneState,values,slotsA,slotsB,slotsC,low,GridNatEntry.decode]

theorem decoded_C (s : State) : values (decoded s) slotsC =
    GridNatEntry.decode (s.regs (sreg 1)) (s.regs (sreg 5)) := by
  simp (disch := decide) [decoded,oneState,values,slotsA,slotsB,slotsC,low,GridNatEntry.decode]

@[simp] lemma decoded_output (s : State) : (decoded s).output = s.output := rfl

end GridEntryDecode
end

-- Helpers from Solutions.GridEntryProgram
section
namespace GridEntryProgram
open GridNatProgram GridNatArithmetic GridStraightLine GridConditions GridEntryPrep
open GridEntryDecode GridEntryAlgorithm GridNatOutput GridNatControl

def choices : List GridEntryScan.Orientation := orientations slotsA slotsB slotsC

def script : Script := .seq GridEntryDecode.script (.seq (GridEntryScan.script choices) (.clear 9))

def bits (s : State) : List Bool := GridNatEntry.entry (s.regs 0) (s.regs 1)
  (s.regs 3) (s.regs 4) (s.regs 5)

lemma choices_indices (s : State) : choices.map (GridEntryScan.indices (decoded s)) =
    orientations (GridNatEntry.decode (s.regs 1) (s.regs 3))
      (GridNatEntry.decode (s.regs 1) (s.regs 4))
      (GridNatEntry.decode (s.regs 1) (s.regs 5)) := by
  simp only [choices,orientations,List.map_cons,List.map_nil,GridEntryScan.indices,
    decoded_A,decoded_B,decoded_C]
  rfl

attribute [local irreducible] GridEntryScan.script GridEntryDecode.decoded

lemma clear_frame (s u : State) (out : List Bool) (hs : TailClean 9 s)
    (hl : ∀ r : Reg,r.val < 9 → u.regs r = s.regs r) (ho : u.output = out) :
    (Script.clear 9).eval u = withOutput s out := by
  apply state_ext
  · intro r
    change (if 9 ≤ r.val then 0 else u.regs r) = s.regs r
    by_cases hr : 9 ≤ r.val
    · simpa only [if_pos hr] using (hs r hr).symm
    · simpa only [if_neg hr] using hl r (by omega)
  · exact ho

theorem script_eval (s : State) (hs : TailClean 9 s) :
    script.eval s = withOutput s ((bits s).reverse ++ s.output) := by
  have hs29 : TailClean 29 s := fun r hr => hs r (by omega)
  obtain ⟨_,hl,ho⟩ := GridEntryScan.script_eval choices (decoded s) (decoded_clean s hs29)
  have hzero : (decoded s).regs (sreg 0) = s.regs 0 := decoded_base s 0
  have hone : (decoded s).regs (sreg 1) = s.regs 1 := decoded_base s 1
  have ho' : ((GridEntryScan.script choices).eval (decoded s)).output =
      (bits s).reverse ++ s.output := by
    simpa only [choices_indices,hzero,hone,decoded_output,
      bits,GridNatEntry.entry,GridNatEntry.compute] using ho
  rw [script,Script.eval,GridEntryDecode.script_eval,Script.eval]
  apply clear_frame s _ _ hs
  · intro r hr
    have hh := hl ⟨r.val,by omega⟩
    have he : sreg (low (⟨r.val,by omega⟩ : Fin 18)) = r := rfl
    rw [he] at hh
    have hb := decoded_base s ⟨r.val,hr⟩
    have he' : sreg (base ⟨r.val,hr⟩) = r := rfl
    rw [he'] at hb
    exact hh.trans hb
  · exact ho'

def code : Code := script.compile
noncomputable def timeBound : Polynomial ℕ := script.timeBound

theorem runs (s : State) (M : ℕ) (hs : TailClean 9 s) (hM : Bounded s M) :
    ∃ t,Runs code s (withOutput s ((bits s).reverse ++ s.output)) t ∧
      t ≤ timeBound.eval M := by
  obtain ⟨t,ht,hb,_,_⟩ := Script.correct script s M (fun r hr => hs r (by omega)) hM
  rw [script_eval s hs] at ht
  exact ⟨t,ht,hb⟩

end GridEntryProgram
end

-- Helpers from Solutions.GridForEach
section
namespace GridForEach
open GridNatProgram GridNatArithmetic GridNatControl GridNatOutput GridConditions

def code (size counter fuel : Reg) (hne : size ≠ fuel) (body : Code) : Code :=
  .seq (.copy size fuel hne)
    (.seq (.loop fuel (.seq body (.seq (.inc counter) (.dec fuel)))) (.zero counter))

def atIndex (s : State) (counter fuel : Reg) (N i : ℕ) (out : List Bool) : State :=
  withOutput ((s.set counter i).set fuel (N-i)) out

def outputPrefix (f : ℕ → List Bool) (i : ℕ) (out : List Bool) : List Bool :=
  ((List.range i).flatMap f).reverse ++ out

lemma outputPrefix_zero (f : ℕ → List Bool) (out : List Bool) : outputPrefix f 0 out = out := rfl

lemma outputPrefix_succ (f : ℕ → List Bool) (i : ℕ) (out : List Bool) :
    outputPrefix f (i+1) out = (f i).reverse ++ outputPrefix f i out := by
  simp [outputPrefix,List.range_succ,List.flatMap_append,List.reverse_append,List.append_assoc]

@[simp] lemma atIndex_counter (s : State) (counter fuel : Reg) (N i : ℕ) (out : List Bool)
    (hne : counter ≠ fuel) : (atIndex s counter fuel N i out).regs counter = i := by
  simp [atIndex,hne]

@[simp] lemma atIndex_fuel (s : State) (counter fuel : Reg) (N i : ℕ) (out : List Bool) :
    (atIndex s counter fuel N i out).regs fuel = N-i := by simp [atIndex]

@[simp] lemma atIndex_other (s : State) (counter fuel r : Reg) (N i : ℕ) (out : List Bool)
    (hc : r ≠ counter) (hf : r ≠ fuel) :
    (atIndex s counter fuel N i out).regs r = s.regs r := by simp [atIndex,hc,hf]

lemma atIndex_bounded {s : State} {M : ℕ} (hs : Bounded s M)
    (counter fuel : Reg) (N i : ℕ) (out : List Bool) (hN : N ≤ M) (hi : i ≤ N) :
    Bounded (atIndex s counter fuel N i out) M :=
  bounded_set (bounded_set hs counter i (by omega)) fuel (N-i) (by omega)

lemma atIndex_clean {s : State} {k : ℕ} (hs : TailClean k s)
    (counter fuel : Reg) (N i : ℕ) (out : List Bool) (hc : counter.val < k) (hf : fuel.val < k) :
    TailClean k (atIndex s counter fuel N i out) := by
  intro r hr
  have hrc : r ≠ counter := by intro h; subst r; omega
  have hrf : r ≠ fuel := by intro h; subst r; omega
  rw [atIndex_other _ _ _ _ _ _ _ hrc hrf]
  exact hs r hr

theorem runs (size counter fuel : Reg) (hsf : size ≠ fuel) (hcf : counter ≠ fuel)
    (body : Code) (s : State) (N B : ℕ) (f : ℕ → List Bool)
    (hsize : s.regs size = N) (hcounter : s.regs counter = 0) (hfuel : s.regs fuel = 0)
    (hb : ∀ i < N,∀ out,∃ t,
      Runs body (atIndex s counter fuel N i out)
        (atIndex s counter fuel N i ((f i).reverse ++ out)) t ∧ t ≤ B) :
    ∃ t,Runs (code size counter fuel hsf body) s
      (withOutput s (outputPrefix f N s.output)) t ∧ t ≤ (B+14)*N+7 := by
  let states := fun i => atIndex s counter fuel N i (outputPrefix f i s.output)
  have hstep : ∀ i < N,∃ t,
      Runs (.seq body (.seq (.inc counter) (.dec fuel))) (states i) (states (i+1)) t ∧
        t ≤ B+2 := by
    intro i hi
    obtain ⟨t,ht,htb⟩ := hb i hi (outputPrefix f i s.output)
    let u := atIndex s counter fuel N i ((f i).reverse ++ outputPrefix f i s.output)
    have hr : Runs (.seq body (.seq (.inc counter) (.dec fuel))) (states i)
        (((u.set counter (u.regs counter+1))).set fuel
          ((u.set counter (u.regs counter+1)).regs fuel-1)) (t+(1+1)) :=
      Runs.seq ht (Runs.seq (Runs.inc u counter) (Runs.dec (u.set counter (u.regs counter+1)) fuel))
    have he : ((u.set counter (u.regs counter+1))).set fuel
        ((u.set counter (u.regs counter+1)).regs fuel-1) = states (i+1) := by
      apply state_ext
      · intro r
        by_cases hrc : r = counter
        · subst r
          simp [u,states,atIndex,State.set,hcf,hcf.symm]
        · by_cases hrf : r = fuel
          · subst r
            simp [u,states,atIndex,State.set,hcf,hcf.symm,Nat.sub_sub]
          · simp [u,states,atIndex,State.set,hrc,hrf]
      · exact (outputPrefix_succ f i s.output).symm
    rw [he] at hr
    exact ⟨_,hr,by omega⟩
  obtain ⟨t,ht,htb⟩ := loop_range _ fuel N (B+2) states
    (fun i _ => atIndex_fuel _ _ _ _ _ _) hstep
  have hstart : states 0 = s.set fuel N := by
    change withOutput ((s.set counter 0).set fuel (N-0)) s.output = s.set fuel N
    have hc : s.set counter 0 = s := by rw [← hcounter,set_self]
    rw [hc,Nat.sub_zero]
    rfl
  have hend : (states N).set counter 0 = withOutput s (outputPrefix f N s.output) := by
    apply state_ext
    · intro r
      by_cases hc : r = counter
      · subst r
        simpa only [set_get,withOutput_regs] using hcounter.symm
      · by_cases hf : r = fuel
        · subst r
          simp [states,atIndex,State.set,hcf.symm,hfuel]
        · simp [states,atIndex,State.set,hc,hf]
    · rfl
  have hctrN : (states N).regs counter = N := atIndex_counter _ _ _ _ _ _ hcf
  have hclear := Runs.zero (states N) counter
  rw [hend,hctrN] at hclear
  rw [hstart] at ht
  have hcopy := Runs.copy s size fuel hsf
  rw [hsize,hfuel] at hcopy
  refine ⟨_,Runs.seq hcopy (Runs.seq ht hclear),?_⟩
  nlinarith only [htb]

end GridForEach
end

-- Helpers from Solutions.GridTableLoops
section
namespace GridTableLoops
open GridNatProgram GridNatArithmetic GridNatControl GridNatOutput GridConditions GridForEach

def inner : Code := GridForEach.code 2 5 8 (by decide) GridEntryProgram.code
def middle : Code := GridForEach.code 2 4 7 (by decide) inner
def outer : Code := GridForEach.code 2 3 6 (by decide) middle

noncomputable def innerBound (M N : ℕ) : ℕ := (GridEntryProgram.timeBound.eval M+14)*N+7
noncomputable def middleBound (M N : ℕ) : ℕ := (innerBound M N+14)*N+7
noncomputable def outerBound (M N : ℕ) : ℕ := (middleBound M N+14)*N+7

@[simp] lemma atIndex_output (s : State) (counter fuel : Reg) (N i : ℕ) (out : List Bool) :
    (atIndex s counter fuel N i out).output = out := rfl

@[simp] lemma withOutput_atIndex (s : State) (counter fuel : Reg) (N i : ℕ) (out out' : List Bool) :
    withOutput (atIndex s counter fuel N i out) out' = atIndex s counter fuel N i out' := rfl

theorem inner_runs (s : State) (M N : ℕ) (hs : TailClean 9 s) (hM : Bounded s M)
    (hN : s.regs 2 = N) (h5 : s.regs 5 = 0) (h8 : s.regs 8 = 0) :
    ∃ t,Runs inner s
      (withOutput s (((List.range N).flatMap fun c =>
        GridNatEntry.entry (s.regs 0) (s.regs 1) (s.regs 3) (s.regs 4) c).reverse ++ s.output)) t ∧
      t ≤ innerBound M N := by
  apply GridForEach.runs 2 5 8 (by decide) (by decide) GridEntryProgram.code s N
    (GridEntryProgram.timeBound.eval M) _ hN h5 h8
  intro i hi out
  obtain ⟨t,ht,hb⟩ := GridEntryProgram.runs (atIndex s 5 8 N i out) M
    (atIndex_clean hs _ _ _ _ _ (by decide) (by decide))
    (atIndex_bounded hM _ _ _ _ _ (by simpa [hN] using hM 2) (by omega))
  have he : GridEntryProgram.bits (atIndex s 5 8 N i out) =
      GridNatEntry.entry (s.regs 0) (s.regs 1) (s.regs 3) (s.regs 4) i := by
    simp [GridEntryProgram.bits,atIndex,State.set]
  rw [he,atIndex_output,withOutput_atIndex] at ht
  exact ⟨t,ht,hb⟩

theorem middle_runs (s : State) (M N : ℕ) (hs : TailClean 9 s) (hM : Bounded s M)
    (hN : s.regs 2 = N) (h4 : s.regs 4 = 0) (h5 : s.regs 5 = 0)
    (h7 : s.regs 7 = 0) (h8 : s.regs 8 = 0) :
    ∃ t,Runs middle s
      (withOutput s (((List.range N).flatMap fun b => (List.range N).flatMap fun c =>
        GridNatEntry.entry (s.regs 0) (s.regs 1) (s.regs 3) b c).reverse ++ s.output)) t ∧
      t ≤ middleBound M N := by
  apply GridForEach.runs 2 4 7 (by decide) (by decide) inner s N
    (innerBound M N) _ hN h4 h7
  intro i hi out
  obtain ⟨t,ht,hb⟩ := inner_runs (atIndex s 4 7 N i out) M N
    (atIndex_clean hs _ _ _ _ _ (by decide) (by decide))
    (atIndex_bounded hM _ _ _ _ _ (by simpa [hN] using hM 2) (by omega))
    (by simpa [atIndex,State.set] using hN)
    (by simpa [atIndex,State.set] using h5)
    (by simpa [atIndex,State.set] using h8)
  simp only [atIndex_output,withOutput_atIndex] at ht
  have h0 : (atIndex s 4 7 N i out).regs 0 = s.regs 0 := by simp [atIndex,State.set]
  have h1 : (atIndex s 4 7 N i out).regs 1 = s.regs 1 := by simp [atIndex,State.set]
  have h3 : (atIndex s 4 7 N i out).regs 3 = s.regs 3 := by simp [atIndex,State.set]
  rw [h0,h1,h3,atIndex_counter _ _ _ _ _ _ (by decide)] at ht
  exact ⟨t,ht,hb⟩

theorem outer_runs (s : State) (M N : ℕ) (hs : TailClean 9 s) (hM : Bounded s M)
    (hN : s.regs 2 = N) (h3 : s.regs 3 = 0) (h4 : s.regs 4 = 0) (h5 : s.regs 5 = 0)
    (h6 : s.regs 6 = 0) (h7 : s.regs 7 = 0) (h8 : s.regs 8 = 0) :
    ∃ t,Runs outer s
      (withOutput s (((List.range N).flatMap fun a => (List.range N).flatMap fun b =>
        (List.range N).flatMap fun c =>
        GridNatEntry.entry (s.regs 0) (s.regs 1) a b c).reverse ++ s.output)) t ∧
      t ≤ outerBound M N := by
  apply GridForEach.runs 2 3 6 (by decide) (by decide) middle s N
    (middleBound M N) _ hN h3 h6
  intro i hi out
  obtain ⟨t,ht,hb⟩ := middle_runs (atIndex s 3 6 N i out) M N
    (atIndex_clean hs _ _ _ _ _ (by decide) (by decide))
    (atIndex_bounded hM _ _ _ _ _ (by simpa [hN] using hM 2) (by omega))
    (by simpa [atIndex,State.set] using hN)
    (by simpa [atIndex,State.set] using h4)
    (by simpa [atIndex,State.set] using h5)
    (by simpa [atIndex,State.set] using h7)
    (by simpa [atIndex,State.set] using h8)
  simp only [atIndex_output,withOutput_atIndex] at ht
  have h0 : (atIndex s 3 6 N i out).regs 0 = s.regs 0 := by simp [atIndex,State.set]
  have h1 : (atIndex s 3 6 N i out).regs 1 = s.regs 1 := by simp [atIndex,State.set]
  rw [h0,h1,atIndex_counter _ _ _ _ _ _ (by decide)] at ht
  exact ⟨t,ht,hb⟩

end GridTableLoops
end

-- Helpers from Solutions.GridNatIO
section
namespace GridNatIO
open GridNatProgram GridProgram GridMachine GridRegisters

def loadInput (r : Reg) : Program := .loop .input
  (.seq (.pop .input (fun old _ => old)) (GridRegisters.push (reg r)))

lemma load_exec (r : Reg) (xs : List Bool) (d : Data) (hin : d.input = xs) :
    Executes (loadInput r) d
      {workSet d (reg r) (List.replicate xs.length true ++ d.work (reg r)) with
        var := (none : Scratch),input := []} (3*xs.length+1) := by
  induction xs generalizing d with
  | nil =>
    have h := Executes.done (body := .seq (.pop .input (fun old _ => old))
      (GridRegisters.push (reg r))) (d := d) (tape := .input) (by simp [Cfg.get,hin])
    simpa [loadInput,loopTest,Cfg.get,hin,workSet] using h
  | cons x xs ih =>
    let e : Data := {workSet d (reg r) (true :: d.work (reg r)) with
      var := some true,input := xs}
    have hbody : Executes (.seq (.pop .input (fun old _ => old)) (GridRegisters.push (reg r)))
        (loopTest d .input) e 2 := by
      have hp := Executes.pop (loopTest d .input) .input (fun old _ => old)
      have hq := Executes.push (dataPop (loopTest d .input) .input (fun old _ => old))
        (.work (reg r)) (fun _ => true)
      convert Executes.seq hp hq using 1 <;>
        simp [e,dataPop,dataPush,loopTest,Cfg.get,Cfg.set,hin,workSet,GridRegisters.push]
    have ht := ih e rfl
    have he :
        {workSet e (reg r) (List.replicate xs.length true ++ e.work (reg r)) with
          var := (none : Scratch),input := []} =
        {workSet d (reg r) (List.replicate (x :: xs).length true ++ d.work (reg r)) with
          var := (none : Scratch),input := []} := by
      simp only [e,workSet,Function.update_self,Function.update_idem,List.length_cons]
      rw [List.replicate_succ',List.append_assoc,List.singleton_append]
    rw [he] at ht
    have hh := Executes.again (tape := .input) (by simp [Cfg.get,hin]) hbody ht
    convert hh using 1 <;> first | rfl | (simp only [List.length_cons]; omega)

def moveOutput : Program := .loop (.work outputReg)
  (.seq (.pop (.work outputReg) (fun _ v => v)) (.push .output (fun v => v.getD false)))

lemma output_exec (xs : List Bool) (d : Data) (hx : d.work outputReg = xs) :
    Executes moveOutput d
      {workSet d outputReg [] with var := (none : Scratch),output := xs.reverse ++ d.output}
      (3*xs.length+1) := by
  induction xs generalizing d with
  | nil =>
    have h := Executes.done (body := .seq (.pop (.work outputReg) (fun _ v => v))
      (.push .output (fun v => v.getD false))) (d := d) (tape := .work outputReg)
      (by simp [Cfg.get,hx])
    have hu : Function.update d.work outputReg [] = d.work := by
      rw [← hx,Function.update_eq_self]
    simpa [moveOutput,loopTest,Cfg.get,hx,workSet,hu] using h
  | cons x xs ih =>
    let e : Data := {workSet d outputReg xs with var := some x,output := x :: d.output}
    have hbody : Executes (.seq (.pop (.work outputReg) (fun _ v => v))
        (.push .output (fun v => v.getD false))) (loopTest d (.work outputReg)) e 2 := by
      have hp := Executes.pop (loopTest d (.work outputReg)) (.work outputReg) (fun _ v => v)
      have hq := Executes.push (dataPop (loopTest d (.work outputReg)) (.work outputReg)
        (fun _ v => v)) .output (fun v => v.getD false)
      convert Executes.seq hp hq using 1 <;>
        simp [e,dataPop,dataPush,loopTest,Cfg.get,Cfg.set,hx,workSet]
    have ht := ih e (by simp [e,workSet])
    have he :
        {workSet e outputReg [] with var := (none : Scratch),output := xs.reverse ++ e.output} =
        {workSet d outputReg [] with var := (none : Scratch),output := (x :: xs).reverse ++ d.output} := by
      simp [e,workSet,Function.update_idem,List.reverse_cons,List.append_assoc]
    rw [he] at ht
    have hh := Executes.again (tape := .work outputReg) (by simp [Cfg.get,hx]) hbody ht
    convert hh using 1 <;> first | rfl | (simp only [List.length_cons]; omega)

def zeroState : State := ⟨fun _ => 0,[]⟩
def inputState (n : ℕ) : State := zeroState.set 0 n
def outputState (bits : List Bool) : State := ⟨fun _ => 0,bits.reverse⟩

@[simp] lemma work_zero (k : Work) : work zeroState k = [] := by
  simp [work,zeroState]

lemma work_zero_function : work zeroState = (fun _ => []) := by
  funext k
  exact work_zero k

lemma initialize_exec (n : ℕ) : Executes (loadInput 0) (initialData (List.replicate n true))
    (GridNatProgram.repr (inputState n) none) (3*n+1) := by
  have h := load_exec 0 (List.replicate n true) (initialData (List.replicate n true)) rfl
  simp only [List.length_replicate,initialData,List.append_nil] at h
  convert h using 1 <;> simp [GridNatProgram.repr,inputState,work_set,initialData,workSet,work_zero_function]

lemma finalize (bits : List Bool) (v : Scratch) :
    Executes moveOutput (GridNatProgram.repr (outputState bits) v) (finalData bits) (3*bits.length+1) := by
  have h := output_exec bits.reverse (GridNatProgram.repr (outputState bits) v) (by
    simp [repr_output,outputState])
  simp only [List.length_reverse,List.reverse_reverse] at h
  convert h using 1
  simp only [GridNatProgram.repr,outputState,finalData,workSet]
  simp only [List.append_nil]
  congr 1
  funext k
  by_cases hk : k = outputReg
  · subst k
    simp
  · by_cases hl : k.val < 62
    · simp [Function.update_of_ne hk,work,hl]
    · simp [Function.update_of_ne hk,work,hl,hk]

def program (p : Code) : Program := .seq (loadInput 0) (.seq (GridNatProgram.compile p) moveOutput)

lemma execution (p : Code) (n t : ℕ) (bits : List Bool)
    (h : Runs p (inputState n) (outputState bits) t) :
    Executes (program p) (initialData (List.replicate n true)) (finalData bits)
      (t+3*n+3*bits.length+2) := by
  obtain ⟨v,hv⟩ := GridNatProgram.compile_correct h none
  have hh := Executes.seq (initialize_exec n) (Executes.seq hv (finalize bits v))
  convert hh using 1 <;> first | rfl | omega

end GridNatIO
end

-- Helpers from Solutions.GridSideProgram
section
namespace GridSideProgram
open GridNatProgram GridNatArithmetic

def grow : Code := .seq (.copy 1 4 (by decide))
  (.seq (.add 4 1 (by decide)) (.seq (.add 4 1 (by decide))
    (.seq (.dec 1) (.seq (.dec 1) (.zero 4)))))

lemma grow_runs (s : State) :
    Runs grow s ((s.set 1 (3*s.regs 1-2)).set 4 0)
      (2*s.regs 4+29*s.regs 1+14) := by
  let a := s.set 4 (s.regs 1)
  let b := a.set 1 (a.regs 4+a.regs 1)
  let c := b.set 1 (b.regs 4+b.regs 1)
  let d := c.set 1 (c.regs 1-1)
  let e := d.set 1 (d.regs 1-1)
  have hh := Runs.seq (Runs.copy s 1 4 (by decide))
    (Runs.seq (Runs.add a 4 1 (by decide)) (Runs.seq (Runs.add b 4 1 (by decide))
      (Runs.seq (Runs.dec c 1) (Runs.seq (Runs.dec d 1) (Runs.zero e 4)))))
  convert hh using 1
  · rfl
  · apply state_ext
    · intro r
      by_cases h₁ : r = 1 <;> by_cases h₄ : r = 4
      all_goals simp_all [a,b,c,d,e,State.set]
      omega
    · rfl
  · simp [a,b,c,d,e,State.set]
    omega

/-- Register 3 receives n-(k-1), which is zero exactly when k>n (for k>0).
    Registers 4 and 5 are cleared; all other registers and the output are preserved. -/
def compare : Code := .seq (.copy 0 3 (by decide))
  (.seq (.copy 1 4 (by decide)) (.seq (.dec 4)
    (.seq (subtract 4 3 5 (by decide)) (.zero 4))))

lemma compare_runs (s : State) :
    Runs compare s
      (((s.set 3 (s.regs 0-(s.regs 1-1))).set 4 0).set 5 0)
      (2*s.regs 3+2*s.regs 4+2*s.regs 5+9*s.regs 0+
        9*s.regs 1+14*(s.regs 1-1)+18) := by
  let a := s.set 3 (s.regs 0)
  let b := a.set 4 (a.regs 1)
  let c := b.set 4 (b.regs 4-1)
  let d := (c.set 3 (c.regs 3-c.regs 4)).set 5 0
  have hh := Runs.seq (Runs.copy s 0 3 (by decide))
    (Runs.seq (Runs.copy a 1 4 (by decide)) (Runs.seq (Runs.dec b 4)
      (Runs.seq (subtract_runs c 4 3 5 (by decide) (by decide)) (Runs.zero d 4))))
  convert hh using 1
  · rfl
  · apply state_ext
    · intro r
      by_cases h₃ : r = 3 <;> by_cases h₄ : r = 4 <;> by_cases h₅ : r = 5
      all_goals simp_all [a,b,c,d,State.set]
    · rfl
  · simp [a,b,c,d,State.set]
    omega

lemma compare_clean (s : State) (n k : ℕ)
    (h₀ : s.regs 0 = n) (h₁ : s.regs 1 = k)
    (h₃ : s.regs 3 = 0) (h₄ : s.regs 4 = 0) (h₅ : s.regs 5 = 0) :
    Runs compare s (s.set 3 (n-(k-1))) (9*n+9*k+14*(k-1)+18) := by
  have h := compare_runs s
  rw [h₀,h₁,h₃,h₄,h₅] at h
  have he : (((s.set 3 (n-(k-1))).set 4 0).set 5 0) = s.set 3 (n-(k-1)) := by
    apply state_ext
    · intro r
      by_cases h₃' : r = 3 <;> by_cases h₄' : r = 4 <;> by_cases h₅' : r = 5
      all_goals simp_all [State.set]
    · rfl
  simpa only [he,Nat.mul_zero,Nat.zero_add] using h

lemma grow_clean (s : State) (k : ℕ) (h₁ : s.regs 1 = k) (h₄ : s.regs 4 = 0) :
    Runs grow s (s.set 1 (3*k-2)) (29*k+14) := by
  have h := grow_runs s
  rw [h₁,h₄] at h
  have he : ((s.set 1 (3*k-2)).set 4 0) = s.set 1 (3*k-2) := by
    apply state_ext
    · intro r
      by_cases h₁' : r = 1 <;> by_cases h₄' : r = 4
      all_goals simp_all [State.set]
    · rfl
  simpa only [he,Nat.mul_zero,Nat.zero_add] using h

def body : Code := .seq compare
  (.seq (.ifZero 3 (.zero 2) (.seq grow (.dec 2))) (.zero 3))
def loop : Code := .loop 2 body

theorem loop_runs (fuel : ℕ) (n k : ℕ) (s : State)
    (h₀ : s.regs 0 = n) (h₁ : s.regs 1 = k) (h₂ : s.regs 2 = fuel)
    (h₃ : s.regs 3 = 0) (h₄ : s.regs 4 = 0) (h₅ : s.regs 5 = 0)
    (hk : 1 ≤ k) (hkb : k ≤ 4*(n+1)) (hfb : fuel ≤ n) :
    ∃ t, Runs loop s ((s.set 1 (GridSideAlgorithm.run n fuel k)).set 2 0) t ∧
      t ≤ 300*(n+1)*(fuel+1) := by
  induction fuel generalizing k s with
  | zero =>
    have he : ((s.set 1 (GridSideAlgorithm.run n 0 k)).set 2 0) = s := by
      simp only [GridSideAlgorithm.run,← h₁,set_self,← h₂]
    rw [he]
    exact ⟨1,Runs.done h₂,by omega⟩
  | succ fuel ih =>
    have hc := compare_clean s n k h₀ h₁ h₃ h₄ h₅
    by_cases hstop : n < k
    · have hd : n-(k-1) = 0 := by omega
      rw [hd,← h₃,set_self] at hc
      have hz := Runs.zero s 2
      rw [h₂] at hz
      have hb : Runs (.ifZero 3 (.zero 2) (.seq grow (.dec 2))) s (s.set 2 0)
          (2+(2*(fuel+1)+1)) := Runs.yes h₃ hz
      have hclear : Runs (.zero 3) (s.set 2 0) (s.set 2 0) 1 := by
        have hh := Runs.zero (s.set 2 0) 3
        have hzero : (s.set 2 0).regs 3 = 0 := by simp [h₃]
        have heq := set_self (s.set 2 0) 3
        rw [hzero] at heq
        simpa only [hzero,heq,Nat.mul_zero,Nat.zero_add] using hh
      have hbdy := Runs.seq hc (Runs.seq hb hclear)
      have hend : Runs loop (s.set 2 0) (s.set 2 0) 1 := Runs.done (by simp)
      have hh := Runs.again (by omega : s.regs 2 ≠ 0) hbdy hend
      have he : ((s.set 1 (GridSideAlgorithm.run n (fuel+1) k)).set 2 0) = s.set 2 0 := by
        rw [GridSideAlgorithm.run,if_pos hstop,← h₁,set_self]
      rw [he]
      refine ⟨_,hh,?_⟩
      have : k-1 ≤ k := Nat.sub_le _ _
      nlinarith only [hkb,hfb,this,Nat.zero_le (n*fuel)]
    · let d := n-(k-1)
      let a := s.set 3 d
      let b := a.set 1 (3*k-2)
      let c := b.set 2 fuel
      let e := (s.set 1 (3*k-2)).set 2 fuel
      have ha₁ : a.regs 1 = k := by simp [a,h₁]
      have ha₄ : a.regs 4 = 0 := by simp [a,h₄]
      have hg := grow_clean a k ha₁ ha₄
      have hdec : Runs (.dec 2) b c 1 := by
        convert Runs.dec b 2 using 1
        simp [c,b,a,h₂]
      have hnz : a.regs 3 ≠ 0 := by simp [a,d]; omega
      have hb : Runs (.ifZero 3 (.zero 2) (.seq grow (.dec 2))) a c (2+(29*k+14+1)) :=
        Runs.no hnz (Runs.seq hg hdec)
      have hc₃ : c.regs 3 = d := by simp [c,b,a]
      have he : c.set 3 0 = e := by
        apply state_ext
        · intro r
          by_cases h₁' : r = 1 <;> by_cases h₂' : r = 2 <;> by_cases h₃' : r = 3
          all_goals simp [e,c,b,a,State.set,h₁',h₂',h₃',h₃]
        · rfl
      have hclear : Runs (.zero 3) c e (2*d+1) := by
        simpa only [hc₃,he] using Runs.zero c 3
      have hbdy : Runs body s e ((9*n+9*k+14*(k-1)+18)+(2+(29*k+14+1))+(2*d+1)) := by
        convert Runs.seq hc (Runs.seq hb hclear) using 1 <;> first | rfl | omega
      have he₀ : e.regs 0 = n := by simp [e,h₀]
      have he₁ : e.regs 1 = 3*k-2 := by simp [e]
      have he₂ : e.regs 2 = fuel := by simp [e]
      have he₃ : e.regs 3 = 0 := by simp [e,h₃]
      have he₄ : e.regs 4 = 0 := by simp [e,h₄]
      have he₅ : e.regs 5 = 0 := by simp [e,h₅]
      obtain ⟨t,ht,htb⟩ := ih (3*k-2) e he₀ he₁ he₂ he₃ he₄ he₅
        (by omega) (by omega) (by omega)
      have hend : ((e.set 1 (GridSideAlgorithm.run n fuel (3*k-2))).set 2 0) =
          ((s.set 1 (GridSideAlgorithm.run n (fuel+1) k)).set 2 0) := by
        simp only [GridSideAlgorithm.run,if_neg hstop]
        apply state_ext
        · intro r
          by_cases h₁' : r = 1 <;> by_cases h₂' : r = 2
          all_goals simp [e,State.set,h₁',h₂']
        · rfl
      rw [hend] at ht
      have hh := Runs.again (by omega : s.regs 2 ≠ 0) hbdy ht
      refine ⟨_,hh,?_⟩
      have hd : d ≤ n := Nat.sub_le _ _
      have hk' : k-1 ≤ k := Nat.sub_le _ _
      nlinarith only [htb,hd,hk',hkb]

def initializeCode : Code := .seq (.inc 1) (.seq (.inc 1) (.seq (.inc 1)
  (.seq (.inc 1) (.copy 0 2 (by decide)))))

lemma initialize_runs (n : ℕ) :
    Runs initializeCode (GridNatIO.inputState n)
      (((GridNatIO.inputState n).set 1 4).set 2 n) (9*n+9) := by
  let s := GridNatIO.inputState n
  let a := s.set 1 (s.regs 1+1)
  let b := a.set 1 (a.regs 1+1)
  let c := b.set 1 (b.regs 1+1)
  let d := c.set 1 (c.regs 1+1)
  have hh := Runs.seq (Runs.inc s 1) (Runs.seq (Runs.inc a 1) (Runs.seq (Runs.inc b 1)
    (Runs.seq (Runs.inc c 1) (Runs.copy d 0 2 (by decide)))))
  convert hh using 1
  · rfl
  · simp [d,c,b,a,s,GridNatIO.inputState,GridNatIO.zeroState,State.set,Function.update_idem]
  · simp [d,c,b,a,s,GridNatIO.inputState,GridNatIO.zeroState,State.set]
    omega

def compute : Code := .seq initializeCode loop

theorem compute_runs (n : ℕ) : ∃ t,
    Runs compute (GridNatIO.inputState n)
      ((GridNatIO.inputState n).set 1 (ResultantVNP.gridSide n)) t ∧
      t ≤ 400*(n+1)^2 := by
  let s := ((GridNatIO.inputState n).set 1 4).set 2 n
  have h₀ : s.regs 0 = n := by simp [s,GridNatIO.inputState,State.set]
  have h₁ : s.regs 1 = 4 := by simp [s]
  have h₂ : s.regs 2 = n := by simp [s]
  have h₃ : s.regs 3 = 0 := by simp [s,GridNatIO.inputState,GridNatIO.zeroState,State.set]
  have h₄ : s.regs 4 = 0 := by simp [s,GridNatIO.inputState,GridNatIO.zeroState,State.set]
  have h₅ : s.regs 5 = 0 := by simp [s,GridNatIO.inputState,GridNatIO.zeroState,State.set]
  obtain ⟨t,ht,hbound⟩ := loop_runs n n 4 s h₀ h₁ h₂ h₃ h₄ h₅
    (by decide) (by omega) (by omega)
  have he : ((s.set 1 (GridSideAlgorithm.run n n 4)).set 2 0) =
      (GridNatIO.inputState n).set 1 (ResultantVNP.gridSide n) := by
    change ((s.set 1 (GridSideAlgorithm.compute n)).set 2 0) = _
    rw [GridSideAlgorithm.compute_eq]
    apply state_ext
    · intro r
      by_cases h₁' : r = 1 <;> by_cases h₂' : r = 2
      all_goals simp [s,State.set,h₁',h₂',GridNatIO.inputState,GridNatIO.zeroState]
    · rfl
  rw [he] at ht
  refine ⟨9*n+9+t,Runs.seq (initialize_runs n) ht,?_⟩
  nlinarith only [hbound,Nat.zero_le (n*n)]

end GridSideProgram
end

-- Helpers from Solutions.GridTableBounds
section
open ResultantVNP MvPolynomial
open scoped Classical

namespace GridTableBounds

lemma entry_length {n : ℕ} (e : MvPolynomial (Fin n × Fin n) ℤ) :
    (entryCode e).length ≤ 2*n+3 := by
  unfold entryCode
  split_ifs with hzero hone hvar
  · simp
  · simp
  · simp only [List.length_cons,List.length_append,List.length_replicate,List.length_nil]
    have h₁ := hvar.choose.1.isLt
    have h₂ := hvar.choose.2.isLt
    omega
  · simp

lemma flatMap_length {α β : Type} (xs : List α) (f : α → List β) (b : ℕ)
    (h : ∀ x ∈ xs,(f x).length ≤ b) : (xs.flatMap f).length ≤ xs.length*b := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
    simp only [List.flatMap_cons,List.length_append,List.length_cons]
    have hh := h x (by simp)
    have ht := ih (fun y hy => h y (by simp [hy]))
    rw [Nat.add_mul,Nat.one_mul]
    omega

lemma table_length (n : ℕ) :
    (gridTableCode n).length ≤ (5*gridSide n^2)^3*(2*n+3) := by
  unfold gridTableCode
  let N := 5*gridSide n^2
  have hbound := flatMap_length (List.range N)
    (fun a => (List.range N).flatMap fun b => (List.range N).flatMap fun c =>
      entryCode (gridTensor n (gridIdxOfNat (gridSide n) a ::ₛ gridIdxOfNat (gridSide n) b ::ₛ
        gridIdxOfNat (gridSide n) c ::ₛ Sym.nil))) (N*(N*(2*n+3))) (by
      intro a _
      simpa only [List.length_range] using flatMap_length (List.range N) _ (N*(2*n+3)) (by
        intro b _
        simpa only [List.length_range] using flatMap_length (List.range N) _ (2*n+3)
          (fun c _ => entry_length _)))
  simpa only [List.length_range,show N*(N*(N*(2*n+3))) = N^3*(2*n+3) by ring] using hbound

lemma polynomial_length (n : ℕ) : (gridTableCode n).length ≤ 1536000*(n+1)^7 := by
  have hm : gridSide n ≤ 4*(n+1) := by
    rw [← GridSideAlgorithm.compute_eq]
    exact GridSideAlgorithm.compute_linear n
  calc
    (gridTableCode n).length ≤ (5*gridSide n^2)^3*(2*n+3) := table_length n
    _ ≤ (5*(4*(n+1))^2)^3*(3*(n+1)) := by gcongr <;> omega
    _ = 1536000*(n+1)^7 := by ring

end GridTableBounds
end

-- Helpers from Solutions.GridRuntimeBridge
section
/-!
The remaining runtime obligation is an actual register-program witness.
This module proves that such a witness suffices for the precise platform
Turing-machine statement. It does not assume or assert that the witness exists.
-/
namespace GridRuntimeBridge
open GridNatProgram GridNatIO ResultantVNP

lemma unary_eq_replicate (n : ℕ) :
    Computability.unaryEncodeNat n = List.replicate n true := by
  induction n with
  | zero => rfl
  | succ n ih => simp [Computability.unaryEncodeNat,List.replicate_succ,ih]

noncomputable def runtimeBound (p : Polynomial ℕ) : Polynomial ℕ :=
  p + 3*Polynomial.X + 4608000*(Polynomial.X+1)^7 + 3

theorem certifies (p : Code) (bound : Polynomial ℕ)
    (h : ∀ n, ∃ t,
      Runs p (inputState n) (outputState (GridTableAlgorithm.compute n)) t ∧
        t ≤ bound.eval n) :
    Nonempty (Turing.TM2ComputableInPolyTime
      Computability.unaryEncodeNat id gridTableCode) := by
  apply GridProgram.certifies (GridNatIO.program p) Computability.unaryEncodeNat id
    gridTableCode (runtimeBound bound)
  intro n
  obtain ⟨t,ht,hbound⟩ := h n
  rw [GridTableAlgorithm.compute_eq] at ht
  refine ⟨t+3*n+3*(gridTableCode n).length+2,?_,?_⟩
  · simpa only [unary_eq_replicate,id_eq] using execution p n t (gridTableCode n) ht
  · have hl := GridTableBounds.polynomial_length n
    simp only [runtimeBound,unary_eq_replicate,List.length_replicate,
      Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_pow,
      Polynomial.eval_natCast,Polynomial.eval_X,Polynomial.eval_one]
    norm_num only [Polynomial.eval_ofNat]
    omega

end GridRuntimeBridge
end

-- Helpers from Solutions.GridTableProgram
section
namespace GridTableProgram
open GridNatProgram GridNatArithmetic GridNatControl GridNatOutput GridConditions GridStraightLine
open Polynomial ResultantVNP

def sizeScript : Script := .seq (.literal 3 5) (.seq (.binary .mul 2 1 1)
  (.seq (.binary .mul 2 2 3) (.clear 3)))

lemma size_eval (s : State) (hs : TailClean 3 s) :
    sizeScript.eval s = s.set 2 (5*(s.regs 1)^2) := by
  apply state_ext
  · intro r
    by_cases h2 : r = 2
    · subst r
      simp [sizeScript,Script.eval,GridScratch.BinOp.eval,GridStraightLine.reg,State.set]
      ring
    · by_cases hr : 3 ≤ r.val
      · simp [sizeScript,Script.eval,GridScratch.BinOp.eval,GridStraightLine.reg,State.set,
          h2,hr,hs r hr]
      · have h3 : r ≠ 3 := by intro h; subst r; omega
        simp [sizeScript,Script.eval,GridScratch.BinOp.eval,GridStraightLine.reg,State.set,h2,h3,hr]
  · rfl

def sideState (n : ℕ) : State := (GridNatIO.inputState n).set 1 (gridSide n)
def dimension (n : ℕ) : ℕ := 5*(gridSide n)^2
def initial (n : ℕ) : State := (sideState n).set 2 (dimension n)
def maxValue (n : ℕ) : ℕ := 80*(n+1)^2

lemma side_bound (n : ℕ) : gridSide n ≤ 4*(n+1) := by
  rw [← GridSideAlgorithm.compute_eq]
  exact GridSideAlgorithm.compute_linear n

lemma dimension_bound (n : ℕ) : dimension n ≤ maxValue n := by
  have hm := side_bound n
  calc
    dimension n ≤ 5*(4*(n+1))^2 := by dsimp [dimension]; gcongr
    _ = maxValue n := by simp only [maxValue]; ring

lemma side_clean (n : ℕ) : TailClean 3 (sideState n) := by
  intro r hr
  have h0 : r ≠ 0 := by intro h; subst r; omega
  have h1 : r ≠ 1 := by intro h; subst r; omega
  simp [sideState,GridNatIO.inputState,GridNatIO.zeroState,State.set,h0,h1]

lemma side_bounded (n : ℕ) : Bounded (sideState n) (4*(n+1)) := by
  intro r
  by_cases h1 : r = 1
  · subst r
    simpa [sideState] using side_bound n
  · by_cases h0 : r = 0
    · subst r
      simp [sideState,GridNatIO.inputState,GridNatIO.zeroState,State.set]
      omega
    · simp [sideState,GridNatIO.inputState,GridNatIO.zeroState,State.set,h0,h1]

lemma initial_clean (n : ℕ) : TailClean 3 (initial n) := by
  intro r hr
  have h2 : r ≠ 2 := by intro h; subst r; omega
  simpa only [initial,set_other _ _ h2] using side_clean n r hr

lemma initial_bounded (n : ℕ) : Bounded (initial n) (maxValue n) := by
  apply bounded_set (GridScratch.bounded_mono (side_bounded n) ?_) 2 _ (dimension_bound n)
  dsimp [maxValue]
  nlinarith only [Nat.zero_le (n*n)]

@[simp] lemma initial_zero (n : ℕ) : (initial n).regs 0 = n := by
  simp [initial,sideState,GridNatIO.inputState,GridNatIO.zeroState,State.set]
@[simp] lemma initial_one (n : ℕ) : (initial n).regs 1 = gridSide n := by
  simp [initial,sideState,GridNatIO.inputState,GridNatIO.zeroState,State.set]
@[simp] lemma initial_two (n : ℕ) : (initial n).regs 2 = dimension n := by simp [initial]
@[simp] lemma initial_output (n : ℕ) : (initial n).output = [] := rfl

theorem size_runs (n : ℕ) : ∃ t,Runs sizeScript.compile (sideState n) (initial n) t ∧
    t ≤ sizeScript.timeBound.eval (4*(n+1)) := by
  obtain ⟨t,ht,hb,_,_⟩ := Script.correct sizeScript (sideState n) (4*(n+1))
    (fun r hr => side_clean n r (by omega)) (side_bounded n)
  rw [size_eval _ (side_clean n)] at ht
  have h1 : (sideState n).regs 1 = gridSide n := by simp [sideState]
  rw [h1] at ht
  exact ⟨t,ht,hb⟩

theorem table_runs (n : ℕ) : ∃ t,Runs GridTableLoops.outer (initial n)
    (withOutput (initial n) (GridNatEntry.table n (gridSide n)).reverse) t ∧
      t ≤ GridTableLoops.outerBound (maxValue n) (dimension n) := by
  obtain ⟨t,ht,hb⟩ := GridTableLoops.outer_runs (initial n) (maxValue n) (dimension n)
    (fun r hr => initial_clean n r (by omega)) (initial_bounded n) (initial_two n)
    (initial_clean n 3 (by decide)) (initial_clean n 4 (by decide))
    (initial_clean n 5 (by decide)) (initial_clean n 6 (by decide))
    (initial_clean n 7 (by decide)) (initial_clean n 8 (by decide))
  simpa only [initial_zero,initial_one,initial_output,List.append_nil,dimension,GridNatEntry.table] using
    (show ∃ t, Runs GridTableLoops.outer (initial n) _ t ∧
      t ≤ GridTableLoops.outerBound (maxValue n) (dimension n) from ⟨t,ht,hb⟩)

lemma outer_bound_mono (M N : ℕ) (h : N ≤ M) :
    GridTableLoops.outerBound M N ≤ GridTableLoops.outerBound M M := by
  unfold GridTableLoops.outerBound GridTableLoops.middleBound GridTableLoops.innerBound
  gcongr

noncomputable def loopBound : Polynomial ℕ :=
  (((GridEntryProgram.timeBound+14)*X+21)*X+21)*X+7

lemma loopBound_eval (M : ℕ) : loopBound.eval M = GridTableLoops.outerBound M M := by
  simp only [loopBound,GridTableLoops.outerBound,GridTableLoops.middleBound,GridTableLoops.innerBound,
    eval_add,eval_mul,eval_X,eval_ofNat]
  ring

noncomputable def timeBound : Polynomial ℕ :=
  400*(X+1)^2 + sizeScript.timeBound.comp (4*(X+1)) +
    loopBound.comp (80*(X+1)^2) + 124*(80*(X+1)^2)+63

def code : Code := .seq GridSideProgram.compute
  (.seq sizeScript.compile (.seq GridTableLoops.outer (clearAbove 0)))

theorem runs (n : ℕ) : ∃ t,Runs code (GridNatIO.inputState n)
    (GridNatIO.outputState (GridTableAlgorithm.compute n)) t ∧ t ≤ timeBound.eval n := by
  obtain ⟨ts,hs,hsb⟩ := GridSideProgram.compute_runs n
  obtain ⟨ti,hi,hib⟩ := size_runs n
  obtain ⟨tt,ht,htb⟩ := table_runs n
  let u := withOutput (initial n) (GridNatEntry.table n (gridSide n)).reverse
  obtain ⟨tc,hc,hcb⟩ := clearAbove_runs 0 u (maxValue n) (initial_bounded n)
  have hend : (⟨fun r : Reg => if 0 ≤ r.val then 0 else u.regs r,u.output⟩ : State) =
      GridNatIO.outputState (GridTableAlgorithm.compute n) := by
    apply state_ext
    · intro r
      simp [GridNatIO.outputState]
    · simp only [u,withOutput_output,GridNatEntry.table_eq,GridNatIO.outputState,
        GridTableAlgorithm.compute_eq]
  rw [hend] at hc
  refine ⟨_,Runs.seq hs (Runs.seq hi (Runs.seq ht hc)),?_⟩
  have hl := htb.trans (outer_bound_mono _ _ (dimension_bound n))
  rw [← loopBound_eval] at hl
  simp only [timeBound,eval_add,eval_mul,eval_pow,eval_comp,eval_X,eval_one,eval_ofNat]
  change ts+(ti+(tt+tc)) ≤
    400*(n+1)^2 + sizeScript.timeBound.eval (4*(n+1)) + loopBound.eval (maxValue n) +
      124*maxValue n+63
  omega

theorem polytime : Nonempty (Turing.TM2ComputableInPolyTime
    Computability.unaryEncodeNat id gridTableCode) := GridRuntimeBridge.certifies code timeBound runs

end GridTableProgram
end

theorem solution :
    Nonempty (Turing.TM2ComputableInPolyTime Computability.unaryEncodeNat id
      ResultantVNP.gridTableCode) := GridTableProgram.polytime

