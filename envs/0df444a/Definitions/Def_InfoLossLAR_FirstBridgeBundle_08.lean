  let response := (sample.2[input.2.1]?).getD 0
  let shifted := response+_root_.Integration9_9.LARRankOneMachine.directionNumber q sample.1.length mark input.2.1
  ((q-original%q)+shifted*((auxiliary[input.2.2]?).getD 0))%q

