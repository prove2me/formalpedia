namespace NormPowCharLegs
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField NumberField.TateGlobal NumberField.AdelicLevel NumberField.AdeleRing

variable (F : Type) [Field F] [NumberField F]

private theorem isUnitaryChar_normPowChar (t : ℝ) : AutomorphicForm.IsUnitaryChar (𝓞 F) F (normPowChar F t) := by
  intro x
  exact norm_coe_normPowChar_apply t x

private theorem continuous_normPowChar (t : ℝ) : Continuous (normPowChar F t) := by
  have hpow : Continuous fun x : (AdeleRing (𝓞 F) F)ˣ => ((ideleNorm F x : ℝ) : ℂ) ^ (Complex.I * t) :=
    (Complex.continuous_ofReal.comp (continuous_ideleNorm F)).cpow continuous_const fun x =>
      Complex.ofReal_mem_slitPlane.mpr (ideleNorm_pos x)
  refine Units.continuous_iff.mpr ⟨hpow, ?_⟩
  simp only [Units.val_inv_eq_inv_val, coe_normPowChar_apply]
  exact hpow.inv₀ fun x => ofReal_ideleNorm_cpow_ne_zero F x _

variable {F}

private theorem finitePartUnits_localUnit_apply_mem (v : HeightOneSpectrum (𝓞 F)) {u : (v.adicCompletion F)ˣ}
    (hu : (u : v.adicCompletion F) ∈ v.adicCompletionIntegers F) (w : HeightOneSpectrum (𝓞 F)) :
    ((finitePartUnits (𝓞 F) F (Units.map (finIncl (𝓞 F) F) (localUnit (𝓞 F) F v u)) :
        (FiniteAdeleRing (𝓞 F) F)ˣ) : FiniteAdeleRing (𝓞 F) F) w ∈ w.adicCompletionIntegers F := by
  rw [val_finitePartUnits]
  change ((localUnit (𝓞 F) F v u : (FiniteAdeleRing (𝓞 F) F)ˣ) : FiniteAdeleRing (𝓞 F) F) w ∈
    w.adicCompletionIntegers F
  by_cases hw : w = v
  · rw [hw, localUnit_apply_self]
    exact hu
  · rw [localUnit_apply_of_ne (𝓞 F) F v _ hw]
    exact one_mem _

private theorem isUnramifiedCharAt_normPowChar (t : ℝ) (v : HeightOneSpectrum (𝓞 F)) :
    IsUnramifiedCharAt (normPowChar F t) v := by
  intro u hu hu'
  show normPowChar F t (Units.map (finIncl (𝓞 F) F) (localUnit (𝓞 F) F v u)) = 1
  refine normPowChar_eq_one_of_ideleNorm_eq_one t
    (ideleNorm_eq_one_of_fst_eq_one_of_finitePartUnits_mem_unitIdeles F _ rfl ?_)
  rw [FiniteAdeleRing.mem_unitIdeles_iff]
  refine ⟨fun w => finitePartUnits_localUnit_apply_mem v hu w, fun w => ?_⟩
  rw [← map_inv, ← map_inv, ← map_inv]
  exact finitePartUnits_localUnit_apply_mem v hu' w

end LanglandsTunnell.CubicInduction.NormPowCharLegs
