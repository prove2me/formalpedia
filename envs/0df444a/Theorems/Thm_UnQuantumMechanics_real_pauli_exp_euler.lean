-- title:
--   Matrix Euler formulas $e^{\eta\varphi}$ for $\eta^2 = \mp 1$
-- statement:
--   Let $\eta$ be a real $2\times 2$ matrix and $\varphi\in\mathbb R$.
--
--   1. If $\eta^2 = -\mathbf 1$, then $\exp(\varphi\eta) = \cos\varphi\,\mathbf 1 + \sin\varphi\,\eta$.
--   2. If $\eta^2 = \mathbf 1$, then $\exp(\varphi\eta) = \cosh\varphi\,\mathbf 1 + \sinh\varphi\,\eta$.
--
--   In the paper the first case yields rotations and the second boosts, generated by the real Pauli matrices $\eta_0,\dots,\eta_3$ of Eq. (61).
--
--   **Formalization Note** The statement is made for every real $2\times 2$ matrix with the given square, which covers each real Pauli matrix of Eq. (61); $\exp$ is the matrix exponential.
-- source:
--   C. Baumgarten, How to (Un-) Quantum Mechanics, arXiv:1810.06981v2 [physics.gen-ph] (v2 dated June 10, 2025), https://arxiv.org/abs/1810.06981, Sec. VI.D, p. 20, Eq. (66)

import Mathlib
import Definitions.Def_UnQM_phase_space

open Matrix

namespace UnQuantumMechanics

theorem real_pauli_exp_euler (η : Matrix (Fin 2) (Fin 2) ℝ) (φ : ℝ) :
    (η * η = -1 → NormedSpace.exp (φ • η) = Real.cos φ • (1 : Matrix (Fin 2) (Fin 2) ℝ) + Real.sin φ • η) ∧
    (η * η = 1 → NormedSpace.exp (φ • η) = Real.cosh φ • (1 : Matrix (Fin 2) (Fin 2) ℝ) + Real.sinh φ • η) := by sorry

end UnQuantumMechanics
