-- title:
--   Worst-case neighborhood-query cap
-- statement:
--   A deterministic policy has query cap $q$ at degree bound $d$ if its actual execution makes at most $q$ queries on every simple graph of maximum degree at most $d$ and every arrival order. A randomized policy has this cap if every deterministic table of positive probability has it.
--
--   This is a worst-case resource bound, not an expected query count. Since the policy space is finite, this permits every algorithm whose worst-case number of queries is $q$, including algorithms generated by arbitrary random tapes.
-- source:
--   Omri Ben-Eliezer, Krzysztof Onak, Sandeep Silwal, Yinzhan Xu, Sublinear-Time Algorithms on Massive Data Streams, STOC 2027 submission #1068 (October 2026); https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/1068.pdf; SHA256 ca9e204557da80369cd1ee2d960723e20f3d84c40adff5e96b84d7163e827e00; Definition 1 and Theorem 14, printed p.3 / PDF p.3.

import Definitions.Def_StreamTesting_Bipartiteness_Execution

noncomputable section

namespace StreamTesting.Bipartiteness

/-- Worst-case cap for a deterministic policy, over all degree-bounded inputs and orders. -/
def DetQueryCap {n : ℕ} (d : ℕ) (A : Policy n) (q : ℕ) : Prop :=
  ∀ G : SimpleGraph (Fin n), GreedyColoringLCA969.LowerBound.MaxDegreeAtMost G d →
    ∀ σ : Order n, queryCount (execute G A σ) ≤ q

/-- The cap holds for every internal choice with positive probability. The finite
policy space makes this equivalent to an almost-sure worst-case query bound. -/
def QueryCap {n : ℕ} (d : ℕ) (μ : RandomPolicy n) (q : ℕ) : Prop :=
  ∀ A : Policy n, μ A ≠ 0 → DetQueryCap d A q


end StreamTesting.Bipartiteness


