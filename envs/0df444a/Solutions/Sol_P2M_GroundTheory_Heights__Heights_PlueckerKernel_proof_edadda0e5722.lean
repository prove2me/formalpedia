  intro j m Z hZ
  set S : ℝ := ∑ I : {I : Finset (Fin (j + m)) // I.card = j}, ‖(colsOf (onePipe Z) I).det‖ ^ 2 with hS
  have hS0 : 0 ≤ S := Finset.sum_nonneg fun I _ => by positivity
  have hnorm : ‖((S : ℝ) : ℂ)‖ = S := Complex.norm_of_nonneg hS0
