theorem dn0_sp (s0 : IState HS) (F : Fin HS → List ℤ) {Cm : Fin HS} (hC5 : Cm.val < 56)
    (hCm : Cm ≠ 37 ∧ Cm ≠ 38 ∧ Cm ≠ 39 ∧ Cm ≠ 40 ∧ Cm ≠ 41 ∧ Cm ≠ 42 ∧ Cm ≠ 45) (hFC : F Cm = [])
    (h37 : F 37 = []) (h38 : F 38 = []) (h39 : F 39 = []) (h40 : F 40 = []) (h45 : F 45 = [])
    (cs : List (ℤ × ℤ)) (pre post n' : ℕ) {A : ℕ}
    (hcs : ∀ y ∈ flatC cs, |y| ≤ 2 ^ A) (hm : cs.length ≤ 2 ^ A) (hpre : pre ≤ 2 ^ A)
    (hpost : 2 * post ≤ 2 ^ A) (htot : pre * (n' * (2 * post)) ≤ 2 ^ A) :
    Sp (dn0 Cm) (encK s0 (regOut F cs pre post n' [] [])) (encK s0 F) (dnC A cs.length) := by
  have h := dnCore_sp s0 F hC5 hCm hFC h37 h38 h39 h40 h45 cs pre post n' [] [] hcs hm hpre hpost htot
  simp only [List.nil_append, update_eq_self] at h
