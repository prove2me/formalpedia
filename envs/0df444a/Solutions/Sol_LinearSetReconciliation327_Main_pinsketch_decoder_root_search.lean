  obtain ⟨hFuelAt, hDivAt⟩ := At.seqStmt hRestAt
  have hCache : Sem P E pc (pc + 39) (boundaryState pc m)
      (fun k z => k ≤ 39 ∧ z = boundaryState (pc + 39) m1) := by
    exact Sem.boundary_block P E _ cacheDivisorCode m m1 hCacheAt
      (by simp [cacheDivisorCode, cacheDivisorReadCode, metaReadCode, metaStoreCode, fieldInvCode, zeroRegsCode])
      (cacheDivisor_spec b ι t N E _ s.rem DB cap hrows.layout.Dlow hw hW hdet
        (by have h := hrows.Dword; omega) (by omega) (by omega) hrows.rem hscan hrows.ptr74 hrows.dimension)
  have hFuel : Sem P E (pc + 39) (pc + 61) (boundaryState (pc + 39) m1)
      (fun k z => k ≤ 22 ∧ z = boundaryState (pc + 61) m2) := by
    exact Sem.boundary_block P E _ divisionFullFuelCode m1 m2 hFuelAt
      (by simp [divisionFullFuelCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (divisionFullFuel_spec E _ L (by omega) hLWord hr1.length)
  have hc2 : RowCache b s.rem RB UB DB CB L m2 L :=
    ⟨by simp [m2, m1], by simp [m2, m1], by simp [m2],
      hr2.ptr72, hr2.ptr73, hr2.ptr74, hr2.ptr75, hr2.length, hr2.dimension⟩
  have hDiv := longDivProcedure_spec b ι t N P E (pc + 61) RB UB DB CB L cap L
    s.prevR s.prevC s.rem s.curC m2 hDivAt hw hW hdet hrows.layout (by omega)
    hrows.Rword hrows.Uword hrows.Dword hrows.Cword hDpos hD hC
    hr2.prevR hr2.prevC hr2.rem hr2.curC hc2 (by omega)
  have hFull := Sem.seq_bound hCache (fun z _ hz => by
    subst z
    exact Sem.seq_bound hFuel (fun z _ hz => by subst z; exact hDiv))
  refine Sem.mono hFull ?_
  intro k z hQ
  obtain ⟨hk, m3, hz, hc3, hf3, hR3, hU3, hD3, hC3⟩ := hQ
  have hcap3 : m3 81 = cap := by
    rw [hf3 81 (by dsimp [divisionWritable]; have h := hrows.layout.Rlow; have h' := hrows.layout.Ulow; omega)]
    exact hr2.capacity
  refine ⟨by omega, m3, hz, ?_, ?_, ?_⟩
  · exact ⟨hrows.layout, hrows.Rword, hrows.Uword, hrows.Dword, hrows.Cword,
      hR3, hU3, hD3, hC3, hc3.prevR, hc3.prevC, hc3.curR, hc3.curC, hc3.length, hc3.dim, hcap3⟩
  · apply MemoryFrame.trans ((MemoryFrame.trans hf1 hf2).mono ?_)
      (hf3.mono (divisionWritable_le_pade RB UB DB CB cap))
    intro addr ha
    dsimp [padeScratch] at ha
    dsimp [padeWritable]
    omega

  · intro slot hlo hhi
    have hnot : ¬ divisionWritable RB UB cap slot := by
      dsimp [divisionWritable]
      have hRlo := hrows.layout.Rlow
      have hUlo := hrows.layout.Ulow
      omega
    rw [hf3 slot hnot]
    have h69 : slot ≠ 69 := by omega
    have h70 : slot ≠ 70 := by omega
    have h71 : slot ≠ 71 := by omega
    simp [m2, m1, h69, h70, h71]

theorem polynomialModulo_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile polynomialModuloProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s)
    (hR : s.prevR.natDegree < L) (hDpos : 0 < s.rem.natDegree)
    (hD : s.rem.natDegree < L) (hC : s.curC.natDegree < L)
    (hscan : m 95 = s.rem.natDegree + 1) :
    Sem P E pc (pc + 295) (boundaryState pc m)
      (fun k z => k ≤ (48 * L + 187) * L + 65 ∧
        ∃ m', z = boundaryState (pc + 295) m' ∧
          PadeRows b E RB UB DB CB L cap m' (reducedPadeRows s) ∧
          MemoryFrame (padeWritable RB UB DB CB cap) m m') := by
  refine Sem.mono (polynomialModulo_strong_spec b ι t N P E pc RB UB DB CB L cap s m hAt
    hw hW hdet hL hcap hrows hR hDpos hD hC hscan) ?_
  intro k z hQ
  obtain ⟨hk, m', hz, hr, hf, _⟩ := hQ
  exact ⟨hk, m', hz, hr, hf⟩

theorem traceAddX_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (dst : ℕ) (a : F)
    (hmeta : (96 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hdst : dst + 1 < 2 ^ E.W)
    (hm64 : s.mem 64 = dst) (hm96 : s.mem 96 = enc b a) :
    runBlock traceAddXCode E s = boundaryState (s.pc + 25) (Function.update s.mem (dst + 1) (enc b a)) := by
  have hsmall : ∀ i ≤ 96, i % 2 ^ E.W = i := by
    intro i hi
    exact Nat.mod_eq_of_lt (by omega)
  have hdst0 : dst % 2 ^ E.W = dst := Nat.mod_eq_of_lt (by omega)
  have hdst1 : (dst + 1) % 2 ^ E.W = dst + 1 := Nat.mod_eq_of_lt hdst
  have ha : enc b a % 2 ^ E.W = enc b a :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le (enc_lt b a) (Nat.pow_le_pow_right (by norm_num) hwe))
  rw [traceAddXCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc traceAddXCode E s (by
      simp [traceAddXCode, metaReadCode, zeroRegsCode])
    rw [traceAddXCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 25 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm64, hm96, hdst0, hdst1, ha, boundaryState]
  · intro _; rfl

theorem polynomial_square_add_X_stored {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (dst cap : ℕ) (p : F[X]) (a : F) :
    PolynomialStored b (Function.update (writeArray dst m (fun i => enc b ((p ^ 2).coeff i)) cap)
      (dst + 1) (enc b a)) dst cap (p ^ 2 + Polynomial.C a * Polynomial.X) := by
  intro i hi
  by_cases hone : i = 1
  · subst i
    rw [Function.update_self]
    simp [Polynomial.coeff_add, Polynomial.coeff_C_mul, polynomial_square_coeff]
  · rw [Function.update_of_ne (by omega : dst + i ≠ dst + 1), writeArray_get _ _ _ cap i hi]
    congr 1
    simp [Polynomial.coeff_add, Polynomial.coeff_C_mul, Polynomial.coeff_X, hone, Ne.symm hone]

theorem traceSquareProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc dst src L cap : ℕ) (p : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile traceSquareProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L) (hcapWord : cap < 2 ^ E.W)
    (hdstLow : 128 ≤ dst) (hdstWord : dst < 2 ^ E.W) (hsrcWord : src < 2 ^ E.W)
    (hdst : dst + cap ≤ 2 ^ E.W) (hsrc : src + L ≤ 2 ^ E.W)
    (hdisj : src + L ≤ dst ∨ dst + cap ≤ src) (hp : PolynomialStored b m src L p)
    (hm64 : m 64 = dst) (hm65 : m 65 = src) (hm66 : m 66 = cap) (hm96 : m 96 = enc b a) :
    Sem P E pc (pc + 70) (boundaryState pc m)
      (fun k z => k ≤ 18 * cap + 54 ∧ ∃ m', z = boundaryState (pc + 70) m' ∧
        PolynomialStored b m' dst cap (p ^ 2 + Polynomial.C a * Polynomial.X) ∧
        MemoryFrame (fun addr => dst ≤ addr ∧ addr < dst + cap) m m') := by
  let m1 := writeArray dst m (fun i => enc b ((p ^ 2).coeff i)) cap
  let m2 := Function.update m1 (dst + 1) (enc b a)
  obtain ⟨hSquareAt, hAddAt⟩ := At.seqStmt hAt
  have hSquare := squareProcedure_spec b ι t N P E pc dst src L cap p m hSquareAt hw hW hdet
    hcap hcapWord hdstWord hsrcWord hdst hsrc hdisj hp hm64 hm65 hm66
  have hwidth : (96 : ℕ) < 2 ^ E.W := by
    have hp8 : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (96 : ℕ) < 2 ^ 8) hp8
  have hm1meta (slot : ℕ) (hslot : slot < 128) : m1 slot = m slot :=
    writeArray_frame dst m _ cap slot (by omega)
  have hAdd : Sem P E (pc + 45) (pc + 70) (boundaryState (pc + 45) m1)
      (fun k z => k ≤ 25 ∧ z = boundaryState (pc + 70) m2) := by
    exact Sem.boundary_block P E _ traceAddXCode m1 m2 hAddAt
      (by simp [traceAddXCode, metaReadCode, zeroRegsCode])
      (traceAddX_spec b E _ dst a hwidth (by omega) (by omega)
        (by change m1 64 = dst; rw [hm1meta 64 (by norm_num)]; exact hm64)
        (by change m1 96 = enc b a; rw [hm1meta 96 (by norm_num)]; exact hm96))
  have hFull := Sem.seq_bound hSquare (fun z _ hz => by subst z; exact hAdd)
  refine Sem.mono hFull ?_
  intro k z hQ
  obtain ⟨hk, hz⟩ := hQ
  refine ⟨by omega, m2, hz, polynomial_square_add_X_stored b m dst cap p a, ?_⟩
  intro addr haddr
  have hne : addr ≠ dst + 1 := by omega
  change Function.update m1 (dst + 1) (enc b a) addr = m addr
  rw [Function.update_of_ne hne]
  exact writeArray_frame dst m _ cap addr (by omega)

/-- Pointer exchange for arbitrary stored Euclidean rows. -/
theorem PadeRows.swap_memory {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap : ℕ}
    {m : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s) :
    PadeRows b E DB CB RB UB L cap (swapRowMemory m RB UB DB CB)
      (⟨s.rem, s.curC, s.prevR, s.prevC⟩ : PadeState F) := by
  have hf : MemoryFrame (fun addr => addr < 128) m (swapRowMemory m RB UB DB CB) :=
    MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans
      (MemoryFrame.meta_update m 72 DB (by norm_num))
      (MemoryFrame.meta_update _ 73 CB (by norm_num)))
      (MemoryFrame.meta_update _ 74 RB (by norm_num)))
      (MemoryFrame.meta_update _ 75 UB (by norm_num))
  refine ⟨h.layout.swap, h.Dword, h.Cword, h.Rword, h.Uword,
    h.rem.of_metaFrame h.layout.Dlow hf, h.curC.of_metaFrame h.layout.Clow hf,
    h.prevR.of_metaFrame h.layout.Rlow hf, h.prevC.of_metaFrame h.layout.Ulow hf, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simp [swapRowMemory]
  · simp [swapRowMemory]
  · simp [swapRowMemory]
  · simp [swapRowMemory]
  · simpa [swapRowMemory] using h.length
  · simpa [swapRowMemory] using h.dimension
  · simpa [swapRowMemory] using h.capacity

theorem swapRowMemory_frame (m : ℕ → ℕ) (RB UB DB CB cap : ℕ) :
    MemoryFrame (padeWritable RB UB DB CB cap) m (swapRowMemory m RB UB DB CB) := by
  apply MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans
    (MemoryFrame.update_allowed _ m 72 DB (by simp [padeWritable]))
    (MemoryFrame.update_allowed _ _ 73 CB (by simp [padeWritable])))
    (MemoryFrame.update_allowed _ _ 74 RB (by simp [padeWritable])))
    (MemoryFrame.update_allowed _ _ 75 UB (by simp [padeWritable]))

/-- General Euclidean row transition, using uniform fuel instead of the
key-equation degree-balance invariant. -/
theorem gcdQuotient_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdQuotientProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s)
    (hR : s.prevR.natDegree < L) (hDpos : 0 < s.rem.natDegree)
    (hD : s.rem.natDegree < L) (hC : s.curC.natDegree < L)
    (hscan : m 95 = s.rem.natDegree + 1) :
    Sem P E pc (pc + 335) (boundaryState pc m)
      (fun k z => k ≤ (48 * L + 187) * L + 105 ∧
        ∃ m', z = boundaryState (pc + 335) m' ∧
          PadeRows b E DB CB RB UB L cap m' (padeNext s) ∧
          MemoryFrame (padeWritable RB UB DB CB cap) m m') := by
  obtain ⟨hModAt, hSwapAt⟩ := At.seqStmt hAt
  have hMod := polynomialModulo_spec b ι t N P E pc RB UB DB CB L cap s m hModAt
    hw hW hdet hL hcap hrows hR hDpos hD hC hscan
  have hFull := Sem.seq_bound hMod (fun z _ hQ => by
    obtain ⟨m1, hz, hr, hf⟩ := hQ
    subst z
    have hwidth : (75 : ℕ) < 2 ^ E.W := by
      have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
        rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
      exact lt_of_lt_of_le (by norm_num : (75 : ℕ) < 2 ^ 8) hp
    have hSwap : Sem P E (pc + 295) (pc + 335) (boundaryState (pc + 295) m1)
        (fun k z => k ≤ 40 ∧ z = boundaryState (pc + 335) (swapRowMemory m1 RB UB DB CB)) := by
      exact Sem.boundary_block P E _ swapRowsCode m1 _ hSwapAt
        (by simp [swapRowsCode, metaReadCode, metaStoreCode, zeroRegsCode])
        (swapRows_spec E _ RB UB DB CB hwidth
          (by have h := hrows.Rword; have h' := hrows.layout.Rlow; omega)
          (by have h := hrows.Uword; have h' := hrows.layout.Ulow; omega)
          (by have h := hrows.Dword; have h' := hrows.layout.Dlow; omega)
          (by have h := hrows.Cword; have h' := hrows.layout.Clow; omega)
          hr.ptr72 hr.ptr73 hr.ptr74 hr.ptr75)
    refine Sem.mono (Q' := fun k z => k ≤ 40 ∧ ∃ m', z = boundaryState (pc + 335) m' ∧
      PadeRows b E DB CB RB UB L cap m' (padeNext s) ∧
      MemoryFrame (padeWritable RB UB DB CB cap) m m') hSwap ?_
    intro k z hQ
    exact ⟨hQ.1, swapRowMemory m1 RB UB DB CB, hQ.2, hr.swap_memory,
      MemoryFrame.trans hf (swapRowMemory_frame m1 RB UB DB CB cap)⟩)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem gcd_constant_finish {F : Type} [Field F] [DecidableEq F] (s : PadeState F)
    (hdeg : s.rem.natDegree = 0) : EuclideanDomain.gcd s.rem s.prevR = gcdFinish s := by
  by_cases hz : s.rem = 0
  · simp [hz, gcdFinish]
  · have hmod : s.prevR % s.rem = 0 := by
      have h := Polynomial.degree_mod_lt s.prevR hz
      rw [Polynomial.degree_eq_natDegree hz, hdeg] at h
      apply Polynomial.ext
      intro i
      rw [Polynomial.coeff_zero]
      exact (Polynomial.degree_lt_iff_coeff_zero _ 0).mp h i (Nat.zero_le i)
    rw [EuclideanDomain.gcd_val s.rem s.prevR, hmod, EuclideanDomain.gcd_zero_left]
    simp [gcdFinish, hz]

/-- The existing padded Euclidean iteration also computes gcd when t=1. -/
theorem padeRun_gcd {F : Type} [Field F] [DecidableEq F]
    (fuel : ℕ) (s : PadeState F) (hfuel : s.rem.natDegree < fuel) :
    gcdFinish (padeRun 1 fuel s) = EuclideanDomain.gcd s.rem s.prevR := by
  induction fuel generalizing s with
  | zero => omega
  | succ n ih =>
      by_cases hs : s.rem.natDegree < 1
      · rw [padeRun, if_pos hs]
        exact (gcd_constant_finish s (by omega)).symm
      · have hdeg : (padeNext s).rem.natDegree < s.rem.natDegree :=
          Polynomial.natDegree_mod_lt _ (by omega)
        rw [padeRun, if_neg hs, ih (padeNext s) (by omega)]
        exact (EuclideanDomain.gcd_val s.rem s.prevR).symm

theorem gcdInv_tick {F : Type} [Field F] {L : ℕ} {s : PadeState F} (h : GcdInv L s) :
    GcdInv L (padeTick 1 s) := by
  by_cases hs : s.rem.natDegree < 1
  · simpa only [padeTick, if_pos hs] using h
  · rw [padeTick, if_neg hs]
    refine ⟨h.2.1, lt_trans (Polynomial.natDegree_mod_lt _ (by omega)) h.2.1, h.2.2.2, ?_⟩
    change s.prevC - (s.prevR / s.rem) * s.curC = 0
    simp [h.2.2.1, h.2.2.2]

theorem padeRun_gcd_stop {F : Type} [Field F] (fuel : ℕ) (s : PadeState F)
    (hfuel : s.rem.natDegree < fuel) : (padeRun 1 fuel s).rem.natDegree = 0 := by
  induction fuel generalizing s with
  | zero => omega
  | succ n ih =>
      by_cases hs : s.rem.natDegree < 1
      · rw [padeRun, if_pos hs]; omega
      · have hdeg : (padeNext s).rem.natDegree < s.rem.natDegree :=
          Polynomial.natDegree_mod_lt _ (by omega)
        rw [padeRun, if_neg hs]
        exact ih (padeNext s) (by omega)

theorem gcdTestLoad_spec (E : RAMEnv) (pc : ℕ) (m : ℕ → ℕ) (d : ℕ)
    (hmeta : (95 : ℕ) < 2 ^ E.W) (hd : d < 2 ^ E.W) (hm95 : m 95 = d) :
    runBlock gcdTestLoadCode E (boundaryState pc m) = padeTestState (pc + 4) m 1 d := by
  rw [gcdTestLoadCode, runBlock_append, metaRead_spec E _ r1 95 (by decide)]
  have h95 : (95 : ℕ) % 2 ^ E.W = 95 := Nat.mod_eq_of_lt hmeta
  have h1 : (1 : ℕ) % 2 ^ E.W = 1 := Nat.mod_eq_of_lt (by omega)
  apply ramState_eq_of
  · rfl
  · rfl
  · intro r
    fin_cases r <;> simp [runBlock_cons, runBlock_nil, execInstr, boundaryState, padeTestState,
      h95, h1, hm95, Nat.mod_eq_of_lt hd]

theorem gcdSelect_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdSelectStmt pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s) (hinv : GcdInv L s)
    (hm95 : m 95 = degreeScan s.rem cap) :
    Sem P E pc (pc + 375) (boundaryState pc m)
      (fun k z => k ≤ (48 * L + 187) * L + 128 ∧
        ∃ m', z = boundaryState (pc + 375) m' ∧
          PadeAdvance b E RB UB DB CB L cap m m' (padeTick 1 s)) := by
  have hwidth : (95 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (95 : ℕ) < 2 ^ 8) hp
  have hcapWord : cap < 2 ^ E.W := by have h := hrows.layout.Rlow; have h' := hrows.Rword; omega
  have hdWord : degreeScan s.rem cap < 2 ^ E.W := lt_of_le_of_lt (degreeScan_le _ _) hcapWord
  have hDcap : s.rem.natDegree < cap := by have h := hinv.2.1; omega
  obtain ⟨hLoadAt, hSelectAt⟩ := At.seqStmt hAt
  obtain ⟨_, _, hTrueAt, _, hFalseAt, _⟩ := at_ite hSelectAt
  obtain ⟨hZeroAt, hQuotAt⟩ := At.seqStmt hTrueAt
  have hLoad : Sem P E pc (pc + 4) (boundaryState pc m)
      (fun k z => k ≤ 4 ∧ z = padeTestState (pc + 4) m 1 (degreeScan s.rem cap)) := by
    refine Sem.mono (Sem.block P E pc gcdTestLoadCode _ hLoadAt
      (by simp [gcdTestLoadCode, metaReadCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 4 at hk; omega, hz.trans (gcdTestLoad_spec E pc m _ hwidth hdWord hm95)⟩
  let z0 := padeTestState (pc + 4) m 1 (degreeScan s.rem cap)
  let c : Cond := .lt r15 r0 r1
  have htest : c.eval z0 ↔ 1 ≤ s.rem.natDegree := by
    change (1 < degreeScan s.rem cap) ↔ _
    exact padeScan_go 1 cap s.rem le_rfl hDcap
  have hIf : Sem P E (pc + 4) (pc + 375) z0
      (fun k z => k ≤ (48 * L + 187) * L + 124 ∧
        ∃ m', z = boundaryState (pc + 375) m' ∧
          PadeAdvance b E RB UB DB CB L cap m m' (padeTick 1 s)) := by
    apply Sem.ite P E (pc + 4) c (.seq (.code zeroRegsCode) gcdQuotientProcedure) (.code zeroRegsCode)
      z0 _ hSelectAt (by omega) rfl
    · intro hgo
      have hg : 1 ≤ s.rem.natDegree := htest.mp hgo
      have hne : s.rem ≠ 0 := by intro hz; simp [hz] at hg
      have hscan : m 95 = s.rem.natDegree + 1 := by rw [hm95, degreeScan_eq s.rem hne cap hDcap]
      have hZero : Sem P E (pc + 6) (pc + 22)
          { runBlock c.code E z0 with pc := pc + 6 }
          (fun k z => k ≤ 16 ∧ z = boundaryState (pc + 22) m) := by
        refine Sem.mono (Sem.block P E _ zeroRegsCode _ hZeroAt (by simp [zeroRegsCode]) rfl) ?_
        intro k z hQ
        obtain ⟨hk, hz⟩ := hQ
        refine ⟨by change k = 16 at hk; omega, ?_⟩
        rw [hz, zeroRegs_spec]
        rfl
      have hC : s.curC.natDegree < L := by rw [hinv.2.2.2, Polynomial.natDegree_zero]; omega
      have hQuot := gcdQuotient_spec b ι t N P E (pc + 22) RB UB DB CB L cap s m hQuotAt
        hw hW hdet hL hcap hrows hinv.1 hg hinv.2.1 hC hscan
      have hTrue := Sem.seq_bound hZero (fun z _ hz => by subst z; exact hQuot)
      refine Sem.mono hTrue ?_
      intro k z hQ
      obtain ⟨hk, m', hz, hr, hf⟩ := hQ
      refine ⟨by change 1 + 1 + k + 1 ≤ _; omega, m', ?_, DB, CB, RB, UB, ?_, hf, ?_⟩
      · rw [hz]; rfl
      · simpa only [padeTick, if_neg (by omega : ¬ s.rem.natDegree < 1)] using hr
      · exact padeWritable_swap RB UB DB CB cap
    · intro hstop
      have hs : s.rem.natDegree < 1 := by have h := (not_congr htest).mp hstop; omega
      have hZero : Sem P E (pc + 358) (pc + 374)
          { runBlock c.code E z0 with pc := pc + 358 }
          (fun k z => k ≤ 16 ∧ z = boundaryState (pc + 374) m) := by
        refine Sem.mono (Sem.block P E _ zeroRegsCode _ hFalseAt (by simp [zeroRegsCode]) rfl) ?_
        intro k z hQ
        obtain ⟨hk, hz⟩ := hQ
        refine ⟨by change k = 16 at hk; omega, ?_⟩
        rw [hz, zeroRegs_spec]
        rfl
      refine Sem.mono hZero ?_
      intro k z hQ
      obtain ⟨hk, hz⟩ := hQ
      refine ⟨by change 1 + 1 + k + 1 ≤ _; omega, m, ?_, RB, UB, DB, CB, ?_, ?_, ?_⟩
      · rw [hz]; rfl
      · simpa only [padeTick, if_pos hs] using hrows
      · intro addr _; rfl
      · intro addr; rfl
  have hFull := Sem.seq_bound hLoad (fun z _ hz => by subst z; exact hIf)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem gcdStep_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdStepProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s) (hinv : GcdInv L s) :
    Sem P E pc (pc + 445) (boundaryState pc m)
      (fun k z => k ≤ 17 * cap + (48 * L + 187) * L + 183 ∧
        ∃ m', z = boundaryState (pc + 445) m' ∧
          PadeAdvance b E RB UB DB CB L cap m m' (padeTick 1 s)) := by
  let m1 := Function.update (Function.update m 64 DB) 66 cap
  let m2 := Function.update m1 95 (degreeScan s.rem cap)
  have hf1 : MemoryFrame padeScratch m m1 :=
    MemoryFrame.trans (MemoryFrame.update_allowed padeScratch m 64 _ (by simp [padeScratch]))
      (MemoryFrame.update_allowed padeScratch _ 66 _ (by simp [padeScratch]))
  have hf2 : MemoryFrame padeScratch m1 m2 := MemoryFrame.update_allowed padeScratch m1 95 _ (by simp [padeScratch])
  have hr1 := hrows.of_scratch hf1
  have hr2 := hr1.of_scratch hf2
  have hwidth : (95 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (95 : ℕ) < 2 ^ 8) hp
  have hcapWord : cap < 2 ^ E.W := by have h := hrows.layout.Rlow; have h' := hrows.Rword; omega
  have hDBword : DB < 2 ^ E.W := by have h := hrows.Dword; omega
  obtain ⟨hSetupAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hScanAt, hSelectAt⟩ := At.seqStmt hRestAt
  have hSetup : Sem P E pc (pc + 28) (boundaryState pc m)
      (fun k z => k ≤ 28 ∧ z = boundaryState (pc + 28) m1) := by
    exact Sem.boundary_block P E _ (scanSetupCode 74) m m1 hSetupAt
      (by simp [scanSetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (scanSetup_spec E _ 74 DB cap (by omega) (by omega) hDBword hcapWord hrows.ptr74 hrows.capacity)
  have hScan := scanProcedure_spec b P E (pc + 28) DB cap s.rem m1 hScanAt hwidth (by omega)
    hDBword hcapWord hrows.Dword hr1.rem (by simp [m1]) (by simp [m1])
  have hSelect := gcdSelect_spec b ι t N P E (pc + 70) RB UB DB CB L cap s m2 hSelectAt
    hw hW hdet hL hcap hr2 hinv (by simp [m2])
  have hFull := Sem.seq_bound hSetup (fun z _ hz => by
    subst z
    exact Sem.seq_bound hScan (fun z _ hz => by subst z; exact hSelect))
  refine Sem.mono hFull ?_
  intro k z hQ
  obtain ⟨hk, m', hz, RB', UB', DB', CB', hr', hf', hfoot⟩ := hQ
  refine ⟨by omega, m', hz, RB', UB', DB', CB', hr', ?_, hfoot⟩
  apply MemoryFrame.trans ((MemoryFrame.trans hf1 hf2).mono ?_) hf'
  intro addr ha
  dsimp [padeScratch] at ha
  dsimp [padeWritable]
  omega

theorem PadeRows.gcdCounter_update {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap : ℕ}
    {m : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s) (n : ℕ) :
    PadeRows b E RB UB DB CB L cap (Function.update m 93 n) s := by
  apply h.of_scratchFrame (MemoryFrame.meta_update m 93 n (by norm_num))
  intro slot hs
  rw [Function.update_of_ne (by omega : slot ≠ 93)]

theorem gcdLoopBody_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap n : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdLoopBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s) (hinv : GcdInv L s)
    (hn : n + 1 < 2 ^ E.W) (hm93 : m 93 = n + 1) :
    Sem P E pc (pc + 488) (rankState pc m (n + 1))
      (fun k z => k ≤ 17 * cap + (48 * L + 187) * L + 226 ∧
        ∃ m' RB' UB' DB' CB', z = rankState (pc + 488) m' n ∧ m' 93 = n ∧
          PadeRows b E RB' UB' DB' CB' L cap m' (padeTick 1 s) ∧
          MemoryFrame (gcdLoopWritable RB UB DB CB cap) m m' ∧
          ∀ addr, padeWritable RB' UB' DB' CB' cap addr ↔ padeWritable RB UB DB CB cap addr) := by
  obtain ⟨hZeroAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hStepAt, hTailAt⟩ := At.seqStmt hRestAt
  have hwidth : (93 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (93 : ℕ) < 2 ^ 8) hp
  have hZero : Sem P E pc (pc + 16) (rankState pc m (n + 1))
      (fun k z => k ≤ 16 ∧ z = boundaryState (pc + 16) m) := by
    refine Sem.mono (Sem.block P E _ zeroRegsCode _ hZeroAt (by simp [zeroRegsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    refine ⟨by change k = 16 at hk; omega, ?_⟩
    rw [hz, zeroRegs_spec]
    rfl
  have hStep := gcdStep_spec b ι t N P E (pc + 16) RB UB DB CB L cap s m hStepAt
    hw hW hdet hL hcap hrows hinv
  have hRest : Sem P E (pc + 16) (pc + 488) (boundaryState (pc + 16) m)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 183) + 27 ∧
        ∃ m' RB' UB' DB' CB', z = rankState (pc + 488) m' n ∧ m' 93 = n ∧
          PadeRows b E RB' UB' DB' CB' L cap m' (padeTick 1 s) ∧
          MemoryFrame (gcdLoopWritable RB UB DB CB cap) m m' ∧
          ∀ addr, padeWritable RB' UB' DB' CB' cap addr ↔ padeWritable RB UB DB CB cap addr) := by
    refine Sem.seq_bound hStep ?_
    intro z hzpc hQ
    obtain ⟨m1, hz, RB', UB', DB', CB', hr, hf, hfoot⟩ := hQ
    subst z
    have hnot : ¬ padeWritable RB UB DB CB cap 93 := by
      dsimp [padeWritable]
      have hR := hrows.layout.Rlow
      have hU := hrows.layout.Ulow
      have hD := hrows.layout.Dlow
      have hC := hrows.layout.Clow
      omega
    have h93 : m1 93 = n + 1 := (hf 93 hnot).trans hm93
    have hTailRun := countdown_spec E (boundaryState (pc + 461) m1) 93 n hwidth hn h93
    refine Sem.mono (Sem.block P E (pc + 461) (countdownCode 93) _ hTailAt
      (by simp [countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    refine ⟨by change k = 27 at hk; omega,
      Function.update m1 93 n, RB', UB', DB', CB', ?_, by simp, hr.gcdCounter_update n, ?_, hfoot⟩
    · rw [hz, hTailRun]; rfl
    · exact MemoryFrame.trans (hf.mono (by intro addr ha; exact Or.inr ha))
        (MemoryFrame.update_allowed _ m1 93 n (Or.inl rfl))
  have hFull := Sem.seq_bound hZero (fun z _ hz => by subst z; exact hRest)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem gcdLoop_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap n0 : ℕ) (s0 : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdLoopStmt pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s0) (hinv : GcdInv L s0)
    (hn0 : n0 < 2 ^ E.W) (hm93 : m 93 = n0) :
    Sem P E pc (pc + 490) (rankState pc m n0)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * n0 + 1 ∧
        z.regs = (fun _ => 0) ∧ z.mem 93 = 0 ∧
        MemoryFrame (gcdLoopWritable RB UB DB CB cap) m z.mem ∧
        ∃ RB' UB' DB' CB', PadeRows b E RB' UB' DB' CB' L cap z.mem (padeRun 1 n0 s0) ∧
          ∀ addr, padeWritable RB' UB' DB' CB' cap addr ↔ padeWritable RB UB DB CB cap addr) := by
  let I := fun n z => n ≤ n0 ∧ gcdLoopInvariant b E RB UB DB CB L cap (padeRun 1 n0 s0) m n z
  have hW1 : 1 < 2 ^ E.W := by have h := hrows.layout.Rlow; have h' := hrows.Rword; omega
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by
    intro n z pc' h
    simpa only [I, gcdLoopInvariant] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by
    intro n z h
    rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 }
        (fun k z' => k ≤ 17 * cap + (48 * L + 187) * L + 227 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, h93, hf0, RB1, UB1, DB1, CB1, s, hr, hi, hremaining, hfoot0⟩ := hI
    have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (n + 1) := by
      apply ramState_eq_of
      · rfl
      · rfl
      · intro r; exact congrFun hregs r
    rw [hz]
    have hrun := gcdLoopBody_spec b ι t N P E (pc + 1) RB1 UB1 DB1 CB1 L cap n s z.mem
      hBodyAt hw hW hdet hL hcap hr hi (by omega) h93
    refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
    intro k z' hQ
    obtain ⟨hk, m', RB2, UB2, DB2, CB2, hz', h93', hr', hf', hfoot'⟩ := hQ
    refine ⟨by omega, by omega, ?_⟩
    rw [hz']
    refine ⟨rfl, h93', ?_, RB2, UB2, DB2, CB2, padeTick 1 s, hr', gcdInv_tick hi, ?_, ?_⟩
    · exact MemoryFrame.trans hf0 (hf'.mono (by
        intro addr ha
        rcases ha with h93 | hp
        · exact Or.inl h93
        · exact Or.inr ((hfoot0 addr).mp hp)))
    · exact (padeRun_succ_tick 1 n s).trans hremaining
    · intro addr
      exact (hfoot' addr).trans (hfoot0 addr)
  have hinit : I n0 (rankState pc m n0) := by
    refine ⟨le_rfl, rfl, hm93, ?_, RB, UB, DB, CB, s0, hrows, hinv, rfl, ?_⟩
    · intro addr _; rfl
    · intro addr; rfl
  have hloop := Sem.loop_invariant P E pc gcdLoopBody hAt hW1 I
    (17 * cap + (48 * L + 187) * L + 227) hframe hcounter hbody n0 (rankState pc m n0) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, h93, hf, RB', UB', DB', CB', s, hr, _, hremaining, hfoot⟩ := hQ
  have hs : s = padeRun 1 n0 s0 := hremaining
  refine ⟨hk, ?_, h93, hf, RB', UB', DB', CB', ?_, hfoot⟩
  · rw [hregs]
    funext r
    simp [Function.update_apply]
  · simpa only [hs] using hr

theorem gcdSolveProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap n0 : ℕ) (s0 : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdSolveProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s0) (hinv : GcdInv L s0)
    (hn0 : n0 < 2 ^ E.W) (hm93 : m 93 = n0) :
    Sem P E pc (pc + 493) (boundaryState pc m)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * n0 + 4 ∧
        ∃ m' RB' UB' DB' CB', z = boundaryState (pc + 493) m' ∧ m' 93 = 0 ∧
          MemoryFrame (gcdLoopWritable RB UB DB CB cap) m m' ∧
          PadeRows b E RB' UB' DB' CB' L cap m' (padeRun 1 n0 s0) ∧
          ∀ addr, padeWritable RB' UB' DB' CB' cap addr ↔ padeWritable RB UB DB CB cap addr) := by
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hwidth : (93 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (93 : ℕ) < 2 ^ 8) hp
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m n0) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 93) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 3 at hk; omega, hz.trans (rankReadSlot_spec E pc m 93 n0 hwidth hn0 hm93)⟩
  have hLoop := gcdLoop_spec b ι t N P E (pc + 3) RB UB DB CB L cap n0 s0 m hLoopAt
    hw hW hdet hL hcap hrows hinv hn0 hm93
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, h93, hf, RB', UB', DB', CB', hr, hfoot⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, RB', UB', DB', CB', ?_, h93, hf, hr, hfoot⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r
    simpa only [boundaryState] using congrFun hregs r

theorem gcdReturnCode_spec (E : RAMEnv) (s : RAMState) (RB DB d : ℕ)
    (hmeta : (97 : ℕ) < 2 ^ E.W) (hR : RB < 2 ^ E.W) (hD : DB < 2 ^ E.W)
    (hd : d ≤ 1) (hm72 : s.mem 72 = RB) (hm74 : s.mem 74 = DB) (hm95 : s.mem 95 = d) :
    runBlock gcdReturnCode E s = boundaryState (s.pc + 33)
      (Function.update s.mem 97 (if d = 0 then RB else DB)) := by
  have hsmall : ∀ i ≤ 97, i % 2 ^ E.W = i := by
    intro i hi
    exact Nat.mod_eq_of_lt (by omega)
  have hR0 : RB % 2 ^ E.W = RB := Nat.mod_eq_of_lt hR
  have hD0 : DB % 2 ^ E.W = DB := Nat.mod_eq_of_lt hD
  have hsub0 : (1 + 2 ^ E.W - 0) % 2 ^ E.W = 1 := by simp [Nat.add_mod, hsmall 1 (by norm_num)]
  have hsub1 : (1 + 2 ^ E.W - 1) % 2 ^ E.W = 0 := by simp
  rw [gcdReturnCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc gcdReturnCode E s (by
      simp [gcdReturnCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [gcdReturnCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 33 at hp
    exact hp
  · rcases (show d = 0 ∨ d = 1 by omega) with h0 | h1
    · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil,
        execInstr, hsmall, hm72, hm74, hm95, h0, hR0, hD0, hsub0, boundaryState]
    · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil,
        execInstr, hsmall, hm72, hm74, hm95, h1, hR0, hD0, hsub1, boundaryState]
  · intro _; rfl

theorem gcdReturnProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc RB UB DB CB L cap : ℕ) (s : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdReturnProcedure pc))
    (hmeta : (97 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hcap : 1 ≤ cap)
    (hrows : PadeRows b E RB UB DB CB L cap m s) (hdeg : s.rem.natDegree = 0) :
    Sem P E pc (pc + 103) (boundaryState pc m)
      (fun k z => k ≤ 17 * cap + 88 ∧ ∃ m' out, z = boundaryState (pc + 103) m' ∧
        m' 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
        PolynomialStored b m' out cap (gcdFinish s) ∧
        MemoryFrame (fun addr => addr = 64 ∨ addr = 66 ∨ addr = 95 ∨ addr = 97) m m' ∧ (out = RB ∨ out = DB)) := by
  let d := degreeScan s.rem cap
  let m1 := Function.update (Function.update m 64 DB) 66 cap
  let m2 := Function.update m1 95 d
  let out := if d = 0 then RB else DB
  let m3 := Function.update m2 97 out
  have hd : d ≤ 1 := by
    by_cases hz : s.rem = 0
    · simp [d, hz]
    · rw [show d = s.rem.natDegree + 1 from degreeScan_eq s.rem hz cap (by omega), hdeg]
  have hout : out = if s.rem = 0 then RB else DB := by
    by_cases hz : s.rem = 0
    · simp [out, d, hz]
    · simp [out, d, degreeScan_eq s.rem hz cap (by omega), hdeg, hz]
  have hcapWord : cap < 2 ^ E.W := by have h := hrows.layout.Rlow; have h' := hrows.Rword; omega
  have hDBword : DB < 2 ^ E.W := by have h := hrows.Dword; omega
  have hf1 : MemoryFrame padeScratch m m1 :=
    MemoryFrame.trans (MemoryFrame.update_allowed padeScratch m 64 _ (by simp [padeScratch]))
      (MemoryFrame.update_allowed padeScratch _ 66 _ (by simp [padeScratch]))
  have hf2 : MemoryFrame padeScratch m1 m2 := MemoryFrame.update_allowed padeScratch m1 95 d (by simp [padeScratch])
  have hr1 := hrows.of_scratch hf1
  have hr2 := hr1.of_scratch hf2
  obtain ⟨hSetupAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hScanAt, hReturnAt⟩ := At.seqStmt hRestAt
  have hSetup : Sem P E pc (pc + 28) (boundaryState pc m)
      (fun k z => k ≤ 28 ∧ z = boundaryState (pc + 28) m1) := by
    exact Sem.boundary_block P E _ (scanSetupCode 74) m m1 hSetupAt
      (by simp [scanSetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (scanSetup_spec E _ 74 DB cap (by omega) (by omega) hDBword hcapWord hrows.ptr74 hrows.capacity)
  have hScan := scanProcedure_spec b P E (pc + 28) DB cap s.rem m1 hScanAt (by omega) hwe
    hDBword hcapWord hrows.Dword hr1.rem (by simp [m1]) (by simp [m1])
  have hReturn : Sem P E (pc + 70) (pc + 103) (boundaryState (pc + 70) m2)
      (fun k z => k ≤ 33 ∧ z = boundaryState (pc + 103) m3) := by
    exact Sem.boundary_block P E _ gcdReturnCode m2 m3 hReturnAt
      (by simp [gcdReturnCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (gcdReturnCode_spec E _ RB DB d hmeta
        (by have h := hrows.Rword; omega) hDBword hd hr2.ptr72 hr2.ptr74 (by simp [boundaryState, m2]))
  have hFull := Sem.seq_bound hSetup (fun z _ hz => by
    subst z
    exact Sem.seq_bound hScan (fun z _ hz => by subst z; exact hReturn))
  have hfinalmeta : MemoryFrame (fun addr => addr < 128) m2 m3 := MemoryFrame.meta_update m2 97 out (by norm_num)
  have hstored : PolynomialStored b m3 out cap (gcdFinish s) := by
    rw [hout]
    by_cases hz : s.rem = 0
    · simpa [gcdFinish, hz] using hr2.prevR.of_metaFrame hrows.layout.Rlow hfinalmeta
    · simpa [gcdFinish, hz] using hr2.rem.of_metaFrame hrows.layout.Dlow hfinalmeta
  refine Sem.mono hFull ?_
  intro k z hQ
  refine ⟨by omega, m3, out, hQ.2, by simp [m3], ?_, ?_, hstored, ?_, ?_⟩
  · rw [hout]
    split <;> first | exact hrows.layout.Rlow | exact hrows.layout.Dlow
  · rw [hout]
    split <;> first | exact hrows.Rword | exact hrows.Dword
  · apply MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans
      (MemoryFrame.update_allowed _ m 64 DB (by simp))
      (MemoryFrame.update_allowed _ _ 66 cap (by simp)))
      (MemoryFrame.update_allowed _ _ 95 d (by simp)))
      (MemoryFrame.update_allowed _ _ 97 out (by simp))
  · by_cases hzero : d = 0 <;> simp [out, hzero]

/-- Complete gcd routine: its returned pointer stores the exact Euclidean
 gcd, with no normalization or field enumeration. -/
theorem gcdProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB L cap : ℕ) (s0 : PadeState F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile gcdProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hL : 1 ≤ L) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m s0) (hinv : GcdInv L s0) (hm93 : m 93 = L) :
    Sem P E pc (pc + 596) (boundaryState pc m)
      (fun k z => k ≤ (17 * cap + (48 * L + 187) * L + 228) * L + 17 * cap + 92 ∧
        ∃ out, z.mem 97 = out ∧ 128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
          PolynomialStored b z.mem out cap (EuclideanDomain.gcd s0.rem s0.prevR) ∧
          MemoryFrame (gcdProcedureWritable RB UB DB CB cap) m z.mem ∧ z.regs = (fun _ => 0) ∧
          ∀ i < cap, padeWritable RB UB DB CB cap (out + i)) := by
  obtain ⟨hSolveAt, hReturnAt⟩ := At.seqStmt hAt
  have hLWord : L < 2 ^ E.W := by have h := hrows.Rword; have h' := hrows.layout.Rlow; omega
  have hmeta : (97 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (97 : ℕ) < 2 ^ 8) hp
  have hSolve := gcdSolveProcedure_spec b ι t N P E pc RB UB DB CB L cap L s0 m hSolveAt
    hw hW hdet hL hcap hrows hinv hLWord hm93
  have hFull := Sem.seq_bound hSolve (fun z _ hQ => by
    obtain ⟨m1, RB', UB', DB', CB', hz, _, hfSolve, hr, hfoot⟩ := hQ
    subst z
    have hReturn := gcdReturnProcedure_spec b P E (pc + 493) RB' UB' DB' CB' L cap
      (padeRun 1 L s0) m1 hReturnAt hmeta (by omega) (by omega) hr (padeRun_gcd_stop L s0 hinv.2.1)
    refine Sem.mono (Q' := fun k z => k ≤ 17 * cap + 88 ∧ ∃ out, z.mem 97 = out ∧
      128 ≤ out ∧ out + cap ≤ 2 ^ E.W ∧
      PolynomialStored b z.mem out cap (EuclideanDomain.gcd s0.rem s0.prevR) ∧
      MemoryFrame (gcdProcedureWritable RB UB DB CB cap) m z.mem ∧ z.regs = (fun _ => 0) ∧
          ∀ i < cap, padeWritable RB UB DB CB cap (out + i)) hReturn ?_
    intro k z hQ
    obtain ⟨hk, m2, out, hz, hout, hlo, hword, hp, hfReturn, hchoice⟩ := hQ
    refine ⟨hk, out, ?_, hlo, hword, ?_, ?_, ?_, ?_⟩
    · rw [hz]; exact hout
    · rw [hz]
      simpa only [boundaryState, padeRun_gcd L s0 hinv.2.1] using hp
    · rw [hz]
      apply MemoryFrame.trans (hfSolve.mono (by intro addr ha; exact Or.inr ha))
        (hfReturn.mono ?_)
      intro addr ha
      dsimp [gcdProcedureWritable, gcdLoopWritable, padeWritable]
      omega
    · rw [hz]; rfl
    · intro i hi
      apply (hfoot (out + i)).mp
      rcases hchoice with hR | hD
      · rw [hR]
        dsimp [padeWritable]
        omega
      · rw [hD]
        dsimp [padeWritable]
        omega)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem PadeRows.array_arguments {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap : ℕ}
    {m : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s) (dst src len : ℕ) :
    PadeRows b E RB UB DB CB L cap (arrayArguments m dst src len) s := by
  apply h.of_scratchFrame ((arrayArguments_frame m dst src len).mono (by intro addr ha; omega))
  intro slot hs
  exact arrayArguments_frame m dst src len slot (by omega)

/-- A write to the first row leaves the other rows and all pointers intact. -/
theorem PadeRows.replace_prevR {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap : ℕ}
    {m m' : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s) (q : F[X])
    (hf : MemoryFrame (fun addr => RB ≤ addr ∧ addr < RB + cap) m m')
    (hq : PolynomialStored b m' RB cap q) :
    PadeRows b E RB UB DB CB L cap m' (⟨q, s.prevC, s.rem, s.curC⟩ : PadeState F) := by
  have hmeta (slot : ℕ) (hs : slot < 128) : m' slot = m slot :=
    hf slot (by have h' := h.layout.Rlow; omega)
  refine ⟨h.layout, h.Rword, h.Uword, h.Dword, h.Cword, hq,
    h.prevC.of_frame hf (by intro i hi; have h' := h.layout.RU; omega),
    h.rem.of_frame hf (by intro i hi; have h' := h.layout.RD; omega),
    h.curC.of_frame hf (by intro i hi; have h' := h.layout.RC; omega), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hmeta 72 (by norm_num)).trans h.ptr72
  · exact (hmeta 73 (by norm_num)).trans h.ptr73
  · exact (hmeta 74 (by norm_num)).trans h.ptr74
  · exact (hmeta 75 (by norm_num)).trans h.ptr75
  · exact (hmeta 76 (by norm_num)).trans h.length
  · exact (hmeta 77 (by norm_num)).trans h.dimension
  · exact (hmeta 81 (by norm_num)).trans h.capacity

/-- Writes to a separate trace buffer preserve the four Euclidean rows. -/
theorem PadeRows.external_write {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap TB : ℕ}
    {m m' : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s)
    (hTB : 128 ≤ TB)
    (hR : TB + cap ≤ RB ∨ RB + cap ≤ TB) (hU : TB + cap ≤ UB ∨ UB + cap ≤ TB)
    (hD : TB + cap ≤ DB ∨ DB + cap ≤ TB) (hC : TB + cap ≤ CB ∨ CB + cap ≤ TB)
    (hf : MemoryFrame (fun addr => TB ≤ addr ∧ addr < TB + cap) m m') :
    PadeRows b E RB UB DB CB L cap m' s := by
  have hmeta (slot : ℕ) (hs : slot < 128) : m' slot = m slot := hf slot (by omega)
  refine ⟨h.layout, h.Rword, h.Uword, h.Dword, h.Cword,
    h.prevR.of_frame hf (by intro i hi; omega), h.prevC.of_frame hf (by intro i hi; omega),
    h.rem.of_frame hf (by intro i hi; omega), h.curC.of_frame hf (by intro i hi; omega), ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact (hmeta 72 (by norm_num)).trans h.ptr72
  · exact (hmeta 73 (by norm_num)).trans h.ptr73
  · exact (hmeta 74 (by norm_num)).trans h.ptr74
  · exact (hmeta 75 (by norm_num)).trans h.ptr75
  · exact (hmeta 76 (by norm_num)).trans h.length
  · exact (hmeta 77 (by norm_num)).trans h.dimension
  · exact (hmeta 81 (by norm_num)).trans h.capacity

theorem traceSquare_degree_lt {F : Type} [Field F] (p : F[X]) (a : F) (t L : ℕ)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hp : p.natDegree < t) :
    (p ^ 2 + Polynomial.C a * Polynomial.X).natDegree < L := by
  have hs : (p ^ 2).natDegree ≤ 2 * p.natDegree := by
    simpa only [pow_two, two_mul] using Polynomial.natDegree_mul_le (p := p) (q := p)
  have hl : (Polynomial.C a * Polynomial.X : F[X]).natDegree ≤ 1 := by
    simpa only [pow_one] using Polynomial.natDegree_C_mul_X_pow_le a 1
  have ha := Polynomial.natDegree_add_le (p ^ 2) (Polynomial.C a * Polynomial.X)
  omega

/-- One exact modular trace recurrence, retaining the factor and a separate
trace buffer so subsequent squarings never overwrite their source. -/
theorem traceStep_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB TB L cap : ℕ) (p f : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile traceStepProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m (⟨p, 0, f, 0⟩ : PadeState F))
    (hTB : 128 ≤ TB) (hTBword : TB + cap ≤ 2 ^ E.W)
    (hTR : TB + cap ≤ RB ∨ RB + cap ≤ TB) (hTU : TB + cap ≤ UB ∨ UB + cap ≤ TB)
    (hTD : TB + cap ≤ DB ∨ DB + cap ≤ TB) (hTC : TB + cap ≤ CB ∨ CB + cap ≤ TB)
    (htrace : PolynomialStored b m TB cap p) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hp : p.natDegree < f.natDegree)
    (hm95 : m 95 = f.natDegree + 1) (hm96 : m 96 = enc b a) (hm98 : m 98 = TB) :
    Sem P E pc (pc + 469) (boundaryState pc m)
      (fun k z => k ≤ 30 * cap + (48 * L + 187) * L + 213 ∧ ∃ m', z = boundaryState (pc + 469) m' ∧
        PadeRows b E RB UB DB CB L cap m' (⟨(p ^ 2 + Polynomial.C a * Polynomial.X) % f, 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap ((p ^ 2 + Polynomial.C a * Polynomial.X) % f) ∧
        m' 95 = f.natDegree + 1 ∧ m' 96 = enc b a ∧ m' 98 = TB ∧
        MemoryFrame (traceWritable RB UB DB CB TB cap) m m') := by
  let q := p ^ 2 + Polynomial.C a * Polynomial.X
  let m1 := arrayArguments m RB TB cap
  have hcapWord : cap < 2 ^ E.W := by have h := hrows.Rword; have h' := hrows.layout.Rlow; omega
  have hRBword : RB < 2 ^ E.W := by have h := hrows.Rword; omega
  have hTBword0 : TB < 2 ^ E.W := by omega
  have hwidth : (98 : ℕ) < 2 ^ E.W := by
    have hp8 : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (98 : ℕ) < 2 ^ 8) hp8
  have hLpos : 1 ≤ L := by omega
  have hq : q.natDegree < L := traceSquare_degree_lt p a t L ht hL (by omega)
  have hm1meta (slot : ℕ) (hlo : 72 ≤ slot) : m1 slot = m slot :=
    arrayArguments_frame m RB TB cap slot (by omega)
  have hr1 := hrows.array_arguments RB TB cap
  have ht1 : PolynomialStored b m1 TB L p := by
    intro i hi
    change arrayArguments m RB TB cap (TB + i) = enc b (p.coeff i)
    rw [arrayArguments_frame m RB TB cap (TB + i) (by omega)]
    exact htrace i (by omega)
  obtain ⟨hSetup1At, hRest1⟩ := At.seqStmt hAt
  obtain ⟨hSquareAt, hRest2⟩ := At.seqStmt hRest1
  obtain ⟨hModAt, hRest3⟩ := At.seqStmt hRest2
  obtain ⟨hSetup2At, hCopyAt⟩ := At.seqStmt hRest3
  have hSetup1 : Sem P E pc (pc + 34) (boundaryState pc m)
      (fun k z => k ≤ 34 ∧ z = boundaryState (pc + 34) m1) := by
    exact Sem.boundary_block P E _ (arraySetupCode 72 98) m m1 hSetup1At
      (by simp [arraySetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (arraySetup_spec E _ 72 98 RB TB cap (by omega) (by omega) hwidth hRBword hTBword0 hcapWord
        hrows.ptr72 hm98 hrows.capacity)
  have hSquare := traceSquareProcedure_spec b ι t N P E (pc + 34) RB TB L cap p a m1 hSquareAt
    hw hW hdet hLpos hcap hcapWord hrows.layout.Rlow hRBword hTBword0 hrows.Rword
    (by omega) (by omega) ht1 (by simp [m1, arrayArguments]) (by simp [m1, arrayArguments])
    (by simp [m1, arrayArguments]) (by rw [hm1meta 96 (by norm_num)]; exact hm96)
  obtain ⟨_, ks, zs, hrunS, hpcS, hcostS, m2, hzS, hqStored, hfSquare⟩ := hSquare
  have hr2 := hr1.replace_prevR q hfSquare hqStored
  have hm2meta (slot : ℕ) (hhi : slot < 128) : m2 slot = m1 slot :=
    hfSquare slot (by have h := hrows.layout.Rlow; omega)
  have hSquareExact : Sem P E (pc + 34) (pc + 104) (boundaryState (pc + 34) m1)
      (fun k z => k ≤ 18 * cap + 54 ∧ z = boundaryState (pc + 104) m2) :=
    ⟨rfl, ks, zs, hrunS, hpcS, hcostS, hzS⟩
  have hMod := polynomialModulo_strong_spec b ι t N P E (pc + 104) RB UB DB CB L cap
    (⟨q, 0, f, 0⟩ : PadeState F) m2 hModAt hw hW hdet hLpos hcap hr2 hq hFpos (by change f.natDegree < L; omega)
    (by simpa only [Polynomial.natDegree_zero] using (show 0 < L by omega))
    (by change m2 95 = f.natDegree + 1; rw [hm2meta 95 (by norm_num), hm1meta 95 (by norm_num)]; exact hm95)
  obtain ⟨_, km, zm, hrunM, hpcM, hcostM, m3, hzM, hr3raw, hfMod, hm3meta⟩ := hMod
  have hr3 : PadeRows b E RB UB DB CB L cap m3 (⟨q % f, 0, f, 0⟩ : PadeState F) := by
    simpa [reducedPadeRows] using hr3raw
  have hModExact : Sem P E (pc + 104) (pc + 399) (boundaryState (pc + 104) m2)
      (fun k z => k ≤ (48 * L + 187) * L + 65 ∧ z = boundaryState (pc + 399) m3) :=
    ⟨rfl, km, zm, hrunM, hpcM, hcostM, hzM⟩
  let m4 := arrayArguments m3 TB RB cap
  let m5 := writeArray TB m4 (fun i => m4 (RB + i)) cap
  have hr4 := hr3.array_arguments TB RB cap
  have hm4meta (slot : ℕ) (hlo : 72 ≤ slot) : m4 slot = m3 slot :=
    arrayArguments_frame m3 TB RB cap slot (by omega)
  have hSetup2 : Sem P E (pc + 399) (pc + 433) (boundaryState (pc + 399) m3)
      (fun k z => k ≤ 34 ∧ z = boundaryState (pc + 433) m4) := by
    exact Sem.boundary_block P E _ (arraySetupCode 98 72) m3 m4 hSetup2At
      (by simp [arraySetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (arraySetup_spec E _ 98 72 TB RB cap (by omega) hwidth (by omega) hTBword0 hRBword hcapWord
        (by change m3 98 = TB; rw [hm3meta 98 (by norm_num) (by norm_num), hm2meta 98 (by norm_num), hm1meta 98 (by norm_num)]; exact hm98)
        hr3.ptr72 hr3.capacity)
  have hCopy := copyProcedure_spec P E (pc + 433) TB RB cap m4 hCopyAt (by omega) hTBword0 hRBword hcapWord
    hTBword hrows.Rword (by omega)
    (fun i hi => by
      have hv : m4 (RB + i) = enc b ((q % f).coeff i) := hr4.prevR i hi
      rw [hv]
      exact lt_of_lt_of_le (enc_lt b _) (by rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)))
    (by simp [m4, arrayArguments]) (by simp [m4, arrayArguments]) (by simp [m4, arrayArguments])
  have hfCopy : MemoryFrame (fun addr => TB ≤ addr ∧ addr < TB + cap) m4 m5 := by
    intro addr ha
    exact writeArray_frame TB m4 _ cap addr (by omega)
  have hr5 := hr4.external_write hTB hTR hTU hTD hTC hfCopy
  have ht5 : PolynomialStored b m5 TB cap (q % f) := by
    intro i hi
    change writeArray TB m4 (fun j => m4 (RB + j)) cap (TB + i) = enc b ((q % f).coeff i)
    rw [writeArray_get TB m4 _ cap i hi]
    exact hr4.prevR i hi
  have hm5meta (slot : ℕ) (hhi : slot < 128) : m5 slot = m4 slot := hfCopy slot (by omega)
  have hmFinal (slot : ℕ) (hlo : 72 ≤ slot) (hhi : slot < 128) : m5 slot = m slot := by
    rw [hm5meta slot hhi, hm4meta slot hlo, hm3meta slot hlo hhi, hm2meta slot hhi, hm1meta slot hlo]
  have hf01 : MemoryFrame (traceWritable RB UB DB CB TB cap) m m1 :=
    (arrayArguments_frame m RB TB cap).mono (by intro addr ha; dsimp [traceWritable, padeWritable]; omega)
  have hf12 : MemoryFrame (traceWritable RB UB DB CB TB cap) m1 m2 :=
    hfSquare.mono (by intro addr ha; dsimp [traceWritable, padeWritable]; omega)
  have hf23 : MemoryFrame (traceWritable RB UB DB CB TB cap) m2 m3 := hfMod.mono (by intro addr ha; exact Or.inl ha)
  have hf34 : MemoryFrame (traceWritable RB UB DB CB TB cap) m3 m4 :=
    (arrayArguments_frame m3 TB RB cap).mono (by intro addr ha; dsimp [traceWritable, padeWritable]; omega)
  have hf45 : MemoryFrame (traceWritable RB UB DB CB TB cap) m4 m5 := hfCopy.mono (by intro addr ha; exact Or.inr ha)
  have hFull := Sem.seq_bound hSetup1 (fun z _ hz => by
    subst z
    exact Sem.seq_bound hSquareExact (fun z _ hz => by
      subst z
      exact Sem.seq_bound hModExact (fun z _ hz => by
        subst z
        exact Sem.seq_bound hSetup2 (fun z _ hz => by subst z; exact hCopy))))
  refine Sem.mono hFull ?_
  intro k z hQ
  refine ⟨by omega, m5, hQ.2, hr5, ht5, ?_, ?_, ?_, ?_⟩
  · exact (hmFinal 95 (by norm_num) (by norm_num)).trans hm95
  · exact (hmFinal 96 (by norm_num) (by norm_num)).trans hm96
  · exact (hmFinal 98 (by norm_num) (by norm_num)).trans hm98
  · exact MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans hf01 hf12) hf23) hf34) hf45

theorem PadeRows.traceCounter_update {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {E : RAMEnv} {RB UB DB CB L cap : ℕ}
    {m : ℕ → ℕ} {s : PadeState F} (h : PadeRows b E RB UB DB CB L cap m s) (n : ℕ) :
    PadeRows b E RB UB DB CB L cap (Function.update m 92 n) s := by
  apply h.of_scratchFrame (MemoryFrame.meta_update m 92 n (by norm_num))
  intro slot hs
  rw [Function.update_of_ne (by omega : slot ≠ 92)]

theorem traceLoopBody_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB TB L cap n k0 : ℕ) (f : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile traceLoopBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m (⟨traceRemainder a f k0, 0, f, 0⟩ : PadeState F))
    (hTB : 128 ≤ TB) (hTBword : TB + cap ≤ 2 ^ E.W)
    (hTR : TB + cap ≤ RB ∨ RB + cap ≤ TB) (hTU : TB + cap ≤ UB ∨ UB + cap ≤ TB)
    (hTD : TB + cap ≤ DB ∨ DB + cap ≤ TB) (hTC : TB + cap ≤ CB ∨ CB + cap ≤ TB)
    (htrace : PolynomialStored b m TB cap (traceRemainder a f k0)) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hn : n + 1 < 2 ^ E.W) (hm92 : m 92 = n + 1)
    (hm95 : m 95 = f.natDegree + 1) (hm96 : m 96 = enc b a) (hm98 : m 98 = TB) :
    Sem P E pc (pc + 512) (rankState pc m (n + 1))
      (fun k z => k ≤ 30 * cap + (48 * L + 187) * L + 256 ∧ ∃ m',
        z = rankState (pc + 512) m' n ∧ m' 92 = n ∧
        PadeRows b E RB UB DB CB L cap m' (⟨traceRemainder a f (k0 + 1), 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap (traceRemainder a f (k0 + 1)) ∧
        m' 95 = f.natDegree + 1 ∧ m' 96 = enc b a ∧ m' 98 = TB ∧
        MemoryFrame (traceLoopWritable RB UB DB CB TB cap) m m') := by
  obtain ⟨hZeroAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hStepAt, hTailAt⟩ := At.seqStmt hRestAt
  have hwidth : (92 : ℕ) < 2 ^ E.W := by
    have hp8 : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (92 : ℕ) < 2 ^ 8) hp8
  have hZero : Sem P E pc (pc + 16) (rankState pc m (n + 1))
      (fun k z => k ≤ 16 ∧ z = boundaryState (pc + 16) m) := by
    refine Sem.mono (Sem.block P E _ zeroRegsCode _ hZeroAt (by simp [zeroRegsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    refine ⟨by change k = 16 at hk; omega, ?_⟩
    rw [hz, zeroRegs_spec]
    rfl
  have hStep := traceStep_spec b ι t N P E (pc + 16) RB UB DB CB TB L cap (traceRemainder a f k0) f a m
    hStepAt hw hW hdet ht hL hcap hrows hTB hTBword hTR hTU hTD hTC htrace hFpos hF
    (traceRemainder_natDegree_lt a hFpos k0) hm95 hm96 hm98
  have hRest : Sem P E (pc + 16) (pc + 512) (boundaryState (pc + 16) m)
      (fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 213) + 27 ∧ ∃ m',
        z = rankState (pc + 512) m' n ∧ m' 92 = n ∧
        PadeRows b E RB UB DB CB L cap m' (⟨traceRemainder a f (k0 + 1), 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap (traceRemainder a f (k0 + 1)) ∧
        m' 95 = f.natDegree + 1 ∧ m' 96 = enc b a ∧ m' 98 = TB ∧
        MemoryFrame (traceLoopWritable RB UB DB CB TB cap) m m') := by
    refine Sem.seq_bound hStep ?_
    intro z hzpc hQ
    obtain ⟨m1, hz, hr, htr, h95, h96, h98, hf⟩ := hQ
    subst z
    have hnot : ¬ traceWritable RB UB DB CB TB cap 92 := by
      dsimp [traceWritable, padeWritable]
      have hR := hrows.layout.Rlow
      have hU := hrows.layout.Ulow
      have hD := hrows.layout.Dlow
      have hC := hrows.layout.Clow
      omega
    have h92 : m1 92 = n + 1 := (hf 92 hnot).trans hm92
    have hTailRun := countdown_spec E (boundaryState (pc + 485) m1) 92 n hwidth hn h92
    refine Sem.mono (Sem.block P E (pc + 485) (countdownCode 92) _ hTailAt
      (by simp [countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    refine ⟨by change k = 27 at hk; omega, Function.update m1 92 n, ?_, by simp, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hz, hTailRun]; rfl
    · exact hr.traceCounter_update n
    · exact htr.meta_update hTB 92 n (by norm_num)
    · simpa using h95
    · simpa using h96
    · simpa using h98
    · exact MemoryFrame.trans (hf.mono (by intro addr ha; exact Or.inr ha))
        (MemoryFrame.update_allowed _ m1 92 n (Or.inl rfl))
  have hFull := Sem.seq_bound hZero (fun z _ hz => by subst z; exact hRest)
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem traceLoop_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB TB L cap n0 : ℕ) (f : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile traceLoopStmt pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m (⟨0, 0, f, 0⟩ : PadeState F))
    (hTB : 128 ≤ TB) (hTBword : TB + cap ≤ 2 ^ E.W)
    (hTR : TB + cap ≤ RB ∨ RB + cap ≤ TB) (hTU : TB + cap ≤ UB ∨ UB + cap ≤ TB)
    (hTD : TB + cap ≤ DB ∨ DB + cap ≤ TB) (hTC : TB + cap ≤ CB ∨ CB + cap ≤ TB)
    (htrace : PolynomialStored b m TB cap 0) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hn0 : n0 < 2 ^ E.W) (hm92 : m 92 = n0)
    (hm95 : m 95 = f.natDegree + 1) (hm96 : m 96 = enc b a) (hm98 : m 98 = TB) :
    Sem P E pc (pc + 514) (rankState pc m n0)
      (fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 258) * n0 + 1 ∧
        z.regs = (fun _ => 0) ∧ z.mem 92 = 0 ∧
        PadeRows b E RB UB DB CB L cap z.mem (⟨traceRemainder a f n0, 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b z.mem TB cap (traceRemainder a f n0) ∧
        z.mem 95 = f.natDegree + 1 ∧ z.mem 96 = enc b a ∧ z.mem 98 = TB ∧
        MemoryFrame (traceLoopWritable RB UB DB CB TB cap) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ n0 ∧ z.regs = Function.update (fun _ => 0) r9 n ∧ z.mem 92 = n ∧
    z.mem 95 = f.natDegree + 1 ∧ z.mem 96 = enc b a ∧ z.mem 98 = TB ∧
    PadeRows b E RB UB DB CB L cap z.mem (⟨traceRemainder a f (n0 - n), 0, f, 0⟩ : PadeState F) ∧
    PolynomialStored b z.mem TB cap (traceRemainder a f (n0 - n)) ∧
    MemoryFrame (traceLoopWritable RB UB DB CB TB cap) m z.mem
  have hW1 : 1 < 2 ^ E.W := by have h := hrows.Rword; have h' := hrows.layout.Rlow; omega
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by
    intro n z pc' h
    simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by
    intro n z h
    rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 }
        (fun k z' => k ≤ 30 * cap + (48 * L + 187) * L + 257 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, h92, h95, h96, h98, hr, htr, hf⟩ := hI
    have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (n + 1) := by
      apply ramState_eq_of
      · rfl
      · rfl
      · intro r; exact congrFun hregs r
    rw [hz]
    have hrun := traceLoopBody_spec b ι t N P E (pc + 1) RB UB DB CB TB L cap n (n0 - (n + 1)) f a z.mem
      hBodyAt hw hW hdet ht hL hcap hr hTB hTBword hTR hTU hTD hTC htr hFpos hF (by omega) h92 h95 h96 h98
    refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
    intro k z' hQ
    obtain ⟨hk, m', hz', h92', hr', htr', h95', h96', h98', hf'⟩ := hQ
    have hidx : n0 - (n + 1) + 1 = n0 - n := by omega
    refine ⟨by omega, by omega, ?_⟩
    rw [hz']
    refine ⟨rfl, h92', h95', h96', h98', ?_, ?_, MemoryFrame.trans hf hf'⟩
    · simpa only [hidx, rankState, boundaryState] using hr'
    · simpa only [hidx, rankState, boundaryState] using htr'
  have hinit : I n0 (rankState pc m n0) := by
    refine ⟨le_rfl, rfl, hm92, hm95, hm96, hm98, ?_, ?_, ?_⟩
    · simpa only [Nat.sub_self, traceRemainder, rankState, boundaryState] using hrows
    · simpa only [Nat.sub_self, traceRemainder, rankState, boundaryState] using htrace
    · intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc traceLoopBody hAt hW1 I
    (30 * cap + (48 * L + 187) * L + 257) hframe hcounter hbody n0 (rankState pc m n0) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, h92, h95, h96, h98, hr, htr, hf⟩ := hQ
  refine ⟨hk, ?_, h92, ?_, ?_, h95, h96, h98, hf⟩
  · rw [hregs]
    funext r
    simp [Function.update_apply]
  · simpa only [Nat.sub_zero] using hr
  · simpa only [Nat.sub_zero] using htr

/-- Callable modular trace.  Use n0=w for a basis splitter; the whole
calculation stays in the fixed low-degree buffers. -/
theorem traceProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc RB UB DB CB TB L cap n0 : ℕ) (f : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile traceProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hrows : PadeRows b E RB UB DB CB L cap m (⟨0, 0, f, 0⟩ : PadeState F))
    (hTB : 128 ≤ TB) (hTBword : TB + cap ≤ 2 ^ E.W)
    (hTR : TB + cap ≤ RB ∨ RB + cap ≤ TB) (hTU : TB + cap ≤ UB ∨ UB + cap ≤ TB)
    (hTD : TB + cap ≤ DB ∨ DB + cap ≤ TB) (hTC : TB + cap ≤ CB ∨ CB + cap ≤ TB)
    (htrace : PolynomialStored b m TB cap 0) (hFpos : 0 < f.natDegree) (hF : f.natDegree ≤ t)
    (hn0 : n0 < 2 ^ E.W) (hm92 : m 92 = n0)
    (hm95 : m 95 = f.natDegree + 1) (hm96 : m 96 = enc b a) (hm98 : m 98 = TB) :
    Sem P E pc (pc + 517) (boundaryState pc m)
      (fun k z => k ≤ (30 * cap + (48 * L + 187) * L + 258) * n0 + 4 ∧ ∃ m',
        z = boundaryState (pc + 517) m' ∧
        PadeRows b E RB UB DB CB L cap m' (⟨traceRemainder a f n0, 0, f, 0⟩ : PadeState F) ∧
        PolynomialStored b m' TB cap (traceRemainder a f n0) ∧
        m' 92 = 0 ∧ m' 95 = f.natDegree + 1 ∧ m' 96 = enc b a ∧ m' 98 = TB ∧
        MemoryFrame (traceLoopWritable RB UB DB CB TB cap) m m') := by
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hwidth : (92 : ℕ) < 2 ^ E.W := by
    have hp8 : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (92 : ℕ) < 2 ^ 8) hp8
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m n0) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 92) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 3 at hk; omega, hz.trans (rankReadSlot_spec E pc m 92 n0 hwidth hn0 hm92)⟩
  have hLoop := traceLoop_spec b ι t N P E (pc + 3) RB UB DB CB TB L cap n0 f a m hLoopAt hw hW hdet
    ht hL hcap hrows hTB hTBword hTR hTU hTD hTC htrace hFpos hF hn0 hm92 hm95 hm96 hm98
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, h92, hr, htr, h95, h96, h98, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, hr, htr, h92, h95, h96, h98, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r
    simpa only [boundaryState] using congrFun hregs r

theorem mem_keepFactor {F : Type} [Field F] (g f : F[X]) :
    g ∈ keepFactor f ↔ g = f ∧ f.natDegree ≠ 0 := by
  by_cases h : f.natDegree = 0 <;> simp [keepFactor, h]

theorem traceRootSearch_constant {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (as : List F) (f : F[X]) (h : f.natDegree = 0) : traceRootSearch w as f = [] := by
  cases as <;> simp [traceRootSearch, h]

theorem rootForest_cons {F : Type} [Field F] [DecidableEq F] (w : ℕ) (as : List F) (f : F[X]) (fs : List F[X]) :
    rootForest w as (f :: fs) = traceRootSearch w as f ++ rootForest w as fs := by
  simp [rootForest]

theorem rootForest_append {F : Type} [Field F] [DecidableEq F] (w : ℕ) (as : List F) (fs gs : List F[X]) :
    rootForest w as (fs ++ gs) = rootForest w as fs ++ rootForest w as gs := by
  simp [rootForest]

theorem rootForest_keep {F : Type} [Field F] [DecidableEq F] (w : ℕ) (as : List F) (f : F[X]) :
    rootForest w as (keepFactor f) = traceRootSearch w as f := by
  by_cases h : f.natDegree = 0
  · simp [keepFactor, h, rootForest, traceRootSearch_constant w as f h]
  · simp [keepFactor, h, rootForest]

/-- Breadth-first factor splitting preserves the exact recursive root list,
including its order, for arbitrary non-decodable input polynomials. -/
theorem rootForest_split {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (as : List F) (fs : List F[X]) :
    rootForest w as (splitFrontier w a fs) = rootForest w (a :: as) fs := by
  induction fs with
  | nil => simp [splitFrontier, rootForest]
  | cons f fs ih =>
      by_cases h : f.natDegree = 0
      · rw [splitFrontier, if_pos h, ih, rootForest_cons, traceRootSearch, if_pos h, List.nil_append]
      · rw [splitFrontier, if_neg h, rootForest_append, rootForest_append,
          rootForest_keep, rootForest_keep, ih, rootForest_cons, traceRootSearch, if_neg h]

theorem frontierMass_append {F : Type} [Field F] (fs gs : List F[X]) :
    frontierMass (fs ++ gs) = frontierMass fs + frontierMass gs := by
  induction fs with
  | nil => simp [frontierMass]
  | cons f fs ih => simp [frontierMass, ih, Nat.add_assoc]

theorem frontierMass_keep {F : Type} [Field F] (f : F[X]) : frontierMass (keepFactor f) = f.natDegree := by
  by_cases h : f.natDegree = 0 <;> simp [keepFactor, h, frontierMass]

theorem splitFrontier_positive {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (fs : List F[X]) : ∀ g ∈ splitFrontier w a fs, 0 < g.natDegree := by
  induction fs with
  | nil => simp [splitFrontier]
  | cons f fs ih =>
      intro g hg
      by_cases h : f.natDegree = 0
      · rw [splitFrontier, if_pos h] at hg
        exact ih g hg
      · rw [splitFrontier, if_neg h] at hg
        rcases List.mem_append.mp hg with hleft | htail
        · rcases List.mem_append.mp hleft with h0 | h1
          · obtain ⟨heq, hne⟩ := (mem_keepFactor g _).mp h0
            simpa only [heq] using Nat.pos_of_ne_zero hne
          · obtain ⟨heq, hne⟩ := (mem_keepFactor g _).mp h1
            simpa only [heq] using Nat.pos_of_ne_zero hne
        · exact ih g htail

theorem splitFrontier_mass_le {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (fs : List F[X]) (hfs : ∀ f ∈ fs, f ≠ 0) :
    frontierMass (splitFrontier w a fs) ≤ frontierMass fs := by
  induction fs with
  | nil => simp [splitFrontier, frontierMass]
  | cons f fs ih =>
      have hf : f ≠ 0 := hfs f (by simp)
      have htail := ih (fun g hg => hfs g (by simp [hg]))
      by_cases h : f.natDegree = 0
      · rw [splitFrontier, if_pos h]
        simp only [frontierMass, h, zero_add]
        exact htail
      · rw [splitFrontier, if_neg h, frontierMass_append, frontierMass_append, frontierMass_keep, frontierMass_keep]
        have hbudget := split_degree_budget f (traceRemainder a f w) hf
        change _ ≤ f.natDegree + frontierMass fs
        omega

theorem frontier_length_le_mass {F : Type} [Field F] (fs : List F[X])
    (hfs : ∀ f ∈ fs, 0 < f.natDegree) : fs.length ≤ frontierMass fs := by
  induction fs with
  | nil => simp [frontierMass]
  | cons f fs ih =>
      have hf := hfs f (by simp)
      have ht := ih (fun g hg => hfs g (by simp [hg]))
      simp only [List.length_cons, frontierMass]
      omega

theorem enc_basis {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (j : Fin w) : enc b (b j) = 2 ^ (j : ℕ) := by
  classical
  simp only [enc, b.repr_self, Finsupp.single_apply]
  rw [Finset.sum_eq_single j]
  · norm_num <;> decide
  · intro k _ hk
    simp [Ne.symm hk]
  · simp

theorem detStd_pos {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (t N : ℕ) (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) {a : ℕ} (ha : a < 2 ^ w) :
    detStd t N b ι (detPosBase w + a) = posTab N ι (dec b a) := by
  have hm : detMulBase w = 64 := rfl
  have hs : detSqBase w = 64 + 2 ^ (2 * w) := rfl
  have hi : detInvBase w = 64 + 2 ^ (2 * w) + 2 ^ (2 * w) := rfl
  have hp : detPosBase w = detInvBase w + 2 ^ w := rfl
  have hg : detImgBase w = detPosBase w + 2 ^ w := rfl
  have hpow := Nat.two_pow_pos (2 * w)
  have h0 : ¬ detPosBase w + a < 13 := by omega
  have h1 : ¬ detPosBase w + a < detMulBase w := by omega
  have h2 : ¬ detPosBase w + a < detSqBase w := by omega
  have h3 : ¬ detPosBase w + a < detInvBase w := by omega
  have h4 : ¬ detPosBase w + a < detPosBase w := by omega
  have h5 : detPosBase w + a < detImgBase w := by omega
  unfold detStd
  rw [if_neg h0, if_neg h1, if_neg h2, if_neg h3, if_neg h4, if_pos h5, Nat.add_sub_cancel_left]

theorem basisScalar_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (j : Fin w)
    (hmeta : (96 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hm88 : s.mem 88 = (j : ℕ)) :
    runBlock basisScalarCode E s = boundaryState (s.pc + 24) (Function.update s.mem 96 (enc b (b j))) := by
  have hsmall : ∀ i ≤ 96, i % 2 ^ E.W = i := by
    intro i hi
    exact Nat.mod_eq_of_lt (by omega)
  have hjWord : (j : ℕ) % 2 ^ E.W = j :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le j.isLt (le_trans hwe (Nat.le_of_lt (Nat.lt_two_pow_self (n := E.W)))))
  have hpow : (2 : ℕ) ^ (j : ℕ) < 2 ^ E.W := Nat.pow_lt_pow_right (by norm_num) (lt_of_lt_of_le j.isLt hwe)
  rw [basisScalarCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc basisScalarCode E s (by
      simp [basisScalarCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [basisScalarCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 24 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm88, hjWord, Nat.mod_eq_of_lt hpow, enc_basis, boundaryState]
  · intro _; rfl

theorem degreeBranch_spec (P : Program) (E : RAMEnv) (pc : ℕ) (body : Stmt)
    (m : ℕ → ℕ) (d B : ℕ) (Q : (ℕ → ℕ) → Prop)
    (hAt : At P pc (Stmt.compile (degreeBranch body) pc))
    (hmeta : (95 : ℕ) < 2 ^ E.W) (hd : d < 2 ^ E.W) (hm95 : m 95 = d)
    (hcall : 1 < d → ∀ base, At P base (Stmt.compile body base) →
      Sem P E base (base + body.len) (boundaryState base m)
        (fun k z => k ≤ B ∧ z.regs = (fun _ => 0) ∧ Q z.mem))
    (hstop : ¬ 1 < d → Q m) :
    Sem P E pc (pc + (degreeBranch body).len) (boundaryState pc m)
      (fun k z => k ≤ B + 23 ∧ z.regs = (fun _ => 0) ∧ Q z.mem) := by
  obtain ⟨hLoadAt, hIfAt⟩ := At.seqStmt hAt
  obtain ⟨_, _, hTrueAt, _, hFalseAt, _⟩ := at_ite hIfAt
  obtain ⟨hZeroAt, hBodyAt⟩ := At.seqStmt hTrueAt
  have hLoad : Sem P E pc (pc + 4) (boundaryState pc m)
      (fun k z => k ≤ 4 ∧ z = padeTestState (pc + 4) m 1 d) := by
    refine Sem.mono (Sem.block P E pc gcdTestLoadCode _ hLoadAt
      (by simp [gcdTestLoadCode, metaReadCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 4 at hk; omega, hz.trans (gcdTestLoad_spec E pc m d hmeta hd hm95)⟩
  let c : Cond := .lt r15 r0 r1
  let a := pc + 4
  let z0 := padeTestState a m 1 d
  let endpc := a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + (Stmt.code zeroRegsCode).len + 3
  have hIf : Sem P E a endpc z0
      (fun k z => k ≤ B + 19 ∧ z.regs = (fun _ => 0) ∧ Q z.mem) := by
    apply Sem.ite P E a c (Stmt.seq (Stmt.code zeroRegsCode) body) (Stmt.code zeroRegsCode) z0 _ hIfAt (by omega) rfl
    · intro hgo
      have hg : 1 < d := hgo
      have hZero := Sem.zero_block P E (a + 2) { runBlock c.code E z0 with pc := a + 2 } hZeroAt rfl
      have hBody := hcall hg (a + 18) hBodyAt
      have hTrue := Sem.seq_bound hZero (fun z _ hz => by subst z; exact hBody)
      have htend : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len = a + 18 + body.len := by
        simp only [c, Cond.code, Stmt.len, zeroRegsCode, List.length_cons, List.length_nil]
        omega
      rw [htend]
      refine Sem.mono hTrue ?_
      intro k z hQ
      exact ⟨by change 1 + 1 + k + 1 ≤ B + 19; omega, hQ.2.1, hQ.2.2⟩
    · intro hno
      have hng : ¬ 1 < d := hno
      have hFalseAt' : At P (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2) zeroRegsCode := by
        have hh : At P (a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1) zeroRegsCode := hFalseAt
        have heq : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1 =
            a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2 := by omega
        rw [heq] at hh
        exact hh
      have hZero := Sem.zero_block P E (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2)
        { runBlock c.code E z0 with pc := a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2 } hFalseAt' rfl
      have hfend : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1 + (Stmt.code zeroRegsCode).len =
          (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2) + 16 := by
        simp only [Stmt.len, zeroRegsCode, List.length_cons, List.length_nil]
        omega
      rw [hfend]
      refine Sem.mono hZero ?_
      intro k z hQ
      obtain ⟨hk, hz⟩ := hQ
      refine ⟨by change 1 + 1 + k + 1 ≤ B + 19; omega, ?_, ?_⟩
      · rw [hz]; rfl
      · rw [hz]
        exact hstop hng
  have hFull := Sem.seq_bound hLoad (fun z _ hz => by subst z; exact hIf)
  have hpc : endpc = pc + (degreeBranch body).len := by
    simp only [endpc, a, c, degreeBranch, Stmt.len, Cond.code, List.length_singleton, gcdTestLoadCode,
      metaReadCode, List.length_append, List.length_cons, List.length_nil]
    omega
  rw [hpc] at hFull
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem queue_slot_before_next (B cap n j i : ℕ) (hj : j < n) (hi : i < cap) :
    B + j * cap + i < B + n * cap := by
  have hm : (j + 1) * cap ≤ n * cap := Nat.mul_le_mul_right cap (by omega)
  have he : (j + 1) * cap = j * cap + cap := by ring
  omega

theorem FrontierStored.array_arguments {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m : ℕ → ℕ} {B cap : ℕ} {fs : List F[X]}
    (h : FrontierStored b m B cap fs) (hB : 128 ≤ B) (dst src len : ℕ) :
    FrontierStored b (arrayArguments m dst src len) B cap fs := by
  intro j hj i hi
  rw [arrayArguments_frame m dst src len (B + j * cap + i) (by omega)]
  exact h j hj i hi

theorem FrontierStored.meta_update {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m : ℕ → ℕ} {B cap : ℕ} {fs : List F[X]}
    (h : FrontierStored b m B cap fs) (hB : 128 ≤ B) (slot value : ℕ) (hs : slot < 128) :
    FrontierStored b (Function.update m slot value) B cap fs := by
  intro j hj
  exact (h j hj).meta_update (by omega) slot value hs

/-- Copying one coefficient array into the next queue slot appends exactly
one polynomial and preserves all preceding factors. -/
theorem FrontierStored.append_copy {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m : ℕ → ℕ} {B cap src : ℕ} {fs : List F[X]} {f : F[X]}
    (h : FrontierStored b m B cap fs) (hf : PolynomialStored b m src cap f) :
    FrontierStored b (writeArray (B + fs.length * cap) m (fun i => m (src + i)) cap) B cap (fs ++ [f]) := by
  intro j hj
  by_cases hjold : j < fs.length
  · rw [List.getD_append fs [f] 0 j hjold]
    intro i hi
    rw [writeArray_frame _ _ _ _ _ (Or.inl (queue_slot_before_next B cap fs.length j i hjold hi))]
    exact h j hjold i hi
  · have hjlast : j = fs.length := by simp only [List.length_append, List.length_singleton] at hj; omega
    subst j
    rw [List.getD_append_right fs [f] 0 fs.length le_rfl, Nat.sub_self]
    intro i hi
    rw [writeArray_get _ _ _ cap i hi]
    exact hf i hi

theorem queueAppendArgs_spec (E : RAMEnv) (s : RAMState) (B n cap src : ℕ)
    (hmeta : (97 : ℕ) < 2 ^ E.W) (hB : B < 2 ^ E.W) (hn : n < 2 ^ E.W)
    (hnc : n * cap < 2 ^ E.W) (hdst : B + n * cap < 2 ^ E.W)
    (hc : cap < 2 ^ E.W) (hsrc : src < 2 ^ E.W)
    (hm84 : s.mem 84 = B) (hm90 : s.mem 90 = n) (hm81 : s.mem 81 = cap) (hm97 : s.mem 97 = src) :
    runBlock queueAppendArgsCode E s = boundaryState (s.pc + 39) (arrayArguments s.mem (B + n * cap) src cap) := by
  have hsmall : ∀ i ≤ 97, i % 2 ^ E.W = i := by
    intro i hi
    exact Nat.mod_eq_of_lt (by omega)
  rw [queueAppendArgsCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc queueAppendArgsCode E s (by
      simp [queueAppendArgsCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [queueAppendArgsCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 39 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil,
      execInstr, arrayArguments, hsmall, hm84, hm90, hm81, hm97,
      Nat.mod_eq_of_lt hB, Nat.mod_eq_of_lt hn, Nat.mod_eq_of_lt hnc,
      Nat.mod_eq_of_lt hdst, Nat.mod_eq_of_lt hc, Nat.mod_eq_of_lt hsrc, boundaryState]
  · intro _; rfl

theorem queueIncrement_spec (E : RAMEnv) (s : RAMState) (n : ℕ)
    (hmeta : (90 : ℕ) < 2 ^ E.W) (hn : n + 1 < 2 ^ E.W) (hm90 : s.mem 90 = n) :
    runBlock queueIncrementCode E s = boundaryState (s.pc + 24) (Function.update s.mem 90 (n + 1)) := by
  have h90 : (90 : ℕ) % 2 ^ E.W = 90 := Nat.mod_eq_of_lt hmeta
  have h1 : (1 : ℕ) % 2 ^ E.W = 1 := Nat.mod_eq_of_lt (by omega)
  rw [queueIncrementCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc queueIncrementCode E s (by
      simp [queueIncrementCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [queueIncrementCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 24 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil,
      execInstr, h90, h1, hm90, Nat.mod_eq_of_lt (show n < 2 ^ E.W by omega),
      Nat.mod_eq_of_lt hn, boundaryState]
  · intro _; rfl

theorem queueAppendProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv) (pc B src cap T : ℕ)
    (fs : List F[X]) (f : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile queueAppendProcedure pc))
    (hmeta : (97 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hcap : 1 ≤ cap)
    (hB : 128 ≤ B) (hsrc : 128 ≤ src) (hQword : B + T * cap ≤ 2 ^ E.W) (hSword : src + cap ≤ 2 ^ E.W)
    (hcount : fs.length < T) (hdisj : src + cap ≤ B ∨ B + T * cap ≤ src)
    (hq : FrontierStored b m B cap fs) (hf : PolynomialStored b m src cap f)
    (hm84 : m 84 = B) (hm90 : m 90 = fs.length) (hm81 : m 81 = cap) (hm97 : m 97 = src) :
    Sem P E pc (pc + 99) (boundaryState pc m)
      (fun k z => k ≤ 12 * cap + 89 ∧ ∃ m', z = boundaryState (pc + 99) m' ∧
        m' 90 = fs.length + 1 ∧ FrontierStored b m' B cap (fs ++ [f]) ∧
        MemoryFrame (queueAppendWritable B fs.length cap) m m') := by
  let dst := B + fs.length * cap
  let m1 := arrayArguments m dst src cap
  let m2 := writeArray dst m1 (fun i => m1 (src + i)) cap
  let m3 := Function.update m2 90 (fs.length + 1)
  have hmul : (fs.length + 1) * cap ≤ T * cap := Nat.mul_le_mul_right cap (by omega)
  have hmul' : (fs.length + 1) * cap = fs.length * cap + cap := by ring
  have hdst : dst + cap ≤ 2 ^ E.W := by dsimp [dst]; omega
  have hdstWord : dst < 2 ^ E.W := by omega
  have hcapWord : cap < 2 ^ E.W := by omega
  have hnWord : fs.length + 1 < 2 ^ E.W := by
    have hm : fs.length + 1 ≤ (fs.length + 1) * cap := by
      simpa only [Nat.mul_one] using Nat.mul_le_mul_left (fs.length + 1) hcap
    omega
  have hsrcWord : src < 2 ^ E.W := by omega
  have hq1 := hq.array_arguments hB dst src cap
  have hf1 : PolynomialStored b m1 src cap f := by
    intro i hi
    change arrayArguments m dst src cap (src + i) = enc b (f.coeff i)
    rw [arrayArguments_frame m dst src cap (src + i) (by omega)]
    exact hf i hi
  have hq2 := hq1.append_copy hf1
  have hq3 : FrontierStored b m3 B cap (fs ++ [f]) := hq2.meta_update hB 90 (fs.length + 1) (by norm_num)
  have hm2meta (slot : ℕ) (hlo : 72 ≤ slot) (hhi : slot < 128) : m2 slot = m slot := by
    change writeArray dst m1 (fun i => m1 (src + i)) cap slot = m slot
    rw [writeArray_frame dst m1 _ cap slot (by dsimp [dst]; omega)]
    exact arrayArguments_frame m dst src cap slot (by omega)
  obtain ⟨hArgsAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hCopyAt, hIncAt⟩ := At.seqStmt hRestAt
  have hArgs : Sem P E pc (pc + 39) (boundaryState pc m)
      (fun k z => k ≤ 39 ∧ z = boundaryState (pc + 39) m1) := by
    exact Sem.boundary_block P E _ queueAppendArgsCode m m1 hArgsAt
      (by simp [queueAppendArgsCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (queueAppendArgs_spec E _ B fs.length cap src hmeta (by omega) (by omega)
        (by dsimp [dst] at hdstWord; omega) hdstWord hcapWord hsrcWord hm84 hm90 hm81 hm97)
  have hCopy := copyProcedure_spec P E (pc + 39) dst src cap m1 hCopyAt (by omega) hdstWord hsrcWord hcapWord
    hdst hSword (by dsimp [dst]; omega)
    (fun i hi => by
      have hv : m1 (src + i) = enc b (f.coeff i) := hf1 i hi
      rw [hv]
      exact lt_of_lt_of_le (enc_lt b _) (Nat.pow_le_pow_right (by norm_num) hwe))
    (by simp [m1, arrayArguments]) (by simp [m1, arrayArguments]) (by simp [m1, arrayArguments])
  have hInc : Sem P E (pc + 75) (pc + 99) (boundaryState (pc + 75) m2)
      (fun k z => k ≤ 24 ∧ z = boundaryState (pc + 99) m3) := by
    exact Sem.boundary_block P E _ queueIncrementCode m2 m3 hIncAt
      (by simp [queueIncrementCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (queueIncrement_spec E _ fs.length (by omega) hnWord (by
        change m2 90 = fs.length
        rw [hm2meta 90 (by norm_num) (by norm_num)]; exact hm90))
  have hFull := Sem.seq_bound hArgs (fun z _ hz => by
    subst z
    exact Sem.seq_bound hCopy (fun z _ hz => by subst z; exact hInc))
  refine Sem.mono hFull ?_
  intro k z hQ
  refine ⟨by omega, m3, hQ.2, by simp [m3], hq3, ?_⟩
  have hf01 : MemoryFrame (queueAppendWritable B fs.length cap) m m1 := (arrayArguments_frame m dst src cap).mono (by
    intro addr ha
    dsimp [queueAppendWritable]
    omega)
  have hf12 : MemoryFrame (queueAppendWritable B fs.length cap) m1 m2 := by
    intro addr ha
    apply writeArray_frame dst m1 _ cap addr
    dsimp [queueAppendWritable, dst] at ha ⊢
    omega
  exact MemoryFrame.trans (MemoryFrame.trans hf01 hf12)
    (MemoryFrame.update_allowed _ m2 90 (fs.length + 1) (by simp [queueAppendWritable]))

theorem queueKeepProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv) (pc B src cap T : ℕ)
    (fs : List F[X]) (f : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile queueKeepProcedure pc))
    (hmeta : (97 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hcap : 1 ≤ cap)
    (hB : 128 ≤ B) (hsrc : 128 ≤ src) (hQword : B + T * cap ≤ 2 ^ E.W) (hSword : src + cap ≤ 2 ^ E.W)
    (hcount : 0 < f.natDegree → fs.length < T) (hdisj : src + cap ≤ B ∨ B + T * cap ≤ src)
    (hq : FrontierStored b m B cap fs) (hf : PolynomialStored b m src cap f) (hdeg : f.natDegree < cap)
    (hm84 : m 84 = B) (hm90 : m 90 = fs.length) (hm81 : m 81 = cap) (hm97 : m 97 = src) :
    Sem P E pc (pc + 209) (boundaryState pc m)
      (fun k z => k ≤ 29 * cap + 167 ∧ z.regs = (fun _ => 0) ∧
        z.mem 90 = (fs ++ keepFactor f).length ∧ FrontierStored b z.mem B cap (fs ++ keepFactor f) ∧
        MemoryFrame (queueKeepWritable B fs.length cap f.natDegree) m z.mem) := by
  let m1 := Function.update (Function.update m 64 src) 66 cap
  let m2 := Function.update m1 95 (degreeScan f cap)
  have hcapWord : cap < 2 ^ E.W := by omega
  have hsrcWord : src < 2 ^ E.W := by omega
  have hm1meta (slot : ℕ) (hlo : 72 ≤ slot) : m1 slot = m slot := by simp [m1, show slot ≠ 64 by omega, show slot ≠ 66 by omega]
  have hm2meta (slot : ℕ) (hlo : 72 ≤ slot) (hne : slot ≠ 95) : m2 slot = m slot := by
    change Function.update m1 95 (degreeScan f cap) slot = m slot
    rw [Function.update_of_ne hne, hm1meta slot hlo]
  have hq1 := (hq.meta_update hB 64 src (by norm_num)).meta_update hB 66 cap (by norm_num)
  have hq2 := hq1.meta_update hB 95 (degreeScan f cap) (by norm_num)
  have hf1 := (hf.meta_update hsrc 64 src (by norm_num)).meta_update hsrc 66 cap (by norm_num)
  have hf2 : PolynomialStored b m2 src cap f := hf1.meta_update hsrc 95 (degreeScan f cap) (by norm_num)
  let Q := fun m' => m' 90 = (fs ++ keepFactor f).length ∧ FrontierStored b m' B cap (fs ++ keepFactor f) ∧
    MemoryFrame (queueKeepWritable B fs.length cap f.natDegree) m m'
  have hf01 : MemoryFrame (queueKeepWritable B fs.length cap f.natDegree) m m1 :=
    MemoryFrame.trans (MemoryFrame.update_allowed _ m 64 src (by simp [queueKeepWritable, queueAppendWritable]))
      (MemoryFrame.update_allowed _ _ 66 cap (by simp [queueKeepWritable, queueAppendWritable]))
  have hf02 : MemoryFrame (queueKeepWritable B fs.length cap f.natDegree) m m2 :=
    MemoryFrame.trans hf01 (MemoryFrame.update_allowed _ m1 95 _ (Or.inl rfl))
  obtain ⟨hSetupAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hScanAt, hKeepAt⟩ := At.seqStmt hRestAt
  have hSetup : Sem P E pc (pc + 28) (boundaryState pc m)
      (fun k z => k ≤ 28 ∧ z = boundaryState (pc + 28) m1) := by
    exact Sem.boundary_block P E _ (scanSetupCode 97) m m1 hSetupAt
      (by simp [scanSetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (scanSetup_spec E _ 97 src cap (by omega) hmeta hsrcWord hcapWord hm97 hm81)
  have hScan := scanProcedure_spec b P E (pc + 28) src cap f m1 hScanAt (by omega) hwe
    hsrcWord hcapWord hSword hf1 (by simp [m1]) (by simp [m1])
  have hBranch := degreeBranch_spec P E (pc + 70) queueAppendProcedure m2 (degreeScan f cap)
    (12 * cap + 89) Q hKeepAt (by omega)
    (lt_of_le_of_lt (degreeScan_le _ _) hcapWord) (by simp [m2])
    (by
      intro hpos base hBodyAt
      have hfpos : 0 < f.natDegree := by
        have h := (padeScan_go 1 cap f le_rfl hdeg).mp hpos
        omega
      have hAppend := queueAppendProcedure_spec b P E base B src cap T fs f m2 hBodyAt hmeta hwe hcap
        hB hsrc hQword hSword (hcount hfpos) hdisj hq2 hf2
        ((hm2meta 84 (by norm_num) (by norm_num)).trans hm84)
        ((hm2meta 90 (by norm_num) (by norm_num)).trans hm90)
        ((hm2meta 81 (by norm_num) (by norm_num)).trans hm81)
        ((hm2meta 97 (by norm_num) (by norm_num)).trans hm97)
      refine Sem.mono hAppend ?_
      intro k z hPost
      obtain ⟨hk, m3, hz, h90, hq3, hf23⟩ := hPost
      refine ⟨hk, ?_, ?_⟩
      · rw [hz]; rfl
      · change Q z.mem
        rw [hz]
        change Q m3
        have hkeep : keepFactor f = [f] := by simp [keepFactor, Nat.ne_of_gt hfpos]
        dsimp only [Q]
        rw [hkeep]
        refine ⟨?_, hq3, MemoryFrame.trans hf02 (hf23.mono (by
          intro addr ha
          dsimp [queueKeepWritable, queueAppendWritable] at *
          omega))⟩
        simpa using h90)
    (by
      intro hstop
      have hdeg0 : f.natDegree = 0 := by
        have h := (not_congr (padeScan_go 1 cap f le_rfl hdeg)).mp hstop
        omega
      have hkeep : keepFactor f = [] := by simp [keepFactor, hdeg0]
      dsimp only [Q]
      rw [hkeep, List.append_nil]
      exact ⟨(hm2meta 90 (by norm_num) (by norm_num)).trans hm90, hq2, hf02⟩)
  have hFull := Sem.seq_bound hSetup (fun z _ hz => by
    subst z
    exact Sem.seq_bound hScan (fun z _ hz => by subst z; exact hBranch))
  refine Sem.mono hFull ?_
  intro k z hQ
  exact ⟨by omega, hQ.2.1, hQ.2.2⟩

theorem resetRootRows_spec (E : RAMEnv) (s : RAMState) (RB UB DB CB : ℕ)
    (hmeta : (105 : ℕ) < 2 ^ E.W)
    (hR : RB < 2 ^ E.W) (hU : UB < 2 ^ E.W) (hD : DB < 2 ^ E.W) (hC : CB < 2 ^ E.W)
    (hm102 : s.mem 102 = RB) (hm104 : s.mem 104 = UB) (hm103 : s.mem 103 = DB) (hm105 : s.mem 105 = CB) :
    runBlock resetRootRowsCode E s = boundaryState (s.pc + 40)
      (Function.update (Function.update (Function.update (Function.update s.mem 72 RB) 73 UB) 74 DB) 75 CB) := by
  have hsmall : ∀ i ≤ 105, i % 2 ^ E.W = i := by
    intro i hi
    exact Nat.mod_eq_of_lt (by omega)
  rw [resetRootRowsCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc resetRootRowsCode E s (by
      simp [resetRootRowsCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [resetRootRowsCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 40 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, hsmall, hm102, hm104, hm103, hm105,
      Nat.mod_eq_of_lt hR, Nat.mod_eq_of_lt hU, Nat.mod_eq_of_lt hD, Nat.mod_eq_of_lt hC, boundaryState]
  · intro _; rfl

