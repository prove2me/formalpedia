-- title:
--   Theorem 3.2, p. 5 — every run of the projected reflected gradient method converges weakly to a solution of the monotone VI
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ closed and convex, and $F:H\to H$ a mapping such that
--
--   1. (C1) the solution set $S$ of the variational inequality $\langle F(x^*),x-x^*\rangle\ge0$ for all $x\in C$ is nonempty;
--   2. (C2) $F$ is monotone on $H$;
--   3. (C3) $F$ is Lipschitz continuous on $H$ with a constant $L>0$.
--
--   Let $0<\lambda<(\sqrt2-1)/L$ and let $(x_n),(y_n)$ be generated by the projected reflected gradient method (Algorithm 3.1): $x_0=y_0\in H$ arbitrary and
--   $$x_{n+1}=P_C\big(x_n-\lambda F(y_n)\big),\qquad y_{n+1}=2x_{n+1}-x_n .$$
--   Then there is $x^*\in S$ with
--   $$x_n\rightharpoonup x^*\qquad(n\to\infty).$$
--
--   This is the main convergence result of the paper: the method needs one projection and one evaluation of $F$ per iteration, and still converges under the same assumptions as the extragradient method.
--
--   **Formalization Note.** Weak convergence is stated as $\langle x_n,v\rangle\to\langle x^*,v\rangle$ for every $v\in H$. The run predicate has no stopping rule (a stopped run continues as a constant sequence). $x_0$ is not required to lie in $C$.
-- source:
--   Malitsky, Projected Reflected Gradient Methods for Monotone Variational Inequalities, arXiv:1502.04968v1, p. 5, Theorem 3.2

import Mathlib
import Definitions.Def_ProjReflGrad_Weak_Setting

namespace ProjReflGrad.Weak

/-- Theorem 3.2 (Malitsky 2015, p. 5): under (C1)–(C3) and `0 < λ < (√2 - 1)/L`, every sequence
`(x_n)` generated by Algorithm 3.1 converges weakly to a solution of (1.1). -/
theorem theorem_3_2 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (C : Set H) (hCcl : IsClosed C) (hCcv : Convex ℝ C) (F : H → H) (L lam : ℝ)
    (hC1 : (solSet C F).Nonempty) (hC2 : IsMonotoneMap F) (hL : 0 < L) (hC3 : IsLipschitzMap F L)
    (hlam0 : 0 < lam) (hlam1 : lam < (Real.sqrt 2 - 1) / L)
    (x y : ℕ → H) (hrun : IsPRGRun C F lam x y) :
    ∃ xs ∈ solSet C F, IsWeakLimit x xs := by sorry

end ProjReflGrad.Weak
