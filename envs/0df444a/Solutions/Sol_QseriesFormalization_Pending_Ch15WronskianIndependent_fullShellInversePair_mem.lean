theorem two_mul_int_triangularIndex (r : ℕ) :
    2 * (triangularIndex r : ℤ) = (r : ℤ) * ((r : ℤ) + 1) := by
  unfold triangularIndex
  exact_mod_cast two_mul_triangular r

