-- Source module: Solutions.R6CrtP2
/-!
# CRT reversal §7: the global registers (`globU`, `gdropU`) and the prologue (`proU`)

* `proU`: the prologue of KFUU's `p2U` (volume, `Q^n`, `rB = vol ctB · cr`, `rH = ⌊n/2⌋`).
* `globU`: `gQm = Q^m`, `gP = Q^{n-m}`, `gMd = Q^{n-2m}`, `gD = Q^{m-1}`, `gB = Q^{m-1}·vol T`,
  `gI = n - m`, `gUm = u·m`, and `n` copies of `Q` on `oSP`.
* `gdropU`: pops them again.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## `Q^m` -/

def powQ : IStmt HS P := .seq (.op (.const gQm 1)) (rptX rH lA lC lD (.op (.shl gQm rU2)))

/-! ## `n` copies of `Q` on `oSP` -/

def fillU : IStmt HS P := rptX nR lA lC lD (.op (.dup rU2 oSP))

def unfillU : IStmt HS P := rptX nR lA lC lD (.op (.drop oSP))

/-! ## The globals -/

def globU (pM : Fin P) : IStmt HS P :=
  .seq powQ (.seq (.op (.dup rM gP)) (.seq (divE gP gQm tq) (.seq (.op (.dup gP gMd))
  (.seq (divE gMd gQm tq) (.seq (.op (.dup gQm gD)) (.seq (divE gD rU2 tq)
  (.seq (mulC pM gD rB gB) (.seq (.op (.const tq 2)) (.seq (.op (.shl gB tq)) (.seq (.op (.drop tq))
  (.seq (.op (.dup nR gI)) (.seq (.op (.dup rH tq)) (.seq (.op (.neg tq)) (.seq (.op (.add gI tq gI))
  (.seq (mulC pM rH rU gUm) fillU)))))))))))))))

/-- The state with the globals pushed. -/
def gSt (t : IState HS) (Q u n vT : ℕ) : IState HS :=
  (((((((t.upd gQm (.int ((Q ^ (n / 2) : ℕ) : ℤ) :: t.G gQm)).upd
    gP (.int ((Q ^ (n - n / 2) : ℕ) : ℤ) :: t.G gP)).upd
    gMd (.int ((Q ^ (n - 2 * (n / 2)) : ℕ) : ℤ) :: t.G gMd)).upd
    gD (.int ((Q ^ (n / 2 - 1) : ℕ) : ℤ) :: t.G gD)).upd
    gB (.int ((Q ^ (n / 2 - 1) * vT : ℕ) : ℤ) :: t.G gB)).upd
    gI (.int ((n - n / 2 : ℕ) : ℤ) :: t.G gI)).upd
    gUm (.int ((u * (n / 2) : ℕ) : ℤ) :: t.G gUm)).upd
    oSP (ints (List.replicate n ((Q : ℕ) : ℤ)) ++ t.G oSP)

/-- The cost of `globU` / `gdropU`. -/
def cGlob (n Z : ℕ) : ℕ := (n + 1) * (cU Z + 3000) + (n + 1) * (cU Z + 3000) + 30 * cU Z

/-- Pop the globals. -/
def gdropU : IStmt HS P :=
  .seq unfillU (.seq (.op (.drop gUm)) (.seq (.op (.drop gI)) (.seq (.op (.drop gB))
  (.seq (.op (.drop gD)) (.seq (.op (.drop gMd)) (.seq (.op (.drop gP)) (.op (.drop gQm))))))))

end Gen

end NLogN.KFUU.R6Crt

end

