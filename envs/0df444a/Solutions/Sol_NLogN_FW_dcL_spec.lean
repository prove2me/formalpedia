      exact (mul_dvd_mul_iff_left hB0.ne').1 this
    · congr 1
      apply ih _ _ _ (Or.inl rfl)
      obtain ⟨q, hq⟩ := hd1
      rw [hq, Int.mul_ediv_cancel_left _ hB0.ne']
      have : B ^ (n + 1) ∣ B * (q - (x / B + 0)) := by
        have e2 : B * (q - (x / B + 0)) = W - (x + c) := by linear_combination -hq - he - hxd
