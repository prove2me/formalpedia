-- title:
--   Lemma 3.1, pp. 10–11 — basic properties of the Jucys–Murphy elements T_i and z_i
-- statement:
--   In the Temperley–Lieb algebra $A_n(x)$ over $R=\mathbb Z[x]$, let $T_0=T_1=0$, $T_2=e_1$ and
--
--   $$T_{i+1}=-e_iT_i-T_ie_i+e_ie_{i-1}T_ie_i-z_{i-1}-e_iz_{i-2},\qquad z_i=\sum_{k=0}^{i}x^kT_{i-k},$$
--
--   for $i\ge2$ (so $z_0=z_1=0$). Let $A_j(x)\subseteq A_n(x)$ be the subalgebra generated by $e_1,\dots,e_{j-1}$, and let $*$ be the anti-involution of $A_n(x)$ fixing every $e_i$. For $i\ge 2$, whenever the generators involved lie in $A_n(x)$:
--
--   1. $e_{i+1}e_iT_ie_{i+1}=e_{i+1}T_ie_ie_{i+1}$;
--   2. $e_ie_{i-1}T_ie_i=e_iT_ie_{i-1}e_i$;
--   3. $z_i^*=z_i$ and $T_i^*=T_i$;
--   4. $e_{i-1}T_{i+1}=T_{i+1}e_{i-1}$;
--   5. $e_i(xT_i+T_{i+1})=(xT_i+T_{i+1})e_i$;
--   6. $T_i$ commutes with $A_{i-1}(x)$;
--   7. $z_i$ is central in $A_i(x)$.
--
--   These are the structural facts that make $(T_i)$ a commuting family of self-adjoint elements, the input to the triangular action of Corollary 3.6.
--
--   **Formalization Note** Clause (1) needs $i+2\le n$, (2), (4), (5) need $i+1\le n$, and (3), (6), (7) need $i\le n$, so that every generator named is a genuine generator of $A_n(x)$ (the Lean `e i` is $0$ outside $1\le i\le n-1$). The anti-involution is the `star` of the Murphy cellular datum of Lemma 2.3, whose existence is part of clause (3). Centrality in (7) is stated as membership in $A_i(x)$ together with commutation with all of $A_i(x)$.
-- source:
--   Enyang, Representations of Temperley–Lieb Algebras, arXiv:0710.3218v1, pp. 10–11, Lemma 3.1 (1)–(7); p. 10, definition of T_i and z_i

import Mathlib
import Definitions.Def_TemperleyLieb_Gram_Models

namespace TemperleyLieb.Gram
open QAlgorithms.Papers.Independent.Support21.P08

/-- Enyang, Lemma 3.1 (1)–(7), pp. 10–11, inside `A_n(x)` over `ℤ[x]`. Each clause
is stated for the indices whose generators exist in `A_n(x)`; `A_j(x)` is the
subalgebra generated by `e_1, …, e_{j-1}`, and `*` is the anti-involution of the
Murphy cellular datum (Lemma 2.3), which is asserted to exist. -/
theorem lemma_3_1 (n : ℕ) :
    -- (1)
    (∀ i : ℕ, 2 ≤ i → i + 2 ≤ n →
      e R Polynomial.X n (i + 1) * e R Polynomial.X n i * JM R Polynomial.X n i *
          e R Polynomial.X n (i + 1) =
        e R Polynomial.X n (i + 1) * JM R Polynomial.X n i * e R Polynomial.X n i *
          e R Polynomial.X n (i + 1)) ∧
    -- (2)
    (∀ i : ℕ, 2 ≤ i → i + 1 ≤ n →
      e R Polynomial.X n i * e R Polynomial.X n (i - 1) * JM R Polynomial.X n i *
          e R Polynomial.X n i =
        e R Polynomial.X n i * JM R Polynomial.X n i * e R Polynomial.X n (i - 1) *
          e R Polynomial.X n i) ∧
    -- (3)
    ((∃ D : RDatum n, IsMurphyDatum R Polynomial.X n D) ∧
      ∀ D : RDatum n, IsMurphyDatum R Polynomial.X n D →
        ∀ i : ℕ, 2 ≤ i → i ≤ n →
          D.star (zJM R Polynomial.X n i) = zJM R Polynomial.X n i ∧
          D.star (JM R Polynomial.X n i) = JM R Polynomial.X n i) ∧
    -- (4)
    (∀ i : ℕ, 2 ≤ i → i + 1 ≤ n →
      e R Polynomial.X n (i - 1) * JM R Polynomial.X n (i + 1) =
        JM R Polynomial.X n (i + 1) * e R Polynomial.X n (i - 1)) ∧
    -- (5)
    (∀ i : ℕ, 2 ≤ i → i + 1 ≤ n →
      e R Polynomial.X n i *
          ((Polynomial.X : R) • JM R Polynomial.X n i + JM R Polynomial.X n (i + 1)) =
        ((Polynomial.X : R) • JM R Polynomial.X n i + JM R Polynomial.X n (i + 1)) *
          e R Polynomial.X n i) ∧
    -- (6)
    (∀ i : ℕ, 2 ≤ i → i ≤ n →
      ∀ a ∈ Algebra.adjoin R (e R Polynomial.X n '' Set.Icc 1 (i - 2)),
        a * JM R Polynomial.X n i = JM R Polynomial.X n i * a) ∧
    -- (7)
    (∀ i : ℕ, 2 ≤ i → i ≤ n →
      zJM R Polynomial.X n i ∈ Algebra.adjoin R (e R Polynomial.X n '' Set.Icc 1 (i - 1)) ∧
      ∀ a ∈ Algebra.adjoin R (e R Polynomial.X n '' Set.Icc 1 (i - 1)),
        a * zJM R Polynomial.X n i = zJM R Polynomial.X n i * a) := by sorry

end TemperleyLieb.Gram
