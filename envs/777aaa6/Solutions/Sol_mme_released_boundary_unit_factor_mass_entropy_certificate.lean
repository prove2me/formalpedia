theorem cell_bound (c : Fin zCells) :
    ((G (zCellIdx.symm c).val.1 (shapeEquiv.symm (zCellIdx.symm c).val.2) : ℤ) : ℝ) ≤
      MME.RegionRate.massEntropy (fun s => (zCountAt 1 c s : ℝ)) +
        ((∑ s, zCountAt 1 c s * Boundary.ones s : ℕ) : ℝ) * Real.log 5 -
        81 * Real.log (6 * (((∑ s, zCountAt 1 c s : ℕ) : ℝ) + 1)) := by
  obtain ⟨C, rfl⟩ : ∃ C, zCellIdx C = c := ⟨zCellIdx.symm c, zCellIdx.apply_symm_apply c⟩
  rw [zCellIdx.symm_apply_apply]
  have hz : ∀ w, zCountAt 1 (zCellIdx C) w =
      wordCounts C.val.1 (hashMode C.val.1 (zMode C + 1)) C.val.2 w := by
    intro w
    rw [zCountAt_idx]
    simp [scaledWords]
  simp_rw [hz]
  obtain ⟨s, hs⟩ : ∃ s, shape s = C.val.2 := ⟨shapeEquiv.symm C.val.2, shapeEquiv.apply_symm_apply C.val.2⟩
  have hs' : shapeEquiv.symm C.val.2 = s := by
    rw [← hs]; exact shapeEquiv.symm_apply_apply s
  have hj : ((shape s).val (hashMode C.val.1 (zMode C))).val = 0 := by
    rw [hs]; exact zMode_spec C
  rw [hs', ← hs]
  exact owner_bound C.val.1 s (zMode C) hj

