theorem kernelPts_finite_of_eulerChar_ne_zero
    (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of k)}
    (L : RelativeGroupLaw k f) (hA : AbelianSchemePropertyBundle k f)
    (𝓛 : A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛)
    (𝒦 : A.OrderedAffineCover) (hχ : (OModulePresheaf.ofModules f 𝓛).eulerChar 𝒦 ≠ 0) :
    (kernelPts f L 𝓛).Finite := by
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  have hc : L.IsCommutative := hA.isCommutative L
  by_contra hinf

  obtain ⟨K', ι', hι', LK, hhom, hrep⟩ :=
    AbelianSchemePropertyBundle.exists_isClosedImmersion_relativeGroupLaw_forall_iff_locIsoOnBase_sliceAt_mumfordBundle_of_isAlgClosed
      k f hA L hc 𝓛 h𝓛
  haveI := hι'

  have hpts : ∀ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f,
      (∃ κ : Spec (CommRingCat.of k) ⟶ K', κ ≫ ι' = x.1) ↔ x ∈ kernelPts f L 𝓛 := by
    intro x
    rw [hrep k (𝟙 _) x, locIsoOnBase_iff_nonempty_iso_of_field,
      mem_kernelPts_iff_nonempty_pullback_sliceAt_mumfordBundle_iso_unit k f L 𝓛 h𝓛 x]

  obtain ⟨Y, i, LY, n, hi, hirr, hsm, hgi, hopen, hrange, hdimY, hhomY, hcommY, S, hS, hcoset⟩ :=
    RelativeGroupLaw.exists_isClosedImmersion_smoothOfRelativeDimension_range_eq_connectedComponent_of_perfectField
      k (f := ι' ≫ f) LK
  haveI := hi
  haveI := hsm

  have hn : 1 ≤ n := by
    by_contra hn0
    have hn0 : n = 0 := by omega

    have hKinf : Infinite (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (ι' ≫ f)) := by
      by_contra hfinK
      rw [not_infinite_iff_finite] at hfinK
      apply hinf
      refine Set.Finite.subset (Set.finite_range (fun κ : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (ι' ≫ f) =>
        (⟨κ.1 ≫ ι', by rw [Category.assoc, κ.2]⟩ : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f))) ?_
      intro x hx
      obtain ⟨κ, hκ⟩ := (hpts x).mpr hx
      exact ⟨⟨κ, by rw [← x.2, ← hκ, Category.assoc]⟩, Subtype.ext hκ⟩

    have hYinf : Infinite (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (i ≫ ι' ≫ f)) := by
      by_contra hfinY
      rw [not_infinite_iff_finite] at hfinY
      haveI : Finite ↥S := hS.to_subtype
      haveI : Finite (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (ι' ≫ f)) := by
        refine Finite.of_surjective (fun p : ↥S × SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (i ≫ ι' ≫ f) =>
          LK.mul (𝟙 _) p.1.1 (NeronModelInfra.schemeHomOverComp p.2 (⟨i, rfl⟩ : SchemeHomOver (i ≫ ι' ≫ f) (ι' ≫ f)))) ?_
        intro x
        obtain ⟨s, hs, a, ha⟩ := hcoset x
        exact ⟨(⟨s, hs⟩, a), ha.symm⟩
      exact not_finite (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (ι' ≫ f))

    obtain ⟨y₁, y₂, hy⟩ := exists_pair_ne (SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) (i ≫ ι' ≫ f))
    have hinj := (eq_of_base_closedPoint_eq_and_exists_base_closedPoint_eq_and_isClosed_of_isAlgClosed k (i ≫ ι' ≫ f)).1
    have hpne : y₁.1.base (IsLocalRing.closedPoint k) ≠ y₂.1.base (IsLocalRing.closedPoint k) :=
      fun h => hy (Subtype.ext (hinj y₁.1 y₂.1 y₁.2 y₂.2 h))

    have hcl : ∀ p : ↥Y, closure ({p} : Set ↥Y) = Set.univ := by
      intro p
      by_contra hp
      have h := IsIrreducible.topologicalKrullDim_add_one_le_of_isClosed_of_ne
        (IrreducibleSpace.isIrreducible_univ ↥Y) isClosed_closure (Set.subset_univ _) hp
      have huniv : topologicalKrullDim (Set.univ : Set ↥Y) = topologicalKrullDim ↥Y :=
        IsHomeomorph.topologicalKrullDim_eq _ (Homeomorph.Set.univ ↥Y).isHomeomorph
      rw [huniv, hdimY, hn0] at h
      have hne : topologicalKrullDim ↥(closure ({p} : Set ↥Y)) ≠ ⊥ := by
        rw [topologicalKrullDim, ne_eq, Order.krullDim_eq_bot_iff, not_isEmpty_iff]
        exact ⟨⟨closure {⟨p, subset_closure (Set.mem_singleton p)⟩}, isIrreducible_singleton.closure, isClosed_closure⟩⟩
      revert h hne
      generalize topologicalKrullDim ↥(closure ({p} : Set ↥Y)) = e
      intro h hne
      induction e with
      | bot => exact hne rfl
      | coe e =>
        have : ((e + 1 : ℕ∞) : WithBot ℕ∞) ≤ ((0 : ℕ) : WithBot ℕ∞) := by exact_mod_cast h
        have := WithBot.coe_le_coe.mp this
        exact absurd this (by simp)
    apply hpne
    have h12 : y₂.1.base (IsLocalRing.closedPoint k) ⤳ y₁.1.base (IsLocalRing.closedPoint k) := by
      rw [specializes_iff_closure_subset, hcl, hcl]
    have h21 : y₁.1.base (IsLocalRing.closedPoint k) ⤳ y₂.1.base (IsLocalRing.closedPoint k) := by
      rw [specializes_iff_closure_subset, hcl, hcl]
    exact (h21.antisymm h12).eq

  let j : Y ⟶ A := i ≫ ι'
  have hjf : j ≫ f = i ≫ ι' ≫ f := Category.assoc _ _ _
  haveI : IsClosedImmersion j := inferInstance
  have hY : AbelianSchemePropertyBundle k (i ≫ ι' ≫ f) := by
    haveI : Smooth (i ≫ ι' ≫ f) := SmoothOfRelativeDimension.smooth n _
    haveI : ConnectedSpace ↥Y := inferInstance
    exact
      { smooth := inferInstance
        proper := inferInstance
        connectedFibres := fun s => by
          have : (i ≫ ι' ≫ f).base ⁻¹' {s} = Set.univ := Set.eq_univ_of_forall fun y => Subsingleton.elim _ _
