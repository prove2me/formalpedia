variable {K : Type} [Field K] [NumberField K] (v : HeightOneSpectrum (𝓞 K))

private def d067 (n : ℤ) : Set (v.adicCompletion K) := {x | Valued.v x ≤ WithZero.exp n}

private theorem t0636 {n : ℤ} {x : v.adicCompletion K} : x ∈ d067 v n ↔ Valued.v x ≤ WithZero.exp n :=
  Iff.rfl

private theorem t0637 {n : ℤ} {x y : v.adicCompletion K} (hx : x ∈ d067 v n)
    (hy : y ∈ d067 v n) : x + y ∈ d067 v n :=
  (t0636 v).2 ((Valuation.map_add _ x y).trans (max_le ((t0636 v).1 hx) ((t0636 v).1 hy)))

private theorem t0638 {n : ℤ} {x y : v.adicCompletion K} (hx : x ∈ d067 v n)
    (hxy : x + y ∈ d067 v n) : y ∈ d067 v n := by
  have h : y = (x + y) + -x := by ring
  rw [h]
  refine t0637 v hxy ?_
  show Valued.v (-x) ≤ WithZero.exp n
  rw [Valuation.map_neg]
  exact hx

private theorem t0639 : d067 v 0 = (v.adicCompletionIntegers K : Set (v.adicCompletion K)) := by
  ext x
  rw [t0636, WithZero.exp_zero, SetLike.mem_coe, HeightOneSpectrum.mem_adicCompletionIntegers]

private theorem le_exp_neg_one_of_lt_one {γ : ℤᵐ⁰} (hγ : γ < 1) : γ ≤ WithZero.exp (-1) := by
  rcases eq_or_ne γ 0 with h0 | h0
  · rw [h0]
    exact zero_le'
  · rw [← WithZero.exp_log h0] at hγ ⊢
    rw [← WithZero.exp_zero, WithZero.exp_lt_exp] at hγ
    rw [WithZero.exp_le_exp]
    omega

private theorem t0640 :
    d067 v 0 = {x : v.adicCompletion K | Valued.v x = 1} ∪ d067 v (-1) := by
  ext x
  simp only [t0636, Set.mem_union, Set.mem_setOf_eq, WithZero.exp_zero]
  constructor
  · intro hx
    rcases hx.lt_or_eq with hlt | heq
    · exact Or.inr (le_exp_neg_one_of_lt_one hlt)
    · exact Or.inl heq
  · rintro (h | h)
    · exact h.le
    · exact h.trans (by rw [← WithZero.exp_zero, WithZero.exp_le_exp]; norm_num)

private theorem t0641 :
    Disjoint {x : v.adicCompletion K | Valued.v x = 1} (d067 v (-1)) := by
  rw [Set.disjoint_left]
  intro x hx hx'
  have h1 : (1 : ℤᵐ⁰) ≤ WithZero.exp (-1) := by
    rw [Set.mem_setOf_eq] at hx
    rw [← hx]
    exact hx'
  rw [← WithZero.exp_zero, WithZero.exp_le_exp] at h1
  omega

