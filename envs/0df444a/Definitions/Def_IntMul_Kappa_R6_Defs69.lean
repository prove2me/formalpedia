-- Source module: Solutions.R6SDesc
/-!
# Round-six setup, part 6: the descriptor loops

* `cpR`: pops `N` values off `37` and pushes each on `26`, `27`, `28` (so each receives the
  reversed list).
* `btR`: pushes the bits `[d' ≤ j]` for `j = N-1, …, 0` on `26`, `27`, `28` (so each receives
  `[b_0, …, b_{N-1}]` on top).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

noncomputable section

/-- The copy loop. -/
def cpR : RS := .rep 51 (.reg 25)
  (.seq (.push 26 (.reg 37)) (.seq (.push 27 (.reg 37)) (.seq (.push 28 (.reg 37)) (.pop 37))))

/-- The bit `[d' ≤ c - 1]` (`c` on `51`, `d'` on `34`). -/
def bitE : Ex HS := .sel (.add (.add (.reg 51) (.lit (-1))) (.neg (.reg 34))) (.lit 0) (.lit 1)

/-- The bits loop. -/
def btR : RS := .rep 51 (.reg 25) (.seq (.push 26 bitE) (.seq (.push 27 bitE) (.push 28 bitE)))

/-- The bit list `[[d' ≤ j] : j < N]`. -/
def bitL (dp N : ℕ) : List ℤ := (List.range N).map fun j => if dp ≤ j then 1 else 0

end

end IntMul.Kappa.R6

end

