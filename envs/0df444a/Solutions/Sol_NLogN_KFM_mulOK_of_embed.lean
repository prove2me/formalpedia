end NSLevel

theorem mulProg_runs {I : List Sym} (s : IState NS) (a b : ℤ) (LA : List Item)
    (hA : s.G ARG = .int a :: .int b :: LA) :
    IRuns I mulProg (.call 0) s (s.upd ARG (.int (a * b) :: LA)) (mulCost (zsz a + zsz b) + 2) :=
  IRuns.call (mulBody_runs (iprog := mulProg) 1 2 3 4 rfl rfl rfl rfl s a b LA hA)

theorem ssE_inj : Function.Injective ssE := Fin.castLE_injective _

theorem mulWrap_runs {P' : ℕ} {I : List Sym} {iprog' : Fin P' → IStmt HS P'} {g : Fin 5 → Fin P'}
    (hg : ∀ j, iprog' (g j) = (mulProg j).ren ssE g) (t : IState HS) (a b : ℤ) (L : List Item)
    (hA : t.G ARGM = .int a :: .int b :: L) :
    IRuns I iprog' (mulWrap g) t (t.upd ARGM (.int (a * b) :: L))
      (mulCostH (zsz a + zsz b) - 2) := by
  have hne : ARGM ≠ ssE ARG := by decide
  have h1 := IRuns.mv (I := I) (iprog := iprog') (s := t) (i := ARGM) (j := ssE ARG) (a := a)
    (L := .int b :: L) hne hA
  set t1 := (t.upd ARGM (.int b :: L)).upd (ssE ARG) (.int a :: t.G (ssE ARG)) with ht1
  have h2 := IRuns.mv (I := I) (iprog := iprog') (s := t1) (i := ARGM) (j := ssE ARG) (a := b)
    (L := L) hne (by simp [ht1, hne])
  set t2 := (t1.upd ARGM L).upd (ssE ARG) (.int b :: t1.G (ssE ARG)) with ht2
  have hm := mulProg_runs (I := I) (IState.pull ssE t2) b a (t.G (ssE ARG))
    (by simp [ht2, ht1, hne])
  have h3 := IRuns.ren' ssE_inj hg hm t2 (fun _ => rfl) rfl rfl
  rw [IState.embed_upd ssE_inj, IState.embed_pull ssE_inj] at h3
  have h4 := IRuns.mv (I := I) (iprog := iprog') (s := t2.upd (ssE ARG) (.int (b * a) :: t.G (ssE ARG)))
    (i := ssE ARG) (j := ARGM) (a := b * a) (L := t.G (ssE ARG)) hne.symm (by simp)
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 h4))).mono' ?_ ?_
  · simp only [ht2, ht1]
    rw [mul_comm b a]
    ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))
  · have m1 := moveIntCost_le (zsz a); have m2 := moveIntCost_le (zsz b)
    have m3 := moveIntCost_le (zsz (b * a))
    have := zsz_mul_le b a
    simp only [mulCostH]
    show _ ≤ mulCost (zsz a + zsz b) + 400 * (zsz a + zsz b + 3) - 2
    rw [Nat.add_comm (zsz b) (zsz a)]
    omega

end NLogN.KFM

