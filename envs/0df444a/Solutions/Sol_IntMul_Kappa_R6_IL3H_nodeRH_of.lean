variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

/-- **The node frame over a level frame.** -/
theorem nodeRH_of_sol_aux (hL : LevRH c σ K t S0 r H E e B) :
    NodeRH c (σNodeH σ c K t S0 r E B) K t S0 r H E e B := by
  have ne : ∀ i : Fin HS, i ∉ [wF, wB, wR0, wKF, w1, vF, (26 : Fin HS), wL, wV, 21, 23, 25] →
      σNodeH σ c K t S0 r E B i = σ i := fun i hi => σNodeH_ne hi
  refine ⟨⟨fun i hi => ?_, fun i hi => ?_, fun i v hv => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.off i hi
  · rw [ne i (by revert hi; revert i; decide)]; exact hL.offp i hi
  · unfold σNodeH at hv
    rcases σPush_cases _ _ _ _ hv with ⟨p, hp, rfl⟩ | h'
    · have := nodeVL2_keys c t S0 r E B p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this
      rcases this with h1 | h1 | h1 | h1 | h1 | h1 <;> rw [h1] <;> decide
    · rcases σPush_cases _ _ _ _ h' with ⟨p, hp, rfl⟩ | h''
      · have := nodeVL1_keys c K S0 r E B p hp
        simp only [List.mem_cons, List.not_mem_nil, or_false] at this
        rcases this with h1 | h1 | h1 | h1 | h1 | h1 <;> rw [h1] <;> decide
      · exact hL.lt i v h''
  · rw [ne _ (by decide)]; exact hL.hK
  · rw [ne _ (by decide)]; exact hL.ht
  · rw [ne _ (by decide)]; exact hL.hS
  · rw [ne _ (by decide)]; exact hL.hr
  · rw [ne _ (by decide)]; exact hL.hH
  · rw [ne _ (by decide)]; exact hL.hk
  · rw [ne _ (by decide)]; exact hL.hE
  · rw [ne _ (by decide)]; exact hL.hB
  · rw [ne _ (by decide)]; exact hL.hX
  · exact σNodeH_val1 (by simp [nodeVL1]) (by decide)
  · exact σNodeH_val1 (by simp [nodeVL1]) (by decide)
  · exact σNodeH_val1 (by simp [nodeVL1]) (by decide)
  · exact σNodeH_val1 (by simp [nodeVL1]) (by decide)
  · exact σNodeH_val2 (by simp [nodeVL2])
  · exact σNodeH_val2 (by simp [nodeVL2])
  · exact σNodeH_val1 (by simp [nodeVL1]) (by decide)
  · have := σNodeH_val1 (σ := σ) (t := t) (c := c) (K := K) (S0 := S0) (r := r) (E := E)
      (B := B) (i := w1) (v := ((1 : ℕ) : ℤ)) (by simp [nodeVL1]) (by decide)
    simpa using this
  · exact σNodeH_val2 (by simp [nodeVL2])
  · exact σNodeH_val2 (by simp [nodeVL2])
  · exact σNodeH_val2 (by simp [nodeVL2])
  · exact σNodeH_val2 (by simp [nodeVL2])

