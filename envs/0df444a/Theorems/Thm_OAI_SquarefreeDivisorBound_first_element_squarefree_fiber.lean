theorem OAI.SquarefreeDivisorBound.first_element_squarefree_fiber
    (s : Finset (Ideal O × O)) (hs : ∀ x ∈ s, Squarefree x.1)
    (e y : O) (hy : y ≠ 0) :
    (s.filter (fun x => firstElementRowMap e x = y)).card ≤
      ((idealDivisors (Ideal.span {y})).filter Squarefree).card := by sorry
