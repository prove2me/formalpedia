lemma ha7_1_0_eq (j : Fin 7) : ha7_1_0 j = atomKernel7_0 j := by fin_cases j <;> decide +kernel
lemma ha7_1_0_contains (j : Fin 7) : (ha7_1_0 j).Contains (fullFactor true 7 0 ((j.val:ℝ)/6)) := by
