private theorem decomp_Q (shift : E → E) (χ : ↥(A.decompositionSubgroup ℚ) →* Multiplicative (ZMod 2))
    (hact1 : ∀ τ, χ τ = 1 → actZ τ = 1)
    (hact2 : ∀ τ, χ τ ≠ 1 → ∀ x : ↥(ribbonKernel D),
      ((actZ τ x : ↥(ribbonKernel D)) : E → ℤ) = fun c => - (x : E → ℤ) (shift c))
    (hQinv : ∀ x y x' y' : ↥(ribbonKernel D),
      ((x' : E → ℤ) = fun c => - (x : E → ℤ) (shift c)) → ((y' : E → ℤ) = fun c => - (y : E → ℤ) (shift c)) →
        𝒰.P.Q x' y' = 𝒰.P.Q x y) :
    ∀ (σ : ↥(A.decompositionSubgroup ℚ)) (s : A.valuation.Completion ≃ₐ[ℚ] A.valuation.Completion),
      (∀ c, s c = σ • c) → ∀ x y : ↥(ribbonKernel D),
        s (((Additive.toMul (𝒰.P.Q x y) : (↥𝒰.K)ˣ) : ↥𝒰.K) : A.valuation.Completion) =
          (((Additive.toMul (𝒰.P.Q x y) : (↥𝒰.K)ˣ) : ↥𝒰.K) : A.valuation.Completion) := by
  intro σ s hs x y
  rw [𝒰.Q_equiv σ s hs x y]
  by_cases hχ : χ σ = 1
  · rw [hact1 σ hχ]
    rfl
  · rw [hQinv x y (actZ σ x) (actZ σ y) (hact2 σ hχ x) (hact2 σ hχ y)]

