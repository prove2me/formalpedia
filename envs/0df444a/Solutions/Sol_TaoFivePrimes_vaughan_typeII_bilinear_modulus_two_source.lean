    refine ContinuousOn.integrableOn_Icc ?_
    dsimp [f0]
    fun_prop (disch := grind)
  have hf1 : IntegrableOn f1 (Set.Icc V (x / U)) := by
    refine ContinuousOn.integrableOn_Icc ?_
    dsimp [f1]
    fun_prop (disch := grind)
  have hf2 : IntegrableOn f2 (Set.Icc V (x / U)) := by
    refine ContinuousOn.integrableOn_Icc ?_
    dsimp [f2]
    fun_prop (disch := grind)
  have hsplit :
      (∫ W : ℝ in Set.Icc V (x / U),
