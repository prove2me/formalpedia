      apply IRuns.of_runsTo 0
      simp +decide [IStmt.run, IOp.run, zsz_zero, zsz_one]
      refine ⟨?_, by omega⟩
      simp only [hs8, hs7', hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXd, hYd]
      clear * -
      apply IState.ext'
      · intro x; fin_cases x <;> simp +decide [IState.upd_G] <;> rfl
      · simp
      · simp
    -- segments G, H: results back to DX
    have hG := mvH_runs (I := I) (iprog := iprog) (X := P2) (Y := DX) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) s8 Y.reverse (s.G P2)
      (s.G HH) (n + 1) (by simp +decide [s8, ints_reverse]) (by simp +decide [s8, hYl])
