theorem MIPStarRE.QPBT.stateQForm_placeSide_alice_tensor_one {P : _root_.MIPStarRE.QPBT.AdmissibleParams} {epsilon : ℝ}
    (S : _root_.MIPStarRE.QPBT.ProjectiveSetting P epsilon) (A : _root_.LIDT.MIPStarRE.Quantum.Op (S.ExpandedLocalSpace .alice))
    (hA : A.IsHermitian) :
    _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm S.psiHat (S.placeSide .alice (_root_.MIPStarRE.QPBT.heteroKron A (1 : _root_.LIDT.MIPStarRE.Quantum.Op (_root_.MIPStarRE.QPBT.PauliRegister P)))) =
      _root_.MIPStarRE.QPBT.DistanceCalculus.stateQForm (_root_.MIPStarRE.QPBT.ExtendedLineGame.pairState S) (_root_.MIPStarRE.QPBT.heteroKron A 1) := by sorry
