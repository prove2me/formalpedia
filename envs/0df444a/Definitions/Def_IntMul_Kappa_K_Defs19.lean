/-- The doubling exponents: `aE p = Σ_{pos i = p} a'_i`. -/
def aEof {ι : Type*} [Fintype ι] (pos : ι → ℕ) (a' : ι → ℕ) (p : ℕ) : ℕ :=
  ∑ i ∈ Finset.univ.filter (fun i => pos i = p), a' i

