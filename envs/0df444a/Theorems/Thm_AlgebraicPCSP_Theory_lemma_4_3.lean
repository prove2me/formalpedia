-- title:
--   Lemma 4.3 — a minion M satisfies the condition Σ(A, F_M(A))
-- statement:
--   Let $\mathcal M$ be a minion on a pair of finite sets and let $\mathbf A$ be a finite relational structure with a nonempty domain (finite signature, arities $\ge1$). Then $\mathcal M$ satisfies the bipartite minor condition
--   $$\Sigma\big(\mathbf A,\,F_{\mathcal M}(\mathbf A)\big),$$
--   where $F_{\mathcal M}(\mathbf A)$ is the free structure of $\mathcal M$ generated by $\mathbf A$ (Definition 4.1), viewed as an instance similar to $\mathbf A$, and both $\Sigma$ and $F_{\mathcal M}(\mathbf A)$ are built from the same enumerations of $A$ and of the relations $R^{\mathbf A}$.
--
--   This is the step (2) ⇒ (3) of Theorem 4.12, applied to $\mathcal M=\mathrm{Pol}(\mathbf A_1,\mathbf B_1)$ and $\mathbf A=\mathbf A_2$.
-- source:
--   L. Barto, J. Bulín, A. Krokhin, J. Opršal, Algebraic approach to promise constraint satisfaction, arXiv:1811.00970v3, p. 24, Lemma 4.3

import Mathlib
import Definitions.Def_PCSPBLPAff_Symmetric_Setting
import Definitions.Def_AlgebraicPCSP_Theory_Minion
import Definitions.Def_AlgebraicPCSP_Theory_MinorCondition
import Definitions.Def_AlgebraicPCSP_Theory_PPConstruction

open PCSPBLPAff.Symmetric

namespace AlgebraicPCSP.Theory

/-- Lemma 4.3 (arXiv:1811.00970v3, p. 24). Let `M` be a minion (on finite sets) and `𝔸` a
finite relational structure. Then `M` satisfies the condition `Σ(𝔸, F_M(𝔸))`, where `Σ` and the
free structure are built from the same enumerations `e` of `A` and `eR R` of `R^𝔸`. -/
theorem lemma_4_3 {C D : Type} [Fintype C] [DecidableEq C] [Fintype D] [DecidableEq D]
    (M : Minion C D) {τ : Type} [Fintype τ] {ar : τ → ℕ} (har : ∀ R, 0 < ar R)
    {A : Type} [Fintype A] [DecidableEq A] [Nonempty A] (𝔸 : RelStruct τ ar A)
    {n : ℕ} (e : Fin n ≃ A) (m : τ → ℕ) (eR : (R : τ) → Fin (m R) ≃ 𝔸.rel R) :
    M.Satisfies (sigmaCondition 𝔸 (freeStructure M 𝔸 e m eR) e m eR) := by sorry

end AlgebraicPCSP.Theory
