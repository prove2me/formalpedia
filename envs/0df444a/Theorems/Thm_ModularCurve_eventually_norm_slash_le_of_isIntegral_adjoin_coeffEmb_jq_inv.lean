-- title:
--   Integrality over ℂ[j⁻¹] forces cuspidal decay of gE₄²E₆
-- statement:
--   Let $N$ be a natural number, $k$ an integer, and let $g,h$ be modular forms of weight $k$ for $\Gamma_0(N)$ with $h \neq 0$. Let $X \in \mathbb{C}((q))$ be a Laurent series such that $X$ times the $q$-expansion of $h$ of period $1$ (viewed as a power series, then as a Laurent series) equals the corresponding $q$-expansion of $g$; thus $X$ plays the role of $g/h$ in $\mathbb{C}((q))$. Write $J :=$ [`ModularCurve.coeffEmb ℂ ModularCurve.jq`](def/ModularCurve_LaurentCoeff.html#L81) for the Laurent series over $\mathbb{C}$ obtained from [`ModularCurve.jq`](def/ModularCurve_X0.html#L157) $= q^{-1}\cdot(\mathrm{jNum}$ base changed to $\mathbb{Q})$ by pushing coefficients forward along $\mathbb{Q} \to \mathbb{C}$, i.e. the $q$-expansion of the modular invariant. Let $M$ be a natural number and assume that $X^{2M}\,J^{M+1}\,(J - 1728)^{M}$ is integral over the $\mathbb{C}$-subalgebra of $\mathbb{C}((q))$ generated by $J^{-1}$. Then for every $A \in \mathrm{SL}_2(\mathbb{Z})$ and every real $\varepsilon > 0$, eventually as $\operatorname{Im}\tau \to \infty$ on the upper half-plane,
--   $$\bigl\|\bigl((g E_4^2 E_6)\mid_{k+14} A\bigr)(\tau)\bigr\| \le \varepsilon\,\bigl\|\bigl((h\Delta)\mid_{k+12} A\bigr)(\tau)\bigr\|,$$
--   the slash actions being those of the image of $A$ in $\mathrm{GL}_2(\mathbb{R})$ in the indicated weights.
--
--   This is the cuspidal-decay half of the identification of regular differentials on $X_0(N)$ with cusp forms: integrality of the displayed Laurent series over $\mathbb{C}[j^{-1}]$ is the algebraic form of regularity at the cusps, and the conclusion says $(gE_4^2E_6)\mid A = o\bigl((h\Delta)\mid A\bigr)$ at $i\infty$ for every $A \in \mathrm{SL}_2(\mathbb{Z})$. It is used by [`ModularCurve.exists_cuspForm_qExpansion_eq_mul_thetaL_of_isIntegral`](thm.html#ModularCurve.exists_cuspForm_qExpansion_eq_mul_thetaL_of_isIntegral).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_eventually_norm_slash_le_of_isIntegral_adjoin_coeffEmb_jq_inv.lean

import Mathlib
import Definitions.Def_ModularCurve_X0
import Definitions.Def_ModularCurve_LaurentCoeff

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve
open scoped MatrixGroups ModularForm

theorem ModularCurve.eventually_norm_slash_le_of_isIntegral_adjoin_coeffEmb_jq_inv (N : ℕ) {k : ℤ}
    (g h : ModularForm (CongruenceSubgroup.Gamma0 N) k) (hh : h ≠ 0) (X : LaurentSeries ℂ)
    (hX : X * ((UpperHalfPlane.qExpansion 1 (h : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ) = ((UpperHalfPlane.qExpansion 1 (g : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ)) (M : ℕ)
    (h₂ : IsIntegral (Algebra.adjoin ℂ ({(ModularCurve.coeffEmb ℂ ModularCurve.jq)⁻¹} : Set (LaurentSeries ℂ)))
      (X ^ (2 * M) * ModularCurve.coeffEmb ℂ ModularCurve.jq ^ (M + 1) * (ModularCurve.coeffEmb ℂ ModularCurve.jq - algebraMap ℂ (LaurentSeries ℂ) 1728) ^ M))
    (A : Matrix.SpecialLinearGroup (Fin 2) ℤ) (ε : ℝ) (hε : 0 < ε) :
    ∀ᶠ τ : UpperHalfPlane in UpperHalfPlane.atImInfty,
      ‖((fun z : UpperHalfPlane => g z * ModularForm.E₄ z ^ 2 * ModularForm.E₆ z) ∣[k + 14] (A : GL (Fin 2) ℝ)) τ‖ ≤
        ε * ‖((fun z : UpperHalfPlane => h z * ModularForm.discriminant z) ∣[k + 12] (A : GL (Fin 2) ℝ)) τ‖ := by sorry
