/-- Convert the composable statement specification to the platform's halted
program specification without changing its mathematical postcondition. -/
theorem halts_of_statement_spec (body : Stmt) (E : RAMEnv) (start : RAMState) (T : ℝ)
    (Post : RAMState → Prop) (hpc : start.pc = 0)
    (h : StatementSpec body E start T Post) :
    ∃ s' : RAMState, HaltsWithin (programOfStatement body) E T start s' ∧ Post s' := by
  have hAt : At (programOfStatement body) 0 (Stmt.compile body 0) :=
    At.of_program_append (pre := []) (code := Stmt.compile body 0) (post := [iHalt]) rfl rfl
  have hsem := h (programOfStatement body) 0 hAt
  have hstart : ({ start with pc := 0 } : RAMState) = start := by
    apply ramState_eq_of
    · exact hpc.symm
    · rfl
    · intro _; rfl
  rw [hstart, Nat.zero_add] at hsem
  have hhalt : (programOfStatement body)[body.len]? = some iHalt := by
    unfold programOfStatement
    rw [← Stmt.length_compile body 0, List.getElem?_append_right (by omega)]
    simp
  exact halts_of_run (programOfStatement body) E 0 body.len start T
    (fun k s' => (k : ℝ) + 1 ≤ T ∧ Post s') Post hhalt hsem (fun _ _ hQ => hQ)

