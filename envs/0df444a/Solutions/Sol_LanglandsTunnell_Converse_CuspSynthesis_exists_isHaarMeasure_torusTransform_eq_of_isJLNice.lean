        Finset.prod_le_prod (fun v _ => Finset.sum_nonneg fun m _ => t0667 σ v m) fun v _ =>
          (t0668 hσ v).sum_le_tsum _ fun m _ => t0667 σ v m

private theorem t0670 (R : SOrderReps K S) {n : ↥S → ℤ}
    (h : ∃ v : ↥S, n v < -TateLocal.addCharLevel (StandardAddChar.psiLocal K v.1)) :
    ∃ v : ↥S, ¬ Valued.v (((localOf K v.1 (R.rep n) : (v.1.adicCompletion K)ˣ)) : v.1.adicCompletion K) ≤
      WithZero.exp (TateLocal.addCharLevel (StandardAddChar.psiLocal K v.1)) := by
  obtain ⟨v, hv⟩ := h
  refine ⟨v, ?_⟩
  rw [R.rep_ord n v, not_le, WithZero.exp_lt_exp]
  omega

private theorem t0671 (R : SOrderReps K S) {η : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hη1 : ∀ (v : ↥S) (t : (v.1.adicCompletion K)ˣ), ‖((localChar η v.1 t : ℂˣ) : ℂ)‖ ≤ 1) (n : ↥S → ℤ) (s : ℂ) :
    ‖sWeight K S η (R.rep n) (s + 1 / 2)‖ ≤
      ∏ v : ↥S, ((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ) ^ (-((n v : ℤ) : ℝ) * s.re) := by
