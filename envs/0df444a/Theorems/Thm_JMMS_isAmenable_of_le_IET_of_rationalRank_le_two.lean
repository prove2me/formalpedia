-- title:
--   Theorem 1.9 — a subgroup of IET of rational rank at most 2 is amenable
-- statement:
--   Let $G$ be a subgroup of $\mathrm{IET}$ whose angle group $\Lambda(G)$, the subgroup of $\mathbf R/\mathbf Z$ generated by all angles $g(x) - x$ of elements of $G$, has rational rank at most $2$. Then $G$ is amenable.
--
--   Juschenko, Matte Bon, Monod and de la Salle, p. 4: “Theorem 1.9. Let $G \le \mathrm{IET}$. If $\mathrm{rk}_{\mathbf Q}(G) \le 2$ then $G$ is amenable.” Here $\mathrm{rk}_{\mathbf Q}(G)$ is the rational rank of $\Lambda(G)$ (Definition 1.7, p. 4); $G$ need not be finitely generated.
-- source:
--   Juschenko, K., Matte Bon, N., Monod, N. and de la Salle, M., Extensive amenability and an application to interval exchanges, Ergodic Theory Dynam. Systems 38 (2018) 195–219, https://doi.org/10.1017/etds.2016.32 (arXiv:1503.04977v1, whose page numbers are used), p. 4, Theorem 1.9

import Mathlib
import Definitions.Def_IntervalExchange

open IntervalExchange

namespace JMMS

theorem isAmenable_of_le_IET_of_rationalRank_le_two (G : Subgroup (Equiv.Perm UnitAddCircle))
    (hG : G ≤ IET) (hrk : rationalRank (angleGroup G) ≤ 2) : Garrido.IsAmenable ↥G := by
  sorry

end JMMS
