theorem ModularCurve.IgusaScheme.smoothOfRelativeDimension_one_pullback_chartFin_residue
    (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime] (hℓN : ¬ ℓ ∣ N)
    (k : Type) [Field k] [CharP k ℓ] [IsAlgClosed k]
    (φ : ↥(GaloisRep.ratLocalizedAt ℓ) →+* k) :
    SmoothOfRelativeDimension 1
      (pullback.snd
        (Spec.map (CommRingCat.ofHom
          (algebraMap ↥(GaloisRep.ratLocalizedAt ℓ) ↥(chartAlgFin N ℓ))))
        (Spec.map (CommRingCat.ofHom φ))) := by sorry
