-- Source module: Solutions.J6SegSideCost1
/-!
# Side costs 1: the size of the near-boundary list `LJ`

* `bad_count`: `#{l < m : ¬ stepOK l} + m ≤ rrZ m` (`0 < s ≤ t`), hence at most `t - s + 1` bad
  steps below `s - 1`;
* `cuts_card`: `#{c < s : cutP c} ≤ s/λ + (t - s + 1) + 1`;
* **`LJ_len_le`**: `|LJ s t λ w| ≤ 2w (s/λ + (t - s) + 4)` (every near-boundary position is within
  `w` of a cut or of `s`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.Side
open J6Seg J6Seg.Src

variable {s t lam : ℕ}

theorem rrZ_succ_ge (hs : 0 < s) (hst : s ≤ t) (m : ℕ) :
    rrZ s t ((m : ℤ) + 1) ≥ rrZ s t m + 1 := by
  unfold rrZ
  have h2s : (0 : ℤ) < 2 * s := by omega
  have e : (2 * (t : ℤ) * m + s + 1 * (2 * s)) / (2 * s) = (2 * (t : ℤ) * m + s) / (2 * s) + 1 :=
    Int.add_mul_ediv_right _ _ (by omega)
  rw [← e]
  apply Int.ediv_le_ediv h2s
  have : (s : ℤ) ≤ t := by exact_mod_cast hst
  nlinarith

/-- The end of a block is a cut or `s`. -/
theorem eB_cut_or (hs : 0 < s) {j : ℕ} (hj : j < s) :
    cutP s t lam (eB s t lam j) ∨ eB s t lam j = s := by
  have h := Nat.find_spec (enF_ex s t lam (stF s t lam j))
  have hle := eB_le (t := t) (lam := lam) hj
  unfold eB
  rcases h with h | h
  · left; unfold enF; rwa [Nat.add_assoc] at h
  · right; unfold eB at hle; unfold enF at hle ⊢; omega

end J6Seg.Side

end

section
-- Source module: Solutions.J6SegJCost1
/-!
# J cost 1: windows of the near-boundary list

* `LJ_cover`: every `j ∈ LJ` is within `w` of a cut `< s` or of `s`;
* `bad_Ico`: `s · #{l ∈ [a, a+Y) : ¬ stepOK l} < (t - s) Y + s`;
* `mult_Ico`: `#{c ∈ [a, a+Y) : λ ∣ c} ≤ Y/λ + 2`;
* **`win_le`**: `#{j ∈ LJ : x ≤ j ≤ x + X} ≤ 2w ((X+2w)/λ + 4 + (t-s)(X+2w+1)/s)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.Side
open J6Seg J6Seg.Src

variable {s t lam : ℕ}

/-- **Cover.** -/
theorem LJ_cover (hs : 0 < s) {w j : ℕ} (hj : j ∈ LJ s t lam w) :
    ∃ c, ((c < s ∧ cutP s t lam c) ∨ c = s) ∧ c - w ≤ j ∧ j < c + w := by
  unfold LJ Jlist at hj
  rw [List.mem_filter, List.mem_range] at hj
  obtain ⟨hjs, hn⟩ := hj
  have hjs' : j < s := hjs
  rw [nearB_eq, decide_eq_true_eq] at hn
  have hst' := stF_le (s := s) (t := t) (lam := lam) j
  rcases hn with h | h
  · exact ⟨stF s t lam j, Or.inl ⟨by omega, stF_cut j⟩, by omega, by omega⟩
  · have hlt := lt_eB (t := t) (lam := lam) hs hjs'
    have hle := eB_le (t := t) (lam := lam) hjs'
    rcases eB_cut_or (t := t) (lam := lam) hs hjs' with hc | hc
    · by_cases he : eB s t lam j = s
      · exact ⟨s, Or.inr rfl, by omega, by omega⟩
      · exact ⟨eB s t lam j, Or.inl ⟨by omega, hc⟩, by omega, by omega⟩
    · exact ⟨s, Or.inr rfl, by omega, by omega⟩

theorem rrZ_lo (hs : 0 < s) (x : ℤ) : 2 * (s : ℤ) * rrZ s t x ≤ 2 * t * x + s := by
  unfold rrZ; exact Int.mul_ediv_self_le (by omega)

theorem rrZ_hi (hs : 0 < s) (x : ℤ) : 2 * (t : ℤ) * x + s < 2 * s * rrZ s t x + 2 * s := by
  unfold rrZ; exact Int.lt_mul_ediv_self_add (by omega)

theorem bad_Ico_count (hs : 0 < s) (hst : s ≤ t) (a Y : ℕ) :
    ((((Ico a (a + Y)).filter (fun l => ¬ stepOK s t l)).card + Y : ℕ) : ℤ) ≤
      rrZ s t ((a + Y : ℕ) : ℤ) - rrZ s t (a : ℤ) := by
  induction Y with
  | zero => simp
  | succ Y ih =>
    rw [show a + (Y + 1) = (a + Y).succ by omega, Nat.Ico_succ_right_eq_insert_Ico (by omega),
      filter_insert]
    have hge := rrZ_succ_ge (t := t) hs hst (a + Y)
    by_cases h : stepOK s t (a + Y)
    · rw [if_neg (by simpa using h)]
      have e := (stepOK_iff hs (a + Y)).1 h
      push_cast at ih e ⊢
      linarith
    · rw [if_pos h, card_insert_of_notMem (by simp)]
      have hne : rrZ s t (((a + Y : ℕ) : ℤ) + 1) ≠ rrZ s t ((a + Y : ℕ) : ℤ) + 1 :=
        fun e => h ((stepOK_iff hs (a + Y)).2 e)
      push_cast at ih hne hge ⊢
      omega

/-- **Bad steps in a window.** -/
theorem bad_Ico (hs : 0 < s) (hst : s ≤ t) (a Y : ℕ) :
    s * ((Ico a (a + Y)).filter (fun l => ¬ stepOK s t l)).card < (t - s) * Y + s := by
  have h1 := bad_Ico_count (t := t) hs hst a Y
  have h2 := rrZ_lo (t := t) hs ((a + Y : ℕ) : ℤ)
  have h3 := rrZ_hi (t := t) hs (a : ℤ)
  generalize ((Ico a (a + Y)).filter (fun l => ¬ stepOK s t l)).card = b at *
  have e : ((t - s : ℕ) : ℤ) = (t : ℤ) - s := by push_cast [Nat.cast_sub hst]; ring
  have : ((s * b : ℕ) : ℤ) < (((t - s) * Y + s : ℕ) : ℤ) := by
    push_cast [e]
    push_cast at h1 h2 h3
    nlinarith
  exact_mod_cast this

/-- **Multiples of `λ` in a window.** -/
theorem mult_Ico (hl : 1 ≤ lam) (a Y : ℕ) :
    ((Ico a (a + Y)).filter (fun c => c % lam = 0)).card ≤ Y / lam + 2 := by
  have h : ((Ico a (a + Y)).filter (fun c => c % lam = 0)).card ≤
      (Ico (a / lam) ((a + Y) / lam + 1)).card := by
    apply card_le_card_of_injOn (fun c => c / lam)
    · intro c hc
      simp only [coe_filter, mem_Ico, Set.mem_ofPred_eq] at hc
      simp only [coe_Ico, Set.mem_Ico]
      exact ⟨Nat.div_le_div_right hc.1.1, Nat.lt_succ_of_le (Nat.div_le_div_right hc.1.2.le)⟩
    · intro x hx y hy hxy
      simp only [coe_filter, mem_Ico, Set.mem_ofPred_eq] at hx hy
      have h1 := Nat.div_add_mod x lam
      have h2 := Nat.div_add_mod y lam
      simp only at hxy
      rw [hx.2] at h1; rw [hy.2] at h2
      rw [← h1, ← h2, hxy]
  rw [Nat.card_Ico] at h
  have h3 : (a + Y) / lam ≤ a / lam + Y / lam + 1 := by
    rw [Nat.add_div (by omega)]; split_ifs <;> omega
  have h4 : a / lam ≤ (a + Y) / lam := Nat.div_le_div_right (by omega)
  omega

/-- Cuts in a window. -/
theorem cuts_Ico (hs : 0 < s) (hst : s ≤ t) (hl : 1 ≤ lam) (a Y : ℕ) :
    s * ((Ico a (a + Y)).filter (fun c => cutP s t lam c)).card <
      s * (Y / lam + 2) + (t - s) * (Y + 1) + s := by
  have hsub : (Ico a (a + Y)).filter (fun c => cutP s t lam c) ⊆
      ((Ico a (a + Y)).filter (fun c => c % lam = 0)) ∪
        (((Ico (a - 1) (a - 1 + (Y + 1))).filter (fun l => ¬ stepOK s t l)).image (· + 1)) := by
    intro c hc
    simp only [mem_filter, mem_Ico] at hc
    obtain ⟨hca, hcut⟩ := hc
    simp only [mem_union, mem_filter, mem_Ico, mem_image]
    rcases hcut with h | h | h
    · exact Or.inl ⟨hca, by subst h; simp⟩
    · exact Or.inl ⟨hca, h⟩
    · by_cases h0 : c = 0
      · exact Or.inl ⟨hca, by subst h0; simp⟩
      · exact Or.inr ⟨c - 1, ⟨⟨by omega, by omega⟩, h⟩, by omega⟩
  have h1 := card_le_card hsub
  have h2 := card_union_le ((Ico a (a + Y)).filter (fun c => c % lam = 0))
    ((((Ico (a - 1) (a - 1 + (Y + 1))).filter (fun l => ¬ stepOK s t l)).image (· + 1)))
  have h3 := card_image_le (s := (Ico (a - 1) (a - 1 + (Y + 1))).filter (fun l => ¬ stepOK s t l))
    (f := (· + 1))
  have h4 := mult_Ico hl a Y
  have h5 := bad_Ico (t := t) hs hst (a - 1) (Y + 1)
  generalize ((Ico a (a + Y)).filter (fun c => cutP s t lam c)).card = x at *
  generalize ((Ico (a - 1) (a - 1 + (Y + 1))).filter (fun l => ¬ stepOK s t l)).card = y at *
  have : x ≤ (Y / lam + 2) + y := by omega
  have := Nat.mul_le_mul_left s this
  rw [Nat.mul_add] at this
  omega

/-- **Window bound.** -/
theorem win_le_sol_aux (hs : 0 < s) (hst : s ≤ t) (hl : 1 ≤ lam) (w x X : ℕ) :
    s * ((LJ s t lam w).toFinset.filter (fun j => x ≤ j ∧ j ≤ x + X)).card ≤
      2 * w * (s * ((X + 2 * w) / lam + 3) + (t - s) * (X + 2 * w + 1) + s) := by
  set a := x + 1 - w with ha
  set Y := X + 2 * w with hY
  set Cs := ((Ico a (a + Y)).filter (fun c => cutP s t lam c)) ∪ {s} with hCs
  have hsub : (LJ s t lam w).toFinset.filter (fun j => x ≤ j ∧ j ≤ x + X) ⊆
      Cs.biUnion (fun c => Ico (c - w) (c + w)) := by
    intro j hj
    rw [mem_filter, List.mem_toFinset] at hj
    obtain ⟨hj, hx1, hx2⟩ := hj
    obtain ⟨c, hc, h1, h2⟩ := LJ_cover (t := t) (lam := lam) hs hj
    simp only [mem_biUnion, mem_Ico, hCs, mem_union, mem_filter, mem_singleton]
    refine ⟨c, ?_, h1, h2⟩
    rcases hc with ⟨-, hc⟩ | hc
    · exact Or.inl ⟨⟨by omega, by omega⟩, hc⟩
    · exact Or.inr hc
  have h2 : (Cs.biUnion (fun c => Ico (c - w) (c + w))).card ≤ Cs.card * (2 * w) := by
    refine (card_biUnion_le).trans ?_
    calc ∑ c ∈ Cs, (Ico (c - w) (c + w)).card ≤ ∑ c ∈ Cs, 2 * w := by
          apply sum_le_sum; intro c _; simp; omega
      _ = Cs.card * (2 * w) := by rw [sum_const, smul_eq_mul]
  have h3 : Cs.card ≤ ((Ico a (a + Y)).filter (fun c => cutP s t lam c)).card + 1 := by
    have := card_union_le ((Ico a (a + Y)).filter (fun c => cutP s t lam c)) {s}
    simp only [card_singleton] at this; exact this
  have h4 := cuts_Ico (t := t) hs hst hl a Y
  have hc := (card_le_card hsub).trans h2
  generalize ((LJ s t lam w).toFinset.filter (fun j => x ≤ j ∧ j ≤ x + X)).card = z at *
  generalize ((Ico a (a + Y)).filter (fun c => cutP s t lam c)).card = y at *
  generalize Cs.card = cs at *
  -- s z ≤ s cs 2w ≤ 2w (s y + s) < 2w (...)
  have e1 : s * z ≤ s * (cs * (2 * w)) := Nat.mul_le_mul_left s hc
  have e2 : s * cs ≤ s * y + s := by
    have := Nat.mul_le_mul_left s h3; rw [Nat.mul_add, mul_one] at this; exact this
  have e3 : s * y + s ≤ s * (Y / lam + 3) + (t - s) * (Y + 1) + s := by
    have : s * (Y / lam + 3) = s * (Y / lam + 2) + s := by ring
    omega
  calc s * z ≤ s * (cs * (2 * w)) := e1
    _ = 2 * w * (s * cs) := by ring
    _ ≤ 2 * w * (s * (Y / lam + 3) + (t - s) * (Y + 1) + s) :=
        Nat.mul_le_mul_left _ (e2.trans e3)

end J6Seg.Side

end

