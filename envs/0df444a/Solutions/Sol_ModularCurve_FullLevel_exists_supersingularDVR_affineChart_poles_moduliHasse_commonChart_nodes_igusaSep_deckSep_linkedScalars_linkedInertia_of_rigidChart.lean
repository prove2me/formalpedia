    apply Subtype.ext
    show σ f = ((φ ⟨τ (x : E), hτ (x : E) x.2⟩ : F₀) : F)
    rw [hστ, hφx]
  rw [memW₀, memW₀, h1, algEquiv_symm_toRingEquiv_apply_apply]
  have h2 : φ.symm.toRingEquiv ⟨f, hf⟩ = x := rfl
  rw [h2]
  have h3 : x = ⟨(x : E), x.2⟩ := rfl
  conv_lhs => rw [h3]
  exact hup (x : E) x.2 (hτ (x : E) x.2)

