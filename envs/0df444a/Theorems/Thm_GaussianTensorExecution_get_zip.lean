import Definitions.Def_GaussianLattice
import Definitions.Def_GaussianScalarCircuits
import Definitions.Def_GaussianTensorExecution
set_option autoImplicit true
open GaussianTensorExecution
open GaussianParity GaussianSynthesis

theorem GaussianTensorExecution.get_zip (n : Nat) (f : GInt → GInt → GInt)
    (u v : Cube n) (p : Path n) :
    get n (cubeZip f n u v) p = f (get n u p) (get n v p) := by sorry
