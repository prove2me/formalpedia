          intro i j hij
          have := hpP i j hij
          rw [hk i, hk j] at this
          have : k j ≤ k i := by exact_mod_cast this
          simp only [q]; have := hm.2 i; have := hm.2 j; omega
        have h1 := nat_pair R z hS _ q hq rfl
        have h2 : ∀ v, k v = m + (q v : ℤ) := by
          intro v; simp only [q]; have := hm.2 v; omega
        have h3 : ∑ v, z v * k v = m * ∑ v, z v + ∑ v, z v * (q v : ℤ) := by
          simp_rw [h2, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
          congr 1; apply Finset.sum_congr rfl; intro v _; ring
        rw [hsum, mul_zero, zero_add] at h3
        have h4 : ∑ v, z v * k v ≤ 0 := by rw [h3]; exact h1
        simp_rw [hk]; exact_mod_cast h4
      · have : IsEmpty V := not_nonempty_iff.1 hV
        simp
    have := convexHull_min hint hconv (show p ∈ convexHull ℝ (IntPts ∩ P R) by
      rw [← P_eq_hull]; exact hp)
    exact this

/-- smallest tight closed set containing `u`, etc. -/
lemma tight_inter (R : V → V → Prop) (z : V → ℤ) (hz : ∀ S, closedS R S → ∑ v ∈ S, z v ≤ 0)
    {S T : Finset V} (hS : closedS R S) (hT : closedS R T) (hS0 : ∑ v ∈ S, z v = 0)
    (hT0 : ∑ v ∈ T, z v = 0) :
    (closedS R (S ∩ T) ∧ ∑ v ∈ S ∩ T, z v = 0) ∧ (closedS R (S ∪ T) ∧ ∑ v ∈ S ∪ T, z v = 0) := by
  have cI : closedS R (S ∩ T) := by
    intro i j hij hj; rw [Finset.mem_inter] at hj ⊢; exact ⟨hS i j hij hj.1, hT i j hij hj.2⟩
  have cU : closedS R (S ∪ T) := by
    intro i j hij hj; rw [Finset.mem_union] at hj ⊢
    rcases hj with h | h
    · exact Or.inl (hS i j hij h)
    · exact Or.inr (hT i j hij h)
  have e := Finset.sum_union_inter (s₁ := S) (s₂ := T) (f := z)
  have h1 := hz _ cI; have h2 := hz _ cU
  refine ⟨⟨cI, ?_⟩, ⟨cU, ?_⟩⟩ <;> linarith

lemma exch (R : V → V → Prop) [DecidableRel R] (x y : V → ℤ) (hx : x ∈ Bset R)
    (hy : y ∈ Bset R) (u : V) (hu : y u < x u) :
    ∃ v, x v < y v ∧
      (fun w => x w - (if w = u then 1 else 0) + (if w = v then 1 else 0)) ∈ Bset R ∧
      (fun w => y w + (if w = u then 1 else 0) - (if w = v then 1 else 0)) ∈ Bset R := by
  classical
  obtain ⟨hxs, hxS⟩ := (charB R x).1 hx
  obtain ⟨hys, hyS⟩ := (charB R y).1 hy
  have cuniv : closedS R univ := fun _ _ _ _ => mem_univ _
  -- Sy : smallest y-tight closed set containing u
  let F : Finset (Finset V) :=
    univ.filter (fun S => closedS R S ∧ ∑ v ∈ S, y v = 0 ∧ u ∈ S)
  have hFne : F.Nonempty := ⟨univ, by simp [F, cuniv, hys]⟩
  let Sy := F.inf' hFne id
  have hSy : closedS R Sy ∧ ∑ v ∈ Sy, y v = 0 ∧ u ∈ Sy := by
    have := Finset.inf'_induction hFne id
      (p := fun S => closedS R S ∧ ∑ v ∈ S, y v = 0 ∧ u ∈ S) ?_ ?_
    · exact this
    · intro a ha b hb
      have := tight_inter R y hyS ha.1 hb.1 ha.2.1 hb.2.1
      exact ⟨this.1.1, this.1.2, Finset.mem_inter.2 ⟨ha.2.2, hb.2.2⟩⟩
    · intro S hS; simpa [F] using hS
  have hSy_min : ∀ A, closedS R A → ∑ v ∈ A, y v = 0 → u ∈ A → Sy ⊆ A := by
    intro A h1 h2 h3
    exact Finset.inf'_le id (by simp [F, h1, h2, h3])
  -- Ax : largest x-tight closed set not containing u
  let G : Finset (Finset V) :=
    univ.filter (fun A => closedS R A ∧ ∑ v ∈ A, x v = 0 ∧ u ∉ A)
  let Ax := G.sup id
  have hAx : closedS R Ax ∧ ∑ v ∈ Ax, x v = 0 ∧ u ∉ Ax := by
    have := Finset.sup_induction (s := G) (f := id)
      (p := fun A => closedS R A ∧ ∑ v ∈ A, x v = 0 ∧ u ∉ A) ?_ ?_ ?_
    · exact this
    · refine ⟨fun _ _ _ h => absurd h (Finset.notMem_empty _), by simp, by simp⟩
    · intro a ha b hb
      have := tight_inter R x hxS ha.1 hb.1 ha.2.1 hb.2.1
      refine ⟨this.2.1, this.2.2, ?_⟩
      show u ∉ a ⊔ b
      rw [Finset.sup_eq_union, Finset.mem_union]; push Not; exact ⟨ha.2.2, hb.2.2⟩
    · intro A hA; simpa [G] using hA
  have hAx_max : ∀ A, closedS R A → ∑ v ∈ A, x v = 0 → u ∉ A → A ⊆ Ax := by
    intro A h1 h2 h3
    exact Finset.le_sup (f := id) (by simp [G, h1, h2, h3])
  -- choose v
  have hv : ∃ v ∈ Sy, x v < y v ∧ v ∉ Ax := by
    by_contra hcon
    push Not at hcon
    -- every v ∈ Sy \ Ax has x v ≥ y v
    have hge : ∀ v ∈ Sy \ Ax, y v ≤ x v := by
      intro v hv
      rw [Finset.mem_sdiff] at hv
      by_contra h; push Not at h
      exact hv.2 (hcon v hv.1 h)
    have hpos : 0 < ∑ v ∈ Sy \ Ax, (x v - y v) := by
      have hu' : u ∈ Sy \ Ax := Finset.mem_sdiff.2 ⟨hSy.2.2, hAx.2.2⟩
      calc (0:ℤ) < x u - y u := by omega
        _ ≤ ∑ v ∈ Sy \ Ax, (x v - y v) :=
          Finset.single_le_sum (f := fun v => x v - y v)
            (fun v hv => by have := hge v hv; omega) hu'
    have hsd : ∑ v ∈ Sy \ Ax, (x v - y v) + ∑ v ∈ Sy ∩ Ax, (x v - y v)
        = ∑ v ∈ Sy, (x v - y v) := by
      rw [← Finset.sdiff_inter_self_left Sy Ax]
      exact Finset.sum_sdiff Finset.inter_subset_left
    have e := Finset.sum_union_inter (s₁ := Sy) (s₂ := Ax) (f := x)
    have cU : closedS R (Sy ∪ Ax) := by
      intro i j hij hj; rw [Finset.mem_union] at hj ⊢
      rcases hj with h | h
      · exact Or.inl (hSy.1 i j hij h)
      · exact Or.inr (hAx.1 i j hij h)
    have cI : closedS R (Sy ∩ Ax) := by
      intro i j hij hj; rw [Finset.mem_inter] at hj ⊢
      exact ⟨hSy.1 i j hij hj.1, hAx.1 i j hij hj.2⟩
    have h1 := hxS _ cU
    have h2 := hyS _ cI
    simp only [Finset.sum_sub_distrib] at hsd hpos
    linarith [hSy.2.1, hAx.2.1]
  obtain ⟨v, hvS, hvlt, hvA⟩ := hv
  have huv : u ≠ v := by rintro rfl; omega
  refine ⟨v, hvlt, ?_, ?_⟩
  · rw [charB]
    refine ⟨?_, ?_⟩
    · simp [Finset.sum_add_distrib, Finset.sum_sub_distrib, hxs]
    · intro A hA
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq']
      have hxA := hxS A hA
      by_cases hvA' : v ∈ A
      · by_cases huA : u ∈ A
        · simp [hvA', huA]; linarith
        · simp only [hvA', huA, if_true, if_false]
          have : ∑ w ∈ A, x w ≠ 0 := by
            intro h0; exact hvA (hAx_max A hA h0 huA hvA')
          omega
      · by_cases huA : u ∈ A
        · simp [hvA', huA]; linarith
        · simp [hvA', huA]; linarith
  · rw [charB]
    refine ⟨?_, ?_⟩
    · simp [Finset.sum_add_distrib, Finset.sum_sub_distrib, hys]
    · intro A hA
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_ite_eq']
      have hyA := hyS A hA
      by_cases huA : u ∈ A
      · by_cases hvA' : v ∈ A
        · simp [hvA', huA]; linarith
        · simp only [hvA', huA, if_true, if_false]
          have : ∑ w ∈ A, y w ≠ 0 := by
            intro h0; exact hvA' (hSy_min A hA h0 huA hvS)
          omega
      · by_cases hvA' : v ∈ A
        · simp [hvA', huA]; linarith
        · simp [hvA', huA]; linarith

end MCAux


namespace MCAux
open Finset

variable {V : Type*} [Fintype V] [DecidableEq V]

def g (i j : V) : V → ℤ := fun w => (if w = j then 1 else 0) - (if w = i then 1 else 0)

def emb (z : V → ℤ) : V → ℝ := fun v => (z v : ℝ)

lemma flow_eq (l : V → V → ℝ) : flow l = ∑ i, ∑ j, l i j • emb (g i j) := by
  funext w
  simp only [flow, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, emb, g]
  push_cast
  simp only [mul_sub, Finset.sum_sub_distrib, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
    Finset.mem_univ, if_true]
  congr 1
  symm
  rw [Finset.sum_eq_single w]
  · simp
  · intro i _ hi; apply Finset.sum_eq_zero; intro j _; rw [if_neg (Ne.symm hi)]
  · simp

lemma flow_add (l l' : V → V → ℝ) : flow (l + l') = flow l + flow l' := by
  funext w; simp only [flow, Pi.add_apply, Finset.sum_add_distrib]; ring

lemma flow_single (i j : V) :
    flow (fun a b => if a = i ∧ b = j then (1:ℝ) else 0) = emb (g i j) := by
  rw [flow_eq]
  rw [Finset.sum_eq_single i]
  · rw [Finset.sum_eq_single j]
    · simp
    · intro b _ hb; simp [hb]
    · simp
  · intro a _ ha; apply Finset.sum_eq_zero; intro b _; simp [ha]
  · simp

lemma g_mem_K (R : V → V → Prop) {i j : V} (h : R i j) : emb (g i j) ∈ K R := by
  rw [← flow_single]; exact single_mem_K R h

lemma K_add_g (R : V → V → Prop) {x : V → ℝ} (hx : x ∈ K R) {i j : V} (h : R i j) :
    x + emb (g i j) ∈ K R := by
  obtain ⟨l, hl0, hlR, rfl⟩ := hx
  obtain ⟨l', hl0', hlR', he⟩ := g_mem_K R h
  refine ⟨l + l', fun a b => by simp only [Pi.add_apply]; linarith [hl0 a b, hl0' a b],
    fun a b hab => by simp [hlR a b hab, hlR' a b hab], ?_⟩
  rw [flow_add, he]

lemma zero_mem_K (R : V → V → Prop) : (0 : V → ℝ) ∈ K R :=
  ⟨fun _ _ => 0, fun _ _ => le_refl _, fun _ _ _ => rfl, by funext w; simp [flow]⟩

lemma hullB (R : V → V → Prop) [DecidableRel R] :
    convexHull ℝ (emb '' Bset R) = K R := by
  apply le_antisymm
  · exact convexHull_min (by rintro _ ⟨z, hz, rfl⟩; exact hz) (K_convex R)
  · rintro x ⟨l, hl0, hlR, rfl⟩
    set N : ℕ := ⌈∑ i, ∑ j, l i j⌉₊ + 1 with hN
    have hNpos : (0:ℝ) < N := by positivity
    have hlt : ∑ i, ∑ j, l i j ≤ N := by
      have := Nat.le_ceil (∑ i, ∑ j, l i j); rw [hN]; push_cast; linarith
    let z : Option (V × V) → V → ℝ := fun o => match o with
      | none => 0
      | some (i, j) => if R i j then (N:ℝ) • emb (g i j) else 0
    let wt : Option (V × V) → ℝ := fun o => match o with
      | none => 1 - (∑ i, ∑ j, l i j) / N
      | some (i, j) => l i j / N
    have hz : ∀ o ∈ (univ : Finset (Option (V × V))), z o ∈ convexHull ℝ (emb '' Bset R) := by
      have h0 : (0 : V → ℝ) ∈ convexHull ℝ (emb '' Bset R) := by
        apply subset_convexHull; refine ⟨0, ?_, by funext v; simp [emb]⟩
        show emb 0 ∈ K R
        have : emb (0 : V → ℤ) = 0 := by funext v; simp [emb]
        rw [this]; exact zero_mem_K R
      rintro (_ | ⟨i, j⟩) _
      · exact h0
      · simp only [z]
        split_ifs with h
        · apply subset_convexHull
          refine ⟨fun w => (N:ℤ) * g i j w, ?_, ?_⟩
          · show emb _ ∈ K R
            obtain ⟨l', hl0', hlR', he⟩ := g_mem_K R h
            refine ⟨fun a b => (N:ℝ) * l' a b, fun a b => mul_nonneg hNpos.le (hl0' a b),
              fun a b hab => by simp [hlR' a b hab], ?_⟩
            funext w
            have := congrFun he w
            simp only [emb, flow] at this ⊢
            push_cast
            rw [this, ← Finset.mul_sum, ← Finset.mul_sum]; ring
          · funext w; simp [emb]
        · exact h0
    have hw0 : ∀ o ∈ (univ : Finset (Option (V × V))), 0 ≤ wt o := by
      rintro (_ | ⟨i, j⟩) _
      · simp only [wt]; rw [sub_nonneg, div_le_one hNpos]; exact hlt
      · simp only [wt]; exact div_nonneg (hl0 i j) hNpos.le
    have hw1 : ∑ o, wt o = 1 := by
      rw [Fintype.sum_option]; simp only [wt]
      rw [Fintype.sum_prod_type]; simp only
      have : ∑ x, ∑ y, l x y / (N:ℝ) = (∑ x, ∑ y, l x y) / N := by
        rw [Finset.sum_div]; apply Finset.sum_congr rfl; intro x _; rw [Finset.sum_div]
      rw [this]; ring
    have := (convex_convexHull ℝ (emb '' Bset R)).sum_mem hw0 hw1 hz
    convert this using 1
    rw [Fintype.sum_option]; simp only [wt, z, smul_zero, zero_add]
    rw [Fintype.sum_prod_type, flow_eq]
    apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _
    simp only
    split_ifs with h
    · rw [smul_smul, div_mul_cancel₀ _ hNpos.ne']
    · simp [hlR i j h]

end MCAux


namespace MCAux
open Finset

variable {V : Type*} [Fintype V] [DecidableEq V]

def ev (u : V) : V → ℤ := fun w => if w = u then 1 else 0

lemma cone_add {C : Set (V → ℝ)} (hc : Convex ℝ C)
    (hs : ∀ x ∈ C, ∀ t : ℝ, 0 ≤ t → t • x ∈ C) {x y : V → ℝ} (hx : x ∈ C) (hy : y ∈ C) :
    x + y ∈ C := by
  have h1 := hc hx hy (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num : (0:ℝ) ≤ 1/2) (by norm_num)
  have h2 := hs _ h1 2 (by norm_num)
  convert h2 using 1
  rw [smul_add, smul_smul, smul_smul]; norm_num

theorem forward (C : Set (V → ℝ)) (B : Set (V → ℤ)) (hC : C = convexHull ℝ (emb '' B))
    (hs : ∀ x ∈ C, ∀ t : ℝ, 0 ≤ t → t • x ∈ C) (hB0 : (0 : V → ℤ) ∈ B)
    (hex : ∀ x ∈ B, ∀ y ∈ B, ∀ u, y u < x u → ∃ v, x v < y v ∧
      (fun w => x w - ev u w + ev v w) ∈ B ∧ (fun w => y w + ev u w - ev v w) ∈ B) :
    C = K (fun i j => emb (g i j) ∈ C) := by
  classical
  set R : V → V → Prop := fun i j => emb (g i j) ∈ C with hR
  have hconv : Convex ℝ C := hC ▸ convex_convexHull ℝ _
  have hsub : emb '' B ⊆ C := hC ▸ subset_convexHull ℝ _
  apply le_antisymm
  · rw [hC]
    apply convexHull_min _ (K_convex R)
    rintro _ ⟨x, hx, rfl⟩
    suffices h : ∀ n, ∀ x ∈ B, ∑ v, (x v).natAbs = n → emb x ∈ K R from h _ x hx rfl
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
    intro x hx hn
    by_cases h0 : ∀ v, x v = 0
    · have : emb x = 0 := by funext v; simp [emb, h0]
      rw [this]; exact zero_mem_K R
    push Not at h0
    obtain ⟨u, hu⟩ := h0
    rcases lt_or_gt_of_ne hu with hneg | hpos
    · obtain ⟨v, hv, h1, h2⟩ := hex 0 hB0 x hx u (by simpa using hneg)
      simp only [Pi.zero_apply] at hv
      have huv : u ≠ v := by rintro rfl; omega
      have hRuv : R u v := by
        show emb (g u v) ∈ C
        apply hsub; refine ⟨_, h1, ?_⟩; funext w; simp only [emb, g, ev, Pi.zero_apply]; push_cast
        ring
      have hlt : ∑ w, (x w + ev u w - ev v w).natAbs < n := by
        rw [← hn]
        apply Finset.sum_lt_sum
        · intro w _
          by_cases hwu : w = u
          · subst hwu; simp [ev, huv]; omega
          · by_cases hwv : w = v
            · subst hwv; simp [ev, hwu]; omega
            · simp [ev, hwu, hwv]
        · exact ⟨u, mem_univ _, by simp [ev, huv]; omega⟩
      have := ih _ hlt _ h2 rfl
      have e : emb x = emb (fun w => x w + ev u w - ev v w) + emb (g u v) := by
        funext w; simp only [emb, g, ev, Pi.add_apply]; push_cast; ring
      rw [e]; exact K_add_g R this hRuv
    · obtain ⟨v, hv, h1, h2⟩ := hex x hx 0 hB0 u (by simpa using hpos)
      simp only [Pi.zero_apply] at hv
      have huv : u ≠ v := by rintro rfl; omega
      have hRvu : R v u := by
        show emb (g v u) ∈ C
        apply hsub; refine ⟨_, h2, ?_⟩; funext w; simp only [emb, g, ev, Pi.zero_apply]; push_cast
        ring
      have hlt : ∑ w, (x w - ev u w + ev v w).natAbs < n := by
        rw [← hn]
        apply Finset.sum_lt_sum
        · intro w _
          by_cases hwu : w = u
          · subst hwu; simp [ev, huv]; omega
          · by_cases hwv : w = v
            · subst hwv; simp [ev, hwu]; omega
            · simp [ev, hwu, hwv]
        · exact ⟨u, mem_univ _, by simp [ev, huv]; omega⟩
      have := ih _ hlt _ h1 rfl
      have e : emb x = emb (fun w => x w - ev u w + ev v w) + emb (g v u) := by
        funext w; simp only [emb, g, ev, Pi.add_apply]; push_cast; ring
      rw [e]; exact K_add_g R this hRvu
  · rintro _ ⟨l, hl0, hlR, rfl⟩
    rw [flow_eq]
    have h0 : (0 : V → ℝ) ∈ C := by
      have := hsub ⟨0, hB0, rfl⟩
      have e : emb (0 : V → ℤ) = 0 := by funext v; simp [emb]
      rwa [e] at this
    apply Finset.sum_induction _ (· ∈ C) (fun a b ha hb => cone_add hconv hs ha hb) h0
    intro i _
    apply Finset.sum_induction _ (· ∈ C) (fun a b ha hb => cone_add hconv hs ha hb) h0
    intro j _
    by_cases h : R i j
    · exact hs _ h _ (hl0 i j)
    · rw [hlR i j h, zero_smul]; exact h0

lemma exge (D : Set (V → ℤ)) {y : V → ℝ} (hy : y ∈ convexHull ℝ (emb '' D)) (i k : V) :
    ∃ d ∈ D, y i - y k ≤ (d i : ℝ) - d k := by
  have hf : ConvexOn ℝ Set.univ (fun p : V → ℝ => p i - p k) := by
    refine ⟨convex_univ, ?_⟩
    intro x _ z _ a b _ _ _
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    exact le_of_eq (by ring)
  obtain ⟨z, ⟨d, hd, rfl⟩, hz⟩ := hf.exists_ge_of_mem_convexHull (Set.subset_univ _) hy
  exact ⟨d, hd, by simpa [emb] using hz⟩

theorem lside (D : Set (V → ℤ)) (hne : D.Nonempty)
    (hmax : ∀ p ∈ D, ∀ q ∈ D, (fun v => max (p v) (q v)) ∈ D)
    (hmin : ∀ p ∈ D, ∀ q ∈ D, (fun v => min (p v) (q v)) ∈ D)
    (htr : ∀ p ∈ D, (fun v => p v + 1) ∈ D ∧ (fun v => p v - 1) ∈ D)
    (hs : ∀ y ∈ convexHull ℝ (emb '' D), ∀ t : ℝ, 0 ≤ t → t • y ∈ convexHull ℝ (emb '' D)) :
    convexHull ℝ (emb '' D) = P (fun i j => ∀ d ∈ D, d j ≤ d i) := by
  classical
  set R : V → V → Prop := fun i j => ∀ d ∈ D, d j ≤ d i with hR
  apply le_antisymm
  · apply convexHull_min _ (P_convex R)
    rintro _ ⟨d, hd, rfl⟩ i j h
    simp only [emb]; exact_mod_cast h d hd
  rw [P_eq_hull]
  apply convexHull_mono
  rintro p ⟨hpi, hpP⟩
  choose k hk using hpi
  have hpk : p = emb k := funext hk
  subst hpk
  refine ⟨k, ?_, rfl⟩
  have hq : ∀ i j, R i j → k j ≤ k i := by
    intro i j h; have := hpP i j h; simp only [emb] at this; exact_mod_cast this
  -- translations
  have htrans : ∀ d ∈ D, ∀ c : ℤ, (fun v => d v + c) ∈ D := by
    intro d hd c
    induction c using Int.induction_on with
    | zero => simpa using hd
    | succ c ih =>
      have := (htr _ ih).1
      convert this using 1; funext v; push_cast; ring
    | pred c ih =>
      have := (htr _ ih).2
      convert this using 1; funext v; push_cast; ring
  have pair : ∀ i j, ∃ d ∈ D, k i - k j ≤ d i - d j := by
    intro i j
    by_cases hRji : R j i
    · obtain ⟨d0, hd0⟩ := hne
      have h0 : (0 : V → ℝ) ∈ convexHull ℝ (emb '' D) := by
        have := hs _ (subset_convexHull ℝ _ ⟨d0, hd0, rfl⟩) 0 le_rfl
        simpa using this
      obtain ⟨d, hd, h⟩ := exge D h0 i j
      refine ⟨d, hd, ?_⟩
      have h1 : (0:ℤ) ≤ d i - d j := by
        simp only [Pi.zero_apply, sub_zero] at h; exact_mod_cast (by linarith : (0:ℝ) ≤ d i - d j)
      have := hq j i hRji
      omega
    · simp only [hR, not_forall, not_le] at hRji
      obtain ⟨d0, hd0, hlt⟩ := hRji
      set N : ℕ := (k i - k j).toNat with hN
      have hy := hs _ (subset_convexHull ℝ _ ⟨d0, hd0, rfl⟩) N (Nat.cast_nonneg _)
      obtain ⟨d, hd, h⟩ := exge D hy i j
      refine ⟨d, hd, ?_⟩
      simp only [Pi.smul_apply, smul_eq_mul, emb] at h
      have h2 : ((N:ℤ) * (d0 i - d0 j) : ℤ) ≤ d i - d j := by
        have : ((N:ℝ) * ((d0 i:ℝ) - d0 j)) ≤ (d i:ℝ) - d j := by linarith
        exact_mod_cast this
      have h3 : (N:ℤ) ≤ (N:ℤ) * (d0 i - d0 j) :=
        le_mul_of_one_le_right (by positivity) (by omega)
      have h4 : k i - k j ≤ (N:ℤ) := by rw [hN]; omega
      omega
  choose dd hdd hdq using pair
  let t : V → V → V → ℤ := fun i j v => dd i j v + (k i - dd i j i)
  have ht : ∀ i j, t i j ∈ D := fun i j => htrans _ (hdd i j) _
  have hti : ∀ i j, t i j i = k i := by intro i j; simp only [t]; ring
  have htj : ∀ i j, t i j j ≤ k j := by intro i j; simp only [t]; have := hdq i j; omega
  by_cases hV : Nonempty V
  swap
  · obtain ⟨d0, hd0⟩ := hne
    have : k = d0 := funext fun v => (hV ⟨v⟩).elim
    rw [this]; exact hd0
  have hU : (univ : Finset V).Nonempty := univ_nonempty
  let s : V → V → ℤ := fun i => univ.inf' hU (t i)
  have hsD : ∀ i, s i ∈ D := by
    intro i
    apply Finset.inf'_induction hU (t i) (p := (· ∈ D))
    · intro a ha b hb; exact hmin a ha b hb
    · intro j _; exact ht i j
  have hs_apply : ∀ i v, s i v = univ.inf' hU (fun j => t i j v) := by
    intro i v; simp only [s]; rw [Finset.inf'_apply]
  have hsii : ∀ i, s i i = k i := by
    intro i; rw [hs_apply]
    apply le_antisymm
    · exact (Finset.inf'_le _ (mem_univ i)).trans (le_of_eq (hti i i))
    · exact Finset.le_inf' _ _ (fun j _ => le_of_eq (hti i j).symm)
  have hsik : ∀ i j, s i j ≤ k j := by
    intro i j; rw [hs_apply]; exact (Finset.inf'_le _ (mem_univ j)).trans (htj i j)
  have hfin : univ.sup' hU s = k := by
    funext v; rw [Finset.sup'_apply]
    apply le_antisymm
    · exact Finset.sup'_le _ _ (fun i _ => hsik i v)
    · exact (le_of_eq (hsii v).symm).trans (Finset.le_sup' (fun i => s i v) (mem_univ v))
  rw [← hfin]
  apply Finset.sup'_induction hU s (p := (· ∈ D))
  · intro a ha b hb; exact hmax a ha b hb
  · intro i _; exact hsD i

end MCAux


namespace MCFinal
open Finset MCAux DiscreteConvex.ConjugacyDualityB

variable {V : Type*} [Fintype V] [DecidableEq V]

lemma ind_single (u w : V) : IndicatorVec ({u} : Finset V) w = ev u w := by
  simp [IndicatorVec, ev]

lemma polar_eq (C : Set (V → ℝ)) : PolarCone C = MCAux.polar C := rfl

lemma intEmbed_eq (D : Set (V → ℤ)) :
    DiscreteConvex.ConjugacyDualityB.IntEmbed D = emb '' D := rfl

lemma polar_isCone (C : Set (V → ℝ)) : IsCone (PolarCone C) := by
  refine ⟨fun x _ => by simp, fun y hy t ht x hx => ?_⟩
  have := hy x hx
  have e : ∑ v, t * y v * x v = t * ∑ v, y v * x v := by
    rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro v _; ring
  rw [e]; exact mul_nonpos_of_nonneg_of_nonpos ht this

lemma cone_smul {C : Set (V → ℝ)} (hC : IsCone C) :
    ∀ x ∈ C, ∀ t : ℝ, 0 ≤ t → t • x ∈ C := by
  intro x hx t ht
  have := hC.2 x hx t ht
  convert this using 1
  funext v; simp

theorem fwd (C : Set (V → ℝ)) (hM : IsMConvexCone C) : IsLConvexCone (PolarCone C) := by
  classical
  obtain ⟨hcone, B, hexB, hCB⟩ := hM
  rw [intEmbed_eq] at hCB
  have h0C : (0 : V → ℝ) ∈ C := hcone.1
  have hBne : B.Nonempty := by
    by_contra h
    rw [Set.not_nonempty_iff_eq_empty] at h
    rw [hCB, h, Set.image_empty, convexHull_empty] at h0C
    exact h0C
  -- hole-freeness gives 0 ∈ B
  have hexB' : DiscreteConvex.MConvexSetsB.ExchangeAxiomB B := by
    intro x hx y hy u hu
    have hu0 : y u < x u := hu
    have hu' : u ∈ SuppPos x y := by simp [SuppPos, hu0]
    obtain ⟨v, hv, h1, h2⟩ := hexB x hx y hy u hu'
    have hv0 : x v < y v := by simpa [SuppNeg] using hv
    refine ⟨v, hv0, ?_, ?_⟩
    · have e : (fun w => x w - DiscreteConvex.MConvexSetsB.CharVec u w +
          DiscreteConvex.MConvexSetsB.CharVec v w) =
          (fun w => x w - IndicatorVec {u} w + IndicatorVec {v} w) := by
        funext w; simp [DiscreteConvex.MConvexSetsB.CharVec, IndicatorVec]
      rw [e]; exact h1
    · have e : (fun w => y w + DiscreteConvex.MConvexSetsB.CharVec u w -
          DiscreteConvex.MConvexSetsB.CharVec v w) =
          (fun w => y w + IndicatorVec {u} w - IndicatorVec {v} w) := by
        funext w; simp [DiscreteConvex.MConvexSetsB.CharVec, IndicatorVec]
      rw [e]; exact h2
  have hhole := DiscreteConvex.MConvexSetsB.mconvex_hole_free B hexB' hBne
  have hB0 : (0 : V → ℤ) ∈ B := by
    have : (0 : V → ℝ) ∈ DiscreteConvex.MConvexSetsB.IntEmbed B := by
      rw [hhole]
      refine ⟨?_, fun v => ⟨0, by simp⟩⟩
      have : DiscreteConvex.MConvexSetsB.IntEmbed B = emb '' B := rfl
      rw [this, ← hCB]; exact h0C
    obtain ⟨z, hz, hz0⟩ := this
    have : z = 0 := by
      funext v; have := congrFun hz0 v; simp at this; simpa using this
    rw [← this]; exact hz
  have hex : ∀ x ∈ B, ∀ y ∈ B, ∀ u, y u < x u → ∃ v, x v < y v ∧
      (fun w => x w - ev u w + ev v w) ∈ B ∧ (fun w => y w + ev u w - ev v w) ∈ B := by
    intro x hx y hy u hu
    have hu' : u ∈ SuppPos x y := by simp [SuppPos, hu]
    obtain ⟨v, hv, h1, h2⟩ := hexB x hx y hy u hu'
    refine ⟨v, by simpa [SuppNeg] using hv, ?_, ?_⟩
    · have e : (fun w => x w - IndicatorVec {u} w + IndicatorVec {v} w) =
          (fun w => x w - ev u w + ev v w) := by funext w; rw [ind_single, ind_single]
      rw [← e]; exact h1
    · have e : (fun w => y w + IndicatorVec {u} w - IndicatorVec {v} w) =
          (fun w => y w + ev u w - ev v w) := by funext w; rw [ind_single, ind_single]
      rw [← e]; exact h2
  have hK := MCAux.forward C B hCB (cone_smul hcone) hB0 hex
  set R : V → V → Prop := fun i j => emb (g i j) ∈ C
  have hpol : PolarCone C = P R := by rw [polar_eq, hK]; exact polarK_eq R
  refine ⟨polar_isCone C, {d : V → ℤ | emb d ∈ P R}, ⟨⟨0, ?_⟩, ?_, ?_⟩, ?_⟩
  · intro i j _; simp [emb]
  · intro p hp q hq
    refine ⟨?_, ?_⟩
    · intro i j h
      have h1 := hp i j h; have h2 := hq i j h
      simp only [emb, Int.cast_max] at h1 h2 ⊢
      exact max_le_max h1 h2
    · intro i j h
      have h1 := hp i j h; have h2 := hq i j h
      simp only [emb, Int.cast_min] at h1 h2 ⊢
      exact min_le_min h1 h2
  · intro p hp
    refine ⟨?_, ?_⟩
    · intro i j h; have := hp i j h; simp only [emb] at this ⊢; push_cast; linarith
    · intro i j h; have := hp i j h; simp only [emb] at this ⊢; push_cast; linarith
  · rw [hpol, intEmbed_eq]
    conv_lhs => rw [P_eq_hull]
    congr 1
    ext p; constructor
    · rintro ⟨hpi, hpP⟩
      choose k hk using hpi
      have : p = emb k := funext hk
      subst this
      exact ⟨k, hpP, rfl⟩
    · rintro ⟨d, hd, rfl⟩
      exact ⟨fun v => ⟨d v, rfl⟩, hd⟩

theorem bwd (C : Set (V → ℝ)) (hC : IsCone C) (hpoly : IsPolyhedronW C)
    (hL : IsLConvexCone (PolarCone C)) : IsMConvexCone C := by
  classical
  obtain ⟨hcone', D, ⟨hne, hlat, htr⟩, hPD⟩ := hL
  rw [intEmbed_eq] at hPD
  have hs' : ∀ y ∈ convexHull ℝ (emb '' D), ∀ t : ℝ, 0 ≤ t →
      t • y ∈ convexHull ℝ (emb '' D) := by
    rw [← hPD]; exact cone_smul hcone'
  have hside := MCAux.lside D hne (fun p hp q hq => (hlat p hp q hq).1)
    (fun p hp q hq => (hlat p hp q hq).2) htr hs'
  set R : V → V → Prop := fun i j => ∀ d ∈ D, d j ≤ d i
  have hpol : PolarCone C = P R := hPD.trans hside
  have hCK : C = K R := by
    apply le_antisymm
    · intro x hx
      apply polarP_sub_K R
      intro p hp
      rw [← hpol] at hp
      have := hp x hx
      calc ∑ v, x v * p v = ∑ v, p v * x v := by
            apply Finset.sum_congr rfl; intro v _; ring
        _ ≤ 0 := this
    · obtain ⟨m, a, b, hCeq⟩ := hpoly
      have h0 : (0 : V → ℝ) ∈ C := hC.1
      have hb0 : ∀ i, 0 ≤ b i := by
        intro i; rw [hCeq] at h0; simpa using h0 i
      have ha : ∀ i, a i ∈ P R := by
        intro i
        rw [← hpol]
        intro x hx
        by_contra hpos
        push Not at hpos
        set s := ∑ v, a i v * x v with hsdef
        set t := (|b i| + 1) / s with htdef
        have ht : 0 ≤ t := by positivity
        have hx' := hC.2 x hx t ht
        rw [hCeq] at hx'
        have h1 := hx' i
        have e : ∑ w, a i w * (t * x w) = t * s := by
          rw [hsdef, Finset.mul_sum]; apply Finset.sum_congr rfl; intro w _; ring
        rw [e, htdef, div_mul_cancel₀ _ hpos.ne'] at h1
        have := le_abs_self (b i)
        linarith
      intro x hx
      rw [hCeq]
      intro i
      have := K_sub_polarP R hx (a i) (ha i)
      have e : ∑ w, a i w * x w = ∑ v, x v * a i v := by
        apply Finset.sum_congr rfl; intro v _; ring
      rw [e]; linarith [hb0 i]
  refine ⟨hC, Bset R, ?_, ?_⟩
  · intro x hx y hy u hu
    have hu' : y u < x u := by simpa [SuppPos] using hu
    obtain ⟨v, hv, h1, h2⟩ := MCAux.exch R x y hx hy u hu'
    refine ⟨v, by simp [SuppNeg, hv], ?_, ?_⟩
    · have e : (fun w => x w - IndicatorVec {u} w + IndicatorVec {v} w) =
          (fun w => x w - (if w = u then 1 else 0) + (if w = v then 1 else 0)) := by
        funext w; rw [ind_single, ind_single]; rfl
      rw [e]; exact h1
    · have e : (fun w => y w + IndicatorVec {u} w - IndicatorVec {v} w) =
          (fun w => y w + (if w = u then 1 else 0) - (if w = v then 1 else 0)) := by
        funext w; rw [ind_single, ind_single]; rfl
      rw [e]; exact h2
  · rw [intEmbed_eq, hullB, hCK]

end MCFinal

namespace DiscreteConvex.ConjugacyDualityB
open Classical
open scoped Pointwise

theorem m_cone_main {V : Type*} [Fintype V] [DecidableEq V] (C : Set (V → ℝ)) (hC : IsCone C)
    (hpoly : IsPolyhedronW C) :
    IsMConvexCone C ↔ IsLConvexCone (PolarCone C) :=
  ⟨MCFinal.fwd C, MCFinal.bwd C hC hpoly⟩

end DiscreteConvex.ConjugacyDualityB

open DiscreteConvex.ConjugacyDualityB in
theorem solution {V : Type*} [Fintype V] [DecidableEq V] (C : Set (V → ℝ)) (hC : IsCone C)
    (hpoly : IsPolyhedronW C) :
    IsMConvexCone C ↔ IsLConvexCone (PolarCone C) :=
  m_cone_main C hC hpoly
