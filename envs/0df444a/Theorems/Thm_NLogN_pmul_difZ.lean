variable (n : ℕ)

theorem NLogN.pmul_difZ (j E : ℕ) (hjE : j = 0 ∨ 2 ^ j * E = 2 * n) (A B : List ℤ)
    (hA : A.length = 2 ^ j) (hB : B.length = 2 ^ j) :
    pmulZ (2 ^ n + 1) (difZ (2 ^ n + 1) E j A) (difZ (2 ^ n + 1) E j B) =
      difZ (2 ^ n + 1) E j (cycZ (2 ^ n + 1) (2 ^ j) A B) := by sorry
