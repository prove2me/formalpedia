private scoped instance (priority := high) instMulActionT : MulAction ℤ_[lam] (ModularCurve.TateModule lam (JZero M)) :=
  Module.toDistribMulAction.toMulAction

private scoped instance (priority := high) instSMulT : SMul ℤ_[lam] (ModularCurve.TateModule lam (JZero M)) :=
  Module.toDistribMulAction.toMulAction.toSMul

omit [Fact lam.Prime] [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))] in
private theorem levels_mem (x : ModularCurve.TateModule lam (JZero M)) (k : ℕ) :
    (x : ℕ → JZero M) k ∈ OrdConnFit.lvl (JZero M) lam k := by
  rw [OrdConnFit.mem_lvl_iff, ← Nat.cast_pow, natCast_zsmul]
  exact ModularCurve.TateModule.pow_smul_apply x.2 k

private def sπ (x : ℕ → JZero M) (hx : ∀ k, x k ∈ OrdConnFit.lvl (JZero M) lam k) :
    ℕ → JZero M :=
  OrdConnFit.seqπ lam (fT (M := M) lam) (finite_lvl (M := M) lam) x hx

omit [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))] in
private theorem sπ_mem_tate (x : ModularCurve.TateModule lam (JZero M)) :
    sπ lam (x : ℕ → JZero M) (levels_mem lam x) ∈ ModularCurve.TateModule lam (JZero M) := by
  refine ModularCurve.TateModule.mem_iff.mpr ⟨?_, fun n => ?_⟩
  · exact OrdConnFit.seqπ_zero_of_eq_zero lam (fT lam) (finite_lvl lam) _ (levels_mem lam x) 0 x.2.1
  · have h := OrdConnFit.seqπ_compat lam (fT lam) (finite_lvl lam) (x : ℕ → JZero M)
      (levels_mem lam x) (fun k => by rw [natCast_zsmul]; exact x.2.2 k) n
    rw [natCast_zsmul] at h
    exact h

private def πTfun (x : ModularCurve.TateModule lam (JZero M)) : ModularCurve.TateModule lam (JZero M) :=
  ⟨sπ lam (x : ℕ → JZero M) (levels_mem lam x), sπ_mem_tate lam x⟩

omit [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))] in
private theorem πTfun_coe (x : ModularCurve.TateModule lam (JZero M)) (k : ℕ) :
    ((πTfun lam x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) k =
      sπ lam (x : ℕ → JZero M) (levels_mem lam x) k := rfl

omit [Module ℤ_[lam] (ModularCurve.TateModule lam (JZero M))] in
private theorem πTfun_add (x y : ModularCurve.TateModule lam (JZero M)) : πTfun lam (x + y) = πTfun lam x + πTfun lam y := by
  apply Subtype.ext
  funext k
  rw [Submodule.coe_add, Pi.add_apply, πTfun_coe, πTfun_coe, πTfun_coe]
  exact (OrdConnFit.seqπ_congr lam (fT lam) (finite_lvl lam) _ _ _ _ (fun k => rfl) k).trans
    (OrdConnFit.seqπ_add lam (fT lam) (finite_lvl lam) _ _ (levels_mem lam x) (levels_mem lam y) k)

include hsmul in
private theorem πTfun_smul (a : ℤ_[lam]) (x : ModularCurve.TateModule lam (JZero M)) :
    πTfun lam (a • x) = a • πTfun lam x := by
  apply Subtype.ext
  funext k
  rw [hsmul a (πTfun lam x) k, πTfun_coe, πTfun_coe]
  have hmem : ∀ k, (PadicInt.toZModPow k a).val • (x : ℕ → JZero M) k ∈
      OrdConnFit.lvl (JZero M) lam k := fun k => by
    rw [← hsmul a x k]; exact levels_mem lam (a • x) k
  unfold sπ
  rw [← OrdConnFit.seqπ_levelSmul lam (fT lam) (finite_lvl lam) (fun k => (PadicInt.toZModPow k a).val)
    (x : ℕ → JZero M) (levels_mem lam x) k hmem]
  exact OrdConnFit.seqπ_congr lam (fT lam) (finite_lvl lam) _ _ _ _ (fun k => hsmul a x k) k

private def πT : ModularCurve.TateModule lam (JZero M) →ₗ[ℤ_[lam]] ModularCurve.TateModule lam (JZero M) where
  toFun := πTfun lam
  map_add' := πTfun_add lam
  map_smul' := πTfun_smul lam hsmul

private theorem πT_coe (x : ModularCurve.TateModule lam (JZero M)) (k : ℕ) :
    ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) k =
      sπ lam (x : ℕ → JZero M) (levels_mem lam x) k := rfl

private theorem πT_idem (x : ModularCurve.TateModule lam (JZero M)) : πT lam hsmul (πT lam hsmul x) = πT lam hsmul x := by
  apply Subtype.ext
  funext k
  rw [πT_coe, πT_coe]
  exact (OrdConnFit.seqπ_congr lam (fT lam) (finite_lvl lam) _ _ _
      (OrdConnFit.seqπ_mem lam (fT lam) (finite_lvl lam) _ (levels_mem lam x)) (fun k => rfl) k).trans
    (OrdConnFit.seqπ_seqπ lam (fT lam) (finite_lvl lam) _ (levels_mem lam x) k)

private theorem πT_comm (x : ModularCurve.TateModule lam (JZero M)) :
    heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) (πT lam hsmul x) =
      πT lam hsmul (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) x) := by
  apply Subtype.ext
  funext k
  change heckeGen ⟨lam, Fact.out⟩ • (sπ lam (x : ℕ → JZero M) (levels_mem lam x) k) =
    sπ lam ((heckeGen ⟨lam, Fact.out⟩ • x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M)
      (levels_mem lam _) k
  rw [← fT_apply lam]
  symm
  exact (OrdConnFit.seqπ_congr lam (fT lam) (finite_lvl lam) _ (fun k => fT lam ((x : ℕ → JZero M) k)) _
      (fun k => OrdConnFit.map_mem_lvl lam (fT lam) (levels_mem lam x k)) (fun k => rfl) k).trans
    (OrdConnFit.seqπ_map lam (fT lam) (finite_lvl lam) _ (levels_mem lam x) k)

private def nilSub : AddSubgroup (JZero M) where
  carrier := {v | ∃ n, (fT (M := M) lam ^ n) v = 0}
  add_mem' := by
    rintro v w ⟨a, ha⟩ ⟨b, hb⟩
    refine ⟨a + b, ?_⟩
    rw [map_add, pow_add, Module.End.mul_apply, Module.End.mul_apply, hb, map_zero, add_zero,
      ← Module.End.mul_apply, ← pow_add, add_comm, pow_add, Module.End.mul_apply, ha, map_zero]
  zero_mem' := ⟨0, by simp⟩
  neg_mem' := by
    rintro v ⟨a, ha⟩
    exact ⟨a, by rw [map_neg, ha, neg_zero]⟩

private theorem πT_nil :
    ∃ m : ℕ, ∀ x ∈ LinearMap.ker (πT lam hsmul), ∃ y ∈ LinearMap.ker (πT lam hsmul),
      (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) ^ m) x = (lam : ℤ_[lam]) • y := by
  have hbound := OrdConnFit.exists_nil_bound lam (fT (M := M) lam) (finite_lvl lam)
  obtain ⟨m, hm⟩ := hbound
  refine ⟨m, fun x hx => ?_⟩
  have hx0 : πT lam hsmul x = 0 := LinearMap.mem_ker.mp hx

  have hxnil : ∀ k, ∃ n, (fT (M := M) lam ^ n) ((x : ℕ → JZero M) k) = 0 := by
    intro k
    have hk : sπ lam (x : ℕ → JZero M) (levels_mem lam x) k = 0 := by
      have h := congrArg (fun y : ModularCurve.TateModule lam (JZero M) => (y : ℕ → JZero M) k) hx0
      simp only [πT_coe, Submodule.coe_zero, Pi.zero_apply] at h
      exact h
    exact (OrdConnFit.seqπ_eq_zero_iff lam (fT lam) (finite_lvl lam) _ (levels_mem lam x) k).mp hk

  let z : ModularCurve.TateModule lam (JZero M) := (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) ^ m) x
  have hzk : ∀ k, (z : ℕ → JZero M) k = (fT (M := M) lam ^ m) ((x : ℕ → JZero M) k) := by
    intro k
    show (((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) ^ m) x : ModularCurve.TateModule lam (JZero M)) :
      ℕ → JZero M) k = _
    rw [heckeEndZp_pow_apply_coe]
    rfl
  have hz1 : (z : ℕ → JZero M) 1 = 0 := by
    rw [hzk]
    exact hm _ (levels_mem lam x 1) (hxnil 1)
  have hzmem : ∀ k, (z : ℕ → JZero M) k ∈ (fun _ => nilSub (M := M) lam) (lam ^ k) := by
    intro k
    obtain ⟨n, hn⟩ := hxnil k
    refine ⟨n, ?_⟩
    rw [hzk]
    calc (fT (M := M) lam ^ n) ((fT (M := M) lam ^ m) ((x : ℕ → JZero M) k))
        = (fT (M := M) lam ^ m) ((fT (M := M) lam ^ n) ((x : ℕ → JZero M) k)) := by
          rw [← Module.End.mul_apply, ← pow_add, ← Module.End.mul_apply, ← pow_add, add_comm]
      _ = 0 := by rw [hn, map_zero]
  have hlift := tateModule_exists_pow_smul_mem_of_apply_eq_zero
    (fun _ => nilSub (M := M) lam) (fun _ _ _ _ h _ => h) z.2 1 hz1 hzmem
  obtain ⟨y, hy, hyz, hymem⟩ := hlift
  refine ⟨⟨y, hy⟩, LinearMap.mem_ker.mpr ?_, ?_⟩
  · apply Subtype.ext
    funext k
    rw [πT_coe]
    change sπ lam y _ k = 0
    exact (OrdConnFit.seqπ_eq_zero_iff lam (fT lam) (finite_lvl lam) y _ k).mpr (hymem k)
  · apply Subtype.ext
    refine Eq.trans ?_ (natCast_smul_coe hsmul lam ⟨y, hy⟩).symm
    have hyz' := hyz
    rw [pow_one] at hyz'
    exact hyz'.symm

private theorem πT_mem_tateSub (F : AddSubgroup (JZero M)) (hF : ∀ y ∈ F, fT (M := M) lam y ∈ F)
    (x : ModularCurve.TateModule lam (JZero M)) (hx : x ∈ tateSub hsmul (fun _ => F)) :
    πT lam hsmul x ∈ tateSub hsmul (fun _ => F) := by
  rw [mem_tateSub_iff] at hx ⊢
  intro k
  rw [πT_coe]
  exact OrdConnFit.seqπ_mem_of_mem lam (fT lam) (finite_lvl lam) (fun _ => F) (fun _ => hF) _
    (levels_mem lam x) hx k

private theorem πT_unit (x : ModularCurve.TateModule lam (JZero M)) (k m : ℕ) :
    ∃ z : JZero M, lam ^ k • z = 0 ∧
      (heckeOperatorBar M ⟨lam, Fact.out⟩ ^ m) z =
        ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) k := by
  obtain ⟨z, hz, hzx⟩ := OrdConnFit.seqπ_unit lam (fT (M := M) lam) (finite_lvl lam) (x : ℕ → JZero M)
    (levels_mem lam x) k m
  refine ⟨z, ?_, ?_⟩
  · rw [OrdConnFit.mem_lvl_iff, ← Nat.cast_pow, natCast_zsmul] at hz
    exact hz
  · rw [← fT_pow_apply lam, hzx, πT_coe]
    rfl

private def νT (x : ModularCurve.TateModule lam (JZero M)) : ModularCurve.TateModule lam (JZero M) :=
  ⟨(x : ℕ → JZero M) - ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M),
    sub_mem x.2 (πT lam hsmul x).2⟩

private theorem νT_coe (x : ModularCurve.TateModule lam (JZero M)) :
    ((νT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) =
      (x : ℕ → JZero M) - ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) := rfl

private theorem νT_mem_ker (x : ModularCurve.TateModule lam (JZero M)) : νT lam hsmul x ∈ LinearMap.ker (πT lam hsmul) := by
  refine LinearMap.mem_ker.mpr ?_
  apply Subtype.ext
  funext k
  rw [πT_coe, Submodule.coe_zero, Pi.zero_apply]
  have h := OrdConnFit.seqπ_sub lam (fT lam) (finite_lvl lam) (x : ℕ → JZero M)
    ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) (levels_mem lam x)
    (levels_mem lam (πT lam hsmul x)) k
  show OrdConnFit.seqπ lam (fT lam) (finite_lvl lam) _ (levels_mem lam (νT lam hsmul x)) k = 0
  refine (OrdConnFit.seqπ_congr lam (fT lam) (finite_lvl lam) _ _ _ _ (fun k => rfl) k).trans (h.trans ?_)
  rw [sub_eq_zero]
  show sπ lam (x : ℕ → JZero M) (levels_mem lam x) k =
    sπ lam ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M) (levels_mem lam (πT lam hsmul x)) k
  rw [← πT_coe lam hsmul (πT lam hsmul x) k, πT_idem lam hsmul x, πT_coe]

