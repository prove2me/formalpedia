    (hslack : ∀ γ : ↥Γt, ((slack γ : (ZMod n)ˣ) : ZMod n) * (r : ZMod n) ^ (-(kγ γ)).toNat = (r : ZMod n) ^ (kγ γ).toNat)
    (θt : ↥Γt →* G)
    (hθt : ∀ γ : ↥Γt, pushPt (A₀.act (χ (θt γ))) (A₀.act_over (χ (θt γ))) (mapPt (e γ) (he γ) P₀.P) =
