open MeasureTheory

attribute [local instance] ideleBorel borelSpace_ideleBorel

variable (T : Finset (HeightOneSpectrum (𝓞 ℚ)))
variable [∀ v : HeightOneSpectrum (𝓞 ℚ), MeasurableSpace (v.adicCompletion ℚ)ˣ]
  [∀ v : HeightOneSpectrum (𝓞 ℚ), BorelSpace (v.adicCompletion ℚ)ˣ]
  [∀ v : HeightOneSpectrum (𝓞 ℚ), SecondCountableTopology (v.adicCompletion ℚ)ˣ]
  [MeasurableSpace (InfiniteAdeleRing ℚ)ˣ] [BorelSpace (InfiniteAdeleRing ℚ)ˣ]
  [SecondCountableTopology (InfiniteAdeleRing ℚ)ˣ]
  {ν : Measure (TorusProduct T)} {r : ℝ≥0}

private theorem integrable_iff_of_eq (hr : 0 < r) (h : sPartMeasure ℚ T = r • Measure.map (embHom T) ν)
    (f : (AdeleRing (𝓞 ℚ) ℚ)ˣ → ℂ) :
    Integrable f (sPartMeasure ℚ T) ↔ Integrable (fun t => f (embHom T t)) ν := by
  haveI : MeasurableEmbedding (embHom T) := (isClosedEmbedding_embHom T).measurableEmbedding
  rw [h, ENNReal.smul_def, integrable_smul_measure (by exact_mod_cast hr.ne') ENNReal.coe_ne_top]
  exact this.integrable_map_iff

private theorem integral_eq_of_eq
    (h : sPartMeasure ℚ T = r • Measure.map (embHom T) ν) (f : (AdeleRing (𝓞 ℚ) ℚ)ˣ → ℂ) :
    ∫ a, f a ∂(sPartMeasure ℚ T) = (r : ℝ) • ∫ t, f (embHom T t) ∂ν := by
  haveI : MeasurableEmbedding (embHom T) := (isClosedEmbedding_embHom T).measurableEmbedding
  rw [h, ENNReal.smul_def, integral_smul_measure, this.integral_map, ENNReal.coe_toReal]

variable (μ : ∀ v : HeightOneSpectrum (𝓞 ℚ), Measure (v.adicCompletion ℚ)ˣ) [∀ v, SigmaFinite (μ v)]
  (μArch : Measure (InfiniteAdeleRing ℚ)ˣ) [SigmaFinite μArch]

omit [SigmaFinite μArch] in

private theorem integrable_sPartMeasure_of_forall_embHom_eq (hr : 0 < r)
    (h : sPartMeasure ℚ T = r • Measure.map (embHom T) ((Measure.pi fun v : T => μ v).prod μArch))
    (F : (AdeleRing (𝓞 ℚ) ℚ)ˣ → ℂ) (φ : ∀ v : T, ((v : HeightOneSpectrum (𝓞 ℚ)).adicCompletion ℚ)ˣ → ℂ)
    (hφ : ∀ v : T, Integrable (φ v) (μ v)) (φArch : (InfiniteAdeleRing ℚ)ˣ → ℂ) (hφArch : Integrable φArch μArch)
    (hF : ∀ t : TorusProduct T, F (embHom T t) = (∏ v : T, φ v (t.1 v)) * φArch t.2) :
    Integrable F (sPartMeasure ℚ T) := by
  rw [integrable_iff_of_eq T hr h F,
    show (fun t : TorusProduct T => F (embHom T t)) = fun t => (∏ v : T, φ v (t.1 v)) * φArch t.2 from funext hF]
  exact integrable_torusMeasure_prod_mul T μ μArch φ hφ φArch hφArch

end

