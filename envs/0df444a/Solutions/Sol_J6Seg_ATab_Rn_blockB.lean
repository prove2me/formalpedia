theorem Rn.pushes {S : Fin HS} (hS : S ∉ rg) (hS5 : S.val < 56) {W : ℕ} {v : Vr} (hv : BV W v) :
    ∀ (es : List E) (c : Cs), (∀ e ∈ es, e.ok = true ∧ e.lb ≤ 2 ^ W) →
    Rn (pushes S es) v c (· = v) (update c S ((es.map (E.den v)).reverse ++ c S)) (cPushes W es)
  | [], c, _ => by
    simp only [pushes, cPushes, List.map_nil, List.reverse_nil, List.nil_append, update_eq_self]
    exact Rn.skip v c
  | e :: es, c, h => by
    have h1 := Rn.pushE (c := c) (X := S) (e := e) hS hS5 (h e List.mem_cons_self).1
      (h e List.mem_cons_self).2 hv
    refine Rn.seq h1 (fun v1 e1 => ?_)
    subst e1
    have h2 := Rn.pushes hS hS5 hv es (update c S (E.den v1 e :: c S)) (fun e' he' => h e' (List.mem_cons_of_mem _ he'))
    rw [update_self, update_idem] at h2
    simp only [List.map_cons, List.reverse_cons, List.append_assoc, List.singleton_append]
    exact h2

