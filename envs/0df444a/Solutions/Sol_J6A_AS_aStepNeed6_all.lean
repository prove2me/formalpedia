/-!
# Round six, item language: the cost of the general procedure, node bounds

`costN_le_big` / `costN_le_small`: one node of the call tree costs at most
`cq q (r + 1) V + Kv C ⌊V / W⌋ + Σ (children) + KA C q (e + 1) (Bb + 2)²` (`r = e mod m`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

theorem absRep (A S k b X : ℕ) (hbX : b ≤ X) (hX1 : 1 ≤ X) :
    A * b + k * (S * X + 8000 * b + 30) + 32 ≤ (A + S + 8062) * ((k + 1) * X) := by
  have hZ : X ≤ (k + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have h1 : A * b ≤ A * ((k + 1) * X) := Nat.mul_le_mul_left _ (le_trans hbX hZ)
  have h2 : k * (S * X + 8000 * b + 30) ≤ k * (S * X + 8030 * X) := Nat.mul_le_mul_left _ (by omega)
  have h3 : k * (S * X + 8030 * X) + (S * X + 8030 * X) = S * ((k + 1) * X) + 8030 * ((k + 1) * X) := by
    ring
  have h4 : (A + S + 8062) * ((k + 1) * X) = A * ((k + 1) * X) + S * ((k + 1) * X) +
      8062 * ((k + 1) * X) := by ring
  omega

theorem cRep_le (n : NE) (k : ℕ) (L : List (Fin HS × NE)) (B : ℕ) :
    cRep n k L B ≤ crK n L * ((k + 1) * (B + 2) ^ 2) := by
  unfold cRep crK
  exact absRep _ _ k (B + 2) _ (Nat.le_self_pow (n := 2) (by norm_num) _) (Nat.one_le_pow _ _ (by omega))

variable {W T m : ℕ} [NeZero W]

theorem absT (sT c V r B b X : ℕ) (hb : b = B + 2) (hbX : b ≤ X) :
    sT * 10 ^ 7 * X + ((r + 1) * (c * V + 10 ^ 9 * X + 10 ^ 4 * b) + (13 * (2 * B + 2) + 1)) ≤
      c * (r + 1) * V + (sT * 10 ^ 7 + 10 ^ 9 + 10 ^ 4 + 30) * ((r + 1) * X) := by
  have hXZ : X ≤ (r + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  have h1 : (r + 1) * b ≤ (r + 1) * X := Nat.mul_le_mul_left _ hbX
  have e1 : (r + 1) * (c * V + 10 ^ 9 * X + 10 ^ 4 * b) =
      c * (r + 1) * V + 10 ^ 9 * ((r + 1) * X) + 10 ^ 4 * ((r + 1) * b) := by ring
  have h2 : sT * 10 ^ 7 * X ≤ sT * 10 ^ 7 * ((r + 1) * X) := Nat.mul_le_mul_left _ hXZ
  have e2 : (sT * 10 ^ 7 + 10 ^ 9 + 10 ^ 4 + 30) * ((r + 1) * X) =
      sT * 10 ^ 7 * ((r + 1) * X) + 10 ^ 9 * ((r + 1) * X) + 10 ^ 4 * ((r + 1) * X) +
      30 * ((r + 1) * X) := by ring
  rw [e1, e2]
  omega

theorem cTail_le (q V Bb r : ℕ) :
    cTail q V Bb r ≤ cq q * (r + 1) * V + KT q * ((r + 1) * (Bb + 2) ^ 2) := by
  unfold cTail cSw1F KT cq
  exact absT _ _ V r Bb (Bb + 2) _ rfl (Nat.le_self_pow (n := 2) (by norm_num) _)

end

end IntMul.Kappa.R6.IL

