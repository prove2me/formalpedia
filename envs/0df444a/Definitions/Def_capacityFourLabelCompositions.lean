import Mathlib
import Definitions.Def_capacityFourLabelAtoms

set_option autoImplicit false

/-!
# The unique hidden direction on four ordered labels

There are eight interval partitions (compositions) of four ordered labels.
This file writes all eight down and proves directly that the kernel of their
first-order interval-block incidence map is the single line generated by

`12|34 + 1|2|3|4 - 1|2|34 - 12|3|4`.

Thus the signed square from `N4.lean` is not merely an example: among signed
laws on all four-label compositions it is the unique invisible direction,
up to scale.
-/

namespace FormalCapacity.Finite

open Finset

/-- The eight compositions of four ordered labels.  Constructor names record
the non-singleton blocks; `halves` is `12|34`. -/
inductive Composition4
  | whole
  | rightTriple
  | halves
  | leftTriple
  | rightPair
  | middlePair
  | leftPair
  | discrete
  deriving DecidableEq

/-- Blocks of a four-label composition (with zero-based labels). -/
def Composition4.blocks : Composition4 → Finset (Finset Label4)
  | .whole => {{0, 1, 2, 3}}
  | .rightTriple => {{0}, {1, 2, 3}}
  | .halves => {{0, 1}, {2, 3}}
  | .leftTriple => {{0, 1, 2}, {3}}
  | .rightPair => {{0}, {1}, {2, 3}}
  | .middlePair => {{0}, {1, 2}, {3}}
  | .leftPair => {{0, 1}, {2}, {3}}
  | .discrete => {{0}, {1}, {2}, {3}}



/-- Incidence of a block in a composition. -/
def Composition4.blockIndicator (P : Composition4)
    (B : Finset Label4) : ℚ :=
  if B ∈ P.blocks then 1 else 0

/-- First-order block incidence of a signed law on all eight compositions. -/
def composition4FirstOrder (w : Composition4 → ℚ)
    (B : Finset Label4) : ℚ :=
  w .whole * Composition4.blockIndicator .whole B +
  w .rightTriple * Composition4.blockIndicator .rightTriple B +
  w .halves * Composition4.blockIndicator .halves B +
  w .leftTriple * Composition4.blockIndicator .leftTriple B +
  w .rightPair * Composition4.blockIndicator .rightPair B +
  w .middlePair * Composition4.blockIndicator .middlePair B +
  w .leftPair * Composition4.blockIndicator .leftPair B +
  w .discrete * Composition4.blockIndicator .discrete B

/-- The signed square, extended by zero to all eight compositions. -/
def composition4Square : Composition4 → ℚ
  | .halves | .discrete => 1
  | .rightPair | .leftPair => -1
  | _ => 0









end FormalCapacity.Finite


