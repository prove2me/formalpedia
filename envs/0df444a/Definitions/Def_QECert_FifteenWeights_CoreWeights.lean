def certificateCoefficient (n : Nat) : Sum (Fin 4) QuadraticIndex → Bit := fun g =>
  match g with
  | Sum.inl j => if n.testBit j.val then 1 else 0
  | Sum.inr ij => if n.testBit (4 + (ij.1.1.val * (7 - ij.1.1.val)) / 2 + (ij.1.2.val - ij.1.1.val - 1)) then 1 else 0
