theorem child16_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu075.lin : ℝ) ≤ (S : ℝ) * logProd gu075.lo) :
    (gu078.lfin : ℝ) ≤ (S : ℝ) * logProd gu078.top ∧
      (∀ x : ℝ, (gu075.lo : ℝ) < x → x ≤ (gu078.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u075 hγ hstate
  have s1 := sol_u076 hγ (by simpa [gu075, gu076] using s0.1)
  have s2 := sol_u077 hγ (by simpa [gu076, gu077] using s1.1)
  have s3 := sol_u078 hγ (by simpa [gu077, gu078] using s2.1)
  refine ⟨s3.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu075.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu076.lo : ℝ) < x := by
        have hb : (gu075.top : ℝ) = (gu076.lo : ℝ) := by simp [gu075, gu076]
        linarith
    by_cases h1 : x ≤ (gu076.top : ℝ)
