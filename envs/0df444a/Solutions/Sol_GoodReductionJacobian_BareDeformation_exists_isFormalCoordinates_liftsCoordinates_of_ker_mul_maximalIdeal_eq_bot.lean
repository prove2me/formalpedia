section GSide

variable {B : Type} [CommRing B] [IsLocalRing B] {B₁ : Type} [CommRing B₁] [Algebra B B₁]
  (hI : RingHom.ker (algebraMap B B₁) ≤ maximalIdeal B)
  (V : Type) [AddCommGroup V] [Module (ResidueField B) V] [Module.Finite (ResidueField B) V]
  [Module B V] [IsScalarTower B (ResidueField B) V]
  (ι : V →ₗ[B] B) (hι : Function.Injective ι)
  (hιI : LinearMap.range ι = Submodule.restrictScalars B (RingHom.ker (algebraMap B B₁)))
  {d : ℕ} (F : MvFormalGroup d B) [F.IsComm]

abbrev CDef : Type := {G : Deformation (F.map (algebraMap B B₁)) B // G.F.IsComm}

scoped instance setoidCDef : Setoid (CDef (B₁ := B₁) F) where
  r G G' := G.1.IsIso G'.1
  iseqv :=
    { refl := fun G => (Deformation.isIso_equivalence _ B).refl G.1
      symm := fun h => (Deformation.isIso_equivalence _ B).symm h
      trans := fun h h' => (Deformation.isIso_equivalence _ B).trans h h' }

abbrev LG : Type := Quotient (setoidCDef (B₁ := B₁) F)

abbrev W : Type := Module.Dual (ResidueField B) V →ₗ[ResidueField B] firstOrderDeformationSpace (F.map (residue B))

include hI hι hιI

noncomputable def shift (w : W V F) (G : CDef (B₁ := B₁) F) : CDef (B₁ := B₁) F :=
  haveI := G.2
  ⟨Classical.choose (Deformation.exists_isComm_isShiftBy hI V ι hι hιI F w G.1),
    (Classical.choose_spec (Deformation.exists_isComm_isShiftBy hI V ι hι hιI F w G.1)).1⟩

theorem shift_spec (w : W V F) (G : CDef (B₁ := B₁) F) :
    Deformation.IsShiftBy V ι F w G.1 (shift hI V ι hι hιI F w G).1 := by
  haveI := G.2
  exact (Classical.choose_spec (Deformation.exists_isComm_isShiftBy hI V ι hι hιI F w G.1)).2

theorem mk_eq_mk_of_isShiftBy (w : W V F) (G G' G'' : CDef (B₁ := B₁) F)
    (h' : Deformation.IsShiftBy V ι F w G.1 G'.1) (h'' : Deformation.IsShiftBy V ι F w G.1 G''.1) :
    (⟦G'⟧ : LG (B₁ := B₁) F) = ⟦G''⟧ := by
  haveI := G.2; haveI := G'.2; haveI := G''.2
  exact Quotient.sound (Deformation.isIso_of_isShiftBy_of_isShiftBy hI V ι hι hιI F w G.1 G'.1 G''.1 h' h'')

theorem isShiftBy_of_equiv (w : W V F) (G G' G₂ G₂' : CDef (B₁ := B₁) F)
    (h : Deformation.IsShiftBy V ι F w G.1 G'.1) (h₂ : G ≈ G₂) (h₂' : G' ≈ G₂') :
    Deformation.IsShiftBy V ι F w G₂.1 G₂'.1 := by
  haveI := G.2; haveI := G'.2; haveI := G₂.2; haveI := G₂'.2
