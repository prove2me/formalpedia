theorem natCast_ne_zero (q : ℕ) (M' : ℕ) (κ : Type) [Field κ] [CharP κ q] (hqM' : ¬ q ∣ M') :
    (M' : κ) ≠ 0 := by
  intro h
  exact hqM' ((CharP.cast_eq_zero_iff κ q M').mp h)

theorem genusFF_E0_eq (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (κ : Type) [Field κ] [CharP κ q] [IsAlgClosed κ] (hqM' : ¬ q ∣ M') :
    (genusFF κ ↥(modularFunctionFieldC κ M') : ℚ) = genusFormula M' := by
  have h1 : (genusFF κ ↥(modularFunctionFieldC κ M') : ℚ) = genusFF κ ↥(modularFunctionFieldFullC κ M') :=
    congrArg (fun X : IntermediateField κ (LaurentSeries κ) => (genusFF κ ↥X : ℚ))
      (modularFunctionFieldC_eq_modularFunctionFieldFullC κ q M' hqM')
  have h2 : genusFF κ ↥(modularFunctionFieldFullC κ M') =
      genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M') :=
    genusFF_modularFunctionFieldFullC_eq_genusFF_modularFunctionFieldBar κ M' (natCast_ne_zero q M' κ hqM')
  haveI := hasCanonicalDivisor_modularFunctionFieldBar M'
  have h3 := genus_eq_genusFF_modularFunctionFieldBar M'
  have h4 := genus_modularFunctionFieldBar_eq_genusFormula M'
  refine h1.trans ?_
  rw [h2, ← h3]
  exact h4

