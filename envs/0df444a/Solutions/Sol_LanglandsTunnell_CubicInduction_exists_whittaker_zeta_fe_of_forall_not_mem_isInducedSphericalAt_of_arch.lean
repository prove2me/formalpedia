private theorem zpow_sum_eq_prod_zpow {ι : Type} (z : ℂ) (hz : z ≠ 0) (t : Finset ι) (n : ι → ℤ) :
    z ^ (∑ i ∈ t, n i) = ∏ i ∈ t, z ^ n i := by
  classical
  refine Finset.induction_on t ?_ ?_
  · simp
  · intro i s hi ih
    rw [Finset.sum_insert hi, Finset.prod_insert hi, zpow_add₀ hz, ih]

private theorem localChar_comp_norm_apply_uniformizerUnit (K : Type) [Field K] [NumberField K]
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (hχ : IsUnramifiedCharAt χ v)
    (w : v.Extension (𝓞 K)) :
    (localChar χ v).comp (Units.map (Algebra.norm (v.adicCompletion ℚ))) (uniformizerUnit K w.1)
      = localChar χ v (uniformizerUnit ℚ v) ^ v.asIdeal.inertiaDeg' w.1.asIdeal := by
  obtain ⟨𝔓, h𝔓⟩ := w
  subst h𝔓
  have h := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K 1 χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
  have h1 : localChar (1 : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) 𝔓 = 1 := MonoidHom.one_comp _
  rw [h1, one_mul (_ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)] at h
  have h' := DFunLike.congr_fun h (uniformizerUnit K 𝔓)
  rw [MonoidHom.mul_apply, MonoidHom.one_apply, one_mul] at h'
  exact h'.symm.trans
    (LanglandsTunnell.CubicInduction.TwistLegs.apply_idelicNorm_uniformizerIdele K χ 𝔓 hχ)

private theorem stdRootNumberAt_mul_comp_norm (E : Type) [Field E] [NumberField E] (M : Type) [Field M] [NumberField M]
    [Algebra E M] (v : HeightOneSpectrum (𝓞 E)) (w : v.Extension (𝓞 M))
    (ξ : (w.1.adicCompletion M)ˣ →* ℂˣ) (c : ℕ) (hξ : HasConductorExponentAt M w.1 ξ c)
    (hξu : ‖(ξ (uniformizerUnit M w.1) : ℂ)‖ = 1)
    (χ : (v.adicCompletion E)ˣ →* ℂˣ) (hχu : ‖(χ (uniformizerUnit E v) : ℂ)‖ = 1)
    (hN0 : HasConductorExponentAt M w.1 (χ.comp (Units.map (Algebra.norm (v.adicCompletion E)))) 0)
    (hNϖ : χ.comp (Units.map (Algebra.norm (v.adicCompletion E))) (uniformizerUnit M w.1)
      = χ (uniformizerUnit E v) ^ v.asIdeal.inertiaDeg' w.1.asIdeal) :
    stdRootNumberAt M w.1 (ξ * χ.comp (Units.map (Algebra.norm (v.adicCompletion E))))
      = (χ (uniformizerUnit E v) : ℂ)
          ^ ((v.asIdeal.inertiaDeg' w.1.asIdeal : ℤ) * ((c : ℤ) + addCharLevel (psiLocal M w.1)))
        * stdRootNumberAt M w.1 ξ := by
  have huω : ‖((χ.comp (Units.map (Algebra.norm (v.adicCompletion E)))) (uniformizerUnit M w.1) : ℂ)‖ = 1 := by
    rw [hNϖ, Units.val_pow_eq_pow_val, norm_pow, hχu, one_pow]
  rw [stdRootNumberAt_mul_of_hasConductorExponentAt_zero M w.1 ξ
    (χ.comp (Units.map (Algebra.norm (v.adicCompletion E)))) c hξ hN0 hξu huω (psiLocal_ne_one M w.1),
    hNϖ, Units.val_pow_eq_pow_val, ← zpow_natCast, ← zpow_mul]

private theorem stdRootNumberAt_localChar_mul_comp_norm (K : Type) [Field K] [NumberField K]
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ)) (w : v.Extension (𝓞 K)) (c : ℕ)
    (hμ : HasConductorExponentAt K w.1 (localChar μ w.1) c)
    (hμu : ‖(localChar μ w.1 (uniformizerUnit K w.1) : ℂ)‖ = 1)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχ : IsUnramifiedCharAt χ v)
    (hχu : ‖(localChar χ v (uniformizerUnit ℚ v) : ℂ)‖ = 1)
    (hN0 : HasConductorExponentAt K w.1 ((localChar χ v).comp (Units.map (Algebra.norm (v.adicCompletion ℚ)))) 0) :
    stdRootNumberAt K w.1 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) w.1)
      = (localChar χ v (uniformizerUnit ℚ v) : ℂ) ^ ((v.asIdeal.inertiaDeg' w.1.asIdeal : ℤ) * pinnedExp K μ w.1)
        * stdRootNumberAt K w.1 (localChar μ w.1) := by
  rw [localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ v w,
    stdRootNumberAt_mul_comp_norm ℚ K v w (localChar μ w.1) c hμ hμu (localChar χ v) hχu hN0
      (localChar_comp_norm_apply_uniformizerUnit K χ v hχ w),
    pinnedExp, conductorExponentAt_eq_of_hasConductorExponentAt K w.1 hμ]

private theorem prod_stdRootNumberAt_mul_of_hasConductorExponentAt_zero (v : HeightOneSpectrum (𝓞 ℚ))
    (ν : Fin 3 → (v.adicCompletion ℚ)ˣ →* ℂˣ) (a : Fin 3 → ℕ)
    (hν : ∀ i, HasConductorExponentAt ℚ v (ν i) (a i))
    (hνu : ∀ i, ‖((ν i (uniformizerUnit ℚ v) : ℂˣ) : ℂ)‖ = 1)
    (χ : (v.adicCompletion ℚ)ˣ →* ℂˣ) (hχ : HasConductorExponentAt ℚ v χ 0)
    (hχu : ‖((χ (uniformizerUnit ℚ v) : ℂˣ) : ℂ)‖ = 1) :
    ∏ i, stdRootNumberAt ℚ v (ν i * χ)
      = (χ (uniformizerUnit ℚ v) : ℂ) ^ (∑ i, (a i : ℤ)) * ∏ i, stdRootNumberAt ℚ v (ν i) := by
  have hz : ((χ (uniformizerUnit ℚ v) : ℂˣ) : ℂ) ≠ 0 := Units.ne_zero _
  have hi : ∀ i, stdRootNumberAt ℚ v (ν i * χ)
      = ((χ (uniformizerUnit ℚ v) : ℂˣ) : ℂ) ^ (a i : ℤ) * stdRootNumberAt ℚ v (ν i) := by
    intro i
    rw [stdRootNumberAt_mul_of_hasConductorExponentAt_zero ℚ v (ν i) χ (a i) (hν i) hχ (hνu i) hχu
