theorem r6n_pos_of_hist (h : List (ℕ × ℕ)) (m : ℕ) (hw : ∀ p ∈ h, 0 < p.1 ∧ p.1 ≤ m)
    (τ W : ℝ) (hW : W ≤ (h.map fun p => (p.2 : ℝ)).sum)
    (hmom : histMoment h m τ < W) : 0 < τ := by
  by_contra hτ
  push_neg at hτ
  have : (h.map fun p => (p.2 : ℝ)).sum ≤ histMoment h m τ := by
    rw [histMoment]
    apply List.sum_le_sum
    intro p hp
    obtain ⟨h0, h1⟩ := hw p hp
    have hm : (0:ℝ) < m := by have : 0 < m := by omega
                              exact_mod_cast this
    have h1 : (1:ℝ) ≤ ((p.1:ℝ) / m) ^ τ := by
      apply Real.one_le_rpow_of_pos_of_le_one_of_nonpos _ _ hτ
      · have : (0:ℝ) < p.1 := by exact_mod_cast h0
        positivity
      · rw [div_le_one hm]; exact_mod_cast h1
    exact le_mul_of_one_le_right (by positivity) h1
  linarith

