theorem normSq_add_smul_orthogonal_rat {m' : Nat}
    (curr prev : Vector Rat m') (μ : Rat)
    (horth : curr.dotProduct prev = 0) :
    (curr + μ • prev).normSq =
      curr.normSq + μ ^ 2 * prev.normSq := by sorry
