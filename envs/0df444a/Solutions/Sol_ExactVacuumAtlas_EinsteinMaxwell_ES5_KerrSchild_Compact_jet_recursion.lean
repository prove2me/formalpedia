-- ==== solution ====
open Polynomial
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact
variable {M h J Q c : ℝ} {F b A : ℝ[X]}
theorem solution (hn : JetNormalization M c F b A) (hr : SelectedRows h Q J F b A) :
    b.coeff 1 = jetB1 M h J Q c ∧ F.coeff 2 = jetF2 M h J Q c ∧ b.coeff 2 = jetB2 M h J Q c ∧
    A.coeff 2 = jetA2 M h J Q c ∧ A.coeff 3 = jetA3 M h J Q c ∧ F.coeff 3 = jetF3 M h J Q c ∧
    b.coeff 3 = jetB3 M h J Q c ∧ A.coeff 4 = jetA4 M h J Q c := by
  have eC1 := hr.C1; rw [rowC1 hn] at eC1
  have hB1 : b.coeff 1 = -(M + h) / 2 := by linear_combination eC1 / 4
  have eM2 := hr.M2; rw [rowM2 hn, hB1] at eM2
  have hF2 : F.coeff 2 = M * (M - h) / 2 + 4 * Q ^ 2 / 3 := by linear_combination eM2 / 3
  have eC2 := hr.C2; rw [rowC2 hn, hB1, hF2] at eC2
  have hB2 : b.coeff 2 = 4 * Q ^ 2 / 3 := by linear_combination eC2 / 6
  have eA2 := hr.A2; rw [rowA2 hn, hB1] at eA2
  have hA2 : A.coeff 2 = M * c / 6 + h * c / 2 + 2 * J * Q / 3 := by linear_combination eA2 / 3
  have eA3 := hr.A3; rw [rowA3 hn, hB1, hB2, hF2, hA2] at eA3
  have hA3 : A.coeff 3 = M ^ 2 * c / 12 + M * h * c / 6 - M * J * Q / 6 + h ^ 2 * c / 4
      + 2 * h * J * Q / 3 := by linear_combination eA3 / 8
  have eM3 := hr.M3; rw [rowM3 hn, hB1, hB2, hF2] at eM3
  have eC3 := hr.C3; rw [rowC3 hn, hB1, hB2, hF2] at eC3
  have hF3 : F.coeff 3 = -M ^ 3 / 6 + M ^ 2 * h / 2 - M * h ^ 2 / 3 - 16 * M * Q ^ 2 / 9
      + 4 * h * Q ^ 2 / 3 + 2 * J ^ 2 / 3 + 4 * c ^ 2 / 9 := by
    linear_combination (2 * eM3 - 3 * eC3) / 18
  rw [hF3] at eM3
  have hB3 : b.coeff 3 = M ^ 3 / 24 - M * h ^ 2 / 24 - 8 * M * Q ^ 2 / 9 + 2 * h * Q ^ 2 / 3
      + 5 * J ^ 2 / 6 + 2 * c ^ 2 / 9 := by linear_combination eM3 / 12
  have eA4 := hr.A4; rw [rowA4 hn, hB1, hB2, hB3, hF2, hF3, hA2, hA3] at eA4
  have hA4 : A.coeff 4 = M ^ 3 * c / 60 + M ^ 2 * h * c / 8 + M ^ 2 * J * Q / 12
      + 2 * M * h ^ 2 * c / 15 - M * h * J * Q / 4 - 34 * M * Q ^ 2 * c / 135 + h ^ 3 * c / 8
      + 17 * h ^ 2 * J * Q / 30 - 7 * J ^ 2 * c / 30 + 8 * J * Q ^ 3 / 135 - 2 * c ^ 3 / 45 := by
    linear_combination eA4 / 15
  exact ⟨hB1, hF2, hB2, hA2, hA3, hF3, hB3, hA4⟩
