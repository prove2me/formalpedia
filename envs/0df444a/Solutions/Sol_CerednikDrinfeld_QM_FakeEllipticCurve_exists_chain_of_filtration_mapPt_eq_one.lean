    obtain ⟨ps, hps, Ks, κs, hs⟩ := hpres j.castSucc
    obtain ⟨pt, hpt, Kt, κt, ht⟩ := hpres j.succ
    by_cases hrq : ℓ j = q ∨ ℓ j = q'
    · have hAL := CerednikDrinfeld.QM.FakeEllipticCurve.isAtkinLehnerQuotient_of_quotients_of_card_eq_mul_sq hqq' hB Λ hΛ E (ℓ j) hrq
