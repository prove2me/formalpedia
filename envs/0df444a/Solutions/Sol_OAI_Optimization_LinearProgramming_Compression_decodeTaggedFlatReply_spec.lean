theorem explicitValue_preserve_output {m t : Memory ℚ} {q : ℚ} (h : explicitValue (m.atPC 0) q)
    (val : t.data 0=m.data 0) (idx : t.index=m.index) : explicitValue (t.atPC 0) q := by
