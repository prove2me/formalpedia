theorem J6Seg.r6_maps_eq (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
    mapsLine6 P n src D = mapsBs (pP6 P n) (pP6 P n / 7) (lamP (dP6 P n)) (J6Seg.wF (dP6 P n))
      (αN6 P n) (segPF (pP6 P n) (dP6 P n)) (sD6 src D) (tD6 P n D) ∧
    ∀ i : Fin (D + 1), lamP (dP6 P n) ∣ tD6 P n D i ∧ sD6 src D i ≤ tD6 P n D i := by sorry
