/-!
# S4-EtPi1, O8 (part 1): unramified extensions stay unramified under base change

`A → A'`, `K → K'` compatible (`A → K → K'`, `A → A' → K'`), `ι : K̄ →ₐ[K] K̄'` any `K`-embedding.

* `bcField f = K'(roots of f)` in `K̄'` (splitting field, finite, Galois when `f` is separable);
* `rootSet_bc`: the roots of `f` in `K̄'` are the `ι`-images of its roots in `K̄`;
* `icMap`: `integralClosure A L → integralClosure A' L'` induced by `ι`;
* `bcField_unram`: for `L ∈ unramSet A K` the splitting field of `L` over `K'` has trivial inertia over `A'`
  (an inertia element restricts, via `ι`, to an inertia element of `Gal(L/K)`, which is trivial);
* `map_mem_maxUnram`: `ι (K_U(A)) ⊆ K_U(A')`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace EtPi1

open GalCover Lefschetz Polynomial

noncomputable section

section FunA

variable {A K A' K' : Type} [CommRing A] [Field K] [Algebra A K]
  [CommRing A'] [Field K'] [Algebra A' K'] [Algebra K K'] [Algebra A A'] [Algebra A K']
  [IsScalarTower A K K'] [IsScalarTower A A' K']
  (ι : AlgebraicClosure K →ₐ[K] AlgebraicClosure K')

/-- `K'(roots of f)` inside `K̄'`. -/
def bcField (f : K[X]) : IntermediateField K' (AlgebraicClosure K') :=
  IntermediateField.adjoin K' ((f.map (algebraMap K K')).rootSet (AlgebraicClosure K'))

instance bcField_isSplittingField (f : K[X]) :
    (f.map (algebraMap K K')).IsSplittingField K' (bcField (K' := K') f) :=
  IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

instance bcField_finiteDimensional (f : K[X]) : FiniteDimensional K' (bcField (K' := K') f) := by
  let g : K'[X] := f.map (algebraMap K K')
  haveI : g.IsSplittingField K' (bcField (K' := K') f) := bcField_isSplittingField f
  exact IsSplittingField.finiteDimensional _ g

theorem bcField_isGalois {f : K[X]} (hf : f.Separable) : IsGalois K' (bcField (K' := K') f) := by
  have hg : (f.map (algebraMap K K')).Separable := hf.map
  exact IsGalois.of_separable_splitting_field hg

theorem rootSet_bc (f : K[X]) :
    (f.map (algebraMap K K')).rootSet (AlgebraicClosure K') = ι '' f.rootSet (AlgebraicClosure K) := by
  rw [(IsAlgClosed.splits _ : (f.map (algebraMap K (AlgebraicClosure K))).Splits).image_rootSet ι]
  ext w
  rw [mem_rootSet, mem_rootSet, Polynomial.map_ne_zero_iff (algebraMap K K').injective, aeval_map_algebraMap]

theorem adjoin_rootSet_eq (L : IntermediateField K (AlgebraicClosure K)) (f : K[X]) [f.IsSplittingField K L] :
    Algebra.adjoin K (f.rootSet (AlgebraicClosure K)) = L.toSubalgebra := by
  rw [IsSplittingField.adjoin_rootSet_eq_range (f := f) (i := L.val), IntermediateField.range_val]

theorem map_mem_bcField {L : IntermediateField K (AlgebraicClosure K)} (f : K[X]) [f.IsSplittingField K L]
    (y : L) : ι y ∈ bcField (K' := K') f := by
  have h1 : (y : AlgebraicClosure K) ∈ Algebra.adjoin K (f.rootSet (AlgebraicClosure K)) := by
    rw [adjoin_rootSet_eq L f]
    exact y.2
  have h2 : ι y ∈ Algebra.adjoin K (ι '' f.rootSet (AlgebraicClosure K)) := by
    rw [← AlgHom.map_adjoin]
    exact Subalgebra.mem_map.2 ⟨_, h1, rfl⟩
  rw [← rootSet_bc ι f] at h2
  exact Algebra.adjoin_le (S := ((bcField (K' := K') f).restrictScalars K).toSubalgebra)
    (fun w hw => IntermediateField.subset_adjoin K' _ hw) h2

/-- The map of integral closures induced by `ι` when `ι L ⊆ L'`. -/
def icMap (L : IntermediateField K (AlgebraicClosure K)) (L' : IntermediateField K' (AlgebraicClosure K'))
    (h : ∀ y : L, ι y ∈ L') : integralClosure A L →+* integralClosure A' L' where
  toFun b := ⟨⟨ι b, h b⟩, by
    have h1 : IsIntegral A (ι ((b : L) : AlgebraicClosure K)) :=
      IsIntegral.map (ι.restrictScalars A) (IsIntegral.map (L.val.restrictScalars A) b.2)
    exact (isIntegral_algHom_iff (L'.val.restrictScalars A') Subtype.val_injective).1 h1.tower_top⟩
  map_one' := Subtype.ext (Subtype.ext (map_one ι))
  map_mul' x y := Subtype.ext (Subtype.ext
    (map_mul ι ((x : L) : AlgebraicClosure K) ((y : L) : AlgebraicClosure K)))
  map_zero' := Subtype.ext (Subtype.ext (map_zero ι))
  map_add' x y := Subtype.ext (Subtype.ext
    (map_add ι ((x : L) : AlgebraicClosure K) ((y : L) : AlgebraicClosure K)))

theorem icMap_coe (L : IntermediateField K (AlgebraicClosure K)) (L' : IntermediateField K' (AlgebraicClosure K'))
    (h : ∀ y : L, ι y ∈ L') (b : integralClosure A L) :
    (((icMap (A' := A') ι L L' h b : integralClosure A' L') : L') : AlgebraicClosure K') =
      ι ((b : L) : AlgebraicClosure K) := rfl

/-- **Base change preserves unramifiedness.** -/
theorem bcField_unram {L : IntermediateField K (AlgebraicClosure K)} (hL : L ∈ unramSet A K) (f : K[X])
    [f.IsSplittingField K L] (Q' : Ideal (integralClosure A' (bcField (K' := K') f))) (hQ' : Q'.IsPrime) :
    Q'.inertia (bcField (K' := K') f ≃ₐ[K'] bcField (K' := K') f) = ⊥ := by
  have := hL.2.1
  let ι : AlgebraicClosure K →ₐ[K] AlgebraicClosure K' := IsAlgClosed.lift
  rw [eq_bot_iff]
  intro τ hτ
  rw [Subgroup.mem_bot]
  let τ' : AlgebraicClosure K' ≃ₐ[K'] AlgebraicClosure K' := τ.liftNormal (AlgebraicClosure K')
  have hτ' : ∀ y : bcField (K' := K') f, τ' (y : AlgebraicClosure K') = ((τ y : bcField (K' := K') f) :
      AlgebraicClosure K') := fun y => τ.liftNormal_commutes (AlgebraicClosure K') y
  letI : Algebra L (AlgebraicClosure K') := (ι.comp L.val).toRingHom.toAlgebra
  haveI : IsScalarTower K L (AlgebraicClosure K') := IsScalarTower.of_algHom (ι.comp L.val)
  let ρ : L ≃ₐ[K] L := (τ'.restrictScalars K).restrictNormal L
  have hρ : ∀ y : L, ι ((ρ y : L) : AlgebraicClosure K) = τ' (ι (y : AlgebraicClosure K)) := fun y =>
    AlgEquiv.restrictNormal_commutes (τ'.restrictScalars K) L y
  have hmap : ∀ y : L, ι y ∈ bcField (K' := K') f := map_mem_bcField ι f
  have e : ∀ b : integralClosure A L, icMap (A' := A') ι L _ hmap (ρ • b) = τ • icMap ι L _ hmap b := fun b => by
    refine Subtype.ext (Subtype.ext ?_)
    show ι ((ρ (b : L) : L) : AlgebraicClosure K) = ((τ ⟨ι b, hmap b⟩ : bcField (K' := K') f) : AlgebraicClosure K')
    rw [hρ, ← hτ']
  have hin : ρ ∈ (Q'.comap (icMap (A := A) (A' := A') ι L _ hmap)).inertia (L ≃ₐ[K] L) := fun b =>
    Ideal.mem_comap.2 (by rw [RingHom.map_sub, e b]; exact hτ _)
  rw [hL.2.2 _ (Ideal.comap_isPrime _ _), Subgroup.mem_bot] at hin
  have hfixL : ∀ y : L, τ' (ι y) = ι y := fun y => by rw [← hρ, hin, AlgEquiv.one_apply]
  have hfix : ∀ w ∈ bcField (K' := K') f, τ' w = w := fun w hw => by
    have hw' : w ∈ IntermediateField.adjoin K' ((f.map (algebraMap K K')).rootSet (AlgebraicClosure K')) := hw
    clear hw
    induction hw' using IntermediateField.adjoin_induction with
    | mem x hx =>
      rw [rootSet_bc ι f] at hx
      obtain ⟨r, hr, rfl⟩ := hx
      have hrL : r ∈ L := by
        have h3 := Algebra.subset_adjoin (R := K) hr
        rwa [adjoin_rootSet_eq L f] at h3
      exact hfixL ⟨r, hrL⟩
    | algebraMap x => exact τ'.commutes x
    | add x y _ _ hx hy => rw [map_add, hx, hy]
    | inv x _ hx => rw [map_inv₀, hx]
    | mul x y _ _ hx hy => rw [map_mul, hx, hy]
  ext y
  rw [AlgEquiv.one_apply]
  exact (hτ' y).symm.trans (hfix y y.2)

/-- **`ι` maps `K_U(A)` into `K_U(A')`.** -/
theorem map_mem_maxUnram {y : AlgebraicClosure K} (hy : y ∈ maxUnram A K) : ι y ∈ maxUnram A' K' := by
  obtain ⟨L, hL, hyL⟩ := (Lefschetz.mem_maxUnram_iff A K y).1 hy
  have := hL.1
  have := hL.2.1
  obtain ⟨f, hsep, hspl⟩ := IsGalois.is_separable_splitting_field (F := K) (E := L)
  have : IsGalois K' (bcField (K' := K') f) := bcField_isGalois hsep
  exact (Lefschetz.mem_maxUnram_iff A' K' _).2 ⟨bcField f, ⟨inferInstance, inferInstance, bcField_unram hL f⟩,
    map_mem_bcField ι f ⟨y, hyL⟩⟩

end FunA

end

