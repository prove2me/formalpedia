namespace RamanujanPetersson.EtPBC.FreeStk

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtPBC.GenAlg

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

variable (Λ) in
/-- The presheaf fibre of `Λ[Hom(-, W)]` maps to the free module on the fibre of `W`. -/
def fibDesc (W : P.Etale) (x : P) :
    (geomPtAt x).point.presheafFiber.obj (freePre Λ W) ⟶
      ModuleCat.of Λ ((geomPtAt x).point.fiber.obj W →₀ Λ) :=
  (geomPtAt x).point.presheafFiberDesc (fibFun Λ W x) (fibFun_w W x)

theorem toPresheafFiber_fibDesc (W : P.Etale) (x : P) {V : P.Etale} (b : (geomPtAt x).point.fiber.obj V)
    (p : (V ⟶ W) →₀ Λ) :
    (fibDesc Λ W x).hom (((geomPtAt x).point.toPresheafFiber V b (freePre Λ W)).hom p) =
      Finsupp.mapDomain (fun h : V ⟶ W => (geomPtAt x).point.fiber.map h b) p :=
  congrArg (fun ψ => ψ.hom p) ((geomPtAt x).point.toPresheafFiber_presheafFiberDesc
    (fibFun Λ W x) (fibFun_w W x) V b)

variable (Λ) in
/-- The stalk of `Λ[W]` maps to the free module on the fibre of `W`. -/
def stalkFree (W : P.Etale) (x : P) :
    stalk Λ (freeSh Λ W) x ⟶ ModuleCat.of Λ ((geomPtAt x).point.fiber.obj W →₀ Λ) :=
  @inv _ _ _ _ _ (isIso_fib (Λ := Λ) W x) ≫ fibDesc Λ W x

end RamanujanPetersson.EtPBC.FreeStk

