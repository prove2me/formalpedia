  have resQ_mul : ∀ x y : SchemeHomOver sO f, resQ (x * y) = resQ x * resQ y :=
    fun x y => L.mul_natural sO sQ _ hsQ.symm x y
  have redk_mul : ∀ x y : SchemeHomOver sO f, redk (x * y) = redk x * redk y :=
    fun x y => L.mul_natural sO sk _ hsk.symm x y
  have redk_one : redk 1 = 1 := L.one_natural sO sk _ hsk.symm
  have ext_mul : ∀ x y : SchemeHomOver sQ f, ext (x * y) = ext x * ext y := by
    intro x y
    refine (hext_uniq (x * y) (ext x * ext y) ?_).symm
    have := congrArg Subtype.val (resQ_mul (ext x) (ext y))
    rw [resQ_ext, resQ_ext] at this
    show (resQ (ext x * ext y)).1 = (x * y).1
    exact this
  have ext_one : ext 1 = 1 := by
    refine (hext_uniq 1 1 ?_).symm
    exact congrArg Subtype.val (L.one_natural sO sQ _ hsQ.symm)
  let extH : SchemeHomOver sQ f →* SchemeHomOver sO f := { toFun := ext, map_one' := ext_one, map_mul' := ext_mul }
  let redH : SchemeHomOver sO f →* SchemeHomOver sk f := { toFun := redk, map_one' := redk_one, map_mul' := redk_mul }

  have ptsQ_zero : ptsQ 0 = 1 := by
    have h := hptsQ_add 0 0
