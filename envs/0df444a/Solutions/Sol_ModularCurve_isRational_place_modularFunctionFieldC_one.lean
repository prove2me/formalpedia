theorem solution (k : Type*) [Field k] [IsAlgClosed k]
    (v : Place k ↥(modularFunctionFieldC k 1)) : v.IsRational := by
  let eqv := ratFuncEquivCharLOneC k
  letI : Algebra (RatFunc k) ↥(modularFunctionFieldC k 1) := eqv.toAlgHom.toRingHom.toAlgebra
  haveI : IsScalarTower k (RatFunc k) ↥(modularFunctionFieldC k 1) :=
    IsScalarTower.of_algebraMap_eq fun c => (eqv.commutes c).symm
  haveI : FiniteDimensional (RatFunc k) ↥(modularFunctionFieldC k 1) := by
    let L : RatFunc k ≃ₗ[RatFunc k] ↥(modularFunctionFieldC k 1) :=
      { eqv.toRingEquiv.toAddEquiv with
        map_smul' := fun r y => by
          show eqv (r * y) = eqv r * eqv y
          exact map_mul eqv r y }
    exact L.finiteDimensional
  exact Place.isRational_of_isAlgClosed v

