            (1 / (B.sampleData.W : ℝ)) * Calpha *
              Real.log (Scale.L B.sampleData.n)) *
          B.w * B.bandCenter i := by ring
      _ ≤ share * B.w * B.bandCenter i := by
        have hsmall :
