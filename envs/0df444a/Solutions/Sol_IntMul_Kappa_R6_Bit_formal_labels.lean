section Formal

variable {R : Type*} [CommRing R] {U : Type*} {m N : ℕ}

lemma lmulF_mul (L L' : FMat m N) (φ : FV R U m N) :
    lmulF L (lmulF L' φ) = lmulF (L * L') φ := by
  simp only [lmulF, Finsupp.lmapDomain_apply, ← Finsupp.mapDomain_comp]
  congr 1
  funext p
  simp [mul_assoc]

end Formal

