theorem Subgroup.map_map_conj_eq_map_conj_map {G G' : Type} [Group G] [Group G'] (f : G →* G')
    (A : Subgroup G) (s : G) :
    (A.map f).map (MulAut.conj (f s)).toMonoidHom = (A.map (MulAut.conj s).toMonoidHom).map f := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply, map_mul, map_inv]

