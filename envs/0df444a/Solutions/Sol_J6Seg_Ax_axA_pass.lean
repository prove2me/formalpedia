-- Source module: Solutions.J6AIL10
/-!
# A lines, IL side 10: the axis geometry and the kernel row facts

* **`axA_geom`**: in the round-six regime, for every axis `k ≤ D` (`H = HA6`, `t = t_k`,
  `s = src k`, `W = WA p α H`): `1 ≤ H`, `0 < t/16H`, `t = t/16H · 8 · 2H`, `W ≤ s ≤ t`,
  `2Wt ≤ 16Hs`, `2W ≤ 8H`, `2^(⌊log₂ m⌋+3) = 8H`, `0 < preT`, `0 < postT`;
* **`gK_length`**: the kernel keeps a row of length `8H` (when `2W ≤ 8H`);
* **`aKerL_AB`** / **`gK_GB`**: the kernel output bound `AB (Kc ((w2+bk) Kr (Ka X0 + 1) + 1) + 1)`,
  hence `GB (pk + 1)` under the `aK_runs` condition `he3`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf

end J6Seg

namespace J6Seg.KR.AK
open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-- **The kernel output bound.** -/
theorem aKerL_AB {w2 bk win Q : ℕ} {aTab rTab cTab : List ℤ} {x : List GI}
    (hx : w2 ≤ x.length) (hal : aTab.length = w2) (hrl : rTab.length = w2 + bk)
    (hcl : cTab.length = bk)
    {Ka Kr Kc X0 : ℤ} (hKa : 0 ≤ Ka) (hKr : 0 ≤ Kr) (hKc : 0 ≤ Kc) (hX0 : 0 ≤ X0)
    (hta : TB (2 ^ Q * Ka) aTab) (htr : TB (2 ^ Q * Kr) rTab) (htc : TB (2 ^ Q * Kc) cTab)
    (hab : AB X0 x) :
    AB (Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1)
      (J6A.aKerL w2 bk win Q aTab rTab cTab x) := by
  unfold J6A.aKerL
  have hzl : (x.take w2).length = w2 := by simp; omega
  set y := dgG Q aTab (x.take w2) with hydef
  have hyl : y.length = w2 := by rw [hydef, length_dgG Q (by omega), hzl]
  have abz : AB X0 (x.take w2) := fun w hw => hab w (List.mem_of_mem_take hw)
  have aby : AB (Ka * X0 + 1) y := AB_dgG Q hta abz hX0
  set t := J6Seg.padG (w2 + bk) y with htdef
  have htl : t.length = w2 + bk := by simp [htdef, J6Seg.padG, hyl]
  have abt : AB (Ka * X0 + 1) t := AB_padG (by positivity) aby
  have abZ : AB (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) (lwG Q (2 * (w2 + bk)) rTab t) :=
    AB_lwG Q htr abt (by positivity) hKr (by omega) (by omega)
  have abw := AB_dgG Q htc
    (fun v hv => abZ v (List.mem_of_mem_drop (List.mem_of_mem_take hv)))
    (z := ((lwG Q (2 * (w2 + bk)) rTab t).drop w2).take bk) (by positivity)
  intro w hw
  rcases List.mem_append.1 hw with hw | hw
  · exact abw w hw
  · rw [List.eq_of_mem_replicate hw]
    have : 0 ≤ Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 := by positivity
    simpa using this

/-- **`GB (pk + 1)` of the kernel output** under the `aK_runs` condition `he3`. -/
theorem aKerL_GB {w2 bk win Q pk : ℕ} {aTab rTab cTab : List ℤ} {x : List GI}
    (hx : w2 ≤ x.length) (hal : aTab.length = w2) (hrl : rTab.length = w2 + bk)
    (hcl : cTab.length = bk)
    {Ka Kr Kc X0 : ℤ} (hKa : 0 ≤ Ka) (hKr : 0 ≤ Kr) (hKc : 0 ≤ Kc) (hX0 : 0 ≤ X0)
    (hta : TB (2 ^ Q * Ka) aTab) (htr : TB (2 ^ Q * Kr) rTab) (htc : TB (2 ^ Q * Kc) cTab)
    (he3 : Kc * (((w2 + bk : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 ≤ 2 ^ pk)
    (hab : AB X0 x) : GB (pk + 1) (J6A.aKerL w2 bk win Q aTab rTab cTab x) :=
  gb_AB (AB_mono (aKerL_AB hx hal hrl hcl hKa hKr hKc hX0 hta htr htc hab) he3) le_rfl

theorem aKerL_length' {w2 bk win Q : ℕ} {aTab rTab cTab : List ℤ} {x : List GI}
    (hx : w2 ≤ x.length) (hal : aTab.length = w2) (hcl : cTab.length = bk) (hbw : bk ≤ win) :
    (J6A.aKerL w2 bk win Q aTab rTab cTab x).length = win :=
  J6A.length_aKerL w2 bk win Q aTab rTab cTab x hx (by omega) (by omega) hbw

theorem aTabA_length (p s t α H q : ℕ) : (J6A.aTabA p s t α H q).length = 2 * J6A.WA p α H := by
  simp [J6A.aTabA]

theorem cTabA_length (p s t α H q : ℕ) : (J6A.cTabA p s t α H q).length = 2 * H := by
  simp [J6A.cTabA]

/-- **The kernel keeps the row length.** -/
theorem gK_length {p s t α H : ℕ} (hWw : 2 * J6A.WA p α H ≤ 8 * H) (q : ℕ) (x : List GI)
    (hx : x.length = 8 * H) : (J6A.gK p s t α H (8 * H) q x).length = 8 * H := by
  unfold J6A.gK
  exact aKerL_length' (by omega) (aTabA_length _ _ _ _ _ _) (cTabA_length _ _ _ _ _ _) (by omega)

/-- **The kernel output bound for the `A` tables.** -/
theorem gK_GB {p s t α H pk : ℕ} (hWw : 2 * J6A.WA p α H ≤ 8 * H) {Ka Kr Kc X0 : ℤ}
    (hKa : 0 ≤ Ka) (hKr : 0 ≤ Kr) (hKc : 0 ≤ Kc) (hX0 : 0 ≤ X0) (q : ℕ)
    (hrl : (J6A.rTabA p s t α H q).length = 2 * J6A.WA p α H + 2 * H)
    (hta : TB (2 ^ J6A.QA p * Ka) (J6A.aTabA p s t α H q))
    (htr : TB (2 ^ J6A.QA p * Kr) (J6A.rTabA p s t α H q))
    (htc : TB (2 ^ J6A.QA p * Kc) (J6A.cTabA p s t α H q))
    (he3 : Kc * (((2 * J6A.WA p α H + 2 * H : ℕ) : ℤ) * Kr * (Ka * X0 + 1) + 1) + 1 ≤ 2 ^ pk)
    (x : List GI) (hx : x.length = 8 * H) (hab : AB X0 x) :
    GB (pk + 1) (J6A.gK p s t α H (8 * H) q x) := by
  unfold J6A.gK
  exact aKerL_GB (by omega) (aTabA_length _ _ _ _ _ _) hrl (cTabA_length _ _ _ _ _ _) hKa hKr hKc
    hX0 hta htr htc he3 hab

end J6Seg.KR.AK
end

