namespace NLogN

open IntMul RS

/-! ## Stripping the keys -/

/-! ## The whole transposition -/

/-! ## Costs -/

/-! ## Integer and Gaussian-pair arrays -/

/-- Gaussian pairs as flat integer lists `re, im, re, im, …`. -/
