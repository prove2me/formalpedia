-- Prove2me | Definitions.Def_NesterovODE_GenScheme_Run
-- name    : NesterovODE_GenScheme_Run
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-10-09T00:50:31.547533+00:00
-- url     : https://prove2.me/theorems/f16fa479-6b16-48a5-ac1d-2c317501ae4a
-- title:
--   (19), p. 13 — the generalized Nesterov scheme x_k = y_{k−1} − sG_s(y_{k−1}), y_k = x_k + ((k − 1)/(k + r − 1))(x_k − x_{k−1}), y₀ = x₀
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, let $g:\mathcal H\to\mathbb R$ be differentiable, let $s>0$ be a step size and $r$ a real parameter, and let $P:\mathcal H\to\mathcal H$ play the role of the proximal map $\operatorname{prox}_{sh}$ of a function $h$. A sequence $(x_k)_{k\ge 0}$ is a run of the **generalized Nesterov scheme** with parameter $r$ if, starting from $y_0=x_0$,
--
--   $$
--   x_k = P\big(y_{k-1}-s\nabla g(y_{k-1})\big),\qquad y_k = x_k+\frac{k-1}{k+r-1}\,(x_k-x_{k-1})\qquad (k\ge 1).
--   $$
--
--   When $P=\operatorname{prox}_{sh}$, the first equation is $x_k=y_{k-1}-sG_s(y_{k-1})$ with the proximal subgradient $G_s(y)=\big(y-\operatorname{prox}_{sh}(y-s\nabla g(y))\big)/s$, which is scheme (19) of Su, Boyd and Candès. For $r=3$ it is Nesterov's accelerated (proximal) gradient method; larger $r$ means a smaller momentum coefficient, the discrete analogue of higher friction in the ODE $\ddot X+\frac rt\dot X+\nabla f(X)=0$.
--
--   **Formalization Note.** The extrapolated point $y_k$ is the published `NesterovFB.Rates.extrap r x k`, which equals $x_0$ at $k=0$, so the single condition "for every $k\ge 0$, $x_{k+1}=P(y_k-s\nabla g(y_k))$" contains the first step $x_1=P(x_0-s\nabla g(x_0))$. The published predicate `NesterovFB.Rates.IsAccelFBRun` imposes the update only for $k\ge1$ and leaves $x_1$ free; this definition adds the first step, without which the paper's bounds in terms of $x_0$ fail.
-- source:
--   Su, Boyd, Candès, A Differential Equation for Modeling Nesterov's Accelerated Gradient Method, arXiv:1503.01243v2, p. 13, (19)

import Mathlib
import Definitions.Def_NesterovFB_Rates_Algorithm

namespace NesterovODE.GenScheme

open NesterovFB.Rates

/-- `(x_k)` is generated by the generalized Nesterov scheme (19) with parameter `r`, step `s`,
smooth part `Φ` (= g) and `P` playing the role of `prox_{sΨ}`, starting from `y₀ = x₀`:
for every `k ≥ 0`, `x_{k+1} = P(y_k − s∇Φ(y_k))` with `y_k = extrap r x k`
(`y_k = x_k + (k−1)/(k+r−1)·(x_k − x_{k−1})` for `k ≥ 1`, and `y₀ = x₀`).
Equivalently `x_{k+1} = y_k − s G_s(y_k)`. The `k = 0` case is the first step
`x₁ = P(x₀ − s∇Φ(x₀))`. -/
def IsGenNesterovRun {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → ℝ) (P : H → H) (r s : ℝ) (x : ℕ → H) : Prop :=
  ∀ k : ℕ, x (k + 1) = P (extrap r x k - s • gradient Φ (extrap r x k))

end NesterovODE.GenScheme


