theorem natCast_residueField_comap_ne_zero
    (A : ValuationSubring (AlgebraicClosure ℚ)) (q : ℕ) [Fact q.Prime] (hA : A.LiesOverPrime q)
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (ℓ' : ℕ) [Fact ℓ'.Prime] (hℓ'q : ℓ' ≠ q) :
    ((ℓ' : ℕ) : ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ≠ 0 := by
  intro h0
  have h1 : ((ℓ' : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast]; exact h0

  let ψ : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) →+* ↥A :=
    { toFun := fun x => ⟨algebraMap ↥k₀ (AlgebraicClosure ℚ) x.1, ValuationSubring.mem_comap.mp x.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun x y => Subtype.ext (by simp) }
  have h2 : ((q : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hu' : IsUnit ((q : ℕ) : ↥A) := by simpa using hu.map ψ
    have hq : ((q : ℕ) : ↥A) ∈ maximalIdeal ↥A := by
      rw [← ValuationSubring.coe_mem_nonunits_iff]; exact_mod_cast hA
    exact ((IsLocalRing.mem_maximalIdeal _).mp hq) hu'
  have hcop : IsCoprime (ℓ' : ℤ) (q : ℤ) := by
    rw [Nat.isCoprime_iff_coprime]
    exact (Nat.coprime_primes Fact.out Fact.out).mpr hℓ'q
  obtain ⟨a, b, hab⟩ := hcop
  have h3 : (1 : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
    have hab' := congrArg (Int.cast : ℤ → ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) hab
    push_cast at hab'
    rw [← hab']
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h1) (Ideal.mul_mem_left _ _ h2)
  exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (Ideal.eq_top_of_isUnit_mem _ h3 isUnit_one)

theorem exists_ideal_transport
    {A L K : Type*} [CommRing A] [Field L] [Field K] [Algebra L K] [Algebra A L] [Algebra A K]
    [IsScalarTower A L K]
    (C : Subalgebra A K) (τ τ' : K ≃ₐ[L] K) (hinv : ∀ x, τ' (τ x) = x)
    (hpres : ∀ f : K, f ∈ C → τ f ∈ C) (hpres' : ∀ f : K, f ∈ C → τ' f ∈ C)
    (y : Ideal ↥C) (hy : y.IsMaximal) :
    ∃ y₁ : Ideal ↥C, y₁.IsMaximal ∧ (∀ a : A, algebraMap A ↥C a ∈ y → algebraMap A ↥C a ∈ y₁) ∧
      ∀ (b : ↥C) (hb : τ (b : K) ∈ C), b ∈ y ↔ (⟨τ (b : K), hb⟩ : ↥C) ∈ y₁ := by
  let σ : ↥C →+* ↥C :=
    { toFun := fun b => ⟨τ' (b : K), hpres' _ b.2⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x z => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun x z => Subtype.ext (by simp) }
  have hσ : ∀ (b : ↥C) (hb : τ (b : K) ∈ C), σ ⟨τ (b : K), hb⟩ = b := fun b hb => Subtype.ext (hinv _)
  have hsurj : Function.Surjective σ := fun c => ⟨⟨τ (c : K), hpres _ c.2⟩, hσ c _⟩
  haveI := hy
  refine ⟨y.comap σ, Ideal.comap_isMaximal_of_surjective σ hsurj, ?_, ?_⟩
  · intro a ha
