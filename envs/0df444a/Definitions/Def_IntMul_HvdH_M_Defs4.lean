/-! ## The two kinds of passes -/

def Gd (n : ℕ) : ℕ → ℕ → List ℤ → List ℤ := fun E j => difZ (2 ^ n + 1) E j
def Gt (n : ℕ) : ℕ → ℕ → List ℤ → List ℤ := fun E j => ditZ (2 ^ n + 1) n E j

/-- Conditions on the level list, independent of the transform. -/
def LvlOK (n kb W N J : ℕ) (D : List Desc) : Prop :=
  ∀ d ∈ D, d.1 * (2 ^ d.2.1 * d.2.2.2) = N ∧ 1 ≤ d.1 ∧ 1 ≤ d.2.2.2 ∧
    2 ^ d.2.1 * d.2.2.1 = 2 * n ∧ d.2.1 ≤ J

