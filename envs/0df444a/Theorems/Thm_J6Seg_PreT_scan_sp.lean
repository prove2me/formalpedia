--       (hv : VB v A) (h1 : v 1 = st) (h22 : v 22 = sN) (h23 : v 23 = tN) (h24 : v 24 = lam)
--       (hl : 1 ≤ lam) (hlA : lam ≤ 2 ^ A) :
