theorem NLogN.Rsp.resP_run (s0 : IState HS) (R : ℤ) (u : List ℤ) (Dl : List ℕ) (Ws : List (List ℤ))
    (a NR n : ℕ) (RU LKs LKa LKN LR LN LNR LNW RW RD : List Item)
    (hs : 0 < u.length) (ha : a < u.length) (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n)
