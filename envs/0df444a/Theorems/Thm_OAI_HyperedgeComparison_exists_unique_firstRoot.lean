variable {V : Type uV} {E : Type uE}

theorem OAI.HyperedgeComparison.exists_unique_firstRoot {n : ℕ} (H : Hypergraph V E) (x : Fin n → V)
    (ω : E → Bool) (D : Set V) (i : Fin n) : ∃! k, firstRoot H x ω D k i := by sorry
