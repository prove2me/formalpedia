-- title:
--   Lemma 6.5.4 — every primitive cone is closed
-- statement:
--   A **primitive cone** in $\mathbb{R}^m$ is the convex cone $\{t_1v_1+\dots+t_kv_k : t_1,\dots,t_k\ge 0\}$ generated by some $k\le m$ linearly independent vectors $v_1,\dots,v_k\in\mathbb{R}^m$.
--
--   **Lemma.** Every primitive cone $P\subseteq\mathbb{R}^m$ is a closed subset of $\mathbb{R}^m$.
--
--   Together with Lemma 6.5.5 this shows that every finitely generated convex cone is closed (Lemma 6.5.3), which is the topological input of the analytic proof of the Farkas lemma.
--
--   **Formalization Note** $\mathbb{R}^m$ is `EuclideanSpace ℝ (Fin m)` with its usual topology.
-- source:
--   Matoušek & Gärtner, Understanding and Using Linear Programming, Springer 2007, p. 96, Lemma 6.5.4

import Mathlib
import Definitions.Def_MatousekLP_Duality_Cones

namespace MatousekLP.Duality

/-- Matoušek & Gärtner, Lemma 6.5.4 (p. 96): every primitive cone `P` in `ℝ^m` (a convex cone
generated by some `k ≤ m` linearly independent vectors) is closed. -/
theorem primitive_cone_closed {m : ℕ} (P : Set (EuclideanSpace ℝ (Fin m)))
    (hP : IsPrimitiveCone P) : IsClosed P := by sorry

end MatousekLP.Duality
