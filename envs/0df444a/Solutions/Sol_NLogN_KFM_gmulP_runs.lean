theorem drops4_runs (s : IState HS) (a b c d : ℤ) (L1 L2 L3 L4 : List Item)
    (h1 : s.G pX1 = .int a :: L1) (h2 : s.G pX2 = .int b :: L2) (h3 : s.G pX3 = .int c :: L3)
    (h4 : s.G pX4 = .int d :: L4) :
    IRuns I iprog (.seq (.op (.drop pX1)) (.seq (.op (.drop pX2)) (.seq (.op (.drop pX3))
      (.op (.drop pX4))))) s ((((s.upd pX1 L1).upd pX2 L2).upd pX3 L3).upd pX4 L4)
      (2 * zsz a + 2 * zsz b + 2 * zsz c + 2 * zsz d + 8) := by
  have d1 := IRuns.drop (I := I) (iprog := iprog) h1
  have d2 := IRuns.drop (I := I) (iprog := iprog) (s := s.upd pX1 L1) (i := pX2) (a := b) (L := L2)
    (by simp +decide [h2])
  have d3 := IRuns.drop (I := I) (iprog := iprog) (s := (s.upd pX1 L1).upd pX2 L2) (i := pX3)
    (a := c) (L := L3) (by simp +decide [h3])
  have d4 := IRuns.drop (I := I) (iprog := iprog) (s := ((s.upd pX1 L1).upd pX2 L2).upd pX3 L3)
    (i := pX4) (a := d) (L := L4) (by simp +decide [h4])
  exact (d1.seq (d2.seq (d3.seq d4))).mono (by omega)

theorem cMulC_le {M : MulSpec} {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    {a c : ℤ} (ha : zsz a ≤ w) (hc : zsz c ≤ w) : cMulC M a c ≤ φ + 1000 * (w + 1) := by
  have h1 := dupCost_le (zsz a); have h2 := dupCost_le (zsz c)
  have h3 := moveIntCost_le (zsz (c * a)); have h4 := zsz_mul_le c a
  have h5 := hΦ c a hc ha
  unfold cMulC; omega

set_option maxHeartbeats 1000000 in
theorem entry_runs {M : MulSpec} {pM : Fin P} (hM : MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, zsz x ≤ w → zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ : ℕ) (s : IState HS) (z t : GI) (L0 LW LR : List Item)
    (h0 : s.G 0 = .int z.1 :: .int z.2 :: L0) (hW : s.G pW = .int t.1 :: .int t.2 :: LW)
    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hz : zsz z.1 ≤ w ∧ zsz z.2 ≤ w)
    (ht : zsz t.1 ≤ w ∧ zsz t.2 ≤ w) :
    IRuns I iprog (entryB pM) s
      (((s.upd 0 L0).upd pW LW).upd pO
        (.int (gmulT Δ z t).2 :: .int (gmulT Δ z t).1 :: s.G pO))
      (4 * φ + 100000 * (w + Δ + 1)) := by
  obtain ⟨a, b⟩ := z
  obtain ⟨c, d⟩ := t
  simp only at h0 hW hz ht ⊢
  -- load
  have hL : IRuns I iprog (.seq (.op (.mv 0 pX1)) (.seq (.op (.mv 0 pX2)) (.seq (.op (.mv pW pX3))
      (.op (.mv pW pX4))))) s
      (((((s.upd 0 L0).upd pW LW).upd pX1 (.int a :: s.G pX1)).upd pX2 (.int b :: s.G pX2)).upd pX3
        (.int c :: s.G pX3) |>.upd pX4 (.int d :: s.G pX4))
      (440 * (w + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h0, hW]
    refine ⟨by ((apply NLogN.IState.ext' <;> intros <;>
                        simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                      split_ifs <;>
                    simp_all +decide)), ?_⟩
    have := moveIntCost_le (zsz a); have := moveIntCost_le (zsz b)
    have := moveIntCost_le (zsz c); have := moveIntCost_le (zsz d)
    omega
  set s1 := ((((s.upd 0 L0).upd pW LW).upd pX1 (.int a :: s.G pX1)).upd pX2 (.int b :: s.G pX2)).upd
    pX3 (.int c :: s.G pX3) |>.upd pX4 (.int d :: s.G pX4) with hs1
  have m1 := mulC_runs (I := I) (iprog := iprog) hM pP1 pX1 pX3 (by decide) (by decide) (by decide)
    s1 a c (s.G pX1) (s.G pX3) (by simp +decide [hs1]) (by simp +decide [hs1]) (hdom _ _)
  rw [show s1.G pP1 = s.G pP1 by simp +decide [hs1]] at m1
  set s2 := s1.upd pP1 (.int (c * a) :: s.G pP1) with hs2
  have m2 := mulC_runs (I := I) (iprog := iprog) hM pP2 pX2 pX4 (by decide) (by decide) (by decide)
    s2 b d (s.G pX2) (s.G pX4) (by simp +decide [hs2, hs1]) (by simp +decide [hs2, hs1]) (hdom _ _)
  rw [show s2.G pP2 = s.G pP2 by simp +decide [hs2, hs1]] at m2
  set s3 := s2.upd pP2 (.int (d * b) :: s.G pP2) with hs3
  have c1 := combC_runs (I := I) (iprog := iprog) true s3 (c * a) (d * b) Δ (s.G pP1) (s.G pP2) LR
    (by simp +decide [hs3, hs2, hs1]) (by simp +decide [hs3, hs2, hs1])
    (by simp +decide [hs3, hs2, hs1, hR])
  rw [show s3.G pO = s.G pO by simp +decide [hs3, hs2, hs1]] at c1
  set s4 := ((s3.upd pP1 (s.G pP1)).upd pP2 (s.G pP2)).upd pO
    (.int ((c * a + if true then -(d * b) else d * b).tdiv (2 ^ Δ)) :: s.G pO) with hs4
  have m3 := mulC_runs (I := I) (iprog := iprog) hM pP1 pX1 pX4 (by decide) (by decide) (by decide)
    s4 a d (s.G pX1) (s.G pX4) (by simp +decide [hs4, hs3, hs2, hs1])
    (by simp +decide [hs4, hs3, hs2, hs1]) (hdom _ _)
  rw [show s4.G pP1 = s.G pP1 by simp +decide [hs4]] at m3
  set s5 := s4.upd pP1 (.int (d * a) :: s.G pP1) with hs5
  have m4 := mulC_runs (I := I) (iprog := iprog) hM pP2 pX2 pX3 (by decide) (by decide) (by decide)
    s5 b c (s.G pX2) (s.G pX3) (by simp +decide [hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs5, hs4, hs3, hs2, hs1]) (hdom _ _)
  rw [show s5.G pP2 = s.G pP2 by simp +decide [hs5, hs4]] at m4
  set s6 := s5.upd pP2 (.int (c * b) :: s.G pP2) with hs6
  have c2 := combC_runs (I := I) (iprog := iprog) false s6 (d * a) (c * b) Δ (s.G pP1) (s.G pP2) LR
    (by simp +decide [hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs6, hs5, hs4, hs3, hs2, hs1, hR])
  rw [show s6.G pO = .int ((c * a + if true then -(d * b) else d * b).tdiv (2 ^ Δ)) :: s.G pO by
    simp +decide [hs6, hs5, hs4]] at c2
  set s7 := ((s6.upd pP1 (s.G pP1)).upd pP2 (s.G pP2)).upd pO
    (.int ((d * a + if false then -(c * b) else c * b).tdiv (2 ^ Δ)) ::
      .int ((c * a + if true then -(d * b) else d * b).tdiv (2 ^ Δ)) :: s.G pO) with hs7
  have hD := drops4_runs (I := I) (iprog := iprog) s7 a b c d (s.G pX1) (s.G pX2) (s.G pX3)
    (s.G pX4) (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp +decide [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
  refine (hL.seq (m1.seq (m2.seq (c1.seq (m3.seq (m4.seq (c2.seq hD))))))).mono' ?_ ?_
  · have e1 : (d * a + c * b).tdiv (2 ^ Δ) = (a * d + b * c).tdiv (2 ^ Δ) := by ring_nf
    have e2 : (c * a + -(d * b)).tdiv (2 ^ Δ) = (a * c - b * d).tdiv (2 ^ Δ) := by ring_nf
    simp only [gmulT, hs7, hs6, hs5, hs4, hs3, hs2, hs1, if_true, if_false, Bool.false_eq_true, e1, e2]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · have k1 := cMulC_le hΦ hz.1 ht.1
    have k2 := cMulC_le hΦ hz.2 ht.2
    have k3 := cMulC_le hΦ hz.1 ht.2
    have k4 := cMulC_le hΦ hz.2 ht.1
    have z1 := zsz_mul_le c a; have z2 := zsz_mul_le d b
    have z3 := zsz_mul_le d a; have z4 := zsz_mul_le c b
    omega

theorem mvBack_runs (L : List ℤ) (B : ℕ) (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS)
    (LO : List Item) (hO : s.G pO = ints L ++ LO) :
    IRuns I iprog (rpt pA pC pD L.length mvB) s
      ((s.upd pO LO).upd 0 (ints L.reverse ++ s.G 0))
      (L.length * (110 * (B + 1) + 64) + 60 + cRpt L.length) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd pO (ints (L.drop k) ++ LO)).upd 0 (ints (L.take k).reverse ++ s.G 0)
  have h := rpt_runs (I := I) (iprog := iprog) (A := pA) (C := pC) (D := pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) L.length T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) mvB
    (110 * (B + 1))
    (by
      intro k hk LA LC LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have H := IRuns.mv (I := I) (iprog := iprog) (s := cf3 (T k) pA pC pD LA LC LD) (i := pO)
        (j := 0) (a := L[k]) (L := ints (L.drop (k + 1)) ++ LO) (by decide)
        (by simp +decide only [T, cf3, IState.upd_G, if_true, if_false]; rw [hd]; rfl)
      refine H.mono' ?_ ?_
      · have ht : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have e2 : ints (L.take (k + 1)).reverse = .int L[k] :: ints (L.take k).reverse := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear H e2 ht hd
        ((apply NLogN.IState.ext' <;> intros <;>
                 simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
               split_ifs <;>
             simp_all +decide))
      · have := moveIntCost_le (zsz L[k]); omega)
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil]
    rw [← hO]; simp [ints]
  have e1 : T L.length = (s.upd pO LO).upd 0 (ints L.reverse ++ s.G 0) := by
    simp only [T, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at h
  exact h

theorem zsz_gmulT_le {w : ℕ} {Δ : ℕ} {z t : GI} (hz : zsz z.1 ≤ w ∧ zsz z.2 ≤ w)
    (ht : zsz t.1 ≤ w ∧ zsz t.2 ≤ w) :
    zsz (gmulT Δ z t).1 ≤ 4 * w + 1 ∧ zsz (gmulT Δ z t).2 ≤ 4 * w + 1 := by
  simp only [gmulT]
  have a1 := zsz_mul_le z.1 t.1; have a2 := zsz_mul_le z.2 t.2
  have a3 := zsz_mul_le z.1 t.2; have a4 := zsz_mul_le z.2 t.1
  have b1 := zsz_add_le' (z.1 * t.1) (-(z.2 * t.2)); rw [zsz_neg, ← sub_eq_add_neg] at b1
  have b2 := zsz_add_le' (z.1 * t.2) (z.2 * t.1)
  have c1 := KFH.zsz_tdiv_le (z.1 * t.1 - z.2 * t.2) (2 ^ Δ)
  have c2 := KFH.zsz_tdiv_le (z.1 * t.2 + z.2 * t.1) (2 ^ Δ)
  omega

end NLogN.KFM

