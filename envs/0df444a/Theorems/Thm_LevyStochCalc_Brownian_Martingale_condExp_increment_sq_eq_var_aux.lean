/-!
# Conditional expectations of Brownian increments

For a Brownian motion `W` and times `0 ≤ s < t`, the σ-algebra generated by the increment
`W_t − W_s` is independent of the natural filtration `ℱ_s`, so that `𝔼[W_t − W_s | ℱ_s] = 0`,
`𝔼[(W_t − W_s)² | ℱ_s] = t − s` and `𝔼[W_s (W_t − W_s) | ℱ_s] = 0` almost surely. The
variance identity rests on the second moment `∫ x² ∂(gaussianReal 0 v) = v` of a centred
Gaussian law.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace LevyStochCalc.Brownian.Martingale

universe u

section ConditionalExpectations
variable {Ω : Type u} [MeasurableSpace Ω]

theorem _root_.LevyStochCalc.Brownian.Martingale.condExp_increment_sq_eq_var_aux
    {P : Measure Ω} [IsProbabilityMeasure P]
    (W : LevyStochCalc.Brownian.BrownianMotion P)
    {s t : ℝ} (hs : 0 ≤ s) (hst : s < t) :
    P[(fun ω => (W.W t ω - W.W s ω)^2) | (naturalFiltration W) s] =ᵐ[P]
      fun _ => t - s := by sorry
