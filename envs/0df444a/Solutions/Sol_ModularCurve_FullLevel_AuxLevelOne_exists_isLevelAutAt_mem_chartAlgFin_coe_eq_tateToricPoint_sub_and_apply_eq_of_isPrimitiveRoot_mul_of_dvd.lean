noncomputable def pointOf {T F : Type} [CommRing T] [Field F] [Algebra T F] (W : WeierstrassCurve.Projective T)
    (S : Section W) : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap T F))) (projModelStrCR W) :=
  schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap T F))) (Category.comp_id _) S

theorem pointOf_coe {T F : Type} [CommRing T] [Field F] [Algebra T F] (W : WeierstrassCurve.Projective T) (S : Section W) :
    (pointOf (F := F) W S).1 = Spec.map (CommRingCat.ofHom (algebraMap T F)) ≫ S.1 := rfl

theorem pointOf_eq_of_isSectionThrough {T F : Type} [CommRing T] [Field F] [Algebra T F] (W : WeierstrassCurve.Projective T)
    (S : Section W) (x y : T) (h : IsSectionThrough S x y) :
    ∃ χ : ZChartRing W →+* F, (pointOf (F := F) W S).1 = Spec.map (CommRingCat.ofHom χ) ≫ zChartι W ∧
      χ (xOverZ W) = algebraMap T F x ∧ χ (yOverZ W) = algebraMap T F y := by
  obtain ⟨χ, hχ, hx, hy⟩ := h
  refine ⟨(algebraMap T F).comp χ, ?_, by simp [affX, ← hx], by simp [affY, ← hy]⟩
  rw [pointOf_coe, show S.1 = _ from hχ, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]

theorem exists_some_eq_some_add_some_of_isSectionThrough_mul
    {T F : Type} [CommRing T] [Field F] [Algebra T F]
    (W : WeierstrassCurve T) (hΔ : IsUnit W.Δ) (G : RelativeGroupLaw T (projModelStrCR W.toProjective))
    (hG : (G.one (𝟙 _)).1 = (kwZeroSect T W).1)
    (S₁ S₂ : Section W.toProjective) (x₁ y₁ x y : T)
    (h₁ : IsSectionThrough S₁ x₁ y₁) (h : IsSectionThrough (G.mul (𝟙 _) S₁ S₂) x y)
    (χ₂ : ZChartRing W.toProjective →+* F)
    (h₂ : Spec.map (CommRingCat.ofHom (algebraMap T F)) ≫ S₂.1 = Spec.map (CommRingCat.ofHom χ₂) ≫ zChartι W.toProjective) :
    ∃ (n₁ : (W.toProjective.baseChange F).toAffine.Nonsingular (algebraMap T F x₁) (algebraMap T F y₁))
      (n₂ : (W.toProjective.baseChange F).toAffine.Nonsingular (χ₂ (xOverZ W.toProjective)) (χ₂ (yOverZ W.toProjective)))
      (n : (W.toProjective.baseChange F).toAffine.Nonsingular (algebraMap T F x) (algebraMap T F y)),
      WeierstrassCurve.Affine.Point.some _ _ n = WeierstrassCurve.Affine.Point.some _ _ n₁ + WeierstrassCurve.Affine.Point.some _ _ n₂ := by
  obtain ⟨ev, hev, -, hchart⟩ :=
    WeierstrassProjModel.exists_isPointsEval_apply_eq_some_of_eq_comp_zChartInclusion W hΔ G hG

  obtain ⟨χ₁, hp₁, hx₁, hy₁⟩ := pointOf_eq_of_isSectionThrough (F := F) W.toProjective S₁ x₁ y₁ h₁
  obtain ⟨χ, hp, hx, hy⟩ := pointOf_eq_of_isSectionThrough (F := F) W.toProjective (G.mul (𝟙 _) S₁ S₂) x y h
  obtain ⟨n₁, e₁⟩ := hchart F (pointOf W.toProjective S₁) χ₁ hp₁
  obtain ⟨n, e⟩ := hchart F (pointOf W.toProjective (G.mul (𝟙 _) S₁ S₂)) χ hp
  obtain ⟨n₂, e₂⟩ := hchart F (pointOf W.toProjective S₂) χ₂ (by rw [pointOf_coe]; exact h₂)

  have hmul : pointOf (F := F) W.toProjective (G.mul (𝟙 _) S₁ S₂) =
      G.mul _ (pointOf W.toProjective S₁) (pointOf W.toProjective S₂) :=
    G.mul_natural _ _ _ _ S₁ S₂
  have hadd := hev.1 F (pointOf W.toProjective S₁) (pointOf W.toProjective S₂)
  rw [← hmul, e, e₁, e₂] at hadd
  rw [hx₁, hy₁] at n₁
  rw [hx, hy] at n
  refine ⟨n₁, n₂, n, ?_⟩

  have key : ∀ (a b a' b' : F) (ha : (W.toProjective.baseChange F).toAffine.Nonsingular a b) (ea : a = a') (eb : b = b')
      (ha' : (W.toProjective.baseChange F).toAffine.Nonsingular a' b'),
      WeierstrassCurve.Affine.Point.some a b ha = WeierstrassCurve.Affine.Point.some a' b' ha' := by
    intro a b a' b' ha ea eb ha'; subst ea; subst eb; rfl
  rw [key _ _ _ _ _ hx hy n, key _ _ _ _ _ hx₁ hy₁ n₁] at hadd
  exact hadd

theorem exists_comp_eq_comp_zChartι_of_isSectionThrough
    {T F : Type} [CommRing T] [CommRing F] (W : WeierstrassCurve.Projective T) (f : T →+* F)
    (W' : WeierstrassCurve.Projective F) (e : W' = W.map f)
    (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map f))
    (hφ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map f)) ≤ (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ)
    (hcoef : IsCoefficientHom W f φ)
    (S : Section W) (S' : Section W')
    (hSS' : S'.1 ≫ eqToHom (congrArg projModelCR e) ≫ Proj.map φ hφ = Spec.map (CommRingCat.ofHom f) ≫ S.1)
    (a b : F) (hS' : IsSectionThrough S' a b) :
