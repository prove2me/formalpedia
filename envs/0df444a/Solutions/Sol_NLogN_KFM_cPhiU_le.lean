  have hN := NLogN.KFM.Nc_ge_d2 (6 * (IntMul.lg n : ℝ)) (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.KP n) (IntMul.OpenAI.Glue.ℓP n) (IntMul.OpenAI.Glue.αP n)
    (by rw [NLogN.KFM.six_lg' hn]; exact_mod_cast (by omega : 1 ≤ pP n)) (by positivity) (by positivity)
    (by positivity) (by positivity)
  rw [← NLogN.KFM.NcN] at hN
  have hlτ : 0 ≤ (IntMul.OpenAI.Glue.ℓP n : ℝ) ^ τ := by positivity
  have hdR : (1 : ℝ) ≤ d := by exact_mod_cast hd1
  have hTp : (0 : ℝ) ≤ (T : ℝ) * p := by positivity
  have hpoly : (((d + 1) * (h + (p + 2) + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) ≤
      10 ^ 4 * ((IntMul.OpenAI.Glue.bP n + 1) ^ 6 : ℕ) := by
    have hh : h ≤ IntMul.OpenAI.Glue.bP n := by have := (NLogN.KFM.setup_facts hn).2.2.2.2.2.2.1; unfold h; omega
    have : (d + 1) * (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ 10 ^ 4 * (IntMul.OpenAI.Glue.bP n + 1) ^ 6 := by
      have e1 : (d + 1) * (h + (p + 2) + Nat.size VS + 1) ^ 2 ≤ (IntMul.OpenAI.Glue.bP n + 1) * (8 * (IntMul.OpenAI.Glue.bP n + 1)) ^ 2 :=
        Nat.mul_le_mul (by omega) (Nat.pow_le_pow_left (by unfold p IntMul.OpenAI.Glue.pP; omega) 2)
      have e2 : (IntMul.OpenAI.Glue.bP n + 1) * (8 * (IntMul.OpenAI.Glue.bP n + 1)) ^ 2 ≤ 64 * (IntMul.OpenAI.Glue.bP n + 1) ^ 6 := by
        have : (IntMul.OpenAI.Glue.bP n + 1) ^ 3 ≤ (IntMul.OpenAI.Glue.bP n + 1) ^ 6 := Nat.pow_le_pow_right (by omega) (by norm_num)
        nlinarith
      omega
