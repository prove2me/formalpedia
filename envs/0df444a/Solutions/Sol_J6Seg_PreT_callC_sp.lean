-- Source module: Solutions.J6SegILPre3
/-!
# B-line IL, pre-tables (B5), part 3: calls of the library number programs

`callC d e16 e17 e18 e27 prog`: push the four inputs on `16, 17, 18, 27`, run `prog` (which pushes
its result on `19` and leaves everything else), move the result into register `d ∈ rg`, pop.
`callC_sp`: generic; `enC_sp` / `epC_sp`: `v d := expNeg n k j` / `expPos n k j σ`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

theorem n16 : (16 : Fin HS) ∉ rg := by decide
theorem n17 : (17 : Fin HS) ∉ rg := by decide
theorem n18 : (18 : Fin HS) ∉ rg := by decide
theorem n19 : (19 : Fin HS) ∉ rg := by decide
theorem n27 : (27 : Fin HS) ∉ rg := by decide

theorem RF_G (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {j : Fin HS} (hj : j ∉ rg) :
    (encK s (RF v c)).G j = ints (c j) ++ s.G j := by simp [RF_out hj]

theorem zsz_eval {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} {e : Ex HS} {V : Fin HS → ℕ} {B : ℕ}
    (he : InRg e) (hv : ∀ j ∈ e.regs, |v j| ≤ V j) (hm : mg V e < 2 ^ B) :
    zsz (e.eval (encK s (RF v c))) ≤ B :=
  zsz_of_le (eval_le_mg _ V e (RF_bnd he hv)) hm

/-- **A call.** -/
theorem callC_sp_sol_aux (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {d : Fin HS} (hd : d ∈ rg)
    {e16 e17 e18 e27 : Ex HS} (h16 : InRg e16) (h17 : InRg e17) (h18 : InRg e18) (h27 : InRg e27)
    (o16 : e16.ok (encK s (RF v c))) (o17 : e17.ok (encK s (RF v c)))
    (o18 : e18.ok (encK s (RF v c))) (o27 : e27.ok (encK s (RF v c)))
    {a16 a17 a18 a27 : ℕ} (v16 : e16.eval (encK s (RF v c)) = a16)
    (v17 : e17.eval (encK s (RF v c)) = a17) (v18 : e18.eval (encK s (RF v c)) = a18)
    (v27 : e27.eval (encK s (RF v c)) = a27)
    {prog : RS} {r : ℤ} {C : ℕ}
    (hprog : ∀ (t : IState HS) (L16 L17 L18 L27 : List Item), t.G 16 = .int a16 :: L16 →
      t.G 17 = .int a17 :: L17 → t.G 18 = .int a18 :: L18 → t.G 27 = .int a27 :: L27 →
      prog.ok t ∧ prog.run t = t.upd 19 (.int r :: t.G 19) ∧ prog.cost t ≤ C)
    {V : Fin HS → ℕ} {B : ℕ} (b16 : ∀ j ∈ e16.regs, |v j| ≤ V j) (b17 : ∀ j ∈ e17.regs, |v j| ≤ V j)
    (b18 : ∀ j ∈ e18.regs, |v j| ≤ V j) (b27 : ∀ j ∈ e27.regs, |v j| ≤ V j)
    (m16 : mg V e16 < 2 ^ B) (m17 : mg V e17 < 2 ^ B) (m18 : mg V e18 < 2 ^ B)
    (m27 : mg V e27 < 2 ^ B) (hr : zsz r ≤ B) (hvd : zsz (v d) ≤ B) :
    Sp (callC d e16 e17 e18 e27 prog) (encK s (RF v c)) (encK s (RF (Function.update v d r) c))
      (cCall e16 e17 e18 e27 B C) := by
  set s0 := encK s (RF v c)
  -- the four pushes
  have p1 := spU s v c n16 (by decide) h16 o16 b16 m16
  rw [v16] at p1
  set c1 := Function.update c 16 ((a16 : ℤ) :: c 16) with hc1
  have p2 := spU s v c1 n17 (by decide) h17 (agr_ok _ (agr_RF h17) o17) b17 m17
  rw [agr_eval _ (agr_RF (c' := c) h17), v17] at p2
  set c2 := Function.update c1 17 ((a17 : ℤ) :: c1 17) with hc2
  have p3 := spU s v c2 n18 (by decide) h18 (agr_ok _ (agr_RF h18) o18) b18 m18
  rw [agr_eval _ (agr_RF (c' := c) h18), v18] at p3
  set c3 := Function.update c2 18 ((a18 : ℤ) :: c2 18) with hc3
  have p4 := spU s v c3 n27 (by decide) h27 (agr_ok _ (agr_RF h27) o27) b27 m27
  rw [agr_eval _ (agr_RF (c' := c) h27), v27] at p4
  set c4 := Function.update c3 27 ((a27 : ℤ) :: c3 27) with hc4
  -- the program
  have g : ∀ (j : Fin HS) (a : ℕ), j ∉ rg → c4 j = (a : ℤ) :: c j →
      (encK s (RF v c4)).G j = .int a :: (ints (c j) ++ s.G j) := by
    intro j a hj h; rw [RF_G s v c4 hj, h]; simp [ints]
  obtain ⟨q1, q2, q3⟩ := hprog (encK s (RF v c4)) _ _ _ _
    (g 16 a16 n16 (by simp [hc4, hc3, hc2, hc1]))
    (g 17 a17 n17 (by simp [hc4, hc3, hc2, hc1]))
    (g 18 a18 n18 (by simp [hc4, hc3, hc2, hc1]))
    (g 27 a27 n27 (by simp [hc4, hc3, hc2, hc1]))
  set c5 := Function.update c4 19 (r :: c4 19) with hc5
  have e5 : (encK s (RF v c4)).upd 19 (.int r :: (encK s (RF v c4)).G 19) = encK s (RF v c5) := by
    rw [RF_G s v c4 n19, show Item.int r :: (ints (c4 19) ++ s.G 19) = ints (r :: c4 19) ++ s.G 19
      by simp [ints], encK_upd, upd_RF_out n19]
  have pP : Sp prog (encK s (RF v c4)) (encK s (RF v c5)) C := ⟨q1, by rw [q2, e5], q3⟩
  -- the result into `d`
  have pA := Sp.asg s (RF v c5) (i := d) (e := .reg 19) (a := v d) (l := []) (B := B)
    (by simp only [rg, List.mem_cons, List.not_mem_nil, or_false] at hd
        rcases hd with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h <;>
          (subst h; decide))
    (RF_in hd) hvd (clean_of_lt (by decide)) (ok_reg (a := r) (l := c4 19) (by rw [RF_out n19, hc5]; simp))
    trivial (bnd_reg (a := r) (l := c4 19) (by rw [RF_out n19, hc5]; simp) hr)
  rw [eval_reg (a := r) (l := c4 19) (by rw [RF_out n19, hc5]; simp), upd_RF_in hd] at pA
  -- the pops
  set v' := Function.update v d r
  have hz : ∀ a : ℕ, ∀ e : Ex HS, InRg e → (∀ j ∈ e.regs, |v j| ≤ V j) → mg V e < 2 ^ B →
      e.eval s0 = a → zsz (a : ℤ) ≤ B := fun a e he hb hm hv => by
    rw [← hv]; exact zsz_eval he hb hm
  have o1 := spO s v' c5 n19 (by decide) (a := r) (l := c4 19) (by simp [hc5]) hr
  have o2 := spO s v' (Function.update c5 19 (c4 19)) n27 (by decide) (a := a27) (l := c3 27)
    (by simp [hc5, hc4]) (hz _ _ h27 b27 m27 v27)
  have o3 := spO s v' (Function.update (Function.update c5 19 (c4 19)) 27 (c3 27)) n18 (by decide)
    (a := a18) (l := c2 18)
    (by simp [hc5, hc4, hc3]) (hz _ _ h18 b18 m18 v18)
  have o4 := spO s v' (Function.update (Function.update (Function.update c5 19 (c4 19)) 27 (c3 27))
    18 (c2 18)) n17 (by decide) (a := a17) (l := c1 17) (by simp [hc5, hc4, hc3, hc2]) (hz _ _ h17 b17 m17 v17)
  have o5 := spO s v' (Function.update (Function.update (Function.update (Function.update c5 19
    (c4 19)) 27 (c3 27)) 18 (c2 18)) 17 (c1 17)) n16 (by decide) (a := a16) (l := c 16) (by simp [hc5, hc4, hc3, hc2, hc1])
    (hz _ _ h16 b16 m16 v16)
  have hfin : Function.update (Function.update (Function.update (Function.update (Function.update c5
      19 (c4 19)) 27 (c3 27)) 18 (c2 18)) 17 (c1 17)) 16 (c 16) = c := by
    rw [hc5, Function.update_idem, Function.update_eq_self, hc4, Function.update_idem,
      Function.update_eq_self, hc3, Function.update_idem, Function.update_eq_self, hc2,
      Function.update_idem, Function.update_eq_self, hc1, Function.update_idem,
      Function.update_eq_self]
  rw [hfin] at o5
  have T := p1.seq (p2.seq (p3.seq (p4.seq (pP.seq (pA.seq (o1.seq (o2.seq (o3.seq o4))))))))
  have T2 := T.seq o5
  refine (T2.mono ?_)
  simp only [cCall, cE, Ex.size]
  omega

end J6Seg.PreT

end

theorem solution : type_of% @J6Seg.PreT.callC_sp_sol_aux := @J6Seg.PreT.callC_sp_sol_aux
