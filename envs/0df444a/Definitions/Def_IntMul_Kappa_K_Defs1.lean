-- Source module: Solutions.AModelCost
/-!
# Cost recurrences for the A-model (§4, Prop. 11 eq. (12) and Lemma 12)

* `power_width_recurrence`: `F (k+1) ≤ (s/W) F k + C` with `s/W < m^τ` gives
  `F k ≤ K (m^k)^τ`.
* `power_width_time`: the volume-scaled ("time") version
  `T (k+1) V ≤ C V + s T k (V/W)` gives `T k V ≤ K V (m^k)^τ`.
* `arbitrary_width_sum`: digit decomposition `Σ_j a_j (m^j)^τ ≤ K' e^τ`.
* `log_two_mul_le_rpow`: `log (2e) ≤ c e^τ`.
* `arbitrary_width_cost`: combination, total cost `≤ K'' V e^τ`.
-/

namespace AModel

open Finset

/-- The coefficient sequence `G 0 = C`, `G (k+1) = (s/W) G k + C`. -/
noncomputable def coeffSeq (s W : ℕ) (C : ℝ) : ℕ → ℝ
  | 0 => C
  | k + 1 => ((s : ℝ) / W) * coeffSeq s W C k + C

/-- The `j`-th base-`m` digit of `e` (zero beyond the length). -/
def digit (m e j : ℕ) : ℕ := (Nat.digits m e).getD j 0

end AModel

end

