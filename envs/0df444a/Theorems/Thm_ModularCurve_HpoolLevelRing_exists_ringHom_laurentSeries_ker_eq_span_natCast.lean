-- title:
--   Characteristic-q Laurent realisation of the finite j-chart of level p
-- statement:
--   Let $p$ be a prime and let $q$ be a natural number with `hq : q.Prime` and $q \neq p$. Write $F_p =$ [`ModularCurve.modularFunctionFieldFull p`](def/ModularCurve_X0.html#L305) for the intermediate field of `LaurentSeries ℚ` over $\mathbf{Q}$ generated by the set of $q$-expansions `qExpand ℚ d jq` for the nonzero divisors $d \mid p$, let [`ModularCurve.IgusaScheme.jFull p`](def/ModularCurve_IgusaScheme.html#L40) be the element of $F_p$ given by the $q$-expansion `jq` of the modular invariant, and let $A =$ [`ModularCurve.HpoolLevelRing.Afin p`](def/ModularCurve_HpoolLevelRing.html#L20) be the subalgebra [`AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ℤ F_p (IgusaScheme.jFull p)`](def/AlgebraicCurve_TwoChartIntegralModel.html#L142), i.e. `chartAlg ℤ F_p {jFull p}`, the finite-chart algebra of the two-chart integral model over $\mathbf{Z}$ attached to that generator; `jChartFin` is the distinguished element of $A$ whose image in $F_p$ is `jFull p`. The assertion is that there exist a type $K$, a field structure on it, a `CharP K q` and an `IsAlgClosed K` instance, and a ring homomorphism $\varphi \colon A \to$ `LaurentSeries K` such that the kernel of $\varphi$ is the ideal of $A$ generated by $q$, and $\varphi$ sends `jChartFin` to [`ModularCurve.jqModC K`](def/ModularCurve_JqCoeff.html#L15), the Laurent series $t^{-1}$ times the image under $\mathbf{Z} \to K$ of the power series `jNum` $= E_4^3 \cdot$ `dedekindEtaUnitInv`.
--
--   This records the good reduction of the finite $j$-chart of the level-$p$ modular curve at a prime $q \neq p$ in the concrete form of an embedding of the fibre $A/qA$ into Laurent series over an algebraically closed field of characteristic $q$, with the chart coordinate going to the mod-$q$ $q$-expansion of $j$; in particular $qA$ is prime. It is used by [`ModularCurve.HpoolLevelRing.exists_finite_etale_levelRing_jChartFin`](thm.html#ModularCurve.HpoolLevelRing.exists_finite_etale_levelRing_jChartFin).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_HpoolLevelRing_exists_ringHom_laurentSeries_ker_eq_span_natCast.lean

import Mathlib
import Definitions.Def_ModularCurve_HpoolLevelRing
import Definitions.Def_ModularCurve_X0ModL

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

theorem ModularCurve.HpoolLevelRing.exists_ringHom_laurentSeries_ker_eq_span_natCast
    (p : ℕ) [Fact p.Prime] [NeZero p] (q : ℕ) (hq : q.Prime) (hqp : q ≠ p) :
    ∃ (K : Type) (_ : Field K) (_ : CharP K q) (_ : IsAlgClosed K)
      (φ : ModularCurve.HpoolLevelRing.Afin p →+* LaurentSeries K),
      RingHom.ker φ = Ideal.span {(q : ModularCurve.HpoolLevelRing.Afin p)} ∧
      φ (AlgebraicCurve.TwoChartIntegralModel.jChartFin ℤ ↥(ModularCurve.modularFunctionFieldFull p)
          (ModularCurve.IgusaScheme.jFull p)) = ModularCurve.jqModC K := by sorry
