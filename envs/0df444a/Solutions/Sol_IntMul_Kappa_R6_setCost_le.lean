theorem d3_eventually (P : Prm) (hP : P.Ok) : ∃ n₁, ∀ n, n₁ ≤ n → 3 ≤ dP6 P n := by
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  refine ⟨max n₀ (2 ^ 64), fun n hn => ?_⟩
  have G := hG n (le_trans (le_max_left _ _) hn)
  have hb : 64 ≤ bP6 n := lg_ge 64 (le_trans (le_max_right _ _) hn)
  have hb1 : (64 : ℝ) ≤ bP6 n := by exact_mod_cast hb
  have hb0 : (0 : ℝ) < bP6 n := by linarith
  have h2e : (bP6 n : ℝ) ^ (1 : ℝ) ≤ (bP6 n : ℝ) ^ (2 * P.ε) :=
    Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith [hP.eps_ge])
  rw [Real.rpow_one] at h2e
  have hsq : (bP6 n : ℝ) ^ (2 * P.ε) = (bP6 n : ℝ) ^ P.ε * (bP6 n : ℝ) ^ P.ε := by
    rw [← Real.rpow_add hb0]; ring_nf
  have he : 0 ≤ (bP6 n : ℝ) ^ P.ε := (Real.rpow_pos_of_pos hb0 _).le
  have h8 : (8 : ℝ) ≤ (bP6 n : ℝ) ^ P.ε := by nlinarith
  have := G.d_ge
  have : (3 : ℝ) ≤ dP6 P n := by linarith
  exact_mod_cast this

/-- `b^k ≤ 2^{k (log b + 1)}`. -/
theorem pow_le_log (b k : ℕ) : b ^ k ≤ 2 ^ (k * (Nat.log 2 b + 1)) := by
  rw [mul_comm, pow_mul]
  exact Nat.pow_le_pow_left (Nat.lt_pow_succ_log_self (by norm_num) b).le k

set_option maxHeartbeats 1000000 in
theorem setCost_le_sol_aux (P : Prm) (hP : P.Ok) (a c : ℕ) :
    ∃ n₁, ∀ n, n₁ ≤ n → cSet P n a c * kU (BbS P n a c) ≤ 2 ^ LP6 P n * pP6 P n := by
  obtain ⟨n₀, hG⟩ := params6_ok P hP
  obtain ⟨n₃, hd3⟩ := d3_eventually P hP
  set K := KcS P a c with hK
  set m := 24 * K + 1 with hm
  obtain ⟨n₂, hE⟩ := ell_big P hP (2 + P.x + m)
  refine ⟨max (max n₀ n₂) n₃, fun n hn => ?_⟩
  have G := hG n (le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn)
  have E := hE n (le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn)
  have hd3' := hd3 n (le_trans (le_max_right _ _) hn)
  set b := bP6 n with hb
  set b' := b'P6 P n with hb'
  set p := pP6 P n with hp
  set d := dP6 P n with hd
  set L := LP6 P n with hL
  set ℓ := ℓP6 P n with hℓ
  set lb := Nat.log 2 b with hlb
  set r := 2 ^ ℓ with hr
  set D := DgS P a c with hD
  have hb4 : 4 ≤ b := G.b_ge
  have hdb : d ≤ b := G.d_le_b
  have hb'e : b' = b ^ (1 + P.x) := rfl
  have hpe : p = 6 * b' := rfl
  have hbb' : b ≤ b' := by rw [hb'e]; exact Nat.le_self_pow (by omega) _
  have hl1 : 1 ≤ ℓ := G.ell_pos
  have hdl : d * ℓ ≤ L + d - 1 := G.dℓ_le
  -- `ℓ` is large
  have hℓC : (2 + P.x + m) * (lb + 1) ≤ ℓ := by
    have : (lb + 1) ≤ (lb + 1) ^ 2 := by nlinarith
    calc (2 + P.x + m) * (lb + 1) ≤ (2 + P.x + m) * (lb + 1) ^ 2 := Nat.mul_le_mul_left _ this
      _ ≤ ℓ := E
  have hr1 : 2 ^ m * b ^ (2 + P.x) ≤ r := by
    have h1 : b ^ (2 + P.x) ≤ 2 ^ ((2 + P.x) * (lb + 1)) := pow_le_log b _
    have h2 : 2 ^ m ≤ 2 ^ (m * (lb + 1)) := Nat.pow_le_pow_right (by norm_num) (by nlinarith)
    calc 2 ^ m * b ^ (2 + P.x) ≤ 2 ^ (m * (lb + 1)) * 2 ^ ((2 + P.x) * (lb + 1)) :=
          Nat.mul_le_mul h2 h1
      _ = 2 ^ ((2 + P.x + m) * (lb + 1)) := by rw [← pow_add]; ring_nf
      _ ≤ r := Nat.pow_le_pow_right (by norm_num) hℓC
  have hm2 : 24 * K < 2 ^ m := by
    have := Nat.lt_two_pow_self (n := m); omega
  have hbpow : b * b' ≤ b ^ (2 + P.x) := by
    rw [hb'e, ← pow_succ']; exact Nat.pow_le_pow_right (by omega) (by omega)
  -- `4 K d p ≤ r`
  have hkey : 4 * K * d * p ≤ r := by
    have : 4 * K * d * p ≤ 24 * K * (b * b') := by
      rw [hpe]
      have := Nat.mul_le_mul_right b' hdb
      nlinarith
    have h3 : 24 * K * (b * b') ≤ 2 ^ m * b ^ (2 + P.x) :=
      Nat.mul_le_mul (by omega) hbpow
    omega
  have hr0 : 1 ≤ r := Nat.one_le_two_pow
  have hbr : b' ≤ r := by
    have h1 : b' ≤ b * b' := Nat.le_mul_of_pos_left _ (by omega)
    have h2 : b ^ (2 + P.x) ≤ 2 ^ m * b ^ (2 + P.x) :=
      Nat.le_mul_of_pos_left _ Nat.one_le_two_pow
    omega
  -- `r³ ≤ 4 T`
  have hT : r * r * r ≤ 4 * 2 ^ L := by
    have h1 : 3 * ℓ + d ≤ d * ℓ + 3 := by nlinarith
    have h2 : 3 * ℓ ≤ L + 2 := by omega
    calc r * r * r = 2 ^ (3 * ℓ) := by rw [hr, ← pow_add, ← pow_add]; ring_nf
      _ ≤ 2 ^ (L + 2) := Nat.pow_le_pow_right (by norm_num) h2
      _ = 4 * 2 ^ L := by ring
  -- `cSet ≤ 400 (a+c+x+1) d r²`
  have hcS : cSet P n a c ≤ 400 * (a + c + P.x + 1) * d * (r * r) := by
    have e0 : cSet P n a c = b * (2 * a + 2 * c + 31) + 15 * b' + 2 * P.x + 44 +
        d * (r * (22 * r + 52) + 60 + 41) + 100 := rfl
    rw [e0]
    have hrr : r ≤ r * r := Nat.le_mul_self r
    have hdrr : r * r ≤ d * (r * r) := Nat.le_mul_of_pos_left _ (by omega)
    have hbr' : b ≤ r := le_trans hbb' hbr
    have hR : r ≤ d * (r * r) := le_trans hrr hdrr
    have hRb : b ≤ d * (r * r) := le_trans hbr' hR
    have hRb' : b' ≤ d * (r * r) := le_trans hbr hR
    have hdr : d * r ≤ d * (r * r) := Nat.mul_le_mul_left _ hrr
    have hR1 : 1 ≤ d * (r * r) := le_trans hr0 hR
    have hdR : d ≤ d * (r * r) := le_trans (Nat.le_mul_of_pos_right _ hr0) hdr
    have i1 : b * (2 * a + 2 * c + 31) ≤ d * (r * r) * (2 * a + 2 * c + 31) :=
      Nat.mul_le_mul_right _ hRb
    have e3 : d * (r * r) * (2 * a + 2 * c + 31) =
        2 * (a * (d * (r * r))) + 2 * (c * (d * (r * r))) + 31 * (d * (r * r)) := by ring
    have e1 : d * (r * (22 * r + 52) + 60 + 41) = 22 * (d * (r * r)) + 52 * (d * r) + 101 * d := by
      ring
    have e2 : 400 * (a + c + P.x + 1) * d * (r * r) = 400 * (a * (d * (r * r))) +
        400 * (c * (d * (r * r))) + 400 * (P.x * (d * (r * r))) + 400 * (d * (r * r)) := by ring
    have i2 : P.x ≤ P.x * (d * (r * r)) := Nat.le_mul_of_pos_right _ hR1
    rw [e1, e2]
    omega
  -- `kU ≤ 9·10^7 D² p²`
  have hkU : kU (BbS P n a c) ≤ 9 * 10 ^ 7 * D ^ 2 * p ^ 2 := by
    simp only [kU, BbS, ← hD, ← hp, ← hb]
    have h1 : 2 * b + 11 ≤ p := by rw [hpe]; omega
    have hD1 : 1 ≤ D := by rw [hD, DgS]; omega
    have h2 : D * (p + 2 * b + 8) + 1 + 2 ≤ 3 * D * p := by nlinarith
    calc 10 ^ 7 * (D * (p + 2 * b + 8) + 1 + 2) ^ 2 ≤ 10 ^ 7 * (3 * D * p) ^ 2 :=
          Nat.mul_le_mul_left _ (Nat.pow_le_pow_left h2 2)
      _ = 9 * 10 ^ 7 * D ^ 2 * p ^ 2 := by ring
  have hKe : 400 * (a + c + P.x + 1) * (9 * 10 ^ 7 * D ^ 2) ≤ K := by
    rw [hK, KcS, ← hD]; nlinarith
  calc cSet P n a c * kU (BbS P n a c)
      ≤ (400 * (a + c + P.x + 1) * d * (r * r)) * (9 * 10 ^ 7 * D ^ 2 * p ^ 2) :=
        Nat.mul_le_mul hcS hkU
    _ = (400 * (a + c + P.x + 1) * (9 * 10 ^ 7 * D ^ 2)) * d * p * (r * r) * p := by ring
    _ ≤ K * d * p * (r * r) * p := by gcongr
    _ ≤ 2 ^ L * p := by
        have : 4 * (K * d * p * (r * r)) ≤ 4 * 2 ^ L := by
          calc 4 * (K * d * p * (r * r)) = (4 * K * d * p) * (r * r) := by ring
            _ ≤ r * (r * r) := Nat.mul_le_mul_right _ hkey
            _ = r * r * r := by ring
            _ ≤ 4 * 2 ^ L := hT
        have h' : K * d * p * (r * r) ≤ 2 ^ L := by omega
        exact Nat.mul_le_mul_right _ h'

end

end IntMul.Kappa.R6

