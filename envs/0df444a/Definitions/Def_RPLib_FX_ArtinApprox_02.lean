/-! ### piece ArA5d2 -/
section Piece_ArA5d2


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5d2: the monomial curve `x_i ↦ t^{c^i}` detects a nonzero series

`rhoSub c n i = t^{c^i}`; substituting it into `s ∈ K[[x₀, …, x_{n-1}]]` gives a power series in `t` whose
coefficient at the weight `wt c d₀` of the colex-minimal exponent `d₀` of `s` is `coeff d₀ s ≠ 0`
(`exists_rho_ne_zero`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

variable {K : Type*} [Field K]

/-- The base-`c` weight of an exponent. -/
def wt (c : ℕ) {n : ℕ} (d : Fin n →₀ ℕ) : ℕ := ∑ i : Fin n, c ^ (i : ℕ) * d i

/-- The monomial curve `x_i ↦ t^{c^i}`. -/
abbrev rhoSub (c n : ℕ) : Fin n → MvPowerSeries Unit K := fun i => (PowerSeries.X : PowerSeries K) ^ (c ^ (i : ℕ))

theorem hasSubst_rho {c : ℕ} (hc : 1 ≤ c) (n : ℕ) : MvPowerSeries.HasSubst (rhoSub (K := K) c n) :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero fun i => by
    change MvPowerSeries.constantCoeff ((MvPowerSeries.X () : MvPowerSeries Unit K) ^ (c ^ (i : ℕ))) = 0
    rw [map_pow, MvPowerSeries.constantCoeff_X, zero_pow (pow_pos hc _).ne']

theorem prod_rho (c : ℕ) {n : ℕ} (d : Fin n →₀ ℕ) :
    (d.prod fun s e => (rhoSub (K := K) c n s) ^ e) = (PowerSeries.X : PowerSeries K) ^ (wt c d) := by
  rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _)]
  simp only [rhoSub, ← pow_mul]
  rw [Finset.prod_pow_eq_pow_sum, wt]

theorem mv_coeff_X_pow (v w : ℕ) :
    MvPowerSeries.coeff (Finsupp.single () v) ((PowerSeries.X : PowerSeries K) ^ w) = if v = w then 1 else 0 :=
  PowerSeries.coeff_X_pow v w

theorem coeff_rho {c n : ℕ} (hc : 1 ≤ c) (s : MvPowerSeries (Fin n) K) (d₀ : Fin n →₀ ℕ)
    (hmin : ∀ d, d ≠ d₀ → MvPowerSeries.coeff d s ≠ 0 → wt c d₀ < wt c d) :
    PowerSeries.coeff (wt c d₀) (MvPowerSeries.subst (rhoSub c n) s) = MvPowerSeries.coeff d₀ s := by
  change MvPowerSeries.coeff (Finsupp.single () (wt c d₀)) (MvPowerSeries.subst (rhoSub c n) s) = _
  rw [MvPowerSeries.coeff_subst (hasSubst_rho hc n)]
  simp_rw [prod_rho, mv_coeff_X_pow]
  rw [finsum_eq_single _ d₀]
  · rw [if_pos rfl, smul_eq_mul, mul_one]
  · intro d hd
    by_cases h : MvPowerSeries.coeff d s = 0
    · rw [h, zero_smul]
    · rw [if_neg (hmin d hd h).ne, smul_zero]

/-- **A nonzero series survives the monomial curve `x_i ↦ t^{c^i}`** for a suitable `c ≥ 2`. -/
theorem exists_rho_ne_zero {n : ℕ} (s : MvPowerSeries (Fin n) K) (hs : s ≠ 0) :
    ∃ c, 2 ≤ c ∧ ∃ d₀ : Fin n →₀ ℕ, MvPowerSeries.coeff d₀ s ≠ 0 ∧
      PowerSeries.coeff (wt c d₀) (MvPowerSeries.subst (rhoSub (K := K) c n) s) ≠ 0 := by
  obtain ⟨d, hd⟩ : ∃ d, MvPowerSeries.coeff d s ≠ 0 := by
    by_contra h
    push Not at h
    exact hs (MvPowerSeries.ext fun d => by rw [h d, map_zero])
  let S : Set (Fin n → ℕ) := {f | MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm f) s ≠ 0}
  have hdS : (⇑d : Fin n → ℕ) ∈ S := by
    change MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm ⇑d) s ≠ 0
    rw [Finsupp.equivFunOnFinite_symm_coe]
    exact hd
  obtain ⟨α, hαS, c, hc, hmin⟩ := colex_min_weight S ⟨_, hdS⟩
  refine ⟨c, hc, Finsupp.equivFunOnFinite.symm α, hαS, ?_⟩
  rw [coeff_rho (by omega) s _ fun d' hne hd' => ?_]
  · exact hαS
  · have hd'S : (⇑d' : Fin n → ℕ) ∈ S := by
      change MvPowerSeries.coeff (Finsupp.equivFunOnFinite.symm ⇑d') s ≠ 0
      rw [Finsupp.equivFunOnFinite_symm_coe]
      exact hd'
    have hne' : (⇑d' : Fin n → ℕ) ≠ α := fun h => hne (by rw [← h, Finsupp.equivFunOnFinite_symm_coe])
    have := hmin _ hd'S hne'
    simpa [wt, Finsupp.coe_equivFunOnFinite_symm] using this

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5d2

/-! ### piece ArA6b -/
section Piece_ArA6b


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA6b: helper facts for the power-series side of the coefficient system

`dvd_of_coe_dvd`: a distinguished polynomial dividing a polynomial in `A⟦X⟧` divides it in `A[X]` (uniqueness of
Weierstrass division). `mkP_coeff`, `mkR_coeff`: monic / low-degree polynomials from their coefficients.
`coe_thetaS`, `finSuccEquiv_symm_evS`: the coefficient map `K[x₀, …, x_n] → K[[x']][X]` is compatible with
`MvPowerSeries.finSuccEquiv`. `constantCoeff_eq_zero_of_mem`, `cc_cc_finSuccEquiv`: constant terms.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

/-- A distinguished polynomial dividing `F` in `A⟦X⟧` divides it in `A[X]`. -/
theorem dvd_of_coe_dvd {A : Type*} [CommRing A] {I : Ideal A} [IsHausdorff I A] (hI : I ≠ ⊤) {Q F : A[X]}
    (hQ : Q.IsDistinguishedAt I) (h : (Q : PowerSeries A) ∣ (F : PowerSeries A)) : Q ∣ F := by
  obtain ⟨W, hW⟩ := h
  have hnt : Nontrivial A := nontrivial_of_ne 0 1 fun h => hI ((Ideal.eq_top_iff_one I).mpr (h ▸ I.zero_mem))
  have hmon := hQ.monic
  have hord : ((Q : PowerSeries A).map (Ideal.Quotient.mk I)).order.toNat = Q.natDegree := by
    have := hQ.coe_natDegree_eq_order_map (Q : PowerSeries A) 1
      (by rw [map_one]; exact (Ideal.ne_top_iff_one I).mp hI) (mul_one _).symm
    rw [← this, ENat.toNat_natCast]
  have H : (Q : PowerSeries A).IsWeierstrassDivisorAt I := hQ.isWeierstrassDivisorAt hI
  have e : (Q : PowerSeries A) * (W - ((F /ₘ Q : A[X]) : PowerSeries A)) = ((F %ₘ Q : A[X]) : PowerSeries A) := by
    rw [modByMonic_eq_sub_mul_div F Q, Polynomial.coe_sub, Polynomial.coe_mul, hW, mul_sub]
  have hdeg : (F %ₘ Q).degree < ((Q : PowerSeries A).map (Ideal.Quotient.mk I)).order.toNat := by
    rw [hord, ← degree_eq_natDegree hmon.ne_zero]
    exact degree_modByMonic_lt F hmon
  exact (modByMonic_eq_zero_iff_dvd hmon).mp (H.eq_zero_of_mul_eq hdeg e).2

/-- A monic polynomial from its coefficients. -/
theorem mkP_coeff {S : Type*} [CommRing S] (P : S[X]) (hP : P.Monic) :
    mkP P.natDegree (fun l => P.coeff l) = P := by
  rw [mkP, Fin.sum_univ_eq_sum_range (fun l => C (P.coeff l) * X ^ l) P.natDegree]
  exact hP.as_sum.symm

/-- A polynomial of degree `< D` from its coefficients. -/
theorem mkR_coeff {S : Type*} [CommRing S] {D : ℕ} (p : S[X]) (hp : p.degree < D) :
    mkR D (fun l => p.coeff l) = p := by
  ext k
  rw [mkR, finsetSum_coeff]
  simp only [coeff_C_mul_X_pow]
  by_cases hk : k < D
  · rw [Finset.sum_eq_single ⟨k, hk⟩ (fun l _ hl => if_neg fun h => hl (Fin.ext h.symm))
      (fun h => absurd (Finset.mem_univ _) h), if_pos rfl]
  · rw [Finset.sum_eq_zero fun l _ => if_neg fun h => hk (by rw [h]; exact l.isLt),
      coeff_eq_zero_of_degree_lt (hp.trans_le (by exact_mod_cast not_lt.mp hk))]

variable {K : Type*} [Field K]

variable (K) in
/-- `K[x₀, …, x_n] ≅ K[x'][X]` as a ring hom. -/
abbrev theta1 (n : ℕ) : MvPolynomial (Fin (n + 1)) K →+* Polynomial (MvPolynomial (Fin n) K) :=
  (MvPolynomial.finSuccEquiv K n).toRingEquiv.toRingHom

/-- The coefficient map into `K[[x']][X]` agrees with `finSuccEquiv` on power series. -/
theorem coe_thetaS {n : ℕ} (q : MvPolynomial (Fin (n + 1)) K) :
    ((thetaS (theta1 K n) (MvPowerSeries (Fin n) K) q : Polynomial (MvPowerSeries (Fin n) K)) :
        PowerSeries (MvPowerSeries (Fin n) K)) =
      MvPowerSeries.finSuccEquiv K n (q : MvPowerSeries (Fin (n + 1)) K) := by
  induction q using MvPolynomial.induction_on with
  | C a =>
    simp [thetaS, theta1, MvPolynomial.finSuccEquiv_apply, algebraMap_mvPolynomial_eq,
      MvPowerSeries.finSuccEquiv_C]
  | add p q hp hq => simp only [map_add, Polynomial.coe_add, MvPolynomial.coe_add, hp, hq]
  | mul_X p i hp =>
    simp only [map_mul, Polynomial.coe_mul, MvPolynomial.coe_mul, hp]
    congr 1
    induction i using Fin.cases with
    | zero =>
      simp [thetaS, theta1, MvPolynomial.finSuccEquiv_X_zero, MvPowerSeries.finSuccEquiv_X_zero]
    | succ j =>
      simp [thetaS, theta1, MvPolynomial.finSuccEquiv_X_succ, MvPowerSeries.finSuccEquiv_X_succ,
        algebraMap_mvPolynomial_eq]

/-- Nested evaluation is compatible with `finSuccEquiv`. -/
theorem finSuccEquiv_symm_evS {n N : ℕ} (p : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K))
    (R : Fin N → Polynomial (MvPowerSeries (Fin n) K)) :
    (MvPowerSeries.finSuccEquiv K n).symm (evS (theta1 K n) (MvPowerSeries (Fin n) K) p R : PowerSeries _) =
      MvPolynomial.aeval (fun i => (MvPowerSeries.finSuccEquiv K n).symm (R i : PowerSeries _)) p := by
  let φ : Polynomial (MvPowerSeries (Fin n) K) →+* MvPowerSeries (Fin (n + 1)) K :=
    (MvPowerSeries.finSuccEquiv K n).symm.toRingEquiv.toRingHom.comp Polynomial.coeToPowerSeries.ringHom
  have hφ : ∀ F : Polynomial (MvPowerSeries (Fin n) K),
      (MvPowerSeries.finSuccEquiv K n).symm (F : PowerSeries _) = φ F := fun _ => rfl
  simp only [hφ]
  rw [evS, MvPolynomial.eval₂_comp_left, MvPolynomial.aeval_def]
  congr 1
  refine RingHom.ext fun q => ?_
  rw [RingHom.comp_apply, ← hφ, coe_thetaS, AlgEquiv.symm_apply_apply, algebraMap_mvPolynomial_eq]

/-- An element of the maximal ideal of `K[[x']]` has constant term `0`. -/
theorem constantCoeff_eq_zero_of_mem {n : ℕ} {a : MvPowerSeries (Fin n) K}
    (ha : a ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K)) : MvPowerSeries.constantCoeff a = 0 := by
  by_contra h
  exact (IsLocalRing.mem_maximalIdeal _).mp ha (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h))

/-- Constant terms through `finSuccEquiv`. -/
theorem cc_cc_finSuccEquiv {n : ℕ} (g : MvPowerSeries (Fin (n + 1)) K) :
    MvPowerSeries.constantCoeff (PowerSeries.constantCoeff (MvPowerSeries.finSuccEquiv K n g)) =
      MvPowerSeries.constantCoeff g := by
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
    MvPowerSeries.coeff_coeff_finSuccEquiv, Finsupp.cons_zero_zero, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA6b

/-! ### piece CovA2 -/
section Piece_CovA2


/-!
# S4-EtPBC-A, R4-T2 (A'): the corrected algebraic lifting statement `CoverLiftAt₂`

`CoverLiftAt` (CovA) allows fibre charts `β₀ : B₀ ↠ F₀` whose kernel is bigger than `(ker χ) B₀`, and is then false
(`A = K`, `B₀ = B₁ = K[X]`, `F₀ = K` via `X ↦ 1`, `E₀ = K`: the lift would make `K` etale over `K[X]`).
**`CoverLiftAt₂ K A χ`** adds the hypotheses `ker βᵢ = (ker χ) Bᵢ` (and the same on the overlap), so that the fibre
charts are the fibres `K ⊗_A Bᵢ`. The conclusion is the same structure `CoverLift`.
-/

set_option autoImplicit false

open Polynomial TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]

/-- **The algebraic form of T2** at the `K`-point `χ` of `A`, with fibre charts `Fᵢ = Bᵢ ⧸ (ker χ) Bᵢ`
(`CoverLiftAt` without the kernel hypotheses is false). -/
def CoverLiftAt₂ (χ : A →ₐ[K] K) : Prop :=
  ∀ (B₀ B₁ N : Type u) [CommRing B₀] [Algebra A[X] B₀] [Algebra A B₀] [IsScalarTower A A[X] B₀]
    [CommRing B₁] [Algebra A[X] B₁] [Algebra A B₁] [IsScalarTower A A[X] B₁]
    [CommRing N] [Algebra A[X] N] [Algebra A N] [IsScalarTower A A[X] N]
    [Module.Finite A[X] B₀] [Module.Finite A[X] B₁] (φ₀ : B₀ →ₐ[A[X]] N) (φ₁ : B₁ →ₐ[A] N),
    algebraMap A[X] N X * φ₁ (algebraMap A[X] B₁ X) = 1 →
    (∀ y : N, ∃ (k : ℕ) (a : B₀), algebraMap A[X] N X ^ k * y = φ₀ a) →
    (∀ y : N, ∃ (k : ℕ) (b : B₁), φ₁ (algebraMap A[X] B₁ X) ^ k * y = φ₁ b) →
    (∀ a, φ₀ a = 0 → ∃ k : ℕ, algebraMap A[X] B₀ X ^ k * a = 0) →
    (∀ b, φ₁ b = 0 → ∃ k : ℕ, algebraMap A[X] B₁ X ^ k * b = 0) →
    -- the fibre charts
    ∀ (F₀ F₁ F₀₁ : Type u) [CommRing F₀] [CommRing F₁] [CommRing F₀₁] [Algebra K F₀] [Algebra K F₁] [Algebra K F₀₁]
      (β₀ : B₀ →+* F₀) (β₁ : B₁ →+* F₁) (β₀₁ : N →+* F₀₁),
      (∀ a : A, β₀ (algebraMap A B₀ a) = algebraMap K F₀ (χ a)) →
      (∀ a : A, β₁ (algebraMap A B₁ a) = algebraMap K F₁ (χ a)) →
      (∀ a : A, β₀₁ (algebraMap A N a) = algebraMap K F₀₁ (χ a)) →
      Function.Surjective β₀ → Function.Surjective β₁ → Function.Surjective β₀₁ →
      RingHom.ker β₀ = (RingHom.ker χ).map (algebraMap A B₀) →
      RingHom.ker β₁ = (RingHom.ker χ).map (algebraMap A B₁) →
      RingHom.ker β₀₁ = (RingHom.ker χ).map (algebraMap A N) →
      ∀ (φb₀ : F₀ →+* F₀₁) (φb₁ : F₁ →+* F₀₁), φb₀.comp β₀ = β₀₁.comp φ₀.toRingHom →
        φb₁.comp β₁ = β₀₁.comp φ₁.toRingHom →
      -- the fibre cover
      ∀ (E₀ E₁ E₀₁ : Type u) [CommRing E₀] [CommRing E₁] [CommRing E₀₁] [Algebra F₀ E₀] [Algebra F₁ E₁]
        [Algebra F₀₁ E₀₁], Algebra.Etale F₀ E₀ → Algebra.Etale F₁ E₁ → Module.Finite F₀ E₀ → Module.Finite F₁ E₁ →
        ∀ (ψ₀ : E₀ →+* E₀₁) (ψ₁ : E₁ →+* E₀₁),
          ψ₀.comp (algebraMap F₀ E₀) = (algebraMap F₀₁ E₀₁).comp φb₀ →
          ψ₁.comp (algebraMap F₁ E₁) = (algebraMap F₀₁ E₀₁).comp φb₁ →
          IsAwayMap ψ₀ (algebraMap F₀ E₀ (β₀ (algebraMap A[X] B₀ X))) →
          IsAwayMap ψ₁ (algebraMap F₁ E₁ (β₁ (algebraMap A[X] B₁ X))) →
      -- the lift
      Nonempty (CoverLift K A χ B₀ B₁ N φ₀ φ₁ F₀ F₁ F₀₁ β₀ β₁ β₀₁ E₀ E₁ E₀₁ ψ₀ ψ₁)

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovA2

/-! ### piece ArA5d3 -/
section Piece_ArA5d3


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5d3: after `τ̂_c` a nonzero series is `x₀`-regular

`piSub n` sets `x₀ ↦ t` and `x_{i+1} ↦ 0`; its coefficients are the `x₀`-axis coefficients (`coeff_subst_pi`), and
`π ∘ τ̂_c` is the monomial curve `x_i ↦ t^{c^i}` (`subst_pi_tau`). Hence a nonzero `s` has a nonzero `x₀`-axis
coefficient after `τ̂_c` for some `c ≥ 2` (`exists_tau_regular`), so its image in `K[[x']][[x₀]]` is nonzero mod the
maximal ideal (`map_residue_ne_zero`) and has a Weierstrass factorization (`exists_weierstrass_tau`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

variable {K : Type*} [Field K]

/-- `x₀ ↦ t`, `x_{i+1} ↦ 0`. -/
abbrev piSub (n : ℕ) : Fin (n + 1) → MvPowerSeries Unit K :=
  Fin.cases (PowerSeries.X : PowerSeries K) fun _ => 0

theorem hasSubst_pi (n : ℕ) : MvPowerSeries.HasSubst (piSub (K := K) n) :=
  MvPowerSeries.hasSubst_of_constantCoeff_zero fun i => by
    induction i using Fin.cases with
    | zero => exact MvPowerSeries.constantCoeff_X ()
    | succ j => exact map_zero _

theorem prod_pi {n : ℕ} (d : Fin (n + 1) →₀ ℕ) :
    (d.prod fun s e => (piSub (K := K) n s) ^ e) =
      if Finsupp.tail d = 0 then (PowerSeries.X : PowerSeries K) ^ (d 0) else 0 := by
  rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _), Fin.prod_univ_succ]
  split_ifs with h
  · rw [Finset.prod_eq_one fun i _ => ?_, mul_one]
    · rfl
    · have : d i.succ = 0 := by rw [← Finsupp.tail_apply, h, Finsupp.coe_zero, Pi.zero_apply]
      rw [this, pow_zero]
  · obtain ⟨i, hi⟩ : ∃ i : Fin n, d i.succ ≠ 0 := by
      by_contra hc
      push Not at hc
      exact h (Finsupp.ext fun i => by rw [Finsupp.tail_apply, hc i, Finsupp.coe_zero, Pi.zero_apply])
    rw [Finset.prod_eq_zero (Finset.mem_univ i) (by simp [piSub, zero_pow hi]), mul_zero]

/-- The `x₀`-axis coefficients. -/
theorem coeff_subst_pi {n : ℕ} (g : MvPowerSeries (Fin (n + 1)) K) (k : ℕ) :
    PowerSeries.coeff k (MvPowerSeries.subst (piSub (K := K) n) g) =
      MvPowerSeries.coeff (Finsupp.single 0 k) g := by
  change MvPowerSeries.coeff (Finsupp.single () k) (MvPowerSeries.subst (piSub n) g) = _
  rw [MvPowerSeries.coeff_subst (hasSubst_pi n)]
  simp_rw [prod_pi]
  rw [finsum_eq_single _ (Finsupp.single 0 k)]
  · have ht : Finsupp.tail (Finsupp.single (0 : Fin (n + 1)) k) = 0 := by
      ext i
      rw [Finsupp.tail_apply, Finsupp.single_eq_of_ne (Fin.succ_ne_zero i), Finsupp.coe_zero, Pi.zero_apply]
    rw [if_pos ht, Finsupp.single_eq_same, mv_coeff_X_pow, if_pos rfl, smul_eq_mul, mul_one]
  · intro d hd
    split_ifs with h
    · rw [mv_coeff_X_pow, if_neg, smul_zero]
      intro hk
      apply hd
      rw [← Finsupp.cons_tail d, Finsupp.cons_eq_single_zero_iff]
      exact ⟨h, hk.symm⟩
    · rw [map_zero, smul_zero]

theorem tauSub_zero (c n : ℕ) : tauSub (K := K) c n 0 = MvPowerSeries.X 0 := MvPolynomial.coe_X 0

theorem tauSub_succ (c n : ℕ) (j : Fin n) :
    tauSub (K := K) c n j.succ = MvPowerSeries.X j.succ + MvPowerSeries.X 0 ^ (c ^ ((j : ℕ) + 1)) := by
  simp only [tauSub, tauPoly_succ, MvPolynomial.coe_add, MvPolynomial.coe_pow,
    MvPolynomial.coe_X, map_one, one_mul]

/-- `π ∘ τ̂_c` is the monomial curve `x_i ↦ t^{c^i}`. -/
theorem subst_pi_tau {c : ℕ} (hc : 1 ≤ c) {n : ℕ} (s : MvPowerSeries (Fin (n + 1)) K) :
    MvPowerSeries.subst (piSub (K := K) n) (MvPowerSeries.subst (tauSub (K := K) c n) s) =
      MvPowerSeries.subst (rhoSub (K := K) c (n + 1)) s := by
  rw [MvPowerSeries.subst_comp_subst_apply (hasSubst_tau (K := K) hc n) (hasSubst_pi n)]
  refine congrArg (fun a => MvPowerSeries.subst (R := K) a s) (funext fun i => ?_)
  induction i using Fin.cases with
  | zero =>
    rw [tauSub_zero, MvPowerSeries.subst_X (hasSubst_pi n)]
    simp only [piSub, rhoSub, Fin.cases_zero, Fin.val_zero, pow_zero, pow_one]
  | succ j =>
    rw [tauSub_succ, ← MvPowerSeries.coe_substAlgHom (hasSubst_pi n), map_add, map_pow,
      MvPowerSeries.substAlgHom_X, MvPowerSeries.substAlgHom_X]
    simp only [piSub, rhoSub, Fin.cases_zero, Fin.cases_succ, Fin.val_succ, zero_add]

/-- **After `τ̂_c` a nonzero series is `x₀`-regular**, for some `c ≥ 2`. -/
theorem exists_tau_regular {n : ℕ} (s : MvPowerSeries (Fin (n + 1)) K) (hs : s ≠ 0) :
    ∃ c, 2 ≤ c ∧ ∃ k, MvPowerSeries.coeff (Finsupp.single 0 k) (MvPowerSeries.subst (tauSub (K := K) c n) s) ≠ 0 := by
  obtain ⟨c, hc, d₀, -, h⟩ := exists_rho_ne_zero s hs
  refine ⟨c, hc, wt c d₀, ?_⟩
  rw [← coeff_subst_pi, subst_pi_tau (by omega)]
  exact h

/-- An `x₀`-regular series is nonzero modulo the maximal ideal of `K[[x']]`. -/
theorem map_residue_ne_zero {n : ℕ} (g : MvPowerSeries (Fin (n + 1)) K) (k : ℕ)
    (hk : MvPowerSeries.coeff (Finsupp.single 0 k) g ≠ 0) :
    (MvPowerSeries.finSuccEquiv K n g).map (IsLocalRing.residue (MvPowerSeries (Fin n) K)) ≠ 0 := by
  intro h0
  apply hk
  have h1 := congrArg (PowerSeries.coeff k) h0
  rw [PowerSeries.coeff_map, map_zero, IsLocalRing.residue_eq_zero_iff] at h1
  have h2 : MvPowerSeries.constantCoeff (PowerSeries.coeff k (MvPowerSeries.finSuccEquiv K n g)) = 0 := by
    by_contra h3
    exact (IsLocalRing.mem_maximalIdeal _).mp h1
      (MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr h3))
  rw [← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPowerSeries.coeff_coeff_finSuccEquiv,
    Finsupp.cons_zero_eq_single_zero] at h2
  exact h2

/-- **Weierstrass preparation after the coordinate change.** -/
theorem exists_weierstrass_tau {n : ℕ} (s : MvPowerSeries (Fin (n + 1)) K) (hs : s ≠ 0) :
    ∃ c, 2 ≤ c ∧ ∃ (P : Polynomial (MvPowerSeries (Fin n) K)) (U : PowerSeries (MvPowerSeries (Fin n) K)),
      (MvPowerSeries.finSuccEquiv K n (MvPowerSeries.subst (tauSub (K := K) c n) s)).IsWeierstrassFactorization P U := by
  obtain ⟨c, hc, k, hk⟩ := exists_tau_regular s hs
  obtain ⟨P, U, H⟩ := PowerSeries.exists_isWeierstrassFactorization (map_residue_ne_zero _ k hk)
  exact ⟨c, hc, P, U, H⟩

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5d3

/-! ### piece CovApx -/
section Piece_CovApx


/-!
# S4-EtPBC-A, R4-T2 (A3/A4 interface): Artin approximation at a `K`-point

**`ArtinApproxAt K A χ`** (the output of A4): every solution in `Â = AdicCompletion (ker χ) A` of a finite polynomial
system over `A` gives a solution in an etale neighbourhood `(R', χ')` of `χ` with the same residues
(congruence mod `ker χ`; congruence mod `(ker χ)^c` follows by substituting `y = a + Σ π^α z`).
Targets (drafted as stubs in `units/S4-EtPBC-A/CovApx_v1.lean`): `coverLiftAt₂_of_approx` (A3) and `artinApproxAt` (A4).
-/

set_option autoImplicit false

open Polynomial TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]

/-- **Artin approximation at the `K`-point `χ`**: a solution in `Â` of a finite polynomial system over `A` gives a
solution in an etale neighbourhood `(R', χ')` of `χ` with the same residues. -/
def ArtinApproxAt (χ : A →ₐ[K] K) : Prop :=
  ∀ (n m : ℕ) (f : Fin m → MvPolynomial (Fin n) A) (ŷ : Fin n → AdicCompletion (RingHom.ker χ) A),
    (∀ j, MvPolynomial.aeval ŷ (f j) = 0) →
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra A R') (_ : Algebra.Etale A R') (χ' : R' →+* K)
      (y : Fin n → R'), (∀ a : A, χ' (algebraMap A R' a) = χ a) ∧ (∀ j, MvPolynomial.aeval y (f j) = 0) ∧
      ∀ i, ∃ a : A, χ' (y i) = χ a ∧ AdicCompletion.evalₐ (RingHom.ker χ) 1 (ŷ i) = Ideal.Quotient.mk _ a

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovApx

/-! ### piece CovPr1 -/
section Piece_CovPr1


/-!
# S4-EtPBC-A, R4-T2 (A3a): Artin approximation for finitely generated algebras over `Â`

**`resHat K A χ : Â →+* K`** is the residue map of `Â = AdicCompletion (ker χ) A` at `χ`.
**`approxAlg`**: from `ArtinApproxAt K A χ` (`A` noetherian), every `A`-algebra map `σ̂ : C → Â` from a finite type
`A`-algebra `C` is, residually, an `A`-algebra map `σ : C → R'` to an etale neighbourhood `(R', χ')` of `χ`:
`χ' ∘ σ = resHat ∘ σ̂`. This is the form used by the descent of the completed cover (A3).
-/

set_option autoImplicit false

open Polynomial TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable (K : Type u) [Field K] (A : Type u) [CommRing A] [Algebra K A]

/-- The residue map `Â → K` of the completion at the `K`-point `χ`. -/
def resHat (χ : A →ₐ[K] K) : AdicCompletion (RingHom.ker χ) A →+* K :=
  (Ideal.Quotient.lift (RingHom.ker χ) (χ : A →+* K) (fun _ h => RingHom.mem_ker.mp h)).comp
    (AdicCompletion.evalOneₐ (RingHom.ker χ)).toRingHom

theorem resHat_algebraMap (χ : A →ₐ[K] K) (a : A) :
    resHat K A χ (algebraMap A (AdicCompletion (RingHom.ker χ) A) a) = χ a := by
  have e : AdicCompletion.evalOneₐ (RingHom.ker χ) (algebraMap A (AdicCompletion (RingHom.ker χ) A) a) =
      Ideal.Quotient.mk _ a :=
    DFunLike.congr_fun (AdicCompletion.evalOneₐ_comp_algebraMap_eq_mk (RingHom.ker χ)) a
  show Ideal.Quotient.lift (RingHom.ker χ) (χ : A →+* K) (fun _ h => RingHom.mem_ker.mp h)
      (AdicCompletion.evalOneₐ (RingHom.ker χ) (algebraMap A (AdicCompletion (RingHom.ker χ) A) a)) = _
  rw [e, Ideal.Quotient.lift_mk]
  try rfl

theorem resHat_of_eval (χ : A →ₐ[K] K) (x : AdicCompletion (RingHom.ker χ) A) (a : A)
    (h : AdicCompletion.evalₐ (RingHom.ker χ) 1 x = Ideal.Quotient.mk _ a) : resHat K A χ x = χ a := by
  show Ideal.Quotient.lift (RingHom.ker χ) (χ : A →+* K) (fun _ h => RingHom.mem_ker.mp h)
      (AdicCompletion.evalOneₐ (RingHom.ker χ) x) = _
  rw [← AdicCompletion.factorₐ_evalₐ_one, h, Ideal.Quotient.factor_mk, Ideal.Quotient.lift_mk]
  try rfl

/-- **Artin approximation for finitely generated algebras**: an `A`-algebra map `C → Â` from a finite type
`A`-algebra is residually an `A`-algebra map `C → R'` to an etale neighbourhood of `χ`. -/
theorem approxAlg [IsNoetherianRing A] (χ : A →ₐ[K] K) (hA : ArtinApproxAt K A χ)
    (C : Type u) [CommRing C] [Algebra A C] [Algebra.FiniteType A C]
    (σh : C →ₐ[A] AdicCompletion (RingHom.ker χ) A) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra A R') (_ : Algebra.Etale A R') (χ' : R' →+* K)
      (σ : C →ₐ[A] R'), (∀ a : A, χ' (algebraMap A R' a) = χ a) ∧
        ∀ c, χ' (σ c) = resHat K A χ (σh c) := by
  obtain ⟨n, π, hπ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp ‹Algebra.FiniteType A C›
  have hfg : (RingHom.ker π).FG := IsNoetherian.noetherian _
  obtain ⟨m, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  have hfk : ∀ j, f j ∈ RingHom.ker π := fun j => by rw [← hf]; exact Submodule.subset_span ⟨j, rfl⟩
  have hev : MvPolynomial.aeval (fun i => σh (π (MvPolynomial.X i))) = σh.comp π :=
    MvPolynomial.algHom_ext (fun i => by simp)
  have hŷ : ∀ j, MvPolynomial.aeval (fun i => σh (π (MvPolynomial.X i))) (f j) = 0 := by
    intro j
    rw [hev, AlgHom.comp_apply, RingHom.mem_ker.mp (hfk j), map_zero]
  obtain ⟨R', _, _, _, χ', y, hχ, hy, hres⟩ := hA n m f _ hŷ
  have hle : ∀ p ∈ RingHom.ker π, MvPolynomial.aeval y p = 0 := by
    intro p hp
    have h2 : RingHom.ker π ≤ RingHom.ker (MvPolynomial.aeval (R := A) y) := by
      rw [← hf]
      exact Submodule.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact RingHom.mem_ker.mpr (hy j))
    exact RingHom.mem_ker.mp (h2 hp)
  let σ : C →ₐ[A] R' := (Ideal.Quotient.liftₐ (RingHom.ker π) (MvPolynomial.aeval y) hle).comp
    (Ideal.quotientKerAlgEquivOfSurjective hπ).symm.toAlgHom
  have hσ : ∀ p, σ (π p) = MvPolynomial.aeval y p := by
    intro p
    have e : (Ideal.quotientKerAlgEquivOfSurjective hπ).symm (π p) = Ideal.Quotient.mk _ p :=
      (AlgEquiv.symm_apply_eq _).mpr (Ideal.quotientKerAlgEquivOfSurjective_mk hπ p).symm
    exact (congrArg (Ideal.Quotient.liftₐ (RingHom.ker π) (MvPolynomial.aeval y) hle) e).trans rfl
  have key : χ'.comp (MvPolynomial.aeval (R := A) y).toRingHom =
      (resHat K A χ).comp ((σh.comp π : MvPolynomial (Fin n) A →ₐ[A] _) : MvPolynomial (Fin n) A →+* _) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      have e1 : π (MvPolynomial.C a) = algebraMap A C a := by
        rw [← MvPolynomial.algebraMap_eq]; exact π.commutes a
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C,
        AlgHom.comp_apply, e1, AlgHom.commutes, hχ, resHat_algebraMap]
    · intro i
      obtain ⟨a, h1, h2⟩ := hres i
      simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X,
        AlgHom.comp_apply]
      exact h1.trans (resHat_of_eval K A χ _ a h2).symm
  refine ⟨R', inferInstance, inferInstance, inferInstance, χ', σ, hχ, fun c => ?_⟩
  obtain ⟨p, rfl⟩ := hπ c
  rw [hσ]
  exact DFunLike.congr_fun key p

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr1

/-! ### piece CovPr2 -/
section Piece_CovPr2


/-!
# S4-EtPBC-A, R4-T2 (A3b): square presented algebras with witnesses are finite etale

**`Pres g = P[Z₁..Z_r] ⧸ (g₁..g_r)`**, **`jdet g`** its Jacobian determinant. `pres_etale`: a witness
`jdet g * w - 1 ∈ (g)` makes `Pres g` etale over `P` (naive submersive presentation, relative dimension `0`);
`pres_finite`: monic witnesses `q_j(Z_j) ∈ (g)` make it finite. Both hypotheses are memberships in `(g)`, so they are
preserved by any base change `P → P'` (A3: descend from `Â ⊗ Bᵢ` to `C ⊗ Bᵢ`, push to `R' ⊗ Bᵢ`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

/-- The presented algebra `P[Z₁..Z_r] ⧸ (g₁..g_r)`. -/
abbrev Pres {P : Type u} [CommRing P] {r : ℕ} (g : Fin r → MvPolynomial (Fin r) P) : Type u :=
  MvPolynomial (Fin r) P ⧸ Ideal.span (Set.range g)

/-- The Jacobian determinant `det (∂ g_j / ∂ Z_i)` of a square system. -/
def jdet {P : Type u} [CommRing P] {r : ℕ} (g : Fin r → MvPolynomial (Fin r) P) : MvPolynomial (Fin r) P :=
  (Matrix.of fun i j => MvPolynomial.pderiv i (g j)).det

theorem pres_etale {P : Type u} [CommRing P] {r : ℕ} (g : Fin r → MvPolynomial (Fin r) P)
    (hJ : ∃ w, jdet g * w - 1 ∈ Ideal.span (Set.range g)) : Algebra.Etale P (Pres g) := by
  obtain ⟨w, hw⟩ := hJ
  let Q := Algebra.PreSubmersivePresentation.naive (R := P) (v := g) id Function.injective_id
  have hmk : ∀ x, algebraMap Q.Ring (Pres g) x = Ideal.Quotient.mk _ x := by
    intro x
    rw [Algebra.Generators.algebraMap_apply]
    have e : MvPolynomial.aeval (R := P) (fun i => Ideal.Quotient.mk (Ideal.span (Set.range g))
        (MvPolynomial.X i)) = Ideal.Quotient.mkₐ P (Ideal.span (Set.range g)) :=
      MvPolynomial.algHom_ext (fun i => by simp)
    exact DFunLike.congr_fun e x
  have hM : Q.jacobiMatrix = Matrix.of fun i j => MvPolynomial.pderiv i (g j) := by
    ext i j
    rw [Q.jacobiMatrix_apply]
    rfl
  have hU : IsUnit Q.jacobian := by
    rw [Q.jacobian_eq_jacobiMatrix_det, hM, hmk]
    have h1 : Ideal.Quotient.mk (Ideal.span (Set.range g)) (jdet g) * Ideal.Quotient.mk _ w = 1 := by
      rw [← map_mul, ← map_one (Ideal.Quotient.mk (Ideal.span (Set.range g))), Ideal.Quotient.eq]
      exact hw
    exact ⟨⟨_, _, h1, by rw [mul_comm]; exact h1⟩, rfl⟩
  let Q' : Algebra.SubmersivePresentation P (Pres g) (Fin r) (Fin r) := { Q with jacobian_isUnit := hU }
  have hd : Q'.dimension = 0 := by simp [Algebra.Presentation.dimension]
  have := Q'.isStandardSmoothOfRelativeDimension hd
  infer_instance

theorem pres_finite {P : Type u} [CommRing P] {r : ℕ} (g : Fin r → MvPolynomial (Fin r) P)
    (hF : ∀ j, ∃ q : Polynomial P, q.Monic ∧ Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range g)) :
    Module.Finite P (Pres g) := by
  have hint : ∀ x ∈ Set.range (fun j => Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X j)),
      IsIntegral P x := by
    rintro _ ⟨j, rfl⟩
    obtain ⟨q, hq, hev⟩ := hF j
    refine ⟨q, hq, ?_⟩
    rw [← Polynomial.aeval_def, ← Ideal.Quotient.mkₐ_eq_mk P, Polynomial.aeval_algHom_apply,
      Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact hev
  have hfg := fg_adjoin_of_finite (Set.finite_range _) hint
  have htop : Algebra.adjoin P (Set.range (fun j => Ideal.Quotient.mk (Ideal.span (Set.range g))
      (MvPolynomial.X j))) = ⊤ := by
    have e : Set.range (fun j => Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.X j)) =
        (Ideal.Quotient.mkₐ P (Ideal.span (Set.range g))) '' Set.range MvPolynomial.X := by
      rw [← Set.range_comp]; rfl
    rw [e, Algebra.adjoin_image, MvPolynomial.adjoin_range_X, Algebra.map_top]
    refine eq_top_iff.mpr (fun x _ => ?_)
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
    exact (Ideal.Quotient.mkₐ P (Ideal.span (Set.range g))).mem_range_self p
  rw [htop] at hfg
  exact ⟨by simpa using hfg⟩

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr2

/-! ### piece CovPr3 -/
section Piece_CovPr3


/-!
# S4-EtPBC-A, R4-T2 (A3c): base change of square presentations

For a ring hom `f : P →+* P'` and a square system `g`, **`gmap f g`** is the system with coefficients pushed along
`f`, **`presMap f g : Pres g →+* Pres (gmap f g)`** the induced map. Memberships in `(g)` transport (`span_map_mem`),
`jdet (gmap f g) = map f (jdet g)` (`jdet_map`), so the etale and finite witnesses of `pres_etale` / `pres_finite`
transport (`hJ_map`, `hF_map`), giving `pres_etale_map` / `pres_finite_map`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {P P' : Type u} [CommRing P] [CommRing P'] {r : ℕ}

/-- The square system with coefficients pushed along `f`. -/
abbrev gmap (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) : Fin r → MvPolynomial (Fin r) P' :=
  fun j => MvPolynomial.map f (g j)

theorem span_map_mem (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) {x : MvPolynomial (Fin r) P}
    (hx : x ∈ Ideal.span (Set.range g)) :
    MvPolynomial.map f x ∈ Ideal.span (Set.range (gmap f g)) := by
  have h := Ideal.mem_map_of_mem (MvPolynomial.map f) hx
  rw [Ideal.map_span, ← Set.range_comp] at h
  exact h

/-- The map `Pres g → Pres (gmap f g)` induced by `f` on coefficients. -/
def presMap (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) : Pres g →+* Pres (gmap f g) :=
  Ideal.quotientMap _ (MvPolynomial.map f) (fun _ hx => span_map_mem f g hx)

theorem presMap_mk (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) (x : MvPolynomial (Fin r) P) :
    presMap f g (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (MvPolynomial.map f x) :=
  Ideal.quotientMap_mk

theorem presMap_algebraMap (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) (a : P) :
    presMap f g (algebraMap P (Pres g) a) = algebraMap P' (Pres (gmap f g)) (f a) := by
  first
  | (show presMap f g (Ideal.Quotient.mk _ (MvPolynomial.C a)) = Ideal.Quotient.mk _ (MvPolynomial.C (f a))
     rw [presMap_mk, MvPolynomial.map_C])
  | (rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, RingHom.comp_apply,
      presMap_mk, MvPolynomial.algebraMap_eq, MvPolynomial.algebraMap_eq, MvPolynomial.map_C])

theorem presMap_X (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) (j : Fin r) :
    presMap f g (Ideal.Quotient.mk _ (MvPolynomial.X j)) = Ideal.Quotient.mk _ (MvPolynomial.X j) := by
  rw [presMap_mk, MvPolynomial.map_X]

theorem jdet_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P) :
    jdet (gmap f g) = MvPolynomial.map f (jdet g) := by
  unfold jdet
  rw [RingHom.map_det]
  congr 1
  ext i j
  simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, gmap, MvPolynomial.pderiv_map]

theorem hJ_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (hJ : ∃ w, jdet g * w - 1 ∈ Ideal.span (Set.range g)) :
    ∃ w, jdet (gmap f g) * w - 1 ∈ Ideal.span (Set.range (gmap f g)) := by
  obtain ⟨w, hw⟩ := hJ
  refine ⟨MvPolynomial.map f w, ?_⟩
  have h := span_map_mem f g hw
  rwa [map_sub, map_mul, map_one, ← jdet_map] at h

theorem aeval_X_map (f : P →+* P') (q : Polynomial P) (j : Fin r) :
    Polynomial.aeval (MvPolynomial.X j : MvPolynomial (Fin r) P') (q.map f) =
      MvPolynomial.map f (Polynomial.aeval (MvPolynomial.X j : MvPolynomial (Fin r) P) q) := by
  rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map, Polynomial.hom_eval₂, MvPolynomial.map_X]
  congr 1
  refine RingHom.ext fun a => ?_
  simp only [RingHom.comp_apply, MvPolynomial.algebraMap_eq, MvPolynomial.map_C]

theorem hF_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (hF : ∀ j, ∃ q : Polynomial P, q.Monic ∧ Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range g)) :
    ∀ j, ∃ q : Polynomial P', q.Monic ∧
      Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range (gmap f g)) := by
  intro j
  obtain ⟨q, hq, hev⟩ := hF j
  refine ⟨q.map f, hq.map f, ?_⟩
  rw [aeval_X_map]
  exact span_map_mem f g hev

theorem pres_etale_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (hJ : ∃ w, jdet g * w - 1 ∈ Ideal.span (Set.range g)) : Algebra.Etale P' (Pres (gmap f g)) :=
  pres_etale (gmap f g) (hJ_map f g hJ)

theorem pres_finite_map (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (hF : ∀ j, ∃ q : Polynomial P, q.Monic ∧ Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range g)) :
    Module.Finite P' (Pres (gmap f g)) :=
  pres_finite (gmap f g) (hF_map f g hF)

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr3

/-! ### piece CovPr8 -/
section Piece_CovPr8


/-!
# S4-EtPBC-A, R4-T2 (A3h): square presentations of etale algebras, reindexed to `Fin r`

* **`exists_square_presentation`**: an etale `P`-algebra has a submersive presentation whose map
  `relations → variables` is bijective (relative dimension `0`).
* **`reRel Q e eσ`**: the relations of a presentation `Q` reindexed along `e : Fin r ≃ ι`, `eσ : Fin r ≃ σ`;
  **`span_reRel`**, **`reRel_finite`** (monic witnesses when `E` is finite over `P`), and
  **`presEquiv Q e eσ : Pres (reRel Q e eσ) ≃ₐ[P] E`** with **`presEquiv_mk_X`**.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {P E : Type u} [CommRing P] [CommRing E] [Algebra P E]

theorem exists_square_presentation [Algebra.Etale P E] :
    ∃ (ι σ : Type) (_ : Finite ι) (_ : Finite σ) (Q : Algebra.SubmersivePresentation P E ι σ),
      Function.Bijective Q.map := by
  have h := (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero (R := P) (S := E)).mp inferInstance
  obtain ⟨ι, σ, hσ, hι, Q, hQ⟩ := h.out
  refine ⟨ι, σ, hι, hσ, Q, Q.map_inj.bijective_of_nat_card_le ?_⟩
  have h1 := Q.card_relations_le_card_vars_of_isFinite
  have h2 : Q.dimension = Nat.card ι - Nat.card σ := rfl
  omega

variable {ι σ : Type}

/-- The relations of `Q`, reindexed to a square system over `Fin r`. -/
def reRel (Q : Algebra.Presentation P E ι σ) {r : ℕ} (e : Fin r ≃ ι) (eσ : Fin r ≃ σ) :
    Fin r → MvPolynomial (Fin r) P :=
  fun k => MvPolynomial.rename e.symm (Q.relation (eσ k))

theorem span_reRel (Q : Algebra.Presentation P E ι σ) {r : ℕ} (e : Fin r ≃ ι) (eσ : Fin r ≃ σ) :
    Ideal.span (Set.range (reRel Q e eσ)) =
      Ideal.map ((MvPolynomial.renameEquiv (R := P) e.symm : MvPolynomial ι P ≃ₐ[P] MvPolynomial (Fin r) P) :
        MvPolynomial ι P →+* MvPolynomial (Fin r) P) (Ideal.span (Set.range Q.relation)) := by
  rw [Ideal.map_span, ← Set.range_comp]
  congr 1
  first
    | exact eσ.surjective.range_comp (_ ∘ Q.relation)
    | exact eσ.surjective.range_comp (fun x => (MvPolynomial.renameEquiv (R := P) e.symm) (Q.relation x))
    | (ext y
       constructor
       · rintro ⟨x, rfl⟩
         exact ⟨eσ x, rfl⟩
       · rintro ⟨x, rfl⟩
         refine ⟨eσ.symm x, ?_⟩
         simp [reRel, MvPolynomial.renameEquiv_apply])

theorem reRel_finite (Q : Algebra.Presentation P E ι σ) [Module.Finite P E] {r : ℕ} (e : Fin r ≃ ι)
    (eσ : Fin r ≃ σ) (j : Fin r) :
    ∃ q : Polynomial P, q.Monic ∧
      Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range (reRel Q e eσ)) := by
  obtain ⟨q, hq, hq0⟩ := Algebra.IsIntegral.isIntegral (R := P) (Q.val (e j))
  refine ⟨q, hq, ?_⟩
  have e1 : MvPolynomial.aeval Q.val
      (Polynomial.aeval (MvPolynomial.X (e j) : MvPolynomial ι P) q) = 0 := by
    rw [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
    first
      | exact hq0
      | (rw [Polynomial.aeval_def]; exact hq0)
  have h1 : Polynomial.aeval (MvPolynomial.X (e j) : MvPolynomial ι P) q ∈
      Ideal.span (Set.range Q.relation) := by
    rw [Q.span_range_relation_eq_ker, Q.ker_eq_ker_aeval_val]
    exact RingHom.mem_ker.mpr e1
  have h2 : MvPolynomial.rename e.symm (Polynomial.aeval (MvPolynomial.X (e j) : MvPolynomial ι P) q) ∈
      Ideal.span (Set.range (reRel Q e eσ)) := by
    rw [span_reRel]
    first
      | exact Ideal.mem_map_of_mem _ h1
      | simpa [MvPolynomial.renameEquiv_apply] using Ideal.mem_map_of_mem
          ((MvPolynomial.renameEquiv (R := P) e.symm : MvPolynomial ι P ≃ₐ[P] MvPolynomial (Fin r) P) :
            MvPolynomial ι P →+* MvPolynomial (Fin r) P) h1
  rwa [← Polynomial.aeval_algHom_apply, MvPolynomial.rename_X, Equiv.symm_apply_apply] at h2

theorem span_relation_eq_ker (Q : Algebra.Presentation P E ι σ) :
    Ideal.span (Set.range Q.relation) = RingHom.ker (MvPolynomial.aeval (R := P) Q.val) :=
  Q.span_range_relation_eq_ker.trans Q.ker_eq_ker_aeval_val

/-- A reindexed square presentation is isomorphic to `E`. -/
def presEquiv (Q : Algebra.Presentation P E ι σ) {r : ℕ} (e : Fin r ≃ ι) (eσ : Fin r ≃ σ) :
    Pres (reRel Q e eσ) ≃ₐ[P] E :=
  ((Ideal.quotientEquivAlg (Ideal.span (Set.range Q.relation)) (Ideal.span (Set.range (reRel Q e eσ)))
      (MvPolynomial.renameEquiv (R := P) e.symm) (span_reRel Q e eσ)).symm.trans
    (Ideal.quotientEquivAlgOfEq (R₁ := P) (span_relation_eq_ker Q))).trans
    (Ideal.quotientKerAlgEquivOfSurjective Q.aeval_val_surjective)

theorem presEquiv_mk_X (Q : Algebra.Presentation P E ι σ) {r : ℕ} (e : Fin r ≃ ι) (eσ : Fin r ≃ σ)
    (k : Fin r) :
    presEquiv Q e eσ (Ideal.Quotient.mk _ (MvPolynomial.X k)) = Q.val (e k) := by
  first
    | (show MvPolynomial.aeval Q.val (MvPolynomial.rename e (MvPolynomial.X k : MvPolynomial (Fin r) P)) = _
       rw [MvPolynomial.rename_X, MvPolynomial.aeval_X])
    | simp [presEquiv, MvPolynomial.renameEquiv_symm]

theorem presEquiv_algebraMap (Q : Algebra.Presentation P E ι σ) {r : ℕ} (e : Fin r ≃ ι) (eσ : Fin r ≃ σ)
    (a : P) : presEquiv Q e eσ (algebraMap P (Pres (reRel Q e eσ)) a) = algebraMap P E a :=
  (presEquiv Q e eσ).commutes a

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr8

/-! ### piece CovPr4 -/
section Piece_CovPr4


/-!
# S4-EtPBC-A, R4-T2 (A3d): localizations lift to square presentations

If `f : P →+* P'` is a localization away from `t` (`IsAwayMap f t`), then so is the induced map on polynomials
(`away_poly_surj`, `away_poly_ker`) and on presented algebras: **`presMap_away`** :
`IsAwayMap (presMap f g) (algebraMap P (Pres g) t)`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {P P' : Type u} [CommRing P] [CommRing P']

theorem away_poly_surj {σ : Type*} (f : P →+* P') (t : P) (hf : IsAwayMap f t) (Y : MvPolynomial σ P') :
    ∃ (k : ℕ) (Z : MvPolynomial σ P), MvPolynomial.C (f t) ^ k * Y = MvPolynomial.map f Z := by
  induction Y using MvPolynomial.induction_on with
  | C c =>
    obtain ⟨k, a, h⟩ := hf.1 c
    refine ⟨k, MvPolynomial.C a, ?_⟩
    rw [MvPolynomial.map_C, ← h, map_mul, map_pow]
  | add p q hp hq =>
    obtain ⟨k₁, Z₁, h₁⟩ := hp
    obtain ⟨k₂, Z₂, h₂⟩ := hq
    refine ⟨k₁ + k₂, MvPolynomial.C t ^ k₂ * Z₁ + MvPolynomial.C t ^ k₁ * Z₂, ?_⟩
    simp only [map_add, map_mul, map_pow, MvPolynomial.map_C]
    rw [← h₁, ← h₂]
    ring
  | mul_X p n hp =>
    obtain ⟨k, Z, h⟩ := hp
    refine ⟨k, Z * MvPolynomial.X n, ?_⟩
    rw [map_mul, MvPolynomial.map_X, ← h]
    ring

theorem away_poly_ker {σ : Type*} (f : P →+* P') (t : P) (hf : IsAwayMap f t) (Z : MvPolynomial σ P)
    (hZ : MvPolynomial.map f Z = 0) : ∃ k : ℕ, MvPolynomial.C t ^ k * Z = 0 := by
  have h : ∀ m, ∃ k : ℕ, t ^ k * MvPolynomial.coeff m Z = 0 := fun m =>
    hf.2 _ (by rw [← MvPolynomial.coeff_map, hZ, MvPolynomial.coeff_zero])
  choose kf hkf using h
  refine ⟨Z.support.sup kf, ?_⟩
  ext m
  rw [← map_pow, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_zero]
  by_cases hm : m ∈ Z.support
  · have hle : kf m ≤ Z.support.sup kf := Finset.le_sup hm
    rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, hkf m, mul_zero]
  · rw [MvPolynomial.notMem_support_iff.mp hm, mul_zero]

variable {r : ℕ}

theorem presMap_away (f : P →+* P') (t : P) (hf : IsAwayMap f t) (g : Fin r → MvPolynomial (Fin r) P) :
    IsAwayMap (presMap f g) (algebraMap P (Pres g) t) := by
  constructor
  · intro y
    obtain ⟨Y, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨k, Z, h⟩ := away_poly_surj f t hf Y
    refine ⟨k, Ideal.Quotient.mk _ Z, ?_⟩
    rw [presMap_algebraMap, presMap_mk, ← h, map_mul, map_pow]
    try rfl
  · intro a ha
    obtain ⟨A, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [presMap_mk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_range_iff_exists_fun] at ha
    obtain ⟨c, hc⟩ := ha
    try simp only [gmap] at hc
    have hl : ∀ j, ∃ (k : ℕ) (Z : MvPolynomial (Fin r) P),
        MvPolynomial.C (f t) ^ k * c j = MvPolynomial.map f Z := fun j => away_poly_surj f t hf (c j)
    choose kc Zc hZc using hl
    obtain ⟨K, hK⟩ : ∃ K : ℕ, ∀ j, kc j ≤ K :=
      ⟨∑ j, kc j, fun j => Finset.single_le_sum (fun i _ => Nat.zero_le (kc i)) (Finset.mem_univ j)⟩
    have hW : MvPolynomial.map f (MvPolynomial.C t ^ K * A -
        ∑ j, MvPolynomial.C t ^ (K - kc j) * Zc j * g j) = 0 := by
      simp only [map_sub, map_mul, map_pow, map_sum, MvPolynomial.map_C]
      rw [← hc, Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_eq_zero fun j _ => ?_
      rw [← hZc j]
      have e : (MvPolynomial.C (f t) : MvPolynomial (Fin r) P') ^ K =
          MvPolynomial.C (f t) ^ (K - kc j) * MvPolynomial.C (f t) ^ kc j := by
        rw [← pow_add, Nat.sub_add_cancel (hK j)]
      rw [e]
      ring
    obtain ⟨m, hm⟩ := away_poly_ker f t hf _ hW
    refine ⟨m + K, ?_⟩
    have e1 : algebraMap P (Pres g) t ^ (m + K) * Ideal.Quotient.mk (Ideal.span (Set.range g)) A =
        Ideal.Quotient.mk (Ideal.span (Set.range g)) (MvPolynomial.C t ^ (m + K) * A) := by
      rw [map_mul, map_pow]
      try rfl
    rw [e1, Ideal.Quotient.eq_zero_iff_mem]
    have e2 : MvPolynomial.C t ^ (m + K) * A =
        ∑ j, (MvPolynomial.C t ^ m * (MvPolynomial.C t ^ (K - kc j) * Zc j)) * g j := by
      rw [mul_sub, sub_eq_zero, Finset.mul_sum] at hm
      rw [pow_add, mul_assoc, hm]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [e2, Ideal.mem_span_range_iff_exists_fun]
    exact ⟨fun j => MvPolynomial.C t ^ m * (MvPolynomial.C t ^ (K - kc j) * Zc j), rfl⟩

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr4

/-! ### piece CovPr9 -/
section Piece_CovPr9


/-!
# S4-EtPBC-A, R4-T2 (A3i): finite etale algebras are square standard etale presentations over `Fin r`

* **`jdet_eq_det`**: for a pre-submersive presentation on `Fin r` with `map = id`, `jdet` of its relations is the
  determinant of its Jacobi matrix.
* **`hJ_of_submersive`**: the Jacobian witness `hJ` (as in `pres_etale`) for such a submersive presentation.
* **`exists_reRel_hJ_hF`** (headline): a finite etale `P`-algebra `E` has a square submersive presentation `Q`,
  reindexed along `e`, `eσ` to `Fin r`, whose relations `reRel Q e eσ` satisfy `hJ` and the monic condition `hF`
  (so `presEquiv Q e eσ : Pres (reRel Q e eσ) ≃ₐ[P] E`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {P E : Type u} [CommRing P] [CommRing E] [Algebra P E]

theorem jdet_eq_det {r : ℕ} (Q : Algebra.PreSubmersivePresentation P E (Fin r) (Fin r))
    (hm : ∀ k, Q.map k = k) : jdet Q.relation = Q.jacobiMatrix.det := by
  unfold jdet
  congr 1
  ext i j
  rw [Matrix.of_apply, Q.jacobiMatrix_apply, hm]

theorem hJ_of_submersive {r : ℕ} (Q : Algebra.SubmersivePresentation P E (Fin r) (Fin r))
    (hm : ∀ k, Q.map k = k) :
    ∃ w, jdet Q.relation * w - 1 ∈ Ideal.span (Set.range Q.relation) := by
  have hu : IsUnit (MvPolynomial.aeval (R := P) Q.val (jdet Q.relation)) := by
    have h := Q.jacobian_isUnit
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det,
      Algebra.Generators.algebraMap_apply, ← jdet_eq_det Q.toPreSubmersivePresentation hm] at h
    exact h
  obtain ⟨v, hv⟩ := hu.exists_right_inv
  obtain ⟨w, rfl⟩ := Q.aeval_val_surjective v
  refine ⟨w, ?_⟩
  rw [span_relation_eq_ker Q.toPresentation, RingHom.mem_ker, map_sub, map_mul, hv, map_one, sub_self]

theorem exists_reRel_hJ_hF [Algebra.Etale P E] [Module.Finite P E] :
    ∃ (ι σ : Type) (_ : Finite ι) (_ : Finite σ) (Q : Algebra.SubmersivePresentation P E ι σ) (r : ℕ)
      (e : Fin r ≃ ι) (eσ : Fin r ≃ σ),
      (∃ w, jdet (reRel Q.toPresentation e eσ) * w - 1 ∈
        Ideal.span (Set.range (reRel Q.toPresentation e eσ))) ∧
      (∀ j, ∃ q : Polynomial P, q.Monic ∧
        Polynomial.aeval (MvPolynomial.X j) q ∈ Ideal.span (Set.range (reRel Q.toPresentation e eσ))) := by
  obtain ⟨ι, σ, hι, hσ, Q, hb⟩ := exists_square_presentation (P := P) (E := E)
  let e : Fin (Nat.card ι) ≃ ι := (Finite.equivFin ι).symm
  let eσ : Fin (Nat.card ι) ≃ σ := e.trans (Equiv.ofBijective Q.map hb).symm
  refine ⟨ι, σ, hι, hσ, Q, Nat.card ι, e, eσ, ?_, reRel_finite Q.toPresentation e eσ⟩
  have hm : ∀ k, (Q.reindex e eσ).map k = k := by
    intro k
    have h1 : e.symm (Q.map ((Equiv.ofBijective Q.map hb).symm (e k))) = k :=
      (congrArg e.symm (Equiv.ofBijective_apply_symm_apply Q.map hb (e k))).trans (e.symm_apply_apply k)
    exact h1
  have hrel : (Q.reindex e eσ).relation = reRel Q.toPresentation e eσ := rfl
  have h := hJ_of_submersive (Q.reindex e eσ) hm
  rw [hrel] at h
  exact h

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr9

/-! ### piece CovPr5 -/
section Piece_CovPr5


/-!
# S4-EtPBC-A, R4-T2 (A3e): isomorphisms of square presentations from substitution data

`presSubst g g' v hv : Pres g →ₐ[P] Pres g'` is induced by the substitution `Z_i ↦ v_i` when it sends every relation of
`g` into `(g')`; two substitutions inverse to each other modulo the relations give **`presIso`** :
`Pres g ≃ₐ[P] Pres g'`. Localizations away from an element are stable under composing with ring isomorphisms on
either side (`isAwayMap_equiv_comp`, `isAwayMap_comp_equiv_pr`), so `presMap_away` survives an iso (`presMap_away_equiv`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Iso

variable {P : Type u} [CommRing P] {r r' : ℕ}

/-- The algebra map of presentations induced by the substitution `Z_i ↦ v_i`. -/
def presSubst (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (v : Fin r → MvPolynomial (Fin r') P)
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g')) : Pres g →ₐ[P] Pres g' :=
  Ideal.quotientMapₐ (Ideal.span (Set.range g')) (MvPolynomial.bind₁ v)
    (Ideal.span_le.mpr (by
      rintro _ ⟨i, rfl⟩
      exact Ideal.mem_comap.mpr (hv i)))

@[simp]
theorem presSubst_mk (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (v : Fin r → MvPolynomial (Fin r') P)
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g')) (x : MvPolynomial (Fin r) P) :
    presSubst g g' v hv (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (MvPolynomial.bind₁ v x) :=
  rfl

theorem presSubst_comp (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (hu : ∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g))
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g'))
    (hvu : ∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g')) :
    (presSubst g g' v hv).comp (presSubst g' g u hu) = AlgHom.id P (Pres g') := by
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  intro j
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, AlgHom.id_apply, presSubst_mk,
    MvPolynomial.bind₁_X_right]
  exact Ideal.Quotient.eq.mpr (hvu j)

/-- **Presentations related by mutually inverse substitutions are isomorphic.** -/
def presIso (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (hu : ∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g))
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g'))
    (huv : ∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g))
    (hvu : ∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g')) :
    Pres g ≃ₐ[P] Pres g' :=
  AlgEquiv.ofAlgHom (presSubst g g' v hv) (presSubst g' g u hu)
    (presSubst_comp g g' u v hu hv hvu) (presSubst_comp g' g v u hv hu huv)

theorem presIso_mk (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (hu : ∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g))
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g'))
    (huv : ∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g))
    (hvu : ∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g'))
    (x : MvPolynomial (Fin r) P) :
    presIso g g' u v hu hv huv hvu (Ideal.Quotient.mk _ x) =
      Ideal.Quotient.mk _ (MvPolynomial.bind₁ v x) :=
  rfl

theorem presIso_symm_mk (g : Fin r → MvPolynomial (Fin r) P) (g' : Fin r' → MvPolynomial (Fin r') P)
    (u : Fin r' → MvPolynomial (Fin r) P) (v : Fin r → MvPolynomial (Fin r') P)
    (hu : ∀ j, MvPolynomial.bind₁ u (g' j) ∈ Ideal.span (Set.range g))
    (hv : ∀ i, MvPolynomial.bind₁ v (g i) ∈ Ideal.span (Set.range g'))
    (huv : ∀ i, MvPolynomial.bind₁ u (v i) - MvPolynomial.X i ∈ Ideal.span (Set.range g))
    (hvu : ∀ j, MvPolynomial.bind₁ v (u j) - MvPolynomial.X j ∈ Ideal.span (Set.range g'))
    (y : MvPolynomial (Fin r') P) :
    (presIso g g' u v hu hv huv hvu).symm (Ideal.Quotient.mk _ y) =
      Ideal.Quotient.mk _ (MvPolynomial.bind₁ u y) :=
  rfl

end Iso

section Away

theorem isAwayMap_equiv_comp {E E' E'' : Type u} [CommRing E] [CommRing E'] [CommRing E'']
    (ψ : E →+* E') (t : E) (h : IsAwayMap ψ t) (e : E' ≃+* E'') :
    IsAwayMap ((e : E' →+* E'').comp ψ) t := by
  refine ⟨fun y => ?_, fun a ha => h.2 a ?_⟩
  · obtain ⟨k, a, hk⟩ := h.1 (e.symm y)
    refine ⟨k, a, ?_⟩
    simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom]
    rw [← hk, map_mul, map_pow, RingEquiv.apply_symm_apply]
  · have ha' : e (ψ a) = 0 := ha
    first
      | exact (map_eq_zero_iff e e.injective).mp ha'
      | exact e.map_eq_zero_iff.mp ha'
      | simpa using ha'

theorem isAwayMap_comp_equiv_pr {E E' E'' : Type u} [CommRing E] [CommRing E'] [CommRing E'']
    (ψ : E →+* E') (t : E) (h : IsAwayMap ψ t) (e : E'' ≃+* E) :
    IsAwayMap (ψ.comp (e : E'' →+* E)) (e.symm t) := by
  refine ⟨fun y => ?_, fun a ha => ?_⟩
  · obtain ⟨k, a, hk⟩ := h.1 y
    refine ⟨k, e.symm a, ?_⟩
    simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply]
    exact hk
  · obtain ⟨k, hk⟩ := h.2 (e a) ha
    refine ⟨k, e.injective ?_⟩
    rw [map_mul, map_pow, RingEquiv.apply_symm_apply, hk, map_zero]

variable {P P' : Type u} [CommRing P] [CommRing P'] {r : ℕ}

/-- `presMap_away` followed by an isomorphism of the target. -/
theorem presMap_away_equiv {Q : Type u} [CommRing Q] (f : P →+* P') (t : P) (hf : IsAwayMap f t)
    (g : Fin r → MvPolynomial (Fin r) P) (e : Pres (gmap f g) ≃+* Q) :
    IsAwayMap ((e : Pres (gmap f g) →+* Q).comp (presMap f g)) (algebraMap P (Pres g) t) :=
  isAwayMap_equiv_comp _ _ (presMap_away f t hf g) e

end Away

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr5

/-! ### piece CovPr6 -/
section Piece_CovPr6


/-!
# S4-EtPBC-A, R4-T2 (A3f): kernels from sections, and ring maps out of square presentations

**`ker_eq_of_section`**: if `I ≤ ker θ` and some `ρ : E → E' ⧸ I` satisfies `ρ ∘ θ = mk I`, then `ker θ = I`.
**`pres_ringHom_ext`**: two ring maps out of `Pres g` agree once they agree on `P` and on the generators `Z_j`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

theorem ker_eq_of_section {E E' : Type u} [CommRing E] [CommRing E'] (θ : E' →+* E) (I : Ideal E')
    (hI : I ≤ RingHom.ker θ) (ρ : E →+* E' ⧸ I) (hρ : ρ.comp θ = Ideal.Quotient.mk I) :
    RingHom.ker θ = I := by
  refine le_antisymm (fun x hx => ?_) hI
  have h0 : Ideal.Quotient.mk I x = 0 := by
    rw [← hρ, RingHom.comp_apply, RingHom.mem_ker.mp hx, map_zero]
  exact Ideal.Quotient.eq_zero_iff_mem.mp h0

variable {P : Type u} [CommRing P] {r : ℕ}

theorem pres_ringHom_ext {Q : Type u} [CommRing Q] {g : Fin r → MvPolynomial (Fin r) P} (φ ψ : Pres g →+* Q)
    (hC : ∀ a, φ (algebraMap P (Pres g) a) = ψ (algebraMap P (Pres g) a))
    (hX : ∀ j, φ (Ideal.Quotient.mk _ (MvPolynomial.X j)) = ψ (Ideal.Quotient.mk _ (MvPolynomial.X j))) :
    φ = ψ := by
  apply Ideal.Quotient.ringHom_ext
  apply MvPolynomial.ringHom_ext
  · intro a
    first
      | exact hC a
      | (have h := hC a
         rw [Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, MvPolynomial.algebraMap_eq] at h
         simpa only [RingHom.comp_apply] using h)
  · intro j
    simpa only [RingHom.comp_apply] using hX j

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr6

/-! ### piece CovPr10 -/
section Piece_CovPr10


/-!
# S4-EtPBC-A, R4-T2 (A3j): residue maps out of presented algebras

* **`presLift g κ z hz`**: the ring map `Pres g → Q` given by a coefficient map `κ : P →+* Q` and a common root `z`
  of the relations (`eval₂ κ z (g j) = 0`); `presLift_mk`, `presLift_algebraMap`, `presLift_X`.
* `eval₂_gmap`, `presLift_comp_presMap`: compatibility with the coefficient change `presMap` (CovPr3).
* `exists_descend`: a ring map killing the kernel of a surjection factors through it.
* **`presLift_ker`**: if `κ` kills `J` and a ring map `ρ : Q → Pres g ⧸ J·Pres g` sends `κ a` to the class of `a` and
  `z j` to the class of `Z j`, then `ker (presLift g κ z hz) = J·Pres g`.
* **`presLift_ker_of_desc`** (headline): the same with `ρ` produced by descent along a surjection `θ : X ↠ Q`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {P : Type u} [CommRing P] {r : ℕ} {Q : Type u} [CommRing Q]

theorem presLift_le (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) :
    Ideal.span (Set.range g) ≤ RingHom.ker (MvPolynomial.eval₂Hom κ z) := by
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨j, rfl⟩
  first
    | exact RingHom.mem_ker.mpr (hz j)
    | (rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom]; exact hz j)

/-- The ring map out of `Pres g` given by a coefficient map and a common root of the relations. -/
def presLift (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) : Pres g →+* Q :=
  Ideal.Quotient.lift (Ideal.span (Set.range g)) (MvPolynomial.eval₂Hom κ z)
    (fun _ hx => RingHom.mem_ker.mp (presLift_le g κ z hz hx))

theorem presLift_mk (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) (x : MvPolynomial (Fin r) P) :
    presLift g κ z hz (Ideal.Quotient.mk _ x) = MvPolynomial.eval₂ κ z x := by
  first
    | rfl
    | simp only [presLift, Ideal.Quotient.lift_mk, MvPolynomial.coe_eval₂Hom]

theorem presLift_algebraMap (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) (a : P) :
    presLift g κ z hz (algebraMap P (Pres g) a) = κ a := by
  first
    | exact (presLift_mk g κ z hz (MvPolynomial.C a)).trans (MvPolynomial.eval₂_C κ z a)
    | (rw [Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, MvPolynomial.algebraMap_eq, presLift_mk,
          MvPolynomial.eval₂_C])

theorem presLift_X (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) (j : Fin r) :
    presLift g κ z hz (Ideal.Quotient.mk _ (MvPolynomial.X j)) = z j :=
  (presLift_mk g κ z hz (MvPolynomial.X j)).trans (MvPolynomial.eval₂_X κ z j)

theorem eval₂_gmap {P' : Type u} [CommRing P'] (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (κ : P' →+* Q) (z : Fin r → Q) (j : Fin r) :
    MvPolynomial.eval₂ κ z (gmap f g j) = MvPolynomial.eval₂ (κ.comp f) z (g j) := by
  first
    | exact MvPolynomial.eval₂_map (g j) f z κ
    | exact MvPolynomial.eval₂_map f z κ (g j)
    | simp only [gmap, MvPolynomial.eval₂_map]

theorem presLift_comp_presMap {P' : Type u} [CommRing P'] (f : P →+* P') (g : Fin r → MvPolynomial (Fin r) P)
    (κ : P' →+* Q) (z : Fin r → Q) (hz : ∀ j, MvPolynomial.eval₂ κ z (gmap f g j) = 0) :
    (presLift (gmap f g) κ z hz).comp (presMap f g) =
      presLift g (κ.comp f) z (fun j => (eval₂_gmap f g κ z j).symm.trans (hz j)) := by
  refine pres_ringHom_ext _ _ (fun a => ?_) (fun j => ?_)
  · exact (congrArg (presLift (gmap f g) κ z hz) (presMap_algebraMap f g a)).trans
      ((presLift_algebraMap _ κ z hz (f a)).trans (presLift_algebraMap g (κ.comp f) z _ a).symm)
  · exact (congrArg (presLift (gmap f g) κ z hz) (presMap_X f g j)).trans
      ((presLift_X _ κ z hz j).trans (presLift_X g (κ.comp f) z _ j).symm)

theorem exists_descend {X Y T : Type u} [CommRing X] [CommRing Y] [CommRing T] (θ : X →+* Y)
    (hθ : Function.Surjective θ) (φ : X →+* T) (hk : RingHom.ker θ ≤ RingHom.ker φ) :
    ∃ ρ : Y →+* T, ρ.comp θ = φ := by
  refine ⟨(Ideal.Quotient.lift (RingHom.ker θ) φ (fun a ha => RingHom.mem_ker.mp (hk ha))).comp
    (RingHom.quotientKerEquivOfSurjective hθ).symm.toRingHom, RingHom.ext fun x => ?_⟩
  have e : (RingHom.quotientKerEquivOfSurjective hθ).symm (θ x) = Ideal.Quotient.mk _ x :=
    (RingEquiv.symm_apply_eq _).mpr (RingHom.quotientKerEquivOfSurjective_apply_mk hθ x).symm
  first
    | (simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, e,
        Ideal.Quotient.lift_mk])
    | (show Ideal.Quotient.lift (RingHom.ker θ) φ _ ((RingHom.quotientKerEquivOfSurjective hθ).symm (θ x)) = φ x
       rw [e, Ideal.Quotient.lift_mk])

theorem presLift_ker (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) (J : Ideal P) (hJ : ∀ a ∈ J, κ a = 0)
    (ρ : Q →+* Pres g ⧸ J.map (algebraMap P (Pres g)))
    (hρC : ∀ a, ρ (κ a) = Ideal.Quotient.mk _ (algebraMap P (Pres g) a))
    (hρX : ∀ j, ρ (z j) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.X j))) :
    RingHom.ker (presLift g κ z hz) = J.map (algebraMap P (Pres g)) := by
  refine ker_eq_of_section (presLift g κ z hz) _ ?_ ρ ?_
  · refine Ideal.map_le_iff_le_comap.mpr (fun a ha => ?_)
    rw [Ideal.mem_comap, RingHom.mem_ker, presLift_algebraMap]
    exact hJ a ha
  · first
      | (apply pres_ringHom_ext
         · intro a
           exact (congrArg ρ (presLift_algebraMap g κ z hz a)).trans (hρC a)
         · intro j
           exact (congrArg ρ (presLift_X g κ z hz j)).trans (hρX j))
      | (apply Ideal.Quotient.ringHom_ext
         apply MvPolynomial.ringHom_ext
         · intro a
           exact (congrArg ρ (presLift_algebraMap g κ z hz a)).trans (hρC a)
         · intro j
           exact (congrArg ρ (presLift_X g κ z hz j)).trans (hρX j))

/-- **Kernel of a residue map by descent**: `ρ` comes from a map `φ` on `X` killing the kernel of `θ : X ↠ Q`. -/
theorem presLift_ker_of_desc (g : Fin r → MvPolynomial (Fin r) P) (κ : P →+* Q) (z : Fin r → Q)
    (hz : ∀ j, MvPolynomial.eval₂ κ z (g j) = 0) (J : Ideal P) (hJ : ∀ a ∈ J, κ a = 0)
    {X : Type u} [CommRing X] (θ : X →+* Q) (hθ : Function.Surjective θ)
    (φ : X →+* Pres g ⧸ J.map (algebraMap P (Pres g))) (hk : RingHom.ker θ ≤ RingHom.ker φ)
    (hC : ∀ a, ∃ x, θ x = κ a ∧ φ x = Ideal.Quotient.mk _ (algebraMap P (Pres g) a))
    (hX : ∀ j, ∃ x, θ x = z j ∧ φ x = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPolynomial.X j))) :
    RingHom.ker (presLift g κ z hz) = J.map (algebraMap P (Pres g)) := by
  let ρ : Q →+* Pres g ⧸ J.map (algebraMap P (Pres g)) :=
    (Ideal.Quotient.lift (RingHom.ker θ) φ (fun a ha => RingHom.mem_ker.mp (hk ha))).comp
      (RingHom.quotientKerEquivOfSurjective hθ).symm.toRingHom
  have hρ : ∀ x, ρ (θ x) = φ x := fun x => by
    have e : (RingHom.quotientKerEquivOfSurjective hθ).symm (θ x) = Ideal.Quotient.mk _ x :=
      (RingEquiv.symm_apply_eq _).mpr (RingHom.quotientKerEquivOfSurjective_apply_mk hθ x).symm
    first
      | (simp only [ρ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, e,
          Ideal.Quotient.lift_mk])
      | (show Ideal.Quotient.lift (RingHom.ker θ) φ _ ((RingHom.quotientKerEquivOfSurjective hθ).symm (θ x)) = φ x
         rw [e, Ideal.Quotient.lift_mk])
  refine presLift_ker g κ z hz J hJ ρ (fun a => ?_) (fun j => ?_)
  · obtain ⟨x, hx, hφ⟩ := hC a
    rw [← hx, hρ, hφ]
  · obtain ⟨x, hx, hφ⟩ := hX j
    rw [← hx, hρ, hφ]

end RamanujanPetersson.EtPBC.Cov
end

end Piece_CovPr10

/-! ### piece ArA1 -/
section Piece_ArA1


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA1: Hensel's lemma in etale-neighbourhood form

**`hensel_nbhd`**: a square polynomial system `g` over `R` with a `K`-point `c` (over `χ : R →+* K`) at which the
Jacobian determinant does not vanish has a solution `z` in an etale `R`-algebra `R'` with a `K`-point `χ'` over `χ`
sending `z` to `c`. `R'` is the standard etale algebra `Pres (hsys g)`: the relations `g` and `jdet g · W - 1`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Hensel

variable {R : Type u} [CommRing R] {r : ℕ}

/-- The system `g` together with `jdet g · W - 1` in one more variable `W = X (last r)`. -/
def hsys (g : Fin r → MvPolynomial (Fin r) R) : Fin (r + 1) → MvPolynomial (Fin (r + 1)) R :=
  Fin.lastCases (MvPolynomial.rename Fin.castSucc (jdet g) * MvPolynomial.X (Fin.last r) - 1)
    (fun j => MvPolynomial.rename Fin.castSucc (g j))

theorem hsys_castSucc (g : Fin r → MvPolynomial (Fin r) R) (j : Fin r) :
    hsys g j.castSucc = MvPolynomial.rename Fin.castSucc (g j) := by
  unfold hsys
  rw [Fin.lastCases_castSucc]

theorem hsys_last (g : Fin r → MvPolynomial (Fin r) R) :
    hsys g (Fin.last r) = MvPolynomial.rename Fin.castSucc (jdet g) * MvPolynomial.X (Fin.last r) - 1 := by
  unfold hsys
  rw [Fin.lastCases_last]

theorem pderiv_last_rename (p : MvPolynomial (Fin r) R) :
    MvPolynomial.pderiv (Fin.last r) (MvPolynomial.rename Fin.castSucc p) = 0 := by
  apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
  intro h
  obtain ⟨i, -, hi⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename Fin.castSucc p h)
  exact Fin.castSucc_ne_last i hi

theorem jdet_hsys (g : Fin r → MvPolynomial (Fin r) R) :
    jdet (hsys g) = MvPolynomial.rename Fin.castSucc (jdet g) ^ 2 := by
  have h0 : ∀ j : Fin r, (Matrix.of fun i k => MvPolynomial.pderiv i (hsys g k)) (Fin.last r) j.castSucc = 0 :=
    fun j => by
      rw [Matrix.of_apply, hsys_castSucc]
      exact pderiv_last_rename (g j)
  have h1 : (Matrix.of fun i k => MvPolynomial.pderiv i (hsys g k)) (Fin.last r) (Fin.last r) =
      MvPolynomial.rename Fin.castSucc (jdet g) := by
    rw [Matrix.of_apply, hsys_last, map_sub, Derivation.leibniz, MvPolynomial.pderiv_X_self,
      pderiv_last_rename, Derivation.map_one_eq_zero, smul_eq_mul, smul_zero, mul_one, add_zero, sub_zero]
  have h2 : (Matrix.of fun i k => MvPolynomial.pderiv i (hsys g k)).submatrix (Fin.last r).succAbove
      (Fin.last r).succAbove = (MvPolynomial.rename Fin.castSucc :
        MvPolynomial (Fin r) R →ₐ[R] MvPolynomial (Fin (r + 1)) R).toRingHom.mapMatrix
          (Matrix.of fun i k => MvPolynomial.pderiv i (g k)) := by
    rw [Fin.succAbove_last]
    ext i k
    rw [Matrix.submatrix_apply, Matrix.of_apply, hsys_castSucc, MvPolynomial.pderiv_rename (Fin.castSucc_injective r)]
    rfl
  have hd : ((Matrix.of fun i k => MvPolynomial.pderiv i (hsys g k)).submatrix (Fin.last r).succAbove
      (Fin.last r).succAbove).det = MvPolynomial.rename Fin.castSucc (jdet g) := by
    rw [h2, ← RingHom.map_det]
    rfl
  show (Matrix.of fun i k => MvPolynomial.pderiv i (hsys g k)).det = MvPolynomial.rename Fin.castSucc (jdet g) ^ 2
  rw [Matrix.det_succ_row _ (Fin.last r), Fin.sum_univ_castSucc]
  simp only [h0, mul_zero, zero_mul, Finset.sum_const_zero, zero_add]
  rw [h1, hd, Fin.val_last, ← two_mul, pow_mul, neg_one_sq, one_pow, one_mul, sq]

/-- **Hensel's lemma in etale-neighbourhood form.** -/
theorem hensel_nbhd {K : Type u} [Field K] (χ : R →+* K) (g : Fin r → MvPolynomial (Fin r) R) (c : Fin r → K)
    (hc : ∀ j, MvPolynomial.eval₂ χ c (g j) = 0) (hJ : MvPolynomial.eval₂ χ c (jdet g) ≠ 0) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (χ' : R' →+* K)
      (z : Fin r → R'), (∀ a, χ' (algebraMap R R' a) = χ a) ∧ (∀ j, MvPolynomial.aeval z (g j) = 0) ∧
        ∀ j, χ' (z j) = c j := by
  obtain ⟨z', hz'1, hz'2⟩ : ∃ z' : Fin (r + 1) → K, z' ∘ Fin.castSucc = c ∧
      z' (Fin.last r) = (MvPolynomial.eval₂ χ c (jdet g))⁻¹ :=
    ⟨Fin.snoc (α := fun _ => K) c (MvPolynomial.eval₂ χ c (jdet g))⁻¹,
      funext fun j => by simp only [Function.comp_apply, Fin.snoc_castSucc], by simp only [Fin.snoc_last]⟩
  have hz : ∀ j, MvPolynomial.eval₂ χ z' (hsys g j) = 0 := by
    intro j
    refine Fin.lastCases ?_ (fun j => ?_) j
    · rw [hsys_last, MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_rename, hz'1,
        MvPolynomial.eval₂_X, MvPolynomial.eval₂_one, hz'2, mul_inv_cancel₀ hJ, sub_self]
    · rw [hsys_castSucc, MvPolynomial.eval₂_rename, hz'1]
      exact hc j
  have hW : ∃ w, jdet (hsys g) * w - 1 ∈ Ideal.span (Set.range (hsys g)) := by
    refine ⟨MvPolynomial.X (Fin.last r) ^ 2, ?_⟩
    have e : jdet (hsys g) * MvPolynomial.X (Fin.last r) ^ 2 - 1 =
        hsys g (Fin.last r) * (MvPolynomial.rename Fin.castSucc (jdet g) * MvPolynomial.X (Fin.last r) + 1) := by
      rw [jdet_hsys, hsys_last]
      ring
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨Fin.last r, rfl⟩)
  have ha : (MvPolynomial.aeval (fun j : Fin r => Ideal.Quotient.mk (Ideal.span (Set.range (hsys g)))
      (MvPolynomial.X j.castSucc)) : MvPolynomial (Fin r) R →ₐ[R] Pres (hsys g)) =
      (Ideal.Quotient.mkₐ R (Ideal.span (Set.range (hsys g)))).comp (MvPolynomial.rename Fin.castSucc) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, MvPolynomial.rename_X, Ideal.Quotient.mkₐ_eq_mk]
  refine ⟨Pres (hsys g), inferInstance, inferInstance, pres_etale (hsys g) hW, presLift (hsys g) χ z' hz,
    fun j => Ideal.Quotient.mk (Ideal.span (Set.range (hsys g))) (MvPolynomial.X j.castSucc),
    presLift_algebraMap _ _ _ hz, fun j => ?_, fun j => (presLift_X _ _ _ hz j.castSucc).trans (congrFun hz'1 j)⟩
  rw [ha, AlgHom.comp_apply, ← hsys_castSucc, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨j.castSucc, rfl⟩

end Hensel

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA1

/-! ### piece ArA3a -/
section Piece_ArA3a


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA3a: first-order Taylor expansion of a polynomial

* `eval_add_sub_mem`: `p (y + h) - p y` lies in the ideal generated by the entries of `h`.
* `taylor_mem`: `p (y + h) - p y - Σ (∂p/∂Y_i)(y) h_i` lies in its square.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Taylor

variable {R : Type u} [CommRing R] {N : ℕ}

theorem eval_add_sub_mem (p : MvPolynomial (Fin N) R) (y h : Fin N → R) :
    MvPolynomial.eval (y + h) p - MvPolynomial.eval y p ∈ Ideal.span (Set.range h) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.eval_C, MvPolynomial.eval_C, sub_self]
    exact Ideal.zero_mem _
  | add p q hp hq =>
    rw [map_add, map_add, add_sub_add_comm]
    exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, Pi.add_apply]
    have e : MvPolynomial.eval (y + h) p * (y i + h i) - MvPolynomial.eval y p * y i =
        (MvPolynomial.eval (y + h) p - MvPolynomial.eval y p) * y i + MvPolynomial.eval (y + h) p * h i := by
      ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))

theorem sum_pderiv_X (y h : Fin N → R) (i : Fin N) :
    ∑ j, MvPolynomial.eval y (MvPolynomial.pderiv j (MvPolynomial.X i : MvPolynomial (Fin N) R)) * h j = h i := by
  rw [Finset.sum_eq_single i]
  · rw [MvPolynomial.pderiv_X_self, map_one, one_mul]
  · intro j _ hj
    rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hj), map_zero, zero_mul]
  · intro hi
    exact absurd (Finset.mem_univ i) hi

theorem sum_pderiv_mul_X (p : MvPolynomial (Fin N) R) (y h : Fin N → R) (i : Fin N) :
    ∑ j, MvPolynomial.eval y (MvPolynomial.pderiv j (p * MvPolynomial.X i)) * h j =
      MvPolynomial.eval y p * h i + y i * ∑ j, MvPolynomial.eval y (MvPolynomial.pderiv j p) * h j := by
  rw [← sum_pderiv_X y h i, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, MvPolynomial.eval_X]
  ring

/-- **First-order Taylor expansion.** -/
theorem taylor_mem (p : MvPolynomial (Fin N) R) (y h : Fin N → R) :
    MvPolynomial.eval (y + h) p - MvPolynomial.eval y p -
      ∑ i, MvPolynomial.eval y (MvPolynomial.pderiv i p) * h i ∈ Ideal.span (Set.range h) ^ 2 := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [MvPolynomial.pderiv_C]
  | add p q hp hq =>
    have e : MvPolynomial.eval (y + h) (p + q) - MvPolynomial.eval y (p + q) -
        ∑ i, MvPolynomial.eval y (MvPolynomial.pderiv i (p + q)) * h i =
        (MvPolynomial.eval (y + h) p - MvPolynomial.eval y p -
          ∑ i, MvPolynomial.eval y (MvPolynomial.pderiv i p) * h i) +
        (MvPolynomial.eval (y + h) q - MvPolynomial.eval y q -
          ∑ i, MvPolynomial.eval y (MvPolynomial.pderiv i q) * h i) := by
      simp only [map_add, add_mul, Finset.sum_add_distrib]
      ring
    rw [e]
    exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
    rw [sum_pderiv_mul_X, map_mul, map_mul, MvPolynomial.eval_X, MvPolynomial.eval_X, Pi.add_apply]
    have e : MvPolynomial.eval (y + h) p * (y i + h i) - MvPolynomial.eval y p * y i -
        (MvPolynomial.eval y p * h i + y i * ∑ j, MvPolynomial.eval y (MvPolynomial.pderiv j p) * h j) =
        y i * (MvPolynomial.eval (y + h) p - MvPolynomial.eval y p -
          ∑ j, MvPolynomial.eval y (MvPolynomial.pderiv j p) * h j) +
        h i * (MvPolynomial.eval (y + h) p - MvPolynomial.eval y p) := by
      ring
    rw [e]
    refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ hp) ?_
    rw [sq]
    exact Ideal.mul_mem_mul (Ideal.subset_span ⟨i, rfl⟩) (eval_add_sub_mem p y h)

end Taylor

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA3a

/-! ### piece ArA3b -/
section Piece_ArA3b


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA3b: Tougeron's lemma in etale-neighbourhood form

**`tougeron_nbhd`**: let `f : Fin r → R[Y_1, …, Y_N]`, `S : Fin r → Fin N` a choice of `r` of the variables,
`y : Fin N → R`, `δ = det (∂ f_j / ∂ Y_{S k}) (y)` (`tmin f S y`), and `f (y) = δ² e` with `χ (e) = 0`. Then in an etale
neighbourhood `(R', χ')` of `χ` there is `y'` with `f (y') = 0` and `y' = y + δ d`, `χ' (d) = 0`.

Proof: `y + δ · tcor` with `tcor = E w`, `w_k = Σ_l adj(Mᵀ)_{kl} X_l`; Taylor (`taylor_mem`) gives
`f (y + δ tcor) = δ² (e + X + q)` with `q ∈ (X)²`, and `hensel_nbhd` solves `e + X + q = 0` at `0`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Tougeron

variable {R : Type u} [CommRing R] {r N : ℕ}

/-- The `r × r` minor `(∂ f_j / ∂ Y_{S k}) (y)` of the Jacobian matrix at `y`. -/
def tmin (f : Fin r → MvPolynomial (Fin N) R) (S : Fin r → Fin N) (y : Fin N → R) : Matrix (Fin r) (Fin r) R :=
  Matrix.of fun k j => MvPolynomial.eval y (MvPolynomial.pderiv (S k) (f j))

/-- The correction direction `E w`: `w_k = Σ_l adj(Mᵀ)_{kl} X_l`, placed at the variables `S k`. -/
def tcor (f : Fin r → MvPolynomial (Fin N) R) (S : Fin r → Fin N) (y : Fin N → R) (i : Fin N) :
    MvPolynomial (Fin r) R :=
  ∑ k, if S k = i then ∑ l, MvPolynomial.C ((tmin f S y).transpose.adjugate k l) * MvPolynomial.X l else 0

theorem eval_C_map (p : MvPolynomial (Fin N) R) (y : Fin N → R) :
    MvPolynomial.eval (fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R))
      (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) p) =
      MvPolynomial.C (MvPolynomial.eval y p) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp only [map_add, hp, hq]
  | mul_X p i hp => simp only [map_mul, hp, MvPolynomial.map_X, MvPolynomial.eval_X]

theorem eval₂_zero_of_mem {K : Type*} [CommRing K] (χ : R →+* K) {q : MvPolynomial (Fin r) R}
    (hq : q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R))) :
    MvPolynomial.eval₂ χ 0 q = 0 := by
  have h : Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ≤
      RingHom.ker (MvPolynomial.eval₂Hom χ (0 : Fin r → K)) := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X, Pi.zero_apply]
  exact (RingHom.mem_ker).mp (h hq)

theorem pderiv_mem_of_mem_sq (i : Fin r) {q : MvPolynomial (Fin r) R}
    (hq : q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ^ 2) :
    MvPolynomial.pderiv i q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) := by
  rw [sq] at hq
  refine Submodule.mul_induction_on (C := fun q => MvPolynomial.pderiv i q ∈
    Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R))) hq (fun a ha b hb => ?_)
    (fun a b ha hb => ?_)
  · show MvPolynomial.pderiv i (a * b) ∈ _
    rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hb)
  · show MvPolynomial.pderiv i (a + b) ∈ _
    rw [map_add]
    exact Ideal.add_mem _ ha hb

theorem tcor_mem (f : Fin r → MvPolynomial (Fin N) R) (S : Fin r → Fin N) (y : Fin N → R) (i : Fin N) :
    tcor f S y i ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) := by
  unfold tcor
  refine Ideal.sum_mem _ fun k _ => ?_
  split_ifs
  · exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)
  · exact Ideal.zero_mem _

theorem sum_mul_ite {P : Type*} [CommRing P] (a : Fin N → P) (S : Fin r → Fin N) (v : Fin r → P) :
    ∑ i, a i * ∑ k, (if S k = i then v k else 0) = ∑ k, a (S k) * v k := by
  simp only [Finset.mul_sum, mul_ite, mul_zero]
  rw [Finset.sum_comm]
  simp

theorem sum_C_adj (M : Matrix (Fin r) (Fin r) R) (j : Fin r) :
    ∑ k, MvPolynomial.C (M k j) * ∑ l, MvPolynomial.C (M.transpose.adjugate k l) *
      (MvPolynomial.X l : MvPolynomial (Fin r) R) = MvPolynomial.C M.det * MvPolynomial.X j := by
  have H : ∀ l, ∑ k, M k j * M.transpose.adjugate k l = M.det * (1 : Matrix (Fin r) (Fin r) R) j l := by
    intro l
    have h := congrArg (fun A : Matrix (Fin r) (Fin r) R => A j l) (Matrix.mul_adjugate M.transpose)
    simpa only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.det_transpose, Matrix.smul_apply,
      smul_eq_mul] using h
  have e : ∑ k, MvPolynomial.C (M k j) * ∑ l, MvPolynomial.C (M.transpose.adjugate k l) *
      (MvPolynomial.X l : MvPolynomial (Fin r) R) =
      ∑ l, MvPolynomial.C (∑ k, M k j * M.transpose.adjugate k l) * MvPolynomial.X l := by
    simp only [Finset.mul_sum, map_sum, Finset.sum_mul, map_mul, mul_assoc]
    exact Finset.sum_comm
  rw [e, Finset.sum_eq_single j]
  · rw [H, Matrix.one_apply_eq, mul_one]
  · intro l _ hl
    rw [H, Matrix.one_apply_ne (Ne.symm hl), mul_zero, map_zero, zero_mul]
  · intro hj
    exact absurd (Finset.mem_univ j) hj

theorem sum_tcor (f : Fin r → MvPolynomial (Fin N) R) (S : Fin r → Fin N) (y : Fin N → R) (j : Fin r) :
    ∑ i, MvPolynomial.C (MvPolynomial.eval y (MvPolynomial.pderiv i (f j))) * tcor f S y i =
      MvPolynomial.C (tmin f S y).det * MvPolynomial.X j := by
  unfold tcor
  exact (sum_mul_ite (fun i => MvPolynomial.C (MvPolynomial.eval y (MvPolynomial.pderiv i (f j)))) S
    (fun k => ∑ l, MvPolynomial.C ((tmin f S y).transpose.adjugate k l) * MvPolynomial.X l)).trans
      (sum_C_adj (tmin f S y) j)

/-- The Taylor step: `f (y + δ · tcor) = δ² (e + X + q)` with `q ∈ (X)²`. -/
theorem tougeron_taylor (f : Fin r → MvPolynomial (Fin N) R) (S : Fin r → Fin N) (y : Fin N → R) (e : Fin r → R)
    (hf : ∀ j, MvPolynomial.eval y (f j) = (tmin f S y).det ^ 2 * e j) (j : Fin r) :
    ∃ q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ^ 2,
      MvPolynomial.aeval (fun i => MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i) (f j) =
        MvPolynomial.C ((tmin f S y).det ^ 2) * (MvPolynomial.C (e j) + MvPolynomial.X j + q) := by
  have ht := taylor_mem (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) (f j))
    (fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R)) (fun i => MvPolynomial.C (tmin f S y).det * tcor f S y i)
  have h1 : Ideal.span (Set.range fun i => MvPolynomial.C (tmin f S y).det * tcor f S y i) ≤
      Ideal.span {(MvPolynomial.C (tmin f S y).det : MvPolynomial (Fin r) R)} *
        Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self _) (tcor_mem f S y i)
  have hle : Ideal.span (Set.range fun i => MvPolynomial.C (tmin f S y).det * tcor f S y i) ^ 2 ≤
      Ideal.span {(MvPolynomial.C ((tmin f S y).det ^ 2) : MvPolynomial (Fin r) R)} *
        Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ^ 2 := by
    calc _ ≤ (Ideal.span {(MvPolynomial.C (tmin f S y).det : MvPolynomial (Fin r) R)} *
          Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R))) ^ 2 := Ideal.pow_right_mono h1 2
      _ = _ := by rw [mul_pow, Ideal.span_singleton_pow, map_pow]
  obtain ⟨q, hq, hq'⟩ := Ideal.mem_span_singleton_mul.mp (hle ht)
  refine ⟨q, hq, ?_⟩
  have e1 : MvPolynomial.eval ((fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R)) +
      fun i => MvPolynomial.C (tmin f S y).det * tcor f S y i)
        (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) (f j)) =
      MvPolynomial.aeval (fun i => MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i) (f j) := by
    rw [MvPolynomial.eval_map, MvPolynomial.aeval_def, MvPolynomial.algebraMap_eq]
    try rfl
  have e2 : MvPolynomial.eval (fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R))
      (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) (f j)) =
      MvPolynomial.C ((tmin f S y).det ^ 2) * MvPolynomial.C (e j) := by
    rw [eval_C_map, hf j, map_mul]
  have e3a : ∀ i, MvPolynomial.eval (fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R))
      (MvPolynomial.pderiv i (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) (f j))) *
        (MvPolynomial.C (tmin f S y).det * tcor f S y i) = MvPolynomial.C (tmin f S y).det *
          (MvPolynomial.C (MvPolynomial.eval y (MvPolynomial.pderiv i (f j))) * tcor f S y i) := by
    intro i
    rw [MvPolynomial.pderiv_map, eval_C_map]
    ring
  have e3 : ∑ i, MvPolynomial.eval (fun i => (MvPolynomial.C (y i) : MvPolynomial (Fin r) R))
      (MvPolynomial.pderiv i (MvPolynomial.map (MvPolynomial.C : R →+* MvPolynomial (Fin r) R) (f j))) *
        (MvPolynomial.C (tmin f S y).det * tcor f S y i) =
      MvPolynomial.C ((tmin f S y).det ^ 2) * MvPolynomial.X j := by
    rw [Finset.sum_congr rfl fun i _ => e3a i, ← Finset.mul_sum, sum_tcor, map_pow]
    ring
  linear_combination -hq' - e1 + e2 + e3

/-- **Tougeron's lemma in etale-neighbourhood form.** -/
theorem tougeron_nbhd {K : Type u} [Field K] (χ : R →+* K) (f : Fin r → MvPolynomial (Fin N) R)
    (S : Fin r → Fin N) (y : Fin N → R) (e : Fin r → R)
    (hf : ∀ j, MvPolynomial.eval y (f j) = (tmin f S y).det ^ 2 * e j) (he : ∀ j, χ (e j) = 0) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (χ' : R' →+* K)
      (y' d : Fin N → R'), (∀ a, χ' (algebraMap R R' a) = χ a) ∧ (∀ j, MvPolynomial.aeval y' (f j) = 0) ∧
        (∀ i, y' i = algebraMap R R' (y i) + algebraMap R R' (tmin f S y).det * d i) ∧ ∀ i, χ' (d i) = 0 := by
  choose q hq hq2 using tougeron_taylor f S y e hf
  have hc : ∀ j, MvPolynomial.eval₂ χ 0 (MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 0 := by
    intro j
    rw [MvPolynomial.eval₂_add, MvPolynomial.eval₂_add, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, he j,
      eval₂_zero_of_mem χ (Ideal.pow_le_self two_ne_zero (hq j)), Pi.zero_apply, add_zero, add_zero]
  have hm : (MvPolynomial.eval₂Hom χ (0 : Fin r → K)).mapMatrix
      (Matrix.of fun i j => MvPolynomial.pderiv i (MvPolynomial.C (e j) + MvPolynomial.X j + q j)) = 1 := by
    ext i j
    have h3 : MvPolynomial.eval₂Hom χ (0 : Fin r → K) (MvPolynomial.pderiv i (q j)) = 0 :=
      eval₂_zero_of_mem χ (pderiv_mem_of_mem_sq i (hq j))
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_add, MvPolynomial.pderiv_C,
      map_zero, zero_add, h3, add_zero]
    by_cases hij : i = j
    · subst hij
      rw [MvPolynomial.pderiv_X_self, map_one, Matrix.one_apply_eq]
    · rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hij), map_zero, Matrix.one_apply_ne hij]
  have hJ : MvPolynomial.eval₂ χ 0 (jdet fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) ≠ 0 := by
    have h1 := RingHom.map_det (MvPolynomial.eval₂Hom χ (0 : Fin r → K))
      (Matrix.of fun i j => MvPolynomial.pderiv i (MvPolynomial.C (e j) + MvPolynomial.X j + q j))
    rw [hm, Matrix.det_one] at h1
    have h2 : MvPolynomial.eval₂ χ 0 (jdet fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 1 := h1
    rw [h2]
    exact one_ne_zero
  obtain ⟨R', i1, i2, i3, χ', z, hχ', hz, hz0⟩ :=
    hensel_nbhd χ (fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) 0 hc hJ
  have hev : ∀ p : MvPolynomial (Fin r) R, χ' (MvPolynomial.aeval z p) = MvPolynomial.eval₂ χ 0 p := by
    intro p
    have hk : χ'.comp (algebraMap R R') = χ := RingHom.ext hχ'
    have hz' : χ' ∘ z = 0 := funext hz0
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left, hk, hz']
  refine ⟨R', i1, i2, i3, χ', fun i => MvPolynomial.aeval z
    (MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i),
    fun i => MvPolynomial.aeval z (tcor f S y i), hχ', fun j => ?_, fun i => ?_, fun i => ?_⟩
  · have h := MvPolynomial.comp_aeval_apply
      (fun i => MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i) (MvPolynomial.aeval z) (f j)
    rw [hq2 j, map_mul, show MvPolynomial.aeval z (MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 0 from hz j,
      mul_zero] at h
    exact h.symm
  · show MvPolynomial.aeval z (MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i) =
      algebraMap R R' (y i) + algebraMap R R' (tmin f S y).det * MvPolynomial.aeval z (tcor f S y i)
    rw [map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_C]
  · show χ' (MvPolynomial.aeval z (tcor f S y i)) = 0
    rw [hev]
    exact eval₂_zero_of_mem χ (tcor_mem f S y i)

end Tougeron

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA3b


