-- title:
--   Actual first finite-chart data selected from the proved affine-complement theorem
-- statement:
--   Let $R$ be a noetherian commutative integral domain with $104$ invertible. On the literal order-thirteen curve, the specified open $U$ is the complement of the actual positive infinity section. Let $B$ be the actual polynomial subalgebra generated by $p=xt$ and $q=x(p+2)$ with $T\mapsto t=y+x^3+x^2+1$. The existing affine-complement theorem supplies a chosen isomorphism $\operatorname{Spec}B\cong U$, compatible with the actual ordinary chart. Its map to $\operatorname{Spec}R[T]$ is finite and lies over the actual base morphism. This interface selects that actual presentation and exposes its compatibility properties for the first-chart global sections and finite free level sets. The inverse chart and full FiniteMapData remain separate obligations.
-- source:
--   Constructors and projection identities selected from the existing public Proved order13_actual_single_section_affine_complement_finite_map theorem. The full literal chart-data type is kernel-equal to the current public theorem statement, including the actual subalgebra, literal localization patch, infinity section, finite parameter map and base compatibility. The isomorphism is explicitly a new classical choice from the proved existence statement; it is not claimed definitionally equal to any older choice. All native, strict and complete frontend checks pass with standard axioms only. Apache-2.0. Named downstream consumers are actual first-chart section comparison and FiniteMapData. Vas and contributors.

/- Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: the literal positive-infinity complement is affine, with a chosen actual Spec presentation, its ordinary-chart compatibility, and its specified finite parameter map over the base. The presentation is chosen from the existing Proved public affine-complement theorem.
Named downstream consumer: actual first-chart global sections and finite free level sets in FiniteMapData. The inverse chart and full FiniteMapData are separate obligations. -/
import Mathlib
import Definitions.Def_MazurTransfer_Order13ActualSingleSectionFiniteBasis
import Definitions.Def_MazurTransfer_Order13IntegralInfinitySections
import Theorems.Thm_MazurTransfer_order13_actual_single_section_affine_complement_finite_map
noncomputable section
universe u
open CategoryTheory AlgebraicGeometry Polynomial
open MazurTorsion.XOneThirteenAffineCurve MazurTorsion.XOneThirteenProjectiveCurve
open scoped MazurTransfer.Order13SingleSectionFiniteAlgebra
namespace MazurTransfer.Order13FirstFiniteChartFromPublicTheorem
variable (R : Type u) [CommRing R]

def delta : ReciprocalRing R :=
  (wCoordinate R - 1 - zCoordinate R - zCoordinate R ^ 3) *
    (wCoordinate R - 1 - zCoordinate R + zCoordinate R ^ 3)
abbrev PatchRing := Localization.Away (delta R)
def patchInclusion : Spec (.of (PatchRing R)) ⟶ reciprocalScheme R :=
  Spec.map (CommRingCat.ofHom (algebraMap (ReciprocalRing R) (PatchRing R)))
instance patchInclusion_isOpenImmersion : IsOpenImmersion (patchInclusion R) :=
  IsOpenImmersion.of_isLocalization (delta R)
def patchChartMap : Spec (.of (PatchRing R)) ⟶ curveScheme R :=
  patchInclusion R ≫ reciprocalChartMap R
instance patchChartMap_isOpenImmersion : IsOpenImmersion (patchChartMap R) :=
  IsOpenImmersion.comp (patchInclusion R) (reciprocalChartMap R)
def chartOpen : (curveScheme R).Opens :=
  (ordinaryChartMap R).opensRange ⊔ (patchChartMap R).opensRange

variable [IsDomain R] [IsNoetherianRing R]

theorem chartData (h104 : IsUnit (104 : R)) :
    IsAffineOpen (chartOpen R) ∧
      (chartOpen R : Set (curveScheme R)) =
        (Set.range (Order13IntegralSections.positiveInfinitySection R).val)ᶜ ∧
      ∃ e : Spec (.of (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)) ≅
          (chartOpen R).toScheme,
        Spec.map (CommRingCat.ofHom
          (Order13SingleSectionFiniteAlgebra.candidateAlgebra R).val.toRingHom) ≫
            e.hom ≫ (chartOpen R).ι = ordinaryChartMap R ∧
        IsFinite (e.inv ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial R) (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)))) ∧
        (e.inv ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (Polynomial R) (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)))) ≫
          Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)) =
          (chartOpen R).ι ≫ curveToBase R := by
  exact MazurTransfer.order13_actual_single_section_affine_complement_finite_map R h104

def specIso (h104 : IsUnit (104 : R)) :
    Spec (.of (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)) ≅
      (chartOpen R).toScheme := Classical.choose (chartData R h104).2.2

theorem specIso_ordinary (h104 : IsUnit (104 : R)) :
    Spec.map (CommRingCat.ofHom
      (Order13SingleSectionFiniteAlgebra.candidateAlgebra R).val.toRingHom) ≫
        (specIso R h104).hom ≫ (chartOpen R).ι = ordinaryChartMap R :=
  (Classical.choose_spec (chartData R h104).2.2).1

theorem specIso_parameter_finite (h104 : IsUnit (104 : R)) :
    IsFinite ((specIso R h104).inv ≫ Spec.map (CommRingCat.ofHom
      (algebraMap (Polynomial R) (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)))) :=
  (Classical.choose_spec (chartData R h104).2.2).2.1

theorem specIso_parameter_over (h104 : IsUnit (104 : R)) :
    ((specIso R h104).inv ≫ Spec.map (CommRingCat.ofHom
      (algebraMap (Polynomial R) (Order13SingleSectionFiniteAlgebra.candidateAlgebra R)))) ≫
      Spec.map (CommRingCat.ofHom (Polynomial.C : R →+* Polynomial R)) =
      (chartOpen R).ι ≫ curveToBase R :=
  (Classical.choose_spec (chartData R h104).2.2).2.2

theorem chartOpen_isAffine (h104 : IsUnit (104 : R)) :
    IsAffineOpen (chartOpen R) := (chartData R h104).1

theorem mem_chartOpen_iff (h104 : IsUnit (104 : R)) (x : curveScheme R) :
    x ∈ chartOpen R ↔ x ∉ Set.range (Order13IntegralSections.positiveInfinitySection R).val :=
  Set.ext_iff.mp (chartData R h104).2.1 x

end MazurTransfer.Order13FirstFiniteChartFromPublicTheorem
#print axioms MazurTransfer.Order13FirstFiniteChartFromPublicTheorem.chartData
#print axioms MazurTransfer.Order13FirstFiniteChartFromPublicTheorem.specIso


