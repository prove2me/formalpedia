-- title:
--   The discriminant of a number field is the norm of the different ideal
-- statement:
--   **The discriminant is the norm of the different.** Let $K$ be a number field with ring of integers $\mathcal O_K$, discriminant $d_K$ and different ideal $\mathfrak D_K$. Then
--   $$N(\mathfrak D_K)=|d_K|.$$
--
--   This links the two main measures of ramification. With Dedekind's different theorem it shows that a prime $p$ ramifies in $K$ exactly when $p\mid d_K$. It is also used to compute the discriminant, since the different of $\mathbb Z[\alpha]$ is generated by $f'(\alpha)$ for the minimal polynomial $f$ of $\alpha$.
--
--   **Formalization note.** Mathlib's `NumberField.absNorm_differentIdeal`, applied to `NumberField.RingOfIntegers K`. `Ideal.absNorm` is the absolute norm $|\mathcal O_K/I|$ of an ideal and `NumberField.discr K` is the discriminant as an integer.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `NumberField.absNorm_differentIdeal`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

theorem number_field_discriminant_norm_different_7b (K : Type*) [Field K] [NumberField K] :
    Ideal.absNorm (differentIdeal ℤ (NumberField.RingOfIntegers K)) = (NumberField.discr K).natAbs := by sorry

end FamousTheorems
