    (fun j s μ' => ⟨frame (qFr b0 zl zh rv n k pv.N0 pv.K0 KKb cnt j0 (u / pv.K0) (u % pv.K0) a j
      s.1 s.2.1 s.2.2 (cnt + (j0 + u) * (n * n)) u), μ'⟩)
    (fun j μ' => QInv pv t hmL aX aY b0 AL AR μ₀ n k ZL ZH (cnt + j0 * (n * n))
