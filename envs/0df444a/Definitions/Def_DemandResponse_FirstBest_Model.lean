-- title:
--   Canonical space, admissible pairs (weak formulation of (2.1)), criteria J_A (2.2), J_P (2.4), contracts 𝒞 (2.5), first-best value V^FB (2.6) and V̄
-- statement:
--   This file sets up the stochastic layer of the model of Aïd, Possamaï and Touzi and the two values the first-best analysis is about.
--
--   **Canonical space.** $\Omega:=C([0,T],\mathbb R)$, the canonical process $X_t(\omega):=\omega(t)$, the σ-algebra generated by the coordinates and the canonical filtration $\mathbb F=(\mathcal F_t)_{t\in[0,T]}$, $\mathcal F_t:=\sigma(X_s,\,s\le t)$.
--
--   **Controls and admissible pairs.** A control $\nu=(\alpha,\beta)$ is a pair of $\mathbb F$-progressively measurable processes with values in $A$ and $B=[\varepsilon,1]^d$. An **admissible pair** $(\nu,\mathbb P)$ is a control together with a probability measure $\mathbb P$ on $\Omega$ such that $X_0=X_0$ $\mathbb P$-a.s. and both
--   $$M_t:=X_t-X_0+\int_0^t\alpha_s\cdot\mathbf 1\,ds\qquad\text{and}\qquad M_t^2-\int_0^t|\sigma(\beta_s)|^2\,ds$$
--   are $(\mathbb F,\mathbb P)$-martingales. This is the weak formulation of the controlled equation (2.1), $X_t=X_0-\int_0^t\alpha_s\cdot\mathbf 1\,ds+\int_0^t\sigma(\beta_s)\cdot dW_s$.
--
--   **Criteria.** For an $\mathcal F_T$-measurable $\xi:\Omega\to\mathbb R$,
--   $$J_A(\xi,\nu,\mathbb P):=\mathbb E^{\mathbb P}\Big[-e^{-r(\xi+\int_0^T(\kappa X_s-c(\nu_s))ds)}\Big],\qquad J_P(\xi,\nu,\mathbb P):=\mathbb E^{\mathbb P}\Big[-e^{-p(-\xi-\int_0^T\theta X_sds-\frac h2\langle X\rangle_T)}\Big],$$
--   with $\langle X\rangle_T=\int_0^T|\sigma(\beta_s)|^2ds$, both in $[-\infty,0]$.
--
--   **Contracts.** $\xi\in\mathcal C$ when $\xi$ is $\mathcal F_T$-measurable and, for some $m>1$, $\sup_{\mathbb P}\mathbb E^{\mathbb P}[e^{-rm\xi}]+\sup_{\mathbb P}\mathbb E^{\mathbb P}[e^{pm\xi}]<+\infty$ (2.5), the suprema over all admissible pairs.
--
--   **Values.** The first-best value (2.6) and the auxiliary value of p. 26 are
--   $$V^{FB}:=\sup\big\{J_P(\xi,\nu,\mathbb P):\xi\in\mathcal C,\ (\nu,\mathbb P)\text{ admissible},\ J_A(\xi,\nu,\mathbb P)\ge R_0\big\},$$
--   $$\bar V:=\sup_{(\nu,\mathbb P)}\mathbb E^{\mathbb P}\Big[-e^{-\rho\left(\int_0^T(\delta X_t-c(\nu_t))dt-\frac h2\langle X\rangle_T\right)}\Big],$$
--   both suprema in $[-\infty,+\infty]$ with $\sup\emptyset=-\infty$.
--
--   In the first best the producer chooses the contract and the consumer's effort together, constrained only by participation; $\bar V$ is the single stochastic control problem to which the first best reduces.
--
--   **Formalization Note** The paper (footnote 2, p. 7) uses weak solutions without stating them; the martingale problem above is the chosen weak formulation, equivalent for bounded coefficients to $\mathbb P$ being the law of a weak solution of (2.1). The admissible object is the pair $(\nu,\mathbb P)$, since the cost $c(\nu)$ depends on $\nu$ and not only on the law. Wherever the criteria contain $\langle X\rangle_T$ it is replaced by its almost-sure value $\int_0^T|\sigma(\beta_s)|^2ds$ under the pair; a contract may still be any $\mathcal F_T$-measurable function of the path. Expectations of the utilities are negated lower Lebesgue integrals of $e^{(\cdot)}$, valued in $[-\infty,0]$, so a non-integrable utility gives $-\infty$, not a junk $0$; the suprema are `EReal` suprema. Processes are indexed by $[0,T]$ and read at real times through the projection onto $[0,T]$.
-- source:
--   arXiv:1810.09063v3, Section 2.1 (p. 7, (2.1) and footnote 2; p. 8, (2.2)), Section 2.2 (pp. 8-9, (2.4)-(2.6)), Appendix A.2 (p. 26, definition of V̄)

import Mathlib
import Definitions.Def_DemandResponse_FirstBest_Hamiltonian

open MeasureTheory

namespace DemandResponse.FirstBest

variable {N d : ℕ}

/-- The time interval `[0, T]`. -/
abbrev Time (P : Params N d) : Type := Set.Icc (0 : ℝ) P.T

/-- The time `0 ∈ [0, T]`. -/
def t0 (P : Params N d) : Time P := ⟨0, le_rfl, P.hT.le⟩

/-- The terminal time `T ∈ [0, T]`. -/
def tT (P : Params N d) : Time P := ⟨P.T, P.hT.le, le_rfl⟩

/-- The canonical space `Ω := C([0, T], ℝ)` of scalar continuous trajectories (p. 7). It is a
type synonym, so that it carries only the coordinate σ-algebra declared below. -/
def Path (P : Params N d) : Type := C(Set.Icc (0 : ℝ) P.T, ℝ)

/-- The canonical process `X_t(ω) := ω(t)` (p. 7). -/
def X (P : Params N d) (t : Time P) (ω : Path P) : ℝ :=
  (show C(Set.Icc (0 : ℝ) P.T, ℝ) from ω) t

/-- `X` read at a real time `s`, clamped to `[0, T]` (used only for `s ∈ [0, T]`). -/
noncomputable def Xr (P : Params N d) (s : ℝ) (ω : Path P) : ℝ :=
  X P (Set.projIcc 0 P.T P.hT.le s) ω

/-- The σ-algebra on `Ω` generated by the coordinates `X_t`, `t ∈ [0, T]`. -/
instance instMeasurableSpacePath (P : Params N d) : MeasurableSpace (Path P) :=
  ⨆ t : Time P, MeasurableSpace.comap (X P t) inferInstance

/-- The canonical filtration `𝔽 = {𝓕_t}`, `𝓕_t := σ(X_s, s ≤ t)` (p. 7). -/
def filt (P : Params N d) : Filtration (Time P) (instMeasurableSpacePath P) where
  seq t := ⨆ s : Time P, ⨆ (_ : s ≤ t), MeasurableSpace.comap (X P s) inferInstance
  mono' := fun _ _ htt' => iSup_mono fun _ => iSup_mono' fun hs => ⟨hs.trans htt', le_rfl⟩
  le' := fun _ => iSup_le fun s => iSup_le fun _ =>
    le_iSup (fun s : Time P => MeasurableSpace.comap (X P s) (inferInstance : MeasurableSpace ℝ)) s

/-- A control `ν = (α, β)` of the consumer (p. 7): a pair of `𝔽`-progressively measurable
processes on the canonical space with values in `A ⊆ ℝ^N` and `B = [ε, 1]^d`. -/
structure Control (P : Params N d) where
  α : Time P → Path P → (Fin N → ℝ)
  β : Time P → Path P → (Fin d → ℝ)
  α_mem : ∀ t ω, α t ω ∈ effortA P
  β_mem : ∀ t ω, β t ω ∈ effortB P
  α_prog : IsStronglyProgressive (filt P) α
  β_prog : IsStronglyProgressive (filt P) β

/-- `α` read at a real time, clamped to `[0, T]`. -/
noncomputable def Control.αr {P : Params N d} (ν : Control P) (s : ℝ) (ω : Path P) : Fin N → ℝ :=
  ν.α (Set.projIcc 0 P.T P.hT.le s) ω

/-- `β` read at a real time, clamped to `[0, T]`. -/
noncomputable def Control.βr {P : Params N d} (ν : Control P) (s : ℝ) (ω : Path P) : Fin d → ℝ :=
  ν.β (Set.projIcc 0 P.T P.hT.le s) ω

/-- `∫₀ᵗ α_s · 1 ds`. -/
noncomputable def driftInt (P : Params N d) (ν : Control P) (t : ℝ) (ω : Path P) : ℝ :=
  ∫ s in (0 : ℝ)..t, ∑ i, ν.αr s ω i

/-- `∫₀ᵗ |σ(β_s)|² ds`, the quadratic variation of `X` under an admissible pair. -/
noncomputable def qvInt (P : Params N d) (ν : Control P) (t : ℝ) (ω : Path P) : ℝ :=
  ∫ s in (0 : ℝ)..t, sigSq P (ν.βr s ω)

/-- **Admissible pair** `(ν, ℙ)`: the weak formulation of the controlled equation (2.1),
`X_t = X₀ - ∫₀ᵗ α_s · 1 ds + ∫₀ᵗ σ(β_s) · dW_s`, as a martingale problem on the canonical space:
`ℙ` is a probability measure with `X_0 = X₀` a.s., and both
`M_t := X_t - X₀ + ∫₀ᵗ α_s · 1 ds` and `M_t² - ∫₀ᵗ |σ(β_s)|² ds` are `(𝔽, ℙ)`-martingales. -/
structure Admissible (P : Params N d) (ν : Control P) (Q : Measure (Path P)) : Prop where
  isProb : IsProbabilityMeasure Q
  init : ∀ᵐ ω ∂Q, X P (t0 P) ω = P.X₀
  mart_drift : Martingale (fun t ω => X P t ω - P.X₀ + driftInt P ν t ω) (filt P) Q
  mart_qv : Martingale
    (fun t ω => (X P t ω - P.X₀ + driftInt P ν t ω) ^ 2 - qvInt P ν t ω) (filt P) Q

/-- The consumer's criterion (2.2) with `f(x) = κ x` and `U_A(x) = -e^{-r x}`:
`J_A(ξ, ℙ^ν) = E^ℙ[-exp(-r(ξ + ∫₀ᵀ (κ X_s - c(ν_s)) ds))]`, computed as the negated lower
Lebesgue integral of a nonnegative function, valued in `[-∞, 0]`. -/
noncomputable def JA (P : Params N d) (ξ : Path P → ℝ) (ν : Control P) (Q : Measure (Path P)) :
    EReal :=
  -(((∫⁻ ω, ENNReal.ofReal (Real.exp (-P.r * (ξ ω +
      ∫ s in (0 : ℝ)..P.T, (P.κ * Xr P s ω - cost P (ν.αr s ω) (ν.βr s ω))))) ∂Q) : ENNReal) : EReal)

/-- The producer's criterion (2.4) with `g(x) = θ x` and `U(x) = -e^{-p x}`:
`J_P(ξ, ℙ^ν) = E^ℙ[-exp(-p(-ξ - ∫₀ᵀ θ X_s ds - (h/2)⟨X⟩_T))]`, where `⟨X⟩_T` is its almost-sure
value `∫₀ᵀ |σ(β_s)|² ds` under the admissible pair; valued in `[-∞, 0]`. -/
noncomputable def JP (P : Params N d) (ξ : Path P → ℝ) (ν : Control P) (Q : Measure (Path P)) :
    EReal :=
  -(((∫⁻ ω, ENNReal.ofReal (Real.exp (-P.p * (-ξ ω -
      (∫ s in (0 : ℝ)..P.T, P.θ * Xr P s ω) - P.h / 2 * qvInt P ν P.T ω))) ∂Q) : ENNReal) : EReal)

/-- The contract class `𝒞` (p. 9): `𝓕_T`-measurable `ξ` with the integrability property (2.5),
`sup_ℙ E^ℙ[e^{-r m ξ}] + sup_ℙ E^ℙ[e^{p m ξ}] < +∞` for some `m > 1`, the suprema being over all
admissible pairs. -/
def IsContract (P : Params N d) (ξ : Path P → ℝ) : Prop :=
  Measurable[filt P (tT P)] ξ ∧
    ∃ m : ℝ, 1 < m ∧
      (⨆ (ν : Control P) (Q : Measure (Path P)) (_ : Admissible P ν Q),
          ∫⁻ ω, ENNReal.ofReal (Real.exp (-P.r * m * ξ ω)) ∂Q) +
        (⨆ (ν : Control P) (Q : Measure (Path P)) (_ : Admissible P ν Q),
          ∫⁻ ω, ENNReal.ofReal (Real.exp (P.p * m * ξ ω)) ∂Q) < ⊤

/-- The first-best value (2.6): `V^FB := sup { J_P(ξ, ℙ^ν) : ξ ∈ 𝒞, (ν, ℙ) admissible,
J_A(ξ, ℙ^ν) ≥ R₀ }`, an `EReal` supremum (`sup ∅ = -∞`). -/
noncomputable def VFB (P : Params N d) : EReal :=
  sSup {v : EReal | ∃ (ξ : Path P → ℝ) (ν : Control P) (Q : Measure (Path P)),
    IsContract P ξ ∧ Admissible P ν Q ∧ (P.R₀ : EReal) ≤ JA P ξ ν Q ∧ v = JP P ξ ν Q}

/-- The auxiliary control value of p. 26,
`V̄ := sup_ℙ E^ℙ[-exp(-ρ(∫₀ᵀ ((f - g)(X_t) - c(ν_t)) dt - (h/2)⟨X⟩_T))]`, with
`(f - g)(x) = δ x`, `ρ = r p / (r + p)` and `⟨X⟩_T = ∫₀ᵀ |σ(β_t)|² dt`; an `EReal` supremum over
admissible pairs. -/
noncomputable def Vbar (P : Params N d) : EReal :=
  sSup {v : EReal | ∃ (ν : Control P) (Q : Measure (Path P)), Admissible P ν Q ∧
    v = -(((∫⁻ ω, ENNReal.ofReal (Real.exp (-rho P *
      ((∫ s in (0 : ℝ)..P.T, (delta P * Xr P s ω - cost P (ν.αr s ω) (ν.βr s ω))) -
        P.h / 2 * qvInt P ν P.T ω))) ∂Q) : ENNReal) : EReal)}

end DemandResponse.FirstBest


