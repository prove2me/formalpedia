theorem zsz_lt_pow {x : ℤ} {B : ℕ} (h : x.natAbs < 2 ^ B) : zsz x ≤ B := zsz_le_of_lt h

theorem gIn_clean : ∀ r ∈ NLogN.KFV.gIn, r ∉ NLogN.zX.all := by decide

theorem clean_gIn {e : Ex HS} (h : ∀ r ∈ e.regs, r ∈ NLogN.KFV.gIn) : e.Clean := fun r hr =>
  gIn_clean r (h r hr)

theorem RG.reg {i : Fin HS} (h : i ∈ NLogN.KFV.gIn) : RG (.reg i) := by
  intro r hr; simp only [Ex.regs, List.mem_singleton] at hr; rw [hr]; exact h

theorem RG.lit (c : ℤ) : RG (.lit c) := by intro r hr; simp [Ex.regs] at hr

theorem RG.add {a b : Ex HS} (ha : RG a) (hb : RG b) : RG (.add a b) := by
  intro r hr; simp only [Ex.regs, List.mem_append] at hr; exact hr.elim (ha r) (hb r)

theorem RG.mul {a b : Ex HS} (ha : RG a) (hb : RG b) : RG (.mul a b) := by
  intro r hr; simp only [Ex.regs, List.mem_append] at hr; exact hr.elim (ha r) (hb r)

theorem RG.ndiv {a b : Ex HS} (ha : RG a) (hb : RG b) : RG (.ndiv a b) := by
  intro r hr; simp only [Ex.regs, List.mem_append] at hr; exact hr.elim (ha r) (hb r)

theorem RG.nmod {a b : Ex HS} (ha : RG a) (hb : RG b) : RG (.nmod a b) := by
  intro r hr; simp only [Ex.regs, List.mem_append] at hr; exact hr.elim (ha r) (hb r)

theorem RG.neg {a : Ex HS} (ha : RG a) : RG (.neg a) := by
  intro r hr; simp only [Ex.regs] at hr; exact ha r hr

theorem RG.pow2 {a : Ex HS} (ha : RG a) : RG (.pow2 a) := by
  intro r hr; simp only [Ex.regs] at hr; exact ha r hr

theorem gIn_ne_y {r : Fin HS} (h : r ∈ NLogN.KFV.gIn) : r ≠ 0 ∧ r ≠ NLogN.KFV.yP ∧ r ≠ yD ∧ r ≠ yQ ∧ r ≠ yG0 ∧
    r ≠ yQD ∧ r ≠ NLogN.KFV.yW ∧ r ≠ yN ∧ r ≠ yM := by
  revert h; revert r; decide

theorem vol_lf (a d c ℓ : ℕ) :
    2 * (vol (Butterfly.layerShape (2 ^ a) 1 d (2 ^ c)) * 2 ^ ℓ) = 2 ^ (a + d + c + ℓ + 1) := by
  rw [vol_layer]; simp only [pow_one, ← pow_add, ← pow_mul, one_mul]; ring

set_option maxHeartbeats 4000000 in
/-- **The pushes** compute the leaf registers. -/
theorem lfPush_sp (s : IState HS) (v : List ℤ) {eP eD eS : Ex HS} {a d c ℓ B : ℕ}
    (rP : RG eP) (rD : RG eD) (rS : RG eS)
    (hP : EV (encK s (o0 v)) B eP (a : ℤ)) (hD : EV (encK s (o0 v)) B eD (d : ℤ))
    (hS : EV (encK s (o0 v)) B eS (c : ℤ)) (hL : EV (encK s (o0 v)) B (.reg gLl) (ℓ : ℤ))
    (hd : 1 ≤ d) (hB : a + 2 * d + c + ℓ + 3 ≤ B) :
    Sp (lfPush eP eD eS) (encK s (o0 v)) (encK s (lfF v a d c ℓ))
      (cLfPush (eP.size + eD.size + eS.size) B) := by
  set st := encK s (o0 v)
  have zI : ∀ x : ℤ, -1 ≤ x → x ≤ ((a + 2 * d + c + ℓ + 1 : ℕ) : ℤ) → zsz x ≤ B := fun x h1 h2 => by
    apply NLogN.KFV.zsz_lt_pow
    have h3 : x.natAbs ≤ a + 2 * d + c + ℓ + 1 := by omega
    exact lt_of_le_of_lt h3 (lt_of_lt_of_le Nat.lt_two_pow_self
      (Nat.pow_le_pow_right (by norm_num) (by omega)))
  -- the eight expressions, evaluated on `st`
  have E1 := hP.pow2 (by omega)
  have Lm := EV.lit (st := st) (B := B) (c := -1) (zI _ le_rfl (by push_cast; omega))
  have L1 := EV.lit (st := st) (B := B) (c := 1) (zI _ (by omega) (by push_cast; omega))
  have E3 := ((hS.add hL (zI _ (by omega) (by push_cast; omega))).cast
    (v' := ((c + ℓ : ℕ) : ℤ)) (by push_cast; ring)).pow2 (by omega)
  have E4 := (((hP.add hD (zI _ (by omega) (by push_cast; omega))).add Lm
    (zI _ (by omega) (by push_cast; omega))).cast
    (v' := ((a + d - 1 : ℕ) : ℤ)) (by push_cast [show 1 ≤ a + d by omega]; ring)).pow2 (by omega)
  have E5 := ((((hD.add Lm (zI _ (by omega) (by push_cast; omega))).add hS
    (zI _ (by omega) (by push_cast; omega))).add hL
    (zI _ (by omega) (by push_cast; omega))).cast
    (v' := ((d - 1 + c + ℓ : ℕ) : ℤ)) (by push_cast [show 1 ≤ d by omega]; ring)).pow2 (by omega)
  have h2 : zsz ((2 : ℕ) : ℤ) ≤ B := zsz_nat_le (by omega)
  have h8 : zsz ((8 : ℕ) : ℤ) ≤ B := zsz_nat_lt (lt_of_lt_of_le (by norm_num : 8 < 2 ^ 4)
    (Nat.pow_le_pow_right (by norm_num) (by omega)))
  have Dv := hD.ndiv (EV.lit h2) (by norm_num) (zsz_nat_le (by omega))
  have Dm := hD.nmod (EV.lit h2) (by norm_num) (zsz_nat_le (by omega))
  have hd2 : d / 2 + d % 2 ≤ d := by omega
  have E6 := (((hD.add Dv (zI _ (by omega) (by push_cast; omega))).add Dm
      (zI _ (by omega) (by push_cast; omega))).cast
    (v' := ((dScale d : ℕ) : ℤ)) (by unfold dScale; push_cast; ring)).pow2
    (by unfold dScale; omega)
  have E7 := (((((hP.add hD (zI _ (by omega) (by push_cast; omega))).add hS
    (zI _ (by omega) (by push_cast; omega))).add hL
    (zI _ (by omega) (by push_cast; omega))).add L1
    (zI _ (by omega) (by push_cast; omega))).cast
    (v' := ((a + d + c + ℓ + 1 : ℕ) : ℤ)) (by push_cast; ring)).pow2 (by omega)
  have E8 := hD.nmod (EV.lit h8) (by norm_num) (zsz_nat_le (by omega))
  -- the states
  have rL : RG (.reg gLl) := RG.reg (by decide)
  have tr : ∀ {e : Ex HS} {w : ℤ} (g : Fin HS → List ℤ), RG e → (∀ r ∈ NLogN.KFV.gIn, g r = o0 v r) →
      EV st B e w → EV (encK s g) B e w := fun g he hg h => h.encK fun r hr => (hg r (he r hr)).symm
  have ag : ∀ (g : Fin HS → List ℤ) (j : Fin HS) (x : List ℤ), (∀ r ∈ NLogN.KFV.gIn, g r = o0 v r) →
      j ∉ NLogN.KFV.gIn → ∀ r ∈ NLogN.KFV.gIn, Function.update g j x r = o0 v r := fun g j x hg hj r hr => by
    have : r ≠ j := fun e => hj (e ▸ hr)
    rw [Function.update_of_ne this]; exact hg r hr
  have a0 : ∀ r ∈ NLogN.KFV.gIn, o0 v r = o0 v r := fun _ _ => rfl
  set F1 := Function.update (o0 v) NLogN.KFV.yP [((2 ^ a : ℕ) : ℤ)]
  have a1 := ag _ NLogN.KFV.yP [((2 ^ a : ℕ) : ℤ)] a0 (by decide)
  have S1 := NLogN.KFV.pushV s (o0 v) (i := NLogN.KFV.yP) (by decide) (clean_gIn (RG.pow2 rP)) E1 (by simp +decide [o0, Function.update_apply])
  set F2 := Function.update F1 yD [(d : ℤ)]
  have a2 := ag _ yD [(d : ℤ)] a1 (by decide)
  have S2 := NLogN.KFV.pushV s F1 (i := yD) (by decide) (clean_gIn rD) (tr F1 rD a1 hD)
    (by simp +decide [F1, o0, Function.update_apply])
  set F3 := Function.update F2 yQ [((2 ^ (c + ℓ) : ℕ) : ℤ)]
  have a3 := ag _ yQ [((2 ^ (c + ℓ) : ℕ) : ℤ)] a2 (by decide)
  have S3 := NLogN.KFV.pushV s F2 (i := yQ) (by decide) (clean_gIn (RG.pow2 (RG.add rS rL)))
    (tr F2 (RG.pow2 (RG.add rS rL)) a2 E3) (by simp +decide [F2, F1, o0, Function.update_apply])
  set F4 := Function.update F3 yG0 [((2 ^ (a + d - 1) : ℕ) : ℤ)]
  have a4 := ag _ yG0 [((2 ^ (a + d - 1) : ℕ) : ℤ)] a3 (by decide)
  have r4 : RG (.pow2 (.add (.add eP eD) (.lit (-1)))) := RG.pow2 (RG.add (RG.add rP rD) (RG.lit _))
  have S4 := NLogN.KFV.pushV s F3 (i := yG0) (by decide) (clean_gIn r4) (tr F3 r4 a3 E4)
    (by simp +decide [F3, F2, F1, o0, Function.update_apply])
  set F5 := Function.update F4 yQD [((2 ^ (d - 1 + c + ℓ) : ℕ) : ℤ)]
  have a5 := ag _ yQD [((2 ^ (d - 1 + c + ℓ) : ℕ) : ℤ)] a4 (by decide)
  have r5 : RG (.pow2 (.add (.add (.add eD (.lit (-1))) eS) (.reg gLl))) :=
    RG.pow2 (RG.add (RG.add (RG.add rD (RG.lit _)) rS) rL)
  have S5 := NLogN.KFV.pushV s F4 (i := yQD) (by decide) (clean_gIn r5) (tr F4 r5 a4 E5)
    (by simp +decide [F4, F3, F2, F1, o0, Function.update_apply])
  set F6 := Function.update F5 NLogN.KFV.yW [((2 ^ dScale d : ℕ) : ℤ)]
  have a6 := ag _ NLogN.KFV.yW [((2 ^ dScale d : ℕ) : ℤ)] a5 (by decide)
  have r6 : RG (.pow2 (.add (.add eD (.ndiv eD (.lit 2))) (.nmod eD (.lit 2)))) :=
    RG.pow2 (RG.add (RG.add rD (RG.ndiv rD (RG.lit _))) (RG.nmod rD (RG.lit _)))
  have S6 := NLogN.KFV.pushV s F5 (i := NLogN.KFV.yW) (by decide) (clean_gIn r6) (tr F5 r6 a5 E6)
    (by simp +decide [F5, F4, F3, F2, F1, o0, Function.update_apply])
  set F7 := Function.update F6 yN [((2 ^ (a + d + c + ℓ + 1) : ℕ) : ℤ)]
  have a7 := ag _ yN [((2 ^ (a + d + c + ℓ + 1) : ℕ) : ℤ)] a6 (by decide)
  have r7 : RG (.pow2 (.add (.add (.add (.add eP eD) eS) (.reg gLl)) (.lit 1))) :=
    RG.pow2 (RG.add (RG.add (RG.add (RG.add rP rD) rS) rL) (RG.lit _))
  have S7 := NLogN.KFV.pushV s F6 (i := yN) (by decide) (clean_gIn r7) (tr F6 r7 a6 E7)
    (by simp +decide [F6, F5, F4, F3, F2, F1, o0, Function.update_apply])
  have r8 : RG (.nmod eD (.lit 8)) := RG.nmod rD (RG.lit _)
  have S8 := NLogN.KFV.pushV s F7 (i := NLogN.KFV.yM) (by decide) (clean_gIn r8) (tr F7 r8 a7 E8)
    (by simp +decide [F7, F6, F5, F4, F3, F2, F1, o0, Function.update_apply])
  have S := S1.seq (S2.seq (S3.seq (S4.seq (S5.seq (S6.seq (S7.seq S8))))))
  refine (S.congr ?_).mono ?_
  · congr 1
    simp only [F7, F6, F5, F4, F3, F2, F1, lfF, vol_lf, ← pow_add]
    rw [show a + d - 1 = a + (d - 1) by omega, show d - 1 + c + ℓ = d - 1 + (c + ℓ) by omega]
  · simp only [cLfPush, Ex.size]
    have : (0 : ℕ) ≤ (B + 2) ^ 2 := Nat.zero_le _
    nlinarith

/-- **The pops** clear the leaf registers. -/
theorem lfPop_sp (s : IState HS) (v w : List ℤ) {a d c ℓ B : ℕ} (hd : 1 ≤ d)
    (hB : a + 2 * d + c + ℓ + 3 ≤ B) :
    Sp lfPop (encK s (Function.update (lfF v a d c ℓ) 0 w)) (encK s (o0 w)) (8 * (2 * B + 2)) := by
  have zP : ∀ k ≤ a + 2 * d + c + ℓ + 1, zsz (((2 ^ k : ℕ) : ℤ)) ≤ B := fun k hk =>
    zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) (by omega))
  have zS : ∀ k ≤ B, zsz ((k : ℕ) : ℤ) ≤ B := fun k hk => zsz_nat_le hk
  set G := Function.update (lfF v a d c ℓ) 0 w
  have P1 := Sp.pop s G (i := NLogN.KFV.yM) (a := ((d % 8 : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [G, lfF, Function.update_apply]) (zS _ (by omega))
  set G1 := Function.update G NLogN.KFV.yM []
  have P2 := Sp.pop s G1 (i := yN) (a := ((2 ^ (a + d + c + ℓ + 1) : ℕ) : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G1, G, lfF, Function.update_apply, vol_lf]) (zP _ (by omega))
  set G2 := Function.update G1 yN []
  have P3 := Sp.pop s G2 (i := NLogN.KFV.yW) (a := ((2 ^ dScale d : ℕ) : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [G2, G1, G, lfF, Function.update_apply]) (zP _ (by unfold dScale; omega))
  set G3 := Function.update G2 NLogN.KFV.yW []
  have P4 := Sp.pop s G3 (i := yQD) (a := ((2 ^ (d - 1 + (c + ℓ)) : ℕ) : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G3, G2, G1, G, lfF, Function.update_apply, ← pow_add])
    (zP _ (by omega))
  set G4 := Function.update G3 yQD []
  have P5 := Sp.pop s G4 (i := yG0) (a := ((2 ^ (a + (d - 1)) : ℕ) : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G4, G3, G2, G1, G, lfF, Function.update_apply, ← pow_add])
    (zP _ (by omega))
  set G5 := Function.update G4 yG0 []
  have P6 := Sp.pop s G5 (i := yQ) (a := ((2 ^ (c + ℓ) : ℕ) : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G5, G4, G3, G2, G1, G, lfF, Function.update_apply, ← pow_add])
    (zP _ (by omega))
  set G6 := Function.update G5 yQ []
  have P7 := Sp.pop s G6 (i := yD) (a := (d : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G6, G5, G4, G3, G2, G1, G, lfF, Function.update_apply])
    (zS _ (by omega))
  set G7 := Function.update G6 yD []
  have P8 := Sp.pop s G7 (i := NLogN.KFV.yP) (a := ((2 ^ a : ℕ) : ℤ)) (l := []) (B := B)
    (by decide) (by simp +decide [G7, G6, G5, G4, G3, G2, G1, G, lfF, Function.update_apply])
    (zP _ (by omega))
  refine ((P1.seq (P2.seq (P3.seq (P4.seq (P5.seq (P6.seq (P7.seq P8)))))))).congr ?_ |>.mono
    (by omega)
  congr 1
  funext j
  by_cases hj : j = 0
  · subst hj; simp +decide [G7, G6, G5, G4, G3, G2, G1, G, lfF, o0, Function.update_apply]
  · simp only [G7, G6, G5, G4, G3, G2, G1, G, lfF, o0, Function.update_apply, hj, if_false]
    split_ifs <;> rfl

/-- **The register leaf**: Proposition 14 with `K = 1` on `[2^a] × [2]^d × [2^c]`, all sizes
computed at run time. -/
theorem leafR_runs (s : IState HS) (zs : List GI) (l : List ℤ) {eP eD eS : Ex HS}
    {a d c ℓ p w B : ℕ} (rP : RG eP) (rD : RG eD) (rS : RG eS)
    (hP : EV (encK s (o0 (gflat zs ++ l))) B eP (a : ℤ))
    (hD : EV (encK s (o0 (gflat zs ++ l))) B eD (d : ℤ))
    (hS : EV (encK s (o0 (gflat zs ++ l))) B eS (c : ℤ))
    (hL : EV (encK s (o0 (gflat zs ++ l))) B (.reg gLl) (ℓ : ℤ))
    (hd : 1 ≤ d) (hB : a + 2 * d + c + ℓ + 3 ≤ B) {xs : List (Fin (2 ^ ℓ) → ℂ)}
    (hx : RecRep (2 ^ ℓ) p zs xs) (hl : xs.length = vol (Butterfly.layerShape (2 ^ a) 1 d (2 ^ c)))
    (hb : NLogN.KFB.GB w zs) (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', RecRep (2 ^ ℓ) p zs' (Butterfly.prop14Proc (P := 2 ^ a) (S := 2 ^ c) (K := 1)
        Nat.zero_lt_one p ((Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin d))) xs) ∧
      NLogN.KFB.GB (p + 1) zs' ∧
      IRuns I iprog (fcode (leafR eP eD eS)) (encK s (o0 (gflat zs ++ l)))
        (encK s (o0 (gflat zs' ++ l))) (cLeafR (eP.size + eD.size + eS.size) a d c ℓ w B) := by
  have R1 := FSp.irun (I := I) (iprog := iprog) (p := lfPush eP eD eS)
    (by simp [lfPush, fok]) (FSp.of_norep (by simp [lfPush, norep])
      (lfPush_sp s (gflat zs ++ l) rP rD rS hP hD hS hL hd hB))
  set F := lfF (gflat zs ++ l) a d c ℓ
  have hC : Cl F := by
    refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
      simp +decide [F, lfF, o0, Function.update_apply]
  have hK : KFree F := by
    refine ⟨?_, ?_, ?_, ?_⟩ <;> simp +decide [F, lfF, o0, Function.update_apply]
  have hR : NLogN.KFV.LRegs s F (2 ^ a) d (2 ^ c) (2 ^ ℓ) := by
    refine ⟨RV.of_list (l := []) ?_, RV.of_list (l := []) ?_, RV.of_list (l := []) ?_,
      RV.of_list (l := []) ?_, RV.of_list (l := []) ?_, RV.of_list (l := []) ?_,
      RV.of_list (l := []) ?_, RV.of_list (l := []) ?_⟩ <;>
      simp +decide [F, lfF, Function.update_apply]
  obtain ⟨zs', h1, h2, -, h4⟩ := leafU_iruns (I := I) (iprog := iprog) (P := 2 ^ a) (D := d)
    (S := 2 ^ c) (r := 2 ^ ℓ) (p := p) (w := w) hd Nat.one_le_two_pow Nat.one_le_two_pow
    Nat.one_le_two_pow s F zs l xs hx hl (by simp +decide [F, lfF, Function.update_apply]) hC hK
    (by simp +decide [F, lfF, o0, Function.update_apply]) hR hb hdisk
  have R3 := FSp.irun (I := I) (iprog := iprog) (p := lfPop) (by simp [lfPop, fok])
    (FSp.of_norep (by simp [lfPop, norep]) (lfPop_sp s (gflat zs ++ l) (gflat zs' ++ l) hd hB))
  refine ⟨zs', h1, h2, ?_⟩
  have R := R1.seq (h4.seq R3)
  simp only [cLeafR]
  exact R.mono' rfl (by omega)

end NLogN.KFV

