-- title:
--   Lemma 3.1 — basic properties of the IHT method with L > L(f): sufficient decrease, monotone values, ‖xᵏ − xᵏ⁺¹‖ → 0, strict decrease on moves
-- statement:
--   Let $f:\mathbb R^n\to\mathbb R$ be continuously differentiable and bounded below (Assumption 1), with gradient Lipschitz with constant $L(f)$ (Assumption 2), let $0<s<n$, and let $L>L(f)$. Let $(x^k)_{k\ge0}$ be any sequence generated by the IHT method with constant stepsize $1/L$, that is, $x^0\in C_s$ and $x^{k+1}\in P_{C_s}\big(x^k-\tfrac1L\nabla f(x^k)\big)$ for every $k$. Then:
--   1. for every $k$,
--   $$f(x^k)-f(x^{k+1})\ge\frac{L-L(f)}{2}\,\|x^k-x^{k+1}\|^2;$$
--   2. the sequence $(f(x^k))_{k\ge0}$ is nonincreasing;
--   3. $\|x^k-x^{k+1}\|\to0$ as $k\to\infty$;
--   4. for every $k=0,1,2,\dots$, if $x^k\neq x^{k+1}$ then $f(x^{k+1})<f(x^k)$.
--
--   These properties are the inputs of the convergence analysis: part 3 is what forces the whole sequence to converge for least squares (Theorem 3.2).
--
--   **Formalization Note** $L(f)$ is any constant `Lf : ℝ≥0` with `LipschitzWith Lf (gradient f)`. Part 3 uses Assumption 1, which is a hypothesis. A run is any sequence of selections from the set-valued projection.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), p. 15, Lemma 3.1

import Mathlib
import Definitions.Def_SparseNLO_IHT_Setting

open Filter Topology

namespace SparseNLO.IHT

/-- Lemma 3.1 (p. 15). Let `(x^k)` be generated by the IHT method with constant stepsize `1/L`,
where `L > L(f)` (Assumption 2 holds throughout §3.1; Assumption 1 throughout the paper). Then
1. `f(x^k) − f(x^{k+1}) ≥ (L − L(f))/2 · ‖x^k − x^{k+1}‖²`;
2. `(f(x^k))` is nonincreasing;
3. `‖x^k − x^{k+1}‖ → 0`;
4. for every `k`, if `x^k ≠ x^{k+1}` then `f(x^{k+1}) < f(x^k)`. -/
theorem lemma_3_1 {n s : ℕ} (hs : 0 < s) (hsn : s < n)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f) (hbdd : ∃ γ : ℝ, ∀ x, γ ≤ f x)
    (Lf : NNReal) (hLip : LipschitzWith Lf (gradient f)) (L : ℝ) (hL : (Lf : ℝ) < L)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsIHTRun f s L x) :
    (∀ k : ℕ, f (x k) - f (x (k + 1)) ≥ (L - Lf) / 2 * ‖x k - x (k + 1)‖ ^ 2) ∧
    Antitone (fun k => f (x k)) ∧
    Tendsto (fun k => ‖x k - x (k + 1)‖) atTop (𝓝 0) ∧
    (∀ k : ℕ, x k ≠ x (k + 1) → f (x (k + 1)) < f (x k)) := by sorry

end SparseNLO.IHT
