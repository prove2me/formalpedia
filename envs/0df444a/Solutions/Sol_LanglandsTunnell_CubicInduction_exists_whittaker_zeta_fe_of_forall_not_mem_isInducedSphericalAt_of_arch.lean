    (hnorm : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      TateGlobal.ideleNorm ℚ (uniformizerIdele ℚ v) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹)
    (hsum : Summable fun v : HeightOneSpectrum (𝓞 ℚ) => ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (-(3 : ℝ)))
    (s : ℂ) (hs : κ + τ₀ + 4 ≤ s.re)
    (hT : Integrable (fun a => W (iotaGL (diagUnitGL2 a) * g) * ((χ a : ℂˣ) : ℂ) *
        ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)) (NumberField.Idele.sPartMeasure ℚ T)) :
    Multipliable (fun v : {v : HeightOneSpectrum (𝓞 ℚ) // v ∉ T} =>
        ∑' m : ℤ, τ v.1 m * ((χ (uniformizerIdele ℚ v.1) ^ m : ℂˣ) : ℂ) *
          (((((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1)) ∧
