theorem NLogN.AX.ren_spec (π : Equiv.Perm (Fin HS)) (hπ : FixHi π) (P : RS) (st : IState HS) (T : Fin HS)
    (X : List Item) (C : ℕ)
    (h : P.ok (st.rn π⁻¹) ∧ P.run (st.rn π⁻¹) = (st.rn π⁻¹).upd T (X ++ (st.rn π⁻¹).G T) ∧
      P.cost (st.rn π⁻¹) ≤ C) :
    (RS.ren π P).ok st ∧ (RS.ren π P).run st = st.upd (π T) (X ++ st.G (π T)) ∧
      (RS.ren π P).cost st ≤ C := by sorry
