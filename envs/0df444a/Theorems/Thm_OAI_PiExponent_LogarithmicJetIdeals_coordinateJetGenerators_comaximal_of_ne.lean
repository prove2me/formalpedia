-- title:
--   Selected coordinate jet generators at distinct centers are comaximal
-- statement:
--   For any coordinate where the centers differ, the ideals generated by the corresponding powered jet generators are comaximal, including when the exponent is zero.
-- source:
--   https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/lean/OAI/NumberTheory/PiExponent/Approximation/AdmissibleMatrixGeometry.lean#L41-L44

import Definitions.Def_OAI_PiExponent_AdmissibleFormalInterpolation
import Definitions.Def_OAI_PiExponent_LogarithmicJetIdeals
import Mathlib.RingTheory.Ideal.Operations

open OAI.PiExponent
open OAI.PiExponent.AdmissibleFormalInterpolation
open OAI.PiExponent.LogarithmicJetIdeals

theorem OAI.PiExponent.LogarithmicJetIdeals.coordinateJetGenerators_comaximal_of_ne
    {m : ℕ} (c d : Fin m → ℂ) (T : Fin m → ℕ)
    (e : Fin (m + 1) → ℕ) (i : Fin m)
    (h : c i ≠ d i) :
    Ideal.span ({jetCoordinate c T i.succ ^ e i.succ} : Set (MvPolynomial (Fin (m + 1)) ℂ)) ⊔
      Ideal.span ({jetCoordinate d T i.succ ^ e i.succ} : Set (MvPolynomial (Fin (m + 1)) ℂ)) = ⊤ := by sorry
