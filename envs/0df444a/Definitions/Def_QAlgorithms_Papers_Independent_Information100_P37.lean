import Mathlib
import Definitions.Def_QAlgorithms_Defs_Channel
import Definitions.Def_QAlgorithms_Defs_Information
import Definitions.Def_QAlgorithms_Defs_GradientMethods
import Definitions.Def_QAlgorithms_Defs_TensorPermutationRepresentations

/-!
Statements from arXiv:2609.19046v1. All page references are PDF page numbers.
The arbitrary finite coordinate type represents the fixed reference basis. Tensor
products use ordered product coordinates; copy tensors use `Fin n → Fin d`.
The simplex law is constructed by the source's independent exponentials (p.15, E4).
Moments are actual integrals of squared Hilbert--Schmidt coherence, not trace formulas.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Information100.P37

open MeasureTheory ProbabilityTheory Filter
open scoped BigOperators Matrix ComplexConjugate Topology

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- PDF p.2, (3): the entire closed probability simplex in reference-basis coordinates. -/
def IsPopulation (p : ι → ℝ) : Prop := (∀ i, 0 ≤ p i) ∧ ∑ i, p i = 1

/-- PDF p.15, (E4): normalization of independent rate-one exponentials.
The zero-sum input is a null event; its total-function value is the center. -/
def normalizePopulation (z : ι → ℝ) : ι → ℝ :=
  if ∑ i, z i = 0 then fun _ => 1 / (Fintype.card ι : ℝ)
  else fun i => z i / ∑ j, z j

/-- PDF pp.2,15, (4),(E4): Dir(1,...,1), constructed without moment assumptions. -/
def simplexLaw (ι : Type*) [Fintype ι] : Measure (ι → ℝ) :=
  Measure.map normalizePopulation (Measure.pi fun _ : ι => expMeasure 1)

/-- PDF p.2, (1): the complementary off-diagonal projection. -/
def offDiagonal (M : Matrix ι ι ℂ) : Matrix ι ι ℂ := M - Matrix.diagonal (Matrix.diag M)

/-- PDF p.2, (2): squared Hilbert--Schmidt coherence, distinct from l1 coherence. -/
def coherence (M : Matrix ι ι ℂ) : ℝ :=
  ∑ i, ∑ j, if i = j then 0 else Complex.normSq (M i j)

/-- PDF p.2, (3): the diagonal input with population p. -/
def inputDensity (p : ι → ℝ) : Matrix ι ι ℂ := Matrix.diagonal fun i => (p i : ℂ)

/-- PDF p.3, (13): transition probabilities, computed from the matrix entries. -/
def transition (U : Matrix ι ι ℂ) : Matrix ι ι ℝ := fun i j => Complex.normSq (U i j)

/-- PDF p.3, (14): the computed unitary coherence response. -/
def response (U : Matrix ι ι ℂ) : Matrix ι ι ℝ := 1 - (transition U)ᵀ * transition U

/-- PDF p.2, (7): projector onto all zero-sum population modes. -/
def zeroSumProjector (ι : Type*) [Fintype ι] [DecidableEq ι] : Matrix ι ι ℝ :=
  1 - fun _ _ => 1 / (Fintype.card ι : ℝ)

/-- PDF p.2, (6): population displacement from the maximally mixed center. -/
def centered (p : ι → ℝ) : ι → ℝ := fun i => p i - 1 / (Fintype.card ι : ℝ)

/-- PDF p.3, (15): a real quadratic form, including matrices not arising from dynamics. -/
def quadratic (G : Matrix ι ι ℝ) (p : ι → ℝ) : ℝ := ∑ i, ∑ j, p i * G i j * p j

/-- PDF pp.2,9, (8),(75): actual coherence generated by a superoperator. -/
def generated (E : Superop ι ι) (p : ι → ℝ) : ℝ := coherence (E (inputDensity p))

/-- PDF pp.3,4, (9),(24),(25): actual kth moment under the simplex law. -/
def moment (E : Superop ι ι) (k : ℕ) : ℝ := ∫ p, (generated E p) ^ k ∂simplexLaw ι

/-- PDF p.3, (9): coherence-generating power is the first moment. -/
def cgp (E : Superop ι ι) : ℝ := moment E 1

/-- PDF p.3, (9): actual central second moment. -/
def coherenceVariance (E : Superop ι ι) : ℝ :=
  ∫ p, (generated E p - cgp E) ^ 2 ∂simplexLaw ι

/-- PDF p.3, (9): nonnegative standard deviation. -/
def cgpd (E : Superop ι ι) : ℝ := Real.sqrt (coherenceVariance E)

/-- PDF p.3, (11): the full coherence-generation law. -/
def coherenceLaw (E : Superop ι ι) : Measure ℝ := Measure.map (generated E) (simplexLaw ι)

/-- PDF p.3, (10): moment generating function. -/
def partition (E : Superop ι ι) (a : ℝ) : ℝ :=
  ∫ p, Real.exp (a * generated E p) ∂simplexLaw ι

/-- PDF p.3, (10): cumulant generating function. -/
def cumulant (E : Superop ι ι) (a : ℝ) : ℝ := Real.log (partition E a)

/-- PDF p.4, (23): fourth-order Dirichlet denominator. -/
def fourthDenominator (d : ℕ) : ℝ := (d : ℝ) * (d + 1) * (d + 2) * (d + 3)

/-- PDF p.4, (18): column inverse participation ratio. -/
def columnParticipation (U : Matrix ι ι ℂ) (j : ι) : ℝ := ∑ i, (transition U i j) ^ 2

/-- PDF p.4, (30): row inverse participation ratio. -/
def rowParticipation (U : Matrix ι ι ℂ) (i : ι) : ℝ := ∑ j, (transition U i j) ^ 2

/-- PDF p.4, (18): aggregate column participation. -/
def totalParticipation (U : Matrix ι ι ℂ) : ℝ := ∑ j, columnParticipation U j

/-- PDF p.4, (18): squared Frobenius norm on real population matrices. -/
def realFrobeniusSq (G : Matrix ι ι ℝ) : ℝ := ∑ i, ∑ j, (G i j) ^ 2

/-- PDF p.4, (19): squared Euclidean norm of the diagonal. -/
def diagonalSq (G : Matrix ι ι ℝ) : ℝ := ∑ i, (G i i) ^ 2

/-- PDF p.5, before (35): dimensional fluctuation factor, used only for d>=2. -/
def gammaFactor (d : ℕ) : ℝ :=
  2 * d / Real.sqrt (((d : ℝ) - 1) * (d + 2) * (d + 3))

/-- PDF p.5, (35): the traceless anisotropic response; card>=2 in its results. -/
def anisotropy (G : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  G - (G.trace / ((Fintype.card ι : ℝ) - 1)) • zeroSumProjector ι

/-- PDF p.5, (37): excess fluctuation, defined from the anisotropic response. -/
def excess (G : Matrix ι ι ℝ) : ℝ :=
  Real.sqrt ((2 * realFrobeniusSq (anisotropy G) + 6 * diagonalSq (anisotropy G)) /
    fourthDenominator (Fintype.card ι))

/-- PDF p.6, (42): normalized selectivity, used only with positive mean and card>=2. -/
def selectivity (E : Superop ι ι) : ℝ := cgpd E / (gammaFactor (Fintype.card ι) * cgp E)

/-- PDF p.5: a monomial unitary permutes basis states and attaches unit-modulus phases. -/
def IsIncoherent (U : Matrix ι ι ℂ) : Prop :=
  ∃ (s : Equiv.Perm ι) (z : ι → ℂ), (∀ j, Complex.normSq (z j) = 1) ∧
    ∀ i j, U i j = if i = s j then z j else 0

/-- PDF p.6: a complex Hadamard unitary has flat transition probabilities. -/
def IsFlat (U : Matrix ι ι ℂ) : Prop :=
  ∀ i j, transition U i j = 1 / (Fintype.card ι : ℝ)

/-- PDF p.5, (34): generated coherence in basis {V|i>}, expressed in ambient coordinates. -/
def generatedInBasis (V U : Matrix ι ι ℂ) (p : ι → ℝ) : ℝ :=
  coherence (Vᴴ * (U * (V * inputDensity p * Vᴴ) * Uᴴ) * V)

/-- PDF p.5, (34): mean in the rotated reference basis. -/
def cgpInBasis (V U : Matrix ι ι ℂ) : ℝ := ∫ p, generatedInBasis V U p ∂simplexLaw ι

/-- PDF p.5, (34): deviation in the rotated reference basis. -/
def cgpdInBasis (V U : Matrix ι ι ℂ) : ℝ :=
  Real.sqrt (∫ p, (generatedInBasis V U p - cgpInBasis V U) ^ 2 ∂simplexLaw ι)

/-- PDF p.4, (20): integrated n-copy moment state; entrywise finite-dimensional integral. -/
def momentState (d n : ℕ) : Matrix (Fin n → Fin d) (Fin n → Fin d) ℂ :=
  fun a b => ∫ p, piKron n (inputDensity p) a b ∂simplexLaw (Fin d)

/-- PDF p.4, (21): rising factorial, including its standard empty-product convention. -/
def risingDimension (d n : ℕ) : ℝ := ∏ k : Fin n, ((d : ℝ) + k.val)

/-- PDF p.5, (32): the explicit forward/inverse witness, with source row ordering. -/
def inverseWitness : Matrix (Fin 4) (Fin 4) ℂ :=
  (1 / 2 : ℂ) • !![1, -1, 0, (Real.sqrt 2 : ℂ);
    1, 1, (Real.sqrt 2 : ℂ), 0; -1, -1, (Real.sqrt 2 : ℂ), 0;
    -1, 1, 0, (Real.sqrt 2 : ℂ)]

/-- PDF p.10, (82): two ordered 2-by-2 blocks on Fin 4, first block first. -/
def blockPair {R : Type*} [Zero R] (A B : Matrix (Fin 2) (Fin 2) R) :
    Matrix (Fin 4) (Fin 4) R :=
  fun i j => if hi : i.val < 2 then
    if hj : j.val < 2 then A ⟨i.val, hi⟩ ⟨j.val, hj⟩ else 0
  else if hj : j.val < 2 then 0 else
    B ⟨i.val - 2, by omega⟩ ⟨j.val - 2, by omega⟩

/-- PDF p.10, (82): localized two-level response embedded in dimension four. -/
def localized : Matrix (Fin 4) (Fin 4) ℂ := blockPair
    ((rotY (2 * (Real.pi / 4))).submatrix
      (fun i : Fin 2 => i.val == 1) (fun j : Fin 2 => j.val == 1)) 1

/-- PDF p.10, (82): distributed pair of two-level responses. -/
def distributed : Matrix (Fin 4) (Fin 4) ℂ :=
  blockPair
    ((rotY (2 * (Real.pi / 8))).submatrix
      (fun i : Fin 2 => i.val == 1) (fun j : Fin 2 => j.val == 1))
    ((rotY (2 * (Real.pi / 8))).submatrix
      (fun i : Fin 2 => i.val == 1) (fun j : Fin 2 => j.val == 1))

/-- PDF p.14, (D1): uniform population projector. -/
def uniformProjector (d : ℕ) : Matrix (Fin d) (Fin d) ℝ := fun _ _ => 1 / (d : ℝ)

/-- PDF p.10, (87): complete graph adjacency in vertex coordinates. -/
def completeAdjacency (d : ℕ) : Matrix (Fin d) (Fin d) ℂ :=
  fun i j => if i = j then 0 else 1

/-- PDF p.10, (87): star adjacency, with vertex 0 the hub. -/
def starAdjacency (d : ℕ) : Matrix (Fin d) (Fin d) ℂ :=
  fun i j => if (i.val = 0 ∧ j.val ≠ 0) ∨ (j.val = 0 ∧ i.val ≠ 0) then 1 else 0

/-- PDF p.10, (87): spectral normalization, using the frozen operator norm. -/
def walk (A : Matrix ι ι ℂ) (t : ℝ) : Matrix ι ι ℂ :=
  NormedSpace.exp ((-Complex.I * (t : ℂ)) • ((specNorm A)⁻¹ • A))

/-- PDF p.14, (D5): zero hub block plus the leaf zero-sum projector. -/
def leafProjector (d : ℕ) : Matrix (Fin d) (Fin d) ℝ :=
  fun i j => if i.val = 0 ∨ j.val = 0 then 0 else
    (if i = j then 1 else 0) - 1 / ((d : ℝ) - 1)

/-- PDF p.14, (D3): normalized uniform leaf state (used with d>=2). -/
def leafState (d : ℕ) : Fin d → ℂ :=
  fun i => if i.val = 0 then 0 else (Real.sqrt ((d : ℝ) - 1))⁻¹

/-- PDF p.8, (62): exactly observed empirical coherence mean. -/
def empiricalMean (E : Superop ι ι) {N : ℕ} (p : Fin N → (ι → ℝ)) : ℝ :=
  (∑ i, generated E (p i)) / (N : ℝ)

/-- PDF p.8, (65): unbiased sample variance; results use N>=2. -/
def sampleVariance (E : Superop ι ι) {N : ℕ} (p : Fin N → (ι → ℝ)) : ℝ :=
  (∑ i, (generated E (p i) - empiricalMean E p) ^ 2) / ((N : ℝ) - 1)

/-- PDF p.8, (66): fourth central moment. -/
def fourthCentral (E : Superop ι ι) : ℝ :=
  ∫ p, (generated E p - cgp E) ^ 4 ∂simplexLaw ι

/-- PDF p.8, (66): canonical independent N-sample law. -/
def sampleLaw (ι : Type*) [Fintype ι] (N : ℕ) : Measure (Fin N → (ι → ℝ)) :=
  Measure.pi fun _ => simplexLaw ι

/-- PDF p.8, (66): weak convergence of laws, tested on bounded continuous real functions.
This permits varying finite sample spaces and a zero-variance Dirac Gaussian. -/
def LawsConverge (laws : ℕ → Measure ℝ) (limit : Measure ℝ) : Prop :=
  ∀ f : BoundedContinuousFunction ℝ ℝ, Tendsto (fun N => ∫ x, f x ∂laws N) atTop (nhds (∫ x, f x ∂limit))

/-- PDF p.8, (67): normalized exponential tilt, not an unnormalized weighted average. -/
def tiltedLaw (E : Superop ι ι) (a : ℝ) : Measure (ι → ℝ) :=
  (simplexLaw ι).withDensity fun p => ENNReal.ofReal (Real.exp (a * generated E p) / partition E a)

/-- PDF p.8, (68): mean under the normalized tilted probability law. -/
def tiltedMean (E : Superop ι ι) (a : ℝ) : ℝ := ∫ p, generated E p ∂tiltedLaw E a

/-- PDF p.8, (70): swap minus its dephasing, on two ordered copies. -/
def coherenceObservable (ι : Type*) [DecidableEq ι] : Matrix (ι × ι) (ι × ι) ℂ :=
  fun a b => (if a.1 = b.2 ∧ a.2 = b.1 then 1 else 0) -
    (if a = b ∧ a.1 = a.2 then 1 else 0)

/-- PDF p.8, (72): K on copies (0,1) times K on copies (2,3). -/
def fourCopyObservable (d : ℕ) : Matrix (Fin 4 → Fin d) (Fin 4 → Fin d) ℂ :=
  fun a b => coherenceObservable (Fin d) (a 0, a 1) (b 0, b 1) *
    coherenceObservable (Fin d) (a 2, a 3) (b 2, b 3)

/-- PDF p.9, (73): coherent output from the ith basis projector. -/
def channelOutput (E : Superop ι ι) (i : ι) : Matrix ι ι ℂ :=
  offDiagonal (E (Matrix.single i i 1))

/-- PDF p.9, (74): real channel Gram matrix; no unitary response formula is assumed. -/
def channelResponse (E : Superop ι ι) : Matrix ι ι ℝ :=
  fun i j => ((channelOutput E i * channelOutput E j).trace).re

/-- PDF p.9, (78): coherent offset at the center for general CPTP maps. -/
def channelOffset (E : Superop ι ι) : Matrix ι ι ℂ :=
  (1 / (Fintype.card ι : ℂ)) • ∑ i, channelOutput E i

/-! Sanity examples pin definitions without assuming any claimed moment identity. -/

example : normalizePopulation (fun _ : Fin 1 => (0 : ℝ)) = fun _ => 1 := by
  ext i
  simp [normalizePopulation]

example (p : ι → ℝ) (i : ι) : inputDensity p i i = (p i : ℂ) := by
  simp [inputDensity]

example : coherence (1 : Matrix (Fin 1) (Fin 1) ℂ) = 0 := by
  simp [coherence]

example : response (1 : Matrix (Fin 1) (Fin 1) ℂ) = 0 := by
  ext i j
  fin_cases i
  fin_cases j
  simp [response, transition, Matrix.mul_apply]

example (G : Matrix ι ι ℝ) : quadratic G (fun _ => 0) = 0 := by
  simp [quadratic]

example : fourthDenominator 4 = 840 := by norm_num [fourthDenominator]

example : risingDimension 3 0 = 1 := by simp [risingDimension]

example (t : ℝ) : ((rotY (2 * t)).submatrix (fun i : Fin 2 => i.val == 1) (fun j : Fin 2 => j.val == 1)) 0 1 = -(Real.sin ((2 * t) / 2) : ℂ) := by
  rfl

example : blockPair (0 : Matrix (Fin 2) (Fin 2) ℝ) 1 2 2 = 1 := by
  norm_num [blockPair]

example : starAdjacency 3 0 1 = 1 ∧ starAdjacency 3 1 2 = 0 := by
  norm_num [starAdjacency]

example : coherenceObservable (Fin 2) (0, 1) (1, 0) = 1 := by
  norm_num [coherenceObservable]

example (E : Superop ι ι) : channelResponse E =
    fun i j => ((channelOutput E i * channelOutput E j).trace).re := rfl

/-! Theorem statements. Every claim is unproved in this drafting stage. -/

end QAlgorithms.Papers.Independent.Information100.P37


