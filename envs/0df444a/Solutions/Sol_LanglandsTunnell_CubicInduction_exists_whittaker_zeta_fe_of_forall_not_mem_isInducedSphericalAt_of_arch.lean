variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private theorem norm_inducedE3_inducedCoeff_eq_one_of_not_isBadPlace (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (hdeg : Module.finrank ℚ K = 3) (hμu : IsUnitaryChar (𝓞 K) K μ) (v : HeightOneSpectrum (𝓞 ℚ))
    (hv : ¬ IsBadPlace K μ v) : ‖inducedE3 ℚ (inducedCoeff K μ) v‖ = 1 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  rw [TwistFibre.inducedE3_eq (K := K) (hdeg := hdeg) (v := v)
      (he := BadPlaceBridges.ramificationIdx_eq_one_of_not_isBadPlace K μ v hv) (c := inducedCoeff K μ),
    norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul, norm_prod]
  refine Finset.prod_eq_one fun 𝔓 h𝔓 => ?_
  have hur : IsUnramifiedCharAt μ 𝔓 :=
    BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hv 𝔓
      ((FibreDegree.primeFibre_finite K v).mem_toFinset.mp h𝔓)
  rw [inducedCoeff, if_pos hur]
  exact hμu _

end LanglandsTunnell.CubicInduction.InducedE3Unitary
