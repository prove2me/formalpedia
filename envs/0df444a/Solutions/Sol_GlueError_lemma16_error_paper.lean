    change -(cexp ℓ a * ((fq a s x + (β : ℕ) * 2 ^ s : ℕ) : ℤ) * (c : ℤ)) =
      -(cexp ℓ a * (fq a s x : ℕ) * (c : ℕ)) + -((2 ^ (ℓ - h) * (β : ℕ) * κ : ℕ) : ℤ) +
        ((2 ^ ℓ : ℕ) : ℤ) * (-((β : ℕ) * (γ : ℕ) : ℤ)) +
        2 * ((2 ^ ℓ : ℕ) : ℤ) * (-((β : ℕ) * (c / 2 ^ (h + 1) : ℕ) : ℤ))
    generalize c / 2 ^ (h + 1) = q at hc' ⊢
    push_cast at hc' ⊢
    linear_combination (-((β : ℕ) : ℤ) * (c : ℤ)) * hC +
      (((β : ℕ) : ℤ) * ((γ : ℕ) : ℤ) + 2 * ((β : ℕ) : ℤ) * (q : ℤ)) * hℓ -
      (((β : ℕ) : ℤ) * 2 ^ (ℓ - h)) * hc'
  rw [fq_succ, ← hh, hexp, yp_add, yp_add, yp_add, yp_two_r_mul y hy, yp_r_mul y hy, H0_apply]
  generalize yp y (twE ℓ h x) = T
  clear_value β γ
  fin_cases β <;> fin_cases γ <;> simp [smul_smul, pow_succ, Y] <;> ring_nf <;>
    simp [mul_comm, smul_smul] <;> ring_nf <;>
    first | done | (rw [← neg_smul]; congr 1; ring)

lemma Ws_zero (ℓ a x c : ℕ) : Ws y ℓ a 0 x c = if c % 2 ^ a = x % 2 ^ a then 1 else 0 := by
  simp [Ws, fq]

lemma Ws_full (ℓ a x c : ℕ) :
    Ws y ℓ a a x c = algebraMap ℂ R ((2 : ℂ) ^ a)⁻¹ * yp y (-(cexp ℓ a * Synth.rev a x * c)) := by
  simp [Ws, Synth.rev, Nat.mod_one, Algebra.smul_def]

/-- One level applied to a partial transform gives the next partial transform. -/
theorem lev_kop {ℓ a s : ℕ} (hy : y ^ (2 ^ ℓ) = -1) (ha : a ≤ ℓ + 1) (hs : s < a)
    (g : ℕ → R) (x : ℕ) :
    lev y ℓ (a - 1 - s) (kop (2 ^ a) (Ws y ℓ a s) g) x = kop (2 ^ a) (Ws y ℓ a (s + 1)) g x := by
  unfold lev kop
  simp_rw [← levCore y hy ha hs x]
  simp only [smul_sum]
  rw [sum_comm, mul_sum]
  apply sum_congr rfl; intro c _
  rw [mul_assoc, sum_mul]; congr 1
  apply sum_congr rfl; intro b _
  rw [smul_mul_assoc]

variable {D : ℕ}

theorem axisL_axisK_same {ℓ a s : ℕ} (hy : y ^ (2 ^ ℓ) = -1) (ha : a ≤ ℓ + 1) (hs : s < a)
    (i : Fin D) (z : Synth.Arr R D) :
    axisL y ℓ i (a - 1 - s) (axisK i (2 ^ a) (Ws y ℓ a s) z) =
      axisK i (2 ^ a) (Ws y ℓ a (s + 1)) z := by
  funext x
  have := lev_kop y hy ha hs (fun c => z (Function.update x i c)) (x i)
  unfold kop at this
  unfold axisL axisK
  rw [← this]
  congr 1; funext c
  simp [Function.update_idem]

theorem axisL_axisK_comm (ℓ : ℕ) {i j : Fin D} (hij : i ≠ j) (h t : ℕ) (W : ℕ → ℕ → R)
    (z : Synth.Arr R D) :
    axisL y ℓ i h (axisK j t W z) = axisK j t W (axisL y ℓ i h z) := by
  funext x
  unfold axisL axisK lev
  simp only [Function.update_of_ne hij.symm, Function.update_of_ne hij, Function.update_self]
  simp_rw [smul_sum, mul_sum]
  rw [sum_comm]
  apply sum_congr rfl; intro c _
  apply sum_congr rfl; intro b _
  rw [Function.update_comm hij]
  simp only [mul_smul_comm, smul_mul_assoc]
  ring_nf

lemma foldr_congr_mem {α : Type*} (K K' : Fin D → α → α) :
    ∀ (l : List (Fin D)), (∀ j ∈ l, K' j = K j) → ∀ z,
      l.foldr (fun j acc => K j acc) z = l.foldr (fun j acc => K' j acc) z
  | [], _, _ => rfl
  | j :: l, h, z => by
    simp only [List.foldr_cons]
    rw [h j (by simp), foldr_congr_mem K K' l (fun k hk => h k (by simp [hk])) z]

/-- Pushing an operator through a product of axis operators. -/
lemma foldr_push {α : Type*} (op : α → α) (K K' : Fin D → α → α) (i : Fin D)
    (hcomm : ∀ j, j ≠ i → ∀ z, op (K j z) = K j (op z)) (hii : ∀ z, op (K i z) = K' i z)
    (hK : ∀ j, j ≠ i → K' j = K j) :
    ∀ (l : List (Fin D)), l.Nodup → i ∈ l → ∀ z,
      op (l.foldr (fun j acc => K j acc) z) = l.foldr (fun j acc => K' j acc) z
  | [], _, hi, _ => by simp at hi
  | j :: l, hnd, hi, z => by
    simp only [List.foldr_cons]
    by_cases hji : j = i
    · subst hji
      have hnot : j ∉ l := (List.nodup_cons.1 hnd).1
      rw [hii, foldr_congr_mem K K' l (fun k hk => hK k (fun e => hnot (e ▸ hk))) z]
    · have hil : i ∈ l := by
        rcases List.mem_cons.1 hi with h | h
        · exact absurd h.symm hji
        · exact h
      rw [hcomm j hji, foldr_push op K K' i hcomm hii hK l (List.nodup_cons.1 hnd).2 hil z, hK j hji]

/-- A level on axis `i` at slot `a_i - 1 - s_i` advances that axis by one level. -/
theorem axisL_State {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) {a s : Fin D → ℕ} (ha : ∀ i, a i ≤ ℓ + 1)
    {i : Fin D} (hs : s i < a i) (z : Synth.Arr R D) :
    axisL y ℓ i (a i - 1 - s i) (State y ℓ a s z) =
      State y ℓ a (Function.update s i (s i + 1)) z := by
  unfold State
  apply foldr_push _ (fun j acc => axisK j (2 ^ a j) (Ws y ℓ (a j) (s j)) acc)
    (fun j acc => axisK j (2 ^ a j) (Ws y ℓ (a j) (Function.update s i (s i + 1) j)) acc) i
  · intro j hj z; exact axisL_axisK_comm y ℓ (Ne.symm hj) _ _ _ z
  · intro z; simp only [Function.update_self]; exact axisL_axisK_same y hy (ha i) hs i z
  · intro j hj; simp [Function.update_of_ne hj]
  · exact List.nodup_finRange D
  · exact List.mem_finRange i

lemma range_succ_reverse (n : ℕ) : (List.range (n + 1)).reverse = n :: (List.range n).reverse := by
  simp [List.range_succ]

theorem runF_State {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) {a : Fin D → ℕ} (ha : ∀ i, a i ≤ ℓ + 1)
    (z : Synth.Arr R D) :
    ∀ (l : List (Fin D × ℕ)) (s : Fin D → ℕ), (∀ j, s j ≤ a j) → SchedOK a s l →
      runF y ℓ l (State y ℓ a s z) = State y ℓ a a z
  | [], s, hsa, hok => by
    have : s = a := by
      funext j; have := hok j; simp only [List.filter_nil, List.map_nil] at this
      have h2 := congrArg List.length this; simp at h2; have := hsa j; omega
    subst this; rfl
  | (i, h) :: l, s, hsa, hok => by
    have hi := hok i
    simp only [List.filter_cons, decide_true, if_true, List.map_cons] at hi
    have hpos : s i < a i := by
      by_contra hc; rw [show a i - s i = 0 by omega] at hi; simp at hi
    rw [show a i - s i = (a i - s i - 1) + 1 by omega, range_succ_reverse] at hi
    obtain ⟨rfl, hrest⟩ := List.cons.inj hi
    simp only [runF]
    rw [show a i - s i - 1 = a i - 1 - s i by omega, axisL_State y hy ha hpos]
    apply runF_State hy ha z l
    · intro j; by_cases hj : j = i
      · subst hj; simp; omega
      · simp [Function.update_of_ne hj, hsa j]
    · intro j
      by_cases hj : j = i
      · subst hj; simp only [Function.update_self]
        rw [show a j - (s j + 1) = a j - s j - 1 by omega]; exact hrest
      · have := hok j
        simp only [List.filter_cons] at this
        rw [if_neg (by simp; exact Ne.symm hj)] at this
        rw [Function.update_of_ne hj]; exact this

end Synth

end

section
-- Source module: Solutions.SynthSched
set_option linter.unusedSectionVars false

namespace Synth

open Finset Butterfly

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

lemma pbox_cons (t : Fin D → ℕ) {i : Fin D} {l : List (Fin D)} (hi : i ∉ l) (x : Fin D → ℕ) :
    pbox t (i :: l) x = (range (t i)).biUnion fun c => pbox t l (Function.update x i c) := by
  ext m
  simp only [pbox, mem_biUnion, Fintype.mem_piFinset]
  have hii : i ∈ i :: l := by simp
  constructor
  · intro hm
    have hmi : m i < t i := by have := hm i; rwa [if_pos hii, mem_range] at this
    refine ⟨m i, mem_range.2 hmi, fun j => ?_⟩
    by_cases hj : j = i
    · subst hj; rw [if_neg hi, Function.update_self]; exact mem_singleton_self _
    · have := hm j
      by_cases hjl : j ∈ l
      · rw [if_pos (List.mem_cons_of_mem _ hjl)] at this; rw [if_pos hjl]; exact this
      · rw [if_neg (by simp [hj, hjl])] at this
        rw [if_neg hjl, Function.update_of_ne hj]; exact this
  · rintro ⟨c, hc, hm⟩ j
    by_cases hj : j = i
    · subst hj; have := hm j; rw [if_neg hi, Function.update_self, mem_singleton] at this
      rw [if_pos hii, this]; exact hc
    · have := hm j
      by_cases hjl : j ∈ l
      · rw [if_pos hjl] at this; rw [if_pos (List.mem_cons_of_mem _ hjl)]; exact this
      · rw [if_neg hjl, Function.update_of_ne hj] at this
        rw [if_neg (by simp [hj, hjl])]; exact this

lemma pbox_disjoint (t : Fin D → ℕ) {i : Fin D} {l : List (Fin D)} (hi : i ∉ l) (x : Fin D → ℕ) :
    ((range (t i) : Set ℕ)).PairwiseDisjoint fun c => pbox t l (Function.update x i c) := by
  intro c _ c' _ hcc'
  rw [Function.onFun, Finset.disjoint_left]
  intro m hm hm'
  simp only [pbox, Fintype.mem_piFinset] at hm hm'
  have h1 := hm i; have h2 := hm' i
  simp [hi] at h1 h2
  exact hcc' (h1.symm.trans h2)

/-- **Separable kernels.** A product of axis kernels over distinct axes is the kernel
`∏_{i ∈ l} W_i(x_i, m_i)` over the partial box. -/
theorem foldr_axisK_eq (t : Fin D → ℕ) (W : Fin D → ℕ → ℕ → R) (z : Synth.Arr R D) :
    ∀ (l : List (Fin D)), l.Nodup → ∀ x : Fin D → ℕ,
      l.foldr (fun i acc => axisK i (t i) (W i) acc) z x =
        ∑ m ∈ pbox t l x, (∏ i ∈ l.toFinset, W i (x i) (m i)) * z m
  | [], _, x => by
    have : pbox t [] x = {x} := by
      ext m; simp only [pbox, List.not_mem_nil, if_false, Fintype.mem_piFinset, mem_singleton]
      exact ⟨fun h => funext h, fun h j => by rw [h]⟩
    simp [this]
  | i :: l, hnd, x => by
    have hi : i ∉ l := (List.nodup_cons.1 hnd).1
    show ∑ c ∈ range (t i), W i (x i) c *
      (l.foldr (fun i acc => axisK i (t i) (W i) acc) z) (Function.update x i c) = _
    simp_rw [foldr_axisK_eq t W z l (List.nodup_cons.1 hnd).2]
    rw [pbox_cons t hi, sum_biUnion (pbox_disjoint t hi x)]
    apply sum_congr rfl; intro c _
    rw [mul_sum]
    apply sum_congr rfl; intro m hm
    have hmi : m i = c := by
      simp only [pbox, Fintype.mem_piFinset] at hm
      have := hm i; simp [hi] at this; exact this
    have hprod : ∏ k ∈ l.toFinset, W k (Function.update x i c k) (m k) =
        ∏ k ∈ l.toFinset, W k (x k) (m k) := by
      apply prod_congr rfl; intro k hk
      have : k ≠ i := fun e => hi (e ▸ List.mem_toFinset.1 hk)
      rw [Function.update_of_ne this]
    rw [hprod, List.toFinset_cons, prod_insert (by simpa using hi), hmi]; ring

lemma pbox_finRange (t : Fin D → ℕ) (x : Fin D → ℕ) :
    pbox t (List.finRange D) x = Fintype.piFinset fun j => range (t j) := by
  simp [pbox]

/-- Before any level the state is the input, on the box. -/
theorem State_zero (ℓ : ℕ) (a : Fin D → ℕ) (z : Synth.Arr R D) {x : Fin D → ℕ} (hx : x ∈ box a) :
    State y ℓ a 0 z x = z x := by
  unfold State
  rw [foldr_axisK_eq (fun i => 2 ^ a i) (fun i => Ws y ℓ (a i) ((0 : Fin D → ℕ) i)) z _
    (List.nodup_finRange D), pbox_finRange]
  simp only [Pi.zero_apply, Ws_zero]
  rw [mem_box] at hx
  rw [sum_eq_single x]
  · simp [Nat.mod_eq_of_lt (hx _)]
  · intro m hm hmx
    obtain ⟨i, hi⟩ : ∃ i, m i ≠ x i := by
      by_contra h; push Not at h; exact hmx (funext h)
    rw [prod_eq_zero (i := i) (by simp)]
    · simp
    · simp only [Fintype.mem_piFinset, mem_range] at hm
      rw [if_neg]; rw [Nat.mod_eq_of_lt (hm i), Nat.mod_eq_of_lt (hx i)]; exact hi
  · intro h; exact absurd (by simpa [Fintype.mem_piFinset] using hx) h

/-- After all levels the state is `F^-` read at the bit-reversed address (any `x`). -/
theorem State_full (ℓ : ℕ) (a : Fin D → ℕ) (z : Synth.Arr R D) (x : Fin D → ℕ) :
    State y ℓ a a z x = Fm y ℓ a z (revV a x) := by
  unfold State Fm
  rw [foldr_axisK_eq (fun i => 2 ^ a i) (fun i => Ws y ℓ (a i) (a i)) z _ (List.nodup_finRange D),
    pbox_finRange]
  simp only [Ws_full, List.toFinset_finRange]
  rw [Algebra.smul_def, mul_sum]
  apply sum_congr rfl; intro m _
  rw [prod_mul_distrib, ← map_prod, ← mul_assoc]
  congr 2
  · simp [Mv, prod_inv_distrib]
  · rw [← yp_sum]; congr 1
    simp only [pair, revV, ← sum_neg_distrib]

lemma update_mem_box {a : Fin D → ℕ} {x : Fin D → ℕ} (hx : x ∈ box a) {i : Fin D} {c : ℕ}
    (hc : c < 2 ^ a i) : Function.update x i c ∈ box a := by
  rw [mem_box] at hx ⊢; intro j
  by_cases hj : j = i
  · subst hj; simpa
  · rw [Function.update_of_ne hj]; exact hx j

lemma axisL_eqOn (ℓ : ℕ) {a : Fin D → ℕ} {i : Fin D} {h : ℕ} (hh : h < a i) {z z' : Synth.Arr R D}
    (hzz : EqOn a z z') : EqOn a (axisL y ℓ i h z) (axisL y ℓ i h z') := by
  intro x hx
  unfold axisL lev
  congr 1; apply sum_congr rfl; intro b _
  dsimp only
  rw [hzz _ (update_mem_box hx (setBit_lt hh ((mem_box.1 hx) i) b))]

lemma runF_eqOn (ℓ : ℕ) {a : Fin D → ℕ} :
    ∀ (l : List (Fin D × ℕ)), (∀ st ∈ l, st.2 < a st.1) → ∀ {z z' : Synth.Arr R D},
      EqOn a z z' → EqOn a (runF y ℓ l z) (runF y ℓ l z')
  | [], _, _, _, h => h
  | st :: l, hl, _, _, h => by
    simp only [runF]
    exact runF_eqOn ℓ l (fun s hs => hl s (by simp [hs]))
      (axisL_eqOn y ℓ (hl st (by simp)) h)

lemma SchedOK.slot_lt {a s : Fin D → ℕ} {l : List (Fin D × ℕ)} (hok : SchedOK a s l) :
    ∀ st ∈ l, st.2 < a st.1 := by
  intro st hst
  have h := hok st.1
  have : st.2 ∈ (List.filter (fun st' => decide (st'.1 = st.1)) l).map Prod.snd :=
    List.mem_map.2 ⟨st, List.mem_filter.2 ⟨hst, by simp⟩, rfl⟩
  rw [h] at this; simp at this; omega

/-- **(28), forward procedure.** For every schedule that runs the slots of every axis from
high to low (in any interleaving), the result at address `x` of the box is the normalized
transform `F^-` at frequency `rev x`: the procedure implements `B F^-`, with the frequency-`j`
entry stored at `rev j`. -/
theorem synth_forward {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) {a : Fin D → ℕ} (ha : ∀ i, a i ≤ ℓ + 1)
    {l : List (Fin D × ℕ)} (hl : SchedOK a 0 l) (z : Synth.Arr R D) {x : Fin D → ℕ}
    (hx : x ∈ box a) :
    runF y ℓ l z x = Fm y ℓ a z (revV a x) := by
  rw [runF_eqOn y ℓ l hl.slot_lt (fun x hx => (State_zero y ℓ a z hx).symm) x hx,
    runF_State y hy ha z l 0 (fun _ => Nat.zero_le _) hl, State_full]

lemma range_filter_lt {n ℓ : ℕ} (hn : n ≤ ℓ) : (List.range ℓ).filter (fun h => h < n) = List.range n := by
  induction ℓ with
  | zero => simp at hn; subst hn; rfl
  | succ ℓ ih =>
    rw [List.range_succ, List.filter_append]
    by_cases h : n = ℓ + 1
    · subst h
      rw [List.filter_eq_self.2 (fun x hx => by simp at hx ⊢; omega)]
      simp [List.range_succ]
    · rw [ih (by omega)]; simp; omega

end Synth

end

section
-- Source module: Solutions.SynthList
set_option linter.unusedSectionVars false

namespace Synth

open Finset Butterfly AModel

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

lemma axisL_eq_twid_bfly (ℓ h : ℕ) (i : Fin D) (z : Synth.Arr R D) :
    axisL y ℓ i h z = twid y ℓ h i (bfly h i z) := rfl

lemma bfly_twidAll_comm (ℓ h : ℕ) {i : Fin D} {l : List (Fin D)} (hi : i ∉ l) (z : Synth.Arr R D) :
    bfly h i (twidAll y ℓ h l z) = twidAll y ℓ h l (bfly h i z) := by
  funext x
  unfold twidAll bfly
  have : ∀ b : Fin 2, (l.map fun j => twE ℓ h (Function.update x i (setBit h (x i) b) j)) =
      l.map fun j => twE ℓ h (x j) := by
    intro b; apply List.map_congr_left; intro j hj
    rw [Function.update_of_ne (fun (e : j = i) => hi (e ▸ hj))]
  simp only [this, mul_sum, mul_smul_comm]

/-- The twiddles of different axes can be collected after all butterflies of the round. -/
theorem foldr_twid_bfly (ℓ h : ℕ) (z : Synth.Arr R D) :
    ∀ l : List (Fin D), l.Nodup →
      l.foldr (fun i acc => twid y ℓ h i (bfly h i acc)) z =
        twidAll y ℓ h l (l.foldr (fun i acc => bfly h i acc) z)
  | [], _ => by funext x; simp [twidAll]
  | i :: l, hnd => by
    have hi : i ∉ l := (List.nodup_cons.1 hnd).1
    simp only [List.foldr_cons]
    rw [foldr_twid_bfly ℓ h z l (List.nodup_cons.1 hnd).2, bfly_twidAll_comm y ℓ h hi]
    funext x; simp only [twid, twidAll, List.map_cons, List.sum_cons, yp_add]; ring

variable {sh : Shape} {a : Fin D → ℕ}

variable (L : CoordLayout sh a)

lemma bfly_eqOn {h : ℕ} {i : Fin D} (hh : h < a i) {z z' : Synth.Arr R D} (hzz : EqOn a z z') :
    EqOn a (bfly h i z) (bfly h i z') := by
  intro x hx; unfold bfly
  apply sum_congr rfl; intro b _
  rw [hzz _ (update_mem_box hx (setBit_lt hh ((mem_box.1 hx) i) b))]

/-- An individual selected-bit kernel of the layer is the axis butterfly. -/
theorem fn_kernel {h : ℕ} {P : Finset (Fin D)} {Sb : SelBits sh {i // i ∈ P}}
    (hc : SelCompat L h P Sb) (i : {i // i ∈ P}) (xs : List R) {x : Fin D → ℕ} (hx : x ∈ box a) :
    fn L (selOp Sb (tensF (kerAt i H0)) xs) x = bfly h i.1 (fn L xs) x := by
  have hv := L.valid_addr x hx
  unfold fn bfly
  rw [kernel_pair Sb i H0 xs hv, Fin.sum_univ_two, hc.bits_eq _ hv, L.coord_addr x hx]
  have key : ∀ b : Fin 2, Sb.set (L.addr x) (Function.update (Sb.bits (L.addr x)) i b) =
      L.addr (Function.update x i.1 (setBit h (x i.1) b)) := by
    intro b
    rw [← L.addr_coord _ (Sb.valid_set _ _ hv), hc.set_eq _ hv]
    congr 1; funext j
    rw [L.coord_addr x hx]
    by_cases hj : j ∈ P
    · rw [dif_pos hj]
      by_cases hji : j = i.1
      · subst hji; simp
      · have : (⟨j, hj⟩ : {i // i ∈ P}) ≠ i := fun e => hji (congrArg Subtype.val e)
        rw [Function.update_of_ne this, hc.bits_eq _ hv, L.coord_addr x hx, setBit_getBit,
          Function.update_of_ne hji]
    · rw [dif_neg hj, Function.update_of_ne (fun (e : j = i.1) => hj (e ▸ i.2))]
  rw [key 0, key 1]

/-- The layer `H = selOp Sb (tens H0)` is the composition of the axis butterflies. -/
theorem fn_layer {h : ℕ} {P : Finset (Fin D)} {Sb : SelBits sh {i // i ∈ P}}
    (hc : SelCompat L h P Sb) (hP : ∀ i ∈ P, h < a i) {xs : List R} (hlen : xs.length = vol sh) :
    EqOn a (fn L (selOp Sb (Butterfly.tens H0) xs))
      ((Finset.univ : Finset {i // i ∈ P}).toList.foldr (fun i acc => bfly h i.1 acc) (fn L xs)) := by
  rw [layer_eq_kernels Sb H0 _ (Finset.nodup_toList _) (fun i => Finset.mem_toList.2 (mem_univ i))
    hlen]
  generalize (Finset.univ : Finset {i // i ∈ P}).toList = l
  induction l with
  | nil => intro x _; rfl
  | cons i l ih =>
    intro x hx
    simp only [List.foldr_cons]
    rw [fn_kernel L hc i _ hx]
    exact bfly_eqOn (hP i.1 i.2) ih x hx

lemma length_roundL (ℓ h : ℕ) (P : Finset (Fin D)) (Sb : SelBits sh {i // i ∈ P}) (xs : List R) :
    (roundL y L ℓ h P Sb xs).length = vol sh := by simp [roundL]

lemma roundAxes_nodup (P : Finset (Fin D)) : (roundAxes P).Nodup :=
  (Finset.nodup_toList _).map Subtype.val_injective

lemma mem_roundAxes {P : Finset (Fin D)} {i : Fin D} : i ∈ roundAxes P ↔ i ∈ P := by
  simp [roundAxes]

/-- **Grouping (29).** On the box, a round `J_E ∘ H` is the composition of the individual
axis levels (butterfly then twiddle) over the participating axes. -/
theorem fn_roundL (ℓ h : ℕ) {P : Finset (Fin D)} {Sb : SelBits sh {i // i ∈ P}}
    (hc : SelCompat L h P Sb) (hP : ∀ i ∈ P, h < a i) {xs : List R} (hlen : xs.length = vol sh) :
    EqOn a (fn L (roundL y L ℓ h P Sb xs))
      ((roundAxes P).foldr (fun i acc => axisL y ℓ i h acc) (fn L xs)) := by
  intro x hx
  have hv := L.valid_addr x hx
  have hlt := encode_lt hv
  simp only [axisL_eq_twid_bfly]
  rw [foldr_twid_bfly y ℓ h _ _ (roundAxes_nodup P)]
  unfold fn roundL twidAll
  rw [List.getD_eq_getElem _ _ (by simpa using hlt), List.getElem_map, List.getElem_range,
    decode_encode hv, L.coord_addr x hx]
  congr 1
  · rw [show (selOp Sb (Butterfly.tens H0) xs).getD (encode sh (L.addr x)) 0 =
      fn L (selOp Sb (Butterfly.tens H0) xs) x from rfl, fn_layer L hc hP hlen x hx]
    unfold roundAxes
    rw [List.foldr_map]
    rfl

lemma runF_append (ℓ : ℕ) : ∀ (l₁ l₂ : List (Fin D × ℕ)) (z : Synth.Arr R D),
    runF y ℓ (l₁ ++ l₂) z = runF y ℓ l₂ (runF y ℓ l₁ z)
  | [], _, _ => rfl
  | st :: l₁, l₂, z => by simp only [List.cons_append, runF]; exact runF_append ℓ l₁ l₂ _

lemma runF_round (ℓ h : ℕ) : ∀ (l : List (Fin D)) (z : Synth.Arr R D),
    runF y ℓ (l.reverse.map fun i => (i, h)) z = l.foldr (fun i acc => axisL y ℓ i h acc) z
  | [], _ => rfl
  | i :: l, z => by
    rw [List.reverse_cons, List.map_append, runF_append, runF_round ℓ h l z]
    rfl

theorem fn_procL (ℓ : ℕ) {P : ℕ → Finset (Fin D)} {Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}} :
    ∀ n, (∀ h < n, SelCompat L h (P h) (Sb h)) → (∀ h < n, ∀ i ∈ P h, h < a i) →
      ∀ {xs : List R}, xs.length = vol sh →
        EqOn a (fn L (procL y L ℓ P Sb n xs)) (runF y ℓ (schedL P n) (fn L xs))
  | 0, _, _, _, _ => fun _ _ => rfl
  | n + 1, hc, hP, xs, hlen => by
    intro x hx
    simp only [procL, schedL]
    rw [fn_procL ℓ n (fun h hh => hc h (by omega)) (fun h hh => hP h (by omega))
      (length_roundL y L ℓ n (P n) (Sb n) xs) x hx, runF_append, runF_round]
    apply runF_eqOn y ℓ _ _ (fn_roundL y L ℓ n (hc n (by omega)) (hP n (by omega)) hlen) x hx
    intro st hst
    -- every step of `schedL P n` is a slot below its axis length
    clear hx x
    induction n with
    | zero => simp [schedL] at hst
    | succ m ih =>
      simp only [schedL, List.mem_append, List.mem_map, List.mem_reverse] at hst
      rcases hst with ⟨i, hi, rfl⟩ | hst
      · exact hP m (by omega) i (mem_roundAxes.1 hi)
      · exact ih (fun h hh => hc h (by omega)) (fun h hh => hP h (by omega)) hst

lemma round_filter (h : ℕ) (j : Fin D) {l : List (Fin D)} (hl : l.Nodup) :
    (((l.reverse.map fun i => (i, h)).filter fun st => st.1 = j).map Prod.snd) =
      if j ∈ l then [h] else [] := by
  rw [List.filter_map, List.map_map]
  have : (l.reverse.filter ((fun st : Fin D × ℕ => decide (st.1 = j)) ∘ fun i => (i, h))) =
      l.reverse.filter fun i => i = j := rfl
  rw [this, List.filter_eq]
  split_ifs with hj
  · rw [List.count_eq_one_of_mem (List.nodup_reverse.2 hl) (List.mem_reverse.2 hj)]; rfl
  · rw [List.count_eq_zero_of_not_mem (fun h' => hj (List.mem_reverse.1 h'))]; rfl

lemma schedL_filter (P : ℕ → Finset (Fin D)) (j : Fin D) : ∀ n,
    ((schedL P n).filter fun st => st.1 = j).map Prod.snd =
      (List.range n).reverse.filter fun h => j ∈ P h
  | 0 => rfl
  | n + 1 => by
    rw [schedL, List.filter_append, List.map_append, round_filter n j (roundAxes_nodup _),
      schedL_filter P j n, range_succ_reverse, List.filter_cons]
    simp only [mem_roundAxes]
    split_ifs with h1 h2 h2 <;> simp_all

theorem schedL_ok {ℓ : ℕ} (ha : ∀ i, a i ≤ ℓ) : SchedOK a 0 (schedL (partAxes a) ℓ) := by
  intro j
  rw [schedL_filter]
  simp only [partAxes, Finset.mem_filter, mem_univ, true_and, Pi.zero_apply, Nat.sub_zero]
  rw [List.filter_reverse, range_filter_lt (ha j)]

/-- **§6.1 on the tape.** Let `L` be a coordinate layout of the physical shape `sh` and, for
every round `h < ℓ`, let `Sb h` be selected bits reading the named slots `(i, h)` of the axes
with `a_i > h`. Running the rounds `h = ℓ-1, …, 0` (each the simultaneous layer `selOp (tens H0)`
followed by `J_E`) on the records of `z` returns, at physical address `v`, the normalized
transform `(F^- z)(rev (coord v))`: the procedure implements `B F^-` in layout `L`. -/
theorem synth_forward_list {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) (ha : ∀ i, a i ≤ ℓ)
    {Sb : (h : ℕ) → SelBits sh {i // i ∈ partAxes a h}}
    (hc : ∀ h < ℓ, SelCompat L h (partAxes a h) (Sb h)) {xs : List R} (hlen : xs.length = vol sh)
    {v : List ℕ} (hv : Valid sh v) :
    (procL y L ℓ (partAxes a) Sb ℓ xs).getD (encode sh v) 0 =
      Fm y ℓ a (fn L xs) (revV a (L.coord v)) := by
  have hx := L.coord_mem v hv
  have := fn_procL y L ℓ ℓ hc (fun h _ i hi => (Finset.mem_filter.1 hi).2) hlen _ hx
  unfold fn at this
  rw [L.addr_coord v hv] at this
  rw [this, synth_forward y hy (fun i => (ha i).trans (Nat.le_succ ℓ)) (schedL_ok ha) _ hx]
  rfl

end Synth

