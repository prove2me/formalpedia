-- ===== S4.Def_RP_EtPBC_A_O2R3 =====
section

/-!
# S4-EtPBC-A, O2 (MV route), M6a (3): the multi-point MV complex maps to each one-point complex

For `k : ι`, an open `Uz ⊇ U₀` containing every point of every `S j` (`j ≠ k`):
* `copDescF` (maps out of `Λ[cop S]` from maps on the summands), `copι_copDescF`;
* `restSec`, `locτ₂`: the middle map `Λ[cop S] ⊞ Λ[U₀] ⟶ Λ[S k] ⊞ Λ[Uz]`;
* `loc_comm₁₂`, `loc_comm₂₃`, **`mvLocHom`**: a morphism of short complexes `mvCop ⟶ locC (S k)` with
  `τ₁ = copPr k` and `τ₃ = 𝟙`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}} {ι : Type u} [Fintype ι] [DecidableEq ι]
  (S : ι → P.Etale)

theorem copι_copDescF {G : EtSh Λ P} (φ : ∀ j, freeSh Λ (S j) ⟶ G) (j' : ι) :
    freeMap Λ (copι S j') ≫ copDescF Λ S φ = φ j' := by
  rw [copDescF_eq, Preadditive.comp_sum, Finset.sum_eq_single j']
  · rw [← Category.assoc, copι_copPr_self, Category.id_comp]
  · intro j _ hj
    rw [← Category.assoc, copι_copPr_ne S (Ne.symm hj), Limits.zero_comp]
  · intro hj
    exact absurd (Finset.mem_univ j') hj

variable (U₀ : P.Opens) (k : ι) {Uz : P.Opens} (h : U₀ ≤ Uz)
  (hrng : ∀ j, j ≠ k → ∀ v : (S j).left, (S j).hom v ∈ Uz)

theorem loc_comm₂₃_inl :
    copPr Λ S k ≫ freeMap Λ (toTop (S k)) + copDescF Λ S (restSec Λ S k hrng) ≫ freeMap Λ (toTop (opEt Uz)) =
      freeMap Λ (toTop (cop S)) := by
  refine freeCop_hom_ext _ (fun j => ?_)
  rw [Preadditive.comp_add, ← Category.assoc, ← Category.assoc, copι_copPr, copι_copDescF, ← freeMap_comp,
    toTop_ext (copι S j ≫ toTop (cop S)) (toTop (S j))]
  by_cases hj : j = k
  · subst hj
    rw [copPrSec_self, restSec_self, Category.id_comp, Limits.zero_comp, add_zero]
  · rw [copPrSec_ne _ hj, restSec_ne S k hrng hj, Limits.zero_comp, zero_add, ← freeMap_comp,
      toTop_ext (toOpEt (S j) Uz (hrng j hj) ≫ toTop (opEt Uz)) (toTop (S j))]

end RamanujanPetersson.EtPBC.EtMV

end

end

-- ===== S4.Def_RP_EtPBC_A_O2Km3 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Km3): an etale algebra over a PID splits into Dedekind domains

`C` a commutative ring whose localizations at maximal ideals are domains.
* `isReduced_of_loc`, `eq_of_le_max`: two minimal primes inside one maximal ideal agree;
* `isCoprime_minimalPrimes`, `iInf_minimalPrimes`;
* **`piEquiv h : C ≃+* Π p : minimalPrimes C, C ⧸ p`** (`piEquiv_apply` is `rfl`);
* **`isDomain_loc_of_etale`**: for `C` etale over a Jacobson PID `A` (not a field) every `C_m` is a domain;
* **`isDedekindDomain_quot`**: for a minimal prime `p` of such `C`, `C ⧸ p` is a Dedekind domain.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtPBC.EtDed

section Dec

end Dec

section Et

variable (A : Type*) [CommRing A] [IsDomain A] [IsPrincipalIdealRing A] [IsJacobsonRing A] (hA : ¬IsField A)
  (C : Type*) [CommRing C] [Algebra A C] [Algebra.Etale A C]

include hA in
/-- **`C ⧸ p` is a Dedekind domain** for a minimal prime `p` of an etale `C` over a Jacobson PID. -/
theorem isDedekindDomain_quot (p : Ideal C) (hp : p ∈ minimalPrimes C) : IsDedekindDomain (C ⧸ p) := by
  have : p.IsPrime := hp.1.1
  have : Algebra.FiniteType A (C ⧸ p) := Algebra.FiniteType.trans (S := C) inferInstance inferInstance
  have hinj : Function.Injective (algebraMap A (C ⧸ p)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    have hreg : IsSMulRegular C x :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hx0)
    have hreg' : IsSMulRegular C (algebraMap A C x) := (isSMulRegular_algebraMap_iff C).2 hreg
    have hnz : algebraMap A C x ∈ nonZeroDivisors C := by
      refine mem_nonZeroDivisors_iff.2 ⟨fun y hy => hreg' ?_, fun y hy => hreg' ?_⟩
      · show algebraMap A C x • y = algebraMap A C x • 0
        rw [smul_zero, smul_eq_mul, hy]
      · show algebraMap A C x • y = algebraMap A C x • 0
        rw [smul_zero, smul_eq_mul, mul_comm, hy]
    have hmem : algebraMap A C x ∈ p := by
      rw [IsScalarTower.algebraMap_apply A C (C ⧸ p), Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem] at hx
      exact hx
    exact Set.disjoint_left.1 (Ideal.disjoint_nonZeroDivisors_of_mem_minimalPrimes hp) hmem hnz
  exact isDedekindDomain_of_unramified A (C ⧸ p) hinj

end Et

end RamanujanPetersson.EtPBC.EtKum

end

end

