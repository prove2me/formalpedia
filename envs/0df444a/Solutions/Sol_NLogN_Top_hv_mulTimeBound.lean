  simp [NLogN.enc, tout]
@[simp] theorem enc_head_tout (inp : ℕ → Γ L) (c : Cfg S) :
    (NLogN.enc inp c).head tout = c.σ.out.length := by
  simp [NLogN.enc, tout]
@[simp] theorem enc_cells_tctl (inp : ℕ → Γ L) (c : Cfg S) :
    (NLogN.enc inp c).cells tctl = tapeOf (syms L) (c.ctl.map retSym).reverse := by
  simp [NLogN.enc, tctl]
@[simp] theorem enc_head_tctl (inp : ℕ → Γ L) (c : Cfg S) :
