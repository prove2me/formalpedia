theorem solution (L : TypeDensity.Law) (hL : TypeDensity.LawWf L) (σ : TypeDensity.FactorType) :
    (TypeDensity.lawCoef L).coeff σ = (TypeDensity.lawCoeff L σ).rational := by
  have hw : ∀ z ∈ L.map (fun z ↦ if z.1 = σ then z.2 else TypeDensity.Expr.const 0), z.wf := by
    intro e he
    obtain ⟨z, hz, rfl⟩ := List.mem_map.mp he
    by_cases h : z.1 = σ
    · simp only [h, if_true]; exact hL z hz
    · simp only [h, if_false]; simp [TypeDensity.Expr.wf]
  unfold TypeDensity.lawCoeff
  rw [(TypeDensity.Expr.rational_sum) hw]
  clear hw
  induction L with
  | nil => simp [TypeDensity.lawCoef]
  | cons z L ih =>
    have := ih (fun w hw ↦ hL w (List.mem_cons_of_mem _ hw))
    simp only [TypeDensity.lawCoef, List.map_cons, List.sum_cons] at this ⊢
    rw [AddMonoidAlgebra.coeff_add, Finsupp.add_apply, this]
    congr 1
    by_cases h : z.1 = σ
    · subst h; simp [AddMonoidAlgebra.coeff_single]
    · simp only [h, if_false]
      rw [(TypeDensity.Expr.rational_const 0)]
      simp [AddMonoidAlgebra.coeff_single, h]
