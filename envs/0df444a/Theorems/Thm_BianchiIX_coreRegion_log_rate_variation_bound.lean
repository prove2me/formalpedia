theorem BianchiIX.coreRegion_log_rate_variation_bound {k Q : ℝ} {y : ProjectiveState} {ξ : CoreAngleState}
    (hk : 6 ≤ k) (hy : coreRegion k y) (hQ : ‖scaleCoreVariation k ξ‖ ≤ Q) :
    let D := fderiv ℝ (coreLogRates (projectiveCoreAngle y)) (toCoreAngleState y) ξ
    |D 0| ≤ 3 * Q ∧ |D 1| ≤ (9 / k ^ 2) * Q + (8 / k) * |k * ξ 1| := by sorry
