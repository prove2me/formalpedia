-- title:
--   Lemma 4 — descent of L_r + T_1‖A*(y^{k+1} − y^k)‖² along the proximal ADMM iterates
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. Then for every $k\ge1$
--   $$\begin{aligned}&L_r(x^{k+1},z^{k+1},y^{k+1})+T_1\|A^*(y^{k+1}-y^k)\|^2+\tfrac12\|x^{k+1}-x^k\|^2_{M_3^k}+\tfrac12\|z^{k+1}-z^k\|^2_{M_2^k}\\&\quad\le L_r(x^k,z^k,y^k)+T_1\|A^*(y^k-y^{k-1})\|^2+\tfrac{C_1}2\|x^k-x^{k-1}\|^2 .\end{aligned}$$
--   Here $L_r$ is the augmented Lagrangian, $T_1$, $C_1$ and $M_3^k=2M_1^k+rA^*A-C_0\mathrm{Id}$ are the constants of §2.2, and $\|v\|_M^2=\langle Mv,v\rangle$.
--
--   This monotonicity inequality is the basis of the whole convergence analysis: it turns $F_k$ into a Lyapunov sequence (Theorem 7).
--
--   **Formalization Note** The inequality is stated in $\mathbb R\cup\{+\infty\}$ (`EReal`) with all terms on the sides where the paper has them; for $k\ge1$ both values of $L_r$ are finite. $\lambda_{\min}(AA^*)$ and $\mu_i$ enter through the bounds of `Assumption1`.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 10, Lemma 4, (16)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 4 (p. 10). Under Assumption 1, for a sequence generated by Algorithm 1 or
Algorithm 2 and every `k ≥ 1`, (16):
`L_r(xᵏ⁺¹, zᵏ⁺¹, yᵏ⁺¹) + T₁‖A*(yᵏ⁺¹ − yᵏ)‖² + ½‖xᵏ⁺¹ − xᵏ‖²_{M₃ᵏ} + ½‖zᵏ⁺¹ − zᵏ‖²_{M₂ᵏ}
 ≤ L_r(xᵏ, zᵏ, yᵏ) + T₁‖A*(yᵏ − yᵏ⁻¹)‖² + (C₁/2)‖xᵏ − xᵏ⁻¹‖²`,
stated in `ℝ ∪ {+∞}`. -/
theorem lemma_4 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y) (k : ℕ) (hk : 1 ≤ k) :
    Lr P (x (k + 1)) (z (k + 1)) (y (k + 1))
        + ((T1 P * ‖ContinuousLinearMap.adjoint P.A (y (k + 1) - y k)‖ ^ 2
          + 1 / 2 * normSqM3 v P k (x (k + 1) - x k)
          + 1 / 2 * ⟪P.M₂ k (z (k + 1) - z k), z (k + 1) - z k⟫ : ℝ) : EReal)
      ≤ Lr P (x k) (z k) (y k)
        + ((T1 P * ‖ContinuousLinearMap.adjoint P.A (y k - y (k - 1))‖ ^ 2
          + C1 v P / 2 * ‖x k - x (k - 1)‖ ^ 2 : ℝ) : EReal) := by sorry

end BotNguyenADMM.KL
