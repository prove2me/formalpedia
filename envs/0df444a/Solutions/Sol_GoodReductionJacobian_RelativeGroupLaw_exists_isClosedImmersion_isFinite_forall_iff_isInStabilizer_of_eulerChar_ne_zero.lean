      ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of K)) (x : SchemeHomOver t f),
        (∃ κ : T ⟶ KL, κ ≫ ι = x.1) ↔ L.IsInStabilizer 𝓛 t x := by
  haveI : IsProper f := hA.proper
  haveI : Smooth f := hA.smooth
  haveI : Flat f := inferInstance
  haveI : GeometricallyIntegral f := hA.geometricallyIntegral_of_commRing
  have hH0 : ∀ (B : Type) [CommRing B] [Algebra K B],
      Function.Bijective (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap K B)))).appTop := by
