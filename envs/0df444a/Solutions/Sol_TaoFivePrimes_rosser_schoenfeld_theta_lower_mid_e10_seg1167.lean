def walk (K C N Cb j bb lo : ℕ) : ℕ → ℕ → ℕ → List (ℕ × ℕ) → Bool
  | m, c, e, [] => Nat.ble 1 m && Nat.ble c N && (Nat.ble N lo || stepOK K C c (bits m e) N) &&
