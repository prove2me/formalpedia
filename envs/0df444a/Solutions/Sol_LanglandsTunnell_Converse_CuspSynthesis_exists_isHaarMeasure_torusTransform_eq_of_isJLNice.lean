private theorem t0752 {l : List ℂ} (h : ∀ z ∈ l, ‖z‖ ≤ 1) : ‖l.prod‖ ≤ 1 := by
  induction l with
  | nil => simp
  | cons z l ih =>
    rw [List.prod_cons, norm_mul]
    exact mul_le_one₀ (h z List.mem_cons_self) (norm_nonneg _)
      (ih fun w hw => h w (List.mem_cons_of_mem z hw))

private theorem t0753 (v : HeightOneSpectrum (𝓞 K)) (y : v.adicCompletion K) :
