-- title:
--   The Steinberg group St_n(R), its matrix representation, and the column/row product elements of Lemma 4.2
-- statement:
--   The Steinberg group $\mathrm{St}_n(R)$ for a unital associative ring $R$ (the preprint fixes $n=6$; generalized here to arbitrary $n$), presented by generators $x_{ij}(a)$ ($i\neq j$, $a\in R$) and relations (12)-(14) of Section 4 (additivity, chain commutator, disjoint commutator). Its matrix representation $\pi : \mathrm{St}_n(R) \to \mathrm{GL}_n(R)$, $x_{ij}(a)\mapsto I+ae_{ij}$. For $J \subseteq \{1,\dots,n\}$ and $k\notin J$, the "column"/"row" product elements $C_k(c) = \prod_{i\in J} x_{ik}(c_i)$, $R_k(r) = \prod_{i\in J} x_{ki}(r_i)$ of Lemma 4.2 (well-defined independent of the product order, since same-column/row generators commute), and the subgroup $\mathrm{steinSub}(J)$ of "root words using only indices in $J$" (generated by $\{x_{ab}(s) : a,b\in J\}$).
-- source:
--   OpenAI, *Finite algebraic envelopes and the Boone-Higman conjecture*, OpenAI Math Release preprint, September 23, 2026, https://github.com/openai/math/blob/adc7f1241b42e322a6451854ab7e4b4c146bf78a/preprints/Finite-algebraic-envelopes-and-the-Boone-Higman-conjecture-September-23-2026/paper.pdf, Section 4, pp. 10-11.

import Mathlib

/-!
The Steinberg group `St_n(R)` for a general (possibly noncommutative) unital associative ring
`R`, following OpenAI's "Finite algebraic envelopes and the Boone-Higman conjecture" preprint
(OpenAI Math Release, Sep 23, 2026), Section 4, p. 10 (relations (12)-(14); the preprint itself
fixes `n = 6`, generalized here to arbitrary `n`). Also the "column"/"row" product elements
`C_k(c)`, `R_k(r)` of Lemma 4.2 (p. 11) and the subgroup `steinSub J` of root words using only
indices in `J`.

Generators `x_ij(a)` for `i ≠ j : Fin n`, `a : R`. Relations:
  (12) x_ij(a) x_ij(b) = x_ij(a+b)
  (13) [x_ij(a), x_jk(b)] = x_ik(ab)      (i,j,k distinct)
  (14) [x_ij(a), x_kl(b)] = 1             (i ≠ l, j ≠ k)
-/

namespace OAI
namespace FiniteAlgebraicEnvelopes

universe u

/-- A Steinberg generator `x_ij(a)`: a pair of distinct indices and a ring element. -/
structure SteinGen (n : ℕ) (R : Type u) where
  i : Fin n
  j : Fin n
  hij : i ≠ j
  a : R

/-- Parameters for the additivity relation (12). -/
structure SteinAddParam (n : ℕ) (R : Type u) where
  i : Fin n
  j : Fin n
  hij : i ≠ j
  a : R
  b : R

/-- Parameters for the chain-commutator relation (13). -/
structure SteinChainParam (n : ℕ) (R : Type u) where
  i : Fin n
  j : Fin n
  k : Fin n
  hij : i ≠ j
  hjk : j ≠ k
  hik : i ≠ k
  a : R
  b : R

/-- Parameters for the disjoint-commutator relation (14). -/
structure SteinDisjParam (n : ℕ) (R : Type u) where
  i : Fin n
  j : Fin n
  k : Fin n
  l : Fin n
  hij : i ≠ j
  hkl : k ≠ l
  hil : i ≠ l
  hjk : j ≠ k
  a : R
  b : R

variable {n : ℕ} {R : Type u} [Ring R]

open FreeGroup in
/-- The relator for relation (12): `x_ij(a) x_ij(b) x_ij(a+b)⁻¹`. -/
def steinAddRelator (p : SteinAddParam n R) : FreeGroup (SteinGen n R) :=
  FreeGroup.of ⟨p.i, p.j, p.hij, p.a⟩ * FreeGroup.of ⟨p.i, p.j, p.hij, p.b⟩ *
    (FreeGroup.of ⟨p.i, p.j, p.hij, p.a + p.b⟩)⁻¹

open FreeGroup in
/-- The relator for relation (13): `[x_ij(a), x_jk(b)] x_ik(ab)⁻¹`. -/
def steinChainRelator (p : SteinChainParam n R) : FreeGroup (SteinGen n R) :=
  FreeGroup.of ⟨p.i, p.j, p.hij, p.a⟩ * FreeGroup.of ⟨p.j, p.k, p.hjk, p.b⟩ *
    (FreeGroup.of ⟨p.i, p.j, p.hij, p.a⟩)⁻¹ * (FreeGroup.of ⟨p.j, p.k, p.hjk, p.b⟩)⁻¹ *
    (FreeGroup.of ⟨p.i, p.k, p.hik, p.a * p.b⟩)⁻¹

open FreeGroup in
/-- The relator for relation (14): `[x_ij(a), x_kl(b)]`. -/
def steinDisjRelator (p : SteinDisjParam n R) : FreeGroup (SteinGen n R) :=
  FreeGroup.of ⟨p.i, p.j, p.hij, p.a⟩ * FreeGroup.of ⟨p.k, p.l, p.hkl, p.b⟩ *
    (FreeGroup.of ⟨p.i, p.j, p.hij, p.a⟩)⁻¹ * (FreeGroup.of ⟨p.k, p.l, p.hkl, p.b⟩)⁻¹

/-- The defining relations of the Steinberg group `St_n(R)`. -/
def steinRelations (n : ℕ) (R : Type u) [Ring R] : Set (FreeGroup (SteinGen n R)) :=
  Set.range (steinAddRelator (n := n) (R := R)) ∪
  Set.range (steinChainRelator (n := n) (R := R)) ∪
  Set.range (steinDisjRelator (n := n) (R := R))

/-- The Steinberg group `St_n(R)`, presented by generators `x_ij(a)` and relations (12)-(14). -/
def SteinbergGroup (n : ℕ) (R : Type u) [Ring R] : Type u :=
  PresentedGroup (steinRelations n R)

instance : Group (SteinbergGroup n R) :=
  inferInstanceAs (Group (PresentedGroup (steinRelations n R)))

/-- The generator `x_ij(a)` of `St_n(R)`. -/
noncomputable def SteinbergGroup.x (i j : Fin n) (hij : i ≠ j) (a : R) : SteinbergGroup n R :=
  PresentedGroup.of ⟨i, j, hij, a⟩

section MatrixRep

open Matrix in
/-- The square of a cross elementary-matrix product vanishes. -/
theorem single_sq_zero (i j : Fin n) (hij : i ≠ j) (a b : R) :
    Matrix.single i j a * Matrix.single i j b = 0 := by
  have hne : j ≠ i := hij.symm
  simp [Matrix.single_mul_single_of_ne, hne]

open Matrix in
/-- The elementary matrix `1 + a e_ij`, as a unit of `Matrix (Fin n) (Fin n) R` (for `i ≠ j`,
its inverse is `1 - a e_ij`). -/
def elemUnit (i j : Fin n) (hij : i ≠ j) (a : R) : (Matrix (Fin n) (Fin n) R)ˣ where
  val := 1 + Matrix.single i j a
  inv := 1 - Matrix.single i j a
  val_inv := by
    show (1 + Matrix.single i j a) * (1 - Matrix.single i j a) = 1
    rw [mul_sub, mul_one, add_mul, one_mul, single_sq_zero i j hij a a]
    abel
  inv_val := by
    show (1 - Matrix.single i j a) * (1 + Matrix.single i j a) = 1
    rw [sub_mul, one_mul, mul_add, mul_one, single_sq_zero i j hij a a]
    abel

open Matrix in
theorem single_cross_zero (i j k l : Fin n) (hjk : j ≠ k) (a b : R) :
    Matrix.single i j a * Matrix.single k l b = 0 := by
  simp [Matrix.single_mul_single_of_ne, hjk]

open Matrix in
theorem single_chain (i j k : Fin n) (a b : R) :
    Matrix.single i j a * Matrix.single j k b = Matrix.single i k (a * b) := by
  simp [Matrix.single_mul_single_same]

/-- `elemUnit` satisfies the additivity relation (12). -/
theorem elemUnit_add (i j : Fin n) (hij : i ≠ j) (a b : R) :
    elemUnit i j hij a * elemUnit i j hij b = elemUnit i j hij (a + b) := by
  apply Units.ext
  show (1 + Matrix.single i j a) * (1 + Matrix.single i j b) = 1 + Matrix.single i j (a + b)
  rw [mul_add, mul_one, add_mul, one_mul,
    single_sq_zero i j hij a b, Matrix.single_add]
  abel

/-- `elemUnit` satisfies the chain-commutator relation (13), for `i, j, k` pairwise distinct. -/
theorem elemUnit_chain (i j k : Fin n) (hij : i ≠ j) (hjk : j ≠ k) (hik : i ≠ k) (a b : R) :
    elemUnit i j hij a * elemUnit j k hjk b * (elemUnit i j hij a)⁻¹ * (elemUnit j k hjk b)⁻¹ =
      elemUnit i k hik (a * b) := by
  apply Units.ext
  show (1 + Matrix.single i j a) * (1 + Matrix.single j k b) *
      (1 - Matrix.single i j a) * (1 - Matrix.single j k b) = 1 + Matrix.single i k (a * b)
  have step1 : (1 + Matrix.single i j a) * (1 + Matrix.single j k b) =
      1 + Matrix.single i j a + Matrix.single j k b + Matrix.single i k (a * b) := by
    rw [mul_add, mul_one, add_mul, one_mul, single_chain]
    abel
  rw [step1]
  have hki : k ≠ i := hik.symm
  have hkj : k ≠ j := hjk.symm
  have step2 :
      (1 + Matrix.single i j a + Matrix.single j k b + Matrix.single i k (a * b)) *
        (1 - Matrix.single i j a) =
      1 + Matrix.single j k b + Matrix.single i k (a * b) := by
    rw [mul_sub, mul_one, add_mul, add_mul, add_mul, one_mul,
      single_sq_zero i j hij a a,
      single_cross_zero j k i j hki b a,
      single_cross_zero i k i j hki (a * b) a]
    abel
  rw [step2]
  rw [mul_sub, mul_one, add_mul, add_mul, one_mul,
    single_sq_zero j k hjk b b,
    single_cross_zero i k j k hkj (a * b) b]
  abel

/-- `elemUnit` satisfies the disjoint-commutator relation (14). -/
theorem elemUnit_disj (i j k l : Fin n) (hij : i ≠ j) (hkl : k ≠ l) (hil : i ≠ l) (hjk : j ≠ k)
    (a b : R) :
    elemUnit i j hij a * elemUnit k l hkl b * (elemUnit i j hij a)⁻¹ * (elemUnit k l hkl b)⁻¹ =
      1 := by
  apply Units.ext
  show (1 + Matrix.single i j a) * (1 + Matrix.single k l b) *
      (1 - Matrix.single i j a) * (1 - Matrix.single k l b) = 1
  have hli : l ≠ i := hil.symm
  have hkj : k ≠ j := hjk.symm
  have step1 : (1 + Matrix.single i j a) * (1 + Matrix.single k l b) =
      1 + Matrix.single i j a + Matrix.single k l b := by
    rw [mul_add, mul_one, add_mul, one_mul, single_cross_zero i j k l hjk a b]
    abel
  rw [step1]
  have step2 :
      (1 + Matrix.single i j a + Matrix.single k l b) * (1 - Matrix.single i j a) =
      1 + Matrix.single k l b := by
    rw [mul_sub, mul_one, add_mul, add_mul, one_mul,
      single_sq_zero i j hij a a,
      single_cross_zero k l i j hli b a]
    abel
  rw [step2]
  rw [mul_sub, mul_one, add_mul, one_mul, single_sq_zero k l hkl b b]
  abel

/-- The matrix representation of each generator. -/
noncomputable def steinMatrixMap (g : SteinGen n R) : (Matrix (Fin n) (Fin n) R)ˣ :=
  elemUnit g.i g.j g.hij g.a

theorem steinMatrixMap_relations :
    ∀ r ∈ steinRelations n R, FreeGroup.lift steinMatrixMap r = 1 := by
  have hr : steinRelations n R =
      Set.range (steinAddRelator (n := n) (R := R)) ∪
      Set.range (steinChainRelator (n := n) (R := R)) ∪
      Set.range (steinDisjRelator (n := n) (R := R)) := rfl
  rw [hr]
  rintro r ((⟨p, rfl⟩ | ⟨p, rfl⟩) | ⟨p, rfl⟩)
  · simp only [steinAddRelator, _root_.map_mul, _root_.map_inv, FreeGroup.lift_apply_of,
      steinMatrixMap]
    rw [elemUnit_add]
    exact mul_inv_cancel _
  · simp only [steinChainRelator, _root_.map_mul, _root_.map_inv, FreeGroup.lift_apply_of,
      steinMatrixMap]
    rw [elemUnit_chain]
    exact mul_inv_cancel _
  · simp only [steinDisjRelator, _root_.map_mul, _root_.map_inv, FreeGroup.lift_apply_of,
      steinMatrixMap]
    exact elemUnit_disj p.i p.j p.k p.l p.hij p.hkl p.hil p.hjk p.a p.b

/-- The induced matrix representation `St_n(R) → GL_n(R)` sending `x_ij(a) ↦ 1 + a e_ij`. -/
noncomputable def steinPi : SteinbergGroup n R →* (Matrix (Fin n) (Fin n) R)ˣ :=
  PresentedGroup.toGroup steinMatrixMap_relations

theorem steinPi_x (i j : Fin n) (hij : i ≠ j) (a : R) :
    steinPi (SteinbergGroup.x i j hij a) = elemUnit i j hij a :=
  PresentedGroup.toGroup.of steinMatrixMap_relations

end MatrixRep

section Lemma42Defs

variable {n : ℕ} {R : Type u} [Ring R]

noncomputable def steinSub (J : Finset (Fin n)) : Subgroup (SteinbergGroup n R) :=
  Subgroup.closure
    {w | ∃ (a b : Fin n) (hab : a ≠ b) (s : R), a ∈ J ∧ b ∈ J ∧ w = SteinbergGroup.x a b hab s}

theorem steinberg_x_commute (i j k l : Fin n) (hij : i ≠ j) (hkl : k ≠ l) (hil : i ≠ l)
    (hjk : j ≠ k) (a b : R) :
    Commute (SteinbergGroup.x i j hij a) (SteinbergGroup.x k l hkl b) := by
  have hmem : steinDisjRelator (⟨i, j, k, l, hij, hkl, hil, hjk, a, b⟩ : SteinDisjParam n R) ∈
      steinRelations n R := Or.inr (Set.mem_range_self _)
  have h1 := PresentedGroup.one_of_mem hmem
  unfold steinDisjRelator at h1
  simp only [map_mul, map_inv] at h1
  show SteinbergGroup.x i j hij a * SteinbergGroup.x k l hkl b =
    SteinbergGroup.x k l hkl b * SteinbergGroup.x i j hij a
  have h1' : SteinbergGroup.x i j hij a * SteinbergGroup.x k l hkl b *
      (SteinbergGroup.x i j hij a)⁻¹ * (SteinbergGroup.x k l hkl b)⁻¹ = 1 := h1
  have := mul_eq_one_iff_eq_inv.mp h1'
  calc SteinbergGroup.x i j hij a * SteinbergGroup.x k l hkl b
      = (SteinbergGroup.x i j hij a * SteinbergGroup.x k l hkl b *
          (SteinbergGroup.x i j hij a)⁻¹ * (SteinbergGroup.x k l hkl b)⁻¹) *
        SteinbergGroup.x k l hkl b * SteinbergGroup.x i j hij a := by group
    _ = SteinbergGroup.x k l hkl b * SteinbergGroup.x i j hij a := by rw [h1']; group

/-- Column generators `x_ik(a)`, `x_jk(b)` (same column `k`, distinct rows) commute. -/
theorem steinberg_col_commute (k : Fin n) {i j : Fin n} (hik : i ≠ k) (hjk : j ≠ k)
    (hij : i ≠ j) (a b : R) :
    Commute (SteinbergGroup.x i k hik a) (SteinbergGroup.x j k hjk b) :=
  steinberg_x_commute i k j k hik hjk hik hjk.symm a b

/-- Row generators `x_ki(a)`, `x_kj(b)` (same row `k`, distinct columns) commute. -/
theorem steinberg_row_commute (k : Fin n) {i j : Fin n} (hik : i ≠ k) (hjk : j ≠ k)
    (hij : i ≠ j) (a b : R) :
    Commute (SteinbergGroup.x k i hik.symm a) (SteinbergGroup.x k j hjk.symm b) :=
  steinberg_x_commute k i k j hik.symm hjk.symm hjk.symm hik a b

/-- The "column" element `C_k(c) = ∏_{i∈J} x_ik(c_i)` (order-independent, since the factors
pairwise commute). Defined as `1` on indices equal to `k`, which never occurs for `i ∈ J`
given `hk`. -/
noncomputable def columnElem (J : Finset (Fin n)) (k : Fin n) (hk : ∀ i ∈ J, i ≠ k)
    (c : Fin n → R) : SteinbergGroup n R :=
  J.noncommProd
    (fun i => if h : i ≠ k then SteinbergGroup.x i k h (c i) else 1)
    (fun i hi j hj hij => by
      simp only [Function.onFun, dif_pos (hk i hi), dif_pos (hk j hj)]
      exact steinberg_col_commute k (hk i hi) (hk j hj) hij (c i) (c j))

/-- The "row" element `R_k(r) = ∏_{i∈J} x_ki(r_i)` (order-independent, since the factors
pairwise commute). -/
noncomputable def rowElem (J : Finset (Fin n)) (k : Fin n) (hk : ∀ i ∈ J, i ≠ k)
    (r : Fin n → R) : SteinbergGroup n R :=
  J.noncommProd
    (fun i => if h : i ≠ k then SteinbergGroup.x k i h.symm (r i) else 1)
    (fun i hi j hj hij => by
      simp only [Function.onFun, dif_pos (hk i hi), dif_pos (hk j hj)]
      exact steinberg_row_commute k (hk i hi) (hk j hj) hij (r i) (r j))

theorem columnElem_apply (J : Finset (Fin n)) (k : Fin n) (hk : ∀ i ∈ J, i ≠ k) (c : Fin n → R)
    {i : Fin n} (hi : i ∈ J) :
    (fun i => if h : i ≠ k then SteinbergGroup.x i k h (c i) else 1) i =
      SteinbergGroup.x i k (hk i hi) (c i) := by
  simp [dif_pos (hk i hi)]

end Lemma42Defs

end FiniteAlgebraicEnvelopes
end OAI


