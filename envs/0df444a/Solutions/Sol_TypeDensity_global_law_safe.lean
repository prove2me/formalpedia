      have : (2:ℚ) ≤ q := by exact_mod_cast hq
      simpa [TypeDensity.expression_pow_eval, TypeDensity.Expr.eval] using pow_ne_zero n (by linarith : (q:ℚ) ≠ 0)
  refine TypeDensity.law_safe_scale _ _ normSafe fun z hz ↦ ?_
  simp only [List.mem_flatMap] at hz
  obtain ⟨m, _, hz⟩ := hz
  refine TypeDensity.law_safe_scale _ _ (TypeDensity.divisor_count_safe _ _ m) (TypeDensity.lawProd_safe _ ?_) z hz
