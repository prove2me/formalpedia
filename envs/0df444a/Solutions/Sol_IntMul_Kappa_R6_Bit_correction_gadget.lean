/-! ## Partial swaps and the copy correction -/

section PSwap

variable {N m : ℕ}

lemma psw_one : psw (1 : Matrix (Fin m) (Fin m) (ZMod N)) = swapMat := by
  simp [psw, swapMat]

/-- `psw P · swapMat = psw (1 - P)` (the correction identity `T F = E`). -/
lemma psw_mul_swap (P : Matrix (Fin m) (Fin m) (ZMod N)) :
    psw P * swapMat = psw (1 - P) := by
  rw [← psw_one, psw_mul]; congr 1; noncomm_ring

end PSwap

section Gadget

variable {R : Type*} [CommRing R] {U : Type*} {m N : ℕ}

/-- **Copy correction on formal values** (characteristic two). If `A = (swap, y)` and
`B = (swap, x) + (psw (1 - P), y)`, then copying `A` into a zero temporary, applying the frame
change `psw P` to the copy and adding the copy into `B` leaves `B = (swap, x)`. -/
theorem correction_gadget_sol_aux (h2 : (2 : R) = 0) (P : Matrix (Fin m) (Fin m) (ZMod N)) (x y : U) :
    let A : FV R U m N := Finsupp.single (swapMat, y) 1
    let B : FV R U m N := Finsupp.single (swapMat, x) 1 + Finsupp.single (psw (1 - P), y) 1
    let t : FV R U m N := lmulF (psw P) (0 + A)
    B + t = Finsupp.single (swapMat, x) 1 := by
  intro A B t
  simp only [t, A, B, zero_add, lmulF_single, psw_mul_swap, add_assoc, ← Finsupp.single_add]
  rw [show (1 : R) + 1 = 2 by norm_num, h2, Finsupp.single_zero, add_zero]

end Gadget

