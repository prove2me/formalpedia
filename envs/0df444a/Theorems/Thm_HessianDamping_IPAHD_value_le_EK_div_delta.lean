-- title:
--   Proof of Theorem 4, p. 13 — under (G₂dis), (G₃dis) from k₀ on, f(x_k) − min f ≤ E_{k₀}/δ_k for k ≥ k₀
-- statement:
--   Let $\mathcal H$ be a real Hilbert space and $f:\mathcal H\to\mathbb R$ a convex $\mathcal C^1$ function with a minimizer $x^\star$. Let $\alpha\ge1$, $h>0$, $s=h^2$, let $(\beta_k)$, $(b_k)$ be non-negative sequences, and let $(x_k)$ be generated by (IPAHD). Let $k_0\ge1$ and assume that for every $k\ge k_0$
--   1. $(\mathcal G_2^{\rm dis})$: $b_khk-\beta_{k+1}-k(\beta_{k+1}-\beta_k)>0$;
--   2. $(\mathcal G_3^{\rm dis})$: $\delta_{k+1}-\delta_k\le(\alpha-1)\frac{\delta_k}{k+1}$,
--
--   where $\delta_k$ is (9). Then, with $E_k$ the energy of the proof of Theorem 4, for every $k\ge k_0$
--   $$f(x_k)-\min_{\mathcal H}f\le\frac{E_{k_0}}{\delta_k}.$$
--
--   This is the rate estimate behind Theorem 4 (i).
--
--   **Formalization Note.** The page writes $E_0$ and "for $k\ge0$". The growth conditions cannot hold at $k=0$ when $\beta_1\ge0$ ($(\mathcal G_2^{\rm dis})$ reads $-\beta_1>0$), so they are assumed from an index $k_0\ge1$ on, as in the paper's examples, and the energy is started at $E_{k_0}$. $\min f$ is $f(x^\star)$ for a point $x^\star$ with $f(x^\star)\le f(y)$ for all $y$. $h>0$, $\beta_k,b_k\ge0$ are implicit on the page and added.
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, §3.1.1, proof of Theorem 4, p. 13

import Mathlib
import Definitions.Def_GoldenRatioVI_Shared_IsProxPoint
import Definitions.Def_HessianDamping_IPAHD_Setting

namespace HessianDamping.IPAHD

/-- Proof of Theorem 4, p. 13: `f(x_k) - min f ≤ E_{k₀}/δ_k` for `k ≥ k₀` when the growth
conditions hold from `k₀ ≥ 1` on. -/
theorem value_le_EK_div_delta
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f : H → ℝ) (hfconv : ConvexOn ℝ Set.univ f) (hfC1 : ContDiff ℝ 1 f)
    (xstar : H) (hxstar : ∀ y, f xstar ≤ f y)
    (α : ℝ) (hα : 1 ≤ α)
    (h s : ℝ) (hh : 0 < h) (hs : s = h ^ 2)
    (β b : ℕ → ℝ) (hβ : ∀ k, 0 ≤ β k) (hb : ∀ k, 0 ≤ b k)
    (x : ℕ → H) (hx : IsIPAHDRun f α s β b x)
    (k₀ : ℕ) (hk₀ : 1 ≤ k₀)
    (hG2 : ∀ k : ℕ, k₀ ≤ k → 0 < b k * h * k - β (k + 1) - k * (β (k + 1) - β k))
    (hG3 : ∀ k : ℕ, k₀ ≤ k →
      deltaK h β b (k + 1) - deltaK h β b k ≤ (α - 1) * deltaK h β b k / ((k : ℝ) + 1)) :
    ∀ k : ℕ, k₀ ≤ k → f (x k) - f xstar ≤ EK f α h β b x xstar k₀ / deltaK h β b k := by sorry

end HessianDamping.IPAHD
