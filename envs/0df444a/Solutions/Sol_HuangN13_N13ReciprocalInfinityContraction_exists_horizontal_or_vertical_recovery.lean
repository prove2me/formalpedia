  rw [aeval_mapPoly_xbar]
  change
    (p.reflect n).eval₂
          (coefficientToGenericQuotient D) (xbar D) =
      xbar D ^ n *
        p.eval₂ (coefficientToGenericQuotient D) (tbar D)
