      ∃ x y : LaurentSeries ↥A, coeffMap (IsLocalRing.residue ↥A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    {K' : Type*} [Field K'] [Algebra K' ↥(fieldBar q M')] (S : IntermediateField K' ↥(fieldBar q M'))
    (j : ↥S)
    (hj : (j : ↥(fieldBar q M')) = IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M'))) :
    (j : ↥(fieldBar q M')) ∈ O ∧ ((j⁻¹ : ↥S) : ↥(fieldBar q M')) ∈ O := by
  obtain ⟨h1, h2⟩ := j_mem_and_inv_mem q M' A hle O hO (j : ↥(fieldBar q M')) hj
  refine ⟨h1, ?_⟩
