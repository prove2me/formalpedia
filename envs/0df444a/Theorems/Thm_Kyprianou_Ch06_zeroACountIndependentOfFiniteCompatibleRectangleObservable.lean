-- title:
--   Zero A-count independent of every finite observable generated by compatible outside Poisson rectangles
-- statement:
--   A source-faithful marked-Poisson independence transport theorem for any finite family of pairwise compatible outside-A space-time rectangles. Its original independent source rectangle increments generate a countably valued statistic, so every arbitrary finite-dimensional count vector reconstructible almost surely as a deterministic function of the rectangle counts is independent of zero A-count. Pairwise compatibility permits overlapping mark sets whenever their time intervals are disjoint. The source process assumptions are not strengthened and arbitrary observable dimension is retained.

import Mathlib
import Definitions.Def_Kyprianou_Ch06_MarkedPoissonPointProcess
open MeasureTheory Filter
open scoped NNReal ENNReal
open Kyprianou.Ch06
set_option autoImplicit false

theorem Kyprianou.Ch06.zeroACountIndependentOfFiniteCompatibleRectangleObservable
    {Omega E : Type} [MeasurableSpace Omega] [MeasurableSpace E]
    (P : Measure Omega) (n : Measure E)
    (N : Omega → NNReal → Set E → Nat)
    (hPPP : Kyprianou.Ch06.IsMarkedPoissonPointProcess P n N)
    (A : Set E) (hA : MeasurableSet A) (hFA : n A < ⊤)
    (m p : Nat) (starts stops : Fin m → NNReal)
    (B : Fin m → Set E)
    (hValid : ∀ i, starts i ≤ stops i ∧
      MeasurableSet (B i) ∧ n (B i) < ⊤)
    (hAB : ∀ i, Disjoint A (B i))
    (hSep : ∀ i j : Fin m, i ≠ j →
      stops i ≤ starts j ∨ stops j ≤ starts i ∨
      Disjoint (B i) (B j))
    (r : NNReal) (Y : Omega → Fin p → Nat)
    (f : (Fin m → Nat) → Fin p → Nat)
    (hAe : ∀ᵐ omega ∂P,
      Y omega = f (fun i =>
        N omega (stops i) (B i) - N omega (starts i) (B i)))
    (levels : Fin p → Nat) :
    P {omega | N omega r A = 0 ∧ Y omega = levels} =
    P {omega | N omega r A = 0} *
      P {omega | Y omega = levels} := by sorry
