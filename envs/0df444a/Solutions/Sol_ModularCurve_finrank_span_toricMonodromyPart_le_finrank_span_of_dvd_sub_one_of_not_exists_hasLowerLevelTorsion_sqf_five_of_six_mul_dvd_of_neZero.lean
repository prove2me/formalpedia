private theorem sw3_smul_of_gen {Y L : Type*} [AddCommGroup Y] [Module HeckeAlg Y] [AddCommGroup L] [Module HeckeAlg L]
    (φ : Y →+ L) (h : ∀ (ℓ : Nat.Primes) (y : Y), φ (heckeGen ℓ • y) = heckeGen ℓ • φ y) :
    ∀ (r : HeckeAlg) (y : Y), φ (r • y) = r • φ y := by
  intro r
  induction r using MvPolynomial.induction_on with
  | C a =>
    intro y
    rw [eq_intCast MvPolynomial.C a, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul, map_zsmul]
  | add p₁ p₂ hp₁ hp₂ =>
    intro y
    rw [add_smul, map_add, hp₁, hp₂, add_smul]
  | mul_X p₁ n hp₁ =>
    intro y
    have hX : ∀ y : Y, φ (MvPolynomial.X n • y) = MvPolynomial.X n • φ y := h n
    rw [mul_smul, hp₁, hX, mul_smul]

private theorem sw3_hda_transpose {ι : Type*} [Fintype ι] (M : Matrix ι ι ℤ) (D : ι → ℤ) :
    heckeDivisorAction M.transpose D = M.mulVec D := by
  funext j
  simp [heckeDivisorAction_apply, Matrix.mulVec, dotProduct]

private theorem sw3_heckeKernelMap_coe {E V : Type*} [Fintype E] [Fintype V] [DecidableEq V]
    {D : CerednikDrinfeld.DegeneracyData E V} (H : CerednikDrinfeld.HeckeData D) (ℓ : Nat.Primes)
    (x : ↥(CerednikDrinfeld.ribbonKernel D)) :
    ((CerednikDrinfeld.heckeKernelMap H ℓ x : ↥(CerednikDrinfeld.ribbonKernel D)) : E → ℤ) = (H.T ℓ).mulVec (x : E → ℤ) :=
  rfl

private theorem sw3_tower (M : Type*) [AddCommGroup M] [Module HeckeAlg M] : IsScalarTower ℤ HeckeAlg M :=
  ⟨fun a r m => by rw [zsmul_eq_mul, mul_smul, Int.cast_smul_eq_zsmul]⟩

private theorem sw3_exists_incl
    {c : ℕ} [Fact c.Prime] {K : Type} [Field K] [CharP K c] [DecidableEq K]
    {M s : ℕ} [NeZero M] [NeZero s] [Fact s.Prime]
    [Fintype ↥(ssPlaces c (M * s) K)] [Fintype ↥(ssPlaces c M K)] [DecidableEq ↥(ssPlaces c M K)]
    (X : SSLevelDatum c K M s) (hX : X.HeckeLaws)
    {Yo : Type} [AddCommGroup Yo] [Module HeckeAlg Yo]
    (eY : Yo ≃+ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData))
    (hY : ∀ (ℓ : Nat.Primes) (m : Yo),
      eY (heckeGen ℓ • m) = CerednikDrinfeld.heckeKernelMap X.heckeData ℓ (eY m))
    (n : Nat.Primes → ℤ) (hcol : ∀ ℓ : Nat.Primes, HeckeRowSums (X.edgeHecke ℓ).transpose (n ℓ))
    {Lo : Type} [AddCommGroup Lo] [Module HeckeAlg Lo]
    (eL : Lo ≃+ ↥(characterLattice ↥(ssPlaces c (M * s) K)))
    (hL : ∀ (ℓ : Nat.Primes) (l : Lo),
      eL (heckeGen ℓ • l) = heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol ℓ) (eL l)) :
    ∃ f : Yo →ₗ[HeckeAlg] Lo, Function.Injective f ∧
      ∀ y : Yo, ((eL (f y) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
        ((eY y : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ) := by
  classical
  have hT : X.heckeData.T = X.edgeHecke := by
    unfold ModularCurve.SSLevelDatum.heckeData
    rw [dif_pos hX]
  let incl : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData) →ₗ[ℤ] ↥(characterLattice ↥(ssPlaces c (M * s) K)) :=
    Submodule.inclusion (CerednikDrinfeld.ribbonKernel_le_characterLattice X.degeneracyData)
  let f0 : Yo →+ Lo :=
    (eL.symm : ↥(characterLattice ↥(ssPlaces c (M * s) K)) →+ Lo).comp
      (incl.toAddMonoidHom.comp (eY : Yo →+ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)))
  have hf0 : ∀ y : Yo, eL (f0 y) = incl (eY y) := fun y => eL.apply_symm_apply _
  have hf0val : ∀ y : Yo, ((eL (f0 y) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
      ((eY y : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ) := by
    intro y; rw [hf0]; rfl
  have hgen : ∀ (ℓ : Nat.Primes) (y : Yo), f0 (heckeGen ℓ • y) = heckeGen ℓ • f0 y := by
    intro ℓ y
    have lhs : ((eL (f0 (heckeGen ℓ • y)) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
        (X.edgeHecke ℓ).mulVec ((eY y : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ) := by
      rw [hf0val (heckeGen ℓ • y), hY ℓ y, sw3_heckeKernelMap_coe, hT]
    have rhs : ((eL (heckeGen ℓ • f0 y) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
        (X.edgeHecke ℓ).mulVec ((eY y : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ) := by
      rw [hL ℓ (f0 y), heckeCharacterAction_coe, sw3_hda_transpose, ← hf0val y]
    exact eL.injective (Subtype.ext (lhs.trans rhs.symm))
  refine ⟨{ toFun := f0, map_add' := f0.map_add, map_smul' := fun r y => sw3_smul_of_gen f0 hgen r y }, ?_, hf0val⟩
  intro y₁ y₂ h
  have h' : f0 y₁ = f0 y₂ := h
  apply eY.injective
  apply Submodule.inclusion_injective (CerednikDrinfeld.ribbonKernel_le_characterLattice X.degeneracyData)
  have h'' := congrArg eL h'
  rw [hf0, hf0] at h''
  exact h''

private theorem sw3_mulVec_mem_characterLattice {E V : Type} [Fintype E] [Fintype V] [DecidableEq V]
    (φ : E → V) (x : E → ℤ) (hx : x ∈ characterLattice E) :
    (CerednikDrinfeld.degeneracyMatrix φ).mulVec x ∈ characterLattice V := by
  have h := CerednikDrinfeld.degreeOn_pushforward φ x
  rw [degreeOn_apply, degreeOn_apply] at h
  rw [mem_characterLattice] at hx ⊢
  exact h.trans hx

private theorem sw3_delta_hgen
    {c : ℕ} [Fact c.Prime] {K : Type} [Field K] [CharP K c] [DecidableEq K]
    {M s : ℕ} [NeZero M] [NeZero s] (hs : s.Prime) [Fact s.Prime]
    [Fintype ↥(ssPlaces c (M * s) K)] [Fintype ↥(ssPlaces c M K)] [DecidableEq ↥(ssPlaces c (M * s) K)] [DecidableEq ↥(ssPlaces c M K)]
    (X : SSLevelDatum c K M s) (hX : X.HeckeLaws)
    (n : Nat.Primes → ℤ) (hcol : ∀ ℓ : Nat.Primes, HeckeRowSums (X.edgeHecke ℓ).transpose (n ℓ))
    {Lo : Type} [AddCommGroup Lo] [Module HeckeAlg Lo]
    (eL : Lo ≃+ ↥(characterLattice ↥(ssPlaces c (M * s) K)))
    (hL : ∀ (ℓ : Nat.Primes) (l : Lo),
      eL (heckeGen ℓ • l) = heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol ℓ) (eL l))
    {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (eX : Xo ≃+ (↥(characterLattice ↥(ssPlaces c M K)) × ↥(characterLattice ↥(ssPlaces c M K))))
    (hTX : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
        ((eX (heckeGen ℓ • x)).1 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ℓ • x)).2 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).2 : ↥(ssPlaces c M K) → ℤ))
    (hUX : ∀ x : Xo,
        ((eX (heckeGen ⟨s, hs⟩ • x)).1 : ↥(ssPlaces c M K) → ℤ) =
            (X.vertexHecke ⟨s, hs⟩).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) - ((eX x).2 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces c M K) → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : ↥(ssPlaces c M K) → ℤ))
    (hC3 : (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) =
          (X.vertexHecke ⟨s, hs⟩).mulVec ((CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y) - (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec y) ∧
      (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) = ((s : ℕ) : ℤ) • (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y))
    (δ0 : Lo →+ Xo)
    (hval1 : ∀ l, ((eX (δ0 l)).1 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ))
    (hval2 : ∀ l, ((eX (δ0 l)).2 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ)) :
    ∀ (ℓ : Nat.Primes) (l : Lo), δ0 (heckeGen ℓ • l) = heckeGen ℓ • δ0 l := by
  have hext : ∀ z₁ z₂ : Xo, ((eX z₁).1 : ↥(ssPlaces c M K) → ℤ) = ((eX z₂).1 : ↥(ssPlaces c M K) → ℤ) →
      ((eX z₁).2 : ↥(ssPlaces c M K) → ℤ) = ((eX z₂).2 : ↥(ssPlaces c M K) → ℤ) → z₁ = z₂ :=
    fun z₁ z₂ h₁ h₂ => eX.injective (Prod.ext (Subtype.ext h₁) (Subtype.ext h₂))
  intro ℓ l
  have e1 : ((eL (heckeGen ℓ • l) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
      (X.edgeHecke ℓ).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) := by
    rw [hL ℓ l, heckeCharacterAction_coe, sw3_hda_transpose]
  by_cases hℓ : (ℓ : ℕ) = s
  · have hℓ' : ℓ = ⟨s, hs⟩ := Subtype.ext hℓ
    subst hℓ'
    obtain ⟨hU1, hU2⟩ := hUX (δ0 l)
    apply hext
    · rw [hval1, hU1, hval1, hval2, e1, hC3.1]
    · rw [hval2, hU2, hval1, e1, hC3.2]
  · obtain ⟨hT1, hT2⟩ := hTX ℓ hℓ (δ0 l)
    have hℓS : ℓ ∉ ({⟨s, Fact.out⟩} : Finset Nat.Primes) := by
      rw [Finset.mem_singleton]; intro h; exact hℓ (congrArg Subtype.val h)
    have law := hX.2.2.1 ℓ hℓS
    apply hext
    · rw [hval1, hT1, hval1, e1]
      have := law 0 ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ)
      simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using this
    · rw [hval2, hT2, hval2, e1]
      have := law 1 ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ)
      simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using this

private theorem sw3_exists_delta
    {c : ℕ} [Fact c.Prime] {K : Type} [Field K] [CharP K c] [DecidableEq K]
    {M s : ℕ} [NeZero M] [NeZero s] (hs : s.Prime) [Fact s.Prime]
    [Fintype ↥(ssPlaces c (M * s) K)] [Fintype ↥(ssPlaces c M K)] [DecidableEq ↥(ssPlaces c (M * s) K)] [DecidableEq ↥(ssPlaces c M K)]
    (X : SSLevelDatum c K M s) (hX : X.HeckeLaws)
    (n : Nat.Primes → ℤ) (hcol : ∀ ℓ : Nat.Primes, HeckeRowSums (X.edgeHecke ℓ).transpose (n ℓ))
    {Lo : Type} [AddCommGroup Lo] [Module HeckeAlg Lo]
    (eL : Lo ≃+ ↥(characterLattice ↥(ssPlaces c (M * s) K)))
    (hL : ∀ (ℓ : Nat.Primes) (l : Lo),
      eL (heckeGen ℓ • l) = heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol ℓ) (eL l))
    {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (eX : Xo ≃+ (↥(characterLattice ↥(ssPlaces c M K)) × ↥(characterLattice ↥(ssPlaces c M K))))
    (hTX : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
        ((eX (heckeGen ℓ • x)).1 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ℓ • x)).2 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).2 : ↥(ssPlaces c M K) → ℤ))
    (hUX : ∀ x : Xo,
        ((eX (heckeGen ⟨s, hs⟩ • x)).1 : ↥(ssPlaces c M K) → ℤ) =
            (X.vertexHecke ⟨s, hs⟩).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) - ((eX x).2 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces c M K) → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : ↥(ssPlaces c M K) → ℤ))
    (hC3 : (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) =
          (X.vertexHecke ⟨s, hs⟩).mulVec ((CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y) - (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec y) ∧
      (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) = ((s : ℕ) : ℤ) • (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y)) :
    ∃ δ : Lo →ₗ[HeckeAlg] Xo, ∀ l : Lo,
      ((eX (δ l)).1 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) ∧
      ((eX (δ l)).2 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) := by
  classical
  let δE : ↥(characterLattice ↥(ssPlaces c (M * s) K)) → Xo := fun x =>
    eX.symm (⟨(CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec (x : ↥(ssPlaces c (M * s) K) → ℤ), sw3_mulVec_mem_characterLattice _ _ x.2⟩,
      ⟨(CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec (x : ↥(ssPlaces c (M * s) K) → ℤ), sw3_mulVec_mem_characterLattice _ _ x.2⟩)
  have hδE1 : ∀ x, ((eX (δE x)).1 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec (x : ↥(ssPlaces c (M * s) K) → ℤ) := by
    intro x; show ((eX (eX.symm _)).1 : ↥(ssPlaces c M K) → ℤ) = _; rw [eX.apply_symm_apply]
  have hδE2 : ∀ x, ((eX (δE x)).2 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec (x : ↥(ssPlaces c (M * s) K) → ℤ) := by
    intro x; show ((eX (eX.symm _)).2 : ↥(ssPlaces c M K) → ℤ) = _; rw [eX.apply_symm_apply]
  have hext : ∀ z₁ z₂ : Xo, ((eX z₁).1 : ↥(ssPlaces c M K) → ℤ) = ((eX z₂).1 : ↥(ssPlaces c M K) → ℤ) →
      ((eX z₁).2 : ↥(ssPlaces c M K) → ℤ) = ((eX z₂).2 : ↥(ssPlaces c M K) → ℤ) → z₁ = z₂ :=
    fun z₁ z₂ h₁ h₂ => eX.injective (Prod.ext (Subtype.ext h₁) (Subtype.ext h₂))
  let δ0 : Lo →+ Xo := AddMonoidHom.mk' (fun l => δE (eL l)) (by
    intro l₁ l₂
    apply hext
    · rw [hδE1, map_add eL, Submodule.coe_add, Matrix.mulVec_add, map_add eX, Prod.fst_add, Submodule.coe_add,
        hδE1, hδE1]
    · rw [hδE2, map_add eL, Submodule.coe_add, Matrix.mulVec_add, map_add eX, Prod.snd_add, Submodule.coe_add,
        hδE2, hδE2])
  have hval1 : ∀ l, ((eX (δ0 l)).1 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) :=
    fun l => hδE1 (eL l)
  have hval2 : ∀ l, ((eX (δ0 l)).2 : ↥(ssPlaces c M K) → ℤ) = (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) :=
    fun l => hδE2 (eL l)
  have hgen := sw3_delta_hgen hs X hX n hcol eL hL eX hTX hUX hC3 δ0 hval1 hval2
  exact ⟨{ toFun := fun l => δ0 l, map_add' := δ0.map_add, map_smul' := fun r y => sw3_smul_of_gen δ0 hgen r y },
    fun l => ⟨hval1 l, hval2 l⟩⟩

private theorem sw3_smul_top_transfer {R : Type*} [CommRing R] (I : Ideal R)
    {Q X : Type*} [AddCommGroup Q] [Module R Q] [AddCommGroup X] [Module R X] [Module.Finite R X]
    (g : Q →ₗ[R] X) (hg : Function.Injective g) (hX : (I • ⊤ : Submodule R X) = ⊤) :
    (I • ⊤ : Submodule R Q) = ⊤ := by
  obtain ⟨r, hr1, hr⟩ := Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul I (⊤ : Submodule R X)
    Module.Finite.fg_top (by rw [hX])
  refine eq_top_iff.mpr fun z _ => ?_
  have hz : r • z = 0 := hg (by rw [map_smul, map_zero, hr _ Submodule.mem_top])
  have hz' : z = (1 - r) • z := by rw [sub_smul, one_smul, hz, sub_zero]
  rw [hz']
  refine Submodule.smul_mem_smul ?_ Submodule.mem_top
  have := I.neg_mem hr1
  rwa [neg_sub] at this

private theorem sw3_coker_dies_of_old
    {c : ℕ} [Fact c.Prime] {K : Type} [Field K] [CharP K c] [DecidableEq K]
    {M s : ℕ} [NeZero M] [NeZero s] (hs : s.Prime) [Fact s.Prime]
    [Fintype ↥(ssPlaces c (M * s) K)] [Fintype ↥(ssPlaces c M K)] [DecidableEq ↥(ssPlaces c (M * s) K)] [DecidableEq ↥(ssPlaces c M K)]
    (X : SSLevelDatum c K M s) (hX : X.HeckeLaws)
    {Yo : Type} [AddCommGroup Yo] [Module HeckeAlg Yo]
    (eY : Yo ≃+ ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData))
    (n : Nat.Primes → ℤ) (hcol : ∀ ℓ : Nat.Primes, HeckeRowSums (X.edgeHecke ℓ).transpose (n ℓ))
    {Lo : Type} [AddCommGroup Lo] [Module HeckeAlg Lo]
    (eL : Lo ≃+ ↥(characterLattice ↥(ssPlaces c (M * s) K)))
    (hL : ∀ (ℓ : Nat.Primes) (l : Lo),
      eL (heckeGen ℓ • l) = heckeCharacterAction (X.edgeHecke ℓ).transpose (hcol ℓ) (eL l))
    (f : Yo →ₗ[HeckeAlg] Lo)
    (hfval : ∀ y : Yo, ((eL (f y) : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) =
      ((eY y : ↥(CerednikDrinfeld.ribbonKernel X.degeneracyData)) : ↥(ssPlaces c (M * s) K) → ℤ))
    {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (eX : Xo ≃+ (↥(characterLattice ↥(ssPlaces c M K)) × ↥(characterLattice ↥(ssPlaces c M K))))
    (hTX : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → ∀ x : Xo,
        ((eX (heckeGen ℓ • x)).1 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ℓ • x)).2 : ↥(ssPlaces c M K) → ℤ) = (X.vertexHecke ℓ).mulVec ((eX x).2 : ↥(ssPlaces c M K) → ℤ))
    (hUX : ∀ x : Xo,
        ((eX (heckeGen ⟨s, hs⟩ • x)).1 : ↥(ssPlaces c M K) → ℤ) =
            (X.vertexHecke ⟨s, hs⟩).mulVec ((eX x).1 : ↥(ssPlaces c M K) → ℤ) - ((eX x).2 : ↥(ssPlaces c M K) → ℤ) ∧
        ((eX (heckeGen ⟨s, hs⟩ • x)).2 : ↥(ssPlaces c M K) → ℤ) = ((s : ℕ) : ℤ) • ((eX x).1 : ↥(ssPlaces c M K) → ℤ))
    [Module.Finite ℤ Xo]
    (hC3 : (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) =
          (X.vertexHecke ⟨s, hs⟩).mulVec ((CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y) - (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec y) ∧
      (∀ y : ↥(ssPlaces c (M * s) K) → ℤ,
        (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((X.edgeHecke ⟨s, hs⟩).mulVec y) = ((s : ℕ) : ℤ) • (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec y))
    (𝔪 : Ideal HeckeAlg) (hXo : (𝔪 • ⊤ : Submodule HeckeAlg Xo) = ⊤) :
    (𝔪 • ⊤ : Submodule HeckeAlg (Lo ⧸ LinearMap.range f)) = ⊤ := by
  classical
  obtain ⟨δ, hδ⟩ := sw3_exists_delta hs X hX n hcol eL hL eX hTX hUX hC3
  have h1 : LinearMap.range f ≤ LinearMap.ker δ := by
    rintro _ ⟨y, rfl⟩
    rw [LinearMap.mem_ker]
    have hy := (eY y).2
    rw [CerednikDrinfeld.mem_ribbonKernel] at hy
    apply (map_eq_zero_iff eX eX.injective).mp
    refine Prod.ext (Subtype.ext ?_) (Subtype.ext ?_)
    · rw [(hδ (f y)).1, hfval y]
      simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using hy 0
    · rw [(hδ (f y)).2, hfval y]
      simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using hy 1
  have h2 : LinearMap.ker δ ≤ LinearMap.range f := by
    intro l hl
    rw [LinearMap.mem_ker] at hl
    have hz : eX (δ l) = 0 := by rw [hl, map_zero]
    have ha : (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.a).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) = 0 := by
      rw [← (hδ l).1, hz]; rfl
    have hb : (CerednikDrinfeld.degeneracyMatrix X.degeneracyData.b).mulVec ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) = 0 := by
      rw [← (hδ l).2, hz]; rfl
    have hmem : ((eL l : ↥(characterLattice ↥(ssPlaces c (M * s) K))) : ↥(ssPlaces c (M * s) K) → ℤ) ∈ CerednikDrinfeld.ribbonKernel X.degeneracyData := by
      rw [CerednikDrinfeld.mem_ribbonKernel]
      intro i
      fin_cases i
      · simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using ha
      · simpa [CerednikDrinfeld.jointDelta, CerednikDrinfeld.pushforward] using hb
    refine ⟨eY.symm ⟨_, hmem⟩, ?_⟩
    apply eL.injective
    apply Subtype.ext
    rw [hfval, eY.apply_symm_apply]
  haveI : IsScalarTower ℤ HeckeAlg Xo := sw3_tower Xo
  haveI : Module.Finite HeckeAlg Xo := Module.Finite.of_restrictScalars_finite ℤ HeckeAlg Xo
  exact sw3_smul_top_transfer 𝔪 ((LinearMap.range f).liftQ δ h1)
    (LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ _ h2)) hXo

