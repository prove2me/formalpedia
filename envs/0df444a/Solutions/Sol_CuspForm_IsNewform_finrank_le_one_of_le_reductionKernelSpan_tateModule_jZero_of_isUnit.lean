private theorem seqπ_eq_zero_iff (x : ℕ → J) (hx : ∀ k, x k ∈ lvl J p k) (k : ℕ) :
    seqπ p f hfin x hx k = 0 ↔ ∃ n, (f ^ n) (x k) = 0 := by
