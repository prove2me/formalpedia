-- title:
--   Finite qubit gate libraries $G=(U_1,\dots,U_t)$, unitarity, algebraicity, and $\Gamma=G\cup G^\dagger$
-- statement:
--   A **gate library** $G=(U_1,\dots,U_t)$ is a finite list of complex matrices: gate $U_j$ acts on $k_j\ge 1$ qubits and is a $2^{k_j}\times 2^{k_j}$ matrix whose rows and columns are indexed by bit strings $y,x\in\{0,1\}^{k_j}$, with entry $\langle y|U_j|x\rangle$. Repeated gates and the empty library ($t=0$) are allowed.
--
--   1. $G$ is **unitary** if every $U_j$ is unitary.
--   2. $G$ is **algebraic** if every entry of every $U_j$ is an algebraic number.
--   3. The **adjoint library** $\Gamma=G\cup G^\dagger$ lists, for each $j$, the gate $U_j$ followed by its conjugate transpose $U_j^\dagger$ on the same number of qubits.
--
--   These are the fixed data of the exact amplitude problem: the library is fixed, and only circuits over it vary.
--
--   **Formalization Note** In $\Gamma$, gate $2j$ is $U_j$ and gate $2j+1$ is $U_j^\dagger$.
-- source:
--   Liu–Meng, A Dichotomy for Exact Quantum Circuit Amplitudes, STOC 2027 submission (held manuscript, sha256 40ad9c68…), Theorem 1.1 and §1.1, p.2 (PDF p.3); App. A.1, p.18 (PDF p.19); App. G, p.51 (PDF p.52); Proposition B.7, p.26 (PDF p.27) for Γ = G ∪ G†

import Mathlib
import Definitions.Def_QAlgorithms_Defs_Basic

set_option autoImplicit false

namespace ExactAmpDich

open QAlgorithms

/-- A **fixed finite library of qubit gates** `G = (U₁, …, U_t)`: gate `j` acts on `k j ≥ 1`
qubits and is given by its `2^{k j} × 2^{k j}` complex matrix, indexed by bit strings
`Qubits (k j) = Fin (k j) → Bool` (row = output string, column = input string).
Liu–Meng, *A Dichotomy for Exact Quantum Circuit Amplitudes*, STOC 2027 submission (held
manuscript, sha256 40ad9c68…), §1.1, p.2 (PDF p.3): "a fixed finite library G of unitary qubit
gates"; App. A.1, p.18 (PDF p.19): "A circuit over a fixed finite library G = {U1, . . . , Us}";
App. G, p.51 (PDF p.52): "Fix a nonempty library G = (U1, . . . , Ut), in which Uj acts on kj
qubits … For an empty library, every circuit is the identity".

**Formalization Note.** The library is an indexed family, so repeated gates and the empty
library (`t = 0`) are allowed. Unitarity and algebraicity are separate predicates
(`Library.IsUnitary`, `Library.IsAlgebraic`), carried as hypotheses by every theorem. -/
structure Library where
  /-- The number of gates. -/
  t : ℕ
  /-- The number of qubits gate `j` acts on. -/
  k : Fin t → ℕ
  /-- Every gate acts on at least one qubit. -/
  one_le_k : ∀ j, 1 ≤ k j
  /-- The matrix of gate `j`; entry `(y, x)` is `⟨y|U_j|x⟩`. -/
  U : (j : Fin t) → Matrix (Qubits (k j)) (Qubits (k j)) ℂ

/-- Every gate of the library is unitary. Liu–Meng, §1.1, p.2: "a fixed finite library G of
unitary qubit gates". -/
def Library.IsUnitary (L : Library) : Prop :=
  ∀ j, L.U j ∈ Matrix.unitaryGroup (Qubits (L.k j)) ℂ

/-- Every gate entry is an algebraic number. Liu–Meng, App. A.1, p.18 (PDF p.19): "For an
algebraic gate library, let K be the number field generated by its entries". -/
def Library.IsAlgebraic (L : Library) : Prop :=
  ∀ j y x, _root_.IsAlgebraic ℚ (L.U j y x)

/-- The library `Γ = G ∪ G†` of the gates and their adjoints. Liu–Meng, Proposition B.7, p.26
(PDF p.27): "set Γ = G ∪G†".

**Formalization Note.** Gate `2j` of `Γ` is `U_j` and gate `2j + 1` is `U_j†`
(`Matrix.conjTranspose`). -/
noncomputable def Library.adjoint (L : Library) : Library where
  t := 2 * L.t
  k j := L.k ⟨j.val / 2, Nat.div_lt_of_lt_mul j.isLt⟩
  one_le_k _ := L.one_le_k _
  U j := if j.val % 2 = 0 then L.U ⟨j.val / 2, Nat.div_lt_of_lt_mul j.isLt⟩
    else (L.U ⟨j.val / 2, Nat.div_lt_of_lt_mul j.isLt⟩).conjTranspose

end ExactAmpDich


