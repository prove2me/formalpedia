def centerBLowerYBox : DyadicInterval precision := ⟨8525578457517488991908807741348392227474100256038, 8525578457517488991908807741348392227474109230955⟩
def centerBLowerInput : Inputs precision :=
  ⟨centerBLowerAlpha, centerBLowerExp, centerBLowerLog, endpointLogTwo⟩
def centerBLowerExpWitness : ExpWitness precision :=
  ⟨87936498323453739023942818534544665008268174074, scale precision, 87936498323453739023942818534544665008268305147, scale precision,
    0, 1024, 0, 1024, ⟨-4107703459839463323782244320940382247708280097498, -4107703459839463323782244320940382247708280095364⟩, ⟨-4107703459839463323782244320940382247708277919062, -4107703459839463323782244320940382247708277916940⟩⟩

theorem centerBLower_primitive_checks :
    expBoxCheck ((ofInt precision (-2)).mul centerBLowerAlpha) centerBLowerExp centerBLowerExpWitness = true ∧
    logBoxCheck ((ofInt precision 1).add centerBLowerExp) centerBLowerLog fastLogWitness = true := by decide +kernel

theorem centerBLower_denominators : DenominatorsPositive centerBLowerInput := by
  unfold DenominatorsPositive
  decide +kernel

theorem centerBLower_yBox_eq : (yBox centerBLowerInput).d0 = centerBLowerYBox := by decide +kernel

theorem centerBLower_contains :
    centerBLowerYBox.Contains (Y (lower E8TAxisZero0057PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0057PaddedInputs.centerBInput.alpha = ((2053851729919731661891122160470191123854139503309 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
  have ha : centerBLowerInput.alpha.Contains (lower E8TAxisZero0057PaddedInputs.centerBInput.alpha) := by
    rw [e]; exact point_contains precision 2053851729919731661891122160470191123854139503309
  have h := checked_yBox_d0_contains (i := centerBLowerInput) (we := centerBLowerExpWitness)
    (wl := fastLogWitness) (wL := fastLogWitness)
    centerBLower_primitive_checks.1 centerBLower_primitive_checks.2 endpointLogTwo_checked
    centerBLower_denominators ha
  rw [centerBLower_yBox_eq] at h
  exact h

