theorem solution {P : Program} {c : ℕ} (h : Has40 P)
    (h54 : P[Proc.preCore]? = some preCoreBodyP)
    (hShared : ∀ lim, Std lim → Sec2.SharedSpecP lim P c) : ∀ lim, PreCoreSpecP lim P c :=
  fun lim p t hmL aX aY b0 X Y U μ ht hlim =>
    preCoreSpec_of h h54 hlim.std (hShared lim hlim.std) p t hmL aX aY b0 X Y U μ ht hlim
end
