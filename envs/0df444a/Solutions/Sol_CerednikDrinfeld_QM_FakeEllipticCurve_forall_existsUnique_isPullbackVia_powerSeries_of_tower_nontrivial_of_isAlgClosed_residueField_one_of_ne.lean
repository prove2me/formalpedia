  refine ⟨fun x y _ => Subsingleton.elim x y, fun y => ⟨fun _ => Gpt.const ψk, funext fun ρ => ?_⟩⟩
  obtain ⟨d, hd⟩ := Quotient.exists_rep (y ρ)
  rw [← hd]
  exact Quotient.sound (Defm.rel_of_residueField ρ _ d)

