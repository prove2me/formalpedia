  let MG := arithmeticRestrictGT U M
  let LL := arithmeticRestrictLE V L
  let LG := arithmeticRestrictGT V L
  have hM : ML + MG = M := arithmeticRestrictLE_add_GT U M
  have hL : LL + LG = L := arithmeticRestrictLE_add_GT V L
