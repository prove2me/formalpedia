/-- The cubic magnetic potential: the accepted solver with solver parameter `0` and source `q3_j`. -/
noncomputable def cj (j : ℝ) : ℝ → ℝ := bfun 0 (q3j j)

/-- The cubic rotation: the accepted solver with solver parameter `0` and sources `q3_j`, `r3_j`. -/
noncomputable def dj (j : ℝ) : ℝ → ℝ := vfun 0 (q3j j) (r3j j)

/-- The frozen far-field coefficient of the cubic response. -/
noncomputable def sigma3 (j : ℝ) : ℝ := sigmaB 0 (q3j j)

