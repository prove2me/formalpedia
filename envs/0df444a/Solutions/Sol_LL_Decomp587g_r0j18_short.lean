def D_den : Nat := 89667072
def A_num : Nat := 30919680
def B_num : Nat := 36748800
def C_num : Nat := 40757760
def S_sc  : Nat := 1000000000
def TARGET_S2 : Nat := 155569000000000
def D2 : Nat := D_den * D_den
def TwoD : Nat := 2 * D_den
def TwelveD3 : Nat := 12 * D_den * D_den * D_den

def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

def log1pNat (p q : Nat) : Nat :=
  if p == 0 then 0 else ceilDiv (S_sc * p * (6 * q + p)) (q * (6 * q + 4 * p))

def WNat (s_n : Nat) : Nat :=
  if s_n <= A_num + B_num then
    if s_n <= 2 * A_num then 0
    else
      let p := s_n - 2 * A_num
      ceilDiv (S_sc * D_den * p * (6 * A_num + p)) (s_n * A_num * (6 * A_num + 4 * p))
  else
    if 2 * B_num <= s_n then 0
    else
      let p := 2 * B_num - s_n
      let q := s_n - B_num
      ceilDiv (S_sc * D_den * p * (6 * q + p)) (s_n * q * (6 * q + 4 * p))

def gNat (t_n x_n : Nat) : Nat :=
  if t_n <= 3 * x_n then 0
  else
    let R_n := t_n - x_n
    let U_n := min C_num (R_n - x_n)
    if U_n <= x_n then 0
    else
      let p := U_n - x_n
      let l1 := log1pNat p x_n
      let l2 := log1pNat p (R_n - U_n)
      ceilDiv (D2 * (l1 + l2)) (x_n * R_n)

def gmNat (t_lo t_hi x_n : Nat) : Nat :=
  let tp := 2 * x_n + C_num
  if t_hi <= tp then gNat t_hi x_n
  else if tp <= t_lo then gNat t_lo x_n
  else gNat tp x_n

def trapK (t_lo t_hi K xl xr : Nat) : Nat :=
  if xr <= xl then 0
  else
    let dx := xr - xl
    let gl := gmNat t_lo t_hi xl
    let gr := gmNat t_lo t_hi xr
    let trap := ceilDiv ((gl + gr) * dx) TwoD
    let err := if K == 0 then 0 else ceilDiv (S_sc * K * dx * dx * dx) TwelveD3
    trap + err

def evalInterval (t_lo t_hi xa xb xc xl xr : Nat) : Nat :=
  trapK t_lo t_hi 55 xl (min xr xa) +
  trapK t_lo t_hi 0 (max xl xa) (min xr xb) +
  trapK t_lo t_hi 110 (max xl xb) (min xr xc)

def sumUpTo : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | n + 1, f => sumUpTo n f + f n

def HBoxNat (t_lo t_hi M2 : Nat) : Nat :=
  let xa := if C_num < t_lo then (t_lo - C_num) / 2 else 0
  let xb := if C_num < t_hi then (t_hi - C_num) / 2 else 0
  let xc := t_hi / 3
  let hx := (C_num - B_num) / M2
  sumUpTo M2 fun m =>
    let xl := B_num + m * hx
    evalInterval t_lo t_hi xa xb xc xl (xl + hx)

def checkWGo (hs half : Nat) : Nat → Nat → List Nat → Bool
  | 0, _, [] => true
  | k + 1, i, w :: rest =>
    let sl := 2 * A_num + i * hs
    let sr := sl + hs
    let w_req := if i < half then ceilDiv (WNat (sl + hs / 2) * hs) D_den
                 else ceilDiv ((WNat sl + WNat sr) * hs) TwoD
    decide (w_req ≤ w) && checkWGo hs half k (i + 1) rest
  | _, _, _ => false

def checkW (Ns : Nat) (W : List Nat) : Bool :=
  checkWGo ((2 * B_num - 2 * A_num) / Ns) (Ns / 2) Ns 0 W

def checkHGo (phi0 hs M2 mult : Nat) : Nat → List Nat → Bool
  | 0, [] => true
  | j + 1, h :: rest =>
    let t_lo := phi0 + j * hs - 2 * B_num
    let t_hi := t_lo + (mult + 1) * hs
    decide (HBoxNat t_lo t_hi M2 ≤ h) && checkHGo phi0 hs M2 mult j rest
  | _, _ => false

def checkH (phi0 Ns M2 mult nSlices : Nat) (Hrev : List Nat) : Bool :=
  checkHGo phi0 ((2 * B_num - 2 * A_num) / Ns) M2 mult (Ns + (nSlices - 1) * mult) Hrev

def dotList : List Nat → List Nat → Nat → Nat
  | [], _, acc => acc
  | _, [], acc => acc
  | x :: xs, y :: ys, acc => dotList xs ys (acc + x * y)

def checkSlices : Nat → Nat → List Nat → List Nat → Bool
  | 0, _, _, _ => true
  | k + 1, mult, W, Hrev =>
    decide (dotList W Hrev 0 ≤ TARGET_S2) && checkSlices k mult W (Hrev.drop mult)

