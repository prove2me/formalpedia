/-! ## Arithmetic -/

theorem size3_sq_le (V : ℕ) : (Nat.size V + 3) ^ 2 ≤ 146 * (V + 1) := by
  rcases Nat.eq_zero_or_pos V with rfl | hV
  · simp
  · have h := size_sq_le V hV
    nlinarith

theorem cTot_le_sol_aux (w f V : ℕ) :
    cTot w f V ≤ C0fine * ((w + 1) * (V + 1) * (f + 1) + (Nat.size V + w + f + 4) ^ 2) := by
  set Zv := Nat.size V + 2 with hZv
  set Zd := Nat.size V + w + f + 4 with hZd
  have u1 := cU_le Zv
  have u2 := cU_le Zd
  have hZ3 : (Zv + 1) ^ 2 ≤ 146 * (V + 1) := size3_sq_le V
  have hZd1 : (Zd + 1) ^ 2 ≤ 4 * Zd ^ 2 := by
    have : Zd + 1 ≤ 2 * Zd := by omega
    calc (Zd + 1) ^ 2 ≤ (2 * Zd) ^ 2 := Nat.pow_le_pow_left this 2
      _ = 4 * Zd ^ 2 := by ring
  have hk : kap w ≤ 200 * (w + 1) := by unfold kap; omega
  set W3 := (w + 1) * (V + 1) * (f + 1) with hW3
  have hU1 : cU Zv ≤ 146 * (CU * (V + 1)) := by
    calc cU Zv ≤ CU * (146 * (V + 1)) := le_trans u1 (Nat.mul_le_mul_left _ hZ3)
      _ = 146 * (CU * (V + 1)) := by ring
  have hU2 : cU Zd ≤ 4 * (CU * Zd ^ 2) := by
    calc cU Zd ≤ CU * (4 * Zd ^ 2) := le_trans u2 (Nat.mul_le_mul_left _ hZd1)
      _ = 4 * (CU * Zd ^ 2) := by ring
  have hV3 : V + 1 ≤ W3 := by
    have h1 : V + 1 ≤ (w + 1) * (V + 1) := Nat.le_mul_of_pos_left _ (by omega)
    have h2 : (w + 1) * (V + 1) ≤ W3 := Nat.le_mul_of_pos_right _ (by omega)
    omega
  have t1 : (f + 1) * (kap w * V) ≤ 200 * W3 := by
    calc (f + 1) * (kap w * V) ≤ (f + 1) * ((200 * (w + 1)) * (V + 1)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul hk (by omega))
      _ = 200 * W3 := by rw [hW3]; ring
  have t2 : (f + 1) * V ≤ W3 := by
    calc (f + 1) * V ≤ (f + 1) * ((w + 1) * (V + 1)) :=
          Nat.mul_le_mul_left _ (by nlinarith)
      _ = W3 := by rw [hW3]; ring
  have t3 : f + 1 ≤ W3 := by
    calc f + 1 ≤ (w + 1) * (V + 1) * (f + 1) := Nat.le_mul_of_pos_left _ (by positivity)
      _ = W3 := rfl
  have t4 : (f + 1) * cU Zv ≤ 146 * (CU * W3) := by
    calc (f + 1) * cU Zv ≤ (f + 1) * (146 * (CU * ((w + 1) * (V + 1)))) :=
          Nat.mul_le_mul_left _ (le_trans hU1 (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _
            (Nat.le_mul_of_pos_left _ (by omega)))))
      _ = 146 * (CU * W3) := by rw [hW3]; ring
  have t5 : cU Zv ≤ 146 * (CU * W3) :=
    le_trans hU1 (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hV3))
  unfold cTot cCore cIt C0fine
  rw [← hZv, ← hZd]
  have ex : 12 * cU Zv + (f + 1) * (44 * (kap w * V) + 8000 * V + 9000 + 8 * cU Zv + 6400) =
      12 * cU Zv + 44 * ((f + 1) * (kap w * V)) + 8000 * ((f + 1) * V) + 15400 * (f + 1) +
        8 * ((f + 1) * cU Zv) := by ring
  have er : (40000 + 3000 * CU) * (W3 + Zd ^ 2) =
      40000 * W3 + 40000 * Zd ^ 2 + 3000 * (CU * W3) + 3000 * (CU * Zd ^ 2) := by ring
  rw [ex, er]
  clear_value W3 Zv Zd
  clear u1 u2 hZ3 hZd1 hk hU1 hV3 hW3 hZv hZd ex er
  generalize (f + 1) * (kap w * V) = P1 at *
  generalize (f + 1) * V = P2 at *
  generalize (f + 1) * cU Zv = P3 at *
  generalize CU * W3 = KW at *
  generalize CU * Zd ^ 2 = KQ at *
  generalize Zd ^ 2 = Q at *
  generalize cU Zv = A at *
  generalize cU Zd = B at *
  omega

