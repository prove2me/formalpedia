namespace H1Curve

theorem exists_emb (N : ℕ) [NeZero N] (hN1 : 1 < N) (L : Type) [Field L] [CharZero L] [IsCyclotomicExtension {N} ℚ L]
    (ξ : L) (hξ : IsPrimitiveRoot ξ N) :
    ∃ ι : L →+* ℂ, ι ξ = Complex.exp (2 * Real.pi * Complex.I / N) := by
  set z := IsCyclotomicExtension.zeta N ℚ L with hzdef
  have hz : IsPrimitiveRoot z N := IsCyclotomicExtension.zeta_spec N ℚ L
  obtain ⟨k, -, hk⟩ := hz.eq_pow_of_pow_eq_one hξ.pow_eq_one
  have hkcop : k.Coprime N := (hz.pow_iff_coprime (NeZero.pos N) k).mp (hk ▸ hξ)
  set uk : (ZMod N)ˣ := ZMod.unitOfCoprime k hkcop with huk
  set k' : ℕ := ((uk⁻¹ : (ZMod N)ˣ) : ZMod N).val with hk'
  have hk'cop : k'.Coprime N := ZMod.val_coe_unit_coprime _
  set e : ℂ := Complex.exp (2 * Real.pi * Complex.I / N) with hedef
  have he : IsPrimitiveRoot e N := Complex.isPrimitiveRoot_exp N (NeZero.ne N)
  have he' : IsPrimitiveRoot (e ^ k') N := he.pow_of_coprime k' hk'cop
  obtain ⟨φ, hφ⟩ := IsPrimitiveRoot.exists_ringHom_zeta_eq_of_isCyclotomicExtension N L ℂ (e ^ k') he'
  refine ⟨φ, ?_⟩
  have hmod : (k' * k) % N = 1 := by
    have h1 : ((k' * k : ℕ) : ZMod N) = ((1 : ℕ) : ZMod N) := by
      rw [Nat.cast_mul, hk', ZMod.natCast_zmod_val,
        show ((k : ℕ) : ZMod N) = (uk : ZMod N) from (ZMod.coe_unitOfCoprime k hkcop).symm,
        Units.inv_mul, Nat.cast_one]
    rw [ZMod.natCast_eq_natCast_iff'] at h1
    rw [h1, Nat.mod_eq_of_lt hN1]
  rw [← hk, map_pow, hφ, ← pow_mul, ← Nat.div_add_mod (k' * k) N, pow_add, pow_mul, he.pow_eq_one, one_pow,
    one_mul, hmod, pow_one]

end H1Curve

namespace SelectBAux

theorem exists_gamma0_gamma_diag_zero (q : ℕ) [hq : Fact q.Prime] (M' ℓ' : ℕ) [NeZero M'] [hℓ : Fact ℓ'.Prime]
    (hqM' : ¬ q ∣ M') (hℓ'q : ℓ' ≠ q) :
    ∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma0 M' ∧ γ ∈ CongruenceSubgroup.Gamma ℓ' ∧
      (((γ 0 0 : ℤ) : ZMod q) = 0 ∧ ((γ 1 1 : ℤ) : ZMod q) = 0) := by

  have hqℓ : (q : ℤ).gcd ℓ' = 1 := by
    rw [Int.gcd_natCast_natCast]
    exact (Nat.coprime_primes hq.out hℓ.out).mpr (Ne.symm hℓ'q)
  have hqM : (q : ℤ).gcd M' = 1 := by
    rw [Int.gcd_natCast_natCast]
    exact (Nat.Prime.coprime_iff_not_dvd hq.out).mpr hqM'
  have hcop1 : IsCoprime ((M' : ℤ) * ℓ') (q : ℤ) := by
    refine IsCoprime.mul_left ?_ ?_
    · exact (Int.isCoprime_iff_gcd_eq_one.mpr (by rw [Int.gcd_comm]; exact hqM))
    · exact (Int.isCoprime_iff_gcd_eq_one.mpr (by rw [Int.gcd_comm]; exact hqℓ))
  have hcop2 : IsCoprime (q : ℤ) (ℓ' : ℤ) := Int.isCoprime_iff_gcd_eq_one.mpr hqℓ
  obtain ⟨u, v, h1⟩ := hcop1
  obtain ⟨x, y, h2⟩ := hcop2

  have hdet : Matrix.det !![v * q, -u + u * (x * q - y * ℓ') * (v * q); (M' : ℤ) * ℓ', 1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ')] = 1 := by
    rw [Matrix.det_fin_two_of]
    linear_combination (1 : ℤ) * h1
  refine ⟨⟨_, hdet⟩, ?_, ?_, ?_, ?_⟩
  ·
    rw [CongruenceSubgroup.Gamma0_mem]
    show ((((M' : ℤ) * ℓ') : ℤ) : ZMod M') = 0
    push_cast; rw [ZMod.natCast_self, zero_mul]
  ·
    rw [CongruenceSubgroup.Gamma_mem]
    have e1 : (v : ZMod ℓ') * q = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod ℓ')) h1; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    have e2 : (x : ZMod ℓ') * q = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod ℓ')) h2; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    refine ⟨?_, ?_, ?_, ?_⟩
    · show (((v * q : ℤ)) : ZMod ℓ') = 1
      push_cast; exact e1
    · show (((-u + u * (x * q - y * ℓ') * (v * q) : ℤ)) : ZMod ℓ') = 0
      push_cast; rw [ZMod.natCast_self]
      linear_combination (u * x * q) * e1 + u * e2
    · show ((((M' : ℤ) * ℓ' : ℤ)) : ZMod ℓ') = 0
      push_cast; rw [ZMod.natCast_self, mul_zero]
    · show (((1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ') : ℤ)) : ZMod ℓ') = 1
      push_cast; rw [ZMod.natCast_self]; ring
  · show (((v * q : ℤ)) : ZMod q) = 0
    push_cast; rw [ZMod.natCast_self, mul_zero]
  · show (((1 + u * (x * q - y * ℓ') * ((M' : ℤ) * ℓ') : ℤ)) : ZMod q) = 0
    have e3 : (u : ZMod q) * (M' * ℓ') = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod q)) h1; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    have e4 : (y : ZMod q) * ℓ' = 1 := by
      have := congrArg (fun z : ℤ => (z : ZMod q)) h2; push_cast at this; rw [ZMod.natCast_self] at this
      linear_combination this
    push_cast; rw [ZMod.natCast_self]
    linear_combination (-(y : ZMod q) * ℓ') * e3 - e4

end SelectBAux

namespace WRGlue
open IsLocalRing

theorem charP_residueField_of_natCast_mem (R : Type*) [CommRing R] [IsLocalRing R] (q : ℕ) [hq : Fact q.Prime]
    (h : (q : R) ∈ maximalIdeal R) : CharP (ResidueField R) q := by
  have h0 : ((q : ℕ) : ResidueField R) = 0 := by
    rw [← map_natCast (IsLocalRing.residue R), IsLocalRing.residue_eq_zero_iff]; exact h
  exact (CharP.charP_iff_prime_eq_zero hq.out).mpr h0

theorem isUnit_natCast_of_not_dvd (R : Type*) [CommRing R] [IsLocalRing R] (q : ℕ) [hq : Fact q.Prime]
    (h : (q : R) ∈ maximalIdeal R) (n : ℕ) (hn : ¬ q ∣ n) : IsUnit (n : R) := by
  haveI := charP_residueField_of_natCast_mem R q h
  by_contra hnu
  have hmem : (n : R) ∈ maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
  have h0 : ((n : ℕ) : ResidueField R) = 0 := by
    rw [← map_natCast (IsLocalRing.residue R), IsLocalRing.residue_eq_zero_iff]; exact hmem
  exact hn ((CharP.cast_eq_zero_iff (ResidueField R) q n).mp h0)

end WRGlue

namespace WRConsts

theorem isUnit_one_sub_of_pow_eq_one {A : Type} [CommRing A] [IsLocalRing A]
    (ℓ : ℕ) (hℓ : IsUnit ((ℓ : ℕ) : A)) (u : A) (hu : u ^ ℓ = 1) (hu1 : u ≠ 1) : IsUnit (1 - u) := by
  classical
  by_contra hnu
  have hmem : 1 - u ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr hnu

  have hgeom : (∑ i ∈ Finset.range ℓ, u ^ i) * (u - 1) = u ^ ℓ - 1 := geom_sum_mul u ℓ
  have hres1 : IsLocalRing.residue A u = 1 := by
    have h := (Ideal.Quotient.eq_zero_iff_mem).mpr hmem
    rw [map_sub, map_one, sub_eq_zero] at h
    exact h.symm
  have hsumU : IsUnit (∑ i ∈ Finset.range ℓ, u ^ i) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    rw [map_sum]
    simp only [map_pow, hres1, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
    intro h0
    apply (IsLocalRing.mem_maximalIdeal _).mp _ hℓ
    exact (Ideal.Quotient.eq_zero_iff_mem).mp (by simp at h0 ⊢; exact h0)
  have hzero : (∑ i ∈ Finset.range ℓ, u ^ i) * (u - 1) = 0 := by rw [hgeom, hu, sub_self]
  have : u - 1 = 0 := by
    have := hsumU.mul_right_eq_zero.mp hzero
    exact this
  exact hu1 (sub_eq_zero.mp this)

theorem consts (q ℓ : ℕ) [Fact q.Prime] [Fact ℓ.Prime] (hℓ5 : 5 ≤ ℓ) (hℓq : ℓ ≠ q)
    (L : Type) [Field L] [CharZero L] (ξ : L) (hξ : IsPrimitiveRoot ξ (q * ℓ))
    (A : Type) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Algebra A L] [IsFractionRing A L]
    (hAq : (q : A) ∈ IsLocalRing.maximalIdeal A) :
    ∃ ξA : Aˣ, algebraMap A L (ξA : A) = ξ ∧
      (∀ n : ℕ, Units.map (↑(algebraMap A L) : A →* L) (ξA ^ n) =
        (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit ^ n) ∧
      IsUnit (1 - ((ξA ^ q : Aˣ) : A)) ∧
      IsUnit (1 - ((ξA ^ q : Aˣ) : A) ^ 2) ∧
      IsUnit (((ξA ^ q : Aˣ) : A) - ((ξA ^ q : Aˣ) : A) ^ 2) ∧
      IsUnit (1 - ((ξA ^ q : Aˣ) : A) ^ 3) ∧
      IsUnit (1 - ((ξA ^ ℓ : Aˣ) : A) * ((ξA ^ q : Aˣ) : A)) ∧
      (((ξA ^ ℓ : Aˣ) : A) - 1) ∈ IsLocalRing.maximalIdeal A := by
  classical
  have hqP : q.Prime := Fact.out
  have hℓP : ℓ.Prime := Fact.out
  have hqℓ0 : q * ℓ ≠ 0 := Nat.mul_ne_zero hqP.ne_zero hℓP.ne_zero
  have hinj : Function.Injective (algebraMap A L) := IsFractionRing.injective A L

  have hint : IsIntegral A ξ := by
    refine ⟨Polynomial.X ^ (q * ℓ) - 1, Polynomial.monic_X_pow_sub_C 1 hqℓ0, ?_⟩
    simp [hξ.pow_eq_one]
  obtain ⟨x, hx⟩ := (IsIntegrallyClosed.isIntegral_iff (R := A) (K := L)).mp hint
  have hxpow : x ^ (q * ℓ) = 1 := hinj (by rw [map_pow, hx, hξ.pow_eq_one, map_one])
  have hxU : IsUnit x := IsUnit.of_pow_eq_one hxpow hqℓ0
  set ξA : Aˣ := hxU.unit with hξAdef
  have hξA : (ξA : A) = x := hxU.unit_spec
  have hξAL : algebraMap A L (ξA : A) = ξ := by rw [hξA, hx]

  have hdvd : ∀ k : ℕ, ((ξA ^ k : Aˣ) : A) = 1 → q * ℓ ∣ k := by
    intro k hk
    apply (hξ.pow_eq_one_iff_dvd k).mp
    rw [← hξAL, ← map_pow, ← Units.val_pow_eq_pow_val, hk, map_one]

  have hℓA : IsUnit ((ℓ : ℕ) : A) := by
    by_contra h
    have hmem : ((ℓ : ℕ) : A) ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr h
    have hcop : Nat.Coprime ℓ q := (Nat.coprime_primes hℓP hqP).mpr hℓq
    obtain ⟨a, b, hab⟩ := Nat.isCoprime_iff_coprime.mpr hcop
    have h1 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
      have : (a : A) * (ℓ : A) + (b : A) * (q : A) = 1 := by exact_mod_cast congrArg (Int.cast : ℤ → A) hab
      rw [← this]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hmem) (Ideal.mul_mem_left _ _ hAq)
    exact (Ideal.ne_top_iff_one _).mp (IsLocalRing.maximalIdeal.isMaximal A).ne_top h1

  set c : A := ((ξA ^ q : Aˣ) : A) with hcdef
  have hcℓ : c ^ ℓ = 1 := by
    rw [hcdef, Units.val_pow_eq_pow_val, ← pow_mul, hξA, hxpow]
  have hcpow : ∀ k : ℕ, (c ^ k) ^ ℓ = 1 := by
    intro k
    rw [← pow_mul, mul_comm, pow_mul, hcℓ, one_pow]
  have hcne : ∀ k : ℕ, 0 < k → k < ℓ → c ^ k ≠ 1 := by
    intro k hk hkℓ h
    have h' : ((ξA ^ (q * k) : Aˣ) : A) = 1 := by
      rw [pow_mul, Units.val_pow_eq_pow_val]
      show ((ξA ^ q : Aˣ) : A) ^ k = 1
      rw [← hcdef, h]
    have := hdvd (q * k) h'
    have : ℓ ∣ k := (Nat.mul_dvd_mul_iff_left hqP.pos).mp this
    exact absurd (Nat.le_of_dvd hk this) (not_le.mpr hkℓ)
  have hU1 : IsUnit (1 - c) := by
    have := isUnit_one_sub_of_pow_eq_one ℓ hℓA (c ^ 1) (hcpow 1) (hcne 1 one_pos (by omega)); simpa using this
  have hU2 : IsUnit (1 - c ^ 2) := isUnit_one_sub_of_pow_eq_one ℓ hℓA (c ^ 2) (hcpow 2) (hcne 2 two_pos (by omega))
  have hU3 : IsUnit (1 - c ^ 3) := isUnit_one_sub_of_pow_eq_one ℓ hℓA (c ^ 3) (hcpow 3) (hcne 3 (by norm_num) (by omega))
  have hcU : IsUnit c := by rw [hcdef]; exact Units.isUnit _
  have hU12 : IsUnit (c - c ^ 2) := by
    have : c - c ^ 2 = c * (1 - c) := by ring
    rw [this]; exact hcU.mul hU1

  set ζ' : A := ((ξA ^ ℓ : Aˣ) : A) with hζdef
  have hζq : ζ' ^ q = 1 := by
    rw [hζdef, Units.val_pow_eq_pow_val, ← pow_mul, mul_comm ℓ q, hξA, hxpow]
  have hζm : ζ' - 1 ∈ IsLocalRing.maximalIdeal A := by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    haveI : Nontrivial (IsLocalRing.ResidueField A) := inferInstance
    haveI hchar : CharP (IsLocalRing.ResidueField A) q := by
      rw [CharP.charP_iff_prime_eq_zero hqP]
      exact (Ideal.Quotient.eq_zero_iff_mem).mpr hAq
    have h1 : (IsLocalRing.residue A ζ' - 1) ^ q = 0 := by
      rw [sub_pow_char, ← map_pow, hζq, map_one, one_pow, sub_self]
    have h2 : IsLocalRing.residue A ζ' - 1 = 0 := pow_eq_zero_iff (hqP.ne_zero) |>.mp h1
    show Ideal.Quotient.mk _ (ζ' - 1) = 0
    simp [map_sub] at h2 ⊢
    exact h2
  have hU7 : IsUnit (1 - ζ' * c) := by
    by_contra h
    have hmem : 1 - ζ' * c ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal _).mpr h
    have : 1 - c = (1 - ζ' * c) + c * (ζ' - 1) := by ring
    have h1c : 1 - c ∈ IsLocalRing.maximalIdeal A := by
      rw [this]; exact Ideal.add_mem _ hmem (Ideal.mul_mem_left _ _ hζm)
    exact (IsLocalRing.mem_maximalIdeal _).mp h1c hU1
  refine ⟨ξA, hξAL, ?_, hU1, hU2, hU12, hU3, hU7, hζm⟩
  intro n
  ext
  rw [Units.coe_map, MonoidHom.coe_coe, Units.val_pow_eq_pow_val, map_pow, hξAL, Units.val_pow_eq_pow_val,
    IsUnit.unit_spec]

end WRConsts

namespace TD1Glue

theorem coe_map_eq_one_of_mem_Gamma (N : ℕ) (γ : SL(2, ℤ)) (h : γ ∈ CongruenceSubgroup.Gamma N) :
    ((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ).map (Int.castRingHom (ZMod N)) = 1 := by
  rw [CongruenceSubgroup.Gamma_mem] at h
  obtain ⟨h00, h01, h10, h11⟩ := h
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.map_apply, h00, h01, h10, h11]

theorem coe_inv_apply_00 (γ : SL(2, ℤ)) :
    ((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 0 0 =
      ((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; simp

theorem coe_inv_apply_10 (γ : SL(2, ℤ)) :
    ((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 =
      -((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; simp

theorem coe_inv_apply_11 (γ : SL(2, ℤ)) :
    ((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 =
      ((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 0 0 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; simp

theorem dvd_inv_00_and_isCoprime_inv_10 (q : ℕ) (γ : SL(2, ℤ))
    (h00 : ((((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 0 0 : ℤ) : ZMod q) = 0)
    (h11 : ((((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 : ℤ) : ZMod q) = 0) :
    (q : ℤ) ∣ ((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 0 0 ∧
      IsCoprime (((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 0) (q : ℤ) := by
  rw [coe_inv_apply_00, coe_inv_apply_10]
  obtain ⟨m, hm⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mp h00
  obtain ⟨m', hm'⟩ := (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mp h11
  refine ⟨⟨m', hm'⟩, ?_⟩
  have hdet := Matrix.SpecialLinearGroup.det_coe γ
  rw [Matrix.det_fin_two] at hdet
  refine ⟨((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 0 1,
    m * ((γ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ) 1 1, ?_⟩
  rw [hm] at hdet
  linear_combination hdet

theorem isUnit_det_coe_inv (q : ℕ) (γ : SL(2, ℤ)) :
    IsUnit (((((γ⁻¹ : Matrix.SpecialLinearGroup (Fin 2) ℤ) : Matrix (Fin 2) (Fin 2) ℤ).det : ℤ) : ZMod q)) := by
  rw [Matrix.SpecialLinearGroup.det_coe]; simp

