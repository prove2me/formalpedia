      intro i
      rw [show 𝔐.pointEquivPlace.symm (Ps i) = pC i from 𝔐.pointEquivPlace.symm_apply_apply (pC i)]
      show _ = (CategoryTheory.Limits.pullback.lift (pt _ sbar (d i)).1 (𝟙 _) (hlift i) ≫ inv e𝔐) ≫ e𝔐 ≫ _
      rw [Category.assoc, IsIso.inv_hom_id_assoc, CategoryTheory.Limits.pullback.lift_fst]
    refine ⟨n, K, d, Ps, ?_, ?_, hd, hpts, ?_⟩
    ·
      intro i j hij
      exact hpdC i j ((hG3 (K i) (K j) (Kc i) (Kc j) (hK i) (hK j)).1 hij)
    ·
