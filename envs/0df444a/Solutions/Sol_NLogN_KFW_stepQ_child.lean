      (NLogN.KFW.ES k) (DWc + (NLogN.KFW.ES k + 2) * P8Lift.Wc)
      (NLogN.KFW.cWrapQ P8Lift.Wc (NLogN.KFW.nN Bn t S0 * r) Z (NLogN.KFW.ES k) DWc
        (fun x => NLogN.KFW.cFrame 5 6 Bz + NLogN.KFW.cChildF cIH (NLogN.KFW.cPhZ Z Bz Bn t S0 r) DWc fwd x +
