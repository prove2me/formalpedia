-- title:
--   Spin–statistics: Lorentz group, two-particle operators, composite particles
-- statement:
--   Shared definitions for the spin–statistics mission.
--
--   1. **Minkowski metric.** $\eta = \mathrm{diag}(1,-1,-1,-1)$ on $\mathbb R^4$, coordinate $0$ being time.
--   2. **Lorentz transformation.** A real $4\times 4$ matrix $\Lambda$ with $\Lambda^{\mathsf T}\eta\Lambda = \eta$.
--   3. **Restricted Lorentz group** $SO^+(1,3)$: Lorentz transformations with $\det\Lambda = 1$ and $\Lambda_{00}\ge 1$ (proper and orthochronous). It is the identity component of the Lorentz group and is generated by rotations and boosts. It is encoded as a subset of $M_4(\mathbb R)$.
--   4. **Symmetric / antisymmetric parts** of a two-particle wavefunction $\psi : X\times X\to\mathbb C$:
--   $$\psi_S(x,y)=\tfrac12\big(\psi(x,y)+\psi(y,x)\big),\qquad \psi_A(x,y)=\tfrac12\big(\psi(x,y)-\psi(y,x)\big).$$
--   5. **Two-particle creation operator.** For a finite set $X$ of positions, a complex algebra $A$ (of operators) and a field $\phi : X\to A$,
--   $$\Phi[\psi] \;=\; \sum_{x\ne y}\psi(x,y)\,\phi(x)\phi(y)\in A,$$
--   a discretised version of $\iint\psi(x,y)\phi(x)\phi(y)\,dx\,dy$ over distinct positions.
--   6. **Exchange maps for composites.** Two composites of $k$ constituents each are indexed by $\{0,1\}\times\{0,\dots,k-1\}$ (composite, slot). $\sigma$ swaps the composite label; $\tau_i$ swaps only the two constituents in slot $i$.
--   7. **Addition of angular momenta.** With spins recorded as doubled values $2j\in\mathbb N$, $\mathrm{CanAddTo}(l,J)$ holds when a system of constituents with doubled spins $l$ can have total doubled spin $J$: the empty system has $J=0$, and adding a constituent of doubled spin $a$ to a system of doubled spin $b$ yields exactly the $J$ with $|a-b|\le J\le a+b$ and $J\equiv a+b \pmod 2$ (Clebsch–Gordan rule).
--
--   **Formalization Note.** Positions form a finite type (a lattice discretisation of the integral) and the sum excludes the diagonal $x=y$, matching the source's standing assumption $x\ne y$. The Lorentz group is a `Set` of matrices rather than a bundled subgroup; theorems quantify over its elements.
-- source:
--   Wikipedia, "Spin–statistics theorem" (https://en.wikipedia.org/wiki/Spin%E2%80%93statistics_theorem), PDF snapshot supplied by the proposal owner; sections 'Exchange symmetry or permutation symmetry' (p. 2), 'Relation to representation theory of the Lorentz group' and 'Composite particles' (p. 4)

import Mathlib

namespace SpinStatistics

/-! ### Relativity: the Minkowski metric and the restricted Lorentz group -/

/-- The Minkowski metric `η = diag(1, -1, -1, -1)` on `ℝ⁴` (signature `(+,-,-,-)`,
coordinate `0` is time). -/
noncomputable def minkowskiMetric : Matrix (Fin 4) (Fin 4) ℝ :=
  Matrix.diagonal ![1, -1, -1, -1]

/-- A real `4 × 4` matrix `Λ` is a Lorentz transformation if it preserves the Minkowski
metric: `Λᵀ η Λ = η`. -/
def IsLorentz (Λ : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  Λ.transpose * minkowskiMetric * Λ = minkowskiMetric

/-- `Λ` belongs to the restricted (proper, orthochronous) Lorentz group `SO⁺(1,3)`:
it is a Lorentz transformation, has determinant `1`, and preserves the direction of
time (`Λ₀₀ ≥ 1`). This is the connected component of the identity, generated by
the 3-dimensional rotations and the boosts. -/
def IsRestrictedLorentz (Λ : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  IsLorentz Λ ∧ Λ.det = 1 ∧ 1 ≤ Λ 0 0

/-- The restricted Lorentz group `SO⁺(1,3)`, as a subset of the real `4 × 4` matrices. -/
def restrictedLorentzSet : Set (Matrix (Fin 4) (Fin 4) ℝ) :=
  {Λ | IsRestrictedLorentz Λ}

/-! ### Two-particle wavefunctions and field operators -/

/-- The symmetric part `ψ_S(x,y) = (ψ(x,y) + ψ(y,x)) / 2` of a two-particle
wavefunction. -/
noncomputable def symmPart {X : Type*} (ψ : X → X → ℂ) : X → X → ℂ :=
  fun x y => (ψ x y + ψ y x) / 2

/-- The antisymmetric part `ψ_A(x,y) = (ψ(x,y) - ψ(y,x)) / 2` of a two-particle
wavefunction. -/
noncomputable def antisymmPart {X : Type*} (ψ : X → X → ℂ) : X → X → ℂ :=
  fun x y => (ψ x y - ψ y x) / 2

/-- The two-particle creation operator `∑_{x ≠ y} ψ(x,y) φ(x) φ(y)` built from a
complex wavefunction `ψ` and a field `φ` with values in a complex algebra `A` of
operators, on a finite set `X` of positions (a discretisation of
`∬ ψ(x,y) φ(x) φ(y) dx dy`, restricted to distinct positions `x ≠ y`). -/
def twoParticleOp {X A : Type*} [Fintype X] [DecidableEq X] [Ring A] [Algebra ℂ A]
    (ψ : X → X → ℂ) (φ : X → A) : A :=
  ∑ x, ∑ y ∈ Finset.univ.filter (fun y => x ≠ y), ψ x y • (φ x * φ y)

/-! ### Composite particles -/

/-- Exchange of the two composite particles. A configuration of two composites, each
made of `k` constituents, is indexed by `Fin 2 × Fin k` (composite label, constituent
slot); this map swaps the composite label and keeps the slot. -/
def swapComposites {k : ℕ} (p : Fin 2 × Fin k) : Fin 2 × Fin k :=
  (Equiv.swap (0 : Fin 2) 1 p.1, p.2)

/-- Exchange of the `i`-th constituent of the first composite with the `i`-th
constituent of the second composite (all other constituents stay in place). -/
def swapConstituent {k : ℕ} (i : Fin k) (p : Fin 2 × Fin k) : Fin 2 × Fin k :=
  if p.2 = i then (Equiv.swap (0 : Fin 2) 1 p.1, p.2) else p

/-- Quantum-mechanical addition of angular momenta, with spins measured in units of
`ħ/2` (so a spin `j` is recorded as the natural number `2j`).
`CanAddTo l J` means that a system whose constituents have doubled spins `l` can have
total doubled spin `J`: the empty system has spin `0`, and adding a constituent of
doubled spin `a` to a system of doubled spin `b` can produce exactly the doubled spins
`J` with `|a - b| ≤ J ≤ a + b` and `J ≡ a + b (mod 2)` (the Clebsch–Gordan rule). -/
inductive CanAddTo : List ℕ → ℕ → Prop
  | nil : CanAddTo [] 0
  | cons {a b J : ℕ} {l : List ℕ} :
      CanAddTo l b → a ≤ J + b → b ≤ J + a → J ≤ a + b → (J + a + b) % 2 = 0 →
      CanAddTo (a :: l) J

end SpinStatistics


