-- Source module: Solutions.KFQ
/-!
# KFQ: proof of `NLogN.KFM.ChainSizes`

For `n ≥ n₀` and `dP n = D + 1`:
* `tBD_eq`: `t_i = 2^{axExp L d i}`, hence `∏ t_i = T` (`prod_tBD`) and
  `(∏_{i<D} t_i) · r = T` (`prod_init`);
* `win`: the source windows `(4d−2)t_i < 4d s_i ≤ (4d−1)t_i`, `s_i` odd;
* `chainSizes : ChainSizes` (with `n₂ = 0`), from `params_ok`, `L_facts`, `setup_facts`,
  `src_facts`, `srcS_ok_n` and the abstract lemmas of `KFQArith`.
-/

namespace NLogN.KFQ

open IntMul IntMul.HvdH IntMul.OpenAI.Glue IntMul.OpenAI.RP NLogN.KFM

theorem win {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1) (i : Fin (D + 1)) :
    (4 * dP n - 2) * tBD n D i < 4 * dP n * sBD n D i ∧
      4 * dP n * sBD n D i ≤ (4 * dP n - 1) * tBD n D i ∧ Odd (sBD n D i) := by
  have hdp : dpN n ≤ dP n := (mcnt_lt _ _ (by omega)).le
  obtain ⟨hodd, -, hw⟩ := srcS_ok_n hn (dpN n) hdp
  have h1 := hw ⟨i.val, by omega⟩
  have h2 := hodd ⟨i.val, by omega⟩
  have ht : tBD n D i = if i.val < dpN n then rP n / 2 else rP n := by
    unfold tBD; split_ifs <;> first | rfl | omega
  rw [ht]
  exact ⟨h1.1, h1.2, h2⟩

end NLogN.KFQ

end

