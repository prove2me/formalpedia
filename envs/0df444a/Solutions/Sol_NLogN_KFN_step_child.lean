  nlinarith

theorem zsz_role {W t S0 B r Z : ℕ} (hW : 1 ≤ W) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) :
    zsz ((16 * (B * 2 ^ t * S0 * r) : ℕ) : ℤ) ≤ Z := by
  refine le_trans (zsz_nat_le ?_) hZ
  have : W * nR t S0 B * r = W * (B * 2 ^ t * S0 * r) := by unfold nR; ring
  rw [this]
  exact Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_left _ hW)

theorem zsz_role2 {W t S0 B r Z : ℕ} (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) :
