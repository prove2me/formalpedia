/-- Chunk gates come from instruction gates. -/
theorem genF_chunk_mem : ∀ (W : List LInstr) (f : ℕ → ℕ), ∀ chk ∈ (genF f W).2, ∃ i ∈ W, chk.2.2 = i.2.2
  | [], f, chk, h => by simp [genF_nil] at h
  | i :: W, f, chk, h => by
    rw [genF_cons] at h
    rcases List.mem_cons.1 h with rfl | h
    · exact ⟨i, List.mem_cons_self, rfl⟩
    · obtain ⟨j, hj, e⟩ := genF_chunk_mem W _ chk h
      exact ⟨j, List.mem_cons_of_mem _ hj, e⟩

theorem chunk_gates_ok {W : List LInstr} (hW : WFw W) (f : ℕ → ℕ) :
    ∀ chk ∈ (genF f W).2, ∀ p ∈ chk.2.2, p.1 < 43642 ∧ p.2 < 43642 ∧ p.1 ≠ p.2 := by
  intro chk hchk p hp
  obtain ⟨i, hi, e⟩ := genF_chunk_mem W f chk hchk
  rw [e] at hp
  obtain ⟨-, ht, hg⟩ := hW i hi
  obtain ⟨h1, h2, h3⟩ := hg p hp
  exact ⟨ht _ h1, ht _ h2, h3⟩

theorem cs1_gates : cs1.flatMap (fun chk => chk.2.2) = G1 := by
  rw [cs1_eq, genF_gates, ← gates_W1F]; rfl

section Scalar

variable {N : ℕ}

theorem h2F (x : FVN N) : x + x = 0 := by
  rw [← two_smul (ZMod 2) x, show (2 : ZMod 2) = 0 from rfl, zero_smul]

variable (ch : Ch)

theorem u1_tmp {b : ℕ} (hb : b < 1771) : TmpZ (u1 ch N b) := by
  intro c hc
  rw [u1, ι1, show wT c = 43619 + c from rfl]
  unfold g1
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), gw_ge (by omega) (by omega)]
  rfl

/-- Block one, scalars. -/
theorem blk1_sc {b : ℕ} (hb : b < 1771) (v : Wr → FVN N) (hv : ∀ w, w < 43642 → v (ι1 b w) = u1 ch N b w) :
    True ∧ (∀ w, w < 43642 → (blk1 ch b).foldl scalarStepM v (ι1 b w) = xrL G1 (u1 ch N b) w) ∧
      ∀ x, (∀ w, w < 43642 → ι1 b w ≠ x) → (blk1 ch b).foldl scalarStepM v x = v x := by
  have hι : ∀ w w', w < 43642 → w' < 43642 → ι1 b w = ι1 b w' → w = w' :=
    fun w w' hw hw' e => (ι1_inj hb hb hw hw' e).2
  obtain ⟨c1, c2⟩ := chunkProg_scalar (R := ZMod 2) (m := 529) (ι1 b) (· < 43642) (ch.e1 b) hι cs1
    (by rw [cs1_eq]; exact chunk_gates_ok stage1_seg.1 _) v (u1 ch N b) hv
  rw [cs1_gates] at c1
  have hb1 : blk1 ch b = chunkProg (R := ZMod 2) (ι1 b) (ch.e1 b) cs1 ++
      (List.range' 3542 40077).map fun w => (Instr.edge (ι1 b w) (ch.ex b) : NI) := rfl
  rw [hb1, List.foldl_append, edges_scalar]
  exact ⟨trivial, c1, c2⟩

theorem u2_tmp {a : ℕ} (ha : a < 1771) : TmpZ (u2 ch N a) := by
  intro c hc
  rw [u2, if_neg (by simp only [wT, Nat.add_eq]; omega), ι2, show wT c = 43619 + c from rfl]
  unfold g2
  rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_pos (by omega), gw_ge (by omega) (by omega)]
  rfl

/-- Stage-two scalar pre-values. -/
theorem v1_pre {a w : ℕ} (ha : a < 1771) (hw : w < 45413) (v1 : Wr → FVN N)
    (hs1 : ∀ b ∈ List.range 1771, ∀ w, w < 43642 → v1 (ι1 b w) = xrL G1 (u1 ch N b) w)
    (hs2 : ∀ x, (∀ b ∈ List.range 1771, ∀ w, w < 43642 → ι1 b w ≠ x) → v1 x = φ0 ch N x) :
    v1 (ι2 a w) = u2 ch N a w := by
  unfold u2
  by_cases h1 : w < 1771
  · rw [if_pos h1, ι2, g2_x h1 ha, ← ι1, hs1 w (List.mem_range.2 h1) _ (wY_lt ha),
      (stage1_scalar h2F (u1 ch N w) (u1_tmp ch h1)).2.2 a ha]
    rfl
  · rw [if_neg h1]
    by_cases h2 : w < 3542
    · obtain ⟨t, rfl⟩ : ∃ t, w = 1771 + t := ⟨w - 1771, by omega⟩
      have ht : t < 1771 := by omega
      rw [show 1771 + t = wY t from rfl, ι2, g2_y ht ha, ← ι1, hs1 t (List.mem_range.2 ht) _ (wX_lt ha),
        (stage1_scalar h2F (u1 ch N t) (u1_tmp ch ht)).1 a ha]
      rfl
    · exact hs2 (ι2 a w) (fun b hb w' hw' e => g2_ne_g1 ha (by omega) hw
        (List.mem_range.1 hb) hw' (gw_inj (g2_lt ha hw) (g1_lt (List.mem_range.1 hb) hw') e.symm))

theorem c2a (x y : FVN N) : x + (y + x) = y := by
  rw [show x + (y + x) = y + (x + x) by abel, h2F, add_zero]

theorem c2b (x y : FVN N) : (y + x) + (x + (y + x)) = x := by
  rw [show (y + x) + (x + (y + x)) = x + ((x + x) + (y + y)) by abel, h2F, h2F, add_zero, add_zero]

/-- **Scalars of the whole program.** -/
theorem sc_prog_sol_aux :
    (∀ a < 1771, ∀ s < 1771,
      (prog ch).foldl scalarStepM (φ0 ch N) (ι2 a (wY s)) = φ0 ch N (ι2 a (wX s)) ∧
      (prog ch).foldl scalarStepM (φ0 ch N) (ι2 a (wX s)) = φ0 ch N (ι2 a (wY s))) ∧
    (∀ b < 1771, ∀ q < 40077, (prog ch).foldl scalarStepM (φ0 ch N) (ι1 b (wS q)) = φ0 ch N (ι1 b (wS q))) ∧
    (∀ a < 1771, ∀ q < 40077, (prog ch).foldl scalarStepM (φ0 ch N) (ι2 a (wS q)) = φ0 ch N (ι2 a (wS q))) := by
  obtain ⟨-, r2, r3⟩ := flat_fold (scalarStepM (R := ZMod 2) (m := 529)) (fun _ _ => True) (fun _ _ _ => by simp)
    (fun _ => trivial) ι1 (· < 43642) (u1 ch N) (fun b w => xrL G1 (u1 ch N b) w) (blk1 ch)
    (List.range 1771) List.nodup_range
    (fun b hb b' hb' hne w w' hw hw' e => hne (ι1_inj (List.mem_range.1 hb) (List.mem_range.1 hb') hw hw' e).1)
    (fun b hb v hv => blk1_sc ch (List.mem_range.1 hb) v hv) (φ0 ch N) (fun b hb w hw => rfl)
  obtain ⟨v1, hv1⟩ : ∃ v1, v1 = ((List.range 1771).flatMap (blk1 ch)).foldl scalarStepM (φ0 ch N) := ⟨_, rfl⟩
  rw [← hv1] at r2 r3
  obtain ⟨-, t2, t3⟩ := flat_fold (scalarStepM (R := ZMod 2) (m := 529)) (fun _ _ => True) (fun _ _ _ => by simp)
    (fun _ => trivial) ι2 (· < 45413) (u2 ch N) (fin2S ch N) (blk2 ch)
    (List.range 1771) List.nodup_range
    (fun a ha a' ha' hne w w' hw hw' e => hne (ι2_inj (List.mem_range.1 ha) (List.mem_range.1 ha') hw hw' e).1)
    (fun a ha v hv => blk2_sc ch (List.mem_range.1 ha) v hv) v1
    (fun a ha w hw => v1_pre ch (List.mem_range.1 ha) hw v1 r2 r3)
  have hp : prog ch = (List.range 1771).flatMap (blk1 ch) ++ (List.range 1771).flatMap (blk2 ch) := rfl
  rw [hp, List.foldl_append, ← hv1]
  have st2 := fun a (ha : a < 1771) => stage2_scalar h2F (u2 ch N a) (u2_tmp ch ha)
  have uY : ∀ a < 1771, ∀ s < 1771, u2 ch N a (wY s) = φ0 ch N (ι2 a (wY s)) := fun a ha s hs => by
    rw [u2, if_neg (by simp only [wY, Nat.add_eq]; omega)]
  have uX : ∀ a < 1771, ∀ s < 1771, u2 ch N a (wX s) = φ0 ch N (ι2 a (wX s)) + φ0 ch N (ι2 a (wY s)) :=
    fun a ha s hs => by
      rw [u2, if_pos (show wX s < 1771 from hs), ι2, ι2, show wX s = s from rfl, g2_x hs ha, g2_y hs ha]; rfl
  refine ⟨fun a ha s hs => ⟨?_, ?_⟩, fun b hb q hq => ?_, fun a ha q hq => ?_⟩
  · rw [t2 a (List.mem_range.2 ha) _ (by have := wY_lt hs; simp only [NL] at this; omega), fin2S,
      if_neg (by simp only [wY, Nat.add_eq]; omega), if_pos (show wY s < 43642 from wY_lt hs), (st2 a ha).2.2 s hs, uY a ha s hs,
      uX a ha s hs, c2a]
  · have e1 : xrL G2 (u2 ch N a) (wX s) = u2 ch N a (wX s) := (st2 a ha).1 s hs
    have e2 : xrL G2 (u2 ch N a) (wY (wX s)) = u2 ch N a (wY s) + u2 ch N a (wX s) := (st2 a ha).2.2 s hs
    have uX' : u2 ch N a (wX s) = φ0 ch N (ι2 a (wX s)) + φ0 ch N (ι2 a (wY s)) := uX a ha s hs
    rw [t2 a (List.mem_range.2 ha) _ (by have := wX_lt hs; simp only [NL] at this; omega), fin2S,
      if_pos (show wX s < 1771 from hs), e1, e2, uY a ha s hs, uX', c2b]
  · rw [t3 _ (fun a ha w hw e => by
        have e' := gw_inj (g2_lt (List.mem_range.1 ha) hw) (g1_lt hb (wS_lt hq)) e
        have ha' := List.mem_range.1 ha
        rw [show g1 b (wS q) = 6272882 + b * 40077 + q by
          rw [show wS q = 3542 + q from rfl]; unfold g1
          rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]; omega] at e'
        unfold g2 at e'; split_ifs at e' <;> omega),
      r2 b (List.mem_range.2 hb) _ (wS_lt hq), (stage1_scalar h2F (u1 ch N b) (u1_tmp ch hb)).2.1 q hq]
    rfl
  · rw [t2 a (List.mem_range.2 ha) _ (by have := wS_lt hq; simp only [NL] at this; omega), fin2S,
      if_neg (by simp only [wS, Nat.add_eq]; omega), if_pos (show wS q < 43642 from wS_lt hq), (st2 a ha).2.1 q hq, u2,
      if_neg (by simp only [wS, Nat.add_eq]; omega)]

