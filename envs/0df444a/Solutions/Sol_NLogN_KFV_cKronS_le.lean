namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT

theorem cLp_le' (N c Bb : ℕ) (hB : Bb ≤ 2 * N + 2) : cLp N c Bb ≤ (N + 1) * (c + 10 ^ 4) := by
  unfold cLp; nlinarith

theorem zsz2_le (r : ℕ) : zsz ((2 * r : ℕ) : ℤ) ≤ 2 * r + 2 :=
  le_trans (zsz_natCast_le_self' _) (by omega)

theorem cPack_le (r w b : ℕ) :
    cPack r w b (b * r + 2) ≤ 10 ^ 6 * (r + 1) * (w + b + 10) := by
  unfold cPack cLp
  have h := KFT.cCar_le b w r
  nlinarith

theorem cExt_le (esz r b Δ : ℕ) (he : esz ≤ 4) :
    cExt esz r b Δ (b * (2 * r) + 2) (zsz ((2 * r : ℕ) : ℤ)) ≤
      10 ^ 7 * (r + 1) * (b + Δ + 10) := by
  unfold cExt cLp
  have h := KFT.cDig_le b 0 (2 * r) (2 * r)
  have hz := zsz2_le r
  nlinarith

theorem cRec_le (r p b Δ φ : ℕ) :
    cRec r p b Δ φ ≤ 10 ^ 8 * (r + 1) * (b + Δ + p + 10) + 4 * φ := by
  unfold cRec cLp
  have h1 := cPack_le r (p + 2) b
  have h2 := cExt_le 4 r b Δ (by norm_num)
  have h3 := cExt_le 3 r b Δ (by norm_num)
  have hz := zsz2_le r
  nlinarith

set_option maxHeartbeats 4000000 in
/-- **The Kronecker stage.** -/
theorem cKronS_le_sol_aux (p ℓ n BK φ : ℕ) :
    cKronS p ℓ n BK φ ≤ 10 ^ 14 * (p + ℓ + 3) * (2 ^ n * 2 ^ ℓ) + 8000 * 2 ^ n * φ +
      2 * 10 ^ 9 * (BK + 2) ^ 2 := by
  unfold cKronS cKron
  set N := 2 ^ n with hN
  set r := 2 ^ ℓ with hr
  have hN1 : 1 ≤ N := Nat.one_le_two_pow
  have hr1 : 1 ≤ r := Nat.one_le_two_pow
  have hR := cRec_le r p (kb p ℓ) (p + ℓ) φ
  have hkb : kb p ℓ = 2 * p + ℓ + 3 := rfl
  rw [hkb] at hR ⊢
  have hU := KFC.cUL_le N
  have hz : zsz ((2 * (N * r) : ℕ) : ℤ) ≤ 2 * (N * r) + 2 := zsz2_le _
  have l1 : cLp (2 * (N * r)) (250 * (p + 4)) (zsz ((2 * (N * r) : ℕ) : ℤ)) ≤
      (2 * (N * r) + 1) * (250 * (p + 4) + 10 ^ 4) := cLp_le' _ _ _ (by omega)
  have l2 : cLp (2 * (N * r)) (250 * (2 * p + ℓ + 3 + 4)) (zsz ((2 * (N * r) : ℕ) : ℤ)) ≤
      (2 * (N * r) + 1) * (250 * (2 * p + ℓ + 3 + 4) + 10 ^ 4) := cLp_le' _ _ _ (by omega)
  set X := N * r with hX
  have hX1 : 1 ≤ X := Nat.mul_pos hN1 hr1
  have hNr : N ≤ X := Nat.le_mul_of_pos_right _ hr1
  have m1 : N * (r + 1) ≤ 2 * X := by rw [hX]; nlinarith
  have m3 : N * (1 + 2000 * cRec r p (2 * p + ℓ + 3) (p + ℓ) φ + 30) ≤
      31 * N + 2000 * 10 ^ 8 * (N * (r + 1)) * (2 * p + ℓ + 3 + (p + ℓ) + p + 10) + 8000 * N * φ := by
    have := Nat.mul_le_mul_left N (show 1 + 2000 * cRec r p (2 * p + ℓ + 3) (p + ℓ) φ + 30 ≤
      31 + 2000 * (10 ^ 8 * (r + 1) * (2 * p + ℓ + 3 + (p + ℓ) + p + 10)) + 8000 * φ by omega)
    nlinarith
  have m4 : 2000 * 10 ^ 8 * (N * (r + 1)) * (2 * p + ℓ + 3 + (p + ℓ) + p + 10) ≤
      2000 * 10 ^ 8 * (2 * X) * (4 * p + 2 * ℓ + 13) := by
    have := Nat.mul_le_mul_right (2000 * 10 ^ 8 * (4 * p + 2 * ℓ + 13)) m1
    nlinarith
  set Y := (p + ℓ + 3) * X with hY
  have hXY : X ≤ Y := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : (2 * X + 1) * (250 * (p + 4) + 10 ^ 4) ≤ 10 ^ 6 * Y := by
    have : (2 * X + 1) * (250 * (p + 4) + 10 ^ 4) ≤ (3 * X) * (250 * (p + ℓ + 3) + 10 ^ 5) :=
      Nat.mul_le_mul (by omega) (by omega)
    have h2 : (3 * X) * (250 * (p + ℓ + 3) + 10 ^ 5) = 750 * Y + 3 * 10 ^ 5 * X := by rw [hY]; ring
    linarith
  have e2 : (2 * X + 1) * (250 * (2 * p + ℓ + 3 + 4) + 10 ^ 4) ≤ 10 ^ 6 * Y := by
    have : (2 * X + 1) * (250 * (2 * p + ℓ + 3 + 4) + 10 ^ 4) ≤
        (3 * X) * (500 * (p + ℓ + 3) + 10 ^ 5) := Nat.mul_le_mul (by omega) (by omega)
    have h2 : (3 * X) * (500 * (p + ℓ + 3) + 10 ^ 5) = 1500 * Y + 3 * 10 ^ 5 * X := by rw [hY]; ring
    linarith
  have e3 : 2000 * 10 ^ 8 * (2 * X) * (4 * p + 2 * ℓ + 13) ≤ 10 ^ 13 * Y := by
    have t : (4 * p + 2 * ℓ + 13) * X ≤ 5 * Y := by
      rw [hY]; nlinarith
    have h2 : 2000 * 10 ^ 8 * (2 * X) * (4 * p + 2 * ℓ + 13) = 4 * 10 ^ 11 * ((4 * p + 2 * ℓ + 13) * X) := by
      ring
    linarith
  have hBK : 2 * BK + 2 ≤ (BK + 2) ^ 2 := by nlinarith
  have hg : 10 ^ 14 * (p + ℓ + 3) * X = 10 ^ 14 * Y := by rw [hY]; ring
  rw [hg]
  linarith

end NLogN.KFV

