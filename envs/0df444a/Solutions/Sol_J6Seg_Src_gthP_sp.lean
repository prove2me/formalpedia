/-- A loop counting down on `43`, for any state family. -/
theorem loopDown (s0 : IState HS) (S : ℕ → Fin HS → List ℤ) {iN : Fin HS} (hi : iN.val < 56)
    {n' A c : ℕ} {LN : List ℤ} (h43 : ∀ j, S j 43 = []) (hN : S n' iN = (n' : ℤ) :: LN)
    (hnA : n' ≤ 2 ^ A) {b : RS} (hw : (43 : Fin HS) ∉ b.writes)
    (hb : ∀ j < n', Sp b (encK s0 (update (S (j + 1)) 43 [(j : ℤ) + 1]))
      (encK s0 (update (S j) 43 [(j : ℤ) + 1])) c) :
    Sp (.rep 43 (.reg iN) b) (encK s0 (S n')) (encK s0 (S 0)) ((n' + 1) * (c + uC A DD)) := by
  have H := repP (C := 43) (i := iN) (b := b) (s0 := s0) (F := fun k => S (n' - k)) (N := n')
    (A := A) (D := DD) (c := c) (by decide) (fun k => h43 _) hw hi (by simpa using hN) hnA
    (by decide) (fun k hk => by
      obtain ⟨j, hj⟩ : ∃ j, n' - k = j + 1 := ⟨n' - k - 1, by omega⟩
      have e2 : n' - (k + 1) = j := by omega
      have e3 : (n' : ℤ) - k = (j : ℤ) + 1 := by omega
      simp only [hj, e2, e3]
      exact hb j (by omega))
  simpa using H

theorem gth_arith (L : List ℕ) (n' A : ℕ) :
    ((Ex.reg (31 : Fin HS) : Ex HS).size + 1) * 2000 * (A * DD + 1 + 2) +
      (zLs L).length * (14000 * (A * DD + 1 + 2)) + 32 +
      (n' + 1) * (2 * (10 * uC A DD) + 200 * (A * DD + 1 + 1) + uC A DD) ≤
      (L.length + n' + 2) * (40 * uC A DD) := by
  have hu := uC_ge A DD
  have hs : (Ex.reg (31 : Fin HS) : Ex HS).size = 1 := rfl
  rw [hs, List.length_map]
  generalize uC A DD = u at *
  generalize A * DD = x at *
  generalize L.length = l
  have m1 : l * (14000 * (x + 1 + 2)) ≤ l * (2 * u) := Nat.mul_le_mul_left _ (by omega)
  have m2 : (n' + 1) * (2 * (10 * u) + 200 * (x + 1 + 1) + u) ≤ (n' + 1) * (22 * u) :=
    Nat.mul_le_mul_left _ (by omega)
  have e1 : (l + n' + 2) * (40 * u) = 40 * (l * u) + 40 * (n' * u) + 80 * u := by ring
  have e2 : l * (2 * u) = 2 * (l * u) := by ring
  have e3 : (n' + 1) * (22 * u) = 22 * (n' * u) + 22 * u := by ring
  omega

