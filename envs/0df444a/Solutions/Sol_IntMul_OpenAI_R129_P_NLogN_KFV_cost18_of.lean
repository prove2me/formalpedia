theorem pow_split {c δ E m : ℕ} (h : c + δ + E = m) : 2 ^ c * 2 * 2 ^ δ * 2 ^ E = 2 * 2 ^ m := by
  rw [← h]; ring

theorem cK3_two {c δ E B : ℕ} (hc : c < B) (hδ : δ < B) (hE : E < B) (h2 : 2 ≤ B) :
    KFUU.cK3 (2 ^ c) (2 ^ δ) (2 ^ E) ≤ 8 * KFUU.cU B :=
  KFUU.cK3_le (zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) hc))
    (zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) hδ))
    (zsz_nat_lt (Nat.pow_lt_pow_right (by norm_num) hE)) h2

/-- **One move** (`bwdF`). -/
theorem cMvB_le {eA eF eC : Ex HS} (hs : eA.size + eF.size + eC.size ≤ 200) {c δ E m W B : ℕ}
    (hm : c + δ + E = m) (hc : c < B) (hδ : δ < B) (hE : E < B) (h2 : 2 ≤ B) :
    cMvB eA eF eC c δ E W B ≤
      29200 * (W + 1) * 2 ^ m + (206 * 10 ^ 7 * (B + 2) ^ 2 + 6 * B + 6 + 8 * KFUU.cU B) := by
  unfold cMvB cMvR
  have h1 := cBwdF_le (2 ^ c) 2 (2 ^ δ) (2 ^ E) W Nat.one_le_two_pow Nat.one_le_two_pow (by norm_num)
    Nat.one_le_two_pow
  rw [pow_split hm] at h1
  have h3 := cK3_two hc hδ hE h2
  have hk := kap_le W
  have h4 : (2 * 2 + 69) * kap W * (2 * 2 ^ m) ≤ 29200 * (W + 1) * 2 ^ m := by
    have := Nat.mul_le_mul_right (2 * 2 ^ m) hk; nlinarith
  have h5 : ((eA.size + 2) + (eF.size + 2) + (eC.size + 2)) * 10 ^ 7 * (B + 2) ^ 2 ≤
      206 * 10 ^ 7 * (B + 2) ^ 2 := by
    apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; omega
  omega

/-- **One inverse move** (`fwdF`). -/
theorem cMvF_le {eA eF eC : Ex HS} (hs : eA.size + eF.size + eC.size ≤ 200) {c δ E m W B : ℕ}
    (hm : c + δ + E = m) (hc : c < B) (hδ : δ < B) (hE : E < B) (h2 : 2 ≤ B) :
