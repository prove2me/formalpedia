theorem pad_Eb (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) : (pad hΛℤ ρ i j).Eb = ρ.Eb := rfl
theorem pad_Ab (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) : (pad hΛℤ ρ i j).Ab = ρ.Ab := rfl
theorem pad_gb (ρ : FakeEllipticCurve.Rigidification r π A₀ ψ E) (i j : ℕ) : (pad hΛℤ ρ i j).gb = ρ.gb := rfl
