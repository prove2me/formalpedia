theorem dscOf_spec (sdS : Fin HS) : (dscOf sdS = 18 ∨ dscOf sdS = 19) ∧ dscOf sdS ≠ sdS := by
  unfold dscOf; split_ifs with h
  · subst h; exact ⟨Or.inr rfl, by decide⟩
  · exact ⟨Or.inl rfl, fun e => h e.symm⟩

