    by_contra hc
    have := (zsz_le_iff (z := n.eval s) (m := 0)).1 (by omega); simp at this; omega
  apply RS.decCost_le
  · simpa [IState.top, withCtr] using hv
  · simpa [IState.top, withCtr] using hv'
  · exact h1

theorem RM.RepStates.cost_le_lin {M : MulSpec} {i : Fin HS} {n : Ex HS} {b : RM} {s : IState HS}
