variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ) {D : ℕ}

lemma axisLInv_eq (ℓ h : ℕ) (i : Fin D) (z : Arr R D) :
    axisLInv y ℓ i h z = bfly h i (twidI y ℓ h i z) := by
  funext x; unfold axisLInv levInv bfly twidI; simp [Function.update_self]

lemma twidI_bfly_comm (ℓ h : ℕ) {i j : Fin D} (hij : i ≠ j) (z : Arr R D) :
    twidI y ℓ h i (bfly h j z) = bfly h j (twidI y ℓ h i z) := by
  funext x
  unfold twidI bfly
  simp only [Function.update_of_ne hij, mul_sum, mul_smul_comm]

lemma twidI_foldr_bfly (ℓ h : ℕ) (i : Fin D) : ∀ (l : List (Fin D)), i ∉ l → ∀ z : Arr R D,
    twidI y ℓ h i (l.foldr (fun j acc => bfly h j acc) z) =
      l.foldr (fun j acc => bfly h j acc) (twidI y ℓ h i z)
  | [], _, _ => rfl
  | j :: l, hi, z => by
    simp only [List.foldr_cons]
    have hij : i ≠ j := fun e => hi (e ▸ List.mem_cons_self ..)
    rw [twidI_bfly_comm y ℓ h hij, twidI_foldr_bfly ℓ h i l (fun h' => hi (List.mem_cons_of_mem _ h'))]

lemma foldr_bfly_twidI (ℓ h : ℕ) (z : Arr R D) : ∀ l : List (Fin D), l.Nodup →
    l.foldr (fun i acc => bfly h i (twidI y ℓ h i acc)) z =
      l.foldr (fun i acc => bfly h i acc) (twidIAll y ℓ h l z)
  | [], _ => by funext x; simp [twidIAll]
  | i :: l, hnd => by
    simp only [List.foldr_cons]
    rw [foldr_bfly_twidI ℓ h z l (List.nodup_cons.1 hnd).2,
      twidI_foldr_bfly y ℓ h i l (List.nodup_cons.1 hnd).1]
    congr 2
    funext x
    simp only [twidI, twidIAll, List.map_cons, List.sum_cons, neg_add, yp_add]
    ring

lemma foldr_bfly_eqOn {a : Fin D → ℕ} (h : ℕ) : ∀ (l : List (Fin D)), (∀ i ∈ l, h < a i) →
    ∀ {z z' : Arr R D}, EqOn a z z' →
      EqOn a (l.foldr (fun i acc => bfly h i acc) z) (l.foldr (fun i acc => bfly h i acc) z')
  | [], _, _, _, hz => hz
  | i :: l, hl, _, _, hz => by
    simp only [List.foldr_cons]
    exact bfly_eqOn (hl i (List.mem_cons_self ..))
      (foldr_bfly_eqOn h l (fun j hj => hl j (List.mem_cons_of_mem _ hj)) hz)

variable {sh : Shape} {a : Fin D → ℕ} (L : CoordLayout sh a)

/-- `fn_layer` for any complete ordering of the axes. -/
theorem fn_layer_list {h : ℕ} {P : Finset (Fin D)} {Sb : SelBits sh {i // i ∈ P}}
    (hc : SelCompat L h P Sb) (hP : ∀ i ∈ P, h < a i) (l : List {i // i ∈ P}) (hnd : l.Nodup)
    (hall : ∀ i, i ∈ l) {xs : List R} (hlen : xs.length = vol sh) :
    EqOn a (fn L (selOp Sb (Butterfly.tens H0) xs)) (l.foldr (fun i acc => bfly h i.1 acc) (fn L xs)) := by
  rw [layer_eq_kernels Sb H0 l hnd hall hlen]
  clear hnd hall
  induction l with
  | nil => intro x _; rfl
  | cons i l ih =>
    intro x hx
    simp only [List.foldr_cons]
    rw [fn_kernel L hc i _ hx]
    exact bfly_eqOn (hP i.1 i.2) ih x hx

lemma runI_eq_foldr (ℓ : ℕ) : ∀ (l : List (Fin D × ℕ)) (z : Arr R D),
    runI y ℓ l z = l.foldr (fun st acc => axisLInv y ℓ st.1 st.2 acc) z
  | [], _ => rfl
  | st :: l, z => by simp only [runI, List.foldr_cons]; rw [runI_eq_foldr ℓ l z]

lemma runI_append (ℓ : ℕ) (l₁ l₂ : List (Fin D × ℕ)) (z : Arr R D) :
    runI y ℓ (l₁ ++ l₂) z = runI y ℓ l₁ (runI y ℓ l₂ z) := by
  rw [runI_eq_foldr, runI_eq_foldr, runI_eq_foldr, List.foldr_append]

lemma fn_twL {Ex : ℕ → ℤ} {xs : List R} {x : Fin D → ℕ} (hx : x ∈ box a) :
    fn L (twL y sh Ex xs) x = yp y (Ex (encode sh (L.addr x))) * fn L xs x := by
  unfold fn
  rw [getD_twL _ _ (encode_lt (L.valid_addr x hx))]

/-- **One opposite round on the tape** is the composition of the inverse axis levels. -/
theorem fn_roundLI (ℓ h : ℕ) {P : Finset (Fin D)} {Sb : SelBits sh {i // i ∈ P}}
    (hc : SelCompat L h P Sb) (hP : ∀ i ∈ P, h < a i) {xs : List R} (hlen : xs.length = vol sh) :
    EqOn a (fn L (roundLI y L ℓ h P Sb xs))
      (runI y ℓ ((roundAxes P).reverse.map fun i => (i, h)) (fn L xs)) := by
  rw [runI_eq_foldr, List.foldr_map]
  simp only [axisLInv_eq]
  rw [foldr_bfly_twidI y ℓ h _ _ (List.nodup_reverse.2 (roundAxes_nodup P))]
  have hl : (roundAxes P).reverse =
      ((Finset.univ : Finset {i // i ∈ P}).toList.reverse).map Subtype.val := by
    simp [roundAxes, List.map_reverse]
  have hlay := fn_layer_list L hc hP ((Finset.univ : Finset {i // i ∈ P}).toList.reverse)
    (List.nodup_reverse.2 (Finset.nodup_toList _))
    (fun i => List.mem_reverse.2 (Finset.mem_toList.2 (mem_univ i)))
    (xs := twL y sh (fun j => -roundEx L ℓ h P j) xs) (length_twL _ _)
  intro x hx
  show fn L (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -roundEx L ℓ h P j) xs)) x = _
  rw [hlay x hx]
  rw [hl, List.foldr_map]
  have e : ∀ z : Arr R D, List.foldr (fun (i : {i // i ∈ P}) acc => bfly h (↑i) acc) z
      (Finset.univ : Finset {i // i ∈ P}).toList.reverse =
      (((Finset.univ : Finset {i // i ∈ P}).toList.reverse).map Subtype.val).foldr
        (fun i acc => bfly h i acc) z := fun z => by rw [List.foldr_map]
  rw [e, e]
  refine foldr_bfly_eqOn h _ (fun i hi => hP i (by simpa using hi)) ?_ x hx
  intro x' hx'
  rw [fn_twL y L hx']
  unfold twidIAll roundEx
  rw [decode_encode (L.valid_addr x' hx'), L.coord_addr x' hx']
  congr 2
  simp [roundAxes, List.map_reverse, List.sum_reverse, List.map_map]

lemma length_procLI (ℓ : ℕ) (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h})
    {xs : List R} (hlen : xs.length = vol sh) : ∀ n, (procLI y L ℓ P Sb n xs).length = vol sh
  | 0 => hlen
  | n + 1 => by simp [procLI, roundLI]

theorem fn_procLI (ℓ : ℕ) {P : ℕ → Finset (Fin D)} {Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}} :
    ∀ n, (∀ h < n, SelCompat L h (P h) (Sb h)) → (∀ h < n, ∀ i ∈ P h, h < a i) →
      ∀ {xs : List R}, xs.length = vol sh →
        EqOn a (fn L (procLI y L ℓ P Sb n xs)) (runI y ℓ (schedL P n) (fn L xs))
  | 0, _, _, _, _ => fun _ _ => rfl
  | n + 1, hc, hP, xs, hlen => by
    intro x hx
    simp only [procLI, schedL]
    rw [fn_roundLI y L ℓ n (hc n (by omega)) (hP n (by omega))
      (length_procLI y L ℓ P Sb hlen n) x hx, runI_append]
    refine runI_eqOn y ℓ _ ?_ (fn_procLI ℓ n (fun h hh => hc h (by omega))
      (fun h hh => hP h (by omega)) hlen) x hx
    intro st hst
    simp only [List.mem_map, List.mem_reverse] at hst
    obtain ⟨i, hi, rfl⟩ := hst
    exact hP n (by omega) i (mem_roundAxes.1 hi)

/-- **§6.1 opposite transform on the tape.** Running the opposite rounds `h = 0, …, ℓ-1` on the
records of `w` returns, at physical address `v`, `F^+(w ∘ rev)(coord v)`: the procedure
implements `F^+ B^{-1}`. -/
theorem synth_opposite_list {ℓ : ℕ} (hy : y ^ (2 ^ ℓ) = -1) (ha : ∀ i, a i ≤ ℓ)
    {Sb : (h : ℕ) → SelBits sh {i // i ∈ partAxes a h}}
    (hc : ∀ h < ℓ, SelCompat L h (partAxes a h) (Sb h)) {xs : List R} (hlen : xs.length = vol sh)
    {v : List ℕ} (hv : Valid sh v) :
    (procLI y L ℓ (partAxes a) Sb ℓ xs).getD (encode sh v) 0 =
      Fp y ℓ a (fun k => fn L xs (revV a k)) (L.coord v) := by
  have hx := L.coord_mem v hv
  have := fn_procLI y L ℓ ℓ hc (fun h _ i hi => (Finset.mem_filter.1 hi).2) hlen _ hx
  unfold fn at this
  rw [L.addr_coord v hv] at this
  rw [this, synth_opposite y hy (fun i => (ha i).trans (Nat.le_succ ℓ)) (schedL_ok ha) _ hx]
  rfl

variable {r : ℕ} {C : CoeffModel y r}

lemma procLI_eq_foldl (ℓ : ℕ) (P : ℕ → Finset (Fin D))
    (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (xs : List R) : ∀ n,
    procLI y L ℓ P Sb n xs = (List.range n).foldl (fun u k => roundLI y L ℓ k (P k) (Sb k) u) xs
  | 0 => rfl
  | n + 1 => by rw [List.range_succ, List.foldl_append, ← procLI_eq_foldl ℓ P Sb xs n]; rfl

/-- A fold of contractions is a contraction. -/
lemma fold_contract {N : ℕ} (G : ℕ → List R → List R)
    (hcon : ∀ k (u v : CArr C N), dist (toA C N (G k (ofA u))) (toA C N (G k (ofA v))) ≤ dist u v) :
    ∀ (l : List ℕ) (u v : CArr C N),
      dist (l.foldl (fun w k => toA C N (G k (ofA w))) u) (l.foldl (fun w k => toA C N (G k (ofA w))) v)
        ≤ dist u v
  | [], _, _ => le_rfl
  | k :: l, u, v => by
    simp only [List.foldl_cons]
    exact (fold_contract G hcon l _ _).trans (hcon k u v)

/-- **Generic error chain for list procedures** (`Synth.error_chain`). -/
theorem chain_lists {N : ℕ} (G Gt : ℕ → List R → List R)
    (hG : ∀ k zs, (G k zs).length = N) (hGt : ∀ k zs, (Gt k zs).length = N)
    (hcon : ∀ k (u v : CArr C N), dist (toA C N (G k (ofA u))) (toA C N (G k (ofA v))) ≤ dist u v)
    (hdG : ∀ k u, u ∈ disk C N → toA C N (G k (ofA u)) ∈ disk C N)
    (hdGt : ∀ k u, u ∈ disk C N → toA C N (Gt k (ofA u)) ∈ disk C N)
    {η : ℝ} (herr : ∀ k (u : CArr C N), dist (toA C N (Gt k (ofA u))) (toA C N (G k (ofA u))) < η)
    (n : ℕ) (hn : 1 ≤ n) {xs : List R} (hlen : xs.length = N) (hx : toA C N xs ∈ disk C N) :
    dist (toA C N ((List.range n).foldl (fun u k => Gt k u) xs))
        (toA C N ((List.range n).foldl (fun u k => G k u) xs)) < n * η ∧
      toA C N ((List.range n).foldl (fun u k => Gt k u) xs) ∈ disk C N ∧
      toA C N ((List.range n).foldl (fun u k => G k u) xs) ∈ disk C N := by
  rw [toA_foldl Gt hGt _ _ hlen, toA_foldl G hG _ _ hlen]
  refine ⟨error_chain (disk C N) (fun k u => toA C N (G k (ofA u)))
    (fun k u => toA C N (Gt k (ofA u))) η (fun k u _ v _ => hcon k u v) hdG hdGt
    (fun k u _ => herr k u) n _ hx hn, ?_, ?_⟩
  · clear hn
    induction n with
    | zero => exact hx
    | succ n ih => rw [List.range_succ, List.foldl_append]; exact hdGt n _ ih
  · clear hn
    induction n with
    | zero => exact hx
    | succ n ih => rw [List.range_succ, List.foldl_append]; exact hdG n _ ih

section OppMaps

variable {ι : Type} [Fintype ι] [DecidableEq ι] (Sb : SelBits sh ι) (Ex : ℕ → ℤ)

lemma twL_sub_le (u v : CArr C (vol sh)) (k : ℕ) :
    ‖C.co ((twL y sh Ex (ofA u)).getD k 0 - (twL y sh Ex (ofA v)).getD k 0)‖ ≤ dist u v := by
  by_cases hk : k < vol sh
  · rw [getD_twL _ _ hk, getD_twL _ _ hk, ← mul_sub, norm_co_yp]
    exact ofA_getD_sub u v k
  · rw [getD_twL_ge _ _ (by omega), getD_twL_ge _ _ (by omega), sub_zero, map_zero, norm_zero]
    exact dist_nonneg

lemma twL_disk {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) (k : ℕ) :
    ‖C.co ((twL y sh Ex (ofA u)).getD k 0)‖ ≤ 1 := by
  by_cases hk : k < vol sh
  · rw [getD_twL _ _ hk, norm_co_yp]; exact ofA_disk hu k
  · rw [getD_twL_ge _ _ (by omega), map_zero, norm_zero]; exact zero_le_one

lemma oppE_contract (u v : CArr C (vol sh)) :
    dist (toA C (vol sh) (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -Ex j) (ofA u))))
      (toA C (vol sh) (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -Ex j) (ofA v)))) ≤ dist u v :=
  dist_carr_le dist_nonneg fun j => layer_lip Sb _ _ dist_nonneg (twL_sub_le y _ u v) j

lemma oppE_disk {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) :
    toA C (vol sh) (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -Ex j) (ofA u))) ∈ disk C (vol sh) :=
  fun j => layer_disk Sb _ (twL_disk y _ hu) j

lemma oppA_disk (p : ℕ) {u : CArr C (vol sh)} (hu : u ∈ disk C (vol sh)) :
    toA C (vol sh) (compRI y C p Sb Ex (ofA u)) ∈ disk C (vol sh) := by
  intro j
  show ‖C.co ((compRI y C p Sb Ex (ofA u)).getD j 0)‖ ≤ 1
  unfold compRI
  rw [getD_layerQ]
  exact (norm_co_QpR_le C p _).trans (layer_disk Sb _ (twL_disk y _ hu) j)

lemma oppA_err (p : ℕ) (u : CArr C (vol sh)) :
    dist (toA C (vol sh) (compRI y C p Sb Ex (ofA u)))
      (toA C (vol sh) (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -Ex j) (ofA u)))) <
      Real.sqrt 2 * 2⁻¹ ^ p := by
  apply dist_carr_lt (by positivity)
  intro j
  show ‖C.co ((compRI y C p Sb Ex (ofA u)).getD j 0 -
    (selOp Sb (Butterfly.tens H0) (twL y sh (fun j => -Ex j) (ofA u))).getD j 0)‖ < _
  unfold compRI
  rw [getD_layerQ]
  exact norm_co_QpR_sub_lt C p _

end OppMaps

/-- **Opposite transform error (Lemma 16 for `F^+ B^{-1}`).** -/
theorem opp_error (p : ℕ) (ℓ : ℕ) (P : ℕ → Finset (Fin D))
    (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h}) (n : ℕ) (hn : 1 ≤ n)
    {xs : List R} (hlen : xs.length = vol sh) (hx : toA C (vol sh) xs ∈ disk C (vol sh)) :
    dist (toA C (vol sh) (procQI y L C p ℓ P Sb n xs))
        (toA C (vol sh) (procLI y L ℓ P Sb n xs)) < n * (Real.sqrt 2 * 2⁻¹ ^ p) ∧
      toA C (vol sh) (procQI y L C p ℓ P Sb n xs) ∈ disk C (vol sh) ∧
      toA C (vol sh) (procLI y L ℓ P Sb n xs) ∈ disk C (vol sh) := by
  rw [procLI_eq_foldl]
  exact chain_lists y (fun k => roundLI y L ℓ k (P k) (Sb k))
    (fun k => compRI y C p (Sb k) (roundEx L ℓ k (P k))) (fun k zs => by simp [roundLI])
    (fun k zs => by simp [compRI, layerQ])
    (fun k u v => oppE_contract y (Sb k) _ u v) (fun k u hu => oppE_disk y (Sb k) _ hu)
    (fun k u hu => oppA_disk y (Sb k) _ p hu) (fun k u => oppA_err y (Sb k) _ p u) n hn hlen hx

/-- The exact opposite procedure on arrays is a contraction. -/
lemma oppT_contract (ℓ : ℕ) (P : ℕ → Finset (Fin D)) (Sb : (h : ℕ) → SelBits sh {i // i ∈ P h})
    (n : ℕ) (u v : CArr C (vol sh)) :
    dist (toA C (vol sh) (procLI y L ℓ P Sb n (ofA u))) (toA C (vol sh) (procLI y L ℓ P Sb n (ofA v)))
      ≤ dist u v := by
  rw [procLI_eq_foldl, procLI_eq_foldl,
    toA_foldl (N := vol sh) (fun k => roundLI y L ℓ k (P k) (Sb k)) (fun k zs => by simp [roundLI])
      _ _ (length_ofA u),
    toA_foldl (N := vol sh) (fun k => roundLI y L ℓ k (P k) (Sb k)) (fun k zs => by simp [roundLI])
      _ _ (length_ofA v), toA_ofA, toA_ofA]
  exact fold_contract y (fun k => roundLI y L ℓ k (P k) (Sb k))
    (fun k u v => oppE_contract y (Sb k) _ u v) _ u v

section Prop18

lemma PP_sub {N : ℕ} (x x' z z' : CArr C N) :
    PP y C x z - PP y C x' z' = PP y C (x - x') z + PP y C x' (z - z') := by
  funext j
  show ((r : ℂ)⁻¹) • ((x : Fin N → R) j * (z : Fin N → R) j) -
      ((r : ℂ)⁻¹) • ((x' : Fin N → R) j * (z' : Fin N → R) j) =
    ((r : ℂ)⁻¹) • (((x : Fin N → R) j - (x' : Fin N → R) j) * (z : Fin N → R) j) +
      ((r : ℂ)⁻¹) • ((x' : Fin N → R) j * ((z : Fin N → R) j - (z' : Fin N → R) j))
  rw [← smul_sub, ← smul_add]; congr 1; ring

lemma norm_PP_le {N : ℕ} (x z : CArr C N) : ‖PP y C x z‖ ≤ ‖x‖ * ‖z‖ := by
  rw [norm_carr]
  refine (pi_norm_le_iff_of_nonneg (by positivity)).2 fun j => ?_
  have hr : (0 : ℝ) < r := by exact_mod_cast C.pos
  show ‖C.co (((r : ℂ)⁻¹) • ((x : Fin N → R) j * (z : Fin N → R) j))‖ ≤ _
  rw [map_smul, norm_smul, norm_inv, Complex.norm_natCast]
  have h1 := norm_co_mul_le C ((x : Fin N → R) j) ((z : Fin N → R) j)
  have h2 : ‖C.co ((x : Fin N → R) j)‖ ≤ ‖x‖ := by
    rw [norm_carr]; exact norm_le_pi_norm (fun j => C.co ((x : Fin N → R) j)) j
  have h3 : ‖C.co ((z : Fin N → R) j)‖ ≤ ‖z‖ := by
    rw [norm_carr]; exact norm_le_pi_norm (fun j => C.co ((z : Fin N → R) j)) j
  rw [inv_mul_le_iff₀ hr]
  calc ‖C.co ((x : Fin N → R) j * (z : Fin N → R) j)‖
      ≤ r * ‖C.co ((x : Fin N → R) j)‖ * ‖C.co ((z : Fin N → R) j)‖ := h1
    _ ≤ r * ‖x‖ * ‖z‖ := by gcongr
    _ = r * (‖x‖ * ‖z‖) := by ring

lemma norm_QQ_sub_lt (p : ℕ) {N : ℕ} (w : CArr C N) :
    ‖QQ y C p w - w‖ < Real.sqrt 2 * 2⁻¹ ^ p := by
  rw [norm_carr]
  refine (pi_norm_lt_iff (by positivity)).2 fun j => ?_
  exact norm_co_QpR_sub_lt C p _

lemma norm_QQ_le (p : ℕ) {N : ℕ} (w : CArr C N) : ‖QQ y C p w‖ ≤ ‖w‖ := by
  rw [norm_carr, norm_carr]
  refine (pi_norm_le_iff_of_nonneg (norm_nonneg _)).2 fun j => ?_
  exact (norm_co_QpR_le C p _).trans (norm_le_pi_norm (fun j => C.co ((w : Fin N → R) j)) j)

lemma norm_le_one_of_disk {N : ℕ} {u : CArr C N} (hu : u ∈ disk C N) : ‖u‖ ≤ 1 := by
  rw [norm_carr]; exact (pi_norm_le_iff_of_nonneg zero_le_one).2 hu

lemma disk_of_norm_le_one {N : ℕ} {u : CArr C N} (hu : ‖u‖ ≤ 1) : u ∈ disk C N := fun j => by
  rw [norm_carr] at hu; exact (norm_le_pi_norm (fun j => C.co ((u : Fin N → R) j)) j).trans hu

variable {ℓ : ℕ} {Sb : (h : ℕ) → SelBits sh {i // i ∈ partAxes a h}}

/-- **Proposition 18, error (unconditional).** Let `f, g` be disk arrays in a compatible
layout, `ut, vt` their computed forward transforms (`procQ`, `ℓ ≥ 1` rounds), `W = P(ut, vt)`
the normalized pointwise product, and `ht` the computed opposite transform (`procQI`) of
`Q_p W`.  Then at every valid address `v`, `ht` is within `(3ℓ + 1)·√2·2^{-p}` of
`M⁻¹ M_r(f, g)(coord v)`, where `M_r(f,g) = (f ∗ g)/(rM)` (normalized cyclic convolution). -/
theorem prop18_error_full (p : ℕ) (hy : y ^ (2 ^ ℓ) = -1) (ha : ∀ i, a i ≤ ℓ) (hℓ : 1 ≤ ℓ)
    (hc : ∀ h < ℓ, SelCompat L h (partAxes a h) (Sb h))
    {f g : List R} (hf : f.length = vol sh) (hg : g.length = vol sh)
    (hfd : ∀ k, ‖C.co (f.getD k 0)‖ ≤ 1) (hgd : ∀ k, ‖C.co (g.getD k 0)‖ ≤ 1)
    {v : List ℕ} (hv : Valid sh v) :
    ‖C.co ((procQI y L C p ℓ (partAxes a) Sb ℓ
        (ofA (QQ y C p (PP y C (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ f))
          (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ g)))))).getD (encode sh v) 0 -
        ((Mv a : ℂ)⁻¹) • Mr r a (fn L f) (fn L g) (L.coord v))‖ <
      3 * (ℓ * (Real.sqrt 2 * 2⁻¹ ^ p)) + Real.sqrt 2 * 2⁻¹ ^ p := by
  set η := Real.sqrt 2 * 2⁻¹ ^ p with hη
  set N := vol sh with hN
  set U := toA C N (procL y L ℓ (partAxes a) Sb ℓ f) with hU
  set V := toA C N (procL y L ℓ (partAxes a) Sb ℓ g) with hV
  set ut := toA C N (procQ C p L ℓ (partAxes a) Sb ℓ f) with hut
  set vt := toA C N (procQ C p L ℓ (partAxes a) Sb ℓ g) with hvt
  set T : CArr C N → CArr C N := fun w => toA C N (procLI y L ℓ (partAxes a) Sb ℓ (ofA w)) with hT
  set ht := toA C N (procQI y L C p ℓ (partAxes a) Sb ℓ (ofA (QQ y C p (PP y C ut vt)))) with hht
  -- forward errors and disks
  have hfx : toA C N f ∈ disk C N := fun j => hfd j
  have hgx : toA C N g ∈ disk C N := fun j => hgd j
  obtain ⟨ef, dft⟩ := lemma16_error (C := C) p L ℓ (partAxes a) Sb ℓ hℓ hf hfd
  obtain ⟨eg, dgt⟩ := lemma16_error (C := C) p L ℓ (partAxes a) Sb ℓ hℓ hg hgd
  have hδ : 0 < (ℓ : ℝ) * η := by
    have : (1 : ℝ) ≤ ℓ := by exact_mod_cast hℓ
    positivity
  have hdu : ‖ut - U‖ < ℓ * η := by
    rw [← dist_eq_norm]; exact dist_carr_lt hδ fun j => by rw [hut, hU, hη]; simp only [toA]; simpa [map_sub] using ef j
  have hdv : ‖vt - V‖ < ℓ * η := by
    rw [← dist_eq_norm]; exact dist_carr_lt hδ fun j => by rw [hvt, hV, hη]; simp only [toA]; simpa [map_sub] using eg j
  have hvt1 : ‖vt‖ ≤ 1 := norm_le_one_of_disk y fun j => dgt j
  have hut1 : ‖ut‖ ≤ 1 := norm_le_one_of_disk y fun j => dft j
  -- the exact forward outputs lie in the disk
  have hUd : ‖U‖ ≤ 1 := by
    have h := (chain_lists y (C := C) (N := N)
      (fun k => exactR y (Sb (ℓ - 1 - k)) (roundEx L ℓ (ℓ - 1 - k) (partAxes a (ℓ - 1 - k))))
      (fun k => exactR y (Sb (ℓ - 1 - k)) (roundEx L ℓ (ℓ - 1 - k) (partAxes a (ℓ - 1 - k))))
      (fun k zs => length_twL _ _) (fun k zs => length_twL _ _)
      (fun k u v => round_contract _ _ u v) (fun k u hu => round_disk _ _ hu)
      (fun k u hu => round_disk _ _ hu) (η := 1) (fun k u => by simp) ℓ hℓ hf hfx).2.2
    apply norm_le_one_of_disk y
    rw [hU, procL_eq_runDown, runDown_eq_foldl]; exact h
  -- the opposite input lies in the disk
  have hWd : QQ y C p (PP y C ut vt) ∈ disk C N := by
    apply disk_of_norm_le_one y
    calc ‖QQ y C p (PP y C ut vt)‖ ≤ ‖PP y C ut vt‖ := norm_QQ_le y p _
      _ ≤ ‖ut‖ * ‖vt‖ := norm_PP_le y ut vt
      _ ≤ 1 := by nlinarith [norm_nonneg ut, norm_nonneg vt]
  have hWlen := length_ofA (QQ y C p (PP y C ut vt))
  have hopp := opp_error y L (C := C) p ℓ (partAxes a) Sb ℓ hℓ hWlen
    (by rw [toA_ofA]; exact hWd)
  have hh : ‖ht - T (QQ y C p (PP y C ut vt))‖ < ℓ * η := by
    rw [← dist_eq_norm]; exact hopp.1
  -- Proposition 18's error estimate
  have key := (prop18_error (PP y C) (QQ y C p) T (PP_sub y) (norm_PP_le y)
    (fun a' b' => by
      rw [← dist_eq_norm, ← dist_eq_norm]; exact oppT_contract y L ℓ (partAxes a) Sb ℓ a' b')
    hUd hvt1 hdu hdv (norm_QQ_sub_lt y p _) hh).2.2
  -- identify `T (P(U, V))` at address `v`
  have hlenPV := length_ofA (PP y C U V)
  have hTval : (T (PP y C U V) : Fin N → R) ⟨encode sh v, encode_lt hv⟩ =
      ((Mv a : ℂ)⁻¹) • Mr r a (fn L f) (fn L g) (L.coord v) := by
    show (procLI y L ℓ (partAxes a) Sb ℓ (ofA (PP y C U V))).getD (encode sh v) 0 = _
    rw [synth_opposite_list y L hy ha hc hlenPV hv]
    have hx := L.coord_mem v hv
    have hr : 0 < r := C.pos
    have hM : (Mv a : ℂ) ≠ 0 := by exact_mod_cast (Mv_pos (a := a)).ne'
    rw [← normalization hy (fun i => (ha i).trans (Nat.le_succ ℓ)) r hr (fn L f) (fn L g) hx,
      smul_smul, inv_mul_cancel₀ hM, one_smul]
    -- both `F^+` sums only see the box
    unfold Fp
    congr 1
    apply sum_congr rfl
    intro k hk
    congr 1
    have hk' := revV_mem_box a k
    show (ofA (PP y C U V)).getD (encode sh (L.addr (revV a k))) 0 = _
    have hlt := encode_lt (L.valid_addr _ hk')
    rw [getD_ofA, dif_pos hlt]
    show ((r : ℂ)⁻¹) • ((procL y L ℓ (partAxes a) Sb ℓ f).getD (encode sh (L.addr (revV a k))) 0 *
      (procL y L ℓ (partAxes a) Sb ℓ g).getD (encode sh (L.addr (revV a k))) 0) = _
    rw [synth_forward_list y L hy ha hc hf (L.valid_addr _ hk'),
      synth_forward_list y L hy ha hc hg (L.valid_addr _ hk'), L.coord_addr _ hk',
      revV_revV hk]
  have hj := norm_le_dist_carr ht (T (PP y C U V)) ⟨encode sh v, encode_lt hv⟩
  rw [dist_eq_norm] at hj
  have := lt_of_le_of_lt hj key
  rw [hTval] at this
  exact this

/-- **Proposition 18 after the exact scaling by `M`**: the returned array is within
`√2 · M · (3ℓ + 1) · 2^{-p}` of `M_r(f, g) = (f ∗ g)/(rM)`. -/
theorem prop18_scaled_full (p : ℕ) (hy : y ^ (2 ^ ℓ) = -1) (ha : ∀ i, a i ≤ ℓ) (hℓ : 1 ≤ ℓ)
    (hc : ∀ h < ℓ, SelCompat L h (partAxes a h) (Sb h))
    {f g : List R} (hf : f.length = vol sh) (hg : g.length = vol sh)
    (hfd : ∀ k, ‖C.co (f.getD k 0)‖ ≤ 1) (hgd : ∀ k, ‖C.co (g.getD k 0)‖ ≤ 1)
    {v : List ℕ} (hv : Valid sh v) :
    ‖C.co ((Mv a : ℂ) • (procQI y L C p ℓ (partAxes a) Sb ℓ
        (ofA (QQ y C p (PP y C (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ f))
          (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ g)))))).getD (encode sh v) 0 -
        Mr r a (fn L f) (fn L g) (L.coord v))‖ <
      Real.sqrt 2 * (Mv a) * (3 * ℓ + 1) * 2⁻¹ ^ p := by
  have h := prop18_error_full y L p hy ha hℓ hc hf hg hfd hgd hv
  have hM : (0 : ℝ) < Mv a := by exact_mod_cast (Mv_pos (a := a))
  have hMc : (Mv a : ℂ) ≠ 0 := by exact_mod_cast (Mv_pos (a := a)).ne'
  have e : (Mv a : ℂ) • (procQI y L C p ℓ (partAxes a) Sb ℓ
        (ofA (QQ y C p (PP y C (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ f))
          (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ g)))))).getD (encode sh v) 0 -
        Mr r a (fn L f) (fn L g) (L.coord v) =
      (Mv a : ℂ) • ((procQI y L C p ℓ (partAxes a) Sb ℓ
        (ofA (QQ y C p (PP y C (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ f))
          (toA C (vol sh) (procQ C p L ℓ (partAxes a) Sb ℓ g)))))).getD (encode sh v) 0 -
        ((Mv a : ℂ)⁻¹) • Mr r a (fn L f) (fn L g) (L.coord v)) := by
    rw [smul_sub, smul_smul, mul_inv_cancel₀ hMc, one_smul]
  rw [e, map_smul, norm_smul, Complex.norm_natCast]
  calc (Mv a : ℝ) * ‖C.co _‖ < (Mv a : ℝ) * (3 * (ℓ * (Real.sqrt 2 * 2⁻¹ ^ p)) +
        Real.sqrt 2 * 2⁻¹ ^ p) := mul_lt_mul_of_pos_left h hM
    _ = Real.sqrt 2 * (Mv a) * (3 * ℓ + 1) * 2⁻¹ ^ p := by ring

end Prop18

