section
-- Source module: Solutions.KFNPad
/-!
# KFN: running a program on a zero-padded stream

`padC L0 Q code`: park the `L0` entries of the stream (stack `qP`), push `Q` zeros, unpark;
run `code`; park the first `L0` entries, drop the next `Q`, unpark.

**`sImpl_pad`**: if `code` implements `T` on `np ≥ n` records (strides `st`), the padded program
implements `T` on `n` records (the padding records are zero, and the selected-bit structure on
`n` records never reads them: `selOpF_pad`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

section Lists

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : Type*} [AddCommMonoid M] [Module ℂ M]

end Lists

/-! ## The padded program -/

/-- Pad by `Q` zero entries (the register part before the program). -/
def padPre (L0 Q : ℕ) : RS :=
  .seq (NLogN.mvK 0 qP NLogN.KFB.c1 (.lit (L0 : ℤ))) (.seq (zeroK 0 NLogN.KFB.c1 Q) (NLogN.mvK qP 0 NLogN.KFB.c1 (.lit (L0 : ℤ))))

/-- Unpad (the register part after the program). -/
def padPost (L0 Q : ℕ) : RS :=
  .seq (NLogN.mvK 0 qP NLogN.KFB.c1 (.lit (L0 : ℤ))) (.seq (dropK 0 NLogN.KFB.c1 Q) (NLogN.mvK qP 0 NLogN.KFB.c1 (.lit (L0 : ℤ))))

/-- Pad by `Q` zero entries, run `code`, unpad. -/
def padC {Pp : ℕ} (L0 Q : ℕ) (code : ℕ → IStmt HS Pp) : ℕ → IStmt HS Pp := fun w =>
  .seq (fcode (NLogN.KFN.padPre L0 Q)) (.seq (code w) (fcode (padPost L0 Q)))

/-- The cost of a move of `L0` entries of width `w`. -/
def cMv (L0 w : ℕ) : ℕ := zsz (L0 : ℤ) + 2 + cRep L0 + L0 * (250 * (w + 2))

/-- Cost of the padded program. -/
def cPadC (L0 Q Z w dw : ℕ) (cost : ℕ → ℕ) : ℕ :=
  2 * NLogN.KFN.cMv L0 w + cLp Q 8000 Z + cost w + 2 * NLogN.KFN.cMv L0 (w + dw) + cLp Q (2 * (w + dw) + 2) Z

end NLogN.KFN

end

