theorem solution
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (ℓ M' : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) (hℓq : ℓ ≠ q)
    [NeZero M'] (hM'q : ¬ q ∣ M')

    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀]
    (hA₀q : maximalIdeal A₀ = Ideal.span {(q : A₀)}) [Finite (ResidueField A₀)]

    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D →
        ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : GroupLaws A₀) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (𝒯 : LevelTransport A₀ 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)

    (hVC : ∀ (T : Type) [CommRing T] [Algebra A₀ T] (W : WeierstrassCurve.Projective T) (C : WeierstrassCurve.VariableChange T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (C • W))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (C • W)) ≤ (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsVariableChangeHom W C φ)
    (hCO : ∀ (T T' : Type) [CommRing T] [Algebra A₀ T] [CommRing T'] [Algebra A₀ T'] (f : T →ₐ[A₀] T')
      (W : WeierstrassCurve.Projective T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map f.toRingHom))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map f.toRingHom)) ≤
          (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsCoefficientHom W f.toRingHom φ)
    (P₀ : LevelModuliPackageAbs A₀ (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum)
    [Algebra.FiniteType A₀ P₀.B₀]
    (x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Raw P₀.B₀)
    (hx : (Quot.mk _ x : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Pt P₀.B₀) = P₀.univ)
    (𝔪 : Ideal P₀.B₀) [𝔪.IsMaximal] (hq𝔪 : algebraMap A₀ P₀.B₀ (q : A₀) ∈ 𝔪)
    (F₀ : FormalGroup (P₀.B₀ ⧸ 𝔪))
    (hF₀W : F₀.toPowerSeries = (x.curve.map (Ideal.Quotient.mk 𝔪)).formalGroupLawFixed)
    (hF₀ : ∃ u : PowerSeries (P₀.B₀ ⧸ 𝔪), IsUnit u ∧ F₀.nthSeries q = u * PowerSeries.X ^ q) :
    IsDomain (AdicCompletion 𝔪 P₀.B₀) ∧ IsIntegrallyClosed (AdicCompletion 𝔪 P₀.B₀) ∧
      algebraMap P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) (algebraMap A₀ P₀.B₀ (q : A₀)) ≠ 0 := by
  classical
  letI instF : Field (P₀.B₀ ⧸ 𝔪) := Ideal.Quotient.field 𝔪
  obtain ⟨instLoc, instNoe, instCpl, instTow, resR, hresR, hkerR, hrescomp, W₀, instCRW, instDomW, instDVRW,
      instCplW, hW₀, res₀, hres₀, hker₀, instW₀R, instA₀W₀, instTow₂, hresR₀, hchar, hfac⟩ :=
    ModularCurve.LevelModuliPackageAbs.exists_coefficientRing_factorsThrough_adicCompletion_of_levelModuliDatum
      q A₀ hA₀q P₀ 𝔪 hq𝔪

  have hℓk : ((ℓ : ℕ) : P₀.B₀ ⧸ 𝔪) ≠ 0 := by
    haveI := hchar
    intro h
    have hdvd : q ∣ ℓ := (CharP.cast_eq_zero_iff (P₀.B₀ ⧸ 𝔪) q ℓ).mp h
    exact hℓq ((Nat.prime_dvd_prime_iff_eq (Fact.out : q.Prime) (Fact.out : ℓ.Prime)).mp hdvd).symm
  have hM'k : ((M' : ℕ) : P₀.B₀ ⧸ 𝔪) ≠ 0 := by
    haveI := hchar
    intro h
    exact hM'q ((CharP.cast_eq_zero_iff (P₀.B₀ ⧸ 𝔪) q M').mp h)
  let ι : P₀.B₀ →ₐ[A₀] (AdicCompletion 𝔪 P₀.B₀) := IsScalarTower.toAlgHom A₀ P₀.B₀ (AdicCompletion 𝔪 P₀.B₀)
  have hι : (ι : P₀.B₀ →+* (AdicCompletion 𝔪 P₀.B₀)) = algebraMap P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) := rfl

  obtain ⟨hc, -⟩ := h𝒯.2 P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) ι x.level.2.2
  have hlev : x.level.2.2.curve = x.curve := x.isLevel.2.2.1
  have hcurve : ((((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).mapRing ι x).level.2.2.curve).map resR) =
      x.curve.map (Ideal.Quotient.mk 𝔪) := by
    change WeierstrassCurve.map ((𝒯.map ι x.level.2.2).curve) resR = _
    rw [hc, hlev]
    change WeierstrassCurve.map (WeierstrassCurve.map x.curve ι.toRingHom) resR = _
    rw [WeierstrassCurve.map_map]
    have hι' : ι.toRingHom = algebraMap P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) := rfl
    rw [hι', hrescomp]
  have hq2 : q ≠ 2 := by omega
  obtain ⟨g, hgm, hgdeg, hgcoef, ⟨u, hu, hg0⟩, ⟨e⟩⟩ :=
    ModularCurve.LevelModuliPackageAbs.exists_algEquiv_adjoinRoot_powerSeries_of_factorsThrough_of_nthSeries_eq_mul_X_pow_of_five_le_gamma0Pow
      q hq2 hq ℓ M' hℓ3 A₀ hℓ hM 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 P₀ x hx (AdicCompletion 𝔪 P₀.B₀) ι (P₀.B₀ ⧸ 𝔪) hℓk hM'k resR hresR hkerR
      W₀ hW₀ res₀ hres₀ hker₀ hresR₀ hfac F₀ (hcurve ▸ hF₀W) hF₀

  haveI hregS : IsRegularLocalRing (PowerSeries W₀) :=
    (IsRegularLocalRing.mvPowerSeries_fin W₀ 1).of_ringEquiv (MvPowerSeries.renameEquiv W₀ finOneEquiv).toRingEquiv
  have hdimS : ringKrullDim (PowerSeries W₀) = 2 := by
    rw [← ringKrullDim_eq_of_ringEquiv (MvPowerSeries.renameEquiv W₀ finOneEquiv).toRingEquiv,
      MvPowerSeries.ringKrullDim_fin_eq_of_isDiscreteValuationRing W₀ 1]
    norm_num

  have hqW : (q : W₀) ≠ 0 := by
    intro h0
    have : maximalIdeal W₀ = ⊥ := by rw [hW₀, h0, Ideal.span_singleton_eq_bot]
    exact IsDiscreteValuationRing.not_isField W₀ ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr this)
  haveI hlocCC : IsLocalHom (PowerSeries.constantCoeff (R := W₀)) :=
    ⟨fun s hs => PowerSeries.isUnit_iff_constantCoeff.mpr hs⟩
  have h0 : g.coeff 0 ∉ maximalIdeal (PowerSeries W₀) ^ 2 := by
    rw [hg0]
    intro hmem
    have hle : (maximalIdeal (PowerSeries W₀)).map (PowerSeries.constantCoeff (R := W₀)) ≤ maximalIdeal W₀ :=
      ((IsLocalRing.local_hom_TFAE (PowerSeries.constantCoeff (R := W₀))).out 0 2).mp hlocCC
    have h1 : PowerSeries.constantCoeff ((q : PowerSeries W₀) * u) ∈ maximalIdeal W₀ ^ 2 := by
      have := Ideal.mem_map_of_mem (PowerSeries.constantCoeff (R := W₀)) hmem
      rw [Ideal.map_pow] at this
      exact Ideal.pow_right_mono hle 2 this
    rw [map_mul, map_natCast, hW₀, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h1
    obtain ⟨c, hc⟩ := h1
    have hu0 : IsUnit (PowerSeries.constantCoeff u) := PowerSeries.isUnit_constantCoeff u hu
    have : PowerSeries.constantCoeff u = q * c := by
      have : (q : W₀) * PowerSeries.constantCoeff u = q * (q * c) := by rw [hc]; ring
      exact mul_left_cancel₀ hqW this
    apply (mem_nonunits_iff.mp ((mem_maximalIdeal _).mp (_ : PowerSeries.constantCoeff u ∈ maximalIdeal W₀))) hu0
    rw [this, hW₀]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)

  have hq3 : 3 ≤ q := by omega
  obtain ⟨hregT, hdimT⟩ :=
    IsRegularLocalRing.adjoinRoot_of_monic_of_coeff_mem_maximalIdeal_of_coeff_zero_not_mem_sq (PowerSeries W₀) g hgm
      (by rw [hgdeg]; omega) (by rw [hgdeg]; exact hgcoef) h0
  haveI := hregT
  haveI hdomT : IsDomain (AdjoinRoot g) := IsRegularLocalRing.isDomain _
  haveI : UniqueFactorizationMonoid (AdjoinRoot g) :=
    IsRegularLocalRing.uniqueFactorizationMonoid_of_ringKrullDim_le_two _ (by rw [hdimT, hdimS])
  haveI : IsIntegrallyClosed (AdjoinRoot g) := inferInstance
  refine ⟨(e : (AdicCompletion 𝔪 P₀.B₀) ≃ₐ[W₀] AdjoinRoot g).toMulEquiv.isDomain,
    IsIntegrallyClosed.of_equiv (e : (AdicCompletion 𝔪 P₀.B₀) ≃ₐ[W₀] AdjoinRoot g).toRingEquiv.symm, ?_⟩

  have hR : algebraMap P₀.B₀ (AdicCompletion 𝔪 P₀.B₀) (algebraMap A₀ P₀.B₀ (q : A₀)) =
      algebraMap W₀ (AdicCompletion 𝔪 P₀.B₀) (q : W₀) := by
    rw [← IsScalarTower.algebraMap_apply A₀ P₀.B₀ (AdicCompletion 𝔪 P₀.B₀),
      IsScalarTower.algebraMap_apply A₀ W₀ (AdicCompletion 𝔪 P₀.B₀), map_natCast]
  rw [hR]
  intro hz
  have h1 := congrArg e hz
  rw [AlgEquiv.commutes, map_zero, IsScalarTower.algebraMap_apply W₀ (PowerSeries W₀) (AdjoinRoot g),
    map_natCast] at h1
  have hinjOf : Function.Injective (algebraMap (PowerSeries W₀) (AdjoinRoot g)) :=
    AdjoinRoot.of.injective_of_degree_ne_zero (by
      rw [Polynomial.degree_eq_natDegree hgm.ne_zero, hgdeg]; exact_mod_cast (show q - 1 ≠ 0 by omega))
  have h2 : ((q : ℕ) : PowerSeries W₀) = 0 := hinjOf (by rwa [map_zero])
  rw [← map_natCast (PowerSeries.C (R := W₀))] at h2
  exact hqW (PowerSeries.C_injective (by rwa [map_zero]))

