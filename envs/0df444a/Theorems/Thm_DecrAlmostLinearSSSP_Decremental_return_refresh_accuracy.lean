-- title:
--   Lemma 3.8 — Return-refresh accuracy
-- statement:
--   In the same algorithm with $K\ge32$, let $p$ be the current labels at an attained stable state. For each nonsource vertex $v$, let $\bar p_v$ be the label actually sampled at initialization or the most recent refresh of its return edge $v\to s$. Then
--
--   $$(1-\epsilon/8)p_v\le\bar p_v\le(1+\epsilon/8)p_v\qquad(v\ne s).$$
--
--   Both directions hold simultaneously. The sample is retained by the execution semantics and cannot be chosen after seeing the desired answer. This is the link between current implicit labels and the explicit historical output array.
--
--   Differences from the source:
--   - encoding: the actual §3.2.2 run using the dynamic cut interface → attained states of deterministic repair and refresh semantics with the cut quality guarantee on those states; reason: the interface is a standing algorithmic dependency, while no balance or accuracy conclusion is an input hypothesis
-- source:
--   Bin Cui, Hanqing Li, Xupeng Miao, Haoze Wang, STOC 2027 submission #912 (October 2026), p. 16, Lemma 3.8, equations (3.30)–(3.31); p. 17, proof; pp. 7–11, standing parameters and algorithm; pinned PDF: https://github.com/sigact-stoc/stoc2027/releases/download/papers-2/912.pdf

import Mathlib
import Definitions.Def_DecrAlmostLinearSSSP_Decremental_Algorithm

set_option autoImplicit false
open scoped ENNReal NNReal

namespace DecrAlmostLinearSSSP.Decremental

/-- Lemma 3.8; sample is the actual last return insertion/refresh sample generated by the interpreter. -/
theorem return_refresh_accuracy (b : Core) (K : ℝ) (hK : 32 ≤ K)
    (choose : State b → CutReply b) (hcut : CutQuality b K choose)
    (s : State b) (hs : Attained b K choose s) (hstable : Stable b s) :
    ∀ v, v ≠ b.input.source →
      (1 - b.input.accuracy / 8) * labels b s v ≤ s.sample v ∧
      s.sample v ≤ (1 + b.input.accuracy / 8) * labels b s v := by sorry

end DecrAlmostLinearSSSP.Decremental
