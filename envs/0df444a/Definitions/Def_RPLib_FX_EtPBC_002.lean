variable {Λ : Type u} [CommRing Λ] {X P Y : Scheme.{u}} (ι : X ⟶ P) (π : Y ⟶ P) {M : ModuleCat.{u} Λ}
  {Ω : Type u} [Field Ω] [IsSepClosed Ω]

/-- The geometric point `τ ≫ π_s` of `X`. -/
def sigPt (τ : Spec (CommRingCat.of Ω) ⟶ pullback π ι) : GeomPt X where
  Ω := Ω
  pt := τ ≫ pullback.snd π ι

theorem kap_cond_aux {W : P.Etale} {U : X.Etale} (m : U.left ⟶ pullback W.hom ι)
    (hm : m ≫ pullback.snd W.hom ι = U.hom) :
    (pullback.snd (pullback.snd π ι) U.hom ≫ m ≫ pullback.fst W.hom ι) ≫ W.hom =
      (pullback.fst (pullback.snd π ι) U.hom ≫ pullback.fst π ι) ≫ π := by
  simp only [Category.assoc]
  rw [pullback.condition (f := W.hom) (g := ι), ← Category.assoc m, hm,
    ← pullback.condition_assoc (f := pullback.snd π ι) (g := U.hom), ← pullback.condition (f := π) (g := ι)]

end RamanujanPetersson.EtPBC

