def ProRep : Prop :=
  ∀ (A : Type) [CommRing A] [IsLocalRing A] [IsArtinianRing A] [Algebra O A]
      (resA : A →+* ResidueField O), Function.Surjective resA →
      resA.comp (algebraMap O A) = residue O →
    ∀ (X : FormalODModule q A), X.IsSpecial ((algebraMap O A).comp ι) → X.HasHeight 4 →
    ∀ (w : (X.map resA).Hom X₀.toFormalODModule), w.IsIso →
      ∃! χ : R →ₐ[O] A, resA.comp χ.toRingHom = resR ∧
        ∃ v : (Xu.map χ.toRingHom).Hom X, v.IsIso ∧
          (w.comp (v.map resA)).toSeries = wu.toSeries

variable {A : Type} [CommRing A] [IsLocalRing A] [IsArtinianRing A] [Algebra O A]
  (resA : A →+* ResidueField O)

def Rig (E : FakeEllipticCurve Λ 1 A) (g : u₀.1.A ⟶ E.A) (X : FormalODModule q A)
    (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (w : (X.map resA).Hom X₀.toFormalODModule) : Prop :=
  letI : Algebra A (ResidueField O) := resA.toAlgebra
  E.IsFormalModuleVia coord X θ ∧ w.IsIso ∧
    ∀ (B'' : Type) [CommRing B''] [Algebra A B''] [Algebra (ResidueField O) B''] [IsScalarTower A (ResidueField O) B'']
      (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        (θ₀ B'' (fun i => MvFormalGroup.nilEval n (w.toSeries i) s)).1 ≫ g = (θ B'' s).1

def P (X : FormalODModule q A) (w : (X.map resA).Hom X₀.toFormalODModule) (χ : R →ₐ[O] A) : Prop :=
  resA.comp χ.toRingHom = resR ∧
    ∃ v : (Xu.map χ.toRingHom).Hom X, v.IsIso ∧ (w.comp (v.map resA)).toSeries = wu.toSeries

