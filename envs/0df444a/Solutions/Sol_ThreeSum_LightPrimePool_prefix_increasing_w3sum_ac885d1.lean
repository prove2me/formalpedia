set_option autoImplicit false
open ThreeSum ThreeSum.LightPrimePool
open Light
set_option maxHeartbeats 1000000
set_option maxRecDepth 10000
namespace ThreeSum.LightPrimePool
theorem _root_.solution (y i : ℕ) : (scanned y i).Pairwise (· < ·) := by
  induction i with
  | zero => simp [scanned]
  | succ i ih =>
      unfold scanned
      split
      · rw [List.pairwise_append]
        refine ⟨ih,by simp,?_⟩
        intro a ha b hb
        have hb' : b = y+i+1 := by simpa using hb
        have ha' := (mem_prefix.mp ha).2.2
        omega
      · exact ih
end ThreeSum.LightPrimePool
