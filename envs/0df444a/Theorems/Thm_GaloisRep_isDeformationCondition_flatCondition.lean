theorem GaloisRep.isDeformationCondition_flatCondition (𝒪 : Type) [CommRing 𝒪]
    {p : ℕ} {S : Finset ℕ} :
    GaloisRep.IsDeformationCondition 𝒪 (GaloisRep.flatCondition 𝒪 p S) := by sorry
