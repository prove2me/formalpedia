private theorem eq_zero_of_mulVec_eq_smul_of_odd (hφk : ∀ x : k, φ (algebraMap k F x) = algebraMap k F x)
    (hφfix : ∀ a : F, φ a = a → ∃ a₀ : k, algebraMap k F a₀ = a) {n : ℕ}
    (hφn : ∀ x, (φ ^ n) x = x) (hodd : Odd n) (Y₀ : Matrix (Fin 2) (Fin 2) k)
