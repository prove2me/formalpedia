/-- Joint smoothness of a left-inverse metric family. -/
theorem contDiffOn_inv_joint {g ginv : ℝ → Metric n} {W : Set (ℝ × Pt n)}
    (hg : ∀ i j, ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => g p.1 i j p.2) W)
    (hinv : ∀ p ∈ W, metricMatrix (ginv p.1) p.2 * metricMatrix (g p.1) p.2 = 1) (i j : Fin n) :
    ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => ginv p.1 i j p.2) W :=
  contDiffOn_left_inverse (A := fun p : ℝ × Pt n => metricMatrix (g p.1) p.2)
    (B := fun p : ℝ × Pt n => metricMatrix (ginv p.1) p.2) (fun a b => hg a b) hinv i j

