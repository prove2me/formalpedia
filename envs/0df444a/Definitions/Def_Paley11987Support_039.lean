variable {n k : ℕ} {I : Type} [Fintype I]

def candidateCost (q t u m δ a b s j : ℕ) : ℕ :=
  let E := m*(q+1)-m.choose 2
  let L := (u*m+u.choose 2)-q*u
  let save := L-u
  let intr := min (m.choose 2) (2*m)
  u*a+(t-u)*b+(E-save-δ)*s+(intr+min u save+δ)*j









