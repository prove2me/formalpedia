variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : Type*} [AddCommMonoid M] [Module ℂ M]

theorem fbit_block {st : ι → ℕ} {n : ℕ} (ha : ∀ i, 2 * st i ∣ n) (v j : ℕ) :
    fbit st (v * n + j) = fbit st j := by
  funext i
  obtain ⟨k, hk⟩ := ha i
  apply Fin.ext
  simp only [fbit]
  rcases Nat.eq_zero_or_pos (st i) with h0 | hpos
  · simp [h0]
  rw [hk, show v * (2 * st i * k) + j = j + (2 * v * k) * st i by ring,
    Nat.add_mul_div_right _ _ hpos, mul_assoc, Nat.add_mul_mod_self_left]

theorem fsetZ_block {st : ι → ℕ} {n : ℕ} (ha : ∀ i, 2 * st i ∣ n) (v j : ℕ) (y : ι → Fin 2) :
    fsetZ st (v * n + j) y = (v * n : ℕ) + fsetZ st j y := by
  simp only [fsetZ, fbit_block ha]; push_cast; ring

theorem fset_block {st : ι → ℕ} {n : ℕ} (hs : SLaws st n) (ha : ∀ i, 2 * st i ∣ n) (v : ℕ)
    {j : ℕ} (hj : j < n) (y : ι → Fin 2) : fset st (v * n + j) y = v * n + fset st j y := by
  unfold fset
  rw [fsetZ_block ha]
  have := hs.nonneg j hj y
  omega

/-- **An operator inside the role blocks acts on each stream.** -/
theorem selOpF_flatR {W : ℕ} {st : ι → ℕ} {n : ℕ} (hs : SLaws st n) (ha : ∀ i, 2 * st i ∣ n)
    (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) {X : Fin W → List M} (hX : ∀ v, (X v).length = n) :
    selOpF st (W * n) T (flatR X) = flatR fun v => selOpF st n T (X v) := by
  have hn : ∀ v, (selOpF st n T (X v)).length = n := fun v => length_selOpF _ _ _ _
  apply List.ext_getElem (by rw [length_selOpF, length_flatR hn])
  intro J h1 h2
  rw [length_selOpF] at h1
  have hn0 : 0 < n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · simp [h] at h1
    · exact h
  set v : Fin W := ⟨J / n, by rw [Nat.div_lt_iff_lt_mul hn0]; linarith⟩
  have hJ : J = v.val * n + J % n := by simp only [v]; rw [mul_comm, Nat.div_add_mod]
  have hjn : J % n < n := Nat.mod_lt _ hn0
  rw [← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0, getD_selOpF _ _ _ _ h1]
  conv_rhs => rw [hJ]
  rw [getD_flatR hn 0 v hjn, getD_selOpF _ _ _ _ hjn]
  conv_lhs => rw [hJ]
  rw [fbit_block ha]
  refine Finset.sum_congr rfl fun y _ => ?_
  rw [fset_block hs ha _ hjn, getD_flatR hX 0 v (hs.lt _ hjn y)]

end Blocks

