  -- opposite
  obtain ⟨zh0, a3, b3, l3, d3, R3⟩ := HO sB hC0 _ l _ rK lK gK dK
  have hL3 : (NLogN.KFB.gflat zh0).length = 2 * (2 ^ n * 2 ^ ℓ) := by
    rw [NLogN.KFV.gflat_length, a3.1, l3]
  -- scaling
  have SC := NLogN.KFV.scaleS_runs (I := I) (iprog := iprog) (w := W) (B := B) sB hn hl hB l hL3 b3.bnd
  rw [← NLogN.KFV.gflat_scG] at SC
  refine ⟨zh0.map (NLogN.KFV.scG n), NLogN.KFV.recRep_scG a3, l3, ?_⟩
  rw [← hsB] at S1 S2
  exact R1.seq (S1.seq (R2.seq (S2.seq (K1.seq (R3.seq SC)))))
end
