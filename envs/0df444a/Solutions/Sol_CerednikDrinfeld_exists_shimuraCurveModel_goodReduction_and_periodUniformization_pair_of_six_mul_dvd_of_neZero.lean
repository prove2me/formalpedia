private theorem e_surj_torsion (hinj : Function.Injective ιT) :
    ∀ t : J, IsOfFinAddOrder t → t ∈ e.range := by
  intro t ht
  obtain ⟨n, hn, hnt⟩ := isOfFinAddOrder_iff_nsmul_eq_zero.mp ht
  have ht' : IsOfFinAddOrder (ιT t) :=
    isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, hn, by rw [← map_nsmul, hnt, map_zero]⟩
  obtain ⟨u, hu⟩ := AddMonoidHom.mem_range.mp
    ((EquivariantUniformization.eFull_restrict_U_torsion_and_equiv 𝒰).1 (ιT t) ht')
  refine AddMonoidHom.mem_range.mpr ⟨u, hinj ?_⟩
  rw [he]
  exact hu

include he in
