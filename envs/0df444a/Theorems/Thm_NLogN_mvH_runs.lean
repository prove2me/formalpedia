variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.mvH_runs {X Y : Fin NS} (hXY : X ≠ Y) (hXC : X ≠ CC) (hYC : Y ≠ CC) (hX3 : X ≠ NLogN.T3)
    (hY3 : Y ≠ NLogN.T3) (hXH : X ≠ HH) (hYH : Y ≠ HH) (s : IState NS) (A : List ℤ) (R LH : List Item)
    (m : ℕ) (hX : s.G X = ints A ++ R) (hH : s.G HH = .int A.length :: LH) (hA : NLogN.Bnd m A) :
    IRuns I iprog (mvH X Y) s ((s.upd X R).upd Y ((ints A).reverse ++ s.G Y))
      (A.length * (1000 * (m + zsz (A.length : ℤ) + 3)) + 300 * (zsz (A.length : ℤ) + 1) + 40) := by sorry
