import Mathlib

/-!
# Finite max-plus tropical convexity

This file develops normalized max-plus combinations and proves a finite tropical
Carathéodory theorem.  In `Fin d → ℝ`, every point generated by finitely many
points is generated by a subset of at most `d + 1` of them.
-/

open Finset Set

namespace TropicalConvexity

variable {d : ℕ}

/-- A normalized finite max-plus tropical combination.  The conditions
`w j ≤ 0` and `w j₀ = 0` remove the common additive scaling ambiguity. -/
def IsTropicalCombination {m : ℕ} (p : Fin m → Fin d → ℝ)
    (z : Fin d → ℝ) : Prop :=
  ∃ (hm : 0 < m) (w : Fin m → ℝ),
    (∀ j, w j ≤ 0) ∧ (∃ j, w j = 0) ∧
      ∀ i, z i = Finset.univ.sup' ⟨⟨0, hm⟩, Finset.mem_univ _⟩ (fun j => w j + p j i)

/-- Tropical convex hull, expressed by finite normalized combinations. -/
def tropicalConvexHull (S : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  {z | ∃ (m : ℕ) (p : Fin m → Fin d → ℝ), (∀ j, p j ∈ S) ∧ IsTropicalCombination p z}






end TropicalConvexity


