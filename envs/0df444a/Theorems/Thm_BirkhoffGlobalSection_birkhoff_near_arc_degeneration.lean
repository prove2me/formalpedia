-- title:
--   Near family degenerates into a collision orbit at the first bad parameter
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. A state is $s=(z_1,z_2,w_1,w_2)$; its physical position relative to the primary is $(x_1,x_2)=(2(z_1^2-z_2^2),\,4z_1z_2)$, and $(v_1,v_2)$ denotes the physical (Jacobi) velocity. A collision state has $z=0$; on $K=0$ it has $|w|^2=1-\mu$. $N(r)$ and $F(r)$ are the perpendicular near and far starts at $z=(r,0)$ and $z=(0,r)$, and $(\sigma,\eta)$ are the shooting coordinates (velocity sine and depth $-x_2$).
--
--   **Degeneration of the near family.** Let $b>0$. Suppose $N(r)$ admits a near shooting arc for every $0<r<b$, but $N(b)$ does not. Then there is $T>0$ such that the following hold.
--
--   - The backward orbit of $N(b)$ stays in the open quadrant $\{x_1>0,\ x_2<0\}$ for $-T<t<0$.
--   - $\varphi_{-T}N(b)$ is a collision state.
--   - The arc lengths $\tau(r)$ of the near arcs from $N(r)$ tend to $T$ as $r\to b^-$.
--
--   That is, the near arcs converge to a collision orbit. Tangency with the vertical line and an earlier return to the axis are excluded by the monotone quantities along near arcs.
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18 (Collected Mathematical Papers Vol. 1, pp. 731–741); Liu–Salomão, arXiv 2506.17867v2, §5, pp. 30–31

import Definitions.Def_BirkhoffShootingArcs

namespace BirkhoffGlobalSection

theorem birkhoff_near_arc_degeneration (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ)
    (b : ℝ) (hb : 0 < b)
    (hgood : ∀ r ∈ Set.Ioo 0 b, ∃ x : LeftEnergyState μ c, (x : Phase) = nearShootingStart μ c r ∧ ∃ τ : ℝ, IsNearShootingArc φ x τ)
    (hbad : ¬ (∃ x : LeftEnergyState μ c, (x : Phase) = nearShootingStart μ c b ∧ ∃ τ : ℝ, IsNearShootingArc φ x τ)) :
    ∃ xb : LeftEnergyState μ c, (xb : Phase) = nearShootingStart μ c b ∧ ∃ T : ℝ, 0 < T ∧
      (∀ t ∈ Set.Ioo (-T) 0,
        0 < relativePosition μ ((φ t xb : LeftEnergyState μ c) : Phase) 0 ∧
        relativePosition μ ((φ t xb : LeftEnergyState μ c) : Phase) 1 < 0) ∧
      ((φ (-T) xb : LeftEnergyState μ c) : Phase) 0 = 0 ∧
      ((φ (-T) xb : LeftEnergyState μ c) : Phase) 1 = 0 ∧
      ∀ η > 0, ∃ δ > 0, ∀ r ∈ Set.Ioo (b - δ) b, ∀ x : LeftEnergyState μ c, ∀ τ : ℝ,
        (x : Phase) = nearShootingStart μ c r → IsNearShootingArc φ x τ → |τ - T| < η := by sorry

end BirkhoffGlobalSection
