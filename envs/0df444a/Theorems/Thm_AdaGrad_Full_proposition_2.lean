-- title:
--   Proposition 2 — regret of primal-dual subgradient (dual averaging) with growing quadratic proximal functions, (10)
-- statement:
--   Let $\mathcal X\subseteq\mathbb R^d$ be closed and convex with $0\in\mathcal X$, $f_t$ and $\varphi$ convex with $\varphi$ minimized over $\mathcal X$ at $0$, and $\eta>0$. Let $H_0,H_1,\dots,H_T$ be positive definite matrices with $H_0\preceq H_1\preceq\dots\preceq H_T$, put $\psi_t(x)=\tfrac12\langle x,H_tx\rangle$, and let $x_1=0,x_2,\dots,x_{T+1}$ be generated by the primal-dual subgradient update (3). Then for every $x^*\in\mathcal X$,
--   $$\sum_{t=1}^T f_t(x_t)+\varphi(x_t)-f_t(x^*)-\varphi(x^*)\le\frac1\eta\psi_T(x^*)+\frac\eta2\sum_{t=1}^T\|g_t\|_{\psi_{t-1}^*}^2,$$
--   where $\|g\|_{\psi_{t-1}^*}^2=\langle g,H_{t-1}^{-1}g\rangle$.
--
--   This is the regret bound of regularized dual averaging when the proximal function is allowed to grow over time.
--
--   **Formalization Note** Specialised to quadratic proximal functions. The paper's standing assumptions (p. 2129) — $\psi_t$ non-decreasing and 1-strongly convex with respect to $\|\cdot\|_{\psi_t}$ — are taken as $H_t$ positive definite and $H_t\preceq H_{t+1}$. The paper's $x_1=\arg\min_{\mathcal X}\varphi$ is taken with $x_1=0$; its proof also uses $x_1=\nabla\psi_0^*(0)=\arg\min_{\mathcal X}\psi_0$ (p. 2153), which holds for $x_1=0$. The dual norm is written with the pseudo-inverse, which equals the inverse for positive definite $H_{t-1}$.
-- source:
--   Duchi, Hazan, Singer, Adaptive Subgradient Methods for Online Learning and Stochastic Optimization, JMLR 12 (2011), p. 2129, Proposition 2, (10)

import Mathlib
import Definitions.Def_AdaGrad_Full_Algorithm2
open scoped MatrixOrder InnerProductSpace

namespace AdaGrad.Full

/-- Proposition 2, inequality (10) (p. 2129), specialised to quadratic proximal functions
`ψ_t(x) = ½⟨x, H_t x⟩` with `H_0 ⪯ H_1 ⪯ ⋯ ⪯ H_T` positive definite, started at `x_1 = 0`,
a minimizer of `ϕ` (and of `ψ_0`) over `X`. -/
theorem proposition_2 {d : ℕ} (η : ℝ) (hη : 0 < η) (X : Set (EuclideanSpace ℝ (Fin d)))
    (hXc : Convex ℝ X) (hXcl : IsClosed X) (h0X : (0 : EuclideanSpace ℝ (Fin d)) ∈ X)
    (f : ℕ → EuclideanSpace ℝ (Fin d) → ℝ) (hf : ∀ t, ConvexOn ℝ Set.univ (f t))
    (ϕ : EuclideanSpace ℝ (Fin d) → ℝ) (hϕ : ConvexOn ℝ Set.univ ϕ)
    (hϕ0 : ∀ y ∈ X, ϕ 0 ≤ ϕ y)
    (H : ℕ → Matrix (Fin d) (Fin d) ℝ) (x g : ℕ → EuclideanSpace ℝ (Fin d)) (T : ℕ)
    (hH : ∀ t ≤ T, (H t).PosDef) (hmono : ∀ t < T, (H (t + 1) - H t).PosSemidef)
    (hx1 : x 1 = 0) (hrun : IsQuadPrimalDualRun η X ϕ f H x g T)
    (xstar : EuclideanSpace ℝ (Fin d)) (hstar : xstar ∈ X) :
    AdaGrad.Diag.regret f ϕ x xstar T ≤
      1 / η * psi (H T) xstar + η / 2 * ∑ t ∈ Finset.Icc 1 T, dualNormSq (H (t - 1)) (g t) := by sorry

end AdaGrad.Full
