-- title:
--   Exact coRE completeness and alternate-model verifier values
-- statement:
--   A predicate $P$ on natural-number game descriptions is coRE-complete when its complement is recursively enumerable and every coRE language $L$ of finite binary strings has a total computable map $r$ satisfying
--   $$x\in L\iff P(r(x)).$$
--   The halting language uses a finite binary description of a universal partial-recursive program and its input: interpret the bits as a little-endian binary integer, unpair it, decode the first component as a Mathlib partial-recursive program, and ask whether its evaluation on the second component is defined. This is a fixed effective program/input encoding.
--   The explicit commuting value evaluates the base explicit game with the commuting model. The succinct oracularisable and tracial values evaluate the same finite game generated by the published polynomial-time verifier on a binary input, using the corresponding strategy model. No expanded game table or polynomial bound on its size is assumed.
-- source:
--   Richard Cleve, Eric Culf, Aviv Taller, XOR Games at Full Tilt: The Hardness of Binary Nonlocal Games, STOC 2027 submission #396 (October 2026), pp.20,31–32,37,39, decision problems in Theorems 4.1,6.4,6.10,6.14

import Mathlib
import Definitions.Def_XORFullTilt_Hardness_Supplement_CommutingModel
import Definitions.Def_XORFullTilt_Hardness_Supplement_TracialModel
import Definitions.Def_XORFullTilt_Hardness_EffectiveGames

namespace XORFullTilt.Hardness.Supplement

/-- Finite binary code of a program/input pair: little-endian binary integer,
    Cantor unpairing, then Mathlib's universal partial recursive program decoder. -/
def haltingLanguage (x : List Bool) : Prop :=
  let p := Nat.unpair (Nat.ofDigits 2 (x.map Bool.toNat))
  ((Nat.Partrec.Code.ofNatCode p.1).eval p.2).Dom

/-- Complement enumerability and total many-one hardness, with no promise band. -/
def CoREComplete (P : ℕ → Prop) : Prop :=
  REPred (fun n => ¬ P n) ∧
  ∀ L : List Bool → Prop, REPred (fun x => ¬ L x) →
    ∃ r : List Bool → ℕ, Computable r ∧ ∀ x, L x ↔ P (r x)

noncomputable def explicitCOValue (n : ℕ) : ℝ := coValue (explicitGame n).game

noncomputable def succinctOracularisableValue (V : SuccinctVerifier) (z : List Bool) : ℝ :=
  oracularisableValue (V.game z).game

noncomputable def succinctTracialValue (V : SuccinctVerifier) (z : List Bool) : ℝ :=
  tracialValue (V.game z).game
end XORFullTilt.Hardness.Supplement


