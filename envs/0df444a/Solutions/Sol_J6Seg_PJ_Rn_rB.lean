theorem getD_map_range (f : ℕ → ℤ) {s j : ℕ} (hj : j < s) : ((List.range s).map f).getD j 0 = f j := by
  rw [List.getD_eq_getElem _ _ (by simpa using hj), List.getElem_map, List.getElem_range]

theorem map_range_bnd {f : ℕ → ℤ} {s : ℕ} {V : ℤ} (h : ∀ j < s, |f j| ≤ V) :
    ∀ x ∈ (List.range s).map f, |x| ≤ V := by
  intro x hx
  simp only [List.mem_map, List.mem_range] at hx
  obtain ⟨j, hj, rfl⟩ := hx
  exact h j hj

end J6Seg.PJ

