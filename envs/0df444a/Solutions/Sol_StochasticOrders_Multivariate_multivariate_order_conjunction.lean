import Mathlib
import Definitions.Def_StochasticOrders_Multivariate_MultivariateOrder

/-! Disproof of fc28449d `StochasticOrders.Multivariate.multivariate_order_conjunction`.

`ψ` is only assumed monotone, not measurable, and `μ {ω | x < ψ (X ω)}` is then an OUTER
measure, which depends on the σ-algebra of the sample space and not only on the law of `X`.
Take `m = 1`, `n = 2`, and let `V ⊆ [0,1)` be a Vitali set (one point from each class of `ℝ/ℚ`).
Every measurable subset of `V` is null, but `V` has positive outer measure. Set:
* `Ω = ℝ` with `μ = Leb|[0,1)` and `X t = (t, -t)`;
* `Ω' = {x : ℝ // x ∉ V}` with its subtype σ-algebra, `ν` the trace of `μ` (a probability
  measure whose push-forward under `Subtype.val` is `μ`, because `V` has inner measure `0`),
  and `Y s = (s, -s)`;
* `ψ` the indicator of the upper set generated by the antichain `{(a, -a) : a ∈ V}`.
`X` and `Y` are measurable, and a single-index family is independent. `MultivariateOrder` holds
with equality: `∫ φ ∘ Y ∂ν = ∫ φ ∘ X ∂(map val ν) = ∫ φ ∘ X ∂μ` for every `φ` with `φ ∘ X`
integrable. But `{t | 1/2 < ψ (X t)} = V`, which has positive outer `μ`-measure, while
`{s | 1/2 < ψ (Y s)} = ∅`. So the claimed inequality `μ V ≤ ν ∅ = 0` fails. -/

set_option autoImplicit false

open MeasureTheory

/-! ### A Vitali set `V ⊆ [0,1)` -/

/-- A representative in `[0,1)` of the class of `x` in `ℝ/ℚ`, chosen from the class alone. -/
noncomputable def soMVrep (x : ℝ) : ℝ :=
  Classical.epsilon (fun v : ℝ => v ∈ Set.Ico (0 : ℝ) 1 ∧ ∃ q : ℚ, v - x = q)

theorem soMVrep_spec (x : ℝ) : soMVrep x ∈ Set.Ico (0 : ℝ) 1 ∧ ∃ q : ℚ, soMVrep x - x = q := by
  apply Classical.epsilon_spec (p := fun v : ℝ => v ∈ Set.Ico (0 : ℝ) 1 ∧ ∃ q : ℚ, v - x = q)
  refine ⟨Int.fract x, ⟨Int.fract_nonneg x, Int.fract_lt_one x⟩, -⌊x⌋, ?_⟩
  rw [Int.fract]
  push_cast
  ring

theorem soMVrep_eq {x y : ℝ} (q : ℚ) (h : x - y = q) : soMVrep x = soMVrep y := by
  unfold soMVrep
  congr 1
  funext v
  apply propext
  constructor
  · rintro ⟨hv, r, hr⟩
    exact ⟨hv, r + q, by push_cast; linarith⟩
  · rintro ⟨hv, r, hr⟩
    exact ⟨hv, r - q, by push_cast; linarith⟩

/-- The Vitali set: one point of `[0,1)` from each class of `ℝ/ℚ`. -/
def soMVV : Set ℝ := Set.range soMVrep

theorem soMVV_sub {v : ℝ} (hv : v ∈ soMVV) : v ∈ Set.Ico (0 : ℝ) 1 := by
  obtain ⟨a, rfl⟩ := hv
  exact (soMVrep_spec a).1

theorem soMVV_rat {v w : ℝ} (hv : v ∈ soMVV) (hw : w ∈ soMVV) (q : ℚ) (h : v - w = q) :
    v = w := by
  obtain ⟨a, rfl⟩ := hv
  obtain ⟨b, rfl⟩ := hw
  obtain ⟨_, r, hr⟩ := soMVrep_spec a
  obtain ⟨_, s, hs⟩ := soMVrep_spec b
  exact soMVrep_eq (-r + q + s) (by push_cast; linarith)

/-- Every measurable subset of the Vitali set is null. -/
theorem soMVV_inner {B : Set ℝ} (hB : MeasurableSet B) (hBV : B ⊆ soMVV) : volume B = 0 := by
  let q : ℕ → ℚ := fun k => ((k : ℚ) + 1)⁻¹
  let T : ℕ → Set ℝ := fun k => (fun x => x + (-(q k : ℝ))) ⁻¹' B
  have hTm : ∀ k, MeasurableSet (T k) := fun k => (measurable_add_const _) hB
  have hTvol : ∀ k, volume (T k) = volume B := fun k => measure_preimage_add_right _ _ _
  have hdisj : Pairwise (Function.onFun Disjoint T) := by
    intro i j hij
    rw [Function.onFun, Set.disjoint_left]
    intro x hxi hxj
    have hij' := soMVV_rat (hBV hxi) (hBV hxj) (q j - q i) (by push_cast; ring)
    have hq : (q i : ℝ) = q j := by linarith
    have hq' : q i = q j := by exact_mod_cast hq
    simp only [q, inv_inj, add_left_inj, Nat.cast_inj] at hq'
    exact hij hq'
  have hsub : (⋃ k, T k) ⊆ Set.Ico (0 : ℝ) 2 := by
    intro x hx
    obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hx
    have h1 := soMVV_sub (hBV hk)
    have hq0 : (0 : ℝ) < q k := by
      have : (0 : ℚ) < q k := by positivity
      exact_mod_cast this
    have hq1 : (q k : ℝ) ≤ 1 := by
      have : q k ≤ 1 := inv_le_one_of_one_le₀ (by simp)
      exact_mod_cast this
    simp only [Set.mem_Ico] at h1 ⊢
    constructor <;> linarith [h1.1, h1.2]
  by_contra hne
  have htop : ∑' _ : ℕ, volume B = ⊤ := ENNReal.tsum_const_eq_top_of_ne_zero hne
  have h2 : volume (⋃ k, T k) ≤ volume (Set.Ico (0 : ℝ) 2) := measure_mono hsub
  rw [measure_iUnion hdisj hTm] at h2
  simp only [hTvol, htop, Real.volume_Ico, top_le_iff] at h2
  exact ENNReal.ofReal_ne_top h2

/-- The Vitali set has positive outer measure. -/
theorem soMVV_outer : volume soMVV ≠ 0 := by
  intro h0
  have hcov : Set.Ico (0 : ℝ) 1 ⊆ ⋃ q : ℚ, (fun x => x + (q : ℝ)) ⁻¹' soMVV := by
    intro x _
    obtain ⟨_, q, hq⟩ := soMVrep_spec x
    refine Set.mem_iUnion.mpr ⟨q, ?_⟩
    show x + (q : ℝ) ∈ soMVV
    exact ⟨x, by linarith⟩
  have h1 := measure_mono (μ := volume) hcov
  have h2 := measure_iUnion_le (μ := volume) (fun q : ℚ => (fun x => x + (q : ℝ)) ⁻¹' soMVV)
  simp only [measure_preimage_add_right, h0, tsum_zero] at h2
  rw [Real.volume_Ico] at h1
  have h3 := h1.trans h2
  simp at h3

/-! ### The two probability spaces -/

/-- Lebesgue measure on `[0,1)`. -/
noncomputable def soMV_mu0 : Measure ℝ := volume.restrict (Set.Ico (0 : ℝ) 1)

instance soMV_mu0_prob : IsProbabilityMeasure soMV_mu0 := by
  constructor
  simp [soMV_mu0, Real.volume_Ico]

/-- The complement of the Vitali set carries all of the mass of every measurable set. -/
theorem soMV_mu0_diff (E : Set ℝ) (hE : MeasurableSet E) : soMV_mu0 (E ∩ soMVVᶜ) = soMV_mu0 E := by
  apply le_antisymm (measure_mono Set.inter_subset_left)
  set T := toMeasurable soMV_mu0 (E ∩ soMVVᶜ)
  have hT : MeasurableSet T := measurableSet_toMeasurable _ _
  have hET : MeasurableSet (E \ T) := hE.diff hT
  have hEV : E \ T ⊆ soMVV := by
    intro x hx
    by_contra hxV
    exact hx.2 (subset_toMeasurable _ _ ⟨hx.1, hxV⟩)
  have hnull : soMV_mu0 (E \ T) = 0 := by
    rw [soMV_mu0, Measure.restrict_apply hET]
    exact soMVV_inner (hET.inter measurableSet_Ico) (Set.inter_subset_left.trans hEV)
  calc soMV_mu0 E ≤ soMV_mu0 T + soMV_mu0 (E \ T) := by
        calc soMV_mu0 E ≤ soMV_mu0 (T ∪ (E \ T)) := measure_mono (by
              intro x hx
              by_cases hxT : x ∈ T
              · exact Or.inl hxT
              · exact Or.inr ⟨hx, hxT⟩)
          _ ≤ soMV_mu0 T + soMV_mu0 (E \ T) := measure_union_le _ _
    _ = soMV_mu0 (E ∩ soMVVᶜ) := by rw [hnull, add_zero, measure_toMeasurable]

/-- The trace of `soMV_mu0` on the complement of the Vitali set. -/
noncomputable def soMV_nu : Measure {x : ℝ // x ∉ soMVV} :=
  (OuterMeasure.comap Subtype.val soMV_mu0.toOuterMeasure).toMeasure (by
    intro s hs
    obtain ⟨E, hE, rfl⟩ := hs
    rw [OuterMeasure.isCaratheodory_iff_le]
    intro t
    simp only [OuterMeasure.comap_apply, Set.image_inter_preimage, Set.image_sdiff_preimage]
    exact (measure_inter_add_sdiff _ hE).le)

theorem soMV_nu_preimage (E : Set ℝ) (hE : MeasurableSet E) :
    soMV_nu (Subtype.val ⁻¹' E) = soMV_mu0 E := by
  rw [soMV_nu, toMeasure_apply _ _ (measurable_subtype_coe hE),
    OuterMeasure.comap_apply, Set.image_preimage_eq_inter_range, Subtype.range_coe_subtype]
  exact soMV_mu0_diff E hE

theorem soMV_nu_map : soMV_nu.map Subtype.val = soMV_mu0 := by
  ext E hE
  rw [Measure.map_apply measurable_subtype_coe hE, soMV_nu_preimage E hE]

instance soMV_nu_prob : IsProbabilityMeasure soMV_nu := by
  constructor
  have := soMV_nu_preimage Set.univ MeasurableSet.univ
  rw [Set.preimage_univ] at this
  rw [this]
  exact measure_univ

/-! ### The counterexample -/

/-- The sign vector `(1, -1)`. -/
def soMV_sg (j : Fin 2) : ℝ := 1 - 2 * ((j : ℕ) : ℝ)

/-- `X t = (t, -t)`, a point on the antidiagonal. -/
def soMV_X : Fin 1 → ℝ → Fin 2 → ℝ := fun _ t j => soMV_sg j * t

/-- The same vector, read off the complement of the Vitali set. -/
def soMV_Y : Fin 1 → {x : ℝ // x ∉ soMVV} → Fin 2 → ℝ := fun _ s j => soMV_sg j * s.1

/-- The upper set generated by the antichain `{(a, -a) : a ∈ V}`. -/
def soMV_U : Set (Fin 1 → Fin 2 → ℝ) := {z | ∃ a ∈ soMVV, ∀ j, soMV_sg j * a ≤ z 0 j}

open Classical in
/-- The indicator of `soMV_U`. It is monotone but not Borel. -/
noncomputable def soMV_psi (z : Fin 1 → Fin 2 → ℝ) : ℝ := if z ∈ soMV_U then 1 else 0

theorem soMV_psi_mono : Monotone soMV_psi := by
  intro z z' hz
  by_cases h : z ∈ soMV_U
  · have h' : z' ∈ soMV_U := by
      obtain ⟨a, ha, hle⟩ := h
      exact ⟨a, ha, fun j => (hle j).trans (hz 0 j)⟩
    rw [soMV_psi, soMV_psi, if_pos h, if_pos h']
  · rw [soMV_psi, if_neg h]
    unfold soMV_psi
    split_ifs <;> norm_num

theorem soMV_mem_U (t : ℝ) : (fun i => soMV_X i t) ∈ soMV_U ↔ t ∈ soMVV := by
  constructor
  · rintro ⟨a, ha, hle⟩
    have h0 := hle 0
    have h1 := hle 1
    norm_num [soMV_sg, soMV_X] at h0 h1
    have hat : a = t := by linarith
    rw [← hat]
    exact ha
  · intro ht
    exact ⟨t, ht, fun j => le_refl _⟩

theorem soMV_X_meas (i : Fin 1) : Measurable (soMV_X i) :=
  measurable_pi_lambda _ (fun _ => measurable_const.mul measurable_id)

theorem soMV_Y_meas (i : Fin 1) : Measurable (soMV_Y i) :=
  measurable_pi_lambda _ (fun _ => measurable_const.mul measurable_subtype_coe)

theorem soMV_order :
    StochasticOrders.Multivariate.MultivariateOrder soMV_mu0 soMV_nu (soMV_X 0) (soMV_Y 0) := by
  intro φ _ hφX _
  apply le_of_eq
  calc ∫ ω, φ (soMV_X 0 ω) ∂soMV_mu0
        = ∫ ω, φ (soMV_X 0 ω) ∂(soMV_nu.map Subtype.val) := by rw [soMV_nu_map]
    _ = ∫ s, φ (soMV_X 0 s.1) ∂soMV_nu :=
        integral_map measurable_subtype_coe.aemeasurable
          (by rw [soMV_nu_map]; exact hφX.aestronglyMeasurable)
    _ = ∫ s, φ (soMV_Y 0 s) ∂soMV_nu := rfl

theorem soMV_mu0_V : soMV_mu0 soMVV = volume soMVV := by
  rw [soMV_mu0, Measure.restrict_apply' measurableSet_Ico,
    Set.inter_eq_left.mpr (fun v hv => soMVV_sub hv)]

open MeasureTheory ProbabilityTheory StochasticOrders.Multivariate in
theorem solution : ¬ (∀ {Ω Ω' : Type} [MeasurableSpace Ω] [MeasurableSpace Ω']
    (μ : Measure Ω) (ν : Measure Ω') [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    {m n : ℕ} (X : Fin m → Ω → Fin n → ℝ) (Y : Fin m → Ω' → Fin n → ℝ)
    (hX : ∀ i, Measurable (X i)) (hY : ∀ i, Measurable (Y i))
    (hXindep : iIndepFun X μ) (hYindep : iIndepFun Y ν)
    (hord : ∀ i, MultivariateOrder μ ν (X i) (Y i))
    (ψ : (Fin m → Fin n → ℝ) → ℝ) (hψ : Monotone ψ),
    ∀ x : ℝ, μ {ω | x < ψ (fun i => X i ω)} ≤ ν {ω | x < ψ (fun i => Y i ω)}) := by
  intro H
  have key := @H ℝ {x : ℝ // x ∉ soMVV} inferInstance inferInstance soMV_mu0 soMV_nu
    soMV_mu0_prob soMV_nu_prob 1 2 soMV_X soMV_Y soMV_X_meas soMV_Y_meas
    iIndepFun.of_subsingleton iIndepFun.of_subsingleton
    (fun i => by rw [Subsingleton.elim i 0]; exact soMV_order) soMV_psi soMV_psi_mono (1 / 2)
  have hL : {ω : ℝ | (1 / 2 : ℝ) < soMV_psi (fun i => soMV_X i ω)} = soMVV := by
    ext t
    simp only [Set.mem_ofPred_eq]
    constructor
    · intro h
      by_contra ht
      have hU : (fun i => soMV_X i t) ∉ soMV_U := fun hU => ht ((soMV_mem_U t).mp hU)
      rw [soMV_psi, if_neg hU] at h
      norm_num at h
    · intro ht
      rw [soMV_psi, if_pos ((soMV_mem_U t).mpr ht)]
      norm_num
  have hR : {ω : {x : ℝ // x ∉ soMVV} | (1 / 2 : ℝ) < soMV_psi (fun i => soMV_Y i ω)} = ∅ := by
    ext s
    simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
    have hU : (fun i => soMV_Y i s) ∉ soMV_U := fun hU => s.2 ((soMV_mem_U s.1).mp hU)
    rw [soMV_psi, if_neg hU]
    norm_num
  rw [hL, hR, measure_empty, soMV_mu0_V] at key
  exact soMVV_outer (le_antisymm key zero_le)
