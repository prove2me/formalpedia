-- Source module: Solutions.J6SegILSrc19
/-!
# B-line IL, source-table producers, part 19: `SetupS` for the four slab passes

`setup_of`: a body taking `RF v c` to `regOut (RF v c) cs …` (for every `v` with `ParV` and every
`c` empty off `0, sZ, Z`) and a tear-down taking `regOut F cs …` back to `F` give
`SetupS … (upF dA Z Z1 Cm body) dn ρS dA desc (slabV cs …) C`.
`setup1/3/5/7`: the four passes (`body1/3/5/7`, `dn0`/`dn7`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost)
open J6Seg.PJ (rg RF RF_in RF_out ParV BV parBig cPar dsc)
open J6Seg.Ax (ρS sZ slabV SetupS)

set_option maxHeartbeats 1000000 in
theorem setup_of_sol_aux {Pp : ℕ} {I : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA Z Z1 Cm : Fin HS}
    (hP : ParkOK dA Z Z1 Cm) (hZ : ZOK Z) {body : IStmt HS Pp} {dn : RS}
    {k pre post sv t p α d W : ℕ} (hW : parBig 0 0 0 0 k pre post sv t p α d < 2 ^ W) (hW3 : 3 ≤ W)
    (cs : List (ℤ × ℤ)) (n' : ℕ) (K1 K2 : List ℤ) {cB cD : ℕ}
    (hbody : ∀ s0 v c, ParV 0 0 0 0 pre post sv t p α d v → BV W v →
      (∀ j, j ≠ 0 → j ≠ sZ → j ≠ Z → c j = []) →
      IRuns I tbl body (encK s0 (RF v c)) (encK s0 (regOut (RF v c) cs pre post n' K1 K2)) cB)
    (hdn : ∀ s0 F, (∀ i, F (ρS i) = []) → F Cm = [] →
      Sp dn (encK s0 (regOut F cs pre post n' K1 K2)) (encK s0 F) cD)
    (C : ℝ) (hCu : ((frameC W d sv p + cB : ℕ) : ℝ) ≤ C) (hCd : (cD : ℝ) ≤ C) :
    SetupS I tbl (upF dA Z Z1 Cm body) dn.code ρS dA (dsc k pre post sv t p α d)
      (slabV cs pre post n' K1 K2) C := by
  intro s F hF hρ hdA
  obtain ⟨⟨l1, l2, l3, l4⟩, ⟨n1, n2, n3, n4, n5, n6⟩, ⟨r1, r2, r3⟩, ⟨z1, z2, z3⟩, hout,
    ⟨a1, a2, a3⟩⟩ := hP
  have oC := hout Cm (by simp)
  have hFC : F Cm = [] := hF Cm oC.1 oC.2.1 (Ne.symm n3) oC.2.2
  set c := c0 F dA Z (dsc k pre post sv t p α d) with hc
  have hcρ : ∀ i, c (ρS i) = [] := fun i => by
    rw [hc, c0, update_of_ne ((hout Z (by simp)).2.2 i), update_of_ne (a3 i), hρ i]
  have hcn : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ Z → c j = [] := by
    intro j h0 hs hZj
    rw [hc, c0, update_of_ne hZj]
    by_cases hjd : j = dA
    · subst hjd; simp
    rw [update_of_ne hjd]
    by_cases hj : ∃ i, ρS i = j
    · obtain ⟨i, rfl⟩ := hj; exact hρ i
    · push_neg at hj; exact hF j h0 hs hjd hj
  have hB' : ∀ v, ParV 0 0 0 0 pre post sv t p α d v → BV W v →
      IRuns I tbl body (encK s (RF v c)) (encK s (RF v (extend ρS (slabV cs pre post n' K1 K2) c)))
        cB := by
    intro v hv hb
    have H := hbody s v c hv hb hcn
    rw [regOut_RF v c cs pre post n' K1 K2 hcρ] at H
    exact H
  refine ⟨⟨_, upF_runs (m := 7) (ρ := ρS) ⟨⟨l1, l2, l3, l4⟩, ⟨n1, n2, n3, n4, n5, n6⟩,
      ⟨r1, r2, r3⟩, ⟨z1, z2, z3⟩, hout, ⟨a1, a2, a3⟩⟩ s F hF hdA hW hW3
      (slabV cs pre post n' K1 K2) hB', le_trans (le_of_eq ?_) hCu⟩, ?_⟩
  · simp only [frameC]; push_cast; ring
  · have e := regOut_ext F cs pre post n' K1 K2 hρ
    rw [← e]
    exact ⟨_, (hdn s F hρ hFC).toIRuns, hCd⟩

end J6Seg.Src

end

theorem solution : type_of% @J6Seg.Src.setup_of_sol_aux := @J6Seg.Src.setup_of_sol_aux
