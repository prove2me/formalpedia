  have hW := sgm_ok dSA dA (by decide) (by decide) hdA
  set σ := sgm dSA dA with hσ
  set E := 0 + 0 + 0 + 0 + (nU + 1) with hE
  set idx := idxL 0 nU with hidxd
  set body : IStmt HS (7 + E) := swp σ dSA dA (idx eX) with hbody
  set ext := extL ext0 U body with hext
  have hidx : ∀ i, IL.kTableP tab ext (idx i) = U E idx i := extL_idx tab ext0 U body
  have hbd : IL.kTableP tab ext (gO4 0 0 0 0 (nU + 1) (Fin.last nU)) = body :=
    extL_body tab ext0 U body
  refine ⟨E, ext, gO4 0 0 0 0 (nU + 1) (Fin.last nU), dSA, CX + 10 ^ 12, AX,
    max nX (max nG (max nQ nN)), by decide, by decide, by positivity, ?_⟩
  intro n hn src hsrc D hD _ _ Isym s f l hf hdesc zs h0 hlen hGB
  have hnX : nX ≤ n := by omega
  have hnG : nG ≤ n := by omega
  have hnQ : nQ ≤ n := by omega
  have hnN : nN ≤ n := by omega
  set Q : List GI → Prop := fun L =>
    L.length = (List.ofFn (tD6 P n D)).prod ∧ GB (pP6 P n + 2) L with hQd
  have hQ : ∀ L, Q L → L.length = TW P n D ∧ GB (pP6 P n + 2) L := fun L h => h
  have hpipe : ∀ k ≤ D, ∀ L : List GI, Q L → Q (pipeA6 P n src D k L) := by
    intro k hk L h
    obtain ⟨e1, e2⟩ := HG n hnG src hsrc D hD k hk L h.1 h.2
    exact ⟨e1.trans h.1, e2⟩
  have hXb : AxisBodyF P n src D (pipeA6 P n src D) Isym (IL.kTableP tab ext) (idx eX) dA
      (CX * cU6 P n AX / (D + 1)) := HX n hnX src hsrc D hD E ext idx hidx Isym
  have hQk := hq n hnQ src hsrc
  have hb := swB_of P n src hQk D hD
  have hCx0 : 0 ≤ CX * cU6 P n AX / (D + 1) := by
    have := le_trans (by positivity) (T_le_cU6 P hP n AX)
    positivity
  obtain ⟨c, hc, hcost⟩ := sweep_runF hW hXb hCx0 hD (bSw P n) hb Q hQ hpipe s f l hf hdesc
    zs h0 ⟨hlen, hGB⟩
  have hc2 : IRuns Isym (IL.kTableP tab ext) (.call (gO4 0 0 0 0 (nU + 1) (Fin.last nU)))
      (encK s f) (encK s (Function.update f 0
        (gflat (pipeSweep (pipeA6 P n src D) (D + 1) zs) ++ l))) (c + 2) :=
    IRuns.call (by rw [hbd]; exact hc)
  have hax : ∀ i < D + 1, 0 < src i ∧ src i ≤ tF6 P n i := by
    intro i hi
