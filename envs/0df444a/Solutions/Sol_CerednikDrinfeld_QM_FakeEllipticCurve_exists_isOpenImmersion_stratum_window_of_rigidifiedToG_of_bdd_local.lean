  show 𝟙 _ ≫ ρ.φ ≫ ρ.Ab.act (zΛ hΛℤ (r ^ i)) = (ρ.φ ≫ ρ.Ab.act (zΛ hΛℤ (r ^ i))) ≫ 𝟙 _ ≫ ρ.Ab.act (zΛ hΛℤ (r ^ 0))
  rw [pow_zero, act_zΛ_one, Category.id_comp, Category.id_comp, Category.comp_id]

