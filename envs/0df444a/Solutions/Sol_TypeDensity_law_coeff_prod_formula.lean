      rw [List.ofFn_succ, TypeDensity.lawProd, List.foldr_cons, ← TypeDensity.lawProd, TypeDensity.law_coeff_mul, TypeDensity.sum_piFinset_succ]
      refine Finset.sum_congr rfl fun τ₀ _ ↦ ?_
      rw [ih (fun i ↦ Dl i.succ)]
