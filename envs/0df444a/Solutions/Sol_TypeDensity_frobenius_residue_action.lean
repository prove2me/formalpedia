theorem solution (O : Type) [CommRing O] [IsLocalRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) :
    (∀ x : AdjoinRoot Φ,
      TypeDensity.baseReduce O Φ (TypeDensity.unramifiedFrobenius O Φ x) = (TypeDensity.baseReduce O Φ x) ^ TypeDensity.residueCard O) ∧
    (∀ (i : ℕ) (x : AdjoinRoot Φ),
      TypeDensity.baseReduce O Φ (TypeDensity.frobeniusIter O Φ i x) = (TypeDensity.baseReduce O Φ x) ^ (TypeDensity.residueCard O ^ i)) := by
  obtain ⟨-, hcong, hroot, -⟩ := TypeDensity.frobenius_root_spec O Φ hΦ
  have hle : IsLocalRing.maximalIdeal O ≤
      RingHom.ker ((TypeDensity.baseReduce O Φ).comp (AdjoinRoot.of Φ)) := fun c hc => by
    rw [RingHom.mem_ker, RingHom.comp_apply, TypeDensity.baseReduce, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_map_of_mem _ hc
  let ρ : IsLocalRing.ResidueField O →+* TypeDensity.residueExtension O Φ :=
    Ideal.Quotient.lift _ ((TypeDensity.baseReduce O Φ).comp (AdjoinRoot.of Φ)) hle
  have hρ : ρ.comp (IsLocalRing.residue O) = (TypeDensity.baseReduce O Φ).comp (AdjoinRoot.of Φ) := by
    ext c; rfl
  have key : ∀ (p : Polynomial O) (a : AdjoinRoot Φ),
      TypeDensity.baseReduce O Φ (Polynomial.aeval a p) =
        (p.map (IsLocalRing.residue O)).eval₂ ρ (TypeDensity.baseReduce O Φ a) := fun p a => by
    rw [Polynomial.eval₂_map, hρ, Polynomial.aeval_def, Polynomial.hom_eval₂]
    rfl
  have h1 : ∀ x : AdjoinRoot Φ, TypeDensity.baseReduce O Φ (TypeDensity.unramifiedFrobenius O Φ x) =
      (TypeDensity.baseReduce O Φ x) ^ TypeDensity.residueCard O := by
    intro x
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hroot, key, key]
    have : TypeDensity.baseReduce O Φ (TypeDensity.frobeniusRoot O Φ) =
        (TypeDensity.baseReduce O Φ (AdjoinRoot.root Φ)) ^ TypeDensity.residueCard O := by
      rw [← map_pow, TypeDensity.baseReduce, Ideal.Quotient.eq]; exact hcong
    rw [this]
    exact TypeDensity.eval_at_pow_card _ _ ρ _ _
  refine ⟨h1, fun i => ?_⟩
  induction i with
  | zero => intro x; simp [TypeDensity.frobeniusIter]
  | succ i ih =>
    intro x
    change TypeDensity.baseReduce O Φ (TypeDensity.unramifiedFrobenius O Φ (TypeDensity.frobeniusIter O Φ i x)) = _
    rw [h1, ih, ← pow_mul, pow_succ]
