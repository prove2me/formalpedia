theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] [TopologicalSpace O] [IsTopologicalRing O]
    [CompactSpace O] [T2Space O] [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (n : ℕ) (σ : TypeDensity.FactorType) :
    TypeDensity.clusterDensity O n σ =
      TypeDensity.densityValue (TypeDensity.clusterExpr n σ) (Nat.card (IsLocalRing.ResidueField O)) := by
  have hprob := TypeDensity.coefficient_measure_probability O htop n
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have hC : TypeDensity.clusterCell O 0 = Set.univ := Set.eq_univ_of_forall fun _ i => i.elim0
    have hE : {a : Fin 0 → O | HasPolynomialType O (TypeDensity.monicPolynomial O a) σ} =
        if σ = 0 then Set.univ else ∅ := by
      ext a
      have h1 : TypeDensity.monicPolynomial O a = 1 := by simp [TypeDensity.monicPolynomial]
      rw [Set.mem_ofPred_eq, h1, TypeDensity.hasPolynomialType_one_iff]
      split_ifs with h <;> simp [h]
    rw [TypeDensity.clusterDensity, hC, hE, TypeDensity.clusterExpr, TypeDensity.rootLaw, if_pos rfl]
    by_cases hσ : σ = 0
    · subst hσ
      simp [TypeDensity.lawCoeff, TypeDensity.lawOne, TypeDensity.Expr.sum, TypeDensity.densityValue, TypeDensity.Expr.eval]
    · rw [if_neg hσ]
      simp [TypeDensity.lawCoeff, TypeDensity.lawOne, TypeDensity.Expr.sum, TypeDensity.densityValue, TypeDensity.Expr.eval, Ne.symm hσ]
  · obtain ⟨pi, hpi⟩ := IsDiscreteValuationRing.exists_irreducible O
    obtain ⟨hR1, hR2⟩ := TypeDensity.root_cell_law O htop pi hpi n hn σ
    obtain ⟨-, hU2⟩ := TypeDensity.scaling_image_borel_mass O htop pi hpi n Set.univ MeasurableSet.univ
    obtain ⟨-, hT2⟩ := TypeDensity.scaling_image_borel_mass O htop pi hpi n _ hR1
    have hae : (TypeDensity.clusterCell O n ∩ {a | HasPolynomialType O (TypeDensity.monicPolynomial O a) σ} :
        Set (Fin n → O)) =ᵐ[TypeDensity.coefficientMeasure O n]
        (TypeDensity.clusterCell O n ∩ {a | HasPolynomialTypeF O (TypeDensity.monicPolynomial O a) σ} :
          Set (Fin n → O)) :=
      (measure_eq_zero_iff_ae_notMem.1 (TypeDensity.monic_inseparable_null O htop n)).mono fun _ ha =>
        propext <| and_congr_right fun _ =>
          (TypeDensity.hasPolynomialTypeF_iff_of_separable O (not_not.1 ha)).symm
    have hc0 : (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ^ n ≠ 0 :=
      pow_ne_zero _ (ENNReal.inv_ne_zero.2 (ENNReal.natCast_ne_top _))
    have hct : (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ^ n ≠ ⊤ :=
      ENNReal.pow_ne_top (ENNReal.inv_ne_top.2 (by exact_mod_cast Nat.card_pos.ne'))
    rw [TypeDensity.clusterDensity, measure_congr hae, TypeDensity.clusterCell_inter_eq_image O pi hpi n σ, hT2,
      TypeDensity.clusterCell_eq_image O pi hpi n, hU2, measure_univ, ENNReal.mul_div_mul_left _ _ hc0 hct,
      div_one, hR2, TypeDensity.clusterExpr, TypeDensity.rootLaw, if_neg hn.ne']
