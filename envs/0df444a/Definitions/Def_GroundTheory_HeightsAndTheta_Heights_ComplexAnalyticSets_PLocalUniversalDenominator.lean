namespace LocalUniversalDenominator
def divCoeff (P : Polynomial ℂ) (K j : ℕ) (τ : ℂ) : ℂ :=
  ∑ i ∈ Finset.range (K + 1), if j < i then P.coeff i * τ ^ (i - 1 - j) else 0
