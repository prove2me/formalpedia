    ∃ p t₀, Eval [inp] (prepProg univ) p t₀ ∧
      ((p = .nil ∧ out = .nil) ∨
        ∃ st₀ st₁, p = .cons st₀ st₁ ∧ ∃ t₁, Eval [Data.cons st₀ st₁] (.loop (coordBody univ)) out t₁) := by
  change Eval [inp] (.let_ (prepProg univ) _) out t at h
