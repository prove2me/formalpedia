open MeasureTheory
open scoped ENNReal NNReal





variable {alpha : Type*} [PseudoMetricSpace alpha]

















variable [MeasurableSpace alpha] [BorelSpace alpha]

namespace MarkovProcess.ContinuousPath

end MarkovProcess.ContinuousPath
open MarkovProcess.ContinuousPath
theorem solution (U : Set alpha) (hU : IsOpen U) (t : NNReal) :
    Measurable fun omega : ContinuousPath alpha ↦
      LifetimePath.coordinate t (killAtExit U omega) := by
  intro S hS
  have hC : MeasurableSet (Subtype.val '' (Cemetery.alive ⁻¹' S)) :=
    (MeasurableEmbedding.subtype_coe hU.measurableSet).measurableSet_image.mpr
      (measurable_inl hS)
  have hlive : MeasurableSet {omega : ContinuousPath alpha |
      (t : ℝ≥0∞) < exitTime U omega ∧ omega t ∈ Subtype.val '' (Cemetery.alive ⁻¹' S)} :=
    (measurableSet_lt_exitTime U hU t).inter
      ((measurable_coordinateProcess (alpha := alpha) t) hC)
  by_cases hdelta : (Cemetery.delta : Cemetery U) ∈ S
  · rw [preimage_coordinate_killAtExit_of_mem U t hdelta]
    refine hlive.union ?_
    have hcompl : {omega : ContinuousPath alpha | ¬ (t : ℝ≥0∞) < exitTime U omega} =
        {omega : ContinuousPath alpha | (t : ℝ≥0∞) < exitTime U omega}ᶜ := rfl
    rw [hcompl]
    exact (measurableSet_lt_exitTime U hU t).compl
  · rw [preimage_coordinate_killAtExit_of_notMem U t hdelta]
    exact hlive
