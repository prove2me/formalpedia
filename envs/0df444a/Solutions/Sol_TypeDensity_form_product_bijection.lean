theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] (ι : Type) [Fintype ι] (d : ι → ℕ)
    (ν : ∀ i, Fin (d i + 1)) (g : ∀ i, Fin (d i + 1) → IsLocalRing.ResidueField O)
    (hgν : ∀ i, g i (ν i) = 1) (hc : TypeDensity.FormsCoprime d g) (μ : Fin ((∑ i, d i) + 1))
    (hμ : TypeDensity.formProd d g μ = 1) :
    Set.BijOn (TypeDensity.reducedFormProduct O d ν g μ)
      (Set.pi Set.univ (fun i => TypeDensity.reducedFormCell O (d i) (ν i) (g i)))
      (TypeDensity.reducedFormCell O (∑ i, d i) μ (TypeDensity.formProd d g)) := by
  set m := IsLocalRing.maximalIdeal O
  set S := Set.pi Set.univ (fun i => TypeDensity.reducedFormCell O (d i) (ν i) (g i))
  refine ⟨?_, ?_, ?_⟩
  · exact fun a ha => (TypeDensity.form_product_maps_to_and_preserves O ι d ν g μ hμ a a ha ha).1
  · intro a ha a' ha' h
    funext i j
    rw [← sub_eq_zero]
    apply TypeDensity.eq_zero_of_forall_mem_pow O
    intro L
    refine TypeDensity.form_product_congruence_reflects O ι d ν g hgν hc μ hμ a a' ha ha' L ?_ i j
    intro j; simp [h]
  · intro c hc'
    have hcell := fun i => TypeDensity.reducedFormCell_iff O (d i) (ν i) (g i) (hgν i)
    have hGcell := TypeDensity.reducedFormCell_iff O (∑ i, d i) μ (TypeDensity.formProd d g) hμ
    -- base point
    have a₁ : ∃ a, a ∈ S := by
      refine ⟨fun i j => (IsLocalRing.residue_surjective (g i ((ν i).succAbove j))).choose, ?_⟩
      intro i _
      rw [hcell]
      intro j
      exact (IsLocalRing.residue_surjective _).choose_spec
    obtain ⟨a₁, ha₁⟩ := a₁
    let P : ℕ → (∀ i, Fin (d i) → O) → Prop := fun t a =>
      a ∈ S ∧ ∀ j, TypeDensity.reducedFormProduct O d ν g μ a j - c j ∈ m ^ (t + 1)
    have hP0 : P 0 a₁ := by
      refine ⟨ha₁, fun j => ?_⟩
      rw [zero_add, pow_one, TypeDensity.sub_mem_maximalIdeal_iff]
      have h1 := (hGcell _).1
        (TypeDensity.form_product_maps_to_and_preserves O ι d ν g μ hμ a₁ a₁ ha₁ ha₁).1 j
      rw [h1, (hGcell c).1 hc' j]
    have step : ∀ t a, P t a → ∃ a', P (t+1) a' ∧ ∀ i j, a' i j - a i j ∈ m ^ (t + 1) := by
      intro t a ha
      obtain ⟨a', ha', h1, h2⟩ := TypeDensity.form_product_digit_lift O ι d ν g hgν hc μ hμ a ha.1 c hc'
        (t+1) (by omega) ha.2
      exact ⟨a', ⟨ha', h2⟩, h1⟩
    let f : (t : ℕ) → {a // P t a} := fun t => Nat.rec (motive := fun t => {a // P t a})
      ⟨a₁, hP0⟩ (fun t x => ⟨(step t x.1 x.2).choose, (step t x.1 x.2).choose_spec.1⟩) t
    have hf : ∀ t i j, (f (t+1)).1 i j - (f t).1 i j ∈ m ^ (t + 1) := fun t =>
      (step t (f t).1 (f t).2).choose_spec.2
    have hcompat : ∀ s t, s ≤ t → ∀ i j, (f s).1 i j - (f t).1 i j ∈ m ^ (s + 1) := by
      intro s t hst i j
      induction t, hst using Nat.le_induction with
      | base => simp
      | succ t hst ih =>
        simpa only [sub_sub_sub_cancel_right] using
          sub_mem ih (Ideal.pow_le_pow_right (I := m) (by omega : s + 1 ≤ t + 1) (hf t i j))
    have hlim : ∀ i j, ∃ ℓ : O, ∀ n, (f n).1 i j - ℓ ∈ m ^ n := by
      intro i j
      obtain ⟨ℓ, hℓ⟩ := IsPrecomplete.prec (I := m) (IsAdicComplete.toIsPrecomplete)
        (f := fun n => (f n).1 i j) (by
          intro s t hst
          rw [SModEq.sub_mem]
          simpa [smul_eq_mul, Ideal.mul_top] using
            Ideal.pow_le_pow_right (I := m) (by omega : s ≤ s + 1) (hcompat s t hst i j))
      refine ⟨ℓ, fun n => ?_⟩
      have := hℓ n
      rw [SModEq.sub_mem] at this
      simpa [smul_eq_mul, Ideal.mul_top] using this
    choose ℓ hℓ using hlim
    have haS : ℓ ∈ S := by
      intro i _
      rw [hcell]
      intro j
      have h0' : (f 0).1 i j - ℓ i j ∈ m := by
        rw [← sub_add_sub_cancel _ ((f 1).1 i j)]
        exact add_mem (by simpa using hcompat 0 1 (by omega) i j) (by simpa using hℓ i j 1)
      rw [TypeDensity.sub_mem_maximalIdeal_iff] at h0'
      rw [← h0']
      exact (hcell i _).1 ((f 0).2.1 i (Set.mem_univ _)) j
    refine ⟨ℓ, haS, ?_⟩
    funext j
    rw [← sub_eq_zero]
    apply TypeDensity.eq_zero_of_forall_mem_pow O
    intro t
    have h1 := (TypeDensity.form_product_maps_to_and_preserves O ι d ν g μ hμ ℓ (f t).1 haS
      (f t).2.1).2.2.2 t (fun i j => by
        have := hℓ i j t
        rw [← neg_sub]; exact neg_mem this) j
    have h2 := Ideal.pow_le_pow_right (I := m) (by omega : t ≤ t + 1) ((f t).2.2 j)
    simpa only [sub_add_sub_cancel] using add_mem h1 h2
