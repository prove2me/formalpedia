theorem Eapprox_congr (p s t α : ℕ) (hs : 0 < s) (U U' : ℕ → ℤ × ℤ) (h : ∀ j < s, U j = U' j)
    (l : ℕ) : HvdH.Eapprox p s t α U l = HvdH.Eapprox p s t α U' l := by
  have key : ∀ h' : ℤ, ((l + h') % (s : ℤ)).toNat < s := by
    intro h'
    have h1 := Int.emod_nonneg (l + h') (by omega : (s : ℤ) ≠ 0)
    have h2 := Int.emod_lt_of_pos (l + h') (by omega : (0 : ℤ) < s)
    omega
  unfold HvdH.Eapprox HvdH.eTerm
  simp only [h _ (key _)]

end NLogN.Rsp

