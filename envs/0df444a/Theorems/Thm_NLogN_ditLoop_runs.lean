variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.ditLoop_runs (s : IState NS) (n E : ℕ) (lo hi : List ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (hlen : lo.length = hi.length)
    (hE : lo.length * E = n) (hcz : zsz (lo.length : ℤ) ≤ n)
    (hlo : Canon (2 ^ n + 1) lo) (hhi : Canon (2 ^ n + 1) hi)
    (hV : s.G NLogN.V = ints lo ++ RV) (hX : s.G DX = ints hi ++ RX) (hW : s.G W = .int (2 ^ n) :: LW)
    (hC : s.G CC = .int lo.length :: LC) (hDE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) ditStep) s
      (((((((s.upd NLogN.V RV).upd DX RX).upd NLogN.P1
        ((ints (dcomX (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G NLogN.P1)).upd P2
        ((ints (dcomY (2 ^ n + 1) n E 0 lo hi)).reverse ++ s.G P2)).upd W
          (.int 1 :: LW)).upd CC (.int 0 :: LC)))
      (lo.length * (150000 * (n + 3) + 30) + 30) := by sorry
