-- title:
--   Lemma 2, (16), p. 419 — E[‖ȳ_k − h(x_k)‖² | F_k] ≤ σ²/n
-- statement:
--   Assume Assumptions 1–4, let $x^*$ minimize $f$, and run DSGT (4) with a constant stepsize $\alpha>0$ from a deterministic $\mathbf x_0$. Let $\mathcal F_k$ be the σ-algebra generated by $\boldsymbol\xi_0,\dots,\boldsymbol\xi_{k-1}$ and $h(\mathbf x)=\frac1n\sum_i\nabla f_i(x_i)$. Then for every $k\ge0$ the random variable $\|\bar y_k-h(\mathbf x_k)\|^2$ is integrable and, almost surely,
--   $$\mathbb E\big[\|\bar y_k-h(\mathbf x_k)\|^2\mid\mathcal F_k\big]\le\frac{\sigma^2}{n}.$$
--
--   Through (6), $\bar y_k-h(\mathbf x_k)$ is the average of $n$ independent zero-mean gradient errors, so its conditional variance shrinks like $1/n$; this is the source of the $1/n$ in the first term of Theorem 1's bound (8).
--
--   **Formalization Note.** The page says "under Assumption 1"; the iterates are defined through the recursion (4) and so depend on $\mathbf W$, and the full model (Assumptions 1–4) is assumed. Integrability is part of the conclusion so that the conditional expectation is not Lean's default value $0$.
-- source:
--   Pu & Nedić, Math. Program. 187 (2021), §3, Lemma 2 with (16), p. 419

import Mathlib
import Definitions.Def_StochGradTrack_Const_Model

namespace StochGradTrack.Const

open MeasureTheory ProbabilityTheory Matrix

theorem lemma_2 {n p m : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (f : Fin n → E p → ℝ) (gradf : Fin n → E p → E p) (μ L : ℝ)
    (g : Fin n → E p → E m → E p) (ξ : ℕ → Fin n → Ω → E m) (σ : ℝ)
    (W : Matrix (Fin n) (Fin n) ℝ) (xstar : E p) (x0 : Stack n p)
    (hM : Model P f gradf μ L g ξ σ W xstar) (α : ℝ) (hα : 0 < α) :
    ∀ k, Integrable (fun ω => ‖avg (ys (fun _ => α) W g ξ x0 k ω) - hAvg gradf (xs (fun _ => α) W g ξ x0 k ω)‖ ^ 2) P ∧
      P[fun ω => ‖avg (ys (fun _ => α) W g ξ x0 k ω) - hAvg gradf (xs (fun _ => α) W g ξ x0 k ω)‖ ^ 2 | noiseSigma ξ k]
        ≤ᵐ[P] fun _ => σ ^ 2 / n := by sorry

end StochGradTrack.Const
