    intro a b
    have m2 := emod2_01 a
    have h1 := Int.emod_nonneg b hR.ne'
    have h2 := Int.emod_lt_of_pos b hR
    unfold tfA
    rcases m2 with h | h <;> rw [h] <;> simp [abs_of_nonneg h1] <;> linarith

