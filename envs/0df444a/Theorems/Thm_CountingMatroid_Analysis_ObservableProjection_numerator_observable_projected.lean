    (o₁ o₂ : IndependenceOracle n) (ρ : ℚ) (π : FinDist (PairedSet n)) :
    observableProjection π (numeratorObservable r o₁ o₂ ρ) =
      numeratorObservable r o₁ o₂ ρ := by sorry
