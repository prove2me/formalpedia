    FSp (p3B B) (encK s (P3 κ γ recs M A G0 (k + 1))) (encK s (P3 κ γ recs M A G0 k)) (cP3 B Bb) := by
  set G := P3 κ γ recs M A G0 (k + 1) with hG
  have gF : G sFL = flagV κ k :: (flL κ k ++ G0 sFL) := by
    simp +decide [G, P3, Function.update_apply, flL_succ]
