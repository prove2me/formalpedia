-- title:
--   $S$ and $T$ generate $SL(2,\mathbb Z)$
-- statement:
--   Let $S=\begin{pmatrix}0&-1\\1&0\end{pmatrix}$ and $T=\begin{pmatrix}1&1\\0&1\end{pmatrix}$. Then the subgroup of $SL(2,\mathbb Z)$ generated by $S$ and $T$ is all of $SL(2,\mathbb Z)$:
--
--   $$
--   \langle S,T\rangle=SL(2,\mathbb Z).
--   $$
--
--   This is the statement that every modular transformation (6.19) "is constructed from combinations of $S$ and $T$", which reduces modular invariance to invariance under $S$ and $T$.
-- source:
--   D. Tong, *String Theory*, University of Cambridge Part III Mathematical Tripos lecture notes (January 2009), http://www.damtp.cam.ac.uk/user/tong/string.html, Section 6.4.1, p. 146 ('A general modular transformation is constructed from combinations of S and T ...', eq. (6.19))

import Mathlib
import Definitions.Def_TongString_modular_action

namespace TongString

theorem SL2Z_closure_S_T : Subgroup.closure {modularS, modularT} = ⊤ := by sorry

end TongString
