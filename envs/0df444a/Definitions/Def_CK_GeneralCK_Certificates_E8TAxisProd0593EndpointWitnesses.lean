    centerALowerYBox.Contains (Y (lower E8TAxisProd0593PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0593PaddedInputs.centerAInput.alpha = ((2374304945389442440708671056104672722900422278 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
