-- ===== S4.Def_RP_EtPBC_A_O2Pb =====
section

/-!
# S4-EtPBC-A, O2 GLOB (O2Pb): the pullback square of `wm (prdMap d X)` and what it gives on global sections

GLOB/REL PLAN v1 (2). For `d : D₁ ⟶ D` and `X R : P.Etale`, `W := (D ×_P X) ×_P R`, `W₁ := (D₁ ×_P X) ×_P R`:
* `isPullback_wm`, `isPullback_prdMap`, **`isPullback_wD`**: `W₁ = D₁ ×_D W` (through `wm (prdMap d X)`, `wD`);
* `mem_closure_of_isPushout`, `mem_adjoin_of_isPushout`: in a pushout of rings the two legs generate;
* **`appTop_mem_closure`** (Gen): `Γ(W₁)` is generated by the images of `Γ(W)` and `Γ(D₁)` (all affine);
* `isPushout_bW`: for `D = Spec B`, `D₁ = Spec B'`, `d.left = Spec.map ι`, the square `bW, ι, wm^*, bW'` is a
  pushout of rings;
* **`isLocalization_away_wm`** (Zar): for `B' = B_f`, `Γ(W) → Γ(W₁)` is `IsLocalization.Away (bW f)`;
  `comap_injective_wm`: so `Ideal.comap` along it is injective.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtPBC.EtMV RamanujanPetersson.EtPBC.EtShap RamanujanPetersson.EtPBC.GenGeo

universe u

section Ring

/-- In a pushout of commutative rings, the images of the two legs generate the ring. -/
theorem mem_closure_of_isPushout {Z X Y Q : CommRingCat.{u}} {f : Z ⟶ X} {g : Z ⟶ Y} {inl : X ⟶ Q}
    {inr : Y ⟶ Q} (h : IsPushout f g inl inr) (x : Q) :
    x ∈ Subring.closure (Set.range inl.hom ∪ Set.range inr.hom) := by
  set S := Subring.closure (Set.range inl.hom ∪ Set.range inr.hom)
  let iS : CommRingCat.of S ⟶ Q := CommRingCat.ofHom S.subtype
  let l' : X ⟶ CommRingCat.of S := CommRingCat.ofHom (inl.hom.codRestrict S fun y =>
    Subring.subset_closure (Or.inl ⟨y, rfl⟩))
  let r' : Y ⟶ CommRingCat.of S := CommRingCat.ofHom (inr.hom.codRestrict S fun y =>
    Subring.subset_closure (Or.inr ⟨y, rfl⟩))
  have w : f ≫ l' = g ≫ r' := by
    ext z; exact congrArg (fun t => t.hom z) h.w
  have he : h.desc l' r' w ≫ iS = 𝟙 Q := h.hom_ext
    (by rw [h.inl_desc_assoc, Category.comp_id]; ext y; rfl)
    (by rw [h.inr_desc_assoc, Category.comp_id]; ext y; rfl)
  have hx : iS.hom ((h.desc l' r' w).hom x) = x := congrArg (fun t => t.hom x) he
  rw [← hx]; exact ((h.desc l' r' w).hom x).2

end Ring

section Pb

end Pb

end RamanujanPetersson.EtPBC.EtKum

end

