section Ret

variable {Λ : Type u} [CommRing Λ] {X : Scheme.{u}} {F E : EtSh Λ X}
  (a : F ⟶ E) (b : E ⟶ unitSh Λ X) (hab : a ≫ b = 0) (hS : (ShortComplex.mk a b hab).ShortExact)
  {T : X.Etale} (σ : E.obj.obj (op T))
  (hσ : (b.hom.app (op T)).hom σ = (constUnit (ModuleCat.of Λ Λ) T).hom 1)

/-- A map of sheaves restricted to `Over T`. -/
abbrev wh {G H : EtSh Λ X} (φ : G ⟶ H) (T : X.Etale) : HomOver G H T :=
  Functor.whiskerLeft (Over.forget T).op φ.hom

/-- The section `Λ|_T ⟶ E|_T`, `1 ↦ σ`. -/
def secT : HomOver (unitSh Λ X) E T :=
  (homConstEquiv (ModuleCat.of Λ Λ) E T).symm (ModuleCat.ofHom (LinearMap.toSpanSingleton Λ _ σ))

