variable {K : Type} [Field K] {ν r0 r1 : ℕ}

theorem Formalism.InvariantFactorPaths.G7.EDec.subst_sT [NeZero ν] (TT : Finset (ZMod (2 * ν))) (ξ : ZMod (2 * ν) → Fin r0 → K) (p E : ℕ)
    (s : ZMod (2 * ν)) (ab : Fin r0 × Fin r1) :
    MvPowerSeries.subst (zSub TT ξ) (sT (K := K) p E s ab) =
      ∑ l ∈ range E, (-1) ^ l * (zlS (s - 2 * (l : ZMod (2 * ν)), ab) +
        tpS TT ξ (s - 2 * (l : ZMod (2 * ν)), ab)) ^ ((p ^ 2) ^ l) := by sorry
