    (update (update (update (update (update (update (update v2 0 []) 1 []) 2 []) 3 []) 4 [])
      5 []) 6 []) B 8 ((D + 1 : ℕ) : ℤ) [] (by rw [hv2, hv1, hv]; simp [vK, vH, update_apply])
    (zle _ hkB)
