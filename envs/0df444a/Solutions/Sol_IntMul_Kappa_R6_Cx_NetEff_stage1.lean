set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetScal

open NetSpec NetMask Finset

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

lemma runL_cons (o : ℕ × ℕ × ℤ) (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) :
    runL (o :: l) Λ = runL l (stepL Λ o) := rfl
lemma runL_append (a b : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) : runL (a ++ b) Λ = runL b (runL a Λ) := by
  simp [runL, List.foldl_append]

lemma stepL_add (o : ℕ × ℕ × ℤ) (Λ₁ Λ₂ : ℕ → Vt) : stepL (Λ₁ + Λ₂) o = stepL Λ₁ o + stepL Λ₂ o := by
  funext w
  simp only [stepL, Pi.add_apply]
  by_cases h : w = o.1
  · subst h; simp only [Function.update_self, smul_add]; abel
  · simp [Function.update_of_ne h]

lemma runL_add : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ₁ Λ₂ : ℕ → Vt), runL l (Λ₁ + Λ₂) = runL l Λ₁ + runL l Λ₂
  | [], _, _ => rfl
  | o :: l, Λ₁, Λ₂ => by rw [runL_cons, runL_cons, runL_cons, stepL_add, runL_add l]

lemma runL_untouched : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) (w : ℕ), w ∉ dsts l → runL l Λ w = Λ w
  | [], _, _, _ => rfl
  | o :: l, Λ, w, hw => by
    simp only [dsts, List.map_cons, List.mem_cons, not_or] at hw
    rw [runL_cons, runL_untouched l _ w hw.2, stepL, Function.update_of_ne hw.1]

/-- A state vanishing on all wires of `l` is fixed. -/
lemma runL_fix : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt), (∀ o ∈ l, Λ o.1 = 0 ∧ Λ o.2.1 = 0) → runL l Λ = Λ
  | [], _, _ => rfl
  | o :: l, Λ, h => by
    have h0 := h o List.mem_cons_self
    have e : stepL Λ o = Λ := by
      funext w; simp only [stepL]
      by_cases hw : w = o.1
      · subst hw; rw [Function.update_self, h0.1, h0.2, smul_zero, add_zero]
      · rw [Function.update_of_ne hw]
    rw [runL_cons, e]; exact runL_fix l Λ fun o' h' => h o' (List.mem_cons_of_mem _ h')

lemma negOps_cons (o : ℕ × ℕ × ℤ) (l : List (ℕ × ℕ × ℤ)) :
    negOps (o :: l) = negOps l ++ [(o.1, o.2.1, -o.2.2)] := by simp [negOps]

/-- **Inverses.** -/
theorem runL_neg : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt), (∀ o ∈ l, o.1 ≠ o.2.1) →
    runL (negOps l) (runL l Λ) = Λ
  | [], _, _ => rfl
  | o :: l, Λ, h => by
    rw [negOps_cons, runL_append, runL_cons o l, runL_neg l (stepL Λ o) fun o' h' => h o' (List.mem_cons_of_mem _ h')]
    have hne := h o List.mem_cons_self
    funext w
    simp only [runL_cons, runL_nil, stepL, cf]
    by_cases hw : w = o.1
    · subst hw
      rw [Function.update_self, Function.update_self, Function.update_of_ne (Ne.symm hne)]
      push_cast
      rw [neg_div, neg_smul]; abel
    · rw [Function.update_of_ne hw, Function.update_of_ne hw]

/-- **Parallel blocks**: no op reads a wire written by the block. -/
theorem runL_par : ∀ (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt), (∀ o ∈ l, ∀ o' ∈ l, o.1 ≠ o'.2.1) →
    runL l Λ = padd l Λ
  | [], Λ, _ => by funext w; simp [padd]
  | o :: l, Λ, h => by
    rw [runL_cons, runL_par l _ fun a ha b hb => h a (List.mem_cons_of_mem _ ha) b (List.mem_cons_of_mem _ hb)]
    funext w
    simp only [padd, List.map_cons, List.sum_cons]
    have hs : ∀ o' ∈ l, stepL Λ o o'.2.1 = Λ o'.2.1 := fun o' ho' => by
      rw [stepL, Function.update_of_ne (Ne.symm (h o List.mem_cons_self o' (List.mem_cons_of_mem _ ho')))]
    have e : (l.map fun o' => if o'.1 = w then cf o' • stepL Λ o o'.2.1 else 0) =
        (l.map fun o' => if o'.1 = w then cf o' • Λ o'.2.1 else 0) :=
      List.map_congr_left fun o' ho' => by rw [hs o' ho']
    rw [e]
    by_cases hw : o.1 = w
    · subst hw; rw [stepL, Function.update_self, if_pos rfl, add_assoc]
    · rw [stepL, Function.update_of_ne (Ne.symm hw), if_neg hw, zero_add]

