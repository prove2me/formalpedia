section ArchHeight

variable (F : Type) [Field F] [NumberField F]

private theorem archHeight_unipotent_mul {n : GL (Fin 2) (InfiniteAdeleRing F)}
    (g : GL (Fin 2) (InfiniteAdeleRing F))
    (h0 : (n : Matrix (Fin 2) (Fin 2) (InfiniteAdeleRing F)) 1 0 = 0)
    (h1 : (n : Matrix (Fin 2) (Fin 2) (InfiniteAdeleRing F)) 1 1 = 1)
    (h2 : (n : Matrix (Fin 2) (Fin 2) (InfiniteAdeleRing F)) 0 0 = 1) :
    archHeight F (n * g) = archHeight F g := by
  unfold archHeight
  refine Finset.prod_congr rfl fun v _ => ?_
  rw [map_mul]
  congr 1
  refine localHeight_unipotent_mul (archComponent F v g) ?_ ?_ ?_
  · rw [archComponent_apply, h0]
    rfl
  · rw [archComponent_apply, h1]
    rfl
  · rw [archComponent_apply, h2]
    rfl

private def adelicArchHeight (g : AdelicGL2 (𝓞 F) F) : ℝ :=
  archHeight F (glArch (𝓞 F) F g)

@[scoped simp] private theorem adelicArchHeight_one : adelicArchHeight F 1 = 1 := by
  unfold adelicArchHeight
  rw [map_one]
  exact archHeight_one F

private theorem adelicArchHeight_unipotentGL2_mul (x : AdeleRing (𝓞 F) F) (g : AdelicGL2 (𝓞 F) F) :
    adelicArchHeight F (unipotentGL2 x * g) = adelicArchHeight F g := by
  unfold adelicArchHeight
  rw [map_mul]
  refine archHeight_unipotent_mul F (glArch (𝓞 F) F g) ?_ ?_ ?_
  · rw [glArch_apply, unipotentGL2_coe]
    rfl
  · rw [glArch_apply, unipotentGL2_coe]
    rfl
  · rw [glArch_apply, unipotentGL2_coe]
    rfl

end ArchHeight
