-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

section outer
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

/-- **The forward rows.** -/
theorem Rn.fLoop_sol_aux {v : Vr} {D : Cs} (hF : Fx Q kk m mw cB v) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W v) {t : ℕ} (h23 : v 23 = t)
    (hD50 : D 50 = []) (hD51 : D 51 = [])
    (ht : t + ((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).length ≤ 2 ^ W)
    (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) :
    Rn (PJ.forL 50 28 1 fBody) v D (fun v' =>
      v' 23 = ((t + ((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).length
        : ℕ) : ℤ) ∧
      (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 23, 29] : List (Fin HS)), v' i = v i) ∧ BV W v')
      (update D 41 (((List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))).reverse
        ++ D 41))
      (cFor W m (cfB W m)) := by
  set rowL : ℕ → List ℤ := fun k => (List.range k).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))
    with hrowL
  have hrs : ∀ k, rowL (k + 1) = rowL k ++ rowP Q m mw cB L Mf (m - 1 - k) := fun k => by
    simp only [hrowL, List.range_succ, List.flatMap_append, List.flatMap_cons, List.flatMap_nil,
      List.append_nil]
  have hmono0 : ∀ k d, (rowL k).length ≤ (rowL (k + d)).length := by
    intro k d
    induction d with
    | zero => exact le_rfl
    | succ d ih => rw [← Nat.add_assoc, hrs, List.length_append]; omega
  have hmono : ∀ k ≤ m, (rowL k).length ≤ (rowL m).length := fun k hk => by
    have := hmono0 k (m - k); rwa [Nat.add_sub_cancel' hk] at this
  have f28 : v 28 = m := hF.2.2.2.2.2
  have ht' : t + (rowL m).length ≤ 2 ^ W := ht
  set Iv : ℕ → Vr → Prop := fun k w =>
    (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 23, 29] : List (Fin HS)), w i = v i) ∧
      w 23 = ((t + (rowL k).length : ℕ) : ℤ) with hIv
  have hmW : m + 1 ≤ 2 ^ W := by nlinarith
  have H := Rn.forL (C := 50) (rN := 28) (ix := 1) (b := fBody) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m) (W := W) (Iv := Iv)
    (cf := fun k => update D 41 ((rowL k).reverse ++ D 41)) (cb := cfB W m)
    (fun k => by simp [hD50]) (by omega)
    (fun k hk w ⟨hfw, hw23⟩ hw1 hbw => by
      set c' := update (update D 41 ((rowL k).reverse ++ D 41)) 50 [(m : ℤ) - k]
      have hFw : Fx Q kk m mw cB w := hF.frm hfw (by decide)
      have hS' : StS m L Mf c' := (hS.upd (by decide) _).upd (by decide) _
      have hl := hmono (k + 1) hk
      have H1 := Rn.fBodyS hFw hS' hB hLm hbw hw1 hk hw23 (by simp [c', hD51]) hmW
        (by rw [hrs, List.length_append] at hl; omega)
      have hst : update c' 41 ((rowP Q m mw cB L Mf (m - 1 - k)).reverse ++ c' 41) =
          update (update D 41 ((rowL (k + 1)).reverse ++ D 41)) 50 [(m : ℤ) - k] := by
        have e41 : c' 41 = (rowL k).reverse ++ D 41 := by simp [c']
        rw [e41, hrs, List.reverse_append, List.append_assoc]; simp only [c']
        rw [update_comm (by decide : (50 : Fin HS) ≠ 41), update_idem]
      refine (H1.mono (fun w' hw' => ?_) le_rfl).congr hst
      obtain ⟨g23, gf, gb⟩ := hw'
      refine ⟨⟨frm_upd (frm_trans (C := [1, 2, 3, 4, 5, 6, 7, 8, 23, 29]) hfw gf (by decide)
        (by decide)) (by decide) _, ?_⟩, by rw [gf 1 (by decide), hw1], gb⟩
      rw [update_of_ne (by decide), g23, hrs, List.length_append]; push_cast; ring)
    hv f28 ⟨frm_upd (fun i _ => rfl) (by decide) _, by rw [update_of_ne (by decide), h23]; simp [hrowL]⟩
  have e0 : update D 41 ((rowL 0).reverse ++ D 41) = D := by
    simp only [hrowL, List.range_zero, List.flatMap_nil, List.reverse_nil, List.nil_append]
    exact update_eq_self _ _
  rw [e0] at H
  exact H.mono (fun v' ⟨⟨hf, h23'⟩, _, hb⟩ => ⟨h23', hf, hb⟩) le_rfl

end outer

