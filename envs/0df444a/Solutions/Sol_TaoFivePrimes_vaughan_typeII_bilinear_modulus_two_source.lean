                    (1 / Real.sqrt 2 : ℝ) * f2 W) := by
            rw [MeasureTheory.integral_add
              (hf1.const_mul (1 / 2 : ℝ))
              (hf2.const_mul (1 / Real.sqrt 2 : ℝ))]
          _ = _ := by
            rw [MeasureTheory.integral_const_mul,
              MeasureTheory.integral_const_mul,
              MeasureTheory.integral_const_mul]
