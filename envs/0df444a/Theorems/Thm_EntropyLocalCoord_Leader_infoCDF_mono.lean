-- title:
--   §4, p. 10 — $f_X$ is monotone from $0$ to $H(X)$
-- statement:
--   Let $Z_1,\dots,Z_k$ be random variables on a probability space and let $X$ be a finite-valued random variable measurable with respect to $Z_1,\dots,Z_k$. Write $f_X(j)=I(X;Z_{[j]})$ for the mutual information between $X$ and the first $j$ sources. Then $f_X$ maps $\{0,\dots,k\}$ into $[0,H(X)]$, is monotone on $\{0,\dots,k\}$, and
--
--   $$f_X(0)=0,\qquad f_X(k)=H(X).$$
--
--   So the increments $df_X(\{j\})=f_X(j)-f_X(j-1)$ define a nonnegative measure on $K$ of total mass $H(X)$.
--
--   Differences from the source:
--   - generalization: in §4 the variables $Z_1,\dots,Z_k$ are the mutually independent sources of a binary coordination profile → no independence hypothesis on the $Z_j$; the codomain of $X$ is any type with measurable singletons; reason: the printed statement does not use independence, and the source's case is the special case of independent sources
--   - encoding: a finite-valued random variable → a map with finite range into a type with measurable singletons; reason: the same objects
--   - encoding: sources numbered $1,\dots,k$ and $f_X(j)=I(X;Z_1,\dots,Z_j)$ → sources indexed by `Fin k`, with `prefixSigma Z j` generated by indices less than $j$; reason: the same ordered prefixes under the index shift, including the empty prefix at $j=0$
-- source:
--   Peretz and Kraizberg, Entropy Bounds for Local Coordination and Graph Amenability, STOC 2027 submission #272, §4, p. 10, paragraph defining f_X.

import Mathlib
import Definitions.Def_EntropyLocalCoord_Leader_Information

open MeasureTheory

namespace EntropyLocalCoord.Leader

/-- §4, p. 10: for a finite-valued `X` measurable with respect to `Z_1, …, Z_k`, the function
`f_X` maps `{0, …, k}` into `[0, H(X)]`, is monotone, and `f_X(0) = 0`, `f_X(k) = H(X)`. -/
theorem infoCDF_mono {Ω β : Type*} [MeasurableSpace Ω] [MeasurableSpace β]
    [MeasurableSingletonClass β] {k : ℕ} {α : Fin k → Type*} [∀ l, MeasurableSpace (α l)]
    (P : Measure Ω) [IsProbabilityMeasure P] (Z : ∀ l, Ω → α l) (hZ : ∀ l, Measurable (Z l))
    (X : Ω → β) (hfin : (Set.range X).Finite)
    (hX : Measurable[sourceSigma Z Finset.univ] X) :
    MonotoneOn (infoCDF P Z X) (Set.Iic k) ∧
      infoCDF P Z X 0 = 0 ∧
      infoCDF P Z X k = entropy P X ∧
      ∀ j ≤ k, infoCDF P Z X j ∈ Set.Icc 0 (entropy P X) := by sorry

end EntropyLocalCoord.Leader
