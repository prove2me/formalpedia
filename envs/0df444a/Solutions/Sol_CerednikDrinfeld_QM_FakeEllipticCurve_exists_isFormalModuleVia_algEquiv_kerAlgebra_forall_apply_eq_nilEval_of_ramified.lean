        θ T (fun i => χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i)))) := by
    intro T _ _ χ
    have hc : (fun i => χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i)))) =
