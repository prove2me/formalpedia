-- title:
--   Definitions for Vanishing quantum discord is necessary and sufficient for completely positive maps
-- statement:
--   The objects the formalized statements of *Vanishing quantum discord is necessary and sufficient for completely positive maps* (arXiv:0808.0175) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `SystemMatrix`: System operators in the fixed basis of Eq. (4), PDF p. 2.
--   - `JointMatrix`: Joint operators, system first, in Eq. (1), PDF p. 1.
--   - `BathFamily`: The fixed bath coefficient operators of Eq. (4), PDF p. 2.
--   - `IsSLFamily`: Definition 1 and the adjoint symmetry stated before it, PDF p. 2. This imposes no positivity on individual bath coefficients.
--   - `sourceAssignment`: Eq. (4), PDF p. 2, extended to every system matrix as in Eqs. (14)-(15), PDF p. 4: the (i,j) bath block is X_ij phi_ij. Zero coefficient operators annihilate the corresponding matrix units, independently of the scalar input.
--   - `IsSLAdmissibleInput`: The admissible scalar data of Eq. (4) and its normalization, PDF p. 2. Positivity means positive semidefinite; rank-deficient joint states are included.
--   - `qdp`: Eq. (1), PDF p. 1: conjugate by the joint unitary and trace out the bath.
--   - `specifiedReducedMap`: The specific matrix-unit extension in Eqs. (14)-(15), PDF p. 4. The fixed phi and U precede the varying system input.
--   - `AllUnitaryCP`: The all-unitary CP hypothesis of the Introduction, PDF p. 1, and the necessary-direction proof, PDF p. 3. The linear map agrees with the specified extension on the entire matrix space. CP does not include trace preservation.
--   - `operatorComponent`: Definition 2, PDF pp. 2-3: components are generated by nonzero operator entries. Reflexivity retains isolated indices, including wholly zero singleton blocks.
--   - `bathBlock`: The actual (i,j) bath block of a joint operator, Eq. (4), PDF p. 2.
--   - `IsSLState`: Intrinsic SL membership in the specified system basis, Definition 1 and Discussion, PDF pp. 2,4. On density matrices this is equivalent to existence of an SL expansion: a nonzero bath block must have nonzero trace.
-- source:
--   Vanishing quantum discord is necessary and sufficient for completely positive maps, arXiv:0808.0175v2, https://arxiv.org/abs/0808.0175v2

import Mathlib
import Definitions.Def_QAlgorithms_Defs_Information
import Definitions.Def_QAlgorithms_Defs_Measurement
import Definitions.Def_QAlgorithms_Defs_MatrixMapPositivity

/-!
Statements from Shabani and Lidar, arXiv:0808.0175v2.
All matrices use fixed orthonormal coordinates, with the system first and bath second.
Theorem 3, Lemma 1, and the arbitrary-state claim are deferred in HARD.md.
Theorem 1 records its minimal rectangular typing correction explicitly.
No CP sufficiency assertion is made for the matrix-unit extension below.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Advance50.P40

/-- System operators in the fixed basis of Eq. (4), PDF p. 2. -/
abbrev SystemMatrix (n : ℕ) := Matrix (Fin n) (Fin n) ℂ

/-- Joint operators, system first, in Eq. (1), PDF p. 1. -/
abbrev JointMatrix (n m : ℕ) := Matrix (Fin n × Fin m) (Fin n × Fin m) ℂ

/-- The fixed bath coefficient operators of Eq. (4), PDF p. 2. -/
abbrev BathFamily (n m : ℕ) := Fin n → Fin n → SystemMatrix m

/-- Definition 1 and the adjoint symmetry stated before it, PDF p. 2.
This imposes no positivity on individual bath coefficients. -/
def IsSLFamily {n m : ℕ} (phi : BathFamily n m) : Prop :=
  (∀ i j, phi i j = 0 ∨ Matrix.trace (phi i j) = 1) ∧
    ∀ i j, phi j i = (phi i j).conjTranspose

/-- Eq. (4), PDF p. 2, extended to every system matrix as in Eqs. (14)-(15),
PDF p. 4: the (i,j) bath block is X_ij phi_ij. Zero coefficient operators
annihilate the corresponding matrix units, independently of the scalar input. -/
def sourceAssignment {n m : ℕ} (phi : BathFamily n m) (X : SystemMatrix n) :
    JointMatrix n m :=
  Matrix.of fun p q => X p.1 q.1 * phi p.1 q.1 p.2 q.2

/-- The admissible scalar data of Eq. (4) and its normalization, PDF p. 2.
Positivity means positive semidefinite; rank-deficient joint states are included. -/
def IsSLAdmissibleInput {n m : ℕ} (phi : BathFamily n m) (R : SystemMatrix n) : Prop :=
  R.IsHermitian ∧ (∑ i, R i i) = 1 ∧
    QAlgorithms.IsDensityMatrix (sourceAssignment phi R)

/-- Eq. (1), PDF p. 1: conjugate by the joint unitary and trace out the bath. -/
def qdp {n m : ℕ} (U : Matrix.unitaryGroup (Fin n × Fin m) ℂ)
    (rho : JointMatrix n m) : SystemMatrix n :=
  QAlgorithms.traceRight ((U : JointMatrix n m) * rho *
    (U : JointMatrix n m).conjTranspose)

/-- The specific matrix-unit extension in Eqs. (14)-(15), PDF p. 4.
The fixed phi and U precede the varying system input. -/
def specifiedReducedMap {n m : ℕ} (phi : BathFamily n m)
    (U : Matrix.unitaryGroup (Fin n × Fin m) ℂ) (X : SystemMatrix n) : SystemMatrix n :=
  qdp U (sourceAssignment phi X)

/-- The all-unitary CP hypothesis of the Introduction, PDF p. 1, and the
necessary-direction proof, PDF p. 3. The linear map agrees with the specified
extension on the entire matrix space. CP does not include trace preservation. -/
def AllUnitaryCP {n m : ℕ} (phi : BathFamily n m) : Prop :=
  ∀ U : Matrix.unitaryGroup (Fin n × Fin m) ℂ,
    ∃ F : SystemMatrix n →ₗ[ℂ] SystemMatrix n,
      (∀ X, F X = specifiedReducedMap phi U X) ∧
        QAlgorithms.Entanglement.IsCompletelyPositive F

/-- Definition 2, PDF pp. 2-3: components are generated by nonzero operator
entries. Reflexivity retains isolated indices, including wholly zero singleton blocks. -/
def operatorComponent {n m : ℕ} (phi : BathFamily n m) : Setoid (Fin n) :=
  Relation.EqvGen.setoid (fun i j => phi i j ≠ 0)

/-- The actual (i,j) bath block of a joint operator, Eq. (4), PDF p. 2. -/
def bathBlock {n m : ℕ} (rho : JointMatrix n m) (i j : Fin n) : SystemMatrix m :=
  Matrix.of fun a b => rho (i, a) (j, b)

/-- Intrinsic SL membership in the specified system basis, Definition 1 and
Discussion, PDF pp. 2,4. On density matrices this is equivalent to existence
of an SL expansion: a nonzero bath block must have nonzero trace. -/
def IsSLState {n m : ℕ} (rho : JointMatrix n m) : Prop :=
  ∀ i j, bathBlock rho i j = 0 ∨ Matrix.trace (bathBlock rho i j) ≠ 0

/-- Sanity: Eq. (4) retains each scalar coefficient and the tensor-factor order. -/
example {n m : ℕ} (phi : BathFamily n m) (X : SystemMatrix n)
    (i j : Fin n) (a b : Fin m) :
    sourceAssignment phi X (i, a) (j, b) = X i j * phi i j a b := rfl

/-- Sanity: a zero bath family gives the zero joint operator on every input. -/
example {n m : ℕ} (X : SystemMatrix n) :
    sourceAssignment (fun _ _ => (0 : SystemMatrix m)) X = 0 := by
  ext p q
  simp [sourceAssignment]

/-- Sanity: the one-dimensional normalized coefficient family is SL. -/
example : IsSLFamily (fun _ _ : Fin 1 => (1 : SystemMatrix 1)) := by
  constructor
  · intro i j
    right
    simp [Matrix.trace]
  · intro i j
    simp

/-- Sanity: identity joint evolution and a one-dimensional bath keep the entry. -/
example (rho : JointMatrix 1 1) :
    qdp (1 : Matrix.unitaryGroup (Fin 1 × Fin 1) ℂ) rho 0 0 = rho (0, 0) (0, 0) := by
  simp [qdp, QAlgorithms.traceRight]

/-- Sanity: isolated indices are still in their own component. -/
example {n m : ℕ} (phi : BathFamily n m) (i : Fin n) :
    (operatorComponent phi).r i i := Relation.EqvGen.refl i

/-- Sanity: zero bath blocks satisfy the intrinsic SL condition; zero trace
alone does not make a block non-SL. Density is required separately. -/
example {n m : ℕ} : IsSLState (0 : JointMatrix n m) := by
  intro i j
  left
  rfl

/-- Sanity: the physical one-dimensional trace-one state is SL. -/
example : IsSLState (1 : JointMatrix 1 1) := by
  intro i j
  right
  have hij : i = j := Subsingleton.elim _ _
  subst j
  simp [bathBlock, Matrix.trace]

open scoped Matrix.Norms.Frobenius

end QAlgorithms.Papers.Independent.Advance50.P40


