theorem repPad_disc {zs : List GI} {u : ((i : Fin d) → ZMod (s i)) → ℂ}
    (hrep : RepPad p s t zs u) (hu : ‖u‖ ≤ 1) : ∀ x, ‖gC (zs.getD x 0)‖ ≤ 2 ^ p := by
