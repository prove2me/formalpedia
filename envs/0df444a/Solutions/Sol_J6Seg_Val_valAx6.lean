section
-- Source module: Solutions.J6SegVal2
/-!
# B-line value bounds 2: the chunk kernel, crude entrywise bound

With all stage-table entries `≤ 2^(P+a)` in modulus (at indices `< 2^ℓ`) and an input of
length `≤ 2^ℓ` with entries `≤ 2^e`, every output entry of the block solve `blkL` and of the
chunk kernel `chunkL` is `≤ 2^(e + 7a + 2ℓ)` (five diagonal stages, two Toeplitz stages of
length `≤ 2^ℓ`; each rounding `rs P` of a value `≤ 2^(P+f)` is `≤ 2^f`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.Val

theorem rs_bnd (P f : ℕ) {z : ℤ} (hz : |z| ≤ 2 ^ (P + f)) : |rs P z| ≤ 2 ^ f := by
  unfold rs rq
  have hB : (0 : ℤ) < 2 ^ P := by positivity
  have hF : (0 : ℤ) < 2 ^ f := by positivity
  rw [pow_add] at hz
  set B : ℤ := 2 ^ P
  set F : ℤ := 2 ^ f
  rw [abs_le] at hz ⊢
  constructor
  · apply Int.le_ediv_of_mul_le (by omega)
    nlinarith
  · apply Int.le_of_lt_add_one
    apply Int.ediv_lt_of_lt_mul (by omega)
    nlinarith

theorem IB_getD {e : ℕ} {x : List ℤ} (hx : IB e x) (k : ℕ) : |x.getD k 0| ≤ 2 ^ e :=
  getD_pr (Pr := fun a : ℤ => |a| ≤ 2 ^ e) (by simp) hx k

theorem IB_mono {e e' : ℕ} (h : e ≤ e') {x : List ℤ} (hx : IB e x) : IB e' x :=
  fun a ha => (hx a ha).trans (pow_le_pow_right₀ (by norm_num) h)

theorem fmul_bnd (P a e : ℕ) {c y : ℤ} (hc : |c| ≤ 2 ^ (P + a)) (hy : |y| ≤ 2 ^ e) :
    |fmul P c y| ≤ 2 ^ (a + e) := by
  unfold fmul
  apply rs_bnd
  rw [abs_mul, show P + (a + e) = (P + a) + e by ring, pow_add]
  exact mul_le_mul hc hy (abs_nonneg _) (by positivity)

theorem dgL_bnd (P a e N : ℕ) {c x : List ℤ} (hc : TB (2 ^ (P + a)) N c) (hxl : x.length ≤ N)
    (hx : IB e x) : IB (a + e) (dgL P c x) := by
  intro y hy
  obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.1 hy
  simp only [dgL, List.length_zipWith] at hi
  simp only [dgL, List.getElem_zipWith]
  apply fmul_bnd
  · have := hc i (by omega)
    rwa [List.getD_eq_getElem _ _ (by omega)] at this
  · exact hx _ (List.getElem_mem _)

theorem length_dgL_le (P : ℕ) (c x : List ℤ) : (dgL P c x).length ≤ x.length := by
  simp [dgL]

theorem lwL_bnd (P a e ℓ : ℕ) {c x : List ℤ} (hc : TB (2 ^ (P + a)) (2 ^ ℓ) c)
    (hxl : x.length ≤ 2 ^ ℓ) (hx : IB e x) : IB (a + e + ℓ) (lwL P c x) := by
  intro y hy
  simp only [lwL, convL, List.map_map, List.mem_map, List.mem_range, Function.comp] at hy
  obtain ⟨u, hu, rfl⟩ := hy
  apply rs_bnd
  calc |∑ k ∈ range (u + 1), c.getD (u - k) 0 * x.getD k 0|
      ≤ ∑ k ∈ range (u + 1), |c.getD (u - k) 0 * x.getD k 0| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k ∈ range (u + 1), (2 ^ (P + a) * 2 ^ e : ℤ) := by
        apply Finset.sum_le_sum
        intro k hk
        rw [abs_mul]
        exact mul_le_mul (hc _ (by omega)) (IB_getD hx k) (abs_nonneg _) (by positivity)
    _ = ((u + 1 : ℕ) : ℤ) * (2 ^ (P + a) * 2 ^ e) := by rw [Finset.sum_const, card_range]; simp
    _ ≤ ((2 ^ ℓ : ℕ) : ℤ) * (2 ^ (P + a) * 2 ^ e) := by
        apply mul_le_mul_of_nonneg_right _ (by positivity)
        exact_mod_cast (by omega : u + 1 ≤ 2 ^ ℓ)
    _ = 2 ^ (P + (a + e + ℓ)) := by push_cast; rw [← pow_add, ← pow_add]; ring_nf

theorem upL_bnd (P a e ℓ : ℕ) {c x : List ℤ} (hc : TB (2 ^ (P + a)) (2 ^ ℓ) c)
    (hxl : x.length ≤ 2 ^ ℓ) (hx : IB e x) : IB (a + e + ℓ) (upL P c x) := by
  intro y hy
  simp only [upL, List.mem_reverse] at hy
  exact lwL_bnd P a e ℓ hc (by simpa using hxl) (fun b hb => hx b (List.mem_reverse.1 hb)) y hy

/-- **The block solve, crude bound.** -/
theorem blkL_bnd (P a e ℓ : ℕ) {di gi gam dd am ap x : List ℤ}
    (h1 : TB (2 ^ (P + a)) (2 ^ ℓ) di) (h2 : TB (2 ^ (P + a)) (2 ^ ℓ) gi)
    (h3 : TB (2 ^ (P + a)) (2 ^ ℓ) gam) (h4 : TB (2 ^ (P + a)) (2 ^ ℓ) dd)
    (h5 : TB (2 ^ (P + a)) (2 ^ ℓ) am) (h6 : TB (2 ^ (P + a)) (2 ^ ℓ) ap)
    (hxl : x.length ≤ 2 ^ ℓ) (hx : IB e x) :
    IB (e + 7 * a + 2 * ℓ) (blkL P di gi gam dd am ap x) := by
  unfold blkL
  have l1 := length_dgL_le P di x
  have s1 := dgL_bnd P a e _ h1 hxl hx
  have l2 := length_dgL_le P gi (dgL P di x)
  have s2 := dgL_bnd P a _ _ h2 (by omega) s1
  have l3 := length_lwL P am (dgL P gi (dgL P di x))
  have s3 := lwL_bnd P a _ ℓ h5 (by omega) s2
  have l4 := length_dgL_le P gam (lwL P am (dgL P gi (dgL P di x)))
  have s4 := dgL_bnd P a _ _ h3 (by omega) s3
  have l5 := length_upL P ap (dgL P gam (lwL P am (dgL P gi (dgL P di x))))
  have s5 := upL_bnd P a _ ℓ h6 (by omega) s4
  have l6 := length_dgL_le P gi (upL P ap (dgL P gam (lwL P am (dgL P gi (dgL P di x)))))
  have s6 := dgL_bnd P a _ _ h2 (by omega) s5
  have s7 := dgL_bnd P a _ _ h4 (by omega) s6
  exact IB_mono (by omega) s7

/-- **The chunk kernel on lists, crude bound.** -/
theorem chunkL_bnd (P a e ℓ : ℕ) {di gi gam dd : List ℤ}
    (h1 : TB (2 ^ (P + a)) (2 ^ ℓ) di) (h2 : TB (2 ^ (P + a)) (2 ^ ℓ) gi)
    (h3 : TB (2 ^ (P + a)) (2 ^ ℓ) gam) (h4 : TB (2 ^ (P + a)) (2 ^ ℓ) dd) :
    ∀ (ds : List (ℕ × List ℤ × List ℤ)),
      (∀ d ∈ ds, TB (2 ^ (P + a)) (2 ^ ℓ) d.2.1 ∧ TB (2 ^ (P + a)) (2 ^ ℓ) d.2.2) →
      ∀ x : List ℤ, x.length ≤ 2 ^ ℓ → IB e x →
      IB (e + 7 * a + 2 * ℓ) (chunkL P di gi gam dd ds x) := by
  intro ds
  induction ds with
  | nil =>
    intro _ x _ _ y hy
    simp only [chunkL, List.mem_map] at hy
    obtain ⟨_, _, rfl⟩ := hy
    simp
  | cons d ds ih =>
    intro hds x hxl hx
    obtain ⟨n, am, ap⟩ := d
    have hd := hds _ List.mem_cons_self
    intro y hy
    simp only [chunkL, List.mem_append] at hy
    rcases hy with hy | hy
    · exact blkL_bnd P a e ℓ h1 h2 h3 h4 hd.1 hd.2 (by simp; omega)
        (fun b hb => hx b (List.mem_of_mem_take hb)) y hy
    · exact ih (fun d hd' => hds d (List.mem_cons_of_mem _ hd')) _ (by simp; omega)
        (fun b hb => hx b (List.mem_of_mem_drop hb)) y hy

/-! ## The line's chunk kernel -/

theorem TB_range {A : ℤ} (hA : 0 ≤ A) {N n : ℕ} {g : ℕ → ℤ} (hg : ∀ u < N, u < n → |g u| ≤ A) :
    TB A N ((List.range n).map g) := by
  intro i hi
  by_cases h : i < n
  · rw [List.getD_eq_getElem _ _ (by simpa using h)]; simpa using hg i hi h
  · rw [List.getD_eq_default _ _ (by simp; omega)]; simpa using hA

/-- **The chunk kernel `chunkK`, crude bound**: tables `≤ 2^(P+a)`, `λ = 2^ℓ`, input of length
`≤ λ` with entries `≤ 2^e` give entries `≤ 2^(e + 7a + 2ℓ)`. -/
theorem chunkK_bnd {P R s t lam α a ℓ e : ℕ} (hlam : lam = 2 ^ ℓ)
    (hT : TabB (2 ^ (P + a)) lam (TT P R s t α)) (c : ℕ) {x : List ℤ} (hxl : x.length ≤ lam)
    (hx : IB e x) : IB (e + 7 * a + 2 * ℓ) (chunkK P R s t lam α c x) := by
  subst hlam
  have hA : (0 : ℤ) ≤ 2 ^ (P + a) := by positivity
  unfold chunkK diL giL gamL ddL
  refine chunkL_bnd P a e ℓ (TB_range hA fun u hu _ => (hT u hu).1)
    (TB_range hA fun u hu _ => (hT u hu).2.1) (TB_range hA fun u hu _ => (hT u hu).2.2.1)
    (TB_range hA fun u hu _ => (hT u hu).2.2.2.1) _ ?_ x hxl hx
  intro d hd
  unfold descsOf at hd
  obtain ⟨b, -, rfl⟩ := List.mem_map.1 hd
  exact ⟨TB_range hA fun u hu _ => ((hT u hu).2.2.2.2 b.1).1,
    TB_range hA fun u hu _ => ((hT u hu).2.2.2.2 b.1).2⟩

end J6Seg.Val

end

