theorem solution
    (F : Type) [Field F] [NumberField F] (c u : ℝ) :
    let α : (AdeleRing (𝓞 F) F)ˣ →* ℝˣ :=
      ((NNReal.toRealHom : ℝ≥0 →+* ℝ).toMonoidHom.comp
        (distribHaarChar (AdeleRing (𝓞 F) F))).toHomUnits
    ∀ (hα : ∀ x, 0 < ((α x : ℝˣ) : ℝ))
      (μ ν : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ)
      (_hμ : IsUnitaryChar (𝓞 F) F μ) (_hν : IsUnitaryChar (𝓞 F) F ν)
      (s : ℂ) (_hs : 1 / 2 < s.re) (φ : AdelicGL2 (𝓞 F) F → ℂ)
      (_hφ : IsInducedSection (𝓞 F) F (etaFst μ α hα s) (etaSnd ν α hα s) φ)
      (_hφK : IsArchKFinite F φ) (_hφf : IsKfSmooth F φ) (_hφc : Continuous φ),
    let E : AdelicGL2 (𝓞 F) F → ℂ := fun g' =>
      φ g' + ∑' ξ : F, φ (adelicWeyl (𝓞 F) F
        * unipotentGL2 (algebraMap F (AdeleRing (𝓞 F) F) ξ) * g')
    ∃ T₀ : ℝ, IsRapidlyDecreasingOn
      (integralWindowedSiegelSet F c u ∩ {x | T₀ < archHeight F (glArch (𝓞 F) F x)})
      (fun g => archHeight F (glArch (𝓞 F) F g))
      (fun x => E x - @AutomorphicForm.constantTerm _ (NumberField.AdelicHaar.adeleBorel (𝓞 F) F) _ _
          (@ProbabilityTheory.cond _ (NumberField.AdelicHaar.adeleBorel (𝓞 F) F)
            (NumberField.AdelicHaar.adelicAddHaar (𝓞 F) F) (adelicBox F))
          (fun t => unipotentGL2 t) E x) := by
  intro α hα μ ν _hμ _hν s _hs φ _hφ _hφK _hφf _hφc E

  obtain ⟨𝔫, h𝔫, hrow⟩ := M4aP3B.KfLevel.exists_ideal_forall_apply_mul_conj_unipotentGL2_eq _hφf

  have hK : ∀ (g x : AdelicGL2 (𝓞 F) F), glFin (𝓞 F) F x ∈ finiteIntegralGL2 (𝓞 F) F →
      ∀ n ∈ 𝔫, ∀ o ∈ NumberField.AdelicBox.integralFiniteAdeles (𝓞 F) F,
        φ (g * (x⁻¹ * unipotentGL2 (mkAdele F 0
          (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x)) = φ g := by
    intro g x hxf n hn o ho
    exact hrow g x hxf _ rfl
      (mul_mem_idealBall_right (M4aP3B.RowA.algebraMap_mem_idealBall h𝔫 hn) ho)

  have hD := M4aP3B.DHead.bruhat_sub_mFourierCoeff_zero_isRapidlyDecreasingOn
    F c u hα μ ν _hμ _hν s _hs φ _hφ _hφK _hφf _hφc 𝔫 h𝔫 hK
  obtain ⟨T₀, hT⟩ := hD
  refine ⟨T₀, fun N => ?_⟩
  obtain ⟨C, hC⟩ := hT N
  refine ⟨C, fun x hx => ?_⟩
  have hxf : glFin (𝓞 F) F x ∈ finiteIntegralGL2 (𝓞 F) F := hx.1.1

  have hEc : Continuous E :=
    _hφc.add (AutomorphicForm.continuous_bruhatTransversal_tsum_of_re_gt_half F hα μ ν _hμ _hν s _hs φ _hφ _hφc)
  have hF' : ∀ (k : F) (t : AdeleRing (𝓞 F) F),
      E (unipotentGL2 (algebraMap F (AdeleRing (𝓞 F) F) k + t) * x) = E (unipotentGL2 t * x) := fun k t => by
    show φ _ + M4aP3B.JT1cAssembly.bruhatSum F φ _ = φ _ + M4aP3B.JT1cAssembly.bruhatSum F φ _
    rw [M4aP3B.JT1cAssembly.apply_unipotentGL2_mul _hφ, M4aP3B.JT1cAssembly.apply_unipotentGL2_mul _hφ,
      M4aP3B.JT1cAssembly.bruhatSum_unipotentGL2_add_algebraMap]
  have hU' : ∀ n ∈ 𝔫, ∀ o ∈ NumberField.AdelicBox.integralFiniteAdeles (𝓞 F) F, ∀ t : AdeleRing (𝓞 F) F,
      E (unipotentGL2 (t + mkAdele F 0 (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x)
        = E (unipotentGL2 t * x) := by
    intro n hn o ho t
    have hk : ∀ g, φ (g * (x⁻¹ * unipotentGL2 (mkAdele F 0
        (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x)) = φ g :=
      fun g => hK g x hxf n hn o ho
    have hEk : ∀ g, E (g * (x⁻¹ * unipotentGL2 (mkAdele F 0
        (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x)) = E g := fun g => by
      show φ _ + M4aP3B.JT1cAssembly.bruhatSum F φ _ = φ _ + M4aP3B.JT1cAssembly.bruhatSum F φ _
      rw [hk g]
      unfold M4aP3B.JT1cAssembly.bruhatSum
      congr 1
      exact tsum_congr fun ξ => by rw [← mul_assoc, hk]
    rw [unipotentGL2_add, show unipotentGL2 t * unipotentGL2 (mkAdele F 0
        (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x
        = unipotentGL2 t * x * (x⁻¹ * unipotentGL2 (mkAdele F 0
            (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) * x) by group, hEk]
  have hc' : Continuous fun t : AdeleRing (𝓞 F) F => E (unipotentGL2 t * x) :=
    hEc.comp (AutomorphicForm.continuous_unipotentGL2.mul continuous_const)
  have hmeas := M4aP3B.LevelTorus.measure_leg 𝔫 h𝔫 (fun t => E (unipotentGL2 t * x)) hF' hU' hc'

  have h1 := hC x hx
  have hct : @AutomorphicForm.constantTerm _ (NumberField.AdelicHaar.adeleBorel (𝓞 F) F) _ _
      (@ProbabilityTheory.cond _ (NumberField.AdelicHaar.adeleBorel (𝓞 F) F)
        (NumberField.AdelicHaar.adelicAddHaar (𝓞 F) F) (adelicBox F))
      (fun t => unipotentGL2 t) E x
      = UnitAddTorus.mFourierCoeff
          (torusLift (adelicTorusMap F 𝔫 h𝔫) (adelicTorusMap_surjective F 𝔫 h𝔫)
            (archRestrict (fun t => E (unipotentGL2 t * x)))) 0 := by
    rw [← hmeas]
    rfl
  beta_reduce at h1 ⊢
  rw [hct]
  exact h1

end
