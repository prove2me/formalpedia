theorem _root_.solution
    (pre l l' : List (Ordinal.{u} × Ordinal.{u}))
    (h : cnfValue l < cnfValue l') :
    cnfValue (pre ++ l) < cnfValue (pre ++ l') := by
  induction pre with
  | nil => simpa using h
  | cons p pre ih =>
      simp only [List.cons_append, cnfValue, List.foldr_cons]
      exact (add_lt_add_iff_left _).2 ih
end OrderClosures
