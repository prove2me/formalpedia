    obtain ⟨F, hF⟩ := (faceCr_continuousLinear r hr n).1 m i
    rw [← hF, ← hF, ← hF, map_add]
  map_smul' c w := by
    obtain ⟨F, hF⟩ := (faceCr_continuousLinear r hr n).1 m i
    rw [← hF, ← hF, map_smul]
    rfl

theorem faceLin_continuous (hr : 1 ≤ r) (n : ℕ) (i : Fin (m + 2)) :
