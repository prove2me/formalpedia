    codeUpTo bs o i l < 7 ^ l := by
  have hlt := ThreeSumApsp.ofDigitList_lt ((Spec.gluedDigits bs o i).take l) fun d hd =>
    Spec.lt_of_mem_gluedDigits ho hi d (List.mem_of_mem_take hd)
