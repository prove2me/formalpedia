open scoped BigOperators

open ErdosProblems.Erdos269.PaperR7

theorem ErdosProblems.Erdos269.PaperR7.long_all_scale_lattice {N : ℤ} {D : ℕ} (hD : 0 < D)
    (hval : paperSeries235 = (N : ℝ) / (D : ℝ)) :
    (∀ u b : ℕ, u ≤ b → ∃ z : ℕ,
      (threePrimeHeight 2 3 5 (2 ^ b) : ℝ) / 2 *
        (∑ i ∈ Finset.range (b - u), dyadicShellMassR235 (u + i)) = (z : ℝ)) ∧
    (∀ a : ℕ, 1 ≤ a → ∃ z : ℤ,
      (D : ℝ) * trueNormalizedState a = (z : ℝ)) ∧
    (∃ i j : ℕ, 1 ≤ i ∧ i < j ∧ ∃ z : ℤ,
      trueNormalizedState j - trueNormalizedState i = (z : ℝ)) := by sorry
