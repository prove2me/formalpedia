/-! ### The Brownian increments of a cell -/


theorem _root_.Prove2MeSourceProof.h_da13dd42275c2a9e7134e617 (D : LevyDriver.{u, v, w} P d ν)
    (a b : Fin d) {s t : ℝ} (hs : 0 ≤ s) (hst : s ≤ t) :
    ∫ ω, ((D.W.W a).W t ω - (D.W.W a).W s ω) * ((D.W.W b).W t ω - (D.W.W b).W s ω) ∂P
      = if a = b then t - s else 0 := by
  by_cases hab : a = b
  · subst hab
    rw [if_pos rfl]
    by_cases heq : s = t
    · subst t
      simp
    · have hlt : s < t := lt_of_le_of_ne hst heq
      simpa only [pow_two] using
        (LevyStochCalc.Brownian.Ito.integral_increment_sq (D.W.W a) hs hlt)
  · rw [if_neg hab]
    exact D.integral_increment_mul_eq_zero_of_restSigma a hs hst
      (D.measurable_increment_restSigma (Ne.symm hab) s t)
