theorem mem_kernelPts_tensor (k : Type) [Field k] [IsAlgClosed k] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of k))
    (L : RelativeGroupLaw k f) (𝓛 Q : A.Modules) (hQ : InPicZero f L Q)
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of k))) f) (hx : x ∈ kernelPts f L 𝓛) :
    x ∈ kernelPts f L (𝓛 ⊗ Q) := by
  obtain ⟨e⟩ := (mem_kernelPts_iff_nonempty_pullback_translate_iso k f L 𝓛 x).mp hx
  obtain ⟨eQ⟩ := hQ.2 x
  exact (mem_kernelPts_iff_nonempty_pullback_translate_iso k f L (𝓛 ⊗ Q) x).mpr
    ⟨Scheme.Modules.pullbackTensorObjIso _ _ _ ≪≫ tensorIso e eQ⟩

