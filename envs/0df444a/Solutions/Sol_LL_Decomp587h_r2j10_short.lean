def D_den : Nat := 119906304
def W_scale : Nat := 1000000000
def A0_num : Nat := 33587200
def B0_num : Nat := 41779200
def A1_num : Nat := 33587200
def B1_num : Nat := 41779200
def A2_num : Nat := 41779200
def B2_num : Nat := 49960960
