    simpa only [he] using hprime
  · have hd : r ∣ 2 := hr.dvd_of_dvd_pow h
    have he : r = 2 := (Nat.prime_dvd_prime_iff_eq hr Nat.prime_two).mp hd
    simpa only [he] using htwo

