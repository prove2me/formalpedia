private theorem encoder_loop (d : ℕ → K) (t : ℕ → ℕ) (xs : List PowerToken)
    (src stop tag : ℕ) (out : List ℕ) (hrange : src + xs.length = stop)
    (hdisj : out.length + 2*xs.length ≤ src)
    (hread : ∀ i, ∀ hi : i < xs.length, t (src+i) = xs[i].code) :
