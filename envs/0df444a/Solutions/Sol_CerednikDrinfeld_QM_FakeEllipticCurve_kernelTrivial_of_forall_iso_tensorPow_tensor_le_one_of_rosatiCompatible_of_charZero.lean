    simp only [ofUnitPt_toUnitPt, RelativeGroupLaw.AlgPoints.ofPoint_toPoint]

  have hperf : ∀ (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : k) ≠ 0) (ζ : ℕ → k) (hζ : ∀ n : ℕ, IsPrimitiveRoot (ζ n) (ℓ ^ n))
      (hζℓ : ∀ n : ℕ, ζ (n + 1) ^ ℓ = ζ n)
      (e : TateModule ℓ (E.L.AlgPoints E.comm k) →ₗ[ℤ_[ℓ]] TateModule ℓ (E.L.AlgPoints E.comm k) →ₗ[ℤ_[ℓ]] ℤ_[ℓ]),
      IsRiemannForm E.f E.L E.comm 𝓛 ℓ ζ e → e.IsPerfPair := by
    intro ℓ _ hℓ ζ hζ hζℓ e he
    obtain ⟨ρ, hρ, ρ_one, ρ_mul, ρ_add⟩ :=
