-- title:
--   Theorem 6.3 (v) — with constant ρ*, every policy has limsup pathwise average cost ≥ ρ* a.s., with equality-in-the-limit iff (1/N)ΣΦ → 0
-- statement:
--   Let $(S, A, U, P, c)$ be a controlled Markov process with Borel state and action spaces and $c \in \mathcal M_b(K)$. Let $(\rho, h, \pi^*)$ be a canonical triplet with $\rho(x) = \rho^* \in \mathbb R$ for all $x \in S$, and let $\Phi(x,a) = c(x,a) + \int_S h(y)\,P(dy\mid x,a) - \rho^* - h(x)$ be Mandl's discrepancy function. Then for every admissible policy $\pi \in \Pi$ and every initial state $X_0 = x$, with $\{A_t\}$ generated by $\pi$:
--   1. $$\limsup_{N\to\infty}\frac1N\sum_{t=0}^{N-1} c(X_t, A_t) \ge \rho^*, \qquad \mathcal P^\pi_x\text{-a.s.};$$
--   2. $\displaystyle\lim_{N\to\infty}\frac1N\sum_{t=0}^{N-1} c(X_t, A_t) = \rho^*$ $\mathcal P^\pi_x$-a.s. if and only if $\displaystyle\lim_{N\to\infty}\frac1N\sum_{t=0}^{N-1}\Phi(X_t, A_t) = 0$ $\mathcal P^\pi_x$-a.s.
--
--   No policy beats $\rho^*$ pathwise, and a policy achieves $\rho^*$ pathwise exactly when its average discrepancy vanishes.
--
--   **Formalization Note.** The limit superior in part 1 is taken in `EReal`, so it is never a junk value. "$\lim = \rho^*$" is convergence (`Tendsto`) of the real sequence of running averages.
-- source:
--   Arapostathis, Borkar, Fernández-Gaucherand, Ghosh, Marcus, Discrete-time controlled Markov processes with average cost criterion: a survey, SIAM J. Control Optim. 31(2) (1993), p. 318, Theorem 6.3 (v)

import Mathlib
import Definitions.Def_ArapostathisAC_CanonicalPolicy_CMP
import Definitions.Def_ArapostathisAC_CanonicalPolicy_SamplePath

open MeasureTheory ProbabilityTheory Filter Topology

namespace ArapostathisAC.CanonicalPolicy

variable {S A : Type*} [MeasurableSpace S] [StandardBorelSpace S]
  [TopologicalSpace A] [MeasurableSpace A] [BorelSpace A]

/-- Theorem 6.3 (v), p. 318. Let `(ρ, h, π*)` be a canonical triplet with `ρ(x) = ρ* ∈ ℝ` for all
`x`, and `c ∈ 𝓜_b(K)`. Then, for every `π ∈ Π` and every initial state `x`,
`limsup_N (1/N) ∑_{t<N} c(X_t, A_t) ≥ ρ*` `𝒫^π_x`-a.s.; and `(1/N) ∑_{t<N} c(X_t, A_t) → ρ*`
`𝒫^π_x`-a.s. if and only if `(1/N) ∑_{t<N} Φ(X_t, A_t) → 0` `𝒫^π_x`-a.s. -/
theorem theorem_6_3_v (M : BorelCMP S A) (hc : CostBounded M) (ρ h : S → ℝ) (πs : Policy M)
    (hcan : IsCanonical M ρ h πs) (ρs : ℝ) (hρ : ∀ x, ρ x = ρs) (π : Policy M) (x : S) :
    (∀ᵐ ω ∂(pathMeasure M π x), (ρs : EReal) ≤ sampleAvgCost M ω) ∧
    ((∀ᵐ ω ∂(pathMeasure M π x), Tendsto (fun N : ℕ => avgPathCost M N ω) atTop (𝓝 ρs)) ↔
      (∀ᵐ ω ∂(pathMeasure M π x), Tendsto (fun N : ℕ =>
        (N : ℝ)⁻¹ * ∑ t ∈ Finset.range N, mandl M h ρs (ω t)) atTop (𝓝 0))) := by sorry

end ArapostathisAC.CanonicalPolicy
