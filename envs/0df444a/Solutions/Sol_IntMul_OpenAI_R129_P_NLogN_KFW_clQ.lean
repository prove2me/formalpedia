      rw [Function.iterate_succ_apply']
      have e := ih t
      generalize ((fun t => decSt i (b.run t))^[k] t) = X at e ⊢
      simp only [decSt, IState.upd_G, if_neg h.1]
      rw [run_G_of_not_mem b _ j h.2, e]

