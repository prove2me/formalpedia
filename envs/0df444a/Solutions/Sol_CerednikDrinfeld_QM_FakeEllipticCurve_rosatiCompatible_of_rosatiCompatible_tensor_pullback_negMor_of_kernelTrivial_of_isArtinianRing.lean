theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S : Type} [CommRing S] [IsLocalRing S] [IsNoetherianRing S] [IsArtinianRing S] [IsAlgClosed (IsLocalRing.ResidueField S)]
    (E : FakeEllipticCurve Λ N S) (star : ↥Λ → ↥Λ)
    (𝓛 : E.A.Modules) (h𝓛 : Scheme.Modules.IsInvertible 𝓛) (hK : KernelTrivial E.f E.L 𝓛)
    (hR : RosatiCompatible E.f E.L (𝓛 ⊗ (Scheme.Modules.pullback (negMor E.f E.L)).obj 𝓛) E.act E.act_over star) :
    RosatiCompatible E.f E.L 𝓛 E.act E.act_over star  := by

  have hπ : Function.Surjective (algebraMap S (ResidueField S)) := by
    rw [ResidueField.algebraMap_eq]; exact residue_surjective
  have hker : IsNilpotent (RingHom.ker (algebraMap S (ResidueField S))) := by
    rw [ResidueField.algebraMap_eq, ker_residue, ← jacobson_eq_maximalIdeal (⊥ : Ideal S) bot_ne_top]
    exact IsArtinianRing.isNilpotent_jacobson_bot

  obtain ⟨E₀, g, hg, hmul, hact, hlev, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (algebraMap S (ResidueField S)) E
  have hvia : FakeEllipticCurve.IsPullbackVia (algebraMap S (ResidueField S)) E E₀ g :=
    ⟨hg, fun t' P Q => hmul t' P Q, hact, fun t' P => hlev t' P⟩

  have h𝓛₀ : Scheme.Modules.IsInvertible ((Scheme.Modules.pullback g).obj 𝓛) :=
    Scheme.Modules.IsInvertible.pullback g h𝓛
  have hK₀ : KernelTrivial E₀.f E₀.L ((Scheme.Modules.pullback g).obj 𝓛) :=
    AlgebraicGeometry.Polarisation.KernelTrivial.pullback_of_isPullback (algebraMap S (ResidueField S)) hg E.L E₀.L
      (fun t' P Q => hmul t' P Q) 𝓛 h𝓛 hK

  have hneg𝓛 : Scheme.Modules.IsInvertible ((Scheme.Modules.pullback (negMor E.f E.L)).obj 𝓛) :=
    Scheme.Modules.IsInvertible.pullback _ h𝓛
  have hinvsym : Scheme.Modules.IsInvertible (𝓛 ⊗ (Scheme.Modules.pullback (negMor E.f E.L)).obj 𝓛) :=
    Scheme.Modules.IsInvertible.tensor_monoidalV2 h𝓛 hneg𝓛
  have hRsym₀ : RosatiCompatible E₀.f E₀.L
      ((Scheme.Modules.pullback g).obj (𝓛 ⊗ (Scheme.Modules.pullback (negMor E.f E.L)).obj 𝓛)) E₀.act E₀.act_over star :=
    AlgebraicGeometry.Polarisation.RosatiCompatible.pullback_of_isPullback S (ResidueField S) (algebraMap S (ResidueField S))
      E.f E.L E₀.f E₀.L g hg (fun t' P Q => hmul t' P Q) E.act E.act_over E₀.act E₀.act_over hact star _ hinvsym hR

  have hneg : g ≫ negMor E.f E.L = negMor E₀.f E₀.L ≫ g :=
    GoodReductionJacobian.RelativeGroupLaw.comp_negMor_eq_negMor_comp_of_hom (algebraMap S (ResidueField S)) E.L E₀.L g
      hg.w (fun T t' P Q => hmul t' P Q)
  have σ : (Scheme.Modules.pullback g).obj (𝓛 ⊗ (Scheme.Modules.pullback (negMor E.f E.L)).obj 𝓛) ≅
      (Scheme.Modules.pullback g).obj 𝓛 ⊗
        (Scheme.Modules.pullback (negMor E₀.f E₀.L)).obj ((Scheme.Modules.pullback g).obj 𝓛) :=
    Scheme.Modules.pullbackTensorObjIso g _ _ ≪≫
      (Iso.refl _ ⊗ᵢ ((Scheme.Modules.pullbackComp g _).app 𝓛 ≪≫ (Scheme.Modules.pullbackCongr hneg).app 𝓛 ≪≫
        ((Scheme.Modules.pullbackComp (negMor E₀.f E₀.L) g).app 𝓛).symm))
