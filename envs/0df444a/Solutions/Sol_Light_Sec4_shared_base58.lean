/-- **A leaf**: the number is copied. -/
theorem encodeP_leaf (pre : EncodePre lim μ src out scr tab p7 p10 V 0 a c) :
    Ends lim P d (encodePBody pS pE) ⟨Light.frame [(0 : ℕ), src, out, scr, tab, p7, p10, r], μ⟩
      (encPTime 0 r) fun σ' => EncodePPost μ out scr 0 r a c σ'.mem := by
  (((obtain ⟨⟩ := id pre.lay); (obtain ⟨⟩ := id pre.lay.std)))
  have hread : μ src = a 0 := pre.srcV 0 (by norm_num)
  -- if Level = 0 then mem[Out] := mem[Src]
  refine Ends.iteLast (fun _ => ?_) (fun h => absurd (by simp) h) (hT := by simp [encPTime])
  refine Ends.storeTo out (a 0) ⟨fun i hi _ => ?_, by (( (try refine Light.SameOn.cell ?_)
                                                         (intro x_m3 hx_m3)
                                                         (first
                                                           | ((  (repeat
                                                                     ((with_reducible rename Light.SameOn _ _ _ => h_m4);
                                                                       (try have := h_m4 x_m3 (by omega)); (revert h_m4)))
                                                                 (intros)
                                                                 (try simp only [Function.update_apply, Light.wrote] at *)); (omega))
                                                           |
                                                             ((simp [] at hx_m3);
                                                               ( (repeat
                                                                     ((with_reducible rename Light.SameOn _ _ _ => h_m5);
                                                                       (try have := h_m5 x_m3 (by omega)); (revert h_m5)))
                                                                 (intros)
                                                                 (try simp only [Function.update_apply, Light.wrote] at *)); (omega))
                                                           | ( ( (repeat
                                                                     ((with_reducible rename Light.SameOn _ _ _ => h_m6);
                                                                       (try have := h_m6 x_m3 (by omega)); (revert h_m6)))
