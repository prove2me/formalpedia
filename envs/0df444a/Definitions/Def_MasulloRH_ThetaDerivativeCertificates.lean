def thetaRow (j : ℤ) : JetRow := if active j then thetaData[(j+48).toNat]! else zeroRow
def pulseRow (j : ℤ) : JetRow := pulseData[(j+112).toNat]!
def weightQ (j : ℤ) : ℚ := (weightData[(j+112).toNat]!:ℚ)/1000000
def thetaCheck (j : ℤ) : Bool :=
  (List.range 7).all (fun k => let b := branch j
    fits (thetaJB b (orderFor k) (params b (samplingBox j k))) (col (thetaRow j) k)) &&
  let d := params (branch j) (cellBox j)
  decide (0 < tailDen d ∧ tailU d ≤ tailQ (thetaRow j))
def pulseCheck (j : ℤ) : Bool :=
  (List.range 7).all (fun k => fits (pulseJB (orderFor k) (samplingBox j k)) (col (pulseRow j) k)) &&
  let v := centerQ (j+1)
  decide ((expPoint (max v (2*v))).2 ≤ weightQ j)
def netBox (j : ℤ) (k : ℕ) : Box :=
  subB (col (pulseRow j) k)
    (∑ i : Fin 25, mulB (point (coeff i)) (col (thetaRow (j-offset i)) k))
def budgetQ (j : ℤ) (i : ℕ) : ℚ :=
  if i=3 then mag (netBox j 6) else max (mag (netBox j (2*i))) (mag (netBox j (2*i+1)))
def tailSumQ (j : ℤ) : ℚ := ∑ i : Fin 25, coeff i*tailQ (thetaRow (j-offset i))
def capQ (j : ℤ) : ℚ := majorant (1/2048:ℚ) (budgetQ j) 3 0 + tailSumQ j
def cellCost (j : ℤ) : ℚ := weightQ j*(capQ j)^2/16
noncomputable def selectedJet (j : ℤ) (n : ℕ) (x : ℝ) :=
  if active j then tJet (branch j) n x else 0
noncomputable def residualJet (j : ℤ) (n : ℕ) (x : ℝ) :=
  pJet n x-∑ i : Fin 25, (coeff i:ℝ)*selectedJet (j-offset i) n (x-(shift i:ℝ))
end MasulloRH.ThetaDerivativeCertificate


