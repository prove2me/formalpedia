    by_cases h0 : 2 * d ≤ q
    · exact Or.inl ⟨hd, h0⟩
    · right
      by_cases h1 : 2 * d ≤ 5 * q
      · exact Or.inl ⟨hd, Nat.lt_of_not_ge h0, h1⟩
      · exact Or.inr ⟨hd, Nat.lt_of_not_ge h1⟩
