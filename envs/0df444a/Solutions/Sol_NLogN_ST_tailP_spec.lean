theorem Spec.seq {M : MulSpec} {a b : RM} {s s1 s2 : IState HS} {c1 c2 : ℕ}
    (ha : Spec M a s s1 c1) (hb : Spec M b s1 s2 c2) : Spec M (RM.seq a b) s s2 (c1 + c2) := by
  refine ⟨⟨ha.1, by rw [ha.2.1]; exact hb.1⟩, by simp only [RM.run_seq, ha.2.1, hb.2.1], ?_⟩
  simp only [RM.cost]; rw [ha.2.1]; have := ha.2.2; have := hb.2.2; omega

theorem Spec.mono {M : MulSpec} {p : RM} {s s' : IState HS} {c c' : ℕ} (h : Spec M p s s' c)
    (hc : c ≤ c') : Spec M p s s' c' := ⟨h.1, h.2.1, h.2.2.trans hc⟩

theorem Spec.congr {M : MulSpec} {p : RM} {s s' t : IState HS} {c : ℕ} (h : Spec M p s s' c)
    (ht : s' = t) : Spec M p s t c := ht ▸ h

theorem Spec.of_rs {M : MulSpec} {p : RS} {s s' : IState HS} {c : ℕ} (hok : p.ok s)
    (hrun : p.run s = s') (hc : p.cost s ≤ c) : Spec M (RM.rs p) s s' c := ⟨hok, hrun, hc⟩

theorem clean_reg {i : Fin HS} (hi : i.val < 56) : (Ex.reg i).Clean := RS.clean_of_lt hi

/-- Push the top of register `j` onto `i`. -/
theorem spec_push_reg (M : MulSpec) (i j : Fin HS) (s : IState HS) (a : ℤ) (L : List Item)
    (hi : i.val < 56) (hj : j.val < 56) (h : s.G j = .int a :: L) (Q : ℕ) (hQ : zsz a ≤ Q) :
    Spec M (RM.rs (RS.push i (.reg j))) s (s.upd i (.int a :: s.G i)) (4000 * (Q + 2)) := by
  have ht : s.top j = a := IState.top_eq h
  refine Spec.of_rs ⟨hi, clean_reg hj, ⟨L, by rw [h, ht]⟩⟩ (by simp [RS.run, Ex.eval, ht]) ?_
  exact cpush_reg i j s Q (by rw [ht]; exact hQ)

/-- Pop an integer from `i`. -/
theorem spec_pop (M : MulSpec) (i : Fin HS) (s : IState HS) (a : ℤ) (L : List Item)
    (hi : i.val < 56) (h : s.G i = .int a :: L) (Q : ℕ) (hQ : zsz a ≤ Q) :
    Spec M (RM.rs (RS.pop i)) s (s.upd i L) (2 * Q + 2) := by
  have ht : s.top i = a := IState.top_eq h
  refine Spec.of_rs ⟨hi, ⟨L, by rw [h, ht]⟩⟩ (by simp [RS.run, h]) ?_
  exact cpop i s Q (by rw [ht]; exact hQ)

