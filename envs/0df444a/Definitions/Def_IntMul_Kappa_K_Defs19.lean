variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- `code w` implements the selected-bit operator `T` on inputs of width `w`. -/
def SImplI (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) {ι : Type*} [Fintype ι] [DecidableEq ι]
    (r : ℕ) (st : ι → ℕ) (n : ℕ) (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) (code : ℕ → IStmt HS Pp)
    (e dw : ℕ) (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (F w : ℕ), ClN f → f 0 = gflat zs ++ l → RecRep r F zs xs → xs.length = n → NLogN.KFB.GB w zs →
    ∃ zs', RecRep r (F + e) zs' (selOpF st n T xs) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      IRuns I iprog (code w) (encK s f) (encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

section SImplILemmas

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ}

/-- Sequential composition of code families. -/
def seqI (c1 c2 : ℕ → IStmt HS Pp) (d1 : ℕ) : ℕ → IStmt HS Pp :=
  fun w => .seq (c1 w) (c2 (w + d1))

end SImplILemmas

section RImplIDefs

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- `code w` implements the network operator `A` on `W` role streams of `n` records each. -/
def RImplI (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (r n : ℕ) (st : Fin m × κ → ℕ)
    (A : ROp (Fin W) m κ) (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ) : Prop :=
  ∀ (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (X : Fin W → List (Fin r → ℂ)) (F w : ℕ), ClN f → f 0 = gflat zs ++ l →
    RecRep r F zs (flatR X) → (∀ v, (X v).length = n) → NLogN.KFB.GB w zs →
    ∃ zs', RecRep r (F + e) zs' (flatR (roleOpF st n A X)) ∧ NLogN.KFB.GB (w + dw) zs' ∧
      IRuns I iprog (code w) (encK s f) (encK s (Function.update f 0 (gflat zs' ++ l))) (cost w)

variable {r n : ℕ} {st : Fin m × κ → ℕ}

/-- Sequence of code families (the `a`-th one starts at the width left by the previous ones). -/
def seqLI {α : Type*} (code : α → ℕ → IStmt HS Pp) (dw : α → ℕ) : List α → ℕ → IStmt HS Pp
  | [] => fun _ => .skip
  | a :: l => seqI (code a) (seqLI code dw l) (dw a)

end RImplIDefs

section DiagI

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {r n : ℕ} {st : Fin m × κ → ℕ}

end DiagI

section WrapI

/-- Run the code family `code` (scale `+e`) on role `w`. -/
def wrapCI (W L w e : ℕ) (code : ℕ → IStmt HS Pp) : ℕ → IStmt HS Pp := fun x =>
  .seq (fcode (swapsP L (NLogN.KFN.swL w))) (.seq (code x)
    (.seq (fcode (gateP (levA W 0) (Function.update (fun _ => 0) 0 e) L))
      (fcode (swapsP L (NLogN.KFN.swL w)))))

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

end WrapI

