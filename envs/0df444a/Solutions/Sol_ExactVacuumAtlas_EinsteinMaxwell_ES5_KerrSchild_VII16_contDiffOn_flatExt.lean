/-! ## The flat extension -/

theorem flatExt_of_pos {h : ℝ → ℝ} {x : ℝ} (hx : 0 < x) : flatExt h x = h x := if_pos hx

theorem flatExt_of_nonpos {h : ℝ → ℝ} {x : ℝ} (hx : ¬ 0 < x) : flatExt h x = 0 := if_neg hx

theorem flatExt_zero (h : ℝ → ℝ) : flatExt h 0 = 0 := flatExt_of_nonpos (lt_irrefl 0)

/-! ## Continuity -/

theorem continuousAt_flatExt_zero {h : ℝ → ℝ} (hlim0 : Tendsto h (𝓝[>] (0:ℝ)) (𝓝 0)) :
    ContinuousAt (flatExt h) 0 := by
  rw [ContinuousAt, flatExt_zero, Metric.tendsto_nhds]
  intro η hη
  have hδ := Metric.tendsto_nhds.mp hlim0 η hη
  rw [eventually_nhdsWithin_iff, Metric.eventually_nhds_iff] at hδ
  obtain ⟨δ', hδ'pos, hδ'b⟩ := hδ
  refine Metric.eventually_nhds_iff.mpr ⟨δ', hδ'pos, ?_⟩
  intro y hy
  by_cases hpos : 0 < y
  · rw [flatExt_of_pos hpos]; exact hδ'b hy hpos
  · rw [flatExt_of_nonpos hpos, dist_self]; exact hη

theorem continuousAt_flatExt_of_neg {h : ℝ → ℝ} {x : ℝ} (hx : x < 0) :
    ContinuousAt (flatExt h) x := by
  have hz : (fun _ => (0:ℝ)) =ᶠ[𝓝 x] flatExt h := by
    filter_upwards [Iio_mem_nhds hx] with y hy
    exact (flatExt_of_nonpos (not_lt.mpr hy.le)).symm
  exact continuousAt_const.congr hz

theorem continuousAt_flatExt_of_pos {h : ℝ → ℝ} {x : ℝ} (hx : 0 < x) (hc : ContinuousAt h x) :
    ContinuousAt (flatExt h) x := by
  have hz : h =ᶠ[𝓝 x] flatExt h := by
    filter_upwards [Ioi_mem_nhds hx] with y hy
    exact (flatExt_of_pos hy).symm
  exact hc.congr hz

theorem continuousOn_flatExt {h : ℝ → ℝ} {ε : ℝ} (hc : ContinuousOn h (Ioo (0:ℝ) ε))
    (hlim0 : Tendsto h (𝓝[>] (0:ℝ)) (𝓝 0)) :
    ContinuousOn (flatExt h) (Ioo (-ε) ε) := by
  intro x hx
  rcases lt_trichotomy x 0 with hlt | heq | hgt
  · exact (continuousAt_flatExt_of_neg hlt).continuousWithinAt
  · subst heq
    exact (continuousAt_flatExt_zero hlim0).continuousWithinAt
  · exact (continuousAt_flatExt_of_pos hgt
      ((hc.continuousAt (Ioo_mem_nhds hgt hx.2)))).continuousWithinAt

