variable {B : Type} [CommRing B] {N g : ℕ} {hf : ℕ → ℕ} (C : KCtx B N g hf) {n : ℕ} (F : C.FramedPt n)

noncomputable def framedOf {R : Type} [CommRing R] (s : Spec (CommRingCat.of R) ⟶ C.W₀) (hn : IsUnit ((n : ℕ) : R))
    (hs : C.Mem n s)

    (hid : ∀ {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of R)) (M : X.Modules) {m : ℕ} (σ : Fin m → Γ(M, ⊤)),
      Scheme.Modules.IsSectionBasisOn f ((Scheme.Modules.pullback (𝟙 X)).obj M) ((𝟙 X) ⁻¹ᵁ ⊤)
          (fun i => Scheme.Modules.pullbackLocalSection (𝟙 X) (σ i)) →
        Scheme.Modules.IsSectionBasis f M σ) :
    FramedPolarisedAbelianScheme g N n R := by
  classical
  have h₁ := hs.fst
  have h₂ := hs.snd.fst
  have h₃ := hs.snd.snd.fst
  have h₄ := hs.snd.snd.snd
  let hl := C.lifts_of_iSup_eq_bot s h₁
  have hlev : C.U₄lev s hl h₂ n = Set.univ := Set.univ_subset_iff.mp (h₄ ▸ Set.inter_subset_left)
  have hlin : C.U₄lin s hl h₂ = Set.univ := Set.univ_subset_iff.mp (h₄ ▸ Set.inter_subset_right)
  have hbasis : Scheme.Modules.IsSectionBasis (C.f s) (C.polMod s) (C.polPres s).σ := by
    apply hid
    refine ((C.U₄lin_spec s hl h₂).2 R (RingHom.id R) (C.Z s) (C.f s) (𝟙 _) ?_).mpr ?_
    · simpa using IsPullback.of_horiz_isIso ⟨by simp⟩
    · rw [hlin]; exact Set.subset_univ _
  exact
  { A := C.Z s
    f := C.f s
    L := C.law s hl h₂
    comm := (C.law_spec s hl h₂).2.1
    bundle := C.bundle s hl h₂
    dim_fibre := fun t => (C.topfibre s h₂ t).2
    P := C.Psec s hl
    P_torsion := (C.I₃_eq_bot_iff s hl h₂ n).mp h₃
    P_indep := fun k _ _ sk c c' hcc' =>
      ((Set.eq_univ_iff_forall.mp hlev) ⟨RingHom.ker sk, RingHom.ker_isPrime sk⟩ k sk rfl).1 c c' hcc'
    P_span := fun k _ _ sk Q hQ =>
      ((Set.eq_univ_iff_forall.mp hlev) ⟨RingHom.ker sk, RingHom.ker_isPrime sk⟩ k sk rfl).2 Q hQ
    pol := C.polMod s
    pol_isInvertible := C.polMod_isInvertible s
    pol_veryAmple := C.polMod_closedImmersionBySections s
    pol_finrank := fun k _ _ sk =>
      (GoodReductionJacobian.AbelianSchemePropertyBundle.sections_finite_projective_and_isSectionBasisOn_pullback_type0
        (C.law s hl h₂) (C.bundle s hl h₂) (C.polMod s) (C.polMod_isInvertible s)
        (C.polMod_closedImmersionBySections s)).2.2.2 (C.polPres s).σ hbasis k sk
    frame := C.polPres s
    frame_isClosedImmersion := by rw [polPres_toProj]; infer_instance
    frame_basis := hbasis }

end KCtx
