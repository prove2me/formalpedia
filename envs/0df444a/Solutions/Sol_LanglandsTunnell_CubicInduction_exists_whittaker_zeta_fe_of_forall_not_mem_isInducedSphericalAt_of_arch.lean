      List.map_map, Units.val_mul, units_val_map_prod]
    simp only [Function.comp_def, map_zpow]
  have hnT : TateGlobal.ideleNorm ℚ (L.map fun v => uniformizerIdele ℚ v ^ NumberField.Idele.ord ℚ v a).prod =
      (L.map fun v => ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹ ^ NumberField.Idele.ord ℚ v a).prod := by
    rw [ideleNorm_map_prod]
