-- Source module: Solutions.J6SegVal4
/-!
# B-line value bounds 4: size arithmetic at `Q = segPF p d s`

All from the definition `segPF p d s = p + 1 + p/7 + size (NF d s)`, with
`NF d s ≥ (λ_F + 1)(2w + 1)(s + 1)²` (no regime hypotheses):
`p + 1 ≤ Q`, `7(R + 2) ≤ Q + 13`, `log₂ λ_F < Q`, `size (2w+1) ≤ Q`, `(s+1)² < 2^Q`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Val
open J6Seg

section ar
variable (p d s : ℕ)

theorem NF_pos_factors : (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 ≤ NF d s := by
  unfold NF
  have h1 : 1 ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) := by omega
  calc (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      = 1 * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := by ring
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) *
        (s + 1) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
        exact h1

theorem le_NF_s : (s + 1) ^ 2 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (lamF d + 1) * (2 * wF d + 1) := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc (s + 1) ^ 2 = 1 * (s + 1) ^ 2 := by ring
    _ ≤ (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := Nat.mul_le_mul_right _ h2
    _ ≤ _ := this

/-- `2^⌈log₂ m⌉ ≤ 2m + 1`. -/
theorem pow_clog_le (m : ℕ) : 2 ^ Nat.clog 2 m ≤ 2 * m + 1 := by
  rcases Nat.lt_or_ge 1 m with h | h
  · have h1 := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) h
    have hc : 0 < Nat.clog 2 m := Nat.clog_pos (by norm_num) h
    have e : 2 ^ Nat.clog 2 m = 2 * 2 ^ (Nat.clog 2 m).pred := by
      rw [← pow_succ']; congr 1; exact (Nat.succ_pred_eq_of_pos hc).symm
    omega
  · have : Nat.clog 2 m = 0 := Nat.clog_of_right_le_one h 2
    rw [this]; omega

end ar

end J6Seg.Val

end

