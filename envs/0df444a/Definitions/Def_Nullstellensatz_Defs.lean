-- title:
--   Affine algebraic sets and vanishing ideals over a field
-- statement:
--   Let $K$ be a field and $n \in \mathbb N$. Points of affine $n$-space are tuples $a = (a_1, \dots, a_n) \in K^n$, and $K[X_1, \dots, X_n]$ is the polynomial ring in $n$ variables. This file fixes the objects of the article's *Formulations* section.
--
--   1. **Zero locus.** For an ideal $J \subseteq K[X_1,\dots,X_n]$,
--   $$\mathrm V(J) = \{\, a \in K^n : f(a) = 0 \text{ for all } f \in J \,\}.$$
--   2. **Vanishing ideal.** For a subset $U \subseteq K^n$,
--   $$\mathrm I(U) = \{\, p \in K[X_1,\dots,X_n] : p(a) = 0 \text{ for all } a \in U \,\},$$
--   which is an ideal.
--   3. **Algebraic set.** $W \subseteq K^n$ is an algebraic set if $W = \mathrm V(J)$ for some ideal $J$.
--   4. **Irreducible (Zariski topology).** $W \subseteq K^n$ is irreducible if $W \neq \emptyset$ and, whenever $W \subseteq W_1 \cup W_2$ with $W_1, W_2$ algebraic sets, $W \subseteq W_1$ or $W \subseteq W_2$.
--   5. **Ideal of a point.** For $a \in K^n$, $\mathfrak m_a = (X_1 - a_1, \dots, X_n - a_n)$, the ideal generated by the $n$ polynomials $X_i - a_i$.
--
--   These are the objects in terms of which the Nullstellensatz, the correspondence between algebraic sets and radical ideals, and the description of maximal ideals are stated.
--
--   **Formalization Note.** Points are functions $\mathrm{Fin}\, n \to K$. The algebraic sets are exactly the closed sets of the Zariski topology on $K^n$; irreducibility is expressed through that closed-set characterisation instead of through a topology instance. The standing field $K$ in this file is not assumed algebraically closed; the theorems that need it assume it explicitly.
-- source:
--   Wikipedia, article "Hilbert's Nullstellensatz" (snapshot supplied as Hilbert's_Nullstellensatz.pdf, printed 2026-09-27), https://en.wikipedia.org/wiki/Hilbert%27s_Nullstellensatz, section "Formulations", paragraphs 2 and 6 (definitions of V(J), I(U), algebraic set, irreducible, and the ideal (X_1 - a_1, ..., X_n - a_n)).

import Mathlib

namespace Nullstellensatz

open MvPolynomial

variable {K : Type*} [Field K] {n : ℕ}

/-- The algebraic set `V(J) ⊆ Kⁿ`: the common zeros of all polynomials in `J`. -/
def zeroSet (J : Ideal (MvPolynomial (Fin n) K)) : Set (Fin n → K) :=
  {a | ∀ f ∈ J, eval a f = 0}

/-- The vanishing ideal `I(U)`: all polynomials vanishing at every point of `U`. -/
def vanishingIdeal (U : Set (Fin n → K)) : Ideal (MvPolynomial (Fin n) K) where
  carrier := {p | ∀ a ∈ U, eval a p = 0}
  zero_mem' := by simp
  add_mem' := by
    intro p q hp hq a ha
    simp [hp a ha, hq a ha]
  smul_mem' := by
    intro c p hp a ha
    simp [hp a ha]

/-- `W ⊆ Kⁿ` is an algebraic set: `W = V(J)` for some ideal `J`. -/
def IsAlgebraicSet (W : Set (Fin n → K)) : Prop :=
  ∃ J : Ideal (MvPolynomial (Fin n) K), W = zeroSet J

/-- `W` is irreducible in the Zariski topology: it is nonempty and whenever it is covered by
two algebraic sets (Zariski-closed sets), it is contained in one of them. -/
def IsZariskiIrreducible (W : Set (Fin n → K)) : Prop :=
  W.Nonempty ∧ ∀ W₁ W₂ : Set (Fin n → K), IsAlgebraicSet W₁ → IsAlgebraicSet W₂ →
    W ⊆ W₁ ∪ W₂ → W ⊆ W₁ ∨ W ⊆ W₂

/-- The ideal `(X₁ - a₁, …, Xₙ - aₙ)` of the point `a ∈ Kⁿ`. -/
noncomputable def pointIdeal (a : Fin n → K) : Ideal (MvPolynomial (Fin n) K) :=
  Ideal.span (Set.range fun i => X i - C (a i))

end Nullstellensatz


