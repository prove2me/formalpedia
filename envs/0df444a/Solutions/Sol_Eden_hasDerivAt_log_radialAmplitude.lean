theorem _root_.solution {t s : ℝ} (ht : 0 ≤ t) (hs : 0 ≤ s) :
    HasDerivAt (fun τ => Real.log (radialAmplitude τ s))
      (radialRate (squaredRadiusEvolution t s)) t := by
