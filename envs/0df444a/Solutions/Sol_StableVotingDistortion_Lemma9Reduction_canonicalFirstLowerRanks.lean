theorem solution {p q : ℝ} (hp : p ∈ Icc (16/25:ℝ) (99/100)) (hq : q ∈ Icc (0:ℝ) ((703/2500):ℝ)) : q+PaperMiddle.canonical score p*deltaP score p q ≤ PaperCurve.lam := by
  have hqa : q ∈ Icc (0:ℝ) PaperCurve.lam := ⟨hq.1,hq.2.trans (by norm_num [PaperCurve.lam,PaperCurve.lamQ])⟩
  apply base_canonical hp hqa
  obtain ⟨tree,ht⟩ := rangeCover
  rw [fastRectTest_eq] at ht
  apply rect_cover_sound tree _ _ ht
  · simpa only [Bounds.Holds, Set.mem_Icc, Rat.cast_div, Rat.cast_ofNat] using hp
  · simpa only [Bounds.Holds, Set.mem_Icc, Rat.cast_zero, Rat.cast_div, Rat.cast_ofNat, PaperCurve.lam, PaperCurve.lamQ] using hq
