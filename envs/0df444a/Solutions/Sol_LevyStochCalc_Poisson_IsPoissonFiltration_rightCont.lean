/-!
# Poisson random measures with respect to a filtration

`IsPoissonFiltration N ℱ` says that the counts of the Poisson random measure `N` on regions
of the past `(-∞, t] × E` are `ℱ t`-measurable and that, for `0 ≤ s`, the σ-algebra `ℱ s` is
independent of the σ-algebra generated by the counts on *all* measurable regions of the future
`(s, ∞) × E`. Independence of `ℱ s` from the count on a single strip `(s, t] × A` of finite
intensity is the special case `IsPoissonFiltration.indep`. The natural filtration of `N` is an
instance, a smaller filtration to which `N` is adapted is one, and so is the right-continuous
version `ℱ₊`: for a finite family of future regions `D`, the counts `N(D ∩ ((r, ∞) × E))` are
jointly independent of `ℱ r ⊇ ℱ₊ s` and increase to `N(D)` as `r ↓ s`.
-/

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

namespace LevyStochCalc.Poisson

universe u v

variable {Ω : Type u} [MeasurableSpace Ω] {E : Type v} [MeasurableSpace E]
  {P : Measure Ω} [IsProbabilityMeasure P] {ν : Measure E} [SigmaFinite ν]

theorem _root_.solution {N : PoissonRandomMeasure P ν}
    {ℱ : Filtration ℝ ‹MeasurableSpace Ω›} (h : IsPoissonFiltration N ℱ) :
    IsPoissonFiltration N ℱ.rightCont := by
  refine ⟨fun t B hB hBm => (h.measurable hB hBm).mono (ℱ.le_rightCont t) le_rfl, ?_⟩
  intro s hs
  set G : ℝ → MeasurableSpace Ω := fun r =>
    ⨆ D ∈ {D : Set (ℝ × E) | D ⊆ Set.Ioi r ×ˢ Set.univ ∧ MeasurableSet D},
      MeasurableSpace.comap (fun ω => N.N ω D) inferInstance with hG
  set r : ℕ → ℝ := fun n => s + 1 / ((n : ℝ) + 1) with hr
  have hr_gt : ∀ n, s < r n := by
    intro n
    have : (0:ℝ) < 1 / ((n:ℝ) + 1) := by positivity
    simp only [r]
    linarith
  have hr_anti : Antitone r := by
    intro m n hmn
    simp only [r]
    have : (m : ℝ) + 1 ≤ (n : ℝ) + 1 := by exact_mod_cast Nat.add_le_add_right hmn 1
    have := one_div_le_one_div_of_le (by positivity) this
    linarith
  have hGmono : Monotone fun n => G (r n) := by
    intro m n hmn
    refine iSup₂_le fun D hD => le_iSup₂_of_le D ⟨hD.1.trans (Set.prod_mono
      (Set.Ioi_subset_Ioi (hr_anti hmn)) le_rfl), hD.2⟩ le_rfl
  have hGle : ∀ r', G r' ≤ ‹MeasurableSpace Ω› := fun r' =>
    iSup₂_le fun D hD => (N.measurable_eval hD.2).comap_le
  have hRle : ℱ.rightCont s ≤ ℱ (r 0) := by
    rw [Filtration.rightCont_eq]
    exact iInf₂_le (r 0) (hr_gt 0)
  have hind : ∀ n, Indep (G (r n)) (ℱ.rightCont s) P := by
    intro n
    have h1 := h.indep_future (hs.trans (hr_gt n).le)
    have h2 : ℱ.rightCont s ≤ ℱ (r n) := by
      rw [Filtration.rightCont_eq]
      exact iInf₂_le (r n) (hr_gt n)
    exact (indep_of_indep_of_le_left h1 h2).symm
  have hsup := indep_iSup_of_directed_le hind (fun n => hGle _) (ℱ.rightCont.le s)
    hGmono.directed_le
  refine (indep_of_indep_of_le_left hsup ?_).symm
  refine iSup₂_le fun D hD => ?_
  have hDn : ∀ n, MeasurableSet (D ∩ Set.Ioi (r n) ×ˢ Set.univ) := fun n =>
    hD.2.inter (measurableSet_Ioi.prod MeasurableSet.univ)
  have hmeas : ∀ n, Measurable[⨆ n, G (r n)] fun ω => N.N ω (D ∩ Set.Ioi (r n) ×ˢ Set.univ) := by
    intro n
    refine Measurable.mono ?_ (le_iSup (fun n => G (r n)) n) le_rfl
    refine (measurable_iff_comap_le (m₁ := G (r n))).2 ?_
    exact le_iSup₂_of_le (D ∩ Set.Ioi (r n) ×ˢ Set.univ) ⟨Set.inter_subset_right, hDn n⟩ le_rfl
  have hlim : Tendsto (fun n ω => N.N ω (D ∩ Set.Ioi (r n) ×ˢ Set.univ)) atTop
      (𝓝 fun ω => N.N ω D) := by
    rw [tendsto_pi_nhds]
    intro ω
    have hmono : Monotone fun n => D ∩ Set.Ioi (r n) ×ˢ Set.univ := by
      intro m n hmn x hx
      exact ⟨hx.1, ⟨lt_of_le_of_lt (hr_anti hmn) hx.2.1, trivial⟩⟩
    have hU : (⋃ n, D ∩ Set.Ioi (r n) ×ˢ Set.univ) = D := by
      ext x
      simp only [Set.mem_iUnion, Set.mem_inter_iff, Set.mem_prod, Set.mem_Ioi, Set.mem_univ,
        and_true]
      constructor
      · rintro ⟨n, hx, _⟩; exact hx
      · intro hx
        have hxs : s < x.1 := (hD.1 hx).1
        obtain ⟨n, hn⟩ := exists_nat_one_div_lt (sub_pos.2 hxs)
        exact ⟨n, hx, by simp only [r]; linarith⟩
    have := tendsto_measure_iUnion_atTop (μ := N.N ω) hmono
    rw [hU] at this
    exact this
  have hm : Measurable[⨆ n, G (r n)] (fun ω => N.N ω D) :=
    @measurable_of_tendsto_metrizable Ω ℝ≥0∞ (⨆ n, G (r n)) _ _ _ _ _ _ hmeas hlim
  exact hm.comap_le

end LevyStochCalc.Poisson
