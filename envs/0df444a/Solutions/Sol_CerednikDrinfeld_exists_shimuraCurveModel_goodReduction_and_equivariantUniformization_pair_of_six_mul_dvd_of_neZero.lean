theorem tower_hecke
    {N q q' : ℕ} [NeZero N] {r r' : ℕ} [Fact r.Prime] [Fact r'.Prime] (hrr' : r' ≠ r) (hrN : ¬ r ∣ N) (hr'N : ¬ r' ∣ N)
    (hcover : ∀ ℓ : Nat.Primes, (ℓ : ℕ) = r ∨ (ℓ : ℕ) = r' ∨ ((ℓ : ℕ) ≠ q ∧ (ℓ : ℕ) ≠ q'))
