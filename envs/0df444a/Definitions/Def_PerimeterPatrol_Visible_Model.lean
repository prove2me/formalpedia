-- title:
--   §1–§2.1, pp. 2, 4–5, 7 — the patrol game Γ(λ, t, p): feasible dispatch schedules (1), mixed strategies, adaptive attacks, detection probability, value (2)
-- statement:
--   This file sets up the one-location patrol game $\Gamma(\lambda, t, p)$ of Lin, *Optimal Patrol of a Perimeter*, §1 and §2.1.
--
--   **Parameters.** $\lambda > 0$ is the long-run dispatch rate of patrollers, $t > 0$ the duration of an attack, and $p \in (0, 1]$ the probability that a patroller passing during an attack detects it.
--
--   **Defender.** A *pure strategy* is a dispatch sequence $s_1 \le s_2 \le \cdots$ of times in $[0, \infty)$ at which patrollers pass the location; it is *feasible with rate* $\lambda$ if, writing $N(T) = \#\{n : s_n \le T\}$ for the number of patrollers dispatched by time $T$, condition (1) holds:
--
--   $$\lim_{T \to \infty} \frac{N(T)}{T} = \lambda .$$
--
--   A *mixed strategy* is a probability measure $\mu$ on sequences that is carried by the feasible ones (the infeasible sequences form a $\mu$-null set).
--
--   **Attacker.** For a schedule $s$ and a window $(a, b]$, let $N_s(a, b] = \#\{n : a < s_n \le b\}$ be the number of patrollers passing during it. The observer's information up to time $u$ is the $\sigma$-algebra $\mathcal F_u$ generated by the counts $N(v)$, $v \le u$. An *attack* is a rule $\tau$ assigning to each schedule a start time $\tau(s)$ such that
--
--   1. there is an operating window $[y, z]$ with $0 < y$ and $y \le \tau(s)$, $\tau(s) + t \le z$ for every $s$;
--   2. $\{\tau \le u\} \in \mathcal F_u$ for every $u$: the decision to have started by time $u$ uses only the patrollers seen up to and including time $u$.
--
--   The attack occupies the time interval $(\tau, \tau + t]$.
--
--   **Payoff.** Given the schedule, an attack meeting $N$ patrollers escapes all of them with probability $(1-p)^N$, by independence of the detections. The detection probability of the attack $\tau$ against $\mu$ is therefore
--
--   $$P_{\mathrm{det}}(\mu, \tau) = \int \bigl(1 - (1 - p)^{N_s(\tau(s),\, \tau(s) + t]}\bigr)\, \mu(ds).$$
--
--   The attacker sees only the patrollers going by, never the outcome of a detection, so no detection randomness needs to be modelled beyond this formula.
--
--   **Value (2).** For $c > 0$ put
--
--   $$v(c, p) = 1 - (c - \lfloor c \rfloor)(1 - p)^{\lceil c \rceil} - (1 - c + \lfloor c \rfloor)(1 - p)^{\lfloor c \rfloor},$$
--
--   and $V(\lambda, t, p) = v(\lambda t, p)$, the right-hand side of (2). When $c$ is an integer the two terms combine to $1 - (1-p)^c$.
--
--   **Lemma 1's law.** The two-point law on $\{\lfloor c \rfloor, \lceil c \rceil\}$: the point mass at $c$ if $c$ is an integer; otherwise $P\{N = \lfloor c \rfloor\} = \lceil c \rceil - c$ and $P\{N = \lceil c \rceil\} = c - \lfloor c \rfloor$.
--
--   These objects are shared by every statement of the mission: Lemma 1, the steps of the proof of Theorem 2, and Theorem 2 itself.
--
--   **Formalization Note.** Schedules are maps $s : \mathbb N \to \mathbb R$ (patroller $n+1$ passes at $s(n)$) with the product $\sigma$-algebra. Three conventions are fixed: (i) "increasing" is read as nondecreasing, so two patrollers may pass together (a larger defender class); (ii) the attack window is $(\tau, \tau + t]$ with information up to and including $\tau$, matching "begin an attack immediately after a patroller has just left" (p. 6); (iii) the attacker may observe from time $0$ rather than only from $y$, a larger attacker class, so the defender's guarantee is stronger than the page's and the converse is unaffected. Counts are `Nat.card`, which is $0$ on an infinite set; on feasible schedules every count is finite. Floors and ceilings are `Nat.floor`/`Nat.ceil`, exact for positive arguments.
-- source:
--   Lin, Optimal Patrol of a Perimeter, arXiv:1905.03600v3, pp. 2, 4–7, §1 condition (1), §2.1 game Γ(λ, t, p), Lemma 1, formula (2)

import Mathlib

open MeasureTheory Filter Topology

namespace PerimeterPatrol.Visible

/-- Condition (1), p. 2: a dispatch sequence `s` (patroller `n + 1` passes the location at time
`s n`) is a feasible pure strategy with rate `lam` if it is nondecreasing, starts in the horizon
`[0, ∞)`, and the number of patrollers dispatched by time `T`, divided by `T`, tends to `lam`. -/
def IsFeasible (lam : ℝ) (s : ℕ → ℝ) : Prop :=
  Monotone s ∧ 0 ≤ s 0 ∧
    Tendsto (fun T : ℝ => (Nat.card {n : ℕ | s n ≤ T} : ℝ) / T) atTop (𝓝 lam)

/-- A feasible mixed strategy: a probability measure on dispatch sequences that is carried by the
feasible pure strategies. -/
def IsMixedStrategy (lam : ℝ) (μ : Measure (ℕ → ℝ)) : Prop :=
  IsProbabilityMeasure μ ∧ ∀ᵐ s ∂μ, IsFeasible lam s

/-- The number of patrollers of the schedule `s` that pass during the time window `(a, b]`. -/
noncomputable def arrivals (s : ℕ → ℝ) (a b : ℝ) : ℕ :=
  Nat.card {n : ℕ | a < s n ∧ s n ≤ b}

/-- The information of an observer who has watched the patrollers go by up to and including time
`u`: the σ-algebra generated by the counts `#{n | s n ≤ v}` for `v ≤ u`. -/
noncomputable def observed (u : ℝ) : MeasurableSpace (ℕ → ℝ) :=
  ⨆ (v : ℝ) (_ : v ≤ u), MeasurableSpace.comap (fun s : ℕ → ℝ => Nat.card {n : ℕ | s n ≤ v}) ⊤

/-- An attack of duration `t`: a rule `τ` giving the start time of the attack as a function of the
schedule, such that the attack lies in a fixed operating window `[y, z]` with `0 < y`
(`y ≤ τ ≤ τ + t ≤ z`), and the decision to have started by time `u` depends only on the patrollers
observed up to and including time `u` (a stopping time). The attack occupies `(τ, τ + t]`. -/
def IsAttack (t : ℝ) (τ : (ℕ → ℝ) → ℝ) : Prop :=
  (∃ y z : ℝ, 0 < y ∧ ∀ s, y ≤ τ s ∧ τ s + t ≤ z) ∧
    ∀ u : ℝ, MeasurableSet[observed u] {s | τ s ≤ u}

/-- The detection probability of the attack `τ` (duration `t`) against the mixed strategy `μ` when
each passing patroller detects independently with probability `p`: the expectation over `μ` of
`1 − (1 − p) ^ N`, where `N` is the number of patrollers passing during `(τ, τ + t]`. -/
noncomputable def detectionProb (p t : ℝ) (μ : Measure (ℕ → ℝ)) (τ : (ℕ → ℝ) → ℝ) : ℝ :=
  ∫ s, (1 - (1 - p) ^ arrivals s (τ s) (τ s + t)) ∂μ

/-- The right-hand side of (2) as a function of `c = λt`:
`1 − (c − ⌊c⌋)(1 − p)^⌈c⌉ − (1 − c + ⌊c⌋)(1 − p)^⌊c⌋`. -/
noncomputable def valueC (c p : ℝ) : ℝ :=
  1 - (c - ⌊c⌋₊) * (1 - p) ^ ⌈c⌉₊ - (1 - c + ⌊c⌋₊) * (1 - p) ^ ⌊c⌋₊

/-- The value (2) of the game `Γ(λ, t, p)`: `V(λ, t, p) = valueC (λ t) p`. -/
noncomputable def patrolValue (lam t p : ℝ) : ℝ :=
  valueC (lam * t) p

/-- The law of Lemma 1, as a probability mass function on `ℕ`: if `c` is an integer, the point
mass at `c`; otherwise `P{N = ⌊c⌋} = ⌈c⌉ − c`, `P{N = ⌈c⌉} = c − ⌊c⌋`. -/
noncomputable def twoPoint (c : ℝ) (n : ℕ) : ℝ :=
  if ⌊c⌋₊ = ⌈c⌉₊ then (if n = ⌊c⌋₊ then 1 else 0)
  else if n = ⌊c⌋₊ then (⌈c⌉₊ : ℝ) - c
  else if n = ⌈c⌉₊ then c - ⌊c⌋₊
  else 0

end PerimeterPatrol.Visible


