-- title:
--   p. 250 — the index of a rational simplex is finite, equals |det| of the lifts, and is 1 exactly for integral simplices
-- statement:
--   Let $v_0, \dots, v_n$ be affinely independent rational points of $\Delta_n$. Then the subgroup of $\mathbb{Z}^{n+1}$ generated by their lifts has finite index, this index equals the absolute value of the determinant of the matrix whose columns are the lifts, and it equals $1$ exactly when the simplex with these vertices is an integral subsimplex.
-- source:
--   Cannon, J. W., Floyd, W. J., Parry, W. R., Introductory notes on Richard Thompson's groups, L'Enseignement Mathématique (2) 42 (1996) 215–256, https://doi.org/10.5169/seals-87877, section 7, p. 250, proof of Theorem 7.1

import Mathlib
import Definitions.Def_CannonFloydParry_PIP

namespace CannonFloydParry

theorem ind_ne_zero_and_eq_natAbs_det_and_eq_one_iff {n : ℕ} {v : Fin (n + 1) → Fin (n + 1) → ℝ}
    (hv : ∀ j, IsRationalPoint (v j)) (hind : AffineIndependent ℝ v) :
    ind v ≠ 0 ∧ ind v = (Matrix.of fun i j => lift (v j) i).det.natAbs ∧
      (ind v = 1 ↔ IsIntegralSubsimplex n (convexHull ℝ (Set.range v))) := by
  sorry

end CannonFloydParry
