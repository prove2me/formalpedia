theorem Arb4.H1000.B04_line : ∃ xs : List ℝ, xs.length = 21 ∧ xs.IsChain (· < ·) ∧
    (∀ t ∈ xs, (161 : ℝ) ≤ t ∧ t ≤ (201 : ℝ)) ∧
    (∀ t ∈ xs, completedRiemannZeta (1 / 2 + (t : ℂ) * Complex.I) = 0) := by sorry
