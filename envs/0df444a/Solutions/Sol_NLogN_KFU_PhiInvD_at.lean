  rw [← mod_prefix_eq_sum, Nat.mod_eq_of_lt hk]

/-- **(42)**: if `μ_i P_i ≡ 1 (mod s_i)` then
`μ_i k ≡ a_i + μ_i Σ_{j<i} a_j P_j (mod s_i)`. -/
theorem coord_formula (s : ℕ → ℕ) (μ : ℕ → ℕ) (i k : ℕ)
