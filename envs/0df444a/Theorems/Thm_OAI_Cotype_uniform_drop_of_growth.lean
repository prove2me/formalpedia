open OAI OAI.Cotype

theorem OAI.Cotype.uniform_drop_of_growth (m : ℕ) (hm : 0 < m) (c q : ℝ)
    (hc : 0 < c) (hq0 : 0 < q) (hq1 : q < 1) :
    ∃ n₀ : ℕ, 4*m < n₀ ∧ ∀ w : ℕ → ℝ,
      (∀ n, 0 < w n) → Antitone w →
      (∃ D : ℝ, ∀ n, w n ≤ D*q^n) →
      (∀ n, 4*m < n → w (n-2*m) ≤ 2*w n → c*w n ≤ w (2*(n-2*m))) →
      ∀ n, n₀ ≤ n → 2*w n < w (n-2*m) := by sorry
