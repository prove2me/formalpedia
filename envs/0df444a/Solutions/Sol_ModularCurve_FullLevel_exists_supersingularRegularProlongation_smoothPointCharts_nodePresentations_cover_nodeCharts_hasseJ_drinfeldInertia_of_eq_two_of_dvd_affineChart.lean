                  σ (π l) = algebraMap ↥(𝒩₀ nd l) (AdicCompletion (maximalIdeal ↥(𝒩₀ nd l)) ↥(𝒩₀ nd l)) ⟨_, h⟩) ∧
                (∀ o : Wc l, ι (σ o) = const (π l ^ E l) o) ∧
                (∀ (c : ↥(C' l)) (h : algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (c : AlgebraicClosure ℚ) ∈ 𝒩₀ nd l),
                  ∃ o : Wc l, σ o = algebraMap ↥(𝒩₀ nd l) (AdicCompletion (maximalIdeal ↥(𝒩₀ nd l)) ↥(𝒩₀ nd l)) ⟨_, h⟩) ∧
                (∀ (f : ↥(𝒩₀ nd l)) (n : ℕ) (h₁ : f.1 ∈ (Rx nd).integers), (Rx nd).residue ⟨f.1, h₁⟩ ≠ 0 →
                  (bx nd).ord ((Rx nd).residue ⟨f.1, h₁⟩) = (n : ℤ) →
                    ∃ γ : UVCrossingModel (Wc l) (π l ^ E l), IsUnit γ ∧
                      ι (algebraMap ↥(𝒩₀ nd l) (AdicCompletion (maximalIdeal ↥(𝒩₀ nd l)) ↥(𝒩₀ nd l)) f) - γ * V (π l ^ E l) ^ n ∈
                        Ideal.span {const (π l ^ E l) (π l), U (π l ^ E l)}) ∧
                (∀ (f : ↥(𝒩₀ nd l)) (n : ℕ) (h₂ : f.1 ∈ R.integers), R.residue ⟨f.1, h₂⟩ ≠ 0 →
                  nd.ord (R.residue ⟨f.1, h₂⟩) = (n : ℤ) →
                    ∃ γ : UVCrossingModel (Wc l) (π l ^ E l), IsUnit γ ∧
                      ι (algebraMap ↥(𝒩₀ nd l) (AdicCompletion (maximalIdeal ↥(𝒩₀ nd l)) ↥(𝒩₀ nd l)) f) - γ * U (π l ^ E l) ^ n ∈
                        Ideal.span {const (π l ^ E l) (π l), V (π l ^ E l)}))) ∧

          (∀ nd ∈ N', ∀ nd' ∈ N', ∀ P, P ∈ S nd → P ∈ S nd' → nd = nd') ∧

          (∀ nd ∈ N', ∀ P ∈ S nd, ∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
            (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
              0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
                coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
                ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
            (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
              ∀ a : A, residue A a =
                  (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
                ∃ h : P.evalAt (IntermediateField.inclusion hle f : fieldBar q M') - (a : AlgebraicClosure ℚ) ∈ A,
                  (⟨_, h⟩ : A) ∈ maximalIdeal A) ∧

          (∀ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' → ∃ τN : Place (ResidueField A) FSS → Place (ResidueField A) FSS,
            ∀ nd ∈ N', τN nd ∈ N' ∧
              (∀ P : Place (AlgebraicClosure ℚ) (fieldBar q M'), (levelAutBar q M' ζ' γ) • P ∈ S nd ↔ P ∈ S (τN nd)) ∧
              ((Rx nd).integers).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = (Rx (τN nd)).integers) ∧

          (∀ τ ∈ Subgroup.closure {τ : (fieldBar q M') ≃ₐ[AlgebraicClosure ℚ] (fieldBar q M') |
                ∃ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' ∧ τ = levelAutBar q M' ζ' γ},
            ∀ (hτ : ∀ f : fieldBar q M', τ f ∈ R.integers ↔ f ∈ R.integers), ∀ nd ∈ N',
              R.resAut τ hτ • nd ∈ N' ∧
              AlgebraicCurve.RegularProlongation.smulDisc τ (S nd) = S (R.resAut τ hτ • nd)) ∧

          (∀ nd ∈ N', ∀ f : ↥(modularFunctionFieldBar M'), f ∈ R₀.integers →
            (IntermediateField.inclusion hle f : ↥(fieldBar q M')) ∈ (Rx nd).integers) ∧

          (∀ nd ∈ N', ∃ j : modularFunctionFieldC (ResidueField A) M' →+* FIx nd,
            (∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
              ∃ hC : (IntermediateField.inclusion hle f : fieldBar q M') ∈ (Rx nd).integers,
                (Rx nd).residue ⟨_, hC⟩ = j (R₀.residue ⟨f, hf⟩)) ∧
            ∀ g : modularFunctionFieldC (ResidueField A) M',
              g ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring ↔
                j g ∈ (bx nd).toValuationSubring) ∧

          (∃ (hJK : ModularCurve.jqNModC (AlgebraicClosure ℚ) q ∈ fieldBar q M') (a₀ : AlgebraicClosure ℚ) (ha₀ : a₀ ∈ A)
             (hR : (⟨ModularCurve.jqNModC (AlgebraicClosure ℚ) q, hJK⟩ : ↥(fieldBar q M')) -
                algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') a₀ ∈ R.integers),
            R.residue ⟨_, hR⟩ = 0 ∧
            (IsLocalRing.residue ↥A ⟨a₀, ha₀⟩) ^ q = (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (jGeomGen (ResidueField ↥A) M') ∧
            ∃ (c' : AlgebraicClosure ℚ) (htc : c' • ((⟨ModularCurve.jqNModC (AlgebraicClosure ℚ) q, hJK⟩ : ↥(fieldBar q M')) -
                algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') a₀) ∈ R.integers),
              R.residue ⟨_, htc⟩ ≠ 0 ∧
              ∀ nd ∈ N', ∃ hC : ((⟨ModularCurve.jqNModC (AlgebraicClosure ℚ) q, hJK⟩ : ↥(fieldBar q M')) -
                algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') a₀) ∈ (Rx nd).integers,
                (Rx nd).residue ⟨_, hC⟩ ≠ 0 ∧
                nd.ord (R.residue ⟨_, htc⟩) = -((bx nd).ord ((Rx nd).residue ⟨_, hC⟩))) ∧

          (∀ x ∈ N', ∀ y : Place (ResidueField A) FSS, y ∉ N' →
                ∃ (g : ↥(fieldBar q M')) (hg : g ∈ R.integers) (hg₀ : g ∈ 𝒩₀ x l₀),
                  ¬ IsUnit (⟨g, hg₀⟩ : ↥(𝒩₀ x l₀)) ∧
                  y.ord (R.residue ⟨g, hg⟩) = 0 ∧ R.residue ⟨g, hg⟩ ≠ 0 ∧
                  ∀ P : Place (AlgebraicClosure ℚ) ↥(fieldBar q M'), P.IsRational →
                    0 ≤ P.ord (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
                coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
                ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) → g ∈ P.toValuationSubring) ∧

          (∀ x ∈ N', ∀ x' ∈ N', x ≠ x' →
                ∃ (g : ↥(fieldBar q M')) (hgx : g ∈ 𝒩₀ x l₀) (hcx : cx x ∈ 𝒩₀ x l₀) (hgx' : g ∈ 𝒩₀ x' l₀),
                  (∃ u : (↥(𝒩₀ x l₀))ˣ, (⟨g, hgx⟩ : ↥(𝒩₀ x l₀)) = ⟨cx x, hcx⟩ * (u : ↥(𝒩₀ x l₀))) ∧
                  IsUnit (⟨g, hgx'⟩ : ↥(𝒩₀ x' l₀))) ∧

          (∀ P : Place (AlgebraicClosure ℚ) ↥(fieldBar q M'), P.IsRational →
                (∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
                  (∀ P' : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
                    0 ≤ P'.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
                      coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
                      ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P'.ord (f : ↥(modularFunctionFieldBar M'))) →
                  (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
                      (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
                    ∀ a : A, IsLocalRing.residue A a =
                        (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
                      ∃ h : P.evalAt (IntermediateField.inclusion hle f : fieldBar q M') - (a : AlgebraicClosure ℚ) ∈ A,
                        (⟨_, h⟩ : A) ∈ IsLocalRing.maximalIdeal A) →
            (∃ nd, nd ∈ N' ∧ P ∈ S nd) ∨
            (∃ Q : Place (ResidueField A) FSS, Q ∉ N' ∧
              ∃ (D : Set (Place (AlgebraicClosure ℚ) ↥(fieldBar q M'))) (z : ↥(fieldBar q M')), R.IsResidueDisc Q D z ∧ P ∈ D)) := by
  classical

  obtain ⟨k₀, π₀, hπ, hdvr₀, hunif₀, hhens₀, hres₀, hκ₀, hstab₀, htame₀, ℓ, hℓ, hℓ3, hℓq, hℓM', ζ₀, hζ₀, ϖt, hϖtA, hϖt⟩ :=
    ValuationSubring.exists_admissible_smallConstants_tameFixed_of_eq_two q hq2 M' hqM' A hA

  let ι : Type := {K : IntermediateField ↥k₀ (AlgebraicClosure ℚ) // FiniteDimensional ↥k₀ ↥K}
  let K : ι → IntermediateField ↥k₀ (AlgebraicClosure ℚ) := fun n => n.1
  have hKfin : ∀ n, FiniteDimensional ↥k₀ ↥(K n) := fun n => n.2
  let An : ∀ n, ValuationSubring ↥(K n) := fun n => A.comap (algebraMap ↥(K n) (AlgebraicClosure ℚ))
  have hAn : ∀ n (x : ↥(K n)), x ∈ An n ↔ (x : AlgebraicClosure ℚ) ∈ A := fun n x => Iff.rfl
  let n₀ : ι := ⟨⊥, inferInstance⟩
  have hn₀ : ∀ n, K n₀ ≤ K n := fun n => bot_le
  have hKcof : ∀ T : Finset (AlgebraicClosure ℚ), ∃ n : ι, ∀ x ∈ T, x ∈ Set.range (fun y : ↥(K n) => (y : AlgebraicClosure ℚ)) := by
    intro T
    haveI : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.isAlgebraic ℚ
    haveI : Algebra.IsAlgebraic ↥k₀ (AlgebraicClosure ℚ) := Algebra.IsAlgebraic.tower_top (K := ℚ) ↥k₀
    refine ⟨⟨IntermediateField.adjoin ↥k₀ (T : Set (AlgebraicClosure ℚ)), ?_⟩, ?_⟩
    · exact IntermediateField.finiteDimensional_adjoin (fun x _ => (Algebra.IsAlgebraic.isAlgebraic x).isIntegral)
    · intro x hx
      exact ⟨⟨x, IntermediateField.subset_adjoin ↥k₀ (T : Set (AlgebraicClosure ℚ)) hx⟩, rfl⟩
  have htame : ∀ τ ∈ A.inertiaSubgroupIn ℚ, A.tameCharacter πt τ = 1 →
      ∀ x : ↥(K n₀), τ (x : AlgebraicClosure ℚ) = (x : AlgebraicClosure ℚ) := by
    intro τ hτ h1 x
    obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp x.2
    rw [← hc]
    exact htame₀ πt hπt hπA τ hτ h1 c

  obtain ⟨F₀, W₀, hK1, hK2a, hK2b, hK2c, hK3, hK4, hK5, hS, hNode⟩ :=
    ModularCurve.FullLevel.exists_klevel_supersingularDVR_smoothPointPackages_nodePresentations_nodeCharts_hasseJ_drinfeldInertia_of_eq_two_of_dvd_affineChart q hq2 M' hqM' ℓg hℓg hℓg12 hℓgM' A hA W hW hle R₀ hR₀ s
      k₀ π₀ hπ hdvr₀ hunif₀ hhens₀ hres₀ hκ₀ ℓ hℓ hℓ3 hℓq hℓM' ζ₀ hζ₀ ϖt hϖtA hϖt K hKfin An hAn n₀ hn₀ hKcof πt hπt hπA htame hstab₀

  haveI hQalg : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.isAlgebraic ℚ
  haveI halg : Algebra.IsAlgebraic ↥k₀ ↥(Lbar q M' k₀) := by
    haveI : Algebra.IsAlgebraic ↥k₀ (AlgebraicClosure ℚ) := Algebra.IsAlgebraic.tower_top (K := ℚ) ↥k₀
    exact (eL q M' k₀).isAlgebraic
  have hkL : ∀ c : ↥k₀, algebraMap ↥k₀ ↥(Lbar q M' k₀) c = eL q M' k₀ (c : AlgebraicClosure ℚ) := fun c =>
    ((eL q M' k₀).commutes c).symm
  have hcomapEq : A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)) = (AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀)) := by
    ext x
    show (x : AlgebraicClosure ℚ) ∈ A ↔ algebraMap ↥k₀ ↥(Lbar q M' k₀) x ∈ AL q M' k₀ A
    rw [hkL, eL_mem_AL]
  obtain ⟨hπ', hunif'⟩ : ∃ hπ' : π₀ ∈ (AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀)),
      maximalIdeal ↥((AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀))) = Ideal.span {⟨π₀, hπ'⟩} :=
    hcomapEq ▸ (⟨hπ, hunif₀⟩ : ∃ hπ' : π₀ ∈ A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)),
      maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) = Ideal.span {⟨π₀, hπ'⟩})
  have hdvr' : IsDiscreteValuationRing ↥((AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀))) := hcomapEq ▸ hdvr₀
  have hhens' : HenselianLocalRing ↥((AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀))) := hcomapEq ▸ hhens₀
  have hres' : IsAlgClosed (ResidueField ↥((AL q M' k₀ A).comap (algebraMap ↥k₀ ↥(Lbar q M' k₀)))) := hcomapEq ▸ hres₀
  obtain ⟨hint, htower⟩ :=
    @ValuationSubring.isIntegral_and_exists_totallyRamified_layers_of_henselian ↥k₀ (FB q M') _ _ _ _ (Lbar q M' k₀)
      halg (AL q M' k₀ A) π₀ hπ' hdvr' hunif' hhens' hres'

  have hgen : Lbar q M' k₀ ⊔ F₀ = ⊤ := by
    have : Lbar q M' k₀ = IntermediateField.adjoin ↥k₀ (Set.range (algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M'))) := by
      apply le_antisymm
      · intro x hx
        obtain ⟨y, rfl⟩ := (AlgHom.mem_fieldRange).mp hx
        exact IntermediateField.subset_adjoin ↥k₀ _ ⟨y, rfl⟩
      · exact IntermediateField.adjoin_le_iff.mpr fun x ⟨y, hy⟩ => (AlgHom.mem_fieldRange).mpr ⟨y, hy⟩
    rw [this]; exact hK1
  have hagree : ∀ x : ↥k₀, algebraMap ↥k₀ ↥(Lbar q M' k₀) x ∈ AL q M' k₀ A ↔ algebraMap ↥k₀ ↥F₀ x ∈ W₀ := by
    intro x; rw [hkL, eL_mem_AL]; exact hK2a x
  obtain ⟨hπW, hunifW⟩ := hK2c
  obtain ⟨O, hOA, hOF₀, hOres, hOsm⟩ :=
    ValuationSubring.exists_constantsTower_of_totallyRamified_of_isIntegral ↥k₀ (FB q M') (Lbar q M' k₀) F₀ hgen
      (AL q M' k₀ A) W₀ hagree hK2b π₀ hπW hunifW hint htower

  have hOA' : ∀ x : AlgebraicClosure ℚ, algebraMap (AlgebraicClosure ℚ) (fieldBar q M') x ∈ O ↔ x ∈ A := by
    intro x
    rw [← eL_mem_AL q M' k₀ A x, ← hOA]
    rfl
  have hsm' : ∀ f : ↥(fieldBar q M'), f ≠ 0 →
      ∃ c : AlgebraicClosure ℚ, ∃ h : c • f ∈ O, IsUnit (⟨c • f, h⟩ : O) := by
    intro f hf
    obtain ⟨c, hc0, h, hu⟩ := hOsm f hf
    have hc : ((eL q M' k₀).symm c) • f = (c : FB q M') * f := by
      rw [Algebra.smul_def]
      congr 1
      have := eL_apply q M' k₀ ((eL q M' k₀).symm c)
      rw [AlgEquiv.apply_symm_apply] at this
      exact this.symm
    refine ⟨(eL q M' k₀).symm c, ?_, ?_⟩
    · rw [hc]; exact h
    · convert hu using 2
  have htr' : ∃ t : O, ∀ p : Polynomial A,
      Polynomial.eval₂ (B2PackV.toW A O hOA') t p ∈ maximalIdeal O → ∀ n, p.coeff n ∈ maximalIdeal A := by
    classical
    obtain ⟨t₀, ht₀⟩ := hK3

    have hkF : ∀ c : ↥k₀, ((algebraMap ↥k₀ ↥F₀ c : ↥F₀) : FB q M') =
        algebraMap (AlgebraicClosure ℚ) (FB q M') (c : AlgebraicClosure ℚ) := fun c => rfl
    have hkL : ∀ c : ↥k₀, algebraMap ↥k₀ ↥(Lbar q M' k₀) c = eL q M' k₀ (c : AlgebraicClosure ℚ) := by
      intro c; exact ((eL q M' k₀).commutes c).symm
    have hkA : ∀ c : ↥k₀, algebraMap ↥k₀ ↥(Lbar q M' k₀) c ∈ AL q M' k₀ A ↔ (c : AlgebraicClosure ℚ) ∈ A := by
      intro c; rw [hkL, eL_mem_AL]

    have hW₀O : ∀ x : ↥W₀, ((x : ↥F₀) : FB q M') ∈ O := fun x => (hOF₀ x).mpr x.2
    have hmaxW₀ : ∀ x : ↥W₀, (⟨_, hW₀O x⟩ : O) ∈ maximalIdeal O → x ∈ maximalIdeal ↥W₀ := by
      intro x hx
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu; apply hx
      obtain ⟨y, hy⟩ := isUnit_iff_exists_inv.mp hu
      refine isUnit_iff_exists_inv.mpr ⟨⟨_, hW₀O y⟩, Subtype.ext ?_⟩
      have := congrArg (fun z : ↥W₀ => ((z : ↥F₀) : FB q M')) hy
      simpa using this
    have hmaxA : ∀ c : ↥k₀, (c : AlgebraicClosure ℚ) ∈ A →
        (∃ hc : algebraMap ↥k₀ ↥F₀ c ∈ W₀, (⟨_, hc⟩ : ↥W₀) ∈ maximalIdeal ↥W₀) →
        ∃ hA : (c : AlgebraicClosure ℚ) ∈ A, (⟨_, hA⟩ : A) ∈ maximalIdeal A := by
      intro c hcA ⟨hc, hm⟩
      refine ⟨hcA, ?_⟩
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm ⊢
      intro hu; apply hm
      obtain ⟨y, hy⟩ := isUnit_iff_exists_inv.mp hu
      have hy' : (c : AlgebraicClosure ℚ) * (y : AlgebraicClosure ℚ) = 1 := by
        have := congrArg Subtype.val hy; simpa using this
      have hc0 : (c : AlgebraicClosure ℚ) ≠ 0 := left_ne_zero_of_mul_eq_one hy'
      have hyinv : ((y : A) : AlgebraicClosure ℚ) = (c : AlgebraicClosure ℚ)⁻¹ := eq_inv_of_mul_eq_one_right hy'

      have hcinvA : ((c⁻¹ : ↥k₀) : AlgebraicClosure ℚ) ∈ A := by
        have e1 : ((c⁻¹ : ↥k₀) : AlgebraicClosure ℚ) = (c : AlgebraicClosure ℚ)⁻¹ := rfl
        rw [e1, ← hyinv]; exact y.2
      have hcinvW : algebraMap ↥k₀ ↥F₀ c⁻¹ ∈ W₀ := (hagree c⁻¹).mp ((hkA c⁻¹).mpr hcinvA)
      have hc0' : (c : ↥k₀) ≠ 0 := fun h => hc0 (by rw [h]; rfl)
      refine isUnit_iff_exists_inv.mpr ⟨⟨_, hcinvW⟩, Subtype.ext ?_⟩
      change (algebraMap ↥k₀ ↥F₀ c : ↥F₀) * algebraMap ↥k₀ ↥F₀ c⁻¹ = 1
      rw [← map_mul, mul_inv_cancel₀ hc0', map_one]
    refine ⟨⟨_, hW₀O t₀⟩, fun p hp n => ?_⟩

    choose c hcA hcd hcm using fun m => hκ₀ (p.coeff m : AlgebraicClosure ℚ) (p.coeff m).2
    let p₀ : Polynomial ↥k₀ := ∑ m ∈ p.support, Polynomial.C (c m) * Polynomial.X ^ m
    have hp₀coeff : ∀ m, p₀.coeff m = if m ∈ p.support then c m else 0 := by
      intro m
      simp only [p₀, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow]
      exact Finset.sum_ite_eq p.support m c
    have hcoefA : ∀ m, algebraMap ↥k₀ ↥(Lbar q M' k₀) (p₀.coeff m) ∈ AL q M' k₀ A := by
      intro m; rw [hkA, hp₀coeff]; split_ifs
      · exact hcA m
      · simp [A.zero_mem]
    have hcoefW : ∀ m, algebraMap ↥k₀ ↥F₀ (p₀.coeff m) ∈ W₀ := fun m => (hagree _).mp (hcoefA m)
    have haevalW : Polynomial.aeval (t₀ : ↥F₀) p₀ ∈ W₀ := by
      rw [Polynomial.aeval_eq_sum_range]
      refine Subring.sum_mem _ fun m _ => ?_
      rw [Algebra.smul_def]
      exact mul_mem (hcoefW m) (pow_mem t₀.2 m)

