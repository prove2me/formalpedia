variable {N : ℕ} {S : Set ℕ} {r : ℕ}

theorem gen_not_dvd (hr : r.Prime) (g : Gen N r S) : ¬ g.ℓ ∣ N * r := by
  intro h
  rcases (Nat.Prime.dvd_mul g.prime).mp h with hN | hR
  · exact g.not_dvd hN
  · exact g.ne ((Nat.prime_dvd_prime_iff_eq g.prime hr).mp hR)

theorem gen_coprime (hr : r.Prime) (g : Gen N r S) : Nat.Coprime g.ℓ r :=
  (Nat.coprime_primes g.prime hr).mpr g.ne

end Level

end RNewSol

