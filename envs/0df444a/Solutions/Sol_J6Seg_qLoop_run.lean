theorem tUnload_sp (s : IState HS) (F : Fin HS → List ℤ) (z tq u acc ci cq cr T : List ℤ)
    (B : ℕ) (hTB : Bnd B T) (hlB : zsz (T.length : ℤ) ≤ B) :
    Sp (tUnload ρ dT) (encK s (KS ρ dT F z T tq u [] [(T.length : ℤ)] acc ci cq cr))
      (encK s (KS ρ dT F z [] tq (T.reverse ++ u) [] [] acc ci cq cr)) (cTab B T.length) := by
  have S1 := Sp.mvK (Ne.symm (hR.neT 15)) (Ne.symm (hR.neT 18))
    (hR.ne (by decide : (15 : Fin 19) ≠ 18)) hR.Tlt (hR.lt 15) (hR.lt 18) s
    (KS ρ dT F z T tq u [] [(T.length : ℤ)] acc ci cq cr) (.reg (ρ 16)) (clean_reg (hR.lt 16))
    (ok_reg (KS_atRl hR ..)) T [] (by rw [KS_atT hR, List.append_nil])
    (by rw [eval_reg (KS_atRl hR ..)]) B hTB trivial (bnd_reg (KS_atRl hR ..) hlB)
  rw [KS_atU hR, KS_dt hR, KS_u hR] at S1
  have S2 := Sp.pop s (KS ρ dT F z [] tq (T.reverse ++ u) [] [(T.length : ℤ)] acc ci cq cr)
    (i := ρ 16) (a := (T.length : ℤ)) (l := []) (B := B) (hR.lt 16) (KS_atRl hR ..) hlB
  rw [KS_rl hR] at S2
  refine (S1.seq S2).mono ?_
  simp only [cTab, Ex.size]
  ring_nf; omega

end tab

/-! ## The row loop -/

theorem gflat_length (y : List GI) : (gflat y).length = 2 * y.length := by
  induction y with
  | nil => rfl
  | cons a y ih => simp only [gflat, List.flatMap_cons, List.length_append] at ih ⊢; simp [ih]; ring

section rows
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e : Fin Pp}
  {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} (hR : RegOK ρ dT dF)
  {tabOf : ℕ → List ℤ} {Pre : List GI → Prop} {g : ℕ → List GI → List GI} {Ck : ℝ}
  (hRow : RowBody6 Isym tbl e dT tabOf Pre g Ck)
include hR hRow

theorem rowB_run (q m B : ℕ) (s : IState HS) (F : Fin HS → List ℤ) (x : List GI)
    (z tq u rl acc ci cq cr : List ℤ) (hm2 : F (ρ 7) = [((2 * m : ℕ) : ℤ)])
    (hmB : zsz ((2 * m : ℕ) : ℤ) ≤ B) (hpre : Pre x) (hlen : (g q x).length = m)
    (hgb : Bnd B (gflat (g q x))) :
    IRuns Isym tbl (rowB ρ e)
      (encK s (KS ρ dT F (gflat x ++ z) (tabOf q) tq u [] rl acc ci cq cr))
      (encK s (KS ρ dT F z (tabOf q) tq u [] rl ((gflat (g q x)).reverse ++ acc) ci cq cr))
      (⌊Ck⌋₊ + 2 + 30000 * (B + 2) * (m + 1)) := by
  obtain ⟨c, hc, hck⟩ := row_call hRow hR.T0 q s
    (KS ρ dT F (gflat x ++ z) (tabOf q) tq u [] rl acc ci cq cr) x z (KS_atT hR ..)
    (KS_at0 hR ..) hpre
  rw [KS_z hR] at hc
  have hfl : (gflat (g q x)).length = 2 * m := by rw [gflat_length, hlen]
  have hm7 : KS ρ dT F (gflat (g q x) ++ z) (tabOf q) tq u [] rl acc ci cq cr (ρ 7) =
      [((2 * m : ℕ) : ℤ)] := by rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 7 (by decide), hm2]
  have S := Sp.mvK (Ne.symm (hR.ne0 17)) (Ne.symm (hR.ne0 18))
    (hR.ne (by decide : (17 : Fin 19) ≠ 18)) (by decide) (hR.lt 17) (hR.lt 18) s
    (KS ρ dT F (gflat (g q x) ++ z) (tabOf q) tq u [] rl acc ci cq cr) (.reg (ρ 7))
    (clean_reg (hR.lt 7)) (ok_reg hm7) (gflat (g q x)) z (KS_at0 hR ..)
    (by rw [eval_reg hm7, hfl]) B hgb trivial (bnd_reg hm7 hmB)
  rw [KS_atAcc hR, KS_z hR, KS_acc hR] at S
  have hck' : c ≤ ⌊Ck⌋₊ := Nat.le_floor hck
  refine (hc.seq S.toIRuns).mono ?_
  rw [hfl]; simp only [Ex.size]; ring_nf; omega

/-- **The rows of one block**, on an abstract row stream `zA` / `xr` / `aA`. -/
theorem rows_run (q m post B r0 : ℕ) (hB : 1 ≤ B) (s : IState HS) (F : Fin HS → List ℤ)
    (tq u rl ci cq : List ℤ) (zA aA : ℕ → List ℤ) (xr : ℕ → List GI)
    (hm2 : F (ρ 7) = [((2 * m : ℕ) : ℤ)]) (hmB : zsz ((2 * m : ℕ) : ℤ) ≤ B)
    (hp : F (ρ 4) = [(post : ℤ)]) (hpB : zsz (post : ℤ) ≤ B)
    (hz : ∀ c < post, zA (r0 + c) = gflat (xr (r0 + c)) ++ zA (r0 + c + 1))
    (hpre : ∀ c < post, Pre (xr (r0 + c)))
    (hlen : ∀ c < post, (g q (xr (r0 + c))).length = m)
    (hgb : ∀ c < post, Bnd B (gflat (g q (xr (r0 + c)))))
    (ha : ∀ c < post, aA (r0 + c + 1) = (gflat (g q (xr (r0 + c)))).reverse ++ aA (r0 + c)) :
    IRuns Isym tbl (rowsL ρ e)
      (encK s (KS ρ dT F (zA r0) (tabOf q) tq u [] rl (aA r0) ci cq []))
      (encK s (KS ρ dT F (zA (r0 + post)) (tabOf q) tq u [] rl (aA (r0 + post)) ci cq []))
      (cRows ⌊Ck⌋₊ B m post) := by
  have hp' : KS ρ dT F (zA r0) (tabOf q) tq u [] rl (aA r0) ci cq [] (ρ 4) = [(post : ℤ)] := by
    rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 4 (by decide), hp]
  have H := IRuns.irep (I := Isym) (iprog := tbl) (C := ρ 13) (n := .reg (ρ 4))
    (body := rowB ρ e) (s := s)
    (F := fun c => KS ρ dT F (zA (r0 + c)) (tabOf q) tq u [] rl (aA (r0 + c)) ci cq [])
    (N := post) (B := B) (c := ⌊Ck⌋₊ + 2 + 30000 * (B + 2) * (m + 1)) hB (hR.lt 13)
    (fun k => KS_atCr hR ..) (clean_reg (hR.lt 4)) (ok_reg hp') trivial (bnd_reg hp' hpB)
    (eval_reg hp') (by
      intro k hk
      simp only [KS_cr hR]
      have := rowB_run hR hRow q m B s F (xr (r0 + k)) (zA (r0 + k + 1)) tq u rl (aA (r0 + k))
        ci cq [(post : ℤ) - k] hm2 hmB (hpre k hk) (hlen k hk) (hgb k hk)
      rw [← hz k hk, ← ha k hk] at this
      simpa only [Nat.add_assoc] using this)
  simp only [Nat.add_zero] at H
  refine H.mono ?_
  have h1 : 2 + 30000 * (B + 2) * (m + 1) + 8000 * (B + 2) + 30 ≤ 40000 * (B + 2) * (m + 1) := by
    ring_nf; omega
  have h2 := Nat.mul_le_mul_left post h1
  simp only [cRows, Ex.size]; ring_nf at h2 ⊢; omega

end rows

end J6Seg

end

section
-- Source module: Solutions.J6SegILKer3
/-!
# B-line IL, B2 (kernel-pass wrapper) §3: the block loops

`segT tabOf q = |tabOf q| :: tabOf q`; the table store holds `tabsT tabOf nc ++ R0`
(`tabsT = ⋃_{q < nc} segT q`).

* `qLoop_run`: for one outer index `i`, the loop over the chunks `q < nc`: load table `q`, run the
  `post` rows of block `i·nc + q` (kernel `g q`), unload; the store is consumed and `U` (`ρ 15`)
  collects the used tables, reversed.
* `iLoop_run`: the loop over `i < pre`: the chunk loop, then the store is restored from `U`.

The rows come from an abstract stream (`RowStream`): row `r` is `xr r`, on top of stack `0`
before it is `zA r`, the outputs so far are `aA r` (reversed), the kernel of row `r` is
`g (r / post % nc)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

theorem blk_idx {i j c nc post : ℕ} (hj : j < nc) (hc : c < post) :
    ((i * nc + j) * post + c) / post % nc = j := by
  have hp : 0 < post := by omega
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt hc, zero_add,
    Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hj]

theorem row_lt {i j c nc post pre : ℕ} (hi : i < pre) (hj : j < nc) (hc : c < post) :
    (i * nc + j) * post + c < pre * nc * post := by
  have h1 : i * nc + j + 1 ≤ pre * nc := by
    have : (i + 1) * nc ≤ pre * nc := Nat.mul_le_mul_right _ hi
    rw [Nat.succ_mul] at this; omega
  have h2 : (i * nc + j + 1) * post ≤ pre * nc * post := Nat.mul_le_mul_right _ h1
  rw [Nat.succ_mul] at h2; omega

theorem tq_step (tabOf : ℕ → List ℤ) (R0 : List ℤ) {j nc : ℕ} (hj : j < nc) :
    (List.range' j (nc - j)).flatMap (segT tabOf) ++ R0 =
      ((tabOf j).length : ℤ) :: (tabOf j ++
        ((List.range' (j + 1) (nc - (j + 1))).flatMap (segT tabOf) ++ R0)) := by
  rw [show nc - j = (nc - (j + 1)) + 1 by omega, List.range'_succ]
  simp [segT]

theorem u_step (tabOf : ℕ → List ℤ) (j : ℕ) :
    (tabOf j).reverse ++ ((tabOf j).length : ℤ) ::
        ((List.range j).flatMap (segT tabOf)).reverse =
      ((List.range (j + 1)).flatMap (segT tabOf)).reverse := by
  rw [List.range_succ, List.flatMap_append, List.reverse_append]
  simp [segT]

section loops
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e : Fin Pp}
  {ρ : Fin 19 → Fin HS} {dT dF : Fin HS} (hR : RegOK ρ dT dF)
  {tabOf : ℕ → List ℤ} {Pre : List GI → Prop} {g : ℕ → List GI → List GI} {Ck : ℝ}
  (hRow : RowBody6 Isym tbl e dT tabOf Pre g Ck)
include hR hRow

theorem qLoop_run_sol_aux (i m post nc pre B Lmax : ℕ) (hB : 1 ≤ B) (hi : i < pre)
    (s : IState HS) (F : Fin HS → List ℤ) (R0 ci : List ℤ) (zA aA : ℕ → List ℤ)
    (xr : ℕ → List GI)
    (hS : RowStream Pre g B m post nc (pre * nc * post) zA aA xr)
    (hm2 : F (ρ 7) = [((2 * m : ℕ) : ℤ)]) (hmB : zsz ((2 * m : ℕ) : ℤ) ≤ B)
    (hp : F (ρ 4) = [(post : ℤ)]) (hpB : zsz (post : ℤ) ≤ B)
    (hn : F (ρ 6) = [(nc : ℤ)]) (hnB : zsz (nc : ℤ) ≤ B)
    (hTB : ∀ q < nc, Bnd B (tabOf q)) (hTL : ∀ q < nc, (tabOf q).length ≤ Lmax)
    (hLB : zsz (Lmax : ℤ) ≤ B) :
    IRuns Isym tbl (qLoop ρ dT e)
      (encK s (KS ρ dT F (zA (i * nc * post)) [] (tabsT tabOf nc ++ R0) [] [] []
        (aA (i * nc * post)) ci [] []))
      (encK s (KS ρ dT F (zA ((i + 1) * nc * post)) [] R0 (tabsT tabOf nc).reverse [] []
        (aA ((i + 1) * nc * post)) ci [] []))
      ((1 + 1) * 2000 * (B + 2) + nc * (cQb ⌊Ck⌋₊ B m post Lmax + 8000 * (B + 2) + 30) +
        (2 * B + 32)) := by
  set tqA : ℕ → List ℤ := fun j => (List.range' j (nc - j)).flatMap (segT tabOf) ++ R0
    with htqA
  set uA : ℕ → List ℤ := fun j => ((List.range j).flatMap (segT tabOf)).reverse with huA
  have hn' : KS ρ dT F (zA ((i * nc + 0) * post)) [] (tqA 0) (uA 0) [] []
      (aA ((i * nc + 0) * post)) ci [] [] (ρ 6) = [(nc : ℤ)] := by
    rw [KS_in hR _ _ _ _ _ _ _ _ _ _ _ 6 (by decide), hn]
  have H := IRuns.irep (I := Isym) (iprog := tbl) (C := ρ 12) (n := .reg (ρ 6))
    (body := qBody ρ dT e) (s := s)
    (F := fun j => KS ρ dT F (zA ((i * nc + j) * post)) [] (tqA j) (uA j) [] []
      (aA ((i * nc + j) * post)) ci [] [])
    (N := nc) (B := B) (c := cQb ⌊Ck⌋₊ B m post Lmax) hB (hR.lt 12)
    (fun k => KS_atCq hR ..) (clean_reg (hR.lt 6)) (ok_reg hn') trivial (bnd_reg hn' hnB)
    (eval_reg hn') (by
      intro j hj
      simp only [KS_cq hR]
      have hlen := hTL j hj
      have hlB : zsz ((tabOf j).length : ℤ) ≤ B := le_trans (zsz_nat_le hlen) hLB
      have e1 : tqA j = ((tabOf j).length : ℤ) :: (tabOf j ++ tqA (j + 1)) := tq_step tabOf R0 hj
      rw [e1]
      have S1 := tLoad_sp hR s F (zA ((i * nc + j) * post)) (uA j) (aA ((i * nc + j) * post)) ci
        [(nc : ℤ) - j] [] (tabOf j) (tqA (j + 1)) B (hTB j hj) hlB
      have S2 := rows_run hR hRow j m post B ((i * nc + j) * post) hB s F (tqA (j + 1))
        (((tabOf j).length : ℤ) :: uA j) [((tabOf j).length : ℤ)] ci [(nc : ℤ) - j] zA aA xr
        hm2 hmB hp hpB
        (fun c hc => by
          have hr := row_lt hi hj hc
          exact (hS _ hr).1)
        (fun c hc => by
          have hr := row_lt hi hj hc
          exact (hS _ hr).2.1)
        (fun c hc => by
          have hr := row_lt hi hj hc
          have := (hS _ hr).2.2.1; rwa [blk_idx hj hc] at this)
        (fun c hc => by
          have hr := row_lt hi hj hc
          have := (hS _ hr).2.2.2.1; rwa [blk_idx hj hc] at this)
        (fun c hc => by
          have hr := row_lt hi hj hc
          have := (hS _ hr).2.2.2.2; rwa [blk_idx hj hc] at this)
      have S3 := tUnload_sp hR s F (zA ((i * nc + j) * post + post)) (tqA (j + 1))
        (((tabOf j).length : ℤ) :: uA j) (aA ((i * nc + j) * post + post)) ci [(nc : ℤ) - j] []
        (tabOf j) B (hTB j hj) hlB
      have e2 : (i * nc + j) * post + post = (i * nc + (j + 1)) * post := by ring
      rw [u_step tabOf j, e2] at S3
      rw [e2] at S2
      have hc : cTab B (tabOf j).length ≤ cTab B Lmax := by
        unfold cTab; exact Nat.mul_le_mul_left _ (by omega)
      refine (S1.toIRuns.seq (S2.seq S3.toIRuns)).mono ?_
      unfold cQb; omega)
  have e0 : tqA 0 = tabsT tabOf nc ++ R0 := by
    simp only [htqA, Nat.sub_zero, tabsT, ← List.range_eq_range']
  have eN : tqA nc = R0 := by simp [htqA]
  have u0 : uA 0 = [] := by simp [huA]
  have uN : uA nc = (tabsT tabOf nc).reverse := rfl
  simp only [Nat.add_zero, e0, eN, u0, uN] at H
  rw [show (i * nc + nc) * post = (i + 1) * nc * post by ring] at H
  exact H

end loops

end J6Seg

end

theorem solution : type_of% @J6Seg.qLoop_run_sol_aux := @J6Seg.qLoop_run_sol_aux
