theorem sigmaQConv_eq_qpow_mul (q : ℂ) (m : ℕ) :
    sigmaQConv q m = q^m *
      (∑ ab ∈ Finset.HasAntidiagonal.antidiagonal m,
        ((QseriesFormalization.PartI.Ch04Franklin.pentagonalSign ab.1 : ℤ) : ℂ) *
