/-!
# KFM 14: the exact side of the error chain

The exact maps of §9.4–9.7 as `LinC` / `BilC` instances, and the identities `chain_close` needs.

* `avg_le`: a normalized sum of terms of modulus `≤ C` has modulus `≤ C`.
* **`linC_clm`** (CLMs of norm `≤ 1`), **`linC_RF`** (`R F_s`), **`linC_QF`** (`Q F_t`).
* `mrX t f g`: the normalized ring convolution on the box `∏_{i ≤ D} ℤ/t_i`: cyclic on the first
  `D` axes, negacyclic on the last (coefficient) axis, divided by `T = ∏ t_i`; **`bilC_mrX`**.
* **`mc_exact`**: twisting the last coordinate by `ζ^k` (`ζ^{t_D} = -1`) turns `mrX` into the
  normalized cyclic convolution `(f ∗ g)/T` (§9.4, pointwise form of `RTw.MC_eq`).
* **`chirp_exact`**: `ā · ((a ∗ (ā · x))/T) = Q F_t x` (Lemma 21, (36)).
* **`final_exact`**: `2^{2b+4} S · (S · conj RF_s(conj(RF_s u · RF_s v))) = ū ∗ v̄` (`pipeline_exact`).
* **`chain_concrete`**: `chain_close` with all exact maps instantiated (Lemma 19/20 witnesses
  `tensCLM (kerA M.A)`, `tensCLM (kerB M.B)`); only the computed procedures remain as hypotheses.
-/

namespace NLogN.KFM

open Complex IntMul.OpenAI.RT IntMul.OpenAI.RC

noncomputable section

/-! ## Averages -/

lemma avg_le {β : Type*} [Fintype β] [Nonempty β] (z : β → ℂ) {C : ℝ} (hz : ∀ k, ‖z k‖ ≤ C) :
    ‖((Fintype.card β : ℂ))⁻¹ * ∑ k, z k‖ ≤ C := by
  have hc : (0 : ℝ) < Fintype.card β := by exact_mod_cast Fintype.card_pos
  rw [norm_mul, norm_inv, Complex.norm_natCast]
  have hs : ‖∑ k, z k‖ ≤ Fintype.card β * C := by
    refine (norm_sum_le _ _).trans ?_
    calc ∑ k, ‖z k‖ ≤ ∑ _k : β, C := Finset.sum_le_sum fun k _ => hz k
      _ = _ := by simp
  calc (Fintype.card β : ℝ)⁻¹ * ‖∑ k, z k‖ ≤ (Fintype.card β : ℝ)⁻¹ * (Fintype.card β * C) :=
        mul_le_mul_of_nonneg_left hs (by positivity)
    _ = C := by field_simp

lemma linC_clm {ι κ : Type*} [Fintype ι] [Fintype κ]
    (L : (κ → ℂ) →L[ℂ] (ι → ℂ)) (h : ‖L‖ ≤ 1) : LinC (fun u => L u) :=
  ⟨fun a b => (map_sub L a b).symm, fun a => (L.le_opNorm a).trans (by
    nlinarith [norm_nonneg a])⟩

variable {d : ℕ}

lemma norm_prod_char (s : Fin d → ℕ) [∀ i, NeZero (s i)] (f : (i : Fin d) → ZMod (s i)) :
    ‖∏ i, (ZMod.stdAddChar (f i) : ℂ)‖ = 1 := by
  rw [norm_prod]; exact Finset.prod_eq_one fun i _ => IntMul.OpenAI.RH.norm_stdAddChar _

lemma card_box (s : Fin d → ℕ) [∀ i, NeZero (s i)] :
    ((Fintype.card ((i : Fin d) → ZMod (s i)) : ℕ) : ℂ) = ∏ i, (s i : ℂ) := card_pi_eq s

/-- `Q F_t` is a linear contraction. -/
theorem linC_QF (s t : Fin d → ℕ) [∀ i, NeZero (t i)] :
    LinC (fun x => Qperm s t (dftM t x)) := by
  refine ⟨fun a b => ?_, fun u => ?_⟩
  · funext k
    simp only [Qperm, dftM, Pi.sub_apply, ← mul_sub, ← Finset.sum_sub_distrib]
  · refine pi_le (norm_nonneg _) fun k => ?_
    simp only [Qperm, dftM]
    rw [← card_box t]
    refine avg_le _ fun j => ?_
    rw [norm_mul, norm_prod_char]
    rw [one_mul]; exact norm_le_pi_norm u j

/-! ## The twisted ring convolution -/

