theorem call_of_run (body : Fragment) (s : State ℚ) (m : Memory ℚ) (bound H : ℕ)
    (hpc : s.pc=0) (hout : s.output=none)
    (h : body.Run (fun q => ratBits q ≤ H) s.memory bound m) :
