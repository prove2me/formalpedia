      ≤ cCk P n src k ap := by
    intro q
    have hds := descsOf_ok (s := axs6 src k) (t := t) hl1
      (TT Q (axR6 P n) (axs6 src k) t (axα6 P n)) q
    have hs := sumN_descsOf (s := axs6 src k) (t := t) hl1
      (TT Q (axR6 P n) (axs6 src k) t (axα6 P n)) q
    have := cKer2_le (pk := pk) (b := b) (lam := lam) (φD := mulSup (2 * cBI P n src k ap))
      (B := cBI P n src k ap) (BH := cBH P n src k ap) (J := cJ P n) (Z := cZ P n src k ap)
      (Φ := cPhi P n src k ap) (φT := fun m => mulSup (2 * (b * (2 * m) + 2)))
      (descsOf (axs6 src k) t lam (TT Q (axR6 P n) (axs6 src k) t (axα6 P n)) q)
      (fun d hd => by
        obtain ⟨h1, h2, h3, h4, -, -⟩ := hds d hd
        refine ⟨h1, h2, h3, ?_, ?_, ?_⟩
        · apply Nat.clog_le_of_le_pow
          have := (zsz_le_iff (z := (((2 * lam + 1 : ℕ)) : ℤ)) (m := cJ P n)).1 le_rfl
          simp only [Int.natAbs_natCast] at this
          omega
        · exact zszN_mono (show b * (2 * d.1) ≤ b * (2 * lam) + 1 by
            have : b * (2 * d.1) ≤ b * (2 * lam) := Nat.mul_le_mul_left _ (by omega)
            omega)
        · exact phiT_le hb1 h4)
      hs
