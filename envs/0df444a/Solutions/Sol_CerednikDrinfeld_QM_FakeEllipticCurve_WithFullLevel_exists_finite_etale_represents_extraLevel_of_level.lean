  simp only [locEnd, Set.preimage_compl, Transfer.preimage_image_eq hkN]
  congr 2
  ext x
  simp only [Set.mem_preimage, Set.mem_diff]
  show _ ↔ (kN.base x ∈ U ∧ ¬ (KerOps.endK L₂ n a₂ ha₂ hh₂ ≫ kN).base x ∈ U)
  rw [← Transfer.kN_endK ψ L₁ L₂ kA n kN hkN hkNι a₁ ha₁ hh₁ a₂ ha₂ hh₂ hcomp]
  rfl

