-- title:
--   §3–§4.1, pp. 8868–8873 — parameters, fake-account price, following cost, follower counts (8)–(12), platform profit (6), thresholds d₁, d₂, regime map
-- statement:
--   The model of Huang and Liu (§3–§4, pp. 8868–8873). A platform chooses an **antifake effort** $d\ge 0$; an influencer of type $t\in\{H,L\}$ (type $H$ with probability $\rho$) has content quality $q_t$, with $q_H>q_L$; a fraction $l$ of consumers is informed (knows the type) and the rest are uninformed.
--
--   **Parameters.** $\mu>0$ (advertising revenue per real consumer), shares $\lambda_i,\lambda_p\in(0,1)$ of the influencer and the platform with $\lambda_i+\lambda_p<1$, $\rho\in(0,1)$, $l\in(0,1)$, $0<q_L<q_H$, costs $c_0,c_1\ge 0$, technology level $\tau\in[0,1)$, base price $p_0$ of fake accounts, effort-cost coefficient $\gamma>0$.
--
--   1. Fake-account price (1) and following cost (2):
--   $$p_f=p_0+\frac{d}{1-\tau},\qquad c=c_0+c_1(1-\tau)d.$$
--   2. Informed (8) and uninformed (9) followers, where $\bar q$ is the expected quality conditional on the observed signal:
--   $$n^t_{in}=l\Big(1-\frac{c}{q_t}\Big),\qquad n_{un}(\bar q)=(1-l)\Big(1-\frac{c}{\bar q}\Big).$$
--   3. On the equilibrium path the posterior $\Pr(H\mid n_2^t)$ is $\rho$ for both types under **pooling** (Lemma 1) and $1$ for the $H$-type, $0$ for the $L$-type under either **separating** equilibrium (Lemmas 2–3); $E[q\mid n_2^t]=\Pr(H\mid n_2^t)q_H+\Pr(L\mid n_2^t)q_L$. With $E[q]=\rho q_H+(1-\rho)q_L$ the pooling value is $E[q]$.
--   4. Real followers (10) $n^t_{r,ia}=n^t_{in}+n^t_{un}$; the uninformed advertiser's expectation (11) $E[n_{r,ua}]=\Pr(H\mid n)n^H_{r,ia}+\Pr(L\mid n)n^L_{r,ia}$; real followers paid for from the $t$-type's perspective (12) $E[n^t_r]=l\,n^t_{r,ia}+(1-l)E[n_{r,ua}]$; and $E[n_r]=\rho E[n^H_r]+(1-\rho)E[n^L_r]$.
--   5. The platform's profit (6) under equilibrium type $r\in\{\text{pool},\text{csep},\text{nsep}\}$:
--   $$\pi^r_p(d)=\lambda_p\mu E[n_r]-\frac{\gamma}{2}d^2.$$
--   6. Thresholds (13), (16): $\eta_1=\lambda_i\mu(1-l)\Big[\dfrac{q_H(E[q]-q_L)}{lE[q](q_H-q_L)}+\rho\Big]$, $d_1=(1-\tau)(\eta_1-p_0)$, $\eta_2=\frac1l\lambda_i\mu(1-l^2)$, $d_2=(1-\tau)(\eta_2-p_0)$.
--   7. The equilibrium type induced by $d$ (Proposition 1): pooling if $d_1>0$ and $d\le d_1$; otherwise costly separating if $d\le d_2$; otherwise naturally separating. The platform's equilibrium profit is $\pi_p(d)=\pi^{r(d)}_p(d)$.
--
--   These objects are the shared vocabulary of every statement of the mission.
--
--   **Formalization Note** The parameters are fields of a structure with ASCII names (`lamI`, `lamP`, `mu`, …); `Standing` collects the ranges of §3 and Table 1, read as: $\rho\in(0,1)$ (both types occur), $l\in(0,1)$ ($\eta_1,\eta_2$ divide by $l$), $q_L>0$, $c_0,c_1\ge 0$, $\mu>0$; $p_0$ is unconstrained. Assumptions 1 and 2 (p. 8870) depend on $d$ and are not imposed; the follower formulas are used untruncated, as in the paper. Assumption 3 ($p_0<\eta_2$) is not part of `Standing`; it is a separate hypothesis where used. The regime map is Proposition 1 taken as a definition: the belief systems and the undefeated refinement behind it are in the Online Appendix and are not formalized. Expectations over types are the closed forms (8)–(12); no probability space is introduced. The two separating profits coincide as functions (real followers depend only on the information revealed); the three regimes are kept because Lemmas 7 and 8 name all three.
-- source:
--   Huang and Liu, Economics of Social Media Fake Accounts, Management Science 71(10), 2025, pp. 8868–8873, §3 (1), (2), (6), §4.1 (8)–(12), Lemmas 1–3, (13), (16), Proposition 1

import Mathlib

namespace FakeAccounts.Platform

/-- §3 and Table 1 (pp. 8868–8870): the model parameters. -/
structure Params where
  /-- μ: advertising revenue generated by one real consumer. -/
  mu : ℝ
  /-- λ_i: the influencer's share of the advertising revenue. -/
  lamI : ℝ
  /-- λ_p: the platform's share of the advertising revenue. -/
  lamP : ℝ
  /-- ρ: the probability that the influencer is the H-type. -/
  rho : ℝ
  /-- l: social media literacy, the fraction of informed consumers. -/
  l : ℝ
  /-- q_H: content quality of the H-type. -/
  qH : ℝ
  /-- q_L: content quality of the L-type. -/
  qL : ℝ
  /-- c₀: base cost of following. -/
  c0 : ℝ
  /-- c₁: nuisance-cost coefficient of the antifake effort. -/
  c1 : ℝ
  /-- τ: antifake technology level. -/
  tau : ℝ
  /-- p₀: base price of fake accounts. -/
  p0 : ℝ
  /-- γ: cost coefficient of the platform's antifake effort. -/
  gamma : ℝ

/-- Standing parameter ranges of §3 / Table 1. -/
structure Standing (P : Params) : Prop where
  mu_pos : 0 < P.mu
  lamI_pos : 0 < P.lamI
  lamP_pos : 0 < P.lamP
  lamA_pos : P.lamI + P.lamP < 1
  rho_pos : 0 < P.rho
  rho_lt_one : P.rho < 1
  l_pos : 0 < P.l
  l_lt_one : P.l < 1
  qL_pos : 0 < P.qL
  qL_lt_qH : P.qL < P.qH
  c0_nonneg : 0 ≤ P.c0
  c1_nonneg : 0 ≤ P.c1
  tau_nonneg : 0 ≤ P.tau
  tau_lt_one : P.tau < 1
  gamma_pos : 0 < P.gamma

/-- (1): unit price of fake accounts, p_f = p₀ + d/(1 − τ). -/
noncomputable def price (P : Params) (d : ℝ) : ℝ := P.p0 + d / (1 - P.tau)

/-- (2): a consumer's cost of following, c = c₀ + c₁(1 − τ)d. -/
def cost (P : Params) (d : ℝ) : ℝ := P.c0 + P.c1 * (1 - P.tau) * d

/-- (8): informed followers of an influencer of quality q, n_in = l(1 − c/q). -/
noncomputable def nIn (P : Params) (q d : ℝ) : ℝ := P.l * (1 - cost P d / q)

/-- η₂ ≡ (1/l)λ_iμ(1 − l²) (Lemma 2, p. 8872). -/
noncomputable def eta2 (P : Params) : ℝ := (1 / P.l) * P.lamI * P.mu * (1 - P.l ^ 2)

/-- d₂ ≡ (1 − τ)(η₂ − p₀), (16) and (21). -/
noncomputable def d2 (P : Params) : ℝ := (1 - P.tau) * (eta2 P - P.p0)

/-- The influencer's type. -/
inductive InfType
  | H
  | L

/-- Content quality q_t. -/
def qual (P : Params) : InfType → ℝ
  | .H => P.qH
  | .L => P.qL

/-- E[q] = ρ q_H + (1 − ρ) q_L. -/
def meanQ (P : Params) : ℝ := P.rho * P.qH + (1 - P.rho) * P.qL

/-- (9): uninformed followers when the expected quality given the signal is qe,
n_un = (1 − l)(1 − c/qe). -/
noncomputable def nUn (P : Params) (qe d : ℝ) : ℝ := (1 - P.l) * (1 - cost P d / qe)

/-- The three equilibrium types: pooling, costly separating, naturally separating. -/
inductive Regime
  | pool
  | csep
  | nsep

/-- On-path posterior Pr(H | n₂^t): ρ under pooling (Lemma 1), 1 at the H-type's signal and 0 at
the L-type's under either separating equilibrium (Lemmas 2–3). -/
def postH (P : Params) : Regime → InfType → ℝ
  | .pool, _ => P.rho
  | _, .H => 1
  | _, .L => 0

/-- E[q | n₂^t] = Pr(H | n₂^t) q_H + Pr(L | n₂^t) q_L, as in (9). -/
def postQ (P : Params) (r : Regime) (t : InfType) : ℝ :=
  postH P r t * P.qH + (1 - postH P r t) * P.qL

/-- (10): real followers of the t-type, n^t_{r,ia} = n^t_in + n^t_un. -/
noncomputable def nReal (P : Params) (r : Regime) (t : InfType) (d : ℝ) : ℝ :=
  nIn P (qual P t) d + nUn P (postQ P r t) d

/-- (11): the uninformed advertiser's expectation E[n_{r,ua}], with Pr(H | n) = Pr(H | n₂^t)
on the equilibrium path. -/
noncomputable def nUa (P : Params) (r : Regime) (t : InfType) (d : ℝ) : ℝ :=
  postH P r t * nReal P r .H d + (1 - postH P r t) * nReal P r .L d

/-- (12): real followers the advertiser pays for, from the t-type's perspective,
E[n^t_r] = l n^t_{r,ia} + (1 − l) E[n_{r,ua}]. -/
noncomputable def nPay (P : Params) (r : Regime) (t : InfType) (d : ℝ) : ℝ :=
  P.l * nReal P r t d + (1 - P.l) * nUa P r t d

/-- E[n_r]: the expectation of (12) over the type drawn by nature (H with probability ρ). -/
noncomputable def expReal (P : Params) (r : Regime) (d : ℝ) : ℝ :=
  P.rho * nPay P r .H d + (1 - P.rho) * nPay P r .L d

/-- (6): the platform's profit under equilibrium type r, π_p^r(d) = λ_p μ E[n_r] − (γ/2)d². -/
noncomputable def profit (P : Params) (r : Regime) (d : ℝ) : ℝ :=
  P.lamP * P.mu * expReal P r d - P.gamma / 2 * d ^ 2

/-- η₁ ≡ λ_iμ(1 − l)[q_H(E[q] − q_L)/(l E[q](q_H − q_L)) + ρ], (13). -/
noncomputable def eta1 (P : Params) : ℝ :=
  P.lamI * P.mu * (1 - P.l) *
    (P.qH * (meanQ P - P.qL) / (P.l * meanQ P * (P.qH - P.qL)) + P.rho)

/-- d₁ ≡ (1 − τ)(η₁ − p₀), (13). -/
noncomputable def d1 (P : Params) : ℝ := (1 - P.tau) * (eta1 P - P.p0)

/-- Proposition 1 (p. 8873), taken as a definition: the globally undefeated equilibrium type at
effort d. Pooling iff d₁ > 0 and d ≤ d₁; otherwise costly separating iff d ≤ d₂; otherwise
naturally separating. -/
noncomputable def eqRegime (P : Params) (d : ℝ) : Regime :=
  if 0 < d1 P ∧ d ≤ d1 P then .pool else if d ≤ d2 P then .csep else .nsep

/-- The platform's profit in the equilibrium its effort d induces. -/
noncomputable def eqProfit (P : Params) (d : ℝ) : ℝ := profit P (eqRegime P d) d

end FakeAccounts.Platform


