theorem remSum_succ (D : ℕ → Bool) (Gv : ℕ → ℕ → ℕ) (t g : ℕ) :
    ((Light.Filter2.remSum D Gv t (g + 1) : ℕ) : ℤ) = (Light.Filter2.remSum D Gv t g : ℤ) + (1 - Light.Filter2.bitB (D g)) * (Gv t g : ℤ) := by
  unfold Light.Filter2.remSum
  rw [Finset.sum_range_succ]
  cases D g <;> simp

theorem remSum_le (D : ℕ → Bool) {Gv : ℕ → ℕ → ℕ} {vmax t : ℕ} (g : ℕ)
    (hG : ∀ g' < g, Gv t g' ≤ vmax) : Light.Filter2.remSum D Gv t g ≤ g * vmax := by
  unfold Light.Filter2.remSum
  calc _ ≤ ∑ g' ∈ Finset.range g, vmax := Finset.sum_le_sum fun g' hg' => by
        split_ifs
        · exact Nat.zero_le _
        · exact hG g' (Finset.mem_range.1 hg')
    _ = g * vmax := by simp

