  have B1 := NLogN.KFY.rs_all M _ u u1 _ a1
  have Hall := NLogN.GL.seq_all _ _ u u1 _ _ _ B1 B2
  refine ⟨Hall.1, Hall.2.1, le_trans Hall.2.2 ?_⟩
