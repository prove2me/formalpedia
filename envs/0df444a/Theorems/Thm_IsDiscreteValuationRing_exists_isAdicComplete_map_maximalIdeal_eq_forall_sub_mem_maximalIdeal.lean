-- title:
--   Existence of a residually trivial complete DVR extension
-- statement:
--   Let $A$ be a commutative ring which is a domain and a discrete valuation ring, with maximal ideal $\mathfrak m_A$. The assertion is the existence of a type $W$ in the same universe, equipped with a commutative ring structure for which $W$ is a domain, a discrete valuation ring, and adically complete with respect to its maximal ideal $\mathfrak m_W$ (i.e. the canonical map to the $\mathfrak m_W$-adic completion is both separated and surjective in the sense of Mathlib's `IsAdicComplete`), together with a ring homomorphism $\sigma\colon A \to W$ which is a local homomorphism (the preimage of a non-unit is a non-unit), such that two conditions hold: first, the ideal of $W$ generated by $\sigma(\mathfrak m_A)$ is exactly $\mathfrak m_W$, so that $\sigma$ is unramified in the sense that a uniformiser of $A$ maps to a uniformiser of $W$; second, for every $w \in W$ there is $a \in A$ with $w - \sigma(a) \in \mathfrak m_W$, i.e. $\sigma$ induces a surjection, hence an isomorphism, of residue fields $A/\mathfrak m_A \to W/\mathfrak m_W$. The statement is purely existential: no characterisation of $W$ as a completion of $A$ is asserted.
--
--   This is the statement that every discrete valuation ring embeds residually trivially and unramifiedly into a complete discrete valuation ring, namely its own adic completion. It is used in the construction of coefficient rings for the modular-curve layer constructions, where one needs to reduce to a complete base without changing the residue field.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsDiscreteValuationRing_exists_isAdicComplete_map_maximalIdeal_eq_forall_sub_mem_maximalIdeal.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

theorem IsDiscreteValuationRing.exists_isAdicComplete_map_maximalIdeal_eq_forall_sub_mem_maximalIdeal
    (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] :
    ∃ (W : Type u) (_ : CommRing W) (_ : IsDomain W) (_ : IsDiscreteValuationRing W)
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal W) W) (σ : A →+* W) (_ : IsLocalHom σ),
      Ideal.map σ (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal W ∧
      ∀ w : W, ∃ a : A, w - σ a ∈ IsLocalRing.maximalIdeal W := by sorry
