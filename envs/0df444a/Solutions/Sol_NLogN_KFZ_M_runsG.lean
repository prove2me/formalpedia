section Setter

variable {s : IState HS} {F : Fin HS → List ℤ} {B : ℕ}

theorem setter (l : List (Fin HS × Ex HS))
    (hl : ∀ q ∈ l, q.1.val < 56 ∧ q.2.Clean ∧ q.2.size ≤ 30 ∧ q.2.ok (encK s F) ∧
      q.2.Bnd (encK s F) B ∧ ∀ q' ∈ l, q'.1 ∉ q.2.regs)
    (vs : List (Fin HS × ℤ)) (hvs : l.map (fun q => (q.1, q.2.eval (encK s F))) = vs) :
    Sp (pushes l) (encK s F) (encK s (pushF F vs)) (l.length * (31 * 10 ^ 7 * (B + 2) ^ 2) + 1) ∧
    Sp (popsL (l.map Prod.fst)) (encK s (pushF F vs)) (encK s F) (l.length * (2 * B + 2) + 1) := by
  constructor
  · rw [← hvs]; exact pushes_sp s B 30 l F hl
  · have e1 : l.map Prod.fst = vs.map Prod.fst := by rw [← hvs, List.map_map]; rfl
    have e2 : l.length = vs.length := by rw [← hvs, List.length_map]
    rw [e1, e2]
    refine popsL_sp s B vs F (fun q hq => ?_)
    rw [← hvs] at hq
    obtain ⟨q0, hq0, rfl⟩ := List.mem_map.1 hq
    obtain ⟨a1, -, -, -, a5, -⟩ := hl q0 hq0
    exact ⟨a1, Ex.zsz_eval_le _ B _ a5⟩

variable {p h d σ K : ℕ} (hR : Regs F p h d σ K) (hB : RB p h d σ K B)
include hR hB

theorem Regs.s18 :
    let vs : List (Fin HS × ℤ) := [(zD, (d : ℤ)), (zDp, ((d - σ : ℕ) : ℤ)), (zR, 2 ^ (h + 1)),
      (zK, (K : ℤ)), (zEl, ((h + 1 : ℕ) : ℤ)), (zB, ((p / 6 : ℕ) : ℤ))]
    Sp (pushes set18) (encK s F) (encK s (pushF F vs)) (6 * (31 * 10 ^ 7 * (B + 2) ^ 2) + 1) ∧
    Sp (popsL (set18.map Prod.fst)) (encK s (pushF F vs)) (encK s F) (6 * (2 * B + 2) + 1) := by
  intro vs
  obtain ⟨o1, b1, e1⟩ := hR.ev_D (s := s) hB
  obtain ⟨o2, b2, e2⟩ := hR.ev_Dp (s := s) hB
  obtain ⟨o3, b3, e3⟩ := hR.ev_R (s := s) hB
  obtain ⟨o4, b4, e4⟩ := hR.ev_K (s := s) hB
  obtain ⟨o5, b5, e5⟩ := hR.ev_El (s := s) hB
  obtain ⟨o6, b6, e6⟩ := hR.ev_B (s := s) hB
  refine setter set18 (fun q hq => ?_) vs
    (by simp only [set18, List.map, e1, e2, e3, e4, e5, e6, vs])
  simp only [set18, List.mem_cons, List.not_mem_nil, or_false] at hq
  rcases hq with rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o1, b1, by decide⟩
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o2, b2, by decide⟩
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o3, b3, by decide⟩
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o4, b4, by decide⟩
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o5, b5, by decide⟩
  · exact ⟨by decide, clean_of_regs _ (by decide), by decide, o6, b6, by decide⟩

end Setter

