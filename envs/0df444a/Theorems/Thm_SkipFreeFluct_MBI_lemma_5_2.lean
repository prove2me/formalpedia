-- title:
--   Lemma 5.2, p. 14 — Λ is a bijection [0, s₀) → [0, ∞) and 𝔼_x[s^{X_t} 1_{t<ζ}] = Ψ_t(s)^x Φ_t(s)
-- statement:
--   Let $(X,\mathbb P)$ be an MBI with parameters $(\alpha,\mu,p,\beta,\nu,q)$ and let $\pi,\varpi$ be as in Lemma 5.1. Define $\Lambda:[0,s_0)\to[0,\infty)$ by $\Lambda(s)=\int_0^s\frac{du}{\psi(u)}$. Then $\Lambda$ is a bijection, and for $x\in E$, $t\ge0$ and $s\in[0,s_0)$,
--   $$\mathbb E_x\big[s^{X_t}\mathbb 1_{\{t<\zeta\}}\big]=\sum_{y\ge0}P_t(x,y)s^y=\Psi_t(s)^x\,\Phi_t(s),\tag{5.4}$$
--   where
--   $$\Psi_t(s)=\Lambda^{-1}\big(t+\Lambda(s)\big),\qquad \Phi_t(s)=\pi^*[s]\,\varpi^*[\Psi_t(s)].\tag{5.5–5.6}$$
--
--   This closed form of the transition generating function is what turns the resolvent into the integral formulas of Theorem 5.4.
--
--   Differences from the source:
--   - encoding: parameter constraints of p. 12 (α > 0, µ, ν probability measures, µ(0) > 0, µ(1) = 0, p, β, q ≥ 0) → MBIParams.Valid, with HasSum µ 1, HasSum ν 1 and ν(0) = 0; reason: same constraints
--   - encoding: E = ℤ ∩ [0, ∞), states x, y ≥ 0 → Set.Ici (0 : ℤ), with natural-number arguments cast to ℤ; reason: same states
--   - encoding: the Markov chain (X, ℙ) generated by Q (jump chain/holding time definition, p. 2) → transition, resolvent, hitProb, hitBeforeProb, exitDist, killedResolvent computed from jump-chain path sums with Exp(1) holding clocks; reason: this is the paper's construction (i)–(iv); the cemetery ∂ is represented by leaving E
--   - encoding: Ψ_t(s) = Λ⁻¹(t + Λ(s)) → ∀ u ∈ [0, s₀) with Λ(u) = t + Λ(s); reason: with the bijectivity clause this u is exactly Λ⁻¹(t + Λ(s))
--   - encoding: 𝔼_x[s^{X_t} 1_{t<ζ}] → HasSum (y ↦ P_t(x, y) s^y); reason: P_t f(x) = 𝔼_x[f(X_t) 1_{t<ζ}] (p. 3)
--   - encoding: π*[s], ϖ*[Ψ_t(s)] → tsums ∑' k, π(k) s^k and ∑' k, ϖ(k) u^k; reason: the generating functions, convergent by Lemma 5.1
--   - encoding: real-valued transition probabilities P_t(x, y) → ℝ≥0∞-valued transition, compared through .toReal; reason: P_t(x, y) ≤ 1, so .toReal loses nothing
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, p. 14, Lemma 5.2, (5.4)–(5.6)

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
import Definitions.Def_SkipFreeFluct_MBI_Model
open scoped ENNReal Topology
open Filter MeasureTheory

namespace SkipFreeFluct.MBI

/-- Lemma 5.2, p. 14. `Λ(s) = ∫_0^s 1/ψ(u) du` is a bijection `[0, s₀) → [0, ∞)`, and for
`x ∈ E`, `t ≥ 0`, `s ∈ [0, s₀)`, with `Ψ_t(s) = Λ⁻¹(t + Λ(s))` (the unique `u ∈ [0, s₀)` with
`Λ(u) = t + Λ(s)`), the generating function of the MBI is (5.4)–(5.6):
`𝔼_x[s^{X_t} 1_{t < ζ}] = ∑_{y ≥ 0} P_t(x, y) s^y = Ψ_t(s)^x Φ_t(s)` with
`Φ_t(s) = π*[s] ϖ*[Ψ_t(s)]`. -/
theorem lemma_5_2 (P : MBIParams) (hP : P.Valid) :
    Set.BijOn (Lam P) (Set.Ico 0 (s0 P)) (Set.Ici 0) ∧
    ∀ x : ℕ, ∀ t : ℝ, 0 ≤ t → ∀ s ∈ Set.Ico 0 (s0 P), ∀ u ∈ Set.Ico 0 (s0 P),
      Lam P u = t + Lam P s →
        HasSum (fun y : ℕ => (transition (Set.Ici 0) (mbiQ P) t x y).toReal * s ^ y)
          (u ^ x * ((∑' k : ℕ, piSeq P k * s ^ k) * (∑' k : ℕ, varpi P k * u ^ k))) := by sorry

end SkipFreeFluct.MBI
