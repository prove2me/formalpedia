-- name    : ExtraConsensus.Linear.theorem_3_7
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-09T09:15:59.394374+00:00
-- url     : https://prove2.me/theorems/0d52bbe5-b242-4b9c-bbb2-02ce354cfe62
-- title:
--   Theorem 3.7, p. 15 — if 𝐠 is restricted strongly convex and α < 2μ_g λmin(W̃)/L_f², then ‖z^k − z*‖²_G ≥ (1 + δ)‖z^{k+1} − z*‖²_G and ‖x^k − x*‖²_W̃ = O((1+δ)^{−k})
-- statement:
--   Let $n\ge1$ agents on a connected network with mixing matrices $W,\tilde W$ satisfying Assumption 1, local objectives $f_i$ satisfying Assumption 2 with constant $L_{\mathbf f}$, and suppose problem (1.1) has a solution (Assumption 3). Let $U=(\tilde W-W)^{1/2}$, let $\alpha>0$ be the step size, let $x^*$ be a solution of (1.1) and $\mathbf x^*=\mathbf 1(x^*)^{\mathsf T}$, and let $\mathbf q^*=U\mathbf p$ satisfy the optimality conditions $U\mathbf q^*+\alpha\nabla\mathbf f(\mathbf x^*)=0$, $U\mathbf x^*=0$. Let $\mathbf x^k$ be generated by EXTRA from any $\mathbf x^0$, $\mathbf q^k=\sum_{t=0}^kU\mathbf x^t$, $\mathbf z^k=(\mathbf q^k;\mathbf x^k)$, $\mathbf z^*=(\mathbf q^*;\mathbf x^*)$ and $G=\operatorname{diag}(I,\tilde W)$.
--
--   If the penalized function $\mathbf g(\mathbf x)=\mathbf f(\mathbf x)+\frac1{4\alpha}\|\mathbf x\|^2_{\tilde W-W}$ is restricted strongly convex with respect to $\mathbf x^*$ with constant $\mu_{\mathbf g}>0$, and the step size satisfies
--   $$
--   \alpha<\frac{2\mu_{\mathbf g}\lambda_{\min}(\tilde W)}{L_{\mathbf f}^2},
--   $$
--   then there exists $\delta>0$ such that for all $k=0,1,\dots$
--   $$
--   \|\mathbf z^k-\mathbf z^*\|_G^2\ \ge\ (1+\delta)\,\|\mathbf z^{k+1}-\mathbf z^*\|_G^2, \tag{3.22}
--   $$
--   that is, $\|\mathbf z^k-\mathbf z^*\|_G^2$ converges to $0$ Q-linearly at rate $O((1+\delta)^{-k})$; consequently there is a constant $C$ with $\|\mathbf x^k-\mathbf x^*\|_{\tilde W}^2\le C(1+\delta)^{-k}$ for all $k$ (R-linear convergence).
--
--   This is the paper's linear-convergence theorem: with a fixed step size, EXTRA converges linearly to the exact consensual solution, under a restricted strong convexity condition on $\mathbf g$ rather than on the individual $f_i$ (Remark 1).
--
--   **Formalization Note** The step-size condition is stated multiplied out, $\alpha L_{\mathbf f}^2<2\mu_{\mathbf g}\lambda_{\min}(\tilde W)$, so that $L_{\mathbf f}=0$ means "no upper bound" instead of Lean's $x/0=0$; $\lambda_{\min}(\tilde W)$ is pinned by its characterisation. $\alpha>0$ is Algorithm 1's "Choose $\alpha>0$". Restricted strong convexity of $\mathbf g$ is stated for its explicit gradient $\nabla\mathbf f(\mathbf x)+\frac1{2\alpha}(\tilde W-W)\mathbf x$ in the Frobenius inner product. $\delta$ may depend on all data but is chosen before $k$; $C$ may depend on $\mathbf x^0$.
-- source:
--   Shi, Ling, Wu & Yin, arXiv:1404.6264v4, Theorem 3.7, eq. (3.22), p. 15

import Mathlib
import Definitions.Def_ExtraConsensus_Linear_Model

namespace ExtraConsensus.Linear

open Matrix

/-- Shi–Ling–Wu–Yin, arXiv:1404.6264v4, Theorem 3.7, p. 15: under Assumptions 1–3, if
`𝐠(𝐱) = 𝐟(𝐱) + (1/(4α))‖𝐱‖²_{W̃−W}` is restricted strongly convex at `𝐱* = 𝟏(x*)ᵀ` with constant `μ_𝐠 > 0`
and `α < 2μ_𝐠λmin(W̃)/L_𝐟²`, there is `δ > 0` with `‖𝐳ᵏ − 𝐳*‖²_G ≥ (1 + δ)‖𝐳^{k+1} − 𝐳*‖²_G` for all `k`
(3.22), and consequently `‖𝐱ᵏ − 𝐱*‖²_W̃ = O((1 + δ)^{−k})`. -/
theorem theorem_3_7 {n p : ℕ} (hn : 0 < n) (Gr : SimpleGraph (Fin n))
    (W Wt U : Matrix (Fin n) (Fin n) ℝ) (f : Fin n → EuclideanSpace ℝ (Fin p) → ℝ) (Lf α μg : ℝ)
    (hA1 : MixingAssumption Gr W Wt) (hA2 : ExtraConsensus.Sublinear.ConvexLipschitzGrad f Lf) (hA3 : ExtraConsensus.Sublinear.SolutionExists f)
    (hUs : Uᵀ = U) (hUpsd : U.PosSemidef) (hU2 : U * U = Wt - W)
    (lmin : ℝ) (hlmin : ExtraConsensus.Sublinear.IsLamMin Wt lmin)
    (hα0 : 0 < α)
    (xs : EuclideanSpace ℝ (Fin p)) (hsol : ∀ y, ExtraConsensus.Sublinear.fbar f xs ≤ ExtraConsensus.Sublinear.fbar f y)
    (qs : ExtraConsensus.Sublinear.Stack n p) (hopt : ExtraConsensus.Sublinear.IsOptimalPair U α f qs (fun _ => xs))
    (hrsc : RSCAtStack (gradG α W Wt f) (fun _ => xs) μg)
    (hα : α * Lf ^ 2 < 2 * μg * lmin)
    (x0 : ExtraConsensus.Sublinear.Stack n p) :
    let x := ExtraConsensus.Sublinear.extraIter α W Wt f x0
    let q := ExtraConsensus.Sublinear.qSeq U x
    let Xs : ExtraConsensus.Sublinear.Stack n p := fun _ => xs
    ∃ δ : ℝ, 0 < δ ∧
      (∀ k : ℕ, (1 + δ) * ExtraConsensus.Sublinear.zNormSq Wt (q (k + 1) - qs) (x (k + 1) - Xs)
          ≤ ExtraConsensus.Sublinear.zNormSq Wt (q k - qs) (x k - Xs)) ∧
      ∃ C : ℝ, ∀ k : ℕ, ExtraConsensus.Sublinear.mnormSq Wt (x k - Xs) ≤ C * ((1 + δ)⁻¹) ^ k := by sorry

end ExtraConsensus.Linear
