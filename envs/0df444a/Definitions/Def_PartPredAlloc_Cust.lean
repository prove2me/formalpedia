-- title:
--   Customer types: no customer, type-2 ($a$), type-1 ($1$)
-- statement:
--   Each period of the horizon holds at most one customer. Its **type** is one of three values: no customer ($v_i=0$), a **type-2** customer, who pays $a\in(0,1)$ if accepted, or a **type-1** customer, who pays $1$. The revenue map $\mathrm{rev}_a$ sends these to $0$, $a$ and $1$.
--
--   A sequence of arrivals over $n$ periods is a word $\vec v=(v_1,\dots,v_n)$ over these three values.
--
--   **Formalization Note** The type is a three-element inductive type, so whether a customer is of type 2 does not depend on the numerical value of $a$; positions $1,\dots,n$ are the elements of `Fin n`.
-- source:
--   Hwang, Jaillet, Manshadi, Online Resource Allocation under Partially Predictable Demand, arXiv:1810.00447v1, §3, p.9

import Mathlib

namespace PartPredAlloc

/-- The value of one period of an arrival sequence (Hwang–Jaillet–Manshadi, *Online Resource
Allocation under Partially Predictable Demand*, arXiv:1810.00447v1, §3, p.9): `empty` means that no
customer arrives (`v_i = 0`), `low` is a type-2 customer (revenue `a`), `high` is a type-1 customer
(revenue `1`).

**Formalization Note.** The type is symbolic, so "type-2" does not depend on the numerical value of
`a`; the revenue is attached by `rev`. -/
inductive Cust where
  /-- no customer arrives (`v_i = 0`) -/
  | empty
  /-- a type-2 customer (`v_i = a`) -/
  | low
  /-- a type-1 customer (`v_i = 1`) -/
  | high
  deriving DecidableEq, Repr

/-- The revenue `v_i ∈ {0, a, 1}` generated by accepting the customer of a period
(arXiv:1810.00447v1, §3, p.9): `0` for no customer, `a` for type-2, `1` for type-1. -/
noncomputable def rev (a : ℝ) : Cust → ℝ
  | .empty => 0
  | .low => a
  | .high => 1

end PartPredAlloc


