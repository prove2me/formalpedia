                ∂(adelicGLHaar (Fin 2) (𝓞 K) K)) ∂νZK) :
    (RL ∩ {δ : GL (Fin 2) L | ∃ γ : GL (Fin 2) K, γ ∈ AutomorphicForm.ellipticCell K ∧
        LT.TwistedNorm.normClassMap hgen (LT.TwistedNorm.SigmaConjClasses.mk σ.symm δ) =
          ConjClasses.mk γ} ∩
