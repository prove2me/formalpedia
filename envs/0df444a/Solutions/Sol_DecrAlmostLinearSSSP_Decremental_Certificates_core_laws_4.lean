open Structured
lemma nat_eval (slot source : ℕ) (s : Data) : Eval (natCode slot source) s 3 (natResult slot source s) :=
  eval_sequence_atoms (natAtoms slot source) s
lemma real_eval (slot source : ℕ) (s : Data) : Eval (realCode slot source) s 3 (realResult slot source s) :=
  eval_sequence_atoms (realAtoms slot source) s
lemma nat_values (slot source : ℕ) (s : Data) (hsource : source ≠ 630) :
    (natResult slot source s).natMem = Function.update s.natMem (s.natReg 50+2*slot) (s.natReg source) ∧
    (natResult slot source s).realMem = s.realMem := by
  simp [natResult,natAtoms,Atom.effect,instructionEffect,data,Data.machine,Function.update_of_ne hsource]
lemma real_values (slot source : ℕ) (s : Data) :
    (realResult slot source s).realMem = Function.update s.realMem (s.natReg 50+2*slot) (s.realReg source) ∧
    (realResult slot source s).natMem = s.natMem := by
  simp [realResult,realAtoms,Atom.effect,instructionEffect,data,Data.machine]
lemma nat_frame (slot source k : ℕ) (hk : k ≠ 630) : NatFrame (natCode slot source) k := by
  simp [natCode,natAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma real_nat_frame (slot source k : ℕ) (hk : k ≠ 630) : NatFrame (realCode slot source) k := by
  simp [realCode,realAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma nat_real_frame (slot source k : ℕ) : RealFrame (natCode slot source) k := by
  simp [natCode,natAtoms,Structured.sequence,RealFrame,writesReal]
lemma real_frame (slot source k : ℕ) : RealFrame (realCode slot source) k := by
  simp [realCode,realAtoms,Structured.sequence,RealFrame,writesReal]
lemma nat_saved (N slot source value : ℕ) (s : Data) (old : ℕ → ℕ)
    (hsource : source ≠ 630) (hv : s.natReg source = 2*value)
    (hsaved : ∀ j < N, s.natMem (s.natReg 50+2*j) = 2*old j) :
    ∀ j < N, (natResult slot source s).natMem ((natResult slot source s).natReg 50+2*j) =
      2*(Function.update old slot value j) := by
  intro j hj
  rw [(nat_eval slot source s).nat_frame (nat_frame slot source 50 (by omega)),(nat_values slot source s hsource).1,hv]
  by_cases hh : j = slot
  · subst j;simp
  · have hne : s.natReg 50+2*j ≠ s.natReg 50+2*slot := by omega
    rw [Function.update_of_ne hne,Function.update_of_ne hh,hsaved j hj]
lemma real_saved (N slot source : ℕ) (s : Data) (old : ℕ → ℝ)
    (hsaved : ∀ j < N, s.realMem (s.natReg 50+2*j) = old j) :
    ∀ j < N, (realResult slot source s).realMem ((realResult slot source s).natReg 50+2*j) =
      Function.update old slot (s.realReg source) j := by
  intro j hj
  rw [(real_eval slot source s).nat_frame (real_nat_frame slot source 50 (by omega)),(real_values slot source s).1]
  by_cases hh : j = slot
  · subst j;simp
  · have hne : s.natReg 50+2*j ≠ s.natReg 50+2*slot := by omega
    rw [Function.update_of_ne hne,Function.update_of_ne hh,hsaved j hj]
end DecrAlmostLinearSSSP.Decremental.CoreRequest
