theorem IRuns.of_runsTo {S P : ℕ} {I : List Sym} {iprog : Fin P → IStmt S P} {p : IStmt S P}
    {s t : IState S} {c : ℕ} (n : ℕ) (h : runsTo (IStmt.run iprog n p s) t c) :
    IRuns I iprog p s t c := by
  unfold runsTo at h
  split at h
  · rename_i r hr; exact IRuns.of_run n hr h.1 h.2
  · exact h.elim

