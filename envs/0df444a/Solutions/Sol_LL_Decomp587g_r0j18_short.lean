        have : ((t_lo : ℝ) + sr) / D_den = ((phi0 + p * step : ℕ) : ℝ) / D_den := by
          congr 1; exact_mod_cast ht_lo_eq
        rw [add_div] at this; linarith [hp_lo, hs_mem.2]
