section
-- Source module: Solutions.J6SegILSweep8
/-!
# B-line IL, B6 §8: one axis (`axB_run`) and the loop over the axes (`swL_run`)
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- The cost of one axis. -/
def cAx (Ckn B : ℕ) : ℕ :=
  cP1 B + (8 * (300 * (B + 1)) + 1) + Ckn + (8 * (2 * B + 2) + 1) + cP2 B

/-- The loop over the axes. -/
def swL {Pp : ℕ} (σ : Fin 19 → Fin HS) (dS dA : Fin HS) (eX : Fin Pp) : IStmt HS Pp :=
  irep (σ 17) (.reg (σ 3)) (axB σ dS dA eX)

end J6Seg

end

