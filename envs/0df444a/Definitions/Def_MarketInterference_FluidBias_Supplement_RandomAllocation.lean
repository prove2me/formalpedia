-- title:
--   Definition 2 and Assumption 1, pp. 9–11 — random path allocation and the actual RCT estimator
-- statement:
--   For each supply-to-demand path $p$, let $\nu_p$ be the sum of its arc values. Experimental path flow is split into nonnegative control and treatment flows $Y^c_p$ and $Y^t_p$, each consuming no more demand than its observed group count. Their sum is a random path decomposition of an optimal arc flow. No deterministic selection of a finite-sample optimizer is required. The RCT estimator is the actual random revenue difference
--   $$
--   \widehat\Delta^\tau_{RCT}=\frac1\tau\left(\frac{\sum_p\nu_pY^t_p}{\rho}-\frac{\sum_p\nu_pY^c_p}{1-\rho}\right).
--   $$
--   Blindness is the separate conditional-mean restriction of Assumption 1:
--   $$
--   \mathbb E[Y^c_p\mid C,T,S]=\frac{C_{i(p)}}{C_{i(p)}+T_{i(p)}}Y^{\rm experiment}_p.
--   $$
--   In particular this definition retains allocation randomness instead of replacing RCT by its conditional mean. The inherited finite simple-arc paths and their finite-support flows also accommodate intermediate nodes. Zero total demand forces both group flows to vanish; division by zero in the mean formula therefore gives zero.
--
--   The file also defines the explicit one-arc diagnostic for Theorem 5: value $1$, capacity $3$, rates $\lambda=2,\beta=0,\pi=1$, fraction $1/2$. At integer density $n$ the matched count is $M=\min(C+T,S,3n)$, the mean control allocation is $m=MC/(C+T)$ and its feasible integer endpoints are $L=\max(0,M-T)$ and $U=\min(M,C)$. Uniform-seed randomized rounding of $m$ and the two-point allocation on $\{L,U\}$ with upper probability $(m-L)/(U-L)$ both have conditional mean $m$. Even densities use rounding, odd densities use endpoints. At $L=U$ the endpoint rule returns that common value. These are auxiliary objects for the disclosed counterexample, not a claim that the paper prescribed either policy.
--
--   **Formalization Note** Demand and supply indices are zero-based `Fin` indices. Conditional expectation is taken over the sigma algebra generated by the count vector. Component measurability describes random allocations; their integrability follows from feasibility and the finite capacitated network, rather than being assumed. Natural subtraction in $L$ implements the displayed nonnegative maximum. Capacities bound revenues, so `rctScaledVariance` uses the real variance only on square-integrable variables in the theorem.
--   The file also defines `reducedRCT` as the conditional expectation of the actual RCT estimator given all control, treatment and supply counts, exactly as the p.42 remark specifies for the paper's results. `observedSP` evaluates the published backward-difference SP estimator on those counts. These remain distinct random variables; raw-estimator square integrability is concluded in the variance theorem, so its conditional expectation cannot rely on a nonintegrable default.
--
--   The file also defines a second diagnostic network, `routingNetwork`: two supplies
--   merge at one intermediate node and feed two demands. In arc order (supply 0,
--   supply 1, demand 0, demand 1), values are (2,1,1,0) and all capacities are 3.
--   Demand rates are (1,3), supply rates (1,1), treatment effect is zero and fraction
--   is 1/2. `routingLaw n` is the actual product Poisson law at density n with an
--   independent uniform allocation seed. These auxiliary witnesses test the source's
--   variance-reduced assertion; they do not restrict any positive theorem's domain.
-- source:
--   Bright, Delarue and Lobel, Reducing Marketplace Interference Bias Via Shadow Prices, arXiv:2205.02274v4, pp. 9–11, paths, Assumption 1, Definition 2 and (6); p. 23, Theorem 5 (counterexample context); p. 42, variance-reduced estimator remark; pp. 13, 23, Assumption 2 and Theorem 5 (routing counterexample context)

import Mathlib
import Definitions.Def_MarketInterference_FluidBias_Supplement_TwoLP
import Definitions.Def_MarketInterference_FluidBias_PathFlow

namespace MarketInterference.FluidBias.Supplement

open MeasureTheory

variable {nd ns : ℕ} {I E Ω : Type} [Fintype E] [DecidableEq I] [DecidableEq E]
  [MeasurableSpace Ω]

noncomputable def pathDemand (N : Network nd ns I E) (y : SDPath N →₀ ℝ) (i : Fin nd) : ℝ :=
  ∑ p ∈ y.support with p.i = i, y p

noncomputable def pathRevenue (N : Network nd ns I E) (y : SDPath N →₀ ℝ) : ℝ :=
  ∑ p ∈ y.support, y p * pathValue p

/-- The actual path allocations, including their randomness. The displayed equation is precisely
Assumption 1, not a definition of the RCT random variable by its conditional mean. -/
structure BlindAllocation (N : Network nd ns I E) (μ : Measure Ω) (X : Ω → Counts nd ns)
    (τ : ℝ) where
  total : Ω → SDPath N →₀ ℝ
  control : Ω → SDPath N →₀ ℝ
  treatment : Ω → SDPath N →₀ ℝ
  total_measurable : ∀ p, Measurable (fun ω => total ω p)
  control_measurable : ∀ p, Measurable (fun ω => control ω p)
  treatment_measurable : ∀ p, Measurable (fun ω => treatment ω p)
  optimal : ∀ᵐ ω ∂μ, ∃ x,
    IsOptimal N τ (fun i => ((X ω).1.1 i + (X ω).1.2 i : ℕ))
      (fun j => ((X ω).2 j : ℝ)) x ∧ IsPathDecomposition N (total ω) x
  split : ∀ᵐ ω ∂μ, control ω + treatment ω = total ω
  nonneg : ∀ᵐ ω ∂μ, (∀ p, 0 ≤ control ω p) ∧ (∀ p, 0 ≤ treatment ω p)
  control_count : ∀ᵐ ω ∂μ, ∀ i, pathDemand N (control ω) i ≤ ((X ω).1.1 i : ℝ)
  treatment_count : ∀ᵐ ω ∂μ, ∀ i, pathDemand N (treatment ω) i ≤ ((X ω).1.2 i : ℝ)
  blind : ∀ p, condExp (MeasurableSpace.comap X inferInstance) μ (fun ω => control ω p) =ᵐ[μ]
    (fun ω => ((X ω).1.1 p.i : ℝ) /
      (((X ω).1.1 p.i : ℝ) + ((X ω).1.2 p.i : ℝ)) * total ω p)

noncomputable def rctEst (N : Network nd ns I E) (μ : Measure Ω) (X : Ω → Counts nd ns)
    (ρ τ : ℝ) (A : BlindAllocation N μ X τ) (ω : Ω) : ℝ :=
  (1 / τ) * (pathRevenue N (A.treatment ω) / ρ - pathRevenue N (A.control ω) / (1 - ρ))


/-- The variance-reduced estimator explicitly specified in the remark on p. 42. -/
noncomputable def reducedRCT (N : Network nd ns I E) (μ : Measure Ω)
    (X : Ω → Counts nd ns) (ρ τ : ℝ) (A : BlindAllocation N μ X τ) : Ω → ℝ :=
  condExp (MeasurableSpace.comap X inferInstance) μ (rctEst N μ X ρ τ A)

/-- The finite SP estimator evaluated on the actual observed counts. -/
noncomputable def observedSP (N : Network nd ns I E) (X : Ω → Counts nd ns)
    (ρ τ : ℝ) (ω : Ω) : ℝ :=
  MarketInterference.FiniteSample.SPest N ρ τ (X ω).1.1 (X ω).1.2 (X ω).2

/-- The one-arc marketplace used to test Theorem 5: v=1, k=3. -/
def varianceNetwork : Network 1 1 Empty (Fin 1) where
  tail := fun _ => Sum.inl 0
  head := fun _ => Sum.inl 0
  v := fun _ => 1
  k := fun _ => 3
  k_nonneg := by norm_num

def variancePath : SDPath varianceNetwork where
  i := 0
  j := 0
  arcs := [0]
  ne_nil := by simp
  nodup := by simp
  first_tail := by simp [varianceNetwork]
  last_head := by simp [varianceNetwork]
  chain := by simp

/-- At density n the integral optimal flow is min(C+T,S,3n). -/
def matchedCount (n : ℕ) (z : Counts 1 1) : ℕ :=
  min (z.1.1 0 + z.1.2 0) (min (z.2 0) (3 * n))

noncomputable def meanControl (n : ℕ) (z : Counts 1 1) : ℝ :=
  (matchedCount n z : ℝ) * (z.1.1 0 : ℝ) / ((z.1.1 0 : ℝ) + (z.1.2 0 : ℝ))

/-- Feasible integer extremes for the number of control units matched. -/
def lowerControl (n : ℕ) (z : Counts 1 1) : ℕ := matchedCount n z - z.1.2 0

def upperControl (n : ℕ) (z : Counts 1 1) : ℕ := min (matchedCount n z) (z.1.1 0)

/-- Randomized rounding has the prescribed mean and conditional variance at most 1/4. -/
noncomputable def roundedControl (n : ℕ) (z : Counts 1 1) (u : ℝ) : ℕ :=
  if u < meanControl n z - (Nat.floor (meanControl n z) : ℝ)
    then Nat.floor (meanControl n z) + 1 else Nat.floor (meanControl n z)

/-- The two feasible extremes with exactly the same prescribed conditional mean. -/
noncomputable def extremeControl (n : ℕ) (z : Counts 1 1) (u : ℝ) : ℕ :=
  if u < (meanControl n z - (lowerControl n z : ℝ)) /
      ((upperControl n z : ℝ) - (lowerControl n z : ℝ))
    then upperControl n z else lowerControl n z

/-- Both branches satisfy Assumption 1; their conditional variances have different orders. -/
noncomputable def alternatingControl (n : ℕ) (ω : Counts 1 1 × ℝ) : ℕ :=
  if n % 2 = 0 then roundedControl n ω.1 ω.2 else extremeControl n ω.1 ω.2

/-- Independent C,T~Poisson(n), S~Poisson(n), and a uniform allocation random seed. -/
noncomputable def varianceLaw (n : ℕ) : Measure (Counts 1 1 × ℝ) :=
  (MarketInterference.FiniteSample.experimentLaw (fun _ => 2) (fun _ => 0)
    (fun _ => 1) (1/2) n).prod (volume.restrict (Set.Icc 0 1))

noncomputable def rctScaledVariance (N : Network nd ns I E) (μ : Measure Ω)
    (X : Ω → Counts nd ns) (ρ τ : ℝ) (A : BlindAllocation N μ X τ) : ℝ :=
  ProbabilityTheory.variance (fun ω => Real.sqrt τ * rctEst N μ X ρ τ A ω) μ

/-- Two supplies merge at one intermediate node and then feed two demands. Arc order:
high-value supply, low-value supply, high-value demand, low-value demand. -/
def routingNetwork : Network 2 2 (Fin 1) (Fin 4) where
  tail := fun e => if e = 0 then Sum.inl 0 else if e = 1 then Sum.inl 1 else Sum.inr 0
  head := fun e => if e = 2 then Sum.inl 0 else if e = 3 then Sum.inl 1 else Sum.inr 0
  v := fun e => if e = 0 then 2 else if e = 3 then 0 else 1
  k := fun _ => 3
  k_nonneg := by norm_num

def routingDemand : Fin 2 → ℝ := fun i => if i = 0 then 1 else 3

/-- The independent source experiment, with zero effect and a uniform seed for blind
integer group allocation. Its routing may depend on the density, as the source permits. -/
noncomputable def routingLaw (n : ℕ) : Measure (Counts 2 2 × ℝ) :=
  (MarketInterference.FiniteSample.experimentLaw routingDemand (fun _ => 0)
    (fun _ => 1) (1/2) n).prod (volume.restrict (Set.Icc 0 1))

end MarketInterference.FluidBias.Supplement


