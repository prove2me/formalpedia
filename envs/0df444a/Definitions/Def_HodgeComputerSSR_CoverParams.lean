lemma syl5_homog {A : Type*} [CommRing A] (q2 q1 q0 e3 e2 e1 e0 c : A) :
    syl5 q2 (c * q1) (c ^ 2 * q0) e3 (c * e2) (c ^ 2 * e1) (c ^ 3 * e0) =
      c ^ 6 * syl5 q2 q1 q0 e3 e2 e1 e0 := by
  simp only [syl5]; ring

/-- Universal `b`-elimination vs `a`-elimination resultant symmetry over any commutative ring
(zero-divisor-free after cancelling `cb^6` over an integral domain). -/
lemma syl5_elim_symm {A : Type*} [CommRing A]
    (ca cb c0 q20 q11 q02 c30 c21 c12 c03 k2 k3 : A) :
    cb ^ 6 * (ca ^ 6 * syl5
      (q20 * cb ^ 2 - q11 * ca * cb + q02 * ca ^ 2)
      ((-q11 * cb + 2 * q02 * ca) * c0)
      (q02 * c0 ^ 2 + cb ^ 2 * k2)
      (c30 * cb ^ 3 - c21 * ca * cb ^ 2 + c12 * ca ^ 2 * cb - c03 * ca ^ 3)
      ((-c21 * cb ^ 2 + 2 * c12 * ca * cb - 3 * c03 * ca ^ 2) * c0)
      ((c12 * cb - 3 * c03 * ca) * c0 ^ 2)
      (-c03 * c0 ^ 3 + cb ^ 3 * k3)) =
    cb ^ 6 * (cb ^ 6 * syl5
      (q20 * cb ^ 2 - q11 * ca * cb + q02 * ca ^ 2)
      ((-q11 * ca + 2 * q20 * cb) * c0)
      (q20 * c0 ^ 2 + ca ^ 2 * k2)
      (-c30 * cb ^ 3 + c21 * ca * cb ^ 2 - c12 * ca ^ 2 * cb + c03 * ca ^ 3)
      ((-3 * c30 * cb ^ 2 + 2 * c21 * ca * cb - c12 * ca ^ 2) * c0)
      ((-3 * c30 * cb + c21 * ca) * c0 ^ 2)
      (-c30 * c0 ^ 3 + ca ^ 3 * k3)) := by
  set d22 := q20 * cb ^ 2 - q11 * ca * cb + q02 * ca ^ 2
  set d21 := (-q11 * cb + 2 * q02 * ca) * c0
  set d20 := q02 * c0 ^ 2 + cb ^ 2 * k2
  set d33 := c30 * cb ^ 3 - c21 * ca * cb ^ 2 + c12 * ca ^ 2 * cb - c03 * ca ^ 3
  set d32 := (-c21 * cb ^ 2 + 2 * c12 * ca * cb - 3 * c03 * ca ^ 2) * c0
  set d31 := (c12 * cb - 3 * c03 * ca) * c0 ^ 2
  set d30 := -c03 * c0 ^ 3 + cb ^ 3 * k3
  set e22 := q20 * cb ^ 2 - q11 * ca * cb + q02 * ca ^ 2
  set e21 := (-q11 * ca + 2 * q20 * cb) * c0
  set e20 := q20 * c0 ^ 2 + ca ^ 2 * k2
  set e33 := -c30 * cb ^ 3 + c21 * ca * cb ^ 2 - c12 * ca ^ 2 * cb + c03 * ca ^ 3
  set e32 := (-3 * c30 * cb ^ 2 + 2 * c21 * ca * cb - c12 * ca ^ 2) * c0
  set e31 := (-3 * c30 * cb + c21 * ca) * c0 ^ 2
  set e30 := -c30 * c0 ^ 3 + ca ^ 3 * k3
  have h1 := syl5_homog d22 d21 d20 d33 d32 d31 d30 ca
  have h2 := syl5_affine d22 (ca * d21) (ca ^ 2 * d20) d33 (ca * d32) (ca ^ 2 * d31) (ca ^ 3 * d30) (-cb) (-c0)
  have h3 := syl5_scale e22 e21 e20 e33 e32 e31 e30 (cb ^ 2) (cb ^ 3)
  have hc1 : d22 * (-cb) ^ 2 = cb ^ 2 * e22 := by dsimp [d22, e22]; ring
  have hc2 : 2 * d22 * (-cb) * (-c0) + ca * d21 * (-cb) = cb ^ 2 * e21 := by dsimp [d22, d21, e21]; ring
  have hc3 : d22 * (-c0) ^ 2 + ca * d21 * (-c0) + ca ^ 2 * d20 = cb ^ 2 * e20 := by dsimp [d22, d21, d20, e20]; ring
  have hc4 : d33 * (-cb) ^ 3 = cb ^ 3 * e33 := by dsimp [d33, e33]; ring
  have hc5 : 3 * d33 * (-cb) ^ 2 * (-c0) + ca * d32 * (-cb) ^ 2 = cb ^ 3 * e32 := by dsimp [d33, d32, e32]; ring
  have hc6 : 3 * d33 * (-cb) * (-c0) ^ 2 + 2 * (ca * d32) * (-cb) * (-c0) + ca ^ 2 * d31 * (-cb) = cb ^ 3 * e31 := by
    dsimp [d33, d32, d31, e31]; ring
  have hc7 : d33 * (-c0) ^ 3 + ca * d32 * (-c0) ^ 2 + ca ^ 2 * d31 * (-c0) + ca ^ 3 * d30 = cb ^ 3 * e30 := by
    dsimp [d33, d32, d31, d30, e30]; ring
  rw [hc1, hc2, hc3, hc4, hc5, hc6, hc7, h3] at h2
  have hcb : (-cb) ^ 6 = cb ^ 6 := by ring
  rw [hcb, h1] at h2
  linear_combination h2.symm

end PolyDefs

