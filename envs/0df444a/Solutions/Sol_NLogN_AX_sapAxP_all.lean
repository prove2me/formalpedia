    have za := zsz_eval_le s B a h.1; have zb := zsz_eval_le s B b h.2.1
    simp only [NLogN.Ex.cost, size]; (simp only [dupCost, moveCost, zipCost, addIntCost, addMagCost, subMagCost, smulCost, shlCost, splitCost, takeCost, ldivCost, pow2Cost] at *); nlinarith
  | shl a b, hl, h => by
