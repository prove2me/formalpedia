private lemma F_fn_le_F_UB {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    {m0 m1 : ℕ} (hm01 : m0 ≤ m1) {s : ℝ}
    (hs_lo : (((206 + m0) * 1656 : ℕ) : ℝ) / D_in ≤ s)
    (hs_hi : s ≤ (((206 + m1 + 1) * 1656 : ℕ) : ℝ) / D_in) :
    F_fn ω s ≤ (F_UB m0 m1 : ℝ) / S_scale := by
  have hDpos : (0 : ℝ) < D_in := by unfold D_in; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  unfold F_UB
  split_ifs with hm0_big hm1_lt
  · have hs_tail : ((334 * 1656 : ℕ) : ℝ) / D_in ≤ s := by
      have h1 : ((334 * 1656 : ℕ) : ℝ) / D_in ≤ (((206 + m0) * 1656 : ℕ) : ℝ) / D_in := by
        apply div_le_div_of_nonneg_right _ (le_of_lt hDpos)
        exact_mod_cast (by omega : 334 * 1656 ≤ (206 + m0) * 1656)
      linarith
    exact F_fn_le_tail hω hz hs_tail
  · by_cases heq : s = (((206 + m1 + 1) * 1656 : ℕ) : ℝ) / D_in
    · have hm_eq : (206 + m1 + 1) * 1656 = (207 + m1) * 1656 := by omega
      have h1 := F_fn_le_getF hω hz hm1_lt (s := s)
        (by rw [heq]; apply div_le_div_of_nonneg_right _ (le_of_lt hDpos); exact_mod_cast (by omega : (206 + m1) * 1656 ≤ (206 + m1 + 1) * 1656))
        (by rw [heq, hm_eq])
      have h2 : getF m1 ≤ F_tree.rangeMax 7 m0 m1 :=
        SegTree.get_le_rangeMax validF_tree hm01 (le_refl m1) (by simpa using hm1_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hs_lt : s < (((206 + m1 + 1) * 1656 : ℕ) : ℝ) / D_in := lt_of_le_of_ne hs_hi heq
      set m : ℕ := Nat.floor (s * 120 - 206)
      have hD1656 : (D_in : ℝ) = 1656 * 120 := by unfold D_in; norm_num
      have hs120_lo : (206 : ℝ) + m0 ≤ s * 120 := by
        have := (div_le_iff₀ hDpos).mp hs_lo
        rw [hD1656] at this; push_cast at this; linarith
      have hs120_hi : s * 120 < (206 : ℝ) + m1 + 1 := by
        have := (lt_div_iff₀ hDpos).mp hs_lt
        rw [hD1656] at this; push_cast at this; linarith
      have hm0_le : m0 ≤ m := Nat.le_floor (by linarith)
      have hm_le1 : m ≤ m1 := by
        have hlt : s * 120 - 206 < ((m1 + 1 : ℕ) : ℝ) := by push_cast; linarith
        have := (Nat.floor_lt (by linarith)).mpr hlt; omega
      have hm_lt : m < 128 := lt_of_le_of_lt hm_le1 hm1_lt
      have hfl1 : (m : ℝ) ≤ s * 120 - 206 := Nat.floor_le (by linarith)
      have hfl2 : s * 120 - 206 < (m : ℝ) + 1 := Nat.lt_floor_add_one _
      have h1 := F_fn_le_getF hω hz hm_lt (s := s)
        (by rw [div_le_iff₀ hDpos, hD1656]; push_cast; linarith)
        (by rw [le_div_iff₀ hDpos, hD1656]; push_cast; linarith)
      have h2 : getF m ≤ F_tree.rangeMax 7 m0 m1 :=
        SegTree.get_le_rangeMax validF_tree hm0_le hm_le1 (by simpa using hm_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
  · by_cases hs_tail : ((334 * 1656 : ℕ) : ℝ) / D_in ≤ s
    · have h1 := F_fn_le_tail hω hz hs_tail
      have h2 : F_tail_val ≤ max (F_tree.rangeMax 7 m0 127) F_tail_val := le_max_right _ _
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · push Not at hs_tail
      set m : ℕ := Nat.floor (s * 120 - 206)
      have hD1656 : (D_in : ℝ) = 1656 * 120 := by unfold D_in; norm_num
      have hs120_lo : (206 : ℝ) + m0 ≤ s * 120 := by
        have := (div_le_iff₀ hDpos).mp hs_lo
