theorem _root_.solution (L : List (PauliString n)) (Ls : List (List (PauliString n)))
    (p : PauliString n) : reachable Ls p ⊆ reachable (L :: Ls) p := by
  intro q hq
  rw [reachable_cons]
  exact Finset.mem_biUnion.2 ⟨p, self_mem_oneLayer L p, hq⟩
