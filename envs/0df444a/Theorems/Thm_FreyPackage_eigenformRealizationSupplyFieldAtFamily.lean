theorem FreyPackage.eigenformRealizationSupplyFieldAtFamily (P : FreyPackage) : ∀ M : ℕ, (hM : 0 < M) → (haveI : NeZero M := ⟨hM.ne'⟩; letI := ModularCurve.heckeModuleBar M; P.EigenformRealizationSupplyFieldAt M) := by sorry
