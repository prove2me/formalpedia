  have h1 : (1 : ℝ) ≤ t ^ Module.finrank ℚ F := one_le_pow₀ ht
  exact Real.rpow_le_one (inv_nonneg.mpr (zero_le_one.trans h1)) (inv_le_one_of_one_le₀ h1) hs

end Modulus
