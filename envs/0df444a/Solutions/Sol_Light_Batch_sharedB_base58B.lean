  exact at_base58 h R

theorem band_base58B (R : Program) : (base58B ++ R)[Sec2.pBandArray]? = some bandArrayBBody := by
  rw [base58B_append, List.getElem?_set_self]
  simp [length_base58, Sec2.pBandArray]; omega

