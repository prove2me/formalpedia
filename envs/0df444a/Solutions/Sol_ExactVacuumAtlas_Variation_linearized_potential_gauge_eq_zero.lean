  have hR : ∀ b d, ricciVar g gi (0 : Metric 4) b d x = 0 := by
    intro b d; simp [ricciVar, ricciLin, hC, hz]
  simp [linEinstein, scalarVar, emStressVar, fieldSqVar, raise2Var, invVar, hR]

theorem linMaxwell_zero {n : ℕ} (g gi : Metric n) (F : TwoForm n) (b : Fin n) (x : Pt n) :
    linMaxwell g gi F 0 0 b x = 0 := by
  have hz : ∀ (i : Fin n) (y : Pt n), pd i (0 : Pt n → ℝ) y = 0 := fun i y => pd_const 0 i y
  have hC : ∀ a b c, chrVar g gi (0 : Metric n) a b c = 0 := by
    intro a b c; funext y; simp [chrVar, invVar, hz]
  have hV : ∀ a b, raise2Var gi (0 : Metric n) F (0 : TwoForm n) a b = 0 := by
    intro a b; funext y; simp [raise2Var, invVar]
  simp [linMaxwell, hC, hV, hz]

end ExactVacuumAtlas.Variation

-- ==== solution ====
open Filter Topology
open scoped ContDiff
open Matrix
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {n : ℕ}
theorem solution {U : Set (Pt 4)} (hU : IsOpen U) {χ : Pt 4 → ℝ}
    (hχ : ContDiffOn ℝ ∞ χ U) (g gi : Metric 4) (F : TwoForm 4) {x : Pt 4} (hx : x ∈ U) :
    (∀ a b, linEinstein g gi F 0 (extD (gradCo χ)) a b x = 0) ∧
    (∀ b, linMaxwell g gi F 0 (extD (gradCo χ)) b x = 0) ∧
    (∀ a b c, linFaraday (extD (gradCo χ)) a b c x = 0) := by
  have hf : ∀ i j, Set.EqOn (extD (gradCo χ) i j) ((0 : TwoForm 4) i j) U :=
    fun i j y hy => extD_gradCo hU hχ hy i j
  refine ⟨fun a b => ?_, fun b => ?_, fun a b c => ?_⟩
  · rw [linEinstein_congr hU (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _)
      (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) hf hx a b]
    exact linEinstein_zero g gi F a b x
  · rw [linMaxwell_congr hU (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _)
      (fun _ _ => Set.eqOn_refl _ _) (fun _ _ => Set.eqOn_refl _ _) hf hx b]
    exact linMaxwell_zero g gi F b x
  · rw [linFaraday_congr hU hf hx a b c]
    have hz : ∀ (i : Fin 4) (y : Pt 4), pd i (0 : Pt 4 → ℝ) y = 0 := fun i y => pd_const 0 i y
    simp [linFaraday, hz]
