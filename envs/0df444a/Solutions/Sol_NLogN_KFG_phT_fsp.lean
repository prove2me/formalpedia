    FSp (dblB ε) (encK s f) (encK s (Function.update (Function.update (Function.update f
      xA ((a + ε) % 4 :: f xA)) xC (a :: f xC)) xB B)) 100000 := by
  have p1 := Sp.push s f (i := xA) (e := NLogN.KFG.dE ε) (B := 4) (by decide) (clean_dE ε)
    ⟨⟨isInt_encK hB, trivial⟩, trivial, ⟨2, by simp [Ex.eval]⟩⟩ ⟨⟨trivial, trivial⟩, trivial⟩
    ⟨⟨by simp only [Ex.Bnd, top_encK hB]; exact small_zsz (by omega) (by omega),
      by simp only [Ex.Bnd]; exact small_zsz (by omega) (by omega),
      by simp only [Ex.eval, top_encK hB]; exact small_zsz (by omega) (by omega)⟩,
      by simp only [Ex.Bnd]; exact small_zsz (by omega) (by omega)⟩
  rw [show (NLogN.KFG.dE ε).eval (encK s f) = (a + ε) % 4 by
    simp only [NLogN.KFG.dE, Ex.eval, top_encK hB]; exact Int.tmod_eq_emod_of_nonneg (by omega)] at p1
  set f1 := Function.update f xA ((a + ε) % 4 :: f xA)
  have hB1 : f1 xB = a :: B := by simp +decide [f1, hB]
  have p2 := Sp.push s f1 (i := xC) (e := .reg xB) (B := 4) (by decide) (clean_reg (by decide))
    (isInt_encK hB1) trivial (by simp only [Ex.Bnd, top_encK hB1]; exact small_zsz (by omega) (by omega))
  rw [show (Ex.reg xB).eval (encK s f1) = a by simp only [Ex.eval, top_encK hB1]] at p2
  set f2 := Function.update f1 xC (a :: f1 xC)
  have p3 := Sp.pop s f2 (i := xB) (a := a) (l := B) (B := 4) (by decide)
    (by simp +decide [f2, hB1]) (small_zsz (by omega) (by omega))
  refine ((FSp.of_norep rfl p1).seq ((FSp.of_norep rfl p2).seq (FSp.of_norep rfl p3))).mono
    (by simp only [NLogN.KFG.dE, Ex.size]; norm_num) |>.congr ?_
  simp +decide [f2, f1]

theorem dbl_fsp (s : IState HS) (f : Fin HS → List ℤ) (ε : ℤ) (he : 0 ≤ ε) (he' : ε < 4)
    (T R : List ℤ) (hT : Ex4 T) (hA : f xA = T ++ R) (hB : f xB = []) (hC : f xC = [])
    (hD : f xD = []) (hc : f NLogN.KFB.c1 = []) (hN : f xN = [(T.length : ℤ)]) (Z : ℕ)
    (hZ : zsz ((2 * T.length : ℕ) : ℤ) ≤ Z) :
    FSp (dblP ε) (encK s f) (encK s (Function.update (Function.update f xA (dblL ε T ++ R)) xN
      [((2 * T.length : ℕ) : ℤ)])) (cDbl T.length Z) := by
  set M := T.length with hM
  set g : ℤ → ℤ := fun x => (x + ε) % 4 with hg
  -- 1. T to xB
  have m1 := FSp.mvN (X := xA) (Y := xB) (C := NLogN.KFB.c1) (r := xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f T R hA (Lr := s.G xN)
    (by simp [hN, ints, hM]) 4 hT.bnd
  -- 2. the loop
  set F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update f
    xA ((T.drop (M - k)).map g ++ R)) xB (T.take (M - k)).reverse) xC (T.drop (M - k))
    with hF
  have F0 : Function.update (Function.update f xA R) xB (T.reverse ++ f xB) = F 0 := by
    funext x
    simp only [hF, hM, Function.update_apply, Nat.sub_zero, List.drop_length, List.take_length,
      List.map_nil, List.nil_append, hB, List.append_nil]
    by_cases e1 : x = xC
    · subst e1; simp +decide [hC]
    · simp [e1]
  rw [F0] at m1
  have hF0N : F 0 xN = [(M : ℤ)] := by simp +decide [hF, hN]
  have m2 := FSp.rep (C := NLogN.KFB.c1) (n := .reg xN) (b := dblB ε) (s := s) (F := F) (N := M)
    (c := 100000) (by decide) (fun k => by simp +decide [hF, hc]) (by simp +decide [dblB, RS.writes])
    (clean_reg (by decide)) (isInt_encK hF0N) (by simp only [Ex.eval, top_encK hF0N])
    (by
      intro k hk
      have hj : M - k - 1 < T.length := by omega
      have e1 : M - (k + 1) = M - k - 1 := by omega
      have e2 : M - k = M - k - 1 + 1 := by omega
      have htake : T.take (M - k) = T.take (M - k - 1) ++ [T[M - k - 1]] := by
        have := List.take_succ_eq_append_getElem hj; rwa [← e2] at this
      have hdrop : T.drop (M - k - 1) = T[M - k - 1] :: T.drop (M - k) := by
        rw [List.drop_eq_getElem_cons hj, ← e2]
      have hTa := hT _ (List.getElem_mem hj)
      refine (dblB_fsp s _ ε T[M - k - 1] (T.take (M - k - 1)).reverse he he' hTa.1 hTa.2 ?_).congr ?_
      · simp +decide [hF, htake]
      · congr 1; funext x
        simp only [hF, Function.update_apply, e1, hdrop, htake]
        by_cases x1 : x = xB
        · subst x1; simp +decide
        by_cases x2 : x = xC
        · subst x2; simp +decide
        by_cases x3 : x = xA
        · subst x3; simp +decide [hg]
        simp [x1, x2, x3])
  have hFM : F M = Function.update (Function.update (Function.update f xA (T.map g ++ R)) xB [])
      xC T := by simp [hF]
  rw [hFM] at m2
  simp only [Ex.cost, top_encK hF0N] at m2
  -- 3. T to xD, then back on top of xA
  set f3 := Function.update (Function.update (Function.update f xA (T.map g ++ R)) xB []) xC T
  have m3 := FSp.mvN (X := xC) (Y := xD) (C := NLogN.KFB.c1) (r := xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f3 T [] (by simp +decide [f3])
    (Lr := s.G xN) (by simp +decide [f3, hN, ints, hM]) 4 hT.bnd
  set f4 := Function.update (Function.update f3 xC []) xD (T.reverse ++ f3 xD)
  have m4 := FSp.mvN (X := xD) (Y := xA) (C := NLogN.KFB.c1) (r := xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f4 T.reverse [] (by simp +decide [f4, f3, hD])
    (Lr := s.G xN) (by simp +decide [f4, f3, hN, ints, hM]) 4 (NLogN.KIL.bnd_reverse hT.bnd)
  set f5 := Function.update (Function.update f4 xD []) xA (T.reverse.reverse ++ f4 xA)
  have hN5 : f5 xN = [(M : ℤ)] := by simp +decide [f5, f4, f3, hN]
  have hZM : zsz (M : ℤ) ≤ Z := le_trans (zsz_natCast_le (by omega)) hZ
  have m5 := Sp.asg s f5 (i := xN) (e := .add (.reg xN) (.reg xN)) (B := Z) (by decide) hN5 hZM
    (clean_add (clean_reg (by decide)) (clean_reg (by decide))) ⟨isInt_encK hN5, isInt_encK hN5⟩
    ⟨trivial, trivial⟩ ⟨bnd_reg hN5 hZM, bnd_reg hN5 hZM, by
      simp only [Ex.eval, top_encK hN5]; exact le_trans (le_of_eq (by push_cast; ring_nf)) hZ⟩
  rw [eval_add_reg hN5 hN5] at m5
  refine (m1.seq (m2.seq (m3.seq (m4.seq (FSp.of_norep rfl m5))))).mono ?_ |>.congr ?_
  · simp only [Ex.size, cDbl, cRep, List.length_reverse, dupCost, zipCost, moveCost]
    have h1 := zsz_natCast_le (show M ≤ 2 * M by omega)
    have h2 : zsz (M : ℤ) ≤ Z := le_trans h1 hZ
    have h3 : T.length = M := hM.symm
    omega
  · congr 1; funext x
    simp only [f5, f4, f3, Function.update_apply]
    by_cases x1 : x = xN
    · subst x1; simp +decide; ring
    by_cases x2 : x = xA
    · subst x2; simp +decide [dblL, hg]
    by_cases x3 : x = xB
    · subst x3; simp +decide [hB]
    by_cases x4 : x = xC
    · subst x4; simp +decide [hC]
    by_cases x5 : x = xD
    · subst x5; simp +decide [hD]
    simp [x1, x2, x3, x4, x5]

theorem ex4_tbl (u : ℕ) (aE : ℕ → ℕ) : ∀ t, Ex4 (tbl u aE t)
  | 0 => by intro a ha; simp [tbl] at ha; subst ha; omega
  | t + 1 => by
    intro a ha
    simp only [tbl, dblL, List.mem_append, List.mem_map] at ha
    rcases ha with ha | ⟨x, -, rfl⟩
    · exact ex4_tbl u aE t a ha
    · omega

theorem tblP_fsp (s : IState HS) (u : ℕ) (aE : ℕ → ℕ) (f : Fin HS → List ℤ) (R : List ℤ)
    (hA : f xA = tbl u aE 0 ++ R) (hB : f xB = []) (hC : f xC = []) (hD : f xD = [])
    (hc : f NLogN.KFB.c1 = []) (hN : f xN = [1]) (Z : ℕ) :
    ∀ t, zsz ((2 ^ t : ℕ) : ℤ) ≤ Z →
    FSp (tblP aE t) (encK s f) (encK s (Function.update (Function.update f xA (tbl u aE t ++ R))
      xN [((2 ^ t : ℕ) : ℤ)])) (cTbl t Z)
  | 0, _ => by
    refine (FSp.skip _).mono (by simp [cTbl]) |>.congr ?_
    congr 1; funext x
    by_cases x1 : x = xN
    · subst x1; simp +decide [hN]
    by_cases x2 : x = xA
    · subst x2; simp +decide [hA]
    simp [x1, x2]
  | t + 1, hZ => by
    have IH := tblP_fsp s u aE f R hA hB hC hD hc hN Z t
      (le_trans (zsz_natCast_le (Nat.pow_le_pow_right (by norm_num) (by omega))) hZ)
    have hl := length_tbl u aE t
    have D := dbl_fsp s (Function.update (Function.update f xA (tbl u aE t ++ R)) xN
      [((2 ^ t : ℕ) : ℤ)]) ((aE t % 4 : ℕ) : ℤ) (by omega) (by omega) (tbl u aE t) R
      (ex4_tbl u aE t) (by simp +decide) (by simp +decide [hB]) (by simp +decide [hC])
      (by simp +decide [hD]) (by simp +decide [hc]) (by simp +decide [hl]) Z
      (by rw [hl, ← pow_succ']; exact hZ)
    refine (IH.seq D).mono ?_ |>.congr ?_
    · rw [hl]; simp only [cTbl, cDbl, pow_succ]; nlinarith
    · congr 1; funext x
      by_cases x1 : x = xN
      · subst x1; simp +decide [hl, pow_succ]; ring
      by_cases x2 : x = xA
      · subst x2; simp +decide [tbl]
      simp [x1, x2]

theorem clean_of_all (e : Ex HS) (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean := fun i hi hz => by
  have := h i hi
  rw [zX_all] at hz
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hz
  rcases hz with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> revert this <;> decide

theorem clean_reE : NLogN.KFG.reE.Clean := clean_of_all _ (by decide)
theorem clean_imE : NLogN.KFG.imE.Clean := clean_of_all _ (by decide)

theorem rot_bnd {e : ℤ} (z : GI) {w : ℕ} (h0 : 0 ≤ e) (h4 : e < 4) (hz : zsz z.1 ≤ w ∧ zsz z.2 ≤ w) :
    zsz (rot e z).1 ≤ w ∧ zsz (rot e z).2 ≤ w := by
  rcases (show e = 0 ∨ e = 1 ∨ e = 2 ∨ e = 3 by omega) with rfl | rfl | rfl | rfl <;>
    simp [rot, zsz_neg, hz]

section
variable {s : IState HS} {f : Fin HS → List ℤ} {e x y : ℤ} {A X Y : List ℤ}

theorem rotE_facts (hA : f xA = e :: A) (hX : f rUr = x :: X) (hY : f rUi = y :: Y)
    (h0 : 0 ≤ e) (h4 : e < 4) {w : ℕ} (hx : zsz x ≤ w) (hy : zsz y ≤ w) :
    NLogN.KFG.reE.ok (encK s f) ∧ NLogN.KFG.reE.Bnd (encK s f) (w + 4) ∧ NLogN.KFG.reE.eval (encK s f) = (rot e (x, y)).1 ∧
    NLogN.KFG.imE.ok (encK s f) ∧ NLogN.KFG.imE.Bnd (encK s f) (w + 4) ∧ NLogN.KFG.imE.eval (encK s f) = (rot e (x, y)).2 := by
  have iA := isInt_encK (s := s) hA; have iX := isInt_encK (s := s) hX
  have iY := isInt_encK (s := s) hY
  have s1 : zsz (1 : ℤ) ≤ w + 4 := by rw [zsz_one]; omega
  have sx : zsz x ≤ w + 4 := by omega
  have sy : zsz y ≤ w + 4 := by omega
  have se : ∀ k : ℤ, -4 < e + -k → e + -k < 4 → -4 < -k → -k < 4 → zsz (e + -k) ≤ w + 4 ∧
      zsz (-k) ≤ w + 4 ∧ zsz e ≤ w + 4 := fun k a b c d =>
    ⟨le_trans (small_zsz (by omega) (by omega)) (by omega),
      le_trans (small_zsz (by omega) (by omega)) (by omega),
      le_trans (small_zsz (by omega) (by omega)) (by omega)⟩
  rcases (show e = 0 ∨ e = 1 ∨ e = 2 ∨ e = 3 by omega) with rfl | rfl | rfl | rfl
  all_goals
    obtain ⟨a1, b1, c1'⟩ := se 1 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    obtain ⟨a2, b2, c2'⟩ := se 2 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    obtain ⟨a3, b3, c3'⟩ := se 3 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    simp only [NLogN.KFG.reE, NLogN.KFG.imE, ckE, Ex.ok, Ex.Bnd, Ex.eval, top_encK hA, top_encK hX, top_encK hY, rot]
    norm_num
    simp_all [zsz_neg]

end

theorem mulB_fsp (s : IState HS) (f : Fin HS → List ℤ) (z : GI) (D : List ℤ) (e : ℤ)
    (A : List ℤ) (h0 : f 0 = z.1 :: z.2 :: D) (hA : f xA = e :: A) (hX : f rUr = [])
    (hY : f rUi = []) (he0 : 0 ≤ e) (he4 : e < 4) {w : ℕ} (hz : zsz z.1 ≤ w ∧ zsz z.2 ≤ w) :
    FSp mulB (encK s f) (encK s (Function.update (Function.update (Function.update
      (Function.update f 0 D) xA A) xB (e :: f xB)) qO ((rot e z).2 :: (rot e z).1 :: f qO)))
      (cMulB w) := by
  have b1 : zsz z.1 ≤ w + 4 := by omega
  have b2 : zsz z.2 ≤ w + 4 := by omega
  have be : zsz e ≤ w + 4 := le_trans (small_zsz (by omega) (by omega)) (by omega)
  have p1 := Sp.push s f (i := rUr) (e := .reg 0) (B := w + 4) (by decide) (clean_reg (by decide))
    (isInt_encK h0) trivial (bnd_reg h0 b1)
  rw [show (Ex.reg 0).eval (encK s f) = z.1 by simp only [Ex.eval, top_encK h0], hX] at p1
  set f1 := Function.update f rUr [z.1]
  have p2 := Sp.pop s f1 (i := 0) (a := z.1) (l := z.2 :: D) (B := w + 4) (by decide)
    (by simp +decide [f1, h0]) b1
  set f2 := Function.update f1 0 (z.2 :: D)
  have h2 : f2 0 = z.2 :: D := by simp [f2]
  have p3 := Sp.push s f2 (i := rUi) (e := .reg 0) (B := w + 4) (by decide) (clean_reg (by decide))
    (isInt_encK h2) trivial (bnd_reg h2 b2)
  rw [show (Ex.reg 0).eval (encK s f2) = z.2 by simp only [Ex.eval, top_encK h2],
    show f2 rUi = [] by simp +decide [f2, f1, hY]] at p3
  set f3 := Function.update f2 rUi [z.2]
  have p4 := Sp.pop s f3 (i := 0) (a := z.2) (l := D) (B := w + 4) (by decide)
    (by simp +decide [f3, h2]) b2
  set f4 := Function.update f3 0 D
  have hA4 : f4 xA = e :: A := by simp +decide [f4, f3, f2, f1, hA]
  have hX4 : f4 rUr = z.1 :: [] := by simp +decide [f4, f3, f2, f1]
  have hY4 : f4 rUi = z.2 :: [] := by simp +decide [f4, f3, f2, f1]
  obtain ⟨o1, n1, v1, -, -, -⟩ := rotE_facts (s := s) hA4 hX4 hY4 he0 he4 hz.1 hz.2
  have p5 := Sp.push s f4 (i := qO) (e := NLogN.KFG.reE) (B := w + 4) (by decide) clean_reE o1
    (by simp [NLogN.KFG.reE, ckE, Ex.Lin]) n1
  rw [v1] at p5
  set f5 := Function.update f4 qO ((rot e (z.1, z.2)).1 :: f4 qO)
  have hA5 : f5 xA = e :: A := by simp +decide [f5, hA4]
  have hX5 : f5 rUr = z.1 :: [] := by simp +decide [f5, hX4]
  have hY5 : f5 rUi = z.2 :: [] := by simp +decide [f5, hY4]
  obtain ⟨-, -, -, o2, n2, v2⟩ := rotE_facts (s := s) hA5 hX5 hY5 he0 he4 hz.1 hz.2
  have p6 := Sp.push s f5 (i := qO) (e := NLogN.KFG.imE) (B := w + 4) (by decide) clean_imE o2
    (by simp [NLogN.KFG.imE, ckE, Ex.Lin]) n2
  rw [v2] at p6
  set f6 := Function.update f5 qO ((rot e (z.1, z.2)).2 :: f5 qO)
  have p7 := Sp.pop s f6 (i := rUr) (a := z.1) (l := []) (B := w + 4) (by decide)
    (by simp +decide [f6, hX5]) b1
  set f7 := Function.update f6 rUr []
  have p8 := Sp.pop s f7 (i := rUi) (a := z.2) (l := []) (B := w + 4) (by decide)
    (by simp +decide [f7, f6, hY5]) b2
  set f8 := Function.update f7 rUi []
  have hA8 : f8 xA = e :: A := by simp +decide [f8, f7, f6, hA5]
  have p9 := Sp.push s f8 (i := xB) (e := .reg xA) (B := w + 4) (by decide)
    (clean_reg (by decide)) (isInt_encK hA8) trivial (bnd_reg hA8 be)
  rw [show (Ex.reg xA).eval (encK s f8) = e by simp only [Ex.eval, top_encK hA8]] at p9
  set f9 := Function.update f8 xB (e :: f8 xB)
  have p10 := Sp.pop s f9 (i := xA) (a := e) (l := A) (B := w + 4) (by decide)
    (by simp +decide [f9, hA8]) be
  have F := fun {p : RS} {a b : IState HS} {c : ℕ} (h : Sp p a b c) (hr : norep p = true) =>
    FSp.of_norep hr h
  refine ((F p1 rfl).seq ((F p2 rfl).seq ((F p3 rfl).seq ((F p4 rfl).seq ((F p5 rfl).seq
    ((F p6 rfl).seq ((F p7 rfl).seq ((F p8 rfl).seq ((F p9 rfl).seq (F p10 rfl)))))))))).mono
    ?_ |>.congr ?_
  · simp only [Ex.size, NLogN.KFG.reE, NLogN.KFG.imE, ckE, cMulB]; omega
  · congr 1; funext x
    simp only [f9, f8, f7, f6, f5, f4, f3, f2, f1, Function.update_apply]
    by_cases x1 : x = 0
    · subst x1; simp +decide
    by_cases x2 : x = rUr
    · subst x2; simp +decide [hX]
    by_cases x3 : x = rUi
    · subst x3; simp +decide [hY]
    by_cases x4 : x = qO
    · subst x4; simp +decide
    by_cases x5 : x = xB
    · subst x5; simp +decide
    by_cases x6 : x = xA
    · subst x6; simp +decide
    simp [x1, x2, x3, x4, x5, x6]

theorem mulL_take_succ (T : List ℤ) (zs : List GI) (k : ℕ) (hT : k < T.length)
    (hz : k < zs.length) :
    mulL (T.take (k + 1)) (zs.take (k + 1)) = mulL (T.take k) (zs.take k) ++ [rot T[k] zs[k]] := by
  simp only [mulL, List.take_succ_eq_append_getElem hT, List.take_succ_eq_append_getElem hz]
  rw [List.zipWith_append (by simp; omega)]
  rfl

theorem mulLoop_fsp (s : IState HS) (f : Fin HS → List ℤ) (T : List ℤ) (zs : List GI)
    (l : List ℤ) (hT : Ex4 T) (hl : T.length = zs.length) (h0 : f 0 = gflat zs ++ l)
    (hA : f xA = T) (hB : f xB = []) (hO : f qO = []) (hX : f rUr = []) (hY : f rUi = [])
    (hc : f NLogN.KFB.c1 = []) (hN : f xN = [(T.length : ℤ)]) {w : ℕ} (hb : NLogN.KFB.GB w zs) :
    FSp (.rep NLogN.KFB.c1 (.reg xN) mulB) (encK s f) (encK s (Function.update (Function.update
      (Function.update (Function.update f 0 l) xA []) xB T.reverse) qO
        (gflat (mulL T zs)).reverse))
      ((Ex.reg xN).cost (encK s f) + cRep T.length + T.length * cMulB w) := by
  set F : ℕ → Fin HS → List ℤ := fun k => Function.update (Function.update (Function.update
    (Function.update f 0 (gflat (zs.drop k) ++ l)) xA (T.drop k)) xB (T.take k).reverse) qO
      (gflat (mulL (T.take k) (zs.take k))).reverse with hF
  have F0 : F 0 = f := by
    funext x
    simp only [hF, Function.update_apply, List.drop_zero, List.take_zero]
    by_cases x1 : x = 0
    · subst x1; simp +decide [h0]
    by_cases x2 : x = xA
    · subst x2; simp +decide [hA]
    by_cases x3 : x = xB
    · subst x3; simp +decide [hB]
    by_cases x4 : x = qO
    · subst x4; simp +decide [hO, mulL]
    simp [x1, x2, x3, x4]
  have hF0N : F 0 xN = [(T.length : ℤ)] := by rw [F0]; exact hN
  have R := FSp.rep (C := NLogN.KFB.c1) (n := .reg xN) (b := mulB) (s := s) (F := F) (N := T.length)
    (c := cMulB w) (by decide) (fun k => by simp +decide [hF, hc])
    (by simp +decide [mulB, RS.writes]) (clean_reg (by decide)) (isInt_encK hF0N)
    (by simp only [Ex.eval, top_encK hF0N])
    (by
      intro k hk
      have hk' : k < zs.length := by omega
      have hdz : zs.drop k = zs[k] :: zs.drop (k + 1) := List.drop_eq_getElem_cons hk'
      have hdT : T.drop k = T[k] :: T.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hTk := hT _ (List.getElem_mem hk)
      refine (mulB_fsp s _ zs[k] (gflat (zs.drop (k + 1)) ++ l) T[k] (T.drop (k + 1)) ?_ ?_ ?_ ?_
        hTk.1 hTk.2 (hb _ (List.getElem_mem hk'))).congr ?_
      · simp only [hF, Function.update_apply]; simp +decide only [if_true, if_false]
        rw [hdz]; rfl
      · simp only [hF, Function.update_apply]; simp +decide only [if_true, if_false]; exact hdT
      · simp +decide [hF, hX]
      · simp +decide [hF, hY]
      · congr 1; funext x
        simp only [hF, Function.update_apply, mulL_take_succ T zs k hk hk',
          List.take_succ_eq_append_getElem hk]
        by_cases x1 : x = 0
        · subst x1; simp +decide
        by_cases x2 : x = xA
        · subst x2; simp +decide
        by_cases x3 : x = xB
        · subst x3; simp +decide
          have := List.take_succ_eq_append_getElem hk
          rw [this, List.reverse_append]; rfl
        by_cases x4 : x = qO
        · subst x4; simp +decide; rw [mulL_take_succ T zs k hk hk']; simp [gflat_append]
        by_cases x5 : x = NLogN.KFB.c1
        · subst x5; simp +decide
        simp [x1, x2, x3, x4, x5])
  rw [F0] at R
  refine R.congr ?_
  congr 1; funext x
  simp only [hF, Function.update_apply, List.drop_length, List.take_length, hl,
    List.drop_eq_nil_of_le (le_of_eq hl.symm), List.take_of_length_le (le_of_eq hl.symm)]
  rw [← hl]
  simp [List.take_length]

/-- Discard `|L|` entries of `xB`. -/
theorem dropLoop_fsp (s : IState HS) (f : Fin HS → List ℤ) (L : List ℤ) (hL : Bnd 4 L)
    (hB : f xB = L) (hc : f NLogN.KFB.c1 = []) (hN : f xN = [(L.length : ℤ)]) :
    FSp (.rep NLogN.KFB.c1 (.reg xN) (.pop xB)) (encK s f) (encK s (Function.update f xB []))
      ((Ex.reg xN).cost (encK s f) + cRep L.length + L.length * 10) := by
  set F : ℕ → Fin HS → List ℤ := fun k => Function.update f xB (L.drop k) with hF
  have F0 : F 0 = f := by simp only [hF, List.drop_zero]; rw [← hB]; exact Function.update_eq_self _ _
  have hF0N : F 0 xN = [(L.length : ℤ)] := by rw [F0]; exact hN
  have R := FSp.rep (C := NLogN.KFB.c1) (n := .reg xN) (b := .pop xB) (s := s) (F := F) (N := L.length)
    (c := 10) (by decide) (fun k => by simp +decide [hF, hc]) (by decide) (clean_reg (by decide))
    (isInt_encK hF0N) (by simp only [Ex.eval, top_encK hF0N])
    (by
      intro k hk
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      refine (FSp.of_norep rfl (Sp.pop s _ (i := xB) (a := L[k]) (l := L.drop (k + 1)) (B := 4)
        (by decide) (by simp only [hF, Function.update_apply]; simp +decide only [if_true, if_false]; exact hd) (hL _ (List.getElem_mem hk)))).mono (by norm_num)
        |>.congr ?_
      congr 1; funext x
      simp only [hF, Function.update_apply]
      by_cases h1 : x = xB
      · subst h1; simp +decide
      by_cases h2 : x = NLogN.KFB.c1
      · subst h2; simp +decide
      simp [h1, h2])
  rw [F0] at R
  exact R.congr (by simp [hF])

theorem GB_mulL {w : ℕ} (T : List ℤ) (zs : List GI) (hT : Ex4 T) (hb : NLogN.KFB.GB w zs) :
    NLogN.KFB.GB w (mulL T zs) := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  simp only [mulL, List.getElem_zipWith]
  simp only [mulL, List.length_zipWith] at hi
  have h1 := hT _ (List.getElem_mem (show i < T.length by omega))
  exact rot_bnd _ h1.1 h1.2 (hb _ (List.getElem_mem (show i < zs.length by omega)))

theorem length_mulL (T : List ℤ) (zs : List GI) (h : T.length = zs.length) :
    (mulL T zs).length = zs.length := by simp [mulL, h]

end NLogN.KFG

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFG
open IntMul RS AModel KIL KFD KFB Complex
theorem solution (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (K off u : ℕ) (aE : ℕ → ℕ)
    (pre seg : List NLogN.KFB.GI) (l : List ℤ) (hpre : pre.length = off) (hseg : seg.length = 2 ^ K)
    (h0 : f 0 = NLogN.KFB.gflat pre ++ (NLogN.KFB.gflat seg ++ l)) (hC : NLogN.KFG.ClT f) {w : ℕ} (hbp : NLogN.KFB.GB w pre)
    (hbs : NLogN.KFB.GB w seg) (Z : ℕ) (hZ : NLogN.zsz ((4 * (off + 2 ^ K) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFD.FSp (NLogN.KFG.phT K off u aE) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat pre ++ (NLogN.KFB.gflat (NLogN.KFG.mulL (NLogN.KFG.tbl u aE K) seg) ++ l))))
      (NLogN.KFG.cPhT w K off Z) := by
  have zl : ∀ k : ℕ, k ≤ 4 * (off + 2 ^ K) → NLogN.zsz (k : ℤ) ≤ Z :=
    fun k hk => le_trans (NLogN.zsz_natCast_le hk) hZ
  have hK1 : 1 ≤ 2 ^ K := Nat.one_le_two_pow
  set T := NLogN.KFG.tbl u aE K with hTd
  have hTl : T.length = 2 ^ K := NLogN.KFG.length_tbl u aE K
  have hT4 : NLogN.KFG.Ex4 T := NLogN.KFG.ex4_tbl u aE K
  -- 1. park the prefix
  have p1 := NLogN.KIL.Sp.push s f (i := NLogN.KFB.rP) (e := .lit ((2 * off : ℕ) : ℤ)) (B := Z) (by decide)
    (NLogN.KIL.clean_lit _) trivial trivial (zl _ (by omega))
  rw [show NLogN.Ex.eval (NLogN.KIL.encK s f) (.lit ((2 * off : ℕ) : ℤ)) :: f NLogN.KFB.rP = [((2 * off : ℕ) : ℤ)] by
    simp [NLogN.Ex.eval, hC.rp]] at p1
  set f1 := Function.update f NLogN.KFB.rP [((2 * off : ℕ) : ℤ)]
  have m2 := NLogN.KFB.FSp.mvN (X := 0) (Y := NLogN.KFB.qP) (C := NLogN.KFB.c1) (r := NLogN.KFB.rP) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f1 (NLogN.KFB.gflat pre) (NLogN.KFB.gflat seg ++ l)
    (by simp +decide [f1, h0]) (Lr := s.G NLogN.KFB.rP) (by simp +decide [f1, NLogN.ints, hpre]) w hbp.bnd
  set f2 := Function.update (Function.update f1 0 (NLogN.KFB.gflat seg ++ l)) NLogN.KFB.qP ((NLogN.KFB.gflat pre).reverse ++ f1 NLogN.KFB.qP)
  -- 2. the table
  have p3 := NLogN.KIL.Sp.push s f2 (i := NLogN.KFG.xA) (e := .lit ((u % 4 : ℕ) : ℤ)) (B := Z) (by decide)
    (NLogN.KIL.clean_lit _) trivial trivial (zl _ (by omega))
  rw [show NLogN.Ex.eval (NLogN.KIL.encK s f2) (.lit ((u % 4 : ℕ) : ℤ)) :: f2 NLogN.KFG.xA = [((u % 4 : ℕ) : ℤ)] by
    simp +decide [NLogN.Ex.eval, f2, f1, hC.a]] at p3
  set f3 := Function.update f2 NLogN.KFG.xA [((u % 4 : ℕ) : ℤ)]
  have p4 := NLogN.KIL.Sp.push s f3 (i := NLogN.KFG.xN) (e := .lit 1) (B := Z) (by decide)
    (NLogN.KIL.clean_lit _) trivial trivial (by have := zl 1 (by omega); simpa [NLogN.Ex.Bnd] using this)
  rw [show NLogN.Ex.eval (NLogN.KIL.encK s f3) (.lit 1) :: f3 NLogN.KFG.xN = [1] by
    simp +decide [NLogN.Ex.eval, f3, f2, f1, hC.n]] at p4
  set f4 := Function.update f3 NLogN.KFG.xN [1]
  have t5 := NLogN.KFG.tblP_fsp s u aE f4 [] (by simp +decide [f4, f3, NLogN.KFG.tbl]) (by simp +decide [f4, f3, f2, f1, hC.b])
    (by simp +decide [f4, f3, f2, f1, hC.c]) (by simp +decide [f4, f3, f2, f1, hC.d])
    (by simp +decide [f4, f3, f2, f1, hC.c1]) (by simp +decide [f4]) Z K (zl _ (by omega))
  rw [List.append_nil, ← hTd] at t5
  set f5 := Function.update (Function.update f4 NLogN.KFG.xA T) NLogN.KFG.xN [((2 ^ K : ℕ) : ℤ)]
  have hN5 : f5 NLogN.KFG.xN = [(T.length : ℤ)] := by simp +decide [f5, hTl]
  -- 3. multiply
  have m6 := NLogN.KFG.mulLoop_fsp s f5 T seg l hT4 (hTl.trans hseg.symm)
    (by simp +decide [f5, f4, f3, f2]) (by simp +decide [f5])
    (by simp +decide [f5, f4, f3, f2, f1, hC.b]) (by simp +decide [f5, f4, f3, f2, f1, hC.o])
    (by simp +decide [f5, f4, f3, f2, f1, hC.ur]) (by simp +decide [f5, f4, f3, f2, f1, hC.ui])
    (by simp +decide [f5, f4, f3, f2, f1, hC.c1]) hN5 hbs
  simp only [NLogN.Ex.cost, NLogN.KIL.top_encK hN5] at m6
  set f6 := Function.update (Function.update (Function.update (Function.update f5 0 l) NLogN.KFG.xA []) NLogN.KFG.xB
    T.reverse) NLogN.KFB.qO (NLogN.KFB.gflat (NLogN.KFG.mulL T seg)).reverse
  have hN6 : f6 NLogN.KFG.xN = [(T.reverse.length : ℤ)] := by simp +decide [f6, hN5]
  have d7 := NLogN.KFG.dropLoop_fsp s f6 T.reverse (NLogN.KIL.bnd_reverse hT4.bnd) (by simp +decide [f6])
    (by simp +decide [f6, f5, f4, f3, f2, f1, hC.c1]) hN6
  simp only [NLogN.Ex.cost, NLogN.KIL.top_encK hN6, List.length_reverse] at d7
  set f7 := Function.update f6 NLogN.KFG.xB []
  have hN7 : f7 NLogN.KFG.xN = [(T.length : ℤ)] := by simp +decide [f7, f6, hN5]
  have zT : NLogN.zsz (T.length : ℤ) ≤ Z := zl _ (by omega)
  have a8 := NLogN.KIL.Sp.asg s f7 (i := NLogN.KFG.xN) (e := .add (.reg NLogN.KFG.xN) (.reg NLogN.KFG.xN)) (B := Z) (by decide) hN7 zT
    (NLogN.KIL.clean_add (NLogN.KIL.clean_reg (by decide)) (NLogN.KIL.clean_reg (by decide))) ⟨NLogN.KIL.isInt_encK hN7, NLogN.KIL.isInt_encK hN7⟩
    ⟨trivial, trivial⟩ ⟨NLogN.KIL.bnd_reg hN7 zT, NLogN.KIL.bnd_reg hN7 zT, by
      simp only [NLogN.Ex.eval, NLogN.KIL.top_encK hN7]
      exact le_trans (le_of_eq (by push_cast; ring_nf)) (zl (2 * T.length) (by omega))⟩
  rw [NLogN.KIL.eval_add_reg hN7 hN7] at a8
  set f8 := Function.update f7 NLogN.KFG.xN [(T.length : ℤ) + T.length]
  -- 4. results back
  have hlo : (NLogN.KFB.gflat (NLogN.KFG.mulL T seg)).reverse.length = 2 * T.length := by
    simp [NLogN.KFG.length_mulL T seg (hTl.trans hseg.symm), hTl, hseg]
  have m9 := NLogN.KFB.FSp.mvN (X := NLogN.KFB.qO) (Y := 0) (C := NLogN.KFB.c1) (r := NLogN.KFG.xN) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f8 (NLogN.KFB.gflat (NLogN.KFG.mulL T seg)).reverse []
    (by simp +decide [f8, f7, f6]) (Lr := s.G NLogN.KFG.xN) (by simp +decide [f8, NLogN.ints, hlo]; ring) w
    (NLogN.KIL.bnd_reverse (NLogN.KFG.GB_mulL T seg hT4 hbs).bnd)
  set f9 := Function.update (Function.update f8 NLogN.KFB.qO []) 0
    ((NLogN.KFB.gflat (NLogN.KFG.mulL T seg)).reverse.reverse ++ f8 0)
  have p10 := NLogN.KIL.Sp.pop s f9 (i := NLogN.KFG.xN) (a := (T.length : ℤ) + T.length) (l := []) (B := Z)
    (by decide) (by simp +decide [f9, f8])
    (by have := zl (2 * T.length) (by omega); push_cast at this; rwa [two_mul] at this)
  set f10 := Function.update f9 NLogN.KFG.xN []
  -- 5. unpark
  have m11 := NLogN.KFB.FSp.mvN (X := NLogN.KFB.qP) (Y := 0) (C := NLogN.KFB.c1) (r := NLogN.KFB.rP) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f10 (NLogN.KFB.gflat pre).reverse []
    (by simp +decide [f10, f9, f8, f7, f6, f5, f4, f3, f2, f1, hC.p])
    (Lr := s.G NLogN.KFB.rP) (by simp +decide [f10, f9, f8, f7, f6, f5, f4, f3, f2, f1, NLogN.ints, hpre]) w
    (NLogN.KIL.bnd_reverse hbp.bnd)
  set f11 := Function.update (Function.update f10 NLogN.KFB.qP []) 0 ((NLogN.KFB.gflat pre).reverse.reverse ++ f10 0)
  have p12 := NLogN.KIL.Sp.pop s f11 (i := NLogN.KFB.rP) (a := ((2 * off : ℕ) : ℤ)) (l := []) (B := Z)
    (by decide) (by simp +decide [f11, f10, f9, f8, f7, f6, f5, f4, f3, f2, f1])
    (zl _ (by omega))
  have F := fun {p : NLogN.RS} {a b : NLogN.IState NLogN.HS} {c : ℕ} (h : NLogN.KIL.Sp p a b c) (hr : NLogN.KFD.norep p = true) =>
    NLogN.KFD.FSp.of_norep hr h
  refine ((F p1 rfl).seq (m2.seq ((F p3 rfl).seq ((F p4 rfl).seq (t5.seq (m6.seq (d7.seq
    ((F a8 rfl).seq (m9.seq ((F p10 rfl).seq (m11.seq (F p12 rfl)))))))))))).mono ?_ |>.congr ?_
  · simp only [NLogN.Ex.size, NLogN.KFB.length_gflat, List.length_reverse, hpre, hlo, NLogN.KFG.cPhT, NLogN.KFD.cRep, NLogN.dupCost,
      NLogN.zipCost, NLogN.moveCost, NLogN.KFG.cMulB]
    rw [hTl] at zT ⊢
    generalize 2 ^ K = X at zT ⊢
    generalize NLogN.KFG.cTbl K Z = C
    ring_nf
    nlinarith [zT]
  · congr 1; funext x
    simp only [f11, f10, f9, f8, f7, f6, f5, f4, f3, f2, f1, Function.update_apply]
    by_cases e0 : x = 0
    · subst e0; simp +decide
    by_cases e1 : x = NLogN.KFB.rP
    · subst e1; simp +decide [hC.rp]
    by_cases e2 : x = NLogN.KFB.qP
    · subst e2; simp +decide [hC.p]
    by_cases e3 : x = NLogN.KFG.xA
    · subst e3; simp +decide [hC.a]
    by_cases e4 : x = NLogN.KFG.xN
    · subst e4; simp +decide [hC.n]
    by_cases e5 : x = NLogN.KFG.xB
    · subst e5; simp +decide [hC.b]
    by_cases e6 : x = NLogN.KFB.qO
    · subst e6; simp +decide [hC.o]
    simp [e0, e1, e2, e3, e4, e5, e6]
end
