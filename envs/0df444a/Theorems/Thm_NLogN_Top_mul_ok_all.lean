theorem NLogN.Top.mul_ok_all {st : RM} {n₀ : ℕ} {lin : ℕ → ℕ} {calls : ℕ → List (ℕ × ℕ)}
    (hst : StepOK st n₀ lin calls) {I : List Sym} {iprog : Fin 5 → IStmt HS 5}
    (h1 : iprog 1 = (mulRM n₀ st).code 1 pcH)
    (h2 : iprog 2 = (difBody 2).ren ssH id) (h3 : iprog 3 = (ditBody 3).ren ssH id)
    (h4 : iprog 4 = blenProc) (G : ℕ → ℕ) (hGm : Monotone G)
    (hG : ∀ N, topCost n₀ N + (if N < n₀ then smallCost N else
        lin N + ((calls N).map fun q => q.1 * G q.2).sum) + 2 ≤ G N) :
    ∀ n, MulOK I iprog 1 (Mlt G n) := by sorry
