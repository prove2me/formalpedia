variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem NLogN.mvN_runs {X Y C : Fin NS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX3 : X ≠ NLogN.T3)
    (hY3 : Y ≠ NLogN.T3) (hC3 : C ≠ NLogN.T3) (s : IState NS) (A : List ℤ) (R LC : List Item) (m : ℕ)
    (hX : s.G X = ints A ++ R) (hC : s.G C = .int A.length :: LC) (hA : NLogN.Bnd m A) :
    IRuns I iprog (NLogN.mvN X Y C) s
      (((s.upd X R).upd Y ((ints A).reverse ++ s.G Y)).upd C (.int 0 :: LC))
      (A.length * (1000 * (m + zsz (A.length : ℤ) + 3)) + 30) := by sorry
