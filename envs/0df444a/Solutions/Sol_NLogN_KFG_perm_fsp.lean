theorem PCnt.congr {s : IState HS} {f g : Fin HS → List ℤ} {L P Q : ℕ} (h : PCnt s f L P Q)
    (h1 : g NLogN.KFB.rB = f NLogN.KFB.rB) (h2 : g rB2 = f rB2) (h3 : g NLogN.KFB.rP = f NLogN.KFB.rP) (h4 : g rQ = f rQ) :
    PCnt s g L P Q :=
