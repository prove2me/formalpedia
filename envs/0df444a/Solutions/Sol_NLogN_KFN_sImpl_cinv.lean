open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
theorem solution {r : ℕ} (hr : 0 < r) (pos : κ → ℕ) (t S0 B : ℕ) (hpos : ∀ p, pos p < t)
    (hS : 0 < S0) (hB : 1 ≤ B) (hs : NLogN.KFN.SLaws (fun c => 2 ^ pos c * S0) (B * 2 ^ t * S0))
    {code : ℕ → NLogN.IStmt NLogN.HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (H : NLogN.KFN.SImplI Isym iprog r (fun c => 2 ^ pos c * S0) (B * 2 ^ t * S0) (Butterfly.tens Butterfly.Cm : Butterfly.Op κ)
      code e dw cost)
    (Z : ℕ) (hZ1 : NLogN.zsz ((4 * (B * (S0 * r * 2 ^ t) + S0 * r + B + 1) : ℕ) : ℤ) ≤ Z) :
    NLogN.KFN.SImplI Isym iprog r (fun c => 2 ^ pos c * S0) (B * 2 ^ t * S0) (Butterfly.tens Butterfly.Cinv : Butterfly.Op κ)
      (NLogN.KFN.cinvC pos S0 r t B code dw) (0 + e + 0) (0 + dw + 0)
      (fun w => (NLogN.KFN.cPhL w (B * (S0 * r * 2 ^ t)) t B Z + cost (w + 0)) +
        NLogN.KFN.cPhL (w + (0 + dw)) (B * (S0 * r * 2 ^ t)) t B Z) := by
  have P1 := (NLogN.KFN.sImpl_phase r S0 t B 0 pos hpos (fun _ => 2) hr hS hB Z hZ1).toI (I := Isym)
    (iprog := iprog) (NLogN.KFN.fok_phL _ _ _ _ _)
  have P2 := (NLogN.KFN.sImpl_phase r S0 t B (3 * Fintype.card κ) pos hpos (fun _ => 2) hr hS hB Z
    hZ1).toI (I := Isym) (iprog := iprog) (NLogN.KFN.fok_phL _ _ _ _ _)
  have C := (P1.comp hs H).comp hs P2
  refine C.congrT ?_
  rw [NLogN.KFN.diag_ZD, NLogN.KFN.diag_ZD', Butterfly.tens_Cinv', smul_mul_assoc, mul_assoc]
end
