  unfold FSc FSb
  suffices H : ∀ ls : List Line, ls.foldr (fun l c => lineP K ρ f l c) c =
      ofP c.1 (ls.foldr (fun l p => pline K ρ f c.1 (negL l) p) (nmP c)) from H lines
  intro ls
  induction ls with
  | nil => exact (ofP_nmP c).symm
  | cons l ls ih =>
    simp only [List.foldr_cons]
    rw [ih]
    have hv := VP_foldr (K := K) (ρ := ρ) (f := f) c.1 ls (nmP c) (VP_nmP c hc)
    rw [lineP_eq l _ (TV_ofP _ hc.1 _ hv)]
    simp only [ofP]
    rw [show ((((ls.foldr (fun l p => pline K ρ f c.1 (negL l) p) (nmP c)).1.toNat : ℕ) : ℤ),
        (((ls.foldr (fun l p => pline K ρ f c.1 (negL l) p) (nmP c)).2.toNat : ℕ) : ℤ)) =
        ls.foldr (fun l p => pline K ρ f c.1 (negL l) p) (nmP c) from
      Prod.ext (Int.toNat_of_nonneg hv.1) (Int.toNat_of_nonneg hv.2.2.1)]

theorem S0c_eq (c : Tr) : S0c K ρ f c = ofP c.1 (S0 K ρ f c.1 (nmP c)) := rfl

theorem TV_S0c (c : Tr) (hc : TV (2 ^ (f * K)) c) : TV (2 ^ (f * K)) (S0c K ρ f c) :=
  TV_ofP _ hc.1 _ (VP_S0 _ _ (VP_nmP c hc))

theorem FSc_S0c (c : Tr) (hc : TV (2 ^ (f * K)) c) : FSc K ρ f (S0c K ρ f c) = c := by
  rw [FSc_eq _ (TV_S0c c hc), S0c_eq]
  simp only [ofP]
  rw [show nmP (c.1, (S0 K ρ f (↑c.1) (nmP c)).1.toNat, (S0 K ρ f (↑c.1) (nmP c)).2.toNat) =
    S0 K ρ f c.1 (nmP c) from nmP_ofP c.1 _ (VP_S0 _ _ (VP_nmP c hc))]
  rw [FSb_S0 _ _ (VP_nmP c hc)]
  exact ofP_nmP c

theorem T0c_T0c (c : Tr) : T0c K ρ f (T0c K ρ f c) = c := by
  simp only [T0c, Nat.xor_assoc, Nat.xor_self, Nat.xor_zero]

theorem TV_T0c (c : Tr) (hc : TV (2 ^ (f * K)) c) : TV (2 ^ (f * K)) (T0c K ρ f c) := by
  refine ⟨hc.1, ?_, hc.2.2⟩
  simp only [T0c]
  exact Nat.xor_lt_two_pow hc.2.1 (lt_of_le_of_lt Nat.and_le_left hc.1)

theorem guardOK_xor (hK : 1 ≤ K) (y m : ℕ)
    (hm : ∀ p, m.testBit p = true → (selM K ρ (f - 1)).testBit p = true) :
    GuardOK K ρ f ((y ^^^ m : ℕ) : ℤ) ↔ GuardOK K ρ f (y : ℤ) := by
  unfold GuardOK
  simp only [guard_natCast, guardN_xor hK ρ (f - 1) y m _ hm]

theorem good_T0c (hK : 1 ≤ K) (c : Tr) : good K ρ f (T0c K ρ f c) ↔ good K ρ f c := by
  unfold good T0c
  simp only
  rw [guardOK_xor hK]
  intro p hp
  rw [Nat.testBit_and] at hp
  simp only [Bool.and_eq_true] at hp
  exact hp.2

theorem S0c_good (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (c : Tr) (hc : TV (2 ^ (f * K)) c)
    (hg : good K ρ f c) : S0c K ρ f c = T0c K ρ f c := by
  have hy : (0 : ℤ) ≤ c.2.1 ∧ (c.2.1 : ℤ) < 2 ^ (f * K) := ⟨by positivity, by exact_mod_cast hc.2.1⟩
  have hz : (0 : ℤ) ≤ c.2.2 ∧ (c.2.2 : ℤ) < 2 ^ (f * K) := ⟨by positivity, by exact_mod_cast hc.2.2⟩
  have := S0_eq_T0 hρK hf (c.1 : ℤ) (c.2.1 : ℤ) (c.2.2 : ℤ) hy hz hg.1 hg.2
  rw [S0c_eq, ofP, nmP, this, T0y_eq (by omega)]
  simp [T0c]

end Facts

end NLogN.KFL

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open Butterfly
variable {K ρ f : ℕ}
theorem solution (hK : 6 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) (c : NLogN.KFL.Tr) (hc : NLogN.KFL.TV (2 ^ (f * K)) c)
    (hg : NLogN.KFL.good K ρ f c) : NLogN.KFL.FSc K ρ f c = NLogN.KFL.T0c K ρ f c := by
  have hd := NLogN.KFL.TV_T0c (ρ := ρ) c hc
  have hgd : NLogN.KFL.good K ρ f (NLogN.KFL.T0c K ρ f c) := (NLogN.KFL.good_T0c (by omega) c).2 hg
  have e := NLogN.KFL.S0c_good hK hρK hf _ hd hgd
  rw [NLogN.KFL.T0c_T0c] at e
  have := NLogN.KFL.FSc_S0c (ρ := ρ) _ hd
  rw [e] at this
  exact this
end
