-- title:
--   §3.1 — for a sampling operator, $\mathcal A^*\mathcal A=P_\Omega$ and (3.3) becomes (2.7)
-- statement:
--   Let $\omega:\{1,\dots,m\}\to\{1,\dots,n_1\}\times\{1,\dots,n_2\}$ be injective with image $\Omega$, and let $\mathcal A$ be the sampling operator $\mathcal A(X)_i=X_{\omega(i)}$, which extracts the $m$ entries with indices in $\Omega$. Then:
--
--   1. $\mathcal A^*\mathcal A=P_\Omega$, i.e. $\mathcal A^*(\mathcal A(X))=P_\Omega(X)$ for every $X$;
--   2. for every $\tau$, step sizes $\{\delta_k\}$, and every $M$ with $\mathcal A(M)=b$: if $(X^k,y^k)$ is generated by Uzawa's iteration (3.3) from $y^0=0$,
--   $$X^k=\mathcal D_\tau(\mathcal A^*(y^{k-1})),\qquad y^k=y^{k-1}+\delta_k(b-\mathcal A(X^k)),$$
--   then $(X^k, Y^k)$ with $Y^k=\mathcal A^*(y^k)$ is generated by the SVT iteration (2.7) from $Y^0=0$:
--   $$X^k=\mathcal D_\tau(Y^{k-1}),\qquad Y^k=Y^{k-1}+\delta_kP_\Omega(M-X^k).$$
--
--   This is how the paper derives the convergence of (2.7) from the general convergence result for (3.3).
--
--   **Formalization Note** "Extracting $m$ entries with indices in $\Omega$" is encoded by an injective enumeration $\omega$ of $\Omega$ (so $|\Omega|=m$); the statement holds for every such enumeration.
-- source:
--   Cai, Candès, Shen, A Singular Value Thresholding Algorithm for Matrix Completion, SIAM J. Optim. 20 (2010), p. 1964, §3.1, last paragraph

import Mathlib
import Definitions.Def_CaiCandesShen_Convergence_Iterations

namespace CaiCandesShen.Convergence

/-- §3.1, p. 1964: when `𝒜` is the sampling operator extracting the `m` entries with indices in
`Ω`, then `𝒜*𝒜 = P_Ω`, and for any `M` with `𝒜(M) = b`, setting `Y^k = 𝒜*(y^k)` turns a run of
(3.3) into a run of (2.7). -/
theorem sampling_reduction {n₁ n₂ m : ℕ} (ω : Fin m → Fin n₁ × Fin n₂)
    (hω : Function.Injective ω) (Ω : Finset (Fin n₁ × Fin n₂))
    (hΩ : Ω = Finset.univ.image ω) :
    (∀ X : Mat n₁ n₂, adjA (samplingOp ω) (applyA (samplingOp ω) X) = projΩ Ω X) ∧
    ∀ (τ : ℝ) (M : Mat n₁ n₂) (b : Fin m → ℝ) (δ : ℕ → ℝ) (X : ℕ → Mat n₁ n₂)
      (y : ℕ → Fin m → ℝ),
      applyA (samplingOp ω) M = b → IsUzawaSeq τ (samplingOp ω) b δ X y →
        IsSVTSeq τ Ω M δ X (fun k => adjA (samplingOp ω) (y k)) := by sorry

end CaiCandesShen.Convergence
