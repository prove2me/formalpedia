    obtain ⟨h1, h2⟩ := ModularCurve.FullLevel.det_eq_of_ker_classify_act_eq_of_relabel_gamma0Pow
      q hq M' hqM' ℓ hℓ3 hℓq hℓM' L ξ hξ hιξ K hK A hAq j hj hℓA hM'A hℓ hM 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 hVC hCO P₀ xT hxT (g i) (g i') (hgdet i) (hgdet i') (σ i) (σ i') (hσpin i) (hσpin i') hker
