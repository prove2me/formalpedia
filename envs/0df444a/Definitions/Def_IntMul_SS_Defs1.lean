namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Negation -/

def negInt (i : Fin S) : Stmt S P :=
  caseTop i fun o => if o = some hdNeg then .seq (.pop i) (.push i hdPos)
    else .seq (.pop i) (.ite i isBitT (.push i hdNeg) (.push i hdPos))

end NLogN

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

/-! ## Duplication -/

def dupInt (q i j t1 t2 : Fin S) : Stmt S P :=
  caseTop i fun o =>
    let h := if o = some hdNeg then hdNeg else hdPos
    .seq (.pop i) (.seq (zip q j i t1 t2 true fCopy finNone false) (.seq (moveBits q t2 i)
      (.seq (.push i h) (.seq (moveBits q t1 j) (.push j h)))))

def dupCost (L : ℕ) : ℕ := zipCost 0 L + 2 * moveCost L + 21

