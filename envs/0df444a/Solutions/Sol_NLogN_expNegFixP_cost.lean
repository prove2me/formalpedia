    | skip
  simp only [NLogN.Ex.fdiv, NLogN.Ex.size, z0, NLogN.expCost, NLogN.expNegFixCost,
    show Bc + 3 + 2 = Bc + 5 by omega, show Bc + 3 + 2 + 2 = Bc + 7 by omega]
  have hS : M + NLogN.zsz (X + -X / log2Bits M * log2Bits M) + 0 + 20 ≤
      4 * (n + M + NLogN.zsz X + (-X / log2Bits M).toNat + 20) := by
    linarith [f9, Nat.zero_le ((-X / log2Bits M).toNat), Nat.zero_le (NLogN.zsz X), Nat.zero_le n]
  have hBS : Bc + 7 ≤ 9 * (n + M + NLogN.zsz X + (-X / log2Bits M).toNat + 20) ^ 2 := by
    rw [hBdef]; simp only [NLogN.expB]; nlinarith
  obtain ⟨S, hSdef⟩ : ∃ S, n + M + NLogN.zsz X + (-X / log2Bits M).toNat + 20 = S := ⟨_, rfl⟩
  rw [hSdef] at hS hBS ⊢
  have hS20 : M + 10 ≤ S := by omega
  have hZ5 : (Bc + 5) ^ 2 ≤ (Bc + 7) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have hZ : (Bc + 7) ^ 2 ≤ 81 * S ^ 4 := by
    calc (Bc + 7) ^ 2 ≤ (9 * S ^ 2) ^ 2 := Nat.pow_le_pow_left hBS 2
      _ = 81 * S ^ 4 := by ring
  have hBZ : Bc + 7 ≤ (Bc + 7) ^ 2 := by nlinarith
  have hE5 : (M + NLogN.zsz (X + -X / log2Bits M * log2Bits M) + 0 + 20) ^ 5 ≤ 1024 * S ^ 5 := by
    calc _ ≤ (4 * S) ^ 5 := Nat.pow_le_pow_left hS 5
      _ = 1024 * S ^ 5 := by ring
  have hM3 : (M + 10) ^ 3 ≤ S ^ 3 := Nat.pow_le_pow_left hS20 3
  have h35 : S ^ 3 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  have h45 : S ^ 4 ≤ S ^ 5 := Nat.pow_le_pow_right (by omega) (by omega)
  generalize (M + NLogN.zsz (X + -X / log2Bits M * log2Bits M) + 0 + 20) ^ 5 = E5 at *
  generalize (Bc + 7) ^ 2 = Z at *
  generalize (Bc + 5) ^ 2 = Y at *
  linarith [f13, f14, g9, f1, f10, f7, f6]
end
