/-! ## Genuine product and sum rules for `pd` -/

theorem pd_eq_fderiv {f : Pt n → ℝ} {x : Pt n} (j : Fin n) (hf : DifferentiableAt ℝ f x) :
    pd j f x = fderiv ℝ f x (Pi.single j 1) :=
  pd_eq_of_hasDerivAt (hasDerivAt_slice j hf)

theorem hasDerivAt_slice_pd {f : Pt n → ℝ} {x : Pt n} (j : Fin n) (hf : DifferentiableAt ℝ f x) :
    HasDerivAt (fun u : ℝ => f (Function.update x j u)) (pd j f x) (x j) := by
  rw [pd_eq_fderiv j hf]; exact hasDerivAt_slice j hf

theorem pd_mul {f h : Pt n → ℝ} {x : Pt n} (j : Fin n) (hf : DifferentiableAt ℝ f x)
    (hh : DifferentiableAt ℝ h x) :
    pd j (fun y => f y * h y) x = pd j f x * h x + f x * pd j h x := by
  have := (hasDerivAt_slice_pd j hf).mul (hasDerivAt_slice_pd j hh)
  simp only [Function.update_eq_self] at this
  exact pd_eq_of_hasDerivAt this

theorem pd_sum {ι : Type*} (s : Finset ι) {F : ι → Pt n → ℝ} {x : Pt n} (j : Fin n)
    (hF : ∀ i ∈ s, DifferentiableAt ℝ (F i) x) :
    pd j (fun y => ∑ i ∈ s, F i y) x = ∑ i ∈ s, pd j (F i) x :=
  pd_eq_of_hasDerivAt (HasDerivAt.fun_sum fun i hi => hasDerivAt_slice_pd j (hF i hi))

/-! ## The lowered-index identity (from `g · ginv = 1` only) -/

theorem metric_mul_inv_apply {g ginv : Metric n} {x : Pt n}
    (hinv : metricMatrix g x * metricMatrix ginv x = 1) (b k : Fin n) :
    ∑ i, g b i x * ginv i k x = if b = k then 1 else 0 := by
  have := congrFun (congrFun hinv b) k
  simpa [metricMatrix, Matrix.mul_apply, Matrix.one_apply] using this

/-- `Σ_i g_{bi} Γ^i_{jl} = ½ (∂_l g_{bj} + ∂_j g_{bl} - ∂_b g_{jl})`. -/
theorem lower_christoffel {g ginv : Metric n} {x : Pt n}
    (hinv : metricMatrix g x * metricMatrix ginv x = 1) (b j l : Fin n) :
    ∑ i, g b i x * christoffel g ginv i j l x =
      (pd l (g b j) x + pd j (g b l) x - pd b (g j l) x) / 2 := by
  have h : ∑ i, g b i x * christoffel g ginv i j l x =
      (∑ k, (∑ i, g b i x * ginv i k x) *
        (pd l (g k j) x + pd j (g k l) x - pd k (g j l) x)) / 2 := by
    simp only [christoffel, Finset.sum_mul, ← mul_div_assoc, Finset.mul_sum, ← Finset.sum_div]
    rw [Finset.sum_comm]
    exact congrArg (· / 2) (Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun i _ => by ring)
  rw [h]
  simp [metric_mul_inv_apply hinv]

