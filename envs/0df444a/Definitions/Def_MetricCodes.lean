    omega
  rw [arbitraryRowPathWeight_eq_foldl]
  exact (foldl_interlaces_of_count_le_gap h pref hcounts).antitone_ambient
theorem reverseInterlacingPolynomialSeed_polarization
    {r n : ℕ} (lam : Fin (r + 2) → ℕ)
