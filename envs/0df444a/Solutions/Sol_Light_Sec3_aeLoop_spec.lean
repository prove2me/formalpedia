    (S : HostSetting lim d X U A need (aeBase X fl μ t) μ') (ht : t < X.m) (ch : ℕ) (res : ℤ) :
    Ends lim (P₀ ++ R) d (aeCalls pS pWriteX pWriteY pScanPairs)
      (aeState X A fl t ch (X.c0 t) (X.len t) (X.rho t) (X.lo t) (X.w t) res μ')
