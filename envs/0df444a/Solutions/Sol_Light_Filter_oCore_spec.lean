    · dsimp only
      intro i hi
      rcases Nat.lt_succ_iff_lt_or_eq.1 hi with hi | rfl
      · by_cases he : base + oAddr n WI WJ i = base + oAddr n WI WJ j
        · have : oAddr n WI WJ i = oAddr n WI WJ j := by omega
          rw [he, Function.update_self, this]
        · rw [Function.update_of_ne he]
          exact hdone i hi
      · exact Function.update_self _ _ _
    · dsimp only
      intro a ha
      rw [Function.update_of_ne (ha j (Nat.lt_succ_self j))]
      exact hrest a fun i hi => ha i (by omega)
