private theorem entry_same : fastEntry = Staircase.schedule.entry := by
  funext r j
  have hs : Staircase.schedule.rows.size = 1123 := by rw [← view.hr, view.rs.size_ok]; rfl
  have hw : fastWord r = Staircase.schedule.rows[r]?.getD 0 := by
    by_cases hr : r < 1123
    · have hx := beq_iff_eq.mp (wordRangeAll r (Nat.zero_le _) (by simpa using hr))
      simpa only [view.rs.get_ok, view.hr] using hx
    · have hd : Staircase.schedule.rows.size ≤ r := by omega
      simp [fastWord, hr, Array.getElem?_eq_none hd]
  simp only [fastEntry, Block.entry, hw]

private def frameCode (v : Nat) : Frame :=
  (List.range (v.log2 / 11)).map fun j => (v >>> (11*j)) % (2^11)

private structure GramInput where
  den : Nat
  coeff : List Int
  coords : Array Int

private def GramInput.cert (v : GramInput) (b : Frame) : GramCertificate :=
  ⟨v.den, (b.zip v.coeff).filter (fun p => p.2 != 0), v.coords⟩

private def batchOK : List Frame → List GramInput → Bool
  | [], [] => true
  | b::bs, c::cs => (c.cert b).ok fastEntry b && batchOK bs cs
  | _, _ => false

private def Every (bs : Array Frame) : Prop :=
  ∀ b ∈ bs.toList, ∃ c : GramCertificate, c.ok fastEntry b = true

private theorem batch_sound : ∀ (bs : List Frame) (cs : List GramInput), batchOK bs cs = true →
    ∀ b ∈ bs, ∃ c : GramCertificate, c.ok fastEntry b = true
  | [], _, _, b, hb => by simp at hb
  | _ :: _, [], h, _, _ => by simp [batchOK] at h
  | b::bs, c::cs, h, x, hx => by
      have checks := Bool.and_eq_true_iff.mp h
      rcases List.mem_cons.mp hx with rfl | tail
      · exact ⟨c.cert x, checks.1⟩
      · exact batch_sound bs cs checks.2 x tail

private theorem append_every {a b : Array Frame} (ha : Every a) (hb : Every b) : Every (a++b) := by
  intro f hf
  rw [Array.toList_append, List.mem_append] at hf
  exact hf.elim (ha f) (hb f)

private structure GramView where
  len : Nat
  pick : Nat → Frame
  sound : ∀ i, i < len → ∃ c : GramCertificate, c.ok fastEntry (pick i) = true

private def gramLeaf (xs : Array Frame) (n : Nat) (hs : xs.size=n) (h : Every xs) : GramView where
  len := n
  pick i := xs[i]?.getD []
  sound i hi := by
    have hxs : i < xs.size := by simpa only [hs] using hi
    apply h
    simp [Array.getElem?_eq_getElem hxs]

private def gramJoin (l r : GramView) (n : Nat) (hs : l.len+r.len=n) : GramView where
  len := n
  pick i := if i<l.len then l.pick i else r.pick (i-l.len)
  sound i hi := by
    split
    next hl => exact l.sound i hl
    next hl => exact r.sound (i-l.len) (by omega)

