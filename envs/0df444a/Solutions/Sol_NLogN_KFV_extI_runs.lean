    by_cases e1 : j = NLogN.KFV.vL
    · subst e1; simp +decide [hO3.symm]
    by_cases e2 : j = vT4
    · subst e2; simp +decide [hO2.symm]
    by_cases e3 : j = NLogN.KFV.vT
    · subst e3; simp +decide [hO1.symm]
    by_cases e4 : j = O
    · subst e4
      simp only [hO1, hO2, hO3, if_true, if_false, htu, htv]
      rw [List.zipWith_append (by simp [List.length_take]; omega)]
      simp
    · simp [e1, e2, e3, e4]

end NLogN.KFV

