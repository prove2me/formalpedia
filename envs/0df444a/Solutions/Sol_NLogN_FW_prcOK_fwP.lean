    (fun _ => by rw [hP, ditBody_ren_const]) h t
  rwa [IState.embed_upd hf, IState.embed_pull hf] at h'

/-- `dif_runs` on the 64-stack machine, SS stack `i` at HS stack `i`. -/
theorem hdif_runs {iprog' : Fin P → IStmt 64 P} (pD : Fin P)
    (hP : iprog' pD = (difBody pD).ren ssH id) (n : ℕ) (hn : 1 ≤ n) :
