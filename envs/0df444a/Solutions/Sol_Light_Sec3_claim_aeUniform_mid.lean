  refine Ends.storeTo (x.out + (a * x.n + b)) (Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC (a * x.n + b)))
    ⟨Light.Sec3.bit (aeHit x.n x.AB x.BC x.AC (a * x.n + b)), ?_⟩ (by (( (try have := Light.Std.space_le (by assumption))
