-- title:
--   Proposition 3.9 — the commutant (ρ_m ⊗ ρ̌_r(SU(2)))′ is abelian and generated by the projections q_{m,r,l}
-- statement:
--   Let $m,r\in\mathbb N$. The commutant
--   $$(\rho_m\otimes\check\rho_r(SU(2)))'=\{T\in\mathrm{End}(P_m\otimes\bar P_r): T(\rho_m(g)\otimes\bar\rho_r(g))=(\rho_m(g)\otimes\bar\rho_r(g))T\ \ \forall g\in SU(2)\}$$
--   is an abelian algebra, and it is the algebra generated by the projections $q_{m,r,l}$ onto the SU(2)-subspaces $V_{m+r-2l}$ of $P_m\otimes\bar P_r$, $0\le l\le\min\{m,r\}$.
--
--   The paper cites this from Vollbrecht–Werner [17]. It expresses that $\rho_m\otimes\bar\rho_r$ is multiplicity-free, and is what reduces SU(2)-equivariant maps to a $(\min\{m,r\}+1)$-dimensional space.
--
--   **Formalization Note** $P_k$ is represented by coordinates in its canonical orthonormal basis $f^k_l=x_1^lx_2^{k-l}/\sqrt{l!(k-l)!}$, $l=0,\dots,k$ (0-based indices); $\mathrm{End}(P_k)$ is the algebra of $(k+1)\times(k+1)$ complex matrices, adjoints are conjugate transposes, and $P_m\otimes P_n$ is indexed with the $P_m$ factor first. The conjugate space $\bar P_k$ has the same coordinates and carries the entrywise conjugate matrices $\overline{\rho_k(g)}$. Channels are maps on matrices given by a finite normalized Kraus family. The Choi matrix is $C(\Phi)=\sum_{ij}\Phi(E_{ij})\otimes E_{ij}$, output factor first. The relation $r=m+n-2h$ is carried as the hypothesis $r+2h=m+n$. "Generated" is the complex subalgebra generated by the $q_{m,r,l}$ (`Algebra.adjoin`).
-- source:
--   Al Nuwairan, SU(2)-irreducibly covariant and EPOSIC channels, arXiv:1306.5321v1, p. 23, Proposition 3.9 (cited from [17])

import Mathlib
import Definitions.Def_SU2Eposic_Extreme_Choi

namespace SU2Eposic.Extreme

open scoped Matrix Kronecker

/-- **Proposition 3.9, p. 23** (cited in the paper from [17]). The commutant
`(ρ_m ⊗ ρ̌_r(SU(2)))′` of the operators `ρ_m(g) ⊗ ρ̄_r(g)` on `P_m ⊗ P̄_r` is an abelian algebra,
and it is the algebra generated by the projections `q_{m,r,l}` onto the SU(2)-subspaces
`V_{m+r−2l}`, `0 ≤ l ≤ min{m, r}`. -/
theorem proposition_3_9 (m r : ℕ) :
    (∀ T T' : Matrix (Fin (m + 1) × Fin (r + 1)) (Fin (m + 1) × Fin (r + 1)) ℂ,
      (∀ g : Matrix.specialUnitaryGroup (Fin 2) ℂ, Commute T (rho m g ⊗ₖ rhoConj r g)) →
      (∀ g : Matrix.specialUnitaryGroup (Fin 2) ℂ, Commute T' (rho m g ⊗ₖ rhoConj r g)) →
        Commute T T') ∧
    ∀ T : Matrix (Fin (m + 1) × Fin (r + 1)) (Fin (m + 1) × Fin (r + 1)) ℂ,
      (∀ g : Matrix.specialUnitaryGroup (Fin 2) ℂ, Commute T (rho m g ⊗ₖ rhoConj r g)) ↔
        T ∈ Algebra.adjoin ℂ (Set.range fun l : Fin (min m r + 1) => q m r l) := by sorry

end SU2Eposic.Extreme
