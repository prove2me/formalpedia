open Real
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable (M : ℝ)
theorem solution (hM : 0 ≤ M) : VacuumCertificate (gIso M) (giIso M) (domIso M) := by
  rcases hM.lt_or_eq with h | h
  · exact cert_pos M h
  · subst h; exact cert_zero
