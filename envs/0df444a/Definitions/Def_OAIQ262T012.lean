lemma summable_l1_complex_smul {ι E : Type*} [NormedAddCommGroup E] [CompleteSpace E]
    [NormedSpace ℂ E] (w : ℓ¹(ι,ℝ)) (T : ι → E) (M : ℝ) (hM : ∀ i, ‖T i‖≤M) :
