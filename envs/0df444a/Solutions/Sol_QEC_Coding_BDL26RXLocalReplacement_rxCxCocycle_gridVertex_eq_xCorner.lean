universe u
private theorem rxCxCocycle_gridVertical_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (i : Fin (S.half + 1))
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    (step : Nat) → (hstep : step ≤ S.half) →
      word (copy, subdivisionGridVertex P x S face i
        ⟨step, by omega⟩) =
      word (copy, subdivisionGridVertex P x S face i 0)
  | 0, _ => rfl
  | step + 1, hstep => by
      have hindex : step < S.half := by omega
      let edge := subdivisionVerticalEdge P x S face i
        (⟨step, hindex⟩ : Fin S.half)
      have hedge := rxCxCocycle_eq_on_subdivisionEdge
        P x S copy edge word hword
      rw [subdivisionVerticalEdge_start, subdivisionVerticalEdge_end] at hedge
      have ih := rxCxCocycle_gridVertical_eq_zero P x S copy face i word hword
        step (by omega)
      exact hedge.trans ih
private theorem rxCxCocycle_gridHorizontal_eq_zero
    (P : TannerSquarePresentation) (x : P.X) (S : OddScale)
    (copy : Two) (face : XStarFace P x)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0) :
    (step : Nat) → (hstep : step ≤ S.half) →
      word (copy, subdivisionGridVertex P x S face
        ⟨step, by omega⟩ 0) =
      word (copy, subdivisionGridVertex P x S face 0 0)
  | 0, _ => rfl
  | step + 1, hstep => by
      have hindex : step < S.half := by omega
      let edge := subdivisionHorizontalEdge P x S face
        (⟨step, hindex⟩ : Fin S.half) 0
      have hedge := rxCxCocycle_eq_on_subdivisionEdge
        P x S copy edge word hword
      rw [subdivisionHorizontalEdge_start, subdivisionHorizontalEdge_end] at hedge
      have ih := rxCxCocycle_gridHorizontal_eq_zero P x S copy face word hword
        step (by omega)
      exact hedge.trans ih
