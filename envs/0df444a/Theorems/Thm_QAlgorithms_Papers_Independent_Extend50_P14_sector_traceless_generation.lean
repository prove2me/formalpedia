-- title:
--   Lemma 4: generation of sector-traceless evolutions
-- statement:
--   For n≥1 let Π_m be the full Hamming-weight projectors. Any invariant Hermitian L satisfying Tr(LΠ_m)=0 for every 0≤m≤n obeys
--
--   $$e^{-itL}\in G_2\quad\text{for every }t\in\mathbb R,$$
--
--   where G_2 is the finite-product group generated by exchange R_{rs}=(X_rX_s+Y_rY_s)/2 and single-site Z. Equivalently in Lie-algebra form, every invariant skew-Hermitian A with all sector traces zero belongs to the real Lie algebra generated by iR_{rs} and iZ_r. This retains both statements on p.24.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 24, Lemma 4 and its Lie-algebra restatement

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.24, Lemma 4/C9–C10: both Hamiltonian reachability and the real
Lie-algebra inclusion, without assumptions taken from their proofs. -/
theorem sector_traceless_generation (n : ℕ) (hn : 1 ≤ n) :
    (∀ L : QMat n, L.IsHermitian → U1Invariant L →
      (∀ m : Fin (n+1), Matrix.trace (L * chargeSector n m.val) = 0) →
      ∀ t : ℝ, schrodingerEvolution L t ∈ xyZGroup n) ∧
    (∀ A : QMat n, A + Aᴴ = 0 → U1Invariant A →
      (∀ m : Fin (n+1), Matrix.trace (A * chargeSector n m.val) = 0) →
      A ∈ xyZLie n) := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
