       S.min' hne ∈ (Finset.range (topStaircase S)).image (S.max' hne - ·)))) :
    franklinInv S =
      (S \ (Finset.range (S.min' hne)).image (S.max' hne - ·)).erase (S.min' hne) ∪
      ((Finset.range (S.min' hne)).image (S.max' hne - ·)).image (· + 1) := by
