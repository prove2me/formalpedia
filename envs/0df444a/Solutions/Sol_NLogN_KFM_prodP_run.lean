open IntMul RS
theorem solution (n : NLogN.Ex NLogN.HS) (rd : Fin NLogN.HS) (s : NLogN.IState NLogN.HS) (N : ℕ) (hd56 : rd.val < 56)
    (hdI : rd ≠ NLogN.KFM.sI) (hn : n.Clean) (hnd : rd ∉ n.regs) (hnok : n.ok s) (hN : n.eval s = N) :
    (NLogN.KFM.prodP n rd).ok s ∧ (NLogN.KFM.prodP n rd).run s = s.upd rd (.int (N.factorial : ℤ) :: s.G rd) := by
  set s1 := s.upd rd (.int 1 :: s.G rd) with hs1
  have r1 : (NLogN.RS.push rd (.lit 1)).run s = s1 := by simp [NLogN.RS.run, NLogN.Ex.eval, hs1]
  have k1 : (NLogN.RS.push rd (.lit 1)).ok s := ⟨hd56, by intro j hj; simp [NLogN.Ex.regs] at hj, trivial⟩
  have H := NLogN.KFM.genLoop_run NLogN.KFM.sI rd n (NLogN.KFM.prodB rd) s1 N (NLogN.KFM.prodG N) 1 (s.G rd) (Ne.symm hdI) (by decide) hn
    ((NLogN.Ex.ok_upd s rd _ n hnd).2 hnok) (by rw [hs1, NLogN.Ex.eval_upd s rd _ n hnd, hN])
    (by simp [NLogN.KFM.prodB, NLogN.RS.writes]; exact Ne.symm hdI) (by simp [hs1]) (NLogN.KFM.prodB_step rd s N hd56 hdI)
  rw [NLogN.KFM.accSeq_prodG N N le_rfl, Nat.descFactorial_self] at H
  refine ⟨⟨k1, by rw [r1]; exact H.1⟩, ?_⟩
  simp only [NLogN.KFM.prodP, NLogN.RS.run_seq]
  rw [r1, H.2, hs1, NLogN.IState.upd_upd_same]
end
