-- Source module: Solutions.R6BitNBPrime
/-!
# Round six, bit network: good primes

Finitely many rationals have denominators coprime to every power of every prime `q > q₀`, and the
nonzero ones are units mod `q ^ f`. Consequently a finite set of edges with `EdgeQ` data
is `EdgeOK (q ^ f)` for all large primes `q` and all `f`.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset AModelFac

/-- **Good primes for edges.** Finitely many edges with rational Bruhat data (`EdgeQ`) are
admissible mod every power of every large prime. -/
theorem good_edges_sol_aux {m : ℕ} (E : Finset (Edge m))
    (hE : ∀ e ∈ E, ∃ q : Matrix (Fin m) (Fin m) ℚ, EdgeQ e q) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∀ f : ℕ, ∀ e ∈ E, EdgeOK (q ^ f) e := by
  classical
  obtain ⟨q₀, hq⟩ := good_mats (E.image Edge.E₁ ∪ E.image Edge.E₂)
  refine ⟨q₀, fun q hp hlt f e he => ?_⟩
  obtain ⟨Q, h0, h1, h2, h3, h4, -⟩ := hE e he
  refine ⟨h1, h3, fun i => ?_, fun i => ?_⟩
  · exact (hq q hp hlt f e.E₁ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ he)) i i).2 (h2 i)
  · exact (hq q hp hlt f e.E₂ (Finset.mem_union_right _ (Finset.mem_image_of_mem _ he)) i i).2 (h4 i)

end IntMul.Kappa.R6.Bit.NB

end

theorem solution : type_of% @IntMul.Kappa.R6.Bit.NB.good_edges_sol_aux := @IntMul.Kappa.R6.Bit.NB.good_edges_sol_aux
