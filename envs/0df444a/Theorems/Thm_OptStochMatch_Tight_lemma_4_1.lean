-- title:
--   Lemma 4.1 — the posterior allocation policy serves at the posterior expectation of Y
-- statement:
--   Under the posterior allocation policy (4.1) for a measurable offline allocation $Y$ on a feasible-rate region $P$, for every $t\in[0,1]$ and every job $i$ unfinished at $t$: $s_i(t)=\mathbb E[Y_i(Z)\mid\mathcal F_t]$ and $x_i(t)+1=\mathbb E[Z_i\mid\mathcal F_t]$ (4.2), almost surely on the event that $i$ is unfinished at $t$.
--
--   Differences from the source:
--   - encoding: the posterior allocation policy (4.1) → any SchedPolicy whose rate equals (4.1) after every completion history with nonnegative accumulated work (FollowsPosterior); reason: this gives a feedback-rule extension to all nonnegative states, including every reachable state; negative-work states are irrelevant to the source process
--   - encoding: F_t, the observed service and completion history up to t → the σ-algebra generated by x_i(v) and 1{i completed by v}, 0 ≤ v ≤ t; identities as a.e. equalities of the restrictions to {i unfinished at t}; reason: conditional expectations are a.e.-defined; the policy (4.1) uses no internal randomness, so the seed is a fixed parameter
-- source:
--   Dütting, Feldman, Molina, Optimal Online Stochastic Matching, arXiv:2610.19866 (sha256 0458ce2e…), Lemma 4.1, eq. (4.2), p. 14 (PDF p. 15)

import Mathlib
import Definitions.Def_OptStochMatch_Tight_Basic
import Definitions.Def_OptStochMatch_Tight_Laws
import Definitions.Def_OptStochMatch_Tight_Matching
import Definitions.Def_OptStochMatch_Tight_Scheduling
open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal BigOperators

namespace OptStochMatch.Tight

/-- Lemma 4.1 (p. 14, PDF 15). Under the posterior allocation policy (4.1) for a measurable
offline allocation `Y` on a feasible-rate region `P`, for every time `t ∈ [0, 1]` and every job
`i` that is unfinished at time `t`: `s_i(t) = E[Y_i(Z) | F_t]` and `x_i(t) + 1 = E[Z_i | F_t]`
(4.2), where `F_t` is the observed service and completion history up to time `t`. Both
identities hold almost surely on the event that job `i` is unfinished at `t`. -/
theorem lemma_4_1 {m : ℕ} (P : Set (Fin m → ℝ)) (hP : IsRateRegion P)
    (Y : (Fin m → ℝ) → (Fin m → ℝ)) (hY : IsOfflineAllocation P Y)
    (σ : SchedPolicy m P) (hσ : FollowsPosterior Y σ) (u : ℝ)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) (i : Fin m) :
    (Set.indicator {z : Fin m → ℝ | i ∉ matchedSet (histUpTo σ u z t)}
        (fun z => rateProc σ u z t i) =ᵐ[demandLaw m]
      Set.indicator {z : Fin m → ℝ | i ∉ matchedSet (histUpTo σ u z t)}
        (condExp (obsAlgebra σ u t) (demandLaw m) (fun z => Y z i))) ∧
    (Set.indicator {z : Fin m → ℝ | i ∉ matchedSet (histUpTo σ u z t)}
        (fun z => workProc σ u z t i + 1) =ᵐ[demandLaw m]
      Set.indicator {z : Fin m → ℝ | i ∉ matchedSet (histUpTo σ u z t)}
        (condExp (obsAlgebra σ u t) (demandLaw m) (fun z => z i))) := by sorry

end OptStochMatch.Tight
