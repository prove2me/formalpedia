private theorem s002.t0935 {v : HeightOneSpectrum (𝓞 K)} (hvS : v ∉ S)
    (hvL : v ∉ D.L) : (D.d112 d).c v = -d105 d v := by
  rw [D.t0918 d (D.t0933 d hvS hvL), s002.combExp,
    D.t0930 hvS hvL, add_zero]

private theorem s002.t0936 {v : HeightOneSpectrum (𝓞 K)} (hvS : v ∉ S)
