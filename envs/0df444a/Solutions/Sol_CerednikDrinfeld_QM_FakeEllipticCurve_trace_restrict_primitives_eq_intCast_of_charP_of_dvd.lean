variable {p : ℕ} [Fact p.Prime] {k : Type u} [Field k] [CharP k p] {j₀ : Zp2 p →+* k}

theorem subst_addVia_mem_span (X₀ : SpecialFormalODModule p j₀) (α β : Zp2 p)
    {r : MvPowerSeries (Fin 2) k} (hr : r ∈ Ideal.span (Set.range (X₀.F.nthSeries p))) :
    subst (Series.addVia X₀.F (X₀.act α) ((X₀.act β).comp X₀.varpi)) r ∈ Ideal.span (Set.range (X₀.F.nthSeries p)) := by
  set sE : MvFormalGroup.End X₀.F :=
    X₀.toFormalODModule.actEnd α + X₀.toFormalODModule.actEnd β * X₀.toFormalODModule.varpiEnd with hsEdef
  have hsE : sE.toPowerSeries = Series.addVia X₀.F (X₀.act α) ((X₀.act β).comp X₀.varpi) := by
    rw [hsEdef, MvFormalGroup.End.toPowerSeries_add, MvFormalGroup.End.toPowerSeries_mul]
    rfl
  rw [← hsE]
  have hs0 : ∀ i, constantCoeff (sE.toPowerSeries i) = 0 := sE.constantCoeff_eq_zero
  have hS : HasSubst sE.toPowerSeries := hasSubst_of_constantCoeff_zero hs0
  have hN : HasSubst (X₀.F.nthSeries p) := hasSubst_of_constantCoeff_zero (MvFormalGroup.constantCoeff_nthSeries X₀.F p)
  have hgen : ∀ l, subst sE.toPowerSeries (X₀.F.nthSeries p l) ∈ Ideal.span (Set.range (X₀.F.nthSeries p)) := by
    intro l
    have hc : ((p : MvFormalGroup.End X₀.F) * sE) = sE * (p : MvFormalGroup.End X₀.F) := (Nat.cast_commute p sE).eq
    have := congrArg (fun φ : MvFormalGroup.End X₀.F => φ.toPowerSeries l) hc
    simp only [MvFormalGroup.End.toPowerSeries_mul, MvFormalGroup.End.toPowerSeries_natCast] at this
    rw [this]
    exact S3Asm.subst_mem_span_of_constantCoeff hN (hs0 l)
  exact (Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hgen j)) (S3Asm.subst_mem_span_range hS hr)

theorem smul_mem_span {σ : Type*} (I : Ideal (MvPowerSeries σ k)) (c : k) {r : MvPowerSeries σ k} (hr : r ∈ I) :
    c • r ∈ I := by
  rw [MvPowerSeries.smul_eq_C_mul]
  exact I.mul_mem_left _ hr

end T3RamA

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (μ : ↥Λ) (hμ : (μ : ℍ[ℚ, a, b]) * (μ : ℍ[ℚ, a, b]) = -(((q * q' : ℕ) : ℚ) • (1 : ℍ[ℚ, a, b])))
    (star : ↥Λ → ↥Λ) (hstar : ∀ x : ↥Λ, (μ : ℍ[ℚ, a, b]) * (star x : ℍ[ℚ, a, b]) = Star.star (x : ℍ[ℚ, a, b]) * μ)
    {N : ℕ} {p : ℕ} [Fact p.Prime]
    (k : Type) [Field k] [IsAlgClosed k] [CharP k p]
    (E : FakeEllipticCurve Λ N k)

    (H : Type) [CommRing H] [HopfAlgebra k H] [Module.Finite k H] [Coalgebra.IsCocomm k H]
    (hH : Module.finrank k H = p ^ (2 * 2))
    (hHp : PDivisibleGroup.Hopf.nsmulAlgHom k H p = (Algebra.ofId k H).comp (Bialgebra.counitAlgHom k H))
    (e : ∀ (T : Type) [CommRing T] [Algebra k T],
      WithConv (H →ₐ[k] T) ≃ E.L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap k T))) p)
    (he_mul : ∀ (T : Type) [CommRing T] [Algebra k T] (φ ψ : WithConv (H →ₐ[k] T)),
      ((e T (φ * ψ)).val : SchemeHomOver _ E.f) = E.L.mul _ (e T φ).val (e T ψ).val)
    (he_nat : ∀ (T T' : Type) [CommRing T] [Algebra k T] [CommRing T'] [Algebra k T']
        (g' : T →ₐ[k] T') (φ : WithConv (H →ₐ[k] T)),
      ((e T' (.toConv (g'.comp φ.ofConv))).val : SchemeHomOver _ E.f).1 =
        Spec.map (CommRingCat.ofHom g'.toRingHom) ≫ (e T φ).val.1)

    (m : ↥Λ) (φH : H →ₐ[k] H)
    (hφH : ∀ (T : Type) [CommRing T] [Algebra k T] (q : WithConv (H →ₐ[k] T)),
      ((e T (.toConv (q.ofConv.comp φH))).val : SchemeHomOver _ E.f).1 = (e T q).val.1 ≫ E.act m)
    (hprim : ∀ x ∈ primitives k H, φH x ∈ primitives k H)
    (n : ℤ) (hmn : (m : ℍ[ℚ, a, b]) + Star.star (m : ℍ[ℚ, a, b]) = ((n : ℚ) : ℍ[ℚ, a, b]))
    (hp : p ∣ q * q') :
    LinearMap.trace k ↥(primitives k H) (φH.toLinearMap.restrict hprim) = (n : k) := by
  classical

  have hp' : p = q ∨ p = q' := by
    rcases (Nat.Prime.dvd_mul (Fact.out : p.Prime)).mp hp with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) (Fact.out : q.Prime)).mp h)
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) (Fact.out : q'.Prime)).mp h)
  obtain ⟨coord, hcoord, j₀, X₀, Ψ, hΨprim, hΨinj, hΨsurj, hΨact⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_specialFormalODModule_linearMap_primitives_of_ramified
      hqq' hB Λ hΛ μ hμ star hstar k E H hH hHp e he_mul he_nat hp'
  have hdim := CerednikDrinfeld.QM.FakeEllipticCurve.finrank_primitives_eq_two hqq' hB Λ hΛ μ hμ star hstar k E H hH hHp e he_mul he_nat

  have hdimR3 : ∃ e e' : MvPowerSeries (Fin 2) k,
      MvPowerSeries.constantCoeff e = 0 ∧ MvPowerSeries.constantCoeff e' = 0 ∧
      X₀.F.addCoboundary e ∈ Ideal.span (Set.range (Sum.elim
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inl t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inr t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l)))) ∧
      X₀.F.addCoboundary e' ∈ Ideal.span (Set.range (Sum.elim
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inl t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inr t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l)))) ∧
      (∀ c c' : k, c • e + c' • e' ∈ Ideal.span (Set.range (X₀.F.nthSeries p)) → c = 0 ∧ c' = 0) ∧
      (∀ g : MvPowerSeries (Fin 2) k, MvPowerSeries.constantCoeff g = 0 →
        X₀.F.addCoboundary g ∈ Ideal.span (Set.range (Sum.elim
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inl t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l))
          (fun l => MvPowerSeries.subst
            (fun t => (MvPowerSeries.X (Sum.inr t) : MvPowerSeries (Fin 2 ⊕ Fin 2) k)) (X₀.F.nthSeries p l)))) →
        ∃ c c' : k, g - (c • e + c' • e') ∈ Ideal.span (Set.range (X₀.F.nthSeries p))) := by
    haveI : Module.Finite k ↥(primitives k H) := Module.finite_of_finrank_eq_succ hdim
    let by_ : Module.Basis (Fin 2) k ↥(primitives k H) := Module.finBasisOfFinrankEq k _ hdim
    refine ⟨Ψ (by_ 0), Ψ (by_ 1), (hΨprim _).1, (hΨprim _).1, (hΨprim _).2, (hΨprim _).2, ?_, ?_⟩
    swap
    · intro g hg0 hgp
      obtain ⟨y, hy⟩ := hΨsurj g hg0 hgp
      refine ⟨by_.repr y 0, by_.repr y 1, ?_⟩
      have hy' : y = by_.repr y 0 • by_ 0 + by_.repr y 1 • by_ 1 := by
        conv_lhs => rw [← by_.sum_repr y]
        rw [Fin.sum_univ_two]
      have : (by_.repr y 0) • Ψ (by_ 0) + (by_.repr y 1) • Ψ (by_ 1) = Ψ y := by
        conv_rhs => rw [hy']
        rw [map_add, map_smul, map_smul]
      rw [this]
      exact hy
    intro c c' hcc
    have h0 : c • by_ 0 + c' • by_ 1 = 0 := by
      apply hΨinj
      rw [map_add, map_smul, map_smul]
      exact hcc
    have hrepr := congrArg by_.repr h0
    rw [map_add, map_smul, map_smul, by_.repr_self, by_.repr_self, map_zero] at hrepr
    have e0 := congrArg (fun f => f 0) hrepr
    have e1 := congrArg (fun f => f 1) hrepr
    simp only [Finsupp.add_apply, Finsupp.smul_apply, Finsupp.single_apply, Finsupp.zero_apply, smul_eq_mul] at e0 e1
    simp only [if_true, show ((1 : Fin 2) = 0) = False from by decide, show ((0 : Fin 2) = 1) = False from by decide,
      if_false, mul_one, mul_zero, add_zero, zero_add] at e0 e1
    exact ⟨e0, e1⟩
  obtain ⟨g, hg0, hgprim, hgind, -, hgact⟩ :=
    CerednikDrinfeld.SpecialFormalODModule.exists_primitives_mod_nthSeries_typed_forall_subst_addVia_act_of_finrank_eq_two X₀ hdimR3
  set I : Ideal (MvPowerSeries (Fin 2) k) := Ideal.span (Set.range (X₀.F.nthSeries p)) with hI

  have hx : ∀ i : Fin 2, ∃ x : ↥(primitives k H), g i - Ψ x ∈ I := fun i => hΨsurj (g i) (hg0 i) (hgprim i)
  choose x hx using hx

  set f : ↥(primitives k H) →ₗ[k] ↥(primitives k H) := φH.toLinearMap.restrict hprim with hf
  have hf_apply : ∀ y : ↥(primitives k H), f y = ⟨φH y, hprim y y.2⟩ := fun y => rfl

  obtain ⟨c, hc0, hc1⟩ := hgact (coord m).1 (coord m).2
  set s := CerednikDrinfeld.SpecialFormal.Series.addVia X₀.F (X₀.act (coord m).1) ((X₀.act (coord m).2).comp X₀.varpi) with hs
  have hS : MvPowerSeries.HasSubst s := by
    rw [hs]
    exact MvPowerSeries.hasSubst_of_constantCoeff_zero
      (X₀.toFormalODModule.actEnd (coord m).1 + X₀.toFormalODModule.actEnd (coord m).2 *
        X₀.toFormalODModule.varpiEnd).constantCoeff_eq_zero

  have hsub : ∀ r ∈ I, MvPowerSeries.subst s r ∈ I := fun r hr => by
    rw [hs, hI]; exact T3RamA.subst_addVia_mem_span X₀ _ _ (by rwa [hI] at hr)
  have hΨlin : ∀ (a b : k) (y z : ↥(primitives k H)), Ψ (a • y + b • z) = a • Ψ y + b • Ψ z := by
    intro a b y z; rw [map_add, map_smul, map_smul]
  have key : ∀ (i j : Fin 2) (d : k) (cc : k),
      MvPowerSeries.subst s (g i) - (d • g i + cc • g j) ∈ I →
      f (x i) = d • x i + cc • x j := by
    intro i j d cc hact
    have h1 : Ψ (f (x i)) - MvPowerSeries.subst s (Ψ (x i)) ∈ I := by
      rw [hf_apply]; rw [hs, hI]; exact hΨact m φH hφH hprim (x i)
    have h2 : MvPowerSeries.subst s (Ψ (x i)) - MvPowerSeries.subst s (g i) ∈ I := by
      have h := I.neg_mem (hsub _ (hx i))
      rw [MvPowerSeries.subst_sub hS, neg_sub] at h
      exact h
    have h4 : (d • g i + cc • g j) - Ψ (d • x i + cc • x j) ∈ I := by
      rw [hΨlin]
      have : d • g i + cc • g j - (d • Ψ (x i) + cc • Ψ (x j)) = d • (g i - Ψ (x i)) + cc • (g j - Ψ (x j)) := by
        simp only [smul_sub]; abel
      rw [this]
      exact I.add_mem (T3RamA.smul_mem_span I d (hx i)) (T3RamA.smul_mem_span I cc (hx j))
    have htot : Ψ (f (x i) - (d • x i + cc • x j)) ∈ I := by
      rw [map_sub]
      have : Ψ (f (x i)) - Ψ (d • x i + cc • x j) =
          (Ψ (f (x i)) - MvPowerSeries.subst s (Ψ (x i))) + (MvPowerSeries.subst s (Ψ (x i)) - MvPowerSeries.subst s (g i)) +
          (MvPowerSeries.subst s (g i) - (d • g i + cc • g j)) + ((d • g i + cc • g j) - Ψ (d • x i + cc • x j)) := by abel
      rw [this]
      exact I.add_mem (I.add_mem (I.add_mem h1 h2) hact) h4
    exact sub_eq_zero.mp (hΨinj _ htot)
  have key0 : f (x 0) = (j₀ (coord m).1) • x 0 + c 0 • x 1 := key 0 1 _ _ (by rw [hI, hs]; exact hc0)
  have key1 : f (x 1) = (j₀ (WittVector.frobenius (coord m).1)) • x 1 + c 1 • x 0 := key 1 0 _ _ (by rw [hI, hs]; exact hc1)

  have hxind : LinearIndependent k x := by
    rw [Fintype.linearIndependent_iff]
    intro cc hcc
    suffices hc : cc = 0 from fun i => congrFun hc i
    apply hgind cc
    have : (∑ i, cc i • g i) = (∑ i, cc i • (g i - Ψ (x i))) + Ψ (∑ i, cc i • x i) := by
      rw [map_sum]; simp only [map_smul, smul_sub, Finset.sum_sub_distrib]; abel
    rw [this, hcc, map_zero, add_zero]
    refine Submodule.sum_mem I (fun i _ => ?_)
    exact T3RamA.smul_mem_span I (cc i) (hx i)
  let bx : Module.Basis (Fin 2) k ↥(primitives k H) :=
    basisOfLinearIndependentOfCardEqFinrank hxind (by rw [hdim, Fintype.card_fin])
  have hbx : ∀ i, bx i = x i := fun i =>
    congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hxind (by rw [hdim, Fintype.card_fin])) i

  rw [LinearMap.trace_eq_matrix_trace k bx, Matrix.trace, Fin.sum_univ_two]
  simp only [Matrix.diag_apply, LinearMap.toMatrix_apply, hbx]
  rw [key0, key1]
  simp only [map_add, map_smul, ← hbx, bx.repr_self, Finsupp.smul_single, Finsupp.add_apply,
    Finsupp.single_apply, smul_eq_mul, mul_one]
  simp only [if_true, show ((1 : Fin 2) = 0) = False from by decide, show ((0 : Fin 2) = 1) = False from by decide,
    if_false, mul_zero, add_zero, zero_add]

  rw [← map_add, hcoord.trace m n hmn, map_intCast]

end
