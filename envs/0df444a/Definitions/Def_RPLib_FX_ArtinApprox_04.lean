/-! ### piece ArA8d -/
section Piece_ArA8d


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA8d: **`artinApproxAt`**

`artinApproxAt [PerfectField K] [Algebra.FiniteType K A] χ : ArtinApproxAt K A χ`. Present `A = K[x]/J` centred at `χ`
(`exists_surj_origin`), lift `f` to `F` over `K[x]` and `ŷ` to `ŵ` over `K[[x]]` (`hat_surjective`); then
`F_j(ŵ) ∈ J·K[[x]]` (`mem_map_of_hat_eq_zero`), so `F_j(Y) - Σ_k g_k Z_{jk}` (`g` generators of `J`) has the solution
`(ŵ, ẑ)`; `AA.all` solves it in an etale neighbourhood `B'` of the origin of `K[x]`, and `A ⊗[K[x]] B'` is the
neighbourhood of `χ` (`tensor_point`), with residues `ŵ_i(0)`.
-/

set_option autoImplicit false

noncomputable section

open TensorProduct

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Assembly

variable {K : Type u} [Field K] {A : Type u} [CommRing A] [Algebra K A]

theorem artinApproxAt [PerfectField K] [Algebra.FiniteType K A] (χ : A →ₐ[K] K) : ArtinApproxAt K A χ := by
  classical
  haveI : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing K A
  intro N m f ŷ hf
  obtain ⟨n, π, hπ, hχ⟩ := exists_surj_origin χ
  choose F hF using fun j => MvPolynomial.map_surjective (σ := Fin N) (π : MvPolynomial (Fin n) K →+* A) hπ (f j)
  choose ŵ hŵ using fun i => hat_surjective χ π hχ hπ (ŷ i)
  obtain ⟨s, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (RingHom.ker π))
  have hg' : Ideal.span (Set.range g) = RingHom.ker π := hg
  have hzero : ∀ j, hat χ π hχ (MvPolynomial.aeval ŵ (F j)) = 0 := fun j => by
    rw [MvPolynomial.aeval_def, MvPolynomial.hom_eval₂, hat_comp]
    have hy : (fun i => hat χ π hχ (ŵ i)) = ŷ := funext hŵ
    rw [hy, ← MvPolynomial.eval₂_map, hF j, ← MvPolynomial.aeval_def]
    exact hf j
  have hcoef : ∀ j, ∃ c : Fin s → MvPowerSeries (Fin n) K,
      ∑ k, c k * algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K) (g k) =
        MvPolynomial.aeval ŵ (F j) := fun j => by
    have h := mem_map_of_hat_eq_zero χ π hχ hπ (hzero j)
    rw [← hg', Ideal.map_span, ← Set.range_comp, Ideal.mem_span_range_iff_exists_fun] at h
    exact h
  choose c hc using hcoef
  let G : Fin m → MvPolynomial (Fin N ⊕ (Fin m × Fin s)) (MvPolynomial (Fin n) K) := fun j =>
    MvPolynomial.rename Sum.inl (F j) - ∑ k, MvPolynomial.C (g k) * MvPolynomial.X (Sum.inr (j, k))
  have hG : ∀ j, MvPolynomial.aeval (Sum.elim ŵ fun jk : Fin m × Fin s => c jk.1 jk.2) (G j) = 0 := fun j => by
    simp only [G, map_sub, map_sum, map_mul, MvPolynomial.aeval_rename, MvPolynomial.aeval_C,
      MvPolynomial.aeval_X, Sum.elim_comp_inl, Sum.elim_inr]
    rw [← hc j, sub_eq_zero]
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  obtain ⟨B', i1, i2, i3, χ'', z, h1, h2, h3⟩ := (AA.all (K := K) n).apply_fintype G _ hG
  letI : Algebra (MvPolynomial (Fin n) K) A := (π : MvPolynomial (Fin n) K →+* A).toAlgebra
  obtain ⟨χ3, g1, g2⟩ := tensor_point (R := MvPolynomial (Fin n) K) (B := A) (R' := B') (χ : A →+* K) χ''
    fun a => (h1 a).trans (hχ a).symm
  refine ⟨A ⊗[MvPolynomial (Fin n) K] B', inferInstance, inferInstance, inferInstance, χ3,
    fun i => (Algebra.TensorProduct.includeRight : B' →ₐ[MvPolynomial (Fin n) K]
      A ⊗[MvPolynomial (Fin n) K] B') (z (Sum.inl i)), fun a => g1 a, fun j => ?_,
    fun i => ⟨algebraMap K A (MvPowerSeries.constantCoeff (ŵ i)), ?_, ?_⟩⟩
  · have h2j := h2 j
    simp only [G, map_sub, map_sum, map_mul, MvPolynomial.aeval_rename, MvPolynomial.aeval_C,
      MvPolynomial.aeval_X, sub_eq_zero] at h2j
    have hmap : MvPolynomial.map (π : MvPolynomial (Fin n) K →+* A) (F j) =
        MvPolynomial.map (algebraMap (MvPolynomial (Fin n) K) A) (F j) := rfl
    have key : MvPolynomial.aeval (fun i => (Algebra.TensorProduct.includeRight : B' →ₐ[MvPolynomial (Fin n) K]
        A ⊗[MvPolynomial (Fin n) K] B') (z (Sum.inl i))) (F j) =
        (Algebra.TensorProduct.includeRight : B' →ₐ[MvPolynomial (Fin n) K] A ⊗[MvPolynomial (Fin n) K] B')
          (MvPolynomial.aeval (fun i => z (Sum.inl i)) (F j)) := by
      rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval]
    rw [← hF j, hmap, MvPolynomial.aeval_map_algebraMap, key]
    have h2j' : MvPolynomial.aeval (fun i => z (Sum.inl i)) (F j) =
        ∑ k, algebraMap (MvPolynomial (Fin n) K) B' (g k) * z (Sum.inr (j, k)) := h2j
    rw [h2j', map_sum]
    refine Finset.sum_eq_zero fun k _ => ?_
    have hgk : algebraMap (MvPolynomial (Fin n) K) A (g k) = 0 := by
      have hk : g k ∈ RingHom.ker π := hg' ▸ Ideal.subset_span ⟨k, rfl⟩
      exact hk
    rw [map_mul, AlgHom.commutes, IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) K) A
      (A ⊗[MvPolynomial (Fin n) K] B'), hgk, map_zero, zero_mul]
  · beta_reduce
    rw [g2, h3, Sum.elim_inl, AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
  · rw [← hŵ i, evalOne_hat]

