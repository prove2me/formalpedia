-- title:
--   Residual-glue instances and their isomorphisms
-- statement:
--   A **residual-glue instance** of residual rank $r$ is a tuple $\mathcal G=(\sigma,R,F,H,\omega)$: a scale $\sigma>0$, a residual lattice $R$, fixed data $F$ with underlying lattice, a glue subgroup $H\le D(F\oplus R)$ presented by cosets, and a residual marker $\omega\in\mathrm{span}(R)$. The associated overlattice $K_H=\{x\in S^*:x+S\in H\}$, $S=F\oplus R$, must be integral.
--
--   A **residual-glue isomorphism** $\mathcal G_1\to\mathcal G_2$ exists only if the scales and the fixed data agree, and it is then a residual isometry $O_R$ with
--
--   $$O_R\,\omega_1=\omega_2,\qquad (\mathrm{id}_F\oplus O_R)(K_{H_1})=K_{H_2}.$$
--
--   This is the small problem left after a marker has fixed most of the lattice.
--
--   **Formalization Note** The instance is in coordinates: $G_F$, $G_R$ are integer Gram matrices, the glue is a list of rational vectors generating $K_H$ together with $\mathbb Z^{d+r}$, and $O_R$ is an integer matrix $U$ with $G_{R,1}=U^\top G_{R,2}U$. The glue clause is the form that the paper prints as equivalent to preservation of $H$. Primitivity of the model is not required.
-- source:
--   Aggarwal, Jiang, Li, Liu, An n^{n+o(n)}-Time Algorithm for the Lattice Isomorphism Problem, STOC 2027 submission (manuscript sha256 61ee52aa…), Definition 5.13, p.28; (5.1), p.29; Definition 5.9 and Remark 5.11, p.27

import Mathlib
import Definitions.Def_ExponomialAssortment_FPTAS_Machine
import Definitions.Def_LIPAlgorithm_encInst

open ExponomialAssortment.FPTAS

namespace LIPAlgorithm

/-- A residual-glue instance `G = (σ, R, F, H, ω)` of residual rank `r` in coordinates (Definition 5.13, p.28).

**Formalization Note.** `GF` is the Gram matrix of the fixed lattice in its canonical basis, the matrix
`B_F⊤ G_F B_F` of p.28, and `fixedStr` holds the remaining data of the string `str(F)`. `GR` is the Gram matrix
of `R`. The glue subgroup `H` is presented by explicit cosets: `glue` lists rational vectors that generate, with
`ℤ^{d+r}`, the overlattice `K_H`. The marker `ω ∈ span(R)` is written in the coordinates of `R`. -/
structure ResGlue (d r : ℕ) where
  /-- the recorded scale factor `σ` -/
  σ : ℚ
  /-- the fixed-side comparison data of `str(F)` -/
  fixedStr : List ℤ
  /-- the Gram matrix of the fixed lattice in its canonical basis -/
  GF : Gram d
  /-- the Gram matrix of the residual lattice `R` -/
  GR : Gram r
  /-- representatives of generating cosets of the glue subgroup `H` -/
  glue : List (Fin d ⊕ Fin r → ℚ)
  /-- the residual marker `ω` in the coordinates of `R` -/
  ω : Fin r → ℚ

/-- The overlattice `K_H = {x ∈ S* : x + S ∈ H}` (Definition 5.9, p.27) of `S = F ⊕ R`, in coordinates: the
subgroup of `ℚ^{d+r}` generated by `ℤ^{d+r}` and the glue representatives. -/
def ResGlue.overlattice {d r : ℕ} (G : ResGlue d r) : AddSubgroup (Fin d ⊕ Fin r → ℚ) :=
  AddSubgroup.closure
    (Set.range (fun z : Fin d ⊕ Fin r → ℤ => fun i => (z i : ℚ)) ∪ {g | g ∈ G.glue})

/-- The Gram matrix of `S = F ⊕ R` (p.28), read in `ℚ`. -/
def ResGlue.gramS {d r : ℕ} (G : ResGlue d r) : Matrix (Fin d ⊕ Fin r) (Fin d ⊕ Fin r) ℚ :=
  Matrix.fromBlocks (G.GF.map (Int.cast : ℤ → ℚ)) 0 0 (G.GR.map (Int.cast : ℤ → ℚ))

/-- The requirements of Definition 5.13, p.28: `σ > 0`, the lattices `F` and `R` are positive definite and
integral, and the overlattice `K_H` is integral (which also gives `K_H ⊆ S*`, as `S ⊆ K_H`).

**Formalization Note.** Primitivity of the model, `α(K_H) = 1`, is not required: the class of instances is
larger than the paper's. -/
def ResGlue.IsValid {d r : ℕ} (G : ResGlue d r) : Prop :=
  0 < G.σ ∧ IsGram G.GF ∧ IsGram G.GR ∧
    ∀ x ∈ G.overlattice, ∀ y ∈ G.overlattice, ∃ z : ℤ, x ⬝ᵥ G.gramS.mulVec y = (z : ℚ)

/-- The map `id_F ⊕ O_R` of Remark 5.11, p.27 in coordinates, with `O_R` given by the matrix `U`. -/
def idSum {d r : ℕ} (U : Gram r) (x : Fin d ⊕ Fin r → ℚ) : Fin d ⊕ Fin r → ℚ :=
  Sum.elim (fun i => x (Sum.inl i))
    ((U.map (Int.cast : ℤ → ℚ)).mulVec fun i => x (Sum.inr i))

/-- `U` is a residual-glue isomorphism `G₁ → G₂` ((5.1), p.29): the scales and the fixed data agree, `U` is an
isometry `R₁ → R₂` (`GR₁ = U⊤ GR₂ U`, `U ∈ GL_r(Z)`), it preserves the residual marker, and
`(id_F ⊕ U)(K_{H₁}) = K_{H₂}`.

**Formalization Note.** The glue clause is the form that (5.1) prints as equivalent to
`(id_{D(F)} ⊕ O_R)(H₁) = H₂`, by Remark 5.11, p.27. -/
def IsResGlueIso {d r : ℕ} (G₁ G₂ : ResGlue d r) (U : Gram r) : Prop :=
  G₁.σ = G₂.σ ∧ G₁.fixedStr = G₂.fixedStr ∧ G₁.GF = G₂.GF ∧
    U ∈ isoSet G₁.GR G₂.GR ∧
    (U.map (Int.cast : ℤ → ℚ)).mulVec G₁.ω = G₂.ω ∧
    idSum U '' (G₁.overlattice : Set (Fin d ⊕ Fin r → ℚ)) = G₂.overlattice

/-- The binary encoding of a residual-glue instance: self-delimiting fields, in the order of the structure. -/
def encResGlue {d r : ℕ} (G : ResGlue d r) : List Bool :=
  encodeNat d ++ encodeNat r ++ encodeRat G.σ ++
    encodeNat G.fixedStr.length ++ G.fixedStr.flatMap encodeInt ++
    encG G.GF ++ encG G.GR ++
    encodeNat G.glue.length ++
    G.glue.flatMap (fun g =>
      (List.finRange d).flatMap (fun i => encodeRat (g (Sum.inl i))) ++
        (List.finRange r).flatMap (fun i => encodeRat (g (Sum.inr i)))) ++
    (List.finRange r).flatMap (fun i => encodeRat (G.ω i))

end LIPAlgorithm


