    dLR u v (fun μ => f (phi k r c n n' μ)) =
      fun μ => dLR (u.map fun Y => n⁻¹ * emb0 k r Y * n) (v.map fun Y => n'⁻¹ * emb0 k r Y * n') f (phi k r c n n' μ) := by sorry
