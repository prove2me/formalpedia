-- title:
--   Coefficient extension generates the full modular function field
-- statement:
--   Let $k$ and $K$ be fields with a specified $k$-algebra structure on $K$. Let $F_k$ and $F_K$ be the level-$25$ modular function fields over these fields, and let $c:F_k→F_K$ be coefficientwise scalar extension. Then the intermediate field of $F_K/K$ generated by the image of $c$ is all of $F_K$:
--
--   $$K\bigl(c(F_k)\bigr)=F_K.$$
--
--   This generation statement allows identities proved on coefficient-extended functions to control the entire function field.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Definitions.Def_N25_CoefficientMap
import Theorems.Thm_ModularCurve_qExpFunctionFieldC_eq_adjoin_image_coeffMap_qExpFunctionFieldC

set_option autoImplicit false
open N25
open N25.Endgame

theorem N25.Endgame.FBaseCoeffMap25_generates
    (k K : Type*) [Field k] [Field K] [Algebra k K] :
    IntermediateField.adjoin K (Set.range (FBaseCoeffMap25 k K)) = ⊤ := by sorry
