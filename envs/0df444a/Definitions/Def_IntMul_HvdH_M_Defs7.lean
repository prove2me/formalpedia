-- Source module: NLogN.HAx4
/-!
# One resampling axis, part 4: the `S̃` axis program `sapAxP`

`sapAxP` on `gD = gints L ++ R` (with `L` of dims `s :: rest`, `m = rest.prod`) computes
`gints (tensorGo [(t, sapL p s t α)] (s :: rest) L) ++ R`: it builds the `S` weight table on
`aW = 39` and the step table on `aD = 40`, runs `GL.axisP` with the slice program `sapSl`, and
pops the two tables again.  Every stack except `gD` is restored.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.AX

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp

/-- The axis core (= `GL.axisP (sapAx …)`, written out). -/
def sapCoreP : RM :=
  .seq (RM.seqL [.rs (.push 1 (.reg aS)), .rs (.push 2 (.reg aM)), .rs (.push 3 (.reg aKB)),
      .rs (transP 2), .rs (.pop 1), .rs (.pop 2), .rs (.pop 3)])
    (.seq (.rep gCC (.reg aM) (RM.seqL [.rs (mvList gD gZT gCV (cnt2 aS)),
        .rs (mvList gZT aI gCV (cnt2 aS)), sapSlP, .rs (mvList aO gZB gCV (cnt2 aT))]))
      (.rs (mvList gZB gD gCV (cnt2 aTot))))

/-- **The `S̃` axis program.** -/
def sapAxP : RM :=
  RM.seqL [.rs sTabR, .rs dTabR, sapCoreP, .rs (popK aW gCC (.reg aNW)), .rs (popK aD gCC (.reg aT))]

/-- The scalar registers read by `sapAxP` (see the table in `HAx2`). -/
structure SapRegs (p s t α m kb : ℕ) (st : IState HS) : Prop where
  tab : STabRegs p s t α st
  rKa : ∃ L, st.G aKa = .int (sOff s (HvdH.sWidth p α) : ℤ) :: L
  rKN : ∃ L, st.G aKN = .int ((s + (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: L
  rR : ∃ L, st.G aR = .int (2 ^ (2 * p)) :: L
  rNW : ∃ L, st.G aNW = .int ((t * (2 * HvdH.sWidth p α + 1) : ℕ) : ℤ) :: L
  rM : ∃ L, st.G aM = .int (m : ℤ) :: L
  rKB : ∃ L, st.G aKB = .int (kb : ℤ) :: L
  rTot : ∃ L, st.G aTot = .int ((m * t : ℕ) : ℤ) :: L

/-- Size conditions of the list moves / transposition (`Q` bounds every moved entry). -/
structure AxQ (s t m kb Bi Bo Q : ℕ) : Prop where
  hm : 1 ≤ m
  hkb : s * m ≤ 2 ^ kb
  bB : Bi ≤ Q
  bBo : Bo ≤ Q
  bn : zsz ((2 * s : ℕ) : ℤ) ≤ Q
  bn' : zsz ((2 * t : ℕ) : ℤ) ≤ Q
  bm : zsz ((2 * m : ℕ) : ℤ) ≤ Q
  bkb : zsz (kb : ℤ) ≤ Q
  btot : zsz ((2 * (m * t) : ℕ) : ℤ) ≤ Q

/-- Cost bound of `sapAxP`. -/
def sapAxCost (p s t α m kb Bi mm Φ Bacc Q Bq : ℕ) : ℕ :=
  tabCost (2 * HvdH.sWidth p α + 1) t (sWCost p Bq) +
    (tabCost 1 t (40 * 10 ^ 7 * (Bq + 2) ^ 2) + 10 ^ 9) +
    (3 * 10 ^ 6 * (kb + 1) * (s * m + 1) * (Bi + kb + 6) +
      m * (sapSlC p s t α mm Φ Bacc Q + 100000 * (s + t + 1) * (Q + 2)) +
      100000 * (m * t + 1) * (Q + 2)) +
    (2 * 2000 * (Bq + 2) + t * (2 * HvdH.sWidth p α + 1) * (12000 * (Bq + 2)) + 32) +
    (2 * 2000 * (Bq + 2) + t * (12000 * (Bq + 2)) + 32)

end NLogN.AX

end

