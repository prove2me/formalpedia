-- Source module: NLogN.Flat
/-!
# Flat code with jumps, and compilation of structured programs into it

Instructions carry absolute addresses. `ret` with an empty control stack halts.
`exec_flat`: a structured run of cost `c` is `c` flat steps.
-/

namespace NLogN

variable {S P : ℕ}

/-! ## Layout -/

theorem Stmt.size_pos (s : Stmt S P) : 0 < s.size := by
  induction s <;> simp [Stmt.size] <;> omega

/-! ## A concrete layout -/

theorem Stmt.placed_of_instrAt (ent : Fin P → ℕ) (code : ℕ → Instr S) :
    ∀ (s : Stmt S P) (a e : ℕ),
      (∀ x, a ≤ x → x < a + s.size → s.instrAt ent a e x = some (code x)) →
      Placed code ent s a e := by
  intro s
  induction s with
  | skip => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | push i y => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | pop i => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | inRd i => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | out b => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | call j => intro a e h; have := h a le_rfl (by simp [Stmt.size]); simp [Stmt.instrAt] at this; exact this.symm
  | seq p q ihp ihq =>
    intro a e h
    refine ⟨ihp _ _ fun x h1 h2 => ?_, ihq _ _ fun x h1 h2 => ?_⟩
    · have := h x h1 (by simp only [Stmt.size]; omega); simpa [Stmt.instrAt, h2] using this
    · have := h x (by omega) (by simp [Stmt.size] at h2 ⊢; omega)
      simpa [Stmt.instrAt, show ¬ x < a + p.size by omega] using this
  | ite i f p q ihp ihq =>
    intro a e h
    refine ⟨?_, ihp _ _ fun x h1 h2 => ?_, ihq _ _ fun x h1 h2 => ?_⟩
    · have := h a le_rfl (by simp only [Stmt.size]; omega); simp [Stmt.instrAt] at this; exact this.symm
    · have := h x (by omega) (by simp only [Stmt.size]; omega)
      simpa [Stmt.instrAt, show x ≠ a by omega, h2] using this
    · have := h x (by omega) (by simp [Stmt.size] at h2 ⊢; omega)
      simpa [Stmt.instrAt, show x ≠ a by omega, show ¬ x < a + 1 + p.size by omega] using this
  | loop i f p ihp =>
    intro a e h
    refine ⟨?_, ihp _ _ fun x h1 h2 => ?_⟩
    · have := h a le_rfl (by simp only [Stmt.size]; omega); simp [Stmt.instrAt] at this; exact this.symm
    · have := h x (by omega) (by simp only [Stmt.size]; omega)
      simpa [Stmt.instrAt, show x ≠ a by omega] using this

theorem find_proc (prog : Fin P → Stmt S P) (j : Fin P) (x : ℕ)
    (h1 : entryOf prog j ≤ x) (h2 : x < entryOf prog j + (prog j).size) :
    procAt prog x = some j := by
  rw [procAt, List.find?_eq_some_iff_getElem]
  refine ⟨by simp [h1, h2], j.val, by simp, by simp, ?_⟩
  intro i hi
  simp only [List.getElem_finRange, Fin.cast_mk, Bool.not_eq_true', decide_eq_false_iff_not,
    not_and, not_lt]
  intro hi1
  have := entryOf_mono prog (show i + 1 ≤ j.val by omega)
  have e := entryOf_succ prog ⟨i, by omega⟩
  simp only at e
  omega

theorem stmt_instrAt_isSome (ent : Fin P → ℕ) :
    ∀ (s : Stmt S P) (a e x : ℕ), a ≤ x → x < a + s.size → (s.instrAt ent a e x).isSome := by
  intro s
  induction s with
  | skip | push | pop | inRd | out | call =>
    intro a e x h1 h2; simp [Stmt.size] at h2; simp [Stmt.instrAt, show x = a by omega]
  | seq p q ihp ihq =>
    intro a e x h1 h2
    simp only [Stmt.instrAt]
    split_ifs with h
    · exact ihp _ _ _ h1 h
    · exact ihq _ _ _ (by omega) (by simp [Stmt.size] at h2; omega)
  | ite i f p q ihp ihq =>
    intro a e x h1 h2
    simp only [Stmt.instrAt]
    split_ifs with h h'
    · simp
    · exact ihp _ _ _ (by omega) (by omega)
    · exact ihq _ _ _ (by omega) (by simp [Stmt.size] at h2; omega)
  | loop i f p ihp =>
    intro a e x h1 h2
    simp only [Stmt.instrAt]
    split_ifs with h
    · simp
    · exact ihp _ _ _ (by omega) (by simp [Stmt.size] at h2; omega)

theorem progPlaced_codeOf (prog : Fin P → Stmt S P) :
    ProgPlaced (codeOf prog) prog (fun j => entryOf prog j) := by
  intro j
  refine ⟨Stmt.placed_of_instrAt _ _ _ _ _ fun x h1 h2 => ?_, ?_⟩
  · simp only [codeOf, find_proc prog j x h1 h2]
    have := stmt_instrAt_isSome (fun j => entryOf prog j) (prog j) _
      (entryOf prog j + (prog j).size) x h1 h2
    rw [Option.isSome_iff_exists] at this
    obtain ⟨v, hv⟩ := this
    simp [hv]
  · simp only [codeOf]
    rcases hf : procAt prog (entryOf prog j + (prog j).size) with _ | i
    · rfl
    · rw [procAt, List.find?_eq_some_iff_getElem] at hf
      obtain ⟨hc, -⟩ := hf
      simp only [decide_eq_true_eq] at hc
      exfalso
      rcases lt_trichotomy i.val j.val with hij | hij | hij
      · have := entryOf_mono prog (show i.val + 1 ≤ j.val by omega)
        have e := entryOf_succ prog i
        omega
      · have : i = j := Fin.ext hij
        subst this; omega
      · have := entryOf_mono prog (show j.val + 1 ≤ i.val by omega)
        have e := entryOf_succ prog j
        omega

end NLogN

end

