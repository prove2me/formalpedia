      BuchstabArithmetic.target := by
  rw [buchstabIntegral_eq_D]
  have c_cut : Continuous (fun x : R4 => x.1 + x.2.1 + 2 * x.2.2.1 + x.2.2.2) :=
    ((c_x0.add c_x1).add (continuous_const.mul c_x2)).add c_x3
  have hm_le : MeasurableSet (H_le_set φ) := (isClosed_le c_cut continuous_const).measurableSet
  have hm_gt : MeasurableSet (H_gt_set φ) := (isOpen_lt continuous_const c_cut).measurableSet
  have hpt_eq : ∀ x ∈ D_set, integrand4 ω φ x = (H_le_set φ).indicator (f_smooth φ) x := by
    intro x hx
    rcases hx with ⟨h0, h01, h12, h23, h3⟩
    have hx2_pos : 0 < x.2.2.1 := lt_of_lt_of_le ha0_pos (by linarith)
    by_cases hcut : x.1 + x.2.1 + 2 * x.2.2.1 + x.2.2.2 ≤ φ
    · have hmem : x ∈ H_le_set φ := hcut
      rw [indicator_of_mem hmem]
      have hu1 : 1 ≤ (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1 := by
        rw [one_le_div hx2_pos]; linarith
      have hu2 : (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1 ≤ 2 := by
        rw [div_le_iff₀ hx2_pos]
        norm_num [a0, BuchstabArithmetic.a, BuchstabArithmetic.top] at h0 hhi
        linarith
      unfold integrand4 f_smooth
      rw [hω.2.1 _ hu1 hu2,
          show φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2) = φ - x.1 - x.2.1 - x.2.2.1 - x.2.2.2 by ring]
      exact inv_u_div_weight (ne_of_gt hx2_pos)
    · have hnmem : x ∉ H_le_set φ := hcut
      rw [indicator_of_notMem hnmem]
      push Not at hcut
      have hu_lt : (φ - (x.1 + x.2.1 + x.2.2.1 + x.2.2.2)) / x.2.2.1 < 1 := by
        rw [div_lt_one hx2_pos]; linarith
      unfold integrand4
      rw [hz _ hu_lt, zero_div]
  have hint_f : IntegrableOn (f_smooth φ) D_set volume :=
    ((f_smooth_cont hlo).mono D_subset_B).integrableOn_compact isCompact_D
  have hsum_ind : ∀ x : R4,
      (H_le_set φ).indicator (f_smooth φ) x + (H_gt_set φ).indicator (f_smooth φ) x = f_smooth φ x := by
    intro x
    by_cases h : x.1 + x.2.1 + 2 * x.2.2.1 + x.2.2.2 ≤ φ
    · have hm1 : x ∈ H_le_set φ := h
      have hm2 : x ∉ H_gt_set φ := by change ¬ φ < x.1 + x.2.1 + 2 * x.2.2.1 + x.2.2.2; linarith
      rw [indicator_of_mem hm1, indicator_of_notMem hm2, add_zero]
    · push Not at h
      have hm1 : x ∉ H_le_set φ := by change ¬ x.1 + x.2.1 + 2 * x.2.2.1 + x.2.2.2 ≤ φ; linarith
      have hm2 : x ∈ H_gt_set φ := h
      rw [indicator_of_notMem hm1, indicator_of_mem hm2, zero_add]
  have hint_le : IntegrableOn ((H_le_set φ).indicator (f_smooth φ)) D_set volume :=
    hint_f.indicator hm_le
  have hint_gt : IntegrableOn ((H_gt_set φ).indicator (f_smooth φ)) D_set volume :=
    hint_f.indicator hm_gt
  have hdecomp : (∫ x in D_set, integrand4 ω φ x) + (∫ x in Cap_open φ, f_smooth φ x) =
      ∫ x in D_set, f_smooth φ x := by
    rw [setIntegral_congr_fun isClosed_D.measurableSet hpt_eq]
    have hcap_eq : D_set ∩ H_gt_set φ = Cap_open φ := rfl
    rw [← hcap_eq, ← setIntegral_indicator hm_gt, ← integral_add hint_le hint_gt]
    exact setIntegral_congr_fun isClosed_D.measurableSet (fun x _ => hsum_ind x)
