private theorem e_hecke (hinj : Function.Injective ιT)
    (hhecke : ∀ (ℓ : Nat.Primes) (u : 𝒰.P.TorusPoints) (c : J), u ∈ 𝒰.P.U → 𝒰.eFull u = ιT c →
      𝒰.eFull (𝒰.P.precomp (heckeKernelMap H ℓ) u) = ιT (hecke (heckeGen ℓ) c)) :
    ∀ (ℓ : Nat.Primes) (u : ↥𝒰.P.U)
      (hu : 𝒰.P.precomp (heckeKernelMap H ℓ) (u : 𝒰.P.TorusPoints) ∈ 𝒰.P.U),
      e ⟨𝒰.P.precomp (heckeKernelMap H ℓ) (u : 𝒰.P.TorusPoints), hu⟩ = hecke (heckeGen ℓ) (e u) := by
  intro ℓ u hu
  apply hinj
  rw [he]
  exact hhecke ℓ (u : 𝒰.P.TorusPoints) (e u) u.2 (he u).symm

