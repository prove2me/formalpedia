lemma P_card (Ω : ℕ) : (P (4 * (Ω + 1))).card ≤ 2 * Ω + 3 := by
  have hsub : P (4 * (Ω + 1)) ⊆ insert 2 ((range (2 * Ω + 2)).image (fun i => 2 * i + 1)) := by
    intro p hp
    unfold P at hp
    simp only [Finset.mem_filter, Finset.mem_range] at hp
    rw [Finset.mem_insert, Finset.mem_image]
    by_cases h2 : p = 2
    · left; exact h2
    · right
      have ho := hp.2.odd_of_ne_two h2
      obtain ⟨i, hi⟩ := ho
      exact ⟨i, Finset.mem_range.mpr (by omega), hi.symm⟩
  calc _ ≤ _ := Finset.card_le_card hsub
    _ ≤ ((range (2 * Ω + 2)).image (fun i => 2 * i + 1)).card + 1 := Finset.card_insert_le _ _
    _ ≤ (range (2 * Ω + 2)).card + 1 := Nat.add_le_add_right Finset.card_image_le 1
    _ = 2 * Ω + 3 := by simp

lemma TS_card (S : Finset ℕ) (m z : ℕ) (hz : 1 ≤ z) (hS : S.card ≤ z) :
    (TS S m).card ≤ (m + 1) * z ^ m := by
  have hsub : TS S m ⊆ (range (m + 1)).biUnion (fun j => S.powersetCard j) := by
    intro t ht
    simp only [TS, Finset.mem_filter, Finset.mem_powerset] at ht
    simp only [Finset.mem_biUnion, Finset.mem_range, Finset.mem_powersetCard]
    exact ⟨t.card, by omega, ht.1, rfl⟩
  calc _ ≤ _ := Finset.card_le_card hsub
    _ ≤ ∑ j ∈ range (m + 1), (S.powersetCard j).card := Finset.card_biUnion_le
    _ ≤ ∑ j ∈ range (m + 1), z ^ m := by
        apply Finset.sum_le_sum; intro j hj
        rw [Finset.card_powersetCard]
        simp only [Finset.mem_range] at hj
        calc S.card.choose j ≤ S.card ^ j := Nat.choose_le_pow _ _
          _ ≤ z ^ j := Nat.pow_le_pow_left hS _
          _ ≤ z ^ m := Nat.pow_le_pow_right hz (by omega)
    _ = (m + 1) * z ^ m := by simp

