  have h1 : IntMul.OpenAI.R129.P.NLogN.KFM.TrRegs t1 n w m rw rm := h.upd hd _
  obtain ⟨LD1, hD1⟩ := h1.hD
  set t2 := t1.upd dst (.int (IntMul.OpenAI.R129.dP n : ℤ) :: t1.G dst) with ht2
