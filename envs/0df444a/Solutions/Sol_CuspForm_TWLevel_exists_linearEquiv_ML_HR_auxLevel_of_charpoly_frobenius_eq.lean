namespace TWAlphaComm

open CuspForm.TWLevel

variable (M : ℕ) (H : Subgroup (ZMod M)ˣ) (𝒪 : Type) [CommRing 𝒪]

theorem heckeTL_comm_of_prime (a b : ℕ) [NeZero a] [NeZero b] (ha : a.Prime) (hb : b.Prime) :
    CohCarrier.heckeTL M H 𝒪 a * CohCarrier.heckeTL M H 𝒪 b =
      CohCarrier.heckeTL M H 𝒪 b * CohCarrier.heckeTL M H 𝒪 a := by
  by_cases hab : a = b
  · subst hab
    rfl
  · apply LinearMap.ext
    intro F
    change CohCarrier.heckeT M H a 𝒪 (CohCarrier.heckeT M H b 𝒪 F) =
      CohCarrier.heckeT M H b 𝒪 (CohCarrier.heckeT M H a 𝒪 F)
    exact CohCarrier.heckeT_comm_of_prime M H a b ha ((Nat.coprime_primes ha hb).mpr hab) F

variable (N r : ℕ) {t : ℕ} (qv : Fin t → ℕ) (S : Set ℕ)
  [∀ i, NeZero (qv i)] (hq : ∀ i, (qv i).Prime)

include hq in

theorem op_eq_heckeTL (H : Subgroup (ZMod (level N r qv))ˣ) (g : Gen (level N r qv) S t) :
    ∃ (a : ℕ) (ha : a.Prime), op N r qv S 𝒪 H g =
      (haveI : NeZero a := ⟨ha.ne_zero⟩; CohCarrier.heckeTL (level N r qv) H 𝒪 a) := by
  cases g with
  | T ℓ hℓ hℓS hℓL => exact ⟨ℓ, hℓ, rfl⟩
  | U i => exact ⟨qv i, hq i, rfl⟩

include hq in

theorem opComm (H : Subgroup (ZMod (level N r qv))ˣ) : OpComm N r qv S 𝒪 H := by
  intro g h
  obtain ⟨a, ha, hga⟩ := op_eq_heckeTL 𝒪 N r qv S hq H g
  obtain ⟨b, hb, hhb⟩ := op_eq_heckeTL 𝒪 N r qv S hq H h
  rw [hga, hhb]
  haveI : NeZero a := ⟨ha.ne_zero⟩
  haveI : NeZero b := ⟨hb.ne_zero⟩
  exact heckeTL_comm_of_prime (level N r qv) H 𝒪 a b ha hb

end TWAlphaComm
