      rw [this, List.getElem?_eq_none (by omega), List.getElem?_eq_none (by simp; omega)]
  lt i hi := by unfold mvIdx; split_ifs <;> omega
  surj j hj := by
    refine ⟨if j < nA then j else if j < nA + nG then j + nF else if j < nA + nG + nF then j - nG
      else j, by split_ifs <;> omega, ?_⟩
    unfold mvIdx; split_ifs <;> omega

section Layout

variable (mz : ℕ → ℕ) (bg : ℕ → Bool)

end Layout

theorem Full.mono {bg : ℕ → Bool} {ax0 l l' : List ℕ} (h : Full bg ax0 l) (hm : ∀ x ∈ l, x ∈ l') :
    Full bg ax0 l' := fun j hj => ⟨hm _ (h j hj).1, fun hb => hm _ ((h j hj).2 hb)⟩

theorem idxOf_getElem_nd {l : List ℕ} (hnd : l.Nodup) {i : ℕ} (hi : i < l.length) :
    l.idxOf l[i] = i := by
  simp [hnd]

/-- **One layout step.** -/
theorem Dl_step (mz : ℕ → ℕ) (bg : ℕ → Bool) {g : List ℕ → List ℕ} {σ : ℕ → ℕ} {n : ℕ}
    (hP : POp g σ n) (ax0 lay' : List ℕ) (hl : lay'.length = n) (hnd : (g lay').Nodup)
    (hF : Full bg ax0 (g lay')) {α : Type*} (xs : List α) (d : α) :
    AModel.pull ((g lay').map (asz mz)) (lay'.map (asz mz)) g d (Dl mz bg ax0 (g lay') xs d) =
      Dl mz bg ax0 lay' xs d := by
  have hnd' := hP.nodup hl hnd
  have hgl := hP.length hl
  unfold Dl
  rw [pull_comp _ _ ?hv]
  case hv =>
    intro b hb
    have hbl : b.length = n := by rw [hb.length_eq]; simp [hl]
    refine (valid_iff _ _).2 ⟨by rw [hP.length hbl]; simp [hgl], fun k h1 h2 => ?_⟩
    have hk : k < n := by rw [hP.length hbl] at h1; exact h1
    obtain ⟨-, hlt⟩ := (valid_iff _ _).1 hb
    rw [hP.getElem hbl h1]
    have hs : σ k < n := hP.lt k hk
