    (by simp [hSt, NLogN.KFM.pushL]) (by simp [hSt, IState.upd_G, Ne.symm hdO])
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      have := hB (ints (NLogN.KFM.pushL v d k)) (d - k) (by omega) (by omega)
      refine ⟨this.1, ?_⟩
      rw [this.2]
