-- title:
--   Product Lebesgue measure $\bar\lambda$ on $[0,1]^\infty$ and mixtures of nonrandomized policies
-- statement:
--   Let $\bar\lambda$ be the countable product of Lebesgue measures on $[0,1]$, a probability measure on $[0,1]^\infty$.
--
--   A family $\bar f(\bar\theta)$, $\bar\theta\in[0,1]^\infty$, of policies **represents the policy $\pi$ as a mixture of nonrandomized policies** if
--   1. every $\bar f(\bar\theta)$ is nonrandomized, $\bar f(\bar\theta)\in\Pi'$;
--   2. the mapping $(p_0,\bar\theta)\mapsto\rho_{p_0}[\bar f(\bar\theta)]$ from $\mathcal P(\mathbb X)\times[0,1]^\infty$ into $\mathcal P(\Omega)$ is universally measurable;
--   3. for all $p_0\in\mathcal P(\mathbb X)$,
--   $$\mathbb P^\pi_{p_0}(E)=\int_{[0,1]^\infty}\mathbb P^{\bar f(\bar\theta)}_{p_0}(E)\,\bar\lambda(d\bar\theta)\qquad\forall\,E\in\mathcal U(\Omega);$$
--   4. if $\pi$ is Markov (resp. semi-Markov), every $\bar f(\bar\theta)$ is Markov (resp. semi-Markov).
--
--   These are the properties of the family produced by Theorem 3.2; the family enters condition (3.5) of Theorem 3.3.
--
--   **Formalization Note.** $[0,1]^\infty$ is `ℕ → unitInterval` and $\bar\lambda$ is `Measure.infinitePi` of the Lebesgue measure. The mapping in 2 is an explicit witness $\Psi$ whose values are strategic measures of $\bar f(\bar\theta)$ (unique, so $\Psi(p_0,\bar\theta)=\rho_{p_0}[\bar f(\bar\theta)]$). $\mathcal P(\cdot)$ carries Mathlib's $\sigma$-algebra generated by $p\mapsto p(B)$, which for Borel spaces is the Borel $\sigma$-algebra of the weak topology. $\mathbb P^\pi_{p_0}(E)$ for universally measurable $E$ is the value of $\rho_{p_0}[\pi]$ at $E$ (Mathlib: outer measure, equal to the completion's value).
-- source:
--   Yu, arXiv:2206.06492v3, p. 8 (λ̄ and Theorem 3.2 (i)–(ii), eq. (3.1), and its last sentence)

import Mathlib
import Definitions.Def_BertsekasShreve_AnalyticSelection_Measurability
import Definitions.Def_BertsekasShreve_BorelInfinite_Analytic
import Definitions.Def_YuStrategic_Optimality_StrategicMeasure

namespace YuStrategic.Optimality

open MeasureTheory ProbabilityTheory

/-- `λ̄`, the countable product of Lebesgue measures on `[0, 1]` (Yu, arXiv:2206.06492v3, p. 8),
a probability measure on `[0, 1]^∞ = ℕ → [0, 1]`. -/
noncomputable def lambdaBar : Measure (ℕ → unitInterval) :=
  Measure.infinitePi (fun _ : ℕ => (volume : Measure unitInterval))

variable {X A : Type} [TopologicalSpace X] [MeasurableSpace X]
  [TopologicalSpace A] [MeasurableSpace A]

/-- `f̄` is a family of policies representing `π` as a mixture of nonrandomized policies in the
sense of Theorem 3.2 (Yu, arXiv:2206.06492v3, p. 8): the policies `f̄(θ̄)`, `θ̄ ∈ [0, 1]^∞`, are
1. nonrandomized, `f̄(θ̄) ∈ Π′`;
2. (Theorem 3.2(i)) the mapping `(p₀, θ̄) ↦ ρ_{p₀}[f̄(θ̄)]` from `P(X) × [0, 1]^∞` into `P(Ω)` is
   universally measurable;
3. (Theorem 3.2(ii), (3.1)) for all `p₀ ∈ P(X)`,
   `P^π_{p₀}(E) = ∫_{[0,1]^∞} P^{f̄(θ̄)}_{p₀}(E) λ̄(dθ̄)` for every universally measurable `E ⊆ Ω`;
4. Markov (resp. semi-Markov) whenever `π` is Markov (resp. semi-Markov).

**Formalization Note.** The mapping in 2 is the witness `Ψ`: `Ψ (p₀, θ̄)` is a strategic measure
of `f̄(θ̄)` from `p₀`, hence equals `ρ_{p₀}[f̄(θ̄)]` by uniqueness. `P(X)` and `P(Ω)` carry Mathlib's
σ-algebra on `ProbabilityMeasure`, generated by `p ↦ p(B)` (the Giry σ-algebra), which for Borel
spaces is the Borel σ-algebra of the weak topology [Bertsekas–Shreve, Prop. 7.25]. `P^π_{p₀}(E)`
for a universally measurable `E` is the value of `ρ_{p₀}[π]` at `E` (Mathlib: outer measure,
equal to the completion's value). -/
def IsMixtureFamily (M : Model X A) (π : Policy M)
    (fbar : (ℕ → unitInterval) → Policy M) : Prop :=
  (∀ θ, (fbar θ).IsNonrandomized) ∧
  (∃ Ψ : ProbabilityMeasure X × (ℕ → unitInterval) → ProbabilityMeasure (Path X A),
    BertsekasShreve.BorelInfinite.IsUniversallyMeasurableFun Ψ ∧
    (∀ (p₀ : ProbabilityMeasure X) (θ : ℕ → unitInterval),
      IsStrategicMeasure M (fbar θ) p₀ (Ψ (p₀, θ))) ∧
    ∀ (p₀ : ProbabilityMeasure X) (P : ProbabilityMeasure (Path X A)),
      IsStrategicMeasure M π p₀ P →
      ∀ E : Set (Path X A), BertsekasShreve.AnalyticSelection.IsUniversallyMeasurable E →
        (P : Measure (Path X A)) E =
          ∫⁻ θ, (Ψ (p₀, θ) : Measure (Path X A)) E ∂lambdaBar) ∧
  (π.IsMarkov → ∀ θ, (fbar θ).IsMarkov) ∧
  (π.IsSemiMarkov → ∀ θ, (fbar θ).IsSemiMarkov)

end YuStrategic.Optimality


