theorem ModularCurve.FullLevel.xHFunctionFieldC_levelH_eq_modularFunctionFieldC_of_liesOverPrime_of_eq_two
    (q : ℕ) [Fact q.Prime] (hq2 : q = 2) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q) :
    xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M') =
      modularFunctionFieldC (ResidueField A) M' := by sorry
