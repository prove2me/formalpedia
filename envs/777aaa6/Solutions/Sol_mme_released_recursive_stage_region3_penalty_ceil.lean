        ((n3 3 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by
    intro r
    have hcast : (fun c ↦ ((m3 3 r c : ℕ) : ℝ) / ((n3 3 r : ℕ) : ℝ)) =
