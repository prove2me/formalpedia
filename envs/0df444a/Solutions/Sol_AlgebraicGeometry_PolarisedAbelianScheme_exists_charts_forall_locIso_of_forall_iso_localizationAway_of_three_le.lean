theorem hw : PolarisedAbelianScheme.IsPullback incL (v₁ S B u i j) (w S B u i j incL) :=
  (AlgebraicGeometry.PolarisedAbelianScheme.exists_isPullback incL (v₁ S B u i j)).choose_spec

