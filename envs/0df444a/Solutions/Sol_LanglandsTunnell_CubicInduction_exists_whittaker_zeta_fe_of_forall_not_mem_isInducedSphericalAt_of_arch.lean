variable (R K : Type*) [CommRing R] [IsDedekindDomain R] [Field K] [Algebra R K] [IsFractionRing R K]

private theorem globalPoints_unipotentGL2 (x : K) :
    globalPoints R K (unipotentGL2 x) = unipotentGL2 (algebraMap K (AdeleRing R K) x) := by
  refine Units.ext ?_
  ext i j
  fin_cases i <;> fin_cases j <;> simp [globalPoints, Matrix.GeneralLinearGroup.map_apply]

private theorem iota_globalPoints_unipotentGL2 (x : K) :
    iota R K (globalPoints R K (unipotentGL2 x)) = upperUnipotent3 (algebraMap K (AdeleRing R K) x) 0 0 := by
  rw [globalPoints_unipotentGL2]
  exact iotaGL_unipotentGL2 _

private theorem globalPointsGL_iotaGL (h : GL (Fin 2) K) :
    globalPointsGL 3 R K (iotaGL h) = iota R K (globalPoints R K h) := by
  refine Units.ext ?_
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [globalPointsGL, globalPoints, iota, Matrix.GeneralLinearGroup.map_apply, embedMat2]

private theorem coe_iotaGL_of_coe_eq_diagonal {p q : K} (d : GL (Fin 2) K)
    (hd : (d : Matrix (Fin 2) (Fin 2) K) = Matrix.diagonal ![p, q]) :
    ((iotaGL d : GL (Fin 3) K) : Matrix (Fin 3) (Fin 3) K) = Matrix.diagonal ![p, q, 1] := by
  rw [coe_iotaGL, hd]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [embedMat2, Matrix.diagonal]

end
