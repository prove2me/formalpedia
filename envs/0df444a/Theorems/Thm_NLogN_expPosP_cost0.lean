theorem NLogN.expPosP_cost0 (n k j σ : ℕ) (s : IState HS) (L16 L17 L18 L27 : List Item)
    (h16 : s.G 16 = .int n :: L16) (h17 : s.G 17 = .int k :: L17)
    (h18 : s.G 18 = .int j :: L18) (h27 : s.G 27 = .int σ :: L27) :
    expPosP.cost s ≤ piCost 5 239 (2 * n + 10) + piCost 3 3 (2 * n + 10) +
      expNegFixCost n (2 * n + 10)
        (zsz (min 0 (piBits (2 * n + 10) * j / k - σ * log2Bits (2 * n + 10))))
        ((-(min 0 (piBits (2 * n + 10) * j / k - σ * log2Bits (2 * n + 10)))) /
          log2Bits (2 * n + 10)).toNat +
      10 ^ 10 * (expPosBB n
        (zsz (min 0 (piBits (2 * n + 10) * j / k - σ * log2Bits (2 * n + 10))))
        ((-(min 0 (piBits (2 * n + 10) * j / k - σ * log2Bits (2 * n + 10)))) /
          log2Bits (2 * n + 10)).toNat
        (zsz (j : ℤ)) (zsz (k : ℤ)) (zsz (σ : ℤ)) + 4) ^ 2 := by sorry
