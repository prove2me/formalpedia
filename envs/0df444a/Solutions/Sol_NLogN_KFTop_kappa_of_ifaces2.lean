variable {E₁ E₂ E₃ E₀ E : ℕ}

theorem kTable_ext' (ext : Fin E → IStmt HS (7 + E)) (j : Fin (7 + E)) (hj : 7 ≤ j.val) :
    kTable ext j = ext ⟨j.val - 7, by omega⟩ := by
  unfold kTable; rw [dif_neg (by omega), dif_neg (by omega), dif_neg (by omega)]

theorem gI_gL (Ei E off : ℕ) (h : off + Ei ≤ E) : NLogN.KFM.gI Ei E off h ∘ NLogN.KFM.gL Ei = NLogN.KFM.gL E := by
