variable {K ρ f}

/-- **Lemma 13, correctness off the bad set.** For L-bit chunks `y, z` (`L = fK`) all of whose
used guard values satisfy (23), and any control chunk `x`, the eight packed lines (22) give
`S0 (y, z) = (T0 y, z)`: bit `j_i = ρ + iK` of `y` is flipped exactly when `x_{j_i} = 1`
(`i < f - 1`), all other bits of `y` and the whole chunk `z` are unchanged. -/
theorem S0_eq_T0 (hρK : ρ < K) (hf : 1 ≤ f) (x y z : ℤ)
    (hy : 0 ≤ y ∧ y < 2 ^ (f * K)) (hz : 0 ≤ z ∧ z < 2 ^ (f * K))
    (gy : GuardOK K ρ f y) (gz : GuardOK K ρ f z) :
    Butterfly.S0 K ρ f x (y, z) = (T0y K ρ f x y, z) := by
  have hK : 1 ≤ K := by omega
  have hρ : (0 : ℤ) < 2 ^ ρ := by positivity
  -- decomposition of a chunk
  have dec : ∀ t : ℤ, 0 ≤ t ∧ t < 2 ^ (f * K) → GuardOK K ρ f t →
