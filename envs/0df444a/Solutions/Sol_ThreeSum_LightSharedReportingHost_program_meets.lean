  · intro i hi
    exact (heq _ (by omega)).trans (hs i hi)
  · intro i hi
    exact (heq _ (by omega)).trans (H.pointers i hi)
  · intro i hi
    exact ReportingHostQueryBounds.boxStored_of_on (H.boxes i hi)
      (by intro a ha _; exact heq a (by omega))








































