  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma valid_addr (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.addr Λ a) := by
  rw [addr_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma valid_inv (s : Step n Q) {a : List ℕ} (ha : Valid sh a) : Valid sh (s.inv Λ a) := by
