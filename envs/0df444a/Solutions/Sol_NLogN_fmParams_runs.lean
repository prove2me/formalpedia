        (2000 * (N + 3)) := by
    intro s' hp hd
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hp, hd, sg_natCast]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := dupCost_le (zsz (N : ℤ)); have := dupCost_le (zsz ((N / 2 ^ k : ℕ) : ℤ))
    have := splitCost_le k
    have e1 : ((N : ℤ) % 2 ^ k) = ((N % 2 ^ k : ℕ) : ℤ) := by push_cast; rfl
    have e2 : ((N : ℤ) / 2 ^ k) = ((N / 2 ^ k : ℕ) : ℤ) := by push_cast; rfl
    have := dupCost_le (zsz ((N : ℤ) / 2 ^ k))
    rw [e1] at *; rw [e2] at *
    omega
  have h1 := h1g s hPRM hDL
  set s1 := (s.upd T2 (.int (N / 2 ^ k : ℕ) :: s.G T2)).upd PW (.int (N / 2 ^ k : ℕ) :: s.G PW)
    with hs1
  have h2 := pow2_runs (I := I) pP hP (N / 2 ^ k) s1 (s.G PW) (by simp +decide [s1])
  have h3g : ∀ s' : IState NS, s'.G PW = .int (2 ^ (N / 2 ^ k)) :: s.G PW →
      IRuns I iprog (.op (.mv PW RM)) s'
        ((s'.upd PW (s.G PW)).upd RM (.int (2 ^ (N / 2 ^ k)) :: s'.G RM)) (200 * (N + 2)) := by
    intro s' h
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h]
    have := moveIntCost_le (zsz ((2 : ℤ) ^ (N / 2 ^ k))); have := zsz_two_pow (N / 2 ^ k)
    omega
  have h3 := h3g (s1.upd PW (.int (2 ^ (N / 2 ^ k)) :: s.G PW)) (by simp)
  refine (IRuns.seq h1 (IRuns.seq h2 h3)).mono' ?_ ?_
  · simp only [hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  · simp only [pow2Cost]; omega

set_option maxHeartbeats 1000000 in
theorem parC_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N M k : ℕ)
    (L1 L2 LL : List Item) (hM : M ≤ N) (hk : k ≤ N)
    (hQ : (2 * M + 2 * k + 3) / 2 ^ k + 1 ≤ N)
    (hT1 : s.G T1 = .int k :: L1) (hT2 : s.G T2 = .int M :: L2)
    (hDL : s.G DL = .int (2 ^ k) :: LL) :
    IRuns I iprog (parC pP) s
      ((((s.upd T2 (.int ((2 * M + 2 * k + 3) / 2 ^ k + 1 : ℕ) :: L2)).upd T3
        (.int (((2 * M + 2 * k + 3) / 2 ^ k + 1) * 2 ^ k : ℕ) :: s.G T3)).upd RQ
          (.int (2 ^ ((2 * M + 2 * k + 3) / 2 ^ k + 1)) :: s.G RQ)).upd DE
            (.int (2 ^ (2 * ((2 * M + 2 * k + 3) / 2 ^ k + 1))) :: s.G DE))
      (70000 * (N + 3)) := by
  obtain ⟨t, ht⟩ : ∃ t, t = 2 * M + 2 * k + 3 := ⟨_, rfl⟩
  obtain ⟨Q, hQd⟩ : ∃ Q, Q = t / 2 ^ k + 1 := ⟨_, rfl⟩
  rw [← ht, ← hQd]; rw [← ht, ← hQd] at hQ
  have h1g : ∀ s' : IState NS, s'.G T1 = .int k :: L1 → s'.G T2 = .int M :: L2 →
      s'.G DL = .int (2 ^ k) :: LL →
      IRuns I iprog (.seq (.op (.dup T2 T3)) (.seq (.op (.add T3 T2 T2)) (.seq (.op (.dup T1 T3))
        (.seq (.op (.dup T1 T4)) (.seq (.op (.add T3 T4 T4)) (.seq (.op (.add T4 T2 T2))
          (.seq (.op (.const T3 3)) (.seq (.op (.add T3 T2 T2)) (.seq (.op (.split T2 DL T3))
            (.seq (.op (.drop T3)) (.seq (.op (.const T3 1)) (.seq (.op (.add T3 T2 T2))
              (.seq (.op (.dup T2 T3)) (.seq (.op (.shl T3 DL)) (.op (.dup T2 PW))))))))))))))))
        s' (((s'.upd T2 (.int Q :: L2)).upd T3 (.int (Q * 2 ^ k : ℕ) :: s'.G T3)).upd PW
          (.int Q :: s'.G PW)) (40000 * (N + 3)) := by
    intro s' h1 h2 hd
    have et : (3 + ((k : ℤ) + k + ((M : ℤ) + M))) = (t : ℤ) := by omega
    have eQ : 1 + (((t / 2 ^ k : ℕ)) : ℤ) = (Q : ℤ) := by omega
    have eQ' : 1 + (t : ℤ) / 2 ^ k = (Q : ℤ) := by
      rw [← eQ]; push_cast; rfl
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h1, h2, hd, et, sg_natCast, eQ, eQ']
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have zl : ∀ x : ℕ, x ≤ 4 * N + 3 → zsz (x : ℤ) ≤ 4 * N + 3 := fun x hx =>
      le_trans (zsz_natCast_le_self x) hx
    have a1 := zl M (by omega); have a2 := zl k (by omega)
    have a3 := zl (k + k) (by omega); have a4 := zl (M + M) (by omega)
    have a5 := zl (k + k + (M + M)) (by omega)
    have a6 := zl (t % 2 ^ k) (le_trans (Nat.mod_le _ _) (by omega))
    have a7 := zl (t / 2 ^ k) (le_trans (Nat.div_le_self _ _) (by omega))
    have a8 := zl Q (by omega)
    push_cast at a3 a4 a5 a6 a7
    have := dupCost_le (zsz (M : ℤ)); have := dupCost_le (zsz (k : ℤ))
    have := dupCost_le (zsz (Q : ℤ))
    have := addIntCost_le (8 * N + 6)
    have := addIntCost_mono (show zsz (M : ℤ) + zsz (M : ℤ) ≤ 8 * N + 6 by omega)
    have := addIntCost_mono (show zsz (k : ℤ) + zsz (k : ℤ) ≤ 8 * N + 6 by omega)
    have := addIntCost_mono (show zsz ((k : ℤ) + k) + zsz ((M : ℤ) + M) ≤ 8 * N + 6 by omega)
    have := addIntCost_mono (show zsz (3 : ℤ) + zsz ((k : ℤ) + k + ((M : ℤ) + M)) ≤ 8 * N + 6 by
      have : zsz (3 : ℤ) ≤ 2 := zsz_le_of_abs (by norm_num); omega)
    have := addIntCost_mono (show zsz (1 : ℤ) + zsz ((t : ℤ) / 2 ^ k) ≤ 8 * N + 6 by
      rw [zsz_one]; omega)
    have : zsz (3 : ℤ) ≤ 2 := zsz_le_of_abs (by norm_num)
    have := splitCost_le k; have := shlCost_le k
    simp only [zsz_one] at *
    clear et eQ eQ' ht hQd hQ zl h1 h2 hd
    generalize zsz (3 : ℤ) = z3 at *
    linarith
  have h1 := h1g s hT1 hT2 hDL
  set s1 := ((s.upd T2 (.int Q :: L2)).upd T3 (.int (Q * 2 ^ k : ℕ) :: s.G T3)).upd PW
    (.int Q :: s.G PW) with hs1
  have h2 := pow2_runs (I := I) pP hP Q s1 (s.G PW) (by simp +decide [s1])
  have epow : (2 : ℤ) ^ Q * 2 ^ Q = 2 ^ (2 * Q) := by rw [two_mul, pow_add]
  have h3g : ∀ s' : IState NS, s'.G PW = .int (2 ^ Q) :: s.G PW →
      IRuns I iprog (.seq (.op (.mv PW RQ)) (.seq (.op (.dup RQ T4)) (.seq (.op (.shl T4 RQ))
        (.op (.mv T4 DE))))) s'
        (((s'.upd PW (s.G PW)).upd RQ (.int (2 ^ Q) :: s'.G RQ)).upd DE
          (.int (2 ^ (2 * Q)) :: s'.G DE)) (2000 * (N + 3)) := by
    intro s' h
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h, epow]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz ((2 : ℤ) ^ Q)); have := zsz_two_pow Q
    have := moveIntCost_le (zsz ((2 : ℤ) ^ (2 * Q))); have := zsz_two_pow (2 * Q)
    have := dupCost_le (zsz ((2 : ℤ) ^ Q)); have := shlCost_le Q
    omega
  have h3 := h3g (s1.upd PW (.int (2 ^ Q) :: s.G PW)) (by simp)
  refine (IRuns.seq h1 (IRuns.seq h2 h3)).mono' ?_ ?_
  · simp only [hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  · simp only [pow2Cost]; omega

theorem parD_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (n : ℕ)
    (L3 : List Item) (hT3 : s.G T3 = .int n :: L3) :
    IRuns I iprog (parD pP) s
      ((s.upd RN (.int (2 ^ n) :: s.G RN)).upd RF (.int (2 ^ n + 1) :: s.G RF))
      (25000 * (n + 3)) := by
  have hzn : zsz (n : ℤ) ≤ n := zsz_natCast_le_self n
  have h1 : IRuns I iprog (.op (.dup T3 PW)) s (s.upd PW (.int n :: s.G PW)) (300 * (n + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hT3]
    have := dupCost_le (zsz (n : ℤ)); omega
  have h2 := pow2_runs (I := I) pP hP n (s.upd PW (.int n :: s.G PW)) (s.G PW) (by simp)
  have h3g : ∀ s' : IState NS, s'.G PW = .int (2 ^ n) :: s.G PW →
      IRuns I iprog (.seq (.op (.dup PW T4)) (.seq (.op (.mv PW RN)) (.seq (.op (.const T5 1))
        (.seq (.op (.add T5 T4 T4)) (.op (.mv T4 RF)))))) s'
        (((s'.upd PW (s.G PW)).upd RN (.int (2 ^ n) :: s'.G RN)).upd RF
          (.int (2 ^ n + 1) :: s'.G RF)) (3000 * (n + 3)) := by
    intro s' h
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h, zsz_one, add_comm (1 : ℤ)]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz ((2 : ℤ) ^ n)); have := zsz_two_pow n
    have := moveIntCost_le (zsz ((2 : ℤ) ^ n + 1))
    have := zsz_add_le ((2 : ℤ) ^ n) 1; rw [zsz_one] at this
    have := dupCost_le (zsz ((2 : ℤ) ^ n))
    have := addIntCost_mono (show 1 + zsz ((2 : ℤ) ^ n) ≤ n + 2 by omega)
    have := addIntCost_le (n + 2)
    omega
  have h3 := h3g ((s.upd PW (.int n :: s.G PW)).upd PW (.int (2 ^ n) :: s.G PW)) (by simp)
  refine (IRuns.seq h1 (IRuns.seq h2 h3)).mono' ?_ ?_
  · clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  · simp only [pow2Cost]; omega

theorem parE_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N n k Q ℓ : ℕ)
    (L1 L2 L3 LZ : List Item) (hn : 1 ≤ n) (hkn : k ≤ n) (hnN : n ≤ N) (hQ : Q ≤ N)
    (hℓ : ℓ ≤ N)
    (hT1 : s.G T1 = .int k :: L1) (hT2 : s.G T2 = .int Q :: L2) (hT3 : s.G T3 = .int n :: L3)
    (hZ : s.G ZZ = .int ℓ :: LZ) :
    IRuns I iprog (parE pP) s
      ((((((((s.upd W2 (.int (2 ^ (n - k)) :: s.G W2)).upd HB (.int (2 ^ (n - 1)) :: s.G HB)).upd
        PRM (.int n :: s.G PRM)).upd T3 L3).upd T2 L2).upd T1 L1).upd ZZ LZ))
      (60000 * (N + 3)) := by
  have hzn : zsz (n : ℤ) ≤ n := zsz_natCast_le_self n
  have hzk : zsz (k : ℤ) ≤ n := le_trans (zsz_natCast_le_self k) hkn
  have e1 : -(k : ℤ) + n = ((n - k : ℕ) : ℤ) := by omega
  have e2 : -1 + (n : ℤ) = ((n - 1 : ℕ) : ℤ) := by omega
  have hz1 : zsz ((n - k : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hzn
  have hz2 : zsz ((n - 1 : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hzn
  set s1 := s.upd PW (.int (n - k : ℕ) :: s.G PW) with hs1
  have h1 : IRuns I iprog (.seq (.op (.dup T3 PW)) (.seq (.op (.dup T1 T4)) (.seq (.op (.neg T4))
      (.op (.add T4 PW PW))))) s s1 (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hT3, hT1, e1]
    refine ⟨by rw [hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := dupCost_le (zsz (n : ℤ)); have := dupCost_le (zsz (k : ℤ))
    have := addIntCost_mono (show zsz (-(k : ℤ)) + zsz (n : ℤ) ≤ 2 * n by rw [zsz_neg]; omega)
    have := addIntCost_le (2 * n)
    omega
  have h2 := pow2_runs (I := I) pP hP (n - k) s1 (s.G PW) (by simp [s1])
  set s2 := s1.upd PW (.int (2 ^ (n - k)) :: s.G PW) with hs2
  set s3 := (s2.upd W2 (.int (2 ^ (n - k)) :: s.G W2)).upd PW (.int (n - 1 : ℕ) :: s.G PW) with hs3
  have h3 : IRuns I iprog (.seq (.op (.mv PW W2)) (.seq (.op (.dup T3 PW)) (.seq (.op (.const T4 (-1)))
      (.op (.add T4 PW PW))))) s2 s3 (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hs2, hs1, hT3, e2, zsz_neg_one]
    refine ⟨by rw [hs3, hs2, hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz ((2 : ℤ) ^ (n - k))); have := zsz_two_pow (n - k)
    have := dupCost_le (zsz (n : ℤ))
    have := addIntCost_mono (show 1 + zsz (n : ℤ) ≤ 2 * n by omega)
    have := addIntCost_le (2 * n)
    omega
  have h4 := pow2_runs (I := I) pP hP (n - 1) s3 (s.G PW) (by simp [s3])
  have h5g : ∀ s' : IState NS, s'.G PW = .int (2 ^ (n - 1)) :: s.G PW → s'.G T3 = .int n :: L3 →
      s'.G T2 = .int Q :: L2 → s'.G T1 = .int k :: L1 → s'.G ZZ = .int ℓ :: LZ →
      IRuns I iprog (.seq (.op (.mv PW HB)) (.seq (.op (.mv T3 PRM)) (.seq (.op (.drop T2))
        (.seq (.op (.drop T1)) (.op (.drop ZZ)))))) s'
        ((((((s'.upd PW (s.G PW)).upd HB (.int (2 ^ (n - 1)) :: s'.G HB)).upd T3 L3).upd PRM
          (.int n :: s'.G PRM)).upd T2 L2).upd T1 L1 |>.upd ZZ LZ) (2000 * (N + 3)) := by
    intro s' h hh3 hh2 hh1 hhz
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, h, hh3, hh2, hh1, hhz]
    have := moveIntCost_le (zsz ((2 : ℤ) ^ (n - 1))); have := zsz_two_pow (n - 1)
    have := moveIntCost_le (zsz (n : ℤ))
    have := zsz_natCast_le_self Q; have := zsz_natCast_le_self ℓ
    omega
  have h5 := h5g (s3.upd PW (.int (2 ^ (n - 1)) :: s.G PW)) (by simp)
    (by simp +decide [s3, s2, s1, hT3]) (by simp +decide [s3, s2, s1, hT2])
    (by simp +decide [s3, s2, s1, hT1]) (by simp +decide [s3, s2, s1, hZ])
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 h5)))).mono' ?_ ?_
  · simp only [hs3, hs2, hs1]; clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)
  · simp only [pow2Cost]; omega

theorem fmQ_eq (N : ℕ) : fmQ N = (2 * fmM N + 2 * fmK N + 3) / 2 ^ fmK N + 1 := rfl
theorem fmN'_eq (N : ℕ) : fmN' N = fmQ N * 2 ^ fmK N := rfl

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N : ℕ)
    (LP : List Item) (hB : fmB N ≤ fmL N / 2) (hk : fmK N ≤ fmN' N) (hn1 : 1 ≤ fmN' N)
    (hnN : fmN' N ≤ N) (hQ : fmQ N ≤ N) (hℓ : fmL N ≤ N) (hPRM : s.G PRM = .int N :: LP) :
    IRuns I iprog (fmParams pP) s
      ((((((((((s.upd DL (.int (2 ^ fmK N) :: s.G DL)).upd RM (.int (2 ^ fmM N) :: s.G RM)).upd
        RQ (.int (2 ^ fmQ N) :: s.G RQ)).upd DE (.int (2 ^ (2 * fmQ N)) :: s.G DE)).upd
          RN (.int (2 ^ fmN' N) :: s.G RN)).upd RF (.int (2 ^ fmN' N + 1) :: s.G RF)).upd
            W2 (.int (2 ^ (fmN' N - fmK N)) :: s.G W2)).upd HB (.int (2 ^ (fmN' N - 1)) :: s.G HB)).upd
              PRM (.int (fmN' N) :: s.G PRM)))
      (1000 * (fmL N + 1) ^ 2 + 1000 * (fmB N + 1) ^ 2 + 30000 * (fmL N + 3) +
        180000 * (N + 3)) := by
  have hkN : fmK N ≤ N := by omega
  have hMN : fmM N ≤ N := Nat.div_le_self _ _
  have eM : N / 2 ^ fmK N = fmM N := rfl
  have hA := parA_runs (I := I) (iprog := iprog) pP hP s N LP hB hPRM
  set s1 := ((s.upd ZZ (.int (fmL N) :: s.G ZZ)).upd T1 (.int (fmK N) :: s.G T1)).upd DL
      (.int (2 ^ fmK N) :: s.G DL) with hs1
  have hBr := parB_runs (I := I) (iprog := iprog) pP hP s1 N (fmK N) LP (s.G DL) hkN
    (by simp +decide [s1, hPRM]) (by simp +decide [s1])
  simp only [eM] at hBr
  set s2 := (s1.upd T2 (.int (fmM N) :: s1.G T2)).upd RM (.int (2 ^ fmM N) :: s1.G RM) with hs2
  have hCr := parC_runs (I := I) (iprog := iprog) pP hP s2 N (fmM N) (fmK N) (s.G T1) (s.G T2)
    (s.G DL) hMN hkN (by rw [← fmQ_eq]; exact hQ) (by simp +decide [s2, s1])
    (by simp +decide [s2, s1]) (by simp +decide [s2, s1])
  rw [← fmQ_eq, ← fmN'_eq] at hCr
  set s3 := (((s2.upd T2 (.int (fmQ N) :: s.G T2)).upd T3 (.int (fmN' N) :: s2.G T3)).upd RQ
    (.int (2 ^ fmQ N) :: s2.G RQ)).upd DE (.int (2 ^ (2 * fmQ N)) :: s2.G DE) with hs3
  have hDr := parD_runs (I := I) (iprog := iprog) pP hP s3 (fmN' N) (s2.G T3) (by simp +decide [s3])
  set s4 := (s3.upd RN (.int (2 ^ fmN' N) :: s3.G RN)).upd RF (.int (2 ^ fmN' N + 1) :: s3.G RF)
    with hs4
  have hEr := parE_runs (I := I) (iprog := iprog) pP hP s4 N (fmN' N) (fmK N) (fmQ N) (fmL N)
    (s.G T1) (s.G T2) (s2.G T3) (s.G ZZ) hn1 hk hnN hQ hℓ (by simp +decide [s4, s3, s2, s1])
    (by simp +decide [s4, s3]) (by simp +decide [s4, s3]) (by simp +decide [s4, s3, s2, s1])
  refine (IRuns.seq hA (IRuns.seq hBr (IRuns.seq hCr (IRuns.seq hDr hEr)))).mono' ?_ ?_
  · simp only [hs4, hs3, hs2, hs1]
    clear * -
    apply IState.ext'
    · intro x; fin_cases x <;> simp +decide [IState.upd_G] <;> rfl
    · simp
    · simp
  · omega
end
