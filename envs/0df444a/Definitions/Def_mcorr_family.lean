-- title:
--   Unicritical correspondence family: orbits, filled Julia and Multibrot sets
-- statement:
--   Fix integers $p>q>0$ (the structure `UnicriticalExponent`, with the special case $(p,q)=(4,2)$). The unicritical algebraic correspondence $\mathbf{f}_c(z)=z^{p/q}+c$ is represented as the set of images $\{w:(w-c)^q=z^p\}$. A forward orbit of $z_0$ is a sequence $z$ with $z(0)=z_0$ and $z(i+1)\in\mathbf{f}_c(z(i))$. The filled Julia set $K_c$ (`filledJulia`) is the set of points admitting at least one bounded forward orbit; the Multibrot set $M_{p,q}$ (`multibrot`) is $\{c:0\in K_c\}$. Also defined: the orbit of the critical point $0$ written from the orbit of $a$ (`zeroOrbit`), the backward images $\mathbf{f}_a^{-n}(0)$ (`backwardOrbitSet`), and univalent branches (`IsUnivalentBranch`), i.e. holomorphic injective local selections of the correspondence.
-- source:
--   C. Siqueira, Similarity between the Multibrot set and the Julia set of correspondences at Misiurewicz points, https://arxiv.org/abs/2509.07266, Section 1.3 (eq. 1.1), Section 1.4, Definition 1.1, Section 2 (eq. 2.3), Section 2.1, Definition 5.1.

import Mathlib

open Set Filter Topology Finset

namespace MultibrotCorr


/-- Exponent data of the unicritical family: a rational exponent r = p/q > 1 represented by
natural numbers p > q > 0 (paper, Section 1.3, eq. (1.1)). -/
structure UnicriticalExponent where
  p : ℕ
  q : ℕ
  hq : 0 < q
  hpq : q < p

/-- The exponent (p,q) = (4,2): the semigroup correspondence generated by z^2+c and -z^2+c
(paper, Theorem 3.1 and Corollary 5.1). -/
def quadCorrExponent : UnicriticalExponent := ⟨4, 2, by decide, by decide⟩

/-- The unicritical algebraic correspondence f_c(z) = z^(p/q) + c, as the (p:q) correspondence
(w - c)^q = z^p (paper, eq. (1.1)); its value at z is the set of images w. -/
def unicriticalCorr (p q : ℕ) (c z : ℂ) : Set ℂ :=
  {w | (w - c) ^ q = z ^ p}

/-- The forward orbit of the critical point 0 written in terms of the orbit z of a = f_c(0):
the sequence 0, a = z 0, z 1, z 2, ... (paper, Sections 1.4 and 6.2). -/
def zeroOrbit (z : ℕ → ℂ) : ℕ → ℂ
  | 0 => 0
  | (j + 1) => z j

/-- A forward orbit of the correspondence starting at z0 (paper, Section 1.4). -/
def IsForwardOrbit (e : UnicriticalExponent) (c z0 : ℂ) (z : ℕ → ℂ) : Prop :=
  z 0 = z0 ∧ ∀ i, z (i + 1) ∈ unicriticalCorr e.p e.q c (z i)

/-- The filled Julia set K_c: points with at least one bounded forward orbit
(paper, Section 1.4 and Section 2, eq. (2.3)). -/
def filledJulia (e : UnicriticalExponent) (c : ℂ) : Set ℂ :=
  {z0 | ∃ z, IsForwardOrbit e c z0 z ∧ ∃ R, ∀ i, ‖z i‖ ≤ R}

/-- The Multibrot set M_(p,q): parameters c for which 0 lies in K_c
(paper, Definition 1.1 and Definition 5.1). -/
def multibrot (e : UnicriticalExponent) : Set ℂ :=
  {c | (0 : ℂ) ∈ filledJulia e c}

/-- The n-th backward image of 0 under f_a, i.e. f_a^(-n)(0): points admitting a forward orbit
of length n ending at 0 (used in Theorem D of arXiv:2509.05682). -/
def backwardOrbitSet (e : UnicriticalExponent) (a : ℂ) (n : ℕ) : Set ℂ :=
  {z | ∃ w : ℕ → ℂ, w 0 = z ∧ w n = 0 ∧
    ∀ i < n, w (i + 1) ∈ unicriticalCorr e.p e.q a (w i)}

/-- A univalent branch of f_c on an open set U: a holomorphic injective map f with
(f z - c)^q = z^p for all z in U (paper, Section 2.1). -/
def IsUnivalentBranch (e : UnicriticalExponent) (c : ℂ) (U : Set ℂ) (f : ℂ → ℂ) : Prop :=
  IsOpen U ∧ DifferentiableOn ℂ f U ∧ Set.InjOn f U ∧
  ∀ z ∈ U, (f z - c) ^ e.q = z ^ e.p

end MultibrotCorr


