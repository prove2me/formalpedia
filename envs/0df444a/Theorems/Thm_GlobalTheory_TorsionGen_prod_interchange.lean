theorem GlobalTheory.TorsionGen.prod_interchange (t₁ t₂ : A → A → A → U)
    (ic : ∀ x x' y y', t₁ x x' (y * y') * t₂ x y y' * t₂ x' y y' = t₂ (x * x') y y' * t₁ x x' y * t₁ x x' y')
    (x a y : A) (n : ℕ) :
    (∏ k ∈ Finset.range n, t₁ (x ^ k) x (a * y)) * t₂ x a y ^ n * t₂ 1 a y =
      t₂ (x ^ n) a y * (∏ k ∈ Finset.range n, t₁ (x ^ k) x a) * (∏ k ∈ Finset.range n, t₁ (x ^ k) x y) := by sorry
