open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.D.EMCertificateD
variable {n : ℕ} {g ginv : Metric (n + 1)} {F : TwoForm (n + 1)} {U : Set (Pt (n + 1))}
theorem solution (h : EMCertificateD g ginv F U) {g' ginv' : Metric (n + 1)} {F' : TwoForm (n + 1)}
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) U) (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) U)
    (hF : ∀ i j, Set.EqOn (F i j) (F' i j) U) : EMCertificateD g' ginv' F' U where
  isOpen := h.isOpen
  nonempty := h.nonempty
  symm x hx i j := by rw [← hg i j hx, ← hg j i hx]; exact h.symm x hx i j
  inv x hx := by
    have e1 : metricMatrix g' x = metricMatrix g x := by
      ext i j; simp [metricMatrix, hg i j hx]
    have e2 : metricMatrix ginv' x = metricMatrix ginv x := by
      ext i j; simp [metricMatrix, hgi i j hx]
    rw [e1, e2]; exact h.inv x hx
  smooth i j := (h.smooth i j).congr fun x hx => (hg i j hx).symm
  smooth_inv i j := (h.smooth_inv i j).congr fun x hx => (hgi i j hx).symm
  smooth_F i j := (h.smooth_F i j).congr fun x hx => (hF i j hx).symm
  antisymm x hx i j := by rw [← hF i j hx, ← hF j i hx]; exact h.antisymm x hx i j
  lorentz x hx := by
    have e1 : metricMatrix g' x = metricMatrix g x := by
      ext i j; simp [metricMatrix, hg i j hx]
    rw [e1]; exact h.lorentz x hx
  einstein x hx i j := by
    have hgx : ∀ i j, g i j x = g' i j x := fun i j => hg i j hx
    have hgix : ∀ i j, ginv i j x = ginv' i j x := fun i j => hgi i j hx
    have hFx : ∀ i j, F i j x = F' i j x := fun i j => hF i j hx
    have hR : ∀ b d, ricciOf g ginv b d x = ricciOf g' ginv' b d x :=
      ricciOf_congr_of_eqOn h.isOpen hg hgi hx
    have e : einsteinMaxwellD g ginv F i j x = einsteinMaxwellD g' ginv' F' i j x := by
      simp only [einsteinMaxwellD, ricciScalar, emStressD, hR, hgx, hgix, hFx,
        fieldSq_congr_at hgix hFx]
    rw [← e]; exact h.einstein x hx i j
  maxwell x hx b := by
    have hgix : ∀ i j, ginv i j x = ginv' i j x := fun i j => hgi i j hx
    have hFx : ∀ i j, F i j x = F' i j x := fun i j => hF i j hx
    have hup : ∀ a b, Set.EqOn (raise2 ginv F a b) (raise2 ginv' F' a b) U := fun a b y hy =>
      raise2_congr_at (fun i j => hgi i j hy) (fun i j => hF i j hy) a b
    have hΓ : ∀ a c d, christoffel g ginv a c d x = christoffel g' ginv' a c d x :=
      fun a c d => christoffel_congr_of_eqOn h.isOpen hg hgi a c d hx
    have hpd : ∀ a b, pd a (raise2 ginv F a b) x = pd a (raise2 ginv' F' a b) x :=
      fun a b => pd_congr_of_eqOn h.isOpen hx (hup a b) a
    have e : maxwellDiv g ginv F b x = maxwellDiv g' ginv' F' b x := by
      simp only [maxwellDiv, hpd, hΓ, raise2_congr_at hgix hFx]
    rw [← e]; exact h.maxwell x hx b
  closed x hx i j k := by
    have hpd : ∀ a b c, pd a (F b c) x = pd a (F' b c) x :=
      fun a b c => pd_congr_of_eqOn h.isOpen hx (hF b c) a
    have e : faradayCyclic F i j k x = faradayCyclic F' i j k x := by
      simp only [faradayCyclic, hpd]
    rw [← e]; exact h.closed x hx i j k
