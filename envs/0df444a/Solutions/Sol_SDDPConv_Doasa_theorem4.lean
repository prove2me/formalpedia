noncomputable def cutHeight (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (x : Fin (I.n t) → ℝ) : ℝ :=
  sSup ((fun a => Cut.eval I a x) '' C)

def dualSignature (I : Instance) (t : ℕ) (l : List (Cut I t)) (d : Dual I t) :
    (Fin (I.m t) → ℝ) × ℝ :=
  (d.1, ∑ j : Fin l.length, d.2 j * (l.get j).1)

def dualSignatures (I : Instance) (t : ℕ) (C : Set (Cut I t)) :
    Set ((Fin (I.m t) → ℝ) × ℝ) :=
  {v | ∃ l : List (Cut I t), (∀ a ∈ l, a ∈ C) ∧
    ∃ d ∈ Set.extremePoints ℝ (H I t l), dualSignature I t l d = v}

end DOASAProof

