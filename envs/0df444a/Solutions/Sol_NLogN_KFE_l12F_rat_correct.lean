lemma ShapeLE.valid {S T : Shape} (h : ShapeLE S T) {a : List ℕ} (ha : AModel.Valid S a) :
    AModel.Valid T a := by
  obtain ⟨hl, hlt⟩ := (valid_iff S a).1 ha
  refine (valid_iff T a).2 ⟨by rw [hl, h.1], fun k h₁ h₂ => ?_⟩
  exact lt_of_lt_of_le (hlt k h₁ (by omega)) (h.2 k (by omega) h₂)

@[simp] lemma length_embed (S T : Shape) (d : α) (xs : List α) :
    (AModelL12.embed S T d xs).length = AModel.vol T := by simp [AModelL12.embed]

/-- **Padding lemma.** Embedding `S` into `T ≥ S`, applying any pull whose address map keeps
valid `S`-addresses valid `S`-addresses, and extracting, is the same pull on the original
array. (The padded entries may be arbitrary: the pull never reads them at `S`-addresses.) -/
theorem extract_pull_embed {S T : Shape} (hST : ShapeLE S T) (g : List ℕ → List ℕ)
    (hg : ∀ a, AModel.Valid S a → AModel.Valid S (g a)) (d : α) (xs : List α) :
    extract S T d (AModel.pull T T g d (AModelL12.embed S T d xs)) = AModel.pull S S g d xs := by
  classical
  unfold extract
  rw [pull_comp g id (fun a ha => hST.valid ha)]
  apply List.ext_getElem (by simp)
  intro j h₁ h₂
  simp only [length_pull] at h₁
  rw [getElem_pull, getElem_pull, Function.comp_apply, id]
  have hv := hg _ (valid_decode h₁)
  have hlt := encode_lt (hST.valid hv)
  rw [List.getD_eq_getElem _ _ (by simpa using hlt)]
  simp only [AModelL12.embed, List.getElem_map, List.getElem_range, decode_encode (hST.valid hv),
    if_pos hv]

end Embed

section Pieces

lemma blockSwap_blockSwap_adj {i j r₁ r₂ : ℕ} {a : List ℕ} (hij : i + r₁ + r₂ ≤ j)
    (hj : j + r₁ + r₂ ≤ a.length) :
    blockSwap i j r₁ (blockSwap (i + r₁) (j + r₁) r₂ a) = blockSwap i j (r₁ + r₂) a := by
  unfold blockSwap
  rw [permIdx_permIdx (fun k hk => bsIdx_lt (by omega) (by omega) hk)]
  apply permIdx_congr
  intro k _
  simp only [Function.comp_apply]
  unfold bsIdx
  split_ifs <;> omega

/-- **Interchanging two chunks = interchanging all corresponding aligned pieces.** If every
piece operation at offset `o` with width `w t` is the pull by the block swap of the digit runs
`[c + o, c + o + w t)` and `[c' + o, c' + o + w t)`, then running all pieces is the pull by the
block swap of the whole chunks `[c + o₀, c + o₀ + Σ w)` and `[c' + o₀, …)`. -/
theorem runPieces_eq {α β : Type*} {T : Shape} {c c' n : ℕ} (hcc : c + n ≤ c')
    (hc' : c' + n ≤ T.length) (hsz : ∀ k < n, T.getD (c + k) 0 = T.getD (c' + k) 0)
    (step : ℕ → β → List α → List α) (w : β → ℕ) (d : α)
    (hstep : ∀ o t ys, o + w t ≤ n → ys.length = AModel.vol T →
      step o t ys = AModel.pull T T (blockSwap (c + o) (c' + o) (w t)) d ys) :
    ∀ (ts : List β) (o : ℕ) (xs : List α), o + (ts.map w).sum ≤ n → xs.length = AModel.vol T →
      runPieces step w o ts xs = AModel.pull T T (blockSwap (c + o) (c' + o) (ts.map w).sum) d xs := by
  intro ts
  induction ts with
  | nil =>
    intro o xs _ hxs
    simp only [runPieces, List.map_nil, List.sum_nil]
    rw [pull_congr (g' := id) (fun a _ => blockSwap_zero _ _ a), pull_id d hxs]
  | cons t ts ih =>
    intro o xs ho hxs
    simp only [List.map_cons, List.sum_cons] at ho ⊢
    simp only [runPieces]
    rw [hstep o t xs (by omega) hxs, ih (o + w t) _ (by omega) (by simp),
      pull_comp (blockSwap (c + o) (c' + o) (w t))
        (blockSwap (c + (o + w t)) (c' + (o + w t)) (ts.map w).sum) (fun a ha => valid_blockSwap (i := c + (o + w t))
        (j := c' + (o + w t)) (r := (ts.map w).sum) (by omega) (by omega) (fun k hk => by
          rw [show c + (o + w t) + k = c + (o + w t + k) by omega,
            show c' + (o + w t) + k = c' + (o + w t + k) by omega]
          exact hsz _ (by omega)) ha)]
    apply pull_congr
    intro a ha
    simp only [Function.comp_apply]
    rw [show c + (o + w t) = c + o + w t by omega, show c' + (o + w t) = c' + o + w t by omega,
      blockSwap_blockSwap_adj (by omega) (by rw [ha.length_eq]; omega)]

end Pieces

