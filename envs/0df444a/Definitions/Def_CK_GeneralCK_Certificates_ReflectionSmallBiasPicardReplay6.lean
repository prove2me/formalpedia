theorem stage6_replay {k : ℂ} {f : ℂ × ℂ → ℂ}
    (hk : k ≠ 0) (hklog : k = (Real.log 2 : ℂ))
    (hf : Approximates 24 k f stage5) (hf0 : f 0 = 0) :
    Approximates 24 k (fun z => z.1 * ComplexEntropy.entropyExt (f z)) stage6 := by
  have h2 : Approximates 24 k (fun z => f z ^ 2) replay6p2 := by
    convert (hf.mul hk hf).replacePolynomial (equalityCheck_sound replay6p2_checked k) using 1
    funext z
    ring
  have h4 : Approximates 24 k (fun z => f z ^ 4) replay6p4 := by
    convert (h2.mul hk h2).replacePolynomial (equalityCheck_sound replay6p4_checked k) using 1
    funext z
    ring
  have h6 : Approximates 24 k (fun z => f z ^ 6) replay6p6 := by
