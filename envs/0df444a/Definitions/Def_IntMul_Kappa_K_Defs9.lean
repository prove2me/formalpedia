-- Source module: Solutions.NetProp7Sum
/-!
# Prop. 7, part 5: the labelled network and its rank sum

Labels of table (6) on the gates of `named7` (`labG`), terminal labels `MinL`, `MoutL`
(sources `X_a ↦ −P_{U_a}`, otherwise `0`; sinks `Y_a ↦ P_{U_a^⊥} = 1 − P_{U_a}`, otherwise `1`),
and the per-wire rank sums (Lemma 6):
`X_a ↦ m`, `Y_a ↦ m − 1`, side wire `↦ m`, central wire `↦ m + 2h`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option synthInstance.maxSize 512

namespace NetProp7

open Matrix Finset AModel NetScalar NetLabels
open scoped Kronecker

variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] (ind : T → Finset (Fin h))

/-- Physical time of row `r` at stage `j` (reversed at stage 2). -/
def time (j : Fin 3) (r : Fin 8) : ℕ := if j = 1 then 7 - r.val else r.val

/-- Triple projection of a gate name's triple (`0` for the central gates). -/
noncomputable def τo (j : Fin 3) : Option T → Matrix (Cube h) (Cube h) ℚ
  | none => 0
  | some t => τM j (ind t)

/-- **Gate labels (table (6))**, by gate name. -/
noncomputable def labG : NetScalar.GName T → Matrix (Cube h) (Cube h) ℚ
  | (j, p, (r, o)) => labK (αM j (ind p.1) (ind p.2)) (AM j (ind p.1) (ind p.2)) (τo ind j o)
      (NetProp7.time j r)

/-- The labelled gates. -/
noncomputable def gatesL : List (NGate (NetScalar.Wr ind) (ZMod 2) (Matrix (Cube h) (Cube h) ℚ)) :=
  NetScalar.labelled (labG ind) (named7 ind)

/-- `P_{U_a}`. -/
noncomputable def uA (a : T × T × T) : Matrix (Cube h) (Cube h) ℚ :=
  uM (ind a.1) (ind a.2.1) (ind a.2.2)

/-- Source labels: `X_a ↦ −P_{U_a}`, all other sources `0`. -/
noncomputable def MinL : NetScalar.Wr ind → Matrix (Cube h) (Cube h) ℚ
  | Sum.inl a => -NetProp7.uA ind a
  | Sum.inr _ => 0

/-- Sink labels: `Y_a ↦ 1 − P_{U_a}`, all other sinks `1`. -/
noncomputable def MoutL : NetScalar.Wr ind → Matrix (Cube h) (Cube h) ℚ
  | Sum.inl _ => 1
  | Sum.inr (Sum.inl a) => 1 - NetProp7.uA ind a
  | Sum.inr (Sum.inr _) => 1

variable (hcard : ∀ t, (ind t).card = 3)
include hcard

omit hcard in
/-- The wire count `W = 2v³ + 3v² (z + h)`. -/
lemma card_Wr : (Fintype.card (NetScalar.Wr ind) : ℚ) = 2 * (Fintype.card T : ℚ) ^ 3 +
    3 * (Fintype.card T : ℚ) ^ 2 * ((Fintype.card (NetScalar.Nb ind) : ℚ) + h) := by
  simp only [Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
  push_cast
  ring

end NetProp7

