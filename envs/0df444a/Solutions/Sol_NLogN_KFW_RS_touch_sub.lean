-- Source module: Solutions.KFWSub
/-!
# KFW: literals read from registers (the uniformity meta-theorem for register programs)

A uniform register program `U` reads its run-time parameters from registers (tops of stacks).
`RS.sub σ U` replaces each register `i` with `σ i = some v` by the literal `v`; the result is
the (non-uniform) program with baked-in literals, for which a spec is usually already proved.

**`FSp.of_sub`**: if `FSp (U.sub σ) s t c`, the registers of `σ` hold their values in `s`
(`Agree σ s`) and `U` never writes them, then `FSp U s t (400 c)`.  Also `fok_of_sub`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFW

open IntMul RS KFD

theorem Ex.regs_sub (σ : Fin HS → Option ℤ) : ∀ e : Ex HS, ∀ i ∈ e.regs,
    i ∈ (Ex.sub σ e).regs ∨ (σ i).isSome
  | .reg i, j, h => by
    simp only [Ex.regs, List.mem_singleton] at h; subst h
    unfold Ex.sub
    rcases hσ : σ j with _ | v
    · left; simp [Ex.regs]
    · right; simp
  | .lit c, j, h => by simp [Ex.regs] at h
  | .add a b, j, h | .mul a b, j, h | .shl a b, j, h | .quo a b, j, h | .rem a b, j, h
  | .ndiv a b, j, h | .nmod a b, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with h | h
    · rcases Ex.regs_sub σ a j h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases Ex.regs_sub σ b j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .neg a, j, h | .pow2 a, j, h => by
    simp only [Ex.regs] at h
    simp only [Ex.sub, Ex.regs]
    exact Ex.regs_sub σ a j h
  | .sel c x y, j, h => by
    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.sub, Ex.regs, List.mem_append]
    rcases h with (h | h) | h
    · rcases Ex.regs_sub σ c j h with h' | h'
      · exact Or.inl (Or.inl (Or.inl h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ x j h with h' | h'
      · exact Or.inl (Or.inl (Or.inr h'))
      · exact Or.inr h'
    · rcases Ex.regs_sub σ y j h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'

theorem RS.touch_sub_sol_aux (σ : Fin HS → Option ℤ) : ∀ (p : RS), ∀ i ∈ touch p,
    i ∈ touch (RS.sub σ p) ∨ (σ i).isSome
  | .skip, i, h => by simp [touch] at h
  | .asg j e, i, h | .push j e, i, h => by
    simp only [touch, List.mem_cons] at h
    simp only [RS.sub, touch, List.mem_cons]
    rcases h with h | h
    · exact Or.inl (Or.inl h)
    · rcases Ex.regs_sub σ e i h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .pop j, i, h => Or.inl h
  | .seq a b, i, h => by
    simp only [touch, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_append]
    rcases h with h | h
    · rcases RS.touch_sub_sol_aux σ a i h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases RS.touch_sub_sol_aux σ b i h with h' | h'
      · exact Or.inl (Or.inr h')
      · exact Or.inr h'
  | .ite c a b, i, h => by
    simp only [touch, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_append]
    rcases h with h | h | h
    · rcases Ex.regs_sub σ c i h with h' | h'
      · exact Or.inl (Or.inl h')
      · exact Or.inr h'
    · rcases RS.touch_sub_sol_aux σ a i h with h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr h'
    · rcases RS.touch_sub_sol_aux σ b i h with h' | h'
      · exact Or.inl (Or.inr (Or.inr h'))
      · exact Or.inr h'
  | .rep j n b, i, h => by
    simp only [touch, List.mem_cons, List.mem_append] at h
    simp only [RS.sub, touch, List.mem_cons, List.mem_append]
    rcases h with h | h | h
    · exact Or.inl (Or.inl h)
    · rcases Ex.regs_sub σ n i h with h' | h'
      · exact Or.inl (Or.inr (Or.inl h'))
      · exact Or.inr h'
    · rcases RS.touch_sub_sol_aux σ b i h with h' | h'
      · exact Or.inl (Or.inr (Or.inr h'))
      · exact Or.inr h'

end NLogN.KFW

