-- title:
--   Growth of g(E₄²E₆)^m against hΔ^m at the cusps
-- statement:
--   Fix $N\in\mathbb N$, a weight $k\in\mathbb Z$ and an integer $m\ge 1$, and let $g,h$ be modular forms of weight $k$ for $\Gamma_0(N)$ with $h\ne 0$. Let $X$ be a Laurent series over $\mathbb C$ satisfying $X\cdot\tilde h=\tilde g$, where $\tilde g,\tilde h$ denote the $q$-expansions of $g,h$ at $\infty$ with period $1$, viewed as Laurent series. Write $J:=$ [`ModularCurve.coeffEmb ℂ ModularCurve.jq`](def/ModularCurve_LaurentCoeff.html#L81), the coefficientwise image under $\mathbb Q\to\mathbb C$ of the Laurent series $q^{-1}\cdot$`jNumQ` $\in\mathbb Q((q))$, i.e. the $q$-expansion of the modular invariant $j$. Assume that $X^2\,J^m\,(J-1728)^m$ is integral over the $\mathbb C$-subalgebra of $\mathbb C((q))$ generated by $J^{-1}$, where $1728$ means the image of the constant $1728$. Then for every $A\in\mathrm{SL}_2(\mathbb Z)$ there is a real constant $C$ such that, for $\tau$ in a neighbourhood of $i\infty$ in the filter `UpperHalfPlane.atImInfty`, $$\bigl\|\bigl(z\mapsto g(z)\,(E_4(z)^2E_6(z))^m\bigr)\mid_{k+14m}A\,(\tau)\bigr\|\le C\,\bigl\|\bigl(z\mapsto h(z)\,\Delta(z)^m\bigr)\mid_{k+12m}A\,(\tau)\bigr\|,$$ the slash actions being taken with respect to the image of $A$ in $\mathrm{GL}_2(\mathbb R)$. No positivity of $C$ is asserted.
--
--   This is the modular-form form of the standard estimate bounding a meromorphic function on $X_0(N)$, integral over $\mathbb C[1/j]$ after the indicated twist, at every cusp: the integrality hypothesis forces the order of $X$ at each cusp to be at least $m$ times its width, so the translated ratio stays bounded rather than merely meromorphic. It feeds the construction of a genuine modular form with prescribed $q$-expansion in [`ModularCurve.exists_modularForm_qExpansion_eq_mul_thetaL_pow_of_isIntegral`](thm.html#ModularCurve.exists_modularForm_qExpansion_eq_mul_thetaL_pow_of_isIntegral).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_eventually_norm_slash_le_mul_of_isIntegral_adjoin_coeffEmb_jq_inv_sq.lean

import Mathlib
import Definitions.Def_ModularCurve_X0
import Definitions.Def_ModularCurve_LaurentCoeff

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve
open scoped MatrixGroups ModularForm

theorem ModularCurve.eventually_norm_slash_le_mul_of_isIntegral_adjoin_coeffEmb_jq_inv_sq (N : ℕ) {k : ℤ} (m : ℕ) (hm : 1 ≤ m)
    (g h : ModularForm (CongruenceSubgroup.Gamma0 N) k) (hh : h ≠ 0) (X : LaurentSeries ℂ)
    (hX : X * ((UpperHalfPlane.qExpansion 1 (h : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ) = ((UpperHalfPlane.qExpansion 1 (g : UpperHalfPlane → ℂ) : PowerSeries ℂ) : LaurentSeries ℂ))
    (h₂ : IsIntegral (Algebra.adjoin ℂ ({(ModularCurve.coeffEmb ℂ ModularCurve.jq)⁻¹} : Set (LaurentSeries ℂ)))
      (X ^ 2 * ModularCurve.coeffEmb ℂ ModularCurve.jq ^ m * (ModularCurve.coeffEmb ℂ ModularCurve.jq - algebraMap ℂ (LaurentSeries ℂ) 1728) ^ m))
    (A : Matrix.SpecialLinearGroup (Fin 2) ℤ) :
    ∃ C : ℝ, ∀ᶠ τ : UpperHalfPlane in UpperHalfPlane.atImInfty,
      ‖((fun z : UpperHalfPlane => g z * (ModularForm.E₄ z ^ 2 * ModularForm.E₆ z) ^ m) ∣[k + 14 * (m : ℤ)] (A : GL (Fin 2) ℝ)) τ‖ ≤
        C * ‖((fun z : UpperHalfPlane => h z * ModularForm.discriminant z ^ m) ∣[k + 12 * (m : ℤ)] (A : GL (Fin 2) ℝ)) τ‖ := by sorry
