    (n : ℕ) (x y : SpherePacking.Euclidean n) :
    ⟪gtTransverseEuclidean n x, gtTransverseEuclidean n y⟫_ℝ =
      ⟪x, y⟫_ℝ := by
  rw [PiLp.inner_apply, Fin.sum_univ_castSucc]
  simp [PiLp.inner_apply]
