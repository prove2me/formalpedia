-- title:
--   Index ℓ+1 for the stabiliser of a prime Hecke meet order
-- statement:
--   Fix rationals $a,b$ and a prime $q'$ such that $\mathbb{H} = \mathbb{H}[\mathbb{Q},a,b]$ satisfies [`QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q'`](def/QuaternionAlgebra_EichlerOrder.html#L87), i.e. $a<0$, $b<0$, and for every height-one prime $v$ of $\mathcal{O}_{\mathbb{Q}}$ the algebra $\mathbb{H}\otimes_{\mathbb{Q}} \mathbb{Q}_v$ has all its nonzero elements invertible exactly when $q'$ lies in $v$. Let $R$ be a $\mathbb{Z}$-submodule of $\mathbb{H}$ which is an Eichler order of level $N$ in the sense of [`QuaternionAlgebra.IsEichlerOrder`](def/QuaternionAlgebra_EichlerOrder.html#L69): $R = \Lambda_1 \sqcap \Lambda_2$ for two orders $\Lambda_1,\Lambda_2$ each maximal among orders containing it, with the relative index of the additive group of $R$ in that of $\Lambda_1$ equal to $N$. Let $\ell$ be a prime with $\ell \nmid N$ and $\ell \neq q'$, and let $g$ be a unit of $\mathbb{H}\otimes_{\mathbb{Q}}\mathbb{A}^{\mathrm{fin}}_{\mathbb{Q}}$ lying in the prime Hecke set [`QuaternionAlgebra.primeHeckeSet R ℓ`](def/QuaternionAlgebra_ClassSetHecke.html#L109), that is: $g$ lies in the finite adelic box $\widehat{R}$ (the additive subgroup generated by the elements $z \otimes \alpha$ with $z \in R$ and $\alpha$ an everywhere integral finite adele), $\ell \cdot g^{-1} \in \widehat{R}$, while $g^{-1} \notin \widehat{R}$ and $\ell^{-1}\cdot g \notin \widehat{R}$. Write $R' =$ [`CerednikDrinfeld.meetOrder R g`](def/CerednikDrinfeld_ClassSetGraph.html#L15) $= R \sqcap$ [`Submodule.conjByFiniteIdele R g`](def/Submodule_FiniteAdeleBox.html#L31), the $\mathbb{Z}$-submodule of elements of $R$ whose image in $\mathbb{H}\otimes_{\mathbb{Q}}\mathbb{A}^{\mathrm{fin}}_{\mathbb{Q}}$ lies in $g\widehat{R}g^{-1}$. Then the relative index of the stabiliser of $\widehat{R'}$ in the stabiliser of $\widehat{R}$ inside the unit group of $\mathbb{H}\otimes_{\mathbb{Q}}\mathbb{A}^{\mathrm{fin}}_{\mathbb{Q}}$ — that is, the index of the intersection of the two stabilisers in the stabiliser of $\widehat{R}$ — equals $\ell+1$.
--
--   This is the local degree computation $[\widehat{R}^{\times} : \widehat{R}^{\times} \cap g\widehat{R}^{\times}g^{-1}] = \ell+1$ attached to a Hecke element at a prime $\ell$ not dividing the Eichler level and distinct from the ramified prime, the count of cosets in $\widehat{R}^{\times} g \widehat{R}^{\times}/\widehat{R}^{\times}$. It supplies the arrow degrees and the fibre sums $\sum_{v' \mapsto v} \deg v' = \ell+1$ for the degeneracy maps of the coset graph in the Čerednik–Drinfeld class set tower.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CerednikDrinfeld_relIndex_finiteIdeleStabilizer_meetOrder_eq_succ_of_mem_primeHeckeSet.lean

import Definitions.Def_CerednikDrinfeld_ClassSetGraph
import Definitions.Def_QuaternionAlgebra_EichlerOrder

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open scoped TensorProduct Quaternion
open IsDedekindDomain NumberField

theorem CerednikDrinfeld.relIndex_finiteIdeleStabilizer_meetOrder_eq_succ_of_mem_primeHeckeSet
    {a b : ℚ} {q' : ℕ} [Fact q'.Prime] (hdef : QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q')
    {R : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} (hR : QuaternionAlgebra.IsEichlerOrder R N)
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓN : ¬ ℓ ∣ N) (hℓq' : ℓ ≠ q')
    {g : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ} (hg : g ∈ QuaternionAlgebra.primeHeckeSet R ℓ) :
    (Submodule.finiteIdeleStabilizer (CerednikDrinfeld.meetOrder R g)).relIndex
      (Submodule.finiteIdeleStabilizer R) = ℓ + 1 := by sorry
