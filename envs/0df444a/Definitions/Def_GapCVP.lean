          by_cases ordinary : row < ordinaryBoundary
          · simp [global, afterGlobal, refinement,
              afterRefinement, ordinary]
          · have afterOrdinary : ordinaryBoundary ≤ row :=
              Nat.le_of_not_gt ordinary
