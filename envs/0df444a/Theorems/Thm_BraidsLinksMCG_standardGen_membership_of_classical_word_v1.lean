-- title:
--   The classical standard-loop braid identity implies elementary half-twist subgroup membership
-- statement:
--   Assuming the explicit geometric identity expressing the standard punctured-plane generator as the classical pure braid word in elementary half-twists, its projected braid belongs to the subgroup generated by those half-twists. This isolates the algebraic implication from the outstanding geometric path-homotopy identity.
-- source:
--   Tarcha Teorema 3.11, reduction from the explicit standard-loop pure braid word to subgroup membership; the unresolved geometric identity remains a separate obligation.

import Mathlib
import Definitions.Def_BraidsLinksMCG_ConfigSpace
import Definitions.Def_BraidsLinksMCG_StandardLoops
import Definitions.Def_TarchaBraids_HalfTwist
import Definitions.Def_TarchaBraids_generation_word_data_v1
import Definitions.Def_TarchaBraids_standard_pure_braid_word_v1

open TarchaBraids

namespace BraidsLinksMCG

open TarchaBraids

theorem standardGen_membership_of_classical_word_v1 (n : ℕ) (j : Fin n)
    (hclassical :
      (FundamentalGroup.map (configProj (n + 1)) (baseOrdered (n + 1)))
          ((FundamentalGroup.mapOfEq (configIncl n) (BraidsLinksMCG.configIncl_base n))
            (standardGen n j))
        =
      FreeGroup.lift
          (fun i : Fin (n + 1 - 1) => halfTwistBraid (n + 1) i)
          (braidWordFree (standardPureBraidWord n j))) :
    (FundamentalGroup.map (configProj (n + 1)) (baseOrdered (n + 1)))
        ((FundamentalGroup.mapOfEq (configIncl n) (BraidsLinksMCG.configIncl_base n))
          (standardGen n j))
      ∈ Subgroup.closure
          (Set.range (fun i : Fin (n + 1 - 1) => halfTwistBraid (n + 1) i)) := by sorry

end BraidsLinksMCG
