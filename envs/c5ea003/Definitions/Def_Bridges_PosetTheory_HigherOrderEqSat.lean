/-! ## Section 10: Higher-Order Equivalence Generation -/

/-- Higher-order equivalence generation: the congruence/equivalence closure
    generated by user axioms `R`, β-reduction, η-expansion, and congruence
    under `app` and `lam`. -/
inductive HOEqvGen
    (R : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → HOTerm Γ τ → Prop)
    : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → HOTerm Γ τ → Prop where
  | user : ∀ {Γ : Ctx} {τ : HOType} {t u : HOTerm Γ τ},
      R t u → HOEqvGen R t u
  | beta : ∀ {Γ : Ctx} {σ τ : HOType}
      (body : HOTerm (σ :: Γ) τ) (arg : HOTerm Γ σ),
      HOEqvGen R (app (lam body) arg) (subst0 arg body)
  | eta : ∀ {Γ : Ctx} {σ τ : HOType}
      (f : HOTerm Γ (σ ⟶ₕ τ)),
      HOEqvGen R (lam (app (weaken f) (var vz))) f
  | refl : ∀ {Γ : Ctx} {τ : HOType} {t : HOTerm Γ τ},
      HOEqvGen R t t
  | symm : ∀ {Γ : Ctx} {τ : HOType} {t u : HOTerm Γ τ},
      HOEqvGen R t u → HOEqvGen R u t
  | trans : ∀ {Γ : Ctx} {τ : HOType} {t u v : HOTerm Γ τ},
      HOEqvGen R t u → HOEqvGen R u v → HOEqvGen R t v
  | congr_lam : ∀ {Γ : Ctx} {σ τ : HOType} {t u : HOTerm (σ :: Γ) τ},
      HOEqvGen R t u → HOEqvGen R (.lam t) (.lam u)
  | congr_app_fn : ∀ {Γ : Ctx} {σ τ : HOType}
      {f g : HOTerm Γ (σ ⟶ₕ τ)} {x : HOTerm Γ σ},
      HOEqvGen R f g → HOEqvGen R (.app f x) (.app g x)
  | congr_app_arg : ∀ {Γ : Ctx} {σ τ : HOType}
      {f : HOTerm Γ (σ ⟶ₕ τ)} {x y : HOTerm Γ σ},
      HOEqvGen R x y → HOEqvGen R (.app f x) (.app f y)

