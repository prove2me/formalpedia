    (by simp [RS.writes, hYC.symm]) (clean_reg_r6c hr5)
    (by simp only [List.replicate_zero, List.nil_append, Function.update_eq_self]
        exact IState.isInt_of_r6c hr) trivial
    (by simp only [List.replicate_zero, List.nil_append, Function.update_eq_self, Ex.Bnd]
        rw [IState.top_eq_r6c hr]; exact hn)
    (by simp only [List.replicate_zero, List.nil_append, Function.update_eq_self, Ex.eval]
        rw [IState.top_eq_r6c hr]) ?_
