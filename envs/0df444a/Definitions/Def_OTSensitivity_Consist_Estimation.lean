-- title:
--   Separate-cost bound, condition (73), cell laws, partitions (75) and weak convergence (Appendix A, pp. 38–39)
-- statement:
--   This module fixes the objects of the estimation setting of Appendix A (pp. 38–39) and of the "bounded separate costs" condition of p. 4.
--
--   1. **Bounded separate costs** (p. 4): continuous functions $a_1,a_2:\mathsf Y\to[0,\infty)$ with $k(y,y')\le a_1(y)+a_2(y')$ for all $y,y'$.
--   2. **Condition (73)**: for joint laws $\pi^N$ and $\pi$ on $\mathsf X\times\mathsf Y$ with second marginals $\nu^N$ and $\nu$, and $a=a_1+a_2$, $$\lim_{N\to\infty}\int_{\mathsf Y}a\,d\nu^N=\int_{\mathsf Y}a\,d\nu<\infty.$$
--   3. **Cell laws** (p. 39): for a law $\pi$ on $\mathsf X\times\mathsf Y$ with first marginal $\mu$ and a measurable $A\subseteq\mathsf X$, $$\nu_A(B)=\mu(A)^{-1}\,\pi(A\times B),\qquad B\subseteq\mathsf Y\text{ measurable}.$$ It is the conditional law of $Y$ given $X\in A$ when $\mu(A)>0$; when $\mu(A)=0$ the formula gives the zero measure.
--   4. **Finite measurable partitions** $\{X_h\}_{h=1}^{n}$ of $\mathsf X$ (measurable, pairwise disjoint, covering $\mathsf X$) and the $\sigma$-algebra $\sigma(\{X_h\})$ they generate.
--   5. **Condition (75)**: a sequence $\mathscr X^M=\{X^M_h\}_{h=1}^{H(M)}$ of finite measurable partitions with $\mathcal F^M=\sigma(\mathscr X^M)\subseteq\mathcal F^{M+1}$ and $\mu(\partial X^M_h)=0$ for all $M,h$. The $\sigma$-algebra $\mathcal F=\bigvee_M\mathcal F^M$ is written out where it is used.
--   6. **Weak convergence** $\mu_N\to\mu$ of finite measures: $\int f\,d\mu_N\to\int f\,d\mu$ for every bounded continuous $f\ge0$.
--
--   These are the hypotheses and auxiliary objects of Theorem 21 and of the steps of its proof.
--
--   **Formalization Note** The integrals are lower Lebesgue integrals with values in $[0,+\infty]$. The cell law uses $\mu(A)^{-1}$ in $[0,+\infty]$; on a null cell $\infty\cdot0=0$ gives the zero measure, so the theorems use it only on cells of positive mass or multiplied by $\mu(A)$.
-- source:
--   Borgonovo, Figalli, Plischke & Savaré, Global Sensitivity Analysis via Optimal Transport, authors' manuscript of 7 March 2024 (Management Science, doi:10.1287/mnsc.2023.01796), bounded separate costs, p. 4; Appendix A, Estimation: Detailed Treatment and Proof, (73) and (75), p. 38; definitions of ν_{M,h}, p. 39

import Mathlib
import Definitions.Def_OTSensitivity_Consist_Setting

open MeasureTheory ProbabilityTheory Filter Topology BoundedContinuousFunction
open scoped ENNReal NNReal

namespace OTSensitivity.Consist

/-- Bounded separate costs (p. 4): `a₁, a₂ : 𝒴 → [0, ∞)` are continuous and
`k y y' ≤ a₁ y + a₂ y'` for all `y, y'`. -/
def IsSeparateCostBound {𝒴 : Type*} [TopologicalSpace 𝒴] (k : 𝒴 → 𝒴 → ℝ≥0∞)
    (a₁ a₂ : 𝒴 → ℝ≥0) : Prop :=
  Continuous a₁ ∧ Continuous a₂ ∧ ∀ y y', k y y' ≤ (a₁ y : ℝ≥0∞) + a₂ y'

/-- Condition (73), p. 38, for the joint laws `π^N → π` on `𝒳 × 𝒴`: with `a = a₁ + a₂`,
`∫ a dν^N → ∫ a dν < ∞`, where `ν^N`, `ν` are the second marginals of `π^N`, `π`. -/
def MomentConvergence {𝒳 𝒴 : Type*} [MeasurableSpace 𝒳] [MeasurableSpace 𝒴]
    (a₁ a₂ : 𝒴 → ℝ≥0) (πs : ℕ → Measure (𝒳 × 𝒴)) (π : Measure (𝒳 × 𝒴)) : Prop :=
  Tendsto (fun N => ∫⁻ y, ((a₁ y : ℝ≥0∞) + a₂ y) ∂(πs N).snd) atTop
      (𝓝 (∫⁻ y, ((a₁ y : ℝ≥0∞) + a₂ y) ∂π.snd)) ∧
    ∫⁻ y, ((a₁ y : ℝ≥0∞) + a₂ y) ∂π.snd < ⊤

/-- The conditional law of the second coordinate on a cell `A × 𝒴` (p. 39):
`ν_A(B) = (π(A × 𝒴))⁻¹ · π(A × B)`. Only meaningful when `π(A × 𝒴) ≠ 0`; when the cell
is `π`-null this is the zero measure (`⊤ • 0 = 0`). -/
noncomputable def cellLaw {𝒳 𝒴 : Type*} [MeasurableSpace 𝒳] [MeasurableSpace 𝒴]
    (π : Measure (𝒳 × 𝒴)) (A : Set 𝒳) : Measure 𝒴 :=
  (π.fst A)⁻¹ • (π.restrict (A ×ˢ Set.univ)).snd

/-- A finite measurable partition `{C h}_{h < n}` of `𝒳`: measurable, pairwise disjoint cells
covering `𝒳`. -/
def IsFinitePartition {𝒳 : Type*} [MeasurableSpace 𝒳] {n : ℕ} (C : Fin n → Set 𝒳) : Prop :=
  (∀ h, MeasurableSet (C h)) ∧ Pairwise (fun h h' => Disjoint (C h) (C h')) ∧ (⋃ h, C h) = Set.univ

/-- The σ-algebra `σ(𝒳^M)` generated by the cells of a partition. -/
abbrev cellSigma {𝒳 : Type*} {n : ℕ} (C : Fin n → Set 𝒳) : MeasurableSpace 𝒳 :=
  MeasurableSpace.generateFrom (Set.range C)

/-- Condition (75), p. 38: a sequence of finite measurable partitions `𝒳^M = {X^M_h}_{h ≤ H(M)}`
whose σ-algebras `𝓕^M = σ(𝒳^M)` increase in `M` and whose cells have `μ`-null boundaries. The
σ-algebra `𝓕 = ⋁_M 𝓕^M` of (75) is written `⨆ M, cellSigma (C M)` where it is used. -/
def IsPartitionSeq {𝒳 : Type*} [TopologicalSpace 𝒳] [MeasurableSpace 𝒳] (μ : Measure 𝒳)
    (H : ℕ → ℕ) (C : (M : ℕ) → Fin (H M) → Set 𝒳) : Prop :=
  (∀ M, IsFinitePartition (C M)) ∧ Monotone (fun M => cellSigma (C M)) ∧
    ∀ M h, μ (frontier (C M h)) = 0

/-- Weak (narrow) convergence `μ_N → μ` of finite measures on `𝒴`, tested against bounded
continuous nonnegative functions. -/
def WeakConv {𝒴 : Type*} [TopologicalSpace 𝒴] [MeasurableSpace 𝒴] (μs : ℕ → Measure 𝒴)
    (μ : Measure 𝒴) : Prop :=
  ∀ f : 𝒴 →ᵇ ℝ≥0, Tendsto (fun N => ∫⁻ y, (f y : ℝ≥0∞) ∂(μs N)) atTop (𝓝 (∫⁻ y, (f y : ℝ≥0∞) ∂μ))

end OTSensitivity.Consist


