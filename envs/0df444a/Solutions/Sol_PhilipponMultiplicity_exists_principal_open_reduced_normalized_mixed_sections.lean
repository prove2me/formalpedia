/-- A finite-dimensional affine coordinate algebra has finitely many rational zeros. -/
theorem finite_zeroLocus_of_module_finite
    {K σ : Type*} [Field K] (I : Ideal (MvPolynomial σ K))
    [Module.Finite K (MvPolynomial σ K ⧸ I)] : (zeroLocus K I).Finite := by
  letI : IsArtinianRing (MvPolynomial σ K ⧸ I) :=
    IsArtinianRing.of_finite K (MvPolynomial σ K ⧸ I)
  letI : Finite {m : Ideal (MvPolynomial σ K ⧸ I) // m.IsMaximal} :=
    (IsArtinianRing.setOfPred_isMaximal_finite (MvPolynomial σ K ⧸ I)).to_subtype
  letI : Finite (MaximalSpectrum (MvPolynomial σ K ⧸ I)) :=
    Finite.of_equiv _ (MaximalSpectrum.equivSubtype _).symm
  exact Finite.of_injective
    (PhilipponMultiplicity.AffineClosedPoints.point I)
    (PhilipponMultiplicity.AffineClosedPoints.point_injective I)

theorem finite_zeroLocus_of_pointwise_jacobian
    {K σ : Type*} [Field K] [IsAlgClosed K] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ K))
    (h : ∀ a : σ → K, (∀ P ∈ I, eval a P = 0) →
      ∃ F : σ → MvPolynomial σ K, (∀ i, F i ∈ I) ∧
        eval a (Matrix.of (fun i j => pderiv j (F i))).det ≠ 0) :
    (zeroLocus K I).Finite := by
  letI := finite_quotient_of_pointwise_jacobian I h
  exact finite_zeroLocus_of_module_finite I

end AffineJacobian.Radical

namespace PhilipponMultiplicity.NormalizedJacobian
variable {K : Type*} [Field K] (M : MultiProjectiveSpace K)

/-- Normalized block coordinates distinguish projective points on a chart. -/
theorem coordinate_ratio_injective
    (b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1))
    (x y : M.Point) (hx : ∀ i, M.coordinate x ⟨i,b i⟩ ≠ 0)
    (hy : ∀ i, M.coordinate y ⟨i,b i⟩ ≠ 0)
    (h : (fun j : M.Variable => M.coordinate x j / M.coordinate x ⟨j.1,b j.1⟩) =
      (fun j : M.Variable => M.coordinate y j / M.coordinate y ⟨j.1,b j.1⟩)) : x = y := by
  funext i
  rw [← (x i).mk_rep, ← (y i).mk_rep]
  apply (Projectivization.mk_eq_mk_iff' K _ _ _ _).mpr
  refine ⟨M.coordinate x ⟨i,b i⟩ / M.coordinate y ⟨i,b i⟩, ?_⟩
  funext j
  have hj := congrFun h (⟨i,j⟩ : M.Variable)
  have heq := (div_eq_div_iff (hx i) (hy i)).mp hj
  change M.coordinate x ⟨i,b i⟩ / M.coordinate y ⟨i,b i⟩ *
    M.coordinate y ⟨i,j⟩ = M.coordinate x ⟨i,j⟩
  apply (mul_right_cancel₀ (hy i))
  field_simp [hy i]
  simpa only [mul_comm] using heq.symm

/-- Finiteness in all normalized charts implies finiteness of the projective zero set. -/
theorem finite_projective_zeroLocus
    (I : Ideal M.CoordinateRing) (hI : M.IsHomogeneousIdeal I)
    (hfinite : ∀ b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1),
      (MvPolynomial.zeroLocus K (I ⊔ Ideal.span (Set.range (fun i : M.FactorIndex =>
        (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1)))).Finite) :
    (M.zeroLocus I).Finite := by
  classical
  let Z := M.zeroLocus I
  let Zb (b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1)) : Set M.Point :=
    {x | x ∈ Z ∧ ∀ i, M.coordinate x ⟨i,b i⟩ ≠ 0}
  have hchart (b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1)) :
      (Zb b).Finite := by
    let J := I ⊔ Ideal.span (Set.range (fun i : M.FactorIndex =>
      (X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1))
    let n (x : M.Point) : M.Variable → K :=
      fun j => M.coordinate x j / M.coordinate x ⟨j.1,b j.1⟩
    have hn (x : Zb b) : n x.val ∈ MvPolynomial.zeroLocus K J := by
      have hker : J ≤ RingHom.ker (MvPolynomial.eval (n x.val)) := by
        apply sup_le
        · rw [hI]
          apply Ideal.span_le.mpr
          rintro P ⟨hP, D, hD⟩
          have hs := M.eval_block_scale P D hD (M.coordinate x.val)
            (fun i => (M.coordinate x.val ⟨i,b i⟩)⁻¹)
          have hz : MvPolynomial.eval (M.coordinate x.val) P = 0 := x.property.1 P hP
          change MvPolynomial.eval (n x.val) P = 0
          simpa only [n, div_eq_mul_inv, mul_comm, hz, mul_zero, zero_mul] using hs
        · apply Ideal.span_le.mpr
          rintro _ ⟨i, rfl⟩
          change MvPolynomial.eval (n x.val) (X (⟨i,b i⟩ : M.Variable) - 1) = 0
          simp [n, div_self (x.property.2 i)]
      intro P hP
      change MvPolynomial.eval (n x.val) P = 0
      exact hker hP
    let f : Zb b → MvPolynomial.zeroLocus K J := fun x => ⟨n x.val, hn x⟩
    have hf : Function.Injective f := by
      intro x y hxy
      apply Subtype.ext
      exact coordinate_ratio_injective M b x.val y.val x.property.2 y.property.2
        (congrArg Subtype.val hxy)
    letI : Finite (MvPolynomial.zeroLocus K J) := (hfinite b).to_subtype
    letI : Finite (Zb b) := Finite.of_injective f hf
    exact Set.toFinite _
  apply (Set.finite_iUnion hchart).subset
  intro x hx
  have hex (i : M.FactorIndex) : ∃ j, M.coordinate x ⟨i,j⟩ ≠ 0 := by
    simpa only [MultiProjectiveSpace.coordinate, ne_eq, _root_.funext_iff, Pi.zero_apply, not_forall]
      using (x i).rep_nonzero
  choose b hb using hex
  exact Set.mem_iUnion.mpr ⟨b, hx, hb⟩

end PhilipponMultiplicity.NormalizedJacobian
end
end


