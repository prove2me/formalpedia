/-- The actual Stieltjes regulator generated by shifted Lévy future records
integrates killed discounted mesh payments to exact shifted cash increments. -/
theorem solution
    {Ω : Type*} [mΩ : MeasurableSpace Ω] {P : Measure Ω}
    {𝓕 : Filtration ℝ≥0 mΩ}
    (X : SpectrallyNegativeLevy P 𝓕) (ω : Ω) (age : ℝ≥0)
    (q : ℝ) (τ : ℝ≥0∞) (n N : ℕ) :
    let M : ℝ≥0 → ℝ := fun v =>
      sSup ((fun w : ℝ≥0 => X.X (age + w) ω - X.X age ω) '' Icc 0 v)
    let μ : Measure ℝ := dividendMeasure (fun r (_ : Ω) => M r) ω
    let grid : ℕ → ℝ := fun j => (j : ℝ) / ((n : ℝ) + 1)
    (∫⁻ r in Ioc (grid 0) (grid N),
      (let e := ((⌈r * ((n : ℝ) + 1)⌉ : ℤ) : ℝ) / ((n : ℝ) + 1)
       if ENNReal.ofReal e < τ then
         ENNReal.ofReal (Real.exp (-(q * e))) else 0) ∂μ) =
    ∑ k ∈ Finset.range N,
      (if ENNReal.ofReal (grid (k + 1)) < τ then
        ENNReal.ofReal (Real.exp (-(q * grid (k + 1)))) else 0) *
      ENNReal.ofReal (M (grid (k + 1)).toNNReal -
        M (grid k).toNNReal) := by
  let M : ℝ≥0 → ℝ := fun v =>
    sSup ((fun w : ℝ≥0 => X.X (age + w) ω - X.X age ω) '' Icc 0 v)
  let μ : Measure ℝ := dividendMeasure (fun r (_ : Ω) => M r) ω
  let grid : ℕ → ℝ := fun j => (j : ℝ) / ((n : ℝ) + 1)
  let f : ℝ → ℝ≥0∞ := fun r =>
    let e := ((⌈r * ((n : ℝ) + 1)⌉ : ℤ) : ℝ) / ((n : ℝ) + 1)
    if ENNReal.ofReal e < τ then
      ENNReal.ofReal (Real.exp (-(q * e))) else 0
  have hu : Monotone grid := by
    intro i j hij
    dsimp [grid]
    exact div_le_div_of_nonneg_right (by exact_mod_cast hij) (by positivity)
  have hcell (k : ℕ) :
      (∫⁻ r in Ioc (grid k) (grid (k + 1)), f r ∂μ) =
      (if ENNReal.ofReal (grid (k + 1)) < τ then
        ENNReal.ofReal (Real.exp (-(q * grid (k + 1)))) else 0) *
      ENNReal.ofReal (M (grid (k + 1)).toNNReal -
        M (grid k).toNNReal) := by
    have hm :=
      avram_root29_05_shiftedSup_stieltjes_Ioc_eq_record_increment
        X ω age (grid k) (grid (k + 1))
    have hc := avram_root29_05_killed_mesh_cell_integral_eq_mass μ q τ n k
    calc
      _ = (if ENNReal.ofReal (grid (k + 1)) < τ then
            ENNReal.ofReal (Real.exp (-(q * grid (k + 1)))) else 0) *
          μ (Ioc (grid k) (grid (k + 1))) := by
            simpa [f, μ, grid, Nat.cast_add] using hc
      _ = _ := by rw [hm]
  change (∫⁻ r in Ioc (grid 0) (grid N), f r ∂μ) =
    ∑ k ∈ Finset.range N,
      (if ENNReal.ofReal (grid (k + 1)) < τ then
        ENNReal.ofReal (Real.exp (-(q * grid (k + 1)))) else 0) *
      ENNReal.ofReal (M (grid (k + 1)).toNNReal -
        M (grid k).toNNReal)
  rw [lintegral_Ioc_partition_fin μ f grid hu N]
  exact Finset.sum_congr rfl (fun k _ => hcell k)
