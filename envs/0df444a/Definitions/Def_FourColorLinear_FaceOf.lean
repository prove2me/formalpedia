-- title:
--   Faces of a subgraph, appearances of a vertex, sides of a cycle, obstructing cycles, touching
-- statement:
--   Let $P$ be a connected plane graph and let $B$ be a subgraph with edge set $E$. The **faces of $B$** are the classes of faces of $P$ under adjacency across edges of $P$ not in $E$; formally, classes of darts generated by $d\sim\varphi(d)$ and, for an edge not in $E$, by $d\sim\bar d$.
--
--   An **appearance** of a vertex $v$ on the boundary of a face is a run of corners at $v$ between consecutive $E$-edges at $v$. A vertex with several $E$-edges has one appearance per run, and a vertex with no $E$-edge has exactly one.
--
--   A cycle $C$ of $P$ has two faces, its **sides**. It is **obstructing** if it "is of length at most 4 with at least one vertex on each side, or of length 5, with at least 2 vertices on each side". Two vertex sets **touch** if they intersect or some edge joins them.
--
--   This single notion of face underlies the sides of a cycle, the holes of a region and the faces $\Phi$ in which Kempe chains are contracted.
-- source:
--   Inoue, Kawarabayashi, Miyashita, Mohar, Thomassen, Thorup, Four-Coloring Planar Graphs in Linear Time, arXiv:2610.39753 (held version, sha256 4dce39c5…), §1.1, p.2; §1.2, p.5; §2.2, p.15

import Mathlib
import Definitions.Def_FourColorLinear_IsPlaneScheme

open PlanarQueue.Genus

namespace FourColorLinear

variable {V : Type} [Fintype V] [DecidableEq V] {G : SimpleGraph V} [DecidableRel G.Adj]

/-- Adjacency of darts for faces of a subgraph with edge set `E`: the next dart of the same face of
`G`, or the reversed dart across an edge not in `E`. -/
def FaceRel (S : EmbeddingScheme G) (E : Set (Sym2 V)) (d d' : G.Dart) : Prop :=
  d' = faceNext S d ∨ (d' = d.symm ∧ d.edge ∉ E)

/-- The faces of the subgraph with edge set `E` of a connected plane graph: classes of the faces of
`G` under adjacency across edges not in `E`. Used for the sides of a cycle (arXiv:2610.39753, held
version, sha256 4dce39c5…, p.2), the holes of a region (p.11) and the faces `Φ` of p.15. -/
def FaceOf (S : EmbeddingScheme G) (E : Set (Sym2 V)) : Type := Quot (FaceRel S E)

/-- The dart `d` of `G` lies on this face of the subgraph. -/
def faceOf (S : EmbeddingScheme G) (E : Set (Sym2 V)) (d : G.Dart) : FaceOf S E := Quot.mk _ d

/-- Corner runs around a vertex. The corner of `d` lies between `d` and its rotation-successor;
two consecutive corners are joined when the dart separating them is not in `E`. -/
def CornerRel (S : EmbeddingScheme G) (E : Set (Sym2 V)) (d d' : G.Dart) : Prop :=
  d' = S.rot d ∧ d'.edge ∉ E

/-- The appearances of vertices on faces of the subgraph with edge set `E` (arXiv:2610.39753, p.15,
"each appearance of a vertex v on the boundary of Φ"): runs of corners at a vertex between
consecutive `E`-edges at it. A vertex with no `E`-edge has exactly one appearance. -/
def Appearance (S : EmbeddingScheme G) (E : Set (Sym2 V)) : Type := Quot (CornerRel S E)

/-- The appearance whose run contains the corner just after `d`; for `d` not in `E`, the appearance
in which `d` lies. -/
def appOf (S : EmbeddingScheme G) (E : Set (Sym2 V)) (d : G.Dart) : Appearance S E := Quot.mk _ d

/-- The vertex of an appearance. -/
def Appearance.vertex {S : EmbeddingScheme G} {E : Set (Sym2 V)} (a : Appearance S E) : V :=
  Quot.lift (fun d : G.Dart => d.fst)
    (fun d d' (h : CornerRel S E d d') => by rw [h.1]; exact (S.rot_fst d).symm) a

/-- The vertices that are ends of edges in `E`. -/
def edgeVerts (E : Set (Sym2 V)) : Set V := {v | ∃ e ∈ E, v ∈ e}

/-- The vertices not on the subgraph that lie in a face `Φ` of it: one side of a cycle when `E` is
the edge set of a cycle. -/
def sideVerts (S : EmbeddingScheme G) (E : Set (Sym2 V)) (Φ : FaceOf S E) : Set V :=
  {u | u ∉ edgeVerts E ∧ ∃ d : G.Dart, d.fst = u ∧ faceOf S E d = Φ}

/-- `l` lists the vertices of a cycle of `G` in cyclic order. -/
def IsCycleList (G : SimpleGraph V) (l : List V) : Prop :=
  3 ≤ l.length ∧ l.Nodup ∧ ∀ i < l.length, ∃ u v, l[i]? = some u ∧
    l[(i + 1) % l.length]? = some v ∧ G.Adj u v

/-- The edge set of the cycle listed by `l`. -/
def cycleEdges (l : List V) : Set (Sym2 V) :=
  {e | ∃ i < l.length, ∃ u v, l[i]? = some u ∧ l[(i + 1) % l.length]? = some v ∧ e = s(u, v)}

/-- Obstructing cycle, arXiv:2610.39753, p.2: "of length at most 4 with at least one vertex on each
side, or of length 5, with at least 2 vertices on each side". -/
def IsObstructing (S : EmbeddingScheme G) (l : List V) : Prop :=
  IsCycleList G l ∧
    ((l.length ≤ 4 ∧ ∀ Φ, 1 ≤ (sideVerts S (cycleEdges l) Φ).ncard) ∨
      (l.length = 5 ∧ ∀ Φ, 2 ≤ (sideVerts S (cycleEdges l) Φ).ncard))

/-- Touching, arXiv:2610.39753, p.5: "two subgraphs X and Y of G touch if either V(X) ∩ V(Y) ≠ ∅, or
there is an edge xy ∈ E(G) with x ∈ V(X) and y ∈ V(Y)". -/
def Touch (G : SimpleGraph V) (X Y : Set V) : Prop :=
  (X ∩ Y).Nonempty ∨ ∃ x ∈ X, ∃ y ∈ Y, G.Adj x y

end FourColorLinear


