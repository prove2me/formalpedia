theorem decode4 {A X Y k c : ℕ} (hk : k < A * X * Y) (hc : c < 2) :
    decode [A, X, Y, 2] (2 * k + c) = [k / (X * Y), k / Y % X, k % Y, c] := by
  have hX : 0 < X := by rcases Nat.eq_zero_or_pos X with h | h <;> [simp [h] at hk; exact h]
  have hY : 0 < Y := by rcases Nat.eq_zero_or_pos Y with h | h <;> [simp [h] at hk; exact h]
  have hv : Valid [A, X, Y, 2] [k / (X * Y), k / Y % X, k % Y, c] := by
    unfold Valid
    refine List.Forall₂.cons ?_ (List.Forall₂.cons (Nat.mod_lt _ hX)
      (List.Forall₂.cons (Nat.mod_lt _ hY) (List.Forall₂.cons hc List.Forall₂.nil)))
    rw [Nat.div_lt_iff_lt_mul (by positivity)]; rw [mul_assoc] at hk; exact hk
  rw [← decode_encode hv]
  congr 1
  have e1 := Nat.div_add_mod k Y
  have e2 := Nat.div_add_mod (k / Y) X
  rw [Nat.div_div_eq_div_mul, mul_comm Y X] at e2
  simp only [encode, vol_cons, vol_nil, mul_one, List.headD_cons, List.tail_cons]
  generalize k / (X * Y) = a at *
  generalize k / Y % X = b at *
  generalize k % Y = r at *
  generalize k / Y = t at *
  subst e2; subst e1
  ring

theorem pull_g4 {A X Y : ℕ} (xs : List ℤ) (k c : ℕ) (hk : k < A * X * Y) (hc : c < 2) :
    (AModel.pull [A, Y, X, 2] [A, X, Y, 2] gS 0 xs).getD (2 * k + c) 0 =
      xs.getD (2 * g4 X Y k + c) 0 := by
  have hJ : 2 * k + c < vol [A, X, Y, 2] := by simp [vol]; nlinarith
  rw [List.getD_eq_getElem _ _ (by simpa using hJ), getElem_pull, decode4 hk hc]
  congr 1
  simp only [gS, List.getD_cons_succ, List.getD_cons_zero, encode, vol_cons, vol_nil, mul_one,
    List.headD_cons, List.tail_cons, g4]
  ring

@[simp] theorem length_mvL (X Y : ℕ) (zs : List GI) : (NLogN.KFB.mvL X Y zs).length = zs.length := by
  simp [NLogN.KFB.mvL]

theorem getD_mvL (X Y : ℕ) (zs : List GI) (k : ℕ) (hk : k < zs.length) :
    (NLogN.KFB.mvL X Y zs).getD k 0 = zs.getD (g4 X Y k) 0 := by
  simp [NLogN.KFB.mvL, List.getD_eq_getElem?_getD, hk]

