-- Source module: Solutions.KFV13Tab
/-!
# KFV §17: the uniform `J_E` exponent table

`tabP Q M N T` (`KFV3Tab`) evaluates one expression per record whose *shape* is the list of terms
`T` (it grows with `n`).  Here the terms are run-time data: three stacks `tbC, tbK, tbL` hold the
columns `c, k₁, k₂` of `T` (first term on top), and **`tabU`** loops over the records (count `N`
from `tbN`) and, for each record `j`, over the terms (count `|T|` from `tbM`), accumulating
`Σ c · bit_{k₁}(j) · bit_{k₂}(j) mod Q` (`Q` from `tbQ`); the terms are moved aside and moved back
after each record.  The entries pushed on stack `14` are those of `tabP`:

**`tabU_fsp`**: `tabU` pushes `(range N).map (svv Q T)` on stack `14` (entry `0` on top), leaves
everything else as it was, at cost `≤ cTabU N |T| B` with `B = zsz U`
(`O(N (|T| + 1) (B + 2)^2)`, as `tabP`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB AModel

abbrev tbV : Fin HS := 3
abbrev tbI : Fin HS := 5
abbrev tbQ : Fin HS := 6
abbrev tbN : Fin HS := 7
abbrev tbM : Fin HS := 8
abbrev tbC : Fin HS := 9
abbrev tbK : Fin HS := 10
abbrev tbL : Fin HS := 11
abbrev tbC2 : Fin HS := 12
abbrev tbK2 : Fin HS := 13
abbrev tbL2 : Fin HS := 15
abbrev tbJ : Fin HS := 16
abbrev tbA : Fin HS := 17
abbrev tbT : Fin HS := 18
abbrev tbR : Fin HS := 19

/-! ## 1. Expressions -/

/-- The record index `j = J - 1`. -/
def jU : Ex HS := .add (.reg tbJ) (.lit (-1))

/-- `bit_k(j)` with `k` on top of stack `x`. -/
def bitU (x : Fin HS) : Ex HS := .nmod (.ndiv jU (.pow2 (.reg x))) (.lit 2)

/-- The current term `c · bit_{k₁}(j) · bit_{k₂}(j)`. -/
def trmU : Ex HS := .mul (.mul (.reg tbC) (bitU tbK)) (bitU tbL)

/-- The accumulator update `(A + t) mod Q`. -/
def accU : Ex HS := .nmod (.add (.reg tbA) (.reg tbT)) (.reg tbQ)

/-- The entry `(Q - A) mod Q`. -/
def entU : Ex HS := .nmod (.add (.reg tbQ) (.neg (.reg tbA))) (.reg tbQ)

section Eval

variable {st : IState HS} {j k c : ℕ}

end Eval

/-! ## 2. The program -/

/-- One term: accumulate it and move it aside. -/
def inB : RS :=
  .seq (.push tbT trmU) (.seq (.push tbT accU) (.seq (.asg tbA (.reg tbT)) (.seq (.pop tbT)
  (.seq (.pop tbT) (.seq (.push tbC2 (.reg tbC)) (.seq (.pop tbC) (.seq (.push tbK2 (.reg tbK))
  (.seq (.pop tbK) (.seq (.push tbL2 (.reg tbL)) (.pop tbL))))))))))

/-- One record: the term loop, the terms moved back, the entry pushed on `14`. -/
def recB : RS :=
  .seq (.push tbA (.lit 0)) (.seq (.rep tbI (.reg tbM) inB)
  (.seq (NLogN.mvK tbC2 tbC tbV (.reg tbM)) (.seq (NLogN.mvK tbK2 tbK tbV (.reg tbM))
  (.seq (NLogN.mvK tbL2 tbL tbV (.reg tbM)) (.seq (.push 14 entU) (.seq (.pop tbA)
    (.asg tbJ (.add (.reg tbJ) (.lit (-1))))))))))

/-- **The uniform exponent table.** -/
def tabU : RS := .seq (.push tbJ (.reg tbN)) (.seq (.rep tbR (.reg tbN) NLogN.KFV.recB) (.pop tbJ))

/-! ## 3. The term loop -/

/-- The value of term `t` at record `j`. -/
def tmv (j : ℕ) (t : ℕ × ℕ × ℕ) : ℕ := t.1 * NLogN.KFV.bt t.2.1 j * NLogN.KFV.bt t.2.2 j

/-- The state after `k` terms of record `j`. -/
def inSt (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (Q j k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update g
    tbC ((T.drop k).map fun t => (t.1 : ℤ)))
    tbK ((T.drop k).map fun t => (t.2.1 : ℤ)))
    tbL ((T.drop k).map fun t => (t.2.2 : ℤ)))
    tbC2 ((T.take k).map fun t => (t.1 : ℤ)).reverse)
    tbK2 ((T.take k).map fun t => (t.2.1 : ℤ)).reverse)
    tbL2 ((T.take k).map fun t => (t.2.2 : ℤ)).reverse)
    tbA [((((T.take k).map (tmv j)).sum % Q : ℕ) : ℤ)]

/-- Cost of one term. -/
def cInB (B : ℕ) : ℕ := 40 * 10 ^ 7 * (B + 2) ^ 2

/-- Cost of one record. -/
def cRecB (m B : ℕ) : ℕ := 5 * 10 ^ 8 * (m + 1) * (B + 2) ^ 2

/-! ## 4. The record loop -/

/-- Cost of the table. -/
def cTabU (N m B : ℕ) : ℕ := 10 ^ 9 * (N + 1) * (m + 1) * (B + 2) ^ 2

/-- The registers of the table program other than the term columns and stack `14`. -/
def tbWork : List (Fin HS) := [tbC2, tbK2, tbL2, tbA, tbT, tbI, tbV, tbJ, tbR]

end NLogN.KFV

end

section
-- Source module: Solutions.KFV14Gen
/-!
# KFV §18: the terms of a round, generated at run time

The table program `tabU` (`KFV13Tab`) reads the terms `T` of round `h` from the stacks
`tbC, tbK, tbL`.  For the paper's layout (`Synth.tgtL`) the terms are
`(2^{ℓ-h+t}, n-1-pos(i,h), n-1-pos(i,t))` for the axes `i` of the round and `t < h`, where the slot
position `pos(i,t)` has the closed form `posF` (prefix slot `nL + (b-1-t) D + i`, chunk slot
`Lst + (⌊e/K⌋ D + i) K + e mod K`, `e = qK - 1 - (t-b)`).  The generator reads the layout
parameters from registers (`GRegs`), so it is one fixed program for every `n`:

* `posE`: the position expression; `posE_eval`/`posE_ok`/`posE_bnd`;
* `termB`/`tLoop`: the terms of one axis (counted loop over `t < h`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB AModel

/-- Layout parameters. -/
structure LP where
  D : ℕ
  ℓ : ℕ
  K : ℕ
  b : ℕ
  q : ℕ
  nL : ℕ
  Lst : ℕ
  n : ℕ

/-- `e = qK - 1 - (t - b)`. -/
def eF (L : NLogN.KFV.LP) (t : ℕ) : ℕ := L.q * L.K - 1 - (t - L.b)

/-- **The slot position** of `(i, t)` (`t ≤ ℓ - 2`) in the paper's layout. -/
def posF (L : NLogN.KFV.LP) (i t : ℕ) : ℕ :=
  if t < L.b then L.nL + (L.b - 1 - t) * L.D + i
  else L.Lst + (NLogN.KFV.eF L t / L.K * L.D + i) * L.K + NLogN.KFV.eF L t % L.K

/-- The admissibility of the parameters. -/
structure LP.OK (L : NLogN.KFV.LP) : Prop where
  hD : 1 ≤ L.D
  hK : 1 ≤ L.K
  hLst : L.Lst = L.nL + L.b * L.D
  hn : L.n = L.Lst + L.D * L.q * L.K
  hl : L.b + L.q * L.K + 1 = L.ℓ

/-! ## 1. Registers -/

abbrev gA : Fin HS := 20
abbrev gT : Fin HS := 21
abbrev gI : Fin HS := 22
abbrev gP : Fin HS := 23
abbrev gT2 : Fin HS := 24
abbrev gV : Fin HS := 25
abbrev gD : Fin HS := 40
abbrev gLl : Fin HS := 41
abbrev gKk : Fin HS := 42
abbrev gBb : Fin HS := 43
abbrev gQq : Fin HS := 44
abbrev gNL : Fin HS := 45
abbrev gLst : Fin HS := 46
abbrev gNn : Fin HS := 47
abbrev gH : Fin HS := 48
abbrev gLG : Fin HS := 49
abbrev gLG2 : Fin HS := 39

/-- Register `r` holds `v` on top. -/
def RV (s : IState HS) (g : Fin HS → List ℤ) (r : Fin HS) (v : ℤ) : Prop :=
  ∃ L, (NLogN.KIL.encK s g).G r = .int v :: L

/-- The layout registers, and the round `h`. -/
structure GRegs (s : IState HS) (g : Fin HS → List ℤ) (L : NLogN.KFV.LP) (h : ℕ) : Prop where
  d : RV s g NLogN.KFV.gD L.D
  l : RV s g gLl L.ℓ
  k : RV s g gKk L.K
  b : RV s g gBb L.b
  q : RV s g gQq L.q
  nl : RV s g gNL L.nL
  st : RV s g gLst L.Lst
  n : RV s g gNn L.n
  h : RV s g gH h

def gIn : List (Fin HS) := [NLogN.KFV.gD, gLl, gKk, gBb, gQq, gNL, gLst, gNn, gH]

/-! ## 2. The position expression -/

/-- `e = qK - 1 - (t - b)` with `t` on `tR`. -/
def eE (tR : Fin HS) : Ex HS :=
  .add (.add (.mul (.reg gQq) (.reg gKk)) (.lit (-1))) (.neg (.add (.reg tR) (.neg (.reg gBb))))

/-- The prefix branch `nL + (b - 1 - t) D + i`. -/
def preE (iR tR : Fin HS) : Ex HS :=
  .add (.reg gNL) (.add (.mul (.add (.add (.reg gBb) (.lit (-1))) (.neg (.reg tR))) (.reg NLogN.KFV.gD)) (.reg iR))

/-- The chunk branch `Lst + (⌊e/K⌋ D + i) K + e mod K`. -/
def chkE (iR tR : Fin HS) : Ex HS :=
  .add (.reg gLst) (.add (.mul (.add (.mul (.ndiv (NLogN.KFV.eE tR) (.reg gKk)) (.reg NLogN.KFV.gD)) (.reg iR)) (.reg gKk))
    (.nmod (NLogN.KFV.eE tR) (.reg gKk)))

/-- **The slot position** `pos(i, t)` with `i` on `iR`, `t` on `tR`. -/
def posE (iR tR : Fin HS) : Ex HS := .sel (.add (.reg tR) (.neg (.reg gBb))) (preE iR tR) (chkE iR tR)

section PosE

variable {s : IState HS} {g : Fin HS → List ℤ} {L : LP} {h : ℕ} (H : GRegs s g L h) (hL : L.OK)
  {iR tR : Fin HS} {i t : ℕ} (hiR : RV s g iR i) (htR : RV s g tR t)
  (hi : i < L.D) (ht : t + 2 ≤ L.ℓ)
include H hL hiR htR hi ht

end PosE

/-! ## 3. The terms of one axis -/

/-- The weight of a term: `2^a` (forward) or `Q - 2^a` (opposite round). -/
def tF (op : Bool) (Q a : ℕ) : ℕ := if op then Q - 2 ^ a else 2 ^ a

/-- The sign register value: `-1` forward, `0` opposite. -/
def opV (op : Bool) : ℤ := if op then 0 else -1

/-- The terms of axis `i` (top slot at `tp`) in round `h`. -/
def axTr (L : NLogN.KFV.LP) (op : Bool) (Q h i tp : ℕ) : List (ℕ × ℕ × ℕ) :=
  (List.range h).map fun t => (NLogN.KFV.tF op Q (L.ℓ - h + t), L.n - 1 - tp, L.n - 1 - posF L i t)

/-- Push the terms `T` (in order) on the columns. -/
def pushT (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update g
    tbC ((T.reverse.map fun t => (t.1 : ℤ)) ++ g tbC))
    tbK ((T.reverse.map fun t => (t.2.1 : ℤ)) ++ g tbK))
    tbL ((T.reverse.map fun t => (t.2.2 : ℤ)) ++ g tbL)

/-- One term (`t` on `gT2`): push the weight, `n-1-tp`, `n-1-pos(i,t)`; `t += 1`. -/
def tE : Ex HS := .pow2 (.add (.add (.reg gLl) (.neg (.reg gH))) (.reg gT2))

def termB : RS :=
  .seq (.push tbC (.sel (.reg NLogN.KFV.gV) NLogN.KFV.tE (.add (.reg tbQ) (.neg NLogN.KFV.tE))))
  (.seq (.push tbK (.add (.add (.reg gNn) (.lit (-1))) (.neg (.reg NLogN.KFV.gP))))
  (.seq (.push tbL (.add (.add (.reg gNn) (.lit (-1))) (.neg (posE NLogN.KFV.gI gT2))))
    (.asg gT2 (.add (.reg gT2) (.lit 1)))))

/-- Cost of one term. -/
def cTermB (B : ℕ) : ℕ := 10 ^ 9 * (B + 2) ^ 2

/-- The terms of one axis: `t` from `0` to `h-1` on `gT2` (the loop counter `gT` is not read). -/
def tLoop : RS := .seq (.push gT2 (.lit 0)) (.seq (.rep NLogN.KFV.gT (.reg gH) termB) (.pop gT2))

def cTLoop (h B : ℕ) : ℕ := cLp h (cTermB B) B + 10 ^ 4 * (B + 2)

/-! ## 4. One axis: position, terms, count -/

/-- One axis with top slot `e`: push `gP := e`, the terms, `tbM += h`. -/
def AX (e : Ex HS) : RS :=
  .seq (.push NLogN.KFV.gP e) (.seq NLogN.KFV.tLoop (.seq (.asg tbM (.add (.reg tbM) (.reg gH))) (.pop NLogN.KFV.gP)))

def cAX (sz h B : ℕ) : ℕ := (sz + 1) * 10 ^ 7 * (B + 2) ^ 2 + cTLoop h B + 10 ^ 4 * (B + 2)

/-! ## 5. The axes of a round -/

abbrev gRk : Fin HS := 38

/-- Flag of an axis on `gLG`: `-1` long, `0` short. -/
def fv (b : Bool) : ℤ := if b then -1 else 0

/-- The rank of axis `i` among the long axes. -/
def rk (fl : List Bool) (i : ℕ) : ℕ := (fl.take i).count true

/-- The terms of axis `i` in round `h` (none for a short axis in the top round). -/
def axG (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h i : ℕ) : List (ℕ × ℕ × ℕ) :=
  if h + 1 < L.ℓ then axTr L op Q h i (posF L i h)
  else if fl.getD i false then axTr L op Q h i (rk fl i) else []

/-- `e < 0` iff the round is not the top one. -/
def eTop : Ex HS := .add (.add (.reg gH) (.lit 1)) (.neg (.reg gLl))

/-- The branch of one axis. -/
def brB : RS := .ite eTop (AX (posE NLogN.KFV.gI gH)) (.ite (.reg gLG) (AX (.reg gRk)) .skip)

def cBr (h B : ℕ) : ℕ := 2 * cAX 100 h B + 10 ^ 5 * (B + 2)

/-- One axis (`i` on `gI`): its branch, the rank update, the flag moved to `gLG2`, `i += 1`. -/
def axB : RS :=
  .seq NLogN.KFV.brB
  (.seq (.asg gRk (.add (.reg gRk) (.neg (.reg gLG))))
  (.seq (.push gLG2 (.reg gLG)) (.seq (.pop gLG) (.asg NLogN.KFV.gI (.add (.reg NLogN.KFV.gI) (.lit 1))))))

/-- All axes (the loop counter `gA` is not read). -/
def axL : RS := .seq (.push NLogN.KFV.gI (.lit 0)) (.seq (.rep NLogN.KFV.gA (.reg NLogN.KFV.gD) NLogN.KFV.axB) (.pop NLogN.KFV.gI))

def cAxB (h B : ℕ) : ℕ := NLogN.KFV.cBr h B + 10 ^ 5 * (B + 2)

/-- The terms of the first `k` axes. -/
def genL (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h k : ℕ) : List (ℕ × ℕ × ℕ) :=
  (List.range k).flatMap (NLogN.KFV.axG L fl op Q h)

/-- The loop state after `k` axes. -/
def axF (g : Fin HS → List ℤ) (L : NLogN.KFV.LP) (fl : List Bool) (op : Bool) (Q h m0 : ℕ)
    (lm rG rG2 : List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update
    (pushT g (genL L fl op Q h k)) tbM (((m0 + (genL L fl op Q h k).length : ℕ) : ℤ) :: lm))
    gLG ((fl.drop k).map fv ++ rG)) gLG2 ((fl.take k).reverse.map fv ++ rG2)) gRk [(rk fl k : ℤ)]

def cAxL (D h B : ℕ) : ℕ := cLp D (cAxB h B) B + 10 ^ 4 * (B + 2)

end NLogN.KFV

end

section
-- Source module: Solutions.KFV15Tw
/-!
# KFV §19: the uniform twiddle pass `twCU`

`KFV.twC N r = dblI N (2r) ; rotC N (2r) ; unpadI N (2r) (4r)` carries the literals `N` and `2r`.
`twCU` reads them from the parameter stacks `qX = N`, `qB = 2r`, `qZ = 2r` (`KFUU.π3`):
`dblIU` (register-counted doubling), `rotCU` (`const 1 N`, `const 2 Q` become `dup`s), and
KFUU's `unpadIU`.  **`twCU_runs`**: `twC_spec` transported by `KFV.ISim.runs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFV

open IntMul KIL KFC KFT KFU KFB KFH KFUU AModel

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

def dblBlkU : IStmt HS Pp :=
  .seq (rptX NLogN.KFUU.qB zA zC NLogN.KFU.zD dnStep) (.seq (rptX NLogN.KFUU.qB zA zC NLogN.KFU.zD (.op (.mv zX zY)))
    (rptX NLogN.KFUU.qB zA zC NLogN.KFU.zD (.op (.mv zY zO))))

/-- Uniform doubling scan. -/
def dblIU : IStmt HS Pp :=
  .seq (.op (.mark zO)) (.seq (rptX NLogN.KFUU.qX oA oC NLogN.KFU.oD dblBlkU) (.seq (mvW zO 0) (.op (.unmark zO))))

/-- Uniform rotation (parameters `N`, `Q` duplicated from `qX`, `qB`). -/
def rotCU : IStmt HS Pp :=
  .seq (.op (.dup NLogN.KFUU.qX 1)) (.seq (.op (.dup NLogN.KFUU.qB 2)) (.seq (.op (.const 4 2))
    (.seq rotF (.seq (.op (.drop 1)) (.seq (.op (.drop 2)) (.op (.drop 4)))))))

/-- **The uniform twiddle pass.** -/
def twCU : IStmt HS Pp := .seq dblIU (.seq NLogN.KFV.rotCU unpadIU)

/-- Its parameters. -/
def πT (N r : ℕ) : PMap := π3 N (2 * r) (4 * r - 2 * r)

end NLogN.KFV

end

section
-- Source module: Solutions.KFV16Twist
/-!
# KFV §20: the uniform twist `J_E` of a round

`twistU op` (`op = false`: `J_E` of a forward round, `op = true`: `J_{-E}` of an opposite round):

* `genT op`: `Q = 2^{ℓ+1}`, `N = 2^n` on `tbQ`, `tbN`; the terms of the round (`axL`) on the
  columns, their number on `tbM` (**`genT_fsp`**);
* `tabU` (`KFV13Tab`): the exponent table on stack `14`;
* `clrT`: the term columns are emptied; the parameters `N, 2r, 2r` of `twCU` are pushed;
* `twCU` (`KFV15Tw`), then the parameters are popped.

Everything `n`-dependent is read from the layout registers `GRegs` and the flag list on `gLG`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB AModel

/-- The term generation of a round. -/
def genT (op : Bool) : RS :=
  .seq (.push NLogN.KFV.gV (.lit (opV op)))
  (.seq (.push tbQ (.pow2 (.add (.reg gLl) (.lit 1))))
  (.seq (.push tbN (.pow2 (.reg gNn)))
  (.seq (.push tbM (.lit 0))
  (.seq (.push gRk (.lit 0))
  (.seq axL
  (.seq (.pop gRk)
  (.seq (NLogN.mvK gLG2 gLG NLogN.KFV.gA (.reg NLogN.KFV.gD)) (.pop NLogN.KFV.gV))))))))

def cGenT (D h B : ℕ) : ℕ := cAxL D h B + 10 ^ 9 * (B + 2) ^ 2 + 10 ^ 4 * D * (B + 2)

/-- The generated terms of round `h`. -/
def genG (L : LP) (fl : List Bool) (op : Bool) (h : ℕ) : List (ℕ × ℕ × ℕ) :=
  genL L fl op (2 ^ (L.ℓ + 1)) h L.D

/-! ## Emptying the term columns -/

def clrB : RS := .seq (.pop tbC) (.seq (.pop tbK) (.pop tbL))

/-- Drop `|T|` entries from each term column. -/
def clrT : RS := .rep NLogN.KFV.gA (.reg tbM) clrB

def colSt (g : Fin HS → List ℤ) (T : List (ℕ × ℕ × ℕ)) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update g
    tbC (((T.map fun t => (t.1 : ℤ))).drop k ++ g tbC))
    tbK (((T.map fun t => (t.2.1 : ℤ))).drop k ++ g tbK))
    tbL (((T.map fun t => (t.2.2 : ℤ))).drop k ++ g tbL)

/-! ## The register part of the twist -/

abbrev qX : Fin HS := KFUU.qX
abbrev qB : Fin HS := KFUU.qB
abbrev qZ : Fin HS := KFUU.qZ

/-- Terms, table, clean-up, the parameters of `twCU`. -/
def twA (op : Bool) : RS :=
  .seq (genT op) (.seq NLogN.KFV.tabU (.seq clrT (.seq (.pop tbM) (.seq (.pop tbN) (.seq (.pop tbQ)
    (.seq (.push qX (.pow2 (.reg gNn))) (.seq (.push NLogN.KFV.qB (.pow2 (.add (.reg gLl) (.lit 1))))
      (.push qZ (.pow2 (.add (.reg gLl) (.lit 1)))))))))))

/-- Pop the parameters of `twCU`. -/
def twB : RS := .seq (.pop qX) (.seq (.pop NLogN.KFV.qB) (.pop qZ))

def cTwA (N D h m B : ℕ) : ℕ := cGenT D h B + cTabU N m B + cLp m (6 * B + 6) B + 10 ^ 9 * (B + 2) ^ 2

/-- The table of a round. -/
def tabG (L : LP) (fl : List Bool) (op : Bool) (h : ℕ) : List ℤ :=
  (List.range (2 ^ L.n)).map (svv (2 ^ (L.ℓ + 1)) (genG L fl op h).reverse)

/-! ## The twist pass -/

section Twist

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- **The uniform twist** of a round (`op = true`: the opposite twist). -/
def twistU (op : Bool) : IStmt HS Pp := .seq (fcode (twA op)) (.seq twCU (fcode twB))

def cTwistU (n ℓ D h m W B : ℕ) : ℕ :=
  cTwA (2 ^ n) D h m B + 2000 * cTw (2 ^ n) (2 ^ ℓ) W + 10 ^ 4 * (B + 2)

end Twist

end NLogN.KFV

end

section
-- Source module: Solutions.KFV17Link
/-!
# KFV §21: the generated terms are the paper's exponent table

For the paper's layout (`pLP`: `D, ℓ, K, b = bb, q = qq, nL = nLong, Lst = |lstL|, n = |tgtL|`)
the closed-form positions are the slot positions of `tgtL`:

* `spos_eq_posF`: `spos (i, t) = posF i t` for `t ≤ ℓ - 2` (`pre_slot`, `tgt_slot`);
* `spos_top`: the top slot of a long axis sits at its rank among the long axes;

hence (**`genG_perm`**) the terms generated at run time (`genG`) are a permutation of
`tabT h = trips tgtL ℓ h (partAxes al h)` (forward) resp. of `negTr (2r) (tabT h)` (opposite),
and the exponent tables agree (**`svv_genG`**).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open Finset Synth GlueLayout GlueP14 GlueError

/-! ## List lemmas -/

/-! ## The paper's layout parameters -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- The flags of the axes. -/
def flOf : List Bool := (List.finRange D).map long

/-- The layout parameters of `tgtL`. -/
def pLP : LP :=
  ⟨D, ℓ, K, bb ℓ K, qq ℓ K, nLong D long, (lstL D ℓ K long).length, (tgtL D ℓ K long).length⟩

end Paper

