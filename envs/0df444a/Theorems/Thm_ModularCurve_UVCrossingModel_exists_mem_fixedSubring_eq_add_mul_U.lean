theorem ModularCurve.UVCrossingModel.exists_mem_fixedSubring_eq_add_mul_U {W : Type*} [CommRing W] (π : W) (x : UVCrossingModel W π) : ∃ a b : UVCrossingModel W π, a ∈ fixedSubring π ∧ b ∈ fixedSubring π ∧ x = a + b * U π := by sorry
