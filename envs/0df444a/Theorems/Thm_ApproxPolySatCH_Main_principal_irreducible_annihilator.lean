-- title:
--   Claim 7 — Principal irreducible annihilator
-- statement:
--   For $n\ge 1$, if $f=(f_1,\ldots,f_{n+1})\in k[X_1,\ldots,X_n]^{n+1}$ is minimally algebraically dependent, then its full substitution kernel
--   $$I=\{G\in k[Y_1,\ldots,Y_{n+1}]:G(f_1,\ldots,f_{n+1})=0\}$$
--   is a principal ideal generated by an irreducible polynomial $H$. The kernel is taken over the coefficient field $k$ itself, not over its algebraic closure.
--
--   This is the first assertion of Claim 7. Minimal dependence is essential: it gives transcendence degree $n$, so the graph of $f$ is a hypersurface.
-- source:
--   STOC 2027 submission #1125, Claim 7 and its proof, p.18; minimally dependent systems are defined on p.6.

import Definitions.Def_ApproxPolySatCH_Main_ResultantLanguages

set_option autoImplicit false

theorem ApproxPolySatCH.Main.principal_irreducible_annihilator {k : Type} [Field k] {n : ℕ}
    (hn : 1 ≤ n) (f : Fin (n + 1) → Poly k n)
    (hf : MinimallyDependent f) :
    ∃ H : Poly k (n + 1), Irreducible H ∧ annihilator f = Ideal.span {H} := by sorry
