theorem solution {P : ℕ} (F : Fin P → NLogN.IStmt NLogN.HS P) (pM bigE : Fin P) (N₁ : ℕ) (Tb : ℕ → ℕ)
    (hM : ∀ I, NLogN.MulOK I F pM ⟨fun a b => NLogN.KFM.mulCostH (NLogN.zsz a + NLogN.zsz b), fun _ _ => True⟩)
    (hB : NLogN.KFM.BigSpec F bigE N₁ Tb) (C₀ : ℝ) (hC₀ : 0 ≤ C₀) (A : ℕ)
    (hT : ∀ n, IntMul.OpenAI.Glue.n0 ≤ n → N₁ ≤ n → (2 * ((Tb n + NLogN.KFM.topOvh n N₁ : ℕ) : ℝ) + 1 : ℝ) ≤
      C₀ * (IntMul.OpenAI.Glue.VP n * IntMul.OpenAI.R154.Ncost (6 * (IntMul.lg n : ℝ)) (IntMul.OpenAI.R154.dP n) (IntMul.OpenAI.R154.KP n) (IntMul.OpenAI.R154.ℓP n) (IntMul.OpenAI.R154.αP n) *
        (Real.log (6 * (IntMul.lg n : ℝ)) + 1) ^ A + n)) :
    IntMul.OpenAI.R154.P.MachineGoal := by
  refine IntMul.OpenAI.R154.P.machineGoal_of (NLogN.KFM.kMachine F pM bigE N₁) (fun n _ => ?_) N₁ C₀ hC₀ A
    (fun n hn0 hn1 => ?_)
  · by_cases hn : n < N₁
    · refine ⟨2 * ((NLogN.KFM.topOvh n N₁ + NLogN.KFM.smallCost n : ℕ) : ℝ) + 1, IntMul.OpenAI.R154.P.NLogN.KFM.kMachine_at F pM bigE N₁ n _ ?_⟩
      intro x y hx hy
      obtain ⟨s', c, h1, h2, h3⟩ := NLogN.KFM.kmain_small (F := F) (pM := pM) (bigE := bigE) N₁ x y
        (hx.trans hy.symm) (by omega) (hM _)
      refine ⟨s', c, h1, by rw [h2, hx], ?_⟩
      rw [hx] at h3
      have : (c : ℝ) ≤ ((NLogN.KFM.topOvh n N₁ + NLogN.KFM.smallCost n : ℕ) : ℝ) := by exact_mod_cast h3
      linarith
