            Ideles.archScale K p.2) : ℝ) : ℂ) ^ s)
        (d012 S) ∧
      ∫ p : ↥(torusClass (K := K) S) × ℝ, ∑' β : {β : Kˣ // IsSUnit K S β},
          d010 d archR archC dR dC dF (torusPoint g p) (r * β.1) *
              ((μ (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
                Ideles.archScale K p.2) : ℂˣ) : ℂ) *
            ((ideleNorm K (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
              Ideles.archScale K p.2) : ℝ) : ℂ) ^ s
          ∂(d012 S) =
        d.a r * d.epsChar g * ((d034 S).toReal : ℂ) *
          ∫ z in d020 S, d043 archR archC dR dC epsS dF r g μ s z
            ∂(NumberField.Idele.idelicHaar K) := by
  have hpt : ∀ p : ↥(torusClass (K := K) S) × ℝ,
      ∑' β : {β : Kˣ // IsSUnit K S β},
          d010 d archR archC dR dC dF (torusPoint g p) (r * β.1) *
              ((μ (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
                Ideles.archScale K p.2) : ℂˣ) : ℂ) *
            ((ideleNorm K (((torusLift p.1 : ↥(normOneIdeles K)) : (AdeleRing (𝓞 K) K)ˣ) *
