/-!
# Segmented inverse (S2): the recentred block and its explicit inverse

For a block of length `n` with recentring value `b` (`|b| ≤ 1/2`), `σ ≥ 1`, `θ = σ - 1`:
* `TF u k = e^{-πα²(σ(k-u)² + 2b(k-u))}` (the Toeplitz block, `= realToep`),
* `TinvF u v = Γ_u⁻¹ Γ_v⁻¹ Σ_{max(u,v) ≤ k < n} a⁺_{k-u} Γ_k a⁻_{k-v}` (its inverse, from the q-LU),
  with `Σ_k TF u k TinvF k v = δ_uv` (`TF_mul_TinvF`) and **persymmetry**
  `TinvF u v = TinvF (n-1-v) (n-1-u)` (`TinvF_persym`, report L6);
* `MF = D T D⁻¹`, `MinvF = D T⁻¹ D⁻¹` with `D = diag(e^{πα²θu²})` (report L4), `MF · MinvF = I`;
* the exact seven-stage pipeline `blkE` (scale by `D⁻¹`, `Γ⁻¹`, lower Toeplitz `a⁻`, `Γ`,
  upper Toeplitz `a⁺`, `Γ⁻¹`, `D`) equals `MinvF` applied to the input (`blkE_eq`).
* coefficient bounds: `|a^±_h| ≤ 1.0001 e^{-πα²θh}`, `Σ_h |a^±_h| ≤ 1.05`, `Γ_u ∈ (0,1]`,
  `Γ_u⁻¹ ≤ 1.0001`, `|TinvF u v| ≤ 1.1` (under `α ≥ 2`, `α²θ ≥ 2`).
-/

open Finset Matrix Real

namespace J6Seg
open J6QLU

/-! ### Real stage operators on `ℕ`-indexed vectors -/

/-! ### From matrices on `Fin n` to `ℕ`-indexed sums -/

/-! ### Coefficient bounds -/

section bounds
variable {α σ b : ℝ}

lemma gamR_pos (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : 0 < gamR α σ u :=
  (inv_qpoch_bound α σ hα hσ u).1

lemma gamR_le_one (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : gamR α σ u ≤ 1 := by
  unfold gamR qpoch
  apply prod_le_one
  · intro i _; have := pow_le_one₀ (qR_pos α σ).le (by linarith [qR_le α σ hα hσ] : qR α σ ≤ 1)
      (n := i + 1); linarith
  · intro i _; have := pow_nonneg (qR_pos α σ).le (i + 1); linarith

lemma giR_le (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : giR α σ u ≤ 1.0001 := by
  obtain ⟨h0, h1⟩ := inv_qpoch_bound α σ hα hσ u
  unfold giR; rw [inv_le_comm₀ h0 (by norm_num)]
  rw [inv_le_iff_one_le_mul₀ (by norm_num)]; linarith

lemma one_le_giR (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : 1 ≤ giR α σ u := by
  exact (one_le_inv₀ (gamR_pos hα hσ u)).2 (gamR_le_one hα hσ u)

lemma one_le_ddR (hσ : 1 ≤ σ) (u : ℕ) : 1 ≤ ddR α σ u := by
  unfold ddR; apply Real.one_le_exp_iff.2
  have := pi_pos
  exact mul_nonneg (mul_nonneg (mul_nonneg this.le (sq_nonneg _)) (by linarith)) (sq_nonneg _)

lemma ddR_mono (hσ : 1 ≤ σ) {u v : ℕ} (huv : u ≤ v) : ddR α σ u ≤ ddR α σ v := by
  unfold ddR; apply exp_le_exp.2
  have hc : 0 ≤ π * α ^ 2 * (σ - 1) := mul_nonneg (mul_nonneg pi_pos.le (sq_nonneg _)) (by linarith)
  have : (u : ℝ) ^ 2 ≤ (v : ℝ) ^ 2 := by
    have : (u : ℝ) ≤ v := by exact_mod_cast huv
    nlinarith [(Nat.cast_nonneg u : (0 : ℝ) ≤ u)]
  nlinarith

end bounds

end J6Seg

end

