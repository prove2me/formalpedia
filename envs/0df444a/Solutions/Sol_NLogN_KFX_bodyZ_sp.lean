/-!
# KFX §6: the bit-length loop and the run of the uniform row addition

`loopZ` computes `A = zsz V` on stack `48` by halving `V` (pushed on stack `14`) until it is `0`.
`rowCodeU q = withPushI hdrL (zB (l13U q))` pushes the master registers computed from the
parameter registers (`hdrL`), runs `loopZ`, then `l13U q`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace NLogN.KFX

open IntMul RS KIL KFD KFE KFB KFL KFW KFH AModel Butterfly

/-! ## The bit-length loop -/

theorem Sp.asgG (s : IState HS) {i : Fin HS} {e : Ex HS} {B : ℕ} (hi : i.val < 56) (hc : e.Clean)
    (hok : e.ok s) (hint : s.IsInt i) (hB : e.Bnd s B) (htop : zsz (s.top i) ≤ B) :
    Sp (.asg i e) s (s.upd i (.int (e.eval s) :: (s.G i).tail)) ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) :=
  ⟨⟨hi, hc, hok, hint⟩, rfl, asgCost_le i e s B hB htop⟩

theorem mA_ne_rX : mA ≠ rX := by decide

theorem ssZ_G_rX (t : IState HS) (V m : ℕ) : (ssZ t V m).G rX = .int ((V / 2 ^ m : ℕ) : ℤ) :: t.G rX := by
  simp [ssZ]

theorem ssZ_G_mA (t : IState HS) (V m : ℕ) : (ssZ t V m).G mA = .int (m : ℤ) :: t.G mA := by
  simp [ssZ, mA_ne_rX]

theorem bodyZ_sp_sol_aux (t : IState HS) (V m Bb : ℕ) (hm : m < zsz (V : ℤ)) (hB : zsz (V : ℤ) ≤ Bb)
    (hB2 : 2 ≤ Bb) : Sp bodyZ (ssZ t V m) (ssZ t V (m + 1)) (cZ Bb) := by
  set s := ssZ t V m
  have hX : s.G rX = .int ((V / 2 ^ m : ℕ) : ℤ) :: t.G rX := ssZ_G_rX t V m
  have hA : s.G mA = .int (m : ℤ) :: t.G mA := ssZ_G_mA t V m
  have tX : s.top rX = ((V / 2 ^ m : ℕ) : ℤ) := IState.top_eq hX
  have tA : s.top mA = (m : ℤ) := IState.top_eq hA
  have zX : zsz (((V / 2 ^ m : ℕ)) : ℤ) ≤ Bb := le_trans (zsz_nat_le (Nat.div_le_self _ _)) hB
  have zX2 : zsz (((V / 2 ^ m : ℕ) : ℤ) / 2) ≤ Bb := by
    rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, ← Int.natCast_div]
    exact le_trans (zsz_nat_le (le_trans (Nat.div_le_self _ _) (Nat.div_le_self _ _))) hB
  have z2 : zsz (2 : ℤ) ≤ Bb := by
    have : zsz ((2 : ℤ) ^ 1) = 1 + 1 := zsz_two_pow 1
    simp at this; omega
  have zm : zsz (m : ℤ) ≤ Bb := le_trans (zsz_natCast_le_self m) (by omega)
  have zm1 : zsz ((m : ℤ) + 1) ≤ Bb := by
    have := zsz_natCast_le_self (m + 1); push_cast at this; omega
  have z1 : zsz (1 : ℤ) ≤ Bb := by rw [zsz_one]; omega
  have S1 := Sp.asgG s (i := rX) (e := eHalf) (B := Bb) (by decide) (KFL.clean_all _ (by decide))
    ⟨IState.isInt_of hX, trivial, by simp only [Ex.eval, tX]; positivity, by simp [Ex.eval]⟩
    (IState.isInt_of hX) ⟨by simp only [Ex.Bnd, tX]; exact zX, z2, by simp only [Ex.eval, tX]; exact zX2⟩
    (by rw [tX]; exact zX)
  set s1 := s.upd rX (.int (eHalf.eval s) :: (s.G rX).tail)
  have hA1 : s1.G mA = .int (m : ℤ) :: t.G mA := by simp [s1, hA, mA_ne_rX]
  have tA1 : s1.top mA = (m : ℤ) := IState.top_eq hA1
  have S2 := Sp.asgG s1 (i := mA) (e := eInc) (B := Bb) (by decide) (KFL.clean_all _ (by decide))
    ⟨IState.isInt_of hA1, trivial⟩ (IState.isInt_of hA1)
    ⟨by simp only [Ex.Bnd, tA1]; exact zm, z1, by simp only [Ex.eval, tA1]; exact zm1⟩
    (by rw [tA1]; exact zm)
  refine (S1.seq S2).mono (by simp [cZ, eHalf, eInc, Ex.size]; nlinarith) |>.congr ?_
  apply IState.ext'
  · intro x
    have e1 : eHalf.eval s = ((V / 2 ^ (m + 1) : ℕ) : ℤ) := by
      simp only [eHalf, Ex.eval, tX]
      rw [show (2 : ℤ) = ((2 : ℕ) : ℤ) by norm_num, ← Int.natCast_div, Nat.div_div_eq_div_mul, ← pow_succ]
    have e2 : eInc.eval s1 = ((m + 1 : ℕ) : ℤ) := by simp only [eInc, Ex.eval, tA1]; push_cast; ring
    rw [e2]
    simp only [s1, e1, hX, ssZ, IState.upd_G, List.tail_cons]
    have := mA_ne_rX
    split_ifs <;> simp_all [s, ssZ]
  · simp [s1, s, ssZ]
  · simp [s1, s, ssZ]

