    (hkN : IsPullback kN (E₂.L.schemeKerStr N) (E'.L.schemeKerStr N) (Spec.map (CommRingCat.ofHom ψ)))
    (hkNι : kN ≫ KerOps.ι E'.L N = KerOps.ι E₂.L N ≫ kA) :
