theorem inversePower17_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 (parameter (-17)) inverseSum17) z = eval k inversePower17 z := by
  have he := eval_eq_of_degrees 24 k inversePower17_raw inversePower17 z
    (degreeBound_sound inversePower17_raw_bound) (degreeBound_sound inversePower17_result_bound)
    inversePower17_degrees
  change eval k (normalize inversePower17_raw) z = eval k inversePower17 z
  rw [eval_normalize]
  exact he

theorem inversePower17_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^17) inversePower17 := by
  have h23 := (lossPower23_approximates hk hklog).scale (37711260990 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (22239974430 : ℚ)).addAppend h23
  have h21 := ((lossPower21_approximates hk hklog).scale (12875774670 : ℚ)).addAppend h22
  have h20 := ((lossPower20_approximates hk hklog).scale (7307872110 : ℚ)).addAppend h21
  have h19 := ((lossPower19_approximates hk hklog).scale (4059928950 : ℚ)).addAppend h20
  have h18 := ((lossPower18_approximates hk hklog).scale (2203961430 : ℚ)).addAppend h19
