theorem auxMatrix_diag (b : Matrix Int n m) (k : Nat) (hk : k ≤ n)
    (i : Fin k) :
    (auxMatrix b k hk)[i][i] =
      ((basis b).row (GramSchmidt.liftFinLE i hk)).normSq := by sorry
