namespace RedKer
open GoodReductionJacobian

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}

theorem exists_unique_lift (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (gE : E.A ⟶ 𝒜.A) (hgE : CategoryTheory.IsPullback gE E.f 𝒜.f (Spec.map (CommRingCat.ofHom O.subtype)))
    (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    ∃! xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f,
      Spec.map (CommRingCat.ofHom O.subtype) ≫ xt.1 = x.1 ≫ gE := by
  haveI : IsProper 𝒜.f := 𝒜.bundle.proper
  have hx : (x.1 ≫ gE) ≫ 𝒜.f = Spec.map (CommRingCat.ofHom O.subtype) ≫ 𝟙 _ := by
    rw [Category.assoc, hgE.w, ← Category.assoc, x.2, Category.id_comp, Category.comp_id]
  exact NeronModelInfra.existsUnique_schemeHomOver_comp_eq_of_isProper_valuationSubring O 𝒜.f (𝟙 _) (x.1 ≫ gE) hx

noncomputable def redOf (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))
    (xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f) :
    SchemeHomOver (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O)))) Abar.f :=
  ⟨hgbar.lift (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ xt.1) (𝟙 _)
      (by rw [Category.assoc, xt.2, Category.comp_id, Category.id_comp]),
    hgbar.lift_snd _ _ _⟩

theorem redOf_comp (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))
    (xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f) :
    (redOf O 𝒜 Abar gbar hgbar xt).1 ≫ gbar = Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ xt.1 :=
  hgbar.lift_fst _ _ _

theorem eq_of_comp_gbar_eq (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))
    (y y' : SchemeHomOver (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O)))) Abar.f)
    (h : y.1 ≫ gbar = y'.1 ≫ gbar) : y = y' :=
  Subtype.ext (hgbar.hom_ext h (by rw [y.2, y'.2]))

section Red
variable (O : ValuationSubring (AlgebraicClosure ℚ))
    (𝒜 : FakeEllipticCurve Λ N ↥O) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (Abar : FakeEllipticCurve Λ N (IsLocalRing.ResidueField ↥O))
    (gE : E.A ⟶ 𝒜.A) (hgE : CategoryTheory.IsPullback gE E.f 𝒜.f (Spec.map (CommRingCat.ofHom O.subtype)))
    (gbar : Abar.A ⟶ 𝒜.A)
    (hgbar : CategoryTheory.IsPullback gbar Abar.f 𝒜.f (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O))))

private noncomputable def _root_.RedKer.lift (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f :=
  (exists_unique_lift O 𝒜 E gE hgE x).choose

p2m_export "RedKer" "lift"
theorem lift_spec (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    Spec.map (CommRingCat.ofHom O.subtype) ≫ (lift O 𝒜 E gE hgE x).1 = x.1 ≫ gE :=
  (exists_unique_lift O 𝒜 E gE hgE x).choose_spec.1

theorem lift_unique (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f)
    (xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f)
    (h : Spec.map (CommRingCat.ofHom O.subtype) ≫ xt.1 = x.1 ≫ gE) : xt = lift O 𝒜 E gE hgE x :=
  (exists_unique_lift O 𝒜 E gE hgE x).unique h (lift_spec O 𝒜 E gE hgE x)

noncomputable def red (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    SchemeHomOver (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O)))) Abar.f :=
  redOf O 𝒜 Abar gbar hgbar (lift O 𝒜 E gE hgE x)

theorem redZero_iff (x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f) :
    (∃ xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) 𝒜.f,
        Spec.map (CommRingCat.ofHom O.subtype) ≫ xt.1 = x.1 ≫ gE ∧
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥O)) ≫ xt.1 =
          (Abar.L.one (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥O))))).1 ≫ gbar) ↔
    red O 𝒜 E Abar gE hgE gbar hgbar x = Abar.L.one (𝟙 _) := by
  constructor
  · rintro ⟨xt, h1, h2⟩
    have hxt := lift_unique O 𝒜 E gE hgE x xt h1
    apply eq_of_comp_gbar_eq O 𝒜 Abar gbar hgbar
    rw [red, redOf_comp, ← hxt, h2]
  · intro h
    refine ⟨lift O 𝒜 E gE hgE x, lift_spec O 𝒜 E gE hgE x, ?_⟩
    rw [← redOf_comp O 𝒜 Abar gbar hgbar, ← h]
    rfl

end Red
