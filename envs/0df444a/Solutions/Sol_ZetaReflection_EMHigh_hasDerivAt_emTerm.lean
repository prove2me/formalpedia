/-! ## M1. Rising factorial and the derivative coefficients of `x^{-s}`. -/





lemma poch_succ (s : ℂ) (k : ℕ) : poch s (k + 1) = poch s k * (s + k) := rfl





lemma emC_succ (s : ℂ) (k : ℕ) : emC s (k + 1) = emC s k * (-s - k) := by
  simp only [emC, poch_succ, pow_succ]; ring







