              repeatedConditionedAnswerFlag
                G n S D point.2),
              (projection point).2))
        (reweightedSeedPosterior seedLaw G n S D) := by
  classical
  let augmented :
      K × ExactOutcome X Y A B n →
        (Ω × ConditionedAnswerFlag A B D) ×
          (Fin h → V) :=
    fun point =>
      (((projection point).1,
        repeatedConditionedAnswerFlag G n S D point.2),
        (projection point).2)
