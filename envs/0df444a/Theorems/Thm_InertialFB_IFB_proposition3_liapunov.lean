-- title:
--   Proposition 3: $b(\Theta(q)-\Theta(u_{k+1})) \ge F_{k+1}(q)-F_k(q)$
-- statement:
--   Let $H$ be a real Hilbert space, $\Phi : H \to \mathbb R\cup\{+\infty\}$ proper, lower semicontinuous and convex, $\Psi : H\to\mathbb R$ differentiable with $L_\Psi$-Lipschitz gradient, and $a, b, \lambda > 0$. Assume $\Theta = \Phi + \Psi$ is convex, and let $(u_k, y_k)$ be generated by (IFB). With $\xi_k, \zeta_k$ and $F_k(q)$ as in the definitions, for every $q \in H$ and every $k \ge 1$,
--   $$b\big(\Theta(q) - \Theta(u_{k+1})\big) \ \ge\ b\left\langle \left(\frac1\lambda - a\right)\xi_{k+1} + \left(\frac1\lambda + b\right)\zeta_{k+1},\ u_{k+1} - q\right\rangle \ =\ F_{k+1}(q) - F_k(q).$$
--   In particular, if $q \in \mathcal S = \operatorname{Argmin}\Theta$, then $F_{k+1}(q) \le F_k(q)$ for all $k \ge 1$.
--
--   This identifies $F_k(q)$ as a Liapunov-type sequence for the algorithm: its increments are controlled by the gap $\Theta(q) - \Theta(u_{k+1})$.
--
--   **Formalization Note** The paper prints only "Assume $\Theta$ is convex"; the standing hypotheses $H_\Phi$, $H_\Psi$ and $a, b, \lambda > 0$ of the setting are made explicit, while $H_\lambda$ and boundedness from below are not assumed. Since $\Theta(q)$ may be $+\infty$, the inequality is written without subtraction in `EReal`, as $b\,\Theta(u_{k+1}) + b\langle\cdot,\cdot\rangle \le b\,\Theta(q)$.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 6, Proposition 3, eq. (19)

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis
import Definitions.Def_InertialFB_IFB_Algorithm
import Definitions.Def_InertialFB_IFB_Lyapunov

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- **Proposition 3** (Attouch–Peypouquet–Redont, p. 6), inequality and identity (19), under the
standing setting of the paper (`H_Φ`, `H_Ψ`, `a, b, λ > 0`) and the printed hypothesis that
`Θ` is convex. -/
theorem proposition3_liapunov (Φ : H → EReal) (Ψ : H → ℝ) (L a b lam : ℝ)
    (hΦ_proper : IsProperFn Φ) (hΦ_lsc : LowerSemicontinuous Φ) (hΦ_convex : IsConvexFn Φ)
    (hΨ_diff : Differentiable ℝ Ψ)
    (hΨ_lip : ∀ x x' : H, ‖gradient Ψ x - gradient Ψ x'‖ ≤ L * ‖x - x'‖)
    (ha : 0 < a) (hb : 0 < b) (hlam : 0 < lam)
    (hΘ_convex : IsConvexFn (theta Φ Ψ))
    (u y : ℕ → H) (hIFB : IsIFBSeq Φ Ψ a b lam u y) :
    (∀ (q : H) (k : ℕ), 1 ≤ k →
      (b : EReal) * theta Φ Ψ (u (k + 1)) +
          ((b * inner ℝ ((1 / lam - a) • xi u (k + 1) + (1 / lam + b) • zeta y (k + 1))
              (u (k + 1) - q) : ℝ) : EReal) ≤
        (b : EReal) * theta Φ Ψ q ∧
      b * inner ℝ ((1 / lam - a) • xi u (k + 1) + (1 / lam + b) • zeta y (k + 1))
          (u (k + 1) - q) =
        auxF a b lam u y (k + 1) q - auxF a b lam u y k q) ∧
    (∀ q ∈ argminSet Φ Ψ, ∀ k : ℕ, 1 ≤ k → auxF a b lam u y (k + 1) q ≤ auxF a b lam u y k q) := by sorry

end InertialFB.IFB
