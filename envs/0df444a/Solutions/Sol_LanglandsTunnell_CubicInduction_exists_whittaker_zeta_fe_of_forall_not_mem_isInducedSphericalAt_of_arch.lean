    (hχTdef : χT = μ * χ.comp (M4aHerbrand.GenuineDescent.genuineBaseChange ℚ K).idelicNorm) (hχc : Continuous χ)
    (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (aχ : HeightOneSpectrum (𝓞 ℚ) → ℕ)
    (haχ : ∀ v ∈ T \ S,
      LanglandsTunnell.TateLocal.HasConductorExponentAt ℚ v (NumberField.TateGlobal.localChar χ v) (aχ v))
    (ω : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (αS : (v : HeightOneSpectrum (𝓞 ℚ)) → (v.adicCompletion ℚ)ˣ)
