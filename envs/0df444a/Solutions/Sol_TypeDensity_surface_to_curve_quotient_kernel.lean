theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hreg : TypeDensity.RegularParameterPair R t x) (hregSwap : TypeDensity.RegularParameterPair R x t) (j : ℕ)
    (hregF : Function.Injective (fun c : TypeDensity.BlowupOverlap R t x ⧸
      (Ideal.span {TypeDensity.overlapException R t x})^j =>
      Ideal.Quotient.mk ((Ideal.span {TypeDensity.overlapException R t x})^j)
      ((algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x)) (G.left j)) * c))
    (f : R)
    (hf : ∀ j : ℕ, TypeDensity.surfaceToCechInput R t x j f =
      (TypeDensity.cechInputLattice R t x j).mkQ (TypeDensity.gluedFunctionPair R t x G j))
    (r : R) :
    TypeDensity.surfaceToChartPair R t x r ∈ TypeDensity.curveIdealLattice R t x beta G j ↔ r ∈ Ideal.span {f} ⊔
      (Ideal.span {t,x})^j := by
  have hker := TypeDensity.surface_to_cech_kernel R t x hreg j
  have hfA := TypeDensity.glued_function_left_chart R t x beta d G f hf j
  have hfB := TypeDensity.glued_function_right_chart R t x beta d G f hf j
  -- kernel elements map into the input lattice
  have hlat : ∀ u : R, u ∈ (Ideal.span {t,x})^j ↔
      TypeDensity.surfaceToChartPair R t x u ∈ TypeDensity.cechInputLattice R t x j := by
    intro u
    rw [← hker, LinearMap.mem_ker]
    change (TypeDensity.cechInputLattice R t x j).mkQ _ = 0 ↔ _
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  have hin : TypeDensity.cechInputLattice R t x j ≤ TypeDensity.curveIdealLattice R t x beta G j := by
    rintro ⟨a, b⟩ ⟨ha, hb⟩
    exact ⟨Ideal.mem_sup_right ha, Ideal.mem_sup_right hb⟩
  constructor
  · intro h
    obtain ⟨hA, hB⟩ := h
    change algebraMap R (TypeDensity.BlowupChart R t x) r ∈ Ideal.span {G.left j} ⊔ _ at hA
    change algebraMap R (TypeDensity.BlowupChart R x t) r ∈ Ideal.span {G.right j} ⊔ _ at hB
    obtain ⟨y, hy, c, hc, hyc⟩ := Submodule.mem_sup.mp hA
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨y', hy', c', hc', hyc'⟩ := Submodule.mem_sup.mp hB
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp hy'
    set alpha := algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) with halpha
    set Zi := IsLocalization.Away.invSelf (TypeDensity.chartSlope R t x) (S := TypeDensity.BlowupOverlap R t x) with hZi
    set I := (Ideal.span {TypeDensity.overlapException R t x})^j with hI
    have hZ : TypeDensity.overlapSlope R t x * Zi = 1 := IsLocalization.Away.mul_invSelf _
    have hZd : TypeDensity.overlapSlope R t x ^ d * Zi ^ d = 1 := by rw [← mul_pow, hZ, one_pow]
    have h1 : alpha (a * G.left j + c) = beta.right (b * G.right j + c') := by
      rw [hyc, hyc', AlgHom.commutes, halpha, ← IsScalarTower.algebraMap_apply]
    rw [map_add, map_add, map_mul, map_mul] at h1
    have hov := G.overlap j
    have hmem : alpha (G.left j) * (alpha a - Zi ^ d * beta.right b) ∈ I := by
      have heq : alpha (G.left j) * (alpha a - Zi ^ d * beta.right b) =
          beta.right c' - alpha c - Zi ^ d * beta.right b *
            (alpha (G.left j) - TypeDensity.overlapSlope R t x ^ d * beta.right (G.right j)) := by
        linear_combination h1 - (beta.right b * beta.right (G.right j)) * hZd
      rw [heq]
      exact sub_mem (sub_mem (TypeDensity.beta_right_mem_overlap_pow beta j c' hc')
        (TypeDensity.algebraMap_mem_overlap_pow j c hc)) (Ideal.mul_mem_left _ _ hov)
    have hcl : alpha a - Zi ^ d * beta.right b ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      apply hregF
      simp only [mul_zero]
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact hmem
    have hle : TypeDensity.cechInputLattice R t x j ≤
        (TypeDensity.cechOutputLattice R t x j).comap (TypeDensity.fullCechDifferential R t x beta d) := by
      rintro ⟨a₁, b₁⟩ ⟨ha₁, hb₁⟩
      change alpha a₁ - Zi ^ d * beta.right b₁ ∈ I
      exact sub_mem (TypeDensity.algebraMap_mem_overlap_pow j a₁ ha₁)
        (Ideal.mul_mem_left _ _ (TypeDensity.beta_right_mem_overlap_pow beta j b₁ hb₁))
    obtain ⟨s, hs⟩ := TypeDensity.twisted_kernel_from_surface R t x hreg hregSwap beta d j hle
      ((TypeDensity.cechInputLattice R t x j).mkQ (a, b)) (by
        rw [TypeDensity.finiteCechDifferential, Submodule.mkQ_apply, Submodule.mapQ_apply,
          Submodule.Quotient.mk_eq_zero]
        exact hcl)
    rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq] at hs
    obtain ⟨hsA, hsB⟩ := hs
    refine Submodule.mem_sup.mpr ⟨f * s, Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self f),
      r - f * s, ?_, by ring⟩
    rw [hlat]
    exact ⟨TypeDensity.algebraMap_sub_mul_mem _ _ _ a c d hyc hsA hc hfA,
      TypeDensity.algebraMap_sub_mul_mem _ _ _ b c' d hyc' hsB hc' hfB⟩
  · intro h
    obtain ⟨y, hy, u, hu, rfl⟩ := Submodule.mem_sup.mp h
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp hy
    rw [map_add]
    refine add_mem ?_ (hin ((hlat u).mp hu))
    rw [show s * f = s • f from rfl, map_smul]
    exact Submodule.smul_mem _ _
      ⟨TypeDensity.algebraMap_mem_span_sup _ _ _ d hfA, TypeDensity.algebraMap_mem_span_sup _ _ _ d hfB⟩
