theorem J6Seg.TabBnd.tab_bnd (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) (hl : 1 ≤ lam)
    (hPl : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P)
    (hR : ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) ≤ 2 ^ R) :
    ∀ u < lam, |(mkTables P R s t α).di u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).gi u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).gam u| ≤ 2 ^ (P + R + 2) ∧
      |(mkTables P R s t α).dd u| ≤ 2 ^ (P + R + 2) ∧
      ∀ c, |(mkTables P R s t α).am c u| ≤ 2 ^ (P + R + 2) ∧
        |(mkTables P R s t α).ap c u| ≤ 2 ^ (P + R + 2) := by sorry
