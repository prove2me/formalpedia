theorem valid_mulAddr {P Q B k : ℕ} (hk : 0 < k) (a : List ℕ) (h : Valid [P, Q, B] a) :
    Valid [P, Q, B] (mulAddr Q k a) := by
  rcases h with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  exact List.Forall₂.cons hp (List.Forall₂.cons (yOf_lt hk _ hy) (List.Forall₂.cons hb .nil))

theorem frac_mul_inv [NeZero Q] {k l : ℕ} (hQk : Nat.Coprime Q k) (hQl : Nat.Coprime Q l) :
    (k : ZMod Q) * (l : ZMod Q)⁻¹ * ((l : ZMod Q) * (k : ZMod Q)⁻¹) = 1 := by
  have hu : IsUnit (k : ZMod Q) := (ZMod.isUnit_iff_coprime k Q).2 hQk.symm
  have hv : IsUnit (l : ZMod Q) := (ZMod.isUnit_iff_coprime l Q).2 hQl.symm
  calc (k : ZMod Q) * (l : ZMod Q)⁻¹ * ((l : ZMod Q) * (k : ZMod Q)⁻¹)
      = ((k : ZMod Q) * (k : ZMod Q)⁻¹) * ((l : ZMod Q)⁻¹ * (l : ZMod Q)) := by ring
    _ = 1 := by rw [ZMod.mul_inv_of_unit _ hu, ZMod.inv_mul_of_unit _ hv, one_mul]

theorem frac_inv [NeZero Q] {k l : ℕ} (hQk : Nat.Coprime Q k) (hQl : Nat.Coprime Q l) :
    ((k : ZMod Q) * (l : ZMod Q)⁻¹)⁻¹ = (l : ZMod Q) * (k : ZMod Q)⁻¹ :=
  ZMod.inv_eq_of_mul_eq_one _ _ _ (frac_mul_inv hQk hQl)

theorem divmul_val [NeZero Q] {k l : ℕ} (hk : 0 < k) (hQk : Nat.Coprime Q k) (w : ZMod Q) :
    l * NLogN.KIL.yOf Q k w.val % Q = ((l : ZMod Q) * (k : ZMod Q)⁻¹ * w).val := by
  rw [yOf_eq hk hQk _ (ZMod.val_lt w), ← ZMod.val_natCast, Nat.cast_mul, ZMod.natCast_zmod_val,
    ZMod.natCast_val, ZMod.cast_id', id, mul_assoc]

theorem sub_mod_val [NeZero Q] (y o : ℕ) (ho : o ≤ Q) :
    (y + Q - o) % Q = ((y : ZMod Q) - (o : ZMod Q)).val := by
  have hQ : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  rw [← ZMod.val_cast_of_lt (Nat.mod_lt (y + Q - o) hQ)]
  congr 1
  rw [ZMod.natCast_mod, Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero]

theorem offs_lt [NeZero Q] (c : Fin n → ZMod Q) (A : Shape) (p : ℕ) : offs Λ c A p < Q := by
  unfold offs; exact ZMod.val_lt _

/-- **`u = n·d⁻¹`.** -/
theorem shiftArr_frac_eq [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k l : ℕ) (hk : 0 < k) (hQk : Nat.Coprime Q k)
    (hQl : Nat.Coprime Q l) (xs : List ℤ) :
    shiftArr Λ i ((k : ZMod Q) * (l : ZMod Q)⁻¹) c 0 xs =
      shiftArr Λ i 1 c 0 (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (mulAddr Q k) 0
        (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (divAddr Q l) 0 xs)) := by
  have hQ : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  rw [shiftArr_eq_rot Λ i c hc A C hsh hA, pull_comp _ _ (valid_mulAddr hk),
    pull_comp _ _ (valid_rotAddr hQ _), shiftArr_u_eq Λ i _ c hc A C hsh hA]
  refine pull_congr (fun a ha => ?_) _ _
  rcases ha with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  simp only [Function.comp_apply, rotAddr, mulAddr, divAddr, uAddr, List.getD_cons_zero,
    List.getD_cons_succ]
  rw [frac_inv hQk hQl, sub_mod_val _ _ (offs_lt Λ c A _).le, divmul_val hk hQk]

/-- **`u = -n·d⁻¹`.** -/
theorem shiftArr_negfrac_eq [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k l : ℕ) (hk : 0 < k) (hQk : Nat.Coprime Q k)
    (hQl : Nat.Coprime Q l) (xs : List ℤ) :
    shiftArr Λ i (-((k : ZMod Q) * (l : ZMod Q)⁻¹)) c 0 xs =
      shiftArr Λ i (-1) c 0 (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (mulAddr Q k) 0
        (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (divAddr Q l) 0 xs)) := by
  have hQ : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have hinv : (-((k : ZMod Q) * (l : ZMod Q)⁻¹))⁻¹ = -((l : ZMod Q) * (k : ZMod Q)⁻¹) :=
    ZMod.inv_eq_of_mul_eq_one _ _ _ (by rw [neg_mul_neg, frac_mul_inv hQk hQl])
  rw [shiftArr_neg_eq_ref Λ i c hc A C hsh hA, pull_comp _ _ (valid_mulAddr hk),
    pull_comp _ _ (valid_refAddr hQ _), shiftArr_u_eq Λ i _ c hc A C hsh hA]
  refine pull_congr (fun a ha => ?_) _ _
  rcases ha with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  simp only [Function.comp_apply, refAddr, mulAddr, divAddr, uAddr, List.getD_cons_zero,
    List.getD_cons_succ]
  rw [hinv, sub_mod_val _ _ hy.le, divmul_val hk hQk, neg_mul, ← mul_neg, neg_sub]

