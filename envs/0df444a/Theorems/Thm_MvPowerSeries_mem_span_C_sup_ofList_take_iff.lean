-- title:
--   Coefficientwise criterion for membership in (varpi, X₀,…,X_{k-1})
-- statement:
--   Let $R$ be a commutative ring, let $\varpi \in R$, let $n, k$ be natural numbers, and let $F$ be a multivariate power series in the variables indexed by `Fin n` over $R$. Consider the ideal of `MvPowerSeries (Fin n) R` obtained as the supremum (i.e. the sum) of the principal ideal generated by the constant series `C ϖ` and the ideal `Ideal.ofList` generated by the first $k$ entries of the list $[X_0,\dots,X_{n-1}]$, that is by the variables $X_j$ with $j < \min(k,n)$. The theorem asserts that $F$ lies in this ideal if and only if for every exponent function $m : \mathrm{Fin}\,n \to_{f} \mathbb{N}$ satisfying $m_j = 0$ for all $j$ with $j < k$, the element $\varpi$ divides the coefficient of $F$ at $m$. Thus membership in $(\varpi, X_0,\dots,X_{k-1})$ is detected by $\varpi$-divisibility of exactly those coefficients whose monomials involve none of the first $k$ variables. No hypothesis is imposed on $\varpi$, on $k$ relative to $n$, or on $R$ beyond commutativity.
--
--   This is the elementary replacement for the isomorphism $R[[X_0,\dots,X_{n-1}]]/(\varpi,X_0,\dots,X_{k-1}) \cong (R/\varpi R)[[X_k,\dots,X_{n-1}]]$, in the coefficientwise form convenient for handling ideals generated by a prefix of the variables together with a constant. It is used in the proof that the variables generate the kernel of the constant-coefficient map, [`MvPowerSeries.span_range_X_eq_ker_constantCoeff`](thm.html#MvPowerSeries.span_range_X_eq_ker_constantCoeff), and underlies the regular-sequence properties of power series rings needed in the commutative algebra of the modularity-lifting arguments.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_MvPowerSeries_mem_span_C_sup_ofList_take_iff.lean

import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.RingTheory.MvPowerSeries.Basic
import Mathlib.Data.Finsupp.Order

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open MvPowerSeries

theorem MvPowerSeries.mem_span_C_sup_ofList_take_iff {R : Type*} [CommRing R] (ϖ : R) (n k : ℕ) (F : MvPowerSeries (Fin n) R) :
    F ∈ Ideal.span {(C ϖ : MvPowerSeries (Fin n) R)} ⊔
        Ideal.ofList ((List.ofFn fun j : Fin n => (X j : MvPowerSeries (Fin n) R)).take k) ↔
      ∀ m : Fin n →₀ ℕ, (∀ j : Fin n, (j : ℕ) < k → m j = 0) → ϖ ∣ coeff m F := by sorry
