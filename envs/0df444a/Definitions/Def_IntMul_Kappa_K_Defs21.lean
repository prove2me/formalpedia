-- Source module: Solutions.KFHDefs
/-! # KFH: Lemma 13 address definitions (moved out of KFH_WIP so stable files avoid the WIP import) -/
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

/-! ## Lemma 13 -/

/-- The selected-position mask `Σ_{i<f} 2^{ρ + iK}`. -/
def selMask (K ρ f : ℕ) : ℕ := ((List.range f).map fun i => 2 ^ (ρ + i * K)).sum

/-- The rectangle `[N0] × [2^L] × [N1] × [2^L] × [N2] × [2^L] × [N3]`. -/
def rect (N0 N1 N2 N3 L : ℕ) : Shape := [N0, 2 ^ L, N1, 2 ^ L, N2, 2 ^ L, N3]

/-- Field index of chunk slot `t : Fin 3`. -/
def slotF (t : Fin 3) : ℕ := 2 * t.val + 1

/-- The address map of one packed row addition: `y ← y ⊕ (x ∧ mask)`. -/
def rowAddAddr (K ρ f : ℕ) (px py : Fin 3) (a : List ℕ) : List ℕ :=
  a.set (slotF py) ((a.getD (slotF py) 0) ^^^ ((a.getD (slotF px) 0) &&& selMask K ρ f))

/-- Records permuted by an address map (records of `R` Gaussian entries). -/
def permRecs (sh : Shape) (π : List ℕ → List ℕ) (R : ℕ) (zs : List GI) : List GI :=
  (List.range (vol sh)).flatMap fun q => (zs.drop (encode sh (π (decode sh q)) * R)).take R

end NLogN.KFH

end

