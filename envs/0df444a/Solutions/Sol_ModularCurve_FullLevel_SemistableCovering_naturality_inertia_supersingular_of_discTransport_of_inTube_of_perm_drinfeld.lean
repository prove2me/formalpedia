private theorem _root_.AlgebraicCurve.RegularProlongation.degreeOn_semiSmul (hA : ∀ x : L, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hres : ∀ a : A, IsLocalRing.residue A ⟨SemilinearAut.baseAut g a, (hA a).mpr a.2⟩ = IsLocalRing.residue A a)
    {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} (h : R.DegreeOn Q D) :
    R.DegreeOn (R.semiResAut g hg hA hres • Q) (SemilinearAut.semiSmulDisc g D) := by
  classical
  intro f hf D' hD hD0
  set φ := R.semiResAut g hg hA hres with hφ
  let f' : R.integers := ⟨g⁻¹ • (f : F), (R.inv_smul_mem_integers_iff g hg f).mpr f.2⟩
  have hresid : φ (R.residue f') = R.residue f := R.semiResAut_residue_inv_smul g hg hA hres f
  have hf' : R.residue f' ≠ 0 := fun h0 => hf (by rw [← hresid, h0, map_zero])
  have key := h f' hf' (g⁻¹ • D') (fun P hP => ?_) (fun P hP => ?_)
  · rw [← hresid, Place.ord_smul φ Q (R.residue f'), ← key, SemilinearAut.divisor_smul_def,
      Finsupp.sum_mapDomain_index_inj (MulAction.injective (β := Place L F) g⁻¹)]
  · rw [SemilinearAut.divisor_smul_apply, inv_inv, hD (g • P) ((SemilinearAut.smul_mem_semiSmulDisc_iff g D P).mpr hP),
      SemilinearAut.PlaceTransport.ord_smul' g P]
  · rw [SemilinearAut.divisor_smul_apply, inv_inv]
    exact hD0 _ (fun h' => hP ((SemilinearAut.smul_mem_semiSmulDisc_iff g D P).mp h'))

