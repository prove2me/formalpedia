open MeasureTheory

namespace WassersteinDRO.Duality

/-- A copy of `ℝ` carrying the coarse σ-algebra generated by `{0}`. -/
def aux_lr_E : Type := ℝ

noncomputable instance aux_lr_inst_nacg : NormedAddCommGroup aux_lr_E :=
  inferInstanceAs (NormedAddCommGroup ℝ)

def aux_lr_isZero (x : aux_lr_E) : Prop := x = 0

instance aux_lr_inst_ms : MeasurableSpace aux_lr_E := MeasurableSpace.comap aux_lr_isZero ⊤

def aux_lr_pt (r : ℝ) : aux_lr_E := r

lemma aux_lr_norm_pt (r : ℝ) : ‖aux_lr_pt r - 0‖ = |r| := by
  show ‖r - 0‖ = |r|
  rw [sub_zero, Real.norm_eq_abs]

lemma aux_lr_pt_ne (r : ℝ) (hr : r ≠ 0) : aux_lr_pt r ≠ 0 := hr

lemma aux_lr_meas_zero : MeasurableSet ({0} : Set aux_lr_E) := by
  refine ⟨{True}, trivial, ?_⟩
  ext x
  simp [aux_lr_isZero]

lemma aux_lr_prod_le :
    (inferInstance : MeasurableSpace (aux_lr_E × aux_lr_E)) ≤
      MeasurableSpace.comap (fun z : aux_lr_E × aux_lr_E => (aux_lr_isZero z.1, aux_lr_isZero z.2)) ⊤ := by
  show MeasurableSpace.comap Prod.fst aux_lr_inst_ms ⊔ MeasurableSpace.comap Prod.snd aux_lr_inst_ms ≤ _
  refine sup_le ?_ ?_
  · show MeasurableSpace.comap Prod.fst (MeasurableSpace.comap aux_lr_isZero ⊤) ≤ _
    rw [MeasurableSpace.comap_comp]
    have : (aux_lr_isZero ∘ Prod.fst) = Prod.fst ∘
        (fun z : aux_lr_E × aux_lr_E => (aux_lr_isZero z.1, aux_lr_isZero z.2)) := rfl
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono le_top
  · show MeasurableSpace.comap Prod.snd (MeasurableSpace.comap aux_lr_isZero ⊤) ≤ _
    rw [MeasurableSpace.comap_comp]
    have : (aux_lr_isZero ∘ Prod.snd) = Prod.snd ∘
        (fun z : aux_lr_E × aux_lr_E => (aux_lr_isZero z.1, aux_lr_isZero z.2)) := rfl
    rw [this, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono le_top

lemma aux_lr_meas_const (g : aux_lr_E × aux_lr_E → ENNReal) (hg : Measurable g)
    (x : aux_lr_E) (hx : x ≠ 0) : g (x, 0) = g (aux_lr_pt 1, 0) := by
  have hS := aux_lr_prod_le _ (hg (measurableSet_singleton (g (aux_lr_pt 1, 0))))
  rw [MeasurableSpace.measurableSet_comap] at hS
  obtain ⟨t, -, ht⟩ := hS
  have h1 : (aux_lr_pt 1, (0 : aux_lr_E)) ∈ g ⁻¹' {g (aux_lr_pt 1, 0)} := rfl
  have hxmem : (x, (0 : aux_lr_E)) ∈ g ⁻¹' {g (aux_lr_pt 1, 0)} := by
    rw [← ht] at h1 ⊢
    have hψ : (aux_lr_isZero x, aux_lr_isZero (0 : aux_lr_E)) =
        (aux_lr_isZero (aux_lr_pt 1), aux_lr_isZero (0 : aux_lr_E)) := by
      have hx' : aux_lr_isZero x = False := propext ⟨fun h => hx h, fun h => h.elim⟩
      have h1' : aux_lr_isZero (aux_lr_pt 1) = False :=
        propext ⟨fun h => aux_lr_pt_ne 1 one_ne_zero h, fun h => h.elim⟩
      rw [hx', h1']
    simp only [Set.mem_preimage] at h1 ⊢
    rw [hψ]
    exact h1
  exact hxmem

lemma aux_lr_cost_zero :
    ∫⁻ z : aux_lr_E × aux_lr_E, ENNReal.ofReal (‖z.1 - z.2‖ ^ (1:ℝ))
      ∂(Measure.dirac (aux_lr_pt 1, (0 : aux_lr_E))) = 0 := by
  obtain ⟨g, hgm, hgle, heq⟩ := exists_measurable_le_lintegral_eq
    (Measure.dirac (aux_lr_pt 1, (0 : aux_lr_E)))
    (fun z : aux_lr_E × aux_lr_E => ENNReal.ofReal (‖z.1 - z.2‖ ^ (1:ℝ)))
  rw [heq, lintegral_dirac' _ hgm]
  refine le_antisymm ?_ bot_le
  refine ENNReal.le_of_forall_pos_le_add fun δ hδ _ => ?_
  rw [zero_add]
  have hδ' : (δ : ℝ) ≠ 0 := by exact_mod_cast hδ.ne'
  rw [← aux_lr_meas_const g hgm (aux_lr_pt δ) (aux_lr_pt_ne _ hδ')]
  calc g (aux_lr_pt δ, 0) ≤ ENNReal.ofReal (‖aux_lr_pt δ - 0‖ ^ (1:ℝ)) := hgle _
    _ = (δ : ENNReal) := by
      rw [Real.rpow_one, aux_lr_norm_pt, NNReal.abs_eq, ENNReal.ofReal_coe_nnreal]

noncomputable def aux_lr_ell : aux_lr_E → ℝ :=
  Set.indicator ({0}ᶜ : Set aux_lr_E) (fun _ => (1 : ℝ))

lemma aux_lr_ell_sm : StronglyMeasurable aux_lr_ell :=
  StronglyMeasurable.indicator stronglyMeasurable_const aux_lr_meas_zero.compl

lemma aux_lr_ell_int (a : aux_lr_E) : Integrable aux_lr_ell (Measure.dirac a) :=
  (integrable_const (1 : ℝ)).indicator aux_lr_meas_zero.compl

end WassersteinDRO.Duality

open WassersteinDRO.Duality

theorem solution : ¬ (∀ {E : Type} [MeasurableSpace E] [NormedAddCommGroup E]
    (ε p : ℝ) (hε : 0 ≤ ε) (hp : 1 ≤ p) (Ξ : Set E) (hΞcl : IsClosed Ξ)
    (PN : Measure E) [IsProbabilityMeasure PN]
    (ℓ : E → ℝ) (hℓ : Integrable ℓ PN),
    worstCaseRisk ε p Ξ PN ℓ ≤
      (nominalRisk PN ℓ : EReal) + ((ENNReal.ofReal ε * lipschitzModulus ℓ : ENNReal) : EReal)) := by
  intro h
  have key := @h aux_lr_E _ _ 0 1 le_rfl le_rfl Set.univ isClosed_univ
    (Measure.dirac (0 : aux_lr_E)) _ aux_lr_ell (aux_lr_ell_int 0)
  -- right-hand side is `0`
  have hN0 : nominalRisk (Measure.dirac (0 : aux_lr_E)) aux_lr_ell = 0 := by
    unfold nominalRisk
    rw [integral_dirac' _ _ aux_lr_ell_sm]
    simp [aux_lr_ell]
  have hN1 : nominalRisk (Measure.dirac (aux_lr_pt 1)) aux_lr_ell = 1 := by
    unfold nominalRisk
    rw [integral_dirac' _ _ aux_lr_ell_sm]
    simp [aux_lr_ell, aux_lr_pt_ne 1 one_ne_zero]
  rw [hN0, ENNReal.ofReal_zero, zero_mul] at key
  simp only [EReal.coe_zero, EReal.coe_ennreal_zero, add_zero] at key
  -- the Dirac mass at `1` lies in the ambiguity ball of radius `0`
  have hQ : Measure.dirac (aux_lr_pt 1) ∈
      ambiguitySet (0 : ℝ) 1 (Set.univ : Set aux_lr_E) (Measure.dirac (0 : aux_lr_E)) := by
    refine ⟨measure_univ, by simp, ?_⟩
    unfold wassersteinDistance
    have hinf : (⨅ (π : Measure (aux_lr_E × aux_lr_E))
        (_ : π.map Prod.fst = Measure.dirac (aux_lr_pt 1) ∧
          π.map Prod.snd = Measure.dirac (0 : aux_lr_E)),
        ∫⁻ x : aux_lr_E × aux_lr_E, ENNReal.ofReal (‖x.1 - x.2‖ ^ (1:ℝ)) ∂π) = 0 := by
      refine le_antisymm ?_ bot_le
      refine (iInf₂_le (Measure.dirac (aux_lr_pt 1, (0 : aux_lr_E)))
        ⟨Measure.map_dirac' measurable_fst _, Measure.map_dirac' measurable_snd _⟩).trans ?_
      rw [aux_lr_cost_zero]
    rw [hinf, ENNReal.ofReal_zero, div_one, ENNReal.rpow_one]
  have hge : ((1 : ℝ) : EReal) ≤
      worstCaseRisk (0 : ℝ) 1 (Set.univ : Set aux_lr_E) (Measure.dirac (0 : aux_lr_E)) aux_lr_ell := by
    have hle : ((nominalRisk (Measure.dirac (aux_lr_pt 1)) aux_lr_ell : ℝ) : EReal) ≤
        worstCaseRisk (0 : ℝ) 1 (Set.univ : Set aux_lr_E) (Measure.dirac (0 : aux_lr_E))
          aux_lr_ell := by
      unfold worstCaseRisk
      exact le_iSup_of_le (Measure.dirac (aux_lr_pt 1))
        (le_iSup_of_le hQ (le_iSup_of_le (aux_lr_ell_int _) le_rfl))
    rwa [hN1] at hle
  have h10 : ((1 : ℝ) : EReal) ≤ ((0 : ℝ) : EReal) := by
    rw [EReal.coe_zero]
    exact hge.trans key
  exact absurd (EReal.coe_le_coe_iff.mp h10) (by norm_num)
