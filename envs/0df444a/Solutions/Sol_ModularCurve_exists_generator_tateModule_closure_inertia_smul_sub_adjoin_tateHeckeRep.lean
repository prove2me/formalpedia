theorem BQ_tmul (Bf : T →ₗ[ℤ_[2]] T →ₗ[ℤ_[2]] ℤ_[2]) (a b : ℚ_[2]) (x y : T) :
    BQ J Bf (a ⊗ₜ x) (b ⊗ₜ y) = (Bf x y) • (a * b) :=
  LinearMap.BilinForm.baseChange_tmul _ _ _ _ _

theorem BQ_left_nondegenerate (Bf : T →ₗ[ℤ_[2]] T →ₗ[ℤ_[2]] ℤ_[2]) (hBl : ∀ x, (∀ y, Bf x y = 0) → x = 0) :
    ∀ v : V, (∀ w, BQ J Bf v w = 0) → v = 0 := by
  intro v hv
  obtain ⟨c, x, hx⟩ := TensorProduct.exists_pow_smul_eq_one_tmul 2 v
  have hx0 : x = 0 := by
    refine hBl x fun y => ?_
    have h' : BQ J Bf ((((2 : ℕ) : ℚ_[2]) ^ c) • v) ((1 : ℚ_[2]) ⊗ₜ y) = 0 := by
      rw [LinearMap.map_smul₂, hv, smul_zero]
    rw [hx, BQ_tmul, mul_one, Algebra.smul_def, mul_one] at h'
    exact Subtype.ext h'
  have h2 : (((2 : ℕ) : ℚ_[2]) ^ c) • v = 0 := by rw [hx, hx0, TensorProduct.tmul_zero]
  exact (smul_eq_zero.mp h2).resolve_left (pow_ne_zero _ (by norm_num))

theorem BQ_balanced (Bf : T →ₗ[ℤ_[2]] T →ₗ[ℤ_[2]] ℤ_[2])
    (hBt : ∀ (t : HeckeAlg) (x y : T), Bf (tateHeckeRep 2 J t x) y = Bf x (tateHeckeRep 2 J t y)) :
    ∀ τ ∈ rationalHeckeAlgebra 2 J, ∀ v w : V,
      BQ J Bf ((τ : Module.End ℚ_[2] V) v) w = BQ J Bf v ((τ : Module.End ℚ_[2] V) w) := by
  intro τ hτ
  refine Algebra.adjoin_induction (hx := hτ) ?_ ?_ ?_ ?_
  · rintro _ ⟨t, rfl⟩ v w
    induction v using TensorProduct.induction_on with
    | zero => simp
    | tmul a x =>
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul b y => rw [rationalHeckeRep_tmul, rationalHeckeRep_tmul, BQ_tmul, BQ_tmul, hBt]
      | add w w' hw hw' => rw [map_add, map_add, hw, hw', map_add]
    | add v v' hv hv' => simp only [map_add, LinearMap.add_apply, hv, hv']
  · intro a v w
    rw [Algebra.algebraMap_eq_smul_one, LinearMap.smul_apply, LinearMap.smul_apply, Module.End.one_apply,
      Module.End.one_apply, LinearMap.map_smul₂, LinearMap.map_smul]
  · intro α β _ _ hα hβ v w
    rw [LinearMap.add_apply, LinearMap.add_apply, map_add, LinearMap.add_apply, hα, hβ, map_add]
  · intro α β hαm hβm hα hβ v w
    have hcomm : α * β = β * α :=
      congrArg Subtype.val (mul_comm (⟨α, hαm⟩ : ↥(rationalHeckeAlgebra 2 J)) ⟨β, hβm⟩)
    conv_rhs => rw [hcomm]
    rw [Module.End.mul_apply, Module.End.mul_apply, hα, hβ]

