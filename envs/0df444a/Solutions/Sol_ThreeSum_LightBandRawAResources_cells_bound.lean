theorem solution : ∀ (n : Nat),
  @LE.le.{0} Nat instLENat
    (ThreeSum.LightBandRawAResources.cells
      (@HAdd.hAdd.{0, 0, 0} Nat Nat Nat (@instHAdd.{0} Nat instAddNat) (ThreeSum.Scales.inputBits n)
        (@OfNat.ofNat.{0} Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
      n (ThreeSum.BandScales.bandSize n))
    (ThreeSum.LightBandRawAResources.envelope n) := by
  exact @ThreeSum.LightBandRawAResources.cells_bound_sourceProof

