                (simp [Light.Limits.Addr, abs_le, -abs_mul, levelOuter, hreadI, hreadJ] <;> omega))), _, ?_, hnext,
    same.update ⟨by omega, by omega⟩ _⟩
  simp [levelOuter, update_frame_setLocal, hcount, hreadI, hreadJ]

