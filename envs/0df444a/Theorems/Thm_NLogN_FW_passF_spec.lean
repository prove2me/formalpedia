open IntMul IntMul.HvdH NLogN

theorem NLogN.FW.passF_spec (M : MulSpec) (n kb W N J : ℕ) (D : List Desc) (hD : LvlOK n kb W N J D)
    (hn : 1 ≤ n) (hN : N ≤ 2 ^ kb) (hW : 2 * n + kb + 3 ≤ W) (hJ : J + 1 ≤ W)
    (hmW : zsz (D.length : ℤ) ≤ W)
    (s : IState HS) (A : List ℤ) (RD Rs LK LN LXN LXF LM : List Item)
    (hAl : A.length = N) (hAc : Canon (2 ^ n + 1) A) (hX : s.G XD = ints A ++ RD)
    (hsrc : s.G AXS = ints (D.flatMap enc8) ++ Rs) (hK : s.G KBR = .int kb :: LK)
    (hNN : s.G NN = .int (N : ℤ) :: LN) (hXN : s.G NLogN.FW.XN = .int (2 ^ n) :: LXN)
    (hXF : s.G XF = .int (2 ^ n + 1) :: LXF) (hM : s.G NAX = .int (D.length : ℤ) :: LM) :
    Spec M (passP AXS AXR difPrc) s
      (((s.upd XD (ints (lvls (Gd n) D A) ++ RD)).upd AXS Rs).upd AXR
        (ints (D.flatMap enc8).reverse ++ s.G AXR))
      (passCost D.length n kb W N J) := by sorry
