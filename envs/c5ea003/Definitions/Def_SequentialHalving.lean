-- statement:
--   Characterization of the sequential-halving algorithm (Algorithm 22) for fixed-budget best-arm identification: over $L=\lceil\log_2 k\rceil$ phases, the active set halves,
--
--   $$c_0=k, \qquad c_{\ell+1}=\lceil c_\ell/2\rceil,$$
--
--   each phase-$\ell$ active arm is pulled exactly
--
--   $$T_\ell=\left\lfloor \frac{n}{L c_\ell} \right\rfloor$$
--
--   times, survivors are the top half by the fresh phase-$\ell$ empirical means, and the recommendation is the arm surviving all phases. A policy-with-recommendation pair implements sequential halving if in every environment almost every generated history is such a run (this pins the algorithm up to tie-breaking and within-phase pull order).
-- source:
--   L&S §33.3, Algorithm 22, p.413

import Definitions.Def_BanditPolicy

/-!
Lattimore & Szepesvári, *Bandit Algorithms* (CUP 2020), §33.3, Algorithm 22:
sequential halving, the fixed-budget best-arm-identification algorithm.

Given a budget of `n` rounds and `k` arms, the algorithm runs `L = ⌈log₂ k⌉`
phases. Entering phase `ℓ` (`ℓ = 0, …, L - 1`, `0`-indexed here) there is an
active set `A_ℓ` of `c_ℓ` arms, where `c_0 = k` and `c_{ℓ+1} = ⌈c_ℓ / 2⌉` — the
active-set *sizes* are deterministic, so the phase boundaries are as well. During
phase `ℓ` each active arm is pulled exactly `T_ℓ = ⌊n / (L · c_ℓ)⌋` times; the
top `⌈c_ℓ / 2⌉` arms ranked by the empirical means of the *fresh* phase-`ℓ`
samples survive to `A_{ℓ+1}`. After phase `L - 1` a single arm remains, which is
the recommendation.

Formalization: rather than committing to one concrete kernel (which would fix a
tie-breaking rule and a within-phase pull order — choices Algorithm 22 leaves
open and Theorem 33.10 does not depend on), we characterize the algorithm by a
predicate. `IsSeqHalvingRun k n h r` says the `n`-round history `h` is consistent
with a sequential-halving run recommending `r`: there is a chain of active sets
with the prescribed cardinalities in which every eliminated arm's phase empirical
mean is at most every survivor's, each phase pulls exactly its active arms
exactly `T_ℓ` times each, and `r` survives all `L` phases. Rounds after the last
phase (the budget's remainder) are unconstrained, as in the book.
`IsSequentialHalvingPolicy` then says: in every environment, almost every history
generated by the policy is a sequential-halving run recommending `rec`.
-/

open MeasureTheory Finset

namespace BanditAlgorithm

/-- `c_ℓ`, the number of active arms entering (0-indexed) phase `ℓ` of sequential
halving: `c_0 = k` and `c_{ℓ+1} = ⌈c_ℓ / 2⌉` (Algorithm 22, line 7). -/
def seqHalvingCount (k : ℕ) : ℕ → ℕ
  | 0 => k
  | ℓ + 1 => (seqHalvingCount k ℓ + 1) / 2

/-- `T_ℓ = ⌊n / (L · c_ℓ)⌋`, the number of pulls of each active arm during phase
`ℓ`, where `L = ⌈log₂ k⌉` is the number of phases (Algorithm 22, line 4). -/
def seqHalvingPulls (k n ℓ : ℕ) : ℕ :=
  n / (Nat.clog 2 k * seqHalvingCount k ℓ)

/-- The first round (0-indexed) of phase `ℓ`: phase `ℓ` occupies rounds
`[seqHalvingStart k n ℓ, seqHalvingStart k n (ℓ + 1))`, of length `c_ℓ · T_ℓ`. -/
def seqHalvingStart (k n : ℕ) : ℕ → ℕ
  | 0 => 0
  | ℓ + 1 => seqHalvingStart k n ℓ + seqHalvingCount k ℓ * seqHalvingPulls k n ℓ

/-- The rounds of phase `ℓ` inside an `n`-round history. -/
def seqHalvingPhase (k n ℓ : ℕ) : Finset (Fin n) :=
  Finset.univ.filter fun t ↦
    seqHalvingStart k n ℓ ≤ (t : ℕ) ∧ (t : ℕ) < seqHalvingStart k n (ℓ + 1)

/-- `μ̂ᵢ^ℓ`, the empirical mean of arm `i` over the (fresh) phase-`ℓ` samples of
history `h` (Algorithm 22, line 6); junk value `0` if arm `i` is not pulled in
phase `ℓ`. -/
noncomputable def seqHalvingPhaseMean {k n : ℕ} (h : BanditHistory k n) (ℓ : ℕ)
    (i : Fin k) : ℝ :=
  (∑ t ∈ (seqHalvingPhase k n ℓ).filter (fun t ↦ (h t).1 = i), (h t).2) /
    (seqHalvingPulls k n ℓ : ℝ)

/-- The `n`-round history `h` is consistent with a sequential-halving run
(Algorithm 22) recommending arm `r`: some chain `A_0 ⊇ A_1 ⊇ ⋯ ⊇ A_L` of active
sets starts at all arms, halves in cardinality each phase, keeps only arms whose
fresh phase-`ℓ` empirical mean is at least every eliminated arm's, pulls each
phase-`ℓ` active arm exactly `T_ℓ` times during phase `ℓ`, and `r` survives every
phase. (Tie-breaking and the within-phase pull order are unconstrained.) -/
def IsSeqHalvingRun (k n : ℕ) (h : BanditHistory k n) (r : Fin k) : Prop :=
  ∃ A : ℕ → Finset (Fin k),
    A 0 = Finset.univ ∧
    (∀ ℓ < Nat.clog 2 k,
      A (ℓ + 1) ⊆ A ℓ ∧
      (A (ℓ + 1)).card = ((A ℓ).card + 1) / 2 ∧
      (∀ i ∈ A (ℓ + 1), ∀ j ∈ A ℓ \ A (ℓ + 1),
        seqHalvingPhaseMean h ℓ j ≤ seqHalvingPhaseMean h ℓ i) ∧
      (∀ t ∈ seqHalvingPhase k n ℓ, (h t).1 ∈ A ℓ) ∧
      (∀ i ∈ A ℓ,
        ((seqHalvingPhase k n ℓ).filter (fun t ↦ (h t).1 = i)).card =
          seqHalvingPulls k n ℓ)) ∧
    r ∈ A (Nat.clog 2 k)

/-- The policy `π` together with the recommendation rule `rec` implements
sequential halving (Algorithm 22) for budget `n`: in every environment, almost
every history of the `n`-round interaction is a sequential-halving run whose
surviving arm is the recommendation. This pins Algorithm 22 down up to
tie-breaking and the within-phase pull order, neither of which the guarantee of
Theorem 33.10 depends on. -/
def IsSequentialHalvingPolicy (k n : ℕ) (π : BanditPolicy k)
    (rec : BanditHistory k n → Fin k) : Prop :=
  ∀ ν : StochasticBandit k,
    ∀ᵐ h ∂banditMeasure ν π n, IsSeqHalvingRun k n h (rec h)

end BanditAlgorithm


