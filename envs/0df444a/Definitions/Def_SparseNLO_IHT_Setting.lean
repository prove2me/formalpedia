-- name    : SparseNLO_IHT_Setting
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-10-07T16:07:15.015293+00:00
-- url     : https://prove2.me/theorems/50b9957a-f100-4979-828a-45823765b32d
-- title:
--   The IHT method: the projection P_{C_s}, L-stationarity (Def. 2.3), s-regularity (Def. 2.2), f_LI and IHT runs (‖x‖₀, I₁, I₀, C_s, M_s and BF vectors from SparseNLO.CWOpt.Setting)
-- statement:
--   These are the objects of the sparsity constrained problem
--   $$(\mathrm P)\qquad \min\ f(x)\quad\text{s.t.}\quad \|x\|_0\le s,$$
--   where $f:\mathbb R^n\to\mathbb R$ is continuously differentiable and $0<s<n$ is an integer, and of the iterative hard thresholding (IHT) method for solving it.
--
--   1. The **$\ell_0$ norm** $\|x\|_0$ is the number of nonzero components of $x$. The **support** is $I_1(x)=\{i : x_i\neq 0\}$ and its complement is $I_0(x)=\{i : x_i=0\}$. The feasible set is $C_s=\{x : \|x\|_0\le s\}$.
--   2. $M_s(x)$ is the $s$-th largest of the absolute values $|x_1|,\dots,|x_n|$, counted with multiplicity, so that $M_1(x)\ge M_2(x)\ge\dots\ge M_n(x)$. In particular $M_s(x)=0$ exactly when $\|x\|_0<s$.
--   3. The **orthogonal projection** onto $C_s$ is the set of all nearest points
--   $$P_{C_s}(y)=\operatorname*{argmin}_{x\in C_s}\|x-y\|^2 .$$
--   Because $C_s$ is not convex it can have several elements; for example $P_{C_2}((2,1,1)^T)=\{(2,1,0)^T,(2,0,1)^T\}$.
--   4. (Definition 2.3) For $L>0$, a vector $x^*\in C_s$ is an **$L$-stationary point** of (P) if
--   $$[\mathrm{NC}_L]\qquad x^*\in P_{C_s}\Big(x^*-\tfrac1L\nabla f(x^*)\Big).$$
--   5. (Definition 2.1) A vector $x^*\in C_s$ is a **basic feasible (BF) vector** of (P) if $\nabla f(x^*)=0$ when $\|x^*\|_0<s$, and $\nabla_i f(x^*)=0$ for all $i\in I_1(x^*)$ when $\|x^*\|_0=s$.
--   6. (Definition 2.2) A matrix $A\in\mathbb R^{m\times n}$ is **$s$-regular** if for every index set $I\subseteq\{1,\dots,n\}$ with $|I|=s$ the columns of $A$ indexed by $I$ are linearly independent.
--   7. (Example 1.1) The least-squares objective is $f_{LI}(x)=\|Ax-b\|^2$ for $A\in\mathbb R^{m\times n}$ and $b\in\mathbb R^m$.
--   8. (The IHT method, §3.1) Given a constant $L$, a sequence $(x^k)_{k\ge0}$ is generated by the **IHT method with stepsize $1/L$** if $x^0\in C_s$ and, for every $k=0,1,2,\dots$,
--   $$x^{k+1}\in P_{C_s}\Big(x^k-\tfrac1L\nabla f(x^k)\Big).$$
--
--   The IHT method is a fixed-point iteration for the condition $[\mathrm{NC}_L]$; the mission's theorems describe its limit points and, for $f=f_{LI}$ with $s$-regular $A$, the limit of the whole sequence.
--
--   **Formalization Note** Vectors live in `EuclideanSpace ℝ (Fin n)`, so indices are $0,\dots,n-1$ rather than $1,\dots,n$, and $\|\cdot\|$ is the Euclidean norm. $M_s(x)$ is the entry at position $s-1$ of the list of $|x_i|$ sorted in nonincreasing order (meaningful for $1\le s\le n$). $P_{C_s}(y)$ is the full set of minimizers, never one chosen minimizer, so an IHT run is any sequence of selections from it and the theorems hold for every run. Column $i$ of $A$ is the vector $(A_{ri})_{r}$, and $Ax$ is `Matrix.toEuclideanLin A x`. The $L$-stationarity predicate keeps the membership $x^*\in C_s$ of Definition 2.3 even though $[\mathrm{NC}_L]$ implies it. Items 1, 2 and 5 ($\|x\|_0$, $I_1$, $I_0$, $C_s$, $M_s$, BF vectors) are defined in the shared module `SparseNLO.CWOpt.Setting`, which this file imports; this file defines items 3, 4, 6, 7 and 8.
-- source:
--   Beck, Eldar, Sparsity Constrained Nonlinear Optimization: Optimality Conditions and Algorithms, SIAM J. Optim. (2013), doi:10.1137/120869778 (source: arXiv:1203.4580v1), pp. 2, 4, 5, 7, 15, (P), Example 1.1, §2.1, Definition 2.1, Definition 2.2, Definition 2.3 (2.4), the IHT method

import Mathlib
import Definitions.Def_SparseNLO_CWOpt_Setting

namespace SparseNLO.IHT

/-- The orthogonal projection onto `C_s` (p. 7), `P_{C_s}(y) = argmin_{x ∈ C_s} ‖x − y‖²`, as the
**set** of all minimizers: `C_s` is not convex, so the projection is set-valued
(e.g. `P_{C_2}((2,1,1)ᵀ) = {(2,1,0)ᵀ, (2,0,1)ᵀ}`). -/
def projCs (n s : ℕ) (y : EuclideanSpace ℝ (Fin n)) : Set (EuclideanSpace ℝ (Fin n)) :=
  {x | x ∈ SparseNLO.CWOpt.Cs n s ∧ ∀ z ∈ SparseNLO.CWOpt.Cs n s, ‖x - y‖ ≤ ‖z - y‖}

/-- Definition 2.3 (p. 7): `x ∈ C_s` is an `L`-stationary point of (P) if it satisfies
`[NC_L]`: `x ∈ P_{C_s}(x − (1/L) ∇f(x))` (2.4). -/
def IsLStationary {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (s : ℕ) (L : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) : Prop :=
  x ∈ SparseNLO.CWOpt.Cs n s ∧ x ∈ projCs n s (x - (1 / L) • gradient f x)

/-- Definition 2.2 (s-regularity, p. 5): `A ∈ ℝ^{m×n}` is `s`-regular if for every index set
`I ⊆ {1, …, n}` with `|I| = s`, the columns of `A` indexed by `I` are linearly independent.
Column `i` of `A` is `fun r => A r i`. -/
def IsSRegular {m n : ℕ} (s : ℕ) (A : Matrix (Fin m) (Fin n) ℝ) : Prop :=
  ∀ I : Finset (Fin n), I.card = s →
    LinearIndependent ℝ (fun i : (I : Set (Fin n)) => fun r : Fin m => A r i)

/-- The least-squares objective of Example 1.1 (p. 2): `f_LI(x) = ‖Ax − b‖²`. -/
noncomputable def fLI {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : EuclideanSpace ℝ (Fin m))
    (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  ‖Matrix.toEuclideanLin A x - b‖ ^ 2

/-- A run of the IHT method (box, p. 15) with stepsize `1/L`: `x⁰ ∈ C_s` and, for every
`k = 0, 1, 2, …`, `x^{k+1} ∈ P_{C_s}(x^k − (1/L) ∇f(x^k))`. Since `P_{C_s}` is set-valued, a run
is any sequence of selections. -/
def IsIHTRun {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ) (s : ℕ) (L : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) : Prop :=
  x 0 ∈ SparseNLO.CWOpt.Cs n s ∧ ∀ k : ℕ, x (k + 1) ∈ projCs n s (x k - (1 / L) • gradient f (x k))

end SparseNLO.IHT


