theorem main
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (ℓ : ℕ) (hℓ : ℓ.Prime)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (hℓu : IsUnit ((ℓ : ℕ) : 𝒪))
    (h2 : IsUnit ((2 : ℕ) : 𝒪)) (h3 : IsUnit ((3 : ℕ) : 𝒪))
    (m₀ : ℕ) (hm₀ : 3 ≤ m₀) (hm₀u : IsUnit ((m₀ : ℕ) : 𝒪))
    {X : Scheme.{0}} {πX : X ⟶ Spec (CommRingCat.of 𝒪)}
    {pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s πX}
    (hX : IsCoarseModuliT Λ N ℓ X πX pt)
    (k : Type) [Field k] (i : 𝒪 →+* k) (hi : Function.Injective i) :
    ∃ ptk : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of k)),
        FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s (Limits.pullback.snd πX (Spec.map (CommRingCat.ofHom i))),
      IsCoarseModuliT Λ N ℓ (Limits.pullback πX (Spec.map (CommRingCat.ofHom i)))
        (Limits.pullback.snd πX (Spec.map (CommRingCat.ofHom i))) ptk := by
  classical

  have hℓ2 : 2 ≤ ℓ := hℓ.two_le
  have hm : 3 ≤ ℓ * m₀ := le_trans hm₀ (Nat.le_mul_of_pos_left m₀ (by omega))
  have hℓm : ℓ ∣ ℓ * m₀ := Dvd.intro m₀ rfl
  have hm' : IsUnit ((ℓ * m₀ : ℕ) : 𝒪) := by rw [Nat.cast_mul]; exact hℓu.mul hm₀u
  have hNk : IsUnit ((N : ℕ) : k) := by simpa only [map_natCast] using hN.map i
  have hm'k : IsUnit ((ℓ * m₀ : ℕ) : k) := by simpa only [map_natCast] using hm'.map i
  have h2k : IsUnit ((2 : ℕ) : k) := by simpa only [map_natCast] using h2.map i
  have h3k : IsUnit ((3 : ℕ) : k) := by simpa only [map_natCast] using h3.map i

  obtain ⟨L₀, hL₀, hℓL₀, hL₀_left, hL₀_index⟩ :=
    QuaternionAlgebra.IsMaximalOrder.exists_submodule_le_mul_mem_relIndex_eq_sq hqq' hB Λ hΛ ℓ hℓ

  obtain ⟨M, πM, ptF, hM, hMlft, G, instG, instFG, ρ, χ, hρ, H, hH, XH, πXH, πH, hπHX, hπH, hintH, haffH, hsurjH,
      horbitH, hsecH, hinvH, hcatH, U, ptT, hUcl, hUT, hUc, hUf⟩ :=
    oneSide hqq' hB Λ hΛ N ℓ hℓ (ℓ * m₀) hm hℓm L₀ hL₀ hℓL₀ hL₀_left hL₀_index 𝒪 hN hm' h2 h3
  letI := instG; letI := instFG

  obtain ⟨Mk, πMk, ptFk, hMk, hMklft, Gk, instGk, instFGk, ρk, χk, hρk, Hk, hHk, XHk, πXHk, πHk, hπHXk, hπHk, hintHk,
      haffHk, hsurjHk, horbitHk, hsecHk, hinvHk, hcatHk, Uk, ptTk, hUkcl, hUkT, hUkc, hUkf⟩ :=
    oneSide hqq' hB Λ hΛ N ℓ hℓ (ℓ * m₀) hm hℓm L₀ hL₀ hℓL₀ hL₀_left hL₀_index k hNk hm'k h2k h3k
  letI := instGk; letI := instFGk

  obtain ⟨ψ, hψ, hψlab⟩ :=
    CerednikDrinfeld.QM.IsLevelTwistAction.exists_monoidHom_injective_label_congr_of_isOrder Λ hΛ.isOrder N (ℓ * m₀) hρ hρk
  obtain ⟨ψ', hψ', -⟩ :=
    CerednikDrinfeld.QM.IsLevelTwistAction.exists_monoidHom_injective_label_congr_of_isOrder Λ hΛ.isOrder N (ℓ * m₀) hρk hρ
  have hψs : Function.Surjective ψ :=
    (hψ.bijective_of_nat_card_le (Nat.card_le_card_of_injective ψ' hψ')).2
  have hψH : ∀ g : Gk, ψ g ∈ H ↔ g ∈ Hk := fun g => by
    rw [hH, hHk]
    obtain ⟨y, hy⟩ := hψlab g
    exact mem_stabilizer_iff_of_label Λ (fun x y hx hy => hΛ.isOrder.mul_mem hx hy) (ℓ * m₀) ℓ hℓm
      L₀ hL₀ hℓL₀ _ _ y hy
  let τ : ↥Hk → ↥H := fun h => ⟨ψ h, (hψH h).mpr h.2⟩
  have hτ : Function.Surjective τ := fun h' => by
    obtain ⟨g, hg⟩ := hψs h'
    exact ⟨⟨g, (hψH g).mp (hg ▸ h'.2)⟩, Subtype.ext hg⟩

  have hflat : Flat (Spec.map (CommRingCat.ofHom i)) := flat_specMap_of_injective 𝒪 k i hi
  obtain ⟨eM, e, heM, he, heMπ, heπ, heMpt, hecomp⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_iso_quotient_pullback_of_flat_pointCompat
      hqq' hB Λ hΛ N (ℓ * m₀) hm i hflat hN hm' hM hρ hMk hρk
      (↥Hk) (ψ.comp Hk.subtype) (hψ.comp (Subgroup.subtype_injective Hk)) Hk.subtype (Subgroup.subtype_injective Hk)
      (fun h => hψlab h)
      XH πXH πH hπHX (fun h => hπH (τ h)) hintH haffH hsurjH
      (fun x x' => (horbitH x x').trans
        ⟨fun ⟨h', hh'⟩ => by obtain ⟨h, rfl⟩ := hτ h'; exact ⟨h, hh'⟩, fun ⟨h, hh⟩ => ⟨τ h, hh⟩⟩)
      hsecH
      (fun V => by
        rw [hinvH V]
        ext s
        simp only [Set.mem_setOf_eq]
        constructor
        · intro hs h; exact hs (τ h)
        · intro hs h'; obtain ⟨h, rfl⟩ := hτ h'; exact hs h)
      (fun T f hf => hcatH T f (fun h' => by obtain ⟨h, rfl⟩ := hτ h'; exact hf h))
      XHk πXHk πHk hπHXk hπHk hintHk haffHk hsurjHk horbitHk hsecHk hinvHk hcatHk
  haveI := heM
  haveI := he

  obtain ⟨⟨g, ⟨hgπ, hgpt⟩, -⟩, hiso⟩ := CerednikDrinfeld.QM.IsCoarseModuliT.existsUnique_comp_eq_and_isIso hX hUT
  haveI : IsIso g := hiso g hgπ hgpt

  have hident : Uk = e ⁻¹ᵁ ((Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) ⁻¹ᵁ U) := by
    haveI := hMklft

    have key : πHk ⁻¹ᵁ Uk = πHk ⁻¹ᵁ (e ⁻¹ᵁ ((Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) ⁻¹ᵁ U)) := by
      apply AlgebraicGeometry.Scheme.Opens.eq_of_forall_isAlgClosed_mem_iff_of_locallyOfFiniteType πMk
      intro K _ _ i' p hp y
      obtain rfl : y = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      obtain ⟨u, hu⟩ := hMk.ptF_surjective K (Spec.map (CommRingCat.ofHom i')) ⟨p, hp⟩
      have hp' : p = (ptFk K (Spec.map (CommRingCat.ofHom i')) u).1 := (congrArg Subtype.val hu).symm
      subst hp'

      have hcomp : (ptFk K (Spec.map (CommRingCat.ofHom i')) u).1 ≫ πHk ≫ e ≫
          Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i)) =
          (ptF K (Spec.map (CommRingCat.ofHom i') ≫ Spec.map (CommRingCat.ofHom i)) u).1 ≫ πH := by
        have h1 : πHk ≫ e ≫ Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i)) =
            eM ≫ Limits.pullback.fst πM (Spec.map (CommRingCat.ofHom i)) ≫ πH := by
          rw [← Category.assoc, hecomp, Category.assoc, Limits.pullback.lift_fst]
        rw [h1, reassoc_of% (heMpt K (Spec.map (CommRingCat.ofHom i')) u)]
      change ((ptFk K (Spec.map (CommRingCat.ofHom i')) u).1 ≫ πHk).base (IsLocalRing.closedPoint K) ∈ (Uk : Set XHk) ↔
        ((ptFk K (Spec.map (CommRingCat.ofHom i')) u).1 ≫ πHk ≫ e ≫
          Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))).base (IsLocalRing.closedPoint K) ∈ (U : Set XH)
      rw [hcomp, hUkf, hUf]
    apply TopologicalSpace.Opens.ext
    apply hsurjHk.preimage_injective
    exact congrArg (fun O : Mk.Opens => (O : Set Mk)) key

  obtain ⟨etot, hetot, hetotπ⟩ : ∃ etot : (Uk : Scheme.{0}) ⟶ Limits.pullback πX (Spec.map (CommRingCat.ofHom i)),
      IsIso etot ∧ etot ≫ Limits.pullback.snd πX (Spec.map (CommRingCat.ofHom i)) = Uk.ι ≫ πXHk := by

    have si := Spec.map (CommRingCat.ofHom i)

    have hginv : inv g ≫ πX = U.ι ≫ πXH := by rw [← hgπ]; simp
    have hP : IsPullback (Limits.pullback.fst (U.ι ≫ πXH) (Spec.map (CommRingCat.ofHom i)) ≫ inv g)
        (Limits.pullback.snd (U.ι ≫ πXH) (Spec.map (CommRingCat.ofHom i))) πX (Spec.map (CommRingCat.ofHom i)) :=
      (IsPullback.of_hasPullback (U.ι ≫ πXH) (Spec.map (CommRingCat.ofHom i))).of_iso (Iso.refl _) (asIso (inv g))
        (Iso.refl _) (Iso.refl _) (by simp) (by simp) (by simp [hginv]) (by simp)
    let W : (Limits.pullback πXH (Spec.map (CommRingCat.ofHom i))).Opens :=
      (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) ⁻¹ᵁ U
    let e₁ := (XHk.isoOfEq hident).hom
    let e₂ := e ∣_ W
    let e₃ := (pullbackRestrictIsoRestrict (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) U).inv
    let e₄ := (Limits.pullbackSymmetry (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) U.ι).hom
    let e₅ := (Limits.pullbackRightPullbackFstIso πXH (Spec.map (CommRingCat.ofHom i)) U.ι).hom
    let e₆ := hP.isoPullback.hom
    refine ⟨e₁ ≫ e₂ ≫ e₃ ≫ e₄ ≫ e₅ ≫ e₆, inferInstance, ?_⟩
    have h6 : e₆ ≫ Limits.pullback.snd πX (Spec.map (CommRingCat.ofHom i)) =
        Limits.pullback.snd (U.ι ≫ πXH) (Spec.map (CommRingCat.ofHom i)) := hP.isoPullback_hom_snd
    have h5 : e₅ ≫ Limits.pullback.snd (U.ι ≫ πXH) (Spec.map (CommRingCat.ofHom i)) =
        Limits.pullback.snd U.ι (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) ≫
          Limits.pullback.snd πXH (Spec.map (CommRingCat.ofHom i)) :=
      Limits.pullbackRightPullbackFstIso_hom_snd _ _ _
    have h4 : e₄ ≫ Limits.pullback.snd U.ι (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) =
        Limits.pullback.fst (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) U.ι :=
      Limits.pullbackSymmetry_hom_comp_snd _ _
    have h3 : e₃ ≫ Limits.pullback.fst (Limits.pullback.fst πXH (Spec.map (CommRingCat.ofHom i))) U.ι = W.ι :=
      pullbackRestrictIsoRestrict_inv_fst _ _
    have h2 : e₂ ≫ W.ι = (e ⁻¹ᵁ W).ι ≫ e := morphismRestrict_ι _ _
    have h1 : e₁ ≫ (e ⁻¹ᵁ W).ι = Uk.ι := XHk.isoOfEq_hom_ι hident
    simp only [Category.assoc]
    rw [h6, h5, reassoc_of% h4, reassoc_of% h3, reassoc_of% h2, reassoc_of% h1, heπ]
  haveI := hetot
  obtain ⟨ptk, hk, -⟩ := isCoarseModuliT_transport hUkT _ etot hetotπ
  exact ⟨ptk, hk⟩

end CoarseBCFieldQMT

theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q) {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (ℓ : ℕ) (hℓ : ℓ.Prime)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (hℓu : IsUnit ((ℓ : ℕ) : 𝒪))
    (h2 : IsUnit ((2 : ℕ) : 𝒪)) (h3 : IsUnit ((3 : ℕ) : 𝒪))
    (m₀ : ℕ) (hm₀ : 3 ≤ m₀) (hm₀u : IsUnit ((m₀ : ℕ) : 𝒪))
    {X : Scheme.{0}} {πX : X ⟶ Spec (CommRingCat.of 𝒪)}
    {pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
