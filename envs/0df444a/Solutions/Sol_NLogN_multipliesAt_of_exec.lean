      (i.val ≠ 0 ∧ a i ≠ st ∧ (w i).1 ≠ st)) :
    fix st a w = w := by
  funext i
  simp only [fix]
  rcases h i with ⟨h1, h2⟩ | ⟨h1, h2, h3⟩
  · split_ifs <;> simp_all [Prod.ext_iff]
  · simp [h1, h2, h3]

