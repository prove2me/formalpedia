  haveI : IsFiniteMeasure (Measure.map (fun θ => Θ y₀ + θ) (Measure.map Θ P)) := Measure.isFiniteMeasure_map _ _

  refine MeasureTheory.ext_of_forall_integral_eq_of_IsFiniteMeasure fun G => ?_
  rw [integral_map (measurable_const_add _).aemeasurable G.continuous.aestronglyMeasurable,
    integral_map (f := fun x => G (Θ y₀ + x)) hΘm
      (by exact (G.continuous.comp (continuous_const_add _)).aestronglyMeasurable),
    integral_map hΘm G.continuous.aestronglyMeasurable]
  simpa only [add_comm (Θ y₀)] using h y₀ G

