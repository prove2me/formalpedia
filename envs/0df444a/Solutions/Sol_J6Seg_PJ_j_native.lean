-- Source module: Solutions.J6SegILPreJM1
/-!
# B-line IL, `J` pre-table (B5-J), math part 1: the elimination in index form and its bounds

* `aseq_rows`: under the near-identity hypotheses of `pivPos_of` (same induction), every
  trailing block of the pattern elimination `Aseq` stays within `1/2` of the identity in row sums;
  hence (`aseq_entry`, `aseq_piv`) its entries are `≤ (3/2) 2^P` and its pivots `≥ 2^P/2`;
* `Mseq`: the elimination on line indices that only updates the trailing block (`q < i, k`);
  `Mseq_eq`: on the trailing block it is `Aseq` (`Aseq_last`: one more pivot is one more
  `stepA`); `Mseq_frz`: entry `(i, k)` is frozen from step `min i k` on. So the final matrix
  holds `Aseq (min i k) (L i) (L k)` at `(i, k)`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section idx
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S] (L : List ℕ) (A : ℕ → ℕ → ℤ)

lemma Aseq_zero' : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ), Aseq P S L A 0 = A
  | [], _ => rfl
  | _ :: _, _ => rfl

/-- One more pivot is one more `stepA`. -/
theorem Aseq_last : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (q : ℕ), q < L.length →
    Aseq P S L A (q + 1) = stepA P S (L.getD q 0) (Aseq P S L A q)
  | [], _, _, h => by simp at h
  | j :: L, A, 0, _ => by
    rw [Aseq_succ, Aseq_zero', Aseq_zero]; rfl
  | j :: L, A, q + 1, h => by
    rw [Aseq_succ, Aseq_succ, Aseq_last L (stepA P S j A) q (by simp at h; omega)]
    rfl

/-- **On the trailing block, `Mseq` is `Aseq`.** -/
theorem Mseq_eq : ∀ q ≤ L.length, ∀ i k, q ≤ i → q ≤ k →
    Mseq P S L A q i k = Aseq P S L A q (Lg L i) (Lg L k)
  | 0, _, i, k, _, _ => by rw [Aseq_zero']; rfl
  | q + 1, hq, i, k, hi, hk => by
    have ih := Mseq_eq q (by omega)
    rw [Aseq_last P S L A q (by omega)]
    show stepI P S L q (Mseq P S L A q) i k = _
    simp only [stepI, stepA]
    rw [ih i k (by omega) (by omega), ih i q (by omega) le_rfl, ih q q le_rfl le_rfl,
      ih q k le_rfl (by omega)]
    have h1 : q < i := by omega
    have h2 : q < k := by omega
    simp only [h1, h2, true_and]
    rfl

/-- **Entries freeze at step `min i k`.** -/
theorem Mseq_frz (i k : ℕ) : ∀ q, min i k ≤ q → Mseq P S L A q i k = Mseq P S L A (min i k) i k := by
  intro q hq
  induction q with
  | zero => have : min i k = 0 := by omega
            rw [this]
  | succ q ih =>
    rcases Nat.eq_or_lt_of_le hq with h | h
    · rw [h]
    · show stepI P S L q (Mseq P S L A q) i k = _
      have : ¬ (q < i ∧ q < k) := by omega
      simp only [stepI]
      rw [if_neg (fun h' => this ⟨h'.1, h'.2.1⟩)]
      exact ih (by omega)

end idx

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre2
/-!
# `J` kernel precondition (JPre), part 2: entries and pivots of the elimination

`ElimOK P S L A η` bundles the hypotheses of `aseq_rows`/`geSolveS_eq` (near-identity rows with
`η + |L|²/2^P ≤ 1/2`, zero pattern, `PatOK`). Under it, on every trailing block `L.drop r`:

* `aseq_dev`: `|A_r(i,k)/2^P - δ_ik| ≤ 1/2`;
* `aseq_abs_le` / `aseq_int_le`: `|A_r(i,k)| ≤ (3/2) 2^P ≤ 2^{P+1}`; `aseq_zsz`: `zsz ≤ P + 1`;
* `aseq_off`: off the diagonal `|A_r(i,k)| ≤ 2^P/2`;
* `aseq_piv` / `aseq_piv_int`: the pivot `A_r(i,i) ≥ 2^P/2` (`≥ 2^{P-1}` in `ℤ`);
* `aseq_offsum`: the off-diagonal part of pivot row `r` sums to `≤ 2^P/2`;
* `fco_abs_le`: the forward multipliers satisfy `|F| ≤ 2^P + 1`.

`segReg_elim`: the capacitance of a line in the regime `SegReg` satisfies `ElimOK` on
`LJ` with the pattern `bandS (λ+w) (s-λ-w)`; `segReg_aseq` collects the bounds there.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

lemma getD_mem_drop {L : List ℕ} {q r : ℕ} (hqr : q ≤ r) (hr : r < L.length) :
    L.getD r 0 ∈ L.drop q := by
  rw [List.getD_eq_getElem _ _ hr, List.mem_drop_iff_getElem]
  exact ⟨r - q, by omega, by simp only [show q + (r - q) = r by omega]⟩

section elim
variable {P : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ} {η : ℝ}

theorem aseq_dev (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) :
    |(Aseq P S L A r i k : ℝ) / 2 ^ P - kd i k| ≤ 1 / 2 :=
  (single_le_sum (f := fun k => |(Aseq P S L A r i k : ℝ) / 2 ^ P - kd i k|)
    (fun _ _ => abs_nonneg _) (List.mem_toFinset.2 hk)).trans
    (aseq_rows P S L A (fun _ => 0) η h.nd h.η0 h.ηs h.row h.zero h.pat r hr i hi)

theorem aseq_abs_le (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) :
    |(Aseq P S L A r i k : ℝ)| ≤ 3 / 2 * 2 ^ P := by
  have hS := two_pow_pos' P
  have hd := aseq_dev h hr hi hk
  have hkd : |kd i k| ≤ 1 := by unfold kd; split_ifs <;> norm_num
  have h1 : |(Aseq P S L A r i k : ℝ) / 2 ^ P| ≤ 3 / 2 := by
    have := abs_sub_abs_le_abs_sub ((Aseq P S L A r i k : ℝ) / 2 ^ P) (kd i k)
    linarith
  rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at h1
  exact h1

theorem aseq_piv (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i : ℕ}
    (hi : i ∈ L.drop r) : (2 : ℝ) ^ P / 2 ≤ Aseq P S L A r i i := by
  have hS := two_pow_pos' P
  have hd := aseq_dev h hr hi hi
  rw [kd_self] at hd
  have := neg_abs_le ((Aseq P S L A r i i : ℝ) / 2 ^ P - 1)
  have h2 : 1 / 2 ≤ (Aseq P S L A r i i : ℝ) / 2 ^ P := by linarith
  rw [le_div_iff₀ hS] at h2
  linarith

theorem aseq_int_le (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) : |Aseq P S L A r i k| ≤ 2 ^ (P + 1) := by
  have h1 := aseq_abs_le h hr hi hk
  have hS := two_pow_pos' P
  have : (|Aseq P S L A r i k| : ℝ) ≤ ((2 ^ (P + 1) : ℤ) : ℝ) := by
    push_cast; rw [pow_succ]; linarith
  exact_mod_cast this

theorem aseq_piv_int (h : ElimOK P S L A η) (hP : 1 ≤ P) {r : ℕ} (hr : r ≤ L.length) {i : ℕ}
    (hi : i ∈ L.drop r) : 2 ^ (P - 1) ≤ Aseq P S L A r i i := by
  have h1 := aseq_piv h hr hi
  have e : (2 : ℝ) ^ P / 2 = 2 ^ (P - 1) := by
    rw [show P = (P - 1) + 1 by omega, pow_succ]; simp
  rw [e] at h1
  exact_mod_cast h1

/-- The input matrix itself (`r = 0`). -/
theorem cap_int_le (h : ElimOK P S L A η) {i k : ℕ} (hi : i ∈ L) (hk : k ∈ L) :
    |A i k| ≤ 2 ^ (P + 1) := by
  have := aseq_int_le h (r := 0) (Nat.zero_le _) (by simpa using hi) (by simpa using hk)
  rwa [Aseq_zero'] at this

end elim

/-! ## The line in the regime -/

section reg
variable {P R s t lam w α : ℕ}

theorem segReg_elim (h : SegReg P R s t lam w α) :
    ∃ η : ℝ, η ≤ 1 / 4 ∧ (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8 ∧
      ElimOK P (bandS (lam + w) (s - lam - w)) (LJ s t lam w)
        (capI P (TT P R s t α) (BB s t lam w)) η := by
  obtain ⟨η, h0, h4, h8, hrow, hzero⟩ := segReg_cap h
  have hS := two_pow_pos' P
  refine ⟨η, h4, h8, ⟨LJ_nodup s t lam w, h0, ?_, hrow, hzero,
    bandS_patOK _ _ _ (LJ_sorted (s := s) (t := t) (lam := lam) (w := w))⟩⟩
  have : ((LJ s t lam w).length : ℝ) ^ 2 / 2 ^ P ≤
      (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P :=
    div_le_div_of_nonneg_right (by nlinarith [(Nat.cast_nonneg (LJ s t lam w).length : (0 : ℝ) ≤ _)])
      hS.le
  linarith

/-- **The elimination bounds on a line in the regime** (for D2's cost bounds): with
`L = LJ s t λ w`, `A = capI P (TT P R s t α) (BB s t λ w)`, `S = bandS (λ+w) (s-λ-w)`, every
trailing-block entry of the elimination is `≤ 2^{P+1}` in absolute value, every pivot is
`≥ 2^{P-1}`, and the capacitance itself is `≤ 2^{P+1}` on `L × L`. -/
theorem segReg_aseq (h : SegReg P R s t lam w α) :
    (∀ r ≤ (LJ s t lam w).length, ∀ i ∈ (LJ s t lam w).drop r, ∀ k ∈ (LJ s t lam w).drop r,
      |Aseq P (bandS (lam + w) (s - lam - w)) (LJ s t lam w)
        (capI P (TT P R s t α) (BB s t lam w)) r i k| ≤ 2 ^ (P + 1)) ∧
    (∀ r < (LJ s t lam w).length,
      2 ^ (P - 1) ≤ Aseq P (bandS (lam + w) (s - lam - w)) (LJ s t lam w)
        (capI P (TT P R s t α) (BB s t lam w)) r ((LJ s t lam w).getD r 0)
          ((LJ s t lam w).getD r 0)) ∧
    (∀ i ∈ LJ s t lam w, ∀ k ∈ LJ s t lam w,
      |capI P (TT P R s t α) (BB s t lam w) i k| ≤ 2 ^ (P + 1)) := by
  obtain ⟨η, -, -, hE⟩ := segReg_elim h
  have hP1 := (segReg_num h).2.2.2.2
  refine ⟨fun r hr i hi k hk => aseq_int_le hE hr hi hk, fun r hr => ?_,
    fun i hi k hk => cap_int_le hE hi hk⟩
  exact aseq_piv_int hE hP1 hr.le (getD_mem_drop le_rfl hr)

end reg

end J6Seg

end

