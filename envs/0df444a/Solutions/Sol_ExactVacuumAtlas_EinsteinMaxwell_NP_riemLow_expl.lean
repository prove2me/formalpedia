theorem riem_expand (g gi : Metric n) (a b c d : Fin n) (x : Pt n) :
    riem g gi a b c d x = pd c (christoffel g gi a d b) x - pd d (christoffel g gi a c b) x
      + ∑ e, (christoffel g gi a c e x * christoffel g gi e d b x
        - christoffel g gi a d e x * christoffel g gi e c b x) := by
