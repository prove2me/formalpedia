theorem pushforward_mem_characterLattice (f : E → V) (x : E → ℤ) (hx : x ∈ characterLattice E) :
    pushforward f x ∈ characterLattice V := by
  rw [mem_characterLattice] at hx ⊢
  have h := degreeOn_pushforward f x
  rw [degreeOn_apply, degreeOn_apply] at h
  rw [h]
  exact hx

def δ₀ : ↥(characterLattice E) →ₗ[ℤ] (↥(characterLattice V) × ↥(characterLattice V)) :=
  LinearMap.prod
    ((pushforward Q.D.a).restrict (fun x hx => pushforward_mem_characterLattice Q.D.a x hx))
    ((pushforward Q.D.b).restrict (fun x hx => pushforward_mem_characterLattice Q.D.b x hx))

def ι₀ : ↥(ribbonKernel Q.D) →ₗ[ℤ] ↥(characterLattice E) :=
  Submodule.inclusion (ribbonKernel_le_characterLattice Q.D)

theorem δ₀_ι₀ (y : ↥(ribbonKernel Q.D)) : Q.δ₀ (Q.ι₀ y) = 0 := by
  have hy := (mem_ribbonKernel).1 y.2
  have h0 : pushforward Q.D.a (y : E → ℤ) = 0 := by simpa [jointDelta] using hy 0
  have h1 : pushforward Q.D.b (y : E → ℤ) = 0 := by simpa [jointDelta] using hy 1
  apply Prod.ext
  · apply Subtype.ext
    show pushforward Q.D.a (y : E → ℤ) = 0
    exact h0
  · apply Subtype.ext
    show pushforward Q.D.b (y : E → ℤ) = 0
    exact h1

def σfull : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] (E → ℤ) :=
  (Q.padj 0).comp (-((characterLattice V).subtype.comp (LinearMap.fst ℤ _ _))) +
  (Q.padj 1).comp ((Q.TV Q.s).mulVecLin.comp ((characterLattice V).subtype.comp (LinearMap.fst ℤ _ _)) -
      (characterLattice V).subtype.comp (LinearMap.snd ℤ _ _))

theorem padj_mem (i : Fin 2) (v : V → ℤ) (hv : v ∈ characterLattice V) : Q.padj i v ∈ characterLattice E := by
  rw [mem_characterLattice] at hv ⊢
  have hdeg := degreeOn_pushforward ((![Q.D.a, Q.D.b]) i) (Q.padj i v)
  have h2 : pushforward ((![Q.D.a, Q.D.b]) i) (Q.padj i v) = (((Q.s : ℕ) : ℤ) + 1) • v := Q.c3_deg i v
  rw [h2, degreeOn_apply, degreeOn_apply] at hdeg
  rw [← hdeg]
  simp only [Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum, hv, mul_zero]

theorem σfull_mem (x : ↥(characterLattice V) × ↥(characterLattice V)) : Q.σfull x ∈ characterLattice E := by
  show Q.padj 0 (-x.1.1) + Q.padj 1 ((Q.TV Q.s).mulVec x.1.1 - x.2.1) ∈ characterLattice E
  refine Submodule.add_mem _ (Q.padj_mem 0 _ ?_) (Q.padj_mem 1 _ ?_)
  · exact Submodule.neg_mem _ x.1.2
  · exact Submodule.sub_mem _ (Q.degV Q.s _ x.1.2) x.2.2

def σ₀ : (↥(characterLattice V) × ↥(characterLattice V)) →ₗ[ℤ] ↥(characterLattice E) :=
  LinearMap.codRestrict (characterLattice E) Q.σfull Q.σfull_mem

