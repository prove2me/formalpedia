      omega
    have hcost : cb+cr+2 ≤ ((dispatchCharge ScaledCeiling.ceilingProgram.code+3)*(16*utilityDepth i.size+32)+61)*
        (bankAddress B j.val logical::rest).length+13*pointerTravel i a (allEvents i B j g (bankAddress B j.val logical::rest))+2 := by
      rw [allEvents_cons,pointerTravel_append,List.length_cons,Nat.mul_add,Nat.mul_one]
      omega
    refine ⟨cb+cr+2,t,zs,Eval.loopYes htest hu ht,hcost,?_,?_,htenv,?_,huframe.trans htframe⟩
    · rw [allEvents_cons,adapterTrace_append]
      exact htm
    · simp only [List.length_cons];omega
