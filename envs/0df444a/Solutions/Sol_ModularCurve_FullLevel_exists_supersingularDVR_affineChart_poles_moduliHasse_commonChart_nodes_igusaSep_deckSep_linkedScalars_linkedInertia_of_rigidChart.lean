theorem exists_pow_succ_eq (q : ℕ) [Fact q.Prime] (d : (ZMod q)ˣ) :
    ∃ c : (GaloisField q 2)ˣ, ((c : GaloisField q 2)) ^ (q + 1) = algebraMap (ZMod q) (GaloisField q 2) d := by
  obtain ⟨c, hc⟩ := FiniteField.unitsMap_norm_surjective (ZMod q) (GaloisField q 2) d
  refine ⟨c, ?_⟩
  have h := congrArg (fun u : (ZMod q)ˣ => algebraMap (ZMod q) (GaloisField q 2) (u : ZMod q)) hc
  simp only [Units.coe_map] at h
  rw [FiniteField.algebraMap_norm_eq_pow] at h
  have hcard : (Nat.card (GaloisField q 2) - 1) / (Nat.card (ZMod q) - 1) = q + 1 := by
    rw [GaloisField.card q 2 two_ne_zero, Nat.card_zmod]
    have hq : 2 ≤ q := (Fact.out : q.Prime).two_le
    have h1 : q ^ 2 - 1 = (q + 1) * (q - 1) := by
      obtain ⟨n, rfl⟩ : ∃ n, q = n + 1 := ⟨q - 1, by omega⟩
      simp only [Nat.add_sub_cancel]
      ring_nf
      omega
    rw [h1, Nat.mul_div_cancel _ (by omega)]
  rw [hcard] at h
  exact h

theorem exists_diagOneElem_inv_mem_hSubgroup (q : ℕ) [Fact q.Prime] (d : (ZMod q)ˣ) :
    ∃ c : (GaloisField q 2)ˣ, (diagOneElem q d⁻¹, c) ∈ DrinfeldCurve.hSubgroup q := by
  obtain ⟨c, hc⟩ := exists_pow_succ_eq q d
  refine ⟨c, ?_⟩
  rw [DrinfeldCurve.mem_hSubgroup_iff, Units.ext_iff, DrinfeldCurve.coe_hChar_apply, Units.val_one]
  have hdet : ((diagOneElem q d⁻¹ : CuspidalType.GL2 q) : Matrix (Fin 2) (Fin 2) (ZMod q)).det = (d⁻¹ : (ZMod q)ˣ) := by
    rw [coe_diagOneElem, Matrix.det_fin_two_of]; ring
  show algebraMap (ZMod q) (GaloisField q 2) ((diagOneElem q d⁻¹ : CuspidalType.GL2 q) : Matrix (Fin 2) (Fin 2) (ZMod q)).det *
      ((c : GaloisField q 2)) ^ (q + 1) = 1
  rw [hdet, hc, ← map_mul, Units.inv_mul, map_one]

