    rw [hsos]; exact sos3_eq_zero_iff h0 h2 h4
  have hmis0 : misalign f m N w p a x k = 0 ↔
      resL f m N w p a x k = 0 ∧ frameInv w x k 2 = 0 ∧ frameInv w x k 4 = 0 := by
    have := sos3_eq_zero_iff (a := resL f m N w p a x k) (b := frameInv w x k 2)
