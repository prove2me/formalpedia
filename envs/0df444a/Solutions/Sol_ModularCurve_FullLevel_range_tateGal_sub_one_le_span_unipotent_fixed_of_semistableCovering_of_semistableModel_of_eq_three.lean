  · have hr : Set.range (fun p => vc (𝒞.eEdge p)) = Set.range vc := 𝒞.eEdge.surjective.range_comp vc
    rw [hr]
    exact hi (AG q M' τ) ⟨τ, hτ, hχ, rfl⟩ w'
  ·
    let E₀ : Equiv.Perm (CuspidalType.ProjLine q ⊕ ↥W) :=
      Equiv.sumCongr (MulAction.toPerm (redQ q γ)) (Equiv.refl ↥W)
    let E₁ : Equiv.Perm (CuspidalType.ProjLine q × ↥W) :=
      Equiv.prodCongr (MulAction.toPerm (redQ q γ)) (Equiv.refl ↥W)
    let σ₀ : Equiv.Perm (Fin 𝒞.teleN) := (𝒞.eIdx.symm.trans E₀).trans 𝒞.eIdx
    let σ₁ : Equiv.Perm (Fin 𝒞.teleM) := (𝒞.eEdge.symm.trans E₁).trans 𝒞.eEdge
    have hσ₀ : ∀ j, 𝒞.eIdx.symm (σ₀ (𝒞.eIdx j)) = E₀ j := fun j => by simp [σ₀]
    have hσ₁ : ∀ p, 𝒞.eEdge.symm (σ₁ (𝒞.eEdge p)) = (redQ q γ • p.1, p.2) := fun p => by
      obtain ⟨ℓ', s'⟩ := p
      simp [σ₁, E₁]
    have key := hii (levelAutBar q M' ζ₀ γ⁻¹) σ₀ σ₁
      (fun e => by
        obtain ⟨p, rfl⟩ := 𝒞.eEdge.surjective e
        simp [SemistableCovering.teleSrc, σ₀, σ₁, E₀, E₁])
      (fun e => by
        obtain ⟨p, rfl⟩ := 𝒞.eEdge.surjective e
        simp [SemistableCovering.teleTgt, σ₀, σ₁, E₀, E₁])
      (fun i P => by
        obtain ⟨j, rfl⟩ := 𝒞.eIdx.surjective i
        have gen : ∀ a b : CuspidalType.ProjLine q ⊕ ↥W, a = j → b = E₀ j →
            (P ∈ (𝒞.sumChart a).dom ↔
              SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹) • P ∈ (𝒞.sumChart b).dom) := by
          intro a b ha hb
          rw [ha, hb]
          exact chart_dom_levelAut 𝒞 hEq hd γ hγ j P
        exact gen _ _ (𝒞.eIdx.symm_apply_apply j) (hσ₀ j))
      (fun i f => by
        obtain ⟨j, rfl⟩ := 𝒞.eIdx.surjective i
        have gen : ∀ a b : CuspidalType.ProjLine q ⊕ ↥W, a = j → b = E₀ j →
            (f ∈ (𝒞.sumChart a).integers ↔
              (levelAutBar q M' ζ₀ γ⁻¹) f ∈ (𝒞.sumChart b).integers) := by
          intro a b ha hb
          rw [ha, hb]
          exact chart_int_levelAut 𝒞 hEq hd γ hγ j f
        exact gen _ _ (𝒞.eIdx.symm_apply_apply j) (hσ₀ j))
      (fun e P => by
        obtain ⟨p, rfl⟩ := 𝒞.eEdge.surjective e
        have gen : ∀ a b : CuspidalType.ProjLine q × ↥W, a = p → b = (redQ q γ • p.1, p.2) →
            (P ∈ (𝒞.An a.1 a.2).dom ↔
              SemilinearAut.ofAlgAut (levelAutBar q M' ζ₀ γ⁻¹) • P ∈ (𝒞.An b.1 b.2).dom) := by
          intro a b ha hb
          rw [ha, hb]
          exact an_dom_levelAut 𝒞 hd γ hγ p.1 p.2 P
        exact gen _ _ (𝒞.eEdge.symm_apply_apply p) (hσ₁ p))
      𝒞.teleSrc_ne_teleTgt (𝒞.eEdge (ℓ, s))
    have hE : σ₁ (𝒞.eEdge (ℓ, s)) = 𝒞.eEdge (redQ q γ • ℓ, s) := by
      apply 𝒞.eEdge.symm.injective
      rw [hσ₁, Equiv.symm_apply_apply]
    rw [hE] at key
    exact key

