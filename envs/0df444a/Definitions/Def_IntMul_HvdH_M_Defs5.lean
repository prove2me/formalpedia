-- Source module: NLogN.HCrKey
/-!
# Generating the CRT keys `keyL s` incrementally (namespace `NLogN.CR`)

Records `[k mod sᵢ, sᵢ, wᵢ, sᵢ wᵢ]` (`wᵢ = ∏_{i' > i} s_{i'}`) on stack `kRA`; for each `k < S`
the current key `rmPos s (k mod sᵢ)ᵢ` (kept on `kPS`) is emitted and every record is advanced.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul IntMul.HvdH IntMul.HvdH.Ref RS

abbrev kRA : Fin HS := 4
abbrev kRB : Fin HS := 5
abbrev kX1 : Fin HS := 6
abbrev kX2 : Fin HS := 7
abbrev kX3 : Fin HS := 8
abbrev kX4 : Fin HS := 9
abbrev kPS : Fin HS := 10
abbrev kT : Fin HS := 11
abbrev kC1 : Fin HS := 12
abbrev kC2 : Fin HS := 13
abbrev kC3 : Fin HS := 14
abbrev kSR : Fin HS := 15
abbrev kKR : Fin HS := 16
abbrev kK4 : Fin HS := 17

/-- Advance one record `[r, s, w, sw]` from `kRA` to `kRB` and update the position. -/
def axBody : RS :=
  seqL [push kX1 (.reg kRA), pop kRA, push kX2 (.reg kRA), pop kRA,
    push kX3 (.reg kRA), pop kRA, push kX4 (.reg kRA), pop kRA,
    ite (.add (.add (.reg kX1) (.lit 1)) (.neg (.reg kX2)))
      (NLogN.RS.seq (push kRB (.add (.reg kX1) (.lit 1))) (asg kPS (.add (.reg kPS) (.reg kX3))))
      (NLogN.RS.seq (push kRB (.lit 0)) (asg kPS (.add (.add (.reg kPS) (.reg kX3)) (.neg (.reg kX4))))),
    push kRB (.reg kX2), push kRB (.reg kX3), push kRB (.reg kX4),
    pop kX1, pop kX2, pop kX3, pop kX4]

/-! ## Records -/

/-- Residues of `k + 1` on the axes `< m`, of `k` on the others. -/
def mixJ (s : List ℕ) (k m : ℕ) : ℕ → ℕ :=
  fun i => if i < m then (k + 1) % s.getD i 1 else k % s.getD i 1

/-! ## The inner loop over the axes -/

def innerSt (t1 : IState HS) (s : List ℕ) (k : ℕ) (Rst RB0 LP : List Item) (m : ℕ) : IState HS :=
  ((t1.upd kRA (ints ((recL s k).drop m).flatten ++ Rst)).upd kRB
    (ints ((recL s (k + 1)).take m).flatten.reverse ++ RB0)).upd kPS
    (.int (rmPos s (mixJ s k m)) :: LP)

/-! ## The outer loop over `k < S` -/

def outBody : RS :=
  NLogN.RS.seq (push kT (.reg kPS)) (NLogN.RS.seq (rep kC2 (.reg kKR) NLogN.CR.axBody) (mvK kRB kRA kC3 (.reg kK4)))

/-- The keys emitted so far. -/
def keyPre (s : List ℕ) (k : ℕ) : List ℤ := (List.range k).map fun k' => (crtKey s k' : ℤ)

def keySt (s0 : IState HS) (s : List ℕ) (Rst LP T0 : List Item) (k : ℕ) : IState HS :=
  ((s0.upd kRA (ints (recL s k).flatten ++ Rst)).upd kPS (.int (crtKey s k) :: LP)).upd kT
    (ints (keyPre s k).reverse ++ T0)

/-- **Key generation.** -/
def keyGen : RS :=
  NLogN.RS.seq (push kPS (.lit 0)) (NLogN.RS.seq (rep kC1 (.reg kSR) outBody) (NLogN.RS.seq (pop kPS) (mvK kT 3 kC3 (.reg kSR))))

end NLogN.CR

end

