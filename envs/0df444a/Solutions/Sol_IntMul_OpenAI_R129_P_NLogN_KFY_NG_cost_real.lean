  have hK0 : (0 : ℝ) ≤ (IntMul.OpenAI.R129.KP n : ℝ) := Nat.cast_nonneg _
  have r0 : 0 ≤ (IntMul.OpenAI.R129.dP n : ℝ) * (IntMul.OpenAI.R129.KP n : ℝ) + (IntMul.OpenAI.Glue.pP n : ℝ) * (IntMul.OpenAI.R129.KP n : ℝ) ^ (IntMul.OpenAI.R129.τ - 1) +
      (IntMul.OpenAI.R129.ℓP n : ℝ) * (IntMul.OpenAI.R129.dP n : ℝ) ^ lam' := by positivity
  have r1a : 0 ≤ (IntMul.OpenAI.R129.dP n : ℝ) * (IntMul.OpenAI.Glue.pP n : ℝ) ^ δ := by positivity
  have r1b : 0 ≤ (IntMul.OpenAI.Glue.pP n : ℝ) ^ δ := by positivity
