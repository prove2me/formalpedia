section
-- Source module: NLogN.Add
/-!
# Binary words on stacks; addition

A word `A : List Bool` (least significant bit first) sits on a stack as `A.map codeBit`, so its
least significant bit is on top.  A word ends where the stack stops showing bits.
-/

namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

@[simp] theorem bitOf_codeBit (b : Bool) : bitOf (some (codeBit b)) = some b := by
  cases b <;> rfl

theorem codeBit_ne_hlt (b : Bool) : codeBit b ≠ hlt := by cases b <;> decide

/-- Ripple-carry addition with carry-in `c`. -/
def addL : Bool → List Bool → List Bool → List Bool
  | c, [], [] => if c then [true] else []
  | c, x :: A, [] => (x ^^ c) :: addL (x && c) A []
  | c, [], y :: B => (y ^^ c) :: addL (y && c) [] B
  | c, x :: A, y :: B => (x ^^ y ^^ c) :: addL ((x && y) || (c && (x ^^ y))) A B

/-- Transition of `add`: the state is the carry (`codeBit`). -/
def addδ (q a b d e : Fin S) : List (Option Sym) → List (Op S)
  | [some c, ta, tb] =>
    if bitOf ta = none ∧ bitOf tb = none then
      (if c = 1 then [.push d 1] else []) ++ [.pop q, .push q hlt]
    else
      let x := (bitOf ta).getD false
      let y := (bitOf tb).getD false
      let cb := decide (c = 1)
      (if (bitOf ta).isSome then [.pop a] else []) ++
        (if (bitOf tb).isSome then [.pop b, .push e (codeBit y)] else []) ++
        [.push d (codeBit (x ^^ y ^^ cb)), .pop q,
          .push q (codeBit ((x && y) || (cb && (x ^^ y))))]
  | _ => [.pop q, .push q hlt]

theorem addδ_length (q a b d e : Fin S) (os) : (addδ q a b d e os).length ≤ 6 := by
  unfold addδ; split
  · split_ifs <;> simp
  · simp

/-- `add`: pops the words on `a` and `b`, pushes their sum on `d` (most significant bit on top)
and the word of `b` on `e` (reversed). -/
def add (q a b d e : Fin S) : Stmt S P := machine q [a, b] 0 (addδ q a b d e)

def addCost (m : ℕ) : ℕ := (m + 1) * 59 + 3

section
variable {q a b d e : Fin S} (hqa : q ≠ a) (hqb : q ≠ b) (hqd : q ≠ d) (hqe : q ≠ e)
  (hab : a ≠ b) (had : a ≠ d) (hae : a ≠ e) (hbd : b ≠ d) (hbe : b ≠ e) (hde : d ≠ e)
  (ra rb Q : List Sym) (hra : bitOf ra.head? = none) (hrb : bitOf rb.head? = none)

/-- Configuration of `add` with carry `c`, remaining words `A`, `B`. -/
def addCfg (σ : St S) (c : Sym) (A B : List Bool) (D E : List Sym) : St S :=
  ((((σ.set a (A.map codeBit ++ ra)).set b (B.map codeBit ++ rb)).set d D).set e E).set q (c :: Q)

include hqa hqb hqd hqe hab had hae hbd hbe hde hra hrb in
theorem add_reaches (σ : St S) : ∀ (A B : List Bool) (c : Bool) (D E : List Sym),
    Reaches I q [a, b] (addδ q a b d e)
      (addCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ (codeBit c) A B D E)
      (addCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q σ hlt [] []
        (((addL c A B).map codeBit).reverse ++ D) ((B.map codeBit).reverse ++ E))
      (max A.length B.length + 1) := by
  have hqa' := Ne.symm hqa; have hqb' := Ne.symm hqb; have hqd' := Ne.symm hqd
  have hqe' := Ne.symm hqe; have hab' := Ne.symm hab; have had' := Ne.symm had
  have hae' := Ne.symm hae; have hbd' := Ne.symm hbd; have hbe' := Ne.symm hbe
  have hde' := Ne.symm hde
  have htop : ∀ (c : Bool) A B D E, (addCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q
      σ (codeBit c) A B D E).top q ≠ some hlt := by
    intro c A B D E
    simp only [addCfg, St.top_set_same, List.head?_cons, ne_eq, Option.some.injEq]
    exact codeBit_ne_hlt c
  -- the tops seen by one step
  have htops : ∀ (c : Sym) A B D E, (addCfg (q := q) (a := a) (b := b) (d := d) (e := e) ra rb Q
      σ c A B D E).tops [q, a, b] = [some c, (A.map codeBit ++ ra).head?,
        (B.map codeBit ++ rb).head?] := by
    intro c A B D E
    simp only [St.tops, addCfg, List.map_cons, List.map_nil, St.top_set, hqa, hqb, hqd, hqe, hab,
      had, hae, hbd, hbe, hde, hqa', hqb', hqd', hqe', hab', had', hae', hbd', hbe', hde',
      if_true, if_false, List.head?_cons]
  intro A
  induction A with
  | nil =>
    intro B
    induction B with
    | nil =>
      intro c D E
      refine Reaches.step' (htop c [] [] D E) ?_ (Reaches.refl _)
      rw [mstep, htops]
      simp only [List.map_nil, List.nil_append]
