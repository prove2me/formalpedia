def LevelAuts : Subgroup ((fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M')) :=
  Subgroup.closure {τ | ∃ (ζ : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' ∧ τ = levelAutBar q M' ζ γ}

set_option synthInstance.maxHeartbeats 1600000 in
theorem levelAutBar_mem_levelAuts (ζ : Idx q) {γ : SL(2, ℤ)} (hγ : γ ∈ Gamma0 M') :
    levelAutBar q M' ζ γ ∈ LevelAuts q M' :=
  Subgroup.subset_closure ⟨ζ, γ, hγ, rfl⟩

set_option synthInstance.maxHeartbeats 1600000 in

structure ChartSpec {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A (fieldBar q M') Fbar) (O : ValuationSubring (fieldBar q M')) (n : ℕ) : Prop where
  integers_eq : C.integers = O
  card_nodes : C.nodes.card = n
  dom_canonical : ∀ τ ∈ LevelAuts q M',
    (C.comap τ).integers = C.integers → (C.comap τ).dom = C.dom
  hasPrincipalDivisors : HasPrincipalDivisors (ResidueField A) Fbar
  isRational : ∀ x : Place (ResidueField A) Fbar, x.IsRational
  isCurveOver : IsCurveOver (ResidueField A) Fbar
  essFiniteType : Algebra.EssFiniteType (ResidueField A) Fbar
  hasDiscFibres : SemistableCovering.HasDiscFibres C

variable {q M' A}

set_option synthInstance.maxHeartbeats 1600000 in
theorem comap_conj_integers_eq {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A (fieldBar q M') Fbar) (g₁ g₂ τ : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M'))
    (h : ((C.comap g₁).comap τ).integers = (C.comap g₂).integers) :
    (C.comap (g₁ * τ * g₂⁻¹)).integers = C.integers := by
  ext f
  have hf := SetLike.ext_iff.mp h (g₂⁻¹ f)
  simp only [ComponentChart.mem_comap_integers, AlgEquiv.mul_apply] at hf ⊢
  rw [hf]
  show g₂ (g₂⁻¹ f) ∈ C.integers ↔ f ∈ C.integers
  rw [← AlgEquiv.mul_apply, mul_inv_cancel, AlgEquiv.one_apply]

set_option synthInstance.maxHeartbeats 1600000 in
theorem comap_comap_dom_eq_of_integers_eq {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A (fieldBar q M') Fbar)
    (hcan : ∀ τ ∈ LevelAuts q M', (C.comap τ).integers = C.integers → (C.comap τ).dom = C.dom)
    (g₁ g₂ τ : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M'))
    (hg₁ : g₁ ∈ LevelAuts q M') (hg₂ : g₂ ∈ LevelAuts q M') (hτ : τ ∈ LevelAuts q M')
    (h : ((C.comap g₁).comap τ).integers = (C.comap g₂).integers) :
    ((C.comap g₁).comap τ).dom = (C.comap g₂).dom := by
  have key := hcan (g₁ * τ * g₂⁻¹) (Subgroup.mul_mem _ (Subgroup.mul_mem _ hg₁ hτ) (Subgroup.inv_mem _ hg₂))
    (comap_conj_integers_eq C g₁ g₂ τ h)
  ext P
  have hP := Set.ext_iff.mp key (g₂ • P)
  simp only [ComponentChart.mem_comap_dom] at hP ⊢
  rw [← hP, mul_smul, mul_smul, inv_smul_smul]

