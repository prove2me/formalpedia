  have h3 : IntMul.OpenAI.R129.P.NLogN.KFM.TrRegs t3 n w m rw rm := h2.upd hd _
  obtain ⟨LW3, hW3⟩ := h3.hW
  have c4 := NLogN.KFM.pushReg_cost dst (.reg rw) t3 A _ hEnv (by
