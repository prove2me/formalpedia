section DyadicApproximation


theorem _root_.solution {n m : ℕ} : Measurable (dyadicShift (n := n) m) := by
  unfold dyadicShift
  apply measurable_pi_lambda
  intro i
  have hfloor : Measurable (fun z : Fin n → ℝ => ⌊(2 : ℝ)^m * z i⌋) :=
    (measurable_const.mul (measurable_pi_apply i)).floor
  have hcast : Measurable (fun k : ℤ => (k : ℝ)) := measurable_of_countable _
  exact (hcast.comp hfloor).div measurable_const
