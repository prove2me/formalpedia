    exact rational_phase_norm_lower a q j hqpos haq hjpos hjq
  have hjhalfR : (j : ℝ) ≤ (q : ℝ) / 2 := by
    have hcast : (2 * j : ℝ) ≤ (q : ℝ) := by exact_mod_cast hjhalf
