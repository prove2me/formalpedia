open Real
open scoped ComplexConjugate ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del domReg domKN)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable (om mm : ℝ) (u : (Fin 2 → ℝ) → ℂ) (x : Pt 4)
theorem solution : cpdC 0 (modeField om mm u) x = -(Complex.I * om) * modeField om mm u x := by
  unfold cpdC
  have e : (fun s : ℝ => modeField om mm u (Function.update x 0 s)) =
      fun s : ℝ => Complex.exp (-(Complex.I * om * (s : ℂ)) + Complex.I * mm * x 3) * u (toRT x) := by
    funext s; simp [modeField, phaseP, toRT_update_t]
  rw [e]
  have h : HasDerivAt (fun s : ℝ => -(Complex.I * om * (s : ℂ)) + Complex.I * mm * x 3) (-(Complex.I * om)) (x 0) := by
    have := (((hasDerivAt_id (x 0)).ofReal_comp).const_mul (Complex.I * (om : ℂ))).neg.add_const
      (Complex.I * (mm : ℂ) * (x 3 : ℂ))
    simpa using this
  rw [(h.cexp.mul_const (u (toRT x))).deriv]
  simp only [modeField, phaseP]; ring
