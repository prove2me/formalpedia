section
-- Source module: Solutions.R6ChkBitBase
/-!
# Bit round six (h = 23): support trees and triple tables

* `BT`: a binary tree of numbers; `btGet t d i` follows the low `d` bits of `i` (most significant
  first). Node supports (bitmasks over the 1771 triples of `Fin 23`) are stored 16 per leaf in
  1792-bit fields (`R6BitDataSup*`), read by `fieldOf`.
* `TRIPL`: row `i` (32-bit field) is the bitmask of the `i`-th triple (lexicographic order);
  `STARL`: field `c` (1792 bits) is `star c`, the set of triples containing `c`;
  `UMT0..3`: field `b` of `UMTj` is the set of triples meeting the 6-bit chunk `b` of points
  `6j, …, 6j+5` (so `um P` = triples meeting `P` is four lookups).
* Table facts are proved by one kernel evaluation each (`star_spec`, `umt_spec`).
-/

namespace R6Chk.Bit

open R6Chk

theorem tb_eq (x i : ℕ) : tb x i = x.testBit i := by
  rw [tb, nland, nshr, Nat.and_one_is_mod, Nat.testBit_eq_decide_div_mod_eq, Nat.shiftRight_eq_div_pow]
  rcases Nat.mod_two_eq_zero_or_one (x / 2 ^ i) with h | h <;> rw [h] <;> rfl

theorem testBit_fieldOf (X w i t : ℕ) :
    (fieldOf X w i).testBit t = (decide (t < w) && X.testBit (w * i + t)) := by
  rw [fieldOf, nland, nshr, nmul, nsub, nshl, Nat.one_shiftLeft, Nat.testBit_and,
    Nat.testBit_two_pow_sub_one, Nat.testBit_shiftRight, Bool.and_comm]

theorem fieldOf_lt (X w i : ℕ) : fieldOf X w i < 2 ^ w := by
  rw [fieldOf, nland, nsub, nshl, Nat.one_shiftLeft]
  exact Nat.and_lt_two_pow _ (Nat.sub_lt (Nat.two_pow_pos w) Nat.one_pos)

end R6Chk.Bit

end

section
-- Source module: Solutions.R6ChkCx
/-!
# Reflective checker for nested nondegenerate `F₂` label pairs (complex round six)

Data: a list of **groups**. A group is one natural number read as 32-bit fields (LSB first):
`kV, cnt, B (kV rows), H (n-kV), D (kV), E (n-kV)`, then `cnt` entries `kU, U (kU), EU (kU),
R (kV-kU)`. Rows are vectors of `F₂^n` (`n ≤ 24`).

* `grpChk n bad G : Bool` — two packed products for the label `V = span B`
  (`H·[B;E]ᵀ = [0 | I]`, `D·[H;B]ᵀ = [0 | I]`) and two per entry
  (`U·[H;EU]ᵀ = [0 | I]`, `R·[H;U;R]ᵀ = [0 | 0 | I]`), plus row range checks.
* `grpChk_sound`: if `grpChk n (BADf n) G = true` then `V` is nondegenerate of dimension `kV`,
  and for every entry `(U, kU)`, `PairOK n U kU V kV`: `span U ≤ span V`, `dim span U = kU`,
  `span U` nondegenerate, and `span U = span V` or some `w ∈ span V` has `w·w = 1`, `w ⊥ U`
  (i.e. `NetComplexP8.Up (span U) (span V)` with `Fd = kV - kU`; see `R6ChkCxBridge`).
-/

namespace R6Chk

open Matrix Module

/-! ## Stream decoding -/

theorem tk_lt (s k : ℕ) : tk s k < 2 ^ (32 * k) := by
  rw [tk, nland, nsub, nshl, nmul, Nat.one_shiftLeft, Nat.and_two_pow_sub_one_eq_mod]
  exact Nat.mod_lt _ (by positivity)

theorem pow768 {k : ℕ} (hk : k ≤ 24) {X : ℕ} (h : X < 2 ^ (32 * k)) : X < 2 ^ 768 :=
  lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num) (by omega))

theorem okR_spec {n bad X : ℕ} (hbad : bad = BADf n) (hn : n ≤ 32) (h : okR bad X = true)
    {i : ℕ} (hi : i < 48) : row X i < 2 ^ n := by
  rw [okR, nland, Nat.beq_eq, hbad] at h
  exact row_lt_of_bad hn h hi

