-- title:
--   Complete antipodally equivariant Hamiltonian flow
-- statement:
--   Let $0<\mu<1$ and $-c<h_1(\mu)$. There exists a complete continuous real flow $\varphi$ on $\Sigma_{\mu,c}$ generated by the Hamiltonian vector field of $K_{\mu,c}$. It commutes with the antipodal deck transformation. In addition to the generator identity at time zero, every orbit curve satisfies
--
--   $$
--   \frac{d}{d\tau}\varphi_\tau(s)\bigg|_{\tau=t}
--   =X_{K_{\mu,c}}\bigl(\varphi_t(s)\bigr)
--   $$
--
--   for every state $s$ and every $t\in\mathbb R$. This isolates standard flow existence, deck equivariance, and propagation of the generator identity from the open global-section assertion.
-- source:
--   Joung--van Koert, equation (2.2) and Proposition 2.4, https://arxiv.org/abs/2407.19159v3, together with standard smooth-ODE completeness on the compact regular component.

import Definitions.Def_BirkhoffGlobalSection

namespace BirkhoffGlobalSection

/-- The regularized Hamiltonian vector field has a complete flow on the compact
subcritical component, and its generator identity holds at every time. -/
theorem leviCivita_flow_exists (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c) :
    ∃ φ : Flow ℝ (LeftEnergyState μ c),
      IsLeviCivitaHamiltonianFlow μ c φ ∧
      IsAntipodallyEquivariantFlow μ c φ ∧
      ∀ t : ℝ, ∀ s : LeftEnergyState μ c,
        HasDerivAt
          (fun τ : ℝ => ((φ τ s : LeftEnergyState μ c) : Phase))
          (hamiltonianVectorField (leviCivitaHamiltonian μ c)
            ((φ t s : LeftEnergyState μ c) : Phase)) t := by sorry

end BirkhoffGlobalSection
