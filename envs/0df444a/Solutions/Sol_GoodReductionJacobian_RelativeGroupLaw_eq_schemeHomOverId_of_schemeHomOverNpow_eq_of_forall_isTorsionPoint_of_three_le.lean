theorem exists_tateSeq_val_eq (L : RelativeGroupLaw K f) (p : ℕ)
    (hdiv : Function.Surjective (L.nsmul (𝟙 (Spec (CommRingCat.of K))) p))
    (j : ℕ) (z : Pt f) (hz : L.nsmul _ (p ^ j) z = L.one _) :
    ∃ x : TateSeq L p, x.1 j = z := by
  classical
  letI := L.pointGroup (𝟙 (Spec (CommRingCat.of K)))

  choose root hroot using hdiv

  let s : ℕ → Pt f := fun i => Nat.rec z (fun _ w => root w) i
  have hs0 : s 0 = z := rfl
  have hs : ∀ i, L.nsmul _ p (s (i + 1)) = s i := fun i => hroot (s i)

  let x : ℕ → Pt f := fun i => if i ≤ j then L.nsmul _ (p ^ (j - i)) z else s (i - j)
  have hxle : ∀ i, i ≤ j → x i = L.nsmul _ (p ^ (j - i)) z := fun i hi => if_pos hi
  have hxgt : ∀ i, j < i → x i = s (i - j) := fun i hi => if_neg (not_le.mpr hi)
  refine ⟨⟨x, ?_, fun i => ?_⟩, ?_⟩
  · rw [hxle 0 (Nat.zero_le _), Nat.sub_zero]; exact hz
  · rcases lt_trichotomy (i + 1) (j + 1) with h | h | h
    ·
      have hi1 : i + 1 ≤ j := Nat.lt_succ_iff.mp h
      have hi : i ≤ j := Nat.le_of_succ_le hi1
      rw [hxle _ hi1, hxle _ hi, nsmul_eq_pow, nsmul_eq_pow, nsmul_eq_pow]
      change (z ^ p ^ (j - (i + 1))) ^ p = z ^ p ^ (j - i)
      rw [← pow_mul, ← pow_succ]
      congr 2
      omega
    ·
      have hij : i = j := by omega
      subst hij
      rw [hxgt _ (Nat.lt_add_one _), hxle _ le_rfl, Nat.add_sub_cancel_left, Nat.sub_self, pow_zero,
        L.nsmul_one_apply]
      exact hs 0
    ·
      have hji : j < i := by omega
      rw [hxgt _ (by omega), hxgt _ hji]
      have : i + 1 - j = (i - j) + 1 := by omega
      rw [this]
      exact hs _
  · change x j = z
    rw [hxle _ le_rfl, Nat.sub_self, pow_zero, L.nsmul_one_apply]

theorem connectedSpace_of_bundle (hA : AbelianSchemePropertyBundle K f) : ConnectedSpace A := by
  have hcf := hA.connectedFibres (default : ↥(Spec (CommRingCat.of K)))
  have huniv : f.base ⁻¹' {(default : ↥(Spec (CommRingCat.of K)))} = Set.univ := by
    ext a
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_univ, iff_true]
    exact Subsingleton.elim _ _
  rw [huniv] at hcf
  exact connectedSpace_iff_univ.mpr hcf

end P2mKcSerreAV
