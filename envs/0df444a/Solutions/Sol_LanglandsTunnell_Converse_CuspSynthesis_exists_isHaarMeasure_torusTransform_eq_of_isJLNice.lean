  refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only [t0084 v z g, map_mul]
  · exact mul_ne_zero hc h1
  · rw [h2]
  · exact mul_le_mul' le_rfl h3
  · rw [mul_assoc]; exact mul_le_mul' le_rfl h4

