theorem R6.crude_guard_single (E : ℝ) (s m : ℕ) (d β : ℝ) (A : ℕ → ℝ) (hm : 2 ≤ m) (hs : 2 ≤ s)
    (hβ : 0 ≤ β ∧ β ≤ 1) (hd : 1 ≤ d) (hE : 0 ≤ E)
    (hrec : ∀ e : ℕ, d ^ β ≤ e → A e ≤ E + s * A ((m - 1) * e / m))
    (hleaf : ∀ e : ℕ, (e : ℝ) < d ^ β → A e ≤ 8 * d ^ β) :
    ∀ e : ℕ, (e : ℝ) ≤ d → A e ≤ 2 * (E + 8 * d ^ β) * (s : ℝ) ^ (1 + m * (1 - β) * Real.log d) := by sorry
