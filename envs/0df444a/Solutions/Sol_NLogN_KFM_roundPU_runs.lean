  have m3 := combC_runs (I := I) (iprog := iprog) false s2 x h Δ (st.G pP1) (st.G pP2) LR
    (by simp +decide [hs2, hs1]) (by simp +decide [hs2, hs1]) (by simp +decide [hs2, hs1, hR'])
  refine (m1.seq (m2.seq m3)).mono' ?_ ?_
  · simp only [hs2, hs1, if_false, Bool.false_eq_true]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
