theorem πR_none {c r KG B BJ D2 : ℤ} {i : Fin HS} (h : i.val < 50 ∨ 55 < i.val) :
    πR c r KG B BJ D2 i = none := by
  unfold πR
  simp only [pmOf]
  split_ifs with h1 h2 h3 h4 h5 h6 <;> first | rfl | (subst_vars; revert h; decide)

theorem πR_some {c r KG B BJ D2 : ℤ} {i : Fin HS} {v : ℤ} (h : πR c r KG B BJ D2 i = some v) :
    50 ≤ i.val ∧ i.val ≤ 55 := by
  by_contra hc
  rw [πR_none (by omega)] at h
  simp at h

/-- The parameters sit in the frame. -/
theorem PV_encK {π : PMap} {s : IState HS} (hs : PV π s) {f : Fin HS → List ℤ}
    (hf : ∀ i v, π i = some v → f i = []) : PV π (NLogN.KIL.encK s f) := by
  intro i v hv
  obtain ⟨L, hL⟩ := hs i v hv
  exact ⟨L, by simp [hf i v hv, hL]⟩

