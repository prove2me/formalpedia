private def toRealGL : GL (Fin 2) w.Completion →* GL (Fin 2) ℝ :=
  (glEquivOfRingEquiv (ringEquivRealOfIsReal hw)).toMonoidHom

private def ofRealGL : GL (Fin 2) ℝ →* GL (Fin 2) w.Completion :=
  (glEquivOfRingEquiv (ringEquivRealOfIsReal hw)).symm.toMonoidHom

@[scoped simp] private theorem toRealGL_apply (k : GL (Fin 2) w.Completion) (i j : Fin 2) :
    ((toRealGL hw k : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ) i j
      = ringEquivRealOfIsReal hw ((k : Matrix (Fin 2) (Fin 2) w.Completion) i j) := rfl

@[scoped simp] private theorem ofRealGL_apply (k : GL (Fin 2) ℝ) (i j : Fin 2) :
    ((ofRealGL hw k : GL (Fin 2) w.Completion) : Matrix (Fin 2) (Fin 2) w.Completion) i j
      = (ringEquivRealOfIsReal hw).symm ((k : Matrix (Fin 2) (Fin 2) ℝ) i j) := rfl

@[scoped simp] private theorem ofRealGL_toRealGL (k : GL (Fin 2) w.Completion) : ofRealGL hw (toRealGL hw k) = k :=
  (glEquivOfRingEquiv (ringEquivRealOfIsReal hw)).symm_apply_apply k

@[scoped simp] private theorem toRealGL_ofRealGL (k : GL (Fin 2) ℝ) : toRealGL hw (ofRealGL hw k) = k :=
  (glEquivOfRingEquiv (ringEquivRealOfIsReal hw)).apply_symm_apply k

private theorem continuous_toRealGL : Continuous (toRealGL hw) :=
  (Continuous.generalLinearGroup_map (n := Fin 2) (f := (ringEquivRealOfIsReal hw).toRingHom)
    (continuous_ringEquiv hw)).congr fun _ => rfl

private theorem continuous_ofRealGL : Continuous (ofRealGL hw) :=
  (Continuous.generalLinearGroup_map (n := Fin 2) (f := (ringEquivRealOfIsReal hw).symm.toRingHom)
    (continuous_ringEquiv_symm hw)).congr fun _ => rfl

private theorem toRealGL_unipotentGL2 (c : w.Completion) :
    toRealGL hw (unipotentGL2 c) = unipotentGL2 (ringEquivRealOfIsReal hw c) := by
  apply Units.ext
  ext i j
  rw [toRealGL_apply, unipotentGL2_coe, unipotentGL2_coe]
  fin_cases i <;> fin_cases j <;> simp

private theorem toRealGL_gl2Weyl : toRealGL hw (gl2Weyl : GL (Fin 2) w.Completion) = gl2Weyl := by
  apply Units.ext
  ext i j
  rw [toRealGL_apply, gl2Weyl_val, gl2Weyl_val]
  fin_cases i <;> fin_cases j <;> simp

private theorem det_toRealGL_ne_zero (k : GL (Fin 2) w.Completion) :
    ((toRealGL hw k : GL (Fin 2) ℝ) : Matrix (Fin 2) (Fin 2) ℝ).det ≠ 0 :=
  Matrix.GeneralLinearGroup.det_ne_zero _

private def rotW (θ : ℝ) : GL (Fin 2) w.Completion := ofRealGL hw (RealIwasawa.rotGL θ)

private theorem rotW_apply (θ : ℝ) (i j : Fin 2) :
    ((rotW hw θ : GL (Fin 2) w.Completion) : Matrix (Fin 2) (Fin 2) w.Completion) i j
      = (ringEquivRealOfIsReal hw).symm (RealIwasawa.rot θ i j) := rfl

private theorem rotW_zero : rotW hw 0 = 1 := by
  rw [rotW, RealIwasawa.rotGL_zero, map_one]

private theorem rotW_add (s t : ℝ) : rotW hw (s + t) = rotW hw s * rotW hw t := by
  rw [rotW, RealIwasawa.rotGL_add, map_mul]
  rfl

private theorem continuous_rotW : Continuous (rotW hw) :=
  (continuous_ofRealGL hw).comp RealIwasawa.continuous_rotGL

private theorem rotGL_periodic : Function.Periodic RealIwasawa.rotGL (2 * Real.pi) := fun θ => by
  apply Units.ext
  ext i j
  rw [RealIwasawa.coe_rotGL, RealIwasawa.coe_rotGL]
  fin_cases i <;> fin_cases j <;>
    simp [Real.cos_add_two_pi, Real.sin_add_two_pi]

private theorem rotW_periodic : Function.Periodic (rotW hw) (2 * Real.pi) := fun θ => by
  show ofRealGL hw (RealIwasawa.rotGL (θ + 2 * Real.pi)) = ofRealGL hw (RealIwasawa.rotGL θ)
  rw [rotGL_periodic θ]

private theorem isRowIsometry_rotW (θ : ℝ) : IsRowIsometry (rotW hw θ) := by
  constructor
  · have hdet : ((rotW hw θ : GL (Fin 2) w.Completion) : Matrix (Fin 2) (Fin 2) w.Completion).det
        = (ringEquivRealOfIsReal hw).symm.toRingHom (RealIwasawa.rot θ).det := by
      rw [RingHom.map_det]
      rfl
    rw [hdet]
    show ‖(ringEquivRealOfIsReal hw).symm (RealIwasawa.rot θ).det‖ = 1
    rw [norm_ringEquiv_symm, RealIwasawa.norm_det_rot]
  · intro x y
    obtain ⟨x', rfl⟩ : ∃ x', (ringEquivRealOfIsReal hw).symm x' = x :=
      ⟨ringEquivRealOfIsReal hw x, RingEquiv.symm_apply_apply _ _⟩
    obtain ⟨y', rfl⟩ : ∃ y', (ringEquivRealOfIsReal hw).symm y' = y :=
      ⟨ringEquivRealOfIsReal hw y, RingEquiv.symm_apply_apply _ _⟩
    simp only [rotW_apply, ← map_mul, ← map_add, norm_ringEquiv_symm]
    exact RealIwasawa.norm_row_sq_rot θ x' y'

private theorem rotW_mem_rowIsometrySubgroup (θ : ℝ) : rotW hw θ ∈ rowIsometrySubgroup w.Completion :=
  isRowIsometry_rotW hw θ

private theorem ofRealGL_borelGL_mem {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    ofRealGL hw (RealIwasawa.borelGL hg u) ∈ borelSubgroup w.Completion := by
  show ((ofRealGL hw (RealIwasawa.borelGL hg u) : GL (Fin 2) w.Completion) :
      Matrix (Fin 2) (Fin 2) w.Completion) 1 0 = 0
  rw [ofRealGL_apply, RealIwasawa.coe_borelGL, RealIwasawa.borel_apply_10, map_zero]

private def borelFstUnit {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) : ℝˣ :=
  Units.mk0 (-gm.det / RealIwasawa.rad gm u)
    (div_ne_zero (neg_ne_zero.2 hg) (RealIwasawa.rad_pos hg u).ne')

private def borelSndUnit {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) : ℝˣ :=
  Units.mk0 (RealIwasawa.rad gm u) (RealIwasawa.rad_pos hg u).ne'

@[scoped simp] private theorem coe_borelFstUnit {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    (borelFstUnit hg u : ℝ) = -gm.det / RealIwasawa.rad gm u := rfl

@[scoped simp] private theorem coe_borelSndUnit {gm : Matrix (Fin 2) (Fin 2) ℝ} (hg : gm.det ≠ 0) (u : ℝ) :
    (borelSndUnit hg u : ℝ) = RealIwasawa.rad gm u := rfl

end Transport
