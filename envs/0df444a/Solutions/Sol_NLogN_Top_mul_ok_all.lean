    (((s.upd T5 (.int ((x : ℤ) / 2 ^ i) :: s.G T5)).upd C (.int (i : ℤ) :: s.G C)).upd T7
      (.int 2 :: s.G T7))
  have h1 : IRuns I iprog (.seq (.op (.dup X T5)) (.seq (.op (.const C 0)) (.op (.const T7 2)))) s
      (ss 0) (400 * (ℓ + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hX, hXC, hX5, hX7, hC5, hC7, hC5', hC7', hX5', hX7', ss]
    try refine ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := dupCost_le (zsz (x : ℤ)); have := zsz_two
    simp only [zsz_zero] at *
    omega
  have h2 := IRuns.loop' (I := I) (iprog := iprog) (i := T5) (f := fun c => c != .zero)
    (p := .seq (.op (.split T5 T7 T6)) (.seq (.op (.drop T6))
      (.seq (.op (.const T6 1)) (.op (.add T6 C C))))) ss (1000 * (b + 2)) ℓ
    (by intro i hi; simp +decide [ss, hC5', hC7']; exact blen_div_ne x i hi)
    (by simp +decide [ss, hC5', hC7']; exact blen_div_zero x)
    (by
      intro i hi
      apply IRuns.of_runsTo 0
      have hnn : (0 : ℤ) ≤ (x : ℤ) / 2 ^ i := Int.ediv_nonneg (by omega) (by positivity)
      have hz : zsz ((x : ℤ) / 2 ^ i % 2) ≤ 2 :=
        zsz_le_of_lt (by
          have h0 := Int.emod_nonneg ((x : ℤ) / 2 ^ i) (b := 2) (by norm_num)
          have h1 := Int.emod_lt_of_pos ((x : ℤ) / 2 ^ i) (b := 2) (by norm_num)
          omega)
      have hzi : zsz (i : ℤ) ≤ b := zsz_natCast_le hi.le
      have ediv : (x : ℤ) / 2 ^ i / 2 = (x : ℤ) / 2 ^ (i + 1) := by
        rw [Int.ediv_ediv_of_nonneg (by positivity), ← pow_succ]
      have e1 : (1 + (i : ℤ)) = ((i + 1 : ℕ) : ℤ) := by push_cast; ring
      simp +decide [IStmt.run, IOp.run, ss, hC5, hC6, hC7, hC5', hC6', hC7',
        sg_nonneg_div2 hnn, sg_nonneg_mod2 hnn, zsz_one, ediv, e1]
      constructor
      · ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))
      · have := splitCost_le 1
        have := addIntCost_mono (show 1 + zsz (i : ℤ) ≤ b + 1 by omega)
        have := addIntCost_le (b + 1)
        omega)
  have hz0 : (x : ℤ) / 2 ^ ℓ = 0 := blen_div_zero x
  have h3 : IRuns I iprog (.seq (.op (.drop T5)) (.op (.drop T7))) (ss ℓ)
      (s.upd C (.int (ℓ : ℤ) :: s.G C)) 20 := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, ss, hz0, zsz_zero, hC5, hC7, hC5', hC7']
    try refine ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have := zsz_two
    omega
  refine (IRuns.seq h1 (IRuns.seq h2 h3)).mono ?_
  nlinarith

end blen

end NLogN

