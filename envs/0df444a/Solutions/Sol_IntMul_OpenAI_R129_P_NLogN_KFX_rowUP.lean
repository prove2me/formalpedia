theorem σC_none (s0 q s1 s2 b r2 fm k2 m a : ℤ) {i : Fin HS} (h : 11 ≤ i.val) :
    σC s0 q s1 s2 b r2 fm k2 m a i = none := by
  simp only [σC]
  split_ifs <;> subst_vars <;> first | rfl | (exfalso; revert h; decide)

theorem sclean_σC (s0 q s1 s2 b r2 fm k2 m a : ℤ) : SClean (σC s0 q s1 s2 b r2 fm k2 m a) := by
  intro i hi
  have : i.val ≤ 10 := by
    by_contra hc
    rw [σC_none s0 q s1 s2 b r2 fm k2 m a (by omega)] at hi
    simp at hi
  exact notMem_zX (by omega)

theorem noW_corrRSU (s0 q s1 s2 b r2 fm k2 m a : ℤ) : NoW (σC s0 q s1 s2 b r2 fm k2 m a) corrRSU := by
  intro i hi
  have : ∀ j ∈ corrRSU.writes, j.val = 0 ∨ 11 ≤ j.val := by decide +kernel
  rcases this i hi with h | h
  · have : i = 0 := Fin.ext h
    subst this; rfl
  · exact σC_none _ _ _ _ _ _ _ _ _ _ h

theorem fok_corrRSU : fok corrRSU = true := by decide +kernel

theorem offE_subC (s0 q s1 s2 b r2 fm k2 m a bb : ℤ) :
    Ex.sub (σC s0 q s1 s2 b r2 fm k2 m a) (offE bb) = offE bb := by
  unfold offE; split_ifs <;> rfl

theorem t0E_subC (s0 q s1 s2 b r2 fm k2 m a : ℤ) :
    Ex.sub (σC s0 q s1 s2 b r2 fm k2 m a) t0E = t0E := rfl

theorem σC_mem {s0 q s1 s2 b r2 fm k2 m a : ℤ} {i : Fin HS} {v : ℤ}
    (hv : σC s0 q s1 s2 b r2 fm k2 m a i = some v) :
    (i, v) ∈ [((1 : Fin HS), s0), (2, q), (3, s1), (4, s2), (5, b), (6, r2), (7, fm), (8, k2),
      (9, m), (10, a)] := by
  simp only [σC] at hv
  split_ifs at hv <;> cases hv <;> subst_vars <;> simp

theorem corrRSU_sub (K ρ f : ℕ) (g : Geo) (hQe : g.Q = 2 ^ (f * K)) (A : ℕ) :
    RS.sub (σCg K ρ f g A) corrRSU = corrRS K ρ f g A := by
  have hQ : ((g.Q : ℕ) : ℤ) = (2 : ℤ) ^ (f * K) := by rw [hQe]; push_cast; rfl
  simp only [σCg, corrRSU, p1ProgU, p1BU, keyProgU, progLU, lines, lineRU, t0RU, segStepU,
    segLoopU, segBodyU, gcEU, keyEU, brBU, badBU, goodBU, radixProgU, passBU, entLoopU, entBU,
    bucketU, p3ProgU, p3BU, NLogN.mvK, RS.sub, Ex.sub, offE_subC, t0E_subC]
  simp only [corrRS, p1Prog, NLogN.KFL.p1B, keyProg, progL, lines, lineR,
    t0R, segStep, segLoop, segBody, gcE, keyE, NLogN.KFL.brB, badB, goodB, radixProg, NLogN.KFL.passB, entLoop, entB,
    bucket, p3Prog, NLogN.KFL.p3B, NLogN.mvK, Geo.recG_Q, hQ]
  all_goals (repeat' constructor)

theorem aux_k2 {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) : a * (b + a + 5) ≤ 5 * ((a + 1) * (b + a + 1)) := by
  nlinarith [mul_nonneg ha hb, sq_nonneg a]

theorem aux_k1 {a : ℝ} (ha : 0 ≤ a) : (a + 5) ^ 3 ≤ 125 * (a + 1) ^ 3 := by
  have : a + 5 ≤ 5 * (a + 1) := by linarith
  calc (a + 5) ^ 3 ≤ (5 * (a + 1)) ^ 3 := pow_le_pow_left₀ (by linarith) this 3
    _ = 125 * (a + 1) ^ 3 := by ring

theorem aux_bb {b : ℝ} (hb : 0 ≤ b) : 1 ≤ (b + 2) ^ 2 ∧ 2 * b + 2 ≤ (b + 2) ^ 2 :=
  ⟨by nlinarith, by nlinarith⟩

/-- **The correction, register-driven.** -/
theorem corrU_spec :
    ∃ Kc : ℝ, 0 < Kc ∧
      ∀ (K ρ f : ℕ), 6 ≤ K → ρ < K → 1 ≤ f →
      ∀ (g : Geo), g.Pos → g.Q = 2 ^ (f * K) →
