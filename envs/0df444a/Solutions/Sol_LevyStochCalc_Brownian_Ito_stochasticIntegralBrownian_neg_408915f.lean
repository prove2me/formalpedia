      (‖H ω s‖₊ : ℝ≥0∞) ^ 2 ∂volume ∂P < ⊤)
    (hmn : Measurable (Function.uncurry fun ω s => -H ω s))
    (hpn : LevyStochCalc.Probability.ProgressivelyMeasurable ℱ fun ω s => -H ω s)
