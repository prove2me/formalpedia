/-! # Fields depending only on `(x₁, x₂) = (r, θ)` in four dimensions

Stationary axisymmetric metrics (Schwarzschild, Kerr, Minkowski spherical, in every coordinate
system of release 0.1 except Cartesian) have components that depend only on `r = x₁` and
`θ = x₂`. `liftRT F` is the field `x ↦ F (x₁) (x₂)`; its partial derivatives reduce to ordinary
one-variable derivatives of `F`.
-/

namespace ExactVacuumAtlas

@[simp] theorem liftRT_apply (F : ℝ → ℝ → ℝ) (x : Pt 4) : liftRT F x = F (x 1) (x 2) := rfl

theorem pd_liftRT_one (F : ℝ → ℝ → ℝ) (y : Pt 4) :
    pd 1 (liftRT F) y = deriv (fun u => F u (y 2)) (y 1) := by
  simp [pd, liftRT, Function.update_apply]

end ExactVacuumAtlas

