open AlgebraicCurve ModularCurve

theorem ModularCurve.JZero.divisible (N : ℕ) [NeZero N] :
    ∀ m : ℕ, m ≠ 0 → ∀ x : JZero N, ∃ y : JZero N, m • y = x := by sorry
