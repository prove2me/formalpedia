    rw [hX]; nlinarith
  have e1 : (n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 = (n.size + 1) * X := by rw [hX]; ring
  have e2 : (tst.size + 6) * 10 ^ 7 * (B + 2) ^ 2 + 4 * 10 ^ 7 * (B + 2) ^ 2 = (tst.size + 10) * X := by
    rw [hX]; ring
  have e3 : (N + 1) * (tst.size + n.size + 12) * 10 ^ 7 * (B + 2) ^ 2 =
      (N + 1) * (tst.size + n.size + 12) * X := by rw [hX]; ring
  have e4 : 2 * 10 ^ 7 * (B + 2) ^ 2 = 2 * X := by rw [hX]; ring
  rw [e1, e2] at c2
  rw [e4] at c1
  rw [e3]
  nlinarith [Nat.zero_le (N * tst.size * X), Nat.zero_le (N * n.size * X), Nat.zero_le (N * X),
    Nat.zero_le (tst.size * X), Nat.zero_le (n.size * X)]
end
