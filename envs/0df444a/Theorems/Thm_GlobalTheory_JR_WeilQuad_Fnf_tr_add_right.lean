variable {F E : Type} [NontriviallyNormedField F] [NontriviallyNormedField E] [NormedAlgebra F E] [StarRing E]

theorem GlobalTheory.JR.WeilQuad.Fnf.tr_add_right (A : Et F E) (a b b' : A.L) :
    Algebra.trace A.K A.L (star a * (b + b')) =
      Algebra.trace A.K A.L (star a * b) + Algebra.trace A.K A.L (star a * b') := by sorry
