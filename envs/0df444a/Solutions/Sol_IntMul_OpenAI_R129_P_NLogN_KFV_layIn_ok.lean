  rw [List.mem_range] at hk
  have hx : (xs1 D ℓ K long).getD k ([], [], []) = ([], topS D ℓ long ⟨k, hk⟩,
      restA D ℓ K ⟨k, hk⟩ ++ loS D ℓ K 0 ⟨k, hk⟩) := by
    rw [List.getD_eq_getElem _ _ (by rw [hl]; exact hk)]; simp [xs1]
  have h1 : ((xs1 D ℓ K long).take k).map tL = (List.range k).map (fbk D long) := by
    have : (xs1 D ℓ K long).map tL = (List.range D).map (fbk D long) := by
      unfold xs1; rw [List.map_map]
      have := map_finRange_fbk D long (fun x => x)
      simp only [Function.comp_def] at this ⊢
      rw [← this]; apply List.map_congr_left; intro i _; simp [tL, length_topS]
    rw [List.map_take, this, ← List.map_take, List.take_range, min_eq_left hk.le]
  have h2 : ((xs1 D ℓ K long).take k).map uvL = List.replicate k (ℓ - 1) := by
    rw [List.map_take]
    apply List.eq_replicate_iff.2
    refine ⟨by simp [hl, hk.le], fun x hx => ?_⟩
    obtain ⟨y, hy', rfl⟩ := List.mem_map.1 (List.mem_of_mem_take hx)
    simp only [xs1, List.mem_map, List.mem_finRange, true_and] at hy'
    obtain ⟨i, rfl⟩ := hy'
    simp [uvL, length_restA, length_loS]; have := hbq ℓ K hK hℓ; omega
  rw [hx, h1, h2, List.sum_replicate]
  simp only [tL, length_topS, smul_eq_mul, List.length_nil, zero_add, add_zero, rkS]
  try simp only [fbk, hk, dif_pos]
  all_goals ring_nf

theorem tL_xs1 (x) (hx : x ∈ xs1 D ℓ K long) : tL x ≤ 1 := by
  simp only [xs1, List.mem_map, List.mem_finRange, true_and] at hx
  obtain ⟨i, rfl⟩ := hx
  simp only [tL, length_topS, fbk, i.2, dif_pos]
  first | done | (split_ifs <;> simp)

theorem pre2_length (u : ℕ) : (pre2 D ℓ K long u).length = nLong D long + u * D := by
  simp [pre2, nLong, List.length_flatMap, List.sum_replicate]

theorem ops2_u_eq (hK : 0 < K) (hℓ : 1 ≤ ℓ) (u : ℕ) (hu : u < bb ℓ K) :
    genOps (pre2 D ℓ K long u).length 0 (xs2 D ℓ K u) =
      (List.range D).map fun i => LOp.mv (nLong D long + (u * D + i))
        (nLong D long + (u * D + i) + dl2 D ℓ K (u * D + i)) := by
  have hl : (xs2 D ℓ K u).length = D := by simp [xs2]
  have e : genOps (pre2 D ℓ K long u).length 0 (xs2 D ℓ K u) =
      genOps1 (pre2 D ℓ K long u).length 0 (xs2 D ℓ K u) := by
    have : ∀ (xs : List (List ℕ × List ℕ × List ℕ)) (c d : ℕ), (∀ x ∈ xs, tL x = 1) →
        genOps c d xs = genOps1 c d xs := by
      intro xs
      induction xs with
      | nil => intro _ _ _; rfl
      | cons x xs ih =>
        intro c d h
        obtain ⟨U, T, V⟩ := x
        have hT : T.length = 1 := h (U, T, V) (by simp)
        simp only [genOps, genOps1, hT]
        rw [ih _ _ (fun y hy => h y (by simp [hy]))]
        simp [bmOps]
    exact this _ _ _ (by
      intro x hx; simp only [xs2, List.mem_map, List.mem_finRange, true_and] at hx
      obtain ⟨i, rfl⟩ := hx; simp [tL])
  rw [e, genOps1_eq, hl, pre2_length]
  apply List.map_congr_left
  intro i hi
  rw [List.mem_range] at hi
  have hx : (xs2 D ℓ K u).getD i ([], [], []) = (restA D ℓ K ⟨i, hi⟩,
      [nm D ⟨i, hi⟩ (bb ℓ K - 1 - u)], loS D ℓ K (u + 1) ⟨i, hi⟩) := by
    rw [List.getD_eq_getElem _ _ (by rw [hl]; exact hi)]; simp [xs2]
  have h1 : ((xs2 D ℓ K u).take i).map tL = List.replicate i 1 := by
    rw [List.map_take]
    apply List.eq_replicate_iff.2
    refine ⟨by simp [hl, hi.le], fun x hx => ?_⟩
    obtain ⟨y, hy', rfl⟩ := List.mem_map.1 (List.mem_of_mem_take hx)
    simp only [xs2, List.mem_map, List.mem_finRange, true_and] at hy'
    obtain ⟨j, rfl⟩ := hy'
    simp [tL]
  have h2 : ((xs2 D ℓ K u).take i).map uvL = List.replicate i (qq ℓ K * K + (bb ℓ K - 1 - u)) := by
    rw [List.map_take]
    apply List.eq_replicate_iff.2
    refine ⟨by simp [hl, hi.le], fun x hx => ?_⟩
    obtain ⟨y, hy', rfl⟩ := List.mem_map.1 (List.mem_of_mem_take hx)
    simp only [xs2, List.mem_map, List.mem_finRange, true_and] at hy'
    obtain ⟨j, rfl⟩ := hy'
    simp [uvL, length_restA, length_loS]; omega
  have hD : 0 < D := Nat.pos_of_ne_zero (NeZero.ne D)
  have e1 : (u * D + i) % D = i := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hi]
  have e2 : (u * D + i) / D = u := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hD, Nat.div_eq_of_lt hi, zero_add]
  rw [hx, h1, h2, List.sum_replicate, List.sum_replicate]
  simp only [tL, List.length_singleton, smul_eq_mul, one_mul, mul_one, dl2, e1, e2,
    length_restA, zero_add]
  congr 1 <;> ring

theorem moves12_eq (hK : 0 < K) (hℓ : 1 ≤ ℓ) (a : List ℕ) :
    applyN (ops1 D ℓ long ++ ops2 D ℓ K long) a = applyN (moves12 D ℓ K long) a := by
  unfold moves12
  rw [applyN_append, applyN_append, ← ops1_eq D ℓ K long hK hℓ,
    applyN_genOps1 _ _ _ _ (tL_xs1 D ℓ K long)]
  have h2 : ops2 D ℓ K long = (List.range (bb ℓ K)).flatMap
      (fun u => genOps (pre2 D ℓ K long u).length 0 (xs2 D ℓ K u)) := by
    unfold ops2
    rw [← range_mul_map (fun k => LOp.mv (nLong D long + k) (nLong D long + k + dl2 D ℓ K k)) D]
    exact List.flatMap_congr (fun u hu => (ops2_u_eq D ℓ K long hK hℓ u (List.mem_range.1 hu)).symm)
  rw [h2]

/-- **The three phases take the row-major order to the paper's layout.** -/
theorem applyN_lay3 (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    applyN (ops1 D ℓ long ++ ops2 D ℓ K long ++ ops3 D ℓ K long) (initL D ℓ long) =
      tgtL D ℓ K long := by
  rw [applyN_append, moves12_eq D ℓ K long hK hℓ]
  have := applyN_layOps D ℓ K long hK hℓ
  unfold layOps at this
  rw [applyN_append] at this
  exact this

end Paper

theorem iterL_runArr {α : Type*} (n : ℕ) (d : α) (g : ℕ → List LOp) :
    ∀ (N : ℕ) (xs : List α),
      NLogN.KFV.iterL (fun k => Synth.runArr n d (g k)) N xs = Synth.runArr n d ((List.range N).flatMap g) xs
  | 0, xs => rfl
  | N + 1, xs => by
    rw [NLogN.KFV.iterL, iterL_runArr n d g N xs, List.range_succ, List.flatMap_append]
    simp [Synth.runArr, List.foldl_append]

end NLogN.KFV

end

