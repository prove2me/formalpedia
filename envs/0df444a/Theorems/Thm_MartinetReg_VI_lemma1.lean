-- title:
--   Lemme 1 — successive regularized iterates get closer: ‖xⁿ⁺¹ − xⁿ‖ → 0
-- statement:
--   Let $H$ be a real Hilbert space, $C\subseteq H$ convex, closed and bounded, $T:H\to H'$ monotone and hemicontinuous on $C$, and let $(x^n)$ be a sequence generated by the regularization algorithm (2) from $x^0\in C$. Then
--   $$
--   \lim_{n\to\infty}\|x^{n+1}-x^n\|=0 .
--   $$
--
--   This is the first of the two lemmas into which Martinet splits the proof of Théorème 1.
--
--   **Formalization Note.** No hypothesis "$M\neq\emptyset$" is added: the paper obtains a solution from §2.1 (here $C\neq\emptyset$ because $x^0\in C$). The standing hypotheses are bundled in `Standing T C`; the limit is `Tendsto … atTop (𝓝 0)`.
-- source:
--   Martinet, Régularisation d'inéquations variationnelles par approximations successives, R.I.R.O. 4(R-3) (1970), p. 155, Lemme 1

import Mathlib
import Definitions.Def_MartinetReg_VI_Setting

namespace MartinetReg.VI

open Filter Topology

/-- Lemme 1, p. 155: `lim_{n→∞} ‖xⁿ⁺¹ − xⁿ‖ = 0`. -/
theorem lemma1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (T : H → StrongDual ℝ H) (C : Set H) (hS : Standing T C)
    (x : ℕ → H) (hx : IsRegSeq T C x) :
    Tendsto (fun n => ‖x (n + 1) - x n‖) atTop (𝓝 0) := by sorry

end MartinetReg.VI
