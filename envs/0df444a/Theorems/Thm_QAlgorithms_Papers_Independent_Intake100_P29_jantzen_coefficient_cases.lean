-- title:
--   Support and complete signed formulas for Jantzen coefficients
-- statement:
--   Let $F$ be a field, let $n,r\ge1$, let $q\in F^\times$ with $q\ne1$, and fix integer charges $c_1,\ldots,c_r$, with $Q_a=q^{c_a}$. Let $e$ be the least $k\ge2$ with $1+q+\cdots+q^{k-1}=0$, or $\infty$ if there is none. For an $r$-multipartition $\lambda$ of $n$, each node $(i,j,a)$ has charged residue $j-i+c_a$ modulo $e$, interpreted as an integer when $e=\infty$. Residue multiplicities count nodes individually. The relation $\sim_J$ is the equivalence relation generated by nonzero coefficients $J_{\alpha\beta}$ in Definition 2.5, with intermediate multipartitions of the same size.
--
--   Write $p$ for the characteristic, with $p=\infty$ in characteristic zero, and define $\nu'_p(h)=p^{v_p(h)}$ for $h\ne0$ when $p$ is finite, and $\nu'_\infty(h)=1$. Let $\lambda,\mu$ be multipartitions of $n$. For $x=(i,j,a)\in[\lambda]$, write $r_x^\lambda$ for its rim hook, $h_x^\lambda=|r_x^\lambda|$ for its length, $f_x^\lambda=(\lambda_j^{(a)\prime},j,a)$ for its foot, and $\ell\ell(r_x^\lambda)=\lambda_j^{(a)\prime}-i$ for its leg length. Let $\lambda\triangleright\mu$ denote strict dominance.
--
--   The coefficient can be nonzero only in one of the following two situations. In the first, two genuinely changed components have indices $a<b$, there are roots $x=(i,j,a)\in[\lambda]$ and $y=(k,l,b)\in[\mu]$ with equal foot residues, and $[\lambda]\setminus r_x^\lambda=[\mu]\setminus r_y^\mu$. In the second, $e$ is finite, only one component $a$ changes, and there are roots $x=(i,j,a)$, $z=(i,m,a)$ in $[\lambda]$, with $m<j$ and $e\mid h_z^\lambda$, such that $\mu$ is obtained by wrapping a hook of length $h_x^\lambda$ onto $\lambda\setminus r_x^\lambda$, with its hand in column $m$. Write $y$ for the root of that wrapped hook.
--
--   For these configurations in the strict dominance orientation, respectively,
--
--   $$
--   J_{\lambda\mu}=(-1)^{\ell\ell(r_x^\lambda)+\ell\ell(r_y^\mu)}
--   \nu'_p\!\left(n(a-b)+j-\lambda_j^{(a)\prime}-l+\mu_l^{(b)\prime}\right),
--   $$
--
--   and
--
--   $$
--   J_{\lambda\mu}=(-1)^{\ell\ell(r_x^\lambda)+\ell\ell(r_y^\mu)}
--   \begin{cases}
--   \nu'_p(h_z^\lambda),&e\nmid h_x^\lambda,\\
--   \nu'_p(h_z^\lambda)-\nu'_p(h_x^\lambda),&e\mid h_x^\lambda.
--   \end{cases}
--   $$
--
--   In all other support cases $J_{\lambda\mu}=0$; Definition 2.5 also sets it to zero outside strict dominance. The support condition is necessary, and the second branch may cancel to zero. These formulas describe the actual coefficient rather than asserting nonvanishing for every geometric pattern.
--
--   **Formalization Note** The printed conjugate-part subscripts $i,k$ in part (a) are corrected to the foot columns $j,l$, as uniquely specified by the foot definition on PDF p. 6. This correction requires independent moderation.
-- source:
--   Blocks of cyclotomic Hecke algebras, arXiv:math/0607451v4, PDF p. 12, Proposition 3.6

import Definitions.Def_QAlgorithms_Papers_Independent_Intake100_P29

namespace QAlgorithms.Papers.Independent.Intake100.P29

noncomputable section

open scoped BigOperators Classical

variable {F : Type} [Field F]

/-- Proposition 3.6, PDF pp. 12--13, all cases. The printed foot indices i,k
in (a) are changed to columns j,l, uniquely fixed by p. 6. Part (b) divides
h_(i,m,a), not h_x. Branch formulas retain strict dominance. -/
theorem jantzen_coefficient_cases {r n : ℕ} (hr : 0 < r) (hn : 0 < n)
    (q : F) (hq : q ≠ 0) (hqOne : q ≠ 1) (c : Fin r → ℤ)
    (L M : Multipartition r) (hL : size L = n) (hM : size M = n) :
    let Q := fun a => q ^ c a
    let e := quantumCharacteristic q
    let J := jantzenCoefficient q Q L M
    (J ≠ 0 → (∃ x y, IntercomponentPattern q Q L M x y) ∨
      (∃ x z y, SingleComponentPattern e L M x z y)) ∧
    (∀ x y, strictlyDominates L M → IntercomponentPattern q Q L M x y →
      J = (-1 : ℤ) ^ (legLength L x + legLength M y) *
        primePowerMultiplicity (ringChar F)
          ((n : ℤ) * ((x.comp.val : ℤ) - y.comp.val) + x.col -
            column (L x.comp) x.col - y.col + column (M y.comp) y.col)) ∧
    (∀ x z y, strictlyDominates L M → SingleComponentPattern e L M x z y →
      J = singleComponentFormula (ringChar F) e L M x z y) ∧
    ((¬∃ x y, IntercomponentPattern q Q L M x y) →
      (¬∃ x z y, SingleComponentPattern e L M x z y) → J = 0) := by sorry

end

end QAlgorithms.Papers.Independent.Intake100.P29
