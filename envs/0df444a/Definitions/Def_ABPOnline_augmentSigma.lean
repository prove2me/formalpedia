-- title:
--   Completion of a $\sigma$-algebra by the null sets of a measure
-- statement:
--   Let $(\Omega,\mathcal F,\mathbb P)$ be a measure space and $\mathcal M$ a $\sigma$-algebra on $\Omega$. Its **completion** (augmentation) by $\mathbb P$ is the family of sets $A\in\mathcal F$ that coincide $\mathbb P$-almost everywhere with some $A'\in\mathcal M$:
--   $$
--   \overline{\mathcal M}^{\mathbb P}:=\{A\in\mathcal F:\ \exists A'\in\mathcal M,\ \mathbb P(A\,\triangle\,A')=0\}.
--   $$
--   It is a $\sigma$-algebra contained in $\mathcal F$. When $\mathcal M\subseteq\mathcal F$, it is the $\sigma$-algebra generated by $\mathcal M$ and the $\mathbb P$-null sets of $\mathcal F$.
--
--   It is used for the completed natural filtration of a Brownian motion and for the equality of $\sigma$-fields "after completion" in Lemma B.1 and Proposition 4.6.
--
--   **Formalization Note** Only sets of the ambient $\sigma$-algebra are kept, so the result is a sub-$\sigma$-algebra even when $\mathcal M$ is generated by maps that are only almost everywhere measurable.
-- source:
--   Jo, Lee, The Exact Online Threshold for the Asymmetric Binary Perceptron, arXiv:2609.02124 (artifact sha256 bd5e2bdb18a47b7e806191ae9b888a6e4e7e150a9bd50e541b7587007d07a7a2), §2.2, p.6 (PDF p.7) ('completed natural filtration'); Lemma B.1, p.33 (PDF p.34) ('after completion')

import Mathlib

set_option autoImplicit false
set_option warn.classDefReducibility false

open MeasureTheory

namespace ABPOnline

/-- The **completion** of a σ-algebra `m` by the null sets of a measure `P`
(arXiv:2609.02124, used for "completed natural filtration", §2.2, printed p.6, PDF p.7, and for
"after completion" in Lemma B.1, p.33): the sets `s` of the ambient σ-algebra that agree
`P`-almost everywhere with some `m`-measurable set.

**Formalization Note** Only sets measurable for the ambient σ-algebra are kept, so the result is
a sub-σ-algebra of the ambient one even when `m` is not (for instance if `m` is generated by an
only a.e.-measurable process). When `m` is a sub-σ-algebra, this is `m` together with all
`P`-null sets of the ambient σ-algebra. -/
def augmentSigma {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) (m : MeasurableSpace Ω) :
    MeasurableSpace Ω where
  MeasurableSet' s := MeasurableSet[mΩ] s ∧ ∃ t, MeasurableSet[m] t ∧ s =ᵐ[P] t
  measurableSet_empty := ⟨@MeasurableSet.empty _ mΩ, ∅, @MeasurableSet.empty _ m, Filter.EventuallyEq.rfl⟩
  measurableSet_compl s hs := by
    obtain ⟨hs, t, ht, hst⟩ := hs
    exact ⟨@MeasurableSet.compl _ _ mΩ hs, tᶜ, ht.compl, hst.compl⟩
  measurableSet_iUnion f hf := by
    choose hfm t ht hft using hf
    exact ⟨@MeasurableSet.iUnion _ _ mΩ _ _ hfm, ⋃ i, t i, MeasurableSet.iUnion ht,
      Filter.EventuallyEq.countable_iUnion hft⟩

lemma augmentSigma_le {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : @Measure Ω mΩ)
    (m : MeasurableSpace Ω) : @augmentSigma Ω mΩ P m ≤ mΩ := fun _ hs => hs.1

lemma augmentSigma_mono {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : @Measure Ω mΩ)
    {m₁ m₂ : MeasurableSpace Ω} (h : m₁ ≤ m₂) :
    @augmentSigma Ω mΩ P m₁ ≤ @augmentSigma Ω mΩ P m₂ := fun s hs => by
  obtain ⟨hs1, t, ht, hst⟩ := hs
  exact ⟨hs1, t, h t ht, hst⟩

end ABPOnline


