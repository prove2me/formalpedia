-- title:
--   The unequal-probability algorithm of §§9.1–9.5
-- statement:
--   The algorithm of Theorem 1.1 is as follows.
--
--   1. **Preprocessing.** Contract the components generated by edges with $p_e=0$, delete edges with $p_e=1$, replace incidences by quotient vertices, remove loops, and keep the remaining labels. Return $0$ if at most one quotient vertex remains and $1$ if the support is disconnected. Otherwise relabel the connected quotient; $n,m$ refer to it.
--   2. **Rate rounding.** With $\tau=\varepsilon/(64m)$, take $l_e$ from Lemma 7.1 at tolerance $\tau/4$, put $u_e=l_e+\tau/4$, take the least $a$ with $d=2^{-a}\le\tau/4$, and set $r^\prime_e=d\lceil u_e/d\rceil$, $R=\sum_e r^\prime_e$.
--   3. **Cut.** $\Lambda$ is the minimum cut of the rates $r^\prime$.
--   4. **Sampling.** With $M_0=\max\{1,R\}$, set
--   $$L^\prime=\Bigl\lceil\frac{1024NM_0^2}{\varepsilon}\Bigr\rceil,\quad h^\prime=\frac1{L^\prime},\quad S^\prime=\Bigl\lceil\frac{512N}{\varepsilon^2}\Bigr\rceil,$$
--   the least $q^\prime\ge1$ with $2^{q^\prime}\ge1024N[N+L^\prime(2m+2)]/\varepsilon$, and the least positive odd $r$ with $2^{-r}\le\delta$. The median of the batch averages is $Z_*$.
--   5. **Output.** Return $\min\{1,q_0Z_*\}$, with $q_0$ from Lemma 9.3.
--
--   The comparison law $p^\prime_e=e^{-r^\prime_e}$, $u^\prime=u(p^\prime)$ and $\mu^\prime=e^\Lambda u^\prime$ occur only in the analysis.
--
--   **Formalization Note** The procedure is a pure function of the input and the bit stream, with no oracle or certificate among its parameters. Its machine cost is a separate theorem. Quotient vertices are numbered in increasing order of the smallest original vertex of the component.
-- source:
--   Zhijie Zheng, STOC 2027 submission #37 (October 2026), §§9.1–9.5, pp. 12–15

import Mathlib
import Definitions.Def_HypergraphUnreliability_FPRAS_Instance
import Definitions.Def_HypergraphUnreliability_FPRAS_EulerSampler
import Definitions.Def_HypergraphUnreliability_FPRAS_RationalApprox

noncomputable section

open scoped BigOperators Classical

namespace HypergraphUnreliability.FPRAS

/-- The output of the preprocessing of §9.1, p. 12: a hypergraph on `Fin n` with retained labels
`Fin m` and written failure probabilities. -/
structure QuotientData where
  n : ℕ
  m : ℕ
  H : LabeledHypergraph n (Fin m)
  fail : Fin m → Frac

namespace QuotientData

variable (D : QuotientData)

/-- The context after §9.1: `n ≥ 2`, connected, nonloop edges, and `0 < p_e < 1` written as a fraction
of positive integers. -/
structure Regular : Prop where
  standing : D.H.Standing
  num_pos : ∀ e, 0 < (D.fail e).num
  num_lt : ∀ e, (D.fail e).num < (D.fail e).den

/-- The failure probabilities `p_e`, as real numbers. -/
def failProb (e : Fin D.m) : ℝ := (((D.fail e).val : ℚ) : ℝ)

/-- The unreliability `u(p)` of the quotient. -/
def target : ℝ := D.H.unreliability D.failProb

/-- `N = binom(n, 2)`, as a rational number. -/
def N : ℚ := (D.n.choose 2 : ℕ)

variable (ε δ : ℚ)

/-- `τ = ε/(64 m)`, (9.1), p. 12. -/
def τ : ℚ := ε / (64 * D.m)

/-- The least nonnegative integer `a` with `2^{-a} ≤ τ/4`. -/
def a : ℕ := sInf {a : ℕ | (1 / 2 : ℚ) ^ a ≤ D.τ ε / 4}

/-- The rational lower bound `l_e ≤ r_e` with `r_e - l_e ≤ τ/4`, from Lemma 7.1. -/
def lowerRate (e : Fin D.m) : ℚ :=
  logLower (D.fail e).num (D.fail e).den (D.τ ε / 4)

/-- The rounded rate `r′_e = d ⌈u_e / d⌉`, with `u_e = l_e + τ/4` and `d = 2^{-a}`, (9.2), p. 13. -/
def roundedRate (e : Fin D.m) : ℚ :=
  let d : ℚ := (1 / 2 : ℚ) ^ D.a ε
  d * (⌈(D.lowerRate ε e + D.τ ε / 4) / d⌉ : ℤ)

/-- The real rounded rates. -/
def roundedRateReal (e : Fin D.m) : ℝ := ((D.roundedRate ε e : ℚ) : ℝ)

/-- `R = ∑_e r′_e`, (9.3), p. 13. -/
def R : ℚ := ∑ e, D.roundedRate ε e

/-- The exact weighted minimum cut `Λ`, (9.5), p. 13. -/
def Lam : ℚ := D.H.minCut (D.roundedRate ε)

/-- The comparison probabilities `p′_e = exp(-r′_e)`; only `r′_e` is ever computed. -/
def comparisonProb (e : Fin D.m) : ℝ := Real.exp (-D.roundedRateReal ε e)

/-- `u′ = u(p′)`, §9.1, p. 13. -/
def comparisonTarget : ℝ := D.H.unreliability (D.comparisonProb ε)

/-- The normalized mean `μ′ = e^Λ u′`, (9.7), p. 14. -/
def normalizedMean : ℝ := Real.exp ((D.Lam ε : ℚ) : ℝ) * D.comparisonTarget ε

/-- `M₀ = max{1, R}`. -/
def M₀ : ℚ := max 1 (D.R ε)

/-- `L′ = ⌈1024 N M₀² / ε⌉`, (9.8), p. 14. -/
def L' : ℕ := ⌈1024 * D.N * (D.M₀ ε) ^ 2 / ε⌉₊

/-- The parameters of the weighted sampler, §§9.3–9.4: rates `r′`, `Λ`, `h′ = 1/L′`, the least
`q′ ≥ 1` with `2^{q′} ≥ 1024 N [N + L′(2m+2)] / ε`, `S′ = ⌈512 N / ε²⌉`, and the least positive odd
`r` with `2^{-r} ≤ δ`. -/
def params : SamplerParams D.n D.m where
  H := D.H
  r := D.roundedRate ε
  Λ := D.Lam ε
  h := 1 / (D.L' ε : ℚ)
  L := D.L' ε
  q := bitWidth (1024 * D.N * (D.N + (D.L' ε : ℚ) * (2 * D.m + 2)) / ε)
  S := ⌈512 * D.N / ε ^ 2⌉₊
  b := oddBatchCount δ

/-- The output on the quotient, `min{1, q₀ Z_*}` (proof of Theorem 1.1, p. 15). -/
def sampledOutput (ω : ℕ → Bool) : ℚ :=
  min 1 (expApprox (D.Lam ε) ε * (D.params ε δ).medianOfBatches ω)

end QuotientData

namespace RawInstance

variable (x : RawInstance)

/-- `p_e = 0`: the label is always present. -/
def zeroLabels : Finset (Fin x.edges.length) :=
  Finset.univ.filter (fun e => (x.edges.get e).fail.num = 0)

/-- The components generated by the edges with `p_e = 0`, which are contracted (§9.1, p. 12). -/
def zeroComponents : Setoid (Fin x.n) :=
  x.hypergraph.components (x.zeroLabelsᶜ)

/-- The smallest vertex of the zero-component of `v`. -/
def componentMin (v : Fin x.n) : Fin x.n :=
  (Finset.univ.filter (fun u => x.zeroComponents u v)).min'
    ⟨v, Finset.mem_filter.mpr ⟨Finset.mem_univ _, x.zeroComponents.refl v⟩⟩

/-- The quotient vertices, each named by the smallest vertex of its component, in increasing order. -/
def quotientReps : List (Fin x.n) :=
  (List.finRange x.n).filter (fun v => x.componentMin v = v)

/-- The quotient vertices relabeled `0, …, n′ - 1`, increasing in the smallest original vertex. -/
def quotientLabel (v : Fin x.n) : ℕ := x.quotientReps.idxOf (x.componentMin v)

/-- The number of quotient vertices. -/
def quotientSize : ℕ := x.quotientReps.length

/-- The quotient endpoints of an input edge. -/
def quotientEdge (e : RawEdge x.n) : Finset (Fin x.quotientSize) :=
  Finset.univ.filter (fun u => ∃ v ∈ e.verts, x.quotientLabel v = u.val)

/-- The retained labels (§9.1, p. 12): the labels with `p_e = 0` were contracted, the labels with
`p_e = 1` are deleted, the loops are removed (including empty and singleton edges); every other label
is retained as an independent trial, in the input order. -/
def quotientEdges : List (Finset (Fin x.quotientSize) × Frac) :=
  ((x.edges.filter (fun e => e.fail.num ≠ 0 ∧ e.fail.num ≠ e.fail.den)).map
      (fun e => (x.quotientEdge e, e.fail))).filter (fun e => 2 ≤ e.1.card)

/-- The connected-quotient data of §9.1. -/
def quotient : QuotientData where
  n := x.quotientSize
  m := x.quotientEdges.length
  H := ⟨fun e => (x.quotientEdges.get e).1⟩
  fail := fun e => (x.quotientEdges.get e).2

/-- The algorithm of Theorem 1.1 on the random bit stream `ω` (§§9.1–9.5): `0` if at most one
quotient vertex remains, `1` if the support is disconnected, and otherwise `min{1, q₀ Z_*}`. -/
def output (ω : ℕ → Bool) : ℚ :=
  if x.quotient.n ≤ 1 then 0
  else if ¬ x.quotient.H.IsConnected then 1
  else x.quotient.sampledOutput x.ε.val x.δ.val ω

/-- All bits used by the sampler; fixed before the run. -/
def totalBits : ℕ := (x.quotient.params x.ε.val x.δ.val).totalBits

/-- The case in which the sampler runs. -/
def IsSamplingCase : Prop := x.quotient.Regular

end RawInstance

end HypergraphUnreliability.FPRAS


