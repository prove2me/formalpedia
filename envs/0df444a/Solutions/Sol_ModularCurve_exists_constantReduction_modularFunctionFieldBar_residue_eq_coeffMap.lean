private theorem transport {L : Type*} [Field L] (A : ValuationSubring L)
    {X : Type*} [Field X] [Algebra L X] {Y : Type*} [Field Y] [Algebra (ResidueField A) Y]
    (E₁ E₂ : IntermediateField L X) (hE : E₁ = E₂)
    (E₁' E₂' : IntermediateField (ResidueField A) Y) (hE' : E₁' = E₂')
    (ι : LaurentSeries A → X) (red : LaurentSeries A → Y)
    (R : ConstantReduction A E₁ E₁')
    (law : ∀ (y : LaurentSeries A) (hy : ι y ∈ E₁), ∃ h : (⟨ι y, hy⟩ : E₁) ∈ R.integers,
      ((R.residue ⟨_, h⟩ : E₁') : Y) = red y) :
    ∃ R₂ : ConstantReduction A E₂ E₂', ∀ (y : LaurentSeries A) (hy : ι y ∈ E₂),
      ∃ h : (⟨ι y, hy⟩ : E₂) ∈ R₂.integers, ((R₂.residue ⟨_, h⟩ : E₂') : Y) = red y := by
  subst hE hE'
  exact ⟨R, law⟩

private theorem charP_residueField (q : ℕ) [Fact q.Prime] (A : ValuationSubring (AlgebraicClosure ℚ))
    (hA : A.LiesOverPrime q) : CharP (ResidueField A) q := by
  apply (CharP.charP_iff_prime_eq_zero (Fact.out : q.Prime)).mpr
  have hmem : (⟨(q : AlgebraicClosure ℚ), natCast_mem A q⟩ : A) ∈ maximalIdeal A := by
    rw [← ValuationSubring.coe_mem_nonunits_iff]; exact hA
  have : IsLocalRing.residue A ⟨(q : AlgebraicClosure ℚ), natCast_mem A q⟩ = 0 := (residue_eq_zero_iff _).mpr hmem
  rw [← map_natCast (IsLocalRing.residue A) q]
  convert this <;> first | rfl | simp

private theorem translation_mem_Gamma0 (M : ℕ) : ModularGroup.T ∈ Gamma0 M := by
  rw [Gamma0_mem]
  simp [ModularGroup.T]

