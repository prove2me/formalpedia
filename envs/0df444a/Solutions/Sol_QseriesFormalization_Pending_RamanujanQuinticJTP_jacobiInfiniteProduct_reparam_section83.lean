    (hq : ‖q‖ < 1) :
    PartI.Ch02.jacobiInfiniteProduct Y (-(z * Y)) =
      (1 - z⁻¹) * section83JTPProductAnalytic z q := by
  have hYnorm : ‖Y‖ < 1 := norm_of_sq_eq_lt_one hYq hq
  rw [PartI.Ch02.jacobiInfiniteProduct_eq_tprod_components Y (-(z * Y)) hYnorm]
