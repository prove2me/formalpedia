-- title:
--   Proof of Proposition 3.1, p. 10 — finitely many realizations of 𝔔_t and of first-stage solutions; the approximations stabilize
-- statement:
--   Fix the SAA data, the initial cut sets $C_0$, the oracle and the number $M$ of forward scenarios per iteration, and consider all runs of the SDDP method (all forward samples, all choices of basic optimal dual solutions). Then:
--
--   1. for every stage $t$, only finitely many different cut sets occur as the stage-$t$ set of some run at some iteration; hence only finitely many different approximations $\mathfrak Q_{t+1}$ arise;
--   2. only finitely many different first-stage solutions of (3.13) arise;
--   3. along every run, the cut sets are eventually constant: there is an iteration $K$ such that the cut sets of all stages at every iteration $k\ge K$ equal those at iteration $K$.
--
--   The paper uses item 3 when it says "Since the total number of different realizations of functions $\mathfrak Q_t(\cdot)$ is finite" (p. 11): cut sets only grow inside a finite universe.
--
--   **Formalization Note** The first-stage solutions are those returned by the deterministic oracle for the stage-1 cut sets. Stages outside $1,\dots,T-1$ never change.
-- source:
--   Shapiro, Analysis of Stochastic Dual Dynamic Programming Method, Optimization Online 2009/12/2509, p. 10, proof of Proposition 3.1, first paragraph; p. 11

import Mathlib
import Definitions.Def_ShapiroSDDP_Convergence_Model
import Definitions.Def_ShapiroSDDP_Convergence_SDDP

namespace ShapiroSDDP.Convergence

/-- Proof of Proposition 3.1, pp. 10–11: with basic optimal dual solutions, the approximations
`𝔔_t` and the first-stage solutions generated by the method range over finite sets. For fixed data,
initial cuts, oracle and number `M` of forward scenarios, (1) for every stage `t` the set of cut
sets `cuts k t` occurring in any run, at any iteration, for any forward samples, is finite; (2) the
set of first-stage solutions they produce is finite; and (3) along every run the cut sets are
eventually constant. -/
theorem finite_approx (I : Instance) (C₀ : (t : ℕ) → Finset (Cut I t)) (sol : Oracle I) (M : ℕ) :
    (∀ t, {C : Finset (Cut I t) | ∃ (ω : ℕ → Fin M → Scen I) (cuts : ℕ → (t : ℕ) → Finset (Cut I t))
        (k : ℕ), IsRun I C₀ sol ω cuts ∧ cuts k t = C}.Finite) ∧
      {x : Fin (I.n 1) → ℝ | ∃ (ω : ℕ → Fin M → Scen I)
        (cuts : ℕ → (t : ℕ) → Finset (Cut I t)) (k : ℕ),
        IsRun I C₀ sol ω cuts ∧ x = sol.first (cuts k 1)}.Finite ∧
      ∀ (ω : ℕ → Fin M → Scen I) (cuts : ℕ → (t : ℕ) → Finset (Cut I t)),
        IsRun I C₀ sol ω cuts → ∃ K, ∀ k, K ≤ k → cuts k = cuts K := by sorry

end ShapiroSDDP.Convergence
