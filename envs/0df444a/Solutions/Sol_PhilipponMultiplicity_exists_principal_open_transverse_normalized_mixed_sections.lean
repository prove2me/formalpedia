attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- A unit ideal over the coefficient fraction field already contains a nonzero
constant polynomial before localization. -/
theorem exists_nonzero_constant_mem
    {R σ : Type*} [CommRing R] [IsDomain R]
    (I : Ideal (MvPolynomial σ R))
    (h : I.map (map (algebraMap R (FractionRing R))) = ⊤) :
    ∃ d : R, d ≠ 0 ∧ C d ∈ I := by
  let S := (nonZeroDivisors R).map (C (σ := σ))
  have h1 : algebraMap (MvPolynomial σ R) (MvPolynomial σ (FractionRing R)) 1 ∈
      I.map (algebraMap (MvPolynomial σ R) (MvPolynomial σ (FractionRing R))) := by
    change (map (algebraMap R (FractionRing R))) 1 ∈
      I.map (map (algebraMap R (FractionRing R)))
    rw [map_one, h]
    trivial
  obtain ⟨s, hs, hsI⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff S
      (MvPolynomial σ (FractionRing R)) I 1).mp h1
  obtain ⟨d, hd, rfl⟩ := hs
  exact ⟨d, mem_nonZeroDivisors_iff_ne_zero.mp hd, by simpa using hsI⟩

/-- Nonvanishing of the cleared coefficient preserves the unit ideal under specialization. -/
theorem specialized_eq_top_of_constant_mem
    {R K σ : Type*} [CommRing R] [Field K]
    (I : Ideal (MvPolynomial σ R)) (d : R) (hd : C d ∈ I)
    (φ : R →+* K) (hφ : φ d ≠ 0) : I.map (map φ) = ⊤ := by
  apply (I.map (map φ)).eq_top_of_isUnit_mem
    (Ideal.mem_map_of_mem (map φ) hd)
  simpa only [map_C] using
    (isUnit_iff_ne_zero.mpr hφ).map (C (σ := σ))

/-- A finite family of generic unit ideals spreads out over a single principal open. -/
theorem finite_family_spreads
    {R K σ ι : Type*} [CommRing R] [IsDomain R] [Field K] [Fintype ι]
    (I : ι → Ideal (MvPolynomial σ R))
    (h : ∀ i, (I i).map (map (algebraMap R (FractionRing R))) = ⊤) :
    ∃ d : R, d ≠ 0 ∧ ∀ φ : R →+* K, φ d ≠ 0 →
      ∀ i, (I i).map (map φ) = ⊤ := by
  classical
  choose d hd hmem using fun i => exists_nonzero_constant_mem (I i) (h i)
  refine ⟨∏ i, d i, Finset.prod_ne_zero_iff.mpr (fun i _ => hd i), ?_⟩
  intro φ hφ i
  apply specialized_eq_top_of_constant_mem (I i) (d i) (hmem i) φ
  have hprod : (∏ i, φ (d i)) ≠ 0 := by simpa only [map_prod] using hφ
  exact Finset.prod_ne_zero_iff.mp hprod i (Finset.mem_univ i)

/-- Coefficient specialization commutes with a full square Jacobian determinant. -/
theorem map_jacobian_det
    {R S σ : Type*} [CommRing R] [CommRing S] [Fintype σ] [DecidableEq σ]
    (φ : R →+* S) (Q : σ → MvPolynomial σ R) :
    map φ (Matrix.of (fun i j => pderiv j (Q i))).det =
      (Matrix.of (fun i j => pderiv j (map φ (Q i)))).det := by
  rw [show map φ (Matrix.of (fun i j => pderiv j (Q i))).det =
    (Matrix.of (fun i j => map φ (pderiv j (Q i)))).det from
      RingHom.map_det (map φ) _]
  simp only [pderiv_map]

/-- The Jacobian obstruction ideal specializes into the obstruction ideal of
any containing specialized system of equations. -/
theorem map_jacobianIdeal_le
    {R S σ : Type*} [CommRing R] [CommRing S] [Fintype σ] [DecidableEq σ]
    (φ : R →+* S) (I : Ideal (MvPolynomial σ R)) (J : Ideal (MvPolynomial σ S))
    (hIJ : I.map (map φ) ≤ J) :
    (jacobianIdeal I).map (map φ) ≤ jacobianIdeal J := by
  apply Ideal.map_le_iff_le_comap.mpr
  apply sup_le
  · exact Ideal.map_le_iff_le_comap.mp (hIJ.trans le_sup_left)
  · apply Ideal.span_le.mpr
    rintro d ⟨Q, hQ, rfl⟩
    change map φ (Matrix.of (fun i j => pderiv j (Q i))).det ∈ jacobianIdeal J
    rw [map_jacobian_det]
    apply (le_sup_right : _ ≤ jacobianIdeal J)
    apply Ideal.subset_span
    exact ⟨fun i => map φ (Q i), fun i =>
      hIJ (Ideal.mem_map_of_mem (map φ) (hQ i)), rfl⟩

/-- A unit Jacobian obstruction ideal gives full-rank equations at every common zero. -/
theorem pointwise_of_jacobianIdeal_eq_top
    {K σ : Type*} [Field K] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ K)) (hI : jacobianIdeal I = ⊤)
    (a : σ → K) (ha : ∀ P ∈ I, eval a P = 0) :
    ∃ Q : σ → MvPolynomial σ K, (∀ i, Q i ∈ I) ∧
      eval a (Matrix.of (fun i j => pderiv j (Q i))).det ≠ 0 := by
  classical
  by_contra h
  have hker : jacobianIdeal I ≤ RingHom.ker (eval a) := by
    apply sup_le ha
    apply Ideal.span_le.mpr
    rintro d ⟨Q, hQ, rfl⟩
    change eval a (Matrix.of (fun i j => pderiv j (Q i))).det = 0
    by_contra hd
    exact h ⟨Q, hQ, hd⟩
  have h1 : (1 : MvPolynomial σ K) ∈ RingHom.ker (eval a) := by
    apply hker
    rw [hI]
    trivial
  exact (one_ne_zero : (1 : K) ≠ 0) (by simpa using h1)

end PhilipponMultiplicity.GenericMixedSections
end
