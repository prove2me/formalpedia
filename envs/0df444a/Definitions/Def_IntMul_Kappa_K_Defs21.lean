-- Source module: Solutions.KFLAddr
/-!
# KFL §17: `permRecs (rowAddAddr …)` as a triple map on the bit array

The Gaussian records (`R` entries, `2 (w+1)` bits per entry after `toBitsI`) of the rectangle
`rect N0 N1 N2 N3 L` form the bit array of the geometry `geoB` (`Q = 2^L`, `B = 2 R (w+1)`).
`bits_permRecs`: converting `permRecs rect (rowAddAddr px py) R zs` to bits gives
`rixT (geoB …) (Fpp px py)` of the bits of `zs`, where `Fpp px py` replaces slot `py` by
`y ⊕ (x ∧ selM f)` (`x` = slot `px`).  `Fpp_conj`: `Fpp px py` is the canonical row addition
`RAc` conjugated by at most two slot swaps.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD KFB KFH AModel Butterfly

/-! ## Chunks of a list -/

/-! ## The bit records -/

/-- Record `m` of `zs` in bits. -/
def recB (R w : ℕ) (zs : List GI) (m : ℕ) : List ℤ := bitsL w (gflat ((zs.drop (m * R)).take R))

/-- Padded to all `m`. -/
def recsB (R w M : ℕ) (zs : List GI) (m : ℕ) : List ℤ :=
  if m < M then recB R w zs m else List.replicate (R * (2 * (w + 1))) 0

/-! ## The geometry of the bit array -/

/-- The bit-array geometry: `Q = 2^L`, records of `B = 2 R (w + 1)` bits. -/
def geoB (N0 N1 N2 N3 L R w : ℕ) : Geo := ⟨2 ^ L, N0, N1, N2, N3, R * (2 * (w + 1))⟩

section Geom

variable {N0 N1 N2 N3 L R w : ℕ}

/-- Slot access on triples. -/
def slotG (c : Tr) : Fin 3 → ℕ
  | 0 => c.1
  | 1 => c.2.1
  | 2 => c.2.2

def slotS (c : Tr) : Fin 3 → ℕ → Tr
  | 0, v => (v, c.2.1, c.2.2)
  | 1, v => (c.1, v, c.2.2)
  | 2, v => (c.1, c.2.1, v)

/-- The stride of a slot. -/
def strd (g : Geo) : Fin 3 → ℕ
  | 0 => g.S0
  | 1 => g.S1
  | 2 => g.S2

end Geom

/-! ## The slot row addition as a triple map -/

/-- Slot `py` gets `y ⊕ (x ∧ selM f)`, `x` = slot `px`. -/
def Fpp (K ρ f : ℕ) (px py : Fin 3) (c : Tr) : Tr :=
  slotS c py (slotG c py ^^^ (slotG c px &&& selM K ρ f))

/-! ## Records permuted by `rowAddAddr`, in bits -/

/-! ## Conjugation by slot swaps -/

def swT : Fin 3 → Tr → Tr
  | 0 => sw01
  | 1 => sw12
  | 2 => sw02

def compL : List (Fin 3) → Tr → Tr
  | [] => id
  | i :: l => swT i ∘ compL l

/-- The swaps bringing `(px, py)` to the canonical slots `(0, 1)`. -/
def preL : Fin 3 → Fin 3 → List (Fin 3)
  | 1, 0 => [0]
  | 0, 2 => [1]
  | 2, 1 => [2]
  | 2, 0 => [2, 1]
  | 1, 2 => [0, 1]
  | _, _ => []

end NLogN.KFL

end

