def outerSt (s : IState HS) (D : List (List ℤ)) (Rest : List Item) (n m d i : ℕ) : IState HS :=
  ((((s.upd 0 (ints (D.drop (i * m)).flatten ++ Rest)).upd 40
    (ints (kflat n m D (i * m)).reverse ++ s.G 40)).upd 42
    (.int (i : ℤ) :: s.G 42)).upd 45
    (.int ((i * m * (d + 1) : ℕ) : ℤ) :: s.G 45)).upd 54
    (.int ((i * m : ℕ) : ℤ) :: s.G 54)

def outerLoop (d : ℕ) : RS := rep 43 (.reg 1) (rowBody d)

/-- Attach the keys: the keyed records end up on `0`. -/
def attachP (d : ℕ) : RS :=
  NLogN.RS.seq (push 42 (.lit 0)) (NLogN.RS.seq (push 45 (.lit 0)) (NLogN.RS.seq (push 54 (.lit 0))
