-- Source module: Solutions.KFLCorr3
/-!
# KFL §14: the correction, pass 3 (merge) and the whole correction

Pass 3 rebuilds stack `0` from the bottom: for `d = M-1, …, 0` it pops the flag of `d` and moves
the top record of `sKB` (a moved destination: the sorted entries are in decreasing destination
order) or of `sT` (an unmoved record) to stack `0`.

`corrRS` = pass 1 + radix sort + pass 3; `corrRS_fsp`: on `flR recs M` it produces
`flR (recs ∘ corrR) M`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFL

open IntMul RS KIL KFD Butterfly

/-! ## Pass 3 -/

def p3B (B : ℕ) : RS :=
  .seq (.ite (.neg (.reg sFL)) (.seq (NLogN.mvK sKB 0 NLogN.KFL.cMv (.lit (B : ℤ))) (.pop sKK))
    (NLogN.mvK sT 0 NLogN.KFL.cMv (.lit (B : ℤ)))) (.pop sFL)

def cP3 (B Bb : ℕ) : ℕ := cLp B (250 * (1 + 2)) Bb + 10 ^ 4 * (Bb + 2)

section P3

variable (κ γ : ℕ → ℕ) (recs : ℕ → List ℤ) (M A : ℕ)

/-- The state of pass 3 when the destinations `≥ k` are done. -/
def P3 (G0 : Fin HS → List ℤ) (k : ℕ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update G0
    0 (restR (fun d => recs (γ d)) M k ++ G0 0))
    sT (stkF (fun m => !mvP κ m) (fun m => (recs m).reverse) k ++ G0 sT))
    sKB (stkF (mvP κ) (fun d => (recs (γ d)).reverse) k ++ G0 sKB))
    sKK (stkK (mvP κ) (fun d => ((d / 2 ^ A : ℕ) : ℤ)) k ++ G0 sKK))
    sFL (flL κ k ++ G0 sFL)

end P3

def p3Prog (B M : ℕ) : RS := .rep c4 (.lit (M : ℤ)) (p3B B)

/-! ## The whole correction -/

def corrRS (K ρ f : ℕ) (g : Geo) (A : ℕ) : RS :=
  .seq (.push NLogN.KFL.rm (.lit 0)) (.seq (.push rNB (.lit 0)) (.seq (p1Prog K ρ f g) (.seq (.pop NLogN.KFL.rm)
    (.seq (radixProg g.B A) (.seq (p3Prog g.B g.recG.V) (.pop rNB))))))

def cCorr (K f : ℕ) (g : Geo) (A nB Bb : ℕ) : ℕ :=
  10 ^ 5 * (Bb + 2) + cLp g.recG.V (cP1 K f g.B Bb) Bb + cLp A (cPass g.B nB Bb) Bb +
    cLp g.recG.V (cP3 g.B Bb) Bb

section Lists

variable (κ γ : ℕ → ℕ) (recs : ℕ → List ℤ) (M A : ℕ)

end Lists

end NLogN.KFL

end

