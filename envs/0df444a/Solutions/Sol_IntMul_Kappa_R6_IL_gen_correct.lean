  have h := Nat.mul_div_cancel' hWL
  have h2 : P * (L * Z) = W * (P * (L / W * Z)) := by
    calc P * (L * Z) = P * ((W * (L / W)) * Z) := by rw [h]
      _ = _ := by ring
  rw [h2, Nat.mul_div_cancel_left _ (NeZero.pos W)]

theorem costN_eq (C : Bit.QHNet (ZMod 2) W T m) (q Bb e V : ℕ) :
