-- Source module: Solutions.J6AILTab2
/-!
# A lines, table set-up, part 2: the input-scaling table loop

The register file during the table loop (`LV`):

    1 = 2p   2 = p/2   3 = s   4 = t   5 = 2^(2p)   6 = β = betaT (2p) α   7 = t³α²
    8 = H    9 = W     11 = t²α²   12 = 2^Q   20 = 2^pk   21 = 2^b   22 = jA   23 = b·2r

(`10` the loop count, `24` the block index, `25` the block offset `A0 = t (j_c - W) - s k_c`,
`26` the loop index, `28`, `29` scratch).

`loopA`: for `i < 2W`: `28 := (t-s)⁺ (A0 + t i)²; 29 := expNeg 2p (t³α²) 28; push 2^Q · 29`,
i.e. it pushes `aTabA … q` (`Rn.loopA`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.ATab

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH Function

/-! ## Arithmetic -/

/-! ## The body -/

/-- `(t - s)⁺`. -/
def eTS : E := .sel (.sub (.r 4) (.r 3)) (.k 0) (.sub (.r 4) (.r 3))
def eAx : E := .add (.r 25) (.mul (.r 4) (.r 26))
def eA1 : E := .mul eTS (.mul eAx eAx)
def ePQ : E := .mul (.r 12) (.r 29)

def bodyA : RS := .seq (.asg 28 eA1.ex) (.seq (Ins.en 29 1 7 28).p (.push sS ePQ.ex))

/-- **The input-scaling loop** (count on `10`, index on `26`). -/
def loopA : RS := forL cI 10 26 bodyA

def cBodyA (W : ℕ) : ℕ := cT eA1.ex W + (Ins.cEn W + cT ePQ.ex W)

/-- The entries pushed by `loopA` for block `q`. -/
def fA (p s t α H q : ℕ) (i : ℕ) : ℤ := 2 ^ J6A.QA p * J6A.aFA p s t α H q i

end J6Seg.ATab

end

