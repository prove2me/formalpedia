namespace IntMul.Kappa.R6

open AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM Complex NLogN.KFZ

noncomputable section

/-! ## Lemma 20 with `AxisMaps6` -/

/-! ## The source transform -/

/-- The cost bound of the shift pass. -/
def kShl6 (Q : Q6) (D : ℕ) : ℕ :=
  cItem (2 ^ (Q.L + 1)) (1000 * (Q.p + 2 + 2 * (D + 1) * Q.α ^ 2 + 2))
      (Q.p + 2 + 2 * (D + 1) * Q.α ^ 2 + 1) + 2 * cCnt (2 ^ (Q.L + 1)) +
    cW (2 ^ (2 * (D + 1) * Q.α ^ 2)) + cW ((2 ^ (Q.L + 1) : ℕ) : ℤ)

section Ftil

variable {P P₃ P₄ : ℕ} {Isym : List Sym} {iprog : Fin P → IStmt HS P} {tab : Fin 1 → IStmt HS 1}
  {ext₃ : Fin P₃ → IStmt HS (7 + P₃)} {g₃ : Fin (7 + P₃) → Fin P}
  {ext₄ : Fin P₄ → IStmt HS (7 + P₄)} {g₄ : Fin (7 + P₄) → Fin P}

/-- The source transform. -/
def ftilP6 (g₃ : Fin (7 + P₃) → Fin P) (g₄ : Fin (7 + P₄) → Fin P) (eA eB : Fin (7 + P₃))
    (eC : Fin (7 + P₄)) (dSL dSC : Fin HS) : IStmt HS P :=
  .seq (callW (cpyD zLn (bX dSL) 2 4) (bX dSL) (bY dSL) dSL (g₃ eA))
    (.seq (callW (cpyD zCh (bX dSC) 2 5) (bX dSC) (bY dSC) dSC (g₄ eC))
      (.seq (callW (cpyD zLn (bX dSL) 2 4) (bX dSL) (bY dSL) dSL (g₃ eB)) (shlW KFM.rG)))

end Ftil

/-! ## The context of one size -/

/-- The fixed data of the program: the table maps of the four interfaces (setup, `Φ`, lines,
chirp), their entries and descriptor stacks. -/
structure Ix6 (P : ℕ) where
  P₁ : ℕ
  P₂ : ℕ
  P₃ : ℕ
  P₄ : ℕ
  g₁ : Fin (7 + P₁) → Fin P
  g₂ : Fin (7 + P₂) → Fin P
  g₃ : Fin (7 + P₃) → Fin P
  g₄ : Fin (7 + P₄) → Fin P
  eS : Fin (7 + P₁)
  eF : Fin (7 + P₂)
  eI : Fin (7 + P₂)
  eA : Fin (7 + P₃)
  eB : Fin (7 + P₃)
  eC : Fin (7 + P₄)
  dSΦ : Fin HS
  dSL : Fin HS
  dSC : Fin HS

/-- **Everything the run for one size uses.** -/
structure BigCtx6 {E : ℕ} (ix : Ix6 (7 + E)) (Isym : List Sym) (tab : Fin 1 → IStmt HS 1)
    (extM : Fin E → IStmt HS (7 + E)) (Q : Q6) (D : ℕ) [∀ i, NeZero (Q.sB D i)]
    [∀ i, NeZero (Q.tB D i)] where
  hQ : QOk Q
  hD : Q.d = D + 1
  H : KFU.CrtOK (D + 1) Q.src Q.mu
  -- `Φ`
  ext₂ : Fin ix.P₂ → IStmt HS (7 + ix.P₂)
  hp₂ : ∀ j, IL.kTableP tab extM (ix.g₂ j) = (IL.kTableP tab ext₂ j).ren id ix.g₂
  CΦ : ℝ
  AΦ : ℕ
  hdΦ : ix.dSΦ ≠ 0
  hΦ : phiG6 Isym (IL.kTableP tab ext₂) ix.eF ix.eI ix.dSΦ CΦ AΦ Q
  BΦ : ℕ
  hBΦ : ∀ x ∈ Q.dPh, zsz x ≤ BΦ
  -- lines
  ext₃ : Fin ix.P₃ → IStmt HS (7 + ix.P₃)
  hp₃ : ∀ j, IL.kTableP tab extM (ix.g₃ j) = (IL.kTableP tab ext₃ j).ren id ix.g₃
  CL : ℝ
  AL : ℕ
  hdL : ix.dSL ≠ 0
  M : AxisMaps6 Q.α (Q.sB D) (Q.tB D)
  hL : lineG6 Isym (IL.kTableP tab ext₃) ix.eA ix.eB ix.dSL CL AL Q D M
  BL : ℕ
  hBL : ∀ x ∈ Q.dLn, zsz x ≤ BL
  -- chirp
  ext₄ : Fin ix.P₄ → IStmt HS (7 + ix.P₄)
  hp₄ : ∀ j, IL.kTableP tab extM (ix.g₄ j) = (IL.kTableP tab ext₄ j).ren id ix.g₄
  CC : ℝ
  AC : ℕ
  hdC : ix.dSC ≠ 0
  θt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ
  θit : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ
  at' : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ
  bt : ((i : Fin (D + 1)) → ZMod (Q.tB D i)) → ℂ
  ζ : ℂ
  hζ : ζ ^ Q.tB D (Fin.last D) = -1
  hθ : Phases Q.p (twX (Q.tB D) ζ) θt
  hθi : Phases Q.p (fun j => (twX (Q.tB D) ζ j)⁻¹) θit
  ha : Phases Q.p (fun j => (starRingEnd ℂ) (chirp (Q.sB D) (Q.tB D) j)) at'
  hb' : Phases Q.p (chirp (Q.sB D) (Q.tB D)) bt
  hbg : Grid Q.p bt
  hC : chirpG6 Isym (IL.kTableP tab ext₄) ix.eC ix.dSC CC AC Q D θt θit at' bt
  BC : ℕ
  hBC : ∀ x ∈ Q.dCh, zsz x ≤ BC

/-! ## The digit cut -/

/-- The cost of the digit cut. -/
def kDig6 (Q : Q6) : ℕ :=
  cDigU Q.b Q.e Q.M Q.S + cW (2 ^ Q.e) + cW (((2 * (Q.S - Q.M) : ℕ) : ℤ)) + cW (Q.M : ℤ) +
    cW (2 ^ Q.b)

/-! ## One input -/

variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

/-- One input: the top of `ARGM` to the array `U`. -/
def inP6 (ix : Ix6 (7 + E)) : IStmt HS (7 + E) :=
  .seq (.op (.mv ARGM tX)) (.seq digW
    (.seq (callW (cpyD zPh (bX ix.dSΦ) 3 3) (bX ix.dSΦ) (bY ix.dSΦ) ix.dSΦ (ix.g₂ ix.eF))
      (ftilP6 ix.g₃ ix.g₄ ix.eA ix.eB ix.eC ix.dSL ix.dSC)))

/-- The digits `ū` of `x` on the box. -/
def ubar6 (C : BigCtx6 ix Isym tab extM Q D) (x : ℕ) :
    ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ :=
  fun k => (dgt Q.b Q.M x ((eB Q.src Q.mu C.H).symm k).val : ℂ)

/-- The cost bound of one source transform. -/
def kFt6 (C : BigCtx6 ix Isym tab extM Q D) : ℝ :=
  kCall6 Q 2 4 C.BL C.CL C.AL + kCall6 Q 2 5 C.BC C.CC C.AC + kCall6 Q 2 4 C.BL C.CL C.AL +
    kShl6 Q D

/-- The cost bound of one input. -/
def kIn6 (C : BigCtx6 ix Isym tab extM Q D) : ℝ :=
  ((2 * moveCost (Q.n + 1) + 19 + kDig6 Q : ℕ) : ℝ) + kCall6 Q 3 3 C.BΦ C.CΦ C.AΦ + kFt6 C

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6MMul
/-!
# Round-six machine: the product and the rounding passes

The frozen `KFMBig7` / `KFMBig8` at the round-six parameters.

* **`mul_phase6`**: both inputs, the Gaussian product, conjugation and the third transform.
* **`finA_runs6`**: `conj; ×S; ×S; ×2^{2b+4}; round_p`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6

open AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM Complex NLogN.KFZ

noncomputable section

/-! ## The product phase -/

/-- The width of the transform outputs. -/
def wU6 (Q : Q6) (D : ℕ) : ℕ := Q.p + 2 + (2 * (D + 1) * Q.α ^ 2 + 1)

/-- The cost of the Gaussian product pass. -/
def kGm6 (Q : Q6) (D : ℕ) : ℕ :=
  2 ^ Q.L * (4 * KFM.fmB (2 * wU6 Q D)) + 10 ^ 6 * (2 ^ Q.L + 1) * (wU6 Q D + Q.p + 1) +
    2 * cCnt (2 * 2 ^ Q.L) + cW (2 ^ Q.p) + cW ((2 * 2 ^ Q.L : ℕ) : ℤ) + cW ((2 ^ Q.L : ℕ) : ℤ)

/-- The cost of a conjugation pass at width `B`. -/
def kCj6 (Q : Q6) (B : ℕ) : ℕ :=
  cConj (2 ^ Q.L) B + cW ((2 * 2 ^ Q.L : ℕ) : ℤ) + cW ((2 ^ Q.L : ℕ) : ℤ)

variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

/-- The product program. -/
def mulP6 (ix : Ix6 (7 + E)) : IStmt HS (7 + E) :=
  .seq (inP6 ix) (.seq (.seq (mvNU KFM.rT2 0 pO) (mvNU KFM.rT2 pO pW)) (.seq (inP6 ix) (.seq gmulW
    (.seq conjW (ftilP6 ix.g₃ ix.g₄ ix.eA ix.eB ix.eC ix.dSL ix.dSC)))))

/-- The cost bound of the product phase. -/
def kMul6 (C : BigCtx6 ix Isym tab extM Q D) : ℝ :=
  kIn6 C + ((2 * cMvN (2 ^ (Q.L + 1)) (wU6 Q D) : ℕ) : ℝ) + kIn6 C + (kGm6 Q D : ℝ) +
    (kCj6 Q (Q.p + 1) : ℝ) + kFt6 C

/-! ## The rounding passes -/

/-- The width of the rounding passes. -/
def wFR6 (Q : Q6) (D : ℕ) : ℕ := wU6 Q D + 4 * Q.b + 5

/-- The cost of one `×S` pass. -/
def kSm6 (Q : Q6) (D : ℕ) : ℕ :=
  cItem (2 ^ (Q.L + 1)) (KFM.fmB (2 * wFR6 Q D) + 5000 * (wFR6 Q D + 0 + 3)) (2 * wFR6 Q D) +
    2 * cCnt (2 ^ (Q.L + 1)) + cW (Q.S : ℤ) + cW (2 ^ 0) + cW ((2 ^ (Q.L + 1) : ℕ) : ℤ)

/-- The cost of the `×2^{2b+4}` pass. -/
def kShF6 (Q : Q6) (D : ℕ) : ℕ :=
  cItem (2 ^ (Q.L + 1)) (1000 * (wFR6 Q D + (2 * Q.b + 4) + 2)) (wFR6 Q D + (2 * Q.b + 4) + 1) +
    2 * cCnt (2 ^ (Q.L + 1)) + cW (2 ^ (2 * Q.b + 4)) + cW ((2 ^ (Q.L + 1) : ℕ) : ℤ)

/-- The cost of the rounding pass. -/
def kRd6 (Q : Q6) (D : ℕ) : ℕ :=
  cItem (2 ^ (Q.L + 1)) (3000 * (wFR6 Q D + Q.p + 3)) (2 * wFR6 Q D + 1) +
    2 * cCnt (2 ^ (Q.L + 1)) + cW (2 ^ (Q.p - 1)) + cW (2 ^ Q.p) +
    cW ((2 ^ (Q.L + 1) : ℕ) : ℤ)

/-- The cost of `finA`. -/
def kFinA6 (Q : Q6) (D : ℕ) : ℕ :=
  kCj6 Q (wU6 Q D) + (kSm6 Q D + (kSm6 Q D + (kShF6 Q D + kRd6 Q D)))

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6MFin
/-!
# Round-six machine: the read-out and one run

The frozen `KFMBig9` / `KFMBig10` at the round-six parameters.

* `zsz_cN6`, `cconv_ubar6`, `pt_val6`, `zsW_GB6`: the rounded numerators are the coefficients.
* **`fin_phase6`**: `finA; Φ⁻¹; carries; write`.
* **`big_run6`**: `bigP6 = setup; mulP6; finP6` from the state after the reads, the setup being
  a call into a sub-table.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6

open Finset AModel AModelL12 IntMul NLogN NLogN.KIL KFB KFT RS IntMul.HvdH IntMul.OpenAI.RT
  IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM Complex

noncomputable section

variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

/-- The final closeness (the conclusion of `final_call3`). -/
def Close6 (C : BigCtx6 ix Isym tab extM Q D) (x y : ℕ)
    (Z : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ) : Prop :=
  ∀ j, ‖(2 : ℂ) ^ (2 * Q.b + 4) * ((∏ i, (Q.sB D i : ℝ) : ℝ) : ℂ) *
      (((∏ i, (Q.sB D i : ℝ) : ℝ) : ℂ) * cnj Z j) - cconv (Q.sB D) (ubar6 C x) (ubar6 C y) j‖ <
    1 / 2

/-- The rounded array. -/
def zsWf6 (Q : Q6) (zsZ : List GI) : List GI :=
  (zsZ.map gconj).map fun z => (rndV Q.p Q.b Q.S z.1, rndV Q.p Q.b Q.S z.2)

/-- The read-out program. -/
def finP6 (ix : Ix6 (7 + E)) : IStmt HS (7 + E) :=
  .seq finA (.seq (callW (cpyD zPh (bX ix.dSΦ) 3 3) (bX ix.dSΦ) (bY ix.dSΦ) ix.dSΦ (ix.g₂ ix.eI))
    (.seq carW (writeI 0 KFM.rO)))

/-- The cost bound of the read-out. -/
def kFin6 (C : BigCtx6 ix Isym tab extM Q D) : ℝ :=
  (kFinA6 Q D : ℝ) + kCall6 Q 3 3 C.BΦ C.CΦ C.AΦ +
    ((cCarU Q.b (Q.p + 2) Q.S + cW (Q.S : ℤ) + cW (2 ^ Q.b) + outRCost (2 * Q.n) : ℕ) : ℝ)

/-! ## One run -/

/-- **The program `bigE`**: the setup (a call into the setup sub-table), the product, the
read-out. -/
def bigP6 (ix : Ix6 (7 + E)) : IStmt HS (7 + E) :=
  .seq (.call (ix.g₁ ix.eS)) (.seq (mulP6 ix) (finP6 ix))

end

end IntMul.Kappa.R6

end

section
-- Source module: Solutions.R6ZSD
/-!
# Round six, chirp: the Prop 18 descriptor for any parameters

The frozen `KFMSD.desc18P_run_n` / `desc18P_cost_n` with the values of `n` (`dP n, dpN n, rP n,
KP n, ℓP n, bP n`) replaced by free values `d₀ d₁ r₀ K₀ ℓ₀ b₀` on the registers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

/-- The axis lengths: `d₀ - 1` entries, `r` from index `d₁` on, `r/2` before. -/
def tsG (d₀ d₁ r₀ : ℕ) : List ℕ :=
  (List.range (d₀ - 1)).map fun j => if d₁ ≤ j then r₀ else r₀ / 2

/-- The registers `desc18P` reads, with free values. -/
structure D18G (t : IState HS) (d₀ d₁ r₀ K₀ ℓ₀ b₀ : ℕ) : Prop where
  hD : ∃ L, t.G zD = .int (d₀ : ℤ) :: L
  hDp : ∃ L, t.G zDp = .int (d₁ : ℤ) :: L
  hR : ∃ L, t.G zR = .int (r₀ : ℤ) :: L
  hK : ∃ L, t.G zK = .int (K₀ : ℤ) :: L
  hEl : ∃ L, t.G zEl = .int (ℓ₀ : ℤ) :: L
  hB : ∃ L, t.G zB = .int (b₀ : ℤ) :: L

end NLogN.KFM

end

section
-- Source module: Solutions.R6ZCall
/-!
# Round six, chirp: the Prop 18 call and the product phase for any parameters

* `MG`, `dsG`: the side conditions and the Prop 18 descriptor for free `p h d σ K` (the frozen
  `KFZCall.M_runs` reads them through `n`).
* **`M_runsG`**: the frozen `M_runs` without `n`.
* **`PP_runsP`**: the frozen `PP_runs` in `IL.kTableP tab ext`, without `n`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue

/-- The side conditions of the descriptor program for free parameters. -/
structure MG (p h d σ K : ℕ) : Prop where
  p6 : 6 * (p / 6) = p
  b8 : 8 ≤ p / 6
  d1 : 1 ≤ d
  db : d ≤ p / 6
  r : 2 ^ (h + 1) ≤ 2 ^ (p / 6)
  Kd : K ≤ p / 6
  lb : h + 1 ≤ p / 6

/-- The Prop 18 descriptor for free parameters. -/
def dsG (p h d σ K : ℕ) : List ℤ := desc18 p (h + 1) K (tsG d (d - σ) (2 ^ (h + 1)))

end NLogN.KFZ

end


