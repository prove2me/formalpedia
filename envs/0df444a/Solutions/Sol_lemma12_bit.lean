lemma framesOK_of_mem (Pr : M → Prop) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      (∀ a ∈ frameMS gates lab Mout, Pr a) → FramesOK Pr gates lab Mout := by
  intro gates
  induction gates with
  | nil =>
