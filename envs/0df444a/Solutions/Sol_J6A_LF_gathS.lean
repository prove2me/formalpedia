theorem Sp.ir {p : RS} {s t : IState HS} {c : ℕ} (h : Sp p s t c) :
    IRuns I iprog p.code s t c := by
  obtain ⟨c', hc', h'⟩ := Sp.irun (I := I) (iprog := iprog) h
