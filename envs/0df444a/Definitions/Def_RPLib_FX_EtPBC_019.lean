/-- **`resFreeIso` is natural** in the etale object. -/
theorem resFreeIso_natural {T' T : X.Etale} (r : T' ⟶ T) :
    (resFreeIso Λ e T').hom ≫ (res e Λ).map (freeMap Λ r) =
      freeMap Λ ((etPull e).map r) ≫ (resFreeIso Λ e T).hom := by
  simp only [resFreeIso, Iso.trans_hom, Iso.app_hom, Category.assoc]
  rw [← (pullIsoRes e Λ).hom.naturality (freeMap Λ r)]
  show pullFreeHom Λ e T' ≫ (pull e Λ).map (freeMap Λ r) ≫ _ =
    freeMap Λ ((etPull e).map r) ≫ pullFreeHom Λ e T ≫ _
  rw [← Category.assoc, ← pullFreeHom_natural, Category.assoc]

