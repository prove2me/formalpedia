private theorem apply_mem_of_forall_apply_smul_eq_one
    (V : Submodule T J) (E : J → Prop) (π : T →+* L) (IL : Ideal L) (hfin : Finite ↥V)
    (hseam : ∀ t : T, π t ∈ IL → ∀ v ∈ V, E (t • v))
    (e₁ : ↥V → Fˣ)
    (hadd : ∀ v₁ v₂, e₁ (v₁ + v₂) = e₁ v₁ * e₁ v₂)
    (hkill : ∀ v : ↥V, E (v : J) → e₁ v = 1)
    (hsep : ∀ v : ↥V, (∀ t : T, e₁ (t • v) = 1) → E (v : J))
    (hcard : Nat.card ↥V = Nat.card (L ⧸ IL) * Nat.card {v : ↥V // E (v : J)})
    (t : T) (ht : ∀ v : ↥V, e₁ (t • v) = 1) : π t ∈ IL := by
  classical

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : T →+ (↥V → Additive Fˣ), ∀ s v, Φ s v = Additive.ofMul (e₁ (s • v)) :=
    ⟨AddMonoidHom.mk' (fun s v => Additive.ofMul (e₁ (s • v))) fun s₁ s₂ => by
      funext v
      show Additive.ofMul (e₁ ((s₁ + s₂) • v)) =
        Additive.ofMul (e₁ (s₁ • v)) + Additive.ofMul (e₁ (s₂ • v))
      rw [add_smul, hadd, ofMul_mul], fun _ _ => rfl⟩
  have hA : ∀ s, s ∈ Φ.ker ↔ ∀ v, e₁ (s • v) = 1 := fun s => by
    rw [AddMonoidHom.mem_ker, funext_iff]
    refine forall_congr' fun v => ?_
    rw [hΦ]
    exact Additive.ofMul.injective.eq_iff

  obtain ⟨θ, hθ⟩ : ∃ θ : T →+ L ⧸ IL, ∀ s, θ s = Ideal.Quotient.mk IL (π s) :=
    ⟨((Ideal.Quotient.mk IL).comp π).toAddMonoidHom, fun _ => rfl⟩
  have hK : ∀ s, s ∈ θ.ker ↔ π s ∈ IL := fun s => by
    rw [AddMonoidHom.mem_ker, hθ]
    exact Ideal.Quotient.eq_zero_iff_mem

  have hKA : θ.ker ≤ Φ.ker := fun s hs =>
    (hA s).mpr fun v => hkill (s • v) (hseam s ((hK s).mp hs) (v : J) v.2)

  haveI := hfin
  have hV0 : Nat.card ↥V ≠ 0 := Nat.card_pos.ne'
  have hRE : Nat.card (L ⧸ IL) ≠ 0 ∧ Nat.card {v : ↥V // E (v : J)} ≠ 0 := by
    rw [hcard] at hV0
    exact mul_ne_zero_iff.mp hV0
  haveI : Finite (L ⧸ IL) := Nat.finite_of_card_ne_zero hRE.1

  have hKle : θ.ker.index ≤ Nat.card (L ⧸ IL) := by
    rw [AddSubgroup.index_ker]
    exact AddSubgroup.card_le_card_addGroup θ.range
  have hKne : θ.ker.index ≠ 0 := by
    rw [AddSubgroup.index_ker]
    exact Nat.card_pos.ne'

  have hdvd : Φ.ker.index ∣ θ.ker.index := AddSubgroup.index_dvd_of_le hKA
  have hAle : Φ.ker.index ≤ θ.ker.index := Nat.le_of_dvd (Nat.pos_of_ne_zero hKne) hdvd
  have hAne : Φ.ker.index ≠ 0 := fun h => hKne (Nat.eq_zero_of_zero_dvd (h ▸ hdvd))
  have hP : Nat.card ↥Φ.range = Φ.ker.index := (AddSubgroup.index_ker Φ).symm
  haveI : Finite ↥Φ.range := Nat.finite_of_card_ne_zero (by rw [hP]; exact hAne)

  haveI : NeZero (Monoid.exponent (Multiplicative ↥Φ.range)) :=
    ⟨Monoid.exponent_ne_zero_of_finite⟩
  have hdual : Nat.card (↥Φ.range →+ Additive Fˣ) = Nat.card ↥Φ.range := by
    rw [Nat.card_congr AddMonoidHom.toMultiplicativeLeft]
    exact CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity (Multiplicative ↥Φ.range) F
  haveI : Finite (↥Φ.range →+ Additive Fˣ) :=
    Nat.finite_of_card_ne_zero (by rw [hdual, hP]; exact hAne)

  obtain ⟨ψ, hψ⟩ : ∃ ψ : ↥V →+ (↥Φ.range →+ Additive Fˣ),
      ∀ v f, ψ v f = (f : ↥V → Additive Fˣ) v := by
    refine ⟨AddMonoidHom.mk'
      (fun v => (Pi.evalAddMonoidHom (fun _ : ↥V => Additive Fˣ) v).comp Φ.range.subtype) ?_,
      fun _ _ => rfl⟩
    intro v w
    refine AddMonoidHom.ext fun f => ?_
    obtain ⟨s, hs⟩ := AddMonoidHom.mem_range.mp f.2
    show (f : ↥V → Additive Fˣ) (v + w) = (f : ↥V → Additive Fˣ) v + (f : ↥V → Additive Fˣ) w
    rw [← hs, hΦ, hΦ, hΦ, smul_add, hadd, ofMul_mul]

  have hkerψ : ∀ v : ↥V, v ∈ ψ.ker → E (v : J) := fun v hv => by
    refine hsep v fun s => ?_
    have h1 : ψ v ⟨Φ s, AddMonoidHom.mem_range.mpr ⟨s, rfl⟩⟩ = 0 := by
      rw [AddMonoidHom.mem_ker.mp hv, AddMonoidHom.zero_apply]
    rw [hψ] at h1
    change Φ s v = Additive.ofMul 1 at h1
    rw [hΦ] at h1
    exact Additive.ofMul.injective h1
  have hker : Nat.card ↥ψ.ker ≤ Nat.card {v : ↥V // E (v : J)} :=
    Nat.card_le_card_of_injective (fun v => ⟨v.1, hkerψ v.1 v.2⟩)
      fun a b h => Subtype.ext (congrArg (fun x : {v : ↥V // E (v : J)} => (x.1 : ↥V)) h)

  have hVle : Nat.card ↥V ≤ Φ.ker.index * Nat.card {v : ↥V // E (v : J)} := by
    have h1 : Nat.card ↥V = ψ.ker.index * Nat.card ↥ψ.ker := by
      rw [AddSubgroup.index_eq_card]
      exact AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup ψ.ker
    have h2 : ψ.ker.index ≤ Φ.ker.index := by
      rw [AddSubgroup.index_ker ψ, ← hP, ← hdual]
      exact AddSubgroup.card_le_card_addGroup ψ.range
    rw [h1]
    exact Nat.mul_le_mul h2 hker

  have hRA : Nat.card (L ⧸ IL) ≤ Φ.ker.index := by
    rw [hcard] at hVle
    exact Nat.le_of_mul_le_mul_right hVle (Nat.pos_of_ne_zero hRE.2)
  have hidx : Φ.ker.index = θ.ker.index := le_antisymm hAle (hKle.trans hRA)
  have h1 : θ.ker.relIndex Φ.ker = 1 := by
    refine Nat.eq_of_mul_eq_mul_right (Nat.pos_of_ne_zero hAne) ?_
    rw [one_mul, AddSubgroup.relIndex_mul_index hKA, hidx]
  have hAK : Φ.ker ≤ θ.ker := AddSubgroup.relIndex_eq_one.mp h1
  exact (hK t).mp (hAK ((hA t).mpr ht))

private theorem exists_character_free
    (V : Submodule T J) (E : J → Prop) (π : T →+* L) (IL : Ideal L) (hfin : Finite ↥V)
    (hseam : ∀ t : T, π t ∈ IL → ∀ v ∈ V, E (t • v))
    (hcyc : ∃ e₁ : ↥V → Fˣ,
      (∀ v₁ v₂, e₁ (v₁ + v₂) = e₁ v₁ * e₁ v₂) ∧
      (∀ v : ↥V, E (v : J) → e₁ v = 1) ∧
      (∀ v : ↥V, (∀ t : T, e₁ (t • v) = 1) → E (v : J)))
    (hcard : Nat.card ↥V = Nat.card (L ⧸ IL) * Nat.card {v : ↥V // E (v : J)}) :
    ∃ e₀ : ↥V → Fˣ,
      (∀ v₁ v₂, e₀ (v₁ + v₂) = e₀ v₁ * e₀ v₂) ∧
      (∀ v : ↥V, E (v : J) → e₀ v = 1) ∧
      (∀ t : T, (∀ v : ↥V, e₀ (t • v) = 1) → π t ∈ IL) := by
  obtain ⟨e₁, hadd, hkill, hsep⟩ := hcyc
  exact ⟨e₁, hadd, hkill, fun t ht =>
    apply_mem_of_forall_apply_smul_eq_one V E π IL hfin hseam e₁ hadd hkill hsep hcard t ht⟩

