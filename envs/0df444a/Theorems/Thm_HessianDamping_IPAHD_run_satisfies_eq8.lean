-- title:
--   (8), p. 10, and (IPAHD), p. 11 — every run of (IPAHD) satisfies the implicit discretization (8)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space and $f:\mathcal H\to\mathbb R$ a convex function of class $\mathcal C^1$. Let $\alpha\ge1$, $h>0$, $s=h^2$, and let $(\beta_k)$, $(b_k)$ be non-negative sequences. If $(x_k)_{k\in\mathbb N}$ is generated by (IPAHD), i.e. $x_{k+1}=\mathrm{prox}_{\mu_kf}(y_k)$ for every $k\ge1$ with
--   $\mu_k=\frac{k}{k+\alpha}(\beta_k\sqrt s+sb_k)$ and $y_k=x_k+(1-\frac{\alpha}{k+\alpha})(x_k-x_{k-1})+\beta_k\sqrt s(1-\frac{\alpha}{k+\alpha})\nabla f(x_k)$, then for every $k\ge1$
--   $$k(x_{k+1}-2x_k+x_{k-1})+\alpha(x_{k+1}-x_k)+\beta_khk\big(\nabla f(x_{k+1})-\nabla f(x_k)\big)+b_kh^2k\,\nabla f(x_{k+1})=0. \tag{8}$$
--
--   The paper obtains (IPAHD) from the implicit discretization (8) of the continuous dynamic; this statement is the converse direction, the one the proof of Theorem 4 uses.
--
--   **Formalization Note.** The hypotheses $h>0$ and $\beta_k,b_k\ge0$ are implicit on the page (the step size is positive, $\mu_k\ge0$ for the proximal step); see the Setting definition for the encoding of the proximal step.
-- source:
--   Attouch, Chbani, Fadili, Riahi, First-order optimization algorithms via inertial systems with Hessian driven damping, arXiv:1907.10536v2, §3.1.1, (8), p. 10, and (IPAHD), p. 11

import Mathlib
import Definitions.Def_GoldenRatioVI_Shared_IsProxPoint
import Definitions.Def_HessianDamping_IPAHD_Setting

namespace HessianDamping.IPAHD

/-- (8), p. 10, and (IPAHD), p. 11: every run of (IPAHD) satisfies the implicit discretization (8). -/
theorem run_satisfies_eq8
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (f : H → ℝ) (hfconv : ConvexOn ℝ Set.univ f) (hfC1 : ContDiff ℝ 1 f)
    (α : ℝ) (hα : 1 ≤ α)
    (h s : ℝ) (hh : 0 < h) (hs : s = h ^ 2)
    (β b : ℕ → ℝ) (hβ : ∀ k, 0 ≤ β k) (hb : ∀ k, 0 ≤ b k)
    (x : ℕ → H) (hx : IsIPAHDRun f α s β b x)
    (k : ℕ) (hk : 1 ≤ k) :
    (k : ℝ) • (x (k + 1) - (2 : ℝ) • x k + x (k - 1)) + α • (x (k + 1) - x k)
      + (β k * h * k) • (gradient f (x (k + 1)) - gradient f (x k))
      + (b k * h ^ 2 * k) • gradient f (x (k + 1)) = 0 := by sorry

end HessianDamping.IPAHD
