  have hτₑ : ∀ c, τₑ c = τ c := fun _ => rfl

  haveI := RingHomInvPair.of_ringEquiv τₑ.toRingEquiv
  haveI := RingHomInvPair.of_ringEquiv_symm τₑ.toRingEquiv
  let eₛₗ : ↥(cornerSubmodule (M := V) (Sp.e j₀))
      ≃ₛₗ[(↑τₑ.toRingEquiv : Sp.CornerRing j₀ →+* ↥(Aimg (D := D)))] D.ML :=
    { toFun := E.symm
