/-! # The progressive sigma-field

The sole sigma-field is characterized by measurable restrictions to every
finite horizon. It is proved equal to the sigma-field generated by native
real progressively measurable processes, as in Protter III.1. Mathlib's
`IsProgressive` and `IsStronglyProgressive` remain the process predicates.
-/

@[expose] public section

open ProbabilityTheory Set
open scoped NNReal

namespace MeasureTheory.Filtration

variable {Ω : Type*} {mΩ : MeasurableSpace Ω}

theorem _root_.Prove2MeSourceProof.h_84e43ea7d3e275425e367f8b (F : Filtration ℝ≥0 mΩ)
    {E : Type*} [MeasurableSpace E] {X : ℝ≥0 → Ω → E} :
    Measurable[F.progressive] (Function.uncurry X) ↔ IsProgressive F X := by
  constructor
  · intro h t A hA
    exact ((_root_.Prove2MeSourceProof.h_4a46693f0bd80ffadcd80499 F).mp (h hA)) t
  · intro h A hA
    exact (_root_.Prove2MeSourceProof.h_4a46693f0bd80ffadcd80499 F).mpr (fun t ↦ h t hA)
end MeasureTheory.Filtration

namespace MeasureTheory.IsProgressive

variable {Ω E : Type*} {mΩ : MeasurableSpace Ω} [MeasurableSpace E]
  {F : Filtration ℝ≥0 mΩ} {X : ℝ≥0 → Ω → E}

end MeasureTheory.IsProgressive


