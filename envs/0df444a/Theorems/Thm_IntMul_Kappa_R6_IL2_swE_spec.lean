variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

theorem IntMul.Kappa.R6.IL2.swE_spec (hτ : 0 ≤ τ) (hL : L12Canon tab l12 τ) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u : ℕ) (Pre G Suf : Shape), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      ∀ (I : List Sym) (t : IState HS) (xs : List (ZMod 2)) (R : List Item),
      t.G 0 = ints (enc2 xs) ++ R →
      xs.length = vol (binShape Pre G Suf (2 ^ u)) →
      ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (vol (binShape Pre G Suf (2 ^ u)) : ℤ) + 3 →
      eP.size + eG.size + eS.size + eU.size ≤ 50 →
      NoK eP → NoK eG → NoK eS → NoK eU →
      ESp eP t Bb (vol Pre : ℤ) → ESp eG t Bb (vol G : ℤ) → ESp eS t Bb (vol Suf : ℤ) →
      ESp eU t Bb (u : ℤ) →
      ∃ c : ℕ, IRuns I tab (swE l12 eP eG eS eU) t
        (t.upd 0 (ints (pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
          (swapPos Pre.length (Pre.length + 1 + G.length)) 0 (enc2 xs)) ++ R)) c ∧
        (c : ℝ) ≤ K * ((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) *
          (u : ℝ) ^ τ := by sorry
