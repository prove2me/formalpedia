variable (K : Type) [Field K] [NumberField K]

private theorem continuous_idelicNorm_genuineBaseChange : Continuous (genuineBaseChange ℚ K).idelicNorm := by
  unfold M4aHerbrand.AdeleBaseChange.idelicNorm
  exact Continuous.units_map _ (M4aHerbrand.GenuineDescent.continuous_adelicNorm_genuineBaseChange ℚ K)

private theorem forall_exists_idelicNorm_map_algebraMap_eq : ∀ u : Kˣ, ∃ q : ℚˣ,
    (genuineBaseChange ℚ K).idelicNorm (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) u) =
      Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ)) q := by
  intro u
  refine ⟨Units.map (Algebra.norm ℚ : K →* ℚ) u, Units.ext ?_⟩
  simp only [M4aHerbrand.AdeleBaseChange.idelicNorm, Units.coe_map, MonoidHom.coe_coe]
  exact M4aHerbrand.GenuineDescent.adelicNorm_genuineBaseChange_algebraMap ℚ K (u : K)

end LanglandsTunnell.CubicInduction.IdelicNormBaseChange
