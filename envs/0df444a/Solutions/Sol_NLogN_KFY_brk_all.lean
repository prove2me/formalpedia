theorem PushOk.tail {r : Fin HS} {e : Ex HS} {l : List (Fin HS × Ex HS)} {s : IState HS}
    (h : PushOk ((r, e) :: l) s) :
    PushOk l (s.upd r (.int (e.eval s) :: s.G r)) where
  nd := (List.nodup_cons.1 h.nd).2
  lt := fun p hp => h.lt p (by simp [hp])
  cl := fun p hp => h.cl p (by simp [hp])
  ok := fun p hp => (Ex.ok_upd s r _ p.2 (h.rd p (by simp [hp]) (r, e) (by simp))).2
    (h.ok p (by simp [hp]))
  rd := fun p hp q hq => h.rd p (by simp [hp]) q (by simp [hq])

theorem pushL_spec : ∀ (l : List (Fin HS × Ex HS)) (s : IState HS), PushOk l s →
    (NLogN.KFY.pushL l).ok s ∧
    (∀ p ∈ l, ((NLogN.KFY.pushL l).run s).G p.1 = .int (p.2.eval s) :: s.G p.1) ∧
    (∀ j, j ∉ l.map Prod.fst → ((NLogN.KFY.pushL l).run s).G j = s.G j) ∧
    ((NLogN.KFY.pushL l).run s).ip = s.ip ∧ ((NLogN.KFY.pushL l).run s).out = s.out
  | [], s, _ => by simp [NLogN.KFY.pushL, RS.ok, RS.run]
  | (r, e) :: l, s, h => by
    set s' := s.upd r (.int (e.eval s) :: s.G r) with hs'
    obtain ⟨k, hrun, hfr, hip, hout⟩ := pushL_spec l s' h.tail
    have hrl : r ∉ l.map Prod.fst := (List.nodup_cons.1 h.nd).1
    have hrun' : (NLogN.KFY.pushL ((r, e) :: l)).run s = (NLogN.KFY.pushL l).run s' := rfl
    refine ⟨⟨⟨h.lt (r, e) (by simp), h.cl (r, e) (by simp), h.ok (r, e) (by simp)⟩, k⟩, ?_, ?_,
      ?_, ?_⟩
    · intro p hp
      rw [hrun']
      simp only [List.mem_cons] at hp
      rcases hp with rfl | hp
      · rw [hfr _ hrl]; simp [hs']
      · rw [hrun p hp]
        have hpr : p.1 ≠ r := fun he => hrl (he ▸ List.mem_map_of_mem hp)
        have := Ex.eval_upd s r (.int (e.eval s) :: s.G r) p.2 (h.rd p (by simp [hp]) (r, e)
          (by simp))
        simp [hs', hpr, this]
    · intro j hj
      simp only [List.map_cons, List.mem_cons, not_or] at hj
      rw [hrun', hfr j hj.2]; simp [hs', hj.1]
    · rw [hrun', hip]; simp [hs']
    · rw [hrun', hout]; simp [hs']

theorem pushL_cost : ∀ (l : List (Fin HS × Ex HS)) (s : IState HS), PushOk l s →
    ∀ (B K : ℕ), (∀ p ∈ l, p.2.Bnd s B ∧ p.2.size ≤ K) →
    (NLogN.KFY.pushL l).cost s ≤ l.length * ((K + 1) * 10 ^ 7 * (B + 2) ^ 2) + 1
  | [], s, _, B, K, _ => by simp [NLogN.KFY.pushL, RS.cost]
  | (r, e) :: l, s, h, B, K, hb => by
    set s' := s.upd r (.int (e.eval s) :: s.G r) with hs'
    have IH := pushL_cost l s' h.tail B K (fun p hp => by
      refine ⟨?_, (hb p (by simp [hp])).2⟩
      have hr := h.rd p (by simp [hp]) (r, e) (by simp)
      exact (Ex_Bnd_upd' s r _ B p.2 hr).2 (hb p (by simp [hp])).1)
    have h1 := RS.pushCost_le e s B (hb (r, e) (by simp)).1
    have h2 : (e.size + 1) * 10 ^ 7 * (B + 2) ^ 2 ≤ (K + 1) * 10 ^ 7 * (B + 2) ^ 2 := by
      have : e.size ≤ K := (hb (r, e) (by simp)).2
      apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; omega
    show (RS.push r e).cost s + (NLogN.KFY.pushL l).cost ((RS.push r e).run s) ≤ _
    have e1 : (RS.push r e).run s = s' := rfl
    rw [e1]
    simp only [RS.cost] at h1 ⊢
    have h3 := le_trans h1 h2
    generalize (K + 1) * 10 ^ 7 * (B + 2) ^ 2 = X at h3 IH ⊢
    rw [List.length_cons, Nat.add_mul, one_mul]
    omega
where
  Ex_Bnd_upd' (s : IState HS) (j : Fin HS) (L : List Item) (B : ℕ) :
      ∀ e : Ex HS, j ∉ e.regs → (e.Bnd (s.upd j L) B ↔ e.Bnd s B)
    | .reg i, h => by
      simp only [Ex.regs, List.mem_singleton] at h
      simp only [Ex.Bnd, IState.top_upd_ne s (Ne.symm h) L]
    | .lit _, _ => Iff.rfl
    | .add a b, h | .mul a b, h | .shl a b, h | .ndiv a b, h | .nmod a b, h => by
      simp only [Ex.regs, List.mem_append, not_or] at h
      simp only [Ex.Bnd, Ex_Bnd_upd' s j L B a h.1, Ex_Bnd_upd' s j L B b h.2,
        Ex.eval_upd s j L a h.1, Ex.eval_upd s j L b h.2]
    | .quo a b, h | .rem a b, h => by
      simp only [Ex.regs, List.mem_append, not_or] at h
      simp only [Ex.Bnd, Ex_Bnd_upd' s j L B a h.1, Ex_Bnd_upd' s j L B b h.2]
    | .neg a, h => by simp only [Ex.regs] at h; simp only [Ex.Bnd, Ex_Bnd_upd' s j L B a h]
    | .pow2 a, h => by
      simp only [Ex.regs] at h
      simp only [Ex.Bnd, Ex_Bnd_upd' s j L B a h, Ex.eval_upd s j L a h]
    | .sel c x y, h => by
      simp only [Ex.regs, List.mem_append, not_or] at h
      simp only [Ex.Bnd, Ex_Bnd_upd' s j L B c h.1.1, Ex_Bnd_upd' s j L B x h.1.2,
        Ex_Bnd_upd' s j L B y h.2, Ex.eval_upd s j L c h.1.1]

theorem popL_spec : ∀ (l : List (Fin HS)) (s : IState HS) (B : ℕ), PopOk l s B →
    (popL l).ok s ∧
    (∀ j, ((popL l).run s).G j = if j ∈ l then (s.G j).tail else s.G j) ∧
    ((popL l).run s).ip = s.ip ∧ ((popL l).run s).out = s.out ∧
    (popL l).cost s ≤ l.length * (2 * B + 2) + 1
  | [], s, B, _ => by simp [popL, RS.ok, RS.run, RS.cost]
  | r :: l, s, B, h => by
    obtain ⟨hnd, hv⟩ := h
    have hrl : r ∉ l := (List.nodup_cons.1 hnd).1
    obtain ⟨hr56, v, L, ev, hvB⟩ := hv r (by simp)
    set s' := s.upd r L with hs'
    have hpop : (RS.pop r).run s = s' := by simp [RS.run, ev, hs']
    have h' : PopOk l s' B := ⟨(List.nodup_cons.1 hnd).2, fun q hq => by
      obtain ⟨a, w, M, e2, e3⟩ := hv q (by simp [hq])
      have hqr : q ≠ r := fun he => hrl (he ▸ hq)
      exact ⟨a, w, M, by simp [hs', hqr, e2], e3⟩⟩
    obtain ⟨k, hrun, hip, hout, hc⟩ := popL_spec l s' B h'
    have hrun' : (popL (r :: l)).run s = (popL l).run s' := by
      show (popL l).run ((RS.pop r).run s) = _; rw [hpop]
    refine ⟨⟨⟨hr56, IState.isInt_of ev⟩, by rw [hpop]; exact k⟩, ?_, ?_, ?_, ?_⟩
    · intro j
      rw [hrun', hrun j]
      by_cases j1 : j = r
      · subst j1; simp [hrl, hs', ev]
      · by_cases j2 : j ∈ l
        · simp [j2, hs', j1]
        · simp [j1, j2, hs']
    · rw [hrun', hip]; simp [hs']
    · rw [hrun', hout]; simp [hs']
    · show (RS.pop r).cost s + (popL l).cost ((RS.pop r).run s) ≤ _
      rw [hpop]
      simp only [RS.cost, IState.top_eq ev, List.length_cons]
      nlinarith

