variable {E : ℕ}
theorem solution (ext : Fin E → NLogN.IStmt NLogN.HS (7 + E)) : ∃ (A : ℕ) (Kc : ℝ), 0 < Kc ∧
    ∀ (Isym : List NLogN.Sym) {K r Z : ℕ}, 6 ≤ K → 1 ≤ r → 80 * Z * (Z + 2) ≤ 2 ^ K →
    let CR : ℝ := Kc * (K + 2) + 1
    let Ψ : ℕ → ℕ := NLogN.KFR.PsiR r Z
    ∀ {P D S ρ : ℕ} (hρ : ρ < K), 1 ≤ S → 1 ≤ P → 1 ≤ D →
    NLogN.zsz ((32 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ) ≤ Z →
    ∃ (Cc : ℕ → NLogN.IStmt NLogN.HS (7 + E)) (E dC : ℕ) (kC : ℕ → ℕ),
      E ≤ D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * ((Nat.log (100 ^ 3) D + 1) *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ Nat.log (100 ^ 3) D) ∧
      dC ≤ 2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 * (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
        NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2)) ∧
      (∀ w, (kC w : ℝ) ≤ (2 * ((((Nat.log (100 ^ 3) D + 1) * 100 ^ 3 : ℕ) : ℝ) *
          ((100000 + (Nat.log (100 ^ 3) D : ℝ) *
            (((P8Lift.sc + P8Lift.complexIface.net.length) * NLogN.KFN.alN P8Lift.Wc A + 1 : ℕ) : ℝ) +
            (Nat.log (100 ^ 3) D : ℝ) *
              (2 * (((P8Lift.sc + P8Lift.complexIface.net.length : ℕ) : ℝ) * CR))) *
            (D : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFN.τ50) + 1) + 1000000 * (((Nat.log (100 ^ 3) D * 71 : ℕ) : ℝ) + 2)) *
        ((AModel.vol (Butterfly.layerShape P K D S) : ℕ) : ℝ) *
        (NLogN.KFN.Xf r Ψ (w + 2 * D + (Nat.log (100 ^ 3) D + 1) * 100 ^ 3 *
          (4 * (Nat.log (100 ^ 3) D + 1) ^ 2 *
            NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2)) +
          20 * (Nat.log (100 ^ 3) D + 1) ^ 3 *
            NLogN.KFN.Gb P8Lift.complexIface.net.length P8Lift.sc P8Lift.Wc A ^ (Nat.log (100 ^ 3) D + 2) +
          2) : ℝ)) ∧
      ∀ (st : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
        (xs : List (Fin r → ℂ)) (p w : ℕ), NLogN.KFH.RecRep r p zs xs →
        xs.length = AModel.vol (Butterfly.layerShape P K D S) → f 0 = NLogN.KFB.gflat zs ++ l → NLogN.KFN.ClN f →
        NLogN.KFB.GB w zs → (∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) →
        ∃ zs', NLogN.KFH.RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
            (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) ∧
          NLogN.KFB.GB (p + 1) zs' ∧
          (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p
              (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs).length)
            (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
            ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p
              (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs)[j] c -
              (Butterfly.layerH P K D S ρ hρ xs)[j] c‖ < Real.sqrt 2 * 2⁻¹ ^ p) ∧
          NLogN.IRuns Isym (NLogN.KFM.kTable ext) (NLogN.KFM.p14Ph P K D S ρ r E dC Cc w) (NLogN.KIL.encK st f)
            (NLogN.KIL.encK st (Function.update f 0 (NLogN.KFB.gflat zs' ++ l)))
            (kC w + NLogN.KFM.cWrapPh P K D S r E
              (NLogN.zsz ((16 * (AModel.vol (Butterfly.layerShape P K D S) * r) : ℕ) : ℤ)) w dC) := by
  obtain ⟨Kc, hKc, HR⟩ := IntMul.OpenAI.R129.P.NLogN.KFM.kTable_rowHyp ext
  obtain ⟨A, hA⟩ := NLogN.KFN.complexIface_gclass
  refine ⟨A, Kc, hKc, fun Isym K r Z hK hr hKZ => ?_⟩
  obtain ⟨hrow, hCR, hmono, hZΨ⟩ := HR Isym hK hr hKZ
  intro CR Ψ P D S ρ hρ hS hP hD hZ
  have H := IntMul.OpenAI.R129.P.NLogN.KFM.prop14Ph_closedA hA hrow hCR hr hmono hZΨ hρ hS hP hD hZ
  rw [IntMul.OpenAI.R129.P.NLogN.KFM.lam_complex_eq] at H
  exact H
end
