-- title:
--   A limit of far arcs that is not an arc ends in a collision or a vertical tangency
-- statement:
--   Fix $0<\mu<1$ and a Jacobi energy $-c$ below the first critical value. Let $\Sigma_{\mu,c}$ be the selected Levi-Civita component and $\varphi$ a continuous flow on it generated by the Hamiltonian vector field of $K_{\mu,c}$. A state is $s=(z_1,z_2,w_1,w_2)$. Its physical position relative to the primary is $(x_1,x_2)=(2(z_1^2-z_2^2),\,4z_1z_2)$, and $(v_1,v_2)$ is its physical (Jacobi) velocity. A collision state has $z=0$. $N(r)$ and $F(r)$ are the perpendicular near and far starts at $z=(r,0)$ and $z=(0,r)$.
--
--   **Far limit orbits.** Let $s$ and $T$ be as in the far axis-contact exclusion: $z_1=0$, $z_2>0$, $v_2(s)<0$, with $x_2\le0$, $v_1>0$ and $z\ne0$ along $\varphi_ts$ for $0<t<T$. Assume in addition that
--   $$x_1(\varphi_Ts)=0,\qquad x_2(\varphi_Ts)\le0,\qquad v_1(\varphi_Ts)\ge0,$$
--   and that $s$ admits no far shooting arc. Then $x_2<0$ on $(0,T)$, and $\varphi_Ts$ is either a collision state, or has $x_2<0$ and $v_1=0$ (a vertical tangency below the axis).
-- source:
--   Birkhoff 1915, The restricted problem of three bodies, §§16–18 (Collected Mathematical Papers Vol. 1, pp. 731–741); Liu–Salomão, arXiv 2506.17867v2, §5, pp. 30–31

import Definitions.Def_BirkhoffShootingArcs

namespace BirkhoffGlobalSection

theorem birkhoff_far_limit_end (μ c : ℝ)
    (hμ0 : 0 < μ) (hμ1 : μ < 1)
    (hc : belowFirstCriticalValue μ c)
    (φ : Flow ℝ (LeftEnergyState μ c))
    (hφ : IsLeviCivitaHamiltonianFlow μ c φ)
    (x : LeftEnergyState μ c) (T : ℝ) (hT : 0 < T)
    (hx0 : (x : Phase) 0 = 0) (hx1 : 0 < (x : Phase) 1)
    (hv : jacobiVelocity (leviCivitaToJacobi μ (x : Phase)) 1 < 0)
    (hcl : ∀ t ∈ Set.Ioo 0 T, relativePosition μ ((φ t x : LeftEnergyState μ c) : Phase) 1 ≤ 0)
    (hvx : ∀ t ∈ Set.Ioo 0 T, 0 < jacobiVelocity (leviCivitaToJacobi μ ((φ t x : LeftEnergyState μ c) : Phase)) 0)
    (hP : ∀ t ∈ Set.Ioo 0 T, 0 < zNormSq ((φ t x : LeftEnergyState μ c) : Phase))
    (hX : relativePosition μ ((φ T x : LeftEnergyState μ c) : Phase) 0 = 0)
    (hY : relativePosition μ ((φ T x : LeftEnergyState μ c) : Phase) 1 ≤ 0)
    (hVxT : 0 ≤ jacobiVelocity (leviCivitaToJacobi μ ((φ T x : LeftEnergyState μ c) : Phase)) 0)
    (hno : ¬ ∃ τ : ℝ, IsFarShootingArc φ x τ) :
    (∀ t ∈ Set.Ioo 0 T, relativePosition μ ((φ t x : LeftEnergyState μ c) : Phase) 1 < 0) ∧
    ((((φ T x : LeftEnergyState μ c) : Phase) 0 = 0 ∧ ((φ T x : LeftEnergyState μ c) : Phase) 1 = 0) ∨
      (relativePosition μ ((φ T x : LeftEnergyState μ c) : Phase) 1 < 0 ∧ jacobiVelocity (leviCivitaToJacobi μ ((φ T x : LeftEnergyState μ c) : Phase)) 0 = 0)) := by sorry

end BirkhoffGlobalSection
