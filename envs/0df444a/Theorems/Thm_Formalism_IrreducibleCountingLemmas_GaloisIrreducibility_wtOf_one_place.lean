variable {ι Ω : Type} [Fintype ι] [Fintype Ω] [DecidableEq ι]

theorem Formalism.IrreducibleCountingLemmas.GaloisIrreducibility.wtOf_one_place (P : Ω → ℝ) (hP : ∑ c, P c = 1) (S : Set Ω) (v₀ : ι) :
    wtOf (fun x : ι → Ω => ∏ v, P (x v)) {x | x v₀ ∈ S} = wtOf P S := by sorry
