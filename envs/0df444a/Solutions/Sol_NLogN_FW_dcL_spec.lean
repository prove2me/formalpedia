      apply ih _ _ _ (Or.inr rfl)
      -- W - (e - B) = B * ((W - (e - B)) / B) and the rest
      have hq : B ∣ W - (e - B) := by
        have := dvd_add hd1 (dvd_refl B); rw [show W - e + B = W - (e - B) by ring] at this
        exact this
      obtain ⟨q, hq⟩ := hq
      rw [hq, Int.mul_ediv_cancel_left _ hB0.ne']
