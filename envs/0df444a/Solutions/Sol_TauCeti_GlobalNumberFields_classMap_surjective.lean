/-- Transition from a larger modulus to any divisor is surjective. -/
theorem solution {𝔪 𝔫 : _root_.TauCeti.GlobalNumberFields.Modulus K} (h : 𝔪 ∣ 𝔫) :
    _root_.Function.Surjective (_root_.TauCeti.GlobalNumberFields.classMap h) := by
  classical
  intro c
  obtain ⟨I, rfl⟩ := _root_.TauCeti.GlobalNumberFields.rayClassMk_surjective 𝔪 c
  choose p hp using fun v : _root_.IsDedekindDomain.HeightOneSpectrum (_root_.NumberField.RingOfIntegers K) ↦
    v.valuation_surjective K
      (_root_.WithZero.exp (_root_.FractionalIdeal.count K v I.1.1))
  let a : _root_.IsDedekindDomain.HeightOneSpectrum (_root_.NumberField.RingOfIntegers K) → K := fun v ↦
    if v ∈ 𝔪.support then 1 else p v
  let γ := fun v : _root_.IsDedekindDomain.HeightOneSpectrum (_root_.NumberField.RingOfIntegers K) ↦
    if v ∈ 𝔪.support then _root_.WithZero.exp (-(𝔪.exponent v : ℤ))
    else _root_.WithZero.exp (_root_.FractionalIdeal.count K v I.1.1)
  obtain ⟨x, hx, hsign⟩ := _root_.TauCeti.GlobalNumberFields.exists_fieldUnit_valuation_sub_lt_and_signHom_eq
    (S := 𝔫.support) a γ (fun v _ ↦ by
      dsimp [γ]
      split <;> exact _root_.WithZero.exp_ne_zero) 1
  have hxm : _root_.TauCeti.GlobalNumberFields.IsCongrOne 𝔪 x := by
    rw [_root_.TauCeti.GlobalNumberFields.isCongrOne_iff]
    refine ⟨fun v hv ↦ ?_, fun w _ ↦ ?_⟩
    · have hvm : v ∈ 𝔪.support := (_root_.TauCeti.GlobalNumberFields.Modulus.mem_support_iff 𝔪 v).mpr hv
      simpa only [a, γ, _root_.if_pos hvm] using
        (hx v (_root_.TauCeti.GlobalNumberFields.Modulus.support_mono h hvm)).le
    · rw [← _root_.TauCeti.GlobalNumberFields.signHom_apply_eq_one_iff x w, hsign]
      rfl
  let J : _root_.TauCeti.GlobalNumberFields.idealsPrimeTo 𝔫 := ⟨I.1 * _root_.toPrincipalIdeal (_root_.NumberField.RingOfIntegers K) K x,
    NumberFieldArithmetic.mem_idealsAway_iff.mpr (by
    intro v hv
    rw [_root_.Units.val_mul, _root_.FractionalIdeal.count_mul K v (_root_.Units.ne_zero I)
      (_root_.Units.ne_zero (_root_.toPrincipalIdeal (_root_.NumberField.RingOfIntegers K) K x)),
      _root_.FractionalIdeal.count_toPrincipalIdeal_eq_neg_log_valuation]
    by_cases hvm : v ∈ 𝔪.support
    · rw [NumberFieldArithmetic.mem_idealsAway_iff.mp I.2 v hvm,
        hxm.valuation_eq_one ((_root_.TauCeti.GlobalNumberFields.Modulus.mem_support_iff 𝔪 v).mp hvm)]
      simp
    · have hval : v.valuation K (x : K) = _root_.WithZero.exp
          (_root_.FractionalIdeal.count K v I.1.1) := by
        calc
          v.valuation K (x : K) = v.valuation K (p v) :=
            _root_.Valuation.map_eq_of_sub_lt _ (by
              have hlt := hx v hv
              simp only [a, γ, _root_.if_neg hvm] at hlt
              rw [hp v]
              exact hlt)
          _ = _ := hp v
      rw [hval, _root_.WithZero.log_exp]
      ring)⟩
  refine ⟨_root_.TauCeti.GlobalNumberFields.rayClassMk 𝔫 J, ?_⟩
  rw [_root_.TauCeti.GlobalNumberFields.classMap_rayClassMk]
  let xm : _root_.TauCeti.GlobalNumberFields.primeToSubgroup 𝔪 :=
    ⟨x, _root_.TauCeti.GlobalNumberFields.congruenceSubgroup_le_primeToSubgroup 𝔪 (mem_congruenceSubgroup.mpr hxm)⟩
  have hJ : _root_.TauCeti.NumberFieldArithmetic.idealsAwayInclusion (_root_.TauCeti.GlobalNumberFields.Modulus.support_mono h) J =
      I * _root_.TauCeti.GlobalNumberFields.principalIdealPrimeTo 𝔪 xm := by
    apply _root_.Subtype.ext
    apply _root_.Units.ext
    rw [_root_.TauCeti.NumberFieldArithmetic.coe_idealsAwayInclusion, _root_.Subgroup.coe_mul,
      _root_.TauCeti.GlobalNumberFields.coe_principalIdealPrimeTo]
  rw [hJ, _root_.map_mul]
  rw [← _root_.TauCeti.GlobalNumberFields.principalRayClass_apply, _root_.TauCeti.GlobalNumberFields.principalRayClass_eq_one_of_isCongrOne hxm, _root_.mul_one]







