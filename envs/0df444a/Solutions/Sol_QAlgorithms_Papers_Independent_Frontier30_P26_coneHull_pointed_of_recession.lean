theorem G53Cone.main {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (C : Set E)
    (hc : IsClosed C) (hv : Convex ℝ C) (hr : Pointed (recession C)) (hz : (0 : E) ∉ C) :
    Pointed (closedConeHull C) := by
  have hzero : ∀ D : Set E, ClosedCone D → (0 : E) ∈ D := fun D hD => hD.2.2.1
  have h0K : (0 : E) ∈ closedConeHull C := by
    rw [closedConeHull, mem_sInter]; intro D hD; exact hzero D hD.1
  intro v hv1 hv2
  have hvK : v ∈ closedConeHull C := by simpa using hv1 0 h0K
  have hnvK : -v ∈ closedConeHull C := by simpa using hv2 0 h0K
  rcases C.eq_empty_or_nonempty with hCe | hne
  · have hD : ClosedCone ({0} : Set E) := ⟨isClosed_singleton, convex_singleton 0, rfl, by
      intro t _ x hx; rw [mem_singleton_iff] at hx ⊢; rw [hx, smul_zero]⟩
    have := sInter_subset_of_mem (show ({0} : Set E) ∈ {D : Set E | ClosedCone D ∧ C ⊆ D} from
      ⟨hD, by rw [hCe]; exact empty_subset _⟩) hvK
    simpa using this
  · have hsub : closedConeHull C ⊆ closure (G53Cone.coneOf C) :=
      sInter_subset_of_mem ⟨G53Cone.closure_coneOf_closedCone hv hne, G53Cone.subset_closure_coneOf C⟩
    have A := G53Cone.closure_coneOf hc hv hz (hsub hvK)
    have B := G53Cone.closure_coneOf hc hv hz (hsub hnvK)
    -- helper: t • c ∈ C-cone and its negative in recession ⇒ t = 0 (else 0 ∈ C)
    have key : ∀ w : E, w ∈ G53Cone.coneOf C → -w ∈ recession C → w = 0 := by
      rintro w ⟨t, ht, c, hc', rfl⟩ hw
      rcases ht.eq_or_lt with h0 | hpos
      · rw [← h0, zero_smul]
      · exfalso; apply hz
        have := G53Cone.rec_smul hv hw hc' (inv_nonneg.mpr hpos.le)
        rwa [smul_neg, smul_smul, inv_mul_cancel₀ hpos.ne', one_smul, add_neg_cancel] at this
    rcases A with hA | hA <;> rcases B with hB | hB
    · obtain ⟨t, ht, c, hc1, rfl⟩ := hA
      obtain ⟨s, hs, c', hc2, hcs⟩ := hB
      rcases (add_nonneg ht hs).eq_or_lt with h0 | hpos
      · have : t = 0 := by linarith
        rw [this, zero_smul]
      · exfalso; apply hz
        have hmem := hv hc1 hc2 (div_nonneg ht hpos.le) (div_nonneg hs hpos.le)
          (by rw [← add_div]; exact div_self hpos.ne')
        convert hmem using 1
        have : t • c + s • c' = 0 := by rw [← hcs]; simp
        rw [div_eq_inv_mul, div_eq_inv_mul, ← smul_smul, ← smul_smul, ← smul_add, this, smul_zero]
    · exact key v hA (by simpa using hB)
    · have := key (-v) hB (by simpa using hA); simpa using this
    · have rr : ∀ w : E, w ∈ recession C → w ∈ recession (recession C) := by
        intro w hw u hu c hc'
        rw [← add_assoc]; exact hw _ (hu c hc')
      exact hr v (rr v hA) (rr _ hB)

