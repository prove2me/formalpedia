/-- **Cost of the chirp table program**: `O(T·K·B²)` for the request keys (the chirp index of
every position, `K` quadratic steps each), `2r` twiddle calls, and `O(kb·(2r+T)·(B+kb))` for the
sort, scan and gather. -/
theorem chirpP_cost (M : MulSpec) (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (tw : RM)
    (Ctw : ℕ) (htw : TwSpec M tw q.p (2 * q.r) Ctw) (s : IState HS) (hw : ChirpRegs q s)
    (LP : List Item) (hp : s.G hPp = .int q.p :: LP) (kb : ℕ) (L2 : List Item)
    (h2 : s.G 2 = .int kb :: L2) (hkb1 : 4 * q.r ≤ 2 ^ kb) (hkb2 : q.tdims.prod ≤ 2 ^ kb)
    (B : ℕ) (hB : ChirpB q B) (hv : TwB q.p (2 * q.r) B)
    (hBig : 8 * q.r + 3 * q.tdims.prod + 4 < 2 ^ B) (hkbB : kb + 2 ≤ B) :
    (chirpP tw).cost M s ≤ (q.tdims.prod + 1) * (q.K + 6) * (2 * 10 ^ 9) * (B + 2) ^ 2 +
      (2 * q.r + 1) * (Ctw + 3 * 10 ^ 9 * (B + 2) ^ 2) +
      10 ^ 7 * (kb + 1) * (2 * q.r + q.tdims.prod + 1) * (B + kb + 6) := by
  have c1 := reqGen_cost q he hdh s hw B hB
  obtain ⟨-, r1⟩ := reqGen_spec q he hdh s hw
  set s1 := s.upd 0 (ints ((List.range q.tdims.prod).map (reqRec (chirpKey q))).flatten ++ s.G 0)
    with hs1
  obtain ⟨LM, hm⟩ := hw.m2
  obtain ⟨LT, ht⟩ := hw.tt
  rw [two_r] at hm
  have c2 := tabGen_cost M tw q.p (2 * q.r) Ctw htw s1 LP LM (by simp +decide [hs1, hp])
    (by simp +decide [hs1, hm]) B (by omega) hv
  obtain ⟨-, r2⟩ := tabGen_spec M tw q.p (2 * q.r) Ctw htw s1 LP LM (by simp +decide [hs1, hp])
    (by simp +decide [hs1, hm])
  set s2 := s1.upd 0 (ints ((List.range (2 * q.r)).map (tabRec (twD q.p (2 * q.r)))).flatten ++
    s1.G 0) with hs2
  have c3 := chirpTail_cost (twD q.p (2 * q.r)) (chirpKey q) (2 * q.r) q.tdims.prod kb
    (fun x _ => chirpKey_lt q x) (by omega) hkb2 s2 (s.G 0) LM LT L2
    (by simp [hs2, hs1, mergeL, ints_append])
    (by simp +decide [hs2, hs1, hm]) (by simp +decide [hs2, hs1, ht])
    (by simp +decide [hs2, hs1, h2]) B hv (by omega) hkbB
  have tot := rm_seq_cost_rs r1 c1 (rm_seq_cost (M := M) r2 c2 (b := RM.rs chirpTail) c3)
  refine le_trans tot (le_of_eq ?_)
  ring

end NLogN.CR

