-- ===== S4.Def_RP_EtPBC_A_DescB =====
section

/-!
# S4-EtPBC-A, R4-T1b (algebra part): descent data from locally constant functions, and localization

* `fib c hc ν`: for `c : PrimeSpectrum R → N` locally constant, the idempotent of the clopen `{c = ν}`
  (`fib_not_mem`: `fib c hc ν ∉ P ↔ c P = ν`); `idem_ext` (idempotents are determined by their primes),
  `fib_mul_ne`, `fib_sum`, `fib_map` (naturality along ring maps).
* **`mkDatum c hc hdiag hcoc : Datum A C N`** from a locally constant `c` on `Spec (C ⊗[A] C)` that vanishes on the
  diagonal and satisfies the cocycle identity pointwise.
* `mapB`: the map of descended algebras induced by compatible maps; `mapB_id`, `mapB_comp`, `mapB_algebraMap`.
* `psiMap ρA φC hφC : C ⊗[A] C →+* C' ⊗[A'] C'`; `psiMap_ker` (kernel is `r`-power torsion when `A'`, `C'` are the
  localizations away from `r`).
* **`isLocalizationAway_B`**: then `D'.B` is the localization of `D.B` away from `r` (input of `Coequifibered`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.DescA

universe u

open TensorProduct

section Idem

variable {R : Type u} [CommRing R]

theorem idem_ext {e f : R} (he : IsIdempotentElem e) (hf : IsIdempotentElem f)
    (h : ∀ P : PrimeSpectrum R, e ∉ P.asIdeal ↔ f ∉ P.asIdeal) : e = f := by
  have h' : PrimeSpectrum.isIdempotentElemEquivClopens (R := R) ⟨e, he⟩ =
      PrimeSpectrum.isIdempotentElemEquivClopens ⟨f, hf⟩ := by
    apply TopologicalSpace.Clopens.ext
    rw [PrimeSpectrum.coe_isIdempotentElemEquivClopens_apply,
      PrimeSpectrum.coe_isIdempotentElemEquivClopens_apply]
    ext P
    exact h P
  exact congrArg Subtype.val (PrimeSpectrum.isIdempotentElemEquivClopens.injective h')

theorem not_mem_mul (P : PrimeSpectrum R) (a b : R) :
    a * b ∉ P.asIdeal ↔ a ∉ P.asIdeal ∧ b ∉ P.asIdeal := by
  rw [P.isPrime.mul_mem_iff_mem_or_mem, not_or]

theorem eq_one_of_idem {e : R} (he : IsIdempotentElem e) (h : ∀ P : PrimeSpectrum R, e ∉ P.asIdeal) :
    e = 1 :=
  idem_ext he IsIdempotentElem.one fun P => ⟨fun _ => P.isPrime.one_notMem, fun _ => h P⟩

theorem eq_zero_of_idem {e : R} (he : IsIdempotentElem e) (h : ∀ P : PrimeSpectrum R, e ∈ P.asIdeal) :
    e = 0 :=
  idem_ext he IsIdempotentElem.zero fun P =>
    ⟨fun h' => absurd (h P) h', fun h' => absurd P.asIdeal.zero_mem h'⟩

theorem not_mem_comap {S : Type u} [CommRing S] (φ : R →+* S) (x : R) (P : PrimeSpectrum S) :
    φ x ∉ P.asIdeal ↔ x ∉ (PrimeSpectrum.comap φ P).asIdeal := Iff.rfl

section Orth

variable {ι : Type*} [Fintype ι] (g : ι → R)

theorem mul_sum_orth (hg : ∀ i, IsIdempotentElem (g i)) (ho : ∀ i j, i ≠ j → g i * g j = 0) (i : ι) :
    g i * ∑ j, g j = g i := by
  rw [Finset.mul_sum, Finset.sum_eq_single i]
  · exact hg i
  · intro j _ hj
    exact ho i j (Ne.symm hj)
  · intro h
    exact absurd (Finset.mem_univ i) h

theorem isIdem_sum_orth (hg : ∀ i, IsIdempotentElem (g i)) (ho : ∀ i j, i ≠ j → g i * g j = 0) :
    IsIdempotentElem (∑ j, g j) := by
  unfold IsIdempotentElem
  rw [Finset.sum_mul]
  exact Finset.sum_congr rfl fun i _ => mul_sum_orth g hg ho i

theorem not_mem_sum_orth (hg : ∀ i, IsIdempotentElem (g i)) (ho : ∀ i j, i ≠ j → g i * g j = 0)
    (P : PrimeSpectrum R) : (∑ j, g j) ∉ P.asIdeal ↔ ∃ i, g i ∉ P.asIdeal := by
  constructor
  · intro h
    by_contra h'
    push Not at h'
    exact h (Ideal.sum_mem _ fun i _ => h' i)
  · rintro ⟨i, hi⟩ h
    have h2 := P.asIdeal.mul_mem_left (g i) h
    rw [mul_sum_orth g hg ho i] at h2
    exact hi h2

end Orth

variable {N : Type u}

/-- The idempotent of the clopen fibre `{c = ν}` of a locally constant function on `Spec R`. -/
def fib (c : PrimeSpectrum R → N) (hc : IsLocallyConstant c) (ν : N) : R :=
  (PrimeSpectrum.isIdempotentElemEquivClopens.symm ⟨{P | c P = ν}, hc.isClopen_fiber ν⟩).1

theorem fib_isIdem (c : PrimeSpectrum R → N) (hc : IsLocallyConstant c) (ν : N) :
    IsIdempotentElem (fib c hc ν) :=
  (PrimeSpectrum.isIdempotentElemEquivClopens.symm _).2

theorem fib_not_mem (c : PrimeSpectrum R → N) (hc : IsLocallyConstant c) (ν : N) (P : PrimeSpectrum R) :
    fib c hc ν ∉ P.asIdeal ↔ c P = ν := by
  rw [← PrimeSpectrum.mem_basicOpen, fib, PrimeSpectrum.basicOpen_isIdempotentElemEquivClopens_symm]
  rfl

theorem fib_mul_ne (c : PrimeSpectrum R → N) (hc : IsLocallyConstant c) {ν μ : N} (h : ν ≠ μ) :
    fib c hc ν * fib c hc μ = 0 :=
  eq_zero_of_idem ((fib_isIdem c hc ν).mul (fib_isIdem c hc μ)) fun P => by
    by_contra h'
    rw [not_mem_mul, fib_not_mem, fib_not_mem] at h'
    exact h (h'.1.symm.trans h'.2)

theorem fib_sum [Fintype N] [DecidableEq N] (c : PrimeSpectrum R → N) (hc : IsLocallyConstant c) :
    ∑ ν, fib c hc ν = 1 :=
  eq_one_of_idem (isIdem_sum_orth _ (fib_isIdem c hc) fun _ _ h => fib_mul_ne c hc h) fun P => by
    rw [not_mem_sum_orth _ (fib_isIdem c hc) (fun _ _ h => fib_mul_ne c hc h)]
    exact ⟨c P, (fib_not_mem c hc _ P).mpr rfl⟩

theorem fib_map {S : Type u} [CommRing S] (φ : R →+* S) (c : PrimeSpectrum R → N)
    (hc : IsLocallyConstant c) (c' : PrimeSpectrum S → N) (hc' : IsLocallyConstant c')
    (h : ∀ P, c' P = c (PrimeSpectrum.comap φ P)) (ν : N) :
    φ (fib c hc ν) = fib c' hc' ν := by
  refine idem_ext ((fib_isIdem c hc ν).map φ) (fib_isIdem c' hc' ν) fun P => ?_
  rw [fib_not_mem c' hc' ν P, h, not_mem_comap, fib_not_mem]

/-- `fib_not_mem` after an algebra map. -/
theorem fib_algMap_not_mem {A S T : Type u} [CommRing A] [CommRing S] [CommRing T] [Algebra A S]
    [Algebra A T] (φ : S →ₐ[A] T) (c : PrimeSpectrum S → N) (hc : IsLocallyConstant c) (ν : N)
    (P : PrimeSpectrum T) :
    φ (fib c hc ν) ∉ P.asIdeal ↔ c (PrimeSpectrum.comap φ.toRingHom P) = ν :=
  fib_not_mem c hc ν (PrimeSpectrum.comap φ.toRingHom P)

end Idem

section Mk

end Mk

section Map

variable {A C A' C' A'' C'' : Type u} [CommRing A] [CommRing C] [Algebra A C] [CommRing A'] [CommRing C']
  [Algebra A' C'] [CommRing A''] [CommRing C''] [Algebra A'' C''] {N : Type u} [AddCommGroup N] [Fintype N]
  [DecidableEq N]

/-- The map `C ⊗[A] C → C' ⊗[A'] C'` induced by `ρA : A → A'` and a compatible `φC : C → C'`. -/
def psiMap (ρA : A →+* A') (φC : C →+* C')
    (hφC : ∀ a, φC (algebraMap A C a) = algebraMap A' C' (ρA a)) : C ⊗[A] C →+* C' ⊗[A'] C' :=
  letI : Algebra A (C' ⊗[A'] C') := ((algebraMap A' (C' ⊗[A'] C')).comp ρA).toAlgebra
  (Algebra.TensorProduct.productMap
    { toRingHom := (j1 A' C').toRingHom.comp φC
      commutes' := fun a => by
        show j1 A' C' (φC (algebraMap A C a)) = algebraMap A' (C' ⊗[A'] C') (ρA a)
        rw [hφC, AlgHom.commutes] }
    { toRingHom := (j2 A' C').toRingHom.comp φC
      commutes' := fun a => by
        show j2 A' C' (φC (algebraMap A C a)) = algebraMap A' (C' ⊗[A'] C') (ρA a)
        rw [hφC, AlgHom.commutes] }).toRingHom

end Map

end RamanujanPetersson.EtPBC.DescA

