variable {S : Type} [CommRing S] [Algebra ℚ S] {d : ℕ}

theorem Formalism.MainNotions.ModuliIntegralCharts.H1.CIndFrFix2c.formal_log_add_first_two (G : FGLaw S d) (l : Fin d) :
    ev (n := 3) ![G.add (pt S d 0) (pt S d 1)] (LogPf.logOf G l) =
      ev (n := 3) ![pt S d 0] (LogPf.logOf G l) + ev (n := 3) ![pt S d 1] (LogPf.logOf G l) := by sorry
