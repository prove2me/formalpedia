section
-- Source module: Solutions.KFWCost1
/-!
# KFW: cost units of the uniform level procedure

All costs of the level procedure are evaluated at widths in the window `[0, H]` (plus small
offsets and the scale `ES k ≤ H`), so they are bounded by multiples of the **cost unit**

  `Yu r Z H = r (2H + 21) + (Z + 2)³`

(per record).  This file bounds the elementary cost pieces (`cAtom`, `cPhU`, push and move
overheads, `pow2Cost`) by multiples of `n · Yu`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

theorem yu_z (r Z H : ℕ) : (Z + 2) ^ 3 ≤ Yu r Z H := Nat.le_add_left _ _

theorem yu_r (r Z H : ℕ) : r * (2 * H + 21) ≤ Yu r Z H := Nat.le_add_right _ _

theorem yu_z2 (r Z H : ℕ) : (Z + 2) ^ 2 ≤ Yu r Z H := by
  have : (Z + 2) ^ 2 ≤ (Z + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  exact this.trans (yu_z r Z H)

theorem yu_z1 (r Z H : ℕ) : Z + 2 ≤ Yu r Z H := by
  have : Z + 2 ≤ (Z + 2) ^ 2 := by nlinarith
  exact this.trans (yu_z2 r Z H)

theorem yu_8 (r Z H : ℕ) : 8 ≤ Yu r Z H := by
  have : 2 ^ 3 ≤ (Z + 2) ^ 3 := Nat.pow_le_pow_left (by omega) 3
  exact le_trans (by simpa using this) (yu_z r Z H)

theorem moveCost_Y (Z r H : ℕ) : moveCost Z ≤ 50 * Yu r Z H := by
  unfold moveCost
  have := yu_z1 r Z H
  omega

end NLogN.KFW

end

section
-- Source module: Solutions.KFWCost2
/-!
# KFW: cost bounds of the local steps, the wrapper and the leaf

With `P = (W n) · Yu r Z H` (`n` records per role, `W` roles):

* `cWrapQ_Y`: the role wrapper adds `≤ 10^12 (W + 2) P`;
* `cost_gate`, `cost_perm`, `cost_phase`, `cost_fixG`: every local step costs `≤ Mloc P`;
* `cost_leaf`: the leaf costs `≤ 10^12 n Yu`;
* `costL_win`: a windowed sum of step costs.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

theorem cFrame_Y (N sz r Z H : ℕ) : cFrame N sz Z ≤ N * (sz + 1) * 10 ^ 8 * Yu r Z H + 1 := by
  unfold cFrame
  have h1 := yu_z2 r Z H
  have h2 := moveCost_Y Z r H
  set Y := Yu r Z H
  have : sz * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost Z + 19) ≤ (sz + 1) * 10 ^ 8 * Y := by
    have a : sz * 10 ^ 7 * (Z + 2) ^ 2 ≤ sz * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h1
    have hY8 := yu_8 r Z H
    have e : (sz + 1) * 10 ^ 8 * Y = sz * 10 ^ 7 * Y + (9 * sz * 10 ^ 7 * Y + 10 ^ 8 * Y) := by ring
    omega
  have := Nat.mul_le_mul_left N this
  have e : N * ((sz + 1) * 10 ^ 8 * Y) = N * (sz + 1) * 10 ^ 8 * Y := by ring
  omega

/-- **The leaf.** -/
theorem cost_leaf {n r Z H w : ℕ} (hn : 1 ≤ n) (hw : w ≤ H) :
    400 * (ck (n * r) Z w + xLeaf Z) ≤ 10 ^ 12 * (n * Yu r Z H) := by
  unfold ck xLeaf
  have h1 := yu_r r Z H
  have h2 := yu_z2 r Z H
  have h3 := yu_z1 r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hnY : Y ≤ n * Y := Nat.le_mul_of_pos_left _ hn
  have a : 100000 * (w + 3) * (n * r) ≤ 100000 * (n * Y) := by
    have : (w + 3) * (n * r) ≤ n * Y := by
      calc (w + 3) * (n * r) = n * (r * (w + 3)) := by ring
        _ ≤ n * (r * (2 * H + 21)) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (by omega))
        _ ≤ n * Y := Nat.mul_le_mul_left _ h1
    have e : 100000 * (w + 3) * (n * r) = 100000 * ((w + 3) * (n * r)) := by ring
    rw [e]; exact Nat.mul_le_mul_left _ this
  have b : 60 * 10 ^ 7 * (Z + 2) ^ 2 ≤ 60 * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h2
  omega

end NLogN.KFW

end

section
-- Source module: Solutions.KFWC1
/-!
# KFW C-layer tools: frames with shadowing, run specifications

* `ExV.of_regs`: an expression value only depends on the registers the expression reads.
* `NoRd`, **`pushSeq_of`**: a frame of pushes whose expressions are valued on a base assignment
  `σ0` and never read a register pushed earlier in the frame (registers may be shadowed).
* `RunQ σ U f g c`: from every background agreeing with `σ`, `U` runs from `encK s f` to
  `encK s g` within cost `c` (`f`, `g` fixed): frames (`runQ_push`), register tests
  (`runQ_ite`), calls, sequences.
* `recRep_uniq`, **`runQ_of_sImplQ`**: an `SImplQ` statement gives a `RunQ` with a fixed result.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-! ## Expression values and frames -/

theorem ExV.of_regs {σ σ' : Fin HS → Option ℤ} {e : Ex HS} {v : ℤ} {B : ℕ}
    (h : ExV σ e v B) (hr : ∀ j ∈ e.regs, σ j = σ' j) : ExV σ' e v B := by
  intro t ht
  classical
  let t' : IState HS := { t with G := fun j => if j ∈ e.regs then t.G j else
      (match σ j with | some v => [.int v] | none => []) }
  have hag : Agree σ t' := by
    intro j u hj
    by_cases hje : j ∈ e.regs
    · obtain ⟨L, hL⟩ := ht j u (by rw [← hr j hje]; exact hj)
      exact ⟨L, by simp [t', hje, hL]⟩
    · exact ⟨[], by simp [t', hje, hj]⟩
  obtain ⟨a, b, c⟩ := h t' hag
  have hc := Ex.congrG (s := t') (s' := t) e (fun j hj => by simp [t', hj])
  refine ⟨hc.2.1.1 a, ?_, (hc.2.2.1 B).1 c⟩
  rw [← hc.1]; exact b

/-- **A frame with shadowing.** -/
theorem pushSeq_of (σ0 : Fin HS → Option ℤ) (B sz : ℕ) :
    ∀ (pre : List (Fin HS)) (l : List (Fin HS × Ex HS × ℤ)) (σ : Fin HS → Option ℤ),
      (∀ j, j ∉ pre → σ j = σ0 j) →
      (∀ x ∈ l, x.1.val < 56 ∧ x.2.1.Clean ∧ x.2.1.size ≤ sz ∧ ExV σ0 x.2.1 x.2.2 B) →
      NoRd pre l →
      PushSeq σ (l.map fun x => (x.1, x.2.1)) (l.map fun x => (x.1, x.2.2)) (cFrame l.length sz B)
  | pre, [], σ, _, _, _ => by simp [PushSeq, cFrame]
  | pre, x :: l, σ, hσ, h, hn => by
    obtain ⟨h1, h3, h4, h5⟩ := h x List.mem_cons_self
    have hv : ExV σ x.2.1 x.2.2 B := h5.of_regs (fun j hj => (hσ j (hn.1 j hj)).symm)
    have IH := pushSeq_of σ0 B sz (x.1 :: pre) l (Function.update σ x.1 (some x.2.2))
      (fun j hj => by
        have hj1 : j ≠ x.1 := fun h => hj (by rw [h]; exact List.mem_cons_self)
        rw [Function.update_of_ne hj1]
        exact hσ j (fun h => hj (List.mem_cons_of_mem _ h)))
      (fun y hy => h y (List.mem_cons_of_mem _ hy)) hn.2
    have := pushSeq_consV h1 h3 hv h4 IH
    simp only [List.map_cons]
