variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]}
variable {O : Type} [CommRing O] [IsLocalRing O]

def Adm (B : Type) [CommRing B] (ψ : O →+* B) : Type :=
  {ρ : B →+* ResidueField O // ρ.comp ψ = residue O}

theorem Adm.surjective {B : Type} [CommRing B] {ψ : O →+* B} (ρ : Adm B ψ) : Function.Surjective ρ.1 := by
  intro y
  obtain ⟨o, rfl⟩ := residue_surjective (R := O) y
  exact ⟨ψ o, by rw [← RingHom.comp_apply, ρ.2]⟩

theorem Adm.subsingleton {B : Type} [CommRing B] [IsLocalRing B] (ψ : O →+* B) : Subsingleton (Adm B ψ) := by
  refine ⟨fun ρ ρ' => Subtype.ext ?_⟩
  have hk : ∀ σ : Adm B ψ, RingHom.ker σ.1 = maximalIdeal B := fun σ =>
    IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective σ.1 (Adm.surjective σ))
  apply RingHom.ext
  intro x
  obtain ⟨o, ho⟩ := residue_surjective (R := O) (ρ.1 x)

  have h1 : ρ.1 (ψ o) = ρ.1 x := by rw [← RingHom.comp_apply, ρ.2, ho]
  have hmem : x - ψ o ∈ RingHom.ker ρ'.1 := by
    rw [hk ρ', ← hk ρ, RingHom.mem_ker, map_sub, h1, sub_self]
  rw [RingHom.mem_ker, map_sub, sub_eq_zero] at hmem
  rw [hmem, ← RingHom.comp_apply, ρ'.2, ho]

def Adm.comap {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B') (hf : f.comp ψ = ψ')
    (ρ' : Adm B' ψ') : Adm B ψ :=
  ⟨ρ'.1.comp f, by rw [RingHom.comp_assoc, hf, ρ'.2]⟩

@[scoped simp] theorem Adm.comap_val {B B' : Type} [CommRing B] [CommRing B'] {ψ : O →+* B} {ψ' : O →+* B'} (f : B →+* B')
    (hf : f.comp ψ = ψ') (ρ' : Adm B' ψ') : (Adm.comap f hf ρ').1 = ρ'.1.comp f := rfl

