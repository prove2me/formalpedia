theorem stgM_snoc : ∀ (rv : List (ℕ × ℕ)) (x : ℕ × ℕ) (suf : List (ℕ × ℕ)),
    stgM (rv ++ [x]) suf = stgM rv suf ++ [(vol ((rv.reverse ++ suf).map Prod.fst) : ℤ)]
  | [], x, suf => by simp [stgM]
  | y :: rv, x, suf => by
    simp only [List.cons_append, stgM, stgM_snoc rv x (y :: suf), List.reverse_cons,
      List.append_assoc, List.singleton_append, List.nil_append]

theorem stgAM_snoc : ∀ (rv : List (ℕ × ℕ)) (x : ℕ × ℕ) (suf : List (ℕ × ℕ)),
    stgAM (rv ++ [x]) suf = stgAM rv suf ++ [((x.1 * vol ((rv.reverse ++ suf).map Prod.fst) : ℕ) : ℤ)]
  | [], x, suf => by simp [stgAM]
  | y :: rv, x, suf => by
    simp only [List.cons_append, stgAM, stgAM_snoc rv x (y :: suf), List.reverse_cons,
      List.append_assoc, List.singleton_append, List.nil_append]

theorem stgM_rev (suf : List (ℕ × ℕ)) : ∀ ac : List (ℕ × ℕ),
    stgM ac.reverse suf = (sufV suf ac).reverse
  | [] => rfl
  | x :: ac => by
    rw [List.reverse_cons, stgM_snoc, stgM_rev suf ac, List.reverse_reverse]
    simp [sufV]

theorem stgAM_rev (suf : List (ℕ × ℕ)) : ∀ ac : List (ℕ × ℕ),
    stgAM ac.reverse suf = (sufAV suf ac).reverse
  | [] => rfl
  | x :: ac => by
    rw [List.reverse_cons, stgAM_snoc, stgAM_rev suf ac, List.reverse_reverse]
    simp [sufAV]

end NLogN.KIL

