-- title:
--   §3.1 (p. 16) — the RSGF method (3.12)–(3.13), its sampling model, the σ-algebras ζ_[k], the pmf (3.15) and the random output index R
-- statement:
--   This file defines the randomized stochastic gradient free (RSGF) method of Section 3.1 and the probability model in which it runs. Fix a probability space $(\Omega,\mathcal F,\mu)$, the distribution $P$ of $\xi$ and the integrand $F$ of the companion definition file.
--
--   1. **Sampling model.** At each iteration $k \ge 1$ the method uses a fresh sample $\xi_k$ with distribution $P$ and a fresh $n$-dimensional standard Gaussian vector $u_k$, with density $(2\pi)^{-n/2} e^{-\|u\|^2/2}$. All of $\xi_1, u_1, \xi_2, u_2, \dots$ are measurable and mutually independent: the pairs $\zeta_k = (\xi_k,u_k)$ are independent across $k$, and within each pair $\xi_k$ and $u_k$ are independent.
--   2. **History.** $\sigma(\zeta_{[k]})$ is the $\sigma$-algebra generated by $\zeta_{[k]} = (\zeta_1,\dots,\zeta_k)$. For $k = 0$ it is the trivial $\sigma$-algebra.
--   3. **Run.** Given an initial point $x_1$, stepsizes $\{\gamma_k\}$ and a smoothing parameter $\mu$, the iterates satisfy
--   $$
--   x_{k+1} = x_k - \gamma_k\, G_\mu(x_k,\xi_k,u_k), \qquad k \ge 1. \tag{3.13}
--   $$
--   4. **Probability mass function (3.15).** For $k = 1,\dots,N$,
--   $$
--   P_R(k) = \frac{\gamma_k - 2L(n+4)\gamma_k^2}{\sum_{j=1}^N [\gamma_j - 2L(n+4)\gamma_j^2]} .
--   $$
--   5. **Random output index.** $R$ is a measurable random variable with values in $\{1,\dots,N\}$ and $\operatorname{Prob}\{R = k\} = p(k)$ for a given mass function $p$. It is independent of the whole sample sequence $(\xi_k,u_k)_{k \ge 1}$. The method outputs $x_R$.
--
--   The expectations in Theorem 3.2 "with respect to $R$, $\xi_{[N]}$ and $u_{[N]}$" are expectations under $\mu$ in this model.
--
--   **Formalization Note** Iterates are indexed from $1$ as in the paper, and index $0$ is unused. Mutual independence of the samples and the independence of $R$ from them are implicit in the paper (fresh oracle calls, "Generate $u_k$ by Gaussian random vector generator", Step 0); they are made explicit here. The smoothing parameter is `μs` in Lean.
-- source:
--   Ghadimi & Lan, arXiv:1309.5549v1, RSGF method (Input, Step 0, Step k, Output), Eqs. (3.12)–(3.13), p. 16; Eq. (3.15), p. 16; ζ_[k] in the proof of Theorem 3.2, p. 17

import Mathlib
import Definitions.Def_GhadimiLan_RSGF_Model

open MeasureTheory ProbabilityTheory

namespace GhadimiLan.RSGF

/-- The sampling model of the RSGF method (Ghadimi & Lan, arXiv:1309.5549v1, §3.1, pp. 15–16) on a
probability space `(Ω, μ)`: at iteration `k ≥ 1` the stochastic zeroth-order oracle receives a
fresh sample `ξ_k` of the random vector `ξ` (law `P`, the distribution of (3.1)) and the method
draws a fresh `n`-dimensional standard Gaussian vector `u_k` (law `stdGaussian`, density
`(2π)^{-n/2} e^{-‖u‖²/2}`, as in (3.3)). All of `ξ_1, u_1, ξ_2, u_2, …` are mutually independent:
the pairs `ζ_k = (ξ_k, u_k)` are independent across `k` (`indep_pairs`), and within each pair
`ξ_k` and `u_k` are independent (`indep_xi_u`). Index `0` is unused by the method. -/
structure IsSZOSampling {n : ℕ} {Ω Ξ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ξ]
    (μ : Measure Ω) (P : Measure Ξ) (ξ : ℕ → Ω → Ξ) (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) :
    Prop where
  measurable_xi : ∀ k, Measurable (ξ k)
  measurable_u : ∀ k, Measurable (u k)
  law_xi : ∀ k, μ.map (ξ k) = P
  law_u : ∀ k, μ.map (u k) = stdGaussian (EuclideanSpace ℝ (Fin n))
  indep_pairs : iIndepFun (fun k ω => (ξ k ω, u k ω)) μ
  indep_xi_u : ∀ k, IndepFun (ξ k) (u k) μ

/-- The σ-algebra `σ(ζ_[k])`, `ζ_[k] = (ζ_1, …, ζ_k)`, `ζ_j = (ξ_j, u_j)`, generated by the first
`k` samples (proof of Theorem 3.2, p. 17). For `k = 0` it is the trivial σ-algebra, so conditioning
on `ζ_[0]` is plain expectation. -/
def zetaSigma {n : ℕ} {Ω Ξ : Type*} [MeasurableSpace Ξ] (ξ : ℕ → Ω → Ξ)
    (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (k : ℕ) : MeasurableSpace Ω :=
  ⨆ j ∈ Finset.Icc 1 k, MeasurableSpace.comap (fun ω => (ξ j ω, u j ω)) inferInstance

/-- A run of the RSGF method, (3.12)–(3.13) (p. 16), with initial point `x1`, stepsizes `γ`,
smoothing parameter `μs` (the paper's `µ`) and samples `ξ`, `u`: `x_1 = x1` and, for `k ≥ 1`,
`x_{k+1} = x_k − γ_k G_µ(x_k, ξ_k, u_k)`. Iterates are indexed from `1`; `x 0` is unused. -/
def IsRSGFRun {n : ℕ} {Ω Ξ : Type*} (F : EuclideanSpace ℝ (Fin n) → Ξ → ℝ) (μs : ℝ)
    (γ : ℕ → ℝ) (x1 : EuclideanSpace ℝ (Fin n)) (ξ : ℕ → Ω → Ξ)
    (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (x : ℕ → Ω → EuclideanSpace ℝ (Fin n)) : Prop :=
  (∀ ω, x 1 ω = x1) ∧
    ∀ k : ℕ, 1 ≤ k → ∀ ω, x (k + 1) ω = x k ω - γ k • szoGrad F μs (x k ω) (ξ k ω) (u k ω)

/-- The probability mass function (3.15) (p. 16) of the random iteration count `R`:
`P_R(k) = [γ_k − 2L(n+4)γ_k²] / Σ_{j=1}^N [γ_j − 2L(n+4)γ_j²]`, where `n` is the dimension. -/
noncomputable def rsgfPMF (L : ℝ) (n : ℕ) (γ : ℕ → ℝ) (N k : ℕ) : ℝ :=
  (γ k - 2 * L * ((n : ℝ) + 4) * γ k ^ 2) /
    ∑ j ∈ Finset.Icc 1 N, (γ j - 2 * L * ((n : ℝ) + 4) * γ j ^ 2)

/-- `R` is the random iteration count of the method (Step 0, p. 16): a random variable with values
in `{1, …, N}` and probability mass function `p` (`Prob{R = k} = p(k)`), drawn independently of the
whole sample sequence `(ξ_k, u_k)_k` (the paper's expectation "with respect to `R`, `ξ_[N]` and
`u_[N]`" is over this product). -/
structure IsOutputIndex {n : ℕ} {Ω Ξ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ξ]
    (μ : Measure Ω) (ξ : ℕ → Ω → Ξ) (u : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (N : ℕ)
    (p : ℕ → ℝ) (R : Ω → ℕ) : Prop where
  measurable : Measurable R
  mem_range : ∀ ω, R ω ∈ Finset.Icc 1 N
  law : ∀ k ∈ Finset.Icc 1 N, μ {ω | R ω = k} = ENNReal.ofReal (p k)
  indep : IndepFun R (fun ω k => (ξ k ω, u k ω)) μ

end GhadimiLan.RSGF


