/-!
# Canonical filtration of lifetime paths

The raw canonical filtration is generated by the cemetery-valued coordinates up to each time.
The lifetime is a stopping time because death by time `t` is exactly the event that the time-`t`
coordinate is the cemetery state.
-/

open MeasureTheory
open scoped ENNReal

namespace MarkovProcess.LifetimePath

variable {alpha : Type*} [TopologicalSpace alpha] [MeasurableSpace alpha]



/-- The raw canonical filtration generated by lifetime-path coordinates up to time `t`. -/
noncomputable def canonicalFiltration :
    Filtration NNReal (instMeasurableSpace (α := alpha)) where
  seq t := ⨆ s : Set.Iic t,
    MeasurableSpace.comap (coordinate (α := alpha) s) inferInstance
  mono' t u htu := by
    refine iSup_le fun s ↦ ?_
    exact le_iSup_of_le (⟨s.1, s.2.trans htu⟩ : Set.Iic u) le_rfl
  le' t := iSup_le fun s ↦ (measurable_coordinate s).comap_le







end MarkovProcess.LifetimePath


