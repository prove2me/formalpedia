    rw [IdempotentSplitting.coe_zero_cornerRing]
    apply Subtype.ext
    apply LinearMap.ext
    intro v
    have h1 : ((c : ↥D₁.opSubalgebra) : Module.End 𝒪 V) v =
        ((c : ↥D₁.opSubalgebra) : Module.End 𝒪 V) (((Sp.e j₀ : ↥D₁.opSubalgebra) : Module.End 𝒪 V) v) := by
      conv_lhs => rw [← Sp.coe_mul_e j₀ c]
