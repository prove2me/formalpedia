theorem lowbit : ∀ Y : ℕ, Y ≠ 0 → ∃ j, Y.testBit j = true ∧ Y - (Y &&& (Y - 1)) = 2 ^ j ∧
    ∀ i, (Y &&& (Y - 1)).testBit i = (Y.testBit i && decide (i ≠ j)) := by
  intro Y
  induction Y using Nat.strong_induction_on with
  | _ Y ih =>
    intro hY
    rcases Nat.mod_two_eq_zero_or_one Y with h | h
    · obtain ⟨m, rfl⟩ : ∃ m, Y = 2 * m := ⟨Y / 2, by omega⟩
      have hm : m ≠ 0 := by omega
      obtain ⟨j, h1, h2, h3⟩ := ih m (by omega) hm
      have e : (2 * m) &&& (2 * m - 1) = 2 * (m &&& (m - 1)) := by
        apply Nat.eq_of_testBit_eq
        intro i
        cases i with
        | zero => simp [Nat.testBit_zero]
        | succ i =>
          have a1 : (2 * m - 1) / 2 = m - 1 := by omega
          simp only [Nat.testBit_land]
          simp [Nat.testBit_succ, a1]
      refine ⟨j + 1, by simpa [Nat.testBit_succ] using h1, ?_, ?_⟩
      · rw [e, pow_succ]
        have := Nat.and_le_left (n := m) (m := m - 1)
        omega
      · intro i
        rw [e]
        cases i with
        | zero => simp [Nat.testBit_zero]
        | succ i => simpa [Nat.testBit_succ] using h3 i
    · obtain ⟨m, rfl⟩ : ∃ m, Y = 2 * m + 1 := ⟨Y / 2, by omega⟩
      have e : (2 * m + 1) &&& (2 * m + 1 - 1) = 2 * m := by
        apply Nat.eq_of_testBit_eq
        intro i
        cases i with
        | zero => simp [Nat.testBit_zero]
        | succ i =>
          have a1 : (2 * m + 1) / 2 = m := by omega
          simp only [Nat.testBit_land]
          simp [Nat.testBit_succ, a1]
      refine ⟨0, by simp [Nat.testBit_zero], by rw [e]; simp, ?_⟩
      intro i
      rw [e]
      cases i with
      | zero => simp [Nat.testBit_zero]
      | succ i =>
        have a1 : (2 * m + 1) / 2 = m := by omega
        simp [Nat.testBit_succ, a1]

theorem bitsGo_zero (f : Nat → Bool) (S : Nat) : bitsGo f 0 S = false := rfl
theorem bitsGo_succ_zero (f : Nat → Bool) (n : Nat) : bitsGo f (n + 1) 0 = true := rfl
