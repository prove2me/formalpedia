theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    (s : NLogN.IState NLogN.HS) (wb W K P Q : ℕ) (hW : 1 ≤ W) (hPQ : P < Q) (hQK : Q < K)
    (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ) (hl : zs.length = W * 2 ^ K)
    (h0 : f 0 = NLogN.KFB.gflat zs ++ l) (hb : NLogN.KFB.GB wb zs) :
    NLogN.IRuns I iprog (NLogN.KFB.gswP W K P Q) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFB.gswL P Q zs) ++ l))) (NLogN.KFB.cGsw W K P Q wb) := by
  have hV := NLogN.KFB.vol_swSh (W := W) hPQ hQK
  have hsh : [W * 2 ^ (K - Q - 1)] ++ 2 :: ([2 ^ (Q - P - 1)] ++ 2 :: [2 ^ (P + 1)]) =
      NLogN.KFB.swSh W K P Q := rfl
  have hle : ∀ v : ℕ, v ≤ 2 * (W * 2 ^ K) → NLogN.zsz (v : ℤ) ≤ NLogN.zsz (((2 * (W * 2 ^ K)) : ℕ) : ℤ) :=
    fun v hv => NLogN.zsz_natCast_le hv
  have hV' : AModel.vol (NLogN.KFB.swSh W K P Q) = AModel.vol [W * 2 ^ (K - Q - 1)] * 2 * AModel.vol [2 ^ (Q - P - 1)] * 2 *
      AModel.vol [2 ^ (P + 1)] := by simp [NLogN.KFB.swSh, AModel.vol]; ring
  have p1 : 1 ≤ 2 ^ (K - Q - 1) := Nat.one_le_two_pow
  have p2 : 1 ≤ 2 ^ (Q - P - 1) := Nat.one_le_two_pow
  have p3 : 1 ≤ 2 ^ (P + 1) := Nat.one_le_two_pow
  have l1 : W * 2 ^ (K - Q - 1) ≤ 2 * (W * 2 ^ K) := by
    have : 2 ^ (K - Q - 1) ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) (by omega)
    nlinarith
  have l2 : 2 ^ (Q - P - 1) ≤ 2 * (W * 2 ^ K) := by
    have : 2 ^ (Q - P - 1) ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) (by omega)
    nlinarith
  have l3 : 2 ^ (P + 1) ≤ 2 * (W * 2 ^ K) := by
    have : 2 ^ (P + 1) ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) (by omega)
    nlinarith
  have H := NLogN.KFD.swapEF_runs (I := I) (iprog := iprog) [W * 2 ^ (K - Q - 1)] [2 ^ (Q - P - 1)]
    [2 ^ (P + 1)] 2 (NLogN.zsz (((2 * (W * 2 ^ K)) : ℕ) : ℤ)) wb
    (.lit ((W * 2 ^ (K - Q - 1) : ℕ) : ℤ)) (.lit 2) (.lit ((2 ^ (Q - P - 1) : ℕ) : ℤ))
    (.lit ((2 ^ (P + 1) : ℕ) : ℤ)) (NLogN.KIL.encK s f) (NLogN.KFB.gflat zs) (NLogN.ints l ++ s.G 0)
    (by simp [h0, NLogN.ints_append])
    (by rw [hsh, hV, NLogN.KFB.length_gflat, hl])
    hb.bnd (by simp only [AModel.vol, List.prod_cons, List.prod_nil, mul_one]; exact Nat.mul_le_mul hW p1)
    (by norm_num) (by simpa [AModel.vol] using p2) (by simpa [AModel.vol] using p3)
    (by rw [hsh, hV])
    (NLogN.KIL.goodE_lit (hle _ l1)) (NLogN.KIL.goodE_lit (hle 2 (by nlinarith [Nat.one_le_two_pow (n := K)])))
    (NLogN.KIL.goodE_lit (hle _ l2)) (NLogN.KIL.goodE_lit (hle _ l3))
    (by simp [NLogN.Ex.eval, AModel.vol]) (by simp [NLogN.Ex.eval]) (by simp [NLogN.Ex.eval, AModel.vol]) (by simp [NLogN.Ex.eval, AModel.vol])
  rw [hsh, show [W * 2 ^ (K - Q - 1)].length = 1 from rfl,
    show 1 + 1 + [2 ^ (Q - P - 1)].length = 3 from rfl, ← NLogN.KFB.gflat_gswL hPQ hQK zs hl,
    ← List.append_assoc, ← NLogN.ints_append, NLogN.KIL.encK_upd, hV] at H
  exact H
end
