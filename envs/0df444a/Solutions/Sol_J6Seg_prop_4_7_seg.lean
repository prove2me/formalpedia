    ext j; simp [permS]
  rw [hL, resT_sum α hα]
  -- right side
  have hu : resS s t α u = fun l => ∑ ρ, v ρ * resS s t α (ch s ρ) l := by
    ext l
    conv_lhs => rw [dft_inversion u]
    rw [resS_sum α hα]
  rw [hu]
  simp only [permT]
  rw [dftN_sum]
  congr 1; ext ρ; congr 1
