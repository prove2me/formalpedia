variable {K : Type} [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]

private def dualValue (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ)) (m : ℤ) : ℂ :=
  if m < 0 then 0 else
    (cNormQ v)⁻¹ ^ m.toNat *
      sphericalTorusValue (inducedE2 ℚ c v / inducedE3 ℚ c v) (inducedE1 ℚ c v / inducedE3 ℚ c v)
        (inducedE3 ℚ c v)⁻¹ m.toNat

omit [NumberField K] in
private theorem dualValue_of_neg (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ)) {m : ℤ} (hm : m < 0) :
    dualValue c v m = 0 := by
  simp only [dualValue, if_pos hm]

omit [NumberField K] in
private theorem dualValue_natCast (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ)) (n : ℕ) :
    dualValue c v n =
      (cNormQ v)⁻¹ ^ n *
        sphericalTorusValue (inducedE2 ℚ c v / inducedE3 ℚ c v) (inducedE1 ℚ c v / inducedE3 ℚ c v)
          (inducedE3 ℚ c v)⁻¹ n := by
  simp only [dualValue, if_neg (not_lt.mpr (Int.natCast_nonneg n)), Int.toNat_natCast]

omit [NumberField K] in
private theorem dualValue_zero
    (c : HeightOneSpectrum (𝓞 K) → ℂ) (v : HeightOneSpectrum (𝓞 ℚ)) : dualValue c v 0 = 1 := by
  have h := dualValue_natCast c v 0
  simp only [Nat.cast_zero] at h
  rw [h, pow_zero, one_mul]
  rfl

private theorem dualValue_natCast_eq_inv_coeff (hdeg : Module.finrank ℚ K = 3) (c : HeightOneSpectrum (𝓞 K) → ℂ)
    (v : HeightOneSpectrum (𝓞 ℚ))
    (he : ∀ 𝔓 ∈ primeFibre ℚ K v, (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hc : ∀ 𝔓 ∈ primeFibre ℚ K v, c 𝔓 ≠ 0) (n : ℕ) :
    dualValue c v n =
      (cNormQ v)⁻¹ ^ n *
        sphericalTorusValue (inducedE1 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v) (inducedE2 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v)
          (inducedE3 ℚ (fun 𝔓 => (c 𝔓)⁻¹) v) n := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  obtain ⟨h₁, h₂, h₃⟩ :=
    DualEulerMatch.inducedE_inv_eq_of_forall_ne_zero K hdeg c v (FibreDegree.primeFibre_finite K v) he hc
  rw [dualValue_natCast, h₁, h₂, h₃]

private theorem two_le_absNorm (v : HeightOneSpectrum (𝓞 ℚ)) : 2 ≤ Ideal.absNorm v.asIdeal := by
  have h0 : Ideal.absNorm v.asIdeal ≠ 0 := by
    rw [Ne, Ideal.absNorm_eq_zero_iff]
    exact v.ne_bot
  have h1 : Ideal.absNorm v.asIdeal ≠ 1 := by
    rw [Ne, Ideal.absNorm_eq_one_iff]
    exact v.isPrime.ne_top
  omega

private theorem norm_dualValue_le (hdeg : Module.finrank ℚ K = 3) {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
    (hμu : IsUnitaryChar (𝓞 K) K μ) {v : HeightOneSpectrum (𝓞 ℚ)} (hv : ¬ IsBadPlace K μ v) (n : ℕ) :
    ‖dualValue (inducedCoeff K μ) v n‖ ≤ (2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (4 : ℝ)) ^ n := by
  obtain ⟨h₁, h₂, h₃⟩ := TorusGrowth.norm_inducedE_le hdeg.le hμu v
  have he₃ := InducedE3Unitary.norm_inducedE3_inducedCoeff_eq_one_of_not_isBadPlace K μ hdeg hμu v hv
  have hN : (2 : ℝ) ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) := by exact_mod_cast two_le_absNorm v
  have hd₁ : ‖inducedE2 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v‖ ≤ 8 := by
    rw [norm_div, he₃, div_one]; exact h₂
  have hd₂ : ‖inducedE1 ℚ (inducedCoeff K μ) v / inducedE3 ℚ (inducedCoeff K μ) v‖ ≤ 8 := by
    rw [norm_div, he₃, div_one]; exact h₁
  have hd₃ : ‖(inducedE3 ℚ (inducedCoeff K μ) v)⁻¹‖ ≤ 8 := by
    rw [norm_inv, he₃, inv_one]; norm_num
  have hval := TorusGrowth.norm_sphericalTorusValue_le (by norm_num) hd₁ hd₂ hd₃ n
  have hinv : ‖(cNormQ v)⁻¹‖ ≤ 1 := by
    rw [norm_inv, cNormQ, Complex.norm_natCast]
    exact inv_le_one_of_one_le₀ (by exact_mod_cast (one_le_two.trans (two_le_absNorm v)))
  have hbase : (3 * 8 : ℝ) ≤ 2 * ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (4 : ℝ) := by
    rw [Real.rpow_ofNat]
    have h16 : (2 : ℝ) ^ 4 ≤ ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ 4 := pow_le_pow_left₀ (by norm_num) hN 4
    norm_num at h16 ⊢
    linarith
  rw [dualValue_natCast, norm_mul, norm_pow]
  refine (mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) hinv n) hval (norm_nonneg _) (by positivity)).trans ?_
  rw [one_pow, one_mul]
  exact pow_le_pow_left₀ (by norm_num) hbase n

end
