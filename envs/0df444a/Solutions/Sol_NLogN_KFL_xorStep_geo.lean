    simp only [Ex.regs, List.mem_append] at h
    simp only [Ex.ok, ok_congr a (fun i hi => h i (Or.inl hi)),
      ok_congr b (fun i hi => h i (Or.inr hi)), eval_congr a (fun i hi => h i (Or.inl hi)),
      eval_congr b (fun i hi => h i (Or.inr hi))]
