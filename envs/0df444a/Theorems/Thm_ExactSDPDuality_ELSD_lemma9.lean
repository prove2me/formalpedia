-- title:
--   Lemma 9 — Q(x)U = 0 = Q(x)W for x ∈ G, U ∈ 𝒰ₖ, W ∈ 𝒲ₖ
-- statement:
--   Let $Q_0, Q_1,\dots,Q_m$ be real symmetric $n\times n$ matrices, $Q(x) = Q_0 - \sum_i x_i Q_i$, $G = \{x\in\mathbb R^m\mid Q(x)\succeq 0\}$, and let $\mathcal U_k, \mathcal W_k$ be the sets of the Extended Lagrange–Slater Dual. Let $k\le m$. For every $x\in G$, $U\in\mathcal U_k$ and $W\in\mathcal W_k$,
--   $$Q(x)U = 0,\qquad Q(x)W = 0,$$
--   and hence $Q(x)\bullet U = 0 = Q(x)\bullet W$. In particular, if $0\in G$ then $Q_0\bullet U = 0 = Q_0\bullet W$.
--
--   The products are matrix products. The lemma says that the matrices generated by the dual's recursive constraints annihilate every feasible slack matrix; it is the key to weak duality and to Lemma 10(iv).
--
--   **Formalization Note** $\mathcal U_0 = \mathcal W_0 = \{0\}$ by the convention of the definition file, so the case $k = 0$ is trivial.
-- source:
--   Ramana, An exact duality theory for semidefinite programming and its complexity implications, Math. Program. 77 (1997), p. 140, Lemma 9

import Mathlib
import Definitions.Def_ExactSDPDuality_ELSD_Model

open Matrix

namespace ExactSDPDuality.ELSD

/-- Lemma 9 (Ramana 1997, p. 140): for `k ≤ m`, `x ∈ G`, `U ∈ 𝒰ₖ` and `W ∈ 𝒲ₖ`,
`Q(x)U = 0` and `Q(x)W = 0`, hence `Q(x) • U = 0 = Q(x) • W`; in particular, if `0 ∈ G`
then `Q₀ • U = 0 = Q₀ • W`. -/
theorem lemma9 {n m : ℕ} (Q0 : Matrix (Fin n) (Fin n) ℝ)
    (Q : Fin m → Matrix (Fin n) (Fin n) ℝ)
    (hQ0 : Q0.IsSymm) (hQ : ∀ i, (Q i).IsSymm) (k : ℕ) (hk : k ≤ m) :
    (∀ x ∈ feasibleSet Q0 Q, ∀ U ∈ Uset Q0 Q k, ∀ W ∈ Wset Q0 Q k,
        Qaff Q0 Q x * U = 0 ∧ Qaff Q0 Q x * W = 0 ∧
          frob (Qaff Q0 Q x) U = 0 ∧ frob (Qaff Q0 Q x) W = 0) ∧
      ((0 : Fin m → ℝ) ∈ feasibleSet Q0 Q →
        ∀ U ∈ Uset Q0 Q k, ∀ W ∈ Wset Q0 Q k, frob Q0 U = 0 ∧ frob Q0 W = 0) := by sorry

end ExactSDPDuality.ELSD
