# Round six, item language (I2): the register-driven Lemma 13 core over any Lemma 12 table

Parametric copy of `KFX.swE`/`swE_spec`/`swE_geo` (`KFX1Sw`), `KFL.coreCost`/`coreCost_le`
(`KFLMain`) and the tail of `KFX4Core` (`optA` … `l13U_body`) with the OpenAI Lemma 12
(`KFL.l12prog`, `KFL.l12C q`, `τ = 1 - 2^-50`) replaced by any table `tab`, code `l12` and
exponent `τ` satisfying `IL.L12Canon tab l12 τ` (`0 ≤ τ ≤ 1`).

**`l13U_body`**: `L12Canon tab l12 τ → ∃ Kc > 0, (Lemma 13 for the code `l13U l12`)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE NLogN.KFB NLogN.KFL NLogN.KFW NLogN.KFH
  NLogN.KFX AModel AModelL12 NetProp7 Butterfly IntMul.Kappa.R6.IL

variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

/-- **The swap wrapper with expression parameters** around any Lemma 12 code `l12`. -/
def swE (l12 : IStmt HS 1) (eP eG eS eU : Ex HS) : IStmt HS 1 := withPushI (swPl eP eG eS eU) l12

/-! ## The three slot swaps on the 8-axis geometry -/

/-! ## The core cost with exponent `τ` -/

/-- `KFL.coreCost` with `τ`. -/
noncomputable def coreCost (τ : ℝ) (Ks Kcr : ℝ) (K ρ f : ℕ) (g : Geo) : ℝ :=
  (1 + 8 * (2 * Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ
        + cRotG K f g (zsz (g.V : ℤ) + 3))) +
    Kcr * (((g.V / g.B : ℕ) : ℝ) * ((zsz (g.V : ℤ) : ℝ) + 1) ^ 3 + (g.V : ℝ) +
      min 1 (80 * ((f : ℝ) - 1) * 2⁻¹ ^ K) * ((g.V / g.B : ℕ) : ℝ) *
        ((zsz (g.V : ℤ) : ℝ) + 1) * ((g.B : ℝ) + (zsz (g.V : ℤ) : ℝ) + 1)) +
    cXor (g.N0 * g.Q * g.N1 * 2 ^ (f * K - (ρ + (f - 1) * K) - 1)) (2 ^ (ρ + (f - 1) * K) * g.S1)
      1 (zsz (g.V : ℤ) + 3)

/-- Slot swap `1` (`y ↔ z`). -/
def swBU (l12 : IStmt HS 1) : IStmt HS 1 := swE l12 eP1 (.reg mN2) eS2 eFK
/-- Slot swap `0` or `2` (by `gx`). -/
def swAU (l12 : IStmt HS 1) : IStmt HS 1 := swE l12 (.reg mN0) eGA eSA eFK
def optA (l12 : IStmt HS 1) : IStmt HS 1 := .ite mFa isPos (swAU l12) .skip
def optB (l12 : IStmt HS 1) : IStmt HS 1 := .ite mFb isPos (swBU l12) .skip

def lineU (l12 : IStmt HS 1) (l : Line) : IStmt HS 1 :=
  if l.tgtY then .seq (swBU l12) (.seq (rotLU l) (swBU l12)) else rotLU l

def linesU (l12 : IStmt HS 1) : List Line → IStmt HS 1
  | [] => .skip
  | l :: ls => .seq (lineU l12 l) (linesU l12 ls)

def coreBU (l12 : IStmt HS 1) : IStmt HS 1 := .seq (linesU l12 lines) (.seq corrLU xorLU)

/-- **The register-driven Lemma 13 code.** -/
def l13U (l12 : IStmt HS 1) : IStmt HS 1 :=
  .seq toBitsU (.seq (optA l12) (.seq (optB l12) (.seq (coreBU l12) (.seq (optB l12) (.seq (optA l12)
    fromBitsU)))))

/-! ## Swap lists -/

/-- The swap property of `swE_geo` for one prime. -/
def SwEOK (tab : Fin 1 → IStmt HS 1) (l12 : IStmt HS 1) (τ : ℝ) (Ksw : ℝ) : Prop :=
  ∀ (i : Fin 3) (g : Geo), g.Pos → ∀ u : ℕ, 1 ≤ u → g.Q = 2 ^ u →
    ∀ (I : List Sym) (t : IState HS) (zs : List ℤ) (R : List Item),
    KFL.Bits zs → t.G 0 = ints zs ++ R → zs.length = g.V →
    ∀ (eP eG eS eU : Ex HS) (Bb : ℕ), Bb ≤ zsz (g.V : ℤ) + 3 →
    eP.size + eG.size + eS.size + eU.size ≤ 50 →
    NoK eP → NoK eG → NoK eS → NoK eU →
    ESp eP t Bb (svP g i : ℤ) → ESp eG t Bb (svG g i : ℤ) → ESp eS t Bb (svS g i : ℤ) →
    ESp eU t Bb (u : ℤ) →
    ∃ c : ℕ, IRuns I tab (swE l12 eP eG eS eU) t
        (t.upd 0 (ints (rixT g (swT i) zs) ++ R)) c ∧
        (c : ℝ) ≤ Ksw * ((g.V : ℝ) + 1) * (u : ℝ) ^ τ

end IntMul.Kappa.R6.IL2

end

