  have hq : 0 < 2 ^ degree := by positivity
  rw [Nat.mul_comm first.val (2 ^ degree),
    Nat.mul_add_div hq, Nat.div_eq_of_lt second.isLt]
  simp
theorem factor400BinaryProperFactorPairRank_mod
