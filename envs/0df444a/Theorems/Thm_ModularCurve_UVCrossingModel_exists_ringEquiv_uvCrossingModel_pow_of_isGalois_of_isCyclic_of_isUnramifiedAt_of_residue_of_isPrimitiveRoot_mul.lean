        Algebra.IsUnramifiedAt (UVCrossingModel W (π ^ (m * n))) 𝔭)
    (hres : ∀ b : B, ∃ w : W,
      b - algebraMap (UVCrossingModel W (π ^ (m * n))) B (const (π ^ (m * n)) w) ∈ IsLocalRing.maximalIdeal B) :
    ∃ e : B ≃+* UVCrossingModel W (π ^ m),
