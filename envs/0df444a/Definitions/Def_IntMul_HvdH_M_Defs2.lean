-- Source module: NLogN.IComp
/-!
# Control flow of the item language and the compiler correctness theorem
-/

namespace NLogN

open IntMul

variable {S P : ℕ}

/-- Classes of the top of an item stack, for tests. -/
inductive Cls where
  | none | mark | zero | pos | neg
  deriving DecidableEq

def cls : Option Item → Cls
  | none => .none
  | some .mark => .mark
  | some (.int z) => if z = 0 then .zero else if z < 0 then .neg else .pos

inductive IStmt (S P : ℕ) where
  | skip
  | op (o : IOp S)
  | seq (p q : IStmt S P)
  | ite (i : Fin S) (f : Cls → Bool) (p q : IStmt S P)
  | loop (i : Fin S) (f : Cls → Bool) (p : IStmt S P)
  | call (j : Fin P)

def IState.cl (s : IState S) (i : Fin S) : Cls := cls (s.G i).head?

inductive IExec (I : List Sym) (iprog : Fin P → IStmt S P) :
    IStmt S P → IState S → IState S → ℕ → Prop
  | skip (s) : IExec I iprog .skip s s 1
  | op {o s s' c} : o.Step I s s' c → IExec I iprog (.op o) s s' c
  | seq {p q s s₁ s₂ c₁ c₂} : IExec I iprog p s s₁ c₁ → IExec I iprog q s₁ s₂ c₂ →
      IExec I iprog (.seq p q) s s₂ (c₁ + c₂)
  | iteT {i f p q s s' c} : f (s.cl i) = true → IExec I iprog p s s' c →
      IExec I iprog (.ite i f p q) s s' (c + 25)
  | iteF {i f p q s s' c} : f (s.cl i) = false → IExec I iprog q s s' c →
      IExec I iprog (.ite i f p q) s s' (c + 25)
  | loopT {i f p s s₁ s₂ c₁ c₂} : f (s.cl i) = true → IExec I iprog p s s₁ c₁ →
      IExec I iprog (.loop i f p) s₁ s₂ c₂ → IExec I iprog (.loop i f p) s s₂ (c₁ + c₂ + 30)
  | loopF {i f p s} : f (s.cl i) = false → IExec I iprog (.loop i f p) s s 30
  | call {j s s' c} : IExec I iprog (iprog j) s s' c → IExec I iprog (.call j) s s' (c + 2)

/-! ## Compilation -/

def branchOn (i : Fin S) (k : Cls → Stmt (S + 4) P) : Stmt (S + 4) P :=
  caseTop (ι i) fun o =>
    if o = none then k .none
    else if o = some hdMark then k .mark
    else if o = some hdNeg then k .neg
    else .seq (.pop (ι i)) (.ite (ι i) isBitT (.seq (.push (ι i) hdPos) (k .pos))
      (.seq (.push (ι i) hdPos) (k .zero)))

def flagOf (i : Fin S) (f : Cls → Bool) : Stmt (S + 4) P :=
  branchOn i fun c => .push (s3 S) (if f c then 1 else 0)

def loopTest (o : Option Sym) : Bool := decide (o = some 1)

def compile : IStmt S P → Stmt (S + 4) P
  | .skip => .skip
  | .op o => o.stmt
  | .seq p q => .seq (compile p) (compile q)
  | .ite i f p q => branchOn i fun c => if f c then compile p else compile q
  | .loop i f p => .seq (flagOf i f) (.seq (.loop (s3 S) loopTest
      (.seq (.pop (s3 S)) (.seq (compile p) (flagOf i f)))) (.pop (s3 S)))
  | .call j => .call j

def inner (i : Fin S) (f : Cls → Bool) (p : IStmt S P) : Stmt (S + 4) P :=
  .loop (s3 S) loopTest (.seq (.pop (s3 S)) (.seq (compile p) (flagOf i f)))

variable {I : List Sym} {prog : Fin P → Stmt (S + 4) P}

def encF (i : Fin S) (f : Cls → Bool) (s : IState S) : St (S + 4) :=
  (encI s).push (s3 S) (if f (s.cl i) then 1 else 0)

end NLogN

namespace NLogN

open IntMul

variable {S P : ℕ}

end NLogN

end

