namespace DecrAlmostLinearSSSP.Decremental.CoreSource
open Structured
lemma Image.call (B R N entry : ℕ) (p : Program) (g final : Machine) (s : Data)
    (h : Image B R N g s) (hN : registerBound p.code ≤ N)
    (hodd : ∃ r, R = B+2*r+1) (hentry : g.pc = entry)
    (hhalt : g.halted = false) (hfault : g.fault = false)
    (hzero : ZeroRegisterTail N g) (hend : Ends p g final) :
    ∃ cost t, Eval (SourceCall.code N entry p) s cost t ∧
      cost ≤ (dispatchCharge p.code+2)*(final.work-g.work)+8*N+15 ∧
      Image B R N final t ∧ ShadowDataRep B 2 t final ∧
      ∀ address, (∀ a, address ≠ B+2*(2*a+1)) → address ≠ R+6 →
        (∀ j < N, address ≠ R+8+2*j) → t.natMem address = s.natMem address ∧ t.realMem address = s.realMem address := by
  obtain ⟨cost,t,he,hcost,hrep,hwork,hsaved,hframe⟩ := SourceCall.eval_code N entry B 0 s p g final
    h.base (by simpa [bankFactor] using h.factor) h.zero hentry
    (by simpa only [h.record] using h.work) hhalt hfault
    (by simpa [bankFactor] using h.realMem) (by simpa [bankFactor] using h.natMem)
    (by intro j hj;simpa [bankFactor] using And.intro (h.saved.nat j hj) (h.saved.real j hj))
    h.tail hzero hend (by rw [h.savedBase,h.record]) (by simpa only [h.record] using hodd)
  have hn (k : ℕ) (hk : 10 ≤ k) (hev : Even k) (h52 : k ≠ 52) (h54 : k ≠ 54) :
      t.natReg k = s.natReg k := he.nat_frame (SourceCall.nat_even_frame N entry p k hk hev h52 h54)
  have hfinalzero := hzero.ends_of_bound hN hend
  have htimage : Image B R N final t := by
    refine ⟨(hn 74 (by omega) (by decide) (by omega) (by omega)).trans h.base,
      (hn 112 (by omega) (by decide) (by omega) (by omega)).trans h.factor,
      (hn 106 (by omega) (by decide) (by omega) (by omega)).trans h.record,
      (hn 50 (by omega) (by decide) (by omega) (by omega)).trans h.savedBase,
      (hn 56 (by omega) (by decide) (by omega) (by omega)).trans h.zero,
      ?_,?_,?_,?_,?_⟩
    · simpa [bankFactor,Data.machine] using hrep.realMem
    · simpa [bankFactor,Data.machine] using hrep.natMem
    · simpa only [h.record] using hwork
    · constructor
      · intro j hj
        rw [hn 50 (by omega) (by decide) (by omega) (by omega)]
        simpa [bankFactor] using (hsaved j hj).1
      · intro j hj
        rw [hn 50 (by omega) (by decide) (by omega) (by omega)]
        exact (hsaved j hj).2
    · intro j hj
      obtain ⟨hzN,hzR⟩ := hfinalzero j hj
      exact ⟨by simpa [bankFactor,hzN,Data.machine] using hrep.natReg j,by simpa only [hzR,Data.machine] using hrep.realReg j⟩
  refine ⟨cost,t,he,hcost,htimage,by simpa [bankFactor] using hrep,?_⟩
  intro address hb hw hs
  exact hframe address (by simpa [bankFactor] using hb) (by simpa only [h.record] using hw)
    (by simpa only [h.savedBase] using hs)
end DecrAlmostLinearSSSP.Decremental.CoreSource
