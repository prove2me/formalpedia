section Rotation

lemma rotIdx_lt {s b c k L : ℕ} (hL : s + b + c ≤ L) (hk : k < L) : rotIdx s b c k < L := by
  unfold rotIdx; split_ifs <;> omega

lemma rotIdx_inv (s b c k : ℕ) : rotIdx s c b (rotIdx s b c k) = k := by
  unfold rotIdx; split_ifs <;> omega

lemma getD_append4 (A B C D : List ℕ) (p : ℕ) :
    (A ++ (B ++ (C ++ D))).getD p 0 =
      if p < A.length then A.getD p 0
      else if p < A.length + B.length then B.getD (p - A.length) 0
      else if p < A.length + B.length + C.length then C.getD (p - A.length - B.length) 0
      else D.getD (p - A.length - B.length - C.length) 0 := by
  split_ifs with h1 h2 h3
  · rw [List.getD_append _ _ _ _ h1]
  · rw [List.getD_append_right _ _ _ _ (by omega), List.getD_append _ _ _ _ (by omega)]
  · rw [List.getD_append_right _ _ _ _ (by omega), List.getD_append_right _ _ _ _ (by omega),
      List.getD_append _ _ _ _ (by omega), Nat.sub_sub]
  · rw [List.getD_append_right _ _ _ _ (by omega), List.getD_append_right _ _ _ _ (by omega),
      List.getD_append_right _ _ _ _ (by omega), Nat.sub_sub, Nat.sub_sub]

/-- **The rotation as a list rearrangement** (applies to addresses and shapes alike). -/
theorem permIdx_rot (A B C D : List ℕ) :
    permIdx (rotIdx A.length B.length C.length) (A ++ (B ++ (C ++ D))) =
      A ++ (C ++ (B ++ D)) := by
  apply List.ext_getElem (by simp; omega)
  intro k h₁ h₂
  rw [getElem_permIdx, ← List.getD_eq_getElem _ 0 h₂, getD_append4, getD_append4]
  simp only [length_permIdx, List.length_append] at h₁
  unfold rotIdx
  by_cases c1 : A.length ≤ k ∧ k < A.length + C.length
  · rw [if_pos c1]; split_ifs <;> first | omega | (congr 1; omega)
  · rw [if_neg c1]
    by_cases c2 : A.length + C.length ≤ k ∧ k < A.length + C.length + B.length
    · rw [if_pos c2]; split_ifs <;> first | omega | (congr 1; omega)
    · rw [if_neg c2]; split_ifs <;> first | omega | (congr 1; omega)

/-- **The joining moves.** The rotation moving the block `C` (`c` fields) in front of the block
`B` is the composition of `c` single-field moves (primitive (a)): move the field at position
`s + t` in front of `B`, for `t = 0, …, c - 1`. (List level: applies to addresses and shapes.) -/
theorem rot_as_moves (s b : ℕ) : ∀ (c : ℕ) (l : List ℕ), s + b + c ≤ l.length →
    (List.range c).foldl (fun l' t => permIdx (rotIdx (s + t) b 1) l') l =
      permIdx (rotIdx s b c) l := by
  intro c
  induction c with
  | zero =>
    intro l _
    simp only [List.range_zero, List.foldl_nil]
    exact (permIdx_of_id fun k _ => by unfold rotIdx; split_ifs <;> omega).symm
  | succ c ih =>
    intro l hl
    rw [List.range_succ, List.foldl_append, ih l (by omega), List.foldl_cons, List.foldl_nil,
      permIdx_permIdx (fun k hk => rotIdx_lt (by simp; omega) hk)]
    apply permIdx_congr
    intro k _
    simp only [Function.comp_apply]
    unfold rotIdx; split_ifs <;> omega

end Rotation

end AModelL12

