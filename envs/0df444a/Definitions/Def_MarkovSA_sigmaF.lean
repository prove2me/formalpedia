-- title:
--   The σ-algebra $\mathcal F_k$ generated by $\{(x_i,Y_i,w_i)\}_{i\le k-1}\cup\{x_k\}$
-- statement:
--   For processes $x$, $Y$, $w$ the σ-algebra $\mathcal F_k$ is the one generated by
--
--   $$
--   \{(x_i,Y_i,w_i)\}_{0\le i\le k-1}\cup\{x_k\}.
--   $$
--
--   It contains the past of all three processes and the current iterate, but not the current state $Y_k$. Assumption 2.4 (1) asks that the noise $w_k$ has conditional mean zero given $\mathcal F_k$.
-- source:
--   Chen, Maguluri, Shakkottai & Shanmugam, A Lyapunov Theory for Finite-Sample Guarantees of Markovian Stochastic Approximation, arXiv:2102.01567v4, §2.1, sentence before Assumption 2.4, p.6

import Mathlib

namespace MarkovSA

/-- The σ-algebra `𝓕_k` generated by `{(x_i, Y_i, w_i)}_{0 ≤ i ≤ k−1} ∪ {x_k}`
(Chen, Maguluri, Shakkottai & Shanmugam, arXiv:2102.01567v4, §2.1, p.6, the sentence before Assumption 2.4). Note that `Y_k` is **not** in `𝓕_k`. -/
@[reducible] def sigmaF {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E] [MeasurableSpace E] [BorelSpace E] {𝒴 : Type*} [Fintype 𝒴] [DecidableEq 𝒴] [MeasurableSpace 𝒴] [MeasurableSingletonClass 𝒴] {Ω : Type*}
    (x : ℕ → Ω → E) (Y : ℕ → Ω → 𝒴) (w : ℕ → Ω → E) (k : ℕ) : MeasurableSpace Ω :=
  (⨆ i ∈ Finset.range k,
      (MeasurableSpace.comap (x i) inferInstance ⊔ MeasurableSpace.comap (Y i) inferInstance ⊔
        MeasurableSpace.comap (w i) inferInstance)) ⊔
    MeasurableSpace.comap (x k) inferInstance

end MarkovSA


