              (Scheme.ΓSpecIso (CommRingCat.of ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin A (↥K) j))).inv.hom)
        let Ψ : ↥(chartAlgFin A (↥K) j) →+* S := (e₁ : CMP →+* S).comp (toC.comp germY)
        let La := Localization.Away (Ψ a)
        let 𝔐 : Ideal S := Ideal.span {mkS (MvPowerSeries.C (σ₁ ϖt)), mkS (MvPowerSeries.X 0), mkS (MvPowerSeries.X 1)}
        let R : Subring La := Subring.closure
          (Set.range (algebraMap S La) ∪ {x : La | ∃ i ∈ 𝔐, x * algebraMap S La (Ψ a) = algebraMap S La i})

        Ψ a ∈ nonZeroDivisors S ∧ Ψ a ∈ 𝔐 ∧
        ∃ (Φ : ↥Ba →+* La) (hΦR : ∀ b : ↥Ba, Φ b ∈ R),

          (∀ (c : ↥(chartAlgFin A (↥K) j)) (hc : ((c : ↥(chartAlgFin A (↥K) j)) : ↥K) ∈ Ba), Φ ⟨_, hc⟩ = algebraMap S La (Ψ c)) ∧
          (∀ (x : ↥K) (hx : x ∈ Ba) (i : ↥(chartAlgFin A (↥K) j)), i ∈ J → x * ((a : ↥(chartAlgFin A (↥K) j)) : ↥K) = ((i : ↥(chartAlgFin A (↥K) j)) : ↥K) →
            Φ ⟨x, hx⟩ * algebraMap S La (Ψ a) = algebraMap S La (Ψ i)) ∧

          ∃ (P' : Ideal ↥R) (_ : P'.IsMaximal),
            (∀ b : ↥Ba, (⟨Φ b, hΦR b⟩ : ↥R) ∈ P' ↔ b ∈ P) ∧
            (∀ (s : S) (hs : algebraMap S La s ∈ R),
              s ∈ Ideal.span {mkS (MvPowerSeries.C (σ₁ ϖ)), mkS (MvPowerSeries.X 0), mkS (MvPowerSeries.X 1)} →
              (⟨algebraMap S La s, hs⟩ : ↥R) ∈ P') ∧

            ∃ T : AdicCompletion P ↥Ba ≃+* AdicCompletion P' ↥R,
              ∀ b : ↥Ba, T (algebraMap ↥Ba (AdicCompletion P ↥Ba) b) =
                algebraMap ↥R (AdicCompletion P' ↥R) ⟨Φ b, hΦR b⟩ := by sorry
