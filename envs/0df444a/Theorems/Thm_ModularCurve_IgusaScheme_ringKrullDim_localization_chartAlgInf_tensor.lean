theorem ModularCurve.IgusaScheme.ringKrullDim_localization_chartAlgInf_tensor
    (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime]
    (k : Type) [Field k] [CharP k ℓ] [Algebra ↥(GaloisRep.ratLocalizedAt ℓ) k]
    (m : Ideal (k ⊗[↥(GaloisRep.ratLocalizedAt ℓ)] ↥(chartAlgInf N ℓ))) [m.IsMaximal] :
    ringKrullDim (Localization.AtPrime m) = (1 : ℕ∞) := by sorry
