    centerBLowerYBox.Contains (Y (lower E8TAxisZero0071PaddedInputs.centerBInput.alpha)) := by
  have e : lower E8TAxisZero0071PaddedInputs.centerBInput.alpha = ((1571725475230391432901411083389706526352748507609 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
