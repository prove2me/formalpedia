namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

attribute [local instance 2000] localizedTermAddCommGroup localizedTermModule

noncomputable local instance (priority := 3000) hochsterRestrictionTermAddCommMonoid
    (K : Complex V) (T : Finset V) (a : V → ℤ) (p : ℕ) :
    AddCommMonoid (LocalizedCechTerm k K T a p) :=
  (localizedTermAddCommGroup k K T a p).toAddCommMonoid

/-- The link-cochain orientation factor depends only on its two faces,
so the specified signed Hochster comparison commutes with ordinary
restriction of face functions. -/
theorem hochsterModelLinkEquiv_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (a : V → ℤ) (q : ℕ)
    (ha : positiveSupport a = ∅) (y : CechBasis L Finset.univ a q → k) :
    hochsterModelLinkEquiv k rank K a q ha (modelFaceRestriction k h Finset.univ a q y) =
      (offsetFaceRestriction k rank (link_faces_mono h (negativeSupport a))
        (negativeSupport a).card).f (q : ℤ) (hochsterModelLinkEquiv k rank L a q ha y) := by
  funext G
  rfl

theorem hochsterOffsetActualTermEquiv_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (a : V → ℤ) (q : ℕ)
    (ha : positiveSupport a = ∅)
    (y : (localizedCechComplex k rank L Finset.univ a).X q) :
    hochsterOffsetActualTermEquiv k rank K a q ha
        (localizedCechTermRestriction k rank h Finset.univ a q y) =
      (offsetFaceRestriction k rank (link_faces_mono h (negativeSupport a))
        (negativeSupport a).card).f (q : ℤ) (hochsterOffsetActualTermEquiv k rank L a q ha y) := by
  change hochsterModelLinkEquiv k rank K a q ha
      (actualTermEquivModel k K Finset.univ a q
        (localizedCechTermRestriction k rank h Finset.univ a q y)) = _
  rw [actualTermEquivModel_restriction]
  exact hochsterModelLinkEquiv_restriction k rank h a q ha _

/-- Naturality of the actual homogeneous Cech-to-signed-link cochain
comparison, before the exact reduced-degree reindexing. -/
@[reassoc] theorem hochsterActualComplexIso_restriction (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (a : V → ℤ) (ha : positiveSupport a = ∅) :
    localizedCechRestriction k rank h Finset.univ a ≫ (hochsterActualComplexIso k rank K a ha).hom =
      (hochsterActualComplexIso k rank L a ha).hom ≫
        HomologicalComplex.restrictionMap
          (offsetFaceRestriction k rank (link_faces_mono h (negativeSupport a))
            (negativeSupport a).card) ComplexShape.embeddingUpNat := by
  apply HomologicalComplex.hom_ext
  intro q
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  exact hochsterOffsetActualTermEquiv_restriction k rank h a q ha y

end LPCA


