section
set_option autoImplicit false

namespace FiniteSampleDependence.Dev.Goal

open FiniteSampleDependence.Rigidity FiniteSampleDependence.Dev.GoalH MvPolynomial Matrix
open scoped Classical

theorem homog_mem_pow {n m : ℕ} (hn : 2 ≤ n) (hnm : n ≤ m) (F : PolyRing n m)
    (hL : LFDPI (polyFun F)) (hI : IZ (polyFun F)) :
    homog F ∈ maxMinorIdeal n m ^ 2 := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
  have hm : 2 ≤ m := by omega
  have hk : 1 ≤ k := by omega
  have hnon := (nonnegativity_permutation_invariance hn hm (polyFun F)).1 hL hI
  have hne : (Finset.univ : Finset (Fin (k + 1))).Nonempty := ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  have hne' : (Finset.univ : Finset (Fin m)).Nonempty := ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
  have hτpos : ∀ V : Matrix (Fin (k + 1)) (Fin m) ℝ, (∀ i α, 0 < V i α) → 0 < tau V := by
    intro V hV
    exact Finset.sum_pos (fun i _ => Finset.sum_pos (fun α _ => hV i α) hne') hne
  have hpos : ∀ V : Matrix (Fin (k + 1)) (Fin m) ℝ, (∀ i α, 0 < V i α) → 0 ≤ polyFun (homog F) V := by
    intro V hV
    have hτ := hτpos V hV
    rw [polyFun_homog F V hτ]
    exact mul_nonneg (pow_nonneg hτ.le _)
      (hnon _ (smul_mem_simplex V (fun i α => (hV i α).le) hτ))
  have hzero : ∀ V : Matrix (Fin (k + 1)) (Fin m) ℝ, (∀ i α, 0 < V i α) →
      (∃ c : Fin k → ℝ, (∀ i, 0 ≤ c i) ∧
        ∀ α, V (Fin.last k) α = ∑ i : Fin k, c i * V (Fin.castSucc i) α) →
      polyFun (homog F) V = 0 := by
    intro V hV ⟨c, hc0, hc⟩
    have hτ := hτpos V hV
    rw [polyFun_homog F V hτ]
    have : polyFun F ((tau V)⁻¹ • V) = 0 := by
      refine row_cone_vanishing hn hm (polyFun F) (isC1Extendable_polyFun F) hL hI _
        (smul_mem_simplex V (fun i α => (hV i α).le) hτ) (Fin.last k)
        ⟨fun i => if h : i.val < k then c ⟨i.val, h⟩ else 0, fun i => ?_, fun α => ?_⟩
      · by_cases h : i.val < k
        · simp [h, hc0]
        · simp [h]
      · rw [Finset.sum_erase _ (by simp), Fin.sum_univ_castSucc]
        simp only [Matrix.smul_apply, smul_eq_mul, hc α, Finset.mul_sum]
        simp [Fin.is_lt]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        ring
    rw [this, mul_zero]
  obtain ⟨N, hN⟩ := GoalS.schur_main hnm hk (homog F) hpos hzero
  obtain ⟨hprime, -, -, hsat⟩ := maximal_minor_saturation hn hnm
  have hnot : GoalB.delta hnm ^ N ∉ maxMinorIdeal (k + 1) m :=
    fun h => GoalH.delta_not_mem hnm (hprime.mem_of_pow_mem N h)
  exact hsat _ _ hnot hN

theorem part_one {n m : ℕ} (hn : 2 ≤ n) (hnm : n ≤ m) (F : PolyRing n m)
    (hL : LFDPI (polyFun F)) (hI : IZ (polyFun F)) :
    F ∈ maxMinorIdeal n m ^ 2 ⊔ simplexIdeal n m ∧
      ((∃ U ∈ simplex n m, polyFun F U ≠ 0) → 2 * n ≤ F.totalDegree) := by
  have hH := homog_mem_pow hn hnm F hL hI
  refine ⟨?_, ?_⟩
  · have : F = homog F - (homog F - F) := by ring
    rw [this]
    exact Ideal.sub_mem _ (Ideal.mem_sup_left hH) (Ideal.mem_sup_right (homog_sub_mem F))
  · rintro ⟨U, hU, hne⟩
    refine deg_lower (homog F) hH (homog_isHomogeneous F) (fun h0 => hne ?_)
    have h1 : tau U = 1 := hU.2
    have hτ : 0 < tau U := by rw [h1]; exact one_pos
    have := polyFun_homog F U hτ
    rw [h0] at this
    simp only [polyFun, map_zero] at this
    rw [h1] at this
    simpa [polyFun] using this.symm

theorem square_case {n : ℕ} (hn : 2 ≤ n) (F : PolyRing n n)
    (hL : LFDPI (polyFun F)) (hI : IZ (polyFun F)) :
    ∃ G : PolyRing n n, ∀ U ∈ simplex n n, polyFun F U = U.det ^ 2 * polyFun G U := by
  have h1 := (part_one hn le_rfl F hL hI).1
  have hid : maxMinorIdeal n n = Ideal.span {maxMinor (id : Fin n → Fin n)} := by
    apply le_antisymm
    · refine Ideal.span_le.2 ?_
      rintro _ ⟨s, hs, rfl⟩
      rw [hs.eq_id]
      exact Ideal.subset_span rfl
    · exact Ideal.span_le.2 (by
        rintro _ rfl
        exact Ideal.subset_span ⟨id, strictMono_id, rfl⟩)
  rw [hid, Ideal.span_singleton_pow, Submodule.mem_sup] at h1
  obtain ⟨a, ha, b, hb, hab⟩ := h1
  rw [Ideal.mem_span_singleton'] at ha
  obtain ⟨G, hG⟩ := ha
  unfold simplexIdeal at hb
  rw [Ideal.mem_span_singleton'] at hb
  obtain ⟨h, hh⟩ := hb
  refine ⟨G, fun U hU => ?_⟩
  have hD : polyFun (maxMinor (id : Fin n → Fin n)) U = U.det := by
    unfold polyFun maxMinor
    rw [RingHom.map_det]
    congr 1
    refine Matrix.ext fun i j => ?_
    simp [genericMatrix, Matrix.mvPolynomialX_apply]
  rw [← hab, ← hG, ← hh]
  simp only [polyFun, map_add, map_mul, map_sub, map_pow, map_one]
  have hτ : polyFun (tauPoly n n) U = 1 := by rw [polyFun_tauPoly]; exact hU.2
  simp only [polyFun] at hτ hD
  rw [hτ, hD]
  ring

end FiniteSampleDependence.Dev.Goal

namespace FiniteSampleDependence.Rigidity

theorem chk_determinantal_rigidity_full {n m : ℕ} (hn : 2 ≤ n) (hnm : n ≤ m) :
    (∀ F : PolyRing n m, LFDPI (polyFun F) → IZ (polyFun F) →
      F ∈ maxMinorIdeal n m ^ 2 ⊔ simplexIdeal n m ∧
      ((∃ U ∈ simplex n m, polyFun F U ≠ 0) → 2 * n ≤ F.totalDegree)) ∧
    ((∃ U ∈ simplex n m, polyFun (gramPoly n m) U ≠ 0) ∧
      (gramPoly n m).totalDegree = 2 * n ∧
      LFDPI (polyFun (gramPoly n m)) ∧ IZ (polyFun (gramPoly n m))) ∧
    (n = m → ∀ F : PolyRing n n, LFDPI (polyFun F) → IZ (polyFun F) →
      ∃ G : PolyRing n n, ∀ U ∈ simplex n n, polyFun F U = U.det ^ 2 * polyFun G U) := by
  refine ⟨fun F hL hI => Dev.Goal.part_one hn hnm F hL hI, ?_, ?_⟩
  · have h := gram_determinant_monotone hn hnm
    exact ⟨h.2.1, h.2.2.1, h.2.2.2.1, h.2.2.2.2⟩
  · intro h F hL hI
    subst h
    exact Dev.Goal.square_case hn F hL hI

end FiniteSampleDependence.Rigidity

end

theorem solution : type_of% @FiniteSampleDependence.Rigidity.chk_determinantal_rigidity_full := @FiniteSampleDependence.Rigidity.chk_determinantal_rigidity_full
