theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)

    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) {N : ℕ} [NeZero N]
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓq : ℓ ≠ q) (hℓq' : ℓ ≠ q')

    (𝒪₀ : Type) [CommRing 𝒪₀]
    (𝒳₀ : Scheme.{0}) (f₀ : 𝒳₀ ⟶ Spec (CommRingCat.of 𝒪₀))
    (pt₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪₀)), FakeEllipticCurve Λ N S → SchemeHomOver s f₀)
    (h𝒳₀ : IsCoarseModuli Λ N 𝒳₀ f₀ pt₀) [LocallyOfFiniteType f₀]
    (𝒴 : Scheme.{0}) (g : 𝒴 ⟶ Spec (CommRingCat.of 𝒪₀))
    (ptT : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪₀)),
      FakeEllipticCurve.WithExtraLevel Λ N ℓ S → SchemeHomOver s g)
    (h𝒴 : IsCoarseModuliT Λ N ℓ 𝒴 g ptT)
    (d₀ d₁ : 𝒴 ⟶ 𝒳₀)
    (hd₀ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪₀))
      (u : FakeEllipticCurve.WithExtraLevel Λ N ℓ S), (ptT S s u).1 ≫ d₀ = (pt₀ S s u.1).1)
    (hd₁ : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪₀))
      (u : FakeEllipticCurve.WithExtraLevel Λ N ℓ S) (d : FakeEllipticCurve Λ N S),
      FakeEllipticCurve.IsLevelIsogeny ℓ u d → (ptT S s u).1 ≫ d₁ = (pt₀ S s d).1)

    (K : Type) [Field K] [IsAlgClosed K] [CharZero K] (sK : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of 𝒪₀))
    [hXKint : IsIntegral (Limits.pullback f₀ sK)] [hYKint : IsIntegral (Limits.pullback g sK)]
    :
    ∀ (k : Fin 2) (dK : Limits.pullback g sK ⟶ Limits.pullback f₀ sK),
      dK ≫ Limits.pullback.fst f₀ sK = Limits.pullback.fst g sK ≫ (if k = 0 then d₀ else d₁) →
      dK ≫ Limits.pullback.snd f₀ sK = Limits.pullback.snd g sK →
      dK.base (genericPoint ((Limits.pullback g sK) : Scheme.{0})) = genericPoint ((Limits.pullback f₀ sK) : Scheme.{0}) := by

  intro k dK hdK1 hdK2
  classical
  haveI : LocallyOfFiniteType (Limits.pullback.snd f₀ sK) := inferInstance
  haveI : JacobsonSpace ↥(Limits.pullback f₀ sK) := LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd f₀ sK)
  have hℓK : ((ℓ : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.2 (Fact.out : ℓ.Prime).ne_zero
  have hNK : ((N : ℕ) : K) ≠ 0 := Nat.cast_ne_zero.2 (NeZero.ne N)

  have hrange : closedPoints ↥(Limits.pullback f₀ sK) ⊆ Set.range dK.base := by
    intro c hc
    have hx : (pointOfClosedPoint (Limits.pullback.snd f₀ sK) c hc ≫ Limits.pullback.fst f₀ sK) ≫ f₀ = sK := by
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, pointOfClosedPoint_comp, Category.id_comp]
    obtain ⟨E, hE⟩ := h𝒳₀.pt_surjective K sK ⟨pointOfClosedPoint (Limits.pullback.snd f₀ sK) c hc ≫ Limits.pullback.fst f₀ sK, hx⟩
    obtain ⟨u, hu⟩ : ∃ u : FakeEllipticCurve.WithExtraLevel Λ N ℓ K,
        (ptT K sK u).1 ≫ (if k = 0 then d₀ else d₁) = (pt₀ K sK E).1 := by
      by_cases hk : k = 0
      · obtain ⟨n, Ks, hn, -, -⟩ :=
          CerednikDrinfeld.QM.FakeEllipticCurve.exists_extraLevel_enum hqq' hB Λ hΛ ℓ hℓq hℓq' K hℓK hNK E
        have hn0 : 0 < n := by
          rw [hn]; split_ifs
          · exact (Fact.out : ℓ.Prime).pos
          · exact Nat.succ_pos ℓ
        refine ⟨⟨E, Ks ⟨0, hn0⟩⟩, ?_⟩
        rw [if_pos hk]
        exact hd₀ K sK ⟨E, Ks ⟨0, hn0⟩⟩
      · obtain ⟨u, hu⟩ :=
          CerednikDrinfeld.QM.FakeEllipticCurve.exists_withExtraLevel_isLevelIsogeny hqq' hB Λ hΛ ℓ hℓq hℓq' K hℓK hNK E
        exact ⟨u, by rw [if_neg hk]; exact hd₁ K sK u E hu⟩
    let y : Spec (CommRingCat.of K) ⟶ (Limits.pullback g sK) :=
      Limits.pullback.lift (ptT K sK u).1 (𝟙 _) (by rw [(ptT K sK u).2, Category.id_comp])
    have hy : y ≫ dK = pointOfClosedPoint (Limits.pullback.snd f₀ sK) c hc := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hdK1, ← Category.assoc, Limits.pullback.lift_fst, hu]
        exact congrArg Subtype.val hE
      · rw [Category.assoc, hdK2, Limits.pullback.lift_snd, pointOfClosedPoint_comp]
    refine ⟨y.base (IsLocalRing.closedPoint K), ?_⟩
    change (y ≫ dK).base (IsLocalRing.closedPoint K) = c
    rw [hy]
    exact pointOfClosedPoint_apply _ _ _ _
  have hcl : closure (Set.range dK.base) = Set.univ := by
    apply Set.eq_univ_of_univ_subset
    rw [← closure_closedPoints (X := ↥(Limits.pullback f₀ sK))]
    exact closure_mono hrange
  have hgen : IsGenericPoint (dK.base (genericPoint ↥(Limits.pullback g sK))) (closure (Set.range dK.base)) := by
    have := (genericPoint_spec ↥(Limits.pullback g sK)).image dK.base.hom.continuous
    rwa [Set.image_univ] at this
  rw [hcl] at hgen
  exact hgen.eq (genericPoint_spec ↥(Limits.pullback f₀ sK))

