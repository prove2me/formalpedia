theorem tF6_eq (P : Prm) (n : ℕ) (hl : 1 ≤ ℓP6 P n) (j : ℕ) (hj : j < dP6 P n) :
    tF6 P n j = 2 ^ OpenAI.RP.axExp (LP6 P n) (dP6 P n) ⟨j, hj⟩ := by
  have hl' : 1 ≤ OpenAI.RP.ell (LP6 P n) (dP6 P n) := hl
  unfold tF6 OpenAI.RP.axExp bL6
  have e1 : hN6 P n = OpenAI.RP.ell (LP6 P n) (dP6 P n) - 1 := rfl
  have e2 : dpN6 P n = OpenAI.RP.mcnt (LP6 P n) (dP6 P n) := rfl
  rw [e1, e2]
  simp only [decide_eq_true_eq]
  by_cases h : OpenAI.RP.mcnt (LP6 P n) (dP6 P n) ≤ j
  · rw [if_pos h, if_neg (by omega), ← pow_succ]; congr 1; omega
  · rw [if_neg h, if_pos (by omega)]

theorem prod_tF6 (P : Prm) (n : ℕ) (hd : 1 ≤ dP6 P n) (hl : 1 ≤ ℓP6 P n) :
    ∏ j ∈ Finset.range (dP6 P n), tF6 P n j = 2 ^ LP6 P n := by
  have e := OpenAI.RP.axLen_prod (LP6 P n) (dP6 P n) (by omega)
  rw [← e, ← Fin.prod_univ_eq_prod_range]
  refine Finset.prod_congr rfl fun j _ => ?_
  exact tF6_eq P n hl j.val j.isLt

/-- `S ≥ (1 - 1/(4d)) T`-type bound: `2 M ≤ S`. -/
theorem MS_of_sol_aux (P : Prm) (n : ℕ) (src : ℕ → ℕ) (hs : SrcOK6 P n src) (hd : 1 ≤ dP6 P n)
    (hl : 1 ≤ ℓP6 P n) (hL : 3 ≤ LP6 P n) (hb : 1 ≤ b'P6 P n) :
    2 * M6 P n ≤ S6 P n src := by
  set d := dP6 P n with hdd
  have hd0 : (0 : ℝ) < d := by exact_mod_cast hd
  set c : ℝ := 1 - 1 / (4 * (d : ℝ) ^ 2) with hc
  have hc0 : 0 ≤ c := by
    rw [hc]
    have : 1 / (4 * (d : ℝ) ^ 2) ≤ 1 := by
      rw [div_le_one (by positivity)]
      have : (1 : ℝ) ≤ d := by exact_mod_cast hd
      nlinarith
    linarith
  -- per axis
  have hj : ∀ j ∈ Finset.range d, c * (tF6 P n j : ℝ) ≤ (src j : ℝ) := by
    intro j hjr
    have hj := Finset.mem_range.1 hjr
    have lo := hs.lo j hj
    set t := tF6 P n j
    set w := wnd6 P n j with hw
    have hw8 : w * (8 * d ^ 2) ≤ t := by rw [hw]; exact Nat.div_mul_le_self _ _
    have h8 : 8 ≤ 8 * d ^ 2 := by nlinarith
    have h2w : 2 * w ≤ t := by nlinarith
    have hsr : (t : ℝ) - 2 * w ≤ src j := by
      have : t - 2 * w ≤ src j := by omega
      have : ((t - 2 * w : ℕ) : ℝ) ≤ src j := by exact_mod_cast this
      rw [Nat.cast_sub h2w] at this; push_cast at this; exact this
    have hwr : (w : ℝ) * (8 * (d : ℝ) ^ 2) ≤ t := by exact_mod_cast hw8
    have : c * (t : ℝ) = t - t / (4 * (d : ℝ) ^ 2) := by rw [hc]; ring
    rw [this]
    have : 2 * (w : ℝ) ≤ t / (4 * (d : ℝ) ^ 2) := by
      rw [le_div_iff₀ (by positivity)]; nlinarith
    linarith
  have hprod : ∏ j ∈ Finset.range d, c * (tF6 P n j : ℝ) ≤ ∏ j ∈ Finset.range d, (src j : ℝ) :=
    Finset.prod_le_prod (fun j _ => mul_nonneg hc0 (Nat.cast_nonneg _)) hj
  rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_range] at hprod
  have hT : ∏ j ∈ Finset.range d, (tF6 P n j : ℝ) = (2 : ℝ) ^ LP6 P n := by
    have := prod_tF6 P n hd hl
    exact_mod_cast this
  rw [hT] at hprod
  -- Bernoulli
  have hbern : 1 + (d : ℝ) * (-(1 / (4 * (d : ℝ) ^ 2))) ≤ c ^ d := by
    have := one_add_mul_le_pow (a := -(1 / (4 * (d : ℝ) ^ 2)))
      (by have : 1 / (4 * (d : ℝ) ^ 2) ≤ 1 := by
            rw [div_le_one (by positivity)]
            have : (1 : ℝ) ≤ d := by exact_mod_cast hd
            nlinarith
          linarith) d
    rw [hc]; simpa [sub_eq_add_neg] using this
  have hq : (d : ℝ) * (1 / (4 * (d : ℝ) ^ 2)) ≤ 1 / 4 := by
    rw [show (d : ℝ) * (1 / (4 * (d : ℝ) ^ 2)) = 1 / (4 * d) by field_simp]
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]
    have : (1 : ℝ) ≤ d := by exact_mod_cast hd
    nlinarith
  have hcd : (3 : ℝ) / 4 ≤ c ^ d := by nlinarith
  -- M
  have hTb := T_lower P n
  have hM : M6 P n * b'P6 P n ≤ n + b'P6 P n - 1 := Nat.div_mul_le_self _ _
  have h4M : 4 * M6 P n ≤ TP6 P n + 4 := by
    have : 4 * M6 P n * b'P6 P n ≤ (TP6 P n + 4) * b'P6 P n := by
      have : (TP6 P n + 4) * b'P6 P n = TP6 P n * b'P6 P n + 4 * b'P6 P n := by ring
      rw [this]; rw [mul_assoc]; omega
    exact Nat.le_of_mul_le_mul_right this (by omega)
  have hT8 : 8 ≤ TP6 P n := by
    unfold TP6
    calc 8 = 2 ^ 3 := by norm_num
      _ ≤ 2 ^ LP6 P n := Nat.pow_le_pow_right (by norm_num) hL
  have hTR : (8 : ℝ) ≤ (2 : ℝ) ^ LP6 P n := by
    have : ((8 : ℕ) : ℝ) ≤ ((TP6 P n : ℕ) : ℝ) := by exact_mod_cast hT8
    simpa [TP6] using this
  have h4MR : 4 * (M6 P n : ℝ) ≤ (2 : ℝ) ^ LP6 P n + 4 := by
    have : ((4 * M6 P n : ℕ) : ℝ) ≤ ((TP6 P n + 4 : ℕ) : ℝ) := by exact_mod_cast h4M
    push_cast at this; simpa [TP6] using this
  have hS : (2 * M6 P n : ℝ) ≤ ∏ j ∈ Finset.range d, (src j : ℝ) := by
    have h0 : (0 : ℝ) ≤ (2 : ℝ) ^ LP6 P n := by positivity
    nlinarith
  have : ((2 * M6 P n : ℕ) : ℝ) ≤ ((S6 P n src : ℕ) : ℝ) := by
    unfold S6; push_cast; exact hS
  exact_mod_cast this

end

end IntMul.Kappa.R6

