namespace P2MICS

open MvPolynomial

variable {N n : ℕ} {R : Type*} [CommRing R]

/-! ### The coefficient action of an integral matrix is defined over `ℤ` -/

theorem act_map (g : Matrix (Fin 2) (Fin 2) ℤ) (P : Binary ℤ) :
    MvPolynomial.map (Int.castRingHom R) (act g P)
      = act g (MvPolynomial.map (Int.castRingHom R) P) := by
  induction P using MvPolynomial.induction_on with
  | C a => simp [act]
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp =>
      simp only [act, map_mul, AlgHom.toLinearMap_apply] at hp ⊢
      rw [hp]
      congr 1
      simp [MvPolynomial.smul_eq_C_mul]

theorem act_monomial_int (g : Matrix (Fin 2) (Fin 2) ℤ) (d e : Fin 2 →₀ ℕ) :
    ∃ z : ℤ, MvPolynomial.coeff e (act (R := R) g (MvPolynomial.monomial d (1 : R)))
      = (z : R) := by
  refine ⟨MvPolynomial.coeff e (act (R := ℤ) g (MvPolynomial.monomial d (1 : ℤ))), ?_⟩
  have h := act_map (R := R) g (MvPolynomial.monomial d (1 : ℤ))
  rw [MvPolynomial.map_monomial] at h
  simp only [map_one] at h
  rw [← h, MvPolynomial.coeff_map]
  rfl

/-! ### Polynomials whose coefficients lie in a fixed subgroup -/

/-- The `ℤ`-submodule of binary forms all of whose coefficients lie in `A`. -/
def CIn (A : Submodule ℤ R) : Submodule ℤ (Binary R) where
  carrier := {P | ∀ d, MvPolynomial.coeff d P ∈ A}
  zero_mem' := by intro d; simp
  add_mem' := by intro P Q hP hQ d; rw [MvPolynomial.coeff_add]; exact A.add_mem (hP d) (hQ d)
  smul_mem' := by
    intro c P hP d
    rw [MvPolynomial.coeff_smul]
    exact A.smul_mem c (hP d)

theorem mem_CIn {A : Submodule ℤ R} {P : Binary R} :
    P ∈ CIn A ↔ ∀ d, MvPolynomial.coeff d P ∈ A := Iff.rfl

theorem CIn_act (A : Submodule ℤ R) (g : Matrix (Fin 2) (Fin 2) ℤ) {P : Binary R}
    (hP : P ∈ CIn A) : act g P ∈ CIn A := by
  have hexp : act g P = ∑ d ∈ P.support,
      MvPolynomial.coeff d P • act g (MvPolynomial.monomial d (1 : R)) := by
    conv_lhs => rw [MvPolynomial.as_sum P]
    rw [map_sum]
    refine Finset.sum_congr rfl fun d _ => ?_
    rw [← map_smul]
    congr 1
    rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
  intro e
  rw [hexp, MvPolynomial.coeff_sum]
  refine Submodule.sum_mem _ fun d _ => ?_
  obtain ⟨z, hz⟩ := act_monomial_int (R := R) g d e
  rw [MvPolynomial.coeff_smul, hz, smul_eq_mul]
  have := A.smul_mem z (hP d)
  rwa [zsmul_eq_mul, mul_comm] at this

/-! ### All coefficients of a class lie in the span of its Manin coordinates -/

theorem cuspAct_mul (g h : Matrix.SpecialLinearGroup (Fin 2) ℤ) (x : Cusp) :
    cuspAct (g * h) x = cuspAct g (cuspAct h x) := by
  simp [cuspAct, map_mul, mul_smul]

/-- The right-coset space of `Γ₁(N)` in `SL(2,ℤ)`. -/
abbrev Cos (N : ℕ) := Quotient (QuotientGroup.rightRel (CongruenceSubgroup.Gamma1 N))

instance cosFinite (N : ℕ) [NeZero N] : Finite (Cos N) :=
  Finite.of_equiv _
    (QuotientGroup.quotientRightRelEquivQuotientLeftRel (CongruenceSubgroup.Gamma1 N)).symm

/-- The finite index set of Manin coordinates. -/
abbrev Idx (N n : ℕ) := Cos N × Fin (n + 1)

/-- The exponent vector of `X^j Y^{n-j}`. -/
def mono (n j : ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun i : Fin 2 => if i = 0 then j else n - j)

theorem mono_apply (n j : ℕ) (i : Fin 2) : mono n j i = if i = 0 then j else n - j := rfl

theorem deg_eq (d : Fin 2 →₀ ℕ) : d.degree = d 0 + d 1 := by
  rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]

theorem eq_mono (m : ℕ) (d : Fin 2 →₀ ℕ) (hd : d.degree = m) : d = mono m (d 0) := by
  rw [deg_eq] at hd
  ext i
  have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
  rcases hi with rfl | rfl
  · rw [mono_apply]; simp
  · rw [mono_apply]; simp; omega

/-- Manin coordinates of a class: the `X^j Y^{n-j}` coefficients on the unimodular paths
attached to a fixed set of coset representatives. -/
def coordFn (Φ : Hc N n R) : Idx N n → R := fun z =>
  MvPolynomial.coeff (mono n z.2.val)
    (Φ.val (cuspAct z.1.out ((0 : ℚ) : Cusp), cuspAct z.1.out OnePoint.infty))

/-- The subgroup of `R` generated by the Manin coordinates of `Φ`. -/
def Acoef (Φ : Hc N n R) : Submodule ℤ R := Submodule.span ℤ (Set.range (coordFn Φ))

theorem coeff_rep_mem (Φ : Hc N n R) (q : Cos N) :
    Φ.val (cuspAct q.out ((0 : ℚ) : Cusp), cuspAct q.out OnePoint.infty) ∈ CIn (Acoef Φ) := by
  intro d
  by_cases hd : d.degree = n
  · have hle : d 0 ≤ n := by rw [deg_eq] at hd; omega
    rw [eq_mono n d hd]
    exact Submodule.subset_span ⟨(q, ⟨d 0, by omega⟩), rfl⟩
  · have hΦ := (MvPolynomial.mem_homogeneousSubmodule _ _).mp
      (Φ.2.1 (cuspAct q.out ((0 : ℚ) : Cusp)) (cuspAct q.out OnePoint.infty))
    rw [hΦ.coeff_eq_zero hd]
    exact Submodule.zero_mem _

theorem coeff_mem [NeZero N] (Φ : Hc N n R) (D : Cusp × Cusp) : Φ.val D ∈ CIn (Acoef Φ) := by
  obtain ⟨x, y⟩ := D
  have h := MTT.Cohomology.manin_generation_span Φ x y
  refine (AddSubgroup.closure_le (CIn (Acoef Φ)).toAddSubgroup).mpr ?_ h
  rintro _ ⟨g, rfl⟩
  set q : Cos N := Quotient.mk _ g with hqdef
  have hmk : (Quotient.mk (QuotientGroup.rightRel (CongruenceSubgroup.Gamma1 N)) q.out)
      = Quotient.mk _ g := by rw [Quotient.out_eq]
  have hrel : g * (Quotient.out q)⁻¹ ∈ CongruenceSubgroup.Gamma1 N :=
    QuotientGroup.rightRel_apply.mp (Quotient.exact hmk)
  obtain ⟨γ, hγ⟩ : ∃ γ : CongruenceSubgroup.Gamma1 N, g = γ.val * q.out :=
    ⟨⟨g * (q.out)⁻¹, hrel⟩, by simp⟩
  show Φ.val _ ∈ CIn (Acoef Φ)
  rw [hγ, cuspAct_mul, cuspAct_mul, Φ.2.2.2 γ]
  exact CIn_act _ _ (coeff_rep_mem Φ q)

/-! ### Descent along a basis of the coefficient subgroup -/

section Descent

variable {m : ℕ} (A : Submodule ℤ R) (b : Module.Basis (Fin m) ℤ A)

open Classical in
/-- The `i`-th coordinate of an element of `A` in the basis `b`, extended by zero. -/
def qc (i : Fin m) (r : R) : ℤ := if h : r ∈ A then b.repr ⟨r, h⟩ i else 0

theorem qc_mem (i : Fin m) {r : R} (h : r ∈ A) : qc A b i r = b.repr ⟨r, h⟩ i := by
  classical
  simp only [qc, dif_pos h]

theorem qc_zero (i : Fin m) : qc A b i 0 = 0 := by
  rw [qc_mem A b i A.zero_mem]
  have h0 : (⟨(0 : R), A.zero_mem⟩ : A) = 0 := rfl
  rw [h0, map_zero]
  simp

/-- The `i`-th integral component of the value of `Φ` on `D`. -/
def psi (Φ : Hc N n R) (i : Fin m) (D : Cusp × Cusp) : Binary ℤ :=
  ∑ d ∈ (Φ.val D).support, MvPolynomial.monomial d (qc A b i (MvPolynomial.coeff d (Φ.val D)))

theorem coeff_psi (Φ : Hc N n R) (i : Fin m) (D : Cusp × Cusp) (e : Fin 2 →₀ ℕ) :
    MvPolynomial.coeff e (psi A b Φ i D) = qc A b i (MvPolynomial.coeff e (Φ.val D)) := by
  rw [psi, MvPolynomial.coeff_sum]
  by_cases he : e ∈ (Φ.val D).support
  · rw [Finset.sum_eq_single e]
    · rw [MvPolynomial.coeff_monomial, if_pos rfl]
    · intro c _ hc
      rw [MvPolynomial.coeff_monomial, if_neg hc]
    · intro h; exact absurd he h
  · rw [Finset.sum_eq_zero, MvPolynomial.notMem_support_iff.mp he, qc_zero]
    intro c hc
    rw [MvPolynomial.coeff_monomial, if_neg]
    rintro rfl
    exact he hc

theorem indep (z : Fin m → ℤ) (h : ∑ i, (z i : R) * ((b i : A) : R) = 0) : ∀ i, z i = 0 := by
  refine Fintype.linearIndependent_iff.mp b.linearIndependent z ?_
  apply Subtype.val_injective
  rw [AddSubmonoidClass.coe_finsetSum]
  simp only [SetLike.val_smul, ZeroMemClass.coe_zero, zsmul_eq_mul]
  simpa using h

theorem uniq (P Q : Fin m → Binary ℤ)
    (h : ∑ i, ((b i : A) : R) • MvPolynomial.map (Int.castRingHom R) (P i)
       = ∑ i, ((b i : A) : R) • MvPolynomial.map (Int.castRingHom R) (Q i)) : P = Q := by
  funext i
  refine MvPolynomial.ext _ _ fun d => ?_
  have hd := congrArg (MvPolynomial.coeff d) h
  rw [MvPolynomial.coeff_sum, MvPolynomial.coeff_sum] at hd
  simp only [MvPolynomial.coeff_smul, MvPolynomial.coeff_map, smul_eq_mul,
    eq_intCast] at hd
  have hz : ∑ j, ((MvPolynomial.coeff d (P j) - MvPolynomial.coeff d (Q j) : ℤ) : R)
      * ((b j : A) : R) = 0 := by
    have : ∀ j : Fin m, ((MvPolynomial.coeff d (P j) - MvPolynomial.coeff d (Q j) : ℤ) : R)
        * ((b j : A) : R)
        = ((b j : A) : R) * ((MvPolynomial.coeff d (P j) : ℤ) : R)
          - ((b j : A) : R) * ((MvPolynomial.coeff d (Q j) : ℤ) : R) := by
      intro j; push_cast; ring
    rw [Finset.sum_congr rfl fun j _ => this j, Finset.sum_sub_distrib, hd, sub_self]
  have := indep A b _ hz i
  omega

theorem hrep (Φ : Hc N n R) (hA : ∀ D, Φ.val D ∈ CIn A) (D : Cusp × Cusp) :
    Φ.val D = ∑ i, ((b i : A) : R) • MvPolynomial.map (Int.castRingHom R) (psi A b Φ i D) := by
  refine MvPolynomial.ext _ _ fun d => ?_
  rw [MvPolynomial.coeff_sum]
  have hc : MvPolynomial.coeff d (Φ.val D) ∈ A := hA D d
  have hb := congrArg (fun x : A => (x : R))
    (b.sum_repr ⟨MvPolynomial.coeff d (Φ.val D), hc⟩)
  simp only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul, zsmul_eq_mul] at hb
  rw [← hb]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [MvPolynomial.coeff_smul, MvPolynomial.coeff_map, coeff_psi, qc_mem A b i hc]
  simp only [eq_intCast, smul_eq_mul]
  ring

theorem psi_hom (Φ : Hc N n R) (i : Fin m) (D : Cusp × Cusp) :
    psi A b Φ i D ∈ MTT.Cohomology.Sym ℤ n := by
  rw [MvPolynomial.mem_homogeneousSubmodule]
  intro d hd
  by_contra hdeg
  apply hd
  rw [coeff_psi]
  obtain ⟨x, y⟩ := D
  have hΦ := (MvPolynomial.mem_homogeneousSubmodule _ _).mp (Φ.2.1 x y)
  have hdeg' : d.degree ≠ n := by
    rw [Finsupp.degree_eq_weight_one]
    exact hdeg
  rw [hΦ.coeff_eq_zero hdeg', qc_zero]

theorem psi_cocycle (Φ : Hc N n R) (hA : ∀ D, Φ.val D ∈ CIn A) (x y z : Cusp) (i : Fin m) :
    psi A b Φ i (x, y) + psi A b Φ i (y, z) = psi A b Φ i (x, z) := by
  have hu := uniq A b (fun i => psi A b Φ i (x, y) + psi A b Φ i (y, z))
    (fun i => psi A b Φ i (x, z)) ?_
  · exact congrFun hu i
  · simp only [map_add, smul_add, Finset.sum_add_distrib]
    rw [← hrep A b Φ hA, ← hrep A b Φ hA, ← hrep A b Φ hA]
    exact Φ.2.2.1 x y z

theorem psi_equiv (Φ : Hc N n R) (hA : ∀ D, Φ.val D ∈ CIn A)
    (γ : CongruenceSubgroup.Gamma1 N) (x y : Cusp) (i : Fin m) :
    psi A b Φ i (cuspAct γ.val x, cuspAct γ.val y) = act γ.val.val (psi A b Φ i (x, y)) := by
  have hR : ∑ i, ((b i : A) : R) • MvPolynomial.map (Int.castRingHom R)
      (act γ.val.val (psi A b Φ i (x, y)))
      = act γ.val.val (Φ.val (x, y)) := by
    rw [hrep A b Φ hA (x, y), map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [act_map, map_smul]
  have hu := uniq A b (fun i => psi A b Φ i (cuspAct γ.val x, cuspAct γ.val y))
    (fun i => act γ.val.val (psi A b Φ i (x, y))) ?_
  · exact congrFun hu i
  · rw [← hrep A b Φ hA, hR]
    exact Φ.2.2.2 γ x y

include b in
theorem key (Φ : Hc N n R) (hA : ∀ D, Φ.val D ∈ CIn A) :
    ∃ (c : Fin m → R) (ψ : Fin m → Hc N n ℤ),
      ∀ D : Cusp × Cusp, Φ.val D
        = ∑ i, c i • MvPolynomial.map (Int.castRingHom R) ((ψ i).val D) :=
  ⟨fun i => ((b i : A) : R),
    fun i => ⟨fun D => psi A b Φ i D,
      fun x y => psi_hom A b Φ i (x, y),
      fun x y z => psi_cocycle A b Φ hA x y z i,
      fun γ x y => psi_equiv A b Φ hA γ x y i⟩,
    hrep A b Φ hA⟩

end Descent

end P2MICS

open P2MICS in
theorem solution {N n : ℕ} (hN : 0 < N) (R : Type*) [CommRing R] [Module.Flat ℤ R]
    (Φ : Hc N n R) :
    ∃ (m : ℕ) (c : Fin m → R) (φ : Fin m → Hc N n ℤ),
      ∀ D : Cusp × Cusp,
        Φ.val D = ∑ i, c i • MvPolynomial.map (Int.castRingHom R) ((φ i).val D) := by
  have : NeZero N := ⟨hN.ne'⟩
  have hfin : (Set.range (coordFn Φ)).Finite := Set.finite_range _
  have hFin : Module.Finite ℤ (Acoef Φ) := Module.Finite.iff_fg.mpr (Submodule.fg_span hfin)
  have h1 : Module.IsTorsionFree ℤ R :=
    (Submodule.isTorsionFree_iff_torsion_eq_bot).mpr Module.Flat.torsion_eq_bot
  have h2 : Module.IsTorsionFree ℤ (Acoef Φ) :=
    Function.Injective.moduleIsTorsionFree (Acoef Φ).subtype Subtype.val_injective
      (fun _ _ => rfl)
  obtain ⟨m, b⟩ := Module.basisOfFiniteTypeTorsionFree' (R := ℤ) (M := (Acoef Φ))
  obtain ⟨c, ψ, h⟩ := key (Acoef Φ) b Φ (coeff_mem Φ)
  exact ⟨m, c, ψ, h⟩
