namespace EulerHasProd
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open Filter

variable {ι : Type*}

private theorem norm_inv_sub_one {a : ℂ} (ha : a ≠ 0) : ‖a⁻¹ - 1‖ = ‖a - 1‖ / ‖a‖ := by
  have h : a⁻¹ - 1 = (1 - a) / a := by field_simp
  rw [h, norm_div, norm_sub_rev]

private theorem multipliable_inv_of_summable_norm_sub_one (a : ι → ℂ) (ha : Summable fun i => ‖a i - 1‖) :
    Multipliable fun i => (a i)⁻¹ := by
  by_cases hne : ∃ i, a i = 0
  · obtain ⟨i, hi⟩ := hne
    exact multipliable_of_exists_eq_zero ⟨i, by simp [hi]⟩
  have h0 : ∀ i, a i ≠ 0 := fun i hi => hne ⟨i, hi⟩
  have hev : ∀ᶠ i in cofinite, ‖a i - 1‖ ≤ 1 / 2 :=
    ha.tendsto_cofinite_zero.eventually_le_const one_half_pos
  have hsum : Summable fun i => (a i)⁻¹ - 1 := by
    refine Summable.of_norm_bounded_eventually (ha.mul_left 2) ?_
    filter_upwards [hev] with i hi
    have hai : 1 / 2 ≤ ‖a i‖ := by
      have h1 := norm_sub_norm_le (1 : ℂ) (a i)
      rw [norm_sub_rev, norm_one] at h1
      linarith
    rw [norm_inv_sub_one (h0 i), div_le_iff₀ (by linarith)]
    nlinarith [norm_nonneg (a i - 1)]
  have h1 : (fun i => (a i)⁻¹) = fun i => 1 + ((a i)⁻¹ - 1) := by
    funext i
    ring
  rw [h1]
  exact Complex.multipliable_one_add_of_summable hsum

private theorem hasProd_inv_eval_euler_lFun (D : LDatum ι) (hD : D.Converges) {s : ℂ} (hs : D.abscissa < s.re) :
    HasProd (fun i => ((D.euler i).eval ((D.norm i : ℂ) ^ (-s)))⁻¹) (D.LFun s) :=
  (multipliable_inv_of_summable_norm_sub_one _ (hD s hs).1).hasProd

private theorem hasProd_inv_eval_dual_lFunDual (D : LDatum ι) (hD : D.Converges) {s : ℂ}
    (hs : D.abscissa < s.re) :
    HasProd (fun i => ((D.dual i).eval ((D.norm i : ℂ) ^ (-s)))⁻¹) (D.LFunDual s) :=
  (multipliable_inv_of_summable_norm_sub_one _ (hD s hs).2.1).hasProd

end LanglandsTunnell.CubicInduction.EulerHasProd
