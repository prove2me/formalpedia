open AModel
open Matrix
variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)
variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}
variable [NeZero Q]
theorem solution {E₁ E₂ : Matrix (Fin n) (Fin n) (ZMod Q)}
    (hE₁ : ∀ i j, i < j → E₁ i j = 0) (hE₂ : ∀ i j, i < j → E₂ i j = 0)
    (σ : Equiv.Perm (Fin n)) :
    ∃ ts : List (Fin n × Fin n), ts.length ≤ n ∧
      ∀ a, AModel.Valid sh a →
        AModel.amap Λ (E₁ * σ.permMatrix (ZMod Q) * E₂) a = AModel.run Λ (AModel.bruhatSteps E₁ ts E₂) a := by
  obtain ⟨ts, hl, -, hp⟩ := AModel.exists_swap_list σ
  refine ⟨ts, le_trans hl ?_, AModel.linear_via_bruhat Λ hE₁ hE₂ σ ts hp⟩
  simpa using Finset.card_le_univ σ.support
end
