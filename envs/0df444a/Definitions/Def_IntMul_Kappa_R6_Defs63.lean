/-!
# Round-six setup, part 1: the sources by search, and the counted parameters

The setup machine picks the source `s_j` of axis `j` by scanning the candidates
`c = A_j + x` (`A_j = t_j - 2 w_j`, `x = w_j, w_j - 1, …, 1`) and keeping the last one coprime to
`2 ∏_{i<j} s_i` (`pick`, `src6`). The sieve (`J6SieveStep.step`) shows that a coprime candidate
exists once `w_j > sieveBound d r` (**`exists_cop`**), which holds for large `n`
(**`ell_big`**: `ℓ ≥ C (log₂ b + 1)^2` eventually). Then `src6` satisfies `SrcOK6`
(**`src6_ok`**).

The parameters `d, L, α` are computed by the machine as counts (`d_count6`, `L_count6`,
`α_count6`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KFM Finset

noncomputable section

/-! ## Selection -/

/-- The selection loop after `k` candidates `A + N, A + N - 1, …, A + N - k + 1`: the last
candidate coprime to `Q` (initially `0`). -/
def pickA (A Q N : ℕ) : ℕ → ℕ
  | 0 => 0
  | k + 1 => if Nat.Coprime Q (A + (N - k)) then A + (N - k) else pickA A Q N k

/-- The selected candidate. -/
def pick (A Q N : ℕ) : ℕ := pickA A Q N N

/-! ## The sources -/

/-- The left end of the window of axis `j`: `A_j = t_j - 2 w_j`. -/
def wA6 (P : Prm) (n j : ℕ) : ℕ := tF6 P n j - 2 * wnd6 P n j

/-- The products `∏_{i<j} s_i` of the selected sources. -/
def PP6 (P : Prm) (n : ℕ) : ℕ → ℕ
  | 0 => 1
  | j + 1 => PP6 P n j * pick (wA6 P n j) (2 * PP6 P n j) (wnd6 P n j)

/-- The source of axis `j`. -/
def src6 (P : Prm) (n j : ℕ) : ℕ := pick (wA6 P n j) (2 * PP6 P n j) (wnd6 P n j)

/-! ## Existence of a coprime candidate (the sieve) -/

/-! ## `SrcOK6` for the selected sources -/

/-- The window condition of the sieve. -/
def WinOK6 (P : Prm) (n : ℕ) : Prop :=
  ∀ j < dP6 P n, J6Sieve.sieveBound (dP6 P n) (2 ^ ℓP6 P n) < wnd6 P n j

/-! ## Eventual growth of `ℓ` -/

/-! ## The counted parameters -/

end

end IntMul.Kappa.R6

end


