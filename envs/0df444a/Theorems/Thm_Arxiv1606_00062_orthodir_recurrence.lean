-- title:
--   Theorem 6: recurrence for the ORTHODIR directions with $\mathcal A=\mathcal I-\mathcal T$
-- statement:
--   Let $V$ be a complex Hilbert space, $\mathcal T:V\to V$ a bounded linear operator, $g\in V$, and let $p^{(j)}$ and $\beta_{ij}$ be the directions and coefficients generated by the ORTHODIR iteration for $\mathcal A=\mathcal I-\mathcal T$ with $r^{(0)}=p^{(0)}=g$. Then for every $j=0,1,\dots$,
--
--   $$p^{(j)}=(\mathcal I-\mathcal T)^j p^{(0)}+\sum_{\ell=0}^{j-1}\sum_{i=0}^{\ell}\beta_{i\ell}\,(\mathcal I-\mathcal T)^{j-1-\ell}p^{(i)}.$$
--
--   **Formalization Note** $\mathcal T$ is an arbitrary bounded operator, of which the paper's operator (7) is an instance. The inner product $\langle x,y\rangle$ of the paper (linear in $x$) is Mathlib's `inner ℂ y x`. When $\mathcal Ap^{(i)}=0$ the formal coefficient is $0$; the identity holds for any values of the coefficients.
-- source:
--   Boubendir, Ecevit and Reitich, Acceleration of an iterative method for the evaluation of high-frequency multiple scattering effects, arXiv:1606.00062v1 (2016), claim c006; Section 5, Theorem 6, eq. (33), PDF p. 12

import Mathlib
import Definitions.Def_Arxiv1606_00062_Basic

open Filter Topology

namespace Arxiv1606_00062

theorem orthodir_recurrence {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℂ V]
    [CompleteSpace V] (T : V →L[ℂ] V) (g : V) (j : ℕ) :
    orthodirDir (1 - T) g j =
      ((1 - T) ^ j) (orthodirDir (1 - T) g 0) +
        ∑ l ∈ Finset.range j, ∑ i ∈ Finset.range (l + 1),
          orthodirBeta (1 - T) g i l • ((1 - T) ^ (j - 1 - l)) (orthodirDir (1 - T) g i) := by sorry

end Arxiv1606_00062
