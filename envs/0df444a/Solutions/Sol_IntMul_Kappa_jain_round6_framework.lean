-- Source module: Solutions.J6SegAKCost4
/-!
# `A`-axis costs 4: the numeric side conditions `AKCond` of the `A` kernel v2

For `p ≥ 64` (eventually true) and an `A` axis with the facts `AxANum`, **`akCond_at`** gives
`AKCond` at

* `B = 20p + 60`, `BH = Bk = b + 2`, `Lmax = 17 + 2W + (2W + 2H) + 2H` (the row length),
* `φ₁ = mulSup (2B)`, `φ₂ = mulSup (2 (b · 2n + 2))` with `n = 2W + 2H`,
* `Ka = Kr = Kc = (8p + 35) 2^{2p}` (`J6AILTab12`), `X₀ = 2^{p+2}`.

The exponential facts come from `2^16 p^4 ≤ 2^p` (`pow4_big`, `p ≥ 64`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.AC
open IntMul NLogN IntMul.Kappa.R6 J6Seg J6Seg.KR J6Seg.KR.AK J6Seg.Ax

theorem tabsT_len (f : ℕ → List ℤ) (L : ℕ) (hf : ∀ q, (f q).length = L) :
    ∀ N, (tabsT f N).length = N * (L + 1)
  | 0 => by simp [tabsT]
  | N + 1 => by
    have ih := tabsT_len f L hf N
    simp only [tabsT, List.range_succ, List.flatMap_append, List.length_append] at ih ⊢
    rw [ih]; simp [segT, hf]; ring

/-! ## The big-number inequalities -/

/-! ## The side conditions -/

theorem aTabG_length (p s t α H pk b q : ℕ) :
    (aTabG p s t α H pk b q).length =
      17 + 2 * J6A.WA p α H + (2 * J6A.WA p α H + 2 * H) + 2 * H := by
  simp only [aTabG, aKTab2, aHdr2, List.length_append, List.length_cons, List.length_nil,
    J6A.aTabA, J6A.rTabA, J6A.cTabA, List.length_map, List.length_range]
