section
-- Source module: Solutions.KFMPhase
/-!
# KFM 2: Proposition 14 with the phase diagonals `S_D` in one pass each

`KFN.p14WithI` implements `S_D = diag i^{x_1+⋯+x_D}` as `D` kernel passes (`kersP … MS`), so one
simultaneous butterfly round costs `Θ(D · N · w)` even before the `C`-layer.  Lemma 16 runs `≈ ℓ`
such rounds with `D ≈ d`, giving `ℓ d V ≈ V log T`: a full logarithmic factor, which `Ncost`
(`ℓ d^{λ'}` for this row) cannot absorb (MACHINE-PLAN.md, item 4, issue (A)).

Here `S_D` is the KFN phase pass `phL` (`KFN.sImpl_phase`): one pass with an exponent table built
by doubling, `O(N (w+1))` plus `O((K D + P) Z)` descriptor work, independent of `D`.

* `posL K D ρ i = ρ + K (D-1-i)`: the bit position of the selected bit of chunk `i`;
  `stT_posL`: the record stride is `2^{posL i} · S`.
* **`sImpl_SD`**: `sdP` (one `phL` pass) implements `SD` on the layer layout, scale and width
  unchanged, at cost `cSD … w = cPhL w N (K D) P Z`.
* `p14Ph`: the wrapper `S_D ; C ; S_D ; b^D ; Q_p` with one-pass phases.
* **`p14Ph_iruns`**: same conclusions as `KFN.p14WithI_iruns` (output `prop14Proc … (tens Cm)`,
  `GB (p+1)`, error `< √2·2^{-p}` against `layerH`), at cost `kC w + cWrapPh …`.
* **`cWrapPh_le`**: `cWrapPh ≤ 10^6 (w + dC + E + D + 10) N + 10^6 (K D + P + 10)(Z + 2)`:
  the data term carries **no factor `D`** (only the additive width `E + D`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFM

open IntMul RS AModel KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

/-! ## 1. `S_D` as one phase pass -/

/-- Position (in the binary record index below `P`) of the selected bit of chunk `i`. -/
def posL (K D ρ : ℕ) (i : Fin D) : ℕ := ρ + K * (D - 1 - i)

/-- The `S_D` pass: `phL` with unit exponent on every selected bit. -/
def sdP (P K D S ρ r : ℕ) : RS := phL (S * r) (K * D) P 0 (aEof (posL K D ρ) (fun _ => 1))

/-- Cost of one `S_D` pass on `N = vol · r` Gaussian entries of width `w`. -/
def cSD (P K D S r Z w : ℕ) : ℕ := cPhL w (P * (S * r * 2 ^ (K * D))) (K * D) P Z

/-! ## 2. The wrapper -/

/-- Proposition 14 with one-pass phases: `S_D ; C ; S_D ; b^D ; Q_p`. -/
def p14Ph {Pp : ℕ} (P K D S ρ r E dC : ℕ) (Cc : ℕ → IStmt HS Pp) : ℕ → IStmt HS Pp := fun w =>
  .seq (seqI (seqI (seqI (fun _ => fcode (sdP P K D S ρ r)) Cc 0)
      (fun _ => fcode (sdP P K D S ρ r)) (0 + dC))
    (fun _ => fcode (kerP K D S ρ P r 0 (MD D))) (0 + dC + 0) w)
  (fcode (truncP (E + (D / 2 + D % 2)) (2 * (vol (Butterfly.layerShape P K D S) * r))))

/-- Wrapper cost (everything except the `C`-layer). -/
def cWrapPh (P K D S r E Z w dC : ℕ) : ℕ :=
  cSD P K D S r Z w + cSD P K D S r Z (w + dC) +
    ck (vol (Butterfly.layerShape P K D S) * r) Z (w + dC) +
    cTrunc (w + dC + 2) (E + (D / 2 + D % 2)) (2 * (vol (Butterfly.layerShape P K D S) * r)) Z

section Wrap

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp} {P K D S ρ : ℕ}

end Wrap

/-! ## 3. The wrapper cost has no factor `D` on the data -/

end NLogN.KFM

