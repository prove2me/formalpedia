variable {K : Type} [Field K] [NumberField K] [StarRing K]

theorem Formalism.DivisionValues.StepBAux.fmat_change {d m : ℕ} (σ : K →+* ℂ) (e : Fin m → Fin d → K)
    (γ : Matrix (Fin m) (Fin m) K) :
    fmat σ (fun i => ∑ k, γ k i • e k) = fmat σ e * γ.map σ := by sorry
