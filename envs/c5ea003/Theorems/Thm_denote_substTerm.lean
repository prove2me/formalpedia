theorem denote_substTerm{Γ Δ : Ctx} {τ : HOType}
    (s : Subst Γ Δ) (t : HOTerm Γ τ)
    (envΔ : Env Δ) (envΓ : Env Γ)
    (henv : ∀ {α : HOType} (x : Var Γ α),
      denote (s x) envΔ = lookupVar x envΓ) :
    denote (substTerm s t) envΔ = denote t envΓ := by sorry
