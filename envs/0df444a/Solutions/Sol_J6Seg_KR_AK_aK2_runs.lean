/-!
# A lines, IL side 3: the kernel frame and the header moves

The `A` kernel (`J6AIL4`) reads its parameters from the table stack `dT`: a header of register
values on top of the tables. Here:

* `AF G r0 w1 w2 o dt du`: the six stacks the kernel body changes (`0, W1, W2, OUT, dT, DU`)
  over a base `G` (the registers live in `G`);
* `tkL Rs`: the header values `vs` on top of `dT` into the registers `Rs` (`tkL_sp`:
  `G ↦ pushAll G Rs vs`);
* `rtLR Rs`: back from the registers onto `dT`, the registers emptied (`rtLR_sp`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR.AK

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

section AFl
variable {G : Fin HS → List ℤ} {r0 w1 w2 o dt du : List ℤ}

theorem AF_ne {j : Fin HS} (hj : ∀ k ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS)), j ≠ k) : AF G r0 w1 w2 o dt du j = G j := by
  unfold AF; rw [Function.update_of_ne (hj DU (by decide)), Function.update_of_ne (hj dT (by decide)), Function.update_of_ne (hj OUT (by decide)), Function.update_of_ne (hj W2 (by decide)), Function.update_of_ne (hj W1 (by decide)), Function.update_of_ne (hj (0 : Fin HS) (by decide))]
theorem AFu_r0 (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) (0 : Fin HS) vv = AF G vv w1 w2 o dt du := by
  unfold AF; rw [Function.update_comm (show DU ≠ (0 : Fin HS) by decide), Function.update_comm (show dT ≠ (0 : Fin HS) by decide), Function.update_comm (show OUT ≠ (0 : Fin HS) by decide), Function.update_comm (show W2 ≠ (0 : Fin HS) by decide), Function.update_comm (show W1 ≠ (0 : Fin HS) by decide), Function.update_idem]
theorem AFu_w1 (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) W1 vv = AF G r0 vv w2 o dt du := by
  unfold AF; rw [Function.update_comm (show DU ≠ W1 by decide), Function.update_comm (show dT ≠ W1 by decide), Function.update_comm (show OUT ≠ W1 by decide), Function.update_comm (show W2 ≠ W1 by decide), Function.update_idem]
theorem AFu_w2 (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) W2 vv = AF G r0 w1 vv o dt du := by
  unfold AF; rw [Function.update_comm (show DU ≠ W2 by decide), Function.update_comm (show dT ≠ W2 by decide), Function.update_comm (show OUT ≠ W2 by decide), Function.update_idem]
theorem AFu_o (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) OUT vv = AF G r0 w1 w2 vv dt du := by
  unfold AF; rw [Function.update_comm (show DU ≠ OUT by decide), Function.update_comm (show dT ≠ OUT by decide), Function.update_idem]
theorem AFu_dt (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) dT vv = AF G r0 w1 w2 o vv du := by
  unfold AF; rw [Function.update_comm (show DU ≠ dT by decide), Function.update_idem]
theorem AFu_du (vv : List ℤ) : Function.update (AF G r0 w1 w2 o dt du) DU vv = AF G r0 w1 w2 o dt vv := by
  unfold AF; rw [Function.update_idem]
theorem AFu_ne {R : Fin HS} (hR : ∀ k ∈ ([(0 : Fin HS), W1, W2, OUT, dT, DU] : List (Fin HS)), R ≠ k) (vv : List ℤ) :
    Function.update (AF G r0 w1 w2 o dt du) R vv = AF (Function.update G R vv) r0 w1 w2 o dt du := by
  unfold AF; rw [Function.update_comm (hR DU (by decide)).symm, Function.update_comm (hR dT (by decide)).symm, Function.update_comm (hR OUT (by decide)).symm, Function.update_comm (hR W2 (by decide)).symm, Function.update_comm (hR W1 (by decide)).symm, Function.update_comm (hR (0 : Fin HS) (by decide)).symm]

end AFl

theorem Tmp_AF {G : Fin HS → List ℤ} {r0 w1 w2 o dt du : List ℤ} (h : Tmp G) :
    Tmp (AF G r0 w1 w2 o dt du) :=
  ⟨by rw [AF_ne (by decide)]; exact h.a,
   by rw [AF_ne (by decide)]; exact h.b,
   by rw [AF_ne (by decide)]; exact h.c,
   by rw [AF_ne (by decide)]; exact h.e,
   by rw [AF_ne (by decide)]; exact h.pa,
   by rw [AF_ne (by decide)]; exact h.pb,
   by rw [AF_ne (by decide)]; exact h.pc,
   by rw [AF_ne (by decide)]; exact h.pe,
   by rw [AF_ne (by decide)]; exact h.m1,
   by rw [AF_ne (by decide)]; exact h.m2,
   by rw [AF_ne (by decide)]; exact h.m3,
   by rw [AF_ne (by decide)]; exact h.m4,
   by rw [AF_ne (by decide)]; exact h.z,
   by rw [AF_ne (by decide)]; exact h.x,
   by rw [AF_ne (by decide)]; exact h.rh,
   by rw [AF_ne (by decide)]; exact h.t,
   by rw [AF_ne (by decide)]; exact h.t2,
   by rw [AF_ne (by decide)]; exact h.t4,
   by rw [AF_ne (by decide)]; exact h.or,
   by rw [AF_ne (by decide)]; exact h.oi,
   by rw [AF_ne (by decide)]; exact h.l⟩

