theorem solution {k m : ℕ} {x t : ℝ} (hx : x ∈ UG) (ht : t ∈ Icc (0:ℝ) 1) :
    ‖t ^ k * (1 - t * x)⁻¹ ^ (m + 1)‖ ≤ (12 / 7 : ℝ) ^ (m + 1) := by
  obtain ⟨ht0, ht1⟩ := ht
  obtain ⟨hpos, hinv, hinv0, -⟩ := inv_bound hx ⟨ht0, ht1⟩
  have htk : ‖t ^ k‖ ≤ 1 := by
    rw [Real.norm_eq_abs, abs_pow, abs_of_nonneg ht0]
    exact pow_le_one₀ ht0 ht1
  have hp : ‖(1 - t * x)⁻¹ ^ (m + 1)‖ ≤ (12 / 7 : ℝ) ^ (m + 1) := by
    rw [Real.norm_eq_abs, abs_pow, abs_of_nonneg hinv0]
    exact pow_le_pow_left₀ hinv0 hinv (m + 1)
  calc ‖t ^ k * (1 - t * x)⁻¹ ^ (m + 1)‖
      = ‖t ^ k‖ * ‖(1 - t * x)⁻¹ ^ (m + 1)‖ := norm_mul _ _
    _ ≤ 1 * (12 / 7 : ℝ) ^ (m + 1) := mul_le_mul htk hp (norm_nonneg _) (by norm_num)
    _ = (12 / 7 : ℝ) ^ (m + 1) := by ring
