theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨171743716258,171963618585⟩ ⟨755355112912,755388581767⟩ ⟨81572767664,90280899757⟩ := rfl
noncomputable def centerUpper : ℝ := (44360541725 / 137438953472)
