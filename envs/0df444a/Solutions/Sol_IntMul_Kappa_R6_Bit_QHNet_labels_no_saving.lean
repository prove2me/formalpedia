/-! ## Execution of a network on streams (generic in the edge implementation) -/

/-! ## The network data: edges, histogram, hypotheses -/

namespace QHNet

variable {R : Type*} [CommRing R] {W T m : ℕ}

lemma sum_hist (C : QHNet R W T m) (g : ℕ → ℝ) :
    (C.hist.map fun p => (p.2 : ℝ) * g p.1).sum = (C.widths.map g).sum := by
  simp [hist, Function.comp_def]

lemma mem_widths {C : QHNet R W T m} {w : ℕ} (hw : w ∈ C.widths) :
    ∃ e ∈ C.edges, ∃ ρ ∈ e.runs, ρ.2.2 = w := by
  simp only [widths, List.mem_flatMap, List.mem_map] at hw
  obtain ⟨e, he, ρ, hρ, rfl⟩ := hw
  exact ⟨e, he, ρ, hρ, rfl⟩

end QHNet

end IntMul.Kappa.R6.Bit

