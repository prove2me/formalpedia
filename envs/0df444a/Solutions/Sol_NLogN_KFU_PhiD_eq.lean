open NLogN
open NLogN.KFU
open IntMul KFC AModel AModelL12
variable {d : ℕ} {sF μ : ℕ → ℕ}
open Classical
theorem solution (H : NLogN.KFU.CrtOK d sF μ) (h : ℕ) (bL : ℕ → Bool) (hst : ∀ j < d, sF j ≤ 2 ^ h)
    (xs : List ℤ) :
    NLogN.KFU.PhiD h d bL sF μ xs = (List.range (AModel.vol (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)))).map fun j =>
      if AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) (AModel.decode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) j) then
        xs.getD (2 * NLogN.KFU.kOf d sF μ (AModel.decode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) j) +
          (AModel.decode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) j).getD d 0) 0
      else 0 := by
  apply List.ext_getElem (by simp [NLogN.KFU.PhiD])
  intro j h1 h2
  simp only [NLogN.KFU.PhiD, AModelL12.length_embed] at h1
  set b := AModel.decode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) j
  have hvT : AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b := AModel.valid_decode h1
  have e : (NLogN.KFU.PhiD h d bL sF μ xs)[j]'(by simpa [NLogN.KFU.PhiD] using h1) =
      (NLogN.KFU.PhiD h d bL sF μ xs).getD (AModel.encode (NLogN.KFU.shR d (NLogN.KFU.tP d h bL)) b) 0 := by
    rw [AModel.encode_decode h1, List.getD_eq_getElem]
  rw [e, List.getElem_map, List.getElem_range]
  by_cases hv : AModel.Valid (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) b
  · rw [if_pos hv]
    obtain ⟨hk, hb⟩ := NLogN.KFU.cover H hv
    conv_lhs => rw [← hb]
    exact NLogN.KFU.PhiD_at h d bL sF μ H.pos hst H.inv xs _ _ hk (NLogN.KFU.cover_c d sF hv)
  · rw [if_neg hv]
    exact NLogN.KFU.PhiD_zero h d bL sF μ xs b hvT hv
end
