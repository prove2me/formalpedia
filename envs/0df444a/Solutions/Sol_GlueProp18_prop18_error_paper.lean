namespace Synth

/-- **Error accumulation.** If every round is an exact map `E k` that is `1`-Lipschitz on a set
`S` of good arrays (disk arrays), the computed round `A k` maps `S` to `S` and differs from the
exact round on `S` by less than `η`, then after `n ≥ 1` rounds the error is less than `n η`. -/
theorem error_chain {X : Type*} [PseudoMetricSpace X] (S : Set X) (E A : ℕ → X → X) (η : ℝ)
    (hE : ∀ k, ∀ u ∈ S, ∀ v ∈ S, dist (E k u) (E k v) ≤ dist u v)
    (hES : ∀ k, ∀ u ∈ S, E k u ∈ S) (hAS : ∀ k, ∀ u ∈ S, A k u ∈ S)
    (hAE : ∀ k, ∀ u ∈ S, dist (A k u) (E k u) < η) :
    ∀ n, ∀ x ∈ S, 1 ≤ n →
      dist ((List.range n).foldl (fun u k => A k u) x) ((List.range n).foldl (fun u k => E k u) x)
        < n * η := by
  have hS : ∀ n, ∀ x ∈ S, (List.range n).foldl (fun u k => A k u) x ∈ S ∧
      (List.range n).foldl (fun u k => E k u) x ∈ S := by
    intro n x hx
    induction n with
    | zero => exact ⟨hx, hx⟩
    | succ n ih =>
      rw [List.range_succ, List.foldl_append, List.foldl_append]
      exact ⟨hAS n _ ih.1, hES n _ ih.2⟩
  intro n x hx hn
  induction n with
  | zero => omega
  | succ n ih =>
    rw [List.range_succ, List.foldl_append, List.foldl_append]
    simp only [List.foldl_cons, List.foldl_nil]
    obtain ⟨hu, hv⟩ := hS n x hx
    set u := (List.range n).foldl (fun u k => A k u) x
    set v := (List.range n).foldl (fun u k => E k u) x
    have h1 := hAE n u hu
    have h2 := hE n u hu v hv
    have h4 := dist_triangle (A n u) (E n u) (E n v)
    rcases Nat.eq_zero_or_pos n with h0 | h0
    · have huv : dist u v = 0 := by
        have : u = v := by simp [u, v, h0]
        rw [this, dist_self]
      have : ((n + 1 : ℕ) : ℝ) = 1 := by rw [h0]; norm_num
      rw [this]; linarith
    · have h3 := ih h0
      push_cast; linarith

end Synth

end

