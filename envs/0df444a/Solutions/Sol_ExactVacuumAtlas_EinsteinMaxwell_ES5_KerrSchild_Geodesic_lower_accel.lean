variable {n : ℕ}
theorem solution {g ginv : Metric n} {K : Pt n → Fin n → ℝ} {x : Pt n}
    (hinv : metricMatrix g x * metricMatrix ginv x = 1)
    (hg : ∀ i j, DifferentiableAt ℝ (g i j) x) (hK : ∀ i, DifferentiableAt ℝ (fun y => K y i) x)
    (b : Fin n) :
    (metricMatrix g x *ᵥ accel g ginv K x) b =
      ∑ j, K x j * pd j (fun y => (metricMatrix g y *ᵥ K y) b) x -
        (∑ j, ∑ l, pd b (g j l) x * K x j * K x l) / 2 := by
  have hpd : ∀ j, pd j (fun y => (metricMatrix g y *ᵥ K y) b) x =
      ∑ i, (pd j (g b i) x * K x i + g b i x * pd j (fun y => K y i) x) := by
    intro j
    simp only [Matrix.mulVec, dotProduct, metricMatrix, Matrix.of_apply]
    have h := pd_sum (F := fun i y => g b i y * K y i) Finset.univ j
      fun i _ => (hg b i).mul (hK i)
    rw [h]
    exact Finset.sum_congr rfl fun i _ => pd_mul j (hg b i) (hK i)
  have hΓ : ∑ i, g b i x * (∑ j, ∑ l, christoffel g ginv i j l x * K x j * K x l) =
      ∑ j, ∑ l, (pd l (g b j) x + pd j (g b l) x - pd b (g j l) x) / 2 * K x j * K x l := by
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [← lower_christoffel hinv b j l, Finset.sum_mul, Finset.sum_mul]
    exact Finset.sum_congr rfl fun i _ => by ring
  have h1 : ∑ i, g b i x * (∑ j, K x j * pd j (fun y => K y i) x) =
      ∑ j, K x j * ∑ i, g b i x * pd j (fun y => K y i) x := by
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => by ring
  have hX : ∑ j, ∑ l, pd l (g b j) x * K x j * K x l =
      ∑ j, ∑ l, pd j (g b l) x * K x j * K x l := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l _ => by ring
  have h2 : ∑ j, ∑ l, (pd l (g b j) x + pd j (g b l) x - pd b (g j l) x) / 2 * K x j * K x l =
      ∑ j, ∑ l, pd j (g b l) x * K x j * K x l -
        (∑ j, ∑ l, pd b (g j l) x * K x j * K x l) / 2 := by
    have : ∀ j l, (pd l (g b j) x + pd j (g b l) x - pd b (g j l) x) / 2 * K x j * K x l =
        (pd l (g b j) x * K x j * K x l + pd j (g b l) x * K x j * K x l -
          pd b (g j l) x * K x j * K x l) / 2 := fun j l => by ring
    simp only [this, ← Finset.sum_div, Finset.sum_add_distrib, Finset.sum_sub_distrib, hX]
    ring
  have h4 : ∑ j, K x j * ∑ l, pd j (g b l) x * K x l =
      ∑ j, ∑ l, pd j (g b l) x * K x j * K x l := by
    simp only [Finset.mul_sum]
    exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun l _ => by ring
  simp only [Matrix.mulVec, dotProduct, metricMatrix, Matrix.of_apply] at hpd ⊢
  simp only [accel, mul_add, Finset.sum_add_distrib, hΓ, h1, h2, hpd]
  linarith [h4]
