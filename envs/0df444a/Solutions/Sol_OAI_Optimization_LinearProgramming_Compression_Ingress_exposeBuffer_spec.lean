  have ea : Block.Eval (Good P) (.op (.addrCopy 40 3)) s 1 a := Block.Eval.op_addrCopy _ _ _ hs hs
  obtain ⟨b,eb,bd,b40,bf⟩ := walk_spec P a false 40 64 ea.safe_end
