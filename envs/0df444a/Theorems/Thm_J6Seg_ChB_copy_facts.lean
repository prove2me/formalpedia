open J6Seg J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR
variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : Side.AxJ P n src D k)
include h

theorem J6Seg.ChB.copy_facts (hD : dP6 P n = D + 1) (hk : k ≤ D) :
    let post := axpost6 P n D k; let pre := axpre6 P n D k
    let Bs := axBcp6 P ap n src D k
    2 ≤ Bs ∧ zsz (k : ℤ) ≤ Bs ∧ zsz ((axs6 src k : ℕ) : ℤ) ≤ Bs ∧
    zsz ((axt6 P n k : ℕ) : ℤ) ≤ Bs ∧
    zsz ((axt6 P n k : ℤ) * post) ≤ Bs ∧ zsz ((pre : ℤ) * ((axt6 P n k : ℤ) * post)) ≤ Bs ∧
    zsz (2 * ((pre : ℤ) * ((axt6 P n k : ℤ) * post))) ≤ Bs := by sorry
