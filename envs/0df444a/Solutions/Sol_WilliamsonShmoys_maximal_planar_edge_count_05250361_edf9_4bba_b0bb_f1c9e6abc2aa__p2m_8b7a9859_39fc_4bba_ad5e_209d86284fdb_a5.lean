    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (SimpleGraph.edgeSet_mono (le_of_eq h)))
    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (SimpleGraph.edgeSet_mono (le_of_eq h.symm)))
    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (fun e => Sym2.ind (fun u v hu => by simpa using h u v (by simpa using hu)) e))
    | (have h := hmax Tz (Set.Subset.trans (fun e he => he) (SimpleGraph.edgeSet_mono hlez)) hTz; exact (fun e => Sym2.ind (fun u v hu => by simpa using h (by simpa using hu)) e))
  have hcardz : Tz.edgeSet.ncard ≤ Q.edgeSet.ncard := Set.ncard_le_ncard hsub (Set.toFinite _)
