theorem ModularCurve.moduliPoint_eq_of_isModuliPlaceOf_of_isModuliPlaceOf
    {κ : Type} [Field κ] [IsAlgClosed κ] [DecidableEq κ] (N : ℕ) [NeZero N] (hN : ((N : ℕ) : κ) ≠ 0)
    (x x' : ModuliPoint N κ) (v : Place κ ↥(modularFunctionFieldFullC κ N))
    (hv : IsModuliPlaceOf κ N x v) (hv' : IsModuliPlaceOf κ N x' v) : x = x' := by sorry
