  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil]
    rw [← h0]; simp [ints]
  have e1 : T L.length = ((s.upd X RX).upd Y (ints L.reverse ++ s.G Y)).upd Z
