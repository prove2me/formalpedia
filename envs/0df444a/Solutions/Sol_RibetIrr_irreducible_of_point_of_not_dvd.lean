@[reducible] def quotAction (k : ℕ) : DistribMulAction G ((O ⊗[ℤ_[p]] ModularCurve.TateModule p J) ⧸
    (Ideal.span {(p : O) ^ k} • (⊤ : Submodule O (O ⊗[ℤ_[p]] ModularCurve.TateModule p J)))) where
  smul σ q := ρQ p J O ρM k σ q
  one_smul q := by
    induction q using Submodule.Quotient.induction_on with
    | H m =>
      change Submodule.Quotient.mk (ρM 1 m) = Submodule.Quotient.mk m
      rw [map_one]
      rfl
  mul_smul σ τ q := by
    induction q using Submodule.Quotient.induction_on with
    | H m =>
      change Submodule.Quotient.mk (ρM (σ * τ) m) = Submodule.Quotient.mk (ρM σ (ρM τ m))
      rw [map_mul]
      rfl
  smul_zero σ := map_zero (ρQ p J O ρM k σ)
  smul_add σ a b := map_add (ρQ p J O ρM k σ) a b

