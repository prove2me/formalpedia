  let selected := OAI.EditApproximation.filterWithWork (fun r =>
    let word := read r
    let guard := OAI.EditApproximation.BinaryFraction.centerEligibilityWithWork b F a word.1
    (guard.1, guard.2 + word.2)) points.1
