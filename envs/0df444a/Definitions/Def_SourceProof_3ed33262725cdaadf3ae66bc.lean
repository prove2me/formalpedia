    IsContinuousConvolutionSemigroup ν := by
  refine ⟨(_root_.Prove2MeSourceProof.h_d6f4fb383eb3bed5aa4c9b52 hν), ?_⟩
  rw [← (_root_.Prove2MeSourceProof.h_5bc1b74e4d3d1a7b8c19f425 hν)]
  exact (_root_.Prove2MeSourceProof.h_eb237f54b799fd716d63095d hν).continuousAt.mono_left inf_le_left
end HasScaledLaws

