-- title:
--   Infinite regression samples with the exact conditional noise assumptions
-- statement:
--   On a probability space $(\Omega,\mu)$ let $X_i\in\mathbb R^n$ and $\nu_i\in\mathbb R$ be measurable random variables. The design variables are independent and identically distributed, supported on $B$, have finite second moment, and give positive probability to every measurable subset of $B$ with nonempty interior. The regression function $f$ is continuous on $B$ and $Y_i=f(X_i)+\nu_i$.
--
--   Every noise variable has support all of $\mathbb R$, expressed by positive mass on every nonempty open interval. Its conditional mean given $X_i$ vanishes. All noise second moments have one common finite value. For each finite prefix, the conditional probability of every measurable noise rectangle, given the design prefix, equals the product of the individual conditional probabilities given $X_i$.
--
--   These conditional probabilities are conditional expectations of indicator functions with respect to the sigma algebras generated by the observables. All integrability conditions needed to avoid undefined expectations are explicit or follow from bounded indicators and the probability measure. Conditional laws may depend on $i$ and $X_i$; there is no assumption that the pairs $(X_i,Y_i)$ are identically distributed, and boundary atoms are allowed.
-- source:
--   Curmei and Hall, Shape-Constrained Regression using Sum of Squares Polynomials, arXiv:2004.03853v3, p. 13, Assumptions 1–3

import Definitions.Def_ShapeSOS_ConvexConsistency_Estimators

set_option autoImplicit false
open MeasureTheory ProbabilityTheory Filter
open scoped BigOperators MeasureTheory Topology

namespace ShapeSOS.ConvexConsistency
noncomputable section

/-- The sigma algebra generated by an observable. -/
abbrev observableSigma {Ω α : Type*} [MeasurableSpace α] (Z : Ω → α) : MeasurableSpace Ω :=
  MeasurableSpace.comap Z inferInstance

/-- Conditional probabilities on all measurable rectangles encode the displayed joint law. -/
def ConditionalNoiseFactorization {Ω : Type*} [MeasurableSpace Ω] {n : ℕ}
    (μ : Measure Ω) (X : ℕ → Ω → Vec n) (ν : ℕ → Ω → ℝ) : Prop :=
  ∀ (m : ℕ) (A : Fin m → Set ℝ), (∀ i, MeasurableSet (A i)) →
    (μ[fun ω => ∏ i : Fin m, (A i).indicator (fun _ => (1 : ℝ)) (ν i.val ω) |
      observableSigma (fun ω => fun i : Fin m => X i.val ω)]) =ᵐ[μ]
    (fun ω => ∏ i : Fin m,
      (μ[fun ω' => (A i).indicator (fun _ => (1 : ℝ)) (ν i.val ω') |
        observableSigma (X i.val)]) ω)

/-- Precisely Assumptions 1--3 on one infinite data stream. No iid-pairs assumption. -/
def SamplingAssumptions {Ω : Type*} [MeasurableSpace Ω] {n : ℕ}
    (μ : Measure Ω) (B : Box n) (f : Vec n → ℝ)
    (X : ℕ → Ω → Vec n) (ν : ℕ → Ω → ℝ) : Prop :=
  (∀ i, Measurable (X i)) ∧ (∀ i, Measurable (ν i)) ∧
  iIndepFun X μ ∧ (∀ i, IdentDistrib (X i) (X 0) μ μ) ∧
  Integrable (fun ω => norm₂ (X 0 ω) ^ 2) μ ∧
  (∀ i, ∀ᵐ ω ∂μ, X i ω ∈ B.carrier) ∧
  (∀ C : Set (Vec n), MeasurableSet C → C ⊆ B.carrier → (interior C).Nonempty →
    0 < μ ((X 0) ⁻¹' C)) ∧
  ContinuousOn f B.carrier ∧
  (∀ i (a b : ℝ), a < b → 0 < μ {ω | a < ν i ω ∧ ν i ω < b}) ∧
  ConditionalNoiseFactorization μ X ν ∧
  (∀ i, Integrable (ν i) μ ∧ (μ[ν i | observableSigma (X i)]) =ᵐ[μ] 0) ∧
  (∃ sigmaSq : ℝ, ∀ i, Integrable (fun ω => ν i ω ^ 2) μ ∧
    (∫ ω, ν i ω ^ 2 ∂μ) = sigmaSq)

def response {Ω : Type*} {n : ℕ} (f : Vec n → ℝ)
    (X : ℕ → Ω → Vec n) (ν : ℕ → Ω → ℝ) (i : ℕ) (ω : Ω) : ℝ :=
  f (X i ω) + ν i ω

end
end ShapeSOS.ConvexConsistency


