    (hA : ∀ x a, A x a = A' x a) (hB : ∀ x a, B x a = B' x a) :
    _root_.MIPStarRE.QPBT.consistencyDefect mu A B psi = _root_.MIPStarRE.QPBT.consistencyDefect mu A' B' psi := by sorry
