open ModularCurve ModularCurve.UVCrossingModel

theorem ModularCurve.UVCrossingModel.exists_ringEquiv_quotient_span_V_powerSeries {W : Type*} [CommRing W] (π : W) : ∃ e : (UVCrossingModel W π ⧸ Ideal.span {V π}) ≃+* PowerSeries (W ⧸ Ideal.span {π}), e (Ideal.Quotient.mk _ (U π)) = PowerSeries.X ∧ e (Ideal.Quotient.mk _ (V π)) = 0 ∧ ∀ w : W, e (Ideal.Quotient.mk _ (const π w)) = PowerSeries.C (Ideal.Quotient.mk (Ideal.span {π}) w) := by sorry
