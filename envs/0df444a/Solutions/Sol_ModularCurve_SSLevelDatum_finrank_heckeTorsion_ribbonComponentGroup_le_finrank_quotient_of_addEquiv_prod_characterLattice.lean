theorem isWidthAdjoint_edge_corr (ℓ : Nat.Primes) (hℓq' : (ℓ : ℕ) ≠ q') :
    haveI : NeZero (ℓ : ℕ) := ⟨ℓ.2.ne_zero⟩
    haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
    haveI := hPD (M * s) ℓ (natCast_ne_zero_of_not_dvd q' A (M * s) (not_q'_dvd_Ms M s q' hs hsq' hq'M)) (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
    IsWidthAdjoint (fun e : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) => ((SSLevelDatum.degeneracyData X).w e : ℕ)) (X.edgeHecke ℓ) (Matrix.of fun y x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) =>
        Divisor.correspondence (heckeAlphaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ) (heckeBetaC (IsLocalRing.ResidueField ↥A) (M * s) ℓ)
          (X.legsIntegral (M * s) ℓ).1 (X.legsIntegral (M * s) ℓ).2 (Finsupp.single x.1 1) y.1) := by
  haveI : NeZero (ℓ : ℕ) := ⟨ℓ.2.ne_zero⟩
  haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
  haveI := hPD (M * s) ℓ (natCast_ne_zero_of_not_dvd q' A (M * s) (not_q'_dvd_Ms M s q' hs hsq' hq'M)) (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
  exact isWidthAdjoint_corr q' hq5 A (M * s) ℓ ℓ.2 hℓq' (not_q'_dvd_Ms M s q' hs hsq' hq'M)
    (X.legsIntegral (M * s) ℓ).1 (X.legsIntegral (M * s) ℓ).2 (X.edgeHecke ℓ)
    ((SSLevelDatum.edgeHecke_apply_and_vertexHecke_apply_of_ne X ℓ hℓq').1)

theorem isWidthAdjoint_vertex_corr (ℓ : Nat.Primes) (hℓq' : (ℓ : ℕ) ≠ q') :
    haveI : NeZero (ℓ : ℕ) := ⟨ℓ.2.ne_zero⟩
    haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
    haveI := hPD M ℓ (natCast_ne_zero_of_not_dvd q' A M hq'M) (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
    IsWidthAdjoint (fun v : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) => ((Nat.toPNat' (placeWidth M v.1)) : ℕ)) (X.vertexHecke ℓ) (Matrix.of fun y x : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) =>
        Divisor.correspondence (heckeAlphaC (IsLocalRing.ResidueField ↥A) M ℓ) (heckeBetaC (IsLocalRing.ResidueField ↥A) M ℓ)
          (X.legsIntegral M ℓ).1 (X.legsIntegral M ℓ).2 (Finsupp.single x.1 1) y.1) := by
  haveI : NeZero (ℓ : ℕ) := ⟨ℓ.2.ne_zero⟩
  haveI : Fact (ℓ : ℕ).Prime := ⟨ℓ.2⟩
  haveI := hPD M ℓ (natCast_ne_zero_of_not_dvd q' A M hq'M) (natCast_ne_zero_of_prime_ne q' A ℓ hℓq')
  exact isWidthAdjoint_corr q' hq5 A M ℓ ℓ.2 hℓq' hq'M
    (X.legsIntegral M ℓ).1 (X.legsIntegral M ℓ).2 (X.vertexHecke ℓ)
