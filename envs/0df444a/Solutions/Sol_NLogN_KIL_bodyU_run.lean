      (cStepsU rX (vol (P :: L :: hdShape A B Cs m N)) Bb (subT m)) := by
  have H := stepsU_spec A B Cs P L rX hrX hpos Bb R hV hQ2 t hNQ hQQ hX hB hC (subT m) xs
    (fun T hT => by
      simp only [subT, List.mem_map] at hT
