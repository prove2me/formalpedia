    rw [hx0, mul_zero] at h3
    exact (mul_eq_zero.1 h3).resolve_left (Nat.cast_ne_zero.2 hc.ne')

  have h7 : (((p : ℕ) : ℤ_[p]) ^ k₂) • ((c : ℤ_[p]) • x) ∈ TtH.map (tmap p pull) ⊔ ToldH.map (tmap p pull) := by
    rw [← hnormx, ← map_smul, ← Submodule.map_sup]
    exact Submodule.mem_map_of_mem (hk₂ (tmap p push x) horthH)

  have hTorLeg : ∀ a' ∈ TtH.map (tmap p pull), (p : ℤ_[p]) • a' ∈
      Submodule.span ℤ_[p]
        ({z : TateModule p J₁ | ∃ (i : Fin 2) (w : TateModule p J'), ∀ n : ℕ,
            (z : ℕ → J₁) n = π i ((w : ℕ → J') n)} ∪
          {z : TateModule p J₁ | ∃ τ ∈ I, ∃ y : TateModule p J₁,
            (∀ (n : ℕ), ∀ d ∈ S, D d ((y : ℕ → J₁) n) = (y : ℕ → J₁) n) ∧
