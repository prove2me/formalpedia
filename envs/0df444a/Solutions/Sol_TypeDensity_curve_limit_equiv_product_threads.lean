theorem solution (R : Type) [CommRing R] (t x : R)
    [(Ideal.span ({t,x} : Set R)).IsMaximal] [IsNoetherianRing (TypeDensity.BlowupChart R t x)]
    [IsNoetherianRing (TypeDensity.BlowupChart R x t)] (beta : TypeDensity.BlowupRestriction R t x) (D : TypeDensity.TwoChartCurveData R
    t x beta) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d) (hG : ∀ j : ℕ,
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (G.left j)} = TypeDensity.leftLevelKernel D j ∧
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (G.right j)} = TypeDensity.rightLevelKernel D j)
    :
    ∃ E : TypeDensity.CurveOrderLimit R t x beta G ≃ TypeDensity.curveProductThreads D, ∀ p : TypeDensity.curveThreads R t x beta G, ∀ j
      : ℕ, (E (TypeDensity.curveLimitMk R t x beta G p)).val j = TypeDensity.sectionsToProduct D j (p.val j) := by
  choose Ej hEj using fun j => TypeDensity.curve_sections_quot_equiv_product R t x beta D d G hG j
  choose ρ hρ using fun j => TypeDensity.curve_sections_quot_reduction_exists R t x beta d G j
  -- key: equal classes, one in curveSections, give equal images
  have key : ∀ j (a b : TypeDensity.ChartPair R t x), a ∈ TypeDensity.curveSections R t x beta G j →
      (TypeDensity.curveIdealLattice R t x beta G j).mkQ a = (TypeDensity.curveIdealLattice R t x beta G j).mkQ b →
        TypeDensity.sectionsToProduct D j a = TypeDensity.sectionsToProduct D j b := by
    intro j a b ha hab
    have hm : (TypeDensity.curveIdealLattice R t x beta G j).mkQ a ∈ TypeDensity.curveSectionsQuot R t x beta G j :=
      ⟨a, ha, rfl⟩
    rw [← hEj j ⟨_, hm⟩ a rfl, ← hEj j ⟨_, hm⟩ b hab]
  have red : ∀ j (q : TypeDensity.ChartPair R t x),
      TypeDensity.curveProductReduction D j (TypeDensity.sectionsToProduct D (j+1) q) = TypeDensity.sectionsToProduct D j q := by
    intro j q; rfl
  have secs : ∀ (p : TypeDensity.curveThreads R t x beta G) j, p.val j ∈ TypeDensity.curveSections R t x beta G j :=
    fun p j => p.2.1 j (Set.mem_univ _)
  let F : TypeDensity.curveThreads R t x beta G → TypeDensity.curveProductThreads D := fun p =>
    ⟨fun j => TypeDensity.sectionsToProduct D j (p.val j), fun j => by
      rw [red]; exact (key j _ _ (secs p j) (TypeDensity.curveThreads_mkQ_succ p j)).symm⟩
  let Φ : TypeDensity.CurveOrderLimit R t x beta G → TypeDensity.curveProductThreads D :=
    Quotient.lift F (by
      intro p p' h
      have h' : TypeDensity.curveLimitMk R t x beta G p = TypeDensity.curveLimitMk R t x beta G p' := Quotient.sound h
      rw [TypeDensity.curveLimitMk_eq_iff] at h'
      apply Subtype.ext; funext j
      exact key j _ _ (secs p j) (h' j))
  have hΦ : ∀ p, Φ (TypeDensity.curveLimitMk R t x beta G p) = F p := fun p => rfl
  have inj : Function.Injective Φ := by
    intro a b hab
    induction a using Quotient.inductionOn with | _ p => ?_
    induction b using Quotient.inductionOn with | _ p' => ?_
    change Φ (TypeDensity.curveLimitMk R t x beta G p) = Φ (TypeDensity.curveLimitMk R t x beta G p') at hab
    change TypeDensity.curveLimitMk R t x beta G p = TypeDensity.curveLimitMk R t x beta G p'
    rw [hΦ, hΦ] at hab
    rw [TypeDensity.curveLimitMk_eq_iff]; intro j
    have hj := congrArg (fun u : TypeDensity.curveProductThreads D => u.val j) hab
    simp only [F] at hj
    have e1 := hEj j ⟨_, ⟨p.val j, secs p j, rfl⟩⟩ (p.val j) rfl
    have e2 := hEj j ⟨_, ⟨p'.val j, secs p' j, rfl⟩⟩ (p'.val j) rfl
    have := (Ej j).injective (e1.trans (hj.trans e2.symm))
    exact congrArg Subtype.val this
  have surj : Function.Surjective Φ := by
    intro u
    -- representatives
    have hrep : ∀ j, ∃ r ∈ TypeDensity.curveSections R t x beta G j,
        (TypeDensity.curveIdealLattice R t x beta G j).mkQ r =
          (((Ej j).symm (u.val j) : TypeDensity.curveSectionsQuot R t x beta G j) : _) :=
      fun j => ((Ej j).symm (u.val j)).2
    choose r hr hre using hrep
    have hs : ∀ j, TypeDensity.sectionsToProduct D j (r j) = u.val j := by
      intro j
      rw [← hEj j ((Ej j).symm (u.val j)) (r j) (hre j).symm, AddEquiv.apply_symm_apply]
    have mem : r ∈ TypeDensity.curveThreads R t x beta G := by
      refine ⟨fun j _ => hr j, ?_⟩
      intro j _
      have e := hρ j ((Ej (j+1)).symm (u.val (j+1))) (r (j+1)) (hre (j+1)).symm
      have e2 := hEj j _ (r (j+1)) e
      rw [← red j (r (j+1)), hs (j+1), u.2 j, ← hs j] at e2
      have e3 := hEj j ((Ej j).symm (u.val j)) (r j) (hre j).symm
      have e4 : ρ j ((Ej (j+1)).symm (u.val (j+1))) = (Ej j).symm (u.val j) :=
        (Ej j).injective (by rw [e2, e3])
      have e5 : (TypeDensity.curveIdealLattice R t x beta G j).mkQ (r (j+1)) =
          (TypeDensity.curveIdealLattice R t x beta G j).mkQ (r j) := by
        rw [← e, e4, hre]
      rw [Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq] at e5
      have e6 := (TypeDensity.curveIdealLattice R t x beta G j).neg_mem e5
      rw [neg_sub] at e6
      change r j - r (j+1) ∈ _
      exact e6
    refine ⟨TypeDensity.curveLimitMk R t x beta G ⟨r, mem⟩, ?_⟩
    rw [hΦ]; apply Subtype.ext; funext j; exact hs j
  refine ⟨Equiv.ofBijective Φ ⟨inj, surj⟩, fun p j => rfl⟩
