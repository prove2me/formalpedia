-- title:
--   Theorem 2.15 — the conjugate-subgradient direction points at least as much toward $x^*$ as the subgradient
-- statement:
--   Let $f$ be convex on $E_n$ with a minimum point $x^*$ and $f^* = f(x^*)$. Consider the procedure (2.38):
--   $$
--   x_{k+1} = x_k - h_k s_k, \quad h_k = \frac{[f(x_k) - f^*]\,\gamma_k}{\|s_k\|^2}; \qquad s_0 = g_f(x_0), \quad s_k = g_f(x_k) + \beta_k s_{k-1}, \quad k = 1, 2, \dots,
--   $$
--   for any subgradient selection $g_f$. If $0 < \gamma_k \le 1$ and $\beta_k \ge 0$ for all $k = 0, 1, \dots$, then
--   $$
--   (x_k - x^*,\, s_k) \ge (x_k - x^*,\, g_f(x_k)) \qquad \text{for all } k .
--   $$
--
--   Combining the current subgradient with the previous direction never makes the direction less aligned with $x_k - x^*$, in the sense of this inner product.
--
--   **Formalization Note** The sequences $\{x_k\}$, $\{s_k\}$, $\{\gamma_k\}$, $\{\beta_k\}$ are arbitrary sequences satisfying the recursion; $\beta_k$ may depend on the trajectory. $\beta_0$ never enters the recursion. If $s_k = 0$ the step $h_k$ is taken to be $0$ (the book's formula is then undefined; this only happens at a minimum point).
-- source:
--   Shor, Minimization Methods for Non-Differentiable Functions, Springer 1985, p. 41, Theorem 2.15 with procedure (2.38)

import Mathlib
import Definitions.Def_ShorNonsmooth_Fejer_PolyakMethod

open Filter Topology

namespace ShorNonsmooth.Fejer

/-- Shor (1985), p. 41, Theorem 2.15. Let `f` be convex on `E_n` with minimum point `x*`,
`f* = f(x*)`, and let `{x_k}`, `{s_k}` be generated by the procedure (2.38):
`x_{k+1} = x_k - h_k s_k`, `h_k = [f(x_k) - f*] γ_k / ‖s_k‖²`, `s₀ = g_f(x₀)`,
`s_k = g_f(x_k) + β_k s_{k-1}` (`k = 1, 2, …`), for any subgradient selection `g_f`.
If `0 < γ_k ≤ 1` and `β_k ≥ 0` for all `k`, then `(x_k - x*, s_k) ≥ (x_k - x*, g_f(x_k))` for
all `k`. -/
theorem cfm_inner_direction_ge {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (hf : ConvexOn ℝ Set.univ f) (xstar : EuclideanSpace ℝ (Fin n))
    (hmin : ∀ y, f xstar ≤ f y)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hg : ∀ x, ShorNonsmooth.AlmostDiff.IsSubgradient f x (g x))
    (γ β : ℕ → ℝ) (hγ : ∀ k, 0 < γ k ∧ γ k ≤ 1) (hβ : ∀ k, 0 ≤ β k)
    (x s : ℕ → EuclideanSpace ℝ (Fin n)) (hs0 : s 0 = g (x 0))
    (hx : ∀ k, x (k + 1) = x k - cfmStepsize f (f xstar) (γ k) (x k) (s k) • s k)
    (hs : ∀ k, s (k + 1) = g (x (k + 1)) + β (k + 1) • s k) :
    ∀ k, inner ℝ (x k - xstar) (s k) ≥ inner ℝ (x k - xstar) (g (x k)) := by sorry

end ShorNonsmooth.Fejer
