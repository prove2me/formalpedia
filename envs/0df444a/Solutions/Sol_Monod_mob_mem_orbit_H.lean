section
/-!
# Piecewise `PSL(2, A)` maps lie in Monod's `G`

A map that is locally Möbius with `SL(2, A)` matrices off a finite subset of `P_A` is locally
Möbius with `SL(2, ℝ)` matrices (the same real entries) off a finite set. Hence the condition
`f ∈ Gpp` in the definition of `G A` is automatic, and `G A` is the subgroup generated by the maps
piecewise in `PSL(2, A)` with breakpoints in `P_A`.
-/

open Filter Topology

namespace Monod.Dev.GMono

open Monod

/-- An element of `SL(2, A)` viewed in `SL(2, ℝ) = SL(2, ⊤)`, with the same real entries. -/
noncomputable def toTop {A : Subring ℝ} (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    Matrix.SpecialLinearGroup (Fin 2) (⊤ : Subring ℝ) :=
  Matrix.SpecialLinearGroup.map (Subring.inclusion le_top) g

lemma slToGL_toTop {A : Subring ℝ} (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    slToGL ⊤ (toTop g) = slToGL A g := by
  ext i j
  rfl

lemma mob_toTop {A : Subring ℝ} (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (toTop g) x = mob g x := by
  unfold mob
  rw [slToGL_toTop]

/-- A map piecewise in `PSL(2, A)` with breakpoints in `E` is piecewise in `PSL(2, ℝ)` with
breakpoints anywhere. -/
theorem isPiecewiseProjOn_top_univ {A : Subring ℝ} {E : Set (OnePoint ℝ)}
    {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : IsPiecewiseProjOn A E f) :
    IsPiecewiseProjOn ⊤ Set.univ f := by
  obtain ⟨B, -, hB⟩ := hf
  refine ⟨B, Set.subset_univ _, fun x hx => ?_⟩
  obtain ⟨g, hg⟩ := hB x hx
  exact ⟨toTop g, hg.mono fun y hy => by rw [hy, mob_toTop]⟩

/-- **Monotonicity**: a map piecewise in `PSL(2, A)` with breakpoints in `P_A` lies in Monod's
`G`. -/
theorem mem_Gpp_of_isPiecewiseProj {A : Subring ℝ} {f : OnePoint ℝ ≃ₜ OnePoint ℝ}
    (hf : IsPiecewiseProj A f) : f ∈ Gpp :=
  Subgroup.subset_closure (isPiecewiseProjOn_top_univ hf)

/-- `G A` is the subgroup generated by the maps piecewise in `PSL(2, A)` with breakpoints in
`P_A`. -/
theorem G_eq_closure_isPiecewiseProj (A : Subring ℝ) :
    G A = Subgroup.closure {f | IsPiecewiseProj A f} := by
  unfold G
  congr 1
  ext f
  exact ⟨fun h => h.2, fun h => ⟨mem_Gpp_of_isPiecewiseProj h, h⟩⟩

/-- A map piecewise in `PSL(2, A)` with breakpoints in `P_A` lies in `G A`. -/
theorem mem_G_of_isPiecewiseProj {A : Subring ℝ} {f : OnePoint ℝ ≃ₜ OnePoint ℝ}
    (hf : IsPiecewiseProj A f) : f ∈ G A :=
  Subgroup.subset_closure ⟨mem_Gpp_of_isPiecewiseProj hf, hf⟩

end Monod.Dev.GMono
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- real entries -/
noncomputable abbrev ent (g : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) : ℝ :=
  ((g i j : A) : ℝ)

lemma slToGL_apply (g : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) :
    (slToGL A g : GL (Fin 2) ℝ) i j = ent g i j := by
  simp [slToGL]

lemma det_ent (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    ent g 0 0 * ent g 1 1 - ent g 0 1 * ent g 1 0 = 1 := by
  have h := g.2
  rw [Matrix.det_fin_two] at h
  have := congrArg (fun x : A => (x : ℝ)) h
  simpa using this

lemma mob_coe (g : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) :
    mob g (t : OnePoint ℝ) = if ent g 1 0 * t + ent g 1 1 = 0 then ∞ else
      (((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1) : ℝ) : OnePoint ℝ) := by
  unfold mob
  rw [OnePoint.smul_some_eq_ite]
  simp only [slToGL_apply]

lemma mob_infty (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    mob g ∞ = if ent g 1 0 = 0 then ∞ else ((ent g 0 0 / ent g 1 0 : ℝ) : OnePoint ℝ) := by
  unfold mob
  rw [OnePoint.smul_infty_eq_ite]
  simp only [slToGL_apply]

lemma mob_mul (g h : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (g * h) x = mob g (mob h x) := by
  unfold mob
  rw [map_mul, mul_smul]

lemma mob_one (x : OnePoint ℝ) : mob (1 : Matrix.SpecialLinearGroup (Fin 2) A) x = x := by
  unfold mob
  rw [map_one, one_smul]

lemma mob_inv_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g⁻¹ (mob g x) = x := by
  rw [← mob_mul, inv_mul_cancel, mob_one]

lemma mob_mob_inv (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob g (mob g⁻¹ x) = x := by
  rw [← mob_mul, mul_inv_cancel, mob_one]

lemma tendsto_coe_cobounded :
    Tendsto (fun x : ℝ => (x : OnePoint ℝ)) (Bornology.cobounded ℝ) (𝓝 ∞) := by
  rw [Metric.cobounded_eq_cocompact, ← coclosedCompact_eq_cocompact]
  exact tendsto_coe_infty

lemma tendsto_affine_cobounded {c : ℝ} (hc : c ≠ 0) (d : ℝ) :
    Tendsto (fun x : ℝ => c * x + d) (Bornology.cobounded ℝ) (Bornology.cobounded ℝ) := by
  rw [← tendsto_norm_atTop_iff_cobounded]
  have h1 := tendsto_norm_cobounded_atTop (E := ℝ)
  have h2 : Tendsto (fun x : ℝ => |c| * ‖x‖ - |d|) (Bornology.cobounded ℝ) atTop := by
    apply tendsto_atTop_add_const_right
    exact h1.const_mul_atTop (abs_pos.2 hc)
  refine tendsto_atTop_mono (fun x => ?_) h2
  simp only [Real.norm_eq_abs]
  have := abs_sub_abs_le_abs_sub (c * x) (-d)
  rw [abs_mul, abs_neg, sub_neg_eq_add] at this
  linarith

lemma frac_eq (g : Matrix.SpecialLinearGroup (Fin 2) A) {x : ℝ} (hc : ent g 1 0 ≠ 0)
    (hx : ent g 1 0 * x + ent g 1 1 ≠ 0) :
    (ent g 0 0 * x + ent g 0 1) / (ent g 1 0 * x + ent g 1 1) =
      ent g 0 0 / ent g 1 0 - (ent g 1 0 * (ent g 1 0 * x + ent g 1 1))⁻¹ := by
  have := det_ent g
  rw [eq_sub_iff_add_eq, div_eq_mul_inv, mul_inv, ← add_mul, ← div_eq_mul_inv]
  rw [div_eq_div_iff hx hc, add_mul, inv_mul_cancel₀ hc]
  linear_combination (-1 : ℝ) * this

lemma continuous_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) : Continuous (mob g) := by
  have hdet := det_ent g
  rw [OnePoint.continuous_iff]
  constructor
  · rw [coclosedCompact_eq_cocompact, ← Metric.cobounded_eq_cocompact]
    by_cases hc : ent g 1 0 = 0
    · have hd : ent g 1 1 ≠ 0 := by
        intro h; rw [h, hc] at hdet; simp at hdet
      rw [mob_infty, if_pos hc]
      have : (fun x : ℝ => mob g (x : OnePoint ℝ)) =
          fun x : ℝ => (((ent g 0 0 / ent g 1 1) * x + ent g 0 1 / ent g 1 1 : ℝ) : OnePoint ℝ) := by
        funext x
        rw [mob_coe, if_neg (by rw [hc]; simpa using hd)]
        congr 1
        rw [hc, zero_mul, zero_add]; field_simp
      rw [this]
      have ha : ent g 0 0 ≠ 0 := by
        intro h; rw [h, hc] at hdet; simp at hdet
      exact tendsto_coe_cobounded.comp (tendsto_affine_cobounded (div_ne_zero ha hd) _)
    · rw [mob_infty, if_neg hc]
      have hev : ∀ᶠ x : ℝ in Bornology.cobounded ℝ, ent g 1 0 * x + ent g 1 1 ≠ 0 := by
        have := (tendsto_affine_cobounded hc (ent g 1 1)).eventually
          (Bornology.eventually_ne_cobounded (0 : ℝ))
        exact this
      have hlim : Tendsto (fun x : ℝ => ((ent g 0 0 / ent g 1 0 -
          (ent g 1 0 * (ent g 1 0 * x + ent g 1 1))⁻¹ : ℝ) : OnePoint ℝ))
          (Bornology.cobounded ℝ) (𝓝 ((ent g 0 0 / ent g 1 0 : ℝ) : OnePoint ℝ)) := by
        apply (continuous_coe.tendsto _).comp
        have h3 : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1))
            (Bornology.cobounded ℝ) (Bornology.cobounded ℝ) := by
          have := tendsto_affine_cobounded (mul_ne_zero hc hc) (ent g 1 0 * ent g 1 1)
          refine this.congr (fun x => ?_)
          ring
        have h4 := (tendsto_inv₀_cobounded.comp h3)
        have := (tendsto_const_nhds (x := ent g 0 0 / ent g 1 0)).sub h4
        simpa using this
      refine hlim.congr' ?_
      filter_upwards [hev] with x hx
      rw [mob_coe, if_neg hx, frac_eq g hc hx]
  · rw [continuous_iff_continuousAt]
    intro t
    by_cases ht : ent g 1 0 * t + ent g 1 1 = 0
    · have hc : ent g 1 0 ≠ 0 := by
        intro h; rw [h, zero_mul, zero_add] at ht; rw [ht, h] at hdet; simp at hdet
      show Tendsto (fun x : ℝ => mob g (x : OnePoint ℝ)) (𝓝 t) (𝓝 (mob g (t : OnePoint ℝ)))
      rw [mob_coe, if_pos ht, ← nhdsNE_sup_pure t, tendsto_sup]
      constructor
      · have h3 : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1))
            (𝓝[≠] t) (𝓝[≠] 0) := by
          apply tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within
          · have : Tendsto (fun x : ℝ => ent g 1 0 * (ent g 1 0 * x + ent g 1 1)) (𝓝 t)
                (𝓝 (ent g 1 0 * (ent g 1 0 * t + ent g 1 1))) :=
              ((continuous_const.mul ((continuous_const.mul continuous_id).add
                continuous_const)).tendsto t)
            rw [ht, mul_zero] at this
            exact tendsto_nhdsWithin_of_tendsto_nhds this
          · filter_upwards [self_mem_nhdsWithin] with x hx
            simp only [mem_compl_iff, mem_singleton_iff] at hx ⊢
            intro h0
            rcases mul_eq_zero.1 h0 with h | h
            · exact hc h
            · apply hx
              have : ent g 1 0 * (x - t) = 0 := by linarith
              rcases mul_eq_zero.1 this with h' | h'
              · exact absurd h' hc
              · linarith
        have h4 := tendsto_inv₀_nhdsNE_zero.comp h3
        have h5 := (tendsto_const_add_cobounded (ent g 0 0 / ent g 1 0)).comp
          ((tendsto_neg_cobounded).comp h4)
        refine (tendsto_coe_cobounded.comp h5).congr' ?_
        filter_upwards [self_mem_nhdsWithin] with x hx
        simp only [mem_compl_iff, mem_singleton_iff] at hx
        have hx' : ent g 1 0 * x + ent g 1 1 ≠ 0 := by
          intro h0; apply hx
          have : ent g 1 0 * (x - t) = 0 := by linarith
          rcases mul_eq_zero.1 this with h' | h'
          · exact absurd h' hc
          · linarith
        simp only [Function.comp_apply]
        rw [mob_coe, if_neg hx', frac_eq g hc hx', sub_eq_add_neg]
      · rw [tendsto_pure_left]
        intro s hs
        rw [mob_coe, if_pos ht]
        exact mem_of_mem_nhds hs
    · have hev : ∀ᶠ x : ℝ in 𝓝 t, ent g 1 0 * x + ent g 1 1 ≠ 0 :=
        ((continuous_const.mul continuous_id).add continuous_const).continuousAt.eventually_ne ht
      have hcont : ContinuousAt (fun x : ℝ => (((ent g 0 0 * x + ent g 0 1) /
          (ent g 1 0 * x + ent g 1 1) : ℝ) : OnePoint ℝ)) t := by
        apply continuous_coe.continuousAt.comp
        exact (((continuous_const.mul continuous_id).add continuous_const).continuousAt).div
          (((continuous_const.mul continuous_id).add continuous_const).continuousAt) ht
      refine hcont.congr (Filter.EventuallyEq.symm ?_)
      filter_upwards [hev] with x hx
      rw [mob_coe, if_neg hx]

/-- The Möbius action as a homeomorphism. -/
noncomputable def mobH (g : Matrix.SpecialLinearGroup (Fin 2) A) : OnePoint ℝ ≃ₜ OnePoint ℝ where
  toFun := mob g
  invFun := mob g⁻¹
  left_inv := mob_inv_mob g
  right_inv := mob_mob_inv g
  continuous_toFun := continuous_mob g
  continuous_invFun := continuous_mob g⁻¹

@[simp] lemma mobH_apply (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mobH g x = mob g x := rfl

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-! ### Identity theorem for Möbius maps -/

lemma fixed_eq (k : Matrix.SpecialLinearGroup (Fin 2) A) {w : ℝ} (h : mob k (w : OnePoint ℝ) = w) :
    ent k 0 0 * w + ent k 0 1 = w * (ent k 1 0 * w + ent k 1 1) := by
  rw [mob_coe] at h
  split_ifs at h with hd
  · exact absurd h (infty_ne_coe _)
  · rw [coe_eq_coe, div_eq_iff hd] at h
    linarith

lemma mob_eq_self_of_three (k : Matrix.SpecialLinearGroup (Fin 2) A) {w1 w2 w3 : ℝ}
    (h12 : w1 ≠ w2) (h13 : w1 ≠ w3) (h23 : w2 ≠ w3)
    (e1 : mob k (w1 : OnePoint ℝ) = w1) (e2 : mob k (w2 : OnePoint ℝ) = w2)
    (e3 : mob k (w3 : OnePoint ℝ) = w3) : ∀ x, mob k x = x := by
  have f1 := fixed_eq k e1
  have f2 := fixed_eq k e2
  have f3 := fixed_eq k e3
  have hdet := det_ent k
  have q1 : (w1 - w2) * (ent k 1 0 * (w1 + w2) + ent k 1 1 - ent k 0 0) = 0 := by
    linear_combination f2 - f1
  have q2 : (w1 - w3) * (ent k 1 0 * (w1 + w3) + ent k 1 1 - ent k 0 0) = 0 := by
    linear_combination f3 - f1
  have s1 := (mul_eq_zero.1 q1).resolve_left (sub_ne_zero.2 h12)
  have s2 := (mul_eq_zero.1 q2).resolve_left (sub_ne_zero.2 h13)
  have hc0 : ent k 1 0 * (w2 - w3) = 0 := by linear_combination s1 - s2
  have hc : ent k 1 0 = 0 := (mul_eq_zero.1 hc0).resolve_right (sub_ne_zero.2 h23)
  have hd : ent k 1 1 = ent k 0 0 := by rw [hc] at s1; linarith
  have hb : ent k 0 1 = 0 := by rw [hc, hd] at f1; linarith
  have ha : ent k 0 0 ≠ 0 := by
    intro h; rw [hd, h, hc] at hdet; simp at hdet
  intro x
  cases x with
  | infty => rw [mob_infty, if_pos hc]
  | coe t =>
    rw [mob_coe, hc, hd, hb, zero_mul, zero_add, if_neg ha, add_zero]
    congr 1; field_simp

lemma mob_eq_of_eventually (g g' : Matrix.SpecialLinearGroup (Fin 2) A) (z : ℝ)
    (h : ∀ᶠ w : ℝ in 𝓝 z, mob g (w : OnePoint ℝ) = mob g' w) : ∀ x, mob g x = mob g' x := by
  have hk : ∀ᶠ w : ℝ in 𝓝 z, mob (g'⁻¹ * g) (w : OnePoint ℝ) = w :=
    h.mono fun w hw => by rw [mob_mul, hw, mob_inv_mob]
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 hk
  have hd : ∀ r : ℝ, 0 ≤ r → r < ε → dist (z + r) z < ε := fun r h0 h1 => by
    rw [Real.dist_eq, abs_lt]; constructor <;> linarith
  have key := mob_eq_self_of_three (g'⁻¹ * g) (w1 := z) (w2 := z + ε / 2) (w3 := z + ε / 4)
    (by intro h; linarith) (by intro h; linarith) (by intro h; linarith)
    (hball (by simpa using hε)) (hball (hd _ (by linarith) (by linarith)))
    (hball (hd _ (by linarith) (by linarith)))
  intro x
  have := key x
  rw [mob_mul] at this
  calc mob g x = mob g' (mob g'⁻¹ (mob g x)) := (mob_mob_inv _ _).symm
    _ = mob g' x := by rw [this]

lemma exists_mob_eqOn (f : OnePoint ℝ → OnePoint ℝ) {I : Set ℝ} (hI : IsPreconnected I)
    {y0 : ℝ} (hy0 : y0 ∈ I)
    (hloc : ∀ y ∈ I, ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, f =ᶠ[𝓝 (y : OnePoint ℝ)] mob g) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, ∀ y ∈ I, f y = mob g y := by
  classical
  let gs : ℝ → Matrix.SpecialLinearGroup (Fin 2) A :=
    fun y => if h : y ∈ I then (hloc y h).choose else 1
  have hgs : ∀ y ∈ I, f =ᶠ[𝓝 (y : OnePoint ℝ)] mob (gs y) := fun y hy => by
    simp only [gs, dif_pos hy]; exact (hloc y hy).choose_spec
  have hgs1 : ∀ y ∈ I, ∀ᶠ v : ℝ in 𝓝 y, f (v : OnePoint ℝ) = mob (gs y) v := fun y hy =>
    (continuous_coe.tendsto y).eventually (hgs y hy)
  let P : ℝ → ℝ → Prop := fun y z => ∀ x, mob (gs y) x = mob (gs z) x
  have hP : ∀ y z, y ∈ I → z ∈ I → P y z := by
    intro y z hy hz
    refine hI.induction₂' P ?_ ?_ hy hz
    · intro y hy
      rw [eventually_nhdsWithin_iff]
      filter_upwards [(hgs1 y hy).eventually_nhds] with z hz hzI
      have h3 : ∀ᶠ v : ℝ in 𝓝 z, mob (gs y) (v : OnePoint ℝ) = mob (gs z) v := by
        filter_upwards [hz, hgs1 z hzI] with v h1 h2
        rw [← h1, h2]
      have := mob_eq_of_eventually _ _ z h3
      exact ⟨this, fun x => (this x).symm⟩
    · intro a b c _ _ _ hab hbc x
      rw [hab, hbc]
  refine ⟨gs y0, fun y hy => ?_⟩
  rw [(hgs y hy).self_of_nhds, hP y y0 hy hy0]

/-! ### One-sided filters -/

/-- the right-hand filter at a point of `P¹` (for `∞`, approach from `-∞`) -/
def RF (x : OnePoint ℝ) : Filter (OnePoint ℝ) :=
  x.elim (map (fun y : ℝ => (y : OnePoint ℝ)) atBot) (fun t => map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[>] t))

/-- the left-hand filter at a point of `P¹` (for `∞`, approach from `+∞`) -/
def LF (x : OnePoint ℝ) : Filter (OnePoint ℝ) :=
  x.elim (map (fun y : ℝ => (y : OnePoint ℝ)) atTop) (fun t => map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[<] t))

lemma RF_infty : RF ∞ = map (fun y : ℝ => (y : OnePoint ℝ)) atBot := rfl
lemma RF_coe (t : ℝ) : RF t = map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[>] t) := rfl
lemma LF_infty : LF ∞ = map (fun y : ℝ => (y : OnePoint ℝ)) atTop := rfl
lemma LF_coe (t : ℝ) : LF t = map (fun y : ℝ => (y : OnePoint ℝ)) (𝓝[<] t) := rfl

lemma atBot_le_coe_nhds_infty :
    map (fun y : ℝ => (y : OnePoint ℝ)) atBot ≤ 𝓝 ∞ := by
  have : Tendsto (fun y : ℝ => (y : OnePoint ℝ)) atBot (𝓝 ∞) := by
    have h := tendsto_coe_infty (X := ℝ)
    rw [coclosedCompact_eq_cocompact] at h
    exact h.mono_left atBot_le_cocompact
  exact this

lemma RF_le_nhds (x : OnePoint ℝ) : RF x ≤ 𝓝 x := by
  cases x with
  | infty => exact atBot_le_coe_nhds_infty
  | coe t =>
    rw [RF_coe, nhds_coe_eq]
    exact map_mono nhdsWithin_le_nhds

instance RF_neBot (x : OnePoint ℝ) : NeBot (RF x) := by
  cases x with
  | infty => rw [RF_infty]; infer_instance
  | coe t => rw [RF_coe]; infer_instance

instance LF_neBot (x : OnePoint ℝ) : NeBot (LF x) := by
  cases x with
  | infty => rw [LF_infty]; infer_instance
  | coe t => rw [LF_coe]; infer_instance

lemma sub_frac (g : Matrix.SpecialLinearGroup (Fin 2) A) {y t : ℝ}
    (hy : ent g 1 0 * y + ent g 1 1 ≠ 0) (ht : ent g 1 0 * t + ent g 1 1 ≠ 0) :
    (ent g 0 0 * y + ent g 0 1) / (ent g 1 0 * y + ent g 1 1) -
      (ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1) =
      (y - t) / ((ent g 1 0 * y + ent g 1 1) * (ent g 1 0 * t + ent g 1 1)) := by
  have hdet := det_ent g
  rw [div_sub_div _ _ hy ht]
  congr 1
  linear_combination (y - t) * hdet

lemma cont_frac (g : Matrix.SpecialLinearGroup (Fin 2) A) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 ≠ 0) :
    ContinuousAt (fun y : ℝ => (ent g 0 0 * y + ent g 0 1) / (ent g 1 0 * y + ent g 1 1)) t :=
  (((continuous_const.mul continuous_id).add continuous_const).continuousAt).div
    (((continuous_const.mul continuous_id).add continuous_const).continuousAt) ht

lemma ev_pos_prod (g : Matrix.SpecialLinearGroup (Fin 2) A) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 ≠ 0) :
    ∀ᶠ y in 𝓝 t, 0 < (ent g 1 0 * y + ent g 1 1) * (ent g 1 0 * t + ent g 1 1) := by
  have hc : Continuous fun y : ℝ => (ent g 1 0 * y + ent g 1 1) * (ent g 1 0 * t + ent g 1 1) :=
    ((continuous_const.mul continuous_id).add continuous_const).mul continuous_const
  exact hc.continuousAt.eventually (lt_mem_nhds (mul_self_pos.2 ht))

lemma ne_of_pos_prod {u v : ℝ} (h : 0 < u * v) : u ≠ 0 := by
  rintro rfl; simp at h

lemma tendsto_RF (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    Tendsto (mob g) (RF x) (RF (mob g x)) := by
  have hdet := det_ent g
  cases x with
  | infty =>
    by_cases hc : ent g 1 0 = 0
    · rw [mob_infty, if_pos hc, RF_infty, tendsto_map'_iff]
      have hd : ent g 1 1 ≠ 0 := by intro h; rw [h, hc] at hdet; simp at hdet
      have hpos : 0 < ent g 0 0 / ent g 1 1 := by
        have : ent g 0 0 * ent g 1 1 = 1 := by rw [hc] at hdet; linarith
        have h2 : ent g 0 0 / ent g 1 1 = ent g 0 0 * ent g 1 1 / (ent g 1 1 * ent g 1 1) := by
          field_simp
        rw [h2, this]; exact div_pos one_pos (mul_self_pos.2 hd)
      have h1 : Tendsto (fun y : ℝ => ent g 0 0 / ent g 1 1 * y + ent g 0 1 / ent g 1 1)
          atBot atBot :=
        tendsto_atBot_add_const_right _ _ (tendsto_id.const_mul_atBot hpos)
      refine (tendsto_map.comp h1).congr (fun y => ?_)
      simp only [Function.comp_apply]
      rw [mob_coe, hc, zero_mul, zero_add, if_neg hd]
      congr 1; field_simp
    · rw [mob_infty, if_neg hc, RF_infty, RF_coe, tendsto_map'_iff]
      have h1 : Tendsto (fun y : ℝ => ent g 1 0 * (ent g 1 0 * y + ent g 1 1)) atBot atBot := by
        have : Tendsto (fun y : ℝ => (ent g 1 0 * ent g 1 0) * y + ent g 1 0 * ent g 1 1)
            atBot atBot :=
          tendsto_atBot_add_const_right _ _ (tendsto_id.const_mul_atBot (mul_self_pos.2 hc))
        exact this.congr (fun y => by ring)
      have h2 := tendsto_inv_atBot_nhdsLT_zero.comp h1
      have h4 : Tendsto (fun u : ℝ => ent g 0 0 / ent g 1 0 - u) (𝓝[<] 0)
          (𝓝[>] (ent g 0 0 / ent g 1 0)) := by
        rw [tendsto_nhdsWithin_iff]
        constructor
        · have : Tendsto (fun u : ℝ => ent g 0 0 / ent g 1 0 - u) (𝓝 0)
              (𝓝 (ent g 0 0 / ent g 1 0 - 0)) := (continuous_const.sub continuous_id).tendsto 0
          rw [sub_zero] at this
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with u hu
          simp only [mem_Iio, mem_Ioi] at hu ⊢
          linarith
      refine (tendsto_map.comp (h4.comp h2)).congr' ?_
      have hev : ∀ᶠ y : ℝ in atBot, ent g 1 0 * y + ent g 1 1 ≠ 0 := by
        filter_upwards [h1.eventually (eventually_lt_atBot 0)] with y hy h0
        rw [h0, mul_zero] at hy; exact lt_irrefl _ hy
      filter_upwards [hev] with y hy
      simp only [Function.comp_apply]
      rw [mob_coe, if_neg hy, frac_eq g hc hy]
  | coe t =>
    by_cases ht : ent g 1 0 * t + ent g 1 1 = 0
    · have hc : ent g 1 0 ≠ 0 := by
        intro h; rw [h, zero_mul, zero_add] at ht; rw [ht, h] at hdet; simp at hdet
      rw [mob_coe, if_pos ht, RF_infty, RF_coe, tendsto_map'_iff]
      have hid : ∀ y : ℝ, ent g 1 0 * (ent g 1 0 * y + ent g 1 1) =
          ent g 1 0 * ent g 1 0 * (y - t) := fun y => by linear_combination ent g 1 0 * ht
      have h1 : Tendsto (fun y : ℝ => ent g 1 0 * (ent g 1 0 * y + ent g 1 1)) (𝓝[>] t)
          (𝓝[>] 0) := by
        rw [tendsto_nhdsWithin_iff]
        constructor
        · have : Tendsto (fun y : ℝ => ent g 1 0 * ent g 1 0 * (y - t)) (𝓝 t)
              (𝓝 (ent g 1 0 * ent g 1 0 * (t - t))) :=
            (continuous_const.mul (continuous_id.sub continuous_const)).tendsto t
          rw [sub_self, mul_zero] at this
          simp_rw [hid]
          exact this.mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with y hy
          rw [mem_Ioi, hid]
          exact mul_pos (mul_self_pos.2 hc) (sub_pos.2 hy)
      have h2 := tendsto_inv_nhdsGT_zero.comp h1
      have h3 : Tendsto (fun y : ℝ => ent g 0 0 / ent g 1 0 +
          -(ent g 1 0 * (ent g 1 0 * y + ent g 1 1))⁻¹) (𝓝[>] t) atBot :=
        tendsto_atBot_add_const_left _ _ (tendsto_neg_atTop_atBot.comp h2)
      refine (tendsto_map.comp h3).congr' ?_
      filter_upwards [self_mem_nhdsWithin] with y hy
      have hy' : ent g 1 0 * y + ent g 1 1 ≠ 0 := by
        intro h0
        have := hid y
        rw [h0, mul_zero] at this
        have := mul_pos (mul_self_pos.2 hc) (sub_pos.2 (show t < y from hy))
        linarith
      simp only [Function.comp_apply]
      rw [mob_coe, if_neg hy', frac_eq g hc hy', sub_eq_add_neg]
    · rw [mob_coe, if_neg ht, RF_coe, RF_coe, tendsto_map'_iff]
      have h3 : Tendsto (fun y : ℝ => (ent g 0 0 * y + ent g 0 1) / (ent g 1 0 * y + ent g 1 1))
          (𝓝[>] t) (𝓝[>] ((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1))) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨(cont_frac g ht).tendsto.mono_left nhdsWithin_le_nhds, ?_⟩
        filter_upwards [self_mem_nhdsWithin, nhdsWithin_le_nhds (ev_pos_prod g ht)] with y hy hpos
        rw [mem_Ioi, ← sub_pos, sub_frac g (ne_of_pos_prod hpos) ht]
        exact div_pos (sub_pos.2 hy) hpos
      refine (tendsto_map.comp h3).congr' ?_
      filter_upwards [nhdsWithin_le_nhds (ev_pos_prod g ht)] with y hpos
      simp only [Function.comp_apply]
      rw [mob_coe, if_neg (ne_of_pos_prod hpos)]

/-! ### Germ property, generically in a filter family -/

/-- `f` agrees along `F x` with a Möbius map, for every `x`. -/
def GermP (F : OnePoint ℝ → Filter (OnePoint ℝ)) (A : Subring ℝ)
    (f : OnePoint ℝ ≃ₜ OnePoint ℝ) : Prop :=
  ∀ x, ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[F x] mob g

section generic

variable {F : OnePoint ℝ → Filter (OnePoint ℝ)} (hle : ∀ x, F x ≤ 𝓝 x) [hne : ∀ x, NeBot (F x)]
  (htend : ∀ (g : Matrix.SpecialLinearGroup (Fin 2) A) x, Tendsto (mob g) (F x) (F (mob g x)))

include hle in
lemma germ_value {f : OnePoint ℝ → OnePoint ℝ} (hf : Continuous f)
    {g : Matrix.SpecialLinearGroup (Fin 2) A} {x : OnePoint ℝ} (h : f =ᶠ[F x] mob g) :
    f x = mob g x :=
  tendsto_nhds_unique ((hf.tendsto x).mono_left (hle x))
    ((((continuous_mob g).tendsto x).mono_left (hle x)).congr' h.symm)

include hle htend in
lemma GermP_mul {f1 f2 : OnePoint ℝ ≃ₜ OnePoint ℝ} (h1 : GermP F A f1) (h2 : GermP F A f2) :
    GermP F A (f1 * f2) := by
  intro x
  obtain ⟨g2, hg2⟩ := h2 x
  obtain ⟨g1, hg1⟩ := h1 (f2 x)
  refine ⟨g1 * g2, ?_⟩
  have hx : f2 x = mob g2 x := germ_value hle f2.continuous hg2
  have ht : Tendsto f2 (F x) (F (f2 x)) := by
    rw [hx]; exact (htend g2 x).congr' hg2.symm
  filter_upwards [ht.eventually hg1, hg2] with y hy1 hy2
  rw [Homeomorph.mul_apply, mob_mul, hy1, hy2]

include hle htend in
lemma GermP_inv {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (h : GermP F A f) : GermP F A f⁻¹ := by
  intro x
  obtain ⟨g, hg⟩ := h (f.symm x)
  refine ⟨g⁻¹, ?_⟩
  have hx : f (f.symm x) = mob g (f.symm x) := germ_value hle f.continuous hg
  rw [Homeomorph.apply_symm_apply] at hx
  have hy : mob g⁻¹ x = f.symm x := by conv_lhs => rw [hx]
                                       exact mob_inv_mob _ _
  have ht : Tendsto (mob g⁻¹) (F x) (F (f.symm x)) := by rw [← hy]; exact htend g⁻¹ x
  filter_upwards [ht.eventually hg] with z hz
  rw [mob_mob_inv] at hz
  rw [Homeomorph.inv_apply]
  conv_lhs => rw [← hz]
  exact f.symm_apply_apply _

omit hne in
lemma GermP_one : GermP F A 1 := fun _ => ⟨1, Eventually.of_forall fun y => (mob_one y).symm⟩

include hle htend in
lemma GermP_of_mem_G (hgen : ∀ f, IsPiecewiseProj A f → GermP F A f) :
    ∀ f ∈ G A, GermP F A f := by
  intro f hf
  rw [Monod.Dev.GMono.G_eq_closure_isPiecewiseProj] at hf
  induction hf using Subgroup.closure_induction with
  | mem x hx => exact hgen x hx
  | one => exact GermP_one
  | mul x y _ _ hx hy => exact GermP_mul hle htend hx hy
  | inv x _ hx => exact GermP_inv hle htend hx

end generic

lemma germ_gen_aux {f : OnePoint ℝ ≃ₜ OnePoint ℝ} {B : Finset (OnePoint ℝ)}
    (hloc : ∀ x ∉ B, ∃ g : Matrix.SpecialLinearGroup (Fin 2) A,
      ∀ᶠ y in 𝓝 x, f y = mob g y)
    (Fr : Filter ℝ) [NeBot Fr] {I : Set ℝ} (hIF : I ∈ Fr) (hI : IsPreconnected I)
    (hIB : ∀ y ∈ I, (y : OnePoint ℝ) ∉ B) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) A,
      (f : OnePoint ℝ → OnePoint ℝ) =ᶠ[map (fun y : ℝ => (y : OnePoint ℝ)) Fr] mob g := by
  obtain ⟨y0, hy0⟩ := Filter.nonempty_of_mem hIF
  obtain ⟨g, hg⟩ := exists_mob_eqOn (A := A) f hI hy0 (fun y hy => hloc _ (hIB y hy))
  exact ⟨g, Filter.eventually_map.2 (Filter.mem_of_superset hIF (fun y hy => hg y hy))⟩

lemma gen_RF {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : IsPiecewiseProj A f) : GermP RF A f := by
  obtain ⟨B, -, hloc⟩ := hf
  intro x
  cases x with
  | infty =>
    have hev : ∀ᶠ y : ℝ in atBot, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      cases b with
      | infty => exact Eventually.of_forall (fun y => coe_ne_infty y)
      | coe s =>
        filter_upwards [eventually_lt_atBot s] with y hy h
        exact (ne_of_lt hy) (coe_injective h)
    obtain ⟨M, hM⟩ := eventually_atBot.1 hev
    exact germ_gen_aux hloc atBot (Iio_mem_atBot M) isPreconnected_Iio
      (fun y hy hyB => hM y (le_of_lt hy) _ hyB rfl)
  | coe t =>
    have hev : ∀ᶠ y : ℝ in 𝓝[>] t, ∀ b ∈ B, (y : OnePoint ℝ) ≠ b := by
      rw [eventually_all_finset]
      intro b _
      by_cases hbt : b = (t : OnePoint ℝ)
      · subst hbt
        filter_upwards [self_mem_nhdsWithin] with y hy h
        exact (ne_of_gt (show t < y from hy)) (coe_injective h)
      · exact nhdsWithin_le_nhds ((continuous_coe.continuousAt (x := t)).eventually_ne (Ne.symm hbt))
    obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hev
    exact germ_gen_aux hloc (𝓝[>] t) (mem_nhdsGT_iff_exists_Ioo_subset.2 ⟨u, hu, subset_rfl⟩)
      isPreconnected_Ioo (fun y hy hyB => hsub hy _ hyB rfl)

theorem germR_of_mem_G {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G A) : GermP RF A f :=
  GermP_of_mem_G RF_le_nhds tendsto_RF (fun _ h => gen_RF h) f hf

theorem orbit_of_mem_G {f : OnePoint ℝ ≃ₜ OnePoint ℝ} (hf : f ∈ G A) (x : OnePoint ℝ) :
    ∃ g : Matrix.SpecialLinearGroup (Fin 2) A, f x = mob g x := by
  obtain ⟨g, hg⟩ := germR_of_mem_G hf x
  exact ⟨g, germ_value RF_le_nhds f.continuous hg⟩

/-! ### Constructing elements of `G A` -/

theorem mobH_mem_G (g : Matrix.SpecialLinearGroup (Fin 2) A) : mobH g ∈ G A :=
  Monod.Dev.GMono.mem_G_of_isPiecewiseProj ⟨∅, by simp, fun _ _ => ⟨g, Eventually.of_forall fun _ => rfl⟩⟩

/-- Gluing a Möbius map on `s` with the identity off `s`. -/
theorem glue {q : Matrix.SpecialLinearGroup (Fin 2) A} {s : Set (OnePoint ℝ)}
    (B : Finset (OnePoint ℝ)) (hBP : (B : Set (OnePoint ℝ)) ⊆ P A)
    (hfr : frontier s ⊆ B) (hfix : ∀ b ∈ B, mob q b = b) (hinv : ∀ x, mob q x ∈ s ↔ x ∈ s) :
    ∃ f ∈ G A, (∀ x ∈ s, f x = mob q x) ∧ (∀ x ∉ s, f x = x) := by
  classical
  have hinv' : ∀ x, mob q⁻¹ x ∈ s ↔ x ∈ s := fun x => by
    rw [← hinv (mob q⁻¹ x), mob_mob_inv]
  let F : OnePoint ℝ ≃ₜ OnePoint ℝ :=
    { toFun := s.piecewise (mob q) id
      invFun := s.piecewise (mob q⁻¹) id
      left_inv := fun x => by
        by_cases hx : x ∈ s
        · rw [Set.piecewise_eq_of_mem _ _ _ hx, Set.piecewise_eq_of_mem _ _ _ ((hinv x).2 hx),
            mob_inv_mob]
        · rw [Set.piecewise_eq_of_notMem _ _ _ hx, id, Set.piecewise_eq_of_notMem _ _ _ hx, id]
      right_inv := fun x => by
        by_cases hx : x ∈ s
        · rw [Set.piecewise_eq_of_mem _ _ _ hx, Set.piecewise_eq_of_mem _ _ _ ((hinv' x).2 hx),
            mob_mob_inv]
        · rw [Set.piecewise_eq_of_notMem _ _ _ hx, id, Set.piecewise_eq_of_notMem _ _ _ hx, id]
      continuous_toFun := (continuous_mob q).piecewise
        (fun a ha => by rw [hfix a (hfr ha)]; rfl) continuous_id
      continuous_invFun := (continuous_mob q⁻¹).piecewise
        (fun a ha => by
          show mob q⁻¹ a = a
          conv_lhs => rw [← hfix a (hfr ha)]
          exact mob_inv_mob q a) continuous_id }
  have hF1 : ∀ x ∈ s, F x = mob q x := fun x hx => Set.piecewise_eq_of_mem _ _ _ hx
  have hF2 : ∀ x ∉ s, F x = x := fun x hx => Set.piecewise_eq_of_notMem _ _ _ hx
  refine ⟨F, Monod.Dev.GMono.mem_G_of_isPiecewiseProj ⟨B, hBP, fun x hx => ?_⟩, hF1, hF2⟩
  have hxf : x ∉ frontier s := fun h => hx (hfr h)
  by_cases hxs : x ∈ closure s
  · have hint : x ∈ interior s := by
      by_contra h; exact hxf ⟨hxs, h⟩
    exact ⟨q, Filter.mem_of_superset (isOpen_interior.mem_nhds hint)
      (fun y hy => hF1 y (interior_subset hy))⟩
  · have : (closure s)ᶜ ∈ 𝓝 x := isClosed_closure.isOpen_compl.mem_nhds hxs
    exact ⟨1, Filter.mem_of_superset this (fun y hy => by
      show F y = mob 1 y
      rw [hF2 y (fun h => hy (subset_closure h)), mob_one])⟩

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- the fixed-point quadratic of `g` -/
noncomputable def Qf (g : Matrix.SpecialLinearGroup (Fin 2) A) (t : ℝ) : ℝ :=
  ent g 1 0 * t ^ 2 + (ent g 1 1 - ent g 0 0) * t - ent g 0 1

lemma trace_ent (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    ((Matrix.trace (g : Matrix (Fin 2) (Fin 2) A) : A) : ℝ) = ent g 0 0 + ent g 1 1 := by
  rw [Matrix.trace_fin_two]; push_cast; rfl

lemma Qf_mob (g : Matrix.SpecialLinearGroup (Fin 2) A) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 ≠ 0) :
    Qf g ((ent g 0 0 * t + ent g 0 1) / (ent g 1 0 * t + ent g 1 1)) =
      Qf g t / (ent g 1 0 * t + ent g 1 1) ^ 2 := by
  have hdet := det_ent g
  unfold Qf
  rw [eq_div_iff (pow_ne_zero 2 ht)]
  field_simp
  linear_combination (ent g 1 0 * t ^ 2 + (ent g 1 1 - ent g 0 0) * t - ent g 0 1) * hdet

lemma Qf_pole (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) {t : ℝ}
    (ht : ent g 1 0 * t + ent g 1 1 = 0) : Qf g t = 1 / ent g 1 0 := by
  have hdet := det_ent g
  have htt : t = -ent g 1 1 / ent g 1 0 := by field_simp; linarith
  unfold Qf
  rw [htt]
  field_simp
  linear_combination hdet

lemma Qf_inf (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) :
    Qf g (ent g 0 0 / ent g 1 0) = 1 / ent g 1 0 := by
  have hdet := det_ent g
  unfold Qf
  field_simp
  linear_combination hdet

lemma mob_eq_self_of_Qf (g : Matrix.SpecialLinearGroup (Fin 2) A) (hc : ent g 1 0 ≠ 0) {t : ℝ}
    (hQ : Qf g t = 0) : mob g (t : OnePoint ℝ) = t := by
  have ht : ent g 1 0 * t + ent g 1 1 ≠ 0 := by
    intro h; rw [Qf_pole g hc h] at hQ; simp [hc] at hQ
  rw [mob_coe, if_neg ht, coe_eq_coe, div_eq_iff ht]
  unfold Qf at hQ
  linear_combination (-1 : ℝ) * hQ

section hyp

variable (g : Matrix.SpecialLinearGroup (Fin 2) A) (hyp : IsHyperbolic g) (hc : 0 < ent g 1 0)

lemma disc_pos (hyp : IsHyperbolic g) : 0 < (ent g 0 0 + ent g 1 1) ^ 2 - 4 := by
  unfold IsHyperbolic at hyp
  rw [trace_ent] at hyp
  have : (2:ℝ) ^ 2 < (ent g 0 0 + ent g 1 1) ^ 2 := by
    rw [← sq_abs (ent g 0 0 + ent g 1 1)]
    exact pow_lt_pow_left₀ hyp (by norm_num) (by norm_num)
  linarith

/-- the smaller fixed point -/
noncomputable def xi1 : ℝ :=
  ((ent g 0 0 - ent g 1 1) - Real.sqrt ((ent g 0 0 + ent g 1 1) ^ 2 - 4)) / (2 * ent g 1 0)

/-- the larger fixed point -/
noncomputable def xi2 : ℝ :=
  ((ent g 0 0 - ent g 1 1) + Real.sqrt ((ent g 0 0 + ent g 1 1) ^ 2 - 4)) / (2 * ent g 1 0)

include hyp hc in
lemma xi1_lt_xi2 : xi1 g < xi2 g := by
  unfold xi1 xi2
  have := Real.sqrt_pos.2 (disc_pos g hyp)
  apply div_lt_div_of_pos_right _ (by linarith)
  linarith

include hyp in
lemma Qf_eq (hc : ent g 1 0 ≠ 0) (t : ℝ) : Qf g t = ent g 1 0 * (t - xi1 g) * (t - xi2 g) := by
  have hdet := det_ent g
  have hs := Real.sq_sqrt (le_of_lt (disc_pos g hyp))
  unfold Qf xi1 xi2
  field_simp
  linear_combination hs + 4 * hdet

include hyp hc in
lemma Qf_nonpos_iff (t : ℝ) : Qf g t ≤ 0 ↔ t ∈ Icc (xi1 g) (xi2 g) := by
  rw [Qf_eq g hyp hc.ne', mem_Icc]
  have h12 := xi1_lt_xi2 g hyp hc
  constructor
  · intro h
    by_contra hn
    rw [not_and_or, not_le, not_le] at hn
    have : 0 < (t - xi1 g) * (t - xi2 g) := by
      rcases hn with hn | hn
      · exact mul_pos_of_neg_of_neg (by linarith) (by linarith)
      · exact mul_pos (by linarith) (by linarith)
    have := mul_pos hc this
    rw [← mul_assoc] at this
    linarith
  · rintro ⟨h1, h2⟩
    rw [mul_assoc]
    exact mul_nonpos_of_nonneg_of_nonpos hc.le (mul_nonpos_of_nonneg_of_nonpos (by linarith)
      (by linarith))

include hyp hc in
lemma Qf_xi1 : Qf g (xi1 g) = 0 := by rw [Qf_eq g hyp hc.ne']; ring

include hyp hc in
lemma Qf_xi2 : Qf g (xi2 g) = 0 := by rw [Qf_eq g hyp hc.ne']; ring

include hyp hc in
lemma xi_mem_P : ((xi1 g : ℝ) : OnePoint ℝ) ∈ P A ∧ ((xi2 g : ℝ) : OnePoint ℝ) ∈ P A :=
  ⟨⟨g, hyp, mob_eq_self_of_Qf g hc.ne' (Qf_xi1 g hyp hc)⟩,
    ⟨g, hyp, mob_eq_self_of_Qf g hc.ne' (Qf_xi2 g hyp hc)⟩⟩

lemma mem_image_coe_iff {S : Set ℝ} (t : ℝ) :
    ((t : OnePoint ℝ) ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' S) ↔ t ∈ S :=
  coe_injective.mem_set_image

lemma infty_notMem_image {S : Set ℝ} : (∞ : OnePoint ℝ) ∉ (fun y : ℝ => (y : OnePoint ℝ)) '' S :=
  infty_notMem_image_coe

/-- sign of `Qf` is `g`-invariant, in the form needed for gluing -/
lemma Qf_sign_invariant (hc : 0 < ent g 1 0) (Pr : ℝ → Prop) (hP : ∀ r s : ℝ, 0 < s → (Pr (r / s) ↔ Pr r))
    (hPc : ¬ Pr (1 / ent g 1 0)) (x : OnePoint ℝ) :
    (mob g x ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Pr (Qf g t)} ↔
      x ∈ (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Pr (Qf g t)}) := by
  cases x with
  | infty =>
    rw [mob_infty, if_neg hc.ne', mem_image_coe_iff]
    simp only [mem_setOf_eq, Qf_inf g hc.ne', hPc, false_iff]
    exact infty_notMem_image
  | coe t =>
    rw [mem_image_coe_iff, mob_coe]
    split_ifs with ht
    · simp only [mem_setOf_eq, Qf_pole g hc.ne' ht, hPc, iff_false]
      exact infty_notMem_image
    · rw [mem_image_coe_iff]
      simp only [mem_setOf_eq]
      rw [Qf_mob g ht]
      exact hP _ _ (by positivity)

include hyp hc in
/-- glue `g` on the complement of the closed interval between its fixed points -/
theorem glue_out : ∃ f ∈ G A, (∀ t : ℝ, 0 < Qf g t → f t = mob g t) ∧ f ∞ = mob g ∞ ∧
    (∀ t : ℝ, Qf g t ≤ 0 → f t = t) := by
  classical
  set K := (fun y : ℝ => (y : OnePoint ℝ)) '' {t | Qf g t ≤ 0} with hK
  have hKI : K = (fun y : ℝ => (y : OnePoint ℝ)) '' Icc (xi1 g) (xi2 g) := by
    rw [hK]; congr 1; ext t; exact Qf_nonpos_iff g hyp hc t
  have hfr : frontier Kᶜ ⊆ (({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ)) :
      Set (OnePoint ℝ)) := by
    intro x hx
    rw [frontier_compl, frontier, hKI] at hx
    have hopen : IsOpen ((fun y : ℝ => (y : OnePoint ℝ)) '' Ioo (xi1 g) (xi2 g)) :=
      isOpen_image_coe.2 isOpen_Ioo
    have hclosed : IsClosed ((fun y : ℝ => (y : OnePoint ℝ)) '' Icc (xi1 g) (xi2 g)) :=
      (isCompact_Icc.image continuous_coe).isClosed
    rw [hclosed.closure_eq] at hx
    have hsub := interior_maximal (image_mono Ioo_subset_Icc_self) hopen
    obtain ⟨t, ht, rfl⟩ := hx.1
    have h2 : t ∉ Ioo (xi1 g) (xi2 g) := fun h => hx.2 (hsub ⟨t, h, rfl⟩)
    simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff, mem_singleton_iff,
      coe_eq_coe]
    rw [mem_Icc] at ht; rw [mem_Ioo] at h2
    by_contra hn; push_neg at hn
    exact h2 ⟨lt_of_le_of_ne ht.1 (Ne.symm hn.1), lt_of_le_of_ne ht.2 hn.2⟩
  have hBP : ((({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ))) :
      Set (OnePoint ℝ)) ⊆ P A := by
    intro x hx
    simp only [Finset.coe_insert, Finset.coe_singleton, mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact (xi_mem_P g hyp hc).1
    · exact (xi_mem_P g hyp hc).2
  have hfix : ∀ b ∈ ({(xi1 g : OnePoint ℝ), (xi2 g : OnePoint ℝ)} : Finset (OnePoint ℝ)),
      mob g b = b := by
    intro b hb
    simp only [Finset.mem_insert, Finset.mem_singleton] at hb
    rcases hb with rfl | rfl
    · exact mob_eq_self_of_Qf g hc.ne' (Qf_xi1 g hyp hc)
    · exact mob_eq_self_of_Qf g hc.ne' (Qf_xi2 g hyp hc)
  have hinvK : ∀ x, mob g x ∈ K ↔ x ∈ K := Qf_sign_invariant g hc (fun r => r ≤ 0)
    (fun r s hs => by
      constructor
      · intro h; by_contra h'; push_neg at h'; have := div_pos h' hs; linarith
      · intro h; exact div_nonpos_of_nonpos_of_nonneg h hs.le)
    (by simp [hc])
  have hinv : ∀ x, mob g x ∈ Kᶜ ↔ x ∈ Kᶜ := fun x => not_congr (hinvK x)
  obtain ⟨f, hfG, hf1, hf2⟩ := glue _ hBP hfr hfix hinv
  refine ⟨f, hfG, fun t ht => hf1 _ ?_, hf1 _ infty_notMem_image,
    fun t ht => hf2 _ (fun h => h ⟨t, ht, rfl⟩)⟩
  rw [mem_compl_iff, mem_image_coe_iff]; simp only [mem_setOf_eq, not_le]; exact ht

end hyp

end Monod.Dev.Dyn
end

section
namespace Monod.Dev.Dyn

open OnePoint Filter Topology Set

variable {A : Subring ℝ}

/-- `-g`, which acts as `g` does -/
def negSL (g : Matrix.SpecialLinearGroup (Fin 2) A) : Matrix.SpecialLinearGroup (Fin 2) A :=
  ⟨-(g : Matrix (Fin 2) (Fin 2) A), by
    rw [Matrix.det_fin_two]
    have := g.2
    rw [Matrix.det_fin_two] at this
    simp only [Matrix.neg_apply]
    linear_combination this⟩

lemma ent_negSL (g : Matrix.SpecialLinearGroup (Fin 2) A) (i j : Fin 2) :
    ent (negSL g) i j = -ent g i j := by
  simp [ent, negSL]

lemma mob_negSL (g : Matrix.SpecialLinearGroup (Fin 2) A) (x : OnePoint ℝ) :
    mob (negSL g) x = mob g x := by
  cases x with
  | infty =>
    rw [mob_infty, mob_infty]
    simp only [ent_negSL, neg_eq_zero, neg_div_neg_eq]
  | coe t =>
    rw [mob_coe, mob_coe]
    simp only [ent_negSL]
    have h1 : -ent g 1 0 * t + -ent g 1 1 = -(ent g 1 0 * t + ent g 1 1) := by ring
    have h2 : -ent g 0 0 * t + -ent g 0 1 = -(ent g 0 0 * t + ent g 0 1) := by ring
    simp only [h1, h2, neg_eq_zero, neg_div_neg_eq]

/-- the matrix `g · (1 r; 0 1)` written out -/
def gT (g : Matrix.SpecialLinearGroup (Fin 2) A) (r : A) : Matrix.SpecialLinearGroup (Fin 2) A :=
  ⟨!![g 0 0, g 0 0 * r + g 0 1; g 1 0, g 1 0 * r + g 1 1], by
    rw [Matrix.det_fin_two_of]
    have := g.2
    rw [Matrix.det_fin_two] at this
    linear_combination this⟩

lemma ent_gT (g : Matrix.SpecialLinearGroup (Fin 2) A) (r : A) :
    ent (gT g r) 0 0 = ent g 0 0 ∧ ent (gT g r) 0 1 = ent g 0 0 * r + ent g 0 1 ∧
    ent (gT g r) 1 0 = ent g 1 0 ∧ ent (gT g r) 1 1 = ent g 1 0 * r + ent g 1 1 := by
  simp [ent, gT]

theorem prop9_part1 (p : ℝ) (g : Matrix.SpecialLinearGroup (Fin 2) A) :
    mob g (p : OnePoint ℝ) = ∞ ∨ ∃ h ∈ H A, h (p : OnePoint ℝ) = mob g p := by
  -- normalize so that `c ≥ 0`
  wlog hc0 : 0 ≤ ent g 1 0 generalizing g
  · have := this (negSL g) (by rw [ent_negSL]; linarith)
    simpa only [mob_negSL] using this
  by_cases hpole : ent g 1 0 * p + ent g 1 1 = 0
  · left; rw [mob_coe, if_pos hpole]
  right
  rcases hc0.lt_or_eq with hc | hc
  swap
  · refine ⟨mobH g, Subgroup.mem_inf.2 ⟨mobH_mem_G g, ?_⟩, rfl⟩
    show mob g ∞ = ∞
    rw [mob_infty, if_pos hc.symm]
  -- the generic case
  have hdet := det_ent g
  set a := ent g 0 0 with ha
  set b := ent g 0 1 with hb
  set c := ent g 1 0 with hcdef
  set d := ent g 1 1 with hd
  set v := (a * p + b) / (c * p + d) with hv
  have hgp : mob g (p : OnePoint ℝ) = v := by rw [mob_coe, if_neg hpole]
  have hs : c * v - a ≠ 0 := by
    have : c * v - a = -1 / (c * p + d) := by
      rw [hv]; field_simp; linear_combination (-1 : ℝ) * hdet
    rw [this]; exact div_ne_zero (by norm_num) hpole
  set Q0 := c * v ^ 2 + (d - a) * v - b with hQ0
  obtain ⟨N, hN⟩ := exists_nat_gt (max (|Q0| / |c * v - a|) ((|a + d| + 2) / c))
  have hN1 : |Q0| / |c * v - a| < N := lt_of_le_of_lt (le_max_left _ _) hN
  have hN2 : (|a + d| + 2) / c < N := lt_of_le_of_lt (le_max_right _ _) hN
  set rz : ℤ := if 0 < c * v - a then -(N : ℤ) else N with hrz
  set r : A := (rz : A) with hr
  have hrR : (r : ℝ) = rz := by rw [hr]; push_cast; rfl
  have hrs : (rz : ℝ) * (c * v - a) = -(N * |c * v - a|) := by
    rw [hrz]
    split_ifs with h
    · rw [abs_of_pos h]; push_cast; ring
    · rw [abs_of_neg (lt_of_le_of_ne (not_lt.1 h) hs)]; push_cast; ring
  have hrabs : |(rz : ℝ)| = N := by
    rw [hrz]; split_ifs <;> push_cast <;> simp
  obtain ⟨e00, e01, e10, e11⟩ := ent_gT g r
  set q0 := gT g r with hq0
  have hQv : Qf q0 v < 0 := by
    unfold Qf
    rw [e00, e01, e10, e11, hrR]
    have h1 : |Q0| < N * |c * v - a| := by
      rwa [div_lt_iff₀ (abs_pos.2 hs)] at hN1
    have h2 : c * v ^ 2 + (c * ↑rz + d - a) * v - (a * ↑rz + b) =
        Q0 + (rz : ℝ) * (c * v - a) := by rw [hQ0]; ring
    rw [← ha, ← hb, ← hcdef, ← hd, h2, hrs]
    linarith [le_abs_self Q0]
  have hyp : IsHyperbolic q0 := by
    unfold IsHyperbolic
    rw [trace_ent, e00, e11, hrR]
    have h1 : |a + d| + 2 < N * c := by rwa [div_lt_iff₀ hc] at hN2
    have h2 : |c * (rz : ℝ)| = N * c := by rw [abs_mul, hrabs, abs_of_pos hc, mul_comm]
    have h3 := abs_sub_abs_le_abs_sub (c * (rz : ℝ)) (-(a + d))
    rw [abs_neg, h2] at h3
    have h4 : c * (rz : ℝ) - -(a + d) = a + (c * rz + d) := by ring
    rw [h4] at h3
    rw [← ha, ← hcdef, ← hd]
    linarith
  have hcq : 0 < ent q0 1 0 := by rw [e10]; exact hc
  obtain ⟨f, hfG, -, hfinf, hfin⟩ := glue_out q0 hyp hcq
  have hfv : f v = v := hfin v hQv.le
  have hq0inf : mob q0 ∞ = mob g ∞ := by
    rw [mob_infty, mob_infty, e10, e00]
  refine ⟨f⁻¹ * mobH g, Subgroup.mem_inf.2 ⟨mul_mem (inv_mem hfG) (mobH_mem_G g), ?_⟩, ?_⟩
  · show f.symm (mob g ∞) = ∞
    rw [← hq0inf, ← hfinf, Homeomorph.symm_apply_apply]
  · show f.symm (mob g p) = mob g p
    rw [hgp]
    conv_lhs => rw [← hfv]
    exact f.symm_apply_apply _

theorem mob_mem_orbit_H' (A : Subring ℝ) :
    (∀ (p : ℝ) (g : Matrix.SpecialLinearGroup (Fin 2) A),
        mob g (p : OnePoint ℝ) = OnePoint.infty ∨ ∃ h ∈ H A, h (p : OnePoint ℝ) = mob g p) ∧
      ∀ p q : ℝ, (∃ g : Matrix.SpecialLinearGroup (Fin 2) A, mob g (p : OnePoint ℝ) = q) ↔
        ∃ h ∈ H A, h (p : OnePoint ℝ) = q := by
  refine ⟨prop9_part1, fun p q => ⟨?_, ?_⟩⟩
  · rintro ⟨g, hg⟩
    rcases prop9_part1 p g with h | ⟨h, hh, hhp⟩
    · rw [hg] at h; exact absurd h (coe_ne_infty q)
    · exact ⟨h, hh, hhp.trans hg⟩
  · rintro ⟨h, hh, hhp⟩
    obtain ⟨g, hg⟩ := orbit_of_mem_G (Subgroup.mem_inf.1 hh).1 (p : OnePoint ℝ)
    exact ⟨g, hg.symm.trans hhp⟩

end Monod.Dev.Dyn
end

