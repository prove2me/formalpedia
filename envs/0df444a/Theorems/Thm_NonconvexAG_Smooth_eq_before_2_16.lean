-- title:
--   §2.1, display before (2.16) — x^ag_k − x_k = Γ_k Σ_{τ≤k} ((λ_τ − β_τ)/Γ_τ) ∇Ψ(x^md_τ)
-- statement:
--   Let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$, using an arbitrary map $\nabla\Psi:\mathbb R^n\to\mathbb R^n$ in place of the gradient, and let $\Gamma_k$ be as in (2.6). Then for every $k\ge1$,
--   $$x^{ag}_k-x_k=\Gamma_k\sum_{\tau=1}^k\Big(\frac{\lambda_\tau-\beta_\tau}{\Gamma_\tau}\Big)\nabla\Psi(x^{md}_\tau).$$
--
--   The identity writes the gap between the two sequences of the AG method as a $\Gamma$-weighted combination of the past gradients; it is the input to the bound (2.17).
--
--   **Formalization Note** The identity is algebraic: it is stated for any map `g` (no smoothness of $\Psi$ is assumed), which includes the gradient of the paper.
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 6, §2.1, display before (2.16)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- The identity displayed before (2.16), p. 6. -/
theorem eq_before_2_16 {n : ℕ} (g : E n → E n) (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k →
      xagSeq g α β lam x0 k - xSeq g α β lam x0 k =
        Gamma α k • ∑ τ ∈ Finset.Icc 1 k, ((lam τ - β τ) / Gamma α τ) • g (xmdSeq g α β lam x0 τ) := by sorry

end NonconvexAG.Smooth
