variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- **The field-width loop.** -/
theorem gloopQ_sol_aux {cz : ℕ} (hcz : 1 ≤ cz) {jG : Fin Pp} {cont : IStmt HS Pp}
    (hj : tbl jG = gloopC cz jG cont) {P K D S ρ r w Z Mb Bz : ℕ} (hMb : zsz (Mb : ℤ) ≤ Bz)
    (hM : 2 * gBnd cz Z + Gv cz Z + 2 ≤ Mb)
    {f g : Fin HS → List ℤ} (hf : Clean0 f) (hg : Clean0 g) {cc : ℕ}
    (Cont : ∀ σ, DescR σ P K D S ρ r w → σ vG = some (Z : ℤ) → σ 11 = some (Gv cz Z : ℤ) →
      RunQ Isym tbl σ cont f g cc) :
    ∀ n σ, (DescR σ P K D S ρ r w ∧ σ vG = some (Z : ℤ) ∧ ∃ j : ℕ, σ 11 = some (j : ℤ) ∧
      σ 12 = some ((2 ^ j : ℕ) : ℤ) ∧ j + n = Gv cz Z) →
      RunQ Isym tbl σ (.call jG) f g (cc + (n + 1) * cLoopS 15 2 Bz) := by
  obtain ⟨hG1, hG2, hG3⟩ := Gv_spec cz Z hcz
  have hgb : gBnd cz Z = 4 * (Z + cz) * (Z + (cz + 2)) := by unfold gBnd; ring
  have hgb1 : 4 * (Z + cz) ≤ 4 * (Z + cz) * (Z + (cz + 2)) := Nat.le_mul_of_pos_right _ (by omega)
  have hgb2 : Z + (cz + 2) ≤ 4 * (Z + cz) * (Z + (cz + 2)) := Nat.le_mul_of_pos_left _ (by omega)
  have hcR : (gCond cz).RegsLt := by
    intro i hi
    simp only [gCond, gBndNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
      or_false, List.nil_append, List.append_nil] at hi
    rcases hi with rfl | rfl | rfl <;> decide
  have hcS : (gCond cz).size ≤ 15 := by simp [gCond, gBndNE, NE.size]
  have hnat : ∀ σ : Fin HS → Option ℤ, σ vG = some (Z : ℤ) → ∀ j : ℕ, σ 12 = some (j : ℤ) →
      NatR σ (gCond cz) := by
    intro σ hZ j h12
    refine natR_of [12, vG] (by
      intro i hi
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl
      exacts [⟨_, h12⟩, ⟨_, hZ⟩]) (by
      intro i hi
      simp only [gCond, gBndNE, NE.regs, List.mem_append, List.mem_singleton, List.not_mem_nil,
        or_false, List.nil_append, List.append_nil, List.mem_cons] at hi ⊢
      tauto)
  refine loopQS (Isym := Isym) (tbl := tbl) hj _ hMb hcR hcS
    (noRdN_of_B _ _ (by decide)) (by decide) hf hg ?_ ?_
  · rintro σ ⟨hd, hZ, j, h11, h12, hjn⟩
    have hjG : j = Gv cz Z := by omega
    subst hjG
    have hval : (gBndNE cz).val (vOf σ) = gBnd cz Z := by
      simp only [gBndNE, NE.val, vOf_eq hZ]; rw [hgb]
    have hv : (gCond cz).val (vOf σ) = 1 := by
      simp only [gCond, NE.val, hval, vOf_eq h12]; rw [if_neg (by omega)]
    refine ⟨hd.base.off 0 (by decide), fun i hi => ?_, ?_, by rw [hv]; norm_num, ?_⟩
    · exact hnat σ hZ _ h12 i hi
    · simp only [gCond, gBndNE, NE.OK, NE.val, vOf_eq hZ, vOf_eq h12]
      rw [hgb] at hM hG3
      repeat' apply And.intro
      all_goals first | omega | (split_ifs <;> (try simp only [NE.OK]) <;> omega) | nlinarith
    · rw [hv]
      exact Cont _ (hd.push _ (fun q hq => by simp only [List.mem_singleton] at hq; subst hq; (try dsimp only); decide))
        (by rw [σPush16_ne σ _ (by decide)]; exact hZ) (by rw [σPush16_ne σ _ (by decide)]; exact h11)
  · rintro n σ ⟨hd, hZ, j, h11, h12, hjn⟩
