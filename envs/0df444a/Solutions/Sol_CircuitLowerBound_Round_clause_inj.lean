open CircuitLowerBound
open ENP Groundwork
open CircuitLowerBound.Round
namespace CircuitLowerBound.Round
theorem _root_.solution {C C' : List (ℕ × Bool)} {r r' : List Bool} (h : C.flatMap encLit ++ false :: r = C'.flatMap encLit ++ false :: r') : C = C' ∧ r = r' := by
  induction C generalizing C' with
  | nil =>
    cases C' with
    | nil => simpa using h
    | cons l' C' => simp [encLit] at h
  | cons l C ih =>
    cases C' with
    | nil => simp [encLit] at h
    | cons l' C' =>
      simp only [List.flatMap_cons, encLit, List.cons_append, List.append_assoc, List.cons.injEq, true_and, List.nil_append] at h
      obtain ⟨a, b⟩ := replicate_inj h
      simp only [List.cons.injEq] at b
      obtain ⟨c, d⟩ := ih b.2
      exact ⟨by rw [c, Prod.ext a b.1], d⟩
end CircuitLowerBound.Round
