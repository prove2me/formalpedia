/-! ## The tangent of the family is the Lie derivative -/

theorem fderiv_eq_sum_pd {U : Set (Pt n)} (hU : IsOpen U) {f : Pt n → ℝ} (hf : ContDiffOn ℝ ∞ f U)
    {y : Pt n} (hy : y ∈ U) (v : Pt n) : fderiv ℝ f y v = ∑ e, v e * pd e f y := by
  have hv : v = ∑ e : Fin n, v e • (Pi.single e (1 : ℝ) : Pt n) := by
    ext m; simp [Finset.sum_apply, Pi.single_apply]
  conv_lhs => rw [hv]
  rw [map_sum]
  simp only [map_smul, smul_eq_mul]
  exact Finset.sum_congr rfl fun e _ => by rw [pd_eq_fderiv_of hU hf hy e]

theorem hasDerivAt_comp_shift {U : Set (Pt n)} (hU : IsOpen U) {f : Pt n → ℝ} (hf : ContDiffOn ℝ ∞ f U)
    (ξ : Fin n → Pt n → ℝ) {y : Pt n} (hy : y ∈ U) :
    HasDerivAt (fun ε => f (shiftMap ξ ε y)) (∑ e, ξ e y * pd e f y) 0 := by
  have h1 : HasDerivAt (fun ε => shiftMap ξ ε y) (fun k => ξ k y) 0 := by
    refine hasDerivAt_pi.mpr fun k => ?_
    simpa [shiftMap] using ((hasDerivAt_id (0 : ℝ)).mul_const (ξ k y)).const_add (y k)
  have hd : DifferentiableAt ℝ f y := differentiableAt_of_contDiffOn hU hf hy
  have h2 : HasFDerivAt f (fderiv ℝ f y) (shiftMap ξ 0 y) := by
    rw [shiftMap_zero]; exact hd.hasFDerivAt
  have h3 := HasFDerivAt.comp_hasDerivAt (x := (0 : ℝ)) (hl := h2) (hf := h1)
  rw [fderiv_eq_sum_pd hU hf hy] at h3
  exact h3

