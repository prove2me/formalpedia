          have hfull := EvalsToInTime.trans rationalRadiusMachine.step _ _ _ _ _ hfirst hrest
          have hbounded := rebound (newBudget := rationalRadiusScanBudget
              (true :: input) count)
            hfull (by
              simp [rationalRadiusScanBudget, pow_two]
              nlinarith)
          exact hbounded
