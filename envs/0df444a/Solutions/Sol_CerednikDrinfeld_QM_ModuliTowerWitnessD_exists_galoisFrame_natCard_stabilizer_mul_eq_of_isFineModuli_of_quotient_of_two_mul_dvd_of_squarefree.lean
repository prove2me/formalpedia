theorem GCAux.mem_of_rho0_eq_one
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hNsq : Squarefree N)
    (m : ℕ) (hmU : IsUnit ((m : ℕ) : (AlgebraicClosure ℚ)))
    (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (hMlft : LocallyOfFiniteType πM)
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM)
    (hM : IsFineModuli Λ N m M πM ptF)
    (G : Type) [Group G] [Finite G] (ρ : G →* Aut M) (χ : G → ↥Λ)
    (hρ : IsLevelTwistAction Λ N m M πM ptF G ρ χ)
    (ℓ' : ℕ) (hℓ : ℓ'.Prime) (hℓm : ℓ' ∣ m)
    (L₀ : Submodule ℤ ℍ[ℚ, a, b]) (hL₀ : L₀ ≤ Λ) (hℓL₀ : ∀ x : ↥Λ, (ℓ' : ℚ) • (x : ℍ[ℚ, a, b]) ∈ L₀)
    (hL₀_left : ∀ (y : ↥Λ) (x : ℍ[ℚ, a, b]), x ∈ L₀ → (y : ℍ[ℚ, a, b]) * x ∈ L₀)
    (hL₀_index : L₀.toAddSubgroup.relIndex Λ.toAddSubgroup = ℓ' ^ 2)
    (H : Subgroup G) (hH : ∀ g : G, g ∈ H ↔ ∀ x : ℍ[ℚ, a, b], x ∈ L₀ → x * (χ g : ℍ[ℚ, a, b]) ∈ L₀)

    (Xq : Scheme.{0}) (πXq : Xq ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))) (πq : M ⟶ Xq) (hπqX : πq ≫ πXq = πM)
    (ptq : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ))),
      FakeEllipticCurve Λ N S → SchemeHomOver s πXq)
    (hXq : IsCoarseModuli Λ N Xq πXq ptq)
    (hptq : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)))
      (u : FakeEllipticCurve.WithFullLevel Λ N m S), (ptq S s u.1).1 = (ptF S s u).1 ≫ πq)

    (C₀ : M.Opens) (G₀ : Subgroup G) (ρ₀ : G₀ →* Aut (C₀ : Scheme.{0}))
    (hρ₀ι : ∀ g : G₀, (ρ₀ g).hom ≫ C₀.ι = C₀.ι ≫ (ρ (g : G)).hom)
    (hsurj₀ : Function.Surjective (C₀.ι ≫ πq).base)
    (z : G₀) (hz : ρ₀ z = 1) :
    (z : G) ∈ H := by
  classical
  haveI : LocallyOfFiniteType πM := hMlft

  obtain ⟨Er, hrig⟩ := FakeEllipticCurve.exists_forall_hom_eq_id_or_mapPt_eq_inv_of_not_dvd_of_squarefree hqq' hB Λ hΛ N hqN hq'N hNsq
  let p := ptq (AlgebraicClosure ℚ) (𝟙 _) Er
  let g : (C₀ : Scheme.{0}) ⟶ Xq := C₀.ι ≫ πq

  obtain ⟨c, hc⟩ := hsurj₀ (p.1.base (IsLocalRing.closedPoint (AlgebraicClosure ℚ)))
  let T := CategoryTheory.Limits.pullback p.1 g
  obtain ⟨z₀, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := p.1) (g := g)
    (IsLocalRing.closedPoint (AlgebraicClosure ℚ)) c hc.symm
  haveI : Nonempty T := ⟨z₀⟩

  have hp1 : LocallyOfFiniteType (p.1 ≫ πXq) := by rw [p.2]; infer_instance
  haveI : LocallyOfFiniteType p.1 := locallyOfFiniteType_of_comp p.1 πXq
  let πT : T ⟶ Spec (CommRingCat.of (AlgebraicClosure ℚ)) := CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι ≫ πM
  haveI hπT : LocallyOfFiniteType πT := inferInstance
  haveI : JacobsonSpace T := LocallyOfFiniteType.jacobsonSpace πT
  obtain ⟨t, -, ht⟩ := (jacobsonSpace_iff_locallyClosed.mp ‹JacobsonSpace T›) Set.univ Set.univ_nonempty
    isClosed_univ.isLocallyClosed
  let τ : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ T := pointOfClosedPoint πT t ht
  have hτ : τ ≫ πT = 𝟙 _ := pointOfClosedPoint_comp πT t ht

  let ybar : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ M := τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι
  have hybar : ybar ≫ πM = 𝟙 _ := by
    show (τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι) ≫ πM = 𝟙 _
    simpa only [Category.assoc] using hτ
  have hfst : τ ≫ CategoryTheory.Limits.pullback.fst p.1 g = 𝟙 _ := by
    calc τ ≫ CategoryTheory.Limits.pullback.fst p.1 g
        = τ ≫ CategoryTheory.Limits.pullback.fst p.1 g ≫ (p.1 ≫ πXq) := by rw [p.2, Category.comp_id]
      _ = τ ≫ (CategoryTheory.Limits.pullback.fst p.1 g ≫ p.1) ≫ πXq := by simp only [Category.assoc]
      _ = τ ≫ (CategoryTheory.Limits.pullback.snd p.1 g ≫ g) ≫ πXq := by rw [CategoryTheory.Limits.pullback.condition]
      _ = τ ≫ πT := by simp only [g, πT, Category.assoc, hπqX]
      _ = 𝟙 _ := hτ
  obtain ⟨u, hu⟩ := hM.ptF_surjective (AlgebraicClosure ℚ) (𝟙 _) ⟨ybar, hybar⟩

  have hq : ptq (AlgebraicClosure ℚ) (𝟙 _) u.1 = p := by
    apply Subtype.ext
    rw [hptq, hu]
    show (τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι) ≫ πq = p.1
    calc (τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι) ≫ πq
        = τ ≫ (CategoryTheory.Limits.pullback.snd p.1 g ≫ g) := by simp only [g, Category.assoc]
      _ = τ ≫ (CategoryTheory.Limits.pullback.fst p.1 g ≫ p.1) := by rw [CategoryTheory.Limits.pullback.condition]
      _ = p.1 := by rw [← Category.assoc, hfst, Category.id_comp]
  have hiso : FakeEllipticCurve.Iso u.1 Er := hXq.pt_injective (AlgebraicClosure ℚ) (𝟙 _) u.1 Er hq
  have hrig_u := rigid_of_iso hiso hrig

  have hg : (ptF (AlgebraicClosure ℚ) (𝟙 _) u).1 ≫ (ρ (z : G)).hom = (ptF (AlgebraicClosure ℚ) (𝟙 _) u).1 := by
    rw [hu]
    show (τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι) ≫ (ρ (z : G)).hom = τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ C₀.ι
    simp only [Category.assoc]
    rw [← hρ₀ι z, hz]
    show τ ≫ CategoryTheory.Limits.pullback.snd p.1 g ≫ (Iso.refl _).hom ≫ C₀.ι = _
    rw [Iso.refl_hom, Category.id_comp]
  exact IsFineModuli.mem_of_ptF_comp_eq_of_rigid Λ hΛ N m hmU hM hρ ℓ' hℓ hℓm L₀ hL₀ hℓL₀ hL₀_left hL₀_index H hH
    (AlgebraicClosure ℚ) (𝟙 _) u hrig_u (z : G) hg

#print axioms GCAux.mem_of_rho0_eq_one

theorem GCAux.isFinite_of_isIntegralHom_of_isAffineHom
    {k : Type} [Field k] {M Xq : Scheme.{0}} (πM : M ⟶ Spec (CommRingCat.of k)) (hMlft : LocallyOfFiniteType πM)
    (πXq : Xq ⟶ Spec (CommRingCat.of k)) (πq : M ⟶ Xq) (hπqX : πq ≫ πXq = πM)
    (hintq : IsIntegralHom πq) (haffq : IsAffineHom πq) : IsFinite πq := by
  haveI : LocallyOfFiniteType (πq ≫ πXq) := by rw [hπqX]; exact hMlft
  haveI := locallyOfFiniteType_of_comp πq πXq
  rw [IsFinite.iff_isIntegralHom_and_locallyOfFiniteType]
  exact ⟨hintq, inferInstance⟩

