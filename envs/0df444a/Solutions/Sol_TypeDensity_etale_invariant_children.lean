    [∀ j, Algebra O (B j)] [∀ j, Module.Finite O (B j)] [∀ j, Module.Free O (B j)]
    [∀ j, Algebra (Oj j) (B j)] [∀ j, IsScalarTower O (Oj j) (B j)] (ψ : A →ₐ[O] ∀ j, B j)
    (hinj : Function.Injective ψ) (ℓ : ℕ)
    (hℓ : Module.length O ((∀ j, B j) ⧸ LinearMap.range ψ.toLinearMap) = ℓ) (σ : TypeDensity.FactorType)
    (hσ : TypeDensity.HasAlgebraType O A σ) :
    ∀ j, (TypeDensity.orderDefect (Oj j) (B j)).toNat ≤ (TypeDensity.orderDefect O A).toNat ∧
    (1 ≤ ℓ → (TypeDensity.orderDefect (Oj j) (B j)).toNat < (TypeDensity.orderDefect O A).toNat) := by
  have hA : TypeDensity.orderDefect O A ≠ ⊤ := TypeDensity.order_defect_ne_top_of_type O A σ hσ
  intro j
  have h₁ := TypeDensity.order_defect_le_of_tower O (Oj j) (δ j) (hrank j) pi hpi (hpiδ j) (B j)
  obtain ⟨h₂, _, h₃⟩ := TypeDensity.order_defect_child_le O A n B ψ hinj ℓ hℓ hA j
  refine ⟨ENat.toNat_le_toNat (h₁.trans h₂) hA, fun h ↦ ?_⟩
  have hlt := h₁.trans_lt (h₃ h)
  have hne := ne_top_of_lt hlt
  rw [← ENat.natCast_toNat_eq_self.2 hne, ← ENat.natCast_toNat_eq_self.2 hA] at hlt
  exact_mod_cast hlt
