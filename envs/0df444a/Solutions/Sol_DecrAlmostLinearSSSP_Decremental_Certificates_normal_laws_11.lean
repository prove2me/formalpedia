section s243
set_option autoImplicit false
set_option maxRecDepth 10000
namespace DecrAlmostLinearSSSP.Decremental.Native
open Structured
namespace ReportConsume
lemma fields_eval (s : Data) : Eval fields s 5 (fieldData s) := eval_sequence_atoms atoms s
lemma field_values (s : Data) (hz : s.natReg 56 = 0) :
    (fieldData s).natReg 212 = s.natReg 74+2*s.natReg 154+s.natReg 112 ∧
    (fieldData s).natReg 210 = s.natReg 92 ∧ (fieldData s).natReg 214 = s.natReg 12 := by
  simp [fieldData,atoms,Atom.effect,instructionEffect,data,Data.machine,hz,two_mul]
  omega
lemma setup_eval (i : Input) (hi : i.Valid) (B j start count : ℕ) (s : Data)
    (hB : s.natReg 74 = B) (hF : s.natReg 112 = bankFactor j) (hn : s.natReg 66 = i.n)
    (hstart : s.natReg 92 = start) (hcount : s.natReg 12 = count)
    (hz : s.natReg 56 = 0) (hrz : s.realReg 56 = 0) :
    ∃ cost t, Eval setup s cost t ∧
      cost ≤ (dispatchCharge ScaledCeiling.ceilingProgram.code+3)*(16*utilityDepth i.size+32)+9 ∧
      t.natReg 212 = B+bankFactor j*(2*i.n+1) ∧ t.natReg 210 = start ∧ t.natReg 214 = count ∧
      (∀ address, (∀ a, address ≠ s.natReg 48+2*a+1) →
        t.natMem address = s.natMem address ∧ t.realMem address = s.realMem address) := by
  have hnupper : (i.n : ℝ) ≤ (2 : ℝ)^utilityDepth i.size := by
    have hm : (i.n : ℝ) ≤ i.size := by exact_mod_cast hi.1
    have hm1 : (1 : ℝ) ≤ i.size := by exact_mod_cast (lt_of_lt_of_le (input_vertex_positive i) hi.1)
    have hh := utilityDepth_power i.size
    nlinarith
  obtain ⟨c,u,hu,hu154,hcost,hframe⟩ := ScaledCeiling.productNat_eval s 154 112 66 (utilityDepth i.size) hz hrz (by rwa [hn])
  have hun (k : ℕ) (hk : 10 ≤ k) (hev : Even k) (h154 : k ≠ 154) (h58 : k ≠ 58) : u.natReg k = s.natReg k :=
    hu.nat_frame (ScaledCeiling.productNat_nat_frame _ _ _ k hk hev h154 h58)
  have huz := (hun 56 (by omega) (by decide) (by omega) (by omega)).trans hz
