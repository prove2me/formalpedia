open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Minkowski
open ExactVacuumAtlas
open ExactVacuumAtlas.Minkowski
open ExactVacuumAtlas.Minkowski.R4
set_option maxHeartbeats 4000000
set_option linter.unusedSimpArgs false
theorem solution {x : Pt 4} (_hx : x ∈ domChart) :
    (jac x).transpose * metricMatrix (gCart 3) (toCart x) * jac x = metricMatrix gSph x := by
  have hθ := sin_sq_add_cos_sq (x 2)
  have hφ := sin_sq_add_cos_sq (x 3)
  rw [metricMatrix_gCart]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, jac, eta, metricMatrix, gSph, Matrix.diagonal] <;>
    first
    | ring1
    | linear_combination sin (x 2) ^ 2 * hφ + hθ
    | linear_combination (x 1) ^ 2 * cos (x 2) ^ 2 * hφ + (x 1) ^ 2 * hθ
    | linear_combination (x 1) ^ 2 * sin (x 2) ^ 2 * hφ
    | linear_combination (x 1) * sin (x 2) * cos (x 2) * hφ
