/-! ## Elementary bounds and regularity of `V` -/

theorem Vfun_eq_div {z : ℝ} (hz : z ≠ 0) : Vfun z = (z ^ 2 + 9) / z ^ 3 := by
  unfold Vfun; field_simp

/-- `V` is continuous on `[3, ∞)`. -/
theorem continuousOn_Vfun : ContinuousOn Vfun (Ici 3) := by
  have hq : ContinuousOn (fun z : ℝ => (z ^ 2 + 9) / z ^ 3) (Ici 3) := by
    apply ContinuousOn.div (by fun_prop) (by fun_prop)
    intro z hz
    have hz0 : (0:ℝ) < z := by linarith [mem_Ici.mp hz]
    positivity
  refine hq.congr ?_
  intro z hz
  exact Vfun_eq_div (show z ≠ 0 by linarith [mem_Ici.mp hz])

/-- `t ↦ t/(t-1)` is continuous on `[3, ∞)`. -/
theorem continuousOn_ratio : ContinuousOn (fun t : ℝ => t / (t - 1)) (Ici 3) := by
  apply ContinuousOn.div (by fun_prop) (by fun_prop)
  intro t ht
  have : (0:ℝ) < t - 1 := by linarith [mem_Ici.mp ht]
  exact this.ne'

