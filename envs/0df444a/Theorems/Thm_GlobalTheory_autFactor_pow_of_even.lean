variable {g : ℕ} {τ : Matrix (Fin g) (Fin g) ℂ} {a b : Fin g → ℝ}

theorem GlobalTheory.autFactor_pow_of_even (ha : ∀ i, a i = 0 ∨ a i = 1 / 2) (hb : ∀ i, b i = 0 ∨ b i = 1 / 2)
    {N : ℕ} (hN : Even N) (n n' : Fin g → ℤ) (z : Fin g → ℂ) :
    autFactor a b τ n n' z ^ N =
      eC (-(N : ℂ) * (ofIntVec n ⬝ᵥ (τ *ᵥ ofIntVec n) / 2 + ofIntVec n ⬝ᵥ z)) := by sorry
