/-- The product of the first four parameters is at most the product of all. -/
theorem oQ_le_prod (ps : List ℕ) : oQ ps ≤ (ps.map (· + 1)).prod := by
  rcases ps with _ | ⟨a, _ | ⟨b, _ | ⟨c, _ | ⟨e, rest⟩⟩⟩⟩
  · simp [oQ]
  · simp [oQ]
  · simp [oQ]
  · simp only [oQ, List.getD_cons_zero, List.getD_cons_succ, List.getD_nil, List.map_cons,
      List.map_nil, List.prod_cons, List.prod_nil, Nat.zero_add, Nat.mul_one]
    rw [Nat.mul_assoc]
  · have h1 : 1 ≤ (rest.map (· + 1)).prod := List.prod_pos fun x hx => by
      obtain ⟨y, -, rfl⟩ := List.mem_map.1 hx
      exact Nat.succ_pos y
    simp only [oQ, List.getD_cons_zero, List.getD_cons_succ, List.map_cons, List.prod_cons]
    calc (a + 1) * (b + 1) * (c + 1) * (e + 1)
          = (a + 1) * ((b + 1) * ((c + 1) * ((e + 1) * 1))) := by ring
      _ ≤ (a + 1) * ((b + 1) * ((c + 1) * ((e + 1) * (rest.map (· + 1)).prod))) := by gcongr

/-- `2^S Q^K` is a bound of the form `polyBound`. -/
theorem le_polyBound_of_oQ {z S K : ℕ} {ps : List ℕ} (h : z ≤ 2 ^ S * oQ ps ^ K) :
    z ≤ polyBound S K ps :=
  h.trans (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left (oQ_le_prod ps) K))

section bounds

variable {n U s p : ℕ}

private theorem one_le_Q4 : 1 ≤ Q4 n U s p :=
  Nat.one_le_iff_ne_zero.2 (by unfold Q4; positivity)

private theorem n_lt_Q4 : n + 1 ≤ Q4 n U s p := by
  unfold Q4
  calc n + 1 = (n + 1) * 1 * 1 * 1 := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem U_lt_Q4 : U + 1 ≤ Q4 n U s p := by
  unfold Q4
  calc U + 1 = 1 * (U + 1) * 1 * 1 := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem s_lt_Q4 : s + 1 ≤ Q4 n U s p := by
  unfold Q4
  calc s + 1 = 1 * 1 * (s + 1) * 1 := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem p_lt_Q4 : p + 1 ≤ Q4 n U s p := by
  unfold Q4
  calc p + 1 = 1 * 1 * 1 * (p + 1) := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem sp_lt_Q4 : (s + 1) * (p + 1) ≤ Q4 n U s p := by
  unfold Q4
  calc (s + 1) * (p + 1) = 1 * 1 * (s + 1) * (p + 1) := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem nsp_lt_Q4 : (n + 1) * ((s + 1) * (p + 1)) ≤ Q4 n U s p := by
  unfold Q4
  calc (n + 1) * ((s + 1) * (p + 1)) = (n + 1) * 1 * (s + 1) * (p + 1) := by ring
    _ ≤ _ := by gcongr <;> omega

private theorem pU_lt_Q4 : (p + 1) * (U + 1) ≤ Q4 n U s p := by
  unfold Q4
  calc (p + 1) * (U + 1) = 1 * (U + 1) * 1 * (p + 1) := by ring
    _ ≤ _ := by gcongr <;> omega

/-- The numbers of the oracle: at most `32 Q²`. -/
private theorem oWord_le : oWord n U s p ≤ 32 * Q4 n U s p ^ 2 := by
  have hQ := one_le_Q4 (n := n) (U := U) (s := s) (p := p)
  have hn := n_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hU := U_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hs := s_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hp := p_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hsp := sp_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hpU := pU_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  set Q := Q4 n U s p
  have hQQ : Q ≤ Q ^ 2 := by nlinarith
  have hnn : n * n ≤ Q ^ 2 := by nlinarith
  have hsp' : s * p ≤ Q := by nlinarith
  have hpU' : p * (4 * (U + 1)) ≤ 4 * Q := by nlinarith
  have hdiv : (n + s - 1) / s ≤ n + s := (Nat.div_le_self _ _).trans (by omega)
  have hblocks : (n + s - 1) / s * (2 * p) ≤ 2 * Q ^ 2 := by
    calc (n + s - 1) / s * (2 * p) ≤ (n + s) * (2 * p) := Nat.mul_le_mul_right _ hdiv
      _ ≤ (2 * Q) * (2 * Q) / 2 := by
          rw [Nat.le_div_iff_mul_le (by norm_num)]
          nlinarith
      _ ≤ 2 * Q ^ 2 := by
          rw [Nat.div_le_iff_le_mul_add_pred (by norm_num)]
          nlinarith
  unfold oWord
  omega

/-- The cells of the arrays of the oracle: at most `32 Q²`. -/
private theorem oLayout_le : oLayout n U s p ≤ 32 * Q4 n U s p ^ 2 := by
  have hQ := one_le_Q4 (n := n) (U := U) (s := s) (p := p)
  have hn := n_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hU := U_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hp := p_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hnsp := nsp_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  set Q := Q4 n U s p
  have hQQ : Q ≤ Q ^ 2 := by nlinarith
  have hnn : n * n ≤ Q ^ 2 := by nlinarith
  have hnsp' : n * (s * p) ≤ Q := by nlinarith
  have hbits : bitLen U ≤ U := Nat.size_le.2 Nat.lt_two_pow_self
  have hcap := oCap_le n p
  unfold oLayout
  omega

/-- The solver on an instance with `w ≤ n²`: its parameters are at most `Q⁴`. -/
private theorem solver_le {f : List ℕ → ℕ} {s₀ k₀ : ℕ} (hf : ∀ ps, f ps ≤ polyBound s₀ k₀ ps) :
    (Finset.range (oCap n p + 1)).sup (fun w => f [n, s * p, w]) ≤
      2 ^ s₀ * Q4 n U s p ^ (4 * k₀) := by
  refine Finset.sup_le fun w hw => (hf _).trans ?_
  have hw' : w ≤ n * n := (Nat.lt_succ_iff.1 (Finset.mem_range.1 hw)).trans (oCap_le n p)
  have hn := n_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  have hsp := sp_lt_Q4 (n := n) (U := U) (s := s) (p := p)
  set Q := Q4 n U s p
  simp only [polyBound, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
  refine Nat.mul_le_mul_left _ ?_
  rw [Nat.pow_mul]
  refine Nat.pow_le_pow_left ?_ k₀
  have h1 : s * p + 1 ≤ Q := by nlinarith
  have h2 : w + 1 ≤ Q * Q := by nlinarith
  calc (n + 1) * ((s * p + 1) * (w + 1)) ≤ Q * (Q * (Q * Q)) := by gcongr
    _ = Q ^ 4 := by ring

end bounds

/-- **The need of the oracle stays polynomial** if that of the solver does. -/
theorem oracleNeed_poly {need : List ℕ → Light.Need} (h : PolyNeedN need) :
    PolyNeedN (oracleNeed need) := by
  obtain ⟨s₀, k₀, hle⟩ := h
  refine ⟨s₀ + 6, 4 * k₀ + 2, fun ps => ?_⟩
  set n := ps.getD 0 0
  set U := ps.getD 1 0
  set s := ps.getD 2 0
  set p := ps.getD 3 0
  have hQ : Q4 n U s p = oQ ps := rfl
  have hQ1 := one_le_Q4 (n := n) (U := U) (s := s) (p := p)
  have hw := solver_le (n := n) (U := U) (s := s) (p := p) fun ps => (hle ps).1
  have hc := solver_le (n := n) (U := U) (s := s) (p := p) fun ps => (hle ps).2.1
  have hd := solver_le (n := n) (U := U) (s := s) (p := p) fun ps => (hle ps).2.2
  have hW := oWord_le (n := n) (U := U) (s := s) (p := p)
  have hL := oLayout_le (n := n) (U := U) (s := s) (p := p)
  set Q := Q4 n U s p
  have hK1 : Q ^ (4 * k₀) ≤ Q ^ (4 * k₀ + 2) := Nat.pow_le_pow_right hQ1 (by omega)
  have hK2 : Q ^ 2 ≤ Q ^ (4 * k₀ + 2) := Nat.pow_le_pow_right hQ1 (by omega)
  have hK0 : 1 ≤ Q ^ (4 * k₀ + 2) := Nat.one_le_pow _ _ hQ1
  have h2 : 2 ^ (s₀ + 6) = 64 * 2 ^ s₀ := by rw [pow_add]; ring
  have h1 : 1 ≤ 2 ^ s₀ := Nat.one_le_two_pow
  have key : ∀ A B : ℕ, A ≤ 32 * Q ^ 2 + 5 → B ≤ 2 ^ s₀ * Q ^ (4 * k₀) →
      A + B ≤ polyBound (s₀ + 6) (4 * k₀ + 2) ps := by
    intro A B hA hB
    refine le_polyBound_of_oQ ?_
    rw [← hQ, h2]
    have e1 : 2 ^ s₀ * Q ^ (4 * k₀) ≤ 2 ^ s₀ * Q ^ (4 * k₀ + 2) := Nat.mul_le_mul_left _ hK1
    have e2 : 32 * Q ^ 2 + 5 ≤ 37 * Q ^ (4 * k₀ + 2) := by omega
    have e3 : 37 * Q ^ (4 * k₀ + 2) ≤ 37 * 2 ^ s₀ * Q ^ (4 * k₀ + 2) := by
      rw [Nat.mul_assoc]
      exact Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_left _ (by omega))
    have e4 : 2 ^ s₀ * Q ^ (4 * k₀ + 2) + 37 * 2 ^ s₀ * Q ^ (4 * k₀ + 2) ≤
        64 * 2 ^ s₀ * Q ^ (4 * k₀ + 2) := by
      have : 2 ^ s₀ * Q ^ (4 * k₀ + 2) + 37 * 2 ^ s₀ * Q ^ (4 * k₀ + 2) =
          38 * (2 ^ s₀ * Q ^ (4 * k₀ + 2)) := by ring
      rw [this, Nat.mul_assoc]
      omega
    omega
  have ew : (oracleNeed need ps).word = oWord n U s p +
      (Finset.range (oCap n p + 1)).sup (fun w => (need [n, s * p, w]).word) := rfl
  have ec : (oracleNeed need ps).cells = oLayout n U s p +
      (Finset.range (oCap n p + 1)).sup (fun w => (need [n, s * p, w]).cells) + 1 := rfl
  have ed : (oracleNeed need ps).depth = 4 +
      (Finset.range (oCap n p + 1)).sup (fun w => (need [n, s * p, w]).depth) := rfl
  rw [ew, ec, ed]
  have hc' := key (oLayout n U s p + 1) _ (by omega) hc
  exact ⟨key _ _ (by omega) hw, by omega, key _ _ (by omega) hd⟩

/-- The time of the oracle at the parameters of an instance. -/
theorem oracleTime_eq (Tl : List ℕ → ℕ) (n U s p : ℕ) :
    oracleTime Tl [n, U, s, p] = oTimeAt Tl n U s p := rfl

/-- **The counting oracle (Lemma 4.1) as a host**: from an arbitrary solver of #Lop-AE-SparseTri,
the appended procedures `oracleProcs` make a solver of the counting oracle, procedure number
`|P| + 12`, with the time `oracleTime Tl` and the need `oracleNeed needl`; and the need stays
polynomially bounded. -/
theorem oracle_host :
    (∀ (P : Program) (pl : ℕ) (Tl : List ℕ → ℕ) (needl : List ℕ → Light.Need),
      SolvesN lopCountTask P pl Tl needl →
      SolvesN oracleTask (P ++ oracleProcs pl P.length) (P.length + 12) (oracleTime Tl)
        (oracleNeed needl)) ∧
    (∀ needl, PolyNeedN needl → PolyNeedN (oracleNeed needl)) :=
  ⟨fun _ _ _ _ h => oracle_solves h, fun _ h => oracleNeed_poly h⟩

end Light.Filter
end
end

