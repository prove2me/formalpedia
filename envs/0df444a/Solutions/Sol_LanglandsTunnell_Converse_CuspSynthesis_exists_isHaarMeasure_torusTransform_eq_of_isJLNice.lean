private theorem t0531 (S : Finset (HeightOneSpectrum (𝓞 K)))
    (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ) (χ : ↥(torusClass (K := K) S) →* ℂˣ)
