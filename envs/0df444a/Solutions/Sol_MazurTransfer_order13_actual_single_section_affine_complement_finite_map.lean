#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.parameterLocalizationEquiv_symm_x
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.parameterLocalizationEquiv_symm_y

end
