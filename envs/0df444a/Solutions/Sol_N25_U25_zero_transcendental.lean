theorem _root_.solution :
    Transcendental ℚ (show N25.Endgame.FQ from U25 0) := by
  have key : ∀ i j : Algebra ℚ N25.Endgame.FQ,
      @Transcendental ℚ N25.Endgame.FQ _ _ i (U25 0) →
        @Transcendental ℚ N25.Endgame.FQ _ _ j (U25 0) :=
