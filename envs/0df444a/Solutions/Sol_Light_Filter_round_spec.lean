                                                                                                                            |
                                                                                                                              (simp [] <;>
                                                                                                                                  first
                                                                                                                                  | omega
                                                                                                                                  | ((ring_nf); (omega)))))
      rw [← wrote_succ]
      simp [hz]
    · have hz : 0 < c j := by
        have : (c j : ℤ) ≠ 0 := by simpa [hcell] using h0
        omega
      refine Ends.skip ⟨by simp, ?_⟩
      rw [wrote_succ_of_eq (by rw [hact j hj]; simp [hz])]

end Light.Filter
end
end

