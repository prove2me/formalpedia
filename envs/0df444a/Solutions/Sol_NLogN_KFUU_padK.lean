theorem sufV_cons (S : Shape) {j : ℕ} (hj : j ≤ S.length) :
    sufV S j = (vol (S.drop j) : ℤ) :: sufV S (j + 1) := by
  unfold sufV
  rw [List.drop_eq_getElem_cons (by simp; omega)]
  simp

theorem sufV_len (S : Shape) : sufV S S.length = [1] := by
  rw [sufV_cons S le_rfl]; simp [sufV]

theorem vol_drop_succ (S : Shape) {j : ℕ} (hj : j < S.length) :
    vol (S.drop j) = S[j] * vol (S.drop (j + 1)) := by
  rw [List.drop_eq_getElem_cons hj, vol_cons]

theorem zl_length (S : Shape) : (NLogN.KFUU.zl S).length = S.length := by unfold NLogN.KFUU.zl; rw [List.length_map]

theorem mem_le_vol {S : Shape} (hS : ∀ a ∈ S, 1 ≤ a) {a : ℕ} (ha : a ∈ S) : a ≤ vol S := by
  induction S with
  | nil => simp at ha
  | cons b S ih =>
    rw [vol_cons]
    have h1 := one_le_vol S (fun x hx => hS x (by simp [hx]))
    have hb := hS b (by simp)
    rcases List.mem_cons.1 ha with rfl | ha
    · nlinarith
    · have := ih (fun x hx => hS x (by simp [hx])) ha; nlinarith

theorem vol_drop_le' {S : Shape} (hS : ∀ a ∈ S, 1 ≤ a) (k : ℕ) : vol (S.drop k) ≤ vol S := by
  conv_rhs => rw [← List.take_append_drop k S]
  rw [vol_append]
  have := one_le_vol (S.take k) (fun x hx => hS x (List.mem_of_mem_take hx))
  nlinarith

theorem bnd_zl {S : Shape} (hS : ∀ a ∈ S, 1 ≤ a) {Z : ℕ} (hZ : zsz ((vol S : ℕ) : ℤ) ≤ Z) :
    Bnd Z (NLogN.KFUU.zl S) := by
  intro x hx
  unfold NLogN.KFUU.zl at hx; rw [List.mem_map] at hx
  obtain ⟨a, ha, rfl⟩ := hx
  exact le_trans (zsz_natCast_le (mem_le_vol hS ha)) hZ

theorem bnd_rev {L : List ℤ} {Z : ℕ} (h : Bnd Z L) : Bnd Z L.reverse :=
  fun x hx => h x (List.mem_reverse.1 hx)

