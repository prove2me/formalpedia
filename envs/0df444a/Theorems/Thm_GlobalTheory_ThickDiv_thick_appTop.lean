theorem GlobalTheory.ThickDiv.thick_appTop {V : Type} [CommRing V] (I : Ideal V) (e : ℕ) (a : V) :
    (thick V I e).appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of V)).inv.hom a) =
      (Scheme.ΓSpecIso (CommRingCat.of (V ⧸ I ^ (e + 1)))).inv.hom (Ideal.Quotient.mk (I ^ (e + 1)) a) := by sorry
