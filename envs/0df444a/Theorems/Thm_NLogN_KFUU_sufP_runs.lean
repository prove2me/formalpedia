theorem NLogN.KFUU.sufP_runs {pM : Fin P} (hM : MulOK I iprog pM MS) {pS : Fin HS} (hpS : LS pS)
    (S : Shape) (Z : ℕ) (hS1 : ∀ a ∈ S, 1 ≤ a) (hVZ : zsz ((vol S : ℕ) : ℤ) ≤ Z)
    (t : IState HS) (RS RV LN : List Item) (hpS0 : t.G pS = ints (zl S).reverse ++ RS)
    (hV : t.G pV = .int 1 :: RV) (hN : t.G nR = .int (S.length : ℤ) :: LN) :
    IRuns I iprog (sufP pM pS) t
      (((t.upd pV (ints (sufV S 0) ++ RV)).upd pS RS).upd tS (ints (zl S) ++ t.G tS))
      ((S.length + 1) * (cU Z + 76 * Z + 3000)) := by sorry
