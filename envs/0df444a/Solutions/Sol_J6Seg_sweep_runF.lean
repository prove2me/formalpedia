-- Source module: Solutions.J6SegILSweep9
/-!
# B-line IL, B6: **`sweep_run`** (the sweep over the axes computes `pipeSweep`)

`swp σ dS dA eX = hdrA; swL; hdrC`: read the line descriptor `descLine6` on `dS` (header to
registers, bits counted, `T`), loop over the axes `k = 0..D` (axis descriptor `descAx6` on `dA`,
call `eX`), restore the descriptor (`hdrC`: move the used `s`'s and bits back, push
`d, h, α, p`, clear the registers).

**`sweep_run`**: on a state with `dS = descLine6 P n src` and every other managed stack except
`0` empty, with `ys` (length `∏ t`, `GB (p+2)`) on stack `0`, given `AxisBody6 … eX dA Cx` and the
list invariant of `pipe6`, `swp` leaves `gflat (pipeSweep (pipe6 P n src D) (D+1) ys) ++ l` on
stack `0`, everything else unchanged, at cost `(D+1)(Cx + 10^9 (B+2)^2) + 10^9 (B+2)^2 (D+2)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- **The sweep over the axes computes `pipeSweep`** (general axis step `pf`). -/
theorem sweep_runF_sol_aux {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp}
    {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
    {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {Cx : ℝ} {pf : ℕ → List GI → List GI}
    (hX : AxisBodyF P n src D pf Isym tbl eX dA Cx) (hCx : 0 ≤ Cx) (hD : dP6 P n = D + 1)
    (B : ℕ) (hb : SwB P n src D B)
    (Q : List GI → Prop) (hQ : ∀ L, Q L → L.length = TW P n D ∧ GB (pP6 P n + 2) L)
    (hpipe : ∀ k ≤ D, ∀ L : List GI, Q L → Q (pf k L))
    (s : IState HS) (f : Fin HS → List ℤ) (l : List ℤ)
    (hf : ∀ j, j ≠ 0 → j ≠ dS → f j = []) (hdesc : f dS = descLine6 P n src)
    (ys : List GI) (h0 : f 0 = gflat ys ++ l) (hys : Q ys) :
    ∃ c : ℕ, IRuns Isym tbl (swp σ dS dA eX) (encK s f)
        (encK s (update f 0 (gflat (pipeSweep (pf) (D + 1) ys) ++ l))) c ∧
      (c : ℝ) ≤ (D + 1) * (Cx + 10 ^ 9 * (B + 2) ^ 2) + 10 ^ 9 * (B + 2) ^ 2 * (D + 2) := by
  have hkB : D + 1 ≤ B := by have := hb.hB; omega
  have hreg : ∀ i, f (σ i) = [] := fun i => hf _ (hW.ne0 i) (hW.neS i)
  have hdl : descLine6 P n src = (pP6 P n : ℤ) :: (αN6 P n : ℤ) :: (hN6 P n : ℤ) ::
      ((bsW P n D).length : ℤ) :: (bsW P n D ++ svW src D) := by
    rw [bsW_len]; unfold descLine6 KFM.descLine bsW svW; rw [hD]
  have hf0 : f = SS σ dS f (gflat ys ++ l) (descLine6 P n src) (fun _ => []) := by
    conv_lhs => rw [← SS_self σ dS hW.inj f]
    rw [h0, hdesc]
    congr 1; funext i; exact hreg i
  -- header
  have A := (hdr_sp hW s f (gflat ys ++ l) (pP6 P n) (αN6 P n) (hN6 P n) (cntB P n (D + 1))
    (bsW P n D) (svW src D) B (by linarith [hb.two]) (bits01 _ _) (by rw [bsW, KFM.bitsZ_sum])
    hb.p hb.α (by rw [bsW_len]; exact hb.hB) (by have := hb.hB; nlinarith)
    (by rw [bsW_len, T_eq]; exact hb.T)).toIRuns
    (I := Isym) (iprog := tbl)
  rw [← hdl, ← hf0, bsW_len] at A
  have hv0 : vH (pP6 P n) (αN6 P n) (hN6 P n) (D + 1) (cntB P n (D + 1)) (bsW P n D) =
      vK P n src D 0 := by
    unfold vK
    have : preT P n D 0 = 1 := by simp [preT]
    rw [this]
    unfold vH
    ((funext i; fin_cases i <;> simp [Function.update_apply]))
  rw [hv0] at A
  -- the axes
  have L := swL_run hW hX hD B hb Q hQ hpipe s f ys l hys
  -- the descriptor back
  have C := (hdrC_sp hW P n src D B hb s f
    (gflat (pipeSweep (pf) (D + 1) ys) ++ l)).toIRuns (I := Isym) (iprog := tbl)
  have hdl' : (pP6 P n : ℤ) :: (αN6 P n : ℤ) :: (hN6 P n : ℤ) ::
      ((D + 1 : ℕ) : ℤ) :: (bsW P n D ++ svW src D) = descLine6 P n src := by
    rw [hdl, bsW_len]
  rw [hdl'] at C
  have hfin : SS σ dS f (gflat (pipeSweep (pf) (D + 1) ys) ++ l)
      (descLine6 P n src) (fun _ => []) =
      update f 0 (gflat (pipeSweep (pf) (D + 1) ys) ++ l) := by
    conv_rhs => rw [hf0]
    rw [SS_z hW]
  rw [hfin] at C
  refine ⟨_, A.seq (L.seq C), ?_⟩
  have hfl : (⌊Cx⌋₊ : ℝ) ≤ Cx := Nat.floor_le hCx
  have hN : cHdr B (D + 1) + (((1 + 1) * 2000 * (B + 2) + (D + 1) * (cAx ⌊Cx⌋₊ B +
      8000 * (B + 2) + 30) + (2 * B + 32)) + 10 ^ 6 * (B + 2) * (D + 2)) ≤
      (D + 1) * (⌊Cx⌋₊ + 10 ^ 9 * (B + 2) ^ 2) + 10 ^ 9 * (B + 2) ^ 2 * (D + 2) := by
    have hB2 := hb.two
    have e3 : B + 2 ≤ (B + 2) ^ 2 := Nat.le_self_pow two_ne_zero _
    have e2 : (B + 2) * D ≤ (B + 2) ^ 2 * D := Nat.mul_le_mul_right _ e3
    simp only [cHdr, cAx, cP1, cP2]
    generalize (B + 2) ^ 2 = Y at e2 e3 ⊢
    generalize ⌊Cx⌋₊ = K
    ring_nf at e2 e3 ⊢
    omega
  calc _ ≤ (((D + 1) * (⌊Cx⌋₊ + 10 ^ 9 * (B + 2) ^ 2) + 10 ^ 9 * (B + 2) ^ 2 * (D + 2) : ℕ) : ℝ) :=
        by exact_mod_cast hN
    _ ≤ _ := by push_cast; gcongr; all_goals norm_num

end J6Seg

