section GroupOnPoints

variable {T : Type} [CommRing T] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of T)}

@[reducible] noncomputable def pointGroup (G : RelativeGroupLaw T f) {S : Scheme.{0}} (t : S ⟶ Spec (CommRingCat.of T)) :
    Group (SchemeHomOver t f) :=
  letI : Mul (SchemeHomOver t f) := ⟨G.mul t⟩
  letI : One (SchemeHomOver t f) := ⟨G.one t⟩
  letI : Inv (SchemeHomOver t f) := ⟨G.inv t⟩
  Group.ofLeftAxioms (G.mul_assoc t) (G.one_mul t) (G.inv_mul_cancel t)

theorem nsmul_eq_pow (G : RelativeGroupLaw T f) {S : Scheme.{0}} (t : S ⟶ Spec (CommRingCat.of T))
    (n : ℕ) (x : SchemeHomOver t f) :
    letI := pointGroup G t
    G.nsmul t n x = x ^ n := by
  letI := pointGroup G t
  induction n with
  | zero => rw [RelativeGroupLaw.nsmul_zero, pow_zero]; rfl
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, pow_succ, ih]; rfl

theorem zsmulSection_eq_zpow {W : WeierstrassCurve.Projective T} (G : RelativeGroupLaw T (projModelStrCR W))
    (a : ℤ) (x : Section W) :
    letI := pointGroup G (𝟙 (base (T := T)))
    zsmulSection G a x = x ^ a := by
  letI := pointGroup G (𝟙 (base (T := T)))
  cases a with
  | ofNat k =>
    show G.nsmul _ k x = x ^ (Int.ofNat k)
    rw [Int.ofNat_eq_natCast, zpow_natCast, nsmul_eq_pow]
  | negSucc k =>
    show G.inv _ (G.nsmul _ (k + 1) x) = x ^ (Int.negSucc k)
    rw [zpow_negSucc, nsmul_eq_pow]; rfl

theorem comp_mul (G : RelativeGroupLaw T f) {S S' : Scheme.{0}} (t : S ⟶ Spec (CommRingCat.of T))
    (t' : S' ⟶ Spec (CommRingCat.of T)) (ψ : S' ⟶ S) (hψ : ψ ≫ t = t') (x y : SchemeHomOver t f) :
    letI := pointGroup G t; letI := pointGroup G t'
    schemeHomOverComp ψ hψ (x * y) = schemeHomOverComp ψ hψ x * schemeHomOverComp ψ hψ y :=
  G.mul_natural t t' ψ hψ x y

theorem comp_one (G : RelativeGroupLaw T f) {S S' : Scheme.{0}} (t : S ⟶ Spec (CommRingCat.of T))
    (t' : S' ⟶ Spec (CommRingCat.of T)) (ψ : S' ⟶ S) (hψ : ψ ≫ t = t') :
    letI := pointGroup G t; letI := pointGroup G t'
    schemeHomOverComp ψ hψ (1 : SchemeHomOver t f) = 1 :=
  G.one_natural t t' ψ hψ

noncomputable def compHom (G : RelativeGroupLaw T f) {S S' : Scheme.{0}} (t : S ⟶ Spec (CommRingCat.of T))
    (t' : S' ⟶ Spec (CommRingCat.of T)) (ψ : S' ⟶ S) (hψ : ψ ≫ t = t') :
    letI := pointGroup G t; letI := pointGroup G t'
    SchemeHomOver t f →* SchemeHomOver t' f :=
  letI := pointGroup G t; letI := pointGroup G t'
  { toFun := schemeHomOverComp ψ hψ, map_one' := comp_one G t t' ψ hψ, map_mul' := comp_mul G t t' ψ hψ }

end GroupOnPoints

theorem comp_eq_comp_kwZeroSect_of_zlinComb {T Ω : Type} [CommRing T] [CommRing Ω] (W : WeierstrassCurve T)
    (G : RelativeGroupLaw T (projModelStrCR W.toProjective))
    (hone : (G.one (𝟙 _)).1 = (kwZeroSect T W).1)
    (q : ℕ) (P Q : Section W.toProjective)
    (hP : G.nsmul (𝟙 _) q P = G.one (𝟙 _)) (hQ : G.nsmul (𝟙 _) q Q = G.one (𝟙 _))
    (a b : ℤ) (ha : (q : ℤ) ∣ a) (hb : IsCoprime b (q : ℤ))
    (f : T →+* Ω)
    (h : Spec.map (CommRingCat.ofHom f) ≫ (zlinComb G P Q a b).1 =
      Spec.map (CommRingCat.ofHom f) ≫ (kwZeroSect T W).1) :
    Spec.map (CommRingCat.ofHom f) ≫ Q.1 = Spec.map (CommRingCat.ofHom f) ≫ (kwZeroSect T W).1 := by

  have hψ : Spec.map (CommRingCat.ofHom f) ≫ 𝟙 (base (T := T)) = Spec.map (CommRingCat.ofHom f) :=
    Category.comp_id _
  letI iT := pointGroup G (𝟙 (base (T := T)))
  letI iΩ := pointGroup G (Spec.map (CommRingCat.ofHom f))
  let c := compHom G (𝟙 (base (T := T))) (Spec.map (CommRingCat.ofHom f)) (Spec.map (CommRingCat.ofHom f)) hψ
  have hc : ∀ x : Section W.toProjective, (c x).1 = Spec.map (CommRingCat.ofHom f) ≫ x.1 := fun _ => rfl
  have hc1 : ((1 : SchemeHomOver (Spec.map (CommRingCat.ofHom f)) (projModelStrCR W.toProjective))).1 =
      Spec.map (CommRingCat.ofHom f) ≫ (kwZeroSect T W).1 := by
    rw [← hone]; exact (congrArg Subtype.val (comp_one G (𝟙 (base (T := T))) _ _ hψ)).symm

  have hPq : c P ^ (q : ℤ) = 1 := by
    rw [zpow_natCast, ← map_pow, ← nsmul_eq_pow, hP]; exact comp_one G _ _ _ hψ
  have hQq : c Q ^ (q : ℤ) = 1 := by
    rw [zpow_natCast, ← map_pow, ← nsmul_eq_pow, hQ]; exact comp_one G _ _ _ hψ

  have hcomb : c P ^ a * c Q ^ b = 1 := by
    have e : zlinComb G P Q a b = P ^ a * Q ^ b := by
      show G.mul _ (zsmulSection G a P) (zsmulSection G b Q) = _
      rw [zsmulSection_eq_zpow, zsmulSection_eq_zpow]; rfl
    apply Subtype.ext
    rw [← map_zpow, ← map_zpow, ← map_mul, ← e, hc1]
    exact h
  have hQ1 : c Q = 1 := RelabelQZeroAux.eq_one_of_zpow_mul_zpow_eq_one (c P) (c Q) q a b hPq hQq ha hb hcomb
  have := congrArg Subtype.val hQ1
  rw [hc1] at this
  exact this

end TD1ConnAux

