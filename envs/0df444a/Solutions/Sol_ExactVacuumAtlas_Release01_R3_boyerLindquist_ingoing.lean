/-!
# R3: Boyer–Lindquist ↔ ingoing Kerr on the overlap `Δ ≠ 0`

Visser, arXiv:0706.0622, eqs. (E:BL-change-1)–(E:BL-change-3): starting from the ingoing form
(E:K1) with coordinates `(u, r, θ, φ)`,
`u = t + r`, `t = t_BL + 2M ∫ r dr/Δ`, `φ = −φ_BL − a ∫ dr/Δ`, `r = r_BL`, `θ = θ_BL`,
gives the Boyer–Lindquist line element (our `KerrBL.gKerr`). Hence the map BL → ingoing is

  `toIn x = (t + r + H₁(r), r, θ, −φ − H₂(r))`, `H₁' = 2Mr/Δ`, `H₂' = a/Δ`,

with inverse `fromIn y = (v − r − H₁(r), r, θ, −φ̃ − H₂(r))`. The Jacobian is
`∂v/∂r = 1 + 2Mr/Δ = (r² + a²)/Δ`, `∂φ̃/∂r = −a/Δ`, `∂φ̃/∂φ = −1`.

**Generic part** (this file, section `Generic`): for *any* `H₁ H₂ : ℝ → ℝ` with those derivatives
on `{Δ ≠ 0}` and `C^∞` there, all R3 obligations hold: `C^∞` both ways, bijection of `domBL`
onto itself, Jacobian entries are genuine derivatives, and `jacᵀ · (gIn ∘ toIn) · jac = gKerr`.

**Reading note.** `gIn` depends only on `(r, θ)`, which `toIn` fixes, and `jac` is an explicit matrix, so
the identity `pullback` alone does not involve `H₁ H₂`; it certifies the map only *together with*
`hasDerivAt_pd_toIn` / `pd_toIn`, which prove that `jac` is the genuine Jacobian of `toIn` (this is where
`H₁' = 2Mr/Δ`, `H₂' = a/Δ` enter). Cite the pair. `φ ∼ φ + 2π` is not modelled (`φ, φ̃ ∈ ℝ`).

**Concrete part** (section `Branches`): explicit `H₁`, `H₂` for the three parameter branches
`M² > a²` (two real roots, logarithms), `M² = a²` (double root, rational `K`; `H₁` keeps its `M log|Δ|`
term) and `M² < a²` (no real root, arctan), each with its derivative proved; then the generic result is instantiated. These
are parameter sub-rows of R3, not a reduction of its scope.
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Kerr

namespace ExactVacuumAtlas.Kerr.R3

theorem Delta_eq_Del (M a r : ℝ) : Delta M a r = KerrBL.Del M a r := by unfold Delta KerrBL.Del; ring

theorem Delta_ne_of_mem {M a : ℝ} {x : Pt 4} (hx : x ∈ domBL M a) : Delta M a (x 1) ≠ 0 := by
  rw [Delta_eq_Del]; exact domBL_Del hx

section Generic

variable (M a : ℝ) (H₁ H₂ : ℝ → ℝ)

@[simp] theorem toIn_0 (x : Pt 4) : toIn H₁ H₂ x 0 = x 0 + x 1 + H₁ (x 1) := rfl
@[simp] theorem toIn_1 (x : Pt 4) : toIn H₁ H₂ x 1 = x 1 := rfl
@[simp] theorem toIn_2 (x : Pt 4) : toIn H₁ H₂ x 2 = x 2 := rfl
@[simp] theorem toIn_3 (x : Pt 4) : toIn H₁ H₂ x 3 = -(x 3) - H₂ (x 1) := rfl
@[simp] theorem fromIn_0 (y : Pt 4) : fromIn H₁ H₂ y 0 = y 0 - y 1 - H₁ (y 1) := rfl
@[simp] theorem fromIn_1 (y : Pt 4) : fromIn H₁ H₂ y 1 = y 1 := rfl
@[simp] theorem fromIn_2 (y : Pt 4) : fromIn H₁ H₂ y 2 = y 2 := rfl
@[simp] theorem fromIn_3 (y : Pt 4) : fromIn H₁ H₂ y 3 = -(y 3) - H₂ (y 1) := rfl

theorem fromIn_toIn (x : Pt 4) : fromIn H₁ H₂ (toIn H₁ H₂ x) = x := by
  funext i; fin_cases i <;> (simp; try ring)

theorem toIn_fromIn (y : Pt 4) : toIn H₁ H₂ (fromIn H₁ H₂ y) = y := by
  funext i; fin_cases i <;> (simp; try ring)

theorem toIn_mem {x : Pt 4} (hx : x ∈ domBL M a) : toIn H₁ H₂ x ∈ domBL M a := by
  simpa [domBL] using hx

theorem fromIn_mem {y : Pt 4} (hy : y ∈ domBL M a) : fromIn H₁ H₂ y ∈ domBL M a := by
  simpa [domBL] using hy

theorem bijOn_toIn : Set.BijOn (toIn H₁ H₂) (domBL M a) (domBL M a) :=
  Set.InvOn.bijOn ⟨fun x _ => fromIn_toIn H₁ H₂ x, fun y _ => toIn_fromIn H₁ H₂ y⟩
    (fun _ hx => toIn_mem M a H₁ H₂ hx) (fun _ hy => fromIn_mem M a H₁ H₂ hy)

theorem isOpen_radDom : IsOpen (radDom M a) := by
  unfold radDom Delta
  exact isOpen_ne_fun (by fun_prop) continuous_const

theorem mem_radDom_of_mem {x : Pt 4} (hx : x ∈ domBL M a) : x 1 ∈ radDom M a := Delta_ne_of_mem hx

variable (h₁ : ContDiffOn ℝ ∞ H₁ (radDom M a)) (h₂ : ContDiffOn ℝ ∞ H₂ (radDom M a))
include h₁ h₂

theorem contDiffOn_fromIn : ContDiffOn ℝ ∞ (fromIn H₁ H₂) (domBL M a) := by
  rw [contDiffOn_pi]; intro i
  have hp1 : ContDiffOn ℝ ∞ (fun x : Pt 4 => x 1) (domBL M a) := contDiffOn_pi.mp contDiffOn_id 1
  have hH₁ : ContDiffOn ℝ ∞ (fun x : Pt 4 => H₁ (x 1)) (domBL M a) :=
    h₁.comp hp1 (fun x hx => mem_radDom_of_mem M a hx)
  have hH₂ : ContDiffOn ℝ ∞ (fun x : Pt 4 => H₂ (x 1)) (domBL M a) :=
    h₂.comp hp1 (fun x hx => mem_radDom_of_mem M a hx)
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, fromIn_0,
    fromIn_1, fromIn_2, fromIn_3]
  · exact ((contDiffOn_pi.mp contDiffOn_id 0).sub hp1).sub hH₁
  · exact hp1
  · exact contDiffOn_pi.mp contDiffOn_id 2
  · exact (contDiffOn_pi.mp contDiffOn_id 3).neg.sub hH₂

omit h₁ h₂

theorem jac_01 (x : Pt 4) : jac M a x 0 1 = (x 1 ^ 2 + a ^ 2) / Delta M a (x 1) := rfl
theorem jac_31 (x : Pt 4) : jac M a x 3 1 = -a / Delta M a (x 1) := rfl

variable (d₁ : ∀ r ∈ radDom M a, HasDerivAt H₁ (2 * M * r / Delta M a r) r)
variable (d₂ : ∀ r ∈ radDom M a, HasDerivAt H₂ (a / Delta M a r) r)
include d₁

theorem hasDerivAt_toIn_0_r {x : Pt 4} (hx : x ∈ domBL M a) :
    HasDerivAt (fun u => toIn H₁ H₂ (Function.update x 1 u) 0) (jac M a x 0 1) (x 1) := by
  have hD := Delta_ne_of_mem hx
  have h := ((hasDerivAt_id' (x 1)).add (d₁ (x 1) (mem_radDom_of_mem M a hx))).const_add (x 0)
  have e : (fun u => toIn H₁ H₂ (Function.update x 1 u) 0) = fun u => x 0 + (u + H₁ u) := by
    funext u; simp [Function.update_apply]; ring
  rw [e, jac_01]
  refine h.congr_deriv ?_
  rw [eq_div_iff hD, add_mul, one_mul, div_mul_cancel₀ _ hD]; unfold Delta; ring

omit d₁
include d₂

theorem hasDerivAt_toIn_3_r {x : Pt 4} (hx : x ∈ domBL M a) :
    HasDerivAt (fun u => toIn H₁ H₂ (Function.update x 1 u) 3) (jac M a x 3 1) (x 1) := by
  have h := ((d₂ (x 1) (mem_radDom_of_mem M a hx)).const_sub (-(x 3)))
  have e : (fun u => toIn H₁ H₂ (Function.update x 1 u) 3) = fun u => -(x 3) - H₂ u := by
    funext u; simp [Function.update_apply]
  rw [e, jac_31]
  exact h.congr_deriv (by ring)

omit d₂
include d₁ d₂

/-- All sixteen Jacobian entries are the `pd` partial derivatives of the components of `toIn`. -/
theorem pd_toIn {x : Pt 4} (hx : x ∈ domBL M a) (k i : Fin 4) :
    pd i (fun y => toIn H₁ H₂ y k) x = jac M a x k i := by
  fin_cases k <;> fin_cases i <;>
    first
    | exact (hasDerivAt_toIn_0_r M a H₁ H₂ d₁ hx).deriv
    | exact (hasDerivAt_toIn_3_r M a H₁ H₂ d₂ hx).deriv
    | simp [pd, jac, Function.update_apply, toIn]

include h₁ h₂ in
/-- No junk derivatives: each component of `toIn` has the Jacobian entry as genuine derivative. -/
theorem hasDerivAt_pd_toIn {x : Pt 4} (hx : x ∈ domBL M a) (k i : Fin 4) :
    HasDerivAt (fun u => toIn H₁ H₂ (Function.update x i u) k) (jac M a x k i) (x i) := by
  rw [← pd_toIn M a H₁ H₂ d₁ d₂ hx k i]
  have hc : ContDiffOn ℝ ∞ (fun y => toIn H₁ H₂ y k) (domBL M a) :=
    (contDiffOn_pi.mp (contDiffOn_toIn M a H₁ H₂ h₁ h₂)) k
  exact hasDerivAt_pd (isOpen_domBL M a) hc hx i

omit d₁ d₂

end Generic

/-! ## Concrete antiderivatives `K` with `K' = 1/Δ`, by parameter branch -/
section Branches

variable (M a : ℝ)

theorem contDiffOn_K : ContDiffOn ℝ ∞ (K M a) (radDom M a) := by
  rw [contDiffOn_infty_iff_deriv_of_isOpen (isOpen_radDom M a)]
  refine ⟨fun r hr => (hasDerivAt_K M a hr).differentiableAt.differentiableWithinAt, ?_⟩
  have e : Set.EqOn (deriv (K M a)) (fun r => 1 / Delta M a r) (radDom M a) :=
    fun r hr => (hasDerivAt_K M a hr).deriv
  refine ContDiffOn.congr ?_ e
  unfold Delta
  fun_prop (disch := (intro r hr; exact hr))

theorem hasDerivAt_H1 {r : ℝ} (hr : r ∈ radDom M a) :
    HasDerivAt (H1 M a) (2 * M * r / Delta M a r) r := by
  have hΔ : Delta M a r ≠ 0 := hr
  have dΔ : HasDerivAt (fun u => Delta M a u) (2 * r - 2 * M) r := by
    unfold Delta
    have := (((hasDerivAt_pow 2 r).sub ((hasDerivAt_id' r).const_mul (2 * M))).add_const (a ^ 2))
    refine this.congr_deriv ?_; push_cast; ring
  have dl : HasDerivAt (fun u => log (Delta M a u)) ((2 * r - 2 * M) / Delta M a r) r := dΔ.log hΔ
  have := (dl.const_mul M).add ((hasDerivAt_K M a hr).const_mul (2 * M ^ 2))
  unfold H1
  refine this.congr_deriv ?_
  unfold Delta at hΔ ⊢; field_simp; ring

theorem hasDerivAt_H2 {r : ℝ} (hr : r ∈ radDom M a) :
    HasDerivAt (H2 M a) (a / Delta M a r) r := by
  have := (hasDerivAt_K M a hr).const_mul a
  unfold H2
  refine this.congr_deriv ?_
  ring

theorem contDiffOn_H1 : ContDiffOn ℝ ∞ (H1 M a) (radDom M a) := by
  unfold H1
  have hl : ContDiffOn ℝ ∞ (fun r => log (Delta M a r)) (radDom M a) := by
    refine ContDiffOn.log ?_ (fun r hr => hr)
    unfold Delta; fun_prop
  exact (hl.const_smul M).add ((contDiffOn_K M a).const_smul (2 * M ^ 2))

theorem contDiffOn_H2 : ContDiffOn ℝ ∞ (H2 M a) (radDom M a) := by
  unfold H2
  exact (contDiffOn_K M a).const_smul a

/-! ## R3 instantiated with the explicit `H₁`, `H₂` (all real `M`, `a`) -/

theorem bijOn : Set.BijOn (toIn (H1 M a) (H2 M a)) (domBL M a) (domBL M a) :=
  bijOn_toIn M a _ _

theorem contDiffOn_toIn_prime : ContDiffOn ℝ ∞ (toIn (H1 M a) (H2 M a)) (domBL M a) :=
  contDiffOn_toIn M a _ _ (contDiffOn_H1 M a) (contDiffOn_H2 M a)

theorem contDiffOn_fromIn_prime : ContDiffOn ℝ ∞ (fromIn (H1 M a) (H2 M a)) (domBL M a) :=
  contDiffOn_fromIn M a _ _ (contDiffOn_H1 M a) (contDiffOn_H2 M a)

theorem hasDerivAt_pd_toIn_prime {x : Pt 4} (hx : x ∈ domBL M a) (k i : Fin 4) :
    HasDerivAt (fun u => toIn (H1 M a) (H2 M a) (Function.update x i u) k) (jac M a x k i) (x i) :=
  hasDerivAt_pd_toIn M a _ _ (contDiffOn_H1 M a) (contDiffOn_H2 M a)
    (fun r hr => hasDerivAt_H1 M a hr) (fun r hr => hasDerivAt_H2 M a hr) hx k i

theorem pullback_prime {x : Pt 4} (hx : x ∈ domBL M a) :
    (jac M a x).transpose * metricMatrix (In.gIn M a) (toIn (H1 M a) (H2 M a) x) * jac M a x =
      metricMatrix (KerrBL.gKerr M a) x :=
  pullback M a _ _ hx

end Branches

end ExactVacuumAtlas.Kerr.R3

