namespace StableVotingDistortion.PaperBox
open Set MeasureTheory
noncomputable section
set_option maxRecDepth 100000
def potential (lam : ℝ) (φ : ℝ → ℝ) (r y : ℝ) : ℝ :=
  if y ≤ lam then 0 else lam-y-r*φ y
def correction (lam : ℝ) (φ : ℝ → ℝ) (a b x : ℝ) : ℝ :=
  max (a * (lam-x) + b * φ x) 0
def lowFirst (lam : ℝ) (φ : ℝ → ℝ) (β a b p q x : ℝ) : ℝ :=
  q + β * deltaP φ p q + correction lam φ a b x - lam
def highSecond (lam : ℝ) (φ : ℝ → ℝ) (β a b p q z r : ℝ) : ℝ :=
  q + β * KP φ p q z + potential lam φ r q - potential lam φ r z -
    max (-φ z) 0 * max (a*r+b) 0
end
end StableVotingDistortion.PaperBox

namespace StableVotingDistortion.PaperMiddle
open Set MeasureTheory
open StableVotingDistortion.PaperBox
noncomputable section
set_option maxRecDepth 100000
def lam : ℝ := 703/1250
def pA : ℝ := 3/50
def pC : ℝ := 16/25
def p1 : ℝ := 99/100
def beta0 : ℝ := 6
def eps : ℝ := 1/20000
def value (column : Knot → ℕ) (k : Knot) : ℝ := (column k : ℝ)/1000000
def rank (k : Knot) : ℝ := (k.position:ℝ)/1000
def fraction (x lo hi : ℝ) : ℝ := max 0 (min 1 ((x-lo)/(hi-lo)))
def interpolate (column : Knot → ℕ) (k l : Knot) (x : ℝ) : ℝ :=
  let t := fraction x (rank k) (rank l)
  (1-t)*value column k+t*value column l
def lookup (col : Knot → ℕ) (x : ℝ) : Knot → List Knot → ℝ
  | k,[] => value col k
  | k,l::tail => if x≤rank l then interpolate col k l x else lookup col x l tail
def entry (col : Knot → ℕ) (p : ℝ) : ℝ := lookup col p knots.head! knots.tail
def adjacentCells : List (Knot×Knot) := knots.zip knots.tail
def canonical (φ : ℝ → ℝ) (p : ℝ) : ℝ := (p/J φ p)*(1+eps)
def beta (φ : ℝ → ℝ) (p : ℝ) : ℝ :=
  if p≤pA then beta0 else if p≤pC then entry Knot.beta p else if p≤p1 then canonical φ p else p/J φ p
def a (p : ℝ) : ℝ := if p≤pC then -1 else 1
def b (φ : ℝ → ℝ) (p : ℝ) : ℝ :=
  if p≤pA then 1+beta0*p else if p≤pC then entry Knot.eta p else -(beta φ p*(1-p))
def corr (φ : ℝ → ℝ) (p : ℝ) := PaperBox.correction lam φ (a p) (b φ p)
end
end StableVotingDistortion.PaperMiddle

namespace StableVotingDistortion.PaperCurve
open Set MeasureTheory
noncomputable section
set_option maxRecDepth 100000
structure Piece where
  lo : ℚ
  hi : ℚ
  coeff : List ℚ
  areaBefore : ℚ
  deriving DecidableEq, Repr, Inhabited
def Piece.c (p : Piece) (n : ℕ) : ℚ := p.coeff[n]?.getD 0
def horner (c : List ℚ) (x : ℝ) : ℝ := c.foldr (fun a t => a + x*t) 0
def qhorner (c : List ℚ) (x : ℚ) : ℚ := c.foldr (fun a t => a + x*t) 0
def pad (c : ℕ → ℚ) : List ℚ := [c 0, c 1, c 2, c 3, c 4, c 5, c 6]
def Piece.value (p : Piece) (x : ℝ) : ℝ := horner (pad p.c) (x-p.lo)
def Piece.qvalue (p : Piece) (x : ℚ) : ℚ := qhorner (pad p.c) (x-p.lo)
def Piece.slopeCoeffs (p : Piece) : List ℚ :=
  [p.c 1,2*p.c 2,3*p.c 3,4*p.c 4,5*p.c 5,6*p.c 6]
def Piece.intCoeffs (p : Piece) : List ℚ := pad (fun n => p.c n / (n+1 : ℕ))
def Piece.primitiveValue (p : Piece) (x : ℝ) : ℝ :=
  p.areaBefore + (x-p.lo)*horner p.intCoeffs (x-p.lo)
def Piece.qprimitive (p : Piece) (x : ℚ) : ℚ :=
  p.areaBefore + (x-p.lo)*qhorner p.intCoeffs (x-p.lo)
end
end StableVotingDistortion.PaperCurve

namespace StableVotingDistortion.PaperCurve
open Set MeasureTheory
noncomputable section
set_option maxRecDepth 100000
structure Knot where
  x : ℚ
  y : ℚ
  j : ℚ
  deriving DecidableEq, Repr
def select (v : Piece → ℝ → ℝ) (ending : ℚ) : List Piece → ℝ → ℝ
  | [], _ => ending
  | p::ps, x => if x ≤ p.hi then v p x else select v ending ps x
def scoreEval (b : Knot) := select Piece.value b.y
def primitiveEval (b : Knot) := select Piece.primitiveValue b.j
end
end StableVotingDistortion.PaperCurve

