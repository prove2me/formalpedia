theorem isWidthAdjoint_adjE (ℓ : Nat.Primes) : IsWidthAdjoint (fun e : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) => ((SSLevelDatum.degeneracyData X).w e : ℕ)) (X.edgeHecke ℓ) (adjE M s q' A X ℓ) := by
  refine isWidthAdjoint_widthAdjoint ?_
  by_cases hℓ : (ℓ : ℕ) = q'
  · exact (isWidthAdjoint_frob M s q' hq5 A X (M * s) (X.edgeHecke ℓ)
      ((SSLevelDatum.edgeHecke_apply_and_vertexHecke_apply_self X ℓ hℓ).1)).dvd
  · exact (isWidthAdjoint_edge_corr M s q' hs hq5 hsq' hq'M hsM A X hPD ℓ hℓ).dvd

theorem isWidthAdjoint_adjV (ℓ : Nat.Primes) : IsWidthAdjoint (fun v : ↥(ssPlaces q' M (IsLocalRing.ResidueField ↥A)) => ((Nat.toPNat' (placeWidth M v.1)) : ℕ)) (X.vertexHecke ℓ) (adjV M s q' A X ℓ) := by
