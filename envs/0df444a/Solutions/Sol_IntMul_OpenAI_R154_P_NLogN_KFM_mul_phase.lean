    lt_of_lt_of_le hx (Nat.pow_le_pow_right (by norm_num) (le_bM hn))
  have r2 := digW_runs (I := Isym) (iprog := kTable extM) t1 hR1 C.hMS' x hxM (t.G tX)
    (by simp [t1])
  set xs := gflat (digG (bP n) (NLogN.KFM.eN n) (NLogN.KFM.mN n) (sCmp n) x) with hxs
  have e2 : (t1.upd tX (t.G tX)).upd 0 (ints xs ++ t1.G 0) = t0.upd 0 (ints xs ++ t.G 0) := by
    rw [ht1, restore t (by decide) LA]
    simp only [t0, IState.upd_G, if_neg (show (0 : Fin HS) ≠ tX by decide),
