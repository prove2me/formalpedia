-- title:
--   Components after suppressing a two-valent vertex
-- statement:
--   Let $\sigma,\theta$ be permutations of $D$ with $\sigma x=y$. Let $k(\alpha,\beta)$ denote the equivalence relation generated by the cycles of $\alpha$ and $\beta$. Then joining the components of $\bigl((x\ y)\sigma,\ \mathrm{supp}(\theta,x,y)\bigr)$ along the pairs $\{x,\theta x\}$ and $\{y,\theta x\}$ recovers
--   $$
--   k(\sigma,\theta).
--   $$
--
--   Suppression only detaches the two darts of the vertex as isolated markers.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/Suppression.lean#L259-L288

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

theorem OAI.KervaireRibbon.components_suppress (σ θ : Equiv.Perm D) {x y : D} (hsx : σ x = y) :
    joinPair (joinPair (components (swap x y * σ) (suppress θ x y)) x (θ x)) y (θ x) =
      components σ θ := by sorry
