-- Source module: Solutions.AModelProp11
/-!
# Proposition 11 (power-width interchange with rows) in the array model

1. `Layout.cons2`: a layout on `rest` lifted to `P :: L :: rest`; `amap_cons2`.
2. The concrete frame action `shearπ` (shear address maps on `rest`), its hypotheses, and
   `shear_network`: the row-split network realizes `H ← H + D` on every row.
3. `netRunF`: the network with implemented frame changes; `netRunF_congr` (agreement on the frame
   changes that actually occur, `FramesOK`, suffices).
4. `runC`: Lemma 10 steps with every field interchange delegated to a child.
5. Chunk shapes `hdShape` (chunks split into `m` fields) / `swShape` (chunks merged).
6. `amap_swapMat_eq_blockSwap`.
7. One level (`levelR`) with an oracle child: `levelR_correct_amap`, `levelR_correct`.
8. The recursive program `prog` and `prog_correct` (induction on the level).
9. Cost: `levelCost_eq` (`T_{k+1}(V) = C₀ V + s T_k(V/W)`), `prog_cost`.
10. `prop11`: denotation (block swap of the two `m^k`-digit chunks) and cost `O(V (m^k)^τ)`.
-/

namespace AModel

open Matrix

/-! ## 1. Lifting a layout past the prefix and row fields -/

section Cons2

variable {sh : Shape} {n Q : ℕ}

variable (Λ : Layout sh n Q)

lemma Layout.actIdx_cons2_add (P L k : ℕ) : (Λ.cons2 P L).actIdx (k + 2) = Λ.actIdx k := by
  unfold Layout.actIdx
  congr 1
  funext i
  simp

lemma Layout.actIdx_cons2_lt (P L k : ℕ) (hk : k < 2) : (Λ.cons2 P L).actIdx k = none := by
  unfold Layout.actIdx
  rw [List.find?_eq_none]
  intro i _
  simp only [cons2_pos, beq_iff_eq]
  omega

lemma act_cons2 (P L p r : ℕ) (x : List ℕ) : act (Λ.cons2 P L) (p :: r :: x) = act Λ x := by
  funext i
  simp [act]

lemma setAct_cons2 (P L p r : ℕ) (x : List ℕ) (v : Fin n → ZMod Q) :
    setAct (Λ.cons2 P L) (p :: r :: x) v = p :: r :: setAct Λ x v := by
  apply List.ext_getElem (by simp)
  intro k h₁ h₂
  rw [getElem_setAct]
  rcases k with _ | _ | k
  · rw [Λ.actIdx_cons2_lt P L 0 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_lt P L 1 (by omega)]; rfl
  · rw [Λ.actIdx_cons2_add]
    simp only [List.getElem_cons_succ]
    rw [getElem_setAct]

lemma amap_cons2 (P L p r : ℕ) (x : List ℕ) (M : Matrix (Fin n) (Fin n) (ZMod Q)) :
    amap (Λ.cons2 P L) M (p :: r :: x) = p :: r :: amap Λ M x := by
  simp only [amap, act_cons2, setAct_cons2]

lemma rowLift_amap {P L : ℕ} (M : Matrix (Fin n) (Fin n) (ZMod Q)) {a : List ℕ}
    (ha : Valid (P :: L :: sh) a) : rowLift (amap Λ M) a = amap (Λ.cons2 P L) M a := by
  obtain ⟨p, r, x, rfl, -⟩ := valid_cons2 ha
  rw [amap_cons2]; rfl

end Cons2

/-! ## 2. The concrete frame action: shears on the `rest` digits -/

/-! ## 3. Networks with implemented frame changes -/

/-! ## 4. Running steps with the interchanges delegated to a child procedure -/

section RunChild

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q) {α : Type*}

lemma length_runArr (d : α) (steps : List (Step n Q)) {xs : List α}
    (hxs : xs.length = vol sh) : (runArr Λ d steps xs).length = vol sh := by
  induction steps generalizing xs with
  | nil => exact hxs
  | cons s rest ih =>
    simp only [runArr, List.foldl_cons] at ih ⊢
    exact ih (by rw [Step.arr, length_pull])

end RunChild

/-! ## 5. Chunk shapes: two chunks split into `m` fields, and merged -/

section Chunks

lemma hdPos_castAdd (A B : Shape) (m : ℕ) (i : Fin m) :
    hdPos A B m (Fin.castAdd m i : ℕ) = A.length + i := by
  simp [hdPos]

lemma hdPos_natAdd (A B : Shape) (m : ℕ) (j : Fin m) :
    hdPos A B m (Fin.natAdd m j : ℕ) = A.length + B.length + m + j := by
  simp [hdPos]; omega

end Chunks

/-! ## 6. The chunk interchange `amap swapMat` is a block swap -/

section SwapBlock

variable {sh : Shape} {m Q : ℕ} [NeZero Q] (Λ : Layout sh (m + m) Q)

/-- For contiguous `H` fields at `c, …, c+m-1` and `D` fields at `c', …, c'+m-1`, the chunk
interchange `(H, D) ↦ (D, H)` moves digit blocks: it is `blockSwap c c' m` on valid addresses. -/
theorem amap_swapMat_eq_blockSwap {c c' : ℕ}
    (hc : ∀ i : Fin m, (Λ.pos (Fin.castAdd m i) : ℕ) = c + i)
    (hc' : ∀ j : Fin m, (Λ.pos (Fin.natAdd m j) : ℕ) = c' + j) (hcc : c + m ≤ c')
    {a : List ℕ} (ha : Valid sh a) : amap Λ swapMat a = blockSwap c c' m a := by
  apply List.ext_getElem (by simp [amap])
  intro k h₁ h₂
  rw [getElem_blockSwap]
  simp only [amap] at h₁ ⊢
  rw [getElem_setAct]
  cases h : Λ.actIdx k with
  | none =>
    have hn := Λ.actIdx_none h
    have o1 : ¬ (c ≤ k ∧ k < c + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.castAdd m ⟨k - c, by omega⟩) (by rw [hc]; simp; omega)
    have o2 : ¬ (c' ≤ k ∧ k < c' + m) := by
      rintro ⟨h1, h2⟩
      exact hn (Fin.natAdd m ⟨k - c', by omega⟩) (by rw [hc']; simp; omega)
    rw [bsIdx_out o1 o2, List.getD_eq_getElem]
  | some t =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only
    induction t using Fin.addCases with
    | left i =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.castAdd m i) = act Λ a (Fin.natAdd m i) :=
        congrFun (hv_swapMat (act Λ a)) i
      rw [e1, val_act Λ ha, hc, hc', bsIdx_left hcc i.2]
    | right j =>
      have e1 : (swapMat *ᵥ act Λ a) (Fin.natAdd m j) = act Λ a (Fin.castAdd m j) :=
        congrFun (dv_swapMat (act Λ a)) j
      rw [e1, val_act Λ ha, hc, hc', bsIdx_right hcc j.2]

end SwapBlock

