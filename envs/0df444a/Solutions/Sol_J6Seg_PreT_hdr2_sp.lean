-- Source module: Solutions.J6SegILPre22
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 22: the new block header and one block

* `hdrP2 K Cs` pushes `blkHdr2 n b = [n, 2n, clog₂(2n), 2nb]` (reading order, i.e. `K` gains its
  reverse) for `n` on `2`, `b` on `28`. `clog₂(2n)` is computed by `λ` rounds (counter `Cs`) of
  `if p < 2n then (p := 2p; j := j + 1)` with `j` on `3`, `p` on `4`. Everything is at width `BW A`
  (needs `4λ ≤ 2^A`, since `p = 2^j < 4n`).
* `blkB2 K Cs` is `blkB K Cs` with `hdrP2` in place of `hdrP`; `blk2_sp` needs no `M`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## The header -/

theorem clog_le_self {n : ℕ} (hn : 1 ≤ n) : Nat.clog 2 (2 * n) ≤ n := by
  apply Nat.clog_le_of_le_pow
  have := Nat.lt_two_pow_self (n := n - 1)
  have e : 2 ^ n = 2 * 2 ^ (n - 1) := by rw [← pow_succ']; congr 1; omega
  omega

theorem pow_clog_lt {n : ℕ} (hn : 1 ≤ n) : 2 ^ Nat.clog 2 (2 * n) < 4 * n := by
  have h := Nat.pow_pred_clog_lt_self (b := 2) (by norm_num) (x := 2 * n) (by omega)
  have hp := Nat.clog_pos (b := 2) (n := 2 * n) (by norm_num) (by omega)
  have e : 2 ^ Nat.clog 2 (2 * n) = 2 * 2 ^ (Nat.clog 2 (2 * n)).pred := by
    rw [← pow_succ']; congr 1; exact (Nat.succ_pred_eq_of_pos hp).symm
  omega

/-- **The new block header.** -/
theorem hdr2_sp_sol_aux (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {K Cs : Fin HS}
    (hK : K ∉ rg) (hK5 : K.val < 56) (hCs : Cs ∉ rg) (hCs5 : Cs.val < 56) (hKs : K ≠ Cs)
    (hcs : c Cs = []) {A n b lam : ℕ} (hA : 2 ≤ A) (hv : VB v A) (h2 : v 2 = n) (h24 : v 24 = lam)
    (h28 : v 28 = b) (hn1 : 1 ≤ n) (hnl : n ≤ lam) (h4l : 4 * lam ≤ 2 ^ A) :
    ∃ v' : Fin HS → ℤ, (∀ j, j ≠ 3 → j ≠ 4 → v' j = v j) ∧ VB v' A ∧
      Sp (hdrP2 K Cs) (encK s (RF v c))
        (encK s (RF v' (Function.update c K ((J6Seg.KR.blkHdr2 n b).reverse ++ c K))))
        (cHdr2 A lam) := by
  set J := Nat.clog 2 (2 * n) with hJ
  have hJn : J ≤ n := clog_le_self hn1
  have hJ4 : 2 ^ J < 4 * n := pow_clog_lt hn1
  have pu : ∀ (w : Fin HS → ℤ) (cc : Fin HS → List ℤ) (e : Ex HS), VB w A → InRg e →
      Poly e = true → dg e ≤ 40 → Safe e = true → Sp (.push K e) (encK s (RF w cc))
        (encK s (RF w (Function.update cc K (e.eval (encK s (RF w cc)) :: cc K)))) (cE e (BW A)) :=
    fun w cc e hw he hp hd hs => spU s w cc hK hK5 he (ok_RF he hs) (V := fun _ => 2 ^ A)
      (B := BW A) (vb_regs hw he) (mgB hA hp hd)
  have P1 := pu v c (.reg 2) hv (inRg_of (by decide)) (by decide) (by decide) (by decide)
  rw [show (Ex.reg 2).eval (encK s (RF v c)) = (n : ℤ) by
    simp only [Ex.eval, top_RF (show (2 : Fin HS) ∈ rg by decide), h2]] at P1
  set c1 := Function.update c K ((n : ℤ) :: c K)
  have P2 := pu v c1 (.add (.reg 2) (.reg 2)) hv (inRg_of (by decide)) (by decide) (by decide)
    (by decide)
  rw [show (Ex.add (.reg 2) (.reg 2)).eval (encK s (RF v c1)) = ((2 * n : ℕ) : ℤ) by
    simp only [Ex.eval, top_RF (show (2 : Fin HS) ∈ rg by decide), h2]; push_cast; ring] at P2
  set c2 := Function.update c1 K (((2 * n : ℕ) : ℤ) :: c1 K)
  have P3 := spA' s v c2 hA hv (i := 3) (by decide) (e := .lit 0) (inRg_of (by decide)) (by decide)
    (by decide) (by decide)
  simp only [Ex.eval] at P3
  have hv3 : VB (Function.update v 3 0) A := VB_upd hv 3 (by simp)
  have P4 := spA' s _ c2 hA hv3 (i := 4) (by decide) (e := .lit 1) (inRg_of (by decide))
    (by decide) (by decide) (by decide)
  simp only [Ex.eval] at P4
  have e0 : Function.update (Function.update v 3 0) 4 1 = hS v J 0 := by simp [hS]
  rw [e0] at P4
  have oth : ∀ k j, j ≠ 3 → j ≠ 4 → hS v J k j = v j := by
    intro k j a b'; simp [hS, a, b']
  have hVB : ∀ k, VB (hS v J k) A := by
    intro k
    refine VB_upd (VB_upd hv 3 ?_) 4 ?_
    · rw [abs_of_nonneg (by positivity)]
      have : min k J ≤ 2 ^ A := by omega
      exact_mod_cast this
    · rw [abs_of_nonneg (by positivity)]
      have : 2 ^ min k J ≤ 2 ^ J := Nat.pow_le_pow_right (by norm_num) (min_le_right _ _)
      exact_mod_cast (show 2 ^ min k J ≤ 2 ^ A by omega)
  have c2C : c2 Cs = [] := by
    simp only [c2, c1]
    rw [Function.update_of_ne (Ne.symm hKs), Function.update_of_ne (Ne.symm hKs), hcs]
  have R := Sp.rep (C := Cs) (n := .reg 24) (b := hdB) (s := s)
    (F := fun k => RF (hS v J k) c2) (N := lam) (B := BW A) (c := cHdB A) hCs5
    (fun k => by simp only [RF_out hCs, c2C])
    (by
      simp only [hdB, RS.writes, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
        not_or]
      exact ⟨by rintro rfl; exact hCs (by decide), by rintro rfl; exact hCs (by decide)⟩)
    (clean_of_inRg (inRg_reg (by decide))) (ok_RF (inRg_reg (by decide)) rfl) trivial
    (bnd_of_mg _ (fun _ => 2 ^ A) (BW A) _ (RF_bnd (inRg_reg (by decide))
      (vb_regs (hVB 0) (inRg_reg (by decide)))) (mgB hA (by decide) (by decide)))
    (by rw [ev_reg (by decide), oth 0 24 (by decide) (by decide), h24])
    (fun k hk => by
      simp only [upd_RF_out hCs]
      set cc := Function.update c2 Cs [(lam : ℤ) - k]
      have hw := hVB k
      have w4 : hS v J k 4 = (2 : ℤ) ^ min k J := by simp [hS]
      have w3 : hS v J k 3 = ((min k J : ℕ) : ℤ) := by simp [hS]
      have w2 : hS v J k 2 = n := by rw [oth k 2 (by decide) (by decide), h2]
      have ep : pE.eval (encK s (RF (hS v J k) cc)) = (2 : ℤ) ^ min k J - 2 * n := by
        simp only [pE, Ex.eval, top_RF (show (4 : Fin HS) ∈ rg by decide),
          top_RF (show (2 : Fin HS) ∈ rg by decide), w4, w2]; ring
      have iP : InRg pE := inRg_of (by decide)
      have mP := mgB (e := pE) hA (by decide) (by decide)
      by_cases hkJ : k < J
      · have hlt : 2 ^ k < 2 * n := Nat.pow_lt_of_lt_clog hkJ
        have a4 := spA' s (hS v J k) cc hA hw (i := 4) (by decide) (e := .add (.reg 4) (.reg 4))
          (inRg_of (by decide)) (by decide) (by decide) (by decide)
        have e4 : (Ex.add (.reg 4) (.reg 4)).eval (encK s (RF (hS v J k) cc)) = (2 : ℤ) ^ (k + 1) := by
          simp only [Ex.eval, top_RF (show (4 : Fin HS) ∈ rg by decide), w4, min_eq_left hkJ.le]
          ring
        rw [e4] at a4
        have hw' : VB (Function.update (hS v J k) 4 ((2 : ℤ) ^ (k + 1))) A := by
          refine VB_upd hw 4 ?_
          rw [abs_of_nonneg (by positivity)]
          have : 2 ^ (k + 1) ≤ 2 ^ J := Nat.pow_le_pow_right (by norm_num) hkJ
          exact_mod_cast (show 2 ^ (k + 1) ≤ 2 ^ A by omega)
        have a3 := spA' s _ cc hA hw' (i := 3) (by decide) (e := .add (.reg 3) (.lit 1))
          (inRg_of (by decide)) (by decide) (by decide) (by decide)
        have e3 : (Ex.add (.reg 3) (.lit 1)).eval
            (encK s (RF (Function.update (hS v J k) 4 ((2 : ℤ) ^ (k + 1))) cc)) = ((k + 1 : ℕ) : ℤ) := by
          simp only [Ex.eval, top_RF (show (3 : Fin HS) ∈ rg by decide),
            upd_ne (show (3 : Fin HS) ≠ 4 by decide), w3, min_eq_left hkJ.le]
          push_cast; ring
        rw [e3] at a3
        have I := spIT s (hS v J k) cc iP (ok_RF iP rfl) (vb_regs hw iP) mP
          (by
            rw [ep, min_eq_left hkJ.le]
            have : ((2 ^ k : ℕ) : ℤ) < ((2 * n : ℕ) : ℤ) := by exact_mod_cast hlt
            push_cast at this; linarith) (b := .skip) (a4.seq a3)
        refine (I.congr ?_).mono (by unfold cHdB; omega)
        congr 2
        funext j
        simp only [hS, Function.update_apply, min_eq_left hkJ.le, min_eq_left (show k + 1 ≤ J by omega)]
        split_ifs <;> first | rfl | omega | (exfalso; simp_all)
      · push Not at hkJ
        have hge : 2 * n ≤ 2 ^ J := Nat.le_pow_clog (by norm_num) _
        have I := spIF s (hS v J k) cc iP (ok_RF iP rfl) (vb_regs hw iP) mP
          (by
            rw [ep, min_eq_right hkJ]
            have : ((2 * n : ℕ) : ℤ) ≤ ((2 ^ J : ℕ) : ℤ) := by exact_mod_cast hge
            push_cast at this; linarith)
          (a := .seq (.asg 4 (.add (.reg 4) (.reg 4))) (.asg 3 (.add (.reg 3) (.lit 1)))) (Sp.skip _)
        refine (I.congr ?_).mono (by unfold cHdB; omega)
        congr 2
        simp only [hS, min_eq_right hkJ, min_eq_right (show J ≤ k + 1 by omega)])
  have eL : min lam J = J := min_eq_right (by omega)
  set vh := hS v J lam
  have hvh := hVB lam
  have P5 := pu vh c2 (.reg 3) hvh (inRg_of (by decide)) (by decide) (by decide) (by decide)
  rw [show (Ex.reg 3).eval (encK s (RF vh c2)) = ((J : ℕ) : ℤ) by
    simp only [Ex.eval, top_RF (show (3 : Fin HS) ∈ rg by decide), vh, hS, eL]; simp] at P5
  set c3 := Function.update c2 K (((J : ℕ) : ℤ) :: c2 K)
  have P6 := pu vh c3 nbE hvh (inRg_of (by decide)) (by decide) (by decide) (by decide)
  rw [show nbE.eval (encK s (RF vh c3)) = ((2 * n * b : ℕ) : ℤ) by
    simp only [nbE, Ex.eval, top_RF (show (2 : Fin HS) ∈ rg by decide),
      top_RF (show (28 : Fin HS) ∈ rg by decide), vh, oth lam 2 (by decide) (by decide),
      oth lam 28 (by decide) (by decide), h2, h28]; push_cast; ring] at P6
  refine ⟨vh, oth lam, hvh, ?_⟩
  refine (P1.seq (P2.seq (P3.seq (P4.seq (R.seq (P5.seq P6)))))).congr ?_ |>.mono
    (le_of_eq (by unfold cHdr2; rfl))
  congr 2
  simp only [c3, c2, c1, Function.update_self, Function.update_idem, J6Seg.KR.blkHdr2]
  simp [J]

/-! ## One block -/

end J6Seg.PreT

end

theorem solution : type_of% @J6Seg.PreT.hdr2_sp_sol_aux := @J6Seg.PreT.hdr2_sp_sol_aux
