theorem FCSide.finrankAlong_φC_eq {q q' : ℕ} {Fbase : Type} [Field Fbase] [Algebra (AlgebraicClosure ℚ) Fbase]
    [IsCurveOver (AlgebraicClosure ℚ) Fbase]
    {𝕋 : TowerData q q' Fbase} {A : ValuationSubring (AlgebraicClosure ℚ)}
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
    {galF : ∀ j : Obj q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j)}
    (𝔉 : FCSide 𝕋 A S scalar galF)
    (hfg : ∀ j : Obj q q', ∃ x : 𝕋.objField j, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set (𝕋.objField j))) (𝕋.objField j))
    {r : ℕ} [Fact r.Prime] (hA : A.LiesOverPrime r) (α : Arr q q') :
    finrankAlong A.valuation.Completion (𝔉.φC α) = finrankAlong (AlgebraicClosure ℚ) (𝕋.φ α) := by
  haveI : IsAlgClosed A.valuation.Completion :=
    ValuationSubring.isAlgClosed_completion_of_liesOverPrime r Fact.out A hA

  letI := 𝔉.instAlgF (cod α); letI := 𝔉.instAlgF (dom α)
  haveI := 𝔉.instTowF (cod α); haveI := 𝔉.instTowF (dom α)
  exact (finrankAlong_eq_and_trace_eq_of_constantFieldExtension_of_isAlgClosed (AlgebraicClosure ℚ)
    (𝕋.objField (cod α)) (hfg (cod α)) (𝕋.objField (dom α)) (hfg (dom α)) (𝕋.φ α) (𝕋.integral α)
    A.valuation.Completion (𝔉.FC (cod α)) (𝔉.hfg' (cod α)) (𝔉.hgen (cod α))
    (𝔉.FC (dom α)) (𝔉.hfg' (dom α)) (𝔉.hgen (dom α)) (𝔉.φC α) (𝔉.hcomm α) (𝔉.hφC_int α)).2.2.1

theorem FCSide.finrankAlong_φC_eq_arrowDegree {q q' : ℕ} {Fbase : Type} [Field Fbase]
    [Algebra (AlgebraicClosure ℚ) Fbase] [IsCurveOver (AlgebraicClosure ℚ) Fbase]
    {𝕋 : TowerData q q' Fbase} {A : ValuationSubring (AlgebraicClosure ℚ)}
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
    {galF : ∀ j : Obj q q', S →* SemilinearAut (AlgebraicClosure ℚ) (𝕋.objField j)}
    (𝔉 : FCSide 𝕋 A S scalar galF)
    (hfg : ∀ j : Obj q q', ∃ x : 𝕋.objField j, Transcendental (AlgebraicClosure ℚ) x ∧
      FiniteDimensional (IntermediateField.adjoin (AlgebraicClosure ℚ) ({x} : Set (𝕋.objField j))) (𝕋.objField j))
    {r : ℕ} [Fact r.Prime] (hA : A.LiesOverPrime r)
    (N : ℕ) (hdegT : ∀ α : Arr q q', finrankAlong (AlgebraicClosure ℚ) (𝕋.φ α) = arrowDegree N α)
    (α : Arr q q') :
    finrankAlong A.valuation.Completion (𝔉.φC α) = arrowDegree N α :=
  (𝔉.finrankAlong_φC_eq hfg hA α).trans (hdegT α)

namespace MumfordAux

variable {K : Type} [Field K] {G : Type} [Group G] {M : Type} [CommRing M] [Algebra K M]
  [MulSemiringAction G M] [SMulCommClass G K M] [IsDomain M]

theorem smul_mem_invariantFieldOf (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ)
    (x : FractionRing M) (hx : x ∈ invariantFieldOf K G M Γ) : g • x ∈ invariantFieldOf K G M Γ' := by
  intro γ hγ
  have hfix : (g⁻¹ * γ * g) • x = x := hx _ (h γ hγ)
  calc γ • g • x = (g * (g⁻¹ * γ * g)) • x := by rw [← mul_smul]; congr 1; group
    _ = g • x := by rw [mul_smul, hfix]

def smulRingHom (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ) :
    ↥(invariantFieldOf K G M Γ) →+* ↥(invariantFieldOf K G M Γ') :=
  ((MulSemiringAction.toRingHom G (FractionRing M) g).comp (invariantFieldOf K G M Γ).subtype).codRestrict
    (invariantFieldOf K G M Γ') (fun x => smul_mem_invariantFieldOf Γ Γ' g h (x : FractionRing M) x.2)

theorem coe_smulRingHom (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ)
    (x : ↥(invariantFieldOf K G M Γ)) :
    ((smulRingHom (K := K) Γ Γ' g h x : ↥(invariantFieldOf K G M Γ')) : FractionRing M) = g • (x : FractionRing M) :=
  rfl

def smulAlgHom (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ) :
    ↥(invariantFieldOf K G M Γ) →ₐ[K] ↥(invariantFieldOf K G M Γ') :=
  { smulRingHom (K := K) Γ Γ' g h with
    commutes' := fun c => Subtype.ext (by
      show g • ((algebraMap K ↥(invariantFieldOf K G M Γ) c : ↥(invariantFieldOf K G M Γ)) : FractionRing M) =
        ((algebraMap K ↥(invariantFieldOf K G M Γ') c : ↥(invariantFieldOf K G M Γ')) : FractionRing M)
      rw [algebraMap_invariantFieldOf_coe, algebraMap_invariantFieldOf_coe, smul_algebraMap_const]) }

@[scoped simp] theorem coe_smulAlgHom (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ)
    (x : ↥(invariantFieldOf K G M Γ)) :
    ((smulAlgHom (K := K) Γ Γ' g h x : ↥(invariantFieldOf K G M Γ')) : FractionRing M) = g • (x : FractionRing M) := rfl

theorem adjoin_range_codRestrict_eq_top {C Fr : Type} [Field C] [Field Fr] [Algebra C Fr] (L : Subfield Fr)
    [Algebra C ↥L] (hL : ∀ c : C, ((algebraMap C ↥L c : ↥L) : Fr) = algebraMap C Fr c)
    {F : Type} [Field F] (ι : F →+* Fr) (hι : ∀ x, ι x ∈ L)
    (hcl : Subfield.closure (Set.range (algebraMap C Fr) ∪ Set.range ι) = L) :
    letI := (ι.codRestrict L hι).toAlgebra
    IntermediateField.adjoin C (Set.range (algebraMap F ↥L)) = ⊤ := by
  letI := (ι.codRestrict L hι).toAlgebra
  rw [eq_top_iff]
  intro y _
  have hy : (y : Fr) ∈ Subfield.closure (Set.range (algebraMap C Fr) ∪ Set.range ι) := by
    rw [hcl]; exact y.2
  have hle : Subfield.closure (Set.range (algebraMap C Fr) ∪ Set.range ι) ≤
      (IntermediateField.adjoin C (Set.range (algebraMap F ↥L))).toSubfield.map L.subtype := by
    rw [Subfield.closure_le]
    rintro _ (⟨c, rfl⟩ | ⟨x, rfl⟩)
    · exact ⟨algebraMap C ↥L c, (IntermediateField.adjoin C _).algebraMap_mem c, hL c⟩
    · exact ⟨algebraMap F ↥L x, IntermediateField.subset_adjoin C _ ⟨x, rfl⟩, rfl⟩
  obtain ⟨z, hz, hzy⟩ := Subfield.mem_map.mp (hle hy)
  have hzy' : z = y := Subtype.ext hzy
  exact hzy' ▸ hz

theorem smulAlgHom_algebraMap_eq (Γ Γ' : Subgroup G) (g : G) (h : ∀ γ : G, γ ∈ Γ' → g⁻¹ * γ * g ∈ Γ)
    {F F' : Type} [Field F] [Field F'] (ι : F →+* FractionRing M) (hι : ∀ x, ι x ∈ invariantFieldOf K G M Γ)
    (ι' : F' →+* FractionRing M) (hι' : ∀ x, ι' x ∈ invariantFieldOf K G M Γ') (x : F) (x' : F')
    (hx : g • ι x = ι' x') :
    letI := (ι.codRestrict (invariantFieldOf K G M Γ) hι).toAlgebra
    letI := (ι'.codRestrict (invariantFieldOf K G M Γ') hι').toAlgebra
    smulAlgHom (K := K) Γ Γ' g h (algebraMap F ↥(invariantFieldOf K G M Γ) x)
      = algebraMap F' ↥(invariantFieldOf K G M Γ') x' :=
  Subtype.ext hx

theorem coe_algebraMap_codRestrict {F Fr : Type} [Field F] [Field Fr] (L : Subfield Fr) (ι : F →+* Fr)
    (hι : ∀ x, ι x ∈ L) (x : F) :
    letI := (ι.codRestrict L hι).toAlgebra
    ((algebraMap F ↥L x : ↥L) : Fr) = ι x := rfl

theorem isIntegral_of_adjoin_range_eq_top {K F F' E FE F'E : Type} [Field K] [Field F] [Field F'] [Field E]
    [Field FE] [Field F'E] [Algebra K F] [Algebra K F'] [Algebra E FE] [Algebra E F'E] [Algebra F FE]
    [Algebra F' F'E] (φ : F →ₐ[K] F') (hφ : φ.toRingHom.IsIntegral) (φE : FE →ₐ[E] F'E)
    (hcomm : ∀ f : F, φE (algebraMap F FE f) = algebraMap F' F'E (φ f))
    (hgen' : IntermediateField.adjoin E (Set.range (algebraMap F' F'E)) = ⊤) :
    φE.toRingHom.IsIntegral := by
  letI algFE : Algebra FE F'E := algebraAlong φE
  letI algF : Algebra F F' := algebraAlong φ
  have hle : Subfield.closure (Set.range (algebraMap E F'E) ∪ Set.range (algebraMap F' F'E)) ≤
      (algebraicClosure FE F'E).toSubfield := by
    rw [Subfield.closure_le]
    rintro _ (⟨c, rfl⟩ | ⟨f', rfl⟩)
    · show IsIntegral FE (algebraMap E F'E c)
      rw [← φE.commutes c]
      exact isIntegral_algebraMap
    · show IsIntegral FE (algebraMap F' F'E f')
      exact IsIntegral.map_of_comp_eq (R := F) (S := F') (T := FE) (U := F'E) (algebraMap F FE)
        (algebraMap F' F'E) (RingHom.ext fun f => hcomm f) (hφ f')
  intro y
  have hy : y ∈ (IntermediateField.adjoin E (Set.range (algebraMap F' F'E))).toSubfield := by
    rw [hgen']; trivial
  rw [IntermediateField.adjoin_toSubfield] at hy
  exact hle hy

end MumfordAux
