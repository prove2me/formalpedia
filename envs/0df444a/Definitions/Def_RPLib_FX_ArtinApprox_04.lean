/-! ### piece ArA5a -/
section Piece_ArA5a


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5a: the Jacobian datum in nested form

`ψ = sumAlgEquiv ∘ rename sumComm : K[x, y] ≃ K[x][y]` transports `jacobian_minor` to systems over `K[x]`:
`jacobian_nested ŷ` gives `h₁, …, h_r` over `K[x]` vanishing at `ŷ`, a `y`-minor `δ` with `δ(ŷ) ≠ 0`, and `G` with
`G(ŷ) ≠ 0` and `G · q ∈ (h)` for every `q` vanishing at `ŷ` (evaluation `MvPolynomial.aeval ŷ`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K : Type u} [Field K]

/-- `K[x, y] ≃ K[x][y]`. -/
abbrev nestEquiv (n N : ℕ) : MvPolynomial (Fin n ⊕ Fin N) K ≃ₐ[K] MvPolynomial (Fin N) (MvPolynomial (Fin n) K) :=
  (MvPolynomial.renameEquiv K (Equiv.sumComm (Fin n) (Fin N))).trans (MvPolynomial.sumAlgEquiv K (Fin N) (Fin n))

theorem nestEquiv_X_inl {n N : ℕ} (i : Fin n) :
    nestEquiv (K := K) n N (MvPolynomial.X (Sum.inl i)) = MvPolynomial.C (MvPolynomial.X i) := by
  simp [nestEquiv, MvPolynomial.sumAlgEquiv_X_inr]

theorem nestEquiv_X_inr {n N : ℕ} (k : Fin N) :
    nestEquiv (K := K) n N (MvPolynomial.X (Sum.inr k)) = MvPolynomial.X k := by
  simp [nestEquiv, MvPolynomial.sumAlgEquiv_X_inl]

theorem nestEquiv_C {n N : ℕ} (a : K) :
    nestEquiv (K := K) n N (MvPolynomial.C a) = MvPolynomial.C (MvPolynomial.C a) := by
  simp [nestEquiv, MvPolynomial.sumAlgEquiv_C_inl]

theorem aeval_nestEquiv {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) (p : MvPolynomial (Fin n ⊕ Fin N) K) :
    MvPolynomial.aeval ŷ (nestEquiv n N p) = evalHat ŷ p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [nestEquiv_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C, MvPowerSeries.algebraMap_apply',
      MvPowerSeries.algebraMap_apply]
    simp
  | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
  | mul_X p v hp =>
    rw [map_mul, map_mul, map_mul, hp]
    congr 1
    cases v with
    | inl i =>
      rw [nestEquiv_X_inl, MvPolynomial.aeval_C, MvPowerSeries.algebraMap_apply', MvPolynomial.aeval_X]
      simp
    | inr k => rw [nestEquiv_X_inr, MvPolynomial.aeval_X, MvPolynomial.aeval_X, Sum.elim_inr]

theorem nestEquiv_pderiv {n N : ℕ} (k : Fin N) (p : MvPolynomial (Fin n ⊕ Fin N) K) :
    nestEquiv n N (MvPolynomial.pderiv (Sum.inr k) p) = MvPolynomial.pderiv k (nestEquiv n N p) := by
  induction p using MvPolynomial.induction_on with
  | C a => rw [MvPolynomial.pderiv_C, map_zero, nestEquiv_C, MvPolynomial.pderiv_C]
  | add p q hp hq => rw [map_add, map_add, map_add, map_add, hp, hq]
  | mul_X p v hp =>
    rw [Derivation.leibniz, map_mul, Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, smul_eq_mul,
      smul_eq_mul, map_mul, map_mul, hp]
    congr 2
    cases v with
    | inl i =>
      rw [MvPolynomial.pderiv_X_of_ne (by simp), map_zero, nestEquiv_X_inl, MvPolynomial.pderiv_C]
    | inr k' =>
      rw [nestEquiv_X_inr, MvPolynomial.pderiv_X, MvPolynomial.pderiv_X]
      by_cases hk : k = k'
      · subst hk
        simp
      · rw [Pi.single_eq_of_ne (by simpa using Ne.symm hk), Pi.single_eq_of_ne (Ne.symm hk), map_zero]

/-- **The nested Jacobian datum** at a power-series point `ŷ`. -/
theorem jacobian_nested [PerfectField K] {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) :
    ∃ (r : ℕ) (h : Fin r → MvPolynomial (Fin N) (MvPolynomial (Fin n) K)) (T : Fin r → Fin N),
      (∀ j, MvPolynomial.aeval ŷ (h j) = 0) ∧
      MvPolynomial.aeval ŷ (Matrix.of fun j k => MvPolynomial.pderiv (T k) (h j)).det ≠ 0 ∧
      ∃ G, MvPolynomial.aeval ŷ G ≠ 0 ∧ ∀ q, MvPolynomial.aeval ŷ q = 0 → G * q ∈ Ideal.span (Set.range h) := by
  obtain ⟨r, h₀, T, hh, hδ, G₀, hG, hGI⟩ := jacobian_minor (K := K) ŷ
  refine ⟨r, fun j => nestEquiv n N (h₀ j), T, fun j => by rw [aeval_nestEquiv]; exact hh j, ?_,
    nestEquiv n N G₀, by rw [aeval_nestEquiv]; exact hG, fun q hq => ?_⟩
  · have e : (Matrix.of fun j k => MvPolynomial.pderiv (T k) (nestEquiv n N (h₀ j))).det =
        nestEquiv n N (Matrix.of fun j k => MvPolynomial.pderiv (Sum.inr (T k)) (h₀ j)).det := by
      rw [AlgEquiv.map_det]
      refine congrArg Matrix.det (Matrix.ext fun j k => ?_)
      simp only [Matrix.of_apply, AlgEquiv.mapMatrix_apply, Matrix.map_apply]
      exact (nestEquiv_pderiv (T k) (h₀ j)).symm
    rw [e, aeval_nestEquiv]
    exact hδ
  · have hq' : evalHat ŷ ((nestEquiv n N).symm q) = 0 := by
      rw [← aeval_nestEquiv, AlgEquiv.apply_symm_apply]
      exact hq
    have hm := Ideal.mem_map_of_mem (nestEquiv n N) (hGI _ hq')
    rw [map_mul, AlgEquiv.apply_symm_apply, Ideal.map_span, ← Set.range_comp] at hm
    exact hm

end RamanujanPetersson.EtPBC.Cov
end

