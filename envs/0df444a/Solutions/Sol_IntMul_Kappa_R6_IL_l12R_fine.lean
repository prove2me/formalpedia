-- Source module: Solutions.KIL6Inst
/-!
# KIL6: the Lemma 12 program with the Prop. 11 code as oracle

The oracle code is the uniform Prop. 11 program of KIL5 (`prog_il_uniform_rat`, i.e.
`progU (Qc.toCircuit 1) (edgeTplQ Qc)`).  Its denotation at the levels used is
`prog (Qc.toCircuit (q ^ m ^ Kp)) q`.  The variant denotation `l12v` is taken with the
length-normalised oracle `normO` (equal to the oracle on every call of the procedure, see
`normO_eq`; it only serves to state the uniform length invariant).

* `l12_il_uniform_rat`: the item-language program `l12I q m W` (with the oracle procedure table)
  computes `l12v (normO (prog …)) …`, with cost `cL12 … (ilCostU5 …)`, for every prime `q`, under
  the KIL5 level side conditions at the levels `j < Kp`;
* `l12_il_rat_correct`: if moreover the oracle is correct (`OracleSpec`, which holds for all large
  primes by `prop11_ratLabels`), the output is the interchange of the two `[2^u]` fields.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12 AModelRat AModelFac

section Norm

variable {α : Type*}

theorem normO_eq {child : Oracle α} {j P L : ℕ} {A B Cs : Shape} {ys : List α}
    (h : (child j P L A B Cs ys).length = ys.length) :
    normO child j P L A B Cs ys = child j P L A B Cs ys := if_pos h

theorem length_normO (child : Oracle α) (j P L : ℕ) (A B Cs : Shape) (ys : List α) :
    (normO child j P L A B Cs ys).length = ys.length := by
  unfold normO; split_ifs with h
  · exact h
  · rfl

theorem oracleSpec_normO {child : Oracle α} {d : α} {W m q K : ℕ}
    (h : OracleSpec child d W m q K) : OracleSpec (normO child) d W m q K := by
  intro j hj P L A B Cs ys hL hys
  rw [normO_eq (by rw [h j hj P L A B Cs ys hL hys, length_pull, hys])]
  exact h j hj P L A B Cs ys hL hys

end Norm

theorem le_of_pow_le_pow' {m j K : ℕ} (hm : 2 ≤ m) (h : m ^ j ≤ m ^ K) : j ≤ K :=
  (Nat.pow_le_pow_iff_right (by omega)).1 h

/-- The padded row volume is at most twice the radix-`q` volume. -/
theorem rowVol_le {q W K r n : ℕ} (hq : 2 ≤ q) (hW : 1 ≤ W) (Pre G Suf : Shape)
    (hWK : W ^ K ≤ q ^ r) :
    vol (rowShape (vol Pre) (padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n) ≤
      2 * vol (qShape Pre G Suf q (r + n)) := by
  rw [vol_qShape_row, vol_rowShape]
  have h1 := padRows_le W K (q ^ r) hW
  have h2 : padRows W K (q ^ r) ≤ 2 * q ^ r := by omega
  calc vol Pre * padRows W K (q ^ r) * vol (restShape (G ++ List.replicate r q) Suf q n)
      ≤ vol Pre * (2 * q ^ r) * vol (restShape (G ++ List.replicate r q) Suf q n) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h2)
    _ = 2 * (vol Pre * (q ^ r * vol (restShape (G ++ List.replicate r q) Suf q n))) := by ring

end NLogN.KIL

