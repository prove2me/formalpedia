theorem normalizedRowApprox_error {n p : ℕ} (oracle : (Fin p → ℤ) → Bool) (v : Fin p → ℝ)
    (hOracle : ∀ c, oracle c = true ↔ 0 ≤ formValue c v) (P : Fin n → Fin p → ℚ) (k : ℕ) :
    let x := fun i ↦ ∑ j, (P i j : ℝ) * v j
