/-- **Transport of selected-bit operators** along an address map that preserves the linear
index. -/
theorem selOp_transport {sh sh' : Shape} {ι ι' : Type*} [Fintype ι] [DecidableEq ι]
    [Fintype ι'] [DecidableEq ι'] (Sb : SelBits sh ι) (Sb' : SelBits sh' ι') (e : ι ≃ ι')
    (φ : List ℕ → List ℕ) (hvol : AModel.vol sh' = AModel.vol sh)
    (hval : ∀ a, AModel.Valid sh a → AModel.Valid sh' (φ a))
    (henc : ∀ a, AModel.Valid sh a → encode sh' (φ a) = encode sh a)
    (hbits : ∀ a, AModel.Valid sh a → ∀ i, Sb'.bits (φ a) (e i) = Sb.bits a i)
    (hset : ∀ a, AModel.Valid sh a → ∀ y : ι → Fin 2, Sb'.set (φ a) (y ∘ e.symm) = φ (Sb.set a y))
    (A : M2) {M : Type*} [AddCommMonoid M] [Module ℂ M] (xs : List M) :
    selOp Sb (Butterfly.tens A) xs = selOp Sb' (Butterfly.tens A) xs := by
