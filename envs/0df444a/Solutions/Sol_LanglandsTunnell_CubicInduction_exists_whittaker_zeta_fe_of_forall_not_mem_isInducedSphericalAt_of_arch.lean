private theorem norm_sphericalTorusValue_le {e₁ e₂ e₃ : ℂ} {A : ℝ} (hA : 1 ≤ A) (h₁ : ‖e₁‖ ≤ A) (h₂ : ‖e₂‖ ≤ A)
    (h₃ : ‖e₃‖ ≤ A) (n : ℕ) : ‖sphericalTorusValue e₁ e₂ e₃ n‖ ≤ (3 * A) ^ n := by
  have h3A : (1 : ℝ) ≤ 3 * A := by linarith
  have key : ∀ n : ℕ, ‖sphericalTorusValue e₁ e₂ e₃ n‖ ≤ (3 * A) ^ n ∧
      ‖sphericalTorusValue e₁ e₂ e₃ (n + 1)‖ ≤ (3 * A) ^ (n + 1) ∧
      ‖sphericalTorusValue e₁ e₂ e₃ (n + 2)‖ ≤ (3 * A) ^ (n + 2) := by
    intro n
    induction n with
    | zero =>
      refine ⟨?_, ?_, ?_⟩
      · simp [sphericalTorusValue]
      · simp only [sphericalTorusValue, zero_add, pow_one]
        linarith
      · simp only [sphericalTorusValue, zero_add]
        have hsq : ‖e₁ ^ 2‖ ≤ A ^ 2 := by
          rw [norm_pow]
          exact pow_le_pow_left₀ (norm_nonneg _) h₁ 2
        have hsub := norm_sub_le (e₁ ^ 2) e₂
        nlinarith
    | succ k ih =>
      obtain ⟨h0, h1, h2⟩ := ih
      refine ⟨h1, h2, ?_⟩
      rw [show k + 1 + 2 = k + 3 by omega, sphericalTorusValue]
      have hk1 : ‖sphericalTorusValue e₁ e₂ e₃ (k + 1)‖ ≤ (3 * A) ^ (k + 2) :=
        h1.trans (pow_le_pow_right₀ h3A (by omega))
      have hk0 : ‖sphericalTorusValue e₁ e₂ e₃ k‖ ≤ (3 * A) ^ (k + 2) :=
        h0.trans (pow_le_pow_right₀ h3A (by omega))
      have hm₁ := mul_le_mul h₁ h2 (norm_nonneg _) (by linarith)
      have hm₂ := mul_le_mul h₂ hk1 (norm_nonneg _) (by linarith)
      have hm₃ := mul_le_mul h₃ hk0 (norm_nonneg _) (by linarith)
      have hadd := norm_add_le (e₁ * sphericalTorusValue e₁ e₂ e₃ (k + 2) - e₂ * sphericalTorusValue e₁ e₂ e₃ (k + 1))
        (e₃ * sphericalTorusValue e₁ e₂ e₃ k)
      have hsub := norm_sub_le (e₁ * sphericalTorusValue e₁ e₂ e₃ (k + 2)) (e₂ * sphericalTorusValue e₁ e₂ e₃ (k + 1))
      rw [norm_mul, norm_mul] at hsub
      rw [norm_mul] at hadd
      have hpow : (3 * A) ^ (k + 3) = A * (3 * A) ^ (k + 2) + A * (3 * A) ^ (k + 2) + A * (3 * A) ^ (k + 2) := by ring
      linarith
  exact (key n).1

end
