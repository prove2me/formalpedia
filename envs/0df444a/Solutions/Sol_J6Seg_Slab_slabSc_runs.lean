    (by rw [hGx _ (by decide)]; exact hC) (by rw [hGx _ (by decide)]; exact hD)
    (by rw [hGx _ (by decide)]; exact hM) cs (by rw [hGx _ (by decide)]; exact hN) hcs n hV hND
