      _ ≤ _ := by gcongr
  · calc U + 1 = 1 * (U + 1) * 1 * 1 := by ring
      _ ≤ _ := by gcongr
  · calc RR n + 1 = 1 * 1 * (RR n + 1) * 1 := by ring
      _ ≤ _ := by gcongr
  · calc PmaxOf n + 1 = 1 * 1 * 1 * (PmaxOf n + 1) := by ring
      _ ≤ _ := by gcongr

