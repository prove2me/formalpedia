noncomputable def decode (p : Nat) : Int×Int :=
  (((p%2^96:Nat):Int)-2^95,((p/2^96%2^96:Nat):Int)-2^95)
noncomputable def signedWord (p j : Nat) : Int×Int :=
  if j%2=0 then decode p else (-(decode p).1,-(decode p).2)
noncomputable def bFast (v : List Nat) (imag : Bool) : List Nat :=
  (v.take 1954).zipIdx.map (fun p=>
    let z:=signedWord p.1 p.2
    ((if imag then z.2 else z.1)+(2:Int)^100).toNat)
lemma bReal_fast (v : List Nat) (hv:1954≤v.length) : bReal v=bFast v false := by
