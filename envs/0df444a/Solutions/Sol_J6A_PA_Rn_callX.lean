/-!
# A lines, IL side 7: register-file helpers and the parameter block

On the register file `RF v c` of `J6SegILPreJ*` (`Rn` runs):

* `Rn.asgR`, `Rn.pushR`: assignments / pushes of expressions reading only registers of `rg`;
* `Rn.callX`: a call of a number program with inputs on `16, 17, 18, 27` and result on `19`
  (`callC` of `J6SegILPre3`), and `Rn.enX` / `Rn.epX`: `v d := expNeg n k j` /
  `expPos n k j σ`;
* **`parA`**: from the axis descriptor `[k, pre, post, s, t, p, α, d]` on `dA = 31`, the
  registers `1 … 12` become `pre, post, s, t, p, α, m = sWidth p α, H = 2^⌊log₂ m⌋,
  W = H + m + 3, M = t / 16H, win = 8H, f = ⌊log₂ m⌋ + 3` (**`Rn.parA`**).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6A.PA

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH

/-! ## Expressions on `rg` -/

theorem onRg_mem {e : Ex HS} (h : OnRg e) {j : Fin HS} (hj : j ∈ e.regs) : j ∈ rg := by
  have := List.all_eq_true.1 h j hj
  simpa using this

section rgx
variable {v : Vr} {c : Cs} {W : ℕ}

theorem Rd_onRg {e : Ex HS} (h : OnRg e) : Rd c e := fun j hj => Or.inl (onRg_mem h hj)

theorem clean_onRg {e : Ex HS} (h : OnRg e) : e.Clean :=
  clean_of_regs (fun j hj => rg_lt (onRg_mem h hj))

theorem agr_onRg {e : Ex HS} (h : OnRg e) (c' : Cs) :
    Agr (encK sN (RF v c)) (encK sN (RF v c')) e.regs := fun i hi =>
  ⟨by rw [top_RF (onRg_mem h hi), top_RF (onRg_mem h hi)], isInt_RF (onRg_mem h hi),
    isInt_RF (onRg_mem h hi)⟩

theorem ev_onRg {e : Ex HS} (h : OnRg e) (c' : Cs) : ev v c' e = ev v c e :=
  (agr_eval e (agr_onRg h c')).symm

theorem okR_onRg {e : Ex HS} (h : OnRg e) (c' : Cs) (ho : okR v c e) : okR v c' e :=
  agr_ok e (agr_onRg h c') ho

theorem RB_onRg {e : Ex HS} (h : OnRg e) (hv : BV W v) : RB W v c e :=
  RB_of hv (fun j hj hn => absurd (onRg_mem h hj) hn)

/-- Push of an expression on registers. -/
theorem Rn.pushR {i : Fin HS} (hi : i ∉ rg) (hi5 : i.val < 56) {e : Ex HS} (he : OnRg e)
    (ho : okR v c e) (ht : Tame (2 ^ W) e) (hv : BV W v) :
    Rn (.push i e) v c (· = v) (Function.update c i (ev v c e :: c i)) (J6Seg.PJ.cT e W) :=
  Rn.push hi hi5 (Rd_onRg he) (clean_onRg he) ho ht (RB_onRg he hv)

end rgx

/-! ## Calls of the number programs -/

theorem n16 : (16 : Fin HS) ∉ rg := by decide
theorem n17 : (17 : Fin HS) ∉ rg := by decide
theorem n18 : (18 : Fin HS) ∉ rg := by decide
theorem n19 : (19 : Fin HS) ∉ rg := by decide
theorem n27 : (27 : Fin HS) ∉ rg := by decide

theorem RF_G' (s : IState HS) (v : Vr) (c : Cs) {j : Fin HS} (hj : j ∉ rg) :
    (encK s (RF v c)).G j = ints (c j) ++ s.G j := by simp [RF_out hj]

/-- **A call of a number program.** -/
theorem Rn.callX_sol_aux {v : Vr} {c : Cs} {W : ℕ} {d : Fin HS} (hd : d ∈ rg)
    {e16 e17 e18 e27 : Ex HS} (h16 : OnRg e16) (h17 : OnRg e17) (h18 : OnRg e18)
    (h27 : OnRg e27) (o16 : okR v c e16) (o17 : okR v c e17) (o18 : okR v c e18)
    (o27 : okR v c e27) (t16 : Tame (2 ^ W) e16) (t17 : Tame (2 ^ W) e17)
    (t18 : Tame (2 ^ W) e18) (t27 : Tame (2 ^ W) e27) (hv : BV W v)
    {a16 a17 a18 a27 : ℕ} (v16 : ev v c e16 = a16) (v17 : ev v c e17 = a17)
    (v18 : ev v c e18 = a18) (v27 : ev v c e27 = a27)
    (b16 : (a16 : ℤ) < 2 ^ W) (b17 : (a17 : ℤ) < 2 ^ W) (b18 : (a18 : ℤ) < 2 ^ W)
    (b27 : (a27 : ℤ) < 2 ^ W)
    {prog : RS} {r : ℤ} {C : ℕ}
    (hprog : ∀ (t : IState HS) (L16 L17 L18 L27 : List Item), t.G 16 = .int a16 :: L16 →
      t.G 17 = .int a17 :: L17 → t.G 18 = .int a18 :: L18 → t.G 27 = .int a27 :: L27 →
      prog.ok t ∧ prog.run t = t.upd 19 (.int r :: t.G 19) ∧ prog.cost t ≤ C)
    (hr : |r| < 2 ^ W) :
    Rn (callX d e16 e17 e18 e27 prog) v c (· = Function.update v d r) c
      (cCallX e16 e17 e18 e27 W C) := by
  have p1 := Rn.pushR (W := W) n16 (by decide) h16 o16 t16 hv (c := c)
  rw [v16] at p1
  set c1 := Function.update c 16 ((a16 : ℤ) :: c 16) with hc1
  have p2 := Rn.pushR (W := W) n17 (by decide) h17
    (okR_onRg h17 c1 o17) t17 hv (c := c1)
  rw [ev_onRg h17 c1, v17] at p2
  set c2 := Function.update c1 17 ((a17 : ℤ) :: c1 17) with hc2
  have p3 := Rn.pushR (W := W) n18 (by decide) h18
    (okR_onRg h18 c2 o18) t18 hv (c := c2)
  rw [ev_onRg h18 c2, v18] at p3
  set c3 := Function.update c2 18 ((a18 : ℤ) :: c2 18) with hc3
  have p4 := Rn.pushR (W := W) n27 (by decide) h27
    (okR_onRg h27 c3 o27) t27 hv (c := c3)
  rw [ev_onRg h27 c3, v27] at p4
  set c4 := Function.update c3 27 ((a27 : ℤ) :: c3 27) with hc4
  set c5 := Function.update c4 19 (r :: c4 19) with hc5
  have g : ∀ (j : Fin HS) (a : ℕ), j ∉ rg → c4 j = (a : ℤ) :: c j → ∀ s,
      (encK s (RF v c4)).G j = .int a :: (ints (c j) ++ s.G j) := by
    intro j a hj h s; rw [RF_G' s v c4 hj, h]; simp [ints]
  have pP : Rn prog v c4 (· = v) c5 C := by
    refine ⟨v, rfl, fun s => ?_⟩
    obtain ⟨q1, q2, q3⟩ := hprog (encK s (RF v c4)) _ _ _ _
      (g 16 a16 n16 (by simp [hc4, hc3, hc2, hc1]) s)
      (g 17 a17 n17 (by simp [hc4, hc3, hc2, hc1]) s)
      (g 18 a18 n18 (by simp [hc4, hc3, hc2, hc1]) s)
      (g 27 a27 n27 (by simp [hc4, hc3, hc2, hc1]) s)
    refine ⟨q1, ?_, q3⟩
    rw [q2, RF_G' s v c4 n19, show Item.int r :: (ints (c4 19) ++ s.G 19) =
      ints (r :: c4 19) ++ s.G 19 by simp [ints], encK_upd, upd_RF_out n19]
  have h19 : c5 19 = r :: c4 19 := by rw [hc5, Function.update_self]
  have pA := Rn.asg (W := W) (v := v) (c := c5) hd (e := .reg 19)
    (Rd_reg (Or.inr (by rw [h19]; exact List.cons_ne_nil _ _))) (clean_of_regs (by
      intro j hj; simp [Ex.regs] at hj; subst hj; decide))
    (okR_reg (Or.inr (by rw [h19]; exact List.cons_ne_nil _ _))) trivial hv
    (fun j hj => by
      simp [Ex.regs] at hj; subst hj
      simp only [tp, if_neg n19, h19, List.headD_cons]; exact hr.le)
  rw [ev_regO n19 h19] at pA
  have o1 := Rn.pop (v := Function.update v d r) (c := c5) (W := W) n19 (by decide) h19 hr
  have e1 : Function.update c5 19 (c4 19) = c4 := by
    rw [hc5, Function.update_idem, Function.update_eq_self]
  rw [e1] at o1
  have o2 := Rn.pop (v := Function.update v d r) (c := c4) (W := W) n27 (by decide)
    (a := a27) (l := c3 27) (by rw [hc4, Function.update_self]) (by
      rw [abs_of_nonneg (by positivity)]; exact b27)
  have e2 : Function.update c4 27 (c3 27) = c3 := by
    rw [hc4, Function.update_idem, Function.update_eq_self]
  rw [e2] at o2
  have o3 := Rn.pop (v := Function.update v d r) (c := c3) (W := W) n18 (by decide)
    (a := a18) (l := c2 18) (by rw [hc3, Function.update_self]) (by
      rw [abs_of_nonneg (by positivity)]; exact b18)
  have e3 : Function.update c3 18 (c2 18) = c2 := by
    rw [hc3, Function.update_idem, Function.update_eq_self]
  rw [e3] at o3
  have o4 := Rn.pop (v := Function.update v d r) (c := c2) (W := W) n17 (by decide)
    (a := a17) (l := c1 17) (by rw [hc2, Function.update_self]) (by
      rw [abs_of_nonneg (by positivity)]; exact b17)
  have e4 : Function.update c2 17 (c1 17) = c1 := by
    rw [hc2, Function.update_idem, Function.update_eq_self]
  rw [e4] at o4
  have o5 := Rn.pop (v := Function.update v d r) (c := c1) (W := W) n16 (by decide)
    (a := a16) (l := c 16) (by rw [hc1, Function.update_self]) (by
      rw [abs_of_nonneg (by positivity)]; exact b16)
  have e5 : Function.update c1 16 (c 16) = c := by
    rw [hc1, Function.update_idem, Function.update_eq_self]
  rw [e5] at o5
  have T := Rn.seq p1 fun v1 h1 => by
    subst h1
    exact Rn.seq p2 fun v2 h2 => by
      subst h2
      exact Rn.seq p3 fun v3 h3 => by
        subst h3
        exact Rn.seq p4 fun v4 h4 => by
          subst h4
          exact Rn.seq pP fun v5 h5 => by
            subst h5
            exact Rn.seq pA fun v6 h6 => by
              subst h6
              exact Rn.seq o1 fun v7 h7 => by
                subst h7
                exact Rn.seq o2 fun v8 h8 => by
                  subst h8
                  exact Rn.seq o3 fun v9 h9 => by
                    subst h9
                    exact Rn.seq o4 fun v10 h10 => by
                      subst h10
                      exact o5
  refine T.mono (fun _ h => h) ?_
  unfold cCallX; omega

end J6A.PA

