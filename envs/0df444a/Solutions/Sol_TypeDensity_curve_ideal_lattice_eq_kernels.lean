/-- If `(g) + I` and `K ⊇ I` have the same image modulo `I`, then `(g) + I = K`. -/
private theorem span_sup_eq_of_map_eq {A : Type} [CommRing A] (I K : Ideal A) (g : A)
    (h : Ideal.span {Ideal.Quotient.mk I g} = K.map (Ideal.Quotient.mk I)) (hIK : I ≤ K) :
    Ideal.span {g} ⊔ I = K := by
  have h1 : Ideal.span {Ideal.Quotient.mk I g} = (Ideal.span {g}).map (Ideal.Quotient.mk I) := by
    rw [Ideal.map_span, Set.image_singleton]
  have h2 := congrArg (Ideal.comap (Ideal.Quotient.mk I)) h
  rw [h1, Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective,
    Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective] at h2
  have hk : Ideal.comap (Ideal.Quotient.mk I) ⊥ = I := Ideal.mk_ker
  rwa [hk, sup_eq_left.mpr hIK] at h2

end TypeDensity

open TypeDensity

theorem solution (R : Type) [CommRing R] (t x : R)
    [(Ideal.span ({t,x} : Set R)).IsMaximal] [IsNoetherianRing (TypeDensity.BlowupChart R t x)]
    [IsNoetherianRing (TypeDensity.BlowupChart R x t)] (beta : TypeDensity.BlowupRestriction R t x)
    (D : TypeDensity.TwoChartCurveData R t x beta) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hG : ∀ j : ℕ, Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (G.left j)} =
    TypeDensity.leftLevelKernel D j ∧ Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (G.right j)} =
    TypeDensity.rightLevelKernel D j) (j : ℕ) :
    TypeDensity.leftCurveIdeal R t x beta G j = TypeDensity.leftKernel D j ∧ TypeDensity.rightCurveIdeal R t x beta G j = TypeDensity.rightKernel D
        j := by
  have key : ∀ (A : Type) [CommRing A] (ι : Type) (P : ι → Ideal A) [∀ i, (P i).IsPrime]
      (J : ∀ i, Ideal (TypeDensity.CompletedLocalAt A (P i))) (e : A) (g : ∀ i, TypeDensity.CompletedLocalAt A (P i)),
      (∀ i, J i = TypeDensity.finiteLocalCurveIdeal A (P i) e (g i) j) →
      e ^ j ∈ TypeDensity.finiteSupportKernel A ι P J := by
    intro A _ ι P _ J e g hJ
    unfold TypeDensity.finiteSupportKernel
    rw [Submodule.mem_iInf]
    intro i
    rw [Ideal.mem_comap, hJ i, map_pow]
    exact Ideal.subset_span (by simp)
  have hl : (TypeDensity.chartExceptional R t x) ^ j ≤ TypeDensity.leftKernel D j := by
    rw [TypeDensity.chartExceptional, Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
    exact key _ _ _ _ _ (fun s => TypeDensity.leftData D s) (fun _ => rfl)
  have hr : (TypeDensity.chartExceptional R x t) ^ j ≤ TypeDensity.rightKernel D j := by
    rw [TypeDensity.chartExceptional, Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
    exact key _ _ _ _ _ (fun s => TypeDensity.rightData D s) (fun _ => rfl)
  exact ⟨TypeDensity.span_sup_eq_of_map_eq _ _ _ (by rw [(hG j).1]; rfl) hl,
    TypeDensity.span_sup_eq_of_map_eq _ _ _ (by rw [(hG j).2]; rfl) hr⟩
