/-! ## The chain frames -/

/-! ## Splitting a tensor power -/

section Split

variable {ι κ₁ κ₂ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ₁] [DecidableEq κ₁]
  [Fintype κ₂] [DecidableEq κ₂]

/-- **`tens A` on two complementary subfamilies.** -/
theorem tens_split {g₁ : κ₁ → ι} {g₂ : κ₂ → ι} (h₁ : Function.Injective g₁)
    (h₂ : Function.Injective g₂) (hcov : ∀ i, (∃ k, g₁ k = i) ∨ (∃ k, g₂ k = i))
    (hdis : ∀ k₁ k₂, g₁ k₁ ≠ g₂ k₂) (A : Butterfly.M2) :
    subOp g₂ (Butterfly.tens A : Matrix (κ₂ → Fin 2) (κ₂ → Fin 2) ℂ) *
      subOp g₁ (Butterfly.tens A : Matrix (κ₁ → Fin 2) (κ₁ → Fin 2) ℂ) =
      (Butterfly.tens A : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) := by
  rw [subOp_tens h₂, subOp_tens h₁, ← tensF_mul]
  unfold Butterfly.tens
  congr 1
  funext i
  rcases hcov i with ⟨k, rfl⟩ | ⟨k, rfl⟩
  · have hn : ¬ ∃ k', g₂ k' = g₁ k := fun ⟨k', hk'⟩ => hdis k k' hk'.symm
    rw [if_neg hn, if_pos ⟨k, rfl⟩, one_mul]
  · have hn : ¬ ∃ k', g₁ k' = g₂ k := fun ⟨k', hk'⟩ => hdis k' k hk'
    rw [if_pos ⟨k, rfl⟩, if_neg hn, mul_one]

end Split

/-! ## The node and chain subfamilies -/

theorem gN1_inj {m F E : ℕ} (hE : m * F ≤ E) : Function.Injective (gN1 hE) := by
  intro p q h
  simp only [gN1, Fin.mk.injEq] at h
  have hF : 0 < F := Nat.pos_of_ne_zero (fun h0 => by subst h0; exact p.2.elim0)
  have d1 : (p.2.val + F * p.1.val) / F = p.1.val := by
    rw [Nat.add_mul_div_left _ _ hF, Nat.div_eq_of_lt p.2.isLt, zero_add]
  have d2 : (q.2.val + F * q.1.val) / F = q.1.val := by
    rw [Nat.add_mul_div_left _ _ hF, Nat.div_eq_of_lt q.2.isLt, zero_add]
  have m1 : (p.2.val + F * p.1.val) % F = p.2.val := by
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt p.2.isLt]
  have m2 : (q.2.val + F * q.1.val) % F = q.2.val := by
    rw [Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt q.2.isLt]
  have e1 : p.1.val = q.1.val := by rw [← d1, ← d2, h]
  have e2 : p.2.val = q.2.val := by rw [← m1, ← m2, h]
  exact Prod.ext (Fin.ext e1) (Fin.ext e2)

theorem gN2_inj {m F E : ℕ} (hE : m * F + E % m = E) : Function.Injective (gN2 hE) := by
  intro i j h
  simp only [gN2, Fin.mk.injEq] at h
  exact Fin.ext (by omega)

/-- **The node split** of `tens A` on `E = m F + E mod m` bits. -/
theorem tens_node {m F E : ℕ} (hF : 0 < F) (h1 : m * F ≤ E) (h2 : m * F + E % m = E)
    (A : Butterfly.M2) :
    subOp (gN2 h2) (Butterfly.tens A : Matrix (Fin (E % m) → Fin 2) (Fin (E % m) → Fin 2) ℂ) *
      subOp (gN1 h1) (Butterfly.tens A : Matrix (Fin m × Fin F → Fin 2) (Fin m × Fin F → Fin 2) ℂ) =
      (Butterfly.tens A : Matrix (Fin E → Fin 2) (Fin E → Fin 2) ℂ) := by
  refine tens_split (gN1_inj h1) (gN2_inj h2) (fun i => ?_) (fun p j => ?_) A
  · by_cases hi : i.val < m * F
    · left
      have hm : 0 < m := Nat.pos_of_ne_zero (fun h0 => by subst h0; simp at hi)
      refine ⟨(⟨i.val / F, ?_⟩, ⟨i.val % F, Nat.mod_lt _ hF⟩), ?_⟩
      · rw [Nat.div_lt_iff_lt_mul hF]; exact hi
      · apply Fin.ext; simp only [gN1]; exact Nat.mod_add_div _ _
    · right
      refine ⟨⟨i.val - m * F, by omega⟩, ?_⟩
      apply Fin.ext; simp only [gN2]; omega
  · intro h
    have := congrArg Fin.val h
    simp only [gN1, gN2] at this
    have := gN1_lt (le_refl (m * F)) p
    omega

/-! ## Strides -/

theorem st_gN1 {m K e F E S0 : ℕ} (h1 : m * F ≤ E) :
    (fun i : Fin E => 2 ^ (e - K * i.val) * S0) ∘ gN1 h1 = stH m K e F S0 := by
  funext p; simp only [Function.comp, gN1, stH, IL3F.posR]

theorem st_gN2 {m K e F E S0 : ℕ} (h2 : m * F + E % m = E) :
    (fun i : Fin E => 2 ^ (e - K * i.val) * S0) ∘ gN2 h2 =
      fun j : Fin (E % m) => 2 ^ ((e - K * (m * F)) - K * j.val) * S0 := by
  funext j; simp only [Function.comp, gN2, mul_add, Nat.sub_sub]

end IntMul.Kappa.R6.IL3H

