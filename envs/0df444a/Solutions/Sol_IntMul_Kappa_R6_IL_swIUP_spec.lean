-- Source module: Solutions.KFEBit
/-!
# KFE: fine Lemma 12, unconditional versions

* `lemma12_fine_rat`: for a rational-label circuit with the hypotheses of `prop11_ratLabels`, there
  are `T`, `q₀` such that for every prime `q > q₀` the fine item-language program `l12F q m W`
  (procedure table: the fine uniform Prop. 11 code `KFD.progF (Qc.toCircuit 1) (edgeTplQ Qc)`)
  interchanges the two `[2^u]` fields of every bit array at cost
  `≤ K ((V + 1) u^τ + (u+1)^c (Bb + 2)²)`, `c = clog_m (S + 1) + 1` (`S` the frame rank sum),
  for every item size bound `Bb ≥ zsz (T (q² V + 1)²)`.
* `lemma12_fine`: the same for the bit network of Prop. 7 (`m = 10⁶`, `W = W_b`,
  `τ = 1 − 2^{−50}`).
* `lemma12_fine_lin`: under the explicit condition `(u+1)^c (Bb+2)² ≤ V`, the cost is
  `≤ 2K (V+1) u^τ`.  Since `V ≥ 4^u` and the admissible `Bb` is `O(log V)`, the overhead term is
  `O(polylog V) = o(V)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFE

open IntMul RS AModel AModelL12 AModelRat AModelFac Finset KIL KFD

/-! ## The overhead term -/

theorem two_pow_le_vol {u : ℕ} (Pre G Suf : Shape) (hPre : ∀ a ∈ Pre, 1 ≤ a)
    (hG : ∀ a ∈ G, 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a) : 2 ^ u ≤ vol (binShape Pre G Suf (2 ^ u)) := by
  rw [KIL.vol_binShape]
  have h1 := one_le_vol hPre; have h2 := one_le_vol hG; have h3 := one_le_vol hS
  have h4 : 1 ≤ 2 ^ u := Nat.one_le_two_pow
  calc 2 ^ u = 1 * (2 ^ u * (1 * (1 * 1))) := by ring
    _ ≤ vol Pre * (2 ^ u * (vol G * (2 ^ u * vol Suf))) := by gcongr

/-- `u + 1 ≤ zsz V` for the bit volume `V ≥ 2^u`: the overhead `(u+1)^c (Bb+2)²` is polylogarithmic
in `V`. -/
theorem succ_le_zsz_vol {u : ℕ} (Pre G Suf : Shape) (hPre : ∀ a ∈ Pre, 1 ≤ a)
    (hG : ∀ a ∈ G, 1 ≤ a) (hS : ∀ a ∈ Suf, 1 ≤ a) :
    u + 1 ≤ zsz ((vol (binShape Pre G Suf (2 ^ u)) : ℕ) : ℤ) := by
  by_contra h
  have h' : zsz ((vol (binShape Pre G Suf (2 ^ u)) : ℕ) : ℤ) ≤ u := by omega
  rw [zsz_le_iff] at h'
  have := two_pow_le_vol (u := u) Pre G Suf hPre hG hS
  simp only [Int.natAbs_natCast] at h'
  omega

end NLogN.KFE

end

section
-- Source module: Solutions.KFBCanon
/-!
# KFB §0: fine Lemma 12 with the canonical item-size bound

`lemma12_fine` (KFEBit) bounds the cost by `K ((V+1) u^τ + (u+1)^cE (Bb+2)²)` for every item
size bound `Bb ≥ zsz (T (q² V + 1)²)`.  Here we take the minimal admissible `Bb` and absorb the
overhead term: since `u + 1 ≤ zsz V`, `Bb = O(zsz V)`, and `(zsz V)^k ≤ C_k · V`
(`polylog_le_lin`), the overhead is `≤ C (V + 1)`.

* `pow_le_two_pow`: for each `k` there is `C` with `n^k ≤ C 2^n` for all `n`.
* `zsz_canon_le`: `zsz (T (q² V + 1)²) ≤ A + 2 zsz V` with `A = zsz (T (q²+1)²)`.
* **`lemma12_fine_canon`**: `∃ T q₀, ∀ prime q > q₀, ∃ K' ≥ 0`, for all `u ≥ 1` and positive
  shapes, the fine program `l12F` interchanges the two `[2^u]` fields at a cost
  `c ≤ K' (V + 1) u^τ` (no `Bb` hypothesis left; the run uses `Bb = zsz (T (q² V + 1)²)`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel AModelL12 AModelRat AModelFac Finset KIL KFD KFE Filter

/-- Polynomial versus exponential: `n^k ≤ C 2^n`. -/
theorem pow_le_two_pow (k : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, (n : ℝ) ^ k ≤ C * 2 ^ n := by
  have ht := tendsto_pow_const_div_const_pow_of_one_lt k (r := 2) (by norm_num)
  obtain ⟨C, hC⟩ := ht.bddAbove_range
  refine ⟨max C 0, le_max_right _ _, fun n => ?_⟩
  have h1 : (n : ℝ) ^ k / 2 ^ n ≤ max C 0 := le_trans (hC ⟨n, rfl⟩) (le_max_left _ _)
  have h2 : (0 : ℝ) < 2 ^ n := by positivity
  rwa [div_le_iff₀ h2] at h1

/-- `2^(zsz V - 1) ≤ V` for `V ≥ 1`. -/
theorem two_pow_pred_zsz_le {V : ℕ} (hV : 1 ≤ V) : 2 ^ (zsz (V : ℤ) - 1) ≤ V := by
  by_contra h
  push Not at h
  have h' : zsz (V : ℤ) ≤ zsz (V : ℤ) - 1 := by
    rw [zsz_le_iff]; simpa using h
  have : 1 ≤ zsz (V : ℤ) := by
    by_contra h0
    have h00 : zsz (V : ℤ) ≤ 0 := by omega
    rw [zsz_le_iff] at h00
    simp at h00; omega
  omega

theorem two_pow_zsz_le {V : ℕ} (hV : 1 ≤ V) : 2 ^ zsz (V : ℤ) ≤ 2 * V := by
  have h1 := two_pow_pred_zsz_le hV
  have : 1 ≤ zsz (V : ℤ) := by
    by_contra h0
    have h00 : zsz (V : ℤ) ≤ 0 := by omega
    rw [zsz_le_iff] at h00
    simp at h00; omega
  calc 2 ^ zsz (V : ℤ) = 2 * 2 ^ (zsz (V : ℤ) - 1) := by
        rw [← pow_succ']; congr 1; omega
    _ ≤ 2 * V := by omega

theorem one_le_zsz {V : ℕ} (hV : 1 ≤ V) : 1 ≤ zsz (V : ℤ) := by
  by_contra h0
  have h00 : zsz (V : ℤ) ≤ 0 := by omega
  rw [zsz_le_iff] at h00
  simp at h00; omega

/-- The overhead estimate: `(u+1)^c (Bb+2)² ≤ D (V+1)` for the canonical `Bb`, once `u+1 ≤ zsz V`. -/
theorem overhead_le (c A : ℕ) : ∃ D : ℝ, 0 ≤ D ∧ ∀ (u V Bb : ℕ), 1 ≤ V → u + 1 ≤ zsz (V : ℤ) →
    Bb ≤ A + 2 * zsz (V : ℤ) → ((u : ℝ) + 1) ^ c * ((Bb : ℝ) + 2) ^ 2 ≤ D * V := by
  obtain ⟨C, hC0, hC⟩ := pow_le_two_pow (c + 2)
  refine ⟨((A : ℝ) + 4) ^ 2 * C * 2, by positivity, fun u V Bb hV hu hB => ?_⟩
  set L := zsz (V : ℤ)
  have hL1 : 1 ≤ L := one_le_zsz hV
  have hL : (1 : ℝ) ≤ L := by exact_mod_cast hL1
  have h1 : ((u : ℝ) + 1) ≤ L := by exact_mod_cast hu
  have h2 : ((Bb : ℝ) + 2) ≤ ((A : ℝ) + 4) * L := by
    have : (Bb : ℝ) ≤ A + 2 * L := by exact_mod_cast hB
    nlinarith
  have h3 : ((u : ℝ) + 1) ^ c ≤ (L : ℝ) ^ c := pow_le_pow_left₀ (by positivity) h1 c
  have h4 : ((Bb : ℝ) + 2) ^ 2 ≤ (((A : ℝ) + 4) * L) ^ 2 := pow_le_pow_left₀ (by positivity) h2 2
  have h5 : (L : ℝ) ^ (c + 2) ≤ C * 2 ^ L := hC L
  have h6 : ((2 : ℝ) ^ L) ≤ 2 * V := by exact_mod_cast two_pow_zsz_le hV
  calc ((u : ℝ) + 1) ^ c * ((Bb : ℝ) + 2) ^ 2 ≤ (L : ℝ) ^ c * (((A : ℝ) + 4) * L) ^ 2 :=
        mul_le_mul h3 h4 (by positivity) (by positivity)
    _ = ((A : ℝ) + 4) ^ 2 * (L : ℝ) ^ (c + 2) := by ring
    _ ≤ ((A : ℝ) + 4) ^ 2 * (C * 2 ^ L) := mul_le_mul_of_nonneg_left h5 (by positivity)
    _ ≤ ((A : ℝ) + 4) ^ 2 * (C * (2 * V)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h6 hC0) (by positivity)
    _ = ((A : ℝ) + 4) ^ 2 * C * 2 * V := by ring

end NLogN.KFB

end

section
-- Source module: Solutions.KFBQop
/-!
# KFB: the two-stream pass `qop` (fine cost)

On a Gaussian array viewed as consecutive blocks `[u ‖ v]` of two streams of `B1` entries each,
`qop Ms` applies the small `2 × 2` Gaussian matrix `M_p = Ms[p mod L]` (`L = |Ms|`) to block `p`:
`(u, v) ↦ (M₀₀ u + M₀₁ v, M₁₀ u + M₁₁ v)` entrywise.  With a single matrix this is a
selected-bit kernel on a field `[2]` (the `C` kernel (25) scaled by 2, a phase on the selected
half, a sign); with the period `[1, X]` it is a CNOT whose control is the field just before.

Per block: one move of the block to a scratch stack (reversal), the two streams distributed to
four register stacks (real/imaginary parts), one zip loop computing the outputs with linear
register expressions (`lcE`), the second output stream moved back in order.  Every entry is
touched `O(1)` times; loop counters are unary (`fcode`) with overhead linear in the counts.

Stacks: data `0`; scratch `qT = 33`, output accumulator `qA = 34`, `qO = 35`; stream registers
`36 … 39`; counters `30, 31`; counts `48 … 52` (`G`, `B1`, `2B1`, `4B1`, total items).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel KIL KFD

/-! ## Pushing a linear combination -/

/-! ## The zip loop -/

/-! ## One block -/

theorem Cnt.congr {s : IState HS} {f g : Fin HS → List ℤ} {B1 : ℕ} (h : Cnt s f B1)
    (h1 : g rB = f rB) (h2 : g rB2 = f rB2) (h3 : g rB4 = f rB4) : Cnt s g B1 :=
  ⟨by simp only [encK_G, h1]; exact h.b, by simp only [encK_G, h2]; exact h.b2,
    by simp only [encK_G, h3]; exact h.b4⟩

