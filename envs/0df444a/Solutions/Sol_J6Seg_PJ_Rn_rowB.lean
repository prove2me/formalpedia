theorem bOE_eval {sN tN cN : ℕ} (h22 : v 22 = sN) (h23 : v 23 = tN) (h1 : v 1 = cN) :
    bOE.eval (encK s (RF v c)) = bOf sN tN cN := by
  simp only [bOE, NLogN.Ex.ediv_eval, Ex.eval, top_RF (show (22 : Fin HS) ∈ rg by decide),
    top_RF (show (23 : Fin HS) ∈ rg by decide), top_RF (show (1 : Fin HS) ∈ rg by decide),
    h22, h23, h1, bOf]
