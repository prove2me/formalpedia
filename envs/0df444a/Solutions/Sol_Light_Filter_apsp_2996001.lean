theorem kOf_pos {n : ℕ} (hn : 1 ≤ n) : 1 ≤ kOf n := Nat.size_pos.2 hn

theorem two_pow_kOf_sub_one_le {n : ℕ} (hn : 1 ≤ n) : 2 ^ (kOf n - 1) ≤ n := by
