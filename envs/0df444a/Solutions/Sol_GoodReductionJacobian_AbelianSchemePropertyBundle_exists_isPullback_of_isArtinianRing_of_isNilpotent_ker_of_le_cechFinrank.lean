def Lifts (T' T : Type u) [CommRing T'] [CommRing T] (π : T' →+* T)
    {A₀ : Scheme.{u}} (f₀ : A₀ ⟶ Spec (CommRingCat.of T)) (L₀ : RelativeGroupLaw T f₀) : Prop :=
  ∃ (A : Scheme.{u}) (f : A ⟶ Spec (CommRingCat.of T')) (L : RelativeGroupLaw T' f) (_ : L.IsCommutative)
      (_ : AbelianSchemePropertyBundle T' f)
      (g : A₀ ⟶ A) (hg : IsPullback g f₀ f (Spec.map (CommRingCat.ofHom π))),
      ∀ {S : Scheme.{u}} (t : S ⟶ Spec (CommRingCat.of T)) (P Q : SchemeHomOver t f₀),
        (L₀.mul t P Q).1 ≫ g =
          (L.mul (t ≫ Spec.map (CommRingCat.ofHom π))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1

def H1W {T : Type u} [CommRing T] {A₀ : Scheme.{u}} (f₀ : A₀ ⟶ Spec (CommRingCat.of T)) : Prop :=
  ∃ (k : Type u) (_ : Field k) (_ : IsAlgClosed k)
    (Ak : Scheme.{u}) (fk : Ak ⟶ Spec (CommRingCat.of k)) (i : Ak ⟶ A₀) (ρ : T →+* k)
    (_ : IsPullback i fk f₀ (Spec.map (CommRingCat.ofHom ρ))) (g : ℕ) (_ : SmoothOfRelativeDimension g fk)
    (𝒦 : Ak.OrderedAffineCover), g ≤ (OModulePresheaf.unit fk).cechFinrank 𝒦 1

theorem H1W.of_isPullback {T' T : Type u} [CommRing T'] [CommRing T] (π : T' →+* T)
    {A₀ : Scheme.{u}} {f₀ : A₀ ⟶ Spec (CommRingCat.of T)} {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of T')}
    (g : A₀ ⟶ A) (hg : IsPullback g f₀ f (Spec.map (CommRingCat.ofHom π))) (h : H1W f₀) : H1W f := by
  obtain ⟨k, _, _, Ak, fk, i, ρ, hi, d, _, 𝒦, hle⟩ := h
  refine ⟨k, inferInstance, inferInstance, Ak, fk, i ≫ g, ρ.comp π, ?_, d, inferInstance, 𝒦, hle⟩
  have : Spec.map (CommRingCat.ofHom (ρ.comp π)) = Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom π) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rw [this]
  exact hi.paste_horiz hg

theorem surjective_specMap (T' T : Type u) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T']
    [CommRing T] (π : T' →+* T) (hker : IsNilpotent (RingHom.ker π)) :
    Surjective (Spec.map (CommRingCat.ofHom π)) := by
  have hT : Nontrivial T := by
    by_contra h
    rw [not_nontrivial_iff_subsingleton] at h
    obtain ⟨n, hn⟩ := hker
    have hk : RingHom.ker π = ⊤ := by
      ext x; simp [Subsingleton.elim (π x) 0]
    rw [hk, ← Ideal.one_eq_top, one_pow, Ideal.one_eq_top, Ideal.zero_eq_bot] at hn
    exact absurd hn top_ne_bot
  have hsub : Subsingleton (PrimeSpectrum T') := by
    refine ⟨fun p q => PrimeSpectrum.ext ?_⟩
    have hp := (IsArtinianRing.isPrime_iff_isMaximal p.asIdeal).mp p.isPrime
    have hq := (IsArtinianRing.isPrime_iff_isMaximal q.asIdeal).mp q.isPrime
    rw [IsLocalRing.eq_maximalIdeal hp, IsLocalRing.eq_maximalIdeal hq]
  obtain ⟨m, hm⟩ := Ideal.exists_maximal T
  exact ⟨fun p => ⟨(⟨m, hm.isPrime⟩ : PrimeSpectrum T), @Subsingleton.elim _ hsub _ _⟩⟩

theorem coe_mul_eq_of_eq {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {S : Scheme.{u}} {t t' : S ⟶ Spec (CommRingCat.of R)} (h : t = t')
    (P Q : SchemeHomOver t f) (P' Q' : SchemeHomOver t' f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t P Q).1 = (L.mul t' P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem small (T' T : Type u) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T']
    [IsAlgClosed (ResidueField T')] [CommRing T] (π : T' →+* T) (hπ : Function.Surjective π)
    (hker : IsNilpotent (RingHom.ker π)) (hsmall : RingHom.ker π * maximalIdeal T' = ⊥)
    {A₀ : Scheme.{u}} (f₀ : A₀ ⟶ Spec (CommRingCat.of T)) (L₀ : RelativeGroupLaw T f₀) (hc₀ : L₀.IsCommutative)
    (h₀ : AbelianSchemePropertyBundle T f₀) (hH1 : H1W f₀) : Lifts T' T π f₀ L₀ := by
  obtain ⟨A, f, hs, g, hg⟩ :=
    AbelianSchemePropertyBundle.exists_smooth_isPullback_of_ker_mul_maximalIdeal_eq_bot_of_le_cechFinrank
      T' T π hπ hker hsmall f₀ L₀ hc₀ h₀ hH1
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom π)) :=
    IsClosedImmersion.spec_of_surjective _ hπ
  have : Surjective (Spec.map (CommRingCat.ofHom π)) := surjective_specMap T' T π hker
  have hlft : LocallyOfFiniteType f := by
    have : Smooth f := hs
    infer_instance
  have hp : IsProper f :=
    (AlgebraicGeometry.isClosedImmersion_and_surjective_and_isProper_of_isPullback_of_surjective
      (Spec.map (CommRingCat.ofHom π)) hg).2.2.2.2 h₀.proper hlft
  obtain ⟨L, hc, h, hom⟩ :=
    RelativeGroupLaw.exists_isCommutative_comp_eq_mul_of_isPullback_of_ker_mul_maximalIdeal_eq_bot
      T' T π hπ hker hsmall f₀ L₀ hc₀ h₀ f hs hp g hg
  exact ⟨A, f, L, hc, h, g, hg, hom⟩

theorem step (n : ℕ) : ∀ (T' T : Type u) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T']
    [IsAlgClosed (ResidueField T')] [CommRing T] (π : T' →+* T) (_hπ : Function.Surjective π)
    (_hker : IsNilpotent (RingHom.ker π)) (_hn : RingHom.ker π * maximalIdeal T' ^ n = ⊥)
    {A₀ : Scheme.{u}} (f₀ : A₀ ⟶ Spec (CommRingCat.of T)) (L₀ : RelativeGroupLaw T f₀) (_hc₀ : L₀.IsCommutative)
    (_h₀ : AbelianSchemePropertyBundle T f₀) (_hH1 : H1W f₀), Lifts T' T π f₀ L₀ := by
  induction n with
  | zero =>
    intro T' T _ _ _ _ _ π hπ hker hn A₀ f₀ L₀ hc₀ h₀ hH1
    have hsmall : RingHom.ker π * maximalIdeal T' = ⊥ := by
      rw [pow_zero, Ideal.one_eq_top, Ideal.mul_top] at hn
      rw [hn, Ideal.bot_mul]
    exact small T' T π hπ hker hsmall f₀ L₀ hc₀ h₀ hH1
  | succ n ih =>
    intro T' T _ _ _ _ _ π hπ hker hn A₀ f₀ L₀ hc₀ h₀ hH1

    have hkertop : RingHom.ker π ≠ ⊤ := by
      intro h
      obtain ⟨k, hk⟩ := hker
      rw [h, ← Ideal.one_eq_top, one_pow, Ideal.one_eq_top, Ideal.zero_eq_bot] at hk
      exact top_ne_bot hk

    set J : Ideal T' := RingHom.ker π * maximalIdeal T' ^ n with hJ
    have hJle : J ≤ RingHom.ker π := Ideal.mul_le_left
    have hJm : J * maximalIdeal T' = ⊥ := by rw [hJ, mul_assoc, ← pow_succ, hn]
    have hJne : J ≠ ⊤ := ne_top_of_le_ne_top hkertop hJle
    have hJlem : J ≤ maximalIdeal T' := le_maximalIdeal hJne

    haveI : Nontrivial (T' ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJne
    haveI : IsLocalRing (T' ⧸ J) := IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    haveI : IsLocalHom (Ideal.Quotient.mk J) := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    have hm₁ : (maximalIdeal T').map (Ideal.Quotient.mk J) = maximalIdeal (T' ⧸ J) := by
      refine (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
        (maximalIdeal.isMaximal T')).resolve_left ?_ |> IsLocalRing.eq_maximalIdeal
      intro htop
      have := Ideal.comap_map_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective (maximalIdeal T')
      rw [htop, Ideal.comap_top, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker, sup_eq_left.mpr hJlem] at this
      exact (maximalIdeal.isMaximal T').ne_top this.symm
    haveI : IsAlgClosed (ResidueField (T' ⧸ J)) := by
      have hsurj : Function.Surjective (ResidueField.map (Ideal.Quotient.mk J)) := by
        intro y
        obtain ⟨x, rfl⟩ := residue_surjective y
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
        exact ⟨residue T' x, ResidueField.map_residue _ x⟩
      exact IsAlgClosed.of_ringEquiv (ResidueField T') (ResidueField (T' ⧸ J))
        (RingEquiv.ofBijective _ ⟨(ResidueField.map (Ideal.Quotient.mk J)).injective, hsurj⟩)

    set π₁ : T' →+* T' ⧸ J := Ideal.Quotient.mk J with hπ₁
    set π₂ : T' ⧸ J →+* T := Ideal.Quotient.lift J π (fun a ha => hJle ha) with hπ₂
    have hcomp : π₂.comp π₁ = π := RingHom.ext fun x => by simp [π₁, π₂]
    have hπ₂ : Function.Surjective π₂ := fun y => by
      obtain ⟨x, rfl⟩ := hπ y
      exact ⟨π₁ x, by simp [π₁, π₂]⟩
    have hker₂le : RingHom.ker π₂ ≤ (RingHom.ker π).map π₁ := by
      intro y hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine Ideal.mem_map_of_mem _ ?_
      rw [RingHom.mem_ker] at hy ⊢
      simpa [π₂] using hy
    have hker₂ : IsNilpotent (RingHom.ker π₂) := by
      obtain ⟨k, hk⟩ := hker
      refine ⟨k, ?_⟩
      rw [Ideal.zero_eq_bot] at hk ⊢
      exact le_bot_iff.mp ((Ideal.pow_right_mono hker₂le k).trans
        (by rw [← Ideal.map_pow, hk, Ideal.map_bot]))
    have hn₂ : RingHom.ker π₂ * maximalIdeal (T' ⧸ J) ^ n = ⊥ := by
      refine le_bot_iff.mp ((Ideal.mul_mono hker₂le le_rfl).trans ?_)
      rw [← hm₁, ← Ideal.map_pow, ← Ideal.map_mul, ← hJ]
      simp [π₁, Ideal.map_quotient_self]

    obtain ⟨A₁, f₁, L₁, hc₁, h₁, g₀, hg₀, hom₀⟩ := ih (T' ⧸ J) T π₂ hπ₂ hker₂ hn₂ f₀ L₀ hc₀ h₀ hH1

    have hker₁ : RingHom.ker π₁ = J := Ideal.mk_ker
    have hnil₁ : IsNilpotent (RingHom.ker π₁) :=
      ⟨2, by rw [hker₁, pow_two, Ideal.zero_eq_bot]; exact le_bot_iff.mp ((Ideal.mul_mono_right hJlem).trans hJm.le)⟩
    have hsmall₁ : RingHom.ker π₁ * maximalIdeal T' = ⊥ := by rw [hker₁]; exact hJm
    obtain ⟨A, f, L, hc, h, g₁, hg₁, hom₁⟩ :=
      small T' (T' ⧸ J) π₁ Ideal.Quotient.mk_surjective hnil₁ hsmall₁ f₁ L₁ hc₁ h₁ (hH1.of_isPullback π₂ g₀ hg₀)

    have hSpec : Spec.map (CommRingCat.ofHom π) =
        Spec.map (CommRingCat.ofHom π₂) ≫ Spec.map (CommRingCat.ofHom π₁) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
    have hg : IsPullback (g₀ ≫ g₁) f₀ f (Spec.map (CommRingCat.ofHom π)) := by
      rw [hSpec]; exact hg₀.paste_horiz hg₁
    refine ⟨A, f, L, hc, h, g₀ ≫ g₁, hg, ?_⟩
    intro S t P Q
    rw [← Category.assoc, hom₀, hom₁]
    exact coe_mul_eq_of_eq L (by rw [hSpec, Category.assoc]) _ _ _ _
      (by simp only [Category.assoc]) (by simp only [Category.assoc])

end GoodReductionJacobian.P2mAvInfLift

open GoodReductionJacobian.P2mAvInfLift in
theorem solution
    (T' T : Type u) [CommRing T'] [IsLocalRing T'] [IsArtinianRing T'] [IsAlgClosed (ResidueField T')]
    [CommRing T] (π : T' →+* T) (hπ : Function.Surjective π) (hker : IsNilpotent (RingHom.ker π))
    {A₀ : Scheme.{u}} (f₀ : A₀ ⟶ Spec (CommRingCat.of T)) (L₀ : RelativeGroupLaw T f₀) (hc₀ : L₀.IsCommutative)
    (h₀ : AbelianSchemePropertyBundle T f₀)
    (hH1 : ∃ (k : Type u) (_ : Field k) (_ : IsAlgClosed k)
      (Ak : Scheme.{u}) (fk : Ak ⟶ Spec (CommRingCat.of k)) (i : Ak ⟶ A₀) (ρ : T →+* k)
      (_ : IsPullback i fk f₀ (Spec.map (CommRingCat.ofHom ρ))) (g : ℕ) (_ : SmoothOfRelativeDimension g fk)
      (𝒦 : Ak.OrderedAffineCover), g ≤ (OModulePresheaf.unit fk).cechFinrank 𝒦 1) :
    ∃ (A : Scheme.{u}) (f : A ⟶ Spec (CommRingCat.of T')) (L : RelativeGroupLaw T' f) (_ : L.IsCommutative)
      (_ : AbelianSchemePropertyBundle T' f)
      (g : A₀ ⟶ A) (hg : IsPullback g f₀ f (Spec.map (CommRingCat.ofHom π))),
      ∀ {S : Scheme.{u}} (t : S ⟶ Spec (CommRingCat.of T)) (P Q : SchemeHomOver t f₀),
        (L₀.mul t P Q).1 ≫ g =
          (L.mul (t ≫ Spec.map (CommRingCat.ofHom π))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1 := by
  obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := T')
  rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.zero_eq_bot] at hn
  have hn' : RingHom.ker π * maximalIdeal T' ^ n = ⊥ :=
    le_bot_iff.mp ((Ideal.mul_le_right).trans hn.le)
  exact step n T' T π hπ hker hn' f₀ L₀ hc₀ h₀ hH1

end S_GoodReductionJacobian_AbelianSchemePropertyBundle_exists_isPullback_of_isArtinianRing_of_isNilpotent_ker_of_le_cechFinrank
