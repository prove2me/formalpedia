theorem iteratedDeriv_mono_self (c : ℝ) (m : ℕ) :
    iteratedDeriv m (fun x : ℝ => c * x ^ m) 0 = c * (m.factorial : ℝ) := by
  have hd : iteratedDeriv m (fun y : ℝ => c * y ^ m) 0
      = c * iteratedDeriv m (fun y : ℝ => y ^ m) 0 :=
    iteratedDeriv_const_mul (𝕜 := ℝ) (n := m) (x := (0 : ℝ)) c (by fun_prop)
  rw [hd, iteratedDeriv_pow]
  simp [Nat.descFactorial_self]

theorem iteratedDeriv_mono_ne (c : ℝ) {m j : ℕ} (h : m ≠ j) :
    iteratedDeriv j (fun x : ℝ => c * x ^ m) 0 = 0 := by
  have hd : iteratedDeriv j (fun y : ℝ => c * y ^ m) 0
      = c * iteratedDeriv j (fun y : ℝ => y ^ m) 0 :=
    iteratedDeriv_const_mul (𝕜 := ℝ) (n := j) (x := (0 : ℝ)) c (by fun_prop)
  rw [hd, iteratedDeriv_pow]
  rcases lt_or_gt_of_ne h with hlt | hgt
  · rw [Nat.descFactorial_eq_zero_iff_lt.mpr hlt]; simp
  · rw [zero_pow (Nat.sub_pos_of_lt hgt).ne']; simp

