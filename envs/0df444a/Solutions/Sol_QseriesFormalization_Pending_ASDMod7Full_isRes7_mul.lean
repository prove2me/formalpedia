open QseriesFormalization QseriesFormalization.Pending
open PowerSeries
open QseriesFormalization.PartIV.Ch19
open QseriesFormalization.Pending.Hirschhorn7
theorem solution {R : Type*} [CommRing R] {r s : ℕ} {φ ψ : R⟦X⟧}
    (hφ : IsRes7 r φ) (hψ : IsRes7 s ψ) :
    IsRes7 ((r + s) % 7) (φ * ψ) := by
  intro n hn
  rw [PowerSeries.coeff_mul]
  apply Finset.sum_eq_zero
  rintro ⟨i, j⟩ hij
  rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
  by_cases hi : i % 7 = r
  · by_cases hj : j % 7 = s
    · exfalso
      apply hn
      rw [← hij, Nat.add_mod, hi, hj]
    · change φ.coeff i * ψ.coeff j = 0
      rw [hψ j hj, mul_zero]
  · change φ.coeff i * ψ.coeff j = 0
    rw [hφ i hi, zero_mul]
