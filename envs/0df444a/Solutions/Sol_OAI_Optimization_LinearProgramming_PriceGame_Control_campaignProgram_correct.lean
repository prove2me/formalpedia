theorem padded_header_budget (i : PublicInput) :
    (eiPad i).length ≤ 6*(i.goods+i.range.size+1)+4 := by
  rw [eiPad_length,encodeInput_length]
  have hg : i.goods.size ≤ i.goods := Nat.size_le.mpr i.goods.lt_two_pow_self
