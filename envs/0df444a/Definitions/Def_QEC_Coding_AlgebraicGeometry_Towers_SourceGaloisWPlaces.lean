namespace QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth
noncomputable section
open IntermediateField Polynomial
theorem sourceGaloisBaseW_transcendental : Transcendental F256 galoisBaseW := by
  have hdegree :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree = 16 := by
    calc
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).natDegree =
          (Polynomial.X ^ 16 : Polynomial F256).natDegree :=
        Polynomial.natDegree_add_eq_left_of_natDegree_lt (by norm_num)
      _ = 16 := by norm_num
  have hmonic :
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256).Monic :=
    Polynomial.monic_X_pow_add (by norm_num)
  have hw :
      galoisBaseW = algebraMap (Polynomial F256) (RatFunc F256)
        (Polynomial.X ^ 16 + Polynomial.X) := by
    simp [galoisBaseW, RatFunc.algebraMap_X]
  rw [hw]
  simpa only [RatFunc.aeval_X_left_eq_algebraMap] using
    RatFunc.transcendental_X.aeval
      (Polynomial.X ^ 16 + Polynomial.X : Polynomial F256)
      (by simp [hdegree])
      (by simp [hmonic.leadingCoeff])
noncomputable def sourceGaloisWFieldGenerator : SourceGaloisWField :=
  ⟨galoisBaseW, by
    change galoisBaseW ∈ IntermediateField.adjoin F256 {galoisBaseW}
    exact IntermediateField.subset_adjoin F256 {galoisBaseW}
      (Set.mem_singleton galoisBaseW)⟩
noncomputable def sourceGaloisWFieldEquivRatFunc :
    RatFunc F256 ≃ₐ[F256] SourceGaloisWField :=
  RatFunc.algEquivOfTranscendental galoisBaseW
    sourceGaloisBaseW_transcendental
noncomputable def sourceGaloisWZeroPlace : GlobalPlace F256 SourceGaloisWField :=
  GlobalPlace.comapAlgEquiv sourceGaloisWFieldEquivRatFunc.symm
    zeroBaseRationalPlace.place
noncomputable def sourceGaloisWInfinityPlace : GlobalPlace F256 SourceGaloisWField :=
  GlobalPlace.comapAlgEquiv sourceGaloisWFieldEquivRatFunc.symm
    (GlobalPlace.rationalInfinity F256)
end
end QEC.Coding.AlgebraicGeometry.F256GarciaStichtenoth


