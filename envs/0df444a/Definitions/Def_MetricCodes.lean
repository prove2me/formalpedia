        (arbitraryRowAxialLowerScalar low row)⁻¹ ^ 2 =
      internalRowLowerGramScalar high row *
        plusProbability (n + 1) low mu row := by
  subst high
  exact canonicalAdjacentProjectedRaiseCoefficient_sq_of_fischerGram
