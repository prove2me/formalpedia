/-- The actual Boolean program computes the bounded joint ticket and all
base-q digits. The caller handles the explicit success flag. -/
def jointDrawNumbers (input : ℕ × (List Unit × Str)) : Bool × List ℕ :=
  let count := _root_.Integration9_9.LARCoinMachine.powerWithSlots (input.1,input.2.1)
  let ticket := bitValue (input.2.2.take (Nat.size count))
