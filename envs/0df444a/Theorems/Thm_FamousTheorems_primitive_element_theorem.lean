-- title:
--   The primitive element theorem
-- statement:
--   **The primitive element theorem.** Every finite separable field extension $E/F$ is simple: there is $\alpha\in E$ with $E=F(\alpha)$.
--
--   In particular every finite extension of a field of characteristic zero, such as every number field, is generated by one element. This reduces many questions to the study of a single minimal polynomial and is used throughout Galois theory and algebraic number theory.
--
--   **Formalization note.** Mathlib's `Field.exists_primitive_element`; `F⟮α⟯` is the intermediate field generated by `α`, and `⊤` is `E` itself.
-- source:
--   Listed in Mathlib's curated theorem manifests (docs/1000.yaml); formalized in Mathlib as `Field.exists_primitive_element`. Proof here reduces to that Mathlib result.

import Mathlib

namespace FamousTheorems

open IntermediateField

theorem primitive_element_theorem (F E : Type*) [Field F] [Field E] [Algebra F E] [FiniteDimensional F E] [Algebra.IsSeparable F E] :
    ∃ α : E, F⟮α⟯ = ⊤ := by sorry

end FamousTheorems
