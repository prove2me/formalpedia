-- Source module: NLogN.HTopBlen
/-!
# Bit length as a procedure call

Procedure `4` of the HvdH machine computes the bit length: SS `blenS T1 ZZ` relocated by `ssH`.
In `RM` it is the call `blenRM`: the top of `ssH T1` (a nonnegative integer `x`) gives
`zsz x` pushed onto `ssH ZZ`.
-/

namespace NLogN.Top

open IntMul NLogN

/-- The body of the bit-length procedure (procedure `4` of a 5-procedure program). -/
def blenProc : IStmt HS 5 := (blenS T1 ZZ : IStmt NS 1).ren ssH (fun _ => (4 : Fin 5))

abbrev BX : Fin HS := ssH T1
abbrev BC : Fin HS := ssH ZZ

def blenCost (x : ℤ) : ℕ := 2000 * (zsz x + 1) * (zsz (zsz x : ℤ) + 2) + 2

/-- The `RM` call of the bit-length procedure (procedure number `3 + 1`). -/
def blenRM : RM :=
  .prc 3 (fun s => s.upd NLogN.Top.BC (.int (zsz (s.top NLogN.Top.BX)) :: s.G NLogN.Top.BC)) (fun s => blenCost (s.top NLogN.Top.BX))
    (fun s => ∃ (x : ℕ) (LX : List Item), s.G NLogN.Top.BX = .int x :: LX) [NLogN.Top.BC]
    (fun s j hj => by simp at hj; simp [IState.upd_G, hj])
    (fun s => by simp)

end NLogN.Top

end

section
-- Source module: NLogN.HTop
/-!
# The multiplication procedure of the HvdH machine

Procedure `1` multiplies the two integers on top of `ARGM = 55` (any signs).  It takes absolute
values, computes `N = max(bitlen |a|, bitlen |b|)`, multiplies directly (schoolbook expression)
when `N < n₀`, and otherwise runs one step `st` of the recursive algorithm (an `RM` program that
may call the multiplication procedure on smaller operands).

The step `st` is abstract here: it is specified by `StepOK`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Top

open IntMul NLogN

abbrev XA : Fin HS := 44
abbrev XB : Fin HS := 45
abbrev SA : Fin HS := 46
abbrev SB : Fin HS := 47
abbrev XN : Fin HS := 48
abbrev XR : Fin HS := 49
abbrev TT : Fin HS := 50

def sgnE (i : Fin HS) : Ex HS := .sel (.reg i) (.lit (-1)) (.lit 1)
def absE (i : Fin HS) : Ex HS := .sel (.reg i) (.neg (.reg i)) (.reg i)
def maxE (i j : Fin HS) : Ex HS := .sel (.add (.reg i) (.neg (.reg j))) (.reg j) (.reg i)
def resE : Ex HS :=
  .sel (.reg NLogN.Top.SA) (.sel (.reg SB) (.reg XR) (.neg (.reg XR)))
    (.sel (.reg SB) (.neg (.reg XR)) (.reg XR))

/-- The schoolbook branch. -/
def smallRM : RM :=
  .rs (RS.seqL [.push XR (.mul (.reg XA) (.reg XB)), .pop XA, .pop XB])

def mulPre : RS :=
  RS.seqL [.push XA (.reg ARGM), .pop ARGM, .push XB (.reg ARGM), .pop ARGM,
    .push NLogN.Top.SA (sgnE XA), .push SB (sgnE XB), .asg XA (absE XA), .asg XB (absE XB),
    .push NLogN.Top.BX (.reg XA)]

def mulMid : RS :=
  RS.seqL [.pop NLogN.Top.BX, .push TT (.reg NLogN.Top.BC), .pop NLogN.Top.BC, .push NLogN.Top.XN (maxE TT NLogN.Top.BC), .pop NLogN.Top.BC, .pop TT]

def mulPost : RS :=
  RS.seqL [.pop NLogN.Top.XN, .push ARGM resE, .pop XR, .pop NLogN.Top.SA, .pop SB]

/-- The body of the multiplication procedure (as an `RM` program). -/
def mulPrefix : RM :=
  RM.seqL [.rs mulPre, blenRM, .rs (RS.seqL [.pop NLogN.Top.BX, .push NLogN.Top.BX (.reg XB)]), blenRM, .rs mulMid]

def mulRM (n₀ : ℕ) (st : RM) : RM :=
  .seq mulPrefix (.seq (.ite (.add (.reg NLogN.Top.XN) (.lit (-(n₀ : ℤ)))) smallRM st) (.rs mulPost))

/-- The procedure map: `prc 0` = DIF (procedure 2), `prc 1` = DIT (3), `prc 3` = bit length (4). -/
def pcH (k : ℕ) : Fin 5 := if k = 1 then 2 else if k = 2 then 3 else 4

/-- What the recursive step must satisfy.  `calls N` lists pairs `(count, size)` of the
multiplications it performs on `N`-bit inputs. -/
structure StepOK (st : RM) (n₀ : ℕ) (lin : ℕ → ℕ) (calls : ℕ → List (ℕ × ℕ)) : Prop where
  run : ∀ (s : IState HS) (a b N : ℕ) (LA LB LN : List Item), n₀ ≤ N → a < 2 ^ N → b < 2 ^ N →
    s.G XA = .int a :: LA → s.G XB = .int b :: LB → s.G NLogN.Top.XN = .int N :: LN →
    st.run s = ((s.upd XA LA).upd XB LB).upd XR (.int (a * b : ℕ) :: s.G XR)
  okc : ∀ (M : MulSpec) (Φ : ℕ → ℕ) (s : IState HS) (a b N : ℕ) (LA LB LN : List Item),
    n₀ ≤ N → a < 2 ^ N → b < 2 ^ N →
    s.G XA = .int a :: LA → s.G XB = .int b :: LB → s.G NLogN.Top.XN = .int N :: LN →
    (∀ q ∈ calls N, MulBnd M q.2 (Φ q.2)) →
    st.ok M s ∧ st.cost M s ≤ lin N + ((calls N).map fun q => q.1 * Φ q.2).sum
  smaller : ∀ N, n₀ ≤ N → ∀ q ∈ calls N, q.2 < N
  prc : ∀ (I : List Sym) (iprog : Fin 5 → IStmt HS 5), iprog 2 = (difBody 2).ren ssH id →
    iprog 3 = (ditBody 3).ren ssH id → iprog 4 = blenProc → RM.PrcOK I iprog pcH st

end NLogN.Top

namespace NLogN.Top

open IntMul NLogN

def sg1 (a : ℤ) : ℤ := if a < 0 then -1 else 1

/-- The state before the branch. -/
def st3 (s : IState HS) (a b : ℤ) (L : List Item) (N : ℕ) : IState HS :=
  (((((s.upd ARGM L).upd XA (.int (a.natAbs : ℤ) :: s.G XA)).upd XB
    (.int (b.natAbs : ℤ) :: s.G XB)).upd NLogN.Top.SA (.int (sg1 a) :: s.G NLogN.Top.SA)).upd SB
    (.int (sg1 b) :: s.G SB)).upd NLogN.Top.XN (.int (N : ℤ) :: s.G NLogN.Top.XN)

def nOf (a b : ℤ) : ℕ := max (zsz (a.natAbs : ℤ)) (zsz (b.natAbs : ℤ))

/-- The state after either branch. -/
def stB (s : IState HS) (a b : ℤ) (L : List Item) (N : ℕ) : IState HS :=
  (((st3 s a b L N).upd XA (s.G XA)).upd XB (s.G XB)).upd XR
    (.int ((a.natAbs * b.natAbs : ℕ) : ℤ) :: s.G XR)

end NLogN.Top

end

section
-- Source module: NLogN.HDigits
/-!
# Chunking an integer into `b`-bit digits

`chunkP X RB D C n`: with `x ≥ 0` on `X` and the ruler `2^b` on `RB`, cut `n` digits off `x`
(each `split` costs `O(b)`, independently of the size of the rest) and push them on `D`.
-/

namespace NLogN

open IntMul IntMul.HvdH.Ref

/-- Cut `n` digits of `b` bits off `X` onto `D`, counting on `C`. -/
def chunkP (X RB D C : Fin HS) (n : Ex HS) : RM := .rep C n (.op (.split X RB D))

/-- The state after `k` digits. -/
def chunkSt (X D : Fin HS) (s : IState HS) (b x : ℕ) (LX : List Item) (k : ℕ) : IState HS :=
  (s.upd X (.int ((x / 2 ^ (b * k) : ℕ) : ℤ) :: LX)).upd D
    (ints (chunksL b k x).reverse ++ s.G D)

end NLogN

end

section
-- Source module: NLogN.HCarry
/-!
# Carrying and assembling digits: `evalDigits`

Input: nonnegative coefficients `c₀, c₁, …, c_{M-1}` on stack `CA` (`c₀` on top), the ruler
`2^b` on `CR`.  Output on `CY`: `∑ cₖ 2^{bk}`.

Phase 1 normalises: `t := y + cₖ`, digit `t mod 2^b` (by `split`, cost `O(b)`), carry `t / 2^b`.
Phase 2 assembles from the top with `cat` (cost `O(b)` per digit) starting from the sentinel
`carry + 1 ≠ 0`, while `CP := CP · 2^b` tracks `2^{bM}`; finally the sentinel is removed.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul IntMul.HvdH IntMul.HvdH.Ref

abbrev CA : Fin HS := 20
abbrev CD : Fin HS := 21
abbrev CY : Fin HS := 22
abbrev CR : Fin HS := 23
abbrev CP : Fin HS := 24
abbrev CQ : Fin HS := 25

/-! ## Pure carrying -/

def carryL (b : ℕ) : List ℤ → ℤ → List ℤ × ℤ
  | [], y => ([], y)
  | c :: cs, y => ((y + c) % 2 ^ b :: (carryL b cs ((y + c) / 2 ^ b)).1,
      (carryL b cs ((y + c) / 2 ^ b)).2)

/-! ## Phase 1: normalisation -/

/-- Register holding the number of coefficients `M`. -/
abbrev CM : Fin HS := 26

def carryBody : RM :=
  .seq (.rs (.seq (.asg CY (.add (.reg CY) (.reg CA))) (.pop CA))) (.op (.split CY CR CD))

def carry1 : RM := .rep CQ (.reg CM) carryBody

/-- The state after `k` normalisation steps. -/
def c1St (s : IState HS) (b : ℕ) (c : List ℤ) (y0 : ℤ) (RA LY : List Item) (k : ℕ) :
    IState HS :=
  ((s.upd CA (ints (c.drop k) ++ RA)).upd CY (.int (carryL b (c.take k) y0).2 :: LY)).upd CD
    (ints (carryL b (c.take k) y0).1.reverse ++ s.G CD)

/-! ## Phase 2: assembly -/

def asmBody : RM := .seq (.op (.cat CY CR CD)) (.op (.shl CP CR))

def carry2 : RM :=
  .seq (.rs (.seq (.asg CY (.add (.reg CY) (.lit 1))) (.push CP (.lit 1))))
    (.seq (.rep CQ (.reg CM) asmBody) (.rs (.seq (.asg CY (.add (.reg CY) (.neg (.reg CP))))
      (.pop CP))))

/-- The state after `j` assembly steps (`M = dl.length` digits, top carry `y`). -/
def c2St (s1 : IState HS) (b : ℕ) (dl : List ℤ) (y : ℤ) (LY D0 P0 : List Item) (j : ℕ) :
    IState HS :=
  ((s1.upd CY (.int (kpack (2 ^ b) (dl.drop (dl.length - j)) + (y + 1) * 2 ^ (b * j)) :: LY)).upd
    CD (ints (dl.take (dl.length - j)).reverse ++ D0)).upd CP (.int (2 ^ (b * j)) :: P0)

def carryP : RM := .seq carry1 carry2

/-! ## Side conditions -/

/-! ## Cost -/

end NLogN

end

section
-- Source module: NLogN.HListOps
/-!
# Basic list moves between stacks

`mvList i j c n`: move `n` integers from stack `i` to stack `j` (reversing their order),
counting on `c`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

def mvBody (i j : Fin HS) : RS := .seq (.push j (.reg i)) (.pop i)

def mvList (i j c : Fin HS) (n : Ex HS) : RS := .rep c n (mvBody i j)

/-- The state after `k` moves. -/
def mvSt (i j : Fin HS) (s : IState HS) (l : List ℤ) (Ri : List Item) (k : ℕ) : IState HS :=
  (s.upd i (ints (l.drop k) ++ Ri)).upd j (ints (l.take k).reverse ++ s.G j)

end NLogN

end

section
-- Source module: NLogN.HFermMath
/-!
# Pure facts behind the Fermat encode/decode routines

* `kunpack B n W` (balanced digits) equals a carry pass `balConv` over the standard digits of
  any nonnegative `x ≡ W (mod B^n)`; so the machine can cut standard digits by `split` and fix
  them up with small numbers only.
* `kpack` of a signed digit list is `kpack` of the positive parts minus `kpack` of the negative
  parts.
-/

namespace NLogN

open IntMul IntMul.HvdH IntMul.HvdH.Ref

/-- Standard base-`B` digits of `x`, least significant first. -/
def stdDigits (B : ℤ) : ℕ → ℤ → List ℤ
  | 0, _ => []
  | n + 1, x => x % B :: stdDigits B n (x / B)

/-- Balanced conversion of standard digits with an incoming carry `c ∈ {0, 1}`. -/
def balConv (B : ℤ) : List ℤ → ℤ → List ℤ
  | [], _ => []
  | d :: ds, c => if B ≤ 2 * (d + c) then (d + c - B) :: balConv B ds 1
      else (d + c) :: balConv B ds 0

/-- Positive and negative parts of a signed digit. -/
def posP (z : ℤ) : ℤ := max z 0
def negP (z : ℤ) : ℤ := max (-z) 0

end NLogN

end

section
-- Source module: NLogN.HEnc
/-!
# Encoding a block of Gaussian integers as a Fermat residue

A Gaussian list is stored flattened, `gints [(a₀,b₀), (a₁,b₁), …] = a₀ :: b₀ :: a₁ :: …`.
`splitPN` pops a block of `r` pairs from `GU` and pushes the positive/negative parts of the real
and imaginary parts onto `E1 … E4` (reversed).
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul IntMul.HvdH IntMul.HvdH.Ref

def gints (L : List (ℤ × ℤ)) : List Item := L.flatMap fun z => [.int z.1, .int z.2]

@[simp] theorem gints_nil : gints [] = [] := rfl
@[simp] theorem gints_cons (z : ℤ × ℤ) (L : List (ℤ × ℤ)) :
    gints (z :: L) = .int z.1 :: .int z.2 :: gints L := rfl

abbrev GU : Fin HS := 45
abbrev E1 : Fin HS := 40
abbrev E2 : Fin HS := 41
abbrev E3 : Fin HS := 42
abbrev E4 : Fin HS := 43
abbrev ET : Fin HS := 47
abbrev EC : Fin HS := 46

def posE (i : Fin HS) : Ex HS := .sel (.reg i) (.lit 0) (.reg i)
def negE (i : Fin HS) : Ex HS := .sel (.reg i) (.neg (.reg i)) (.lit 0)

def splitBody : RS :=
  RS.seqL [.push ET (.reg GU), .pop GU, .push E1 (posE ET), .push E2 (negE ET), .pop ET,
    .push ET (.reg GU), .pop GU, .push E3 (posE ET), .push NLogN.E4 (negE ET), .pop ET]

def splitPN (n : Ex HS) : RS := .rep EC n splitBody

def spSt (s : IState HS) (blk : List (ℤ × ℤ)) (R : List Item) (k : ℕ) : IState HS :=
  ((((s.upd GU (gints (blk.drop k) ++ R)).upd E1
    (ints ((blk.take k).map (posP ∘ Prod.fst)).reverse ++ s.G E1)).upd E2
    (ints ((blk.take k).map (negP ∘ Prod.fst)).reverse ++ s.G E2)).upd E3
    (ints ((blk.take k).map (posP ∘ Prod.snd)).reverse ++ s.G E3)).upd NLogN.E4
    (ints ((blk.take k).map (negP ∘ Prod.snd)).reverse ++ s.G NLogN.E4)

/-! ## Packing one nonnegative digit list -/

/-- Move the reversed list on `Ei` to `CA`, assemble it with `carryP`, push the value on `X`. -/
def packOne (Ei X : Fin HS) : RM :=
  RM.seqL [.rs (mvList Ei CA EC (.reg CM)), .rs (.push CY (.lit 0)), carryP,
    .rs (.push X (.reg CY)), .rs (.pop CY)]

/-! ## The whole block -/

abbrev X1 : Fin HS := 44
abbrev X2 : Fin HS := 48
abbrev X3 : Fin HS := 49
abbrev X4 : Fin HS := 50
abbrev EO : Fin HS := 51
abbrev RW : Fin HS := 52
abbrev FR : Fin HS := 53

/-- `X1 - X2 + (X3 - X4) · 2^{2rP}` -/
def encV : Ex HS :=
  .add (.add (.reg X1) (.neg (.reg X2))) (.shl (.add (.reg X3) (.neg (.reg X4))) (.reg RW))

def encE : Ex HS := .sel NLogN.encV (.add NLogN.encV (.reg FR)) NLogN.encV

def encP : RM :=
  RM.seqL [.rs (splitPN (.reg CM)), packOne E1 X1, packOne E2 X2, packOne E3 X3, packOne NLogN.E4 X4,
    .rs (.push EO encE), .rs (.pop X4), .rs (.pop X3), .rs (.pop X2), .rs (.pop X1)]

/-- The encoded value before reduction. -/
def encRaw (P : ℕ) (blk : List (ℤ × ℤ)) : ℤ :=
  kpack (2 ^ P) (blk.map (posP ∘ Prod.fst)) - kpack (2 ^ P) (blk.map (negP ∘ Prod.fst)) +
    (kpack (2 ^ P) (blk.map (posP ∘ Prod.snd)) - kpack (2 ^ P) (blk.map (negP ∘ Prod.snd))) *
      2 ^ (2 * blk.length * P)

/-! ## Side conditions -/

end NLogN

end

section
-- Source module: NLogN.HTopCost
/-!
# Side conditions and cost of the multiplication procedure
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Top

open IntMul NLogN

end NLogN.Top

namespace NLogN.Top

open IntMul NLogN

def preCost (N : ℕ) : ℕ := 300000 * (N + 3) + 4000 * (N + 1) * (zsz (N : ℤ) + 2) + 4

def Q1 (s : IState HS) (a b : ℤ) (L : List Item) : IState HS :=
  (((((s.upd ARGM L).upd XA (.int |a| :: s.G XA)).upd XB (.int |b| :: s.G XB)).upd NLogN.Top.SA
    (.int (sg1 a) :: s.G NLogN.Top.SA)).upd SB (.int (sg1 b) :: s.G SB)).upd NLogN.Top.BX (.int |a| :: s.G NLogN.Top.BX)

def Q2 (s : IState HS) (a b : ℤ) (L : List Item) : IState HS :=
  (Q1 s a b L).upd NLogN.Top.BC (.int (zsz |a| : ℤ) :: s.G NLogN.Top.BC)

def Q3 (s : IState HS) (a b : ℤ) (L : List Item) : IState HS :=
  (Q2 s a b L).upd NLogN.Top.BX (.int |b| :: s.G NLogN.Top.BX)

def Q4 (s : IState HS) (a b : ℤ) (L : List Item) : IState HS :=
  (Q3 s a b L).upd NLogN.Top.BC (.int (zsz |b| : ℤ) :: .int (zsz |a| : ℤ) :: s.G NLogN.Top.BC)

/-- Cost of the schoolbook branch. -/
def smallCost (N : ℕ) : ℕ := 4 * 10 ^ 7 * (2 * N + 3) ^ 2 + 8 * N + 8

def topCost (n₀ N : ℕ) : ℕ :=
  preCost N + 20000 * (N + zsz (n₀ : ℤ) + 3) + 200000 * (2 * N + 3)

end NLogN.Top

end

section
-- Source module: NLogN.HTopInd
/-!
# Correctness and cost of the multiplication procedure, by induction on the operand size
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Top

open IntMul NLogN

/-- Multiplication of operands of fewer than `n` bits, at cost `G (max size)`. -/
def Mlt (G : ℕ → ℕ) (n : ℕ) : MulSpec :=
  ⟨fun a b => G (max (zsz a) (zsz b)), fun a b => zsz a < n ∧ zsz b < n⟩

end NLogN.Top

namespace NLogN.Top

open IntMul NLogN

/-- The `N log N` shape used for the cost function. -/
def TT' (N : ℕ) : ℕ := (N + 1) * (zsz (N : ℤ) + 2)

/-- The constant for the small inputs. -/
def smallS (n₀ : ℕ) : ℕ := ∑ N ∈ Finset.range n₀, (topCost n₀ N + smallCost N + 2)

end NLogN.Top

end

section
-- Source module: NLogN.HTopMain
/-!
# The main procedure: read `x`, `y`, multiply, write `bin_{2n}`
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Top

open IntMul NLogN

abbrev M1 : Fin HS := 10
abbrev M2 : Fin HS := 11

def mainH : IStmt HS 5 :=
  .seq (.op (.read ARGM M1 codeSep)) (.seq (.op (.read ARGM M2 codeEnd)) (.seq (.call 1)
    (.seq (.op (.shl M1 M2)) (.op (.write ARGM M1)))))

def mainHCost (n : ℕ) (Φ : ℕ) : ℕ := 2 * readRCost n + Φ + shlCost n + outRCost (2 * n)

end NLogN.Top

end

section
-- Source module: NLogN.HTopFinal
/-!
# The `O(n log n)` bound, conditional on a recursive step `st` satisfying `StepOK`
-/

set_option linter.unusedSimpArgs false

namespace NLogN.Top

open IntMul NLogN

/-- The program of the machine. -/
def hvProg (n₀ : ℕ) (st : RM) : Fin 5 → IStmt HS 5 :=
  ![mainH, (mulRM n₀ st).code 1 pcH, (difBody 2).ren ssH id, (ditBody 3).ren ssH id, blenProc]

def hvMachine (n₀ : ℕ) (st : RM) : MultitapeTM :=
  machineOf (fun j => compile (hvProg n₀ st j)) (by norm_num)

end NLogN.Top

