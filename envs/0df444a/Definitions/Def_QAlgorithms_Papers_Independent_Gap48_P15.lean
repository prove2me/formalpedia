-- title:
--   Definitions for Algorithm to compute the rank and a Cartan subalgebra of a matrix Lie algebra with Mathematica
-- statement:
--   The objects the formalized statements of *Algorithm to compute the rank and a Cartan subalgebra of a matrix Lie algebra with Mathematica* (arXiv:math/0205235) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `J`: J[p,q] = F[p,q] - F[q,p], with ordinary transpose (PDF p. 5).
--   - `Z`: Z[p,q] = F[p,q] + F[q,p] (PDF pp. 14,16).
--   - `bSo`: BSo, ordered by increasing p and then increasing q > p (PDF p. 5).
--   - `bSl`: Bsl: row-major off-diagonal units, then F11-Fpp for p=2,...,t (PDF p. 10).
--   - `listFamily`: A finite list as an indexed family, retaining its order and multiplicities.
--   - `isBasisFor`: Independence and equality of real linear span, without assuming an input Basis.
--   - `isCartanBasisFor`: A displayed family is a basis of a Cartan subalgebra inside L. Cartan means nilpotent and self-normalizing, as in Mathlib, not transpose-normal. The map into ambient matrices ensures that the asserted Cartan is exactly the linear span of these matrices (PDF pp. 6-18).
--   - `star`: Star's upper-triangular pairwise ordinary-transpose test (PDF p. 4).
--   - `bG2`: The literal compact g2 family in the ambient 8 by 8 representation (PDF p. 12). Lean index k denotes source b[k+1]; the first matrix row and column stay zero.
--   - `compactG2`: The matrix Lie algebra generated by the source's compact g2 family (PDF pp. 12-13). Closure of its linear span and independence are conclusions of compactG2_basis.
--   - `bSplitG2`: The distinct split g2 family, with all source J/Z signs retained (PDF p. 14).
--   - `splitG2`: The matrix Lie algebra generated by BSplitg2 (PDF pp. 14-15).
--   - `modelBasis`: The literal ordered 34-matrix model family (PDF p. 16).
--   - `firstBlockForm`: The first block's ++++---- form, extended by zero on the last four coordinates.
--   - `secondBlockForm`: The last block's ++-- form, extended by zero on the first eight coordinates.
--   - `blockModel`: The block-diagonal so(4,4) plus so(2,2) model (PDF pp. 16-17). Skew-adjointness for both degenerate forms forces both off-block rectangles to vanish, and imposes the two indicated orthogonal equations on the diagonal blocks. This definition is independent of the claimed 34-element basis.
-- source:
--   Algorithm to compute the rank and a Cartan subalgebra of a matrix Lie algebra with Mathematica, arXiv:math/0205235v1, https://arxiv.org/abs/math/0205235v1

import Mathlib

/-!
Explicit real matrix examples from Alberca Bjerregaard and Martin Gonzalez,
"Algorithm to compute the rank and a Cartan subalgebra of a matrix Lie algebra
with Mathematica", arXiv:math/0205235v1. Page numbers below are PDF pages.
The false general transpose criterion and underspecified executable routine
are deferred in HARD.md; they are not assumptions of the concrete results.
-/

namespace QAlgorithms.Papers.Independent.Gap48.P15

attribute [local instance 100] LieRing.ofAssociativeRing

-- Reuse Mathlib Matrix and Matrix.single directly. Natural one-based
-- coordinates are restricted to Fin coordinates with Matrix.submatrix.

/-- J[p,q] = F[p,q] - F[q,p], with ordinary transpose (PDF p. 5). -/
def J (t p q : ℕ) : (Matrix (Fin t) (Fin t) ℝ) := ((Matrix.single p q (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1)) - ((Matrix.single q p (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1))

/-- Z[p,q] = F[p,q] + F[q,p] (PDF pp. 14,16). -/
def Z (t p q : ℕ) : (Matrix (Fin t) (Fin t) ℝ) := ((Matrix.single p q (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1)) + ((Matrix.single q p (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1))

example : ((Matrix.single 1 2 (1 : ℝ)).submatrix
      (fun i : Fin 2 => i.val + 1) (fun j : Fin 2 => j.val + 1)) 0 1 = 1 := by rfl

example : J 2 1 2 1 0 = -1 := by norm_num [J, Matrix.submatrix, Matrix.single]

example : Z 2 1 2 1 0 = 1 := by norm_num [Z, Matrix.submatrix, Matrix.single]

/-- BSo, ordered by increasing p and then increasing q > p (PDF p. 5). -/
def bSo (t : ℕ) : List ((Matrix (Fin t) (Fin t) ℝ)) :=
  (List.range t).flatMap fun p =>
    ((List.range t).filter fun q => p < q).map fun q => J t (p + 1) (q + 1)

/-- Bsl: row-major off-diagonal units, then F11-Fpp for p=2,...,t (PDF p. 10). -/
def bSl (t : ℕ) : List ((Matrix (Fin t) (Fin t) ℝ)) :=
  ((List.range t).flatMap fun p =>
    ((List.range t).filter fun q => p ≠ q).map fun q => ((Matrix.single (p + 1) (q + 1) (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1))) ++
  (List.range (t - 1)).map fun p => ((Matrix.single 1 1 (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1)) - ((Matrix.single (p + 2) (p + 2) (1 : ℝ)).submatrix
      (fun i : Fin t => i.val + 1) (fun j : Fin t => j.val + 1))

/-- A finite list as an indexed family, retaining its order and multiplicities. -/
def listFamily {t : ℕ} (v : List ((Matrix (Fin t) (Fin t) ℝ))) : Fin v.length → (Matrix (Fin t) (Fin t) ℝ) :=
  fun i => v.get i

example : bSo 1 = [] := by rfl

example : bSl 1 = [] := by rfl

example : listFamily [J 2 1 2] 0 = J 2 1 2 := by rfl

/-- Independence and equality of real linear span, without assuming an input Basis. -/
def isBasisFor {t m : ℕ} (L : LieSubalgebra ℝ ((Matrix (Fin t) (Fin t) ℝ)))
    (v : Fin m → (Matrix (Fin t) (Fin t) ℝ)) : Prop :=
  LinearIndependent ℝ v ∧ Submodule.span ℝ (Set.range v) = L.toSubmodule

/-- A displayed family is a basis of a Cartan subalgebra inside L.
Cartan means nilpotent and self-normalizing, as in Mathlib, not transpose-normal.
The map into ambient matrices ensures that the asserted Cartan is exactly the
linear span of these matrices (PDF pp. 6-18). -/
def isCartanBasisFor {t m : ℕ} (L : LieSubalgebra ℝ ((Matrix (Fin t) (Fin t) ℝ)))
    (v : Fin m → (Matrix (Fin t) (Fin t) ℝ)) : Prop :=
  ∃ H : LieSubalgebra ℝ L, H.IsCartanSubalgebra ∧
    LinearIndependent ℝ v ∧
    Submodule.span ℝ (Set.range v) = H.toSubmodule.map L.toSubmodule.subtype

/-- Star's upper-triangular pairwise ordinary-transpose test (PDF p. 4). -/
def star {t m : ℕ} (v : Fin m → (Matrix (Fin t) (Fin t) ℝ)) : Prop :=
  ∀ i j, i ≤ j → ⁅v i, (v j).transpose⁆ = 0

example : star (fun i : Fin 0 => (Fin.elim0 i : (Matrix (Fin 3) (Fin 3) ℝ))) := by
  intro i
  exact Fin.elim0 i

/-- The literal compact g2 family in the ambient 8 by 8 representation (PDF p. 12).
Lean index k denotes source b[k+1]; the first matrix row and column stay zero. -/
def bG2 : Fin 14 → (Matrix (Fin 8) (Fin 8) ℝ) :=
  ![J 8 2 3 + J 8 6 7, J 8 2 4 + J 8 6 8,
    J 8 2 5 + J 8 7 4, J 8 2 6 + J 8 8 4,
    J 8 2 7 + J 8 4 5, J 8 2 8 + J 8 4 6,
    J 8 3 4 + J 8 7 8, J 8 3 5 + J 8 4 6,
    J 8 3 6 + J 8 5 4, J 8 3 7 + J 8 8 4,
    J 8 3 8 + J 8 4 7, J 8 5 6 + J 8 7 8,
    J 8 5 7 + J 8 8 6, J 8 5 8 + J 8 6 7]

/-- The matrix Lie algebra generated by the source's compact g2 family (PDF pp. 12-13).
Closure of its linear span and independence are conclusions of compactG2_basis. -/
def compactG2 : LieSubalgebra ℝ ((Matrix (Fin 8) (Fin 8) ℝ)) :=
  LieSubalgebra.lieSpan ℝ ((Matrix (Fin 8) (Fin 8) ℝ)) (Set.range bG2)

example : bG2 0 = J 8 2 3 + J 8 6 7 := by rfl

example : bG2 0 ∈ compactG2 :=
  LieSubalgebra.subset_lieSpan ⟨0, rfl⟩

/-- The distinct split g2 family, with all source J/Z signs retained (PDF p. 14). -/
def bSplitG2 : Fin 14 → (Matrix (Fin 8) (Fin 8) ℝ) :=
  ![J 8 2 3 - J 8 7 6, -J 8 4 2 + J 8 6 8,
    Z 8 2 5 + Z 8 4 7, Z 8 2 6 - Z 8 4 8,
    Z 8 2 7 - Z 8 4 5, Z 8 2 8 + Z 8 4 6,
    J 8 3 4 + J 8 7 8, Z 8 3 5 - Z 8 4 6,
    Z 8 3 6 + Z 8 4 5, Z 8 3 7 - Z 8 4 8,
    Z 8 3 8 + Z 8 4 7, -J 8 6 5 - J 8 7 8,
    J 8 5 7 + J 8 6 8, J 8 5 8 + J 8 7 6]

/-- The matrix Lie algebra generated by BSplitg2 (PDF pp. 14-15). -/
def splitG2 : LieSubalgebra ℝ ((Matrix (Fin 8) (Fin 8) ℝ)) :=
  LieSubalgebra.lieSpan ℝ ((Matrix (Fin 8) (Fin 8) ℝ)) (Set.range bSplitG2)

example : bSplitG2 2 = Z 8 2 5 + Z 8 4 7 := by rfl

example : bSplitG2 2 ∈ splitG2 :=
  LieSubalgebra.subset_lieSpan ⟨2, rfl⟩

/-- The literal ordered 34-matrix model family (PDF p. 16). -/
def modelBasis : Fin 34 → (Matrix (Fin 12) (Fin 12) ℝ) :=
  ![Z 12 1 5, Z 12 1 6, Z 12 1 7, Z 12 1 8,
    Z 12 2 5, Z 12 2 6, Z 12 2 7, Z 12 2 8,
    Z 12 3 5, Z 12 3 6, Z 12 3 7, Z 12 3 8,
    Z 12 4 5, Z 12 4 6, Z 12 4 7, Z 12 4 8,
    J 12 1 2, J 12 1 3, J 12 1 4, J 12 2 3,
    J 12 2 4, J 12 3 4, J 12 5 6, J 12 5 7,
    J 12 5 8, J 12 6 7, J 12 6 8, J 12 7 8,
    J 12 9 10, J 12 11 12, Z 12 9 11, Z 12 9 12,
    Z 12 10 11, Z 12 10 12]

/-- The first block's ++++---- form, extended by zero on the last four coordinates. -/
def firstBlockForm : (Matrix (Fin 12) (Fin 12) ℝ) :=
  Matrix.diagonal fun i => if i.val < 4 then 1 else if i.val < 8 then -1 else 0

/-- The last block's ++-- form, extended by zero on the first eight coordinates. -/
def secondBlockForm : (Matrix (Fin 12) (Fin 12) ℝ) :=
  Matrix.diagonal fun i => if i.val < 8 then 0 else if i.val < 10 then 1 else -1

/-- The block-diagonal so(4,4) plus so(2,2) model (PDF pp. 16-17).
Skew-adjointness for both degenerate forms forces both off-block rectangles to
vanish, and imposes the two indicated orthogonal equations on the diagonal blocks.
This definition is independent of the claimed 34-element basis. -/
def blockModel : LieSubalgebra ℝ ((Matrix (Fin 12) (Fin 12) ℝ)) :=
  skewAdjointMatricesLieSubalgebra firstBlockForm ⊓
    skewAdjointMatricesLieSubalgebra secondBlockForm

example : modelBasis 0 = Z 12 1 5 := by rfl

example : firstBlockForm 0 0 = 1 := by rfl

example : secondBlockForm 8 8 = 1 := by rfl

example : (0 : (Matrix (Fin 12) (Fin 12) ℝ)) ∈ blockModel := blockModel.zero_mem

end QAlgorithms.Papers.Independent.Gap48.P15


