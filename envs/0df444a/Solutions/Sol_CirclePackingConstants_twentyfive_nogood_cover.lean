    ∃ lo hi L, lo ≤ p ∧ p < hi ∧ runChunk GT PIDX lo hi L = true :=
  if h0 : p < 1 then ⟨0, 1, CERT0, by omega, h0, chunk0⟩ else
  if h1 : p < 2 then ⟨1, 2, CERT1, by omega, h1, chunk1⟩ else
  if h2 : p < 3 then ⟨2, 3, CERT2, by omega, h2, chunk2⟩ else
