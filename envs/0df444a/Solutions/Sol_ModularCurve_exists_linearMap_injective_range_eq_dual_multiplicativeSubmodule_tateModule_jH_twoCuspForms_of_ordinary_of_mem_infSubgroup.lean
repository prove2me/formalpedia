theorem exists_Θ0 :
    ∃ Θ0 : (↥P0 →+ ZMod p) ≃ₗ[ZMod p] N0 p M H S' i₀ τ₀,
      ∀ (t : 𝕋) (φ : ↥P0 →+ ZMod p), Θ0 (fX ↥P0 (ZMod p) t φ) = fN p M H S' i₀ τ₀ t (Θ0 φ) := by
  haveI := moduleFinite_N0 p K hp2 M H hpM hpM2 hHp S hin hfaith op hop hgen S' i₀ hord Pl hPl P0 hP0 d hd hdH τ₀ hτ₀
  haveI : Nontrivial K := inferInstance
  exact exists_linearEquiv_of_baseChange_family (ZMod p) K (↥P0 →+ ZMod p) (N0 p M H S' i₀ τ₀)
    (fX ↥P0 (ZMod p)) (fN p M H S' i₀ τ₀)
    (EE p K hp2 M H hpM hpM2 hHp S hin hfaith op hop hgen S' i₀ hord Pl hPl P0 hP0 d hd hdH τ₀ hτ₀)
    (EE_equiv p K hp2 M H hpM hpM2 hHp S hin hfaith op hop hgen S' i₀ hord Pl hPl P0 hP0 d hd hdH τ₀ hτ₀)

