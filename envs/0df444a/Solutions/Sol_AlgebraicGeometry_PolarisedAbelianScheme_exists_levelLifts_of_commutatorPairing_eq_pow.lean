namespace K77PIECE

variable {g d n : ℕ} {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
  {R : Type} [CommRing R] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))

theorem mul_comm_of_act (θ θ' : ThetaPt u.f u.L u.pol t)
    (h : ∀ s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤), θ.act (θ'.act s) = θ'.act (θ.act s)) :
    θ * θ' = θ' * θ := by
  apply AlgebraicGeometry.PolarisedAbelianScheme.thetaPt_eq_of_pt_eq_of_forall_act_eq u t
  · rw [ThetaPt.mul_pt, ThetaPt.mul_pt]; exact u.comm t _ _
  · intro s; rw [ThetaPt.mul_act, ThetaPt.mul_act, h]

theorem mul_eq_ofScalar_mul_of_act (θ θ' : ThetaPt u.f u.L u.pol t) (v : Rˣ)
    (h : ∀ s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤),
      θ.act (θ'.act s) = baseScalar u.f t (v : R) • θ'.act (θ.act s)) :
    θ * θ' = ThetaPt.ofScalar v * (θ' * θ) := by
  apply AlgebraicGeometry.PolarisedAbelianScheme.thetaPt_eq_of_pt_eq_of_forall_act_eq u t
  · rw [ThetaPt.mul_pt, ThetaPt.mul_pt, ThetaPt.mul_pt, ThetaPt.ofScalar_pt, u.L.one_mul]; exact u.comm t _ _
  · intro s; rw [ThetaPt.mul_act, ThetaPt.mul_act, ThetaPt.mul_act, ThetaPt.ofScalar_act, h]

theorem act_of_mul_eq_ofScalar_mul (θ θ' : ThetaPt u.f u.L u.pol t) (v : Rˣ)
    (h : θ * θ' = ThetaPt.ofScalar v * (θ' * θ))
    (s : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)) :
    θ.act (θ'.act s) = baseScalar u.f t (v : R) • θ'.act (θ.act s) := by
  rw [← ThetaPt.mul_act, h, ThetaPt.mul_act, ThetaPt.mul_act, ThetaPt.ofScalar_act]

theorem act_surjective (θ : ThetaPt u.f u.L u.pol t) (X : Γ((Scheme.Modules.pullback (pullback.fst u.f t)).obj u.pol, ⊤)) :
    θ.act (θ⁻¹.act X) = X := by
  rw [← ThetaPt.mul_act, mul_inv_cancel, ThetaPt.one_act]

end K77PIECE

theorem solution
    {g d n : ℕ} (δ : Fin g → ℕ) [∀ i, NeZero (δ i)] [NeZero d] (hδd : ∏ i, δ i = d)
    {S : Type} [CommRing S] (u : PolarisedAbelianScheme g d n S)
    {R : Type} [CommRing R] [Algebra S R] (hdR : IsUnit ((d : ℕ) : R))
    (ζ : Rˣ) (hζ : (ζ : R) ^ d = 1) (hζu : ∀ j : ℕ, 0 < j → j < d → IsUnit (1 - (ζ : R) ^ j))
    (x : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap S R))) u.f)
    (hx0 : x 0 = u.L.one _) (hx : ∀ k k' : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))), x (k + k') = u.L.mul _ (x k) (x k'))
    (θ₀ : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R)))) (hθ₀ : ∀ k, (θ₀ k).pt = x k)
    (B : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) → ZMod d)
    (hB : ∀ (k k' : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i)))) (s : Γ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S R))))).obj u.pol, ⊤)),
      (θ₀ k).act ((θ₀ k').act s) = baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) ((ζ : R) ^ (B k k').val) • (θ₀ k').act ((θ₀ k).act s))
    (hadd₁ : ∀ a b c, B (a + b) c = B a c + B b c) (hadd₂ : ∀ a b c, B a (b + c) = B a b + B a c)
    (halt : ∀ a, B a a = 0) (hnd : ∀ a, (∀ b, B a b = 0) → a = 0) :
    ∃ (R' : Type) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra S R') (_ : IsScalarTower S R R'),
      Module.FaithfullyFlat R R' ∧ Algebra.Etale R R' ∧
      ∃ (lift : ((i : Fin g) → ZMod (δ i)) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R'))))
        (dualLift : (((i : Fin g) → ZMod (δ i)) →+ ZMod d) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R')))),
        lift 0 = 1 ∧ (∀ h h' : ((i : Fin g) → ZMod (δ i)), lift (h + h') = lift h * lift h') ∧
        dualLift 0 = 1 ∧ (∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d, dualLift (c + c') = dualLift c * dualLift c') ∧
        (∀ (c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d) (h : ((i : Fin g) → ZMod (δ i))),
          dualLift c * lift h =
            ThetaPt.ofScalar (Units.map (algebraMap R R' : R →* R') ζ ^ (c h).val) * (lift h * dualLift c)) := by
  classical

  obtain ⟨α, hα⟩ := ZMod.exists_addEquiv_prod_addMonoidHom_forall_apply_eq_sub_of_alternating_of_nondegenerate δ hδd B
    hadd₁ hadd₂ halt hnd
  have hB_hh : ∀ h h' : (i : Fin g) → ZMod (δ i), B (α (h, 0)) (α (h', 0)) = 0 := fun h h' => by
    rw [hα]; simp
  have hB_cc : ∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d, B (α (0, c)) (α (0, c')) = 0 := fun c c' => by
    rw [hα]; simp
  have hB_ch : ∀ (c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d) (h : (i : Fin g) → ZMod (δ i)),
      B (α (0, c)) (α (h, 0)) = c h := fun c h => by rw [hα]; simp
  have hα0 : α ((0 : (i : Fin g) → ZMod (δ i)), (0 : ((i : Fin g) → ZMod (δ i)) →+ ZMod d)) = 0 := by
    rw [← Prod.zero_eq_mk]; exact map_zero α

  have hbs1 : baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap S R))) (1 : R) = 1 :=
    map_one (baseScalarHom u.f _)

  have hcommR : ∀ k k', B k k' = 0 → θ₀ k * θ₀ k' = θ₀ k' * θ₀ k := by
    intro k k' hkk
    refine K77PIECE.mul_comm_of_act u _ _ _ fun s => ?_
    have := hB k k' s
    rwa [hkk, ZMod.val_zero, pow_zero, hbs1, one_smul] at this
  have hHeisR : ∀ k k', θ₀ k * θ₀ k' = ThetaPt.ofScalar (ζ ^ (B k k').val) * (θ₀ k' * θ₀ k) := fun k k' =>
    K77PIECE.mul_eq_ofScalar_mul_of_act u _ _ _ _ fun s => by rw [Units.val_pow_eq_pow_val]; exact hB k k' s

  have hcardH : Fintype.card ((i : Fin g) → ZMod (δ i)) = d := by
    rw [Fintype.card_pi, ← hδd]; exact Finset.prod_congr rfl fun i _ => ZMod.card (δ i)

  obtain ⟨R₁, instR₁, algR₁, hff₁, het₁, lift₁, hl₁0, hl₁m, hl₁pt⟩ :=
    AlgebraicGeometry.PolarisedAbelianScheme.exists_faithfullyFlat_etale_levelLift_of_forall_act_comm u
      (Spec.map (CommRingCat.ofHom (algebraMap S R))) (K₁ := (i : Fin g) → ZMod (δ i)) (by rw [hcardH]; exact hdR)
      (fun h => x (α (h, 0))) (by show x (α (0, 0)) = _; rw [hα0, hx0])
      (fun h h' => by rw [← hx, ← map_add, Prod.mk_add_mk, add_zero])
      (fun h => θ₀ (α (h, 0))) (fun h => hθ₀ _)
      (fun h h' s => by rw [← ThetaPt.mul_act, hcommR _ _ (hB_hh h h'), ThetaPt.mul_act])

  obtain ⟨β₁, hβ₁pt, -, hβ₁sc, -⟩ := AlgebraicGeometry.Polarisation.TA.exists_monoidHom_transport u.f u.L u.pol
    (Spec.map (CommRingCat.ofHom (algebraMap S R)))
    (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R))) (algebraMap R R₁) rfl

  have hx₁0 : schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, (0 : ((i : Fin g) → ZMod (δ i)) →+ ZMod d)))) =
      u.L.one (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R))) := by
    rw [hα0, hx0]; exact u.L.one_natural _ _ _ rfl
  have hx₁add : ∀ c c' : ((i : Fin g) → ZMod (δ i)) →+ ZMod d,
      schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, c + c'))) =
        u.L.mul _ (schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, c))))
          (schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, c')))) := by
    intro c c'
    rw [← u.L.mul_natural _ _ _ rfl, ← hx, ← map_add, Prod.mk_add_mk, add_zero]
  have hθ₁pt : ∀ c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d,
      (β₁ (θ₀ (α (0, c)))).pt = schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, c))) :=
    fun c => Subtype.ext (by rw [hβ₁pt, GoodReductionJacobian.schemeHomOverComp_coe, hθ₀])

  haveI : Finite (((i : Fin g) → ZMod (δ i)) →+ ZMod d) :=
    Finite.of_injective (fun c : ((i : Fin g) → ZMod (δ i)) →+ ZMod d => (c : ((i : Fin g) → ZMod (δ i)) → ZMod d))
      DFunLike.coe_injective
  letI : Fintype (((i : Fin g) → ZMod (δ i)) →+ ZMod d) := Fintype.ofFinite _
  have hcardHd : Fintype.card (((i : Fin g) → ZMod (δ i)) →+ ZMod d) = d := by
    have h1 := Fintype.card_congr α.toEquiv
    rw [Fintype.card_prod, Fintype.card_prod, hcardH] at h1
    have hd0 : 0 < d := Nat.pos_of_ne_zero (NeZero.ne d)
    exact Nat.eq_of_mul_eq_mul_left hd0 h1
  have hK₂ : IsUnit ((Fintype.card (((i : Fin g) → ZMod (δ i)) →+ ZMod d) : ℕ) : R₁) := by
    rw [hcardHd]; have := hdR.map (algebraMap R R₁); rwa [map_natCast] at this

  obtain ⟨R', instR', algR₁R', hff₂, het₂, lift₂, hl₂0, hl₂m, hl₂pt⟩ :=
    AlgebraicGeometry.PolarisedAbelianScheme.exists_faithfullyFlat_etale_levelLift_of_forall_act_comm u
      (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R))) hK₂
      (fun c => schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R₁))) rfl (x (α (0, c)))) hx₁0 hx₁add
      (fun c => β₁ (θ₀ (α (0, c)))) hθ₁pt
      (fun c c' s => by rw [← ThetaPt.mul_act, ← map_mul, hcommR _ _ (hB_cc c c'), map_mul, ThetaPt.mul_act])

  letI algRR' : Algebra R R' := ((algebraMap R₁ R').comp (algebraMap R R₁)).toAlgebra
  letI algSR' : Algebra S R' := ((algebraMap R R').comp (algebraMap S R)).toAlgebra
  haveI hstS : IsScalarTower S R R' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI hstR : IsScalarTower R R₁ R' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hr₂ : Spec.map (CommRingCat.ofHom (algebraMap R₁ R')) ≫
      (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R))) =
        Spec.map (CommRingCat.ofHom (algebraMap S R')) := by
    rw [← Category.assoc, AlgebraicGeometry.Polarisation.TA.hr_algebraMap (S := R) R₁ R',
      AlgebraicGeometry.Polarisation.TA.hr_algebraMap (S := S) R R']
  have hrRR' : Spec.map (CommRingCat.ofHom (algebraMap R R')) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R)) =
      Spec.map (CommRingCat.ofHom (algebraMap S R')) := AlgebraicGeometry.Polarisation.TA.hr_algebraMap (S := S) R R'
  have hr₃ : Spec.map (CommRingCat.ofHom (RingHom.id R')) ≫
      (Spec.map (CommRingCat.ofHom (algebraMap R₁ R')) ≫
        (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R)))) =
        Spec.map (CommRingCat.ofHom (algebraMap S R')) := by
    rw [hr₂, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]

  obtain ⟨β₂, hβ₂pt, -, hβ₂sc, -⟩ := AlgebraicGeometry.Polarisation.TA.exists_monoidHom_transport u.f u.L u.pol
    (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R)))
    (Spec.map (CommRingCat.ofHom (algebraMap S R'))) (algebraMap R₁ R') hr₂
  obtain ⟨β₃, hβ₃pt, -, hβ₃sc, -⟩ := AlgebraicGeometry.Polarisation.TA.exists_monoidHom_transport u.f u.L u.pol
    (Spec.map (CommRingCat.ofHom (algebraMap R₁ R')) ≫
      (Spec.map (CommRingCat.ofHom (algebraMap R R₁)) ≫ Spec.map (CommRingCat.ofHom (algebraMap S R))))
    (Spec.map (CommRingCat.ofHom (algebraMap S R'))) (RingHom.id R') hr₃

  let lift : ((i : Fin g) → ZMod (δ i)) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R'))) :=
    fun h => β₂ (lift₁ h)
  let dualLift : (((i : Fin g) → ZMod (δ i)) →+ ZMod d) → ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R'))) :=
    fun c => β₃ (lift₂ c)
  have hl0 : lift 0 = 1 := by show β₂ (lift₁ 0) = 1; rw [hl₁0, map_one]
  have hlm : ∀ h h', lift (h + h') = lift h * lift h' := fun h h' => by
    show β₂ (lift₁ (h + h')) = β₂ (lift₁ h) * β₂ (lift₁ h'); rw [hl₁m, map_mul]
  have hd0' : dualLift 0 = 1 := by show β₃ (lift₂ 0) = 1; rw [hl₂0, map_one]
  have hdm : ∀ c c', dualLift (c + c') = dualLift c * dualLift c' := fun c c' => by
    show β₃ (lift₂ (c + c')) = β₃ (lift₂ c) * β₃ (lift₂ c'); rw [hl₂m, map_mul]

  have hxF0 : schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x 0) = u.L.one _ := by
    rw [hx0]; exact u.L.one_natural _ _ _ hrRR'
  have hxFadd : ∀ k k', schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x (k + k')) =
      u.L.mul _ (schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x k))
        (schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x k')) := fun k k' => by
    rw [← u.L.mul_natural _ _ _ hrRR', ← hx]
  have hSpecRR' : Spec.map (CommRingCat.ofHom (algebraMap R R')) =
      Spec.map (CommRingCat.ofHom (algebraMap R₁ R')) ≫ Spec.map (CommRingCat.ofHom (algebraMap R R₁)) :=
    (AlgebraicGeometry.Polarisation.TA.hr_algebraMap (S := R) R₁ R').symm

  have hθFpt : ∀ k, (β₂ (β₁ (θ₀ k))).pt = schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x k) :=
    fun k => Subtype.ext (by rw [hβ₂pt, hβ₁pt, GoodReductionJacobian.schemeHomOverComp_coe, hθ₀, hSpecRR', Category.assoc])

  have hζmap : ∀ m : ℕ, β₂ (β₁ (ThetaPt.ofScalar (ζ ^ m))) = ThetaPt.ofScalar (Units.map (algebraMap R R' : R →* R') ζ ^ m) := by
    intro m
    rw [hβ₁sc, hβ₂sc, ← map_pow]
    congr 1
  have hHeisF : ∀ k k', β₂ (β₁ (θ₀ k)) * β₂ (β₁ (θ₀ k')) =
      ThetaPt.ofScalar (Units.map (algebraMap R R' : R →* R') ζ ^ (B k k').val) * (β₂ (β₁ (θ₀ k')) * β₂ (β₁ (θ₀ k))) := by
    intro k k'
    rw [← map_mul, ← map_mul, hHeisR, map_mul, map_mul, map_mul, map_mul, hζmap]

  obtain ⟨e, he1, -, -, -, -, -, he7⟩ := AlgebraicGeometry.PolarisedAbelianScheme.exists_commutatorPairing_of_thetaPt u
    (Spec.map (CommRingCat.ofHom (algebraMap S R')))
    (fun k => schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x k)) hxF0 hxFadd
    (fun k => β₂ (β₁ (θ₀ k))) hθFpt
  have hscal : ∀ (k k') (Y : Γ((Scheme.Modules.pullback (pullback.fst u.f (Spec.map (CommRingCat.ofHom (algebraMap S R'))))).obj u.pol, ⊤)),
      baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap S R'))) (e k k' : R') • Y =
        baseScalar u.f (Spec.map (CommRingCat.ofHom (algebraMap S R'))) ((Units.map (algebraMap R R' : R →* R') ζ : R') ^ (B k k').val) • Y := by
    intro k k' Y
    have hsurj := K77PIECE.act_surjective u _ (β₂ (β₁ (θ₀ k')) * β₂ (β₁ (θ₀ k))) Y
    rw [ThetaPt.mul_act] at hsurj
    rw [← hsurj, ← he1, K77PIECE.act_of_mul_eq_ofScalar_mul u _ _ _ _ (hHeisF k k'), Units.val_pow_eq_pow_val]

  let θ₂ : (((i : Fin g) → ZMod (δ i)) × ((i : Fin g) → ZMod (δ i))) →
      ThetaPt u.f u.L u.pol (Spec.map (CommRingCat.ofHom (algebraMap S R'))) :=
    fun k => lift (α.symm k).1 * dualLift (α.symm k).2
  have hliftpt : ∀ h, (lift h).pt = schemeHomOverComp (Spec.map (CommRingCat.ofHom (algebraMap R R'))) hrRR' (x (α (h, 0))) :=
    fun h => Subtype.ext (by
      show (β₂ (lift₁ h)).pt.1 = _
