theorem NLogN.KFM.chirpArr_err (Δ : ℕ) {d : ℕ} (s t : Fin d → ℕ) [∀ i, NeZero (t i)]
    (hst : ∀ i, s i ≤ t i) (T : ℕ) (hT : ∀ i, t i ≤ T)
    (hu : d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1) (j : (i : Fin d) → ZMod (t i)) :
    ∃ x, (chirpArr Δ d s t)[flatIx d t j]? = some x ∧
      ‖vP Δ x - IntMul.OpenAI.RC.chirp s t j‖ ≤ d * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ := by sorry
