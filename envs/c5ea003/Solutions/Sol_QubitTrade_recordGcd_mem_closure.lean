import Mathlib
import Definitions.Def_Algebra_QubitTrade_GroupBridge
import Definitions.Def_Algebra_QubitTrade_SampleFungibility

/-!
# QUBIT-TRADE VI: the sample criterion is a generation criterion in `ZMod r`

The arithmetic criterion of `SampleFungibility.lean` — a record of Shor samples
`k₁, …, k_m` recovers the order `r` iff `gcd (gcd_i k_i, r) = 1` — is exactly a
*group-theoretic* statement about the cyclic group `ZMod r`:

  **a record recovers the order iff the sampled numerators generate `ZMod r`.**

* `QubitTrade.recovered_eq_addOrderOf` — one sample returns the additive order of
  `k` in `ZMod r`, i.e. the size of the subgroup it generates;
* `QubitTrade.recordGcd_mem_closure` — the joint gcd of a record lies in the
  subgroup generated by the record (Bézout, by induction along the list);
* `QubitTrade.closure_eq_top_iff_gcd` — the generation criterion;
* `QubitTrade.samples_recover_iff_generate` — the bridge: `recordEstimate ks r = r`
  iff the samples generate `ZMod r`.

So "qubit ↔ sample fungibility" is the statement that extra samples enlarge the
subgroup of `ZMod r` that the algorithm has seen, until it is everything; while
extra qubits (below the resolution threshold) enlarge nothing at all.
-/

open QubitTrade



theorem mem_recordImage {ks : List ℕ} {r k : ℕ} (hk : k ∈ ks) :
    ((k : ZMod r)) ∈ recordImage ks r := ⟨k, hk, rfl⟩

theorem recordImage_mono {a : ℕ} {l : List ℕ} {r : ℕ} :
    recordImage l r ⊆ recordImage (a :: l) r := by
  rintro x ⟨k, hk, rfl⟩
  exact ⟨k, List.mem_cons_of_mem _ hk, rfl⟩





open QubitTrade in
theorem solution(ks : List ℕ) (r : ℕ) :
    ((recordGcd ks : ℕ) : ZMod r) ∈ AddSubgroup.closure (recordImage ks r) := by
  induction ks with
  | nil =>
      simp [recordGcd]
  | cons a l ih =>
      have ha : ((a : ZMod r)) ∈ AddSubgroup.closure (recordImage (a :: l) r) :=
        AddSubgroup.subset_closure (mem_recordImage (List.mem_cons_self ..))
      have hl : ((recordGcd l : ℕ) : ZMod r) ∈ AddSubgroup.closure (recordImage (a :: l) r) :=
        AddSubgroup.closure_mono recordImage_mono ih
      have hgcd : recordGcd (a :: l) = Nat.gcd a (recordGcd l) := rfl
      have hbez : ((Nat.gcd a (recordGcd l) : ℕ) : ZMod r) =
          (Nat.gcdA a (recordGcd l)) • ((a : ZMod r)) +
            (Nat.gcdB a (recordGcd l)) • (((recordGcd l : ℕ)) : ZMod r) := by
        have hZ : ((Nat.gcd a (recordGcd l) : ℕ) : ℤ) =
            (a : ℤ) * Nat.gcdA a (recordGcd l) + (recordGcd l : ℤ) * Nat.gcdB a (recordGcd l) :=
          Nat.gcd_eq_gcd_ab a (recordGcd l)
        have hcast : (((Nat.gcd a (recordGcd l) : ℕ) : ℤ) : ZMod r) =
            (((a : ℤ) * Nat.gcdA a (recordGcd l)
              + (recordGcd l : ℤ) * Nat.gcdB a (recordGcd l) : ℤ) : ZMod r) := by
          rw [hZ]
        push_cast [zsmul_eq_mul] at hcast ⊢
        rw [hcast]; ring
      rw [hgcd, hbez]
      exact add_mem (AddSubgroup.zsmul_mem _ ha _) (AddSubgroup.zsmul_mem _ hl _)
