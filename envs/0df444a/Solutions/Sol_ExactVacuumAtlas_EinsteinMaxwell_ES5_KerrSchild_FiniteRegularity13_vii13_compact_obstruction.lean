  have hc : ContDiffAt ℝ ((0 + k : ℕ) : WithTop ℕ∞) g 0 := cda_le hg (by omega)
  refine zero_at_zero_of_right_zero hε (cda_iteratedDeriv_fin k 0 hc).continuousAt
    fun x hx => ?_
  rw [hEq.iteratedDeriv_of_isOpen isOpen_Ioo k hx, iteratedDeriv_const_zero]

