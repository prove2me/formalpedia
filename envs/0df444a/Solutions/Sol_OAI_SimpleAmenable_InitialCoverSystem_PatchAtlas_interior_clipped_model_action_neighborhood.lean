  · simpa only [translatedTemplate,tangentChartTemplate,ite_true,add_zero] using hp.symm
  · intro x y he
    have hh := he ()
    simpa only [primitiveTests,primitiveFamilyTests,translatedTemplate,tangentChartTemplate,
