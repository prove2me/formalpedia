theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ) [IsDomain (AdjoinRoot Φ)]
    (ι : TypeDensity.BaseField O →+* TypeDensity.BaseField (AdjoinRoot Φ))
    (τ : ℕ → (TypeDensity.BaseField (AdjoinRoot Φ) ≃+* TypeDensity.BaseField (AdjoinRoot Φ)))
    (hτ : ∀ (i : ℕ) (x : AdjoinRoot Φ), τ i
      (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ)) x) = algebraMap (AdjoinRoot Φ)
      (TypeDensity.BaseField (AdjoinRoot Φ)) (TypeDensity.frobeniusIter O Φ i x))
    (hτι : ∀ (i : ℕ) (y : TypeDensity.BaseField O), τ i (ι y) = ι y)
    (hτ0 : τ 0 = RingEquiv.refl (TypeDensity.BaseField (AdjoinRoot Φ)))
    (hrec : ∀ i : ℕ, τ (i+1) = (τ i).trans (τ 1))
    (hτδ : ∀ z : TypeDensity.BaseField (AdjoinRoot Φ), τ Φ.natDegree z = z)
    (hfix : ∀ z : TypeDensity.BaseField (AdjoinRoot Φ), τ 1 z = z → ∃ y : TypeDensity.BaseField O, ι y = z)
    (hinj : Function.Injective ι) (F : Polynomial (AdjoinRoot Φ))
    (gs : List (Polynomial (TypeDensity.BaseField (AdjoinRoot Φ)))) (hgs : ∀ g ∈ gs, g.Monic ∧ Irreducible g)
    (hd : gs.Pairwise (fun g h => g ≠ h))
    (hprod : F.map (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ))) = gs.prod)
    (hcop : ∀ i j : Fin Φ.natDegree, i ≠ j → IsCoprime
      ((fun i : Fin Φ.natDegree => (F.map (TypeDensity.frobeniusIter O Φ i).toRingHom).map
          (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ)))) i)
      ((fun i : Fin Φ.natDegree => (F.map (TypeDensity.frobeniusIter O Φ i).toRingHom).map
          (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ)))) j)) :
    ∃ H : Fin gs.length → Polynomial (TypeDensity.BaseField O), (∀ a, (H a).Monic ∧ Irreducible (H a)) ∧
      Function.Injective H ∧
      (∀ a, (H a).map ι = ∏ i : Fin Φ.natDegree, (gs.get a).map (τ i).toRingHom) ∧
      (∀ a, (H a).natDegree = Φ.natDegree * (gs.get a).natDegree) ∧ (∏ a, H a).map ι =
      (TypeDensity.conjugateProduct O Φ F).map (algebraMap (AdjoinRoot Φ) (TypeDensity.BaseField (AdjoinRoot Φ))) := by
  obtain ⟨h1, h2, _h3, h4⟩ := TypeDensity.conjugate_irreducible_factors_distinct O Φ τ hτ
    F gs hgs hd hprod hcop
  -- positivity of δ
  have hδ : 0 < Φ.natDegree := Nat.pos_of_ne_zero fun h0 => hΦ.2.not_isUnit <| by
    rw [TypeDensity.residuePoly, eq_one_of_monic_natDegree_zero (hΦ.1.map _) (by rw [hΦ.1.natDegree_map, h0])]
    exact isUnit_one
  set δ := Φ.natDegree with hδdef
  -- orbit product
  let P : Polynomial (TypeDensity.BaseField (AdjoinRoot Φ)) → Polynomial (TypeDensity.BaseField (AdjoinRoot Φ)) :=
    fun p => ∏ i : Fin δ, p.map (τ i).toRingHom
  have Plifts : ∀ p, P p ∈ Polynomial.lifts ι := TypeDensity.orbit_product_lifts ι τ δ hτ0 hrec hτδ hfix
  choose H hH using fun a : Fin gs.length => Polynomial.mem_lifts _ |>.mp (Plifts (gs.get a))
  have gmem : ∀ a : Fin gs.length, gs.get a ∈ gs := fun a => List.get_mem gs a
  have gmon : ∀ a, (gs.get a).Monic := fun a => (hgs _ (gmem a)).1
  have girr : ∀ a, Irreducible (gs.get a) := fun a => (hgs _ (gmem a)).2
  have Pmon : ∀ a, (P (gs.get a)).Monic := fun a =>
    Polynomial.monic_prod_of_monic _ _ fun (i : Fin δ) _ => (h1 i _ (gmon a) (girr a)).1
  have Pdeg : ∀ a, (P (gs.get a)).natDegree = δ * (gs.get a).natDegree := by
    intro a
    simp only [P]
    rw [Polynomial.natDegree_prod_of_monic (h := fun (i : Fin δ) _ => (h1 i _ (gmon a) (girr a)).1)]
    simp [Polynomial.natDegree_map]
  have Hmon : ∀ a, (H a).Monic := fun a =>
    Polynomial.monic_of_injective hinj (by rw [hH a]; exact Pmon a)
  have Hdeg : ∀ a, (H a).natDegree = δ * (gs.get a).natDegree := by
    intro a
    rw [← Pdeg a, ← hH a, Polynomial.natDegree_map_eq_of_injective hinj]
  have hτ0' : ∀ p : Polynomial (TypeDensity.BaseField (AdjoinRoot Φ)), p.map (τ 0).toRingHom = p :=
    fun p => by simp [hτ0]
  have gdvdP : ∀ a, gs.get a ∣ P (gs.get a) := fun a => by
    have h := Finset.dvd_prod_of_mem (fun i : Fin δ => (gs.get a).map (τ i).toRingHom)
      (Finset.mem_univ (⟨0, hδ⟩ : Fin δ))
    rwa [Fin.val_mk, hτ0'] at h
  refine ⟨H, fun a => ⟨Hmon a, ?_⟩, ?_, hH, Hdeg, ?_⟩
  · -- irreducibility
    exact TypeDensity.irreducible_of_map_eq_orbit_product ι hinj τ hτι (girr a)
      (fun i => h1 i _ (gmon a) (girr a)) (fun i j he => (h2 i j a a he).1) (Hmon a) (hH a)
