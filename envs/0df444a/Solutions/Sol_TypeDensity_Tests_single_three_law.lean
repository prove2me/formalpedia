  (simp only [TypeDensity.Tests.childProd, List.map_cons, List.map_nil, TypeDensity.Tests.stateLaw_terminal, TypeDensity.Tests.lawDescend_lawAtom, TypeDensity.Tests.lawProd_cons, TypeDensity.Tests.lawProd_nil, TypeDensity.Tests.coeff_mul_lawOne, TypeDensity.Tests.coeff_descend_one, TypeDensity.Tests.coeff_mul_atom, TypeDensity.Tests.coeff_lawAtom, TypeDensity.Tests.coeff_lawOne, TypeDensity.Tests.ite_mem_erase, TypeDensity.Tests.ite_add_zero, Multiset.cons_zero])
  rw [TypeDensity.Tests.crossing_left_one_law 1 1 2 one_pos one_pos two_pos q hq,
    TypeDensity.Tests.crossing_right_one_law 1 1 2 one_pos one_pos two_pos q hq,
    TypeDensity.Tests.crossing_one_one_law 1 1 one_pos one_pos q hq]
  simp only [TypeDensity.Expr.eval, TypeDensity.Tests.tangentCount_single_one_three, d1, d2, d3, d4, TypeDensity.Tests.ite_mem_erase]
  simp (disch := decide) only [TypeDensity.tangentCount, TypeDensity.Tests.divisorCount_zero, TypeDensity.Tests.divisorCount_cell]
