def checkSteps (bits D : Nat) : Nat → Nat → List Int → List Nat → Nat → Nat → Nat → Nat → Bool
  | _,0,_,_,_,_,_,_ => true
  | i,n+1,fs,ss,pp,pm,pe,pr =>
    decide (((i+1:Int)*fs.headD 0*D+(pp%2^bits:Int)-(pm%2^bits:Int)).natAbs+
      pe%2^bits+pr%2^bits ≤  (i+1)*ss.headD 0*D) &&
    checkSteps bits D (i+1) n fs.tail ss.tail
      (pp>>>bits) (pm>>>bits) (pe>>>bits) (pr>>>bits)

