    (by positivity : 0 ≤ 2*semiprimePartitionScale i)
    (fun p hp => ⟨(semiprimeFullSupport_bounds hX i hp).1,
      (semiprimeFullSupport_bounds hX i hp).2.2⟩)
  exact h.trans_eq (by ring)

