theorem _root_.solution : EffectiveShift.Statement := by
  intro O _ _ _ ϖ hϖ K _ _ ι _ P e hP b f g hD
  classical
  have hPr : P.IsPrime := hP.multiProj.isPrime
  have hCP : (C ϖ : MRing ι O) ∉ P := by
