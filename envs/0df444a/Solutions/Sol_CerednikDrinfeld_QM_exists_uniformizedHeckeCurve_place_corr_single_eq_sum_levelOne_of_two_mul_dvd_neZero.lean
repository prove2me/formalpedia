      (hbcE E) (hbcE E') hAL
    have hM := hPq' (bcE E) (bcE E') hALc
    rw [← L1 E (bcE E) (hbcE E) P hE, ← L1 E' (bcE E') (hbcE E') Q hE', U₀.corr_single_pt, hmap, hM,
