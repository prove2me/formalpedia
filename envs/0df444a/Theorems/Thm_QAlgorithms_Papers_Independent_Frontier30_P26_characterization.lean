-- title:
--   Theorem 3.20: Characterization Theorem
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g=\mathfrak z\oplus V\oplus\mathfrak l$ be admissible in its structural presentation, with faithful $\mathfrak l$-action. Write $x=x_z+x_V+x_l$ and define $H_x^z(v)=x_z+[v,x_V]+\tfrac12[v,[v,x_l]]$ and $\operatorname{co}_z(x)=\overline{\operatorname{conv}}H_x^z(V)$. Then
--
--   $$\operatorname{co}(x)\text{ pointed}\iff\operatorname{co}_z(x)\text{ pointed},$$
--   $$C_x\text{ pointed}\iff\operatorname{co}_z(x)\text{ pointed and }(x_l\text{ ad-nilpotent}\Rightarrow\operatorname{co}_z(x)\text{ lies in a pointed closed convex cone}).$$
--
--   The nilpotent condition includes $x_l=0$. This is the paper’s central characterization.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 14, Theorem 3.20: Characterization Theorem

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Theorem 3.20, PDF pp. 14–15. The conditional nilpotent case includes lPart x=0. -/
theorem characterization (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (hf : FaithfulAction P) (x : G) :
    (Pointed (orbitHull x) ↔ Pointed (centralHull P x)) ∧
    (Pointed (orbitCone x) ↔ Pointed (centralHull P x) ∧
      (AdNilpotent (lPart P x) → InPointedCone (centralHull P x))) := by sorry

end Presentations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
