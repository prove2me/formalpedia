@[reducible] def torsionAction (k : ℕ) : DistribMulAction G ↥(Submodule.torsionBy ℤ J ((p : ℤ) ^ k)) where
  smul σ v := galT p J σ k v
  one_smul v := Subtype.ext (one_smul G (v : J))
  mul_smul σ τ v := Subtype.ext (mul_smul σ τ (v : J))
  smul_zero σ := Subtype.ext (smul_zero σ)
  smul_add σ v w := Subtype.ext (smul_add σ (v : J) (w : J))

