variable {K : Type*} [Field K] (M : MultiProjectiveSpace K)

/-- Equality of projective zero loci makes a relevant homogeneous prime
an actual minimal prime of the defining ideal. -/
theorem prime_minimal_of_zeroLocus_eq [IsAlgClosed K]
    (I p : Ideal M.CoordinateRing) (hI : IsMultihomogeneousIdeal M I)
    (hp : p.IsPrime) (hphom : IsMultihomogeneousIdeal M p)
    (hrel : Hilbert.IsRelevant K M.factorCount M.ambientDimension p)
    (hZ : M.zeroLocus I = M.zeroLocus p) : p ∈ I.minimalPrimes := by
  letI := hp
  have hIp : I ≤ p := calc
    I ≤ M.vanishingIdeal (M.zeroLocus I) :=
      M.homogeneousIdeal_le_vanishingIdeal_zeroLocus I hI
    _ = M.vanishingIdeal (M.zeroLocus p) := congrArg M.vanishingIdeal hZ
    _ = p := M.vanishingIdeal_zeroLocus_of_relevant_prime p hp hphom hrel
  obtain ⟨q,hq,hqp⟩ := Ideal.exists_minimalPrimes_le hIp
  have hqhom := Hilbert.minimalPrime_homogeneous M I q hI hq
  have hqrel : Hilbert.IsRelevant K M.factorCount M.ambientDimension q :=
    fun h => hrel (h.trans hqp)
  have hZqp : M.zeroLocus q ⊆ M.zeroLocus p := by
    rw [← hZ]
    exact fun x hx f hf => hx f (hq.le hf)
  have hpq : p ≤ q := calc
    p = M.vanishingIdeal (M.zeroLocus p) :=
      (M.vanishingIdeal_zeroLocus_of_relevant_prime p hp hphom hrel).symm
    _ ≤ M.vanishingIdeal (M.zeroLocus q) := by
      apply Ideal.span_le.mpr
      rintro f ⟨hhom,hvan⟩
      exact Ideal.subset_span ⟨hhom,fun x hx => hvan x (hZqp hx)⟩
    _ = q := M.vanishingIdeal_zeroLocus_of_relevant_prime q hq.isPrime hqhom hqrel
  exact le_antisymm hpq hqp ▸ hq

theorem prime_meets_top (p : Ideal M.CoordinateRing) (hp : p.IsPrime) :
    Hilbert.MeetsOpen K M.factorCount M.ambientDimension p ⊤ := by
  obtain ⟨m,hm,hle⟩ := Ideal.exists_le_maximal p hp.ne_top
  exact ⟨⟨m,hm⟩,Set.mem_univ _,hle⟩

/-- Every relevant reduced component contributes its nonnegative degree. -/
theorem prime_degree_le_reduced_sum (I p : Ideal M.CoordinateRing)
    (hI : IsMultihomogeneousIdeal M I) (hp : p.IsPrime) (hmin : p ∈ I.minimalPrimes)
    (hrel : Hilbert.IsRelevant K M.factorCount M.ambientDimension p)
    (D : M.FactorIndex → ℕ) :
    idealDegreeValue M p D ≤ componentHilbertSum M I.radical ⊤ D := by
  classical
  letI := Fintype.ofFinite (Hilbert.MinimalComponent K M.factorCount M.ambientDimension I)
  let q : Hilbert.MinimalComponent K M.factorCount M.ambientDimension I := ⟨⟨p,hp⟩,hmin⟩
  rw [RadicalIntersection.reduced_componentSum]
  have h := Finset.single_le_sum (s := Finset.univ) (a := q)
    (fun r _ => show 0 ≤ (if Hilbert.IsRelevant K M.factorCount M.ambientDimension r.1.asIdeal ∧
      Hilbert.MeetsOpen K M.factorCount M.ambientDimension r.1.asIdeal ⊤ then
      Hilbert.degreeValue K M.factorCount M.ambientDimension r.1.asIdeal D else 0) from by
        split_ifs
        · exact PrimaryComponentSupport.degreeValue_nonneg M _
            (Hilbert.minimalPrime_homogeneous M I _ hI r.2) D
        · exact le_rfl)
    (Finset.mem_univ q)
  change (if Hilbert.IsRelevant K M.factorCount M.ambientDimension p ∧
    Hilbert.MeetsOpen K M.factorCount M.ambientDimension p ⊤ then
    idealDegreeValue M p D else 0) ≤ _ at h
  rw [if_pos ⟨hrel,prime_meets_top M p hp⟩] at h
  exact h

theorem reduced_prime_sum_le_degree (p : Ideal M.CoordinateRing)
    (hp : p.IsPrime) (hphom : IsMultihomogeneousIdeal M p) (D : M.FactorIndex → ℕ) :
    componentHilbertSum M p.radical ⊤ D ≤ idealDegreeValue M p D := by
  classical
  letI := Fintype.ofFinite (Hilbert.MinimalComponent K M.factorCount M.ambientDimension p)
  have hmin : p ∈ p.minimalPrimes := ⟨⟨hp,le_rfl⟩,fun _ h _ => h.2⟩
  let q : Hilbert.MinimalComponent K M.factorCount M.ambientDimension p := ⟨⟨p,hp⟩,hmin⟩
  have heq (r : Hilbert.MinimalComponent K M.factorCount M.ambientDimension p) : r = q := by
    apply Subtype.ext
    apply PrimeSpectrum.ext
    exact le_antisymm (r.2.2 ⟨hp,le_rfl⟩ r.2.le) r.2.le
  rw [RadicalIntersection.reduced_componentSum]
  rw [Finset.sum_eq_single q]
  · split_ifs
    · exact le_rfl
    · exact PrimaryComponentSupport.degreeValue_nonneg M p hphom D
  · intro r _ hr
    exact (hr (heq r)).elim
  · simp

end Algebra

variable (K : Type*) [NontriviallyNormedField K]

/-- The set-theoretic projective Bezout bound, using the proved reduced
intersection inequality and the actual ambient Hilbert polynomial. -/
theorem connected_projective_closure_degree_bound_proved
    (hK : IsPhilipponBaseField K) (E : EmbeddedCommutativeGroup K)
    (hconnected : @_root_.IsConnected _ (singleGroupProduct E).zariskiTopology Set.univ)
    (b : ℕ) (hb : 1 ≤ b)
    (hclosure : ∃ equations : Finset (singleGroupProduct E).CoordinateRing,
      (∀ P ∈ equations, (singleGroupProduct E).ambient.IsHomogeneousAtMost P (fun _ => b)) ∧
      groupProjectiveClosure (singleGroupProduct E) =
        {x | ∀ P ∈ equations, (singleGroupProduct E).ambient.eval P x = 0}) :
    ((idealDegreeValue (singleGroupProduct E).ambient
      ((singleGroupProduct E).vanishingIdeal Set.univ) (fun _ => 1) : ℚ) : ℝ) ≤
        (b : ℝ) ^ (E.ambientDimension - (singleGroupProduct E).dimension) := by
  classical
  letI : IsAlgClosed K := hK.isAlgClosed
  let G := singleGroupProduct E
  let M := G.ambient
  let p := G.vanishingIdeal Set.univ
  obtain ⟨F,hF,hZ⟩ := hclosure
  let I : Ideal M.CoordinateRing := Ideal.span (F : Set M.CoordinateRing)
  have hI : IsMultihomogeneousIdeal M I := OperatorSupport.homogeneous_span M _ (by
    intro f hf
    obtain ⟨d,_,hd⟩ := hF f hf
    exact ⟨d,hd⟩)
  have hp : p.IsPrime := MWCutInduction.connected_group_prime G hconnected
  have hphom : IsMultihomogeneousIdeal M p := vanishingIdeal_multihomogeneous K _ _
  have hrel := M.relevant_of_zeroLocus_nonempty p
    ⟨G.embedding 0,fun f hf => M.eval_eq_zero_of_mem_vanishingIdeal hf
      ⟨0,Set.mem_univ _,rfl⟩⟩
  have hZI : M.zeroLocus I = {x | ∀ f ∈ F, M.eval f x = 0} := by
    ext x
    constructor
    · exact fun hx f hf => hx f (Ideal.subset_span hf)
    · intro hx
      change I ≤ RingHom.ker (MvPolynomial.eval (M.coordinate x))
      exact Ideal.span_le.mpr hx
  have hZp : M.zeroLocus p = groupProjectiveClosure G := by
    change M.zeroLocus (M.vanishingIdeal (G.embedding '' Set.univ)) = _
    rw [M.zeroLocus_vanishingIdeal_eq_closure,Set.image_univ]
    rfl
  have hmin : p ∈ I.minimalPrimes := prime_minimal_of_zeroLocus_eq M I p hI hp hphom hrel
    (hZI.trans (hZ.symm.trans hZp.symm))
  let e := F.equivFin.symm
  let P (j : Fin F.card) : M.CoordinateRing := (e j).val
  have hrange : Set.range P = (F : Set M.CoordinateRing) := by
    ext f
    constructor
    · rintro ⟨j,rfl⟩
      exact (e j).property
    · intro hf
      obtain ⟨j,hj⟩ := e.surjective ⟨f,hf⟩
      exact ⟨j,congrArg Subtype.val hj⟩
  have hP (j : Fin F.card) : IsMultihomogeneousOfDegreeAtMost M (P j) (fun _ => b) := by
    obtain ⟨d,hd,hh⟩ := hF (P j) (e j).property
    exact ⟨d,hd,(M.degreePiece_iff _ _).mpr hh⟩
  have hbot : IsMultihomogeneousIdeal M (⊥ : Ideal M.CoordinateRing) := by
    intro f hf d
    have hf0 := Ideal.mem_bot.mp hf
    simp [hf0]
  have hcut := (proposition_3_3 K hK M ⊥ hbot F.card P (fun _ => b) hP).1
  have hsum : componentHilbertSum M I.radical ⊤ (fun _ => b) ≤
      componentHilbertSum M (⊥ : Ideal M.CoordinateRing).radical ⊤ (fun _ => b) := by
    simpa only [bot_sup_eq,hrange] using hcut
  have hdeg : idealDegreeValue M p (fun _ => b) ≤ (b : ℚ)^E.ambientDimension := calc
    _ ≤ componentHilbertSum M I.radical ⊤ (fun _ => b) :=
      prime_degree_le_reduced_sum M I p hI hp hmin hrel _
    _ ≤ componentHilbertSum M (⊥ : Ideal M.CoordinateRing).radical ⊤ (fun _ => b) := hsum
    _ ≤ idealDegreeValue M ⊥ (fun _ => b) :=
      reduced_prime_sum_le_degree M ⊥ Ideal.isPrime_bot hbot _
    _ = (b : ℚ)^E.ambientDimension := by
      change idealDegreeValue (projectiveSpace K E.ambientDimension) ⊥ (fun _ => b) = _
      exact ProjectiveAmbientDegree.degreeValue_bot K E.ambientDimension b
  have hdim : idealDimension M p = G.dimension := MWCutInduction.single_group_dimension E
  change idealDegreeValue (projectiveSpace K E.ambientDimension) p (fun _ => b) ≤ _ at hdeg
  rw [MWCutInduction.degree_scale] at hdeg
  change idealDegreeValue M p (fun _ => 1) * (b : ℚ)^idealDimension M p ≤ _ at hdeg
  rw [hdim] at hdeg
  have hbQ : (1 : ℚ) ≤ b := by exact_mod_cast hb
  have hexp : E.ambientDimension ≤ E.ambientDimension-G.dimension+G.dimension := by omega
  have hpow := pow_le_pow_right₀ hbQ hexp
  rw [pow_add] at hpow
  have hbound : idealDegreeValue M p (fun _ => 1) ≤ (b : ℚ)^(E.ambientDimension-G.dimension) :=
    (mul_le_mul_iff_left₀ (pow_pos (lt_of_lt_of_le zero_lt_one hbQ) G.dimension)).mp
      (hdeg.trans hpow)
  exact_mod_cast hbound

end PhilipponMultiplicity.ProjectiveClosureDegree

end
end

open PhilipponMultiplicity

theorem solution
    (K : Type*) [NontriviallyNormedField K] (hK : IsPhilipponBaseField K)
    (E : EmbeddedCommutativeGroup K)
    (hconnected : @_root_.IsConnected _ (singleGroupProduct E).zariskiTopology Set.univ)
    (b : ℕ) (hb : 1 ≤ b)
    (hclosure : ∃ equations : Finset (singleGroupProduct E).CoordinateRing,
      (∀ P ∈ equations, (singleGroupProduct E).ambient.IsHomogeneousAtMost P (fun _ => b)) ∧
      groupProjectiveClosure (singleGroupProduct E) =
        {x | ∀ P ∈ equations, (singleGroupProduct E).ambient.eval P x = 0}) :
    ((SectionThree.idealDegreeValue (singleGroupProduct E).ambient
      ((singleGroupProduct E).vanishingIdeal Set.univ) (fun _ => 1) : ℚ) : ℝ) ≤
        (b : ℝ) ^ (E.ambientDimension - (singleGroupProduct E).dimension) := by
  exact ProjectiveClosureDegree.connected_projective_closure_degree_bound_proved
    K hK E hconnected b hb hclosure
