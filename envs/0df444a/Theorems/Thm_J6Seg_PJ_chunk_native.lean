theorem J6Seg.PJ.chunk_native (P : Prm) (hP : P.Ok) (pl : Plan6) {Zn : Fin HS} {oN : Fin 19 → Fin HS}
    (hZ : Zn ∉ rg) (hZ5 : Zn.val < 56) (hZT : Zn ≠ sTmp) (hZC : Zn ≠ cRdC) (hZ2 : Zn ≠ sT2)
    (hZx : Zn ≠ J6Seg.PJ.sSt ∧ Zn ≠ sX ∧ Zn ≠ sOut ∧ Zn ≠ sLn ∧ Zn ≠ cLC ∧ Zn ≠ 13 ∧ Zn ≠ 51 ∧ Zn ≠ 53 ∧
      Zn ≠ 54 ∧ Zn ≠ PreT.Cu)
    (hinj : Injective oN) (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC)
    (hZo : ∀ i, oN i ≠ Zn) :
    ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ k ≤ D, ∀ A' : ℕ, ∃ cU cD : ℕ,
      (∀ s0, Sp (eCn pl Zn oN) (encK s0 (F0 Zn (descAx6 P n src D k)))
        (encK s0 (extend oN (chunkRegs6 P n src D k pl) (F0 Zn (descAx6 P n src D k)))) cU) ∧
      (∀ s0, Sp (tearP oN) (encK s0 (extend oN (chunkRegs6 P n src D k pl)
        (F0 Zn (descAx6 P n src D k)))) (encK s0 (F0 Zn (descAx6 P n src D k))) cD) ∧
      ((cU + 2 : ℕ) : ℝ) ≤ 2 * (cU6 P n A' / (D + 1)) ∧
      ((cD + 2 : ℕ) : ℝ) ≤ 2 * (cU6 P n A' / (D + 1)) := by sorry
