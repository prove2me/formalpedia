# Proper base change for the projective line, library file 203

Declarations of the formalization of proper base change for the étale cohomology of the projective
line over a base (geometric stalks of the higher direct images of P¹_S → S are the étale cohomology of
the geometric fibres), re-hosted declaration by declaration from the library modules below. Each module
contributes the declarations assigned to this file, copied verbatim with the module's own `namespace` /
`open` / `variable` lines, inside its own `section` ... `end`:

* `S4.Def_RP_EtPBC_A_O2T8`: S4-EtPBC-A, O2 S5h (O2T8): one-point classes with coefficients `Λ[T]`
-/

set_option autoImplicit false

-- ===== S4.Def_RP_EtPBC_A_O2T8 =====
section

/-!
# S4-EtPBC-A, O2 S5h (O2T8): one-point classes with coefficients `Λ[T]`

**`isLoc_free_decomp`**: for `T` separated étale over `P` with finite fibre over `z = c (X = a)`, a one-point class
`β ∈ Ext²(Λ_P, Λ[T])` at `z` is, modulo the subgroup generated by the point classes `pcD c' ∘ Λ[s]`
(`s : Spec B ⟶ T`), the class `clsD (Λ[g] ≫ resFreeIso) Y_R` of an open `R ⊆ Spec B ×_P T` with no point over `z`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtMV

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.GalTrE RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.FreeStk RamanujanPetersson.EtPBC.EtDed

section Decomp

variable {k : Type} [Field k] [IsAlgClosed k] {Λ : Type} [CommRing Λ] {P : Scheme.{0}} (c : A1 k ⟶ P)
  [IsOpenImmersion c] (a : k) {N : ℕ} [NeZero N] (hN : (N : k) ≠ 0) (hΛ : ∀ x : Λ, N • x = 0)

set_option backward.isDefEq.respectTransparency false in
include hN hΛ in
/-- **One-point classes with coefficients `Λ[T]`**: point classes `pcD c' ∘ Λ[s]` plus a residual class through an
open `R ⊆ Spec B ×_P T` with no point over `z`. -/
theorem isLoc_free_decomp {T : P.Etale} [IsSeparated T.hom]
    [Finite ((geomPtAt (c (A1pt k a))).point.fiber.obj T)] (hG : Subsingleton (Gal (c (A1pt k a))))
    {β : Ext.{0} (freeSh Λ (etId P)) (freeSh Λ T) 2} (hβ : IsLoc Λ (freeSh Λ T) (c (A1pt k a)) β) :
    ∃ (B : CommRingCat.{0}) (φ : CommRingCat.of k[X] ⟶ B) (_ : Etale (Spec.map φ ≫ c)) (Uz : P.Opens)
      (hUz : ∀ u : Spec B, (chEt c φ).hom u ∈ Uz ↔ φ.hom (X - C a) ∉ u.asIdeal)
      (hS : (locC Λ (chEt c φ) (le_refl Uz)).ShortExact) (R : (chEt c φ).left.Etale)
      (g : R ⟶ (etPull (chEt c φ).hom).obj T)
      (YR : H Λ ((res (toD1 c φ a).left Λ).obj (freeSh Λ R)) 1),
      φ.hom.Etale ∧ IsDedekindDomain B ∧ φ.hom (X - C a) ≠ 0 ∧ (Ideal.span {φ.hom (X - C a)}).IsPrime ∧
      (∀ x : P, x ∈ Uz ↔ x ≠ c (A1pt k a)) ∧
      Subsingleton ((geomPtAt (c (A1pt k a))).point.fiber.obj (chEt c φ)) ∧
      Nonempty ((geomPtAt (c (A1pt k a))).point.fiber.obj (chEt c φ)) ∧ IsOpenImmersion g.left ∧ IsSeparated R.hom ∧
      (IsAffineHom T.hom → IsAffine R.left) ∧
      (∀ r : R.left, (chEt c φ).hom (R.hom r) ≠ c (A1pt k a)) ∧
      β - (clsD c φ a hUz hS (freeMap Λ g ≫ (resFreeIso Λ (chEt c φ).hom T).hom) YR :
        Ext.{0} (freeSh Λ (etId P)) (freeSh Λ T) 2) ∈
        AddSubgroup.closure {x | ∃ (s : chEt c φ ⟶ T) (c' : Λ),
          x = (pcD c φ a hN hΛ hUz hS c').comp (Ext.mk₀ (freeMap Λ s)) (add_zero 2)} := by
  classical
  obtain ⟨Uo, Uz, h, hz, D, hD, hDn, hDr, κ, hβe⟩ := hβ
  have hzc : IsClosed ({c (A1pt k a)} : Set P) := by
    have : ({c (A1pt k a)} : Set P) = (Uz : Set P)ᶜ := Set.ext fun x => by
      rw [Set.mem_singleton_iff, Set.mem_compl_iff, SetLike.mem_coe, hz x, not_not]
    rw [this]
    exact Uz.isOpen.isClosed_compl
  have : Fintype ((geomPtAt (c (A1pt k a))).point.fiber.obj T) := Fintype.ofFinite _
  -- sections through every fibre point, disjoint graphs, then the affine Dedekind presentation
  obtain ⟨D₁, hD₁, hDn₁, hDr₁, κ₁, τ₁, hτ₁, e₁⟩ := isLoc_secs Λ h hz hD hDn hDr κ hzc hG T Finset.univ
  obtain ⟨D₂, hD₂, hDn₂, hDr₂, κ₂, τ₂, hτ₂, hdisj₂, e₂⟩ := isLoc_disj Λ h hz hD₁ hDn₁ hDr₁ κ₁ hG T
    (fun t => τ₁ t (Finset.mem_univ t)) (fun t d => hτ₁ t (Finset.mem_univ t) d)
  obtain ⟨B, φ, hφE, hφ, hded, ht, hP, hD', hDn', hDr', κ', dm, e₃⟩ := isLoc_aff_map c a h hz hD₂ hDn₂ hDr₂ κ₂
  have hDrz : ∀ v : (chEt c φ).left, (chEt c φ).hom v ∈ Uz ∨ (chEt c φ).hom v = c (A1pt k a) :=
    fun v => (hDr' v).imp_left (fun hv => h hv)
  have hUo := mem_Uo_iff c φ h hz hDr'
  have hUz := mem_Uo_iff c φ (le_refl Uz) hz hDrz
  have hS := locC_shortExact (Λ := Λ) (chEt c φ) (le_refl Uz) (c (A1pt k a)) hz hD' hDn' hDrz
  -- the sections over `Spec B`
  have hτ : ∀ t d, (geomPtAt (c (A1pt k a))).point.fiber.map (dm ≫ τ₂ t) d = t := fun t d => by
    rw [Functor.map_comp_apply, hτ₂]
  have hdisj : ∀ t t', t ≠ t' →
      Disjoint (Set.range (graph (dm ≫ τ₂ t)).left) (Set.range (graph (dm ≫ τ₂ t')).left) :=
    fun t t' htt => disjoint_graph fun v hv => hdisj₂ t t' htt (dm.left v) (graphMeet_natural dm (τ₂ t) (τ₂ t') hv)
  -- the class as `clsD` with coefficients `Λ[Spec B ×_P T]`
  obtain ⟨Y₀, hY₀⟩ : ∃ Y₀ : H Λ ((res (toD1 c φ a).left Λ).obj ((res (chEt c φ).hom Λ).obj (freeSh Λ T))) 1,
      β = clsD c φ a hUz hS (𝟙 _) Y₀ :=
    ⟨_, hβe.trans (e₁.trans (e₂.trans (e₃.trans (cls_eq_clsD c φ a hUz hS h hUo _ κ'))))⟩
  rw [← Iso.inv_hom_id (resFreeIso Λ (chEt c φ).hom T), clsD_comp] at hY₀
  obtain ⟨R, g, hg, hR, hRa, YR, h1, -, h3⟩ := clsD_splitAll c φ a hUz hS
    (N := (etPull (chEt c φ).hom).obj T) (fun t => graph (dm ≫ τ₂ t)) hdisj
    (resFreeIso Λ (chEt c φ).hom T).hom
    (Y₀.comp (Ext.mk₀ ((res (toD1 c φ a).left Λ).map (resFreeIso Λ (chEt c φ).hom T).inv)) (add_zero 1))
    Finset.univ
  -- the residual has no point over `z`
  have hres : ∀ r : R.left, (chEt c φ).hom (R.hom r) ≠ c (A1pt k a) := by
    intro r hr
    obtain ⟨d⟩ := hDn'
    have hRr : R.hom r = fpt (c (A1pt k a)) d := eq_fpt_of_over hD' d (R.hom r) hr
    have he : ((etPull (chEt c φ).hom).obj T).hom (g.left r) = fpt (c (A1pt k a)) d :=
      (Scheme.Hom.comp_apply g.left _ r).symm.trans
        ((congrArg (fun f : R.left ⟶ (chEt c φ).left => f r) (MorphismProperty.Over.w g)).trans hRr)
    obtain ⟨b, hb⟩ := graph_cover (c (A1pt k a)) d (fun t => dm ≫ τ₂ t) (fun b => hτ b d) (g.left r) he
    exact h1 r b (Finset.mem_univ b) hb
  have hRa' : IsAffineHom T.hom → IsAffine R.left := fun hT => hRa (by
    have : IsAffineHom (pullback.snd T.hom (chEt c φ).hom) :=
      MorphismProperty.pullback_snd (P := @IsAffineHom) _ _ hT
    have : IsAffine ((𝟭 Scheme).obj (chEt c φ).left) := show IsAffine (Spec B) from inferInstance
    exact isAffine_of_isAffineHom (pullback.snd T.hom (chEt c φ).hom))
  refine ⟨B, φ, hφE, Uz, hUz, hS, R, g, YR, hφ, hded, ht, hP, hz, hD', hDn', hg, hR, hRa', hres, ?_⟩
  rw [hY₀]
  refine AddSubgroup.closure_mono ?_ h3
  rintro x ⟨i, -, Y', rfl⟩
  obtain ⟨c', hc'⟩ := clsD_graph c φ a hN hΛ hUz hS hφ ht hP (dm ≫ τ₂ i) Y'
  exact ⟨dm ≫ τ₂ i, c', hc'⟩

end Decomp

end RamanujanPetersson.EtPBC.EtMV

end

