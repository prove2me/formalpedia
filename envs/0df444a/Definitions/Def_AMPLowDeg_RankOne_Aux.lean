-- author  : @mikedeng1
-- created : 2026-11-08T09:02:43.24702+00:00
-- url     : https://prove2.me/theorems/10a3a8c4-933a-49aa-8a63-35fe43f17d74
-- title:
--   Conditional cumulants $\mathcal K_\alpha(R)$ (2.7), $A_\alpha(\theta)$ (2.10), the channel (2.9), the field (4.2) and $C_\alpha(h)$ (4.3)
-- statement:
--   Let $R=R(\theta,Z)\in\mathbb R^N$ be an auxiliary observation, where $Z$ is external randomness.
--
--   1. **Conditional cumulants (2.7).**
--   $$
--   \mathcal K_\alpha(R)=\mathrm{Cum}\big(\theta_1,\ \underbrace{x_e(\theta),\dots,x_e(\theta)}_{\alpha_e\text{ copies}}:e\in\mathcal E_n\ \big|\ R\big),\qquad \mathcal K_0(R)=\mathbb E[\theta_1\mid R].
--   $$
--   2. **Averaged cumulants (2.10).** $A_\alpha(\theta)=\mathbb E[\mathcal K_\alpha(R)\mid\theta]$.
--   3. **The channel (2.9).** $R=\sqrt s\,\theta+Z$ with $Z\sim\mathcal N(0,I_n)$ independent of $\theta$ (and of the noise $W$), and the field $H_i=\sqrt s R_i=s\theta_i+\sqrt s Z_i$ of (4.2).
--   4. **Graph cumulants (4.3).** For $s>0$ and $h\in\mathbb R^n$,
--   $$
--   C_\alpha(h)=\mathrm{Cum}\big(\theta_1,\ \underbrace{x_e(\theta),\dots,x_e(\theta)}_{\alpha_e\text{ copies}}:e\in\mathcal E_n\big)
--   $$
--   under the product law $\bigotimes_{i=1}^n\pi_{s,h_i}$.
--
--   For the channel (2.9) one has $\mathcal K_\alpha(R)=C_\alpha(H)$ (p. 11), a proved identity that is not used as a definition here.
--
--   **Formalization Note** The variables of the cumulants are labelled by `Option (Σ e, Fin (α e))`: `none` is $\theta_1$ and $\langle e,k\rangle$ is the $k$-th copy of $x_e$. $\mathcal K_\alpha$ conditions on the $\sigma$-algebra generated by $R$ and $A_\alpha$ on the one generated by $\theta$. For the channel (2.9) these are taken on the space of $(\theta,Z)$ with law $\pi^{\otimes n}\otimes\mathcal N(0,I_n)$, since $W$ does not enter them.
-- source:
--   Zhangsong Li, Almost Sharp Equivalence between Approximate Message Passing and Low-Degree Polynomials, STOC 2027 submission #180 (October 2026), source.pdf SHA-256 9eb368625386c835173a663de76761a4514eda91fb4398b726b5affa824b5a0c, p. 7, (2.7) and (2.9); p. 8, (2.10); p. 11, (4.2) and (4.3); https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/180.pdf

import Mathlib
import Definitions.Def_AMPLowDeg_RankOne_Model
import Definitions.Def_AMPLowDeg_RankOne_Cumulant
import Definitions.Def_AMPLowDeg_RankOne_Potential

open MeasureTheory ProbabilityTheory

namespace AMPLowDeg.RankOne

/-- The labels of the variables `(θ₁, x_e(θ), …, x_e(θ) [α_e copies] : e ∈ ℰₙ)` entering
(2.7) and (4.3): `none` is `θ₁` (the root coordinate), `some ⟨e, k⟩` the `k`-th copy of `x_e`. -/
abbrev CumIdx {n : ℕ} (α : Edge n → ℕ) := Option (Σ e : Edge n, Fin (α e))

/-- The variables of (2.7)/(4.3) as functions of the signal: `none ↦ θ_r`, `⟨e, k⟩ ↦ x_e(θ)`.
The root `r` is the paper's vertex `1`. -/
def cumVars {n : ℕ} (r : Fin n) (α : Edge n → ℕ) : CumIdx α → (Fin n → ℝ) → ℝ
  | none => fun θ => θ r
  | some ⟨e, _⟩ => fun θ => edgeVar θ e

/-- The conditional cumulant `𝒦_α(R) = Cum(θ₁, x_e(θ) [α_e copies] : e ∈ ℰₙ | R)` of (2.7), for a
signal `θ` and an auxiliary observation `R` on a probability space `(Ω, μ)`; `𝒦₀(R) = E[θ₁ | R]`. -/
noncomputable def Kcum {Ω : Type*} [MeasurableSpace Ω] {n N : ℕ} (μ : Measure Ω)
    (θ : Ω → Fin n → ℝ) (R : Ω → Fin N → ℝ) (r : Fin n) (α : Edge n → ℕ) : Ω → ℝ :=
  condCum μ (MeasurableSpace.comap R inferInstance) (fun j w => cumVars r α j (θ w))

/-- `A_α(θ) = E[𝒦_α(R) | θ]` of (2.10). -/
noncomputable def Acum {Ω : Type*} [MeasurableSpace Ω] {n N : ℕ} (μ : Measure Ω)
    (θ : Ω → Fin n → ℝ) (R : Ω → Fin N → ℝ) (r : Fin n) (α : Edge n → ℕ) : Ω → ℝ :=
  μ[Kcum μ θ R r α | MeasurableSpace.comap θ inferInstance]

/-- The law of `(θ, Z)` for the auxiliary channel (2.9): `θ` i.i.d. `∼ π` and `Z ∼ 𝒩(0, Iₙ)`
independent. (The noise `W` of (1.1) is independent of both and does not enter `A_α`.) -/
noncomputable def chanLaw (π : Measure ℝ) (n : ℕ) : Measure ((Fin n → ℝ) × (Fin n → ℝ)) :=
  (Measure.pi fun _ : Fin n => π).prod (Measure.pi fun _ : Fin n => gaussianReal 0 1)

/-- The auxiliary observation (2.9): `R = √s θ + Z`. -/
noncomputable def chanObs {n : ℕ} (s : ℝ) : (Fin n → ℝ) × (Fin n → ℝ) → Fin n → ℝ :=
  fun w i => Real.sqrt s * w.1 i + w.2 i

/-- The field `Hᵢ = √s Rᵢ = s θᵢ + √s Zᵢ` of (4.2). -/
noncomputable def Hfield {n : ℕ} (s : ℝ) : (Fin n → ℝ) × (Fin n → ℝ) → Fin n → ℝ :=
  fun w i => s * w.1 i + Real.sqrt s * w.2 i

/-- `A_α(θ) = E[𝒦_α(R) | θ]` for the auxiliary channel (2.9) at strength `s`. -/
noncomputable def Aaux (π : Measure ℝ) {n : ℕ} (s : ℝ) (r : Fin n) (α : Edge n → ℕ) :
    (Fin n → ℝ) × (Fin n → ℝ) → ℝ :=
  Acum (chanLaw π n) Prod.fst (chanObs s) r α

/-- `C_α(h) = Cum(θ₁, x_e(θ) [α_e identical copies] : e ∈ ℰₙ)` of (4.3), the cumulant under the
independent product law `⊗ᵢ π_{s,hᵢ}`, for a field `h ∈ ℝⁿ`. -/
noncomputable def Ccum (π : Measure ℝ) {n : ℕ} (s : ℝ) (r : Fin n) (α : Edge n → ℕ)
    (h : Fin n → ℝ) : ℝ :=
  cum (Measure.pi fun i : Fin n => post π s (h i)) (cumVars r α)

end AMPLowDeg.RankOne


