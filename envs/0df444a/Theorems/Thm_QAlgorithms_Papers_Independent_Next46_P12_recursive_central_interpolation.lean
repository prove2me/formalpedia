-- title:
--   Theorem 3.11: recursive primitive central idempotents
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Let $(J_i)$ be a JM sequence. For an edge $\mu\to\lambda$ into level $n\ge1$, set $d_{\mu\lambda}=a_\lambda-a_\mu$ using the central partial sums $z_n=\sum_{i=1}^nJ_i$, and define
--
--   $$P_\mu^\lambda(x)=\prod_{\nu:\mu\to\nu,\ \nu\ne\lambda}\frac{x-d_{\mu\nu}}{d_{\mu\lambda}-d_{\mu\nu}}.$$
--
--   The denominators are nonzero, and for every $\lambda\in\operatorname{Irr}(n)$,
--
--   $$\epsilon(\lambda)=\sum_{\mu:\mu\to\lambda}P_\mu^\lambda(J_n)\epsilon(\mu).$$
--
--   The predecessor idempotents are embedded into $A_n$.
--
--   This reconstructs primitive central idempotents recursively from last-edge polynomials.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 15, Theorem 3.11: recursive primitive central idempotents

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Theorem 3.11, source PDF p. 15. Incoming edges index the sum; OTHER OUTGOING
edges of each predecessor index its interpolation polynomial. -/
theorem recursive_central_interpolation (D : Tower k AA) (J : (i : ℕ) → AA (i + 1))
    (hJ : IsJMSequence D J) (n : ℕ) (lam : (D.split (n + 1)).Label) :
    (∀ mu nu, Branch D n mu lam → Branch D n mu nu → nu ≠ lam →
      edgeContent D J n mu lam - edgeContent D J n mu nu ≠ 0) ∧
    centralIdempotent (D.split (n + 1)) lam =
      ∑ mu ∈ Finset.univ.filter (fun mu => Branch D n mu lam),
        Polynomial.aeval (J n) (edgePolynomial D J n mu lam) *
          D.inc n (n + 1) (by omega) (centralIdempotent (D.split n) mu) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
