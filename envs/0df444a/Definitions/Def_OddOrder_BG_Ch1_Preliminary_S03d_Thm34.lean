        intro v hv
        have hv2 : ∀ r : ↥R, ρ ((r : G)) (v : V) = (v : V) := by
          intro r
          have hrQmem : (QuotientGroup.mk' N) (r : G) ∈ R.map (QuotientGroup.mk' N) :=
