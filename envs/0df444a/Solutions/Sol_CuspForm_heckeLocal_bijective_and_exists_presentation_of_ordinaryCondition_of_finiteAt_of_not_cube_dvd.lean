theorem GaloisRepAdic.isUnipotentOnInertiaAt_of_baseChangeAlong_injective {A B : Type} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] (φ : A →+* B) (hφ : IsLocalHom φ) (hinj : Function.Injective φ)
    (ρ : GaloisRepAdic A) {q : ℕ} (h : (ρ.baseChangeAlong φ hφ).IsUnipotentOnInertiaAt q) : ρ.IsUnipotentOnInertiaAt q := by
  intro P hP σ hσ
  have h1 := h P hP σ hσ
  rw [LadderDescent.charpoly_baseChangeAlong_adic] at h1
  apply Polynomial.map_injective φ hinj
  rw [h1, Polynomial.map_pow, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_one]

