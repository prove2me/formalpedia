-- Round-six κ development (integer-multiplication-kappa), generated by skeleton subtraction.


set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Seg
open Finset Real
open IntMul.HvdH IntMul.HvdH.JPf J6QLU
variable {s t α : ℕ} {B : Blocks}



theorem solution (hB : BlocksOK s t B) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α)
    (hx1 : 1 ≤ xθ s t α) (x : ℕ → ℝ) (X : ℝ) (hX : ∀ k < s, |x k| ≤ X) {i : ℕ} (hi : i < s) :
    |NxR s t α x i - (Mv (blS B) (MxG s t α) x i + Dv (Hset B) (col B.s) (cfG s t α) x i)| ≤
      4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1)))) * X := by
  classical
  have hX0 : 0 ≤ X := le_trans (abs_nonneg _) (hX 0 hs)
  have hBs := hB.hs
  obtain ⟨hst_i, hi_lt, hend⟩ := hB.cover i hi
  set L : ℤ := (i : ℤ) with hLdef
  have heEx0 : ∀ h, 0 ≤ eEx s t α L h := by
    intro h; unfold eEx; split_ifs <;> positivity
  obtain ⟨hgs, hgle⟩ := J6Seg.tail_sum s t α hs hst hα L B.w
  set g : ℤ → ℝ := fun h => if (B.w : ℤ) < |h| then eEx s t α L h else 0 with hg
  set f : ℤ → ℝ := fun h => eEx s t α L h * x ((((i : ℤ) + h) % s).toNat) with hf
  have hcol_lt : ∀ h : ℤ, ((((i : ℤ) + h) % s).toNat) < s := by
    intro h
    have h1 : 0 ≤ ((i : ℤ) + h) % s := Int.emod_nonneg _ (by exact_mod_cast hs.ne')
    have h2 : ((i : ℤ) + h) % s < s := Int.emod_lt_of_pos _ (by exact_mod_cast hs)
    omega
  have hfabs : ∀ h, |f h| ≤ eEx s t α L h * X := by
    intro h
    rw [hf]; dsimp only
    rw [abs_mul, abs_of_nonneg (heEx0 h)]
    exact mul_le_mul_of_nonneg_left (hX _ (hcol_lt h)) (heEx0 h)
  -- finite set F
  set Fb : Finset ℤ := (blS B i).image (fun k : ℕ => (k : ℤ) - i) with hFb
  have hdisj : Disjoint Fb (Hset B i) := by
    rw [Finset.disjoint_left]
    intro h hh1 hh2
    obtain ⟨k, hk, rfl⟩ := Finset.mem_image.1 hh1
    unfold Hset at hh2
    rw [Finset.mem_filter] at hh2
    unfold blS at hk
    rw [Finset.mem_Ico] at hk
    apply hh2.2.2
    constructor <;> push_cast <;> omega
  set F := Fb ∪ Hset B i with hF
  -- eEx summable
  have hes : Summable (fun h => eEx s t α L h) := by
    have hfin : Summable (fun h : ℤ => if (B.w : ℤ) < |h| then 0 else eEx s t α L h) := by
      apply summable_of_ne_finset_zero (s := Finset.Icc (-(B.w : ℤ)) B.w)
      intro h hh
      rw [Finset.mem_Icc] at hh
      have : (B.w : ℤ) < |h| := by
        rw [lt_abs]; by_contra hc; push_neg at hc; exact hh ⟨by linarith [hc.2], hc.1⟩
      simp [this]
    have := hgs.add hfin
    refine this.congr fun h => ?_
    simp only [hg]
    split_ifs <;> simp
  have hfs : Summable f :=
    Summable.of_norm_bounded (hes.mul_right X) (fun h => by rw [Real.norm_eq_abs]; exact hfabs h)
  -- split f
  set f1 : ℤ → ℝ := fun h => if h ∈ F then f h else 0
  set f2 : ℤ → ℝ := fun h => if h ∈ F then 0 else f h
  have hf12 : f = fun h => f1 h + f2 h := by
    funext h; simp only [f1, f2]; split_ifs <;> simp
  have hf1s : Summable f1 := summable_of_ne_finset_zero (s := F) (fun h hh => by simp [f1, hh])
  have hf2s : Summable f2 := by
    have : f2 = fun h => f h - f1 h := by funext h; simp only [f1, f2]; split_ifs <;> simp
    rw [this]; exact hfs.sub hf1s
  have htf1 : ∑' h, f1 h = ∑ h ∈ F, f h := by
    rw [tsum_eq_sum (s := F) (fun h hh => by simp [f1, hh])]
    exact Finset.sum_congr rfl fun h hh => by simp [f1, hh]
  -- bound on f2
  have hf2b : ∀ h, |f2 h| ≤ g h * X := by
    intro h
    simp only [f2, hg]
    by_cases hhF : h ∈ F
    · simp [hhF]; split_ifs <;> [exact mul_nonneg (heEx0 h) hX0; simp]
    · simp only [hhF, if_false]
      have hw : (B.w : ℤ) < |h| := by
        by_contra hc; push_neg at hc
        apply hhF
        rw [hF, Finset.mem_union]
        by_cases hin : (B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i
        · left
          rw [hFb, Finset.mem_image]
          refine ⟨((i : ℤ) + h).toNat, ?_, by omega⟩
          unfold blS; rw [Finset.mem_Ico]; omega
        · by_cases h0 : h = 0
          · exfalso; apply hin; subst h0; push_cast; omega
          · right
            unfold Hset
            rw [Finset.mem_filter, Finset.mem_image]
            refine ⟨⟨(h + B.w).toNat, Finset.mem_range.2 (by rw [abs_le] at hc; omega), by
              rw [abs_le] at hc; omega⟩, h0, hin⟩
      simp only [hw, if_true]
      exact hfabs h
  have hf2abs : |∑' h, f2 h| ≤ (∑' h, g h) * X := by
    calc |∑' h, f2 h| = ‖∑' h, f2 h‖ := (Real.norm_eq_abs _).symm
      _ ≤ ∑' h, ‖f2 h‖ := norm_tsum_le_tsum_norm hf2s.norm
      _ ≤ ∑' h, g h * X := by
          apply Summable.tsum_le_tsum (fun h => by rw [Real.norm_eq_abs]; exact hf2b h) hf2s.norm
            (hgs.mul_right X)
      _ = (∑' h, g h) * X := tsum_mul_right
  -- identify M x + Δ x
  have hMv : Mv (blS B) (MxG s t α) x i = x i + ∑ h ∈ Fb, f h := by
    unfold Mv MxG
    simp only [add_mul, Finset.sum_add_distrib]
    have hiB : i ∈ blS B i := by unfold blS; rw [Finset.mem_Ico]; omega
    rw [Finset.sum_eq_single_of_mem i hiB (fun k _ hk => by simp [kd, Ne.symm hk])]
    simp only [kd, if_true, one_mul]
    congr 1
    rw [hFb, Finset.sum_image (fun a _ b _ hab => by omega)]
    refine Finset.sum_congr rfl fun k hk => ?_
    unfold blS at hk; rw [Finset.mem_Ico] at hk
    simp only [hf]
    congr 2
    have : (i : ℤ) + ((k : ℤ) - i) = k := by ring
    rw [this, Int.emod_eq_of_lt (by positivity) (by omega)]
    simp
  have hDv : Dv (Hset B) (col B.s) (cfG s t α) x i = ∑ h ∈ Hset B i, f h := by
    unfold Dv cfG col
    rw [hBs]
  have hNx : NxR s t α x i = x i + ∑' h, f h := rfl
  have htsum : ∑' h, f h = ∑ h ∈ F, f h + ∑' h, f2 h := by
    rw [← htf1, ← Summable.tsum_add hf1s hf2s]
    exact tsum_congr fun h => congrFun hf12 h
  rw [hNx, hMv, hDv, htsum, hF, Finset.sum_union hdisj]
  have : x i + (∑ h ∈ Fb, f h + ∑ h ∈ Hset B i, f h + ∑' h, f2 h) -
      (x i + ∑ h ∈ Fb, f h + ∑ h ∈ Hset B i, f h) = ∑' h, f2 h := by ring
  rw [this]
  calc |∑' h, f2 h| ≤ (∑' h, g h) * X := hf2abs
    _ ≤ 4 * exp (-(π * (α : ℝ) ^ 2 * (B.w * (B.w + 1)))) * X := mul_le_mul_of_nonneg_right hgle hX0

