import Definitions.Def_FourColor_Hypermap
import Mathlib.GroupTheory.Perm.Cycle.Factors
import Mathlib.Data.Fintype.Perm
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.List.Chain
import Mathlib.Data.List.OfFn
import Mathlib.Data.Finset.Max
import Mathlib.Data.Finset.Powerset

/-!
Concrete configurations, boundary-color semantics, and a reference certificate checker.
Source: Gonthier (2005), Sections 5.2 and 5.4, PDF pp. 26–32 and 38–44; pinned
rocq-community/fourcolor `c1d6b1cd5288bea4b067aac13cdde3c18dffe018`, `coloring.v`
(embeddable, valid_contract, C_reducible, preembedding), `chromogram.v` (matchg,
Kempe_closed), and `cfreducible.v` (check_reducible_valid).

The concrete finite data contain no proof of reducibility or nonoccurrence. The checker
uses explicit finite enumeration and a list of traces to add to the Kempe coclosure.
It is a deliberately simple reference algorithm, not a claim of efficient computation on
all 633 configurations. Efficient implementations may refine it with proved correctness.
-/

namespace FourColor

instance {n : ℕ} (H : Hypermap n) (x y : Fin n) : Decidable (H.SameFace x y) :=
  inferInstanceAs (Decidable (H.face.SameCycle x y))

/-- A finite configuration remainder map, its ordered outer node ring, and contract edges. -/
structure Configuration where
  dartCount : ℕ
  map : Hypermap dartCount
  ring : List (Fin dartCount)
  contract : List (Fin dartCount)

/-- Four colors, with the Klein-four operation used to form edge-color traces. -/
abbrev ConfigurationColor := Fin 4

def configurationColorAdd (a b : ConfigurationColor) : ConfigurationColor :=
  ⟨(Nat.xor a.val b.val) % 4, Nat.mod_lt _ (by decide)⟩

/-- A noncrossing chord word: a skipped edge, opening chord, or one of two closing parities. -/
inductive ChromogramSymbol
  | skip | push | popSame | popOther
  deriving DecidableEq, Repr

instance : Fintype ChromogramSymbol where
  elems := {.skip, .push, .popSame, .popOther}
  complete := by intro x; cases x <;> simp

/-- Gonthier's stack matcher. Color 0 never matches; color 1 skips a chord endpoint. -/
def matchChromogram : List Bool → List ConfigurationColor → List ChromogramSymbol → Bool
  | [], [], [] => true
  | stack, e :: es, symbol :: symbols =>
    match e.val, symbol, stack with
    | 1, .skip, _ => matchChromogram stack es symbols
    | 2, .push, _ => matchChromogram (false :: stack) es symbols
    | 3, .push, _ => matchChromogram (true :: stack) es symbols
    | 2, .popSame, false :: rest => matchChromogram rest es symbols
    | 3, .popSame, true :: rest => matchChromogram rest es symbols
    | 2, .popOther, true :: rest => matchChromogram rest es symbols
    | 3, .popOther, false :: rest => matchChromogram rest es symbols
    | _, _, _ => false
  | _, _, _ => false

namespace Configuration

variable (C : Configuration)

/-- Both darts of every selected contract edge, retaining multiplicities for sparsity checks. -/
def edgeCompletion : List (Fin C.dartCount) :=
  C.contract.flatMap fun x ↦ [x, C.map.edge x]

/-- The kernel consists of faces disjoint from the outer ring. -/
def InKernel (x : Fin C.dartCount) : Prop :=
  ∀ r ∈ C.ring, ¬ C.map.SameFace x r

/-- Face adjacency, rather than dart equality. -/
def Adjacent (x y : Fin C.dartCount) : Prop :=
  ∃ z, C.map.SameFace x z ∧ C.map.SameFace (C.map.edge z) y

/-- A directed ring step crosses one edge and then stays within the new face. -/
def RLink (x y : Fin C.dartCount) : Prop := C.map.SameFace (C.map.edge x) y

/-- A nonempty ordered node cycle meeting each face at most once.
The catalogue always has a nonempty perimeter; this explicitly excludes the empty cycle. -/
def NodeRing : Prop :=
  C.ring ≠ [] ∧ C.ring.Pairwise (fun x y ↦ ¬ C.map.SameFace x y) ∧
    ∀ p ∈ C.ring.zip (C.ring.rotate 1), C.map.node p.1 = p.2

/-- The source's exact-two-hop condition on the face kernel. -/
def KernelRadiusTwo : Prop :=
  ∃ x, C.InKernel x ∧ ∀ y, C.InKernel y →
    ∃ z, C.InKernel z ∧ C.Adjacent x z ∧ C.Adjacent y z

/-- Geometric configuration hypotheses, separate from reducibility and from occurrence. -/
def Embeddable : Prop :=
  C.map.Planar ∧ C.map.Bridgeless ∧ C.map.Plain ∧ C.map.Connected ∧ C.NodeRing ∧
    (∀ x, x ∉ C.ring → C.map.nodeArity x = 3) ∧
    (∀ x ∈ C.ring, 3 ≤ C.map.faceArity x ∧ C.map.faceArity x ≤ 6) ∧ C.KernelRadiusTwo

/-- A triad has at least three incident selected faces and misses some selected face. -/
def Triad (x : Fin C.dartCount) : Prop :=
  2 < (Finset.univ.filter fun y : Fin C.dartCount ↦
    C.map.SameFace x y ∧ ∃ p ∈ C.edgeCompletion, C.map.SameFace (C.map.edge y) p).card ∧
    ¬ ∀ p ∈ C.edgeCompletion, C.Adjacent x p

/-- The nonempty contract has at most four edges; four require the source's triad condition. -/
def ValidContract : Prop :=
  (∀ x ∈ C.ring, x ∉ C.edgeCompletion) ∧
    C.edgeCompletion.Pairwise (fun x y ↦ ¬ C.map.node.SameCycle x y) ∧
    1 ≤ C.contract.length ∧ C.contract.length ≤ 4 ∧
    (C.contract.length = 4 → ∃ x, C.InKernel x ∧ C.Triad x)

/-- Contract coloring identifies exactly the selected edges and colors all others properly. -/
def ContractColoring (k : Fin C.dartCount → ConfigurationColor) : Prop :=
  (∀ x y, C.map.SameFace x y → k x = k y) ∧
    ∀ x, (k (C.map.edge x) = k x ↔ x ∈ C.edgeCompletion)

/-- The finite type of edge traces on the perimeter. -/
abbrev BoundaryTrace := Fin C.ring.length → ConfigurationColor

/-- The finite type of chord words of the perimeter length. -/
abbrev Chromogram := Fin C.ring.length → ChromogramSymbol

/-- Colors of consecutive faces on the reversed ring differ by the Klein-four operation.
The reverse matches `C_reducible` in the source; the last coordinate closes the cycle. -/
def boundaryTrace (k : Fin C.dartCount → ConfigurationColor) : C.BoundaryTrace :=
  fun i ↦
    let j : Fin C.ring.length := ⟨(i.val + 1) % C.ring.length,
      Nat.mod_lt _ (Nat.zero_lt_of_lt i.isLt)⟩
    configurationColorAdd
      (k (C.ring.reverse.get ⟨i.val, by simpa only [List.length_reverse] using i.isLt⟩))
      (k (C.ring.reverse.get ⟨j.val, by simpa only [List.length_reverse] using j.isLt⟩))

/-- Realizable ordinary coloring traces. -/
def RingTrace (t : C.BoundaryTrace) : Prop :=
  ∃ k : Fin C.dartCount → ConfigurationColor, C.map.Coloring k ∧ C.boundaryTrace k = t

/-- Realizable contract-coloring traces. -/
def ContractRingTrace (t : C.BoundaryTrace) : Prop :=
  ∃ k : Fin C.dartCount → ConfigurationColor, C.ContractColoring k ∧ C.boundaryTrace k = t

/-- Every permutation of the three nonzero edge colors, fixing zero. -/
abbrev ColorSymmetry := {p : Equiv.Perm ConfigurationColor // p 0 = 0}

def permuteTrace (p : ColorSymmetry) (t : C.BoundaryTrace) : C.BoundaryTrace :=
  fun i ↦ p.val (t i)

def Matches (t : C.BoundaryTrace) (w : C.Chromogram) : Prop :=
  matchChromogram [] (List.ofFn t) (List.ofFn w) = true

/-- Kempe closure uses all color permutations and one matching chord word per trace. -/
def KempeClosed (P : C.BoundaryTrace → Prop) : Prop :=
  ∀ t, P t →
    (∀ p : ColorSymmetry, P (C.permuteTrace p t)) ∧
      ∃ w : C.Chromogram, C.Matches t w ∧ ∀ u, C.Matches u w → P u

/-- A trace lies in the coclosure when every Kempe-closed set containing it meets `P`. -/
def KempeCoclosure (P : C.BoundaryTrace → Prop) (t : C.BoundaryTrace) : Prop :=
  ∀ Q, C.KempeClosed Q → Q t → ∃ u, P u ∧ Q u

/-- Semantic C-reducibility, without quantification over minimal counterexamples. -/
def CReducible : Prop :=
  C.ValidContract ∧ ∀ t, C.ContractRingTrace t → C.KempeCoclosure C.RingTrace t

/-- Source preembedding on the kernel. Injectivity is a conclusion of later geometry. -/
def Preembedding {n : ℕ} (H : Hypermap n) (h : Fin C.dartCount → Fin n) : Prop :=
  (∀ x, C.InKernel x → h (C.map.face x) = H.face (h x)) ∧
  (∀ x, C.InKernel x → C.map.faceArity x = H.faceArity (h x)) ∧
  (∀ x, C.InKernel x → ∃ y, C.map.SameFace x y ∧ h (C.map.edge y) = H.edge (h y)) ∧
  ∀ x y, C.InKernel x → h (C.map.edge x) = H.edge (h x) →
    C.InKernel y → h (C.map.edge y) = H.edge (h y) →
    ∃ p : List (Fin C.dartCount),
      List.IsChain C.RLink (C.map.node (C.map.face x) :: (p ++ [y])) ∧
      ∀ z ∈ p, C.InKernel z ∧ h (C.map.edge z) = H.edge (h z)

/-- Concrete occurrence: geometric admissibility and a partial combinatorial embedding. -/
def Occurs {n : ℕ} (H : Hypermap n) : Prop :=
  C.Embeddable ∧ ∃ h : Fin C.dartCount → Fin n, C.Preembedding H h

instance (x : Fin C.dartCount) : Decidable (C.InKernel x) := by
  unfold InKernel Hypermap.SameFace
  infer_instance

instance (x y : Fin C.dartCount) : Decidable (C.Adjacent x y) := by
  unfold Adjacent Hypermap.SameFace
  infer_instance

instance (x : Fin C.dartCount) : Decidable (C.Triad x) := by
  unfold Triad
  infer_instance

instance : Decidable C.ValidContract := by
  unfold ValidContract
  infer_instance

instance (k : Fin C.dartCount → ConfigurationColor) : Decidable (C.ContractColoring k) := by
  unfold ContractColoring Hypermap.SameFace
  infer_instance

instance (k : Fin C.dartCount → ConfigurationColor) : Decidable (C.map.Coloring k) := by
  unfold Hypermap.Coloring Hypermap.SameFace
  infer_instance

instance (t : C.BoundaryTrace) : Decidable (C.RingTrace t) := by
  unfold RingTrace
  infer_instance

instance (t : C.BoundaryTrace) : Decidable (C.ContractRingTrace t) := by
  unfold ContractRingTrace
  infer_instance

instance (t : C.BoundaryTrace) (w : C.Chromogram) : Decidable (C.Matches t w) := by
  unfold Matches
  infer_instance

/-- One justified coclosure addition: a known color permutation or every matching chord word
has a known trace. This is an actual finite proposition and contains no proof oracle. -/
def CanAdd (known : Finset C.BoundaryTrace) (t : C.BoundaryTrace) : Prop :=
  (∃ p : ColorSymmetry, C.permuteTrace p t ∈ known) ∨
    ∀ w : C.Chromogram, C.Matches t w → ∃ u ∈ known, C.Matches u w

instance (known : Finset C.BoundaryTrace) (t : C.BoundaryTrace) :
    Decidable (C.CanAdd known t) := by
  unfold CanAdd
  infer_instance

/-- An untrusted finite trace list; each addition is independently checked. -/
structure ReducibilityCertificate where
  additions : List C.BoundaryTrace

/-- Reference extension enumerator; more efficient color-tree implementations need a theorem. -/
def ordinaryTraces : Finset C.BoundaryTrace := Finset.univ.filter C.RingTrace

/-- Check the trace list in order, stopping on an unjustified addition. -/
def checkAdditions : Finset C.BoundaryTrace → List C.BoundaryTrace → Option (Finset C.BoundaryTrace)
  | known, [] => some known
  | known, t :: ts =>
    if C.CanAdd known t then checkAdditions (insert t known) ts else none

/-- Check geometry-independent C-reducibility data by finite computation. -/
def checkReducibility (certificate : C.ReducibilityCertificate) : Bool :=
  decide C.ValidContract &&
    match C.checkAdditions C.ordinaryTraces certificate.additions with
    | none => false
    | some known => decide (∀ t, C.ContractRingTrace t → t ∈ known)

/-- Ordinary extendibility is included in its Kempe coclosure. -/
theorem ringTrace_coclosure {t : C.BoundaryTrace} (h : C.RingTrace t) :
    C.KempeCoclosure C.RingTrace t := by
  intro Q _ ht
  exact ⟨t, h, ht⟩

/-- Every accepted elementary addition preserves semantic coclosure membership. -/
theorem canAdd_sound {known : Finset C.BoundaryTrace} {t : C.BoundaryTrace}
    (hknown : ∀ u ∈ known, C.KempeCoclosure C.RingTrace u) (h : C.CanAdd known t) :
    C.KempeCoclosure C.RingTrace t := by
  intro Q hQ ht
  rcases h with ⟨p, hp⟩ | hgrams
  · exact hknown _ hp Q hQ ((hQ t ht).1 p)
  · obtain ⟨w, htw, hclosed⟩ := (hQ t ht).2
    obtain ⟨u, hu, huw⟩ := hgrams w htw
    exact hknown u hu Q hQ (hclosed u huw)

/-- The invariant for a checked list of coclosure additions. -/
theorem checkAdditions_sound {known result : Finset C.BoundaryTrace}
    {steps : List C.BoundaryTrace}
    (hknown : ∀ u ∈ known, C.KempeCoclosure C.RingTrace u)
    (h : C.checkAdditions known steps = some result) :
    ∀ u ∈ result, C.KempeCoclosure C.RingTrace u := by
  induction steps generalizing known with
  | nil =>
    simp only [checkAdditions, Option.some.injEq] at h
    exact h ▸ hknown
  | cons t ts ih =>
    simp only [checkAdditions] at h
    split at h
    next hadd =>
      apply ih ?_ h
      intro u hu
      rcases Finset.mem_insert.mp hu with rfl | hu
      · exact C.canAdd_sound hknown hadd
      · exact hknown u hu
    next => simp at h

/-- Kernel-checked soundness of the reference certificate checker.
This proves the checker implication for every input; it does not assert that any of the
633 catalogue certificates pass. -/
theorem checkReducibility_sound (certificate : C.ReducibilityCertificate)
    (h : C.checkReducibility certificate = true) : C.CReducible := by
  unfold checkReducibility at h
  have hv : C.ValidContract := of_decide_eq_true (Bool.and_eq_true_iff.mp h).1
  have hh := (Bool.and_eq_true_iff.mp h).2
  split at hh
  next => cases hh
  next known hk =>
    refine ⟨hv, ?_⟩
    intro t ht
    have hmem : t ∈ known := of_decide_eq_true hh t ht
    apply C.checkAdditions_sound (result := known) ?_ hk t hmem
    intro u hu
    exact C.ringTrace_coclosure (Finset.mem_filter.mp hu).2

/-- Concatenating checked addition lists composes their finite executions. -/
theorem checkAdditions_append {known middle : Finset C.BoundaryTrace}
    {steps rest : List C.BoundaryTrace}
    (h : C.checkAdditions known steps = some middle) :
    C.checkAdditions known (steps ++ rest) = C.checkAdditions middle rest := by
  induction steps generalizing known with
  | nil =>
    simp only [checkAdditions, Option.some.injEq] at h
    exact h ▸ rfl
  | cons t ts ih =>
    simp only [checkAdditions] at h
    simp only [List.cons_append, checkAdditions]
    split at h
    next hadd => rw [if_pos hadd]; exact ih h
    next => simp at h

/-- Checked additions retain all previously known traces. -/
theorem checkAdditions_subset {known result : Finset C.BoundaryTrace}
    {steps : List C.BoundaryTrace}
    (h : C.checkAdditions known steps = some result) : known ⊆ result := by
  induction steps generalizing known with
  | nil =>
    simp only [checkAdditions, Option.some.injEq] at h
    exact h ▸ Finset.Subset.refl _
  | cons t ts ih =>
    simp only [checkAdditions] at h
    split at h
    next => exact (Finset.subset_insert t known).trans (ih h)
    next => simp at h

/-- Completeness of the finite certificate language for semantic C-reducibility.
A maximal reachable trace set has a Kempe-closed complement. Such a complement cannot
contain a contract trace by semantic reducibility. This is an existence proof, not a
claim that the reference enumerator is efficient. -/
theorem checkReducibility_complete (hC : C.CReducible) :
    ∃ certificate : C.ReducibilityCertificate, C.checkReducibility certificate = true := by
  classical
  let reachable : Finset (Finset C.BoundaryTrace) :=
    Finset.univ.filter fun known ↦ ∃ steps, C.checkAdditions C.ordinaryTraces steps = some known
  have hr : C.ordinaryTraces ∈ reachable := by
    apply Finset.mem_filter.mpr
    exact ⟨Finset.mem_univ _, [], rfl⟩
  obtain ⟨known, hknown, hmax⟩ := Finset.exists_max_image reachable Finset.card ⟨_, hr⟩
  obtain ⟨steps, hs⟩ := (Finset.mem_filter.mp hknown).2
  have hstop : ∀ t, t ∉ known → ¬ C.CanAdd known t := by
    intro t ht hadd
    have hreach : insert t known ∈ reachable := by
      apply Finset.mem_filter.mpr
      refine ⟨Finset.mem_univ _, steps ++ [t], ?_⟩
      rw [C.checkAdditions_append hs]
      simp only [checkAdditions, if_pos hadd]
    have hle := hmax (insert t known) hreach
    rw [Finset.card_insert_of_notMem ht] at hle
    exact Nat.not_succ_le_self known.card hle
  have hclosed : C.KempeClosed (fun t ↦ t ∉ known) := by
    intro t ht
    constructor
    · intro p hp
      exact hstop t ht (Or.inl ⟨p, hp⟩)
    · have hnot : ¬ ∀ w : C.Chromogram, C.Matches t w → ∃ u ∈ known, C.Matches u w :=
        fun h ↦ hstop t ht (Or.inr h)
      obtain ⟨w, hw⟩ := not_forall.mp hnot
      have hparts := Classical.not_imp.mp hw
      refine ⟨w, hparts.1, ?_⟩
      intro u huw humem
      exact hparts.2 ⟨u, humem, huw⟩
  have hcoverage : ∀ t, C.ContractRingTrace t → t ∈ known := by
    intro t ht
    by_contra hnot
    obtain ⟨u, hu, hunot⟩ := hC.2 t ht _ hclosed hnot
    apply hunot
    exact C.checkAdditions_subset hs (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hu⟩)
  refine ⟨⟨steps⟩, ?_⟩
  unfold checkReducibility
  apply Bool.and_eq_true_iff.mpr
  refine ⟨decide_eq_true hC.1, ?_⟩
  simp only [hs]
  exact decide_eq_true hcoverage

/-- Accepted finite certificates characterize exactly semantic C-reducibility. -/
theorem checkReducibility_iff :
    (∃ certificate : C.ReducibilityCertificate, C.checkReducibility certificate = true) ↔
      C.CReducible :=
  ⟨fun ⟨certificate, h⟩ ↦ C.checkReducibility_sound certificate h, C.checkReducibility_complete⟩
end Configuration
end FourColor


