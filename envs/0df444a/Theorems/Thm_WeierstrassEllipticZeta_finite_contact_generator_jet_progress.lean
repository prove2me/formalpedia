-- title:
--   Strict progress, stabilization and dimension drops for finite-generator jet ideals
-- statement:
--   Fix an elliptic-extension chart with derivation $D$, a finite set
--   $V\subset\mathbb C^4$ and contact orders $n_v\in\mathbb N$. Suppose
--   $f_1,\ldots,f_r$ generate the contact ideal
--
--   $$I=\bigcap_{v\in V}C_v(n_v),\qquad
--   C_v(a)=\{p:D^jp(v)=0\text{ for }0\leq j<a\}.$$
--
--   For $k\in\mathbb N$, let
--
--   $$F_k=(D^j f_i:1\leq i\leq r,\ 0\leq j\leq k).$$
--
--   Then $F_k\subseteq F_{k+1}$, and
--
--   $$F_k=F_{k+1}\quad\Longleftrightarrow\quad F_k=\mathbb C[t,x,y,z],$$
--
--   $$F_k\subsetneq F_{k+1}\quad\Longleftrightarrow\quad
--   \text{there is }v\in V\text{ with }k<n_v.$$
--
--   The exact drop in quotient dimension is
--
--   $$\dim_{\mathbb C}(\mathbb C[t,x,y,z]/F_k)
--   =\dim_{\mathbb C}(\mathbb C[t,x,y,z]/F_{k+1})
--   +|\{v\in V:k<n_v\}|.$$
--
--   Thus a pair of equal consecutive ideals certifies that the sequence has
--   reached the whole ring. The theorem permits empty support and zero orders
--   and applies to every family satisfying the stated generating equality.
-- source:
--   Derived progress calculation for the differential polynomial-ring method associated with Senthil Kumar K (2026), Appendix A introductory paragraphs and Theorem A.2, https://doi.org/10.1017/S001309152610145X. This exact progress statement is derived here, not quoted from the article. Reuses the Proved finite_contact_generator_jets. The ideals generated by successive derivative lists are increasing; consecutive terms are equal precisely at the whole ring, and otherwise the inclusion is strict. Their quotient-dimension drop is the number of points whose contact order is still positive. Requires the actual generating equality and permits empty support and zero orders.

import Definitions.Def_WeierstrassEllipticZeta_ProjectiveContactIdeal
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.RingTheory.Ideal.Quotient.Basic

open WeierstrassEllipticZeta
open scoped Classical

theorem WeierstrassEllipticZeta.finite_contact_generator_jet_progress (g₂ g₃ : ℂ) (c : Fin 2)
    (V : Finset (Fin 4 → ℂ)) (n : V → ℕ) (r : ℕ)
    (f : Fin r → MvPolynomial (Fin 4) ℂ)
    (hgen : Ideal.span (Set.range f) =
      ⨅ v : V, extensionChartContactIdeal g₂ g₃ c v.val (n v)) (k : ℕ) :
    let F : ℕ → Ideal (MvPolynomial (Fin 4) ℂ) := fun a =>
      Ideal.span (Set.range (fun i : Fin (a + 1) × Fin r =>
        (extensionChartDerivation g₂ g₃ c)^[i.1.val] (f i.2)))
    F k ≤ F (k + 1) ∧
      (F k = F (k + 1) ↔ F k = ⊤) ∧
      (F k < F (k + 1) ↔ ∃ v : V, k < n v) ∧
      Module.finrank ℂ (MvPolynomial (Fin 4) ℂ ⧸ F k) =
        Module.finrank ℂ (MvPolynomial (Fin 4) ℂ ⧸ F (k + 1)) +
          (Finset.univ.filter (fun v : V => k < n v)).card := by sorry
