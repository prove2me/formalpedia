lemma field_encoded (b : Core) (B : ℕ) (e : Edge b) (offset : ℕ) :
    field b B e offset = B+5*encodedEdge b e+2*offset+1 := by unfold field encodedEdge;omega
lemma field_injective (b : Core) (B : ℕ) (e f : Edge b) (a c : ℕ) (ha : a < 5) (hc : c < 5)
    (heq : field b B e a = field b B f c) : e = f ∧ a = c := by
  have hval : (logicalIndexEquiv b e).val = (logicalIndexEquiv b f).val := by dsimp [field] at heq;omega
  have hef : e = f := (logicalIndexEquiv b).injective (Fin.ext hval)
  exact ⟨hef,by dsimp [field] at heq;omega⟩
lemma gradientCell_injective (b : Core) (B : ℕ) (v w : Fin b.input.n)
    (heq : gradientCell b B v = gradientCell b B w) : v = w := by
  apply Fin.ext
  dsimp [gradientCell] at heq
  omega
lemma field_guest_disjoint (b : Core) (B : ℕ) (e : Edge b) (offset a : ℕ) :
    field b B e offset ≠ B+4*a+2 := by dsimp [field];omega
lemma gradient_guest_disjoint (b : Core) (B : ℕ) (v : Fin b.input.n) (a : ℕ) :
    gradientCell b B v ≠ B+4*a+2 := by dsimp [gradientCell,gradientBase];omega
lemma source_guest_disjoint (b : Core) (B offset a : ℕ) :
    sourceRecord b B+2*offset ≠ B+4*a+2 := by dsimp [sourceRecord,gradientBase];omega
lemma field_above_base (b : Core) (B : ℕ) (e : Edge b) (a : ℕ) : B < field b B e a := by dsimp [field];omega
lemma gradient_above_base (b : Core) (B : ℕ) (v : Fin b.input.n) : B < gradientCell b B v := by
  dsimp [gradientCell,gradientBase];omega
lemma encodedEdge_injective (b : Core) {e f : Edge b} (h : encodedEdge b e = encodedEdge b f) : e = f := by
  apply (logicalIndexEquiv b).injective
  apply Fin.ext
  dsimp [encodedEdge] at h
  omega
