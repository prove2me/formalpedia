-- Variant R word: corrected densified GREC + copyo cND(t) + argument/geometry preload.
-- Not a reuse of IntMul_Kappa_R8_Data_BitOppbankQHNetRec. No C_LOW=0 wipe.
import Definitions.Def_IntMul_Kappa_R8_Data_BitOppbankWireLayout
import Definitions.Def_IntMul_Kappa_R8_Data_BitOppbankLocSlots
import Definitions.Def_IntMul_Kappa_R8_Data_BitOppbankLocGrecR
