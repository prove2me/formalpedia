private theorem _root_.AlgebraicCurve.Annulus.IsAttached.of_integers_eq
    {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
    {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    {An : Annulus A F} {R : RegularProlongation A F Fbar} {C : ComponentChart A F Fbar}
    {x : Place (ResidueField A) Fbar}
    (hint : C.integers = R.integers)
    (hres : ∀ (f : F) (hC : f ∈ C.integers) (hR : f ∈ R.integers), C.residue ⟨f, hC⟩ = R.residue ⟨f, hR⟩)
    (hx : x ∈ C.nodes)
    (h : ∃ hz : An.param ∈ R.integers, x.ord (R.residue ⟨An.param, hz⟩) = 1 ∧
      ∀ (f : F) (hf : f ∈ R.integers), R.residue ⟨f, hf⟩ ≠ 0 → (∀ P ∈ An.dom, P.ord f = 0) →
        ∀ P ∈ An.dom, ∃ h : P.evalAt f * (P.evalAt An.param) ^ (-(x.ord (R.residue ⟨f, hf⟩))) ∈ A,
          IsUnit (⟨_, h⟩ : A)) :
    An.IsAttached C x := by
  obtain ⟨hz, hord, hslope⟩ := h
  have hzC : An.param ∈ C.integers := hint ▸ hz
  refine ⟨hx, hzC, by rw [hres _ hzC hz, hord], fun f hf hf0 hdiv P hP => ?_⟩
  have hfR : f ∈ R.integers := hint ▸ hf
  rw [hres _ hf hfR] at hf0 ⊢
  exact hslope f hfR hf0 hdiv P hP

