open NLogN
open NLogN.KFM
open Complex
variable {ι : Type*} [Fintype ι]
theorem solution (p : ℕ) (e et x : ι → ℂ) (he : ∀ i, ‖e i‖ ≤ 1)
    (het : ∀ i, ‖et i - e i‖ ≤ 2 * NLogN.KFM.hp p) (het1 : ∀ i, ‖et i‖ ≤ 1) (hx : ‖x‖ ≤ 1) :
    ‖NLogN.KFM.QA p (et * x) - e * x‖ ≤ 4 * NLogN.KFM.hp p ∧ ‖NLogN.KFM.QA p (et * x)‖ ≤ ‖x‖ := by
  have h0 := NLogN.KFM.hp_pos p
  constructor
  · refine NLogN.KFM.pi_le (by positivity) fun i => ?_
    have hxi : ‖x i‖ ≤ 1 := (norm_le_pi_norm x i).trans hx
    have h1 := (Butterfly.norm_Qp_sub_lt p (et i * x i)).le
    have e1 : NLogN.KFM.QA p (et * x) i - (e * x) i =
        (Butterfly.Qp p (et i * x i) - et i * x i) + (et i - e i) * x i := by
      simp only [NLogN.KFM.QA, Pi.mul_apply]; ring
    rw [Pi.sub_apply, e1]
    calc _ ≤ ‖Butterfly.Qp p (et i * x i) - et i * x i‖ + ‖(et i - e i) * x i‖ := norm_add_le _ _
      _ ≤ Real.sqrt 2 * NLogN.KFM.hp p + 2 * NLogN.KFM.hp p * 1 := by
          rw [norm_mul]
          exact add_le_add h1 (mul_le_mul (het i) hxi (norm_nonneg _) (by positivity))
      _ ≤ 4 * NLogN.KFM.hp p := by nlinarith [NLogN.KFM.sqrt2_le_two]
  · refine NLogN.KFM.pi_le (norm_nonneg _) fun i => ?_
    calc ‖NLogN.KFM.QA p (et * x) i‖ ≤ ‖et i * x i‖ := Butterfly.norm_Qp_le p _
      _ = ‖et i‖ * ‖x i‖ := norm_mul _ _
      _ ≤ 1 * ‖x‖ := mul_le_mul (het1 i) (norm_le_pi_norm x i) (norm_nonneg _) zero_le_one
      _ = ‖x‖ := one_mul _
end
