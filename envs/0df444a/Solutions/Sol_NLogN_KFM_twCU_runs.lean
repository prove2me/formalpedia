      (a := n.eval s - N) (L := s.G i) (hG N)
    refine ((h1.seq h2).seq (hloop.seq hdrop)).mono' ?_ ?_
    · have hGN := hG N
      simp only [NLogN.RS.repSt] at hGN
      simp only [NLogN.RS.run, NLogN.RS.repSt, ← hN]
      rw [hGN]; rfl
