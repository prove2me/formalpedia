    2 * (2 ^ pos i * S0) ∣ B * 2 ^ t * S0 := by
  have : 2 ^ t = 2 * 2 ^ pos i * 2 ^ (t - pos i - 1) := by
    rw [mul_comm 2, ← pow_succ, ← pow_add]; congr 1; have := hpos i; omega
  rw [this]
  exact ⟨B * 2 ^ (t - pos i - 1), by ring⟩

