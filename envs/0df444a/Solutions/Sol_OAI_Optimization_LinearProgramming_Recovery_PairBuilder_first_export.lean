theorem needed_usable (p : Phase) : needed (plan p) ⊆ usable := by
  cases p with | place r | finish r => cases r <;> decide | _ => decide

theorem meta_static (p : Phase) : ((plan p).code 220).indexWritesBelow 512=true := by
