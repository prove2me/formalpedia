  have hfc := canonicalMulWithWork_cost (nat 8) (nat F) B height hFn
  have huw := canonicalMulWithWork_width (canonicalMulWithWork (nat 8) (nat F)).1 (nat b)
    (4 * B + 2) hfw (by omega)
