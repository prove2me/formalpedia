    (hn : false = true ∨ ∀ tag, op ≠ .halt tag) :
    logProxyProgram[56+i]? = some (rebaseInstr 56 op) :=
  proxyCall_lookup (pre := throughSetup) (post := proxyFinish) (ret := 116) rfl hi hn

