    (B : Type) [CommRing B] [Algebra 𝒪 B] (hB : IsNilpotent (algebraMap 𝒪 B π))
    (ψ ψ' : Onr →ₐ[𝒪] B) (hψ : ∀ y : Onr, Fr (Fr y) = y → ψ y = ψ' y) (P : (Omega K₀ π).obj B) :
