theorem isHomPt_act {T : Type} [CommRing T] (E' : FakeEllipticCurve Λ N₀ T) (x : ↥Λ) :
    KerOps.IsHomPt E'.L (E'.act x) (E'.act_over x) :=
  fun t P Q => E'.act_hom x t P Q

def admOf {R : Type} [CommRing R] (E' : FakeEllipticCurve Λ N₀ R) [IsFinite (E'.L.schemeKerStr N)]
    [Etale (E'.L.schemeKerStr N)] (s : Finset ↥Λ) (U V : (E'.L.schemeKer N).Opens) : Set ↥(Spec (CommRingCat.of R)) :=
  Loci.locOne E'.L N (U : Set _) ∩
  Loci.locInv E'.L E'.comm N (U : Set _) ∩
  Loci.locMul E'.L E'.comm N (U : Set _) ∩
  (⋂ x ∈ s, Loci.locEnd E'.L N (E'.act x) (E'.act_over x) (isHomPt_act _ x) (U : Set _)) ∩
  rankLoc (E'.L.schemeKerStr N) U (N ^ 2) ∩
  (⋂ d ∈ N.divisors, rankLoc (E'.L.schemeKerStr N) (U ⊓ Td E'.L E'.comm N d) (d ^ 2)) ∩
  locDisj E'.L N (U : Set _) (V : Set _)

theorem mem_admOf {R : Type} [CommRing R] (E' : FakeEllipticCurve Λ N₀ R) [IsFinite (E'.L.schemeKerStr N)]
    [Etale (E'.L.schemeKerStr N)] (s : Finset ↥Λ) (U V : (E'.L.schemeKer N).Opens) (t : ↥(Spec (CommRingCat.of R))) :
    t ∈ admOf (N := N) E' s U V ↔
      t ∈ Loci.locOne E'.L N (U : Set _) ∧ t ∈ Loci.locInv E'.L E'.comm N (U : Set _) ∧
      t ∈ Loci.locMul E'.L E'.comm N (U : Set _) ∧
      (∀ x ∈ s, t ∈ Loci.locEnd E'.L N (E'.act x) (E'.act_over x) (isHomPt_act _ x) (U : Set _)) ∧
      t ∈ rankLoc (E'.L.schemeKerStr N) U (N ^ 2) ∧
      (∀ d ∈ N.divisors, t ∈ rankLoc (E'.L.schemeKerStr N) (U ⊓ Td E'.L E'.comm N d) (d ^ 2)) ∧
      t ∈ locDisj E'.L N (U : Set _) (V : Set _) := by
  simp only [admOf, Set.mem_inter_iff, Set.mem_iInter, and_assoc]

theorem isClopen_admOf {R : Type} [CommRing R] (E' : FakeEllipticCurve Λ N₀ R) [IsFinite (E'.L.schemeKerStr N)]
    [Etale (E'.L.schemeKerStr N)] (s : Finset ↥Λ) (U V : (E'.L.schemeKer N).Opens)
    (hUc : IsClosed (U : Set ↥(E'.L.schemeKer N))) (hVc : IsClosed (V : Set ↥(E'.L.schemeKer N))) :
