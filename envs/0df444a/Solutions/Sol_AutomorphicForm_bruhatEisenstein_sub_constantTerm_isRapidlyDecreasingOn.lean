private theorem normSq_linePhat_add_lineQSq (hg : g.det ≠ 0) (z₀ : ℂ) (θ t : ℝ) :
    normSq (linePhat g z₀ θ t) + lineQSq g z₀ θ t = 1 :=
  normSq_phat_add_normSq_qhat g hg _

private theorem radC_line_pos (hg : g.det ≠ 0) (z₀ : ℂ) (θ t : ℝ) :
    0 < radC g (z₀ + t * Complex.exp (θ * Complex.I)) := radC_pos hg _

private theorem contDiff_radC_line (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) :
