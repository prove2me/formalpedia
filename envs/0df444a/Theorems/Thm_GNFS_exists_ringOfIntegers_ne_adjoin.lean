-- title:
--   $\mathbb{Z}[\theta]$ can differ from the ring of integers
-- statement:
--   There exist a monic polynomial $f \in \mathbb{Z}[x]$, irreducible in $\mathbb{Z}[x]$, and a complex root $\theta$ of $f$, together with an element $x \in \mathbb{Q}(\theta)$ such that
--
--   1. $x$ is an algebraic integer, i.e. a root of a monic polynomial with integer coefficients, and
--   2. $x \notin \mathbb{Z}[\theta]$, the subring of $\mathbb{C}$ generated by $\theta$.
--
--   So the ring of integers $\mathcal{O}_{\mathbb{Q}(\theta)}$ can strictly contain $\mathbb{Z}[\theta]$. (A standard example is $\theta = \sqrt{5}$, $x = (1+\sqrt5)/2$.)
-- source:
--   Wikipedia, "General number field sieve" (revision oldid=1377718368, https://en.wikipedia.org/w/index.php?title=General_number_field_sieve&oldid=1377718368), section 'Number fields'

import Mathlib
import Definitions.Def_GNFS_defs
open Polynomial IntermediateField

namespace GNFS
theorem exists_ringOfIntegers_ne_adjoin :
    ∃ (f : ℤ[X]) (θ : ℂ), f.Monic ∧ Irreducible f ∧ aeval θ f = 0 ∧
      ∃ x : ℂ, x ∈ ℚ⟮θ⟯ ∧ IsIntegral ℤ x ∧ x ∉ Algebra.adjoin ℤ ({θ} : Set ℂ) := by sorry
end GNFS
