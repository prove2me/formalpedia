-- Source module: Solutions.GlueProp14
/-!
# Glue 1: Proposition 14 unconditionally (through `complexIface`)

`ButterflyProp14.prop14_output` takes an implementation `Cimpl` of `C^{⊗D}` on the `D` selected
bits together with a proof `Cimpl = tens Cm`.  Here we *build* that implementation from the
recursive program `recOp` of an arbitrary `Prop8Iface` (the network recursion of §5.1), cutting
the `D` selected bits into consecutive pieces of sizes `u · m^k` given by the base-`m` digits of
`D` (piece `k` = the depth-`k` program with leaf width `u = k`-th digit), embedding each piece on
its block of bits and multiplying (`tens_blocks`, `embed_tens`).

* `cRec I D` : the operator computed by the pieces; `cRec_eq` : `cRec I D = tens Cm` (`2 ≤ m`).
* `cRecC D := cRec complexIface.toIface D` (`W_c` roles, `m = 100³`, `s_c` children).
* **`prop14_unconditional`**: for the concrete layer `[P] × [2^K]^D × [S]` (bit `ρ` of every
  chunk), the procedure `Q_p(b^D S_D · C-layer(cRecC) · S_D z)` equals `Q_p(H0^{⊗D} z)`, every
  output coefficient lies in the unit disk and is within `√2·2^{-p}` of the exact layer.
* **`prop14_unconditional_sel`**: the same for an arbitrary selected-bit structure `Sb` on any
  shape with any finite index type `ι` (the C-layer is `cRecC` transported along `ι ≃ Fin |ι|`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace GlueP14

open Matrix Finset Butterfly AModel

/-! ## 1. Interval blocks -/

/-- The block of selected bits `[off, off + sz)`. -/
def blk (D off sz : ℕ) : Finset (Fin D) := univ.filter fun j => off ≤ (j : ℕ) ∧ (j : ℕ) < off + sz

lemma mem_blk {D off sz : ℕ} {j : Fin D} : j ∈ blk D off sz ↔ off ≤ (j : ℕ) ∧ (j : ℕ) < off + sz := by
  simp [blk]

lemma card_blk {D off sz : ℕ} (h : off + sz ≤ D) : (blk D off sz).card = sz := by
  have hmap : (blk D off sz).map Fin.valEmbedding = Finset.Ico off (off + sz) := by
    ext x
    simp only [Finset.mem_map, mem_blk, Fin.valEmbedding_apply, Finset.mem_Ico]
    constructor
    · rintro ⟨j, hj, rfl⟩; exact hj
    · intro hx; exact ⟨⟨x, by omega⟩, hx, rfl⟩
  rw [← Finset.card_map Fin.valEmbedding, hmap, Nat.card_Ico]; omega

/-! ## 2. Pieces -/

/-- Total number of selected bits of a piece list `(u, k)` (piece size `u · m^k`). -/
def tot (m : ℕ) : List (ℕ × ℕ) → ℕ
  | [] => 0
  | (u, k) :: ps => u * m ^ k + tot m ps

/-- The blocks of a piece list starting at offset `off`. -/
def blocks (D m : ℕ) : ℕ → List (ℕ × ℕ) → List (Finset (Fin D))
  | _, [] => []
  | off, (u, k) :: ps => blk D off (u * m ^ k) :: blocks D m (off + u * m ^ k) ps

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s)

/-- One piece: the depth-`k` recursive program with leaf width `u`, embedded on its block. -/
noncomputable def pieceOp (D off u k : ℕ) : Op (Fin D) :=
  if h : off + u * m ^ k ≤ D then
    Butterfly.embed (blk D off (u * m ^ k))
      (Fintype.equivOfCardEq ((card_Lvl u m k).trans
        ((card_blk h).symm.trans (Fintype.card_coe _).symm))) (recOp I u k)
  else 1

/-- All pieces of a piece list, from offset `off`. -/
noncomputable def pieceList (D : ℕ) : ℕ → List (ℕ × ℕ) → List (Op (Fin D))
  | _, [] => []
  | off, (u, k) :: ps => pieceOp I D off u k :: pieceList D (off + u * m ^ k) ps

/-! ## 3. Base-`m` digit pieces -/

/-- Pieces `(digit_k, k)` for the first `f` base-`m` digits of `D`, starting at level `k`. -/
def digitPieces (m : ℕ) : ℕ → ℕ → ℕ → List (ℕ × ℕ)
  | 0, _, _ => []
  | f + 1, D, k => (D % m, k) :: digitPieces m f (D / m) (k + 1)

/-- **The recursive implementation of the `C`-layer on `D` selected bits**: the pieces given by
the base-`m` digits of `D`, each the recursive network program of its depth. -/
noncomputable def cRec (D : ℕ) : Op (Fin D) := (pieceList I D 0 (digitPieces m D D 0)).prod

/-! ## 4. The complex network instance -/

/-- The C-layer implementation through the complex network (`complexIface`, `m = 100³`). -/
noncomputable def cRecC (D : ℕ) : Op (Fin D) := cRec P8Lift.complexIface.toIface D

/-! ## 5. Arbitrary selected-bit structures -/

section General

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Transport an operator on `Fin |ι|` bits to `ι` bits. -/
def reidx (e : ι ≃ Fin (Fintype.card ι)) (T : Op (Fin (Fintype.card ι))) : Op ι :=
  fun x y => T (x ∘ e.symm) (y ∘ e.symm)

/-- The C-layer implementation on `ι` selected bits. -/
noncomputable def cRecι : Op ι := reidx (Fintype.equivFin ι) (cRecC (Fintype.card ι))

variable {sh : Shape} {r : ℕ}

/-- The layer procedure for an arbitrary selected-bit structure. -/
noncomputable def prop14ProcG (Sb : SelBits sh ι) (p : ℕ) (Cimpl : Op ι) (xs : List (Fin r → ℂ)) :
    List (Fin r → ℂ) :=
  QpArr p ((selOp Sb SD (selOp Sb Cimpl (selOp Sb SD xs))).map ((cb ^ Fintype.card ι) • ·))

end General

end GlueP14

end

