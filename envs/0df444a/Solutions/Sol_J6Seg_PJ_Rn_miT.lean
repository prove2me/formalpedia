    have b2 := rev_mem_bnd bDD; rw [← hDD] at b2
    have b3 := rev_mem_bnd bDI; rw [← hDI] at b3
    have e3' := e3; rw [← hy1] at e3'
    have bY' : |y1| ≤ 2 ^ W := by rw [hy1]; exact bY
    subst hw5 hw4 hw3 hw2 hw1
    simp only [PJ.miT, OkL, Ins.run, Ins.ok, d1, d2, d4, d5, e3', e6, l1, l2, l3, Int.toNat_natCast]
    refine ⟨⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl, ?_, by positivity,
