section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFW
open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
theorem solution (jW jL : Fin Pp) (rowC : NLogN.IStmt NLogN.HS Pp) (hW : tbl jW = NLogN.KFW.lowC jW jL)
    (hL : tbl jL = NLogN.KFW.levC jL rowC) {K S r H P D ρ k q0 Bp Z Zr Mb Bz : ℕ} {Kc : ℝ}
    (LV : ∀ j, NLogN.KFW.LvQ Isym tbl jL rowC K r Z Zr H j (NLogN.KFW.cbW Kc K j))
    (ctx : NLogN.KFW.LowCtx K S r H P D ρ k q0 Bp Z Zr Mb Bz) :
    ∀ j R o (σ : Fin NLogN.HS → Option ℤ), j ≤ k → NLogN.KFW.CoreR σ K S r H P D ρ k q0 Bp → NLogN.KFW.LowR σ j R o →
      o + R ≤ D - q0 → R < NLogN.KFW.mC ^ (j + 1) →
      NLogN.KFW.LowS Isym tbl jW K S r H ρ (D - q0) Bp j R o σ
        (NLogN.KFW.lowF (NLogN.KFW.cLowP Kc K S r H (D - q0) Bp Zr Bz) j R + (j + 1) * NLogN.KFW.cLowS Bz) := by
  intro j
  induction j with
  | zero =>
    intro R
    induction R using Nat.strong_induction_on with
    | _ R IHR =>
      intro o σ hj hC hLo hoR hR
      by_cases h1 : NLogN.KFW.mC ^ 0 ≤ R
      · have T := NLogN.KFW.lowTake jW jL rowC hW hL LV ctx 0 R o σ hj hC hLo hoR h1 _
          (fun σ2 hC2 hLo2 => IHR (R - NLogN.KFW.mC ^ 0) (by simp at h1 ⊢; omega) (o + NLogN.KFW.mC ^ 0) σ2 hj hC2 hLo2
            (by omega) (by omega))
        unfold NLogN.KFW.LowS at T ⊢
        refine T.mono (fun w _ _ => le_of_eq ?_)
        rw [NLogN.KFW.lowF_take _ 0 R h1]; ring
      · have hR0 : R = 0 := by simp at h1; omega
        subst hR0
        have T := NLogN.KFW.lowEnd (Isym := Isym) jW jL hW ctx o σ hC hLo
        unfold NLogN.KFW.LowS at T ⊢
        refine T.mono (fun w _ _ => ?_)
        simp [NLogN.KFW.lowF]
  | succ j IHj =>
    intro R
    induction R using Nat.strong_induction_on with
    | _ R IHR =>
      intro o σ hj hC hLo hoR hR
      by_cases h1 : NLogN.KFW.mC ^ (j + 1) ≤ R
      · have T := NLogN.KFW.lowTake jW jL rowC hW hL LV ctx (j + 1) R o σ hj hC hLo hoR h1 _
          (fun σ2 hC2 hLo2 => IHR (R - NLogN.KFW.mC ^ (j + 1)) (by have := NLogN.KFW.mC_pow_pos (j + 1); omega)
            (o + NLogN.KFW.mC ^ (j + 1)) σ2 hj hC2 hLo2 (by omega) (by omega))
        unfold NLogN.KFW.LowS at T ⊢
        refine T.mono (fun w _ _ => le_of_eq ?_)
        rw [NLogN.KFW.lowF_take _ (j + 1) R h1]; ring
      · have h1' : R < NLogN.KFW.mC ^ (j + 1) := by omega
        have T := NLogN.KFW.lowDown (Isym := Isym) jW jL hW ctx j R o σ hj hC hLo h1' _
          (fun σ2 hC2 hLo2 => IHj R o σ2 (by omega) hC2 hLo2 hoR h1')
        unfold NLogN.KFW.LowS at T ⊢
        refine T.mono (fun w _ _ => ?_)
        rw [NLogN.KFW.lowF_down _ j R h1']
        nlinarith
end
