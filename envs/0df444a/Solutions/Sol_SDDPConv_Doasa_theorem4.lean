/-- Weak duality for the literal list-padded native dual. -/
theorem ap_weak_duality (I : Instance) (t : ℕ) (l : List (Cut I t))
    (h : Fin (I.m t) → ℝ) (y : Fin (I.n t) → ℝ) (z : ℝ) (d : Dual I t)
    (hy : y ∈ Feas I t h) (hz : ∀ a ∈ l, Cut.eval I a y ≤ z)
    (hd : d ∈ H I t l) :
    dualObj I t l h d ≤ I.c t ⬝ᵥ y + z := by
  have hdot := dotProduct_le_dotProduct_of_nonneg_right hd.1 hy.1
  have hmat : ((I.A t)ᵀ *ᵥ d.1) ⬝ᵥ y = d.1 ⬝ᵥ h := by
    rw [dotProduct_comm, dotProduct_transpose_mulVec, hy.2]
  rw [add_dotProduct, sum_dotProduct, hmat] at hdot
  simp only [smul_dotProduct, smul_eq_mul] at hdot
  have hcut (j : Fin l.length) : d.2 j * (l.get j).1 ≤
      d.2 j * ((l.get j).2 ⬝ᵥ y) + d.2 j * z := by
    have hh := hz (l.get j) (List.get_mem l j)
    dsimp [Cut.eval] at hh
    have hm := mul_le_mul_of_nonneg_left hh (hd.2.2.1 j)
    simp only [List.get_eq_getElem] at *
    nlinarith only [hm]
  have hsum := Finset.sum_le_sum (fun j (_ : j ∈ (Finset.univ : Finset (Fin l.length))) => hcut j)
  simp only [Finset.sum_add_distrib, ← Finset.sum_mul, hd.2.1, one_mul] at hsum
  dsimp [dualObj]
  simp only [List.get_eq_getElem] at *
  linarith

private abbrev APVec (I : Instance) (t : ℕ) :=
  EuclideanSpace ℝ (Fin (I.n t) ⊕ Unit)

private def apPack (I : Instance) (t : ℕ) (y : Fin (I.n t) → ℝ) (z : ℝ) : APVec I t :=
  WithLp.toLp 2 (Sum.elim y (fun _ => z))

private lemma apPack_inner (I : Instance) (t : ℕ) (y : Fin (I.n t) → ℝ) (z : ℝ)
    (w : APVec I t) : inner ℝ (apPack I t y z) w =
      y ⬝ᵥ (fun j => w (Sum.inl j)) + z * w (Sum.inr ()) := by
  simp [apPack, PiLp.inner_apply, Fintype.sum_sum_type, dotProduct, mul_comm]

private abbrev APIndex (I : Instance) (t : ℕ) (l : List (Cut I t)) :=
  (Fin (I.n t) ⊕ Fin l.length) ⊕ (Fin (I.m t) ⊕ Fin (I.m t))

private noncomputable def apNormal (I : Instance) (t : ℕ) (l : List (Cut I t)) : APIndex I t l → APVec I t
  | Sum.inl (Sum.inl j) => EuclideanSpace.single (Sum.inl j) (-1)
  | Sum.inl (Sum.inr j) => apPack I t (-(l.get j).2) (-1)
  | Sum.inr (Sum.inl j) => apPack I t (I.A t j) 0
  | Sum.inr (Sum.inr j) => apPack I t (-(I.A t j)) 0

private def apRhs (I : Instance) (t : ℕ) (l : List (Cut I t)) (h : Fin (I.m t) → ℝ) :
    APIndex I t l → ℝ
  | Sum.inl (Sum.inl _) => 0
  | Sum.inl (Sum.inr j) => -(l.get j).1
  | Sum.inr (Sum.inl j) => h j
  | Sum.inr (Sum.inr j) => -h j

private lemma ap_feas_iff (I : Instance) (t : ℕ) (l : List (Cut I t))
    (h : Fin (I.m t) → ℝ) (w : APVec I t) :
    (∀ i, inner ℝ (apNormal I t l i) w ≤ apRhs I t l h i) ↔
      (fun j => w (Sum.inl j)) ∈ Feas I t h ∧
      ∀ a ∈ l, Cut.eval I a (fun j => w (Sum.inl j)) ≤ w (Sum.inr ()) := by
  constructor
  · intro hw
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · intro j
      have hh := hw (Sum.inl (Sum.inl j))
      simpa [apNormal, apRhs, EuclideanSpace.inner_single_left] using hh
    · ext j
      have hp := hw (Sum.inr (Sum.inl j))
      have hn := hw (Sum.inr (Sum.inr j))
      simp only [apNormal, apRhs, apPack_inner, zero_mul, add_zero, neg_dotProduct] at hp hn
      change (I.A t j ⬝ᵥ (fun j => w (Sum.inl j))) = h j
      exact le_antisymm hp (by linarith)
    · intro a ha
      obtain ⟨j, rfl⟩ := List.mem_iff_get.mp ha
      have hh := hw (Sum.inl (Sum.inr j))
      simp only [apNormal, apRhs, apPack_inner, neg_dotProduct, neg_one_mul] at hh
      dsimp [Cut.eval]
      simp only [List.get_eq_getElem] at hh
      linarith
  · rintro ⟨hw, hc⟩ i
    rcases i with (j | j) <;> rcases j with (j | j)
    · simpa [apNormal, apRhs, EuclideanSpace.inner_single_left] using hw.1 j
    · have hh := hc (l.get j) (List.get_mem l j)
      simp only [apNormal, apRhs, apPack_inner, neg_dotProduct, neg_one_mul]
      dsimp [Cut.eval] at hh
      simp only [List.get_eq_getElem]
      linarith
    · simp only [apNormal, apRhs, apPack_inner, zero_mul, add_zero]
      exact (congrFun hw.2 j).le
    · simp only [apNormal, apRhs, apPack_inner, zero_mul, add_zero, neg_dotProduct]
      exact neg_le_neg (congrFun hw.2 j).ge

/-- KKT constructs one genuine feasible dual with the attained AP objective. -/
theorem ap_exists_zero_gap_dual (I : Instance) (t : ℕ) (l : List (Cut I t))
    (h : Fin (I.m t) → ℝ) (y : Fin (I.n t) → ℝ) (z : ℝ)
    (hop : IsAPOpt I t {a | a ∈ l} h y z) :
    ∃ d ∈ H I t l, dualObj I t l h d = I.c t ⬝ᵥ y + z := by
  classical
  let v := apPack I t y z
  let c := apPack I t (I.c t) 1
  have hv : ∀ i, inner ℝ (apNormal I t l i) v ≤ apRhs I t l h i := by
    apply (ap_feas_iff I t l h v).mpr
    exact ⟨hop.1, hop.2.1⟩
  have hmin (w : APVec I t) (hw : ∀ i, inner ℝ (apNormal I t l i) w ≤ apRhs I t l h i) :
      inner ℝ c v ≤ inner ℝ c w := by
    obtain ⟨hwf, hwc⟩ := (ap_feas_iff I t l h w).mp hw
    change inner ℝ (apPack I t (I.c t) 1) (apPack I t y z) ≤
      inner ℝ (apPack I t (I.c t) 1) w
    rw [apPack_inner, apPack_inner]
    simpa [apPack] using hop.2.2 _ hwf _ hwc
  obtain ⟨lam, hlam, hstat, hcomp⟩ := finite_kkt
    (apNormal I t l) (apRhs I t l h) c v hv hmin
  let r : Fin l.length → ℝ := fun j => lam (Sum.inl (Sum.inr j))
  let pi : Fin (I.m t) → ℝ := fun j =>
    lam (Sum.inr (Sum.inr j)) - lam (Sum.inr (Sum.inl j))
  let rho : ℕ → ℝ := fun j => if hj : j < l.length then r ⟨j, hj⟩ else 0
  have hrho (j : Fin l.length) : rho j = r j := by simp [rho]
  have hs (j : Fin (I.n t) ⊕ Unit) :
      c j + ∑ i, lam i * apNormal I t l i j = 0 := by
    have hh := congrArg (fun w : APVec I t => inner ℝ w (EuclideanSpace.single j 1)) hstat
    simpa [inner_add_left, sum_inner, inner_smul_left, EuclideanSpace.inner_single_right] using hh
  have hr : ∑ j, r j = 1 := by
    have hh := hs (Sum.inr ())
    simp [c, apPack, apNormal, Fintype.sum_sum_type] at hh
    linarith
  have hcoef : (I.A t)ᵀ *ᵥ pi + ∑ j : Fin l.length, rho j • (l.get j).2 ≤ I.c t := by
    intro j
    have hh := hs (Sum.inl j)
    simp [c, apPack, apNormal, Fintype.sum_sum_type] at hh
    have hp := hlam (Sum.inl (Sum.inl j))
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hrho,
      mulVec, dotProduct, transpose_apply, pi, mul_sub, Finset.sum_sub_distrib]
    simp only [r, List.get_eq_getElem, mul_comm] at hh ⊢
    linarith only [hh, hp]
  let d : Dual I t := (pi, rho)
  have hd : d ∈ H I t l := by
    refine ⟨hcoef, ?_, ?_, ?_⟩
    · simpa only [d, hrho] using hr
    · intro j
      dsimp [d, rho]
      split_ifs with hj
      · exact hlam _
      · exact le_rfl
    · intro j hj
      simp [d, rho, not_lt.mpr hj]
  have heq : inner ℝ c v = -(∑ i, lam i * apRhs I t l h i) := by
    have hh := congrArg (fun w : APVec I t => inner ℝ w v) hstat
    simp only [inner_add_left, sum_inner, inner_smul_left, conj_trivial, inner_zero_left] at hh
    have hmul (i : APIndex I t l) : lam i * apRhs I t l h i =
        lam i * inner ℝ (apNormal I t l i) v := by
      have hc := hcomp i
      nlinarith only [hc]
    simp_rw [hmul]
    linarith
  refine ⟨d, hd, ?_⟩
  change inner ℝ (apPack I t (I.c t) 1) (apPack I t y z) = _ at heq
  rw [apPack_inner] at heq
  change I.c t ⬝ᵥ y + 1 * z = _ at heq
  rw [one_mul] at heq
  simp only [Fintype.sum_sum_type, apRhs, mul_zero, Finset.sum_const_zero,
    zero_add, mul_neg, Finset.sum_neg_distrib] at heq
  dsimp [dualObj, d]
  simp only [hrho, pi, dotProduct, sub_mul, Finset.sum_sub_distrib]
  dsimp [r, dotProduct] at heq ⊢
  linarith

/-- Actual zero gap for the supplied native optimal extreme dual. -/
theorem ap_dual_equality (I : Instance) (t : ℕ) (l : List (Cut I t))
    (h : Fin (I.m t) → ℝ) (y : Fin (I.n t) → ℝ) (z : ℝ) (d : Dual I t)
    (hop : IsAPOpt I t {a | a ∈ l} h y z)
    (hd : IsOptExtDual I t l h d) :
    dualObj I t l h d = I.c t ⬝ᵥ y + z := by
  obtain ⟨e, he, hval⟩ := ap_exists_zero_gap_dual I t l h y z hop
  apply le_antisymm (ap_weak_duality I t l h y z d hop.1 hop.2.1 hd.1.1)
  rw [← hval]
  exact hd.2 e he

end DOASAProof

open SDDPConv.Doasa Matrix MeasureTheory Filter Topology

namespace DOASAProof

 theorem feas_closed (I : Instance) (t : ℕ) (h : Fin (I.m t) → ℝ) :
    IsClosed (Feas I t h) := by
  exact (isClosed_le continuous_const continuous_id).inter
    (isClosed_eq (by fun_prop) continuous_const)

theorem feas_compact (I : Instance) (t : ℕ) (h : Fin (I.m t) → ℝ)
    (hb : Bornology.IsBounded (Feas I t h)) : IsCompact (Feas I t h) :=
  Metric.isCompact_of_isClosed_isBounded (feas_closed I t h) hb

theorem V_terminal (I : Instance) (x : Fin (I.n I.T) → ℝ) : V I I.T x = 0 := by
  simp [V, Vrem]

theorem V_rec (I : Instance) (t : ℕ) (ht : t < I.T) (x : Fin (I.n t) → ℝ) :
    V I t x = ∑ i, I.p (t + 1) i * Qo I t x i := by
  have he : I.T - t = (I.T - (t + 1)) + 1 := by omega
  simp only [V, he, Vrem, Qo]

theorem next_reachable (I : Instance) (t : ℕ) (ht : 1 ≤ t)
    (x : Fin (I.n t) → ℝ) (hx : x ∈ Reach I t) (i : Fin (I.q (t + 1)))
    (y : Fin (I.n (t + 1)) → ℝ) (hy : y ∈ Feas I (t + 1) (rhs I t x i)) :
    y ∈ Reach I (t + 1) := by
  obtain ⟨s, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : t ≠ 0)
  exact ⟨x, hx, i, hy⟩

theorem value_lower (I : Instance) (L : ℕ → ℝ) (hL : ValidInit I L)
    (t : ℕ) (ht : 1 ≤ t) (hT : t ≤ I.T)
    (x : Fin (I.n t) → ℝ) (hx : x ∈ Reach I t) :
    (if t < I.T then L t else 0) ≤ V I t x := by
  split_ifs with hlt
  · exact hL t ht (by omega) x hx
  · have he : t = I.T := by omega
    subst t
    rw [V_terminal]

theorem objective_bddBelow (I : Instance) (L : ℕ → ℝ) (hL : ValidInit I L)
    (t : ℕ) (ht : 1 ≤ t) (hT : t ≤ I.T) (h : Fin (I.m t) → ℝ)
    (hb : Bornology.IsBounded (Feas I t h)) (hr : Feas I t h ⊆ Reach I t) :
    BddBelow ((fun y => I.c t ⬝ᵥ y + V I t y) '' Feas I t h) := by
  obtain ⟨b, hbound⟩ := (feas_compact I t h hb).bddBelow_image
    (f := fun y => I.c t ⬝ᵥ y) (by fun_prop)
  refine ⟨b + (if t < I.T then L t else 0), ?_⟩
  rintro _ ⟨y, hy, rfl⟩
  exact add_le_add (hbound ⟨y, hy, rfl⟩) (value_lower I L hL t ht hT y (hr hy))

theorem qo_bddBelow (I : Instance) (L : ℕ → ℝ) (h4 : A4 I) (hL : ValidInit I L)
    (t : ℕ) (ht : 1 ≤ t) (hT : t + 1 ≤ I.T)
    (x : Fin (I.n t) → ℝ) (hx : x ∈ Reach I t) (i : Fin (I.q (t + 1))) :
    BddBelow ((fun y => I.c (t + 1) ⬝ᵥ y + V I (t + 1) y) ''
      Feas I (t + 1) (rhs I t x i)) :=
  objective_bddBelow I L hL (t + 1) (by omega) hT _
    (h4.2.2 t ht hT x hx i).2 (fun y hy => next_reachable I t ht x hx i y hy)

theorem qo_le (I : Instance) (L : ℕ → ℝ) (h4 : A4 I) (hL : ValidInit I L)
    (t : ℕ) (ht : 1 ≤ t) (hT : t + 1 ≤ I.T)
    (x : Fin (I.n t) → ℝ) (hx : x ∈ Reach I t) (i : Fin (I.q (t + 1)))
    (y : Fin (I.n (t + 1)) → ℝ) (hy : y ∈ Feas I (t + 1) (rhs I t x i)) :
    Qo I t x i ≤ I.c (t + 1) ⬝ᵥ y + V I (t + 1) y :=
  csInf_le (qo_bddBelow I L h4 hL t ht hT x hx i) ⟨y, hy, rfl⟩

theorem cut_le_height (I : Instance) (t : ℕ) (C : Set (Cut I t)) (hC : C.Finite)
    (x : Fin (I.n t) → ℝ) (a : Cut I t) (ha : a ∈ C) :
    Cut.eval I a x ≤ cutHeight I t C x :=
  le_csSup (hC.image _).bddAbove ⟨a, ha, rfl⟩

theorem height_le (I : Instance) (t : ℕ) (C : Set (Cut I t)) (hne : C.Nonempty)
    (x : Fin (I.n t) → ℝ) (z : ℝ) (hz : ∀ a ∈ C, Cut.eval I a x ≤ z) :
    cutHeight I t C x ≤ z := by
  apply csSup_le (hne.image _)
  rintro _ ⟨a, ha, rfl⟩
  exact hz a ha

theorem ap_height (I : Instance) (t : ℕ) (C : Set (Cut I t)) (hC : C.Finite)
    (hne : C.Nonempty) (h : Fin (I.m t) → ℝ) (y : Fin (I.n t) → ℝ) (z : ℝ)
    (hop : IsAPOpt I t C h y z) : z = cutHeight I t C y := by
  apply le_antisymm
  · have hh := hop.2.2 y hop.1 (cutHeight I t C y) (fun a ha => cut_le_height I t C hC y a ha)
    linarith only [hh]
  · exact height_le I t C hne y z hop.2.1

theorem ap_value (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (h : Fin (I.m t) → ℝ) (y : Fin (I.n t) → ℝ) (z : ℝ)
    (hop : IsAPOpt I t C h y z) : apVal I t C h = I.c t ⬝ᵥ y + z := by
  have hm : I.c t ⬝ᵥ y + z ∈ {v | ∃ y ∈ Feas I t h, ∃ θ : ℝ,
      (∀ a ∈ C, a.eval I y ≤ θ) ∧ v = I.c t ⬝ᵥ y + θ} :=
    ⟨y, hop.1, z, hop.2.1, rfl⟩
  have hlo : ∀ v ∈ {v | ∃ y ∈ Feas I t h, ∃ θ : ℝ,
      (∀ a ∈ C, a.eval I y ≤ θ) ∧ v = I.c t ⬝ᵥ y + θ}, I.c t ⬝ᵥ y + z ≤ v := by
    rintro v ⟨w, hw, a, ha, rfl⟩
    exact hop.2.2 w hw a ha
  exact le_antisymm (csInf_le ⟨_, hlo⟩ hm) (le_csInf ⟨_, hm⟩ hlo)

theorem terminal_ap (I : Instance) (h : Fin (I.m I.T) → ℝ)
    (hne : (Feas I I.T h).Nonempty) (hb : Bornology.IsBounded (Feas I I.T h)) :
    ∃ y, IsAPOpt I I.T {(0, 0)} h y 0 := by
  obtain ⟨y, hy, hmin⟩ := (feas_compact I I.T h hb).exists_isMinOn hne
    (f := fun y => I.c I.T ⬝ᵥ y) (by fun_prop)
  refine ⟨y, hy, ?_, ?_⟩
  · intro a ha
    have : a = (0, 0) := Set.mem_singleton_iff.mp ha
    subst a
    simp [Cut.eval]
  · intro w hw z hz
    have hz0 := hz (0, 0) (by simp)
    simp only [Cut.eval, zero_dotProduct, sub_zero] at hz0
    have hh : I.c I.T ⬝ᵥ y ≤ I.c I.T ⬝ᵥ w := hmin hw
    linarith only [hh, hz0]

end DOASAProof

open SDDPConv.Doasa Matrix MeasureTheory Filter Topology

namespace DOASAProof

section Run
variable {I : Instance} {L : ℕ → ℝ} {sol : Oracle I} {fw : ℕ → Scen I}
  {bw : ℕ → (t : ℕ) → Finset (Fin (I.q t))}
  {cuts : ℕ → (t : ℕ) → List (Cut I t)} {D : ℕ → (t : ℕ) → Set (Dual I t)}

/-- Padding makes the signature independent of later appended cuts. -/
theorem signature_append (t : ℕ) (l a : List (Cut I t)) (d : Dual I t)
    (hz : ∀ j, l.length ≤ j → d.2 j = 0) :
    dualSignature I t (l ++ a) d = dualSignature I t l d := by
  classical
  apply Prod.ext
  · rfl
  have hsum : (∑ j : Fin (l ++ a).length, d.2 j * ((l ++ a).get j).1) =
      ∑ j ∈ Finset.range (l ++ a).length, d.2 j * (((l ++ a)[j]?).getD (0, 0)).1 := by
    rw [← Fin.sum_univ_eq_sum_range]
    apply Finset.sum_congr rfl
    intro j _
    rw [List.getElem?_eq_getElem j.isLt]
    rfl
  change (∑ j : Fin (l ++ a).length, d.2 j * ((l ++ a).get j).1) = _
  rw [hsum, List.length_append, Finset.sum_range_add]
  have hzsum : (∑ j ∈ Finset.range a.length,
      d.2 (l.length + j) * (((l ++ a)[l.length + j]?).getD (0, 0)).1) = 0 := by
    apply Finset.sum_eq_zero
    intro j _
    rw [hz _ (by omega), zero_mul]
  rw [hzsum, add_zero, ← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro j _
  rw [List.getElem?_eq_getElem (by simp only [List.length_append]; omega : (j : ℕ) < (l ++ a).length)]
  simp only [Option.getD_some, List.getElem_append_left j.isLt, List.get_eq_getElem]

theorem signature_prefix (t : ℕ) (l a : List (Cut I t)) (d : Dual I t)
    (hp : l <+: a) (hd : d ∈ H I t l) :
    dualSignature I t a d = dualSignature I t l d := by
  obtain ⟨b, rfl⟩ := hp
  exact signature_append t l b d hd.2.2.2


theorem run_initial (hrun : IsDOASARun I L sol fw bw cuts D) (t : ℕ) :
    cuts 0 t = [initCut I L t] := hrun.1 t

theorem run_inactive (hrun : IsDOASARun I L sol fw bw cuts D)
    (k t : ℕ) (ht : ¬ (1 ≤ t ∧ t + 1 ≤ I.T)) : cuts (k + 1) t = cuts k t := by
  have hh := hrun.2.2.2 k t
  rw [if_neg ht] at hh
  exact hh.2

theorem run_dual_step (hrun : IsDOASARun I L sol fw bw cuts D)
    (k s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T) :
    ∃ N : Set (Dual I (s + 1)), D (k + 1) (s + 1) = D k (s + 1) ∪ N ∧
      (∀ d ∈ N, ∃ i ∈ bw k (s + 1), IsOptExtDual I (s + 1) (cuts k (s + 1))
        (rhs I s (policy I sol (cutset I cuts k) (fw k) s) i) d) ∧
      (∀ i ∈ bw k (s + 1), ∃ d ∈ N, IsOptExtDual I (s + 1) (cuts k (s + 1))
        (rhs I s (policy I sol (cutset I cuts k) (fw k) s) i) d) := by
  have hh := hrun.2.2.2 k s
  rw [if_pos ⟨hs, hT⟩] at hh
  simpa only [List.mem_singleton, exists_eq_left, forall_eq] using hh.1

theorem run_cut_step (hrun : IsDOASARun I L sol fw bw cuts D)
    (k s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T) :
    cuts (k + 1) s = cuts k s ∨
      ∃ d : Fin (I.q (s + 1)) → Dual I (s + 1),
        (∀ i, IsBest I (s + 1) (cuts k (s + 1)) (D (k + 1) (s + 1))
          (rhs I s (policy I sol (cutset I cuts k) (fw k) s) i) (d i)) ∧
        cuts (k + 1) s = cuts k s ++ [cutOf I s (cuts k (s + 1)) d] := by
  have hh := hrun.2.2.2 k s
  rw [if_pos ⟨hs, hT⟩] at hh
  rcases hh.2 with ⟨_, hc⟩ | ⟨_, d, hd, hc⟩
  · exact Or.inl hc
  · right
    refine ⟨d 0, ?_, ?_⟩
    · simpa using hd 0
    · simpa using hc

theorem run_cut_nonempty_step (hrun : IsDOASARun I L sol fw bw cuts D)
    (k s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T)
    (hne : (D (k + 1) (s + 1)).Nonempty) :
    ∃ d : Fin (I.q (s + 1)) → Dual I (s + 1),
      (∀ i, IsBest I (s + 1) (cuts k (s + 1)) (D (k + 1) (s + 1))
        (rhs I s (policy I sol (cutset I cuts k) (fw k) s) i) (d i)) ∧
      cuts (k + 1) s = cuts k s ++ [cutOf I s (cuts k (s + 1)) d] := by
  have hh := hrun.2.2.2 k s
  rw [if_pos ⟨hs, hT⟩] at hh
  rcases hh.2 with ⟨he, _⟩ | ⟨_, d, hd, hc⟩
  · exact False.elim (hne.ne_empty he)
  · refine ⟨d 0, ?_, ?_⟩
    · simpa using hd 0
    · simpa using hc

theorem cuts_prefix_step (hrun : IsDOASARun I L sol fw bw cuts D) (k t : ℕ) :
    cuts k t <+: cuts (k + 1) t := by
  by_cases ht : 1 ≤ t ∧ t + 1 ≤ I.T
  · rcases run_cut_step hrun k t ht.1 ht.2 with he | ⟨d, _, he⟩
    · rw [he]
    · rw [he]
      exact List.prefix_append _ _
  · rw [run_inactive hrun k t ht]

theorem cuts_prefix (hrun : IsDOASARun I L sol fw bw cuts D) (t : ℕ) :
    ∀ {a b : ℕ}, a ≤ b → cuts a t <+: cuts b t := by
  intro a b hab
  induction b, hab using Nat.le_induction with
  | base => exact List.prefix_refl _
  | succ b hab ih => exact ih.trans (cuts_prefix_step hrun b t)

theorem cutset_mono (hrun : IsDOASARun I L sol fw bw cuts D) (t : ℕ) :
    Monotone (fun k => cutset I cuts k t) := by
  intro a b hab x hx
  exact (cuts_prefix hrun t hab).subset hx

theorem init_mem (hrun : IsDOASARun I L sol fw bw cuts D) (k t : ℕ) :
    initCut I L t ∈ cutset I cuts k t := by
  apply cutset_mono hrun t (Nat.zero_le k)
  simp [cutset, run_initial hrun]

theorem cutset_finite (k t : ℕ) : (cutset I cuts k t).Finite :=
  (cuts k t).finite_toSet

theorem inactive_list (hrun : IsDOASARun I L sol fw bw cuts D) (k t : ℕ)
    (ht : ¬ (1 ≤ t ∧ t + 1 ≤ I.T)) : cuts k t = [initCut I L t] := by
  induction k with
  | zero => exact run_initial hrun t
  | succ k ih => rw [run_inactive hrun k t ht, ih]

theorem terminal_list (hrun : IsDOASARun I L sol fw bw cuts D) (k : ℕ) :
    cuts k I.T = [(0, 0)] := by
  rw [inactive_list hrun k I.T (by omega)]
  simp [initCut]

theorem dual_mono (hrun : IsDOASARun I L sol fw bw cuts D) (t : ℕ) :
    Monotone (fun k => D k t) := by
  apply monotone_nat_of_le_succ
  intro k
  cases t with
  | zero => rw [hrun.2.2.1 k]
  | succ s =>
    by_cases ht : 1 ≤ s ∧ s + 1 ≤ I.T
    · obtain ⟨N, he, _⟩ := run_dual_step hrun k s ht.1 ht.2
      rw [he]
      exact Set.subset_union_left
    · have hh := hrun.2.2.2 k s
      rw [if_neg ht] at hh
      rw [hh.1]

theorem dual_origin (hrun : IsDOASARun I L sol fw bw cuts D) (k t : ℕ)
    (d : Dual I t) (hd : d ∈ D k t) :
    ∃ j < k, d ∈ Set.extremePoints ℝ (H I t (cuts j t)) := by
  induction k with
  | zero => simp [hrun.2.1 t] at hd
  | succ k ih =>
    by_cases hold : d ∈ D k t
    · obtain ⟨j, hj, he⟩ := ih hold
      exact ⟨j, by omega, he⟩
    · cases t with
      | zero => exact False.elim (hold (by rwa [hrun.2.2.1 k] at hd))
      | succ s =>
        by_cases ht : 1 ≤ s ∧ s + 1 ≤ I.T
        · obtain ⟨N, he, hN, _⟩ := run_dual_step hrun k s ht.1 ht.2
          have hn : d ∈ N := (he ▸ hd).resolve_left hold
          obtain ⟨i, _, hi⟩ := hN d hn
          exact ⟨k, by omega, hi.1⟩
        · have hh := hrun.2.2.2 k s
          rw [if_neg ht] at hh
          exact False.elim (hold (by rwa [hh.1] at hd))

end Run

end DOASAProof

namespace DOASAProof

open SDDPConv.Doasa Matrix Set
open scoped BigOperators

private noncomputable def fiberSum {ι κ : Type*} [Fintype ι]
    (f : ι → κ) (w : ι → ℝ) (a : κ) : ℝ := by
  classical
  exact ∑ j, if f j = a then w j else 0

private lemma fiber_weighted {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : ι → κ) (w : ι → ℝ) (v : κ → ℝ) :
    ∑ a, fiberSum f w a * v a = ∑ j, w j * v (f j) := by
  classical
  simp only [fiberSum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  simp [ite_mul]

private lemma fiber_total {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : ι → κ) (w : ι → ℝ) : ∑ a, fiberSum f w a = ∑ j, w j := by
  simpa using fiber_weighted f w (fun _ => 1)

private lemma fiber_nonneg {ι κ : Type*} [Fintype ι]
    (f : ι → κ) (w : ι → ℝ) (hw : ∀ j, 0 ≤ w j) (a : κ) :
    0 ≤ fiberSum f w a := by
  classical
  unfold fiberSum
  exact Finset.sum_nonneg (fun j _ => by split_ifs <;> simp_all)

private lemma le_fiber {ι κ : Type*} [Fintype ι]
    (f : ι → κ) (w : ι → ℝ) (hw : ∀ j, 0 ≤ w j) (j : ι) :
    w j ≤ fiberSum f w (f j) := by
  classical
  have hh := Finset.single_le_sum
    (s := (Finset.univ : Finset ι)) (f := fun i => if f i = f j then w i else 0)
    (fun i _ => by split_ifs <;> simp_all) (Finset.mem_univ j)
  simpa [fiberSum] using hh

private lemma fiber_lift {ι κ : Type*} [Fintype ι]
    (f : ι → κ) (w : ι → ℝ) (q : κ → ℝ)
    (hz : ∀ a, fiberSum f w a = 0 → q a = 0) :
    ∀ a, fiberSum f (fun j => w j / fiberSum f w (f j) * q (f j)) a = q a := by
  classical
  intro a
  have he : fiberSum f (fun j => w j / fiberSum f w (f j) * q (f j)) a =
      fiberSum f w a / fiberSum f w a * q a := by
    simp only [fiberSum, Finset.sum_div, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro j _
    by_cases hj : f j = a <;> simp [hj]
  rw [he]
  by_cases h : fiberSum f w a = 0
  · simp [h, hz a h]
  · rw [div_self h, one_mul]

private abbrev CanonicalDual (I : Instance) (t : ℕ) (C : Set (Cut I t)) :=
  (Fin (I.m t) → ℝ) × (C → ℝ)

private def canonicalH (I : Instance) (t : ℕ) (C : Set (Cut I t)) [Fintype C] :
    Set (CanonicalDual I t C) :=
  {q | (I.A t)ᵀ *ᵥ q.1 + ∑ a : C, q.2 a • a.val.2 ≤ I.c t ∧
    ∑ a, q.2 a = 1 ∧ ∀ a, 0 ≤ q.2 a}

private noncomputable def canonicalForm (I : Instance) (t : ℕ) (C : Set (Cut I t)) [Fintype C] :
    (Fin (I.n t) ⊕ (C ⊕ Bool)) → CanonicalDual I t C →ₗ[ℝ] ℝ := fun i =>
  { toFun := fun q => match i with
      | Sum.inl j => ((I.A t)ᵀ *ᵥ q.1) j + ∑ a : C, q.2 a * a.val.2 j
      | Sum.inr (Sum.inl a) => -q.2 a
      | Sum.inr (Sum.inr b) => if b then ∑ a, q.2 a else -(∑ a, q.2 a)
    map_add' := by
      intro x y
      rcases i with j | (a | b)
      · simp [mulVec, dotProduct, mul_add, add_mul, Finset.sum_add_distrib]; ring
      · simp; ring
      · cases b
        · simp [Finset.sum_add_distrib]
          ring
        · simp [Finset.sum_add_distrib]
    map_smul' := by
      intro r x
      rcases i with j | (a | b)
      · simp [mulVec, dotProduct, mul_add, Finset.mul_sum, mul_assoc, mul_left_comm]
      · simp
      · cases b <;> simp [Finset.mul_sum] }

private def canonicalRhs (I : Instance) (t : ℕ) (C : Set (Cut I t)) :
    (Fin (I.n t) ⊕ (C ⊕ Bool)) → ℝ
  | Sum.inl j => I.c t j
  | Sum.inr (Sum.inl _) => 0
  | Sum.inr (Sum.inr b) => if b then 1 else -1

private theorem canonical_extremes_finite (I : Instance) (t : ℕ)
    (C : Set (Cut I t)) [Fintype C] :
    (Set.extremePoints ℝ (canonicalH I t C)).Finite := by
  have he : canonicalH I t C = {q | ∀ i, canonicalForm I t C i q ≤ canonicalRhs I t C i} := by
    ext q
    constructor
    · rintro ⟨hc, hs, hn⟩ i
      rcases i with j | (a | b)
      · simpa [canonicalForm, canonicalRhs, Finset.sum_apply] using hc j
      · simpa [canonicalForm, canonicalRhs] using hn a
      · cases b <;> simp [canonicalForm, canonicalRhs, hs]
    · intro h
      refine ⟨?_, ?_, ?_⟩
      · intro j
        simpa [canonicalForm, canonicalRhs, Finset.sum_apply] using h (Sum.inl j)
      · have hp := h (Sum.inr (Sum.inr true))
        have hm := h (Sum.inr (Sum.inr false))
        simp only [canonicalForm, LinearMap.coe_mk, AddHom.coe_mk, canonicalRhs,
          Bool.false_eq_true, ↓reduceIte] at hp hm
        linarith
      · intro a
        simpa [canonicalForm, canonicalRhs] using h (Sum.inr (Sum.inl a))
  rw [he]
  exact polyhedron_extremePoints_finite (canonicalForm I t C) (canonicalRhs I t C)

private def listLabel (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (j : Fin l.length) : C :=
  ⟨l.get j, hl _ (List.get_mem l j)⟩

private noncomputable def aggregate (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t) : CanonicalDual I t C :=
  (d.1, fiberSum (listLabel I t C l hl) (fun j => d.2 j))

private lemma aggregate_mem (I : Instance) (t : ℕ) (C : Set (Cut I t)) [Fintype C]
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t) (hd : d ∈ H I t l) :
    aggregate I t C l hl d ∈ canonicalH I t C := by
  refine ⟨?_, ?_, ?_⟩
  · intro j
    have hh := hd.1 j
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, aggregate]
    change ((I.A t)ᵀ *ᵥ d.1) j +
      (∑ a : C, fiberSum (listLabel I t C l hl) (fun k => d.2 k) a * a.val.2 j) ≤ I.c t j
    rw [fiber_weighted]
    simpa [listLabel, Finset.sum_apply] using hh
  · exact (fiber_total _ _).trans hd.2.1
  · exact fiber_nonneg (listLabel I t C l hl) (fun j : Fin l.length => d.2 j) (fun j => hd.2.2.1 j)

private noncomputable def liftDual (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t)
    (q : CanonicalDual I t C) : Dual I t :=
  (q.1, fun j => if hj : j < l.length then
    d.2 j / (aggregate I t C l hl d).2 (listLabel I t C l hl ⟨j, hj⟩) *
      q.2 (listLabel I t C l hl ⟨j, hj⟩) else 0)

private lemma liftDual_finite (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t)
    (q : CanonicalDual I t C) (j : Fin l.length) :
    (liftDual I t C l hl d q).2 j = d.2 j /
      (aggregate I t C l hl d).2 (listLabel I t C l hl j) * q.2 (listLabel I t C l hl j) := by
  simp [liftDual]

private lemma aggregate_lift (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t)
    (q : CanonicalDual I t C)
    (hz : ∀ a, (aggregate I t C l hl d).2 a = 0 → q.2 a = 0) :
    aggregate I t C l hl (liftDual I t C l hl d q) = q := by
  apply Prod.ext
  · rfl
  funext a
  change fiberSum (listLabel I t C l hl) (fun j => (liftDual I t C l hl d q).2 j) a = q.2 a
  simp_rw [liftDual_finite]
  exact fiber_lift _ _ _ hz a

private lemma lift_mem (I : Instance) (t : ℕ) (C : Set (Cut I t)) [Fintype C]
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t) (hd : d ∈ H I t l)
    (q : CanonicalDual I t C) (hq : q ∈ canonicalH I t C)
    (hz : ∀ a, (aggregate I t C l hl d).2 a = 0 → q.2 a = 0) :
    liftDual I t C l hl d q ∈ H I t l := by
  have he := aggregate_lift I t C l hl d q hz
  have hc := hq
  rw [← he] at hc
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro j
    have hh := hc.1 j
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, aggregate] at hh
    change ((I.A t)ᵀ *ᵥ (liftDual I t C l hl d q).1) j +
      (∑ a : C, fiberSum (listLabel I t C l hl) (fun k => (liftDual I t C l hl d q).2 k) a * a.val.2 j) ≤ I.c t j at hh
    rw [fiber_weighted] at hh
    simpa [listLabel, Finset.sum_apply] using hh
  · exact (fiber_total _ _).symm.trans hc.2.1
  · intro j
    dsimp [liftDual]
    split_ifs with hj
    · exact mul_nonneg (div_nonneg (hd.2.2.1 j)
        (fiber_nonneg (listLabel I t C l hl) (fun k : Fin l.length => d.2 k) (fun k => hd.2.2.1 k) _)) (hq.2.2 _)
    · exact le_rfl
  · intro j hj
    simp [liftDual, not_lt.mpr hj]

/-- Positive-fiber lifting proves extremality after duplicate columns are aggregated. -/
private theorem aggregate_extreme (I : Instance) (t : ℕ) (C : Set (Cut I t)) [Fintype C]
    (l : List (Cut I t)) (hl : ∀ a ∈ l, a ∈ C) (d : Dual I t)
    (hd : d ∈ Set.extremePoints ℝ (H I t l)) :
    aggregate I t C l hl d ∈ Set.extremePoints ℝ (canonicalH I t C) := by
  refine ⟨aggregate_mem I t C l hl d hd.1, ?_⟩
  intro q hq q' hq' hseg
  obtain ⟨a, b, ha, hb, hab, he⟩ := hseg
  have hzero : ∀ c, (aggregate I t C l hl d).2 c = 0 → q.2 c = 0 ∧ q'.2 c = 0 := by
    intro c hc
    have hh := congrArg (fun v : CanonicalDual I t C => v.2 c) he
    change a * q.2 c + b * q'.2 c = (aggregate I t C l hl d).2 c at hh
    rw [hc] at hh
    have hp := hq.2.2 c
    have hp' := hq'.2.2 c
    constructor <;> nlinarith only [hh, hp, hp', ha, hb]
  have hqz := fun c hc => (hzero c hc).1
  have hqz' := fun c hc => (hzero c hc).2
  have hlq := lift_mem I t C l hl d hd.1 q hq hqz
  have hlq' := lift_mem I t C l hl d hd.1 q' hq' hqz'
  have hcomb : a • liftDual I t C l hl d q + b • liftDual I t C l hl d q' = d := by
    apply Prod.ext
    · have hh := congrArg (fun v : CanonicalDual I t C => v.1) he
      exact hh
    · funext j
      change a * (liftDual I t C l hl d q).2 j + b * (liftDual I t C l hl d q').2 j = d.2 j
      by_cases hj : j < l.length
      · let k : Fin l.length := ⟨j, hj⟩
        have h1 := liftDual_finite I t C l hl d q k
        have h2 := liftDual_finite I t C l hl d q' k
        change (liftDual I t C l hl d q).2 j = _ at h1
        change (liftDual I t C l hl d q').2 j = _ at h2
        rw [h1, h2]
        have hh := congrArg (fun v : CanonicalDual I t C => v.2 (listLabel I t C l hl k)) he
        change a * q.2 (listLabel I t C l hl k) + b * q'.2 (listLabel I t C l hl k) =
          (aggregate I t C l hl d).2 (listLabel I t C l hl k) at hh
        by_cases hz : (aggregate I t C l hl d).2 (listLabel I t C l hl k) = 0
        · have hw := le_fiber (listLabel I t C l hl) (fun k => d.2 k) (fun k => hd.1.2.2.1 k) k
          change d.2 j ≤ (aggregate I t C l hl d).2 (listLabel I t C l hl k) at hw
          have hdj : d.2 j = 0 := le_antisymm (hw.trans_eq hz) (hd.1.2.2.1 j)
          simp [k, hdj]
        · calc
            _ = (d.2 j / (aggregate I t C l hl d).2 (listLabel I t C l hl k)) *
                (a * q.2 (listLabel I t C l hl k) + b * q'.2 (listLabel I t C l hl k)) := by ring
            _ = d.2 j := by rw [hh, div_mul_cancel₀ _ hz]
      · simp [liftDual, hj, hd.1.2.2.2 j (Nat.le_of_not_gt hj)]
  have hnative : d ∈ openSegment ℝ (liftDual I t C l hl d q) (liftDual I t C l hl d q') :=
    ⟨a, b, ha, hb, hab, hcomb⟩
  have hlEq := hd.2 hlq hlq' hnative
  have heq := congrArg (aggregate I t C l hl) hlEq
  rw [aggregate_lift I t C l hl d q hqz] at heq
  exact heq

/-- The actual (pi, weighted-intercept) signatures are finite even for duplicate cut lists. -/
theorem dualSignatures_finite (I : Instance) (t : ℕ) (C : Set (Cut I t))
    (hC : C.Finite) : (dualSignatures I t C).Finite := by
  classical
  let : Fintype C := hC.fintype
  let sig : CanonicalDual I t C → (Fin (I.m t) → ℝ) × ℝ :=
    fun q => (q.1, ∑ a : C, q.2 a * a.val.1)
  apply ((canonical_extremes_finite I t C).image sig).subset
  rintro v ⟨l, hl, d, hd, rfl⟩
  refine ⟨aggregate I t C l hl d, aggregate_extreme I t C l hl d hd, ?_⟩
  apply Prod.ext
  · rfl
  exact fiber_weighted (listLabel I t C l hl) (fun j => d.2 j) (fun a => a.val.1)

end DOASAProof

open SDDPConv.Doasa Matrix MeasureTheory Filter Topology

namespace DOASAProof

def signatureCut (I : Instance) (s : ℕ)
    (v : Fin (I.q (s + 1)) → (Fin (I.m (s + 1)) → ℝ) × ℝ) : Cut I s :=
  (∑ i, I.p (s + 1) i * (I.ω (s + 1) i ⬝ᵥ (v i).1 + (v i).2),
   ∑ i, I.p (s + 1) i • ((I.B s)ᵀ *ᵥ (v i).1))

theorem cutOf_signature (I : Instance) (s : ℕ) (l : List (Cut I (s + 1)))
    (d : Fin (I.q (s + 1)) → Dual I (s + 1)) :
    cutOf I s l d = signatureCut I s (fun i => dualSignature I (s + 1) l (d i)) := rfl

section Run
variable {I : Instance} {L : ℕ → ℝ} {sol : Oracle I} {fw : ℕ → Scen I}
  {bw : ℕ → (t : ℕ) → Finset (Fin (I.q t))}
  {cuts : ℕ → (t : ℕ) → List (Cut I t)} {D : ℕ → (t : ℕ) → Set (Dual I t)}

theorem dual_signature_mem (hrun : IsDOASARun I L sol fw bw cuts D)
    (k t : ℕ) (C : Set (Cut I t)) (hC : ∀ j, cutset I cuts j t ⊆ C)
    (d : Dual I t) (hd : d ∈ D (k + 1) t) :
    dualSignature I t (cuts k t) d ∈ dualSignatures I t C := by
  obtain ⟨j, hj, he⟩ := dual_origin hrun (k + 1) t d hd
  have hmem : d ∈ H I t (cuts j t) := he.1
  have hp := cuts_prefix hrun t (show j ≤ k by omega)
  rw [signature_prefix t (cuts j t) (cuts k t) d hp hmem]
  exact ⟨cuts j t, fun a ha => hC j ha, d, he, rfl⟩

theorem finite_stage_of_next (hrun : IsDOASARun I L sol fw bw cuts D)
    (s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T)
    (C : Set (Cut I (s + 1))) (hC : C.Finite)
    (hc : ∀ k, cutset I cuts k (s + 1) ⊆ C) :
    (⋃ k, cutset I cuts k s).Finite := by
  classical
  let V := dualSignatures I (s + 1) C
  have hV : V.Finite := dualSignatures_finite I (s + 1) C hC
  let W : Set (Fin (I.q (s + 1)) → (Fin (I.m (s + 1)) → ℝ) × ℝ) :=
    {v | ∀ i, v i ∈ V}
  have hW : W.Finite := Set.Finite.pi' (fun _ => hV)
  let U := {initCut I L s} ∪ signatureCut I s '' W
  have hU : U.Finite := (Set.finite_singleton _).union (hW.image _)
  apply hU.subset
  intro a ha
  obtain ⟨k, hk⟩ := Set.mem_iUnion.mp ha
  have hall : ∀ k, cutset I cuts k s ⊆ U := by
    intro k
    induction k with
    | zero => simp [cutset, run_initial hrun, U]
    | succ k ih =>
      rcases run_cut_step hrun k s hs hT with he | ⟨d, hd, he⟩
      · simpa only [cutset, he] using ih
      · intro b hb
        have hb' : b ∈ cuts k s ∨ b = cutOf I s (cuts k (s + 1)) d := by
          simpa [cutset, he] using hb
        rcases hb' with hb' | rfl
        · exact ih hb'
        · right
          refine ⟨fun i => dualSignature I (s + 1) (cuts k (s + 1)) (d i), ?_, ?_⟩
          · intro i
            exact dual_signature_mem hrun k (s + 1) C hc (d i) (hd i).1
          · exact (cutOf_signature I s _ d).symm
  exact hall k hk

theorem all_cuts_finite (hrun : IsDOASARun I L sol fw bw cuts D) (t : ℕ) :
    (⋃ k, cutset I cuts k t).Finite := by
  have hh : ∀ r t, I.T - t = r → (⋃ k, cutset I cuts k t).Finite := by
    intro r
    induction r using Nat.strong_induction_on with
    | h r ih =>
      intro t he
      by_cases ht : 1 ≤ t ∧ t + 1 ≤ I.T
      · exact finite_stage_of_next hrun t ht.1 ht.2 _
          (ih (I.T - (t + 1)) (by omega) (t + 1) rfl)
          (fun k => Set.subset_iUnion (fun j => cutset I cuts j (t + 1)) k)
      · have heq : (⋃ k, cutset I cuts k t) = {initCut I L t} := by
          ext a
          simp [cutset, inactive_list hrun _ t ht]
        rw [heq]
        exact Set.finite_singleton _
  exact hh (I.T - t) t rfl

end Run
end DOASAProof

open SDDPConv.Doasa Matrix MeasureTheory Filter Topology

namespace DOASAProof

theorem finite_monotone_stabilizes {α : Type*} (f : ℕ → Set α) (hm : Monotone f)
    (hf : (⋃ k, f k).Finite) : ∃ K, ∀ k, K ≤ k → f k = f K := by
  have hd : Directed (· ⊆ ·) f := fun i j => ⟨max i j, hm (le_max_left _ _), hm (le_max_right _ _)⟩
  obtain ⟨K, hK⟩ := hd.exists_mem_subset_of_finset_subset_biUnion
    (s := hf.toFinset) (by simp)
  have hK' : (⋃ k, f k) ⊆ f K := by simpa using hK
  refine ⟨K, fun k hk => Set.Subset.antisymm ?_ (hm hk)⟩
  exact (Set.subset_iUnion f k).trans hK'

theorem cuts_stabilize (I : Instance) (L : ℕ → ℝ) (sol : Oracle I)
    (fw : ℕ → Scen I) (bw : ℕ → (t : ℕ) → Finset (Fin (I.q t)))
    (cuts : ℕ → (t : ℕ) → List (Cut I t)) (D : ℕ → (t : ℕ) → Set (Dual I t))
    (hrun : IsDOASARun I L sol fw bw cuts D) :
    ∃ K, ∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t := by
  classical
  have he : ∀ t : Fin (I.T + 1), ∃ K, ∀ k, K ≤ k →
      cutset I cuts k t = cutset I cuts K t := fun t =>
    finite_monotone_stabilizes _ (cutset_mono hrun t) (all_cuts_finite hrun t)
  choose N hN using he
  let K := Finset.univ.sup N
  refine ⟨K, ?_⟩
  intro k hk t
  by_cases ht : t ≤ I.T
  · let u : Fin (I.T + 1) := ⟨t, by omega⟩
    have hu : N u ≤ K := Finset.le_sup (f := N) (Finset.mem_univ u)
    exact (hN u k (hu.trans hk)).trans (hN u K hu).symm
  · have hn : ¬ (1 ≤ t ∧ t + 1 ≤ I.T) := by omega
    simp only [cutset, inactive_list hrun _ t hn]

end DOASAProof

open SDDPConv.Doasa Matrix MeasureTheory Filter Topology

namespace DOASAProof

theorem padded_sum_append {α E : Type*} [AddCommMonoid E]
    (z : α) (l a : List α) (f : ℕ → α → E)
    (hz : ∀ j, l.length ≤ j → ∀ x, f j x = 0) :
    (∑ j : Fin (l ++ a).length, f j ((l ++ a).get j)) = ∑ j : Fin l.length, f j (l.get j) := by
  classical
  have hsum : (∑ j : Fin (l ++ a).length, f j ((l ++ a).get j)) =
      ∑ j ∈ Finset.range (l ++ a).length, f j (((l ++ a)[j]?).getD z) := by
    rw [← Fin.sum_univ_eq_sum_range]
    apply Finset.sum_congr rfl
    intro j _
    rw [List.getElem?_eq_getElem j.isLt]
    rfl
  rw [hsum, List.length_append, Finset.sum_range_add]
  have hzsum : (∑ j ∈ Finset.range a.length, f (l.length + j) (((l ++ a)[l.length + j]?).getD z)) = 0 := by
    apply Finset.sum_eq_zero
    intro j _
    exact hz _ (by omega) _
  rw [hzsum, add_zero, ← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro j _
  rw [List.getElem?_eq_getElem (by simp only [List.length_append]; omega : (j : ℕ) < (l ++ a).length)]
  simp only [Option.getD_some, List.getElem_append_left j.isLt, List.get_eq_getElem]

theorem H_append (I : Instance) (t : ℕ) (l a : List (Cut I t)) (d : Dual I t)
    (hd : d ∈ H I t l) : d ∈ H I t (l ++ a) := by
  classical
  have hv := padded_sum_append (0, 0) l a (fun j v => d.2 j • v.2)
    (fun j hj v => by rw [hd.2.2.2 j hj, zero_smul])
  have hs := padded_sum_append (0, 0) l a (fun j _ => d.2 j)
    (fun j hj _ => hd.2.2.2 j hj)
  refine ⟨?_, ?_, hd.2.2.1, ?_⟩
  · rw [hv]
    exact hd.1
  · rw [hs]
    exact hd.2.1
  · intro j hj
    exact hd.2.2.2 j (by simp only [List.length_append] at hj; omega)

theorem H_prefix (I : Instance) (t : ℕ) (l a : List (Cut I t)) (d : Dual I t)
    (hp : l <+: a) (hd : d ∈ H I t l) : d ∈ H I t a := by
  obtain ⟨b, rfl⟩ := hp
  exact H_append I t l b d hd

theorem dualObj_prefix (I : Instance) (t : ℕ) (l a : List (Cut I t)) (d : Dual I t)
    (hp : l <+: a) (hd : d ∈ H I t l) (h : Fin (I.m t) → ℝ) :
    dualObj I t a h d = dualObj I t l h d := by
  have hh := congrArg Prod.snd (signature_prefix t l a d hp hd)
  exact congrArg (fun x => d.1 ⬝ᵥ h + x) hh

theorem cutOf_eval (I : Instance) (s : ℕ) (l : List (Cut I (s + 1)))
    (d : Fin (I.q (s + 1)) → Dual I (s + 1)) (x : Fin (I.n s) → ℝ) :
    Cut.eval I (cutOf I s l d) x = ∑ i, I.p (s + 1) i * dualObj I (s + 1) l (rhs I s x i) (d i) := by
  classical
  have hm (i : Fin (I.q (s + 1))) : ((I.B s)ᵀ *ᵥ (d i).1) ⬝ᵥ x = (d i).1 ⬝ᵥ (I.B s *ᵥ x) := by
    rw [dotProduct_comm, dotProduct_transpose_mulVec]
  simp only [Cut.eval, cutOf, dualObj, rhs, dotProduct_sub, sum_dotProduct,
    smul_dotProduct, smul_eq_mul]
  simp_rw [hm, dotProduct_comm (I.ω (s + 1) _) ((d _).1)]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i _
  ring

theorem outcome_nonempty (I : Instance) (t : ℕ) (ht : 2 ≤ t) (hT : t ≤ I.T) :
    Nonempty (Fin (I.q t)) := by
  by_contra hn
  have : IsEmpty (Fin (I.q t)) := not_nonempty_iff.mp hn
  have hh := I.hp_sum t ht hT
  simp at hh

theorem scenario_nonempty (I : Instance) : Nonempty (Scen I) := by
  have hh : ∀ u : Fin (I.T - 2), Nonempty (Fin (I.q (u + 2))) :=
    fun u => outcome_nonempty I (u + 2) (by omega) (by omega)
  exact ⟨fun u => Classical.choice (hh u)⟩

theorem policy_agree (I : Instance) (sol : Oracle I) (C : (t : ℕ) → Set (Cut I t))
    (t : ℕ) (sc sc' : Scen I) (ha : AgreeBefore I (t + 1) sc sc') :
    policy I sol C sc t = policy I sol C sc' t := by
  induction t using Nat.twoStepInduction with
  | zero => rfl
  | one => rfl
  | more t ih ih' =>
    rw [policy, policy]
    split_ifs with ht
    · have hp : AgreeBefore I (t + 2) sc sc' := fun u hu hu' => ha u hu (by omega)
      rw [ih' hp, ha t ht (by omega)]
    · rfl

section Run
variable {I : Instance} {L : ℕ → ℝ} {sol : Oracle I} {fw : ℕ → Scen I}
  {bw : ℕ → (t : ℕ) → Finset (Fin (I.q t))}
  {cuts : ℕ → (t : ℕ) → List (Cut I t)} {D : ℕ → (t : ℕ) → Set (Dual I t)}

theorem stored_dual_feasible (hrun : IsDOASARun I L sol fw bw cuts D)
    (k t : ℕ) (d : Dual I t) (hd : d ∈ D (k + 1) t) : d ∈ H I t (cuts k t) := by
  obtain ⟨j, hj, he⟩ := dual_origin hrun (k + 1) t d hd
  exact H_prefix I t _ _ d (cuts_prefix hrun t (show j ≤ k by omega)) he.1

theorem policy_reachable (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hsol : OracleSpec I L sol) (k : ℕ) (sc : Scen I)
    (t : ℕ) (ht : 1 ≤ t) (hT : t + 1 ≤ I.T) :
    policy I sol (cutset I cuts k) sc t ∈ Reach I t := by
  induction t using Nat.twoStepInduction with
  | zero => omega
  | one =>
    obtain ⟨z, hz⟩ := hsol 1 (by omega) (by omega) _ I.b₁
      (init_mem hrun k 1) (cutset_finite k 1) h4.1 h4.2.1
    exact hz.1
  | more t ih ih' =>
    have hprev := ih' (by omega) (by omega)
    have hu : t < I.T - 2 := by omega
    obtain ⟨z, hz⟩ := hsol (t + 2) (by omega) hT _ _
      (init_mem hrun k (t + 2)) (cutset_finite k (t + 2))
      (h4.2.2 (t + 1) (by omega) (by omega) _ hprev (sc ⟨t, hu⟩)).1
      (h4.2.2 (t + 1) (by omega) (by omega) _ hprev (sc ⟨t, hu⟩)).2
    rw [policy, dif_pos hu]
    exact next_reachable I (t + 1) (by omega) _ hprev _ _ hz.1

theorem cuts_valid (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hL : ValidInit I L) (k t : ℕ)
    (ht : 1 ≤ t) (hT : t ≤ I.T) (a : Cut I t) (ha : a ∈ cutset I cuts k t)
    (x : Fin (I.n t) → ℝ) (hx : x ∈ Reach I t) : Cut.eval I a x ≤ V I t x := by
  have hall : ∀ k t, 1 ≤ t → t ≤ I.T → ∀ a ∈ cutset I cuts k t,
      ∀ x ∈ Reach I t, Cut.eval I a x ≤ V I t x := by
    intro k
    induction k with
    | zero =>
      intro t ht hT a ha x hx
      have he : a = initCut I L t := by simpa [cutset, run_initial hrun] using ha
      subst a
      simpa [Cut.eval, initCut] using value_lower I L hL t ht hT x hx
    | succ k ih =>
      intro t ht hT a ha x hx
      by_cases hact : t + 1 ≤ I.T
      · rcases run_cut_step hrun k t ht hact with he | ⟨d, hd, he⟩
        · exact ih t ht hT a (by simpa [cutset, he] using ha) x hx
        · have hh : a ∈ cuts k t ∨ a = cutOf I t (cuts k (t + 1)) d := by
            simpa [cutset, he] using ha
          rcases hh with hh | rfl
          · exact ih t ht hT a hh x hx
          · rw [cutOf_eval, V_rec I t (by omega)]
            apply Finset.sum_le_sum
            intro i _
            apply mul_le_mul_of_nonneg_left _ (le_of_lt (I.hp_pos (t + 1) (by omega) hact i))
            apply le_csInf ((h4.2.2 t ht hact x hx i).1.image _)
            rintro _ ⟨y, hy, rfl⟩
            exact ap_weak_duality I (t + 1) _ _ y (V I (t + 1) y) (d i) hy
              (fun a ha => ih (t + 1) (by omega) hact a ha y
                (next_reachable I t ht x hx i y hy))
              (stored_dual_feasible hrun k (t + 1) (d i) (hd i).1)
      · exact ih t ht hT a (by simpa [cutset, run_inactive hrun k t (by omega)] using ha) x hx
  exact hall k t ht hT a ha x hx

theorem next_ap_exists (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hsol : OracleSpec I L sol) (k s : ℕ)
    (hs : 1 ≤ s) (hT : s + 1 ≤ I.T) (x : Fin (I.n s) → ℝ)
    (hx : x ∈ Reach I s) (i : Fin (I.q (s + 1))) :
    ∃ y z, IsAPOpt I (s + 1) (cutset I cuts k (s + 1)) (rhs I s x i) y z := by
  by_cases he : s + 1 = I.T
  · have hc : cutset I cuts k (s + 1) = {(0, 0)} := by
      have hc := inactive_list hrun k (s + 1) (by omega)
      simp only [initCut, if_neg (by omega : ¬ s + 1 < I.T)] at hc
      ext a
      simp [cutset, hc]
    rw [hc]
    have hh := h4.2.2 s hs hT x hx i
    have hmin : ∃ y, IsAPOpt I (s + 1) {(0, 0)} (rhs I s x i) y 0 := by
      obtain ⟨y, hy, hm⟩ := (feas_compact I (s + 1) _ hh.2).exists_isMinOn hh.1
        (f := fun y => I.c (s + 1) ⬝ᵥ y) (by fun_prop)
      refine ⟨y, hy, ?_, ?_⟩
      · simp [Cut.eval]
      · intro w hw z hz
        have hz0 := hz (0, 0) (by simp)
        simp only [Cut.eval, zero_dotProduct, sub_zero] at hz0
        have hmw : I.c (s + 1) ⬝ᵥ y ≤ I.c (s + 1) ⬝ᵥ w := hm hw
        linarith only [hmw, hz0]
    obtain ⟨y, hy⟩ := hmin
    exact ⟨y, 0, hy⟩
  · obtain ⟨z, hz⟩ := hsol (s + 1) (by omega) (by omega) _ _
      (init_mem hrun k (s + 1)) (cutset_finite k (s + 1))
      (h4.2.2 s hs hT x hx i).1 (h4.2.2 s hs hT x hx i).2
    exact ⟨_, z, hz⟩

theorem stable_policy (K : ℕ)
    (hK : ∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t)
    (k : ℕ) (hk : K ≤ k) (sc : Scen I) :
    policy I sol (cutset I cuts k) sc = policy I sol (cutset I cuts K) sc := by
  rw [show cutset I cuts k = cutset I cuts K from funext (hK k hk)]

theorem stable_height_ge_ap (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hsol : OracleSpec I L sol) (K : ℕ)
    (hK : ∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t)
    (hJ : ∀ t, 2 ≤ t → t ≤ I.T → ∀ sc : Scen I, ∀ i : Fin (I.q t),
      {k | AgreeBefore I t (fw k) sc ∧ i ∈ bw k t}.Infinite)
    (s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T) (sc : Scen I) :
    (∑ i, I.p (s + 1) i * apVal I (s + 1) (cutset I cuts K (s + 1))
      (rhs I s (policy I sol (cutset I cuts K) sc s) i)) ≤
      cutHeight I s (cutset I cuts K s) (policy I sol (cutset I cuts K) sc s) := by
  classical
  let x := policy I sol (cutset I cuts K) sc s
  have hx : x ∈ Reach I s := policy_reachable hrun h4 hsol K sc s hs hT
  have hcollect : ∀ i : Fin (I.q (s + 1)), ∃ k, K ≤ k ∧ ∃ d ∈ D (k + 1) (s + 1),
      d ∈ H I (s + 1) (cuts k (s + 1)) ∧
      dualObj I (s + 1) (cuts k (s + 1)) (rhs I s x i) d =
        apVal I (s + 1) (cutset I cuts K (s + 1)) (rhs I s x i) := by
    intro i
    obtain ⟨k, hk, hlarge⟩ := (hJ (s + 1) (by omega) hT sc i).exists_gt K
    have hxk : policy I sol (cutset I cuts k) (fw k) s = x := by
      rw [stable_policy K hK k (by omega)]
      exact policy_agree I sol _ s _ _ hk.1
    obtain ⟨N, he, _, hsample⟩ := run_dual_step hrun k s hs hT
    obtain ⟨d, hd, hopt⟩ := hsample i hk.2
    rw [hxk] at hopt
    obtain ⟨y, z, hap⟩ := next_ap_exists hrun h4 hsol k s hs hT x hx i
    refine ⟨k, by omega, d, he.symm ▸ Or.inr hd, hopt.1.1, ?_⟩
    rw [ap_dual_equality I (s + 1) _ _ y z d hap hopt]
    rw [← ap_value I (s + 1) _ _ y z hap, hK k (by omega)]
  choose ki hki di hdi hfeas hvalue using hcollect
  let N := max K (Finset.univ.sup (fun i => ki i + 1))
  have hN : ∀ i, ki i + 1 ≤ N := fun i =>
    (Finset.le_sup (f := fun i => ki i + 1) (Finset.mem_univ i)).trans (le_max_right _ _)
  let i0 : Fin (I.q (s + 1)) := Classical.choice (outcome_nonempty I (s + 1) (by omega) hT)
  obtain ⟨k, hk, hlarge⟩ := (hJ (s + 1) (by omega) hT sc i0).exists_gt N
  have hKk : K ≤ k := (le_max_left _ _).trans (by omega : N ≤ k)
  have hxk : policy I sol (cutset I cuts k) (fw k) s = x := by
    rw [stable_policy K hK k hKk]
    exact policy_agree I sol _ s _ _ hk.1
  have hstore : ∀ i, di i ∈ D (k + 1) (s + 1) := fun i =>
    dual_mono hrun (s + 1) (show ki i + 1 ≤ k + 1 from (hN i).trans (by omega)) (hdi i)
  obtain ⟨d, hbest, hcuts⟩ := run_cut_nonempty_step hrun k s hs hT ⟨di i0, hstore i0⟩
  have ha : cutOf I s (cuts k (s + 1)) d ∈ cutset I cuts K s := by
    rw [← hK (k + 1) (by omega) s]
    simp [cutset, hcuts]
  calc
    _ ≤ ∑ i, I.p (s + 1) i * dualObj I (s + 1) (cuts k (s + 1)) (rhs I s x i) (d i) := by
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_left _ (le_of_lt (I.hp_pos (s + 1) (by omega) hT i))
      rw [← hvalue i, ← dualObj_prefix I (s + 1) _ (cuts k (s + 1)) (di i)
        (cuts_prefix hrun (s + 1) (show ki i ≤ k by have := hN i; omega)) (hfeas i)]
      have hb := (hbest i).2 (di i) (hstore i)
      rwa [hxk] at hb
    _ = Cut.eval I (cutOf I s (cuts k (s + 1)) d) x := (cutOf_eval I s _ d x).symm
    _ ≤ cutHeight I s (cutset I cuts K s) x := cut_le_height I s _ (cutset_finite K s) x _ ha

theorem scenario_next (C : (t : ℕ) → Set (Cut I t)) (s : ℕ)
    (hs : 1 ≤ s) (hT : s + 2 ≤ I.T) (sc : Scen I) (i : Fin (I.q (s + 1))) :
    ∃ sc' : Scen I, policy I sol C sc' s = policy I sol C sc s ∧
      policy I sol C sc' (s + 1) = sol (s + 1) (C (s + 1))
        (rhs I s (policy I sol C sc s) i) := by
  classical
  obtain ⟨r, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : s ≠ 0)
  have hu : r < I.T - 2 := by omega
  let u : Fin (I.T - 2) := ⟨r, hu⟩
  let sc' : Scen I := Function.update sc u i
  have hagree : AgreeBefore I (r + 2) sc' sc := by
    intro v hv hv'
    have hne : (⟨v, hv⟩ : Fin (I.T - 2)) ≠ u := by
      intro he
      have := congrArg Fin.val he
      dsimp [u] at this
      omega
    exact Function.update_of_ne hne _ _
  have hp := policy_agree I sol C (r + 1) sc' sc hagree
  refine ⟨sc', hp, ?_⟩
  rw [policy, dif_pos hu, hp]
  simp [sc', u]

theorem stable_ap_true (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hL : ValidInit I L) (hsol : OracleSpec I L sol)
    (K s : ℕ) (hs : 1 ≤ s) (hT : s + 1 ≤ I.T) (sc : Scen I)
    (he : ∀ sc' : Scen I, s + 1 < I.T →
      cutHeight I (s + 1) (cutset I cuts K (s + 1)) (policy I sol (cutset I cuts K) sc' (s + 1)) =
      V I (s + 1) (policy I sol (cutset I cuts K) sc' (s + 1)))
    (i : Fin (I.q (s + 1))) :
    apVal I (s + 1) (cutset I cuts K (s + 1))
      (rhs I s (policy I sol (cutset I cuts K) sc s) i) =
      Qo I s (policy I sol (cutset I cuts K) sc s) i := by
  let x := policy I sol (cutset I cuts K) sc s
  have hx : x ∈ Reach I s := policy_reachable hrun h4 hsol K sc s hs hT
  have hchoice : ∃ y z, IsAPOpt I (s + 1) (cutset I cuts K (s + 1)) (rhs I s x i) y z ∧
      z = V I (s + 1) y := by
    by_cases ht : s + 1 < I.T
    · obtain ⟨sc', hp, hy⟩ := scenario_next (sol := sol) (cutset I cuts K) s hs (by omega) sc i
      obtain ⟨z, hz⟩ := hsol (s + 1) (by omega) (by omega) _ _
        (init_mem hrun K (s + 1)) (cutset_finite K (s + 1))
        (h4.2.2 s hs hT x hx i).1 (h4.2.2 s hs hT x hx i).2
      refine ⟨_, z, hz, ?_⟩
      rw [ap_height I (s + 1) _ (cutset_finite K (s + 1))
        ⟨_, init_mem hrun K (s + 1)⟩ _ _ _ hz]
      rw [← hy]
      exact he sc' ht
    · obtain ⟨y, z, hz⟩ := next_ap_exists hrun h4 hsol K s hs hT x hx i
      refine ⟨y, z, hz, ?_⟩
      have hc : cutset I cuts K (s + 1) = {(0, 0)} := by
        have hh : s + 1 = I.T := by omega
        have hc := inactive_list hrun K (s + 1) (by omega)
        simp only [initCut, if_neg (by omega : ¬ s + 1 < I.T)] at hc
        ext a
        simp [cutset, hc]
      have hz0 : z = 0 := by
        have hle := hz.2.2 y hz.1 0 (by rw [hc]; simp [Cut.eval])
        have hge := hz.2.1 (0, 0) (by rw [hc]; simp)
        simp only [Cut.eval, zero_dotProduct, sub_zero] at hge
        linarith only [hle, hge]
      rw [hz0]
      simp [V, show I.T - (s + 1) = 0 by omega, Vrem]
  obtain ⟨y, z, hop, hz⟩ := hchoice
  rw [ap_value I (s + 1) _ _ y z hop, hz]
  apply le_antisymm
  · apply le_csInf ((h4.2.2 s hs hT x hx i).1.image _)
    rintro _ ⟨w, hw, rfl⟩
    have hh := hop.2.2 w hw (V I (s + 1) w)
      (fun a ha => cuts_valid hrun h4 hL K (s + 1) (by omega) hT a ha w
        (next_reachable I s hs x hx i w hw))
    rwa [hz] at hh
  · exact qo_le I L h4 hL s hs hT x hx i y hop.1

theorem stable_height_true (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hL : ValidInit I L) (hsol : OracleSpec I L sol) (K : ℕ)
    (hK : ∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t)
    (hJ : ∀ t, 2 ≤ t → t ≤ I.T → ∀ sc : Scen I, ∀ i : Fin (I.q t),
      {k | AgreeBefore I t (fw k) sc ∧ i ∈ bw k t}.Infinite) :
    ∀ s, 1 ≤ s → s + 1 ≤ I.T → ∀ sc : Scen I,
      cutHeight I s (cutset I cuts K s) (policy I sol (cutset I cuts K) sc s) =
      V I s (policy I sol (cutset I cuts K) sc s) := by
  have hall : ∀ r s, I.T - s = r → 1 ≤ s → s + 1 ≤ I.T → ∀ sc : Scen I,
      cutHeight I s (cutset I cuts K s) (policy I sol (cutset I cuts K) sc s) =
      V I s (policy I sol (cutset I cuts K) sc s) := by
    intro r
    induction r using Nat.strong_induction_on with
    | h r ih =>
      intro s he hs hT sc
      apply le_antisymm
      · exact height_le I s _ ⟨_, init_mem hrun K s⟩ _ _
          (fun a ha => cuts_valid hrun h4 hL K s hs (by omega) a ha _
            (policy_reachable hrun h4 hsol K sc s hs hT))
      · have hh := stable_height_ge_ap hrun h4 hsol K hK hJ s hs hT sc
        have hap : ∀ i, apVal I (s + 1) (cutset I cuts K (s + 1))
            (rhs I s (policy I sol (cutset I cuts K) sc s) i) =
            Qo I s (policy I sol (cutset I cuts K) sc s) i := by
          intro i
          exact stable_ap_true hrun h4 hL hsol K s hs hT sc
            (fun sc' ht => ih (I.T - (s + 1)) (by omega) (s + 1) rfl
              (by omega) (by omega) sc') i
        simp_rw [hap] at hh
        rwa [← V_rec I s (by omega)] at hh
  intro s hs hT sc
  exact hall (I.T - s) s rfl hs hT sc

theorem stable_optimal (hrun : IsDOASARun I L sol fw bw cuts D)
    (h4 : A4 I) (hL : ValidInit I L) (hsol : OracleSpec I L sol) (K : ℕ)
    (hK : ∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t)
    (hJ : ∀ t, 2 ≤ t → t ≤ I.T → ∀ sc : Scen I, ∀ i : Fin (I.q t),
      {k | AgreeBefore I t (fw k) sc ∧ i ∈ bw k t}.Infinite) :
    IsOptimalPolicy I (policy I sol (cutset I cuts K)) ∧
      apVal I 1 (cutset I cuts K 1) I.b₁ = Q₁ I := by
  have hheight := stable_height_true hrun h4 hL hsol K hK hJ
  have hinit : ∀ sc : Scen I, SolvesLP1 I (policy I sol (cutset I cuts K) sc 1) ∧
      apVal I 1 (cutset I cuts K 1) I.b₁ = Q₁ I := by
    intro sc
    obtain ⟨z, hz⟩ := hsol 1 (by omega) I.hT _ I.b₁
      (init_mem hrun K 1) (cutset_finite K 1) h4.1 h4.2.1
    have he : z = V I 1 (sol 1 (cutset I cuts K 1) I.b₁) :=
      (ap_height I 1 _ (cutset_finite K 1) ⟨_, init_mem hrun K 1⟩ _ _ _ hz).trans
        (hheight 1 (by omega) I.hT sc)
    have hmin : ∀ w ∈ Feas I 1 I.b₁,
        I.c 1 ⬝ᵥ sol 1 (cutset I cuts K 1) I.b₁ + z ≤ I.c 1 ⬝ᵥ w + V I 1 w := by
      intro w hw
      exact hz.2.2 w hw _ (fun a ha => cuts_valid hrun h4 hL K 1 (by omega)
        (by have := I.hT; omega) a ha w hw)
    constructor
    · refine ⟨hz.1, ?_⟩
      intro w hw
      simpa only [policy, he] using hmin w hw
    · rw [ap_value I 1 _ _ _ _ hz]
      apply le_antisymm
      · exact le_csInf (h4.1.image _) (by rintro _ ⟨w, hw, rfl⟩; exact hmin w hw)
      · have hm : I.c 1 ⬝ᵥ sol 1 (cutset I cuts K 1) I.b₁ + z ∈
            (fun w => I.c 1 ⬝ᵥ w + V I 1 w) '' Feas I 1 I.b₁ :=
          ⟨_, hz.1, by rw [he]⟩
        exact csInf_le ⟨_, by rintro _ ⟨w, hw, rfl⟩; exact hmin w hw⟩ hm
  refine ⟨⟨fun sc => (hinit sc).1, ?_⟩, (hinit (Classical.choice (scenario_nonempty I))).2⟩
  intro sc u hu
  have hp := policy_reachable hrun h4 hsol K sc (u + 1) (by omega) (by omega)
  obtain ⟨z, hz⟩ := hsol (u + 2) (by omega) (by omega) _ _
    (init_mem hrun K (u + 2)) (cutset_finite K (u + 2))
    (h4.2.2 (u + 1) (by omega) (by omega) _ hp (sc ⟨u, hu⟩)).1
    (h4.2.2 (u + 1) (by omega) (by omega) _ hp (sc ⟨u, hu⟩)).2
  have he : z = V I (u + 2) (policy I sol (cutset I cuts K) sc (u + 2)) := by
    rw [ap_height I (u + 2) _ (cutset_finite K (u + 2)) ⟨_, init_mem hrun K (u + 2)⟩ _ _ _ hz]
    have hh := hheight (u + 2) (by omega) (by omega) sc
    simpa only [policy, dif_pos hu] using hh
  refine ⟨?_, ?_⟩
  · simpa only [policy, dif_pos hu] using hz.1
  · intro w hw
    have hh := hz.2.2 w hw _ (fun a ha => cuts_valid hrun h4 hL K (u + 2) (by omega)
      (by omega) a ha w (next_reachable I (u + 1) (by omega) _ hp _ w hw))
    rw [he] at hh
    simpa only [policy, dif_pos hu] using hh

end Run
end DOASAProof

open MeasureTheory

namespace SDDPConv.Doasa

/-- Theorem 4, p. 12, under the joint prefix sampling property J (which implies FPSP and BPSP;
FPSP and BPSP alone do not suffice): with probability 1, every DOASA run stops changing its cuts
after finitely many iterations, the policy induced by the final cuts is optimal for [LP1], and the
lower bound `C^K_1` equals the optimal value `Q_1`. -/
theorem theorem4 (I : Instance) (hA4 : A4 I) (L : ℕ → ℝ) (hL : ValidInit I L) (sol : Oracle I)
    (hsol : OracleSpec I L sol)
    {Ω' : Type*} [MeasurableSpace Ω'] (P : Measure Ω') [IsProbabilityMeasure P]
    (fw : Ω' → ℕ → Scen I) (bw : Ω' → ℕ → (t : ℕ) → Finset (Fin (I.q t)))
    (hJ : JointSP I P fw bw) :
    ∀ᵐ w ∂P, ∀ (cuts : ℕ → (t : ℕ) → List (Cut I t)) (D : ℕ → (t : ℕ) → Set (Dual I t)),
      IsDOASARun I L sol (fw w) (bw w) cuts D →
        ∃ K, (∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t) ∧
          IsOptimalPolicy I (policy I sol (cutset I cuts K)) ∧
          apVal I 1 (cutset I cuts K 1) I.b₁ = Q₁ I := by
  have _ := ‹IsProbabilityMeasure P›
  have hall : ∀ᵐ w ∂P, ∀ t, 2 ≤ t → t ≤ I.T → ∀ sc : Scen I, ∀ i : Fin (I.q t),
      {k | AgreeBefore I t (fw w k) sc ∧ i ∈ bw w k t}.Infinite := by
    apply ae_all_iff.mpr
    intro t
    apply ae_all_iff.mpr
    intro ht
    apply ae_all_iff.mpr
    intro hT
    apply ae_all_iff.mpr
    intro sc
    apply ae_all_iff.mpr
    intro i
    exact hJ t ht hT sc i
  filter_upwards [hall] with w hw
  intro cuts D hrun
  obtain ⟨K, hK⟩ := DOASAProof.cuts_stabilize I L sol (fw w) (bw w) cuts D hrun
  exact ⟨K, hK, DOASAProof.stable_optimal hrun hA4 hL hsol K hK hw⟩

end SDDPConv.Doasa

open SDDPConv.Doasa

theorem solution (I : Instance) (hA4 : A4 I) (L : ℕ → ℝ) (hL : ValidInit I L) (sol : Oracle I)
    (hsol : OracleSpec I L sol)
    {Ω' : Type*} [MeasurableSpace Ω'] (P : Measure Ω') [IsProbabilityMeasure P]
    (fw : Ω' → ℕ → Scen I) (bw : Ω' → ℕ → (t : ℕ) → Finset (Fin (I.q t)))
    (hJ : JointSP I P fw bw) :
    ∀ᵐ w ∂P, ∀ (cuts : ℕ → (t : ℕ) → List (Cut I t)) (D : ℕ → (t : ℕ) → Set (Dual I t)),
      IsDOASARun I L sol (fw w) (bw w) cuts D →
        ∃ K, (∀ k, K ≤ k → ∀ t, cutset I cuts k t = cutset I cuts K t) ∧
          IsOptimalPolicy I (policy I sol (cutset I cuts K)) ∧
          apVal I 1 (cutset I cuts K 1) I.b₁ = Q₁ I := by
  exact SDDPConv.Doasa.theorem4 I hA4 L hL sol hsol P fw bw hJ
