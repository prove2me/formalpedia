    {A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})}
    {B B' : Type} [CommRing B] [Algebra 𝒪 B] [CommRing B'] [Algebra 𝒪 B'] {ψ : Onr →ₐ[𝒪] B}
    (f : B →ₐ[𝒪] B') {E : FakeEllipticCurve Λ N B} {E' : FakeEllipticCurve Λ N B'} (g : E'.A ⟶ E.A)
    (hE' : FakeEllipticCurve.IsPullbackVia (f : B →+* B') E E' g)
