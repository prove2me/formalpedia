            ⟨xet.curve.map ψet.toRingHom, (𝒢 k (xet.curve.map ψet.toRingHom) hΔk).one (𝟙 (base (T := k))), Qk⟩⟩,
          ⟨hhk, hDk, hyk⟩⟩ : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).Raw k) :=
    ModularCurve.LevelComponent.Raw.ext' E1' (Prod.ext E2' (Prod.ext E3' hp))
  have hmapρ : (rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum.map ρ P₀.univ =
      Quot.mk _ ((rigidDataPow A₀ ℓ M' q hℓ hM 𝒢 𝒯).act Cb⁻¹ xk) := by
    rw [← hx]; exact Quot.sound ⟨Cb⁻¹, rfl⟩
