      _ ≤ _ := Nat.le_mul_of_pos_left _ hA0
  have lqC : q * vol Cs ≤ V := by
    rw [hVe]
    calc q * vol Cs ≤ vol B * (q * vol Cs) := Nat.le_mul_of_pos_left _ hB
      _ ≤ q * (vol B * (q * vol Cs)) := Nat.le_mul_of_pos_left _ hq
      _ ≤ _ := Nat.le_mul_of_pos_left _ hA0
  have l1 : vol A0 ≤ V := by
    rw [hVe]; exact Nat.le_mul_of_pos_right _ (Nat.mul_pos hq (Nat.mul_pos hB (Nat.mul_pos hq hC)))
  have l2 : q ≤ V := by
    rw [hVe]
    exact le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hB (Nat.mul_pos hq hC)))
      (Nat.le_mul_of_pos_left _ hA0)
  have l4 : vol Cs ≤ V := le_trans (Nat.le_mul_of_pos_left _ hq) lqC
  have l5 : vol B ≤ V := le_trans (Nat.le_mul_of_pos_right _ hq) lBq
  -- parameter lists
  set l1L : List (Fin HS × Ex HS) := [(1, a), (2, eq), (3, .mul b eq), (4, c)]
  set l2L : List (Fin HS × Ex HS) := [(1, a), (2, eq), (3, b), (4, .mul eq c)]
  have gbq : GoodE t Bb (.mul b eq) := goodE_mul gb gq (by rw [eb, eq']; exact_mod_cast hle _ lBq)
  have gqc : GoodE t Bb (.mul eq c) := goodE_mul gq gc (by rw [eq', ec]; exact_mod_cast hle _ lqC)
  have P1 : PushOK t Bb l1L := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l1L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> assumption)
  have P2 : PushOK t Bb l2L := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> assumption)
  have v1 : ∀ p ∈ l1L, zsz (p.2.eval t) ≤ Bb := by
    intro p hp; simp only [l1L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · simp only; rw [ea]; exact hle _ l1
    · simp only; rw [eq']; exact hle _ l2
    · simp only [Ex.eval]; rw [eb, eq']; exact_mod_cast hle _ lBq
    · simp only; rw [ec]; exact hle _ l4
  have v2 : ∀ p ∈ l2L, zsz (p.2.eval t) ≤ Bb := by
    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · simp only; rw [ea]; exact hle _ l1
    · simp only; rw [eq']; exact hle _ l2
    · simp only; rw [eb]; exact hle _ l5
    · simp only [Ex.eval]; rw [eq', ec]; exact_mod_cast hle _ lqC
