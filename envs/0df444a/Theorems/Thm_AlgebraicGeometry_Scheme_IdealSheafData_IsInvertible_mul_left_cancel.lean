theorem AlgebraicGeometry.Scheme.IdealSheafData.IsInvertible.mul_left_cancel {X : Scheme.{u}}
    {I J J' : X.IdealSheafData} (hI : I.IsInvertible) (h : I * J = I * J') : J = J' := by sorry
