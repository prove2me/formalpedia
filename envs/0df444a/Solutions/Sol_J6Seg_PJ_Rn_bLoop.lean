section outer
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ}

theorem recL_length_le (kk m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) :
    ∀ k, ((List.range k).flatMap (recP kk m mw cB L Mf)).length ≤ k * (2 * m + 5)
  | 0 => by simp
  | n + 1 => by
    have ih := recL_length_le kk m mw cB L Mf n
    have h1 := recP_length kk m mw cB L Mf n
    have h2 := czP_length_le m mw cB L Mf n
    have h3 : wbN m mw L n ≤ m := (wbN_le m mw L n).trans (by omega)
    rw [List.range_succ, List.flatMap_append, List.length_append]
    simp only [List.flatMap_cons, List.flatMap_nil, List.append_nil]
    nlinarith

/-- **The backward records.** -/
theorem Rn.bLoop_sol_aux {v : Vr} {D : Cs} (hF : Fx Q kk m mw cB v) (hS : StS m L Mf D)
    (hB : BdS W m L Mf) (hLm : L.length = m) (hv : BV W v) (h22 : v 22 = 0) (h23 : v 23 = 0)
    (hD50 : D 50 = []) (hD51 : D 51 = []) (hW8 : 8 * (m + 1) ^ 2 ≤ 2 ^ W) :
    Rn (PJ.forL 50 28 1 bBody) v D (fun v' => v' 22 = (flN cB L m : ℤ) ∧
      v' 23 = (((List.range m).flatMap (recP kk m mw cB L Mf)).length : ℤ) ∧
      (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)), v' i = v i) ∧ BV W v')
      (update D 41 (((List.range m).flatMap (recP kk m mw cB L Mf)).reverse ++ D 41))
      (cFor W m (cbB W m)) := by
  set recL : ℕ → List ℤ := fun k => (List.range k).flatMap (recP kk m mw cB L Mf) with hrecL
  have hrs : ∀ k, recL (k + 1) = recL k ++ recP kk m mw cB L Mf k := fun k => by
    simp only [hrecL, List.range_succ, List.flatMap_append, List.flatMap_cons, List.flatMap_nil,
      List.append_nil]
  have f28 : v 28 = m := hF.2.2.2.2.2
  set Iv : ℕ → Vr → Prop := fun k w =>
    (∀ i ∉ ([1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29] : List (Fin HS)), w i = v i) ∧
      w 22 = (flN cB L k : ℤ) ∧ w 23 = ((recL k).length : ℤ) with hIv
  have hmW : m + 1 ≤ 2 ^ W := by nlinarith
  have H := Rn.forL (C := 50) (rN := 28) (ix := 1) (b := bBody) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (N := m) (W := W) (Iv := Iv)
    (cf := fun k => update D 41 ((recL k).reverse ++ D 41)) (cb := cbB W m)
    (fun k => by simp [hD50]) (by omega)
    (fun k hk w ⟨hfw, hw22, hw23⟩ hw1 hbw => by
      set c' := update (update D 41 ((recL k).reverse ++ D 41)) 50 [(m : ℤ) - k]
      have hFw : Fx Q kk m mw cB w := hF.frm hfw (by decide)
      have hS' : StS m L Mf c' := (hS.upd (by decide) _).upd (by decide) _
      have hfl : flN cB L k ≤ k := cnt_le_self _ k
      have hl : (recL (k + 1)).length ≤ (k + 1) * (2 * m + 5) := recL_length_le kk m mw cB L Mf (k + 1)
      have hk1 : (k + 1) * (2 * m + 5) ≤ 8 * (m + 1) ^ 2 := by nlinarith
      have H1 := Rn.bBodyS hFw hS' hB hLm hbw hw1 hk hw22 hw23 (by simp [c', hD51]) hmW
        (by omega) (by rw [← List.length_append, ← hrs]; omega)
      have hst : update c' 41 ((recP kk m mw cB L Mf k).reverse ++ c' 41) =
          update (update D 41 ((recL (k + 1)).reverse ++ D 41)) 50 [(m : ℤ) - k] := by
        have e41 : c' 41 = (recL k).reverse ++ D 41 := by simp [c']
        rw [e41, hrs, List.reverse_append, List.append_assoc]; simp only [c']
        rw [update_comm (by decide : (50 : Fin HS) ≠ 41), update_idem]
      refine (H1.mono (fun w' hw' => ?_) le_rfl).congr hst
      obtain ⟨g22, g23, gf, gb⟩ := hw'
      refine ⟨⟨frm_upd (frm_trans (C := [1, 2, 3, 4, 5, 6, 7, 8, 22, 23, 29]) hfw gf (by decide)
        (by decide)) (by decide) _, ?_, ?_⟩, by rw [gf 1 (by decide), hw1], gb⟩
      · rw [update_of_ne (by decide), g22]
        simp only [flN]; rw [cnt_succ]; simp [flg]
      · rw [update_of_ne (by decide), g23, hrs, List.length_append])
    hv f28 ⟨frm_upd (fun i _ => rfl) (by decide) _, by rw [update_of_ne (by decide), h22]; simp [flN],
      by rw [update_of_ne (by decide), h23]; simp [hrecL]⟩
  have e0 : update D 41 ((recL 0).reverse ++ D 41) = D := by
    simp only [hrecL, List.range_zero, List.flatMap_nil, List.reverse_nil, List.nil_append]
    exact update_eq_self _ _
  rw [e0] at H
  exact H.mono (fun v' ⟨⟨hf, h22', h23'⟩, _, hb⟩ => ⟨h22', h23', hf, hb⟩) le_rfl

