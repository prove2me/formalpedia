theorem t_inv (hn : 3 ≤ n) (hn' : IsUnit ((n : ℕ) : S)) (i j : Fin k)
    (l : ((V S r B u i j : (u i).A.Opens) : Scheme.{0}) ⟶ ((V S r B u j i : (u j).A.Opens) : Scheme.{0}))
    (hl : l ≫ (V S r B u j i).ι = t S r B u hover i j) :
    l ≫ t S r B u hover j i = (V S r B u i j).ι := by
  obtain ⟨κ, hκ, hκpb, hκmul, hκP, hκpol⟩ := exists_κ S r B u hover i j
  obtain ⟨κ', hκ', hκ'pb, hκ'mul, hκ'P, hκ'pol⟩ := exists_κ S r B u hover j i
  have hl' : l = (θ S r B u i j).hom ≫ κ ≫ (θ S r B u j i).inv := by
    rw [← cancel_mono (V S r B u j i).ι, hl, Category.assoc, Category.assoc, ← θ_hom_gA₁ S r B u j i,
      Iso.inv_hom_id_assoc, hκ]
    rfl
  rw [hl', Category.assoc, Category.assoc, t, Iso.inv_hom_id_assoc, ← hκ', ← θ_hom_gA₁ S r B u i j]
  congr 1
  exact κκ_gA₁ S r B u hover hn hn' i j κ hκ hκpb hκmul hκP hκpol κ' hκ'pb hκ'mul hκ'P hκ'pol

