def XJoined_separated_familiesStatement : Prop := ∀ {ε : ℝ} (_hε : 0 < ε),
    ∃ η : ℝ, 0 < η ∧ η < 1 ∧
      (ε ≤ 2 → η = min (1/2) (logarithmicGamma 2 (ε/16))) ∧
