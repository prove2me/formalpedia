open TypeDensity

theorem solution (R : Type) [CommRing R] (t x : R)
    (beta : TypeDensity.BlowupRestriction R t x) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d)
    (hreg : TypeDensity.RegularParameterPair R t x) (J : ℕ)
    (π : TypeDensity.CurveOrderLimit R t x beta G →ₗ[R] TypeDensity.curveSectionsQuot R t x beta G J)
    (hπ : ∀ p : TypeDensity.curveThreads R t x beta G,
      ((π (TypeDensity.curveLimitMk R t x beta G p) : TypeDensity.curveSectionsQuot R t x beta G J) :
      (TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t) ⧸ TypeDensity.curveIdealLattice R t x beta G J) =
      (TypeDensity.curveIdealLattice R t x beta G J).mkQ (p.val J)) :
    Function.Surjective π := by
  classical
  -- key lifting step
  have key : ∀ j : ℕ, ∀ a, a ∈ TypeDensity.curveSections R t x beta G j →
      ∃ b, b ∈ TypeDensity.curveSections R t x beta G (j+1) ∧ a - b ∈ TypeDensity.curveIdealLattice R t x beta G j := by
    intro j a ha
    obtain ⟨ρ, hρ⟩ := TypeDensity.curve_sections_quot_reduction_exists R t x beta d G j
    have hs := TypeDensity.curve_sections_reduction_surjective R t x beta d G hreg j ρ hρ
    obtain ⟨q', hq'⟩ := hs ⟨(TypeDensity.curveIdealLattice R t x beta G j).mkQ a, Submodule.mem_map_of_mem ha⟩
    obtain ⟨b, hb, hbq⟩ := Submodule.mem_map.mp q'.2
    refine ⟨b, hb, ?_⟩
    have h1 := hρ q' b hbq.symm
    rw [hq'] at h1
    have h2 : (TypeDensity.curveIdealLattice R t x beta G j).mkQ (a - b) = 0 := by
      rw [map_sub]; exact sub_eq_zero.mpr h1
    exact (Submodule.Quotient.mk_eq_zero _).mp h2
  have anti : Antitone (fun j => TypeDensity.curveSections R t x beta G j) :=
    antitone_nat_of_succ_le (fun j => (TypeDensity.curve_lattices_antitone R t x beta d G j).2)
  intro q
  obtain ⟨a, ha, haq⟩ := Submodule.mem_map.mp q.2
  let f : ℕ → TypeDensity.ChartPair R t x := fun n => Nat.rec a (fun n fn =>
    if h : fn ∈ TypeDensity.curveSections R t x beta G (J+n) then Classical.choose (key (J+n) fn h) else 0) n
  have f0 : f 0 = a := rfl
  have fmem : ∀ n, f n ∈ TypeDensity.curveSections R t x beta G (J+n) ∧
      f n - f (n+1) ∈ TypeDensity.curveIdealLattice R t x beta G (J+n) := by
    have hs : ∀ n (h : f n ∈ TypeDensity.curveSections R t x beta G (J+n)),
        f (n+1) = Classical.choose (key (J+n) (f n) h) := fun n h => dif_pos h
    intro n
    induction n with
    | zero => exact ⟨ha, by rw [hs 0 ha]; exact (Classical.choose_spec (key _ _ ha)).2⟩
    | succ n ih =>
      have h : f (n+1) ∈ TypeDensity.curveSections R t x beta G (J+(n+1)) := by
        rw [hs n ih.1]; exact (Classical.choose_spec (key _ _ ih.1)).1
      exact ⟨h, by rw [hs (n+1) h]; exact (Classical.choose_spec (key _ _ h)).2⟩
  let p : ℕ → TypeDensity.ChartPair R t x := fun j => f (j - J)
  have hp : p ∈ TypeDensity.curveThreads R t x beta G := by
    refine ⟨?_, ?_⟩
    · intro j _
      exact anti (show j ≤ J + (j - J) by omega) (fmem (j - J)).1
    · intro j _
      change p j - LinearMap.id (p (j+1)) ∈ TypeDensity.curveIdealLattice R t x beta G j
      simp only [LinearMap.id_apply, p]
      by_cases hj : j < J
      · rw [show j - J = 0 by omega, show j + 1 - J = 0 by omega, sub_self]
        exact Submodule.zero_mem _
      · rw [show j + 1 - J = (j - J) + 1 by omega]
        have := (fmem (j - J)).2
        rwa [show J + (j - J) = j by omega] at this
  refine ⟨TypeDensity.curveLimitMk R t x beta G ⟨p, hp⟩, ?_⟩
  apply Subtype.ext
  rw [hπ]
  change (TypeDensity.curveIdealLattice R t x beta G J).mkQ (f (J - J)) = _
  rw [Nat.sub_self, f0, haq]
