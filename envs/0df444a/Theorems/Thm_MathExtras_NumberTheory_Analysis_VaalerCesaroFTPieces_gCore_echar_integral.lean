theorem gCore_echar_integral (M : ℕ) {t : ℝ} (ht : Real.sin (π * t) ≠ 0) :
    (∫ x : ℝ, gCore M x * echar t x)
      = (1 / (M : ℝ) : ℂ) * ∑ N ∈ Finset.range M,
          (MathExtras.Fourier.fejerTriangle t : ℂ)
            * ((π * t : ℂ) * cotC t
                + (π * Complex.I * t : ℂ)
                    * (Complex.I * ((Real.cos (π * (2 * N + 1) * t) : ℂ) / (Real.sin (π * t) : ℂ)))) := by sorry
