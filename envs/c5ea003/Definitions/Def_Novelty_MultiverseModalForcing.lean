import Mathlib
/-
# The Modal Logic of Forcing — Deepening the Multiverse Core

This file goes **deeper** than `MultiverseSetTheory.lean`: instead of only
recording *that* forcing renders atomic sentences independent, we build the
**modal logic** in which forcing statements live.  Following Hamkins–Löwe, we
read the possibility operator `◇p` as *"`p` is forceable"* and the necessity
operator `□p` as *"`p` holds in every forcing extension"*.

The development has two layers.

* **Abstract Kripke layer.**  For any accessibility relation `R` on a type of
  worlds we define the semantic operators `Box` and `Dia` and prove, purely from
  frame conditions, the modal principles
  - `dia_iff_not_box_not` (duality `◇p ↔ ¬□¬p`),
  - `box_K` (the distribution axiom `□(p→q) → □p → □q`),
  - `box_necess` (necessitation),
  - `box_T` (`□p → p`, from reflexivity),
  - `box_four` (`□p → □□p`, from transitivity),
  - `box_dot2` (`◇□p → □◇p`, from confluence/directedness — the **characteristic
    axiom of forcing**, giving `S4.2`),
  - `box_five` (`◇p → □◇p`, from the Euclidean property).

* **Concrete forcing frame.**  We instantiate the abstract layer with the
  accessibility relation generated by single atom *flips* (generic extensions),
  i.e. the reflexive–transitive closure `forcingRel` of `flipStep`.  Because a
  flip is its own inverse, `forcingRel` is an equivalence relation, so the
  forcing frame is reflexive, transitive, confluent **and** Euclidean: it
  validates `T`, `4`, `.2` and `5`.  We then reconnect to sentences, proving that
  from *every* world every atom is *possibly true and possibly false*
  (`forcing_poss_atom_true` / `forcing_poss_atom_false`), a modal restatement of
  the multiverse independence phenomenon, and instantiate it for the Continuum
  Hypothesis.

Everything is proved over `Mathlib` and is self-contained.
-/

namespace MultiverseModalForcing

open Relation

/-! ## Abstract Kripke layer -/

section Kripke

variable {W : Type*}

/-- Necessity: `Box R P w` holds when `P` holds in every `R`-successor of `w`. -/
def Box (R : W → W → Prop) (P : W → Prop) (w : W) : Prop := ∀ v, R w v → P v

/-- Possibility: `Dia R P w` holds when `P` holds in some `R`-successor of `w`. -/
def Dia (R : W → W → Prop) (P : W → Prop) (w : W) : Prop := ∃ v, R w v ∧ P v

variable {R : W → W → Prop} {P Q : W → Prop} {w : W}












/-- A relation is **confluent** (directed) when any two successors of a point have
    a common successor.  For forcing: any two extensions have a common further
    extension. -/
def Confluent (R : W → W → Prop) : Prop :=
  ∀ x y z, R x y → R x z → ∃ u, R y u ∧ R z u

/-- A relation is **Euclidean** when successors of a point are related. -/
def EuclideanRel (R : W → W → Prop) : Prop :=
  ∀ x y z, R x y → R x z → R y z



end Kripke

/-! ## The concrete forcing frame -/

section Forcing

variable {α : Type*} [DecidableEq α]

/-- A `World` is a truth assignment to atomic set-theoretic assertions. -/
abbrev World (α : Type*) := α → Bool

/-- The generic extension of `w` along atom `a`: flip the truth value of `a`. -/
def flip (w : World α) (a : α) : World α :=
  fun x => if x = a then !(w x) else w x




/-- A single **forcing step**: `v` is a generic extension of `w` along some atom. -/
def flipStep (w v : World α) : Prop := ∃ a, v = flip w a


/-- The **forcing accessibility relation**: reachability by finitely many generic
    extensions.  This is the reflexive–transitive closure of `flipStep`. -/
def forcingRel : World α → World α → Prop := ReflTransGen flipStep







/-! ### Forcing validates the modal axioms

We now specialise the abstract theorems to the concrete forcing frame. -/





/-! ### Forcing independence, modally

From every world, every atom is *possibly true* and *possibly false*: forcing
never settles an atom.  This is the modal heart of the multiverse. -/






end Forcing

/-! ## Concrete instance: the Continuum Hypothesis -/

/-- Three atomic set-theoretic assertions. -/
inductive Claim
  | CH      -- the Continuum Hypothesis
  | VeqL    -- the axiom of constructibility `V = L`
  | Meas    -- "there exists a measurable cardinal"
  deriving DecidableEq, Fintype

open Claim

/-- Gödel's constructible universe `L`. -/
def godel : World Claim
  | CH => true
  | VeqL => true
  | Meas => false



end MultiverseModalForcing


