section PsiTowers

p2m_open "Complex Function.Complex AutomorphicForm.ComplexIwasawa"
p2m_open_scoped "Nat Filter.Nat"

variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private def TowersLE (g : Matrix (Fin 2) (Fin 2) ℂ) (N k : ℕ) (f : ℝ → ℝ) (c : ℝ) (e : ℕ) : Prop :=
  ∀ i ≤ k, ‖iteratedFDeriv ℝ i f 0‖ ≤ c * hatD g N ^ e

private theorem hatD_pos (g : Matrix (Fin 2) (Fin 2) ℂ) (N : ℕ) : 0 < hatD g N :=
  zero_lt_one.trans_le (one_le_hatD g N)

private theorem TowersLE.c_nonneg {N k : ℕ} {f : ℝ → ℝ} {c : ℝ} {e : ℕ} (h : TowersLE g N k f c e) : 0 ≤ c :=
  (mul_nonneg_iff_of_pos_right (pow_pos (hatD_pos g N) e)).mp ((norm_nonneg _).trans (h 0 (Nat.zero_le k)))

private theorem TowersLE.mono {N k k' : ℕ} {f : ℝ → ℝ} {c : ℝ} {e : ℕ} (hk : k' ≤ k) (h : TowersLE g N k f c e) :
    TowersLE g N k' f c e :=
  fun i hi => h i (hi.trans hk)

private theorem TowersLE.relax {N k : ℕ} {f : ℝ → ℝ} {c : ℝ} {e : ℕ} (h : TowersLE g N k f c e) {c' : ℝ} {e' : ℕ}
    (hc : c ≤ c') (he : e ≤ e') : TowersLE g N k f c' e' :=
  fun i hi => (h i hi).trans (mul_le_mul hc (pow_le_pow_right₀ (one_le_hatD g N) he)
    (pow_nonneg (hatD_pos g N).le e) (h.c_nonneg.trans hc))

private theorem TowersLE.const {N k : ℕ} (r : ℝ) : TowersLE g N k (fun _ : ℝ => r) (max 1 |r|) 0 := by
  intro i _
  rw [pow_zero, mul_one, norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_const]
  split_ifs
  · rw [Real.norm_eq_abs]; exact le_max_right _ _
  · rw [norm_zero]; exact zero_le_one.trans (le_max_left _ _)

private theorem TowersLE.neg {N k : ℕ} {f : ℝ → ℝ} {c : ℝ} {e : ℕ} (h : TowersLE g N k f c e) :
    TowersLE g N k (fun t => -f t) c e := by
  intro i hi
  have hneg : (fun t => -f t) = -f := rfl
  rw [hneg, iteratedFDeriv_neg_apply, norm_neg]
  exact h i hi

private theorem TowersLE.add {N k : ℕ} {f₁ f₂ : ℝ → ℝ} {c₁ c₂ : ℝ} {e : ℕ} (hf₁ : ContDiff ℝ ∞ f₁)
    (hf₂ : ContDiff ℝ ∞ f₂) (h₁ : TowersLE g N k f₁ c₁ e) (h₂ : TowersLE g N k f₂ c₂ e) :
    TowersLE g N k (fun t => f₁ t + f₂ t) (c₁ + c₂) e := by
  intro i hi
  have hadd : (fun t => f₁ t + f₂ t) = f₁ + f₂ := rfl
  rw [hadd, iteratedFDeriv_add_apply (hf₁.of_le (by exact_mod_cast le_top)).contDiffAt
    (hf₂.of_le (by exact_mod_cast le_top)).contDiffAt, add_mul]
  exact (norm_add_le _ _).trans (add_le_add (h₁ i hi) (h₂ i hi))

private theorem TowersLE.mul {N k : ℕ} {f₁ f₂ : ℝ → ℝ} {c₁ c₂ : ℝ} {e₁ e₂ : ℕ} (hf₁ : ContDiff ℝ ∞ f₁)
    (hf₂ : ContDiff ℝ ∞ f₂) (h₁ : TowersLE g N k f₁ c₁ e₁) (h₂ : TowersLE g N k f₂ c₂ e₂) :
    TowersLE g N k (fun t => f₁ t * f₂ t) (2 ^ k * (c₁ * c₂)) (e₁ + e₂) := by
  intro i hi
  refine (norm_iteratedFDeriv_mul_le hf₁ hf₂ 0 (by exact_mod_cast le_top)).trans ?_
  have hB : 0 ≤ c₁ * hatD g N ^ e₁ * (c₂ * hatD g N ^ e₂) :=
    mul_nonneg ((norm_nonneg _).trans (h₁ 0 (Nat.zero_le _)))
      ((norm_nonneg _).trans (h₂ 0 (Nat.zero_le _)))
  calc ∑ j ∈ Finset.range (i + 1),
          (i.choose j : ℝ) * ‖iteratedFDeriv ℝ j f₁ 0‖ * ‖iteratedFDeriv ℝ (i - j) f₂ 0‖
      ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : ℝ) * (c₁ * hatD g N ^ e₁ * (c₂ * hatD g N ^ e₂)) := by
        refine Finset.sum_le_sum fun j hj => ?_
        have hj : j ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
        rw [mul_assoc]
        exact mul_le_mul_of_nonneg_left
          (mul_le_mul (h₁ j (hj.trans hi)) (h₂ (i - j) ((Nat.sub_le i j).trans hi)) (norm_nonneg _)
            ((norm_nonneg _).trans (h₁ j (hj.trans hi)))) (Nat.cast_nonneg _)
    _ = (2 : ℝ) ^ i * (c₁ * hatD g N ^ e₁ * (c₂ * hatD g N ^ e₂)) := by
        rw [← Finset.sum_mul, ← Nat.cast_sum, Nat.sum_range_choose]
        push_cast
        ring
    _ ≤ (2 : ℝ) ^ k * (c₁ * hatD g N ^ e₁ * (c₂ * hatD g N ^ e₂)) :=
        mul_le_mul_of_nonneg_right (pow_le_pow_right₀ one_le_two hi) hB
    _ = 2 ^ k * (c₁ * c₂) * hatD g N ^ (e₁ + e₂) := by rw [pow_add]; ring

private theorem towersLE_re_clamp {N : ℕ} {h : ℝ → ℂ} (hh : ContDiff ℝ ∞ h)
    (hT : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h t‖ ≤ hatTower g i) {a b η : ℝ} (hη : 0 < η)
    (ha : a < 0) (hb : 0 < b) : TowersLE g N N (fun t : ℝ => (h (chartClamp a b η t)).re) 1 1 := by
  intro i hi
  rw [one_mul, pow_one]
  exact (norm_iteratedFDeriv_re_clamp_le hh hT hη ha hb i).trans (hatTower_le_hatD g hi)

private theorem towersLE_im_clamp {N : ℕ} {h : ℝ → ℂ} (hh : ContDiff ℝ ∞ h)
    (hT : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h t‖ ≤ hatTower g i) {a b η : ℝ} (hη : 0 < η)
    (ha : a < 0) (hb : 0 < b) : TowersLE g N N (fun t : ℝ => (h (chartClamp a b η t)).im) 1 1 := by
  intro i hi
  rw [one_mul, pow_one]
  exact (norm_iteratedFDeriv_im_clamp_le hh hT hη ha hb i).trans (hatTower_le_hatD g hi)

private theorem TowersLE.comp_Icc {N k : ℕ} {o : ℝ → ℝ} {p q : ℝ} (hpq : p < q) (ho : ContDiffOn ℝ ∞ o (Set.Icc p q))
    {Co : ℝ} (hCo0 : 0 ≤ Co)
    (hCo : ∀ i ≤ k, ∀ y ∈ Set.Icc p q, ‖iteratedFDerivWithin ℝ i o (Set.Icc p q) y‖ ≤ Co)
    {f : ℝ → ℝ} (hf : ContDiff ℝ ∞ f) (hrange : ∀ t, f t ∈ Set.Icc p q) {c : ℝ} {e : ℕ}
    (h : TowersLE g N k f c e) :
    TowersLE g N k (fun t => o (f t)) (k ! * Co * max 1 c ^ k) (e * k) := by
  intro j hj
  have hcomp : (fun t => o (f t)) = o ∘ f := rfl
  have hD1 : 1 ≤ max 1 c * hatD g N ^ e :=
    one_le_mul_of_one_le_of_one_le (le_max_left _ _) (one_le_pow₀ (one_le_hatD g N))
  have ht : Set.range f ⊆ Set.Icc p q := Set.range_subset_iff.mpr hrange
  have hC : ∀ i, i ≤ j → ‖iteratedFDerivWithin ℝ i o (Set.Icc p q) (f 0)‖ ≤ Co :=
    fun i hi => hCo i (hi.trans hj) _ (hrange 0)
  have hD : ∀ i, 1 ≤ i → i ≤ j → ‖iteratedFDeriv ℝ i f 0‖ ≤ (max 1 c * hatD g N ^ e) ^ i := by
    intro i hi1 hij
    calc ‖iteratedFDeriv ℝ i f 0‖ ≤ c * hatD g N ^ e := h i (hij.trans hj)
      _ ≤ max 1 c * hatD g N ^ e :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) (pow_nonneg (hatD_pos g N).le e)
      _ ≤ (max 1 c * hatD g N ^ e) ^ i := le_self_pow₀ hD1 (by omega)
  rw [hcomp]
  refine (norm_iteratedFDeriv_comp_le' ht (uniqueDiffOn_Icc hpq) ho hf (by exact_mod_cast le_top) 0 hC
    hD).trans ?_
  · rw [mul_pow, ← pow_mul]
    have hfac : (j ! : ℝ) ≤ k ! := by exact_mod_cast Nat.factorial_le hj
    have hc1 : (1 : ℝ) ≤ max 1 c := le_max_left _ _
    calc (j ! : ℝ) * Co * (max 1 c ^ j * hatD g N ^ (e * j))
        ≤ k ! * Co * (max 1 c ^ k * hatD g N ^ (e * k)) := by
          apply mul_le_mul (mul_le_mul_of_nonneg_right hfac hCo0)
            (mul_le_mul (pow_le_pow_right₀ hc1 hj)
              (pow_le_pow_right₀ (one_le_hatD g N) (Nat.mul_le_mul_left e hj))
              (pow_nonneg (hatD_pos g N).le _) (pow_nonneg (zero_le_one.trans hc1) _))
            (mul_nonneg (pow_nonneg (zero_le_one.trans hc1) _) (pow_nonneg (hatD_pos g N).le _))
            (by positivity)
      _ = k ! * Co * max 1 c ^ k * hatD g N ^ (e * k) := by ring

private theorem TowersLE.deriv {N k : ℕ} {f : ℝ → ℝ} {c : ℝ} {e : ℕ} (h : TowersLE g N (k + 1) f c e) :
    TowersLE g N k (_root_.deriv f) c e := by
  intro i hi
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, ← iteratedDeriv_succ',
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  exact h (i + 1) (by omega)

private theorem deriv_eq_cos_mul_sub (ψ : ℝ → ℝ) (hψ : ContDiff ℝ ∞ ψ) :
    _root_.deriv ψ = fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t
      - Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t := by
  funext t
  have hd : HasDerivAt ψ (_root_.deriv ψ t) t :=
    (hψ.differentiable (by simp) t).hasDerivAt
  have hs : HasDerivAt (fun u => Real.sin (ψ u)) (Real.cos (ψ t) * _root_.deriv ψ t) t :=
    (Real.hasDerivAt_sin (ψ t)).comp t hd
  have hc : HasDerivAt (fun u => Real.cos (ψ u)) (-Real.sin (ψ t) * _root_.deriv ψ t) t :=
    (Real.hasDerivAt_cos (ψ t)).comp t hd
  rw [hs.deriv, hc.deriv]
  linear_combination (-(_root_.deriv ψ t)) * Real.cos_sq_add_sin_sq (ψ t)

private theorem norm_iteratedFDeriv_angle_le {n : ℕ} {ψ : ℝ → ℝ} (hψ : ContDiff ℝ ∞ ψ) {cX cY : ℝ}
    {eX eY : ℕ} (hX : TowersLE g n n (fun t => Real.cos (ψ t)) cX eX)
    (hY : TowersLE g n n (fun t => Real.sin (ψ t)) cY eY) {j : ℕ} (hj : j + 1 ≤ n) :
    ‖iteratedFDeriv ℝ (j + 1) ψ 0‖ ≤ 2 * (2 ^ j * (cX * cY)) * hatD g n ^ (eX + eY) := by
  have hXs : ContDiff ℝ ∞ fun t => Real.cos (ψ t) := Real.contDiff_cos.comp hψ
  have hYs : ContDiff ℝ ∞ fun t => Real.sin (ψ t) := Real.contDiff_sin.comp hψ
  have hX' : ContDiff ℝ ∞ (_root_.deriv fun t => Real.cos (ψ t)) := by
    simpa using hXs.iterate_deriv 1
  have hY' : ContDiff ℝ ∞ (_root_.deriv fun t => Real.sin (ψ t)) := by
    simpa using hYs.iterate_deriv 1
  have hjn : j ≤ n := by omega

  have hP₁ : TowersLE g n j (fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t)
      (2 ^ j * (cX * cY)) (eX + eY) :=
    TowersLE.mul hXs hY' (hX.mono hjn) (TowersLE.deriv (hY.mono hj))
  have hP₂ : TowersLE g n j (fun t => Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t)
      (2 ^ j * (cY * cX)) (eY + eX) :=
    TowersLE.mul hYs hX' (hY.mono hjn) (TowersLE.deriv (hX.mono hj))
  have hP₂' : TowersLE g n j (fun t => Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t)
      (2 ^ j * (cX * cY)) (eX + eY) := by
    rw [mul_comm cY cX] at hP₂
    rw [add_comm eY eX] at hP₂
    exact hP₂
  have hP₁s : ContDiff ℝ ∞ fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t := hXs.mul hY'
  have hP₂s : ContDiff ℝ ∞ fun t => Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t := hYs.mul hX'
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_succ', deriv_eq_cos_mul_sub ψ hψ,
    ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hsub : (fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t
      - Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t)
      = (fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t)
        - fun t => Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t := rfl
  rw [hsub, iteratedFDeriv_sub_apply (hP₁s.of_le (by exact_mod_cast le_top)).contDiffAt
    (hP₂s.of_le (by exact_mod_cast le_top)).contDiffAt]
  calc ‖iteratedFDeriv ℝ j (fun t => Real.cos (ψ t) * _root_.deriv (fun u => Real.sin (ψ u)) t) 0
          - iteratedFDeriv ℝ j (fun t => Real.sin (ψ t) * _root_.deriv (fun u => Real.cos (ψ u)) t) 0‖
      ≤ 2 ^ j * (cX * cY) * hatD g n ^ (eX + eY) + 2 ^ j * (cX * cY) * hatD g n ^ (eX + eY) :=
        (norm_sub_le _ _).trans (add_le_add (hP₁ j le_rfl) (hP₂' j le_rfl))
    _ = 2 * (2 ^ j * (cX * cY)) * hatD g n ^ (eX + eY) := by ring

private theorem TowersLE.congr {N k : ℕ} {f f' : ℝ → ℝ} {c : ℝ} {e : ℕ} (hff' : f = f') (h : TowersLE g N k f c e) :
    TowersLE g N k f' c e := hff' ▸ h

private def psiCW (n : ℕ) : ℝ := 1 + 2 ^ n

private def psiCI (n : ℕ) (Ci : ℝ) : ℝ := n ! * Ci * max 1 (psiCW n) ^ n

private def psiCN (n : ℕ) : ℝ := 2 ^ n + 2 ^ n

private def psiCS (n : ℕ) (Cs : ℝ) : ℝ := n ! * Cs * max 1 (psiCN n) ^ n

private def psiCX (n : ℕ) (Ci : ℝ) : ℝ := 2 ^ n * (1 * psiCI n Ci)

private def psiCY (n : ℕ) (Cs Ci : ℝ) : ℝ := 2 ^ n * (psiCS n Cs * psiCI n Ci)

private def psiConst (n : ℕ) (Cs Ci : ℝ) : ℝ := 2 * (2 ^ n * (psiCX n Ci * psiCY n Cs Ci))

private theorem psiConst_nonneg (n : ℕ) {Cs Ci : ℝ} (hCs : 0 ≤ Cs) (hCi : 0 ≤ Ci) : 0 ≤ psiConst n Cs Ci := by
  unfold psiConst psiCX psiCY psiCS psiCI
  positivity

private theorem exists_psi_tower_bound {m : ℝ} (hm : 0 < m) (hm' : m < 1 / 2) (n : ℕ) :
    ∃ Psi : ℝ, 0 ≤ Psi ∧ ∀ {g : Matrix (Fin 2) (Fin 2) ℂ} {h₁ h₂ : ℝ → ℂ},
      ContDiff ℝ ∞ h₁ → ContDiff ℝ ∞ h₂ →
      (∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h₁ t‖ ≤ hatTower g i) →
      (∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i h₂ t‖ ≤ hatTower g i) →
      (∀ u : ℝ, normSq (h₁ u) + normSq (h₂ u) = 1) →
      ∀ {a b η : ℝ}, 0 < η → a < 0 → 0 < b →
      (∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ normSq (h₂ u)) →
      ∀ {ψ δ : ℝ → ℝ}, ContDiff ℝ ∞ ψ →
      δ = (fun t => -Real.arcsin ((h₁ (chartClamp a b η t)).im)) →
      (∀ t, Real.cos (ψ t) = (h₁ (chartClamp a b η t)).re / Real.cos (δ t)) →
      (∀ t, Real.sin (ψ t) = -Real.sqrt (normSq (h₂ (chartClamp a b η t))) / Real.cos (δ t)) →
      ∀ k : ℕ, 1 ≤ k → k ≤ n → ‖iteratedFDeriv ℝ k ψ 0‖ ≤ Psi * hatD g n ^ (6 * n + 2) := by

  have hJ : (1 : ℝ) / 2 - m < 1 := by linarith
  have hJpos : (0 : ℝ) < 1 / 2 - m := by linarith
  have hsqrtOn : ContDiffOn ℝ ∞ Real.sqrt (Set.Icc (1 / 2 - m) 1) := fun u hu =>
    (Real.contDiffAt_sqrt (hJpos.trans_le hu.1).ne').contDiffWithinAt
  have hinvOn : ContDiffOn ℝ ∞ (fun u : ℝ => (Real.sqrt u)⁻¹) (Set.Icc (1 / 2 - m) 1) :=
    hsqrtOn.inv fun u hu => (Real.sqrt_pos.mpr (hJpos.trans_le hu.1)).ne'
  obtain ⟨Cs, hCs0, hCs⟩ := exists_bound_iteratedFDerivWithin_Icc hJ hsqrtOn n
  obtain ⟨Ci, hCi0, hCi⟩ := exists_bound_iteratedFDerivWithin_Icc hJ hinvOn n
  refine ⟨psiConst n Cs Ci, psiConst_nonneg n hCs0 hCi0, ?_⟩
  intro g h₁ h₂ hh₁ hh₂ hT₁ hT₂ hone a b η hη ha hb hguard ψ δ hψ hδ hcos hsin k hk1 hkn
  have hab : a ≤ b := ha.le.trans hb.le

  have hRe₁ : TowersLE g n n (fun t => (h₁ (chartClamp a b η t)).re) 1 1 := towersLE_re_clamp hh₁ hT₁ hη ha hb
  have hIm₁ : TowersLE g n n (fun t => (h₁ (chartClamp a b η t)).im) 1 1 := towersLE_im_clamp hh₁ hT₁ hη ha hb
  have hRe₂ : TowersLE g n n (fun t => (h₂ (chartClamp a b η t)).re) 1 1 := towersLE_re_clamp hh₂ hT₂ hη ha hb
  have hIm₂ : TowersLE g n n (fun t => (h₂ (chartClamp a b η t)).im) 1 1 := towersLE_im_clamp hh₂ hT₂ hη ha hb
  have hcl : ContDiff ℝ ∞ fun t => h₁ (chartClamp a b η t) := hh₁.comp (contDiff_chartClamp a b η)
  have hcl₂ : ContDiff ℝ ∞ fun t => h₂ (chartClamp a b η t) := hh₂.comp (contDiff_chartClamp a b η)
  have hRe₁s : ContDiff ℝ ∞ fun t => (h₁ (chartClamp a b η t)).re := Complex.reCLM.contDiff.comp hcl
  have hIm₁s : ContDiff ℝ ∞ fun t => (h₁ (chartClamp a b η t)).im := Complex.imCLM.contDiff.comp hcl
  have hRe₂s : ContDiff ℝ ∞ fun t => (h₂ (chartClamp a b η t)).re := Complex.reCLM.contDiff.comp hcl₂
  have hIm₂s : ContDiff ℝ ∞ fun t => (h₂ (chartClamp a b η t)).im := Complex.imCLM.contDiff.comp hcl₂

  have hN_le : ∀ t, normSq (h₂ (chartClamp a b η t)) ≤ 1 := fun t => by
    have := hone (chartClamp a b η t)
    linarith [normSq_nonneg (h₁ (chartClamp a b η t))]
  have hN_ge : ∀ t, 1 / 2 - m ≤ normSq (h₂ (chartClamp a b η t)) := fun t =>
    hguard _ (chartClamp_mem hη hab t)
  have hNrange : ∀ t, normSq (h₂ (chartClamp a b η t)) ∈ Set.Icc (1 / 2 - m) 1 := fun t =>
    ⟨hN_ge t, hN_le t⟩
  have hWrange : ∀ t, 1 - (h₁ (chartClamp a b η t)).im ^ 2 ∈ Set.Icc (1 / 2 - m) 1 := fun t => by
    have h1 := hone (chartClamp a b η t)
    have h2 := Complex.im_sq_le_normSq (h₁ (chartClamp a b η t))
    have h3 := hN_ge t
    constructor <;> nlinarith [sq_nonneg (h₁ (chartClamp a b η t)).im]
  have hWpos : ∀ t, 0 < 1 - (h₁ (chartClamp a b η t)).im ^ 2 := fun t => hJpos.trans_le (hWrange t).1

  have hWeq : (fun t => 1 - (h₁ (chartClamp a b η t)).im ^ 2)
      = fun t => (fun _ : ℝ => (1 : ℝ)) t
          + (fun t => -((h₁ (chartClamp a b η t)).im * (h₁ (chartClamp a b η t)).im)) t := by
    funext t; ring
  have hWs : ContDiff ℝ ∞ fun t => 1 - (h₁ (chartClamp a b η t)).im ^ 2 :=
    contDiff_const.sub (hIm₁s.pow 2)
  have hW : TowersLE g n n (fun t => 1 - (h₁ (chartClamp a b η t)).im ^ 2) (psiCW n) 2 := by
    refine (TowersLE.congr hWeq.symm
      (TowersLE.add contDiff_const (hIm₁s.mul hIm₁s).neg
        ((TowersLE.const 1).relax le_rfl (Nat.zero_le (1 + 1)))
        (TowersLE.mul hIm₁s hIm₁s hIm₁ hIm₁).neg)).relax ?_ (by norm_num)
    unfold psiCW
    simp

  have hNeq : (fun t => normSq (h₂ (chartClamp a b η t)))
      = fun t => (h₂ (chartClamp a b η t)).re * (h₂ (chartClamp a b η t)).re
          + (h₂ (chartClamp a b η t)).im * (h₂ (chartClamp a b η t)).im := by
    funext t; exact Complex.normSq_apply _
  have hNs : ContDiff ℝ ∞ fun t => normSq (h₂ (chartClamp a b η t)) := by
    rw [hNeq]; exact (hRe₂s.mul hRe₂s).add (hIm₂s.mul hIm₂s)
  have hN : TowersLE g n n (fun t => normSq (h₂ (chartClamp a b η t))) (psiCN n) 2 := by
    refine (TowersLE.congr hNeq.symm
      (TowersLE.add (hRe₂s.mul hRe₂s) (hIm₂s.mul hIm₂s) (TowersLE.mul hRe₂s hRe₂s hRe₂ hRe₂)
        (TowersLE.mul hIm₂s hIm₂s hIm₂ hIm₂))).relax ?_ (by norm_num)
    unfold psiCN
    simp

  have hInvW : TowersLE g n n (fun t => (Real.sqrt (1 - (h₁ (chartClamp a b η t)).im ^ 2))⁻¹)
      (psiCI n Ci) (2 * n) :=
    TowersLE.comp_Icc hJ hinvOn hCi0 hCi hWs hWrange hW
  have hSqrtN : TowersLE g n n (fun t => Real.sqrt (normSq (h₂ (chartClamp a b η t)))) (psiCS n Cs) (2 * n) :=
    TowersLE.comp_Icc hJ hsqrtOn hCs0 hCs hNs hNrange hN
  have hInvWs : ContDiff ℝ ∞ fun t => (Real.sqrt (1 - (h₁ (chartClamp a b η t)).im ^ 2))⁻¹ :=
    (hWs.sqrt fun t => (hWpos t).ne').inv fun t => (Real.sqrt_pos.mpr (hWpos t)).ne'
  have hSqrtNs : ContDiff ℝ ∞ fun t => Real.sqrt (normSq (h₂ (chartClamp a b η t))) :=
    hNs.sqrt fun t => (hJpos.trans_le (hN_ge t)).ne'

  have hXeq : (fun t => Real.cos (ψ t))
      = fun t => (h₁ (chartClamp a b η t)).re
          * (Real.sqrt (1 - (h₁ (chartClamp a b η t)).im ^ 2))⁻¹ := by
    funext t
    rw [hcos t]
    simp only [hδ, Real.cos_neg, Real.cos_arcsin, div_eq_mul_inv]
  have hYeq : (fun t => Real.sin (ψ t))
      = fun t => -Real.sqrt (normSq (h₂ (chartClamp a b η t)))
          * (Real.sqrt (1 - (h₁ (chartClamp a b η t)).im ^ 2))⁻¹ := by
    funext t
    rw [hsin t]
    simp only [hδ, Real.cos_neg, Real.cos_arcsin, div_eq_mul_inv]
  have hX : TowersLE g n n (fun t => Real.cos (ψ t)) (psiCX n Ci) (1 + 2 * n) :=
    TowersLE.congr hXeq.symm (TowersLE.mul hRe₁s hInvWs hRe₁ hInvW)
  have hY : TowersLE g n n (fun t => Real.sin (ψ t)) (psiCY n Cs Ci) (2 * n + 2 * n) :=
    TowersLE.congr hYeq.symm (TowersLE.mul hSqrtNs.neg hInvWs hSqrtN.neg hInvW)

  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  refine (norm_iteratedFDeriv_angle_le hψ hX hY hkn).trans ?_
  have hcXY : 0 ≤ psiCX n Ci * psiCY n Cs Ci := mul_nonneg hX.c_nonneg hY.c_nonneg
  unfold psiConst
  exact mul_le_mul
    (mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right (pow_le_pow_right₀ one_le_two (by omega)) hcXY) zero_le_two)
    (pow_le_pow_right₀ (one_le_hatD g n) (by omega)) (pow_nonneg (hatD_pos g n).le _)
    (mul_nonneg zero_le_two (mul_nonneg (pow_nonneg zero_le_two _) hcXY))

end PsiTowers
