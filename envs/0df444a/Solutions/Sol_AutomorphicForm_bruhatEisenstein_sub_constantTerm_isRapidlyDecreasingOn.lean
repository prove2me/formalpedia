section WindowC

p2m_open "Complex Function.Complex ComplexConjugate AutomorphicForm.ComplexIwasawa"

variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private theorem radC_line_le_aux (g : Matrix (Fin 2) (Fin 2) ℂ) (z₀ : ℂ) (θ t : ℝ) :
    radC g (z₀ + t * Complex.exp (θ * Complex.I))
      ≤ radC g z₀ + Real.sqrt (botNormSqC g) * |t| := by
  have hnexp : normSq (Complex.exp ((θ : ℂ) * Complex.I)) = 1 := by
    rw [normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I, one_pow]
  have hA : normSq (Complex.exp (θ * Complex.I) * g 1 0)
      + normSq (Complex.exp (θ * Complex.I) * g 1 1) = botNormSqC g := by
    rw [normSq_mul, normSq_mul, hnexp, one_mul, one_mul, botNormSqC]
  have hA0 : (0 : ℝ) ≤ botNormSqC g := by
    rw [botNormSqC]
    exact add_nonneg (normSq_nonneg _) (normSq_nonneg _)
  have hR2 : radC g (z₀ + t * Complex.exp (θ * Complex.I)) ^ 2
      = botNormSqC g * t ^ 2
        + 2 * ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
            + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) * t
        + (normSq (botP g z₀) + normSq (botQ g z₀)) := by
    have h1 : radC g (z₀ + t * Complex.exp (θ * Complex.I)) ^ 2
        = normSq (botP g (z₀ + t * Complex.exp (θ * Complex.I)))
          + normSq (botQ g (z₀ + t * Complex.exp (θ * Complex.I))) := by
      rw [radC, Real.sq_sqrt (add_nonneg (normSq_nonneg _) (normSq_nonneg _))]
    rw [h1, botP_line, botQ_line,
      normSq_add_smul_add_normSq_add_smul (Complex.exp (θ * Complex.I) * g 1 0)
        (Complex.exp (θ * Complex.I) * g 1 1) (botP g z₀) (botQ g z₀) t, hA]
  have hR02 : radC g z₀ ^ 2 = normSq (botP g z₀) + normSq (botQ g z₀) := by
    rw [radC, Real.sq_sqrt (add_nonneg (normSq_nonneg _) (normSq_nonneg _))]
  have hR00 : 0 ≤ radC g z₀ := Real.sqrt_nonneg _
  have hRt0 : 0 ≤ radC g (z₀ + t * Complex.exp (θ * Complex.I)) := Real.sqrt_nonneg _
  have hL0 : 0 ≤ Real.sqrt (botNormSqC g) := Real.sqrt_nonneg _
  have hLsq : Real.sqrt (botNormSqC g) ^ 2 = botNormSqC g := Real.sq_sqrt hA0

  have hcs : |(conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
      + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re|
      ≤ Real.sqrt (botNormSqC g) * radC g z₀ := by
    have h2 : ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
        + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) ^ 2
        ≤ normSq (conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀
          + conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀) := by
      rw [normSq_apply, add_re]
      nlinarith [sq_nonneg (conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀
          + conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).im,
        add_im (conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀)
          (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀)]
    have h3 := normSq_conj_mul_add_conj_mul_add_normSq_sub
      (Complex.exp (θ * Complex.I) * g 1 0) (Complex.exp (θ * Complex.I) * g 1 1)
      (botP g z₀) (botQ g z₀)
    have h4 : ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
        + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) ^ 2
        ≤ botNormSqC g * (normSq (botP g z₀) + normSq (botQ g z₀)) := by
      refine h2.trans ?_
      nlinarith [normSq_nonneg ((Complex.exp (θ * Complex.I) * g 1 0) * botQ g z₀
        - (Complex.exp (θ * Complex.I) * g 1 1) * botP g z₀), hA, h3]
    have h5 : (Real.sqrt (botNormSqC g) * radC g z₀) ^ 2
        = botNormSqC g * (normSq (botP g z₀) + normSq (botQ g z₀)) := by
      rw [mul_pow, hLsq, hR02]
    nlinarith [abs_nonneg ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
        + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re),
      mul_nonneg hL0 hR00,
      sq_abs ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
        + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re), h4, h5]

  have habs2 : ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
      + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) * t
      ≤ Real.sqrt (botNormSqC g) * radC g z₀ * |t| := by
    calc ((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
        + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) * t
        ≤ |((conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
          + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re) * t| :=
          le_abs_self _
      _ = |(conj (Complex.exp (θ * Complex.I) * g 1 0) * botP g z₀).re
          + (conj (Complex.exp (θ * Complex.I) * g 1 1) * botQ g z₀).re| * |t| :=
          abs_mul _ _
      _ ≤ Real.sqrt (botNormSqC g) * radC g z₀ * |t| :=
          mul_le_mul_of_nonneg_right hcs (abs_nonneg t)
  have hsq : radC g (z₀ + t * Complex.exp (θ * Complex.I)) ^ 2
      ≤ (radC g z₀ + Real.sqrt (botNormSqC g) * |t|) ^ 2 := by
    rw [hR2]
    nlinarith [habs2, sq_abs t, mul_nonneg hL0 (abs_nonneg t), hR00, hLsq, hR02]
  calc radC g (z₀ + t * Complex.exp (θ * Complex.I))
      = Real.sqrt (radC g (z₀ + t * Complex.exp (θ * Complex.I)) ^ 2) :=
        (Real.sqrt_sq hRt0).symm
    _ ≤ Real.sqrt ((radC g z₀ + Real.sqrt (botNormSqC g) * |t|) ^ 2) :=
        Real.sqrt_le_sqrt hsq
    _ = radC g z₀ + Real.sqrt (botNormSqC g) * |t| :=
        Real.sqrt_sq (add_nonneg hR00 (mul_nonneg hL0 (abs_nonneg t)))

private theorem abs_radC_line_sub_le (z₀ : ℂ) (θ t : ℝ) :
    |radC g (z₀ + t * Complex.exp (θ * Complex.I)) - radC g z₀|
      ≤ Real.sqrt (botNormSqC g) * |t| := by
  have h1 := radC_line_le_aux g z₀ θ t
  have h2 := radC_line_le_aux g (z₀ + t * Complex.exp (θ * Complex.I)) θ (-t)
  have hz : z₀ + t * Complex.exp (θ * Complex.I) + (-t : ℝ) * Complex.exp (θ * Complex.I)
      = z₀ := by push_cast; ring
  rw [hz, abs_neg] at h2
  rw [abs_sub_le_iff]
  exact ⟨by linarith, by linarith⟩

private noncomputable def lipLineQSq (g : Matrix (Fin 2) (Fin 2) ℂ) : ℝ :=
  4 * Real.sqrt (botNormSqC g) / Real.sqrt (radFloorC g)

private theorem lineQSq_le_one (hg : g.det ≠ 0) (z₀ : ℂ) (θ t : ℝ) : lineQSq g z₀ θ t ≤ 1 := by
  have h := normSq_linePhat_add_lineQSq hg z₀ θ t
  nlinarith [normSq_nonneg (linePhat g z₀ θ t)]

private theorem lineQSq_ge_half_or (hg : g.det ≠ 0) (z₀ : ℂ) (θ t : ℝ) :
    1 / 2 ≤ lineQSq g z₀ θ t ∨ 1 / 2 ≤ normSq (linePhat g z₀ θ t) := by
  have h := normSq_linePhat_add_lineQSq hg z₀ θ t
  by_cases hc : 1 / 2 ≤ lineQSq g z₀ θ t
  · exact Or.inl hc
  · exact Or.inr (by linarith [not_le.1 hc])

private theorem abs_lineQSq_sub_le (hg : g.det ≠ 0) (z₀ : ℂ) (θ t : ℝ) :
    |lineQSq g z₀ θ t - lineQSq g z₀ θ 0| ≤ lipLineQSq g * |t| := by
  have h00 : z₀ + (0 : ℝ) * Complex.exp (θ * Complex.I) = z₀ := by push_cast; ring
  set β := Complex.exp (θ * Complex.I) * g 1 1 with hβ
  have hnexp : normSq (Complex.exp ((θ : ℂ) * Complex.I)) = 1 := by
    rw [normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I, one_pow]
  have hnβ : ‖β‖ ≤ Real.sqrt (botNormSqC g) := by
    have h1 : ‖β‖ ^ 2 ≤ botNormSqC g := by
      rw [← normSq_eq_norm_sq, hβ, normSq_mul, hnexp, one_mul, botNormSqC]
      nlinarith [normSq_nonneg (g 1 0)]
