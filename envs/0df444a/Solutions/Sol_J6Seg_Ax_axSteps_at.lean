      slabPass n n' m src (fun l => g (argOf l)) xs := by
  rw [slabPass_blocks n n' m pre hnm src g argOf xs hxs]
  unfold passOut
  apply List.flatMap_congr
  intro i _
  rw [runC_ctlOf m g hs argOf]
  apply List.flatMap_congr
  intro l hl
  rw [List.mem_range] at hl
