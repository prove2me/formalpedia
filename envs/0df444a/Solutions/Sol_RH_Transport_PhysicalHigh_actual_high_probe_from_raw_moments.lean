  rw [signal_eq, signal_eq]
  ring

theorem lowExponent_value : lowExponent = 938614149 / 5000000000 := by
  norm_num [lowExponent, lowExponentAt, lxAt, ell, Geometry.ell, b, p]

theorem sideMargin_eq_value (term : SideCondition) :
