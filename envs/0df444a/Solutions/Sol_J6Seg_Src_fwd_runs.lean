section
-- Source module: Solutions.J6SegILSrc3
/-!
# B-line IL, source-table producers, part 3: `ljP`, the forward pass

`ljP iS iT iL iW` (inputs `s, t, λ, w` on the tops of the free stacks `iS, iT, iL, iW`):

1. push the sentinel `0` on `14`;
2. **forward pass** `rep 43 s fwdB`: at step `k` push `stF k` on `14` (`stE`: `k` if `k = 0`,
   `k % λ = 0` or `rrZ k ≠ rrZ (k-1) + 1`, else the previous top);
3. push `s` on `15` (the block end `eB`), `0` on `31` (the count);
4. **backward pass** `rep 43 s bwdB` (part 4): at step `k` (`j = s - 1 - k`) pop `stF j` from
   `14`, push it on `32`, push `eB j - stF j` on `33`, push `j` on `30` and count it on `31` if
   `nearB j`, update `15` to `eB (j - 1)`;
5. pop `15` and the sentinel.

Here: the expressions, their values, and `fwd_runs`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT J6Seg

theorem stE_poly (iS iT iL : Fin HS) :
    PreT.Poly (stE iS iT iL) = true ∧ J6Seg.PreT.dg (stE iS iT iL) ≤ DD ∧
      (stE iS iT iL).size ≤ 400 := by
  refine ⟨?_, ?_, ?_⟩ <;> simp +decide [stE, dE, rrE, jF, PreT.Poly, J6Seg.PreT.dg, Ex.size]

theorem stE_regs (iS iT iL : Fin HS) :
    ∀ j ∈ (stE iS iT iL).regs, j = iS ∨ j = iT ∨ j = iL ∨ j = 43 ∨ j = 14 := by
  intro j hj
  simp only [stE, dE, rrE, jF, Ex.regs, List.mem_append, List.mem_cons,
    List.not_mem_nil, or_false] at hj
  tauto

theorem stV_eq {s t lam k : ℕ} (hs : 0 < s) (hP : 1 ≤ k → True) (prev : ℤ)
    (hprev : 1 ≤ k → prev = (stF s t lam (k - 1) : ℤ)) :
    stV k lam (rrZ s t k + -rrZ s t ((k : ℤ) + -1) + -1) prev = (stF s t lam k : ℤ) := by
  unfold stV
  rcases Nat.eq_zero_or_pos k with rfl | hk1
  · simp [stF_zero]
  · have hcut := cut_iff (t := t) (lam := lam) hs (j := k) hk1
    have hkm : ((k - 1 : ℕ) : ℤ) = (k : ℤ) + -1 := by push_cast [Nat.cast_sub hk1]; ring
    rw [hkm] at hcut
    have hsucc : stF s t lam k = if cutP s t lam k then k else stF s t lam (k - 1) := by
      have := stF_succ (s := s) (t := t) (lam := lam) (k - 1)
      rwa [show k - 1 + 1 = k by omega] at this
    have hc0 : cutP s t lam k → stF s t lam k = k := (stF_eq_iff k).2
    rw [if_pos (by omega)]
    by_cases hm : k % lam = 0
    · rw [if_neg (by rw [show (k : ℤ) % lam = ((k % lam : ℕ) : ℤ) by push_cast; rfl, hm]; simp),
        hc0 (hcut.2 (Or.inl hm))]
    · rw [if_pos (by
        rw [show (k : ℤ) % lam = ((k % lam : ℕ) : ℤ) by push_cast; rfl]
        have : 0 < k % lam := Nat.pos_of_ne_zero hm
        omega)]
      by_cases hd : rrZ s t k + -rrZ s t ((k : ℤ) + -1) + -1 = 0
      · have hnc : ¬ cutP s t lam k := by
          rw [hcut]; push Not; exact ⟨hm, by linarith⟩
        rw [hd, if_neg (by simp), if_neg (by simp), hprev hk1, hsucc, if_neg hnc]
      · have hc : cutP s t lam k := hcut.2 (Or.inr (fun h => hd (by rw [h]; ring)))
        rw [hc0 hc]
        split_ifs <;> first | rfl | omega

/-- **The forward value**: `stE` evaluates to `stF k` at step `k`. -/
theorem stE_eval {σ : IState HS} {iS iT iL : Fin HS} {s t lam k : ℕ} (hs : 0 < s) (hl : 0 < lam)
    (hk : k < s) (hS : σ.top iS = s) (hT : σ.top iT = t) (hL : σ.top iL = lam)
    (hC : σ.top 43 = (s : ℤ) - k)
    (hP : 1 ≤ k → σ.top 14 = (stF s t lam (k - 1) : ℤ))
    (iS' : σ.IsInt iS) (iT' : σ.IsInt iT) (iL' : σ.IsInt iL) (iC' : σ.IsInt 43)
    (iP' : σ.IsInt 14) :
    (stE iS iT iL).eval σ = (stF s t lam k : ℤ) ∧ (stE iS iT iL).ok σ := by
  have hjk : (s : ℤ) + -((s : ℤ) - k) = k := by ring
  have e1 : (stE iS iT iL).eval σ =
      stV k lam (rrZ s t k + -rrZ s t ((k : ℤ) + -1) + -1) (σ.top 14) := by
    simp only [stE, dE, rrE, jF, Ex.eval, hS, hT, hL, hC, hjk]; rfl
  refine ⟨by rw [e1]; exact stV_eq hs (fun _ => trivial) _ hP, ?_⟩
  have hs0 : (0 : ℤ) < 2 * s := by
    have : (0 : ℤ) < s := by exact_mod_cast hs
    omega
  have hl0 : (0 : ℤ) < lam := by exact_mod_cast hl
  have hk0 : (0 : ℤ) ≤ k := by positivity
  have ht0 : (0 : ℤ) ≤ t := by positivity
  have hs1 : (0 : ℤ) ≤ s := by positivity
  have hp0 : (0 : ℤ) ≤ 2 * t * k := by positivity
  simp only [stE, dE, rrE, jF, Ex.ok, Ex.eval, hS, hT, hL, hC, hjk]
  simp only [iS', iT', iL', iC', iP', true_and, and_true, hs0, hl0, hk0]
  split_ifs with h1 h2 h3 h4 <;> simp only [true_and, and_true]
  all_goals first
    | trivial
    | (have hp1 : (0 : ℤ) ≤ 2 * t * ((k : ℤ) + -1) := mul_nonneg (by positivity) (by omega)
       refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith)
    | (have hp1 : (0 : ℤ) ≤ 2 * t * ((k : ℤ) + -1) := mul_nonneg (by positivity) (by omega)
       refine ⟨?_, ?_⟩ <;> linarith)
    | linarith

/-! ## Loops -/

theorem uC_ge (A D : ℕ) : 12000 * (A * D + 3) + 100 ≤ uC A D := by
  unfold uC
  generalize A * D = x
  have : x + 3 ≤ (x + 3) ^ 2 := by nlinarith
  omega

/-- A counted loop on the value of a stack. -/
theorem repP {C i : Fin HS} {b : RS} {s0 : IState HS} {F : ℕ → Fin HS → List ℤ} {N A D c : ℕ}
    (hC5 : C.val < 56) (hC : ∀ k, F k C = []) (hw : C ∉ b.writes) (hi : i.val < 56)
    {L : List ℤ} (hFi : F 0 i = (N : ℤ) :: L) (hN : N ≤ 2 ^ A) (hD : 1 ≤ D)
    (hb : ∀ k < N, Sp b (encK s0 (update (F k) C [(N : ℤ) - k]))
      (encK s0 (update (F (k + 1)) C [(N : ℤ) - k])) c) :
    Sp (.rep C (.reg i) b) (encK s0 (F 0)) (encK s0 (F N)) ((N + 1) * (c + uC A D)) := by
  have hz : zsz (N : ℤ) ≤ A * D + 1 := zsz_le_AD (by simpa using (show ((N : ℤ)) ≤ 2 ^ A by
    exact_mod_cast hN)) hD
  have H := Sp.rep (B := A * D + 1) hC5 hC hw (clean_reg hi) (ok_reg hFi) trivial
    (bnd_reg hFi hz) (eval_reg hFi) hb
  refine H.mono ?_
  have h1 := uC_ge A D
  simp only [Ex.size]
  generalize uC A D = u at h1 ⊢
  generalize A * D = x at h1 ⊢
  have h0 : c + 8000 * (x + 1 + 2) + 30 ≤ c + u := by linarith
  have h2 : N * (c + 8000 * (x + 1 + 2) + 30) ≤ N * (c + u) := Nat.mul_le_mul_left N h0
  have h3 : (1 + 1) * 2000 * (x + 1 + 2) + 32 ≤ c + u := by linarith
  have h4 : (N + 1) * (c + u) = N * (c + u) + (c + u) := by ring
  rw [h4]; linarith

/-! ## The forward pass -/

theorem fwdL_succ (s t lam k : ℕ) : fwdL s t lam (k + 1) = (stF s t lam k : ℤ) :: fwdL s t lam k := by
  simp [fwdL, List.range_succ]

theorem free_top {s0 : IState HS} {G : Fin HS → List ℤ} {i : Fin HS} (hf : Free i) {a : ℤ}
    {l : List ℤ} (hG : G i = a :: l) (x13 x14 x15 x30 x31 x32 x33 x43 x44 : List ℤ) :
    (encK s0 (bS G x13 x14 x15 x30 x31 x32 x33 x43 x44)).top i = a ∧
      (encK s0 (bS G x13 x14 x15 x30 x31 x32 x33 x43 x44)).IsInt i := by
  have h : bS G x13 x14 x15 x30 x31 x32 x33 x43 x44 i = a :: l := by rw [bS_free _ _ _ _ _ _ _ _ _ _ hf]; exact hG
  exact ⟨topv h, isInt_encK h⟩

/-- **The forward pass.** -/
theorem fwd_runs_sol_aux (s0 : IState HS) (G : Fin HS → List ℤ) {iS iT iL : Fin HS} (fS : Free iS)
    (fT : Free iT) (fL : Free iL) {s t lam A : ℕ} {LS LT LL : List ℤ}
    (hGS : G iS = (s : ℤ) :: LS) (hGT : G iT = (t : ℤ) :: LT) (hGL : G iL = (lam : ℤ) :: LL)
    (h43 : G 43 = []) (hs : 0 < s) (hl : 0 < lam) (hsA : s ≤ 2 ^ A) (htA : t ≤ 2 ^ A)
    (hlA : lam ≤ 2 ^ A) (hA : 2 ≤ A) :
    Sp (.rep 43 (.reg iS) (fwdB iS iT iL)) (encK s0 (fwS G s t lam 0)) (encK s0 (fwS G s t lam s))
      ((s + 1) * (401 * uC A DD + uC A DD)) := by
  refine repP (by decide) (fun k => by simp [fwS]) (by simp [fwdB, RS.writes]) fS.1
    (by rw [fwS, bS_free _ _ _ _ _ _ _ _ _ _ fS]; exact hGS) hsA (by decide) ?_
  intro k hk
  simp only [fwS, bS_upd_43]
  have tS := free_top (s0 := s0) fS hGS (G 13) (fwdL s t lam k ++ 0 :: G 14) (G 15) (G 30) (G 31)
    (G 32) (G 33) [(s : ℤ) - k] (G 44)
  have tT := free_top (s0 := s0) fT hGT (G 13) (fwdL s t lam k ++ 0 :: G 14) (G 15) (G 30) (G 31)
    (G 32) (G 33) [(s : ℤ) - k] (G 44)
  have tL := free_top (s0 := s0) fL hGL (G 13) (fwdL s t lam k ++ 0 :: G 14) (G 15) (G 30) (G 31)
    (G 32) (G 33) [(s : ℤ) - k] (G 44)
  obtain ⟨p, lp, hp, hpv⟩ : ∃ p lp, fwdL s t lam k ++ 0 :: G 14 = p :: lp ∧
      (1 ≤ k → p = (stF s t lam (k - 1) : ℤ)) ∧ (k = 0 → p = 0) := by
    rcases Nat.eq_zero_or_pos k with rfl | hk1
    · exact ⟨0, G 14, rfl, fun h => absurd h (by omega), fun _ => rfl⟩
    · obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      exact ⟨_, _, by rw [fwdL_succ]; rfl, fun _ => by simp, fun h => absurd h (by omega)⟩
  set σ := encK s0 (bS G (G 13) (fwdL s t lam k ++ 0 :: G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(s : ℤ) - k] (G 44)) with hσ
  have t14 : σ.top 14 = p := topv (by rw [bS_14]; exact hp)
  have i14 : σ.IsInt 14 := isInt_encK (by rw [bS_14]; exact hp)
  have t43 : σ.top 43 = (s : ℤ) - k := topv (by rw [bS_43])
  have i43 : σ.IsInt 43 := isInt_encK (by rw [bS_43])
  obtain ⟨ev, eok⟩ := stE_eval (σ := σ) (iS := iS) (iT := iT) (iL := iL) hs hl hk tS.1 tT.1 tL.1
    t43 (fun h => by rw [t14]; exact hpv.1 h) tS.2 tT.2 tL.2 i43 i14
  have hpb : |p| ≤ 2 ^ A := by
    rcases Nat.eq_zero_or_pos k with rfl | hk1
    · rw [hpv.2 rfl]; positivity
    · rw [hpv.1 hk1]
      have := stF_le (s := s) (t := t) (lam := lam) (k - 1)
      rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega : stF s t lam (k - 1) ≤ 2 ^ A)
  obtain ⟨hpoly, hdg, hsz⟩ := stE_poly iS iT iL
  have H := pushP s0 _ (i := 14) (e := stE iS iT iL) (A := A) (D := DD) (by decide)
    (fun j hj => by
      rcases stE_regs iS iT iL j hj with rfl | rfl | rfl | rfl | rfl
      · exact fS.1
      · exact fT.1
      · exact fL.1
      · decide
      · decide) eok ev
    (fun j hj => by
      rcases stE_regs iS iT iL j hj with rfl | rfl | rfl | rfl | rfl
      · rw [tS.1, abs_of_nonneg (by positivity)]; exact_mod_cast hsA
      · rw [tT.1, abs_of_nonneg (by positivity)]; exact_mod_cast htA
      · rw [tL.1, abs_of_nonneg (by positivity)]; exact_mod_cast hlA
      · rw [t43, abs_of_nonneg (by omega)]
        have h2 : ((s : ℕ) : ℤ) ≤ (2 : ℤ) ^ A := by exact_mod_cast hsA
        have h3 : (0 : ℤ) ≤ k := by positivity
        linarith
      · rw [t14]; exact hpb) hA hpoly hdg
  rw [bS_upd_14, bS_14] at H
  rw [fwdL_succ, List.cons_append]
  exact H.mono (Nat.mul_le_mul_right _ (by omega))

