    KFM.Hold.of_agree h' (ha r hr)
  have f : ∀ r, r ∈ regIdx6 → ∀ l : List ℤ, (∃ L, u.G r = ints l ++ L) →
      ∃ L, t.G r = ints l ++ L := fun r hr l ⟨L, hL⟩ => ⟨L, by rw [ha r hr, hL]⟩
  exact ⟨e _ (by decide) _ h.hS, e _ (by decide) _ h.hT, e _ (by decide) _ h.hT2,
