  have h3 : pre * B * 2 ^ j = N := by rw [← hN]; ring
  set X := (kb + 1) * (W + kb + 5) with hX
  have hXW : W + 2 ≤ X := by rw [hX]; nlinarith
  have a1 : pre * (4 * 10 ^ 6 * (kb + 1) * (2 ^ j * B + 1) * (W + kb + 5)) ≤ 8 * 10 ^ 6 * X * N := by
    have : pre * (4 * 10 ^ 6 * (kb + 1) * (2 ^ j * B + 1) * (W + kb + 5)) =
        4 * 10 ^ 6 * X * (pre * (2 ^ j * B) + pre) := by rw [hX]; ring
    rw [this, hN]; nlinarith
  have a2 : pre * (B * (cT + 2 ^ j * (14000 * (W + 2) + 30) + 12000 * (W + 2) + 62)) ≤
      pre * B * cT + N * (26000 * (W + 2) + 92) := by
    have : pre * (B * (cT + 2 ^ j * (14000 * (W + 2) + 30) + 12000 * (W + 2) + 62)) =
        pre * B * cT + (pre * B * 2 ^ j) * (14000 * (W + 2) + 30) +
          (pre * B) * (12000 * (W + 2) + 62) := by ring
    rw [this, h3]; nlinarith
  have a3 : pre * (2 * (8000 * (W + 2) + 2 ^ j * B * (14000 * (W + 2) + 30) + 32)) ≤
      N * (44000 * (W + 2) + 124) := by
    have : pre * (2 * (8000 * (W + 2) + 2 ^ j * B * (14000 * (W + 2) + 30) + 32)) =
        2 * pre * (8000 * (W + 2) + 32) + 2 * (pre * (2 ^ j * B)) * (14000 * (W + 2) + 30) := by ring
    rw [this, hN]; nlinarith
  have a4 : pre * (40000 * (W + 2) + (4000 * (W + 2) + 32) + 8000 * (W + 2) + 30) ≤
      N * (52000 * (W + 2) + 62) := by nlinarith
  have hNX : N * (W + 2) ≤ X * N := by nlinarith
  have hN1 : 1 ≤ N := le_trans hp h2
  have e : lvlCost pre j B kb W cT =
      pre * (4 * 10 ^ 6 * (kb + 1) * (2 ^ j * B + 1) * (W + kb + 5)) +
      pre * (B * (cT + 2 ^ j * (14000 * (W + 2) + 30) + 12000 * (W + 2) + 62)) +
      pre * (2 * (8000 * (W + 2) + 2 ^ j * B * (14000 * (W + 2) + 30) + 32)) +
      pre * (40000 * (W + 2) + (4000 * (W + 2) + 32) + 8000 * (W + 2) + 30) +
      pre * (2 ^ j * B) * (14000 * (W + 2) + 30) + 8000 * (W + 2) + 64 := by
    simp only [lvlCost, blkCost]; ring
  rw [e, hN]
  have : 10 ^ 7 * (kb + 1) * N * (W + kb + 5) = 10 ^ 7 * X * N := by rw [hX]; ring
  rw [this]
  nlinarith

