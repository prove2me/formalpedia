theorem RootEnvironment.persistent {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L : ℕ} {a : F} {m : ℕ → ℕ}
    (h : RootEnvironment b R U D C TB ZB cap L a m) (src : ℕ) (f : F[X])
    (hm99 : m 99 = src) (hf : PolynomialStored b m src cap f) : RootPersistent b R U D C TB ZB cap L src f a m :=
  ⟨h.length, h.dimension, h.unit, h.capacity, h.scalar, hm99, h.fixedR, h.fixedD, h.fixedU, h.fixedC, h.fixedT, h.fixedZ, hf, h.zero⟩

theorem RootWorkspace.level_meta_readonly {R U D C TB ZB cap QB T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hQB : 128 ≤ QB)
    (slot : ℕ) (hs : slot < 128) (hn : ¬ rootLevelMeta slot) :
    ¬ rootLevelWritable R U D C TB cap QB T slot := by
  intro hbad
  rcases hbad with h91 | h99 | h111 | hnode
  · exact hn (Or.inl h91)
  · exact hn (Or.inr (Or.inl h99))
  · exact hn (Or.inr (Or.inr (Or.inl h111)))
  · exact h.meta_readonly hQB slot hs (by intro ha; exact hn (Or.inr (Or.inr (Or.inr ha)))) hnode

theorem RootWorkspace.level_zero_readonly {R U D C TB ZB cap QB T : ℕ}
    (h : RootWorkspace R U D C TB ZB cap) (hQ : QB + T * cap ≤ ZB ∨ ZB + cap ≤ QB)
    (i : ℕ) (hi : i < cap) : ¬ rootLevelWritable R U D C TB cap QB T (ZB + i) := by
  intro hbad
  have hZ := h.Zlow
  rcases hbad with h91 | h99 | h111 | hnode
  · omega
  · omega
  · omega
  · exact h.node_zero_readonly hQ i hi hnode

theorem RootEnvironment.of_level_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L QB T : ℕ} {a : F} {m m' : ℕ → ℕ}
    (h : RootEnvironment b R U D C TB ZB cap L a m) (hl : RootWorkspace R U D C TB ZB cap)
    (hQB : 128 ≤ QB) (hQZ : QB + T * cap ≤ ZB ∨ ZB + cap ≤ QB)
    (hf : MemoryFrame (rootLevelWritable R U D C TB cap QB T) m m') :
    RootEnvironment b R U D C TB ZB cap L a m' := by
  have hmeta (slot : ℕ) (hs : slot < 128) (hn : ¬ rootLevelMeta slot) : m' slot = m slot :=
    hf slot (hl.level_meta_readonly hQB slot hs hn)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, h.zero.of_frame hf (hl.level_zero_readonly hQZ)⟩
  · exact (hmeta 76 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.length
  · exact (hmeta 77 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.dimension
  · exact (hmeta 78 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.unit
  · exact (hmeta 81 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.capacity
  · exact (hmeta 96 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.scalar
  · exact (hmeta 102 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedR
  · exact (hmeta 103 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedD
  · exact (hmeta 104 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedU
  · exact (hmeta 105 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedC
  · exact (hmeta 106 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedT
  · exact (hmeta 108 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans h.fixedZ

theorem queueReadPointer_spec (E : RAMEnv) (s : RAMState) (B j cap : ℕ)
    (hmeta : (99 : ℕ) < 2 ^ E.W) (hB : B < 2 ^ E.W) (hj : j < 2 ^ E.W)
    (hc : cap < 2 ^ E.W) (hprod : j * cap < 2 ^ E.W) (haddr : B + j * cap < 2 ^ E.W)
    (hm83 : s.mem 83 = B) (hm91 : s.mem 91 = j) (hm81 : s.mem 81 = cap) :
    runBlock queueReadPointerCode E s = boundaryState (s.pc + 30) (Function.update s.mem 99 (B + j * cap)) := by
  have hsmall : ∀ i ≤ 99, i % 2 ^ E.W = i := by intro i hi; exact Nat.mod_eq_of_lt (by omega)
  rw [queueReadPointerCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc queueReadPointerCode E s (by
      simp [queueReadPointerCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [queueReadPointerCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 30 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, runBlock_cons, runBlock_nil, execInstr,
      hsmall, hm83, hm91, hm81, Nat.mod_eq_of_lt hB, Nat.mod_eq_of_lt hj, Nat.mod_eq_of_lt hc,
      Nat.mod_eq_of_lt hprod, Nat.mod_eq_of_lt haddr, boundaryState]
  · intro _; rfl

theorem rootLevelTail_spec (E : RAMEnv) (s : RAMState) (j n : ℕ)
    (hmeta : (111 : ℕ) < 2 ^ E.W) (hj : j + 1 < 2 ^ E.W) (hn : n + 1 < 2 ^ E.W)
    (hm91 : s.mem 91 = j) (hm111 : s.mem 111 = n + 1) :
    runBlock rootLevelTailCode E s = rankState (s.pc + 51)
      (Function.update (Function.update s.mem 91 (j + 1)) 111 n) n := by
  rw [rootLevelTailCode, runBlock_append, incrementMeta_spec E s 91 j (by omega) hj hm91]
  have hcounter : (boundaryState (s.pc + 24) (Function.update s.mem 91 (j + 1))).mem 111 = n + 1 := by
    simp [boundaryState, hm111]
  rw [countdown_spec E _ 111 n hmeta hn hcounter] <;> rfl

/-- Appending one parent to the processed prefix appends its two children. -/
theorem splitFrontier_append {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (fs gs : List F[X]) :
    splitFrontier w a (fs ++ gs) = splitFrontier w a fs ++ splitFrontier w a gs := by
  induction fs with
  | nil => simp [splitFrontier]
  | cons f fs ih =>
      by_cases h : f.natDegree = 0 <;> simp [splitFrontier, h, ih, List.append_assoc]

theorem splitFrontier_snoc {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (fs : List F[X]) (f : F[X]) (hf : 0 < f.natDegree) :
    splitFrontier w a (fs ++ [f]) =
      (splitFrontier w a fs ++ keepFactor (EuclideanDomain.gcd f (traceRemainder a f w))) ++
        keepFactor (EuclideanDomain.gcd f (traceRemainder a f w - 1)) := by
  rw [splitFrontier_append]
  simp [splitFrontier, Nat.ne_of_gt hf, List.append_assoc]

theorem frontier_degree_le_mass {F : Type} [Field F] (fs : List F[X]) (f : F[X]) (hf : f ∈ fs) :
    f.natDegree ≤ frontierMass fs := by
  induction fs with
  | nil => simp at hf
  | cons g fs ih =>
      rcases List.mem_cons.mp hf with heq | hmem
      · subst g
        simp only [frontierMass]
        omega
      · have ht := ih hmem
        have hnonneg := Nat.zero_le g.natDegree
        simp only [frontierMass]
        omega

theorem frontier_prefix_budget {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (a : F) (fs done pending : List F[X]) (T : ℕ)
    (heq : fs = done ++ pending) (hpos : ∀ f ∈ fs, 0 < f.natDegree) (hmass : frontierMass fs ≤ T) :
    frontierMass (splitFrontier w a done) + frontierMass pending ≤ T := by
  have hdone : ∀ f ∈ done, f ≠ 0 := by
    intro f hf hz
    have hp := hpos f (by rw [heq]; exact List.mem_append.mpr (Or.inl hf))
    simp [hz] at hp
  have hs := splitFrontier_mass_le w a done hdone
  rw [heq, frontierMass_append] at hmass
  omega

theorem QueueWorkspaceSeparated.source_separated {R U D C TB ZB cap BQ T src : ℕ}
    (h : QueueWorkspaceSeparated R U D C TB ZB cap BQ T) (hlo : BQ ≤ src) (hhi : src + cap ≤ BQ + T * cap) :
    RootSourceSeparated R U D C TB cap src := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have hR := h.QR; omega
  · have hU := h.QU; omega
  · have hD := h.QD; omega
  · have hC := h.QC; omega
  · have hT := h.QT; omega

theorem old_queue_level_readonly {R U D C TB ZB cap BQ QB T : ℕ}
    (h : QueueWorkspaceSeparated R U D C TB ZB cap BQ T) (hBQ : 128 ≤ BQ)
    (hdisj : BQ + T * cap ≤ QB ∨ QB + T * cap ≤ BQ)
    (addr : ℕ) (hlo : BQ ≤ addr) (hhi : addr < BQ + T * cap) :
    ¬ rootLevelWritable R U D C TB cap QB T addr := by
  intro hbad
  rcases hbad with h91 | h99 | h111 | hnode
  · omega
  · omega
  · omega
  · rcases hnode with h90 | hwork | hnext
    · omega
    · exact h.readonly hBQ addr hlo hhi hwork
    · omega

theorem FrontierStored.of_level_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m m' : ℕ → ℕ}
    {R U D C TB ZB cap BQ QB T : ℕ} {fs : List F[X]}
    (h : FrontierStored b m BQ cap fs) (hsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ T)
    (hBQ : 128 ≤ BQ) (hdisj : BQ + T * cap ≤ QB ∨ QB + T * cap ≤ BQ) (hn : fs.length ≤ T)
    (hf : MemoryFrame (rootLevelWritable R U D C TB cap QB T) m m') : FrontierStored b m' BQ cap fs := by
  intro j hj
  apply (h j hj).of_frame hf
  intro i hi
  have hprod := Nat.zero_le (j * cap)
  exact old_queue_level_readonly hsep hBQ hdisj _ (by omega) (queue_slot_before_next BQ cap T j i (by omega) hi)

/-- Word bounds for the currently selected fixed-capacity queue slot. -/
theorem queue_slot_word_bounds (B cap T j W : ℕ) (hB : 128 ≤ B) (hc : 1 ≤ cap)
    (hj : j < T) (hword : B + T * cap ≤ 2 ^ W) :
    B + j * cap + cap ≤ 2 ^ W ∧ B + j * cap < 2 ^ W ∧ j * cap < 2 ^ W ∧ j < 2 ^ W ∧ cap < 2 ^ W := by
  have hm : (j + 1) * cap ≤ T * cap := Nat.mul_le_mul_right cap (by omega)
  have he : (j + 1) * cap = j * cap + cap := by ring
  have hjprod : j ≤ j * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left j hc
  have hprod := Nat.zero_le (j * cap)
  omega

theorem rootLevelBody_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L BQ QB : ℕ) (a : F) (fs done pending : List F[X]) (f : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootLevelBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQword : BQ + t * cap ≤ 2 ^ E.W) (hQBword : QB + t * cap ≤ 2 ^ E.W)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t)
    (hdisj : BQ + t * cap ≤ QB ∨ QB + t * cap ≤ BQ) (hmeta : (111 : ℕ) < 2 ^ E.W)
    (hfs : fs = done ++ (f :: pending)) (hpos : ∀ g ∈ fs, 0 < g.natDegree) (hmass : frontierMass fs ≤ t)
    (hv : RootLevelView b R U D C TB ZB cap L BQ QB a fs done (f :: pending) m) :
    Sem P E pc (pc + 3141) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ rootNodeBudget cap L w + 81 ∧ ∃ m', z = rankState (pc + 3141) m' pending.length ∧
        RootLevelView b R U D C TB ZB cap L BQ QB a fs (done ++ [f]) pending m' ∧
        MemoryFrame (rootLevelWritable R U D C TB cap QB t) m m') := by
  have hlen := frontier_length_le_mass fs hpos
  have hfmem : f ∈ fs := by rw [hfs]; simp
  have hfpos := hpos f hfmem
  have hfdeg : f.natDegree ≤ t := le_trans (frontier_degree_le_mass fs f hfmem) hmass
  have hbudget := frontier_prefix_budget w a fs done (f :: pending) t hfs hpos hmass
  have hnodeBudget : frontierMass (splitFrontier w a done) + f.natDegree ≤ t := by
    simp only [frontierMass] at hbudget
    omega
  have hj : done.length < t := by
    have he : fs.length = done.length + (pending.length + 1) := by simp [hfs]
    omega
  have hcapPos : 1 ≤ cap := by omega
  have hslot := queue_slot_word_bounds BQ cap t done.length E.W hBQ hcapPos hj hBQword
  have hn : pending.length + 1 < 2 ^ E.W := by
    have he : fs.length = done.length + (pending.length + 1) := by simp [hfs]
    have htw : t < 2 ^ E.W := by
      have hm : t ≤ t * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left t hcapPos
      omega
    omega
  have hjword : done.length + 1 < 2 ^ E.W := by
    have hm : t ≤ t * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left t hcapPos
    omega
  let src := BQ + done.length * cap
  let m1 := Function.update m 99 src
  have hf01 : MemoryFrame (rootLevelWritable R U D C TB cap QB t) m m1 :=
    MemoryFrame.update_allowed _ m 99 src (Or.inr (Or.inl rfl))
  have henv1 := hv.environment.of_level_frame hl hQB hQBsep.QZ hf01
  have hfactor : PolynomialStored b m1 src cap f := by
    have hjfs : done.length < fs.length := by simp [hfs]
    have hg := hv.oldQueue done.length hjfs
    have he : fs.getD done.length 0 = f := by
      rw [hfs, List.getD_append_right done (f :: pending) 0 done.length le_rfl, Nat.sub_self]
      rfl
    rw [he] at hg
    exact hg.meta_update (by omega) 99 src (by norm_num)
  have hp1 := henv1.persistent src f (by simp [m1]) hfactor
  have hsrcEnd : src + cap ≤ BQ + t * cap := by
    have hm := Nat.mul_le_mul_right cap (show done.length + 1 ≤ t by omega)
    have he : (done.length + 1) * cap = done.length * cap + cap := by ring
    dsimp [src]
    omega
  have hsource' := hBQsep.source_separated (show BQ ≤ src by dsimp [src]; omega) hsrcEnd
  have hsrcQ : src + cap ≤ QB ∨ QB + t * cap ≤ src := by
    have hstart : BQ ≤ src := by dsimp [src]; omega
    omega
  obtain ⟨hPointerAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hNodeAt, hTailAt⟩ := At.seqStmt hRestAt
  have hPointer : Sem P E pc (pc + 30) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ 30 ∧ z = boundaryState (pc + 30) m1) := by
    refine Sem.mono (Sem.block P E pc queueReadPointerCode _ hPointerAt
      (by simp [queueReadPointerCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 30 := hQ.1
    refine ⟨by omega, ?_⟩
    exact hQ.2.trans (queueReadPointer_spec E _ BQ done.length cap (by omega) (by omega)
      hslot.2.2.2.1 hslot.2.2.2.2 hslot.2.2.1 hslot.2.1 hv.oldBase hv.index hv.environment.capacity)
  have hNode := rootNodeProcedure_spec b ι t N P E (pc + 30) R U D C TB ZB cap L src QB t f a
    (splitFrontier w a done) m1 hNodeAt hw hW hdet ht hL hcap hl hwords hp1
    (by dsimp [src]; omega) hslot.1 hsource' hQB hQBword hQBsep hsrcQ (by omega) hfpos hfdeg
    (hv.newQueue.meta_update hQB 99 src (by norm_num)) (splitFrontier_positive w a done) hnodeBudget
    (by simpa [m1] using hv.newBase) (by simpa [m1] using hv.newCount)
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, m2, hz2, hp2, hCount2, hQueue2, hf12raw⟩ := hNode
  have hf12 : MemoryFrame (rootLevelWritable R U D C TB cap QB t) m1 m2 :=
    hf12raw.mono (fun _ ha => Or.inr (Or.inr (Or.inr ha)))
  have hf02 := MemoryFrame.trans hf01 hf12
  have hmeta2 (slot : ℕ) (hs : slot < 128) (hn : ¬ rootNodeMeta slot) : m2 slot = m1 slot :=
    hf12raw slot (hl.meta_readonly hQB slot hs hn)
  have h91 : m2 91 = done.length := by
    rw [hmeta2 91 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])]
    simpa [m1] using hv.index
  have h111 : m2 111 = pending.length + 1 := by
    rw [hmeta2 111 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])]
    simpa [m1] using hv.remaining
  let m3 := Function.update (Function.update m2 91 (done.length + 1)) 111 pending.length
  have hf23 : MemoryFrame (rootLevelWritable R U D C TB cap QB t) m2 m3 :=
    MemoryFrame.trans (MemoryFrame.update_allowed _ m2 91 (done.length + 1) (Or.inl rfl))
      (MemoryFrame.update_allowed _ _ 111 pending.length (Or.inr (Or.inr (Or.inl rfl))))
  have hf03 := MemoryFrame.trans hf02 hf23
  have hnew3 : FrontierStored b m3 QB cap (splitFrontier w a (done ++ [f])) := by
    rw [splitFrontier_snoc w a done f hfpos]
    exact (hQueue2.meta_update hQB 91 (done.length + 1) (by norm_num)).meta_update hQB 111 pending.length (by norm_num)
  have hfixed (slot : ℕ) (hs : slot < 128) (hn : ¬ rootLevelMeta slot) : m3 slot = m slot :=
    hf03 slot (hl.level_meta_readonly hQB slot hs hn)
  have hv3 : RootLevelView b R U D C TB ZB cap L BQ QB a fs (done ++ [f]) pending m3 := by
    refine ⟨hv.environment.of_level_frame hl hQB hQBsep.QZ hf03,
      hv.oldQueue.of_level_frame hBQsep hBQ hdisj (by omega) hf03, hnew3, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact (hfixed 83 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans hv.oldBase
    · exact (hfixed 84 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans hv.newBase
    · exact (hfixed 89 (by norm_num) (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta])).trans hv.oldCount
    · simpa [m3, splitFrontier_snoc w a done f hfpos] using hCount2
    · simp [m3]
    · simp [m3]
  have hNodeExact : Sem P E (pc + 30) (pc + 3090) (boundaryState (pc + 30) m1)
      (fun k z => k ≤ rootNodeBudget cap L w ∧ z = boundaryState (pc + 3090) m2) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hTail : Sem P E (pc + 3090) (pc + 3141) (boundaryState (pc + 3090) m2)
      (fun k z => k ≤ 51 ∧ z = rankState (pc + 3141) m3 pending.length) := by
    refine Sem.mono (Sem.block P E _ rootLevelTailCode _ hTailAt
      (by simp [rootLevelTailCode, incrementMetaCode, countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 51 := hQ.1
    exact ⟨by omega, hQ.2.trans (rootLevelTail_spec E _ done.length pending.length hmeta hjword hn h91 h111)⟩
  have hFull := Sem.seq_bound hPointer (fun z _ hz => by
    subst z
    exact Sem.seq_bound hNodeExact (fun z _ hz => by subst z; exact hTail))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, m3, hQ.2, hv3, hf03⟩)

theorem rootLevelLoop_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L BQ QB : ℕ) (a : F) (fs : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootLevelLoop pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQword : BQ + t * cap ≤ 2 ^ E.W) (hQBword : QB + t * cap ≤ 2 ^ E.W)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t)
    (hdisj : BQ + t * cap ≤ QB ∨ QB + t * cap ≤ BQ) (hmeta : (111 : ℕ) < 2 ^ E.W)
    (hpos : ∀ f ∈ fs, 0 < f.natDegree) (hmass : frontierMass fs ≤ t)
    (hv : RootLevelView b R U D C TB ZB cap L BQ QB a fs [] fs m) :
    Sem P E pc (pc + 3143) (rankState pc m fs.length)
      (fun k z => k ≤ (rootNodeBudget cap L w + 83) * fs.length + 1 ∧ z.regs = (fun _ => 0) ∧
        RootLevelView b R U D C TB ZB cap L BQ QB a fs fs [] z.mem ∧
        MemoryFrame (rootLevelWritable R U D C TB cap QB t) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ fs.length ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    ∃ done pending, fs = done ++ pending ∧ pending.length = n ∧
      RootLevelView b R U D C TB ZB cap L BQ QB a fs done pending z.mem ∧
      MemoryFrame (rootLevelWritable R U D C TB cap QB t) m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by
    intro n z pc' h
    simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by
    intro n z h
    rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 }
        (fun k z' => k ≤ rootNodeBudget cap L w + 82 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, done, pending, heq, hrem, hvz, hf⟩ := hI
    cases pending with
    | nil => simp at hrem
    | cons f pending =>
      have heN : n = pending.length := by simp only [List.length_cons] at hrem; omega
      subst n
      have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (pending.length + 1) := by
        apply ramState_eq_of
        · rfl
        · rfl
        · intro r; exact congrFun hregs r
      rw [hz]
      have hrun := rootLevelBody_spec b ι t N P E (pc + 1) R U D C TB ZB cap L BQ QB a fs done pending f z.mem
        hBodyAt hw hW hdet ht hL hcap hl hwords hBQ hQB hBQword hQBword hBQsep hQBsep hdisj hmeta heq hpos hmass hvz
      refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
      intro k z' hQ
      obtain ⟨hk, m', hz', hv', hf'⟩ := hQ
      refine ⟨by omega, by omega, ?_⟩
      rw [hz']
      refine ⟨rfl, done ++ [f], pending, ?_, rfl, hv', MemoryFrame.trans hf hf'⟩
      simpa only [List.append_assoc, List.singleton_append] using heq
  have hinit : I fs.length (rankState pc m fs.length) := by
    refine ⟨le_rfl, rfl, [], fs, by simp, rfl, hv, ?_⟩
    intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc rootLevelBody hAt (by omega) I
    (rootNodeBudget cap L w + 82) hframe hcounter hbody fs.length (rankState pc m fs.length) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, done, pending, heq, hrem, hvz, hf⟩ := hQ
  have hp : pending = [] := by
    cases pending with
    | nil => rfl
    | cons f pending => simp at hrem
  subst pending
  have hd : done = fs := by simpa using heq.symm
  subst done
  refine ⟨hk, ?_, hvz, hf⟩
  rw [hregs]
  funext r
  simp [Function.update_apply]

theorem rootLevelProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L BQ QB : ℕ) (a : F) (fs : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootLevelProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQword : BQ + t * cap ≤ 2 ^ E.W) (hQBword : QB + t * cap ≤ 2 ^ E.W)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t)
    (hdisj : BQ + t * cap ≤ QB ∨ QB + t * cap ≤ BQ) (hmeta : (111 : ℕ) < 2 ^ E.W)
    (hpos : ∀ f ∈ fs, 0 < f.natDegree) (hmass : frontierMass fs ≤ t)
    (hv : RootLevelView b R U D C TB ZB cap L BQ QB a fs [] fs m) :
    Sem P E pc (pc + 3146) (boundaryState pc m)
      (fun k z => k ≤ (rootNodeBudget cap L w + 83) * fs.length + 4 ∧ ∃ m',
        z = boundaryState (pc + 3146) m' ∧ RootLevelView b R U D C TB ZB cap L BQ QB a fs fs [] m' ∧
        MemoryFrame (rootLevelWritable R U D C TB cap QB t) m m') := by
  have hlen := frontier_length_le_mass fs hpos
  have hc : 1 ≤ cap := by omega
  have hmul : t ≤ t * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left t hc
  have hn : fs.length < 2 ^ E.W := by omega
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m fs.length) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 111) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 3 := hQ.1
    exact ⟨by omega, hQ.2.trans (rankReadSlot_spec E pc m 111 fs.length hmeta hn hv.remaining)⟩
  have hLoop := rootLevelLoop_spec b ι t N P E (pc + 3) R U D C TB ZB cap L BQ QB a fs m hLoopAt
    hw hW hdet ht hL hcap hl hwords hBQ hQB hBQword hQBword hBQsep hQBsep hdisj hmeta hpos hmass hv
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, hvz, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, hvz, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r; exact congrFun hregs r

theorem RootEnvironment.constants {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L : ℕ} {a : F} {m : ℕ → ℕ}
    (h : RootEnvironment b R U D C TB ZB cap L a m) : RootConstants b R U D C TB ZB cap L m :=
