section
-- Source module: ThreeSumApsp.Pruned.RegimeP
@[expose] public section

open ThreeSumApsp

namespace Light.Sec4

open ThreeSumApsp.Spec

theorem levelsOf_22 (m : ℕ) : levelsOf 22 m = ratParamsP.L m := by
  have h := levelsOf_div 22 m (b := 1) le_rfl
  rw [show ((22 : ℕ) : ℝ) / ((1 : ℕ) : ℝ) = 22 by norm_num] at h
  rw [h]
  rfl

theorem switchOf_29_250 (m : ℕ) : switchOf (29 / 250) m = ratParamsP.t m := by
  have h := switchOf_div 29 m (q := 250) (by norm_num)
  rw [show ((29 : ℕ) : ℝ) / ((250 : ℕ) : ℝ) = 29 / 250 by norm_num] at h
  rw [h]
  rfl

section bounds

variable {N D₀ : ℕ}

/-- `D^91 ≤ N^5` gives `D ≤ N^{5/91}`. -/
theorem le_rpow_of_pow_le (h : D₀ ^ 91 ≤ N ^ 5) : (D₀ : ℝ) ≤ (N : ℝ) ^ (5 / 91 : ℝ) := by
  have h' : (D₀ : ℝ) ^ 91 ≤ (N : ℝ) ^ 5 := by exact_mod_cast h
  have h2 := Real.rpow_le_rpow (by positivity) h' (by norm_num : (0 : ℝ) ≤ ((91 : ℕ) : ℝ)⁻¹)
  rw [Real.pow_rpow_inv_natCast (by positivity) (by norm_num), ← Real.rpow_natCast (N : ℝ) 5,
    ← Real.rpow_mul (by positivity)] at h2
  convert h2 using 2
  norm_num

/-- `D^91 ≤ N^5` gives `D ≤ N`. -/
theorem le_of_pow_le (h : D₀ ^ 91 ≤ N ^ 5) : D₀ ≤ N := by
  rcases Nat.eq_zero_or_pos D₀ with rfl | hD
  · exact Nat.zero_le _
  have h5 : D₀ ^ 5 ≤ N ^ 5 := (Nat.pow_le_pow_right hD (by norm_num)).trans h
  exact (Nat.pow_le_pow_iff_left (by norm_num)).1 h5

theorem one_le_of_pow_le (hD : 1 ≤ D₀) (h : D₀ ^ 91 ≤ N ^ 5) : 1 ≤ N :=
  hD.trans (le_of_pow_le h)

theorem one_le_preBoundP (hD : 1 ≤ D₀) (h : D₀ ^ 91 ≤ N ^ 5) : 1 ≤ preBoundP N D₀ := by
  have hDR : (1 : ℝ) ≤ D₀ := by exact_mod_cast hD
  have hDN : (D₀ : ℝ) ≤ N := by exact_mod_cast le_of_pow_le h
  have hlog := Real.log_nonneg hDR
  unfold preBoundP
  rw [le_div_iff₀ (Real.rpow_pos_of_pos (by linarith) _), one_mul]
  have h1 : (D₀ : ℝ) ^ (0.07618 : ℝ) ≤ D₀ := by
    calc (D₀ : ℝ) ^ (0.07618 : ℝ) ≤ (D₀ : ℝ) ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hDR (by norm_num)
      _ = D₀ := Real.rpow_one _
  have h2 : (N : ℝ) ≤ (N : ℝ) ^ 2 := by nlinarith
  have h3 : (1 : ℝ) ≤ (Real.log D₀ + 1) ^ 2 := one_le_pow₀ (by linarith)
  have h4 : (N : ℝ) ^ 2 ≤ (N : ℝ) ^ 2 * (Real.log D₀ + 1) ^ 2 :=
    le_mul_of_one_le_right (by positivity) h3
  linarith

theorem one_le_queryBoundP (hD : 1 ≤ D₀) : 1 ≤ queryBoundP D₀ := by
  have hDR : (1 : ℝ) ≤ D₀ := by exact_mod_cast hD
  have hlog := Real.log_nonneg hDR
  exact one_le_mul_of_one_le_of_one_le (Real.one_le_rpow hDR (by norm_num)) (by linarith)

theorem le_preBoundP {γ : ℝ} (hD : 1 ≤ D₀) (hγ : 0.07618 ≤ γ) :
    (N : ℝ) ^ 2 * Real.log (D₀ : ℝ) ^ 2 / (D₀ : ℝ) ^ γ ≤ preBoundP N D₀ := by
  have hDR : (1 : ℝ) ≤ D₀ := by exact_mod_cast hD
  have hlog := Real.log_nonneg hDR
  have hsq : Real.log (D₀ : ℝ) ^ 2 ≤ (Real.log D₀ + 1) ^ 2 := pow_le_pow_left₀ hlog (by linarith) 2
  exact div_le_div₀ (by positivity) (mul_le_mul_of_nonneg_left hsq (by positivity))
    (Real.rpow_pos_of_pos (by linarith) _) (Real.rpow_le_rpow_of_exponent_le hDR hγ)

theorem le_queryBoundP {q : ℝ} (hD : 1 ≤ D₀) (hq : q ≤ 0.44274) :
    (D₀ : ℝ) ^ q * Real.log (D₀ : ℝ) ≤ queryBoundP D₀ := by
  have hDR : (1 : ℝ) ≤ D₀ := by exact_mod_cast hD
  have hlog := Real.log_nonneg hDR
  exact mul_le_mul (Real.rpow_le_rpow_of_exponent_le hDR hq) (by linarith) hlog (by positivity)

end bounds

/-- **The regime `D^91 ≤ N^5`.** There is a constant with which, on these inputs, the two bounds
dominate the pruned cost of the preprocessing and the cost of a query of Theorem 30 at `L = 22 m`
and `t = ⌈29 m/250⌉` from the threshold on. -/
theorem regimeP : ∃ C : ℝ, 0 ≤ C ∧ ∀ N D₀ : ℕ, 1 ≤ D₀ → D₀ ^ 91 ≤ N ^ 5 →
    CostsWithinP ratParamsP C N D₀ (preBoundP N D₀) (queryBoundP D₀) := by
  obtain ⟨hC, hcost⟩ := Classical.choose_spec (Classical.choose_spec
    (CorollaryP.costs admissibleP_5_91))
  refine ⟨costsPC, hC, fun N D₀ hD hN => ⟨one_le_of_pow_le hD hN, hD, le_of_pow_le hN,
    one_le_preBoundP hD hN, one_le_queryBoundP hD, fun hm => ?_⟩⟩
  have hm' : max costsPm 1 ≤ logFour D₀ := hm
  have hm1 : 1 ≤ logFour D₀ := le_trans (le_max_right _ _) hm'
  obtain ⟨hfit, hpre, hquery⟩ := hcost D₀ N (logFour D₀) (two_le_of_clog hm1)
    (le_rpow_of_pow_le hN) (ceil_logb_four D₀).symm (le_trans (le_max_left _ _) hm')
  rw [levelsOf_22] at hfit hpre hquery
  rw [switchOf_29_250] at hpre hquery
  exact ⟨⟨hm1, RatParams.ten_le_L _ _, RatParams.t_le _ _, hfit⟩,
    hpre.trans (mul_le_mul_of_nonneg_left (le_preBoundP hD GammaOf_22.le) hC),
    hquery.trans (mul_le_mul_of_nonneg_left (le_queryBoundP hD qOf_29_250.le) hC)⟩

end Light.Sec4
end
end

