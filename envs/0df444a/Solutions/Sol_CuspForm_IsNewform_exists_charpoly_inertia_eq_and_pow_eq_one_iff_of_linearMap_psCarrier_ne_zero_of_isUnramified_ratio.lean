    have h2 : (μ₁ u)⁻¹ * μ₂ u = 1 := by rw [← MonoidHom.inv_apply, ← MonoidHom.mul_apply]; exact hratio u hu1
    have h3 : μ₂ u = μ₁ u := by rwa [inv_mul_eq_one, eq_comm] at h2
    rw [h3] at h1
    have h4 : (μ₁ u : ℂ) * (μ₁ u : ℂ) = 1 := by rw [← Units.val_mul, h1, Units.val_one]
    rcases mul_self_eq_one_iff.mp h4 with h5 | h5
    · exact Or.inl (Units.ext h5)
    · exact Or.inr (Units.ext (by rw [h5, Units.val_neg, Units.val_one]))
