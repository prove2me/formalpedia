-- title:
--   Two simple subfields of coprime relative degrees generate the whole field
-- statement:
--   Let $K⊆F$ be fields and let $u,v∈F$. Assume $F$ is finite-dimensional over both $K(u)$ and $K(v)$, and assume the two degrees are coprime:
--
--   $$gcd\bigl([F:K(u)],[F:K(v)]\bigr)=1.$$
--
--   Then the intermediate field generated by both elements is all of $F$:
--
--   $$K(u,v)=F.$$
--
--   This is the field-theoretic mechanism turning the special-unit degrees four and seven into full generation.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Mathlib

set_option autoImplicit false

theorem N25.Endgame.adjoin_pair_eq_top_of_coprime_finrank
    {K F : Type*} [Field K] [Field F] [Algebra K F]
    (u v : F)
    [FiniteDimensional (IntermediateField.adjoin K ({u} : Set F)) F]
    [FiniteDimensional (IntermediateField.adjoin K ({v} : Set F)) F]
    (hcop :
      Nat.Coprime
        (Module.finrank (IntermediateField.adjoin K ({u} : Set F)) F)
        (Module.finrank (IntermediateField.adjoin K ({v} : Set F)) F)) :
    IntermediateField.adjoin K ({u, v} : Set F) = ⊤ := by sorry
