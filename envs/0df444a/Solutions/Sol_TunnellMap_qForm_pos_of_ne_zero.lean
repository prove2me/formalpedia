set_option autoImplicit true
open TunnellMap
namespace TunnellMap
theorem _root_.solution {p : Triple} (hp : p ≠ ⟨0, 0, 0⟩) : 0 < qForm p := by
  by_cases hx : p.x = 0
  · by_cases hy : p.y = 0
    · have hz : p.z ≠ 0 := by
        intro hz
        apply hp
        ext <;> simp_all
      have hzsq : 0 < p.z ^ 2 := sq_pos_of_ne_zero hz
      simp [qForm, hx, hy]
      omega
    · have hysq : 0 < p.y ^ 2 := sq_pos_of_ne_zero hy
      have hzsq : 0 ≤ p.z ^ 2 := sq_nonneg p.z
      simp [qForm, hx]
      nlinarith
  · have hxsq : 0 < p.x ^ 2 := sq_pos_of_ne_zero hx
    have hysq : 0 ≤ p.y ^ 2 := sq_nonneg p.y
    have hzsq : 0 ≤ p.z ^ 2 := sq_nonneg p.z
    simp [qForm]
    nlinarith
end TunnellMap
