theorem mem_nodes_iff_mem_range_xt {q : ℕ} [Fact q.Prime] {M' : ℕ} [NeZero M'] {A : ValuationSubring (AlgebraicClosure ℚ)}
    {W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M'))}
    (𝒞 : SemistableCovering q M' A W) (s : ↥W) (Q : Place (ResidueField A) (𝒞.FSS s)) :
    Q ∈ (𝒞.CSS s).nodes ↔ Q ∈ Set.range (fun ℓ => 𝒞.xt ℓ s) := by
  constructor
  · intro hQ
    obtain ⟨ℓ, hℓ, -⟩ := 𝒞.existsUnique_xt_eq s Q hQ
    exact ⟨ℓ, hℓ⟩
  · rintro ⟨ℓ, rfl⟩
    exact (𝒞.isAttached ℓ s).2.1

