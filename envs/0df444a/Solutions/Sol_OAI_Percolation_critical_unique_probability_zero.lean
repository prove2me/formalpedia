section
-- module Solutions.OAIQ040_CM.UnimodularPercolation_Criticality_Connectivity
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Critical connection probabilities and nonamenable growth. -/

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace Percolation
open MeasureTheory Filter
open scoped Topology
universe u v
variable {V : Type u} {E : Type v}

theorem connectivity_twoPoint_mul_le [Countable E] (G : BondGraph V E) (p : unitInterval)
    (x y z : V) : twoPoint G p x y * twoPoint G p y z ≤ twoPoint G p x z := by
  have h := association_finiteWitness p {ω | Conn G ω x y} {ω | Conn G ω y z}
    (fun _ _ hst hxy => conn_mono G hst hxy)
    (fun _ _ hst hyz => conn_mono G hst hyz)
    (finiteWitness_conn G x y) (finiteWitness_conn G y z)
  refine h.trans (measureReal_mono ?_)
  intro ω hω
  exact conn_trans G ω hω.1 hω.2

theorem reachBall_split (G : BondGraph V E) (x z : V) (n m : ℕ)
    (hz : z ∈ reachBall G x (n+m)) :
    ∃ y ∈ reachBall G x n, z ∈ reachBall G y m := by
  induction m generalizing z with
  | zero =>
      exact ⟨z,by simpa using hz,by simp [reachBall]⟩
  | succ m ih =>
      change z ∈ reachBall G x (n+m) ∪ _ at hz
      rcases hz with hz | hz
      · obtain ⟨y,hy,hyz⟩ := ih z hz
        exact ⟨y,hy,Or.inl hyz⟩
      · simp only [Set.mem_iUnion,Set.mem_ofPred_eq] at hz
        obtain ⟨z',hz',hzz⟩ := hz
        obtain ⟨y,hy,hyz⟩ := ih z' hz'
        refine ⟨y,hy,Or.inr ?_⟩
        simp only [Set.mem_iUnion,Set.mem_ofPred_eq]
        exact ⟨z',hyz,hzz⟩

theorem twoPoint_block_lower [Countable E] (G : BondGraph V E) (p : unitInterval)
    (n : ℕ) (c : ℝ) (hc : 0 ≤ c)
    (h : ∀ x y, y ∈ reachBall G x n → c ≤ twoPoint G p x y)
    (m : ℕ) (x y : V) (hy : y ∈ reachBall G x (n*m)) :
    c^m ≤ twoPoint G p x y := by
  induction m generalizing x y with
  | zero =>
      simp only [mul_zero,reachBall,Set.mem_singleton_iff] at hy
      subst y
      simp [twoPoint_self]
  | succ m ih =>
      rw [Nat.mul_succ] at hy
      obtain ⟨z,hz,hzy⟩ := reachBall_split G x y (n*m) n hy
      calc
        c^(m+1) = c^m*c := pow_succ _ _
        _ ≤ twoPoint G p x z * twoPoint G p z y :=
          mul_le_mul (ih x z hz) (h z y hzy) hc (twoPoint_nonneg G p x z)
        _ ≤ twoPoint G p x y := connectivity_twoPoint_mul_le G p x z y

theorem isoperimetric_ball_growth (G : BondGraph V E) (hloc : LocallyFinite G)
    (hh : 0 < hV G) (x : V) (n : ℕ) :
    (1+hV G)^n ≤ ((reachBall G x n).ncard : ℝ) := by
  classical
  induction n with
  | zero => simp [reachBall]
  | succ n ih =>
      let B := (finite_reachBall hloc x n).toFinset
      have heq : reachBall G x (n+1) = reachBall G x n ∪ vertexBoundary G B := by
        ext y
        simp only [reachBall,Set.mem_union,Set.mem_iUnion,Set.mem_ofPred_eq,vertexBoundary]
        constructor
        · rintro (hy | ⟨z,hz,hzy⟩)
          · exact Or.inl hy
          · by_cases hy : y ∈ reachBall G x n
            · exact Or.inl hy
            · exact Or.inr ⟨by simpa [B] using hy,z,by simpa [B] using hz,hzy⟩
        · rintro (hy | ⟨_,z,hz,hzy⟩)
          · exact Or.inl hy
          · exact Or.inr ⟨z,by simpa [B] using hz,hzy⟩
      have hd : Disjoint (reachBall G x n) (vertexBoundary G B) := by
        apply Set.disjoint_left.mpr
        intro y hy hb
        exact hb.1 (by simpa [B] using hy)
      have hb := hV_mul_card_le G B
      have hcard : B.card = (reachBall G x n).ncard :=
        (Set.ncard_eq_toFinset_card _ _).symm
      rw [hcard] at hb
      rw [heq,Set.ncard_union_eq hd (finite_reachBall hloc x n)
        (finite_vertexBoundary G hloc B),Nat.cast_add,pow_succ]
      have hh0 : 0 ≤ 1+hV G := by linarith
      nlinarith [mul_le_mul_of_nonneg_right ih hh0]

theorem subcritical_block_bound [Countable V] [Countable E] [Nonempty V]
    (G : BondGraph V E) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (hh : 0 < hV G) (p : unitInterval) (hp : p < pc G)
    (n : ℕ) (c : ℝ) (hc : 0 ≤ c)
    (h : ∀ x y, y ∈ reachBall G x n → c ≤ twoPoint G p x y) :
    (1+hV G)^n*c ≤ 1 := by
  classical
  by_contra hbad
  have hgt : 1 < (1+hV G)^n*c := lt_of_not_ge hbad
  let x : V := Classical.arbitrary V
  have hbound (m : ℕ) : ((1+hV G)^n*c)^m ≤ susceptibility G p x := by
    let B := (finite_reachBall hloc x (n*m)).toFinset
    calc
      ((1+hV G)^n*c)^m = (1+hV G)^(n*m)*c^m := by rw [mul_pow,pow_mul]
      _ ≤ (B.card:ℝ)*c^m := by
        simpa only [B, ← Set.ncard_eq_toFinset_card] using mul_le_mul_of_nonneg_right
          (isoperimetric_ball_growth G hloc hh x (n*m)) (pow_nonneg hc m)
      _ = ∑ y ∈ B, c^m := by simp
      _ ≤ ∑ y ∈ B, twoPoint G p x y := by
        apply Finset.sum_le_sum
        intro y hy
        exact twoPoint_block_lower G p n c hc h m x y (by simpa [B] using hy)
      _ ≤ susceptibility G p x :=
        (summable_twoPoint_subcritical G hloc hqt p hp x).sum_le_tsum B
          (fun y _ => twoPoint_nonneg G p x y)
  obtain ⟨m,hm⟩ := pow_unbounded_of_one_lt (susceptibility G p x) hgt
  exact (not_lt_of_ge (hbound m)) hm

theorem uniform_ball_lower_below [Countable V] [Countable E]
    (G : BondGraph V E) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (q : unitInterval) (hq : 0 < q) (n : ℕ) (a c : ℝ) (hac : a < c)
    (h : ∀ x y, c ≤ twoPoint G q x y) :
    ∃ p : unitInterval, p < q ∧ ∀ x y, y ∈ reachBall G x n → a < twoPoint G p x y := by
  classical
  obtain ⟨R,hR⟩ := hqt
  obtain ⟨ps,hps,hpsq,ht⟩ := exists_seq_strictMono_tendsto' hq
  have hev : ∀ᶠ k in atTop, ∀ o ∈ R, ∀ y ∈ reachBall G o n,
      a < twoPoint G (ps k) o y := by
    apply (eventually_all_finset R).mpr
    intro o _
    apply (eventually_all_finite (finite_reachBall hloc o n)).mpr
    intro y _
    exact (twoPoint_tendsto_of_monotone G ps hps.monotone q
      (fun k => (hpsq k).2.le) ht o y).eventually (eventually_gt_nhds (hac.trans_le (h o y)))
  obtain ⟨k,hk⟩ := hev.exists
  refine ⟨ps k,(hpsq k).2,?_⟩
  intro x y hy
  obtain ⟨o,ho,g,b,hg,hgx⟩ := hR x
  have hy' : g.symm y ∈ reachBall G o n := by
    apply (mem_reachBall_aut_iff G hg o (g.symm y) n).mp
    simpa only [g.apply_symm_apply,hgx] using hy
  have hb := hk o ho (g.symm y) hy'
  have he := twoPoint_aut G (ps k) hg o (g.symm y)
  rw [g.apply_symm_apply,hgx] at he
  rwa [he]

theorem critical_twoPoint_no_uniform_positive [Countable V] [Countable E] [Nonempty V]
    (G : BondGraph V E) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (hh : 0 < hV G) (c : ℝ) (hc : 0 < c) :
    ¬ (∀ x y, c ≤ twoPoint G (pc G) x y) := by
  intro h
  have ha : 0 < c/2 := by positivity
  obtain ⟨n,hn⟩ := pow_unbounded_of_one_lt (1/(c/2)) (show 1 < 1+hV G by linarith)
  obtain ⟨p,hp,hball⟩ := uniform_ball_lower_below G hloc hqt (pc G)
    (pc_pos G hloc hqt) n (c/2) c (by linarith) h
  have hb := subcritical_block_bound G hloc hqt hh p hp n (c/2) ha.le
    (fun x y hy => (hball x y hy).le)
  exact (not_lt_of_ge hb) ((div_lt_iff₀ ha).mp hn)

theorem critical_not_ae_unique [Infinite V] (G : BondGraph V E)
    (hconn : Connected G) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (hh : 0 < hV G) :
    law (pc G) {ω | ∃! C, C ∈ infiniteClusters G ω} ≠ 1 := by
  classical
  let : Countable V := countable_vertices hloc hconn
  let : Countable E := countable_edges hloc
  intro hu
  have hpos : 0 < law (pc G) {ω | (infiniteClusters G ω).Nonempty} := by
    exact lt_of_lt_of_le (show 0 < law (pc G) {ω | ∃! C, C ∈ infiniteClusters G ω} by
      rw [hu]; exact zero_lt_one)
      (measure_mono fun ω hω => ⟨hω.choose,hω.choose_spec.1⟩)
  obtain ⟨θ,hθ,hroot⟩ := uniform_survival_pos G hconn hqt (pc G) (pc_pos G hloc hqt) hpos
  have hue : ∀ᵐ ω ∂law (pc G), ∃! C, C ∈ infiniteClusters G ω :=
    (mem_ae_iff_prob_eq_one (measurableSet_unique_infinite_cluster G)).mpr hu
  apply critical_twoPoint_no_uniform_positive G hloc hqt hh (θ*θ) (mul_pos hθ hθ)
  intro x y
  refine (mul_le_mul (hroot x) (hroot y) hθ.le measureReal_nonneg).trans
    ((association_infinite_cluster G (pc G) x y).trans ?_)
  apply ENNReal.toReal_mono (measure_ne_top _ _)
  apply measure_mono_ae
  filter_upwards [hue] with ω hω
  intro hi
  obtain ⟨r,_,hr⟩ := (unique_infinite_cluster_iff G ω).mp hω
  exact conn_trans G ω (conn_symm G ω (hr x hi.1)) (hr y hi.2)

end Percolation

end OAI
end

section
-- module Solutions.OAIQ040_CM.UnimodularPercolation_Criticality_Ergodicity
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Zero-one laws for invariant Bernoulli events. -/

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace Percolation
open MeasureTheory ProbabilityTheory
open scoped ENNReal symmDiff
universe u v
variable {V : Type u} {E : Type v}
attribute [local instance] Classical.propDecidable Classical.decEq

theorem exists_aut_disjoint_edges [Infinite V] (G : BondGraph V E)
    (hconn : Connected G) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (F : Finset E) : ∃ a : V ≃ V, ∃ b : E ≃ E, IsAut G a b ∧ Disjoint F (F.image b) := by
  classical
  let B : Finset V := F.biUnion (fun e => (G e).toFinset)
  let x : V := Classical.arbitrary V
  obtain ⟨n,hn⟩ := exists_transportCut G hconn x B
  have hfin : (⋃ z ∈ (B : Set V), reachBall G z n).Finite :=
    B.finite_toSet.biUnion (fun z _ => finite_reachBall hloc z n)
  obtain ⟨y,⟨a,b,hab,hax⟩,hy⟩ :=
    (vertexOrbit_infinite G hconn hloc hqt x).exists_notMem_finite hfin
  refine ⟨a,b,hab,Finset.disjoint_left.mpr ?_⟩
  intro e he heb
  obtain ⟨e',he',rfl⟩ := Finset.mem_image.mp heb
  have hm : ∃ z, z ∈ G e' := Sym2.inductionOn (G e') (fun z w => ⟨z,by simp⟩)
  obtain ⟨z,hz⟩ := hm
  have hzB : z ∈ B := Finset.mem_biUnion.mpr ⟨e',he',by simpa using hz⟩
  have hazB : a z ∈ B := by
    apply Finset.mem_biUnion.mpr
    refine ⟨b e',he,?_⟩
    rw [Sym2.mem_toFinset,hab]
    exact Sym2.mem_map.mpr ⟨z,hz,rfl⟩
  apply hy
  simp only [Set.mem_iUnion]
  refine ⟨a z,hazB,?_⟩
  rw [←hax]
  exact mem_reachBall_aut G hab (hn z hzB).1

theorem label_cylinder_independent (F : Finset E) (b : E ≃ E)
    (hd : Disjoint F (F.image b)) (S : Set (F → unitInterval)) (hS : MeasurableSet S) :
    (labelLaw : Measure (E → unitInterval))
      (cylinder F S ∩ (fun l : E → unitInterval => l ∘ b) ⁻¹' cylinder F S) =
      labelLaw (cylinder F S) * labelLaw (cylinder F S) := by
  classical
  have hi : iIndepFun (fun e (l : E → unitInterval) => l e) labelLaw :=
    iIndepFun_infinitePi (X := fun (_ : E) (x : unitInterval) => x) (fun _ => measurable_id)
  have h := hi.indepFun_finset F (F.image b) hd (fun e => measurable_pi_apply e)
  let r : ((F.image b) → unitInterval) → (F → unitInterval) :=
    fun l e => l ⟨b e,Finset.mem_image.mpr ⟨e,e.property,rfl⟩⟩
  have hr : Measurable r := Measurable.of_eval (fun _ => measurable_pi_apply _)
  have h' := h.comp measurable_id hr
  have he := h'.meas_inter (s := cylinder F S)
    (t := (fun l : E → unitInterval => l ∘ b) ⁻¹' cylinder F S)
    ⟨S,hS,rfl⟩ ⟨S,hS,rfl⟩
  have hm : Measurable (fun l : E → unitInterval => l ∘ b) :=
    Measurable.of_eval fun e => measurable_pi_apply (b e)
  rw [←Measure.map_apply hm hS.cylinder,labelLaw_map_precomp] at he
  exact he

theorem label_invariant_zero_one [Infinite V] (G : BondGraph V E)
    (hconn : Connected G) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (A : Set (E → unitInterval)) (hA : MeasurableSet A)
    (hinv : ∀ a : V ≃ V, ∀ b : E ≃ E, IsAut G a b →
      (fun l : E → unitInterval => l ∘ b) ⁻¹' A = A) :
    labelLaw A = 0 ∨ labelLaw A = 1 := by
  classical
  let μ : Measure (E → unitInterval) := labelLaw
  have hd := Measure.MeasureDense.of_generateFrom_isSetAlgebra_finite μ
    (isSetAlgebra_measurableCylinders (α := fun _ : E => unitInterval))
    generateFrom_measurableCylinders.symm
  have heq : μ.real A ≤ (μ.real A)^2 := by
    apply le_of_forall_pos_le_add
    intro ε hε
    obtain ⟨B,hB,hAB⟩ := hd.approx A hA (measure_ne_top _ _) (ε/4) (by positivity)
    obtain ⟨F,S,hS,rfl⟩ := (mem_measurableCylinders B).mp hB
    let B : Set (E → unitInterval) := cylinder F S
    have hBm : MeasurableSet B := hS.cylinder
    have hABr : μ.real (A ∆ B) < ε/4 := by
      exact (ENNReal.toReal_lt_toReal (measure_ne_top _ _) ENNReal.ofReal_ne_top).mpr hAB |>.trans_le
        (by rw [ENNReal.toReal_ofReal (by positivity)])
    obtain ⟨a,b,hab,habF⟩ := exists_aut_disjoint_edges G hconn hloc hqt F
    let φ : (E → unitInterval) → (E → unitInterval) := fun l => l ∘ b
    have hφ : Measurable φ := Measurable.of_eval fun e => measurable_pi_apply (b e)
    have hφμ : μ.map φ = μ := labelLaw_map_precomp b
    have hφA : φ ⁻¹' A = A := hinv a b hab
    have hφAB : μ.real (A ∆ (φ ⁻¹' B)) = μ.real (A ∆ B) := by
      conv_lhs => rw [←hφA,←Set.preimage_symmDiff]
      change (μ (φ ⁻¹' (A ∆ B))).toReal = _
      rw [←Measure.map_apply hφ (hA.symmDiff hBm),hφμ]
      rfl
    have hC : MeasurableSet (B ∩ φ ⁻¹' B) := hBm.inter (hBm.preimage hφ)
    have hsub : A ∆ (B ∩ φ ⁻¹' B) ⊆ (A ∆ B) ∪ (A ∆ (φ ⁻¹' B)) := by
      intro l hl
      simp only [Set.mem_symmDiff,Set.mem_inter_iff,Set.mem_union] at hl ⊢
      tauto
    have hAC : μ.real (A ∆ (B ∩ φ ⁻¹' B)) < ε/2 := by
      calc
        _ ≤ μ.real ((A ∆ B) ∪ (A ∆ (φ ⁻¹' B))) := measureReal_mono hsub
        _ ≤ μ.real (A ∆ B) + μ.real (A ∆ (φ ⁻¹' B)) := measureReal_union_le _ _
        _ < ε/2 := by rw [hφAB]; linarith
    have hprod : μ.real (B ∩ φ ⁻¹' B) = (μ.real B)^2 := by
      change (labelLaw (B ∩ φ ⁻¹' B)).toReal = _
      rw [label_cylinder_independent F b habF S hS,ENNReal.toReal_mul,pow_two]
      rfl
    have h1 := abs_measureReal_sub_le_measureReal_symmDiff (μ := μ) hA.nullMeasurableSet hC.nullMeasurableSet
    have h2 := abs_measureReal_sub_le_measureReal_symmDiff (μ := μ) hA.nullMeasurableSet hBm.nullMeasurableSet
    have h1' : μ.real A - (μ.real B)^2 < ε/2 := by
      rw [hprod] at h1
      exact lt_of_le_of_lt (le_trans (le_abs_self (μ.real A - (μ.real B)^2)) h1) hAC
    have h2' : μ.real B - μ.real A < ε/4 := by
      have hh := (neg_le_abs (μ.real A - μ.real B)).trans h2 |>.trans_lt hABr
      linarith
    have hA0 : 0 ≤ μ.real A := measureReal_nonneg
    have hB0 : 0 ≤ μ.real B := measureReal_nonneg
    have hA1 : μ.real A ≤ 1 := measureReal_le_one
    have hB1 : μ.real B ≤ 1 := measureReal_le_one
    have hsq : (μ.real B)^2 ≤ (μ.real A)^2 + ε/2 := by
      by_cases hle : μ.real B ≤ μ.real A
      · nlinarith [sq_nonneg (μ.real A-μ.real B)]
      · have hp := mul_le_mul (le_of_lt h2') (show μ.real B+μ.real A ≤ 2 by linarith)
          (show 0 ≤ μ.real B+μ.real A by positivity) (show 0 ≤ ε/4 by positivity)
        nlinarith
    linarith
  have hA0 : 0 ≤ μ.real A := measureReal_nonneg
  have hA1 : μ.real A ≤ 1 := measureReal_le_one
  have he : μ.real A = 0 ∨ μ.real A = 1 := by
    have : μ.real A * (μ.real A-1) = 0 := by nlinarith
    rcases mul_eq_zero.mp this with h | h
    · exact Or.inl h
    · exact Or.inr (by linarith)
  rcases he with h | h
  · left
    exact (ENNReal.toReal_eq_zero_iff _).mp h |>.resolve_right (measure_ne_top _ _)
  · right
    exact (ENNReal.toReal_eq_one_iff _).mp h

end Percolation

end OAI
end

section
-- module Solutions.OAIQ040_CM.UnimodularPercolation_Criticality_ClusterCount
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Exclusion of positive finite critical cluster counts. -/

open MeasureTheory ProbabilityTheory
open scoped ENNReal NNReal

namespace Percolation
open MeasureTheory ProbabilityTheory
open scoped ENNReal
universe u v
variable {V : Type u} {E : Type v}
attribute [local instance] Classical.propDecidable Classical.decEq

theorem law_invariant_zero_one [Infinite V] (G : BondGraph V E)
    (hconn : Connected G) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (p : unitInterval) (A : Set (Set E)) (hA : MeasurableSet A)
    (hinv : ∀ a : V ≃ V, ∀ b : E ≃ E, IsAut G a b →
      (fun ω : Set E => b ⁻¹' ω) ⁻¹' A = A) : law p A = 0 ∨ law p A = 1 := by
  have hm : law p A = labelLaw ((fun l => openEdges l p) ⁻¹' A) := by
    rw [←map_openEdges p,Measure.map_apply (measurable_openEdges p) hA]
  rw [hm]
  apply label_invariant_zero_one G hconn hloc hqt _ (hA.preimage (measurable_openEdges p))
  intro a b hab
  ext l
  have h := Set.ext_iff.mp (hinv a b hab) (openEdges l p)
  exact h

theorem unique_infinite_cluster_aut_iff (G : BondGraph V E)
    {a : V ≃ V} {b : E ≃ E} (hab : IsAut G a b) (ω : Set E) :
    (∃! C, C ∈ infiniteClusters G (b ⁻¹' ω)) ↔ ∃! C, C ∈ infiniteClusters G ω := by
  have hInf (x : V) : (cluster G (b ⁻¹' ω) x).Infinite ↔ (cluster G ω (a x)).Infinite := by
    rw [←cluster_aut G hab ω x]
    exact (Set.infinite_image_iff a.injective.injOn).symm
  rw [unique_infinite_cluster_iff,unique_infinite_cluster_iff]
  constructor
  · rintro ⟨x,hx,h⟩
    refine ⟨a x,(hInf x).mp hx,?_⟩
    intro y hy
    have hh : (cluster G (b ⁻¹' ω) (a.symm y)).Infinite := (hInf _).mpr (by simpa using hy)
    simpa only [Equiv.apply_symm_apply] using (conn_aut_iff G hab ω x (a.symm y)).mp (h _ hh)
  · rintro ⟨x,hx,h⟩
    refine ⟨a.symm x,(hInf _).mpr (by simpa using hx),?_⟩
    intro y hy
    apply (conn_aut_iff G hab ω (a.symm x) y).mpr
    simpa only [Equiv.apply_symm_apply] using h (a y) ((hInf y).mp hy)

theorem critical_unique_probability_zero_oai [Infinite V] (G : BondGraph V E)
    (hconn : Connected G) (hloc : LocallyFinite G) (hqt : QuasiTransitive G)
    (hh : 0 < hV G) : law (pc G) {ω | ∃! C, C ∈ infiniteClusters G ω} = 0 := by
  let : Countable V := countable_vertices hloc hconn
  let : Countable E := countable_edges hloc
  refine (law_invariant_zero_one G hconn hloc hqt (pc G) _
    (measurableSet_unique_infinite_cluster G) ?_).resolve_right
    (critical_not_ae_unique G hconn hloc hqt hh)
  intro a b hab
  ext ω
  exact unique_infinite_cluster_aut_iff G hab ω

end Percolation

end OAI
end

theorem solution.{u, v} : type_of% @OAI.Percolation.critical_unique_probability_zero_oai.{u, v} := @OAI.Percolation.critical_unique_probability_zero_oai.{u, v}
