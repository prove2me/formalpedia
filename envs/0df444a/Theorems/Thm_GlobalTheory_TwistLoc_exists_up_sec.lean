theorem GlobalTheory.TwistLoc.exists_up_sec {w : LB.Iso L' (L.pull F)} (hw : PGen w) (hL : L.IsLB) (hL' : L'.IsLB)
    {φ' : K → (Y ⟶ X')} {ψ : K → (Y ⟶ X)} (hψ : ∀ k, φ' k ≫ F = ψ k) (ε : K → ℤ)
    (a : LB.Sec (LB.LinComb L' φ' ε)) : ∃ s : LB.Sec (LB.LinComb L ψ ε),
      ∀ (Z : Scheme.{0}) (r : Z ⟶ Y) (z : Z) (p : K → L.ι) (q : K → L'.ι),
        r z ∈ LB.wchart L ψ p → r z ∈ LB.wchart L' φ' q →
        gs r z (LB.wchart L ψ p) (s.f p) = (pw w φ' ε r z p q).val * gs r z (LB.wchart L' φ' q) (a.f q) := by sorry
