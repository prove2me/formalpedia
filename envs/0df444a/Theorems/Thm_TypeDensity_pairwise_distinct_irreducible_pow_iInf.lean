theorem TypeDensity.pairwise_distinct_irreducible_pow_iInf (k : Type) [Field k] (ι : Type) [Fintype ι]
    (φ : ι → Polynomial k) (hm : ∀ i, (φ i).Monic) (hirr : ∀ i, Irreducible (φ i))
    (hinj : Function.Injective φ) (r : ι → ℕ) :
    (⨅ i, Ideal.span {φ i ^ r i}) = Ideal.span {∏ i, φ i ^ r i} := by sorry
