  obtain ⟨ub', uA'', hub'₁, hub'₂, huA''₁, huA''₂, hd, hsq⟩ := hρρ'
  have hNκb : IsUnit ((N : ℕ) : κ ⧸ Ideal.span {algebraMap 𝒪 κ π}) := by
