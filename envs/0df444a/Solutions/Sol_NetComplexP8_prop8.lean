variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)} {m : ℕ}

/-- **Phase interface.** The corrected complex network over `ℂ`, applied pointwise to arrays
`𝔽₂^m → ℂ` with phase frames on every gate (any labelling `lab`) and any endpoint labels,
sends the input array on role `w` to `Φ_{q_sink(ρ w) - q_source(w)}` of it on role `ρ w`. -/
theorem phase_interface (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4))
    (Min Mout : Wr ind → ((Fin m → ZMod 2) → ZMod 4)) (f : Wr ind → NetComplexInterface.Arr m) (w : Wr ind) :
    netRun PhiQ (cxFixGatesL ℂ ind lab) Min Mout f (NetComplex.ρ ind w) =
      PhiQ (Mout (NetComplex.ρ ind w) - Min w) (f w) :=
  network_realizes_var PhiQ PhiQ_add PhiQ_zero _
    (complex_exchange_fixed_net hcard hinj lab).1 (NetComplex.ρ ind)
    (complex_exchange_fixed_net hcard hinj lab).2 Min Mout f w

/-- **Full-label routes.** If the endpoint difference is `wt` (source label `0` or `U_a`, sink
label `F` or `U_a^⊥` with `q` difference `wt`), the route applies `C^{⊗m}`. -/
theorem phase_interface_full (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4))
    (Min Mout : Wr ind → ((Fin m → ZMod 2) → ZMod 4)) (f : Wr ind → NetComplexInterface.Arr m) (w : Wr ind)
    (hw : Mout (NetComplex.ρ ind w) - Min w = fun x => (NetComplexPhase.wt x : ZMod 4)) :
    netRun PhiQ (cxFixGatesL ℂ ind lab) Min Mout f (NetComplex.ρ ind w) = Cten (f w) := by
  rw [phase_interface hcard hinj, hw]
  funext y
  change WH _ y = _
  have e : (fun x => I ^ ((NetComplexPhase.wt x : ZMod 4)).val * WH (f w) x) = fun x => I ^ NetComplexPhase.wt x * WH (f w) x := by
    funext x
    congr 1
    apply I_pow_mod
    simp only [ZMod.natCast_val, ZMod.cast_id', id]
  rw [e, WH_full]
  rfl

/-- **The pair `X_a → Y_a`.** If the endpoint difference is `wt + 2[u·x]`, the route applies
`C⁻¹` on `supp u` and `C` elsewhere. -/
theorem phase_interface_mixed (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4))
    (Min Mout : Wr ind → ((Fin m → ZMod 2) → ZMod 4)) (f : Wr ind → NetComplexInterface.Arr m) (w : Wr ind)
    (u : Fin m → ZMod 2)
    (hw : Mout (NetComplex.ρ ind w) - Min w = fun x => ((NetComplexPhase.wt x + 2 * (u ⬝ᵥ x).val : ℕ) : ZMod 4)) :
    netRun PhiQ (cxFixGatesL ℂ ind lab) Min Mout f (NetComplex.ρ ind w) = Mten u (f w) := by
  rw [phase_interface hcard hinj, hw]
  funext y
  change WH _ y = _
  have e : (fun x => I ^ (((NetComplexPhase.wt x + 2 * (u ⬝ᵥ x).val : ℕ) : ZMod 4)).val * WH (f w) x) =
      fun x => I ^ (NetComplexPhase.wt x + 2 * (u ⬝ᵥ x).val) * WH (f w) x := by
    funext x
    congr 1
    apply I_pow_mod
    simp only [ZMod.natCast_val, ZMod.cast_id', id]
  rw [e, WH_mixed]
  rfl

/-- **Proposition 8, assembled for the pair `X_a → Y_a`.** Applying `Z_u` before the network
at `X_a` and `i^{wt u} Z_u` after it at `Y_a` turns this route into `C^{⊗m}`. -/
theorem phase_interface_mixed_corrected (hcard : ∀ t, #(ind t) = 3)
    (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4))
    (Min Mout : Wr ind → ((Fin m → ZMod 2) → ZMod 4)) (f : Wr ind → NetComplexInterface.Arr m) (w : Wr ind)
    (u : Fin m → ZMod 2)
    (hw : Mout (NetComplex.ρ ind w) - Min w = fun x => ((NetComplexPhase.wt x + 2 * (u ⬝ᵥ x).val : ℕ) : ZMod 4))
    (f' : NetComplexInterface.Arr m) (hf : f w = Zu u f') :
    I ^ NetComplexPhase.wt u • Zu u (netRun PhiQ (cxFixGatesL ℂ ind lab) Min Mout f (NetComplex.ρ ind w)) = Cten f' := by
  rw [phase_interface_mixed hcard hinj lab Min Mout f w u hw, hf, Z_correct_tensor]

