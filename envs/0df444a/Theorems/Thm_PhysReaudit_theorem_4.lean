namespace PhysReaudit

/-- **Theorem 4 (A finite-sample minimax sandwich)** (Q. Li, *When Can Physical Evidence Survive a World-Model Update?*, review revision of 3 November 2026 (sha256 a20c437b…), Theorem 4, p.3 (PDF p.4), display (1)).

Fix depth `d`, survival `a ∈ (0, 1]`, entry parameter `κ ∈ (0, 1]`, `0 < ε < b < κ a^d`, and an old-data
law `ν₀`. Put `t = b/(κ a^d)`, `q₀ = (b − ε)/(κ a^d)`, `D = kl(q₀, t)`, `z₊ = log((1 − q₀)/(1 − t))`. Then:
1. for every `0 < δ < 1/2`, `µ(a, d) kl(1 − δ, δ)/D ≤ V_δ ≤ µ(a, d){log(1/δ) + z₊}/D`;
2. for every `0 < δ < 1/2`, the two-sided SPRT `sprtRule` (with thresholds `q₀, t` and `A = log(1/δ)`, private
   randomness trivial) is δ-sound and ε-complete, stops almost surely under every `q ∈ [0, 1]`, and its
   worst good-instance cost `sup_{q ≤ q₀} E_q C` is at most `µ(a, d){log(1/δ) + z₊}/D`;
3. `V_δ / log(1/δ) → µ(a, d)/D` as `δ ↓ 0`. -/
theorem theorem_4 {W₀ : Type} [MeasurableSpace W₀] (ν₀ : Measure W₀) [IsProbabilityMeasure ν₀]
    {a b κ ε : ℝ} {d : ℕ} (ha : 0 < a) (ha1 : a ≤ 1) (hκ : 0 < κ) (hκ1 : κ ≤ 1) (hε : 0 < ε)
    (hεb : ε < b) (hb : b < κ * a ^ d) :
    (∀ δ : ℝ, 0 < δ → δ < 1 / 2 →
      ENNReal.ofReal (mu a d * klBer (1 - δ) δ / klBer (q0 a d b κ ε) (tThr a d b κ))
          ≤ V ν₀ a d b κ ε δ ∧
      V ν₀ a d b κ ε δ
          ≤ ENNReal.ofReal (mu a d * (Real.log (1 / δ) + zPlus (q0 a d b κ ε) (tThr a d b κ))
              / klBer (q0 a d b κ ε) (tThr a d b κ)) ∧
      IsSound (sprtRule (W₀ × Unit) (q0 a d b κ ε) (tThr a d b κ) δ)
          (ν₀.prod (Measure.dirac ())) a d b κ δ ∧
      IsComplete (sprtRule (W₀ × Unit) (q0 a d b κ ε) (tThr a d b κ) δ)
          (ν₀.prod (Measure.dirac ())) a d b κ ε δ ∧
      (∀ q ∈ Set.Icc (0 : ℝ) 1, ∀ᵐ ω ∂(lawQ (ν₀.prod (Measure.dirac ())) a q),
          stops (sprtRule (W₀ × Unit) (q0 a d b κ ε) (tThr a d b κ) δ) d ω) ∧
      (⨆ q ∈ Set.Icc (0 : ℝ) (q0 a d b κ ε),
          expCost (sprtRule (W₀ × Unit) (q0 a d b κ ε) (tThr a d b κ) δ)
            (ν₀.prod (Measure.dirac ())) a d q)
          ≤ ENNReal.ofReal (mu a d * (Real.log (1 / δ) + zPlus (q0 a d b κ ε) (tThr a d b κ))
              / klBer (q0 a d b κ ε) (tThr a d b κ))) ∧
    Tendsto (fun δ : ℝ => (V ν₀ a d b κ ε δ).toReal / Real.log (1 / δ)) (𝓝[>] 0)
      (𝓝 (mu a d / klBer (q0 a d b κ ε) (tThr a d b κ))) := by sorry

end PhysReaudit
