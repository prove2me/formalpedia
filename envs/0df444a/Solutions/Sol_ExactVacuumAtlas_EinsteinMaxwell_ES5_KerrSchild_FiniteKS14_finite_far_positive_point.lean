section R05Seg7
/-! # VII-08 (1/5): same-coordinate Kerr–Schild metric over an independent background

All objects live in **one** coordinate chart `Pt 5` on an open `U`. The raw data are an
independent background metric `b`, its actual inverse `bi`, a profile `v` and a vector field `k`.
With `ℓ_i = Σ_j b_ij k^j` (`lowerK`) the Kerr–Schild metric and inverse are

  `g_ij = b_ij + v ℓ_i ℓ_j`,  `gi^ij = bi^ij − v k^i k^j`   (plus-profile convention; the
  2009 convention `g = η − 2H ℓℓ` is `v = −2H`).

`KSData` only packages genuine raw geometric data: the existing background record
`MetricData b bi U` (openness, symmetry of `b`, `bi · b = 1`, componentwise `C^∞` of `b, bi`;
reused from `Atlas/Transport`, no curvature condition), `C^∞` of `v, k` on `U` (stronger than the
`C²` that suffices; assumed for the `Core.Pd` API), and actual `b(k,k) = 0` on **all** of `U`. It contains no connection,
acceleration, curvature or Ricci-null statement. `b` may be non-constant with cross terms.

Proved here: `bi` is two-sided and symmetric, `g` is symmetric, `gi · g = 1 = g · gi`,
`g k = ℓ`, `gi ℓ = k`, `g(k,k) = 0`, and `C^∞` of `ℓ, g, gi` on `U`. No `v ≠ 0`, `k ≠ 0`,
Lorentz signature or flatness is used.
-/

open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections (contract2)
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geometry

/-- Generic raising: if `gi · g = 1` then `Σ_d gi^ad Σ_i g_di X^i = X^a`. -/
theorem raise_lower {g gi : Metric 5} {x : Pt 5}
    (h : metricMatrix gi x * metricMatrix g x = 1) (X : Fin 5 → ℝ) (a : Fin 5) :
    ∑ d, gi a d x * ∑ i, g d i x * X i = X a := by
  have e : ∑ d, gi a d x * ∑ i, g d i x * X i = ∑ i, (∑ d, gi a d x * g d i x) * X i := by
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun d _ => by ring
  rw [e]
  simp [metric_mul_inv_apply h]

variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}

namespace KSData

variable (hD : KSData b bi v k U)
include hD

theorem isOpen : IsOpen U := hD.bg.isOpen
theorem symm : ∀ x ∈ U, ∀ i j, b i j x = b j i x := hD.bg.symm
theorem inv : ∀ x ∈ U, metricMatrix bi x * metricMatrix b x = 1 := hD.bg.inv

theorem bi_mul_b_apply {x : Pt 5} (hx : x ∈ U) (a c : Fin 5) :
    ∑ j, bi a j x * b j c x = if a = c then 1 else 0 :=
  metric_mul_inv_apply (hD.inv x hx) a c

theorem sum_k_mul_b {x : Pt 5} (hx : x ∈ U) (c : Fin 5) :
    ∑ j, k x j * b j c x = lowerK b k x c := by
  unfold lowerK
  exact Finset.sum_congr rfl fun j _ => by rw [hD.symm x hx j c]; ring

/-- Actual nullity as `Σ_c k^c ℓ_c = 0`. -/
theorem k_dot_lower {x : Pt 5} (hx : x ∈ U) : ∑ c, k x c * lowerK b k x c = 0 := by
  have h := hD.null x hx
  unfold contract2 at h
  rw [← h]
  unfold lowerK
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [Finset.mul_sum]
  exact Finset.sum_congr rfl fun j _ => by ring

theorem lower_dot_k {x : Pt 5} (hx : x ∈ U) : ∑ c, lowerK b k x c * k x c = 0 := by
  rw [← hD.k_dot_lower hx]
  exact Finset.sum_congr rfl fun c _ => mul_comm _ _

/-- `bi ℓ = k`. -/
theorem inv_lower {x : Pt 5} (hx : x ∈ U) (a : Fin 5) :
    ∑ c, bi a c x * lowerK b k x c = k x a :=
  raise_lower (hD.inv x hx) (k x) a

/-- Actual `gi · g = 1` (componentwise). -/
theorem ks_inv_apply {x : Pt 5} (hx : x ∈ U) (a c : Fin 5) :
    ∑ j, ksInverse bi v k a j x * ksMetric b v k j c x = if a = c then 1 else 0 := by
  simp only [ksInverse, ksMetric]
  have e : ∑ j, (bi a j x - v x * k x a * k x j) *
      (b j c x + v x * lowerK b k x j * lowerK b k x c) =
      ∑ j, bi a j x * b j c x + v x * (∑ j, bi a j x * lowerK b k x j) * lowerK b k x c
        - v x * k x a * (∑ j, k x j * b j c x)
        - v x ^ 2 * k x a * lowerK b k x c * (∑ j, k x j * lowerK b k x j) := by
    simp only [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [e, hD.bi_mul_b_apply hx, hD.inv_lower hx, hD.sum_k_mul_b hx, hD.k_dot_lower hx]
  ring

/-- **Genuine inverse.** `gi · g = 1` on `U`. -/
theorem ks_inv {x : Pt 5} (hx : x ∈ U) :
    metricMatrix (ksInverse bi v k) x * metricMatrix (ksMetric b v k) x = 1 := by
  ext a c
  simp only [metricMatrix, Matrix.mul_apply, Matrix.of_apply, Matrix.one_apply]
  exact hD.ks_inv_apply hx a c

/-- `g k = ℓ = b k`. -/
theorem ks_mulVec_k {x : Pt 5} (hx : x ∈ U) (i : Fin 5) :
    ∑ j, ksMetric b v k i j x * k x j = lowerK b k x i := by
  simp only [ksMetric]
  have e : ∑ j, (b i j x + v x * lowerK b k x i * lowerK b k x j) * k x j =
      ∑ j, b i j x * k x j + v x * lowerK b k x i * ∑ j, lowerK b k x j * k x j := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [e, hD.lower_dot_k hx, mul_zero, add_zero]
  rfl

/-- **The KS vector stays null for the full metric:** `g(k,k) = 0` on `U`. -/
theorem ks_null {x : Pt 5} (hx : x ∈ U) : contract2 (ksMetric b v k) x (k x) = 0 := by
  unfold contract2
  have e : ∑ a, ∑ c, ksMetric b v k a c x * k x a * k x c =
      ∑ a, k x a * ∑ c, ksMetric b v k a c x * k x c := by
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun c _ => by ring
  rw [e]
  simp only [hD.ks_mulVec_k hx]
  exact hD.k_dot_lower hx

/-! ### Genuine smoothness and differentiability on `U` -/

end KSData

