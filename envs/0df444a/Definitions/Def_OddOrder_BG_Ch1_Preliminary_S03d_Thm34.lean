open scoped Pointwise commutatorElement

/-- **BG Theorem 3.4, step 6 (closing absurdity for the elementary-abelian case).**
If `G = KR` is a Frobenius group (kernel `K`, complement `R`) on which `K` acts nontrivially over a
field `F` with `char F ∤ |K|`, then some nonzero vector is fixed by all of `R` (Lemma 3.3), so
`C_V(R) ≠ 0` — contradicting the standing hypothesis `C_V(R) = 0`.  In the proof of Theorem 3.4 the
elementary-abelian branch yields `C_K(R) = 1`, hence a Frobenius group (Lemma 3.1), and this lemma
closes that branch. -/
private theorem thm34_frobenius_absurd {F : Type*} [Field F]
    {G : Type*} [Group G] [Finite G] {V : Type*} [AddCommGroup V] [Module F V]
    {K R : Subgroup G} (ρ : Representation F G V)
    (hFrob : IsFrobeniusGroup G K R) (hchar : (Nat.card ↥K : F) ≠ 0)
    (hKnt : ∃ k : ↥K, ρ (k : G) ≠ 1)
    (hCV : ∀ v : V, (∀ r : ↥R, ρ (r : G) v = v) → v = 0) : False := by
  obtain ⟨v, hv0, hvfix⟩ :=
    OddOrder.BG.Ch1.S03b.centralizer_ne_bot_of_nontrivial_kernel hFrob ρ hchar hKnt
  exact hv0 (hCV v hvfix)

/-- **BG Theorem 3.4, step 4 (front half).** If `K` is generated by a family of proper
`R`-invariant subgroups `Hᵢ`, each of which already satisfies `[Hᵢ, R] ⊆ C` (the inductive
conclusion from `wiring_check`), then `[R, K] ⊆ C`.  The commutator distributes over the join
(`commutator_iSup_right`), and each `⁅R, Hᵢ⁆` lands in `ker ρ`.  Combined with the back half
(a `≥ 2`-prime `|K|` is generated by its proper `R`-invariant Sylow subgroups) this gives the
contradiction forcing `|K| = qⁿ`. -/
private theorem thm34_commutator_of_generated {F : Type*} [Field F]
    {G : Type*} [Group G] {V : Type*} [AddCommGroup V] [Module F V]
    (ρ : Representation F G V) {K R : Subgroup G}
    (hproper : ∀ H : Subgroup G, H < K → R ≤ Subgroup.normalizer H → ∀ g ∈ ⁅R, H⁆, ρ g = 1)
    {ι : Type*} (Hs : ι → Subgroup G) (hHlt : ∀ i, Hs i < K)
    (hHinv : ∀ i, R ≤ Subgroup.normalizer (Hs i)) (hgen : ⨆ i, Hs i = K) :
    ∀ g ∈ ⁅R, K⁆, ρ g = 1 := by
  refine (Subgroup.commutator_le (H₁ := R) (H₂ := K) (H₃ := MonoidHom.ker ρ)).mpr ?_
  intro r hr k hk
  -- `Cr = {k | ρ kills ⁅r,k⁆}` is a subgroup: `one` via `⁅r,1⁆=1`; `mul` via the identity
  -- `⁅r,ab⁆ = ⁅r,a⁆·(a⁅r,b⁆a⁻¹)` and `ker ρ` normal; `inv` via `⁅r,a⁻¹⁆ = a⁻¹⁅r,a⁆⁻¹a`.
  -- Each `Hs i ≤ Cr` by `hproper`, so `K = ⨆ Hs ≤ Cr`, giving `⁅r,k⁆ ∈ ker ρ`.
  let Cr : Subgroup G :=
    { carrier := {k | ⁅r, k⁆ ∈ MonoidHom.ker ρ}
      one_mem' := by
        simp only [Set.mem_ofPred_eq, commutatorElement_one_right]; exact one_mem _
      mul_mem' := fun {a b} ha hb => by
        simp only [Set.mem_ofPred_eq] at *
        have hid : ⁅r, a * b⁆ = ⁅r, a⁆ * (a * ⁅r, b⁆ * a⁻¹) := by group
        rw [hid]
        exact mul_mem ha ((MonoidHom.normal_ker ρ).conj_mem _ hb a)
      inv_mem' := fun {a} ha => by
        simp only [Set.mem_ofPred_eq] at *
        have hid : ⁅r, a⁻¹⁆ = a⁻¹ * ⁅r, a⁆⁻¹ * a := by group
        rw [hid]
        simpa only [inv_inv] using (MonoidHom.normal_ker ρ).conj_mem _ (inv_mem ha) a⁻¹ }
  have hKCr : (⨆ i, Hs i) ≤ Cr := by
    refine iSup_le fun i => ?_
    intro k' hk'
    change ⁅r, k'⁆ ∈ MonoidHom.ker ρ
    rw [MonoidHom.mem_ker]
    exact hproper (Hs i) (hHlt i) (hHinv i) _ (Subgroup.commutator_mem_commutator hr hk')
  rw [← hgen] at hk
  exact hKCr hk

/-- A finite group is generated by **any choice** of one Sylow `p`-subgroup per prime divisor
(choice version of `⨆ Sylow = ⊤`, same factorization argument).  Used in step 4 with the
`R`-invariant Sylow subgroups to express `K` as a join of proper `R`-invariant subgroups. -/
private lemma sylow_choice_iSup_eq_top {M : Type*} [Group M] [Finite M]
    (P : ∀ p : (Nat.card M).primeFactors, Sylow p.val M) :
    (⨆ p, (P p : Subgroup M)) = ⊤ := by
  classical
  set sup := ⨆ p, (P p : Subgroup M) with hsup_def
  have h_sup_dvd : Nat.card sup ∣ Nat.card M := Subgroup.card_subgroup_dvd_card sup
  have h_pow_dvd : ∀ p ∈ (Nat.card M).primeFactors,
      p ^ (Nat.card M).factorization p ∣ Nat.card sup := by
    intro p hp
    have : Fact p.Prime := ⟨Nat.prime_of_mem_primeFactors hp⟩
    have hP_le : ((P ⟨p, hp⟩ : Subgroup M)) ≤ sup :=
      le_iSup (fun q : (Nat.card M).primeFactors => (P q : Subgroup M)) ⟨p, hp⟩
    have h_dvd := Subgroup.card_dvd_of_le hP_le
    rwa [Sylow.card_eq_multiplicity] at h_dvd
  have h_le : ∀ p, (Nat.card M).factorization p ≤ (Nat.card sup).factorization p := by
    intro p
    rcases Nat.eq_zero_or_pos ((Nat.card M).factorization p) with h0 | hpos
    · rw [h0]; exact Nat.zero_le _
    · have hp_in : p ∈ (Nat.card M).primeFactors := by
        rw [← Nat.support_factorization]; exact Finsupp.mem_support_iff.mpr (by omega)
      exact ((Nat.prime_of_mem_primeFactors hp_in).pow_dvd_iff_le_factorization
        Nat.card_pos.ne').mp (h_pow_dvd p hp_in)
  have h_le' : ∀ p, (Nat.card sup).factorization p ≤ (Nat.card M).factorization p :=
    fun p => (Nat.factorization_le_iff_dvd Nat.card_pos.ne' Nat.card_pos.ne').mpr h_sup_dvd p
  exact Subgroup.eq_top_of_card_eq sup
    (Nat.eq_of_factorization_eq Nat.card_pos.ne' Nat.card_pos.ne'
      (fun p => le_antisymm (h_le' p) (h_le p)))

/-- **BG Theorem 3.4, step 4 (back half): a non-prime-power kernel is generated by proper
`R`-invariant subgroups.**  Let `K ◁ G` with `R` acting coprimely (here `|R|` coprime to `|K|`).
If `|K|` is *not* a prime power then, for each prime `p ∣ |K|`, there is an `R`-invariant Sylow
`p`-subgroup of `K` (`exists_aInvariant_sylow`, the coprime-action fixed-point theorem); mapped into
`G` these are:
* **proper** (`< K`) — a single Sylow cannot be all of `K`, else `|K|` would be a prime power;
* **`R`-invariant** (`R ≤ normalizer`) — `R` normalises them since they are `φ`-invariant for the
  conjugation action `φ = MulAut.conjNormal ∘ R.subtype`;
* a **generating** family (`⨆ = K`) — the Sylow subgroups of `K` join to `K`.

Feeding this family to `thm34_commutator_of_generated` forces `[R, K] ⊆ C_K(V)` in the minimal
counterexample, a contradiction; hence `|K|` is a prime power (step 4). -/
private lemma exists_proper_aInvariant_iSup_eq_of_not_isPrimePow
    {G : Type*} [Group G] [Finite G] [Group.IsSolvable G] {K R : Subgroup G} [K.Normal]
    (hcop : Nat.Coprime (Nat.card ↥R) (Nat.card ↥K))
    (hnpp : ¬ IsPrimePow (Nat.card ↥K)) :
    ∃ Hs : (Nat.card ↥K).primeFactors → Subgroup G,
      (∀ i, Hs i < K) ∧ (∀ i, R ≤ Subgroup.normalizer (Hs i)) ∧ ⨆ i, Hs i = K := by
  classical
  -- conjugation action of `R` on the normal subgroup `K`, and the value of its (inverse) action
  set φ : ↥R →* MulAut ↥K := (MulAut.conjNormal (G := G) (H := K)).comp R.subtype with hφ
  have hval : ∀ (r : ↥R) (k : ↥K), (((φ r) k : ↥K) : G) = (r : G) * (k : G) * (r : G)⁻¹ := by
    intro r k
    simp only [hφ, MonoidHom.comp_apply, Subgroup.coe_subtype, MulAut.conjNormal_apply]
  have hvalinv : ∀ (r : ↥R) (k : ↥K), (((φ r)⁻¹ k : ↥K) : G) = (r : G)⁻¹ * (k : G) * (r : G) := by
    intro r k
    simp only [hφ, MonoidHom.comp_apply, Subgroup.coe_subtype]
    exact MulAut.conjNormal_inv_apply (r : G) k
  -- choose an `R`-invariant Sylow `p`-subgroup of `K` for each prime `p ∣ |K|`
  have hchoose : ∀ p : (Nat.card ↥K).primeFactors,
      ∃ P : Sylow p.val ↥K, IsAInvariant φ (P : Subgroup ↥K) := by
    intro p
    have : Fact p.val.Prime := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    exact exists_aInvariant_sylow (φ := φ) hcop (Or.inl inferInstance) p.val
  choose P hP using hchoose
  refine ⟨fun p => (P p : Subgroup ↥K).map K.subtype, ?_, ?_, ?_⟩
  · -- properness: `(P p).map K.subtype < K`
    intro p
    refine lt_of_le_of_ne (Subgroup.map_subtype_le _) ?_
    intro heq
    apply hnpp
    have : Fact p.val.Prime := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    have e1 : Nat.card ↥((P p : Subgroup ↥K).map K.subtype) = Nat.card ↥(P p : Subgroup ↥K) :=
      Nat.card_congr (Subgroup.equivMapOfInjective _ _ K.subtype_injective).symm.toEquiv
    have hcard : Nat.card ↥K = p.val ^ (Nat.card ↥K).factorization p.val := by
      conv_lhs => rw [← heq]
      rw [e1, (P p).card_eq_multiplicity]
    exact ⟨p.val, (Nat.card ↥K).factorization p.val, (Nat.prime_of_mem_primeFactors p.2).prime,
      (Nat.prime_of_mem_primeFactors p.2).factorization_pos_of_dvd Nat.card_pos.ne'
        (Nat.dvd_of_mem_primeFactors p.2), hcard.symm⟩
  · -- `R`-invariance: `R ≤ normalizer ((P p).map K.subtype)`
    intro p r hr
    rw [Subgroup.mem_normalizer_iff]
    intro n
    constructor
    · rintro ⟨k, hk, rfl⟩
      refine ⟨(φ ⟨r, hr⟩) k, (hP p).smul_mem ⟨r, hr⟩ hk, ?_⟩
      simp only [Subgroup.coe_subtype] at *
      rw [hval ⟨r, hr⟩ k]
    · rintro ⟨k, hk, hkn⟩
      refine ⟨(φ ⟨r, hr⟩)⁻¹ k, (hP p).inv_smul_mem ⟨r, hr⟩ hk, ?_⟩
      simp only [Subgroup.coe_subtype] at hkn ⊢
      rw [hvalinv ⟨r, hr⟩ k, hkn]
      group
  · -- generating: `⨆ p, (P p).map K.subtype = K`
    rw [← Subgroup.map_iSup, sylow_choice_iSup_eq_top P, ← MonoidHom.range_eq_map,
      Subgroup.range_subtype]

/-- **BG Theorem 3.4, step 4 (packaging): the kernel of a minimal counterexample has prime-power
order.**  Combining step 1 (`hproper`, the inductive conclusion for proper `R`-invariant subgroups,
supplied by `wiring_check`) with the generation lemma
`exists_proper_aInvariant_iSup_eq_of_not_isPrimePow` and `thm34_commutator_of_generated`: if `|K|`
were not a prime power, `K` would be generated by proper `R`-invariant subgroups, forcing
`[R, K] ⊆ C_K(V)` — contradicting the standing minimal-counterexample assumption `[R, K] ⊄ C_K(V)`
(`hRK`).  (The `|K| = 1` case is also covered: there the generating family is empty,
`K = ⊥`, and the
conclusion holds outright, again contradicting `hRK`.) -/
private lemma thm34_isPrimePow_of_minimal {F : Type*} [Field F]
    {G : Type*} [Group G] [Finite G] [Group.IsSolvable G] {V : Type*} [AddCommGroup V] [Module F V]
    (ρ : Representation F G V) {K R : Subgroup G} [K.Normal]
    (hcop : Nat.Coprime (Nat.card ↥R) (Nat.card ↥K))
    (hproper : ∀ H : Subgroup G, H < K → R ≤ Subgroup.normalizer H → ∀ g ∈ ⁅R, H⁆, ρ g = 1)
    (hRK : ¬ ∀ g ∈ ⁅R, K⁆, ρ g = 1) :
    IsPrimePow (Nat.card ↥K) := by
  by_contra hnpp
  obtain ⟨Hs, hlt, hinv, hgen⟩ := exists_proper_aInvariant_iSup_eq_of_not_isPrimePow hcop hnpp
  exact hRK (thm34_commutator_of_generated ρ hproper Hs hlt hinv hgen)

open OddOrder.GroupTheory in
/-- **BG Theorem 3.4, step 7: a nonabelian special kernel with cyclic ambient centre is
extraspecial.**  In the minimal counterexample `G = K ⋊ R` with `G` faithful irreducible (so `Z(G)`
is cyclic by Gorenstein 3.2.2, `hZcyc`), suppose Gorenstein 5.3.7 left `K` *nonabelian special*
(`IsSpecial p K`, not elementary abelian) and `R` centralises `Z(K)` (`hRcent`, the
centralising half
of BG (3.3), since `K' = Z(K)` for a special group).  Then `Z(K) ⊆ Z(G)`: any `↑z` with `z ∈ Z(K)`
commutes with all of `K` (it is central in `K`) and with all of `R` (`hRcent`), and `K ⊔ R = ⊤`
(complement), so its centraliser is everything.  Hence `Z(K)` embeds injectively into the cyclic
`Z(G)`, is itself cyclic, and `of_isSpecial_of_isCyclic_center` (Leaf 1) gives
`IsExtraspecial p K`. -/
private lemma thm34_isExtraspecial_of_special {G : Type*} [Group G] [Finite G]
    {K R : Subgroup G} {p : ℕ} [Fact p.Prime]
    (hcompl : Subgroup.IsComplement' K R)
    (hZcyc : IsCyclic (Subgroup.center G))
    (hRcent : ∀ r ∈ R, ∀ k : ↥K, k ∈ Subgroup.center ↥K → r * (k : G) = (k : G) * r)
    (hsp : IsSpecial p ↥K) (hnonab : ¬ IsElementaryAbelian p ↥K) :
    IsExtraspecial p ↥K := by
  -- every `↑z` with `z ∈ Z(K)` lies in `Z(G)` (its centraliser contains `K ⊔ R = ⊤`)
  have hmem : ∀ z : ↥(Subgroup.center ↥K),
      (K.subtype.comp (Subgroup.center ↥K).subtype) z ∈ Subgroup.center G := by
    intro z
    change ((z : ↥K) : G) ∈ Subgroup.center G
    have hcent : Subgroup.centralizer ({((z : ↥K) : G)} : Set G) = ⊤ := by
      rw [eq_top_iff, ← hcompl.sup_eq_top]
      refine sup_le (fun a ha => ?_) (fun b hb => ?_)
      · rw [Subgroup.mem_centralizer_iff]
        intro h hh
        rw [Set.mem_singleton_iff] at hh; subst hh
        have h2 := congrArg (K.subtype) (Subgroup.mem_center_iff.mp z.2 ⟨a, ha⟩)
        simp only [map_mul, Subgroup.coe_subtype] at h2
        exact h2.symm
      · rw [Subgroup.mem_centralizer_iff]
        intro h hh
        rw [Set.mem_singleton_iff] at hh; subst hh
        exact (hRcent b hb (z : ↥K) z.2).symm
    rw [Subgroup.mem_center_iff]
    intro g
    have hg : g ∈ Subgroup.centralizer ({((z : ↥K) : G)} : Set G) := hcent ▸ Subgroup.mem_top g
    rw [Subgroup.mem_centralizer_iff] at hg
    exact (hg _ rfl).symm
  -- `Z(K) ↪ Z(G)` injectively, hence `Z(K)` is cyclic; conclude via Leaf 1
  let f' : ↥(Subgroup.center ↥K) →* ↥(Subgroup.center G) :=
    (K.subtype.comp (Subgroup.center ↥K).subtype).codRestrict _ hmem
  have hinj : Function.Injective f' := by
    intro a b hab
    have h1 : ((a : ↥K) : G) = ((b : ↥K) : G) :=
      congrArg (Subtype.val : ↥(Subgroup.center G) → G) hab
    exact Subtype.ext (Subtype.ext h1)
  have : IsCyclic (Subgroup.center ↥K) := isCyclic_of_injective f' hinj
  exact IsExtraspecial.of_isSpecial_of_isCyclic_center hsp hnonab this

open OddOrder.RepresentationTheory in
set_option backward.isDefEq.respectTransparency false in
/-- **BG Theorem 3.4, step 2 (Maschke selection).**  Over a field with `char F ∤ |G|` a
finite-dimensional representation `ρ` is semisimple (Maschke).  If `ρ g₀ ≠ 1` then `g₀` acts
nontrivially on some **irreducible** subrepresentation `W`: were `g₀` to fix every simple
subrepresentation pointwise it would fix their join `⊤ = ⨆ simple`, contradicting
`ρ g₀ ≠ 1`.  In the
proof of Theorem 3.4 this is applied to a `g₀ ∈ ⁅R, K⁆` with `ρ g₀ ≠ 1` (from `hRK`) to choose the
irreducible `M` on which `[K, R]` acts nontrivially. -/
theorem exists_irreducible_subrep_apply_ne
    {F : Type*} [Field F] {G : Type*} [Group G] [Finite G]
    {V : Type*} [AddCommGroup V] [Module F V] [NeZero (Nat.card G : F)]
    (ρ : Representation F G V) {g₀ : G} (hg₀ : ρ g₀ ≠ 1) :
    ∃ W : Subrepresentation ρ, (W.toRepresentation).IsIrreducible ∧ W.toRepresentation g₀ ≠ 1 := by
  classical
  have : IsSemisimpleModule (MonoidAlgebra F G) ρ.asModule := by
    rw [← Representation.isSemisimpleRepresentation_iff_isSemisimpleModule_asModule]; infer_instance
  -- find a simple `F[G]`-submodule on which `single g₀ 1` (i.e. `ρ g₀`) acts nontrivially
  have key : ∃ N : Submodule (MonoidAlgebra F G) ρ.asModule,
      IsSimpleModule (MonoidAlgebra F G) ↥N ∧
      ∃ w : ρ.asModule, w ∈ N ∧ MonoidAlgebra.single g₀ (1 : F) • w ≠ w := by
    by_contra hcon
    push Not at hcon
    apply hg₀
    -- `single g₀ 1` fixes every `asModule` element (it fixes every simple, which join to `⊤`)
    have hall : ∀ w : ρ.asModule, MonoidAlgebra.single g₀ (1 : F) • w = w := by
      intro w
      have hv : w ∈
          ⨆ i : ↥{m : Submodule (MonoidAlgebra F G) ρ.asModule |
              IsSimpleModule (MonoidAlgebra F G) ↥m},
            (i : Submodule (MonoidAlgebra F G) ρ.asModule) := by
        rw [← sSup_eq_iSup', IsSemisimpleModule.sSup_simples_eq_top]; exact Submodule.mem_top
      refine Submodule.iSup_induction (motive := fun z => MonoidAlgebra.single g₀ (1 : F) • z = z)
        _ hv (fun i x hx => hcon i.1 i.2 x hx) (by simp)
        (fun a b ha hb => by rw [smul_add, ha, hb])
    ext v
    have hv := congrArg ρ.asModuleEquiv (hall (ρ.asModuleEquiv.symm v))
    rw [Representation.asModuleEquiv_map_smul, Representation.asAlgebraHom_single_one,
      LinearEquiv.apply_symm_apply] at hv
    simpa using hv
  obtain ⟨N, hNs, w, hwN, hwne⟩ := key
  have := hNs
  refine ⟨Subrepresentation.ofSubmodule' N, subRep_isIrreducible ρ N, ?_⟩
  intro hcontra
  apply hwne
  have hwW : w ∈ (Subrepresentation.ofSubmodule' N).toSubmodule :=
    (Subrepresentation.mem_ofSubmodule'_iff).mpr hwN
  have key2 : (Subrepresentation.ofSubmodule' N).toRepresentation g₀ ⟨w, hwW⟩ = ⟨w, hwW⟩ := by
    rw [hcontra]; rfl
  have happ : ρ g₀ w = w := congrArg Subtype.val key2
  refine ρ.asModuleEquiv.injective ?_
  rw [Representation.asModuleEquiv_map_smul, Representation.asAlgebraHom_single_one]
  exact happ

/-- **BG Theorem 3.4, step 2-3 (group theory): a normal subgroup meeting the prime-order complement
trivially lies in the normal Hall kernel.**  `K ◁ G` is a Hall subgroup and `R` a complement of
prime order `p`, so `R` is a Sylow `p`-subgroup.  A normal `N ◁ G` with `N ⊓ R = ⊥` satisfies
`N ≤ K`:
* **`p ∤ |N|`** — otherwise Cauchy gives an order-`p` element `x ∈ N`, which lies in some Sylow
  `p`-subgroup `Q`; conjugating `Q` to `R` (Sylow conjugacy) carries `x` into `R`, and `N`'s
  normality keeps it in `N`, producing a nontrivial element of `N ⊓ R = ⊥`.
* then `|N.map (mk' K)|` divides both `|N|` (coprime to `p`) and `|G/K| = p`, hence is `1`, so
  `N ≤ ker (mk' K) = K`.

In the proof of Theorem 3.4 this is applied with `N = C_G(M)` (the kernel on the chosen irreducible
`M`), giving `N ≤ K` for the `G/N`-quotient step. -/
private lemma normal_le_of_complement_prime_of_inf_eq_bot
    {G : Type*} [Group G] [Finite G] {K N R : Subgroup G} [K.Normal] [N.Normal]
    (hcompl : Subgroup.IsComplement' K R) (hp : (Nat.card ↥R).Prime)
    (hcop : Nat.Coprime (Nat.card ↥K) (Nat.card ↥R)) (hNR : N ⊓ R = ⊥) :
    N ≤ K := by
  have : Fact (Nat.card ↥R).Prime := ⟨hp⟩
  have hpK : ¬ (Nat.card ↥R) ∣ Nat.card ↥K := (hp.coprime_iff_not_dvd).mp hcop.symm
  have hcard_mul : Nat.card ↥K * Nat.card ↥R = Nat.card G := hcompl.card_mul_card
  -- `|G/K| = |R|`
  have hquot : Nat.card (G ⧸ K) = Nat.card ↥R := by
    have h1 : Nat.card G = Nat.card (G ⧸ K) * Nat.card ↥K :=
      Subgroup.card_eq_card_quotient_mul_card_subgroup K
    have h2 : Nat.card (G ⧸ K) * Nat.card ↥K = Nat.card ↥R * Nat.card ↥K := by
      rw [← h1, ← hcard_mul, mul_comm]
    exact Nat.eq_of_mul_eq_mul_right Nat.card_pos h2
  -- `R` is a Sylow `p`-subgroup: its multiplicity is `1`
  have hfact : (Nat.card G).factorization (Nat.card ↥R) = 1 := by
    rw [← hcard_mul, Nat.factorization_mul Nat.card_pos.ne' Nat.card_pos.ne',
      Finsupp.coe_add, Pi.add_apply, Nat.factorization_eq_zero_of_not_dvd hpK,
      hp.factorization_self, zero_add]
  let Rsyl : Sylow (Nat.card ↥R) G := Sylow.ofCard R (by rw [hfact, pow_one])
  -- **Step 1**: `p ∤ |N|`
  have hpN : ¬ (Nat.card ↥R) ∣ Nat.card ↥N := by
    intro hdvd
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := ↥N) (Nat.card ↥R) hdvd
    have hxG : orderOf ((x : G)) = Nat.card ↥R := by
      rw [← hx]; exact orderOf_injective N.subtype N.subtype_injective x
    have hPgroup : IsPGroup (Nat.card ↥R) (Subgroup.zpowers ((x : G))) :=
      IsPGroup.of_card (((Nat.card_zpowers _).trans hxG).trans (pow_one _).symm)
    obtain ⟨Q, hQ⟩ := hPgroup.exists_le_sylow
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G Q Rsyl
    have hxQ : (x : G) ∈ (Q : Subgroup G) := hQ (Subgroup.mem_zpowers _)
    have hcompute : (MulAut.conj g)⁻¹ • (g * (x : G) * g⁻¹) = (x : G) := by
      rw [← map_inv]; change (MulAut.conj g⁻¹) (g * (x : G) * g⁻¹) = (x : G)
      rw [MulAut.conj_apply]; group
    have hconjR : g * (x : G) * g⁻¹ ∈ R := by
      have hR : (Rsyl : Subgroup G) = R := Sylow.coe_ofCard _ _
      rw [← hR, ← hg, Sylow.coe_subgroup_smul, Subgroup.mem_pointwise_smul_iff_inv_smul_mem,
        hcompute]
      exact hxQ
    have hconjN : g * (x : G) * g⁻¹ ∈ N := ‹N.Normal›.conj_mem (x : G) x.2 g
    have hmem : g * (x : G) * g⁻¹ ∈ N ⊓ R := ⟨hconjN, hconjR⟩
    rw [hNR, Subgroup.mem_bot] at hmem
    have hx1 : (x : G) = 1 := by
      have hc : (MulAut.conj g) (x : G) = 1 := by rw [MulAut.conj_apply]; exact hmem
      exact (MulEquiv.map_eq_one_iff _).mp hc
    rw [hx1, orderOf_one] at hxG
    exact hp.one_lt.ne hxG
  -- **Step 2**: `N ≤ K`
  have hdvd1 : Nat.card (N.map (QuotientGroup.mk' K)) ∣ Nat.card ↥N := Subgroup.card_map_dvd _ _
  have hdvd2 : Nat.card (N.map (QuotientGroup.mk' K)) ∣ Nat.card ↥R := by
    rw [← hquot]; exact Subgroup.card_subgroup_dvd_card _
  have hcop2 : Nat.Coprime (Nat.card ↥N) (Nat.card ↥R) := ((hp.coprime_iff_not_dvd).mpr hpN).symm
  have hone : Nat.card (N.map (QuotientGroup.mk' K)) = 1 :=
    Nat.eq_one_of_dvd_coprimes hcop2 hdvd1 hdvd2
  have hbot : N.map (QuotientGroup.mk' K) = ⊥ := Subgroup.card_eq_one.mp hone
  rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hbot
  exact hbot

/-- In a finite subgroup `R` of **prime** order, every non-identity element generates `R`
(`⟨r⟩ = R`).  Used in steps 2-3 and 6 of Theorem 3.4 to upgrade "fixed by `r ≠ 1`" to "fixed by all
of `R`" (the prime order forces `R` to be cyclic, generated by any non-identity element). -/
theorem zpowers_eq_of_prime_card {G : Type*} [Group G] [Finite G] {R : Subgroup G}
    (hp : (Nat.card ↥R).Prime) {r : G} (hr : r ∈ R) (hr1 : r ≠ 1) :
    Subgroup.zpowers r = R := by
  have hle : Subgroup.zpowers r ≤ R := (Subgroup.zpowers_le).mpr hr
  have hord : orderOf r = Nat.card ↥R := by
    rcases (Nat.dvd_prime hp).mp (R.orderOf_dvd_natCard hr) with h1 | h
    · exact absurd (orderOf_eq_one_iff.mp h1) hr1
    · exact h
  exact Subgroup.eq_of_le_of_card_ge hle (le_of_eq (by rw [Nat.card_zpowers, hord]))

/-- **BG Theorem 3.4, step 2-3 (B1): the centraliser of the chosen irreducible meets the prime-order
complement trivially.**  With `C_V(R) = 0` (the `S03b` idiom `∀ v, (∀ r, ρ r v = v) → v = 0`) and
`W ≠ ⊥` a subrepresentation, the kernel `N = C_G(W) = ker (W.toRepresentation.asGroupHom)` satisfies
`N ⊓ R = ⊥`: a non-identity `r ∈ N ⊓ R` generates `R` (prime order, `zpowers_eq_of_prime_card`), so
`R ≤ N` and all of `R` fixes `W` pointwise; a nonzero `w ∈ W` is then fixed by all of `R`,
contradicting `C_V(R) = 0`.  Supplies the `hNR` hypothesis of
`normal_le_of_complement_prime_of_inf_eq_bot` in the proof of Theorem 3.4. -/
private lemma ker_subrep_inf_complement_prime_eq_bot
    {F : Type*} [Field F] {G : Type*} [Group G] [Finite G]
    {V : Type*} [AddCommGroup V] [Module F V]
    (ρ : Representation F G V) (W : Subrepresentation ρ) (hWne : W ≠ ⊥)
    {R : Subgroup G} (hp : (Nat.card ↥R).Prime)
    (hCV : ∀ v : V, (∀ r : ↥R, ρ (r : G) v = v) → v = 0) :
    MonoidHom.ker (W.toRepresentation.asGroupHom) ⊓ R = ⊥ := by
  rw [eq_bot_iff]
  intro r hr
  rw [Subgroup.mem_inf] at hr
  obtain ⟨hrN, hrR⟩ := hr
  rw [Subgroup.mem_bot]
  by_contra hr1
  -- `r ≠ 1` generates `R`, so `R ≤ N = ker (asGroupHom)`
  have hgen : Subgroup.zpowers r = R := zpowers_eq_of_prime_card hp hrR hr1
  have hRker : R ≤ MonoidHom.ker (W.toRepresentation.asGroupHom) := by
    rw [← hgen]; exact (Subgroup.zpowers_le).mpr hrN
  -- pick a nonzero `w ∈ W`
  have hWsub : W.toSubmodule ≠ ⊥ := by
    intro h; exact hWne (Subrepresentation.toSubmodule_injective (by rw [h]; rfl))
  obtain ⟨w, hwW, hw0⟩ := (Submodule.ne_bot_iff _).mp hWsub
  -- all of `R` fixes `w`
  have hfix : ∀ r' : ↥R, ρ ((r' : G)) w = w := by
    intro r'
    have hWr' : W.toRepresentation (r' : G) = 1 := by
      rw [← Representation.asGroupHom_apply, MonoidHom.mem_ker.mp (hRker r'.2), Units.val_one]
    have hval : W.toRepresentation (r' : G) ⟨w, hwW⟩ = ⟨w, hwW⟩ := by rw [hWr']; rfl
    exact congrArg Subtype.val hval
  exact hw0 (hCV w hfix)

/-- **BG Theorem 3.4, step 3 (C): the complement structure descends to `G/N`.**  If `K ◁ G` has
complement `R` and `N ◁ G` with `N ≤ K`, then the images `K.map (mk' N)` and `R.map (mk' N)` are
complementary in `G/N`.  (`K̄ ⊔ R̄ = ⊤` since `mk' N` is surjective and `K ⊔ R = ⊤`; `K̄ ⊓ R̄ = ⊥`
because `mk' k = mk' r` forces `k⁻¹r ∈ N ≤ K`, hence `r ∈ K ⊓ R = ⊥`.)  Used to feed the `G/N`
induction hypothesis in the quotient step. -/
private lemma isComplement'_map_mk' {G : Type*} [Group G] [Finite G] {K N R : Subgroup G}
    [K.Normal] [N.Normal] (hcompl : Subgroup.IsComplement' K R) (hNK : N ≤ K) :
    Subgroup.IsComplement' (K.map (QuotientGroup.mk' N)) (R.map (QuotientGroup.mk' N)) := by
  have : (K.map (QuotientGroup.mk' N)).Normal :=
    (‹K.Normal›).map (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
  refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
  · rw [disjoint_iff, eq_bot_iff]
    rintro y hy
    rw [Subgroup.mem_inf] at hy
    obtain ⟨⟨k, hkK, hk⟩, ⟨r, hrR, hr⟩⟩ := hy
    rw [Subgroup.mem_bot]
    have heq : (QuotientGroup.mk' N) k = (QuotientGroup.mk' N) r := hk.trans hr.symm
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq] at heq
    have hrK : r ∈ K := by
      have hmem : k * (k⁻¹ * r) ∈ K := mul_mem hkK (hNK heq)
      simpa using hmem
    have hrKR : r ∈ K ⊓ R := ⟨hrK, hrR⟩
    rw [disjoint_iff.mp hcompl.disjoint, Subgroup.mem_bot] at hrKR
    rw [← hr, hrKR, map_one]
  · have hsup : K.map (QuotientGroup.mk' N) ⊔ R.map (QuotientGroup.mk' N) = ⊤ := by
      rw [← Subgroup.map_sup, hcompl.sup_eq_top,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)]
    have hmul := Subgroup.normal_mul (K.map (QuotientGroup.mk' N)) (R.map (QuotientGroup.mk' N))
    rw [hsup, Subgroup.coe_top] at hmul
    exact hmul.symm

/-- **BG Theorem 3.4, step 6 (Frobenius construction from a fixed-point-free prime complement).**
If `K ◁ G` has a prime-order complement `R` and *no* nontrivial element of `K` is centralised by all
of `R` (`hFix`, i.e. `C_K(R) = 1`), then `G = KR` is a Frobenius group.  The Frobenius condition
`a k a⁻¹ ≠ k` (for `a ∈ R^#`, `k ∈ K^#`) follows because `a` of prime order generates `R`
(`zpowers_eq_of_prime_card`), so if `a` centralised `k` then so would every power of
`a`, i.e. all of
`R`, forcing `k = 1` by `hFix`.  Used in the elementary-abelian branch of Theorem 3.4 and at
Theorem 3.6 (3.34) (`S03f_Thm36`, building the Frobenius group `⁅K,R₀⁆·R₀`). -/
lemma isFrobeniusGroup_of_prime_complement_fixedFree
    {G : Type*} [Group G] [Finite G] {K R : Subgroup G} [K.Normal]
    (hcompl : Subgroup.IsComplement' K R) (hp : (Nat.card ↥R).Prime) (hKne : K ≠ ⊥)
    (hFix : ∀ k ∈ K, (∀ r ∈ R, r * k * r⁻¹ = k) → k = 1) :
    IsFrobeniusGroup G K R where
  isNormal := ‹K.Normal›
  isComplement := hcompl
  ne_bot_kernel := hKne
  ne_bot_complement :=
    (Subgroup.nontrivial_iff_ne_bot R).mp (Finite.one_lt_card_iff_nontrivial.mp hp.one_lt)
  conj_frobenius := by
    intro a haR ha n hnK hn hconj
    apply hn
    refine hFix n hnK (fun r hrR => ?_)
    have hcomm : Commute a n := by
      have h := congrArg (· * a) hconj
      simpa [commute_iff_eq, mul_assoc] using h
    have hgen : Subgroup.zpowers a = R := zpowers_eq_of_prime_card hp haR ha
    rw [← hgen, Subgroup.mem_zpowers_iff] at hrR
    obtain ⟨j, rfl⟩ := hrR
    rw [(hcomm.zpow_left j).eq, mul_inv_cancel_right]

/-- The image under `K.subtype` of a *proper* subgroup of `↥K` is a proper subgroup of `K`. -/
private lemma map_subtype_lt_of_ne_top {G : Type*} [Group G] {K : Subgroup G}
    {N : Subgroup ↥K} (hN : N ≠ ⊤) : N.map K.subtype < K := by
  refine lt_of_le_of_ne (Subgroup.map_subtype_le N) (fun heq => hN ?_)
  have hKeq : K = (⊤ : Subgroup ↥K).map K.subtype := by
    rw [← MonoidHom.range_eq_map, K.range_subtype]
  exact Subgroup.map_injective K.subtype_injective (heq.trans hKeq)

/-- A subgroup `N ≤ K` that is invariant under the conjugation action `φ = conjNormal ∘ R.subtype`
of `R` is normalised by `R` once pushed forward into `G` (`R ≤ N_G(N.map K.subtype)`).  This is the
bridge from the `IsAInvariant` formulation used by Gorenstein 5.3.7 to the `R ≤ normalizer _`
formulation of `wiring_check`.  (Same computation as in
`exists_proper_aInvariant_iSup_eq_of_not_isPrimePow`.) -/
private lemma le_normalizer_map_subtype_of_isAInvariant {G : Type*} [Group G] {K R : Subgroup G}
    [K.Normal] {N : Subgroup ↥K}
    (hN : OddOrder.Isaacs.Ch03.IsAInvariant
        ((MulAut.conjNormal (G := G) (H := K)).comp R.subtype) N) :
    R ≤ Subgroup.normalizer (N.map K.subtype) := by
  set φ : ↥R →* MulAut ↥K := (MulAut.conjNormal (G := G) (H := K)).comp R.subtype with hφ
  have hval : ∀ (r : ↥R) (k : ↥K), (((φ r) k : ↥K) : G) = (r : G) * (k : G) * (r : G)⁻¹ := by
    intro r k
    simp only [hφ, MonoidHom.comp_apply, Subgroup.coe_subtype, MulAut.conjNormal_apply]
  have hvalinv : ∀ (r : ↥R) (k : ↥K), (((φ r)⁻¹ k : ↥K) : G) = (r : G)⁻¹ * (k : G) * (r : G) := by
    intro r k
    simp only [hφ, MonoidHom.comp_apply, Subgroup.coe_subtype]
    exact MulAut.conjNormal_inv_apply (r : G) k
  intro r hr
  rw [Subgroup.mem_normalizer_iff]
  intro y
  constructor
  · rintro ⟨k, hk, rfl⟩
    refine ⟨(φ ⟨r, hr⟩) k, hN.smul_mem ⟨r, hr⟩ hk, ?_⟩
    simp only [Subgroup.coe_subtype]
    rw [hval ⟨r, hr⟩ k]
  · rintro ⟨k, hk, hkn⟩
    refine ⟨(φ ⟨r, hr⟩)⁻¹ k, hN.inv_smul_mem ⟨r, hr⟩ hk, ?_⟩
    simp only [Subgroup.coe_subtype] at hkn ⊢
    rw [hvalinv ⟨r, hr⟩ k, hkn]
    group

open OddOrder.RepresentationTheory OddOrder.RepresentationTheory.EigenspaceUnderCyclicAction
  OddOrder.BG.Ch1.S04 OddOrder.GroupTheory in
/-- **BG Theorem 3.4, group-order strong-induction core** (algebraically closed `F`).

`Nat.card G = n` での強帰納法. 結論は `∀ g ∈ ⁅R, K⁆, ρ g = 1` (= `[R,K] ⊆ C_K(V)`,
`[R,K] ⊆ K` は `K` 正規より自動). `C_V(R) = 0` は `∀ v, (∀ r:R, ρ r v = v) → v = 0` (S03b idiom).

Hall 条件は `Coprime |K| |R|` で表現 (`R` 素数位数 ⟹ `|R| ∤ |K|`). -/
private theorem thm34_aux : ∀ (n : ℕ)
    {F : Type*} [Field F] [IsAlgClosed F]
    {G : Type*} [Group G] [Finite G] [Group.IsSolvable G]
    {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : Representation F G V) (K R : Subgroup G) [K.Normal],
    Subgroup.IsComplement' K R →
    Nat.Coprime (Nat.card ↥K) (Nat.card ↥R) →
    (∃ p : ℕ, p.Prime ∧ Nat.card ↥R = p) →
    Odd (Nat.card G) →
    (Nat.card G : F) ≠ 0 →
    (∀ v : V, (∀ r : ↥R, ρ (r : G) v = v) → v = 0) →
    Nat.card G = n →
    ∀ g ∈ ⁅R, K⁆, ρ g = 1 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n IH =>
    intro F _ _ G _ _ _ V _ _ _ ρ K R _ hcompl hHall hRp hodd hchar hCV hn
    -- IH-WIRING CHECK (subgroup branch, BG step 1): for a proper `R`-invariant `H < K`, the group
    -- `HR = H ⊔ R` satisfies the hypotheses with `|HR| < |G|`, so IH gives `[H,R] ⊆ C`.
    have wiring_check : ∀ H : Subgroup G, H < K → R ≤ Subgroup.normalizer H →
        ∀ g ∈ ⁅R, H⁆, ρ g = 1 := by
      intro H hHltK hHRnorm
      have hHK : H ≤ K := hHltK.le
      have : Finite ↥(H ⊔ R) := inferInstance
      have : Group.IsSolvable ↥(H ⊔ R) := inferInstance
      have hHRle : (H ⊔ R) ≤ Subgroup.normalizer H := sup_le Subgroup.le_normalizer hHRnorm
      have hHnormHR : (H.subgroupOf (H ⊔ R)).Normal :=
        Subgroup.normal_subgroupOf_of_le_normalizer hHRle
      have hRcard : Nat.card ↥(R.subgroupOf (H ⊔ R)) = Nat.card ↥R :=
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe (le_sup_right)).toEquiv
      have hHcard : Nat.card ↥(H.subgroupOf (H ⊔ R)) = Nat.card ↥H :=
        Nat.card_congr (Subgroup.subgroupOfEquivOfLe (le_sup_left)).toEquiv
      have hHRdvd : Nat.card ↥(H ⊔ R) ∣ Nat.card G := Subgroup.card_subgroup_dvd_card _
      have hchar' : (Nat.card ↥(H ⊔ R) : F) ≠ 0 := by
        obtain ⟨m, hm⟩ := hHRdvd
        intro h0; apply hchar; rw [hm, Nat.cast_mul, h0, zero_mul]
      have hodd' : Odd (Nat.card ↥(H ⊔ R)) := by
        obtain ⟨m, hm⟩ := hHRdvd; rw [hm, Nat.odd_mul] at hodd; exact hodd.1
      have hRp' : ∃ p : ℕ, p.Prime ∧ Nat.card ↥(R.subgroupOf (H ⊔ R)) = p := by
        obtain ⟨p, hp, hpc⟩ := hRp; exact ⟨p, hp, hRcard.trans hpc⟩
      have hHall' : Nat.Coprime (Nat.card ↥(H.subgroupOf (H ⊔ R)))
          (Nat.card ↥(R.subgroupOf (H ⊔ R))) := by
        rw [hHcard, hRcard]; exact hHall.coprime_dvd_left (Subgroup.card_dvd_of_le hHK)
      have hCV' : ∀ v : V, (∀ r : ↥(R.subgroupOf (H ⊔ R)),
          (ρ.comp (H ⊔ R).subtype) (r : ↥(H ⊔ R)) v = v) → v = 0 := by
        intro v hv
        refine hCV v fun r => ?_
        have hrHR : (r : G) ∈ (H ⊔ R) := (le_sup_right : R ≤ H ⊔ R) r.2
        have hmem : (⟨(r : G), hrHR⟩ : ↥(H ⊔ R)) ∈ R.subgroupOf (H ⊔ R) := by
          rw [Subgroup.mem_subgroupOf]; exact r.2
        simpa using hv ⟨⟨(r : G), hrHR⟩, hmem⟩
      have hcompl' : Subgroup.IsComplement' (H.subgroupOf (H ⊔ R)) (R.subgroupOf (H ⊔ R)) := by
        refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ ?_ ?_
        · refine disjoint_iff.mpr (eq_bot_iff.mpr fun x hx => ?_)
          rw [Subgroup.mem_inf] at hx
          simp only [Subgroup.mem_subgroupOf] at hx
          have hmem : (x : G) ∈ H ⊓ R := ⟨hx.1, hx.2⟩
          have hdisjHR : Disjoint H R := hcompl.disjoint.mono_left hHK
          rw [hdisjHR.eq_bot, Subgroup.mem_bot] at hmem
          rw [Subgroup.mem_bot]; exact Subtype.ext (by simpa using hmem)
        · have hsup : (H.subgroupOf (H ⊔ R)) ⊔ (R.subgroupOf (H ⊔ R)) = ⊤ := by
            rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right, Subgroup.subgroupOf_self]
          have hmul := Subgroup.normal_mul (H.subgroupOf (H ⊔ R)) (R.subgroupOf (H ⊔ R))
          rw [hsup, Subgroup.coe_top] at hmul
          exact hmul.symm
      have hcardHR : Nat.card ↥(H ⊔ R) < n := by
        have e1 : Nat.card ↥(H.subgroupOf (H ⊔ R)) * Nat.card ↥(R.subgroupOf (H ⊔ R))
            = Nat.card ↥(H ⊔ R) := hcompl'.card_mul_card
        have e2 : Nat.card ↥K * Nat.card ↥R = Nat.card G := hcompl.card_mul_card
        rw [hHcard, hRcard] at e1
        have hHlt : Nat.card ↥H < Nat.card ↥K := by
          have hdvd := Subgroup.card_dvd_of_le hHK
          refine lt_of_le_of_ne (Nat.le_of_dvd Nat.card_pos hdvd) (fun heq => ?_)
          exact (ne_of_lt hHltK) (Subgroup.eq_of_le_of_card_ge hHK heq.ge)
        rw [← hn, ← e2, ← e1]
        exact mul_lt_mul_of_pos_right hHlt Nat.card_pos
      have hIH := IH (Nat.card ↥(H ⊔ R)) hcardHR (ρ.comp (H ⊔ R).subtype)
        (H.subgroupOf (H ⊔ R)) (R.subgroupOf (H ⊔ R)) hcompl' hHall' hRp' hodd' hchar' hCV' rfl
      -- `hIH : ∀ g' ∈ ⁅R.subgroupOf (H⊔R), H.subgroupOf (H⊔R)⁆, (ρ.comp (H⊔R).subtype) g' = 1`.
      -- Pull back along `(H⊔R).subtype`: `⁅R,H⁆ = ⁅R',H'⁆.map subtype`, so every `g ∈ ⁅R,H⁆`
      -- lifts to a `g' ∈ ⁅R',H'⁆` with `ρ g = (ρ.comp subtype) g' = 1`.
      intro g hg
      have hmap : (⁅R, H⁆ : Subgroup G)
          = (⁅R.subgroupOf (H ⊔ R), H.subgroupOf (H ⊔ R)⁆).map (H ⊔ R).subtype := by
        rw [Subgroup.map_commutator, Subgroup.subgroupOf_map_subtype,
          Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr le_sup_right,
          inf_eq_left.mpr le_sup_left]
      rw [hmap, Subgroup.mem_map] at hg
      obtain ⟨g', hg'mem, hg'eq⟩ := hg
      rw [← hg'eq]
      exact hIH g' hg'mem
    -- `|R|` is prime; `char F ∤ |G|` gives the Maschke hypothesis `NeZero (|G| : F)`.
    obtain ⟨p, hp, hpcard⟩ := hRp
    have hRp' : (Nat.card ↥R).Prime := hpcard ▸ hp
    have : NeZero (Nat.card G : F) := ⟨hchar⟩
    -- **Minimal counterexample**: suppose `[R, K] ⊄ C_K(V)`.
    by_contra hRK
    -- **step 4**: then `|K|` is a prime power (else `K` is generated by proper
    -- `R`-invariant Sylows).
    have hKpp : IsPrimePow (Nat.card ↥K) :=
      thm34_isPrimePow_of_minimal ρ hHall.symm wiring_check hRK
