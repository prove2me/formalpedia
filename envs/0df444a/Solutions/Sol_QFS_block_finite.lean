end QFS

open QFS

variable {d : ℕ}

/-- Blocks are finite, so "maximal size" in Definition 5.11 is meaningful. -/
theorem solution {ℓ : ℝ} (hℓ : 0 ≤ ℓ) (x : EuclideanSpace ℝ (Fin d)) :
    (QFS.block ℓ x).Finite :=
  (QFS.lattice_inter_closedBall_finite x (ℓ / 2 * Real.sqrt d)).subset
    (Set.inter_subset_inter Set.Subset.rfl (QFS.closedCube_subset_closedBall hℓ x))
