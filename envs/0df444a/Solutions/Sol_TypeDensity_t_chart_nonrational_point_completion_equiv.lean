    (Λ : (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) →+* (ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0))
    (hΛT : Λ ((chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (surfaceT O pi u a b)) =
      surfaceT (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) ((substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0)
    (hΛO : Λ.comp (((chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))).comp (algebraMap O (ConcreteSurface O pi u a b))) =
      (algebraMap (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0))).comp
        (algebraMap O (AdjoinRoot Φ)))
    (hΛZ : Λ ((chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))) =
      surfaceX (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) ((substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0 +
        algebraMap (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ))
    (x : (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))) :
    x ∈ P ↔ Λ x ∈ surfaceParameterIdeal (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi)
      ((substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0 := by
  obtain ⟨_, _, hdvr, -, hirr, -, -, -⟩ := unramified_is_dvr O Φ hΦ
  have := hdvr
  have hpiδ : Irreducible (algebraMap O (AdjoinRoot Φ) pi) := hirr pi hpi
  have hab : 0 < a + b := by omega
  have : IsLocalRing ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) :=
    concrete_surface_isLocalRing _ _ _ _ _ hpiδ.not_isUnit hab
  have hmax := concrete_surface_maximalIdeal_eq _ _ hpiδ ((substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0 hab
  have : (Ideal.span ({surfaceT O pi u a b, surfaceX O pi u a b} :
      Set (ConcreteSurface O pi u a b))).IsMaximal :=
    concrete_surface_parameterIdeal_isMaximal O pi hpi u a b ha
  have hirrR := unramified_lift_map_parameter_quotient_irreducible O pi hpi u a b ha Φ hΦ
  rw [← Polynomial.map_map] at hirrR
  obtain ⟨-, hspan⟩ := chart_nonrational_point_span_eq_comap _ _ _
    (Φ.map (algebraMap O (ConcreteSurface O pi u a b))) hirrR _ Λ
    (by rw [hΛT, hmax]; exact Ideal.subset_span (Set.mem_insert _ _)) (by
      -- `Φ(x' + θ) ≡ Φ(θ) = 0` modulo `x'`
      rw [Polynomial.eval₂_map, Polynomial.hom_eval₂, hΛO, hΛZ, hmax]
      obtain ⟨k, hk⟩ := Polynomial.sub_dvd_eval_sub (surfaceX (AdjoinRoot Φ)
        (algebraMap O (AdjoinRoot Φ) pi) ((substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0 + algebraMap
          (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ))
        (algebraMap (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ))
        (Φ.map ((algebraMap (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0))).comp
          (algebraMap O (AdjoinRoot Φ))))
      have hF0 : Φ.eval₂ ((algebraMap (AdjoinRoot Φ) ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0))).comp
          (algebraMap O (AdjoinRoot Φ))) (algebraMap (AdjoinRoot Φ)
            ((ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ)) = 0 := by
        rw [← Polynomial.hom_eval₂, show Φ.eval₂ (algebraMap O (AdjoinRoot Φ))
          (AdjoinRoot.root Φ) = 0 from AdjoinRoot.eval₂_root Φ, map_zero]
      rw [Polynomial.eval_map, Polynomial.eval_map, hF0, sub_zero, add_sub_cancel_right] at hk
      rw [hk]; exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
  rw [← hmax, ← Ideal.mem_comap, ← hspan, hP, Polynomial.eval₂_map]

end TypeDensity

open TypeDensity

theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] (pi : O) (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ) (a b : ℕ)
    (ha : 0 < a) [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] (Φ : Polynomial O) (hΦ : TypeDensity.IsUnramifiedLift O Φ)
    (hθ : IsUnit (AdjoinRoot.root Φ)) (P : Ideal ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)))) [P.IsPrime]
    (hP : P = Ideal.span
      {(TypeDensity.chartBase (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)) (TypeDensity.surfaceT O pi u a b),
      Polynomial.eval₂ (((TypeDensity.chartBase (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))).comp (algebraMap O (TypeDensity.ConcreteSurface O pi u a b)))
          ((TypeDensity.chartSlope (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) Φ}) :
    ∃ Eq : TypeDensity.CompletedLocalAt ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P ≃+* (TypeDensity.ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0),
      (∀ s : TypeDensity.TwoSeries O,
        Eq (TypeDensity.completedPointMap ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P ((TypeDensity.chartBase (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)) (TypeDensity.surfaceMk O pi u a b s))) =
          TypeDensity.surfaceMk (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) ((TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0
            (TypeDensity.chartSubst (AdjoinRoot Φ) (AdjoinRoot.root Φ)
              (MvPowerSeries.map (algebraMap O (AdjoinRoot Φ)) s))) ∧
      Eq (TypeDensity.completedPointMap ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P ((TypeDensity.chartSlope (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)))) =
        TypeDensity.surfaceX (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) ((TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b)) (a + b) 0 +
          algebraMap (AdjoinRoot Φ) ((TypeDensity.ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ) ∧
      (∀ c : O,
        Eq (TypeDensity.completedPointMap ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P
            ((TypeDensity.chartBase (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)) (algebraMap O (TypeDensity.ConcreteSurface O pi u a b) c))) =
          algebraMap (AdjoinRoot Φ) ((TypeDensity.ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0))
            (algebraMap O (AdjoinRoot Φ) c)) ∧
      Polynomial.eval₂ ((TypeDensity.completedPointMap ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P).comp
          (((TypeDensity.chartBase (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))).comp (algebraMap O (TypeDensity.ConcreteSurface O pi u a b))))
        (Eq.symm (algebraMap (AdjoinRoot Φ) ((TypeDensity.ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ)))
        Φ = 0 ∧
      Eq.symm (algebraMap (AdjoinRoot Φ) ((TypeDensity.ConcreteSurface (AdjoinRoot Φ) (algebraMap O (AdjoinRoot Φ) pi) (TypeDensity.substUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) (TypeDensity.baseChangeUnit O (algebraMap O (AdjoinRoot Φ)) u) * TypeDensity.shiftUnit (AdjoinRoot Φ) (AdjoinRoot.root Φ) hθ ^ b) (a + b) 0)) (AdjoinRoot.root Φ)) -
          TypeDensity.completedPointMap ((TypeDensity.BlowupChart (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) P ((TypeDensity.chartSlope (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b))) ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime P)).map
          (TypeDensity.localCompletionMap (Localization.AtPrime P)) := by
  obtain ⟨_, _, hdvr, -, hirr, -, -, -⟩ := TypeDensity.unramified_is_dvr O Φ hΦ
  have := hdvr
  set θ := AdjoinRoot.root Φ
  set ρ := algebraMap O (AdjoinRoot Φ)
  set uδ := TypeDensity.substUnit (AdjoinRoot Φ) θ (TypeDensity.baseChangeUnit O ρ u) * TypeDensity.shiftUnit (AdjoinRoot Φ) θ hθ ^ b
  set R := TypeDensity.ConcreteSurface O pi u a b
  set Rδ := TypeDensity.ConcreteSurface (AdjoinRoot Φ) (ρ pi) uδ (a + b) 0
  set A := TypeDensity.BlowupChart R (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)
  set cb := TypeDensity.chartBase R (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)
  set Z := TypeDensity.chartSlope R (TypeDensity.surfaceT O pi u a b) (TypeDensity.surfaceX O pi u a b)
  set cpm := TypeDensity.completedPointMap A P
  set aδ := algebraMap (AdjoinRoot Φ) Rδ
  set Xδ := TypeDensity.surfaceX (AdjoinRoot Φ) (ρ pi) uδ (a + b) 0
  have hpiδ : Irreducible (ρ pi) := hirr pi hpi
  have hab : 0 < a + b := by omega
  have : IsLocalRing Rδ := TypeDensity.concrete_surface_isLocalRing _ _ _ _ _ hpiδ.not_isUnit hab
  have : IsNoetherianRing A := TypeDensity.blowupChart_concrete_isNoetherianRing O pi u a b _ _
  -- The chart substitution `s = chartSubst θ ∘ map ρ` and the chart map `Λ : A → Rδ` it induces.
  obtain ⟨hsC0, hsT0, hsX0, -⟩ := TypeDensity.chartSubst_apply_generators (AdjoinRoot Φ) θ
  set s := (TypeDensity.chartSubst (AdjoinRoot Φ) θ).toRingHom.comp (MvPowerSeries.map ρ)
  have hsC : ∀ c : O, s (MvPowerSeries.C c) = MvPowerSeries.C (ρ c) := fun c =>
    (congrArg (TypeDensity.chartSubst (AdjoinRoot Φ) θ) (MvPowerSeries.map_C _ _)).trans (hsC0 _)
  have hsE : s (TypeDensity.axisT O) = TypeDensity.axisT (AdjoinRoot Φ) :=
    (congrArg (TypeDensity.chartSubst (AdjoinRoot Φ) θ) (MvPowerSeries.map_X _ _)).trans hsT0
  have hsF : s (TypeDensity.axisX O) = TypeDensity.axisT (AdjoinRoot Φ) * (TypeDensity.axisX (AdjoinRoot Φ) + MvPowerSeries.C θ) :=
    (congrArg (TypeDensity.chartSubst (AdjoinRoot Φ) θ) (MvPowerSeries.map_X _ _)).trans hsX0
  have hs : s (TypeDensity.surfaceRelation O pi u a b) = TypeDensity.surfaceRelation (AdjoinRoot Φ) (ρ pi) uδ (a + b) 0 :=
    (TypeDensity.chartSubst_surfaceRelation_base_change_and_x_chart O (AdjoinRoot Φ) ρ pi u a b).1 θ hθ
  obtain ⟨Λ, hΛ, hΛZ⟩ : ∃ Λ : A →+* Rδ, (∀ g : TypeDensity.TwoSeries O,
      Λ (cb (TypeDensity.surfaceMk O pi u a b g)) = TypeDensity.surfaceMk (AdjoinRoot Φ) (ρ pi) uδ (a + b) 0 (s g)) ∧
      Λ Z = Xδ + aδ θ := TypeDensity.chart_child_map_exists O (AdjoinRoot Φ) pi u a b (ρ pi) uδ (a + b) 0
    (TypeDensity.axisT O) (TypeDensity.axisX O) s (hs ▸ Ideal.mem_span_singleton_self _) θ hsE hsF
  have hΛC : ∀ c : O, Λ (cb (algebraMap O R c)) = aδ (ρ c) :=
    fun c ↦ (hΛ (MvPowerSeries.C c)).trans (congrArg _ (hsC c))
  have hΛCc : Λ.comp (cb.comp (algebraMap O R)) = aδ.comp ρ := RingHom.ext hΛC
  -- `P` is the preimage of the maximal ideal of `Rδ`; pass to the completion.
  have hP' := TypeDensity.nonrational_point_mem_iff O pi hpi u a b ha Φ hΦ hθ P hP Λ
    (by have := hΛ (TypeDensity.axisT O); rw [hsE] at this; exact this) hΛCc hΛZ
  obtain ⟨Λ', hΛ'⟩ := TypeDensity.chart_child_completion_map_exists A (AdjoinRoot Φ) (ρ pi) hpiδ uδ
    (a + b) 0 hab Λ P hP'
  have hloc' := TypeDensity.chart_child_completion_map_local A (AdjoinRoot Φ) (ρ pi) hpiδ uδ
    (a + b) 0 hab Λ P hP' Λ' hΛ'
  -- The Hensel root `θ'` of `Φ` maps to `θ`, so `θ ↦ θ'` extends `O → completion` to `κ`.
  obtain ⟨θ', hroot, hcong⟩ := TypeDensity.nonrational_point_hensel_root O pi hpi u a b ha Φ hΦ P hP
  set κO := cpm.comp (cb.comp (algebraMap O R))
  have hΛ'κO : Λ'.comp κO = aδ.comp ρ := by rw [← hΛCc]; ext c; exact hΛ' _
  set κ := AdjoinRoot.lift κO θ' hroot with hκdef
  have hκ := TypeDensity.nonrational_point_root_lift O pi hpi u a b ha Φ hΦ hθ P Λ' hΛ'κO
    ((hΛ' _).trans hΛZ) θ' hroot ((hloc' _).1 hcong)
  obtain ⟨E, hE, hEs⟩ : ∃ E : TypeDensity.CompletedLocalAt A P ≃+* Rδ,
      (∀ y, E y = Λ' y) ∧ ∀ c, E.symm (aδ c) = κ c :=
    @TypeDensity.chart_child_completion_equiv O (AdjoinRoot Φ) _ _ _ _ _ pi u a b (ρ pi)
    hpiδ uδ (a + b) 0 hab (TypeDensity.axisT O) (TypeDensity.axisX O) (Or.inl ⟨rfl, rfl⟩) ρ θ s hsC hsE hsF hs Λ hΛ hΛZ P
    ‹_› hP'
    (TypeDensity.nonrational_point_residue_surjective O pi u a b Φ hθ Λ hΛ hΛZ) Λ' hΛ' κ hκ
    fun c => AdjoinRoot.lift_of (h := hroot)
  have hEθ : E.symm (aδ (AdjoinRoot.root Φ)) = θ' := by
    rw [hEs]; exact AdjoinRoot.lift_root (h := hroot)
  refine ⟨E, fun g => ((hE _).trans (hΛ' _)).trans (hΛ g), ((hE _).trans (hΛ' _)).trans hΛZ,
    fun c => ((hE _).trans (hΛ' _)).trans (hΛC c), ?_, ?_⟩
  · rw [hEθ]; exact hroot
  · rw [hEθ]; exact hcong
