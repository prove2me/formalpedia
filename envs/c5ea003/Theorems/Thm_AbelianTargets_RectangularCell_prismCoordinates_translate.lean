variable {d : ℕ}

theorem AbelianTargets.RectangularCell.prismCoordinates_translate (R : RectangularCell d) (a : Fin d→ℤ) (i : Fin d)
    (r : I) (v : ConeBall (R.ActiveTransverse i→ℝ)) :
    (R.translate a).prismCoordinates i r (R.translateConeBall a i v)=
      translateCoordinates a (R.prismCoordinates i r v) := by sorry
