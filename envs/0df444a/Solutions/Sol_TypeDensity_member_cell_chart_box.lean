  -- along the child coordinate map; transport measurability and measure along this square
  intro E hE G hG
  set Φ := fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J
  set Ψ := fun (w : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) (j : (m.toMeasured.childIdx c)) => coordinateIdeal (mc j).toMeasured.S.pi (g j) (bc' j) (ρ w j)
  set ch := childCoordinateMap (m.toMeasured.S.pi) a bc E (pulledVariation (AlgHom.pi alpha) cc b)
  set sc := coordinateScale (n := (m.toMeasured.s.degree)) (m.toMeasured.S.pi) (s + a - 1)
  have hpiIrr : Irreducible (m.toMeasured.S.pi) := m.toMeasured.S.pi_irreducible
  have hf' : AlgHom.pi alpha f = e ^ (m.toMeasured.cellDegree c) * g := by
    funext j; simp [AlgHom.pi_apply, hg j]
  obtain ⟨hjac, heC⟩ := member_children_jacobson_regular m c mc hpiO e he
  -- completeness of the coordinate modules
  have hOc : IsAdicComplete (Ideal.span {(m.toMeasured.S.pi)}) (m.toMeasured.O) := dvr_isAdicComplete_span_uniformizer _ _ hpiIrr
  have hOn : IsAdicComplete (Ideal.span {(m.toMeasured.S.pi)}) (Fin (m.toMeasured.s.degree) → (m.toMeasured.O)) := finite_free_adic_complete _ _ _
  have hC := member_children_isAdicComplete m c mc hpiO
  have hprod : IsAdicComplete (Ideal.span {(m.toMeasured.S.pi)}) ((Fin (m.toMeasured.s.degree) → (m.toMeasured.O)) × (∀ j, (mc j).toMeasured.R)) := isAdicComplete_prod _ _ _ _
  -- product chart and linear part
  obtain ⟨hproj, -, hinjP⟩ := product_chart_projection (m.toMeasured.O) (m.toMeasured.childIdx c) (fun j => (mc j).toMeasured.O)
    (fun j => (mc j).toMeasured.R) (fun j => (mc j).toMeasured.s.degree) _ ρ bc' bc hcompat g _ _
    hpiO
  have hΨ : Function.Injective (coordinateIdeal (m.toMeasured.S.pi) g bc) := hinjP fun j =>
    (concrete_member_division_chart_measure (mc j) (g j) (hgj j) (bc' j) (E' j) (hE' j)).1
  obtain ⟨Q, hQ, hD, hkl⟩ := member_center_linear_part m c mc hcard alpha e he hbij hindex hsum
    s hs cc hcc f b E₀ hE₀ hf g hg bc E hE
  have htri : tri (m.toMeasured.cellDegree c) ≤ s * (m.toMeasured.s.degree) :=
    le_trans hs (Nat.le_mul_of_pos_right s (concrete_member_one_le_degree m))
  obtain ⟨hgen, hHaar, hProb, hfinite, hcontall⟩ :=
    coefficient_space_strict_instances (m.toMeasured.O) m.toMeasured.htop (m.toMeasured.S.pi) hpiIrr (m.toMeasured.s.degree)
  have hk : s * (m.toMeasured.s.degree) - tri (m.toMeasured.cellDegree c) < a := by omega
  have hΨm : Measurable Ψ := child_chart_map_measurable m c mc g hgj bc' E' hE' ρ hρ
  set T := Ψ ⁻¹' Set.pi Set.univ G
  have hT : MeasurableSet T := hΨm (MeasurableSet.univ_pi hG)
  -- the strict transform commutes with the coordinate charts
  have hcomm : ∀ z, strictTransformIdeal (AlgHom.pi alpha) e (m.toMeasured.cellDegree c) (coordinateIdeal (m.toMeasured.S.pi) f b (sc z)) =
      coordinateIdeal (m.toMeasured.S.pi) g bc (ch z) :=
    strict_chart_coordinates_commute _ _ _ _ _ s a _ _ f g e cc b hf' hcc heC (by omega) hjac bc E
      hE
  have hcommC : ∀ z, Φ (coordinateIdeal (m.toMeasured.S.pi) f b (sc z)) = Ψ (ch z) := fun z => by
    funext j; simp only [Φ, Ψ]
    rw [← (pi_strict_transform_map_eval _ _ _ _ alpha e g _ _).2.2.2 j, hcomm z, hproj]
  have hL : coordinateIdeal (m.toMeasured.S.pi) f b ⁻¹' (Φ ⁻¹' Set.pi Set.univ G) ∩ Set.range sc =
      sc '' (ch ⁻¹' T) := by
    ext x; constructor
    · rintro ⟨hx, z, rfl⟩; exact ⟨z, (hcommC z ▸ hx : Ψ (ch z) ∈ Set.pi Set.univ G), rfl⟩
    · rintro ⟨z, hz, rfl⟩; exact ⟨(hcommC z ▸ hz : Φ _ ∈ Set.pi Set.univ G), z, rfl⟩
  obtain ⟨hrangeM, hpreM⟩ := member_childCoordinateMap_measurable m a bc E
    (pulledVariation (AlgHom.pi alpha) cc b) _ hk Q hQ
  have himgS : strictTransformIdeal (AlgHom.pi alpha) e (m.toMeasured.cellDegree c) '' (coordinateIdeal (m.toMeasured.S.pi) f b '' Set.range sc)
      = coordinateIdeal (m.toMeasured.S.pi) g bc '' Set.range ch := by
    rw [Set.image_image, ← Set.range_comp, ← Set.range_comp]
    exact congrArg Set.range (funext hcomm)
  refine ⟨hrangeM, ?_, ?_, ?_⟩
  · rw [hL]
    exact measurableSet_coordinateScale_image _ hgen (smul_right_injective _ hpiIrr.ne_zero) _ _
      (hpreM T hT)
  · rw [Set.image_image, ← Set.range_comp, ← Set.range_comp]
    exact congrArg Set.range (funext hcommC)
  · rw [hL, ← strict_chart_preimage_set_identity _ _ _ _ _ s a _ _ f g e cc b hf' hcc heC
      (by omega) hjac bc E hE hΨ T, strict_transform_translate_measure _ _ _ _ _ s a _ _ f g e cc b
      hf' hcc heC (by omega) hjac bc E hE hΨ _ hk Q hQ hD hpiIrr hkl hgen _ hfinite (hcontall a _)
      (fun k S _ => coordinate_scale_measure _ m.toMeasured.htop _ hpiIrr _ k S) htri rfl T hT,
      himgS, ← Set.image_inter hΨ, Set.preimage_image_eq _ hΨ]

include pc hpc hpc' hdeg hstrict in
/-- The coefficient measure of the center box of parent coordinates whose strict transforms lie in
  `Π G_j` is `q^(-tri(cellDegree)) q^(deg)` times the product child measure of the part of `Π G_j`
  reached from the center box. -/
private theorem member_center_box_measure
    (s : ℕ) (hs : tri (m.toMeasured.cellDegree c) ≤ s) (cc : (∀ j, (mc j).toMeasured.R)) (hcc : (algebraMap (m.toMeasured.O) (∀ j, (mc j).toMeasured.R) (m.toMeasured.S.pi)) ^ s = e ^ (m.toMeasured.cellDegree c) * cc)
    (f : (m.toMeasured.R)) (b : Fin (m.toMeasured.s.degree) → (m.toMeasured.R)) (E₀ : (m.toMeasured.R) ≃ₗ[(m.toMeasured.O)] ((Fin (m.toMeasured.s.degree) → (m.toMeasured.O)) × (m.toMeasured.R))) (hE₀ : ∀ w, E₀.symm w = divisionMap f b w)
    (hf : Ideal.span {f} ∈ m.toMeasured.cell c) (a : ℕ) (ha : a = s * (m.toMeasured.s.degree) - tri (m.toMeasured.cellDegree c) + 1)
    (G : ∀ j, Set (Ideal (mc j).toMeasured.R)) (hG : ∀ j, MeasurableSet (G j)) :
    MeasurableSet (coordinateIdeal (m.toMeasured.S.pi) f b ⁻¹' ((fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) ⁻¹' Set.pi Set.univ G) ∩
      (Set.range (coordinateScale (m.toMeasured.S.pi) (s + a - 1)))) ∧
    MeasurableSet ((fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) '' (coordinateIdeal (m.toMeasured.S.pi) f b '' (Set.range (coordinateScale (m.toMeasured.S.pi) (s + a - 1))))) ∧
    coefficientMeasure (m.toMeasured.O) (m.toMeasured.s.degree)
      (coordinateIdeal (m.toMeasured.S.pi) f b ⁻¹' ((fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) ⁻¹' Set.pi Set.univ G) ∩ (Set.range (coordinateScale (m.toMeasured.S.pi) (s + a - 1)))) =
      ((m.toMeasured.q : ℝ≥0∞))⁻¹ ^ tri (m.toMeasured.cellDegree c) * ((m.toMeasured.q : ℝ≥0∞)) ^ (m.toMeasured.s.degree) * Measure.pi (fun j => (mc j).toMeasured.μ)
        (Set.pi Set.univ G ∩ (fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) '' (coordinateIdeal (m.toMeasured.S.pi) f b '' (Set.range (coordinateScale (m.toMeasured.S.pi) (s + a - 1))))) := by
  obtain ⟨g, hg⟩ := hstrict f hf
  have hgj : ∀ j, Ideal.span {g j} ∈ (mc j).toMeasured.stateSet := fun j => by
    simpa [strict_transform_ideal_of_generator _ _ _ (alpha j) (e j) (g j) _ f (hg j)
      (concrete_member_mul_t_injective (he j))] using hbij.mapsTo hf j (Set.mem_univ _)
  choose bc' E' hE' using fun j => concrete_member_state_generator_division (mc j) (g j) (hgj j)
  obtain ⟨ρ, bc, hρ, hρ', hcompat⟩ := product_coordinates_exist (m.toMeasured.O) (m.toMeasured.childIdx c) (fun j => (mc j).toMeasured.O)
    (fun j => (mc j).toMeasured.R) (m.toMeasured.childDelta c) (fun j => (mc j).toMeasured.s.degree)
    pc hpc hpc' (m.toMeasured.s.degree) hdeg bc'
  obtain ⟨E, hE⟩ := product_division_equiv (m.toMeasured.O) (m.toMeasured.childIdx c) (fun j => (mc j).toMeasured.O)
    (fun j => (mc j).toMeasured.R) (fun j => (mc j).toMeasured.s.degree) (m.toMeasured.s.degree) ρ bc' bc hcompat g E' hE'
  obtain ⟨h1, h2, h3, h4⟩ := member_center_translate_measure_data m c mc hcard hpiO alpha e he
    hbij hindex hsum s hs cc hcc f b E₀ hE₀ hf g hg hgj bc' E' hE' ρ hρ bc hcompat a ha E hE G hG
  obtain ⟨hemb, hpush⟩ := member_product_chart_pushforward (m.toMeasured.childIdx c) mc g hgj bc' E' hE'
  set T := Set.range (childCoordinateMap (m.toMeasured.S.pi) a bc E (pulledVariation (AlgHom.pi alpha) cc b))
  set Ψ := fun (w : ∀ j, Fin (mc j).toMeasured.s.degree → (mc j).toMeasured.O) (j : (m.toMeasured.childIdx c)) =>
    coordinateIdeal (mc j).toMeasured.S.pi (g j) (bc' j) (w j)
  have hρT : MeasurableSet (ρ '' T) := by
    rw [LinearEquiv.image_eq_preimage_symm]; exact hρ' h1
  have himg : (fun (w : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) (j : (m.toMeasured.childIdx c)) => coordinateIdeal (mc j).toMeasured.S.pi (g j) (bc' j)
      (ρ w j)) '' T = Ψ '' (ρ '' T) := by
    rw [Set.image_image]
  refine ⟨h2, ?_, ?_⟩
  · rw [h3, himg]; exact hemb.measurableSet_image' hρT
  · rw [h4, h3, himg]
    set Y := ρ '' T ∩ Ψ ⁻¹' Set.pi Set.univ G
    have hYm : MeasurableSet Y := hρT.inter (hemb.measurable (MeasurableSet.univ_pi hG))
    have hpre : (fun (w : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) (j : (m.toMeasured.childIdx c)) => coordinateIdeal (mc j).toMeasured.S.pi (g j) (bc' j)
        (ρ w j)) ⁻¹' Set.pi Set.univ G ∩ T = ρ ⁻¹' Y := by
      rw [Set.preimage_inter, Set.preimage_image_eq _ ρ.injective, Set.inter_comm]; rfl
    have hC : (∏ j, ((mc j).toMeasured.q : ℝ≥0∞)⁻¹ ^ (mc j).toMeasured.s.degree) = ((m.toMeasured.q : ℝ≥0∞))⁻¹ ^ (m.toMeasured.s.degree) := by
      simp_rw [hcard, Nat.cast_pow, ENNReal.inv_pow, ← pow_mul]
      rw [Finset.prod_pow_eq_pow_sum, hdeg]
    rw [hpre, ← Measure.map_apply hρ hYm,
      member_coefficient_measure_map_product_coordinates m c mc ρ hρ,
      ← Set.inter_comm, ← Set.image_inter_preimage, hpush Y hYm, hC, mul_assoc,
      ← mul_assoc (((m.toMeasured.q : ℝ≥0∞)) ^ _), concreteMember_q_pow_mul_inv_pow, one_mul]

end CellBoxes
end TypeDensity

open TypeDensity
open MeasureTheory
open scoped BigOperators ENNReal
variable (m : ConcreteMember) (c : m.toMeasured.cellIndex)
    (mc : m.toMeasured.childIdx c → ConcreteMember)
variable [∀ j, Algebra m.toMeasured.O (mc j).toMeasured.O]
    [∀ j, Algebra m.toMeasured.O (mc j).toMeasured.R]
    [∀ j, IsScalarTower m.toMeasured.O (mc j).toMeasured.O (mc j).toMeasured.R]
    (pc : ∀ j, (mc j).toMeasured.O ≃ₗ[m.toMeasured.O]
      (Fin (m.toMeasured.childDelta c j) → m.toMeasured.O))
    (hpc : ∀ j, Measurable (pc j)) (hpc' : ∀ j, Measurable (pc j).symm)
    (hcard : ∀ j, (mc j).toMeasured.q = m.toMeasured.q ^ m.toMeasured.childDelta c j)
    (hpiO : ∀ j, algebraMap m.toMeasured.O (mc j).toMeasured.O m.toMeasured.S.pi =
      (mc j).toMeasured.S.pi)
    (hdeg : ∑ j, m.toMeasured.childDelta c j * (mc j).toMeasured.s.degree = m.toMeasured.s.degree)
    (alpha : ∀ j, m.toMeasured.R →ₐ[m.toMeasured.O] (mc j).toMeasured.R)
    (e : ∀ j, (mc j).toMeasured.R) (he : ∀ j, e j = (mc j).toMeasured.S.t)
    (hvert : ∀ j, ∃ (s : ℕ) (cj : (mc j).toMeasured.R),
      algebraMap m.toMeasured.O (mc j).toMeasured.R m.toMeasured.S.pi ^ s =
      e j ^ m.toMeasured.cellDegree c * cj)
    (hbij : Set.BijOn
      (fun (J : Ideal m.toMeasured.R) (j : m.toMeasured.childIdx c) => strictTransformIdeal
      (alpha j) (e j) (m.toMeasured.cellDegree c) J) (m.toMeasured.cell c)
      (Set.pi Set.univ fun j => (mc j).toMeasured.stateSet))
    (hstrict : ∀ f : m.toMeasured.R, Ideal.span {f} ∈ m.toMeasured.cell c →
      ∃ g : (∀ j, (mc j).toMeasured.R), ∀ j, alpha j f = e j ^ m.toMeasured.cellDegree c * g j)
    (hindex : ∀ f : m.toMeasured.R, Ideal.span {f} ∈ m.toMeasured.cell c →
      ∀ g : (∀ j, (mc j).toMeasured.R), (∀ j, alpha j f = e j ^ m.toMeasured.cellDegree c * g j) →
      ∀ iota : (m.toMeasured.R ⧸ Ideal.span {f}) →ₗ[m.toMeasured.O]
      ((∀ j, (mc j).toMeasured.R) ⧸ Ideal.span {g}),
      (∀ h : m.toMeasured.R, iota (Ideal.Quotient.mk (Ideal.span {f}) h) =
      Ideal.Quotient.mk (Ideal.span {g}) (fun j => alpha j h)) → Function.Injective iota ∧
      Module.length m.toMeasured.O
      (((∀ j, (mc j).toMeasured.R) ⧸ Ideal.span {g}) ⧸ LinearMap.range iota) =
      (chooseTwo (m.toMeasured.cellDegree c) : ℕ∞))
    (hsum : ∑ j, m.toMeasured.childDelta c j * (mc j).toMeasured.s.firstContact =
      m.toMeasured.cellDegree c)
include hcard hpiO he hbij hindex hsum
open scoped Classical
include pc hpc hpc' hdeg hstrict

theorem solution (s : ℕ) (hs : TypeDensity.tri (m.toMeasured.cellDegree c) ≤ s) (cc : (∀ j, (mc j).toMeasured.R))
    (hcc : (algebraMap (m.toMeasured.O) (∀ j, (mc j).toMeasured.R) (m.toMeasured.S.pi)) ^ s = e ^ (m.toMeasured.cellDegree c) * cc) (a : ℕ) (ha : a = s * (m.toMeasured.s.degree) - TypeDensity.tri (m.toMeasured.cellDegree c) + 1)
    (reps : Finset (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) (hrdisj : (reps : Set (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))).PairwiseDisjoint (TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1)))
    (i : m.atlas.ι)
    (hdec : TypeDensity.memberChart m i ⁻¹' m.toMeasured.cell c =
      ⋃ z₀ ∈ reps.filter (fun z₀ => TypeDensity.memberChart m i z₀ ∈ m.toMeasured.cell c),
        TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1) z₀)
    (G : ∀ j, Set (Ideal (mc j).toMeasured.R)) (hG : ∀ j, MeasurableSet (G j)) :
    MeasurableSet (TypeDensity.memberChart m i ⁻¹' (m.toMeasured.cell c ∩ (fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => TypeDensity.strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) ⁻¹' Set.pi Set.univ G)) ∧
    TypeDensity.coefficientMeasure (m.toMeasured.O) (m.toMeasured.s.degree)
        (TypeDensity.memberChart m i ⁻¹' (m.toMeasured.cell c ∩ (fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => TypeDensity.strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) ⁻¹' Set.pi Set.univ G)) =
      ((m.toMeasured.q : ℝ≥0∞))⁻¹ ^ TypeDensity.tri (m.toMeasured.cellDegree c) * ((m.toMeasured.q : ℝ≥0∞)) ^ (m.toMeasured.s.degree) *
        ∑ z₀ ∈ reps.filter (fun z₀ => TypeDensity.memberChart m i z₀ ∈ m.toMeasured.cell c),
        Measure.pi (fun j => (mc j).toMeasured.μ) (Set.pi Set.univ G ∩
          (fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => TypeDensity.strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) '' (TypeDensity.memberChart m i '' TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1) z₀)) ∧
    ∀ z₀ ∈ reps.filter (fun z₀ => TypeDensity.memberChart m i z₀ ∈ m.toMeasured.cell c),
      MeasurableSet ((fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => TypeDensity.strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J) '' (TypeDensity.memberChart m i '' TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1) z₀)) := by
  set Φ := fun (J : Ideal (m.toMeasured.R)) (j : (m.toMeasured.childIdx c)) => TypeDensity.strictTransformIdeal (alpha j) (e j) (m.toMeasured.cellDegree c) J
  have := TypeDensity.concrete_member_division_module_isAdicComplete m
  -- `Φi` is the chart, `F` the representatives of the cell in it, and `Φp z₀` the chart recentred
  -- at `z₀`; the chart preimage of the box is the union of the translated center boxes `A z₀`
  let fi : (m.toMeasured.R) := (m.atlas.chart i).f
  let bi : Fin (m.toMeasured.s.degree) → (m.toMeasured.R) := (m.atlas.chart i).b
  set Φi := TypeDensity.memberChart m i
  set F := reps.filter (fun z₀ => Φi z₀ ∈ m.toMeasured.cell c)
  let Φp (z₀ : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O)) → Ideal (m.toMeasured.R) := TypeDensity.coordinateIdeal (m.toMeasured.S.pi) (fi + (m.toMeasured.S.pi) • TypeDensity.coordinateLift bi z₀) bi
  have Tr := fun z₀ => TypeDensity.member_chart_translate m fi bi (s + a - 1) z₀
  set Y := Set.pi Set.univ G
  set Rg := Set.range (TypeDensity.coordinateScale (n := (m.toMeasured.s.degree)) (m.toMeasured.S.pi) (s + a - 1))
  let A (z₀ : (Fin (m.toMeasured.s.degree) → (m.toMeasured.O))) : Set (Fin (m.toMeasured.s.degree) → (m.toMeasured.O)) := (fun z => z₀ + z) '' (Φp z₀ ⁻¹' (Φ ⁻¹' Y) ∩ Rg)
  -- the center box measure applies at every representative
  have hC : ∀ z₀ ∈ F, MeasurableSet (Φp z₀ ⁻¹' (Φ ⁻¹' Y) ∩ Rg) ∧
      MeasurableSet (Φ '' (Φp z₀ '' Rg)) ∧
      TypeDensity.coefficientMeasure (m.toMeasured.O) (m.toMeasured.s.degree) (Φp z₀ ⁻¹' (Φ ⁻¹' Y) ∩ Rg) =
        ((m.toMeasured.q : ℝ≥0∞))⁻¹ ^ TypeDensity.tri (m.toMeasured.cellDegree c) * ((m.toMeasured.q : ℝ≥0∞)) ^ (m.toMeasured.s.degree) *
          Measure.pi (fun j => (mc j).toMeasured.μ) (Y ∩ Φ '' (Φp z₀ '' Rg)) := by
    intro z₀ hz₀
    have hf : Ideal.span {fi + (m.toMeasured.S.pi) • TypeDensity.coordinateLift bi z₀} ∈ m.toMeasured.cell c := by
      have h0 := (Tr z₀).1 0
      rw [add_zero] at h0
      have : TypeDensity.coordinateIdeal (m.toMeasured.S.pi) fi bi z₀ = Ideal.span {fi + (m.toMeasured.S.pi) • TypeDensity.coordinateLift bi z₀} := by
        rw [h0]
        simp [TypeDensity.coordinateIdeal, TypeDensity.normalizedIdeal, TypeDensity.normalizedGenerator, TypeDensity.coordinateLift]
      rw [← this]; exact (Finset.mem_filter.mp hz₀).2
    obtain ⟨E₀, hE₀⟩ := @TypeDensity.division_data_vertical_perturbation (m.toMeasured.O) (m.toMeasured.R) _ _ _ (m.toMeasured.s.degree) (m.toMeasured.S.pi) fi bi
      (m.atlas.chart i).E (m.atlas.chart i).division this (TypeDensity.coordinateLift bi z₀)
    exact TypeDensity.member_center_box_measure m c mc pc hpc hpc' hcard hpiO hdeg alpha e he hbij
      hstrict hindex hsum s hs cc hcc _ bi E₀ hE₀ hf a ha G hG
  have hPeq (z₀) : Φp z₀ '' Rg = Φi '' TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1) z₀ := by
    rw [(Tr z₀).2.1, Set.image_image]
    exact congrArg (· '' Rg) (funext fun w => ((Tr z₀).1 w).symm)
  have hXi : Φi ⁻¹' (m.toMeasured.cell c ∩ Φ ⁻¹' Y) = ⋃ z₀ ∈ F, A z₀ :=
    TypeDensity.preimage_inter_eq_biUnion_translate Φi Φp _ _ Rg F _ (fun z₀ => (Tr z₀).1)
      (fun z₀ => (Tr z₀).2.1) hdec
  have hAdisj : (F : Set _).PairwiseDisjoint A := by
    intro z₀ hz z₀' hz' hne
    have hsub : ∀ z₁, A z₁ ⊆ TypeDensity.coordinateCoset (m.toMeasured.S.pi) (s + a - 1) z₁ := fun z₁ => by
      rw [(Tr z₁).2.1]; exact Set.image_mono Set.inter_subset_right
    exact (hrdisj (Finset.mem_filter.mp hz).1 (Finset.mem_filter.mp hz').1 hne).mono (hsub z₀)
      (hsub z₀')
  have hAmeas : ∀ z₀ ∈ F, MeasurableSet (A z₀) := fun z₀ hz => ((Tr z₀).2.2 _).2 (hC z₀ hz).1
  refine ⟨?_, ?_, fun z₀ hz => hPeq z₀ ▸ (hC z₀ hz).2.1⟩
  · rw [hXi]; exact Finset.measurableSet_biUnion _ hAmeas
  · rw [hXi, measure_biUnion_finset hAdisj hAmeas, Finset.mul_sum]
    refine Finset.sum_congr rfl fun z₀ hz => ?_
    rw [← hPeq]
    exact ((Tr z₀).2.2 _).1.trans (hC z₀ hz).2.2
