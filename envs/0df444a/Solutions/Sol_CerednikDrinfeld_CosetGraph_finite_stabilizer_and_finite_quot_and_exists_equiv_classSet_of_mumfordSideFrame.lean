theorem solution

    {a₁ b₁ : ℚ} {N q q' : ℕ} [NeZero N] (hN : Squarefree N) [Fact q.Prime] [Fact q'.Prime]
    (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q) (hq5 : 5 ≤ q) (hq'5 : 5 ≤ q')

    (r rbar : ℕ) [Fact r.Prime] [Fact rbar.Prime] (hrN : ¬ r ∣ N) (hrbarN : ¬ rbar ∣ N) (hrrbar : rbar ≠ r)
    (hr5 : 5 ≤ r) (hrbar5 : 5 ≤ rbar)
    (hdef₁ : IsDefiniteRamifiedExactlyAt a₁ b₁ rbar)
    (Λ₁ R₁ : Submodule ℤ ℍ[ℚ, a₁, b₁]) (hΛ₁ : IsMaximalOrder Λ₁) (hR₁ : IsEichlerOrder R₁ N) (hRΛ₁ : R₁ ≤ Λ₁)
    (n₁ : (ℍ[ℚ, a₁, b₁] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) (hn₁ : n₁ ∈ primeHeckeSet R₁ r)
    (hS₁ : IsEichlerOrder (meetOrder R₁ n₁) (N * r))
    (hnorm₁ : Submodule.conjByFiniteIdele (meetOrder R₁ n₁) n₁ = meetOrder R₁ n₁)
    (hsq₁ : ∀ x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₁ n₁)),
      classSetShift _ n₁ (classSetShift _ n₁ x) = x)
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₁ n₁)))]
    [Fintype (ClassSet (Submodule.finiteIdeleStabilizer R₁))]
    [DecidableEq (ClassSet (Submodule.finiteIdeleStabilizer R₁))]
    (A₂ : ValuationSubring (AlgebraicClosure ℚ)) (hA₂ : A₂.LiesOverPrime r)
    (v₂ : HeightOneSpectrum (𝓞 ℚ)) (hv₂ : ((r : ℕ) : 𝓞 ℚ) ∈ v₂.asIdeal)

    (ι₂ : ℍ[ℚ, a₁, b₁] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A₂)) (hι₂ : Function.Injective ι₂)
    (ρ₂ : (ℍ[ℚ, a₁, b₁])ˣ →* PGL(2, ↥(ValuationSubring.ratClosure A₂)))
    (hρ₂ : ∀ x : (ℍ[ℚ, a₁, b₁])ˣ, ρ₂ x = Matrix.ProjGenLinGroup.mk (Units.map (ι₂ : ℍ[ℚ, a₁, b₁] →* Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A₂)) x))
    (s₂ : HeckeTower.AwayPrime q q' → (ℍ[ℚ, a₁, b₁])ˣ)
    (sf₂ : HeckeTower.AwayPrime q q' → (ℍ[ℚ, a₁, b₁] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hs₂ : ∀ ℓ : HeckeTower.AwayPrime q q',
      (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∉ u.asIdeal →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, a₁, b₁] u (sf₂ ℓ : ℍ[ℚ, a₁, b₁] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) =
          (s₂ ℓ : ℍ[ℚ, a₁, b₁]) ⊗ₜ[ℚ] (1 : u.adicCompletion ℚ)) ∧
      (∀ u : HeightOneSpectrum (𝓞 ℚ), ((r : ℕ) : 𝓞 ℚ) ∈ u.asIdeal →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, a₁, b₁] u (sf₂ ℓ : ℍ[ℚ, a₁, b₁] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) = 1) ∧
      Submodule.finiteIdeleDiagonal ℍ[ℚ, a₁, b₁]
          (Units.map (algebraMap ℚ ℍ[ℚ, a₁, b₁]).toMonoidHom
            (Units.mk0 ((ℓ.1 : ℕ) : ℚ) (Nat.cast_ne_zero.mpr ℓ.1.prop.ne_zero))) * (sf₂ ℓ)⁻¹ ∈
        (if (ℓ.1 : ℕ) ∣ N then levelHeckeUSet Λ₁ (meetOrder R₁ n₁) (ℓ.1 : ℕ)
          else primeHeckeSet (meetOrder R₁ n₁) (ℓ.1 : ℕ)) ∧
      nrd (s₂ ℓ : ℍ[ℚ, a₁, b₁]) = ((ℓ.1 : ℕ) : ℚ))

    (R₀ : Type) [CommRing R₀] [IsDomain R₀] [IsDiscreteValuationRing R₀]
    [Algebra R₀ ↥(ValuationSubring.ratClosure A₂)] [IsFractionRing R₀ ↥(ValuationSubring.ratClosure A₂)]
    (hR₀ : ∀ x : ↥(ValuationSubring.ratClosure A₂), x ∈ Set.range (algebraMap R₀ ↥(ValuationSubring.ratClosure A₂)) ↔
      Valued.v (algebraMap ↥(ValuationSubring.ratClosure A₂) A₂.valuation.Completion x) ≤ 1)

    [MulAction (ℍ[ℚ, a₁, b₁])ˣ (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))]
    (hact : ∀ (g : (ℍ[ℚ, a₁, b₁])ˣ) (x : LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)), g • x = ρ₂ g • x)
    [Mumford.GraphAction (ℍ[ℚ, a₁, b₁])ˣ (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))] :

    (∀ d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart,
      Finite (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) d) ∧
      ¬ ringChar (IsLocalRing.ResidueField ↥(Valued.v.valuationSubring : ValuationSubring A₂.valuation.Completion)) ∣
        Nat.card (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) d)) ∧
    (∀ (ℓ : HeckeTower.AwayPrime q q') (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart),
      Finite (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits (meetOrder R₁ (sf₂ ℓ)) v₂).map ρ₂)) d) ∧
      ¬ ringChar (IsLocalRing.ResidueField ↥(Valued.v.valuationSubring : ValuationSubring A₂.valuation.Completion)) ∣
        Nat.card (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits (meetOrder R₁ (sf₂ ℓ)) v₂).map ρ₂)) d)) ∧

    (Finite (Mumford.QuotVert (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) ∧
      Finite (Mumford.QuotEdge (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)))) ∧
    (∀ ℓ : HeckeTower.AwayPrime q q',
      Finite (Mumford.QuotVert (CerednikDrinfeld.CosetGraph.awayUnits (meetOrder R₁ (sf₂ ℓ)) v₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) ∧
      Finite (Mumford.QuotEdge (CerednikDrinfeld.CosetGraph.awayUnits (meetOrder R₁ (sf₂ ℓ)) v₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)))) ∧

    (∃ (εV : Mumford.QuotVert (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) ≃
          ClassSet (Submodule.finiteIdeleStabilizer R₁))
       (εE : Mumford.QuotEdge (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) ≃
          ClassSet (Submodule.finiteIdeleStabilizer (meetOrder R₁ n₁))),
      (∀ e, εV ((Mumford.quotientDegeneracyData (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))).a e) =
        (classSetDegeneracyData R₁ n₁).a (εE e)) ∧
      (∀ e, εV ((Mumford.quotientDegeneracyData (CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))).b e) =
        (classSetDegeneracyData R₁ n₁).b (εE e)) ∧
      (∀ d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart,
        Nat.card (MulAction.stabilizer (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) d) =
          (classSetDegeneracyData R₁ n₁).w
            (εE (Quotient.mk (MulAction.orbitRel (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) d)))) := by
  classical
  have hr : r.Prime := Fact.out
  have hRo : IsOrder R₁ := hR₁.isOrder
  have hSo : IsOrder (meetOrder R₁ n₁) := hS₁.isOrder

  obtain ⟨e, ψ, he_coe, hψ_coe, he_smul, he_card⟩ :=
    CerednikDrinfeld.CosetGraph.exists_iso_tree_ratClosure_smul_eq_and_natCard_stabilizer_mapDart_eq
      hdef₁ hR₁ hrrbar.symm hrN v₂ hv₂ hn₁ A₂ hA₂ R₀ hR₀ ι₂ hι₂ ρ₂ hρ₂
  obtain ⟨eV, eE, heV, heE, ha, hb, hw⟩ :=
    CerednikDrinfeld.CosetGraph.exists_quotVert_equiv_classSet_and_quotEdge_equiv_classSet_of_isEichlerOrder
      rbar hrbar5 hdef₁ N hN Λ₁ R₁ hΛ₁ hR₁ hRΛ₁ r hrrbar.symm hrN v₂ hv₂ n₁ hn₁ hS₁ hnorm₁ hsq₁

  have hactD : ∀ (g : (ℍ[ℚ, a₁, b₁])ˣ) (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart), g • d = ρ₂ g • d :=
    fun g d => SimpleGraph.Dart.ext _ _ (Prod.ext (hact g d.fst) (hact g d.snd))
  have hRV : ∀ x y : LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂), MulAction.orbitRel (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) x y ↔
      MulAction.orbitRel (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) x y := HeckeMSI.orbitRel_iff_map ρ₂ hact _
  have hRD : ∀ x y : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart, MulAction.orbitRel (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart x y ↔
      MulAction.orbitRel (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart x y := HeckeMSI.orbitRel_iff_map ρ₂ hactD _

  have he_smulD : ∀ (γ : CosetGraph.ProjAwayUnits R₁ v₂) (d : (CosetGraph.graph R₁ v₂ (Units.map (Submodule.finiteAdeleEvalAt ℍ[ℚ, a₁, b₁] v₂).toRingHom.toMonoidHom n₁)).Dart),
      HeckeMSI.dartEquiv e (γ • d) = ψ γ • HeckeMSI.dartEquiv e d :=
    fun γ d => SimpleGraph.Dart.ext _ _ (Prod.ext (he_smul γ d.fst) (he_smul γ d.snd))
  let eVq : Mumford.QuotVert (CosetGraph.ProjAwayUnits R₁ v₂) (CosetGraph.Vert R₁ v₂) ≃ Mumford.QuotVert (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) :=
    HeckeMSI.quotEquiv e.toEquiv ψ he_smul
  let eDq : Mumford.QuotEdge (CosetGraph.ProjAwayUnits R₁ v₂) (CosetGraph.graph R₁ v₂ (Units.map (Submodule.finiteAdeleEvalAt ℍ[ℚ, a₁, b₁] v₂).toRingHom.toMonoidHom n₁)) ≃ Mumford.QuotEdge (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) :=
    HeckeMSI.quotEquiv (HeckeMSI.dartEquiv e) ψ he_smulD
  let iV : Mumford.QuotVert (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) ≃ Mumford.QuotVert (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) :=
    HeckeMSI.quotEquivOfIff _ _ hRV
  let iD : Mumford.QuotEdge (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) ≃ Mumford.QuotEdge (↥((CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂).map ρ₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) :=
    HeckeMSI.quotEquivOfIff _ _ hRD
  let εV : Mumford.QuotVert (↥(CerednikDrinfeld.CosetGraph.awayUnits R₁ v₂)) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂)) ≃ ClassSet (Submodule.finiteIdeleStabilizer R₁) :=
