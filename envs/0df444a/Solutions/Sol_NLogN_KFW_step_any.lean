theorem stT_one (t S0 p : ℕ) (hp : p < t) :
    KFH.stT 1 t S0 0 (t - 1 - p) = 2 ^ p * S0 := by
  rw [KFH.stT, KFH.stS_eq 1 t S0 _ (by omega), pow_zero, one_mul, pow_one]
