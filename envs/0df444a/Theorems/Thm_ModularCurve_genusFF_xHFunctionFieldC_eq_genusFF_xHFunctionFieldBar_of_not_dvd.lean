open AlgebraicCurve ModularCurve

theorem ModularCurve.genusFF_xHFunctionFieldC_eq_genusFF_xHFunctionFieldBar_of_not_dvd
    (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) {ℓ : ℕ} [Fact ℓ.Prime] (hℓM : ¬ ℓ ∣ M)
    (k : Type*) [Field k] [IsAlgClosed k] [CharP k ℓ] :
    genusFF k (ModularCurve.xHFunctionFieldC k M H) =
      genusFF (AlgebraicClosure ℚ) (ModularCurve.xHFunctionFieldBar M H) := by sorry
