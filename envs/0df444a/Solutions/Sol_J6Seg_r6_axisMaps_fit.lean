open Complex

namespace NLogN.KFM

open IntMul.OpenAI.RT

/-! ### Reindexing contractions -/

lemma norm_reidx_le {α β : Type} [Fintype α] [Fintype β] (σ : β → α) : ‖reidx σ‖ ≤ 1 :=
  ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun u => by
    rw [one_mul]
    exact (pi_norm_le_iff_of_nonneg (norm_nonneg _)).2 fun j => norm_le_pi_norm u (σ j)

/-! ### The permutation-free procedure and the single-axis statement -/

lemma reidx_tauT_permT (s t : ℕ) [NeZero t] (hcop : Nat.Coprime s t) (y : ZMod t → ℂ) :
    reidx (tauT s t) (IntMul.OpenAI.RH.permT s t y) = y := by
  funext k
  simp only [reidx_apply, tauT, IntMul.OpenAI.RH.permT]
  congr 1
  rw [mul_neg, neg_neg, ← mul_assoc, ZMod.coe_mul_inv_eq_one s hcop, one_mul]

lemma B_unPt (s t : ℕ) [NeZero s] [NeZero t] (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ))
    (c : ℕ → ℂ) (l : ZMod s) :
    B (fun k : ZMod t => c (tauT s t ((k.val : ℕ) : ZMod t)).val) ((t : ZMod s) * l) =
      B0of s t B (fun k => c k.val) l := by
  simp only [B0of, ContinuousLinearMap.comp_apply, reidx_apply]
  have e : (fun k : ZMod t => c (tauT s t ((k.val : ℕ) : ZMod t)).val) =
      reidx (tauT s t) (fun k => c k.val) := by
    funext k; simp only [reidx_apply, ZMod.natCast_zmod_val]
  rw [e]

lemma permS_B0of (s t : ℕ) [NeZero s] [NeZero t] (hcop : Nat.Coprime s t)
    (B : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)) (c : ℂ) (y : ZMod t → ℂ) :
    IntMul.OpenAI.RH.permS s t (c • B y) =
      c • B0of s t B (IntMul.OpenAI.RH.permT s t y) := by
  funext l
  simp only [IntMul.OpenAI.RH.permS, Pi.smul_apply, B0of, ContinuousLinearMap.comp_apply,
    reidx_apply, reidx_tauT_permT s t hcop]

