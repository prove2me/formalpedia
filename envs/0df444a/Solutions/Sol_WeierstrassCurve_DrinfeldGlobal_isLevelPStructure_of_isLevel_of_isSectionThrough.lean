theorem isLevelPStructure_of_through
    (A : Type) [CommRing A] (𝒢 : GroupLaws A) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (𝒯 : LevelTransport A 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    {T : Type} [CommRing T] [Algebra A T] (hq : IsUnit ((q : ℕ) : T))
    (W : WeierstrassCurve.Projective T) [WeierstrassCurve.IsElliptic W]
    (u : RawDrinfeldPair T) (hu : RawDrinfeldPair.IsLevel 𝒢 q W u)
    (D : ModularCurve.LevelPData T) (hP : IsSectionThrough u.P D.xP D.yP) (hQ : IsSectionThrough u.Q D.xQ D.yQ) :
    ModularCurve.IsLevelPStructure W q D := by
  obtain ⟨hc, hΔ, hbasis⟩ := hu
  obtain ⟨hiPQ, hiQP⟩ := RawDrinfeldPair.IsLevel.isUnit_indepElt_of_isSectionThrough q hq2 A 𝒢 h𝒢 h𝒢O 𝒯 h𝒯 W hq
    u ⟨hc, hΔ, hbasis⟩ D.xP D.yP D.xQ D.yQ hP hQ
  subst hc
  have htors := IsDrinfeldBasis.nsmul_eq_one_and_nsmul_eq_one u.curve (𝒢 T u.curve hΔ) (h𝒢 T u.curve hΔ) q u.P u.Q hbasis
  have hpreP := (nsmul_eq_one_iff_eval_prePsi_eq_zero_of_isSectionThrough 𝒢 h𝒢 h𝒢O q hq2 T hq u.curve hΔ u.P D.xP D.yP hP).mp htors.1
  have hpreQ := (nsmul_eq_one_iff_eval_prePsi_eq_zero_of_isSectionThrough 𝒢 h𝒢 h𝒢O q hq2 T hq u.curve hΔ u.Q D.xQ D.yQ hQ).mp htors.2
  have heq := (equation_iff_exists_isSectionThrough_and_eq_iff_of_isSectionThrough u.curve).1
  exact ⟨(heq D.xP D.yP).mpr ⟨u.P, hP⟩, (heq D.xQ D.yQ).mpr ⟨u.Q, hQ⟩, hpreP, hpreQ, hiPQ, hiQP⟩

