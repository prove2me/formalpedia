theorem _root_.solution (P R S J : ℕ) (raws : List ℤ) (words maps : List ℕ) (targets : ℕ → ℤ) (positions : ℕ → ℕ)
    (n : ℕ) :
    cells (entries P R S J raws words maps targets positions n) =
      LightTernaryWantedBatch.rows P R S J raws words maps targets positions n :=
  by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [entries, cells_append, ih, LightTernaryWantedBatch.rows]
    congr 1
    simp only [cells, List.flatMap_map, Function.comp_def, TernaryWantedCanonicalPairs.rowCells]
