  have hf0 : f ≠ 0 := gu_ne_zero Rpd.R₁ ⟨h₁, hr₁⟩

  obtain ⟨E, hEx, hsuppE⟩ :=
    ModularCurve.XHDRModelAtP.exists_pic0Mk_eq_forall_isStrict_or_reduceFst_mem_of_prolongationDatum_offDiag_of_wgen
      p M H hpM hpM2 hHp hj 𝔛 A hA ρ hρ pb hpb δ hδ SS hSS θ α hα hβ Psp Rpd hwgen hα_coe hTD hmodel hcompat hcompat'
