open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08R
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII18
theorem solution (j : ℝ) {R : ℝ} (hR : 3 < R) :
    ellE3 j R = R ^ 3 * deriv (d3f j) R + 6 * c3f j R - r3j j (1 / R) / R := by
  have hR0 : (R:ℝ) ≠ 0 := by linarith
  have hq : R ^ 2 * e2A j R = -((3 / 2) * uA j R) := by
    have h := q2A_eq_zero j hR
    unfold q2A at h
    linarith
  have hE1 : 4 * (3 / 2) * b1f j R + 2 * j = -(R ^ 3 * deriv (v1f j) R) := by
    have h := ellE1_eq_zero j hR
    unfold ellE1 at h
    linarith
  have hr3 := r3j_div_eq j hR
  have key : -4 * R ^ 2 * e2A j R * b1f j R + 4 * (3 / 2) * zA j R * b1f j R
      + 2 * j * (uA j R + zA j R)
      = -(uA j R + zA j R) * (R ^ 3 * deriv (v1f j) R) := by
    linear_combination (uA j R + zA j R) * hE1 - (4 * b1f j R) * hq
  unfold ellE3
  rw [hr3]
  have h6 : 4 * (3 / 2) * c3f j R = 6 * c3f j R := by ring
  rw [h6]
  linarith [key]
