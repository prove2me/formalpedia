/-- The ideal toggle: `y ↦ Tl x y`. -/
theorem stT_fsp :
    FSp stT (encK s (KS G0 n ((2 : ℤ) ^ G) x t u y))
      (encK s (KS G0 n ((2 : ℤ) ^ G) x t u (subM l.QL y (-(1 * oT K ρ n x y))))) (cV tmT Bb n) := by
  obtain ⟨LQ, hQ⟩ := hE.ql
  have hT : (1 : ℤ) * (2 : ℤ) ^ ρ * ((2 : ℤ) ^ K) ^ n ≤ (l.QL : ℤ) * l.QL := by
    have := hV.hT; rw [← hV.ql] at this; rw [one_mul]; exact_mod_cast this
  have H := vStep_fsp (segTR_T (Rv := (2 : ℤ) ^ G) (by positivity) hV.R4) s _ (ks_c hV hc hE hx ht hu hy)
    (tgt := ky) (q := kQL) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (KS_ky _ _ _ _ _ _ _) hy hQ (ks_pR hV hc hE hx ht hu hy)
    (ks_pN hV hc hE hx ht hu hy) (eK2 hV hc hE hx ht hu hy) (eK2 hV hc hE hx ht hu hy)
    (eK2 hV hc hE hx ht hu hy) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide)
    (eHi hV hc hE hx ht hu hy (by decide) (KS_kx _ _ _ _ _ _ _) (xM hV hc hE hx ht hu hy))
    (eHi hV hc hE hx ht hu hy (by decide) (KS_ky _ _ _ _ _ _ _) (yM hV hc hE hx ht hu hy))
    (eR2 hV hc hE hx ht hu hy) (by positivity) (by positivity) (hK2 hV hc hE hx ht hu hy)
    (hV.zn (by have := hV.nM; omega)) (by positivity) (by positivity) (by positivity)
    le_rfl hT (hV.q3 le_rfl) (Or.inl rfl)
  rw [KS_updy, oT_tab] at H; exact H

end Steps

end IntMul.Kappa.R6.IL2C

