/-! ## 1. The parameter map -/

/-! ## 2. Elementary facts about `lg` -/

lemma lg_ge (B : ℕ) {n : ℕ} (hn : 2 ^ B ≤ n) : B ≤ bP6 n := by
  have h := Nat.clog_mono_right 2 hn
  rw [Nat.clog_pow 2 B (by norm_num)] at h
  exact h.trans (le_max_left _ _)

/-! ## 3. Facts valid as soon as `b ≥ 4` -/

lemma p_cast (P : Prm) (n : ℕ) :
    (pP6 P n : ℝ) = 6 * (bP6 n : ℝ) ^ ((1 : ℝ) + P.x) := by
  unfold pP6 b'P6
  rw [show ((1 : ℝ) + P.x) = ((1 + P.x : ℕ) : ℝ) by push_cast; ring, Real.rpow_natCast]
  push_cast; ring

/-! ## 4. Eventual facts (box exponent and volume) -/

/-! ## 5. The cost bound -/

/-- `Ncost6` for a single `n` with `b ≥ 4`. -/
theorem Ncost6_le_of (P : Prm) (hP : P.Ok) {n : ℕ} (hb : 4 ≤ bP6 n) :
    Ncost6 P n ≤ Cst P * (IntMul.lg n : ℝ) ^ (1 - P.gap) * (Real.log (IntMul.lg n) + 1) := by
  have hB1 : (1 : ℝ) ≤ bP6 n := by exact_mod_cast bP6_pos n
  have hp1 : (1 : ℝ) ≤ pP6 P n := by
    have := b'P6_pos P n
    have : 1 ≤ pP6 P n := by unfold pP6; omega
    exact_mod_cast this
  exact Ncost6R_le P hP (bP6 n) _ _ _ hB1 hp1 (p_cast P n).le (d_half P hP hb) (d_le_beps P n)
    (Nat.cast_nonneg _) (ell_le_rpow P hP hb)

/-- **`Ncost6 ≤ C lg^(1-gap) (log lg + 1)`** eventually. -/
theorem Ncost6_le_sol_aux (P : Prm) (hP : P.Ok) : ∃ (C : ℝ) (A : ℕ) (n₁ : ℕ), 0 ≤ C ∧ ∀ n, n₁ ≤ n →
    Ncost6 P n ≤ C * (IntMul.lg n : ℝ) ^ (1 - P.gap) * (Real.log (IntMul.lg n) + 1) ^ A := by
  refine ⟨Cst P, 1, 16, by unfold Cst; positivity, fun n hn => ?_⟩
  rw [pow_one]
  exact Ncost6_le_of P hP (lg_ge 4 (by simpa using hn))

end

end IntMul.Kappa.R6

