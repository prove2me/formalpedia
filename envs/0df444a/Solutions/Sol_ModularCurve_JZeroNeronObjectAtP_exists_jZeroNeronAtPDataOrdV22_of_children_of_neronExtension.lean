theorem ModularCurve.degeneracyPushforwardPair_heckeAlg_smul_eq_zero (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p]
    (hpN₀ : ¬ p ∣ N₀) (t : HeckeAlg) (x : JZero (N₀ * p))
    (h0 : degeneracyPushforwardPair N₀ p 0 x = 0) (h1 : degeneracyPushforwardPair N₀ p 1 x = 0) (i : Fin 2) :
    degeneracyPushforwardPair N₀ p i (letI := heckeModuleBar (N₀ * p); t • x) = 0 := by
  letI := heckeModuleBar (N₀ * p)
  have hpp : p.Prime := Fact.out
  have hcomm := ModularCurve.heckeOperatorsCommuteBar (N₀ * p)
  suffices H : degeneracyPushforwardPair N₀ p 0 (t • x) = 0 ∧ degeneracyPushforwardPair N₀ p 1 (t • x) = 0 by
    fin_cases i
    · exact H.1
    · exact H.2
  induction t using MvPolynomial.induction_on with
  | C a =>
      rw [heckeModuleBar_C_smul]
      exact ⟨by rw [map_zsmul, h0, smul_zero], by rw [map_zsmul, h1, smul_zero]⟩
  | add f g hf hg =>
      rw [add_smul]
      exact ⟨by rw [map_add, hf.1, hg.1, add_zero], by rw [map_add, hf.2, hg.2, add_zero]⟩
  | mul_X f ℓ hf =>
      rw [mul_comm f, mul_smul]
      generalize f • x = y at hf
      obtain ⟨hy0, hy1⟩ := hf
      rw [show (MvPolynomial.X ℓ : HeckeAlg) = heckeGen ℓ from rfl, heckeModuleBar_heckeGen_smul hcomm]
      by_cases hℓ : (ℓ : ℕ) = p
      · have hℓ' : ℓ = ⟨p, hpp⟩ := Subtype.ext hℓ
        subst hℓ'
        refine ⟨?_, ?_⟩
        · rw [ModularCurve.degeneracyPushforwardPair_zero_heckeOperatorBar_self N₀ p hpp hpN₀ y, hy0, hy1,
            (heckeOperatorBar N₀ ⟨p, hpp⟩).map_zero, sub_zero]
        · rw [ModularCurve.degeneracyPushforwardPair_one_heckeOperatorBar_self N₀ p hpp y, hy0]
          exact zsmul_zero _
      · have hℓp : ¬ (ℓ : ℕ) ∣ p := fun hd => hℓ ((Nat.prime_dvd_prime_iff_eq ℓ.2 hpp).mp hd)
        refine ⟨?_, ?_⟩
        · rw [ModularCurve.degeneracyPushforwardPair_heckeOperatorBar_of_not_dvd N₀ p (ModularCurve.heckeInputsAll _)
            (ModularCurve.heckeInputsAll _) ℓ hℓp 0 y, hy0]
          exact (heckeOperatorBar N₀ ℓ).map_zero
        · rw [ModularCurve.degeneracyPushforwardPair_heckeOperatorBar_of_not_dvd N₀ p (ModularCurve.heckeInputsAll _)
            (ModularCurve.heckeInputsAll _) ℓ hℓp 1 y, hy1]
          exact (heckeOperatorBar N₀ ℓ).map_zero

