  simp only [if_true, d1, d2, d3, d4, d5, d6, d7, d8, d9, d10, d11, zero_mul, zero_add,
    TypeDensity.Tests.coeff_m4Inert, TypeDensity.Tests.coeff_m4Cubic, TypeDensity.Tests.coeff_m4SplitQuadratic, TypeDensity.Tests.coeff_m4ContactThree,
    TypeDensity.Tests.coeff_m4TangentQuadratic, TypeDensity.Tests.coeff_m4TwoTangent, TypeDensity.Tests.coeff_m4QuadraticContact, TypeDensity.Tests.coeff_m4Contact_at_two,
    TypeDensity.Tests.coeff_m4SplitTangent, TypeDensity.Tests.single_four_law_at_two]
  simp only [TypeDensity.Tests.ite_eq_mul_indicator]
