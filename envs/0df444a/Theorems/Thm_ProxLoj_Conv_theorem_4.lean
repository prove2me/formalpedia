-- title:
--   Theorem 4 (Convergence result), p. 5 — a bounded proximal sequence of a Łojasiewicz function has finite length and converges to a critical point
-- statement:
--   Throughout, $f:\mathbb R^n\to\mathbb R\cup\{+\infty\}$ is proper and lower semicontinuous, $\partial f$ is the limiting subdifferential, $\operatorname{crit} f=\{x: 0\in\partial f(x)\}$, and $(x^k)_{k\in\mathbb N}$ is generated by the proximal algorithm
--   $$x^{k+1}\in\operatorname{argmin}\Big\{f(u)+\frac{1}{2\lambda_k}|u-x^k|^2 : u\in\mathbb R^n\Big\}\qquad(2)$$
--   from an arbitrary $x^0\in\mathbb R^n$, with step sizes $\lambda_k\in(\lambda_-,\lambda_+)$ for fixed $0<\lambda_-<\lambda_+<+\infty$.
--
--   Assume that $f$ satisfies
--
--   1. (H1) $\inf_{\mathbb R^n} f>-\infty$;
--   2. (H2) the restriction of $f$ to its domain is continuous;
--   3. (H3) the Łojasiewicz property: at every critical point $\hat x$ there are $C,\varepsilon>0$ and $\theta\in[0,1)$ with $|f(x)-f(\hat x)|^\theta\le C|x^*|$ for all $x\in B(\hat x,\varepsilon)$, $x^*\in\partial f(x)$ (with $0^0=0$).
--
--   If the sequence $(x^k)_{k\in\mathbb N}$ is bounded, then
--   $$\sum_{k=0}^{+\infty}|x^{k+1}-x^k|<+\infty,$$
--   and the whole sequence $(x^k)$ converges to some critical point $x^\infty\in\operatorname{crit} f$.
--
--   This is the main result of the paper: for nonsmooth, nonconvex functions with the Łojasiewicz property (for example real-analytic functions, or continuous subanalytic ones), boundedness of a proximal sequence is enough for convergence of the whole sequence, not just of a subsequence.
--
--   **Formalization Note** $f$ is `EReal`-valued, never $-\infty$. Boundedness means the range of the sequence is bounded. No hypothesis beyond the page's is added: in particular the proof's reduction $x^{k+1}\neq x^k$ is not assumed.
-- source:
--   Attouch & Bolte, On the convergence of the proximal algorithm for nonsmooth functions involving analytic features, author's version hal-00803898v1, p. 5, Theorem 4

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonsmoothLojasiewicz_Continuous_slope
import Definitions.Def_ProxLoj_Conv_Setting

open Filter Topology NonconvexSplitting.Shared NonsmoothLojasiewicz.Continuous

namespace ProxLoj.Conv

/-- Theorem 4 (Convergence result), p. 5: if `f` is proper, lower semicontinuous and satisfies
(H1), (H2), (H3), every bounded proximal run has finite length and converges to a critical
point of `f`. -/
theorem theorem_4 {n : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal)
    (hproper : IsProper f) (hlsc : LowerSemicontinuous f)
    (hH1 : H1 f) (hH2 : H2 f) (hH3 : HasLojProperty f)
    (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hstep : StepBounds lam lamMinus lamPlus)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsProxRun f lam x)
    (hbdd : Bornology.IsBounded (Set.range x)) :
    Summable (fun k => ‖x (k + 1) - x k‖) ∧
      ∃ xinf ∈ crit f, Tendsto x atTop (𝓝 xinf) := by sorry

end ProxLoj.Conv
