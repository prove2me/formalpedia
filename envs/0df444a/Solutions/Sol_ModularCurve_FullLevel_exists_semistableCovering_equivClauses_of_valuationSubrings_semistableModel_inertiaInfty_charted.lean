theorem fibre_eq_disc_family (C : ComponentChart A F Fbar)
    (disc : Place (ResidueField A) Fbar → Set (Place L F))
    (hdisj : ∀ Q Q', Q ∉ N → Q' ∉ N → ∀ P, P ∈ disc Q → P ∈ disc Q' → Q = Q')
