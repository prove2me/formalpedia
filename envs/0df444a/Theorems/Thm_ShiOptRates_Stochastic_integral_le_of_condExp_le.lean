theorem ShiOptRates.Stochastic.integral_le_of_condExp_le (hm : m ≤ mΩ) [SigmaFinite (μ.trim hm)] {u v : Ω → ℝ}
    (_hu : Integrable u μ) (hv : Integrable v μ) (h : μ[u | m] ≤ᵐ[μ] v) :
    ∫ ω, u ω ∂μ ≤ ∫ ω, v ω ∂μ := by sorry
