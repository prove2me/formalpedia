variable {ι : Type*} [Fintype ι] [DecidableEq ι] {M : Type*} [AddCommMonoid M] [Module ℂ M]

theorem selOpF_pad {st : ι → ℕ} {n np : ℕ} (hs : SLaws st n) (hnp : n ≤ np)
    (T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) {xs : List M} (hl : xs.length = n) (ys : List M) :
    (selOpF st np T (xs ++ ys)).take n = selOpF st n T xs := by
  apply List.ext_getElem (by simp; omega)
  intro j h1 h2
  simp only [length_selOpF] at h2
  rw [List.getElem_take, ← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0,
    getD_selOpF _ _ _ _ (by omega), getD_selOpF _ _ _ _ h2]
  refine Finset.sum_congr rfl fun y _ => ?_
  rw [List.getD_append _ _ _ _ (by rw [hl]; exact hs.lt j h2 y)]

theorem recRep_pad {r F : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r F zs xs) (q : ℕ) :
    RecRep r F (zs ++ List.replicate (q * r) ((0, 0) : GI)) (xs ++ List.replicate q 0) := by
  refine ⟨by simp [h.1]; ring, fun j c hj => ?_⟩
  rw [List.length_append, List.length_replicate] at hj
  have hc := c.isLt
  by_cases hjx : j < xs.length
  · have hjr : j * r + c < zs.length := by
      rw [h.1]
      have : (j + 1) * r ≤ xs.length * r := Nat.mul_le_mul_right _ hjx
      rw [Nat.succ_mul] at this; omega
    rw [List.getD_append _ _ _ _ hjr, List.getD_append _ _ _ _ hjx, h.2 j c hjx]
  · have hjr : zs.length ≤ j * r + c := by
      rw [h.1]
      have : xs.length * r ≤ j * r := Nat.mul_le_mul_right _ (by omega)
      omega
    rw [List.getD_append_right _ _ _ _ hjr, List.getD_append_right _ _ _ _ (by omega)]
    simp [List.getD_eq_getElem?_getD, List.getElem?_replicate, NLogN.KFB.toC]
    split_ifs <;> simp

theorem recRep_take' {r F : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r F zs xs)
    {n : ℕ} (hn : n ≤ xs.length) : RecRep r F (zs.take (n * r)) (xs.take n) := by
  refine ⟨?_, fun j c hj => ?_⟩
  · rw [List.length_take, List.length_take, h.1, Nat.min_eq_left hn,
      Nat.min_eq_left (Nat.mul_le_mul_right _ hn)]
  · rw [List.length_take] at hj
    have hjn : j < n := lt_of_lt_of_le hj (min_le_left _ _)
    have hjx : j < xs.length := lt_of_lt_of_le hj (min_le_right _ _)
    have hjr : j * r + c < n * r := by
      have := c.isLt
      have : (j + 1) * r ≤ n * r := Nat.mul_le_mul_right _ hjn
      rw [Nat.succ_mul] at this; omega
    rw [List.getD_eq_getElem?_getD, List.getElem?_take, if_pos hjr, ← List.getD_eq_getElem?_getD,
      h.2 j c hjx]
    simp [List.getD_eq_getElem?_getD, List.getElem?_take, hjn]

theorem GB_take {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (k : ℕ) : NLogN.KFB.GB w (zs.take k) :=
  fun z hz => h z (List.mem_of_mem_take hz)

theorem GB_drop {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (k : ℕ) : NLogN.KFB.GB w (zs.drop k) :=
  fun z hz => h z (List.mem_of_mem_drop hz)

theorem GB_zeros (w q : ℕ) : NLogN.KFB.GB w (List.replicate q ((0, 0) : GI)) := by
  intro z hz
  rw [List.eq_of_mem_replicate hz]
  simp [zsz_zero]

