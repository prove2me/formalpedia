  have hb1 : (1 : ℝ) ≤ bP6 n := by exact_mod_cast (show 1 ≤ bP6 n by have := hG.b_ge; omega)
  have hm : 1 ≤ (1 - P.ε) * (mExp P : ℝ) := by
    have : 1 / (1 - P.ε) ≤ (mExp P : ℝ) := Nat.le_ceil _
    rw [div_le_iff₀ hpos] at this; linarith
