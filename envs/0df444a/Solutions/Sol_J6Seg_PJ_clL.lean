/-!
# B-line IL, `J` pre-table (B5-J), part 5: register-only loops and the parameter recursions

* `Rn.loopA`: `repeat rN times (asgs l)` (registers only), from a step invariant.
* the four recursions of the parameter phase, as pure invariant lemmas:
  `sqrt` (`sqS_step`), `2^⌊log₂ x⌋` by doubling (`lgS_step`), `Nat.size` by halving
  (`szS_step`), `2^⌈log₂ m⌉` (`clS_step`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS E

/-! ## The recursions -/

/-- One step towards `2^⌈log₂ m⌉` (with `f = min k ⌈log₂ m⌉`). -/
theorem clS_step (m k : ℕ) :
    (if ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ) - m < 0 then 2 * ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ)
      else ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ)) = ((2 ^ min (k + 1) (Nat.clog 2 m) : ℕ) : ℤ) ∧
    (if ((2 ^ min k (Nat.clog 2 m) : ℕ) : ℤ) - m < 0 then ((min k (Nat.clog 2 m) : ℕ) : ℤ) + 1
      else ((min k (Nat.clog 2 m) : ℕ) : ℤ)) = ((min (k + 1) (Nat.clog 2 m) : ℕ) : ℤ) := by
  rcases lt_or_ge k (Nat.clog 2 m) with h | h
  · rw [min_eq_left h.le, min_eq_left h]
    have h1 : 2 ^ k < m := Nat.pow_lt_of_lt_clog h
    have : ((2 ^ k : ℕ) : ℤ) - m < 0 := by
      have : ((2 ^ k : ℕ) : ℤ) < m := by exact_mod_cast h1
      linarith
    rw [if_pos this, if_pos this]; push_cast; constructor <;> ring
  · rw [min_eq_right h, min_eq_right (by omega : Nat.clog 2 m ≤ k + 1)]
    have h1 : m ≤ 2 ^ Nat.clog 2 m := Nat.le_pow_clog (by norm_num) m
    have : ¬ (((2 ^ Nat.clog 2 m : ℕ) : ℤ) - m < 0) := by
      push Not; have : (m : ℤ) ≤ ((2 ^ Nat.clog 2 m : ℕ) : ℤ) := by exact_mod_cast h1
      linarith
    rw [if_neg this, if_neg this]; exact ⟨rfl, rfl⟩

end J6Seg.PJ

end

