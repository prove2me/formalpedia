/-! ## Section 1: Noise smudging -/

/-- The uniform probability mass on a finite set of integers (here indexed by
`ℕ`, i.e. a window of consecutive noise values). -/
def unifMass (S : Finset ℕ) (x : ℕ) : ℝ := if x ∈ S then 1 / (S.card : ℝ) else 0



/-! ## Section 2: Random self-reducibility of the LWE secret -/

variable {n q : ℕ}

/-- An LWE sample value `b = ⟨a, s⟩ + e`. -/
def lweSample (a s : Fin n → ZMod q) (e : ZMod q) : ZMod q := a ⬝ᵥ s + e





/-! ## Section 3: Exact regularity of the inner product `⟨a, s⟩` -/



/-- The inner product with a fixed secret, as a group homomorphism. -/
def dotHom {p n : ℕ} (s : Fin n → ZMod p) : (Fin n → ZMod p) →+ ZMod p where
  toFun a := a ⬝ᵥ s
  map_zero' := by simp
  map_add' a b := by simp [add_dotProduct]


