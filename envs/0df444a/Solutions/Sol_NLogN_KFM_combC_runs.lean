/-! ## Combining two products: `(u ± v).tdiv 2^Δ` pushed on `pO` -/

theorem combC_runs_sol_aux (sub : Bool) (s : IState HS) (u v : ℤ) (Δ : ℕ) (L1 L2 LR : List Item)
    (h1 : s.G pP1 = .int u :: L1) (h2 : s.G pP2 = .int v :: L2)
    (hR : s.G pR = .int (2 ^ Δ) :: LR) :
    IRuns I iprog (combC sub) s
      (((s.upd pP1 L1).upd pP2 L2).upd pO
        (.int ((u + if sub then -v else v).tdiv (2 ^ Δ)) :: s.G pO))
      (1000 * (zsz u + zsz v + Δ + 3)) := by
  set v' : ℤ := if sub then -v else v with hv'
  have hzv : zsz v' = zsz v := by rw [hv']; split_ifs <;> simp [zsz_neg]
  have h0 : IRuns I iprog (if sub then .op (.neg pP2) else .skip) s
      (s.upd pP2 (.int v' :: L2)) 20 := by
    cases sub
    · simp only [hv', Bool.false_eq_true, if_false]
      have : s.upd pP2 (.int v :: L2) = s := (IState.upd_eq_self _ _ _).2 h2
      rw [this]; exact (IRuns.skip s).mono (by norm_num)
    · simp only [hv', if_true]
      exact IRuns.neg h2
  set s0 := s.upd pP2 (.int v' :: L2) with hs0
  have ha := IRuns.add (I := I) (iprog := iprog) (s := s0) (i := pP1) (j := pP2) (k := pP1)
    (a := u) (b := v') (Li := L1) (Lj := L2) (by decide) (by simp +decide [hs0, h1]) (by simp +decide [hs0])
  set x := u + v' with hx
  set s1 := ((s0.upd pP1 L1).upd pP2 L2).upd pP1 (.int x :: ((s0.upd pP1 L1).upd pP2 L2).G pP1)
    with hs1
  have hsp := IRuns.split (I := I) (iprog := iprog) (s := s1) (i := pP1) (j := pR) (k := pT)
    (a := x) (m := Δ) (Li := L1) (Lj := LR) (by decide) (by decide) (by decide)
    (by simp +decide [hs1]) (by simp +decide [hs1, hs0, hR])
  set s2 := (s1.upd pP1 (.int (sg x (x.natAbs / 2 ^ Δ)) :: L1)).upd pT
    (.int (sg x (x.natAbs % 2 ^ Δ)) :: s1.G pT) with hs2
  have hd := IRuns.drop (I := I) (iprog := iprog) (s := s2) (i := pT)
    (a := sg x (x.natAbs % 2 ^ Δ)) (L := s1.G pT) (by simp +decide [hs2])
  have hm := IRuns.mv (I := I) (iprog := iprog) (s := s2.upd pT (s1.G pT)) (i := pP1) (j := pO)
    (a := sg x (x.natAbs / 2 ^ Δ)) (L := L1) (by decide) (by simp +decide [hs2])
  refine (h0.seq (ha.seq (hsp.seq (hd.seq hm)))).mono' ?_ ?_
  · rw [sg_tdiv]
    simp only [hs2, hs1, hs0]
    apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip,
      IState.upd_out] <;> split_ifs <;> simp_all +decide
  · have c1 := addIntCost_le (zsz u + zsz v')
    have c2 := splitCost_le Δ
    have c3 := zsz_sg_mod_le x Δ
    have c4 := moveIntCost_le (zsz (sg x (x.natAbs / 2 ^ Δ)))
    have c5 := zsz_sg_div_le x Δ
    have c6 := zsz_add_le' u v'
    rw [← hx] at c6
    omega

