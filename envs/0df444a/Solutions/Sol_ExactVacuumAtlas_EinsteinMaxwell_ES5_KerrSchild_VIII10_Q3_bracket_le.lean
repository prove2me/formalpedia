/-! ## The pointwise inverse lower bound -/

/-- On `KG × [0,1]` the inverse factor is at least `1`. -/
theorem one_le_inv_KG {x t : ℝ} (hx : x ∈ KG) (ht : t ∈ Icc (0:ℝ) 1) :
    (1 : ℝ) ≤ (1 - t * x)⁻¹ := by
  have hge := one_sub_mul_ge_KG hx ht
  obtain ⟨ht0, ht1⟩ := ht
  obtain ⟨hx0, hx1⟩ := hx
  have hpos : (0:ℝ) < 1 - t * x := by linarith
  have hle : 1 - t * x ≤ 1 := by
    have : 0 ≤ t * x := mul_nonneg ht0 hx0
    linarith
  exact (one_le_inv₀ hpos).mpr hle

/-- Integrability of the `Hc` integrand on `[0,1]`. -/
theorem intervalIntegrable_Hc_integrand {x : ℝ} (hx : x ∈ KG) :
    IntervalIntegrable (fun t : ℝ => (1 - t * x)⁻¹) volume 0 1 := by
  simpa only [pow_zero, one_mul, zero_add, pow_one] using
    intervalIntegrable_J (k := 0) (m := 0) (KG_subset_UG hx)

/-- Integrability of the `Gc` integrand on `[0,1]`. -/
theorem intervalIntegrable_Gc_integrand {x : ℝ} (hx : x ∈ KG) :
    IntervalIntegrable (fun t : ℝ => t * (1 - t * x)⁻¹) volume 0 1 := by
  simpa only [pow_one, zero_add] using
    intervalIntegrable_J (k := 1) (m := 0) (KG_subset_UG hx)

/-! ## The three lower bounds -/

/-- `1 ≤ Hc x` on `KG`. -/
theorem one_le_Hc {x : ℝ} (hx : x ∈ KG) : (1 : ℝ) ≤ Hc x := by
  rw [Hc_eq]
  have hmono : (∫ t in (0:ℝ)..1, (1:ℝ)) ≤ ∫ t in (0:ℝ)..1, (1 - t * x)⁻¹ :=
    intervalIntegral.integral_mono_on (μ := volume) (a := (0:ℝ)) (b := 1) (by norm_num)
      intervalIntegrable_const (intervalIntegrable_Hc_integrand hx)
      (fun t ht => one_le_inv_KG hx ht)
  simpa using hmono

/-- `1/2 ≤ Gc x` on `KG`. -/
theorem half_le_Gc {x : ℝ} (hx : x ∈ KG) : (1 / 2 : ℝ) ≤ Gc x := by
  rw [Gc_eq]
  have hmono : (∫ t in (0:ℝ)..1, t) ≤ ∫ t in (0:ℝ)..1, t * (1 - t * x)⁻¹ :=
    intervalIntegral.integral_mono_on (μ := volume) (a := (0:ℝ)) (b := 1) (by norm_num)
      intervalIntegrable_id (intervalIntegrable_Gc_integrand hx)
      (fun t ht => le_mul_of_one_le_right ht.1 (one_le_inv_KG hx ht))
  have hid : (∫ t in (0:ℝ)..1, t) = 1 / 2 := by
    rw [integral_id]; norm_num
  rw [hid] at hmono
  exact hmono

