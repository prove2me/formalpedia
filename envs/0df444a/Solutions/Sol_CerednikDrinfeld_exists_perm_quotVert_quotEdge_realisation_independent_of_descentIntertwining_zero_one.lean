    rw [he e, hn_eq]
    have e1 : ρ₂ nσ * ρ₂ (nσ⁻¹ * n) = (ρ₂ nσ * ρ₂ (nσ⁻¹ * n) * (ρ₂ nσ)⁻¹) * ρ₂ nσ := by group
    rw [e1, mul_smul]; exact (horbD j _ hmem' _).symm
  · obtain ⟨hs, he⟩ := hNTσ (fun h' => hT (hpar.2 h'))
    refine ⟨hs, ?_⟩
    rw [he e, hn_eq]
    have e1 : ρ₂ nσ * ρ₂ (nσ⁻¹ * n) = (ρ₂ nσ * ρ₂ (nσ⁻¹ * n) * (ρ₂ nσ)⁻¹) * ρ₂ nσ := by group
    rw [e1, mul_smul, Mumford.smul_dart_symm]; exact (horbD j _ hmem' _).symm

