-- title:
--   A nonzero base polynomial is not divisible by the chart coordinate $x$
-- statement:
--   Let $p∈K[T]$ be nonzero, viewed as a constant element of the canonical $A$-chart base ring. Then $$C(p)\notin(x).$$ This separates the coefficient subring from the principal ideal generated by the base coordinate $x$.
-- source:
--   B. Mazur, Modular curves and the Eisenstein ideal, Publ. IHES 47 (1977); Lean formalization of the order-25 case for this mission. Modules in the MazurProof/Keystone/Tate families are adapted from anthropics/fermats-last-theorem (Apache-2.0) via the xiangyazi24/FLT fork.

import Mathlib
import Definitions.Def_N25_CanonicalAChartTower

open N25
open Polynomial
variable (K : Type*) [Field K]

theorem N25.canonicalAChartBase_constant_not_mem_x (p : Polynomial K) (hp : p ≠ 0) :
    C p ∉ Ideal.span ({canonicalAChartBaseX25 K} : Set (CanonicalAChartBase25 K)) := by sorry
