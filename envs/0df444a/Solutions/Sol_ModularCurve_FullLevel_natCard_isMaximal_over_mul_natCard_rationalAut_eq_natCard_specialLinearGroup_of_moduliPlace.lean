variable {κ : Type u} [Field κ] [IsAlgClosed κ] [DecidableEq κ]

def G0 (W₀ : WeierstrassCurve κ) {I : Type*} (d : I → ℕ) (T₀ : I → Polynomial κ) :
    Subgroup (WeierstrassCurve.VariableChange κ) where
  carrier := {C | C • W₀ = W₀ ∧ ∀ i, ModularCurve.kernelVariableChangeDeg C (d i) (T₀ i) = T₀ i}
  mul_mem' := by
    intro C C' hC hC'
    refine ⟨by rw [mul_smul, hC'.1, hC.1], fun i => ?_⟩
    rw [ModularCurve.kernelVariableChangeDeg_mul, hC'.2 i, hC.2 i]
  one_mem' := ⟨one_smul _ _, fun i => ModularCurve.kernelVariableChangeDeg_one _ _⟩
  inv_mem' := by
    intro C hC
    refine ⟨?_, fun i => ?_⟩
    · calc C⁻¹ • W₀ = C⁻¹ • (C • W₀) := by rw [hC.1]
        _ = W₀ := by rw [← mul_smul, inv_mul_cancel, one_smul]
    · calc ModularCurve.kernelVariableChangeDeg C⁻¹ (d i) (T₀ i)
          = ModularCurve.kernelVariableChangeDeg C⁻¹ (d i) (ModularCurve.kernelVariableChangeDeg C (d i) (T₀ i)) := by
            rw [hC.2 i]
        _ = T₀ i := by rw [← ModularCurve.kernelVariableChangeDeg_mul, inv_mul_cancel, ModularCurve.kernelVariableChangeDeg_one]

theorem mem_G0_iff (W₀ : WeierstrassCurve κ) {I : Type*} (d : I → ℕ) (T₀ : I → Polynomial κ)
    (C : WeierstrassCurve.VariableChange κ) :
    C ∈ G0 W₀ d T₀ ↔ C • W₀ = W₀ ∧ ∀ i, ModularCurve.kernelVariableChangeDeg C (d i) (T₀ i) = T₀ i := Iff.rfl

def B (W₀ : WeierstrassCurve κ) [W₀.IsElliptic] (ℓ : ℕ) (e₀ : κˣ) : Type u :=
  {D : ModularCurve.LevelPData κ // ModularCurve.IsLevelPStructure W₀ ℓ D ∧
    weilPairing0 W₀ κ (ℓ : ℤ) (toPoint (W₀.baseChange κ) D.xP D.yP) (toPoint (W₀.baseChange κ) D.xQ D.yQ) = e₀}

variable (W₀ : WeierstrassCurve κ) [W₀.IsElliptic] (ℓ : ℕ) [Fact ℓ.Prime] [hℓ3 : Fact (3 ≤ ℓ)] [hℓκ : NeZero ((ℓ : ℕ) : κ)]
  {I : Type*} (d : I → ℕ) (T₀ : I → Polynomial κ) (e₀ : κˣ)

theorem mem_B_variableChange (C : WeierstrassCurve.VariableChange κ) (hC : C • W₀ = W₀)
    (D : ModularCurve.LevelPData κ)
    (hD : ModularCurve.IsLevelPStructure W₀ ℓ D ∧
      weilPairing0 W₀ κ (ℓ : ℤ) (toPoint (W₀.baseChange κ) D.xP D.yP) (toPoint (W₀.baseChange κ) D.xQ D.yQ) = e₀) :
    ModularCurve.IsLevelPStructure W₀ ℓ (D.variableChange C) ∧
      weilPairing0 W₀ κ (ℓ : ℤ) (toPoint (W₀.baseChange κ) (D.variableChange C).xP (D.variableChange C).yP)
        (toPoint (W₀.baseChange κ) (D.variableChange C).xQ (D.variableChange C).yQ) = e₀ := by
  obtain ⟨hD1, hD2⟩ := hD
  have hlev : ModularCurve.IsLevelPStructure (C • W₀) ℓ (D.variableChange C) := hD1.variableChange C
  refine ⟨hC ▸ hlev, ?_⟩
  haveI : (C • W₀).IsElliptic := by rw [hC]; infer_instance
  have h1 := WeierstrassCurve.Affine.weilPairing0_toPoint_variableChange W₀ C ℓ hℓ3.out hℓκ.out D hD1
  have h2 := WeierstrassCurve.Affine.weilPairing0_toPoint_eq_of_baseChange_eq (Ω := κ) (C • W₀) W₀
    (by rw [hC]) (ℓ : ℤ) (D.variableChange C).xP (D.variableChange C).yP (D.variableChange C).xQ (D.variableChange C).yQ
  rw [← hD2, ← h1]
  exact Units.ext h2.symm

scoped instance instSMul : SMul (↥(G0 W₀ d T₀)) (B W₀ ℓ e₀) where
  smul g b := ⟨b.1.variableChange (g : WeierstrassCurve.VariableChange κ),
    mem_B_variableChange W₀ ℓ e₀ g g.2.1 b.1 b.2⟩

@[scoped simp] theorem smul_val (g : ↥(G0 W₀ d T₀)) (b : B W₀ ℓ e₀) :
    (HSMul.hSMul (self := instHSMul (α := ↥(G0 W₀ d T₀)) (β := B W₀ ℓ e₀)) g b).1 =
      b.1.variableChange (g : WeierstrassCurve.VariableChange κ) := rfl

scoped instance instMulAction : MulAction (↥(G0 W₀ d T₀)) (B W₀ ℓ e₀) where
  one_smul b := by
    apply Subtype.ext
    show b.1.variableChange ((1 : ↥(G0 W₀ d T₀)) : WeierstrassCurve.VariableChange κ) = b.1
    rw [OneMemClass.coe_one]
    exact ModularCurve.LevelPData.variableChange_one b.1
  mul_smul g h b := by
    apply Subtype.ext
    show b.1.variableChange ((g * h : ↥(G0 W₀ d T₀)) : WeierstrassCurve.VariableChange κ) =
      (b.1.variableChange (h : WeierstrassCurve.VariableChange κ)).variableChange (g : WeierstrassCurve.VariableChange κ)
    rw [Subgroup.coe_mul]
    exact ModularCurve.LevelPData.variableChange_mul _ _ b.1

theorem free (g : ↥(G0 W₀ d T₀)) (b : B W₀ ℓ e₀) (h : g • b = b) : g = 1 := by
  have h1 : b.1.variableChange (g : WeierstrassCurve.VariableChange κ) = b.1 := congrArg Subtype.val h
