import Mathlib

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.IX

/-!
# Exact Spacetime Atlas IX — physical actual-source interface

This B3 interface records the closed compactified actual `M` source `srcMbar`,
the generic completion `qMcK`, the four weighted residuals, and the absorption
identity used in the VIII20 estimate. The domain `kg` is the compact source
domain in the compact variable `x`. The identity and its positive coefficient
margin are the algebraic physical interface extracted from the VIII17/VIII20
actual-source argument. The interface is independent of a metric or Ricci API.
-/

def OnSet (kg : Set ℝ) (P : ℝ → Prop) : Prop := ∀ x, x ∈ kg → P x

def zeroFun : ℝ → ℝ := fun _ => 0

def absorptionCoefficient (lamM : ℝ → ℝ) (x : ℝ) : ℝ := 2 - 4 * x + x * lamM x

def sourceDefect (srcMbar qMcK : ℝ → ℝ) (x : ℝ) : ℝ := srcMbar x - qMcK x

def physicalAbsorbedDefect (srcMbar qMcK lamM : ℝ → ℝ) : ℝ → ℝ :=
  fun x => absorptionCoefficient lamM x * sourceDefect srcMbar qMcK x

def PhysicalMarginOn (kg : Set ℝ) (lamM : ℝ → ℝ) : Prop :=
  OnSet kg (fun x => 0 < absorptionCoefficient lamM x)

def ResidualZero (w : ℝ → ℝ) (kg : Set ℝ) : Prop := OnSet kg (fun x => w x = 0)

def AbsorbedDefectZero (srcMbar qMcK lamM : ℝ → ℝ) (kg : Set ℝ) : Prop :=
  OnSet kg (fun x => physicalAbsorbedDefect srcMbar qMcK lamM x = 0)

def SourceEquality (srcMbar qMcK : ℝ → ℝ) (kg : Set ℝ) : Prop :=
  OnSet kg (fun x => sourceDefect srcMbar qMcK x = 0)

/-- Physical actual-source data, including the VIII20 absorption identity and margin. -/
def PhysicalSourceData
    (kg : Set ℝ)
    (srcMbar : ℝ → ℝ) (qMcK : ℝ → ℝ)
    (wF : ℝ → ℝ) (wMc : ℝ → ℝ) (wC : ℝ → ℝ) (wA : ℝ → ℝ)
    (lamF : ℝ → ℝ) (lamM : ℝ → ℝ) (lamC : ℝ → ℝ) (lamA : ℝ → ℝ) : Prop :=
  (OnSet kg (fun x =>
    absorptionCoefficient lamM x * sourceDefect srcMbar qMcK x =
      lamF x * wF x + lamM x * wMc x + lamC x * wC x + lamA x * wA x)) ∧
  PhysicalMarginOn kg lamM

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.IX


