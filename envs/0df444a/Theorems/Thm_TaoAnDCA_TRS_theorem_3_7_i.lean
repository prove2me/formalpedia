-- title:
--   Theorem 3.7(i), p. 487 — the simplified DCA decreases g − h by the maxima of the ρ-weighted steps
-- statement:
--   Let $g,h\in\Gamma_0(\mathbb R^n)$ satisfy $\operatorname{dom}g\subset\operatorname{dom}h$ and $\operatorname{dom}h^*\subset\operatorname{dom}g^*$, and let $\{x^k\}$, $\{y^k\}$ be generated by the simplified DCA ($x^0\in\operatorname{dom}g$, $y^k\in\partial h(x^k)$, $x^{k+1}\in\partial g^*(y^k)$). Let $\rho_1,\rho_2,\rho_1^*,\rho_2^*\ge0$ be constants such that $g$, $h$, $g^*$, $h^*$ are $\rho_1$-, $\rho_2$-, $\rho_1^*$- and $\rho_2^*$-convex, and write $dx^k = x^{k+1}-x^k$, $dy^k = y^{k+1}-y^k$. Then for every $k\ge1$
--   $$(g-h)(x^{k+1})\le(h^*-g^*)(y^k)-\max\Big\{\frac{\rho_2}{2}\|dx^k\|^2,\frac{\rho_2^*}{2}\|dy^k\|^2\Big\}$$
--   and
--   $$(h^*-g^*)(y^k)-\max\Big\{\frac{\rho_2}{2}\|dx^k\|^2,\frac{\rho_2^*}{2}\|dy^k\|^2\Big\}\le(g-h)(x^k)-\max\Big\{\frac{\rho_1+\rho_2}{2}\|dx^k\|^2,\ \frac{\rho_1^*}{2}\|dy^{k-1}\|^2+\frac{\rho_2}{2}\|dx^k\|^2,\ \frac{\rho_1^*}{2}\|dy^{k-1}\|^2+\frac{\rho_2^*}{2}\|dy^k\|^2\Big\}.$$
--
--   This is the descent property of the DCA for general d.c. programs: the primal objective decreases along the iterates by an amount controlled by the strong convexity of the four functions $g,h,g^*,h^*$.
--
--   **Formalization Note.** The paper's constants satisfy $0\le\rho_i<\rho(f_i)$, or $\rho_i=\rho(f_i)$ when the supremum (5) is attained, or $\rho_i = 0$ when $\rho(f_i)=0$; each case says exactly that $f_i$ is $\rho_i$-convex, and that is the hypothesis used. The statement starts at $k=1$ because $dy^{k-1}$ needs $y^{k-1}$. Differences use the convention $+\infty-(+\infty)=+\infty$ (`dcSub`). The equality case of (i) is the separate companion item `theorem_3_7_i_eq`.
-- source:
--   Pham Dinh & Le Thi, A d.c. optimization algorithm for solving the trust-region subproblem, SIAM J. Optim. 8 (1998), p. 487, §3.4, Theorem 3.7(i) (inequalities)

import Mathlib
import Definitions.Def_TaoAnDCA_TRS_Setting

open Filter Topology

namespace TaoAnDCA.TRS

theorem theorem_3_7_i {n : ℕ} (g h : EuclideanSpace ℝ (Fin n) → EReal) (hgh : TaoAnDCA.GlobalOpt.DCStanding g h)
    (x y : ℕ → EuclideanSpace ℝ (Fin n)) (hrun : IsSimplifiedDCARun g h x y)
    (ρ₁ ρ₂ ρ₁' ρ₂' : ℝ) (h₁ : IsRhoConvex g ρ₁) (h₂ : IsRhoConvex h ρ₂)
    (h₁' : IsRhoConvex (CondatPD.FinDim.conj g) ρ₁') (h₂' : IsRhoConvex (CondatPD.FinDim.conj h) ρ₂') :
    ∀ k : ℕ, 1 ≤ k →
      TaoAnDCA.GlobalOpt.dcSub g h (x (k + 1)) ≤
          TaoAnDCA.GlobalOpt.dcSub (CondatPD.FinDim.conj h) (CondatPD.FinDim.conj g) (y k) -
            ((max (ρ₂ / 2 * ‖x (k + 1) - x k‖ ^ 2) (ρ₂' / 2 * ‖y (k + 1) - y k‖ ^ 2) : ℝ) : EReal) ∧
        TaoAnDCA.GlobalOpt.dcSub (CondatPD.FinDim.conj h) (CondatPD.FinDim.conj g) (y k) -
            ((max (ρ₂ / 2 * ‖x (k + 1) - x k‖ ^ 2) (ρ₂' / 2 * ‖y (k + 1) - y k‖ ^ 2) : ℝ) : EReal) ≤
          TaoAnDCA.GlobalOpt.dcSub g h (x k) -
            ((max ((ρ₁ + ρ₂) / 2 * ‖x (k + 1) - x k‖ ^ 2)
                (max (ρ₁' / 2 * ‖y k - y (k - 1)‖ ^ 2 + ρ₂ / 2 * ‖x (k + 1) - x k‖ ^ 2)
                  (ρ₁' / 2 * ‖y k - y (k - 1)‖ ^ 2 + ρ₂' / 2 * ‖y (k + 1) - y k‖ ^ 2)) : ℝ) : EReal) := by sorry

end TaoAnDCA.TRS
