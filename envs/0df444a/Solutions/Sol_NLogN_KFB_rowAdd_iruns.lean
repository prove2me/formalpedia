namespace NLogN.KFB

open IntMul RS AModel KIL KFD Complex

@[simp] theorem length_gswL (P Q : ℕ) (zs : List GI) : (gswL P Q zs).length = zs.length := by
  simp [gswL]

theorem getD_gswL (P Q : ℕ) (zs : List GI) (k : ℕ) (hk : k < zs.length) :
    (gswL P Q zs).getD k 0 = zs.getD (swbit P Q k) 0 := by
  simp [gswL, List.getD_eq_getElem?_getD, hk]

theorem GB_gswL {w : ℕ} (P Q : ℕ) (zs : List GI) (hb : NLogN.KFB.GB w zs) : NLogN.KFB.GB w (gswL P Q zs) := by
  rw [GB_getD]
  intro i hi
  rw [length_gswL] at hi
  rw [getD_gswL _ _ _ _ hi]
  exact GB_getD_all hb _

theorem adig_swA {m n : ℕ} (P Q : Fin (m * n)) (b : Fin m × Fin n → Fin 2) (i : ℕ)
    (hi : i < m * n) : adig (swA P Q b) i = adig b (Equiv.swap P Q ⟨i, hi⟩).val := by
  unfold adig swA
  rw [dif_pos hi, dif_pos (Equiv.swap P Q ⟨i, hi⟩).isLt]
  simp only [Fin.eta, Equiv.apply_symm_apply]

theorem aidx_swA {m n : ℕ} (P Q : Fin (m * n)) (hPQ : P.val < Q.val) (b : Fin m × Fin n → Fin 2) :
    (aidx (swA P Q b) : ℤ) = aidx b + ((adig b Q : ℤ) - adig b P) * ((2 ^ P.val : ℕ) : ℤ) +
      ((adig b P : ℤ) - adig b Q) * ((2 ^ Q.val : ℕ) : ℤ) := by
  have hs : ∑ i ∈ Finset.range (m * n), (((adig (swA P Q b) i : ℕ) : ℤ) - (adig b i : ℕ)) *
      ((2 ^ i : ℕ) : ℤ) = ((adig b Q : ℤ) - adig b P) * ((2 ^ P.val : ℕ) : ℤ) +
      ((adig b P : ℤ) - adig b Q) * ((2 ^ Q.val : ℕ) : ℤ) := by
    rw [Finset.sum_eq_add P.val Q.val (by omega)]
    · rw [adig_swA _ _ _ _ P.isLt, adig_swA _ _ _ _ Q.isLt]
      simp only [Fin.eta, Equiv.swap_apply_left, Equiv.swap_apply_right]
      try ring
    · intro i hi hne
      rw [adig_swA _ _ _ _ (Finset.mem_range.1 hi)]
      rw [Equiv.swap_apply_of_ne_of_ne (fun e => hne.1 (congrArg Fin.val e))
        (fun e => hne.2 (congrArg Fin.val e))]
      ring
    · intro h; exact absurd (Finset.mem_range.2 P.isLt) h
    · intro h; exact absurd (Finset.mem_range.2 Q.isLt) h
  rw [aidx_eq, aidx_eq]
  simp only [sub_mul, Finset.sum_sub_distrib] at hs
  push_cast at hs ⊢
  linarith

theorem bit_seg {K w a i : ℕ} (ha : a < 2 ^ K) (hi : i < K) :
    (w * 2 ^ K + a) / 2 ^ i % 2 = a / 2 ^ i % 2 := by
  have e : 2 ^ K = 2 ^ i * (2 * 2 ^ (K - i - 1)) := by
    rw [← pow_succ', ← pow_add]; congr 1; omega
  rw [e, show w * (2 ^ i * (2 * 2 ^ (K - i - 1))) + a = a + 2 ^ i * (2 * (w * 2 ^ (K - i - 1))) by
    ring, Nat.add_mul_div_left _ _ (by positivity), Nat.add_mul_mod_self_left]

theorem swbit_aidx {m n : ℕ} (P Q : Fin (m * n)) (hPQ : P.val < Q.val) (w : ℕ)
    (b : Fin m × Fin n → Fin 2) :
    swbit P.val Q.val (w * 2 ^ (m * n) + aidx b) = w * 2 ^ (m * n) + aidx (swA P Q b) := by
  have ha := aidx_lt b
  have hz := aidx_swA P Q hPQ b
  have bP := bit_seg (w := w) ha P.isLt
  have bQ := bit_seg (w := w) ha Q.isLt
  rw [aidx_bit b _ P.isLt] at bP
  rw [aidx_bit b _ Q.isLt] at bQ
  have dP := adig_lt b P.val
  have dQ := adig_lt b Q.val
  unfold swbit
  rw [bP, bQ]
  have pPQ : 2 ^ P.val < 2 ^ Q.val := Nat.pow_lt_pow_right (by norm_num) hPQ
  have aP : adig b P.val = 1 → 2 ^ P.val ≤ aidx b := fun h => by
    have := aidx_bit b _ P.isLt
    rw [h] at this
    by_contra hc; push Not at hc; rw [Nat.div_eq_of_lt hc] at this; simp at this
  have aQ : adig b Q.val = 1 → 2 ^ Q.val ≤ aidx b := fun h => by
    have := aidx_bit b _ Q.isLt
    rw [h] at this
    by_contra hc; push Not at hc; rw [Nat.div_eq_of_lt hc] at this; simp at this
  split_ifs with h1 h2
  · rw [h1] at hz; simp only [sub_self, zero_mul, add_zero] at hz; omega
  · have e2 : adig b Q.val = 0 := by omega
    have := aP h2
    rw [h2, e2] at hz
    generalize 2 ^ P.val = A at *
    generalize 2 ^ Q.val = B at *
    simp only [Nat.cast_zero, Nat.cast_one] at hz
    ring_nf at hz
    omega
  · have e1 : adig b P.val = 0 := by omega
    have e2 : adig b Q.val = 1 := by omega
    have := aQ e2
    rw [e1, e2] at hz
    generalize 2 ^ P.val = A at *
    generalize 2 ^ Q.val = B at *
    simp only [Nat.cast_zero, Nat.cast_one] at hz
    ring_nf at hz
    omega

/-- **Address-bit swap on the encoding** (all roles). -/
theorem rep_gsw {W m n : ℕ} (P Q : Fin (m * n)) (hPQ : P.val < Q.val) (zs : List GI)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) :
    Rep (gswL P.val Q.val zs) (fun p => x (p.1, swA P Q p.2)) := by
  obtain ⟨hl, hv⟩ := hx
  refine ⟨by rw [length_gswL, hl], fun w b => ?_⟩
  have hk : w.val * 2 ^ (m * n) + aidx b < zs.length := by
    rw [hl]
    have : (w.val + 1) * 2 ^ (m * n) ≤ W * 2 ^ (m * n) := Nat.mul_le_mul_right _ w.isLt
    have := aidx_lt b
    rw [Nat.succ_mul] at *; omega
  rw [getD_gswL _ _ _ _ hk, swbit_aidx P Q hPQ, hv]

end NLogN.KFB

end

section
-- Source module: Solutions.KFBCnot
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel KIL KFD Complex

theorem idM_ok : idM.Ok := ⟨Sm_ipw 0, Sm_zero, Sm_zero, Sm_ipw 0⟩

theorem cnMs_ok (d : ℕ) : ∀ M ∈ cnMs d, M.Ok := by
  intro M hM
  simp only [cnMs, List.mem_map] at hM
  obtain ⟨p, _, rfl⟩ := hM
  split_ifs
  · exact swM_ok
  · exact idM_ok

@[simp] theorem length_cnMs (d : ℕ) : (cnMs d).length = 2 ^ (d + 1) := by simp [cnMs]

theorem mod2_lt_iff {j B : ℕ} (hB : 0 < B) : j % (2 * B) < B ↔ j / B % 2 = 0 := by
  have e2 : j % (B * 2) = j % B + B * (j / B % 2) := Nat.mod_mul
  rw [mul_comm 2 B, e2]
  have : j / B % 2 < 2 := Nat.mod_lt _ (by norm_num)
  have : j % B < B := Nat.mod_lt _ hB
  constructor
  · intro h; by_contra h'; have : j / B % 2 = 1 := by omega
    rw [this] at h; omega
  · intro h; rw [h]; omega

theorem mod_pow_div_bit (j a : ℕ) : j % 2 ^ (a + 1) / 2 ^ a = j / 2 ^ a % 2 := by
  have e : j % 2 ^ (a + 1) = j % 2 ^ a + 2 ^ a * (j / 2 ^ a % 2) := Nat.mod_pow_succ
  rw [e, Nat.add_mul_div_left _ _ (by positivity), Nat.div_eq_of_lt (Nat.mod_lt _ (by positivity)),
    zero_add]

theorem lin2_sw (x y : GI) : lin2 swM.a swM.b x y = y ∧ lin2 swM.c swM.d x y = x := by
  constructor <;> ext <;> simp [lin2, gmul, swM, ipw]

theorem lin2_id (x y : GI) : lin2 idM.a idM.b x y = x ∧ lin2 idM.c idM.d x y = y := by
  constructor <;> ext <;> simp [lin2, gmul, idM, ipw]

theorem cn_GS {K t d : ℕ} (h : t + d + 1 < K) :
    2 ^ K / 2 ^ (t + d + 2) * (2 * 2 ^ t * (cnMs d).length) = 2 ^ K := by
  rw [length_cnMs, show 2 * 2 ^ t * 2 ^ (d + 1) = 2 ^ (t + d + 2) by
    rw [← pow_succ', ← pow_add]; congr 1; omega]
  exact Nat.div_mul_cancel (pow_dvd_pow 2 (by omega))

theorem getD_cnL {K t d off : ℕ} (h : t + d + 1 < K) (zs : List GI)
    (hlen : off + 2 ^ K ≤ zs.length) (j : ℕ) (hj : j < 2 ^ K) :
    (cnL K t d off zs).getD (off + j) 0 =
      if j / 2 ^ (t + d + 1) % 2 = 1 then
        zs.getD (off + (if j / 2 ^ t % 2 = 0 then j + 2 ^ t else j - 2 ^ t)) 0
      else zs.getD (off + j) 0 := by
  unfold cnL
  rw [getD_segApply _ _ _ _ _ (by rw [cn_GS h]; exact hlen), if_pos ⟨by omega, by
    rw [cn_GS h]; omega⟩, Nat.add_sub_cancel_left]
  have hS : 2 * 2 ^ t * (cnMs d).length = 2 ^ (t + d + 1 + 1) := by
    rw [length_cnMs, ← pow_succ', ← pow_add]; congr 1; omega
  rw [hS]
  have hp : j % 2 ^ (t + d + 1 + 1) / (2 * 2 ^ t) < 2 ^ (d + 1) := by
    rw [Nat.div_lt_iff_lt_mul (by positivity)]
    calc j % 2 ^ (t + d + 1 + 1) < 2 ^ (t + d + 1 + 1) := Nat.mod_lt _ (by positivity)
      _ = 2 ^ (d + 1) * (2 * 2 ^ t) := by rw [← pow_succ', ← pow_add]; congr 1; omega
  have hM : (cnMs d).getD (j % 2 ^ (t + d + 1 + 1) / (2 * 2 ^ t)) M0 =
      if j / 2 ^ (t + d + 1) % 2 = 1 then swM else idM := by
    rw [List.getD_eq_getElem _ _ (by simpa using hp)]
    simp only [cnMs, List.getElem_map, List.getElem_range]
    congr 2
    rw [Nat.div_div_eq_div_mul, ← pow_succ', ← pow_add, show t + 1 + d = t + d + 1 by omega,
      mod_pow_div_bit, Nat.mod_mod]
  rw [hM]
  have hB : 0 < 2 ^ t := by positivity
  simp only [pent, NLogN.KFB.getD_drop']
  by_cases hc : j / 2 ^ (t + d + 1) % 2 = 1
  · rw [if_pos hc, if_pos hc]
    by_cases ht : j / 2 ^ t % 2 = 0
    · rw [if_pos ((mod2_lt_iff hB).2 ht), if_pos ht, (lin2_sw _ _).1]
    · rw [if_neg (fun h => ht ((mod2_lt_iff hB).1 h)), if_neg ht, (lin2_sw _ _).2]
  · rw [if_neg hc, if_neg hc]
    by_cases ht : j / 2 ^ t % 2 = 0
    · rw [if_pos ((mod2_lt_iff hB).2 ht), (lin2_id _ _).1]
    · rw [if_neg (fun h => ht ((mod2_lt_iff hB).1 h)), (lin2_id _ _).2]

theorem cQopW_le_gen (w B1 L G N off Z : ℕ) (hB : 1 ≤ B1) (hL : 1 ≤ L) (hN : G * (2 * B1 * L) = N) :
    cQopW w B1 L G off Z ≤ NLogN.KFB.cPass w N off Z := by
  simp only [cQopW, cQop, NLogN.KFB.cBlk, NLogN.KFB.cPass]
  have hGL : G * L ≤ N := by nlinarith
  have hG : G ≤ N := by nlinarith
  have hGLB : G * L * B1 ≤ N := by nlinarith
  have e1 : G * (L * (B1 * (135000 * w + 530000) + 12000) + 2101) =
      (G * L * B1) * (135000 * w + 530000) + (G * L) * 12000 + G * 2101 := by ring
  rw [e1, hN]
  have : (G * L * B1) * (135000 * w + 530000) ≤ N * (135000 * w + 530000) :=
    Nat.mul_le_mul_right _ hGLB
  have : (G * L) * 12000 ≤ N * 12000 := Nat.mul_le_mul_right _ hGL
  have : G * 2101 ≤ N * 2101 := Nat.mul_le_mul_right _ hG
  nlinarith

theorem adig_cnA {m n : ℕ} (ctl tgt : Fin (m * n)) (b : Fin m × Fin n → Fin 2) (i : ℕ)
    (hi : i < m * n) :
    adig (cnA ctl tgt b) i = if i = tgt.val then (adig b i + adig b ctl.val) % 2 else adig b i := by
  unfold adig cnA
  rw [dif_pos hi, dif_pos hi, dif_pos ctl.isLt]
  simp only [Equiv.apply_symm_apply, Fin.eta]
  by_cases h : i = tgt.val
  · rw [if_pos (Fin.ext h), if_pos h, Fin.val_add]
  · rw [if_neg (fun e => h (congrArg Fin.val e)), if_neg h]

theorem cnA_of_zero {m n : ℕ} (ctl tgt : Fin (m * n)) (b : Fin m × Fin n → Fin 2)
    (h : adig b ctl.val = 0) : cnA ctl tgt b = b := by
  funext p
  unfold cnA
  split_ifs
  · have : b (finProdFinEquiv.symm ctl) = 0 := by
      unfold adig at h; rw [dif_pos ctl.isLt] at h; exact Fin.ext h
    rw [this, add_zero]
  · rfl

theorem aidx_cnA {m n : ℕ} (ctl tgt : Fin (m * n)) (hne : ctl ≠ tgt) (b : Fin m × Fin n → Fin 2)
    (h : adig b ctl.val = 1) :
    (aidx (cnA ctl tgt b) : ℤ) = aidx b + (1 - 2 * (adig b tgt.val : ℤ)) * ((2 ^ tgt.val : ℕ) : ℤ) := by
  have dt := adig_lt b tgt.val
  have hs : ∑ i ∈ Finset.range (m * n), (((adig (cnA ctl tgt b) i : ℕ) : ℤ) - (adig b i : ℕ)) *
      ((2 ^ i : ℕ) : ℤ) = (1 - 2 * (adig b tgt.val : ℤ)) * ((2 ^ tgt.val : ℕ) : ℤ) := by
    rw [Finset.sum_eq_single tgt.val]
    · rw [adig_cnA _ _ _ _ tgt.isLt, if_pos rfl, h]
      have : adig b tgt.val = 0 ∨ adig b tgt.val = 1 := by omega
      rcases this with e | e <;> rw [e] <;> norm_num
    · intro i hi hne'
      rw [adig_cnA _ _ _ _ (Finset.mem_range.1 hi), if_neg hne', sub_self, zero_mul]
    · intro h'; exact absurd (Finset.mem_range.2 tgt.isLt) h'
  rw [aidx_eq, aidx_eq]
  simp only [sub_mul, Finset.sum_sub_distrib] at hs
  push_cast at hs ⊢
  linarith

theorem getD_cnL_out {K t d off : ℕ} (h : t + d + 1 < K) (zs : List GI)
    (hlen : off + 2 ^ K ≤ zs.length) (i : ℕ) (hi : ¬ (off ≤ i ∧ i < off + 2 ^ K)) :
    (cnL K t d off zs).getD i 0 = zs.getD i 0 := by
  unfold cnL
  rw [getD_segApply _ _ _ _ _ (by rw [cn_GS h]; exact hlen), if_neg (by rw [cn_GS h]; exact hi)]

theorem length_cnL {K t d off : ℕ} (h : t + d + 1 < K) (zs : List GI)
    (hlen : off + 2 ^ K ≤ zs.length) : (cnL K t d off zs).length = zs.length :=
  length_segApply _ _ _ _ _ (by rw [cn_GS h]; exact hlen)

/-- **The controlled flip on role `w`** (control position `ctl = tgt + d + 1`). -/
theorem rep_cnot {W m n : ℕ} (ctl tgt : Fin (m * n)) (d : ℕ) (hd : ctl.val = tgt.val + d + 1)
    (w : Fin W) (zs : List GI) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) :
    Rep (cnL (m * n) tgt.val d (w.val * 2 ^ (m * n)) zs)
      (fun p => if p.1 = w then x (p.1, cnA ctl tgt p.2) else x p) := by
  obtain ⟨hl, hv⟩ := hx
  have hK : tgt.val + d + 1 < m * n := by have := ctl.isLt; omega
  have hlen : w.val * 2 ^ (m * n) + 2 ^ (m * n) ≤ zs.length := by
    rw [hl, ← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  refine ⟨by rw [length_cnL hK _ hlen, hl], fun w' b => ?_⟩
  have hb := aidx_lt b
  show _ = if w' = w then x (w', cnA ctl tgt b) else x (w', b)
  by_cases e : w' = w
  · subst e
    rw [if_pos rfl, getD_cnL hK zs hlen _ hb]
    have bc : aidx b / 2 ^ (tgt.val + d + 1) % 2 = adig b ctl.val := by
      rw [← hd]; exact aidx_bit b _ ctl.isLt
    have bt : aidx b / 2 ^ tgt.val % 2 = adig b tgt.val := aidx_bit b _ tgt.isLt
    rw [bc, bt]
    by_cases hc : adig b ctl.val = 1
    · rw [if_pos hc]
      have hz := aidx_cnA ctl tgt (fun e => by rw [e] at hd; omega) b hc
      have hcl := aidx_lt (cnA ctl tgt b)
      rw [← hv]
      congr 2
      have dt := adig_lt b tgt.val
      have aT : adig b tgt.val = 1 → 2 ^ tgt.val ≤ aidx b := fun h1 => by
        have := aidx_bit b _ tgt.isLt
        rw [h1] at this
        by_contra hc'; push Not at hc'; rw [Nat.div_eq_of_lt hc'] at this; simp at this
      split_ifs with h0
      · rw [h0] at hz
        generalize 2 ^ tgt.val = A at *
        simp only [Nat.cast_zero] at hz
        ring_nf at hz
        omega
      · have h1 : adig b tgt.val = 1 := by omega
        have := aT h1
        rw [h1] at hz
        generalize 2 ^ tgt.val = A at *
        simp only [Nat.cast_one] at hz
        ring_nf at hz
        omega
    · have h0 : adig b ctl.val = 0 := by have := adig_lt b ctl.val; omega
      rw [if_neg hc, cnA_of_zero ctl tgt b h0, hv]
  · rw [if_neg e, getD_cnL_out hK zs hlen _ (fun h => e (Fin.ext ((seg_iff hb).1 h))), hv]

theorem GB_cnL {w K t d off : ℕ} (h : t + d + 1 < K) (zs : List GI)
    (hlen : off + 2 ^ K ≤ zs.length) (hb : NLogN.KFB.GB w zs) : NLogN.KFB.GB w (cnL K t d off zs) := by
  rw [GB_getD]
  intro i hi
  rw [length_cnL h zs hlen] at hi
  by_cases hs : off ≤ i ∧ i < off + 2 ^ K
  · obtain ⟨j, rfl⟩ : ∃ j, i = off + j := ⟨i - off, by omega⟩
    rw [getD_cnL h zs hlen j (by omega)]
    split_ifs <;> exact GB_getD_all hb _
  · rw [getD_cnL_out h zs hlen i hs]; exact GB_getD_all hb _

/-- The fine run of the controlled flip pass. -/
theorem cnot_fsp (s : IState HS) (wb K t d off : ℕ) (h : t + d + 1 < K) (f : Fin HS → List ℤ)
    (zs : List GI) (l : List ℤ) (hlen : off + 2 ^ K ≤ zs.length) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB wb zs) :
    FSp (qopW (cnMs d) (2 ^ t) (2 ^ K / 2 ^ (t + d + 2)) off) (encK s f)
      (encK s (Function.update f 0 (gflat (cnL K t d off zs) ++ l)))
      (NLogN.KFB.cPass wb (2 ^ K) off (zsz (((4 * (3 * 2 ^ K + off)) : ℕ) : ℤ))) := by
  have hGS := cn_GS (d := d) h
  have hB : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have hBK : 2 ^ t ≤ 2 ^ K := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hGK : 2 ^ K / 2 ^ (t + d + 2) ≤ 2 ^ K := Nat.div_le_self _ _
  have H := pass_fsp s wb (2 ^ t) (2 ^ K / 2 ^ (t + d + 2)) off (cnMs d) (cnMs_ok d) f zs l
    (by rw [hGS]; exact hlen) h0 hC hb (zsz (((4 * (3 * 2 ^ K + off)) : ℕ) : ℤ))
    (zsz_natCast_le (by rw [hGS]; omega))
  refine H.mono ?_
  exact cQopW_le_gen wb (2 ^ t) _ _ (2 ^ K) off _ hB (by simp [Nat.one_le_two_pow]) hGS

end NLogN.KFB

end

section
-- Source module: Solutions.KFBRow
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel KIL KFD Complex

theorem den_rowAdd_mulVec {W m n : ℕ} (T : Butterfly.Op (Fin n)) (w : Fin W) (i j : Fin m)
    (hij : i ≠ j) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (p : Fin W × (Fin m × Fin n → Fin 2)) :
    ((P8Lift.RStep.den T (P8Lift.RStep.rowAdd w i j hij : P8Lift.RStep (Fin W) m)).mulVec x) p =
      if p.1 = w then x (p.1, P8Lift.rowAddr i j p.2) else x p := by
  simp only [Matrix.mulVec, dotProduct, P8Lift.RStep.den]
  by_cases hw : p.1 = w
  · rw [if_pos hw, Finset.sum_eq_single (p.1, P8Lift.rowAddr i j p.2)]
    · simp [hw]
    · rintro ⟨q1, q2⟩ _ hq
      by_cases h1 : p.1 = q1
      · rw [if_pos h1, if_pos hw, if_neg, zero_mul]
        intro h2; exact hq (Prod.ext h1.symm h2)
      · rw [if_neg h1, zero_mul]
    · simp
  · rw [if_neg hw, Finset.sum_eq_single p]
    · simp [hw]
    · rintro ⟨q1, q2⟩ _ hq
      by_cases h1 : p.1 = q1
      · rw [if_pos h1, if_neg hw, if_neg, zero_mul]
        intro h2; exact hq (Prod.ext h1.symm h2.symm)
      · rw [if_neg h1, zero_mul]
    · simp

theorem raC_colA {m n : ℕ} (i j : Fin m) (hij : i ≠ j) (C : ℕ) (b : Fin m × Fin n → Fin 2) :
    raC i j C (colA i j C b) = raC i j (C + 1) b := by
  funext p
  obtain ⟨r, c⟩ := p
  simp only [raC, colA]
  by_cases hr : r = j
  · subst hr
    by_cases h1 : c.val < C
    · simp [h1, hij, show c.val ≠ C by omega, show c.val < C + 1 by omega]
    · by_cases h2 : c.val = C
      · simp [h1, h2, hij]
      · simp [h1, h2, show ¬ c.val < C + 1 by omega]
  · simp [hr]

theorem raC_zero {m n : ℕ} (i j : Fin m) (b : Fin m × Fin n → Fin 2) : raC i j 0 b = b := by
  funext p; simp [raC]

theorem raC_full {m n : ℕ} (i j : Fin m) (b : Fin m × Fin n → Fin 2) :
    raC i j n b = P8Lift.rowAddr i j b := by
  funext p
  simp only [raC, P8Lift.rowAddr]
  by_cases h : p.1 = j
  · rw [if_pos ⟨h, p.2.isLt⟩, if_pos h]
  · rw [if_neg (fun e => h e.1), if_neg h]

theorem cnA_colA {m n : ℕ} (i j : Fin m) (hij : i ≠ j) (c : Fin n) (b : Fin m × Fin n → Fin 2) :
    cnA (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) b = colA i j c.val b := by
  funext p
  simp only [cnA, colA, NLogN.KFB.pos, Equiv.symm_apply_apply]
  by_cases h : p = (j, c)
  · subst h; simp
  · rw [if_neg (fun e => h (finProdFinEquiv.injective e)), if_neg]
    rintro ⟨h1, h2⟩; exact h (Prod.ext h1 (Fin.ext h2))

theorem swA_swA {m n : ℕ} (P Q : Fin (m * n)) (b : Fin m × Fin n → Fin 2) :
    swA P Q (swA P Q b) = b := by
  funext p
  unfold swA
  rw [Equiv.apply_symm_apply, Equiv.swap_apply_self, Equiv.symm_apply_apply]

theorem swA_cnA_swA {m n : ℕ} (i j : Fin m) (hij : i ≠ j) (c : Fin n) (b : Fin m × Fin n → Fin 2) :
    swA (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) (cnA (NLogN.KFB.pos j c) (NLogN.KFB.pos i c) (swA (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) b)) =
      colA i j c.val b := by
  funext p
  have k1 : ∀ q, swA (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) b q =
      b (finProdFinEquiv.symm (Equiv.swap (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) (finProdFinEquiv q))) := fun q => rfl
  show cnA (NLogN.KFB.pos j c) (NLogN.KFB.pos i c) (swA (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) b)
    (finProdFinEquiv.symm (Equiv.swap (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) (finProdFinEquiv p))) = _
  unfold cnA
  rw [k1, k1, Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.swap_apply_self,
    Equiv.symm_apply_apply, Equiv.swap_apply_right]
  have hpi : finProdFinEquiv.symm (NLogN.KFB.pos i c) = (i, c) := by simp [NLogN.KFB.pos]
  rw [hpi]
  unfold colA
  by_cases hp : p = (j, c)
  · subst hp
    rw [if_pos (by simp [NLogN.KFB.pos]), if_pos ⟨rfl, rfl⟩]
  · rw [if_neg, if_neg]
    · rintro ⟨e1, e2⟩; exact hp (Prod.ext e1 (Fin.ext e2))
    · intro e
      rw [Equiv.swap_apply_eq_iff, Equiv.swap_apply_left] at e
      exact hp (finProdFinEquiv.injective e)

theorem pos_val {m n : ℕ} (r : Fin m) (c : Fin n) : (NLogN.KFB.pos r c).val = c.val + n * r.val := rfl

theorem pos_gap {m n : ℕ} (i j : Fin m) (c : Fin n) (h : j.val < i.val) :
    (NLogN.KFB.pos i c).val = (NLogN.KFB.pos j c).val + (n * (i.val - j.val) - 1) + 1 := by
  rw [pos_val, pos_val]
  have hn : 0 < n := by have := c.isLt; omega
  have : n * (i.val - j.val) ≥ 1 := Nat.one_le_iff_ne_zero.2 (Nat.mul_ne_zero (by omega) (by omega))
  have e : n * i.val = n * j.val + n * (i.val - j.val) := by
    rw [← Nat.mul_add]; congr 1; omega
  omega

theorem rep_col {W m n : ℕ} (w : Fin W) (i j : Fin m) (hij : i ≠ j) (c : Fin n) (zs : List GI)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : Rep zs x) :
    Rep (colL W m n w.val i j c zs) (fun p => if p.1 = w then x (p.1, colA i j c.val p.2) else x p) := by
  unfold colL
  split_ifs with h
  · refine rep_congr (rep_cnot (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) _ (pos_gap i j c h) w zs x hx) ?_
    funext p; rw [cnA_colA i j hij c]
  · have h' : i.val < j.val := by
      rcases lt_trichotomy i.val j.val with e | e | e
      · exact e
      · exact absurd (Fin.ext e) hij
      · exact absurd e h
    have hPQ : (NLogN.KFB.pos i c).val < (NLogN.KFB.pos j c).val := by rw [pos_gap j i c h']; omega
    have H1 := rep_gsw (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) hPQ zs x hx
    have H2 := rep_cnot (NLogN.KFB.pos j c) (NLogN.KFB.pos i c) _ (pos_gap j i c h') w _ _ H1
    have H3 := rep_gsw (NLogN.KFB.pos i c) (NLogN.KFB.pos j c) hPQ _ _ H2
    refine rep_congr H3 ?_
    funext p
    simp only
    split_ifs
    · rw [swA_cnA_swA i j hij c]
    · rw [swA_swA]

theorem GB_colL {wb W m n : ℕ} (w : Fin W) (i j : Fin m) (hij : i ≠ j) (c : Fin n)
    (zs : List GI) (hl : zs.length = W * 2 ^ (m * n)) (hb : NLogN.KFB.GB wb zs) :
    NLogN.KFB.GB wb (colL W m n w.val i j c zs) := by
  have hlen : w.val * 2 ^ (m * n) + 2 ^ (m * n) ≤ W * 2 ^ (m * n) := by
    rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  have hK : ∀ a b : Fin m, a.val < b.val → (NLogN.KFB.pos a c).val + (n * (b.val - a.val) - 1) + 1 < m * n :=
    fun a b hab => by rw [← pos_gap b a c hab]; exact (NLogN.KFB.pos b c).isLt
  unfold colL
  split_ifs with h
  · exact GB_cnL (hK j i h) _ (by rw [hl]; exact hlen) hb
  · have h' : i.val < j.val := by
      rcases lt_trichotomy i.val j.val with e | e | e
      · exact e
      · exact absurd (Fin.ext e) hij
      · exact absurd e h
    exact GB_gswL _ _ _ (GB_cnL (hK i j h') _ (by rw [length_gswL, hl]; exact hlen)
      (GB_gswL _ _ _ hb))

theorem cGsw_eq (W K P Q wb : ℕ) : cGsw W K P Q wb = cGsw W K 0 0 wb := by
  simp only [cGsw, cSwapEF, pushCost, List.map_cons, List.map_nil, Ex.size]

theorem col_iruns {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (hW : 1 ≤ W) (w : Fin W) (i j : Fin m) (hij : i ≠ j)
    (c : Fin n) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hl : zs.length = W * 2 ^ (m * n)) (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB wb zs) :
    IRuns I iprog (colP W m n w.val i j c) (encK s f)
      (encK s (Function.update f 0 (gflat (colL W m n w.val i j c zs) ++ l)))
      (cColU W (m * n) wb) := by
  have hlen : w.val * 2 ^ (m * n) + 2 ^ (m * n) ≤ W * 2 ^ (m * n) := by
    rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right _ w.isLt
  have hK : ∀ a b : Fin m, a.val < b.val → (NLogN.KFB.pos a c).val + (n * (b.val - a.val) - 1) + 1 < m * n :=
    fun a b hab => by rw [← pos_gap b a c hab]; exact (NLogN.KFB.pos b c).isLt
  have hoff : w.val * 2 ^ (m * n) ≤ W * 2 ^ (m * n) := le_trans (Nat.le_add_right _ _) hlen
  have cm := cPass_mono (w := wb) (N := 2 ^ (m * n)) hoff
    (zsz_natCast_le (show 4 * (3 * 2 ^ (m * n) + w.val * 2 ^ (m * n)) ≤
      4 * (3 * 2 ^ (m * n) + W * 2 ^ (m * n)) by omega))
  unfold colP colL
  split_ifs with h
  · have H := cnot_fsp s wb (m * n) (NLogN.KFB.pos j c).val (n * (i.val - j.val) - 1) (w.val * 2 ^ (m * n))
      (hK j i h) f zs l (by rw [hl]; exact hlen) h0 hC hb
    refine (FSp.irun (fok_qopW _ _ _ _) H).mono ?_
    unfold cColU; omega
  · have h' : i.val < j.val := by
      rcases lt_trichotomy i.val j.val with e | e | e
      · exact e
      · exact absurd (Fin.ext e) hij
      · exact absurd e h
    have hPQ : (NLogN.KFB.pos i c).val < (NLogN.KFB.pos j c).val := by rw [pos_gap j i c h']; omega
    have S1 := gsw_iruns (I := I) (iprog := iprog) s wb W (m * n) (NLogN.KFB.pos i c).val (NLogN.KFB.pos j c).val hW hPQ
      (NLogN.KFB.pos j c).isLt f zs l hl h0 hb
    set z1 := gswL (NLogN.KFB.pos i c).val (NLogN.KFB.pos j c).val zs
    have l1 : z1.length = W * 2 ^ (m * n) := by rw [length_gswL, hl]
    have H := cnot_fsp s wb (m * n) (NLogN.KFB.pos i c).val (n * (j.val - i.val) - 1) (w.val * 2 ^ (m * n))
      (hK i j h') (Function.update f 0 (gflat z1 ++ l)) z1 l (by rw [l1]; exact hlen) (by simp)
      (hC.upd0 _) (GB_gswL _ _ _ hb)
    have S2 := FSp.irun (I := I) (iprog := iprog) (fok_qopW _ _ _ _) H
    rw [Function.update_idem] at S2
    set z2 := cnL (m * n) (NLogN.KFB.pos i c).val (n * (j.val - i.val) - 1) (w.val * 2 ^ (m * n)) z1
    have l2 : z2.length = W * 2 ^ (m * n) := by
      rw [length_cnL (hK i j h') _ (by rw [l1]; exact hlen), l1]
    have S3 := gsw_iruns (I := I) (iprog := iprog) s wb W (m * n) (NLogN.KFB.pos i c).val (NLogN.KFB.pos j c).val hW hPQ
      (NLogN.KFB.pos j c).isLt (Function.update f 0 (gflat z2 ++ l)) z2 l l2 (by simp)
      (GB_cnL (hK i j h') _ (by rw [l1]; exact hlen) (GB_gswL _ _ _ hb))
    rw [Function.update_idem] at S3
    refine (S1.seq (S2.seq S3)).mono ?_
    rw [cGsw_eq W (m * n) (NLogN.KFB.pos i c).val (NLogN.KFB.pos j c).val wb]
    unfold cColU; omega

theorem rowL_spec {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    (s : IState HS) (wb : ℕ) {W m n : ℕ} (hW : 1 ≤ W) (w : Fin W) (i j : Fin m) (hij : i ≠ j)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ)
    (hx : Rep zs x) (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB wb zs) : ∀ C, C ≤ n →
    Rep (NLogN.KFB.rowL W m n w.val i j C zs) (fun p => if p.1 = w then x (p.1, raC i j C p.2) else x p) ∧
    NLogN.KFB.GB wb (NLogN.KFB.rowL W m n w.val i j C zs) ∧
    IRuns I iprog (rowP W m n w.val i j C) (encK s f)
      (encK s (Function.update f 0 (gflat (NLogN.KFB.rowL W m n w.val i j C zs) ++ l)))
      (C * cColU W (m * n) wb + 1)
  | 0, _ => by
    refine ⟨rep_congr hx ?_, hb, ?_⟩
    · funext p; split_ifs with h
      · rw [raC_zero]
      · rfl
    · rw [show Function.update f 0 (gflat (NLogN.KFB.rowL W m n w.val i j 0 zs) ++ l) = f by
        rw [NLogN.KFB.rowL, ← h0, Function.update_eq_self]]
      exact (IRuns.skip _).mono (by simp)
  | C + 1, hC1 => by
    obtain ⟨R, B, H⟩ := rowL_spec s wb hW w i j hij f zs l x hx h0 hC hb C (by omega)
    have hCn : C < n := by omega
    simp only [NLogN.KFB.rowL, rowP, dif_pos hCn]
    set ys := NLogN.KFB.rowL W m n w.val i j C zs
    have hl : ys.length = W * 2 ^ (m * n) := R.1
    refine ⟨rep_congr (rep_col w i j hij ⟨C, hCn⟩ ys _ R) ?_, GB_colL w i j hij _ ys hl B, ?_⟩
    · funext p
      simp only
      split_ifs with h
      · rw [raC_colA i j hij C]
      · rfl
    · have S := col_iruns (I := I) (iprog := iprog) s wb hW w i j hij ⟨C, hCn⟩
        (Function.update f 0 (gflat ys ++ l)) ys l hl (by simp) (hC.upd0 _) B
      rw [Function.update_idem] at S
      refine (H.seq S).mono ?_
      rw [Nat.succ_mul]; omega

end NLogN.KFB

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFB
open IntMul RS AModel KIL KFD Complex
theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp}
    (s : NLogN.IState NLogN.HS) (wb : ℕ) {W m n : ℕ} (hW : 1 ≤ W) (T : Butterfly.Op (Fin n)) (w : Fin W)
    (i j : Fin m) (hij : i ≠ j) (f : Fin NLogN.HS → List ℤ) (zs : List NLogN.KFB.GI) (l : List ℤ)
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (hx : NLogN.KFB.Rep zs x) (h0 : f 0 = NLogN.KFB.gflat zs ++ l)
    (hC : NLogN.KFB.Cl f) (hb : NLogN.KFB.GB wb zs) :
    ∃ zs', NLogN.KFB.Rep zs' ((P8Lift.RStep.den T
        (P8Lift.RStep.rowAdd w i j hij : P8Lift.RStep (Fin W) m)).mulVec x) ∧ NLogN.KFB.GB wb zs' ∧
      NLogN.IRuns I iprog (NLogN.KFB.rowP W m n w.val i j n) (NLogN.KIL.encK s f)
        (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat zs' ++ l))) (n * NLogN.KFB.cColU W (m * n) wb + 1) := by
  obtain ⟨R, B, H⟩ := NLogN.KFB.rowL_spec s wb hW w i j hij f zs l x hx h0 hC hb n le_rfl
  refine ⟨_, NLogN.KFB.rep_congr R ?_, B, H⟩
  funext p
  rw [NLogN.KFB.den_rowAdd_mulVec, NLogN.KFB.raC_full]
end
