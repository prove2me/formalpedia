/-!
# Transport layer II.b: entrywise calculus of matrix-valued fields (ATLAS-II)

`pdM i A y` is the matrix of slice derivatives `pd i (A · a b) y` of a matrix field `A : Pt n → Matrix`
(B3 class B: a notation wrapper over `pd`, bridge `pdM_apply` is `rfl`). `SmoothOn A U` says every entry
is `C^∞` on `U`. On an open set all the usual rules hold with genuine derivatives:

* product rule `pdM i (A·B) = (pdM i A)·B + A·(pdM i B)`, linearity, finite sums, scalar multiples;
* derivative of an inverse: `K·J = 1` on `U` ⇒ `pdM i K = −K·(pdM i J)·K`;
* chain rule `pdM i (B ∘ Φ) y = Σ_e J y e i • pdM e B (Φ y)`;
* symmetry `pdM c (pdM d A) = pdM d (pdM c A)`;
* smoothness of a right inverse `K` of a smooth `J` (`K = det(J)⁻¹ • adjugate J`), and of the genuine
  Jacobian of a `C^∞` map (`smoothOn_jacobian`).

Nothing here mentions a metric or a connection.
-/

open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

@[simp] theorem pdM_apply (i : Fin n) (A : Pt n → Matrix (Fin n) (Fin n) ℝ) (y : Pt n) (a b : Fin n) :
    pdM i A y a b = pd i (fun z => A z a b) y := rfl

namespace SmoothOn

variable {U V : Set (Pt n)} {A B : Pt n → Matrix (Fin n) (Fin n) ℝ}

end SmoothOn

/-! ### Rules for `pdM` on an open set -/

section rules

variable {U : Set (Pt n)} (hU : IsOpen U) {y : Pt n} (hy : y ∈ U) (i : Fin n)
  {A B : Pt n → Matrix (Fin n) (Fin n) ℝ}
include hU hy

end rules

/-! ### Smoothness of Jacobians and of their inverses -/

/-- The genuine Jacobian of a `C^∞` map is `C^∞` (its entries are `pd` of the components). -/
theorem smoothOn_jacobian {U : Set (Pt n)} (hU : IsOpen U) {Φ : Pt n → Pt n}
    {J : Pt n → Matrix (Fin n) (Fin n) ℝ} (hΦ : ContDiffOn ℝ ∞ Φ U)
    (hJ : ∀ y ∈ U, ∀ k i : Fin n,
      HasDerivAt (fun u : ℝ => Φ (Function.update y i u) k) (J y k i) (y i)) :
    SmoothOn J U := by
  intro k i
  have hk : ContDiffOn ℝ ∞ (fun y => Φ y k) U := (contDiffOn_pi.mp hΦ) k
  exact (contDiffOn_pd hU hk i).congr fun y hy => (pd_eq_of_hasDerivAt (hJ y hy k i)).symm

end ExactVacuumAtlas

