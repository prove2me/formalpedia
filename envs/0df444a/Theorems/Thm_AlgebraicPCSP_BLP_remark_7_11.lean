-- title:
--   Remark 7.11 — LP(A) is isomorphic to the free structure F_𝒬(A) of 𝒬_conv
-- statement:
--   Let $\mathbf A$ be a finite relational structure with universe enumerated as $A=\{a_1,\dots,a_n\}$, and fix an enumeration of each relation $R^{\mathbf A}$. Let $\mathbf F_{\mathcal Q}(\mathbf A)$ be the free structure of the minion $\mathcal Q_{\mathrm{conv}}$ generated by $\mathbf A$. Then the map $h:\mathrm{LP}(\mathbf A)\to\mathbf F_{\mathcal Q}(\mathbf A)$,
--   $$h(\phi)=f_\phi,\qquad f_\phi(x_1,\dots,x_n)=\sum_{i\in[n]}\phi(a_i)\,x_i,$$
--   is an isomorphism of structures: a bijection onto the $n$-ary convex linear functions such that, for every relation $R$ and every tuple $(\phi_1,\dots,\phi_k)$,
--   $$(\phi_1,\dots,\phi_k)\in R^{\mathrm{LP}(\mathbf A)}\iff (f_{\phi_1},\dots,f_{\phi_k})\in R^{\mathbf F_{\mathcal Q}(\mathbf A)}.$$
--
--   The remark identifies the LP structure with an algebraic object, which lets the proof of Theorem 7.9 treat $\mathrm{LP}(\mathbf A)$ as an infinite instance of the free-structure argument (compare Lemma 4.11).
--
--   **Formalization Note** The enumeration of $A$ is an equivalence $e:\mathrm{Fin}\,n\simeq A$ and the enumerations of the relations are explicit parameters of the free structure; the statement holds for every choice. The isomorphism is stated as an `Equiv` together with the formula for $h$ and the preservation and reflection of every relation.
-- source:
--   L. Barto, J. Bulín, A. Krokhin, J. Opršal, Algebraic approach to promise constraint satisfaction, arXiv:1811.00970v3, p. 47, Remark 7.11

import Mathlib
import Definitions.Def_PCSPBLPAff_Symmetric_Setting
import Definitions.Def_AlgebraicPCSP_Theory_MinorCondition
import Definitions.Def_AlgebraicPCSP_BLP_Qconv
import Definitions.Def_AlgebraicPCSP_BLP_LP

namespace AlgebraicPCSP.BLP

open PCSPBLPAff.Symmetric

/-- Remark 7.11 (arXiv:1811.00970v3, p. 47): `LP(𝔸)` is isomorphic to the free structure
`F_𝒬(𝔸)` of the minion `𝒬_conv` generated by `𝔸`. With the enumeration `aᵢ = e i` of `A`
and any enumerations `eR` of the relations of `𝔸`, the map `h(ϕ) = f_ϕ`,
`f_ϕ(x₁, …, xₙ) = ∑_{i ∈ [n]} ϕ(aᵢ)xᵢ`, is a bijection from `LP(𝔸)` onto the `n`-ary members
of `𝒬_conv` that preserves and reflects every relation. -/
theorem remark_7_11 {τ : Type} {ar : τ → ℕ} {A : Type} [Fintype A] [DecidableEq A]
    (𝔸 : RelStruct τ ar A) {n : ℕ} (e : Fin n ≃ A) (m : τ → ℕ)
    (eR : (R : τ) → Fin (m R) ≃ 𝔸.rel R) :
    ∃ h : LPDist A ≃ {f // f ∈ convexMinion.mem n},
      (∀ ϕ : LPDist A, (h ϕ).val = fun x : Fin n → ℚ => ∑ i, ϕ.val (e i) * x i) ∧
      ∀ (R : τ) (t : Fin (ar R) → LPDist A),
        t ∈ (LP 𝔸).rel R ↔
          (fun i => h (t i)) ∈ (AlgebraicPCSP.Theory.freeStructure convexMinion 𝔸 e m eR).rel R := by sorry

end AlgebraicPCSP.BLP
