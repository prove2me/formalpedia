theorem SArgs.v_bnd (A : SArgs) (s0 : IState HS) (B : ℕ) (hF : A.Fine s0 B) (k : Fin 7) :
    zsz (A.v s0 k) ≤ B := by
  have h : ∀ e ∈ A.l, zsz (e.eval s0) ≤ B := fun e he => Ex.zsz_eval_le s0 B e (hF e he).2.2.2.1
  fin_cases k <;> simp only [SArgs.v] <;> apply h <;> simp [SArgs.l]

set_option maxHeartbeats 16000000 in
theorem stageP_okc (M : MulSpec) (m Φ B sh dmax : ℕ) (hM : MulBnd M m Φ)
    (A : SArgs) (hA : A.Good) (s0 : IState HS) (hF : A.Fine s0 B) (R : ℤ) (U : List (ℤ × ℤ))
    (Dl : List ℕ) (Ws : List (List ℤ)) (a NR n : ℕ) (RU RW RD : List Item)
    (hs : 0 < U.length) (ha : a < U.length) (hWs : Ws.length = NR) (hWr : ∀ W ∈ Ws, W.length = n)
    (hDl : Dl.length = n) (hpre : NLogN.Rsp.pre Dl n ≤ U.length)
    (hU : s0.G CU = gints U ++ RU) (hW : s0.G NLogN.Rsp.BW = ints Ws.flatten ++ RW)
    (hD : s0.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD)
    (v1 : A.eKs.eval s0 = U.length) (v2 : A.eKa.eval s0 = a)
    (v3 : A.eKN.eval s0 = ((U.length + NR : ℕ) : ℤ)) (v4 : A.eBR.eval s0 = R)
    (v5 : A.eBN.eval s0 = n) (v6 : A.eBNR.eval s0 = NR) (v7 : A.eBNW.eval s0 = ((n * NR : ℕ) : ℤ))
    (hRsh : R = 2 ^ sh) (hu : ∀ z ∈ U, zsz z.1 ≤ m ∧ zsz z.2 ≤ m)
    (hWB : ∀ W ∈ Ws, ∀ y ∈ W, zsz y ≤ m)
    (hAcc : (NR + 1) * 2 ^ (2 * m) ≤ 2 ^ B) (hmB : 2 * m ≤ B)
    (hLB : zsz ((U.length + NR : ℕ) : ℤ) ≤ B) (hsh : sh + 1 ≤ B)
    (hnB : zsz ((n * NR : ℕ) : ℤ) ≤ B) (hn1 : zsz (n : ℤ) ≤ B) (hdm : ∀ d ∈ Dl, d ≤ dmax) :
    (stageP A).ok M s0 ∧
      (stageP A).cost M s0 ≤ 7 * (4 * 2000 * (B + 2)) + gresCost U.length NR n m Φ B dmax +
        7 * (2 * B + 2) ∧
      ∀ z ∈ gresL R Dl Ws U a n, zsz z.1 ≤ B ∧ zsz z.2 ≤ B := by
  have hp := pushesP_okc A hA s0 B hF
  obtain ⟨σ, hσ⟩ : ∃ q, q = NLogN.Rsp.pSt s0 (A.v s0) := ⟨_, rfl⟩
  have g : ∀ i, i ∉ stTg → σ.G i = s0.G i := fun i hi => hσ ▸ pSt_G_other s0 _ i hi
  have a1 : σ.G CU = gints U ++ RU := by rw [g _ (by decide), hU]
  have a2 : σ.G Ks = .int (U.length : ℤ) :: s0.G Ks := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v1]
  have a3 : σ.G Ka = .int (a : ℤ) :: s0.G Ka := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v2]
  have a4 : σ.G KN = .int ((U.length + NR : ℕ) : ℤ) :: s0.G KN := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v3]
  have a5 : σ.G BR = .int R :: s0.G BR := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v4]
  have a6 : σ.G BN = .int (n : ℤ) :: s0.G BN := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v5]
  have a7 : σ.G BNR = .int (NR : ℤ) :: s0.G BNR := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v6]
  have a8 : σ.G BNW = .int ((n * NR : ℕ) : ℤ) :: s0.G BNW := by
    simp (config := {decide := true}) [hσ, NLogN.Rsp.pSt, SArgs.v, v7]
  have a9 : σ.G NLogN.Rsp.BW = ints Ws.flatten ++ RW := by rw [g _ (by decide), hW]
  have a10 : σ.G BD = ints (Dl.map (Nat.cast : ℕ → ℤ)) ++ RD := by rw [g _ (by decide), hD]
  have hg := gresP_okc M m Φ B sh dmax hM σ R U Dl Ws a NR n RU (s0.G Ks) (s0.G Ka) (s0.G KN)
    (s0.G BR) (s0.G BN) (s0.G BNR) (s0.G BNW) RW RD hs ha hWs hWr hDl hpre a1 a2 a3 a4 a5 a6 a7 a8
    a9 a10 hRsh hu hWB hAcc hmB hLB hsh hnB hn1 hdm
  have hr := gresP_run σ R U Dl Ws a NR n RU (s0.G Ks) (s0.G Ka) (s0.G KN) (s0.G BR) (s0.G BN)
    (s0.G BNR) (s0.G BNW) RW RD hs ha hWs hWr hDl hpre a1 a2 a3 a4 a5 a6 a7 a8 a9 a10
  have hq := popsP_okc s0 (A.v s0) B (SArgs.v_bnd A s0 B hF) (gresP.run σ) (by
    intro i hi; rw [hr]
    have : i ≠ CU := by
      simp only [stTg, List.mem_cons, List.not_mem_nil, or_false] at hi
      rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    simp [this, hσ])
  refine ⟨?_, ?_, hg.2.2⟩
  · simp only [stageP, RM.ok, RM.run_seq, RM.run_rs, pushesP_run A hA s0, ← hσ]
    exact ⟨hp.1, hg.1, hq.1⟩
  · simp only [stageP, RM.cost_seq', RM.cost_rs', RM.run_seq, RM.run_rs, pushesP_run A hA s0, ← hσ]
    have := hp.2; have := hg.2.1; have := hq.2
    omega

end NLogN.Rsp

