theorem mem_transposeL {α : Type*} [Inhabited α] (n m : ℕ) (L : List α) (x : α)
    (hx : x ∈ Ref.transposeL n m L) : x ∈ L ∨ x = default := by
  simp only [Ref.transposeL, List.mem_map, List.mem_range] at hx
  obtain ⟨q, _, rfl⟩ := hx
  by_cases h : (q % n) * m + q / n < L.length
  · left; rw [List.getD_eq_getElem _ _ h]; exact List.getElem_mem h
  · right; rw [List.getD_eq_default _ _ (by omega)]

theorem canon_transposeL {F : ℤ} (hF : 0 < F) (n m : ℕ) (L : List ℤ) (h : Canon F L) :
    Canon F (Ref.transposeL n m L) := by
  intro x hx
  rcases mem_transposeL n m L x hx with h1 | h1
  · exact h x h1
  · subst h1; exact ⟨le_rfl, hF⟩

