-- title:
--   Proposition 6.2, p. 26 — metric subregularity of ∂L_γ with Assumption 3 implies the VP-EB error bound
-- statement:
--   Work in the standing setting of the paper: problem (P) satisfies Assumptions 1 and 2, the step bound $\delta_k$ is set by (8), and $\{w^k\}$ is generated by NAPP-AL. Let $\bar w$ be a cluster point of $\{w^k\}$ and let $\bar{\mathbf W}$ be the set of stationary points.
--
--   Suppose that
--   1. Assumption 3 holds at $\bar w$ with radius $\delta>0$: $\mathcal L_\gamma(w)\le\mathcal L_\gamma(\bar w)$ whenever $w\in\bar{\mathbf W}$ and $\|w-\bar w\|\le\delta$;
--   2. $\partial\mathcal L_\gamma$ is metrically subregular around $(\bar w,0)$ with modulus $\kappa_3>0$ and radius $\eta>0$, i.e. $\mathrm{dist}(w,\bar{\mathbf W})\le\kappa_3\,\mathrm{dist}(0,\partial\mathcal L_\gamma(w))$ for all $w\in\mathbb B(\bar w;\eta)$;
--   3. $\eta<\delta$.
--
--   Then the value proximity error bound holds at $\bar w$: there exist $\kappa_1>0$, $\eta'>0$ and $\nu>0$ such that for every $k$,
--   $$\|w^{k+1}-\bar w\|<\eta',\ \ \mathcal L_\gamma(w^{k+1})<\mathcal L_\gamma(\bar w)+\nu\ \Longrightarrow\ \mathcal L_\gamma(w^{k+1})-\mathcal L_\gamma(\bar w)\le\kappa_1\|w^k-w^{k+1}\|^2.$$
--
--   Combined with Theorem 5.1 of the paper, this gives linear convergence of NAPP-AL under metric subregularity of the stationarity map, a condition that is often easier to verify than the KL property.
--
--   **Formalization Note** "Generated by NAPP-AL" carries the standing setting of Theorem 4.1 (Assumptions 1–2 and rule (8)), which the proof uses through Theorem 4.1(iv) and Lemma 6.1. The conclusion is existential in $(\kappa_1,\eta',\nu)$, as Definition 5.1 is; the radius $\eta'$ need not equal the subregularity radius $\eta$. Distances live in $[0,+\infty]$ with $\mathrm{dist}(\cdot,\emptyset)=+\infty$. VP-EB is read without the presupposition that $\{w^k\}$ converges to $\bar w$.
-- source:
--   Zhu, Zhao, Zhang, A First-Order Primal-Dual Method for Nonconvex Constrained Optimization Based on the Augmented Lagrangian, arXiv:2007.12219v1, p. 26, Proposition 6.2; Definition 6.2 and Assumption 3, p. 23; Definition 5.1, p. 19

import Mathlib
import Definitions.Def_NAPPAL_Subreg_Setting
import Definitions.Def_NAPPAL_Subreg_Subregularity

namespace NAPPAL.Subreg

open NAPPAL.Rate (qseq)
open NAPPAL.KL (wseq)

theorem proposition_6_2 {n d m : ℕ} (P : NAPPAL.KL.Problem n d m) (LG LH L0 : ℝ) (LOmj : Fin m → ℝ)
    (LK : ℝ) (K : NAPPAL.KL.E n → ℝ) (β γ σ : ℝ) (δ ε : ℕ → ℝ)
    (u : ℕ → NAPPAL.KL.E n) (v : ℕ → NAPPAL.KL.E d) (p : ℕ → NAPPAL.KL.E m)
    (hrun : RunHyp P LG LH L0 LOmj LK K β γ σ δ ε u v p)
    (wbar : NAPPAL.KL.W n d m) (hcl : MapClusterPt wbar Filter.atTop (wseq u v p))
    (δ3 η κ3 : ℝ) (hA3 : Assumption3 P γ wbar δ3) (hMS : MetricSubregularAt P γ wbar η κ3)
    (hηδ : η < δ3) :
    ∃ κ1 η' ν : ℝ, NAPPAL.KL.VPEB P γ (wseq u v p) wbar κ1 η' ν := by sorry

end NAPPAL.Subreg
