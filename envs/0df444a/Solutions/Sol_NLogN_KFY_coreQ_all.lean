theorem gints_append (L L' : List (ℤ × ℤ)) : gints (L ++ L') = gints L ++ gints L' := by
  simp [gints]

theorem pairInts_length (L : List (ℤ × ℤ)) : (pairInts L).length = 2 * L.length := by
  induction L with
