import Mathlib
import Definitions.Def_IntMul_Kappa_R6_Defs3
-- Round-six κ development (integer-multiplication-kappa), generated by skeleton subtraction.


set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open J6Seg
open Finset
variable (bl : ℕ → Finset ℕ) (Mx : ℕ → ℕ → ℝ) (Hs : ℕ → Finset ℤ) (cl : ℕ → ℤ → ℕ)
  (cf : ℕ → ℤ → ℝ)

omit Hs cl cf in
theorem h49_Mv_sub (bl : ℕ → Finset ℕ) (Mx : ℕ → ℕ → ℝ) (f g : ℕ → ℝ) (i : ℕ) :
    Mv bl Mx (fun k => f k - g k) i = Mv bl Mx f i - Mv bl Mx g i := by
  unfold Mv; rw [← Finset.sum_sub_distrib]; congr 1; ext k; ring

omit Hs cl cf in
theorem h49_Mv_abs (bl : ℕ → Finset ℕ) (Mx : ℕ → ℕ → ℝ) (f : ℕ → ℝ) (i : ℕ) {A F : ℝ}
    (hF0 : 0 ≤ F) (hf : ∀ k ∈ bl i, |f k| ≤ F) (hA : ∑ k ∈ bl i, |Mx i k| ≤ A) :
    |Mv bl Mx f i| ≤ A * F := by
  unfold Mv
  calc |∑ k ∈ bl i, Mx i k * f k| ≤ ∑ k ∈ bl i, |Mx i k * f k| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ k ∈ bl i, |Mx i k| * F := Finset.sum_le_sum fun k hk => by
        rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hf k hk) (abs_nonneg _)
    _ = (∑ k ∈ bl i, |Mx i k|) * F := by rw [Finset.sum_mul]
    _ ≤ A * F := mul_le_mul_of_nonneg_right hA hF0

omit bl Mx in
theorem h49_Dv_sub (Hs : ℕ → Finset ℤ) (cl : ℕ → ℤ → ℕ) (cf : ℕ → ℤ → ℝ) (f g : ℕ → ℝ) (i : ℕ) :
    Dv Hs cl cf (fun k => f k - g k) i = Dv Hs cl cf f i - Dv Hs cl cf g i := by
  unfold Dv; rw [← Finset.sum_sub_distrib]; congr 1; ext k; ring

omit bl Mx in
theorem h49_Dv_abs (Hs : ℕ → Finset ℤ) (cl : ℕ → ℤ → ℕ) (cf : ℕ → ℤ → ℝ) (f : ℕ → ℝ) (i : ℕ)
    {d F : ℝ} (hF0 : 0 ≤ F) (hf : ∀ h ∈ Hs i, |f (cl i h)| ≤ F) (hd : ∑ h ∈ Hs i, |cf i h| ≤ d) :
    |Dv Hs cl cf f i| ≤ d * F := by
  unfold Dv
  calc |∑ h ∈ Hs i, cf i h * f (cl i h)| ≤ ∑ h ∈ Hs i, |cf i h * f (cl i h)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ h ∈ Hs i, |cf i h| * F := Finset.sum_le_sum fun h hh => by
        rw [abs_mul]; exact mul_le_mul_of_nonneg_left (hf h hh) (abs_nonneg _)
    _ = (∑ h ∈ Hs i, |cf i h|) * F := by rw [Finset.sum_mul]
    _ ≤ d * F := mul_le_mul_of_nonneg_right hd hF0

theorem solution (Mi : ℕ → ℕ → ℝ) {I J : Finset ℕ} {u W y y₂ x z : ℕ → ℝ}
    {ε₁ ε₂ ε₃ ε₄ A d μ : ℝ} (hJI : J ⊆ I) (hblI : ∀ i ∈ I, bl i ⊆ I)
    (hcl : ∀ i ∈ I, ∀ h ∈ Hs i, cl i h ∈ J)
    (hMM : ∀ i ∈ I, ∀ f : ℕ → ℝ, Mv bl Mx (Mv bl Mi f) i = f i)
    (hMi : ∀ (f : ℕ → ℝ) (F : ℝ), (∀ k ∈ I, |f k| ≤ F) → ∀ i ∈ I, |Mv bl Mi f i| ≤ μ * F)
    (hA : ∀ i ∈ I, ∑ k ∈ bl i, |Mx i k| ≤ A) (hd : ∀ i ∈ I, ∑ h ∈ Hs i, |cf i h| ≤ d)
    (hd0 : 0 ≤ d) (hμ : 0 ≤ μ) (hε₂ : 0 ≤ ε₂) (hε₃ : 0 ≤ ε₃) (hε₄ : 0 ≤ ε₄)
    (hx : ∀ i, x i = y i - y₂ i)
    (h1 : ∀ i ∈ I, |y i - Mv bl Mi u i| ≤ ε₁)
    (h2 : ∀ i ∈ I, |y₂ i - Mv bl Mi W i| ≤ ε₂)
    (h3 : ∀ i ∈ I, |W i - Dv Hs cl cf z i| ≤ ε₃)
    (h4 : ∀ a ∈ J, |z a + Mv bl Mi (Dv Hs cl cf z) a - y a| ≤ ε₄) :
    ∀ i ∈ I, |Mv bl Mx x i + Dv Hs cl cf x i - u i| ≤
      A * (ε₁ + ε₂) + ε₃ + d * (ε₄ + μ * ε₃ + ε₂) := by
  intro i hi
  have hε₁ : 0 ≤ ε₁ := le_trans (abs_nonneg _) (h1 i hi)
  -- errors e1 = y - M⁻¹u, e2 = y₂ - M⁻¹W on I
  set e1 : ℕ → ℝ := fun k => y k - Mv bl Mi u k with he1
  set e2 : ℕ → ℝ := fun k => y₂ k - Mv bl Mi W k with he2
  -- M y = u + M e1, M y₂ = W + M e2 at i
  have hMy : Mv bl Mx y i = u i + Mv bl Mx e1 i := by
    rw [he1, h49_Mv_sub, hMM i hi u]
    have : (fun k => y k) = y := rfl
    ring_nf
  have hMy₂ : Mv bl Mx y₂ i = W i + Mv bl Mx e2 i := by
    rw [he2, h49_Mv_sub, hMM i hi W]; ring
  have hMx : Mv bl Mx x i = Mv bl Mx y i - Mv bl Mx y₂ i := by
    rw [← h49_Mv_sub]; unfold Mv; congr 1; ext k; rw [hx k]
  have hMe : |Mv bl Mx (fun k => e1 k - e2 k) i| ≤ A * (ε₁ + ε₂) :=
    h49_Mv_abs bl Mx _ i (by linarith) (fun k hk => by
      have hkI := hblI i hi hk
      have a1 := h1 k hkI
      have a2 := h2 k hkI
      calc |e1 k - e2 k| ≤ |e1 k| + |e2 k| := abs_sub _ _
        _ ≤ ε₁ + ε₂ := add_le_add a1 a2) (hA i hi)
  -- x on J
  set e3 : ℕ → ℝ := fun k => W k - Dv Hs cl cf z k with he3
  have hMie3 : ∀ a ∈ I, |Mv bl Mi e3 a| ≤ μ * ε₃ := hMi e3 ε₃ (fun k hk => h3 k hk)
  have hxJ : ∀ a ∈ J, |x a - z a| ≤ ε₄ + μ * ε₃ + ε₂ := by
    intro a ha
    have haI := hJI ha
    have k4 := h4 a ha
    have k2 := h2 a haI
    have k3 := hMie3 a haI
    have hsplit : Mv bl Mi W a = Mv bl Mi (Dv Hs cl cf z) a + Mv bl Mi e3 a := by
      rw [he3, h49_Mv_sub]; ring
    rw [hx a]
    have : x a - z a = -(z a + Mv bl Mi (Dv Hs cl cf z) a - y a) - (y₂ a - Mv bl Mi W a)
        - Mv bl Mi e3 a := by rw [hx a, hsplit]; ring
    rw [← hx a, this]
    calc |-(z a + Mv bl Mi (Dv Hs cl cf z) a - y a) - (y₂ a - Mv bl Mi W a) - Mv bl Mi e3 a|
        ≤ |z a + Mv bl Mi (Dv Hs cl cf z) a - y a| + |y₂ a - Mv bl Mi W a| + |Mv bl Mi e3 a| := by
          have := abs_sub (-(z a + Mv bl Mi (Dv Hs cl cf z) a - y a) - (y₂ a - Mv bl Mi W a)) (Mv bl Mi e3 a)
          have := abs_sub (-(z a + Mv bl Mi (Dv Hs cl cf z) a - y a)) (y₂ a - Mv bl Mi W a)
          rw [abs_neg] at this
          linarith
      _ ≤ ε₄ + ε₂ + μ * ε₃ := by linarith
      _ = ε₄ + μ * ε₃ + ε₂ := by ring
  have hDx : |Dv Hs cl cf (fun k => x k - z k) i| ≤ d * (ε₄ + μ * ε₃ + ε₂) :=
    h49_Dv_abs Hs cl cf _ i (by positivity) (fun h hh => hxJ _ (hcl i hi h hh)) (hd i hi)
  rw [h49_Dv_sub] at hDx
  rw [h49_Mv_sub] at hMe
  have k3 := h3 i hi
  have key : Mv bl Mx x i + Dv Hs cl cf x i - u i =
      (Mv bl Mx e1 i - Mv bl Mx e2 i) + (Dv Hs cl cf x i - Dv Hs cl cf z i) + (Dv Hs cl cf z i - W i) := by
    rw [hMx, hMy, hMy₂]; ring
  rw [key]
  calc |(Mv bl Mx e1 i - Mv bl Mx e2 i) + (Dv Hs cl cf x i - Dv Hs cl cf z i) + (Dv Hs cl cf z i - W i)|
      ≤ |Mv bl Mx e1 i - Mv bl Mx e2 i| + |Dv Hs cl cf x i - Dv Hs cl cf z i| + |Dv Hs cl cf z i - W i| := by
        have := abs_add_le ((Mv bl Mx e1 i - Mv bl Mx e2 i) + (Dv Hs cl cf x i - Dv Hs cl cf z i)) (Dv Hs cl cf z i - W i)
        have := abs_add_le (Mv bl Mx e1 i - Mv bl Mx e2 i) (Dv Hs cl cf x i - Dv Hs cl cf z i)
        linarith
    _ ≤ A * (ε₁ + ε₂) + d * (ε₄ + μ * ε₃ + ε₂) + ε₃ := by
        rw [abs_sub_comm (Dv Hs cl cf z i)] at *
        linarith
    _ = _ := by ring

