import Definitions.Def_HGASUndecidable_Main_Compactification

open Filter Topology MeasureTheory
open scoped BigOperators

namespace HGASUndecidable.Main

theorem proposition_9_5 (a : DiophantineData) (ha : DiophantineValid a)
    (M : ℕ) (hM : admissiblePower a M) (M₀ K₀ : ℚ) (hb : Bounds94 a M₀ K₀) (e : ℕ) :
    (∃ Ψ : Flow ℝ (compactSet a), FlowSolves (compactSet a)
      (compactVector a e M (gain a M₀ K₀ e)) Ψ) ∧
    ∀ Ψ : Flow ℝ (compactSet a), FlowSolves (compactSet a)
      (compactVector a e M (gain a M₀ K₀ e)) Ψ →
      (haltingSet e → beta Ψ (fun v => reward a M₀ v.val) ≤ -(margin M₀ : ℝ) ∧
        -(margin M₀ : ℝ) < 0) ∧
      (¬haltingSet e → (5/4 : ℝ)*(wStar M₀ : ℝ) ≤ beta Ψ (fun v => reward a M₀ v.val) ∧
        0 < (5/4 : ℝ)*(wStar M₀ : ℝ)) := by sorry

end HGASUndecidable.Main
