section

variable (ι : Type*) [Fintype ι] [DecidableEq ι]
variable (R K : Type*) [CommRing R] [IsDedekindDomain R] [Field K] [Algebra R K] [IsFractionRing R K]
variable (v : HeightOneSpectrum R)

private theorem coe_localToAdelicN (k : GL ι (v.adicCompletion K)) :
    ((localToAdelicN ι R K v k : GL ι (AdeleRing R K)) : Matrix ι ι (AdeleRing R K)) =
      finMatN ι R K (localMatN ι R K v (k : Matrix ι ι (v.adicCompletion K))) := rfl

private theorem coe_componentAtN (g : GL ι (AdeleRing R K)) :
    ((componentAtN ι R K v g : GL ι (v.adicCompletion K)) : Matrix ι ι (v.adicCompletion K)) =
      (AdelicLevel.finAdeleEval R K v).mapMatrix
        ((AdelicLevel.adeleFin R K).mapMatrix (g : Matrix ι ι (AdeleRing R K))) := by
  ext i j
  rfl

private theorem coe_archComponentN (g : GL ι (AdeleRing R K)) :
    ((archComponentN ι R K g : GL ι (InfiniteAdeleRing K)) : Matrix ι ι (InfiniteAdeleRing K)) =
      (AdelicLevel.adeleArch R K).mapMatrix (g : Matrix ι ι (AdeleRing R K)) := rfl

private theorem componentAtN_localToAdelicN_self (k : GL ι (v.adicCompletion K)) :
    componentAtN ι R K v (localToAdelicN ι R K v k) = k := by
  apply Units.ext
  rw [coe_componentAtN, coe_localToAdelicN, mapMatrix_fin_finMatN, mapMatrix_localMatN_self]

private theorem componentAtN_localToAdelicN_of_ne
    {w : HeightOneSpectrum R} (hw : w ≠ v) (k : GL ι (v.adicCompletion K)) :
    componentAtN ι R K w (localToAdelicN ι R K v k) = 1 := by
  apply Units.ext
  rw [coe_componentAtN, coe_localToAdelicN, mapMatrix_fin_finMatN, mapMatrix_localMatN_of_ne ι R K v _ hw,
    Units.val_one]

private theorem archComponentN_localToAdelicN (k : GL ι (v.adicCompletion K)) :
    archComponentN ι R K (localToAdelicN ι R K v k) = 1 := by
  apply Units.ext
  rw [coe_archComponentN, coe_localToAdelicN, mapMatrix_arch_finMatN, Units.val_one]

private theorem localToAdelicN_injective : Function.Injective (localToAdelicN ι R K v) :=
  Function.LeftInverse.injective (componentAtN_localToAdelicN_self ι R K v)

end

section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem componentAt3_localToAdelic3_self (k : LocalGL3 v) : componentAt3 (𝓞 ℚ) ℚ v (localToAdelic3 v k) = k :=
  componentAtN_localToAdelicN_self (Fin 3) (𝓞 ℚ) ℚ v k

private theorem componentAt3_localToAdelic3_of_ne {w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ≠ v) (k : LocalGL3 v) :
    componentAt3 (𝓞 ℚ) ℚ w (localToAdelic3 v k) = 1 :=
  componentAtN_localToAdelicN_of_ne (Fin 3) (𝓞 ℚ) ℚ v hw k

private theorem archComponent3_localToAdelic3 (k : LocalGL3 v) : archComponent3 (𝓞 ℚ) ℚ (localToAdelic3 v k) = 1 :=
  archComponentN_localToAdelicN (Fin 3) (𝓞 ℚ) ℚ v k

private theorem localToAdelic3_injective : Function.Injective (localToAdelic3 v) :=
  localToAdelicN_injective (Fin 3) (𝓞 ℚ) ℚ v

private theorem componentAt3_mul_localToAdelic3_of_ne
    {w : HeightOneSpectrum (𝓞 ℚ)} (hw : w ≠ v) (g : AdelicGL 3 (𝓞 ℚ) ℚ)
    (k : LocalGL3 v) : componentAt3 (𝓞 ℚ) ℚ w (g * localToAdelic3 v k) = componentAt3 (𝓞 ℚ) ℚ w g := by
  simp only [map_mul, componentAt3_localToAdelic3_of_ne v hw, mul_one]

private theorem componentAt3_mul_localToAdelic3_self (g : AdelicGL 3 (𝓞 ℚ) ℚ) (k : LocalGL3 v) :
    componentAt3 (𝓞 ℚ) ℚ v (g * localToAdelic3 v k) = componentAt3 (𝓞 ℚ) ℚ v g * k := by
  simp only [map_mul, componentAt3_localToAdelic3_self]

private theorem archComponent3_mul_localToAdelic3 (g : AdelicGL 3 (𝓞 ℚ) ℚ) (k : LocalGL3 v) :
    archComponent3 (𝓞 ℚ) ℚ (g * localToAdelic3 v k) = archComponent3 (𝓞 ℚ) ℚ g := by
  simp only [map_mul, archComponent3_localToAdelic3, mul_one]

end

section

private theorem finite_setOf_one_lt_valued_finAdeleEval (x : AdeleRing (𝓞 ℚ) ℚ) :
    {v : HeightOneSpectrum (𝓞 ℚ) |
      ¬ Valued.v (AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v (AdelicLevel.adeleFin (𝓞 ℚ) ℚ x)) ≤ 1}.Finite := by
  have h := Filter.eventually_cofinite.1 (RestrictedProduct.eventually
    (fun w : HeightOneSpectrum (𝓞 ℚ) => w.adicCompletion ℚ)
    (fun w : HeightOneSpectrum (𝓞 ℚ) => (w.adicCompletionIntegers ℚ : Set (w.adicCompletion ℚ))) x.2)
  refine h.subset fun v hv => ?_
  first
    | simpa only [Set.mem_setOf_eq, SetLike.mem_coe, HeightOneSpectrum.mem_adicCompletionIntegers,
        AdelicLevel.finAdeleEval_apply, AdelicLevel.adeleFin_apply] using hv
    | (simp only [Set.mem_setOf_eq, SetLike.mem_coe, HeightOneSpectrum.mem_adicCompletionIntegers,
        AdelicLevel.finAdeleEval_apply, AdelicLevel.adeleFin_apply] at hv ⊢; exact hv)
    | exact hv

private theorem finite_setOf_not_mem_localMaximalCompact3 (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    {v : HeightOneSpectrum (𝓞 ℚ) | componentAt3 (𝓞 ℚ) ℚ v g ∉ localMaximalCompact3 (𝓞 ℚ) ℚ v}.Finite := by
  refine (Set.Finite.union
    (Set.finite_iUnion fun i : Fin 3 => Set.finite_iUnion fun j : Fin 3 =>
      finite_setOf_one_lt_valued_finAdeleEval ((g : Matrix (Fin 3) (Fin 3) (AdeleRing (𝓞 ℚ) ℚ)) i j))
    (Set.finite_iUnion fun i : Fin 3 => Set.finite_iUnion fun j : Fin 3 =>
      finite_setOf_one_lt_valued_finAdeleEval
        (((g⁻¹ : AdelicGL 3 (𝓞 ℚ) ℚ) : Matrix (Fin 3) (Fin 3) (AdeleRing (𝓞 ℚ) ℚ)) i j))).subset ?_
  intro v hv
  rw [Set.mem_setOf_eq, mem_localMaximalCompact3_iff, not_and_or] at hv
  rcases hv with hv | hv
  · left
    obtain ⟨i, j, hij⟩ := by simpa only [not_forall] using hv
    exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨j, hij⟩⟩
  · right
    rw [← map_inv] at hv
    obtain ⟨i, j, hij⟩ := by simpa only [not_forall] using hv
    exact Set.mem_iUnion.2 ⟨i, Set.mem_iUnion.2 ⟨j, hij⟩⟩

end

section

variable (v : HeightOneSpectrum (𝓞 ℚ))

private theorem isOpen_localMaximalCompact3 :
    IsOpen ((localMaximalCompact3 (𝓞 ℚ) ℚ v : Subgroup (LocalGL3 v)) : Set (LocalGL3 v)) := by
  have hball : IsOpen (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) :=
    Valued.isOpen_valuationSubring _
  have h1 : IsOpen {k : LocalGL3 v | ∀ i j, Valued.v ((k : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1} := by
    simp only [Set.setOf_forall]
    exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
      hball.preimage (Units.continuous_val.matrix_elem i j)
  have h2 : IsOpen {k : LocalGL3 v |
      ∀ i j, Valued.v (((k⁻¹ : LocalGL3 v) : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1} := by
    simp only [Set.setOf_forall]
    exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
      hball.preimage (Units.continuous_coe_inv.matrix_elem i j)
  exact h1.inter h2

end

