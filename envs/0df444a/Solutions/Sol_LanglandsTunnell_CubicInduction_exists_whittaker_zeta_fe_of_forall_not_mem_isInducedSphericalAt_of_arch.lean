p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField
open scoped BigOperators

open LocalFactorEmbedding

variable (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ)

private def adelicProduct (g : AdelicGL 3 (𝓞 ℚ) ℚ) : ℂ :=
  Warch (archComponent3 (𝓞 ℚ) ℚ g) * ∏ᶠ v, Wloc v (componentAt3 (𝓞 ℚ) ℚ v g)

private theorem exists_finset_integral (S : Finset (HeightOneSpectrum (𝓞 ℚ))) (v : HeightOneSpectrum (𝓞 ℚ))
    (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    ∃ T : Finset (HeightOneSpectrum (𝓞 ℚ)), S ⊆ T ∧ v ∈ T ∧
      ∀ w, w ∉ T → componentAt3 (𝓞 ℚ) ℚ w g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ w := by
  classical
  refine ⟨insert v (S ∪ (finite_setOf_not_mem_localMaximalCompact3 g).toFinset), ?_, Finset.mem_insert_self _ _,
    fun w hw => ?_⟩
  · exact Finset.subset_union_left.trans (Finset.subset_insert _ _)
  · by_contra hbad
    exact hw (Finset.mem_insert_of_mem (Finset.mem_union_right _
      ((finite_setOf_not_mem_localMaximalCompact3 g).mem_toFinset.2 hbad)))

variable {Wloc}
variable {S : Finset (HeightOneSpectrum (𝓞 ℚ))}
  (hone : ∀ v, v ∉ S → ∀ k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v, Wloc v k = 1)

include hone in

private theorem mulSupport_subset {g : AdelicGL 3 (𝓞 ℚ) ℚ} {T : Finset (HeightOneSpectrum (𝓞 ℚ))} (hST : S ⊆ T)
    (hg : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    (Function.mulSupport fun v => Wloc v (componentAt3 (𝓞 ℚ) ℚ v g)) ⊆ (T : Set (HeightOneSpectrum (𝓞 ℚ))) := by
  intro v hv
  by_contra hvT
  exact hv (hone v (fun hvS => hvT (hST hvS)) _ (hg v hvT))

include hone in

private theorem adelicProduct_eq_prod (g : AdelicGL 3 (𝓞 ℚ) ℚ) (T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hST : S ⊆ T)
    (hg : ∀ v, v ∉ T → componentAt3 (𝓞 ℚ) ℚ v g ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    adelicProduct Warch Wloc g =
      Warch (archComponent3 (𝓞 ℚ) ℚ g) * ∏ v ∈ T, Wloc v (componentAt3 (𝓞 ℚ) ℚ v g) := by
  unfold adelicProduct
  rw [finprod_eq_prod_of_mulSupport_subset _ (mulSupport_subset hone hST hg)]

include hone in

private theorem exists_forall_adelicProduct_mul_localToAdelic3_eq
    (v : HeightOneSpectrum (𝓞 ℚ)) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    ∃ c : ℂ, ∀ k : LocalGL3 v,
      adelicProduct Warch Wloc (g * localToAdelic3 v k) = c * Wloc v (componentAt3 (𝓞 ℚ) ℚ v g * k) := by
  classical
  obtain ⟨T, hST, hvT, hg⟩ := exists_finset_integral S v g
  refine ⟨Warch (archComponent3 (𝓞 ℚ) ℚ g) *
    ∏ w ∈ T.erase v, Wloc w (componentAt3 (𝓞 ℚ) ℚ w g), fun k => ?_⟩
  have hgk : ∀ w, w ∉ T → componentAt3 (𝓞 ℚ) ℚ w (g * localToAdelic3 v k) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ w := by
    intro w hw
    have hwv : w ≠ v := fun h => hw (h ▸ hvT)
    rw [componentAt3_mul_localToAdelic3_of_ne v hwv g k]
    exact hg w hw
  rw [adelicProduct_eq_prod Warch hone _ T hST hgk, ← Finset.mul_prod_erase T _ hvT]
  simp only [archComponent3_mul_localToAdelic3, componentAt3_mul_localToAdelic3_self]
  have hrest : ∏ w ∈ T.erase v, Wloc w (componentAt3 (𝓞 ℚ) ℚ w (g * localToAdelic3 v k)) =
      ∏ w ∈ T.erase v, Wloc w (componentAt3 (𝓞 ℚ) ℚ w g) :=
    Finset.prod_congr rfl fun w hw =>
      congrArg (Wloc w) (componentAt3_mul_localToAdelic3_of_ne v (Finset.ne_of_mem_erase hw) g k)
  simp only [hrest]
  ring

include hone in

private theorem exists_forall_adelicProduct_mul_localToAdelic3_eq_and
    (v : HeightOneSpectrum (𝓞 ℚ)) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    ∃ c : ℂ, adelicProduct Warch Wloc g = c * Wloc v (componentAt3 (𝓞 ℚ) ℚ v g) ∧ ∀ k : LocalGL3 v,
      adelicProduct Warch Wloc (g * localToAdelic3 v k) = c * Wloc v (componentAt3 (𝓞 ℚ) ℚ v g * k) := by
  obtain ⟨c, hc⟩ := exists_forall_adelicProduct_mul_localToAdelic3_eq Warch hone v g
  refine ⟨c, ?_, hc⟩
  simpa only [map_one, mul_one] using hc 1

include hone in

private theorem isRightInvariant_map {v : HeightOneSpectrum (𝓞 ℚ)} {U : Subgroup (LocalGL3 v)}
    (hU : IsRightInvariant U (Wloc v)) :
    IsRightInvariant (U.map (localToAdelic3 v)) (adelicProduct Warch Wloc) := by
  intro g u hu
  obtain ⟨k, hk, rfl⟩ := Subgroup.mem_map.1 hu
  obtain ⟨c, hg, hc⟩ := exists_forall_adelicProduct_mul_localToAdelic3_eq_and Warch hone v g
  simp only [hc k, hU _ k hk, hg]

include hone in

private theorem isCongruenceEquivariantAlong {v : HeightOneSpectrum (𝓞 ℚ)} {a : ℕ} {χ : (v.adicCompletion ℚ)ˣ →* ℂˣ}
    (h : IsCongruenceEquivariantAt v a χ (Wloc v)) :
    IsCongruenceEquivariantAlong v a χ (adelicProduct Warch Wloc) := by
  intro k hk u hu g
  obtain ⟨c, hg, hc⟩ := exists_forall_adelicProduct_mul_localToAdelic3_eq_and Warch hone v g
  simp only [hc k, h k hk u hu, hg]
  ring

include hone in

private theorem hasVanishingUnipotentIntegralAlong {v : HeightOneSpectrum (𝓞 ℚ)}
    (h : HasVanishingUnipotentIntegralAt v (Wloc v)) :
    HasVanishingUnipotentIntegralAlong v (adelicProduct Warch Wloc) := by
  intro g
  obtain ⟨c, -, hc⟩ := exists_forall_adelicProduct_mul_localToAdelic3_eq_and Warch hone v g
  simp only [hc]
  rw [MeasureTheory.integral_const_mul]
  exact mul_eq_zero_of_right c (h _)

end LanglandsTunnell.CubicInduction.LocalFactorProduct

