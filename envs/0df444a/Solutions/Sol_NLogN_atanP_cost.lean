theorem solution (x N K : ℕ) (σ : ℤ) (hx : 0 < x) (hσ : |σ| = 1) (s : NLogN.IState NLogN.HS)
    (L0 L1 : List NLogN.Item) (h0 : s.G 0 = .int N :: L0) (h1 : s.G 1 = .int K :: L1) :
    (NLogN.atanP x σ).cost s ≤ (K + 2) * 10 ^ 9 * (NLogN.atanB x N K + 2) ^ 2 := by
  set t0 := (NLogN.RS.seq NLogN.atanPre (NLogN.RS.asg 41 (.lit x))).run s with ht0
  have g40 : t0.G 40 = .int 0 :: s.G 40 := by
    simp (config := {decide := true}) [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.Ex.eval]
  have g41 : t0.G 41 = .int x :: s.G 41 := by
    simp (config := {decide := true}) [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.Ex.eval]
  have g42 : t0.G 42 = .int 0 :: s.G 42 := by
    simp (config := {decide := true}) [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.Ex.eval]
  have g43 : t0.G 43 = .int 1 :: s.G 43 := by
    simp (config := {decide := true}) [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.Ex.eval]
  have g44 : t0.G 44 = .int (2 ^ N) :: s.G 44 := by
    simp (config := {decide := true}) [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.Ex.eval, NLogN.IState.top, h0]
  have gj : ∀ j : Fin NLogN.HS, j ≠ 40 → j ≠ 41 → j ≠ 42 → j ≠ 43 → j ≠ 44 → t0.G j = s.G j := by
    intro j a b c d e
    simp [ht0, NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, a, b, c, d, e]
  have hK : (NLogN.Ex.reg (S := NLogN.HS) 1).eval t0 = K := by
    simp (config := {decide := true}) [NLogN.Ex.eval, NLogN.IState.top, gj 1 (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have hw : (45 : Fin NLogN.HS) ∉ (NLogN.atanBody x σ).writes := by simp [NLogN.atanBody, NLogN.RS.seqL, NLogN.RS.writes]
  have hinv := NLogN.RS.repSt_inv 45 (.reg 1) (NLogN.atanBody x σ) t0 (NLogN.atanInv' x N K σ s)
    (by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
        simp (config := {decide := true}) [g40, g41, g42, g43, g44, gj 45 (by decide) (by decide) (by decide) (by decide) (by decide), hK, NLogN.atanSum]
      intro j hj
      have : j ≠ 40 ∧ j ≠ 41 ∧ j ≠ 42 ∧ j ≠ 43 ∧ j ≠ 44 ∧ j ≠ 45 := by
        refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (rintro rfl; revert hj; decide)
      simp [this, gj j this.1 this.2.1 this.2.2.1 this.2.2.2.1 this.2.2.2.2.1])
    (fun k hk hI => (NLogN.atan_body x N K σ s _ k hI (by simpa [hK] using hk) hx).2)
  rw [hK] at hinv
  simp only [Int.toNat_natCast] at hinv
  obtain ⟨f40, f41, f42, f43, f44, f45, fj⟩ := hinv K le_rfl
  have hrun : (NLogN.RS.rep 45 (.reg 1) (NLogN.atanBody x σ)).run t0 =
      (NLogN.RS.repSt 45 (.reg 1) (NLogN.atanBody x σ) t0 K).upd 45 (s.G 45) := by
    rw [NLogN.RS.run_rep 45 _ _ t0 hw (by rw [hK]; positivity), hK, Int.toNat_natCast, gj 45 (by decide) (by decide) (by decide) (by decide) (by decide)]
  have hM := NLogN.atanM_lt x N K
  set B := NLogN.atanB x N K with hBdef
  set X := (B + 2) ^ 2 with hX
  have hX1 : 1 ≤ X := Nat.one_le_pow _ _ (by omega)
  have hNB : N + 1 ≤ B := by simp only [hBdef, NLogN.atanB]; nlinarith
  have hKB : K + 1 ≤ B := by simp only [hBdef, NLogN.atanB]; nlinarith
  have hxB : x + 1 ≤ B := by simp only [hBdef, NLogN.atanB]; nlinarith
  have zN : NLogN.zsz (N : ℤ) ≤ B := le_trans (NLogN.zsz_natCast_le_self' N) (by omega)
  have zK : NLogN.zsz (K : ℤ) ≤ B := le_trans (NLogN.zsz_natCast_le_self' K) (by omega)
  have zx : NLogN.zsz (x : ℤ) ≤ B := le_trans (NLogN.zsz_natCast_le_self' x) (by omega)
  have z2N : NLogN.zsz ((2 : ℤ) ^ N) ≤ B := by rw [NLogN.zsz_two_pow]; omega
  have zσ : NLogN.zsz (σ ^ K) ≤ B := by
    apply NLogN.zsz_le_of_abs_le (M := 1) (by rw [abs_pow, hσ, one_pow]; norm_num)
      (by have := Nat.one_lt_two_pow (n := B) (by omega); omega)
  have zS : NLogN.zsz (NLogN.atanSum x N σ K) ≤ B := by
    apply NLogN.zsz_le_of_abs_le _ hM
    refine le_trans (NLogN.atanSum_abs_le x N σ hσ K) ?_
    simp only [NLogN.atanM]; push_cast
    have : (1 : ℤ) ≤ (x : ℤ) ^ (2 * K + 3) := one_le_pow₀ (by exact_mod_cast hx)
    have : (K : ℤ) ≤ (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by nlinarith
    nlinarith [pow_pos (show (0 : ℤ) < 2 by norm_num) N]
  have zpw : NLogN.zsz ((x : ℤ) ^ (2 * K + 1)) ≤ B := by
    apply NLogN.zsz_le_of_abs_le _ hM
    rw [abs_of_nonneg (by positivity)]
    simp only [NLogN.atanM]; push_cast
    have : (x : ℤ) ^ (2 * K + 1) ≤ (x : ℤ) ^ (2 * K + 3) :=
      pow_le_pow_right₀ (by exact_mod_cast hx) (by omega)
    have : (1 : ℤ) ≤ 2 ^ N * (2 * K + 3) := by
      nlinarith [one_le_pow₀ (M₀ := ℤ) (a := 2) (n := N) (by norm_num)]
    nlinarith [pow_pos (show (0 : ℤ) < x by exact_mod_cast hx) (2 * K + 3)]
  have crep := NLogN.RS.rep_cost_le 45 (.reg 1) (NLogN.atanBody x σ) t0 B (30 * 10 ^ 7 * X)
    (by show NLogN.zsz ((NLogN.Ex.reg 1).eval t0) ≤ B; rw [hK]; exact zK)
    (fun k hk => by
      rw [hK, Int.toNat_natCast] at hk
      exact NLogN.atan_body_cost x N K σ hσ s _ k (hinv k hk.le) hk hx)
  rw [hK, Int.toNat_natCast] at crep
  have e : (NLogN.atanP x σ).cost s = (NLogN.atanPre.cost s + (NLogN.RS.asg 41 (.lit x)).cost (NLogN.atanPre.run s)) +
      ((NLogN.RS.rep 45 (.reg 1) (NLogN.atanBody x σ)).cost t0 +
        NLogN.atanPost.cost ((NLogN.RS.rep 45 (.reg 1) (NLogN.atanBody x σ)).run t0)) := rfl
  have cpre : NLogN.atanPre.cost s ≤ 10 * 10 ^ 7 * X := by
    simp only [NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.cost, NLogN.RS.run_seq]
    have hp := NLogN.RS.pushCost_le (.pow2 (.reg 0)) ((NLogN.RS.push 43 (.lit 1)).run ((NLogN.RS.push 42 (.lit 0)).run
      ((NLogN.RS.push 41 (.lit 0)).run ((NLogN.RS.push 40 (.lit 0)).run s)))) B
      (by
        simp (config := {decide := true}) only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top, NLogN.RS.run_push_G, h0,
          if_false, Int.toNat_natCast]
        exact ⟨zN, by omega⟩)
    simp only [NLogN.Ex.size, ← hX] at hp
    have hl : ∀ (t : NLogN.IState NLogN.HS) (c : ℤ), NLogN.Ex.cost t (NLogN.Ex.lit c) = NLogN.zsz c + 2 := fun _ _ => rfl
    have hle : ∀ (t : NLogN.IState NLogN.HS) (c : ℤ), NLogN.Ex.eval t (NLogN.Ex.lit c) = c := fun _ _ => rfl
    simp only [hl, hle, NLogN.zsz_zero, NLogN.zsz_one]
    simp only [NLogN.moveCost] at hp ⊢
    omega
  have ca : (NLogN.RS.asg 41 (.lit x)).cost (NLogN.atanPre.run s) ≤ 2 * 10 ^ 7 * X := by
    have := NLogN.RS.asgCost_le 41 (.lit x) (NLogN.atanPre.run s) B zx
      (by simp (config := {decide := true}) [NLogN.atanPre, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.IState.top, NLogN.Ex.eval, NLogN.zsz_zero])
    simp only [NLogN.Ex.size, ← hX] at this
    simpa [NLogN.RS.cost] using this
  have cpost : NLogN.atanPost.cost ((NLogN.RS.rep 45 (.reg 1) (NLogN.atanBody x σ)).run t0) ≤ 10 ^ 8 * X := by
    rw [hrun]
    simp (config := {decide := true}) only [NLogN.atanPost, NLogN.RS.seqL, NLogN.RS.cost, NLogN.RS.run_seq, NLogN.RS.run_push_G,
      NLogN.RS.run_pop_G, NLogN.IState.upd_G, NLogN.IState.top, f40, f41, f42, f43, f44, if_true, if_false,
      List.tail_cons, NLogN.Ex.cost, NLogN.Ex.eval]
    simp only [NLogN.dupCost, NLogN.zipCost, NLogN.moveCost] 
    have zk : NLogN.zsz (K : ℤ) ≤ B := zK
    nlinarith
  rw [e]
  simp only [NLogN.Ex.size, ← hX] at crep
  nlinarith
end
