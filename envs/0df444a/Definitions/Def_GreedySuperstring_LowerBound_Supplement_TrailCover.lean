-- title:
--   Finite directed multigraphs, trails, trail covers, $\pi(H)$, and weak components
-- statement:
--   A **finite directed multigraph** $H$ is a finite set of edges, each with a tail and a head vertex; parallel edges and loops are allowed. A **trail** is a walk without repeated edges with $m\ge1$ edges: a nonempty sequence of distinct edges in which every edge starts where its predecessor ends. A **trail cover** of $H$ is a family of edge-disjoint trails containing all edges of $H$, and
--
--   $$\pi(H)=\min\{|\mathcal T| : \mathcal T\text{ a trail cover of }H\},$$
--
--   with $\pi$ of the edgeless graph equal to $0$. The **weak components** of $H$ are the connected components of the undirected multigraph obtained by ignoring edge directions.
--
--   These general notions of §5.1 are used for the graphs $G_2$ and $G_1$ in the analysis of greedy on strings of length three (Lemmas 5.4–5.7).
--
--   **Formalization Note** The vertices are the endpoints of edges. A weak component is the class of a vertex under the equivalence relation generated by undirected adjacency. The one-edge trails always form a cover, so $\pi$ is a genuine minimum.
-- source:
--   Nikolai Chukhin, Rishikesh Gajjala, Juha Harviainen, Alexander S. Kulikov, Ivan Mihajlin, Hiroki Shibata, Alexander V. Smal, The Greedy Superstring Conjecture Is False, STOC 2027 submission #316 (October 2026), https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/316.pdf, SHA-256 84e171350ae4e20ed6899c32b480753dae49f7b418819656dfedbcac0f60e8fa, §5.1, printed p.25 = PDF p.25

import Mathlib

universe tc_u tc_v

namespace GreedySuperstring.LowerBound.Supplement

/-- A finite directed multigraph (§5.1, p.25): a finite set of edge labels with a tail and a
head map. Parallel edges and loops are allowed; the vertices are the endpoints of edges. -/
structure Multigraph (V : Type tc_u) (E : Type tc_v) where
  edges : Finset E
  tail : E → V
  head : E → V

namespace Multigraph

variable {V : Type tc_u} {E : Type tc_v}

/-- The vertices of `G`: all tails and heads of its edges. -/
def vertices [DecidableEq V] (G : Multigraph V E) : Finset V :=
  G.edges.image G.tail ∪ G.edges.image G.head

/-- §5.1, p.25: a trail is a walk without repeated edges, with `m ≥ 1` edges: a nonempty
list of distinct edges of `G` in which each edge starts at the head of its predecessor. -/
def IsTrail (G : Multigraph V E) (P : List E) : Prop :=
  P ≠ [] ∧ P.Nodup ∧ (∀ e ∈ P, e ∈ G.edges) ∧
    P.IsChain (fun e f => G.head e = G.tail f)

/-- §5.1, p.25: a trail cover of `G` is a family of edge-disjoint trails containing all
edges of `G`. Its size is the number of trails. -/
def IsTrailCover (G : Multigraph V E) (L : List (List E)) : Prop :=
  (∀ P ∈ L, G.IsTrail P) ∧ L.flatten.Nodup ∧ ∀ e ∈ G.edges, e ∈ L.flatten

/-- `π(G)` (§5.1, p.25): the minimum size of a trail cover of `G`. The one-edge trails form a
cover, so the set is nonempty; the empty graph has `π = 0`. -/
noncomputable def trailCoverNumber (G : Multigraph V E) : ℕ :=
  sInf {k : ℕ | ∃ L : List (List E), G.IsTrailCover L ∧ L.length = k}

/-- Undirected adjacency: some edge joins `u` and `v` in either direction. -/
def UAdj (G : Multigraph V E) (u v : V) : Prop :=
  ∃ e ∈ G.edges, (G.tail e = u ∧ G.head e = v) ∨ (G.tail e = v ∧ G.head e = u)

/-- The weak component of a vertex: its class under the equivalence relation generated by
undirected adjacency (§5.1, p.25: connected components after ignoring directions). -/
def weakComponent (G : Multigraph V E) (v : V) : Quot G.UAdj :=
  Quot.mk _ v

/-- The finite set of weak components of `G` (components of its vertices). -/
noncomputable def weakComponents [DecidableEq V] (G : Multigraph V E) : Finset (Quot G.UAdj) := by
  classical
  exact G.vertices.image G.weakComponent

end Multigraph

end GreedySuperstring.LowerBound.Supplement


