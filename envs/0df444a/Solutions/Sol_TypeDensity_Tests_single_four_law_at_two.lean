private theorem coeff_nil (q : ℚ) (σ : FactorType) : (Expr.eval q (lawCoeff [] σ)) = 0 := rfl

private theorem coeff_cons (q : ℚ) (z : FactorType × Expr) (L : Law) (σ : FactorType) :
