-- title:
--   p. 1 — G(A) consists exactly of the elements of G that are piecewise in PSL₂(A) with breakpoints in P_A
-- statement:
--   For every subring $A$ of $\mathbf{R}$, a homeomorphism $f$ of $\mathbf{P}^1$ lies in $G(A)$ if and only if $f$ lies in $G$ (`Gpp`) and is piecewise in $\mathrm{PSL}_2(A)$ with breakpoints in $P_A$.
--
--   **Formalization Note.** $G(A)$ is defined as the subgroup of $G$ generated by these elements, reading the source's "the subgroup of $G$ given by all elements that are …" as "all elements of $G$ that are …". The statement says the generated group contains nothing else: those elements already form a subgroup, which the source takes for granted by calling $G(A)$ "the subgroup".
-- source:
--   Monod, N., Groups of piecewise projective homeomorphisms, Proc. Natl. Acad. Sci. USA 110 (2013) 4524–4527, https://doi.org/10.1073/pnas.1218426110 (arXiv:1209.5229v2, whose page numbers are used), p. 1, the construction

import Mathlib
import Definitions.Def_Monod_PiecewiseProjective

namespace Monod

theorem mem_G_iff_isPiecewiseProj (A : Subring ℝ) (f : OnePoint ℝ ≃ₜ OnePoint ℝ) :
    f ∈ G A ↔ f ∈ Gpp ∧ IsPiecewiseProj A f := by
  sorry

end Monod
