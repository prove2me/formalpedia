/-- **The equivalence at the trivial modulus carries a ray class to the class of the same
fractional ideal.** -/
 theorem solution (I : _root_.TauCeti.GlobalNumberFields.idealsPrimeTo (_root_.TauCeti.GlobalNumberFields.Modulus.one K)) :
    _root_.TauCeti.GlobalNumberFields.oneEquivClassGroup (_root_.TauCeti.GlobalNumberFields.rayClassMk (_root_.TauCeti.GlobalNumberFields.Modulus.one K) I) =
      _root_.ClassGroup.mk K (I : (_root_.FractionalIdeal (𝓞 K)⁰ K)ˣ) := by
  have htrans : _root_.TauCeti.GlobalNumberFields.oneEquivClassGroup (_root_.TauCeti.GlobalNumberFields.rayClassMk (_root_.TauCeti.GlobalNumberFields.Modulus.one K) I) =
      (_root_.ClassGroup.equiv (K := K)).symm
        (_root_.QuotientGroup.congr (_root_.TauCeti.GlobalNumberFields.ray (_root_.TauCeti.GlobalNumberFields.Modulus.one K)) (_root_.toPrincipalIdeal (𝓞 K) K).range
          (_root_.TauCeti.GlobalNumberFields.idealsPrimeToEquiv _root_.TauCeti.GlobalNumberFields.Modulus.support_one) _root_.TauCeti.GlobalNumberFields.map_ray_one
          (_root_.QuotientGroup.mk' (_root_.TauCeti.GlobalNumberFields.ray (_root_.TauCeti.GlobalNumberFields.Modulus.one K)) I)) :=
    _root_.MulEquiv.trans_apply _ _ _
  have hmap : _root_.Units.mapEquiv (_root_.MulEquiv.refl (_root_.FractionalIdeal (𝓞 K)⁰ K))
      (I : (_root_.FractionalIdeal (𝓞 K)⁰ K)ˣ) = (I : (_root_.FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
    _root_.Units.ext (by rw [_root_.Units.coe_mapEquiv, _root_.MulEquiv.refl_apply])
  rw [htrans, _root_.QuotientGroup.congr_mk', _root_.TauCeti.GlobalNumberFields.idealsPrimeToEquiv_apply, _root_.MulEquiv.symm_apply_eq,
    _root_.ClassGroup.equiv_mk]
  simp only [_root_.QuotientGroup.mk'_apply, _root_.FractionalIdeal.canonicalEquiv_self,
    _root_.RingEquiv.coe_mulEquiv_refl, hmap]

