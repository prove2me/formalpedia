          (∃ B : Subring ↥(fieldBar q M'),
            (∀ f : ↥(fieldBar q M'), f ∈ B → f ∈ R.integers) ∧
            (∀ Q : Place (ResidueField ↥A) FSS, Q ∉ N → ∀ (n : ι) (f : ↥(fieldBar q M')), f ∈ B → f ∈ Sn Q n) ∧
