  have c2 := ax.sl.ok sb x (t.G ax.sl.I) sbC ⟨hx, hxB⟩ sbI
  have c3 := ax.sl.cost sb x (t.G ax.sl.I) sbC ⟨hx, hxB⟩ sbI
