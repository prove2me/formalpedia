/-! ### piece EtPi1Geo_Gen (lib module EtPi1Geo_Gen) -/
section Piece_EtPi1Geo_Gen


/-!
# S4-EtPi1Geo, G2 (Gen): one constant generates finitely many constants; inertia through a polynomial

* `exists_isConst_gen`: finitely many constants `x` (`IsConst p x`) of a field of characteristic `p` are `0` or
  powers of ONE constant `ζ` (the constants of a common level form a finite field, whose unit group is cyclic).
* `exists_const_of_finset`: if `FK` is generated over `F` by its constants, finitely many elements of `FK` lie in
  `F⟮ζ⟯` for one constant `ζ`.
* `eval_mem_of_coeff_mem`, `sub_mem_of_eval_map`: `τ x - x ∈ Q` for `x = f(ζ)`, `τ ζ = ζ`, `f` over a subring on
  which `τ` acts through an inertia element.
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh

noncomputable section

section Gen

theorem pow_pow_mul_eq_self {L : Type} [Monoid L] {x : L} {q n : ℕ} (h : x ^ q ^ n = x) (k : ℕ) :
    x ^ q ^ (n * k) = x := by
  induction k with
  | zero => simp
  | succ k ih => rw [Nat.mul_succ, pow_add, pow_mul, ih, h]

variable {Ω : Type} [Field Ω] (p : ℕ) [hp : Fact p.Prime] [CharP Ω p]

/-- Finitely many constants are `0` or powers of one constant. -/
theorem exists_isConst_gen (s : Finset Ω) (hs : ∀ x ∈ s, IsConst p x) :
    ∃ ζ : Ω, IsConst p ζ ∧ ∀ x ∈ s, x = 0 ∨ ∃ k : ℕ, ζ ^ k = x := by
  classical
  let n : Ω → ℕ := fun x => if h : IsConst p x then h.choose else 1
  have hn : ∀ x, 0 < n x := fun x => by
    by_cases h : IsConst p x
    · simp only [n, dif_pos h]; exact h.choose_spec.1
    · simp only [n, dif_neg h]; exact Nat.one_pos
  set N := ∏ x ∈ s, n x with hN
  have hN0 : 0 < N := Finset.prod_pos fun x _ => hn x
  have hxN : ∀ x ∈ s, x ^ p ^ N = x := fun x hx => by
    have h := hs x hx
    have h1 : x ^ p ^ n x = x := by simp only [n, dif_pos h]; exact h.choose_spec.2
    obtain ⟨m, hm⟩ : n x ∣ N := Finset.dvd_prod_of_mem n hx
    rw [hm]
    exact pow_pow_mul_eq_self h1 m
  let S : Subfield Ω := (iterateFrobenius Ω p N).eqLocusField (RingHom.id Ω)
  have hmemS : ∀ y : Ω, y ∈ S ↔ y ^ p ^ N = y := fun y => by
    show iterateFrobenius Ω p N y = y ↔ _
    rw [iterateFrobenius_def]
  have h1 : 1 < p ^ N := Nat.one_lt_pow hN0.ne' hp.out.one_lt
  have hpoly : (X ^ p ^ N - X : Polynomial Ω) ≠ 0 :=
    (monic_X_pow_sub (lt_of_le_of_lt degree_X_le (by exact_mod_cast h1))).ne_zero
  have hfin : (S : Set Ω).Finite := by
    refine Set.Finite.subset (Polynomial.rootSet_finite (X ^ p ^ N - X : Polynomial Ω) Ω) fun y hy => ?_
    rw [Polynomial.mem_rootSet]
    refine ⟨hpoly, ?_⟩
    rw [map_sub, map_pow, aeval_X, (hmemS y).1 hy, sub_self]
  have : Finite S := hfin.to_subtype
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := Sˣ)
  refine ⟨((g : S) : Ω), ⟨N, hN0, (hmemS _).1 (g : S).2⟩, fun x hx => ?_⟩
  by_cases hx0 : x = 0
  · exact Or.inl hx0
  right
  have hxS : x ∈ S := (hmemS x).2 (hxN x hx)
  let u : Sˣ := Units.mk0 ⟨x, hxS⟩ (fun h => hx0 (congrArg Subtype.val h))
  obtain ⟨k, hk⟩ := (mem_powers_iff_mem_zpowers).2 (hg u)
  refine ⟨k, ?_⟩
  have := congrArg (fun v : Sˣ => ((v : S) : Ω)) hk
  simpa [u] using this

variable {F FK : Type} [Field F] [Field FK] [Algebra F FK] [CharP FK p]

/-- If `FK` is generated over `F` by constants, finitely many elements lie in `F⟮ζ⟯` for one constant `ζ`. -/
theorem exists_const_of_finset (hgen : ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x}) (T : Finset FK) :
    ∃ ζ : FK, IsConst p ζ ∧ ∀ c ∈ T, c ∈ F⟮ζ⟯ := by
  classical
  have key : ∀ c : FK, ∃ Tc : Finset FK, (Tc : Set FK) ⊆ {x : FK | IsConst p x} ∧ c ∈ adjoin F (Tc : Set FK) :=
    fun c => exists_finset_of_mem_adjoin (hgen c)
  choose Tc hTc1 hTc2 using key
  obtain ⟨ζ, hζ, hgenζ⟩ := exists_isConst_gen p (T.biUnion Tc) fun x hx => by
    obtain ⟨c, _, hxc⟩ := Finset.mem_biUnion.1 hx
    exact hTc1 c hxc
  refine ⟨ζ, hζ, fun c hc => ?_⟩
  refine (adjoin_le_iff.2 fun y hy => ?_) (hTc2 c)
  rcases hgenζ y (Finset.mem_biUnion.2 ⟨c, hc, hy⟩) with h0 | ⟨k, hk⟩
  · rw [h0]; exact zero_mem _
  · rw [← hk]; exact pow_mem (mem_adjoin_simple_self F ζ) k

end Gen

section Eval

variable {B B' : Type} [CommRing B] [CommRing B']

theorem eval_mem_of_coeff_mem (I : Ideal B) (g : B[X]) (h : ∀ n, g.coeff n ∈ I) (z : B) : g.eval z ∈ I := by
  rw [eval_eq_sum, sum_def]
  exact I.sum_mem fun n _ => I.mul_mem_right _ (h n)

/-- `τ (f(z)) - f(z) ∈ Q` when `τ` fixes `z` and acts on the coefficients (through `ι'`) by an inertia element. -/
theorem sub_mem_of_eval_map (ι' : B' →+* B) (τ : B →+* B) (s : B' →+* B') (hcomm : ∀ b, τ (ι' b) = ι' (s b))
    (Q : Ideal B) (hs : ∀ b, ι' (s b - b) ∈ Q) (f : B'[X]) (z : B) (hz : τ z = z) :
    τ ((f.map ι').eval z) - (f.map ι').eval z ∈ Q := by
  have h1 : τ.comp ι' = ι'.comp s := RingHom.ext hcomm
  rw [eval_map, hom_eval₂, h1, hz, ← eval₂_map, ← eval₂_sub, ← eval_map]
  refine eval_mem_of_coeff_mem Q _ (fun n => ?_) z
  rw [coeff_map, coeff_sub, coeff_map]
  exact hs _

end Eval

end

end EtPi1Geo
end RamanujanPetersson

end Piece_EtPi1Geo_Gen

/-! ### piece EtPi1Geo_Disc (lib module EtPi1Geo_Disc) -/
section Piece_EtPi1Geo_Disc


/-!
# S4-EtPi1Geo, G1 (Disc): adjoining a constant does not enlarge integral closures

`ζ` with `ζ ^ p ^ n = ζ` (a "constant") over a field `L'` of characteristic `p`, `R ⊆ L'` integrally closed with
fraction field `L'`: every `x ∈ L'⟮ζ⟯` integral over `R` lies in `R[ζ]` (**`mem_adjoin_of_pow_eq_self`**).
The discriminant of the power basis of `ζ` is a nonzero constant (`discr_pow_eq_self`), hence a unit of `R`, and
`Algebra.discr_mul_isIntegral_mem_adjoin` applies.
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField

noncomputable section

section Disc

variable {L' Ω : Type} [Field L'] [Field Ω] [Algebra L' Ω] (p : ℕ) [hp : Fact p.Prime] [CharP L' p]

theorem isIntegral_of_pow_eq_self {R S : Type} [CommRing R] [CommRing S] [Algebra R S] {n : ℕ} (hn : 0 < n)
    {ζ : S} (hζ : ζ ^ p ^ n = ζ) : IsIntegral R ζ := by
  have h1 : 1 < p ^ n := Nat.one_lt_pow hn.ne' hp.out.one_lt
  refine ⟨X ^ p ^ n - X, monic_X_pow_sub (lt_of_le_of_lt degree_X_le (by exact_mod_cast h1)), ?_⟩
  rw [eval₂_sub, eval₂_X_pow, eval₂_X, hζ, sub_self]

theorem discr_pow_eq_self {ζ : Ω} {n : ℕ} (hζ : ζ ^ p ^ n = ζ) (hi : IsIntegral L' ζ)
    [Algebra.IsSeparable L' L'⟮ζ⟯] :
    Algebra.discr L' (adjoin.powerBasis hi).basis ^ p ^ n = Algebra.discr L' (adjoin.powerBasis hi).basis := by
  set pb := adjoin.powerBasis hi
  have : CharP (AlgebraicClosure L') p := charP_of_injective_algebraMap (algebraMap L' _).injective p
  have : FiniteDimensional L' L'⟮ζ⟯ := adjoin.finiteDimensional hi
  have hc : Fintype.card (L'⟮ζ⟯ →ₐ[L'] AlgebraicClosure L') = pb.dim := by
    rw [AlgHom.card, pb.finrank]
  let e : Fin pb.dim ≃ (L'⟮ζ⟯ →ₐ[L'] AlgebraicClosure L') := (Fintype.equivFinOfCardEq hc).symm
  have hd := Algebra.discr_powerBasis_eq_prod L' (AlgebraicClosure L') pb e
  have hg : pb.gen ^ p ^ n = pb.gen := by
    apply Subtype.ext
    rw [adjoin.powerBasis_gen]
    simpa using hζ
  have hfix : ∀ i, iterateFrobenius (AlgebraicClosure L') p n (e i pb.gen) = e i pb.gen := fun i => by
    rw [iterateFrobenius_def, ← map_pow, hg]
  apply (algebraMap L' (AlgebraicClosure L')).injective
  rw [map_pow, ← iterateFrobenius_def (R := AlgebraicClosure L') p n, hd, map_prod]
  refine Finset.prod_congr rfl fun i _ => ?_
  rw [map_prod]
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [map_pow, map_sub, hfix, hfix]

variable {R : Type} [CommRing R] [Algebra R L'] [Algebra R Ω] [IsScalarTower R L' Ω]
  [IsIntegrallyClosed R] [IsFractionRing R L']

/-- **Adjoining a constant**: an element of `L'⟮ζ⟯` integral over `R` lies in `R[ζ]`. -/
theorem mem_adjoin_of_pow_eq_self {ζ : Ω} {n : ℕ} (hn : 0 < n) (hζ : ζ ^ p ^ n = ζ) {x : Ω} (hx : x ∈ L'⟮ζ⟯)
    (hxi : IsIntegral R x) : x ∈ Algebra.adjoin R {ζ} := by
  have hi : IsIntegral L' ζ := isIntegral_of_pow_eq_self p hn hζ
  have : CharP Ω p := charP_of_injective_algebraMap (algebraMap L' Ω).injective p
  have hsep : IsSeparable L' ζ := by
    have h1 : 1 < p ^ n := Nat.one_lt_pow hn.ne' hp.out.one_lt
    refine Polynomial.Separable.of_dvd (galois_poly_separable p (p ^ n) (dvd_pow_self p hn.ne')) ?_
    exact minpoly.dvd L' ζ (by rw [map_sub, map_pow, aeval_X, hζ, sub_self])
  have : Algebra.IsSeparable L' L'⟮ζ⟯ := (isSeparable_adjoin_simple_iff_isSeparable L' Ω).2 hsep
  have : FiniteDimensional L' L'⟮ζ⟯ := adjoin.finiteDimensional hi
  set pb := adjoin.powerBasis hi with hpb
  set d := Algebra.discr L' pb.basis
  have hgen : pb.gen = AdjoinSimple.gen L' ζ := adjoin.powerBasis_gen hi
  let f : L'⟮ζ⟯ →ₐ[R] Ω := (L'⟮ζ⟯).val.restrictScalars R
  have hf : Function.Injective f := (L'⟮ζ⟯).val.toRingHom.injective
  have hgi : IsIntegral R pb.gen := by
    rw [← isIntegral_algHom_iff f hf, hgen]
    exact isIntegral_of_pow_eq_self p hn hζ
  have hzi : IsIntegral R (⟨x, hx⟩ : L'⟮ζ⟯) := by
    rw [← isIntegral_algHom_iff f hf]
    exact hxi
  have hmem := Algebra.discr_mul_isIntegral_mem_adjoin L' (B := pb) hgi hzi
  -- `d` is a unit of `R`
  have hd0 : d ≠ 0 := Algebra.discr_not_zero_of_basis L' pb.basis
  have hdi : IsIntegral R d := Algebra.discr_isIntegral L' fun i => by
    rw [PowerBasis.coe_basis]
    exact hgi.pow _
  obtain ⟨r, hr⟩ := IsIntegrallyClosed.isIntegral_iff.1 hdi
  have hdp : d ^ p ^ n = d := discr_pow_eq_self p hζ hi
  have h2 : 2 ≤ p ^ n := (Nat.one_lt_pow hn.ne' hp.out.one_lt)
  have hinv : algebraMap R L' (r ^ (p ^ n - 2)) * d = 1 := by
    rw [map_pow, hr, ← pow_succ]
    have : p ^ n - 2 + 1 = p ^ n - 1 := by omega
    rw [this]
    have h3 : d ^ (p ^ n - 1) * d = d * 1 := by
      rw [← pow_succ, Nat.sub_add_cancel (by omega), hdp, mul_one]
    exact mul_right_cancel₀ hd0 (by rw [h3, mul_comm, one_mul])
  have hx' : (⟨x, hx⟩ : L'⟮ζ⟯) ∈ Algebra.adjoin R {pb.gen} := by
    have := Subalgebra.smul_mem _ hmem (r ^ (p ^ n - 2))
    rwa [← algebraMap_smul L', smul_smul, hinv, one_smul] at this
  have hmap : x ∈ (Algebra.adjoin R {pb.gen}).map f := Subalgebra.mem_map.2 ⟨_, hx', rfl⟩
  rw [AlgHom.map_adjoin, Set.image_singleton, hgen] at hmap
  exact hmap

end Disc

end

end EtPi1Geo
end RamanujanPetersson

end Piece_EtPi1Geo_Disc

/-! ### piece EtPi1Geo_DescH (lib module EtPi1Geo_DescH) -/
section Piece_EtPi1Geo_DescH


/-!
# S4-EtPi1Geo, G3a (DescH): helpers for the descent of unramified extensions

`F = Frac A'` of characteristic `p`, `FK ⊇ F` generated by constants, `FK` acting on `F̄ = AlgebraicClosure F`.
**`mem_maxUnram_of_unrIn_const`**: every finite Galois `L/FK` inside `F̄`, unramified over `A'`, lies in
`maxUnram A' F`. (Primitive element `α`; finitely many coefficients in `F⟮ζ⟯`, `ζ` constant; `L' = E⟮α⟯` over
`E = F⟮ζ⟯` is Galois; an inertia element `σ` of `L'/E` extends to `τ ∈ Gal(L/FK)`, which is inertial because
adjoining a constant does not enlarge integral closures (G1); so `τ = 1`, `σ = 1`.)
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh GalCover Lefschetz

noncomputable section

section Helpers

variable {K W : Type} [Field K] [Field W] [Algebra K W]

theorem exists_eq_adjoin_simple (L : IntermediateField K W) [FiniteDimensional K L] [Algebra.IsSeparable K L] :
    ∃ α : W, L = K⟮α⟯ := by
  obtain ⟨α₀, h⟩ := Field.exists_primitive_element K L
  refine ⟨(α₀ : W), ?_⟩
  have h1 : (K⟮α₀⟯).map L.val = K⟮L.val α₀⟯ := by rw [adjoin_map, Set.image_singleton]
  rw [h, ← AlgHom.fieldRange_eq_map, fieldRange_val] at h1
  exact h1

theorem exists_aeval_eq {α : W} (hα : IsIntegral K α) {y : W} (hy : y ∈ K⟮α⟯) : ∃ h : K[X], aeval α h = y := by
  rw [← mem_toSubalgebra, adjoin_simple_toSubalgebra_of_isAlgebraic hα.isAlgebraic,
    Algebra.adjoin_singleton_eq_range_aeval] at hy
  exact (AlgHom.mem_range _).1 hy

theorem aeval_mem_of_coeffs {σ : Type} [SetLike σ W] [SubsemiringClass σ W] (S : σ) {α : W} (hα : α ∈ S)
    (h : K[X]) (hc : ∀ c ∈ h.coeffs, algebraMap K W c ∈ S) : aeval α h ∈ S := by
  rw [aeval_eq_sum_range]
  refine sum_mem fun i _ => ?_
  rw [Algebra.smul_def]
  by_cases hi : h.coeff i = 0
  · rw [hi, map_zero, zero_mul]; exact zero_mem S
  · exact mul_mem (hc _ (coeff_mem_coeffs hi)) (pow_mem hα i)

theorem exists_map_eq {F' : Type} [Field F'] [Algebra F' W] (E : IntermediateField F' W) (h : K[X])
    (hc : ∀ c ∈ h.coeffs, algebraMap K W c ∈ E) :
    ∃ h' : Polynomial E, h'.map (algebraMap E W) = h.map (algebraMap K W) := by
  have hl : h.map (algebraMap K W) ∈ lifts (algebraMap E W) := by
    refine (lifts_iff_coeff_lifts _).2 fun n => ?_
    rw [coeff_map]
    by_cases hn : h.coeff n = 0
    · rw [hn, map_zero]; exact ⟨0, map_zero _⟩
    · exact ⟨⟨_, hc _ (coeff_mem_coeffs hn)⟩, rfl⟩
  exact (mem_lifts _).1 hl

theorem algebraMap_mem_adjoin {F' : Type} [Field F'] [Algebra F' K] [Algebra F' W] [IsScalarTower F' K W]
    {ζ c : K} (hc : c ∈ F'⟮ζ⟯) : algebraMap K W c ∈ F'⟮algebraMap K W ζ⟯ := by
  have h1 : (F'⟮ζ⟯).map (IsScalarTower.toAlgHom F' K W) = F'⟮algebraMap K W ζ⟯ := by
    rw [adjoin_map, Set.image_singleton]; rfl
  rw [← h1]
  exact ⟨c, hc, rfl⟩

theorem isIntegral_coe_iff {R : Type} [CommRing R] [Algebra R K] [Algebra R W] [IsScalarTower R K W]
    (S : IntermediateField K W) (x : S) : IsIntegral R x ↔ IsIntegral R (x : W) :=
  (isIntegral_algHom_iff (S.val.restrictScalars R) S.val.toRingHom.injective).symm

end Helpers

end

end EtPi1Geo
end RamanujanPetersson

end Piece_EtPi1Geo_DescH

/-! ### piece EtPi1Geo_InstF (lib module EtPi1Geo_InstF) -/
section Piece_EtPi1Geo_InstF


/-!
# S4-EtPi1Geo, G5 (InstF): the hypotheses of `cmp` from an algebraically closed field of constants

For `k` algebraic over a finite field (so every `c : k` is a constant, `isConst_of_isIntegral`) and
`FK = F(k)` (`hFK`): `hgen_of` (`FK` generated by constants), `isAlgebraic_of`; for `k` algebraically closed
`hcl_of_isAlgClosed` (every constant of `F̄K` lies in `FK`); `isIntegral_polyMap` (`R[X] → k[X]` integral).
-/

set_option autoImplicit false

namespace RamanujanPetersson
namespace EtPi1Geo

open Polynomial IntermediateField CurveCoh

noncomputable section

section InstF

variable (p : ℕ) [Fact p.Prime]

omit [Fact p.Prime] in
/-- An element integral over a finite field is a constant. -/
theorem isConst_of_isIntegral {Fq L : Type} [Field Fq] [Finite Fq] [Field L] [CharP L p] [Algebra Fq L]
    {c : L} (hc : IsIntegral Fq c) : IsConst p c := by
  haveI := adjoin.finiteDimensional hc
  haveI : Finite Fq⟮c⟯ := Module.finite_of_finite Fq
  letI : Fintype Fq⟮c⟯ := Fintype.ofFinite _
  haveI : CharP Fq⟮c⟯ p := (RingHom.charP_iff_charP (algebraMap Fq⟮c⟯ L) p).2 inferInstance
  obtain ⟨n, -, hn⟩ := FiniteField.card Fq⟮c⟯ p
  refine ⟨n, n.pos, ?_⟩
  have h := FiniteField.pow_card (⟨c, mem_adjoin_simple_self Fq c⟩ : Fq⟮c⟯)
  rw [hn] at h
  simpa using congrArg (fun x : Fq⟮c⟯ => (x : L)) h

/-- A constant of a field `M` with an algebraically closed `k → M` lies in the image of `k`. -/
theorem exists_algebraMap_eq_of_isConst (k M : Type) [Field k] [Field M] [Algebra k M] [IsAlgClosed k]
    (x : M) (hx : IsConst p x) : ∃ a : k, algebraMap k M a = x := by
  obtain ⟨n, hn, hxn⟩ := hx
  have hint : IsIntegral k x := isIntegral_of_pow_eq_self p hn hxn
  exact minpoly.mem_range_of_degree_eq_one k x
    (IsAlgClosed.degree_eq_one_of_irreducible k (minpoly.irreducible hint))

/-- Constants of `F̄K` come from an algebraically closed field `k → FK`. -/
theorem hcl_of_isAlgClosed (FK k : Type) [Field FK] [Field k] [Algebra k FK] [IsAlgClosed k]
    (x : AlgebraicClosure FK) (hx : IsConst p x) : ∃ c : FK, algebraMap FK _ c = x := by
  obtain ⟨a, ha⟩ := exists_algebraMap_eq_of_isConst p k (AlgebraicClosure FK) x hx
  exact ⟨algebraMap k FK a, by rw [← IsScalarTower.algebraMap_apply]; exact ha⟩

variable (F FK k : Type) [Field F] [Field FK] [Field k] [Algebra F FK] [Algebra k FK]

omit [Fact p.Prime] in
/-- `FK = F(k)` with `k` constants: `FK` is generated over `F` by constants. -/
theorem hgen_of (hk : ∀ c : k, IsConst p c) (hFK : ∀ y : FK, y ∈ adjoin F (Set.range (algebraMap k FK))) :
    ∀ c : FK, c ∈ adjoin F {x : FK | IsConst p x} := fun c =>
  adjoin.mono F _ _ (by rintro _ ⟨a, rfl⟩; exact (hk a).map (algebraMap k FK)) (hFK c)

theorem isAlgebraic_of (hk : ∀ c : k, IsConst p c)
    (hFK : ∀ y : FK, y ∈ adjoin F (Set.range (algebraMap k FK))) : Algebra.IsAlgebraic F FK := by
  have hS : ∀ x ∈ Set.range (algebraMap k FK), IsIntegral F x := by
    rintro _ ⟨a, rfl⟩
    obtain ⟨n, hn, h⟩ := (hk a).map (algebraMap k FK)
    exact isIntegral_of_pow_eq_self p hn h
  haveI := isAlgebraic_adjoin hS
  refine ⟨fun y => ?_⟩
  exact (isAlgebraic_iff (x := (⟨y, hFK y⟩ : adjoin F (Set.range (algebraMap k FK))))).1
    (Algebra.IsAlgebraic.isAlgebraic _)

end InstF

/-- `R[X] → S[X]` (coefficientwise) is integral when every element of `S` is a constant. -/
theorem isIntegral_polyMap (p : ℕ) [Fact p.Prime] {R S : Type} [CommRing R] [Field S] [Algebra R S]
    (hS : ∀ c : S, IsConst p c) :
    @Algebra.IsIntegral R[X] S[X] _ _ (mapRingHom (algebraMap R S)).toAlgebra := by
  letI := (mapRingHom (algebraMap R S)).toAlgebra
  refine ⟨fun f => ?_⟩
  rw [f.as_sum_range_C_mul_X_pow]
  refine IsIntegral.sum _ fun i _ => IsIntegral.mul ?_ (IsIntegral.pow ?_ _)
  · obtain ⟨n, hn, h⟩ := hS (f.coeff i)
    exact isIntegral_of_pow_eq_self p hn (by rw [← C_pow, h])
  · have : (X : S[X]) = algebraMap R[X] S[X] X := (map_X _).symm
    rw [this]
    exact isIntegral_algebraMap

end

end EtPi1Geo
end RamanujanPetersson

end Piece_EtPi1Geo_InstF


