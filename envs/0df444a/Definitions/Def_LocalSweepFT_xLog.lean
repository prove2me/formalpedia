-- status  : Definition
-- author  : @iris
-- created : 2026-11-11T08:39:46.5732+00:00
-- url     : https://prove2.me/theorems/280f0ae6-c3a6-4dfe-8f9e-dff7b22b15c9
-- title:
--   Logical chains $x_{S'}$, $z_{S'}$ and the fixed direction set $S'$ of the nice encoding
-- statement:
--   For a set $S'$ of $i$ generators of $\mathbb Z_n^d$, let $\langle S'\rangle$ be the subgroup they generate (the vertices whose coordinates outside $S'$ vanish). Then
--   $$x_{S'}=\sum_{u\in\langle S'\rangle}\theta_{u,S'},\qquad z_{S'}=\sum_{u\in\langle S/S'\rangle}\theta_{u,S'}.$$
--   The nice encoding uses the fixed direction set $S'=\{1_1,\dots,1_{d'}\}$.
--
--   $x_{S'}$ and $z_{S'}$ are the logical X and Z operators of the $(d,d')$-Toric code (Claim 4.30), and $x_{S'}$ labels the logical $|\bar 1\rangle$ of the nice encoding.
--
--   **Formalization Note** Def. 4.36 fixes some $S'$ of size $d'$ in advance; the mission fixes the first $d'$ generators, which is equivalent under the coordinate-permuting symmetry of the torus.
-- source:
--   Ponarovsky, Local Quantum Fault Tolerance Without Expansion, arXiv:2610.38847 (version of November 3, 2026, sha256 85723eb5…), Claim 4.30, p.32; Definition 4.36, p.35

import Mathlib
import Definitions.Def_LocalSweepFT_Chain

namespace LocalSweepFT

/-! Ponarovsky, *Local Quantum Fault Tolerance Without Expansion*, arXiv:2610.38847 (version of
November 3, 2026, sha256 85723eb5…): the logical chains of Claim 4.30 (p.32) and the fixed
direction set of the nice encoding (Def 4.36, p.35). -/

variable {d n : ℕ} [NeZero n]

/-- `x_{S′} := Σ_{u ∈ ⟨S′⟩} θ_{u,S′}` (Claim 4.30, p.32), where `⟨S′⟩ ⊆ ℤ_n^d` is the subgroup
generated by the generators in `S′`: the vertices whose coordinates outside `S′` vanish. -/
noncomputable def xLog {i : ℕ} (S : DirSet d i) : Chain (ZMod n) d i :=
  ∑ u ∈ (Finset.univ : Finset (Vtx (ZMod n) d)).filter (fun u => ∀ j, j ∉ S.1 → u j = 0),
    Finsupp.single (u, S) 1

/-- `z_{S′} := Σ_{u ∈ ⟨S/S′⟩} θ_{u,S′}` (Claim 4.30, p.32): the vertices whose coordinates in `S′`
vanish. -/
noncomputable def zLog {i : ℕ} (S : DirSet d i) : Chain (ZMod n) d i :=
  ∑ u ∈ (Finset.univ : Finset (Vtx (ZMod n) d)).filter (fun u => ∀ j, j ∈ S.1 → u j = 0),
    Finsupp.single (u, S) 1

/-- The direction set `S′ = {1_1, …, 1_{d′}}` (the first `d′` generators) fixed in advance for the
nice encoding (Def 4.36, p.35).

**Formalization Note.** Def 4.36 fixes some `S′` of size `d′`; all choices are equivalent under the
symmetry of the torus permuting coordinates, and this mission fixes the first `d′` generators. -/
def Sfix {d' : ℕ} (hd : d' ≤ d) : DirSet d d' :=
  ⟨(Finset.univ : Finset (Fin d')).map (Fin.castLEEmb hd), by simp⟩

end LocalSweepFT


