  have hpos : ∀ x ∈ S, 0 < x := by simp [StrictPartitionSet, Finset.mem_filter] at hS; exact hS.2.1
  have hw := (by simp [StrictPartitionSet, Finset.mem_filter] at hS; exact hS.2.2 : S.sum id = n)
