  have m2 := mvK_spec (X := CO) (Y := NLogN.Rsp.BX) (C := CC1) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg KN) (RS.clean_of_lt (by decide)) v
    (cycL u a N).reverse _ vO
    (IState.isInt_of (L := LKN) (a := (N : ℤ)) (by simp (config := {decide := true}) [hv, gSt, s1KN]))
    (by simp (config := {decide := true}) [Ex.eval, IState.top, hv, gSt, s1KN, cycL_length])
  rw [m2.2]
  set v2 := (v.upd CO (s0.G CO)).upd NLogN.Rsp.BX ((ints (cycL u a N).reverse).reverse ++ v.G NLogN.Rsp.BX) with hv2
  have v2U : v2.G CU = ints (u.drop q) ++ RU := by
    simp (config := {decide := true}) [hv2, hv, gSt, hq]
  have v2R : v2.G CRm = .int ((u.length - q : ℕ) : ℤ) :: s0.G CRm := by
    simp (config := {decide := true}) [hv2, hv, gSt, hq]
  have m3 := mvK_spec (X := CU) (Y := CZ) (C := CC1) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg CRm) (RS.clean_of_lt (by decide)) v2
    (u.drop q) _ v2U (IState.isInt_of v2R)
    (by simp [Ex.eval, IState.top, v2R])
  rw [m3.2]
  set v3 := (v2.upd CU RU).upd CZ ((ints (u.drop q)).reverse ++ v2.G CZ) with hv3
  have v3Z : v3.G CZ = ints u.reverse ++ s0.G CZ := by
    simp (config := {decide := true}) [hv3, hv2, hv, gSt, hq, ← ints_reverse]
    rw [← List.append_assoc, ← ints_append, ← List.reverse_append, List.take_append_drop]
  have v3K : v3.G Ks = .int (u.length : ℤ) :: LKs := by
    simp (config := {decide := true}) [hv3, hv2, hv, gSt, s1Ks]
  have m4 := popK_spec (X := CZ) (C := CC1) (by decide) (by decide) (by decide) (.reg Ks)
    (RS.clean_of_lt (by decide)) v3 u.reverse _ v3Z (IState.isInt_of v3K)
    (by simp [Ex.eval, IState.top, v3K])
  have e4 : (rep CC1 (.reg Ks) (pop CZ)).run v3 = v3.upd CZ (s0.G CZ) := m4.2
  rw [e4]
  apply IState.ext' _ (by simp [hv3, hv2, hv, gSt, hs1]) (by simp [hv3, hv2, hv, gSt, hs1])
  intro x
  by_cases x1 : x = CU
  · subst x1; simp (config := {decide := true}) [hv3]
  by_cases x2 : x = CZ
  · subst x2; simp (config := {decide := true})
  by_cases x3 : x = CRm
  · subst x3; simp (config := {decide := true}) [hv3, hv2, hv, gSt]
  by_cases x4 : x = CO
  · subst x4; simp (config := {decide := true}) [hv3, hv2]
  by_cases x5 : x = NLogN.Rsp.BX
  · subst x5; simp (config := {decide := true}) [hv3, hv2, ← ints_reverse, hv, gSt, hs1]
  simp only [RS.run_pop_G, IState.upd_G, if_neg x1, if_neg x2, if_neg x3, if_neg x4, if_neg x5,
    hv3, hv2, hv, gSt, hs1, RS.run_push_G]

theorem RepStates.cost_le_sum {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS}
    {S : ℕ → IState HS}
    (h : RepStates i n b s S) (B : ℕ) (f : ℕ → ℕ) (hl : n.Lin) (hn : n.Bnd s B)
    (hb : ∀ k < (n.eval s).toNat, b.cost (withCtr i s (n.eval s).toNat k (S k)) ≤ f k) :
    (RS.rep i n b).cost s ≤ (n.size + 1) * 2000 * (B + 2) +
      ∑ k ∈ Finset.range (n.eval s).toNat, (f k + 8000 * (B + 2) + 30) + 32 := by
  have hB := Ex.zsz_eval_le s B n hn
  have h1 := RS.pushCost_le_lin n s B hl hn
  have h2 : ∑ k ∈ Finset.range (n.eval s).toNat, (b.cost (RS.repSt i n b s k) +
      RS.asgCost i (RS.decE i) (b.run (RS.repSt i n b s k)) + 30) ≤
      ∑ k ∈ Finset.range (n.eval s).toNat, (f k + 8000 * (B + 2) + 30) := by
    apply Finset.sum_le_sum
    intro k hk
    have hk' := Finset.mem_range.1 hk
    rw [h.repSt k hk'.le]
    have := hb k hk'
    rw [h.step k hk']
    have := withCtr_dec_le i s (S (k + 1)) n k hk' hB
    omega
  simp only [RS.cost]; omega

/-- The number of refills. -/
theorem refill_count (a s : ℕ) (hs : 0 < s) : ∀ N : ℕ,
    (∑ k ∈ Finset.range N, (if (a + (k + 1)) % s = 0 then 1 else 0)) + a / s = (a + N) / s
  | 0 => by simp
  | N + 1 => by
    rw [Finset.sum_range_succ, add_right_comm, refill_count a s hs N, ← Nat.add_assoc,
      Nat.succ_div]
    simp [Nat.dvd_iff_mod_eq_zero]

set_option maxHeartbeats 4000000 in
theorem gen_cost (s1 : IState HS) (u : List ℤ) (a : ℕ) (RU RZ LRm LKs : List Item)
    (hs : 0 < u.length) (hKs : s1.G Ks = .int (u.length : ℤ) :: LKs) (S0 : IState HS) (N0 j : ℕ)
    (B : ℕ) (hu : ∀ y ∈ u, zsz y ≤ B) (hsB : zsz (u.length : ℤ) ≤ B) :
    genBody.cost (withCtr CC1 S0 N0 j (gSt s1 u a RU RZ LRm j)) ≤
      40000 * (B + 2) + (if (a + (j + 1)) % u.length = 0 then
        u.length * (14000 * (B + 2)) + 10000 * (B + 2) else 0) := by
  generalize ht : withCtr CC1 S0 N0 j (gSt s1 u a RU RZ LRm j) = t
  have tG : ∀ x, x ≠ CC1 → t.G x = (gSt s1 u a RU RZ LRm j).G x := fun x hx => by
    rw [← ht, withCtr_G_ne' _ _ _ _ _ _ hx]
  obtain ⟨q, hq⟩ : ∃ q, (a + j) % u.length = q := ⟨_, rfl⟩
  have hqs : q < u.length := by rw [← hq]; exact Nat.mod_lt _ hs
  obtain ⟨x0, hx0⟩ : ∃ x0, u[q] = x0 := ⟨_, rfl⟩
  have hx0B : zsz x0 ≤ B := by rw [← hx0]; exact hu _ (List.getElem_mem _)
  have hud : u.drop q = x0 :: u.drop (q + 1) := by rw [List.drop_eq_getElem_cons hqs, hx0]
  have hut : u.take (q + 1) = u.take q ++ [x0] := by rw [← List.take_concat_get' u q hqs, hx0]
  have tU : t.G CU = .int x0 :: (ints (u.drop (q + 1)) ++ RU) := by
    rw [tG _ (by decide)]; simp (config := {decide := true}) [gSt, hq, hud]
  have tR : t.G CRm = .int ((u.length - q : ℕ) : ℤ) :: LRm := by
    rw [tG _ (by decide)]; simp (config := {decide := true}) [gSt, hq]
  have tK : t.G Ks = .int (u.length : ℤ) :: LKs := by
    rw [tG _ (by decide), gSt_G_other _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide)
      (by decide), hKs]
  set t1 := (asg CRm (.add (.reg CRm) (.lit (-1)))).run ((pop CU).run ((push CZ (.reg CU)).run
    ((push CO (.reg CU)).run t))) with ht1
  have u1R : t1.G CRm = .int ((u.length - (q + 1) : ℕ) : ℤ) :: LRm := by
    simp (config := {decide := true}) [ht1, IState.top, tR, tU, Ex.eval]; omega
  have u1Z : t1.G CZ = ints (u.take (q + 1)).reverse ++ RZ := by
    simp (config := {decide := true}) [ht1, IState.top, tU, tG, gSt, hq, hut, Ex.eval]
  have u1K : t1.G Ks = .int (u.length : ℤ) :: LKs := by
    simp (config := {decide := true}) [ht1, tK]
  have zq : zsz ((u.length - q : ℕ) : ℤ) ≤ B := le_trans (zsz_natCast_le (by omega)) hsB
  have zq1 : zsz ((u.length - (q + 1) : ℕ) : ℤ) ≤ B := le_trans (zsz_natCast_le (by omega)) hsB
  have zq2 : zsz (((u.length - (q + 1) : ℕ) : ℤ) - 1) ≤ B := by
    have : (((u.length - (q + 1) : ℕ) : ℤ) - 1).natAbs ≤ (u.length : ℤ).natAbs := by
      rw [Int.natAbs_natCast]
      rcases Nat.eq_zero_or_pos (u.length - (q + 1)) with h | h
      · rw [h]; simp; omega
      · rw [show (((u.length - (q + 1) : ℕ) : ℤ) - 1) = ((u.length - (q + 1) - 1 : ℕ) : ℤ) by omega,
          Int.natAbs_natCast]; omega
    exact le_trans (zsz_mono this) hsB
  have hB1 : 1 ≤ B := by
    have : 1 ≤ zsz (u.length : ℤ) := by
      by_contra hc
      have := (zsz_le_iff (z := (u.length : ℤ)) (m := 0)).1 (by omega)
      simp only [Int.natAbs_natCast, pow_zero] at this; omega
    omega
  have zq3 : zsz (((u.length - q : ℕ) : ℤ) + -1) ≤ B := by
    have : ((u.length - q : ℕ) : ℤ) + -1 = ((u.length - (q + 1) : ℕ) : ℤ) := by omega
    rw [this]; exact zq1
  have c1 : (seqL [push CO (.reg CU), push CZ (.reg CU), pop CU,
      asg CRm (.add (.reg CRm) (.lit (-1)))]).cost t ≤ 20000 * (B + 2) := by
    have a4 : ∀ t' : IState HS, t'.G CRm = .int ((u.length - q : ℕ) : ℤ) :: LRm →
        (asg CRm (.add (.reg CRm) (.lit (-1)))).cost t' ≤ (3 + 1) * 2000 * (B + 2) := fun t' h' =>
      RS.asgCost_le_lin _ _ t' B (by simp [Ex.Lin])
        (by simp only [Ex.Bnd, Ex.eval, IState.top, h']
            exact ⟨zq, by rw [zsz_neg, zsz_one]; omega, zq3⟩)
        (by simpa [IState.top, h'] using zq)
    simp only [seqL, RS.cost_seq']
    refine le_trans (add_le_add (cpush_reg _ _ _ B ?_) (add_le_add (cpush_reg _ _ _ B ?_)
      (add_le_add (cpop _ _ B ?_) (a4 _ ?_)))) (by omega)
    all_goals simp (config := {decide := true}) [RS.run, IState.top, IState.upd_G, tU, tR, hx0B]
  have hrun : genBody.cost t = (seqL [push CO (.reg CU), push CZ (.reg CU), pop CU,
      asg CRm (.add (.reg CRm) (.lit (-1)))]).cost t + (ite (.add (.reg CRm) (.lit (-1)))
      (NLogN.RS.seq (mvK CZ CU CC2 (.reg Ks)) (asg CRm (.reg Ks))) skip).cost t1 := by
    rw [ht1]; simp only [genBody, seqL, RS.cost_seq']; ring
  rw [hrun]
  have hc1 : (Ex.add (.reg CRm) (.lit (-1)) : Ex HS).eval t1 = ((u.length - (q + 1) : ℕ) : ℤ) - 1 := by
    simp [Ex.eval, IState.top, u1R]; ring
  have hcB : (Ex.add (.reg CRm) (.lit (-1)) : Ex HS).Bnd t1 B := by
    simp only [Ex.Bnd, Ex.eval, IState.top, u1R]
    refine ⟨zq1, by rw [zsz_neg, zsz_one]; omega, ?_⟩
    have : ((u.length - (q + 1) : ℕ) : ℤ) + -1 = ((u.length - (q + 1) : ℕ) : ℤ) - 1 := by ring
    rw [this]; exact zq2
  have cc := Ex.cost_le_lin t1 B (.add (.reg CRm) (.lit (-1))) (by simp [Ex.Lin]) hcB
  have zc := Ex.zsz_eval_le t1 B _ hcB
  simp only [Ex.size] at cc
  simp only [RS.cost]
  have hq1 : (a + (j + 1)) % u.length = 0 ↔ q + 1 = u.length := by
    rw [← Nat.add_assoc, Nat.add_mod, hq]
    rcases Nat.lt_or_ge 1 u.length with h | h
    · rw [Nat.mod_eq_of_lt h]
      constructor
      · intro h2
        rcases Nat.lt_or_ge (q + 1) u.length with h3 | h3
        · rw [Nat.mod_eq_of_lt h3] at h2; omega
        · omega
      · intro h2; rw [h2, Nat.mod_self]
    · have : u.length = 1 := by omega
      simp [this]; omega
  split_ifs with hneg hre hre
  · -- refill
    have hlast := hq1.1 hre
    have hutl : u.take (q + 1) = u := by rw [hlast, List.take_length]
    have u1Z' : t1.G CZ = ints u.reverse ++ RZ := by rw [u1Z, hutl]
    have hm := mvK_spec (X := CZ) (Y := CU) (C := CC2) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (.reg Ks) (RS.clean_of_lt (by decide)) t1 u.reverse RZ
      u1Z' (IState.isInt_of u1K) (by simp [Ex.eval, IState.top, u1K])
    have cm := mvK_cost (X := CZ) (Y := CU) (C := CC2) (by decide) (by decide) (by decide) (.reg Ks)
      t1 u.reverse RZ u1Z' (by simp [Ex.eval, IState.top, u1K]) B
      (fun y hy => hu y (List.mem_reverse.1 hy)) trivial (by simpa [Ex.Bnd, IState.top, u1K])
    simp only [RS.cost_seq', hm.2]
    have ca := RS.asgCost_le_lin CRm (.reg Ks) ((t1.upd CZ RZ).upd CU ((ints u.reverse).reverse ++
      t1.G CU)) B trivial (by simpa (config := {decide := true}) [Ex.Bnd, IState.top, u1K])
      (by simpa (config := {decide := true}) [IState.top, u1R] using zq1)
    simp only [Ex.size, List.length_reverse] at cm ca
    simp only [moveCost] at *
    nlinarith
  · exfalso; rw [hc1] at hneg; exact hre (hq1.2 (by omega))
  · exfalso; have := hq1.1 hre; rw [hc1] at hneg; omega
  · simp only [moveCost] at *
    omega

set_option maxHeartbeats 8000000 in
theorem cycP_okc (s0 : IState HS) (u : List ℤ) (a N : ℕ) (RU LKs LKa LKN : List Item)
    (hs : 0 < u.length) (ha : a < u.length)
    (hU : s0.G CU = ints u ++ RU) (hKs : s0.G Ks = .int (u.length : ℤ) :: LKs)
    (hKa : s0.G Ka = .int (a : ℤ) :: LKa) (hKN : s0.G KN = .int (N : ℤ) :: LKN)
    (B : ℕ) (hu : ∀ y ∈ u, zsz y ≤ B) (hsB : zsz (u.length : ℤ) ≤ B) (hNB : zsz (N : ℤ) ≤ B) :
    cycP.ok s0 ∧ cycP.cost s0 ≤ cycCost u.length N B := by
  have zA : zsz (a : ℤ) ≤ B := le_trans (zsz_natCast_le ha.le) hsB
  have hUa : s0.G CU = ints (u.take a) ++ (ints (u.drop a) ++ RU) := by
    rw [hU, ← List.append_assoc, ← ints_append, List.take_append_drop]
  have m1 := mvK_spec (X := CU) (Y := CZ) (C := CC1) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg Ka) (RS.clean_of_lt (by decide)) s0 (u.take a) _
    hUa (IState.isInt_of hKa) (by simp [Ex.eval, IState.top, hKa]; omega)
  have k1 := mvK_cost (X := CU) (Y := CZ) (C := CC1) (by decide) (by decide) (by decide) (.reg Ka)
    s0 (u.take a) _ hUa (by simp [Ex.eval, IState.top, hKa]; omega) B
    (fun y hy => hu y (List.mem_of_mem_take hy)) trivial (by simpa [Ex.Bnd, IState.top, hKa])
  set s1' := (s0.upd CU (ints (u.drop a) ++ RU)).upd CZ ((ints (u.take a)).reverse ++ s0.G CZ)
    with hs1'
  have ok2 : (push CRm (.add (.reg Ks) (.neg (.reg Ka)))).ok s1' :=
    ⟨by decide, by decide, IState.isInt_of (L := LKs) (a := (u.length : ℤ))
      (by simp (config := {decide := true}) [hs1', hKs]),
      IState.isInt_of (L := LKa) (a := (a : ℤ)) (by simp (config := {decide := true}) [hs1', hKa])⟩
  have k2 : (push CRm (.add (.reg Ks) (.neg (.reg Ka)))).cost s1' ≤ (4 + 1) * 2000 * (B + 2) :=
    RS.pushCost_le_lin _ s1' B (by simp [Ex.Lin]) (by
      simp (config := {decide := true}) only [Ex.Bnd, Ex.eval, IState.top, hs1', IState.upd_G,
        hKs, hKa, if_false, zsz_neg]
      refine ⟨hsB, zA, ?_⟩
      have : (u.length : ℤ) + -(a : ℤ) = ((u.length - a : ℕ) : ℤ) := by omega
      rw [this]; exact le_trans (zsz_natCast_le (by omega)) hsB)
  set s1 := (push CRm (.add (.reg Ks) (.neg (.reg Ka)))).run s1' with hs1
  have s1Ks : s1.G Ks = .int (u.length : ℤ) :: LKs := by
    simp (config := {decide := true}) [hs1, hs1', hKs]
  have s1KN : s1.G KN = .int (N : ℤ) :: LKN := by simp (config := {decide := true}) [hs1, hs1', hKN]
  have h0 : gSt s1 u a RU (s0.G CZ) (s0.G CRm) 0 = s1 := by
    apply IState.ext' _ (by simp [gSt]) (by simp [gSt])
    intro x
    simp only [gSt, IState.upd_G, Nat.add_zero, Nat.mod_eq_of_lt ha]
    split_ifs <;> subst_vars <;> simp (config := {decide := true}) [hs1, hs1', cycL, Ex.eval,
      IState.top, hKs, hKa, ints_reverse]
    omega
  have H := gen_states s1 u a N RU (s0.G CZ) (s0.G CRm) LKs LKN hs s1Ks s1KN h0
  have hN : ((Ex.reg KN).eval s1).toNat = N := by simp [Ex.eval, IState.top, s1KN]
  have hrun := H.run
  rw [hN] at hrun
  have kG := RepStates.cost_le_sum H B (fun k => 40000 * (B + 2) +
      (if (a + (k + 1)) % u.length = 0 then u.length * (14000 * (B + 2)) + 10000 * (B + 2) else 0))
      trivial (by simpa [Ex.Bnd, IState.top, s1KN])
      (fun k _ => gen_cost s1 u a RU (s0.G CZ) (s0.G CRm) LKs hs s1Ks s1 _ k B hu hsB)
  rw [hN] at kG
  have hsum : ∑ k ∈ Finset.range N, (40000 * (B + 2) +
      (if (a + (k + 1)) % u.length = 0 then u.length * (14000 * (B + 2)) + 10000 * (B + 2) else 0)
      + 8000 * (B + 2) + 30) ≤ N * (48000 * (B + 2) + 30) + (a + N) * (24000 * (B + 2)) := by
    have e : ∀ k, (40000 * (B + 2) +
        (if (a + (k + 1)) % u.length = 0 then u.length * (14000 * (B + 2)) + 10000 * (B + 2) else 0)
        + 8000 * (B + 2) + 30) = (48000 * (B + 2) + 30) +
        (u.length * (14000 * (B + 2)) + 10000 * (B + 2)) *
          (if (a + (k + 1)) % u.length = 0 then 1 else 0) := fun k => by
      split_ifs <;> ring
    simp only [e, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul,
      ← Finset.mul_sum]
    have hc := refill_count a u.length hs N
    have hdiv : (a + N) / u.length * u.length ≤ a + N := Nat.div_mul_le_self _ _
    have hdiv2 : (a + N) / u.length ≤ a + N := Nat.div_le_self _ _
    set c := ∑ k ∈ Finset.range N, (if (a + (k + 1)) % u.length = 0 then 1 else 0) with hcdef
    have hc' : c ≤ (a + N) / u.length := hc ▸ Nat.le_add_right _ _
    have h1 : (u.length * (14000 * (B + 2)) + 10000 * (B + 2)) * c ≤
        (u.length * (14000 * (B + 2)) + 10000 * (B + 2)) * ((a + N) / u.length) :=
      Nat.mul_le_mul_left _ hc'
    have h2 : u.length * (14000 * (B + 2)) * ((a + N) / u.length) ≤ (a + N) * (14000 * (B + 2)) := by
      calc u.length * (14000 * (B + 2)) * ((a + N) / u.length)
          = (a + N) / u.length * u.length * (14000 * (B + 2)) := by ring
        _ ≤ (a + N) * (14000 * (B + 2)) := Nat.mul_le_mul_right _ hdiv
    have h3 : 10000 * (B + 2) * ((a + N) / u.length) ≤ 10000 * (B + 2) * (a + N) :=
      Nat.mul_le_mul_left _ hdiv2
    nlinarith
  set v := gSt s1 u a RU (s0.G CZ) (s0.G CRm) N with hv
  obtain ⟨q, hq⟩ : ∃ q, (a + N) % u.length = q := ⟨_, rfl⟩
  have hqs : q < u.length := by rw [← hq]; exact Nat.mod_lt _ hs
  have vO : v.G CO = ints (cycL u a N).reverse ++ s0.G CO := by
    simp (config := {decide := true}) [hv, gSt, hs1, hs1']
  have vN : v.G KN = .int (N : ℤ) :: LKN := by simp (config := {decide := true}) [hv, gSt, s1KN]
  have hcB : ∀ y ∈ (cycL u a N).reverse, zsz y ≤ B := by
    intro y hy
    simp only [List.mem_reverse, cycL, List.mem_map, List.mem_range] at hy
    obtain ⟨j, _, rfl⟩ := hy
    rw [List.getD_eq_getElem _ _ (Nat.mod_lt _ hs)]; exact hu _ (List.getElem_mem _)
  have m2 := mvK_spec (X := CO) (Y := NLogN.Rsp.BX) (C := CC1) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg KN) (RS.clean_of_lt (by decide)) v
    (cycL u a N).reverse _ vO (IState.isInt_of vN)
    (by simp (config := {decide := true}) [Ex.eval, IState.top, vN, cycL_length])
  have k3 := mvK_cost (X := CO) (Y := NLogN.Rsp.BX) (C := CC1) (by decide) (by decide) (by decide) (.reg KN)
    v (cycL u a N).reverse _ vO
    (by simp (config := {decide := true}) [Ex.eval, IState.top, vN, cycL_length]) B hcB trivial
    (by simpa [Ex.Bnd, IState.top, vN])
  set v2 := (v.upd CO (s0.G CO)).upd NLogN.Rsp.BX ((ints (cycL u a N).reverse).reverse ++ v.G NLogN.Rsp.BX) with hv2
