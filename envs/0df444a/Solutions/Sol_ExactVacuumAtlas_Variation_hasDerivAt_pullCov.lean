variable {n : ℕ}
theorem solution {U : Set (Pt n)} (hU : IsOpen U) {T : Fin n → Fin n → Pt n → ℝ}
    (hT : ∀ i j, ContDiffOn ℝ ∞ (T i j) U) (ξ : Fin n → Pt n → ℝ) {y : Pt n} (hy : y ∈ U) (a b : Fin n) :
    HasDerivAt (fun ε => pullCov ξ T ε a b y) (lieCov2 ξ T a b y) 0 := by
  simp only [pullCov_apply]
  have hd := HasDerivAt.fun_sum (u := Finset.univ) fun p _ => HasDerivAt.fun_sum (u := Finset.univ) fun q _ =>
    ((hasDerivAt_shiftJac ξ y p a).mul (hasDerivAt_shiftJac ξ y q b)).mul (hasDerivAt_comp_shift hU (hT p q) ξ hy)
  refine hd.congr_deriv ?_
  simp only [Pi.mul_apply, shiftJac_zero, shiftMap_zero, Matrix.one_apply, add_mul,
    Finset.sum_add_distrib, ite_mul, one_mul, zero_mul, mul_ite, mul_one, mul_zero,
    Finset.sum_ite_eq', Finset.mem_univ, if_true, lieCov2]
  have e : ∀ x : Fin n, (∑ x1, if x = a then pd b (ξ x1) y * T x x1 y else 0) =
      if x = a then ∑ x1, pd b (ξ x1) y * T x x1 y else 0 := fun x => by split_ifs <;> simp
  simp only [e, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [show (∑ x, pd a (ξ x) y * T x b y) = ∑ x, T x b y * pd a (ξ x) y from
      Finset.sum_congr rfl fun _ _ => mul_comm _ _,
    show (∑ x, pd b (ξ x) y * T a x y) = ∑ x, T a x y * pd b (ξ x) y from
      Finset.sum_congr rfl fun _ _ => mul_comm _ _]
  ring
