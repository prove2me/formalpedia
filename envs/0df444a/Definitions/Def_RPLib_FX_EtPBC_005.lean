-- ===== S4.Def_RP_EtPBC_A_O2UK1 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2UK1): `1 + t e` is a `d`-th power over an etale neighbourhood (ring level)

Km DESIGN v3 step UK, ring level. Let `χ : B → K` be a point with `χ t = 0`, `d` a unit of `B`, and `g ∈ B[X]` monic of
degree `n > 0`. In the coordinates `y_0 … y_{n-1}` of `B[X] ⧸ (g)`, the equation `(Σ y_i X^i)^d = 1 + t X` is the
system `ukF g d t` (coefficients of the remainder mod `g`). At `y₀ = (1, 0, …, 0)` its Jacobian is `d · 1`
(`uk_jac`, computed with dual numbers, `aeval_dual`) and its value is `-t · (X mod g)`, divisible by `det² = d^{2n}`.
* **`uk_root`** (Tougeron, `tougeron_nbhd_strong`): there are an etale `B → B'` with a point `χ'` over `χ` and
  `y : Fin n → B'` such that `(Σ y_i e^i)^d = 1 + t e` for every root `e` of `g` in every `B'`-algebra.
* `exists_monic_of_isIntegral`: an integral element has a monic equation of positive degree.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtPBC.Cov

universe u v

section Dual

variable {B : Type u} [CommRing B] {n : ℕ}

/-- Evaluation at `y + ε δ_k` computes the value and the `k`-th partial derivative. -/
theorem aeval_dual (y : Fin n → B) (k : Fin n) (p : MvPolynomial (Fin n) B) :
    MvPolynomial.aeval (fun i => (TrivSqZeroExt.inl (y i) : DualNumber B) + if i = k then DualNumber.eps else 0) p =
      TrivSqZeroExt.inl (MvPolynomial.eval y p) +
        TrivSqZeroExt.inr (MvPolynomial.eval y (MvPolynomial.pderiv k p)) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [TrivSqZeroExt.algebraMap_eq_inl]
  | add p q hp hq =>
    rw [map_add, hp, hq, MvPolynomial.eval_add, map_add, MvPolynomial.eval_add, TrivSqZeroExt.inl_add,
      TrivSqZeroExt.inr_add]
    abel
  | mul_X p i hp =>
    rw [map_mul, hp, MvPolynomial.aeval_X, Derivation.leibniz, MvPolynomial.pderiv_X]
    by_cases h : i = k
    · subst h
      ext <;> simp <;> ring
    · ext <;> simp [h] <;> ring

theorem one_add_pow_of_sq {R : Type*} [CommRing R] {a : R} (ha : a ^ 2 = 0) (m : ℕ) :
    (1 + a) ^ m = 1 + (m : R) * a := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ, ih]
    push_cast
    linear_combination (m : R) * ha

end Dual

section UK

variable {B : Type u} [CommRing B]

/-- The generic element `Σ_i Y_i X^i` of `B[Y_0..Y_{n-1}][X]`. -/
def ukGen (n : ℕ) : (MvPolynomial (Fin n) B)[X] := ∑ i : Fin n, C (MvPolynomial.X i) * X ^ (i : ℕ)

/-- `(Σ_i Y_i X^i)^d - 1 - t X`. -/
def ukP (n d : ℕ) (t : B) : (MvPolynomial (Fin n) B)[X] := ukGen n ^ d - 1 - C (MvPolynomial.C t) * X

/-- The coordinates of `(Σ Y_i X^i)^d - 1 - t X` in `B[Y][X] ⧸ (g)` (basis `X^j`, `j < deg g`). -/
def ukF (g : B[X]) (d : ℕ) (t : B) (j : Fin g.natDegree) : MvPolynomial (Fin g.natDegree) B :=
  (ukP g.natDegree d t %ₘ g.map MvPolynomial.C).coeff j

theorem ukP_map {n : ℕ} (d : ℕ) (t : B) {S : Type v} [CommRing S] [Algebra B S]
    (φ : MvPolynomial (Fin n) B →ₐ[B] S) :
    (ukP n d t).map (φ : MvPolynomial (Fin n) B →+* S) =
      (∑ i : Fin n, C (φ (MvPolynomial.X i)) * X ^ (i : ℕ)) ^ d - 1 - C (algebraMap B S t) * X := by
  simp [ukP, ukGen, Polynomial.map_sum, MvPolynomial.algHom_C]

theorem map_gM (g : B[X]) {S : Type v} [CommRing S] [Algebra B S] {n : ℕ}
    (φ : MvPolynomial (Fin n) B →ₐ[B] S) :
    (g.map (MvPolynomial.C : B →+* MvPolynomial (Fin n) B)).map (φ : MvPolynomial (Fin n) B →+* S) =
      g.map (algebraMap B S) := by
  rw [Polynomial.map_map]
  congr 1
  ext a
  simp [MvPolynomial.algHom_C]

theorem ukF_map (g : B[X]) (hg : g.Monic) (d : ℕ) (t : B) {S : Type v} [CommRing S] [Algebra B S]
    (φ : MvPolynomial (Fin g.natDegree) B →ₐ[B] S) (j : Fin g.natDegree) :
    φ (ukF g d t j) = (((∑ i : Fin g.natDegree, C (φ (MvPolynomial.X i)) * X ^ (i : ℕ)) ^ d - 1 -
      C (algebraMap B S t) * X) %ₘ g.map (algebraMap B S)).coeff j := by
  rw [← ukP_map, ← map_gM g φ,
    ← map_modByMonic (φ : MvPolynomial (Fin g.natDegree) B →+* S) (hg.map MvPolynomial.C), coeff_map]
  rfl

/-- The base point `y₀ = (1, 0, …, 0)` (the coordinates of `1`). -/
def ukY0 {n : ℕ} (hn : 0 < n) : Fin n → B := Pi.single (⟨0, hn⟩ : Fin n) 1

theorem uk_sum {n : ℕ} (hn : 0 < n) (k : Fin n) :
    ∑ i : Fin n, C ((TrivSqZeroExt.inl (ukY0 (B := B) hn i) : DualNumber B) +
      if i = k then DualNumber.eps else 0) * X ^ (i : ℕ) = 1 + C DualNumber.eps * X ^ (k : ℕ) := by
  simp only [map_add, add_mul, Finset.sum_add_distrib]
  rw [Finset.sum_eq_single (⟨0, hn⟩ : Fin n), Finset.sum_eq_single k]
  all_goals first
    | (intro b _ hb; simp [ukY0, Pi.single_apply, hb]; done)
    | (simp [ukY0]; done)

end UK

end RamanujanPetersson.EtPBC.EtKum

end

end

-- ===== S4.Def_RP_EtPBC_A_O2UK2b =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2UK2b): the `d`-th root of `1 + t e` on the pieces over an etale `B → B'`

`D = Spec B` etale over `P` (through `hB`), `X R : P.Etale`, `W := (D ×_P X) ×_P R`; `wD : W ⟶ D`,
`bW : B ⟶ Γ(W)`, `bK p : B →+* Frac(Γ(W) ⧸ p)`.
* `wm_wD`: `wm (prdMap d X) ≫ wD D X = wD D₁ X ≫ d.left`;
* `uk_root'`: O2UK1 `uk_root` with an explicit ring map `ι : B ⟶ B'` (`Spec ι` etale);
* **`exists_pow_of_uk`**: for `D₁ ⟶ Spec B'` and a piece `p₁` of `W₁ := (D₁ ×_P X) ×_P R`, every `Ψ` compatible with
  `wm (prdMap d X)` sends `1 + t e` (`e` a root of `g` over `B`) to a `d`-th power.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtPBC.EtMV RamanujanPetersson.EtPBC.EtShap RamanujanPetersson.EtPBC.GenGeo

universe u

section WD

variable {P : Scheme.{u}}

/-- `(D ×_P X) ×_P R ⟶ D`. -/
def wD (D X R : P.Etale) : ((etPull (prd D X).hom).obj R).left ⟶ D.left :=
  pullback.snd R.hom (prd D X).hom ≫ pullback.fst D.hom X.hom

end WD

section Ring

variable {P : Scheme.{u}} {B : CommRingCat.{u}} (hB : Spec B ⟶ P) [Etale hB] (X R : P.Etale)

/-- `B ⟶ Γ((D ×_P X) ×_P R)` for `D = Spec B`. -/
def bW : B ⟶ Γ(((etPull (prd (Scheme.Etale.mk hB) X).hom).obj R).left, ⊤) :=
  (Scheme.ΓSpecIso B).inv ≫ (wD (Scheme.Etale.mk hB) X R).appTop

variable {B' : CommRingCat.{u}} (ι : B ⟶ B') [Etale (Spec.map ι)]

/-- `Spec B' ⟶ Spec B` over `P`. -/
def nD : Scheme.Etale.mk (Spec.map ι ≫ hB) ⟶ Scheme.Etale.mk hB :=
  MorphismProperty.Over.homMk (Spec.map ι) rfl

variable {D₁ : P.Etale} (d₁ : D₁ ⟶ Scheme.Etale.mk (Spec.map ι ≫ hB))

/-- `B' ⟶ Γ((D₁ ×_P X) ×_P R)`. -/
def bW₁ : B' ⟶ Γ(((etPull (prd D₁ X).hom).obj R).left, ⊤) :=
  (Scheme.ΓSpecIso B').inv ≫ (wD D₁ X R ≫ d₁.left).appTop

end Ring

