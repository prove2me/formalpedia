      ∀ i, |((select u).1 : ℚ) * u i - (select u).2 i| ≤ 1 / (8 * (p : ℚ) * M))
    (v : Fin p → ℝ) (oracle : (Fin p → ℤ) → Bool)
    (hOracle : ∀ c, oracle c = true ↔ 0 ≤ formValue c v)
    {row : Fin p → ℤ} (hm : row ∈ SignQueries.history oracle (roundingProgramWith M select)) (j : Fin p) :
