variable (F : Type) [Field F] [NumberField F]

private theorem finRoot_mul_of_componentAt3_eq (T g : AdelicGL 3 (𝓞 F) F) (v : HeightOneSpectrum (𝓞 F))
    (b c : v.adicCompletion F) (hc : c ≠ 0)
    (hT : ((componentAt3 (𝓞 F) F v T : GL (Fin 3) (v.adicCompletion F)) :
      Matrix (Fin 3) (Fin 3) (v.adicCompletion F)) = Matrix.diagonal ![b * c, c, 1]) :
    finRoot₁ F v (T * g) = ‖b‖ * finRoot₁ F v g ∧ finRoot₂ F v (T * g) = ‖c‖ * finRoot₂ F v g := by
  have h2 : (![b * c, c, 1] : Fin 3 → v.adicCompletion F) 2 = 1 := rfl
  have h1 : (![b * c, c, 1] : Fin 3 → v.adicCompletion F) 1 = c := rfl
  have hr := lastRowSup_mul_of_coe_eq_diagonal _ (componentAt3 (𝓞 F) F v g) _ hT h2
  have hm := minorSup_mul_of_coe_eq_diagonal _ (componentAt3 (𝓞 F) F v g) _ hT h2
  rw [h1] at hm
  simp only [finRoot₁, finRoot₂, map_mul]
  exact ⟨detSize_mul_lastRow_div_minor_sq_mul _ _ b c hc hT _ _ hr hm, minor_div_lastRow_sq_mul _ _ c _ _ hr hm⟩

private theorem archRoot_mul_of_archPlaceComponent3_eq (T g : AdelicGL 3 (𝓞 F) F) (w : InfinitePlace F)
    (b c : w.Completion) (hc : c ≠ 0)
    (hT : ((archPlaceComponent3 F w T : GL (Fin 3) w.Completion) : Matrix (Fin 3) (Fin 3) w.Completion) =
      Matrix.diagonal ![b * c, c, 1]) :
    archRoot₁ F w (T * g) = ‖b‖ * archRoot₁ F w g ∧ archRoot₂ F w (T * g) = ‖c‖ * archRoot₂ F w g := by
  have h2 : (![b * c, c, 1] : Fin 3 → w.Completion) 2 = 1 := rfl
  have h1 : (![b * c, c, 1] : Fin 3 → w.Completion) 1 = c := rfl
  have hr := lastRowEucl_mul_of_coe_eq_diagonal _ (archPlaceComponent3 F w g) _ hT h2
  have hm := minorEucl_mul_of_coe_eq_diagonal _ (archPlaceComponent3 F w g) _ hT h2
  rw [h1] at hm
  simp only [archRoot₁, archRoot₂, map_mul]
  exact ⟨detSize_mul_lastRow_div_minor_sq_mul _ _ b c hc hT _ _ hr hm, minor_div_lastRow_sq_mul _ _ c _ _ hr hm⟩

end
