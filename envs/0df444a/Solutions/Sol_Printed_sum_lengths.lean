namespace Printed
theorem _root_.solution (w lam i : ℕ) : ((List.range i).map fun u => if u = w then 0 else lam).sum = (if w < i then i - 1 else i) * lam := by
  induction i with
  | zero => simp
  | succ i ih =>
    rw [List.range_succ, List.map_append, List.sum_append, ih]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, add_zero]
    rcases lt_trichotomy w i with h | h | h
    · have h1 : w < i + 1 := by omega
      have h2 : i ≠ w := by omega
      rw [if_pos h, if_pos h1, if_neg h2]
      obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
      simp only [Nat.add_sub_cancel]
      ring
    · subst h
      simp
    · have h1 : ¬ w < i + 1 := by omega
      have h0 : ¬ w < i := by omega
      have h2 : i ≠ w := by omega
      rw [if_neg h0, if_neg h1, if_neg h2]
      ring
end Printed
