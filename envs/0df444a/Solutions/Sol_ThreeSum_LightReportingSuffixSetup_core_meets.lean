    · exact hf
    · exact hg
  apply Meets.of_body (p := 28) (by rfl : program[28]? = some (coreBody 27 2))
  unfold coreBody coreTime
  have hl := LightReportingSuffixTable.meets (P := program) (pMain := 27)
