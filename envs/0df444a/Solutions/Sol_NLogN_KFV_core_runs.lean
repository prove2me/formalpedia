    (hB : w + n + ℓ + 4 ≤ B) (g : Fin HS → List ℤ) (hgT : g NLogN.KFV.vT = []) (hgN : g gNn = [])
    (hgL : g gLl = []) {L l : List ℤ} (hgX : g X = L ++ l) (hL : L.length = 2 * (2 ^ n * 2 ^ ℓ))
