lemma valid_append {A B : Shape} {a b : List ℕ} (ha : Valid A a) (hb : Valid B b) :
    Valid (A ++ B) (a ++ b) := List.rel_append ha hb

lemma Valid.take {sh : Shape} {a : List ℕ} (h : Valid sh a) (k : ℕ) :
