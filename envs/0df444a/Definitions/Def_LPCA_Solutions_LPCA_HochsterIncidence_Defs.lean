namespace LPCA

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

/-- The rank orientation is exactly the existing signed-subset orientation. -/
theorem cechCoefficient_eq_signedInc (rank : V ↪ ℕ) (F G : Finset V) :
    letI : LinearOrder V := rankLinearOrder rank
    cechCoefficient k rank F G = Proofs.BassLyubeznik.SignedCore.inc k F G := by
  rfl

/-- The inversion sign agrees with the existing signed-core convention. -/
theorem hochsterSign_eq_signedEps (rank : V ↪ ℕ) (σ G : Finset V) :
    letI : LinearOrder V := rankLinearOrder rank
    hochsterSign k rank σ G = Proofs.BassLyubeznik.SignedCore.eps k σ G := by
  letI : LinearOrder V := rankLinearOrder rank
  unfold hochsterSign Proofs.BassLyubeznik.SignedCore.eps
  congr 1
  change (∑ g ∈ G, (σ.filter (fun s => rank s < rank g)).card) =
    ((σ ×ˢ G).filter (fun p => rank p.1 < rank p.2)).card
  simp only [Finset.card_filter, Finset.sum_product]
  exact Finset.sum_comm

/-- The complete incidence identity, including zero coefficients and
nonadjacent faces, rather than only a single insertion. -/
theorem hochsterSign_incidence (rank : V ↪ ℕ) (σ G H : Finset V)
    (hG : Disjoint σ G) (hH : Disjoint σ H) :
    hochsterSign k rank σ H * cechCoefficient k rank (σ ∪ G) (σ ∪ H) =
      cechCoefficient k rank G H * hochsterSign k rank σ G := by
  letI : LinearOrder V := rankLinearOrder rank
  rw [hochsterSign_eq_signedEps, hochsterSign_eq_signedEps,
    cechCoefficient_eq_signedInc, cechCoefficient_eq_signedInc]
  have he := Proofs.BassLyubeznik.SignedCore.inc_sdiff (k := k)
    (G := σ) (J := σ ∪ G) (J' := σ ∪ H)
    Finset.subset_union_left Finset.subset_union_left
  rw [Finset.union_sdiff_cancel_left hG, Finset.union_sdiff_cancel_left hH] at he
  rw [he]
  calc
    _ = (Proofs.BassLyubeznik.SignedCore.eps k σ G *
        Proofs.BassLyubeznik.SignedCore.eps k σ G) *
        (Proofs.BassLyubeznik.SignedCore.eps k σ H *
          Proofs.BassLyubeznik.SignedCore.inc k (σ ∪ G) (σ ∪ H)) := by
            rw [Proofs.BassLyubeznik.SignedCore.eps_mul_self, one_mul]
    _ = _ := by ring

end LPCA


