          ((p.reflect n).eval₂
            (coefficientToGenericQuotient D) (xbar D)) := by
          rw [← mul_pow, xbar_mul_tbar D hdeg h0,
            one_pow, one_mul]
    _ =
        xbar D ^ n *
          (((p.reflect n).eval₂
              (coefficientToGenericQuotient D) (xbar D)) *
            tbar D ^ n) := by ring
    _ =
        xbar D ^ n *
          p.eval₂ (coefficientToGenericQuotient D) (tbar D) := by
            rw [hreflect]
