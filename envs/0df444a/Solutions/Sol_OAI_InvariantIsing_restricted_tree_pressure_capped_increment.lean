  apply cavity_bounded_base_log_mean_bound
  · intro x
    exact abs_rotatedEnergy_le eig (matrixRotation V⁻¹) (∑ i, |eig i|)
      (fun i => Finset.single_le_sum (fun j _ => abs_nonneg (eig j)) (Finset.mem_univ i)) x.1
