set_option maxHeartbeats 1000000 in
/-- **The A-line math** (the body of `ALineHyp6_of_AIL6`). -/
theorem aLine_math_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
    ∀ [∀ i, NeZero (sD6 src D i)] [∀ i, NeZero (tD6 P n D i)],
    ∀ M : AxisMaps6 (αN6 P n) (sD6 src D) (tD6 P n D), FitSpec6 P n src D M →
    ∀ (zs : List GI) (u : ((i : Fin (D + 1)) → ZMod (sD6 src D i)) → ℂ),
      RepPad (pP6 P n) (sD6 src D) (tD6 P n D) zs u → ‖u‖ ≤ 1 / 2 →
      zs.length = (List.ofFn (tD6 P n D)).prod ∧ GB (pP6 P n + 2) zs ∧
      RepFull (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs)
        (NLogN.KFY.wOf (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs)) ∧
      GB (pP6 P n + 2) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs) ∧
      ‖NLogN.KFY.wOf (pP6 P n) (tD6 P n D) (tensorGo (mapsA6 P n src D) (List.ofFn (tD6 P n D)) zs) -
        tensCLM (kerA M.A) u‖ ≤ errW6 P n * hp (pP6 P n) := by
  obtain ⟨n₂, hnat⟩ := r6_axis_nat P hP
  obtain ⟨n₃, hfit⟩ := r6_axis_fit P hP
  obtain ⟨n₄, hd10⟩ := eventually_d_ge P hP 10
  refine ⟨max n₂ (max n₃ n₄), ?_⟩
  intro n hn src hsrc D hD _ _ M hM zs u hrep hu
  have hn2 : n₂ ≤ n := by omega
  have hn3 : n₃ ≤ n := by omega
  have hn4 : n₄ ≤ n := by omega
  set m := sWidth (pP6 P n) (αN6 P n) with hmdef
  set d := dP6 P n with hddef
  have hd : 10 ≤ d := hd10 n hn4
  obtain ⟨-, -, hα2, -, -, -, hαp, -, hb', -⟩ := hnat n hn2 src hsrc 0 (by omega)
  have hp18 : 18432 ≤ (pP6 P n) := by
    have e : pP6 P n = 6 * b'P6 P n := rfl
    omega
  obtain ⟨-, -, h48, -⟩ := hfit n hn3 src hsrc 0 (by omega)
  have hdp : d ≤ (pP6 P n) := by
