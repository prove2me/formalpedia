-- url     : https://prove2.me/theorems/1e010583-6e2e-4536-b1ea-df97a8f76e61
-- title:
--   Pairwise regret $R_T^{i\to j}$ of a combined forecast (Appendix)
-- statement:
--   Consider $k$ forecasts $i = 1,\dots,k$ with losses $L_t^i$ in round $t$, and a randomized forecast that picks forecast $i$ in round $t$ with probability $w_t^i$. Foster and Vohra (Appendix, p. 52) define
--
--   $$
--   S_T^{ij} = \sum_{t=1}^{T} w_t^i\,(L_t^i - L_t^j), \qquad
--   R_T^{i\to j} = \max\{0, S_T^{ij}\},
--   $$
--
--   "the regret generated by changing all $i$ forecasts to $j$ forecasts": the loss the combined forecast would have saved had it played $j$ whenever it played $i$.
--
--   This is the internal (pairwise) regret whose sublinear growth, Lemma 1, drives the proof of Theorem 3.
--
--   **Formalization Note** Losses and weights are sequences $L, w : \mathbb N\to\mathbb R^k$ indexed from round $0$; `S L w T i j` and `Rg L w T i j` sum over the first $T$ rounds $0,\dots,T-1$. Thus the paper's $R_{t-1}$ (after rounds $1,\dots,t-1$) is `Rg L w t` for the $0$-based round $t$.
-- source:
--   Foster and Vohra, Calibrated learning and correlated equilibrium, Games Econ. Behav. 21 (1997), p. 52, Appendix, Definition (regret R_T^{i→j}, S_T^{ij})

import Mathlib

namespace CalibratedCE.Forecast

/-- `S_T^{ij} = ∑_{t=1}^T w_t^i (L_t^i - L_t^j)` for `k` forecasts with losses `L t i` and
weights `w t i`; rounds are `0, …, T - 1`. -/
def S {k : ℕ} (L w : ℕ → Fin k → ℝ) (T : ℕ) (i j : Fin k) : ℝ :=
  ∑ t ∈ Finset.range T, w t i * (L t i - L t j)

/-- The regret `R_T^{i→j} = max{0, S_T^{ij}}` generated by changing all `i` forecasts to `j`
forecasts over the first `T` rounds. -/
def Rg {k : ℕ} (L w : ℕ → Fin k → ℝ) (T : ℕ) (i j : Fin k) : ℝ :=
  max 0 (S L w T i j)

end CalibratedCE.Forecast


