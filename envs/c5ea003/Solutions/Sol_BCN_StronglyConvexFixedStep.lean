section BCNBundleModule4
/-!
Scalar arguments used in Bottou–Curtis–Nocedal, arXiv:1606.04838v3,
Section 4: Theorem 4.6, PDF pp. 26–27, (4.14)–(4.16); Theorem 4.7,
PDF pp. 28–29, (4.21)–(4.23); Theorems 4.8/4.10, PDF pp. 32–33,
(4.28) and (4.30). These are deterministic recurrence bridges.
-/

open Filter
open scoped BigOperators Topology

namespace BCN

theorem fixed_recurrence_bound {e : ℕ → ℝ} {r b : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1)
    (hstep : ∀ n, e (n + 1) ≤ (1 - r) * e n + b) (n : ℕ) :
    e n ≤ b / r + (1 - r) ^ n * (e 0 - b / r) := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc
      e (n + 1) ≤ (1 - r) * e n + b := hstep n
      _ ≤ (1 - r) * (b / r + (1 - r) ^ n * (e 0 - b / r)) + b :=
        add_le_add (mul_le_mul_of_nonneg_left ih (sub_nonneg.mpr hr1)) le_rfl
      _ = b / r + (1 - r) ^ (n + 1) * (e 0 - b / r) := by
        rw [pow_succ]
        field_simp
        ring

theorem fixed_bound_tendsto {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) (b e0 : ℝ) :
    Tendsto (fun n : ℕ ↦ b / r + (1 - r) ^ n * (e0 - b / r)) atTop
      (𝓝 (b / r)) := by
  have hp : Tendsto (fun n : ℕ ↦ (1 - r) ^ n) atTop (𝓝 (0 : ℝ)) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (sub_nonneg.mpr hr1) (by linarith)
  simpa using tendsto_const_nhds.add (hp.mul_const (e0 - b / r))

theorem diminishing_recurrence_bound {e : ℕ → ℝ} {A B γ : ℝ}
    (hA : 1 < A) (hB : 0 ≤ B) (hγ : 0 < γ)
    (hmult : ∀ n : ℕ, 0 ≤ 1 - A / (γ + (n : ℝ) + 1))
    (hstep : ∀ n : ℕ, e (n + 1) ≤
      (1 - A / (γ + (n : ℝ) + 1)) * e n + B / (γ + (n : ℝ) + 1) ^ 2)
    (n : ℕ) :
    e n ≤ max (B / (A - 1)) ((γ + 1) * e 0) / (γ + (n : ℝ) + 1) := by
  let ν := max (B / (A - 1)) ((γ + 1) * e 0)
  have hν : 0 ≤ ν := le_trans (div_nonneg hB (by linarith)) (le_max_left _ _)
  have hBν : B ≤ (A - 1) * ν := by
    have h := le_max_left (B / (A - 1)) ((γ + 1) * e 0)
    exact (div_le_iff₀ (by linarith : 0 < A - 1)).mp h |>.trans_eq (mul_comm _ _)
  change e n ≤ ν / (γ + (n : ℝ) + 1)
  induction n with
  | zero =>
    apply (le_div_iff₀ (by positivity : 0 < γ + (0 : ℕ) + 1)).mpr
    simp [ν, mul_comm]
  | succ n ih =>
    have ht : 0 < γ + (n : ℝ) + 1 := by positivity
    have ht' : 0 < γ + (n : ℝ) + 1 + 1 := by linarith
    calc
      e (n + 1) ≤ (1 - A / (γ + (n : ℝ) + 1)) * e n +
          B / (γ + (n : ℝ) + 1) ^ 2 := hstep n
      _ ≤ (1 - A / (γ + (n : ℝ) + 1)) *
          (ν / (γ + (n : ℝ) + 1)) + B / (γ + (n : ℝ) + 1) ^ 2 :=
        add_le_add (mul_le_mul_of_nonneg_left ih (hmult n)) le_rfl
      _ ≤ ν / (γ + (n : ℝ) + 1 + 1) := by
        apply (le_div_iff₀ ht').mpr
        field_simp
        nlinarith [mul_nonneg (sub_nonneg.mpr hBν) ht'.le]
      _ = ν / (γ + ((n + 1 : ℕ) : ℝ) + 1) := by push_cast; ring

theorem sum_le_of_descent {e f b : ℕ → ℝ}
    (hstep : ∀ n, e (n + 1) ≤ e n - f n + b n) (K : ℕ) :
    ∑ n ∈ Finset.range K, f n ≤ e 0 - e K + ∑ n ∈ Finset.range K, b n := by
  induction K with
  | zero => simp
  | succ K ih =>
    simp only [Finset.sum_range_succ]
    linarith [hstep K]

theorem summable_of_descent {e f b : ℕ → ℝ} {lower : ℝ}
    (hf : ∀ n, 0 ≤ f n) (hb : ∀ n, 0 ≤ b n) (hsb : Summable b)
    (hlower : ∀ n, lower ≤ e n)
    (hstep : ∀ n, e (n + 1) ≤ e n - f n + b n) : Summable f := by
  apply summable_of_sum_range_le hf (c := e 0 - lower + ∑' n, b n)
  intro K
  have ht := sum_le_of_descent hstep K
  have hbK := hsb.sum_le_tsum (Finset.range K) (fun n _ ↦ hb n)
  linarith [hlower K]

theorem summable_of_eventual_descent {e f b : ℕ → ℝ} {lower : ℝ}
    (hf : ∀ n, 0 ≤ f n) (hb : ∀ n, 0 ≤ b n) (hsb : Summable b)
    (hlower : ∀ n, lower ≤ e n)
    (hstep : ∀ᶠ n in atTop, e (n + 1) ≤ e n - f n + b n) : Summable f := by
  obtain ⟨N, hN⟩ := eventually_atTop.1 hstep
  apply (summable_nat_add_iff N).mp
  apply summable_of_descent (e := fun n ↦ e (n + N)) (lower := lower)
    (fun n ↦ hf (n + N)) (fun n ↦ hb (n + N))
    ((summable_nat_add_iff N).mpr hsb) (fun n ↦ hlower (n + N))
  intro n
  simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hN (n + N) (by omega)

theorem partial_sum_limit_and_ratio {f a : ℕ → ℝ} (hf : Summable f)
    (ha : Tendsto a atTop atTop) :
    (∃ S : ℝ, Tendsto (fun K ↦ ∑ n ∈ Finset.range K, f n) atTop (𝓝 S)) ∧
      Tendsto (fun K ↦ (∑ n ∈ Finset.range K, f n) / a K) atTop (𝓝 0) := by
  have ht := hf.hasSum.tendsto_sum_nat
  exact ⟨⟨∑' n, f n, ht⟩, ht.div_atTop ha⟩

theorem eventually_small_of_summable_sq {a : ℕ → ℝ}
    (hs : Summable (fun n ↦ a n ^ 2)) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ n in atTop, a n ≤ ε := by
  have he : ∀ᶠ n in atTop, a n ^ 2 < ε ^ 2 :=
    hs.tendsto_atTop_zero.eventually (gt_mem_nhds (sq_pos_of_pos hε))
  filter_upwards [he] with n hn
  nlinarith

theorem summable_of_eventual_scaled_descent {e f b : ℕ → ℝ} {lower c : ℝ}
    (hc : 0 < c) (hf : ∀ n, 0 ≤ f n) (hb : ∀ n, 0 ≤ b n) (hsb : Summable b)
    (hlower : ∀ n, lower ≤ e n)
    (hstep : ∀ᶠ n in atTop, e (n + 1) ≤ e n - c * f n + b n) : Summable f := by
  apply (summable_mul_left_iff hc.ne').mp
  exact summable_of_eventual_descent (fun n ↦ mul_nonneg hc.le (hf n)) hb hsb hlower
    hstep

theorem constant_add_div_nat_tendsto (a b : ℝ) {c : ℝ} (hc : 0 < c) :
    Tendsto (fun n : ℕ ↦ a + b / ((n : ℝ) * c)) atTop (𝓝 a) := by
  have ht : Tendsto (fun n : ℕ ↦ (n : ℝ) * c) atTop atTop :=
    tendsto_natCast_atTop_atTop.atTop_mul_const hc
  simpa using tendsto_const_nhds.add (ht.const_div_atTop b)

end BCN

end BCNBundleModule4
/- END Definitions.BCN.Scalar -/

/- BEGIN Definitions.BCN.StrongConvergence -/
section BCNBundleModule5
/-!
Bottou–Curtis–Nocedal, arXiv:1606.04838v3, Section 4.2:
Theorem 4.6, PDF pp. 26–27, equations (4.14)–(4.16), and
Theorem 4.7, PDF pp. 28–29, equations (4.20)–(4.23).
These proofs integrate the derived PL bound and solve the resulting scalar recurrences.
-/

noncomputable section

open MeasureTheory Filter
open scoped Topology

namespace BCN

variable {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
  {P : Objective d} {C : MomentConstants} {prob : Measure Ω}
  [IsProbabilityMeasure prob] {α : ℕ → ℝ}

theorem Run.expectedGap_pl (R : Run P C prob α) {c : ℝ}
    (hc : 0 < c) (hsc : StrongConvexOn Set.univ c P.F) (k : ℕ) :
    2 * c * expectedGap R k ≤ expectedGradSq R k := by
  have hi := integral_mono
    (((R.loss_integrable k).sub (integrable_const (optimalValue P))).const_mul (2 * c))
    (R.gradSq_integrable k) (fun ω ↦ P.strongConvex_pl hc hsc (R.w k ω))
  simpa only [loss, gradSq, integral_const_mul, expectedGap, expectedGradSq] using hi

theorem Run.expectedGap_step (R : Run P C prob α) {c : ℝ}
    (hc : 0 < c) (hsc : StrongConvexOn Set.univ c P.F) (k : ℕ)
    (hk : α k ≤ C.μ / (P.L * C.MG)) :
    expectedGap R (k + 1) ≤ (1 - α k * c * C.μ) * expectedGap R k +
      α k ^ 2 * P.L * C.M / 2 := by
  have hμ := C.μ_pos
  have hα := R.step_pos k
  have hpl := mul_le_mul_of_nonneg_left (R.expectedGap_pl hc hsc k)
    (by positivity : 0 ≤ C.μ / 2 * α k)
  rw [R.expectedGap_eq k] at hpl
  rw [R.expectedGap_eq k, R.expectedGap_eq (k + 1)]
  nlinarith [R.expected_descent_small k hk]

theorem step_mul_strong_le_one (P : Objective d) (C : MomentConstants)
    {a c : ℝ} (hd : 0 < d) (ha : 0 ≤ a) (hsc : StrongConvexOn Set.univ c P.F)
    (hsmall : a ≤ C.μ / (P.L * C.MG)) : a * c * C.μ ≤ 1 := by
  have hstep := (le_div_iff₀ (mul_pos P.L_pos C.MG_pos)).mp hsmall
  have hprod := mul_le_mul_of_nonneg_right hstep C.μ_pos.le
  have hLM : a * P.L * C.μ ≤ 1 := by
    apply (mul_le_mul_iff_left₀ C.MG_pos).mp
    nlinarith [C.μ_sq_le_MG]
  have hcl := P.strongConvex_le_smooth hd hsc
  calc
    a * c * C.μ ≤ a * P.L * C.μ :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hcl ha) C.μ_pos.le
    _ ≤ 1 := hLM

universe u

/-- Theorem 4.6, including the limit of its explicit upper bound. -/
theorem stronglyConvexFixedStep :
    ∀ (d : ℕ), 0 < d → ∀ (P : Objective d) (C : MomentConstants)
      (Ω : Type u) [MeasurableSpace Ω] (prob : Measure Ω) [IsProbabilityMeasure prob]
      (a c : ℝ), 0 < c → StrongConvexOn Set.univ c P.F →
      0 < a → a ≤ C.μ / (P.L * C.MG) →
      ∀ R : Run P C prob (fun _ ↦ a), R.lower = optimalValue P →
        (∀ k, expectedGap R k ≤ fixedGapBound P C R.w0 a c k) ∧
        Tendsto (fixedGapBound P C R.w0 a c) atTop
          (𝓝 (a * P.L * C.M / (2 * c * C.μ))) := by
  intro d hd P C Ω _ prob _ a c hc hsc ha hsmall R _
  have hr : 0 < a * c * C.μ := mul_pos (mul_pos ha hc) C.μ_pos
  have hr1 : a * c * C.μ ≤ 1 := step_mul_strong_le_one P C hd ha.le hsc hsmall
  have hfrac : (a ^ 2 * P.L * C.M / 2) / (a * c * C.μ) =
      a * P.L * C.M / (2 * c * C.μ) := by
    field_simp [ha.ne', hc.ne', C.μ_pos.ne']
  constructor
  · intro k
    have hb := fixed_recurrence_bound hr hr1
      (fun n ↦ R.expectedGap_step hc hsc n hsmall) k
    rw [hfrac, R.expectedGap_zero] at hb
    exact hb
  · have ht := fixed_bound_tendsto hr hr1 (a ^ 2 * P.L * C.M / 2)
      (P.F R.w0 - optimalValue P)
    rw [hfrac] at ht
    exact ht

/-- Theorem 4.7, with the paper's explicit maximum defining the rate constant. -/
theorem stronglyConvexDiminishingStep :
    ∀ (d : ℕ), 0 < d → ∀ (P : Objective d) (C : MomentConstants)
      (Ω : Type u) [MeasurableSpace Ω] (prob : Measure Ω) [IsProbabilityMeasure prob]
      (c β γ : ℝ), 0 < c → StrongConvexOn Set.univ c P.F →
      1 / (c * C.μ) < β → 0 < γ → β / (γ + 1) ≤ C.μ / (P.L * C.MG) →
      ∀ R : Run P C prob (fun k ↦ β / (γ + (k : ℝ) + 1)),
        R.lower = optimalValue P → ∀ k,
          expectedGap R k ≤ diminishingGapConstant P C R.w0 c β γ /
            (γ + (k : ℝ) + 1) := by
  intro d hd P C Ω _ prob _ c β γ hc hsc hβ hγ hsmall R _ k
  have hβpos : 0 < β := (one_div_pos.mpr (mul_pos hc C.μ_pos)).trans hβ
  have hA : 1 < β * c * C.μ := by
    have h := (div_lt_iff₀ (mul_pos hc C.μ_pos)).mp hβ
    nlinarith
  have hB : 0 ≤ β ^ 2 * P.L * C.M / 2 := by
    exact div_nonneg (mul_nonneg (mul_nonneg (sq_nonneg β) P.L_pos.le) C.M_nonneg)
      (by norm_num)
  have hden (n : ℕ) : 0 < γ + (n : ℝ) + 1 := by positivity
  have hsmall' (n : ℕ) : β / (γ + (n : ℝ) + 1) ≤ C.μ / (P.L * C.MG) := by
    apply le_trans _ hsmall
    exact div_le_div_of_nonneg_left hβpos.le (by positivity : 0 < γ + 1)
      (by have := Nat.cast_nonneg (α := ℝ) n; linarith)
  have hmult (n : ℕ) : 0 ≤ 1 - (β * c * C.μ) / (γ + (n : ℝ) + 1) := by
    have h := step_mul_strong_le_one P C hd (div_pos hβpos (hden n)).le hsc (hsmall' n)
    apply sub_nonneg.mpr
    convert h using 1
    ring
  have hstep (n : ℕ) : expectedGap R (n + 1) ≤
      (1 - (β * c * C.μ) / (γ + (n : ℝ) + 1)) * expectedGap R n +
        (β ^ 2 * P.L * C.M / 2) / (γ + (n : ℝ) + 1) ^ 2 := by
    convert R.expectedGap_step hc hsc n (hsmall' n) using 1
    field_simp
  have hb := diminishing_recurrence_bound hA hB hγ hmult hstep k
  rw [R.expectedGap_zero] at hb
  simpa only [div_div, diminishingGapConstant] using hb

end BCN
end -- original EOF-open anonymous section
end BCNBundleModule5
/- END Definitions.BCN.StrongConvergence -/

open MeasureTheory Filter
open scoped Topology
universe u

open BCN
theorem solution :
  ∀ (d : ℕ), 0 < d → ∀ (P : Objective d) (C : MomentConstants)
    (Ω : Type u) [MeasurableSpace Ω] (prob : Measure Ω) [IsProbabilityMeasure prob]
    (a c : ℝ), 0 < c → StrongConvexOn Set.univ c P.F →
    0 < a → a ≤ C.μ / (P.L * C.MG) →
    ∀ R : Run P C prob (fun _ ↦ a), R.lower = optimalValue P →
      (∀ k, expectedGap R k ≤ fixedGapBound P C R.w0 a c k) ∧
      Tendsto (fixedGapBound P C R.w0 a c) atTop
        (𝓝 (a * P.L * C.M / (2 * c * C.μ))) := by
  exact BCN.stronglyConvexFixedStep
