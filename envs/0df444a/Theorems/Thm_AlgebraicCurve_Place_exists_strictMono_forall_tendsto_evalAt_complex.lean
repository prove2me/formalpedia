open AlgebraicCurve
open scoped Topology

theorem AlgebraicCurve.Place.exists_strictMono_forall_tendsto_evalAt_complex
    (F : Type*) [Field F] [Algebra ℂ F]
    (hfg : ∃ x : F, Transcendental ℂ x ∧
      FiniteDimensional (IntermediateField.adjoin ℂ ({x} : Set F)) F)
    [IsCurveOver ℂ F] (w : ℕ → Place ℂ F) :
    ∃ (v : Place ℂ F) (φ : ℕ → ℕ), StrictMono φ ∧
      ∀ f : F, 0 ≤ v.ord f →
        (∀ᶠ n in Filter.atTop, 0 ≤ (w (φ n)).ord f) ∧
        Filter.Tendsto (fun n => (w (φ n)).evalAt f) Filter.atTop (𝓝 (v.evalAt f)) := by sorry
