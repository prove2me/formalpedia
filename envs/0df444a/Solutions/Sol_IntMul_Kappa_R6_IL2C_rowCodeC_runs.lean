  have n2 : 1 ≤ F * (x + 1) := Nat.one_le_iff_ne_zero.2 (by positivity)
  have b1 : ((F : ℕ) : ℤ) * ((x : ℤ) + 1) ≤ T := by exact_mod_cast n1
