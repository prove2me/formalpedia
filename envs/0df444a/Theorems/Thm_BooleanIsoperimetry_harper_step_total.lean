theorem BooleanIsoperimetry.harper_step_total (n : ℕ)
    (ih : ∀ m, m < n + 1 → ∀ x y, x ≤ 2 ^ m → y ≤ 2 ^ m →
            H (m + 1) (x + y) ≤ max (H m x) y + max (H m y) x)
    {a b : ℕ} (ha : a ≤ 2 ^ (n + 1)) (hb : b ≤ 2 ^ (n + 1)) :
    H (n + 2) (a + b) ≤ boundaryCostH (n + 1) a b := by sorry
