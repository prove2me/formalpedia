section
-- Source module: Solutions.KFECost
/-!
# KFE: closed fine cost bound of the Lemma 12 program

* `cL12F_lin`: `cL12F ≤ Av·(Vb+1)(Kp+1) + Ao·(Bb+2)²(u+1) + Σ_j digit_j · cO j` — the data passes
  are linear in the bit volume `Vb` (no `(Bb+2)` factor); the descriptor work costs
  `O((u+1)(Bb+2)²)`.
* `calls_le`: the per-call overhead of the oracle, `Σ_{j<L} digit_j (S+1)^j ≤ m·n^(c+1)` with
  `c = clog_m (S+1)`: the number of Prop. 11 calls is polynomial in `n ≤ u`.
* `cL12F_le`: with the fine oracle cost `ilCostF` and `S/W < m^τ`,
  `cL12F ≤ K·((Vb + 1)·u^τ + (u+1)^(c+1)·(Bb+2)²)`, `c = clog_m (S+1)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFE

open IntMul RS AModel AModelL12 Finset KIL KFD

/-- Volume constant of the fine Lemma 12 cost. -/
def Av (q W : ℕ) : ℕ := 10 ^ 6 * (q + 1) ^ 3 * (W + 1)

/-- Descriptor-overhead constant of the fine Lemma 12 cost. -/
def Ao (m W : ℕ) : ℕ := 10 ^ 11 * (m + 3) * (W + 1)

