def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

theorem le_mul_ceilDiv {a b : Nat} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
  unfold ceilDiv
  have h1 := Nat.div_add_mod (a + b - 1) b
  have h2 := Nat.mod_lt (a + b - 1) hb
  omega

def wInv (a b : Nat) : Nat :=
  ceilDiv (W_scale * (b - a) * ((a + b) * (a + b) + 8 * a * b)) (6 * a * b * (a + b))

def wInvSq (a b : Nat) : Nat :=
  ceilDiv (W_scale * D_den * (b - a)) (a * b)

def wDiag01 (a b : Nat) : Nat :=
  ceilDiv (W_scale * W_scale * D_den * (b - a) * (b - a) * (b + 2 * a)) (a * b * (a * a + 4 * a * b + b * b))

def wDiag12 (a b : Nat) : Nat :=
  ceilDiv (W_scale * W_scale * D_den * (b - a) * (b - a) * (5 * a + b)) (6 * a * a * b * (a + b))

def wDiag012 (a b : Nat) : Nat :=
  ceilDiv (W_scale * W_scale * W_scale * D_den * (b - a) * (b - a) * (b - a)) (6 * a * a * b * b)

inductive CellKind where
  | box | tri01 | tri12 | simp
  deriving DecidableEq

inductive BoxTree where
  | lf
  | s0 (l r : BoxTree)
  | s1 (l r : BoxTree)
  | s2 (l r : BoxTree)
  | sd01 (c0 m c1 : BoxTree)
  | sd12 (c0 m c1 : BoxTree)
  | sd012 (c0 m01 m12 c1 : BoxTree)

def treeValid : CellKind → BoxTree → Bool
  | _, .lf => true
  | .box, .s0 l r => treeValid .box l && treeValid .box r
  | .tri12, .s0 l r => treeValid .tri12 l && treeValid .tri12 r
  | .box, .s1 l r => treeValid .box l && treeValid .box r
  | .box, .s2 l r => treeValid .box l && treeValid .box r
  | .tri01, .s2 l r => treeValid .tri01 l && treeValid .tri01 r
  | .tri01, .sd01 c0 m c1 => treeValid .tri01 c0 && treeValid .box m && treeValid .tri01 c1
  | .tri12, .sd12 c0 m c1 => treeValid .tri12 c0 && treeValid .box m && treeValid .tri12 c1
  | .simp, .sd012 c0 m01 m12 c1 =>
      treeValid .simp c0 && treeValid .tri01 m01 && treeValid .tri12 m12 && treeValid .simp c1
  | _, _ => false

def evalTreeWith (ub : Nat → Nat → Nat) (pa pb : Nat) :
    CellKind → BoxTree → Nat → Nat → Nat → Nat → Nat → Nat → Nat
  | knd, .lf, x0a, x0b, x1a, x1b, x2a, x2b =>
      let k0 := ((pa - x0b - 2 * x1b - x2b) * K_grid) / x1b
      let k1 := ((pb - x0a - 2 * x1a - x2a) * K_grid) / x1a
      let u := ub k0 k1
      match knd with
      | .box   => u * (wInv x0a x0b * wInvSq x1a x1b * wInv x2a x2b)
      | .tri01 => u * (wDiag01 x0a x0b * wInv x2a x2b)
      | .tri12 => u * (wInv x0a x0b * wDiag12 x1a x1b)
      | .simp  => u * wDiag012 x0a x0b
  | knd, .s0 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x0a + x0b) / 2
      evalTreeWith ub pa pb knd l x0a m x1a x1b x2a x2b +
      evalTreeWith ub pa pb knd r m x0b x1a x1b x2a x2b
  | knd, .s1 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x1a + x1b) / 2
      evalTreeWith ub pa pb knd l x0a x0b x1a m x2a x2b +
      evalTreeWith ub pa pb knd r x0a x0b m x1b x2a x2b
  | knd, .s2 l r, x0a, x0b, x1a, x1b, x2a, x2b =>
      let m := (x2a + x2b) / 2
      evalTreeWith ub pa pb knd l x0a x0b x1a x1b x2a m +
      evalTreeWith ub pa pb knd r x0a x0b x1a x1b m x2b
  | _, .sd01 c0 mm c1, a, b, _, _, x2a, x2b =>
      let m := (a + b) / 2
      evalTreeWith ub pa pb .tri01 c0 a m a m x2a x2b +
      evalTreeWith ub pa pb .box mm a m m b x2a x2b +
      evalTreeWith ub pa pb .tri01 c1 m b m b x2a x2b
  | _, .sd12 c0 mm c1, x0a, x0b, a, b, _, _ =>
      let m := (a + b) / 2
      evalTreeWith ub pa pb .tri12 c0 x0a x0b a m a m +
      evalTreeWith ub pa pb .box mm x0a x0b a m m b +
      evalTreeWith ub pa pb .tri12 c1 x0a x0b m b m b
  | _, .sd012 c0 m01 m12 c1, a, b, _, _, _, _ =>
      let m := (a + b) / 2
      evalTreeWith ub pa pb .simp c0 a m a m a m +
      evalTreeWith ub pa pb .tri01 m01 a m a m m b +
      evalTreeWith ub pa pb .tri12 m12 a m m b m b +
      evalTreeWith ub pa pb .simp c1 m b m b m b

