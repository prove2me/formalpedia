theorem crHalts_mono (P : Program) (E : RAMEnv) (T U : ℝ) (s out : RAMState)
    (h : HaltsWithin P E T s out) (hTU : T ≤ U) : HaltsWithin P E U s out := by
  obtain ⟨k, hCost, hRun, hHalt⟩ := h
  exact ⟨k, hCost.trans hTU, hRun, hHalt⟩
def crSourceRaise (S : CRSourceBundle) (K : ℝ) (hK : S.K ≤ K) : CRSourceBundle where
  progUp := S.progUp
  progDec := S.progDec
  K := K
  cW := S.cW
  K_pos := S.K_pos.trans_le hK
  cW_pos := S.cW_pos
  data := S.data
  invalid := S.invalid
  spec := by
    intro N t hN ht
    have h := S.spec N t hN ht
    have hColumn : S.K * lg ((N : ℝ) + 2) ^ 2 ≤ K * lg ((N : ℝ) + 2) ^ 2 :=
      mul_le_mul_of_nonneg_right hK (sq_nonneg _)
    have hTime : S.K * max 1 ((t : ℝ) * lg ((t : ℝ) + 2) * lg ((N : ℝ) + 2)) ≤
        K * max 1 ((t : ℝ) * lg ((t : ℝ) + 2) * lg ((N : ℝ) + 2)) :=
      mul_le_mul_of_nonneg_right hK ((show (0 : ℝ) ≤ 1 by norm_num).trans (le_max_left _ _))
    refine ⟨h.1, h.2.1, ?_, ?_, ?_, ?_⟩
    · exact h.2.2.1.trans (mul_le_mul_of_nonneg_right hK
        (mul_nonneg (Nat.cast_nonneg _) (sq_nonneg _)))
    · intro i
      exact (h.2.2.2.1 i).trans hColumn
    · intro y i
      obtain ⟨out, hRun, hOut⟩ := h.2.2.2.2.1 y i
      exact ⟨out, crHalts_mono _ _ _ _ _ _ hRun hColumn, hOut⟩
    · intro x hx
      obtain ⟨out, hRun, hOut⟩ := h.2.2.2.2.2 x hx
      exact ⟨out, crHalts_mono _ _ _ _ _ _ hRun hTime, hOut⟩
def crSourceCovered (S : CRSourceBundle) : CRSourceBundle :=
  crSourceRaise S (max S.K S.cW) (le_max_left _ _)
theorem crSourceCovered_word (S : CRSourceBundle) :
    (crSourceCovered S).cW ≤ (crSourceCovered S).K := le_max_right _ _
end LinearSetReconciliation327.Main
