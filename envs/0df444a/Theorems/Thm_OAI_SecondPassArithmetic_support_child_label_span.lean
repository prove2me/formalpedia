variable {ι : Type*} [DecidableEq ι]
  (p : ι → OAI.SecondPassArithmetic.O) (hp : ∀ i, p i ≠ 0) [∀ i, (Ideal.span {p i}).IsMaximal]
  (hcop : Pairwise (Function.onFun IsCoprime (fun i => Ideal.span {p i})))
  (hg : ∀ i, lambda ∉ Ideal.span {p i})
omit [DecidableEq ι] [∀ (i : ι), (span {p i}).IsMaximal]

theorem OAI.SecondPassArithmetic.support_child_label_span (x : OldTuple) (V : Finset ι)
    (hV : (∏ i ∈ V, Ideal.span {p i}) = x.v) :
    Ideal.span {idealGenerator (x.core 0) * idealGenerator (x.core 1) *
      idealGenerator (x.core 2) * ∏ i ∈ V, p i} = newLabel x := by sorry
