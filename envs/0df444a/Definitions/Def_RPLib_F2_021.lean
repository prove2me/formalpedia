-- ===== S4.Def_RP_CdOne_C1 =====
section

/-!
# S4-PD (3)(iii), part C: the field `E₀` generated by the constants is C1 (Tsen)

`K` algebraic over `𝔽_q(t)` (`[Algebra.IsAlgebraic (RatFunc Fq) K]`), `q = #𝔽_q = p ^ e`. Then
`E₀ = constFieldU A K q ⊆ K_U` contains `𝔽̄_q` (`constEmb`) and is algebraic over `𝔽̄_q(t)` with `t` transcendental,
so it is C1 by Tsen (`isC1_constFieldU`), and so is every finite extension (`allC1_constFieldU`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson.CdOne

open IntermediateField RamanujanPetersson.Tsen RamanujanPetersson.CurveCoh RamanujanPetersson.Kummer Polynomial

/-- Tsen, abstract form: a field algebraic over `k(t)`, `k` algebraically closed, `t` transcendental, is C1. -/
theorem isC1_of_transcendental (k M : Type*) [Field k] [IsAlgClosed k] [Field M] [Algebra k M] (t : M)
    (ht : Transcendental k t) [Algebra.IsAlgebraic (adjoin k {t}) M] : IsC1 M := by
  let e := RatFunc.algEquivOfTranscendental t ht
  let _ : Algebra (RatFunc k) (adjoin k {t}) := e.toRingEquiv.toRingHom.toAlgebra
  have : Algebra.IsAlgebraic (RatFunc k) (adjoin k {t}) := ⟨fun x => by
    have h2 : algebraMap (RatFunc k) (adjoin k {t}) (e.symm x) = x := e.apply_symm_apply x
    exact h2 ▸ isAlgebraic_algebraMap _⟩
  exact (tsen k (adjoin k {t})).of_algebraic

/-- Every element of `𝔽̄_q` is a constant: `c ^ (q ^ n) = c` for some `n > 0`. -/
theorem exists_pow_card_pow_eq (Fq : Type*) [Field Fq] [Fintype Fq] (c : AlgebraicClosure Fq) :
    ∃ n : ℕ, 0 < n ∧ c ^ Fintype.card Fq ^ n = c := by
  have hc : IsIntegral Fq c := (Algebra.IsAlgebraic.isAlgebraic c).isIntegral
  have : FiniteDimensional Fq (adjoin Fq {c}) := adjoin.finiteDimensional hc
  let _ : Fintype (adjoin Fq {c}) := Module.fintypeOfFintype (Module.finBasis Fq (adjoin Fq {c}))
  refine ⟨Module.finrank Fq (adjoin Fq {c}), Module.finrank_pos, ?_⟩
  have h1 := FiniteField.pow_card (⟨c, mem_adjoin_simple_self Fq c⟩ : adjoin Fq {c})
  rw [Module.card_eq_pow_finrank (K := Fq)] at h1
  have h2 := congrArg (fun x : adjoin Fq {c} => (x : AlgebraicClosure Fq)) h1
  simp only [SubmonoidClass.coe_pow] at h2
  exact h2

section Const

variable (A K : Type) [CommRing A] [Field K] [Algebra A K] {p : ℕ} [Fact p.Prime] [CharP K p]
  (Fq : Type) [Field Fq] [Fintype Fq] [Algebra Fq K] {e : ℕ} (he : 0 < e) (hq : Fintype.card Fq = p ^ e)

/-- The embedding `𝔽̄_q → K̄` over `𝔽_q`. -/
noncomputable def fqBar : AlgebraicClosure Fq →ₐ[Fq] AlgebraicClosure K := IsAlgClosed.lift

include hq in
theorem fqBar_isConst (c : AlgebraicClosure Fq) : IsConst (p ^ e) (fqBar K Fq c) := by
  obtain ⟨n, hn, h⟩ := exists_pow_card_pow_eq Fq c
  rw [hq] at h
  exact IsConst.map (fqBar K Fq) ⟨n, hn, h⟩

include he hq in
theorem fqBar_mem_maxUnram (c : AlgebraicClosure Fq) : fqBar K Fq c ∈ maxUnram A K :=
  mem_maxUnram_of_isConst (A := A) (K := K) (p := p) he (fqBar_isConst K Fq hq c)

include he hq in
theorem fqBar_mem_constFieldU (c : AlgebraicClosure Fq) :
    (⟨fqBar K Fq c, fqBar_mem_maxUnram A K Fq he hq c⟩ : maxUnram A K) ∈ constFieldU A K (p ^ e) := by
  obtain ⟨n, hn, h⟩ := fqBar_isConst K Fq hq c
  exact IntermediateField.subset_adjoin _ _ ⟨n, hn, Subtype.ext h⟩

/-- `𝔽̄_q ⊆ E₀`. -/
noncomputable def constEmb : AlgebraicClosure Fq →+* constFieldU A K (p ^ e) where
  toFun c := ⟨⟨fqBar K Fq c, fqBar_mem_maxUnram A K Fq he hq c⟩, fqBar_mem_constFieldU A K Fq he hq c⟩
  map_one' := Subtype.ext (Subtype.ext (map_one (fqBar K Fq)))
  map_mul' x y := Subtype.ext (Subtype.ext (map_mul (fqBar K Fq) x y))
  map_zero' := Subtype.ext (Subtype.ext (map_zero (fqBar K Fq)))
  map_add' x y := Subtype.ext (Subtype.ext (map_add (fqBar K Fq) x y))

/-- The inclusion `E₀ → K̄`. -/
noncomputable def nuE : constFieldU A K (p ^ e) →ₐ[K] AlgebraicClosure K :=
  (maxUnram A K).val.comp (constFieldU A K (p ^ e)).val

variable [Algebra (RatFunc Fq) K] [IsScalarTower Fq (RatFunc Fq) K] [Algebra.IsAlgebraic (RatFunc Fq) K]

include he hq in
/-- `E₀` is C1 (Tsen). -/
theorem isC1_constFieldU : IsC1 (constFieldU A K (p ^ e)) := by
  classical
  set E₀ := constFieldU A K (p ^ e)
  set ι := constEmb A K Fq he hq
  let _ : Algebra (AlgebraicClosure Fq) E₀ := ι.toAlgebra
  set θ : RatFunc Fq →+* E₀ := (algebraMap K E₀).comp (algebraMap (RatFunc Fq) K)
  set t : E₀ := θ RatFunc.X
  -- `t` is transcendental over `𝔽̄_q`
  have htr : Transcendental (AlgebraicClosure Fq) t := by
    rintro ⟨P, hP, hev⟩
    let _ : Algebra (AlgebraicClosure Fq) (AlgebraicClosure K) := (fqBar K Fq).toRingHom.toAlgebra
    have : IsScalarTower Fq (AlgebraicClosure Fq) (AlgebraicClosure K) :=
      IsScalarTower.of_algebraMap_eq fun a => ((fqBar K Fq).commutes a).symm
    set x0 : K := algebraMap (RatFunc Fq) K RatFunc.X
    have hA : IsAlgebraic (AlgebraicClosure Fq) (algebraMap K (AlgebraicClosure K) x0) := by
      refine ⟨P, hP, ?_⟩
      have h1 := congrArg (nuE A K) hev
      rw [aeval_def, RingHom.algebraMap_toAlgebra, map_zero, ← AlgHom.coe_toRingHom, hom_eval₂] at h1
      rw [aeval_def, RingHom.algebraMap_toAlgebra]
      exact h1
    have hB : IsAlgebraic Fq (algebraMap K (AlgebraicClosure K) x0) := IsAlgebraic.restrictScalars (R := Fq) hA
    have hC : IsAlgebraic Fq x0 :=
      (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom Fq K (AlgebraicClosure K))
        (algebraMap K (AlgebraicClosure K)).injective).1 hB
    have hD : IsAlgebraic Fq (RatFunc.X : RatFunc Fq) :=
      (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom Fq (RatFunc Fq) K)
        (algebraMap (RatFunc Fq) K).injective).1 hC
    exact RatFunc.transcendental_X hD
  set F₀ := adjoin (AlgebraicClosure Fq) {t}
  -- step 1: `θ (𝔽_q(t)) ⊆ F₀`
  have hcst : ∀ a : Fq, θ (algebraMap Fq (RatFunc Fq) a) ∈ F₀ := fun a => by
    have h : θ (algebraMap Fq (RatFunc Fq) a) = algebraMap (AlgebraicClosure Fq) E₀ (algebraMap Fq _ a) := by
      apply Subtype.ext; apply Subtype.ext
      show algebraMap K (AlgebraicClosure K) (algebraMap (RatFunc Fq) K (algebraMap Fq (RatFunc Fq) a)) =
        fqBar K Fq (algebraMap Fq (AlgebraicClosure Fq) a)
      rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply, AlgHom.commutes]
    rw [h]
    exact F₀.algebraMap_mem _
  let S : IntermediateField Fq (RatFunc Fq) :=
    Subfield.toIntermediateField (F₀.toSubfield.comap θ) hcst
  have hS : ∀ r, θ r ∈ F₀ := by
    have hle : adjoin Fq {(RatFunc.X : RatFunc Fq)} ≤ S :=
      adjoin_simple_le_iff.2 (show θ RatFunc.X ∈ F₀ from mem_adjoin_simple_self _ t)
    rw [RatFunc.adjoin_X] at hle
    exact fun r => hle (Set.mem_univ r)
  -- step 2: `K ⊆ E₀` is integral over `F₀`
  have hK : ∀ y : K, IsIntegral F₀ (algebraMap K E₀ y) := fun y =>
    IsIntegral.map_of_comp_eq (θ.codRestrict F₀ hS) (algebraMap K E₀) (RingHom.ext fun _ => rfl)
      (Algebra.IsAlgebraic.isAlgebraic y).isIntegral
  -- step 3 and 4: `E₀` is algebraic over `F₀ (K)`, which is algebraic over `F₀`
  set L₁ := adjoin F₀ (Set.range (algebraMap K E₀))
  have : Algebra.IsAlgebraic F₀ L₁ := isAlgebraic_adjoin (by rintro _ ⟨y, rfl⟩; exact hK y)
  have hx : ∀ x : E₀, IsAlgebraic F₀ x := fun x => by
    have h1 : IsIntegral K x := (isIntegral_algHom_iff (nuE A K) (Subtype.val_injective.comp
      Subtype.val_injective)).1 (Algebra.IsIntegral.isIntegral _)
    have h2 : IsIntegral L₁ x :=
      IsIntegral.map_of_comp_eq ((algebraMap K E₀).codRestrict L₁ fun y => subset_adjoin _ _ ⟨y, rfl⟩)
        (RingHom.id E₀) (RingHom.ext fun _ => rfl) h1
    exact IsAlgebraic.restrictScalars (R := F₀) (S := L₁) h2.isAlgebraic
  have : Algebra.IsAlgebraic F₀ E₀ := ⟨hx⟩
  exact isC1_of_transcendental (AlgebraicClosure Fq) E₀ t htr

end Const

end RamanujanPetersson.CdOne


end


