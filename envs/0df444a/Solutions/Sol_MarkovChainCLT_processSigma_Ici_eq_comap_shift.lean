import Definitions.Def_MixingCoefficients

open MeasureTheory MeasurableSpace
open MarkovChainCLT

set_option maxHeartbeats 1000000

/-- The σ-algebra generated by the coordinates from time `m` on is the one pulled back
along the `m`-shift. -/
theorem solution {X : Type*} [MeasurableSpace X] (m : ℕ) :
    processSigma (fun i (ω : ℕ → X) => ω i) (Set.Ici m)
      = MeasurableSpace.comap (fun ω : ℕ → X => fun n => ω (m + n)) inferInstance := by
  rw [show (inferInstance : MeasurableSpace (ℕ → X)) = ⨆ a : ℕ,
      MeasurableSpace.comap (fun ω : ℕ → X => ω a) inferInstance from rfl,
    MeasurableSpace.comap_iSup]
  simp only [MeasurableSpace.comap_comp, Function.comp_def]
  refine le_antisymm (iSup₂_le (fun i hi => ?_)) (iSup_le (fun a => ?_))
  · have hi' : m ≤ i := hi
    have hrec : i = m + (i - m) := (Nat.add_sub_cancel' hi').symm
    refine le_iSup_of_le (i - m) ?_
    rw [← hrec]
  · exact le_iSup₂_of_le (m + a) (Nat.le_add_right m a) le_rfl
