-- title:
--   The hierarchical family $\mathcal F$ of Instance 11
-- statement:
--   The downward-closed family generated by a realized tree consists of the leaves and their subsets:
--
--   $$\mathcal F=\{\,S : S\subseteq \text{the bidder set of some depth-}L\text{ node}\,\}.$$
-- source:
--   Afshinmehr, Ascher, Ashuri, Gkatzelis, Mahmoudkhan, Rubinstein, Schoepflin, Tight Approximation Bounds for Clock Auctions, manuscript (STOC 2027 submission; held artifact sha256 29bccd9c…b31b, preprint basis), Instance 11, §6.2, p.35 (PDF p.38)

import Mathlib
import Definitions.Def_TightClock_nodeSet
import Definitions.Def_TightClock_leafNode

set_option autoImplicit false

namespace TightClock

/-- The family `F` of Instance 11: "F ← all subsets of the depth-L nodes". Afshinmehr et al., manuscript
(STOC 2027 submission), Instance 11, §6.2, p.35 (PDF 38). -/
def familyOf {q L : ℕ} (T : Tree q L) : Finset (Finset (Fin (bidderCount q L))) :=
  (Finset.univ.image (fun s : Path q L L => nodeSet T (leafNode s))).biUnion Finset.powerset

end TightClock


