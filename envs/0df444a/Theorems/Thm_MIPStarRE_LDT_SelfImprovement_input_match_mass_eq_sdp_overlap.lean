--       (params : Parameters)
--       [FieldModel params.q]
--       (strategy : SymStrat params ι)
--       (G : SubMeas (Polynomial params) ι) :
--       avgOver (uniformDistribution (Point params)) (fun u =>
--           qBipartiteMatchMass strategy.state
--             ((IdxProjMeas.toIdxSubMeas strategy.pointMeasurement) u)
