private theorem t1009 {F : ℂ → ℂ} (hF : d117 F) {c : ℂ} (hc : c.im = 0) :
    d117 fun s => F (s + c) := by
  intro A B
  obtain ⟨C, D, h⟩ := hF (A + c.re) (B + c.re)
  refine ⟨C, D, fun s ha hb => ?_⟩
  have hre : (s + c).re = s.re + c.re := Complex.add_re s c
  have him : (s + c).im = s.im := by rw [Complex.add_im, hc, add_zero]
  have := h (s + c) (by rw [hre]; linarith) (by rw [hre]; linarith)
