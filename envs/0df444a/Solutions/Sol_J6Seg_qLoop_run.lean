theorem encK_split (s : IState HS) {K H G : Fin HS → List ℤ} (h : ∀ j, K j = H j ++ G j) :
    encK s K = encK (encK s G) H := by
  refine IState.ext' (fun j => ?_) rfl rfl
  simp [h j, NLogN.ints_append]

/-- A `RowBody6` call on any managed state. -/
theorem row_call {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {e : Fin Pp}
    {dT : Fin HS} {tabOf : ℕ → List ℤ} {Pre : List GI → Prop} {g : ℕ → List GI → List GI}
    {C : ℝ} (hR : RowBody6 Isym tbl e dT tabOf Pre g C) (hT0 : dT ≠ 0)
    (q : ℕ) (s : IState HS) (G : Fin HS → List ℤ) (x : List GI) (l : List ℤ)
    (hT : G dT = tabOf q) (h0 : G 0 = gflat x ++ l) (hx : Pre x) :
    ∃ c : ℕ, IRuns Isym tbl (.call e) (encK s G)
        (encK s (update G 0 (gflat (g q x) ++ l))) c ∧ (c : ℝ) ≤ C := by
  set H : Fin HS → List ℤ := fun j => if j = 0 then G 0 else if j = dT then G dT else [] with hH
  set Gb : Fin HS → List ℤ := fun j => if j = 0 then [] else if j = dT then [] else G j with hGb
  have hk : ∀ j, G j = H j ++ Gb j := by
    intro j
    by_cases h1 : j = 0
    · subst h1; simp [hH, hGb]
    by_cases h2 : j = dT
    · subst h2; simp [hH, hGb, h1]
    · simp [hH, hGb, h1, h2]
  have hs : ∀ v : List ℤ, ∀ j, update G 0 v j = update H 0 v j ++ Gb j := by
    intro v j
    by_cases h1 : j = 0
    · subst h1; simp [hGb]
    · simp only [update_of_ne h1]; exact hk j
  obtain ⟨c, r, k⟩ := hR q (encK s Gb) H x l (fun j hj0 hjT => by simp [hH, hj0, hjT])
    (by simp [hH, hT0, hT]) (by simp [hH, h0]) hx
  rw [encK_split s hk, encK_split s (hs _)]
  exact ⟨c, r, k⟩

