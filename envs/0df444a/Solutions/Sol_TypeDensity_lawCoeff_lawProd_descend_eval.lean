theorem solution (l : List (ℕ × TypeDensity.State)) (hδ : ∀ z ∈ l, 0 < z.1)
    (σ : TypeDensity.FactorType) (q : ℚ) :
    (TypeDensity.lawCoeff (TypeDensity.lawProd (l.map fun z => TypeDensity.lawDescend z.1 (TypeDensity.stateLaw z.2))) σ).eval q =
    ∑ τ ∈ Fintype.piFinset (fun j : Fin l.length => ((TypeDensity.stateLaw (l.get j).2).map Prod.fst).toFinset),
      (if σ = ∑ j, TypeDensity.scaleType (l.get j).1 (τ j) then
        ∏ j, (TypeDensity.lawCoeff (TypeDensity.stateLaw (l.get j).2) (τ j)).eval (q ^ (l.get j).1) else 0) := by
  have h := TypeDensity.law_coeff_prod_descend (l.map fun z => (z.1, TypeDensity.stateLaw z.2))
    (by intro z hz; obtain ⟨w, hw, rfl⟩ := List.mem_map.1 hz; exact hδ w hw) σ q
  rw [List.map_map] at h
  rw [show ((fun z : ℕ × TypeDensity.Law => TypeDensity.lawDescend z.1 z.2) ∘ fun z : ℕ × TypeDensity.State => (z.1, TypeDensity.stateLaw z.2)) =
    (fun z => TypeDensity.lawDescend z.1 (TypeDensity.stateLaw z.2)) from rfl] at h
  have hl : (l.map fun z => (z.1, TypeDensity.stateLaw z.2)).length = l.length := List.length_map _
  have hg : (l.map fun z => (z.1, TypeDensity.stateLaw z.2)).get =
      fun j => ((l.get (Fin.cast hl j)).1, TypeDensity.stateLaw (l.get (Fin.cast hl j)).2) := by
    funext j; simp
  rw [hg] at h
  rw [h]
  exact TypeDensity.piFinset_sum_reindex σ q hl (fun j => ((l.get j).1, TypeDensity.stateLaw (l.get j).2))
