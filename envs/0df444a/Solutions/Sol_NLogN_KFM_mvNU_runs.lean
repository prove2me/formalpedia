-- Source module: Solutions.KFMMv
/-!
# KFM: counted moves and the conjugation pass

* **`mvNU Cn X Y`**: move `N` items (count on `Cn`) from `X` to `Y` (`mvNU_runs`: the moved block
  arrives reversed). Two of them move a block in order (`mv2_runs`).
* **`conjPU`**: `zs ↦ zs.map gconj` on stack `0` (`N` Gaussian items, counts `N` on `nX` and `2N`
  on `nX2`), as KFM's `itemPU` with a two-item body (`conjPU_runs`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxRecDepth 20000

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem mvNU_runs_sol_aux {Cn X Y : Fin HS} (h : MvOk Cn X Y) (L : List ℤ) (B : ℕ)
    (hB : ∀ x ∈ L, zsz x ≤ B) (s : IState HS) (LX LC : List Item)
    (hX : s.G X = ints L ++ LX) (hC : s.G Cn = .int (L.length : ℤ) :: LC) :
    IRuns I iprog (mvNU Cn X Y) s ((s.upd X LX).upd Y (ints L.reverse ++ s.G Y))
      (cMvN L.length B) := by
  obtain ⟨hXY, ⟨hXA, hXC, hXD⟩, ⟨hYA, hYC, hYD⟩, ⟨hCA, hCX, hCY⟩⟩ := h
  let T : ℕ → IState HS := fun k =>
    (s.upd X (ints (L.drop k) ++ LX)).upd Y (ints (L.take k).reverse ++ s.G Y)
  have hr := rptX_runs (I := I) (iprog := iprog) (X := Cn) (A := pA) (C := pC) (D := pD) hCA
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    L.length T
    (fun k => by simp [T, IState.upd_G, Ne.symm hXA, Ne.symm hYA])
    (fun k => by simp [T, IState.upd_G, Ne.symm hXC, Ne.symm hYC])
    (fun k => by simp [T, IState.upd_G, Ne.symm hXD, Ne.symm hYD])
    (.op (.mv X Y)) (110 * (B + 1))
    (by
      intro k hk LA LC' LD
      have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hz := hB _ (List.getElem_mem hk)
      have H := IRuns.mv (I := I) (iprog := iprog) (s := cf3 (T k) pA pC pD LA LC' LD) (i := X)
        (j := Y) (a := L[k]) (L := ints (L.drop (k + 1)) ++ LX) hXY
        (by
          simp only [T, cf3, IState.upd_G, if_neg hXA, if_neg hXC, if_neg hXD, if_neg hXY,
            if_pos rfl, ↓reduceIte, hd]
          simp only [ints, List.map_cons, List.cons_append])
      refine H.mono' ?_ ?_
      · have ht : L.take (k + 1) = L.take k ++ [L[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hk]; rfl
        have e2 : ints (L.take (k + 1)).reverse = .int L[k] :: ints (L.take k).reverse := by
          rw [ht, List.reverse_append]; simp [ints]
        simp only [T, cf3, e2]
        clear H e2 ht hd
        apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
          split_ifs <;> simp_all
      · have := moveIntCost_le (zsz L[k]); omega)
  have hr := hr LC (by simp [T, IState.upd_G, hCX, hCY, hC])
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, List.reverse_nil]
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all [ints]
  have e1 : T L.length = (s.upd X LX).upd Y (ints L.reverse ++ s.G Y) := by
    simp only [T, List.drop_length, List.take_length]; simp [ints]
  rw [e0, e1] at hr
  exact hr

/-! ## Conjugation pass -/

