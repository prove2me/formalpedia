section
-- Source module: Solutions.J6SegILPreJD2
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D2: the pattern elimination stage (program)

`elQ`: one pivot `q` (on `1`): `3 := m²`; for `x < m²` push `Mseq (q+1)` at `x` onto `16`
(`elB`); pop the old matrix off `14`; move `16` back onto `14` (row-major again).
`elimP = forL 50 28 1 elQ`, and **`Rn.elimP`**: from `c 14 = matL (Mseq 0) m` to
`matL (Mseq m) m`, registers outside `1–8, 29` unchanged, at cost `cElim W m`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-- The registers the stage writes. -/
def scR : List (Fin HS) := [1, 2, 3, 4, 5, 6, 7, 8, 29]

/-- `u` agrees with `v` outside `scR`. -/
def Fr (v u : Vr) : Prop := ∀ j, j ∉ scR → u j = v j

/-- Pop one entry of the old matrix. -/
def poB : List Ins := [.po 14]

/-- The square of `m`. -/
def sqE : E := .mul (.r 28) (.r 28)

/-- **One pivot.** -/
def elQ : RS := .seq (.asg 3 sqE.ex)
  (.seq (forL 51 3 2 (progL elB)) (.seq (forL 51 3 2 (progL poB)) (mvK 16 14 48 (.reg 3))))

/-- **The pattern elimination stage.** -/
def elimP : RS := forL 50 28 1 elQ

/-- The cost of the final move of `n` entries. -/
def cMvE (W n : ℕ) : ℕ := 2 * 2000 * (W + 1 + 2) + n * (14000 * (W + 1 + 2)) + 32

/-- The cost of one pivot. -/
def cQ (W m : ℕ) : ℕ := cT sqE.ex W + (cFor W (m * m) (costL W (m * m + m) elB) +
  (cFor W (m * m) (costL W (m * m + m) poB) + cMvE W (m * m)))

/-- **The cost of the stage.** -/
def cElim (W m : ℕ) : ℕ := cFor W m (cQ W m)

/-! ## The cost bound -/

/-- The size of the expression of an instruction (`en` counts as too large). -/
def Ins.sz : Ins → ℕ
  | .a _ e => e.ex.size
  | .rd _ e _ => e.ex.size
  | .pu _ e => e.ex.size
  | .po _ => 0
  | .en .. => 10000

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD3
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D3: conditionals, and the serialization programs

* `Rn.iteE`: `ite e a b` on the register file (`e : E`);
* the serialization stage `serP` (backward records `bPart`, then forward rows `fPart`), pushing
  onto stack `41`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-- The extra cost of a conditional at width `W`. -/
def cIte (e : E) (W : ℕ) : ℕ := cT e.ex W + (2 * ((W + 1) * (2 * e.ex.size)) + 2) + 25

/-! ## The serialization programs -/

/-- `q = m - 1 - j` (`j` on `2`). -/
def qzE : E := .sub (.sub (.r 28) (.k 1)) (.r 2)
/-- `q = r + 1 + (Wb - 1 - i)` (`r` on `1`, `Wb` on `3`, `i` on `2`). -/
def qbE : E := .add (.add (.r 1) (.k 1)) (.sub (.sub (.r 3) (.k 1)) (.r 2))
/-- `q = r - cw + i` (`r` on `5`, `cw` on `3`, `i` on `2`). -/
def qfE : E := .add (.sub (.r 5) (.r 3)) (.r 2)

/-- Head of a backward record: flag, reciprocal, pivot. -/
def bHead : List Ins :=
  [.rd 30 (.r 1) 4, .a 5 (.sub (.k 1) (ltE (.r 4) (.r 12))), .pu 41 (.r 5),
   .a 22 (.add (.r 22) (.r 5)), .rd 14 (.add (.mul (.r 1) (.r 28)) (.r 1)) 6,
   .pu 41 (.dv (.r 21) (.mul (.k 2) (.r 6))), .pu 41 (.r 6), .a 3 (.k 0)]

/-- Border scan: reads and the condition. -/
def czI : List Ins :=
  [.rd 30 qzE 7, .rd 14 (.add (.mul (.r 1) (.r 28)) qzE) 8,
   .a 6 (.mul (ltE (.r 1) qzE) (.sub (.k 1) (ltE (.r 7) (.r 12))))]

/-- Border push. -/
def czT : List Ins :=
  [.pu 41 (.sel (.sub (bSE (.r 4) (.r 7)) (.k 1)) (.k 0) (.r 8)), .a 3 (.add (.r 3) (.k 1))]

/-- The border-scan body. -/
def czB : RS := .seq (progL czI) (.ite (E.sub (.r 6) (.k 1)).ex .skip (progL czT))

/-- After the border scan. -/
def bMid : List Ins :=
  [.pu 41 (.r 3), .a 23 (.add (.r 23) (.add (.r 3) (.add (.k 2) (.k 2)))), .a 3 (.k 0)]

/-- Band-window count body. -/
def wbI : List Ins :=
  [.rd 30 (.r 2) 7,
   .a 3 (.add (.r 3) (.mul (ltE (.r 1) (.r 2)) (.sub (.k 1) (ltE (.add (.r 4) (.r 11)) (.r 7)))))]

/-- Band-window push body. -/
def cbI : List Ins :=
  [.rd 30 qbE 7, .rd 14 (.add (.mul (.r 1) (.r 28)) qbE) 8,
   .pu 41 (.sel (.sub (.mul (ltE (.r 7) (.r 12)) (bSE (.r 4) (.r 7))) (.k 1)) (.k 0) (.r 8))]

/-- After the band window. -/
def bTail : List Ins := [.pu 41 (.r 3), .a 23 (.add (.r 23) (.add (.r 3) (.k 1)))]

/-- **One backward record** (row `r` on `1`), reversed onto `41`. -/
def bBody : RS :=
  .seq (progL bHead) (.seq (forL 51 28 2 czB) (.seq (progL bMid) (.seq (forL 51 28 2 (progL wbI))
    (.seq (forL 51 3 2 (progL cbI)) (progL bTail)))))

/-- Head of a forward row (`r = m - 1 - r'`). -/
def fHead : List Ins := [.a 5 (.sub (.sub (.r 28) (.k 1)) (.r 1)), .rd 30 (.r 5) 4, .a 3 (.k 0)]

/-- Forward-window count body. -/
def cnI : List Ins :=
  [.rd 30 (.r 2) 7,
   .a 3 (.add (.r 3) (.mul (ltE (.r 2) (.r 5)) (.sub (.k 1) (ltE (.add (.r 7) (.r 11)) (.r 4)))))]

/-- The forward window: the count, or `r` on the border. -/
def fMid : List Ins := [.a 3 (.sel (.sub (.r 4) (.r 12)) (.r 3) (.r 5))]

/-- Forward push body. -/
def fsI : List Ins :=
  [.rd 30 qfE 7, .rd 14 (.add (.mul (.r 5) (.r 28)) qfE) 6, .rd 14 (.add (.mul qfE (.r 28)) qfE) 8,
   .pu 41 (.sel (.sub (bSE (.r 4) (.r 7)) (.k 1)) (.k 0) (fdE (.r 6) (.r 8)))]

/-- After a forward row. -/
def fTail : List Ins := [.pu 41 (.r 3), .a 23 (.add (.r 23) (.add (.r 3) (.k 1)))]

/-- **One forward row**, reversed onto `41`. -/
def fBody : RS :=
  .seq (progL fHead) (.seq (forL 51 28 2 (progL cnI)) (.seq (progL fMid)
    (.seq (forL 51 3 2 (progL fsI)) (progL fTail))))

/-- **The serialization stage.** -/
def serP : RS :=
  .seq (progL [.a 22 (.k 0), .a 23 (.k 0)]) (.seq (forL 50 28 1 bBody) (forL 50 28 1 fBody))

/-! ## What is pushed -/

section spec
variable (Q kk m mw cB : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ)

/-- Border flag of row `r`. -/
def flg (r : ℕ) : ℤ := if cB ≤ Lg L r then 1 else 0

/-- The border coefficient pushed at scan step `j` of row `r` (if any). -/
def czF (r j : ℕ) : Option ℤ :=
  if r < m - 1 - j ∧ cB ≤ Lg L (m - 1 - j) then
    some (if bandS mw cB (Lg L r) (Lg L (m - 1 - j)) then Mf r (m - 1 - j) else 0) else none

/-- Pushed border coefficients of row `r` (decreasing `q`). -/
def czP (r : ℕ) : List ℤ := (List.range m).filterMap (czF m mw cB L Mf r)

/-- The band-window condition. -/
def wbC (r q : ℕ) : Prop := r < q ∧ Lg L q ≤ Lg L r + mw

instance (r q : ℕ) : Decidable (wbC mw L r q) := by unfold wbC; infer_instance

/-- Band window of row `r`. -/
def wbN (r : ℕ) : ℕ := ((List.range m).filter fun q => wbC mw L r q).length

/-- The band coefficient pushed at step `i` of row `r` with window `Wb`. -/
def cbF (r Wb i : ℕ) : ℤ :=
  if ¬ cB ≤ Lg L (r + 1 + (Wb - 1 - i)) ∧ bandS mw cB (Lg L r) (Lg L (r + 1 + (Wb - 1 - i)))
  then Mf r (r + 1 + (Wb - 1 - i)) else 0

/-- Pushed band coefficients of row `r` (decreasing offset). -/
def cbP (r : ℕ) : List ℤ := (List.range (wbN m mw L r)).map (cbF mw cB L Mf r (wbN m mw L r))

/-- One backward record, as pushed. -/
def recP (r : ℕ) : List ℤ :=
  [flg cB L r, 2 ^ kk / (2 * Mf r r), Mf r r] ++ czP m mw cB L Mf r ++
    [((czP m mw cB L Mf r).length : ℤ)] ++ cbP m mw cB L Mf r ++ [(wbN m mw L r : ℤ)]

/-- The forward-window condition. -/
def cwC (r q : ℕ) : Prop := q < r ∧ Lg L r ≤ Lg L q + mw

instance (r q : ℕ) : Decidable (cwC mw L r q) := by unfold cwC; infer_instance

/-- Forward window of row `r`. -/
def cwN (r : ℕ) : ℕ :=
  if cB ≤ Lg L r then r else ((List.range m).filter fun q => cwC mw L r q).length

/-- The forward coefficient pushed at step `i` of row `r` with window `cw`. -/
def fsF (r cw i : ℕ) : ℤ :=
  if bandS mw cB (Lg L r) (Lg L (r - cw + i)) then
    fdiv Q (Mf r (r - cw + i)) (Mf (r - cw + i) (r - cw + i)) else 0

/-- Pushed forward coefficients of row `r` (increasing `q`). -/
def fsP (r : ℕ) : List ℤ := (List.range (cwN m mw cB L r)).map (fsF Q mw cB L Mf r (cwN m mw cB L r))

/-- One forward row, as pushed. -/
def rowP (r : ℕ) : List ℤ := fsP Q m mw cB L Mf r ++ [(cwN m mw cB L r : ℤ)]

/-- Everything pushed, in order. -/
def serL : List ℤ := (List.range m).flatMap (recP kk m mw cB L Mf) ++
  (List.range m).flatMap (fun r' => rowP Q m mw cB L Mf (m - 1 - r'))

end spec

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD4
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D4: the straight-line pieces of `serP`

For each instruction list of `serP` (`bHead`, `czI`, `czT`, `bMid`, `wbI`, `cbI`, `bTail`,
`fHead`, `cnI`, `fMid`, `fsI`, `fTail`): its run on the register file, as an `Rn` with the
registers it sets, the stack it pushes onto (`41`), and the registers it leaves alone.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-- The fixed registers of the stage. -/
def Fx (Q kk m mw cB : ℕ) (u : Vr) : Prop :=
  u 9 = 2 ^ Q ∧ u 10 = 2 ^ (Q + 1) ∧ u 11 = mw ∧ u 12 = cB ∧ u 21 = 2 ^ kk ∧ u 28 = m

/-- The stacks the stage reads: the matrix on `14`, the lines on `30`. -/
def StS (m : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) (c : Cs) : Prop :=
  c 14 = matL Mf m ∧ c 30 = L.map (fun j : ℕ => (j : ℤ))

/-- The bounds the stage needs. -/
def BdS (W m : ℕ) (L : List ℕ) (Mf : ℕ → ℕ → ℤ) : Prop :=
  1 ≤ W ∧ m * m + m ≤ 2 ^ W ∧ (∀ j ∈ L, j ≤ 2 ^ W) ∧ (∀ i < m, ∀ k < m, |Mf i k| ≤ 2 ^ W)

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD5
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D5: the inner loops of `serP`

`Rn.czL` (border scan), `Rn.wbL` (band-window count), `Rn.cbL` (band-window push),
`Rn.cnL` (forward-window count), `Rn.fsL` (forward push): each as an `Rn` of a `forL` on
stack `51`, pushing its list (reversed) onto `41`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-- The border-scan body cost. -/
def cCz (W m : ℕ) : ℕ :=
  costL W (m * m + m) czI + (cIte (E.sub (.r 6) (.k 1)) W + max 1 (costL W (m * m + m) czT))

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD6
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D6: one backward record, one forward row

`Rn.bBodyS`: `bBody` at row `r` pushes `(recP r).reverse` onto `41`, adds `flg r` to `22` and
`(recP r).length` to `23`; `Rn.fBodyS`: `fBody` at `r' ` pushes `(rowP (m - 1 - r')).reverse` and adds
its length to `23`.
-/

