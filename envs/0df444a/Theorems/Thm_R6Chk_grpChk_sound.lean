open R6Chk
open Matrix Matrix.Module Module
variable {n bad : ℕ}

theorem R6Chk.grpChk_sound (hbad : bad = BADf n) (hn : n ≤ 24) {G : ℕ} (h : grpChk n bad G = true) :
    finrank (ZMod 2) (spanP n (grpV n G).1 (grpV n G).2) = (grpV n G).2 ∧
      NondegF (spanP n (grpV n G).1 (grpV n G).2) ∧
      ∀ p ∈ grpEnts n G, PairOK n p.1 p.2 (grpV n G).1 (grpV n G).2 := by sorry
