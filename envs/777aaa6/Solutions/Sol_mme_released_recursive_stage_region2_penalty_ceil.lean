theorem solution :
    penaltyPotential (n3 2) (m3 2) ≤ ((811224532899964063462387214231132405385310964081000000000000000000000000000000000000 : ℕ) : ℝ)/10^30 := by
  have hc := mme_released_recursive_stage_region2_counts
  unfold penaltyPotential
  have hterm : ∀ r : Fin 88,
      ((n3 2 r : ℕ) : ℝ) * Real.log 2 *
          RecursiveThinSplit.entropyPenalty (fun c ↦ ((m3 2 r c : ℕ) : ℝ) / (n3 2 r : ℝ)) ≤
        ((n3 2 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by
    intro r
    have hcast : (fun c ↦ ((m3 2 r c : ℕ) : ℝ) / ((n3 2 r : ℕ) : ℝ)) =
        fun c ↦ ((alphaG (n3 2) (m3 2) r c : ℚ) : ℝ) := by
      funext c
      unfold alphaG
      push_cast
      ring
    rw [mul_assoc, hcast]
    have h2 : (0 : ℝ) ≤ ((n3 2 r : ℕ) : ℝ) := by positivity
    calc ((n3 2 r : ℕ) : ℝ) * (Real.log 2 * RecursiveThinSplit.entropyPenalty _)
        ≤ ((n3 2 r : ℕ) : ℝ) * (((L3Agg.pgn r : ℕ) : ℝ)/10^30) :=
          mul_le_mul_of_nonneg_left (L3Agg.hpen r) h2
      _ = ((n3 2 r * L3Agg.pgn r : ℕ) : ℝ)/10^30 := by push_cast; ring
