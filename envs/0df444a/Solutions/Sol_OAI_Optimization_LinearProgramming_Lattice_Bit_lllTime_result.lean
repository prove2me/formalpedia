theorem reductionTrace_native {n m : ℕ} (c : ReductionCursor n m) (fuel : ℕ) :
    (c.trace fuel).1.state.b = c.nativeAt fuel := by
  induction fuel generalizing c with
  | zero => rfl
  | succ f ih =>
    rw [nativeAt_succ, ReductionCursor.trace]
    cases hn : c.next with
    | none => rfl
    | some d => exact ih d

end Lattice
