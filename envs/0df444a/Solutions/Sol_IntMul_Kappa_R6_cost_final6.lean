theorem cost_final6_sol_aux (hP : Q.P.Ok) (C18 : ℝ) (hC18 : 0 ≤ C18) (A18 c18 : ℕ)
    (hc : (c18 : ℝ) ≤ C18 * cU6 Q.P Q.n A18) :
    ((c18 + cBody (BN6 Q) (BN6 Q) (Q.p / 6) (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length Q.p Q.h
      D (σ6 Q) (Q.sB D) (Q.tB D) + 2 : ℕ) : ℝ) ≤
      (C18 + Kc * ((Q.P.x : ℝ) + 4) ^ 2) * cU6 Q.P Q.n (A18 + 2) := by
  have hb := body_le6 hQ hD
  set Lp := Real.log Q.p + 1 with hLp
  set Ln := Real.log (IntMul.lg Q.n) + 1 with hLn
  set Nc := Ncost6 Q.P Q.n with hNc
  have hLn1 : 1 ≤ Ln := lgn_ge Q.n
  have hN1 : 1 ≤ Nc := Ncost6_ge_one Q.P hP Q.n
  have hLp1 : 1 ≤ Lp := by
    have : (1 : ℝ) ≤ Q.p := by exact_mod_cast (by have := p_ge6 hQ hD; omega : 1 ≤ Q.p)
    have := Real.log_nonneg this; linarith
  have hLpn : Lp ≤ ((Q.P.x : ℝ) + 4) * Ln := lgp_le Q.P Q.n
  have hp := p_ge6 hQ hD
  have hpR : (384 : ℝ) ≤ Q.p := by exact_mod_cast hp
  have hT1 : (1 : ℝ) ≤ Q.T := by have : 1 ≤ Q.T := Nat.one_le_two_pow; exact_mod_cast this
  have hV : cU6 Q.P Q.n (A18 + 2) = (Q.T : ℝ) * Q.p * Nc * Ln ^ (A18 + 2) := by
    unfold cU6 VP6; rfl
  have hV' : cU6 Q.P Q.n A18 = (Q.T : ℝ) * Q.p * Nc * Ln ^ A18 := by unfold cU6 VP6; rfl
  rw [hV' ] at hc
  rw [hV]
  set W := (Q.T : ℝ) * Q.p * Nc * Ln ^ (A18 + 2) with hW
  have hLA : Ln ^ A18 ≤ Ln ^ (A18 + 2) := pow_le_pow_right₀ hLn1 (by omega)
  have hL2 : Ln ^ 2 ≤ Ln ^ (A18 + 2) := pow_le_pow_right₀ hLn1 (by omega)
  have hTp : (1 : ℝ) ≤ (Q.T : ℝ) * Q.p := one_le_mul_of_one_le_of_one_le hT1 (by linarith)
  have hW1 : 1 ≤ W := by
    have a2 : 1 ≤ Nc * Ln ^ (A18 + 2) := by
      have := one_le_pow₀ (n := A18 + 2) hLn1; nlinarith
    calc (1 : ℝ) = 1 * 1 := by ring
      _ ≤ ((Q.T : ℝ) * Q.p) * (Nc * Ln ^ (A18 + 2)) := mul_le_mul hTp a2 (by norm_num) (by linarith)
      _ = W := by rw [hW]; ring
  have h18 : (c18 : ℝ) ≤ C18 * W := by
    calc (c18 : ℝ) ≤ C18 * ((Q.T : ℝ) * Q.p * Nc * Ln ^ A18) := hc
      _ = C18 * ((Q.T : ℝ) * Q.p * Nc) * Ln ^ A18 := by ring
      _ ≤ C18 * ((Q.T : ℝ) * Q.p * Nc) * Ln ^ (A18 + 2) := by
          gcongr
      _ = C18 * W := by rw [hW]; ring
  have hX : (Q.T : ℝ) * Q.p * Lp ^ 2 ≤ ((Q.P.x : ℝ) + 4) ^ 2 * W := by
    have e1 : Lp ^ 2 ≤ (((Q.P.x : ℝ) + 4) * Ln) ^ 2 := pow_le_pow_left₀ (by linarith) hLpn 2
    have e2 : Ln ^ 2 ≤ Nc * Ln ^ (A18 + 2) := by nlinarith
    have hx4 : (0 : ℝ) ≤ ((Q.P.x : ℝ) + 4) ^ 2 := by positivity
    have hTp0 : (0 : ℝ) ≤ (Q.T : ℝ) * Q.p := by linarith
    calc (Q.T : ℝ) * Q.p * Lp ^ 2 ≤ (Q.T : ℝ) * Q.p * (((Q.P.x : ℝ) + 4) * Ln) ^ 2 :=
          mul_le_mul_of_nonneg_left e1 hTp0
      _ = ((Q.P.x : ℝ) + 4) ^ 2 * ((Q.T : ℝ) * Q.p * Ln ^ 2) := by ring
      _ ≤ ((Q.P.x : ℝ) + 4) ^ 2 * ((Q.T : ℝ) * Q.p * (Nc * Ln ^ (A18 + 2))) := by
          gcongr
      _ = ((Q.P.x : ℝ) + 4) ^ 2 * W := by rw [hW]; ring
  have hK : Kc - 2 = 10 ^ 30 * (2 * (32500 * (Cfm : ℝ) + 6) + 6 ^ 12) := by unfold Kc; ring
  have hK0 : (0 : ℝ) ≤ 10 ^ 30 * (2 * (32500 * (Cfm : ℝ) + 6) + 6 ^ 12) := by positivity
  have hB : (cBody (BN6 Q) (BN6 Q) (Q.p / 6) (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length Q.p Q.h D
      (σ6 Q) (Q.sB D) (Q.tB D) : ℝ) ≤ (Kc - 2) * (((Q.P.x : ℝ) + 4) ^ 2 * W) := by
    rw [hK]
    exact hb.trans (mul_le_mul_of_nonneg_left hX hK0)
  have hx16 : (16 : ℝ) ≤ ((Q.P.x : ℝ) + 4) ^ 2 := by
    have : (0 : ℝ) ≤ Q.P.x := Nat.cast_nonneg _; nlinarith
  push_cast
  have e : (C18 + Kc * ((Q.P.x : ℝ) + 4) ^ 2) * W =
      C18 * W + (Kc - 2) * (((Q.P.x : ℝ) + 4) ^ 2 * W) + 2 * ((Q.P.x : ℝ) + 4) ^ 2 * W := by ring
