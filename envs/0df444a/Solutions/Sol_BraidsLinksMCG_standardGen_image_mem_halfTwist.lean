import Mathlib
import Definitions.Def_BraidsLinksMCG_ConfigSpace
import Definitions.Def_BraidsLinksMCG_StandardLoops
import Definitions.Def_TarchaBraids_HalfTwist
import Theorems.Thm_BraidsLinksMCG_standardGen_image_eq_classical_halfTwist_word_v1

open BraidsLinksMCG
open TarchaBraids

/-- The projected standard generator is the value of the free-group lift on the explicit
half-twist word, hence lies in the subgroup generated by the half-twists. -/
theorem solution (n : ℕ) (j : Fin n) :
    (FundamentalGroup.map (configProj (n + 1)) (baseOrdered (n + 1)))
        ((FundamentalGroup.mapOfEq (configIncl n) (configIncl_base n)) (standardGen n j))
      ∈ Subgroup.closure
          (Set.range (fun i : Fin (n + 1 - 1) => halfTwistBraid (n + 1) i)) := by
  rw [standardGen_image_eq_classical_halfTwist_word_v1 n j]
  rw [← FreeGroup.range_lift_eq_closure
    (f := fun i : Fin (n + 1 - 1) => halfTwistBraid (n + 1) i)]
  exact ⟨_, rfl⟩
