theorem CerednikDrinfeld.QM.IsFineModuli.exists_isRegularLocalRing_prorepresents_stalk_of_isClosed
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (m : ℕ) (hm : 3 ≤ m) (hqm : ¬ q ∣ m)
    (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of ℤ_[q]))
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of ℤ_[q])),
      FakeEllipticCurve.WithFullLevel Λ 1 m S → SchemeHomOver s πM)
    (hM : IsFineModuli Λ 1 m M πM ptF) [LocallyOfFiniteType πM]
    (y : M) (hy : IsClosed ({y} : Set M)) (hyq : πM y = IsLocalRing.closedPoint ℤ_[q]) :
    ∃ (Onr : Type) (_ : CommRing Onr) (_ : IsDomain Onr) (_ : IsDiscreteValuationRing Onr) (_ : CharZero Onr)
      (_ : Algebra ℤ_[q] Onr)
      (hOnr_max : (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}).IsMaximal)
      (xbar : M.presheaf.stalk y →+* IsLocalRing.ResidueField Onr)
      (hxbar : RingHom.ker xbar = IsLocalRing.maximalIdeal (M.presheaf.stalk y))
      (R : Type) (_ : CommRing R) (_ : IsRegularLocalRing R) (_ : Algebra Onr R)
      (_ : IsAdicComplete (IsLocalRing.maximalIdeal R) R)
      (resR : R →+* IsLocalRing.ResidueField Onr) (hresR : resR.comp (algebraMap Onr R) = IsLocalRing.residue Onr)
      (φ : M.presheaf.stalk y →+* R) (hφ : resR.comp φ = xbar),
      (∀ (A : Type) [CommRing A] [IsLocalRing A] [IsArtinianRing A] [Algebra Onr A]
          (resA : A →+* IsLocalRing.ResidueField Onr), Function.Surjective resA →
          resA.comp (algebraMap Onr A) = IsLocalRing.residue Onr →
        ∀ ψ : M.presheaf.stalk y →+* A, resA.comp ψ = xbar →
          ∃! χ : R →ₐ[Onr] A, resA.comp χ.toRingHom = resR ∧ χ.toRingHom.comp φ = ψ) ∧
      ((q : ℕ) : R) ≠ 0 := by sorry
