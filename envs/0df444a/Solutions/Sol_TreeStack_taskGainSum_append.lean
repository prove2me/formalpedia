set_option autoImplicit false
open TreeStack
open scoped BigOperators Classical
variable {α : Type*}
namespace TreeStack
theorem _root_.solution (gain : α → ℤ) (xs ys : List α) :
    taskGainSum gain (xs ++ ys) =
      taskGainSum gain xs + taskGainSum gain ys := by
  induction xs with
  | nil => simp [taskGainSum]
  | cons x xs ih =>
      simp [taskGainSum, ih]
      ring
end TreeStack
