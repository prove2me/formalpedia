-- Source module: Solutions.R6ILSpec
/-!
# Round six, item language: the item-language Prop. 11 interface for a bit network

* `depH_le_log`, `depH_pow_le`: the recursion depth of `progH` is logarithmic; at the widths
  `m ^ k` it is `≤ cW k`.
* `ilCostR`, **`ILProp11 tab C q T₀ c₁ K₁ K₂`**: at every level `k` (width `m ^ k`), with the
  KIL5 calling convention `DescIn`, the procedure `tab 0` computes `progH C q (m ^ k)` on the bit
  stream at cost `⌈K₁ costH C (m^k) V + K₂ (m^k + 1)^c₁ (Bb + 2)²⌉`.
* `ilProp11_of_net` (in `R6ILProp`): the item-language Prop. 11 program for a round-six network.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## 1. The recursion depth of `progH` is logarithmic -/

/-! ## 2. The item-language Prop. 11 for a round-six network -/

section Spec

variable {W T m : ℕ} [NeZero W]

/-- Cost of one call of the item-language Prop. 11 at level `k` (width `m ^ k`) on volume `V`
with item-size bound `Bb`: the structural cost `costH` plus a per-call-tree overhead. -/
def ilCostR (C : Bit.QHNet (ZMod 2) W T m) (K₁ K₂ : ℝ) (c₁ k Bb V : ℕ) : ℕ :=
  ⌈K₁ * Bit.costH C (m ^ k) (V : ℝ) +
    K₂ * (((m ^ k : ℕ) : ℝ) + 1) ^ c₁ * ((Bb : ℝ) + 2) ^ 2⌉₊

/-- **Item-language Prop. 11 for the network `C`** (field `q`), at the levels `e = m ^ k`, with
the KIL5 calling convention: the descriptor `DescIn` (registers `dJ = k`, `dP, dL, dA, dB, dC`,
tower `dT`), the bit stream `enc2 xs` of shape `P :: L :: swShape A B Cs (q ^ m ^ k)` on top of
stack `0`. The procedure `tab 0` replaces it by `progH C q (m ^ k) P L A B Cs xs` (which is the
chunk interchange by `progH_correct`), every other stack unchanged. Side conditions: `W ^ depH`
divides the row count, items of size `≤ Bb` with `zsz (T₀ (V + 1)²) ≤ Bb`. -/
def ILProp11 (tab : Fin 1 → IStmt HS 1) (C : Bit.QHNet (ZMod 2) W T m) (q T₀ c₁ : ℕ)
    (K₁ K₂ : ℝ) : Prop :=
  ∀ (Bb k P L : ℕ) (A B Cs : Shape), 1 ≤ P → W ^ Bit.depH m (m ^ k) ∣ L → 1 ≤ L →
    (∀ a ∈ A, 1 ≤ a) → (∀ a ∈ B, 1 ≤ a) → (∀ a ∈ Cs, 1 ≤ a) →
    zsz ((T₀ * (vol (P :: L :: swShape A B Cs (q ^ m ^ k)) + 1) ^ 2 : ℕ) : ℤ) ≤ Bb →
    ∀ (I : List Sym) (t : IState HS) (R : List Item) (xs : List (ZMod 2)),
      DescIn t q m k P L A B Cs →
      xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
      IRuns I tab (tab 0) (t.upd 0 (ints (enc2 xs) ++ R))
        (t.upd 0 (ints (enc2 (Bit.progH C q (m ^ k) P L A B Cs xs)) ++ R))
        (ilCostR C K₁ K₂ c₁ k Bb (vol (P :: L :: swShape A B Cs (q ^ m ^ k))))

end Spec

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILNet
/-!
# Round six, item language: a `QHNet` program on a table of `T + W` streams

The wires `Fin W ⊕ Fin T` of a round-six network are laid out as a table of `T + W` streams of
length `v` on stack `0` (temporaries first: `inr t ↦ t`, `inl w ↦ T + w`, `eqv`).

* `gateH_fsp`: a gate `(g, S)` is one fine rebuild `rebuildCU (T + W) (srcT (ngOf g S))`
  (frozen KIL3/KFD table code), with denotation `gateApply`;
* `instrH`, `netH`: the code of an instruction / of a program, an edge `(x, e)` being run in
  place by `applyCF` with an edge code `E e`;
* `netH_runs`: the program code computes `netRunH v impl prog` whenever every edge code
  computes `impl e` on single streams (under the invariant `Inv G0`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ}

/-! ## The wire layout -/

/-- Wires to stream indices: temporaries first. -/
def eqv : Fin W ⊕ Fin T ≃ Fin (T + W) := (Equiv.sumComm _ _).trans finSumFinEquiv

@[simp] lemma eqv_inl (w : Fin W) : ((eqv (T := T) (Sum.inl w) : Fin (T + W)) : ℕ) = T + w := by
  simp [eqv]

@[simp] lemma eqv_inr (t : Fin T) : ((eqv (W := W) (Sum.inr t) : Fin (T + W)) : ℕ) = t := by
  simp [eqv]

/-- The table of a wire state. -/
def tabS (st : Fin W ⊕ Fin T → List (ZMod 2)) : ℕ → List ℤ :=
  liftF [] fun k : Fin (T + W) => enc2 (st (eqv.symm k))

/-- The wire state as a family of lists indexed by `ℕ`. -/
def zS (st : Fin W ⊕ Fin T → List (ZMod 2)) : ℕ → List (ZMod 2) :=
  liftF [] fun k : Fin (T + W) => st (eqv.symm k)

/-! ## Gates -/

/-- The gate `(g, S)` on the stream indices. -/
def ngOf (g : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) (ZMod 2)) (S : Finset (Fin W ⊕ Fin T)) :
    NGate (Fin (T + W)) (ZMod 2) ℤ :=
  (Matrix.reindex eqv eqv g, S.map eqv.toEmbedding, 0)

/-! ## The program -/

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- Code of one instruction (edges by the edge code `E`). -/
def instrH (E : Bit.Edge m → IStmt HS Pp) :
    Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m → IStmt HS Pp
  | .gate g S => fcode (rebuildCU (T + W) (srcT (ngOf g S)))
  | .edge x e => applyCF ((eqv x : Fin (T + W)) : ℕ) (E e)

/-- Code of a program. -/
def netH (E : Bit.Edge m → IStmt HS Pp) (prog : List (Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m)) :
    IStmt HS Pp :=
  KIL.seqL (prog.map (instrH E))

/-- Cost of one instruction on `T + W` streams of total volume `V`. -/
def instrHC (cE : Bit.Edge m → ℕ) (V Bb : ℕ) : Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m → ℕ
  | .gate _ _ => cRebuildF (T + W) V Bb
  | .edge _ e => cE e + 2 * cOF V Bb + cPushT Bb + (2 * Bb + 2)

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILEdge
/-!
# Round six, item language: the code of one edge (shift templates and one child call per run)

* the general descriptor `DescG t e P L a b c` (`dJ = -1`, `dT = e`, `dP, dL, dA, dB, dC`);
* `npow` and the natural-expression push lists (`pushOK_NE`);
* `callR m ρ`: push the child descriptor of the run `ρ = (i, j, r)` (width `r f`, shapes
  `A ++ [N]^i`, `[N]^(m-i-r) ++ B ++ [N]^j`, `[N]^(m-j-r) ++ Cs`), call procedure `0`, pop;
  `callR_runs`;
* `tplE E`: the rational shift templates of the lower triangular `E` (`tplE_eval`: they denote
  `shiftSteps (redM N E)`);
* `edgeR m e`: shifts of `E₂`, the child calls, shifts of `E₁`; `edgeR_runs`: it computes
  `realEdge` (`R6BitLevel`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## Registers of the general procedure -/

/-- `e mod m`. -/
abbrev gR : Fin HS := 25
/-- `q ^ (e mod m)`. -/
abbrev gQR : Fin HS := 26
/-- Loop counter. -/
abbrev gC : Fin HS := 27
/-- `T · v` (temporaries). -/
abbrev gTV : Fin HS := 53
/-- `vol A`. -/
abbrev gA : Fin HS := 54
/-- `f = e / m`. -/
abbrev gF : Fin HS := 55

/-- **The descriptor of the general procedure**: width `e` (digits), `P`, `L`, and the volumes
of `A`, `B`, `Cs`; `dJ = -1` selects the general branch. -/
structure DescG (t : IState HS) (e P L a b c : ℕ) : Prop where
  j : ∃ R, t.G dJ = .int (-1) :: R
  e : ∃ R, t.G dT = .int (e : ℤ) :: R
  p : ∃ R, t.G dP = .int (P : ℤ) :: R
  l : ∃ R, t.G dL = .int (L : ℤ) :: R
  a : ∃ R, t.G dA = .int (a : ℤ) :: R
  b : ∃ R, t.G dB = .int (b : ℤ) :: R
  c : ∃ R, t.G dC = .int (c : ℤ) :: R

/-! ## Natural expressions -/

/-- `x ^ k` as a product. -/
def npow (x : NE) : ℕ → NE
  | 0 => .lit 1
  | k + 1 => .mul (npow x k) x

/-! ## The child call of a run -/

/-- The child descriptor (natural part) of the run `ρ = (i, j, r)`. -/
def chN (m : ℕ) (ρ : ℕ × ℕ × ℕ) : List (Fin HS × NE) :=
  [(dT, .mul (.lit ρ.2.2) (.reg gF)), (dL, .reg rLp),
   (dA, .mul (.reg gA) (npow (.reg sQQ) ρ.1)),
   (dB, .mul (npow (.reg sQQ) (m - ρ.1 - ρ.2.2)) (.mul (.reg rVB) (npow (.reg sQQ) ρ.2.1))),
   (dC, .mul (npow (.reg sQQ) (m - ρ.2.1 - ρ.2.2)) (.reg rVC))]

/-- The full child descriptor push list. -/
def chR (m : ℕ) (ρ : ℕ × ℕ × ℕ) : List (Fin HS × Ex HS) :=
  (dJ, .lit (-1)) :: (chN m ρ).map fun p => (p.1, p.2.toEx)

/-- The child call of a run. -/
def callR {Pp : ℕ} (j0 : Fin Pp) (m : ℕ) (ρ : ℕ × ℕ × ℕ) : IStmt HS Pp :=
  .seq (pushes (chR m ρ)).code (.seq (.call j0) (popsR [dJ, dT, dL, dA, dB, dC]).code)

/-- Cost of the call wrapper around a child of cost `c0`. -/
def cCallR (m : ℕ) (ρ : ℕ × ℕ × ℕ) (Bb c0 : ℕ) : ℕ :=
  pushCost Bb (chR m ρ) + (c0 + 2) + (6 * (2 * Bb + 2) + 1)

/-! ## Shift templates and the edge code -/

section Edge

variable {m : ℕ}

/-- The rational shift templates of a lower triangular `E` (rows `2m-1, …, 0`). -/
def tplE (E : Bit.QMat2 m) : List (TSh m) :=
  (List.finRange (m + m)).reverse.map fun i => rsh i (E i i) (fun j => E i j)

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The code of an edge: shifts of `E₂`, one child call per run, shifts of `E₁`. -/
def edgeR (j0 : Fin Pp) (m : ℕ) (e : Bit.Edge m) : IStmt HS Pp :=
  .seq (fcode (stepsU m rXs (tplE e.E₂)))
    (.seq (KIL.seqL (e.runs.map (callR j0 m))) (fcode (stepsU m rXs (tplE e.E₁))))

/-- Cost of the edge code on streams of volume `v` (`cC ρ`: cost of the call of run `ρ`). -/
def cEdgeR (m : ℕ) (e : Bit.Edge m) (v Bb : ℕ) (cC : ℕ × ℕ × ℕ → ℕ) : ℕ :=
  cStepsUF rXs v 1 Bb (tplE e.E₂) + (((e.runs.map cC).sum + 1) + cStepsUF rXs v 1 Bb (tplE e.E₁))

end Edge

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILLevel
/-!
# Round six, item language: one level of the general procedure

`levBody C`: row split (KFC `bwdF`), `T · v` zeros pushed in front (the temporaries), the
network `netH (edgeR 0 m) C.prog` on the `T + W` streams, the routing rebuild (role `w` takes the
stream of wire `inl (ρ w)`), the temporaries dropped, row merge (KFC `fwdF`).

`levBody_run`: under the level registers `LevH G0 …` and a run hypothesis for the child calls, the
body computes `Bit.levelH C N P L' A B Cs child` (the denotation used by `Bit.progH`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## Table lemmas -/

/-- The routing sources: temporaries stay, role `w` takes wire `inl (ρ w)`. -/
def srcR {W : ℕ} (T : ℕ) (ρ : Fin W → Fin W) (n : ℕ) : List ℕ :=
  if n < T then [n] else if h : n - T < W then [T + ρ ⟨n - T, h⟩] else []

/-! ## The level registers -/

/-- The registers of a level (in the protected stacks `G0`): modulus `N`, `P`, `L'`, the stream
volume `v = vol (P :: L' :: hdShape A B Cs m N)`, `(T + W) v`, `T v`, `vol A`, `f`. -/
structure LevH (G0 : Fin HS → List Item) (m W T N P L' f : ℕ) (A B Cs : Shape) : Prop where
  qq : ∃ L, G0 sQQ = .int (N : ℤ) :: L
  nq : ∃ L, G0 sNQ = .int (-(N : ℤ)) :: L
  xs : ∃ L, G0 rXs = .int ((vol (P :: L' :: A) : ℕ) : ℤ) :: L
  vb : ∃ L, G0 rVB = .int ((vol B : ℕ) : ℤ) :: L
  vc : ∃ L, G0 rVC = .int ((vol Cs : ℕ) : ℤ) :: L
  v : ∃ L, G0 rV = .int ((vol (P :: L' :: hdShape A B Cs m N) : ℕ) : ℤ) :: L
  wv : ∃ L, G0 rWV = .int (((T + W) * vol (P :: L' :: hdShape A B Cs m N) : ℕ) : ℤ) :: L
  tv : ∃ L, G0 gTV = .int ((T * vol (P :: L' :: hdShape A B Cs m N) : ℕ) : ℤ) :: L
  p : ∃ L, G0 dP = .int (P : ℤ) :: L
  lp : ∃ L, G0 rLp = .int (L' : ℤ) :: L
  a : ∃ L, G0 gA = .int ((vol A : ℕ) : ℤ) :: L
  f : ∃ L, G0 gF = .int (f : ℤ) :: L

/-! ## The body -/

variable {W T m : ℕ} [NeZero W]

/-- **The body of one level** (procedure table with one entry; children by `.call 0`). -/
def levBody (C : Bit.QHNet (ZMod 2) W T m) : IStmt HS 1 :=
  .seq (withPushI (splitL W) KFC.bwdF)
  (.seq (fcode (zeroKE 0 21 (.reg gTV)))
  (.seq (netH (edgeR (0 : Fin 1) m) C.prog)
  (.seq (fcode (rebuildCU (T + W) (srcR T C.ρ)))
  (.seq (fcode (dropKE 0 21 (.reg gTV)))
    (withPushI (splitL W) KFC.fwdF)))))

/-- Cost of the body (`v`: stream volume, `h = vol rest`, `cC`: cost of a run's call). -/
def cLevBody (C : Bit.QHNet (ZMod 2) W T m) (P L' h v Bb : ℕ) (cC : ℕ × ℕ × ℕ → ℕ) : ℕ :=
  (cSplit W Bb + KFC.cBwdF 1 W (P * L') h 1) + (cLp (T * v) 8000 Bb +
  (((C.prog.map (instrHC (fun e => cEdgeR m e v Bb cC) ((T + W) * v) Bb)).sum + 1) +
  (cRebuildF (T + W) ((T + W) * v) Bb + (cLp (T * v) (2 * 1 + 2) Bb +
  (cSplit W Bb + KFC.cFwdF 1 W (P * L') h 1)))))

variable {I : List Sym} {tab : Fin 1 → IStmt HS 1}

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILGenE
/-!
# Round six, item language: the entry of the general procedure

The general procedure reads the descriptor `DescG` (`dT = e`, `dP, dL, dA, dB, dC`) and creates
a register file `genD` holding `f = e / m`, `r = e mod m`, `N = q ^ f`, `q ^ r`, `N ^ m`,
`L' = L / W`, `vol A`, and the level volumes `vol (P :: L' :: A)`, `q ^ r vol B`, `q ^ r vol Cs`,
`v = vol (P :: L' :: hdShape A B' C' m N)`, `(T + W) v`, `T v` (`genE_sp`).

* `desc_split`: a state with the descriptor is a managed state over the descriptor values;
* `vEnt`: the valuation after the entry, with its values (`vEnt_vals`) and bounds.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

/-! ## The register file and the descriptor -/

/-- The register file of the general procedure. -/
def genD : List (Fin HS) := [sQQ, gR, gQR, kP, kG, kS, kQt, kQr, kR, rLp, gTV, gA, gF]

/-- The descriptor registers read by the general procedure. -/
def descD : List (Fin HS) := [dT, dP, dL, dA, dB, dC]

/-- The descriptor values. -/
def vDesc (e P L a b c : ℕ) : Fin HS → ℕ := fun i =>
  if i = dT then e else if i = dP then P else if i = dL then L else if i = dA then a
  else if i = dB then b else if i = dC then c else 0

/-- The descriptor as a managed function. -/
def fDesc (e P L a b c : ℕ) : Fin HS → List ℤ := regState (fun _ => []) (vDesc e P L a b c) descD

/-! ## Loops multiplying by a register -/

def mulR (X Y : Fin HS) : List (Fin HS × NE) := [(X, .mul (.reg X) (.reg Y))]

/-! ## The entry code -/

def entA1 (m : ℕ) : List (Fin HS × NE) :=
  [(gF, .div (.reg dT) (.lit m)), (gR, .mod (.reg dT) (.lit m)), (sQQ, .lit 1), (gQR, .lit 1),
   (kG, .lit 1)]

def entA2 (W T : ℕ) : List (Fin HS × NE) :=
  [(rLp, .div (.reg dL) (.lit W)), (gA, .reg dA),
   (rXs, .mul (.mul (.reg dP) (.reg rLp)) (.reg gA)),
   (rVB, .mul (.reg gQR) (.reg dB)), (rVC, .mul (.reg gQR) (.reg dC)),
   (rV, .mul (.mul (.mul (.mul (.reg rXs) (.reg kG)) (.reg rVB)) (.reg kG)) (.reg rVC)),
   (rWV, .mul (.lit (T + W)) (.reg rV)), (gTV, .mul (.lit T) (.reg rV))]

/-- **The entry**: create the file, `f, r`, the loops for `q ^ f`, `q ^ r`, `N ^ m`, the level
quantities. -/
def genE (m q W T : ℕ) : RS :=
  .seq (pushZs genD) (.seq (asgL (entA1 m))
    (.seq (.rep gC (NE.reg gF).toEx (asgL (mulL sQQ q)))
    (.seq (.rep gC (NE.reg gR).toEx (asgL (mulL gQR q)))
    (.seq (.rep gC (NE.lit m).toEx (asgL (mulR kG sQQ))) (asgL (entA2 W T))))))

/-- Cost of a counted assignment loop of `k` rounds. -/
def cRep (n : NE) (k : ℕ) (L : List (Fin HS × NE)) (B : ℕ) : ℕ :=
  (n.size + 1) * 2000 * (B + 2) + k * (szA L * 10 ^ 7 * (B + 2) ^ 2 + 8000 * (B + 2) + 30) + 32

def cGenE (m q W T e Bb : ℕ) : ℕ :=
  (genD.length * 4000 * (Bb + 2) + 1) + (szA (entA1 m) * 10 ^ 7 * (Bb + 2) ^ 2 +
    (cRep (.reg gF) (e / m) (mulL sQQ q) Bb + (cRep (.reg gR) (e % m) (mulL gQR q) Bb +
    (cRep (.lit m) m (mulR kG sQQ) Bb + szA (entA2 W T) * 10 ^ 7 * (Bb + 2) ^ 2))))

/-- The valuation before the last assignments. -/
def vPre (m q e P L a b c : ℕ) : Fin HS → ℕ :=
  Function.update (Function.update (Function.update (evalA (entA1 m) (vDesc e P L a b c))
    sQQ (q ^ (e / m))) gQR (q ^ (e % m))) kG ((q ^ (e / m)) ^ m)

/-- The valuation after the entry. -/
def vEnt (m q W T e P L a b c : ℕ) : Fin HS → ℕ := evalA (entA2 W T) (vPre m q e P L a b c)

/-- The level volume computed by the entry. -/
def volE (m q W e P L a b c : ℕ) : ℕ :=
  P * (L / W) * a * (q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m * (q ^ (e % m) * c)

/-- The bounds of the entry. -/
structure EntB (m q W T e P L a b c M : ℕ) : Prop where
  m1 : 1 ≤ m
  W1 : 1 ≤ W
  q1 : 1 ≤ q
  lit : m + q + (T + W) ≤ M
  desc : e + P + L + a + b + c ≤ M
  a1 : 1 ≤ a
  b1 : 1 ≤ b
  c1 : 1 ≤ c
  Nm : (q ^ (e / m)) ^ m ≤ M
  qb : q ^ (e % m) * b ≤ M
  qc : q ^ (e % m) * c ≤ M
  vv : (T + W) * volE m q W e P L a b c ≤ M

/-! ## The entry specification -/

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILGenT
/-!
# Round six, item language: the tail of the general procedure

After the level, the general procedure swaps the `r = e mod m` leftover digit pairs (KFE
`swapsF q`, the registers set by `tailA q`) and removes its register file: `gen_tail`. The digit
runs are those of `Bit.tailSwaps` in `progH`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD NLogN.KFE AModel AModelL12 Finset

noncomputable section

/-- The registers of the tail swaps. -/
def tailA (q : ℕ) : List (Fin HS × NE) :=
  [(kP, .mul (.mul (.mul (.reg dP) (.reg dL)) (.reg gA)) (.reg kG)),
   (kG, .mul (.reg dB) (.reg kG)), (kS, .reg dC), (kQt, .lit 1),
   (kQr, .div (.reg gQR) (.lit q)), (kR, .reg gR)]

/-- The tail code. -/
def genTail {Pp : ℕ} (q : ℕ) : IStmt HS Pp :=
  .seq (asgL (tailA q)).code (.seq (swapsF q) (popDs genD).code)

/-- Cost of the tail. -/
def cTail (q V Bb r : ℕ) : ℕ :=
  szA (tailA q) * 10 ^ 7 * (Bb + 2) ^ 2 +
    ((r + 1) * (cSw1F q V Bb + 10 ^ 4 * (Bb + 2)) + (genD.length * (2 * Bb + 2) + 1))

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILLevCost
/-!
# Round six, item language: the cost of one level body

`cLevBody_le`: the cost of `levBody C` on streams of volume `v` is at most
`levB C v Bb = KL C · (10^14 ((T + W) v + 1) + 10^11 (Bb + 2)²)` plus the costs of the child
calls of all runs of all edges (`runsL C`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ}

/-- All runs of all edges of the network (one child call each). -/
def runsL (C : Bit.QHNet (ZMod 2) W T m) : List (ℕ × ℕ × ℕ) := C.edges.flatMap fun e => e.runs

/-- The per-instruction cost constant. -/
def iK (W T : ℕ) : Bit.Instr (Fin W ⊕ Fin T) (ZMod 2) m → ℕ
  | .gate _ _ => (T + W) * (2 * (T + W) + 2) + 202
  | .edge _ e => tKFs rXs (tplE e.E₁) + tKFs rXs (tplE e.E₂) + 1

/-- The cost unit of a level on streams of volume `v`. -/
def uU (W T v Bb : ℕ) : ℕ := 10 ^ 14 * ((T + W) * v + 1) + 10 ^ 11 * (Bb + 2) ^ 2

/-- The level constant. -/
def KL (C : Bit.QHNet (ZMod 2) W T m) : ℕ :=
  (C.prog.map (iK W T)).sum + (T + W) * (2 * (T + W) + 2) + 2 * (2 * W + 69) * 276 +
    2 * pushSz (splitL W) + 1000

/-- The level bound (without the child calls). -/
def levB (C : Bit.QHNet (ZMod 2) W T m) (v Bb : ℕ) : ℕ := KL C * uU W T v Bb

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILTok
/-!
# Round six, item language: the shift templates are admissible for large primes

`tok_edges`: for a prime `q` above the template constant `qBound C` and `f ≥ 1`, if the edges
are `EdgeOK` at `q ^ f`, then every shift template of every edge satisfies `TOK` at `q ^ f`, and
all matrix denominators are coprime to `q ^ f`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 AModelFac Finset

noncomputable section

variable {W T m : ℕ}

/-- The rational step of row `i` of a lower triangular matrix. -/
def rowQ (E : Bit.QMat2 m) (i : Fin (m + m)) : QStep m := .sh i (E i i) (fun j => E i j)

/-- The template constant of a matrix. -/
def qbE (E : Bit.QMat2 m) : ℕ := ∑ i : Fin (m + m), qsB (rowQ E i)

/-- The template constant of the network. -/
def qBound (C : Bit.QHNet (ZMod 2) W T m) : ℕ := (C.edges.map fun e => qbE e.E₁ + qbE e.E₂).sum

end

end IntMul.Kappa.R6.IL

end

section
-- Source module: Solutions.R6ILGenL
/-!
# Round six, item language: the level branch of the general procedure

`genL C`: if `f = e / m = 0` nothing; otherwise push `-N` on `sNQ` (`N = q ^ f`), run the level
body `levBody C` (the level registers are those of the entry file), pop `sNQ`. `gen_level`: given
a specification of the child calls, it computes `levelH` with the child of `progH`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ} [NeZero W]

/-- The level branch. -/
def genL (C : Bit.QHNet (ZMod 2) W T m) : IStmt HS 1 :=
  .ite gF (fun c => c == .zero) .skip
    (.seq (RS.push sNQ (.neg (.reg sQQ))).code (.seq (levBody C) (RS.pop sNQ).code))

/-- The child descriptor values of a run. -/
def chDesc (m N a b c : ℕ) (ρ : ℕ × ℕ × ℕ) : ℕ × ℕ × ℕ :=
  (a * N ^ ρ.1, N ^ (m - ρ.1 - ρ.2.2) * (b * N ^ ρ.2.1), N ^ (m - ρ.2.1 - ρ.2.2) * c)

/-- Cost of the level branch (`c0 ρ`: cost of the child procedure). -/
def cGenL (C : Bit.QHNet (ZMod 2) W T m) (e v Bb : ℕ) (c0 : ℕ × ℕ × ℕ → ℕ) : ℕ :=
  if m ≤ e then
    (3 * 2000 * (Bb + 2) + (levB C v Bb + ((runsL C).map fun ρ => cCallR m ρ Bb (c0 ρ)).sum +
      (2 * Bb + 2))) + 25
  else 1 + 25

end

end IntMul.Kappa.R6.IL

