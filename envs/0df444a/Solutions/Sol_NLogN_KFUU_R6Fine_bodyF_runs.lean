    (L := t.G 1) (by simp +decide [t5, t4, t3, t2, t1])
  have h7 := IRuns.drop (I := I) (iprog := iprog) (s := t5.upd 1 (t.G 1)) (i := 2)
    (a := (2 : ℤ)) (L := t.G 2) (by simp +decide [t5, t4, t3, t2, t1])
  have h8 := IRuns.drop (I := I) (iprog := iprog) (s := (t5.upd 1 (t.G 1)).upd 2 (t.G 2)) (i := 3)
