theorem sum_mu_sol_aux (P s : ℕ) (hs : 2 ≤ s) (hc : Nat.Coprime P s) :
    ∑ y ∈ Finset.Icc 1 s, (y : ℤ) * (if ((y : ℤ) * ((P % s : ℕ) : ℤ)) % (s : ℤ) = 1 then 1 else 0) =
      (muInv P s : ℤ) := by
  have hconv : ∀ y : ℕ, ((y : ℤ) * ((P % s : ℕ) : ℤ)) % (s : ℤ) = 1 ↔ (y * P) % s = 1 := by
    intro y
    rw [show ((y : ℤ) * ((P % s : ℕ) : ℤ)) % (s : ℤ) = (((y * (P % s)) % s : ℕ) : ℤ) by push_cast; rfl,
      Nat.mul_mod, Nat.mod_mod, ← Nat.mul_mod]
    constructor
    · intro h; exact_mod_cast h
    · intro h; exact_mod_cast h
  have hrw : ∀ y ∈ Finset.Icc 1 s, (y : ℤ) *
      (if ((y : ℤ) * ((P % s : ℕ) : ℤ)) % (s : ℤ) = 1 then 1 else 0) =
      if (y * P) % s = 1 then (y : ℤ) else 0 := by
    intro y _
    by_cases h : (y * P) % s = 1
    · rw [if_pos ((hconv y).2 h), if_pos h, mul_one]
    · rw [if_neg (fun h' => h ((hconv y).1 h')), if_neg h, mul_zero]
  rw [Finset.sum_congr rfl hrw, ← Finset.sum_filter]
  obtain ⟨hμs, hμ⟩ := mu_spec P s (by omega) hc
  set μ := muInv P s with hμd
  have h1s : 1 % s = 1 := Nat.mod_eq_of_lt (by omega)
  have hμ0 : μ ≠ 0 := by
    intro h0; rw [h0, zero_mul, Nat.zero_mod, h1s] at hμ; exact absurd hμ (by norm_num)
  have hfil : (Finset.Icc 1 s).filter (fun y => (y * P) % s = 1) = {μ} := by
    ext y
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_singleton]
    constructor
    · rintro ⟨⟨hy1, hys⟩, hy⟩
      have hys' : y < s := by
        rcases Nat.lt_or_ge y s with h | h
        · exact h
        · have : y = s := by omega
          subst this; rw [Nat.mul_mod_right] at hy; omega
      have hmod : y * P ≡ μ * P [MOD s] := by
        show (y * P) % s = (μ * P) % s; rw [hy, hμ, h1s]
      have := Nat.ModEq.cancel_right_of_coprime (Nat.Coprime.symm hc |>.gcd_eq_one) hmod
      unfold Nat.ModEq at this
      rwa [Nat.mod_eq_of_lt hys', Nat.mod_eq_of_lt hμs] at this
    · rintro rfl
      exact ⟨⟨Nat.one_le_iff_ne_zero.2 hμ0, hμs.le⟩, by rw [hμ, h1s]⟩
  rw [hfil, Finset.sum_singleton]

