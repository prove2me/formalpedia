open Finset Real

namespace J6Seg
open J6QLU

section stage
variable (P : ℕ)

end stage

/-! ### The block solve -/

section blk
variable (P : ℕ) (α σ b : ℝ)

lemma ulp_div {x : ℤ} {y E : ℝ} (h : |(x : ℝ) - 2 ^ P * y| ≤ E) :
    |(x : ℝ) / 2 ^ P - y| ≤ E / 2 ^ P := by
