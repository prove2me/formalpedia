private theorem t0875 {F : Type*} [Field F] (val : Valuation F ℤᵐ⁰) {M N : GL (Fin 2) F}
    (hM : LocalWhittaker.IsIntegral val M) (hN : LocalWhittaker.IsIntegral val N) :
    LocalWhittaker.IsIntegral val (M * N) := by
  intro i j
  rw [Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two]
  refine (val.map_add _ _).trans (max_le ?_ ?_)
  · rw [val.map_mul]
    exact mul_le_one' (hM i 0) (hN 0 j)
  · rw [val.map_mul]
    exact mul_le_one' (hM i 1) (hN 1 j)

private theorem t0876 {F : Type*} [Field F] (val : Valuation F ℤᵐ⁰) {k : GL (Fin 2) F}
    (hk : LocalWhittaker.IsIntegral val k) (hk' : LocalWhittaker.IsIntegral val k⁻¹) (h : GL (Fin 2) F) :
    (LocalWhittaker.IsIntegral val (k * h) ∧ LocalWhittaker.IsIntegral val (k * h)⁻¹)
      ↔ (LocalWhittaker.IsIntegral val h ∧ LocalWhittaker.IsIntegral val h⁻¹) := by
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨?_, ?_⟩
    · have h3 := t0875 val hk' h1
      rwa [inv_mul_cancel_left] at h3
    · have h3 := t0875 val h2 hk
      rwa [mul_inv_rev, inv_mul_cancel_right] at h3
  · rintro ⟨h1, h2⟩
    refine ⟨t0875 val hk h1, ?_⟩
    rw [mul_inv_rev]
    exact t0875 val h2 hk'

private theorem t0877 : (weylGL2 K)⁻¹ = weylGL2 K ^ 3 := by
  refine inv_eq_of_mul_eq_one_right (Units.ext (Matrix.ext fun i j => ?_))
  simp only [pow_three, Units.val_mul, Matrix.mul_apply, Fin.sum_univ_two, weylGL2_coe, Units.val_one]
  fin_cases i <;> fin_cases j <;> simp

private theorem t0878 (v : HeightOneSpectrum (𝓞 K)) :
    LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (weylGL2 K))) ∧
      LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (weylGL2 K)))⁻¹ := by
  have hw : LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (weylGL2 K))) := by
    intro i j
    have h : ((compAt v (globalPoints (𝓞 K) K (weylGL2 K)) : GL (Fin 2) (v.adicCompletion K)) :
          Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) i j
        = algebraMap K (v.adicCompletion K) (((weylGL2 K : GL (Fin 2) K) : Matrix (Fin 2) (Fin 2) K) i j) :=
      t0246 v (weylGL2 K) i j
    rw [h, weylGL2_coe]
    fin_cases i <;> fin_cases j <;> simp
  refine ⟨hw, ?_⟩
  rw [← map_inv, ← map_inv, t0877, map_pow, map_pow, pow_three]
  exact t0875 _ hw (t0875 _ hw hw)

private theorem t0879 (v : HeightOneSpectrum (𝓞 K))
    (α : Kˣ) (hα : Valued.v ((localOf K v α : (v.adicCompletion K)ˣ) : v.adicCompletion K) = 1) :
    LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (diagOne α))) ∧
      LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (diagOne α)))⁻¹ := by
  rw [t0098, t0099, t0225, ← map_inv, t0387,
    t0387, hα, Units.val_inv_eq_inv_val, map_inv₀, hα, inv_one]
  exact ⟨le_rfl, le_rfl⟩

private theorem t0880 (d : JLData K S epsS ω)
    (v : HeightOneSpectrum (𝓞 K))
    (hA : Valued.v ((localOf K v d.A : (v.adicCompletion K)ˣ) : v.adicCompletion K) = 1) (g : AdelicGL2 (𝓞 K) K) :
    (LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (weylA d) * g)) ∧
        LocalWhittaker.IsIntegral Valued.v (compAt v (globalPoints (𝓞 K) K (weylA d) * g))⁻¹)
      ↔ (LocalWhittaker.IsIntegral Valued.v (compAt v g) ∧ LocalWhittaker.IsIntegral Valued.v (compAt v g)⁻¹) := by
  have hA' : Valued.v ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K) = 1 := by
    simpa only [localOf, Units.coe_map, MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe, Units.val_neg, map_neg,
      Valuation.map_neg] using hA
  obtain ⟨hd, hd'⟩ := t0879 v (-d.A) hA'
  obtain ⟨hw, hw'⟩ := t0878 (K := K) v
  rw [map_mul, weylA, map_mul, map_mul, mul_assoc, t0876 _ hw hw',
    t0876 _ hd hd']

private theorem t0881 (α : Kˣ) :
    {v : HeightOneSpectrum (𝓞 K) |
      Valued.v ((localOf K v α : (v.adicCompletion K)ˣ) : v.adicCompletion K) ≠ 1}.Finite := by
  refine (Filter.eventually_cofinite.mp (t0432 (globalPoints (𝓞 K) K (diagOne α)))).subset
    fun v hv => ?_
  simp only [Set.mem_setOf_eq] at hv ⊢
  rintro ⟨h1, h2⟩
  rw [t0098, t0099, t0225, t0387] at h1
  rw [t0098, t0099, t0225, ← map_inv, t0387] at h2
  refine hv (le_antisymm h1 ?_)
  calc (1 : ℤᵐ⁰)
      = Valued.v ((localOf K v α : (v.adicCompletion K)ˣ) : v.adicCompletion K) *
          Valued.v (((localOf K v α)⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) := by
        rw [← Valuation.map_mul, Units.mul_inv, Valuation.map_one]
    _ ≤ Valued.v ((localOf K v α : (v.adicCompletion K)ˣ) : v.adicCompletion K) * 1 := mul_le_mul' le_rfl h2
    _ = Valued.v ((localOf K v α : (v.adicCompletion K)ˣ) : v.adicCompletion K) := mul_one _

