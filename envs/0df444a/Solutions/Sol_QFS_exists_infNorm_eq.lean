open QFS

variable {d : ℕ}

/-- On a nonempty index set the supremum defining `‖·‖_∞` is attained. -/
lemma solution [Nonempty (Fin d)] (x : EuclideanSpace ℝ (Fin d)) :
    ∃ i, QFS.infNorm x = |x i| := by
  obtain ⟨i₀, -, hi₀⟩ :=
    Finset.exists_max_image Finset.univ (fun i => |x i|)
      ⟨Classical.arbitrary _, Finset.mem_univ _⟩
  exact ⟨i₀, le_antisymm (QFS.infNorm_le (abs_nonneg _) (fun i => hi₀ i (Finset.mem_univ i)))
    (QFS.le_infNorm x i₀)⟩
