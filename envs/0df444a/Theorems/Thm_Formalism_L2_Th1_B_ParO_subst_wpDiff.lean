variable {K : Type} [Field K] [CharZero K]

theorem Formalism.L2.Th1.B.ParO.subst_wpDiff {ι : Type} (P : PowerSeries K) {b : Fin 2 → MvPowerSeries ι K}
    (hb : MvPowerSeries.HasSubst b) :
    MvPowerSeries.subst b (wpDiff P) =
      b 0 ^ 2 - b 1 ^ 2 +
        b 0 ^ 2 * b 1 ^ 2 * (PowerSeries.subst (b 1) P - PowerSeries.subst (b 0) P) := by sorry
