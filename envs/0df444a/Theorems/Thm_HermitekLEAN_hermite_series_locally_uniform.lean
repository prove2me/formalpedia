theorem HermitekLEAN.hermite_series_locally_uniform :
    ∀ {k : ℕ} {G : ℂ → ℂ},
      G ∈ Hk k →
        ∃ g : ℕ → ℂ,
          G = hermiteSeries k g ∧
            Continuous G := by sorry
