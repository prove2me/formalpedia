def Valid (c : LogCertificate) : Prop :=
  0 < c.q ∧ 0 ≤ c.t ∧ c.t < 1 ∧
  c.q * 2 ^ c.k = (1 + c.t) / (1 - c.t) ∧
  c.lo + c.k * (69314718057 / 100000000000 : ℚ) ≤
    2 * ∑ i ∈ range c.N, c.t ^ (2 * i + 1) / (2 * i + 1) ∧
  2 * ((∑ i ∈ range c.N, c.t ^ (2 * i + 1) / (2 * i + 1)) +
    c.t ^ (2 * c.N + 1) / (1 - c.t ^ 2)) -
    c.k * (69314718055 / 100000000000 : ℚ) ≤ c.hi

instance (c : LogCertificate) : Decidable (Valid c) := inferInstanceAs (Decidable (0 < c.q ∧ _))


def logIndex (q : ℚ) : Fin 212 :=
  ⟨(List.ofFn (fun j : Fin 212 ↦ (certificates j).q)).idxOf q % 212, Nat.mod_lt _ (by decide)⟩

def Covered (q : ℚ) : Prop := q = 0 ∨ q = 1 ∨ (certificates (logIndex q)).q = q
instance (q : ℚ) : Decidable (Covered q) := inferInstanceAs (Decidable (q = 0 ∨ _))

def lowerTerm (q : ℚ) : ℚ :=
  if q = 0 ∨ q = 1 then 0 else -q * (certificates (logIndex q)).hi
def upperTerm (q : ℚ) : ℚ :=
  if q = 0 ∨ q = 1 then 0 else -q * (certificates (logIndex q)).lo

open MME.DWZ224Fine

def coarseLower : ℚ := ∑ r, weight r * ∑ g, lowerTerm (coarse r 0 g)
def parentLower (i : Fin 3) : ℚ := ∑ r, weight r * ∑ a, ∑ b, lowerTerm (jointWord r i a b)
def compatibilityUpper (i : Fin 2) : ℚ :=
  ∑ r, weight r * ∑ s,
    ((∑ w, upperTerm (partMass i r s w)) - lowerTerm (∑ w, partMass i r s w))

def penaltyUpper : ℚ :=
  ∑ r, weight r * ((DWZFourthRecursiveWitness.witness (witnessIndex (region r))).entropyUpper -
    ∑ j, lowerTerm (alpha r j))

def rateLower : Fin 3 → ℚ :=
  ![coarseLower - penaltyUpper, parentLower 1 - compatibilityUpper 0, parentLower 2 - compatibilityUpper 1]

end MME.DWZ224Certificate


