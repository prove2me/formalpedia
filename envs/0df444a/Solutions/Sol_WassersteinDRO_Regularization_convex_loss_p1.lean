/-- The real line, carrying the coarse σ-algebra generated by `{0}`. -/
def R0 : Type := ℝ

noncomputable instance : NormedAddCommGroup R0 := inferInstanceAs (NormedAddCommGroup ℝ)
noncomputable instance : NormedSpace ℝ R0 := inferInstanceAs (NormedSpace ℝ ℝ)
instance msR0 : MeasurableSpace R0 := MeasurableSpace.generateFrom {{(0 : R0)}}

theorem meas_zero : MeasurableSet ({0} : Set R0) :=
  MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton _)

/-- Every measurable set lies inside `{0}` or contains its complement. -/
theorem meas_cases {s : Set R0} (hs : MeasurableSet s) :
    s ⊆ {0} ∨ ({0}ᶜ : Set R0) ⊆ s := by
  refine MeasurableSpace.generateFrom_induction (C := {{(0 : R0)}})
    (p := fun t _ => t ⊆ {0} ∨ ({0}ᶜ : Set R0) ⊆ t) ?_ ?_ ?_ ?_ s hs
  · intro t ht _
    left
    rw [Set.mem_singleton_iff.mp ht]
  · left
    exact Set.empty_subset _
  · intro t _ ih
    rcases ih with h | h
    · right
      exact Set.compl_subset_compl.mpr h
    · left
      exact Set.compl_subset_comm.mp h
  · intro f _ ih
    by_cases hall : ∀ i, f i ⊆ {0}
    · left
      exact Set.iUnion_subset hall
    · obtain ⟨i, hi⟩ := not_forall.mp hall
      right
      exact ((ih i).resolve_left hi).trans (Set.subset_iUnion f i)

/-- View a real number as a point of `R0`. -/
def mk (r : ℝ) : R0 := r

theorem norm_mk (r : ℝ) : ‖mk r‖ = |r| := rfl

theorem mk_ne_zero {r : ℝ} (hr : r ≠ 0) : mk r ≠ 0 := hr

theorem mk_eq_zero {r : ℝ} (h : mk r = 0) : r = 0 := h

theorem ne_zero_of_norm {x : R0} (hx : ‖x‖ ≠ 0) : x ∉ ({0} : Set R0) := by
  intro h
  rw [Set.mem_singleton_iff.mp h, norm_zero] at hx
  exact hx rfl

/-- If the norm is integrable for `Q`, then `Q` is concentrated at `0` and the risk is `0`. -/
theorem risk_eq_zero (Q : Measure R0) (h : Integrable (fun x : R0 => ‖x‖) Q) :
    ∫ x, ‖x‖ ∂Q = 0 := by
  obtain ⟨g, hg, hae⟩ := h.1.aemeasurable
  set c : ℝ := g (mk 1) with hc
  have hgc : ({0}ᶜ : Set R0) ⊆ g ⁻¹' {c} := by
    rcases meas_cases (hg (measurableSet_singleton c)) with h1 | h1
    · exfalso
      have hmem : (mk 1) ∈ g ⁻¹' {c} := by
        simp [hc]
      exact mk_ne_zero one_ne_zero (Set.mem_singleton_iff.mp (h1 hmem))
    · exact h1
  have hnull : Q {x | ¬ ‖x‖ = g x} = 0 := ae_iff.mp hae
  obtain ⟨T, hsub, hT, hQT⟩ := exists_measurable_superset_of_null hnull
  have hp : (mk (|c| + 1)) ∈ T := by
    apply hsub
    have hne : (mk (|c| + 1)) ∈ ({0}ᶜ : Set R0) := by
      intro h0
      have : (|c| + 1 : ℝ) = 0 := mk_eq_zero (Set.mem_singleton_iff.mp h0)
      have := abs_nonneg c
      linarith
    have hgv : g (mk (|c| + 1)) = c := hgc hne
    show ¬ ‖mk (|c| + 1)‖ = g (mk (|c| + 1))
    rw [hgv, norm_mk]
    intro h2
    have h3 : |(|c| + 1)| = |c| + 1 := abs_of_pos (by positivity)
    rw [h3] at h2
    have := le_abs_self c
    linarith
  have hcompl : ({0}ᶜ : Set R0) ⊆ T := by
    rcases meas_cases hT with h1 | h1
    · exfalso
      have : (|c| + 1 : ℝ) = 0 := mk_eq_zero (Set.mem_singleton_iff.mp (h1 hp))
      have := abs_nonneg c
      linarith
    · exact h1
  have hzero : (fun x : R0 => ‖x‖) =ᵐ[Q] fun _ => (0 : ℝ) := by
    rw [Filter.EventuallyEq, ae_iff]
    refine measure_mono_null ?_ (measure_mono_null hcompl hQT)
    intro x hx
    exact ne_zero_of_norm hx
  rw [integral_congr_ae hzero, integral_zero]

theorem int_dirac : Integrable (fun x : R0 => ‖x‖) (Measure.dirac 0) := by
  have hzero : (fun _ => (0 : ℝ)) =ᵐ[Measure.dirac (0 : R0)] fun x : R0 => ‖x‖ := by
    rw [Filter.EventuallyEq, ae_iff]
    refine measure_mono_null (t := ({0}ᶜ : Set R0)) ?_ ?_
    · intro x hx
      exact ne_zero_of_norm (fun h => hx h.symm)
    · rw [Measure.dirac_apply' _ meas_zero.compl]
      simp
  exact (integrable_zero R0 ℝ _).congr hzero

theorem emp_eq : WassersteinDRO.Regularization.empiricalDistribution (fun _ : Fin 1 => (0 : R0))
    = Measure.dirac 0 := by
  simp [WassersteinDRO.Regularization.empiricalDistribution]

theorem lip_ge : (1 : ENNReal) ≤
    WassersteinDRO.Regularization.lipschitzModulus (fun x : R0 => ‖x‖) := by
  unfold WassersteinDRO.Regularization.lipschitzModulus
  have hne : (mk 1) ≠ 0 := mk_ne_zero one_ne_zero
  refine le_iSup_of_le (mk 1) (le_iSup_of_le 0 (le_iSup_of_le hne ?_))
  have h1 : ‖(mk 1)‖ = 1 := by rw [norm_mk]; simp
  show (1 : ENNReal) ≤ ENNReal.ofReal (|‖mk 1‖ - ‖(0 : R0)‖| / ‖mk 1 - 0‖)
  rw [sub_zero, norm_zero, sub_zero, h1]
  simp

theorem cex : ¬ (∀ {E : Type} [MeasurableSpace E] [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ε : ℝ) (hε : 0 ≤ ε) {N : ℕ} (hN : 0 < N) (ξhat : Fin N → E)
    (ℓ : E → ℝ) (hconv : ConvexOn ℝ Set.univ ℓ)
    (hℓ : Integrable ℓ (WassersteinDRO.Regularization.empiricalDistribution ξhat)),
    WassersteinDRO.Regularization.worstCaseRisk ε 1 Set.univ
        (WassersteinDRO.Regularization.empiricalDistribution ξhat) ℓ =
      (WassersteinDRO.Regularization.nominalRisk
          (WassersteinDRO.Regularization.empiricalDistribution ξhat) ℓ : EReal) +
        ((ENNReal.ofReal ε * WassersteinDRO.Regularization.lipschitzModulus ℓ : ENNReal) :
          EReal)) := by
  intro h
  have key := @h R0 msR0 _ _ 1 zero_le_one 1 one_pos (fun _ => 0) (fun x => ‖x‖)
    (convexOn_norm convex_univ) (by rw [emp_eq]; exact int_dirac)
  have hL : WassersteinDRO.Regularization.worstCaseRisk 1 1 Set.univ
      (WassersteinDRO.Regularization.empiricalDistribution (fun _ : Fin 1 => (0 : R0)))
      (fun x : R0 => ‖x‖) ≤ 0 := by
    unfold WassersteinDRO.Regularization.worstCaseRisk
    refine iSup_le fun Q => iSup_le fun _ => iSup_le fun hQ => ?_
    unfold WassersteinDRO.Regularization.nominalRisk
    rw [risk_eq_zero Q hQ]
    simp
  have hR : (1 : EReal) ≤
      (WassersteinDRO.Regularization.nominalRisk
          (WassersteinDRO.Regularization.empiricalDistribution (fun _ : Fin 1 => (0 : R0)))
          (fun x : R0 => ‖x‖) : EReal) +
        ((ENNReal.ofReal 1 *
            WassersteinDRO.Regularization.lipschitzModulus (fun x : R0 => ‖x‖) : ENNReal) :
          EReal) := by
    rw [emp_eq]
    unfold WassersteinDRO.Regularization.nominalRisk
    rw [risk_eq_zero _ int_dirac, ENNReal.ofReal_one, one_mul]
    simp only [EReal.coe_zero, zero_add]
    exact_mod_cast lip_ge
  rw [← key] at hR
  have h10 := hR.trans hL
  exact (not_le.mpr zero_lt_one) h10

