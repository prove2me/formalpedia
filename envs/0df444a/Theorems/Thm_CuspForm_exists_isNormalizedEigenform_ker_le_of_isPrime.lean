theorem CuspForm.exists_isNormalizedEigenform_ker_le_of_isPrime {N : ℕ} [NeZero N] (hN : CuspForm.HasIntegralStructure N 2) (𝔭 : Ideal (CuspForm.heckeAlgebra N 2 {ℓ | ℓ ∣ N})) (h𝔭 : 𝔭.IsPrime) (hchar : ∀ n : ℤ, algebraMap ℤ (CuspForm.heckeAlgebra N 2 {ℓ | ℓ ∣ N}) n ∈ 𝔭 → n = 0) : ∃ (f : CuspForm (CongruenceSubgroup.Gamma0 N) 2), f.IsNormalizedEigenform ∧ ∀ t : CuspForm.heckeAlgebra N 2 {ℓ | ℓ ∣ N}, (t : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2)) f = 0 → t ∈ 𝔭 := by sorry
