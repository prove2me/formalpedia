    (R0 : List Item) (h0 : s.G 0 = ints L ++ R0) (hB : ∀ x ∈ L, zsz (f x) ≤ B)
    (hb : ∀ (st : IState HS) (x : ℤ) (L0 : List Item), Fixd s st → st.G 0 = .int x :: L0 →
      x ∈ L → IRuns I iprog body st ((st.upd 0 L0).upd pO (.int (f x) :: st.G pO)) c)
    (LX : List Item) (hX : s.G nX = .int (L.length : ℤ) :: LX) :
    IRuns I iprog (itemPU body) s (s.upd 0 (ints (L.map f) ++ R0))
      (L.length * (c + 64) + 60 + cRpt L.length +
