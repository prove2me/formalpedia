    (hA0 : 1 ≤ vol A0) (hq : 1 ≤ q) (hB : 1 ≤ vol B) (hC : 1 ≤ vol Cs)
    (hV : zsz ((vol (A0 ++ q :: (B ++ q :: Cs)) : ℕ) : ℤ) ≤ Bb)
    (ga : GoodE t Bb a) (gq : GoodE t Bb eq) (gb : GoodE t Bb b) (gc : GoodE t Bb c)
    (ea : a.eval t = vol A0) (eq' : eq.eval t = q) (eb : b.eval t = vol B) (ec : c.eval t = vol Cs) :
    IRuns I iprog (swapEF a eq b c) t
      (t.upd 0 (ints (AModel.pull (A0 ++ q :: (B ++ q :: Cs)) (A0 ++ q :: (B ++ q :: Cs))
        (swapPos A0.length (A0.length + 1 + B.length)) 0 xs) ++ R))
      (cSwapEF a eq b c q (vol (A0 ++ q :: (B ++ q :: Cs))) Bb w) := by
  set V := vol (A0 ++ q :: (B ++ q :: Cs))
  have hVe : V = vol A0 * (q * (vol B * (q * vol Cs))) := by
    simp only [V, vol_append, vol_cons]
  have hle : ∀ x : ℕ, x ≤ V → zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (zsz_nat_le hx) hV
  have hBq : vol (B ++ [q]) = vol B * q := by simp [vol_append, vol]
  have hqC : vol ([q] ++ Cs) = q * vol Cs := by simp [vol_append, vol]
  have hBq1 : 1 ≤ vol (B ++ [q]) := by rw [hBq]; exact Nat.mul_pos hB hq
  have hqC1 : 1 ≤ vol ([q] ++ Cs) := by rw [hqC]; exact Nat.mul_pos hq hC
  have lBq : vol B * q ≤ V := by
    rw [hVe]
    calc vol B * q ≤ vol B * (q * vol Cs) := Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right _ hC)
      _ ≤ q * (vol B * (q * vol Cs)) := Nat.le_mul_of_pos_left _ hq
      _ ≤ _ := Nat.le_mul_of_pos_left _ hA0
  have lqC : q * vol Cs ≤ V := by
    rw [hVe]
    calc q * vol Cs ≤ vol B * (q * vol Cs) := Nat.le_mul_of_pos_left _ hB
      _ ≤ q * (vol B * (q * vol Cs)) := Nat.le_mul_of_pos_left _ hq
      _ ≤ _ := Nat.le_mul_of_pos_left _ hA0
  have l1 : vol A0 ≤ V := by
    rw [hVe]; exact Nat.le_mul_of_pos_right _ (Nat.mul_pos hq (Nat.mul_pos hB (Nat.mul_pos hq hC)))
  have l2 : q ≤ V := by
    rw [hVe]
    exact le_trans (Nat.le_mul_of_pos_right _ (Nat.mul_pos hB (Nat.mul_pos hq hC)))
      (Nat.le_mul_of_pos_left _ hA0)
  have l4 : vol Cs ≤ V := le_trans (Nat.le_mul_of_pos_left _ hq) lqC
  have l5 : vol B ≤ V := le_trans (Nat.le_mul_of_pos_right _ hq) lBq
  -- parameter lists
  set l1L : List (Fin HS × Ex HS) := [(1, a), (2, eq), (3, .mul b eq), (4, c)]
  set l2L : List (Fin HS × Ex HS) := [(1, a), (2, eq), (3, b), (4, .mul eq c)]
  have gbq : GoodE t Bb (.mul b eq) := goodE_mul gb gq (by rw [eb, eq']; exact_mod_cast hle _ lBq)
  have gqc : GoodE t Bb (.mul eq c) := goodE_mul gq gc (by rw [eq', ec]; exact_mod_cast hle _ lqC)
  have P1 : PushOK t Bb l1L := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l1L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> assumption)
  have P2 : PushOK t Bb l2L := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl <;> assumption)
  have v1 : ∀ p ∈ l1L, zsz (p.2.eval t) ≤ Bb := by
    intro p hp; simp only [l1L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · simp only; rw [ea]; exact hle _ l1
    · simp only; rw [eq']; exact hle _ l2
    · simp only [Ex.eval]; rw [eb, eq']; exact_mod_cast hle _ lBq
    · simp only; rw [ec]; exact hle _ l4
  have v2 : ∀ p ∈ l2L, zsz (p.2.eval t) ≤ Bb := by
    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · simp only; rw [ea]; exact hle _ l1
    · simp only; rw [eq']; exact hle _ l2
    · simp only; rw [eb]; exact hle _ l5
    · simp only [Ex.eval]; rw [eq', ec]; exact_mod_cast hle _ lqC
  -- the pushed states
  have st1 : ∀ i : Fin HS, (pushSt t (evalP t l1L)).G i =
      if i = 1 then .int (vol A0) :: t.G 1 else if i = 2 then .int q :: t.G 2 else
      if i = 3 then .int ((vol (B ++ [q]) : ℕ) : ℤ) :: t.G 3 else
      if i = 4 then .int (vol Cs) :: t.G 4 else t.G i := by
    intro i
    simp only [l1L, evalP_eq, List.map_cons, List.map_nil, pushSt, Ex.eval, ea, eq', eb, ec, hBq]
    by_cases h1 : i = 1
    · subst h1; simp
    by_cases h2 : i = 2
    · subst h2; simp
    by_cases h3 : i = 3
    · subst h3; simp
    by_cases h4 : i = 4
    · subst h4; simp
    simp [h1, h2, h3, h4, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4]
  set mid := AModel.pull (A0 ++ [q] ++ (B ++ [q]) ++ Cs) (A0 ++ (B ++ [q]) ++ [q] ++ Cs)
    (swapMid A0.length 1 (B ++ [q]).length) 0 xs
  have M1 := KFC.moveFieldF_spec (I := I) (iprog := iprog) (pushSt t (evalP t l1L)) xs A0 (B ++ [q]) Cs q w R (t.G 1) (t.G 2)
    (t.G 3) (t.G 4) (by rw [hlen]; simp [V]) hb hC hBq1 hq hA0
    (by rw [st1]; simp [h0])
    (by rw [st1]; simp) (by rw [st1]; simp) (by rw [st1]; simp) (by rw [st1]; simp)
  have S1 := IRuns.withPushI (I := I) (iprog := iprog) l1L KFC.fwdF t Bb P1 v1 (by simp [l1L]) mid R _ M1
  have hmid : mid.length = vol (A0 ++ B ++ [q] ++ ([q] ++ Cs)) := by
    simp only [mid, length_pull, List.append_assoc, List.singleton_append, List.cons_append]
  set t1 := t.upd 0 (ints mid ++ R)
  have hG1 : ∀ i : Fin HS, i ≠ 0 → t1.G i = t.G i := fun i hi => by simp [t1, hi]
  have g1 : ∀ {e : Ex HS}, GoodE t Bb e → GoodE t1 Bb e ∧ e.eval t1 = e.eval t := by
    intro e ge
    have hc := Ex.congrG (s := t) (s' := t1) e (fun r hr => by
      have := ge.rd r hr
      rw [hG1 r this.ne0])
    exact ⟨⟨ge.rd, hc.2.1.1 ge.ok, (hc.2.2.1 Bb).1 ge.bnd⟩, hc.1.symm⟩
  have P2' : PushOK t1 Bb l2L := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact (g1 ga).1
    · exact (g1 gq).1
    · exact (g1 gb).1
    · exact (g1 gqc).1)
  have v2' : ∀ p ∈ l2L, zsz (p.2.eval t1) ≤ Bb := by
    intro p hp
    have hp' := hp
    simp only [l2L, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · rw [(g1 ga).2]; exact v2 _ hp'
    · rw [(g1 gq).2]; exact v2 _ hp'
    · rw [(g1 gb).2]; exact v2 _ hp'
    · rw [(g1 gqc).2]; exact v2 _ hp'
  have st2 : ∀ i : Fin HS, (pushSt t1 (evalP t1 l2L)).G i =
      if i = 1 then .int (vol A0) :: t.G 1 else if i = 2 then .int q :: t.G 2 else
      if i = 3 then .int (vol B) :: t.G 3 else
      if i = 4 then .int ((vol ([q] ++ Cs) : ℕ) : ℤ) :: t.G 4 else t1.G i := by
    intro i
    have e1 := (g1 ga).2; have e2 := (g1 gq).2; have e3 := (g1 gb).2; have e4 := (g1 gc).2
    simp only [l2L, evalP_eq, List.map_cons, List.map_nil, pushSt, Ex.eval] at e1 e2 e3 e4 ⊢
    rw [e1, e2, e3, e4, ea, eq', eb, ec, hqC]
    by_cases h1 : i = 1
    · subst h1; simp [hG1 1 (by decide)]
    by_cases h2 : i = 2
    · subst h2; simp [hG1 2 (by decide)]
    by_cases h3 : i = 3
    · subst h3; simp [hG1 3 (by decide)]
    by_cases h4 : i = 4
    · subst h4; simp [hG1 4 (by decide)]
    simp [h1, h2, h3, h4, Ne.symm h1, Ne.symm h2, Ne.symm h3, Ne.symm h4]
  have M2 := KFC.moveFieldBackF_spec (I := I) (iprog := iprog) (pushSt t1 (evalP t1 l2L)) mid A0 B ([q] ++ Cs) q w R (t.G 1)
    (t.G 2) (t.G 3) (t.G 4) hmid (NLogN.KIL.bnd_pull hb) hqC1 hB hq hA0
    (by rw [st2]; simp [t1]) (by rw [st2]; simp) (by rw [st2]; simp) (by rw [st2]; simp)
    (by rw [st2]; simp)
  have S2 := IRuns.withPushI (I := I) (iprog := iprog) l2L KFC.bwdF t1 Bb P2' v2' (by simp [l2L]) _ R _ M2
  rw [IState.upd_upd_same] at S2
  rw [pull_two_moves] at S2
  refine (S1.seq S2).mono ?_
  -- cost
  have c1 : KFC.cFwdF (vol A0) q (vol (B ++ [q])) (vol Cs) w ≤ (2 * q + 67) * KFC.kap w * V := by
    have := KFC.cFwdF_le (vol A0) q (vol (B ++ [q])) (vol Cs) w hC hBq1 hq hA0
    have e : vol A0 * q * vol (B ++ [q]) * vol Cs = V := by rw [hVe, hBq]; ring
    rw [e] at this; exact this
  have c2 : KFC.cBwdF (vol A0) q (vol B) (vol ([q] ++ Cs)) w ≤ (2 * q + 69) * KFC.kap w * V := by
    have := KFC.cBwdF_le (vol A0) q (vol B) (vol ([q] ++ Cs)) w hqC1 hB hq hA0
    have e : vol A0 * q * vol B * vol ([q] ++ Cs) = V := by rw [hVe, hqC]; ring
    rw [e] at this; exact this
  unfold cSwapEF
  simp only [l1L, l2L, List.length_cons, List.length_nil] at *
  omega

end Swap

