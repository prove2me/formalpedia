  rw [List.take_add_one, List.getElem?_eq_getElem hl]
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hl]

theorem wtZ_snoc (F : ℤ) (Q : ℕ) : ∀ (j : ℕ) (A : List ℤ) (a : ℤ),
    wtZ F Q j (A ++ [a]) = wtZ F Q j A ++ [(a * 2 ^ ((j + A.length) * Q)) % F]
  | j, [], a => by simp [wtZ]
  | j, b :: A, a => by
    simp only [List.cons_append, wtZ, List.length_cons]
    rw [wtZ_snoc F Q (j + 1) A a]
    simp only [List.cons_append, List.cons.injEq, true_and]
    congr 4; ring

theorem prepStep_runs (s : IState NS) (n M Q e : ℕ) (y c : ℤ) (LX LW LC LM LQ LN LF : List Item)
    (hM : M ≤ n) (he : e ≤ n) (hQ : Q ≤ n) (hc : zsz c ≤ n)
    (hX : s.G XA = .int y :: LX) (hW : s.G W = .int (2 ^ e) :: LW) (hC : s.G CC = .int c :: LC)
    (hRM : s.G RM = .int (2 ^ M) :: LM) (hRQ : s.G RQ = .int (2 ^ Q) :: LQ)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog prepStep s
      ((((s.upd XA (.int (sg y (y.natAbs / 2 ^ M)) :: LX)).upd QS
        (.int ((sg y (y.natAbs % 2 ^ M) * 2 ^ e) % (2 ^ n + 1)) :: s.G QS)).upd W
          (.int (2 ^ (e + Q)) :: LW)).upd CC (.int (c + -1) :: LC))
      (30000 * (n + 3)) := by
  set r := sg y (y.natAbs % 2 ^ M) with hr
  have hrb : r.natAbs < 2 ^ M := by rw [hr, natAbs_sg]; exact Nat.mod_lt _ (by positivity)
  have hzr : zsz r ≤ M := zsz_le_of_lt hrb
  have h1 : IRuns I iprog (.seq (.op (.split XA RM T4)) (.op (.shl T4 W))) s
      ((s.upd XA (.int (sg y (y.natAbs / 2 ^ M)) :: LX)).upd T4 (.int (r * 2 ^ e) :: s.G T4))
      (1000 * (n + 1)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hX, hW, hRM]
    refine ⟨by clear * - hr; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := splitCost_le M; have := shlCost_le e
    omega
  set s1 := (s.upd XA (.int (sg y (y.natAbs / 2 ^ M)) :: LX)).upd T4 (.int (r * 2 ^ e) :: s.G T4)
    with hs1
  have hbd : (r * 2 ^ e).natAbs < 2 ^ (2 * n + 1) := by
    rw [Int.natAbs_mul, Int.natAbs_pow]
    simp only [Int.reduceAbs]
    calc r.natAbs * 2 ^ e < 2 ^ M * 2 ^ e := by
          exact Nat.mul_lt_mul_of_pos_right hrb (by positivity)
      _ = 2 ^ (M + e) := by rw [pow_add]
      _ ≤ 2 ^ (2 * n + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have h2 := fred_runs (I := I) (iprog := iprog) (X := T4) (by decide) (by decide) (by decide)
    (by decide) s1 (r * 2 ^ e) n (s.G T4) LN LF (by simp [s1])
    (by simp +decide [s1, hN]) (by simp +decide [s1, hF]) hbd
  set x := (r * 2 ^ e) % (2 ^ n + 1) with hx
  have hx0 : 0 ≤ x := Int.emod_nonneg _ (by positivity)
  have hx1 : x < 2 ^ n + 1 := Int.emod_lt_of_pos _ (by positivity)
  have h1n : (1 : ℤ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  have hzx : zsz x ≤ n + 1 := zsz_le_of_abs (by
    rw [abs_lt, pow_succ]; constructor <;> linarith)
  have h3g : ∀ s' : IState NS, s'.G T4 = .int x :: s.G T4 → s'.G W = .int (2 ^ e) :: LW →
      s'.G RQ = .int (2 ^ Q) :: LQ → s'.G CC = .int c :: LC →
      IRuns I iprog (.seq (.op (.mv T4 QS)) (.seq (.op (.shl W RQ)) (decC CC))) s'
        ((((s'.upd T4 (s.G T4)).upd QS (.int x :: s'.G QS)).upd W (.int (2 ^ (e + Q)) :: LW)).upd
          CC (.int (c + -1) :: LC)) (5000 * (n + 3)) := by
    intro s' h4 hW' hQ' hC'
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, h4, hW', hQ', hC', zsz_neg_one, pow_add]
    refine ⟨by clear * -; (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide), ?_⟩
    have := moveIntCost_le (zsz x); have := shlCost_le Q
    have := addIntCost_mono (show zsz c + 1 ≤ n + 1 by omega)
    have := addIntCost_le (n + 1)
    omega
  have h3 := h3g (s1.upd T4 (.int x :: s.G T4)) (by simp) (by simp +decide [s1, hW])
    (by simp +decide [s1, hRQ]) (by simp +decide [s1, hC])
  refine (IRuns.seq_assoc (IRuns.seq h1 (IRuns.seq h2 h3))).mono' ?_ ?_
  swap; · omega
  simp only [hs1]
  have : (s.upd XA (Item.int (sg y (y.natAbs / 2 ^ M)) :: LX)).G QS = s.G QS := by simp +decide
  clear * -
  (apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)

end NLogN

end

section
open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
theorem solution (s : IState NS) (n M Q K : ℕ) (x : ℤ) (LX LW LC LM LQ LN LF : List Item)
    (hKQ : K * Q = n) (hM : M ≤ n) (hQ : Q ≤ n) (hK : zsz (K : ℤ) ≤ n)
    (hX : s.G XA = .int x :: LX) (hW : s.G W = .int 1 :: LW) (hC : s.G CC = .int K :: LC)
    (hRM : s.G RM = .int (2 ^ M) :: LM) (hRQ : s.G RQ = .int (2 ^ Q) :: LQ)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) prepStep) s
      ((((s.upd XA (.int (qit M K x) :: LX)).upd QS
        ((ints (wtZ (2 ^ n + 1) Q 0 (pcs M K x))).reverse ++ s.G QS)).upd W
          (.int (2 ^ n) :: LW)).upd CC (.int 0 :: LC))
      (K * (30000 * (n + 3) + 30) + 30) := by
  set PL := pcs M K x with hPL
  let ss : ℕ → IState NS := fun i =>
    (((s.upd XA (.int (qit M i x) :: LX)).upd QS
      ((ints (wtZ (2 ^ n + 1) Q 0 (PL.take i))).reverse ++ s.G QS)).upd W
        (.int (2 ^ (i * Q)) :: LW)).upd CC (.int ((K - i : ℕ) : ℤ) :: LC)
  have h0 : ss 0 = s := by
    apply IState.ext' <;> intros <;> simp [ss, qit, wtZ, hX, hW, hC] <;> split_ifs <;> simp_all
  have hk : ss K = ((((s.upd XA (.int (qit M K x) :: LX)).upd QS
      ((ints (wtZ (2 ^ n + 1) Q 0 PL)).reverse ++ s.G QS)).upd W
        (.int (2 ^ n) :: LW)).upd CC (.int 0 :: LC)) := by
    have : PL.take K = PL := List.take_of_length_le (by rw [hPL, length_pcs])
    simp [ss, this, hKQ]
  have := IRuns.loop' (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := prepStep) ss (30000 * (n + 3)) K
    (by intro i hi; simp +decide [ss]; omega)
    (by simp +decide [ss])
    (by
      intro i hi
      have hiQ : i * Q + Q ≤ n := by rw [← hKQ]; nlinarith
      have hc : zsz (((K - i : ℕ) : ℤ)) ≤ n := le_trans (zsz_natCast_le (by omega)) hK
      have hst := prepStep_runs (I := I) (iprog := iprog) (ss i) n M Q (i * Q) (qit M i x)
        ((K - i : ℕ) : ℤ) LX LW LC LM LQ LN LF hM (by omega) hQ hc
        (by simp +decide [ss]) (by simp +decide [ss]) (by simp +decide [ss])
        (by simp +decide [ss, hRM]) (by simp +decide [ss, hRQ]) (by simp +decide [ss, hN])
        (by simp +decide [ss, hF])
      refine hst.mono' ?_ le_rfl
      have e1 := pcs_take_succ M K x hi
      have e2 := wtZ_snoc (2 ^ n + 1) Q 0 (PL.take i) (PL.getD i 0)
      have e3 : (PL.take i).length = i := by rw [List.length_take, hPL, length_pcs]; omega
      rw [e3, zero_add] at e2
      have e4 := pcs_getD M i K x hi
      have e5 : (((K - i : ℕ) : ℤ) + -1) = ((K - (i + 1) : ℕ) : ℤ) := by omega
      have e6 : i * Q + Q = (i + 1) * Q := by ring
      simp only [ss, ← hPL] at e1 e4 ⊢
      rw [e1, e2, e4, ints_append, e5, e6, ← qit_succ]
      apply IState.ext' <;> intros <;> simp [ints] <;> split_ifs <;> simp_all)
  rw [h0, hk] at this
  exact this
end
