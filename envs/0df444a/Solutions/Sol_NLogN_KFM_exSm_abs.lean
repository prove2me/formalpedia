    have hpos := h.2.2
    rw [abs_of_nonneg (Int.emod_nonneg _ hpos.ne')]
    have := Int.emod_lt_of_pos (a.eval s) hpos
    have := le_abs_self (b.eval s)
    have := NLogN.KFM.pow_mono_A hA (le_max_right (NLogN.KFM.exDg a) (NLogN.KFM.exDg b))
