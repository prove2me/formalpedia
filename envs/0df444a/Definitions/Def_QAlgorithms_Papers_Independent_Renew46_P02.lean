-- title:
--   Definitions for Abelian von Neumann algebras, measure algebras and L^\infty-spaces
-- statement:
--   The objects the formalized statements of *Abelian von Neumann algebras, measure algebras and L^\infty-spaces* (arXiv:2108.06406) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `HasMeasureSupport`: Measurable support; positivity concerns all positive-base-measure measurable subsets, rather than singletons. Section 4, PDF p.12.
--   - `IsEssentialSup`: Essential supremum via a.e. inclusion, Lemma 4.2, PDF p.13.
--   - `IsDedekindOn`: Dedekind completeness on a measurable part, PDF pp.6,13.
--   - `IsSemifiniteOn`: Every positive measurable set in the part contains a positive finite measurable subset. PDF pp.12--13.
--   - `IsRelativeSemifiniteOn`: Relative semifiniteness permits infinite nu(F), requiring only finite mu(F) and positive nu(F). Section 4, PDF p.12.
--   - `IsSemifinitePart`: The actual semifinite part: essential supremum of all positive finite sets, rather than an arbitrary split with no link to mu. PDF p.13.
--   - `HasPositiveMonotoneSuprema`: Positive monotone completeness of C(K). Nonempty directed subsets encode increasing nets, with actual norm bounds. PDF p.21.
--   - `IsPositiveRieszFunctional`: Positivity of a complex functional on compactly supported continuous functions. Real nonnegative functions have real nonnegative images. PDF p.22.
--   - `rieszOpen`: The source's open-set functional, PDF p.22. Suprema are in ENNReal.
--   - `rieszOuter`: First outer construction, equation (1), PDF p.22.
--   - `rieszBorelPart`: The inner-regular semifinite Borel part mu_0, PDF pp.22--23.
--   - `rieszExtension`: Exact outer extension mu_0^*, by Borel envelopes, PDF p.23.
--   - `IsCaratheodorySet`: The full Caratheodory measurable domain, PDF p.23.
--   - `IsDecomposableDomain`: Decomposability equations on a domain D with outer values m. The finite-measure partition covers the whole space, PDF p.5.
--   - `IsFremlinRadon`: Every clause of Definition 6.4, PDF p.27. The topology need not be second countable, metrizable, or locally compact.
--   - `HasCompletedBorelDomain`: Completed Borel domain: every measurable set differs from a Borel set by a subset of a Borel null set. PDF p.28.
--   - `HasNormalContinuousIntegral`: Normality of the integral on the positive selfadjoint part of C(K), as used in the proof of Lemma 7.18, PDF p.36.
--   - `HasAllSuprema`: Completeness without selecting a total supremum operation, Definitions 7.4--7.5, PDF pp.30--31.
--   - `BooleanMeasure`: Measure on a sigma-complete Boolean algebra, Definition 7.5, PDF p.31. Strict positivity and countable additivity are the defining properties.
--   - `IsLocalizableBoolean`: Localizable means Dedekind complete and semifinite, PDF p.31.
--   - `StonePoint`: Nonzero ring homomorphisms onto the two-element Boolean ring, expressed equivalently as unital lattice homomorphisms to Bool. PDF p.33.
--   - `stoneSet`: The prescribed characteristic set, Theorem 7.13, PDF p.33.
--   - `stoneTopology`: Topology generated by the prescribed characteristic sets, PDF pp.33--34. The open-set criterion itself is included in the theorem.
--   - `IsOrderClosedBoolean`: Order-closed Boolean subalgebras contain every ambient supremum, including the empty supremum. PDF pp.30--31,45.
--   - `CompletelyGenerates`: Complete generation via all order-closed Boolean subalgebras, PDF p.45.
--   - `HasInfiniteMaharamType`: Infinite Maharam type means no finite set completely generates B. Only used with completeness of B. PDF p.45.
-- source:
--   Abelian von Neumann algebras, measure algebras and L^\infty-spaces, arXiv:2108.06406v2, https://arxiv.org/abs/2108.06406v2

import Mathlib

/-!
Statements from Blecher--Goldstein--Labuschagne, arXiv:2108.06406v2.
Local definitions give bodies for this paper's concepts. Further operator-algebra
constructions are deferred explicitly. Compilation is pending the batch handoff.
-/

noncomputable section

open MeasureTheory Set
open scoped ENNReal Topology CompactlySupported

namespace QAlgorithms.Papers.Independent.Renew46.P02

universe u v

/-- Measurable support; positivity concerns all positive-base-measure
measurable subsets, rather than singletons. Section 4, PDF p.12. -/
def HasMeasureSupport {X : Type u} [MeasurableSpace X] (mu nu : Measure X) : Prop :=
  ∃ S : Set X, MeasurableSet S ∧ nu Sᶜ = 0 ∧
    ∀ E : Set X, MeasurableSet E → E ⊆ S → 0 < mu E → 0 < nu E

/-- Essential supremum via a.e. inclusion, Lemma 4.2, PDF p.13. -/
def IsEssentialSup {X : Type u} [MeasurableSpace X] (mu : Measure X)
    (C : Set (Set X)) (S : Set X) : Prop :=
  MeasurableSet S ∧ (∀ E ∈ C, mu (E \ S) = 0) ∧
    ∀ T : Set X, MeasurableSet T → (∀ E ∈ C, mu (E \ T) = 0) → mu (S \ T) = 0

/-- Dedekind completeness on a measurable part, PDF pp.6,13. -/
def IsDedekindOn {X : Type u} [MeasurableSpace X] (mu : Measure X) (S : Set X) : Prop :=
  ∀ C : Set (Set X), (∀ E ∈ C, MeasurableSet E ∧ E ⊆ S) →
    ∃ T : Set X, T ⊆ S ∧ IsEssentialSup mu C T

/-- Every positive measurable set in the part contains a positive finite
measurable subset. PDF pp.12--13. -/
def IsSemifiniteOn {X : Type u} [MeasurableSpace X] (mu : Measure X) (S : Set X) : Prop :=
  ∀ E : Set X, MeasurableSet E → E ⊆ S → 0 < mu E →
    ∃ F : Set X, MeasurableSet F ∧ F ⊆ E ∧ 0 < mu F ∧ mu F < ⊤

/-- Relative semifiniteness permits infinite nu(F), requiring only finite
mu(F) and positive nu(F). Section 4, PDF p.12. -/
def IsRelativeSemifiniteOn {X : Type u} [MeasurableSpace X]
    (mu nu : Measure X) (S : Set X) : Prop :=
  ∀ E : Set X, MeasurableSet E → E ⊆ S → 0 < nu E →
    ∃ F : Set X, MeasurableSet F ∧ F ⊆ E ∧ mu F < ⊤ ∧ 0 < nu F

/-- The actual semifinite part: essential supremum of all positive finite
sets, rather than an arbitrary split with no link to mu. PDF p.13. -/
def IsSemifinitePart {X : Type u} [MeasurableSpace X] (mu : Measure X) (S : Set X) : Prop :=
  IsEssentialSup mu {E | MeasurableSet E ∧ 0 < mu E ∧ mu E < ⊤} S

example {X : Type u} [MeasurableSpace X] (mu : Measure X) :
    HasMeasureSupport mu (0 : Measure X) := by
  refine ⟨∅, MeasurableSet.empty, by simp, ?_⟩
  intro E hE hsub hpos
  have hzero : E = ∅ := Set.eq_empty_iff_forall_notMem.mpr (fun x hx => hsub hx)
  simp [hzero] at hpos

example {X : Type u} [MeasurableSpace X] (mu : Measure X) :
    IsEssentialSup mu ∅ ∅ := by
  simp [IsEssentialSup]

/-- Positive monotone completeness of C(K). Nonempty directed subsets
encode increasing nets, with actual norm bounds. PDF p.21. -/
def HasPositiveMonotoneSuprema (K : Type u) [TopologicalSpace K] [CompactSpace K] : Prop :=
  ∀ S : Set C(K, ℝ), S.Nonempty → DirectedOn (· ≤ ·) S →
    (∀ f ∈ S, 0 ≤ f) → (∃ R : ℝ, ∀ f ∈ S, ‖f‖ ≤ R) →
    ∃ f : C(K, ℝ), IsLUB S f

/-- Positivity of a complex functional on compactly supported continuous
functions. Real nonnegative functions have real nonnegative images. PDF p.22. -/
def IsPositiveRieszFunctional {X : Type u} [TopologicalSpace X]
    (I : C_c(X, ℂ) →ₗ[ℂ] ℂ) : Prop :=
  ∀ f : C_c(X, ℂ), (∀ x, (f x).im = 0 ∧ 0 ≤ (f x).re) →
    (I f).im = 0 ∧ 0 ≤ (I f).re

/-- The source's open-set functional, PDF p.22. Suprema are in ENNReal. -/
def rieszOpen {X : Type u} [TopologicalSpace X]
    (I : C_c(X, ℂ) →ₗ[ℂ] ℂ) (U : Set X) : ℝ≥0∞ :=
  ⨆ f : {f : C_c(X, ℂ) | (∀ x, (f x).im = 0 ∧ 0 ≤ (f x).re ∧ (f x).re ≤ 1) ∧
    tsupport (fun x => f x) ⊆ U}, ENNReal.ofReal (I f.val).re

/-- First outer construction, equation (1), PDF p.22. -/
def rieszOuter {X : Type u} [TopologicalSpace X]
    (I : C_c(X, ℂ) →ₗ[ℂ] ℂ) (E : Set X) : ℝ≥0∞ :=
  ⨅ U : {U : Set X | IsOpen U ∧ E ⊆ U}, rieszOpen I U.val

/-- The inner-regular semifinite Borel part mu_0, PDF pp.22--23. -/
def rieszBorelPart {X : Type u} [TopologicalSpace X]
    (I : C_c(X, ℂ) →ₗ[ℂ] ℂ) (E : Set X) : ℝ≥0∞ :=
  ⨆ K : {K : Set X | IsCompact K ∧ K ⊆ E}, rieszOuter I K.val

/-- Exact outer extension mu_0^*, by Borel envelopes, PDF p.23. -/
def rieszExtension {X : Type u} [TopologicalSpace X]
    (I : C_c(X, ℂ) →ₗ[ℂ] ℂ) (E : Set X) : ℝ≥0∞ :=
  ⨅ B : {B : Set X | MeasurableSet[borel X] B ∧ E ⊆ B}, rieszBorelPart I B.val

/-- The full Caratheodory measurable domain, PDF p.23. -/
def IsCaratheodorySet {X : Type u} (m : Set X → ℝ≥0∞) (E : Set X) : Prop :=
  ∀ A : Set X, m A = m (A ∩ E) + m (A \ E)

/-- Decomposability equations on a domain D with outer values m.
The finite-measure partition covers the whole space, PDF p.5. -/
def IsDecomposableDomain {X : Type u} (D : Set X → Prop) (m : Set X → ℝ≥0∞) : Prop :=
  ∃ C : Set (Set X), C.Pairwise Disjoint ∧ Set.sUnion C = Set.univ ∧
    (∀ K ∈ C, D K ∧ m K < ⊤) ∧
    (∀ E : Set X, D E ↔ ∀ K ∈ C, D (E ∩ K)) ∧
    ∀ E : Set X, D E → m E = ∑' K : C, m (E ∩ K.val)

/-- Every clause of Definition 6.4, PDF p.27. The topology need not be
second countable, metrizable, or locally compact. -/
def IsFremlinRadon {X : Type u} [TopologicalSpace X] [MeasurableSpace X]
    (mu : Measure X) : Prop :=
  (∀ E N : Set X, E ⊆ N → MeasurableSet N → mu N = 0 → MeasurableSet E) ∧
  (∀ E : Set X, (∀ F : Set X, MeasurableSet F → mu F < ⊤ → MeasurableSet (E ∩ F)) →
    MeasurableSet E) ∧
  T2Space X ∧
  (∀ U : Set X, IsOpen U → MeasurableSet U) ∧
  (∀ E : Set X, MeasurableSet E →
    mu E = ⨆ K : {K : Set X | IsCompact K ∧ K ⊆ E}, mu K.val) ∧
  (∀ x : X, ∃ U : Set X, IsOpen U ∧ x ∈ U ∧ mu U < ⊤)

/-- Completed Borel domain: every measurable set differs from a Borel set
by a subset of a Borel null set. PDF p.28. -/
def HasCompletedBorelDomain {X : Type u} [TopologicalSpace X] [MeasurableSpace X]
    (mu : Measure X) : Prop :=
  ∀ E : Set X, MeasurableSet E ↔ ∃ B N : Set X,
    MeasurableSet[borel X] B ∧ MeasurableSet[borel X] N ∧
      mu N = 0 ∧ ((E \ B) ∪ (B \ E)) ⊆ N

example {X : Type u} : IsCaratheodorySet (fun _ : Set X => (0 : ℝ≥0∞)) Set.univ := by
  simp [IsCaratheodorySet]

example {X : Type u} [TopologicalSpace X] :
    IsPositiveRieszFunctional (0 : C_c(X, ℂ) →ₗ[ℂ] ℂ) := by
  intro f hf
  simp

example {X : Type u} [TopologicalSpace X] (U : Set X) :
    rieszOpen (0 : C_c(X, ℂ) →ₗ[ℂ] ℂ) U = 0 := by
  simp [rieszOpen]

/-- Normality of the integral on the positive selfadjoint part of C(K),
as used in the proof of Lemma 7.18, PDF p.36. -/
def HasNormalContinuousIntegral {K : Type u} [TopologicalSpace K] [CompactSpace K]
    [MeasurableSpace K] (mu : Measure K) : Prop :=
  ∀ S : Set C(K, ℝ), S.Nonempty → DirectedOn (· ≤ ·) S →
    (∀ f ∈ S, 0 ≤ f) → (∃ R : ℝ, ∀ f ∈ S, ‖f‖ ≤ R) →
    ∀ f : C(K, ℝ), IsLUB S f →
      ENNReal.ofReal (∫ x, f x ∂mu) =
        ⨆ g : S, ENNReal.ofReal (∫ x, g.val x ∂mu)

/-- Completeness without selecting a total supremum operation,
Definitions 7.4--7.5, PDF pp.30--31. -/
def HasAllSuprema (B : Type u) [PartialOrder B] : Prop :=
  ∀ S : Set B, ∃ a : B, IsLUB S a

/-- Measure on a sigma-complete Boolean algebra, Definition 7.5, PDF p.31.
Strict positivity and countable additivity are the defining properties. -/
structure BooleanMeasure (B : Type u) [BooleanAlgebra B] where
  value : B → ℝ≥0∞
  zero_iff : ∀ a : B, value a = 0 ↔ a = ⊥
  sigma_complete : ∀ f : ℕ → B, ∃ a : B, IsLUB (Set.range f) a
  countable_add : ∀ f : ℕ → B, Pairwise (fun i j => Disjoint (f i) (f j)) →
    ∀ a : B, IsLUB (Set.range f) a → value a = ∑' n, value (f n)

/-- Localizable means Dedekind complete and semifinite, PDF p.31. -/
def IsLocalizableBoolean {B : Type u} [BooleanAlgebra B] (mu : BooleanMeasure B) : Prop :=
  HasAllSuprema B ∧ ∀ p : B, p ≠ ⊥ → ∃ q : B, q ≠ ⊥ ∧ q ≤ p ∧ mu.value q < ⊤

example {B : Type u} [BooleanAlgebra B] (mu : BooleanMeasure B) :
    mu.value ⊥ = 0 := by
  exact (mu.zero_iff ⊥).2 rfl

/-- Nonzero ring homomorphisms onto the two-element Boolean ring,
expressed equivalently as unital lattice homomorphisms to Bool. PDF p.33. -/
abbrev StonePoint (B : Type u) [BooleanAlgebra B] := BoundedLatticeHom B Bool

/-- The prescribed characteristic set, Theorem 7.13, PDF p.33. -/
def stoneSet {B : Type u} [BooleanAlgebra B] (a : B) : Set (StonePoint B) :=
  {z | z a = true}

/-- Topology generated by the prescribed characteristic sets, PDF pp.33--34.
The open-set criterion itself is included in the theorem. -/
def stoneTopology (B : Type u) [BooleanAlgebra B] : TopologicalSpace (StonePoint B) :=
  TopologicalSpace.generateFrom (Set.range (stoneSet (B := B)))

example {B : Type u} [BooleanAlgebra B] (a : B) (z : StonePoint B) :
    z ∈ stoneSet a ↔ z a = true := by
  rfl

/-- Order-closed Boolean subalgebras contain every ambient supremum,
including the empty supremum. PDF pp.30--31,45. -/
def IsOrderClosedBoolean {B : Type u} [BooleanAlgebra B] (C : BooleanSubalgebra B) : Prop :=
  ∀ S : Set B, S ⊆ C → ∃ a ∈ C, IsLUB S a

/-- Complete generation via all order-closed Boolean subalgebras, PDF p.45. -/
def CompletelyGenerates {B : Type u} [BooleanAlgebra B] (G : Set B) : Prop :=
  ∀ C : BooleanSubalgebra B, G ⊆ C → IsOrderClosedBoolean C → C = ⊤

/-- Infinite Maharam type means no finite set completely generates B.
Only used with completeness of B. PDF p.45. -/
def HasInfiniteMaharamType (B : Type u) [BooleanAlgebra B] : Prop :=
  ∀ G : Set B, G.Finite → ¬ CompletelyGenerates G

example {B : Type u} [BooleanAlgebra B] (hB : HasAllSuprema B) :
    CompletelyGenerates (Set.univ : Set B) := by
  intro C hsub hclosed
  apply top_unique
  intro b hb
  exact hsub (Set.mem_univ b)

end QAlgorithms.Papers.Independent.Renew46.P02


