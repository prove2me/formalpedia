/-- Matrix of frame components `F(e_A, e_B)`. -/
noncomputable def FfrM (F : TwoForm 4) (E : Fin 4 → Fin 4 → Pt 4 → ℂ) (x : Pt 4) : Matrix (Fin 4) (Fin 4) ℂ :=
