  Dominated.mono_right h hle

/-- `O(B) + O(B) = O(B)`. -/
protected theorem add (h₁ : Light.Sec3.Steps t₁ B) (h₂ : Light.Sec3.Steps t₂ B) : Light.Sec3.Steps (fun θ => t₁ θ + t₂ θ) B := by
  simpa only [Light.Sec3.Steps, Nat.cast_add] using Dominated.add h₁ h₂

/-- `O(B₁) · O(B₂) = O(B₁ B₂)`. -/
protected theorem mul (h₁ : Light.Sec3.Steps t₁ B₁) (h₂ : Light.Sec3.Steps t₂ B₂) :
    Light.Sec3.Steps (fun θ => t₁ θ * t₂ θ) fun θ => B₁ θ * B₂ θ := by
  simpa only [Light.Sec3.Steps, Nat.cast_mul] using
    Dominated.mul h₁ h₂ (fun _ _ => Nat.cast_nonneg _) fun _ _ => Nat.cast_nonneg _

