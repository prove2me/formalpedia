-- title:
--   (1.1), §2 p. 6, (3.1), (3.2), (3.11) — fBM on [0,1], dyadic interpolation, midpoint displacement, record-breakers and the last record level
-- statement:
--   This file fixes the objects of Sections 2–3 of Chen, Dong and Ni.
--
--   1. **Fractional Brownian motion.** For a Hurst index $H$, the covariance function (1.1) is
--   $$r(s,t)=\tfrac12\big(|s|^{2H}+|t|^{2H}-|s-t|^{2H}\big).$$
--   A process $B=\{B(t)\}$ on a probability space $(\Omega,\mathcal F,\mathbb P)$ is a *fractional Brownian motion on $[0,1]$* if each $B(t)$ is a random variable, $\{B(t)\}_{t\in[0,1]}$ is a Gaussian process (all finite-dimensional laws are Gaussian), $\mathbb E[B(t)]=0$ and $\operatorname{Cov}(B(s),B(t))=r(s,t)$ for $s,t\in[0,1]$.
--   2. **Dyadic grid.** $D_n=\{t^n_0,\dots,t^n_{2^n}\}$ with $t^n_i=i/2^n$.
--   3. **Dyadic discretization.** For a path $x:\mathbb R\to\mathbb R$, $B_n=x_n$ is the piecewise-linear interpolation of the values of $x$ on $D_n$: on $[t^n_i,t^n_{i+1}]$,
--   $$x_n(t)=x(t^n_i)+(2^nt-i)\big(x(t^n_{i+1})-x(t^n_i)\big),\qquad i=0,\dots,2^n-1 .$$
--   4. **Midpoint displacement** (3.1). For $k\ge1$ and $j=0,\dots,2^{k-1}-1$, $a^k_j=x(t^k_{2j+1})$, $b^k_j=\tfrac12\big(x(t^{k-1}_j)+x(t^{k-1}_{j+1})\big)$, and $\max_{0\le j\le 2^{k-1}-1}|a^k_j-b^k_j|$.
--   5. **Records.** With $\ell_k=2^{-(H-\delta)k}$, a record is broken at level $k\ge1$ if (3.11)
--   $$\max_{0\le j\le 2^{k-1}-1}|a^k_j-b^k_j|\ge\rho\,\ell_k,$$
--   and the last record level is $N=\sup\{k\ge1:\text{a record is broken at level }k\}\in\{0,1,2,\dots\}\cup\{\infty\}$, with $\sup\emptyset=0$.
--   6. **Auxiliary quantities.** $K(\nu)=\sup\{n\ge1:4\sqrt n>\nu\,2^{\delta n}\}$ (3.2); $e^{tN}$ as an extended nonnegative real with $e^{t\cdot\infty}=\infty$; and the $\sigma$-algebra $\sigma(B^H_k)$ generated by the values $B(t^k_0),\dots,B(t^k_{2^k})$, with respect to which the paper's conditional laws $\mathbb P_k(\cdot)=\mathbb P(\cdot\mid B^H_k)$ are taken.
--
--   Every statement of the mission is phrased through these objects.
--
--   **Formalization Note** The process is indexed by all of $\mathbb R$ but only $[0,1]$ is constrained. Path continuity is not part of the predicate; theorems that need it assume it almost surely (the paper's "we refer to the modification as the fBM", p. 5). Measurability of each $B(t)$ is part of the predicate, so the level $\sigma$-algebras are sub-$\sigma$-algebras and conditional expectations are genuine. $N$ is valued in $\mathbb N\cup\{\infty\}$, so infinitely many records give $N=\infty$, not a default value. For $\nu,\delta>0$ the set defining $K(\nu)$ is finite, so its natural-number supremum is the true maximum ($0$ if empty). The paper writes $B^H(0)=0$; this follows almost surely from the covariance at $s=t=0$ and is not a separate field.
-- source:
--   Chen, Dong & Ni, ε-Strong simulation of fractional Brownian motion and related stochastic differential equations, arXiv:1902.07824v1, pp. 1, 5–9, 12, (1.1), (3.1), (3.2), (3.11)

import Mathlib

namespace FBMStrongSim.RecordBreak

open MeasureTheory ProbabilityTheory
open scoped ENNReal

/-- The covariance function (1.1) of fractional Brownian motion with Hurst index `H`:
`r(s, t) = (|s|^{2H} + |t|^{2H} - |s - t|^{2H}) / 2`. -/
noncomputable def fbmCov (H s t : ℝ) : ℝ :=
  (|s| ^ (2 * H) + |t| ^ (2 * H) - |s - t| ^ (2 * H)) / 2

/-- `B` is a fractional Brownian motion with Hurst index `H` on `[0,1]` under `P` (§1 p. 1,
§2 p. 5): every coordinate is measurable, `(B t)_{t ∈ [0,1]}` is a Gaussian process, centered,
with covariance (1.1). Path continuity is not part of this predicate. -/
structure IsFBM {Ω : Type*} [MeasurableSpace Ω] (H : ℝ) (B : ℝ → Ω → ℝ) (P : Measure Ω) :
    Prop where
  measurable : ∀ t, Measurable (B t)
  gaussian : IsGaussianProcess (fun t : Set.Icc (0 : ℝ) 1 => B t) P
  centered : ∀ t ∈ Set.Icc (0 : ℝ) 1, P[B t] = 0
  covariance : ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
    cov[B s, B t; P] = fbmCov H s t

/-- The dyadic point `t^n_i = i / 2^n` of `D_n` (p. 6). -/
noncomputable def dyadic (n i : ℕ) : ℝ := (i : ℝ) / 2 ^ n

/-- The dyadic discretization `B^H_n` of level `n` of a path `x` (p. 6): the piecewise-linear
interpolation of the values of `x` on `D_n = {t^n_0, …, t^n_{2^n}}`. On `[t^n_i, t^n_{i+1}]`
(`i = 0, …, 2^n - 1`) it is `x(t^n_i) + (2^n t - i)(x(t^n_{i+1}) - x(t^n_i))`; the last interval
is closed on the right, so the value at `t = 1` is `x 1`. Only its values on `[0,1]` are used. -/
noncomputable def interp (x : ℝ → ℝ) (n : ℕ) (t : ℝ) : ℝ :=
  let i : ℕ := min ⌊(2 : ℝ) ^ n * t⌋₊ (2 ^ n - 1)
  x (dyadic n i) + ((2 : ℝ) ^ n * t - i) * (x (dyadic n (i + 1)) - x (dyadic n i))

/-- The midpoint displacement `a^k_j - b^k_j` of (3.1), p. 8, for a path `x` (used for `k ≥ 1`):
`a^k_j = x(t^k_{2j+1})`, `b^k_j = (x(t^{k-1}_j) + x(t^{k-1}_{j+1})) / 2`. -/
noncomputable def disp (x : ℝ → ℝ) (k j : ℕ) : ℝ :=
  x (dyadic k (2 * j + 1)) - (x (dyadic (k - 1) j) + x (dyadic (k - 1) (j + 1))) / 2

/-- `max_{0 ≤ j ≤ 2^{k-1} - 1} |a^k_j - b^k_j|` (p. 8). -/
noncomputable def maxDisp (x : ℝ → ℝ) (k : ℕ) : ℝ :=
  (Finset.range (2 ^ (k - 1))).sup' (by simp) (fun j => |disp x k j|)

/-- `ℓ_k = 2^{-(H-δ)k}` (p. 8). -/
noncomputable def ell (H δ : ℝ) (k : ℕ) : ℝ := (2 : ℝ) ^ (-(H - δ) * k)

/-- A record is broken at level `k ≥ 1` (3.11), p. 12:
`max_j |a^k_j - b^k_j| ≥ ρ ℓ_k`. -/
def IsRecord (ρ H δ : ℝ) (x : ℝ → ℝ) (k : ℕ) : Prop :=
  1 ≤ k ∧ ρ * ell H δ k ≤ maxDisp x k

/-- The level of the last record-breaker, `N = sup{k ≥ 1 : max_j |a^k_j - b^k_j| ≥ ρ ℓ_k}`
(p. 12), valued in `ℕ∞`: `sup ∅ = 0`, and `N = ⊤` if records are broken at infinitely many
levels. -/
noncomputable def lastRecord (ρ H δ : ℝ) (x : ℝ → ℝ) : ℕ∞ :=
  ⨆ (k : ℕ) (_ : IsRecord ρ H δ x k), (k : ℕ∞)

/-- `exp(t N)` as an extended nonnegative real, with `exp(t · ⊤) = ⊤`. -/
noncomputable def expMul (t : ℝ) (N : ℕ∞) : ℝ≥0∞ :=
  if N = ⊤ then ⊤ else ENNReal.ofReal (Real.exp (t * (N.toNat : ℝ)))

/-- `K(ν) = sup{n ≥ 1 : 4√n > ν · 2^{δn}}` (3.2), p. 8. For `ν, δ > 0` the set is finite;
`sup ∅ = 0`. -/
noncomputable def Knu (ν δ : ℝ) : ℕ :=
  sSup {n : ℕ | 1 ≤ n ∧ ν * (2 : ℝ) ^ (δ * n) < 4 * Real.sqrt n}

/-- The σ-algebra generated by the values `B^H_k = (B(t^k_0), …, B(t^k_{2^k}))` of the process on
`D_k`; conditioning on it is the paper's `P_k(·) = P(· | B^H_k)` (p. 9). -/
noncomputable def levelSigma {Ω : Type*} (B : ℝ → Ω → ℝ) (k : ℕ) : MeasurableSpace Ω :=
  MeasurableSpace.comap (fun ω (i : Fin (2 ^ k + 1)) => B (dyadic k i) ω) inferInstance

end FBMStrongSim.RecordBreak


