          · have hv' : v ∈ ModularCurve.qExpFrobeniusPlaceModL K (CohCarrier.GammaH (M / p) (ModularCurve.infSubgroup p M H hpM)) p '' (ModularCurve.ssPlacesQExp K (CohCarrier.GammaH (M / p) (ModularCurve.infSubgroup p M H hpM)) p) := by
