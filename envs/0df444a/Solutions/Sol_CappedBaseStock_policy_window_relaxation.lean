/- Begin Solutions.CappedMeanCompactness (SHA-256 2069d072331eadba99f7874b5b3e936a81c78eb5c1acff1be17176180174c0ab). -/
section CappedPolicyUploadModule14
noncomputable section
open Filter MeasureTheory CappedBaseStock
open scoped BigOperators Topology

namespace CappedMeanCompactness

/-- Two eventually bounded nonnegative real sequences have a common convergent subsequence.
Only the eventual tail needs to lie in the compact rectangle. -/
lemma extract_nonneg_pair (u v : ℕ → ℝ) (hu : ∀ n, 0 ≤ u n) (hv : ∀ n, 0 ≤ v n)
    (A B : ℝ) (huA : ∀ᶠ n in atTop, u n ≤ A) (hvB : ∀ᶠ n in atTop, v n ≤ B) :
    ∃ r z : ℝ, 0 ≤ r ∧ 0 ≤ z ∧ ∃ s : ℕ → ℕ, StrictMono s ∧
      Tendsto (fun j => u (s j)) atTop (𝓝 z) ∧
      Tendsto (fun j => v (s j)) atTop (𝓝 r) := by
  have hcompact : IsCompact (Set.Icc (0 : ℝ) A ×ˢ Set.Icc (0 : ℝ) B) :=
    isCompact_Icc.prod isCompact_Icc
  have hmem : ∀ᶠ n in atTop, (u n, v n) ∈ Set.Icc (0 : ℝ) A ×ˢ Set.Icc (0 : ℝ) B := by
    filter_upwards [huA, hvB] with n hnA hnB
    exact ⟨⟨hu n, hnA⟩, ⟨hv n, hnB⟩⟩
  obtain ⟨a, ha, s, hs, hlim⟩ := hcompact.tendsto_subseq' hmem.frequently
  exact ⟨a.2, a.1, ha.2.1, ha.1.1, s, hs, hlim.fst_nhds, hlim.snd_nhds⟩

/-- A weighted Lipschitz estimate on the nonnegative quadrant gives convergence
along arbitrary nonnegative convergent input sequences. -/
lemma tendsto_of_nonneg_lipschitz (F : ℝ → ℝ → ℝ) (m : ℝ)
    (hF : ∀ r z r' z', 0 ≤ r → 0 ≤ z → 0 ≤ r' → 0 ≤ z' →
      |F r z - F r' z'| ≤ |z - z'| + m * |r - r'|)
    (rseq zseq : ℕ → ℝ) (r z : ℝ)
    (hrseq : ∀ j, 0 ≤ rseq j) (hzseq : ∀ j, 0 ≤ zseq j)
    (hr : 0 ≤ r) (hz : 0 ≤ z)
    (hrlim : Tendsto rseq atTop (𝓝 r)) (hzlim : Tendsto zseq atTop (𝓝 z)) :
    Tendsto (fun j => F (rseq j) (zseq j)) atTop (𝓝 (F r z)) := by
  apply tendsto_iff_dist_tendsto_zero.mpr
  simp only [Real.dist_eq]
  have hrdiff : Tendsto (fun j => |rseq j - r|) atTop (𝓝 0) := by
    simpa using (hrlim.sub_const r).abs
  have hzdiff : Tendsto (fun j => |zseq j - z|) atTop (𝓝 0) := by
    simpa using (hzlim.sub_const z).abs
  have hbound : Tendsto (fun j => |zseq j - z| + m * |rseq j - r|) atTop (𝓝 0) := by
    simpa using hzdiff.add (hrdiff.const_mul m)
  exact squeeze_zero (fun _ => abs_nonneg _)
    (fun j => hF _ _ _ _ (hrseq j) (hzseq j) hr hz) hbound

/-- Expected deterministic-window inventory is continuous along nonnegative input means. -/
lemma integral_realInventory_tendsto (P : DemandLaw) (m : ℕ)
    (rseq zseq : ℕ → ℝ) (r z : ℝ)
    (hrseq : ∀ j, 0 ≤ rseq j) (hzseq : ∀ j, 0 ≤ zseq j)
    (hr : 0 ≤ r) (hz : 0 ≤ z)
    (hrlim : Tendsto rseq atTop (𝓝 r)) (hzlim : Tendsto zseq atTop (𝓝 z)) :
    Tendsto (fun j => ∫ d, CappedWindowIntegrals.realInventory d (rseq j) (zseq j) m
      ∂demandPathLaw P) atTop
      (𝓝 (∫ d, CappedWindowIntegrals.realInventory d r z m ∂demandPathLaw P)) := by
  exact tendsto_of_nonneg_lipschitz
    (fun r z => ∫ d, CappedWindowIntegrals.realInventory d r z m ∂demandPathLaw P)
    (m : ℝ)
    (fun r z r' z' hr hz hr' hz' =>
      CappedWindowApproximation.integral_realInventory_lipschitz P r z r' z' hr hz hr' hz' m)
    rseq zseq r z hrseq hzseq hr hz hrlim hzlim

/-- A vanishing additive error disappears from an eventual inequality. -/
lemma limit_le_of_le_add_vanishing (f e : ℕ → ℝ) (a b : ℝ)
    (hf : Tendsto f atTop (𝓝 a)) (he : Tendsto e atTop (𝓝 0))
    (hbound : ∀ᶠ j in atTop, f j ≤ b + e j) : a ≤ b := by
  have hright : Tendsto (fun j => b + e j) atTop (𝓝 b) := by
    simpa using tendsto_const_nhds.add he
  exact le_of_tendsto_of_tendsto hf hright hbound

end CappedMeanCompactness
end
end CappedPolicyUploadModule14
