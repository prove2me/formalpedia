set_option maxHeartbeats 1000000

open AModel AModelL12 AModelRat NetProp7

theorem lemma12_bit {c : ℝ} (hc : 0 ≤ c) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q → ∃ K : ℝ, 0 ≤ K ∧
      ∀ u : ℕ, 1 ≤ u → ∀ Pre G Suf : Shape,
        (∀ xs : List (ZMod 2),
          lemma12Prog (fun K => AModel.prog ((bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q)
              (Fintype.card (NetScalar.Wr NetProp7.ind₀)) (100 ^ 3) q (Fintype.card (NetScalar.Wr NetProp7.ind₀))
              Pre G Suf u 0 xs =
            pull (binShape Pre G Suf (2 ^ u)) (binShape Pre G Suf (2 ^ u))
              (swapPos Pre.length (Pre.length + 1 + G.length)) 0 xs) ∧
        lemma12Cost (fun K => progCost ((bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q) c
            (Fintype.card (NetScalar.Wr NetProp7.ind₀)) (100 ^ 3) q (Fintype.card (NetScalar.Wr NetProp7.ind₀))
            Pre G Suf u ≤
          K * (vol (binShape Pre G Suf (2 ^ u)) : ℝ) * (u : ℝ) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by sorry
