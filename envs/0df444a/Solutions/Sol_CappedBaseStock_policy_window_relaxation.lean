open MeasureTheory Filter Finset
open CappedBaseStock CappedPolicyMoments CappedPolicyDynamics
open CappedEndpointSubsequence
open scoped ENNReal NNReal BigOperators Topology

namespace CappedPolicyMeanLimits

lemma arrivalMean_delayed (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (t : ℕ) :
    arrivalMean P c π t = CappedPolicyCesaro.delayed (orderMean P π) c.L t := by
  exact arrivalMean_eq P c π t

lemma mean_flow_delayed (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (t : ℕ) :
    inventoryMean P c π (t + 1) + salesMean P c π t =
      inventoryMean P c π t + CappedPolicyCesaro.delayed (orderMean P π) c.L t := by
  rw [← arrivalMean_delayed]
  exact mean_flow P c π hfinite t

lemma inventory_average_nonneg (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy) (T : ℕ) :
    0 ≤ CappedPolicyCesaro.mean (inventoryMean P c π) T :=
  CappedPolicyCesaro.mean_nonneg _ (inventoryMean_nonneg P c π) T

lemma order_average_nonneg (P : DemandLaw) (π : AdmissiblePolicy) (T : ℕ) :
    0 ≤ CappedPolicyCesaro.mean (orderMean P π) T :=
  CappedPolicyCesaro.mean_nonneg _ (orderMean_nonneg P π) T

lemma order_average_gap (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (lag T : ℕ)
    (hlag : lag ≤ c.L) (hT : c.L + 1 ≤ T) :
    0 ≤ CappedPolicyCesaro.mean (orderMean P π) T -
      CappedPolicyCesaro.delayedMean (orderMean P π) lag T ∧
    CappedPolicyCesaro.mean (orderMean P π) T -
      CappedPolicyCesaro.delayedMean (orderMean P π) lag T ≤
        (block (inventoryMean P c π) c.L T + (c.L : ℝ) * mean P) / (T : ℝ) := by
  exact CappedPolicyCesaro.mean_sub_delayedMean_bound
    (inventoryMean P c π) (orderMean P π)
    (inventoryMean_nonneg P c π) (orderMean_nonneg P π)
    (mean P) P.positiveMean.le c.L (orderMean_le P c π hfinite)
    lag T hlag hT

lemma order_average_upper (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (T : ℕ) (hT : c.L + 1 ≤ T) :
    CappedPolicyCesaro.mean (orderMean P π) T ≤ mean P +
      (2 * block (inventoryMean P c π) c.L T + (c.L : ℝ) * mean P) / (T : ℝ) := by
  exact CappedPolicyCesaro.order_mean_upper
    (inventoryMean P c π) (orderMean P π) (salesMean P c π)
    (inventoryMean_nonneg P c π) (orderMean_nonneg P π)
    (mean P) P.positiveMean.le c.L (orderMean_le P c π hfinite)
    (inventoryMean_zero P c π) (salesMean_le_mean P c π)
    (mean_flow_delayed P c π hfinite) T hT

lemma sales_average_identity (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (T : ℕ) :
    CappedPolicyCesaro.mean (salesMean P c π) T =
      CappedPolicyCesaro.delayedMean (orderMean P π) c.L T -
        inventoryMean P c π T / (T : ℝ) :=
  CappedPolicyCesaro.sales_mean_eq _ _ _ c.L (inventoryMean_zero P c π)
    (mean_flow_delayed P c π hfinite) T

lemma period_average_identity (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (T : ℕ) (hT : 0 < T) :
    CappedPolicyCesaro.mean (periodMean P c π) T =
      c.h * CappedPolicyCesaro.mean (inventoryMean P c π) T +
      c.p * (mean P - CappedPolicyCesaro.delayedMean (orderMean P π) c.L T) +
      (c.h + c.p) * inventoryMean P c π T / (T : ℝ) :=
  CappedPolicyCesaro.average_cost_identity _ _ _ c.h c.p (mean P) c.L
    (inventoryMean_zero P c π) (mean_flow_delayed P c π hfinite) T hT

lemma period_average_eq_meanAverage (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (T : ℕ) (hT : 0 < T) :
    CappedPolicyCesaro.mean (periodMean P c π) T = meanAverage P c π (T - 1) := by
  have ht : T - 1 + 1 = T := by omega
  unfold CappedPolicyCesaro.mean meanAverage
  have htr : ((T - 1 : ℕ) : ℝ) + 1 = (T : ℝ) := by exact_mod_cast ht
  rw [ht, htr]

lemma input_inventory_mean_eq (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) :
    (∫ ω, ((policyWindowInput c π t ω).1 : ℝ) ∂sampleLaw P) = inventoryMean P c π t := rfl

lemma input_delivery_mean_eq (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) (i : Fin (c.L + 1)) :
    (∫ ω, ((policyWindowInput c π t ω).2 i : ℝ) ∂sampleLaw P) =
      CappedPolicyCesaro.delayed (orderMean P π) (c.L - i.val) t := by
  by_cases hi : i.val < c.L
  · simp only [policyWindowInput, hi, dite_true]
    simp_rw [run_pipeline]
    have hiL : i.val ≤ c.L := by omega
    by_cases ht : c.L ≤ t + i.val
    · have hlag : c.L - i.val ≤ t := by omega
      have htime : t + i.val - c.L = t - (c.L - i.val) := by omega
      simp only [ht, ite_true, htime, CappedPolicyCesaro.delayed, hlag]
      rfl
    · have hlag : ¬ c.L - i.val ≤ t := by omega
      simp only [ht, ite_false, NNReal.coe_zero, integral_zero,
        CappedPolicyCesaro.delayed, hlag]
  · have heq : i.val = c.L := by have h := i.isLt; omega
    simp only [policyWindowInput, heq, lt_self_iff_false, dite_false,
      CappedPolicyCesaro.delayed, Nat.sub_self, Nat.zero_le, ite_true, Nat.sub_zero]
    rfl

lemma input_delivery_average_eq (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (T : ℕ) (i : Fin (c.L + 1)) :
    CappedPolicyCesaro.mean
      (fun t => ∫ ω, ((policyWindowInput c π t ω).2 i : ℝ) ∂sampleLaw P) T =
      CappedPolicyCesaro.delayedMean (orderMean P π) (c.L - i.val) T := by
  simp only [input_delivery_mean_eq, CappedPolicyCesaro.delayedMean]

lemma arrivalMean_shift_eq_delayed (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (t : ℕ) (i : Fin (c.L + 1)) :
    arrivalMean P c π (t + i.val) =
      CappedPolicyCesaro.delayed (orderMean P π) (c.L - i.val) t := by
  have hi : i.val ≤ c.L := by have h := i.isLt; omega
  have hcond : c.L ≤ t + i.val ↔ c.L - i.val ≤ t := by omega
  have htime : t + i.val - c.L = t - (c.L - i.val) := by omega
  simp only [arrivalMean_eq, CappedPolicyCesaro.delayed, hcond, htime]

lemma average_arrivalMean_shift_eq_delayedMean (P : DemandLaw) (c : Parameters)
    (π : AdmissiblePolicy) (T : ℕ) (i : Fin (c.L + 1)) :
    CappedPolicyCesaro.mean (fun t => arrivalMean P c π (t + i.val)) T =
      CappedPolicyCesaro.delayedMean (orderMean P π) (c.L - i.val) T := by
  simp only [arrivalMean_shift_eq_delayed, CappedPolicyCesaro.delayedMean]

lemma objective_average_le_cost (P : DemandLaw) (c : Parameters) (π : AdmissiblePolicy)
    (hfinite : policyCost P c π < ⊤) (T : ℕ) (hT : c.L + 1 ≤ T) :
    c.h * CappedPolicyCesaro.mean (inventoryMean P c π) T +
      c.p * (mean P - CappedPolicyCesaro.mean (orderMean P π) T) ≤
        meanAverage P c π (T - 1) := by
  have hpos : 0 < T := by omega
  rw [← period_average_eq_meanAverage P c π T hpos,
    period_average_identity P c π hfinite T hpos]
  have hgap := (order_average_gap P c π hfinite c.L T le_rfl hT).1
  have hend : 0 ≤ (c.h + c.p) * inventoryMean P c π T / (T : ℝ) :=
    div_nonneg (mul_nonneg (add_nonneg c.holding_pos.le c.penalty_pos.le)
      (inventoryMean_nonneg P c π T)) (Nat.cast_nonneg _)
  nlinarith [mul_nonneg c.penalty_pos.le hgap]

end CappedPolicyMeanLimits
end
