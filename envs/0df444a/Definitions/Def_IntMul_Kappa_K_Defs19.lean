-- Source module: Solutions.KFNStep
/-!
# KFN: the steps of a node at level `k+1`, with bounds

Node bits `Fin m × Fin (m^k)` at strides `2^{pos p} S₀`, `W` roles of `n = B · 2^t · S₀`
records each.  **`step_ok`**: every step of `J.net` has an implementation (`RImpl`) with

* scale `≤ 1` (local) or `≤ E_k` (child),
* width `≤ dwloc W A` (local) or `≤ DW_k + (E_k + 2) W` (child),
* cost `≤ [c_k n Xf(w + Ŵ_k)]_{child} + (alN + CR Γ) (W n) Xf(w + O)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

section Steps

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp} {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ}

/-- The number of records of a role. -/
abbrev nR (t S0 B : ℕ) : ℕ := B * 2 ^ t * S0

/-- Code of a phase step (other steps: `skip`). -/
def phStepC (W n r : ℕ) {k : ℕ} (pos : Fin m × Fin (m ^ k) → ℕ) (S0 t B : ℕ) :
    RStep (Fin W) m → RS
  | .phase w0 k₀ k₁ a => wrapC W (n * r) w0.val 0
      (phC pos S0 r t B (k₀ + k₁ * Fintype.card (Fin (m ^ k))) (fun p => a p.1))
  | _ => .skip

end Steps

end NLogN.KFN

