def decRestrict (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσ : σ ∈ A.decompositionSubgroup ℚ) :
    ↥A →+* ↥A :=
  MulSemiringAction.toRingHom (A.decompositionSubgroup ℚ) ↥A ⟨σ, hσ⟩

theorem coe_decRestrict (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hσ : σ ∈ A.decompositionSubgroup ℚ) (a : ↥A) :
    ((decRestrict (A := A) σ hσ a : ↥A) : AlgebraicClosure ℚ) = σ a := rfl

theorem specMap_galois_comp_barPt (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hσ : σ ∈ A.decompositionSubgroup ℚ) :
    Spec.map (CommRingCat.ofHom (σ : AlgebraicClosure ℚ →+* AlgebraicClosure ℚ)) ≫ barPt A =
      barPt A ≫ Spec.map (CommRingCat.ofHom (decRestrict (A := A) σ hσ)) := by
  rw [barPt, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
  rfl

theorem specMap_decRestrict_comp_σA (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hσ : σ ∈ A.decompositionSubgroup ℚ) :
    Spec.map (CommRingCat.ofHom (decRestrict (A := A) σ hσ)) ≫ Λ.σA = Λ.σA := by
  obtain ⟨φ, hφ⟩ := Spec.map_surjective Λ.σA
  have h1 := Λ.hσA
  rw [← hφ, barPt, genPt, ← Spec.map_comp] at h1
  have h2 : ∀ r : baseRing p, ((φ r : ↥A) : AlgebraicClosure ℚ) = algebraMap (baseRing p) (AlgebraicClosure ℚ) r := by
    intro r
    have := congrArg (fun f => (f : baseRing p →+* AlgebraicClosure ℚ) r) (congrArg CommRingCat.Hom.hom (Spec.map_injective h1))
    simpa using this
  rw [← hφ, ← Spec.map_comp]
  congr 1
  ext r
  rw [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom, coe_decRestrict, h2]
  have : algebraMap (baseRing p) (AlgebraicClosure ℚ) r = algebraMap ℚ (AlgebraicClosure ℚ) (r : ℚ) := rfl
  rw [this, AlgEquiv.commutes]

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.galois_smul_mem_extPts (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
    (hσ : σ ∈ A.decompositionSubgroup ℚ) {x : JZero (N₀ * p)} (hx : x ∈ O.extPts) : σ • x ∈ O.extPts := by
  obtain ⟨s, hs⟩ := hx
  refine ⟨⟨Spec.map (CommRingCat.ofHom (decRestrict (A := A) σ hσ)) ≫ s.1, ?_⟩, ?_⟩
  · rw [Category.assoc, s.2, specMap_decRestrict_comp_σA]
  · rw [O.pts_galois, hs, ← Category.assoc, specMap_galois_comp_barPt, Category.assoc]

p2m_export "ModularCurve.JZeroNeronObjectAtP" "galois_smul_mem_extPts"

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.degeneracyPushforwardPair_galois_smul (hΛ : Λ.IsJacobian) (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (i : Fin 2)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (x : JZero (N₀ * p)) :
    degeneracyPushforwardPair N₀ p i (σ • x) = σ • degeneracyPushforwardPair N₀ p i x := by
  obtain ⟨-, -, -, hgal, -⟩ := hΛ
  apply Λ.pts.injective
  apply Subtype.ext
  rw [O.degeneracyHom_pts, O.pts_galois, hgal, O.degeneracyHom_pts, Category.assoc]

