  have hnorm : ∀ t : ℝ, ‖∫ k, F t k ∂(maximalCompactHaar K)‖ ≤ m t * M := by
    intro t
    have h := norm_integral_le_of_norm_le_const (μ := maximalCompactHaar K)
      (ae_of_all _ (hF_bound t))
    simpa using h
  have hint : Integrable (fun t : ℝ => ∫ k, F t k ∂(maximalCompactHaar K)) := by
    refine Integrable.mono' (hm_int.mul_const M) hcont.aestronglyMeasurable (ae_of_all _ hnorm)
  have hL2 : MemLp (fun t : ℝ => ∫ k, F t k ∂(maximalCompactHaar K)) 2 := by
    rw [memLp_two_iff_integrable_sq_norm hcont.aestronglyMeasurable]
    have hg : Integrable (fun t : ℝ => (B * M) * (m t * M)) := (hm_int.mul_const M).const_mul (B * M)
    refine Integrable.mono' hg (hcont.norm.pow 2).aestronglyMeasurable (ae_of_all _ ?_)
    intro t
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity), sq]
    have h1 := hnorm t
    have h2 : m t * M ≤ B * M := mul_le_mul_of_nonneg_right (hmB t) hM0
    exact mul_le_mul (h1.trans h2) h1 (norm_nonneg _) (by positivity)
  exact ⟨hcont, hint, hL2⟩

