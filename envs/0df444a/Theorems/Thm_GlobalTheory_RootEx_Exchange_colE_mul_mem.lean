variable {k : Type*} [Field k] {n : Type*} [Fintype n] [DecidableEq n] {c : ℕ}

theorem GlobalTheory.RootEx.Exchange.colE_mul_mem (P : Fin c) {g : GL (n ⊕ Fin c) k} (hg : g ∈ N k n c P.val) :
    ∃ w : n → k, ∀ u : n → k, ∃ h ∈ N k n c (P.val + 1), simpleSum h = simpleSum g ∧
      colE c (P.val + 1) u * g = h * colE c (P.val + 1) (u + w) := by sorry
