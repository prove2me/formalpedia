/-!
# KIL6: the run-time descriptor

`preA q m W`: create the register file and compute `2^u`, `e = ⌈log_q 2^u⌉`, `q^e`,
`Kp = ⌈log_m e⌉`, `r = min (W·Kp) e`, `n = e - r`, `q^r`, `q^n`, `vol G · q^r` and the swap
registers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

theorem clog_le_self {m : ℕ} (hm : 2 ≤ m) (e : ℕ) : Nat.clog m e ≤ e :=
  Nat.clog_le_of_le_pow (Nat.lt_pow_self (by omega)).le

end NLogN.KIL

end

