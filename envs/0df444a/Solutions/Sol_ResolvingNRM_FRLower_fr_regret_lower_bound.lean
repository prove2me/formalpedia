    simp_rw [hinner2]
    have hs0 := hasSum_poissonPMFReal 2
    have hs1 := (hasSum_poissonPMFReal_mul_nat 2).mul_right ((1 : ℝ) / 2)
    have hs2 := (hasSum_poissonPMFReal_mul_falling2 2).mul_right ((1 : ℝ) / 4)
