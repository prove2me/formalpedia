/-- Sequential composition: first `A`, then `B`. -/
theorem RImplI.comp (hs : SLaws st n) {A B : ROp (Fin W) m κ} {c1 c2 : ℕ → IStmt HS Pp}
    {e1 e2 d1 d2 : ℕ} {k1 k2 : ℕ → ℕ} (h1 : RImplI I iprog r n st A c1 e1 d1 k1)
    (h2 : RImplI I iprog r n st B c2 e2 d2 k2) :
    RImplI I iprog r n st (B * A) (seqI c1 c2 d1) (e1 + e2) (d1 + d2)
      (fun w => k1 w + k2 (w + d1)) := by
  intro s f zs l X F w hC h0 hx hl hb
  obtain ⟨zs1, r1, b1, f1⟩ := h1 s f zs l X F w hC h0 hx hl hb
  obtain ⟨zs2, r2, b2, f2⟩ := h2 s (Function.update f 0 (gflat zs1 ++ l)) zs1 l _ (F + e1)
    (w + d1) (hC.upd0 _) (by simp) r1 (fun v => length_roleOpF _ _ _ _ _) b1
  refine ⟨zs2, ?_, ?_, ?_⟩
  · rw [← roleOpF_mul hs, ← add_assoc]; exact r2
  · rw [← add_assoc]; exact b2
  · have := f1.seq f2
    rwa [Function.update_idem] at this

theorem rImplI_skip : RImplI (W := W) I iprog r n st 1 (fun _ => .skip) 0 0 (fun _ => 1) := by
  intro s f zs l X F w hC h0 hx hl hb
  refine ⟨zs, ?_, hb, ?_⟩
  · rw [roleOpF_one hl]; exact hx
  · have e : Function.update f 0 (gflat zs ++ l) = f := by
      rw [← h0]; exact Function.update_eq_self 0 f
    rw [e]; exact IRuns.skip _

/-- **A list of implemented steps implements the network.** -/
theorem rImplI_list (hs : SLaws st n) (T : Butterfly.Op κ)
    (code : RStep (Fin W) m → ℕ → IStmt HS Pp)
    (e dw : RStep (Fin W) m → ℕ) (cost : RStep (Fin W) m → ℕ → ℕ) :
    ∀ l : List (RStep (Fin W) m),
      (∀ a ∈ l, RImplI I iprog r n st (a.den T) (code a) (e a) (dw a) (cost a)) →
      RImplI I iprog r n st (denListR T l) (seqLI code dw l) (l.map e).sum (l.map dw).sum
        (costL cost dw l)
  | [], _ => by
    simp only [denListR_nil, List.map_nil, seqLI, List.sum_nil]
    exact rImplI_skip
  | a :: l, h => by
    have H := (h a List.mem_cons_self).comp hs
      (rImplI_list hs T code e dw cost l fun b hb => h b (List.mem_cons_of_mem _ hb))
    rw [← denListR_cons] at H
    simpa [seqLI, costL] using H

