  have hLt : ∀ (t : HeckeAlg) (s : ℕ → JZero p), s ∈ (_root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ (fun _ => AddSubgroup.closure
            {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
              ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x})) → t • s ∈ (_root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ (fun _ => AddSubgroup.closure
            {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
