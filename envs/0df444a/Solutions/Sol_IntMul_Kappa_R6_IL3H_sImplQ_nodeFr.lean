-- Source module: Solutions.KIL4Sim
/-!
# KIL4: literal-to-register simulation of register programs

The KIL1–KIL3 programs carry the sizes of a configuration (field sizes, volumes, the modulus,
pass counts, …) as literals `Ex.lit v`.  A uniform program reads them from parameter stacks
instead.  `RSim π p p'` says that `p'` is `p` with some literal occurrences `.lit v` replaced by
register reads `.reg i`, where the parameter map `π` says `π i = some v`.

`RSim.sim`: on a state where every parameter stack `i` holds `v` on top (`PV π s`) and is not
written by `p`, the program `p'` is executable whenever `p` is, ends in the same state, and costs at
most `200 ×` the cost of `p` (a register read costs at most `200 ×` a literal of the same value).
Hence every KIL specification `Sp p s t c` transfers to `Sp p' s t (200 * c)` (`Sp.sim`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS

section ESimLemmas

variable {π : PMap} {s : IState HS}

theorem ESim.regs_sub {e e' : Ex HS} (h : ESim π e e') :
    ∀ j ∈ e'.regs, j ∈ e.regs ∨ ∃ v, π j = some v := by
  induction h with
  | reg i => intro j hj; exact Or.inl hj
  | lit c => intro j hj; simp [Ex.regs] at hj
  | par hi =>
    intro j hj
    simp only [Ex.regs, List.mem_singleton] at hj
    subst hj; exact Or.inr ⟨_, hi⟩
  | add _ _ iha ihb | mul _ _ iha ihb | shl _ _ iha ihb | quo _ _ iha ihb | rem _ _ iha ihb
  | ndiv _ _ iha ihb | nmod _ _ iha ihb =>
    intro j hj
    simp only [Ex.regs, List.mem_append] at hj ⊢
    rcases hj with hj | hj
    · rcases iha j hj with h | h
      · exact Or.inl (Or.inl h)
      · exact Or.inr h
    · rcases ihb j hj with h | h
      · exact Or.inl (Or.inr h)
      · exact Or.inr h
  | neg _ iha | pow2 _ iha =>
    intro j hj
    simp only [Ex.regs] at hj ⊢
    exact iha j hj
  | sel _ _ _ ihc iha ihb =>
    intro j hj
    simp only [Ex.regs, List.mem_append] at hj ⊢
    rcases hj with (hj | hj) | hj
    · rcases ihc j hj with h | h
      · exact Or.inl (Or.inl (Or.inl h))
      · exact Or.inr h
    · rcases iha j hj with h | h
      · exact Or.inl (Or.inl (Or.inr h))
      · exact Or.inr h
    · rcases ihb j hj with h | h
      · exact Or.inl (Or.inr h)
      · exact Or.inr h

theorem ESim.clean (hπ : PLow π) {e e' : Ex HS} (h : ESim π e e') (hc : e.Clean) : e'.Clean := by
  intro j hj
  rcases h.regs_sub j hj with h1 | ⟨v, hv⟩
  · exact hc j h1
  · exact (clean_of_lt (hπ j v hv)) j (by simp [Ex.regs])

end ESimLemmas

