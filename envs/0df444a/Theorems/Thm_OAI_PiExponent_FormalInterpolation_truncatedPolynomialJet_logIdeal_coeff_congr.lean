-- title:
--   Logarithmic ideal congruence preserves box jet coefficients
-- statement:
--   If two polynomials differ by an element of the logarithmic center ideal with exponent bounds S, then their truncated polynomial jets have equal coefficients at every exponent vector in the strict box. This identifies the box coefficient map’s kernel with the ideal generated by powers of the inverse triangular coordinates. It is the principal local algebra obligation; verify the statement also when some S coordinate is zero, where the box is empty.

import Definitions.Def_OAI_PiExponent_TruncatedPolynomialJets
import Mathlib.RingTheory.Ideal.Quotient.Operations

open OAI.PiExponent OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.truncatedPolynomialJet_logIdeal_coeff_congr
    {m : Nat} (c : Fin m → Complex) (T : Fin m → Nat)
    (S : Fin (m + 1) → Nat)
    (P Q : MvPolynomial (Fin (m + 1)) Complex)
    (h : P - Q ∈ logarithmicCenterIdeal c T S) :
    ∀ a : {a : Fin (m + 1) → Nat // ∀ i, a i < S i},
      (truncatedPolynomialJet c T P).coeff (InterpolationMatrix.exponentVector a.1) =
        (truncatedPolynomialJet c T Q).coeff (InterpolationMatrix.exponentVector a.1) := by sorry
