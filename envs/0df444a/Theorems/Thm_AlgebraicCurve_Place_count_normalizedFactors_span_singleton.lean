open AlgebraicCurve

theorem AlgebraicCurve.Place.count_normalizedFactors_span_singleton {K F F' : Type*} [Field K] [Field F] [Field F'] [Algebra K F] [Algebra K F'] [Algebra F F'] [IsScalarTower K F F'] [FiniteDimensional F F'] [Algebra.IsSeparable F F'] {v : Place K F} {w : Place K F'} (hw : w.restrict F = v) {c : Place.integralClosureAt F' v} (hc : c ≠ 0) : (UniqueFactorizationMonoid.normalizedFactors (Ideal.span {c})).count (Place.fiberCenter F' v hw).asIdeal = (w.ord (algebraMap (Place.integralClosureAt F' v) F' c)).toNat := by sorry
