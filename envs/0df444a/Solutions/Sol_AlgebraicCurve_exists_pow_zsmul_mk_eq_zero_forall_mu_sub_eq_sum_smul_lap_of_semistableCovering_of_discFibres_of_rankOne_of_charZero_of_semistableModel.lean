  have hsplit : x - (α * ((ℓ ^ c : ℕ) : ℤ)) • (((ℓ ^ a : ℕ) : ℤ) • x) = (β * (r : ℤ)) • x := by
    rw [hh]
    conv_lhs => rw [show x - (α * ((ℓ ^ (a + c) : ℕ) : ℤ)) • x = ((1 : ℤ) - α * ((ℓ ^ (a + c) : ℕ) : ℤ)) • x from by
      rw [sub_smul, one_zsmul]]
    congr 1
    linear_combination (-1 : ℤ) * hαβ
  rw [hsplit, smul_smul, show ((ℓ ^ c : ℕ) : ℤ) * (β * (r : ℤ)) = β * ((ℓ ^ c * r : ℕ) : ℤ) by push_cast; ring,
