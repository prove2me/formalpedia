            ((TypeDensity.allowedPatterns (TypeDensity.State.single a c)).toList.flatMap fun P ↦
              if TypeDensity.SelfPattern (TypeDensity.State.single a c) P then [] else
                TypeDensity.lawScale (.mul (TypeDensity.tangentCount (TypeDensity.State.single a c) P)
