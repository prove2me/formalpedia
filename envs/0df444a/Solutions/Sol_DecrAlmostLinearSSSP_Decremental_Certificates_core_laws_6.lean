section s251
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreGradientEndpoints
open Structured
lemma eval_code {n : ℕ} (base : ℕ) (g : Fin n → ℝ) (a z : Fin n) (f : ℝ) (s : Data)
    (h : CoreGradient.Image base g s) (hb : s.natReg 554 = base)
    (ha : s.natReg 626 = a.val) (hz : s.natReg 628 = z.val)
    (hf : s.realReg 612 = f) (hzero : s.realReg 56 = 0) :
    ∃ cost t, Eval code s cost t ∧ cost ≤ 36 ∧
      CoreGradient.Image base (fun v => g v-(if v = a then f else 0)+(if v = z then f else 0)) t ∧
      t.natMem = s.natMem ∧
      (∀ j, j ≠ base+2*a.val → j ≠ base+2*z.val → t.realMem j = s.realMem j) := by
  let p := tailPrepared s
  have hp := tail_eval s
  have hpMem := hp.no_memory tail_no_memory
  have hp0 : p.realReg 56 = 0 := (hp.real_frame (tail_real_frame 56 (by omega))).trans hzero
  have hpimage : CoreGradient.Image base g p := h.frame base g (fun _ => congrFun hpMem.1 _) (hp.nat_frame (tail_nat_frame 550 (by omega)))
  have hpaddr : p.natReg 620 = base+2*a.val := by simpa only [hb,ha] using (tail_fields s hzero).1
  have hpdelta : p.realReg 626 = -f := by simpa only [hf] using (tail_fields s hzero).2
  obtain ⟨c1,hu,hc1⟩ := CoreGradient.eval_code p hp0
  let u := CoreGradient.result p
  let g1 := Function.update g a (g a-f)
  have huimage : CoreGradient.Image base g1 u := by
    simpa only [g1,sub_eq_add_neg] using hpimage.updated base g a (-f) p hpaddr hpdelta
  have hun (k : ℕ) (hk : k ≠ 550 ∧ k ≠ 620 ∧ k ≠ 632 ∧ k ≠ 634) : u.natReg k = s.natReg k :=
    (hu.nat_frame (CoreGradient.nat_frame k hk.1 hk.2.2.1 hk.2.2.2)).trans (hp.nat_frame (tail_nat_frame k hk.2.1))
  have hur (k : ℕ) (hk : k ≠ 626 ∧ k ≠ 628 ∧ k ≠ 630) : u.realReg k = s.realReg k :=
    (hu.real_frame (CoreGradient.real_frame k hk.2.1 hk.2.2)).trans (hp.real_frame (tail_real_frame k hk.1))
  have hu0 : u.realReg 56 = 0 := (hur 56 (by omega)).trans hzero
  let q := headPrepared u
  have hq := head_eval u
  have hqMem := hq.no_memory head_no_memory
  have hqimage : CoreGradient.Image base g1 q := huimage.frame base g1 (fun _ => congrFun hqMem.1 _) (hq.nat_frame (head_nat_frame 550 (by omega)))
  have hqaddr : q.natReg 620 = base+2*z.val := by
    rw [(head_fields u hu0).1,hun 554 (by omega),hun 628 (by omega),hb,hz]
  have hqdelta : q.realReg 626 = f := ((head_fields u hu0).2).trans ((hur 612 (by omega)).trans hf)
  have hq0 : q.realReg 56 = 0 := (hq.real_frame (head_real_frame 56 (by omega))).trans hu0
  obtain ⟨c2,ht,hc2⟩ := CoreGradient.eval_code q hq0
  have htimage := hqimage.updated base g1 z f q hqaddr hqdelta
  have htimage' : CoreGradient.Image base (fun v => g v-(if v = a then f else 0)+(if v = z then f else 0)) (CoreGradient.result q) := by
    simpa only [g1,CoreGradient.update_two_gradient] using htimage
  refine ⟨3+(c1+(3+c2)),CoreGradient.result q,Eval.seq hp (Eval.seq hu (Eval.seq hq ht)),by omega,htimage',?_,?_⟩
  · exact (CoreGradient.values q).2.1.trans (hqMem.2.trans ((CoreGradient.values p).2.1.trans hpMem.2))
  · intro j hja hjz
    rw [(CoreGradient.values q).1,hqaddr,Function.update_of_ne hjz]
    rw [hqMem.1,(CoreGradient.values p).1,hpaddr,Function.update_of_ne hja,hpMem.1]
lemma nat_frame (k : ℕ) (h550 : k ≠ 550) (h620 : k ≠ 620) (h632 : k ≠ 632) (h634 : k ≠ 634) : NatFrame code k :=
  ⟨tail_nat_frame k h620,CoreGradient.nat_frame k h550 h632 h634,
    head_nat_frame k h620,CoreGradient.nat_frame k h550 h632 h634⟩
lemma real_frame (k : ℕ) (h626 : k ≠ 626) (h628 : k ≠ 628) (h630 : k ≠ 630) : RealFrame code k :=
  ⟨tail_real_frame k h626,CoreGradient.real_frame k h628 h630,
    head_real_frame k h626,CoreGradient.real_frame k h628 h630⟩
end DecrAlmostLinearSSSP.Decremental.CoreGradientEndpoints
end s251
