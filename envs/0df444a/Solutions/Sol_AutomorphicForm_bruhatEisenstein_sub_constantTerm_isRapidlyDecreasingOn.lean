section Reshape

variable (F : Type) [Field F] [NumberField F] (w : InfinitePlace F)

private theorem awayFrom_weyl_unipotent_eq (x : AdelicGL2 (𝓞 F) F) {a a' : AdeleRing (𝓞 F) F}
    (harch : ∀ v : InfinitePlace F, v ≠ w → a'.1 v = a.1 v) (hw0 : a'.1 w = 0) (hfin : a'.2 = a.2) :
    awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = adelicWeyl (𝓞 F) F * unipotentGL2 a'
          * (adelicArchGLInclAt F w ((archComponent F w (glArch (𝓞 F) F x) * gl2Weyl)⁻¹) * x) := by

  have h1 : (unipotentGL2 (0 : w.Completion) : GL (Fin 2) w.Completion) = 1 := by
    apply Units.ext; ext i j; rw [unipotentGL2_coe]; fin_cases i <;> fin_cases j <;> simp
  have hR1 : archComponent F w (glArch (𝓞 F) F (adelicWeyl (𝓞 F) F * unipotentGL2 a'
      * (adelicArchGLInclAt F w ((archComponent F w (glArch (𝓞 F) F x) * gl2Weyl)⁻¹) * x))) = 1 := by
    simp only [map_mul, archComponent_adelicWeyl, archComponent_unipotentGL2, archComponent_incl_self, hw0]
    rw [h1, mul_one, mul_inv_rev, inv_mul_cancel_right, mul_inv_cancel]
  rw [awayFrom_weyl_unipotent_eq_of_agree F w (a' := a') (fun v hvw => (harch v hvw).symm) hfin.symm x]

  refine ext_of_components F (fun v => ?_) ?_
  · by_cases hvw : v = w
    · subst hvw
      rw [archComponent_awayFrom_self, hR1]
    · rw [archComponent_awayFrom_of_ne F _ hvw]
      simp only [map_mul]
      rw [archComponent_incl_of_ne F _ hvw, one_mul]
  · rw [glFin_awayFrom]
    simp only [map_mul]
    rw [glFin_incl, one_mul]

end Reshape
