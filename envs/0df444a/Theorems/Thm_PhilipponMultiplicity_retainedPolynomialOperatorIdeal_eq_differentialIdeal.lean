-- title:
--   Polynomial and intrinsic differential ideals agree
-- statement:
--   For either permitted base-field family, a multihomogeneous ideal $I$, a translation point $g$, an order bound $T$, and any supplied genuine translation atlas, the retained coefficientwise polynomial operator ideal equals the intrinsic ideal locally generated by normalized analytic jets. Both sides are actual ideals, with multiplicities retained. The local coefficients are rational functions represented by pairs of homogeneous polynomials of the same degree, with nonvanishing denominators on the chosen Zariski neighborhood. This is the coordinate-to-intrinsic comparison underlying §4.1 and the coordinate-ratio argument in Proposition 4.3; equality of their zero loci alone does not prove this assertion.
-- source:
--   Philippon (1986), Lemmes de zéros dans les groupes algébriques commutatifs, §4.1, printed pp. 371–374; https://numdam.org/articles/10.24033/bsmf.2060/ .

import Definitions.Def_PhilipponMultiplicity_SectionFour
set_option autoImplicit false
open scoped BigOperators Topology
open PhilipponMultiplicity

theorem PhilipponMultiplicity.retainedPolynomialOperatorIdeal_eq_differentialIdeal
    (K : Type*) [NontriviallyNormedField K] (hK : IsPhilipponBaseField K)
    (G : EmbeddedGroupProduct K) (A : AnalyticSubgroup G) (g : G.Point)
    (atlas : TranslationAtlas A g) (T : ℕ) (I : Ideal G.CoordinateRing)
    (hI : IsMultihomogeneousIdeal G.ambient I) :
    retainedPolynomialOperatorIdeal atlas T I = differentialIdeal A g T I := by sorry
