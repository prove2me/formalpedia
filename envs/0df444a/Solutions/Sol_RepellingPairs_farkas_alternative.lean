theorem walk_ext {V : Type u} {E : Type v} {G : Multigraph V E} {u w : V}
    (p p' : G.Walk u w) (h : p.edges = p'.edges) : p = p' := by
  revert p'
  induction p with
  | nil v =>
    intro p' h
    cases p' with
    | nil _ => rfl
    | cons e h' q => simp [Walk.edges] at h
  | cons e h₁ p ih =>
    intro p' h
    cases p' with
    | nil _ => simp [Walk.edges] at h
    | cons e' h₂ q =>
      simp only [Walk.edges, List.cons.injEq] at h
      obtain ⟨rfl, h⟩ := h
      obtain rfl := Sym2.congr_right.mp (h₁.symm.trans h₂)
      rw [ih q h]

theorem walk_len {V : Type u} {E : Type v} {G : Multigraph V E} {u w : V}
    (p : G.Walk u w) : p.edges.length + 1 = p.support.length := by
  induction p with
  | nil v => simp [Walk.edges, Walk.support]
  | cons e h p ih => simp [Walk.edges, Walk.support, ← ih]

theorem finite_terminalPath {V : Type u} {E : Type v} {k : ℕ} [Fintype V] [Fintype E]
    (G : OSInstance V E k) : Finite (TerminalPath G) := by
  haveI : Finite {l : List E // l.length ≤ Fintype.card V} :=
    (List.finite_length_le E (Fintype.card V)).to_subtype
  let φ : TerminalPath G → Fin k × Fin k × {l : List E // l.length ≤ Fintype.card V} :=
    fun q => (q.src, q.tgt, ⟨q.path.1.edges, by
      have h1 := walk_len q.path.1
      have h2 : q.path.1.support.length ≤ Fintype.card V := q.path.2.length_le_card
      omega⟩)
  refine Finite.of_injective φ ?_
  rintro ⟨s, t, p⟩ ⟨s', t', p'⟩ h
  simp only [φ, Prod.mk.injEq, Subtype.mk.injEq] at h
  obtain ⟨rfl, rfl, h⟩ := h
  have : p = p' := Subtype.ext (walk_ext _ _ h)
  rw [this]

theorem list_sum_count {E : Type v} [Fintype E] [DecidableEq E] (ℓ : E → ℝ) (l : List E) :
    (l.map ℓ).sum = ∑ e, ℓ e * (l.count e : ℝ) := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.map_cons, List.sum_cons, ih, List.count_cons, beq_iff_eq]
    have : ∀ e, ℓ e * ((l.count e + if a = e then 1 else 0 : ℕ) : ℝ)
        = ℓ e * (l.count e : ℝ) + if a = e then ℓ e else 0 := by
      intro e
      split_ifs with h
      · subst h; push_cast; ring
      · simp
    simp only [this, Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    ring

theorem len_eq_sum {V : Type u} {E : Type v} {G : Multigraph V E} [Fintype E] [DecidableEq E]
    (ℓ : E → ℝ) {a b : V} (p : G.Walk a b) :
    p.len ℓ = ∑ e, ℓ e * (p.edges.count e : ℝ) := list_sum_count ℓ p.edges

