    change v = (w.1 : ↥(CohCarrier.hdataSub (N * r) H₀ (↑S : Set ℕ) 𝒪 (ResidueField 𝒪) Subtype.val hcomm θbar).opSubalgebra) • ((Sp.toCornerRing i u • (⟨v, hv⟩ : ↥(cornerSubmodule (M := H1 (N * r) H₀ 𝒪) (Sp.e i))) :
