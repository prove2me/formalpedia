open P2mKcSerreAV

theorem solution
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (n : ℕ) (hn3 : 3 ≤ n) (hn : (n : K) ≠ 0) (σ : SchemeHomOver f f)
    (hσ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) σ =
        L.mul t (NeronModelInfra.schemeHomOverComp x σ) (NeronModelInfra.schemeHomOverComp y σ))
    (m : ℕ) (hm : m ≠ 0) (hord : NeronModelInfra.schemeHomOverNpow σ m = NeronModelInfra.schemeHomOverId f)
    (hfix : ∀ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f,
      L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) n x → NeronModelInfra.schemeHomOverComp x σ = x) :
    σ = NeronModelInfra.schemeHomOverId f := by
  classical

  obtain ⟨p, a, hp, ha, ha2, hpa⟩ := exists_prime_pow_dvd_of_three_le n hn3
  obtain ⟨c, hc'⟩ := hpa
  have hpK : (p : K) ≠ 0 := by
    intro h0
    apply hn
    rw [hc']; push_cast; rw [h0, zero_pow (by omega), zero_mul]
  have hpaK : ((p ^ a : ℕ) : K) ≠ 0 := by push_cast; exact pow_ne_zero _ hpK
  set e : Spec (CommRingCat.of K) ⟶ Spec (CommRingCat.of K) := 𝟙 _ with he

  have hfix' : ∀ x : Pt f, L.nsmul e (p ^ a) x = L.one e → NeronModelInfra.schemeHomOverComp x σ = x := by
    intro x hx
    apply hfix
    letI := L.pointGroup e
    change L.nsmul e n x = L.one e
    rw [nsmul_eq_pow] at hx ⊢
    change x ^ n = 1
    change x ^ p ^ a = 1 at hx
    rw [hc', pow_mul, hx, one_pow]

  letI instE := L.pointCommGroup hc f
  set β : SchemeHomOver f f := σ * (NeronModelInfra.schemeHomOverId f)⁻¹ with hβdef
  have hβval : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp x β = L.mul t (NeronModelInfra.schemeHomOverComp x σ) (L.inv t x) := by
    intro T t x
    rw [hβdef]
    change NeronModelInfra.schemeHomOverComp x (L.mul f σ (L.inv f (NeronModelInfra.schemeHomOverId f))) = _
    rw [comp_mul, comp_inv, comp_id]
  have hβhom : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of K)) (x y : SchemeHomOver t f),
      NeronModelInfra.schemeHomOverComp (L.mul t x y) β =
        L.mul t (NeronModelInfra.schemeHomOverComp x β) (NeronModelInfra.schemeHomOverComp y β) := by
    intro T t x y
    letI := L.pointCommGroup hc t
    rw [hβval, hβval, hβval, hσ]
    change (NeronModelInfra.schemeHomOverComp x σ * NeronModelInfra.schemeHomOverComp y σ) * (x * y)⁻¹ =
      (NeronModelInfra.schemeHomOverComp x σ * x⁻¹) * (NeronModelInfra.schemeHomOverComp y σ * y⁻¹)
    rw [mul_inv, mul_mul_mul_comm]
  have hβker : ∀ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f,
      L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) (p ^ a) x →
        NeronModelInfra.schemeHomOverComp x β = L.one (𝟙 (Spec (CommRingCat.of K))) := by
    intro x hx
    rw [hβval, hfix' x hx]
    exact L.mul_inv_cancel _ x
  obtain ⟨γ, hγ, hβγ⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_eq_pow_of_forall_isTorsionPoint_schemeHomOverComp_eq_one
      K f L hc hA (p ^ a) hpaK β hβhom hβker

  haveI : IsComm L := ⟨hc⟩
  let u : TateSeq L p →ₗ[ℤ] TateSeq L p := TateSeq.mapEnd σ hσ
  have hu_apply : ∀ x : TateSeq L p, u x = TateSeq.mapHom σ hσ x := fun x => rfl
  have hu_pow : ∀ (k : ℕ) (x : TateSeq L p) (j : ℕ),
      ((u ^ k) x).1 j = NeronModelInfra.schemeHomOverComp (x.1 j) (NeronModelInfra.schemeHomOverNpow σ k) := by
    intro k x j
    rw [Module.End.pow_apply, comp_npow]
    induction k generalizing x with
    | zero => rfl
    | succ k ih =>
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hu_apply, TateSeq.mapHom_val, ih]
  have hum : u ^ m = 1 := by
    refine LinearMap.ext fun x => TateSeq.ext fun j => ?_
    rw [hu_pow, hord, comp_id]; rfl
  have htf : ∀ x : TateSeq L p, p • x = 0 → x = 0 := fun x hx => TateSeq.eq_zero_of_smul_eq_zero x hx
  have hsep : ∀ x : TateSeq L p, (∀ k : ℕ, ∃ y : TateSeq L p, x = p ^ k • y) → x = 0 :=
    fun x hx => TateSeq.eq_zero_of_forall_exists x hx
  have hcong : ∀ x : TateSeq L p, ∃ y : TateSeq L p, u x - x = p ^ a • y := by
    intro x
    refine ⟨TateSeq.mapHom γ hγ x, TateSeq.ext fun j => ?_⟩
    rw [TateSeq.sub_val, hu_apply, TateSeq.mapHom_val, TateSeq.nsmul_val, TateSeq.mapHom_val,
      ← hβval, hβγ]
    exact comp_hom_pow L hc _ γ (p ^ a) (x.1 j)
  have hu1 : u = 1 :=
    Module.End.eq_one_of_pow_eq_one_of_forall_exists_sub_eq_prime_pow_smul hp a ha ha2 htf hsep u m hm hum hcong
  have hfixT : ∀ (x : TateSeq L p) (j : ℕ), NeronModelInfra.schemeHomOverComp (x.1 j) σ = x.1 j := by
    intro x j
    have := congrArg (fun z : TateSeq L p => z.1 j) (LinearMap.congr_fun hu1 x)
    simpa [hu_apply] using this

  haveI : Smooth f := hA.smooth
  haveI : ConnectedSpace A := connectedSpace_of_bundle hA
  have hdiv : Function.Surjective (L.nsmul (𝟙 (Spec (CommRingCat.of K))) p) :=
    GoodReductionJacobian.RelativeGroupLaw.nsmul_surjective_of_isAlgClosed_of_connectedSpace L
      (fun t x y => hc t x y) p (isUnit_iff_ne_zero.mpr hpK)
  have hfixall : ∀ (j : ℕ) (z : Pt f), L.IsTorsionPoint (𝟙 (Spec (CommRingCat.of K))) (p ^ j) z →
      NeronModelInfra.schemeHomOverComp z σ =
        NeronModelInfra.schemeHomOverComp z (NeronModelInfra.schemeHomOverId f) := by
    intro j z hz
    obtain ⟨x, rfl⟩ := exists_tateSeq_val_eq L p hdiv j z hz
    rw [hfixT, comp_id]

  exact GoodReductionJacobian.RelativeGroupLaw.eq_of_forall_isTorsionPoint_pow_schemeHomOverComp_eq
    K f L hc hA p hp hpK σ (NeronModelInfra.schemeHomOverId f) hfixall

end
