theorem QEC.Coding.StabilizerCode.LocalStabilizerHamiltonian.disjoint_support_of_generatedByMeeting_of_noSharedGenerator
    {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ]
    (H : LocalStabilizerHamiltonian (ι := ι) (κ := κ))
    (R T : Finset ι) (S : Binary ι)
    (hseparated : H.NoSharedGenerator R T)
    (hS : H.GeneratedByMeeting R S) :
