import Definitions.Def_OAI_PiExponent_PolynomialLogarithmicJets

open OAI.PiExponent.LogarithmicJetIdeals

theorem OAI.PiExponent.LogarithmicJetIdeals.polynomialJet_mem_coordinatePowerIdeal
    {m : ℕ} (c : Fin m → ℂ) (T : Fin m → ℕ)
    (b : Fin (m + 1) → ℕ) (P : MvPolynomial (Fin (m + 1)) ℂ)
    (hP : P ∈ localJetIdeal c T b) :
    polynomialJet c T P ∈ Ideal.span (Set.range (fun i : Fin (m + 1) => MvPolynomial.X i ^ b i) : Set (MvPolynomial (Fin (m + 1)) ℂ)) := by sorry
