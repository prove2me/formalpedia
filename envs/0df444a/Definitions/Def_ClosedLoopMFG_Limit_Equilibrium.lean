-- title:
--   Semi-Markov functions, weak MFE and weak RMFE (Definitions 2.4, 2.5, 3.6, Remark 2.6)
-- statement:
--   A function $F:[0,T]\times\mathbb R^d\times C([0,T];\mathcal P(\mathbb R^d))\to E$ is **semi-Markov** (Definition 2.4) if it is Borel measurable and $F(t,x,m)=F(t,x,m')$ whenever $m_s=m'_s$ for all $s\le t$: it depends on the state only through its current value and on the measure flow non-anticipatively.
--
--   A **weak semi-Markov mean field equilibrium** (weak MFE, Definition 2.5) is a tuple $(\Omega,\mathcal F,\mathbb F,\mathbb P,W,\alpha^*,X^*,\mu)$ where $(\Omega,\mathcal F,\mathbb F,\mathbb P)$ is a complete filtered probability space and:
--
--   1. $\mu$ is a continuous $\mathbb F$-adapted $\mathcal P(\mathbb R^d)$-valued process, $W$ is an $\mathbb F$-Brownian motion, and $X^*$ is a continuous $\mathbb F$-adapted process with $X^*_0\sim\lambda$;
--   2. $\alpha^*$ is an $A$-valued semi-Markov function;
--   3. $X^*_0$, $\mu$ and $W$ are independent;
--   4. $dX^*_t=b\big(t,X^*_t,\mu_t,\alpha^*(t,X^*_t,\mu)\big)dt+dW_t$;
--   5. for every $A$-valued semi-Markov $\alpha$,
--   $$\mathbb E\Big[\int_0^T f\big(t,X^*_t,\mu_t,\alpha^*(t,X^*_t,\mu)\big)dt+g(X^*_T,\mu_T)\Big]\ \ge\ \mathbb E\Big[\int_0^T f\big(t,X_t,\mu_t,\alpha(t,X_t,\mu)\big)dt+g(X_T,\mu_T)\Big],$$
--   where $X$ is the solution of $dX_t=b(t,X_t,\mu_t,\alpha(t,X_t,\mu))dt+dW_t$, $X_0=X^*_0$ (2.2), which by Remark 2.6 is adapted to the completed filtration generated by $(X^*_0,W_s,\mu_s)_{s\le t}$;
--   6. for each $t\in[0,T]$, $\mu_t=\mathbb P(X^*_t\in\cdot\mid\mathcal F^\mu_t)$ a.s., where $\mathcal F^\mu_t=\sigma(\mu_s:s\le t)$.
--
--   A **weak RMFE** (Definition 3.6) is the same with a $\mathcal P(A)$-valued semi-Markov $\Lambda^*$, the drift $\int_A b(t,x,\mu_t,a)\Lambda^*(t,x,\mu)(da)$, the running reward $\int_A f(t,x,\mu_t,a)\Lambda^*(t,x,\mu)(da)$, and alternatives ranging over $\mathcal P(A)$-valued semi-Markov $\Lambda$. A law $\nu$ on $C([0,T];\mathcal P(\mathbb R^d))$ is **the law of a weak MFE** (resp. weak RMFE) if some filtered probability space carries a weak MFE (resp. weak RMFE) whose flow $\mu$ has law $\nu$; the paper calls the process $\mu$ itself a weak MFE.
--
--   **Formalization Note** Every state equation is pathwise (unit volatility). The alternative state in (5) ranges over exactly the measurable continuous processes adapted to the completed filtration generated by $(X^*_0,W,\mu)$ with $X_0=X^*_0$ a.s. that solve (2.2) — the class of Remark 2.6, not all $\mathbb F$-adapted solutions; that this class is nonempty is Lemma A.3 and its uniqueness is Lemma A.2 of the paper. Definition 3.6(5) prints "$X_0\sim\lambda$" for the alternative state; we state $X_0=X^*_0$, as in Definition 2.5(5) and (5.10), so that the alternative is on the same space with the same $W$. Consistency (6) is stated for every Borel set $B$ through the conditional expectation $\mathbb E[1_B(X^*_t)\mid\mathcal F^\mu_t]$; measurability of $\mu$ and $X^*$ is part of the definition, so the conditional expectation is not degenerate. The independence in (3) is mutual independence of the $\sigma$-fields generated by $X^*_0$, by $\mu$ and by the Brownian path. Definition 2.4 prints "$(t,x)\in[0,T]\in\mathbb R^d$", a slip for $[0,T]\times\mathbb R^d$; Definition 2.5(5) misses a closing parenthesis in the left reward.
-- source:
--   Lacker, On the convergence of closed-loop Nash equilibria to the mean field game limit, arXiv:1808.02745v1, pp. 7–8, Definitions 2.4, 2.5, Remark 2.6; p. 17, Definition 3.6

import Mathlib
import Definitions.Def_ClosedLoopMFG_Limit_Model

namespace ClosedLoopMFG.Limit

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

/-- **Semi-Markov function** (Definition 2.4, p. 7): `F : [0, T] × ℝ^d × C([0, T]; P(ℝ^d)) → Y`
is Borel measurable and non-anticipating in the flow, `F(t, x, m) = F(t, x, m')` whenever
`m_s = m'_s` for all `s ≤ t`. Time is real; the condition is asked for `t ∈ [0, T]`. -/
def IsSemiMarkov {d : ℕ} {T : ℝ≥0} {Y : Type} [MeasurableSpace Y]
    (F : ℝ → E d → Flow d T → Y) : Prop :=
  Measurable (fun p : ℝ × E d × Flow d T => F p.1 p.2.1 p.2.2) ∧
  ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ (x : E d) (m m' : Flow d T),
    (∀ s : Set.Icc (0 : ℝ) T, (s : ℝ) ≤ t → m s = m' s) → F t x m = F t x m'

/-- An `A`-valued semi-Markov control. -/
def IsSemiMarkovCtrl {d : ℕ} {T : ℝ≥0} {EA : Type} [MeasurableSpace EA] (A : Set EA)
    (α : ℝ → E d → Flow d T → EA) : Prop :=
  IsSemiMarkov α ∧ ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ x m, α t x m ∈ A

/-- The drift `b(t, x, m_t, α(t, x, m))` of a strict semi-Markov control. -/
noncomputable def strictDrift {d : ℕ} {T : ℝ≥0} {EA : Type} (b : ℝ → E d → PR d → EA → E d)
    (α : ℝ → E d → Flow d T → EA) : ℝ → E d → Flow d T → E d :=
  fun t x m => b t x (ev m t) (α t x m)

/-- The running reward `f(t, x, m_t, α(t, x, m))` of a strict semi-Markov control. -/
noncomputable def strictRun {d : ℕ} {T : ℝ≥0} {EA : Type} (f : ℝ → E d → PR d → EA → ℝ)
    (α : ℝ → E d → Flow d T → EA) : ℝ → E d → Flow d T → ℝ :=
  fun t x m => f t x (ev m t) (α t x m)

/-- The drift `∫_A b(t, x, m_t, a) Λ(t, x, m)(da)` of a relaxed semi-Markov control. -/
noncomputable def relaxDrift {d : ℕ} {T : ℝ≥0} {EA : Type} [MeasurableSpace EA] {A : Set EA}
    (b : ℝ → E d → PR d → EA → E d) (Λ : ℝ → E d → Flow d T → PA A) :
    ℝ → E d → Flow d T → E d :=
  fun t x m => ∫ a, b t x (ev m t) (a : EA) ∂(Λ t x m).meas

/-- The running reward `∫_A f(t, x, m_t, a) Λ(t, x, m)(da)` of a relaxed semi-Markov control. -/
noncomputable def relaxRun {d : ℕ} {T : ℝ≥0} {EA : Type} [MeasurableSpace EA] {A : Set EA}
    (f : ℝ → E d → PR d → EA → ℝ) (Λ : ℝ → E d → Flow d T → PA A) :
    ℝ → E d → Flow d T → ℝ :=
  fun t x m => ∫ a, f t x (ev m t) (a : EA) ∂(Λ t x m).meas

/-- The expected reward `E[∫_0^T R(t, X_t, μ) dt + g(X_T, μ_T)]`. -/
noncomputable def reward {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω)
    (X : Ω → Path d T) (μ : Ω → Flow d T) (R : ℝ → E d → Flow d T → ℝ)
    (g : E d → PR d → ℝ) : ℝ :=
  ∫ ω, ((∫ t in (0 : ℝ)..T, R t (ev (X ω) t) (μ ω)) + g (ev (X ω) T) (ev (μ ω) T)) ∂P

/-- The state equation `dX_t = D(t, X_t, μ) dt + dW_t` in pathwise form:
almost surely, `X_t = X_0 + ∫_0^t D(s, X_s, μ) ds + W_t` for all `t ∈ [0, T]`. -/
def SolvesState {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω)
    (W : ℝ≥0 → Ω → E d) (X : Ω → Path d T) (μ : Ω → Flow d T) (D : ℝ → E d → Flow d T → E d) :
    Prop :=
  ∀ᵐ ω ∂P, ∀ t : Set.Icc (0 : ℝ) T,
    X ω t = ev (X ω) 0 + (∫ s in (0 : ℝ)..t, D s (ev (X ω) s) (μ ω)) + W (t : ℝ).toNNReal ω

/-- `X` is **the solution** of `dX_t = D(t, X_t, μ) dt + dW_t`, `X_0 = ξ`, in the sense of
Remark 2.6 (p. 8): a measurable continuous process adapted to the completed filtration generated by
`(ξ, W_s, μ_s)_{s ≤ t}`, with `X_0 = ξ` a.s., satisfying the state equation. -/
def IsGenSol {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω)
    (W : ℝ≥0 → Ω → E d) (ξ : Ω → E d) (μ : Ω → Flow d T) (D : ℝ → E d → Flow d T → E d)
    (X : Ω → Path d T) : Prop :=
  Measurable X ∧
  (∀ s : Set.Icc (0 : ℝ) T, Measurable[genFilt P ξ W μ (s : ℝ).toNNReal] (fun ω => X ω s)) ∧
  (∀ᵐ ω ∂P, ev (X ω) 0 = ξ ω) ∧
  SolvesState P W X μ D

/-- The consistency condition (Definition 2.5(6), p. 8): for each `t ∈ [0, T]`,
`μ_t = P(X_t ∈ · | 𝓕^μ_t)` a.s., i.e. for every Borel `B ⊆ ℝ^d`,
`μ_t(B) = E[1_B(X_t) | 𝓕^μ_t]` a.s. -/
def IsConsistent {Ω : Type} [MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (P : Measure Ω)
    (X : Ω → Path d T) (μ : Ω → Flow d T) : Prop :=
  ∀ (t : Set.Icc (0 : ℝ) T) (B : Set (E d)), MeasurableSet B →
    (fun ω => ((μ ω t).meas B).toReal) =ᵐ[P]
      P[(B.indicator (fun _ => (1 : ℝ))) ∘ (fun ω => X ω t) | Fμ μ t]

/-- The common part (1), (3) and (6) of Definitions 2.5 and 3.6 (pp. 8, 17), for a tuple
`(Ω, 𝓕, 𝔽, P, W, X*, μ)`: `(Ω, 𝓕, 𝔽, P)` is a complete filtered probability space; `μ` is a
continuous `𝔽`-adapted `P(ℝ^d)`-valued process; `W` is an `𝔽`-Brownian motion; `X*` is a continuous
`𝔽`-adapted `ℝ^d`-valued process with `X*_0 ∼ λ`; `X*_0`, `μ` and `W` are independent; and the
consistency condition holds. -/
def IsWeakSetting {Ω : Type} [mΩ : MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} (lam : PR d)
    (P : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → E d) (X : Ω → Path d T)
    (μ : Ω → Flow d T) : Prop :=
  IsProbabilityMeasure P ∧ IsCompleteFilt 𝓕 P ∧
  Measurable μ ∧ (∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => μ ω s)) ∧
  IsFBrownian 𝓕 P W ∧
  Measurable X ∧ (∀ s : Set.Icc (0 : ℝ) T, Measurable[𝓕 (s : ℝ).toNNReal] (fun ω => X ω s)) ∧
  P.map (fun ω => ev (X ω) 0) = lam.meas ∧
  iIndep ![MeasurableSpace.comap (fun ω => ev (X ω) 0) inferInstance,
    MeasurableSpace.comap μ inferInstance, MeasurableSpace.comap (bmPath W) inferInstance] P ∧
  IsConsistent P X μ

/-- **Weak (semi-Markov) mean field equilibrium** (Definition 2.5, p. 8) on a given filtered
probability space: the tuple `(Ω, 𝓕, 𝔽, P, W, α*, X*, μ)` satisfies (1), (3), (6)
(`IsWeakSetting`), (2) `α*` is an `A`-valued semi-Markov function, (4) the state equation
`dX*_t = b(t, X*_t, μ_t, α*(t, X*_t, μ)) dt + dW_t`, and (5) optimality against every alternative
`A`-valued semi-Markov `α`, where the alternative state `X` is the solution of (2.2) with
`X_0 = X*_0` adapted to the completed filtration of `(X*_0, W, μ)` (Remark 2.6). -/
def IsWeakMFE {Ω : Type} [mΩ : MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} {EA : Type}
    [MeasurableSpace EA] (A : Set EA) (lam : PR d) (b : ℝ → E d → PR d → EA → E d)
    (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ) (P : Measure Ω)
    (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → E d) (α : ℝ → E d → Flow d T → EA)
    (X : Ω → Path d T) (μ : Ω → Flow d T) : Prop :=
  IsWeakSetting lam P 𝓕 W X μ ∧
  IsSemiMarkovCtrl A α ∧
  SolvesState P W X μ (strictDrift b α) ∧
  ∀ α' : ℝ → E d → Flow d T → EA, IsSemiMarkovCtrl A α' →
    ∀ X' : Ω → Path d T, IsGenSol P W (fun ω => ev (X ω) 0) μ (strictDrift b α') X' →
      reward P X μ (strictRun f α) g ≥ reward P X' μ (strictRun f α') g

/-- **Weak semi-Markov relaxed mean field equilibrium** (Definition 3.6, p. 17) on a given
filtered probability space: as `IsWeakMFE`, with a `P(A)`-valued semi-Markov `Λ*`, the relaxed
state equation (3.2), and optimality against every `P(A)`-valued semi-Markov `Λ`, the alternative
state solving `dX_t = ∫_A b(t, X_t, μ_t, a) Λ(t, X_t, μ)(da) dt + dW_t` with `X_0 = X*_0`. -/
def IsWeakRMFE {Ω : Type} [mΩ : MeasurableSpace Ω] {d : ℕ} {T : ℝ≥0} {EA : Type}
    [TopologicalSpace EA] [MeasurableSpace EA]
    [OpensMeasurableSpace EA] (A : Set EA) (lam : PR d) (b : ℝ → E d → PR d → EA → E d)
    (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ) (P : Measure Ω)
    (𝓕 : Filtration ℝ≥0 mΩ) (W : ℝ≥0 → Ω → E d) (Λ : ℝ → E d → Flow d T → PA A)
    (X : Ω → Path d T) (μ : Ω → Flow d T) : Prop :=
  IsWeakSetting lam P 𝓕 W X μ ∧
  IsSemiMarkov Λ ∧
  SolvesState P W X μ (relaxDrift b Λ) ∧
  ∀ Λ' : ℝ → E d → Flow d T → PA A, IsSemiMarkov Λ' →
    ∀ X' : Ω → Path d T, IsGenSol P W (fun ω => ev (X ω) 0) μ (relaxDrift b Λ') X' →
      reward P X μ (relaxRun f Λ) g ≥ reward P X' μ (relaxRun f Λ') g

/-- `ν ∈ P(C([0, T]; P(ℝ^d)))` is the law of (the measure flow of) a weak MFE: some filtered
probability space carries a weak MFE whose flow `μ` has law `ν`. -/
def IsWeakMFELaw {d : ℕ} {T : ℝ≥0} {EA : Type} [MeasurableSpace EA] (A : Set EA) (lam : PR d)
    (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ)
    (ν : ProbabilityMeasure (Flow d T)) : Prop :=
  ∃ (Ω : Type) (mΩ : MeasurableSpace Ω) (P : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ)
    (W : ℝ≥0 → Ω → E d) (α : ℝ → E d → Flow d T → EA) (X : Ω → Path d T) (μ : Ω → Flow d T),
    IsWeakMFE A lam b f g P 𝓕 W α X μ ∧ P.map μ = (ν : Measure (Flow d T))

/-- `ν` is the law of (the measure flow of) a weak RMFE. -/
def IsWeakRMFELaw {d : ℕ} {T : ℝ≥0} {EA : Type} [TopologicalSpace EA] [MeasurableSpace EA]
    [OpensMeasurableSpace EA] (A : Set EA) (lam : PR d)
    (b : ℝ → E d → PR d → EA → E d) (f : ℝ → E d → PR d → EA → ℝ) (g : E d → PR d → ℝ)
    (ν : ProbabilityMeasure (Flow d T)) : Prop :=
  ∃ (Ω : Type) (mΩ : MeasurableSpace Ω) (P : Measure Ω) (𝓕 : Filtration ℝ≥0 mΩ)
    (W : ℝ≥0 → Ω → E d) (Λ : ℝ → E d → Flow d T → PA A) (X : Ω → Path d T) (μ : Ω → Flow d T),
    IsWeakRMFE A lam b f g P 𝓕 W Λ X μ ∧ P.map μ = (ν : Measure (Flow d T))

end ClosedLoopMFG.Limit


