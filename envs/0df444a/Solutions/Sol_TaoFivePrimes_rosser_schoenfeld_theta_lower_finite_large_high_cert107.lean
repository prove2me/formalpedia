/-- the walk: state `(m, c, e)` with `m * 2 ^ e * Y ≤ c#`; a step `(de, G)` decodes the primes of
`(c, c']` from `G`, tests them all by one gcd with `pool c'`, multiplies them into `m` and drops `de`
bits; the bound is checked on `[c, c')` unless `c' ≤ lo`; the end covers `[c, N)` and checks the
constant at `N` -/
def walk (C N Cb j bb lo : ℕ) : ℕ → ℕ → ℕ → List (ℕ × ℕ) → Bool
  | m, c, e, [] => Nat.ble 1 m && Nat.ble c N && (Nat.ble N lo || stepOK C c (bits m e) N) &&
      finOK C Cb m e j bb
  | m, c, e, (de, G) :: l =>
      let sr := dec 1 c G 100000
      Nat.ble 1 m && (Nat.ble sr.2 lo || stepOK C c (bits m e) sr.2) &&
        Nat.beq (Nat.gcd sr.1 (pool sr.2)) 1 && Nat.ble sr.2 100000000 &&
        walk C N Cb j bb lo (Nat.shiftRight (Nat.mul m sr.1) de) sr.2 (e + de) l

theorem lo_le (a : ℕ) : (a : ℝ) * 6931471803 / 10000000000 ≤ a * Real.log 2 := by
  have h := Real.log_two_gt_d9
  norm_num at h
  have ha : (0 : ℝ) ≤ a := by positivity
  nlinarith

theorem log_lb (C Y c m e : ℕ) (hY : (C : ℝ) / 2 ^ 40 ≤ Real.log Y) (hY0 : 0 < Y) (hm : 1 ≤ m)
    (h : m * 2 ^ e * Y ≤ primorial c) :
