open Matrix NumberField MeasureTheory

variable {mT : MeasurableSpace (InfiniteAdeleRing ℚ)ˣ} {mA : MeasurableSpace (InfiniteAdeleRing ℚ)}

private theorem archZeta31_nnreal_smul
    (r : NNReal) (μ : Measure (InfiniteAdeleRing ℚ)ˣ) (ν : Measure (InfiniteAdeleRing ℚ))
    (W : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ) (σ : (InfiniteAdeleRing ℚ)ˣ →* ℂˣ) (s : ℂ)
    (g : GL (Fin 3) (InfiniteAdeleRing ℚ)) :
    archZeta31 (r • μ) ν W σ s g = ((r : ℝ) : ℂ) * archZeta31 μ ν W σ s g := by
  unfold archZeta31
  rw [integral_smul_nnreal_measure, NNReal.smul_def, Complex.real_smul]

private theorem archZetaDual31_nnreal_smul (r : NNReal) (μ : Measure (InfiniteAdeleRing ℚ)ˣ)
    (ν : Measure (InfiniteAdeleRing ℚ)) (W : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ)
    (σ : (InfiniteAdeleRing ℚ)ˣ →* ℂˣ) (s : ℂ) (g : GL (Fin 3) (InfiniteAdeleRing ℚ)) :
    archZetaDual31 (r • μ) ν W σ s g = ((r : ℝ) : ℂ) * archZetaDual31 μ ν W σ s g :=
  archZeta31_nnreal_smul r μ ν (dualWhittakerFn3 W) σ⁻¹ s (weylPrime3 * transposeInv3 g)

end LanglandsTunnell.CubicInduction.ArchZetaSmul

