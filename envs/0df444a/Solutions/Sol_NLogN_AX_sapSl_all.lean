  · exact ⟨IState.isInt_of h, IState.isInt_of h⟩
  · refine ⟨show zsz (t.top r) ≤ Q by simpa [IState.top, h] using hN,
      show zsz (t.top r) ≤ Q by simpa [IState.top, h] using hN, ?_⟩
