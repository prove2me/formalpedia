section DiscFibres

variable {q : ℕ} {M' : ℕ} {A : ValuationSubring (AlgebraicClosure ℚ)}

namespace HasDiscFibres
set_option synthInstance.maxHeartbeats 1600000 in

private theorem _root_.ModularCurve.FullLevel.W1c.Plumbing.HasDiscFibres.comap (hrat : ∀ P : Place (AlgebraicClosure ℚ) ↥(fieldBar q M'), P.IsRational)
    {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A (fieldBar q M') Fbar) (τ : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M'))
    (h : SemistableCovering.HasDiscFibres C) : SemistableCovering.HasDiscFibres (C.comap τ) := by
  intro Q hQ
  obtain ⟨T, hT, hres, hord, hreg, huniq⟩ := h Q (by simpa only [ComponentChart.comap_nodes] using hQ)
  have hT' : τ.symm T ∈ (C.comap τ).integers := by
    rw [ComponentChart.mem_comap_integers, AlgEquiv.apply_symm_apply]; exact hT
  have hresEq : (C.comap τ).residue ⟨τ.symm T, hT'⟩ = C.residue ⟨T, hT⟩ := by
    rw [ComponentChart.comap_residue_apply]
    congr 1
    exact Subtype.ext (τ.apply_symm_apply T)
  refine ⟨τ.symm T, hT', ?_, ?_, ?_, ?_⟩
  · rw [hresEq]; exact hres
  · rw [hresEq]; exact hord
  · intro P hP hPQ
    rw [ComponentChart.mem_comap_dom] at hP
    rw [ComponentChart.comap_placeMap] at hPQ
    obtain ⟨hmem, hA, hmax⟩ := hreg (τ • P) hP hPQ
    have e : P.evalAt (τ.symm T) = (τ • P).evalAt T := Place.Transport.evalAt_symm τ P (hrat P) T
    refine ⟨(Place.Transport.mem_smul_iff τ P T).mp hmem, e ▸ hA, ?_⟩
    have hsub : (⟨P.evalAt (τ.symm T), e ▸ hA⟩ : A) = ⟨(τ • P).evalAt T, hA⟩ := Subtype.ext e
    rw [hsub]
    exact hmax
  · intro c hc
    obtain ⟨P₀, ⟨hP₀, hP₀Q, hval⟩, huniq₀⟩ := huniq c hc
    refine ⟨τ⁻¹ • P₀, ⟨?_, ?_, ?_⟩, ?_⟩
    · show τ • τ⁻¹ • P₀ ∈ C.dom
      rwa [smul_inv_smul]
    · show C.placeMap (τ • τ⁻¹ • P₀) = Q
      rw [smul_inv_smul]; exact hP₀Q
    · rw [Place.Transport.evalAt_symm τ _ (hrat _), smul_inv_smul]; exact hval
    · rintro P ⟨hP, hPQ, hPval⟩
      rw [ComponentChart.mem_comap_dom] at hP
      rw [ComponentChart.comap_placeMap] at hPQ
      rw [Place.Transport.evalAt_symm τ P (hrat P)] at hPval
      have := huniq₀ (τ • P) ⟨hP, hPQ, hPval⟩
      rw [← this, inv_smul_smul]

end HasDiscFibres
