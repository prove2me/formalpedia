open IntMul

theorem bflyT_snoc (F : ℤ) : ∀ (A B : List ℤ) (a b : ℤ), A.length = B.length →
    bflyT F (A ++ [a]) (B ++ [b]) = bflyT F A B ++ [(b + a) % F]
  | [], [], a, b, _ => rfl
  | u :: A, v :: B, a, b, h => by
    simp only [List.cons_append, bflyT, List.length_cons, add_left_inj] at h ⊢
    rw [bflyT_snoc F A B a b h]
  | [], _ :: _, _, _, h => by simp at h
  | _ :: _, [], _, _, h => by simp at h

theorem bflyB_snoc (F : ℤ) (E : ℕ) : ∀ (j : ℕ) (A B : List ℤ) (a b : ℤ), A.length = B.length →
    bflyB F E j (A ++ [a]) (B ++ [b]) = bflyB F E j A B ++ [((-b + a) * 2 ^ ((j + A.length) * E)) % F]
  | j, [], [], a, b, _ => by simp [bflyB]
  | j, u :: A, v :: B, a, b, h => by
    simp only [List.cons_append, bflyB, List.length_cons, add_left_inj] at h ⊢
    rw [bflyB_snoc F E (j + 1) A B a b h]
    simp only [List.cons_append, List.cons.injEq, true_and]
    congr 4; ring
  | _, [], _ :: _, _, _, h => by simp at h
  | _, _ :: _, [], _, _, h => by simp at h

theorem length_bflyT (F : ℤ) : ∀ (A B : List ℤ), A.length = B.length →
    (bflyT F A B).length = A.length
  | [], [], _ => rfl
  | u :: A, v :: B, h => by
    simp only [bflyT, List.length_cons, add_left_inj] at h ⊢; exact length_bflyT F A B h
  | [], _ :: _, h => by simp at h
  | _ :: _, [], h => by simp at h

theorem length_bflyB (F : ℤ) (E : ℕ) : ∀ (j : ℕ) (A B : List ℤ), A.length = B.length →
    (bflyB F E j A B).length = A.length
  | _, [], [], _ => rfl
  | j, u :: A, v :: B, h => by
    simp only [bflyB, List.length_cons, add_left_inj] at h ⊢; exact length_bflyB F E (j + 1) A B h
  | _, [], _ :: _, h => by simp at h
  | _, _ :: _, [], h => by simp at h

theorem canon_bflyT {F : ℤ} (hF : 0 < F) : ∀ A B : List ℤ, Canon F (bflyT F A B)
  | u :: A, v :: B => by
    intro x hx; simp only [bflyT, List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact ⟨Int.emod_nonneg _ hF.ne', Int.emod_lt_of_pos _ hF⟩
    · exact canon_bflyT hF A B x hx
  | [], _ => by intro x hx; simp [bflyT] at hx
  | _ :: _, [] => by intro x hx; simp [bflyT] at hx

theorem canon_bflyB {F : ℤ} (hF : 0 < F) (E : ℕ) : ∀ (j : ℕ) (A B : List ℤ), Canon F (bflyB F E j A B)
  | j, u :: A, v :: B => by
    intro x hx; simp only [bflyB, List.mem_cons] at hx
    rcases hx with rfl | hx
    · exact ⟨Int.emod_nonneg _ hF.ne', Int.emod_lt_of_pos _ hF⟩
    · exact canon_bflyB hF E (j + 1) A B x hx
  | _, [], _ => by intro x hx; simp [bflyB] at hx
  | _, _ :: _, [] => by intro x hx; simp [bflyB] at hx

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem bflyStep_runs (s : IState NS) (n e E : ℕ) (u v : ℤ) (c : ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (he : e + E ≤ n)
    (hu : 0 ≤ u ∧ u < 2 ^ n + 1) (hv : 0 ≤ v ∧ v < 2 ^ n + 1) (hc : zsz c ≤ n)
    (hV : s.G NLogN.V = .int u :: RV) (hX : s.G DX = .int v :: RX) (hW : s.G W = .int (2 ^ e) :: LW)
    (hC : s.G CC = .int c :: LC) (hE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog bflyStep s
      (((((((s.upd NLogN.V RV).upd DX RX).upd NLogN.P1 (.int ((v + u) % (2 ^ n + 1)) :: s.G NLogN.P1)).upd P2
        (.int (((-v + u) * 2 ^ e) % (2 ^ n + 1)) :: s.G P2)).upd W (.int (2 ^ (e + E)) :: LW)).upd
          CC (.int (c + -1) :: LC)))
      (100000 * (n + 3)) := by
  have hp : (0 : ℤ) < 2 ^ n := by positivity
  have hp1 : (2 : ℤ) ^ (n + 1) = 2 * 2 ^ n := by ring
  have hp2 : (2 : ℤ) ^ (2 * n + 1) = 2 * 2 ^ n * 2 ^ n := by ring
  have hpn : (2 : ℤ) ≤ 2 ^ n := by
    calc (2 : ℤ) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) hn
  have bu : zsz u ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  have bv : zsz v ≤ n + 1 := NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)
  -- piece 1
  have h1 : IRuns I iprog (.seq (.op (.dup DX T4)) (.seq (.op (.dup NLogN.V NLogN.P1)) (.op (.add T4 NLogN.P1 NLogN.P1)))) s
      (s.upd NLogN.P1 (.int (v + u) :: s.G NLogN.P1)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, hX, hV]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s1 := s.upd NLogN.P1 (.int (v + u) :: s.G NLogN.P1)
  have h2 := fred_runs (I := I) (iprog := iprog) (X := NLogN.P1) (by decide) (by decide) (by decide)
    (by decide) s1 (v + u) n (s.G NLogN.P1) LN LF (by simp [s1]) (by simp +decide [s1, hN]) (by simp +decide [s1, hF])
    (by
      have : |v + u| < 2 ^ (2 * n + 1) := by
        rw [abs_lt, hp2]; constructor <;> nlinarith
      have : (((v + u).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by push_cast; exact this
      exact_mod_cast this)
  set s2 := s1.upd NLogN.P1 (.int ((v + u) % (2 ^ n + 1)) :: s.G NLogN.P1)
  -- piece 2
  have h3 : IRuns I iprog (.seq (.op (.mv DX T4)) (.seq (.op (.neg T4)) (.seq (.op (.mv NLogN.V P2))
      (.seq (.op (.add T4 P2 P2)) (.op (.shl P2 W)))))) s2
      (((s2.upd DX RX).upd NLogN.V RV).upd P2 (.int ((-v + u) * 2 ^ e) :: s.G P2)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, s2, s1, hX, hV, hW, zsz_neg]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  set s3 := ((s2.upd DX RX).upd NLogN.V RV).upd P2 (.int ((-v + u) * 2 ^ e) :: s.G P2)
  have h4 := fred_runs (I := I) (iprog := iprog) (X := P2) (by decide) (by decide) (by decide)
    (by decide) s3 ((-v + u) * 2 ^ e) n (s.G P2) LN LF (by simp [s3])
    (by simp +decide [s3, s2, s1, hN]) (by simp +decide [s3, s2, s1, hF])
    (by
      have hev : (2 : ℤ) ^ e ≤ 2 ^ n := pow_le_pow_right₀ (by norm_num) (by omega)
      have he0 : (0 : ℤ) < 2 ^ e := by positivity
      have : |(-v + u) * 2 ^ e| < 2 ^ (2 * n + 1) := by
        rw [abs_mul, abs_of_pos he0, hp2]
        have : |-v + u| ≤ 2 ^ n := by rw [abs_le]; constructor <;> omega
        nlinarith
      have : ((((-v + u) * 2 ^ e).natAbs : ℕ) : ℤ) < ((2 ^ (2 * n + 1) : ℕ) : ℤ) := by
        push_cast; exact this
      exact_mod_cast this)
  set s4 := s3.upd P2 (.int (((-v + u) * 2 ^ e) % (2 ^ n + 1)) :: s.G P2)
  have h5 : IRuns I iprog (.seq (.op (.shl W NLogN.DE)) (decC CC)) s4
      ((s4.upd W (.int (2 ^ (e + E)) :: LW)).upd CC (.int (c + -1) :: LC)) (2000 * (n + 3)) := by
    apply IRuns.of_runsTo 0
    simp +decide [IStmt.run, IOp.run, decC, s4, s3, s2, s1, hW, hE, hC, zsz_neg_one, pow_add]
    (first | exact ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), by ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega))⟩ | ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, takeCost, splitCost, shlCost, catCost] at *; omega)) | ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)))
  refine (IRuns.seq h1 (IRuns.seq h2 (IRuns.seq h3 (IRuns.seq h4 h5)))).mono' ?_ (by omega)
  simp only [s4, s3, s2, s1]
  ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide))

end NLogN

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

theorem bflyLoop_runs (s : IState NS) (n E : ℕ) (lo hi : List ℤ)
    (RV RX LW LC LE LN LF : List Item) (hn : 1 ≤ n) (hlen : lo.length = hi.length)
    (hE : lo.length * E ≤ n) (hcz : zsz (lo.length : ℤ) ≤ n)
    (hlo : Canon (2 ^ n + 1) lo) (hhi : Canon (2 ^ n + 1) hi)
    (hV : s.G NLogN.V = ints lo ++ RV) (hX : s.G DX = ints hi ++ RX) (hW : s.G W = .int 1 :: LW)
    (hC : s.G CC = .int lo.length :: LC) (hDE : s.G NLogN.DE = .int (2 ^ E) :: LE)
    (hN : s.G RN = .int (2 ^ n) :: LN) (hF : s.G RF = .int (2 ^ n + 1) :: LF) :
    IRuns I iprog (.loop CC (fun c => c != .zero) bflyStep) s
      (((((((s.upd NLogN.V RV).upd DX RX).upd NLogN.P1
        ((ints (bflyT (2 ^ n + 1) lo hi)).reverse ++ s.G NLogN.P1)).upd P2
        ((ints (bflyB (2 ^ n + 1) E 0 lo hi)).reverse ++ s.G P2)).upd W
          (.int (2 ^ (lo.length * E)) :: LW)).upd CC (.int 0 :: LC)))
      (lo.length * (100000 * (n + 3) + 30) + 30) := by
  set F : ℤ := 2 ^ n + 1 with hFdef
  set L0 := lo.zip hi with hL0
  have hm1 : L0.map Prod.fst = lo := by simp [L0, List.map_fst_zip, hlen]
  have hm2 : L0.map Prod.snd = hi := by simp [L0, List.map_snd_zip, hlen]
  have hl0 : L0.length = lo.length := by simp [L0, hlen]
  let St : List (ℤ × ℤ) → List (ℤ × ℤ) → IState NS := fun D R =>
    ((((((s.upd NLogN.V (ints (R.map Prod.fst) ++ RV)).upd DX (ints (R.map Prod.snd) ++ RX)).upd NLogN.P1
      ((ints (bflyT F (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G NLogN.P1)).upd P2
      ((ints (bflyB F E 0 (D.map Prod.fst) (D.map Prod.snd))).reverse ++ s.G P2)).upd W
        (.int (2 ^ (D.length * E)) :: LW)).upd CC (.int (R.length : ℤ) :: LC))
  have h0 : St [] L0 = s := by
    apply IState.ext' <;> intros <;> simp [St, hm1, hm2, hV, hX, hW, hC, hl0, bflyT, bflyB] <;>
      split_ifs <;> simp_all
  have hk : St L0 [] = (((((((s.upd NLogN.V RV).upd DX RX).upd NLogN.P1
        ((ints (bflyT F lo hi)).reverse ++ s.G NLogN.P1)).upd P2
        ((ints (bflyB F E 0 lo hi)).reverse ++ s.G P2)).upd W
          (.int (2 ^ (lo.length * E)) :: LW)).upd CC (.int 0 :: LC))) := by
    simp [St, hm1, hm2, hl0]
  have := IRuns.loopList (I := I) (iprog := iprog) (i := CC) (f := fun c => c != .zero)
    (p := bflyStep) L0 St (100000 * (n + 3))
    (by intro D x R _; simp [St]; omega)
    (by simp [St])
    (by
      intro D x R hD
      have hmem : x ∈ L0 := by rw [← hD]; simp
      have hx1 : x.1 ∈ lo := by rw [← hm1]; exact List.mem_map_of_mem hmem
      have hx2 : x.2 ∈ hi := by rw [← hm2]; exact List.mem_map_of_mem hmem
      have hlD : D.length + 1 + R.length = lo.length := by
        rw [← hl0, ← hD]; simp; omega
      have hc : zsz ((R.length + 1 : ℕ) : ℤ) ≤ n := le_trans (zsz_natCast_le (by omega)) hcz
      have hst := bflyStep_runs (I := I) (iprog := iprog) (St D (x :: R)) n (D.length * E) E x.1
        x.2 ((R.length + 1 : ℕ) : ℤ) (ints (R.map Prod.fst) ++ RV) (ints (R.map Prod.snd) ++ RX)
        LW LC LE LN LF hn (by nlinarith) (hlo _ hx1) (hhi _ hx2) hc (by simp +decide [St])
        (by simp +decide [St]) (by simp +decide [St]) (by simp +decide [St])
        (by simp +decide [St, hDE]) (by simp +decide [St, hN]) (by simp +decide [St, hF, hFdef])
      refine hst.mono' ?_ le_rfl
      have e4 := bflyT_snoc F (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      have e5 := bflyB_snoc F E 0 (D.map Prod.fst) (D.map Prod.snd) x.1 x.2 (by simp)
      simp only [List.length_map, zero_add] at e5
      have e6 : D.length * E + E = (D.length + 1) * E := by ring
      simp only [St, List.map_append, List.map_cons, List.map_nil, e4, e5, List.length_append,
        List.length_singleton, e6]
      apply IState.ext' <;> intros <;> simp [ints_append] <;> split_ifs <;> simp_all)
  rw [h0, hk, hl0] at this
  exact this

theorem two_pow_succ_div (j : ℕ) : sg ((2 : ℤ) ^ (j + 1)) (((2 : ℤ) ^ (j + 1)).natAbs / 2 ^ 1) =
    2 ^ j := by
  have : ((2 : ℤ) ^ (j + 1)).natAbs = 2 ^ (j + 1) := by simp
  have h2 : (2 : ℕ) ^ (j + 1) / 2 ^ 1 = 2 ^ j := by rw [pow_succ, pow_one]; simp
  have h3 : ¬ (2 : ℤ) ^ (j + 1) < 0 := not_lt.mpr (by positivity)
  rw [this, h2]; unfold sg; rw [if_neg h3]; push_cast; rfl

theorem two_pow_succ_mod (j : ℕ) : sg ((2 : ℤ) ^ (j + 1)) (((2 : ℤ) ^ (j + 1)).natAbs % 2 ^ 1) =
    0 := by
  have : ((2 : ℤ) ^ (j + 1)).natAbs = 2 ^ (j + 1) := by simp
  have h2 : (2 : ℕ) ^ (j + 1) % 2 ^ 1 = 0 := by rw [pow_succ, pow_one]; simp
  rw [this, h2]; exact sg_zero _

theorem two_pow_succ_div' (j : ℕ) : sg ((2 : ℤ) ^ (j + 1)) (2 ^ (j + 1) / 2) = 2 ^ j := by
  have := two_pow_succ_div j; simpa using this

theorem two_pow_succ_mod' (j : ℕ) : sg ((2 : ℤ) ^ (j + 1)) (2 ^ (j + 1) % 2) = 0 := by
  have := two_pow_succ_mod j; simpa using this

theorem zsz_natCast_le_self (k : ℕ) : zsz (k : ℤ) ≤ k := by
  apply zsz_le_of_lt; simp only [Int.natAbs_natCast]; exact Nat.lt_two_pow_self

theorem canon_bnd {n : ℕ} {A : List ℤ} (h : Canon (2 ^ n + 1) A) : NLogN.Bnd (n + 1) A := by
  intro a ha
  have := h a ha
  have hp : (2 : ℤ) ^ (n + 1) = 2 * 2 ^ n := by ring
  have hp' : (1 : ℤ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  exact NLogN.zsz_le_of_abs (by rw [abs_lt]; omega)

end NLogN

