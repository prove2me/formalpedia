theorem OAI.CanonicalQuadraticSieve.coefficientAtScale_row_sum (N X : ℝ) (a : idealRange N → ℂ)
    (ha : ∀ J, a J ≠ 0 → (Ideal.absNorm J.val : ℝ) ≤ X) (z : O) :
    (∑ J : idealRange N, quadraticRow J.val z * a J) =
      ∑ J : idealRange X, quadraticRow J.val z * coefficientAtScale N X a J := by sorry
