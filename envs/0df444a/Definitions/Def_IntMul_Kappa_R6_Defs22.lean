section ChildR

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

/-- The size of the scale expression. -/
def gsSz (c : Cfg) : ℕ := (gsNE c.Aw c.p c.m (.mul (.lit 0) (.reg wF))).size

/-- The child frame expressions with values. -/
noncomputable def childFrL (c : Cfg) (s F Bn : ℕ) : List (Fin HS × Ex HS × ℤ) :=
  [(wP, .pow2 (gsNE c.Aw c.p c.m (.mul (.lit s) (.reg wF))).toEx, (2 : ℤ) ^ c.G (s * F)),
    (vX, (gsNE c.Aw c.p c.m (.mul (.lit s) (.reg wF))).toEx, ((c.G (s * F) : ℕ) : ℤ)),
    (vB, .reg wB, (Bn : ℤ)), (vk, (NE.mul (.lit s) (.reg wF)).toEx, ((s * F : ℕ) : ℤ))]

/-- The cost of the child frame pushes (`2^{Gs}` by a linear-cost `pow2`). -/
def cChF (c : Cfg) (Bz G : ℕ) : ℕ :=
  (gsSz c * 10 ^ 7 * (Bz + 2) ^ 2 + 2 * moveCost Bz + pow2Cost G + 2 * Bz + 100) +
    (2 * moveCost (Bz + G + 1) + 19) + cFrame 3 (gsSz c + 1) Bz

end ChildR

