  have cP : (Ex.pow2 (gsNE c.Aw c.p c.m x).toEx).Clean := clean_of_lt (fun j hj => by
    simp only [Ex.regs] at hj
    rw [NE.regs_toEx] at hj; rw [hxr j (gsNE_regs _ _ _ x j hj)]; decide)
  have cX : x.toEx.Clean := clean_of_lt (fun j hj => by
    rw [NE.regs_toEx] at hj; rw [hxr j hj]; decide)
  have item : ∀ (q : Fin HS) (ex : Ex HS) (v : ℤ), q.val < 56 → ex.Clean →
      ex.size ≤ gsSz c + 1 → ExV σ ex v Bz →
      (q, ex, v).1.val < 56 ∧ (q, ex, v).2.1.Clean ∧ (q, ex, v).2.1.size ≤ gsSz c + 1 ∧
