@[reassoc]
theorem specMap_appLE_comp_fromSpec {M : Scheme.{0}} {U : M.Opens} (hU : IsAffineOpen U) {R : CommRingCat.{0}}
    (x : Spec R ⟶ M) (hx : ⊤ ≤ x ⁻¹ᵁ U) :
    Spec.map (Scheme.ΓSpecIso R).hom ≫ Spec.map (x.appLE U ⊤ hx) ≫ hU.fromSpec = x := by
  rw [IsAffineOpen.SpecMap_appLE_fromSpec x hU (isAffineOpen_top _) hx,
    IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Category.assoc, ← Spec.map_comp, Iso.inv_hom_id,
    Spec.map_id, Category.id_comp]

theorem mem_smul_iff {V : Type*} [AddCommGroup V] [Module ℂ V] (ME : Submodule ℤ V) (p : V → Prop)
    (hME : ∀ v, v ∈ ME ↔ p v) (c : ℂ) (w : V) :
    w ∈ c • ME ↔ ∃ v, p v ∧ c • v = w := by
  rw [Submodule.mem_smul_pointwise_iff_exists]
  exact ⟨fun ⟨v, hv, h⟩ => ⟨v, (hME v).1 hv, h⟩, fun ⟨v, hv, h⟩ => ⟨v, (hME v).2 hv, h⟩⟩

