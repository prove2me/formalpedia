-- title:
--   Rank one and multiplicity one for S₂(Γ_H(M))
-- statement:
--   Fix $M\ge 1$, a subgroup $H\le(\mathbb{Z}/M)^\times$, and a set $S\subseteq\mathbb{N}$ assumed finite. Write $W$ for the space `CuspForm (CohCarrier.GammaH M H) 2` of weight-two cusp forms for the group $\Gamma_H(M)$, i.e. the image in $SL(2,\mathbb{Z})$ of those elements of $\Gamma_0(M)$ whose diagonal unit $\bar d\in(\mathbb{Z}/M)^\times$ attached by `gamma0Units` lies in $H$. Inside $\operatorname{End}_{\mathbb{C}}(W)$ consider the $\mathbb{C}$-subalgebra $A$ generated by the set of operators consisting of: [`CuspForm.heckeTLinH 2 hℓ hℓM`](def/CuspForm_HeckeOperatorFormsGammaH.html#L224) for each prime $\ell\nmid M$ with $\ell\notin S$; [`CuspForm.heckeULinH 2 q`](def/CuspForm_HeckeOperatorFormsGammaH.html#L171) for each prime $q\mid M$; and [`CuspForm.diamondLinH 2 d`](def/CuspForm_HeckeOperatorFormsGammaH.html#L132) for each $d\in(\mathbb{Z}/M)^\times$. Each of these three families is defined by the corresponding explicit formula on $q$-expansion level (the $U_\ell$-type average, respectively the average twisted by a lift of $d$, respectively slashing by a lift of $d$) whenever that formula is known to send cusp forms to cusp forms, namely when the predicates `StableT M H 2 ℓ`, `StableU M H 2 q`, `StableD M H 2` hold, and as the zero endomorphism otherwise. The conclusion is twofold: first, $W$ admits a basis indexed by `Fin 1` as an $A$-module, so $W$ is free of rank one over $A$; second, for every $\mathbb{C}$-algebra homomorphism $\chi:A\to\mathbb{C}$ the simultaneous eigenspace $\bigcap_{a\in A}\ker(a-\chi(a))$ has $\mathbb{C}$-dimension exactly $1$.
--
--   This is the multiplicity-one, or rank-one, statement for weight-two cusp forms on $\Gamma_H(M)$ relative to the Hecke algebra generated by the good $T_\ell$ outside a finite exceptional set, the $U_q$ at primes dividing the level, and the diamond operators. It feeds the corresponding rank-two statement for parabolic cohomology, [`CohCarrier.nonempty_basis_fin_two_parabolicHoms_gammaH_and_finrank_eigenspace_eq_two`](thm.html#CohCarrier.nonempty_basis_fin_two_parabolicHoms_gammaH_and_finrank_eigenspace_eq_two).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_nonempty_basis_fin_one_gammaH_and_finrank_eigenspace_eq_one.lean

import Definitions.Def_CuspForm_HeckeOperatorFormsGammaH
import Mathlib.LinearAlgebra.Eigenspace.Basic
import Mathlib.LinearAlgebra.Dimension.Finrank
import Mathlib.LinearAlgebra.Basis.Defs

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

theorem CuspForm.nonempty_basis_fin_one_gammaH_and_finrank_eigenspace_eq_one
    (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (S : Set ℕ) (hSfin : S.Finite) :
    Nonempty (Module.Basis (Fin 1)
      ↥(Algebra.adjoin ℂ {T : Module.End ℂ (CuspForm (CohCarrier.GammaH M H) 2) |
          (∃ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓM : ¬ ℓ ∣ M), ℓ ∉ S ∧ T = CuspForm.heckeTLinH 2 hℓ hℓM) ∨
          (∃ q : ℕ, q.Prime ∧ q ∣ M ∧ T = CuspForm.heckeULinH 2 q) ∨
          (∃ d : (ZMod M)ˣ, T = CuspForm.diamondLinH 2 d)})
      (CuspForm (CohCarrier.GammaH M H) 2)) ∧
    ∀ χ : ↥(Algebra.adjoin ℂ {T : Module.End ℂ (CuspForm (CohCarrier.GammaH M H) 2) |
          (∃ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓM : ¬ ℓ ∣ M), ℓ ∉ S ∧ T = CuspForm.heckeTLinH 2 hℓ hℓM) ∨
          (∃ q : ℕ, q.Prime ∧ q ∣ M ∧ T = CuspForm.heckeULinH 2 q) ∨
          (∃ d : (ZMod M)ˣ, T = CuspForm.diamondLinH 2 d)}) →ₐ[ℂ] ℂ,
      Module.finrank ℂ ↥(⨅ a : ↥(Algebra.adjoin ℂ {T : Module.End ℂ (CuspForm (CohCarrier.GammaH M H) 2) |
          (∃ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓM : ¬ ℓ ∣ M), ℓ ∉ S ∧ T = CuspForm.heckeTLinH 2 hℓ hℓM) ∨
          (∃ q : ℕ, q.Prime ∧ q ∣ M ∧ T = CuspForm.heckeULinH 2 q) ∨
          (∃ d : (ZMod M)ˣ, T = CuspForm.diamondLinH 2 d)}),
        Module.End.eigenspace (a : Module.End ℂ (CuspForm (CohCarrier.GammaH M H) 2)) (χ a)) = 1 := by sorry
