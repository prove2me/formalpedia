  extV_of_RL hg.der (RL_succ.1 h.RL).2 hd

theorem RL_exists {k : ℕ} {g : ℝ → ℝ} (h : RL k g) : ∃ L, Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L) := by
  obtain ⟨M, hM⟩ := RL_iter h 0 (Nat.zero_le _)
  exact ⟨M, by simpa using hM⟩

