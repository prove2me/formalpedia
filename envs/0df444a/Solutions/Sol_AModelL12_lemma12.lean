open AModel
variable {α : Type*}
theorem solution (child : ℕ → AModelL12.Oracle α) (Tc : ℕ → ℕ → ℝ → ℝ) (d : α) {W m q ρ₀ : ℕ}
    {τ K₀ c : ℝ} (hm : 2 ≤ m) (hW : 1 ≤ W) (hq : 2 ≤ q) (hWq : W ≤ q ^ (2 * ρ₀))
    (hτ : 0 < τ) (hK₀ : 0 ≤ K₀) (hc : 0 ≤ c)
    (hspec : ∀ K, AModelL12.OracleSpec (child K) d W m q K)
    (hcost : ∀ K j V, 0 ≤ V → Tc K j V ≤ K₀ * V * ((m : ℝ) ^ j) ^ τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : ℕ, 1 ≤ u → ∀ Pre G Suf : AModel.Shape,
      (∀ xs : List α, AModelL12.lemma12Prog child W m q ρ₀ Pre G Suf u d xs =
        AModel.pull (AModelL12.binShape Pre G Suf (2 ^ u)) (AModelL12.binShape Pre G Suf (2 ^ u))
          (AModel.swapPos Pre.length (Pre.length + 1 + G.length)) d xs) ∧
      AModelL12.lemma12Cost Tc c W m q ρ₀ Pre G Suf u ≤
        K * (AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ) * (u : ℝ) ^ τ := by
  obtain ⟨Cκ, hCκ0, hCκ⟩ := AModelL12.clog_le_rpow hm hτ
  obtain ⟨K'', hK''0, hK''⟩ := AModelL12.l12qCost_le (c := c) (D := ρ₀ * Cκ) hm hτ hK₀ hc (by positivity)
  refine ⟨(2 * c + K'') * (q : ℝ) ^ 2, by positivity, fun u hu Pre G Suf => ?_⟩
  have h2u : 1 < 2 ^ u := Nat.one_lt_two_pow (by omega)
  set e := AModelL12.eOf q u with hedef
  set Kp := AModelL12.kOf m q u with hKdef
  have he1 : 1 ≤ e := Nat.clog_pos (by omega) h2u
  have heu : 2 ^ u ≤ q ^ e := Nat.le_pow_clog (by omega) _
  have heK : e ≤ m ^ Kp := Nat.le_pow_clog (by omega) _
  refine ⟨fun xs => AModelL12.l12bin_correct (hspec Kp) hm hW (ρ₀ * Kp) Pre G Suf heK heu xs, ?_⟩
  unfold AModelL12.lemma12Cost AModelL12.l12binCost
  rw [← hedef, ← hKdef]
  have hWK : W ^ Kp ≤ q ^ (ρ₀ * Kp + ρ₀ * Kp) := by
    rw [show ρ₀ * Kp + ρ₀ * Kp = 2 * ρ₀ * Kp by ring, pow_mul]
    exact Nat.pow_le_pow_left hWq Kp
  have hρ : ((ρ₀ * Kp : ℕ) : ℝ) ≤ ρ₀ * Cκ * (e : ℝ) ^ τ := by
    have := mul_le_mul_of_nonneg_left (hCκ e he1) (Nat.cast_nonneg ρ₀)
    have hKe : Kp = Nat.clog m e := rfl
    rw [← hKe] at this
    push_cast; linarith
  have hQ := hK'' (Tc Kp) W q Kp (ρ₀ * Kp) Pre G Suf e he1 hW (hcost Kp) hWK hρ
  rw [← AModelL12.vol_binShape_q] at hQ
  set Vq : ℝ := (AModel.vol (AModelL12.binShape Pre G Suf (q ^ e)) : ℝ)
  set Vb : ℝ := (AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) : ℝ)
  -- the padded volume is at most `q² V`
  have hqe : q ^ e ≤ q * 2 ^ u := by
    have := Nat.pow_pred_clog_lt_self (b := q) (by omega) h2u
    change q ^ e.pred < 2 ^ u at this
    calc q ^ e = q ^ (e.pred + 1) := by rw [Nat.pred_eq_sub_one, Nat.sub_add_cancel he1]
      _ = q * q ^ e.pred := by rw [pow_succ, mul_comm]
      _ ≤ q * 2 ^ u := Nat.mul_le_mul_left q this.le
  have hVq : Vq ≤ (q : ℝ) ^ 2 * Vb := by
    have : AModel.vol (AModelL12.binShape Pre G Suf (q ^ e)) ≤ q ^ 2 * AModel.vol (AModelL12.binShape Pre G Suf (2 ^ u)) := by
      rw [AModelL12.vol_binShape, AModelL12.vol_binShape]
      calc AModel.vol Pre * AModel.vol G * AModel.vol Suf * (q ^ e) ^ 2 ≤ AModel.vol Pre * AModel.vol G * AModel.vol Suf * (q * 2 ^ u) ^ 2 :=
            by gcongr
        _ = q ^ 2 * (AModel.vol Pre * AModel.vol G * AModel.vol Suf * (2 ^ u) ^ 2) := by ring
    simp only [Vq, Vb]; exact_mod_cast this
  have heτ : (e : ℝ) ^ τ ≤ (u : ℝ) ^ τ := by
    have : e ≤ u := Nat.clog_le_of_le_pow (Nat.pow_le_pow_left hq u)
    exact Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast this) hτ.le
  have huτ : 1 ≤ (u : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast hu) hτ.le
  have hVq0 : 0 ≤ Vq := Nat.cast_nonneg _
  have hVb0 : 0 ≤ Vb := Nat.cast_nonneg _
  have A : c * Vq ≤ c * ((q : ℝ) ^ 2 * Vb) * (u : ℝ) ^ τ := by
    have h1 := mul_le_mul_of_nonneg_left hVq hc
    have h2 : 0 ≤ c * ((q : ℝ) ^ 2 * Vb) := by positivity
    nlinarith
  have B : K'' * Vq * (e : ℝ) ^ τ ≤ K'' * ((q : ℝ) ^ 2 * Vb) * (u : ℝ) ^ τ := by
    have heτ0 : 0 ≤ (e : ℝ) ^ τ := by positivity
    calc K'' * Vq * (e : ℝ) ^ τ ≤ K'' * ((q : ℝ) ^ 2 * Vb) * (e : ℝ) ^ τ := by gcongr
      _ ≤ K'' * ((q : ℝ) ^ 2 * Vb) * (u : ℝ) ^ τ := by gcongr
  nlinarith
end
