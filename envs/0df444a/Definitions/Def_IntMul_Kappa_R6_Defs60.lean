-- Source module: Solutions.ResampleParams
/-!
# §9.1–9.2 Fixed rational choice and sizes

* `constants_ok`: the layer and dimension conditions of (38), `margins_ok`: the seven margins
  of (45) with `min gᵢ = 2⁻¹⁸¹ = 2κ`.
* Axis lengths `t_i ∈ {r/2, r}` with `∏ t_i = T`, last axis `r` (`axExp_sum`, `axLen_prod`,
  `axExp_last`), `p/(12d) ≤ ℓ ≤ p/(3d)` (`ell_bounds`), `24n ≤ T p < 48 n` (`Tp_bounds`).
* Source lengths: `(1-2η)t_i < s_i ≤ (1-η)t_i` ⇒ `S > T/2` (`S_gt_half`), `θ_i > η`
  (`theta_gt_eta`), `α⁴θ_i > p` (`alpha4_theta_gt_p`), `γ < 28 d² √b` (`gamma_bound`);
  existence of pairwise coprime odd `s_i` (`sources_exist`, from `RCop.coprime_params`).
* Radix digits (§9.2.3): `2q - 2 < S` (`degree_lt_S`) and `c_j < 2^{3b}` (`coeff_lt`).
-/

open Finset

namespace IntMul.OpenAI.RP

/-! ### (38) and (45) -/

def g7 : ℚ := ε

/-! ### Axis lengths of the padded box -/

lemma ell_spec (L d : ℕ) (hd : 0 < d) : L ≤ d * ell L d ∧ d * ell L d ≤ L + d - 1 := by
  unfold ell
  constructor
  · have := Nat.lt_div_mul_add (a := L + d - 1) hd
    rw [mul_comm]; omega
  · have := Nat.div_mul_le_self (L + d - 1) d
    rw [mul_comm]; exact this

lemma mcnt_lt (L d : ℕ) (hd : 0 < d) : mcnt L d < d := by
  have := ell_spec L d hd; unfold mcnt; omega

lemma axExp_sum (L d : ℕ) (hd : 0 < d) : ∑ i : Fin d, axExp L d i = L := by
  have hs := ell_spec L d hd
  have hm := mcnt_lt L d hd
  have hl : 0 < mcnt L d → 1 ≤ ell L d := by
    intro hpos
    by_contra h; push Not at h
    have : ell L d = 0 := by omega
    unfold mcnt at hpos; rw [this] at hpos; simp at hpos
  have key : ∀ i : Fin d, (axExp L d i : ℤ) =
      (ell L d : ℤ) - (if (i : ℕ) < mcnt L d then 1 else 0) := by
    intro i; unfold axExp
    split_ifs with h
    · have := hl (by omega); push_cast [Nat.cast_sub this]; ring
    · simp
  zify
  rw [Finset.sum_congr rfl (fun i _ => key i), Finset.sum_sub_distrib,
    Fin.sum_univ_eq_sum_range (fun i => if i < mcnt L d then (1 : ℤ) else 0), Finset.sum_boole]
  have hf : (Finset.range d).filter (fun i => i < mcnt L d) = Finset.range (mcnt L d) := by
    ext x; simp only [Finset.mem_filter, Finset.mem_range]; omega
  rw [hf]
  simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, Finset.card_range, nsmul_eq_mul]
  unfold mcnt
  push_cast [Nat.cast_sub hs.1]
  ring

/-- `∏ t_i = T` with `t_i = 2^{axExp}`. -/
lemma axLen_prod (L d : ℕ) (hd : 0 < d) : ∏ i : Fin d, 2 ^ axExp L d i = 2 ^ L := by
  rw [Finset.prod_pow_eq_pow_sum, axExp_sum L d hd]

/-- `p/(12d) ≤ ℓ ≤ p/(3d)` for `p = 6b`, `b/2 ≤ L ≤ b`, `1 ≤ d ≤ b`. -/
lemma ell_bounds (L d b : ℕ) (hd : 0 < d) (hdb : d ≤ b) (hL1 : b ≤ 2 * L) (hL2 : L ≤ b) :
    (6 * b : ℝ) / (12 * d) ≤ ell L d ∧ (ell L d : ℝ) ≤ (6 * b : ℝ) / (3 * d) := by
  have hs := ell_spec L d hd
  have hd' : (0 : ℝ) < d := by exact_mod_cast hd
  constructor
  · rw [div_le_iff₀ (by positivity)]
    have : (b : ℝ) ≤ 2 * (d * ell L d) := by
      have : b ≤ 2 * (d * ell L d) := by omega
      exact_mod_cast this
    nlinarith
  · rw [le_div_iff₀ (by positivity)]
    have : ((d * ell L d : ℕ) : ℝ) ≤ 2 * b := by
      have : d * ell L d ≤ 2 * b := by omega
      exact_mod_cast this
    push_cast at this
    nlinarith

/-! ### Source lengths, resampling margins -/

/-- (40): `α ≤ 2(12d²b)^{1/4}` gives `γ = 2dα² < 28 d² √b`. -/
lemma gamma_bound (d b α : ℝ) (hd : 0 < d) (hb : 0 < b) (hα0 : 0 ≤ α)
    (hα : α ≤ 2 * (12 * d ^ 2 * b) ^ ((1 : ℝ) / 4)) :
    2 * d * α ^ 2 < 28 * d ^ 2 * Real.sqrt b := by
  have hX : 0 < 12 * d ^ 2 * b := by positivity
  have h2 : α ^ 2 ≤ 4 * Real.sqrt (12 * d ^ 2 * b) := by
    have : α ^ 2 ≤ (2 * (12 * d ^ 2 * b) ^ ((1 : ℝ) / 4)) ^ 2 := by gcongr
    rw [mul_pow, ← Real.rpow_natCast ((12 * d ^ 2 * b) ^ ((1 : ℝ) / 4)) 2,
      ← Real.rpow_mul hX.le, Real.sqrt_eq_rpow] at *
    norm_num at this ⊢; linarith
  have h3 : Real.sqrt (12 * d ^ 2 * b) = d * Real.sqrt 12 * Real.sqrt b := by
    rw [show 12 * d ^ 2 * b = d ^ 2 * (12 * b) by ring, Real.sqrt_mul (by positivity),
      Real.sqrt_sq hd.le, Real.sqrt_mul (by norm_num)]; ring
  have h12 : Real.sqrt 12 < 3.5 := by
    rw [Real.sqrt_lt' (by norm_num)]; norm_num
  have hsb : 0 < Real.sqrt b := Real.sqrt_pos.2 hb
  rw [h3] at h2
  have : 2 * d * α ^ 2 ≤ 8 * d ^ 2 * Real.sqrt 12 * Real.sqrt b := by nlinarith
  have : 8 * d ^ 2 * Real.sqrt 12 * Real.sqrt b < 28 * d ^ 2 * Real.sqrt b := by
    have : 0 < d ^ 2 * Real.sqrt b := by positivity
    nlinarith
  linarith

/-! ### §9.2.3 radix-digit polynomials -/

