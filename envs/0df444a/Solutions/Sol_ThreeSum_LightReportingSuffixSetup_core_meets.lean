    Nat.le_mul_of_pos_left _ (by omega)
  have hproductWord : (((2^stage*B)*(2^stage*D) : ℕ) : ℤ) ≤ lim.word := by
    have hh : (2^stage*B)*(2^stage*D) ≤ 2^V*((2^stage*B)*(2^stage*D)) :=
