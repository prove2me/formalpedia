theorem nonempty_of_iff (h : ∀ ⦃A : Type⦄ [CommRing A] [IsLocalRing A] [Algebra 𝒪 A] (ρ : GaloisRepAdic A), 𝒟 ρ ↔ 𝒟' ρ)
