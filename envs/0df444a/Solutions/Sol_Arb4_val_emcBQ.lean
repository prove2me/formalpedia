theorem abs_bern_div (i : ℕ) (hi : i ≤ 10) :
    |(bernoulli (i + 2) : ℝ)| / ((i + 2)! : ℝ)
      = |(ArbEcon.OrderK.betaN i : ℝ)| / (ArbEcon.OrderK.Lbeta : ℝ) := by
  have hF : (0 : ℝ) < ((i + 2)! : ℝ) := by exact_mod_cast Nat.factorial_pos _
