section IsoTransport

variable {E E' : FakeEllipticCurve Λ 1 A} (e : E.A ≅ E'.A) (he : e.hom ≫ E'.f = E.f)

def isoCoord (θ : RelativeGroupLaw.FormalCoordinates E.f 2) : RelativeGroupLaw.FormalCoordinates E'.f 2 :=
  fun C _ _ s => mapPt e.hom he (θ C s)

@[scoped simp] theorem isoCoord_val (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (C : Type) [CommRing C] [Algebra A C]
    (s : Fin 2 → C) : (isoCoord e he θ C s).1 = (θ C s).1 ≫ e.hom := rfl

include he in
theorem he_inv : e.inv ≫ E.f = E'.f := by
  rw [← he, ← Category.assoc, e.inv_hom_id, Category.id_comp]

variable {e he}

theorem eq_one_of_mul_self {S : Type} [CommRing S] {A₁ : Scheme.{0}} {f : A₁ ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (x : SchemeHomOver t f)
    (hx : L.mul t x x = x) : x = L.one t := by
  calc x = L.mul t (L.one t) x := (L.one_mul t x).symm
    _ = L.mul t (L.mul t (L.inv t x) x) x := by rw [L.inv_mul_cancel]
    _ = L.mul t (L.inv t x) (L.mul t x x) := by rw [L.mul_assoc]
    _ = L.mul t (L.inv t x) x := by rw [hx]
    _ = L.one t := L.inv_mul_cancel t x

theorem mapPt_one
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) : mapPt e.hom he (E.L.one t) = E'.L.one t := by
  apply eq_one_of_mul_self E'.L t
  rw [← hmul, E.L.mul_one]

theorem one_val_comp_hom
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) : (E.L.one t).1 ≫ e.hom = (E'.L.one t).1 :=
  congrArg Subtype.val (mapPt_one hmul t)

theorem isInfinitesimal_iff_val {S : Type} [CommRing S] {A₁ : Scheme.{0}} {f : A₁ ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {C : Type} [CommRing C] [Algebra S C] (J : Ideal C)
    (P : SchemeHomOver (Scheme.specOver (𝒪 := S) C) f) :
    L.IsInfinitesimal J P ↔
      Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫ P.1 = (L.one (Scheme.specOver (𝒪 := S) (C ⧸ J))).1 := by
  constructor
  · intro h; exact congrArg Subtype.val h
  · intro h; exact Subtype.ext h

theorem isFormalCoordinates_isoCoord
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    {F : MvFormalGroup 2 A} {θ : RelativeGroupLaw.FormalCoordinates E.f 2} (hθ : E.L.IsFormalCoordinates F θ) :
    E'.L.IsFormalCoordinates F (isoCoord e he θ) := by
  obtain ⟨hnat, hnil⟩ := hθ
  refine ⟨?_, ?_⟩
  · intro C _ _ C' _ _ ψ s hs
    apply Subtype.ext
    rw [isoCoord_val, schemeHomOverComp_coe, isoCoord_val, hnat C C' ψ s hs, schemeHomOverComp_coe, Category.assoc]
  · intro C _ _ J k hJ
    obtain ⟨hinto, hinj, honto, hhom⟩ := hnil C J k hJ
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro s hs
      rw [isInfinitesimal_iff_val, isoCoord_val, ← Category.assoc, (isInfinitesimal_iff_val E.L J _).1 (hinto s hs)]
      exact one_val_comp_hom hmul _
    · intro s t hs ht hst
      apply hinj s t hs ht
      apply Subtype.ext
      have h := congrArg Subtype.val hst
      rw [isoCoord_val, isoCoord_val] at h
      exact (cancel_mono e.hom).1 h
    · intro P hP
      have hP' : E.L.IsInfinitesimal J (mapPt e.inv (he_inv e he) P) := by
        rw [isInfinitesimal_iff_val, mapPt_coe, ← Category.assoc, (isInfinitesimal_iff_val E'.L J P).1 hP,
          ← one_val_comp_hom hmul, Category.assoc, e.hom_inv_id, Category.comp_id]
      obtain ⟨s, hs, hθs⟩ := honto _ hP'
      refine ⟨s, hs, Subtype.ext ?_⟩
      rw [isoCoord_val, hθs, mapPt_coe, Category.assoc, e.inv_hom_id, Category.comp_id]
    · intro s t hs ht
      show mapPt e.hom he (θ C (F.nilMul k s t)) = _
      rw [hhom s t hs ht, hmul]
      rfl

theorem isFormalModuleVia_isoCoord
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    (hact : ∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E'.act x)
    {X : FormalODModule q A} {θ : RelativeGroupLaw.FormalCoordinates E.f 2} (hX : E.IsFormalModuleVia coord X θ) :
    E'.IsFormalModuleVia coord X (isoCoord e he θ) := by
  refine ⟨isFormalCoordinates_isoCoord hmul hX.1, ?_⟩
  intro C _ _ J n hJ x s hs
  apply Subtype.ext
  rw [isoCoord_val, hX.2 C J n hJ x s hs, mapPt_coe, mapPt_coe, isoCoord_val, Category.assoc, hact x,
    Category.assoc]

theorem Rig.iso {g : u₀.1.A ⟶ E.A} {g' : u₀.1.A ⟶ E'.A} (hge : g ≫ e.hom = g')
    (hmul : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of A)) (P Q : SchemeHomOver t E.f),
      mapPt e.hom he (E.L.mul t P Q) = E'.L.mul t (mapPt e.hom he P) (mapPt e.hom he Q))
    (hact : ∀ x : ↥Λ, E.act x ≫ e.hom = e.hom ≫ E'.act x)
    {X : FormalODModule q A} {θ : RelativeGroupLaw.FormalCoordinates E.f 2} {w : (X.map resA).Hom X₀.toFormalODModule}
    (h : Rig coord θ₀ resA E g X θ w) : Rig coord θ₀ resA E' g' X (isoCoord e he θ) w := by
  obtain ⟨hXθ, hwiso, hred⟩ := h
  refine ⟨isFormalModuleVia_isoCoord hmul hact hXθ, hwiso, ?_⟩
  intro B'' _ _ _ _ J n hJ s hs
  rw [← hge, ← Category.assoc, hred B'' J n hJ s hs, isoCoord_val]

end IsoTransport
