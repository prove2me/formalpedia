lemma progOps_append' (a b : List (GChunk Rl 576)) : progOps (a ++ b) = progOps a ++ progOps b := by
  simp [progOps]

lemma opK_loc {ι : ℕ → Rl} (hinj : ∀ w < NL, ∀ w' < NL, ι w = ι w' → w = w')
    {l : List (ℕ × ℕ × ℤ)} (hl : ∀ o ∈ l, o.1 < NL ∧ o.2.1 < NL) (hd : LD l) :
    ∀ o ∈ l.map (toG ι), OpK o := by
  intro o ho
  obtain ⟨o', ho', rfl⟩ := List.mem_map.1 ho
  refine Or.inl ⟨fun e => hd o' ho' (hinj _ (hl o' ho').1 _ (hl o' ho').2 e), o'.2.2, rfl⟩

theorem opK_CH_sol_aux : ∀ o ∈ progOps CH, OpK o := by
  intro o ho
  rw [CH, progOps_append', progOps_append', progOps_append'] at ho
  rcases List.mem_append.1 ho with ho | ho
  · rcases List.mem_append.1 ho with ho | ho
    · rcases List.mem_append.1 ho with ho | ho
      · -- S1
        obtain ⟨C, hC, ho⟩ := List.mem_flatMap.1 ho
        rw [S1] at hC
        obtain ⟨b, hb, hC⟩ := List.mem_flatMap.1 hC
        have hb' := List.mem_range.1 hb
        have ho' : o ∈ progOps (G1 b) := List.mem_flatMap.2 ⟨C, hC, ho⟩
        rw [G1, progOps_mapProg, cs1, progRun_ops] at ho'
        exact opK_loc (ι1_inj hb') (progChk_ops_lt _ _ seg1.1) (LD_specs1 dat dataOK) o ho'
      · -- E4
        obtain ⟨C, hC, ho⟩ := List.mem_flatMap.1 ho
        rw [E4s] at hC
        obtain ⟨b, _, rfl⟩ := List.mem_map.1 hC
        simp [E4c] at ho
    · -- S2
      obtain ⟨C, hC, ho⟩ := List.mem_flatMap.1 ho
      rw [S2] at hC
      obtain ⟨a, ha, hC⟩ := List.mem_flatMap.1 hC
      have ha' := List.mem_range.1 ha
      have ho' : o ∈ progOps (G2 a) := List.mem_flatMap.2 ⟨C, hC, ho⟩
      rw [G2, progOps_mapProg, cs2, progRun_ops] at ho'
      exact opK_loc (ι2_inj ha') (progChk_ops_lt _ _ seg2.1) (LD_specs2 dat dataOK) o ho'
  · -- KK
    obtain ⟨C, hC, ho⟩ := List.mem_flatMap.1 ho
    rw [KK] at hC
    obtain ⟨p, _, hC⟩ := List.mem_flatMap.1 hC
    simp only [K, List.mem_cons, List.not_mem_nil, or_false] at hC
    rcases hC with rfl | rfl | rfl
    · simp only [C1, List.mem_singleton] at ho
      subst ho
      exact Or.inl ⟨fun e => X_ne_τ e.symm, 2, by norm_num⟩
    · simp only [C2, List.mem_singleton] at ho
      subst ho
      exact Or.inl ⟨Y_ne_τ, 2, by norm_num⟩
    · simp only [C3, List.mem_singleton] at ho
      subst ho
      exact Or.inr ⟨rfl, rfl⟩

