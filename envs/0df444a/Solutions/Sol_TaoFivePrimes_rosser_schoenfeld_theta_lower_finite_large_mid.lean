end TFPThetaM2

theorem solution (t : Real) (h1 : 10 ^ 4 <= t) (h2 : t <= 10 ^ 6) :
    t - 2 * Real.sqrt t < Chebyshev.theta t := by
  have ht0 : (0 : ℝ) ≤ t := by linarith
  have hm1 : 9999 ≤ ⌊t⌋₊ := Nat.le_floor (by norm_num at h1 ⊢; linarith)
  have hm2 : ⌊t⌋₊ < 1000001 := by
    have h := Nat.floor_le ht0
    have h' : (⌊t⌋₊ : ℝ) < 1000001 := by norm_num at h2; linarith
    exact_mod_cast h'
  exact TFPThetaM2.certB_sound TFPThetaM2.cond2 1000001
    (fun m => ∀ t : ℝ, ⌊t⌋₊ = m → 0 ≤ t → t - 2 * √t < Chebyshev.theta t) TFPThetaM2.cond2_sound
    9999 14276 TFPThetaM2.G0 TFPThetaM2.CP TFPThetaM2.CERT_ok ⌊t⌋₊ hm1 hm2 t rfl ht0
