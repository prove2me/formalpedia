p2m_open "LanglandsTunnell.Converse.Ideles P2MW.S_LanglandsTunnell_Converse_CuspSynthesis_exists_isHaarMeasure_torusTransform_eq_of_isJLNice.LanglandsTunnell.Converse.Ideles"

variable {K : Type} [Field K] [NumberField K] {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}
  {epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ} {ω : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ}
  (archR : ∀ w : InfinitePlace K, w.IsReal → RealArchParam)
  (archC : ∀ w : InfinitePlace K, w.IsComplex → ComplexArchParam)
  (dR : ∀ (w : InfinitePlace K) (hw : w.IsReal), ArchDatumR (archR w hw))
  (dC : ∀ (w : InfinitePlace K) (hw : w.IsComplex), ArchDatumC (archC w hw))

private theorem t0402 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (r : Kˣ) {β : Kˣ}
    (hβ : IsSUnit K S β) {y : (AdeleRing (𝓞 K) K)ˣ} (hy : y ∈ unitIdelesAt S) (g : AdelicGL2 (𝓞 K) K) :
    d010 d archR archC dR dC dF (diagOne y * g) (r * β) =
      d.a r * d.epsChar g *
        (((d017 S epsS (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) : ℂˣ) : ℂ) *
          archW' archR archC dR dC
            (globalPoints (𝓞 K) K (diagOne r) * (diagOne (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) * g)) *
          dF.Wf (globalPoints (𝓞 K) K (diagOne r) *
            (diagOne (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) * g))) := by
  have hpt : globalPoints (𝓞 K) K (diagOne (r * β)) * (diagOne y * g)
      = globalPoints (𝓞 K) K (diagOne r) * (diagOne (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) * g) := by
    simp only [map_mul, FiniteWhittaker.t0098, mul_assoc]
  unfold d010
  rw [hpt, d.a_mul r β hβ, t0228 d (fun v => t0137.1 hy v) g, map_mul (d017 S epsS),
    Units.val_mul, t0250, t0249]
  ring

private def d043 (epsS : ∀ v : HeightOneSpectrum (𝓞 K), (v.adicCompletion K)ˣ →* ℂˣ)
    (dF : FinWhittakerDatum K S Pi) (r : Kˣ) (g : AdelicGL2 (𝓞 K) K)
    (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (s : ℂ) (z : (AdeleRing (𝓞 K) K)ˣ) : ℂ :=
  archW' archR archC dR dC (diagOne z * (globalPoints (𝓞 K) K (diagOne r) * g)) *
      dF.Wf (diagOne z * (globalPoints (𝓞 K) K (diagOne r) * g)) *
    (((μ z : ℂˣ) : ℂ) * ((d017 S epsS z : ℂˣ) : ℂ)) * ((ideleNorm K z : ℝ) : ℂ) ^ s

private theorem t0403 (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi) (r : Kˣ) {β : Kˣ}
    (hβ : IsSUnit K S β) {y : (AdeleRing (𝓞 K) K)ˣ} (hy : y ∈ unitIdelesAt S) (g : AdelicGL2 (𝓞 K) K)
    {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hμ : IsIdeleClassChar (𝓞 K) K μ) (s : ℂ) :
    d010 d archR archC dR dC dF (diagOne y * g) (r * β) * ((μ y : ℂˣ) : ℂ) * ((ideleNorm K y : ℝ) : ℂ) ^ s
      = d.a r * d.epsChar g *
          d043 archR archC dR dC epsS dF r g μ s (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) := by
  have h1 : μ (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β) = 1 := hμ β
  have hcomm : diagOne (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) * (globalPoints (𝓞 K) K (diagOne r) * g)
      = globalPoints (𝓞 K) K (diagOne r) * (diagOne (Units.map (algebraMap K (AdeleRing (𝓞 K) K)) β * y) * g) := by
    rw [FiniteWhittaker.t0098, ← mul_assoc, ← mul_assoc, ← map_mul, ← map_mul]
    congr 2
    exact mul_comm _ _
  unfold d043
  rw [t0402 archR archC dR dC d dF r hβ hy g, hcomm, map_mul μ, h1, one_mul, ideleNorm_mul,
    CuspRealizationCT.t0001, one_mul]
  ring

omit archR archC dR dC

private def d044 (S : Finset (HeightOneSpectrum (𝓞 K))) (α : Kˣ) : ↥S → ℤ :=
  fun v => -WithZero.log (Valued.v ((localOf K v.1 α : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K))

private theorem t0404 (v : HeightOneSpectrum (𝓞 K)) (α β : Kˣ) :
    localOf K v (α * β) = localOf K v α * localOf K v β :=
  map_mul (Units.map (algebraMap K (v.adicCompletion K)).toMonoidHom) α β

private theorem t0405 (v : HeightOneSpectrum (𝓞 K)) (α : Kˣ) : localOf K v α⁻¹ = (localOf K v α)⁻¹ :=
  map_inv (Units.map (algebraMap K (v.adicCompletion K)).toMonoidHom) α

private theorem t0406 (R : SOrderReps K S) (α : Kˣ) (v : ↥S) :
    Valued.v ((localOf K v.1 (R.rep (d044 S α)) : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K)
      = Valued.v ((localOf K v.1 α : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K) := by
  rw [R.rep_ord]
  show WithZero.exp (-(-WithZero.log
    (Valued.v ((localOf K v.1 α : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K)))) = _
  rw [neg_neg, WithZero.exp_log ((Valuation.ne_zero_iff _).mpr (Units.ne_zero _))]

private theorem t0407 (R : SOrderReps K S) (α : Kˣ) :
    IsSUnit K S (α * (R.rep (d044 S α))⁻¹) := fun v => by
  rw [t0404, t0405, Units.val_mul, map_mul, Units.val_inv_eq_inv_val, map_inv₀,
    t0406, mul_inv_cancel₀ ((Valuation.ne_zero_iff _).mpr (Units.ne_zero _))]

private theorem t0408 (R : SOrderReps K S) (n : ↥S → ℤ) {β : Kˣ} (hβ : IsSUnit K S β) :
    d044 S (R.rep n * β) = n := by
  funext v
  show -WithZero.log (Valued.v ((localOf K v.1 (R.rep n * β) : (v.1.adicCompletion K)ˣ) : v.1.adicCompletion K))
    = n v
  rw [t0404, Units.val_mul, map_mul, R.rep_ord, hβ v, mul_one, WithZero.log_exp, neg_neg]

private def d045 (R : SOrderReps K S) : (↥S → ℤ) × {β : Kˣ // IsSUnit K S β} ≃ Kˣ where
  toFun p := R.rep p.1 * p.2.1
  invFun α := (d044 S α, ⟨α * (R.rep (d044 S α))⁻¹, t0407 R α⟩)
  left_inv p := by
    obtain ⟨n, β, hβ⟩ := p
    have hn : d044 S (R.rep n * β) = n := t0408 R n hβ
    refine Prod.ext hn (Subtype.ext ?_)
    show R.rep n * β * (R.rep (d044 S (R.rep n * β)))⁻¹ = β
    rw [hn, mul_comm (R.rep n) β, mul_inv_cancel_right]
  right_inv α := by
    show R.rep (d044 S α) * (α * (R.rep (d044 S α))⁻¹) = α
    rw [mul_comm α, mul_inv_cancel_left]

private theorem t0409 (R : SOrderReps K S) {T : Kˣ → ℂ} (hT : Summable T) :
    ∑' α, T α = ∑' n : ↥S → ℤ, ∑' β : {β : Kˣ // IsSUnit K S β}, T (R.rep n * β.1) := by
  rw [← (d045 R).tsum_eq T]
  exact (hT.comp_injective (d045 R).injective).tsum_prod

