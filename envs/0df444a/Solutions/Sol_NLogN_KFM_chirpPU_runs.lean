theorem tup_le (s t n : ℕ) : ∀ x ∈ tupL s t n, zsz x ≤ zV t n := by
  intro x hx
  simp only [tupL, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl <;>
    exact zsz_natCast_le (by nlinarith [Nat.sub_le (2 * t) s, Nat.sub_le t s])

theorem ldB_runs (s t n : ℕ) (st : IState HS) (RD : List Item)
    (h : st.G NLogN.KFM.dS = ints (tupL s t n) ++ RD) :
    IRuns I iprog ldB st
      (((((((st.upd NLogN.KFM.dS RD).upd nX (.int (t : ℤ) :: st.G nX)).upd nX2
        (.int ((2 * t : ℕ) : ℤ) :: st.G nX2)).upd rJ1 (.int ((2 * t - s : ℕ) : ℤ) :: st.G rJ1)).upd rJ2
        (.int ((t - s : ℕ) : ℤ) :: st.G rJ2)).upd rN (.int (n : ℤ) :: st.G rN)).upd rN2
        (.int ((2 * (n * t) : ℕ) : ℤ) :: st.G rN2))
      (660 * (zV t n + 1)) := by
  have hb := tup_le s t n
  simp only [tupL, List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq] at hb
  obtain ⟨b1, b2, b3, b4, b5, b6⟩ := hb
  apply IRuns.of_runsTo 0
  simp +decide [ldB, IStmt.run, IOp.run, h, tupL, ints]
  refine ⟨by ((apply NLogN.IState.ext' <;> intros <;>
                      simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                    split_ifs <;>
                  simp_all +decide)), ?_⟩
  have := moveIntCost_le (zsz (t : ℤ)); have := moveIntCost_le (zsz ((2 * t : ℕ) : ℤ))
  have := moveIntCost_le (zsz ((2 * t - s : ℕ) : ℤ)); have := moveIntCost_le (zsz ((t - s : ℕ) : ℤ))
  have := moveIntCost_le (zsz (n : ℤ)); have := moveIntCost_le (zsz ((2 * (n * t) : ℕ) : ℤ))
  push_cast at *
  omega

