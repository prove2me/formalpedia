section s229
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitializeHeader
open Structured
lemma flag_eval (s : Data) : Eval flagCode s 2 (flagged s) := eval_sequence_atoms flagAtoms s
lemma flag_nat_frame (k : ℕ) (hk : k ≠ 648) : NatFrame flagCode k := by simp [flagCode,flagAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma flag_real_frame (k : ℕ) (hk : k ≠ 602) : RealFrame flagCode k := by simp [flagCode,flagAtoms,Structured.sequence,RealFrame,writesReal,Ne.symm hk]
lemma eval_code (b : Core) (B : ℕ) (e : Fin b.input.k) (s : Data)
    (htape : Exact.Adjacency.Tape b.input s)
    (hunit : s.natReg 26 = 1) (htwo : s.natReg 14 = 2)
    (hsource : s.natReg 72 = b.input.source.val) (hbase : s.natReg 552 = B+1)
    (he : s.natReg 560 = 2*e.val) (hcursor : s.natReg 652 = b.input.n+3*e.val)
    (hz : s.realReg 56 = 0) (hQ : s.realReg 502 = Q b) (hinitial : s.realReg 514 = 1/(2*Q b)) :
    ∃ cost t, Eval code s cost t ∧ cost ≤ 25 ∧ Loaded b B e t ∧ t.realMem = s.realMem ∧ t.natMem = s.natMem := by
  let a := CoreTape.result s
  have ha := CoreTape.eval_code s
  obtain ⟨hat,hah,haw,hac,hacost⟩ := CoreTape.values _ _ _ _ (Q b) s hcursor hunit hQ
    (htape e).1 (htape e).2.1 (htape e).2.2
  have han (k : ℕ) (hk : k ≠ 626 ∧ k ≠ 628 ∧ k ≠ 652 ∧ k ≠ 654) : a.natReg k = s.natReg k :=
    ha.nat_frame (CoreTape.nat_frame k hk.1 hk.2.1 hk.2.2.1 hk.2.2.2)
  have har (k : ℕ) (hk : k ≠ 604) : a.realReg k = s.realReg k := ha.real_frame (CoreTape.real_frame k hk)
  let u := CoreEdgeAddress.result a
  have hu := CoreEdgeAddress.eval_code a
  have huaddr : CoreRecord.Addresses (CoreMemory.field b B (.inl e) 0) u := by
    have hh := CoreEdgeAddress.values B e.val a ((han 552 (by omega)).trans hbase)
      ((han 560 (by omega)).trans he) ((han 14 (by omega)).trans htwo)
    simpa only [CoreMemory.field,logicalIndex_core_val,Nat.mul_zero,Nat.add_zero] using hh
  have hun (k : ℕ) (hk : k < 562 ∨ 580 < k) : u.natReg k = a.natReg k := hu.nat_frame (CoreEdgeAddress.nat_frame k hk)
  have hur (k : ℕ) : u.realReg k = a.realReg k := hu.real_frame (CoreEdgeAddress.real_frame k)
  let p := flagged u
  have hp := flag_eval u
  have hpn (k : ℕ) (hk : k ≠ 648) : p.natReg k = u.natReg k := hp.nat_frame (flag_nat_frame k hk)
  have hpr (k : ℕ) (hk : k ≠ 602) : p.realReg k = u.realReg k := hp.real_frame (flag_real_frame k hk)
  have hpzero : p.realReg 56 = 0 := ((hpr 56 (by omega)).trans ((hur 56).trans (har 56 (by omega)))).trans hz
  have hptail : p.natReg 626 = (b.input.graph.tail e).val := (hpn 626 (by omega)).trans ((hun 626 (by omega)).trans hat)
  have hpsource : p.natReg 72 = b.input.source.val := (hpn 72 (by omega)).trans ((hun 72 (by omega)).trans ((han 72 (by omega)).trans hsource))
  have hpinitial : p.realReg 514 = 1/(2*Q b) := (hpr 514 (by omega)).trans ((hur 514).trans ((har 514 (by omega)).trans hinitial))
  obtain ⟨cd,hd,hcd⟩ := CoreInitialDifference.eval_code p hpzero
  let t := CoreInitialDifference.result p
  have htn (k : ℕ) : t.natReg k = p.natReg k := hd.nat_frame (CoreInitialDifference.nat_frame k)
  have htr (k : ℕ) (hk : k ≠ 606) : t.realReg k = p.realReg k := hd.real_frame (CoreInitialDifference.real_frame k hk)
  have hall : Eval code s (8+(10+(2+cd))) t := Eval.seq ha (Eval.seq hu (Eval.seq hp hd))
  have hloaded : Loaded b B e t := by
    refine ⟨huaddr.frame _ (fun k hk => (htn k).trans (hpn k (by simp at hk;omega))),
      (htn 626).trans hptail,?_,?_,?_,CoreInitialDifference.value b e p hptail hpsource hpinitial,?_,?_⟩
    · exact (htn 628).trans ((hpn 628 (by omega)).trans ((hun 628 (by omega)).trans hah))
    · rw [htr 602 (by omega)]
      simp [p,flagged,flagAtoms,Atom.effect,instructionEffect,data,Data.machine]
    · exact (htr 604 (by omega)).trans ((hpr 604 (by omega)).trans ((hur 604).trans hacost))
    · rw [htn 648]
      simp [p,flagged,flagAtoms,Atom.effect,instructionEffect,data,Data.machine]
    · rw [htn 652,hpn 652 (by omega),hun 652 (by omega),hac]
      omega
  have hm : NoMemory code := ⟨CoreTape.no_memory,CoreEdgeAddress.no_memory,
    by simp [flagCode,flagAtoms,Structured.sequence,NoMemory,NoStore],CoreInitialDifference.no_memory⟩
  refine ⟨8+(10+(2+cd)),t,hall,by omega,hloaded,?_,?_⟩
  · exact (hall.no_memory hm).1
  · exact (hall.no_memory hm).2
end DecrAlmostLinearSSSP.Decremental.CoreInitializeHeader
end s229
section s230
set_option autoImplicit false
set_option maxRecDepth 10000
namespace DecrAlmostLinearSSSP.Decremental.CoreParameters
open Structured
lemma hCode_eval (s : Data) : Eval hCode s 5 (hData s) := eval_sequence_atoms hAtoms s
lemma qCode_eval (s : Data) : Eval qCode s 4 (qData s) := eval_sequence_atoms qAtoms s
lemma argumentCode_eval (s : Data) : Eval argumentCode s 9 (argumentData s) := eval_sequence_atoms argumentAtoms s
lemma header_eval (s : Data) : Eval header s 18 (headed s) := Eval.seq (hCode_eval s) (Eval.seq (qCode_eval _) (argumentCode_eval _))
lemma header_no_memory : NoMemory header := by
  simp [header,hCode,qCode,argumentCode,hAtoms,qAtoms,argumentAtoms,Structured.sequence,NoMemory,NoStore]
lemma header_nat_frame (k : ℕ) (hk : k ≠ 520) : NatFrame header k := by
  simp [header,hCode,qCode,argumentCode,hAtoms,qAtoms,argumentAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm hk]
lemma header_real_frame (k : ℕ) (hk : k ≠ 500 ∧ k ≠ 502 ∧ k ≠ 520 ∧ k ≠ 522 ∧ k ≠ 524) : RealFrame header k := by
  simp [header,hCode,qCode,argumentCode,hAtoms,qAtoms,argumentAtoms,Structured.sequence,RealFrame,writesReal,
    Ne.symm hk.1,Ne.symm hk.2.1,Ne.symm hk.2.2.1,Ne.symm hk.2.2.2.1,Ne.symm hk.2.2.2.2]
lemma headed_capture (i : Input) (s : Data) (h : InputCapture.Captured i s) : InputCapture.Captured i (headed s) :=
  h.frame (fun j hj => (header_eval s).nat_frame (header_nat_frame j (by omega)))
    (fun j hj => (header_eval s).real_frame (header_real_frame j (by omega)))
lemma hData_H (b : Core) (s : Data) (hn : s.natReg 66 = b.input.n) (hW : s.natReg 70 = b.input.W) :
    (hData s).realReg 500 = H b := by
  simp only [hData,hAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  simp only [hn,hW,Rat.cast_ofNat,H]
  ring
lemma qData_Q (b : Core) (s : Data) (hn : s.natReg 66 = b.input.n) (hH : s.realReg 500 = H b) :
    (qData s).realReg 502 = Q b := by
  simp only [qData,qAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  simp only [hn,hH,Rat.cast_ofNat,Q]
  ring
lemma argumentData_value (b : Core) (s : Data) (hsize : s.natReg 64 = b.input.size)
    (hunit : s.natReg 26 = 1) (heps : s.realReg 64 = b.input.accuracy) :
    (argumentData s).realReg 522 = 32*logarithm2 (b.input.size+1)/b.input.accuracy := by
  simp only [argumentData,argumentAtoms,List.foldl_cons,List.foldl_nil,Atom.effect,data,Data.machine,instructionEffect]
  simp (disch := decide) only [Function.update_of_ne,Function.update_self]
  simp only [hsize,hunit,heps,Rat.cast_ofNat,Nat.cast_add,Nat.cast_one,logarithm2]
  ring
lemma argumentCode_H_frame : RealFrame argumentCode 500 := by
  simp [argumentCode,argumentAtoms,Structured.sequence,RealFrame,writesReal]
lemma argumentCode_Q_frame : RealFrame argumentCode 502 := by
  simp [argumentCode,argumentAtoms,Structured.sequence,RealFrame,writesReal]
lemma qCode_H_frame : RealFrame qCode 500 := by simp [qCode,qAtoms,Structured.sequence,RealFrame,writesReal]
lemma headed_H (b : Core) (s : Data) (h : InputCapture.Captured b.input s) : (headed s).realReg 500 = H b := by
  exact ((argumentCode_eval _).real_frame argumentCode_H_frame).trans
    (((qCode_eval _).real_frame qCode_H_frame).trans (hData_H b s h.vertices h.weightBound))
lemma headed_Q (b : Core) (s : Data) (h : InputCapture.Captured b.input s) : (headed s).realReg 502 = Q b := by
  exact ((argumentCode_eval _).real_frame argumentCode_Q_frame).trans
    (qData_Q b (hData s) h.vertices (hData_H b s h.vertices h.weightBound))
lemma headed_argument (b : Core) (s : Data) (h : InputCapture.Captured b.input s) :
    (headed s).realReg 522 = 32*logarithm2 (b.input.size+1)/b.input.accuracy := by
  have he := Eval.seq (hCode_eval s) (qCode_eval (hData s))
  have hr : (qData (hData s)).realReg 64 = s.realReg 64 := he.real_frame (by
    simp [hCode,qCode,hAtoms,qAtoms,Structured.sequence,RealFrame,writesReal])
  exact argumentData_value b _ h.size h.unit (hr.trans h.accuracy)
end DecrAlmostLinearSSSP.Decremental.CoreParameters
end s230
section s231
set_option autoImplicit false
