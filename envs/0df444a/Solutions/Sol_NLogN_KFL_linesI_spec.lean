  set τ := (1 - (2 : ℝ)⁻¹ ^ 50)
  set Cs := 2 * Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ
  have hCs : 0 ≤ Cs := by positivity
  intro ls
  induction ls with
  | nil =>
    intro _ I t zs R hb h0 hlen
    refine ⟨1, ?_, by simp⟩
    simp only [NLogN.KFL.linesI]
    refine (NLogN.IRuns.skip t).mono' ?_ le_rfl
    rw [show (fun c => ([] : List Butterfly.Line).foldr (fun l c => NLogN.KFL.lineP K ρ f l c) c) = id from rfl,
      NLogN.KFL.rixT_id hlen, ← h0, NLogN.KFL.upd_self]
  | cons l ls ih =>
    intro hls I t zs R hb h0 hlen
    have hl := hls l List.mem_cons_self
    -- the line
    have L1 : ∃ c1 : ℕ, NLogN.IRuns I NLogN.KFL.l12prog (NLogN.KFL.lineI q K ρ f g l) t
        (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.lineP K ρ f l) zs) ++ R)) c1 ∧
        (c1 : ℝ) ≤ Cs + NLogN.KFL.cRotG K f g Bb := by
      have hrot := fun (t' : NLogN.IState NLogN.HS) (zs' : List ℤ) (hb' : NLogN.KFL.Bits zs') (h0' : t'.G 0 = NLogN.ints zs' ++ R)
          (hl' : zs'.length = g.V) =>
        NLogN.KFL.rotStep_geo (I := I) (iprog := NLogN.KFL.l12prog) hK hρK hf g hg hQe l hl.1 hl.2 hB2 hbig zV 1 t' zs'
          R hl' (NLogN.KFL.bnd_bits hb') h0'
      have hcr := NLogN.KFL.cRot_le_G K f g Bb l.b hl.2
      have hrc : ∀ c : NLogN.KFL.Tr, NLogN.KFL.TV g.Q c → NLogN.KFL.rot2 g.Q (NLogN.KFL.amt K ρ f l) c =
          (c.1, c.2.1, (c.2.2 + 2 ^ (f * K) - NLogN.KFL.amt K ρ f l c.1 c.2.1) % 2 ^ (f * K)) := by
        intro c _; simp [NLogN.KFL.rot2, hQe]
      by_cases hy : l.tgtY
      · obtain ⟨⟨-, -, -⟩, ⟨c2, H2, hc2⟩, -⟩ := (HK g hg (f * K) hu hQe I t zs R hb h0 hlen)
        set t1 := t.upd 0 (NLogN.ints (NLogN.KFL.rixT g NLogN.KFL.sw12 zs) ++ R)
        have hb1 : NLogN.KFL.Bits (NLogN.KFL.rixT g NLogN.KFL.sw12 zs) := NLogN.KFL.bits_rixT hb
        have R2 := hrot t1 (NLogN.KFL.rixT g NLogN.KFL.sw12 zs) hb1 (by simp [t1]) (NLogN.KFL.length_rixT _ _ _)
        simp only [t1, NLogN.IState.upd_upd_same] at R2
        have hb2 : NLogN.KFL.Bits (NLogN.KFL.rixT g (NLogN.KFL.rot2 g.Q (NLogN.KFL.amt K ρ f l)) (NLogN.KFL.rixT g NLogN.KFL.sw12 zs)) := NLogN.KFL.bits_rixT hb1
        obtain ⟨⟨-, -, -⟩, ⟨c3, H3, hc3⟩, -⟩ := (HK g hg (f * K) hu hQe I
          (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.rot2 g.Q (NLogN.KFL.amt K ρ f l)) (NLogN.KFL.rixT g NLogN.KFL.sw12 zs)) ++ R))
          _ R hb2 (by simp) (NLogN.KFL.length_rixT _ _ _))
        rw [NLogN.IState.upd_upd_same] at H3
        refine ⟨c2 + (NLogN.KFL.cRot K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 1 Bb + c3), ?_, ?_⟩
        · have E := H2.seq (R2.seq H3)
          simp only [NLogN.KFL.lineI, hy, if_true]
          refine E.mono' ?_ le_rfl
          congr 3
          rw [NLogN.KFL.rixT_rixT hg (NLogN.KFL.TV_sw12) (NLogN.KFL.TV_rot2 hg.q _), NLogN.KFL.rixT_rixT hg (F := NLogN.KFL.sw12 ∘ NLogN.KFL.rot2 g.Q (NLogN.KFL.amt K ρ f l))
            (fun c hc => NLogN.KFL.TV_sw12 _ (NLogN.KFL.TV_rot2 hg.q _ c hc)) NLogN.KFL.TV_sw12]
          refine NLogN.KFL.rixT_congr hg (fun c hc => ?_) _
          simp [NLogN.KFL.lineP, hy, NLogN.KFL.rot2, NLogN.KFL.sw12, hQe]
        · push_cast
          have : (NLogN.KFL.cRot K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 1 Bb : ℝ) ≤ NLogN.KFL.cRotG K f g Bb := by
            exact_mod_cast hcr
          have h2 : (c2 : ℝ) ≤ Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := hc2
          have h3 : (c3 : ℝ) ≤ Ks * ((g.V : ℝ) + 1) * ((f * K : ℕ) : ℝ) ^ τ := hc3
          simp only [Cs]; linarith
      · have R1 := hrot t zs hb h0 hlen
        refine ⟨NLogN.KFL.cRot K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 1 Bb, ?_, ?_⟩
        · simp only [NLogN.KFL.lineI, hy, if_false]
          refine R1.mono' ?_ le_rfl
          congr 3
          refine NLogN.KFL.rixT_congr hg (fun c hc => ?_) _
          simp [NLogN.KFL.lineP, hy, NLogN.KFL.rot2, hQe]
        · have : (NLogN.KFL.cRot K f l.b (g.N0 * g.Q * g.N1 * g.Q * g.N2) g.Q g.S2 1 Bb : ℝ) ≤ NLogN.KFL.cRotG K f g Bb := by
            exact_mod_cast hcr
          linarith
    obtain ⟨c1, H1, hc1⟩ := L1
    have hb1 : NLogN.KFL.Bits (NLogN.KFL.rixT g (NLogN.KFL.lineP K ρ f l) zs) := NLogN.KFL.bits_rixT hb
    obtain ⟨c2, H2, hc2⟩ := ih (fun l' hl' => hls l' (List.mem_cons_of_mem _ hl')) I
      (t.upd 0 (NLogN.ints (NLogN.KFL.rixT g (NLogN.KFL.lineP K ρ f l) zs) ++ R)) _ R hb1 (by simp) (NLogN.KFL.length_rixT _ _ _)
    rw [NLogN.IState.upd_upd_same] at H2
    refine ⟨c1 + c2, ?_, ?_⟩
    · refine (H1.seq H2).mono' ?_ le_rfl
      congr 3
      have hQ : g.Q = 2 ^ (f * K) := hQe
      rw [NLogN.KFL.rixT_rixT hg (fun c hc => hQ ▸ NLogN.KFL.TV_lineP l c (hQ ▸ hc))
        (fun c hc => hQ ▸ NLogN.KFL.TV_foldr ls c (hQ ▸ hc))]
      rfl
    · push_cast
      simp only [List.length_cons, Nat.cast_add, Nat.cast_one] at hc2 ⊢
      nlinarith
end
