  ·
    intro i ℓ hℓs
    by_cases hℓq : (ℓ : ℕ) = q'
    · obtain rfl : ℓ = ⟨q', hq'⟩ := Subtype.ext hℓq
      exact leg29_q M s q' hs hq' hsq' hq'M hsM A hA D₁ D₂ ab e₁ e₂ w wV m dpair Φ h₁ h₂
        hc.2.2.2.2.2.2.2.1 hc.2.2.2.2.2.2.2.2.1 hc.2.2.2.2.2.2.2.2.2.2.1
        hc.2.2.2.2.2.2.2.2.2.2.2.1 hc.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1.2.1 hcomp i
    · exact leg29_off M s q' hs hq' hsq' hq'M hsM A hA D₁ D₂ ab e₁ e₂ h₁ h₂ hid hc.2.2.1 hc.2.2.2.1 i ℓ hℓs hℓq
  · exact leg30 M s q' hs hq' hsq' hq'M hsM A hA D₁ D₂ ab e₁ e₂ h₁ h₂ hid hc.2.2.1 hc.2.2.2.1
  · exact leg31 M s q' hs hq' hsq' hq'M hsM A hA D₁ D₂ ab e₁ e₂ h₁ h₂ hid hc.2.2.1 hc.2.2.2.1
