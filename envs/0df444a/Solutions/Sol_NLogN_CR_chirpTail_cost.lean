    rw [Int.tmod_eq_emod_of_nonneg hk0]
    rcases hmod with h | h <;> rw [h] <;> simp [zsz_zero, zsz_one] <;> omega
  have z2 : zsz (2 : ℤ) ≤ B := by
    have : zsz (2 : ℤ) = zsz ((2 : ℕ) : ℤ) := rfl
