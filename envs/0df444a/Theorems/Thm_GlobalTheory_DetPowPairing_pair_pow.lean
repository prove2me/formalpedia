variable {σ : Type} {C : Type} [CommRing C]

theorem GlobalTheory.DetPowPairing.pair_pow (n x : ℕ) :
    (∏ c ∈ Finset.range n, (c.factorial : C)) * pair (cayDet n C ^ x) (cayDet n C ^ x) =
      ∏ c ∈ Finset.range n, ((x + c).factorial : C) := by sorry
