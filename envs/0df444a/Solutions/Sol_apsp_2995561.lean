  have hbands : nB * (R + (S7 + (E + 1) * (L + 1))) ≤ 4 * (nB * (R + L * S7)) :=
    (Nat.mul_le_mul_left _ (by omega : _ ≤ 4 * (R + L * S7))).trans (le_of_eq (by ring))
  omega

