/-!
# Finite generation: the two directions across a finite-index subgroup

Mathlib has Schreier's lemma `Subgroup.fg_of_index_ne_zero`, that a finite-index subgroup of a
finitely generated group is finitely generated.  Wolf's Proposition 4.1 needs the converse as
well, that finite generation passes *up* from a finite-index subgroup, and the standard
"generators of the quotient together with the kernel" principle.
-/

namespace Wolf
namespace Lib

open Subgroup

/-- Transport finite generation along an isomorphism. -/
theorem fg_of_mulEquiv {A B : Type*} [Group A] [Group B] [Group.FG A] (e : A ≃* B) :
    Group.FG B :=
  Group.fg_of_surjective (f := (e : A →* B)) e.surjective

/-- Finite generation passes **up** from a subgroup of finite index: a finite generating set of
`H` together with a transversal of `H` generates the whole group. -/
theorem fg_of_fg_of_finiteIndex {G : Type*} [Group G] (H : Subgroup G)
    [H.FiniteIndex] [Group.FG H] : Group.FG G := by
  classical
  obtain ⟨T, hT, hTfin⟩ := (Group.fg_iff (G := H)).1 inferInstance
  set R : Set G := Set.range (fun q : G ⧸ H => Quotient.out q) with hR
  set A : Set G := H.subtype '' T ∪ R with hA
  have himg : Subgroup.closure (H.subtype '' T) = H := by
    rw [← MonoidHom.map_closure, hT, ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  refine Group.fg_iff.2 ⟨A, ?_, (hTfin.image _).union (Set.finite_range _)⟩
  have hHle : H ≤ Subgroup.closure A := by
    rw [← himg]
    exact Subgroup.closure_mono Set.subset_union_left
  refine eq_top_iff.2 fun g _ => ?_
  have hrep : (Quotient.out (QuotientGroup.mk g : G ⧸ H)) ∈ Subgroup.closure A :=
    Subgroup.subset_closure (Set.mem_union_right _ ⟨_, rfl⟩)
  have hmem : (Quotient.out (QuotientGroup.mk g : G ⧸ H))⁻¹ * g ∈ H := by
    rw [← QuotientGroup.eq]
    exact Quotient.out_eq' _
  have := Subgroup.mul_mem _ hrep (hHle hmem)
  simpa using this

/-- If `Q` is finitely generated and `f : A →* Q` is onto with kernel inside `N`, then finitely
many elements of `A` together with `N` generate `A`. -/
theorem exists_finset_sup_eq_top {A Q : Type*} [Group A] [Group Q] [Group.FG Q]
    (f : A →* Q) (hf : Function.Surjective f) (N : Subgroup A) (hN : f.ker ≤ N) :
    ∃ T : Finset A, Subgroup.closure (T : Set A) ⊔ N = ⊤ := by
  classical
  obtain ⟨S, hS, hSfin⟩ := (Group.fg_iff (G := Q)).1 inferInstance
  have hpre : ∀ q : Q, ∃ a : A, f a = q := hf
  choose g hg using hpre
  refine ⟨hSfin.toFinset.image g, ?_⟩
  set K : Subgroup A := Subgroup.closure ((hSfin.toFinset.image g : Finset A) : Set A) ⊔ N with hK
  have hSK : S ⊆ (K : Set A).image f := by
    intro q hq
    refine ⟨g q, ?_, hg q⟩
    refine le_sup_left (a := Subgroup.closure _) (b := N) ?_
    refine Subgroup.subset_closure ?_
    simp only [Finset.coe_image, Set.mem_image, Finset.mem_coe, Set.Finite.mem_toFinset]
    exact ⟨q, hq, rfl⟩
  refine eq_top_iff.2 fun a _ => ?_
  have hmap : Subgroup.map f K = ⊤ := by
    refine eq_top_iff.2 ?_
    rw [← hS, Subgroup.closure_le]
    intro q hq
    obtain ⟨x, hx, hxq⟩ := hSK hq
    exact ⟨x, hx, hxq⟩
  obtain ⟨k, hk, hkf⟩ : ∃ k ∈ K, f k = f a := by
    have : f a ∈ Subgroup.map f K := hmap ▸ Subgroup.mem_top _
    obtain ⟨k, hk, hkf⟩ := this
    exact ⟨k, hk, hkf⟩
  have : a * k⁻¹ ∈ f.ker := by simp [MonoidHom.mem_ker, hkf]
  have h1 : a * k⁻¹ ∈ K := le_sup_right (a := Subgroup.closure _) (b := N) (hN this)
  simpa using Subgroup.mul_mem _ h1 hk

end Lib
end Wolf

/-!
# A finitely generated nilpotent group is polycyclic

Wolf's Proposition 4.1 lists, among the conditions equivalent to polycyclicity of a solvable
group, the existence of a normal series with abelian, finitely generated factors, and the
finite generation of *every* subgroup.  For a finitely generated nilpotent group the lower
central series is such a series: its terms are normal in the whole group, `⁅Γ_k, Γ_k⁆ ≤ Γ_{k+1}`,
and each factor `Γ_k/Γ_{k+1}` is finitely generated by Theorem 3.2.  So a finitely generated
nilpotent group is Noetherian.
-/

namespace Wolf
namespace Lib

open Subgroup

variable {Γ : Type*} [Group Γ]

/-- `Γ_{k+1} ≤ Γ_k`. -/
theorem lcs_succ_le (k : ℕ) : MilnorWolf.lcs Γ (k + 1) ≤ MilnorWolf.lcs Γ k := by
  show ⁅MilnorWolf.lcs Γ k, (⊤ : Subgroup Γ)⁆ ≤ MilnorWolf.lcs Γ k
  exact Subgroup.commutator_le_left _ _

/-- The commutator subgroup of `Γ_k` lands inside `Γ_{k+1} = ⁅Γ_k, Γ⁆`. -/
theorem commutator_lcs_le (k : ℕ) :
    Subgroup.map (MilnorWolf.lcs Γ k).subtype (_root_.commutator ↥(MilnorWolf.lcs Γ k)) ≤
      MilnorWolf.lcs Γ (k + 1) := by
  have hmt : Subgroup.map (MilnorWolf.lcs Γ k).subtype ⊤ = MilnorWolf.lcs Γ k := by
    rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rw [_root_.commutator, Subgroup.map_commutator, hmt]
  show ⁅MilnorWolf.lcs Γ k, MilnorWolf.lcs Γ k⁆ ≤ ⁅MilnorWolf.lcs Γ k, (⊤ : Subgroup Γ)⁆
  exact Subgroup.commutator_mono le_rfl le_top

/-- The canonical surjection `Γ_k → Γ_k/Γ_{k+1}` of the definition bundle, which factors
through the abelianization of `Γ_k` because `⁅Γ_k, Γ_k⁆ ≤ Γ_{k+1}`. -/
noncomputable def toLcsFactor (k : ℕ) :
    ↥(MilnorWolf.lcs Γ k) →* MilnorWolf.lcsFactor Γ k :=
  (QuotientGroup.mk' _).comp Abelianization.of

theorem toLcsFactor_surjective (k : ℕ) : Function.Surjective (toLcsFactor (Γ := Γ) k) :=
  (QuotientGroup.mk'_surjective _).comp (fun x => Quot.inductionOn x fun y => ⟨y, rfl⟩)

theorem ker_toLcsFactor_le (k : ℕ) :
    (toLcsFactor (Γ := Γ) k).ker ≤
      (MilnorWolf.lcs Γ (k + 1)).subgroupOf (MilnorWolf.lcs Γ k) := by
  intro x hx
  rw [MonoidHom.mem_ker, toLcsFactor, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff] at hx
  obtain ⟨n, hn, hnx⟩ := hx
  have hcomm : n⁻¹ * x ∈ _root_.commutator ↥(MilnorWolf.lcs Γ k) := by
    rw [← Abelianization.ker_of, MonoidHom.mem_ker, map_mul, map_inv, hnx, inv_mul_cancel]
  have : ((n⁻¹ * x : ↥(MilnorWolf.lcs Γ k)) : Γ) ∈ MilnorWolf.lcs Γ (k + 1) :=
    commutator_lcs_le k ⟨n⁻¹ * x, hcomm, rfl⟩
  have hx' : x = n * (n⁻¹ * x) := by group
  rw [hx']
  exact Subgroup.mul_mem _ hn this

/-- If `Γ_k/Γ_{k+1}` is finitely generated then finitely many elements of `Γ_k`, together with
`Γ_{k+1}`, generate `Γ_k`. -/
theorem exists_finset_lcs_eq (k : ℕ) (h : Group.FG (MilnorWolf.lcsFactor Γ k)) :
    ∃ T : Finset Γ, MilnorWolf.lcs Γ k =
      Subgroup.closure (T : Set Γ) ⊔ MilnorWolf.lcs Γ (k + 1) := by
  classical
  obtain ⟨T, hT⟩ := exists_finset_sup_eq_top (toLcsFactor (Γ := Γ) k)
    (toLcsFactor_surjective k) _ (ker_toLcsFactor_le k)
  refine ⟨T.image (MilnorWolf.lcs Γ k).subtype, ?_⟩
  have := congrArg (Subgroup.map (MilnorWolf.lcs Γ k).subtype) hT
  rw [Subgroup.map_sup, MonoidHom.map_closure,
    Subgroup.map_subgroupOf_eq_of_le (lcs_succ_le k), ← MonoidHom.range_eq_map,
    Subgroup.range_subtype] at this
  rw [Finset.coe_image]
  exact this.symm

/-- The lower central series of a finitely generated nilpotent group witnesses condition (2) of
Wolf's Proposition 4.1: a normal series with each term normal in the ambient group, abelian
factors, and every factor finitely generated — the last by Theorem 3.2. -/
theorem lcs_series_of_isNilpotent (Δ : Type*) [Group Δ] [Group.FG Δ] [Group.IsNilpotent Δ] :
    ∃ (u : ℕ) (B : Fin (u + 1) → Subgroup Δ), B 0 = ⊤ ∧ B (Fin.last u) = ⊥ ∧
      ∀ i : Fin u, B i.succ ≤ B i.castSucc ∧
        (∀ g ∈ B i.castSucc, ∀ x ∈ B i.succ, g * x * g⁻¹ ∈ B i.succ) ∧
        ⁅B i.castSucc, B i.castSucc⁆ ≤ B i.succ ∧
        ∃ T : Finset Δ, B i.castSucc = Subgroup.closure (T : Set Δ) ⊔ B i.succ := by
  classical
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := Δ)).1 inferInstance
  have hfac : ∀ k : ℕ, Group.FG (MilnorWolf.lcsFactor Δ k) :=
    (_root_.Wolf.fg_lcsFactor_and_growth_bounds_of_isNilpotent S hS).1
  refine ⟨Group.nilpotencyClass Δ, fun i => MilnorWolf.lcs Δ (i : ℕ), by simp, ?_, ?_⟩
  · simp
  · intro i
    refine ⟨?_, ?_, ?_, ?_⟩
    · simpa using lcs_succ_le (Γ := Δ) (i : ℕ)
    · intro g _ x hx
      simp only [Fin.val_succ] at hx ⊢
      exact (inferInstance : (MilnorWolf.lcs Δ ((i : ℕ) + 1)).Normal).conj_mem x hx g
    · simp only [Fin.val_succ, Fin.val_castSucc]
      show ⁅MilnorWolf.lcs Δ (i : ℕ), MilnorWolf.lcs Δ (i : ℕ)⁆ ≤
        ⁅MilnorWolf.lcs Δ (i : ℕ), (⊤ : Subgroup Δ)⁆
      exact Subgroup.commutator_mono le_rfl le_top
    · simpa using exists_finset_lcs_eq (Γ := Δ) (i : ℕ) (hfac (i : ℕ))

/-- **A finitely generated nilpotent group is Noetherian**: every one of its subgroups is
finitely generated.  Proposition 4.1, (2) ⟹ (6). -/
theorem forall_fg_of_isNilpotent (Δ : Type*) [Group Δ] [Group.FG Δ] [Group.IsNilpotent Δ]
    (K : Subgroup Δ) : Group.FG K := by
  have h : _ ↔ (∀ H : Subgroup Δ, Group.FG H) :=
    (_root_.Wolf.isPolycyclic_tfae (Γ := Δ)).out 1 5
  exact h.1 (lcs_series_of_isNilpotent Δ) K

end Lib
end Wolf

/-!
# Wolf's Theorem 4.8, the Milnor–Wolf theorem

“Let `Γ` be a finitely generated solvable group.  If `Γ` has a nilpotent subgroup `Δ` of finite
index, then `Γ` is polycyclic and of polynomial growth of degree `≤ E₂(Δ)`.  If `Γ` does not have
a nilpotent subgroup of finite index, then `Γ` is of exponential growth.” (p. 438)

The first alternative is Proposition 4.1 for the polycyclicity — every subgroup of `Γ` meets `Δ`
in a subgroup of finite index, and `Δ` is Noetherian — and Theorem 3.2 followed by Theorem 3.11
for the growth bound.  The second is Theorem 4.3 when `Γ` is polycyclic and Milnor's Theorem when
it is not; Wolf says on p. 437 that this is exactly how Milnor extended the scope of 4.3.
-/

namespace Wolf
namespace Lib

open Subgroup

variable {Γ : Type*} [Group Γ]

/-- Every subgroup of a finitely generated group with a nilpotent subgroup `Δ` of finite index is
finitely generated: it meets `Δ` in a subgroup of finite index, finitely generated because a
finitely generated nilpotent group is Noetherian, and finite generation passes up across a
subgroup of finite index. -/
theorem fg_of_finiteIndex_isNilpotent [Group.FG Γ] (Δ : Subgroup Γ)
    (hnil : Group.IsNilpotent Δ) [Δ.FiniteIndex] (H : Subgroup Γ) : Group.FG H := by
  have : Group.FG Δ := inferInstance
  have h1 : Group.FG ↥(H.subgroupOf Δ) := forall_fg_of_isNilpotent (↥Δ) (H.subgroupOf Δ)
  have h2 : Group.FG ↥((H ⊓ Δ).subgroupOf Δ) := by
    rw [Subgroup.inf_subgroupOf_right]; exact h1
  have h3 : Group.FG ↥(H ⊓ Δ) := fg_of_mulEquiv (Subgroup.subgroupOfEquivOfLe inf_le_right)
  have h4 : Group.FG ↥((H ⊓ Δ).subgroupOf H) :=
    fg_of_mulEquiv (Subgroup.subgroupOfEquivOfLe (inf_le_left : H ⊓ Δ ≤ H)).symm
  have h5 : Group.FG ↥(Δ.subgroupOf H) := by
    rw [← Subgroup.inf_subgroupOf_left]; exact h4
  exact fg_of_fg_of_finiteIndex (G := ↥H) (Δ.subgroupOf H)

/-- A finitely generated solvable group with a nilpotent subgroup of finite index is polycyclic:
Proposition 4.1, (6) ⟹ (1). -/
theorem isPolycyclic_of_finiteIndex_isNilpotent [Group.FG Γ] [Group.IsSolvable Γ]
    (Δ : Subgroup Γ) (hnil : Group.IsNilpotent Δ) (hfi : Δ.FiniteIndex) :
    MilnorWolf.IsPolycyclic Γ := by
  have h : (∀ H : Subgroup Γ, Group.FG H) ↔ MilnorWolf.IsPolycyclic Γ :=
    (_root_.Wolf.isPolycyclic_tfae (Γ := Γ)).out 5 0
  exact h.1 (fun H => fg_of_finiteIndex_isNilpotent Δ hnil H)

/-- The ball of radius `0` is `{1}`. -/
theorem wordBall_zero (S : Set Γ) : Chou.wordBall S 0 = {1} := by
  ext g
  constructor
  · rintro ⟨l, hl, -, rfl⟩
    rw [Nat.le_zero, List.length_eq_zero_iff] at hl
    simp [hl]
  · rintro rfl
    exact ⟨[], by simp, by simp, by simp⟩

/-- A finitely generated nilpotent group has polynomial growth of degree `≤ E₂`: the upper bound
of Wolf's Theorem 3.2. -/
theorem hasPolynomialGrowth_of_isNilpotent (Δ : Type*) [Group Δ] [Group.FG Δ]
    [Group.IsNilpotent Δ] :
    MilnorWolf.HasPolynomialGrowthOfDegreeLE Δ (MilnorWolf.growthExponentTwo Δ) := by
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := Δ)).1 inferInstance
  obtain ⟨c₁, c₂, hc₁, hc₁₂, hbd⟩ :=
    (_root_.Wolf.fg_lcsFactor_and_growth_bounds_of_isNilpotent S hS).2
  exact ⟨S, hS, c₂, lt_of_lt_of_le hc₁ hc₁₂, fun m hm => (hbd m hm).2⟩

/-- The exponential alternative: a finitely generated solvable group with no nilpotent subgroup
of finite index has exponential growth — by Theorem 4.3 if it is polycyclic, and by Milnor's
Theorem if it is not. -/
theorem hasExponentialGrowth_of_not_exists [Group.FG Γ] [Group.IsSolvable Γ]
    (hno : ¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent Δ ∧ Δ.FiniteIndex) :
    Chou.HasExponentialGrowth Γ := by
  obtain ⟨_, S, _, hS⟩ := (Group.fg_iff' (G := Γ)).1 inferInstance
  by_cases hp : MilnorWolf.IsPolycyclic Γ
  · exact ((_root_.Wolf.growth_dichotomy_of_isPolycyclic hp S hS).2 hno).2
  · obtain ⟨c, hc, hbd⟩ :=
      Milnor.exists_le_growthFunction_of_isSolvable_of_not_isPolycyclic hp S hS
    refine ⟨S, hS, c, hc, fun n => ?_⟩
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · rw [pow_zero, wordBall_zero]
      simp
    · exact hbd n hn

/-- **Wolf's Theorem 4.8** (p. 438), the Milnor–Wolf theorem. -/
theorem growth_dichotomy_of_isSolvable_of_fg' [Group.FG Γ] [Group.IsSolvable Γ] :
    (∀ Δ : Subgroup Γ, Group.IsNilpotent Δ → Δ.FiniteIndex →
        MilnorWolf.IsPolycyclic Γ ∧
          MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo Δ)) ∧
      ((¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent Δ ∧ Δ.FiniteIndex) →
        Chou.HasExponentialGrowth Γ) := by
  refine ⟨fun Δ hnil hfi => ⟨?_, ?_⟩, hasExponentialGrowth_of_not_exists⟩
  · exact isPolycyclic_of_finiteIndex_isNilpotent Δ hnil hfi
  · have := hfi
    have := hnil
    have hΔ := hasPolynomialGrowth_of_isNilpotent (↥Δ)
    have := (_root_.Wolf.fg_and_polynomial_growth_of_finiteIndex Δ).2.2 hnil
      (MilnorWolf.growthExponentTwo (↥Δ)) hΔ
    simpa using this

end Lib
end Wolf

open Wolf

theorem solution {Γ : Type*} [Group Γ] [Group.FG Γ]
    [Group.IsSolvable Γ] :
    (∀ Δ : Subgroup Γ, Group.IsNilpotent Δ → Δ.FiniteIndex →
        MilnorWolf.IsPolycyclic Γ ∧
          MilnorWolf.HasPolynomialGrowthOfDegreeLE Γ (MilnorWolf.growthExponentTwo Δ)) ∧
      ((¬ ∃ Δ : Subgroup Γ, Group.IsNilpotent Δ ∧ Δ.FiniteIndex) →
        Chou.HasExponentialGrowth Γ) :=
  Wolf.Lib.growth_dichotomy_of_isSolvable_of_fg'
