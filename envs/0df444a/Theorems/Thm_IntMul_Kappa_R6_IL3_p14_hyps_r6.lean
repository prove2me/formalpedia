theorem IntMul.Kappa.R6.IL3.p14_hyps_r6 (P : Prm) (hP : P.Ok) (K₀ : ℕ) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n →
    Good P n ∧ 6 ≤ KP6 P n ∧
    (∀ N : ℕ, N < 2 ^ (6 * bP6 n) → zsz (N : ℤ) ≤ pP6 P n) ∧
    (pP6 P n + K₀) ^ 5 ≤ 2 ^ KP6 P n ∧
    ((K₀ * dP6 P n * (zsz (pP6 P n : ℤ) + 1) : ℕ) : ℝ) ≤
      (KP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp := by sorry
