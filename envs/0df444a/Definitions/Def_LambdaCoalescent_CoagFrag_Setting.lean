-- title:
--   §2, Def. 5, Def. 11, (15) and Appendix, pp. 1871–1899 — partitions of ℕ, coagulation, fragmentation, the (α, θ) EPF
-- statement:
--   This module fixes the objects of Pitman's *Coalescents with multiple collisions* that the coagulation–fragmentation duality (Theorem 12) is about.
--
--   1. **Partitions.** For $n\in\mathbb N$ let $\mathcal P_n$ be the set of partitions of $[n]=\{1,\dots,n\}$ and $\mathcal P_\infty$ the set of partitions of $\mathbb N=\{1,2,\dots\}$. The **restriction** $R_n\pi\in\mathcal P_n$ of $\pi\in\mathcal P_\infty$ is the partition of $[n]$ into the nonempty sets $A\cap[n]$, $A$ a block of $\pi$. $\mathcal P_\infty$ carries the $\sigma$-algebra generated by the maps $R_n$, which is the Borel $\sigma$-algebra of the product-of-discrete topology of §2.
--   2. **Block sizes.** For $\pi\in\mathcal P_n$ with blocks $A_1,\dots,A_K$, the multiset $\{|A_1|,\dots,|A_K|\}$. For a refinement $\pi^1=\{A_1,\dots,A_K\}$ of $\pi^2=\{B_1,\dots,B_k\}$: the counts $j_i=\#\{\ell: A_\ell\subseteq B_i\}$, and for each $i$ the multiset $\{a_{i,1},\dots,a_{i,j_i}\}$ of sizes of the blocks of $\pi^1$ inside $B_i$.
--   3. **Block order.** Writing $\pi=\{A_1,A_2,\dots\}$ lists the blocks of $\pi$ in increasing order of their least elements.
--   4. **Coagulation** (Definition 5). For $\pi=\{A_1,A_2,\dots\}$ and $\gamma=\{B_1,B_2,\dots\}$ in $\mathcal P_\infty$, the $\gamma$-coagulation of $\pi$ is the partition of $\mathbb N$ whose blocks are the nonempty sets
--   $$\bigcup_{j\in B_i}A_j,\qquad i=1,2,\dots$$
--   5. **Fragmentation** (Definition 11). For $\pi'=\{A_1,A_2,\dots\}\in\mathcal P_\infty$ and a sequence $(\Gamma^{(m)})_{m\ge1}$ in $\mathcal P_\infty$, the refinement of $\pi'$ whose restriction to the $m$-th block $A_m$ is the restriction of $\Gamma^{(m)}$ to $A_m$.
--   6. **The $(\alpha,\theta)$ EPF** (15). With $[x]_m=\prod_{i=1}^m(x+i-1)$,
--   $$p_{\alpha,\theta}(n_1,\dots,n_k)=\frac{[\theta/\alpha]_k}{[\theta]_n}\prod_{i=1}^{k}-[-\alpha]_{n_i},\qquad n=n_1+\dots+n_k,$$
--   evaluated after cancelling the factors of $\theta$ and $\alpha$, i.e. as
--   $$p_{\alpha,\theta}(n_1,\dots,n_k)=\frac{\prod_{i=1}^{k-1}(\theta+i\alpha)}{[\theta+1]_{n-1}}\prod_{i=1}^{k}[1-\alpha]_{n_i-1}.$$
--   7. **Exchangeable random partition with EPF $p$** (Appendix). A probability measure $\mu$ on $\mathcal P_\infty$ is the law of an exchangeable random partition with EPF $p$ if for every $n$ and every partition $\{B_1,\dots,B_k\}$ of $[n]$,
--   $$\mu\{\pi: R_n\pi=\{B_1,\dots,B_k\}\}=p(|B_1|,\dots,|B_k|).$$
--   An $(\alpha,\theta)$ **partition** is a random partition whose law has EPF $p_{\alpha,\theta}$.
--
--   These are the objects of Theorem 12 and of Lemmas 34 and 35: coagulation by an independent exchangeable partition and fragmentation by independent copies of one.
--
--   **Formalization Note** A partition of $\mathbb N$ is an equivalence relation on Lean's $\mathbb N=\{0,1,\dots\}$ (type `PInf := Setoid ℕ`), and a partition of $[n]$ an equivalence relation on `Fin n` $=\{0,\dots,n-1\}$; the paper's label $i$ is Lean's $i-1$, which preserves the order of least elements. The $\sigma$-algebra on `PInf` is the comap of the product $\sigma$-algebra on $(\mathbb N\times\mathbb N\to\mathrm{Prop})$ along $\pi\mapsto(i\sim_\pi j)_{i,j}$. Block indices are 0-based: `blockIndex π i` is the number of blocks of $\pi$ whose least element is smaller than that of the block of $i$, so $A_1$ has index $0$, and $\Gamma^{(m)}$ is Lean's `Γ (m-1)`. Coagulation is stated for $\gamma\in\mathcal P_\infty$ (Definition 5's case $n=\infty$; the paper uses $p$-COAG only with $p$ a law on $\mathcal P_\infty$); since $\gamma$-blocks containing only indices beyond $\#\pi$ give empty unions, nothing is lost. Block sizes, counts and nested sizes are multisets, since every EPF used is symmetric. **Cancelled EPF:** using $[\theta/\alpha]_k\,\alpha^k=\prod_{i=0}^{k-1}(\theta+i\alpha)$, $-[-\alpha]_m=\alpha[1-\alpha]_{m-1}$ and $[\theta]_n=\theta[\theta+1]_{n-1}$, the two displays agree whenever $\alpha\ne0$, $\theta\ne0$ and $k,n\ge1$; for $\alpha=0$ or $\theta=0$ the second is the page's "cancelled before evaluation" value. This is needed: Theorem 12 uses the parameter $-\alpha\beta$, which is $0$ when $\beta=0$. For $0\le\alpha<1$, $\theta>-\alpha$ the denominator is positive ($\theta+1>1-\alpha>0$). The empty multiset gets value $1$, the probability of the unique partition of $[0]$. Exchangeability is built into `IsEPFLaw`: the right-hand side depends only on the block sizes.
-- source:
--   Pitman, Coalescents with multiple collisions, Ann. Probab. 27 (1999), p. 1871, §2 (𝒫_n, 𝒫_∞); p. 1874, Definition 5; p. 1877, Lemma 9 (15) and the following paragraph; p. 1878, Definition 11; p. 1899, Appendix (EPF)

import Mathlib
import Definitions.Def_LambdaCoalescent_Rates_Setting

namespace LambdaCoalescent.CoagFrag

open MeasureTheory

/-- `R_n`: the restriction of a partition of `ℕ` to `[n]`, encoded as `Fin n = {0, …, n-1}`. -/
def restrict (n : ℕ) (π : Setoid ℕ) : Setoid (Fin n) := π.comap Fin.val

open Classical in
/-- The blocks of a partition `π` of `[n]`, as a finset of (nonempty) finsets. -/
noncomputable def blocks {n : ℕ} (π : Setoid (Fin n)) : Finset (Finset (Fin n)) :=
  Finset.univ.image (fun i => Finset.univ.filter (fun j => π i j))

/-- The multiset `{n₁, …, n_k}` of block sizes of a partition of `[n]`. -/
noncomputable def blockSizes {n : ℕ} (π : Setoid (Fin n)) : Multiset ℕ :=
  (blocks π).val.map Finset.card

open Classical in
/-- For `π₁ ≤ π₂` (π₁ refines π₂): the multiset `{j₁, …, j_k}` where `j_i = #{ℓ : A_ℓ ⊆ B_i}` is the
number of `π₁`-blocks inside the `i`-th block `B_i` of `π₂` (Lemma 34). -/
noncomputable def coagCounts {n : ℕ} (π₁ π₂ : Setoid (Fin n)) : Multiset ℕ :=
  (blocks π₂).val.map (fun B => ((blocks π₁).filter (fun A => A ⊆ B)).card)

open Classical in
/-- For `π₁ ≤ π₂`: for each block `B_i` of `π₂`, the multiset `{a_{i,1}, …, a_{i,j_i}}` of sizes of the
`π₁`-blocks inside `B_i` (Lemma 35). -/
noncomputable def fragSizes {n : ℕ} (π₁ π₂ : Setoid (Fin n)) : Multiset (Multiset ℕ) :=
  (blocks π₂).val.map (fun B => ((blocks π₁).filter (fun A => A ⊆ B)).val.map Finset.card)

open Classical in
/-- The least element of the block of `π` containing `i`. -/
noncomputable def leastElt (π : Setoid ℕ) (i : ℕ) : ℕ :=
  Nat.find (⟨i, π.refl i⟩ : ∃ m, π m i)

open Classical in
/-- The 0-based position of the block of `i` among the blocks of `π` listed in increasing order of
their least elements (the block `A₁` of Definition 5 has index `0`). -/
noncomputable def blockIndex (π : Setoid ℕ) (i : ℕ) : ℕ :=
  ((Finset.range (leastElt π i)).filter (fun m => leastElt π m = m)).card

/-- Definition 5 (with `n = ∞`): the `γ`-coagulation of `π`. If `π = {A₁, A₂, …}` and
`γ = {B₁, B₂, …}`, its blocks are the nonempty sets `⋃_{j ∈ B_i} A_j`: `i` and `j` are together iff the
indices of their `π`-blocks lie in the same block of `γ`. -/
noncomputable def coag (π γ : Setoid ℕ) : Setoid ℕ := γ.comap (blockIndex π)

/-- Definition 11: the refinement of `π'` whose restriction to the `m`-th block of `π'` (0-based, in
increasing order of least elements) is the restriction of `Γ m` to that block: `i ~ j` iff `i, j` are
in the same block of `π'`, with index `m`, and `Γ m` relates them. -/
noncomputable def frag (π' : Setoid ℕ) (Γ : ℕ → Setoid ℕ) : Setoid ℕ :=
  Setoid.ker (fun i => (blockIndex π' i, {x | Γ (blockIndex π' i) i x}))

/-- The EPF (15) of an `(α, θ)` partition, with the factors of `α` and `θ` cancelled:
`p_{α,θ}(n₁, …, n_k) = (∏_{i=1}^{k-1} (θ + iα)) / [θ+1]_{n-1} · ∏_{i=1}^{k} [1-α]_{n_i - 1}`,
where `k` is the number of blocks, `n = n₁ + ⋯ + n_k`, and `[x]_m = x (x+1) ⋯ (x+m-1)`. -/
noncomputable def pdEPF (α θ : ℝ) (s : Multiset ℕ) : ℝ :=
  (∏ i ∈ Finset.Ico 1 s.card, (θ + (i : ℝ) * α)) / (ascPochhammer ℝ (s.sum - 1)).eval (θ + 1) *
    (s.map (fun m => (ascPochhammer ℝ (m - 1)).eval (1 - α))).prod

/-- `μ` is the law of an exchangeable random partition of `ℕ` with EPF `p`: for every `n` and every
partition `s` of `[n]`, `μ {π : R_n π = s} = p(sizes of the blocks of s)`. -/
def IsEPFLaw (p : Multiset ℕ → ℝ) (μ : Measure LambdaCoalescent.Rates.PInf) : Prop :=
  ∀ (n : ℕ) (s : Setoid (Fin n)), μ.real {π : LambdaCoalescent.Rates.PInf | restrict n π = s} = p (blockSizes s)

end LambdaCoalescent.CoagFrag


