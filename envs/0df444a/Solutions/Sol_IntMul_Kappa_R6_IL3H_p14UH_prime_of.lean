namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

/-- `G + m ≤ N`. -/
theorem hGm (hc : CfgOK c) :
    (chV c (cWc c) P K D S r w).G + c.m ≤ P * 2 ^ (K * D) * S * r := by
  have hG := h.G_le_Z hc
  have hm : c.m ≤ Zc c := by unfold Zc; omega
  have hZ := h.Zc_lt_Z
  have hN := h.N_ge
  have hK : 2 ^ K ≤ 2 ^ (K * D) := Nat.pow_le_pow_right (by norm_num) h.K_le_KD
  have hKZ := h.KZ
  have : 4 * Z ≤ 80 * Z * (Z + 2) := by nlinarith
  rw [chV_G]
  omega

end Hyp14

