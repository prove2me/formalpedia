theorem hdisj_fibre
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (ι : ℍ[ℚ, a, b] →ₐ[ℚ] Matrix (Fin 2) (Fin 2) ℝ) (hι : Function.Injective ι) (hqq' : q' ≠ q)
    {N : ℕ} [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N)
    (hN : Squarefree N) (R : Submodule ℤ ℍ[ℚ, a, b]) (hR : IsEichlerOrder R N) (hRΛ : R ≤ Λ)
    (J' : Submodule ℤ ℍ[ℚ, a, b])
    (hJ' : Λ ≤ J' ∧ (∀ x ∈ Λ, ∀ y ∈ J', x * y ∈ J') ∧ (∀ y ∈ J', ((N : ℤ) • y) ∈ Λ) ∧
      Λ.toAddSubgroup.relIndex J'.toAddSubgroup = N ^ 2 ∧ (∀ x ∈ Λ, x ∈ R ↔ ∀ y ∈ J', y * x ∈ J'))
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓq : ℓ ≠ q) (hℓq' : ℓ ≠ q') (t : ℍ[ℚ, a, b]) (ht : t ∈ R) (hnrd : nrd t = (ℓ : ℚ))
    (hlev : ∀ x : ℍ[ℚ, a, b], (∃ j ∈ J', ∃ m ∈ Λ, (ℓ : ℤ) • j + m * t = x) ↔ ∃ j ∈ J', j * t = x)
    (latt : FakeEllipticCurve Λ N ℂ → Submodule ℤ (Fin 2 → ℂ))
    (e : ∀ E : FakeEllipticCurve Λ N ℂ,
      SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f ≃ ((Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup))
    (hL1 : ∀ E : FakeEllipticCurve Λ N ℂ,
        (∃ b₀ : Module.Basis (Fin 4) ℝ (Fin 2 → ℂ), latt E = Submodule.span ℤ (Set.range b₀)) ∧
        (∀ x ∈ Λ, ∀ v ∈ latt E, ((ι x).map (algebraMap ℝ ℂ)).mulVec v ∈ latt E))
    (hE1 : ∀ (E : FakeEllipticCurve Λ N ℂ) (P Q : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f),
        e E (E.L.mul (𝟙 (Spec (CommRingCat.of ℂ))) P Q) = e E P + e E Q)
    (hE2 : ∀ (E : FakeEllipticCurve Λ N ℂ) (x : ↥Λ) (P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f) (v : Fin 2 → ℂ),
        e E P = (v : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup) →
        e E (pushPt (E.act x) (E.act_over x) P) =
          ((((ι (x : ℍ[ℚ, a, b])).map (algebraMap ℝ ℂ)).mulVec v : Fin 2 → ℂ) : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup))
    (lattLev : FakeEllipticCurve Λ N ℂ → Submodule ℤ (Fin 2 → ℂ))
    (hLev : ∀ E : FakeEllipticCurve Λ N ℂ,
      (∀ v : Fin 2 → ℂ, v ∈ lattLev E ↔
        ∃ P : SchemeHomOver (𝟙 (Spec (CommRingCat.of ℂ))) E.f,
          FactorsThrough E.lev P ∧ e E P = (v : (Fin 2 → ℂ) ⧸ (latt E).toAddSubgroup)) ∧
      latt E ≤ lattLev E ∧
      (∀ x ∈ Λ, ∀ v ∈ lattLev E, ((ι x).map (algebraMap ℝ ℂ)).mulVec v ∈ lattLev E) ∧
      (∀ v ∈ lattLev E, (N : ℤ) • v ∈ latt E) ∧
      (latt E).toAddSubgroup.relIndex (lattLev E).toAddSubgroup = N ^ 2)
    (m : ℕ) (hm0 : m ≠ 0) (hℓm : ℓ ∣ m) (u₀'' : FakeEllipticCurve.WithFullLevel Λ N m ℂ)
    (τ₁ : UpperHalfPlane) (c₁' : ℂ) (hc₁' : c₁' ≠ 0) (hL₁' : c₁' • latt u₀''.1 = qmPeriodLattice ι Λ τ₁)
    (hlattLev : c₁' • lattLev u₀''.1 = qmPeriodLattice ι J' τ₁)
    (ξ₀ : ℍ[ℚ, a, b]) (vb : Fin 2 → ℂ) (hvb : e u₀''.1 u₀''.2.P = (vb : (Fin 2 → ℂ) ⧸ (latt u₀''.1).toAddSubgroup))
    (hvb' : c₁' • vb = ((m : ℂ)⁻¹) • qmPeriodMap ι τ₁ ξ₀)
    (γ : GL (Fin 2) ℝ) (hγ : γ ∈ fuchsianGroup R ι) (uγ wγ : ℍ[ℚ, a, b]) (huγR : uγ ∈ R) (hwγR : wγ ∈ R)
    (huwγ : uγ * wγ = 1) (hwuγ : wγ * uγ = 1)
    (hγu : (((γ⁻¹ : GL (Fin 2) ℝ)) : Matrix (Fin 2) (Fin 2) ℝ) = ι uγ)
    (J : Submodule ℤ ℍ[ℚ, a, b]) (hJmem : ∀ x : ℍ[ℚ, a, b], x ∈ J ↔ ∃ y ∈ Λ, y * t = x)
    (L₀ : Submodule ℤ ℍ[ℚ, a, b]) (hL₀Λ : L₀ ≤ Λ)
    (hL₀tr : ∀ x : ℍ[ℚ, a, b], x ∈ J ↔
      ∃ z ∈ L₀, ∃ y : ↥Λ, x = z * (ξ₀ * wγ) + (ℓ : ℚ) • (y : ℍ[ℚ, a, b])) :
    ∀ (k : Type) [Field k] [IsAlgClosed k] (sk : ℂ →+* k) (x : ↥Λ), (x : ℍ[ℚ, a, b]) ∈ L₀ →
      FactorsThrough u₀''.1.lev
        (pushPt (u₀''.1.act x) (u₀''.1.act_over x)
          (nsmulPt u₀''.1.L (geomPoint k sk) (m / ℓ) (FakeEllipticCurve.sectionAt u₀''.2.P k sk))) →
      pushPt (u₀''.1.act x) (u₀''.1.act_over x)
          (nsmulPt u₀''.1.L (geomPoint k sk) (m / ℓ) (FakeEllipticCurve.sectionAt u₀''.2.P k sk)) =
        u₀''.1.L.one (geomPoint k sk) := by
  have hΛo : IsOrder Λ := hΛ.isOrder
  have hRo : IsOrder R := hR.isOrder
  obtain ⟨ha, hb⟩ := QuaternionAlgebra.IsMaximalOrder.ne_zero_and_ne_zero hΛ

  have hnrdu : nrd uγ = 1 := by
    obtain ⟨u', -, hu'1, hu'eq⟩ :=
      CerednikDrinfeld.exists_isUnitOf_nrd_eq_one_of_mem_fuchsianGroup ha hb R hRo ι hι γ⁻¹ (inv_mem hγ)
    have : u' = uγ := hι (hu'eq.symm.trans hγu)
    rw [← this]; exact hu'1

  obtain ⟨ht', hnrd', hlev'⟩ :=
    QuaternionAlgebra.IsOrder.forall_exists_smul_add_mul_iff_mul_of_isUnitOf_right (N := N) Λ R J' hRo hRΛ hJ' ℓ t uγ
      ht huγR ⟨wγ, hwγR, huwγ, hwuγ⟩ hlev
  have hnrd'' : nrd (t * uγ) = (ℓ : ℚ) := by rw [hnrd', hnrd, hnrdu, mul_one]

  have huγΛ : uγ ∈ Λ := hRΛ huγR
  have hwγΛ : wγ ∈ Λ := hRΛ hwγR
  have hLT' : ∀ y : ℍ[ℚ, a, b], (∃ z ∈ Λ, z * (t * uγ) = y) ↔
      ∃ z ∈ Λ, ∃ x ∈ Λ, x ∈ L₀ ∧ (ℓ : ℚ) • z + x * ξ₀ = y := by
    intro y
    constructor
    · rintro ⟨z, hz, rfl⟩
      have hJ : z * t ∈ J := (hJmem _).mpr ⟨z, hz, rfl⟩
      obtain ⟨z₀, hz₀, y₁, hy₁⟩ := (hL₀tr _).mp hJ
      refine ⟨(y₁ : ℍ[ℚ, a, b]) * uγ, hΛo.mul_mem y₁.2 huγΛ, z₀, hL₀Λ hz₀, hz₀, ?_⟩
      calc (ℓ : ℚ) • ((y₁ : ℍ[ℚ, a, b]) * uγ) + z₀ * ξ₀
          = (z₀ * (ξ₀ * wγ) + (ℓ : ℚ) • (y₁ : ℍ[ℚ, a, b])) * uγ := by
            rw [add_mul, smul_mul_assoc, add_comm, mul_assoc, mul_assoc, hwuγ, mul_one]
        _ = z * t * uγ := by rw [← hy₁]
        _ = z * (t * uγ) := mul_assoc _ _ _
    · rintro ⟨z, hz, x, hx, hxL, rfl⟩
      have hJ : ((ℓ : ℚ) • z + x * ξ₀) * wγ ∈ J := by
        refine (hL₀tr _).mpr ⟨x, hxL, ⟨z * wγ, hΛo.mul_mem hz hwγΛ⟩, ?_⟩
        show ((ℓ : ℚ) • z + x * ξ₀) * wγ = x * (ξ₀ * wγ) + (ℓ : ℚ) • (z * wγ)
        rw [add_mul, smul_mul_assoc, mul_assoc, add_comm]
      obtain ⟨y₂, hy₂, hy₂eq⟩ := (hJmem _).mp hJ
      refine ⟨y₂, hy₂, ?_⟩
      calc y₂ * (t * uγ) = (y₂ * t) * uγ := (mul_assoc _ _ _).symm
        _ = ((ℓ : ℚ) • z + x * ξ₀) * wγ * uγ := by rw [hy₂eq]
        _ = (ℓ : ℚ) • z + x * ξ₀ := by rw [mul_assoc, hwuγ, mul_one]
  exact CerednikDrinfeld.QM.FakeEllipticCurve.FullLevel.forall_factorsThrough_lev_imp_eq_one_of_smul_eq_qmPeriodMap_of_nrd_eq
    hB Λ hΛ ι hι hqq' hqN hq'N hN R hR hRΛ J' hJ' ℓ hℓ hℓq hℓq' (t * uγ) ht' hnrd'' hlev' latt e hL1 hE1 hE2
    lattLev hLev m hm0 hℓm u₀''.1 u₀''.2 τ₁ c₁' hc₁' hL₁' hlattLev ξ₀ vb hvb hvb' L₀ hLT'

end LocalH0

