theorem gIn_ne_q : ∀ r ∈ NLogN.KFV.gIn, r ≠ qX ∧ r ≠ NLogN.KFV.qB ∧ r ≠ qZ := by decide

theorem loop_hQc {G : Fin HS → List ℤ} {h0 p W Z : ℕ} (S : IState HS) (LA LC LD : List Item)
    (hQ : GRegs S G (pLP D ℓ K long) h0 ∧ XR (encK S G) p W Z) :
    GRegs (cf3 S qX NLogN.KFV.qB qZ LA LC LD) G (pLP D ℓ K long) h0 ∧
      XR (encK (cf3 S qX NLogN.KFV.qB qZ LA LC LD) G) p W Z :=
  ⟨hQ.1.baseEq fun r hr => encK_cf3_G _ _ (gIn_ne_q r hr).1 (gIn_ne_q r hr).2.1
      (gIn_ne_q r hr).2.2 LA LC LD,
    hQ.2.congr fun j hj => by
      rcases hj with rfl | rfl | rfl <;> exact encK_cf3_G _ _ (by decide) (by decide) (by decide) _ _ _⟩

theorem loop_hB (G : Fin HS → List ℤ) (hF : ∀ j ∈ twFree, G j = []) (x : List ℤ) (S : IState HS)
    {j : Fin HS} (hj : j ∈ twFree) (hjH : j ≠ gH) :
    (encK S (Function.update G gH x)).G j = S.G j := by
  rw [encK_G, Function.update_of_ne hjH, hF j hj]; simp [ints]

theorem hu (G : Fin HS → List ℤ) (hF : ∀ j ∈ twFree, G j = []) {x : List ℤ} (j : Fin HS)
    (hj : j ∈ twFree ∧ j ≠ gH) : Function.update G gH x j = [] := by
  rw [Function.update_of_ne hj.2]; exact hF j hj.1

theorem popEq (S : IState HS) {G : Fin HS → List ℤ} (hG0 : G 0 = []) (v x : List ℤ) :
    encK S (Function.update (Function.update (Function.update G 0 v) gH x) gH (G gH)) =
      encK (encK S G) (o0 v) := by
  rw [Function.update_idem, encK_o0, hG0, List.append_nil]
  congr 1
  rw [show G gH = Function.update G 0 v gH from (Function.update_of_ne (by decide) _ _).symm,
    Function.update_eq_self]

set_option maxHeartbeats 1000000 in
/-- **Lemma 16 forward, uniform**: `fwdC e14` computes `procQc` of the paper's layout. -/
theorem fwdC_ok (hK : 0 < K) (hℓ : 1 ≤ ℓ) {e14 : Fin Pp} {p W Z B cCh U : ℕ}
    (HC : ChunkU D ℓ K long I iprog e14 hK hℓ p W Z cCh) (hW : p + 1 ≤ W)
    (hB : bL D ℓ K long ≤ B) (hU : TwB D ℓ K long U) (hlB : ℓ + 1 ≤ B) :
    LayerU (r := 2 ^ ℓ) I iprog (PCtx (pLP D ℓ K long) (flOf D long) p W Z) (fwdC e14)
      (procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long))
        (paperSel D ℓ K long hK hℓ) ℓ)
      (2 ^ NLogN.KFV.nB D ℓ K long) p W (NLogN.KFV.cFwd D ℓ K long W B cCh U) := by
  intro s ⟨s1, fG, rG, h0, hs, HG, hGl, hF, hX⟩ zs l xs hx hl hb hd
  subst hs
  have hG0 : fG 0 = [] := hF 0 (by decide)
  obtain ⟨L1, e1⟩ := HG.l
  have e1' : (encK s1 fG).G gLl = .int (ℓ : ℤ) :: L1 := e1
  -- push `ℓ` on `gH`
  have EL : EV (encK s1 (Function.update fG 0 (gflat zs ++ l))) B (.reg gLl) (ℓ : ℤ) :=
    (EV.reg e1' (zsz_nat_le (by omega))).encK fun r hr => by
      simp only [Ex.regs, List.mem_singleton] at hr; subst hr
      exact (Function.update_of_ne (by decide) _ _).symm
  have SP := Sp.pushQ (s := s1) (f := Function.update fG 0 (gflat zs ++ l)) (i := gH) (by decide)
    (clean_gIn (RG.reg (by decide))) EL.1 EL.2.2
  rw [EL.2.1, Function.update_of_ne (by decide : gH ≠ 0), ← encK_o0_upd s1 hG0 (j := gH) (by decide)] at SP
  have R1 := FSp.irun (I := I) (iprog := iprog) (by simp [fok]) (FSp.of_norep (by simp [norep]) SP)
  -- the loop
  obtain ⟨zs', a1, a2, a3, a4, R2⟩ := rptX_layers (I := I) (iprog := iprog) (X := gLl) (A := qX)
    (C := NLogN.KFV.qB) (D := qZ) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (fwdBody D ℓ K long hK hℓ HC hW hB hU hlB hGl hF (fG gH) h0)
    (fun S LA LC LD hQ => loop_hQc D ℓ K long S LA LC LD hQ)
    (fun k S LA LC LD => (encK_cf3 S _ (hu fG hF qX ⟨by decide, by decide⟩)
      (hu fG hF NLogN.KFV.qB ⟨by decide, by decide⟩) (hu fG hF qZ ⟨by decide, by decide⟩) LA LC LD).symm)
    (fun k S => loop_hB fG hF _ S (j := qX) (by decide) (by decide))
    (fun k S => loop_hB fG hF _ S (j := NLogN.KFV.qB) (by decide) (by decide))
    (fun k S => loop_hB fG hF _ S (j := qZ) (by decide) (by decide))
    s1 ⟨HG, hX⟩ zs l xs hx hl hb hd (LX := L1) (by decide)
    (by show (encK s1 _).G gLl = _; rw [encK_G, Function.update_of_ne (by decide), ← encK_G]; exact e1')
  simp only [Nat.sub_zero, Nat.sub_self, Nat.cast_zero] at R2
  -- pop `gH`
  have SQ := Sp.pop (s := s1) (f := Function.update (Function.update fG 0 (gflat zs' ++ l)) gH
    ((0 : ℤ) :: fG gH)) (i := gH) (a := 0) (l := fG gH) (B := B) (by decide)
    (Function.update_self _ _ _) (zsz_abs (by omega) (by omega) (by omega))
  rw [popEq s1 hG0, ← encK_o0_upd s1 hG0 (j := gH) (by decide)] at SQ
  have R3 := FSp.irun (I := I) (iprog := iprog) (by simp [fok]) (FSp.of_norep (by simp [norep]) SQ)
  have eT : procQc p (paperLayout D ℓ K long hK hℓ) ℓ (partAxes (al D ℓ long))
      (paperSel D ℓ K long hK hℓ) ℓ xs = NLogN.KFV.iterL (fun k => compRc p (paperSel D ℓ K long hK hℓ (ℓ - 1 - k))
        (roundEx (paperLayout D ℓ K long hK hℓ) ℓ (ℓ - 1 - k) (partAxes (al D ℓ long) (ℓ - 1 - k))))
        ℓ xs := runDown_eq_iterL _ ℓ xs
  rw [eT, show encK (encK s1 fG) (o0 (gflat zs ++ l)) = encK s1 (Function.update fG 0 (gflat zs ++ l))
    by rw [encK_o0, hG0, List.append_nil]]
  refine ⟨zs', a1, a2, a3, a4, (R1.seq (R2.seq R3)).mono' rfl ?_⟩
  unfold NLogN.KFV.cFwd; omega

end Paper

