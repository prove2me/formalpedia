  suffices H : ∀ (ls : List Line) (p : ℤ × ℤ), NLogN.KFL.VP (2 ^ (f * K)) p →
      ls.foldr (fun l p => pline K ρ f x (negL l) p) (ls.foldl (fun p l => pline K ρ f x l p) p) = p from
