attribute [local instance] Classical.propDecidable Classical.decEq

variable {d : ℕ} [NeZero d]

/-- Section 2, PDF pp.9--10, (2.20)--(2.23): maximal cyclic twirling is
complete dephasing in a common orthonormal eigenbasis. The generator spectrum
has an unrestricted common phase, not necessarily d-th roots of unity. -/
theorem cyclicDephasing (z : WeylLabel d)
    (hcard : (AddSubgroup.zmultiples z : Set (WeylLabel d)).ncard = d) :
    ∃ B : Matrix.unitaryGroup (ZMod d) ℂ, ∃ c0 : ℂ, ‖c0‖ = 1 ∧
      (∀ j : ZMod d,
        act (W z) (act (B : Op (ZMod d)) (ket j)) =
          (c0 * cyclicPhase d j) • act (B : Op (ZMod d)) (ket j)) ∧
      (∀ g ∈ AddSubgroup.zmultiples z, ∀ j : ZMod d,
        ∃ c : ℂ, act (W g) (act (B : Op (ZMod d)) (ket j)) = c • act (B : Op (ZMod d)) (ket j)) ∧
      (∀ X, subgroupTwirl (AddSubgroup.zmultiples z) X =
        ∑ j : ZMod d, pureDensity (act (B : Op (ZMod d)) (ket j)) * X *
          pureDensity (act (B : Op (ZMod d)) (ket j))) ∧
      (∀ X, subgroupTwirl (AddSubgroup.zmultiples z) X =
        (B : Op (ZMod d)) * dephasing ((B : Op (ZMod d))ᴴ * X * (B : Op (ZMod d))) * (B : Op (ZMod d))ᴴ) := by sorry

end QAlgorithms.Papers.Independent.Bridge50.P05

