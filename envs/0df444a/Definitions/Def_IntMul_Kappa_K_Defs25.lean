  g₂ := NLogN.KFM.gI E₂ _ E₁ (by omega)
  g₃ := NLogN.KFM.gI E₃ _ (E₁ + E₂) (by omega)
  eF := eF
  eI := eI
  eA := eA
  eB := eB
  eC := eC
