        (∃ b : ↥(chartAlgFin A (↥K) j), b ∈ y ∧ ∀ hb : ((b : ↥(chartAlgFin A (↥K) j)) : ↥K) ∈ O, (⟨((b : ↥(chartAlgFin A (↥K) j)) : ↥K), hb⟩ : ↥O) ∉ 𝔮I) ∧
        (∃ (f : ↥K) (hf : f ∈ O), ¬ IsUnit (⟨f, hf⟩ : ↥O) ∧ (⟨f, hf⟩ : ↥O) ∉ 𝔮E) ∧
        (∃ (f : ↥K) (hf : f ∈ O), ¬ IsUnit (⟨f, hf⟩ : ↥O) ∧ (⟨f, hf⟩ : ↥O) ∉ 𝔮I) ∧
        (∀ 𝔮 : Ideal ↥O, 𝔮.IsPrime → (∀ h : algebraMap A ↥K ϖ ∈ O, (⟨algebraMap A ↥K ϖ, h⟩ : ↥O) ∈ 𝔮) →
          𝔮 ≠ 𝔮E → 𝔮 ≠ 𝔮I → ∀ x : ↥O, ¬ IsUnit x → x ∈ 𝔮) := by sorry
