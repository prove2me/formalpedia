set_option backward.isDefEq.respectTransparency false

namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

attribute [local instance 2000] localizedTermAddCommGroup localizedTermModule

noncomputable local instance (priority := 3000) nativeChainTermAddCommMonoid
    (K : Complex V) (T : Finset V) (a : V → ℤ) (p : ℕ) :
    AddCommMonoid (LocalizedCechTerm k K T a p) :=
  (localizedTermAddCommGroup k K T a p).toAddCommMonoid

/-- Name the existing actual homogeneous terms uniformly, retaining all data. -/
noncomputable def cechNativeTermFamily (K : Complex V) (T : Finset V) (p : ℕ) :
    (V → ℤ) → ModuleCat.{u} k :=
  fun a => ModuleCat.of k (LocalizedCechTerm k K T a p)

/-- The original product of localized rings with its native field scalars. -/
noncomputable def cechNativeAmbientFieldTerm (K : Complex V) (T : Finset V) (p : ℕ) :
    ModuleCat.{u} k :=
  ModuleCat.of k (FullCechTerm k K T p)

noncomputable def cechNativeTermSumEquiv (K : Complex V) (T : Finset V) (p : ℕ) :
    DirectSum (V → ℤ) (fun a => cechNativeTermFamily k K T p a) ≃ₗ[k]
      cechNativeAmbientFieldTerm k K T p :=
  cechTermSumEquiv k K T p

theorem cechNativeTermSumEquiv_lof (K : Complex V) (T : Finset V) (p : ℕ)
    (a : V → ℤ) (y : cechNativeTermFamily k K T p a) :
    cechNativeTermSumEquiv k K T p
        (DirectSum.lof k (V → ℤ) (fun a => cechNativeTermFamily k K T p a) a y) =
      fun F => (y F).1 :=
  cechTermSumEquiv_lof k K T p a y

end LPCA


