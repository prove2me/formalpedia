lemma QFS.cube_subset_of_mem_shift_shrink_scaled {S : Set (EuclideanSpace ℝ (Fin d))} {h : ℝ}
    {x y : EuclideanSpace ℝ (Fin d)}
    (hy : y ∈ shift (shrink S (h * Real.sqrt d)) x) :
