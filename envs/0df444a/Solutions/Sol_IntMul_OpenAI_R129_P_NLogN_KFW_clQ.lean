theorem lowPartQ (jW jL : Fin Pp) (rowC : IStmt HS Pp) (hW : tbl jW = lowC jW jL)
    (hL : tbl jL = levC jL rowC) {K S r H P D ρ k q0 Bp Z Zr Mb Bz : ℕ} {Kc : ℝ}
    (LV : ∀ j, LvQ Isym tbl jL rowC K r Z Zr H j (cbW Kc K j))
    (pre : LowPre K S r H P D ρ k q0 Bp Z Zr Mb Bz) (hP : 1 ≤ P) (hr : 1 ≤ r)
    {σ : Fin HS → Option ℤ} (hC : CoreR σ K S r H P D ρ k q0 Bp) :
    SImplQ Isym tbl (fun s => Agree σ s) 0 H r (fun x : Fin D => KFH.stT K D S ρ x)
      (P * 2 ^ (K * D) * S) (tensF fun x : Fin D => if q0 ≤ x.val then Cm else 1)
