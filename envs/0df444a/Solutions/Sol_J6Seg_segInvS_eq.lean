-- Source module: Solutions.J6SegSparse
/-!
# Segmented inverse (S2): the sparse algorithm

`segInvS P lam T B U` is `segInv` with the capacitance solved by `geSolveS` on the pattern
`bandS (λ + w) (s - λ - w)`: a band of half-width `λ + w` (blocks of length `≤ λ`, coupling width
`w`) plus the border of positions `≥ s - λ - w` (the cyclic wrap). Per row of the capacitance
at most `2(λ+w)+1` band entries plus the border are touched.

* `capI_band`: the capacitance vanishes off the pattern;
* `segInvS_eq`: under the hypotheses of `segInv_err`, `segInvS = segInv`;
* `segInvFullS_err`: the fully instantiated sparse algorithm satisfies the bound of
  `segInvFull_err`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section sp
variable {P s t α lam : ℕ} {B : Blocks} {T : Tables}

lemma Jlist_pairwise (B : Blocks) : (Jlist B).Pairwise (· < ·) :=
  (List.pairwise_lt_range).filter _

/-- The capacitance vanishes off the band-plus-border pattern. -/
theorem capI_band (hB : BlocksOK s t B) (hs : 0 < s) (hlam : ∀ i < s, B.len i ≤ lam)
    {a b : ℕ} (ha : a < s) (hnb : ¬ bandS (lam + B.w) (B.s - lam - B.w) a b) :
    capI P T B a b = 0 := by
  have hbs := hB.hs
  have hw := hB.hw
  obtain ⟨c1, c2, c3⟩ := hB.cover a ha
  have hla := hlam a ha
  unfold bandS at hnb
  rw [hbs] at hnb
  unfold capI
  have hab : a ≠ b := by intro h; subst h; exact hnb (Or.inl ⟨by omega, by omega⟩)
  rw [if_neg hab, zero_add]
  refine sum_eq_zero fun i hi => sum_eq_zero fun h hh => ?_
  rw [mem_Ico] at hi
  obtain ⟨hw1, hw2, _, _⟩ := mem_Hset hh
  rw [if_neg]
  intro hcol
  unfold col at hcol
  rw [hbs] at hcol
  have hcase := emod_cases hs (a := (i : ℤ) + h) (by omega) (by omega)
  have hjv : (((((i : ℤ) + h) % s).toNat : ℕ) : ℤ) = ((i : ℤ) + h) % s :=
    Int.toNat_of_nonneg (Int.emod_nonneg _ (by exact_mod_cast hs.ne'))
  rw [hcol] at hjv
  omega

/-- **The sparse algorithm equals the dense one** under the hypotheses of `segInv_err`. -/
theorem segInvS_eq_sol_aux {E Dm Bu : ℝ} (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hx : 3 ≤ xθ s t α)
    (hB : BlocksOK s t B) (hlam : ∀ i < s, B.len i ≤ lam)
    (hT : TabOK P s t α B T E Dm) (hE : 0 ≤ E) (hBu : 0 ≤ Bu)
    (hP : 1000 * segG B lam E Dm Bu ≤ 2 ^ P) (U : ℕ → ℤ) :
    ∀ i, segInvS P lam T B U i = segInv P T B U i := by
  have hS := two_pow_pos' P
  have hDm1 : 1 ≤ Dm := Dm_one hB hs hst hT hs
  have hlam0 : (0 : ℝ) ≤ lam := Nat.cast_nonneg _
  have hw0 : (0 : ℝ) ≤ B.w := Nat.cast_nonneg _
  have hJ0 : (0 : ℝ) ≤ (Jlist B).length := Nat.cast_nonneg _
  set K := ((lam : ℝ) + 1) * E + 1 with hK
  have hK1 : 1 ≤ K := by have := mul_nonneg hlam0 hE; nlinarith
  set Q := (((Jlist B).length : ℝ) + 1) ^ 2 with hQ
  have hQ1 : 1 ≤ Q := one_le_pow₀ (by linarith)
  have hGdef : segG B lam E Dm Bu = (Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1)) * Q := by
    simp only [segG, hK, hQ]
  have hA1 : 1 ≤ Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1) := by
    have a1 : (1 : ℝ) ≤ Bu + 1 := by linarith
    have a2 : (1 : ℝ) ≤ (lam : ℝ) + 1 := by linarith
    have a3 : (1 : ℝ) ≤ 2 * (B.w : ℝ) + 1 := by linarith
    exact one_le_mul' (one_le_mul' (one_le_mul' (one_le_mul' hDm1 hK1) a1) a2) a3
  -- `(|J|+1)² / 2^P ≤ 1/8`
  have hQP : Q / 2 ^ P ≤ 1 / 8 := by
    rw [div_le_iff₀ hS]
    have : Q ≤ segG B lam E Dm Bu := by rw [hGdef]; exact le_mul_of_one_le_left (by linarith) hA1
    linarith
  -- `λ(2w+1)δ ≤ 0.1`
  have hδ : (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P) ≤ 1 / 10 := by
    rw [← hK, mul_div_assoc', div_le_iff₀ hS]
    have h1 : (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * K) ≤ 15 * segG B lam E Dm Bu := by
      rw [hGdef]
      have hb : (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * K) ≤
          15 * (Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1)) := by
        have e : 15 * (Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1)) =
            ((lam : ℝ) + 1) * (2 * B.w + 1) * (15 * Dm * K) * (Bu + 1) := by ring
        rw [e]
        have h0 : 0 ≤ (2 * (B.w : ℝ) + 1) * (15 * Dm * K) := by positivity
        have h2 : (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * K) ≤
            ((lam : ℝ) + 1) * (2 * B.w + 1) * (15 * Dm * K) := by nlinarith
        exact h2.trans (le_mul_of_one_le_right (by positivity) (by linarith))
      have := le_mul_of_one_le_right (by positivity :
        (0 : ℝ) ≤ 15 * (Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1))) hQ1
      nlinarith
    linarith
  have hJs := hB.hs
  intro i
  simp only [segInvS, segInv]
  have hge : ∀ k, geSolveS P (bandS (lam + B.w) (B.s - lam - B.w)) (Jlist B) (capI P T B)
      (applyMinv P T B U) k = geSolve P (Jlist B) (capI P T B) (applyMinv P T B U) k := by
    refine geSolveS_eq P _ (Jlist B) (capI P T B) (applyMinv P T B U)
      (1 / 7 + (lam : ℝ) * (2 * B.w + 1) * (15 * Dm * (((lam : ℝ) + 1) * E + 1) / 2 ^ P))
      (Jlist_nodup B) (by positivity) ?_ ?_ ?_ (bandS_patOK _ _ _ (Jlist_pairwise B))
    · have : ((Jlist B).length : ℝ) ^ 2 / 2 ^ P ≤ Q / 2 ^ P :=
        div_le_div_of_nonneg_right (by rw [hQ]; nlinarith) hS.le
      linarith
    · intro a ha
      exact cap_row hB hs hst hα hx hT hE hlam (by
        have : K ≤ segG B lam E Dm Bu := by
          rw [hGdef]
          have h1 : K ≤ Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1) := by
            have e : Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1) =
                K * (Dm * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1)) := by ring
            rw [e]; refine le_mul_of_one_le_right (by linarith) ?_
            have a1 : (1 : ℝ) ≤ Bu + 1 := by linarith
            have a2 : (1 : ℝ) ≤ (lam : ℝ) + 1 := by linarith
            have a3 : (1 : ℝ) ≤ 2 * (B.w : ℝ) + 1 := by linarith
            exact one_le_mul' (one_le_mul' (one_le_mul' hDm1 a1) a2) a3
          have := le_mul_of_one_le_right (by linarith : (0 : ℝ) ≤
            Dm * K * (Bu + 1) * ((lam : ℝ) + 1) * (2 * B.w + 1)) hQ1
          linarith
        rw [← hK]; linarith) (Jlist_lt hJs (List.mem_toFinset.2 ha))
    · intro a ha b _ hnb
      exact capI_band hB hs hlam (Jlist_lt hJs (List.mem_toFinset.2 ha)) hnb
  have : geSolveS P (bandS (lam + B.w) (B.s - lam - B.w)) (Jlist B) (capI P T B)
      (applyMinv P T B U) = geSolve P (Jlist B) (capI P T B) (applyMinv P T B U) :=
    funext hge
  rw [this]

end sp

end J6Seg

