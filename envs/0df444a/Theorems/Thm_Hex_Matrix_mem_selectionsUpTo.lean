theorem mem_selectionsUpTo {m : Nat} :
    ∀ (n bound : Nat) (v : Vector (Fin m) n),
      IsStrictlyIncreasingColumnTuple v →
        (∀ i : Fin n, v[i].val < bound) →
        v ∈ selectedColumnTuplesUpTo m n bound := by sorry
