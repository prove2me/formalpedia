variable {C : Type} [Field C] {κ κ' : Type}

theorem GlobalTheory.OddBlock.ExpBinomial.pair_apply (F : MvPolynomial κ C) (S : MvPowerSeries κ C) :
    pair F S = ∑ A ∈ F.support, MvPolynomial.coeff A F * (A.prod fun _ e => (e.factorial : C)) *
      MvPowerSeries.coeff A S := by sorry
