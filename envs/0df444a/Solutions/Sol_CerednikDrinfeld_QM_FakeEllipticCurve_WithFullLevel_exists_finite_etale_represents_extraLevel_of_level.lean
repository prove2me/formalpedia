variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S : Type} [CommRing S]
  {N : ℕ} [NeZero N] [Fact (IsUnit ((N : ℕ) : S))] [Fact (IsUnit ((N₀ : ℕ) : S))] {m : ℕ}
  (u : FakeEllipticCurve.WithFullLevel Λ N₀ m S) (D : L1aData u.1 N) (s : Finset ↥Λ)

section perK
variable {T : Type} [CommRing T]

theorem UK_spec (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (K : u'.1.ExtraLevel N) :
    ∃ U : (u'.1.L.schemeKer N).Opens, IsClosed (U : Set ↥(u'.1.L.schemeKer N)) ∧
    (∀ t : ↥(Spec (CommRingCat.of T)), (U.ι ≫ u'.1.L.schemeKerStr N).finrank t = N ^ 2) ∧
    ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t u'.1.f),
      CerednikDrinfeld.QM.FactorsThrough K.levK P ↔
        CerednikDrinfeld.QM.FactorsThrough (U.ι ≫ KerOps.ι u'.1.L N) P :=
  FakeEllipticCurve.ExtraLevel.exists_opens_schemeKer_finrank_eq_forall_factorsThrough_iff u'.1 N
    (isUnit_map (S := S) (N := N) φ) K

def UK (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (K : u'.1.ExtraLevel N) :
    (u'.1.L.schemeKer N).Opens := (UK_spec (N := N) φ u' K).choose
theorem UK_closed (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (K : u'.1.ExtraLevel N) :
    IsClosed (UK (N := N) φ u' K : Set ↥(u'.1.L.schemeKer N)) := (UK_spec (N := N) φ u' K).choose_spec.1
theorem UK_rank (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (K : u'.1.ExtraLevel N)
    (t : ↥(Spec (CommRingCat.of T))) : ((UK (N := N) φ u' K).ι ≫ u'.1.L.schemeKerStr N).finrank t = N ^ 2 :=
  (UK_spec (N := N) φ u' K).choose_spec.2.1 t
theorem UK_pts (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T) (K : u'.1.ExtraLevel N)
    {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t u'.1.f) :
    CerednikDrinfeld.QM.FactorsThrough K.levK P ↔
      CerednikDrinfeld.QM.FactorsThrough ((UK (N := N) φ u' K).ι ≫ KerOps.ι u'.1.L N) P :=
  (UK_spec (N := N) φ u' K).choose_spec.2.2 t P

def zCK (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K : u'.1.ExtraLevel N) :
    Spec (CommRingCat.of T) ⟶ Spec (CommRingCat.of (C D.ζ₀)) :=
  zC D φ u'.1 hu'.choose (via_of_wfl φ u u' hu') (UK (N := N) φ u' K) (UK_closed (N := N) φ u' K)

theorem zCK_range (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K : u'.1.ExtraLevel N) :
    Set.range (zCK u D φ u' hu' K) ⊆ Set.range (Zsub D s).ι := by
  haveI : IsFinite (u'.1.L.schemeKerStr N) := isFinite_ker _ N (isUnit_map (S := S) (N := N) φ)
  haveI : Etale (u'.1.L.schemeKerStr N) := etale_ker _ N (isUnit_map (S := S) (N := N) φ)
  rw [Scheme.Opens.range_ι]
  rintro _ ⟨t, rfl⟩
  show (zCK u D φ u' hu' K) t ∈ admSet D s
  rw [zCK, ← spec_θ, admSet_preimage]
  exact adm_of_extraLevel u'.1 (isUnit_map (S := S) (N := N) φ) s (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ) K _ (UK_closed (N := N) φ u' K)
    (UK_rank (N := N) φ u' K) (UK_pts (N := N) φ u' K) t

def ptZ (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K : u'.1.ExtraLevel N) :
    Spec (CommRingCat.of T) ⟶ ↑(Zsub D s) :=
  IsOpenImmersion.lift (Zsub D s).ι (zCK u D φ u' hu' K) (zCK_range u D s φ u' hu' K)

theorem ptZ_ι (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K : u'.1.ExtraLevel N) :
    ptZ u D s φ u' hu' K ≫ (Zsub D s).ι = zCK u D φ u' hu' K := IsOpenImmersion.lift_fac _ _ _

end perK
