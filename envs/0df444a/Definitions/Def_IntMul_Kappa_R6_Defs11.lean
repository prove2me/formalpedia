        addIntCost (zsz (b : ℤ) + zsz (a : ℤ))) := by
    apply IRuns.of_runsTo_r6c 0
    simp +decide [IStmt.run, IOp.run, ldFlag, ldSt, hV]
    refine ⟨by rw [show -(b : ℤ) + a = a - b by ring]; ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, shlCost, splitCost, takeCost, zsz_neg_r6c, zsz_one_r6c, zsz_zero_r6c, zsz_neg_one', zsz_two'] at *)); omega
  -- phase 1
  have hbk : ∀ k ≤ k0, zsz (((b * 2 ^ k : ℕ)) : ℤ) ≤ n + 1 := by
    intro k hk; have := zsz_natCast_mul_two_pow b k; omega
  let ss : ℕ → IState HS := fun k =>
    ldSt s L ((b * 2 ^ k : ℕ) : ℤ) a 0 ((k : ℕ) : ℤ) (some ((a : ℤ) - ((b * 2 ^ k : ℕ) : ℤ)))
  have c1 : ∀ k < k0, IRuns I iprog (ldUp zX) (ss k) (ss (k + 1)) (10000 * (n + 10)) := by
    intro k hk
    have g := ldUp_runs (I := I) (iprog := iprog) s L ((b * 2 ^ k : ℕ) : ℤ) a 0 (k : ℤ)
      ((a : ℤ) - ((b * 2 ^ k : ℕ) : ℤ))
    have e2 : ((b * 2 ^ k : ℕ) : ℤ) * 2 = ((b * 2 ^ (k + 1) : ℕ) : ℤ) := by push_cast; ring
    refine g.mono' (by simp only [ss, e2]; push_cast; ring_nf) ?_
    have := hbk (k + 1) (by omega)
    have := hbk k (by omega)
    have := hlt k hk
    have hf : zsz ((a : ℤ) - ((b * 2 ^ k : ℕ) : ℤ)) ≤ zsz (a : ℤ) := zsz_mono_r6c (by omega)
    have hd : zsz ((k : ℕ) : ℤ) ≤ n := by have := zsz_natCast_le_self' k; omega
    rw [e2]
    ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, shlCost, splitCost, takeCost, zsz_neg_r6c, zsz_one_r6c, zsz_zero_r6c, zsz_neg_one', zsz_two'] at *)); omega
  have hL1 := IRuns.loop' (I := I) (iprog := iprog) (i := zX.F) (f := fun c => c != .neg)
    (p := ldUp zX) ss _ k0 (fun k hk => by
      have h1 : ((b * 2 ^ k : ℕ) : ℤ) ≤ a := by exact_mod_cast hlt k hk
      rw [cl_int (ss k) zX.F ((a : ℤ) - ((b * 2 ^ k : ℕ) : ℤ)) (s.G 62) (by simp [ss, ldSt])]
      have : ¬ ((a : ℤ) - ((b * 2 ^ k : ℕ) : ℤ) < 0) := by omega
      simp only [this, if_false]; split_ifs <;> simp)
    (by
      have h1 : (a : ℤ) < ((b * 2 ^ k0 : ℕ) : ℤ) := by exact_mod_cast hk0
      rw [cl_int (ss k0) zX.F ((a : ℤ) - ((b * 2 ^ k0 : ℕ) : ℤ)) (s.G 62) (by simp [ss, ldSt])]
      have : ((a : ℤ) - ((b * 2 ^ k0 : ℕ) : ℤ) < 0) := by omega
      have : ((a : ℤ) - ((b * 2 ^ k0 : ℕ) : ℤ) ≠ 0) := by omega
      rw [if_neg (by assumption), if_pos (by assumption)]; rfl) c1
  -- drop the flag
  have hdr := IRuns.drop_r6c (I := I) (iprog := iprog) (s := ss k0) (i := zX.F)
    (a := (a : ℤ) - ((b * 2 ^ k0 : ℕ) : ℤ)) (L := s.G 62) (by simp [ss, ldSt])
  -- phase 2
  let tt : ℕ → IState HS := fun j =>
    ldSt s L ((b * 2 ^ (k0 - j) : ℕ) : ℤ) ((a % (b * 2 ^ (k0 - j)) : ℕ) : ℤ)
      ((a / (b * 2 ^ (k0 - j)) : ℕ) : ℤ) ((k0 - j : ℕ) : ℤ) none
  have et : (ss k0).upd zX.F (s.G 62) = tt 0 := by
    simp only [ss, tt, Nat.sub_zero, Nat.mod_eq_of_lt hk0, Nat.div_eq_of_lt hk0]
    simp [ldSt]
  have c2 : ∀ j < k0, IRuns I iprog (ldDown zX) (tt j) (tt (j + 1)) (10000 * (4 * n + 20)) := by
    intro j hj
    set D := b * 2 ^ (k0 - (j + 1)) with hD
    have hD0 : 0 < D := by positivity
    have e2 : b * 2 ^ (k0 - j) = 2 * D := by
      rw [hD, show k0 - j = k0 - (j + 1) + 1 by omega, pow_succ]; ring
    have hq : zsz ((a / (2 * D) : ℕ) : ℤ) ≤ n := by
      have := zsz_natCast_le' (Nat.div_le_self a (2 * D)); omega
    have h2D : zsz ((2 * D : ℕ) : ℤ) ≤ n + 1 := by rw [← e2]; exact hbk _ (by omega)
    have hr : zsz ((a % (2 * D) : ℕ) : ℤ) ≤ n + 1 := by
      have := zsz_natCast_le' (Nat.mod_lt a (show 0 < 2 * D by omega)).le; omega
    have hdk : zsz (((k0 - j : ℕ)) : ℤ) ≤ n := by have := zsz_natCast_le_self' (k0 - j); omega
    have ar := ldiv_arith a D hD0
    have htj : tt j = ldSt s L (2 * (D : ℤ)) ((a % (2 * D) : ℕ) : ℤ) ((a / (2 * D) : ℕ) : ℤ)
        ((k0 - j : ℕ) : ℤ) none := by simp only [tt, e2]; push_cast; rfl
    rw [htj]
    by_cases hc : a % (2 * D) < D
    · have g := ldDown_lt (I := I) (iprog := iprog) s L (D : ℤ) ((a % (2 * D) : ℕ) : ℤ)
        ((a / (2 * D) : ℕ) : ℤ) ((k0 - j : ℕ) : ℤ) (by positivity) (by exact_mod_cast hc)
      refine g.mono' ?_ ?_
      · simp only [tt, ← hD, (ar.1 hc).1, (ar.1 hc).2]; push_cast
        rw [show ((k0 - j : ℕ) : ℤ) - 1 = ((k0 - (j + 1) : ℕ) : ℤ) by omega]
      · push_cast at h2D; omega
    · have g := ldDown_ge (I := I) (iprog := iprog) s L (D : ℤ) ((a % (2 * D) : ℕ) : ℤ)
        ((a / (2 * D) : ℕ) : ℤ) ((k0 - j : ℕ) : ℤ) (by positivity) (by exact_mod_cast (show D ≤ a % (2 * D) by omega))
      refine g.mono' ?_ ?_
      · simp only [tt, ← hD, (ar.2 (by omega)).1, (ar.2 (by omega)).2]
        rw [show ((k0 - j : ℕ) : ℤ) - 1 = ((k0 - (j + 1) : ℕ) : ℤ) by omega]
        push_cast [Nat.cast_sub (show D ≤ a % (2 * D) by omega)]; rfl
      · push_cast at h2D; omega
  have hL2 := IRuns.loop' (I := I) (iprog := iprog) (i := zX.D) (f := fun c => c != .zero)
    (p := ldDown zX) tt _ k0 (fun j hj => by
      rw [cl_int (tt j) zX.D ((k0 - j : ℕ) : ℤ) (s.G 60) (by simp [tt, ldSt])]
      have : ((k0 - j : ℕ) : ℤ) ≠ 0 := by omega
      rw [if_neg this]; split_ifs <;> rfl)
    (by rw [cl_int (tt k0) zX.D ((k0 - k0 : ℕ) : ℤ) (s.G 60) (by simp [tt, ldSt])]; simp) c2
  -- epilogue
  have h3 : IRuns I iprog (.seq (.op (.drop zX.E)) (.seq (.op (.drop zX.D)) (.seq (.op (.drop zX.A))
      (.seq (.op (.mv zX.C zX.V)) (.op (.mv zX.B zX.G)))))) (tt k0)
      ((s.upd 56 (.int ((a / b : ℕ) : ℤ) :: L)).upd 63 (.int ((a % b : ℕ) : ℤ) :: s.G 63))
      (100 * moveCost (n + 1) + 1000) := by
    apply IRuns.of_runsTo_r6c 0
    simp +decide [IStmt.run, IOp.run, tt, ldSt]
    refine ⟨by ((apply IState.ext' <;> intros <;> simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;> simp_all +decide)), ?_⟩
    have h1 := zsz_natCast_le' (Nat.div_le_self a b)
    have h2 := zsz_natCast_le' (Nat.mod_le a b)
    push_cast at h1 h2
    ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, shlCost, splitCost, takeCost, zsz_neg_r6c, zsz_one_r6c, zsz_zero_r6c, zsz_neg_one', zsz_two'] at *)); omega
  rw [et] at hdr
  refine (h0.seq_r6c (hL1.seq_r6c (hdr.seq_r6c (hL2.seq_r6c h3)))).mono_r6c ?_
  have hf : zsz ((a : ℤ) - ((b * 2 ^ k0 : ℕ) : ℤ)) ≤ 2 * n + 2 := by
    have := zsz_add_le' (a : ℤ) (-((b * 2 ^ k0 : ℕ) : ℤ)); rw [zsz_neg_r6c] at this
    have := hbk k0 le_rfl; rw [sub_eq_add_neg]; omega
  simp only [ldivCost]
  have hk : k0 ≤ n := by omega
  ((simp only [addIntCost, addMagCost, subMagCost, dupCost, moveCost, zipCost, shlCost, splitCost, takeCost, zsz_neg_r6c, zsz_one_r6c, zsz_zero_r6c, zsz_neg_one', zsz_two'] at *))
  nlinarith

end NLogN

