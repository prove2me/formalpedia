      NumberField.AdeleRing.finitePartUnits (𝓞 ℚ) ℚ u ∈ IsDedekindDomain.FiniteAdeleRing.unitIdeles (𝓞 ℚ) ℚ → χ u = 1)
    (hnormU : ∀ u : (AdeleRing (𝓞 ℚ) ℚ)ˣ, (u : AdeleRing (𝓞 ℚ) ℚ).1 = 1 →
      (∀ v ∈ T, (u : AdeleRing (𝓞 ℚ) ℚ).2 v = 1) →
      NumberField.AdeleRing.finitePartUnits (𝓞 ℚ) ℚ u ∈ IsDedekindDomain.FiniteAdeleRing.unitIdeles (𝓞 ℚ) ℚ →
        TateGlobal.ideleNorm ℚ u = 1)
    (hnorm : ∀ v : HeightOneSpectrum (𝓞 ℚ),
      TateGlobal.ideleNorm ℚ (uniformizerIdele ℚ v) = ((Ideal.absNorm v.asIdeal : ℕ) : ℝ)⁻¹)
    (hsum : Summable fun v : HeightOneSpectrum (𝓞 ℚ) => ((Ideal.absNorm v.asIdeal : ℕ) : ℝ) ^ (-(3 : ℝ)))
    (s : ℂ) (hs : κ + τ₀ + 4 ≤ s.re)
    (hT : Integrable (fun a => Φ a * ((χ a : ℂˣ) : ℂ) *
        ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)) (NumberField.Idele.sPartMeasure ℚ T)) :
    Multipliable (fun v : {v : HeightOneSpectrum (𝓞 ℚ) // v ∉ T} =>
        ∑' m : ℤ, τ v.1 m * ((χ (uniformizerIdele ℚ v.1) ^ m : ℂˣ) : ℂ) *
          (((((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ)⁻¹ ^ m : ℝ)) : ℂ) ^ (s - 1)) ∧
      Integrable (fun a => Φ a * ((χ a : ℂˣ) : ℂ) *
        ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)) (NumberField.Idele.idelicHaar ℚ) ∧
      (∫ a, Φ a * ((χ a : ℂˣ) : ℂ) * ((TateGlobal.ideleNorm ℚ a : ℝ) : ℂ) ^ (s - 1)
