-- title:
--   The law of the belief process under a policy
-- statement:
--   The law on sequences $(\mu_0,\mu_1,\dots)$ of the distorted posterior means generated by a policy from $\mu_0=\mu_0$: the Ionescu-Tulcea measure of the policy's kernels.
--
--   **Formalization Note.** The expectation $E_\pi$ of (8) is the expectation under this measure.
-- source:
--   Keppo, Kim, Zhang, Learning Manipulation Through Information Dissemination (SSRN 3465030, 2021-09-04), §2, p.11

import Mathlib
import Definitions.Def_LearnManip_Policy

open scoped NNReal ENNReal
open MeasureTheory ProbabilityTheory

namespace LearnManip

/-- The law of the distorted belief process `(μ_t)_{t ∈ ℕ₀}` generated by a policy from `μ_0 = μ₀`
(§2, p.11, of Keppo, Kim, Zhang, SSRN 3465030, 2021-09-04): the Ionescu-Tulcea measure of the
kernels `M.K` started at `μ₀`. -/
noncomputable def pathLaw {s₀ : ℝ≥0} (M : Policy s₀) (μ₀ : ℝ) : Measure (ℕ → ℝ) :=
  Kernel.traj (X := fun _ : ℕ => ℝ) M.K 0 (fun _ => μ₀)

end LearnManip


