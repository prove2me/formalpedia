private theorem _root_.CerednikDrinfeld.QM.IsGroupPullback.push_mul (hg : IsGroupPullback φ L L' g) {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of R'))
    (P Q : SchemeHomOver t' f') :
