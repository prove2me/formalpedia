/-- The goods assigned to an agent by a total owner map. -/
def bundle {n m : ℕ} (owner : Fin m → Fin n) (i : Fin n) : Finset (Fin m) :=
  Finset.univ.filter (fun g => owner g = i)

@[simp] theorem mem_bundle {n m : ℕ} (owner : Fin m → Fin n)
    (i : Fin n) (g : Fin m) : g ∈ bundle owner i ↔ owner g = i := by
  simp [bundle]

/-- Nonnegative integer weights of the eleven public coverage features. -/
def weight : Fin 11 → ℕ := ![1, 1, 3, 3, 3, 8, 8, 9, 9, 2, 2]

/-- Covered features, indexed first by the agent and then by the good. -/
def cov : Fin 3 → Fin 8 → Finset (Fin 11) := ![![{2, 5, 6, 9, 10}, {0, 3, 5, 7, 9}, {1, 4, 6, 8, 10}, {2, 5, 6, 9, 10}, {0, 3, 5, 7, 9}, {1, 4, 6, 8, 10}, {2, 7, 8}, {3, 4, 7, 8, 9, 10}], ![{0, 3, 5, 7, 9}, {1, 4, 6, 8, 10}, {2, 5, 6, 9, 10}, {0, 3, 5, 7, 9}, {1, 4, 6, 8, 10}, {2, 5, 6, 9, 10}, {2, 7, 8}, {3, 4, 7, 8, 9, 10}], ![{1, 4, 6, 8, 10}, {2, 5, 6, 9, 10}, {0, 3, 5, 7, 9}, {1, 4, 6, 8, 10}, {2, 5, 6, 9, 10}, {0, 3, 5, 7, 9}, {2, 7, 8}, {3, 4, 7, 8, 9, 10}]]

/-- The integer coverage valuation; the final root casts this to ℝ. -/
def valueN (i : Fin 3) (S : Finset (Fin 8)) : ℕ :=
  ∑ f ∈ S.biUnion (cov i), weight f

end S02EFX

