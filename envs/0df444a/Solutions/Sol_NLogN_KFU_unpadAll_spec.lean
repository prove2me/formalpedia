      rw [List.take_succ_eq_append_getElem hkS, List.append_assoc]; rfl
    have hle : S[k] ≤ T[k] := (List.forall₂_iff_get.1 hF).2 k hkS hkT
    have hNN : List.Forall₂ (· ≤ ·) (A ++ S[k] :: Bs) (A ++ T[k] :: Bs) :=
      List.rel_append (NLogN.KFU.forall₂_refl' _) (.cons hle (NLogN.KFU.forall₂_refl' _))
    set zs := AModelL12.extract (S.take k ++ T.drop k) T 0 ys
    have hzs : zs.length = AModel.vol (A ++ T[k] :: Bs) := by rw [← eN]; simp [zs]
    have hzsl : zs.length = AModel.vol A * (T[k] * AModel.vol Bs) := by rw [hzs, AModel.vol_append, AModel.vol_cons]
    have H := NLogN.KFU.unpadI_spec (I := I) (iprog := iprog) (AModel.vol A) (S[k] * AModel.vol Bs) (T[k] * AModel.vol Bs) w
      (Nat.mul_le_mul_right _ hle) zs hzsl (NLogN.KFU.bnd_pull _ _ _ hb) (s.upd 0 (NLogN.ints zs ++ R)) R (by simp)
    have eP : NLogN.KFU.unpPre (S[k] * AModel.vol Bs) (T[k] * AModel.vol Bs) zs (AModel.vol A) =
        AModelL12.extract (S.take (k + 1) ++ T.drop (k + 1)) T 0 ys := by
      rw [← NLogN.KFU.unpadL_eq_unpPre, ← NLogN.KIL.extract_eq_unpadL A Bs hle 0 hzs, eN']
      simp only [zs]
      rw [eN]
      exact NLogN.KIL.extract_trans (AModelL12.shapeLE_of_forall₂ hNN) 0 ys
    rw [eP] at H
    have eS : NLogN.KFU.unpadStep (Pp := Pp) S T k = NLogN.KFU.unpadI (AModel.vol A) (S[k] * AModel.vol Bs) (T[k] * AModel.vol Bs) := by
      simp [NLogN.KFU.unpadStep, A, Bs, List.getElem?_eq_getElem hkS, List.getElem?_eq_getElem hkT]
    rw [NLogN.KFU.unpadAllC, eS]
    refine (IH.seq H).mono' (by simp [Bs]) ?_
    have hc := NLogN.KFU.cUnpadI_le (AModel.vol A) (S[k] * AModel.vol Bs) (T[k] * AModel.vol Bs) w (Nat.mul_le_mul_right _ hle)
    have hT : ∀ a ∈ T, 1 ≤ a := by
      intro a ha
      obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem ha
      have := List.forall₂_iff_get.1 hF |>.2 i (by omega) hi
      have := hS _ (List.getElem_mem (show i < S.length by omega)); simp at *; omega
    have h1 : AModel.vol A * (T[k] * AModel.vol Bs) ≤ AModel.vol T := by
      rw [← AModel.vol_cons, ← AModel.vol_append, ← eN]
      apply NLogN.KFU.vol_le_of_forall₂
