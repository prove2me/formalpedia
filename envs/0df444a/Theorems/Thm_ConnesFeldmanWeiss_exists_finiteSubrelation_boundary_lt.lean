-- title:
--   Lemma 8 — the Følner condition: an amenable relation has finite subrelations with small boundary in any bounded set
-- statement:
--   Let $X$ be a standard Borel space, $\mu$ a probability measure on $X$, and $R$ a discrete measured equivalence relation for $\mu$ (`IsDiscreteMeasured`) that is amenable (`Monod.IsAmenableRel`: it has a left invariant mean). Let $K$ be a bounded subset of $R$ (`IsBoundedSubset`) and $\varepsilon > 0$. Then there is a finite subequivalence relation $T$ of $R$ (`IsFiniteSubrelation`) with $\mu(T^{(0)}) \ne 0$ and
--   $$m\{\gamma \in K \mid (s(\gamma) \in T^{(0)} \text{ or } r(\gamma) \in T^{(0)}) \text{ and } \gamma \notin T\} < \varepsilon\, \mu(T^{(0)}),$$
--   where $m$ is the measure on $R$ of p. 434 (`relMeasure`), $r(y, x) = y$ and $s(y, x) = x$.
--
--   Amenability is the standing assumption of §5, and $\mu$ is a probability measure as in the proof of Lemma 9 (see the milestone description).
-- source:
--   Connes, A., Feldman, J., Weiss, B., An amenable equivalence relation is generated by a single transformation, Ergodic Theory Dynam. Systems 1 (1981) 431–450, https://doi.org/10.1017/S014338570000136X, p. 440, Lemma 8

import Mathlib
import Definitions.Def_ConnesFeldmanWeiss
import Definitions.Def_Monod_PiecewiseProjective

namespace ConnesFeldmanWeiss

theorem exists_finiteSubrelation_boundary_lt {X : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] (μ : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure μ]
    (R : Set (X × X)) (hR : IsDiscreteMeasured μ R) (hamen : Monod.IsAmenableRel μ R)
    (K : Set (X × X)) (hK : IsBoundedSubset μ R K) (ε : ℝ) (hε : 0 < ε) :
    ∃ T, IsFiniteSubrelation R T ∧
      relMeasure μ R {γ ∈ K | (γ.2 ∈ unitSpace T ∨ γ.1 ∈ unitSpace T) ∧ γ ∉ T} <
        ENNReal.ofReal ε * μ (unitSpace T) ∧ μ (unitSpace T) ≠ 0 := by
  sorry

end ConnesFeldmanWeiss
