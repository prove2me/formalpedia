  obtain ⟨ℓ, hℓ, rfl⟩ := List.getElem_of_mem hd
  rw [← List.getD_eq_getElem _ 0 hℓ, getD_weaveList]
  split_ifs
  · exact List.getD_of_forall_mem (p := (· < b)) hb hinner _
  · exact List.getD_of_forall_mem (p := (· < b)) hb houter _
  · exact hb

