variable (s μ : ℕ → ℕ)

/-- Processing the targets `m, …, m+n-1` in descending order on a valid address updates each of
them from the original lower coordinates. -/
theorem shifts_foldr (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    ∀ n m, m + n ≤ d → (List.range' m n).foldr (IntMul.OpenAI.RCRT.upd s μ) a =
      fun j => if m ≤ j ∧ j < m + n then (a j + IntMul.OpenAI.RCRT.offset s μ a j) % s j else a j
  | 0, m, _ => by funext j; simp
  | n + 1, m, h => by
    rw [List.range'_succ, List.foldr_cons, shifts_foldr d a ha n (m + 1) (by omega)]
    set y : ℕ → ℕ := fun j => if m + 1 ≤ j ∧ j < m + 1 + n then
      (a j + IntMul.OpenAI.RCRT.offset s μ a j) % s j else a j with hy
    have hyl : ∀ j ≤ m, y j = a j := by
      intro j hj; simp only [hy]; rw [if_neg (by omega)]
    have hval : validUpTo s y m := fun j hj => by rw [hyl j hj]; exact ha j (by omega)
    have hoff : IntMul.OpenAI.RCRT.offset s μ y m = IntMul.OpenAI.RCRT.offset s μ a m := by
      unfold IntMul.OpenAI.RCRT.offset; congr 1
      refine Finset.sum_congr rfl (fun j hj => ?_)
      rw [hyl j (by simp at hj; omega)]
    unfold IntMul.OpenAI.RCRT.upd
    rw [if_pos hval, hoff, hyl m le_rfl]
    funext j
    rcases eq_or_ne j m with rfl | hne
    · simp
    · rw [Function.update_of_ne hne]; simp only [hy]
      by_cases h1 : m + 1 ≤ j ∧ j < m + 1 + n
      · rw [if_pos h1, if_pos (by omega)]
      · rw [if_neg h1, if_neg (by omega)]

/-- **Triangular realization of `Φ`**: the shifts for `i = d-1, …, 0` send the valid address
`a` to `b_i = (a_i + μ_i Σ_{j<i} a_j P_j) mod s_i` (42). -/
theorem shifts_realize (d : ℕ) (a : ℕ → ℕ) (ha : ∀ j < d, a j < s j) :
    (List.range d).foldr (IntMul.OpenAI.RCRT.upd s μ) a =
      fun j => if j < d then (a j + IntMul.OpenAI.RCRT.offset s μ a j) % s j else a j := by
  rw [List.range_eq_range', shifts_foldr s μ d a ha d 0 (by omega)]
  funext j; simp

end shifts

