--   theorem J6QLU.realToep_inv (h : 0 < α ^ 2 * σ) (n : ℕ) :
--       (realToep α σ b n)⁻¹ = GamInv (qR α σ) n * upT (aplus α σ b) * Gam (qR α σ) n *
--         lowT (aminus α σ b) * GamInv (qR α σ) n
--   ```
