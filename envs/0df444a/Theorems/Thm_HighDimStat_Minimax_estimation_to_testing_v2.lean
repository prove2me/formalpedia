-- title:
--   From estimation to testing (Proposition 15.1), with $\delta>0$ and $\Phi\ge 0$
-- statement:
--   **Proposition 15.1** (From estimation to testing). The foundational reduction underlying
--   every minimax lower bound technique in Chapter 15 (Le Cam's method, Fano's method, Assouad's
--   method): the minimax risk of estimating a functional is lower bounded by the difficulty of
--   an associated finite hypothesis-testing problem, built from any $2\delta$-separated packing
--   set of the parameter space.
--
--   Let $\rho$ be a semi-metric on $\Omega$, $\Phi:[0,\infty)\to[0,\infty)$ an increasing
--   (non-decreasing) function, $\delta>0$, and $\{\theta_1,\dots,\theta_M\}\subseteq\theta(\mathcal P)$
--   a $2\delta$-separated set ($\rho(\theta_j,\theta_k)\ge2\delta$ for $j\ne k$) with representative
--   distributions $P_{\theta_1},\dots,P_{\theta_M}\in\mathcal P$. Let $Q$ be the joint law of $(J,Z)$
--   obtained by sampling $J$ uniformly from $\{1,\dots,M\}$ and then $Z\sim P_{\theta_J}$. Then
--
--   $$
--   \mathfrak M\bigl(\theta(\mathcal P); \Phi\circ\rho\bigr) \;\ge\; \Phi(\delta)\, \inf_{\psi}
--   Q\bigl[\psi(Z)\ne J\bigr],
--   $$
--
--   where the infimum ranges over measurable test functions $\psi:\mathcal X \to [M]$ and
--   $\mathfrak M(\theta(\mathcal P);\Phi\circ\rho)=\inf_{\hat\theta}\sup_{P\in\mathcal P}
--   \mathbb E_P[\Phi(\rho(\hat\theta,\theta(P)))]$ is the minimax risk (15.2).
--
--   **Formalization Note.** The retired version (`estimation_to_testing`) let $\delta$ be an
--   arbitrary real and only constrained $\Phi$ on $[0,\infty)$ by monotonicity: for $\delta<0$ the
--   separation hypothesis is automatic ($\rho\ge0$) while $\Phi(\delta)$ is unconstrained, so the
--   statement was false (accepted disproof with $\delta=-1$). The new statement adds `hδ : 0 < δ`
--   (the source's $\delta>0$) and `hΦ0 : ∀ x, 0 ≤ x → 0 ≤ Φ x` (the source's codomain
--   $[0,\infty)$, so that `ENNReal.ofReal` never truncates the loss). Everything else is as before:
--   $\Phi$ is kept fully general, the minimax risk uses the extended-real lower integral so that no
--   integrability hypothesis is needed, and the packing-set formulation of Proposition 15.1 (not
--   Lemma 15.9) is used. The case $M=0$ is excluded automatically since $Q$ must be a probability
--   measure on $[M]\times\mathcal X$.
-- source:
--   Wainwright, High-Dimensional Statistics, CUP 2019, p. 488 (PDF p. 508), Proposition 15.1, Eq. (15.3)

import Mathlib
import Definitions.Def_HighDimStat_Minimax_MinimaxRisk
import Definitions.Def_HighDimStat_Minimax_IsSeparated
import Definitions.Def_HighDimStat_Minimax_IsJointTestingMeasure

open MeasureTheory

namespace HighDimStat.Minimax

/-- **Proposition 15.1** (From estimation to testing), Wainwright, *High-Dimensional
Statistics* (2019), Eq. (15.3), p. 487. For any increasing function `Φ : [0,∞) → [0,∞)` and
any `2δ`-separated set `{θ₁,…,θ_M}` (`δ > 0`) with representative distributions `P_{θⱼ}`, the
minimax risk is lower bounded as

`M(θ(P), Φ∘ρ) ≥ Φ(δ) · inf_ψ Q[ψ(Z) ≠ J]`,

where the infimum ranges over measurable test functions `ψ : 𝒳 → [M]`, and `Q` is the joint
law of `(J,Z)` generated by sampling `J` uniformly and then `Z ∼ P_{θⱼ}` given `J=j`.

Corrections relative to the retired version: the separation radius was an arbitrary real
(`δ < 0` makes `IsSeparated` vacuous while `Φ δ` is unconstrained), so `hδ : 0 < δ` is now
required as in the source; and `Φ` is required to be nonnegative on `[0,∞)`, i.e. to be a map
`[0,∞) → [0,∞)` as the source states. -/
theorem estimation_to_testing_v2 {𝒳 Ω Idx : Type*} [MeasurableSpace 𝒳] [MeasurableSpace Ω]
    (measure : Idx → Measure 𝒳) [∀ p, IsProbabilityMeasure (measure p)]
    (θ : Idx → Ω) (ρ : Ω → Ω → ℝ)
    (hρ_nonneg : ∀ x y, 0 ≤ ρ x y) (hρ_refl : ∀ x, ρ x x = 0)
    (hρ_symm : ∀ x y, ρ x y = ρ y x) (hρ_tri : ∀ x y z, ρ x z ≤ ρ x y + ρ y z)
    (Φ : ℝ → ℝ) (hΦ : ∀ x y, 0 ≤ x → x ≤ y → Φ x ≤ Φ y) (hΦ0 : ∀ x, 0 ≤ x → 0 ≤ Φ x)
    {M : ℕ} (θs : Fin M → Ω) (δ : ℝ) (hδ : 0 < δ) (hsep : IsSeparated ρ θs δ)
    (Prep : Fin M → Idx) (hPrep : ∀ j, θ (Prep j) = θs j)
    (Q : Measure (Fin M × 𝒳)) [IsProbabilityMeasure Q]
    (hQ : IsJointTestingMeasure measure Prep Q) :
    ENNReal.ofReal (Φ δ) *
      (⨅ ψ : {f : 𝒳 → Fin M // Measurable f}, Q {p : Fin M × 𝒳 | ψ.1 p.2 ≠ p.1}) ≤
      minimaxRisk measure θ ρ Φ := by sorry

end HighDimStat.Minimax
