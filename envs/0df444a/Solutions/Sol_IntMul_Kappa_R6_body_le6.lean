      10 ^ 30 * (2 * (32500 * (Cfm : ℝ) + 6) + 6 ^ 12) * ((Q.T : ℝ) * Q.p *
        (Real.log Q.p + 1) ^ 2) := by
  have hB5 := BN6_le hQ hD
  have hpB := p_le_B6 hQ hD
  have hp := p_ge6 hQ hD
  have hdb := hQ.hdb
  have hlen : (dsG Q.p Q.h (D + 1) (σ6 Q) Q.K).length ≤ BN6 Q := by
