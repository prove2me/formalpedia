namespace NLogN.KFW

open IntMul RS KIL KFD KFB KFS KFL AModel AModelL12

theorem sq_le_two_pow (k : ℕ) : k ^ 2 ≤ 2 ^ (k + 1) := by
  induction k with
  | zero => norm_num
  | succ k ih =>
    have h := Nat.lt_two_pow_self (n := k)
    have e : 2 ^ (k + 1 + 1) = 2 * 2 * 2 ^ k := by ring
    rw [e]
    have e2 : 2 ^ (k + 1) = 2 * 2 ^ k := by ring
    rw [e2] at ih
    nlinarith

theorem zsz_sq_le (L : ℕ) : zsz (L : ℤ) ^ 2 ≤ 4 * L := by
  rcases Nat.eq_zero_or_pos L with h | h
  · subst h; simp [zsz_zero]
  · have := sq_le_two_pow (zsz (L : ℤ))
    have h2 := KFB.two_pow_zsz_le (V := L) h
    have e : 2 ^ (zsz (L : ℤ) + 1) = 2 * 2 ^ zsz (L : ℤ) := by ring
    rw [e] at this
    linarith

end NLogN.KFW

end

