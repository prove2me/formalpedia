-- url     : https://prove2.me/theorems/d20045cc-fdb3-4a15-b789-fa2e5dc74de8
-- title:
--   Swan conductor at infinity of the Artin–Schreier sheaf: $\mathrm{Sw}_\infty(\mathcal{L}_\psi(f)) = \deg f$, with a single ramification jump at $\deg f$
-- statement:
--   Let $\mathbb{F}_q$ be a finite field with $q$ elements, $K = \mathbb{F}_q(x)$, and let $f \in \mathbb{F}_q[x]$ have degree $N \ge 1$ with $\gcd(N, q) = 1$ (that is, the characteristic $p$ does not divide $N$). Let $L$ be an extension field of $K$ generated by an element $y$ with
--
--   $$y^q - y + f(x) = 0$$
--
--   (the Artin–Schreier cover of the affine line attached to $f$). Let $\mathcal{O}_\infty \subset K$ be the valuation ring of the place at infinity ($v_\infty(g) = -\deg g$), let $B$ be the integral closure of $\mathcal{O}_\infty$ in $L$, and let $\mathfrak{P}$ be any nonzero prime ideal of $B$ (a place of $L$ over $\infty$). For $i \ge 0$ let
--
--   $$G_i = \{\sigma \in \mathrm{Aut}_K(L) : \sigma(b) - b \in \mathfrak{P}^{\,i+1} \text{ for all } b \in B\}$$
--
--   be the lower ramification groups at $\mathfrak{P}$. Then:
--
--   1. $|\mathrm{Aut}_K(L)| = q$, so $L/K$ is Galois of degree $q$;
--   2. every $\sigma \ne 1$ lies in $G_N$ but not in $G_{N+1}$; hence $G_0 = G_1 = \dots = G_N = \mathrm{Aut}_K(L)$ and $G_{N+1} = 1$: the place at infinity is totally and wildly ramified with a single lower ramification jump at $N$;
--   3. for every nontrivial additive character $\psi : \mathbb{F}_q \to k^\times$ ($k$ any field), the character $\chi$ of $\mathrm{Aut}_K(L)$ given by $\chi(\sigma) = \psi(c)$ when $\sigma(y) = y + c$ with $c \in \mathbb{F}_q$ (the character of the rank-one sheaf $\mathcal{L}_\psi(f)$ restricted to the decomposition group at $\infty$) has Swan conductor
--
--   $$\mathrm{Sw}_\infty(\chi) = \sum_{i \ge 1} \frac{|G_i|}{|G_0|}\,\bigl(1 - \dim \chi^{G_i}\bigr) = N = \deg f.$$
--
--   This is the basic local input to Weil-type bounds for one-variable exponential sums: with the Grothendieck–Ogg–Shafarevich formula it gives $\chi_c(\mathbb{A}^1_{\overline{\mathbb{F}}_q}, \mathcal{L}_\psi(f)) = 1 - \deg f$, so $\sum_{x \in \mathbb{F}_q} \psi(f(x))$ is a sum of $\deg f - 1$ Frobenius eigenvalues.
--
--   **Formalization Note**: $K$ is `RatFunc Fq`, $\mathcal{O}_\infty$ is `(RatFunc.inftyValuation Fq).valuationSubring`, $B$ is `integralClosure (RatFunc.inftyValuation Fq).valuationSubring L`, and $f(x)$ is `algebraMap (RatFunc Fq) L (algebraMap Fq[X] (RatFunc Fq) f)`; that $y$ generates $L$ is `IntermediateField.adjoin (RatFunc Fq) {y} = ⊤`. The group $\mathrm{Aut}_K(L)$ is `L ≃ₐ[RatFunc Fq] L` and $|\cdot|$ is `Nat.card`. Membership $\sigma \in G_i$ is written out as `∀ b : B, ∃ c ∈ P ^ (i + 1), (c : L) = σ b - b` (for $i = 0$ the ideal is `P` itself). Item 2 says, for $\sigma \ne 1$, that $\sigma(b) - b \in \mathfrak{P}^{N+1}$ for all $b$ and that some $b$ has $\sigma(b) - b \notin \mathfrak{P}^{N+2}$. In item 3 the character is any map `χ` with `χ σ = ψ c` whenever `σ y = y + c`; since $\chi$ is one-dimensional, $1 - \dim \chi^{G_i}$ is $0$ if $\chi$ is trivial on $G_i$ and $1$ otherwise, written `if ∀ σ ∈ G_i, χ σ = 1 then 0 else 1`. The sum is a `finsum` over `i : ℕ` whose $i$-th term is the term for $G_{i+1}$ (ideal `P ^ (i + 2)`), computed in `ℚ`. The hypotheses are satisfiable: for example $q = 2$, $f = x$ and $L = K[y]/(y^2 - y + x)$, or any $f$ of degree prime to $p$ with $L = K[y]/(y^q - y + f)$ (this polynomial is irreducible).
-- source:
--   N. M. Katz, Gauss Sums, Kloosterman Sums, and Monodromy Groups, Annals of Mathematics Studies 116, Princeton University Press (1988), Chapter 1 (p. 13: $\mathrm{Sw}_\infty(\mathcal{L}_\psi(f)) = \deg f$ for $p \nmid \deg f$); ramification groups and the Swan conductor as in J.-P. Serre, Local Fields, GTM 67, Springer (1979), Chapters IV and VI

import Mathlib

set_option autoImplicit false

open Polynomial

open scoped Classical

theorem RatFunc.artinSchreier_lowerRamificationGroup_infty_eq_and_swan_eq_natDegree
    (Fq : Type) [Field Fq] [Fintype Fq] [DecidableEq (RatFunc Fq)]
    (f : Fq[X]) (hN : 1 ≤ f.natDegree) (hcop : Nat.Coprime f.natDegree (Fintype.card Fq))
    (L : Type) [Field L] [Algebra (RatFunc Fq) L] (y : L)
    (hy : y ^ Fintype.card Fq - y + algebraMap (RatFunc Fq) L (algebraMap Fq[X] (RatFunc Fq) f) = 0)
    (hgen : IntermediateField.adjoin (RatFunc Fq) {y} = ⊤)
    (P : Ideal (integralClosure (RatFunc.inftyValuation Fq).valuationSubring L)) [P.IsPrime]
    (hP : P ≠ ⊥) :
    Nat.card (L ≃ₐ[RatFunc Fq] L) = Fintype.card Fq ∧
    (∀ σ : L ≃ₐ[RatFunc Fq] L, σ ≠ 1 →
      (∀ b : integralClosure (RatFunc.inftyValuation Fq).valuationSubring L,
          ∃ c ∈ P ^ (f.natDegree + 1), (c : L) = σ b - b) ∧
      ∃ b : integralClosure (RatFunc.inftyValuation Fq).valuationSubring L,
          ∀ c ∈ P ^ (f.natDegree + 2), (c : L) ≠ σ b - b) ∧
    ∀ {k : Type} [Field k] (ψ : AddChar Fq k), (∃ a, ψ a ≠ 1) →
      ∀ χ : (L ≃ₐ[RatFunc Fq] L) → k,
        (∀ (σ : L ≃ₐ[RatFunc Fq] L) (c : Fq),
          σ y = y + algebraMap (RatFunc Fq) L (algebraMap Fq (RatFunc Fq) c) → χ σ = ψ c) →
        ∑ᶠ i : ℕ,
            (Nat.card {σ : L ≃ₐ[RatFunc Fq] L //
                ∀ b : integralClosure (RatFunc.inftyValuation Fq).valuationSubring L,
                  ∃ c ∈ P ^ (i + 2), (c : L) = σ b - b} : ℚ) /
              (Nat.card {σ : L ≃ₐ[RatFunc Fq] L //
                ∀ b : integralClosure (RatFunc.inftyValuation Fq).valuationSubring L,
                  ∃ c ∈ P, (c : L) = σ b - b} : ℚ) *
            (if ∀ σ : L ≃ₐ[RatFunc Fq] L,
                (∀ b : integralClosure (RatFunc.inftyValuation Fq).valuationSubring L,
                  ∃ c ∈ P ^ (i + 2), (c : L) = σ b - b) → χ σ = 1 then 0 else 1) =
          (f.natDegree : ℚ) := by sorry
