-- title:
--   Theorem 6.1(i) — iterates stay feasible and the Lyapunov sequence (27) is nonincreasing and convergent
-- statement:
--   Let $(x_n)$ be generated by Algorithm 2 under Assumptions 1 and 2′, and suppose $S_0=\{x\in S: f(x)/g(x)\le f(x_0)/g(x_0)\}$ is bounded. Then for all $n\in\mathbb N$, $x_n\in S\cap\operatorname{dom}f$, and
--   $$F_n:=\frac{f(x_n)}{g(x_n)}+\Big(\frac{\ell\bar\kappa^2}{2m}+\frac{\bar\mu}{2\sqrt{mM}}\Big)\|x_n-x_{n-1}\|^2\qquad(27)$$
--   is nonincreasing and convergent. Consequently the sequence $\big(f(x_n)/g(x_n)\big)_{n\in\mathbb N}$ is convergent.
--
--   This is the descent part of the convergence theory of Algorithm 2.
--
--   **Formalization Note** $x_{-1}=x_0$; "nonincreasing" is `Antitone`, and convergence is to a real limit.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 22, Theorem 6.1(i)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Enhanced_Basic
import Definitions.Def_FracPSG_Enhanced_Algorithm2

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Enhanced

open NonconvexSplitting.Shared

/-- Theorem 6.1(i) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 22): for a run of Algorithm 2 under
Assumptions 1 and 2′ with bounded `S₀`, every iterate lies in `S ∩ dom f`, the sequence (27)
`Fₙ = f(xₙ)/g(xₙ) + (ℓκ̄²/(2m) + μ̄/(2√(mM)))‖xₙ − xₙ₋₁‖²` is nonincreasing and convergent, and
consequently `f(xₙ)/g(xₙ)` converges. -/
theorem theorem_6_1_i
    {N p : ℕ} [NeZero p] {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {gi : Fin p → EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ ε μbar κbar m M : ℝ}
    {x : ℕ → EuclideanSpace ℝ (Fin N)} {w : ℕ → Fin p → EuclideanSpace ℝ (Fin N)}
    {ihat : ℕ → Fin p} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : FracPSG.Subseq.Assumption1 S fs fn ℓ) (hA2 : Assumption2' S (FracPSG.Subseq.objF fs fn) gi β m M)
    (hpar : Step1Params ℓ β δ ε ζ μbar κbar m M)
    (hrun : IsEnhancedRun S fs fn gi ℓ β δ ζ ε μbar κbar m M x w ihat τ κ μ)
    (hS0 : Bornology.IsBounded (FracPSG.Subseq.S0 S (FracPSG.Subseq.objF fs fn) (maxFn gi) (x 0))) :
    (∀ n, x n ∈ S ∧ FracPSG.Subseq.objF fs fn (x n) ≠ ⊤) ∧
    Antitone (lyap (FracPSG.Subseq.objF fs fn) (maxFn gi) ℓ μbar κbar m M x) ∧
    (∃ L : ℝ, Tendsto (lyap (FracPSG.Subseq.objF fs fn) (maxFn gi) ℓ μbar κbar m M x) atTop (𝓝 L)) ∧
    ∃ L : ℝ, Tendsto (fun n => FracPSG.Subseq.ratio (FracPSG.Subseq.objF fs fn) (maxFn gi) (x n)) atTop (𝓝 L) := by sorry

end FracPSG.Enhanced
