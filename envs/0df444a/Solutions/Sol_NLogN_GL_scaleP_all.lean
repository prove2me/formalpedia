theorem flatMap_genc (L : List (ℤ × ℤ)) : L.flatMap genc = gints L := rfl

theorem flatMap_ienc (L : List ℤ) : L.flatMap ienc = ints L := by
  induction L with
  | nil => rfl
  | cons a L ih => simp [ienc, ints] at ih ⊢; exact ih

theorem gints_eq_ints (L : List (ℤ × ℤ)) : gints L = ints (pairInts L) := by
  induction L with
  | nil => rfl
  | cons a L ih => simp [pairInts, ints] at ih ⊢; exact ih

theorem gints_rev (L : List (ℤ × ℤ)) : (gints L).reverse = ints (pairInts L).reverse := by
  rw [gints_eq_ints, ints_reverse]

theorem pairInts_length (L : List (ℤ × ℤ)) : (pairInts L).length = 2 * L.length := by
  induction L with
  | nil => rfl
  | cons a L ih => simp [pairInts] at ih ⊢; omega

theorem GB_pairInts {B : ℕ} {L : List (ℤ × ℤ)} (h : GB B L) : ∀ x ∈ pairInts L, zsz x ≤ B := by
  intro x hx
  simp only [pairInts, List.mem_flatMap, List.mem_cons, List.not_mem_nil, or_false] at hx
  obtain ⟨z, hz, h1 | h1⟩ := hx <;> subst h1
  · exact (h z hz).1
  · exact (h z hz).2

end NLogN.GL

