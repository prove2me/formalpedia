theorem solution (p : ℕ) [Fact p.Prime]
    (hcomm : HeckeOperatorsCommuteBar p)
    (ℓ : ℕ) (hℓp : ℓ.Prime) (hℓ : ℓ ≠ p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime ℓ) :
    letI := heckeModuleBar p
    ∃ _ : Module HeckeAlg (Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) p)),
    ∃ D : JZeroGoodReductionSpecialization A ℓ hℓp p,
      TorsBijFor ℓ D.sp ∧
      FTorsionFor (Pic0 (ResidueField A) (modularFunctionFieldC (ResidueField A) p)) ∧
      RaynaudFor ℓ D.sp ∧ CuspRuleFor A D.sp := by
  classical
  letI := heckeModuleBar p
  haveI : Fact ℓ.Prime := ⟨hℓp⟩
  haveI : NeZero ℓ := ⟨hℓp.ne_zero⟩
  haveI : CharP (ResidueField A) ℓ := ValuationSubring.charP_residueField_of_liesOverPrime_def hℓp hA
  have hp : p.Prime := Fact.out
  have hℓN : ¬ ℓ ∣ p := fun h => hℓ ((Nat.prime_dvd_prime_iff_eq hℓp hp).1 h)
  haveI : IsCurveOver (ResidueField A) (modularFunctionFieldC (ResidueField A) p) :=
    haveI : PerfectField (ResidueField A) := IsAlgClosed.perfectField _
    ModularCurve.isCurveOver_modularFunctionFieldC_of_perfectField (ResidueField A) p

  obtain ⟨data⟩ := ModularCurve.nonempty_modularPolynomialData ℓ
  have hKr : KroneckerCongruence ℓ data := ModularCurve.kroneckerCongruence ℓ data

  have dataAll : ∀ (d : ℕ) [NeZero d], d ∣ p → ModularPolynomialData d :=
    fun d _ _ => Classical.choice (ModularCurve.nonempty_modularPolynomialData d)
  have hsq : Squarefree p := hp.squarefree
  have hsym : EvalSymm (dataAll p (dvd_refl p)).Φ :=
    ModularCurve.ModularPolynomialData.evalSymm_of_prime p (dataAll p (dvd_refl p))

  haveI : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.isAlgebraic ℚ
  have hsep : (((dataAll p (dvd_refl p)).Φ.map
        (Polynomial.mapRingHom (Int.castRingHom (ResidueField ↥A)))).map
      (algebraMap (Polynomial (ResidueField ↥A)) (RatFunc (ResidueField ↥A)))).Separable :=
    separable_map_ratFunc_of_ringHom (ValuationSubring.residueFieldEquivAlgebraicClosure A hA).toRingHom
      (dataAll p (dvd_refl p)).Φ
      (ModularCurve.ModularPolynomialData.separable_map_ratFunc_of_prime_of_not_dvd p (dataAll p (dvd_refl p)) ℓ hℓN)

  obtain ⟨fm, cc, hnorFin, hnorInf⟩ :=
    ModularCurve.CharPModel.exists_fibreModel_cuspChart_integrallyClosed_of_prime p ℓ hℓ A hA
  have hinp : ReductionInputsModL A p := ModularCurve.reductionInputsModL_of_not_dvd p hℓN A hA
  have hCF : modularFunctionFieldC (ResidueField ↥A) p = modularFunctionFieldFullC (ResidueField ↥A) p :=
    ModularCurve.modularFunctionFieldC_eq_modularFunctionFieldFullC (ResidueField ↥A) ℓ p hℓN
  have hpres : fm.SpDivPreservesPrincipal Ideal.Quotient.mk_surjective dataAll hsep :=
    ModularCurve.CharPModel.FibreModel.spDiv_preservesPrincipal_of_reductionInputs p ℓ A hℓN fm cc dataAll
      hsep hinp hCF

  obtain ⟨inst, D, hsp, -⟩ :=
    ModularCurve.CharPModel.FibreModel.exists_jZeroGoodReductionSpecialization_sp_eq_spPic0_of_prime
      p hp hcomm ℓ hℓN A hA fm cc dataAll hsep hpres hsq hsym data hKr
  refine ⟨inst, D, ?_, ?_, ?_, ?_⟩
  · exact ModularCurve.JZeroGoodReductionSpecialization.torsBijFor_of_charP_of_not_dvd hℓN D
  · exact ModularCurve.fTorsionFor_pic0_residueField_modularFunctionFieldC ℓ hℓp A hA p
  ·
    by_cases hℓ2 : ℓ = 2
    · intro h2; exact absurd hℓ2 h2
    · rw [hsp]
      exact ModularCurve.raynaudFor_of_le_finiteFlat_model_eisensteinQuotient p hcomm ℓ A hA _
        (ModularCurve.CharPModel.FibreModel.exists_le_finiteFlat_model_eisensteinQuotient_torsion_spPic0_of_ne_two
          p hcomm ℓ hℓN hℓ2 A hA fm cc dataAll hsep hpres)
  ·
    have hα := ModularCurve.heckeAlphaBarIntegral_of_prime (AlgebraicClosure ℚ) p ℓ
    have hβ := ModularCurve.heckeBetaBarIntegral_of_prime (AlgebraicClosure ℚ) p ℓ
    obtain ⟨S, -, hS⟩ :=
      ModularCurve.CharPModel.FibreModel.exists_placeSpecialization_spPic0_eq_of_prime
        p hp ℓ hℓN A hA fm cc dataAll hsep hpres hsq hsym data hKr hα hβ
    rw [hsp, ← hS]
    exact ModularCurve.PlaceSpecialization.cuspRuleFor A ℓ p hp hℓ data hKr
      (ResidueField A) (IsLocalRing.residue A) hα hβ S

