-- Source module: Solutions.KFDFok
/-!
# KFD: fine compilability (`fok`) of the uniform level steps

`fok p = true` is the side condition of `FSp.irun`: loop counters are not touched by their
bodies and avoid the `toUL` scratch stacks.  Proved for every `stepsU m rX Ts` (all templates).
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel AModelL12

theorem touch_sel_mem (r : Fin HS) (br : ℕ → RS) :
    ∀ k m, ∀ x ∈ touch (sel r br k m), x = r ∨ ∃ v, x ∈ touch (br v)
  | _, 0 => fun x hx => by simp [sel, touch] at hx
  | k, 1 => fun x hx => Or.inr ⟨k, by simpa [sel] using hx⟩
  | k, m + 2 => fun x hx => by
    simp only [sel, touch, List.mem_append] at hx
    rcases hx with hx | hx | hx
    · left; simpa [Ex.regs] using hx
    · exact Or.inr ⟨k, hx⟩
    · exact touch_sel_mem r br (k + 1) (m + 1) x hx

theorem fok_sel (r : Fin HS) (br : ℕ → RS) (h : ∀ v, fok (br v) = true) :
    ∀ k m, fok (sel r br k m) = true
  | _, 0 => by simp [sel, fok]
  | k, 1 => by simpa [sel] using h k
  | k, m + 2 => by
    simp only [sel, fok, Bool.and_eq_true]
    exact ⟨h k, fok_sel r br h (k + 1) (m + 1)⟩

theorem not_contains_of {l : List (Fin HS)} {x : Fin HS} (h : x ∉ l) : l.contains x = false := by
  simpa using h

theorem fok_mvK_eq (X Y C : Fin HS) (n : Ex HS) :
    fok (NLogN.mvK X Y C n) = (!([Y, X, X].contains C) && !(scr.contains C)) := by
  simp [NLogN.mvK, fok, touch, Ex.regs]

theorem touch_mvK (X Y C : Fin HS) (n : Ex HS) :
    touch (NLogN.mvK X Y C n) = C :: (n.regs ++ (Y :: X :: [X])) := by
  simp [NLogN.mvK, touch, Ex.regs]

/-! ## Gather / scatter -/

theorem touch_brGT (r c j : ℕ) (eB : Ex HS) (v : ℕ) :
    ∀ x ∈ touch (brGT r c j eB v), x ∈ eB.regs ∨ x ∈ ([33, 0, 12, 10] : List (Fin HS)) := by
  intro x hx
  unfold brGT at hx
  split_ifs at hx <;> simp [touch_mvK, touch] at hx <;> simp <;> tauto

theorem touch_brST (r c j : ℕ) (eB : Ex HS) (v : ℕ) :
    ∀ x ∈ touch (brST r c j eB v), x ∈ eB.regs ∨ x ∈ ([33, 10, 11, 0] : List (Fin HS)) := by
  intro x hx
  unfold brST at hx
  split_ifs at hx <;> simp [touch_mvK, touch] at hx <;> simp <;> tauto

theorem fok_brGT (r c j : ℕ) (eB : Ex HS) (v : ℕ) : fok (brGT r c j eB v) = true := by
  unfold brGT; split_ifs
  · rfl
  · rw [fok_mvK_eq]; decide
  · rw [fok_mvK_eq]; decide

theorem fok_brST (r c j : ℕ) (eB : Ex HS) (v : ℕ) : fok (brST r c j eB v) = true := by
  unfold brST; split_ifs
  · rw [fok_mvK_eq]; decide
  · rw [fok_mvK_eq]; decide
  · rfl

theorem touch_bodyGT (r c j : ℕ) (eB : Ex HS) :
    ∀ x ∈ touch (bodyGT r c j eB), x ∈ eB.regs ∨ x ∈ ([13, 33, 0, 12, 10] : List (Fin HS)) := by
  intro x hx
  simp only [bodyGT, touch, List.mem_append] at hx
  rcases hx with hx | hx
  · rcases touch_sel_mem 13 _ 0 c x hx with h | ⟨v, hv⟩
    · right; simp [h]
    · rcases touch_brGT r c j _ v x hv with h | h
      · exact Or.inl h
      · right; simp at h ⊢; tauto
  · right; simp [touch, mAdd, Ex.regs] at hx ⊢; tauto

theorem touch_bodyST (r c j : ℕ) (eB : Ex HS) :
    ∀ x ∈ touch (bodyST r c j eB), x ∈ eB.regs ∨ x ∈ ([13, 33, 10, 11, 0] : List (Fin HS)) := by
  intro x hx
  simp only [bodyST, touch, List.mem_append] at hx
  rcases hx with hx | hx
  · rcases touch_sel_mem 13 _ 0 c x hx with h | ⟨v, hv⟩
    · right; simp [h]
    · rcases touch_brST r c j _ v x hv with h | h
      · exact Or.inl h
      · right; simp at h ⊢; tauto
  · right; simp [touch, mAdd, Ex.regs] at hx ⊢; tauto

theorem fok_bodyGT (r c j : ℕ) (eB : Ex HS) : fok (bodyGT r c j eB) = true := by
  simp [bodyGT, fok, fok_sel 13 _ (fok_brGT r c j eB) 0 c]

theorem fok_bodyST (r c j : ℕ) (eB : Ex HS) : fok (bodyST r c j eB) = true := by
  simp [bodyST, fok, fok_sel 13 _ (fok_brST r c j eB) 0 c]

theorem nmem_of_cover {l : List (Fin HS)} {S : List (Fin HS)} {x : Fin HS}
    (h : ∀ y ∈ l, y ∈ S) (hx : x ∉ S) : l.contains x = false :=
  not_contains_of (fun h' => hx (h x h'))

theorem touch_passGU (r c j : ℕ) :
    ∀ x ∈ touch (passGU r c j), x ∈ ([sCN, sQQ, sPC, 13, 31, 33, 0, 12, 10] : List (Fin HS)) := by
  intro x hx
  simp only [passGU, passGT, touch, List.mem_append, List.mem_cons, cntE, Ex.regs,
    List.not_mem_nil, or_false, touch_mvK, List.append_nil, List.nil_append] at hx
  have hB := touch_bodyGT r c j (.reg sPC) x
  simp only [Ex.regs, List.mem_cons, List.not_mem_nil, or_false] at hB
  simp only [List.mem_cons, List.not_mem_nil, or_false]
  tauto

theorem touch_passSU (r c j : ℕ) :
    ∀ x ∈ touch (passSU r c j), x ∈ ([sCN, sQQ, sPC, 13, 31, 33, 10, 11, 0] : List (Fin HS)) := by
  intro x hx
  simp only [passSU, passST, touch, List.mem_append, List.mem_cons, cntE, Ex.regs,
    List.not_mem_nil, or_false, touch_mvK, List.append_nil, List.nil_append] at hx
  have hB := touch_bodyST r c j (.reg sPC) x
  simp only [Ex.regs, List.mem_cons, List.not_mem_nil, or_false] at hB
  simp only [List.mem_cons, List.not_mem_nil, or_false]
  tauto

theorem fok_passGU (r c j : ℕ) : fok (passGU r c j) = true := by
  have hb : (touch (bodyGT r c j (.reg sPC))).contains 31 = false :=
    nmem_of_cover (S := [sPC, 13, 33, 0, 12, 10]) (fun y hy => by
      rcases touch_bodyGT r c j _ y hy with h | h <;> simp [Ex.regs] at h ⊢ <;> tauto) (by decide)
  simp only [passGU, passGT, fok, Bool.and_eq_true, hb, fok_bodyGT, fok_mvK_eq]
  decide

theorem fok_passSU (r c j : ℕ) : fok (passSU r c j) = true := by
  have hb : (touch (bodyST r c j (.reg sPC))).contains 31 = false :=
    nmem_of_cover (S := [sPC, 13, 33, 10, 11, 0]) (fun y hy => by
      rcases touch_bodyST r c j _ y hy with h | h <;> simp [Ex.regs] at h ⊢ <;> tauto) (by decide)
  simp only [passSU, passST, fok, Bool.and_eq_true, hb, fok_bodyST, fok_mvK_eq]
  decide

theorem touch_passesGU (r c : ℕ) : ∀ k, ∀ x ∈ touch (passesGU r c k),
    x ∈ ([sCN, sQQ, sPC, 13, 31, 33, 0, 12, 10] : List (Fin HS))
  | 0 => fun x hx => by simp [passesGU, touch] at hx
  | k + 1 => fun x hx => by
    simp only [passesGU, touch, List.mem_append] at hx
    rcases hx with hx | hx
    · exact touch_passesGU r c k x hx
    · exact touch_passGU r c k x hx

theorem touch_passesSU (r c : ℕ) : ∀ k, ∀ x ∈ touch (passesSU r c k),
    x ∈ ([sCN, sQQ, sPC, 13, 31, 33, 10, 11, 0] : List (Fin HS))
  | 0 => fun x hx => by simp [passesSU, touch] at hx
  | k + 1 => fun x hx => by
    simp only [passesSU, touch, List.mem_append] at hx
    rcases hx with hx | hx
    · exact touch_passesSU r c k x hx
    · exact touch_passSU r c k x hx

theorem fok_passesGU (r c : ℕ) : ∀ k, fok (passesGU r c k) = true
  | 0 => rfl
  | k + 1 => by simp [passesGU, fok, fok_passesGU r c k, fok_passGU]

theorem fok_passesSU (r c : ℕ) : ∀ k, fok (passesSU r c k) = true
  | 0 => rfl
  | k + 1 => by simp [passesSU, fok, fok_passesSU r c k, fok_passSU]

theorem fok_divPgR (r c : ℕ) : fok (divPgR r c) = true := by
  have hb : (touch (passesGU r c c)).contains 30 = false :=
    nmem_of_cover (touch_passesGU r c c) (by decide)
  simp only [divPgR, fok, Bool.and_eq_true, hb, fok_passesGU, fok_mvK_eq]
  decide

theorem fok_mulPgR (r c : ℕ) : fok (mulPgR r c) = true := by
  have hb : (touch (blkSU r c)).contains 30 = false := by
    refine nmem_of_cover (S := [sCN, sQQ, sPC, 13, 31, 33, 10, 11, 0, 12, sQB]) (fun y hy => ?_)
      (by decide)
    simp only [blkSU, touch, List.mem_append, touch_mvK, Ex.regs, List.mem_cons,
      List.not_mem_nil, or_false] at hy
    rcases hy with hy | hy
    · have := touch_passesSU r c c y hy
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this ⊢; tauto
    · simp only [List.mem_cons, List.not_mem_nil, or_false, List.nil_append] at hy ⊢; tauto
  have hf : fok (blkSU r c) = true := by
    simp only [blkSU, fok, Bool.and_eq_true, fok_passesSU, fok_mvK_eq]; decide
  simp only [mulPgR, fok, Bool.and_eq_true, hb, hf, fok_mvK_eq]
  decide

theorem fok_fdivPU (d : ℕ) : fok (fdivPU d) = true := by
  unfold fdivPU; split_ifs
  · rfl
  · simp [divPgU, fok, fok_sel sRR _ (fun r => fok_divPgR r d) 0 d]

theorem fok_fmulPU (k : ℕ) : fok (fmulPU k) = true := by
  unfold fmulPU; split_ifs
  · rfl
  · simp [mulPgU, resSel, fok, fok_sel sRR _ (fun r => fok_mulPgR r k) 0 k]

/-! ## Table generator, rotations -/

theorem fok_stageU : fok stageU = true := by
  simp +decide [stageU, gStageT, gBodyT, gInnerT, mAddT, fok, touch, scr, NLogN.mvK, Ex.regs,
    KFC.uK, KFC.uR, KFC.uY, KFC.uB]

theorem fok_genPU (n : ℕ) : fok (genPU n) = true := by
  have : ∀ n, fok (stagesU n) = true := by
    intro n; induction n with
    | zero => rfl
    | succ n ih => simp [stagesU, fok, fok_stageU, ih]
  simp [genPU, fok, this]

theorem fok_rotP : fok rotP = true := by
  simp +decide [rotP, rBlk, qma, fok, touch, scr, NLogN.mvK, Ex.regs,
    KFC.uK, KFC.uR, KFC.uY, KFC.uB]

theorem fok_negP : fok KIL.negP = true := by
  simp +decide [KIL.negP, nBlk, dmv, a1E, qa1E, fok, touch, scr, NLogN.mvK, Ex.regs,
    KFC.uK, KFC.uR, KFC.uY, KFC.uB]

theorem fok_shPU (n : ℕ) : fok (shPU n) = true := by
  simp [shPU, fok, fok_genPU, fok_rotP]

theorem fok_shNU (n : ℕ) : fok (shNU n) = true := by
  simp [shNU, fok, fok_genPU, fok_negP]

theorem fok_pushes : ∀ l : List (Fin HS × Ex HS), fok (pushes l) = true
  | [] => rfl
  | (i, e) :: l => by simp [pushes, fok, fok_pushes l]

theorem fok_popsR : ∀ l : List (Fin HS), fok (popsR l) = true
  | [] => rfl
  | i :: l => by simp [popsR, fok, fok_popsR l]

theorem fok_stepU (m : ℕ) (rX : Fin HS) (T : TSh m) : fok (stepU m rX T) = true := by
  unfold stepU stepG shFracU
  cases T.neg <;> simp [fok, fok_pushes, fok_popsR, fok_fdivPU, fok_fmulPU, fok_shPU, fok_shNU]

