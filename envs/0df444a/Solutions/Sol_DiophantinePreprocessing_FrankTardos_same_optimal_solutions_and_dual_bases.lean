    (hspan : x ∈ Submodule.span ℝ (Set.range (integerRows C)))
    (hb : ∀ i, inner ℝ (integerRows C i) x = (b i : ℝ)) :
    ∀ j, (adjugatePoint C b j : ℝ) = ((integerGram C).det : ℝ) * x j := by
