theorem Formalism.HermitianLattices.Ext.L3.integralBasisSpans.nkCount_free (h : V →ₗ⋆[K] V →ₗ[K] K) (b : Basis κ K V) {H : Matrix κ κ (𝓞 K)}
    (hH : ∀ i j, algebraMap (𝓞 K) K (H i j) = h (b i) (b j)) {𝔭 : Ideal (𝓞 F)} (h𝔭 : 𝔭.IsMaximal)
    (k : ℕ) (n : 𝓞 F) :
    nkCount h (spanO b) 𝔭 k n = Nat.card {x : κ → 𝓞 K ⧸ extP K 𝔭 ^ k //
      star x ⬝ᵥ (H.map (Ideal.Quotient.mk (extP K 𝔭 ^ k)) *ᵥ x) = Ideal.Quotient.mk _ (ι n)} := by sorry
