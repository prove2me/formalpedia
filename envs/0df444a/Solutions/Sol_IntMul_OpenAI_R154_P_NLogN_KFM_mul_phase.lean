  have eF : t4.upd 0 (NLogN.ints (NLogN.KFB.gflat zsZ)) = ((t.upd NLogN.ARGM []).upd NLogN.KFM.pW []).upd 0 (NLogN.ints (NLogN.KFB.gflat zsZ)) := by
    rw [ht4, ht3, ht2]; exact IntMul.OpenAI.R154.P.NLogN.KFM.st_mul _ _ _ _ _ _ _ _ _
  rw [eF] at r6
  refine ⟨zsZ, Z, Ux, Uy, _, r1.seq (r2.seq (r3.seq (r4.seq (r5.seq r6)))), hZ, gZ, eZ, eX, eY, ?_⟩
  -- cost
  have hlY2 : (NLogN.KFB.gflat zsY).length = 2 ^ (IntMul.OpenAI.Glue.LP n + 1) := by exact_mod_cast hlY
  have e2' : 2 * NLogN.KFM.cMvN (NLogN.KFB.gflat zsY).length (IntMul.OpenAI.R154.P.NLogN.KFM.wU n D) = 2 * NLogN.KFM.cMvN (2 ^ (IntMul.OpenAI.Glue.LP n + 1)) (IntMul.OpenAI.R154.P.NLogN.KFM.wU n D) := by
    rw [hlY2]
  have e4 : zsX.length * (4 * NLogN.KFM.fmB (2 * IntMul.OpenAI.R154.P.NLogN.KFM.wU n D)) + 10 ^ 6 * (zsX.length + 1) * (IntMul.OpenAI.R154.P.NLogN.KFM.wU n D + IntMul.OpenAI.Glue.pP n + 1) +
      2 * NLogN.KFM.cCnt (2 * zsX.length) + NLogN.KFM.cW (2 ^ IntMul.OpenAI.Glue.pP n) + NLogN.KFM.cW ((2 * zsX.length : ℕ) : ℤ) +
      NLogN.KFM.cW (zsX.length : ℤ) = IntMul.OpenAI.R154.P.NLogN.KFM.kGm n D := by
    unfold IntMul.OpenAI.R154.P.NLogN.KFM.kGm; rw [hlX]
  have e5 : NLogN.KFM.cConj zM.length (IntMul.OpenAI.Glue.pP n + 1) + NLogN.KFM.cW ((2 * zM.length : ℕ) : ℤ) + NLogN.KFM.cW (zM.length : ℤ) =
      NLogN.KFM.kCj n (IntMul.OpenAI.Glue.pP n + 1) := by
    unfold NLogN.KFM.kCj; rw [hlM]
  rw [e2', e4, e5]
  unfold IntMul.OpenAI.R154.P.NLogN.KFM.kMul IntMul.OpenAI.R154.P.NLogN.KFM.kFt
