              (∀ x : NeronModelInfra.SchemeHomOver (CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f,
                CerednikDrinfeld.QM.FactorsThrough (K i).levK x ↔ CerednikDrinfeld.QM.FactorsThrough (K j).levK x) → i = j) ∧
          (∀ i : Fin (ℓ + 1),
              CerednikDrinfeld.QM.FakeEllipticCurve.IsLevelIsogeny ℓ
                (⟨E, K i⟩ : CerednikDrinfeld.QM.FakeEllipticCurve.WithExtraLevel Λ N ℓ (AlgebraicClosure ℚ)) (d i)) ∧
          M.corrBar ℓ hℓ (Finsupp.single P 1) =
            Finset.univ.sum (fun i : Fin (ℓ + 1) => Finsupp.single (w.pts.symm (w.pt _ w.sbar (d i))) 1))

    [hXint : AlgebraicGeometry.IsIntegral w.X]
    (hpts : ∃ (𝔐 : AlgebraicCurve.CurveModel (AlgebraicClosure ℚ) M.Fbar)
        (e𝔐 : Quiver.Hom 𝔐.C (CategoryTheory.Limits.pullback w.πX w.sbar)) (_ : CategoryTheory.IsIso e𝔐),
        CategoryTheory.CategoryStruct.comp e𝔐 (CategoryTheory.Limits.pullback.snd w.πX w.sbar) = 𝔐.toBase ∧
        (∀ x : {p : Quiver.Hom (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ℚ))) 𝔐.C //
            CategoryTheory.CategoryStruct.comp p 𝔐.toBase =
              CategoryTheory.CategoryStruct.id (AlgebraicGeometry.Spec (CommRingCat.of (AlgebraicClosure ℚ)))},
          (w.pts (𝔐.pointEquivPlace x)).1 =
            CategoryTheory.CategoryStruct.comp x.1
              (CategoryTheory.CategoryStruct.comp e𝔐 (CategoryTheory.Limits.pullback.fst w.πX w.sbar))) ∧
        (∀ (U : w.X.Opens) [Nonempty (AlgebraicGeometry.Scheme.Opens.toScheme U)]
          [Nonempty (AlgebraicGeometry.Scheme.Opens.toScheme
            ((TopologicalSpace.Opens.map
              (CategoryTheory.CategoryStruct.comp e𝔐 (CategoryTheory.Limits.pullback.fst w.πX w.sbar)).base).obj U))]
          (t : w.X.presheaf.obj (Opposite.op U)),
          𝔐.ffEquiv.symm (𝔐.C.germToFunctionField
            ((TopologicalSpace.Opens.map
              (CategoryTheory.CategoryStruct.comp e𝔐 (CategoryTheory.Limits.pullback.fst w.πX w.sbar)).base).obj U)
            (((CategoryTheory.CategoryStruct.comp e𝔐 (CategoryTheory.Limits.pullback.fst w.πX w.sbar)).app U).hom t)) =
          M.toBar (w.eF.symm (w.X.germToFunctionField U t))))

    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓS : ¬ ℓ ∣ D)
    (𝔅 : ValuationSubring (AlgebraicClosure ℚ)) (h𝔅ℓ : 𝔅.LiesOverPrime ℓ)
    (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) (hσD : σ ∈ 𝔅.decompositionSubgroup ℚ)
    (hFrob : ∀ x : IsLocalRing.ResidueField ↥𝔅, (⟨σ, hσD⟩ : ↥(𝔅.decompositionSubgroup ℚ)) • x = x ^ ℓ)

    (s𝔅 : Spec (CommRingCat.of ↥𝔅) ⟶ Spec (CommRingCat.of (Localization.Away ((D : ℕ) : ℤ))))
    (hs𝔅 : Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ s𝔅 = w.sbar)
    (K : Type) [Field K] [Algebra (IsLocalRing.ResidueField ↥𝔅) K]
    (𝓡 : ConstantReduction 𝔅 M.Fbar K)
    (ptsk : Place (IsLocalRing.ResidueField ↥𝔅) K ≃
      SchemeHomOver (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) ≫ s𝔅) w.πX)
    (galk : ↥(𝔅.decompositionSubgroup ℚ) →* SemilinearAut (IsLocalRing.ResidueField ↥𝔅) K)
    (hliftX : ∀ P : Place (AlgebraicClosure ℚ) M.Fbar, ∃! Pt : SchemeHomOver s𝔅 w.πX,
      (w.pts P).1 = Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ Pt.1)
    (hred : ∀ (P : Place (AlgebraicClosure ℚ) M.Fbar) (Pt : SchemeHomOver s𝔅 w.πX),
      (w.pts P).1 = Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ Pt.1 →
      (ptsk (𝓡.placeMap P)).1 = Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) ≫ Pt.1)
    (hgalk : ∀ (s : ↥(𝔅.decompositionSubgroup ℚ)) (Q : Place (IsLocalRing.ResidueField ↥𝔅) K),
      (ptsk (galk s • Q)).1 =
        Spec.map (CommRingCat.ofHom (MulSemiringAction.toRingHom (↥(𝔅.decompositionSubgroup ℚ))
          (IsLocalRing.ResidueField ↥𝔅) s)) ≫ (ptsk Q).1) :
    ∀ P : Place (AlgebraicClosure ℚ) M.Fbar,
      Finsupp.mapDomain 𝓡.placeMap (M.corrBar ℓ hℓ (Finsupp.single P 1)) =
        Finsupp.single (galk ⟨σ, hσD⟩ • 𝓡.placeMap P) 1 +
          ℓ • Finsupp.single ((galk ⟨σ, hσD⟩)⁻¹ • 𝓡.placeMap P) 1 := by
  have hNqqD : N * q * q' ∣ D := Dvd.dvd.trans (Dvd.intro 2 (by ring)) hD
  have hℓNqq : ¬ ℓ ∣ N * q * q' := fun h => hℓS (Dvd.dvd.trans h hNqqD)

  intro P
  classical
  haveI : Fact ℓ.Prime := ⟨hℓ⟩

  haveI hkac : IsAlgClosed (IsLocalRing.ResidueField ↥𝔅) :=
    ValuationSubring.isAlgClosed_residueField_of_isAlgClosed 𝔅
  haveI hkch : CharP (IsLocalRing.ResidueField ↥𝔅) ℓ :=
    ValuationSubring.residueField_charP_of_liesOverPrime 𝔅 hℓ h𝔅ℓ
  have hfrobσ : MulSemiringAction.toRingHom (↥(𝔅.decompositionSubgroup ℚ)) (IsLocalRing.ResidueField ↥𝔅) ⟨σ, hσD⟩
      = frobenius (IsLocalRing.ResidueField ↥𝔅) ℓ := by
    ext x
    rw [MulSemiringAction.toRingHom_apply, hFrob x, frobenius_def]

  obtain ⟨E, hE⟩ := w.pt_surjective (AlgebraicClosure ℚ) w.sbar (w.pts P)

  obtain ⟨Kx, d, hKdist, hKd, hcorr⟩ := hmult ℓ hℓ hℓS P E hE

  set Q : Fin (ℓ + 1) → Place (AlgebraicClosure ℚ) M.Fbar := fun i => w.pts.symm (w.pt _ w.sbar (d i)) with hQ
  have hLHS : Finsupp.mapDomain 𝓡.placeMap (M.corrBar ℓ hℓ (Finsupp.single P 1))
      = Finset.univ.sum (fun i : Fin (ℓ + 1) => Finsupp.single (𝓡.placeMap (Q i)) 1) := by
    rw [hcorr, Finsupp.mapDomain_finsetSum]
    simp only [Finsupp.mapDomain_single, hQ]
  rw [hLHS]

  have hu : IsUnit ((((N * q * q' : ℕ) : ℤ)) : ↥𝔅) := by
    have hℓmax : ((ℓ : ℕ) : ↥𝔅) ∈ IsLocalRing.maximalIdeal ↥𝔅 := by
      rw [← ValuationSubring.coe_mem_nonunits_iff]; first | simpa using h𝔅ℓ | (have h_1 := h𝔅ℓ; simp at h_1; exact h_1) | (have h_1 := h𝔅ℓ; simp at h_1 ⊢; exact h_1) | exact (h𝔅ℓ)
    have hℓnu : ¬ IsUnit ((ℓ : ℕ) : ↥𝔅) := (IsLocalRing.mem_maximalIdeal _).mp hℓmax
    have hcop : IsCoprime ((ℓ : ℕ) : ℤ) ((N * q * q' : ℕ) : ℤ) :=
      Nat.isCoprime_iff_coprime.mpr ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr hℓNqq)
    obtain ⟨u, v, huv⟩ := hcop
    have huv' : (u : ↥𝔅) * ((ℓ : ℕ) : ↥𝔅) + (v : ↥𝔅) * ((((N * q * q' : ℕ) : ℤ)) : ↥𝔅) = 1 := by
      have := congrArg (Int.cast : ℤ → ↥𝔅) huv
      push_cast at this ⊢
      exact this
    rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add (huv' ▸ isUnit_one) with h | h
    · exact absurd (isUnit_of_mul_isUnit_right h) hℓnu
    · exact isUnit_of_mul_isUnit_right h
  obtain ⟨𝒜, K𝒜, hK𝒜fd, ι𝒜, hι𝒜, 𝒜₀, ⟨gE, hgE, hgE_mul, hgE_act, hgE_lev⟩, h𝒜₀, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_valuationSubring_of_isUnit_with_numberField_model hqN hq'N hqq' hB Λ hΛ 𝔅 hu E
  have hgE_lev' := @CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_of_exists_comp_eq_of_isPullback
    _ _ _ _ _ _ _ _ 𝔅.subtype 𝒜 E gE hgE hgE_mul hgE_lev
  have h𝒟ex := fun i => CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_valuationSubring_of_isUnit_with_numberField_model hqN hq'N hqq' hB Λ hΛ 𝔅 hu (d i)
  choose 𝒟 K𝒟 hK𝒟fd ι𝒟 hι𝒟 𝒟₀ h𝒟 h𝒟₀ h𝒟₀E using h𝒟ex

  obtain ⟨Abar, gbar, hgbar, hgbar_mul, hgbar_act, hgbar_lev, hgbar_lev'⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (IsLocalRing.residue ↥𝔅) 𝒜

  let RedZero : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f → Prop := fun x =>
    ∃ xt : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥𝔅))) 𝒜.f,
      Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ xt.1 = x.1 ≫ gE ∧
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) ≫ xt.1 =
        (Abar.L.one (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥𝔅))))).1 ≫ gbar
  let Z : Fin (ℓ + 1) → Prop := fun i =>
    ∀ x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f, CerednikDrinfeld.QM.FactorsThrough (Kx i).levK x → RedZero x

  have hPbar : (ptsk (𝓡.placeMap P)).1 =
      (w.pt (IsLocalRing.ResidueField ↥𝔅) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) ≫ s𝔅) Abar).1 := by
    have h1 := w.pt_pullback (↥𝔅) (AlgebraicClosure ℚ) 𝔅.subtype s𝔅 w.sbar hs𝔅 𝒜 E ⟨gE, hgE, hgE_mul, hgE_act, hgE_lev⟩
    have h2 : (w.pts P).1 = Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ (w.pt (↥𝔅) s𝔅 𝒜).1 := by rw [← hE]; exact h1
    rw [hred P _ h2]
    exact (w.pt_pullback (↥𝔅) (IsLocalRing.ResidueField ↥𝔅) (IsLocalRing.residue ↥𝔅) s𝔅 _ rfl 𝒜 Abar
      ⟨gbar, hgbar, hgbar_mul, hgbar_act, hgbar_lev⟩).symm

  have hclass : ∀ i : Fin (ℓ + 1),
      (Z i → 𝓡.placeMap (Q i) = galk ⟨σ, hσD⟩ • 𝓡.placeMap P) ∧
      (¬ Z i → 𝓡.placeMap (Q i) = (galk ⟨σ, hσD⟩)⁻¹ • 𝓡.placeMap P) := by
    intro i

    have hℓN : ¬ ℓ ∣ N := fun h => hℓNqq (Dvd.dvd.mul_right (Dvd.dvd.mul_right h q) q')
    have hℓNc : Nat.Coprime ℓ N := (Nat.Prime.coprime_iff_not_dvd hℓ).mpr hℓN
    have hℓq : ℓ ≠ q := by
      rintro rfl; exact hℓNqq ⟨N * q', by ring⟩
    have hℓq' : ℓ ≠ q' := by
      rintro rfl; exact hℓNqq ⟨N * q, by ring⟩
    have hℓΛ : ((ℓ : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by
      have h1 := Λ.smul_mem (ℓ : ℤ) hΛ.isOrder.one_mem
      have h2 : ((ℓ : ℤ) • (1 : ℍ[ℚ, a, b])) = ((ℓ : ℚ) : ℍ[ℚ, a, b]) := by
        rw [zsmul_eq_mul, mul_one]; norm_cast
      rwa [h2] at h1

    obtain ⟨gd, hgd, hgd_mul, hgd_act, hgd_lev⟩ := h𝒟 i
    have hgd_lev' := @CerednikDrinfeld.QM.FakeEllipticCurve.factorsThrough_lev_of_exists_comp_eq_of_isPullback
      _ _ _ _ _ _ _ _ 𝔅.subtype (𝒟 i) (d i) gd hgd hgd_mul hgd_lev

    haveI := hK𝒜fd
    haveI := hK𝒟fd i
    haveI hK'fd : FiniteDimensional ℚ ↥(K𝒜 ⊔ K𝒟 i) := IntermediateField.finiteDimensional_sup K𝒜 (K𝒟 i)
    have hle𝒜 : 𝔅.toSubring ⊓ K𝒜.toSubring ≤ 𝔅.toSubring ⊓ (K𝒜 ⊔ K𝒟 i).toSubring :=
      fun x hx => ⟨hx.1, (le_sup_left : K𝒜 ≤ K𝒜 ⊔ K𝒟 i) hx.2⟩
    have hle𝒟 : 𝔅.toSubring ⊓ (K𝒟 i).toSubring ≤ 𝔅.toSubring ⊓ (K𝒜 ⊔ K𝒟 i).toSubring :=
      fun x hx => ⟨hx.1, (le_sup_right : K𝒟 i ≤ K𝒜 ⊔ K𝒟 i) hx.2⟩
    let ι' : ↥(𝔅.toSubring ⊓ (K𝒜 ⊔ K𝒟 i).toSubring) →+* ↥𝔅 := Subring.inclusion inf_le_left
    have hι' : ∀ x : ↥(𝔅.toSubring ⊓ (K𝒜 ⊔ K𝒟 i).toSubring), (ι' x : AlgebraicClosure ℚ) = (x : AlgebraicClosure ℚ) := fun x => rfl
    have hι𝒜eq : ι𝒜 = ι'.comp (Subring.inclusion hle𝒜) :=
      RingHom.ext fun x => Subtype.ext (by rw [hι𝒜]; rfl)
    have hι𝒟eq : ι𝒟 i = ι'.comp (Subring.inclusion hle𝒟) :=
      RingHom.ext fun x => Subtype.ext (by rw [hι𝒟]; rfl)
    obtain ⟨𝒜₀', g𝒜₀', hg𝒜₀', hg𝒜₀'_mul, hg𝒜₀'_act, hg𝒜₀'_lev, -⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (Subring.inclusion hle𝒜) 𝒜₀
    obtain ⟨𝒟₀', g𝒟₀', hg𝒟₀', hg𝒟₀'_mul, hg𝒟₀'_act, hg𝒟₀'_lev, -⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (Subring.inclusion hle𝒟) (𝒟₀ i)
    have h𝒜₀' : CerednikDrinfeld.QM.FakeEllipticCurve.IsPullback ι' 𝒜₀' 𝒜 :=
      CerednikDrinfeld.QM.FakeEllipticCurve.isPullback_of_isPullback_comp_of_isPullback (Subring.inclusion hle𝒜) ι' 𝒜₀ 𝒜₀' 𝒜
        (hι𝒜eq ▸ h𝒜₀) ⟨g𝒜₀', hg𝒜₀', hg𝒜₀'_mul, hg𝒜₀'_act, hg𝒜₀'_lev⟩
    have h𝒟₀' : CerednikDrinfeld.QM.FakeEllipticCurve.IsPullback ι' 𝒟₀' (𝒟 i) :=
      CerednikDrinfeld.QM.FakeEllipticCurve.isPullback_of_isPullback_comp_of_isPullback (Subring.inclusion hle𝒟) ι' (𝒟₀ i) 𝒟₀' (𝒟 i)
        (hι𝒟eq ▸ h𝒟₀ i) ⟨g𝒟₀', hg𝒟₀', hg𝒟₀'_mul, hg𝒟₀'_act, hg𝒟₀'_lev⟩
    obtain ⟨𝒦, h𝒦gen, h𝒦d⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_extraLevel_isLevelIsogeny_of_isPullback_valuationSubring_of_coprime_of_one_mem_of_isPullback_inf
        𝔅 ℓ hℓNc hℓΛ hΛ.isOrder.one_mem 𝒜 (𝒟 i) E (d i) (K𝒜 ⊔ K𝒟 i) ι' hι' 𝒜₀' 𝒟₀' h𝒜₀' h𝒟₀'
        gE hgE hgE_mul hgE_act (fun t' P => ⟨hgE_lev t' P, hgE_lev' t' P⟩)
        gd hgd hgd_mul hgd_act (fun t' P => ⟨hgd_lev t' P, hgd_lev' t' P⟩) (Kx i) (hKd i)

    obtain ⟨Dbar, gdbar, hgdbar, hgdbar_mul, hgdbar_act, hgdbar_lev, hgdbar_lev'⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (IsLocalRing.residue ↥𝔅) (𝒟 i)
    obtain ⟨Kbar, hKbar_pts, hKbar_d⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_extraLevel_isLevelIsogeny_of_isPullback
        (IsLocalRing.residue ↥𝔅) ℓ ⟨𝒜, 𝒦⟩ (𝒟 i) h𝒦d Abar Dbar gbar hgbar hgbar_mul hgbar_act hgbar_lev hgbar_lev'
        gdbar hgdbar hgdbar_mul hgdbar_act hgdbar_lev hgdbar_lev'

    obtain ⟨Abarℓ, ⟨D₁⟩⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_hasFrobeniusVerschiebung_of_prime_not_dvd
      (IsLocalRing.ResidueField ↥𝔅) ℓ hℓN Abar

    have hQbar : (ptsk (𝓡.placeMap (Q i))).1 =
        (w.pt (IsLocalRing.ResidueField ↥𝔅) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) ≫ s𝔅) Dbar).1 := by
      have hQi : w.pts (Q i) = w.pt _ w.sbar (d i) := by simp only [hQ, Equiv.apply_symm_apply]
      have h1 := w.pt_pullback (↥𝔅) (AlgebraicClosure ℚ) 𝔅.subtype s𝔅 w.sbar hs𝔅 (𝒟 i) (d i) ⟨gd, hgd, hgd_mul, hgd_act, hgd_lev⟩
      have h2 : (w.pts (Q i)).1 = Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ (w.pt (↥𝔅) s𝔅 (𝒟 i)).1 := by rw [hQi]; exact h1
      rw [hred (Q i) _ h2]
      exact (w.pt_pullback (↥𝔅) (IsLocalRing.ResidueField ↥𝔅) (IsLocalRing.residue ↥𝔅) s𝔅 _ rfl (𝒟 i) Dbar
        ⟨gdbar, hgdbar, hgdbar_mul, hgdbar_act, hgdbar_lev⟩).symm

    have hbridge : Z i ↔ ∀ Pb : SchemeHomOver (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥𝔅)))) Abar.f,
        CerednikDrinfeld.QM.FactorsThrough Kbar.levK Pb →
          Pb = Abar.L.one (𝟙 (Spec (CommRingCat.of (IsLocalRing.ResidueField ↥𝔅)))) := by
      haveI hPr : IsProper 𝒜.f := 𝒜.bundle.proper
      haveI hKf : IsFinite (𝒦.levK ≫ 𝒜.f) := 𝒦.levK_finite
      haveI hKfl : Flat (𝒦.levK ≫ 𝒜.f) := 𝒦.levK_flat
      constructor
      ·
        intro hz Pb hPb
        obtain ⟨P₀, hP₀⟩ := (hKbar_pts (𝟙 _) Pb).mp hPb
        have hzbar : P₀ ≫ (𝒦.levK ≫ 𝒜.f) = Spec.map (CommRingCat.ofHom (IsLocalRing.residue ↥𝔅)) := by
          rw [← Category.assoc, hP₀, Category.assoc, hgbar.w, ← Category.assoc, Pb.2, Category.id_comp]
        obtain ⟨z, hz1, hz2⟩ :=
          AlgebraicGeometry.exists_section_comp_eq_of_finite_flat_valuationSubring 𝔅 (𝒦.levK ≫ 𝒜.f) P₀ hzbar
        have hz1' : (z ≫ 𝒦.levK) ≫ 𝒜.f = 𝟙 _ := by rw [Category.assoc]; exact hz1
        have hx₀f : (Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ z ≫ 𝒦.levK) ≫ 𝒜.f =
            𝟙 _ ≫ Spec.map (CommRingCat.ofHom 𝔅.subtype) := by
          rw [Category.assoc, Category.assoc, hz1, Category.comp_id, Category.id_comp]
        let x : SchemeHomOver (𝟙 (Spec (CommRingCat.of (AlgebraicClosure ℚ)))) E.f :=
          ⟨hgE.lift (Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ z ≫ 𝒦.levK) (𝟙 _) hx₀f, hgE.lift_snd _ _ _⟩
        have hxg : x.1 ≫ gE = Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ z ≫ 𝒦.levK := hgE.lift_fst _ _ _
        have hxK : CerednikDrinfeld.QM.FactorsThrough (Kx i).levK x :=
          (h𝒦gen (𝟙 _) x).mpr ⟨Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ z, by rw [hxg, Category.assoc]⟩
        obtain ⟨xt', hxt'1, hxt'2⟩ := hz x hxK
        have hx₀f' : (Spec.map (CommRingCat.ofHom 𝔅.subtype) ≫ z ≫ 𝒦.levK) ≫ 𝒜.f =
