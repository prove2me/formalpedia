variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices_restrictAtHeight_eq_get_of_mem_supportSubset
    (params : _root_.LIDT.MIPStarRE.LDT.Parameters) [_root_.LIDT.MIPStarRE.LDT.FieldModel params.q]
    {k : ℕ} (xs : _root_.LIDT.MIPStarRE.LDT.PointTuple params k)
    (hxs : Function.Injective xs)
    (gs : _root_.LIDT.MIPStarRE.LDT.Pasting.GHatTupleOutcome params k)
    (hEligible : _root_.LIDT.MIPStarRE.LDT.Pasting.InterpolationEligible params gs)
    {i : Fin k} (hi : i ∈ _root_.LIDT.MIPStarRE.LDT.Pasting.interpolationSupportSubset gs hEligible) :
    (_root_.LIDT.MIPStarRE.LDT.Polynomial.restrictAtHeight params
      (_root_.LIDT.MIPStarRE.LDT.Pasting.interpolateCompletedSlices params k xs gs) (xs i)).poly =
      ((gs i).get (by
        have hisup : i ∈ _root_.LIDT.MIPStarRE.LDT.Pasting.gHatTupleSupport gs :=
          _root_.LIDT.MIPStarRE.LDT.Pasting.interpolationSupportSubset_subset gs hEligible hi
        simpa [_root_.LIDT.MIPStarRE.LDT.Pasting.gHatTupleSupport] using hisup)).poly := by sorry
