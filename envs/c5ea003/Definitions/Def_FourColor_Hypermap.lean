import Mathlib.GroupTheory.Perm.Cycle.Basic
import Mathlib.Logic.Relation
import Mathlib.SetTheory.Cardinal.Finite

/-!
# Finite hypermaps for the Four Color Theorem

This Lean-native interface follows Gonthier, *A computer-checked proof of the Four Colour
Theorem* (2005), Section 5.1, PDF pp. 17–20: the triangular identity is on p. 19 and the
unnumbered Euler formula is on p. 20. The finite carrier is `Fin dartCount`, so later
minimality statements can quantify over all finite hypermaps in a single universe.

The executable reference is rocq-community/fourcolor at commit
`c1d6b1cd5288bea4b067aac13cdde3c18dffe018`, under `theories/proof/`:
`hypermap.v` (`hypermap`, `glink`, `Euler_lhs`, `Euler_rhs`), `geometry.v`
(`plainP`, `cubicP`, `bridgeless`), and `coloring.v` (`coloring`, `four_colorable`).
The Rocq convention `cancel3 edge node face` means `node (face (edge x)) = x`.

Planarity below is the exact Euler equality, without truncated subtraction or division.
Correspondence with a topological graph drawing is a separate theorem obligation.
These definitions do not assert the Four Color Theorem or checker correctness.
-/

namespace FourColor

/-- A finite dart set with three permutations satisfying the hypermap triangular identity. -/
structure Hypermap (dartCount : ℕ) where
  edge : Equiv.Perm (Fin dartCount)
  node : Equiv.Perm (Fin dartCount)
  face : Equiv.Perm (Fin dartCount)
  edge_node_face : ∀ x, node (face (edge x)) = x

namespace Hypermap

variable {dartCount : ℕ}

/-- Darts on the same face, including the starting dart even for a singleton face. -/
def SameFace (H : Hypermap dartCount) : Fin dartCount → Fin dartCount → Prop :=
  H.face.SameCycle

/-- One forward edge, node, or face step. Its generated equivalence gives components. -/
def Link (H : Hypermap dartCount) (x y : Fin dartCount) : Prop :=
  H.edge x = y ∨ H.node x = y ∨ H.face x = y

/-- The equivalence relation generated by all three hypermap permutations. -/
def SameComponent (H : Hypermap dartCount) : Fin dartCount → Fin dartCount → Prop :=
  Relation.EqvGen H.Link

/-- Number of edge orbits, counting singleton orbits as well. -/
noncomputable def edgeCount (H : Hypermap dartCount) : ℕ :=
  Nat.card (Quotient (Equiv.Perm.SameCycle.setoid H.edge))

/-- Number of node orbits, counting singleton orbits as well. -/
noncomputable def nodeCount (H : Hypermap dartCount) : ℕ :=
  Nat.card (Quotient (Equiv.Perm.SameCycle.setoid H.node))

/-- Number of face orbits, counting singleton orbits as well. -/
noncomputable def faceCount (H : Hypermap dartCount) : ℕ :=
  Nat.card (Quotient (Equiv.Perm.SameCycle.setoid H.face))

/-- Number of connected components of the dart set. -/
noncomputable def componentCount (H : Hypermap dartCount) : ℕ :=
  Nat.card (Quotient (Relation.EqvGen.setoid H.Link))

/-- Gonthier's generalized Euler equality, valid also for empty or disconnected hypermaps. -/
def Planar (H : Hypermap dartCount) : Prop :=
  H.edgeCount + H.nodeCount + H.faceCount = dartCount + 2 * H.componentCount

/-- Connectedness includes nonemptiness: the empty hypermap has zero components. -/
def Connected (H : Hypermap dartCount) : Prop :=
  H.componentCount = 1

/-- Every edge orbit has exactly two darts (`geometry.v`, `plainP`). -/
def Plain (H : Hypermap dartCount) : Prop :=
  ∀ x, H.edge (H.edge x) = x ∧ H.edge x ≠ x

/-- The cardinality of the node orbit containing a dart. -/
noncomputable def nodeArity (H : Hypermap dartCount) (x : Fin dartCount) : ℕ :=
  Nat.card {y : Fin dartCount // H.node.SameCycle x y}

/-- Every node orbit has exactly three darts (`geometry.v`, `cubic`). -/
def Cubic (H : Hypermap dartCount) : Prop :=
  ∀ x, H.nodeArity x = 3

/-- Every node orbit has at most three darts (`geometry.v`, `precubic`). -/
def Precubic (H : Hypermap dartCount) : Prop :=
  ∀ x, H.nodeArity x ≤ 3

/-- Cubic maps satisfy the source's weaker precubic condition. -/
theorem Cubic.precubic {H : Hypermap dartCount} (h : H.Cubic) : H.Precubic := by
  intro x
  exact (h x).le

/-- The finite set of darts in the face containing `x`. -/
noncomputable def faceDarts (H : Hypermap dartCount) (x : Fin dartCount) :
    Finset (Fin dartCount) := by
  classical
  exact Finset.univ.filter (H.SameFace x)

/-- The number of sides of the face containing a dart, counted with dart multiplicity. -/
noncomputable def faceArity (H : Hypermap dartCount) (x : Fin dartCount) : ℕ :=
  (H.faceDarts x).card

/-- No edge step stays in the same face orbit (`geometry.v`, `bridgeless`). -/
def Bridgeless (H : Hypermap dartCount) : Prop :=
  ∀ x, ¬ H.SameFace x (H.edge x)

/-- A face coloring is constant on face orbits and changes color across every edge step. -/
def Coloring {α : Type*} (H : Hypermap dartCount) (color : Fin dartCount → α) : Prop :=
  (∀ x y, H.SameFace x y → color x = color y) ∧
    (∀ x, color (H.edge x) ≠ color x)

/-- Existence of a proper face coloring with at most `colorCount` colors. -/
def Colorable (H : Hypermap dartCount) (colorCount : ℕ) : Prop :=
  ∃ color : Fin dartCount → Fin colorCount, H.Coloring color

/-- Existence of a proper face coloring with at most four colors; surjectivity is not required. -/
abbrev FourColorable (H : Hypermap dartCount) : Prop :=
  H.Colorable 4

/-- The class minimized in Gonthier's `coloring.v`, `minimal_counter_example`. -/
def Admissible (H : Hypermap dartCount) : Prop :=
  H.Planar ∧ H.Bridgeless ∧ H.Plain ∧ H.Precubic

/-- A noncolorable member of the source's minimal class with the least number of darts.

The quantification over every `smaller : ℕ` includes the empty hypermap. Cubicity and
connectedness are conclusions to establish later, not additional assumptions here.
Source: Gonthier (2005), Section 3, PDF p. 7, minimal-counterexample paragraph;
precise dart-count formulation in pinned Rocq `coloring.v`, lines 224–231.
-/
structure MinimalCounterexample (H : Hypermap dartCount) : Prop where
  admissible : H.Admissible
  not_fourColorable : ¬ H.FourColorable
  minimal : ∀ (smaller : ℕ), smaller < dartCount → ∀ K : Hypermap smaller,
    K.Admissible → K.FourColorable

/-- A bridge obstructs face coloring because both ends would have the same color. -/
theorem FourColorable.bridgeless {H : Hypermap dartCount} (h : H.FourColorable) :
    H.Bridgeless := by
  obtain ⟨color, hface, hedge⟩ := h
  intro x hsame
  exact hedge x (hface x (H.edge x) hsame).symm

end Hypermap

end FourColor


