def SelbergIntegerSamplingIdentities : Prop :=
  forall (a b delta : Real), a <= b -> 0 < delta -> delta <= 1 ->
    Summable (fun n : Int =>
      (selbergIntervalMajorant a b delta (n : Real) : Complex)) /\
    (∑' n : Int,
      (selbergIntervalMajorant a b delta (n : Real) : Complex)) =
        (((b - a) + delta⁻¹ : Real) : Complex) /\
    forall beta : Real, delta <= circleDist beta 0 ->
      (∑' n : Int,
