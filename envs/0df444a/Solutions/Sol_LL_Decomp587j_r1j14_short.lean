def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

theorem le_mul_ceilDiv {a b : Nat} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
  unfold ceilDiv
  have h1 := Nat.div_add_mod (a + b - 1) b
  have h2 := Nat.mod_lt (a + b - 1) hb
  omega

def wInv (a b : Nat) : Nat :=
  ceilDiv (W_scale * (b * b - a * a)) (2 * a * b)

