theorem rz_hasDerivAt_E (y : Pt 4) (A μ : Fin 4) :
    HasDerivAt (fun ε => rzE E0 B ε A μ y) (B A μ y) 0 := by
  have := ((hasDerivAt_id (0 : ℝ)).ofReal_comp.mul_const (B A μ y)).const_add (E0 A μ y)
  simpa [rzE] using this

