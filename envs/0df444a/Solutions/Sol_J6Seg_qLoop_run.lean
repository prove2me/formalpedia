theorem tLoad_sp (s : IState HS) (F : Fin HS → List ℤ) (z u acc ci cq cr T R : List ℤ) (B : ℕ)
    (hTB : Bnd B T) (hlB : zsz (T.length : ℤ) ≤ B) :
    Sp (tLoad ρ dT) (encK s (KS ρ dT F z [] (((T.length : ℤ) :: T) ++ R) u [] [] acc ci cq cr))
      (encK s (KS ρ dT F z T R ((T.length : ℤ) :: u) [] [(T.length : ℤ)] acc ci cq cr))
      (cTab B T.length) := by
  have S1 := Sp.push s (KS ρ dT F z [] ((T.length : ℤ) :: (T ++ R)) u [] [] acc ci cq cr) (i := ρ 16)
    (e := .reg (ρ 10)) (B := B) (hR.lt 16) (clean_reg (hR.lt 10))
    (ok_reg (KS_atTq hR ..)) trivial (bnd_reg (KS_atTq hR ..) hlB)
  rw [eval_reg (KS_atTq hR ..), KS_atRl hR, KS_rl hR] at S1
  have S2 := Sp.pop s (KS ρ dT F z [] ((T.length : ℤ) :: (T ++ R)) u [] [(T.length : ℤ)] acc ci cq cr) (i := ρ 10)
    (a := (T.length : ℤ)) (l := T ++ R) (B := B) (hR.lt 10) (KS_atTq hR ..) hlB
  rw [KS_tq hR] at S2
  have S3 := Sp.push s (KS ρ dT F z [] (T ++ R) u [] [(T.length : ℤ)] acc ci cq cr) (i := ρ 15)
    (e := .reg (ρ 16)) (B := B) (hR.lt 15) (clean_reg (hR.lt 16))
    (ok_reg (KS_atRl hR ..)) trivial (bnd_reg (KS_atRl hR ..) hlB)
  rw [eval_reg (KS_atRl hR ..), KS_atU hR, KS_u hR] at S3
  have S4 := Sp.mvK (hR.ne (by decide : (10 : Fin 19) ≠ 14)) (hR.ne (by decide))
    (hR.ne (by decide)) (hR.lt 10) (hR.lt 14) (hR.lt 18) s
    (KS ρ dT F z [] (T ++ R) ((T.length : ℤ) :: u) [] [(T.length : ℤ)] acc ci cq cr) (.reg (ρ 16)) (clean_reg (hR.lt 16))
    (ok_reg (KS_atRl hR ..)) T R (KS_atTq hR ..) (by rw [eval_reg (KS_atRl hR ..)]) B hTB trivial
    (bnd_reg (KS_atRl hR ..) hlB)
  rw [KS_atT1 hR, KS_tq hR, KS_t1 hR, List.append_nil] at S4
  have S5 := Sp.mvK (hR.neT 14) (hR.ne (by decide : (14 : Fin 19) ≠ 18)) (Ne.symm (hR.neT 18))
    (hR.lt 14) hR.Tlt (hR.lt 18) s
    (KS ρ dT F z [] R ((T.length : ℤ) :: u) T.reverse [(T.length : ℤ)] acc ci cq cr) (.reg (ρ 16)) (clean_reg (hR.lt 16))
    (ok_reg (KS_atRl hR ..)) T.reverse [] (by rw [KS_atT1 hR, List.append_nil])
    (by rw [eval_reg (KS_atRl hR ..), List.length_reverse]) B (KIL.bnd_reverse hTB) trivial
    (bnd_reg (KS_atRl hR ..) hlB)
  rw [KS_atT hR, KS_t1 hR, KS_dt hR, List.reverse_reverse, List.append_nil] at S5
  refine ((S1.seq (S2.seq (S3.seq (S4.seq S5))))).mono ?_
