        Nat.card (↥(Φ m).ker ⧸
          ((zsmulAddGroupHom ((2 : ℤ) ^ m)).range.addSubgroupOf (Φ m).ker)) ≤ 2 ^ C) := by
  letI : Module HeckeAlg (JZero p) := heckeModuleBar p
  haveI : SMulCommClass (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) HeckeAlg (JZero p) :=
