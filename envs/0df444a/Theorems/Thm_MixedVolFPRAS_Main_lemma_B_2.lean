-- title:
--   Lemma B.2 — the lazy Metropolis chain has Poincaré constant κ, κ⁻¹ = 24(1 + 3(n−1)(n+3)/(γα²)), and mixes from uniform in κ⁻¹(πζ/2 + log(1/ε)) steps
-- statement:
--   Let $n\ge2$ and let $\mu=\psi\,\omega$ be a probability measure on $S^{n-1}$ with smooth positive density $\psi$. Suppose $\gamma,\zeta>0$ satisfy the conditions of Lemma 2.16: the Poincaré inequality $\gamma\,\mathrm{Var}_\mu[f]\le\int\|\nabla_{S^{n-1}}f\|_2^2\,d\mu$ for every smooth $f$, and $\|\nabla_{S^{n-1}}\log\psi\|_2\le\zeta$ on $S^{n-1}$. Let $P$ be the lazy Metropolis chain of Definition B.1 with proposal radius $\alpha=1/(n+\zeta)$, and set
--
--   $$\kappa^{-1}=24\Big(1+\frac{3(n-1)(n+3)}{\gamma\alpha^2}\Big).$$
--
--   Then (19) $\kappa\,\mathrm{Var}_\mu[f]\le\mathcal{E}_P(f,f)=\frac12\iint(f(y)-f(x))^2P(x,dy)\,d\mu(x)$ for all $f\in L^2(\mu)$; and (20) if $X_0\sim\sigma=\omega/\omega(S^{n-1})$ and $X_1,X_2,\dots$ are generated by $P$, then
--
--   $$\|\mathrm{Law}(X_T)-\mu\|_{TV}\le\varepsilon/2\qquad\text{for every }0<\varepsilon<1\text{ and every }T\ge\kappa^{-1}\Big(\frac{\pi\zeta}{2}+\log\frac1\varepsilon\Big).$$
--
--   This is the mixing bound behind the mean-estimation routine (Lemma 2.16) used by the smooth-case algorithm.
--
--   Differences from the source:
--   - reading: "Assume the conditions of Lemma 2.16" → binders $n\ge2$, $\psi$ smooth on the sphere, $\psi>0$ on $S^{n-1}$, $\int\psi\,d\omega=1$, $\gamma,\zeta>0$, the Poincaré inequality for smooth $f$ and $\|\nabla_{S^{n-1}}\log\psi\|\le\zeta$; reason: these are the conditions of Lemma 2.16 on $\mu$, $\gamma$, $\zeta$; its conditions on $g,b,B,L,\varepsilon,\delta$ concern the estimator and do not enter Lemma B.2.
--   - encoding: $\mathrm{Law}(X_T)$ and $\|\cdot\|_{TV}$ → `chainLaw P σ T` ($T$-fold `Measure.bind`) and the supremum of $|\nu(A)-\mu(A)|$ over measurable $A$; reason: standard measure-theoretic forms of the same objects.
-- source:
--   Chen, Liu, An FPRAS for Mixed Volumes, STOC 2027 submission (manuscript sha256 0acf8d97…), p. 34, Lemma B.2

import Mathlib
import Definitions.Def_MixedVolFPRAS_Main_Sphere
import Definitions.Def_MixedVolFPRAS_Main_Metropolis

namespace MixedVolFPRAS.Main

/-- **Lemma B.2.** Assume the conditions of Lemma 2.16: `n ≥ 2`, `µ = ψ ω` a probability measure
on `Sⁿ⁻¹` with smooth positive density `ψ`, constants `γ, ζ > 0` with the Poincaré inequality
`γ Var_µ[f] ≤ ∫ ‖∇_{Sⁿ⁻¹} f‖² dµ` for smooth `f` and `‖∇_{Sⁿ⁻¹} log ψ‖ ≤ ζ`. Let `P` be the lazy
Metropolis chain with `α = 1/(n + ζ)` and `κ⁻¹ = 24(1 + 3(n − 1)(n + 3)/(γα²))`. Then
(19) `κ Var_µ[f] ≤ E_P(f, f)` for all `f ∈ L²(µ)`, and (20) from the uniform start,
`‖Law(X_T) − µ‖_TV ≤ ε/2` for every `0 < ε < 1` and `T ≥ κ⁻¹(πζ/2 + log(1/ε))`. -/
theorem lemma_B_2 {n : ℕ} (hn : 2 ≤ n) (ψ : E n → ℝ) (γ ζ : ℝ)
    (hψsmooth : IsSmoothOnSphere ψ) (hψpos : ∀ θ ∈ unitSphere n, 0 < ψ θ)
    (hψnorm : ∫ θ : Sph n, ψ θ ∂(surfaceMeasure n) = 1)
    (hγ : 0 < γ) (hζ : 0 < ζ)
    (hpoincare : ∀ f : E n → ℝ, IsSmoothOnSphere f →
      γ * ProbabilityTheory.variance (fun θ : Sph n => f θ) (densityMeasure ψ) ≤
        ∫ θ : Sph n, ‖sphGrad f (θ : E n)‖ ^ 2 ∂(densityMeasure ψ))
    (hlip : ∀ θ ∈ unitSphere n, ‖sphGrad (fun x => Real.log (ψ x)) θ‖ ≤ ζ) :
    (∀ f : Sph n → ℝ, MeasureTheory.MemLp f 2 (densityMeasure ψ) →
      (24 * (1 + 3 * ((n : ℝ) - 1) * ((n : ℝ) + 3) /
          (γ * (1 / ((n : ℝ) + ζ)) ^ 2)))⁻¹ *
          ProbabilityTheory.variance f (densityMeasure ψ) ≤
        dirichletForm (lazyMetropolis ψ ζ) (densityMeasure ψ) f) ∧
      ∀ ε : ℝ, 0 < ε → ε < 1 → ∀ T : ℕ,
        24 * (1 + 3 * ((n : ℝ) - 1) * ((n : ℝ) + 3) / (γ * (1 / ((n : ℝ) + ζ)) ^ 2)) *
            (Real.pi * ζ / 2 + Real.log (1 / ε)) ≤ (T : ℝ) →
          tvDist (chainLaw (lazyMetropolis ψ ζ) (uniformSphere n) T) (densityMeasure ψ) ≤
            ε / 2 := by sorry

end MixedVolFPRAS.Main
