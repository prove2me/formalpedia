      simp only [IState.upd_G]
      have hWH : W ≠ H := Ne.symm hHW
      clear k1 k2
      apply IState.ext' <;> intros <;>
        simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;> split_ifs <;>
        simp_all +decide [ints_append])
    L1 (by simp [T, hN1, hWr1, Ne.symm hWr1])
  have e0 : T 0 = s := by simp [T, ints]
  rw [e0] at H
  refine H.mono ?_
  unfold cRepl cCnt; omega

