theorem fitL_eq_ofFn : ∀ (k : ℕ) (A : List Bool),
    fitL k A = List.ofFn (fun i : Fin k => (wval A).testBit i)
  | 0, _ => rfl
  | k + 1, [] => by
    rw [fitL, fitL_eq_ofFn k [], List.ofFn_succ]; simp [wval]
  | k + 1, b :: A => by
    rw [fitL, fitL_eq_ofFn k A, List.ofFn_succ]
    congr 1
    · cases b <;> simp [wval, Nat.testBit_zero]
    · congr 1; funext i
      simp only [wval, Fin.val_succ]
      rw [Nat.testBit_succ]; congr 1; cases b <;> simp <;> omega

theorem fitL_reverse (k : ℕ) (A : List Bool) : (fitL k A).reverse = bin k (wval A) := by
  rw [fitL_eq_ofFn, bin]
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp only [List.getElem_reverse, List.getElem_ofFn, List.length_ofFn]

theorem fitL_append : ∀ (n m : ℕ) (A : List Bool),
    fitL n A ++ fitL m (A.drop n) = fitL (n + m) A
  | 0, m, A => by simp [fitL]
  | n + 1, m, [] => by
    have := fitL_append n m []
    simp only [List.drop_nil] at this
    simp [fitL, ← this, add_right_comm]
  | n + 1, m, b :: A => by
    have := fitL_append n m A
    simp [fitL, ← this, add_right_comm]

