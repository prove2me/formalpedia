    (((t : ℂ) - Complex.I * (x : ℂ)) ^ 2).re = realPolynomial2 x t := by
  have h := real_power_recurrence x t 0
  change (((t : ℂ) - Complex.I * (x : ℂ)) ^ 2).re =
    2 * t * (((t : ℂ) - Complex.I * (x : ℂ)) ^ 1).re -
      (t ^ 2 + x ^ 2) * (((t : ℂ) - Complex.I * (x : ℂ)) ^ 0).re at h
  rw [real_power1, real_power0] at h
  calc
    _ = 2 * t * realPolynomial1 x t -
        (t ^ 2 + x ^ 2) * realPolynomial0 x t := h
    _ = realPolynomial2 x t := by
      simp only [realPolynomial2, realPolynomial1, realPolynomial0]
