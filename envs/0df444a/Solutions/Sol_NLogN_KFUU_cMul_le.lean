theorem solution {x y : ℤ} {Z : ℕ} (hx : NLogN.zsz x ≤ Z) (hy : NLogN.zsz y ≤ Z) : NLogN.KFUU.cMul x y ≤ NLogN.KFUU.cU Z := by
