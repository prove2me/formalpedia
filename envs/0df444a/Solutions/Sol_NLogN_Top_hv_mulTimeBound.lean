  simpa using this

theorem tapeOf_pop_stk (l : List Sym) (x : Sym) :
    Function.update (tapeOf (syms L) ((x :: l).map gsym).reverse) (l.length + 1) gbl =
      tapeOf (syms L) (l.map gsym).reverse := by
  have := tapeOf_pop' (l.map (gsym (L := L))).reverse (gsym x)
  simpa using this

theorem enc_cells_tst (inp : ℕ → Γ L) (c : Cfg S) (i : Fin S) :
