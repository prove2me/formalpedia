theorem ModularCurve.relfinrank_adjoin_jqModC_modularFunctionFieldC_eq_dedekindPsi
    (k : Type*) [Field k] (N : ℕ) [NeZero N] (ℓ : ℕ) [Fact ℓ.Prime] [CharP k ℓ] (hℓN : ¬ ℓ ∣ N) :
