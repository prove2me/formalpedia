-- title:
--   The JM-generated algebra is maximal abelian
-- statement:
--   Let $K$ be a field and $A$ a unital cellular $K$-algebra with finite cell datum $(\Lambda,T,a)$, ordered tableau sets, and exact index-swapping involution. Let $L_1,\ldots,L_M$ be commuting, involution-fixed JM elements with triangular-action contents $c_t(i)$. Assume that the complete content sequences distinguish all tableaux, including tableaux of different shapes. Define $F_t$ by the interpolation product of Definition 3.1, $f_{st}=F_s a_{st}F_t$, and $\gamma_t$ as the coefficient of $a_{tt}$ in $f_{tt}^2$. The unital $K$-subalgebra generated by the JM family is maximal among commutative $K$-subalgebras:
--
--   $$\mathcal L=K[L_1,\ldots,L_M]\quad\text{is maximal abelian in }A.$$
--
--   The source supplies no tower of embedded centres, so this makes no additional Gelfand–Zeitlin algebra identification.
-- source:
--   Seminormal forms and Gram determinants for cellular algebras, arXiv:math/0604108v4, PDF p. 14, 3.18

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P08

noncomputable section

open scoped BigOperators

attribute [local instance] Classical.propDecidable Classical.decEq

namespace QAlgorithms.Papers.Independent.Support21.P08

open QAlgorithms.Papers.Independent.Renew46.P16 (CellIndex)

open QAlgorithms.Papers.Independent.Next46.P12 (PrimitiveIdempotent)

section SeparatedDefinitions

variable {K A Shape : Type*} [Field K] [Ring A] [Algebra K A]

variable [Fintype Shape] [PartialOrder Shape] {T : Shape → Type*}

variable [∀ l, Fintype (T l)] [∀ l, PartialOrder (T l)]

variable {D : CellDatum (R := K) (A := A) (T := T)} {M : ℕ}

/-- Corollary 3.18, PDF p.14. This is the generated JM algebra, with no
unsupported Gelfand–Zeitlin tower identification. Uses corrected injectivity. -/
theorem jm_maximal_abelian (J : JMFamily D M) (hsep : separatesAll J) :
    MaximalAbelian (jmAlgebra J) := by sorry

end SeparatedDefinitions

end QAlgorithms.Papers.Independent.Support21.P08

