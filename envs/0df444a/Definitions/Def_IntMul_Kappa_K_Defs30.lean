section
-- Source module: Solutions.KFV47Scale
/-!
# KFV §50: the scaling pass `× 2^n` (`scaleS`)

`scaleS` multiplies every integer of the `M = 2 N r` integers on top of stack `0` by `2^n`
(`n` on `gNn`, `N = 2^n`, `r = 2^ℓ`): it pushes `2^n` (on `vRH`) and `M` (on `vT`), runs a
counted loop of linear-cost shifts `push sT (shl (reg 0) (reg vRH)) ; pop 0`, moves the result
back and pops. **`scaleS_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC KFH RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The scratch stack of the scaling pass (and of the array shuttle). -/
abbrev sT : Fin HS := 37

/-- The shift of one item. -/
def eSh : Ex HS := .shl (.reg 0) (.reg vRH)

def shBody : RS := .seq (.push NLogN.KFV.sT eSh) (.pop 0)

/-- The scaling pass. -/
def scaleR : RS :=
  .seq (.push vRH (.pow2 (.reg gNn))) <|
  .seq (.push NLogN.KFV.vT eKT) <|
  .seq (.rep NLogN.KFV.vL (.reg NLogN.KFV.vT) shBody) <|
  .seq (NLogN.mvK NLogN.KFV.sT 0 NLogN.KFV.vL (.reg NLogN.KFV.vT)) <|
  .seq (.pop NLogN.KFV.vT) (.pop vRH)

def scaleS : IStmt HS Pp := fcode scaleR

/-- The scaled Gaussian integer. -/
def scG (n : ℕ) (z : GI) : GI := (z.1 * 2 ^ n, z.2 * 2 ^ n)

/-- Cost of the scaling pass. -/
def cScale (M B : ℕ) : ℕ :=
  20 * 10 ^ 7 * (B + 2) ^ 2 + (cLp M (8000 * (B + 2) + (2 * B + 2)) B + cLp M (250 * (B + 2)) B +
    2 * (2 * B + 2))

end NLogN.KFV

end

section
-- Source module: Solutions.KFV48Shut
/-!
# KFV §51: moving an array between stack `0` and `sT` (`shR`)

`shR X Y = push vT (2 N r) ; mvK X Y vL vT ; pop vT` moves the `2 N r` integers on top of `X`
(reversed) onto `Y`. **`shut_runs`**.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KIL KFD KFT KFB KFC KFH RS

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-- The array move. -/
def shR (X Y : Fin HS) : RS := .seq (.push NLogN.KFV.vT eKT) (.seq (NLogN.mvK X Y NLogN.KFV.vL (.reg NLogN.KFV.vT)) (.pop NLogN.KFV.vT))

/-- Its cost. -/
def cShut (M B : ℕ) : ℕ := 10 * 10 ^ 7 * (B + 2) ^ 2 + (cLp M (250 * (B + 2)) B + (2 * B + 2))

end NLogN.KFV

