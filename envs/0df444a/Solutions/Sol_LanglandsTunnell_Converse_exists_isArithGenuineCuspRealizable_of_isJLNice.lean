  refine ⟨v, fun i hi => hv ?_⟩
  exact Set.mem_iUnion.mpr ⟨i, by simpa using hi⟩

private theorem coeff_eq_zero_of_forall_tsum_eq_zero {ι : Type*} [Countable ι] (ℓ : ι → V →L[ℝ] ℝ)
    (hℓ : Function.Injective ℓ) (C : ι → ℂ) (hC : Summable fun i => ‖C i‖)
    (h : ∀ x : V, ∑' i, C i * e (ℓ i x) = 0) (i₀ : ι) : C i₀ = 0 := by

  obtain ⟨v, hv⟩ := exists_forall_apply_ne_zero (V := V) (ι := {i : ι // i ≠ i₀})
    (fun j => ℓ j.1 - ℓ i₀) (fun j hj => j.2 (hℓ (sub_eq_zero.mp hj)))
  refine coeff_eq_zero_of_line C hC (fun i => ℓ i v) i₀ (fun i hi => ?_) (fun t => ?_)
