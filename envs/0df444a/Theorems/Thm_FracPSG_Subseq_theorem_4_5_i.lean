-- title:
--   Theorem 4.5(i) — merit-function descent of e-PSG with the explicit constants (14)
-- statement:
--   Let $S\subseteq\mathbb R^N$ be closed and convex, suppose Assumptions 1 and 2 hold, let the parameters $\delta,\zeta,\bar\mu,\bar\kappa$ be chosen as in Step 1 of Algorithm 1 (either in the (BC) ranges for constants $m,M$, or $\bar\mu=\bar\kappa=0$), let $(x_n)$ be generated by Algorithm 1, and suppose $S_0=\{x\in S: f(x)/g(x)\le f(x_0)/g(x_0)\}$ is bounded. Then:
--
--   1. $x_n\in S\cap\operatorname{dom} f$ for all $n$;
--   2. under (BC) with the (BC) parameter ranges, $\alpha>0$ and for all $n$
--   $$\Big(\frac{f(x_{n+1})}{g(x_{n+1})}+c\|x_{n+1}-x_n\|^2\Big)+\alpha\|x_{n+1}-x_n\|^2\le\frac{f(x_n)}{g(x_n)}+c\|x_n-x_{n-1}\|^2,$$
--   with $c=\frac{\ell\bar\kappa^2}{2m}+\frac{\bar\mu}{2\sqrt{mM}}$ and $\alpha=\frac{\delta(1-\sqrt\beta\zeta)}{2M}-\frac{\bar\mu}{\sqrt{mM}}-\frac{\ell\bar\kappa^2}{2m}$;
--   3. when $\bar\mu=\bar\kappa=0$, the same inequality holds with $c=0$ and $\alpha=\frac{\delta(1-\sqrt\beta\zeta)}{2M'}$, $M'=\sup_{x\in S_0}g(x)$;
--   4. the sequence $\big(f(x_n)/g(x_n)\big)_{n\in\mathbb N}$ converges.
--
--   The quantity $F_n=f(x_n)/g(x_n)+c\|x_n-x_{n-1}\|^2$ is a merit function of the method, and its sufficient decrease drives every later convergence statement.
--
--   **Formalization Note** The paper's "otherwise" branch (no (BC), hence $\bar\mu=\bar\kappa=0$) is stated whenever $\bar\mu=\bar\kappa=0$, which includes the case where (BC) holds; it is true there too. The positivity $\alpha>0$ under (BC) is derived on p. 12 and is stated because without it the inequality says less. "Convergent" is `∃ L, Tendsto θ atTop (𝓝 L)`.
-- source:
--   Boţ, Dao, Li, Extrapolated Proximal Subgradient Algorithms for Nonconvex and Nonsmooth Fractional Programs, arXiv:2003.04124v2, p. 10, Theorem 4.5(i) with (14); proof pp. 11–12, (18), (19)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_FracPSG_Subseq_Basic
import Definitions.Def_FracPSG_Subseq_EPSG

open Filter Topology
open scoped InnerProductSpace

namespace FracPSG.Subseq

open NonconvexSplitting.Shared

/-- Theorem 4.5(i) (Boţ–Dao–Li, arXiv:2003.04124v2, p. 10): under Assumptions 1 and 2, a Step 1
parameter choice and bounded `S₀`, every run of Algorithm 1 stays in `S ∩ dom f` and satisfies
`(f(xₙ₊₁)/g(xₙ₊₁) + c‖xₙ₊₁ − xₙ‖²) + α‖xₙ₊₁ − xₙ‖² ≤ f(xₙ)/g(xₙ) + c‖xₙ − xₙ₋₁‖²` with the
constants (14): under (BC) `c = ℓκ̄²/(2m) + μ̄/(2√(mM))`,
`α = δ(1 − √β ζ)/(2M) − μ̄/√(mM) − ℓκ̄²/(2m) > 0`; with `μ̄ = κ̄ = 0`, `c = 0` and
`α = δ(1 − √β ζ)/(2M′)`, `M′ = sup_{S₀} g`. Consequently `f(xₙ)/g(xₙ)` converges. -/
theorem theorem_4_5_i
    {N : ℕ} {S : Set (EuclideanSpace ℝ (Fin N))}
    {fs : EuclideanSpace ℝ (Fin N) → ℝ} {fn : EuclideanSpace ℝ (Fin N) → EReal}
    {g : EuclideanSpace ℝ (Fin N) → ℝ} {ℓ β δ ζ μbar κbar : ℝ}
    {x gs : ℕ → EuclideanSpace ℝ (Fin N)} {τ κ μ : ℕ → ℝ}
    (hS : IsClosed S) (hSconv : Convex ℝ S)
    (hA1 : Assumption1 S fs fn ℓ) (hA2 : Assumption2 S g β)
    (hδ : 0 < δ) (hζ : 0 < ζ) (hβζ : 0 < 1 - Real.sqrt β * ζ) {m M : ℝ}
    (hpar : ParamsBC S (objF fs fn) g ℓ β δ ζ μbar κbar m M ∨ ParamsNoBC μbar κbar)
    (hrun : IsEPSGRun S fs fn g ℓ β δ ζ μbar κbar x gs τ κ μ)
    (hS0 : Bornology.IsBounded (S0 S (objF fs fn) g (x 0))) :
    (∀ n, x n ∈ S ∧ objF fs fn (x n) ≠ ⊤) ∧
    (ParamsBC S (objF fs fn) g ℓ β δ ζ μbar κbar m M →
      0 < αBC ℓ β δ ζ μbar κbar m M ∧
      ∀ n, (ratio (objF fs fn) g (x (n + 1)) + cBC ℓ μbar κbar m M * ‖x (n + 1) - x n‖ ^ 2)
          + αBC ℓ β δ ζ μbar κbar m M * ‖x (n + 1) - x n‖ ^ 2 ≤
        ratio (objF fs fn) g (x n) + cBC ℓ μbar κbar m M * ‖x n - xPrev x n‖ ^ 2) ∧
    (ParamsNoBC μbar κbar →
      ∀ n, (ratio (objF fs fn) g (x (n + 1)) + 0 * ‖x (n + 1) - x n‖ ^ 2)
          + αNoBC S (objF fs fn) g β δ ζ (x 0) * ‖x (n + 1) - x n‖ ^ 2 ≤
        ratio (objF fs fn) g (x n) + 0 * ‖x n - xPrev x n‖ ^ 2) ∧
    ∃ L : ℝ, Tendsto (fun n => ratio (objF fs fn) g (x n)) atTop (𝓝 L) := by sorry

end FracPSG.Subseq
