namespace FramesPowSol

def Frames {X : Scheme.{0}} (P : X.Modules) : Prop :=
  ∃ (N : ℕ) (σ : Fin (N + 1) → Γ(P, ⊤)) (U : Fin (N + 1) → X.Opens), iSup U = ⊤ ∧ ∀ i, Scheme.Modules.IsFrameOn (σ i) (U i)

theorem frames_of_iso {X : Scheme.{0}} {P Q : X.Modules} (e : P ≅ Q) (h : Frames P) : Frames Q := by
  obtain ⟨N, σ, U, hU, hfr⟩ := h
  exact ⟨N, fun i => e.hom.app ⊤ (σ i), U, hU, fun i => (hfr i).map_iso e⟩

theorem isFrameOn_mono {X : Scheme.{0}} {P : X.Modules} {U : X.Opens} {s : Γ(P, U)} {V V' : X.Opens}
    (h : Scheme.Modules.IsFrameOn s V) (hle : V' ≤ V) : Scheme.Modules.IsFrameOn s V' :=
  fun _ hWU hWV' => h hWU (hWV'.trans hle)

theorem frames_tensor {X : Scheme.{0}} {P Q : X.Modules} (hP : Frames P) (hQ : Frames Q) : Frames (P ⊗ Q) := by
  classical
  obtain ⟨N₁, σ, U, hU, hσ⟩ := hP
  obtain ⟨N₂, τ, V, hV, hτ⟩ := hQ

  obtain ⟨N, hN⟩ : ∃ N, (N₁ + 1) * (N₂ + 1) = N + 1 :=
    ⟨(N₁ + 1) * (N₂ + 1) - 1, (Nat.succ_pred_eq_of_pos (Nat.mul_pos (Nat.succ_pos _) (Nat.succ_pos _))).symm⟩
  let ε : Fin (N + 1) ≃ Fin (N₁ + 1) × Fin (N₂ + 1) := (finCongr hN.symm).trans finProdFinEquiv.symm
  let idx : Fin (N + 1) → Fin (N₁ + 1) × Fin (N₂ + 1) := ε
  refine ⟨N, fun i => Scheme.Modules.tensorSections (σ (idx i).1) (τ (idx i).2), fun i => U (idx i).1 ⊓ V (idx i).2, ?_, ?_⟩
  · rw [eq_top_iff]
    rintro x -
    have hxU : x ∈ (iSup U : X.Opens) := by rw [hU]; trivial
    have hxV : x ∈ (iSup V : X.Opens) := by rw [hV]; trivial
    obtain ⟨a, ha⟩ := Opens.mem_iSup.mp hxU
    obtain ⟨b, hb⟩ := Opens.mem_iSup.mp hxV
    refine Opens.mem_iSup.mpr ⟨ε.symm (a, b), ?_⟩
    have : idx (ε.symm (a, b)) = (a, b) := Equiv.apply_symm_apply ε (a, b)
    rw [this]
    exact ⟨ha, hb⟩
  · intro i
    exact (isFrameOn_mono (hσ (idx i).1) inf_le_left).tensorSections_monoidalV2
      (isFrameOn_mono (hτ (idx i).2) inf_le_right)

