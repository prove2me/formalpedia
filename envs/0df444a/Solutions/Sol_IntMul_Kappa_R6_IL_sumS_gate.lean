-- Source module: Solutions.R6ILNet
/-!
# Round six, item language: a `QHNet` program on a table of `T + W` streams

The wires `Fin W ⊕ Fin T` of a round-six network are laid out as a table of `T + W` streams of
length `v` on stack `0` (temporaries first: `inr t ↦ t`, `inl w ↦ T + w`, `eqv`).

* `gateH_fsp`: a gate `(g, S)` is one fine rebuild `rebuildCU (T + W) (srcT (ngOf g S))`
  (frozen KIL3/KFD table code), with denotation `gateApply`;
* `instrH`, `netH`: the code of an instruction / of a program, an edge `(x, e)` being run in
  place by `applyCF` with an edge code `E e`;
* `netH_runs`: the program code computes `netRunH v impl prog` whenever every edge code
  computes `impl e` on single streams (under the invariant `Inv G0`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace IntMul.Kappa.R6.IL

open IntMul NLogN RS NLogN.KIL NLogN.KFD AModel AModelL12 Finset

noncomputable section

variable {W T m : ℕ}

/-! ## The wire layout -/

lemma tabS_eq (st : Fin W ⊕ Fin T → List (ZMod 2)) : tabS st = fun n => enc2 (zS st n) := by
  funext n
  simp only [tabS, zS, liftF]
  split_ifs <;> simp [enc2]

lemma tabS_eqv (st : Fin W ⊕ Fin T → List (ZMod 2)) (x : Fin W ⊕ Fin T) :
    tabS st (eqv x : ℕ) = enc2 (st x) := by
  simp [tabS, liftF]

lemma zS_eqv (st : Fin W ⊕ Fin T → List (ZMod 2)) (x : Fin W ⊕ Fin T) :
    zS st (eqv x : ℕ) = st x := by
  simp [zS, liftF]

/-! ## Gates -/

lemma gateApply_len {v : ℕ} (g : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) (ZMod 2))
    (S : Finset (Fin W ⊕ Fin T)) {st : Fin W ⊕ Fin T → List (ZMod 2)}
    (h : ∀ x, (st x).length = v) : ∀ x, (Bit.gateApply v g S st x).length = v := by
  intro x
  simp only [Bit.gateApply]
  split_ifs
  · simp
  · exact h x

/-- The rebuild of a gate computes `gateApply`. -/
theorem sumS_gate_sol_aux {v : ℕ} (g : Matrix (Fin W ⊕ Fin T) (Fin W ⊕ Fin T) (ZMod 2))
    (S : Finset (Fin W ⊕ Fin T)) (st : Fin W ⊕ Fin T → List (ZMod 2))
    (h : ∀ x, (st x).length = v) (n : ℕ) (hn : n < T + W) :
    sumS (tabS st) v (srcT (ngOf g S) n) = tabS (Bit.gateApply v g S st) n := by
  rw [tabS_eq st, sumS_enc2]
  set x : Fin W ⊕ Fin T := eqv.symm ⟨n, hn⟩ with hx
  have hnx : n = (eqv x : ℕ) := by simp [hx]
  have hZl : ∀ k, k < T + W → (zS st k).length = v := fun k hk => by
    simp only [zS, liftF, dif_pos hk]; exact h _
  have hsrc := (srcOK (ngOf g S) n hn).1
  have e2 : tabS (Bit.gateApply v g S st) n = enc2 (Bit.gateApply v g S st x) := by
    rw [hnx, tabS_eqv]
  rw [e2]
  congr 1
  apply List.ext_getElem
  · rw [length_sumZ _ _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw)),
      List.length_replicate, gateApply_len g S h x]
  intro i h1 h2
  have hi : i < v := by rw [gateApply_len g S h x] at h2; exact h2
  rw [← List.getD_eq_getElem _ (0 : ZMod 2) h1,
    getD_sumZ _ i _ _ (fun w hw => by rw [List.length_replicate]; exact hZl w (hsrc w hw))
      (by simpa using hi)]
  rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_replicate, zero_add]
  by_cases hS : x ∈ S
  · have hS' : (⟨n, hn⟩ : Fin (T + W)) ∈ (ngOf g S).2.1 := by
      simp only [ngOf, Finset.mem_map_equiv]
      simpa [hx] using hS
    simp only [srcT, dif_pos hn, if_pos hS']
    rw [gate_sum (ngOf g S) ⟨n, hn⟩ (zS st) i]
    simp only [Bit.gateApply, if_pos hS, List.getElem_ofFn]
    simp only [ngOf, Finset.sum_map, Equiv.coe_toEmbedding, Matrix.reindex_apply,
      Matrix.submatrix_apply, smul_eq_mul]
    refine Finset.sum_congr rfl fun y _ => ?_
    rw [zS_eqv]
    simp [hx]
  · have hS' : (⟨n, hn⟩ : Fin (T + W)) ∉ (ngOf g S).2.1 := by
      simp only [ngOf, Finset.mem_map_equiv]
      simpa [hx] using hS
    simp only [srcT, dif_pos hn, if_neg hS', List.map_cons, List.map_nil, List.sum_cons,
      List.sum_nil, add_zero]
    simp only [Bit.gateApply, if_neg hS]
    rw [hnx, zS_eqv]
    rw [List.getD_eq_getElem _ _ (by rw [h]; exact hi)]

