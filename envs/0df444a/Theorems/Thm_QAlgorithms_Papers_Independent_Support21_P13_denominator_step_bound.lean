-- title:
--   One-step bound for squared-modulus denominator exponents
-- statement:
--   Let $z,w\in R$ satisfy $|z|^2+|w|^2=1$. For a nonzero ring element $v$, its finite smallest denominator exponent is the least integer $d$ for which $v(\sqrt2)^d\in\mathbb Z[\omega]$. Suppose $d=\operatorname{sde}(|z|^2)\ge4$. For every integer $k$, the transformed squared modulus has a finite exponent $e$ and
--
--   $$
--   e=\operatorname{sde}\!\left(\left|\frac{z+w\omega^k}{\sqrt2}\right|^2\right),\qquad -1\le e-d\le1.
--   $$
--
--   This controls denominator change under a single $HT^k$ step. The exponents are signed integers and belong to squared moduli.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 6, Lemma 2: one-step squared-modulus denominator bound

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Lemma 2, PDF p.6: both sde arguments are squared moduli. Finite exponents
are expressed by their least-exponent graph, with integer k unrestricted. -/
theorem denominator_step_bound (z w : ℂ)
    (hz : z ∈ synthesisRing) (hw : w ∈ synthesisRing)
    (hstate : Complex.normSq z + Complex.normSq w = 1)
    (d : ℤ) (hd : IsSDE (normSquared z) d) (hlarge : 4 ≤ d) (k : ℤ) :
    ∃ e : ℤ,
      IsSDE (normSquared ((z + w * (QAlgorithms.gateT true true) ^ k) / ((Real.sqrt 2 : ℝ) : ℂ))) e ∧
      -1 ≤ e - d ∧ e - d ≤ 1 := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
