abbrev F8 : Type :=
  AdjoinRoot residueCubic
/-- The residue of the cubic generator. -/
def alpha : F8 :=
  AdjoinRoot.root residueCubic
/-! ## The four generator jets -/
/-! ## Structural collapse of the candidate space -/
end
end MazurProof.N13LocalDlogTwo
end

