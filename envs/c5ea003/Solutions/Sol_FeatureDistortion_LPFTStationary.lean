theorem solution :
  ∀ (n d k : ℕ) (P : Problem n d k), Admissible P →
    ∀ γ : Trajectory d k,
      IsFineTuningFlow P.data (labels P) (alignedHead P) (initialFeatures P) γ →
      ∀ t : ℝ, 0 ≤ t →
        γ.head t = alignedHead P ∧ γ.features t = initialFeatures P := by
  exact FeatureDistortion.LPFTStationary

