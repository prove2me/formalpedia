        one_div_le_one_div_of_le (div_pos hdet hA) hδ
    _ = botNormSqC g / ‖g.det‖ := one_div_div _ _

private theorem radC_line_eq (hg : g.det ≠ 0) (z₀ : ℂ) (θ r : ℝ) :
    radC g (z₀ + r * Complex.exp (θ * Complex.I))
      = Real.sqrt (botNormSqC g) * rad (lineMat g z₀ θ) r := by
  have hA := botNormSqC_pos g hg
  have hδ := lineDelta_pos hg z₀ θ
  have hsq : radC g (z₀ + r * Complex.exp (θ * Complex.I)) ^ 2
      = (Real.sqrt (botNormSqC g) * rad (lineMat g z₀ θ) r) ^ 2 := by
