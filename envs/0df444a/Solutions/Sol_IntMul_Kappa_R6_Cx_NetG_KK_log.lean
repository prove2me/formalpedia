lemma rW_ne_rT {n n' : ℕ} : rW n ≠ rT n' := by simp [rW, rT]

/-! ## Role indices -/

lemma rc_rT {n : ℕ} (h : n < Tn) : rc (rT n) = Wn + n := by simp [rc, rT, Nat.mod_eq_of_lt h]

lemma dmU {n B q r : ℕ} (hB : 0 < B) (h : n = r + B * q) (hr : r < B) : n / B = q ∧ n % B = r :=
  (Nat.div_mod_unique hB).2 ⟨h.symm, hr⟩

