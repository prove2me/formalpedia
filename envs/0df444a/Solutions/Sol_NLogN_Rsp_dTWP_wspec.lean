      simp only [NLogN.Rsp.XDE, NLogN.Rsp.dDE, NLogN.Rsp.cRE, NLogN.Rsp.kE, NLogN.Ex.ok, NLogN.Ex.eval, tops.1, tops.2.1, tops.2.2.1, tops.2.2.2]
      have iI : ∀ x, x ≠ 16 → x ≠ 17 → ∀ v L, σ.G x = .int v :: L → σ2.IsInt x := fun x a b v L h =>
        NLogN.IState.isInt_of (L := L) (a := v) (by rw [t2 x a b, h])
      have jT := iI _ (by decide) (by decide) _ _ gT
      have jS := iI _ (by decide) (by decide) _ _ gS
      have jA := iI _ (by decide) (by decide) _ _ gA
      have jK := iI _ (by decide) (by decide) _ _ hKc
      have s0' : (0 : ℤ) < s := by exact_mod_cast hs
      have t0' : (0 : ℤ) ≤ t := by positivity
      have k0' : (0 : ℤ) ≤ k := by positivity
      push_cast
      simp only [add_neg_cancel_right]
      and_intros <;> first | assumption | trivial | positivity | omega
  have ok3' : (NLogN.RS.push 27 (.reg NLogN.Rsp.TSg)).ok σ3 := ⟨by decide, NLogN.RS.clean_of_lt (by decide),
    NLogN.IState.isInt_of (L := LG) (a := (g : ℤ)) (by rw [h3, h2, h1]; simp (config := {decide := true}) [gG])⟩
  have ok5 : (NLogN.RS.push NLogN.Rsp.W3 (.reg 19)).ok σ4 := ⟨by decide, NLogN.RS.clean_of_lt (by decide), NLogN.IState.isInt_of g19⟩
  refine ⟨?_, ?_, ?_⟩
  · simp only [NLogN.Rsp.dTWP, NLogN.RS.ok, NLogN.RS.run_seq, e1, e2, e3, e3', e4, e5]
    refine ⟨ok1, ok2, ok3, ok3', hx.1, ok5, ⟨by decide, NLogN.IState.isInt_of g19'⟩, ?_, ?_, ?_, ?_⟩
    · rw [e6]; exact ⟨by decide, NLogN.IState.isInt_of g27'⟩
    · rw [e6, e6']; exact ⟨by decide, NLogN.IState.isInt_of g18'⟩
    · rw [e6, e6', e7]; exact ⟨by decide, NLogN.IState.isInt_of g17'⟩
    · rw [e6, e6', e7, e8]; exact ⟨by decide, NLogN.IState.isInt_of g16'⟩
  · simp only [NLogN.Rsp.dTWP, NLogN.RS.run_seq, e1, e2, e3, e3', e4, e5, e6, e6', e7, e8, e9]; exact hfin
  · simp only [NLogN.Rsp.dTWP, NLogN.RS.cost_seq', NLogN.RS.run_seq, e1, e2, e3, e3', e4, e5, e6, e6', e7, e8]
    have c1 := NLogN.RS.pushCost_le (.reg NLogN.Rsp.TP) σ Bq (by simp [NLogN.Ex.Bnd, NLogN.IState.top_eq gP, hpB])
    have c2 := NLogN.RS.pushCost_le (.reg NLogN.Rsp.TK2) σ1 Bq (by
      rw [h1]; simp (config := {decide := true}) [NLogN.Ex.Bnd, NLogN.IState.top, gK, hKB])
    have c3 := NLogN.RS.pushCost_le NLogN.Rsp.XDE σ2 Bq hBx
    have c3g := NLogN.RS.pushCost_le (.reg NLogN.Rsp.TSg) σ3 Bq (by
      rw [h3, h2, h1]; simp (config := {decide := true}) [NLogN.Ex.Bnd, NLogN.IState.top, gG, hgB])
    have zX : NLogN.zsz (Xn : ℤ) ≤ Bq := by
      have := NLogN.Ex.zsz_eval_le σ2 Bq NLogN.Rsp.XDE hBx; rw [hXE.2.2] at this; exact this
    have c4 := le_trans (NLogN.expPosP_cost p K2 Xn g σ3' (σ.G 16) (σ.G 17) (σ.G 18) (σ.G 27)
      g16 g17 g18 g27) (NLogN.Rsp.expPosCost_mono (n := p) (g := g) hKB zX)
    have c5 := NLogN.RS.pushCost_le (.reg 19) σ4 Bq (by simp [NLogN.Ex.Bnd, NLogN.IState.top_eq g19, hEB])
    have hsz : NLogN.Rsp.XDE.size ≤ 60 := by decide
    simp only [NLogN.RS.cost, NLogN.IState.top_eq g19', NLogN.IState.top_eq g27', NLogN.IState.top_eq g18',
      NLogN.IState.top_eq g17', NLogN.IState.top_eq g16']
    have q1 := hEB Xn
    unfold NLogN.Rsp.dTWCost
    have hB2 : Bq + 2 ≤ (Bq + 2) ^ 2 := by nlinarith
    have z1 : (NLogN.Ex.reg (S := NLogN.HS) NLogN.Rsp.TP).size = 1 := rfl
    have z2 : (NLogN.Ex.reg (S := NLogN.HS) NLogN.Rsp.TK2).size = 1 := rfl
    have z2' : (NLogN.Ex.reg (S := NLogN.HS) NLogN.Rsp.TSg).size = 1 := rfl
    have z3 : (NLogN.Ex.reg (S := NLogN.HS) 19).size = 1 := rfl
    rw [z1] at c1; rw [z2] at c2; rw [z3] at c5; rw [z2'] at c3g
    have c3' : NLogN.Rsp.XDE.cost σ2 + (2 * NLogN.moveCost (NLogN.zsz (NLogN.Rsp.XDE.eval σ2)) + 19) ≤ 61 * 10 ^ 7 * (Bq + 2) ^ 2 :=
      le_trans c3 (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (by omega)))
    generalize (Bq + 2) ^ 2 = Q at *
    omega
