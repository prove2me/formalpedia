lemma beps_big {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : (2 : ℝ) ^ ((2 : ℝ) ^ 89) ≤ (bP n : ℝ) ^ ε := by
  have hB : (2 : ℝ) ^ ((2 : ℝ) ^ 132) ≤ (bP n : ℝ) := by
    exact b0_real_ge.trans (by exact_mod_cast b_ge hn)
  have h0 : 0 ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 132) := by positivity
  calc (2 : ℝ) ^ ((2 : ℝ) ^ 89) = ((2 : ℝ) ^ ((2 : ℝ) ^ 132)) ^ ε := by
        rw [← Real.rpow_mul (by norm_num), show (2 : ℝ) ^ 132 * IntMul.OpenAI.R129.ε = (2 : ℝ) ^ 89 by
          unfold IntMul.OpenAI.R129.ε; norm_num]
    _ ≤ (bP n : ℝ) ^ ε := Real.rpow_le_rpow h0 hB (by unfold IntMul.OpenAI.R129.ε; norm_num)

lemma two_le_beps {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 2 ≤ (bP n : ℝ) ^ ε := by
  refine le_trans ?_ (beps_big hn)
  calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
    _ ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 89) := Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)

lemma d_half {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : (bP n : ℝ) ^ IntMul.OpenAI.R129.ε / 2 ≤ (IntMul.OpenAI.R129.dP n : ℝ) :=
  RCost.floor_half (two_le_beps hn)

lemma d_le_beps (n : ℕ) : (IntMul.OpenAI.R129.dP n : ℝ) ≤ (bP n : ℝ) ^ ε :=
  Nat.floor_le (Real.rpow_nonneg (Nat.cast_nonneg _) _)

lemma two_le_dc {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 2 ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ c := by
  have hY : (2 : ℝ) ^ ((2 : ℝ) ^ 89 - 1) ≤ (IntMul.OpenAI.R129.dP n : ℝ) := by
    rw [Real.rpow_sub_one (by norm_num)]
    exact le_trans (div_le_div_of_nonneg_right (beps_big hn) (by norm_num)) (d_half hn)
  have h0 : 0 ≤ (2 : ℝ) ^ ((2 : ℝ) ^ 89 - 1) := by positivity
  calc (2 : ℝ) = 2 ^ (1 : ℝ) := (Real.rpow_one 2).symm
    _ ≤ (2 : ℝ) ^ (((2 : ℝ) ^ 89 - 1) * IntMul.OpenAI.R129.c) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by unfold IntMul.OpenAI.R129.c; norm_num)
    _ = ((2 : ℝ) ^ ((2 : ℝ) ^ 89 - 1)) ^ c := by rw [Real.rpow_mul (by norm_num)]
    _ ≤ (IntMul.OpenAI.R129.dP n : ℝ) ^ c := Real.rpow_le_rpow h0 hY (by unfold IntMul.OpenAI.R129.c; norm_num)

lemma d_pos {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 1 ≤ IntMul.OpenAI.R129.dP n := by
  have h1 := d_half hn
  have h2 := two_le_beps hn
  have : (1 : ℝ) ≤ IntMul.OpenAI.R129.dP n := by linarith
  exact_mod_cast this

end
