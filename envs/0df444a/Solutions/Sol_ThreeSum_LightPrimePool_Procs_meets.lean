                      | omega
                      | ((ring_nf); (omega))))
    · have hp : Nat.Prime (y+i+1) := by
        by_contra hn
        simpa [LightPrimality.answer,hn] using ht
      focus
        ((((first
                | refine Light.Ends.seqSelf ?_
                | refine Light.Ends.skipLast ?_));
            (repeat
                with_unfolding_none
