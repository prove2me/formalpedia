-- title:
--   i.i.d. sequence law, prefix filtration, test supermartingales under $\mathcal P_0$, and the level-$\alpha$ stopping time $\tau_\alpha$
-- statement:
--   For $S\in\Delta_d$ let $S^\infty$ be the law of an i.i.d. sequence $X_1,X_2,\dots$ with marginal $S$, realized on the sequence space $\{1,\dots,d\}^{\mathbb N}$. The **prefix filtration** is $\mathcal F_n=\sigma(X_1,\dots,X_n)$, with $\mathcal F_0$ trivial.
--
--   A process $(M_n)_{n\ge0}$ of functions of the observations is a **test supermartingale under $\mathcal P_0$** if $M_0=1$, $M_n\ge 0$, and for every $R\in\mathcal P_0$ it is a supermartingale with respect to $(\mathcal F_n)$ under $R^\infty$.
--
--   For a wealth process $M$ and a level $\alpha$ the **stopping time** is
--
--   $$\tau_\alpha(M)=\inf\{n\ge1: M_n\ge\alpha^{-1}\},$$
--
--   with $\tau_\alpha(M)=\infty$ if the threshold is never reached.
--
--   These are the probabilistic objects in which validity, power and expected stopping times are stated.
--
--   **Formalization Note** The sequence space is `ℕ → Fin d`, and the paper's $X_t$ is coordinate $t-1$. The filtration is generated by coordinates $0,\dots,n-1$ (not Mathlib's natural filtration, which would include coordinate $n$). $\tau_\alpha$ takes values in $\mathbb N\cup\{\infty\}$.
-- source:
--   A. Saha, A. Ramdas, Beyond least-favorable distribution pairs: asymptotically instance-optimal robust hypothesis testing, arXiv:2611.02130v1, §1.1 pp.3–4; Theorem 2.5 and its proof p.23; eq. (21) p.10

import Mathlib
import Definitions.Def_RobustKellyTV_Setting

open MeasureTheory ProbabilityTheory
open scoped ENNReal

namespace RobustKellyTV

variable {d : ℕ}

/-- The law on `Fin d` with probability mass function `S`: `Σᵢ Sᵢ δᵢ`
(arXiv:2611.02130v1, p.3: "we will denote the probability distributions by their d-dimensional
probability mass functions"). -/
noncomputable def pmfMeasure (S : Fin d → ℝ) : Measure (Fin d) :=
  ∑ i, ENNReal.ofReal (S i) • Measure.dirac i

instance pmfMeasure_isProbability (S : stdSimplex ℝ (Fin d)) :
    IsProbabilityMeasure (pmfMeasure (S : Fin d → ℝ)) := by
  constructor
  simp only [pmfMeasure, Measure.coe_finsetSum, Measure.coe_smul, Finset.sum_apply,
    Pi.smul_apply, measure_univ, smul_eq_mul, mul_one]
  have h := ENNReal.ofReal_sum_of_nonneg (s := Finset.univ) (f := fun i => (S : Fin d → ℝ) i)
    (fun i _ => S.2.1 i)
  have h2 : ∑ i, (S : Fin d → ℝ) i = 1 := S.2.2
  rw [h2, ENNReal.ofReal_one] at h
  exact h.symm

/-- The law of an i.i.d. sequence `X₁, X₂, …` with marginal `S`, on the sequence space
`ℕ → Fin d` (arXiv:2611.02130v1, "i.i.d. observations from S", pp.8, 11).

**Formalization Note.** The paper's observation `X_t` (for `t ≥ 1`) is coordinate `t − 1` of
`ω : ℕ → Fin d`. Every process of the paper is a function of the observed prefix, so the canonical
sequence space changes no instance. -/
noncomputable def seqLaw (S : stdSimplex ℝ (Fin d)) : Measure (ℕ → Fin d) :=
  Measure.infinitePi (fun _ : ℕ => pmfMeasure (S : Fin d → ℝ))

/-- The prefix filtration `F_n = σ(X₁, …, X_n)`: generated by the coordinates `0, …, n − 1` of
`ω : ℕ → Fin d`; `F_0` is trivial (arXiv:2611.02130v1, §1.1, pp.3–4).

**Formalization Note.** Mathlib's natural filtration of the coordinate process would put coordinate
`n` into `F_n`, one observation too many; the prefix filtration is defined directly. -/
noncomputable def prefixFiltration (d : ℕ) :
    Filtration ℕ (MeasurableSpace.pi : MeasurableSpace (ℕ → Fin d)) where
  seq n := ⨆ i ∈ Finset.range n,
    MeasurableSpace.comap (fun ω : ℕ → Fin d => ω i) (inferInstance : MeasurableSpace (Fin d))
  mono' m n hmn := iSup₂_mono' fun i hi =>
    ⟨i, by simp only [Finset.mem_range] at hi ⊢; omega, le_rfl⟩
  le' n := iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

/-- `M` is a **test supermartingale under `P0`** (arXiv:2611.02130v1, §1.1 and Theorems 2.5, 3.2):
`M₀ = 1`, `M` is nonnegative, and under every i.i.d. law `R^∞` with `R ∈ P0` it is a supermartingale
for the prefix filtration (the reading of the proofs on pp.23 and 29: "under every i.i.d. law R∞
with R ∈ P0"). -/
def IsTestSupermartingale (σ : Setting d) (M : ℕ → (ℕ → Fin d) → ℝ) : Prop :=
  (∀ ω, M 0 ω = 1) ∧ (∀ n ω, 0 ≤ M n ω) ∧
    ∀ (R : Fin d → ℝ) (hR : R ∈ nullBall σ),
      Supermartingale M (prefixFiltration d) (seqLaw ⟨R, hR.1⟩)

open Classical in
/-- The level-`α` stopping time `τ_α(M) = inf{n ≥ 1 : M_n ≥ α⁻¹}` (arXiv:2611.02130v1, eq. (21),
p.10), valued in `ℕ∞`, with `τ_α = ∞` when the threshold is never reached. -/
noncomputable def stopTime {Ω : Type*} (M : ℕ → Ω → ℝ) (α : ℝ) (ω : Ω) : ℕ∞ :=
  if h : ∃ n, 1 ≤ n ∧ α⁻¹ ≤ M n ω then (Nat.find h : ℕ∞) else ⊤

end RobustKellyTV


