-- title:
--   §1.3, proof of Theorem 3, p. 5 — lim_{k→∞} ‖x_k − x*‖ exists for every x* ∈ S
-- statement:
--   Let $\mathcal H$, $\Psi$, $\Phi$, $L$, $s$, $\alpha>3$ and the sequence $(x_k)$ generated by algorithm (2) be as in Theorem 3, and let $x^*\in S=\operatorname{argmin}(\Psi+\Phi)$. Then the limit
--
--   $$\lim_{k\to\infty}\|x_k - x^*\|$$
--
--   exists (as a real number).
--
--   This is the first hypothesis of Opial's Lemma: since it holds for every $x^*\in S$, together with the fact that weak cluster points of $(x_k)$ lie in $S$, it yields the weak convergence of $(x_k)$ to a point of $S$ (Theorem 3).
--
--   **Formalization Note** "The limit exists" is the existence of a real $l$ with $\|x_k-x^*\|\to l$. Conventions as in the other items: $L\ge0$, $0<s$, $sL<1$, the proximal map as a map $P$, the run from $k=1$.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 5, §1.3, proof of Theorem 3, last paragraph ("lim ‖x_k − x*‖ exists. Since this holds for any x* ∈ S")

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Weak_Algorithm
open Filter Topology NNReal

namespace NesterovFB.Weak

theorem dist_converges
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : ℝ≥0) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hα : 3 < α)
    (hrun : NesterovFB.Rates.IsAccelFBRun Φ P α s x)
    (xstar : H) (hxstar : ∀ y, NesterovFB.Rates.theta Ψ Φ xstar ≤ NesterovFB.Rates.theta Ψ Φ y) :
    ∃ l : ℝ, Tendsto (fun k => ‖x k - xstar‖) atTop (𝓝 l) := by sorry

end NesterovFB.Weak
