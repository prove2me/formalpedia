open scoped ContDiff
open Matrix
open ExactVacuumAtlas
variable {m : ℕ} {U V : Set (Pt (m + 1))} {Φ : Pt (m + 1) → Pt (m + 1)}
  {J K : Pt (m + 1) → Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ} {g gi h hi : Metric (m + 1)}
theorem solution (hc : CoordChange U V Φ J K) (hne : U.Nonempty)
    (hcert : VacuumCertificate h hi V)
    (hg : ∀ y ∈ U, metricMatrix g y = (J y)ᵀ * metricMatrix h (Φ y) * J y)
    (hgi : ∀ y ∈ U, metricMatrix gi y = K y * metricMatrix hi (Φ y) * (K y)ᵀ) :
    VacuumCertificate g gi U :=
  let hm := MetricData.transport hc hcert.toMetricData hg hgi
  { isOpen := hc.isOpen
    nonempty := hne
    symm := hm.symm
    inv := hm.inv
    smooth := hm.smooth
    smooth_inv := hm.smooth_inv
    lorentz := fun x hx => by
      rw [hg x hx]
      exact isLorentzian_pullback (hc.mul_inv x hx) (hcert.lorentz _ (hc.mapsTo hx))
    ricci_flat := fun x hx b d => by
      rw [ricciOf_transform hc hcert.toMetricData hg hgi hx b d]
      simp [hcert.ricci_flat _ (hc.mapsTo hx)] }
