-- Source module: Solutions.J6SegILPreJ3
/-!
# B-line IL, `J` pre-table (B5-J), part 3: entering and leaving the register file; list reads

* `initP l` / `finiP l`: push `0` on / pop every register of `l` (`rg` at the end): from a state
  with empty registers to `RF 0 c` and back (`initP_sp`, `finiP_sp`, plain `Sp` statements);
* `rdK X j dst`: `dst := (list on X)[j]` through register `9`, temp stack `15`, counter `47`
  (`Rn.rdK`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS

/-! ## Entering and leaving -/

theorem finiP_sp (s : IState HS) : ∀ (l : List (Fin HS)) (c : Cs) (a : Fin HS → ℤ) (W : ℕ),
    l.Nodup → (∀ j ∈ l, j.val < 56) → (∀ j ∈ l, zsz (a j) ≤ W) →
    Sp (finiP l) (encK s (pushL l a c)) (encK s c) (l.length * (2 * W + 2) + 1)
  | [], c, a, _, _, _, _ => by
    have : pushL [] a c = c := by funext j; simp [pushL]
    rw [this]; exact (Sp.skip _).mono (by simp)
  | j :: l, c, a, W, hnd, hl, ha => by
    rw [List.nodup_cons] at hnd
    have h1 := Sp.pop (i := j) (B := W) s (pushL (j :: l) a c) (hl j (by simp))
      (a := a j) (l := c j) (by simp [pushL]) (ha j (by simp))
    have e : Function.update (pushL (j :: l) a c) j (c j) = pushL l a c := by
      funext i
      by_cases hij : i = j
      · subst hij; simp [pushL, hnd.1]
      · simp [pushL, Function.update_of_ne hij, hij]
    rw [e] at h1
    have h2 := finiP_sp s l c a W hnd.2 (fun i hi => hl i (by simp [hi]))
      (fun i hi => ha i (by simp [hi]))
    refine (h1.seq h2).mono ?_
    simp; ring_nf; omega

/-! ## Reading a list entry -/

end J6Seg.PJ

end

