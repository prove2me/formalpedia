  rw [hq, elemA_c₁ T u c₁ huindO huspanO hu_one, ϑ_one hfaith op hop hgen T bO hbO hk θbar Sp i₀ πk hπk hEis]

def op₁ (g : Gen M ↑S) : ↥(AR T ℤ_[p]) := ⟨TC T ℤ_[p] g, Algebra.subset_adjoin ⟨g, rfl⟩⟩

