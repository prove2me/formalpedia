theorem not_dvd_div {p M : ℕ} (hpM : p ∣ M) (hpM2 : ¬ p ^ 2 ∣ M) : ¬ p ∣ M / p := by
  intro h
  apply hpM2
  obtain ⟨c, hc⟩ := h
  refine ⟨c, ?_⟩
  calc M = p * (M / p) := (Nat.mul_div_cancel' hpM).symm
    _ = p ^ 2 * c := by rw [hc]; ring

