  refine ⟨⟨r _ (by decide), r _ (by decide)⟩, ?_, r _ (by decide)⟩
  have h : (Ex.add (.reg 23) (.neg (.mul (.lit 2) bOE))).ok (encK s (RF v c)) :=
    ⟨r _ (by decide), trivial, ok_bOE⟩
  exact ⟨h, by split_ifs <;> trivial⟩

theorem ok_jPE {s : IState HS} {v : Fin HS → ℤ} {c : Fin HS → List ℤ} :
    jPE.ok (encK s (RF v c)) := by
  have r : ∀ j : Fin HS, j ∈ rg → (Ex.reg j).ok (encK s (RF v c)) := fun j hj => isInt_RF hj
  simp only [jPE, mx0, Ex.ok]
  refine ⟨⟨r _ (by decide), r _ (by decide)⟩, ?_, r _ (by decide)⟩
  have h : (Ex.add (.reg 23) (.mul (.lit 2) bOE)).ok (encK s (RF v c)) :=
    ⟨r _ (by decide), trivial, ok_bOE⟩
  exact ⟨h, by split_ifs <;> trivial⟩

theorem upd_ne {w : Fin HS → ℤ} {i j : Fin HS} {x : ℤ} (h : j ≠ i) :
    Function.update w i x j = w j := Function.update_of_ne h _ _

/-- **`am` of the block starting at `c` (on `1`), `n` (on `2`) entries.** -/
theorem amP_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {P R sN tN lam aN A : ℕ}
    (hi : StIn2 v P R sN tN lam aN A) (hPA : P ≤ A) {cN nN : ℕ} (h1 : v 1 = cN) (h2 : v 2 = nN)
    (hn : nN ≤ lam)
    (bX : ∀ k < nN, |expNeg P sN (aN ^ 2 * ((tN : ℤ) - 2 * bOf sN tN cN).toNat * k)| ≤ 2 ^ A)
    (bF : ∀ k < nN, |(mkTables P R sN tN aN).am cN k| ≤ 2 ^ A)
    (bq : ∀ k < lam, |expNeg P sN (2 * aN ^ 2 * tN * (k + 1))| ≤ 2 ^ A)
    (bG : ∀ k ≤ lam, |gamI P sN tN aN k| ≤ 2 ^ A) :
    ∃ v' : Fin HS → ℤ, (∀ j, j ≠ 3 → j ≠ 4 → j ≠ 5 → j ≠ 11 → j ≠ 12 → v' j = v j) ∧ VB v' A ∧
    Sp (amP O) (encK s (RF v c)) (encK s (RF v' (Function.update c O
      (((List.range nN).map ((mkTables P R sN tN aN).am cN)).reverse ++ c O))))
      (cStA A lam jME) :=
  stA_sp s v c hO hO5 hOC hc hi hPA h1 h2 hn (inRg_of (by decide)) (by decide) (by decide)
    (fun u cu => ok_jME) (fun k => aN ^ 2 * ((tN : ℤ) - 2 * bOf sN tN cN).toNat * k)
    (fun k u cu a b c' d e => jME_eval b c' d a e) bX bF bq bG

/-- **`ap` of the block starting at `c` (on `1`), `n` (on `2`) entries.** -/
theorem apP_sp (s : IState HS) (v : Fin HS → ℤ) (c : Fin HS → List ℤ) {O : Fin HS}
    (hO : O ∉ rg) (hO5 : O.val < 56) (hOC : O ≠ Cu) (hc : c Cu = []) {P R sN tN lam aN A : ℕ}
    (hi : StIn2 v P R sN tN lam aN A) (hPA : P ≤ A) {cN nN : ℕ} (h1 : v 1 = cN) (h2 : v 2 = nN)
    (hn : nN ≤ lam)
    (bX : ∀ k < nN, |expNeg P sN (aN ^ 2 * ((tN : ℤ) + 2 * bOf sN tN cN).toNat * k)| ≤ 2 ^ A)
    (bF : ∀ k < nN, |(mkTables P R sN tN aN).ap cN k| ≤ 2 ^ A)
    (bq : ∀ k < lam, |expNeg P sN (2 * aN ^ 2 * tN * (k + 1))| ≤ 2 ^ A)
    (bG : ∀ k ≤ lam, |gamI P sN tN aN k| ≤ 2 ^ A) :
    ∃ v' : Fin HS → ℤ, (∀ j, j ≠ 3 → j ≠ 4 → j ≠ 5 → j ≠ 11 → j ≠ 12 → v' j = v j) ∧ VB v' A ∧
    Sp (apP O) (encK s (RF v c)) (encK s (RF v' (Function.update c O
      (((List.range nN).map ((mkTables P R sN tN aN).ap cN)).reverse ++ c O))))
      (cStA A lam jPE) :=
  stA_sp s v c hO hO5 hOC hc hi hPA h1 h2 hn (inRg_of (by decide)) (by decide) (by decide)
    (fun u cu => ok_jPE) (fun k => aN ^ 2 * ((tN : ℤ) + 2 * bOf sN tN cN).toNat * k)
    (fun k u cu a b c' d e => jPE_eval b c' d a e) bX bF bq bG

end J6Seg.PreT

