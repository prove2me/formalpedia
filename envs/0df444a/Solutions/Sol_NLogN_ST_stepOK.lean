theorem stepArgs_of (M : MulSpec) (K N a b Φf Φm : ℕ) (hK : 20 ≤ K) (hN : n0K K ≤ N) (hn : NumOK K N)
    (ha : a < 2 ^ N) (hb : b < 2 ^ N) (hMf : MulBnd M ((mkParams K N).fn + 1) Φf)
    (hMm : MulBnd M (mmK K N) Φm) :
    StepArgs M K N a b Φf Φm (mmK K N) (mmK K N) Φm (BaccK K N) (BaccK K N) (NLogN.ST.BqT K N) (BxK K N)
      (CSK K N Φm) (CBK K N Φm) (QK K N) (BsK K N) (mkParams K N).b (BcK K N) (BdK K N) (BSf K N) (BBf K N) := by
  have hK1 : 1 ≤ K := by omega
  have hNbig : 2 ^ (2 ^ (8 * K) + 1) ≤ N := (n0K_big K).trans hN
  have pf := Asym.pf_of_large K hK N hNbig
  have hsp := mkParams_s_spec K hK1 N hN
  have hst := mkParams_step K hK1 N hN a b ha hb
  have hTT := CR.T_eq (mkParams K N)
  have hN1 : 1 ≤ N := le_trans (Nat.one_le_two_pow) hNbig
  have hqK : (mkParams K N).K = K := rfl
  have hfn : (mkParams K N).fn = 4 * 2 ^ (mkParams K N).e * (mkParams K N).P := rfl
  have hr : (mkParams K N).r = 2 ^ (mkParams K N).e := rfl
  have hP := pf.P_eq
  have hp := pf.p_eq
  have hlo := pf.lo
  have he1 := pf.e1
  have hPp : (mkParams K N).p ≤ (mkParams K N).P := by omega
  have hKp : 4 * K ≤ (mkParams K N).p := by omega
  have hbp : (mkParams K N).b ≤ (mkParams K N).p := by omega
  have hTp : (mkParams K N).logT ≤ (mkParams K N).p := by omega
  have h2e : 1 ≤ 2 ^ (mkParams K N).e := Nat.one_le_two_pow
  have hPfn : (mkParams K N).P ≤ (mkParams K N).fn := by rw [hfn]; nlinarith
  have hLS : (mkParams K N).L ≤ (mkParams K N).S := by have := (LS_of K N hK hN); have := pf.L1; omega
  have hcrt : CR.CrtOK (mkParams K N).s := ⟨hsp.2.1, hsp.2.2.1⟩
  have hel : (mkParams K N).e ≤ (mkParams K N).logT := by omega
  have hBqs := BD.Bq_size K N hK hNbig
  have LBall := BD.refStep_LB_mkParams K N hK hNbig a b
  refine
    { K1 := hK1, N1 := hN1, ha := ha, hb := hb
      ex := ?_, crt := hcrt, he := he1, hdh := pf.dh
      kb1 := ?_, kb2 := ?_, kbS := (kbS_of K N hK hN), LS := hLS, MoS := (LS_of K N hK hN)
      aL := lt_of_lt_of_le ha (Nat.pow_le_pow_right (by norm_num) pf.NbL)
      bL := lt_of_lt_of_le hb (Nat.pow_le_pow_right (by norm_num) pf.NbL)
      b1 := by have := pf.b_big; have : 1 ≤ 2 ^ (8 * K) := Nat.one_le_two_pow; omega
      kB := (kB_of K N hK hN), chB := (chB_of K N hK hN), pB := by unfold BcK; omega, bigB := (bigB_of K N hK hN)
      kbB := by unfold BcK; omega, bB := by unfold BcK; omega
      dB := by unfold BdK; omega, ppB := (ppB_of K N hK hN), KB := (KB_of K N hK hN), slB := (slB_of K N hK hN), TBd := (TBd_of K N hK hN)
      SBd := (SBd_of K N hK hN), lTBd := by unfold BdK; omega, TB := (TB_of K N hK hN), SB := (SB_of K N hK hN)
      cB := ?_, wB := ?_, wl := wl_of K N hK hN _ _, res := ?_, popB := (popB_of K N hK hN) }
  · -- ExArgs
    refine
      { hMB := hMf, hP := by omega, hK := by omega, hlo := by omega, hkb := by show _ ≤ (mkParams K N).logT + 2; omega
        hMm := hMm, hcfg := ?_, hn := (envN_of K N hK hN)
        hul := by simp [uOf, crtIn_length, Params.S], hvl := by simp [uOf, crtIn_length, Params.S]
        hub := crtIn_zsz _ _ _ _, hvb := crtIn_zsz _ _ _ _
        hmu := by unfold QK; omega
        inU := hn.inU a ha, inV := hn.inU b hb, inW := hn.inW a ha b hb, hS2 := (hS2_of K N hK hN)
        hBQ := by unfold QK; omega
        hSQ := ?_ }
    · refine
        { hM := hMm, hsl := hsp.1, hst := fun i hi => s_le_t K N hK1 hN i hi
          hα := by have := pf.α1; omega, hBx := Nat.lt_size_self _
          sax := hn.sax, bax := hn.bax
          cS := fun k hk => NLogN.ST.sapF_le K N Φm k hk, cB := fun k hk => NLogN.ST.bapF_le K N Φm k hk
          chl := by rw [chirpL_length]; rfl
          chb := ?_, Sm := by rw [hqK]; unfold mmK; omega, Bm := by rw [hqK]; unfold mmK; omega
          mQ := by unfold QK; omega, k := by unfold QK; omega, NQ := ?_ }
      · intro z hz
        have h := BD.chirpL_LB (mkParams K N) z hz
        have hp1 : (mkParams K N).p + 1 ≤ mmK K N := by unfold mmK; omega
        constructor
        · exact (zsz_le_of_lt (lt_of_le_of_lt h.1 (Nat.pow_lt_pow_right (by norm_num)
            (Nat.lt_succ_self _)))).trans hp1
        · exact (zsz_le_of_lt (lt_of_le_of_lt h.2 (Nat.pow_lt_pow_right (by norm_num)
            (Nat.lt_succ_self _)))).trans hp1
      · have : 2 * EX.TT (mkParams K N) = 2 ^ ((mkParams K N).logT + 1) := by
          simp only [EX.TT, hTT, pow_succ]; ring
        rw [this]; push_cast; rw [zsz_two_pow]; unfold QK; omega
    · have : 2 * (mkParams K N).S < 2 ^ ((mkParams K N).logT + 4) := by
        have := (kbS_of K N hK hN)
        have h4 : (2 : ℕ) ^ ((mkParams K N).logT + 4) = 2 ^ ((mkParams K N).logT + 2) * 4 := by
          rw [show (mkParams K N).logT + 4 = (mkParams K N).logT + 2 + 2 by omega, pow_add]; norm_num
        have : 0 < 2 ^ ((mkParams K N).logT + 2) := by positivity
        omega
      exact (zle this).trans (by unfold QK; omega)
  · -- kb1
    unfold kbK at *
    rw [hr, show (mkParams K N).logT + 2 = (mkParams K N).e + (2 + ((mkParams K N).logT - (mkParams K N).e))
      by omega, pow_add, pow_add]
    have : 1 ≤ 2 ^ ((mkParams K N).logT - (mkParams K N).e) := Nat.one_le_two_pow
    nlinarith
  · rw [hTT]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
  · intro x hx
    obtain ⟨h1, h2⟩ := hst.2 x hx
    exact ⟨h1, lt_of_lt_of_le h2 (by
      have : (2 : ℤ) ^ (2 * (mkParams K N).b + (mkParams K N).logT) ≤ 2 ^ BcK K N :=
        pow_le_pow_right₀ (by norm_num) (by unfold BcK; omega)
      exact this)⟩
  · intro x hx
    have h := LBall.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 x hx
    have hs : BD.Bq (mkParams K N) < 2 ^ Nat.size (BD.Bq (mkParams K N)) := Nat.lt_size_self _
    exact zsz_le_of_lt (lt_of_le_of_lt h (lt_of_lt_of_le hs
      (Nat.pow_le_pow_right (by norm_num) (by unfold BcK; omega))))
  · push_cast; exact hst.1

end NLogN.ST

end

