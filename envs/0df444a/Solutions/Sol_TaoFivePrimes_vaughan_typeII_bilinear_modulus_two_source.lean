    calc
      |(j : ℝ) * beta| = (j : ℝ) * |beta| := by
        rw [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (j : ℝ))]
      _ ≤ (j : ℝ) * (1 / (q : ℝ) ^ 2) :=
        mul_le_mul_of_nonneg_left hbeta (by positivity)
      _ ≤ ((q : ℝ) / 2) * (1 / (q : ℝ) ^ 2) :=
        mul_le_mul_of_nonneg_right hjhalfR (by positivity)
