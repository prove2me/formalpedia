  ext a b
  simp only [pdM_apply, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
  rw [pd_comp hV (hB a b) hy hJ i]
  exact Finset.sum_congr rfl fun e _ => mul_comm _ _

