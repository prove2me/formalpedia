private theorem t0024 (x y : 𝔸) (w : InfinitePlace K) : (x * y).1 w = x.1 w * y.1 w := rfl

private theorem t0025 (x y : 𝔸) (w : InfinitePlace K) : (x - y).1 w = x.1 w - y.1 w := rfl

private theorem t0026 (x y : 𝔸) (v : HeightOneSpectrum (𝓞 K)) : (x * y).2 v = x.2 v * y.2 v := rfl

