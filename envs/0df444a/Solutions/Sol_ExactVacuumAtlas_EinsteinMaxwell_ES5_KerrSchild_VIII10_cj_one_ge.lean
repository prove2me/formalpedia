/-! ## The cubic response -/

theorem q3j_contDiffOn (j : ℝ) : ContDiffOn ℝ 1 (q3j j) UG := by
  have h : ContDiffOn ℝ 1 (fun x : ℝ => j ^ 3 * Q3 x) UG :=
    (contDiffOn_const (c := j ^ 3)).mul contDiffOn_one_Q3
  exact h.congr (fun x _ => by unfold q3j; ring)

