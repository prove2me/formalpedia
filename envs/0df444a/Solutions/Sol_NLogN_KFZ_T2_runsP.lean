section
-- Source module: Solutions.R6ZProc
/-!
# Round six, chirp: the table phases in the parametric table

The frozen `KFZWrap` / `KFZProc` table lemmas with `kTable ext` replaced by `IntMul.Kappa.R6.IL.kTableP tab ext`
(the proofs only use the FM multiplier, `IntMul.Kappa.R6.IL.kTableP_mulOK`). Names get a `P` suffix.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFM

open IntMul KFC KFB KFT KIL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

end NLogN.KFM

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM

section Tab

variable {E : ℕ} (tab : Fin 1 → IStmt HS 1) (ext : Fin E → IStmt HS (7 + E)) {I : List Sym} (s : IState HS)
  (F0 : Fin HS → List ℤ) {p h d σ K B : ℕ} (hB : RB p h d σ K B)
include hB

theorem T2_runsP_sol_aux (A : List GI) (hA : A.length = 2 ^ (d * h + σ)) (wA wR : ℕ) (hAB : GB wA A)
    (hRB : GB wR (A.map (KFH.gtr (gV p h d)))) (z w tb ta tt ti : List ℤ) :
    IRuns I (IntMul.Kappa.R6.IL.kTableP tab ext) (T2 E) (encK s (St F0 p h d σ K [] z (gflat A ++ w) tb ta tt ti))
      (encK s (St F0 p h d σ K [] z w (gflat (A.map (KFH.gtr (gV p h d))) ++ tb) ta tt ti))
      (cPush 4 B + ((2 * cMvX (2 * A.length) wA + ((cItem (2 * A.length)
        (3000 * (wA + gV p h d + 3)) (2 * wA + 1) + 2 * cCnt (2 * A.length)) +
        2 * cMvX (2 * A.length) wR)) + cPop 4 B)) := by
  set S0 := St F0 p h d σ K [] z (gflat A ++ w) tb ta tt ti with hS0
  set S1 := St F0 p h d σ K [] z w (gflat (A.map (KFH.gtr (gV p h d))) ++ tb) ta tt ti with hS1
  obtain ⟨k1, -⟩ := (St_regs F0 p h d σ K [] z (gflat A ++ w) tb ta tt ti).sRC (s := s) hB
  obtain ⟨-, k3⟩ := (St_regs F0 p h d σ K [] z w (gflat (A.map (KFH.gtr (gV p h d))) ++ tb)
    ta tt ti).sRC (s := s) hB
  refine wP_runs setRC _ k1 ?_ k3
  set vs : List (Fin HS × ℤ) := [(nX2, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)),
    (nX, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)), (pX2, 0), (pR, 2 ^ gV p h d)] with hvs
  have hn : (vs.map Prod.fst).Nodup := by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))
  have m1 : (nX2, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)) ∈ vs := List.mem_cons_self
  have m2 : (nX, ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ)) ∈ vs :=
    List.mem_cons_of_mem _ List.mem_cons_self
  have m3 : (pX2, (0 : ℤ)) ∈ vs := List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)
  have m4 : (pR, (2 ^ gV p h d : ℤ)) ∈ vs :=
    List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))
  have hlen : ((gflat A).length : ℤ) = ((2 * 2 ^ (d * h + σ) : ℕ) : ℤ) := by
    rw [length_gflat, hA]
  have g0 : (pushF S0 vs) 0 = z := by rw [pushF_apply_ne _ _ 0 (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))), hS0, St_0]
  have gW : (pushF S0 vs) pW = gflat A ++ w := by
    rw [pushF_apply_ne _ _ pW (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))), hS0, St_pW]
  have gB : (pushF S0 vs) qB = tb := by rw [pushF_apply_ne _ _ qB (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))), hS0, St_qB]
  have k1 := mv2W (I := I) (iprog := IntMul.Kappa.R6.IL.kTableP tab ext) pW 0 nX2 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (gflat A) wA hAB.bnd s (pushF S0 vs) w
    (S0 nX2) gW (by rw [pf_top hn m1, hlen])
  set G1 := Function.update (Function.update (pushF S0 vs) pW w) 0 (gflat A ++ (pushF S0 vs) 0) with hG1
  have k2 := roundW (I := I) (iprog := IntMul.Kappa.R6.IL.kTableP tab ext) (gV p h d) wA s G1 (gflat A) ((pushF S0 vs) 0) (S0 pR)
    (S0 pX2) (S0 nX) (by rw [hG1, Function.update_self])
    (by rw [hG1, Function.update_of_ne (by decide), Function.update_of_ne (by decide),
      pf_top hn m4])
    (by rw [hG1, Function.update_of_ne (by decide), Function.update_of_ne (by decide),
      pf_top hn m3])
    hAB.bnd (by rw [zsz_zero]; exact Nat.zero_le _) (by rw [hG1, Function.update_of_ne (by decide),
      Function.update_of_ne (by decide), pf_top hn m2, hlen])
  set L := (gflat A).map (fun x => x.tdiv (2 ^ gV p h d)) with hL
  have hLg : L = gflat (A.map (KFH.gtr (gV p h d))) := by rw [hL, KFH.gflat_map_gtr]
  set G2 := Function.update G1 0 (L ++ (pushF S0 vs) 0) with hG2
  have k3 := mv2W (I := I) (iprog := IntMul.Kappa.R6.IL.kTableP tab ext) 0 qB nX2 (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) L wR (by rw [hLg]; exact hRB.bnd)
    s G2 ((pushF S0 vs) 0) (S0 nX2) (by rw [hG2, Function.update_self])
    (by rw [hG2, Function.update_of_ne (by decide), hG1, Function.update_of_ne (by decide),
      Function.update_of_ne (by decide), pf_top hn m1, hL, List.length_map, hlen])
  rw [length_gflat] at k1 k2
  rw [hL, List.length_map, length_gflat] at k3
  refine ((k1.seq (k2.seq k3)).mono' ?_ le_rfl)
  have e2 : G2 qB = tb := by
    rw [hG2, Function.update_of_ne (by decide), hG1, Function.update_of_ne (by decide),
      Function.update_of_ne (by decide), gB]
  rw [e2, hG2, hG1, Function.update_idem, Function.update_idem, g0, ← KFH.gflat_map_gtr,
    pushF_update _ _ pW _ (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))), pushF_update _ _ 0 _ (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))),
    pushF_update _ _ qB _ (by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))), hS0, St_upd_w, St_upd_z, St_upd_tb]

end Tab

end NLogN.KFZ

