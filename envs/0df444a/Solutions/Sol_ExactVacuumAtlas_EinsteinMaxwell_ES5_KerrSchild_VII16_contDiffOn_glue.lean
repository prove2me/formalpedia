theorem solution (n : ℕ) {L : ℕ → ℝ} {g : ℝ → ℝ} {ε : ℝ} (hε : 0 < ε)
    (hg : ContDiffOn ℝ n g (Ioo (0:ℝ) ε))
    (hlim : ∀ k ≤ n, Tendsto (iteratedDeriv k g) (𝓝[>] (0:ℝ)) (𝓝 (L k))) :
    ContDiffOn ℝ n (glue L n g) (Ioo (-ε) ε) := by
  have hcorr : ContDiffOn ℝ n (fun y => g y - taylorPoly L n y) (Ioo (0:ℝ) ε) :=
    hg.sub (contDiffOn_taylorPoly_any L n n _)
  have hcorrlim : ∀ k ≤ n,
      Tendsto (iteratedDeriv k (fun y => g y - taylorPoly L n y)) (𝓝[>] (0:ℝ)) (𝓝 0) :=
    fun k hk => tendsto_iteratedDeriv_sub_taylor hε hk hg (hlim k hk)
  have hflat := contDiffOn_flatExt n hε hcorr hcorrlim
  have hpoly : ContDiffOn ℝ n (taylorPoly L n) (Ioo (-ε) ε) :=
    contDiffOn_taylorPoly_any L n n _
  have hadd : ContDiffOn ℝ n
      (fun x => taylorPoly L n x + flatExt (fun y => g y - taylorPoly L n y) x)
      (Ioo (-ε) ε) := hpoly.add hflat
  exact hadd
