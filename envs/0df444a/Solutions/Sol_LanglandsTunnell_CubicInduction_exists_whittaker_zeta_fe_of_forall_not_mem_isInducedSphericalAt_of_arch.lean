open MeasureTheory

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} {f : X → ℂ} {m : X → ℝ}

omit [MeasurableSpace X] in

private theorem norm_mul_cpow (hm : ∀ x, 0 < m x) (x : X) (s : ℂ) :
    ‖f x * ((m x : ℝ) : ℂ) ^ (s - 1)‖ = ‖f x‖ * m x ^ (s.re - 1) := by
  rw [norm_mul, Complex.norm_cpow_eq_rpow_re_of_pos (hm x), Complex.sub_re, Complex.one_re]

private theorem rpow_sub_one_le_add {a : ℝ} (ha : 0 < a) {α β σ : ℝ} (hασ : α ≤ σ) (hσβ : σ ≤ β) :
    a ^ (σ - 1) ≤ a ^ (α - 1) + a ^ (β - 1) := by
  rcases le_or_gt a 1 with h1 | h1
  · calc a ^ (σ - 1) ≤ a ^ (α - 1) := Real.rpow_le_rpow_of_exponent_ge ha h1 (by linarith)
      _ ≤ a ^ (α - 1) + a ^ (β - 1) := le_add_of_nonneg_right (Real.rpow_nonneg ha.le _)
  · calc a ^ (σ - 1) ≤ a ^ (β - 1) := Real.rpow_le_rpow_of_exponent_le h1.le (by linarith)
      _ ≤ a ^ (α - 1) + a ^ (β - 1) := le_add_of_nonneg_left (Real.rpow_nonneg ha.le _)

private theorem integrable_norm_mul_rpow (hm : ∀ x, 0 < m x) {α : ℝ}
    (hα : Integrable (fun x => f x * ((m x : ℝ) : ℂ) ^ ((α : ℂ) - 1)) μ) :
    Integrable (fun x => ‖f x‖ * m x ^ (α - 1)) μ := by
  refine hα.norm.congr (Filter.Eventually.of_forall fun x => ?_)
  show ‖f x * ((m x : ℝ) : ℂ) ^ ((α : ℂ) - 1)‖ = ‖f x‖ * m x ^ (α - 1)
  rw [norm_mul_cpow hm x (α : ℂ), Complex.ofReal_re]

private theorem exists_forall_norm_integral_mul_cpow_le (hm : ∀ x, 0 < m x) {α β : ℝ}
    (hα : Integrable (fun x => f x * ((m x : ℝ) : ℂ) ^ ((α : ℂ) - 1)) μ)
    (hβ : Integrable (fun x => f x * ((m x : ℝ) : ℂ) ^ ((β : ℂ) - 1)) μ) :
    ∃ C : ℝ, ∀ s : ℂ, α ≤ s.re → s.re ≤ β → ‖∫ x, f x * ((m x : ℝ) : ℂ) ^ (s - 1) ∂μ‖ ≤ C := by
  have hα' := integrable_norm_mul_rpow hm hα
  have hβ' := integrable_norm_mul_rpow hm hβ
  refine ⟨(∫ x, ‖f x‖ * m x ^ (α - 1) ∂μ) + ∫ x, ‖f x‖ * m x ^ (β - 1) ∂μ, fun s hαs hsβ => ?_⟩
  calc ‖∫ x, f x * ((m x : ℝ) : ℂ) ^ (s - 1) ∂μ‖
      ≤ ∫ x, ‖f x * ((m x : ℝ) : ℂ) ^ (s - 1)‖ ∂μ := norm_integral_le_integral_norm _
    _ ≤ ∫ x, (‖f x‖ * m x ^ (α - 1) + ‖f x‖ * m x ^ (β - 1)) ∂μ := by
        refine integral_mono_of_nonneg (Filter.Eventually.of_forall fun x => norm_nonneg _) (hα'.add hβ')
          (Filter.Eventually.of_forall fun x => ?_)
        show ‖f x * ((m x : ℝ) : ℂ) ^ (s - 1)‖ ≤ ‖f x‖ * m x ^ (α - 1) + ‖f x‖ * m x ^ (β - 1)
        rw [norm_mul_cpow hm x s, ← mul_add]
        exact mul_le_mul_of_nonneg_left (rpow_sub_one_le_add (hm x) hαs hsβ) (norm_nonneg _)
    _ = (∫ x, ‖f x‖ * m x ^ (α - 1) ∂μ) + ∫ x, ‖f x‖ * m x ^ (β - 1) ∂μ := integral_add hα' hβ'

private theorem exists_forall_norm_integral_mul_cpow_le_of_forall (hm : ∀ x, 0 < m x) {α β : ℝ}
    (h : ∀ σ : ℝ, α ≤ σ → σ ≤ β → Integrable (fun x => f x * ((m x : ℝ) : ℂ) ^ ((σ : ℂ) - 1)) μ) :
    ∃ C : ℝ, ∀ s : ℂ, α ≤ s.re → s.re ≤ β → ‖∫ x, f x * ((m x : ℝ) : ℂ) ^ (s - 1) ∂μ‖ ≤ C := by
  rcases le_or_gt α β with hαβ | hβα
  · exact exists_forall_norm_integral_mul_cpow_le hm (h α le_rfl hαβ) (h β hαβ le_rfl)
  · exact ⟨0, fun s hαs hsβ => absurd (hαs.trans hsβ) (not_le.mpr hβα)⟩

end LanglandsTunnell.CubicInduction.StripBound

