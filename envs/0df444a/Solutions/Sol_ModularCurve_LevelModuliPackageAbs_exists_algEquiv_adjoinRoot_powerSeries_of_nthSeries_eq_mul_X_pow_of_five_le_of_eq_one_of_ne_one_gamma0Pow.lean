section S3_sec

open IsLocalRing Polynomial FormalGroup

theorem glue_S3
    (q : ℕ) [Fact q.Prime]
    (S : Type) [CommRing S] [IsDomain S] [IsLocalRing S] [IsNoetherianRing S] [IsAdicComplete (maximalIdeal S) S]
    (k : Type) [Field k] (resS : S →+* k) (hresS : Function.Surjective resS) (hkerS : RingHom.ker resS = maximalIdeal S)
    (V : WeierstrassCurve S) [V.IsElliptic]

    (hord : ∀ F' : FormalGroup k, F'.toPowerSeries = (V.map resS).formalGroupLawFixed →
      ∃ u : PowerSeries k, IsUnit u ∧ F'.nthSeries q = u * PowerSeries.X ^ q) :
    ∃ (g : S[X]) (v : PowerSeries S), g.Monic ∧ g.natDegree = q - 1 ∧
      (∀ i < q - 1, g.coeff i ∈ maximalIdeal S) ∧
      (∃ w : S, IsUnit w ∧ g.coeff 0 = (q : S) * w) ∧ IsUnit v ∧
      V.formalGroup.nthSeries q = PowerSeries.X * (↑g : PowerSeries S) * v := by
  classical
  set F : FormalGroup S := V.formalGroup with hF

  have hlaw : (F.map resS).toPowerSeries = (V.map resS).formalGroupLawFixed := by
    rw [FormalGroup.map_toPowerSeries, (V.formalW_map_and_formalGroupLawFixed_map resS).2]; rfl
  obtain ⟨u, hu, hq⟩ := hord (F.map resS) hlaw
  have hbc : F.IsBaseChange resS (F.map resS) := rfl
  have hmap : PowerSeries.map resS (F.nthSeries q) = u * PowerSeries.X ^ q := by
    rw [← FormalGroup.IsBaseChange.nthSeries_eq_map F resS (F.map resS) hbc q, hq]

  have hker' : RingHom.ker resS = RingHom.ker (residue S) := by rw [hkerS, ker_residue]

  let ē : ResidueField S ≃+* k :=
    (Ideal.quotEquivOfEq (hkerS.symm)).trans (RingHom.quotientKerEquivOfSurjective hresS)
  have hē : ∀ s : S, ē (residue S s) = resS s := by
    intro s; rfl
  have hcomp : (ē.symm : k →+* ResidueField S).comp resS = residue S := by
    ext s; simp [← hē]
  have hF' : ∃ u' : PowerSeries (ResidueField S), IsUnit u' ∧
      PowerSeries.map (residue S) (F.nthSeries q) = u' * PowerSeries.X ^ q := by
    refine ⟨PowerSeries.map (ē.symm : k →+* ResidueField S) u, hu.map _, ?_⟩
    rw [← hcomp, PowerSeries.map_comp, RingHom.comp_apply, hmap, map_mul, map_pow, PowerSeries.map_X]
  exact FormalGroup.exists_monic_isUnit_nthSeries_eq_X_mul_mul_of_map_residue_eq_mul_X_pow S q F hF'

