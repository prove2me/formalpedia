theorem clebschCoefficient_sq_harmonic_balance
    {w N p q t : ℕ}
    (hsupport : 2 * p + t ≤ w)
    (hcomplement : 2 * q + t ≤ N) :
    (∑ r : Fin (t + 1),
      clebschCoefficient w N p q t r.val ^ 2 *
