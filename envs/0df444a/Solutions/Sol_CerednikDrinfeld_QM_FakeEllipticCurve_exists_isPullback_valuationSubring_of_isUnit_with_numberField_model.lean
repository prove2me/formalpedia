theorem mul_val_congr {R : Type u} [CommRing R] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {T : Scheme.{u}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of R)} (h : t₁ = t₂)
    (P₁ Q₁ : SchemeHomOver t₁ f) (P₂ Q₂ : SchemeHomOver t₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul t₁ P₁ Q₁).1 = (L.mul t₂ P₂ Q₂).1 := by
  subst h
  obtain rfl : P₁ = P₂ := Subtype.ext hP
  obtain rfl : Q₁ = Q₂ := Subtype.ext hQ
  rfl

theorem paste_exposed {S₀ S₁ S₂ : Type u} [CommRing S₀] [CommRing S₁] [CommRing S₂]
    (φ : S₀ →+* S₁) (ψ : S₁ →+* S₂)
    (E₀ : FakeEllipticCurve Λ N S₀) (E₁ : FakeEllipticCurve Λ N S₁) (E₂ : FakeEllipticCurve Λ N S₂)
    (g : E₁.A ⟶ E₀.A) (hg : CategoryTheory.IsPullback g E₁.f E₀.f (Spec.map (CommRingCat.ofHom φ)))
    (hg_mul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P Q : SchemeHomOver t' E₁.f),
        (E₁.L.mul t' P Q).1 ≫ g =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1)
    (hg_act : ∀ x : ↥Λ, E₁.act x ≫ g = g ≫ E₀.act x)
    (hg_lev' : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        (∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) → FactorsThrough E₁.lev P)
    (g₀ : E₂.A ⟶ E₀.A) (hg₀ : CategoryTheory.IsPullback g₀ E₂.f E₀.f (Spec.map (CommRingCat.ofHom (ψ.comp φ))))
    (h₀mul : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P Q : SchemeHomOver t' E₂.f),
        (E₂.L.mul t' P Q).1 ≫ g₀ =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ψ.comp φ)))
            ⟨P.1 ≫ g₀, by rw [Category.assoc, hg₀.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g₀, by rw [Category.assoc, hg₀.w, ← Category.assoc, Q.2]⟩).1)
    (h₀act : ∀ x : ↥Λ, E₂.act x ≫ g₀ = g₀ ≫ E₀.act x)
    (h₀lev : ∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P : SchemeHomOver t' E₂.f),
        FactorsThrough E₂.lev P → ∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g₀) :
    ∃ (e : E₂.A ⟶ E₁.A) (he : CategoryTheory.IsPullback e E₂.f E₁.f (Spec.map (CommRingCat.ofHom ψ))),
      e ≫ g = g₀ ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P Q : SchemeHomOver t' E₂.f),
        (E₂.L.mul t' P Q).1 ≫ e =
          (E₁.L.mul (t' ≫ Spec.map (CommRingCat.ofHom ψ))
            ⟨P.1 ≫ e, by rw [Category.assoc, he.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ e, by rw [Category.assoc, he.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E₂.act x ≫ e = e ≫ E₁.act x) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₂)) (P : SchemeHomOver t' E₂.f),
        FactorsThrough E₂.lev P → ∃ P₁ : T ⟶ E₁.C, P₁ ≫ E₁.lev = P.1 ≫ e) := by

  have hcomp : Spec.map (CommRingCat.ofHom (ψ.comp φ)) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]

  have hw : g₀ ≫ E₀.f = (E₂.f ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [hg₀.w, hcomp, Category.assoc]
  let e : E₂.A ⟶ E₁.A := hg.lift g₀ (E₂.f ≫ Spec.map (CommRingCat.ofHom ψ)) hw
  have he₁ : e ≫ g = g₀ := hg.lift_fst _ _ _
  have he₂ : e ≫ E₁.f = E₂.f ≫ Spec.map (CommRingCat.ofHom ψ) := hg.lift_snd _ _ _

  have hsq : CategoryTheory.IsPullback e E₂.f E₁.f (Spec.map (CommRingCat.ofHom ψ)) := by
    refine CategoryTheory.IsPullback.of_right ?_ he₂ hg
    rw [he₁, ← hcomp]
    exact hg₀
  refine ⟨e, hsq, he₁, ?_, ?_, ?_⟩
  ·
    intro T t' P Q
    apply hg.hom_ext
    · rw [Category.assoc, he₁, h₀mul t' P Q, hg_mul]
      apply mul_val_congr E₀.L
      · rw [Category.assoc, hcomp]
      · show P.1 ≫ g₀ = (P.1 ≫ e) ≫ g
        rw [Category.assoc, he₁]
      · show Q.1 ≫ g₀ = (Q.1 ≫ e) ≫ g
        rw [Category.assoc, he₁]
    ·
      conv_lhs => rw [Category.assoc, he₂, ← Category.assoc, (E₂.L.mul t' P Q).2]
      exact ((E₁.L.mul _ _ _).2).symm
  ·
    intro x
    apply hg.hom_ext
    · rw [Category.assoc, he₁, h₀act x, Category.assoc, hg_act x, ← Category.assoc, he₁]
    · rw [Category.assoc, he₂, ← Category.assoc, E₂.act_over x, Category.assoc, E₁.act_over x, he₂]
  ·
    intro T t' P hP
    obtain ⟨P₀, hP₀⟩ := h₀lev t' P hP
    exact hg_lev' (t' ≫ Spec.map (CommRingCat.ofHom ψ))
      ⟨P.1 ≫ e, by rw [Category.assoc, he₂, ← Category.assoc, P.2]⟩ ⟨P₀, by rw [hP₀, Category.assoc, he₁]⟩

theorem exists_baseChange_paste {S₀ S₁ S₂ : Type u} [CommRing S₀] [CommRing S₁] [CommRing S₂]
    (φ : S₀ →+* S₁) (ψ : S₁ →+* S₂) (E₀ : FakeEllipticCurve Λ N S₀) (E₂ : FakeEllipticCurve Λ N S₂)
    (h₀₂ : FakeEllipticCurve.IsPullback (ψ.comp φ) E₀ E₂) :
    ∃ (E₁ : FakeEllipticCurve Λ N S₁) (g : E₁.A ⟶ E₀.A)
      (hg : CategoryTheory.IsPullback g E₁.f E₀.f (Spec.map (CommRingCat.ofHom φ))),
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P Q : SchemeHomOver t' E₁.f),
        (E₁.L.mul t' P Q).1 ≫ g =
          (E₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E₁.act x ≫ g = g ≫ E₀.act x) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        FactorsThrough E₁.lev P → ∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) ∧
      (∀ {T : Scheme.{u}} (t' : T ⟶ Spec (CommRingCat.of S₁)) (P : SchemeHomOver t' E₁.f),
        (∃ P₀ : T ⟶ E₀.C, P₀ ≫ E₀.lev = P.1 ≫ g) → FactorsThrough E₁.lev P) ∧
      FakeEllipticCurve.IsPullback φ E₀ E₁ ∧ FakeEllipticCurve.IsPullback ψ E₁ E₂ := by
  obtain ⟨E₁, g, hg, hmul, hact, hlev, hlev'⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff φ E₀
  obtain ⟨g₀, hg₀, h₀mul, h₀act, h₀lev⟩ := h₀₂
  obtain ⟨e, he, -, hemul, heact, helev⟩ :=
    paste_exposed φ ψ E₀ E₁ E₂ g hg hmul hact hlev' g₀ hg₀ h₀mul h₀act h₀lev
  exact ⟨E₁, g, hg, hmul, hact, hlev, hlev', ⟨g, hg, hmul, hact, hlev⟩, ⟨e, he, hemul, heact, helev⟩⟩

theorem exists_witnesses
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hu : IsUnit (((N * q * q' : ℕ) : ℤ) : ↥B))
    (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (ι : ∀ K' : IntermediateField ℚ (AlgebraicClosure ℚ), ↥(B.toSubring ⊓ K'.toSubring) →+* ↥B)
    (hι : ∀ K' : IntermediateField ℚ (AlgebraicClosure ℚ),
      (B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (ι K') = (B.toSubring ⊓ K'.toSubring).subtype) :
    ∃ (K : IntermediateField ℚ (AlgebraicClosure ℚ)) (_ : FiniteDimensional ℚ K)
      (E₀ : FakeEllipticCurve Λ N K)
      (_ : FakeEllipticCurve.IsPullback (algebraMap K (AlgebraicClosure ℚ)) E₀ E)
      (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (_ : FiniteDimensional ℚ K') (_ : K ≤ K')
      (𝒜₀ : FakeEllipticCurve Λ N ↥(B.toSubring ⊓ K'.toSubring))
      (_ : FakeEllipticCurve.IsPullback (B.toSubring ⊓ K'.toSubring).subtype 𝒜₀ E)
      (𝒜 : FakeEllipticCurve Λ N ↥B) (g : 𝒜.A ⟶ 𝒜₀.A)
      (hg : CategoryTheory.IsPullback g 𝒜.f 𝒜₀.f (Spec.map (CommRingCat.ofHom (ι K')))),
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P Q : SchemeHomOver t' 𝒜.f),
        (𝒜.L.mul t' P Q).1 ≫ g =
          (𝒜₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ι K')))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, 𝒜.act x ≫ g = g ≫ 𝒜₀.act x) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P : SchemeHomOver t' 𝒜.f),
        FactorsThrough 𝒜.lev P → ∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P : SchemeHomOver t' 𝒜.f),
        (∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g) → FactorsThrough 𝒜.lev P) ∧
      FakeEllipticCurve.IsPullback (ι K') 𝒜₀ 𝒜 ∧
      FakeEllipticCurve.IsPullback (B.subtype : ↥B →+* AlgebraicClosure ℚ) 𝒜 E := by

  obtain ⟨K, hK, E₀, hE⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_intermediateField_finiteDimensional_isPullback_algebraMap_of_fg
      Λ hΛ.isOrder.fg N E

  obtain ⟨K', hK', hKK', 𝒜₀, h₀⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_valuationSubring_inf_of_isPullback_algebraMap_of_isUnit
      hqN hq'N hqq' hB Λ hΛ K E₀ E hE B hu

  have h₀' : FakeEllipticCurve.IsPullback ((B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (ι K')) 𝒜₀ E := by
    rw [hι K']
    exact h₀
  obtain ⟨𝒜, g, hg, hmul, hact, hlev, hlev', h₁, h₂⟩ := exists_baseChange_paste (ι K') B.subtype 𝒜₀ E h₀'
  exact ⟨K, hK, E₀, hE, K', hK', hKK', 𝒜₀, h₀, 𝒜, g, hg, hmul, hact, hlev, hlev', h₁, h₂⟩

theorem exists_witnesses_via
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hu : IsUnit (((N * q * q' : ℕ) : ℤ) : ↥B))
    (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (R : IntermediateField ℚ (AlgebraicClosure ℚ) → Type) [∀ K', CommRing (R K')]
    (ρ : ∀ K' : IntermediateField ℚ (AlgebraicClosure ℚ), ↥(B.toSubring ⊓ K'.toSubring) →+* R K')
    (τ : ∀ K' : IntermediateField ℚ (AlgebraicClosure ℚ), R K' →+* ↥B)
    (hρτ : ∀ K' : IntermediateField ℚ (AlgebraicClosure ℚ),
      ((B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (τ K')).comp (ρ K') = (B.toSubring ⊓ K'.toSubring).subtype) :
    ∃ (K : IntermediateField ℚ (AlgebraicClosure ℚ)) (_ : FiniteDimensional ℚ K)
      (E₀ : FakeEllipticCurve Λ N K)
      (_ : FakeEllipticCurve.IsPullback (algebraMap K (AlgebraicClosure ℚ)) E₀ E)
      (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (_ : FiniteDimensional ℚ K') (_ : K ≤ K')
      (𝒜₀ : FakeEllipticCurve Λ N ↥(B.toSubring ⊓ K'.toSubring))
      (_ : FakeEllipticCurve.IsPullback (B.toSubring ⊓ K'.toSubring).subtype 𝒜₀ E)

      (𝒜₁ : FakeEllipticCurve Λ N (R K')) (g₁ : 𝒜₁.A ⟶ 𝒜₀.A)
      (hg₁ : CategoryTheory.IsPullback g₁ 𝒜₁.f 𝒜₀.f (Spec.map (CommRingCat.ofHom (ρ K'))))
      (_ : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (R K'))) (P Q : SchemeHomOver t' 𝒜₁.f),
        (𝒜₁.L.mul t' P Q).1 ≫ g₁ =
          (𝒜₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (ρ K')))
            ⟨P.1 ≫ g₁, by rw [Category.assoc, hg₁.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g₁, by rw [Category.assoc, hg₁.w, ← Category.assoc, Q.2]⟩).1)
      (_ : ∀ x : ↥Λ, 𝒜₁.act x ≫ g₁ = g₁ ≫ 𝒜₀.act x)
      (_ : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (R K'))) (P : SchemeHomOver t' 𝒜₁.f),
        FactorsThrough 𝒜₁.lev P → ∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g₁)
      (_ : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of (R K'))) (P : SchemeHomOver t' 𝒜₁.f),
        (∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g₁) → FactorsThrough 𝒜₁.lev P)
      (_ : FakeEllipticCurve.IsPullback (ρ K') 𝒜₀ 𝒜₁)
      (_ : FakeEllipticCurve.IsPullback ((B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (τ K')) 𝒜₁ E)

      (𝒜 : FakeEllipticCurve Λ N ↥B) (g : 𝒜.A ⟶ 𝒜₁.A)
      (hg : CategoryTheory.IsPullback g 𝒜.f 𝒜₁.f (Spec.map (CommRingCat.ofHom (τ K')))),
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P Q : SchemeHomOver t' 𝒜.f),
        (𝒜.L.mul t' P Q).1 ≫ g =
          (𝒜₁.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (τ K')))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, 𝒜.act x ≫ g = g ≫ 𝒜₁.act x) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P : SchemeHomOver t' 𝒜.f),
        FactorsThrough 𝒜.lev P → ∃ P₀ : T ⟶ 𝒜₁.C, P₀ ≫ 𝒜₁.lev = P.1 ≫ g) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥B)) (P : SchemeHomOver t' 𝒜.f),
        (∃ P₀ : T ⟶ 𝒜₁.C, P₀ ≫ 𝒜₁.lev = P.1 ≫ g) → FactorsThrough 𝒜.lev P) ∧
      FakeEllipticCurve.IsPullback (τ K') 𝒜₁ 𝒜 ∧
      FakeEllipticCurve.IsPullback (B.subtype : ↥B →+* AlgebraicClosure ℚ) 𝒜 E := by

  obtain ⟨K, hK, E₀, hE⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_intermediateField_finiteDimensional_isPullback_algebraMap_of_fg
      Λ hΛ.isOrder.fg N E

  obtain ⟨K', hK', hKK', 𝒜₀, h₀⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_valuationSubring_inf_of_isPullback_algebraMap_of_isUnit
      hqN hq'N hqq' hB Λ hΛ K E₀ E hE B hu

  have h₀' : FakeEllipticCurve.IsPullback
      (((B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (τ K')).comp (ρ K')) 𝒜₀ E := by
    rw [hρτ K']
    exact h₀
  obtain ⟨𝒜₁, g₁, hg₁, hmul₁, hact₁, hlev₁, hlev₁', h₁₁, h₂₁⟩ :=
    exists_baseChange_paste (ρ K') ((B.subtype : ↥B →+* AlgebraicClosure ℚ).comp (τ K')) 𝒜₀ E h₀'

  obtain ⟨𝒜, g, hg, hmul, hact, hlev, hlev', h₁, h₂⟩ := exists_baseChange_paste (τ K') B.subtype 𝒜₁ E h₂₁
  exact ⟨K, hK, E₀, hE, K', hK', hKK', 𝒜₀, h₀, 𝒜₁, g₁, hg₁, hmul₁, hact₁, hlev₁, hlev₁', h₁₁, h₂₁,
    𝒜, g, hg, hmul, hact, hlev, hlev', h₁, h₂⟩

def toField (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    ↥(B.toSubring ⊓ K'.toSubring) →+* ↥K' where
  toFun x := ⟨x.1, x.2.2⟩
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl

theorem algebraMap_comp_toField (B : ValuationSubring (AlgebraicClosure ℚ))
    (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) :
    (algebraMap (↥K') (AlgebraicClosure ℚ)).comp (toField B K') = (B.toSubring ⊓ K'.toSubring).subtype :=
  RingHom.ext fun _ => rfl

theorem exists_numberField_model
    (B : ValuationSubring (AlgebraicClosure ℚ)) (K' : IntermediateField ℚ (AlgebraicClosure ℚ))
    (𝒜₀ : FakeEllipticCurve Λ N ↥(B.toSubring ⊓ K'.toSubring)) (E : FakeEllipticCurve Λ N (AlgebraicClosure ℚ))
    (h₀ : FakeEllipticCurve.IsPullback (B.toSubring ⊓ K'.toSubring).subtype 𝒜₀ E) :
    ∃ (E₀' : FakeEllipticCurve Λ N ↥K') (g : E₀'.A ⟶ 𝒜₀.A)
      (hg : CategoryTheory.IsPullback g E₀'.f 𝒜₀.f (Spec.map (CommRingCat.ofHom (toField B K')))),
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (P Q : SchemeHomOver t' E₀'.f),
        (E₀'.L.mul t' P Q).1 ≫ g =
          (𝒜₀.L.mul (t' ≫ Spec.map (CommRingCat.ofHom (toField B K')))
            ⟨P.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, P.2]⟩
            ⟨Q.1 ≫ g, by rw [Category.assoc, hg.w, ← Category.assoc, Q.2]⟩).1) ∧
      (∀ x : ↥Λ, E₀'.act x ≫ g = g ≫ 𝒜₀.act x) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (P : SchemeHomOver t' E₀'.f),
        FactorsThrough E₀'.lev P → ∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g) ∧
      (∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of ↥K')) (P : SchemeHomOver t' E₀'.f),
        (∃ P₀ : T ⟶ 𝒜₀.C, P₀ ≫ 𝒜₀.lev = P.1 ≫ g) → FactorsThrough E₀'.lev P) ∧
      FakeEllipticCurve.IsPullback (toField B K') 𝒜₀ E₀' ∧
      FakeEllipticCurve.IsPullback (algebraMap (↥K') (AlgebraicClosure ℚ)) E₀' E := by
  have h₀' : FakeEllipticCurve.IsPullback ((algebraMap (↥K') (AlgebraicClosure ℚ)).comp (toField B K')) 𝒜₀ E := by
    rw [algebraMap_comp_toField]
    exact h₀
  exact exists_baseChange_paste (toField B K') (algebraMap (↥K') (AlgebraicClosure ℚ)) 𝒜₀ E h₀'

end CerednikDrinfeld.QM.FakeEllipticCurve.GoodRedWitness

open CerednikDrinfeld.QM.FakeEllipticCurve.GoodRedWitness in
theorem solution
    {N q q' : ℕ} [NeZero N] [Fact q.Prime] [Fact q'.Prime] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) :
    ∀ (B : ValuationSubring (AlgebraicClosure ℚ)), IsUnit (((N * q * q' : ℕ) : ℤ) : ↥B) →
      ∀ E : CerednikDrinfeld.QM.FakeEllipticCurve Λ N (AlgebraicClosure ℚ),
        ∃ (𝒜 : CerednikDrinfeld.QM.FakeEllipticCurve Λ N ↥B)
          (K' : IntermediateField ℚ (AlgebraicClosure ℚ)) (_ : FiniteDimensional ℚ ↥K')
          (ι₀ : ↥(B.toSubring ⊓ K'.toSubring) →+* ↥B)
          (_ : ∀ x : ↥(B.toSubring ⊓ K'.toSubring), (ι₀ x : AlgebraicClosure ℚ) = (x : AlgebraicClosure ℚ))
          (𝒜₀ : CerednikDrinfeld.QM.FakeEllipticCurve Λ N ↥(B.toSubring ⊓ K'.toSubring)),
          CerednikDrinfeld.QM.FakeEllipticCurve.IsPullback (B.subtype : ↥B →+* AlgebraicClosure ℚ) 𝒜 E ∧
