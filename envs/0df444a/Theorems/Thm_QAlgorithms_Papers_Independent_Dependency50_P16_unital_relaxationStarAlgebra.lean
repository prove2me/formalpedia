-- title:
--   Lemma 5.2: Relaxation algebra of a unital generator is a star algebra
-- statement:
--   If a GKSL generator $G=-L$ on $\mathbb C^n$, $n\ge2$, is unital, then
--
--   $$S\in\operatorname{Lat}(\mathcal V)\Longrightarrow S^\perp\in\operatorname{Lat}(\mathcal V),\qquad\mathcal V^*=\mathcal V.$$
--
--   Here $\mathcal V$ is the unital associative algebra generated by the jumps. The invariant-subspace lattice includes zero and the whole Hilbert space. No converse is asserted.
-- source:
--   Reachability, Coolability, and Stabilizability of Open Markovian Quantum Systems with Fast Unitary Control, arXiv:2308.00561v1, PDF p. 23, Lemma 5.2: Relaxation algebra of a unital generator is a star algebra

import Definitions.Def_QAlgorithms_Papers_Independent_Dependency50_P16

noncomputable section

open scoped BigOperators Matrix ComplexConjugate ENNReal NNReal Matrix.Norms.L2Operator

open MeasureTheory Filter

attribute [local instance] Classical.propDecidable Classical.decEq

attribute [local instance 100] LieRing.ofAssociativeRing

namespace QAlgorithms.Papers.Independent.Dependency50.P16

local notation "Mat" => fun n : ℕ => Matrix (Fin n) (Fin n) ℂ

local notation "Vec" => fun n : ℕ => Fin n → ℝ

local notation "Hilbert" => fun n : ℕ => EuclideanSpace ℂ (Fin n)

local notation "Operator" => fun n : ℕ => Module.End ℂ (Mat n)

/-- arXiv:2308.00561v1, PDF p.23, Lemma 5.2: Relaxation algebra of a unital generator is a star algebra. Orthocomplement means the Hilbert-space orthogonal complement. The lattice is extended by zero as in footnote 23; named lazy subspaces remain nonzero. -/
theorem unital_relaxationStarAlgebra {n : ℕ} (hn : 2 ≤ n) (D : LindbladData n)
    (h : unital D) :
    (∀ S : Submodule ℂ (Hilbert n), invariant (relaxationAlgebra D.jump : Set (Mat n)) S →
      invariant (relaxationAlgebra D.jump : Set (Mat n)) Sᗮ) ∧
    starClosed (relaxationAlgebra D.jump) := by sorry

end QAlgorithms.Papers.Independent.Dependency50.P16

end
