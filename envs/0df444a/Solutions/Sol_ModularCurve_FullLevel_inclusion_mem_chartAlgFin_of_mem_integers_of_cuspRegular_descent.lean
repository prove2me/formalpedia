  have hfcoe : ((e.symm (Φ ⟨_, hF⟩) : ↥(laurentBaseChange ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (xHFunctionField (q ^ 2 * M') (levelH q M')))) : LaurentSeries ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))) = coeffEmb ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) g := by
    apply E153C.coeffMap_injective (algebraMap ↥(⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) (AlgebraicClosure ℚ)) hinjB
    rw [← he, e.apply_symm_apply, hΦ]
