theorem GlobalTheory.WachTie.coord_apply (R : Fr l O) (jE : (ZMod n → R.EE) →ₐ[O] W.EE) (T : LocLat G Qp LL O) {r : ℕ}
    (b : Fin r → W.DD T) (x : DD R n r) :
    coord W R jE T b x = ∑ k, jE (fun i => x i k) • b k := by sorry
