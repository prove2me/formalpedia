  simp only [localOf, Units.coe_map, MonoidHom.coe_coe, RingHom.toMonoidHom_eq_coe, Units.val_neg, map_neg,
    Valuation.map_neg]

private theorem t0905 (d : JLData K S epsS ω) (v : HeightOneSpectrum (𝓞 K)) :
    ∃ (a : ℤ) (u : v.adicCompletion K), Valued.v u = 1 ∧
      ((localOf K v (-d.A) : (v.adicCompletion K)ˣ) : v.adicCompletion K)
