theorem rootBasisPrepare_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (E : RAMEnv) (s : RAMState) (j : Fin w) (count : ℕ)
    (hmeta : (111 : ℕ) < 2 ^ E.W) (hwe : w ≤ E.W) (hc : count < 2 ^ E.W)
    (hm88 : s.mem 88 = (j : ℕ)) (hm89 : s.mem 89 = count) :
    runBlock rootBasisPrepareCode E s = boundaryState (s.pc + 86) (rootBasisPrepareMemory b s.mem j count) := by
  have hcopy : (boundaryState (s.pc + 24) (Function.update s.mem 96 (enc b (b j)))).mem 89 = count := by
    simpa [boundaryState] using hm89
  rw [rootBasisPrepareCode, runBlock_append, runBlock_append, runBlock_append,
    basisScalar_spec b E s j (by omega) hwe hm88,
    copyMeta_spec E _ 89 111 count (by omega) hmeta hc hcopy,
    setMeta_spec E _ 90 0 (by omega) (by omega),
    setMeta_spec E _ 91 0 (by omega) (by omega)] <;> rfl

theorem rootBasisPrepare_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (m : ℕ → ℕ) (j : Fin w) (count : ℕ) :
    MemoryFrame rootPrepareMeta m (rootBasisPrepareMemory b m j count) := by
  intro addr ha
  simp only [rootPrepareMeta] at ha
  simp [rootBasisPrepareMemory, Function.update_of_ne (show addr ≠ 91 by omega),
    Function.update_of_ne (show addr ≠ 90 by omega), Function.update_of_ne (show addr ≠ 111 by omega),
    Function.update_of_ne (show addr ≠ 96 by omega)]

theorem swapMeta_spec (E : RAMEnv) (s : RAMState) (left right x y : ℕ)
    (hl : left < 2 ^ E.W) (hr : right < 2 ^ E.W) (hx : x < 2 ^ E.W) (hy : y < 2 ^ E.W)
    (hml : s.mem left = x) (hmr : s.mem right = y) :
    runBlock (swapMetaCode left right) E s = boundaryState (s.pc + 28)
      (Function.update (Function.update s.mem right x) left y) := by
  rw [swapMetaCode, runBlock_append, zeroRegs_spec]
  apply ramState_eq_of
  · have hp := runBlock_pc (swapMetaCode left right) E s (by
      simp [swapMetaCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [swapMetaCode, runBlock_append, zeroRegs_spec] at hp
    change _ = s.pc + 28 at hp
    exact hp
  · simp [runBlock_append, metaRead_spec, metaStore_spec, Nat.mod_eq_of_lt hl,
      Nat.mod_eq_of_lt hr, Nat.mod_eq_of_lt hx, Nat.mod_eq_of_lt hy, hml, hmr, boundaryState]
  · intro _; rfl

theorem rootBasisTail_spec (E : RAMEnv) (s : RAMState) (BQ QB count j n : ℕ)
    (hmeta : (112 : ℕ) < 2 ^ E.W) (hBQ : BQ < 2 ^ E.W) (hQB : QB < 2 ^ E.W)
    (hc : count < 2 ^ E.W) (hj : j + 1 < 2 ^ E.W) (hn : n + 1 < 2 ^ E.W)
    (hm83 : s.mem 83 = BQ) (hm84 : s.mem 84 = QB) (hm90 : s.mem 90 = count)
    (hm88 : s.mem 88 = j) (hm112 : s.mem 112 = n + 1) :
    runBlock rootBasisTailCode E s = rankState (s.pc + 101)
      (rootBasisTailMemory s.mem BQ QB count j n) n := by
  have hcopy : (boundaryState (s.pc + 28) (Function.update (Function.update s.mem 84 BQ) 83 QB)).mem 90 = count := by
    simpa [boundaryState] using hm90
  have hinc : (boundaryState (s.pc + 28 + 22)
      (Function.update (Function.update (Function.update s.mem 84 BQ) 83 QB) 89 count)).mem 88 = j := by
    simpa [boundaryState] using hm88
  have hcount : (boundaryState (s.pc + 28 + 22 + 24)
      (Function.update (Function.update (Function.update (Function.update s.mem 84 BQ) 83 QB) 89 count) 88 (j + 1))).mem 112 = n + 1 := by
    simpa [boundaryState] using hm112
  rw [rootBasisTailCode, runBlock_append, runBlock_append, runBlock_append,
    swapMeta_spec E s 83 84 BQ QB (by omega) (by omega) hBQ hQB hm83 hm84,
    copyMeta_spec E _ 90 89 count (by omega) (by omega) hc hcopy]
  change runBlock (countdownCode 112) E
    (runBlock (incrementMetaCode 88) E (boundaryState (s.pc + 28 + 22)
      (Function.update (Function.update (Function.update s.mem 84 BQ) 83 QB) 89 count))) = _
  rw [incrementMeta_spec E _ 88 j (by omega) hj hinc]
  change runBlock (countdownCode 112) E (boundaryState (s.pc + 28 + 22 + 24)
    (Function.update (Function.update (Function.update (Function.update s.mem 84 BQ) 83 QB) 89 count) 88 (j + 1))) = _
  rw [countdown_spec E _ 112 n hmeta hn hcount] <;> rfl

theorem rootBasisTail_frame (m : ℕ → ℕ) (BQ QB count j n : ℕ) :
    MemoryFrame (fun addr => addr = 83 ∨ addr = 84 ∨ addr = 89 ∨ addr = 88 ∨ addr = 112)
      m (rootBasisTailMemory m BQ QB count j n) := by
  intro addr ha
  dsimp [rootBasisTailMemory]
  simp only [Function.update_of_ne (show addr ≠ 112 by omega), Function.update_of_ne (show addr ≠ 88 by omega),
    Function.update_of_ne (show addr ≠ 89 by omega), Function.update_of_ne (show addr ≠ 83 by omega),
    Function.update_of_ne (show addr ≠ 84 by omega)]

theorem RootBasisView.prepared {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L BQ QB t j0 n : ℕ}
    {fs : List F[X]} {m : ℕ → ℕ} (hv : RootBasisView b R U D C TB ZB cap L BQ QB fs j0 n m)
    (j : Fin w) (hl : RootWorkspace R U D C TB ZB cap) (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t) :
    RootLevelView b R U D C TB ZB cap L BQ QB (b j) fs [] fs (rootBasisPrepareMemory b m j fs.length) := by
  let m1 := rootBasisPrepareMemory b m j fs.length
  have hf01 : MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m m1 :=
    (rootBasisPrepare_frame b m j fs.length).mono (root_prepare_writable_le_basis R U D C TB cap BQ QB t)
  have hc1 := hv.constants.of_basis_frame hl hBQ hQB hBQsep.QZ hQBsep.QZ hf01
  have henv1 := hc1.environment (b j) (by simp [m1, rootBasisPrepareMemory])
  have hq1 : FrontierStored b m1 BQ cap fs :=
    (((hv.queue.meta_update hBQ 96 (enc b (b j)) (by norm_num)).meta_update hBQ 111 fs.length (by norm_num)).meta_update
      hBQ 90 0 (by norm_num)).meta_update hBQ 91 0 (by norm_num)
  have hv1 : RootLevelView b R U D C TB ZB cap L BQ QB (b j) fs [] fs m1 := by
    refine ⟨henv1, hq1, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro k hk; simp [splitFrontier] at hk
    · simpa [m1, rootBasisPrepareMemory] using hv.oldBase
    · simpa [m1, rootBasisPrepareMemory] using hv.newBase
    · simpa [m1, rootBasisPrepareMemory] using hv.count
    · simp [m1, rootBasisPrepareMemory, splitFrontier]
    · simp [m1, rootBasisPrepareMemory]
    · simp [m1, rootBasisPrepareMemory]
  exact hv1

theorem RootLevelView.basis_completed {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L BQ QB t : ℕ}
    {fs : List F[X]} {m2 : ℕ → ℕ} (j : Fin w) (n : ℕ)
    (hv2 : RootLevelView b R U D C TB ZB cap L BQ QB (b j) fs fs [] m2)
    (hl : RootWorkspace R U D C TB ZB cap) (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t) :
    RootBasisView b R U D C TB ZB cap L QB BQ (splitFrontier w (b j) fs) ((j : ℕ) + 1) n
      (rootBasisTailMemory m2 BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n) := by
  let m3 := rootBasisTailMemory m2 BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n
  have hf23 : MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m2 m3 :=
    (rootBasisTail_frame m2 BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n).mono (root_tail_writable_le_basis R U D C TB cap BQ QB t)
  have hq3 : FrontierStored b m3 QB cap (splitFrontier w (b j) fs) :=
    ((((hv2.newQueue.meta_update hQB 84 BQ (by norm_num)).meta_update hQB 83 QB (by norm_num)).meta_update
      hQB 89 (splitFrontier w (b j) fs).length (by norm_num)).meta_update hQB 88 ((j : ℕ) + 1) (by norm_num)).meta_update
      hQB 112 n (by norm_num)
  have hv3 : RootBasisView b R U D C TB ZB cap L QB BQ (splitFrontier w (b j) fs) ((j : ℕ) + 1) n m3 := by
    refine ⟨hv2.environment.constants.of_basis_frame hl hBQ hQB hBQsep.QZ hQBsep.QZ hf23, hq3, ?_, ?_, ?_, ?_, ?_⟩
    all_goals simp [m3, rootBasisTailMemory]
  exact hv3

theorem rootBasisBody_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L BQ QB n : ℕ) (j : Fin w) (fs : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootBasisBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hBQ : 128 ≤ BQ) (hQB : 128 ≤ QB)
    (hBQword : BQ + t * cap ≤ 2 ^ E.W) (hQBword : QB + t * cap ≤ 2 ^ E.W)
    (hBQsep : QueueWorkspaceSeparated R U D C TB ZB cap BQ t)
    (hQBsep : QueueWorkspaceSeparated R U D C TB ZB cap QB t)
    (hdisj : BQ + t * cap ≤ QB ∨ QB + t * cap ≤ BQ) (hmeta : (112 : ℕ) < 2 ^ E.W)
    (hn : n + 1 < 2 ^ E.W) (hpos : ∀ f ∈ fs, 0 < f.natDegree) (hmass : frontierMass fs ≤ t)
    (hv : RootBasisView b R U D C TB ZB cap L BQ QB fs (j : ℕ) (n + 1) m) :
    Sem P E pc (pc + 3333) (rankState pc m (n + 1))
      (fun k z => k ≤ (rootNodeBudget cap L w + 83) * fs.length + 191 ∧ ∃ m',
        z = rankState (pc + 3333) m' n ∧
        RootBasisView b R U D C TB ZB cap L QB BQ (splitFrontier w (b j) fs) ((j : ℕ) + 1) n m' ∧
        MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m m') := by
  have hlen := frontier_length_le_mass fs hpos
  have hc : 1 ≤ cap := by omega
  have hmul : t ≤ t * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left t hc
  have hcountWord : fs.length < 2 ^ E.W := by omega
  have hBQWord : BQ < 2 ^ E.W := by omega
  have hQBWord : QB < 2 ^ E.W := by omega
  have hjWord : (j : ℕ) + 1 < 2 ^ E.W := by
    have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self
    omega
  let m1 := rootBasisPrepareMemory b m j fs.length
  have hf01 : MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m m1 :=
    (rootBasisPrepare_frame b m j fs.length).mono (root_prepare_writable_le_basis R U D C TB cap BQ QB t)
  have hv1 := hv.prepared j hl hBQ hQB hBQsep hQBsep
  obtain ⟨hPrepareAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hLevelAt, hTailAt⟩ := At.seqStmt hRestAt
  have hPrepare : Sem P E pc (pc + 86) (rankState pc m (n + 1))
      (fun k z => k ≤ 86 ∧ z = boundaryState (pc + 86) m1) := by
    refine Sem.mono (Sem.block P E pc rootBasisPrepareCode _ hPrepareAt
      (by simp [rootBasisPrepareCode, basisScalarCode, copyMetaCode, setMetaCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 86 := hQ.1
    exact ⟨by omega, hQ.2.trans (rootBasisPrepare_spec b E _ j fs.length (by omega) (by omega) hcountWord hv.index hv.count)⟩
  have hLevel := rootLevelProcedure_spec b ι t N P E (pc + 86) R U D C TB ZB cap L BQ QB (b j) fs m1 hLevelAt
    hw hW hdet ht hL hcap hl hwords hBQ hQB hBQword hQBword hBQsep hQBsep hdisj (by omega) hpos hmass hv1
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, m2, hz2, hv2, hf12raw⟩ := hLevel
  have hf12 : MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m1 m2 :=
    hf12raw.mono (root_level_writable_le_basis R U D C TB cap BQ QB t)
  have hf02 := MemoryFrame.trans hf01 hf12
  have h88 : m2 88 = (j : ℕ) := by
    rw [hf12raw 88 (hl.level_meta_readonly hQB 88 (by norm_num)
      (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta]))]
    simpa [m1, rootBasisPrepareMemory] using hv.index
  have h112 : m2 112 = n + 1 := by
    rw [hf12raw 112 (hl.level_meta_readonly hQB 112 (by norm_num)
      (by norm_num [rootLevelMeta, rootNodeMeta, rootComputeMeta]))]
    simpa [m1, rootBasisPrepareMemory] using hv.remaining
  have hnewPos := splitFrontier_positive w (b j) fs
  have hnewMass : frontierMass (splitFrontier w (b j) fs) ≤ t :=
    le_trans (splitFrontier_mass_le w (b j) fs (by
      intro f hf hz
      have hp := hpos f hf
      simp [hz] at hp)) hmass
  have hnewLen := frontier_length_le_mass (splitFrontier w (b j) fs) hnewPos
  have hnewWord : (splitFrontier w (b j) fs).length < 2 ^ E.W := by omega
  let m3 := rootBasisTailMemory m2 BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n
  have hf23 : MemoryFrame (rootBasisWritable R U D C TB cap BQ QB t) m2 m3 :=
    (rootBasisTail_frame m2 BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n).mono (root_tail_writable_le_basis R U D C TB cap BQ QB t)
  have hf03 := MemoryFrame.trans hf02 hf23
  have hv3 := hv2.basis_completed j n hl hBQ hQB hBQsep hQBsep
  have hLevelExact : Sem P E (pc + 86) (pc + 3232) (boundaryState (pc + 86) m1)
      (fun k z => k ≤ (rootNodeBudget cap L w + 83) * fs.length + 4 ∧ z = boundaryState (pc + 3232) m2) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hTail : Sem P E (pc + 3232) (pc + 3333) (boundaryState (pc + 3232) m2)
      (fun k z => k ≤ 101 ∧ z = rankState (pc + 3333) m3 n) := by
    refine Sem.mono (Sem.block P E _ rootBasisTailCode _ hTailAt
      (by simp [rootBasisTailCode, swapMetaCode, copyMetaCode, incrementMetaCode, countdownCode,
        metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 101 := hQ.1
    exact ⟨by omega, hQ.2.trans (rootBasisTail_spec E _ BQ QB (splitFrontier w (b j) fs).length (j : ℕ) n
      hmeta hBQWord hQBWord hnewWord hjWord hn hv2.oldBase hv2.newBase hv2.newCount h88 h112)⟩
  have hFull := Sem.seq_bound hPrepare (fun z _ hz => by
    subst z
    exact Sem.seq_bound hLevelExact (fun z _ hz => by subst z; exact hTail))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, m3, hQ.2, hv3, hf03⟩)

theorem basis_suffix_eq {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (j : ℕ) (hj : j < w) :
    (List.ofFn b).drop j = b ⟨j, hj⟩ :: (List.ofFn b).drop (j + 1) := by
  have h : j < (List.ofFn b).length := by simpa using hj
  rw [List.drop_eq_getElem_cons h, List.getElem_ofFn]

theorem rootBasisLoop_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L Q0 Q1 : ℕ) (fs0 : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootBasisLoop pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : 128 ≤ Q1)
    (hQ0word : Q0 + t * cap ≤ 2 ^ E.W) (hQ1word : Q1 + t * cap ≤ 2 ^ E.W)
    (hQ0sep : QueueWorkspaceSeparated R U D C TB ZB cap Q0 t)
    (hQ1sep : QueueWorkspaceSeparated R U D C TB ZB cap Q1 t)
    (hdisj : Q0 + t * cap ≤ Q1 ∨ Q1 + t * cap ≤ Q0) (hmeta : (112 : ℕ) < 2 ^ E.W)
    (hpos : ∀ f ∈ fs0, 0 < f.natDegree) (hmass : frontierMass fs0 ≤ t)
    (hv : RootBasisView b R U D C TB ZB cap L Q0 Q1 fs0 0 w m) :
    Sem P E pc (pc + 3335) (rankState pc m w)
      (fun k z => k ≤ ((rootNodeBudget cap L w + 83) * t + 193) * w + 1 ∧ z.regs = (fun _ => 0) ∧
        ∃ BQ QB fs, ((BQ = Q0 ∧ QB = Q1) ∨ (BQ = Q1 ∧ QB = Q0)) ∧
          RootBasisView b R U D C TB ZB cap L BQ QB fs w 0 z.mem ∧
          (∀ f ∈ fs, 0 < f.natDegree) ∧ frontierMass fs ≤ t ∧
          rootForest w [] fs = rootForest w (List.ofFn b) fs0 ∧
          MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ w ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    ∃ BQ QB fs, ((BQ = Q0 ∧ QB = Q1) ∨ (BQ = Q1 ∧ QB = Q0)) ∧
      RootBasisView b R U D C TB ZB cap L BQ QB fs (w - n) n z.mem ∧
      (∀ f ∈ fs, 0 < f.natDegree) ∧ frontierMass fs ≤ t ∧
      rootForest w ((List.ofFn b).drop (w - n)) fs = rootForest w (List.ofFn b) fs0 ∧
      MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by
    intro n z pc' h
    simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by
    intro n z h
    rw [h.2.1, Function.update_self]
  have hwWord : w < 2 ^ E.W := by
    have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self
    omega
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 }
        (fun k z' => k ≤ (rootNodeBudget cap L w + 83) * t + 192 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, BQ, QB, fs, horder, hvz, hposz, hmassz, hforest, hf⟩ := hI
    let j : Fin w := ⟨w - (n + 1), by omega⟩
    have hgeom : 128 ≤ BQ ∧ 128 ≤ QB ∧ BQ + t * cap ≤ 2 ^ E.W ∧ QB + t * cap ≤ 2 ^ E.W ∧
        QueueWorkspaceSeparated R U D C TB ZB cap BQ t ∧ QueueWorkspaceSeparated R U D C TB ZB cap QB t ∧
        (BQ + t * cap ≤ QB ∨ QB + t * cap ≤ BQ) := by
      rcases horder with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact ⟨hQ0, hQ1, hQ0word, hQ1word, hQ0sep, hQ1sep, hdisj⟩
      · exact ⟨hQ1, hQ0, hQ1word, hQ0word, hQ1sep, hQ0sep, hdisj.elim Or.inr Or.inl⟩
    have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (n + 1) := by
      apply ramState_eq_of
      · rfl
      · rfl
      · intro r; exact congrFun hregs r
    rw [hz]
    have hrun := rootBasisBody_spec b ι t N P E (pc + 1) R U D C TB ZB cap L BQ QB n j fs z.mem hBodyAt
      hw hW hdet ht hL hcap hl hwords hgeom.1 hgeom.2.1 hgeom.2.2.1 hgeom.2.2.2.1 hgeom.2.2.2.2.1
      hgeom.2.2.2.2.2.1 hgeom.2.2.2.2.2.2 hmeta (by omega) hposz hmassz hvz
    refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
    intro k z' hQ
    obtain ⟨hk, m', hz', hv', hf'⟩ := hQ
    have hlen := frontier_length_le_mass fs hposz
    have hmul := Nat.mul_le_mul_left (rootNodeBudget cap L w + 83) (le_trans hlen hmassz)
    refine ⟨by omega, by omega, ?_⟩
    rw [hz']
    have hjnext : (j : ℕ) + 1 = w - n := by dsimp [j]; omega
    have hnewMass : frontierMass (splitFrontier w (b j) fs) ≤ t :=
      le_trans (splitFrontier_mass_le w (b j) fs (by
        intro f hf hz
        have hp := hposz f hf
        simp [hz] at hp)) hmassz
    have hnewForest : rootForest w ((List.ofFn b).drop (w - n)) (splitFrontier w (b j) fs) =
        rootForest w (List.ofFn b) fs0 := by
      rw [← hjnext, rootForest_split]
      have he := basis_suffix_eq b (j : ℕ) j.isLt
      rw [← he]
      exact hforest
    have hnewFrame : MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) z.mem m' := hf'.mono (by
      intro addr ha
      rcases horder with horder | horder
      · simpa only [horder.1, horder.2] using ha
      · have hh := (root_basis_writable_swap R U D C TB cap BQ QB t addr).mp ha
        simpa only [horder.1, horder.2] using hh)
    refine ⟨rfl, QB, BQ, splitFrontier w (b j) fs, ?_, ?_, splitFrontier_positive w (b j) fs,
      hnewMass, hnewForest, MemoryFrame.trans hf hnewFrame⟩
    · rcases horder with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact Or.inr ⟨rfl, rfl⟩
      · exact Or.inl ⟨rfl, rfl⟩
    · simpa only [hjnext, rankState, boundaryState] using hv'
  have hinit : I w (rankState pc m w) := by
    refine ⟨le_rfl, rfl, Q0, Q1, fs0, Or.inl ⟨rfl, rfl⟩, ?_, hpos, hmass, ?_, ?_⟩
    · simpa only [Nat.sub_self, rankState, boundaryState] using hv
    · simp only [Nat.sub_self, List.drop_zero]
    · intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc rootBasisBody hAt (by omega) I
    ((rootNodeBudget cap L w + 83) * t + 192) hframe hcounter hbody w (rankState pc m w) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, BQ, QB, fs, horder, hvz, hposz, hmassz, hforest, hf⟩ := hQ
  refine ⟨hk, ?_, BQ, QB, fs, horder, ?_, hposz, hmassz, ?_, hf⟩
  · rw [hregs]
    funext r
    simp [Function.update_apply]
  · simpa only [Nat.sub_zero] using hvz
  · have he : (List.ofFn b).drop w = [] := by
      simpa only [List.length_ofFn] using (List.drop_length (l := List.ofFn b))
    simpa only [Nat.sub_zero, he] using hforest

theorem rootBasisProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L Q0 Q1 : ℕ) (fs0 : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootBasisProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (ht : 1 ≤ t) (hL : L = 2 * t + 1) (hcap : cap = 2 * L)
    (hl : RootWorkspace R U D C TB ZB cap) (hwords : RootWords E R U D C TB ZB cap)
    (hQ0 : 128 ≤ Q0) (hQ1 : 128 ≤ Q1)
    (hQ0word : Q0 + t * cap ≤ 2 ^ E.W) (hQ1word : Q1 + t * cap ≤ 2 ^ E.W)
    (hQ0sep : QueueWorkspaceSeparated R U D C TB ZB cap Q0 t)
    (hQ1sep : QueueWorkspaceSeparated R U D C TB ZB cap Q1 t)
    (hdisj : Q0 + t * cap ≤ Q1 ∨ Q1 + t * cap ≤ Q0) (hmeta : (112 : ℕ) < 2 ^ E.W)
    (hpos : ∀ f ∈ fs0, 0 < f.natDegree) (hmass : frontierMass fs0 ≤ t)
    (hv : RootBasisView b R U D C TB ZB cap L Q0 Q1 fs0 0 w m) :
    Sem P E pc (pc + 3338) (boundaryState pc m)
      (fun k z => k ≤ ((rootNodeBudget cap L w + 83) * t + 193) * w + 4 ∧ ∃ m',
        z = boundaryState (pc + 3338) m' ∧ ∃ BQ QB fs,
          ((BQ = Q0 ∧ QB = Q1) ∨ (BQ = Q1 ∧ QB = Q0)) ∧
          RootBasisView b R U D C TB ZB cap L BQ QB fs w 0 m' ∧
          (∀ f ∈ fs, 0 < f.natDegree) ∧ frontierMass fs ≤ t ∧
          rootForest w [] fs = rootForest w (List.ofFn b) fs0 ∧
          MemoryFrame (rootBasisWritable R U D C TB cap Q0 Q1 t) m m') := by
  have hn : w < 2 ^ E.W := by
    have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self
    omega
  obtain ⟨hReadAt, hLoopAt⟩ := At.seqStmt hAt
  have hRead : Sem P E pc (pc + 3) (boundaryState pc m)
      (fun k z => k ≤ 3 ∧ z = rankState (pc + 3) m w) := by
    refine Sem.mono (Sem.block P E pc (metaReadCode r9 112) _ hReadAt (by simp [metaReadCode]) rfl) ?_
    intro k z hQ
    have hk : k = 3 := hQ.1
    exact ⟨by omega, hQ.2.trans (rankReadSlot_spec E pc m 112 w hmeta hn hv.remaining)⟩
  have hLoop := rootBasisLoop_spec b ι t N P E (pc + 3) R U D C TB ZB cap L Q0 Q1 fs0 m hLoopAt
    hw hW hdet ht hL hcap hl hwords hQ0 hQ1 hQ0word hQ1word hQ0sep hQ1sep hdisj hmeta hpos hmass hv
  have hFull := Sem.seq_bound hRead (fun z _ hz => by subst z; exact hLoop)
  obtain ⟨hpc, k, z, hrun, hreturn, hk, hregs, BQ, QB, fs, horder, hvz, hposz, hmassz, hforest, hf⟩ := hFull
  refine ⟨hpc, k, z, hrun, hreturn, by omega, z.mem, ?_, BQ, QB, fs, horder, hvz, hposz, hmassz, hforest, hf⟩
  apply ramState_eq_of
  · exact hreturn
  · rfl
  · intro r; exact congrFun hregs r

theorem fieldPosition_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState) (v : F)
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hN : N < 2 ^ E.W) (hv : s.regs r10 = enc b v) :
    runBlock fieldPositionCode E s =
      { s with pc := s.pc + 4, regs := Function.update (Function.update (Function.update s.regs r15 (detPosBase w)) r14 (detPosBase w + enc b v)) r10 (posTab N ι v) } := by
  have hend : detEnd w < 2 ^ E.W := by rw [hW]; exact detEnd_lt hw
  have hbase : detPosBase w < 2 ^ E.W := by
    have hpos := Nat.two_pow_pos w
    unfold detEnd detImgBase at hend
    omega
  have haddr : detPosBase w + enc b v < 2 ^ E.W := by
    have hvlt := enc_lt b v
    unfold detEnd detImgBase at hend
    omega
  have h9 : (9 : ℕ) < 2 ^ E.W := by
    have hp : (2 : ℕ) ^ 8 ≤ 2 ^ E.W := by
      rw [hW]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
    exact lt_of_lt_of_le (by norm_num : (9 : ℕ) < 2 ^ 8) hp
  have hh : E.det 9 = detPosBase w := by
    rw [hdet, detStd_hdr t N w b ι (by decide : 9 < 13)]
    rfl
  have ht : E.det (detPosBase w + enc b v) = posTab N ι v := by
    rw [hdet, detStd_pos t N b ι (enc_lt b v), dec_enc]
  have hpWord : posTab N ι v < 2 ^ E.W := lt_of_le_of_lt (posTab_le N ι v) hN
  apply ramState_eq_of
  · simp [fieldPositionCode, runBlock_cons, runBlock_nil, execInstr] <;> omega
  · rfl
  · intro r
    fin_cases r <;> simp [fieldPositionCode, runBlock_cons, runBlock_nil, execInstr, hv, hh, ht,
      Nat.mod_eq_of_lt h9, Nat.mod_eq_of_lt hbase, Nat.mod_eq_of_lt haddr, Nat.mod_eq_of_lt hpWord]

theorem leafPosition_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (E : RAMEnv) (s : RAMState)
    (src cap : ℕ) (f : F[X]) (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (99 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W) (hsrc : src + cap ≤ 2 ^ E.W) (hcap : 2 ≤ cap)
    (hf : PolynomialStored b s.mem src cap f) (hm99 : s.mem 99 = src) (hm77 : s.mem 77 = w) :
    ∃ z, runBlock leafPositionCode E s = z ∧ z.pc = s.pc + 33 ∧ z.mem = s.mem ∧
      z.regs r10 = posTab N ι ((linearRoot f)⁻¹) := by
  have hwe : w ≤ E.W := by omega
  have hsmall (i : ℕ) (hi : i ≤ 99) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  have hEnc (v : F) : enc b v % 2 ^ E.W = enc b v :=
    Nat.mod_eq_of_lt (lt_of_lt_of_le (enc_lt b v) (Nat.pow_le_pow_right (by norm_num) hwe))
  have hSrc : src % 2 ^ E.W = src := Nat.mod_eq_of_lt (by omega)
  have hSrc1 : (src + 1) % 2 ^ E.W = src + 1 := Nat.mod_eq_of_lt (by omega)
  have hdim : w % 2 ^ E.W = w := Nat.mod_eq_of_lt (by have he : E.W < 2 ^ E.W := Nat.lt_two_pow_self; omega)
  have hm0 : s.mem src = enc b (f.coeff 0) := by simpa only [Nat.add_zero] using hf 0 (by omega)
  have hm1 : s.mem (src + 1) = enc b (f.coeff 1) := hf 1 (by omega)
  let sA := runBlock leafCoefficientOneCode E s
  have hA3 : sA.regs r3 = w := by
    simp [sA, leafCoefficientOneCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hsmall, hm99, hm77, hSrc, hSrc1, hm1, hEnc, hdim]
  have hA10 : sA.regs r10 = enc b (f.coeff 1) := by
    simp [sA, leafCoefficientOneCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hsmall, hm99, hm77, hSrc, hSrc1, hm1, hEnc, hdim]
  let sB := runBlock fieldInvCode E sA
  have hB := fieldInvCode_spec b ι t N E sA (f.coeff 1) hw hW hdet hA10
  have hB3 : sB.regs r3 = w := by dsimp only [sB]; rw [hB]; simpa using hA3
  have hB10 : sB.regs r10 = enc b ((f.coeff 1)⁻¹) := by dsimp only [sB]; rw [hB]; simp
  let sC := runBlock [iBor r11 r10 r10] E sB
  have hC3 : sC.regs r3 = w := by simp [sC, runBlock_cons, runBlock_nil, execInstr, hB3]
  have hC11 : sC.regs r11 = enc b ((f.coeff 1)⁻¹) := by
    simp [sC, runBlock_cons, runBlock_nil, execInstr, hB10, hEnc]
  have hCmem : sC.mem = s.mem := rfl
  let sD := runBlock leafCoefficientZeroCode E sC
  have hD3 : sD.regs r3 = w := by
    simp [sD, leafCoefficientZeroCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr, hC3]
  have hD11 : sD.regs r11 = enc b ((f.coeff 1)⁻¹) := by
    simp [sD, leafCoefficientZeroCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr, hC11]
  have hD10 : sD.regs r10 = enc b (f.coeff 0) := by
    simp [sD, leafCoefficientZeroCode, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil,
      execInstr, hsmall, hCmem, hm99, hSrc, hm0, hEnc]
  let sE := runBlock fieldMulCode E sD
  have hE := fieldMulCode_spec b ι t N E sD (f.coeff 0) (f.coeff 1)⁻¹ hw hW hdet hD3 hD10 hD11
  have hroot : f.coeff 0 * (f.coeff 1)⁻¹ = linearRoot f := by
    haveI : CharP F 2 := pinsketch_charP
    simp [linearRoot, div_eq_mul_inv, CharTwo.neg_eq]
  have hE10 : sE.regs r10 = enc b (linearRoot f) := by dsimp only [sE]; rw [hE]; simp [hroot]
  let sF := runBlock fieldInvCode E sE
  have hF := fieldInvCode_spec b ι t N E sE (linearRoot f) hw hW hdet hE10
  have hF10 : sF.regs r10 = enc b ((linearRoot f)⁻¹) := by dsimp only [sF]; rw [hF]; simp
  let sG := runBlock fieldPositionCode E sF
  have hG := fieldPosition_spec b ι t N E sF (linearRoot f)⁻¹ hw hW hdet hN hF10
  have hG10 : sG.regs r10 = posTab N ι ((linearRoot f)⁻¹) := by dsimp only [sG]; rw [hG]; simp
  have hFull : runBlock leafPositionCode E s = sG := by
    simp only [leafPositionCode, runBlock_append]
    rfl
  refine ⟨sG, hFull, ?_, rfl, hG10⟩
  have hp := runBlock_pc leafPositionCode E s (by
    simp [leafPositionCode, leafCoefficientOneCode, leafCoefficientZeroCode, metaReadCode,
      fieldInvCode, fieldMulCode, fieldPositionCode])
  rw [hFull] at hp
  exact hp

theorem OutputStored.meta_update {m : ℕ → ℕ} {B : ℕ} {xs : List ℕ}
    (h : OutputStored m B xs) (hB : 128 ≤ B) (slot value : ℕ) (hs : slot < 128) :
    OutputStored (Function.update m slot value) B xs := by
  intro j hj
  rw [Function.update_of_ne (by omega : B + j ≠ slot)]
  exact h j hj

theorem OutputStored.append_update {m : ℕ → ℕ} {B v : ℕ} {xs : List ℕ} (h : OutputStored m B xs) :
    OutputStored (Function.update m (B + xs.length) v) B (xs ++ [v]) := by
  intro j hj
  by_cases hlt : j < xs.length
  · rw [List.getD_append xs [v] 0 j hlt, Function.update_of_ne (by omega : B + j ≠ B + xs.length)]
    exact h j hlt
  · have heq : j = xs.length := by simp only [List.length_append, List.length_singleton] at hj; omega
    subst j
    rw [List.getD_append_right xs [v] 0 xs.length le_rfl, Nat.sub_self, Function.update_self]
    rfl

/-- One legal-position test updates the flag and saturates the missing-position
sentinel to output index zero.  Missing positions cannot be accepted later. -/
theorem positionFlag_spec (E : RAMEnv) (s : RAMState) (p flag : ℕ)
    (hmeta : (100 : ℕ) < 2 ^ E.W) (hp : p < 2 ^ E.W) (hf : flag ≤ 1)
    (h10 : s.regs r10 = p) (hm100 : s.mem 100 = flag) :
    ∃ z, runBlock positionFlagCode E s = z ∧ z.pc = s.pc + 10 ∧
      z.mem = Function.update s.mem 100 (flag * positionValidBit p) ∧ z.regs r10 = p - 1 := by
  have hbit := positionValidBit_le p
  have hprod : flag * positionValidBit p ≤ 1 := by
    exact le_trans (Nat.mul_le_mul hf hbit) (by norm_num)
  have h100 : (100 : ℕ) % 2 ^ E.W = 100 := Nat.mod_eq_of_lt hmeta
  have hflag : flag % 2 ^ E.W = flag := Nat.mod_eq_of_lt (by omega)
  have hb : positionValidBit p % 2 ^ E.W = positionValidBit p := Nat.mod_eq_of_lt (by omega)
  have hprodWord : (flag * positionValidBit p) % 2 ^ E.W = flag * positionValidBit p := Nat.mod_eq_of_lt (by omega)
  let z0 := runBlock ([iImm r0 0, iLt r11 r0 r10] ++ metaReadCode r1 100 ++ [iMul r1 r1 r11]) E s
  have h011 : z0.regs r11 = positionValidBit p := by
    by_cases hp0 : 0 < p <;>
      simp [z0, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
        h10, positionValidBit, hp0, h100, hm100, Nat.mod_eq_of_lt (show 1 < 2 ^ E.W by omega)]
  have h01 : z0.regs r1 = flag * positionValidBit p := by
    by_cases hp0 : 0 < p <;>
      simp [z0, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr,
        h10, positionValidBit, hp0, h100, hm100, hflag, Nat.mod_eq_of_lt (show 1 < 2 ^ E.W by omega)]
  have h010 : z0.regs r10 = p := by
    simp [z0, runBlock_append, metaRead_spec, runBlock_cons, runBlock_nil, execInstr, h10]
  let z1 := runBlock (metaStoreCode r1 100 ++ [iSub r10 r10 r11]) E z0
  have hm : z1.mem = Function.update s.mem 100 (flag * positionValidBit p) := by
    simp [z1, runBlock_append, metaStore_spec, runBlock_cons, runBlock_nil, execInstr, h100, h01] <;> rfl
  have hv : z1.regs r10 = p - 1 := by
    simp only [z1, runBlock_append, metaStore_spec E _ r1 100 (by decide), runBlock_cons, runBlock_nil,
      execInstr, Function.update_self, Function.update_of_ne (by decide : r10 ≠ r15), Function.update_of_ne (by decide : r11 ≠ r15)]
    rw [h010, h011]
    exact position_index_word p (2 ^ E.W) (by omega) hp
  have he : runBlock positionFlagCode E s = z1 := by simp only [positionFlagCode, runBlock_append]; rfl
  refine ⟨z1, he, ?_, hm, hv⟩
  have hpc := runBlock_pc positionFlagCode E s (by simp [positionFlagCode, metaReadCode, metaStoreCode])
  rw [he] at hpc
  exact hpc

/-- Append the index in register 10 and advance the output count. -/
theorem positionAppend_spec (E : RAMEnv) (s : RAMState) (B n idx : ℕ)
    (hmeta : (101 : ℕ) < 2 ^ E.W) (hB : B < 2 ^ E.W) (hn : n + 1 < 2 ^ E.W)
    (haddr : B + n < 2 ^ E.W) (hidx : idx < 2 ^ E.W)
    (h10 : s.regs r10 = idx) (hm85 : s.mem 85 = B) (hm101 : s.mem 101 = n) :
    runBlock positionAppendCode E s = boundaryState (s.pc + 29)
      (Function.update (Function.update s.mem (B + n) idx) 101 (n + 1)) := by
  have hsmall (i : ℕ) (hi : i ≤ 101) : i % 2 ^ E.W = i := Nat.mod_eq_of_lt (by omega)
  have hBmod := Nat.mod_eq_of_lt hB
  have hnmod : n % 2 ^ E.W = n := Nat.mod_eq_of_lt (by omega)
  let sA := runBlock (metaReadCode r2 85 ++ metaReadCode r9 101) E s
  have hA2 : sA.regs r2 = B := by
    simp [sA, runBlock_append, metaRead_spec, hsmall, hm85, hm101, hBmod, hnmod]
  have hA9 : sA.regs r9 = n := by
    simp [sA, runBlock_append, metaRead_spec, hsmall, hm85, hm101, hBmod, hnmod]
  have hA10 : sA.regs r10 = idx := by
    simp [sA, runBlock_append, metaRead_spec, h10]
  let sB := runBlock [iAdd r2 r2 r9, iSt r2 r10, iImm r6 1, iAdd r9 r9 r6] E sA
  have hB9 : sB.regs r9 = n + 1 := by
    simp [sB, runBlock_cons, runBlock_nil, execInstr, hA9,
      Nat.mod_eq_of_lt (show 1 < 2 ^ E.W by omega), Nat.mod_eq_of_lt hn]
  have hBmem : sB.mem = Function.update s.mem (B + n) idx := by
    simp [sB, runBlock_cons, runBlock_nil, execInstr, hA2, hA9, hA10, Nat.mod_eq_of_lt haddr] <;> rfl
  let sC := runBlock (metaStoreCode r9 101) E sB
  have hCmem : sC.mem = Function.update (Function.update s.mem (B + n) idx) 101 (n + 1) := by
    dsimp only [sC]
    rw [metaStore_spec E _ r9 101 (by decide)]
    change Function.update sB.mem (101 % 2 ^ E.W) (sB.regs r9) = _
    rw [hsmall 101 le_rfl, hB9, hBmem]
  have hFull : runBlock positionAppendCode E s = boundaryState (sC.pc + 16) sC.mem := by
    have he : runBlock positionAppendCode E s = runBlock zeroRegsCode E sC := by
      simp only [positionAppendCode, runBlock_append]
      rfl
    rw [he, zeroRegs_spec]
  have hpc : sC.pc + 16 = s.pc + 29 := by
    have hp := runBlock_pc positionAppendCode E s (by
      simp [positionAppendCode, metaReadCode, metaStoreCode, zeroRegsCode])
    rw [hFull] at hp
    exact hp
  rw [hFull, hpc, hCmem]

theorem emitPosition_spec (E : RAMEnv) (s : RAMState) (B n p flag : ℕ)
    (hmeta : (101 : ℕ) < 2 ^ E.W) (hB : 128 ≤ B) (hn : n + 1 < 2 ^ E.W)
    (haddr : B + n < 2 ^ E.W) (hp : p < 2 ^ E.W) (hf : flag ≤ 1)
    (h10 : s.regs r10 = p) (hm85 : s.mem 85 = B) (hm101 : s.mem 101 = n) (hm100 : s.mem 100 = flag) :
    runBlock emitPositionCode E s = boundaryState (s.pc + 39) (emitPositionMemory s.mem B n p flag) := by
  obtain ⟨z, hz, hpc, hmem, hidx⟩ := positionFlag_spec E s p flag (by omega) hp hf h10 hm100
  have hz85 : z.mem 85 = B := by rw [hmem]; simpa using hm85
  have hz101 : z.mem 101 = n := by rw [hmem]; simpa using hm101
  rw [emitPositionCode, runBlock_append, hz,
    positionAppend_spec E z B n (p - 1) hmeta (by omega) hn haddr (by omega) hidx hz85 hz101]
  rw [hpc, hmem]
  rfl

theorem emitPosition_stored {m : ℕ → ℕ} {B p flag : ℕ} {xs : List ℕ}
    (h : OutputStored m B xs) (hB : 128 ≤ B) :
    OutputStored (emitPositionMemory m B xs.length p flag) B (xs ++ [p - 1]) :=
  ((h.meta_update hB 100 (flag * positionValidBit p) (by norm_num)).append_update).meta_update
    hB 101 (xs.length + 1) (by norm_num)

theorem emitPosition_frame (m : ℕ → ℕ) (B n p flag : ℕ) :
    MemoryFrame (fun addr => addr = 100 ∨ addr = 101 ∨ addr = B + n) m (emitPositionMemory m B n p flag) :=
  MemoryFrame.trans
    (MemoryFrame.trans (MemoryFrame.update_allowed _ m 100 (flag * positionValidBit p) (Or.inl rfl))
      (MemoryFrame.update_allowed _ _ (B + n) (p - 1) (Or.inr (Or.inr rfl))))
    (MemoryFrame.update_allowed _ _ 101 (n + 1) (Or.inr (Or.inl rfl)))

theorem degreeBelowLoad_spec (E : RAMEnv) (pc : ℕ) (m : ℕ → ℕ) (threshold d : ℕ)
    (hmeta : (95 : ℕ) < 2 ^ E.W) (ht : threshold < 2 ^ E.W)
    (hd : d < 2 ^ E.W) (hm95 : m 95 = d) :
    runBlock (degreeBelowLoadCode threshold) E (boundaryState pc m) = padeTestState (pc + 4) m threshold d := by
  rw [degreeBelowLoadCode, runBlock_append, metaRead_spec E _ r1 95 (by decide)]
  have h95 : (95 : ℕ) % 2 ^ E.W = 95 := Nat.mod_eq_of_lt hmeta
  apply ramState_eq_of
  · rfl
  · rfl
  · intro r
    fin_cases r <;> simp [runBlock_cons, runBlock_nil, execInstr, boundaryState, padeTestState,
      h95, Nat.mod_eq_of_lt ht, Nat.mod_eq_of_lt hd, hm95]

theorem degreeBelowBranch_spec (P : Program) (E : RAMEnv) (pc threshold : ℕ) (body : Stmt)
    (m : ℕ → ℕ) (d B : ℕ) (Q : (ℕ → ℕ) → Prop)
    (hAt : At P pc (Stmt.compile (degreeBelowBranch threshold body) pc))
    (hmeta : (95 : ℕ) < 2 ^ E.W) (hthreshold : threshold < 2 ^ E.W) (hd : d < 2 ^ E.W) (hm95 : m 95 = d)
    (hcall : d < threshold → ∀ base, At P base (Stmt.compile body base) →
      Sem P E base (base + body.len) (boundaryState base m)
        (fun k z => k ≤ B ∧ z.regs = (fun _ => 0) ∧ Q z.mem))
    (hstop : ¬ d < threshold → Q m) :
    Sem P E pc (pc + (degreeBelowBranch threshold body).len) (boundaryState pc m)
      (fun k z => k ≤ B + 23 ∧ z.regs = (fun _ => 0) ∧ Q z.mem) := by
  obtain ⟨hLoadAt, hIfAt⟩ := At.seqStmt hAt
  obtain ⟨_, _, hTrueAt, _, hFalseAt, _⟩ := at_ite hIfAt
  obtain ⟨hZeroAt, hBodyAt⟩ := At.seqStmt hTrueAt
  have hLoad : Sem P E pc (pc + 4) (boundaryState pc m)
      (fun k z => k ≤ 4 ∧ z = padeTestState (pc + 4) m threshold d) := by
    refine Sem.mono (Sem.block P E pc (degreeBelowLoadCode threshold) _ hLoadAt
      (by simp [degreeBelowLoadCode, metaReadCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 4 at hk; omega, hz.trans (degreeBelowLoad_spec E pc m threshold d hmeta hthreshold hd hm95)⟩
  let c : Cond := .lt r15 r1 r0
  let a := pc + 4
  let z0 := padeTestState a m threshold d
  let endpc := a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + (Stmt.code zeroRegsCode).len + 3
  have hIf : Sem P E a endpc z0
      (fun k z => k ≤ B + 19 ∧ z.regs = (fun _ => 0) ∧ Q z.mem) := by
    apply Sem.ite P E a c (Stmt.seq (Stmt.code zeroRegsCode) body) (Stmt.code zeroRegsCode) z0 _ hIfAt (by omega) rfl
    · intro hgo
      have hg : d < threshold := hgo
      have hZero := Sem.zero_block P E (a + 2) { runBlock c.code E z0 with pc := a + 2 } hZeroAt rfl
      have hBody := hcall hg (a + 18) hBodyAt
      have hTrue := Sem.seq_bound hZero (fun z _ hz => by subst z; exact hBody)
      have htend : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len = a + 18 + body.len := by
        simp only [c, Cond.code, Stmt.len, zeroRegsCode, List.length_cons, List.length_nil]
        omega
      rw [htend]
      refine Sem.mono hTrue ?_
      intro k z hQ
      exact ⟨by change 1 + 1 + k + 1 ≤ B + 19; omega, hQ.2.1, hQ.2.2⟩
    · intro hno
      have hng : ¬ d < threshold := hno
      have hFalseAt' : At P (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2) zeroRegsCode := by
        have hh : At P (a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1) zeroRegsCode := hFalseAt
        have heq : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1 =
            a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2 := by omega
        rw [heq] at hh
        exact hh
      have hZero := Sem.zero_block P E (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2)
        { runBlock c.code E z0 with pc := a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2 } hFalseAt' rfl
      have hfend : a + c.code.length + 1 + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 1 + (Stmt.code zeroRegsCode).len =
          (a + c.code.length + (Stmt.seq (Stmt.code zeroRegsCode) body).len + 2) + 16 := by
        simp only [Stmt.len, zeroRegsCode, List.length_cons, List.length_nil]
        omega
      rw [hfend]
      refine Sem.mono hZero ?_
      intro k z hQ
      obtain ⟨hk, hz⟩ := hQ
      refine ⟨by change 1 + 1 + k + 1 ≤ B + 19; omega, ?_, ?_⟩
      · rw [hz]; rfl
      · rw [hz]
        exact hstop hng
  have hFull := Sem.seq_bound hLoad (fun z _ hz => by subst z; exact hIf)
  have hpc : endpc = pc + (degreeBelowBranch threshold body).len := by
    simp only [endpc, a, c, degreeBelowBranch, Stmt.len, Cond.code, List.length_singleton, degreeBelowLoadCode,
      metaReadCode, List.length_append, List.length_cons, List.length_nil]
    omega
  rw [hpc] at hFull
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

theorem rootPositionList_append {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us vs : List F) :
    rootPositionList N ι (us ++ vs) = rootPositionList N ι us ++ rootPositionList N ι vs := by
  simp [rootPositionList]

theorem rootPositionFlag_append {F : Type} [Field F] (N : ℕ) (ι : ℕ → F) (us vs : List F) :
    rootPositionFlag N ι (us ++ vs) = rootPositionFlag N ι us * rootPositionFlag N ι vs := by
  simp [rootPositionFlag, List.prod_append]

theorem leafEmissionProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc src cap B : ℕ) (f : F[X]) (xs : List ℕ) (flag : ℕ) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile leafEmissionProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (101 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W) (hsrc : src + cap ≤ 2 ^ E.W) (hcap : 2 ≤ cap)
    (hB : 128 ≤ B) (hn : xs.length + 1 < 2 ^ E.W) (haddr : B + xs.length < 2 ^ E.W) (hflag : flag ≤ 1)
    (hf : PolynomialStored b m src cap f) (hout : OutputStored m B xs)
    (hm99 : m 99 = src) (hm77 : m 77 = w) (hm85 : m 85 = B) (hm101 : m 101 = xs.length) (hm100 : m 100 = flag) :
    Sem P E pc (pc + 72) (boundaryState pc m)
      (fun k z => k ≤ 72 ∧ ∃ m', z = boundaryState (pc + 72) m' ∧
        m' 100 = flag * positionValidBit (posTab N ι ((linearRoot f)⁻¹)) ∧ m' 101 = xs.length + 1 ∧
        OutputStored m' B (xs ++ [posTab N ι ((linearRoot f)⁻¹) - 1]) ∧
        MemoryFrame (fun addr => addr = 100 ∨ addr = 101 ∨ addr = B + xs.length) m m') := by
  let p := posTab N ι ((linearRoot f)⁻¹)
  let m' := emitPositionMemory m B xs.length p flag
  obtain ⟨z, hz, hzpc, hzmem, hz10⟩ := leafPosition_spec b ι t N E (boundaryState pc m) src cap f hw hW hdet
    (by omega) hN hsrc hcap hf hm99 hm77
  have hp : p < 2 ^ E.W := lt_of_le_of_lt (posTab_le N ι _) hN
  have hz85 : z.mem 85 = B := by rw [hzmem]; exact hm85
  have hz101 : z.mem 101 = xs.length := by rw [hzmem]; exact hm101
  have hz100 : z.mem 100 = flag := by rw [hzmem]; exact hm100
  have hrun : runBlock (leafPositionCode ++ emitPositionCode) E (boundaryState pc m) = boundaryState (pc + 72) m' := by
    rw [runBlock_append, hz, emitPosition_spec E z B xs.length p flag hmeta hB hn haddr hp hflag hz10 hz85 hz101 hz100,
      hzpc, hzmem]
    rfl
  have hblock := Sem.boundary_block P E pc (leafPositionCode ++ emitPositionCode) m m' hAt
    (by simp [leafPositionCode, leafCoefficientOneCode, leafCoefficientZeroCode, fieldPositionCode, fieldInvCode,
      fieldMulCode, emitPositionCode, positionFlagCode, positionAppendCode, metaReadCode, metaStoreCode, zeroRegsCode]) hrun
  change Sem P E pc (pc + 72) (boundaryState pc m)
    (fun k z => k ≤ 72 ∧ z = boundaryState (pc + 72) m') at hblock
  refine Sem.mono hblock ?_
  intro k z hQ
  refine ⟨by omega, m', hQ.2, ?_, ?_, emitPosition_stored hout hB, emitPosition_frame m B xs.length p flag⟩
  · simp [m', emitPositionMemory, p, show 100 ≠ B + xs.length by omega]
  · simp [m', emitPositionMemory]

theorem leafKeepProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc src cap B T : ℕ) (f : F[X]) (us : List F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile leafKeepProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (101 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W)
    (hsrc : 128 ≤ src) (hSword : src + cap ≤ 2 ^ E.W) (hcap : 2 ≤ cap)
    (hB : 128 ≤ B) (hBword : B + T ≤ 2 ^ E.W) (hroom : f.natDegree = 1 → us.length < T)
    (hFpos : 0 < f.natDegree) (hdeg : f.natDegree < cap)
    (hf : PolynomialStored b m src cap f) (hout : OutputStored m B (rootPositionList N ι us))
    (hm99 : m 99 = src) (hm77 : m 77 = w) (hm81 : m 81 = cap) (hm85 : m 85 = B)
    (hm101 : m 101 = us.length) (hm100 : m 100 = rootPositionFlag N ι us) :
    Sem P E pc (pc + 182) (boundaryState pc m)
      (fun k z => k ≤ 17 * cap + 150 ∧ z.regs = (fun _ => 0) ∧
        z.mem 100 = rootPositionFlag N ι (us ++ traceRootSearch w [] f) ∧
        z.mem 101 = (us ++ traceRootSearch w [] f).length ∧
        OutputStored z.mem B (rootPositionList N ι (us ++ traceRootSearch w [] f)) ∧
        MemoryFrame (leafKeepWritable B us.length f.natDegree) m z.mem) := by
  let m1 := Function.update (Function.update m 64 src) 66 cap
  let m2 := Function.update m1 95 (degreeScan f cap)
  have hcapWord : cap < 2 ^ E.W := by omega
  have hsrcWord : src < 2 ^ E.W := by omega
  have hwe : w ≤ E.W := by omega
  have hfne : f ≠ 0 := by intro hz; simp [hz] at hFpos
  have hscan := degreeScan_eq f hfne cap hdeg
  have hmarker : degreeScan f cap < 3 ↔ f.natDegree = 1 := by rw [hscan]; omega
  have hm2meta (slot : ℕ) (hlo : 72 ≤ slot) (hne : slot ≠ 95) : m2 slot = m slot := by
    simp [m2, m1, hne, show slot ≠ 64 by omega, show slot ≠ 66 by omega]
  have hout2 : OutputStored m2 B (rootPositionList N ι us) :=
    ((hout.meta_update hB 64 src (by norm_num)).meta_update hB 66 cap (by norm_num)).meta_update
      hB 95 (degreeScan f cap) (by norm_num)
  have hf1 := (hf.meta_update hsrc 64 src (by norm_num)).meta_update hsrc 66 cap (by norm_num)
  have hf2 := hf1.meta_update hsrc 95 (degreeScan f cap) (by norm_num)
  let Q := fun m' => m' 100 = rootPositionFlag N ι (us ++ traceRootSearch w [] f) ∧
    m' 101 = (us ++ traceRootSearch w [] f).length ∧
    OutputStored m' B (rootPositionList N ι (us ++ traceRootSearch w [] f)) ∧
    MemoryFrame (leafKeepWritable B us.length f.natDegree) m m'
  have hf01 : MemoryFrame (leafKeepWritable B us.length f.natDegree) m m1 :=
    MemoryFrame.trans (MemoryFrame.update_allowed _ m 64 src (Or.inl rfl))
      (MemoryFrame.update_allowed _ _ 66 cap (Or.inr (Or.inl rfl)))
  have hf02 : MemoryFrame (leafKeepWritable B us.length f.natDegree) m m2 :=
    MemoryFrame.trans hf01 (MemoryFrame.update_allowed _ _ 95 _ (Or.inr (Or.inr (Or.inl rfl))))
  obtain ⟨hSetupAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hScanAt, hKeepAt⟩ := At.seqStmt hRestAt
  have hSetup : Sem P E pc (pc + 28) (boundaryState pc m)
      (fun k z => k ≤ 28 ∧ z = boundaryState (pc + 28) m1) := by
    exact Sem.boundary_block P E _ (scanSetupCode 99) m m1 hSetupAt
      (by simp [scanSetupCode, metaReadCode, metaStoreCode, zeroRegsCode])
      (scanSetup_spec E _ 99 src cap (by omega) (by omega) hsrcWord hcapWord hm99 hm81)
  have hScan := scanProcedure_spec b P E (pc + 28) src cap f m1 hScanAt (by omega) hwe
    hsrcWord hcapWord hSword hf1 (by simp [m1]) (by simp [m1])
  have hBranch := degreeBelowBranch_spec P E (pc + 70) 3 leafEmissionProcedure m2 (degreeScan f cap) 72 Q
    hKeepAt (by omega) (by omega) (lt_of_le_of_lt (degreeScan_le _ _) hcapWord) (by simp [m2])
    (by
      intro hgo base hBodyAt
      have hlinear := hmarker.mp hgo
      have hroom' := hroom hlinear
      have hnWord : (rootPositionList N ι us).length + 1 < 2 ^ E.W := by
        simp only [rootPositionList, List.length_map]
        omega
      have hEmission := leafEmissionProcedure_spec b ι t N P E base src cap B f (rootPositionList N ι us)
        (rootPositionFlag N ι us) m2 hBodyAt hw hW hdet hmeta hN hSword hcap hB hnWord
        (by simp only [rootPositionList, List.length_map]; omega) (rootPositionFlag_le_one N ι us) hf2 hout2
        ((hm2meta 99 (by norm_num) (by norm_num)).trans hm99)
        ((hm2meta 77 (by norm_num) (by norm_num)).trans hm77)
        ((hm2meta 85 (by norm_num) (by norm_num)).trans hm85)
        (by simpa only [rootPositionList, List.length_map] using (hm2meta 101 (by norm_num) (by norm_num)).trans hm101)
        ((hm2meta 100 (by norm_num) (by norm_num)).trans hm100)
      refine Sem.mono hEmission ?_
      intro k z hPost
      obtain ⟨hk, m3, hz, h100, h101, hstore, hf23⟩ := hPost
      refine ⟨hk, ?_, ?_⟩
      · rw [hz]; rfl
      · change Q z.mem
        rw [hz]
        dsimp only [Q]
        have hr : traceRootSearch w [] f = [linearRoot f] := by simp [traceRootSearch, hlinear]
        rw [hr]
        refine ⟨?_, ?_, ?_, MemoryFrame.trans hf02 (hf23.mono (by
          intro addr ha
          simp only [rootPositionList, List.length_map] at ha
          dsimp [leafKeepWritable]
          omega))⟩
        · simpa [boundaryState, rootPositionFlag_append, rootPositionFlag] using h100
        · simpa [boundaryState, rootPositionList] using h101
        · simpa [boundaryState, rootPositionList_append, rootPositionList] using hstore)
    (by
      intro hstop
      have hnonlinear : f.natDegree ≠ 1 := fun h => hstop (hmarker.mpr h)
      have hr : traceRootSearch w [] f = [] := by simp [traceRootSearch, hnonlinear]
      dsimp only [Q]
      rw [hr, List.append_nil]
      exact ⟨(hm2meta 100 (by norm_num) (by norm_num)).trans hm100,
        (hm2meta 101 (by norm_num) (by norm_num)).trans hm101, hout2, hf02⟩)
  have hFull := Sem.seq_bound hSetup (fun z _ hz => by
    subst z
    exact Sem.seq_bound hScan (fun z _ hz => by subst z; exact hBranch))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2.1, hQ.2.2⟩)

theorem rootForest_leaf_length_le_mass {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (fs : List F[X]) : (rootForest w [] fs).length ≤ frontierMass fs := by
  induction fs with
  | nil => simp [rootForest, frontierMass]
  | cons f fs ih =>
      rw [rootForest_cons, List.length_append]
      by_cases h : f.natDegree = 1
      · simp only [traceRootSearch, if_pos h, List.length_singleton, frontierMass]
        omega
      · simp only [traceRootSearch, if_neg h, List.length_nil, zero_add, frontierMass]
        omega

theorem rootForest_leaf_snoc {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (fs : List F[X]) (f : F[X]) :
    rootForest w [] (fs ++ [f]) = rootForest w [] fs ++ traceRootSearch w [] f := by
  rw [rootForest_append]
  simp [rootForest]

theorem rootForest_prefix_budget {F : Type} [Field F] [DecidableEq F]
    (w : ℕ) (fs done pending : List F[X]) (f : F[X]) (T : ℕ)
    (heq : fs = done ++ (f :: pending)) (hmass : frontierMass fs ≤ T) :
    (rootForest w [] done).length + f.natDegree + frontierMass pending ≤ T := by
  have h := rootForest_leaf_length_le_mass w done
  rw [heq, frontierMass_append] at hmass
  change frontierMass done + (f.natDegree + frontierMass pending) ≤ T at hmass
  omega

theorem emission_meta_readonly (B T slot : ℕ) (hB : 128 ≤ B) (hs : slot < 128) (hn : ¬ rootEmissionMeta slot) :
    ¬ rootEmissionWritable B T slot := by
  intro h
  rcases h with h | h
  · exact hn h
  · omega

theorem leaf_keep_writable_le_emission (B T n degree addr : ℕ)
    (hroom : degree = 1 → n < T) (ha : leafKeepWritable B n degree addr) : rootEmissionWritable B T addr := by
  rcases ha with h64 | h66 | h95 | h100 | h101 | ⟨hdeg, hout⟩
  · exact Or.inl (Or.inl h64)
  · exact Or.inl (Or.inr (Or.inl h66))
  · exact Or.inl (Or.inr (Or.inr (Or.inl h95)))
  · apply Or.inl
    dsimp [rootEmissionMeta]
    omega
  · apply Or.inl
    dsimp [rootEmissionMeta]
    omega
  · have hn := hroom hdeg
    exact Or.inr ⟨by omega, by omega⟩

theorem FrontierStored.of_emission_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {m m' : ℕ → ℕ} {BQ cap B T : ℕ} {fs : List F[X]}
    (h : FrontierStored b m BQ cap fs) (hBQ : 128 ≤ BQ) (hlen : fs.length ≤ T)
    (hdisj : BQ + T * cap ≤ B ∨ B + T ≤ BQ) (hf : MemoryFrame (rootEmissionWritable B T) m m') :
    FrontierStored b m' BQ cap fs := by
  intro j hj
  apply (h j hj).of_frame hf
  intro i hi
  have hlo : BQ ≤ BQ + j * cap + i := by omega
  have hhi := queue_slot_before_next BQ cap T j i (by omega) hi
  dsimp [rootEmissionWritable, rootEmissionMeta]
  omega

theorem RootEmissionView.source_update {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {N : ℕ} {ι : ℕ → F} {BQ cap B : ℕ}
    {fs done pending : List F[X]} {m : ℕ → ℕ}
    (h : RootEmissionView b N ι BQ cap B fs done pending m) (hBQ : 128 ≤ BQ) (hB : 128 ≤ B) (src : ℕ) :
    RootEmissionView b N ι BQ cap B fs done pending (Function.update m 99 src) := by
  refine ⟨h.queue.meta_update hBQ 99 src (by norm_num), h.output.meta_update hB 99 src (by norm_num), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa using h.queueBase
  · simpa using h.outputBase
  · simpa using h.dimension
  · simpa using h.capacity
  · simpa using h.queueCount
  · simpa using h.index
  · simpa using h.remaining
  · simpa using h.flag
  · simpa using h.count

theorem rootEmissionBody_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc BQ cap B T : ℕ) (fs done pending : List F[X]) (f : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootEmissionBody pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (111 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W) (hcap : 2 ≤ cap) (hTcap : T < cap)
    (hBQ : 128 ≤ BQ) (hBQword : BQ + T * cap ≤ 2 ^ E.W)
    (hB : 128 ≤ B) (hBword : B + T ≤ 2 ^ E.W) (hdisj : BQ + T * cap ≤ B ∨ B + T ≤ BQ)
    (heq : fs = done ++ (f :: pending)) (hpos : ∀ g ∈ fs, 0 < g.natDegree) (hmass : frontierMass fs ≤ T)
    (hv : RootEmissionView b N ι BQ cap B fs done (f :: pending) m) :
    Sem P E pc (pc + 263) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ 17 * cap + 231 ∧ ∃ m', z = rankState (pc + 263) m' pending.length ∧
        RootEmissionView b N ι BQ cap B fs (done ++ [f]) pending m' ∧
        MemoryFrame (rootEmissionWritable B T) m m') := by
  have hlen := frontier_length_le_mass fs hpos
  have hfmem : f ∈ fs := by rw [heq]; simp
  have hfpos := hpos f hfmem
  have hfdeg := le_trans (frontier_degree_le_mass fs f hfmem) hmass
  have hbudget := rootForest_prefix_budget w fs done pending f T heq hmass
  have hroom : f.natDegree = 1 → (rootForest w [] done).length < T := by intro hf; omega
  have hlenEq : fs.length = done.length + (pending.length + 1) := by simp [heq]
  have hj : done.length < T := by omega
  have hslot := queue_slot_word_bounds BQ cap T done.length E.W hBQ (by omega) hj hBQword
  have hTword : T < 2 ^ E.W := by
    have hm : T ≤ T * cap := by simpa only [Nat.mul_one] using Nat.mul_le_mul_left T (show 1 ≤ cap by omega)
    omega
  have hnWord : pending.length + 1 < 2 ^ E.W := by omega
  have hjWord : done.length + 1 < 2 ^ E.W := by omega
  let src := BQ + done.length * cap
  let m1 := Function.update m 99 src
  have hv1 := hv.source_update hBQ hB src
  have hfactor : PolynomialStored b m1 src cap f := by
    have hjfs : done.length < fs.length := by omega
    have hg := hv1.queue done.length hjfs
    have he : fs.getD done.length 0 = f := by
      rw [heq, List.getD_append_right done (f :: pending) 0 done.length le_rfl, Nat.sub_self]
      rfl
    rw [he] at hg
    exact hg
  have hf01 : MemoryFrame (rootEmissionWritable B T) m m1 :=
    MemoryFrame.update_allowed _ m 99 src (by left; dsimp [rootEmissionMeta]; omega)
  obtain ⟨hPointerAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hKeepAt, hTailAt⟩ := At.seqStmt hRestAt
  have hPointer : Sem P E pc (pc + 30) (rankState pc m (pending.length + 1))
      (fun k z => k ≤ 30 ∧ z = boundaryState (pc + 30) m1) := by
    refine Sem.mono (Sem.block P E pc queueReadPointerCode _ hPointerAt
      (by simp [queueReadPointerCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 30 := hQ.1
    exact ⟨by omega, hQ.2.trans (queueReadPointer_spec E _ BQ done.length cap (by omega) (by omega)
      hslot.2.2.2.1 hslot.2.2.2.2 hslot.2.2.1 hslot.2.1 hv.queueBase hv.index hv.capacity)⟩
  have hKeep := leafKeepProcedure_spec b ι t N P E (pc + 30) src cap B T f (rootForest w [] done) m1 hKeepAt
    hw hW hdet (by omega) hN (by dsimp [src]; omega) hslot.1 hcap hB hBword hroom hfpos (by omega)
    hfactor hv1.output (by simp [m1]) hv1.dimension hv1.capacity hv1.outputBase hv1.count hv1.flag
  obtain ⟨_, k2, z2, hRun2, hPc2, hCost2, hRegs2, hFlag2, hCount2, hOutput2, hf12raw⟩ := hKeep
  let m2 := z2.mem
  have hz2 : z2 = boundaryState (pc + 212) m2 := by
    apply ramState_eq_of
    · exact hPc2
    · rfl
    · intro r; exact congrFun hRegs2 r
  have hf12 : MemoryFrame (rootEmissionWritable B T) m1 m2 :=
    hf12raw.mono (fun addr ha => leaf_keep_writable_le_emission B T (rootForest w [] done).length f.natDegree addr hroom ha)
  have hf02 := MemoryFrame.trans hf01 hf12
  have h91 : m2 91 = done.length := by
    have he : m2 91 = m1 91 := hf12raw 91 (by dsimp [leafKeepWritable]; omega)
    exact he.trans hv1.index
  have h111 : m2 111 = pending.length + 1 := by
    have he : m2 111 = m1 111 := hf12raw 111 (by dsimp [leafKeepWritable]; omega)
    exact he.trans hv1.remaining
  let m3 := Function.update (Function.update m2 91 (done.length + 1)) 111 pending.length
  have hf23 : MemoryFrame (rootEmissionWritable B T) m2 m3 :=
    MemoryFrame.trans (MemoryFrame.update_allowed _ m2 91 (done.length + 1) (by left; dsimp [rootEmissionMeta]; omega))
      (MemoryFrame.update_allowed _ _ 111 pending.length (by left; dsimp [rootEmissionMeta]; omega))
  have hf03 := MemoryFrame.trans hf02 hf23
  have hfixed (slot : ℕ) (hs : slot < 128) (hn : ¬ rootEmissionMeta slot) : m3 slot = m slot :=
    hf03 slot (emission_meta_readonly B T slot hB hs hn)
  have hv3 : RootEmissionView b N ι BQ cap B fs (done ++ [f]) pending m3 := by
    refine ⟨hv.queue.of_emission_frame hBQ (by omega) hdisj hf03, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [rootForest_leaf_snoc]
      exact (hOutput2.meta_update hB 91 (done.length + 1) (by norm_num)).meta_update hB 111 pending.length (by norm_num)
    · exact (hfixed 83 (by norm_num) (by norm_num [rootEmissionMeta])).trans hv.queueBase
    · exact (hfixed 85 (by norm_num) (by norm_num [rootEmissionMeta])).trans hv.outputBase
    · exact (hfixed 77 (by norm_num) (by norm_num [rootEmissionMeta])).trans hv.dimension
    · exact (hfixed 81 (by norm_num) (by norm_num [rootEmissionMeta])).trans hv.capacity
    · exact (hfixed 89 (by norm_num) (by norm_num [rootEmissionMeta])).trans hv.queueCount
    · simp [m3]
    · simp [m3]
    · simpa [m3, rootForest_leaf_snoc] using hFlag2
    · simpa [m3, rootForest_leaf_snoc] using hCount2
  have hKeepExact : Sem P E (pc + 30) (pc + 212) (boundaryState (pc + 30) m1)
      (fun k z => k ≤ 17 * cap + 150 ∧ z = boundaryState (pc + 212) m2) :=
    ⟨rfl, k2, z2, hRun2, hPc2, hCost2, hz2⟩
  have hTail : Sem P E (pc + 212) (pc + 263) (boundaryState (pc + 212) m2)
      (fun k z => k ≤ 51 ∧ z = rankState (pc + 263) m3 pending.length) := by
    refine Sem.mono (Sem.block P E _ rootLevelTailCode _ hTailAt
      (by simp [rootLevelTailCode, incrementMetaCode, countdownCode, metaReadCode, metaStoreCode, zeroRegsCode]) rfl) ?_
    intro k z hQ
    have hk : k = 51 := hQ.1
    exact ⟨by omega, hQ.2.trans (rootLevelTail_spec E _ done.length pending.length hmeta hjWord hnWord h91 h111)⟩
  have hFull := Sem.seq_bound hPointer (fun z _ hz => by
    subst z
    exact Sem.seq_bound hKeepExact (fun z _ hz => by subst z; exact hTail))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, m3, hQ.2, hv3, hf03⟩)

theorem rootEmissionLoop_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc BQ cap B T : ℕ) (fs : List F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile rootEmissionLoop pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (hmeta : (111 : ℕ) < 2 ^ E.W) (hN : N < 2 ^ E.W) (hcap : 2 ≤ cap) (hTcap : T < cap)
    (hBQ : 128 ≤ BQ) (hBQword : BQ + T * cap ≤ 2 ^ E.W)
    (hB : 128 ≤ B) (hBword : B + T ≤ 2 ^ E.W) (hdisj : BQ + T * cap ≤ B ∨ B + T ≤ BQ)
    (hpos : ∀ f ∈ fs, 0 < f.natDegree) (hmass : frontierMass fs ≤ T)
    (hv : RootEmissionView b N ι BQ cap B fs [] fs m) :
    Sem P E pc (pc + 265) (rankState pc m fs.length)
      (fun k z => k ≤ (17 * cap + 233) * fs.length + 1 ∧ z.regs = (fun _ => 0) ∧
        RootEmissionView b N ι BQ cap B fs fs [] z.mem ∧ MemoryFrame (rootEmissionWritable B T) m z.mem) := by
  let I := fun (n : ℕ) (z : RAMState) => n ≤ fs.length ∧ z.regs = Function.update (fun _ => 0) r9 n ∧
    ∃ done pending, fs = done ++ pending ∧ pending.length = n ∧
      RootEmissionView b N ι BQ cap B fs done pending z.mem ∧ MemoryFrame (rootEmissionWritable B T) m z.mem
  have hframe : ∀ n z pc', I n z → I n { z with pc := pc' } := by
    intro n z pc' h
    simpa only [I] using h
  have hcounter : ∀ n z, I n z → z.regs r9 = n := by
    intro n z h
    rw [h.2.1, Function.update_self]
  obtain ⟨_, _, hBodyAt, hJumpAt⟩ := at_loop hAt
  have hbody : ∀ n z, I (n + 1) z → z.pc = pc →
      Sem P E (pc + 1) pc { z with pc := pc + 1 } (fun k z' => k ≤ 17 * cap + 232 ∧ I n z') := by
    intro n z hI hpc
    obtain ⟨hn, hregs, done, pending, heq, hrem, hvz, hf⟩ := hI
    cases pending with
    | nil => simp at hrem
    | cons f pending =>
      have heN : n = pending.length := by simp only [List.length_cons] at hrem; omega
      subst n
      have hz : { z with pc := pc + 1 } = rankState (pc + 1) z.mem (pending.length + 1) := by
        apply ramState_eq_of
        · rfl
        · rfl
        · intro r; exact congrFun hregs r
      rw [hz]
      have hrun := rootEmissionBody_spec b ι t N P E (pc + 1) BQ cap B T fs done pending f z.mem hBodyAt
        hw hW hdet hmeta hN hcap hTcap hBQ hBQword hB hBword hdisj heq hpos hmass hvz
      refine Sem.jmp_append (hAt := hJumpAt) (Sem.mono hrun ?_)
      intro k z' hQ
      obtain ⟨hk, m', hz', hv', hf'⟩ := hQ
      refine ⟨by omega, by omega, ?_⟩
      rw [hz']
      refine ⟨rfl, done ++ [f], pending, ?_, rfl, hv', MemoryFrame.trans hf hf'⟩
      simpa only [List.append_assoc, List.singleton_append] using heq
  have hinit : I fs.length (rankState pc m fs.length) := by
    refine ⟨le_rfl, rfl, [], fs, by simp, rfl, hv, ?_⟩
    intro addr _; rfl
  have hloop := Sem.loop_invariant P E pc rootEmissionBody hAt (by omega) I (17 * cap + 232)
    hframe hcounter hbody fs.length (rankState pc m fs.length) hinit rfl
  refine Sem.mono hloop ?_
  intro k z hQ
  obtain ⟨hk, _, hregs, done, pending, heq, hrem, hvz, hf⟩ := hQ
  have hp : pending = [] := by
    cases pending with
    | nil => rfl
    | cons f pending => simp at hrem
  subst pending
  have hd : done = fs := by simpa using heq.symm
  subst done
  refine ⟨hk, ?_, hvz, hf⟩
  rw [hregs]
  funext r
  simp [Function.update_apply]

theorem rootEmissionProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] [DecidableEq F] {w : ℕ}
