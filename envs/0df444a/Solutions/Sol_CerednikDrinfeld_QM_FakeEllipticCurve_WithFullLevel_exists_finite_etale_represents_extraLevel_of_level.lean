section ClopenPts

variable {R : Type} [CommRing R] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of R)}
  (L : RelativeGroupLaw R f) (n : ℕ)

theorem opens_le_of_pts (U₁ U₂ : (L.schemeKer n).Opens)
    (h : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f),
      CerednikDrinfeld.QM.FactorsThrough (U₁.ι ≫ KerOps.ι L n) P →
        CerednikDrinfeld.QM.FactorsThrough (U₂.ι ≫ KerOps.ι L n) P) : U₁ ≤ U₂ := by
  intro y hy
  let x : ↑U₁ ⟶ L.schemeKer n := U₁.ι
  let P := KerOps.toPt L n x rfl
  have h1 : CerednikDrinfeld.QM.FactorsThrough (U₁.ι ≫ KerOps.ι L n) P := by
    rw [Bridge.factorsThrough_iff_of_lift L n U₁ P x rfl, Scheme.Opens.range_ι]
  have h2 := h _ P h1
  rw [Bridge.factorsThrough_iff_of_lift L n U₂ P x rfl, Scheme.Opens.range_ι] at h2
  exact h2 hy

theorem opens_eq_of_pts (U₁ U₂ : (L.schemeKer n).Opens)
    (h : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of R)) (P : SchemeHomOver t f),
      CerednikDrinfeld.QM.FactorsThrough (U₁.ι ≫ KerOps.ι L n) P ↔
        CerednikDrinfeld.QM.FactorsThrough (U₂.ι ≫ KerOps.ι L n) P) : U₁ = U₂ :=
  le_antisymm (opens_le_of_pts L n U₁ U₂ (fun t P => (h t P).mp)) (opens_le_of_pts L n U₂ U₁ (fun t P => (h t P).mpr))

def pieceSections {X : Scheme.{0}} (q : X ⟶ Spec (CommRingCat.of R)) (W : X.Opens)
    (k : Type) [Field k] (sk : R →+* k) :
    {w : Spec (CommRingCat.of k) ⟶ ↑W // w ≫ (W.ι ≫ q) = Spec.map (CommRingCat.ofHom sk)} ≃
    {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧ Set.range w ⊆ (W : Set ↥X)} where
  toFun w := ⟨w.1 ≫ W.ι, by rw [Category.assoc]; exact w.2, by
    rintro _ ⟨p, rfl⟩; rw [Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι W]; exact ⟨_, rfl⟩⟩
  invFun w := ⟨IsOpenImmersion.lift W.ι w.1 (by rw [Scheme.Opens.range_ι]; exact w.2.2), by
    rw [← Category.assoc, IsOpenImmersion.lift_fac]; exact w.2.1⟩
  left_inv w := by
    apply Subtype.ext; apply (cancel_mono W.ι).mp; rw [IsOpenImmersion.lift_fac]
  right_inv w := by apply Subtype.ext; exact IsOpenImmersion.lift_fac _ _ _

theorem opens_eq_of_le_of_finrank_eq {X : Scheme.{0}} (q : X ⟶ Spec (CommRingCat.of R)) [IsFinite q] [Etale q]
    (W₁ W₂ : X.Opens) (h₁ : IsClosed (W₁ : Set ↥X)) (h₂ : IsClosed (W₂ : Set ↥X)) (hle : W₁ ≤ W₂)
    (hrk : ∀ t, (W₁.ι ≫ q).finrank t = (W₂.ι ≫ q).finrank t) : W₁ = W₂ := by
  refine le_antisymm hle ?_
  intro y hy
  let κ := X.residueField y
  let k := AlgebraicClosure κ
  let ι₀ : Spec (CommRingCat.of k) ⟶ X :=
    Spec.map (CommRingCat.ofHom (algebraMap κ k)) ≫ X.fromSpecResidueField y
  have hpt : ∀ p, (X.fromSpecResidueField y) p = y := fun p => by
    have : (X.fromSpecResidueField y) p ∈ Set.range (X.fromSpecResidueField y) := ⟨p, rfl⟩
    rwa [Scheme.range_fromSpecResidueField, Set.mem_singleton_iff] at this
  have hι₀ : ∀ p, ι₀ p = y := fun p => by
    show (Spec.map (CommRingCat.ofHom (algebraMap κ k)) ≫ X.fromSpecResidueField y) p = y
    rw [Scheme.Hom.comp_apply, hpt]
  obtain ⟨skh, hsk⟩ := Spec.map_surjective (ι₀ ≫ q)
  let sk : R →+* k := skh.hom
  have hsk' : ι₀ ≫ q = Spec.map (CommRingCat.ofHom sk) := by rw [← hsk]; rfl
  have hqy : Spec.map (CommRingCat.ofHom sk) (IsLocalRing.closedPoint k) = q y := by
    rw [← hsk', Scheme.Hom.comp_apply, hι₀]
  haveI := isFinite_piece q W₁ h₁
  haveI := isFinite_piece q W₂ h₂
  have c1 : Nat.card {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧
      Set.range w ⊆ (W₁ : Set ↥X)} = (W₁.ι ≫ q).finrank (q y) := by
    rw [← hqy, AlgebraicGeometry.finrank_eq_natCard_of_isFinite_of_etale_of_isAlgClosed (W₁.ι ≫ q) k sk,
      Nat.card_congr (pieceSections q W₁ k sk)]
  have c2 : Nat.card {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧
      Set.range w ⊆ (W₂ : Set ↥X)} = (W₂.ι ≫ q).finrank (q y) := by
    rw [← hqy, AlgebraicGeometry.finrank_eq_natCard_of_isFinite_of_etale_of_isAlgClosed (W₂.ι ≫ q) k sk,
      Nat.card_congr (pieceSections q W₂ k sk)]
  have hpos : 1 ≤ (W₂.ι ≫ q).finrank (q y) := by
    have := Scheme.Hom.one_le_finrank_map (W₂.ι ≫ q) ⟨y, hy⟩
    rwa [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at this
  let incl : {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧ Set.range w ⊆ (W₁ : Set ↥X)} →
      {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧ Set.range w ⊆ (W₂ : Set ↥X)} :=
    fun w => ⟨w.1, w.2.1, w.2.2.trans hle⟩
  have hinj : Function.Injective incl := by
    intro w w' h
    apply Subtype.ext
    have := congrArg Subtype.val h
    exact this
  haveI : Finite {w : Spec (CommRingCat.of k) ⟶ X // w ≫ q = Spec.map (CommRingCat.ofHom sk) ∧
      Set.range w ⊆ (W₂ : Set ↥X)} := by
    apply Nat.finite_of_card_ne_zero
    rw [c2]; omega
  have hbij := (Function.Injective.bijective_of_nat_card_le hinj (by rw [c1, c2, hrk])).2
  obtain ⟨w, hw⟩ := hbij ⟨ι₀, hsk', by
    rintro _ ⟨p, rfl⟩; rw [hι₀]; exact hy⟩
  have hw1 : w.1 = ι₀ := congrArg Subtype.val hw
  have : Set.range ι₀ ⊆ (W₁ : Set ↥X) := by rw [← hw1]; exact w.2.2
  exact this ⟨IsLocalRing.closedPoint k, hι₀ _⟩

end ClopenPts
