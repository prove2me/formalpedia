             ?_ ?_ ?_ ?_
       |
         refine
           Light.Ends.callToThen (scan_meets hP C ha hb (c0 := 0) (Nat.zero_add x.n).le) ?_ ?_ ?_ ?_)
     (on_goal -1 =>
         first
         | ( (simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost, List.map_cons,
                 List.map_nil, List.sum_cons, List.sum_nil, ])
             (first
               | omega
               | ((ring_nf); (omega))))
         | omega
