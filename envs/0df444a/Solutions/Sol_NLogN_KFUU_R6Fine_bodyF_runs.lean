-- Source module: Solutions.R6FineRun
/-!
# Fine-bit exposure §2: the procedures `fineF` / `fineB` in IL

* `bodyF`: `qX /= 2`, one `mvFU` move, `qZ *= 2`; `bodyB`: `qZ /= 2`, one `mvBU` move, `qX *= 2`.
  **`loopF_runs`** / **`loopB_runs`**: `f` iterations (`rptX nR`) take stage `0` to stage `f`.
* `coreF` / `coreB`: with `y` on `dP` and `a, f` in `rCZ, rU`, set `qB = y`, `qX`, `qZ`, `nR = f`,
  `tq = 2`, run the loop, clear. **`coreF_runs`** / **`coreB_runs`**.
* `fineE core`: pop `w, f, a` from `dP` (into `rW, rU, rCZ`), run `core` if `a > 0`, push them
  back. **`fineE_runs`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU.R6Fine

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU IntMul.Kappa.R6

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-! ## The loop bodies -/

theorem pow_split {f k : ℕ} (hk : k < f) : 2 ^ (f - k) = 2 ^ (f - (k + 1)) * 2 := by
  rw [← pow_succ]; congr 1; omega

theorem pow_split3 {f k : ℕ} (hk : k < f) : 2 ^ (f - (k + 1)) * 2 * 2 ^ k = 2 ^ f := by
  rw [← pow_succ, ← pow_add]; congr 1; omega

theorem cFwd_le {P' M B w V : ℕ} (hV : P' * 2 * M * B = 2 * V) (hP : P' ≤ 2 * V) (hM : M ≤ 2 * V)
    (hB : B ≤ 2 * V) : cFwdF P' 2 M B w ≤ 44 * (kap w * V) + 8000 * V + 7600 := by
  unfold cFwdF
  rw [hV]
  have h1 := cUL_le P'; have h2 := cUL_le M; have h3 := cUL_le B; have h4 := cUL_le 2
  have e : (2 * 2 + 16) * kap w * (2 * V) = 40 * (kap w * V) := by ring
  rw [e]
  generalize kap w * V = KV
  omega

/-! ## The forward loop -/

set_option maxHeartbeats 8000000 in
theorem bodyF_runs_sol_aux (a f y w Z : ℕ) (ha : 1 ≤ a) (hy : 1 ≤ y) (hZ2 : 2 ≤ Z)
    (hVZ : zsz ((2 * (a * 2 ^ f * y) : ℕ) : ℤ) ≤ Z)
    (xs : List ℤ) (hlen : xs.length = vol [a, 2 ^ f, y, 2]) (hb : Bnd w xs)
    (t : IState HS) (R LX LZ L2 : List Item) (hT : t.G tq = .int ((2 ^ 1 : ℕ) : ℤ) :: L2)
    {LB : List Item} (hB : t.G qB = .int (y : ℤ) :: LB) {k : ℕ} (hk : k < f) (LA LC LD : List Item) :
    IRuns I iprog bodyF (cf3 (stLF a f y xs t R LX LZ k) lA lC lD LA LC LD)
      (cf3 (stLF a f y xs t R LX LZ (k + 1)) lA lC lD LA LC LD) (cIt w (a * 2 ^ f * y) Z) := by
  set V := a * 2 ^ f * y with hV
  have hp := pow_split hk
  have hp3 := pow_split3 hk
  set p1 := 2 ^ (f - (k + 1)) with hp1
  set p2 := 2 ^ k with hp2
  have hp1pos : 1 ≤ p1 := Nat.one_le_two_pow
  have hp2pos : 1 ≤ p2 := Nat.one_le_two_pow
  set S := cf3 (stLF a f y xs t R LX LZ k) lA lC lD LA LC LD with hS
  -- 1. qX /= 2
  have R1 := divF_runs (I := I) (iprog := iprog) (i := qX) (j := tq) (k := tq2) (by decide) (by decide)
    (by decide) S (a := a * 2 ^ (f - k)) (m := 1) (Li := LX) (Lj := L2)
    (by simp +decide [hp2, S, cf3, stLF]) (by simp +decide [hp2, S, cf3, stLF, hT])
  have eA : a * 2 ^ (f - k) / 2 ^ 1 = vol [a, p1] := by
    rw [hp, vol, List.prod_cons, List.prod_cons, List.prod_nil, mul_one, ← mul_assoc,
      pow_one, Nat.mul_div_cancel _ (by norm_num)]
  rw [eA] at R1
  set S1 := S.upd qX (.int ((vol [a, p1] : ℕ) : ℤ) :: LX) with hS1
  -- 2. the move
  have hlen1 : (stF a (2 ^ f) y (2 ^ (f - k)) p2 xs).length = vol ([a, p1] ++ [2] ++ [y] ++ [p2, 2]) := by
    rw [length_stF, hp]; simp only [vol, List.prod_cons, List.prod_nil, List.cons_append,
      List.nil_append]; ring
  have R2 := mvFU_runs (I := I) (iprog := iprog) S1 (stF a (2 ^ f) y (2 ^ (f - k)) p2 xs)
    [a, p1] [2] [y] [p2, 2] w R hlen1 (KFU.bnd_pull _ _ _ hb) (by simp [vol])
    (by simp [vol]; omega) (by simp [vol]; omega)
    (by simp only [vol, List.prod_cons, List.prod_nil, mul_one]; exact Nat.mul_pos ha hp1pos)
    (by simp +decide [hp2, S1, S, cf3, stLF]) (LX := LX) (LB := LB) (LZ := LZ)
    (by simp +decide [S1]) (by simp +decide [hp2, S1, S, cf3, stLF, hB])
    (by simp +decide [hp2, S1, S, cf3, stLF, vol])
  have hsw : ([a, p1].length) = 2 := rfl
  have hsw1 : ([2] : Shape).length = 1 := rfl
  have hsw2 : ([y] : Shape).length = 1 := rfl
  rw [hsw, hsw1, hsw2, stepF a (2 ^ f) y p1 (2 ^ (f - k)) p2 (2 ^ (k + 1)) hp (pow_succ 2 k)] at R2
  set S2 := S1.upd 0 (ints (stF a (2 ^ f) y p1 (2 ^ (k + 1)) xs) ++ R) with hS2
  -- 3. qZ *= 2
  have R3 := shlN_runs (I := I) (iprog := iprog) (i := qZ) (j := tq) (by decide) S2
    (a := p2 * 2) (m := 1) (Li := LZ) (Lj := L2)
    (by simp +decide [hp2, S2, S1, S, cf3, stLF]) (by simp +decide [hp2, S2, S1, S, cf3, stLF, hT])
  refine (R1.seq (R2.seq R3)).mono' ?_ ?_
  · have e3 : p2 * 2 * 2 ^ 1 = 2 ^ (k + 1) * 2 := by rw [hp2, pow_succ 2 k]; ring
    have e4 : vol [a, p1] = a * 2 ^ (f - (k + 1)) := by simp [vol, hp1]
    simp only [S2, S1, S, cf3, stLF, e3, e4, hp1]
    clear R1 R2 R3
    ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
  · -- cost
    have hvA : vol [a, p1] * 2 * y * vol [p2, 2] = 2 * V := by
      simp only [vol, List.prod_cons, List.prod_nil, hV]
      rw [← hp3]; ring
    have hAV : vol [a, p1] ≤ 2 * V := by
      have : vol [a, p1] * 1 * 1 * 1 ≤ vol [a, p1] * 2 * y * vol [p2, 2] :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left _ (by norm_num)) hy)
          (by simp [vol]; omega)
      omega
    have hyV : y ≤ 2 * V := by
      have : 1 * 1 * y * 1 ≤ vol [a, p1] * 2 * y * vol [p2, 2] :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul (by simp [vol]; nlinarith) (by norm_num))
          le_rfl) (by simp [vol]; omega)
      omega
    have hCV : vol [p2, 2] ≤ 2 * V := by
      have : 1 * 1 * 1 * vol [p2, 2] ≤ vol [a, p1] * 2 * y * vol [p2, 2] :=
        Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul (by simp [vol]; nlinarith) (by norm_num))
          hy) le_rfl
      omega
    have c1 := cFwd_le (w := w) hvA hAV hyV hCV
    have zle : ∀ x : ℕ, x ≤ 2 * V → zsz (x : ℤ) ≤ Z := fun x hx =>
      le_trans (NLogN.zsz_natCast_le hx) hVZ
    have c2 := cK3_le (zle _ hAV) (zle _ hyV) (zle _ hCV) hZ2
    have e2 : vol ([2] : Shape) = 2 := rfl
    have e3 : vol ([y] : Shape) = y := by simp [vol]
    rw [e2, e3]
    unfold cIt
    clear R1 R2 R3
    generalize kap w * V = KV at c1 ⊢
    omega

