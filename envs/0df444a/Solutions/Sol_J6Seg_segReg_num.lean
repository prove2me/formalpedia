open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section reg
variable {P R s t lam w α : ℕ}

/-- The numeric consequences of the budget. -/
theorem segReg_num_sol_aux (h : SegReg P R s t lam w α) :
    200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P ∧
    100 * (((lam : ℝ) + 1) * (3 * lam + 3) + 1) ≤ 2 ^ P ∧
    (lam : ℝ) * (2 * w + 1) * (15 * ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) *
      (((lam : ℝ) + 1) * (3 * lam + 3) + 1) / 2 ^ P) ≤ 1 / 100 ∧
    8 * ((s : ℝ) + 1) ^ 2 ≤ 2 ^ P ∧ 1 ≤ P := by
  have hS := two_pow_pos' P
  set D := ddR (α : ℝ) ((t : ℝ) / s) (lam - 1) with hD
  have hD1 : 1 ≤ D := one_le_ddR (sigma_ge h.hs h.hst) _
  have hl0 : (0 : ℝ) ≤ lam := Nat.cast_nonneg _
  have hw0 : (0 : ℝ) ≤ w := Nat.cast_nonneg _
  have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg _
  set X : ℝ := ((lam : ℝ) + 1) * (3 * lam + 3) + 1 with hX
  have hX1 : 1 ≤ X := by nlinarith
  set Y : ℝ := 3 / 2 * ((lam : ℝ) + 1) * (2 * w + 1) * ((s : ℝ) + 1) ^ 2 with hY
  have hG : fullG lam w s t α (1 / 2) = (D * X) * Y := by
    simp only [fullG, hD, hX, hY]; ring
  have hDX : X ≤ D * X := le_mul_of_one_le_left (by linarith) hD1
  have hs1 : 1 ≤ ((s : ℝ) + 1) ^ 2 := one_le_pow₀ (by linarith)
  have hlw : 1 ≤ ((lam : ℝ) + 1) * (2 * w + 1) := by nlinarith
  have hY1 : ((s : ℝ) + 1) ^ 2 ≤ Y := by
    rw [hY]
    have : 1 ≤ 3 / 2 * ((lam : ℝ) + 1) * (2 * w + 1) := by nlinarith
    nlinarith
  have hYge : 1 ≤ Y := le_trans hs1 hY1
  have hDX0 : 0 ≤ D * X := by nlinarith
  have hGX : X ≤ fullG lam w s t α (1 / 2) := by
    rw [hG]; exact hDX.trans (le_mul_of_one_le_right hDX0 hYge)
  have hGs : ((s : ℝ) + 1) ^ 2 ≤ fullG lam w s t α (1 / 2) := by
    rw [hG]; exact hY1.trans (le_mul_of_one_le_left (by linarith) (by nlinarith))
  have hP := h.hP
  have hX3 : 3 * (lam : ℝ) + 1 ≤ X := by rw [hX]; nlinarith
  have h1 : 200 * (3 * (lam : ℝ) + 1) ≤ 2 ^ P := by linarith
  refine ⟨h1, by linarith, ?_, by linarith, ?_⟩
  · rw [mul_div_assoc', div_le_iff₀ hS]
    have hk : (lam : ℝ) * (2 * w + 1) ≤ ((lam : ℝ) + 1) * (2 * w + 1) * ((s : ℝ) + 1) ^ 2 := by
      have : (lam : ℝ) * (2 * w + 1) ≤ ((lam : ℝ) + 1) * (2 * w + 1) := by nlinarith
      nlinarith
    have : (lam : ℝ) * (2 * w + 1) * (15 * D * X) ≤ 10 * fullG lam w s t α (1 / 2) := by
      rw [hG, hY]
      have := mul_le_mul_of_nonneg_left hk (by positivity : (0 : ℝ) ≤ 15 * (D * X))
      calc (lam : ℝ) * (2 * w + 1) * (15 * D * X) = 15 * (D * X) * ((lam : ℝ) * (2 * w + 1)) := by
            ring
        _ ≤ 15 * (D * X) * (((lam : ℝ) + 1) * (2 * w + 1) * ((s : ℝ) + 1) ^ 2) := this
        _ = _ := by ring
    linarith
  · rcases Nat.eq_zero_or_pos P with h0 | h0
    · subst h0; norm_num at h1; linarith
    · exact h0

end reg

