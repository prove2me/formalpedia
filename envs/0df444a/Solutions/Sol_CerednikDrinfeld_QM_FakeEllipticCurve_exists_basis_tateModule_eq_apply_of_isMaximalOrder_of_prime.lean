        refine Finset.sum_congr rfl fun i _ => ?_
        rw [TateModule.proj_apply, hc]
        exact TateModule.natCast_padicInt_smul_apply _ _ _
      have h2 : ((∑ i, g i • w i : TateModule ℓ (E.L.AlgPoints E.comm Ω)) : ℕ → E.L.AlgPoints E.comm Ω) n = ∑ i, (c i) • (w i : ℕ → E.L.AlgPoints E.comm Ω) n := by
        rw [← TateModule.proj_apply, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [TateModule.proj_apply, TateModule.smul_apply]
      rw [h1, ← h2, hg, TateModule.coe_zero, Pi.zero_apply]
    have hkill : pushPt (E.act (∑ i, c i • bΛ i)) (E.act_over _)
