          have hPeq : 𝔮₀ = P := Ideal.eq_of_le_of_height_le 𝔮₀ hle𝔮 (by rw [hP1]; exact h𝔮₀ht)
          refine ⟨(OSS s).comap F₀.subtype, ?_, ?_, ?_⟩
          ·
            intro htop
            have hmem : (algebraMap A₀ ↥F₀ ϖ₀ : ↥F₀)⁻¹ ∈ (OSS s).comap F₀.subtype := by
              rw [htop]; exact ValuationSubring.mem_top _
            rw [ValuationSubring.mem_comap, map_inv₀] at hmem
            apply hπinvA
            rw [← hSS_A s, map_inv₀, ← hϖ₀B]; exact hmem
