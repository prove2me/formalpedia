      intro k hk r
      have hcent := hRcentProper _ (map_subtype_lt_of_ne_top hK'ne)
        (le_normalizer_map_subtype_of_isAInvariant hK'inv) (r : G) r.2 (k : G)
        (Subgroup.mem_map_of_mem _ hk)
      exact Subtype.ext (by rw [hφval r k]; exact hcent)
