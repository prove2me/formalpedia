    have h1 : zsz ((2 : ℤ) ^ t) = t + 1 := NLogN.zsz_two_pow t
    have h2 : zsz (((2 ^ t : ℕ) : ℤ)) ≤ Bq := hbq _ (by omega)
    push_cast at h2; omega
  have hte : t < 2 ^ t := Nat.lt_two_pow_self
