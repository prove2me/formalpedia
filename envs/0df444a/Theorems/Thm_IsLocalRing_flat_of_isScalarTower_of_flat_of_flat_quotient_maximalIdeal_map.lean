-- title:
--   Fibrewise criterion of flatness for a tower of local rings
-- statement:
--   Let $R$, $S$, $S'$ be commutative rings forming a tower, i.e. $S$ is an $R$-algebra, $S'$ is an $S$-algebra and an $R$-algebra, and the two resulting $R$-algebra structures on $S'$ agree (`IsScalarTower R S S'`). Assume all three rings are local, that the structure maps $R \to S$ and $S \to S'$ are local homomorphisms (they carry the maximal ideal into the maximal ideal), and that $S$ and $S'$ are Noetherian. Write $I := \mathfrak{m}_R S$ and $I' := \mathfrak{m}_R S'$ for the ideals generated by the image of the maximal ideal of $R$ in $S$ and in $S'$ respectively; since $I$ maps into $I'$ under $S \to S'$ (the composite $R \to S \to S'$ being the structure map $R \to S'$), the quotient $S'/I'$ is canonically an algebra over $S/I$. The assertion is that if $S'$ is flat as an $R$-module and $S'/I'$ is flat as an $S/I$-module, then $S'$ is flat as an $S$-module. No finiteness hypothesis on $S'$ over $S$ is imposed.
--
--   This is the ring-theoretic form of the critère de platitude par fibres for a tower of local rings, in the direction deducing flatness over the intermediate ring from flatness over the base together with flatness of the induced map of fibres. It is used in the project to establish flatness of multiplication-by-$n$ type maps for the relative group law on Jacobians with good reduction, and in a descent of flatness along finitely presented algebras from the residue-field fibres.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsLocalRing_flat_of_isScalarTower_of_flat_of_flat_quotient_maximalIdeal_map.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem IsLocalRing.flat_of_isScalarTower_of_flat_of_flat_quotient_maximalIdeal_map
    {R S S' : Type} [CommRing R] [CommRing S] [CommRing S']
    [Algebra R S] [Algebra S S'] [Algebra R S'] [IsScalarTower R S S']
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing S']
    [IsLocalHom (algebraMap R S)] [IsLocalHom (algebraMap S S')]
    [IsNoetherianRing S] [IsNoetherianRing S'] :
    letI : Algebra (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))
        (S' ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S')) :=
      Ideal.Quotient.algebraQuotientOfLEComap (Ideal.map_le_iff_le_comap.mp (le_of_eq
        (by rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq R S S'])))
    Module.Flat R S' →
    Module.Flat (S ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S))
        (S' ⧸ (IsLocalRing.maximalIdeal R).map (algebraMap R S')) →
    Module.Flat S S' := by sorry
