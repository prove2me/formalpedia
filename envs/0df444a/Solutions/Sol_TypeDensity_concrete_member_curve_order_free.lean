theorem solution (m : TypeDensity.ConcreteMember) (J : Ideal m.R)
    (hJ : J ∈ m.toMeasured.stateSet) :
    Module.Free m.O (m.R ⧸ J) ∧ Module.Finite m.O (m.R ⧸ J) ∧ Module.finrank m.O (m.R ⧸ J) =
      m.s.degree := by
  obtain ⟨⟨f, rfl⟩, -, hmatch⟩ := hJ
  obtain ⟨e, he⟩ := TypeDensity.concrete_surface_special_fiber_equiv m.O m.pi m.hpi m.u m.a m.b
  have hc := TypeDensity.concrete_surface_contact_eq_special_fiber_contact m.O m.pi m.u m.a m.b m.ha e he
      f
  have hT : m.S.t = TypeDensity.surfaceT m.O m.pi m.u m.a m.b := m.hS_t
  have hsh := m.shape
  have hmatch' : (match m.s with
    | .single a c => m.S.a = a ∧ m.S.b = 0 ∧ TypeDensity.idealContact m.R (Ideal.span {f}) m.S.t = c
    | .crossing a b c h => m.S.a = a ∧ m.S.b = b ∧
      TypeDensity.idealContact m.R (Ideal.span {f}) m.S.t = c ∧ TypeDensity.idealContact m.R (Ideal.span {f}) m.S.x = h) :=
          hmatch
  revert hmatch' hsh
  generalize m.s = s
  intro hsh hmatch'
  cases s with
  | single a' c =>
    obtain ⟨rfl, hb, hc0⟩ := hsh
    exact TypeDensity.single_curve_free_of_eq_zero m.O m.pi m.hpi m.u _ m.b hb m.ha f e c hc0
      (by rw [← hc.1, ← hT]; exact hmatch'.2.2)
  | crossing a' b' c h =>
    obtain ⟨rfl, rfl, hb, hc0, hh0⟩ := hsh
    exact TypeDensity.concrete_surface_crossing_curve_free m.O m.pi m.hpi m.u _ _ m.ha hb f e c h hc0
      (by rw [← hc.1, ← hT]; exact hmatch'.2.2.1)
      (by rw [← hc.2 hb, ← m.hS_x]; exact hmatch'.2.2.2)
