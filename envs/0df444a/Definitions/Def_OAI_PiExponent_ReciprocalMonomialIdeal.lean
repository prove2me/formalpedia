-- title:
--   Ideals spanned by monomials above a reciprocal-weight threshold
-- statement:
--   The ideal generated by monomials whose weighted exponent sum, using weight 1/e_i on x_i, is at least D. The definition permits arbitrary natural exponents; both proposed lemmas explicitly require positivity.

import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Algebra.Order.Field.Rat

open scoped BigOperators

/-- The ideal spanned by monomials of reciprocal-exponent weight at least `D`.
The variables are arbitrary elements of a commutative ring; independence is not required. -/
noncomputable def OAI.PiExponent.FormalInterpolation.reciprocalMonomialIdeal
    {R : Type*} [CommRing R] {d : Nat}
    (x : Fin d → R) (e : Fin d → Nat) (D : ℚ) : Ideal R :=
  Ideal.span {r | ∃ a : Fin d → Nat,
    D ≤ ∑ i, (a i : ℚ) / (e i : ℚ) ∧ r = ∏ i, x i ^ a i}


