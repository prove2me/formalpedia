    (hvalb : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pullM s m x - (1 + b₁ * x)| ≤ C_b * x ^ 2)
    (hvalA : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pull  s a x - a₁ * x|       ≤ C_A * x ^ 2)
    (hJ : J ≠ 0) (hQ : Q ≠ 0) :
    ∃ η, 0 < η ∧ η ≤ ε ∧ ∃ Fe be Ae : ℝ → ℝ, FiniteBranch6 I s η f m a Fe be Ae ∧
      ChargedTailOutput I s η f m N w p a ∧ PrincipalDefectOutput I f m N w p a ∧
      NoCongruenceOutput I f m N w ∧ GeneralPositiveFamily I f m N w p a ∧
      (¬ ∃ T : ℝ, NonposBackgroundKSTail I f m N w T) ∧
      (¬ ∃ T : ℝ, EinsteinBackgroundKSTail I f m N w T) := by
  obtain ⟨η, hη, hηε, Fe, be, Ae, hS⟩ :=
    actualC6_of_residuals hε hP hN hB htail hCF hCb hCA hvalF hvalb hvalA
  exact ⟨η, hη, hηε, Fe, be, Ae, hS, FiniteKS14.vii14_charged_tail hP hN hB hS hQ,
    FiniteKS14.vii14_principal_defect hP hN hB hS hJ hQ,
    FiniteKS14.vii14_no_ricci_null_congruence hP hN hB hS hJ hQ,
    FiniteKS14.vii14_general_positive_family hP hN hB hS hJ hQ,
    FiniteKS14.vii14_no_nonpositive hP hN hB hS hJ hQ,
    FiniteKS14.vii14_no_einstein hP hN hB hS hJ hQ⟩
