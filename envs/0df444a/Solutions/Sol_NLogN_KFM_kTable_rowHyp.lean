theorem IState.embed_id (s t : IState S) : IState.embed id s t = s :=
  IState.ext' (fun x => IState.embed_G Function.injective_id s t x) rfl rfl

theorem IRuns.relabel {iprog : Fin P → IStmt S P} {iprog' : Fin P' → IStmt S P'}
    {g : Fin P → Fin P'} (hprog : ∀ j, iprog' (g j) = (iprog j).ren id g) {p : IStmt S P}
    {s s' : IState S} {c : ℕ} (h : IRuns I iprog p s s' c) :
    IRuns I iprog' (p.ren id g) s s' c := by
  have := IRuns.ren' Function.injective_id hprog h s (fun _ => rfl) rfl rfl
  rwa [IState.embed_id] at this

end Relabel

section RelabelHS

variable {P P' : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {iprog' : Fin P' → IStmt HS P'}
  {g : Fin P → Fin P'}

theorem SImplI.relabel (hprog : ∀ j, iprog' (g j) = (iprog j).ren id g) {ι : Type*} [Fintype ι]
    [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ} {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ}
    {code : ℕ → IStmt HS P} {e dw : ℕ} {cost : ℕ → ℕ}
    (h : SImplI I iprog r st n T code e dw cost) :
    SImplI I iprog' r st n T (fun w => (code w).ren id g) e dw cost := by
  intro s f zs l xs F w hC h0 hx hl hb
  obtain ⟨zs', h1, h2, h3⟩ := h s f zs l xs F w hC h0 hx hl hb
  exact ⟨zs', h1, h2, IRuns.relabel hprog h3⟩

theorem RowHyp.relabel (hprog : ∀ j, iprog' (g j) = (iprog j).ren id g) {K m r Z : ℕ}
    {Ψ : ℕ → ℕ} {CR τ : ℝ} (h : RowHyp I iprog K m r Z Ψ CR τ) :
    RowHyp I iprog' K m r Z Ψ CR τ := by
  intro k pos t S0 B hinj hlt haff hS0 hB hZ i j hij
  obtain ⟨code, cost, h1, h2⟩ := h k pos t S0 B hinj hlt haff hS0 hB hZ i j hij
  exact ⟨fun w => (code w).ren id g, cost, SImplI.relabel hprog h1, h2⟩

end RelabelHS

