def eh {Xo : Type} [AddCommGroup Xo] (e : Xo ≃+ (↥(characterLattice V) × ↥(characterLattice V))) : Xo →+ Q.Xp :=
  e.toAddMonoidHom

theorem e_law {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (e : Xo ≃+ (↥(characterLattice V) × ↥(characterLattice V)))
    (hT : ∀ ℓ : Nat.Primes, ℓ ≠ Q.s → ∀ x : Xo,
        ((e (heckeGen ℓ • x)).1 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).1 : V → ℤ) ∧
        ((e (heckeGen ℓ • x)).2 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).2 : V → ℤ))
    (hU : ∀ x : Xo,
        ((e (heckeGen Q.s • x)).1 : V → ℤ) = (Q.TV Q.s).mulVec ((e x).1 : V → ℤ) - ((e x).2 : V → ℤ) ∧
        ((e (heckeGen Q.s • x)).2 : V → ℤ) = ((Q.s : ℕ) : ℤ) • ((e x).1 : V → ℤ))
    (ℓ : Nat.Primes) (x : Xo) :
    Q.eh e (heckeGen ℓ • x) = heckeGen ℓ • Q.eh e x := by
  rw [Q.Xp_heckeGen_smul]
  show (id (e (heckeGen ℓ • x)) : Q.Xp) = Q.tX ℓ (e x)
  by_cases h : ℓ = Q.s
  · subst h
    rw [tX, if_pos rfl]
    obtain ⟨h1, h2⟩ := hU x
    apply Prod.ext
    · apply Subtype.ext
      exact h1
    · apply Subtype.ext
      exact h2
  · rw [tX, if_neg h]
    obtain ⟨h1, h2⟩ := hT ℓ h x
    apply Prod.ext
    · apply Subtype.ext
      exact h1
    · apply Subtype.ext
      exact h2

noncomputable def eX {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (e : Xo ≃+ (↥(characterLattice V) × ↥(characterLattice V)))
    (hT : ∀ ℓ : Nat.Primes, ℓ ≠ Q.s → ∀ x : Xo,
        ((e (heckeGen ℓ • x)).1 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).1 : V → ℤ) ∧
        ((e (heckeGen ℓ • x)).2 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).2 : V → ℤ))
    (hU : ∀ x : Xo,
        ((e (heckeGen Q.s • x)).1 : V → ℤ) = (Q.TV Q.s).mulVec ((e x).1 : V → ℤ) - ((e x).2 : V → ℤ) ∧
        ((e (heckeGen Q.s • x)).2 : V → ℤ) = ((Q.s : ℕ) : ℤ) • ((e x).1 : V → ℤ)) :
    Xo ≃ₗ[HeckeAlg] Q.Xp :=
  LinearEquiv.ofBijective (mkHeckeLinear (Q.eh e) (Q.e_law e hT hU)) e.bijective

theorem finrank_quot_eq_of_linearEquiv {A B : Type} [AddCommGroup A] [Module HeckeAlg A] [AddCommGroup B]
    [Module HeckeAlg B] (f : A ≃ₗ[HeckeAlg] B) (𝔪 : Ideal HeckeAlg) [𝔪.IsMaximal] :
    Module.finrank (HeckeAlg ⧸ 𝔪) (A ⧸ (𝔪 • (⊤ : Submodule HeckeAlg A))) =
      Module.finrank (HeckeAlg ⧸ 𝔪) (B ⧸ (𝔪 • (⊤ : Submodule HeckeAlg B))) := by
  have hmap : Submodule.map (f : A →ₗ[HeckeAlg] B) (𝔪 • ⊤) = 𝔪 • ⊤ := by
    rw [Submodule.map_smul'', Submodule.map_top, LinearEquiv.range]
  let g : (A ⧸ (𝔪 • (⊤ : Submodule HeckeAlg A))) ≃ₗ[HeckeAlg] (B ⧸ (𝔪 • (⊤ : Submodule HeckeAlg B))) :=
    Submodule.Quotient.equiv _ _ f hmap
  let g' : (A ⧸ (𝔪 • (⊤ : Submodule HeckeAlg A))) ≃ₗ[HeckeAlg ⧸ 𝔪] (B ⧸ (𝔪 • (⊤ : Submodule HeckeAlg B))) :=
    { g.toAddEquiv with
      map_smul' := fun r x => by
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        exact g.map_smul r x }
  exact g'.finrank_eq

theorem finrank_quotient_eq_finrank_heckeTorsion
    {Xo : Type} [AddCommGroup Xo] [Module HeckeAlg Xo]
    (e : Xo ≃+ (↥(characterLattice V) × ↥(characterLattice V)))
    (hT : ∀ ℓ : Nat.Primes, ℓ ≠ Q.s → ∀ x : Xo,
        ((e (heckeGen ℓ • x)).1 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).1 : V → ℤ) ∧
        ((e (heckeGen ℓ • x)).2 : V → ℤ) = (Q.TV ℓ).mulVec ((e x).2 : V → ℤ))
    (hU : ∀ x : Xo,
        ((e (heckeGen Q.s • x)).1 : V → ℤ) = (Q.TV Q.s).mulVec ((e x).1 : V → ℤ) - ((e x).2 : V → ℤ) ∧
        ((e (heckeGen Q.s • x)).2 : V → ℤ) = ((Q.s : ℕ) : ℤ) • ((e x).1 : V → ℤ))
    (H' : HeckeData Q.D) (hH' : H' = Q.H)
    {Ψo : Type} [AddCommGroup Ψo] [Module HeckeAlg Ψo]
    (eΨ : Ψo ≃+ ribbonComponentGroup Q.D)
    (hΨ : ∀ (ℓ : Nat.Primes) (c : Ψo) (φ : Module.Dual ℤ ↥(ribbonKernel Q.D)),
        eΨ c = ribbonComponentGroupProj Q.D φ →
          eΨ (heckeGen ℓ • c) = ribbonComponentGroupProj Q.D (φ ∘ₗ heckeKernelMap H' ℓ))
    (𝔪 : Ideal HeckeAlg) [𝔪.IsMaximal] (heis : ¬ IsEventuallyEisenstein 𝔪)
    (hη : heckeGen Q.s ^ 2 - 1 ∈ 𝔪) :
    Module.finrank (HeckeAlg ⧸ 𝔪) (Xo ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Xo))) =
      Module.finrank (HeckeAlg ⧸ 𝔪) ↥(heckeTorsion Ψo 𝔪) := by
  subst hH'
  rw [finrank_quot_eq_of_linearEquiv (Q.eX e hT hU) 𝔪, Q.finrank_Xp_eq_finrank_Ψa 𝔪 heis hη,
    Q.finrank_torsion_eq_finrank_Ψa eΨ hΨ 𝔪]

