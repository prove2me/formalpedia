private theorem _root_.RibetAssembly69.InstAdj.degAdjE (ℓ : Nat.Primes) (x : ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A)) → ℤ) (hx : x ∈ characterLattice ↥(ssPlaces q' (M * s) (IsLocalRing.ResidueField ↥A))) :
