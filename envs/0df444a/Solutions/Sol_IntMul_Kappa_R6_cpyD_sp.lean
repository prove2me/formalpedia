section
-- Source module: Solutions.KFV4Round
/-!
# KFV §6: one round of Lemma 16 in IL

A round of the computed forward procedure on coefficients is
`compRc p Sb Ex = twLc Ex ∘ layerQc p Sb` (`KFV1Coef`), the opposite round is
`compRIc p Sb Ex = layerQc p Sb ∘ twLc (-Ex)`.

* `LayerOK code T N r p W cost`: on every clean state holding a record array `zs` (scale `p`,
  width `≤ W`, `N` records in the unit disk) that represents `xs`, `code` leaves an array
  representing `T xs` (scale `p`, width `≤ W`, `N` records in the disk), at cost `≤ cost`.
* **`twist_run`**: the `J_E` pass of a round: the exponent table (`tabP`, `KFV3Tab`) and the
  per-record negacyclic rotation (`twC`, `KFV2Tw`), cost `cTab + cTw`.
* `LayerOK.twist` / `LayerOK.twistPre`: a layer followed / preceded by a twist pass;
  `LayerOK.comp`: sequential composition.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul KFC KFT KFU KFB KFH KFD KIL AModel

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## 1. Width and disk through the twist -/

/-! ## 2. The twist pass -/

/-! ## 3. Layers and their composition -/

section Layer

variable {r : ℕ}

theorem LayerOK.mono {code : IStmt HS Pp} {T : List (Fin r → ℂ) → List (Fin r → ℂ)} {N p W c c' : ℕ}
    (h : LayerOK I iprog code T N p W c) (hc : c ≤ c') : LayerOK I iprog code T N p W c' := by
  intro s f zs l xs hx hl h0 hC hb hd
  obtain ⟨zs', h1, h2, h3, h4, h5⟩ := h s f zs l xs hx hl h0 hC hb hd
  exact ⟨zs', h1, h2, h3, h4, h5.mono' rfl hc⟩

end Layer

end NLogN.KFV

end

section
-- Source module: Solutions.KFWImpl
/-!
# KFW: implementations by a single (uniform) program, parameters in the background

`SImplQ I iprog Q lo hi r st n T U e dw cost`: as `KFN.SImplI`, but

* the code `U` is **one** `IStmt` (not a family indexed by the width);
* the background `s` satisfies `Q s` (it holds the run-time parameters in registers);
* every managed stack other than the data stack `0` is empty (`Clean0 f`);
* the input width `w` lies in a window: `lo ≤ w` and `w + dw ≤ hi`.

`RImplQ` likewise.  Composition lemmas: `SImplQ.comp`, `RImplQ.comp`, `rImplQ_list`,
`sImplQ_of_rImplQ_roleDiag`; leaves from register programs: `sImplQ_leaf`, `rImplQ_leaf`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

section SQ

variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ} {st : ι → ℕ} {n : ℕ}

theorem SImplQ.mono {T : Matrix (ι → Fin 2) (ι → Fin 2) ℂ} {U : IStmt HS Pp} {e dw : ℕ}
    {c c' : ℕ → ℕ} (h : SImplQ I iprog Q lo hi r st n T U e dw c)
    (hc : ∀ w, lo ≤ w → w + dw ≤ hi → c w ≤ c' w) :
    SImplQ I iprog Q lo hi r st n T U e dw c' := by
  intro s f zs l xs F w hQ hC h0 hx hl hb h1 h2
  obtain ⟨zs', r1, b1, f1⟩ := h s f zs l xs F w hQ hC h0 hx hl hb h1 h2
  exact ⟨zs', r1, b1, f1.mono (hc w h1 h2)⟩

end SQ

section RQ

variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {r n : ℕ} {st : Fin m × κ → ℕ}

theorem RImplQ.mono {A : ROp (Fin W) m κ} {U : IStmt HS Pp} {e dw : ℕ} {c c' : ℕ → ℕ}
    (h : RImplQ I iprog Q lo hi r n st A U e dw c)
    (hc : ∀ w, lo ≤ w → w + dw ≤ hi → c w ≤ c' w) :
    RImplQ I iprog Q lo hi r n st A U e dw c' := by
  intro s f zs l X F w hQ hC h0 hx hX hb h1 h2
  obtain ⟨zs', r1, b1, f1⟩ := h s f zs l X F w hQ hC h0 hx hX hb h1 h2
  exact ⟨zs', r1, b1, f1.mono (hc w h1 h2)⟩

end RQ

end NLogN.KFW

end

section
-- Source module: Solutions.R6MCpy
/-!
# Round-six machine: copying a stored descriptor

The setup leaves the descriptors of the interface calls on `zPh`, `zLn`, `zCh` (`BaseOK6`). Before
a call, `cpyD Z X k c` copies the `k d + c` integers on top of `Z` onto the builder stack `X`
and leaves `Z` as it was (`d` from `zDd`; scratch `40`, counter `41`):
`mvK Z 40 41 n` moves them to `40` reversed, then a counted loop pushes each one back on `Z` and
on `X`.

* **`cpyD_sp`**: the specification on managed states.
* **`cpyD_run`**: the form `callW_I` uses: from any state with the descriptor on top of `Z`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL RS

noncomputable section

theorem lenE_lin : ∀ k c, (lenE k c).Lin
  | 0, _ => trivial
  | k + 1, c => ⟨trivial, lenE_lin k c⟩

theorem lenE_regs : ∀ k c, ∀ j ∈ (lenE k c).regs, j = zDd
  | 0, _ => by simp [lenE, Ex.regs]
  | k + 1, c => by
    intro j hj
    simp only [lenE, Ex.regs, List.mem_append, List.mem_singleton] at hj
    rcases hj with h | h
    · exact h
    · exact lenE_regs k c j h

theorem lenE_clean (k c : ℕ) : (lenE k c).Clean :=
  KFM.clean_of_regs _ fun j hj => by rw [lenE_regs k c j hj]; decide

theorem lenE_size : ∀ k c, (lenE k c).size = 2 * k + 1
  | 0, _ => rfl
  | k + 1, c => by simp only [lenE, Ex.size, lenE_size k c]; ring

section Eval

variable {u : IState HS} {dv : ℕ} (hd : u.top zDd = dv) (hi : u.IsInt zDd)
include hd

theorem lenE_eval : ∀ k c, (lenE k c).eval u = (k * dv + c : ℕ)
  | 0, c => by simp [lenE, Ex.eval]
  | k + 1, c => by simp only [lenE, Ex.eval, hd, lenE_eval k c]; push_cast; ring

include hi in
theorem lenE_ok : ∀ k c, (lenE k c).ok u
  | 0, _ => trivial
  | k + 1, c => ⟨hi, lenE_ok k c⟩

theorem lenE_bnd {B : ℕ} : ∀ k c, k * dv + c < 2 ^ B → dv < 2 ^ B → (lenE k c).Bnd u B
  | 0, c, h, _ => by
    simp only [lenE, Ex.Bnd]
    exact KFL.zsz_le_of_abs (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast (by omega))
  | k + 1, c, h, h2 => by
    simp only [lenE, Ex.Bnd]
    refine ⟨?_, lenE_bnd k c (by nlinarith) h2, ?_⟩
    · rw [hd]; exact KFL.zsz_le_of_abs (by rw [abs_of_nonneg (by positivity)]; exact_mod_cast h2)
    · show zsz (u.top zDd + (lenE k c).eval u) ≤ B
      rw [hd, lenE_eval hd k c]
      exact KFL.zsz_le_of_abs (by
        rw [abs_of_nonneg (by positivity)]
        have : dv + (k * dv + c) < 2 ^ B := by nlinarith
        exact_mod_cast this)

end Eval

theorem take_succ_rev (rv : List ℤ) (k : ℕ) (hk : k < rv.length) :
    (rv.take (k + 1)).reverse = rv[k] :: (rv.take k).reverse := by
  rw [List.take_add_one, List.getElem?_eq_getElem hk]; simp

set_option maxHeartbeats 4000000 in
/-- **The copy on managed states.** -/
theorem cpyD_sp_sol_aux {Z X : Fin HS} (hZX : Z ≠ X) (hZ5 : Z.val < 56) (hX5 : X.val < 56)
    (hZy : Z ≠ yC) (hZc : Z ≠ cC) (hXy : X ≠ yC) (hXc : X ≠ cC) (hXd : X ≠ zDd) (hZd : Z ≠ zDd)
    (s : IState HS) (f : Fin HS → List ℤ) (desc : List ℤ) (hfZ : f Z = desc) (hfX : f X = [])
    (hfY : f yC = []) (hfC : f cC = []) (hfD : f zDd = []) (k c dv B : ℕ)
    (hdv : (encK s f).top zDd = dv) (hdi : (encK s f).IsInt zDd) (hlen : desc.length = k * dv + c)
    (hB1 : k * dv + c < 2 ^ B) (hB2 : dv < 2 ^ B) (hB : Bnd B desc) :
    Sp (cpyD Z X k c) (encK s f) (encK s (Function.update f X desc))
      (2 * (2 * k + 2) * 2000 * (B + 2) + desc.length * (40000 * (B + 2) + 30) + 64) := by
  have hn_ok := lenE_ok hdv hdi k c
  have hn_ev := lenE_eval hdv k c
  have hn_b := lenE_bnd hdv (B := B) k c hB1 hB2
  -- 1. move
  have k1 := Sp.mvK (X := Z) (Y := yC) (C := cC) hZy hZc (by decide) hZ5 (by decide) (by decide)
    s f (lenE k c) (lenE_clean k c) hn_ok desc [] (by rw [hfZ, List.append_nil])
    (by rw [hn_ev, hlen]) B hB (lenE_lin k c) hn_b
  rw [hfY, List.append_nil] at k1
  set rv := desc.reverse with hrv
  set f1 := Function.update (Function.update f Z []) yC rv with hf1
  have hF0 : cpyF f Z X rv 0 = f1 := by
    funext j
    simp only [cpyF, hf1, Function.update_apply, List.drop_zero, List.take_zero, List.reverse_nil]
    by_cases e1 : j = Z
    · subst e1; simp [hZy, hZX]
    · by_cases e2 : j = X
      · subst e2; simp [e1, hXy, hfX]
      · simp [e1, e2]
  have hN : rv.length = desc.length := List.length_reverse
  have hFN : cpyF f Z X rv desc.length = Function.update f X desc := by
    funext j
    simp only [cpyF, Function.update_apply, ← hN, List.drop_length, List.take_length, hrv,
      List.reverse_reverse]
    by_cases e1 : j = Z
    · subst e1; simp [hZX, hfZ]
    · by_cases e2 : j = X
      · subst e2; simp [e1]
      · by_cases e3 : j = yC
        · subst e3; simp [e1, e2, hfY]
        · simp [e1, e2, e3]
  -- 2. the loop
  have hF0e : (encK s (cpyF f Z X rv 0)) = encK s f1 := by rw [hF0]
  obtain ⟨LD, hLD⟩ := hdi
  rw [hdv] at hLD
  have hG0 : (encK s (cpyF f Z X rv 0)).G zDd = .int (dv : ℤ) :: LD := by
    rw [hF0e, ← hLD]
    simp [hf1, Function.update_apply, show zDd ≠ yC by decide, Ne.symm hZd]
  have htop0 : (encK s (cpyF f Z X rv 0)).top zDd = dv := IState.top_eq hG0
  have hok0 : (lenE k c).ok (encK s (cpyF f Z X rv 0)) :=
    lenE_ok htop0 (IState.isInt_of hG0) k c
  have k2 := Sp.rep (C := cC) (n := lenE k c) (b := cpyB Z X) (s := s) (F := cpyF f Z X rv)
    (N := desc.length) (B := B) (c := 9000 * (B + 2)) (by decide)
    (fun j => by
      simp only [cpyF, Function.update_apply, if_neg (Ne.symm hZc), if_neg (Ne.symm hXc),
        if_neg (show cC ≠ yC by decide), hfC])
    (by simp [cpyB, RS.writes, Ne.symm hZc, Ne.symm hXc, show cC ≠ yC by decide])
    (lenE_clean k c) hok0 (lenE_lin k c) (lenE_bnd htop0 k c hB1 hB2)
    (by rw [lenE_eval htop0, hlen]) ?_
  · rw [hF0e, hFN] at k2
    refine (k1.seq k2).mono ?_
    rw [lenE_size]
    have : 2 * k + 1 + 1 = 2 * k + 2 := by ring
    rw [this]
    nlinarith
  · intro i hi
    have hi' : i < rv.length := by rw [hN]; exact hi
    set G := Function.update (cpyF f Z X rv i) cC [((desc.length : ℕ) : ℤ) - i] with hG
    have hGy : G yC = rv[i] :: rv.drop (i + 1) := by
      simp only [hG, cpyF, Function.update_apply, if_neg (show yC ≠ cC by decide),
        if_neg (Ne.symm hZy), if_neg (Ne.symm hXy), if_pos rfl]
      exact List.drop_eq_getElem_cons hi'
    have hm : rv[i] ∈ desc := by
      have := List.getElem_mem hi'; simpa [hrv] using this
    have hbi : zsz rv[i] ≤ B := hB _ hm
    have hbnd : (Ex.reg yC).Bnd (encK s G) B := by
      show zsz ((encK s G).top yC) ≤ B
      rw [top_encK hGy]; exact hbi
    have s1 := Sp.push s G (i := X) (e := .reg yC) (B := B) hX5 (KFM.clean_of_regs _ (by decide))
      (ok_reg hGy) trivial hbnd
    rw [eval_reg hGy] at s1
    set G1 := Function.update G X (rv[i] :: G X) with hG1
    have hG1y : G1 yC = rv[i] :: rv.drop (i + 1) := by
      rw [hG1, Function.update_of_ne (Ne.symm hXy), hGy]
    have hbnd1 : (Ex.reg yC).Bnd (encK s G1) B := by
      show zsz ((encK s G1).top yC) ≤ B
      rw [top_encK hG1y]; exact hbi
    have s2 := Sp.push s G1 (i := Z) (e := .reg yC) (B := B) hZ5 (KFM.clean_of_regs _ (by decide))
      (ok_reg hG1y) trivial hbnd1
    rw [eval_reg hG1y] at s2
    set G2 := Function.update G1 Z (rv[i] :: G1 Z) with hG2
    have hG2y : G2 yC = rv[i] :: rv.drop (i + 1) := by
      rw [hG2, Function.update_of_ne (Ne.symm hZy), hG1y]
    have s3 := Sp.pop s G2 (i := yC) (B := B) (by decide) hG2y hbi
    have e : Function.update G2 yC (rv.drop (i + 1)) =
        Function.update (cpyF f Z X rv (i + 1)) cC [((desc.length : ℕ) : ℤ) - i] := by
      funext j
      have t1 := take_succ_rev rv i hi'
      simp only [hG2, hG1, hG, cpyF, Function.update_apply]
      by_cases e1 : j = yC
      · subst e1; simp [Ne.symm hZy, Ne.symm hXy, show yC ≠ cC by decide]
      · by_cases e2 : j = cC
        · subst e2; simp [e1, Ne.symm hZc, Ne.symm hXc]
        · by_cases e3 : j = Z
          · subst e3; simp [e1, e2, t1, hZX]
          · by_cases e4 : j = X
            · subst e4; simp [e1, e2, e3, t1]
            · simp [e1, e2, e3, e4]
    rw [e] at s3
    refine (s1.seq (s2.seq s3)).mono ?_
    simp only [Ex.size]
    omega

end

end IntMul.Kappa.R6

end

theorem solution : type_of% @IntMul.Kappa.R6.cpyD_sp_sol_aux := @IntMul.Kappa.R6.cpyD_sp_sol_aux
