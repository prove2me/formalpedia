theorem DirichletCharacter.admitsModulus_dirichletIdeleChar {N : ℕ} [NeZero N] (χ : DirichletCharacter ℂ N) :
    HeckeCharacter.AdmitsModulus ℚ χ.dirichletIdeleChar (Ideal.span {((N : ℕ) : 𝓞 ℚ)}) := by sorry
