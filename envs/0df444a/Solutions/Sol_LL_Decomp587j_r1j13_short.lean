        rw [div_le_iff₀ hDpos]
        push_cast; linarith
      · have hfl := Nat.lt_floor_add_one ((x * D_den - A) / hh)
        rw [div_lt_iff₀ hhh_r] at hfl
        rw [le_div_iff₀ hDpos]
        push_cast; linarith
  have hD_cover : domain (fun j => (r1j13_lo j : ℝ)) (fun j => (r1j13_hi j : ℝ)) ⊆
      ⋃ c ∈ idxSet, cell c := by
    rw [r1j13_domain_eq]
    intro x hx
    simp only [box3, mem_univ_pi] at hx
    have hx0 : x 0 ∈ Icc ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den) := by simpa using hx 0
    have hx1 : x 1 ∈ Icc ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den) := by simpa using hx 1
    have hx2 : x 2 ∈ Icc ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) := by simpa using hx 2
    have hh0_pos : 0 < h0 := nat_grid_step_pos hAB0 hh0_eq
    have hh1_pos : 0 < h1 := nat_grid_step_pos hAB1 hh1_eq
    have hh2_pos : 0 < h2 := nat_grid_step_pos hAB2 hh2_eq
    obtain ⟨i, hi, hi0, hi1⟩ := hcover1d A0_num B0_num h0 (x 0) hh0_pos hh0_eq (le_of_lt hAB0) hx0.1 hx0.2
    obtain ⟨j, hj, hj0, hj1⟩ := hcover1d A1_num B1_num h1 (x 1) hh1_pos hh1_eq (le_of_lt hAB1) hx1.1 hx1.2
    obtain ⟨k, hk, hk0, hk1⟩ := hcover1d A2_num B2_num h2 (x 2) hh2_pos hh2_eq (le_of_lt hAB2) hx2.1 hx2.2
    simp only [mem_iUnion, exists_prop]
    refine ⟨(i, j, k), by simp [idxSet, hi, hj, hk], ?_⟩
    simp only [cell, box3, mem_univ_pi]
    intro d
    fin_cases d
    · exact ⟨hi0, hi1⟩
    · exact ⟨hj0, hj1⟩
    · exact ⟨hk0, hk1⟩
  let f : (Fin 3 → ℝ) → ℝ := fun x =>
    ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩)
  have hsum_le : buchstabIntegral ω 1 (fun j => (r1j13_lo j : ℝ)) (fun j => (r1j13_hi j : ℝ)) φ ≤
      ∑ c ∈ idxSet, ∫ x in cell c, f x := by
    unfold buchstabIntegral
    apply setIntegral_le_sum_biUnion idxSet cell _ hD_cover
    · rintro ⟨i, j, k⟩ _; exact box3_measurable _ _ _ _ _ _
    · rintro c hc x hx
