    simpa only [List.flatMap_cons, List.append_assoc] using Block.Eval.loopTrue guard one rest

private theorem install_header (d : ℕ → K) (endAddr outputAddr tag : ℕ) (t : ℕ → ℕ) :
    Block.Eval (unchanged d)
