theorem solution {Pp : ℕ} {I : List NLogN.Sym} {iprog : Fin Pp → NLogN.IStmt NLogN.HS Pp} (s : NLogN.IState NLogN.HS) (f : Fin NLogN.HS → List ℤ) (Pre G Suf : AModel.Shape) {q e r : ℕ}
    (xs rest : List ℤ) (hq : 2 ≤ q) (hP : 1 ≤ AModel.vol Pre) (hG : 1 ≤ AModel.vol G) (hS : 1 ≤ AModel.vol Suf)
    (hre : r ≤ e) (hxs : xs.length = AModel.vol (AModelL12.qShape Pre G Suf q e)) (Bb : ℕ) (hb : NLogN.Bnd 1 xs) (hB1 : 1 ≤ Bb)
    (hV : NLogN.zsz ((AModel.vol (AModelL12.qShape Pre G Suf q e) : ℕ) : ℤ) ≤ Bb)
    {lP lG lS l1 l2 lR : List ℤ}
    (h0 : f 0 = xs ++ rest) (h24 : f 24 = []) (hfP : f NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: lP)
    (hfG : f NLogN.KIL.kG = (AModel.vol G : ℤ) :: lG) (hfS : f NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: lS)
    (hfQt : f NLogN.KIL.kQt = ((q ^ 0 : ℕ) : ℤ) :: l1) (hfQr : f NLogN.KIL.kQr = ((q ^ (e - 0) / q : ℕ) : ℤ) :: l2)
    (hfR : f NLogN.KIL.kR = (r : ℤ) :: lR) :
    NLogN.IRuns I iprog (NLogN.KFE.swapsF q) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (NLogN.KIL.swF f (AModelL12.qShape Pre G Suf q e) Pre.length (Pre.length + e + G.length) q e xs rest
        l1 l2 r))
      ((r + 1) * (NLogN.KFE.cSw1F q (AModel.vol (AModelL12.qShape Pre G Suf q e)) Bb + 10 ^ 4 * (Bb + 2))) := by
  set V := AModel.vol (AModelL12.qShape Pre G Suf q e) with hVdef
  set sh := AModelL12.qShape Pre G Suf q e
  set i0 := Pre.length
  set j0 := Pre.length + e + G.length
  have hVe := NLogN.KIL.vol_qShape Pre G Suf q e
  rw [← hVdef] at hVe
  have hle : ∀ x : ℕ, x ≤ V → NLogN.zsz (x : ℤ) ≤ Bb := fun x hx => le_trans (NLogN.KIL.zsz_nat_le hx) hV
  have hq1 : 1 ≤ q := by omega
  have hqe : ∀ a, a ≤ e → q ^ a ≤ q ^ e := fun a ha => Nat.pow_le_pow_right hq1 ha
  have hqpos : ∀ a, 1 ≤ q ^ a := fun a => Nat.one_le_pow _ _ (by omega)
  -- the basic volume bounds
  have hV1 : ∀ x y z w : ℕ, x ≤ AModel.vol Pre → y ≤ q ^ e → z ≤ AModel.vol G * AModel.vol Suf * q ^ e → w = x * y * z →
      w ≤ V := by
    intro x y z w hx hy hz hw
    rw [hw, hVe]
    calc x * y * z ≤ AModel.vol Pre * q ^ e * (AModel.vol G * AModel.vol Suf * q ^ e) := by gcongr
      _ = _ := by ring
  have F0 : NLogN.KIL.swF f sh i0 j0 q e xs rest l1 l2 0 = f := by
    funext j
    simp only [NLogN.KIL.swF, Function.update_apply, AModelL12.highSwaps, List.range_zero, List.foldl_nil]
    split_ifs with h1 h2 h3 <;> (try subst h1) <;> (try subst h2) <;> (try subst h3) <;> simp_all
  have hregs : ∀ k, ∀ r' : Fin NLogN.HS, r' ≠ 0 → r' ≠ NLogN.KIL.kQt → r' ≠ NLogN.KIL.kQr → r' ≠ 24 →
      Function.update (NLogN.KIL.swF f sh i0 j0 q e xs rest l1 l2 k) 24 [(r : ℤ) - k] r' = f r' := by
    intro k r' a b c d; simp [NLogN.KIL.swF, Function.update_apply, a, b, c, d]
  have hrV : r ≤ V := by
    have h1 : r ≤ q ^ e := le_trans hre (Nat.lt_pow_self (by omega)).le
    have h2 : q ^ e ≤ V := by
      rw [hVe]
      have := Nat.mul_pos hP (Nat.mul_pos hG hS)
      calc q ^ e ≤ q ^ e * (AModel.vol G * (q ^ e * AModel.vol Suf)) :=
            Nat.le_mul_of_pos_right _ (Nat.mul_pos hG (Nat.mul_pos (hqpos e) hS))
        _ ≤ _ := Nat.le_mul_of_pos_left _ hP
    omega
  have H := NLogN.KIL.IRuns.irep (I := I) (iprog := iprog) (C := 24) (n := .reg NLogN.KIL.kR) (s := s)
    (F := NLogN.KIL.swF f sh i0 j0 q e xs rest l1 l2) (N := r) (B := Bb) (c := NLogN.KFE.cSw1F q V Bb)
    (body := .seq (NLogN.KFD.swapEF NLogN.KIL.swA (.lit (q : ℤ)) NLogN.KIL.swB NLogN.KIL.swC6)
      (NLogN.RS.seq (.asg NLogN.KIL.kQt (.mul (.reg NLogN.KIL.kQt) (.lit (q : ℤ)))) (.asg NLogN.KIL.kQr (.ndiv (.reg NLogN.KIL.kQr) (.lit (q : ℤ))))).code)
    hB1 (by decide) (fun k => by simp +decide [NLogN.KIL.swF, Function.update_apply, h24])
    (NLogN.KIL.clean_reg (by decide))
    (by rw [F0]; exact NLogN.KIL.ok_reg hfR) trivial
    (by rw [F0]; exact NLogN.KIL.bnd_reg hfR (hle r hrV))
    (by rw [F0]; exact NLogN.KIL.eval_reg hfR) ?_
  · rw [F0] at H
    refine H.mono ?_
    simp only [NLogN.Ex.size]
    have h1 : 8000 * (Bb + 2) + 30 ≤ 10 ^ 4 * (Bb + 2) := by omega
    have h2 : (1 + 1) * 2000 * (Bb + 2) + (2 * Bb + 32) ≤ 10 ^ 4 * (Bb + 2) := by omega
    have h3 := Nat.mul_le_mul_left r (Nat.add_le_add_left h1 (NLogN.KFE.cSw1F q V Bb))
    have e : (r + 1) * (NLogN.KFE.cSw1F q V Bb + 10 ^ 4 * (Bb + 2)) =
        r * (NLogN.KFE.cSw1F q V Bb + 10 ^ 4 * (Bb + 2)) + (NLogN.KFE.cSw1F q V Bb + 10 ^ 4 * (Bb + 2)) := by ring
    rw [e]
    have e2 : r * (NLogN.KFE.cSw1F q V Bb + 8000 * (Bb + 2) + 30) = r * (NLogN.KFE.cSw1F q V Bb + (8000 * (Bb + 2) + 30)) := by
      ring
    rw [e2]
    omega
  · intro k hk
    have hke : k < e := lt_of_lt_of_le hk hre
    obtain ⟨g, hg⟩ : ∃ g, g = Function.update (NLogN.KIL.swF f sh i0 j0 q e xs rest l1 l2 k) 24 [(r : ℤ) - k] :=
      ⟨_, rfl⟩
    rw [← hg]
    set xk := AModelL12.highSwaps sh i0 j0 k 0 xs with hxkdef
    have hxk : xk.length = V := NLogN.KIL.length_highSwaps hxs k
    have hbk : NLogN.Bnd 1 xk := NLogN.KIL.bnd_highSwaps hb k
    have gP : g NLogN.KIL.kP = (AModel.vol Pre : ℤ) :: lP := by
      rw [hg, hregs k NLogN.KIL.kP (by decide) (by decide) (by decide) (by decide), hfP]
    have gG : g NLogN.KIL.kG = (AModel.vol G : ℤ) :: lG := by
      rw [hg, hregs k NLogN.KIL.kG (by decide) (by decide) (by decide) (by decide), hfG]
    have gS : g NLogN.KIL.kS = (AModel.vol Suf : ℤ) :: lS := by
      rw [hg, hregs k NLogN.KIL.kS (by decide) (by decide) (by decide) (by decide), hfS]
    have gQt : g NLogN.KIL.kQt = ((q ^ k : ℕ) : ℤ) :: l1 := by simp +decide [hg, NLogN.KIL.swF, Function.update_apply]
    have hqr : q ^ (e - k) / q = q ^ (e - 1 - k) := by
      rw [show e - k = (e - 1 - k) + 1 by omega, pow_succ, Nat.mul_div_cancel _ (by omega)]
    have gQr : g NLogN.KIL.kQr = ((q ^ (e - 1 - k) : ℕ) : ℤ) :: l2 := by
      simp +decide [hg, NLogN.KIL.swF, Function.update_apply, hqr]
    have g0 : g 0 = xk ++ rest := by simp +decide [hg, NLogN.KIL.swF, Function.update_apply, xk]
    set t := NLogN.KIL.encK s g
    have tP := NLogN.KIL.encK_G_cons s gP
    have tG := NLogN.KIL.encK_G_cons s gG
    have tS := NLogN.KIL.encK_G_cons s gS
    have tQt := NLogN.KIL.encK_G_cons s gQt
    have tQr := NLogN.KIL.encK_G_cons s gQr
    -- volume bounds
    have hqk : q ^ k ≤ q ^ e := hqe k hke.le
    have hqr1 : q ^ (e - 1 - k) * q ^ k * q = q ^ e := by
      rw [← pow_add, ← pow_succ]; congr 1; omega
    have hGS := Nat.mul_pos hG hS
    have b1 : AModel.vol Pre * q ^ k ≤ V := by
      rw [hVe]
      calc AModel.vol Pre * q ^ k ≤ AModel.vol Pre * q ^ e := Nat.mul_le_mul_left _ hqk
        _ ≤ AModel.vol Pre * (q ^ e * (AModel.vol G * (q ^ e * AModel.vol Suf))) := Nat.mul_le_mul_left _
            (Nat.le_mul_of_pos_right _ (Nat.mul_pos hG (Nat.mul_pos (hqpos e) hS)))
    have c1 : q ^ e * AModel.vol Suf ≤ V := by
      rw [hVe]
      exact le_trans (Nat.le_mul_of_pos_left _ hG) (le_trans (Nat.le_mul_of_pos_left _ (hqpos e))
        (Nat.le_mul_of_pos_left _ hP))
    have c2 : AModel.vol G * q ^ e ≤ V := by
      rw [hVe]
      exact le_trans (Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right _ hS))
        (le_trans (Nat.le_mul_of_pos_left _ (hqpos e)) (Nat.le_mul_of_pos_left _ hP))
    have bqe : q ^ e ≤ V := le_trans (Nat.le_mul_of_pos_right _ hS) c1
    have b2 : q ^ (e - 1 - k) * AModel.vol G * q ^ k ≤ V := by
      have : q ^ (e - 1 - k) * q ^ k ≤ q ^ e := by rw [← hqr1]; exact Nat.le_mul_of_pos_right _ (by omega)
      calc q ^ (e - 1 - k) * AModel.vol G * q ^ k = AModel.vol G * (q ^ (e - 1 - k) * q ^ k) := by ring
        _ ≤ AModel.vol G * q ^ e := Nat.mul_le_mul_left _ this
        _ ≤ V := c2
    have b3 : q ^ (e - 1 - k) * AModel.vol Suf ≤ V :=
      le_trans (Nat.mul_le_mul_right _ (hqe _ (by omega))) c1
    have bq : q ≤ V := by
      have : q ≤ q ^ e := by
        calc q = q ^ 1 := (pow_one q).symm
          _ ≤ q ^ e := hqe 1 (by omega)
      omega
    have bq1 : q ^ (k + 1) ≤ V := le_trans (hqe _ hke) bqe
    have bP : AModel.vol Pre ≤ V := le_trans (Nat.le_mul_of_pos_right _ (hqpos k)) b1
    have bG : AModel.vol G ≤ V := by
      refine le_trans ?_ b2
      calc AModel.vol G = 1 * AModel.vol G * 1 := by ring
        _ ≤ q ^ (e - 1 - k) * AModel.vol G * q ^ k :=
          Nat.mul_le_mul (Nat.mul_le_mul_right _ (hqpos _)) (hqpos k)
    have bS : AModel.vol Suf ≤ V := le_trans (Nat.le_mul_of_pos_left _ (hqpos _)) b3
    have bQr : q ^ (e - 1 - k) ≤ V := le_trans (Nat.le_mul_of_pos_right _ hS) b3
    have rd : ∀ r' : Fin NLogN.HS, 38 ≤ r'.val ∧ r'.val < 56 → NLogN.KIL.RdOK r' := fun r' h => NLogN.KIL.rd_reg' h
    have gPe := NLogN.KIL.goodE_reg (rd NLogN.KIL.kP ⟨by decide, by decide⟩) tP (hle _ bP)
    have gGe := NLogN.KIL.goodE_reg (rd NLogN.KIL.kG ⟨by decide, by decide⟩) tG (hle _ bG)
    have gSe := NLogN.KIL.goodE_reg (rd NLogN.KIL.kS ⟨by decide, by decide⟩) tS (hle _ bS)
    have gQte := NLogN.KIL.goodE_reg (rd NLogN.KIL.kQt ⟨by decide, by decide⟩) tQt (hle _ (le_trans hqk bqe))
    have gQre := NLogN.KIL.goodE_reg (rd NLogN.KIL.kQr ⟨by decide, by decide⟩) tQr (hle _ bQr)
    have ga : NLogN.KIL.GoodE t Bb swA := NLogN.KIL.goodE_mul gPe gQte (by
      rw [NLogN.KIL.eval_reg' tP, NLogN.KIL.eval_reg' tQt]; exact_mod_cast hle _ b1)
    have gq : NLogN.KIL.GoodE t Bb (.lit (q : ℤ)) := NLogN.KIL.goodE_lit (hle _ bq)
    have gb1h : NLogN.zsz ((NLogN.Ex.mul (.reg NLogN.KIL.kQr) (.reg NLogN.KIL.kG)).eval t) ≤ Bb := by
      simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq tQr, NLogN.IState.top_eq tG]
      exact_mod_cast hle _ (le_trans (Nat.le_mul_of_pos_right _ (hqpos k)) b2)
    have gb1 : NLogN.KIL.GoodE t Bb (.mul (.reg NLogN.KIL.kQr) (.reg NLogN.KIL.kG)) := NLogN.KIL.goodE_mul gQre gGe gb1h
    have gb2h : NLogN.zsz (NLogN.KIL.swB.eval t) ≤ Bb := by
      simp only [NLogN.KIL.swB, NLogN.Ex.eval]; rw [NLogN.IState.top_eq tQr, NLogN.IState.top_eq tG, NLogN.IState.top_eq tQt]
      exact_mod_cast hle _ b2
    have gb : NLogN.KIL.GoodE t Bb swB := NLogN.KIL.goodE_mul gb1 gQte gb2h
    have gc : NLogN.KIL.GoodE t Bb swC6 := NLogN.KIL.goodE_mul gQre gSe (by
      rw [NLogN.KIL.eval_reg' tQr, NLogN.KIL.eval_reg' tS]; exact_mod_cast hle _ b3)
    have hsh := NLogN.KIL.qShape_at Pre G Suf q e k hke
    have S1 := NLogN.KFD.swapEF_runs (I := I) (iprog := iprog) (Pre ++ List.replicate k q)
      (List.replicate (e - 1 - k) q ++ (G ++ List.replicate k q))
      (List.replicate (e - 1 - k) q ++ Suf) q Bb 1 NLogN.KIL.swA (.lit (q : ℤ)) NLogN.KIL.swB NLogN.KIL.swC6 t xk
      (NLogN.ints rest ++ s.G 0) (by simp [t, g0, NLogN.ints_append]) (by rw [hsh]; exact hxk) hbk
      (by rw [AModel.vol_append, AModel.vol_replicate]; exact Nat.mul_pos hP (hqpos k)) hq1
      (by simp only [AModel.vol_append, AModel.vol_replicate]; exact Nat.mul_pos (hqpos _) (Nat.mul_pos hG (hqpos k)))
      (by simp only [AModel.vol_append, AModel.vol_replicate]; exact Nat.mul_pos (hqpos _) hS)
      (by rw [hsh]; exact hV) ga gq gb gc
      (by simp only [NLogN.KIL.swA, NLogN.Ex.eval]; rw [NLogN.IState.top_eq tP, NLogN.IState.top_eq tQt, AModel.vol_append,
            AModel.vol_replicate]; push_cast; ring)
      rfl
      (by simp only [NLogN.KIL.swB, NLogN.Ex.eval]; rw [NLogN.IState.top_eq tQr, NLogN.IState.top_eq tG, NLogN.IState.top_eq tQt,
            AModel.vol_append, AModel.vol_append, AModel.vol_replicate, AModel.vol_replicate]; push_cast; ring)
      (by simp only [NLogN.KIL.swC6, NLogN.Ex.eval]; rw [NLogN.IState.top_eq tQr, NLogN.IState.top_eq tS, AModel.vol_append,
            AModel.vol_replicate]; push_cast; ring)
    rw [hsh, ← hVdef] at S1
    have ei : (Pre ++ List.replicate k q).length = i0 + k := by simp [i0]
    have ej : i0 + k + 1 +
        (List.replicate (e - 1 - k) q ++ (G ++ List.replicate k q)).length = j0 + k := by
      simp [j0]; omega
    rw [ei, ej, ← NLogN.KIL.highSwaps_succ, ← List.append_assoc, ← NLogN.ints_append, NLogN.KIL.encK_upd0] at S1
    -- the two register updates
    set g1 := Function.update g 0 (AModelL12.highSwaps sh i0 j0 (k + 1) 0 xs ++ rest)
    have g1Qt : g1 NLogN.KIL.kQt = ((q ^ k : ℕ) : ℤ) :: l1 := by simp +decide [g1, gQt]
    have t1Qt := NLogN.KIL.encK_G_cons s g1Qt
    have A1 := NLogN.KIL.Sp.asgQ s g1 (i := NLogN.KIL.kQt) (e := .mul (.reg NLogN.KIL.kQt) (.lit (q : ℤ))) (B := Bb) (by decide)
      g1Qt (hle _ (le_trans hqk bqe)) (NLogN.KIL.clean_mul (NLogN.KIL.clean_reg (by decide)) (NLogN.KIL.clean_lit _))
      ⟨NLogN.IState.isInt_of t1Qt, trivial⟩
      ⟨by simp only [NLogN.Ex.Bnd]; rw [NLogN.IState.top_eq t1Qt]; exact hle _ (le_trans hqk bqe), hle _ bq,
        by simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq t1Qt]
           exact_mod_cast hle _ (by rw [← pow_succ]; exact bq1)⟩
    have ev1 : (NLogN.Ex.mul (.reg NLogN.KIL.kQt) (.lit (q : ℤ))).eval (NLogN.KIL.encK s g1) = ((q ^ (k + 1) : ℕ) : ℤ) := by
      simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq t1Qt]; push_cast; ring
    rw [ev1] at A1
    set g2 := Function.update g1 NLogN.KIL.kQt (((q ^ (k + 1) : ℕ) : ℤ) :: l1)
    have g2Qr : g2 NLogN.KIL.kQr = ((q ^ (e - 1 - k) : ℕ) : ℤ) :: l2 := by simp +decide [g2, g1, gQr]
    have t2Qr := NLogN.KIL.encK_G_cons s g2Qr
    have A2 := NLogN.KIL.Sp.asgQ s g2 (i := NLogN.KIL.kQr) (e := .ndiv (.reg NLogN.KIL.kQr) (.lit (q : ℤ))) (B := Bb) (by decide)
      g2Qr (hle _ bQr) (NLogN.KIL.clean_ndiv (NLogN.KIL.clean_reg (by decide)) (NLogN.KIL.clean_lit _))
      ⟨NLogN.IState.isInt_of t2Qr, trivial, by simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq t2Qr]; positivity,
        by simp only [NLogN.Ex.eval]; omega⟩
      ⟨by simp only [NLogN.Ex.Bnd]; rw [NLogN.IState.top_eq t2Qr]; exact hle _ bQr, hle _ bq,
        by simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq t2Qr, ← Int.natCast_div]
           exact hle _ (le_trans (Nat.div_le_self _ _) bQr)⟩
    have ev2 : (NLogN.Ex.ndiv (.reg NLogN.KIL.kQr) (.lit (q : ℤ))).eval (NLogN.KIL.encK s g2) =
        ((q ^ (e - (k + 1)) / q : ℕ) : ℤ) := by
      simp only [NLogN.Ex.eval]; rw [NLogN.IState.top_eq t2Qr, ← Int.natCast_div,
        show e - (k + 1) = e - 1 - k by omega]
    rw [ev2] at A2
    refine (S1.seq (A1.seq A2).toIRuns).mono' ?_ ?_
    · congr 1
      funext j
      simp only [g2, g1, hg, NLogN.KIL.swF, Function.update_apply]
      by_cases e1 : j = NLogN.KIL.kQr
      · subst e1; simp +decide
      by_cases e2 : j = NLogN.KIL.kQt
      · subst e2; simp +decide
      by_cases e3 : j = 0
      · subst e3; simp +decide
      simp [e1, e2, e3]
    · have := NLogN.KFE.cSwapEF_le q V Bb
      simp only [NLogN.Ex.size] at this ⊢
      omega
end
