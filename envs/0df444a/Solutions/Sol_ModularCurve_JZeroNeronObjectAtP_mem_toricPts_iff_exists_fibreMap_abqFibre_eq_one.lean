theorem isUnit_natCast_of_coprime' {L : Type} [Field L] (A : ValuationSubring L) {p m : ℕ}
    (hA : A.LiesOverPrime p) (hpm : m.Coprime p) : IsUnit ((m : ℕ) : ↥A) := by
  by_contra hm
  have hm' : (m : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := hm
  have hp' : (p : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := by
    rw [← ValuationSubring.coe_mem_nonunits_iff]
    have : ((p : ↥A) : L) = (p : L) := by norm_cast
    rw [this]
    exact hA
  obtain ⟨u, v, huv⟩ := (Nat.Coprime.cast (R := ↥A) hpm : IsCoprime (m : ↥A) (p : ↥A))
  have h1 : (1 : ↥A) ∈ IsLocalRing.maximalIdeal ↥A := by
    rw [← huv]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hm') (Ideal.mul_mem_left _ _ hp')
  exact (IsLocalRing.maximalIdeal.isMaximal ↥A).ne_top (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)

theorem isUnit_natCast_of_coprime {p : ℕ} [Fact p.Prime] {A : ValuationSubring (AlgebraicClosure ℚ)}
    (hA : A.LiesOverPrime p) {m : ℕ} (hpm : m.Coprime p) : IsUnit (m : ↥A) :=
  isUnit_natCast_of_coprime' A hA hpm

theorem natCard_pi_nthRootsFinset_le (κ : Type) [CommRing κ] [IsDomain κ] (t m : ℕ) :
    Nat.card (Fin t → ↥(Polynomial.nthRootsFinset m (1 : κ))) ≤ m ^ t := by
  classical
  rw [Nat.card_eq_fintype_card, Fintype.card_pi, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin]
  apply Nat.pow_le_pow_left
  rw [Fintype.card_coe, Polynomial.nthRootsFinset_def]
  exact (Multiset.toFinset_card_le _).trans (Polynomial.card_nthRoots m 1)

theorem natCard_fun_nthRootsFinset_le (κ : Type) [Field κ] (t m : ℕ) :
    Nat.card (Fin t → ↥(Polynomial.nthRootsFinset m (1 : κ))) ≤ m ^ t :=
  natCard_pi_nthRootsFinset_le κ t m

theorem finite_pi_nthRootsFinset (κ : Type) [CommRing κ] [IsDomain κ] (t m : ℕ) :
    Finite (Fin t → ↥(Polynomial.nthRootsFinset m (1 : κ))) := inferInstance

noncomputable def charUnits {S B : Type} [CommRing S] [CommRing B] [Algebra S B] {t : ℕ}
    (χ : AddMonoidAlgebra S (Fin t → ℤ) →ₐ[S] B) : (Fin t → ℤ) →+ Additive Bˣ :=
  MonoidHom.toAdditiveRight (((χ : AddMonoidAlgebra S (Fin t → ℤ) →* B).comp
    (AddMonoidAlgebra.of S (Fin t → ℤ))).toHomUnits)

theorem charUnits_apply {S B : Type} [CommRing S] [CommRing B] [Algebra S B] {t : ℕ}
    (χ : AddMonoidAlgebra S (Fin t → ℤ) →ₐ[S] B) (x : Fin t → ℤ) :
    ((Additive.toMul (charUnits χ x) : Bˣ) : B) = χ (AddMonoidAlgebra.single x 1) := by
  simp [charUnits, AddMonoidAlgebra.of_apply]

theorem torusChar_ext {S B : Type} [CommRing S] [CommRing B] [Algebra S B] {t : ℕ}
    (χ χ' : AddMonoidAlgebra S (Fin t → ℤ) →ₐ[S] B)
    (h : ∀ i : Fin t, χ (AddMonoidAlgebra.single (Pi.single i (1 : ℤ)) 1) =
      χ' (AddMonoidAlgebra.single (Pi.single i (1 : ℤ)) 1)) : χ = χ' := by
  have hU : charUnits χ = charUnits χ' := by
    refine AddMonoidHom.functions_ext (Additive Bˣ) _ _ fun i n => ?_
    have key : (charUnits χ).comp (AddMonoidHom.single (fun _ : Fin t => ℤ) i) =
        (charUnits χ').comp (AddMonoidHom.single (fun _ : Fin t => ℤ) i) := by
      apply AddMonoidHom.ext_int
      apply Additive.toMul.injective
      apply Units.ext
      rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, AddMonoidHom.single_apply,
        charUnits_apply, charUnits_apply]
      exact h i
    have := DFunLike.congr_fun key n
    simpa only [AddMonoidHom.comp_apply, AddMonoidHom.single_apply] using this
  refine AddMonoidAlgebra.algHom_ext ?_ (Subsingleton.elim _ _)
  intro x
  have := congrArg (fun (φ : (Fin t → ℤ) →+ Additive Bˣ) => ((Additive.toMul (φ x) : Bˣ) : B)) hU
  simpa only [charUnits_apply] using this

end TORICCHAR.Aux

namespace TORICCHAR

variable {N₀ p : ℕ} [NeZero N₀] [Fact p.Prime] [NeZero p] {hpN₀ : ¬ p ∣ N₀}
  {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime p}
  {Λ : JZeroNeronObjectAtP.LevelData N₀ p A}

def Good (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x : JZero (N₀ * p)) : Prop :=
  ∃ s : SchemeHomOver Λ.σA O.g, (O.pts x).1 = barPt A ≫ s.1 ∧
    ∀ i : Fin 2, fibreMap (O.abqFibre i) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s) =
      Λ.L.one (resPt A ≫ Λ.σA)

theorem toFibrePt_one {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) :
    toFibrePt (L.one ι) = (L.baseChange ι).one (𝟙 _) := by
  have hover : overId (L.one ι) = L.one (𝟙 _ ≫ ι) := by
    apply Subtype.ext
    show (L.one ι).1 = (L.one (𝟙 _ ≫ ι)).1
    have := congrArg Subtype.val (L.one_natural ι (𝟙 _ ≫ ι) (𝟙 _) rfl)
    rw [GoodReductionJacobian.schemeHomOverComp_coe, Category.id_comp] at this
    exact this
  unfold toFibrePt
  rw [hover, RelativeGroupLaw.baseChange_one]

theorem ofFibrePt_one {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) :
    ofFibrePt ((L.baseChange ι).one (𝟙 _)) = L.one ι := by
  apply Subtype.ext
  show (RelativeGroupLaw.baseChangePointToBase ι ((L.baseChange ι).one (𝟙 _))).1 = (L.one ι).1
  rw [RelativeGroupLaw.baseChangePointToBase_one]
  have := congrArg Subtype.val (L.one_natural ι (𝟙 _ ≫ ι) (𝟙 _) rfl)
  rw [GoodReductionJacobian.schemeHomOverComp_coe, Category.id_comp] at this
  exact this.symm

theorem hom_one {R R' : Type} [CommRing R] [CommRing R'] {X Y : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    {g : Y ⟶ Spec (CommRingCat.of R)} (LY : RelativeGroupLaw R g) (LX : RelativeGroupLaw R f)
    (φ : SchemeHomOver (RelativeGroupLaw.baseChangeStr ι g) (RelativeGroupLaw.baseChangeStr ι f))
    (hφ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of R'))
      (x y : SchemeHomOver s (RelativeGroupLaw.baseChangeStr ι g)),
      NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).mul s x y) φ =
        (LX.baseChange ι).mul s (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp y φ))
    {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of R')) :
    NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).one s) φ = (LX.baseChange ι).one s := by
  letI := (LX.baseChange ι).pointGroup s
  have h := hφ s ((LY.baseChange ι).one s) ((LY.baseChange ι).one s)
  rw [(LY.baseChange ι).one_mul] at h

  have h' : (NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).one s) φ : SchemeHomOver s _) =
      (NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).one s) φ) *
        (NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).one s) φ) := h
  exact mul_left_cancel (h'.symm.trans (mul_one _).symm)

theorem good_zero (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : Good O 0 := by

  have hpts0 : O.pts 0 = O.L.one (genPt p) := by
    letI := O.L.pointGroup (genPt p)
    have h := O.pts_add 0 0
    rw [add_zero] at h
    have h' : (O.pts 0 : SchemeHomOver (genPt p) O.g) = O.pts 0 * O.pts 0 := h
    exact mul_left_cancel (h'.symm.trans (mul_one _).symm)
  refine ⟨O.L.one Λ.σA, ?_, fun i => ?_⟩
  · rw [hpts0]
    have := congrArg Subtype.val (O.L.one_natural Λ.σA (genPt p) (barPt A) Λ.hσA)
    rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
    exact this.symm
  · have hred : GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (O.L.one Λ.σA) =
        O.L.one (resPt A ≫ Λ.σA) := O.L.one_natural _ _ _ rfl
    rw [hred, fibreMap, toFibrePt_one, hom_one O.L Λ.L (O.abqFibre i) (O.abqFibre_mul i), ofFibrePt_one]

theorem comp_id_eq_overId {B T X : Scheme.{0}} {ι : T ⟶ B} {f : X ⟶ B} (x : SchemeHomOver ι f) :
    GoodReductionJacobian.schemeHomOverComp (𝟙 T) rfl x = castOver (Category.id_comp ι).symm (overId x) := by
  apply Subtype.ext
  rw [GoodReductionJacobian.schemeHomOverComp_coe, Category.id_comp]
  rfl

theorem overId_mul {R : Type} [CommRing R] {X T : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (ι : T ⟶ Spec (CommRingCat.of R)) (a b : SchemeHomOver ι f) :
    overId (L.mul ι a b) = L.mul (𝟙 _ ≫ ι) (overId a) (overId b) := by
  have h := L.mul_natural ι (𝟙 _ ≫ ι) (𝟙 _) rfl a b
  have ha : GoodReductionJacobian.schemeHomOverComp (𝟙 T) (rfl : 𝟙 T ≫ ι = 𝟙 T ≫ ι) a = overId a :=
    Subtype.ext (Category.id_comp _)
  have hb : GoodReductionJacobian.schemeHomOverComp (𝟙 T) (rfl : 𝟙 T ≫ ι = 𝟙 T ≫ ι) b = overId b :=
    Subtype.ext (Category.id_comp _)
  have hab : GoodReductionJacobian.schemeHomOverComp (𝟙 T) (rfl : 𝟙 T ≫ ι = 𝟙 T ≫ ι) (L.mul ι a b) =
      overId (L.mul ι a b) := Subtype.ext (Category.id_comp _)
  rw [ha, hb, hab] at h
  exact h

theorem toFibrePt_mul {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (a b : SchemeHomOver ι f) :
    toFibrePt (L.mul ι a b) = (L.baseChange ι).mul (𝟙 _) (toFibrePt a) (toFibrePt b) := by
  unfold toFibrePt
  rw [RelativeGroupLaw.baseChange_mul, RelativeGroupLaw.baseChangePointToBase_ofBase,
    RelativeGroupLaw.baseChangePointToBase_ofBase, overId_mul]

theorem ofFibrePt_mul {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (y z : SchemeHomOver (𝟙 _) (RelativeGroupLaw.baseChangeStr ι f)) :
    ofFibrePt ((L.baseChange ι).mul (𝟙 _) y z) = L.mul ι (ofFibrePt y) (ofFibrePt z) := by
  apply Subtype.ext
  show (RelativeGroupLaw.baseChangePointToBase ι ((L.baseChange ι).mul (𝟙 _) y z)).1 =
    (L.mul ι (ofFibrePt y) (ofFibrePt z)).1
  rw [RelativeGroupLaw.baseChangePointToBase_mul]
  have hy : RelativeGroupLaw.baseChangePointToBase ι y = overId (ofFibrePt y) := Subtype.ext rfl
  have hz : RelativeGroupLaw.baseChangePointToBase ι z = overId (ofFibrePt z) := Subtype.ext rfl
  rw [hy, hz, ← overId_mul]
  rfl

theorem fibreMap_mul {R R' : Type} [CommRing R] [CommRing R'] {X Y : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    {g : Y ⟶ Spec (CommRingCat.of R)} (LY : RelativeGroupLaw R g) (LX : RelativeGroupLaw R f)
    (φ : SchemeHomOver (RelativeGroupLaw.baseChangeStr ι g) (RelativeGroupLaw.baseChangeStr ι f))
    (hφ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of R'))
      (x y : SchemeHomOver s (RelativeGroupLaw.baseChangeStr ι g)),
      NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).mul s x y) φ =
        (LX.baseChange ι).mul s (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp y φ))
    (a b : SchemeHomOver ι g) :
    fibreMap φ (LY.mul ι a b) = LX.mul ι (fibreMap φ a) (fibreMap φ b) := by
  unfold fibreMap
  rw [toFibrePt_mul, hφ, ofFibrePt_mul]

theorem good_add (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x y : JZero (N₀ * p)}
    (hx : Good O x) (hy : Good O y) : Good O (x + y) := by
  obtain ⟨s, hs1, hs2⟩ := hx
  obtain ⟨t, ht1, ht2⟩ := hy
  refine ⟨O.L.mul Λ.σA s t, ?_, fun i => ?_⟩
  · have hs : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA s = O.pts x := Subtype.ext hs1.symm
    have ht : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA t = O.pts y := Subtype.ext ht1.symm
    have h := O.L.mul_natural Λ.σA (genPt p) (barPt A) Λ.hσA s t
    rw [hs, ht, ← O.pts_add] at h
    have := congrArg Subtype.val h
    rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
    exact this.symm
  · have hred : GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (O.L.mul Λ.σA s t) =
        O.L.mul (resPt A ≫ Λ.σA) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)
          (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl t) := O.L.mul_natural _ _ _ rfl s t
    rw [hred, fibreMap_mul O.L Λ.L (O.abqFibre i) (O.abqFibre_mul i), hs2 i, ht2 i, Λ.L.one_mul]

theorem inv_natural {R : Type} [CommRing R] {X T T' : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (t : T ⟶ Spec (CommRingCat.of R)) (t' : T' ⟶ Spec (CommRingCat.of R))
    (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (a : SchemeHomOver t f) :
    GoodReductionJacobian.schemeHomOverComp ψ hψ (L.inv t a) =
      L.inv t' (GoodReductionJacobian.schemeHomOverComp ψ hψ a) := by
  letI := L.pointGroup t'
  have h : (GoodReductionJacobian.schemeHomOverComp ψ hψ (L.inv t a) : SchemeHomOver t' f) *
      GoodReductionJacobian.schemeHomOverComp ψ hψ a = 1 := by
    show L.mul t' _ _ = L.one t'
    rw [← L.mul_natural t t' ψ hψ, L.inv_mul_cancel, L.one_natural t t' ψ hψ]
  exact eq_inv_of_mul_eq_one_left h

theorem fibreMap_one {R R' : Type} [CommRing R] [CommRing R'] {X Y : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    {g : Y ⟶ Spec (CommRingCat.of R)} (LY : RelativeGroupLaw R g) (LX : RelativeGroupLaw R f)
    (φ : SchemeHomOver (RelativeGroupLaw.baseChangeStr ι g) (RelativeGroupLaw.baseChangeStr ι f))
    (hφ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of R'))
      (x y : SchemeHomOver s (RelativeGroupLaw.baseChangeStr ι g)),
      NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).mul s x y) φ =
        (LX.baseChange ι).mul s (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp y φ)) :
    fibreMap φ (LY.one ι) = LX.one ι := by
  unfold fibreMap
  rw [toFibrePt_one, hom_one LY LX φ hφ, ofFibrePt_one]

theorem fibreMap_inv {R R' : Type} [CommRing R] [CommRing R'] {X Y : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    {g : Y ⟶ Spec (CommRingCat.of R)} (LY : RelativeGroupLaw R g) (LX : RelativeGroupLaw R f)
    (φ : SchemeHomOver (RelativeGroupLaw.baseChangeStr ι g) (RelativeGroupLaw.baseChangeStr ι f))
    (hφ : ∀ {T : Scheme.{0}} (s : T ⟶ Spec (CommRingCat.of R'))
      (x y : SchemeHomOver s (RelativeGroupLaw.baseChangeStr ι g)),
      NeronModelInfra.schemeHomOverComp ((LY.baseChange ι).mul s x y) φ =
        (LX.baseChange ι).mul s (NeronModelInfra.schemeHomOverComp x φ) (NeronModelInfra.schemeHomOverComp y φ))
    (a : SchemeHomOver ι g) :
    fibreMap φ (LY.inv ι a) = LX.inv ι (fibreMap φ a) := by
  letI := LX.pointGroup ι
  have h : (fibreMap φ (LY.inv ι a) : SchemeHomOver ι f) * fibreMap φ a = 1 := by
    show LX.mul ι _ _ = LX.one ι
    rw [← fibreMap_mul LY LX φ hφ, LY.inv_mul_cancel, fibreMap_one LY LX φ hφ]
  exact eq_inv_of_mul_eq_one_left h

theorem good_neg (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)}
    (hx : Good O x) : Good O (-x) := by
  obtain ⟨s, hs1, hs2⟩ := hx

  have hptsneg : O.pts (-x) = O.L.inv (genPt p) (O.pts x) := by
    letI := O.L.pointGroup (genPt p)
    have h0 : O.pts 0 = O.L.one (genPt p) := by
      have h := O.pts_add 0 0
      rw [add_zero] at h
      have h' : (O.pts 0 : SchemeHomOver (genPt p) O.g) = O.pts 0 * O.pts 0 := h
      exact mul_left_cancel (h'.symm.trans (mul_one _).symm)
    have h := O.pts_add (-x) x
    rw [neg_add_cancel, h0] at h
    have h' : (O.pts (-x) : SchemeHomOver (genPt p) O.g) * O.pts x = 1 := h.symm
    exact eq_inv_of_mul_eq_one_left h'
  refine ⟨O.L.inv Λ.σA s, ?_, fun i => ?_⟩
  · have hs : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA s = O.pts x := Subtype.ext hs1.symm
    have h := inv_natural O.L Λ.σA (genPt p) (barPt A) Λ.hσA s
    rw [hs, ← hptsneg] at h
    have := congrArg Subtype.val h
    rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
    exact this.symm
  · rw [inv_natural O.L _ _ _ rfl s, fibreMap_inv O.L Λ.L (O.abqFibre i) (O.abqFibre_mul i), hs2 i]
    letI := Λ.L.pointGroup (resPt A ≫ Λ.σA)
    exact inv_one

theorem apply_single_mem (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ)
    (gx : Fin t → ZMod m) : χ (AddMonoidAlgebra.single gx 1) ∈ A := by
  have hpow : (AddMonoidAlgebra.single gx (1 : ↥A)) ^ m = 1 := by
    rw [AddMonoidAlgebra.single_pow, one_pow]
    have : m • gx = 0 := by
      funext i; simp
    rw [this]; rfl
  have hζ : (χ (AddMonoidAlgebra.single gx 1)) ^ m = 1 := by rw [← map_pow, hpow, map_one]
  rw [← A.valuation_le_one_iff]
  have hv : A.valuation (χ (AddMonoidAlgebra.single gx 1)) ^ m = 1 := by rw [← map_pow, hζ, map_one]
  exact (pow_le_one_iff (Nat.pos_iff_ne_zero.mp hm)).mp hv.le

noncomputable def charMon (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    Multiplicative (Fin t → ZMod m) →* ↥A :=
  { toFun := fun gx => (⟨χ (AddMonoidAlgebra.single (Multiplicative.toAdd gx) 1),
      apply_single_mem t m hm χ _⟩ : ↥A)
    map_one' := Subtype.ext (by
      change χ (AddMonoidAlgebra.single (Multiplicative.toAdd (1 : Multiplicative (Fin t → ZMod m))) 1) = 1
      rw [toAdd_one, show AddMonoidAlgebra.single (0 : Fin t → ZMod m) (1 : ↥A) = 1 from rfl, map_one])
    map_mul' := fun a b => Subtype.ext (by
      change χ (AddMonoidAlgebra.single (Multiplicative.toAdd (a * b)) 1) =
        χ (AddMonoidAlgebra.single (Multiplicative.toAdd a) 1) * χ (AddMonoidAlgebra.single (Multiplicative.toAdd b) 1)
      rw [← map_mul, AddMonoidAlgebra.single_mul_single, one_mul, toAdd_mul]) }

noncomputable def charA (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    muCoord ↥A t m →ₐ[↥A] ↥A :=
  AddMonoidAlgebra.lift ↥A ↥A (Fin t → ZMod m) (charMon t m hm χ)

theorem subtype_comp_charA (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    (A.subtype).comp (charA t m hm χ).toRingHom = χ.toRingHom := by
  have : (Algebra.ofId ↥A (AlgebraicClosure ℚ)).comp (charA t m hm χ) = χ := by
    refine AddMonoidAlgebra.algHom_ext ?_ (Subsingleton.elim _ _)
    intro gx
    show ((charA t m hm χ) (AddMonoidAlgebra.single gx 1) : AlgebraicClosure ℚ) = χ (AddMonoidAlgebra.single gx 1)
    unfold charA
    rw [AddMonoidAlgebra.lift_single, one_smul]
    rfl
  exact congrArg AlgHom.toRingHom this

noncomputable def charK (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    muCoord (ResidueField ↥A) t m →ₐ[ResidueField ↥A] ResidueField ↥A :=
  AddMonoidAlgebra.lift _ _ _ ((residue ↥A).toMonoidHom.comp (charMon t m hm χ))

theorem charA_eq_lift (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    charA t m hm χ = AddMonoidAlgebra.lift _ _ _ (charMon t m hm χ) := rfl

theorem charK_comp_mapRingHom (t m : ℕ) (hm : 0 < m) (χ : muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ) :
    (charK t m hm χ).toRingHom.comp (AddMonoidAlgebra.mapRingHom (Fin t → ZMod m) (residue ↥A)) =
      (residue ↥A).comp (charA t m hm χ).toRingHom := by
  apply AddMonoidAlgebra.ringHom_ext
  · intro r
    show charK t m hm χ (AddMonoidAlgebra.mapRingHom _ (residue ↥A) (AddMonoidAlgebra.single 0 r)) =
      residue ↥A (charA t m hm χ (AddMonoidAlgebra.single 0 r))
    rw [AddMonoidAlgebra.mapRingHom_single, charK, charA_eq_lift, AddMonoidAlgebra.lift_single,
      AddMonoidAlgebra.lift_single]
    simp
  · intro gx
    show charK t m hm χ (AddMonoidAlgebra.mapRingHom _ (residue ↥A) (AddMonoidAlgebra.single gx 1)) =
      residue ↥A (charA t m hm χ (AddMonoidAlgebra.single gx 1))
    rw [AddMonoidAlgebra.mapRingHom_single, map_one, charK, charA_eq_lift, AddMonoidAlgebra.lift_single,
      AddMonoidAlgebra.lift_single, one_smul, one_smul]
    rfl

theorem good_toricPoint (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m)
    (χ : muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ) : Good O (O.toricPoint m hm χ) := by

  let χA := charA O.toricRank m hm χ
  let a : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥A))) (muStr ↥A O.toricRank m) :=
    ⟨Spec.map (CommRingCat.ofHom χA.toRingHom), by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : χA.toRingHom.comp (algebraMap ↥A (muCoord ↥A O.toricRank m)) = RingHom.id ↥A := by
        rw [AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]; rfl
      rw [h, CommRingCat.ofHom_id, Spec.map_id]⟩

  have hfac : (muPt A O.toricRank m χ).1 = barPt A ≫ a.1 := by
    show Spec.map (CommRingCat.ofHom χ.toRingHom) =
      Spec.map (CommRingCat.ofHom A.subtype) ≫ Spec.map (CommRingCat.ofHom χA.toRingHom)
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, subtype_comp_charA]

  let sB : SchemeHomOver (𝟙 _) (RelativeGroupLaw.baseChangeStr Λ.σA O.g) :=
    NeronModelInfra.schemeHomOverComp a (O.toricLift m hm)
  let s : SchemeHomOver Λ.σA O.g :=
    castOver (Category.id_comp Λ.σA) (RelativeGroupLaw.baseChangePointToBase Λ.σA sB)
  have hs1 : s.1 = a.1 ≫ (O.toricLift m hm).1 ≫ pullback.fst O.g Λ.σA := by
    show (a.1 ≫ (O.toricLift m hm).1) ≫ pullback.fst O.g Λ.σA = _
    rw [Category.assoc]
  refine ⟨s, ?_, fun i => ?_⟩
  ·
    show (O.pts (O.pts.symm (genOfBaseChangePt Λ.hσA
      (NeronModelInfra.schemeHomOverComp (muPt A O.toricRank m χ) (O.toricLift m hm))))).1 = barPt A ≫ s.1
    rw [Equiv.apply_symm_apply, hs1]
    show ((muPt A O.toricRank m χ).1 ≫ (O.toricLift m hm).1) ≫ pullback.fst O.g Λ.σA = _
    rw [hfac]
    simp only [Category.assoc]
  ·
    let χκ := charK O.toricRank m hm χ
    let aκ : Spec (CommRingCat.of (ResidueField ↥A)) ⟶ muScheme (ResidueField ↥A) O.toricRank m :=
      Spec.map (CommRingCat.ofHom χκ.toRingHom)
    have haκ : aκ ≫ muBaseChange (residue ↥A) O.toricRank m = resPt A ≫ a.1 := by
      show Spec.map (CommRingCat.ofHom χκ.toRingHom) ≫
          Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapRingHom (Fin O.toricRank → ZMod m) (residue ↥A))) =
        Spec.map (CommRingCat.ofHom (residue ↥A)) ≫ Spec.map (CommRingCat.ofHom χA.toRingHom)
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        charK_comp_mapRingHom]
    have haκ1 : aκ ≫ muStr (ResidueField ↥A) O.toricRank m = 𝟙 _ := by
      show Spec.map (CommRingCat.ofHom χκ.toRingHom) ≫ Spec.map (CommRingCat.ofHom (algebraMap _ _)) = 𝟙 _
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      have h : χκ.toRingHom.comp (algebraMap (ResidueField ↥A) (muCoord (ResidueField ↥A) O.toricRank m)) =
          RingHom.id _ := by
        rw [AlgHom.toRingHom_eq_coe, AlgHom.comp_algebraMap]; rfl
      rw [h, CommRingCat.ofHom_id, Spec.map_id]
    have hμ : muToTorus (ResidueField ↥A) O.toricRank m ≫ torusStr (ResidueField ↥A) O.toricRank =
        muStr (ResidueField ↥A) O.toricRank m := by
      show Spec.map _ ≫ Spec.map _ = Spec.map _
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      apply RingHom.ext
      intro r
      show AddMonoidAlgebra.mapDomainRingHom (ResidueField ↥A) _ (algebraMap _ _ r) = algebraMap _ _ r
      rw [AddMonoidAlgebra.coe_algebraMap, Function.comp_apply, Algebra.algebraMap_self_apply,
        AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single, map_zero]
      rfl
    let y : SchemeHomOver (𝟙 (Spec (CommRingCat.of (ResidueField ↥A)))) (torusStr (ResidueField ↥A) O.toricRank) :=
      ⟨aκ ≫ muToTorus (ResidueField ↥A) O.toricRank m, by rw [Category.assoc, hμ, haκ1]⟩

    have hy : NeronModelInfra.schemeHomOverComp y O.torusFibre =
        toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s) := by
      apply Subtype.ext
      apply pullback.hom_ext
      · show (y.1 ≫ O.torusFibre.1) ≫ pullback.fst O.g (resPt A ≫ Λ.σA) =
          (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)).1 ≫ pullback.fst O.g (resPt A ≫ Λ.σA)
        have hr : (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)).1 ≫
            pullback.fst O.g (resPt A ≫ Λ.σA) = resPt A ≫ s.1 := by
          show (RelativeGroupLaw.baseChangePointToBase (resPt A ≫ Λ.σA)
            (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s))).1 = _
          unfold toFibrePt
          rw [RelativeGroupLaw.baseChangePointToBase_ofBase]
          rfl
        rw [hr, hs1]
        show (aκ ≫ muToTorus _ _ m) ≫ O.torusFibre.1 ≫ pullback.fst O.g (resPt A ≫ Λ.σA) = _
        rw [Category.assoc, ← O.toricLift_special m hm, ← Category.assoc, haκ, Category.assoc]
      · show (y.1 ≫ O.torusFibre.1) ≫ pullback.snd O.g (resPt A ≫ Λ.σA) =
          (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)).1 ≫ pullback.snd O.g (resPt A ≫ Λ.σA)
        have h1 : O.torusFibre.1 ≫ pullback.snd O.g (resPt A ≫ Λ.σA) = torusStr _ O.toricRank := O.torusFibre.2
        have h2 : (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)).1 ≫
            pullback.snd O.g (resPt A ≫ Λ.σA) = 𝟙 _ :=
          (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s)).2
        rw [Category.assoc, h1, h2]
        exact y.2

    have hone := (O.abqFibre_eq_one_iff (𝟙 _) (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s))).mpr
      ⟨y, hy⟩ i
    unfold fibreMap
    rw [hone, ofFibrePt_one]

theorem good_of_mem_toricPts (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m)
    (x : JZero (N₀ * p)) (hx : x ∈ O.toricPts m) : Good O x := by
  rw [toricPts, dif_pos hm] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
      obtain ⟨χ, rfl⟩ := hy
      exact good_toricPoint O m hm χ
  | zero => exact good_zero O
  | add y z _ _ hy hz => exact good_add O hy hz
  | neg y _ hy => exact good_neg O hy

noncomputable def goodTors (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) : AddSubgroup (JZero (N₀ * p)) where
  carrier := {x | x ∈ jZeroTorsion (N₀ * p) m ∧ Good O x}
  add_mem' := fun {x y} hx hy => ⟨(jZeroTorsion (N₀ * p) m).add_mem hx.1 hy.1, good_add O hx.2 hy.2⟩
  zero_mem' := ⟨(jZeroTorsion (N₀ * p) m).zero_mem, good_zero O⟩
  neg_mem' := fun {x} hx => ⟨(jZeroTorsion (N₀ * p) m).neg_mem hx.1, good_neg O hx.2⟩

theorem castOver_mul {R : Type} [CommRing R] {X T : Scheme.{0}} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) {ι ι' : T ⟶ Spec (CommRingCat.of R)} (h : ι = ι') (a b : SchemeHomOver ι f) :
    castOver h (L.mul ι a b) = L.mul ι' (castOver h a) (castOver h b) := by
  subst h; rfl

theorem toricPoint_mul (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m)
    (F G : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)) :
    O.toricPoint m hm (F * G).ofConv = O.toricPoint m hm F.ofConv + O.toricPoint m hm G.ofConv := by
  apply O.pts.injective
  rw [O.pts_add]
  unfold toricPoint
  rw [Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply, O.toricLift_mul m hm F G]
  unfold genOfBaseChangePt
  rw [RelativeGroupLaw.baseChangePointToBase_mul, castOver_mul]

theorem toricPoint_one (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m) :
    O.toricPoint m hm (1 : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)).ofConv = 0 := by
  have h := toricPoint_mul O m hm 1 1
  rw [mul_one] at h
  exact left_eq_add.mp h

theorem toricPoint_pow (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m)
    (F : WithConv (muCoord ↥A O.toricRank m →ₐ[↥A] AlgebraicClosure ℚ)) (n : ℕ) :
    O.toricPoint m hm (F ^ n).ofConv = n • O.toricPoint m hm F.ofConv := by
  induction n with
  | zero => rw [pow_zero, zero_nsmul]; exact toricPoint_one O m hm
  | succ n ih => rw [pow_succ, toricPoint_mul, ih, succ_nsmul]

theorem convMul_apply_single {S : Type} [CommRing S] {Lr : Type} [CommRing Lr] [Algebra S Lr] {Gm : Type}
    [AddCommMonoid Gm] (F G : WithConv (AddMonoidAlgebra S Gm →ₐ[S] Lr)) (gx : Gm) :
    (F * G) (AddMonoidAlgebra.single gx 1) = F (AddMonoidAlgebra.single gx 1) * G (AddMonoidAlgebra.single gx 1) := by
  classical
  let 𝓡 : Coalgebra.Repr S (AddMonoidAlgebra.single gx (1 : S)) Unit :=
    { index := ({()} : Finset Unit)
      left := fun _ => AddMonoidAlgebra.single gx 1
      right := fun _ => AddMonoidAlgebra.single gx 1
      eq := by simp [TensorProduct.map_tmul] }
  have := congrArg (fun (φ : WithConv (AddMonoidAlgebra S Gm →ₗ[S] Lr)) => (WithConv.ofConv φ) (AddMonoidAlgebra.single gx 1))
    (AlgHom.toLinearMap_convMul F G)
  simp only [AlgHom.toLinearMap_apply] at this
  rw [this, Coalgebra.Repr.convMul_apply 𝓡, Finset.sum_singleton]
  rfl

theorem pow_apply_single {S : Type} [CommRing S] {Lr : Type} [CommRing Lr] [Algebra S Lr] {Gm : Type}
    [AddCommMonoid Gm] (F : WithConv (AddMonoidAlgebra S Gm →ₐ[S] Lr)) (gx : Gm) (n : ℕ) :
    (F ^ n) (AddMonoidAlgebra.single gx 1) = (F (AddMonoidAlgebra.single gx 1)) ^ n := by
  induction n with
  | zero =>
      rw [pow_zero, pow_zero, AlgHom.convOne_apply, AddMonoidAlgebra.counit_single, CommSemiring.counit_apply, map_one]
  | succ n ih => rw [pow_succ, convMul_apply_single, ih, pow_succ]

theorem char_pow_eq_one (t m : ℕ) (F : WithConv (muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ)) : F ^ m = 1 := by
  have hext : ∀ (F G : WithConv (muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ)),
      WithConv.ofConv F = WithConv.ofConv G → F = G := fun F G h => by simpa using congrArg WithConv.toConv h
  apply hext
  refine AddMonoidAlgebra.algHom_ext ?_ (Subsingleton.elim _ _)
  intro gx
  show (F ^ m) (AddMonoidAlgebra.single gx 1) = (1 : WithConv (muCoord ↥A t m →ₐ[↥A] AlgebraicClosure ℚ)) (AddMonoidAlgebra.single gx 1)
  rw [pow_apply_single, AlgHom.convOne_apply, AddMonoidAlgebra.counit_single, CommSemiring.counit_apply,
    map_one, ← map_pow, AddMonoidAlgebra.single_pow, one_pow]
  have : m • gx = 0 := by funext i; simp
  rw [this]
  exact map_one (WithConv.ofConv F)

theorem toricPts_le_goodTors (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m) :
    O.toricPts m ≤ goodTors O m := by
  intro x hx
  refine ⟨?_, good_of_mem_toricPts O m hm x hx⟩
  rw [toricPts, dif_pos hm] at hx
  refine (AddSubgroup.closure_le (K := jZeroTorsion (N₀ * p) m)).mpr ?_ hx
  rintro _ ⟨χ, rfl⟩
  show O.toricPoint m hm χ ∈ Submodule.torsionBy ℤ (JZero (N₀ * p)) (m : ℤ)
  rw [Submodule.mem_torsionBy_iff, natCast_zsmul]
  have h := toricPoint_pow O m hm (WithConv.toConv χ) m
  rw [char_pow_eq_one, toricPoint_one] at h
  simpa using h.symm

theorem secUniq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (s s' : SchemeHomOver Λ.σA O.g)
    (h : barPt A ≫ s.1 = barPt A ≫ s'.1) : s = s' := by
  haveI : IsSeparated O.g := O.separated
  haveI : IsDominant (barPt A) := by
    refine ⟨?_⟩
    show DenseRange (PrimeSpectrum.comap (CommRingCat.ofHom A.subtype).hom)
    rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
    intro r hr
    have : (A.subtype r : AlgebraicClosure ℚ) = 0 := hr
    have hr0 : r = 0 := Subtype.ext (by simpa using this)
    rw [hr0]
    exact Ideal.zero_mem _
  exact Subtype.ext (ext_of_isDominant_of_isSeparated O.g (s.2.trans s'.2.symm) (barPt A) h)

theorem pts_zero (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : O.pts 0 = O.L.one (genPt p) := by
  letI := O.L.pointGroup (genPt p)
  have h := O.pts_add 0 0
  rw [add_zero] at h
  have h' : (O.pts 0 : SchemeHomOver (genPt p) O.g) = O.pts 0 * O.pts 0 := h
  exact mul_left_cancel (h'.symm.trans (mul_one _).symm)

theorem pts_neg (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (x : JZero (N₀ * p)) :
    O.pts (-x) = O.L.inv (genPt p) (O.pts x) := by
  letI := O.L.pointGroup (genPt p)
  have h := O.pts_add (-x) x
  rw [neg_add_cancel, pts_zero] at h
  have h' : (O.pts (-x) : SchemeHomOver (genPt p) O.g) * O.pts x = 1 := h.symm
  exact eq_inv_of_mul_eq_one_left h'

noncomputable def sec (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    SchemeHomOver Λ.σA O.g :=
  hx.choose

theorem sec_gen (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    (O.pts x).1 = barPt A ≫ (sec O hx).1 :=
  hx.choose_spec.1

theorem sec_red (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) (i : Fin 2) :
    fibreMap (O.abqFibre i) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx)) =
      Λ.L.one (resPt A ≫ Λ.σA) :=
  hx.choose_spec.2 i

theorem sec_unique (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x)
    (s : SchemeHomOver Λ.σA O.g) (h : (O.pts x).1 = barPt A ≫ s.1) : sec O hx = s :=
  secUniq O _ _ ((sec_gen O hx).symm.trans h)

theorem sec_congr (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x y : JZero (N₀ * p)} (h : x = y)
    (hx : Good O x) (hy : Good O y) : sec O hx = sec O hy := by
  subst h; rfl

theorem sec_add (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x y : JZero (N₀ * p)}
    (hx : Good O x) (hy : Good O y) (hxy : Good O (x + y)) :
    sec O hxy = O.L.mul Λ.σA (sec O hx) (sec O hy) := by
  apply sec_unique
  have hs : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA (sec O hx) = O.pts x :=
    Subtype.ext (sec_gen O hx).symm
  have ht : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA (sec O hy) = O.pts y :=
    Subtype.ext (sec_gen O hy).symm
  have h := O.L.mul_natural Λ.σA (genPt p) (barPt A) Λ.hσA (sec O hx) (sec O hy)
  rw [hs, ht, ← O.pts_add] at h
  have := congrArg Subtype.val h
  rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
  exact this.symm

theorem sec_zero (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) : sec O (good_zero O) = O.L.one Λ.σA := by
  apply sec_unique
  rw [pts_zero]
  have := congrArg Subtype.val (O.L.one_natural Λ.σA (genPt p) (barPt A) Λ.hσA)
  rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
  exact this.symm

theorem sec_neg (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x)
    (hnx : Good O (-x)) : sec O hnx = O.L.inv Λ.σA (sec O hx) := by
  apply sec_unique
  have hs : GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA (sec O hx) = O.pts x :=
    Subtype.ext (sec_gen O hx).symm
  have h := inv_natural O.L Λ.σA (genPt p) (barPt A) Λ.hσA (sec O hx)
  rw [hs, ← pts_neg] at h
  have := congrArg Subtype.val h
  rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
  exact this.symm

theorem good_nsmul (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) (n : ℕ) :
    Good O (n • x) := by
  induction n with
  | zero => rw [zero_nsmul]; exact good_zero O
  | succ n ih => rw [succ_nsmul]; exact good_add O ih hx

theorem sec_nsmul (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    ∀ (n : ℕ) (hn : Good O (n • x)), sec O hn = O.L.nsmul Λ.σA n (sec O hx)
  | 0, hn => by
      rw [sec_congr O (zero_nsmul x) hn (good_zero O), sec_zero]; rfl
  | n + 1, hn => by
      rw [sec_congr O (succ_nsmul x n) hn (good_add O (good_nsmul O hx n) hx),
        sec_add O (good_nsmul O hx n) hx (good_add O (good_nsmul O hx n) hx),
        sec_nsmul O hx n (good_nsmul O hx n)]
      rfl

omit [NeZero N₀] [Fact p.Prime] [NeZero p] in
theorem nsmul_eq_zero_of_mem_jZeroTorsion {x : JZero (N₀ * p)} {m : ℕ} (hx : x ∈ jZeroTorsion (N₀ * p) m) :
    m • x = 0 := by
  have h : x ∈ Submodule.torsionBy ℤ (JZero (N₀ * p)) (m : ℤ) := hx
  rw [Submodule.mem_torsionBy_iff, natCast_zsmul] at h
  exact h

theorem isTorsionPoint_sec (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x)
    {m : ℕ} (hm : x ∈ jZeroTorsion (N₀ * p) m) : O.L.IsTorsionPoint Λ.σA m (sec O hx) := by
  show O.L.nsmul Λ.σA m (sec O hx) = O.L.one Λ.σA
  rw [← sec_nsmul O hx m (good_nsmul O hx m),
    sec_congr O (nsmul_eq_zero_of_mem_jZeroTorsion hm) (good_nsmul O hx m) (good_zero O), sec_zero]

theorem eq_zero_of_red_sec_eq_one (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {m : ℕ} (hpm : m.Coprime p)
    {x : JZero (N₀ * p)} (hx : x ∈ goodTors O m)
    (h : GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx.2) = O.L.one (resPt A ≫ Λ.σA)) :
    x = 0 := by
  haveI : LocallyOfFiniteType O.g := O.locallyOfFiniteType
  have hone : sec O hx.2 = O.L.one Λ.σA :=
    GoodReductionJacobian.RelativeGroupLaw.eq_one_of_isTorsionPoint_of_comp_residue_eq O.L O.comm Λ.σA m
      (Aux.isUnit_natCast_of_coprime hA hpm) (sec O hx.2) (isTorsionPoint_sec O hx.2 hx.1)
      (h.trans (O.L.one_natural Λ.σA (resPt A ≫ Λ.σA) (resPt A) rfl).symm)
  apply O.pts.injective
  apply Subtype.ext
  rw [sec_gen O hx.2, hone, pts_zero]
  have := congrArg Subtype.val (O.L.one_natural Λ.σA (genPt p) (barPt A) Λ.hσA)
  rw [GoodReductionJacobian.schemeHomOverComp_coe] at this
  exact this

theorem eq_of_red_sec_eq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {m : ℕ} (hpm : m.Coprime p)
    {x x' : JZero (N₀ * p)} (hx : x ∈ goodTors O m) (hx' : x' ∈ goodTors O m)
    (h : GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx.2) =
      GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx'.2)) : x = x' := by
  have hz : x - x' ∈ goodTors O m := (goodTors O m).sub_mem hx hx'
  have hsec : sec O hz.2 = O.L.mul Λ.σA (sec O hx.2) (O.L.inv Λ.σA (sec O hx'.2)) := by
    rw [sec_congr O (sub_eq_add_neg x x') hz.2 (good_add O hx.2 (good_neg O hx'.2)),
      sec_add O hx.2 (good_neg O hx'.2) (good_add O hx.2 (good_neg O hx'.2)), sec_neg O hx'.2]
  have hred : GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hz.2) = O.L.one (resPt A ≫ Λ.σA) := by
    rw [hsec, O.L.mul_natural, inv_natural O.L _ _ _ rfl, ← h]
    exact O.L.mul_inv_cancel _ _
  exact sub_eq_zero.mp (eq_zero_of_red_sec_eq_one O hpm hz hred)

theorem toFibrePt_ofFibrePt {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (y : SchemeHomOver (𝟙 _) (RelativeGroupLaw.baseChangeStr ι f)) : toFibrePt (ofFibrePt y) = y := by
  unfold toFibrePt
  have : overId (ofFibrePt y) = RelativeGroupLaw.baseChangePointToBase ι y := Subtype.ext rfl
  rw [this, RelativeGroupLaw.baseChangePointOfBase_toBase]

theorem ofFibrePt_toFibrePt {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (x : SchemeHomOver ι f) : ofFibrePt (toFibrePt x) = x := by
  apply Subtype.ext
  show (RelativeGroupLaw.baseChangePointToBase ι (toFibrePt x)).1 = x.1
  unfold toFibrePt
  rw [RelativeGroupLaw.baseChangePointToBase_ofBase]
  rfl

theorem toFibrePt_nsmul {R R' : Type} [CommRing R] [CommRing R'] {X : Scheme.{0}}
    {ι : Spec (CommRingCat.of R') ⟶ Spec (CommRingCat.of R)} {f : X ⟶ Spec (CommRingCat.of R)}
    (L : RelativeGroupLaw R f) (n : ℕ) (a : SchemeHomOver ι f) :
    toFibrePt (L.nsmul ι n a) = (L.baseChange ι).nsmul (𝟙 _) n (toFibrePt a) := by
  induction n with
  | zero => exact toFibrePt_one L
  | succ n ih => rw [RelativeGroupLaw.nsmul_succ, RelativeGroupLaw.nsmul_succ, toFibrePt_mul, ih]

theorem exists_torusPt (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    ∃ y : SchemeHomOver (𝟙 _) (torusStr (ResidueField ↥A) O.toricRank),
      NeronModelInfra.schemeHomOverComp y O.torusFibre =
        toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx)) := by
  refine (O.abqFibre_eq_one_iff (𝟙 _) _).mp fun i => ?_
  have h := sec_red O hx i
  unfold fibreMap at h
  have h' := congrArg toFibrePt h
  rw [toFibrePt_ofFibrePt, toFibrePt_one] at h'
  exact h'

noncomputable def torY (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    SchemeHomOver (𝟙 _) (torusStr (ResidueField ↥A) O.toricRank) :=
  (exists_torusPt O hx).choose

theorem torY_spec (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    NeronModelInfra.schemeHomOverComp (torY O hx) O.torusFibre =
      toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx)) :=
  (exists_torusPt O hx).choose_spec

theorem torY_alg (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    (Spec.preimage (torY O hx).1).hom.comp
        (algebraMap (ResidueField ↥A) (torusCoord (ResidueField ↥A) O.toricRank)) = RingHom.id _ := by
  have h2 : Spec.map (CommRingCat.ofHom (algebraMap (ResidueField ↥A) (torusCoord (ResidueField ↥A) O.toricRank)) ≫
      Spec.preimage (torY O hx).1) = Spec.map (𝟙 _) := by
    rw [Spec.map_comp, Spec.map_preimage, Spec.map_id]
    exact (torY O hx).2
  have := congrArg (fun f => f.hom) (Spec.map_inj.mp h2)
  simpa using this

noncomputable def torChar (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A :=
  { (Spec.preimage (torY O hx).1).hom with
    commutes' := fun r => by
      simpa using RingHom.congr_fun (torY_alg O hx) r }

theorem torChar_toRingHom (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    (torChar O hx).toRingHom = (Spec.preimage (torY O hx).1).hom := rfl

theorem torY_eq (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    torY O hx = torusPt (ResidueField ↥A) O.toricRank (torChar O hx) := by
  apply Subtype.ext
  show (torY O hx).1 = Spec.map (CommRingCat.ofHom (torChar O hx).toRingHom)
  rw [torChar_toRingHom, CommRingCat.ofHom_hom, Spec.map_preimage]

noncomputable def torT (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (χ : torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A) :
    SchemeHomOver (𝟙 _) (RelativeGroupLaw.baseChangeStr (resPt A ≫ Λ.σA) O.g) :=
  NeronModelInfra.schemeHomOverComp (torusPt _ _ χ) O.torusFibre

theorem torT_one (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) :
    torT O (1 : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)).ofConv =
      (O.L.baseChange (resPt A ≫ Λ.σA)).one (𝟙 _) := by
  letI := (O.L.baseChange (resPt A ≫ Λ.σA)).pointGroup (𝟙 (Spec (CommRingCat.of (ResidueField ↥A))))
  have h := O.torusFibre_mul 1 1
  rw [mul_one] at h
  have h' : (torT O (1 : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)).ofConv : SchemeHomOver (𝟙 _) (RelativeGroupLaw.baseChangeStr (resPt A ≫ Λ.σA) O.g)) =
      torT O (1 : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)).ofConv * torT O (1 : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)).ofConv := h
  exact mul_left_cancel (h'.symm.trans (mul_one _).symm)

theorem torT_pow (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (F : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)) (n : ℕ) :
    torT O (F ^ n).ofConv = (O.L.baseChange (resPt A ≫ Λ.σA)).nsmul (𝟙 _) n (torT O F.ofConv) := by
  induction n with
  | zero => rw [pow_zero, torT_one]; rfl
  | succ n ih =>
      rw [pow_succ, RelativeGroupLaw.nsmul_succ, ← ih]
      exact O.torusFibre_mul (F ^ n) F

theorem torT_injective (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (χ χ' : torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)
    (h : torT O χ = torT O χ') : χ = χ' := by
  have h1 : (torusPt _ _ χ).1 ≫ O.torusFibre.1 = (torusPt _ _ χ').1 ≫ O.torusFibre.1 := congrArg Subtype.val h
  haveI := O.torusFibre_isClosedImmersion
  have h2 : (torusPt (ResidueField ↥A) O.toricRank χ).1 = (torusPt (ResidueField ↥A) O.toricRank χ').1 :=
    (cancel_mono O.torusFibre.1).mp h1
  have h3 : CommRingCat.ofHom χ.toRingHom = CommRingCat.ofHom χ'.toRingHom := Spec.map_inj.mp h2
  apply AlgHom.coe_ringHom_injective
  exact congrArg CommRingCat.Hom.hom h3

theorem nsmul_toFibrePt_red_sec (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {m : ℕ} {x : JZero (N₀ * p)}
    (hx : x ∈ goodTors O m) :
    (O.L.baseChange (resPt A ≫ Λ.σA)).nsmul (𝟙 _) m
        (toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx.2))) =
      (O.L.baseChange (resPt A ≫ Λ.σA)).one (𝟙 _) := by
  have ht : O.L.nsmul Λ.σA m (sec O hx.2) = O.L.one Λ.σA := isTorsionPoint_sec O hx.2 hx.1
  rw [← toFibrePt_nsmul, ← O.L.nsmul_natural Λ.σA _ (resPt A) rfl, ht, O.L.one_natural, toFibrePt_one]

theorem torT_torChar (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {x : JZero (N₀ * p)} (hx : Good O x) :
    torT O (torChar O hx) = toFibrePt (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl (sec O hx)) := by
  unfold torT
  rw [← torY_eq]
  exact torY_spec O hx

theorem torChar_pow_eq_one (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {m : ℕ} {x : JZero (N₀ * p)}
    (hx : x ∈ goodTors O m) :
    (WithConv.toConv (torChar O hx.2)) ^ m = 1 := by
  have h : torT O ((WithConv.toConv (torChar O hx.2)) ^ m).ofConv = torT O (1 : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A)).ofConv := by
    rw [torT_pow, torT_one]
    show (O.L.baseChange (resPt A ≫ Λ.σA)).nsmul (𝟙 _) m (torT O (torChar O hx.2)) = _
    rw [torT_torChar]
    exact nsmul_toFibrePt_red_sec O hx
  have := torT_injective O _ _ h
  exact WithConv.ofConv_injective this

theorem torChar_apply_pow_eq_one (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) {m : ℕ} {x : JZero (N₀ * p)}
    (hx : x ∈ goodTors O m) (i : Fin O.toricRank) :
    (torChar O hx.2 (AddMonoidAlgebra.single (Pi.single i (1 : ℤ)) 1)) ^ m = 1 := by
  have hF := torChar_pow_eq_one O hx
  have := congrArg (fun F : WithConv (torusCoord (ResidueField ↥A) O.toricRank →ₐ[ResidueField ↥A] ResidueField ↥A) =>
    F (AddMonoidAlgebra.single (Pi.single i (1 : ℤ)) 1)) hF
  beta_reduce at this
  rw [pow_apply_single, AlgHom.convOne_apply, AddMonoidAlgebra.counit_single, CommSemiring.counit_apply,
    map_one] at this
  exact this

theorem natCard_goodTors_le (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m) (hpm : m.Coprime p) :
    Finite (goodTors O m) ∧ Nat.card (goodTors O m) ≤ m ^ O.toricRank := by
  classical
  let Φ : goodTors O m → (Fin O.toricRank → ↥(Polynomial.nthRootsFinset m (1 : ResidueField ↥A))) :=
    fun x i => ⟨torChar O x.2.2 (AddMonoidAlgebra.single (Pi.single i (1 : ℤ)) 1),
      (Polynomial.mem_nthRootsFinset hm (1 : ResidueField ↥A)).mpr (torChar_apply_pow_eq_one O x.2 i)⟩
  have hΦ : Function.Injective Φ := by
    intro x x' h
    apply Subtype.ext
    apply eq_of_red_sec_eq O hpm x.2 x'.2
    have hχ : torChar O x.2.2 = torChar O x'.2.2 :=
      Aux.torusChar_ext _ _ fun i => congrArg Subtype.val (congrFun h i)
    have hy : torY O x.2.2 = torY O x'.2.2 := by rw [torY_eq, torY_eq, hχ]
    have h3 := torY_spec O x.2.2
    rw [hy, torY_spec O x'.2.2] at h3
    have h4 := congrArg ofFibrePt h3
    rw [ofFibrePt_toFibrePt, ofFibrePt_toFibrePt] at h4
    exact h4.symm
  exact ⟨Finite.of_injective Φ hΦ,
    (Nat.card_le_card_of_injective Φ hΦ).trans (Aux.natCard_fun_nthRootsFinset_le (ResidueField ↥A) O.toricRank m)⟩

theorem mem_toricPts_of_good (hΛ : Λ.IsJacobian) (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m)
    (hpm : m.Coprime p) (x : JZero (N₀ * p)) (hx : x ∈ jZeroTorsion (N₀ * p) m) (hg : Good O x) :
    x ∈ O.toricPts m := by
  obtain ⟨hfin, hle⟩ := natCard_goodTors_le O m hm hpm
  have hT : Nat.card (O.toricPts m) = m ^ O.toricRank :=
    ModularCurve.JZeroNeronObjectAtP.natCard_toricPts N₀ p hpN₀ A hA Λ hΛ O m hm
  have hsub := toricPts_le_goodTors O m hm

  have heq : O.toricPts m = goodTors O m := by
    haveI := hfin
    apply le_antisymm hsub
    have hcard : Nat.card (goodTors O m) ≤ Nat.card (O.toricPts m) := hT ▸ hle
    exact (AddSubgroup.eq_of_le_of_card_ge hsub hcard).ge
  rw [heq]
  exact ⟨hx, hg⟩

end TORICCHAR

theorem solution
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (m : ℕ) (hm : 0 < m) (hpm : m.Coprime p)
    (x : JZero (N₀ * p)) (hx : x ∈ jZeroTorsion (N₀ * p) m) :
    x ∈ O.toricPts m ↔
      ∃ s : SchemeHomOver Λ.σA O.g, (O.pts x).1 = barPt A ≫ s.1 ∧
        ∀ i : Fin 2, fibreMap (O.abqFibre i) (GoodReductionJacobian.schemeHomOverComp (resPt A) rfl s) =
          Λ.L.one (resPt A ≫ Λ.σA) :=
  ⟨fun h => TORICCHAR.good_of_mem_toricPts O m hm x h,
    fun h => TORICCHAR.mem_toricPts_of_good hΛ O m hm hpm x hx h⟩

end S_ModularCurve_JZeroNeronObjectAtP_mem_toricPts_iff_exists_fibreMap_abqFibre_eq_one
