-- title:
--   Theorem 5.1, p. 238 — a descent method with ‖F(x^{k+1})‖ ≤ ‖F(x^k)‖ and ‖d^k‖ ≤ p‖F(x^k)‖ near x* converges to any BD-regular zero x* among its limit points
-- statement:
--   **Attraction theorem.** Let $F:\mathbb R^n\to\mathbb R^n$ be locally Lipschitz and B-differentiable. Let $\{x^k\}$ be generated by a descent direction method
--   $$x^{k+1}=x^k+\alpha_kd^k,\qquad \alpha_k\ge 0,$$
--   satisfying
--   $$\|F(x^{k+1})\|\le\|F(x^k)\|\quad\text{for all }k. \tag{5.1}$$
--   Let $x^*$ be a limiting (cluster) point of $\{x^k\}$ which is a zero of $F$, and assume $F$ is BD-regular at $x^*$: $F'(x^*;h)\ne0$ for all $h\ne0$. Assume there are scalars $\delta_1>0$, $s>0$, $p>0$ such that for all $k$, if $\|x^k-x^*\|\le\delta_1$ then $\alpha_k\le s$ and
--   $$\|d^k\|\le p\,\|F(x^k)\|. \tag{5.2}$$
--   Then the whole sequence converges: $x^k\to x^*$.
--
--   The theorem needs neither semismoothness nor nonsingularity of generalized Jacobians: a BD-regular zero attracts every descent method whose steps are controlled by the residual near $x^*$. Corollary 5.2 applies it to the damped Newton method, and §5 to the two algorithms of Han, Pang and Rangaraj.
--
--   **Formalization Note** The norm is the 2-norm. "Limiting point" means a cluster point of the sequence (some subsequence converges to $x^*$). The hypothesis $\alpha_k\ge0$ for all $k$ is added: the page's "descent direction method" carries nonnegative step sizes implicitly, and its proof bounds $\alpha_k\|d^k\|$ by $sp\|F(x^k)\|$, which needs $0\le\alpha_k\le s$.
-- source:
--   Qi, Convergence analysis of some algorithms for solving nonsmooth equations, Math. Oper. Res. 18 (1993), p. 238, Theorem 5.1, (5.1)–(5.2)

import Mathlib
import Definitions.Def_NonsmoothNewton_Local_dirDeriv
import Definitions.Def_QiNonsmoothEq_Attraction_Setting
open Filter Topology NonsmoothNewton.Local

namespace QiNonsmoothEq.Attraction

/-- Qi 1993, Theorem 5.1, p. 238 (attraction theorem): for a locally Lipschitz, B-differentiable
`F : ℝⁿ → ℝⁿ` and a descent direction method `x^{k+1} = x^k + α_k d^k` with
`‖F(x^{k+1})‖ ≤ ‖F(x^k)‖` (5.1), if a limiting point `x*` of `{x^k}` is a BD-regular zero of `F`
and, near `x*`, `α_k ≤ s` and `‖d^k‖ ≤ p ‖F(x^k)‖` (5.2), then `x^k → x*`. -/
theorem theorem_5_1 {n : ℕ}
    (F : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n)) (hF : LocallyLipschitz F)
    (hB : ∀ y, QiNonsmoothEq.Local.BDiffAt F y)
    (x d : ℕ → EuclideanSpace ℝ (Fin n)) (α : ℕ → ℝ)
    (hstep : ∀ k, x (k + 1) = x k + α k • d k) (hα : ∀ k, 0 ≤ α k)
    (hdesc : ∀ k, ‖F (x (k + 1))‖ ≤ ‖F (x k)‖)
    (xstar : EuclideanSpace ℝ (Fin n)) (hclu : MapClusterPt xstar atTop x)
    (hzero : F xstar = 0) (hreg : BDRegularAt F xstar)
    (δ₁ s p : ℝ) (hδ₁ : 0 < δ₁) (hs : 0 < s) (hp : 0 < p)
    (hloc : ∀ k, ‖x k - xstar‖ ≤ δ₁ → α k ≤ s ∧ ‖d k‖ ≤ p * ‖F (x k)‖) :
    Tendsto x atTop (𝓝 xstar) := by sorry

end QiNonsmoothEq.Attraction
