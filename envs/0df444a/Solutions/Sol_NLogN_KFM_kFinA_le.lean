namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue RS

theorem gam_le {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : 8 * IntMul.OpenAI.Glue.dP n * αP n ^ 2 ≤ bP n := by
  obtain ⟨-, -, -, -, -, -, -, -, -, -, -, -, -, -, -, -, hγ, -⟩ := params_ok hn
  unfold γP at hγ
  have : ((8 * IntMul.OpenAI.Glue.dP n * αP n ^ 2 : ℕ) : ℝ) ≤ (bP n : ℝ) := by push_cast; linarith
  exact_mod_cast this

end NLogN.KFM

end

