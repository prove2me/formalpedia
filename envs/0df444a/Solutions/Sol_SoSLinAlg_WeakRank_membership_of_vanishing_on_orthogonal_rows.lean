section
open MvPolynomial
namespace SoSLinAlg.WeakRank
theorem chk_membership_of_vanishing_on_orthogonal_rows {n r : ℕ}
    (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) (F : Poly n r)
    (hF : ∀ X Y : Matrix (Fin n) (Fin r) ℝ, (∀ i ∈ I, ∀ j ∈ J, (X * Y.transpose) i j = 0) →
      MvPolynomial.eval (assignment X Y) F = 0) :
    ∃ g : (Fin n × Fin n) → Poly n r, F = ∑ ij ∈ I ×ˢ J, g ij * xy ij.1 ij.2 := by
  classical
  have hm := Dev.Leaf.main I J hIJ F hF
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hm
  refine ⟨fun ij => if h : ij.1 ∈ I ∧ ij.2 ∈ J then c ⟨ij, h⟩ else 0, ?_⟩
  rw [← hc, Finset.sum_subtype (I ×ˢ J) (p := fun ij => ij.1 ∈ I ∧ ij.2 ∈ J)
    (fun _ => Finset.mem_product)]
  refine Finset.sum_congr rfl fun l _ => ?_
  simp only [dif_pos l.2, smul_eq_mul]
  rfl

end SoSLinAlg.WeakRank
end

theorem solution : type_of% @SoSLinAlg.WeakRank.chk_membership_of_vanishing_on_orthogonal_rows := @SoSLinAlg.WeakRank.chk_membership_of_vanishing_on_orthogonal_rows
