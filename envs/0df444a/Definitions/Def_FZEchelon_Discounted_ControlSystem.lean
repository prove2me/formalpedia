-- title:
--   Control systems driven by i.i.d. demands: admissible policies, stationary policies and the expected discounted cost $B^\alpha(s\mid\pi)$
-- statement:
--   This file sets up the general sequential decision framework used for the infinite-horizon problems of Federgruen and Zipkin (1984), following the construction the paper attributes to Veinott (p. 823): a starting state, a policy and a realization of the demand sequence determine the sequences of states and actions.
--
--   1. **Control system.** A control system on a state space $S$ with actions in $A$ consists of a transition map $(s, a, u) \mapsto \mathrm{next}(s, a, u)$, where $u \in \mathbb R$ is the demand of the period, a one-period cost $c(s, a) \in \mathbb R$, and a feasibility relation saying which actions are allowed in state $s$.
--
--   2. **Policies.** A policy $\pi$ prescribes, for each period $k = 0, 1, 2, \dots$ and each demand sequence $\omega = (u_0, u_1, \dots)$, an action $\pi_k(\omega)$. It is *non-anticipative* if $\pi_k(\omega)$ depends only on $u_0, \dots, u_{k-1}$. From an initial state $s_0$ the states are $s_0$ and $s_{k+1} = \mathrm{next}(s_k, \pi_k(\omega), u_k)$. The policy is *admissible* from $s_0$ if every $\pi_k$ is measurable, $\pi$ is non-anticipative, and along every demand sequence every action $\pi_k(\omega)$ is feasible in the state $s_k$.
--
--   3. **Stationary policies.** A stationary policy is a map $\sigma : S \to A$; run from $s_0$, it takes the action $\sigma(s_k)$ in the current state in every period.
--
--   4. **Expected discounted cost.** Let the demands $u_0, u_1, \dots$ be independent with common law $\nu$, and let $c_k(\omega) = c(s_k, \pi_k(\omega))$ be the cost of period $k$, discounted by $\alpha^k$. The expected discounted cost is the extended real number
--   $$
--   B^\alpha(s_0 \mid \pi) \;=\; \mathbb E\Big[\sum_{k\ge 0} (\alpha^k c_k)^+\Big] \;-\; \mathbb E\Big[\sum_{k\ge 0} (\alpha^k c_k)^-\Big] \in [-\infty, +\infty].
--   $$
--   When the second expectation is finite, this equals $\mathbb E\big[\lim_{n\to\infty} \sum_{k<n} \alpha^k c_k\big]$, the paper's $E B^\alpha(\cdot \mid \pi, \tilde u)$.
--
--   These objects define the problems $IH_\alpha$, $IH_\alpha^d$ and $IH_\alpha^r$ of the paper once the state space, the actions, the dynamics and the costs are specified.
--
--   **Formalization Note.** Time runs forward: Lean's period $k$ is the paper's period with $n - k$ periods remaining, and the paper's weight $\alpha^{n-i}$ is $\alpha^k$. The value is split into positive and negative parts rather than written as a limit of partial sums, because the paper's remark that the partial sums are nondecreasing fails for costs that can be negative. Policies are deterministic and history dependent, as in the paper's construction; the initial state is fixed in every statement, so dependence on it is implicit.
-- source:
--   Federgruen and Zipkin, Computational Issues in an Infinite-Horizon, Multiechelon Inventory Model, Oper. Res. 32(4), 1984, pp. 823-824, §1 (construction of Π, B_n, B^α)

import Mathlib

open MeasureTheory

namespace FZEchelon.Discounted

/-- A discrete-time control system driven by real-valued disturbances (demands): from state `s`,
action `a` and disturbance `u` the next state is `next s a u`; the one-period cost is `cost s a`;
`feasible s a` says which actions are allowed in state `s`. -/
structure ControlSystem (S A : Type*) where
  /-- the transition `(s, a, u) ↦ s'` -/
  next : S → A → ℝ → S
  /-- the one-period cost of action `a` in state `s` -/
  cost : S → A → ℝ
  /-- the constraint on the actions available in state `s` -/
  feasible : S → A → Prop

/-- A deterministic history-dependent policy: `π k ω` is the action in period `k = 0, 1, …`
(time runs forward) when the demand sequence is `ω = (u₀, u₁, …)`. Only policies that are
non-anticipative (see `ControlSystem.NonAnticipative`) are admissible. -/
abbrev Policy (A : Type*) := ℕ → (ℕ → ℝ) → A

namespace ControlSystem

variable {S A : Type*} (sys : ControlSystem S A)

/-- The action in period `k` depends only on the demands `u₀, …, u_{k-1}` already observed. -/
def NonAnticipative (π : Policy A) : Prop :=
  ∀ (k : ℕ) (ω ω' : ℕ → ℝ), (∀ j < k, ω j = ω' j) → π k ω = π k ω'

/-- The state sequence generated by policy `π` from the initial state `s₀` along the demand
sequence `ω`: `traj 0 = s₀`, `traj (k+1) = next (traj k) (π k ω) (ω k)`. -/
def traj (π : Policy A) (s₀ : S) (ω : ℕ → ℝ) : ℕ → S
  | 0 => s₀
  | k + 1 => sys.next (traj π s₀ ω k) (π k ω) (ω k)

/-- An admissible policy from `s₀`: every `π k` is measurable (for the product σ-algebra on
demand sequences), `π` is non-anticipative, and along **every** demand sequence every action is
feasible in the state where it is taken. -/
def Admissible [MeasurableSpace A] (π : Policy A) (s₀ : S) : Prop :=
  (∀ k, Measurable (π k)) ∧ NonAnticipative π ∧
    ∀ (ω : ℕ → ℝ) (k : ℕ), sys.feasible (sys.traj π s₀ ω k) (π k ω)

/-- The state sequence of the stationary policy `σ : S → A` started at `s₀`. -/
def statTraj (σ : S → A) (s₀ : S) (ω : ℕ → ℝ) : ℕ → S
  | 0 => s₀
  | k + 1 => sys.next (statTraj σ s₀ ω k) (σ (statTraj σ s₀ ω k)) (ω k)

/-- The stationary policy `σ` (a map from states to actions), run from `s₀`, written as a
history-dependent policy: in period `k` it takes the action `σ` of the current state. -/
def stationary (σ : S → A) (s₀ : S) : Policy A :=
  fun k ω => σ (sys.statTraj σ s₀ ω k)

/-- The expected total discounted cost `B^α(s₀ | π)` of policy `π` from `s₀`, when the demands
`u₀, u₁, …` are independent with common law `ν` (the product law `Measure.infinitePi`). With
`c_k(ω)` the cost of period `k` (weight `α ^ k`), it is the extended real
`E[∑ₖ (αᵏ c_k)⁺] − E[∑ₖ (αᵏ c_k)⁻]`; whenever the second term is finite this is
`E[lim_n ∑_{k<n} αᵏ c_k]`. -/
noncomputable def discCost (α : ℝ) (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (π : Policy A) (s₀ : S) : EReal :=
  ((∫⁻ ω, ∑' k, ENNReal.ofReal (α ^ k * sys.cost (sys.traj π s₀ ω k) (π k ω))
      ∂(Measure.infinitePi fun _ : ℕ => ν) : ENNReal) : EReal) -
  ((∫⁻ ω, ∑' k, ENNReal.ofReal (-(α ^ k * sys.cost (sys.traj π s₀ ω k) (π k ω)))
      ∂(Measure.infinitePi fun _ : ℕ => ν) : ENNReal) : EReal)

end ControlSystem

end FZEchelon.Discounted


