namespace FamilyData

variable {g ginv : ℝ → Metric n} {F : ℝ → TwoForm n} {W : Set (ℝ × Pt n)} {h : Metric n} {f : TwoForm n}

theorem hasDerivAt_pd_field (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {y : Pt n}
    (hy : ((0 : ℝ), y) ∈ W) (k i j : Fin n) :
    HasDerivAt (fun ε => pd k (F ε i j) y) (pd k (f i j) y) 0 :=
  hasDerivAt_pd_param (Φ := fun ε => F ε i j) hfam.isOpen (hfam.smooth_F i j) hy
    (fun z hz => ht.field z hz i j) k

/-- **Bridge for `H`**: `d/dε|₀ H_{abc}(F_ε)(x) = linFaraday f a b c x`. -/
theorem bridge_faraday (hfam : FamilyData g ginv F W) (ht : IsTangent g F W h f) {x : Pt n}
    (hx : ((0 : ℝ), x) ∈ W) (a b c : Fin n) :
    HasDerivAt (fun ε => faradayCyclic (F ε) a b c x) (linFaraday f a b c x) 0 :=
  hasDerivAt_faradayCyclic_of (fun i a b => hfam.hasDerivAt_pd_field ht hx i a b) a b c

end FamilyData

