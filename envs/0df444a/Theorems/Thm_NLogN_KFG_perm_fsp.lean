theorem NLogN.KFG.perm_fsp {W L : ℕ} (σ : Equiv.Perm (Fin W)) (s : IState HS) (l0 : List ℤ) (w Z : ℕ)
    (hZ : zsz ((2 * (W * L) : ℕ) : ℤ) ≤ Z) (e : ℕ → ℕ) (f : Fin HS → List ℤ) (zs : List GI)
    (y : ℕ → ℕ → ℂ) (hx : Enc W L e zs y) (h0 : f 0 = gflat zs ++ l0) (hC : ClP f) (hb : NLogN.KFB.GB w zs) :
    Enc W L (e ∘ pf σ⁻¹) (swapsL L (permSw σ) zs) (fun v => y (pf σ⁻¹ v)) ∧
      NLogN.KFB.GB w (swapsL L (permSw σ) zs) ∧
      FSp (swapsP L (permSw σ)) (encK s f)
        (encK s (Function.update f 0 (gflat (swapsL L (permSw σ) zs) ++ l0)))
        (W * cAtom w 0 L W Z + 1) := by sorry
