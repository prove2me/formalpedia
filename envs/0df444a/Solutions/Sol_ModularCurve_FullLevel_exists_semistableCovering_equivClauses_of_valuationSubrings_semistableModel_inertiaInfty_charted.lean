private theorem _root_.AlgebraicCurve.ComponentChart.discFamily_comap {N : Finset (Place (ResidueField A) Fbar)}
    {disc : Place (ResidueField A) Fbar → Set (Place L F)} {coord : Place (ResidueField A) Fbar → F}
    (h : R.DiscFamily N disc coord) :
    (C.comapRP σ).DiscFamily N (fun Q => RegularProlongation.smulDisc σ⁻¹ (disc Q)) (fun Q => σ.symm (coord Q)) := by
  refine ⟨fun Q hQ => ⟨C.isDiscCoord_comap R hint hres σ (h.1 Q hQ).1, C.pointwiseOn_comap R hint hres σ (h.1 Q hQ).2.1,
    C.degreeOn_comap R hint hres σ (h.1 Q hQ).2.2⟩, fun Q Q' hQ hQ' P hP hP' => ?_⟩
  rw [RegularProlongation.mem_smulDisc_iff] at hP hP'
  exact h.2 Q Q' hQ hQ' _ hP hP'

