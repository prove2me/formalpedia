open Finset

/-! ## I. Behavior Tables and Tropical Kernels -/

/-- The tropical kernel of a behavior table. For each pair `(x, y)`,
    takes the supremum over all contexts of the product of behaviors.
    K(x,y) = sup_c B(c,x) * B(c,y). -/
def tropicalKernel
    {X Ctx : Type*} [Fintype Ctx] [DecidableEq Ctx]
    (B : Ctx → X → ℕ) : X → X → ℕ :=
  fun x y => Finset.sup Finset.univ (fun c => B c x * B c y)


/-! ## II. Factorization and Rank -/

/-- A factorization of a behavior table through an intermediate type of
    size at most `r`. The factorization identity is:
    `B(c,x) = sup_f α(c,f) * β(f,x)` for all `c, x`. -/
structure BehaviorFactorization
    {Ctx X : Type*} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ) (r : ℕ) where
  /-- The intermediate feature type -/
  F : Type
  /-- The feature type is finite -/
  instFintypeF : Fintype F
  /-- The feature type has decidable equality -/
  instDecEqF : DecidableEq F
  /-- The feature type has at most `r` elements -/
  F_card : @Fintype.card F instFintypeF ≤ r
  /-- Left factor: context → feature → value -/
  alpha : Ctx → F → ℕ
  /-- Right factor: feature → input → value -/
  beta : F → X → ℕ
  /-- The factorization identity -/
  factorizes : ∀ c x,
    B c x = @Finset.sup ℕ F _ _ (@Finset.univ F instFintypeF)
      (fun f => alpha c f * beta f x)

/-- Predicate: `B` has factorization rank at most `r`. -/
def HasFactorizationRankAtMost
    {Ctx X : Type*} [Fintype Ctx] [Fintype X]
    (B : Ctx → X → ℕ) (r : ℕ) : Prop :=
  Nonempty (BehaviorFactorization B r)

/-! ## III. Operadic Neural Models -/

/-- An operadic neural model with finite hidden features.
    Behavior is computed as `B(c,x) = sup_f encode(c,f) * decode(f,x)`. -/
structure OperadicNeuralModel
    (Ctx X : Type) [Fintype Ctx] [Fintype X] where
  /-- The hidden feature type -/
  HiddenFeature : Type
  /-- Hidden features are finite -/
  hf_fintype : Fintype HiddenFeature
  /-- Hidden features have decidable equality -/
  hf_deceq : DecidableEq HiddenFeature
  /-- Number of generators -/
  generatorCount : ℕ
  /-- Generator count matches feature cardinality -/
  gen_card : @Fintype.card HiddenFeature hf_fintype = generatorCount
  /-- Context-to-feature map -/
  encode : Ctx → HiddenFeature → ℕ
  /-- Feature-to-output map -/
  decode : HiddenFeature → X → ℕ

/-- The behavior table of a neural model. -/
def OperadicNeuralModel.behaviorTable
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) : Ctx → X → ℕ :=
  fun c x => @Finset.sup ℕ N.HiddenFeature _ _
    (@Finset.univ N.HiddenFeature N.hf_fintype)
    (fun f => N.encode c f * N.decode f x)

/-- Behavioral equivalence of two models. -/
def BehaviorallyEquivalent
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N₁ N₂ : OperadicNeuralModel Ctx X) : Prop :=
  ∀ c x, N₁.behaviorTable c x = N₂.behaviorTable c x

/-- Realizability by at most `r` generators. -/
def RealizableByAtMost
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (r : ℕ) (N : OperadicNeuralModel Ctx X) : Prop :=
  ∃ N' : OperadicNeuralModel Ctx X,
    BehaviorallyEquivalent N N' ∧ N'.generatorCount ≤ r

/-- A model realizes a given behavior table. -/
def RealizesTable
    {Ctx X : Type} [Fintype Ctx] [Fintype X]
    (N : OperadicNeuralModel Ctx X) (B : Ctx → X → ℕ) : Prop :=
  ∀ c x, N.behaviorTable c x = B c x

