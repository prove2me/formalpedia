  have t20 : t2.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ l := by
    simp [ht2, ht1, Ne.symm hX0, h0]
  have hpre : NLogN.KFY.trPre X t2 :=
    ⟨w, IntMul.OpenAI.R129.ℓP n - 1, IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m, zs, l, t.G X, t2X, t20, hh, hbs, hz, hB⟩
  have hF := NLogN.KFY.trF_eq X w (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m) zs l (t.G X) t2 t2X t20 hz hX0
  have hC := IntMul.OpenAI.R129.P.NLogN.KFY.trC_eq X Kc w (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m) (t.G X) t2 t2X
  have hfin : (t2.upd X (t.G X)).upd 0 (NLogN.ints (NLogN.KFB.gflat (IntMul.HvdH.Ref.transposeL
      ((NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).headD 1) (AModel.vol (NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).tail) zs))
        ++ l) = t.upd 0 (NLogN.ints (NLogN.KFB.gflat (IntMul.HvdH.Ref.transposeL
      ((NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).headD 1) (AModel.vol (NLogN.KFM.shPad (IntMul.OpenAI.R129.ℓP n - 1) (IntMul.OpenAI.R129.P.NLogN.KFM.bsN n m)).tail) zs))
