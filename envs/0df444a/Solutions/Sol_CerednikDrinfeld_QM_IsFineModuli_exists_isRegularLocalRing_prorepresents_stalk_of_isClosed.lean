theorem exists_iota
    (Onr : Type) [CommRing Onr] [IsDomain Onr] [IsDiscreteValuationRing Onr] [Algebra ℤ_[q] Onr]
    (hOnr_complete : IsAdicComplete (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}) Onr)
    (hOnr_max : (Ideal.span {algebraMap ℤ_[q] Onr (q : ℤ_[q])}).IsMaximal)
    [IsAlgClosed (ResidueField Onr)] :
    ∃ ι : Zp2 q →+* Onr, IsLocalHom ι := by
  have hq : ((q : ℕ) : Onr) ∈ maximalIdeal Onr := natCast_mem_maximalIdeal_of_frame Onr hOnr_max
  haveI := isAdicComplete_maximalIdeal_of_frame Onr hOnr_complete hOnr_max
  haveI : CharP (ResidueField Onr) q := charP_residueField Onr hq
  letI : Algebra (ZMod q) (ResidueField Onr) := ZMod.algebra _ q
  haveI : Algebra.IsAlgebraic (ZMod q) (GaloisField q 2) := Algebra.IsAlgebraic.of_finite (ZMod q) _
  let f : GaloisField q 2 →+* ResidueField Onr :=
    (IsAlgClosed.lift : GaloisField q 2 →ₐ[ZMod q] ResidueField Onr).toRingHom
  obtain ⟨g, hg, -⟩ :=
    WittVector.exists_ringHom_isLocalHom_and_residue_comp_eq_comp_constantCoeff q (GaloisField q 2) Onr hq f
  exact ⟨g, hg⟩

