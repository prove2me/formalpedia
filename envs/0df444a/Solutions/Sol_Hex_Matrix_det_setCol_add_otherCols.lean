/-- Replacing a column by itself leaves the matrix unchanged. -/
@[simp] theorem setCol_self (M : Matrix R n m) (dst : Fin m) :
    setCol M dst (fun r => M[r][dst]) = M := by
  apply ext_getElem
  intro r c
  rw [getElem_setCol]
  by_cases hc' : c = dst
  · rw [ite_eq_left hc']
    exact congrArg (fun c' : Fin m => M[r][c']) hc'.symm
  · rw [ite_eq_right hc']

end Matrix
