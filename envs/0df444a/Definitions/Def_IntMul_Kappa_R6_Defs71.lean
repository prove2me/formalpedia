-- Source module: Solutions.J6SegILPreJK7
/-!
# B5 `J` side, part K7: `ap` / `am` lists as `Rn` steps

`stA_spX`: `stA_sp` (J6SegILPre9) with the final registers given explicitly (`stAV`), so the
block-table loops `apP`, `amP` become `Rn` steps (`Rn.apP`, `Rn.amP`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The registers after a block-table loop. -/
def stAV (v : Fin HS → ℤ) (P sN tN aN : ℕ) (jv : ℕ → ℕ) (nN : ℕ) : Fin HS → ℤ :=
  aS (Function.update (Function.update v 4 ((2 : ℤ) ^ P)) 3 1)
    (fun k => expNeg P sN (2 * aN ^ 2 * tN * (k + 1)))
    (fun (k : ℕ) => (-1) ^ k * J6Seg.fmul P (expNeg P sN (jv k)) (giI P sN tN aN k))
    (gamI P sN tN aN) (fun (k : ℕ) => (-1) ^ k) nN

end J6Seg.PreT

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK8
/-!
# B5 `J` side, part K8: the `M⁻¹` row loop, the column loop, clearing a stack

* `PJ.clrK X C r`: pop `X` `r` times (`Rn.clrK`);
* `PJ.miL = forL 50 2 3 (8 := 0; PJ.tsL; PJ.miT)`: pushes `miV a u` for `u < n` on `SMI` (`Rn.miL`);
* `PJ.colL = forL 53 28 3 PJ.colB`: for each column `k < m`, `b = L[k]`, pushes
  `[a = b] 2^Q + Σ_y [gC y = b] gV y` on `SMAT = 43` (`Rn.colL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

abbrev SMAT : Fin HS := 43

/-- The reversed first `k` values of `f`. -/
abbrev rvL (f : ℕ → ℤ) (k : ℕ) : List ℤ := ((List.range k).map f).reverse

/-! ## Clearing -/

def clrK (X C r : Fin HS) : RS := .rep C (.reg r) (.pop X)

def cClr (W n : ℕ) : ℕ := 2 * 2000 * (W + 1 + 2) + n * ((2 * W + 2) + 8000 * (W + 1 + 2) + 30) + 32

/-! ## The `M⁻¹` row loop -/

def miB : RS := .seq (progL [.a 8 (.k 0)]) (.seq tsL (progL miT))
def miL : RS := forL 50 2 3 miB

def cMiB (W N n : ℕ) : ℕ := costL W N [.a 8 (.k 0)] + (cFor W n (costL W N tsB) + costL W N miT)

/-! ## The column loop -/

def colA : List Ins := [.rd 30 (.r 3) 4, .a 5 (.mul (eqE (.r 7) (.r 4)) (.r 9))]
def colB : RS := .seq (progL colA) (.seq cwL (progL [.pu SMAT (.r 5)]))
def colL : RS := forL 53 28 3 colB

def cColB (W N NN : ℕ) : ℕ :=
  costL W N PJ.colA + (cFor W NN (costL W N PJ.cwB) + costL W N [.pu SMAT (.r 5)])

/-- The capacitance-row entry of column `b`. -/
def cEnt (Q a : ℕ) (gv gc : ℕ → ℤ) (NN b : ℕ) : ℤ :=
  (if a = b then 2 ^ Q else 0) + ∑ y ∈ range NN, cTm gv gc b y

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK9
/-!
# B5 `J` side, part K9: one row of the capacitance matrix

`PJ.rowB` (row `i` on `6`): `a = L[i]` (`30`), `c = st a` (`32`), `n = len a` (`33`); the block
lists `ap`, `am` (`SAP`, `SAM`); the `M⁻¹` row (`PJ.miL`); the slots (`PJ.vlL`); the columns
(`PJ.colL`, pushing `capI a L[k]` on `SMAT`); clearing `SAP, SAM, SMI, SV, SC` (`Rn.rowB`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

def rowA : List Ins := [.rd 30 (.r 6) 7, .rd 32 (.r 7) 1, .rd 33 (.r 7) 2]
def nnA : List Ins := [.a 11 (.mul (.r 2) dWE)]

def clrs : RS := .seq (clrK SAP 50 2) (.seq (clrK SAM 50 2) (.seq (clrK SMI 50 2)
  (.seq (PJ.clrK SV 50 11) (PJ.clrK SC 50 11))))

def rowB : RS := .seq (progL rowA) (.seq (PreT.apP SAP) (.seq (PreT.amP SAM) (.seq miL
  (.seq (progL PJ.nnA) (.seq PJ.vlL (.seq PJ.colL PJ.clrs))))))

/-- A uniform bound on the cost of a row (`n ≤ λ`, `n (2w+1) ≤ NM`). -/
def cRowB (W N lam NM m : ℕ) : ℕ :=
  costL W N PJ.rowA + (PreT.cStA W lam PreT.jPE + (PreT.cStA W lam PreT.jME +
    (cFor W lam (cMiB W N lam) + (costL W N PJ.nnA + (cFor W NM (costL W N PJ.vlB) +
    (cFor W m (cColB W N NM) + (cClr (W + 1) lam + (cClr (W + 1) lam + (cClr (W + 1) lam +
    (cClr (W + 1) NM + cClr (W + 1) NM))))))))))

/-- The numeric side conditions of row `a` (block `c = st a`, `n = len a`). -/
structure RowBnd (Q R W s t α lam : ℕ) (B : Blocks) (a : ℕ) : Prop where
  ap : ∀ k < B.len a, |(mkTables Q R s t α).ap (B.st a) k| ≤ 2 ^ W
  am : ∀ k < B.len a, |(mkTables Q R s t α).am (B.st a) k| ≤ 2 ^ W
  apX : ∀ k < B.len a,
    |HvdH.expNeg Q s (α ^ 2 * ((t : ℤ) + 2 * HvdH.bOf s t (B.st a)).toNat * k)| ≤ 2 ^ W
  amX : ∀ k < B.len a,
    |HvdH.expNeg Q s (α ^ 2 * ((t : ℤ) - 2 * HvdH.bOf s t (B.st a)).toNat * k)| ≤ 2 ^ W
  tsS : ∀ uu < B.len a, ∀ K ≤ B.len a, |∑ k ∈ range K, tsT Q (mkTables Q R s t α) (B.st a)
    (tU B.w (B.len a) (a - B.st a) uu) (tV B.w (B.len a) (a - B.st a) uu) k| ≤ 2 ^ W
  tsY : ∀ uu < B.len a, |fmul Q (fmul Q ((mkTables Q R s t α).gi (tU B.w (B.len a) (a - B.st a) uu))
    ((mkTables Q R s t α).gi (tV B.w (B.len a) (a - B.st a) uu)))
    (fmul Q (∑ k ∈ range (B.len a), tsT Q (mkTables Q R s t α) (B.st a)
      (tU B.w (B.len a) (a - B.st a) uu) (tV B.w (B.len a) (a - B.st a) uu) k) 1)| ≤ 2 ^ W
  mi : ∀ uu < B.len a, |miV Q (mkTables Q R s t α) B a uu| ≤ 2 ^ W
  X : ∀ u < B.len a, ∀ j < 2 * B.w + 1, α ^ 2 * (HvdH.eKz s t ((B.st a + u : ℕ) : ℤ)
    ((j : ℤ) - B.w)).toNat ≤ 2 ^ W
  C : ∀ u < B.len a, ∀ j < 2 * B.w + 1,
    |(mkTables Q R s t α).cpl (B.st a + u) ((j : ℤ) - B.w)| ≤ 2 ^ W
  V : ∀ y < B.len a * (2 * B.w + 1), |gV Q (mkTables Q R s t α) B a y| ≤ 2 ^ W
  colS : ∀ b : ℕ, ∀ K ≤ B.len a * (2 * B.w + 1), |(if a = b then (2 : ℤ) ^ Q else 0) +
    ∑ y ∈ range K, cTm (gV Q (mkTables Q R s t α) B a) (gC B (B.st a)) b y| ≤ 2 ^ W

/-- The numeric side conditions shared by all rows. -/
structure GlobBnd (Q W s t α lam : ℕ) : Prop where
  q : ∀ k < lam, |HvdH.expNeg Q s (2 * α ^ 2 * t * (k + 1))| ≤ 2 ^ W
  G : ∀ k ≤ lam, |gamI Q s t α k| ≤ 2 ^ W

/-- The table stacks. -/
structure TabSt (Q R W s t α lam : ℕ) (D : Cs) : Prop where
  gm : D SGM = ((List.range lam).map (mkTables Q R s t α).gam).reverse
  gi : D SGI = ((List.range lam).map (mkTables Q R s t α).gi).reverse
  dd : D SDD = ((List.range lam).map (mkTables Q R s t α).dd).reverse
  di : D SDI = ((List.range lam).map (mkTables Q R s t α).di).reverse
  bgm : ∀ i < lam, |(mkTables Q R s t α).gam i| ≤ 2 ^ W
  bgi : ∀ i < lam, |(mkTables Q R s t α).gi i| ≤ 2 ^ W
  bdd : ∀ i < lam, |(mkTables Q R s t α).dd i| ≤ 2 ^ W
  bdi : ∀ i < lam, |(mkTables Q R s t α).di i| ≤ 2 ^ W

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK10
/-!
# B5 `J` side, part K10: one row of the capacitance matrix (`Rn.rowB`)
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

/-- The big frame of a row. -/
abbrev BIG : List (Fin HS) := [1, 2, 3, 4, 5, 7, 8, 11, 12, 29]

def cRowX (W N lam n NN m : ℕ) : ℕ :=
  costL W N rowA + (PreT.cStA W lam PreT.jPE + (PreT.cStA W lam PreT.jME +
    (cFor W n (cMiB W N n) + (costL W N nnA + (cFor W NN (costL W N vlB) +
    (cFor W m (cColB W N NN) + (cClr (W + 1) n + (cClr (W + 1) n + (cClr (W + 1) n +
    (cClr (W + 1) NN + cClr (W + 1) NN))))))))))

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJD1
/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D1: the pattern elimination stage (data part)

* `matL f m`: an `m × m` matrix, row-major, entry `(0,0)` first (`matL_length`, `matL_getD`,
  `matL_get2`);
* `bSE` (indicator of `bandS mw cB`, `mw` on `11`, `cB` on `12`), `flE` (the `stepI` condition at
  `(x / m, x % m)` for pivot `q` on `1`, `x` on `2`, `m` on `28`);
* `elB`: the straight-line body that pushes `Mseq (q + 1)` at position `x` onto stack `16`
  (`elB_run`, `elB_ok`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

/-! ## Row-major matrices -/

/-- An `m × m` matrix, row-major, `(0,0)` first. -/
def matL (f : ℕ → ℕ → ℤ) (m : ℕ) : List ℤ := (List.range (m * m)).map (fun x => f (x / m) (x % m))

@[simp] theorem matL_length (f : ℕ → ℕ → ℤ) (m : ℕ) : (matL f m).length = m * m := by
  simp [matL]

/-! ## Expressions -/

/-- `i = x / m`. -/
def iE : E := .dv (.r 2) (.r 28)
/-- `k = x % m`. -/
def kE : E := .md (.r 2) (.r 28)
/-- Indicator of `bandS mw cB a b` (`mw` on `11`, `cB` on `12`). -/
def bSE (a b : E) : E :=
  .sub (.k 1) (.mul (.mul (.sub (.k 1) (.mul (.sub (.k 1) (ltE (.add b (.r 11)) a))
    (.sub (.k 1) (ltE (.add a (.r 11)) b)))) (ltE a (.r 12))) (ltE b (.r 12)))
/-- The `stepI` condition: `q` on `1`, `Lg i` on `5`, `Lg q` on `6`, `Lg k` on `7`. -/
def flE : E := .mul (.mul (ltE (.r 1) iE) (ltE (.r 1) kE)) (.mul (bSE (.r 5) (.r 6)) (bSE (.r 6) (.r 7)))
/-- The new entry: flag on `5`, `M i k` on `4`, `M i q` on `6`, `M q q` on `7`, `M q k` on `8`. -/
def nwE : E := .sel (.sub (.r 5) (.k 1)) (.r 4) (.sub (.r 4) (fmE (fdE (.r 6) (.r 7)) (.r 8)))

/-- **The elimination body** at position `x` (on `2`) for pivot `q` (on `1`). -/
def elB : List Ins :=
  [.rd 14 (.r 2) 4, .rd 30 iE 5, .rd 30 (.r 1) 6, .rd 30 kE 7, .a 5 flE,
   .rd 14 (.add (.mul iE (.r 28)) (.r 1)) 6, .rd 14 (.add (.mul (.r 1) (.r 28)) (.r 1)) 7,
   .rd 14 (.add (.mul (.r 1) (.r 28)) kE) 8, .pu 16 nwE]

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK11
/-!
# B5 `J` side, part K11: the capacitance matrix

`capP = forL 48 28 6 rowB; 11 := m·m; mvK SMAT 14`: the matrix
`matL (fun i k => capI (L[i]) (L[k])) m` on `14` (`Rn.capP`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 100000

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function Finset

/-- The rows pushed so far (last row first, each reversed). -/
def accR (g : ℕ → List ℤ) : ℕ → List ℤ
  | 0 => []
  | k + 1 => g k ++ accR g k

def capP : RS := .seq (forL 48 28 6 rowB) (.seq (progL [.a 11 (.mul (.r 28) (.r 28))])
  (mvK SMAT 14 50 (.reg 11)))

def cCapP (W N lam NM m : ℕ) : ℕ :=
  cFor W m (cRowB W N lam NM m) + (costL W N [.a 11 (.mul (.r 28) (.r 28))] +
    (2 * 2000 * (W + 1 + 2) + m * m * (14000 * (W + 1 + 2)) + 32))

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK12
/-!
# B5 `J` side, part K12: the line tables as `Rn` steps

`stG_spX`: `stG_sp` (J6SegILPre8) with the final registers explicit (`stGV`); the table stage
`tabP = stDI SDI; stDD SDD; stGam SGM; stGi SGI` (`Rn.tabP`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-- The registers after a `Γ` loop. -/
def stGV (v : Fin HS → ℤ) (P sN tN aN : ℕ) (F : ℕ → ℤ) (lam : ℕ) : Fin HS → ℤ :=
  gS (Function.update v 4 ((2 : ℤ) ^ P)) (fun k => expNeg P sN (2 * aN ^ 2 * tN * (k + 1))) F
    (gamI P sN tN aN) lam

end J6Seg.PreT

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

def tabP : RS := .seq (PreT.stDI SDI) (.seq (PreT.stDD SDD) (.seq (PreT.stGam SGM) (PreT.stGi SGI)))

def cTabP (W Q R lam : ℕ) : ℕ :=
  PreT.cSt W lam (PreT.cCall (.reg 20) (.reg 22) PreT.jDE (.lit 0) (PreT.BW W)
    (expNegCost Q (PreT.BW W) (PreT.BW W))) +
  (PreT.cSt W lam (PreT.cCall (.add (.reg 20) (.reg 21)) (.reg 22) PreT.jDE (.reg 21) (PreT.BW W)
    (expPosCost (Q + R) (PreT.BW W) (PreT.BW W) R)) +
  (PreT.cStG W lam (.reg 4) + PreT.cStG W lam PreT.giE))

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK13
/-!
# B5 `J` side, part K13: the coupling-window entry, innermost loop

For a row position `l` (on `7`, block `c = st l` on `1`, `n = len l` on `2`), a target column
`b` (on `4`) and a slot `j` (on `5`), `ccT l b j = [hcT ∧ col = b] cpl l (j - w)`; the body `jB`
adds it to `8` with one `expNeg` call (`Rn.jB`); `jL = forL 54 11 5 jB` sums it over
`j < 2w + 1` (count on `11`), which is `ccOf` (`Rn.jL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

/-- One slot of a coupling-window entry. -/
def ccT (T : Tables) (B : Blocks) (l b j : ℕ) : ℤ :=
  if hcT B l j ∧ col B.s l ((j : ℤ) - B.w) = b then T.cpl l ((j : ℤ) - B.w) else 0

namespace E
def hE2 : E := .sub (.r 5) (.r 26)
def kzE2 : E := .sub (.mul (.add (.mul (.r 23) hE2) (bOfE (.r 7))) (.add (.mul (.r 23) hE2) (bOfE (.r 7))))
  (.mul (bOfE (.add (.r 7) hE2)) (bOfE (.add (.r 7) hE2)))
def xE2 : E := .mul (.mul (.r 25) (.r 25)) (mx0E kzE2)
def c1E2 : E := .sub (.k 1) (eqE (.r 5) (.r 26))
def pE2 : E := .sub (.add (.r 7) hE2) (.r 1)
def c2E2 : E := .mul (ltE (.k (-1)) pE2) (ltE pE2 (.r 2))
def colE2 : E := .md (.add (.r 7) hE2) (.r 22)
def cdE2 : E := .mul (.mul c1E2 (.sub (.k 1) c2E2)) (eqE colE2 (.r 4))
end E

def jB : List Ins :=
  [.a 29 (.mul (.r 22) (.r 22)), .a 12 xE2, .en 12 20 29 12, .a 8 (.add (.r 8) (.mul cdE2 (.r 12)))]

def jL : RS := forL 54 11 5 (progL PJ.jB)

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK14
/-!
# B5 `J` side, part K14: one coupling window

For row `r` (on `6`, `l = L[r]` on `7`) and window slot `i` (on `3`): read `b = L[qOf r i]`,
sum `ccT` (`jL`), push `ccOf r i` on `SCC = 46` (`Rn.iB`); `iL = forL 53 11 3 iB` pushes the
whole window (`Rn.iL`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

abbrev SCC : Fin HS := 46

namespace E
/-- `qOf L K r i = (r + i + m - K) % m` (`r` on `6`, `i` on `3`, `m` on `28`, `K` on `26`). -/
def qE : E := .md (mx0E (.sub (.add (.add (.r 6) (.r 3)) (.r 28)) (.r 26))) (.r 28)
end E

def iA : List Ins := [.rd 30 E.qE 4, .a 8 (.k 0)]
def iB : RS := .seq (progL iA) (.seq PJ.jL (progL [.pu SCC (.r 8)]))

def cIB (W N w : ℕ) : ℕ :=
  costL W N iA + (cFor W (2 * w + 1) (costL W N PJ.jB) + costL W N [.pu SCC (.r 8)])

/-- Side conditions of the windows of row position `l`. -/
structure CcBnd (W s t α : ℕ) (T : Tables) (B : Blocks) (l : ℕ) : Prop where
  X : ∀ j < 2 * B.w + 1, α ^ 2 * (HvdH.eKz s t (l : ℤ) ((j : ℤ) - B.w)).toNat ≤ 2 ^ W
  C : ∀ j < 2 * B.w + 1, |T.cpl l ((j : ℤ) - B.w)| ≤ 2 ^ W
  S : ∀ b : ℕ, ∀ J ≤ 2 * B.w + 1, |∑ j ∈ range J, ccT T B l b j| ≤ 2 ^ W

def iL : RS := forL 53 11 3 PJ.iB

end J6Seg.PJ

end

section
-- Source module: Solutions.J6SegILPreJK15
/-!
# B5 `J` side, part K15: all coupling windows onto `41`

`ccP = 11 := 2w+1; forL 50 28 6 (rows reads; push 2w+1 on SCC; iL); 11 := m(2w+2); mvK SCC 41`
puts `JK.flatT (rows of ccOf)` in front of stack `41` (`Rn.ccP`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E Finset

def rA : List Ins := [.rd 30 (.r 6) 7, .rd 32 (.r 7) 1, .rd 33 (.r 7) 2, .pu SCC (.r 11)]
def rB : RS := .seq (progL rA) PJ.iL

def cRB (W N w : ℕ) : ℕ := costL W N rA + cFor W (2 * w + 1) (cIB W N w)

/-- The rows of coupling windows. -/
def ccRows (T : Tables) (B : Blocks) (L : List ℕ) (m : ℕ) : List (List ℤ) :=
  (List.range m).map (fun r => (List.range (2 * B.w + 1)).map (ccOf T B L B.w r))

abbrev FR : List (Fin HS) := [1, 2, 3, 4, 5, 7, 8, 12, 29]

def ccLp : RS := forL 50 28 6 PJ.rB

def ccP : RS := .seq (progL [.a 11 (.add (.mul (.k 2) (.r 26)) (.k 1))])
  (.seq ccLp (.seq (progL [.a 11 (.mul (.r 28) (.add (.r 11) (.k 1)))]) (mvK SCC 41 50 (.reg 11))))

def cCcP (W N w m : ℕ) : ℕ :=
  costL W N [.a 11 (.add (.mul (.k 2) (.r 26)) (.k 1))] + (cFor W m (cRB W N w) +
    (costL W N [.a 11 (.mul (.r 28) (.add (.r 11) (.k 1)))] +
    (2 * 2000 * (W + 1 + 2) + m * (2 * w + 2) * (14000 * (W + 1 + 2)) + 32)))

end J6Seg.PJ

end

