section s236
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitializeHeader
open Structured
lemma nat_frame (k : ℕ) (hk : k < 562 ∨ 654 < k) : NatFrame code k := by
  simp [code,CoreTape.code,CoreTape.atoms,CoreEdgeAddress.code,CorePending.prefixCode,CorePending.prefixAtoms,
    CoreGeometry.addressCode,CoreGeometry.addressAtoms,flagCode,flagAtoms,CoreInitialDifference.code,
    CoreInitialDifference.ordinary,CoreInitialDifference.sourceTail,Structured.sequence,NatFrame,writesNat,add,sub]
  omega
lemma real_frame (k : ℕ) (hk : k < 602 ∨ 606 < k) : RealFrame code k := by
  simp [code,CoreTape.code,CoreTape.atoms,CoreEdgeAddress.code,CorePending.prefixCode,CorePending.prefixAtoms,
    CoreGeometry.addressCode,CoreGeometry.addressAtoms,flagCode,flagAtoms,CoreInitialDifference.code,
    CoreInitialDifference.ordinary,CoreInitialDifference.sourceTail,Structured.sequence,RealFrame,writesReal,add,sub]
  omega
lemma no_memory : NoMemory code := ⟨CoreTape.no_memory,CoreEdgeAddress.no_memory,
  by simp [flagCode,flagAtoms,Structured.sequence,NoMemory,NoStore],CoreInitialDifference.no_memory⟩
lemma captured (b : Core) {s t : Data} {cost : ℕ} (h : InputCapture.Captured b.input s) (he : Eval code s cost t) :
    InputCapture.Captured b.input t :=
  h.named_frame b.input (fun k hk => he.nat_frame (nat_frame k (by simp at hk;omega)))
    (fun k hk => he.real_frame (real_frame k (by simp at hk;omega)))
lemma parameters (b : Core) (K : ℝ) {s t : Data} {cost : ℕ} (h : CoreParameters.Values b K s) (he : Eval code s cost t) :
    CoreParameters.Values b K t :=
  h.frame b K (fun k hk => he.nat_frame (nat_frame k (by simp at hk;omega)))
    (fun k hk => he.real_frame (real_frame k (by simp at hk;omega)))
end DecrAlmostLinearSSSP.Decremental.CoreInitializeHeader
end s236
section s237
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
open Structured
lemma field_eval (s : Data) : Eval fieldCode s 4 (fieldResult s) := eval_sequence_atoms fieldAtoms s
lemma field_values (s : Data) (hzN : s.natReg 56 = 0) (hzR : s.realReg 56 = 0) :
    (fieldResult s).natReg 628 = s.natReg 72 ∧ (fieldResult s).natReg 648 = 1 ∧
    (fieldResult s).realReg 604 = 0 ∧ (fieldResult s).realReg 606 = s.realReg 514 := by
  simp [fieldResult,fieldAtoms,Atom.effect,instructionEffect,data,Data.machine,hzN,hzR]
lemma field_nat_frame (k : ℕ) (h628 : k ≠ 628) (h648 : k ≠ 648) : NatFrame fieldCode k := by
  simp [fieldCode,fieldAtoms,Structured.sequence,NatFrame,writesNat,Ne.symm h628,Ne.symm h648]
lemma field_real_frame (k : ℕ) (h604 : k ≠ 604) (h606 : k ≠ 606) : RealFrame fieldCode k := by
  simp [fieldCode,fieldAtoms,Structured.sequence,RealFrame,writesReal,Ne.symm h604,Ne.symm h606]
lemma field_no_memory : NoMemory fieldCode := by simp [fieldCode,fieldAtoms,Structured.sequence,NoMemory,NoStore]
lemma header_nat_frame (k : ℕ) (hk : k < 562 ∨ 662 < k) (h626 : k ≠ 626) : NatFrame headerCode k := by
  exact ⟨CoreEdgeAddress.nat_frame k (by omega),CoreReturnCoefficient.nat_frame k (by omega) (by omega),field_nat_frame k (by omega) (by omega)⟩
lemma header_real_frame (k : ℕ) (h602 : k ≠ 602) (h604 : k ≠ 604) (h606 : k ≠ 606) : RealFrame headerCode k :=
  ⟨CoreEdgeAddress.real_frame k,CoreReturnCoefficient.real_frame k h602,field_real_frame k h604 h606⟩
lemma header_no_memory : NoMemory headerCode := ⟨CoreEdgeAddress.no_memory,CoreReturnCoefficient.no_memory,field_no_memory⟩
end DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
end s237
section s238
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreRefresh
open Structured
lemma label_eval (s : Data) : Eval labelCode s 3 (labelled s) := eval_sequence_atoms labelAtoms s
lemma label_values (s : Data) :
    (labelled s).realReg 616 = s.realReg 606+s.realReg 608-s.realReg 610 ∧
    (labelled s).realReg 618 = s.realReg 604+(s.realReg 606+s.realReg 608-s.realReg 610) := by
  simp only [labelled,labelAtoms,List.foldl_cons,List.foldl_nil]
  simp (disch := decide) [Atom.real_read,primitiveRealRead]
  ring
lemma label_frame (k : ℕ) (hk : k ≠ 616) (hj : k ≠ 618) : RealFrame labelCode k := by
  simp [labelCode,labelAtoms,Structured.sequence,RealFrame,writesReal,Ne.symm hk,Ne.symm hj]
lemma clip_eval (s : Data) (hz : s.realReg 56 = 0) : Eval clipCode s 2 (clipped s) := by
  by_cases hh : s.realReg 618 < s.realReg 506
  · have he := Eval.branchYes (no := Cmd.skip) (show (Test.realLess 618 506).holds s from hh) (eval_add s 618 506 56)
    simpa only [clipCode,clipped,hz,add_zero,max_eq_right (le_of_lt hh)] using he
  · have he := Eval.branchNo (yes := add 618 506 56) (show ¬ (Test.realLess 618 506).holds s from hh) (Eval.skip s)
    have ht : clipped s = s := by
      simp only [clipped,max_eq_left (le_of_not_gt hh),Function.update_eq_self]
    simpa only [clipCode,ht] using he
lemma finish_eval (s : Data) : Eval finishCode s 2 (finished s) := eval_sequence_atoms finishAtoms s
lemma eval_code (s : Data) (hz : s.realReg 56 = 0) : Eval code s 7 (result s) := by
  have hzero : (labelled s).realReg 56 = 0 := ((label_eval s).real_frame (label_frame 56 (by omega) (by omega))).trans hz
  exact Eval.seq (label_eval s) (Eval.seq (clip_eval _ hzero) (finish_eval _))
lemma result_values (s : Data) :
    (result s).realReg 616 = s.realReg 606+s.realReg 608-s.realReg 610 ∧
    (result s).realReg 612 = s.realReg 602 / max (s.realReg 604+(s.realReg 606+s.realReg 608-s.realReg 610)) (s.realReg 506) ∧
    (result s).realReg 614 = (result s).realReg 612-s.realReg 600 := by
  have hv := label_values s
  have hf (k : ℕ) (hk : k ≠ 616) (hj : k ≠ 618) : (labelled s).realReg k = s.realReg k :=
    (label_eval s).real_frame (label_frame k hk hj)
  simp only [result,finished,finishAtoms,List.foldl_cons,List.foldl_nil]
  simp (disch := decide) [Atom.real_read,primitiveRealRead,clipped,Function.update_apply,hv,hf]
lemma no_memory : NoMemory code := by
  simp [code,labelCode,labelAtoms,finishCode,finishAtoms,clipCode,Structured.sequence,NoMemory,NoStore,add]
lemma nat_frame (k : ℕ) : NatFrame code k := by
  simp [code,labelCode,labelAtoms,finishCode,finishAtoms,clipCode,Structured.sequence,NatFrame,writesNat,add]
lemma real_frame (k : ℕ) (h612 : k ≠ 612) (h614 : k ≠ 614) (h616 : k ≠ 616) (h618 : k ≠ 618) : RealFrame code k := by
  simp [code,labelCode,labelAtoms,finishCode,finishAtoms,clipCode,Structured.sequence,RealFrame,writesReal,add,
    Ne.symm h612,Ne.symm h614,Ne.symm h616,Ne.symm h618]
lemma result_capacity (b : Core) (state : State b) (e : Edge b) (s : Data)
    (hmu : s.realReg 602 = coefficient b e) (hc : s.realReg 604 = cost b state.active e)
    (hinit : s.realReg 606 = initialLabel b (tail b e)-initialLabel b (head b e))
    (htail : s.realReg 608 = state.y (tail b e)) (hhead : s.realReg 610 = state.y (head b e))
    (hk : s.realReg 506 = kappa b) :
    (result s).realReg 612 = capacity b state.active (labels b state) e := by
  rw [(result_values s).2.1,hmu,hc,hinit,htail,hhead,hk]
  unfold capacity slack incidence labels
  congr 2
  ring
end DecrAlmostLinearSSSP.Decremental.CoreRefresh
end s238
section s239
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
open Structured
lemma header_eval (b : Core) (B : ℕ) (K : ℝ) (v : ReturnVertex b) (s : Data)
    (hc : InputCapture.Captured b.input s) (hp : CoreParameters.Values b K s)
    (hbase : s.natReg 552 = B+1) (hG : s.natReg 554 = CoreMemory.gradientBase b B)
    (he : s.natReg 560 = 2*(logicalIndexEquiv b (.inr v)).val) (hv : s.natReg 626 = v.val.val)
    (hd : ∀ u, s.natMem (CoreMemory.gradientCell b B u) = indegree b u) :
    ∃ t, Eval headerCode s 19 t ∧ Loaded b B v t ∧ t.natMem = s.natMem ∧ t.realMem = s.realMem := by
  let a := CoreEdgeAddress.result s
  have ha := CoreEdgeAddress.eval_code s
  have haa : CoreRecord.Addresses (CoreMemory.field b B (.inr v) 0) a := by
    simpa only [CoreMemory.field,Nat.mul_zero,Nat.add_zero] using CoreEdgeAddress.values B _ s hbase he hc.two
  have han (k : ℕ) (hk : k < 562 ∨ 580 < k) : a.natReg k = s.natReg k := ha.nat_frame (CoreEdgeAddress.nat_frame k hk)
  have har (k : ℕ) : a.realReg k = s.realReg k := ha.real_frame (CoreEdgeAddress.real_frame k)
  have ham := ha.no_memory CoreEdgeAddress.no_memory
  let u := CoreReturnCoefficient.result a
  have hu := CoreReturnCoefficient.eval_code a
  have hq : a.natMem (CoreMemory.gradientBase b B+2*v.val.val) = indegree b v.val := by
    rw [ham.2]
    exact hd v.val
  have hcoef := CoreReturnCoefficient.value _ _ _ (A b) a ((han 554 (by omega)).trans hG)
    ((han 626 (by omega)).trans hv) hq ((har 504).trans hp.Avalue)
  have hun (k : ℕ) (hk : k ≠ 620 ∧ k ≠ 662) : u.natReg k = a.natReg k := hu.nat_frame (CoreReturnCoefficient.nat_frame k hk.1 hk.2)
  have hur (k : ℕ) (hk : k ≠ 602) : u.realReg k = a.realReg k := hu.real_frame (CoreReturnCoefficient.real_frame k hk)
  have huzN : u.natReg 56 = 0 := (hun 56 (by omega)).trans ((han 56 (by omega)).trans hc.zeroN)
  have huzR : u.realReg 56 = 0 := (hur 56 (by omega)).trans ((har 56).trans hc.zeroR)
  let t := fieldResult u
  have ht := field_eval u
  obtain ⟨hth,htflag,htcost,htinitial⟩ := field_values u huzN huzR
  have htn (k : ℕ) (hk : k ≠ 628 ∧ k ≠ 648) := ht.nat_frame (field_nat_frame k hk.1 hk.2)
  have htr (k : ℕ) (hk : k ≠ 604 ∧ k ≠ 606) := ht.real_frame (field_real_frame k hk.1 hk.2)
  have hall : Eval headerCode s 19 t := Eval.seq ha (Eval.seq hu ht)
  have hloaded : Loaded b B v t := by
    refine ⟨haa.frame _ (fun k hk => (htn k (by simp at hk;omega)).trans (hun k (by simp at hk;omega))),
      ?_,htcost,?_,?_,?_,htflag⟩
    · exact (htr 602 (by omega)).trans hcoef
    · rw [htinitial,hur 514 (by omega),har 514,hp.initial]
      simp [initialLabel,v.property]
    · exact (htn 626 (by omega)).trans ((hun 626 (by omega)).trans ((han 626 (by omega)).trans hv))
    · exact hth.trans ((hun 72 (by omega)).trans ((han 72 (by omega)).trans hc.source))
  exact ⟨t,hall,hloaded,(hall.no_memory header_no_memory).2,(hall.no_memory header_no_memory).1⟩
end DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
end s239
section s240
set_option autoImplicit false
namespace DecrAlmostLinearSSSP.Decremental.CoreInitializeReturn
open Structured
lemma Loaded.after_capacity (b : Core) (B : ℕ) (v : ReturnVertex b) (s : Data)
    (h : Loaded b B v s) (hz : s.realReg 56 = 0) : Loaded b B v (CoreRefresh.result s) := by
  have he := CoreRefresh.eval_code s hz
  have hn (k : ℕ) := he.nat_frame (CoreRefresh.nat_frame k)
  have hr (k : ℕ) (hk : k ≠ 612 ∧ k ≠ 614 ∧ k ≠ 616 ∧ k ≠ 618) :=
    he.real_frame (CoreRefresh.real_frame k hk.1 hk.2.1 hk.2.2.1 hk.2.2.2)
  exact ⟨h.addresses.frame _ (fun k _ => hn k),(hr 602 (by omega)).trans h.coefficient,
    (hr 604 (by omega)).trans h.cost,(hr 606 (by omega)).trans h.initial,
