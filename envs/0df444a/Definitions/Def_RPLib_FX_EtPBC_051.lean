-- ===== S4.Def_RP_EtPBC_A_O2Sh1 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Sh1): `π_*` is exact for a separated etale `π` of constant degree

* `shObj s`, `shι s`: a map `s : N ⟶ W` of etale `P`-schemes gives a sheet `N ⟶ N ×_P W` over `W`.
* `sheet_cover`: sheets that biject onto every geometric fibre cover `N ×_P W`; `sheet_sep`: distinct sheets
  do not meet; `shι_cancel`.
* **`push_epi`**: if `W` is quasi-compact separated etale over `P` with `n` points in every geometric fibre, then
  `push W.hom` preserves epimorphisms (stalk lifts on a splitting neighbourhood, glued over the sheets), and
  **`push_preservesFiniteColimits_of_deg`**.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.EtShap

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.GenAlg RamanujanPetersson.EtPBC.FreeStk
  RamanujanPetersson.EtPBC.EtMV RamanujanPetersson.EtPBC.EtTr

universe u

variable {P : Scheme.{u}}

section Sheet

end Sheet

section Lift

variable {W N : P.Etale}

variable (Λ : Type u) [CommRing Λ]

/-- **Local lifts for `push W.hom`** (`W` separated, quasi-compact, constant degree `n`). -/
theorem exists_push_lift (W : P.Etale) [QuasiCompact W.hom] [IsSeparated W.hom] (n : ℕ)
    (hn : ∀ y : P, Nat.card ((geomPtAt y).point.fiber.obj W) = n)
    {A B : EtSh Λ W.left} (f : A ⟶ B) [Epi f] (x : P) {Z : P.Etale}
    (z : (geomPtAt x).point.fiber.obj Z) (b : B.obj.obj (op ((etPull W.hom).obj Z))) :
    ∃ (M : P.Etale) (d : M ⟶ Z) (m : (geomPtAt x).point.fiber.obj M), (geomPtAt x).point.fiber.map d m = z ∧
      ∃ a : A.obj.obj (op ((etPull W.hom).obj M)),
        (f.hom.app _).hom a = (B.obj.map ((etPull W.hom).map d).op).hom b := by
  classical
  obtain ⟨T, t, τ, -, -, hinj⟩ := exists_split_inj ⊤ W x (by simp)
  have hfin : Finite ((geomPtAt x).point.fiber.obj W) := finite_fiber W x
  obtain ⟨M₀, m₀, d₀, e₀, hd₀, -⟩ := exists_common x z t
  choose V g v hv i hi using fun p => exists_sheet_lift Λ f x m₀ (e₀ ≫ τ p)
    ((B.obj.map (shι (e₀ ≫ τ p) ≫ (etPull W.hom).map d₀).op).hom b)
  obtain ⟨L, c, h, hh⟩ := exists_cone (C := (geomPtAt x).point.fiber.Elements) ⟨M₀, m₀⟩
    (fun p => ⟨(etComp W.hom).obj (V p), v p⟩)
    (fun p => CategoryOfElements.homMk ⟨(etComp W.hom).obj (V p), v p⟩ ⟨M₀, m₀⟩ (upP (g p)) (hv p))
  have hh' : ∀ p, (h p).1 ≫ upP (g p) = c.1 := fun p => congrArg Subtype.val (hh p)
  have hcov := sheet_cover (fun p => c.1 ≫ e₀ ≫ τ p) (bij_of n hn x τ hinj c.1 e₀)
  have hsp : ∀ p, (f.hom.app _).hom ((A.obj.map (dnW (g p) c.1 (h p).1 (hh' p)).op).hom (i p)) =
      (B.obj.map (shι (c.1 ≫ e₀ ≫ τ p)).op).hom
        ((B.obj.map ((etPull W.hom).map (c.1 ≫ d₀)).op).hom b) := fun p => by
    have e : (dnW (g p) c.1 (h p).1 (hh' p) ≫ g p) ≫ shι (e₀ ≫ τ p) ≫ (etPull W.hom).map d₀ =
        shι (c.1 ≫ e₀ ≫ τ p) ≫ (etPull W.hom).map (c.1 ≫ d₀) :=
      (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ (etPull W.hom).map d₀)
        ((Category.assoc _ _ _).trans (dnW_comp (g p) c.1 (h p).1 (hh' p)))).trans
          ((Category.assoc _ _ _).trans
            (congrArg (shι (c.1 ≫ e₀ ≫ τ p) ≫ ·) ((etPull W.hom).map_comp c.1 d₀).symm)))
    rw [NatTrans.naturality_apply (φ := f.hom), hi p, ← mapc, ← mapc, ← mapc]
    exact congrArg (fun k => (B.obj.map k.op).hom b) e
  obtain ⟨a, ha, -⟩ := existsUnique_glue A (fun p => shι (c.1 ≫ e₀ ≫ τ p)) hcov
    (fun p => (A.obj.map (dnW (g p) c.1 (h p).1 (hh' p)).op).hom (i p)) fun p q Z' gi gj hg => by
      refine eq_of_germs A _ _ fun y w => ?_
      obtain rfl := sheet_sep (fun p => c.1 ≫ e₀ ≫ τ p) (sep_of τ hinj c.1 e₀) gi gj hg (fpt y w)
      obtain rfl := shι_cancel _ gi gj hg
      rfl
  have hfa : (f.hom.app _).hom a = (B.obj.map ((etPull W.hom).map (c.1 ≫ d₀)).op).hom b := by
    refine (existsUnique_glue B (fun p => shι (c.1 ≫ e₀ ≫ τ p)) hcov
      (fun p => (B.obj.map (shι (c.1 ≫ e₀ ≫ τ p)).op).hom
        ((B.obj.map ((etPull W.hom).map (c.1 ≫ d₀)).op).hom b)) ?_).unique ?_ ?_
    · exact fun p q Z' gi gj hg => compat_of Λ B (fun p => shι (c.1 ≫ e₀ ≫ τ p))
        ((B.obj.map ((etPull W.hom).map (c.1 ≫ d₀)).op).hom b) p q Z' gi gj hg
    · intro p
      rw [← NatTrans.naturality_apply (φ := f.hom) (shι (c.1 ≫ e₀ ≫ τ p)).op a, ha p, hsp p]
    · intro p
      rfl
  refine ⟨L.1, c.1 ≫ d₀, L.2, ?_, a, hfa⟩
  rw [Functor.map_comp_apply, c.2, hd₀]

end Lift

end RamanujanPetersson.EtPBC.EtShap

end

end

-- ===== S4.Def_RP_EtPBC_A_O2Km8 =====
section

/-!
# S4-EtPBC-A, O2 M6 (O2Km8): `H¹` is generated by Kummer classes of the pieces

* `kumD hζ hζΓ hdN hα hg : ChL A K Λ`: the Kummer character `kumChi_d α g` (`d ∣ N`, `α` a `d`-th radical,
  `d • g = 0`), `kumD_apply`;
* **`h1_mem_of_kum`**: an additive subgroup `S ≤ H¹(X, Λ)` containing every Kummer class
  `kapS p (kumD α g)` (`α ^ d = u ∈ Frac(Γ ⧸ p)`) of every piece `p` is everything
  (`h1_exists_kappa` + `exists_kum_dec`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC.EtKum

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtCompact.Pur RamanujanPetersson.EtPi1 RamanujanPetersson.Kummer
  RamanujanPetersson.EtCompact.GalTrE

section KumD

variable {A K : Type} [CommRing A] [Field K] [Algebra A K] {Λ : Type} [AddCommGroup Λ] {N : ℕ} [NeZero N]
  {ζ : maxUnram A K} (hζ : IsPrimitiveRoot ζ N) (hζΓ : ∀ σ ∈ (⊤ : Subgroup (Pi1 A K)), σ ζ = ζ)
  {d : ℕ} [NeZero d] (hdN : d ∣ N) {α : (maxUnram A K)ˣ} (hα : α ∈ rad (⊤ : Subgroup (Pi1 A K)) d)
  {g : Λ} (hg : d • g = 0)

theorem kumD_apply : (kumD hζ hζΓ hdN hα hg : Pi1 A K → Λ) = kumChi (primd hζ hdN) α g := rfl

end KumD

section Dec

variable {A K : Type} [CommRing A] [Field K] [Algebra A K] {Λ : Type} [AddCommGroup Λ] {N : ℕ} [NeZero N]
  {ζ : maxUnram A K} (hζ : IsPrimitiveRoot ζ N) (hζΓ : ∀ σ ∈ (⊤ : Subgroup (Pi1 A K)), σ ζ = ζ)
  (hΛ : ∀ x : Λ, N • x = 0)

include hΛ in
/-- `exists_kum_dec` as an identity in `ChL A K Λ`. -/
theorem chl_eq_sum_kumD (χ : ChL A K Λ) :
    ∃ (ι : Type) (_ : Fintype ι) (d : ι → ℕ) (_ : ∀ i, NeZero (d i)) (hdN : ∀ i, d i ∣ N) (g : ι → Λ)
      (α : ι → (maxUnram A K)ˣ) (u : ι → K) (hg : ∀ i, d i • g i = 0)
      (hα : ∀ i, α i ∈ rad (⊤ : Subgroup (Pi1 A K)) (d i)),
      (∀ i, (α i : maxUnram A K) ^ d i = algebraMap K (maxUnram A K) (u i)) ∧
      χ = ∑ i, kumD hζ hζΓ (hdN i) (hα i) (hg i) := by
  obtain ⟨ι, hι, d, hd, hdN, g, α, u, hg, hα, hu, hsum⟩ := exists_kum_dec hζ hζΓ hΛ χ
  refine ⟨ι, hι, d, hd, hdN, g, α, u, hg, hα, hu, ?_⟩
  apply Subtype.ext
  funext σ
  rw [hsum σ, AddSubmonoidClass.coe_finsetSum, Finset.sum_apply]
  rfl

include hΛ in
/-- An additive subgroup of `ChL A K Λ` containing every Kummer character is everything. -/
theorem chl_mem_of_kum (T : AddSubgroup (ChL A K Λ))
    (hT : ∀ (d : ℕ) [NeZero d] (hdN : d ∣ N) (α : (maxUnram A K)ˣ) (hα : α ∈ rad (⊤ : Subgroup (Pi1 A K)) d)
      (u : K) (_ : (α : maxUnram A K) ^ d = algebraMap K (maxUnram A K) u) (g : Λ) (hg : d • g = 0),
      kumD hζ hζΓ hdN hα hg ∈ T) (χ : ChL A K Λ) : χ ∈ T := by
  obtain ⟨ι, hι, d, hd, hdN, g, α, u, hg, hα, hu, e⟩ := chl_eq_sum_kumD hζ hζΓ hΛ χ
  rw [e]
  exact AddSubgroup.sum_mem _ fun i _ => hT (d i) (hdN i) (α i) (hα i) (u i) (hu i) (g i) (hg i)

end Dec

section Red

end Red

end RamanujanPetersson.EtPBC.EtKum

end

