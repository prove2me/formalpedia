theorem solution (n : ℕ) (S : ℝ × ℝ → Mat n) (hS : Continuous S)
    (u v : ℝ × ℝ → Vec n) (hu : IsTestSection u) (hv : IsTestSection v) :
    ∫ x, inner ℝ (crOp S u x) (v x) ∂cylMeasure =
      ∫ x, inner ℝ (u x) (-partialS v x + Matrix.toEuclideanLin (J₀ n) (partialT v x) +
        Matrix.toEuclideanLin (S x)ᵀ (v x)) ∂cylMeasure := by
  obtain ⟨Ru, hRu⟩ := hu.2.2
  obtain ⟨Rv, hRv⟩ := hv.2.2
  have hud : Differentiable ℝ u := hu.1.differentiable (by simp)
  have hvd : Differentiable ℝ v := hv.1.differentiable (by simp)
  set φ₁ : ℝ × ℝ → ℝ := fun x => inner ℝ (u x) (v x) with hφ₁
  set φ₂ : ℝ × ℝ → ℝ := fun x => inner ℝ (u x) (Matrix.toEuclideanLin (J₀ n) (v x)) with hφ₂
  have hJv : ContDiff ℝ ∞ fun x => Matrix.toEuclideanLin (J₀ n) (v x) :=
    (matCLM n (J₀ n)).contDiff.comp hv.1
  have hφ₁c : ContDiff ℝ 1 φ₁ := (hu.1.inner ℝ hv.1).of_le (by simp)
  have hφ₂c : ContDiff ℝ 1 φ₂ := (hu.1.inner ℝ hJv).of_le (by simp)
  -- pointwise identity
  have hpt : ∀ x, inner ℝ (crOp S u x) (v x) -
      inner ℝ (u x) (-partialS v x + Matrix.toEuclideanLin (J₀ n) (partialT v x) +
        Matrix.toEuclideanLin (S x)ᵀ (v x)) =
      fderiv ℝ φ₁ x (1, 0) - fderiv ℝ φ₂ x (0, 1) := by
    intro x
    rw [hφ₁, hφ₂, fderiv_inner_apply ℝ (hud x) (hvd x),
      fderiv_inner_apply ℝ (hud x) (hJv.differentiable (by simp) x),
      fderiv_matCLM_comp (J₀ n) (hvd x)]
    simp only [crOp, partialS, partialT, inner_add_left, inner_add_right, inner_neg_right,
      inner_toEuclideanLin, Matrix.J_transpose, transpose_transpose]
    have hneg : ∀ a b : Vec n, inner ℝ a (Matrix.toEuclideanLin (-J₀ n) b) =
        -inner ℝ a (Matrix.toEuclideanLin (J₀ n) b) := by
      intro a b; simp [map_neg, inner_neg_right]
    rw [hneg]
    ring
  have hint : ∀ {f : ℝ × ℝ → ℝ}, Continuous f → (∀ s t, max Ru Rv < |s| → f (s, t) = 0) →
      Integrable f cylMeasure := by
    intro f hf hfz
    rw [← memLp_one_iff_integrable]
    exact memLp_of_vanish f hf _ hfz
  have hRu' : ∀ s t, max Ru Rv < |s| → u (s, t) = 0 := fun s t hs =>
    hRu s t (lt_of_le_of_lt (le_max_left _ _) hs)
  have hRv' : ∀ s t, max Ru Rv < |s| → v (s, t) = 0 := fun s t hs =>
    hRv s t (lt_of_le_of_lt (le_max_right _ _) hs)
  have hcrOp_c : Continuous (crOp S u) :=
    (hu.continuous_partialS.add ((matCLM n (J₀ n)).continuous.comp hu.continuous_partialT)).add
      ((continuous_matCLM.comp hS).clm_apply hu.continuous)
  have hR_c : Continuous fun x => -partialS v x + Matrix.toEuclideanLin (J₀ n) (partialT v x) +
      Matrix.toEuclideanLin (S x)ᵀ (v x) :=
    (hv.continuous_partialS.neg.add ((matCLM n (J₀ n)).continuous.comp hv.continuous_partialT)).add
      ((continuous_matCLM.comp hS.matrix_transpose).clm_apply
        hv.continuous)
  have hI1 : Integrable (fun x => inner ℝ (crOp S u x) (v x)) cylMeasure :=
    hint (hcrOp_c.inner hv.continuous) fun s t hs => by simp [hRv' s t hs]
  have hI2 : Integrable (fun x => inner ℝ (u x) (-partialS v x +
      Matrix.toEuclideanLin (J₀ n) (partialT v x) + Matrix.toEuclideanLin (S x)ᵀ (v x)))
      cylMeasure :=
    hint (hu.continuous.inner hR_c) fun s t hs => by simp [hRu' s t hs]
  have hφ₁z : ∀ s t, max Ru Rv < |s| → φ₁ (s, t) = 0 := fun s t hs => by simp [hφ₁, hRu' s t hs]
  have hφ₂z : ∀ s t, max Ru Rv < |s| → φ₂ (s, t) = 0 := fun s t hs => by simp [hφ₂, hRu' s t hs]
  have hφ₂p : ∀ s t, φ₂ (s, t + 1) = φ₂ (s, t) := fun s t => by simp [hφ₂, hu.2.1, hv.2.1]
  have hd1 : Integrable (fun x => fderiv ℝ φ₁ x (1, 0)) cylMeasure :=
    hint ((hφ₁c.continuous_fderiv (by simp)).clm_apply continuous_const) fun s t hs => by
      simp [fderiv_eq_zero_of_vanish _ hφ₁z hs]
  have hd2 : Integrable (fun x => fderiv ℝ φ₂ x (0, 1)) cylMeasure :=
    hint ((hφ₂c.continuous_fderiv (by simp)).clm_apply continuous_const) fun s t hs => by
      simp [fderiv_eq_zero_of_vanish _ hφ₂z hs]
  rw [← sub_eq_zero, ← integral_sub hI1 hI2]
  simp_rw [hpt]
  rw [integral_sub hd1 hd2, integral_fderiv_s_eq_zero φ₁ hφ₁c _ hφ₁z,
    integral_fderiv_t_eq_zero φ₂ hφ₂c hφ₂p _ hφ₂z, sub_zero]
