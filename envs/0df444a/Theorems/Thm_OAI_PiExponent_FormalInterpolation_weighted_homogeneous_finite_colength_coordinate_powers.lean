-- title:
--   Finite colength of a positive-degree weighted homogeneous ideal gives coordinate powers
-- statement:
--   Given finite colength for the ideal generated by the bounded weighted components, show that every coordinate has a positive power in that ideal. Clearing denominators gives a positive integer grading in which the generators have positive degree; finite-dimensionality of the quotient then forces sufficiently high powers of each variable to vanish. When d = 0, the coordinate conclusion is vacuous.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators
open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.weighted_homogeneous_finite_colength_coordinate_powers
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (s : Nat) (q : Rat) (hq : 0 < q)
    (hfinite : Module.Finite Complex (MvPolynomial (Fin d) Complex ⧸
      Ideal.span (Set.range (fun (p :
        {g : MvPolynomial (Fin d) Complex //
          g ∈ I ^ s ∧
          ∀ a ∈ g.support,
            ∑ j, (w j : Real) * (a j : Real) ≤ (q : Real)}) =>
        MvPolynomial.weightedHomogeneousComponent
          (fun j => (w j : ℚ)) q p.1)))) :
    ∀ i : Fin d, ∃ n : Nat, 0 < n ∧
      MvPolynomial.X i ^ n ∈ Ideal.span (Set.range (fun (p :
        {g : MvPolynomial (Fin d) Complex //
          g ∈ I ^ s ∧
          ∀ a ∈ g.support,
            ∑ j, (w j : Real) * (a j : Real) ≤ (q : Real)}) =>
        MvPolynomial.weightedHomogeneousComponent
          (fun j => (w j : ℚ)) q p.1)) := by sorry
