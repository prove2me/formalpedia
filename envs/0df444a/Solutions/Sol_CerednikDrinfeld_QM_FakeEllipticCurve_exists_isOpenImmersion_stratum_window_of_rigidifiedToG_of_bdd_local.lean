theorem exists_pad_exponents (k k' d Nc : ℕ) (hkk : k + k' = 2 * d) (hN : 2 * d ≤ Nc + 1) :
    ∃ i j : ℕ, k + 2 * i = k' + 2 * j ∧ (d + (i + j) = Nc ∨ d + (i + j) = Nc + 1) := by
  rcases le_total k k' with h | h
  · refine ⟨(k' - k) / 2 + (Nc + 1 - (d + (k' - k) / 2)) / 2, (Nc + 1 - (d + (k' - k) / 2)) / 2, ?_, ?_⟩ <;> omega
  · refine ⟨(Nc + 1 - (d + (k - k') / 2)) / 2, (k - k') / 2 + (Nc + 1 - (d + (k - k') / 2)) / 2, ?_, ?_⟩ <;> omega

theorem exists_pad_balanced (q : ℕ) (hq : 1 < q)
