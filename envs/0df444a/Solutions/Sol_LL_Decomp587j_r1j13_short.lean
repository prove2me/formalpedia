def getV (k : Nat) : Nat :=
  if k < 512 then V_tree.get 9 k else V_last

def getU (k : Nat) : Nat :=
  U_tree.get 9 k

def allPow2 : Nat → Nat → (Nat → Bool) → Bool
  | 0, base, p => p base
  | d + 1, base, p => allPow2 d base p && allPow2 d (base + 2 ^ d) p

theorem allPow2_spec {d base : Nat} {p : Nat → Bool} (h : allPow2 d base p = true)
    {k : Nat} (hlo : base ≤ k) (hhi : k < base + 2 ^ d) : p k = true := by
  induction d generalizing base with
  | zero =>
    have hk : k = base := by omega
    subst hk
    exact h
  | succ d ih =>
    simp only [allPow2, Bool.and_eq_true] at h
    have hpow : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
    by_cases hlt : k < base + 2 ^ d
    · exact ih h.1 hlo hlt
    · exact ih h.2 (by omega) (by omega)

def checkBuchstabStepWith (gV gU : Nat → Nat) (k : Nat) : Bool :=
  if k < 128 then
    decide (S_scale ≤ gV k) &&
    decide (S_scale * K_grid ≤ gU k * (K_grid + k))
  else if k < 256 then
    decide (gV k ≤ gV (k + 1)) &&
    decide (S_scale * (2 * k + 1) ≤ 2 * k * (k + 1) * (gV (k + 1) - gV k)) &&
    decide (K_grid * gV k ≤ gU k * (K_grid + k)) &&
    decide (K_grid * (k * gV k + S_scale) ≤ k * (K_grid + k + 1) * gU k)
  else
    decide (gV k ≤ gV (k + 1)) &&
    decide (gU (k - 128) ≤ K_grid * (gV (k + 1) - gV k)) &&
    decide (K_grid * gV k ≤ gU k * (K_grid + k)) &&
    decide (K_grid * gV (k + 1) ≤ gU k * (K_grid + k + 1)) &&
    (if 384 ≤ k then decide (gU k ≤ M4_val) else true)

def validBuchstabCert : Bool :=
  U_tree.isValid 9 &&
  decide (S_scale ≤ getV 128) &&
  allPow2 9 0 (checkBuchstabStepWith getV getU)

theorem validBuchstabCert_ok : validBuchstabCert = true := by decide

def buchstabUB (k0 k1 : Nat) : Nat :=
  if 512 ≤ k0 then M4_val
  else if k1 < 512 then U_tree.rangeMax 9 k0 k1
  else max (U_tree.rangeMax 9 k0 511) M4_val

/-! ### Part 2: Pure-`Nat` 3D Box Quadrature Checker for `r1j13_short` -/

def D_den : Nat := 58622400
def W_scale : Nat := 1000000000
def A0_num : Nat := 13027200
def B0_num : Nat := 16560000
def A1_num : Nat := 16560000
def B1_num : Nat := 20355000
def A2_num : Nat := 20355000
def B2_num : Nat := 25488000

def ceilDiv (a b : Nat) : Nat := (a + b - 1) / b

theorem le_mul_ceilDiv {a b : Nat} (hb : 0 < b) : a ≤ b * ceilDiv a b := by
  unfold ceilDiv
  have h1 := Nat.div_add_mod (a + b - 1) b
  have h2 := Nat.mod_lt (a + b - 1) hb
  omega

def wInv (a b : Nat) : Nat :=
  ceilDiv (W_scale * (b * b - a * a)) (2 * a * b)

def wInvSq (a b : Nat) : Nat :=
  ceilDiv (W_scale * D_den * (b - a)) (a * b)

def sumUpTo : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | n + 1, f => sumUpTo n f + f n

def pieceSumWith (ub : Nat → Nat → Nat) (pa_n pb_n N : Nat) : Nat :=
  let h0 := (B0_num - A0_num) / N
  let h1 := (B1_num - A1_num) / N
  let h2 := (B2_num - A2_num) / N
  sumUpTo N fun i =>
    let lo0 := A0_num + i * h0
    let hi0 := lo0 + h0
    let w0 := wInv lo0 hi0
    w0 * sumUpTo N fun j =>
      let lo1 := A1_num + j * h1
      let hi1 := lo1 + h1
      let w1 := wInvSq lo1 hi1
      w1 * sumUpTo N fun k =>
        let lo2 := A2_num + k * h2
        let hi2 := lo2 + h2
        let w2 := wInv lo2 hi2
        let num_lo := pa_n - hi0 - 2 * hi1 - hi2
        let num_hi := pb_n - lo0 - 2 * lo1 - lo2
        let k0 := (num_lo * 128) / hi1
        let k1 := (num_hi * 128) / lo1
        ub k0 k1 * w2

def targetBoundNat : Nat := 20031169 * W_scale * W_scale * W_scale

def tailSum : Nat :=
  let h0 := (B0_num - A0_num) / 4
  let h2 := (B2_num - A2_num) / 4
  M4_val *
    (sumUpTo 4 fun i => wInv (A0_num + i * h0) (A0_num + (i + 1) * h0)) *
    wInvSq A1_num B1_num *
    (sumUpTo 4 fun k => wInv (A2_num + k * h2) (A2_num + (k + 1) * h2))

theorem checkPiece1_ok : pieceSumWith buchstabUB (200 * 586224) (202 * 586224) 12 ≤ targetBoundNat := by decide
theorem checkPiece2_ok : pieceSumWith buchstabUB (202 * 586224) (205 * 586224) 8 ≤ targetBoundNat := by decide
theorem checkPiece3_ok : pieceSumWith buchstabUB (205 * 586224) (210 * 586224) 6 ≤ targetBoundNat := by decide
theorem checkPiece4_ok : pieceSumWith buchstabUB (210 * 586224) (246 * 586224) 4 ≤ targetBoundNat := by decide
theorem checkTail_ok : tailSum ≤ targetBoundNat := by decide
theorem getU511_le_M4 : getU 511 ≤ M4_val := by decide

/-! ### Part 3: Analytic Soundness of the Buchstab Upper Envelope -/

noncomputable section

private lemma buchstab_integral_eq {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {a b : ℝ} (ha : 2 ≤ a) (hab : a ≤ b) :
    b * ω b - a * ω a = ∫ s in (a - 1)..(b - 1), ω s := by
  rcases hω with ⟨hcont, _, hderiv⟩
  have hsub : Icc a b ⊆ Ici (1 : ℝ) := fun x hx => le_trans (by linarith) hx.1
  have hcont_mul : ContinuousOn (fun v => v * ω v) (Icc a b) :=
    continuousOn_id.mul (hcont.mono hsub)
  have hderiv_open : ∀ x ∈ Ioo a b, HasDerivAt (fun v => v * ω v) (ω (x - 1)) x :=
    fun x hx => hderiv x (by linarith [hx.1])
  have hcont_shift : ContinuousOn (fun t => ω (t - 1)) (Icc a b) := by
    refine hcont.comp (continuousOn_id.sub continuousOn_const) ?_
    intro x hx
    change 1 ≤ x - 1
    linarith [hx.1]
  have hint : IntervalIntegrable (fun t => ω (t - 1)) volume a b :=
    hcont_shift.intervalIntegrable_of_Icc hab
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hab hcont_mul hderiv_open hint
  rw [← hftc, intervalIntegral.integral_comp_sub_right]

private lemma buchstab_nonneg_on_Icc {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    ∀ n : ℕ, ∀ u : ℝ, 1 ≤ u → u ≤ (n : ℝ) + 2 → 0 ≤ ω u := by
  intro n
  induction n with
  | zero =>
    intro u hu1 hu2
    push_cast at hu2
    rw [hω.2.1 u hu1 (by linarith)]
    positivity
  | succ n ih =>
    intro u hu1 hu2
    by_cases hle : u ≤ (n : ℝ) + 2
    · exact ih u hu1 hle
    · push Not at hle
      set b : ℝ := (n : ℝ) + 2
      have hb2 : 2 ≤ b := by dsimp only [b]; linarith [Nat.cast_nonneg (α := ℝ) n]
      have hbu : b ≤ u := le_of_lt hle
      have heq := buchstab_integral_eq hω hb2 hbu
      have hwb : 0 ≤ ω b := ih b (by linarith) (le_refl b)
      have hint_nn : 0 ≤ ∫ s in (b - 1)..(u - 1), ω s := by
        apply intervalIntegral.integral_nonneg (by linarith)
        intro s hs
        exact ih s (by linarith [hs.1]) (by push_cast at hu2; linarith [hs.2])
      have hu_pos : 0 < u := by linarith
      have hmul : 0 ≤ u * ω u := by nlinarith
      exact nonneg_of_mul_nonneg_right hmul hu_pos

private lemma buchstab_nonneg {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω)
    (u : ℝ) : 0 ≤ ω u := by
  by_cases h1 : u < 1
  · rw [hz u h1]
  · push Not at h1
    exact buchstab_nonneg_on_Icc hω (Nat.ceil u) u h1 (by linarith [Nat.le_ceil u])

private lemma integral_inv_le_trapezoid {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / s : ℝ) ≤ (b - a) / 2 * (1 / a + 1 / b) := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont1 : ContinuousOn (fun s : ℝ => 1 / s) (Icc a b) :=
    continuousOn_const.div continuousOn_id (fun s hs => ne_of_gt (lt_of_lt_of_le ha hs.1))
  have hcont2 : ContinuousOn (fun s : ℝ => (a + b - s) / (a * b)) (Icc a b) :=
    (continuousOn_const.sub continuousOn_id).div_const (a * b)
  have hmono : ∫ s in a..b, (1 / s : ℝ) ≤ ∫ s in a..b, (a + b - s) / (a * b) := by
    apply intervalIntegral.integral_mono_on hab
      (hcont1.intervalIntegrable_of_Icc hab) (hcont2.intervalIntegrable_of_Icc hab)
    intro s hs
    have hs_pos : 0 < s := lt_of_lt_of_le ha hs.1
    rw [div_le_div_iff₀ hs_pos (mul_pos ha hb)]
    nlinarith [hs.1, hs.2]
  have heval : ∫ s in a..b, (a + b - s) / (a * b) = (b - a) / 2 * (1 / a + 1 / b) := by
    have hderiv : ∀ x ∈ uIcc a b,
        HasDerivAt (fun s : ℝ => ((a + b) * s - s ^ 2 / 2) / (a * b)) ((a + b - x) / (a * b)) x := by
      intro x _
      have h1 : HasDerivAt (fun s : ℝ => (a + b) * s) (a + b) x := by
        simpa using (hasDerivAt_id x).const_mul (a + b)
      have h2 : HasDerivAt (fun s : ℝ => s ^ 2 / 2) x x := by
        simpa [mul_comm] using ((hasDerivAt_pow 2 x).div_const 2)
      exact (h1.sub h2).div_const (a * b)
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont2.intervalIntegrable_of_Icc hab)]
    field_simp
    ring
  linarith

private lemma integral_inv_sq_eq {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ s in a..b, (1 / (s * s) : ℝ) = 1 / a - 1 / b := by
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have hcont : ContinuousOn (fun s : ℝ => 1 / (s * s)) (Icc a b) :=
    continuousOn_const.div (continuousOn_id.mul continuousOn_id)
      (fun s hs => mul_ne_zero (ne_of_gt (lt_of_lt_of_le ha hs.1)) (ne_of_gt (lt_of_lt_of_le ha hs.1)))
  have hderiv : ∀ x ∈ uIcc a b, HasDerivAt (fun s : ℝ => -1 / s) (1 / (x * x)) x := by
    intro x hx
    rw [uIcc_of_le hab] at hx
    have hx_ne : x ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hx.1)
    have h : HasDerivAt (fun s : ℝ => -(s⁻¹)) (-(-(x ^ 2)⁻¹)) x := (hasDerivAt_inv hx_ne).neg
    have hfun : (fun s : ℝ => (-1 : ℝ) / s) = (fun s : ℝ => -(s⁻¹)) := by
      funext s; rw [neg_div, one_div]
    have hval : (1 : ℝ) / (x * x) = -(-(x ^ 2)⁻¹) := by rw [neg_neg, ← one_div, sq]
    rw [hfun, hval]
    exact h
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hcont.intervalIntegrable_of_Icc hab)]
  ring

private lemma buchstab_max_propagate {ω : ℝ → ℝ} (hω : IsBuchstab ω) {a M : ℝ}
    (ha : 1 ≤ a) (hbase : ∀ u ∈ Icc a (a + 1), ω u ≤ M) :
    ∀ u : ℝ, a ≤ u → ω u ≤ M := by
  have hstep : ∀ n : ℕ, ∀ u ∈ Icc a (a + 1 + n), ω u ≤ M := by
    intro n
    induction n with
    | zero =>
      intro u hu
      exact hbase u (by simpa using hu)
    | succ n ih =>
      intro u hu
      by_cases hle : u ≤ a + 1 + n
      · exact ih u ⟨hu.1, hle⟩
      · push Not at hle
        set b : ℝ := a + 1 + n
        have hn_nn : (0 : ℝ) ≤ n := Nat.cast_nonneg n
        have hb2 : 2 ≤ b := by dsimp only [b]; linarith
        have hbu : b ≤ u := le_of_lt hle
        have heq := buchstab_integral_eq hω hb2 hbu
        have hwb : ω b ≤ M := ih b ⟨by dsimp only [b]; linarith, le_refl b⟩
        have hcont_sub : ContinuousOn ω (Icc (b - 1) (u - 1)) :=
          hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
        have hint_le : ∫ s in (b - 1)..(u - 1), ω s ≤ (u - b) * M := by
          have h1 : ∫ s in (b - 1)..(u - 1), ω s ≤ ∫ _ in (b - 1)..(u - 1), M := by
            apply intervalIntegral.integral_mono_on (by linarith)
              (hcont_sub.intervalIntegrable_of_Icc (by linarith))
              intervalIntegrable_const
            intro s hs
            exact ih s ⟨by dsimp only [b] at hs; linarith [hs.1],
              by dsimp only [b]; push_cast at hu; linarith [hs.2, hu.2]⟩
          rw [intervalIntegral.integral_const, smul_eq_mul] at h1
          linarith
        have hu_pos : 0 < u := by linarith
        have hmul : u * ω u ≤ u * M := by nlinarith
        exact le_of_mul_le_mul_left hmul hu_pos
  intro u hu
  exact hstep (Nat.ceil (u - a)) u ⟨hu, by linarith [Nat.le_ceil (u - a)]⟩

private lemma affine_div_le_of_endpoints {a b u c va M : ℝ} (hab : a < b)
    (hau : a ≤ u) (hub : u ≤ b)
    (h1 : va ≤ c * a) (h2 : va + (b - a) * M ≤ c * b) :
    va + (u - a) * M ≤ c * u := by
  have hba : 0 < b - a := sub_pos.mpr hab
  have hlam0 : 0 ≤ (u - a) / (b - a) := div_nonneg (sub_nonneg.mpr hau) (le_of_lt hba)
  have hlam1 : 0 ≤ (b - u) / (b - a) := div_nonneg (sub_nonneg.mpr hub) (le_of_lt hba)
  have hcomb : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      ≤ ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b) := by
    nlinarith
  have hlhs : ((b - u) / (b - a)) * va + ((u - a) / (b - a)) * (va + (b - a) * M)
      = va + (u - a) * M := by field_simp; ring
  have hrhs : ((b - u) / (b - a)) * (c * a) + ((u - a) / (b - a)) * (c * b)
      = c * u := by field_simp; ring
  linarith

private def tk (k : Nat) : ℝ := 1 + (k : ℝ) / 128

private lemma buchstab_table_sound_aux {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    (gV gU : ℕ → ℕ)
    (hV128 : S_scale ≤ gV 128)
    (hall : ∀ k < 512, checkBuchstabStepWith gV gU k = true) :
    (∀ k ≤ 512, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
    (∀ k < 512, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hmain : ∀ m : ℕ, m ≤ 512 →
      (∀ k ≤ m, tk k * ω (tk k) ≤ (gV k : ℝ) / S_scale) ∧
      (∀ k < m, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (gU k : ℝ) / S_scale) := by
    intro m
    induction m with
    | zero =>
      intro _
      refine ⟨?_, fun k hk => by omega⟩
      intro k hk
      have hk0 : k = 0 := by omega
      subst hk0
      have hstep0 := hall 0 (by omega)
      simp only [checkBuchstabStepWith, (by omega : 0 < 128), ↓reduceIte, Bool.and_eq_true,
        decide_eq_true_eq] at hstep0
      have htk0 : tk 0 = 1 := by unfold tk; norm_num
      rw [htk0, hω.2.1 1 (le_refl 1) (by norm_num)]
      have hV0 : (S_scale : ℝ) ≤ (gV 0 : ℝ) := by exact_mod_cast hstep0.1
      rw [le_div_iff₀ hSpos]
      linarith
    | succ m ih =>
      intro hm
      have ⟨ihV, ihU⟩ := ih (by omega)
      have hstep := hall m (by omega)
      have hUm : ∀ u ∈ Icc (tk m) (tk (m + 1)), ω u ≤ (gU m : ℝ) / S_scale := by
        intro u hu
        by_cases hm1 : m < 128
        · simp only [checkBuchstabStepWith, hm1, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hstep
          have hu1 : 1 ≤ u := by unfold tk at hu; linarith [hu.1, (show (0 : ℝ) ≤ (m : ℝ) / 128 by positivity)]
          have hu2 : u ≤ 2 := by
            unfold tk at hu
            have hm_le : (m : ℝ) + 1 ≤ 128 := by exact_mod_cast (by omega : m + 1 ≤ 128)
            have htk_le : 1 + ((m + 1 : ℕ) : ℝ) / 128 ≤ 2 := by push_cast; linarith
            linarith [hu.2]
          rw [hω.2.1 u hu1 hu2]
          have htk_pos : 0 < tk m := by unfold tk; positivity
          have hinv : 1 / u ≤ 1 / tk m := one_div_le_one_div_of_le htk_pos hu.1
          have hnat : (S_scale : ℝ) * K_grid ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by
            exact_mod_cast hstep.2
          have htk_eq : tk m = ((K_grid : ℝ) + m) / K_grid := by
            unfold tk K_grid; push_cast; ring
          have hKm_pos : (0 : ℝ) < (K_grid : ℝ) + m := by unfold K_grid; positivity
          have h2 : 1 / tk m ≤ (gU m : ℝ) / S_scale := by
            rw [htk_eq, one_div_div, div_le_div_iff₀ hKm_pos hSpos]
            linarith
          linarith
        · by_cases hm2 : m < 256
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨_, _⟩, hU1⟩, hU2⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk
              have : (128 : ℝ) ≤ m := by exact_mod_cast (by omega : 128 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub_pos : (0 : ℝ) < tk m - 1 := by linarith
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤ (u - tk m) * (1 / (tk m - 1)) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), (1 / (tk m - 1) : ℝ) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                have hs1 : 1 ≤ s := by linarith [hs.1]
                have hs2 : s ≤ 2 := by
                  unfold tk at hu
                  have : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
                  have : u ≤ 3 := by push_cast at hu; linarith [hu.2]
                  linarith [hs.2]
                rw [hω.2.1 s hs1 hs2]
                exact one_div_le_one_div_of_le htm_sub_pos hs.1
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1
              linarith
            have huw_le : u * ω u ≤ (gV m : ℝ) / S_scale + (u - tk m) * (1 / (tk m - 1)) := by
              linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (128 : ℝ) * gV m ≤ (gU m : ℝ) * (128 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (128 : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                (m : ℝ) * (128 + (m : ℝ) + 1) * gU m := by
              have : (K_grid : ℝ) * ((m : ℝ) * gV m + S_scale) ≤
                  (m : ℝ) * ((K_grid : ℝ) + m + 1) * gU m := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk
              rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]
              linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * (1 / (tk m - 1)) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
              have hdiff : tk (m + 1) - tk m = 1 / 128 := by unfold tk; push_cast; ring
              have hsub1 : tk m - 1 = (m : ℝ) / 128 := by unfold tk; ring
              rw [hdiff, hsub1]
              have hterm : (1 / 128 : ℝ) * (1 / ((m : ℝ) / 128)) = 1 / m := by field_simp
              rw [hterm]
              unfold tk
              push_cast
              rw [div_mul_eq_mul_div]
              have hS_ne : (S_scale : ℝ) ≠ 0 := ne_of_gt hSpos
              have hm_ne : (m : ℝ) ≠ 0 := ne_of_gt hm_pos
              rw [div_add_div _ _ hS_ne hm_ne, div_le_div_iff₀ (mul_pos hSpos hm_pos) hSpos]
              nlinarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, hU1⟩, hU2⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk
              have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have heq := buchstab_integral_eq hω htm2 hu.1
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 128) := by
              unfold tk
              have hm128 : 128 ≤ m := by omega
              have hcast : ((m - 128 : ℕ) : ℝ) = (m : ℝ) - 128 := by
                rw [Nat.cast_sub hm128, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 128 + 1) := by
              unfold tk
              have hm128 : 128 ≤ m := by omega
              have hcast : ((m - 128 : ℕ) : ℝ) = (m : ℝ) - 128 := by
                rw [Nat.cast_sub hm128, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                (u - tk m) * ((gU (m - 128) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (u - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(u - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(u - 1), ((gU (m - 128) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith [hu.1])
                  (hcont_w.intervalIntegrable_of_Icc (by linarith [hu.1]))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 128) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, hu.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1
              linarith
            have huw_le : u * ω u ≤
                (gV m : ℝ) / S_scale + (u - tk m) * ((gU (m - 128) : ℝ) / S_scale) := by
              linarith
            have htm_lt : tk m < tk (m + 1) := by unfold tk; push_cast; linarith
            have htm_pos : 0 < tk m := by linarith
            have hU1r : (128 : ℝ) * gV m ≤ (gU m : ℝ) * (128 + (m : ℝ)) := by
              have : (K_grid : ℝ) * gV m ≤ (gU m : ℝ) * ((K_grid : ℝ) + m) := by exact_mod_cast hU1
              unfold K_grid at this; norm_num at this; linarith
            have hU2r : (128 : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * (128 + (m : ℝ) + 1) := by
              have : (K_grid : ℝ) * gV (m + 1) ≤ (gU m : ℝ) * ((K_grid : ℝ) + m + 1) := by exact_mod_cast hU2
              unfold K_grid at this; norm_num at this; linarith
            have hVstepr : (gU (m - 128) : ℝ) ≤ (128 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 128) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1
              unfold K_grid at h1; norm_num at h1; linarith
            have he1 : (gV m : ℝ) / S_scale ≤ ((gU m : ℝ) / S_scale) * tk m := by
              unfold tk
              rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]
              linarith
            have he2 : (gV m : ℝ) / S_scale + (tk (m + 1) - tk m) * ((gU (m - 128) : ℝ) / S_scale) ≤
                ((gU m : ℝ) / S_scale) * tk (m + 1) := by
              have hdiff : tk (m + 1) - tk m = 1 / 128 := by unfold tk; push_cast; ring
              rw [hdiff]
              unfold tk
              push_cast
              have h1 : (gV m : ℝ) / S_scale + 1 / 128 * ((gU (m - 128) : ℝ) / S_scale) ≤
                  (gV (m + 1) : ℝ) / S_scale := by
                rw [← mul_div_assoc, ← add_div, div_le_div_iff_of_pos_right hSpos]
                linarith
              have h2 : (gV (m + 1) : ℝ) / S_scale ≤
                  (gU m : ℝ) / S_scale * (1 + ((m : ℝ) + 1) / 128) := by
                rw [div_mul_eq_mul_div, div_le_div_iff_of_pos_right hSpos]
                linarith
              linarith
            have hlin := affine_div_le_of_endpoints htm_lt hu.1 hu.2 he1 he2
            have hu_pos : 0 < u := lt_of_lt_of_le htm_pos hu.1
            exact le_of_mul_le_mul_left (by nlinarith) hu_pos
      have hVm1 : tk (m + 1) * ω (tk (m + 1)) ≤ (gV (m + 1) : ℝ) / S_scale := by
        by_cases hm1 : m < 128
        · have htk_le2 : tk (m + 1) ≤ 2 := by
            unfold tk
            have : (m : ℝ) + 1 ≤ 128 := by exact_mod_cast (by omega : m + 1 ≤ 128)
            push_cast; linarith
          have htk_ge1 : 1 ≤ tk (m + 1) := by
            unfold tk; linarith [Nat.cast_nonneg (α := ℝ) (m + 1)]
          rw [hω.2.1 (tk (m + 1)) htk_ge1 htk_le2]
          have htk_ne : tk (m + 1) ≠ 0 := ne_of_gt (by linarith)
          rw [mul_one_div_cancel htk_ne]
          have hVge : S_scale ≤ gV (m + 1) := by
            by_cases hm127 : m + 1 < 128
            · have hs := hall (m + 1) (by omega)
              simp only [checkBuchstabStepWith, hm127, ↓reduceIte, Bool.and_eq_true,
                decide_eq_true_eq] at hs
              exact hs.1
            · have : m + 1 = 128 := by omega
              rw [this]; exact hV128
          have hVr : (S_scale : ℝ) ≤ gV (m + 1) := by exact_mod_cast hVge
          rw [le_div_iff₀ hSpos]; linarith
        · by_cases hm2 : m < 256
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk
              have : (128 : ℝ) ≤ m := by exact_mod_cast (by omega : 128 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have hint_eq : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s =
                ∫ s in (tk m - 1)..(tk (m + 1) - 1), (1 / s : ℝ) := by
              apply intervalIntegral.integral_congr
              intro s hs
              rw [uIcc_of_le (by linarith)] at hs
              have hs1 : 1 ≤ s := by linarith [hs.1]
              have hs2 : s ≤ 2 := by
                unfold tk at hs
                have : (m : ℝ) + 1 ≤ 256 := by exact_mod_cast (by omega : m + 1 ≤ 256)
                push_cast at hs; linarith [hs.2]
              exact hω.2.1 s hs1 hs2
            have htrap := integral_inv_le_trapezoid (a := tk m - 1) (b := tk (m + 1) - 1)
              (by linarith) (by linarith)
            have hsub0 : tk m - 1 = (m : ℝ) / 128 := by unfold tk; ring
            have hsub1 : tk (m + 1) - 1 = ((m : ℝ) + 1) / 128 := by unfold tk; push_cast; ring
            have hm_pos : (0 : ℝ) < m := by exact_mod_cast (by omega : 0 < m)
            have htrap_simp : (tk (m + 1) - 1 - (tk m - 1)) / 2 *
                (1 / (tk m - 1) + 1 / (tk (m + 1) - 1)) =
                (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) := by
              rw [hsub0, hsub1]; field_simp; ring
            have hVstepr : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (S_scale : ℝ) * (2 * (m : ℝ) + 1) ≤
                  2 * (m : ℝ) * ((m : ℝ) + 1) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1; exact h1
            have hstep_r : (2 * (m : ℝ) + 1) / (2 * (m : ℝ) * ((m : ℝ) + 1)) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [div_le_div_iff₀ (by positivity) hSpos]
              linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
          · simp only [checkBuchstabStepWith, hm1, hm2, ↓reduceIte, Bool.and_eq_true,
              decide_eq_true_eq] at hstep
            rcases hstep with ⟨⟨⟨⟨hVle, hVstep⟩, _⟩, _⟩, _⟩
            have htm2 : 2 ≤ tk m := by
              unfold tk
              have : (256 : ℝ) ≤ m := by exact_mod_cast (by omega : 256 ≤ m)
              linarith
            have htm_le : tk m ≤ tk (m + 1) := by unfold tk; push_cast; linarith
            have heq := buchstab_integral_eq hω htm2 htm_le
            have hVm := ihV m (le_refl m)
            have htm_sub : tk m - 1 = tk (m - 128) := by
              unfold tk
              have hm128 : 128 ≤ m := by omega
              have hcast : ((m - 128 : ℕ) : ℝ) = (m : ℝ) - 128 := by
                rw [Nat.cast_sub hm128, Nat.cast_ofNat]
              rw [hcast]; ring
            have htm1_sub : tk (m + 1) - 1 = tk (m - 128 + 1) := by
              unfold tk
              have hm128 : 128 ≤ m := by omega
              have hcast : ((m - 128 : ℕ) : ℝ) = (m : ℝ) - 128 := by
                rw [Nat.cast_sub hm128, Nat.cast_ofNat]
              push_cast; rw [hcast]; ring
            have hint_le : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                (1 / 128 : ℝ) * ((gU (m - 128) : ℝ) / S_scale) := by
              have hcont_w : ContinuousOn ω (Icc (tk m - 1) (tk (m + 1) - 1)) :=
                hω.1.mono (fun s hs => by change 1 ≤ s; linarith [hs.1])
              have h1 : ∫ s in (tk m - 1)..(tk (m + 1) - 1), ω s ≤
                  ∫ _ in (tk m - 1)..(tk (m + 1) - 1), ((gU (m - 128) : ℝ) / S_scale) := by
                apply intervalIntegral.integral_mono_on (by linarith)
                  (hcont_w.intervalIntegrable_of_Icc (by linarith))
                  intervalIntegrable_const
                intro s hs
                exact ihU (m - 128) (by omega) s ⟨by linarith [hs.1, htm_sub],
                  by linarith [hs.2, htm1_sub]⟩
              rw [intervalIntegral.integral_const, smul_eq_mul] at h1
              have hdiff : tk (m + 1) - 1 - (tk m - 1) = 1 / 128 := by unfold tk; push_cast; ring
              rw [hdiff] at h1
              exact h1
            have hVstepr : (gU (m - 128) : ℝ) ≤ (128 : ℝ) * ((gV (m + 1) : ℝ) - gV m) := by
              have h1 : (gU (m - 128) : ℝ) ≤ (K_grid : ℝ) * ((gV (m + 1) - gV m : ℕ) : ℝ) := by
                exact_mod_cast hVstep
              rw [Nat.cast_sub hVle] at h1
              unfold K_grid at h1; norm_num at h1; linarith
            have hstep_r : (1 / 128 : ℝ) * ((gU (m - 128) : ℝ) / S_scale) ≤
                ((gV (m + 1) : ℝ) - gV m) / S_scale := by
              rw [← mul_div_assoc, div_le_div_iff_of_pos_right hSpos]
              linarith
            have hcomb : (gV m : ℝ) / S_scale + ((gV (m + 1) : ℝ) - gV m) / S_scale =
                (gV (m + 1) : ℝ) / S_scale := by ring
            linarith
      refine ⟨?_, ?_⟩
      · intro k hk
        by_cases hkm : k ≤ m
        · exact ihV k hkm
        · have : k = m + 1 := by omega
          subst this; exact hVm1
      · intro k hk
        by_cases hkm : k < m
        · exact ihU k hkm
        · have : k = m := by omega
          subst this; exact hUm
  exact hmain 512 (le_refl 512)

private lemma buchstab_table_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) :
    (∀ k ≤ 512, tk k * ω (tk k) ≤ (getV k : ℝ) / S_scale) ∧
    (∀ k < 512, ∀ u ∈ Icc (tk k) (tk (k + 1)), ω u ≤ (getU k : ℝ) / S_scale) := by
  have hcert := validBuchstabCert_ok
  unfold validBuchstabCert at hcert
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hcert
  exact buchstab_table_sound_aux hω getV getU hcert.1.2
    (fun k hk => allPow2_spec hcert.2 (by omega) (by omega))

private lemma buchstab_le_M4 {ω : ℝ → ℝ} (hω : IsBuchstab ω) {u : ℝ} (hu : 4 ≤ u) :
    ω u ≤ (M4_val : ℝ) / S_scale := by
  have hcert := validBuchstabCert_ok
  unfold validBuchstabCert at hcert
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hcert
  have hall := hcert.2
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  apply buchstab_max_propagate hω (a := 4) (by norm_num) _ u hu
  intro x hx
  have hx_le5 : x ≤ 5 := by linarith [hx.2]
  by_cases hx5 : x = 5
  · subst hx5
    have hx_in : (5 : ℝ) ∈ Icc (tk 511) (tk 512) := by unfold tk; constructor <;> norm_num
    have h1 := hU 511 (by omega) 5 hx_in
    have hle : (getU 511 : ℝ) ≤ M4_val := by exact_mod_cast getU511_le_M4
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))
  · have hx_lt5 : x < 5 := lt_of_le_of_ne hx_le5 hx5
    set k : ℕ := Nat.floor ((x - 1) * 128)
    have hk_ge : 384 ≤ k := by
      have h384 : (384 : ℝ) ≤ (x - 1) * 128 := by linarith [hx.1]
      exact Nat.le_floor h384
    have hk_lt : k < 512 := by
      have h512 : (x - 1) * 128 < (512 : ℝ) := by linarith
      exact (Nat.floor_lt (by linarith [hx.1])).mpr h512
    have hfl1 : (k : ℝ) ≤ (x - 1) * 128 := Nat.floor_le (by linarith [hx.1])
    have hfl2 : (x - 1) * 128 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
    have hx_in : x ∈ Icc (tk k) (tk (k + 1)) := by
      unfold tk; push_cast; constructor <;> linarith
    have h1 := hU k hk_lt x hx_in
    have hst := allPow2_spec hall (by omega : 0 ≤ k) (by omega : k < 0 + 2 ^ 9)
    have hn1 : ¬ k < 128 := by omega
    have hn2 : ¬ k < 256 := by omega
    simp only [checkBuchstabStepWith, hn1, hn2, hk_ge, ↓reduceIte, Bool.and_eq_true,
      decide_eq_true_eq] at hst
    have hle : (getU k : ℝ) ≤ M4_val := by exact_mod_cast hst.2
    exact le_trans h1 (div_le_div_of_nonneg_right hle (le_of_lt hSpos))

private lemma buchstab_le_buchstabUB {ω : ℝ → ℝ} (hω : IsBuchstab ω) {k0 k1 : ℕ}
    (hk01 : k0 ≤ k1) {u : ℝ} (hlo : tk k0 ≤ u) (hhi : u ≤ tk (k1 + 1)) :
    ω u ≤ (buchstabUB k0 k1 : ℝ) / S_scale := by
  have hcert := validBuchstabCert_ok
  unfold validBuchstabCert at hcert
  simp only [Bool.and_eq_true] at hcert
  have hUval : U_tree.isValid 9 = true := hcert.1.1
  have hU := (buchstab_table_sound hω).2
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  unfold buchstabUB
  split_ifs with hk0_big hk1_lt
  · have hu4 : 4 ≤ u := by
      have : (512 : ℝ) ≤ k0 := by exact_mod_cast hk0_big
      unfold tk at hlo; linarith
    exact buchstab_le_M4 hω hu4
  · by_cases heq : u = tk (k1 + 1)
    · have hx_in : u ∈ Icc (tk k1) (tk (k1 + 1)) := by
        rw [heq]; unfold tk; push_cast; constructor <;> linarith
      have h1 := hU k1 hk1_lt u hx_in
      have h2 : getU k1 ≤ U_tree.rangeMax 9 k0 k1 :=
        SegTree.get_le_rangeMax hUval hk01 (le_refl k1) (by simpa using hk1_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · have hu_lt : u < tk (k1 + 1) := lt_of_le_of_ne hhi heq
      have hu1 : 1 ≤ u := by unfold tk at hlo; linarith [(show (0 : ℝ) ≤ (k0 : ℝ) / 128 by positivity)]
      set k : ℕ := Nat.floor ((u - 1) * 128)
      have hk0_le : k0 ≤ k := Nat.le_floor (by unfold tk at hlo; linarith)
      have hk_le1 : k ≤ k1 := by
        have hlt : (u - 1) * 128 < (k1 + 1 : ℕ) := by unfold tk at hu_lt; push_cast at *; linarith
        have := (Nat.floor_lt (by linarith)).mpr hlt
        omega
      have hk_lt : k < 512 := lt_of_le_of_lt hk_le1 hk1_lt
      have hx_in : u ∈ Icc (tk k) (tk (k + 1)) := by
        unfold tk; push_cast
        have hfl1 : (k : ℝ) ≤ (u - 1) * 128 := Nat.floor_le (by linarith)
        have hfl2 : (u - 1) * 128 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
        constructor <;> linarith
      have h1 := hU k hk_lt u hx_in
      have h2 : getU k ≤ U_tree.rangeMax 9 k0 k1 :=
        SegTree.get_le_rangeMax hUval hk0_le hk_le1 (by simpa using hk_lt)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
  · by_cases hu4 : 4 ≤ u
    · have h1 := buchstab_le_M4 hω hu4
      have h2 : M4_val ≤ max (U_tree.rangeMax 9 k0 511) M4_val := le_max_right _ _
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h2) (le_of_lt hSpos))
    · push Not at hu4
      have hu1 : 1 ≤ u := by unfold tk at hlo; linarith [(show (0 : ℝ) ≤ (k0 : ℝ) / 128 by positivity)]
      set k : ℕ := Nat.floor ((u - 1) * 128)
      have hk0_le : k0 ≤ k := Nat.le_floor (by unfold tk at hlo; linarith)
      have hk_lt : k < 512 := by
        have hlt : (u - 1) * 128 < (512 : ℝ) := by linarith
        exact (Nat.floor_lt (by linarith)).mpr hlt
      have hx_in : u ∈ Icc (tk k) (tk (k + 1)) := by
        unfold tk; push_cast
        have hfl1 : (k : ℝ) ≤ (u - 1) * 128 := Nat.floor_le (by linarith)
        have hfl2 : (u - 1) * 128 < (k : ℝ) + 1 := Nat.lt_floor_add_one _
        constructor <;> linarith
      have h1 := hU k hk_lt u hx_in
      have h2 : getU k ≤ U_tree.rangeMax 9 k0 511 :=
        SegTree.get_le_rangeMax hUval hk0_le (by omega) (by simpa using hk_lt)
      have h3 : getU k ≤ max (U_tree.rangeMax 9 k0 511) M4_val := le_trans h2 (le_max_left _ _)
      exact le_trans h1 (div_le_div_of_nonneg_right (by exact_mod_cast h3) (le_of_lt hSpos))

/-! ### Part 4: 3D Box Decomposition & Weight Integral Bounds -/

private lemma sumUpTo_eq_finset_sum (n : ℕ) (f : ℕ → ℕ) :
    (sumUpTo n f : ℝ) = ∑ i ∈ Finset.range n, (f i : ℝ) := by
  induction n with
  | zero => simp [sumUpTo]
  | succ n ih =>
    simp only [sumUpTo, Finset.sum_range_succ, Nat.cast_add, ih]

private lemma setIntegral_union_le_of_nonneg {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {A B : Set α} {f : α → ℝ} (hA : MeasurableSet A) (hB : MeasurableSet B)
    (hnnB : ∀ x ∈ B, 0 ≤ f x) (hintA : IntegrableOn f A μ) (hintB : IntegrableOn f B μ) :
    ∫ x in A ∪ B, f x ∂μ ≤ (∫ x in A, f x ∂μ) + (∫ x in B, f x ∂μ) := by
  have hAB : A ∪ B = A ∪ (B \ A) := (Set.union_sdiff_self).symm
  rw [hAB, setIntegral_union disjoint_sdiff_self_right (hB.diff hA) hintA
    (hintB.mono_set Set.sdiff_subset)]
  have hle : ∫ x in B \ A, f x ∂μ ≤ ∫ x in B, f x ∂μ :=
    setIntegral_mono_set hintB
      (ae_restrict_of_forall_mem hB hnnB)
      (Filter.Eventually.of_forall Set.sdiff_subset)
  linarith

private lemma integrableOn_biUnion_finset {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) {f : α → ℝ}
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    IntegrableOn f (⋃ i ∈ s, A i) μ := by
  induction s using Finset.induction_on with
  | empty => simp [integrableOn_empty]
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by
      ext x; simp
    rw [hun]
    exact (hint a (Finset.mem_insert_self a s)).union
      (ih (fun i hi => hint i (Finset.mem_insert_of_mem hi)))

private lemma setIntegral_le_sum_biUnion {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} [DecidableEq ι] (s : Finset ι) (A : ι → Set α) (D : Set α) {f : α → ℝ}
    (hD : D ⊆ ⋃ i ∈ s, A i)
    (hmeas : ∀ i ∈ s, MeasurableSet (A i))
    (hnn : ∀ i ∈ s, ∀ x ∈ A i, 0 ≤ f x)
    (hint : ∀ i ∈ s, IntegrableOn f (A i) μ) :
    ∫ x in D, f x ∂μ ≤ ∑ i ∈ s, ∫ x in A i, f x ∂μ := by
  have hunion_meas : MeasurableSet (⋃ i ∈ s, A i) :=
    Finset.measurableSet_biUnion s hmeas
  have hunion_nn : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
    intro x hx
    simp only [mem_iUnion, exists_prop] at hx
    rcases hx with ⟨i, hi, hxi⟩
    exact hnn i hi x hxi
  have hunion_int : IntegrableOn f (⋃ i ∈ s, A i) μ :=
    integrableOn_biUnion_finset s A hint
  have hsub : ∫ x in D, f x ∂μ ≤ ∫ x in ⋃ i ∈ s, A i, f x ∂μ :=
    setIntegral_mono_set hunion_int
      (ae_restrict_of_forall_mem hunion_meas hunion_nn)
      (Filter.Eventually.of_forall hD)
  refine le_trans hsub ?_
  clear hD hunion_meas hunion_nn hunion_int hsub
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    have hun : (⋃ i ∈ insert a s, A i) = A a ∪ ⋃ i ∈ s, A i := by
      ext x; simp
    rw [hun, Finset.sum_insert ha]
    have hms : MeasurableSet (⋃ i ∈ s, A i) :=
      Finset.measurableSet_biUnion s (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
    have hnns : ∀ x ∈ ⋃ i ∈ s, A i, 0 ≤ f x := by
      intro x hx
      simp only [mem_iUnion, exists_prop] at hx
      rcases hx with ⟨i, hi, hxi⟩
      exact hnn i (Finset.mem_insert_of_mem hi) x hxi
    have hints : IntegrableOn f (⋃ i ∈ s, A i) μ :=
      integrableOn_biUnion_finset s A (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    have h1 := setIntegral_union_le_of_nonneg
      (hmeas a (Finset.mem_insert_self a s)) hms hnns
      (hint a (Finset.mem_insert_self a s)) hints
    have h2 := ih
      (fun i hi => hmeas i (Finset.mem_insert_of_mem hi))
      (fun i hi => hnn i (Finset.mem_insert_of_mem hi))
      (fun i hi => hint i (Finset.mem_insert_of_mem hi))
    linarith

private def box3 (a0 b0 a1 b1 a2 b2 : ℝ) : Set (Fin 3 → ℝ) :=
  Set.univ.pi ![Icc a0 b0, Icc a1 b1, Icc a2 b2]

private lemma box3_measurable (a0 b0 a1 b1 a2 b2 : ℝ) :
    MeasurableSet (box3 a0 b0 a1 b1 a2 b2) := by
  apply MeasurableSet.univ_pi
  intro j
  fin_cases j <;> exact measurableSet_Icc

private lemma box3_weight_integral {a0 b0 a1 b1 a2 b2 : ℝ}
    (h0 : a0 ≤ b0) (h1 : a1 ≤ b1) (h2 : a2 ≤ b2) :
    ∫ x in box3 a0 b0 a1 b1 a2 b2, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) =
      (∫ t in a0..b0, (1 / t : ℝ)) *
      (∫ t in a1..b1, (1 / (t * t) : ℝ)) *
      (∫ t in a2..b2, (1 / t : ℝ)) := by
  have hfun : (fun x : Fin 3 → ℝ => (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ)) =
      (fun x : Fin 3 → ℝ => ∏ j : Fin 3,
        (![fun t : ℝ => 1 / t, fun t : ℝ => 1 / (t * t), fun t : ℝ => 1 / t] j) (x j)) := by
    ext x
    simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
    ring
  rw [hfun]
  have hvol : (volume : Measure (Fin 3 → ℝ)).restrict (box3 a0 b0 a1 b1 a2 b2) =
      Measure.pi (fun j : Fin 3 => (volume : Measure ℝ).restrict (![Icc a0 b0, Icc a1 b1, Icc a2 b2] j)) := by
    unfold box3
    exact Measure.restrict_pi_pi (fun _ : Fin 3 => (volume : Measure ℝ)) _
  rw [hvol, MeasureTheory.integral_fintype_prod_eq_prod]
  simp only [Fin.prod_univ_three, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h0,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h1,
      MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le h2]

private lemma wInv_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_den)..((b : ℝ) / D_den), (1 / t : ℝ) ≤ (wInv a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D_den ≤ (b : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  have htrap := integral_inv_le_trapezoid (div_pos har hDpos) habr
  have hsimp : ((b : ℝ) / D_den - (a : ℝ) / D_den) / 2 *
      (1 / ((a : ℝ) / D_den) + 1 / ((b : ℝ) / D_den)) =
      ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) := by
    field_simp; ring
  have h2ab_pos : 0 < 2 * a * b := Nat.mul_pos (Nat.mul_pos (by omega) ha) hb
  have hceil : W_scale * (b * b - a * a) ≤ (2 * a * b) * wInv a b :=
    le_mul_ceilDiv h2ab_pos
  have hsub : ((b * b - a * a : ℕ) : ℝ) = (b : ℝ) * b - (a : ℝ) * a := by
    rw [Nat.cast_sub (Nat.mul_le_mul hab hab)]; push_cast; ring
  have hceilr : (W_scale : ℝ) * ((b : ℝ) * b - (a : ℝ) * a) ≤
      (2 * (a : ℝ) * b) * (wInv a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  have hle : ((b : ℝ) * b - (a : ℝ) * a) / (2 * (a : ℝ) * b) ≤ (wInv a b : ℝ) / W_scale := by
    rw [div_le_div_iff₀ (by positivity) hWpos]
    linarith
  linarith

private lemma wInvSq_bound {a b : ℕ} (ha : 0 < a) (hab : a ≤ b) :
    ∫ t in ((a : ℝ) / D_den)..((b : ℝ) / D_den), (1 / (t * t) : ℝ) ≤ (wInvSq a b : ℝ) / W_scale := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hb : 0 < b := lt_of_lt_of_le ha hab
  have har : (0 : ℝ) < a := by exact_mod_cast ha
  have hbr : (0 : ℝ) < b := by exact_mod_cast hb
  have habr : (a : ℝ) / D_den ≤ (b : ℝ) / D_den :=
    div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  rw [integral_inv_sq_eq (div_pos har hDpos) habr]
  have hsimp : 1 / ((a : ℝ) / D_den) - 1 / ((b : ℝ) / D_den) =
      (D_den : ℝ) * ((b : ℝ) - a) / ((a : ℝ) * b) := by
    field_simp
  rw [hsimp]
  have hab_pos : 0 < a * b := Nat.mul_pos ha hb
  have hceil : W_scale * D_den * (b - a) ≤ (a * b) * wInvSq a b :=
    le_mul_ceilDiv hab_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * D_den * ((b : ℝ) - a) ≤ (a : ℝ) * b * (wInvSq a b : ℝ) := by
    rw [← hsub]; exact_mod_cast hceil
  rw [div_le_div_iff₀ (by positivity) hWpos]
  linarith

private lemma r1j13_domain_eq :
    domain (fun j => (r1j13_lo j : ℝ)) (fun j => (r1j13_hi j : ℝ)) =
      box3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
           ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
           ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) := by
  have hlo0 : (r1j13_lo 0 : ℝ) = (A0_num : ℝ) / D_den := by
    simp [r1j13_lo, A0_num, D_den]; norm_num
  have hhi0 : (r1j13_hi 0 : ℝ) = (B0_num : ℝ) / D_den := by
    simp [r1j13_hi, B0_num, D_den]; norm_num
  have hlo1 : (r1j13_lo 1 : ℝ) = (A1_num : ℝ) / D_den := by
    simp [r1j13_lo, A1_num, D_den]; norm_num
  have hhi1 : (r1j13_hi 1 : ℝ) = (B1_num : ℝ) / D_den := by
    simp [r1j13_hi, B1_num, D_den]; norm_num
  have hlo2 : (r1j13_lo 2 : ℝ) = (A2_num : ℝ) / D_den := by
    simp [r1j13_lo, A2_num, D_den]; norm_num
  have hhi2 : (r1j13_hi 2 : ℝ) = (B2_num : ℝ) / D_den := by
    simp [r1j13_hi, B2_num, D_den]; norm_num
  ext x
  simp only [domain, box3, mem_ofPred_eq, mem_univ_pi]
  constructor
  · rintro ⟨_, hbox⟩ j
    fin_cases j
    · simpa [hlo0, hhi0] using hbox 0
    · simpa [hlo1, hhi1] using hbox 1
    · simpa [hlo2, hhi2] using hbox 2
  · intro hbox
    have hx0 : (A0_num : ℝ) / D_den ≤ x 0 ∧ x 0 ≤ (B0_num : ℝ) / D_den := by simpa using hbox 0
    have hx1 : (A1_num : ℝ) / D_den ≤ x 1 ∧ x 1 ≤ (B1_num : ℝ) / D_den := by simpa using hbox 1
    have hx2 : (A2_num : ℝ) / D_den ≤ x 2 ∧ x 2 ≤ (B2_num : ℝ) / D_den := by simpa using hbox 2
    refine ⟨?_, ?_⟩
    · intro i j hij
      have h01 : (B0_num : ℝ) / D_den ≤ (A1_num : ℝ) / D_den := by
        unfold B0_num A1_num D_den; norm_num
      have h12 : (B1_num : ℝ) / D_den ≤ (A2_num : ℝ) / D_den := by
        unfold B1_num A2_num D_den; norm_num
      fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> linarith
    · intro j
      fin_cases j
      · simpa [hlo0, hhi0] using hx0
      · simpa [hlo1, hhi1] using hx1
      · simpa [hlo2, hhi2] using hx2

private lemma integrand_integrableOn_subbox {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    {φ : ℝ} (hφ : 2 ≤ φ)
    {a0 b0 a1 b1 a2 b2 : ℝ}
    (hsub : box3 a0 b0 a1 b1 a2 b2 ⊆
      box3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
           ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
           ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den)) :
    IntegrableOn
      (fun x : Fin 3 → ℝ => ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩))
      (box3 a0 b0 a1 b1 a2 b2) volume := by
  have hcomp : IsCompact (box3 a0 b0 a1 b1 a2 b2) := by
    unfold box3
    exact isCompact_univ_pi fun j => by fin_cases j <;> exact isCompact_Icc
  apply ContinuousOn.integrableOn_compact hcomp
  have hxpos : ∀ x ∈ box3 a0 b0 a1 b1 a2 b2,
      (0 : ℝ) < x 0 ∧ (0 : ℝ) < x 1 ∧ (0 : ℝ) < x 2 ∧
      1 ≤ (φ - ∑ j, x j) / x 1 := by
    intro x hx
    have hxm := hsub hx
    simp only [box3, mem_univ_pi] at hxm
    have hx0 : x 0 ∈ Icc ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den) := by simpa using hxm 0
    have hx1 : x 1 ∈ Icc ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den) := by simpa using hxm 1
    have hx2 : x 2 ∈ Icc ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) := by simpa using hxm 2
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_den := by unfold A0_num D_den; norm_num
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_den := by unfold A1_num D_den; norm_num
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_den := by unfold A2_num D_den; norm_num
    have hBsum : (B0_num : ℝ) / D_den + 2 * ((B1_num : ℝ) / D_den) + (B2_num : ℝ) / D_den ≤ 2 := by
      unfold B0_num B1_num B2_num D_den; norm_num
    have h0p : (0 : ℝ) < x 0 := lt_of_lt_of_le hA0 hx0.1
    have h1p : (0 : ℝ) < x 1 := lt_of_lt_of_le hA1 hx1.1
    have h2p : (0 : ℝ) < x 2 := lt_of_lt_of_le hA2 hx2.1
    refine ⟨h0p, h1p, h2p, ?_⟩
    rw [le_div_iff₀ h1p, Fin.sum_univ_three]
    linarith [hx0.2, hx1.2, hx2.2]
  have harg_cont : ContinuousOn (fun x : Fin 3 → ℝ => (φ - ∑ j, x j) / x 1)
      (box3 a0 b0 a1 b1 a2 b2) := by
    refine ContinuousOn.div ?_ (continuous_apply 1).continuousOn ?_
    · exact continuousOn_const.sub (continuousOn_finsetSum _ fun j _ => (continuous_apply j).continuousOn)
    · intro x hx; exact ne_of_gt (hxpos x hx).2.1
  have hnum_cont : ContinuousOn (fun x : Fin 3 → ℝ => ω ((φ - ∑ j, x j) / x 1))
      (box3 a0 b0 a1 b1 a2 b2) :=
    hω.1.comp harg_cont (fun x hx => (hxpos x hx).2.2.2)
  have hden_cont : ContinuousOn (fun x : Fin 3 → ℝ => (∏ j : Fin 3, x j) * x 1)
      (box3 a0 b0 a1 b1 a2 b2) :=
    (continuousOn_finsetProd _ fun j _ => (continuous_apply j).continuousOn).mul
      (continuous_apply 1).continuousOn
  refine hnum_cont.div hden_cont ?_
  intro x hx
  rcases hxpos x hx with ⟨h0, h1, h2, _⟩
  rw [Fin.prod_univ_three]
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (ne_of_gt h0) (ne_of_gt h1)) (ne_of_gt h2)) (ne_of_gt h1)

private lemma nat_grid_step_le {A B N hh i : ℕ} (hAB : A ≤ B) (hNh : N * hh = B - A) (hi : i < N) :
    A + i * hh + hh ≤ B := by
  have h1 : (i + 1) * hh ≤ N * hh := Nat.mul_le_mul_right hh hi
  have h2 : i * hh + hh = (i + 1) * hh := by ring
  omega

private lemma nat_grid_step_pos {A B N hh : ℕ} (hAB : A < B) (hNh : N * hh = B - A) : 0 < hh := by
  by_contra h
  have h0 : hh = 0 := by omega
  rw [h0, Nat.mul_zero] at hNh
  omega

private lemma r1j13_cell_bound {ω : ℝ → ℝ} (hω : IsBuchstab ω)
    (ub : ℕ → ℕ → ℕ)
    (hub : ∀ k0 k1 : ℕ, k0 ≤ k1 → ∀ u : ℝ, tk k0 ≤ u → u ≤ tk (k1 + 1) → ω u ≤ (ub k0 k1 : ℝ) / S_scale)
    {φ : ℝ} {pa_n pb_n lo0 hi0 lo1 hi1 lo2 hi2 : ℕ}
    (hlo0_pos : 0 < lo0) (hlo1_pos : 0 < lo1) (hlo2_pos : 0 < lo2)
    (hlo0_le : lo0 ≤ hi0) (hlo1_le : lo1 ≤ hi1) (hlo2_le : lo2 ≤ hi2)
    (hsum_hi_le : hi0 + 2 * hi1 + hi2 ≤ pa_n) (hpab : pa_n ≤ pb_n)
    (hφ2 : 2 ≤ φ)
    (hφ_lo : (pa_n : ℝ) / D_den ≤ φ) (hφ_hi : φ ≤ (pb_n : ℝ) / D_den)
    (hsub : box3 ((lo0 : ℝ) / D_den) ((hi0 : ℝ) / D_den)
                 ((lo1 : ℝ) / D_den) ((hi1 : ℝ) / D_den)
                 ((lo2 : ℝ) / D_den) ((hi2 : ℝ) / D_den) ⊆
            box3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
                 ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
                 ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den)) :
    ∫ x in box3 ((lo0 : ℝ) / D_den) ((hi0 : ℝ) / D_den)
                ((lo1 : ℝ) / D_den) ((hi1 : ℝ) / D_den)
                ((lo2 : ℝ) / D_den) ((hi2 : ℝ) / D_den),
      ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) ≤
      ((wInv lo0 hi0 : ℝ) * (wInvSq lo1 hi1 : ℝ) *
       ((ub (((pa_n - hi0 - 2 * hi1 - hi2) * 128) / hi1)
            (((pb_n - lo0 - 2 * lo1 - lo2) * 128) / lo1) : ℝ) *
        (wInv lo2 hi2 : ℝ))) /
      ((S_scale : ℝ) * W_scale * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hhi1_pos : 0 < hi1 := lt_of_lt_of_le hlo1_pos hlo1_le
  have hsum_lo_le : lo0 + 2 * lo1 + lo2 ≤ pb_n := by omega
  set num_lo := pa_n - hi0 - 2 * hi1 - hi2
  set num_hi := pb_n - lo0 - 2 * lo1 - lo2
  set k0 := (num_lo * 128) / hi1
  set k1 := (num_hi * 128) / lo1
  have hk01 : k0 ≤ k1 := by
    have hnum_le : num_lo ≤ num_hi := by dsimp only [num_lo, num_hi]; omega
    have h1 : num_lo * 128 ≤ num_hi * 128 := Nat.mul_le_mul_right 128 hnum_le
    have h2 : (num_lo * 128) / hi1 ≤ (num_lo * 128) / lo1 :=
      Nat.div_le_div_left hlo1_le hlo1_pos
    exact le_trans h2 (Nat.div_le_div_right h1)
  set M : ℝ := (ub k0 k1 : ℝ) / S_scale
  have hM_nn : 0 ≤ M := div_nonneg (Nat.cast_nonneg _) (le_of_lt hSpos)
  set C := box3 ((lo0 : ℝ) / D_den) ((hi0 : ℝ) / D_den)
                ((lo1 : ℝ) / D_den) ((hi1 : ℝ) / D_den)
                ((lo2 : ℝ) / D_den) ((hi2 : ℝ) / D_den)
  have hpt : ∀ x ∈ C,
      ω ((φ - ∑ d, x d) / x ⟨1, by omega⟩) / ((∏ d, x d) * x ⟨1, by omega⟩) ≤
        M * (1 / ((∏ d : Fin 3, x d) * x 1)) := by
    intro x hx
    simp only [C, box3, mem_univ_pi] at hx
    have hx0 : x 0 ∈ Icc ((lo0 : ℝ) / D_den) ((hi0 : ℝ) / D_den) := by
      have h := hx 0; simp only [Matrix.cons_val_zero] at h; exact h
    have hx1 : x 1 ∈ Icc ((lo1 : ℝ) / D_den) ((hi1 : ℝ) / D_den) := by
      have h := hx 1; simp only [Matrix.cons_val_one, Matrix.cons_val_zero] at h; exact h
    have hx2 : x 2 ∈ Icc ((lo2 : ℝ) / D_den) ((hi2 : ℝ) / D_den) := by
      have h := hx 2; simp only [Matrix.cons_val] at h; exact h
    have h0p : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo0_pos) hDpos) hx0.1
    have h1p : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo1_pos) hDpos) hx1.1
    have h2p : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast hlo2_pos) hDpos) hx2.1
    have hden_pos : 0 < (∏ d : Fin 3, x d) * x 1 := by rw [Fin.prod_univ_three]; positivity
    set u : ℝ := (φ - ∑ d, x d) / x 1
    have hu_lo : tk k0 ≤ u := by
      unfold tk u
      rw [Fin.sum_univ_three]
      have hdiv : (k0 : ℝ) * (hi1 : ℝ) ≤ (num_lo : ℝ) * 128 := by
        exact_mod_cast Nat.div_mul_le_self (num_lo * 128) hi1
      have hnum_eq : (num_lo : ℝ) = (pa_n : ℝ) - hi0 - 2 * hi1 - hi2 := by
        have : num_lo + (hi0 + 2 * hi1 + hi2) = pa_n := by omega
        have hcast : (num_lo : ℝ) + ((hi0 : ℝ) + 2 * hi1 + hi2) = (pa_n : ℝ) := by
          exact_mod_cast this
        linarith
      have h1 : (pa_n : ℝ) - hi0 - hi1 - hi2 ≤ (φ - (x 0 + x 1 + x 2)) * D_den := by
        have hp := (div_le_iff₀ hDpos).mp hφ_lo
        have h0b := (le_div_iff₀ hDpos).mp hx0.2
        have h1b := (le_div_iff₀ hDpos).mp hx1.2
        have h2b := (le_div_iff₀ hDpos).mp hx2.2
        linarith
      have h2 : x 1 * D_den ≤ hi1 := (le_div_iff₀ hDpos).mp hx1.2
      rw [le_div_iff₀ h1p]
      have h3 : (1 + (k0 : ℝ) / 128) * (hi1 : ℝ) ≤ (pa_n : ℝ) - hi0 - hi1 - hi2 := by linarith
      have h4 : (1 + (k0 : ℝ) / 128) * (x 1 * D_den) ≤ (1 + (k0 : ℝ) / 128) * hi1 := by
        have : (0 : ℝ) ≤ 1 + (k0 : ℝ) / 128 := by positivity
        nlinarith
      have h5 : (1 + (k0 : ℝ) / 128) * x 1 * D_den ≤ (φ - (x 0 + x 1 + x 2)) * D_den := by linarith
      exact le_of_mul_le_mul_right h5 hDpos
    have hu_hi : u ≤ tk (k1 + 1) := by
      unfold tk u
      rw [Fin.sum_univ_three]
      have hdiv : (num_hi : ℝ) * 128 < ((k1 : ℝ) + 1) * (lo1 : ℝ) := by
        have hlt : num_hi * 128 < (k1 + 1) * lo1 := by
          dsimp only [k1]
          rw [Nat.add_mul, Nat.one_mul]
          exact Nat.lt_div_mul_add (a := num_hi * 128) hlo1_pos
        exact_mod_cast hlt
      have hnum_eq : (num_hi : ℝ) = (pb_n : ℝ) - lo0 - 2 * lo1 - lo2 := by
        have : num_hi + (lo0 + 2 * lo1 + lo2) = pb_n := by omega
        have hcast : (num_hi : ℝ) + ((lo0 : ℝ) + 2 * lo1 + lo2) = (pb_n : ℝ) := by
          exact_mod_cast this
        linarith
      have h1 : (φ - (x 0 + x 1 + x 2)) * D_den ≤ (pb_n : ℝ) - lo0 - lo1 - lo2 := by
        have hp := (le_div_iff₀ hDpos).mp hφ_hi
        have h0b := (div_le_iff₀ hDpos).mp hx0.1
        have h1b := (div_le_iff₀ hDpos).mp hx1.1
        have h2b := (div_le_iff₀ hDpos).mp hx2.1
        linarith
      have h2 : (lo1 : ℝ) ≤ x 1 * D_den := (div_le_iff₀ hDpos).mp hx1.1
      rw [div_le_iff₀ h1p]
      push_cast
      have h3 : (pb_n : ℝ) - lo0 - lo1 - lo2 ≤ (1 + ((k1 : ℝ) + 1) / 128) * (lo1 : ℝ) := by linarith
      have h4 : (1 + ((k1 : ℝ) + 1) / 128) * (lo1 : ℝ) ≤
          (1 + ((k1 : ℝ) + 1) / 128) * (x 1 * D_den) := by
        have : (0 : ℝ) ≤ 1 + ((k1 : ℝ) + 1) / 128 := by positivity
        nlinarith
