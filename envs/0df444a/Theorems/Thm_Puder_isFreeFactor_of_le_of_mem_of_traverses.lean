namespace Puder

theorem isFreeFactor_of_le_of_mem_of_traverses {d : ℕ} (H J : Subgroup (FreeGroup (Fin d)))
    (hHJ : H ≤ J)
    (hmem : ∀ g ∈ J, (∀ (i : ℕ) (y : FreeGroup (Fin d)) (x : Fin d), Traverses J g i y x →
        ∃ h ∈ H, ∃ j : ℕ, Traverses J h j y x) → g ∈ H) :
    IsFreeFactor H J := by
  sorry

end Puder
