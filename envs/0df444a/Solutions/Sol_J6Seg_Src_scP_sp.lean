section bs
variable (G : Fin HS → List ℤ) (a13 a14 a15 a30 a31 a32 a33 a43 a44 : List ℤ) (v : List ℤ)

theorem bS_free {i : Fin HS} (h : Free i) : bS G a13 a14 a15 a30 a31 a32 a33 a43 a44 i = G i := by
  obtain ⟨-, h1, h2, h3, h4, h5, h6, h7, h8, h9⟩ := h
  simp [bS, update_apply, h1, h2, h3, h4, h5, h6, h7, h8, h9]

theorem bS_self : bS G (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33) (G 43) (G 44) = G := by
  simp only [bS, update_eq_self]
end bs

/-! ## Steps -/

theorem clean_of_regs' {e : Ex HS} (h : ∀ i ∈ e.regs, i.val < 56) : e.Clean :=
  fun i hi => clean_of_lt (h i hi) i (by simp [Ex.regs])

theorem bnd_P {σ : IState HS} {A D : ℕ} {e : Ex HS} (hR : RB σ A e) (hA : 2 ≤ A)
    (hp : Poly e = true) (hd : J6Seg.PreT.dg e ≤ D) : e.Bnd σ (A * D + 1) :=
  bnd_of_mg σ (fun _ => 2 ^ A) (A * D + 1) e hR (mg_lt (fun _ => le_rfl) hA hp hd)

theorem zsz_le_AD {a : ℤ} {A D : ℕ} (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) : zsz a ≤ A * D + 1 := by
  apply NLogN.zsz_le_of_abs
  have : (2 : ℤ) ^ A < 2 ^ (A * D + 1) :=
    pow_lt_pow_right₀ (by norm_num) (by nlinarith)
  linarith

theorem pushP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {e : Ex HS} {v : ℤ} {A D : ℕ}
    (hi : i.val < 56) (hc : ∀ j ∈ e.regs, j.val < 56) (hok : e.ok (encK s F))
    (hv : e.eval (encK s F) = v) (hR : RB (encK s F) A e) (hA : 2 ≤ A) (hp : Poly e = true)
    (hd : J6Seg.PreT.dg e ≤ D) :
    Sp (.push i e) (encK s F) (encK s (update F i (v :: F i))) ((e.size + 1) * uC A D) := by
  have h := Sp.pushQ s F hi (clean_of_regs' hc) hok (bnd_P hR hA hp hd)
  rw [hv] at h
  refine h.mono (le_of_eq ?_)
  unfold uC; ring

theorem popP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {A D : ℕ}
    (hi : i.val < 56) (hf : F i = a :: l) (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) :
    Sp (.pop i) (encK s F) (encK s (update F i l)) (uC A D) := by
  refine (Sp.pop s F hi hf (zsz_le_AD ha hD)).mono ?_
  unfold uC; nlinarith

theorem topv {s : IState HS} {F : Fin HS → List ℤ} {i : Fin HS} {a : ℤ} {l : List ℤ}
    (h : F i = a :: l) : (encK s F).top i = a := top_encK h

theorem encK_rebase (s : IState HS) (F : Fin HS → List ℤ) (C : Fin HS) :
    encK s F = encK (encK s (update (fun _ => []) C (F C))) (update F C []) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = C
  · subst h; simp [ints]
  · simp [h, ints]

end J6Seg.Src

