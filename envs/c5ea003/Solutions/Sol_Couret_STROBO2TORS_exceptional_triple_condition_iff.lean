/-! ## Exceptional offsets for a fixed nonzero 2-torsion direction

This section identifies and counts possible DIFFERENCES b-a for a fixed
direction d. These offset counts are separate from the global fibre counts
proved in Strobo2TorsEnumeration and the exceptional zero-free counts proved
in Strobo2TorsZeroFree. An offset count alone is not a count of fibres.
-/









theorem triple_sum_two_torsion_shift (w d : G) (hd : d + d = 0) :
    ((w + d) + (w + d)) + (w + d) = ((w + w) + w) + d := by
  calc
    ((w + d) + (w + d)) + (w + d) =
        ((w + w) + w) + ((d + d) + d) := by abel
    _ = ((w + w) + w) + d := by rw [hd]; simp

/-- The exceptional difference condition is a translated 3-torsion condition. -/
theorem p2m_local_exceptional_triple_condition_iff (v d : G) (hd : d + d = 0) :
    (((v + v) + v = 0) ∨ ((v + v) + v = d)) ↔
      ∃ w : G, (w + w) + w = 0 ∧ (v = w ∨ v = w + d) := by
  constructor
  · intro h
    rcases h with hzero | hdir
    · exact ⟨v, hzero, Or.inl rfl⟩
    · refine ⟨v - d, ?_, Or.inr ?_⟩
      · calc
          (((v - d) + (v - d)) + (v - d)) =
              ((v + v) + v) - ((d + d) + d) := by abel
          _ = d - d := by rw [hdir, hd]; simp
          _ = 0 := sub_self d
      · abel
  · rintro ⟨w, hw, h | h⟩
    · left; rw [h]; exact hw
    · right
      rw [h, triple_sum_two_torsion_shift w d hd, hw]
      simp











end Finite
end Couret.STROBO2TORS



