    NLogN.KFV.qB [((2 ^ b : ℕ) : ℤ)]) (by decide) (cl sC)
    ((hC.pow2 hc).encK fun x hx => by
      have := (sC.2 x hx); simp [Function.update_apply, this.1, this.2.1])
    (by simp [Function.update_apply, o0_ne _ (show qZ ≠ 0 by decide), show ¬ qZ = qX by decide,
      show ¬ qZ = NLogN.KFV.qB by decide])
  refine (FSp.of_norep (by simp [mvPush, norep]) (P1.seq (P2.seq P3))).mono ?_
  simp only [Ex.size]; nlinarith

