    rw [IState.top_eq (L := L1) (a := R.length)]
    · positivity
    · rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  hw := by simp (config := {decide := true}) [recBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
  step := by
    intro j hj
    have e : (Ex.reg (S := HS) 1).eval (passSt k s R Rest 0) = R.length := by
      simp only [Ex.eval]
      rw [IState.top_eq (L := L1) (a := R.length)]
      rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
    rw [e, Int.toNat_natCast] at hj ⊢
    exact (pass_step w k s R Rest hR hw L52 h52 _ j hj _).2

theorem passP_spec (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L52 : List Item)
    (h0 : s.G 0 = ints R.flatten ++ Rest)
    (h1 : s.G 1 = .int R.length :: L1) (h52 : s.G 52 = .int (2 ^ k) :: L52) :
    (NLogN.passP w).ok s ∧ (NLogN.passP w).run s = s.upd 0 (ints (radixPass k R).flatten ++ Rest) := by
  have H := pass_states w k s R Rest hR hw L1 L52 h1 h52
  have e1 : (Ex.reg (S := HS) 1).eval (passSt k s R Rest 0) = R.length := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L1) (a := R.length)]
    rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have hz := passSt_zero k s R Rest h0
  have hloop : (passLoop w).run (passSt k s R Rest 0) = passSt k s R Rest R.length := by
    rw [passLoop, H.run, e1, Int.toNat_natCast]
  have hlok : (passLoop w).ok (passSt k s R Rest 0) := by
    refine H.ok (by decide) (clean_of_lt (by decide)) ?_ ?_
    · apply IState.isInt_of (L := L1) (a := R.length)
      rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
    · intro j hj
      rw [e1, Int.toNat_natCast] at hj ⊢
      exact (pass_step w k s R Rest hR hw L52 h52 _ j hj _).1
  set t3 := passSt k s R Rest R.length with ht3
  set ones := R.filter (keyBit k)
  set zeros := R.filter (fun r => !keyBit k r)
  have g46 : t3.G 46 = ints ones.flatten.reverse ++ s.G 46 := by
    rw [ht3, passSt_G46, List.take_length]
  have g48 : t3.G 48 = .int ones.flatten.length :: s.G 48 := by
    rw [ht3, passSt_G48, List.take_length]
  have g0 : t3.G 0 = Rest := by rw [ht3, passSt_G0]; simp
  have m1 := mvK_spec (X := 46) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (.reg 48) (clean_of_lt (by decide)) t3 ones.flatten.reverse (s.G 46)
    g46 (IState.isInt_of g48) (by simp [Ex.eval, IState.top_eq g48])
  set t4 := (t3.upd 46 (s.G 46)).upd 0 ((ints ones.flatten.reverse).reverse ++ t3.G 0) with ht4
  have g47 : t4.G 47 = ints zeros.flatten.reverse ++ s.G 47 := by
    simp only [ht4, IState.upd_G]
    simp (config := {decide := true}) [ht3, passSt_G47, List.take_length]; rfl
  have g49 : t4.G 49 = .int zeros.flatten.length :: s.G 49 := by
    simp only [ht4, IState.upd_G]
    simp (config := {decide := true}) [ht3, passSt_G49, List.take_length]; rfl
  have g40 : t4.G 0 = ints ones.flatten ++ Rest := by
    simp [ht4, g0, ints_reverse]
  have m2 := mvK_spec (X := 47) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (.reg 49) (clean_of_lt (by decide)) t4 zeros.flatten.reverse (s.G 47)
    g47 (IState.isInt_of g49) (by simp [Ex.eval, IState.top_eq g49])
  set t5 := (t4.upd 47 (s.G 47)).upd 0 ((ints zeros.flatten.reverse).reverse ++ t4.G 0) with ht5
  have g549 : t5.G 49 = .int zeros.flatten.length :: s.G 49 := by
    simp only [ht5, IState.upd_G]; simp (config := {decide := true}) [g49]
  have g548 : t5.G 48 = .int ones.flatten.length :: s.G 48 := by
    simp only [ht5, ht4, IState.upd_G]; simp (config := {decide := true}) [g48]
  have hrun : (NLogN.passP w).run s = (pop 48).run ((pop 49).run t5) := by
    simp only [NLogN.passP, run_seq]
    rw [← hz, hloop, m1.2, m2.2]
  refine ⟨?_, ?_⟩
  · refine ⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩,
      ⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩
    rw [← hz]
    refine ⟨hlok, ?_⟩
    rw [hloop]
    refine ⟨m1.1, ?_⟩
    rw [m1.2]
    refine ⟨m2.1, ?_⟩
    rw [m2.2]
    refine ⟨⟨by decide, IState.isInt_of g549⟩, by decide, ?_⟩
    apply IState.isInt_of (L := s.G 48) (a := ones.flatten.length)
    simp only [run_pop_G]; simp (config := {decide := true}) [g548]
  · rw [hrun]
    apply run_ext _ (by simp [ht5, ht4, ht3, passSt]) (by simp [ht5, ht4, ht3, passSt])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x0 : x = 0
    · subst x0
      simp (config := {decide := true}) [ht5, g40, radixPass, ints_append, ints_reverse]; rfl
    by_cases x48 : x = 48
    · subst x48; simp (config := {decide := true}) [g548]
    by_cases x49 : x = 49
    · subst x49; simp (config := {decide := true}) [g549]
    simp only [if_neg x0, if_neg x48, if_neg x49]
    by_cases x47 : x = 47
    · subst x47; simp (config := {decide := true}) [ht5]
    by_cases x46 : x = 46
    · subst x46; simp (config := {decide := true}) [ht5, ht4]
    simp only [ht5, ht4, IState.upd_G, if_neg x0, if_neg x47, if_neg x46]
    rw [ht3, passSt_G_other _ _ _ _ _ _ x0 x46 x47 x48 x49]

theorem sortSt_G_other (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (k : ℕ) (x : Fin HS)
    (h0 : x ≠ 0) (h52 : x ≠ 52) : (sortSt s R Rest k).G x = s.G x := by
  simp [sortSt, h0, h52]

theorem sort_step (w : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 : List Item)
    (h1 : s.G 1 = .int R.length :: L1) (S0 : IState HS) (N k : ℕ) :
    (sortBody w).ok (withCtr 53 S0 N k (sortSt s R Rest k)) ∧
    (sortBody w).run (withCtr 53 S0 N k (sortSt s R Rest k)) =
      withCtr 53 S0 N k (sortSt s R Rest (k + 1)) := by
  generalize ht : withCtr 53 S0 N k (sortSt s R Rest k) = t
  have hp := radixSort_perm k R
  have tG : ∀ x, x ≠ 53 → t.G x = (sortSt s R Rest k).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t0 : t.G 0 = ints (radixSort k R).flatten ++ Rest := by
    rw [tG 0 (by decide)]; simp [sortSt]
  have t1 : t.G 1 = .int (radixSort k R).length :: L1 := by
    rw [tG 1 (by decide), sortSt_G_other _ _ _ _ _ (by decide) (by decide), h1, hp.length_eq]
  have t52 : t.G 52 = .int (2 ^ k) :: s.G 52 := by
    rw [tG 52 (by decide)]; simp [sortSt]
  have hP := passP_spec w k t (radixSort k R) Rest
    (fun r hr => hR r (hp.subset hr)) hw L1 (s.G 52) t0 t1 t52
  have u52 : (t.upd 0 (ints (radixPass k (radixSort k R)).flatten ++ Rest)).G 52 =
      .int (2 ^ k) :: s.G 52 := by
    simp only [IState.upd_G]; simp (config := {decide := true}) [t52]
  refine ⟨⟨hP.1, ?_⟩, ?_⟩
  · rw [hP.2]
    refine ⟨by decide, ?_, ⟨IState.isInt_of u52, trivial, 1, by simp [Ex.eval]⟩,
      IState.isInt_of u52⟩
    intro i hi; simp [Ex.regs] at hi; subst hi; decide
  · rw [sortBody, run_seq, hP.2]
    apply run_ext _ (by rw [← ht]; simp [withCtr, sortSt]) (by rw [← ht]; simp [withCtr, sortSt])
    intro x
    rw [run_asg_G]
    by_cases x53 : x = 53
    · subst x53
      rw [← ht]; simp only [IState.upd_G, withCtr_G]; simp (config := {decide := true})
    rw [withCtr_G_ne _ _ _ _ x53]
    by_cases x52 : x = 52
    · subst x52
      simp only [IState.upd_G]
      simp (config := {decide := true}) [sortSt, Ex.eval, IState.top_eq u52, pow_succ, t52]
    by_cases x0 : x = 0
    · subst x0
      simp only [IState.upd_G]
      simp (config := {decide := true}) [sortSt, radixSort_succ]
    simp only [IState.upd_G, if_neg x0, if_neg x52]
    rw [tG x x53, sortSt_G_other _ _ _ _ _ x0 x52, sortSt_G_other _ _ _ _ _ x0 x52]

theorem sort_states (w kb : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L2 : List Item)
    (h1 : s.G 1 = .int R.length :: L1) (h2 : s.G 2 = .int kb :: L2) :
    RepStates 53 (.reg 2) (sortBody w) (sortSt s R Rest 0) (sortSt s R Rest) where
  nonneg := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L2) (a := kb)]
    · positivity
    · rw [sortSt_G_other _ _ _ _ _ (by decide) (by decide), h2]
  hw := by simp (config := {decide := true}) [sortBody, NLogN.passP, passLoop, recBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [sortSt_G_other _ _ _ _ _ (by decide) (by decide),
      sortSt_G_other _ _ _ _ _ (by decide) (by decide)]
  step := fun k _ => (sort_step w s R Rest hR hw L1 h1 _ _ k).2

theorem sortP_spec (w kb : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L2 : List Item)
    (h0 : s.G 0 = ints R.flatten ++ Rest)
    (h1 : s.G 1 = .int R.length :: L1) (h2 : s.G 2 = .int kb :: L2) :
    (sortP w).ok s ∧ (sortP w).run s = s.upd 0 (ints (radixSort kb R).flatten ++ Rest) := by
  have H := sort_states w kb s R Rest hR hw L1 L2 h1 h2
  have e2 : (Ex.reg (S := HS) 2).eval (sortSt s R Rest 0) = kb := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L2) (a := kb)]
    rw [sortSt_G_other _ _ _ _ _ (by decide) (by decide), h2]
  have hz : (push 52 (.lit 1)).run s = sortSt s R Rest 0 := by
    apply IState.ext' _ (by simp [sortSt]) (by simp [sortSt])
    intro x
    simp only [sortSt, IState.upd_G, run_push_G, Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0, radixSort]
    split_ifs <;> simp_all
  have hloop : (sortLoop w).run (sortSt s R Rest 0) = sortSt s R Rest kb := by
    rw [sortLoop, H.run, e2, Int.toNat_natCast]
  have g52 : (sortSt s R Rest kb).G 52 = .int (2 ^ kb) :: s.G 52 := by simp [sortSt]
  refine ⟨⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩, ?_⟩
  · rw [hz]
    refine ⟨H.ok (by decide) (clean_of_lt (by decide)) ?_ ?_, ?_⟩
    · apply IState.isInt_of (L := L2) (a := kb)
      rw [sortSt_G_other _ _ _ _ _ (by decide) (by decide), h2]
    · intro k _
      exact (sort_step w s R Rest hR hw L1 h1 _ _ k).1
    · rw [hloop]; exact ⟨by decide, IState.isInt_of g52⟩
  · simp only [sortP, run_seq]
    rw [hz, hloop]
    apply run_ext _ (by simp [sortSt]) (by simp [sortSt])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x52 : x = 52
    · subst x52; simp (config := {decide := true}) [g52]
    simp only [if_neg x52]
    by_cases x0 : x = 0
    · subst x0; simp [sortSt]
    simp [sortSt, x0, x52]

theorem flatten_length_of {w : ℕ} : ∀ (R : List (List ℤ)), (∀ r ∈ R, r.length = w) →
    R.flatten.length = R.length * w
  | [], _ => by simp
  | r :: R, h => by
    simp only [List.flatten_cons, List.length_append, List.length_cons]
    rw [h r (by simp), flatten_length_of R (fun x hx => h x (by simp [hx]))]; ring

theorem zsz_nat_mono {a b : ℕ} (h : a ≤ b) : zsz (a : ℤ) ≤ zsz (b : ℤ) := zsz_natCast_le h

theorem branch_cost (w : ℕ) (Y Cn : Fin HS) (hY5 : Y.val < 56) (h0Y : (0 : Fin HS) ≠ Y)
    (hY51 : Y ≠ 51) (hC0 : Cn ≠ 0) (hCY : Cn ≠ Y) (t : IState HS) (r : List ℤ) (L : List Item)
    (tG0 : t.G 0 = ints r ++ L) (hlen : r.length = w) (c : ℕ) (LC : List Item)
    (tC : t.G Cn = .int c :: LC) (B : ℕ) (hr : Bnd B r) (hBw : zsz (w : ℤ) ≤ B)
    (hBc : zsz ((c + w : ℕ) : ℤ) ≤ B) :
    (NLogN.RS.seq (mvK 0 Y 51 (.lit w)) (asg Cn (.add (.reg Cn) (.lit w)))).cost t ≤
      w * (14000 * (B + 2)) + 12000 * (B + 2) + 32 := by
  have hm := mvK_spec h0Y (by decide) hY51 (by decide) hY5 (by decide) (.lit w)
      (by intro i hi; simp [Ex.regs] at hi) t r _ tG0 trivial (by simp [Ex.eval, hlen])
  have hc := mvK_cost (C := 51) h0Y (by decide) hY51 (.lit w) t r L tG0 (by simp [Ex.eval, hlen]) B
    hr trivial (by simpa [Ex.Bnd] using hBw)
  have hcB : zsz (c : ℤ) ≤ B := le_trans (zsz_nat_mono (by omega)) hBc
  have u : ((mvK 0 Y 51 (.lit w)).run t).G Cn = .int c :: LC := by
    rw [hm.2]; simp only [IState.upd_G, if_neg hC0, if_neg hCY, tC]
  have ha := asgCost_le_lin Cn (.add (.reg Cn) (.lit w)) ((mvK 0 Y 51 (.lit w)).run t) B
    (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, Ex.eval, IState.top_eq u]; exact ⟨hcB, hBw, by exact_mod_cast hBc⟩)
    (by rw [IState.top_eq u]; exact hcB)
  have hs : (Ex.add (S := HS) (.reg Cn) (.lit w)).size = 3 := rfl
  have hs' : (Ex.lit (S := HS) (w : ℤ)).size = 1 := rfl
  rw [hs] at ha; rw [hs', hlen] at hc
  simp only [RS.cost]
  nlinarith

theorem zsz_two_HS : zsz (2 : ℤ) = 2 := by
  rw [show (2 : ℤ) = 2 ^ 1 by norm_num, NLogN.zsz_two_pow]

theorem filter_take_flat_le (w : ℕ) (R : List (List ℤ)) (hR : ∀ r ∈ R, r.length = w) (j : ℕ)
    (p : List ℤ → Bool) : ((R.take j).filter p).flatten.length ≤ j * w := by
  rw [flatten_length_of _ (fun r hr => hR r (List.mem_of_mem_take (List.mem_of_mem_filter hr)))]
  have h1 := List.length_filter_le p (R.take j)
  have h2 : (R.take j).length ≤ j := by simp
  exact Nat.mul_le_mul_right _ (h1.trans h2)

theorem pass_body_cost (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L52 : List Item)
    (h52 : s.G 52 = .int (2 ^ k) :: L52) (N j : ℕ) (hj : j < R.length) (S0 : IState HS)
    (B : ℕ) (hBe : ∀ r ∈ R, Bnd B r) (hBN : zsz ((R.length * w : ℕ) : ℤ) ≤ B)
    (hBk : k + 2 ≤ B) (hBw : zsz (w : ℤ) ≤ B) :
    (recBody w).cost (withCtr 50 S0 N j (passSt k s R Rest j)) ≤
      w * (14000 * (B + 2)) + 25000 * (B + 2) := by
  have hd : R.drop j = R[j] :: R.drop (j + 1) := List.drop_eq_getElem_cons hj
  have hlen : R[j].length = w := hR _ (List.getElem_mem hj)
  have hBr : Bnd B R[j] := hBe _ (List.getElem_mem hj)
  obtain ⟨a, r', hr⟩ : ∃ a r', R[j] = a :: r' := by
    rcases h : R[j] with _ | ⟨a, r'⟩
    · rw [h] at hlen; simp at hlen; omega
    · exact ⟨a, r', rfl⟩
  have hBa : zsz a ≤ B := hBr a (by rw [hr]; simp)
  generalize ht : withCtr 50 S0 N j (passSt k s R Rest j) = t
  have tG : ∀ x, x ≠ 50 → t.G x = (passSt k s R Rest j).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have tG0 : t.G 0 = ints R[j] ++ (ints (R.drop (j + 1)).flatten ++ Rest) := by
    rw [tG 0 (by decide), passSt_G0, hd, List.flatten_cons, ints_append, List.append_assoc]
  have tG0' : t.G 0 = .int a :: (ints r' ++ (ints (R.drop (j + 1)).flatten ++ Rest)) := by
    rw [tG0, hr]; rfl
  have tG52 : t.G 52 = .int (2 ^ k) :: L52 := by
    rw [tG 52 (by decide), passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide)
      (by decide) (by decide), h52]
  have t52 : t.top 52 = 2 ^ k := IState.top_eq tG52
  have hcB : bitE.Bnd t B := by
    simp only [bitE, Ex.Bnd, IState.top_eq tG0', t52, NLogN.zsz_two_pow, zsz_two_HS]
    exact ⟨⟨hBa, by omega⟩, by omega⟩
  have hcc := Ex.cost_le_lin t B bitE (by simp [bitE, Ex.Lin]) hcB
  have hcz := Ex.zsz_eval_le t B bitE hcB
  have hsz : bitE.size = 6 := rfl
  rw [hsz] at hcc
  have hNw : (j + 1) * w ≤ R.length * w := Nat.mul_le_mul_right _ (by omega)
  have b1 := branch_cost w 46 48 (by decide) (by decide) (by decide) (by decide) (by decide) t
    R[j] _ tG0 hlen _ (s.G 48) (by rw [tG 48 (by decide), passSt_G48]) B hBr hBw
    (le_trans (zsz_nat_mono (by have := filter_take_flat_le w R hR j (keyBit k); nlinarith)) hBN)
  have b2 := branch_cost w 47 49 (by decide) (by decide) (by decide) (by decide) (by decide) t
    R[j] _ tG0 hlen _ (s.G 49) (by rw [tG 49 (by decide), passSt_G49]) B hBr hBw
    (le_trans (zsz_nat_mono (by
      have := filter_take_flat_le w R hR j (fun r => !keyBit k r); nlinarith)) hBN)
  rw [recBody, RS.cost]
  simp only [moveCost]
  split_ifs <;> nlinarith

theorem cost_seq (a b : RS) (s : IState HS) : (NLogN.RS.seq a b).cost s = a.cost s + b.cost (a.run s) := rfl

theorem cost_push_lit0 (i : Fin HS) (s : IState HS) : (push i (.lit 0)).cost s = 103 := by
  simp [RS.cost, Ex.cost, Ex.eval, zsz_zero, moveCost]

theorem cost_pop (i : Fin HS) (s : IState HS) : (pop i).cost s = 2 * zsz (s.top i) + 2 := rfl

theorem passP_cost (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L52 : List Item)
    (h0 : s.G 0 = ints R.flatten ++ Rest)
    (h1 : s.G 1 = .int R.length :: L1) (h52 : s.G 52 = .int (2 ^ k) :: L52)
    (B : ℕ) (hBe : ∀ r ∈ R, Bnd B r) (hBN : zsz ((R.length * w : ℕ) : ℤ) ≤ B)
    (hBk : k + 2 ≤ B) (hBw : zsz (w : ℤ) ≤ B) :
    (NLogN.passP w).cost s ≤ 100000 * (R.length * w + 1) * (B + 2) := by
  have H := pass_states w k s R Rest hR hw L1 L52 h1 h52
  have e1 : (Ex.reg (S := HS) 1).eval (passSt k s R Rest 0) = R.length := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L1) (a := R.length)]
    rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have hz := passSt_zero k s R Rest h0
  have hloop : (passLoop w).run (passSt k s R Rest 0) = passSt k s R Rest R.length := by
    rw [passLoop, H.run, e1, Int.toNat_natCast]
  have hNB : zsz (R.length : ℤ) ≤ B := le_trans (zsz_nat_mono (by nlinarith)) hBN
  have hlc := H.cost_le_lin B (w * (14000 * (B + 2)) + 25000 * (B + 2)) (by simp [Ex.Lin])
    (by simp only [Ex.Bnd]; rw [← Ex.eval, e1]; exact hNB) (by
      intro j hj
      rw [e1, Int.toNat_natCast] at hj ⊢
