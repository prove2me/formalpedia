-- title:
--   Axioms PSW1–PSW6 on the likelihood relation $\succeq_{\Theta_w}$
-- statement:
--   A small world satisfies the **likelihood axioms** when:
--
--   1. **(PSW1)** $\succeq_\Theta$ is complete and transitive on $Q\cup\mathcal B$;
--   2. **(PSW2)** for open or closed reference intervals $I,J$, $I\succeq_\Theta J\iff \ell_I\ge\ell_J$;
--   3. **(PSW3)** on $Q$: every event $R\succeq_\Theta\emptyset$, $\Theta\succ_\Theta\emptyset$, and $R\succeq_\Theta S\iff R\cup T\succeq_\Theta S\cup T$ whenever $R\cap T=\emptyset=S\cap T$;
--   4. **(PSW4)** the same on $\mathcal B$, with $[0,1]\succ_\Theta\emptyset$;
--   5. **(PSW5)** $\Theta\sim_\Theta[0,1]$, and for $R,S\in Q$, $E,F\in\mathcal B$ with $R\cap S=\emptyset=E\cap F$: if $R\succeq E$ and $S\succeq F$ then $R\cup S\succeq E\cup F$, and if $E\succeq R$ and $F\succeq S$ then $E\cup F\succeq R\cup S$;
--   6. **(PSW6)** for every event $R$, the sets $\{\pi\in[0,1]:[0,\pi]\succeq_\Theta R\}$ and $\{\pi\in[0,1]:R\succeq_\Theta[0,\pi]\}$ are closed;
--   7. the empty event of $\Theta$ and the empty reference event are equally likely.
--
--   These axioms say that the decision maker's likelihood judgements are a qualitative probability on each of $Q$ and $\mathcal B$, uniform on $\mathcal B$, and consistently comparable between the two, without forming the σ-field generated by both.
--
--   **Formalization Note** Item 7 is not one of the paper's axioms: it encodes that $\emptyset$ is a single element of the set union $Q\cup\mathcal B$, whereas the Lean domain is the disjoint sum. The strict form of PSW5(b) is the separate correction `CorrectionC1`.
-- source:
--   French, Axiomatising the Bayesian Paradigm in Parallel Small Worlds, author's accepted manuscript OPRE-2018-05-258 (WRAP 118263), Axioms PSW1–PSW6, pp.20–22 (PDF pp.21–23)

import Mathlib
import Definitions.Def_ParallelSmallWorlds_SEU_SmallWorld

namespace ParallelSmallWorlds.SEU

open SmallWorld

/-- **Axioms PSW1–PSW6 on the likelihood relation `⪰Θw`, as printed.**
S. French, *Axiomatising the Bayesian Paradigm in Parallel Small Worlds*, author's accepted
manuscript OPRE-2018-05-258 (WRAP 118263), Axioms PSW1–PSW6, pp.20–22 (PDF pp.21–23).

* **PSW1** (p.20): `⪰Θw` is a weak order (complete and transitive) on `Qw ∪ B`.
* **PSW2** (p.20): for open or closed intervals `I, J` in `B`, `I ⪰Θw J ⟺ ℓI ≥ ℓJ`.
* **PSW3** (p.21): on `Qw`, (a) `R ⪰Θw ∅` and `Θw ≻Θw ∅`; (b) for `R ∩ T = ∅ = S ∩ T`,
  `R ⪰Θw S ⟺ R ∪ T ⪰Θw S ∪ T`.
* **PSW4** (p.21): the same on `B`, with `[0,1] ≻Θw ∅`.
* **PSW5** (p.21): (a) `Θw ∼Θw [0,1]`; (b) for `R, S ∈ Qw`, `E, F ∈ B` with
  `R ∩ S = ∅ = E ∩ F`: `(R ⪰ E, S ⪰ F) ⇒ R ∪ S ⪰ E ∪ F` and `(E ⪰ R, F ⪰ S) ⇒ E ∪ F ⪰ R ∪ S`.
* **PSW6** (p.22): for `R ∈ Qw`, `{π ∈ [0,1] | [0,π] ⪰Θw R}` and `{π ∈ [0,1] | R ⪰Θw [0,π]}`
  are closed.

The field `empty_identified` says `∅_Θ ∼Θw ∅_B`.

**Formalization Note.** `empty_identified` is an encoding, not an axiom of the paper: in the
paper's set union `Qw ∪ B` the empty set is one element, while the Lean domain is the disjoint
sum `Set Θ ⊕ Set ℝ` (reading R6). The disjoint sum also means that an event of `Θ` is never
identified with a reference event even when `Θ ⊆ ℝ`. The closed sets of PSW6 are subsets of
`unitInterval` (closed there iff closed in `ℝ`). The strict form of PSW5(b), which the proof of
Lemma 1 uses, is the separate correction `CorrectionC1`. -/
structure LikelihoodAxioms {Θ C : Type*} (W : SmallWorld Θ C) : Prop where
  /-- PSW1: `⪰Θw` is complete on `Qw ∪ B`. -/
  psw1_total : ∀ x ∈ W.LikDom, ∀ y ∈ W.LikDom, W.lik x y ∨ W.lik y x
  /-- PSW1: `⪰Θw` is transitive on `Qw ∪ B`. -/
  psw1_trans : ∀ x ∈ W.LikDom, ∀ y ∈ W.LikDom, ∀ z ∈ W.LikDom,
    W.lik x y → W.lik y z → W.lik x z
  /-- PSW2: open or closed intervals compare by length. -/
  psw2 : ∀ (I J : Set ℝ) (ℓI ℓJ : ℝ), IsRefInterval I ℓI → IsRefInterval J ℓJ →
    (W.lik (Sum.inr I) (Sum.inr J) ↔ ℓJ ≤ ℓI)
  /-- PSW3(a): every event is at least as likely as `∅`. -/
  psw3a_nonneg : ∀ R ∈ W.Q, W.lik (Sum.inl R) (Sum.inl ∅)
  /-- PSW3(a): `Θw ≻Θw ∅`. -/
  psw3a_pos : W.strictLik (Sum.inl Set.univ) (Sum.inl ∅)
  /-- PSW3(b): additivity of `⪰Θw` on `Qw`. -/
  psw3b : ∀ R ∈ W.Q, ∀ S ∈ W.Q, ∀ T ∈ W.Q, R ∩ T = ∅ → S ∩ T = ∅ →
    (W.lik (Sum.inl R) (Sum.inl S) ↔ W.lik (Sum.inl (R ∪ T)) (Sum.inl (S ∪ T)))
  /-- PSW4(a): every reference event is at least as likely as `∅`. -/
  psw4a_nonneg : ∀ E ∈ RefEvents, W.lik (Sum.inr E) (Sum.inr ∅)
  /-- PSW4(a): `[0,1] ≻Θw ∅`. -/
  psw4a_pos : W.strictLik (Sum.inr (Set.Icc 0 1)) (Sum.inr ∅)
  /-- PSW4(b): additivity of `⪰Θw` on `B`. -/
  psw4b : ∀ E ∈ RefEvents, ∀ F ∈ RefEvents, ∀ G ∈ RefEvents, E ∩ G = ∅ → F ∩ G = ∅ →
    (W.lik (Sum.inr E) (Sum.inr F) ↔ W.lik (Sum.inr (E ∪ G)) (Sum.inr (F ∪ G)))
  /-- PSW5(a): `Θw ∼Θw [0,1]`. -/
  psw5a : W.indiffLik (Sum.inl Set.univ) (Sum.inr (Set.Icc 0 1))
  /-- PSW5(b), first implication. -/
  psw5b_ge : ∀ R ∈ W.Q, ∀ S ∈ W.Q, ∀ E ∈ RefEvents, ∀ F ∈ RefEvents, R ∩ S = ∅ → E ∩ F = ∅ →
    W.lik (Sum.inl R) (Sum.inr E) → W.lik (Sum.inl S) (Sum.inr F) →
    W.lik (Sum.inl (R ∪ S)) (Sum.inr (E ∪ F))
  /-- PSW5(b), second implication. -/
  psw5b_le : ∀ R ∈ W.Q, ∀ S ∈ W.Q, ∀ E ∈ RefEvents, ∀ F ∈ RefEvents, R ∩ S = ∅ → E ∩ F = ∅ →
    W.lik (Sum.inr E) (Sum.inl R) → W.lik (Sum.inr F) (Sum.inl S) →
    W.lik (Sum.inr (E ∪ F)) (Sum.inl (R ∪ S))
  /-- PSW6: the two sets bracketing `πR` are closed. -/
  psw6 : ∀ R ∈ W.Q,
    IsClosed {π : unitInterval | W.lik (Sum.inr (Set.Icc 0 (π : ℝ))) (Sum.inl R)} ∧
    IsClosed {π : unitInterval | W.lik (Sum.inl R) (Sum.inr (Set.Icc 0 (π : ℝ)))}
  /-- Encoding of the set union `Qw ∪ B` (one empty set): `∅_Θ ∼Θw ∅_B`. -/
  empty_identified : W.lik (Sum.inl ∅) (Sum.inr ∅) ∧ W.lik (Sum.inr ∅) (Sum.inl ∅)

end ParallelSmallWorlds.SEU


