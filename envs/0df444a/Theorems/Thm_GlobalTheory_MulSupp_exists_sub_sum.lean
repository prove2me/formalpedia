theorem GlobalTheory.MulSupp.exists_sub_sum {N : Type} (a : LB.Sec (LB.LinComb L φ ε)) (p : N → LB.Sec (LB.LinComb L φ ε)) (s : Finset N) :
    ∃ d : LB.Sec (LB.LinComb L φ ε), ∀ (Z : Scheme.{0}) (r : Z ⟶ Y) (z : Z) (J), Good L z J →
