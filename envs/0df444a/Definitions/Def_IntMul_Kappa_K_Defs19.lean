-- Source module: Solutions.KFNPhase
/-!
# KFN: a linear-time phase pass on a blocked stream

`phL R0 t B u aE` multiplies the `B · (R0 · 2^t)` Gaussian entries on top of the data stack by
`i^{E}`, where the exponent of entry `q` is read from the table
`tblG (replicate R0 (u mod 4)) aE t` (built by `t` doublings, `KFG.dblP`) at position
`q mod (R0 · 2^t)`:
`E = u + Σ_{p<t} aE p · ⌊q / R0 / 2^p⌋ mod 2` (`getD_tblR`).

Steps: build the table (`R0` pushes and `t` doublings, `O(R0 2^t)`), then for each of the `B`
blocks one multiply loop (`KFG.mulB`, table `xA → xB`, results to `qO`) and one move of the table
back (`xB → xA`); finally drop the table and move the results back to the data stack.
Cost `O(B · R0 2^t · (w + 1) + (t + B) (Z + 1))` (`phL_fsp`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG Complex

/-- The counter of the block loop. -/
abbrev cO : Fin HS := 46

/-! ## Tables -/

/-- The table after `t` doublings of `T0`. -/
def tblG (T0 : List ℤ) (aE : ℕ → ℕ) : ℕ → List ℤ
  | 0 => T0
  | t + 1 => dblL ((aE t % 4 : ℕ) : ℤ) (tblG T0 aE t)

/-! ## Building the table -/

/-- `R0` copies of `v` on `xA`. -/
def initP (R0 : ℕ) (v : ℤ) : RS := .rep NLogN.KFB.c1 (.lit (R0 : ℤ)) (.push xA (.lit v))

/-- `t` doublings. -/
def cTblG (M t Z : ℕ) : ℕ := 120000 * M * 2 ^ t + t * (10000 * (Z + 2) + 20001) + 1

/-! ## The multiply loop with a nonempty result stack -/

/-! ## One block -/

/-- One block: multiply by the table, then move the table back. -/
def blkP : RS := .seq (.rep NLogN.KFB.c1 (.reg xN) mulB) (NLogN.mvK xB xA NLogN.KFB.c1 (.reg xN))

/-- Cost of one block of `M` entries. -/
def cBlk (w M Z : ℕ) : ℕ := M * (cMulB w + 5000) + 1000 * (Z + 2) + 5000

/-! ## All blocks -/

/-- `B` copies of the table. -/
def repT (B : ℕ) (T : List ℤ) : List ℤ := (List.replicate B T).flatten

/-! ## The phase pass -/

/-- **The phase pass** on the `B · R0 · 2^t` entries on top of the data stack. -/
def phL (R0 t B u : ℕ) (aE : ℕ → ℕ) : RS :=
  .seq (initP R0 ((u % 4 : ℕ) : ℤ))
  (.seq (.push xN (.lit (R0 : ℤ)))
  (.seq (tblP aE t)
  (.seq (.rep NLogN.KFN.cO (.lit (B : ℤ)) blkP)
  (.seq (NLogN.mvK xA xB NLogN.KFB.c1 (.reg xN))
  (.seq (.rep NLogN.KFB.c1 (.reg xN) (.pop xB))
  (.seq (.asg xN (.lit ((2 * (B * (R0 * 2 ^ t)) : ℕ) : ℤ)))
  (.seq (NLogN.mvK qO 0 NLogN.KFB.c1 (.reg xN)) (.pop xN))))))))

/-- Cost of the phase pass on `V = B · R0 · 2^t` entries. -/
def cPhL (w V t B Z : ℕ) : ℕ := V * (cMulB w + 300000 + 500 * w) + (t + B + 10) * (20000 * (Z + 2) + 30000)

/-- The rotated stream. -/
noncomputable def phOut (R0 t B u : ℕ) (aE : ℕ → ℕ) (zs : List GI) : List GI :=
  KFG.mulL (repT B (tblG (List.replicate R0 ((u % 4 : ℕ) : ℤ)) aE t)) zs

end NLogN.KFN

end

