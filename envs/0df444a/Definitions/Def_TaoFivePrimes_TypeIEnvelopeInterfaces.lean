open scoped ArithmeticFunction.vonMangoldt ArithmeticFunction.Moebius
open ArithmeticFunction
namespace TaoFivePrimes
noncomputable def arithmeticRestrictLE (B : ℕ)
    (f : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  ⟨fun n => if n ≤ B then f n else 0, by simp⟩
noncomputable def arithmeticRestrictGT (B : ℕ)
    (f : ArithmeticFunction ℝ) : ArithmeticFunction ℝ :=
  ⟨fun n => if B < n then f n else 0, by simp⟩
noncomputable def vaughanHalfLog : ArithmeticFunction ℝ :=
  ⟨fun n => (1 / 2 : ℝ) * Real.log n, by simp⟩
noncomputable def vaughanTruncatedHalfLog (V : ℕ) : ArithmeticFunction ℝ :=
  arithmeticRestrictGT V vaughanHalfLog
noncomputable def vaughanTypeIPart (U V : ℕ) : ArithmeticFunction ℝ :=
  arithmeticRestrictLE U (μ : ArithmeticFunction ℝ) *
      ArithmeticFunction.log -
    arithmeticRestrictLE U (μ : ArithmeticFunction ℝ) *
      arithmeticRestrictLE V ArithmeticFunction.vonMangoldt *
      (ArithmeticFunction.zeta : ArithmeticFunction ℝ) +
    arithmeticRestrictGT U (μ : ArithmeticFunction ℝ) *
      vaughanTruncatedHalfLog V
noncomputable def arithmeticWeightedSum (s : Finset ℕ)
    (A : ArithmeticFunction ℝ) (F : ℕ → ℂ) : ℂ :=
  ∑ n ∈ s, (A n : ℂ) * F n
noncomputable def eta0VaughanTest (x alpha : ℝ) (n : ℕ) : ℂ :=
  if n.Coprime 2 then
    expCircle (alpha * n) * (eta0 ((n : ℝ) / x) : ℂ)
  else 0
noncomputable def eta0VaughanTypeISum
    (x alpha U V : ℝ) : ℂ :=
  arithmeticWeightedSum (Finset.range (⌊x⌋₊ + 1))
    (vaughanTypeIPart ⌊U⌋₊ ⌊V⌋₊) (eta0VaughanTest x alpha)
end TaoFivePrimes
