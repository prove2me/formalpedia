-- title:
--   Canonical path space over $(\alpha,\beta)$ and the stopping times $T_X$
-- statement:
--   The state space is the interval $\mathcal I=(\alpha,\beta)$ with $-\infty\le\alpha<\beta\le\infty$. The canonical space $\Omega$ is the space of continuous trajectories $\omega:[0,\infty)\to\mathcal I$, with the coordinate process $X_t(\omega)=\omega(t)$ and the $\sigma$-field generated by the coordinates. $T_X$ is the set of all stopping times, valued in $[0,\infty]$, of the right-continuous filtration generated by $X$:
--
--   $$\tau\in T_X\iff \{\tau\le t\}\in\bigcap_{s>t}\sigma(X_u:u\le s)\quad\text{for all }t\ge0.$$
--
--   These objects carry the whole stopping problem: the decision maker observes $X$ and nothing else.
--
--   **Formalization Note** The endpoints are elements of `EReal`. The filtration is not augmented by null sets, as on the page.
-- source:
--   Décamps, Gensbittel & Mariotti, Investment Timing and Technological Breakthroughs, arXiv:2106.05112v1, §4.1, p.9

import Mathlib

open MeasureTheory
open scoped NNReal

namespace TechBreakthrough

/-- The state space `𝓘 = (α, β)`, `−∞ ≤ α < β ≤ ∞`, of the diffusion.
Décamps, Gensbittel & Mariotti, *Investment Timing and Technological Breakthroughs*,
arXiv:2106.05112v1, §4.1, p.9.

**Formalization Note** The endpoints live in `EReal`, so that both infinite and finite endpoints
are covered by one definition. -/
def stateSpace (α β : EReal) : Set ℝ := {x | α < (x : EReal) ∧ (x : EReal) < β}

/-- The canonical space of continuous trajectories in `𝓘`, arXiv:2106.05112v1, §4.1, p.9. -/
def PathSpace (α β : EReal) : Type := C(ℝ≥0, stateSpace α β)

/-- The canonical (coordinate) process `X_t(ω) = ω(t)`, arXiv:2106.05112v1, §4.1, p.9. -/
def canonicalProcess (α β : EReal) (t : ℝ≥0) (ω : PathSpace α β) : ℝ :=
  ((show C(ℝ≥0, stateSpace α β) from ω) t : ℝ)

/-- **Formalization Note** The σ-field `F` of the canonical space (arXiv:2106.05112v1, §4.1, p.9)
is the one generated by the coordinates. -/
instance (α β : EReal) : MeasurableSpace (PathSpace α β) :=
  ⨆ t : ℝ≥0, MeasurableSpace.comap (canonicalProcess α β t) inferInstance

theorem canonicalProcess_stronglyMeasurable (α β : EReal) (t : ℝ≥0) :
    StronglyMeasurable (canonicalProcess α β t) := by
  apply Measurable.stronglyMeasurable
  exact (Measurable.of_comap_le (le_iSup
    (fun t : ℝ≥0 => MeasurableSpace.comap (canonicalProcess α β t) inferInstance) t))

theorem canonicalProcess_continuous (α β : EReal) (ω : PathSpace α β) :
    Continuous fun t => canonicalProcess α β t ω :=
  continuous_subtype_val.comp (show C(ℝ≥0, stateSpace α β) from ω).continuous

/-- The right-continuous filtration generated by `X` over the canonical space, with no
augmentation by null sets, arXiv:2106.05112v1, §4.1, p.9. -/
noncomputable def rightContFiltration (α β : EReal) :
    Filtration ℝ≥0 (inferInstance : MeasurableSpace (PathSpace α β)) :=
  (Filtration.natural (canonicalProcess α β) (canonicalProcess_stronglyMeasurable α β)).rightCont

/-- The strategy space `T_X`: all stopping times of the right-continuous filtration generated by
`X`, valued in `ℝ₊ ∪ {∞}`, arXiv:2106.05112v1, §4.1, p.9. -/
def stoppingTimes (α β : EReal) : Set (PathSpace α β → WithTop ℝ≥0) :=
  {τ | IsStoppingTime (rightContFiltration α β) τ}

end TechBreakthrough


