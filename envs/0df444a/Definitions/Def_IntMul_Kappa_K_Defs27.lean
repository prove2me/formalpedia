-- Source module: Solutions.SynthModel
/-!
# The concrete ring `R_r = ℂ[y]/(y^r + 1)` is a coefficient model

`Rr n = AdjoinRoot (X^{n+1} + 1)` over `ℂ` (so `r = n + 1`), with `y` its root (a unit,
`y^r = -1`) and coefficients in the power basis `1, y, …, y^{r-1}`.
`rrModel n : CoeffModel (yU n) (n + 1)` — so every statement of `SynthNorm` applies to `R_r`.
-/

set_option linter.unusedSectionVars false

namespace Synth

open Polynomial Finset

/-- `ℂ[y]/(y^{n+1} + 1)`. -/
abbrev Rr (n : ℕ) := AdjoinRoot (X ^ (n + 1) + 1 : ℂ[X])

lemma monic_rr (n : ℕ) : (X ^ (n + 1) + 1 : ℂ[X]).Monic := by
  have := monic_X_pow_add_C (1 : ℂ) (Nat.succ_ne_zero n); simpa using this

lemma natDegree_rr (n : ℕ) : (X ^ (n + 1) + 1 : ℂ[X]).natDegree = n + 1 := by
  have := natDegree_X_pow_add_C (n := n + 1) (r := (1 : ℂ)); simpa using this

/-- The root `y`. -/
noncomputable def yR (n : ℕ) : Rr n := AdjoinRoot.root _

lemma yR_pow (n : ℕ) : Synth.yR n ^ (n + 1) = -1 := by
  have h := AdjoinRoot.mk_self (f := (X ^ (n + 1) + 1 : ℂ[X]))
  rw [map_add, map_pow, AdjoinRoot.mk_X, map_one] at h
  exact eq_neg_of_add_eq_zero_left h

/-- `y` as a unit: `y · (-y^n) = 1`. -/
noncomputable def yU (n : ℕ) : (Rr n)ˣ :=
  Units.mkOfMulEqOne (Synth.yR n) (-(Synth.yR n) ^ n) (by rw [mul_neg, ← pow_succ', yR_pow, neg_neg])

/-- The power basis `y^k`, indexed by `Fin (n+1)`. -/
noncomputable def rrBasis (n : ℕ) : Module.Basis (Fin (n + 1)) ℂ (Rr n) :=
  (AdjoinRoot.powerBasis' (monic_rr n)).basis.reindex (finCongr (by
    rw [AdjoinRoot.powerBasis'_dim, natDegree_rr]))

lemma rrBasis_apply (n : ℕ) (k : Fin (n + 1)) : rrBasis n k = Synth.yR n ^ (k : ℕ) := by
  simp [rrBasis, Module.Basis.reindex_apply, PowerBasis.basis_eq_pow, AdjoinRoot.powerBasis'_gen,
    Synth.yR]

/-- **`R_r` is a coefficient model.** -/
noncomputable def rrModel (n : ℕ) : CoeffModel (Synth.yU n) (n + 1) where
  pos := Nat.succ_pos n
  co := (rrBasis n).equivFun.toLinearMap
  inj := (rrBasis n).equivFun.injective
  co_one := by
    funext j
    have : (1 : Rr n) = rrBasis n 0 := by rw [rrBasis_apply]; simp
    simp only [LinearEquiv.coe_coe]
    rw [this, Module.Basis.equivFun_self, Pi.single_apply]
    by_cases hj : j = 0
    · subst hj; simp
    · rw [if_neg (Ne.symm hj), if_neg (fun h => hj (by rw [h]; rfl))]
  co_y := by
    intro z
    apply (rrBasis n).equivFun.symm.injective
    simp only [LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    rw [Module.Basis.equivFun_symm_apply]
    set c := (rrBasis n).equivFun z
    have hz : z = ∑ k, c k • rrBasis n k := by
      rw [← Module.Basis.equivFun_symm_apply, LinearEquiv.symm_apply_apply]
    show (Synth.yU n : Rr n) * z = _
    conv_lhs => rw [hz]
    simp only [rrBasis_apply, mul_sum, mul_smul_comm, ← pow_succ']
    have hyU : ((Synth.yU n : (Rr n)ˣ) : Rr n) = Synth.yR n := rfl
    rw [hyU]
    rw [Fin.sum_univ_castSucc, Fin.sum_univ_succ]
    simp only [Fin.val_last, yR_pow, Fin.val_castSucc, Fin.val_succ, Fin.val_zero, pow_zero]
    have h0 : cyc c 0 = -c (Fin.last n) := by simp [cyc, Fin.last]
    have hs : ∀ i : Fin n, cyc c i.succ = c i.castSucc := by
      intro i; simp only [cyc, Fin.val_succ]; rw [dif_neg (by omega)]; rfl
    simp only [h0, hs]
    rw [← pow_succ', yR_pow, add_comm]
    simp only [← pow_succ', smul_neg, neg_smul, one_smul]

end Synth

end

