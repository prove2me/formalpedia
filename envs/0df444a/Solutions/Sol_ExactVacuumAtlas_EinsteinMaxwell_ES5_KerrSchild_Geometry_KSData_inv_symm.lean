variable {b bi : Metric 5} {v : Pt 5 → ℝ} {k : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (i j : Fin 5) : bi i j x = bi j i x := by
  have hbT : (metricMatrix b x)ᵀ = metricMatrix b x := by
    ext p q
    simp [metricMatrix, hD.symm x hx q p]
  have h2 := hD.mul_inv hx
  have hT : (metricMatrix bi x)ᵀ = metricMatrix bi x := by
    calc (metricMatrix bi x)ᵀ = (metricMatrix bi x)ᵀ * (metricMatrix b x * metricMatrix bi x) := by
          rw [h2, Matrix.mul_one]
      _ = (metricMatrix b x * metricMatrix bi x)ᵀ * metricMatrix bi x := by
          rw [Matrix.transpose_mul, hbT, Matrix.mul_assoc]
      _ = metricMatrix bi x := by rw [h2, Matrix.transpose_one, Matrix.one_mul]
  have := congrFun (congrFun hT j) i
  simpa [metricMatrix] using this
