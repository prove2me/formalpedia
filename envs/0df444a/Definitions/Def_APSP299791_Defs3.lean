    Light.v AdrP7, Light.v AdrP10, Light.v AdrEncA] Light.Sec2.Shared.Void ;;
  .call pEncodeBandsP [Light.v Light.Sec2.Shared.Levels, Light.v Light.Sec2.Shared.Inner, Light.v Light.Sec2.Shared.Rows, Light.v Light.Sec2.Shared.Cols, Light.v Light.Sec2.Shared.Root, Light.v BlockRows, Light.v Strings, Light.v Light.Sec2.Shared.Leaves,
