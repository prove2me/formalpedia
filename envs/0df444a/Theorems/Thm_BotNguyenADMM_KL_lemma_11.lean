-- title:
--   Lemma 11 — cluster points of a bounded run are KKT points; ω is nonempty, connected, compact, with L_r ≡ F_* on it
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$, generated by Algorithm 1 or Algorithm 2, is bounded; let $\omega$ be its set of cluster points. Then:
--   1. if a subsequence $(x^{k_q},z^{k_q},y^{k_q})$ converges to $(\hat x,\hat z,\hat y)$, then $L_r(x^{k_q},z^{k_q},y^{k_q})\to L_r(\hat x,\hat z,\hat y)$;
--   2. $\omega\subseteq\mathrm{crit}(L_r)\subseteq\{(\hat x,\hat z,\hat y):-A^*\hat y=\nabla h(\hat x),\ \hat y\in\partial g(\hat z),\ \hat z=A\hat x\}$;
--   3. $\operatorname{dist}((x^k,z^k,y^k),\omega)\to0$;
--   4. $\omega$ is nonempty, connected and compact;
--   5. $L_r$ takes on $\omega$ the value $F_*=\lim_k L_r(x^k,z^k,y^k)$, as does $g\circ A+h$ on the projection of $\omega$ onto $\mathbb R^n$.
--
--   This lemma supplies the KKT property of the limit in Theorem 14.
--
--   **Formalization Note** A subsequence is $k_q=\varphi(q)$ with $\varphi$ strictly increasing; $\omega$ is the set of cluster points (`MapClusterPt`); "connected" is `IsConnected`, which includes nonemptiness. The limit $F_*$ is asserted to exist and be real.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, p. 18, Lemma 11

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 11 (p. 18). Under Assumption 1, let `{(xᵏ, zᵏ, yᵏ)}` be a bounded sequence generated
by Algorithm 1 or Algorithm 2 and `ω` its set of cluster points. Then
(i) along every subsequence converging to `(x̂, ẑ, ŷ)`, `L_r(x^{k_q}, z^{k_q}, y^{k_q}) → L_r(x̂, ẑ, ŷ)`;
(ii) `ω ⊆ crit(L_r) ⊆ {(x̂, ẑ, ŷ) : −A*ŷ = ∇h(x̂), ŷ ∈ ∂g(ẑ), ẑ = Ax̂}`;
(iii) `dist((xᵏ, zᵏ, yᵏ), ω) → 0`;
(iv) `ω` is nonempty, connected and compact;
(v) `L_r` takes on `ω` the value `F_* = lim L_r(xᵏ, zᵏ, yᵏ)`, as `g ∘ A + h` does on the
projection of `ω` onto `ℝⁿ`. -/
theorem lemma_11 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y)
    (hbdd : Bornology.IsBounded (Set.range fun k => pack3 (x k) (z k) (y k))) :
    (∀ (φ : ℕ → ℕ) (uh : Triple n m), StrictMono φ →
      Tendsto (fun q => pack3 (x (φ q)) (z (φ q)) (y (φ q))) atTop (𝓝 uh) →
      Tendsto (fun q => Lr P (x (φ q)) (z (φ q)) (y (φ q))) atTop (𝓝 (LrT P uh))) ∧
    clusterSet (fun k => pack3 (x k) (z k) (y k)) ⊆ critLr P ∧
    critLr P ⊆ {u | IsKKTPoint P (tx u) (tz u) (ty u)} ∧
    Tendsto (fun k => Metric.infDist (pack3 (x k) (z k) (y k))
      (clusterSet (fun k => pack3 (x k) (z k) (y k)))) atTop (𝓝 0) ∧
    IsConnected (clusterSet (fun k => pack3 (x k) (z k) (y k))) ∧
    IsCompact (clusterSet (fun k => pack3 (x k) (z k) (y k))) ∧
    ∃ Fstar : ℝ,
      Tendsto (fun k => Lr P (x k) (z k) (y k)) atTop (𝓝 (Fstar : EReal)) ∧
      ∀ u ∈ clusterSet (fun k => pack3 (x k) (z k) (y k)),
        LrT P u = (Fstar : EReal) ∧ P.g (P.A (tx u)) + (P.h (tx u) : EReal) = (Fstar : EReal) := by sorry

end BotNguyenADMM.KL
