namespace TypeDensity

/-- A two-variable power series all of whose coefficients of total degree `< N` vanish lies in
`(T, X)^N`. -/
private theorem twoSeries_mem_variableIdeal_pow_of_coeff_eq_zero (O : Type) [CommRing O] (N : ℕ)
    (g : TwoSeries O) (hg : ∀ m : Fin 2 →₀ ℕ, m 0 + m 1 < N → MvPowerSeries.coeff m g = 0) :
    g ∈ variableIdeal O ^ N :=
  (axis_ideal_pow_mem_iff O N g).2 hg

end TypeDensity

open TypeDensity

theorem solution (O S : Type) [CommRing O] [CommRing S]
    (φ ψ : TypeDensity.TwoSeries O →+* S) (hC : ∀ c : O, φ (MvPowerSeries.C c) = ψ (MvPowerSeries.C c))
    (hT : φ (TypeDensity.axisT O) = ψ (TypeDensity.axisT O)) (hX : φ (TypeDensity.axisX O) = ψ (TypeDensity.axisX O))
    (hTn : IsNilpotent (φ (TypeDensity.axisT O))) (hXn : IsNilpotent (φ (TypeDensity.axisX O))) :
    φ = ψ := by
  obtain ⟨N, hN⟩ : IsNilpotent (Ideal.span {φ (TypeDensity.axisT O), φ (TypeDensity.axisX O)}) := by
    rw [Ideal.FG.isNilpotent_iff_le_nilradical (Submodule.fg_span (Set.toFinite _)),
      Ideal.span_le]
    rintro x (rfl | rfl)
    exacts [hTn, hXn]
  -- both maps kill `(T, X)^N`, whose image is generated by powers of `φ T, φ X`
  have kill (χ : TypeDensity.TwoSeries O →+* S) (hχT : χ (TypeDensity.axisT O) = φ (TypeDensity.axisT O))
      (hχX : χ (TypeDensity.axisX O) = φ (TypeDensity.axisX O)) (g) (hg : g ∈ TypeDensity.variableIdeal O ^ N) : χ g = 0 := by
    have : χ g ∈ ((TypeDensity.variableIdeal O) ^ N).map χ := Ideal.mem_map_of_mem _ hg
    rw [Ideal.map_pow, TypeDensity.variableIdeal, Ideal.map_span, Set.image_pair, hχT, hχX, hN] at this
    simpa using this
  have hpoly : φ.comp (MvPolynomial.coeToMvPowerSeries.ringHom (σ := Fin 2) (R := O)) =
      ψ.comp (MvPolynomial.coeToMvPowerSeries.ringHom) := by
    apply MvPolynomial.ringHom_ext
    · intro c
      simpa using hC c
    · intro s
      fin_cases s
      · simpa [TypeDensity.axisT] using hT
      · simpa [TypeDensity.axisX] using hX
  ext f
  set p := MvPowerSeries.truncTotal N f
  have hg : f - (p : TypeDensity.TwoSeries O) ∈ TypeDensity.variableIdeal O ^ N := by
    apply TypeDensity.twoSeries_mem_variableIdeal_pow_of_coeff_eq_zero
    intro m hm
    rw [map_sub, MvPolynomial.coeff_coe, MvPowerSeries.coeff_truncTotal, sub_self]
    simpa [Finsupp.degree_eq_sum, Fin.sum_univ_two] using hm
  have h1 := kill φ rfl rfl _ hg
  have h2 := kill ψ hT.symm hX.symm _ hg
  rw [map_sub, sub_eq_zero] at h1 h2
  rw [h1, h2]
  exact congrArg (fun F ↦ F p) hpoly
