section chars

variable (K : Type*) [CommGroup K] [TopologicalSpace K]

/-- A character, as a continuous complex-valued function. -/
noncomputable def charFun (χ : PontryaginDual K) : C(K, ℂ) :=
  ⟨fun k => ((χ k : Circle) : ℂ), continuous_subtype_val.comp χ.continuous⟩

lemma pd_mul_apply (χ ψ : PontryaginDual K) (k : K) : (χ * ψ) k = χ k * ψ k := rfl

lemma pd_inv_apply (χ : PontryaginDual K) (k : K) : χ⁻¹ k = (χ k)⁻¹ := rfl

@[simp] lemma charFun_apply (χ : PontryaginDual K) (k : K) : charFun K χ k = ((χ k : Circle) : ℂ) :=
  rfl

/-- The star subalgebra of `C(K, ℂ)` generated by the characters. -/
noncomputable def charSubalgebra : StarSubalgebra ℂ C(K, ℂ) where
  toSubalgebra := Algebra.adjoin ℂ (Set.range (charFun K))
  star_mem' := by
    change Algebra.adjoin ℂ (Set.range (charFun K)) ≤
      star (Algebra.adjoin ℂ (Set.range (charFun K)))
    refine Algebra.adjoin_le ?_
    rintro - ⟨χ, rfl⟩
    refine Algebra.subset_adjoin ⟨χ⁻¹, ?_⟩
    ext k
    show ((χ⁻¹ k : Circle) : ℂ) = conj ((χ k : Circle) : ℂ)
    rw [pd_inv_apply, Circle.coe_inv_eq_conj]

theorem charSubalgebra_coe :
    Subalgebra.toSubmodule (charSubalgebra K).toSubalgebra =
      Submodule.span ℂ (Set.range (charFun K)) := by
  apply Algebra.adjoin_eq_span_of_subset
  refine Set.Subset.trans ?_ Submodule.subset_span
  intro x hx
  refine Submonoid.closure_induction (fun _ => id) ⟨1, ?_⟩ ?_ hx
  · ext k; simp
  · rintro - - - - ⟨χ, rfl⟩ ⟨ψ, rfl⟩
    refine ⟨χ * ψ, ?_⟩
    ext k; simp [pd_mul_apply]

variable [IsTopologicalGroup K] [CompactSpace K] [T2Space K]

theorem charSubalgebra_separatesPoints : (charSubalgebra K).SeparatesPoints := by
  intro x y hxy
  have hne : x * y⁻¹ ∉ (⊥ : Subgroup K) := by
    rw [Subgroup.mem_bot, mul_inv_eq_one]; exact hxy
  have hcl : IsClosed ((⊥ : Subgroup K) : Set K) := by
    rw [Subgroup.coe_bot]; exact isClosed_singleton
  obtain ⟨χ, -, hχ⟩ := MasulloGRH.pontryaginDual_separates_of_compact K ⊥ hcl (x * y⁻¹) hne
  refine ⟨_, ⟨charFun K χ, Algebra.subset_adjoin ⟨χ, rfl⟩, rfl⟩, ?_⟩
  simp only [charFun_apply]
  intro h
  apply hχ
  rw [map_mul, map_inv, Circle.coe_inj.mp h, mul_inv_cancel]

theorem span_charFun_closure_eq_top :
    (Submodule.span ℂ (Set.range (charFun K))).topologicalClosure = ⊤ := by
  rw [← charSubalgebra_coe]
  exact congr_arg (Subalgebra.toSubmodule <| StarSubalgebra.toSubalgebra ·)
    (ContinuousMap.starSubalgebra_topologicalClosure_eq_top_of_separatesPoints _
      (charSubalgebra_separatesPoints K))

end chars

section vanish

variable {K : Type*} [TopologicalSpace K] [CompactSpace K]
  [MeasurableSpace K] [OpensMeasurableSpace K]

lemma integrable_of_continuous (μ : Measure K) [IsFiniteMeasureOnCompacts μ] {E : Type*}
    [NormedAddCommGroup E] {f : K → E} (hf : Continuous f) : Integrable f μ :=
  hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace f)

/-- Pairing of a continuous function against a fixed continuous function `φ`,
`f ↦ ∫ f φ dμ`, as a continuous linear functional on `C(K, ℂ)`. -/
noncomputable def pairing (μ : Measure K) [IsFiniteMeasureOnCompacts μ] (φ : C(K, ℂ)) :
    C(K, ℂ) →L[ℂ] ℂ :=
  LinearMap.mkContinuous
    { toFun := fun f => ∫ k, f k * φ k ∂μ
      map_add' := fun f g => by
        simp only [ContinuousMap.add_apply, add_mul]
        exact integral_add (integrable_of_continuous μ (f.continuous.mul φ.continuous))
          (integrable_of_continuous μ (g.continuous.mul φ.continuous))
      map_smul' := fun c f => by
        simp only [ContinuousMap.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]
        exact integral_const_mul c _ }
    (‖φ‖ * μ.real Set.univ) (fun f => by
      simp only [LinearMap.coe_mk, AddHom.coe_mk]
      calc ‖∫ k, f k * φ k ∂μ‖ ≤ (‖f‖ * ‖φ‖) * μ.real Set.univ :=
            norm_integral_le_of_norm_le_const (Filter.Eventually.of_forall fun k => by
              rw [norm_mul]
              exact mul_le_mul (f.norm_coe_le_norm k) (φ.norm_coe_le_norm k) (norm_nonneg _)
                (norm_nonneg _))
        _ = ‖φ‖ * μ.real Set.univ * ‖f‖ := by ring)

lemma pairing_apply (μ : Measure K) [IsFiniteMeasureOnCompacts μ] (φ f : C(K, ℂ)) :
    pairing μ φ f = ∫ k, f k * φ k ∂μ := rfl

variable [CommGroup K] [IsTopologicalGroup K] [T2Space K]

/-- A continuous function orthogonal to all characters vanishes identically. -/
theorem eq_zero_of_forall_integral_char_mul (μ : Measure K) [IsFiniteMeasureOnCompacts μ]
    [μ.IsOpenPosMeasure] (φ : C(K, ℂ))
    (h : ∀ χ : PontryaginDual K, ∫ k, ((χ k : Circle) : ℂ) * φ k ∂μ = 0) (x : K) :
    φ x = 0 := by
  have hspan : Submodule.span ℂ (Set.range (charFun K)) ≤ LinearMap.ker (pairing μ φ : C(K, ℂ) →ₗ[ℂ] ℂ) := by
    rw [Submodule.span_le]
    rintro _ ⟨χ, rfl⟩
    simp only [SetLike.mem_coe, LinearMap.mem_ker]
    exact h χ
  have hcl : (Submodule.span ℂ (Set.range (charFun K))).topologicalClosure ≤
      LinearMap.ker (pairing μ φ : C(K, ℂ) →ₗ[ℂ] ℂ) :=
    Submodule.topologicalClosure_minimal _ hspan (pairing μ φ).isClosed_ker
  rw [span_charFun_closure_eq_top] at hcl
  have h0 : pairing μ φ (star φ) = 0 := hcl Submodule.mem_top
  have h1 : ∫ k, ‖φ k‖ ^ 2 ∂μ = 0 := by
    have e : pairing μ φ (star φ) = ((∫ k, ‖φ k‖ ^ 2 ∂μ : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal, pairing_apply]
      congr 1
      funext k
      rw [ContinuousMap.star_apply, Complex.star_def, Complex.conj_mul']
      push_cast
      ring
    rw [e] at h0
    exact_mod_cast h0
  by_contra hx
  have hpos : 0 < ∫ k, ‖φ k‖ ^ 2 ∂μ :=
    Continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero (x := x)
      (by fun_prop) (HasCompactSupport.of_compactSpace _) (fun k => by positivity)
      (by simpa using hx)
  linarith

end vanish

section rep

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

lemma isClosed_isotypic {K : Type*} (π : K → H →L[ℂ] H) (ω : K → ℂ) :
    IsClosed (isotypicSubspace π ω : Set H) := by
  have : (isotypicSubspace π ω : Set H) = ⋂ k, {v | π k v = ω k • v} := by
    ext v; simp
  rw [this]
  exact isClosed_iInter fun k => isClosed_eq (π k).continuous (continuous_const_smul _)

lemma inner_map_map_of_unitary [CompleteSpace H] (U : H →L[ℂ] H)
    (hU : U ∈ unitary (H →L[ℂ] H)) (u w : H) : inner ℂ (U u) (U w) = inner ℂ u w := by
  rw [← ContinuousLinearMap.adjoint_inner_left, ← ContinuousLinearMap.star_eq_adjoint,
    ← mul_apply_eq_comp, Unitary.star_mul_self_of_mem hU,
    one_apply_eq_self]

variable {K : Type*} [CommGroup K] [TopologicalSpace K]

lemma orthogonalFamily_isotypic [CompleteSpace H] (π : K →* (H →L[ℂ] H))
    (hπ_unitary : ∀ k, π k ∈ unitary (H →L[ℂ] H)) :
    OrthogonalFamily ℂ (fun ω : PontryaginDual K => ↥(isotypicSubspace π fun k => (ω k : ℂ)))
      (fun ω => (isotypicSubspace π fun k => (ω k : ℂ)).subtypeₗᵢ) := by
  refine OrthogonalFamily.of_pairwise ?_
  intro ω ω' hne
  rw [Function.onFun, Submodule.isOrtho_iff_inner_eq]
  intro u hu w hw
  have hu' : ∀ k, π k u = ((ω k : Circle) : ℂ) • u := hu
  have hw' : ∀ k, π k w = ((ω' k : Circle) : ℂ) • w := hw
  obtain ⟨k, hk⟩ : ∃ k, ω k ≠ ω' k := by
    by_contra! hcon
    exact hne (PontryaginDual.ext hcon)
  have h1 : inner ℂ (π k u) (π k w) = inner ℂ u w := inner_map_map_of_unitary (π k) (hπ_unitary k) u w
  rw [hu' k, hw' k, inner_smul_left, inner_smul_right] at h1
  have h2 : conj ((ω k : Circle) : ℂ) * ((ω' k : Circle) : ℂ) ≠ 1 := by
    rw [← Circle.coe_inv_eq_conj, ← Circle.coe_mul, Ne, Circle.coe_eq_one, inv_mul_eq_one]
    exact hk
  have h3 : (1 - conj ((ω k : Circle) : ℂ) * ((ω' k : Circle) : ℂ)) * inner ℂ u w = 0 := by
    linear_combination (-1 : ℂ) * h1
  rcases mul_eq_zero.mp h3 with h | h
  · exact absurd (sub_eq_zero.mp h).symm h2
  · exact h

variable [IsTopologicalGroup K] [CompactSpace K] [T2Space K]

/-- A vector orthogonal to all isotypic subspaces of a strongly continuous representation of a
compact abelian group is zero. -/
theorem eq_zero_of_mem_orthogonal_isotypic [CompleteSpace H] (π : K →* (H →L[ℂ] H))
    (hπ_cont : ∀ v : H, Continuous fun k => π k v) (v : H)
    (hv : ∀ ω : PontryaginDual K, v ∈ (isotypicSubspace π fun k => (ω k : ℂ))ᗮ) : v = 0 := by
  let _ : MeasurableSpace K := borel K
  have _ : BorelSpace K := ⟨rfl⟩
  let μ : Measure K := Measure.haar
  have hint : ∀ χ : PontryaginDual K, Integrable (fun k => ((χ k : Circle) : ℂ) • π k v) μ :=
    fun χ => integrable_of_continuous μ (((charFun K χ).continuous).smul (hπ_cont v))
  have hmem : ∀ χ : PontryaginDual K, (∫ k, ((χ k : Circle) : ℂ) • π k v ∂μ) ∈
      isotypicSubspace π fun k => ((χ⁻¹ k : Circle) : ℂ) := by
    intro χ
    rw [mem_isotypicSubspace]
    intro h
    let F : K → H := fun k' => ((χ (h⁻¹ * k') : Circle) : ℂ) • π k' v
    calc π h (∫ k, ((χ k : Circle) : ℂ) • π k v ∂μ)
        = ∫ k, π h (((χ k : Circle) : ℂ) • π k v) ∂μ :=
          (ContinuousLinearMap.integral_comp_comm _ (hint χ)).symm
      _ = ∫ k, F (h * k) ∂μ := by
          congr 1
          funext k
          show π h (((χ k : Circle) : ℂ) • π k v) =
            ((χ (h⁻¹ * (h * k)) : Circle) : ℂ) • π (h * k) v
          rw [inv_mul_cancel_left, map_smul, map_mul, mul_apply_eq_comp]
      _ = ∫ k, F k ∂μ := integral_mul_left_eq_self F h
      _ = ∫ k, ((χ⁻¹ h : Circle) : ℂ) • (((χ k : Circle) : ℂ) • π k v) ∂μ := by
          congr 1
          funext k
          show ((χ (h⁻¹ * k) : Circle) : ℂ) • π k v = _
          rw [map_mul, map_inv, Circle.coe_mul, mul_smul, pd_inv_apply]
      _ = ((χ⁻¹ h : Circle) : ℂ) • ∫ k, ((χ k : Circle) : ℂ) • π k v ∂μ := integral_smul _ _
  have hzero : ∀ χ : PontryaginDual K,
      ∫ k, ((χ k : Circle) : ℂ) * inner ℂ v (π k v) ∂μ = 0 := by
    intro χ
    have h1 := (Submodule.mem_orthogonal' _ v).mp (hv χ⁻¹) _ (hmem χ)
    rw [← integral_inner (hint χ)] at h1
    simpa only [inner_smul_right] using h1
  let φ : C(K, ℂ) := ⟨fun k => inner ℂ v (π k v), continuous_const.inner (hπ_cont v)⟩
  have hφ := eq_zero_of_forall_integral_char_mul μ φ hzero 1
  have : inner ℂ v v = (0 : ℂ) := by
    simpa [φ] using hφ
  exact inner_self_eq_zero.mp this

end rep

