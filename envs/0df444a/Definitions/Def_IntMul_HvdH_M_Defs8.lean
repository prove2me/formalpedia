/-- The registers `envL` reads, with their values. -/
structure EnvRegs (q : Params) (kb : ℕ) (w : IState HS) : Prop where
  r43 : ∃ L, w.G 43 = .int (q.p : ℤ) :: L
  r46 : ∃ L, w.G 46 = .int (q.logT : ℤ) :: L
  r31 : ∃ L, w.G 31 = .int ((2 ^ q.b : ℕ) : ℤ) :: L
  r45 : ∃ L, w.G 45 = .int (q.S : ℤ) :: L
  r42 : ∃ L, w.G 42 = .int (q.α : ℤ) :: L
  r50 : ∃ L, w.G 50 = .int (EX.TT q : ℤ) :: L
  r41 : ∃ L, w.G 41 = .int (ceilSqrt q.p : ℤ) :: L
  r2 : ∃ L, w.G 2 = .int (kb : ℤ) :: L
  r49 : ∃ L, w.G 49 = .int ((q.K - q.dh : ℕ) : ℤ) :: L
  r48 : ∃ L, w.G 48 = .int ((2 ^ (q.e - 1) : ℕ) : ℤ) :: L
  r47 : ∃ L, w.G 47 = .int ((2 ^ q.e : ℕ) : ℤ) :: L
  r44 : ∃ L, w.G 44 = .int (q.P : ℤ) :: L
  r54 : ∃ L, w.G 54 = .int (q.fn : ℤ) :: L
  r51 : ∃ L, w.G 51 = .int (q.logOuter : ℤ) :: L

/-- Size facts for the environment values (all values have at most `Bs` bits). -/
structure EnvN (q : Params) (kb Bs : ℕ) : Prop where
  K1 : 1 ≤ q.K
  α1 : 1 ≤ q.α
  bp : q.b ≤ q.p
  lo : q.logOuter ≤ q.fn
  e1 : 1 ≤ q.e
  p : 2 * q.p + q.logT + 2 ≤ Bs
  c : GL.exC q + 2 ≤ Bs
  P : q.P + 1 ≤ Bs
  fn : q.fn + 2 ≤ Bs
  rP : 2 * q.r * q.P + 1 ≤ Bs
  S2 : q.S * q.S < 2 ^ Bs
  T : EX.TT q < 2 ^ Bs
  sm : 6 * q.K * (q.α * q.α) + 2 * (ceilSqrt q.p * q.α) + 2 * q.α + ceilSqrt q.p + kb + q.K + 2 * 2 ^ q.e +
    2 * q.α + 2 < 2 ^ Bs

end NLogN.ST

