set_option maxHeartbeats 2000000 in
theorem sumLoop_cost (u : IState HS) (s Pm : ℕ) (LS LP LM : List Item)
    (hS : u.G mS = .int (s : ℤ) :: LS) (hP : u.G mP = .int (Pm : ℤ) :: LP)
    (hM : u.G mM = .int 0 :: LM) (hs : 2 ≤ s)
    (A B : ℕ) (hE : CostEnv A B) (hssA : s * s ≤ A) (hPA : Pm ≤ A) :
    (RS.rep mIc (.reg mS) NLogN.KFM.sumB).cost u ≤ (s + 1) * 40 * (10 ^ 7 * (B + 2) ^ 2) := by
  have hA2 : 2 ≤ A := by have := hE.hA; omega
  have hsA : s ≤ A := le_trans (Nat.le_mul_of_pos_left s (by omega)) hssA
  set g : ℕ → ℤ := fun y => (y : ℤ) * (if ((y : ℤ) * (Pm : ℤ)) % (s : ℤ) = 1 then 1 else 0) with hg
  set K := 10 ^ 7 * (B + 2) ^ 2 with hK
  have hK1 := hE.K
  have hsE : (Ex.add (.reg mM) (.mul (.reg mIc) indE) : Ex HS).size + 1 ≤ 35 := by decide
  have H := genLoop_cost mIc mM (.reg mS) NLogN.KFM.sumB u s (sumG g s) 0 LM (by decide) (by decide)
    (NLogN.KFM.clean_of_regs _ (by decide)) (IState.isInt_of hS) (by simp [Ex.eval, IState.top_eq hS])
    (by decide) hM (sumB_step u s Pm LS LP LM hS hP hs) B (35 * K) (hE.zsz_nat hsA) hE.B1
    (exSmS_bnd A B u hA2 _ (by simp only [exSmS, IState.top_eq hS]; (all_goals
                                                                       first
                                                                       | assumption
                                                                       | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                       | ((norm_num); (done))
                                                                       | ((norm_num); (omega))
                                                                       | omega
                                                                       | positivity
                                                                       |
                                                                         ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                               first
                                                                               | ((norm_num); (done))
                                                                               | omega);
                                                                           (done)))) (hE.hAB _ (by decide)))
    (by
      intro k hk
      set c := accSeq (sumG g s) 0 k with hc
      have hcb := sum_partial s Pm g hg k hk.le
      set t := lpSt u mIc mM LM s k c with ht
      have tI : t.G mIc = .int ((s : ℤ) - k) :: u.G mIc := by
        simp (config := {decide := true}) [ht, lpSt, IState.upd_G]
      have tM : t.G mM = .int c :: LM := by simp [ht, lpSt]
      have tS : t.G mS = .int (s : ℤ) :: LS := by
        simp (config := {decide := true}) [ht, lpSt, IState.upd_G, hS]
      have tP : t.G mP = .int (Pm : ℤ) :: LP := by
        simp (config := {decide := true}) [ht, lpSt, IState.upd_G, hP]
      have hs0 : (0 : ℤ) < s := by omega
      have hkA : (k : ℤ) * s ≤ A := by
        have : (k : ℤ) * s ≤ (s : ℤ) * s := by nlinarith
        have : ((s * s : ℕ) : ℤ) ≤ A := by exact_mod_cast hssA
        push_cast at this; linarith
      have hcA : |c| ≤ (A : ℤ) := by rw [abs_le]; constructor <;> linarith [hcb.1, hcb.2]
      have hsm : exSmS A t (.add (.reg mM) (.mul (.reg mIc) indE)) := by
        simp only [indE, exSmS, Ex.eval, IState.top_eq tI, IState.top_eq tS, IState.top_eq tP,
          IState.top_eq tM]
        refine ⟨hcA, ?_⟩
        constructorm* _ ∧ _
        all_goals first
          | (rw [abs_le]; constructor <;> omega)
          | (all_goals
               first
               | assumption
               | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
               | ((norm_num); (done))
               | ((norm_num); (omega))
               | omega
               | positivity
               |
                 ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                       first
                       | ((norm_num); (done))
                       | omega);
                   (done)))
          | exact Int.emod_lt_of_pos _ hs0
          | omega
      have := asgCost_le mM (.add (.reg mM) (.mul (.reg mIc) indE)) t B
        (exSmS_bnd A B t hA2 _ hsm (hE.dg _ (by simp only [exDgS, indE]; norm_num)))
        (by rw [IState.top_eq tM]; exact hE.zsz_le hcA)
      show asgCost mM _ t ≤ 35 * K
      calc _ ≤ _ := this
        _ ≤ 35 * K := by rw [hK, ← mul_assoc]; exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hsE))
  have hsz : (Ex.reg mS : Ex HS).size = 1 := rfl
  rw [hsz] at H
  have e1 : (1 + 1) * 10 ^ 7 * (B + 2) ^ 2 = 2 * K := by rw [hK]; ring
  have e2 : 4 * 10 ^ 7 * (B + 2) ^ 2 = 4 * K := by rw [hK]; ring
  simp only [e1, e2] at H
  have h1 : s * (35 * K + 4 * K + 30) ≤ s * (40 * K) := Nat.mul_le_mul_left _ (by omega)
  nlinarith

end NLogN.KFM

end

