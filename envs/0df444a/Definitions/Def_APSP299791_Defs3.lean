section
-- Source module: ThreeSumApsp.AllEdges.Data
/-!
# All-edges host: the marks, as pure data

The all-edges host runs the instances of Theorem 17 and keeps a mark for every pair `(a, b)`.
`HostData.marks t` are the marks before instance `t`; `HostData.aeExecs t` is the number of scans
of instance `t`.  A scan is a failed scan or sets a new mark, so all instances together make at most
`F(p) + n²` scans (`HostData.sum_aeExecs_le`).  After all instances the mark of `(a, b)` is set if
and only if some `c` has `S(a,b,c) = 0` (`HostData.marks_m_iff`).
-/

@[expose] public section

namespace Light.Sec3

open ThreeSumApsp ThreeSumApsp.Spec

namespace HostData

variable (X : HostData)

/-- The place of the query pair number `i` of instance `t`, as scanPairsAE computes it. -/
abbrev aePl (t : ℕ) : ℕ → ℕ := plOf X.n (X.WI t) (X.WJ t)

/-- The marks before instance `t`. -/
def marks : ℕ → ℕ → Bool
  | 0 => fun _ => false
  | t + 1 => marksUpto (X.acc t) (X.hit t) (X.aePl t) (marks t) (X.w t)

/-- The number of scans of instance `t`. -/
def aeExecs (t : ℕ) : ℕ := aeExecsUpto (X.acc t) (X.hit t) (X.aePl t) (X.marks t) (X.w t)

variable {X}

end HostData

end Light.Sec3
end
end

section
-- Source module: ThreeSumApsp.AllEdges.Loop
/-!
# All-edges host: the loop over the instances

The loop of the host of Theorem 17, with `scanPairsAE` in the place of `scanPairs`: the marks of the
`n²` pairs lie in `n²` cells from `fl`, below the matrices of the instances.  The loop writes, for
every pair, whether a zero triangle through it has been found (`aeLoop_spec`).

The memory before instance `t` agrees below `x` with the first memory, with the marks `marks t` in
the cells from `fl`; so the facts `HostSetting` of the loop of Theorem 17 hold with that memory as
the first one, and the lemmas about the calls of writeX, writeY and the solver are used unchanged.
-/

@[expose] public section

namespace Light.Sec3

open ThreeSumApsp ThreeSumApsp.Spec

variable {lim : Limits} {d : ℕ}

/-! ## The procedure -/

namespace AELocal

/-- The address of the marks; the arguments before it are those of hostLoop. -/
abbrev Fl : ℕ := 20
/-- The number t of the instance. -/
abbrev Inst : ℕ := 21
/-- The number ch of its chunk. -/
abbrev ChunkNo : ℕ := 22
/-- The first vertex c0 of its piece. -/
abbrev PieceStart : ℕ := 23

end AELocal

open HostLocal AELocal

/-- The four calls for one instance: the two matrices, the solver, the scans. -/
def aeCalls (pS pWriteX pWriteY pScanPairs : ℕ) : Stmt :=
  .call pWriteX [Light.v Light.Sec3.HostLocal.MatX, Light.v Light.Sec3.HostLocal.ResAC, Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v Light.Sec3.HostLocal.ThePrime, Light.v AELocal.PieceStart, Light.v Light.Sec3.HostLocal.Len,
    Light.v Residue] Light.Sec3.HostLocal.Unused ;;
  .call pWriteY [Light.v Light.Sec3.HostLocal.MatY, Light.v Light.Sec3.HostLocal.ResBC, Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v Light.Sec3.HostLocal.ThePrime, Light.v AELocal.PieceStart, Light.v Light.Sec3.HostLocal.Len] Light.Sec3.HostLocal.Unused ;;
  .call pS [Light.v Light.Sec3.HostLocal.Size, Light.v Light.Sec3.HostLocal.ParD, Light.v NumPairs, Light.k 1, Light.v Light.Sec3.HostLocal.MatX, Light.v Light.Sec3.HostLocal.MatY, Light.v Light.Sec3.HostLocal.Rows +' Light.v Light.Sec3.HostLocal.Start, Light.v Light.Sec3.HostLocal.Cols +' Light.v Light.Sec3.HostLocal.Start,
    Light.v Light.Sec3.HostLocal.AdrOut, Light.v Light.Sec3.HostLocal.SolverFree] Light.Sec3.HostLocal.Unused ;;
  .call pScanPairs [Light.v Light.Sec3.HostLocal.AdrOut, Light.v Light.Sec3.HostLocal.Rows +' Light.v Light.Sec3.HostLocal.Start, Light.v Light.Sec3.HostLocal.Cols +' Light.v Light.Sec3.HostLocal.Start, Light.v NumPairs, Light.v Fl, Light.v Light.Sec3.HostLocal.AdrAB,
    Light.v Light.Sec3.HostLocal.AdrBC, Light.v Light.Sec3.HostLocal.AdrAC, Light.v Light.Sec3.HostLocal.Size, Light.v AELocal.PieceStart, Light.v Light.Sec3.HostLocal.Len] Light.Sec3.HostLocal.Unused

/-- The numbers of the next instance, of its chunk, and the first vertex of its piece. -/
def aeNext : Stmt :=
  .set AELocal.ChunkNo (Light.v AELocal.ChunkNo +' Light.k 1) ;;
  .ite (Light.v AELocal.ChunkNo =' Light.v Light.Sec3.HostLocal.NumChunks)
    (.set AELocal.ChunkNo (Light.k 0) ;; .set AELocal.PieceStart (Light.v AELocal.PieceStart +' Light.v Light.Sec3.HostLocal.PieceLen))
    .skip ;;
  .set AELocal.Inst (Light.v AELocal.Inst +' Light.k 1)

/-- The parameters of the instance. -/
def aeParams : Stmt :=
  .set Light.Sec3.HostLocal.Len (Light.v Light.Sec3.HostLocal.PieceLen) ;;
  .ite (Light.v Light.Sec3.HostLocal.Size -' Light.v AELocal.PieceStart <' Light.v Light.Sec3.HostLocal.PieceLen) (.set Light.Sec3.HostLocal.Len (Light.v Light.Sec3.HostLocal.Size -' Light.v AELocal.PieceStart))
    .skip ;;
  .set Residue (M (Light.v Light.Sec3.HostLocal.TabR +' Light.v AELocal.ChunkNo)) ;;
  .set Light.Sec3.HostLocal.Start (M (Light.v Light.Sec3.HostLocal.TabL +' Light.v AELocal.ChunkNo)) ;;
  .set NumPairs (M (Light.v Light.Sec3.HostLocal.TabW +' Light.v AELocal.ChunkNo))

/-- One round of aeLoop. -/
def aeRound (pS pWriteX pWriteY pScanPairs : ℕ) : Stmt :=
  aeParams ;;
  aeCalls pS pWriteX pWriteY pScanPairs ;;
  aeNext

/-- aeLoop(n, D, p, q, chunkCount, m, ab, bc, ac, rac, rbc, qi, qj, cr, cl, cw, x, y, out, fr, fl).
-/
def aeLoopBody (pS pWriteX pWriteY pScanPairs : ℕ) : Stmt :=
  .set AELocal.Inst (Light.k 0) ;; .set AELocal.ChunkNo (Light.k 0) ;; .set AELocal.PieceStart (Light.k 0) ;;
  .while (Light.v AELocal.Inst <' Light.v Light.Sec3.HostLocal.NumInst) (aeRound pS pWriteX pWriteY pScanPairs) ;;
  .set 0 (Light.k 0)

/-- The number of steps of aeLoop, if the solver takes Tn. -/
def tAELoop (Tn : List ℕ → ℕ) (X : HostData) : ℕ :=
  (∑ t ∈ Finset.range X.m, (tWrites X.n X.D (X.len t) + Tn [X.n, X.D, X.w t] +
    tScanPairsAE (X.w t) (X.len t) (X.aeExecs t))) + 14

/-! ## What the loop relies on -/

/-- The marks lie below x, apart from everything that the loop reads. -/
structure AEMarksLay (X : HostData) (A : HostAddr) (fl : ℕ) : Prop where
  below : fl + X.n * X.n ≤ A.x
  ab : Apart A.ab (X.n * X.n) fl (X.n * X.n)
  bc : Apart A.bc (X.n * X.n) fl (X.n * X.n)
  ac : Apart A.ac (X.n * X.n) fl (X.n * X.n)
  rac : Apart A.rac (X.n * X.n) fl (X.n * X.n)
  rbc : Apart A.rbc (X.n * X.n) fl (X.n * X.n)
  qi : Apart A.qi (X.n * X.n) fl (X.n * X.n)
  qj : Apart A.qj (X.n * X.n) fl (X.n * X.n)
  cr : Apart A.cr X.chunkCount fl (X.n * X.n)
  cl : Apart A.cl X.chunkCount fl (X.n * X.n)
  cw : Apart A.cw X.chunkCount fl (X.n * X.n)

/-- The context of aeLoop: a solver of Lop-AE-SparseTri, and the procedures writeX, writeY,
scanPairsAE, scan in the program. -/
structure AEHostCtx (P₀ R : Program) (pS pWriteX pWriteY pScanPairs pScan : ℕ) (Tn : List ℕ → ℕ)
    (need : List ℕ → Light.Need) : Prop where
  sol : SolvesN lopDetectTask P₀ pS Tn need
  writeX : (P₀ ++ R)[pWriteX]? = some writeXBody
  writeY : (P₀ ++ R)[pWriteY]? = some writeYBody
  scanPairs : (P₀ ++ R)[pScanPairs]? = some (scanPairsAEBody pScan)
  scan : (P₀ ++ R)[pScan]? = some scanBody

/-- The arguments of aeLoop. -/
def aeLoopArgs (X : HostData) (A : HostAddr) (fl : ℕ) : List ℤ :=
  [X.n, X.D, X.p, X.q, X.chunkCount, X.m, A.ab, A.bc, A.ac, A.rac, A.rbc, A.qi, A.qj, A.cr, A.cl,
    A.cw, A.x, A.y, A.out, A.fr, fl]

/-! ## Marks in the memory -/

/-! ## The parts of a round -/

variable {P₀ R : Program} {pS pWriteX pWriteY pScanPairs pScan : ℕ} {Tn : List ℕ → ℕ}
  {need : List ℕ → Need} {X : HostData} {U : ℕ} {A : HostAddr} {fl : ℕ} {μ μ' : ℕ → ℤ} {t : ℕ}

/-- The state of aeLoop: the arguments, the numbers t, ch and c0 of the instance, and what the
locals Len, Residue, Start, NumPairs and Unused hold. -/
abbrev aeState (X : HostData) (A : HostAddr) (fl t ch c0 : ℕ) (len rho lo w res : ℤ)
    (μ' : ℕ → ℤ) : State :=
  ⟨Light.frame [X.n, X.D, X.p, X.q, X.chunkCount, X.m, A.ab, A.bc, A.ac, A.rac, A.rbc, A.qi, A.qj, A.cr,
    A.cl, A.cw, A.x, A.y, A.out, A.fr, fl, t, ch, c0, len, rho, lo, w, res], μ'⟩

/-- The memory before instance `t`, below `x`: the first memory with the marks of `t`. -/
abbrev aeBase (X : HostData) (fl : ℕ) (μ : ℕ → ℤ) (t : ℕ) : ℕ → ℤ :=
  withMarks μ fl (X.n * X.n) (X.marks t)

/-- The time of the four calls. -/
def tAECalls (Tn : List ℕ → ℕ) (X : HostData) (t : ℕ) : ℕ :=
  tWriteX X.n X.D (X.len t) + tWriteY X.n X.D (X.len t) + Tn [X.n, X.D, X.w t] +
    tScanPairsAE (X.w t) (X.len t) (X.aeExecs t) + 52

/-! ## The loop -/

/-- The invariant of the loop, before instance t. -/
def AEInv (lim : Limits) (d : ℕ) (X : HostData) (U : ℕ) (A : HostAddr) (fl : ℕ)
    (need : List ℕ → Light.Need) (μ : ℕ → ℤ) (t : ℕ) (σ : State) : Prop :=
  ∃ (len rho lo w res : ℤ) (μ' : ℕ → ℤ),
    σ = aeState X A fl t (t % X.chunkCount) (X.c0 t) len rho lo w res μ' ∧
    HostSetting lim d X U A need (aeBase X fl μ t) μ'

end Light.Sec3
end
