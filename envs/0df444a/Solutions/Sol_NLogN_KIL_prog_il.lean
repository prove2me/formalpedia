theorem bnd_enc2 (xs : List (ZMod 2)) {Bb : ℕ} (hB : 1 ≤ Bb) : Bnd Bb (enc2 xs) :=
  bits_bnd (NLogN.KIL.bits_enc2 xs) hB

/-- **Step runner on bits.** Shifts by any shift code correct on all integer arrays, interchanges
by child procedures correct on bit arrays. -/
theorem runCode2_spec (scode : Step n Q → IStmt HS Pp) (jOf : Fin n → Fin n → Fin Pp)
    (child : Fin n → Fin n → List (ZMod 2) → List (ZMod 2)) (t : IState HS) (R : List Item)
    (Bb cS : ℕ) (hB : 1 ≤ Bb) (cC : Fin n → Fin n → ℕ) :
    ∀ steps : List (Step n Q),
    (∀ i u c, Step.shift i u c ∈ steps → ∀ ys, DOK sh Bb ys →
      IRuns I iprog (scode (.shift i u c)) (t.upd 0 (ints ys ++ R))
        (t.upd 0 (ints ((Step.shift i u c).arr Λ 0 ys) ++ R)) cS) →
    (∀ a b, Step.swap a b ∈ steps → ∀ ys : List (ZMod 2), ys.length = vol sh →
      IRuns I iprog (iprog (jOf a b)) (t.upd 0 (ints (enc2 ys) ++ R))
        (t.upd 0 (ints (enc2 (child a b ys)) ++ R)) (cC a b) ∧ (child a b ys).length = vol sh) →
    ∀ xs : List (ZMod 2), xs.length = vol sh →
      IRuns I iprog (runCode scode jOf steps) (t.upd 0 (ints (enc2 xs) ++ R))
        (t.upd 0 (ints (enc2 (runC Λ child 0 steps xs)) ++ R)) (runCostI cS cC steps)
  | [], _, _, xs, _ => by
    simpa [runCode, runC, runCostI] using
      IRuns.skip (I := I) (iprog := iprog) (t.upd 0 (ints (enc2 xs) ++ R))
  | s :: rest, hS, hC, xs, hx => by
    have hS' : ∀ i u c, Step.shift i u c ∈ rest → _ := fun i u c h =>
      hS i u c (List.mem_cons_of_mem _ h)
    have hC' : ∀ a b, Step.swap a b ∈ rest → _ := fun a b h => hC a b (List.mem_cons_of_mem _ h)
    have e : runC Λ child 0 (s :: rest) xs = runC Λ child 0 rest (stepC Λ child 0 xs s) := rfl
    cases s with
    | shift i u c =>
      have h1 := hS i u c List.mem_cons_self (enc2 xs) ⟨by simp [hx], bnd_enc2 xs hB⟩
      rw [arr_enc2] at h1
      have h2 := runCode2_spec scode jOf child t R Bb cS hB cC rest hS' hC'
        ((Step.shift i u c).arr Λ 0 xs) (by simp [Step.arr])
      refine (h1.seq h2).mono' (by rw [e]; rfl) ?_
      simp [runCostI, stepCost]; omega
    | swap a b =>
      have h1 := hC a b List.mem_cons_self xs hx
      have h2 := runCode2_spec scode jOf child t R Bb cS hB cC rest hS' hC' (child a b xs) h1.2
      refine ((IRuns.call h1.1).seq h2).mono' (by rw [e]; rfl) ?_
      simp [runCostI, stepCost]; omega

end Runner

