-- title:
--   Associated primes of a nonzero principal ideal have height one
-- statement:
--   Let $B$ be a commutative ring which is a domain, Noetherian, and integrally closed in its field of fractions, let $x \in B$ be nonzero, and let $P$ be a prime ideal of $B$ that is an associated prime of the $B$-module $B/xB$, i.e. $P$ lies in `associatedPrimes B (B ⧸ Ideal.span {x})`: $P$ is the annihilator of some element of the quotient of $B$ by the ideal generated by $x$. The conclusion is that the height of $P$, as an element of $\mathbb{N}\infty$, equals $1$; here the height is the supremum of the lengths of chains of primes descending from $P$. Since associated primes include the minimal primes over $xB$ as well as any embedded primes, the statement says in particular that a nonzero principal ideal of a Noetherian normal domain is unmixed of height one.
--
--   This is the standard unmixedness statement for principal divisors on a normal Noetherian domain, the ingredient that makes the divisor theory of such rings work. It is used in the project's treatment of integrally closed algebras and trace duals, for instance in establishing that elements of the fraction field integral at all height-one primes lie in the ring.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_IsIntegrallyClosed_height_eq_one_of_mem_associatedPrimes.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem IsIntegrallyClosed.height_eq_one_of_mem_associatedPrimes
    {B : Type*} [CommRing B] [IsDomain B] [IsNoetherianRing B] [IsIntegrallyClosed B]
    {x : B} (hx : x ≠ 0) (P : Ideal B) [P.IsPrime]
    (hP : P ∈ associatedPrimes B (B ⧸ Ideal.span {x})) : P.height = 1 := by sorry
