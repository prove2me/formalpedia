-- title:
--   §2, pp. 4–5, 11–12 — the jump-diffusion market with a stochastic factor, its filtration, standing assumptions, Σ, α, β, λ, and jump diffusions on [t, T]
-- statement:
--   This file fixes the market of Li, Liang and Pang.
--
--   **Data.** A probability space $(\Omega,\mathcal F,\mathbb P)$ carries a two-dimensional Brownian motion $(W^1,W^2)$ and a Poisson random measure $N$ on $[0,\infty)\times\mathbb R$, given by its atoms $(s,p)$ (jump time $s$, mark $p$), with compensator $\mathrm ds\,\nu(\mathrm dp)$ and compensated measure $\tilde N(\mathrm ds,\mathrm dp)=N(\mathrm ds,\mathrm dp)-\mathrm ds\,\nu(\mathrm dp)$. The market has a horizon $T$, a risk-free rate $r$, a risky asset with coefficients $\mu(z)$, $\sigma(z)$, $\gamma(z,p)$, and a stochastic factor $Z$ with coefficients $a(z)$, $b(z)$ and correlation constants $\rho_W$, $\bar\rho_W$.
--
--   **Filtration.** $\mathcal F_t$ is the σ-algebra generated by $W(s)$, $s\le t$, and by the counts $N(B)$ of measurable sets $B\subseteq[0,t]\times\mathbb R$.
--
--   **Standing assumptions** (§2 and p. 12):
--   1. $\mathbb P$ is a probability measure, $(W^1,W^2)$ is a standard two-dimensional Brownian motion, $N$ is an $\{\mathcal F_t\}$-Poisson random measure with intensity $\mathrm ds\otimes\nu$, and $W$ and $N$ are independent;
--   2. $\nu(\mathbb R)<\infty$ and $\nu(\{0\})=0$;
--   3. $\mu,\sigma,a,b$ are continuous; $\gamma$ is measurable, continuous in $z$, $\gamma>-1$, and $\int_{\mathbb R}\gamma(z,p)^2\nu(\mathrm dp)<\infty$ for every $z$;
--   4. $\rho_W^2+\bar\rho_W^2=1$;
--   5. $\Sigma(z)>0$, $\lambda(z)>0$, $\beta(z)>0$ for every $z$, where
--
--   $$\Sigma(z)=\sigma(z)^2+\int_{\mathbb R}\gamma(z,p)^2\nu(\mathrm dp),\qquad \alpha(z)=a(z)-2\rho_W\frac{\mu(z)-r}{\Sigma(z)}\sigma(z)b(z),$$
--   $$\beta(z)=\frac{\bar\rho_W^2\sigma(z)^2+\int_{\mathbb R}\gamma(z,p)^2\nu(\mathrm dp)}{\Sigma(z)},\qquad \lambda(z)=\frac{(\mu(z)-r)^2}{\Sigma(z)} .$$
--
--   Also $m(z)=\int_{\mathbb R}\gamma(z,p)^2\nu(\mathrm dp)$.
--
--   **Jump diffusions on $[t,T]$.** A process $X$ is a jump diffusion started at $X_t=x_0$ with drift $\mathrm{dr}$, Brownian integrands $d_1,d_2$ and jump integrand $j$ if it is adapted with càdlàg paths and, for each $s\in[t,T]$, almost surely
--
--   $$X_s=x_0+\int_t^s \mathrm{dr}_u\,\mathrm du+\int_t^s d_{1,u}\,\mathrm dW^1_u+\int_t^s d_{2,u}\,\mathrm dW^2_u+\int_t^s\!\int_{\mathbb R} j_u(p)\,\tilde N(\mathrm du,\mathrm dp).$$
--
--   The factor $Z=Z^{z,t}$ is the solution of (3), $\mathrm dZ_s=a(Z_s)\mathrm ds+b(Z_s)(\rho_W\mathrm dW^1_s+\bar\rho_W\mathrm dW^2_s)$, $Z_t=z$, with continuous paths. The asset price $S$ of (2) never enters the results, only its coefficients.
--
--   **Formalization Note** Time is $[0,\infty)$; integrals over $[t,s]$ are differences of integral processes whose integrands vanish before $t$. The Brownian integrals are the $L^2$ Itô integrals of `Peng1990.SMP.IsItoIntegral`, so their integrands are progressive and square-integrable. The compensated integral is pathwise: the sum of the integrand over the finitely many atoms in $(t,s]$ minus $\int_t^s\int j\,\mathrm d\nu\,\mathrm du$ (`JacodTodorov10.LLN.compSum` at level $0$), with the integrand jointly integrable on $[t,T]\times\mathbb R$. With $\nu$ finite this is the stochastic integral whenever both exist. The filtration is natural and not completed. The positivity of $\Sigma$, $\lambda$, $\beta$ is implicit in the paper, which divides by $\Sigma$ and asserts $\beta,\lambda>0$ on p. 12. $\nu(\{0\})=0$ makes $\Delta L_s\neq0$ detect every jump.
-- source:
--   Li, Liang & Pang, Comparison Between Mean-Variance and Monotone Mean-Variance Preferences Under Jump Diffusion and Stochastic Factor Model, arXiv:2211.14473v2, pp. 4–5 (§2, (2)–(3)), p. 11 (Σ), p. 12 (α, β, λ), p. 13 (m(z))

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_JacodTodorov10_LLN_Noise

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal

namespace MonotoneMVJump.Compare

/-- The data of the jump-diffusion market with a stochastic factor (Li–Liang–Pang,
arXiv:2211.14473v2, §2, pp. 4–5): the reference probability `P`, the two-dimensional Brownian
motion `W = (W¹, W²)` (coordinates `0` and `1`), the Lévy measure `ν` of the marks, the atoms
`N(ω) ⊆ [0, ∞) × ℝ` of the Poisson random measure, the horizon `T`, the risk-free rate `r`, the
coefficients `μ, σ, γ` of the risky asset (2), the coefficients `a, b` of the factor (3) and the
correlation constants `ρ_W, ρ̄_W`. -/
structure Market (Ω : Type*) [MeasurableSpace Ω] where
  /-- the reference probability measure `ℙ` -/
  P : Measure Ω
  /-- the Brownian motion `(W¹, W²)`: coordinate `0` is `W¹`, coordinate `1` is `W²` -/
  W : ℝ≥0 → Ω → Fin 2 → ℝ
  /-- the Lévy measure `ν(dp)` of the marks -/
  ν : Measure ℝ
  /-- the atoms `(s, p)` of the Poisson random measure `N` -/
  N : Ω → Set (ℝ≥0 × ℝ)
  /-- the horizon `T` -/
  T : ℝ≥0
  /-- the risk-free rate `r` -/
  r : ℝ
  /-- the drift `μ(z)` of the risky asset -/
  μ : ℝ → ℝ
  /-- the volatility `σ(z)` of the risky asset -/
  σ : ℝ → ℝ
  /-- the jump coefficient `γ(z, p)` of the risky asset -/
  γ : ℝ → ℝ → ℝ
  /-- the drift `a(z)` of the factor -/
  a : ℝ → ℝ
  /-- the volatility `b(z)` of the factor -/
  b : ℝ → ℝ
  /-- the correlation `ρ_W` -/
  ρW : ℝ
  /-- the complementary constant `ρ̄_W` -/
  ρbarW : ℝ

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

namespace Market

variable (M : Market Ω)

/-- The σ-algebra generated by `W(s)`, `s ≤ t`, and by the counts `N(B)` of measurable sets
`B ⊆ [0, t] × ℝ`. -/
@[instance_reducible]
noncomputable def genSigma (t : ℝ≥0) : MeasurableSpace Ω :=
  (⨆ (s : ℝ≥0) (_ : s ≤ t), MeasurableSpace.comap (M.W s) inferInstance) ⊔
    ⨆ (B : Set (ℝ≥0 × ℝ)) (_ : MeasurableSet B ∧ B ⊆ Set.Iic t ×ˢ Set.univ),
      MeasurableSpace.comap (fun ω => JacodTodorov10.LLN.cnt M.N ω B) inferInstance

/-- The filtration `{𝓕_t}` generated by `W¹, W²` and `N` (natural, uncompleted). The
intersection with the ambient σ-algebra only makes it a sub-filtration; under `Standing` (all
`W(s)` and counts measurable) it is the generated σ-algebra itself. -/
noncomputable def filt : Filtration ℝ≥0 mΩ where
  seq t := mΩ ⊓ M.genSigma t
  mono' _ _ hst := inf_le_inf_left _ (sup_le_sup
    (iSup₂_mono' fun u hu => ⟨u, le_trans hu hst, le_rfl⟩)
    (iSup₂_mono' fun B hB => ⟨B, ⟨hB.1, hB.2.trans
      (Set.prod_mono (Set.Iic_subset_Iic.mpr hst) le_rfl)⟩, le_rfl⟩))
  le' _ := inf_le_left

/-- `m(z) = ∫_ℝ γ(z, p)² ν(dp)` (Proposition 1's notation). -/
noncomputable def m (z : ℝ) : ℝ := ∫ p, M.γ z p ^ 2 ∂M.ν

/-- `Σ(z) = σ(z)² + ∫_ℝ γ(z, p)² ν(dp)` (p. 11). -/
noncomputable def Sig (z : ℝ) : ℝ := M.σ z ^ 2 + M.m z

/-- `α(z) = a(z) − 2ρ_W ((μ(z) − r)/Σ(z)) σ(z) b(z)` (p. 12). -/
noncomputable def alpha (z : ℝ) : ℝ :=
  M.a z - 2 * M.ρW * ((M.μ z - M.r) / M.Sig z) * M.σ z * M.b z

/-- `β(z) = (ρ̄_W² σ(z)² + ∫_ℝ γ(z, p)² ν(dp)) / Σ(z)` (p. 12). -/
noncomputable def beta (z : ℝ) : ℝ := (M.ρbarW ^ 2 * M.σ z ^ 2 + M.m z) / M.Sig z

/-- `λ(z) = (μ(z) − r)² / Σ(z)` (p. 12). -/
noncomputable def lam (z : ℝ) : ℝ := (M.μ z - M.r) ^ 2 / M.Sig z

/-- The standing assumptions of §2 (pp. 4–5) together with the positivity the paper asserts on
p. 12: `ℙ` is a probability; `W` is a standard two-dimensional Brownian motion; `N` is an
`{𝓕_t}`-Poisson random measure with compensator `ds ⊗ ν`; `ν` is finite with no mass at `0`;
`W` and `N` are independent; `μ, σ, a, b` are continuous, `γ` is measurable, continuous in `z`,
`γ > −1` and `∫ γ(z, p)² ν(dp) < ∞`; `ρ_W² + ρ̄_W² = 1`; `Σ, λ, β > 0`. -/
structure Standing : Prop where
  prob : IsProbabilityMeasure M.P
  brownian : Peng1990.SMP.IsStdBrownian M.P M.W
  poisson : JacodTodorov10.LLN.IsFPoisson M.filt M.P M.ν M.N
  finite_ν : IsFiniteMeasure M.ν
  no_zero_mark : M.ν {0} = 0
  indep : Indep (⨆ s : ℝ≥0, MeasurableSpace.comap (M.W s) inferInstance)
    (⨆ (B : Set (ℝ≥0 × ℝ)) (_ : MeasurableSet B),
      MeasurableSpace.comap (fun ω => JacodTodorov10.LLN.cnt M.N ω B) inferInstance) M.P
  μ_cont : Continuous M.μ
  σ_cont : Continuous M.σ
  a_cont : Continuous M.a
  b_cont : Continuous M.b
  γ_meas : Measurable (Function.uncurry M.γ)
  γ_cont : ∀ p, Continuous fun z => M.γ z p
  γ_gt : ∀ z p, -1 < M.γ z p
  γ_sq : ∀ z, Integrable (fun p => M.γ z p ^ 2) M.ν
  rho : M.ρW ^ 2 + M.ρbarW ^ 2 = 1
  Sig_pos : ∀ z, 0 < M.Sig z
  lam_pos : ∀ z, 0 < M.lam z
  beta_pos : ∀ z, 0 < M.beta z

/-- `X` is a jump-diffusion on `[t, T]` started at `x₀`:
`X_s = x₀ + ∫ₜˢ drift du + ∫ₜˢ d₁ dW¹ + ∫ₜˢ d₂ dW² + ∫ₜˢ∫_ℝ jmp(u, p) Ñ(du, dp)` a.s. for every
`s ∈ [t, T]`. `X` is adapted with a.s. càdlàg paths; the Brownian integrals are Itô integral
processes (`Peng1990.SMP.IsItoIntegral`, so the integrands are in `L²_𝓕`) of the integrands cut
off before `t`; the compensated integral is the path-wise
`Σ_{atoms (u,p), t<u≤s} jmp(u, p) − ∫ₜˢ∫ jmp(u, p) ν(dp) du` (`compSum` at level `0`), with finitely
many atoms in `(t, T]` and `jmp` jointly integrable on `[t, T] × ℝ`. -/
def IsJumpIto (t : ℝ≥0) (x₀ : ℝ) (drift d₁ d₂ : ℝ≥0 → Ω → ℝ) (jmp : ℝ≥0 → Ω → ℝ → ℝ)
    (X : ℝ≥0 → Ω → ℝ) : Prop :=
  StronglyAdapted M.filt X ∧
    (∀ᵐ ω ∂M.P, KurtzProtter91.Integrals.IsCadlag fun u => X u ω) ∧
    ∃ J₁ J₂ : ℝ≥0 → Ω → ℝ,
      Peng1990.SMP.IsItoIntegral M.filt M.P M.T (fun u ω => M.W u ω 0)
        (fun u ω => if t < u then d₁ u ω else 0) J₁ ∧
      Peng1990.SMP.IsItoIntegral M.filt M.P M.T (fun u ω => M.W u ω 1)
        (fun u ω => if t < u then d₂ u ω else 0) J₂ ∧
      ∀ s : ℝ≥0, t ≤ s → s ≤ M.T → ∀ᵐ ω ∂M.P,
        {q : ℝ≥0 × ℝ | q ∈ M.N ω ∧ t < q.1 ∧ q.1 ≤ M.T}.Finite ∧
        IntegrableOn (fun u : ℝ => drift u.toNNReal ω) (Set.Icc (t : ℝ) M.T) ∧
        Integrable (fun q : ℝ × ℝ => jmp q.1.toNNReal ω q.2)
          ((volume.restrict (Set.Icc (t : ℝ) M.T)).prod M.ν) ∧
        X s ω = x₀ + (∫ u in (t : ℝ)..(s : ℝ), drift u.toNNReal ω) + (J₁ s ω - J₁ t ω)
          + (J₂ s ω - J₂ t ω)
          + (JacodTodorov10.LLN.compSum M.ν M.N
                (fun ω' u p => if t < u then jmp u ω' p else 0) 0 s ω
              - JacodTodorov10.LLN.compSum M.ν M.N
                (fun ω' u p => if t < u then jmp u ω' p else 0) 0 t ω)

/-- `Z = Z^{z,t}` is the factor process of (3) on `[t, T]` started at `Z_t = z`:
`dZ_s = a(Z_s) ds + b(Z_s)(ρ_W dW¹_s + ρ̄_W dW²_s)`, with a.s. continuous paths. -/
def IsFactor (t : ℝ≥0) (z : ℝ) (Z : ℝ≥0 → Ω → ℝ) : Prop :=
  M.IsJumpIto t z (fun u ω => M.a (Z u ω)) (fun u ω => M.b (Z u ω) * M.ρW)
      (fun u ω => M.b (Z u ω) * M.ρbarW) (fun _ _ _ => 0) Z ∧
    ∀ᵐ ω ∂M.P, Continuous fun u => Z u ω

end Market

end MonotoneMVJump.Compare


