theorem Formalism.FourierDecayAlt.P.SignAntidiagonal.Tn_XS (j : ℕ) (hj : j ≤ r) (y : Fin j → Fin (2 * r + k + 1) → ℂ) (p q : Fin (2 * r + k + 1))
