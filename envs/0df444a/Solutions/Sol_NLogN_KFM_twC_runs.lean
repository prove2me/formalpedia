/-- A numerator within `1` of a point of the unit disc has `Δ + 2`-bit components. -/
theorem zsz_of_near (Δ : ℕ) (z : GI) (Z : ℂ) (hZ : ‖Z‖ ≤ 1) (h : ‖vP Δ z - Z‖ ≤ 1) :
    zsz z.1 ≤ Δ + 2 ∧ zsz z.2 ≤ Δ + 2 := by
  have hv : ‖vP Δ z‖ ≤ 2 := by
    have := norm_add_le Z (vP Δ z - Z); simp only [add_sub_cancel] at this; linarith
  have h2 : (0 : ℝ) < 2 ^ Δ := by positivity
  have ht : ‖NLogN.KFB.toC z‖ ≤ 2 ^ (Δ + 1) := by
    have e : NLogN.KFB.toC z = vP Δ z * 2 ^ Δ := by
      simp only [vP]; field_simp
    rw [e, norm_mul, norm_pow, Complex.norm_two, pow_succ]; nlinarith
  have hre : |(z.1 : ℝ)| ≤ 2 ^ (Δ + 1) := by
    have := Complex.abs_re_le_norm (NLogN.KFB.toC z); rw [show (NLogN.KFB.toC z).re = z.1 by simp [NLogN.KFB.toC]] at this; linarith
  have him : |(z.2 : ℝ)| ≤ 2 ^ (Δ + 1) := by
    have := Complex.abs_im_le_norm (NLogN.KFB.toC z); rw [show (NLogN.KFB.toC z).im = z.2 by simp [NLogN.KFB.toC]] at this; linarith
  have key : ∀ x : ℤ, |(x : ℝ)| ≤ 2 ^ (Δ + 1) → zsz x ≤ Δ + 2 := by
    intro x hx
    apply zsz_le_of_lt
    have : (x.natAbs : ℝ) ≤ 2 ^ (Δ + 1) := by
      rw [Nat.cast_natAbs, Int.cast_abs]; exact hx
    have h3 : (x.natAbs : ℝ) < 2 ^ (Δ + 2) := by
      rw [pow_succ 2 (Δ + 1)]; nlinarith [show (0 : ℝ) < 2 ^ (Δ + 1) by positivity]
    exact_mod_cast h3
  exact ⟨key _ hre, key _ him⟩

section IL

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem rs_cost_seq (a b : RS) (s : IState HS) : (RS.seq a b).cost s = a.cost s + b.cost (a.run s) :=
  rfl

theorem rs_ok_seq (a b : RS) (s : IState HS) : (RS.seq a b).ok s ↔ a.ok s ∧ b.ok (a.run s) :=
  Iff.rfl

theorem push_lit_ok (r : Fin HS) (hr : r.val < 56) (c : ℤ) (s : IState HS) :
    (RS.push r (.lit c)).ok s := ⟨hr, fun i hi => by simp [Ex.regs] at hi, trivial⟩

theorem push_lit_run (r : Fin HS) (c : ℤ) (s : IState HS) :
    (RS.push r (.lit c)).run s = s.upd r (.int c :: s.G r) := by simp [RS.run, Ex.eval]

theorem push_lit_cost (r : Fin HS) (c : ℤ) (s : IState HS) (B : ℕ) (hB : zsz c ≤ B) :
    (RS.push r (.lit c)).cost s ≤ 2 * 10 ^ 7 * (B + 2) ^ 2 := by
  have := RS.pushCost_le (.lit c) s B hB
  simp only [RS.cost, Ex.size] at this ⊢; linarith

theorem pop_ok' (r : Fin HS) (hr : r.val < 56) (s : IState HS) (v : ℤ) (L : List Item)
    (h : s.G r = .int v :: L) : (RS.pop r).ok s := ⟨hr, L, by simp [IState.top, h]⟩

theorem pop_run' (r : Fin HS) (s : IState HS) (v : ℤ) (L : List Item)
    (h : s.G r = .int v :: L) : (RS.pop r).run s = s.upd r L := by simp [RS.run, h]

theorem pop_cost' (r : Fin HS) (s : IState HS) (v : ℤ) (L : List Item)
    (h : s.G r = .int v :: L) : (RS.pop r).cost s = 2 * zsz v + 2 := by
  simp [RS.cost, IState.top_eq h]

theorem twRS_spec (n k j : ℕ) (s : IState HS) :
    (twRS n k j).ok s ∧ (twRS n k j).run s =
      (s.upd 51 (.int (HvdH.twiddle n k j).1 :: s.G 51)).upd 52 (.int (HvdH.twiddle n k j).2 :: s.G 52) ∧
    (twRS n k j).cost s ≤ twiddleCost n (zsz (j : ℤ)) (zsz (k : ℤ)) +
      7 * 10 ^ 7 * (zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) + 2) ^ 2 := by
  set B := zsz (n : ℤ) + zsz (k : ℤ) + zsz (j : ℤ) with hB
  set u1 := s.upd 28 (.int n :: s.G 28) with hu1
  set u2 := u1.upd 29 (.int k :: s.G 29) with hu2
  set u3 := u2.upd 53 (.int j :: s.G 53) with hu3
  have e1 : (RS.push 28 (.lit n)).run s = u1 := by rw [push_lit_run]
  have e2 : (RS.push 29 (.lit k)).run u1 = u2 := by
    rw [push_lit_run]; simp +decide [hu2, hu1]
  have e3 : (RS.push 53 (.lit j)).run u2 = u3 := by
    rw [push_lit_run]; simp +decide [hu3, hu2, hu1]
  obtain ⟨o4, r4⟩ := twiddleP_spec n k j u3 (s.G 28) (s.G 29) (s.G 53) (by simp +decide [hu3, hu2, hu1])
    (by simp +decide [hu3, hu2, hu1]) (by simp +decide [hu3, hu2, hu1])
  have c4 := twiddleP_cost n k j u3 (s.G 28) (s.G 29) (s.G 53) (by simp +decide [hu3, hu2, hu1])
    (by simp +decide [hu3, hu2, hu1]) (by simp +decide [hu3, hu2, hu1])
  set u4 := (u3.upd 51 (.int (HvdH.twiddle n k j).1 :: u3.G 51)).upd 52
    (.int (HvdH.twiddle n k j).2 :: u3.G 52) with hu4
  have g5 : u4.G 53 = .int j :: s.G 53 := by simp +decide [hu4, hu3]
  set u5 := u4.upd 53 (s.G 53) with hu5
  have g6 : u5.G 29 = .int k :: s.G 29 := by simp +decide [hu5, hu4, hu3, hu2]
  set u6 := u5.upd 29 (s.G 29) with hu6
  have g7 : u6.G 28 = .int n :: s.G 28 := by simp +decide [hu6, hu5, hu4, hu3, hu2, hu1]
  refine ⟨?_, ?_, ?_⟩
  · simp only [twRS, rs_ok_seq]
    rw [e1, e2, e3, r4, pop_run' 53 u4 _ _ g5, pop_run' 29 u5 _ _ g6]
    exact ⟨push_lit_ok 28 (by decide) _ _, push_lit_ok 29 (by decide) _ _,
      push_lit_ok 53 (by decide) _ _, o4, pop_ok' 53 (by decide) _ _ _ g5,
      pop_ok' 29 (by decide) _ _ _ g6, pop_ok' 28 (by decide) _ _ _ g7⟩
  · simp only [twRS, RS.run_seq]
    rw [e1, e2, e3, r4, pop_run' 53 u4 _ _ g5, pop_run' 29 u5 _ _ g6, pop_run' 28 u6 _ _ g7]
    simp only [hu6, hu5, hu4, hu3, hu2, hu1]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · simp only [twRS, rs_cost_seq]
    rw [e1, e2, e3, r4, pop_cost' 53 u4 _ _ g5, pop_run' 53 u4 _ _ g5, pop_cost' 29 u5 _ _ g6,
      pop_run' 29 u5 _ _ g6, pop_cost' 28 u6 _ _ g7]
    have p1 := push_lit_cost 28 n s B (by omega)
    have p2 := push_lit_cost 29 k u1 B (by omega)
    have p3 := push_lit_cost 53 j u2 B (by omega)
    have hsq : B ≤ (B + 2) ^ 2 := by nlinarith
    have hf : 4 ≤ (B + 2) ^ 2 := by nlinarith
    omega

end IL

end NLogN.KFM

