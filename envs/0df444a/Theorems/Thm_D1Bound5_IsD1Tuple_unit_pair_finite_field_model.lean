theorem _root_.D1Bound5.IsD1Tuple.unit_pair_finite_field_model
    {K : Type*} [Field K] [NumberField K] [NumberField.IsTotallyComplex K]
    (hK : finrank ℚ K = 2) (phi : K →+* ℂ)
    (t : Fin 6 → 𝓞 K) (ht : IsD1Tuple t)
    (hm : t 0 = -1) (hp : t 1 = 1)
    (hmon : Monotone (fun i => ‖phi (t i : K)‖)) :
    ∃ M : UnitPairArithmeticModel (𝓞 K),
      7 ≤ M.d ∧ M.d < 10000 ∧ M.d % 8 = 7 ∧
      ∀ i : Fin 4, UnitPairRealDescription M.d (t ⟨i.val+2,by omega⟩) := by sorry

end D1Bound5
