  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

namespace Hyp14

variable {c : Cfg} {P K D S r p w Z : ℕ} {lamp : ℝ} (h : Hyp14 c P K D S r p w Z lamp)
include h

theorem Z3r : (Z + 1) ^ 3 ≤ r := by
  have a : (Z + 1) ^ 3 ≤ (2 * Z + 4) ^ 3 := Nat.pow_le_pow_left (by omega) 3
  have := h.rZ
  omega

theorem U_le : Yu r (3 * Z) (chV c (cWc c) P K D S r w).H ≤ 25 * (r * (w + 1)) := by
  have hH := h.H_le
  unfold Yu
  have a : r * (2 * (chV c (cWc c) P K D S r w).H + 21) ≤ 23 * (r * (w + 1)) := by
    calc r * (2 * (chV c (cWc c) P K D S r w).H + 21) ≤ r * (23 * (w + 1)) :=
          Nat.mul_le_mul_left _ (by omega)
      _ = 23 * (r * (w + 1)) := by ring
  have b : 2 * (3 * Z + 2) ≤ 3 * (2 * Z + 4) := by omega
  have b3 := Nat.pow_le_pow_left b 3
  rw [mul_pow, mul_pow] at b3
  have hr := h.rZ
  have hrw : r ≤ r * (w + 1) := Nat.le_mul_of_pos_right _ (by omega)
  norm_num at b3
  omega

theorem n_pos : 1 ≤ P * 2 ^ (K * D) * S := by
  have := Nat.mul_le_mul (Nat.mul_le_mul h.P1 (Nat.one_le_two_pow (n := K * D))) h.S1
  simpa using this

theorem D_le_n : D ≤ P * 2 ^ (K * D) * S := by
  have a : D ≤ K * D := Nat.le_mul_of_pos_left _ (by have := h.K6; omega)
  have b : K * D < 2 ^ (K * D) := Nat.lt_two_pow_self
  have c := h.n_ge
  omega

theorem za_le (hc : CfgOK c) : (chV c (cWc c) P K D S r w).za ≤ 3 * Z := by
  have e : (chV c (cWc c) P K D S r w).Zl = (chV c (cWc c) P K D S r w).za + K * D := rfl
  have a := h.Zl_le_Z hc
  rw [← chV_Zl c (cWc c), e] at a
  have : c.Wr ≤ Zc c := by unfold Zc; omega
  have := h.Zc_lt_Z
  omega

theorem zaV (hc : CfgOK c) : (chV c (cWc c) P K D S r w).za * (3 * Z + 3) ^ 2 ≤ 27 * r := by
  have a := h.za_le hc
  have b : (chV c (cWc c) P K D S r w).za * (3 * Z + 3) ^ 2 ≤ 3 * Z * (3 * Z + 3) ^ 2 :=
    Nat.mul_le_mul_right _ a
  have e : 3 * Z * (3 * Z + 3) ^ 2 = 27 * (Z * (Z + 1) ^ 2) := by ring
  have f : Z * (Z + 1) ^ 2 ≤ (Z + 1) ^ 3 := by
    have : Z * (Z + 1) ^ 2 ≤ (Z + 1) * (Z + 1) ^ 2 := Nat.mul_le_mul_right _ (by omega)
    calc Z * (Z + 1) ^ 2 ≤ (Z + 1) * (Z + 1) ^ 2 := this
      _ = (Z + 1) ^ 3 := by ring
  have := h.Z3r
  omega

theorem mv_le : 16 * (2 * moveCost Z + 19) + 2 ≤ 2000 * r := by
  have a := h.Z3r
  have b : Z + 1 ≤ (Z + 1) ^ 3 := by
    calc Z + 1 = (Z + 1) ^ 1 := (pow_one _).symm
      _ ≤ (Z + 1) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  unfold moveCost
  omega

theorem loops_le (hc : CfgOK c) :
    (chV c (cWc c) P K D S r w).G + (chV c (cWc c) P K D S r w).d +
      (chV c (cWc c) P K D S r w).q0 + (chV c (cWc c) P K D S r w).qB ≤
      (2 * c.Wr + 14) * ((zsz (p : ℤ) + 1) * (P * 2 ^ (K * D) * S)) := by
  have hG := h.G_le hc
  rw [← chV_G c (cWc c) P K D S r w] at hG
  have hd : (chV c (cWc c) P K D S r w).d ≤ D := dep_le_self hc.m1 D
  have hq := h.qq_le
  have hDn := h.D_le_n
  have hn := h.n_pos
  generalize P * 2 ^ (K * D) * S = n at *
  generalize zsz (p : ℤ) = s at *
  have k1 : s + n ≤ (s + 1) * n := by nlinarith
  have k2 : 1 ≤ (s + 1) * n := Nat.mul_pos (by omega) hn
  have k3 : (2 * c.Wr + 14) * ((s + 1) * n) = 2 * c.Wr * ((s + 1) * n) + 14 * ((s + 1) * n) := by
    ring
  have k4 : 2 * c.Wr ≤ 2 * c.Wr * ((s + 1) * n) := Nat.le_mul_of_pos_right _ k2
  omega

set_option maxHeartbeats 1000000 in
/-- The natural-number part of the cost bound. -/
theorem cost_nat_sol_aux (hc : CfgOK c) (CB : ℕ → ℝ) :
    8 * (2 * moveCost Z + 19) + (cChainH c CB (cWc c) P K D S r w Z (3 * Z) (3 * Z) +
      8 * (2 * moveCost Z + 19)) + 2 ≤
      ((chV c (cWc c) P K D S r w).q0 + (chV c (cWc c) P K D S r w).qB) *
        ⌊CB 1 * ((P * 2 ^ (K * D) * S * Yu r (3 * Z) (chV c (cWc c) P K D S r w).H : ℕ) : ℝ)⌋₊ +
      401 * ⌊CB (D - (chV c (cWc c) P K D S r w).q0 - (chV c (cWc c) P K D S r w).qB) *
        (((chV c (cWc c) P K D S r w).Bp * 2 ^ (K * (D - (chV c (cWc c) P K D S r w).q0)) * S *
          Yu r (3 * Z) (chV c (cWc c) P K D S r w).H : ℕ) : ℝ)⌋₊ +
      10 ^ 17 * (((Sc c + 1) * (2 * c.Wr + 14)) *
        ((P * 2 ^ (K * D) * S) * (r * (w + 1)) * (zsz (p : ℤ) + 1))) := by
  have hZr : 3 * Z + 2 ≤ r := by
    have := h.rZ
    have : 2 * Z + 4 ≤ (2 * Z + 4) ^ 3 := Nat.le_self_pow (by norm_num) _
    omega
  have CH := cChainH_le (c := c) CB (cW := cWc c) (P := P) (K := K) (D := D) (S := S) (r := r)
    (w := w) (Z := Z) (Zr := 3 * Z) (Bz := 3 * Z) h.S1 h.P1 le_rfl (by omega) hZr (h.body_w hc)
    (h.Etot_le hc) (h.Etot_Z hc) (h.np_le hc)
  have hU := h.U_le
  have hL := h.loops_le hc
  have hzV := h.zaV hc
  have hmv := h.mv_le
  have hn := h.n_pos
  set v := chV c (cWc c) P K D S r w with hv
  set U := Yu r (3 * Z) v.H with hUd
  set n := P * 2 ^ (K * D) * S with hnd
  set s := zsz (p : ℤ) with hs
  set R := r * (w + 1) with hR
  have hrR : r ≤ R := Nat.le_mul_of_pos_right _ (by omega)
  have hrM : r ≤ n * R * (s + 1) := by
    have : R ≤ n * R := Nat.le_mul_of_pos_left _ hn
    have : n * R ≤ n * R * (s + 1) := Nat.le_mul_of_pos_right _ (by omega)
    omega
  -- the loop term
  have N1 : (v.G + v.d + v.q0 + v.qB) * ((Sc c + 1) * U) ≤
      25 * (((Sc c + 1) * (2 * c.Wr + 14)) * (n * R * (s + 1))) := by
    calc (v.G + v.d + v.q0 + v.qB) * ((Sc c + 1) * U)
        ≤ ((2 * c.Wr + 14) * ((s + 1) * n)) * ((Sc c + 1) * (25 * R)) :=
          Nat.mul_le_mul hL (Nat.mul_le_mul_left _ hU)
      _ = 25 * (((Sc c + 1) * (2 * c.Wr + 14)) * (n * R * (s + 1))) := by ring
  have N2 : v.za * ((Sc c + 1) * (3 * Z + 3) ^ 2) ≤ 27 * ((Sc c + 1) * (n * R * (s + 1))) := by
    calc v.za * ((Sc c + 1) * (3 * Z + 3) ^ 2) = (Sc c + 1) * (v.za * (3 * Z + 3) ^ 2) := by ring
      _ ≤ (Sc c + 1) * (27 * r) := Nat.mul_le_mul_left _ hzV
      _ ≤ (Sc c + 1) * (27 * (n * R * (s + 1))) := Nat.mul_le_mul_left _ (by omega)
      _ = 27 * ((Sc c + 1) * (n * R * (s + 1))) := by ring
  have N3 : (Sc c + 1) * (n * U) ≤ 25 * ((Sc c + 1) * (n * R * (s + 1))) := by
    calc (Sc c + 1) * (n * U) ≤ (Sc c + 1) * (n * (25 * R)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hU)
      _ = 25 * ((Sc c + 1) * (n * R)) := by ring
      _ ≤ 25 * ((Sc c + 1) * (n * R * (s + 1))) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right _ (by omega)))
  have N6 : 16 * ((Sc c + 1) * (n * R * (s + 1))) ≤
      ((Sc c + 1) * (2 * c.Wr + 14)) * (n * R * (s + 1)) := by
    calc 16 * ((Sc c + 1) * (n * R * (s + 1))) = (16 * (Sc c + 1)) * (n * R * (s + 1)) := by ring
      _ ≤ ((Sc c + 1) * (2 * c.Wr + 14)) * (n * R * (s + 1)) :=
          Nat.mul_le_mul_right _ (by
            have := h.Wr1 hc
            rw [mul_comm 16]; exact Nat.mul_le_mul_left _ (by omega))
  have N7 : n * R * (s + 1) ≤ (Sc c + 1) * (n * R * (s + 1)) := Nat.le_mul_of_pos_left _ (by omega)
  have hmv' : 16 * (2 * moveCost Z + 19) + 2 ≤ 2000 * (n * R * (s + 1)) := by omega
  generalize cChainH c CB (cWc c) P K D S r w Z (3 * Z) (3 * Z) = cc at *
  generalize ⌊CB 1 * ((n * U : ℕ) : ℝ)⌋₊ = F1 at *
  generalize ⌊CB (D - v.q0 - v.qB) * ((v.Bp * 2 ^ (K * (D - v.q0)) * S * U : ℕ) : ℝ)⌋₊ = Fm at *
  generalize (v.G + v.d + v.q0 + v.qB) * ((Sc c + 1) * U) = A1 at *
  generalize v.za * ((Sc c + 1) * (3 * Z + 3) ^ 2) = A2 at *
  generalize (Sc c + 1) * (n * U) = A3 at *
  generalize ((Sc c + 1) * (2 * c.Wr + 14)) * (n * R * (s + 1)) = XM at *
  generalize (Sc c + 1) * (n * R * (s + 1)) = SM at *
  generalize n * R * (s + 1) = M at *
  simp only [Nat.reducePow] at *
  omega

end Hyp14

