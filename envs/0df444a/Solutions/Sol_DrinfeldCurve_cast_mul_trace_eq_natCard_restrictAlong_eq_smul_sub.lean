  refine _root_.TwoB.trace_rationalGaloisRep_mul_toV_eq ℓ (AlgebraicCurve.Pic0 k (drinfeldFunctionField q k)) E
    (hFunctionFieldAction q k h'⁻¹) ΦPic _ ?_

  have hα : ∀ D : AlgebraicCurve.Divisor.degZero (K := k) (F := drinfeldFunctionField q k),
      ((DistribSMul.toAddMonoidHom (AlgebraicCurve.Pic0 k (drinfeldFunctionField q k))
        (hFunctionFieldAction q k h'⁻¹)).comp ΦPic) (AlgebraicCurve.Pic0.mk D) =
