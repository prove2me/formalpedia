-- title:
--   Fact 1, p. 3 — (E(k)) is nonincreasing and lim E(k) exists (finite)
-- statement:
--   Under the standing assumptions of §1 ($\Psi$ proper, lower semicontinuous and convex with values in $\mathbb R\cup\{+\infty\}$; $\Phi$ real, convex, continuously differentiable with $L$-Lipschitz gradient; $\Theta=\Psi+\Phi$; $0<s<1/L$; $\alpha\ge3$; $(x_k)$ generated by algorithm (2)), let $x^*$ minimize $\Theta$ and let $\mathcal E(k)$ be the energy (5). Then
--   $$\mathcal E(k+1)\le\mathcal E(k)\quad\text{for every }k\ge1,$$
--   and there is a real number $\ell$ with
--   $$\lim_{k\to\infty}\mathcal E(k)=\ell .$$
--
--   Monotonicity and convergence of the energy give the $O(k^{-2})$ bound of Fact 2 and the boundedness of $(z_k)$.
--
--   **Formalization Note.** The limit is a *real* number: in the extended reals every monotone sequence converges, so "the limit exists" is stated as convergence to the image of some $\ell\in\mathbb R$. Monotonicity is claimed from $k=1$, where the run starts; $\mathcal E(1)$ may be $+\infty$.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 3, Fact 1

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem fact_1 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 ≤ α)
    (xstar : H) (hxstar : ∀ y, theta Ψ Φ xstar ≤ theta Ψ Φ y) :
    (∀ k : ℕ, 1 ≤ k → energy Ψ Φ α s x xstar (k + 1) ≤ energy Ψ Φ α s x xstar k) ∧
      ∃ l : ℝ, Tendsto (fun k : ℕ => energy Ψ Φ α s x xstar k) atTop (𝓝 (l : EReal)) := by sorry

end NesterovFB.Rates
