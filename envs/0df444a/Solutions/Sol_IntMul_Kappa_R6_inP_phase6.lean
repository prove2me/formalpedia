/-! ## List facts -/

theorem prod_map_range (f : ℕ → ℕ) : ∀ d : ℕ,
    ((List.range d).map f).prod = ∏ j ∈ Finset.range d, f j
  | 0 => rfl
  | d + 1 => by
    rw [List.range_succ, List.map_append, List.prod_append, prod_map_range f d,
      Finset.prod_range_succ]
    simp

theorem vol_shK (d : ℕ) (sF : ℕ → ℕ) :
    vol (shK d (sP d sF)) = 2 * ∏ j ∈ Finset.range d, sF j := by
  rw [shK_eq_app, vol, List.prod_append, List.prod_reverse, prod_map_range]
  have e : ∏ j ∈ Finset.range d, sP d sF j = ∏ j ∈ Finset.range d, sF j :=
    Finset.prod_congr rfl fun j hj => by simp [sP, Finset.mem_range.1 hj]
  rw [e]; simp [sP]; ring

theorem vol_shR (d : ℕ) (f : ℕ → ℕ) :
    vol (shR d f) = (∏ j ∈ Finset.range d, f j) * f d := by
  rw [shR_eq_app, vol, List.prod_append, prod_map_range]; simp

theorem length_PhiD (h d : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (xs : List ℤ) :
    (PhiD h d bL sF μ xs).length = vol (shR d (tP d h bL)) := by
  rw [PhiD, AModelL12.length_embed]

theorem tP_last (d h : ℕ) (bL : ℕ → Bool) : tP d h bL d = 2 := by
  simp [tP_eq]

theorem digG_GB (b e M S x w : ℕ) (hw : b + e ≤ w) : GB w (digG b e M S x) := by
  intro z hz
  simp only [digG, List.mem_append, List.mem_map, List.mem_replicate] at hz
  rcases hz with ⟨a, ha, rfl⟩ | ⟨-, rfl⟩
  · obtain ⟨h0, h1⟩ := chk_lt b M x a ha
    refine ⟨KFL.zsz_le_of_abs ?_, by rw [zsz_zero]; omega⟩
    rw [abs_of_nonneg (by positivity)]
    calc a * 2 ^ e < 2 ^ b * 2 ^ e := by gcongr
      _ = 2 ^ (b + e) := by rw [pow_add]
      _ ≤ 2 ^ w := pow_le_pow_right₀ (by norm_num) hw
  · exact ⟨by rw [zsz_zero]; omega, by rw [zsz_zero]; omega⟩

/-! ## Scales -/

theorem scale_eq (e b p : ℕ) (h : e + (b + 2) = p) :
    (2 : ℂ) ^ e / 2 ^ p = (2 : ℂ)⁻¹ ^ (b + 2) := by
  subst h; rw [pow_add, inv_pow]; field_simp

theorem norm_dgt_le {κ : Type*} [Fintype κ] (b M x : ℕ) (f : κ → ℕ) :
    ‖(fun k => (2 : ℂ)⁻¹ ^ (b + 2) * (dgt b M x (f k) : ℂ))‖ ≤ 1 / 4 := by
  refine (pi_norm_le_iff_of_nonneg (by norm_num)).2 fun k => ?_
  have h1 : (dgt b M x (f k) : ℝ) ≤ 2 ^ b := by exact_mod_cast (dgt_lt b M x (f k)).le
  rw [norm_mul, norm_pow, norm_inv, Complex.norm_ofNat, Complex.norm_natCast]
  have e : (2 : ℝ)⁻¹ ^ (b + 2) * 2 ^ b = 1 / 4 := by
    rw [inv_pow, pow_add]; field_simp; norm_num
  calc (2 : ℝ)⁻¹ ^ (b + 2) * (dgt b M x (f k) : ℝ) ≤ (2 : ℝ)⁻¹ ^ (b + 2) * 2 ^ b := by gcongr
    _ = 1 / 4 := e

/-! ## Sizes -/

theorem le_bM {n : ℕ} (hn : n0 ≤ n) : n ≤ bP n * mN n := by
  have hb := (setup_facts hn).1
  have h1 : 0 < bP n := by omega
  unfold mN
  have := Nat.div_add_mod (n + bP n - 1) (bP n)
  have := Nat.mod_lt (n + bP n - 1) h1
  omega

theorem restore (s : IState HS) {i j : Fin HS} (h : i ≠ j) (L A : List Item) :
    ((s.upd i L).upd j A).upd j (s.G j) = s.upd i L := by
  rw [IState.upd_upd_same, show s.G j = (s.upd i L).G j by simp [IState.upd_G, Ne.symm h],
    IState.upd_self]

/-! ## The input phase -/

