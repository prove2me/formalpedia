-- Source module: Solutions.KILBase
/-!
# KIL base: register programs on "managed" stacks

`encK s f` is the state `s` with the list of integers `f j` pushed on top of every stack `j`
(`f j = []` for unmanaged stacks).  All programs of the KIL files are specified on such states;
updates are `Function.update`s of `f`, which keeps the bookkeeping small.

`Sp p s t c` : the register program `p` is executable from `s` (`RS.ok`), ends in `t`, and costs
at most `c`.  `Sp.irun` turns it into an `IRuns` of the compiled item-language code.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

namespace KIL

/-- `s` with `f j` on top of each stack `j`. -/
def encK (s : IState HS) (f : Fin HS → List ℤ) : IState HS :=
  { s with G := fun j => ints (f j) ++ s.G j }

@[simp] theorem encK_G (s : IState HS) (f : Fin HS → List ℤ) (j : Fin HS) :
    (NLogN.KIL.encK s f).G j = ints (f j) ++ s.G j := rfl
@[simp] theorem encK_ip (s : IState HS) (f : Fin HS → List ℤ) : (NLogN.KIL.encK s f).ip = s.ip := rfl
@[simp] theorem encK_out (s : IState HS) (f : Fin HS → List ℤ) : (NLogN.KIL.encK s f).out = s.out := rfl

/-- Specification of a register program. -/
def Sp (p : RS) (s t : IState HS) (c : ℕ) : Prop := p.ok s ∧ p.run s = t ∧ p.cost s ≤ c

