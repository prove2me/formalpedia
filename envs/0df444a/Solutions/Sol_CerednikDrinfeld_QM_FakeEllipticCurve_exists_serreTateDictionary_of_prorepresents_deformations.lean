  obtain ⟨X₁, θ₁, w₁, hrig₁, hP₁⟩ := Φ_spec coord θ₀ resR Xu wu resA H hs hc E g hg
  obtain ⟨t, ht, htw⟩ := hrig.transfer H.hcoord H.hqO H.hX₀ hs hc hg hrig₁
