-- title:
--   PALM: the proximal map (2.2), Assumption B(i)–(iii), runs (3.3)–(3.4), the vectors (3.18)–(3.19), the limit point set ω(z⁰) and crit Ψ
-- statement:
--   This file fixes the model of Bolte, Sabach and Teboulle's *Proximal Alternating Linearized Minimization* (PALM) on top of the published setting of the problem
--   $$\text{(M)}\qquad \min_{(x,y)\in\mathbb R^n\times\mathbb R^m}\ \Psi(x,y)=f(x)+g(y)+H(x,y),$$
--   where $f:\mathbb R^n\to(-\infty,+\infty]$, $g:\mathbb R^m\to(-\infty,+\infty]$ and $H:\mathbb R^n\times\mathbb R^m\to\mathbb R$. The product $\mathbb R^n\times\mathbb R^m$ carries the Euclidean norm $\|(x,y)\|^2=\|x\|^2+\|y\|^2$; $\nabla_xH$ and $\nabla_yH$ are the two components of $\nabla H$. Assumption A together with Assumption B(iv) ($f,g$ proper and lower semicontinuous, $H\in C^1$, $\nabla H$ Lipschitz on bounded sets) is the published predicate `AssumptionH`.
--
--   **The proximal map (2.2).** For $\sigma$ with values in $(-\infty,+\infty]$, $t\in\mathbb R$ and $x$,
--   $$\operatorname{prox}^\sigma_t(x)=\operatorname*{argmin}_u\Big\{\sigma(u)+\frac t2\|u-x\|^2\Big\},$$
--   a set (possibly with several elements, possibly empty).
--
--   **Assumption B(i)–(iii)**, for given modulus functions $L_1:\mathbb R^m\to\mathbb R$, $L_2:\mathbb R^n\to\mathbb R$, sequences $(x^k)$, $(y^k)$ and constants $\lambda_1^-,\lambda_1^+,\lambda_2^-,\lambda_2^+$:
--   1. $\inf\Psi>-\infty$, $\inf f>-\infty$, $\inf g>-\infty$;
--   2. $\|\nabla_xH(x_1,y)-\nabla_xH(x_2,y)\|\le L_1(y)\|x_1-x_2\|$ for all $y,x_1,x_2$, and $\|\nabla_yH(x,y_1)-\nabla_yH(x,y_2)\|\le L_2(x)\|y_1-y_2\|$ for all $x,y_1,y_2$;
--   3. $\lambda_i^\pm>0$, and $\lambda_1^-\le L_1(y^k)\le\lambda_1^+$, $\lambda_2^-\le L_2(x^k)\le\lambda_2^+$ for every $k\ge0$ (this is (3.5)–(3.6)).
--
--   **PALM runs.** With $c_k=\gamma_1L_1(y^k)$ and $d_k=\gamma_2L_2(x^{k+1})$, a pair of sequences is generated by PALM when for every $k\ge0$
--   $$x^{k+1}\in\operatorname{prox}^f_{c_k}\Big(x^k-\frac1{c_k}\nabla_xH(x^k,y^k)\Big),\qquad y^{k+1}\in\operatorname{prox}^g_{d_k}\Big(y^k-\frac1{d_k}\nabla_yH(x^{k+1},y^k)\Big).$$
--   The starting point $(x^0,y^0)$ is arbitrary and any element of the prox set may be chosen.
--
--   **The vectors (3.18)–(3.19)**, for $k\ge1$:
--   $$A^k_x=c_{k-1}(x^{k-1}-x^k)+\nabla_xH(x^k,y^k)-\nabla_xH(x^{k-1},y^{k-1}),\qquad A^k_y=d_{k-1}(y^{k-1}-y^k)+\nabla_yH(x^k,y^k)-\nabla_yH(x^k,y^{k-1}).$$
--
--   **Limit points and critical points.** $\omega(z^0)$ is the set of points to which some subsequence of $(z^k)$ converges, and $\operatorname{crit}\sigma=\{z: 0\in\partial\sigma(z)\}$ with $\partial$ the limiting subdifferential.
--
--   These objects are shared by every lemma on the way to the finite length theorem.
--
--   **Formalization Note** Values in $(-\infty,+\infty]$ are `EReal`. The prox weight is $t/2$, as in (2.2), not $1/(2t)$. $L_1,L_2$ are parameters (any valid modulus functions), and $\gamma_1,\gamma_2$ are fixed constants of the run; the conditions $\gamma_i>1$ are hypotheses of the theorems. $A^k_x$, $A^k_y$ use natural-number $k-1$ and are meaningful only for $k\ge1$. $\omega(z^0)$ is the set of cluster points of the sequence (`MapClusterPt`), which in a metric space equals the set of subsequential limits.
-- source:
--   Bolte, Sabach, Teboulle, Proximal alternating linearized minimization for nonconvex and nonsmooth problems, Math. Program. 146 (2014), doi:10.1007/s10107-013-0701-9 (source: author version), pp. 6, 7, 10, 16, 17, Remark 2.1(iv)–(v), (2.2), PALM box (3.3)–(3.4), Assumption B (3.5)–(3.6), (3.18)–(3.19), definition of ω(z⁰)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_ProxAltMin_Conv_Setting
open NonconvexSplitting.Shared ProxAltMin.Conv
open Filter Topology

namespace PALM.Conv

/-- The proximal map (2.2) (p. 7), as a set: `u ∈ proxSet σ t x` iff `u` minimizes
`w ↦ σ w + (t/2) ‖w - x‖²`. The weight is `t/2` (not `1/(2t)`). -/
def proxSet {X : Type*} [NormedAddCommGroup X] (σ : X → EReal) (t : ℝ) (x : X) : Set X :=
  {u | ∀ w : X, σ u + ((t / 2 * ‖u - x‖ ^ 2 : ℝ) : EReal) ≤ σ w + ((t / 2 * ‖w - x‖ ^ 2 : ℝ) : EReal)}

/-- Assumption B (i)–(iii) (p. 10) for the PALM sequences `x = (xᵏ)`, `y = (yᵏ)`, the given
modulus functions `L₁ : ℝᵐ → ℝ`, `L₂ : ℝⁿ → ℝ` and the bounds `λ₁⁻, λ₁⁺, λ₂⁻, λ₂⁺`.
(Assumption A and B (iv) are `ProxAltMin.Conv.AssumptionH f H g`.) -/
structure AssumptionB {n m : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (H : Z n m → ℝ)
    (g : EuclideanSpace ℝ (Fin m) → EReal)
    (L₁ : EuclideanSpace ℝ (Fin m) → ℝ) (L₂ : EuclideanSpace ℝ (Fin n) → ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m))
    (lam1m lam1p lam2m lam2p : ℝ) : Prop where
  /-- B (i): `inf Ψ > -∞`, `inf f > -∞`, `inf g > -∞`. -/
  inf_Psi : ∃ c : ℝ, ∀ z : Z n m, (c : EReal) ≤ L f H g z
  inf_f : ∃ c : ℝ, ∀ u, (c : EReal) ≤ f u
  inf_g : ∃ c : ℝ, ∀ v, (c : EReal) ≤ g v
  /-- B (ii): `x ↦ ∇ₓH(x, y)` is `L₁(y)`-Lipschitz for every fixed `y`. -/
  lip_x : ∀ (yy : EuclideanSpace ℝ (Fin m)) (x₁ x₂ : EuclideanSpace ℝ (Fin n)),
    ‖gradX H (pt x₁ yy) - gradX H (pt x₂ yy)‖ ≤ L₁ yy * ‖x₁ - x₂‖
  /-- B (ii): `y ↦ ∇ᵧH(x, y)` is `L₂(x)`-Lipschitz for every fixed `x`. -/
  lip_y : ∀ (xx : EuclideanSpace ℝ (Fin n)) (y₁ y₂ : EuclideanSpace ℝ (Fin m)),
    ‖gradY H (pt xx y₁) - gradY H (pt xx y₂)‖ ≤ L₂ xx * ‖y₁ - y₂‖
  /-- B (iii): the bounds are positive. -/
  lam1m_pos : 0 < lam1m
  lam1p_pos : 0 < lam1p
  lam2m_pos : 0 < lam2m
  lam2p_pos : 0 < lam2p
  /-- B (iii), (3.5)–(3.6): `λ₁⁻ ≤ L₁(yᵏ) ≤ λ₁⁺` for all `k`. -/
  L1_bounds : ∀ k, lam1m ≤ L₁ (y k) ∧ L₁ (y k) ≤ lam1p
  /-- B (iii), (3.5)–(3.6): `λ₂⁻ ≤ L₂(xᵏ) ≤ λ₂⁺` for all `k`. -/
  L2_bounds : ∀ k, lam2m ≤ L₂ (x k) ∧ L₂ (x k) ≤ lam2p

/-- The step parameter `c_k = γ₁ L₁(yᵏ)` of PALM step 2.1 (p. 10). -/
def stepC {m : ℕ} (L₁ : EuclideanSpace ℝ (Fin m) → ℝ) (γ₁ : ℝ)
    (y : ℕ → EuclideanSpace ℝ (Fin m)) (k : ℕ) : ℝ :=
  γ₁ * L₁ (y k)

/-- The step parameter `d_k = γ₂ L₂(xᵏ⁺¹)` of PALM step 2.2 (p. 10). -/
def stepD {n : ℕ} (L₂ : EuclideanSpace ℝ (Fin n) → ℝ) (γ₂ : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (k : ℕ) : ℝ :=
  γ₂ * L₂ (x (k + 1))

/-- `(x, y)` is a sequence generated by PALM (p. 10) with parameters `γ₁, γ₂` and modulus
functions `L₁, L₂`: for every `k`,
`xᵏ⁺¹ ∈ prox^f_{c_k}(xᵏ - (1/c_k) ∇ₓH(xᵏ, yᵏ))` (3.3) and
`yᵏ⁺¹ ∈ prox^g_{d_k}(yᵏ - (1/d_k) ∇ᵧH(xᵏ⁺¹, yᵏ))` (3.4).
The starting point `(x⁰, y⁰)` is arbitrary and every prox point is a selection. -/
def IsPALMRun {n m : ℕ} (f : EuclideanSpace ℝ (Fin n) → EReal) (H : Z n m → ℝ)
    (g : EuclideanSpace ℝ (Fin m) → EReal)
    (L₁ : EuclideanSpace ℝ (Fin m) → ℝ) (L₂ : EuclideanSpace ℝ (Fin n) → ℝ) (γ₁ γ₂ : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m)) : Prop :=
  ∀ k : ℕ,
    x (k + 1) ∈ proxSet f (stepC L₁ γ₁ y k)
        (x k - (1 / stepC L₁ γ₁ y k) • gradX H (pt (x k) (y k))) ∧
    y (k + 1) ∈ proxSet g (stepD L₂ γ₂ x k)
        (y k - (1 / stepD L₂ γ₂ x k) • gradY H (pt (x (k + 1)) (y k)))

/-- The vector `A^k_x` of (3.18) (p. 16), meaningful for `k ≥ 1`:
`c_{k-1}(xᵏ⁻¹ - xᵏ) + ∇ₓH(xᵏ, yᵏ) - ∇ₓH(xᵏ⁻¹, yᵏ⁻¹)`.
(At `k = 0` the natural-number subtraction gives a meaningless value; it is only used for
`k ≥ 1`.) -/
noncomputable def Ax {n m : ℕ} (H : Z n m → ℝ) (L₁ : EuclideanSpace ℝ (Fin m) → ℝ) (γ₁ : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m)) (k : ℕ) :
    EuclideanSpace ℝ (Fin n) :=
  stepC L₁ γ₁ y (k - 1) • (x (k - 1) - x k) + gradX H (pt (x k) (y k)) -
    gradX H (pt (x (k - 1)) (y (k - 1)))

/-- The vector `A^k_y` of (3.19) (p. 16), meaningful for `k ≥ 1`:
`d_{k-1}(yᵏ⁻¹ - yᵏ) + ∇ᵧH(xᵏ, yᵏ) - ∇ᵧH(xᵏ, yᵏ⁻¹)`, where `d_{k-1} = γ₂ L₂(xᵏ)`.
(At `k = 0` the value is meaningless; it is only used for `k ≥ 1`.) -/
noncomputable def Ay {n m : ℕ} (H : Z n m → ℝ) (L₂ : EuclideanSpace ℝ (Fin n) → ℝ) (γ₂ : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y : ℕ → EuclideanSpace ℝ (Fin m)) (k : ℕ) :
    EuclideanSpace ℝ (Fin m) :=
  stepD L₂ γ₂ x (k - 1) • (y (k - 1) - y k) + gradY H (pt (x k) (y k)) -
    gradY H (pt (x k) (y (k - 1)))

/-- The set `ω(z⁰)` of limit points of a sequence (p. 17): the points `w` such that some
subsequence converges to `w`. -/
def limitPoints {X : Type*} [TopologicalSpace X] (z : ℕ → X) : Set X :=
  {w | MapClusterPt w atTop z}

/-- The set `crit σ` of (limiting-)critical points (Remark 2.1 (iv)–(v), p. 6). -/
def critSet {X : Type*} [NormedAddCommGroup X] [InnerProductSpace ℝ X] (σ : X → EReal) : Set X :=
  {w | (0 : X) ∈ LimitingSubdiff σ w}

end PALM.Conv


