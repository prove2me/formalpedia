theorem solution {x : ℝ} (hx : x ∈ UG) : Hc x - x * Gc x = 1 := by
  have hne : ∀ t ∈ Icc (0:ℝ) 1, (1 : ℝ) - t * x ≠ 0 := by
    intro t ht; have h := one_sub_mul_ge hx ht; linarith
  have hcont1 : IntervalIntegrable (fun t : ℝ => (1 - t * x)⁻¹) volume 0 1 := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [uIcc_of_le (by norm_num : (0:ℝ) ≤ 1)]
    exact (continuousOn_const.sub (continuousOn_id.mul continuousOn_const)).inv₀ hne
  have hcont2 : IntervalIntegrable (fun t : ℝ => x * (t * (1 - t * x)⁻¹)) volume 0 1 := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [uIcc_of_le (by norm_num : (0:ℝ) ≤ 1)]
    exact continuousOn_const.mul (continuousOn_id.mul
      ((continuousOn_const.sub (continuousOn_id.mul continuousOn_const)).inv₀ hne))
  rw [Hc_eq, Gc_eq, ← intervalIntegral.integral_const_mul,
    ← intervalIntegral.integral_sub hcont1 hcont2]
  rw [show (∫ t in (0:ℝ)..1, ((1 - t * x)⁻¹ - x * (t * (1 - t * x)⁻¹)))
      = ∫ _t in (0:ℝ)..1, (1:ℝ) from
    intervalIntegral.integral_congr (fun t ht => by
      rw [uIcc_of_le (by norm_num : (0:ℝ) ≤ 1)] at ht
      have h := hne t ht
      field_simp)]
  simp
