-- title:
--   $p$-adic evaluation at a topologically nilpotent unit of $\mathbb{Q}_p$ is surjective
-- statement:
--   Let $0 < r < 1$, let $p$ be a prime, and let $x \in \mathbb{Q}_p$ be a topologically
--   nilpotent unit, i.e. $x \neq 0$ and $|x|_p < 1$. Then evaluation at $x$,
--   $$f_x : \mathbb{Z}((T))_{>r} \to \mathbb{Q}_p, \qquad \sum_n a_n T^n \mapsto \sum_n a_n x^{\,n},$$
--   is surjective.
--
--   This is the $K = \mathbb{Q}_p$ case of the surjectivity assertion in case (3) of Theorem 7.1 of the
--   source, where $K$ is allowed to be any finite extension of $\mathbb{Q}_p$ generated by a
--   topologically nilpotent unit $x$. The argument in the source writes elements of the
--   $\mathbb{Z}_p$-lattice generated by $x$ as convergent sums $\sum a_n x^{\,n}$ with digits
--   $a_n \in \{0, \dots, p^m - 1\}$, obtained by successively projecting to $\Lambda/x^d$ and dividing
--   by $T^d$; bounded digits again give overconvergence for every $r < 1$. Extensions of degree
--   $d > 1$ are outside the scope of this mission.
-- source:
--   Peter Scholze (all results joint with Dustin Clausen), Lectures on Analytic Geometry, Lecture VII, pp. 42-44, Theorem 7.1 (attributed there to D. Harbater, Convergent arithmetic power series, Amer. J. Math. 106 (1984), 801-846). https://www.math.uni-bonn.de/people/scholze/Analytic.pdf

import Mathlib
import Definitions.Def_AnalyticGeometry_ZLaurentGT

namespace AnalyticGeometry

/-- Surjectivity of `p`-adic evaluation at a topologically nilpotent unit `x ∈ ℚ_p`. -/
theorem evalPadic_surjective (r : ℝ) (hr0 : 0 < r) (hr1 : r < 1) (p : ℕ) [hp : Fact p.Prime]
    (x : ℚ_[p]) (hx0 : x ≠ 0) (hx : ‖x‖ < 1) (y : ℚ_[p]) :
    ∃ f ∈ zLaurentGT r,
      Summable (fun n : ℤ => (f.coeff n : ℚ_[p]) * x ^ n) ∧
        ∑' n : ℤ, (f.coeff n : ℚ_[p]) * x ^ n = y := by
  sorry

end AnalyticGeometry
