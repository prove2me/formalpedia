section
-- Reused implementation: Solutions.PhilipponLocalDivisibilityReduction

set_option autoImplicit false

namespace PhilipponMultiplicity

/-- Existing polynomial translation continuity supplies precisely the separate
continuity needed to extend a local prime image to the whole connected group. -/
theorem connected_group_nsmul_surjective_of_prime_interior
    (K : Type*) [Field K] (G : EmbeddedGroupProduct K)
    (hconnected : @_root_.IsConnected _ G.zariskiTopology Set.univ)
    (hlocal : ∀ p : ℕ, p.Prime →
      (@interior _ G.zariskiTopology (Set.range (fun x : G.Point => p • x))).Nonempty) :
    ∀ n : ℕ, 0 < n → Function.Surjective (fun x : G.Point => n • x) := by
  letI : TopologicalSpace G.Point := G.zariskiTopology
  let : PreconnectedSpace G.Point := ⟨hconnected.isPreconnected⟩
  let : SeparatelyContinuousAdd G.Point :=
    { continuous_const_add := fun {a} => G.continuous_translation a
      continuous_add_const := fun {a} => by
        simpa only [add_comm a] using G.continuous_translation a }
  exact LocalPrimeDivisibility.nsmul_surjective_of_prime_interior hlocal

end PhilipponMultiplicity
end

open PhilipponMultiplicity

theorem solution
    (K : Type*) [NontriviallyNormedField K] (hK : IsPhilipponBaseField K)
    (G : EmbeddedGroupProduct K)
    (hconnected : @_root_.IsConnected _ G.zariskiTopology Set.univ) :
    ∀ n : ℕ, 0 < n → Function.Surjective (fun g : G.Point => n • g) := by
  exact connected_group_nsmul_surjective_of_prime_interior K G hconnected
    (fun p hp => prime_nsmul_range_has_nonempty_interior K hK G p hp)
