theorem coupled_finalState_distance {q : ℕ} (A : QueryAlg ι κ W q)
    (H : α → ι → κ) (G : β → ι → κ) (w : α → β → ℝ) (μ : α → ℝ)
    (ε : ℝ) (hw : ∀ a b, 0 ≤ w a b) (hμ : ∑ a, μ a = 1)
    (hdis : ∀ a x, (∑ b, if G b x ≠ H a x then w a b else 0) ≤ ε * μ a) :
    (∑ a, ∑ b, w a b *
      ‖A.finalState (xorOracle (G b)) - A.finalState (xorOracle (H a))‖ ^ 2) ≤
      4 * (q : ℝ) ^ 2 * ε := by
  let e (a : α) (b : β) (j : Fin q) : ℝ :=
    ‖act (Matrix.kronecker (xorOracle (G b)) (1 : Matrix W W ℂ))
        (A.stateAt (xorOracle (H a)) j.castSucc) -
      act (Matrix.kronecker (xorOracle (H a)) (1 : Matrix W W ℂ))
        (A.stateAt (xorOracle (H a)) j.castSucc)‖ ^ 2
  have hone (a : α) (j : Fin q) : (∑ b, w a b * e a b j) ≤ 4 * ε * μ a := by
    let ψ := A.stateAt (xorOracle (H a)) j.castSucc
    have hn : (∑ z : (ι × κ) × W, ‖ψ z‖ ^ 2) = 1 := by
      rw [← EuclideanSpace.norm_sq_eq]
      simp [ψ, stateAt_unit]
    have hd := weighted_disagreement_le (fun b => w a b) (fun z : (ι × κ) × W => ‖ψ z‖ ^ 2)
      (fun b z => G b z.1.1 ≠ H a z.1.1) (ε * μ a)
      (fun _ => sq_nonneg _) (fun z => hdis a z.1.1)
    rw [hn, mul_one] at hd
    calc
      _ ≤ ∑ b, w a b * (4 * ∑ z : (ι × κ) × W,
          if G b z.1.1 ≠ H a z.1.1 then ‖ψ z‖ ^ 2 else 0) := by
        apply Finset.sum_le_sum
        intro b _
        exact mul_le_mul_of_nonneg_left (xor_disagreement_sq (G b) (H a) ψ) (hw a b)
      _ = 4 * ∑ b, w a b * ∑ z : (ι × κ) × W,
          if G b z.1.1 ≠ H a z.1.1 then ‖ψ z‖ ^ 2 else 0 := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro b _
        ring
      _ ≤ _ := by linarith
  calc
    _ ≤ ∑ a, ∑ b, w a b * ((q : ℝ) * ∑ j : Fin q, e a b j) := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro b _
      exact mul_le_mul_of_nonneg_left (finalState_sq_dist_le A (G b) (H a)) (hw a b)
    _ = ∑ a, (q : ℝ) * ∑ j : Fin q, ∑ b, w a b * e a b j := by
      apply Finset.sum_congr rfl
      intro a _
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro j _
      apply Finset.sum_congr rfl
      intro b _
      ring
    _ ≤ ∑ a, (q : ℝ) * ∑ _j : Fin q, 4 * ε * μ a := by
      apply Finset.sum_le_sum
      intro a _
      apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg q)
      exact Finset.sum_le_sum fun j _ => hone a j
    _ = (4 * (q : ℝ) ^ 2 * ε) * ∑ a, μ a := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro a _
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring
    _ = _ := by rw [hμ, mul_one]

theorem coupled_acceptance_bound {q : ℕ} (A : QueryAlg ι κ W q)
    (H : α → ι → κ) (G : β → ι → κ) (w : α → β → ℝ) (μ : α → ℝ) (ν : β → ℝ)
    (ε : ℝ) (hw : ∀ a b, 0 ≤ w a b)
    (hrow : ∀ a, ∑ b, w a b = μ a) (hcol : ∀ b, ∑ a, w a b = ν b)
    (hμ : ∑ a, μ a = 1)
    (hdis : ∀ a x, (∑ b, if G b x ≠ H a x then w a b else 0) ≤ ε * μ a)
    (acc : ((ι × κ) × W) → Prop) [DecidablePred acc] :
    (∑ a, μ a * probEvent (A.finalState (xorOracle (H a))) acc) ≤
      2 * (∑ b, ν b * probEvent (A.finalState (xorOracle (G b))) acc) +
      8 * (q : ℝ) ^ 2 * ε := by
  have hd := coupled_finalState_distance A H G w μ ε hw hμ hdis
  rw [coupling_sum_left w μ hrow, coupling_sum_right w ν hcol]
  calc
    _ ≤ ∑ a, ∑ b, w a b *
        (2 * probEvent (A.finalState (xorOracle (G b))) acc +
          2 * ‖A.finalState (xorOracle (G b)) - A.finalState (xorOracle (H a))‖ ^ 2) := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro b _
      apply mul_le_mul_of_nonneg_left _ (hw a b)
      simpa only [norm_sub_rev (A.finalState (xorOracle (H a))) (A.finalState (xorOracle (G b)))]
        using probEvent_le_two_add (A.finalState (xorOracle (H a)))
          (A.finalState (xorOracle (G b))) acc
    _ = 2 * (∑ a, ∑ b, w a b * probEvent (A.finalState (xorOracle (G b))) acc) +
        2 * (∑ a, ∑ b, w a b *
          ‖A.finalState (xorOracle (G b)) - A.finalState (xorOracle (H a))‖ ^ 2) := by
      simp only [mul_add, Finset.sum_add_distrib, Finset.mul_sum]
      congr 1 <;> apply Finset.sum_congr rfl <;> intro a _ <;>
        apply Finset.sum_congr rfl <;> intro b _ <;> ring
    _ ≤ _ := by linarith

end QAlgorithms.QueryHybrid
end
