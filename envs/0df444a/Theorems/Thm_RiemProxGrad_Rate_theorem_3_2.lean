-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-08T00:22:19.895001+00:00
-- url     : https://prove2.me/theorems/abff062b-e693-457d-a9c5-8be218d5517b
-- title:
--   Theorem 3.2 — RPG converges at rate $O(1/k)$ under retraction convexity (3.16)
-- statement:
--   Let $\mathcal M$ be a finite-dimensional Riemannian manifold with retraction $R$, and consider $\min_{x\in\mathcal M}F(x)=f(x)+g(x)$ with $f$ differentiable (Riemannian gradient $\operatorname{grad} f$) and $g$ continuous with locally Lipschitz pull-backs $g\circ R_x$. Let $\{x_k\}$, $\{\eta^*_{x_k}\}$ be generated by Algorithm 1 (the Riemannian proximal gradient method) with a constant $\tilde L>0$, $\tilde L>L$, and set $\beta=(\tilde L-L)/2$. Suppose:
--
--   1. (Assumption 3.1) $F$ is bounded from below and $\Omega_{x_0}=\{x\mid F(x)\le F(x_0)\}$ is compact;
--   2. (Assumption 3.3) there is an open set $\Omega\supseteq\Omega_{x_0}$ such that $f$ is $L$-retraction-smooth and retraction-convex with respect to $R$ in $\Omega$, and $g$ is retraction-convex with respect to $R$ in $\Omega$;
--   3. (Assumption 3.4) $R^{-1}$ is an inverse retraction on $\Omega$ ($R_x(R_x^{-1}(y))=y$ for $x,y\in\Omega$) and there is a constant $\kappa_\Omega$ with $\bigl|\|R_x^{-1}(z)-R_x^{-1}(y)\|_x^2-\|R_y^{-1}(z)\|_y^2\bigr|\le\kappa_\Omega\|R_x^{-1}(y)\|_x^2$ for all $x,y,z\in\Omega$;
--   4. the inverse retraction recovers the steps: $R_{x_k}^{-1}(x_{k+1})=\eta^*_{x_k}$ for every $k$.
--
--   Let $x_*$ be any accumulation point of $\{x_k\}$. Then for every $k\ge1$,
--   $$F(x_k)-F(x_*)\le\frac1k\left(\frac{\tilde L}{2}\|R_{x_0}^{-1}(x_*)\|_{x_0}^2+\frac{\tilde L\kappa_\Omega}{2\beta}\bigl(F(x_0)-F(x_*)\bigr)\right). \tag{3.16}$$
--
--   This is the Riemannian counterpart of the $O(1/k)$ rate of the Euclidean proximal gradient method for convex problems. In the Euclidean case $R_x(\eta)=x+\eta$, one can take $\kappa_\Omega=0$ and the second term vanishes.
--
--   **Formalization Note** Algorithm 1 is modelled as a run: $0\in\partial\ell_{x_k}(\eta^*_{x_k})$ (Clarke subdifferential on $T_{x_k}\mathcal M$), $\ell_{x_k}(0)\ge\ell_{x_k}(\eta^*_{x_k})$ and $x_{k+1}=R_{x_k}(\eta^*_{x_k})$; the theorem holds for every such run. Readings of the setting: (3.2) is required for every tangent vector at points of $\Omega$; in (3.10) the vector $\zeta$ depends on $\xi$ (gradient of $f\circ R_x$, resp. every Clarke subgradient of $g\circ R_x$), as the sentence after (3.10) says; $\kappa_\Omega$ is a single constant. Item 4 makes explicit the identification $R_{x_k}^{-1}(x_{k+1})=\eta^*_{x_k}$ that the proof uses. "Accumulation point" is a cluster point of the sequence. The case $k=0$ is excluded because the bound divides by $k$.
-- source:
--   Huang, Wei, Riemannian proximal gradient methods, arXiv:1909.06065v4, p. 12, Theorem 3.2, (3.16)

import Mathlib
import Definitions.Def_RiemOpt_BFGS_Setting
import Definitions.Def_RiemOpt_FR_Setting
import Definitions.Def_RiemProxGrad_Global_Setting
import Definitions.Def_RiemProxGrad_Rate_Setting

open Bundle Manifold Filter
open scoped ContDiff

namespace RiemProxGrad.Rate

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
  {M : Type*} [TopologicalSpace M] [ChartedSpace E M] [IsManifold 𝓘(ℝ, E) ∞ M]
  [RiemannianBundle (fun x : M ↦ TangentSpace 𝓘(ℝ, E) x)]

/-- Theorem 3.2 (p. 12). Under Assumptions 3.1, 3.3 and 3.4, for every run of Algorithm 1 (RPG),
every accumulation point `x*` of `{x_k}` and every `k ≥ 1`:
`F(x_k) − F(x*) ≤ (1/k)((L̃/2)‖R_{x_0}⁻¹(x*)‖²_{x_0} + (L̃ κ_Ω/(2β))(F(x_0) − F(x*)))` (3.16),
with `β = (L̃ − L)/2`. -/
theorem theorem_3_2
    (f g : M → ℝ) (grad : (x : M) → TangentSpace 𝓘(ℝ, E) x)
    (R : (x : M) → TangentSpace 𝓘(ℝ, E) x → M)
    (Rinv : (x : M) → M → TangentSpace 𝓘(ℝ, E) x) (L Ltilde κ : ℝ) (Ω : Set M)
    (x : ℕ → M) (η : (k : ℕ) → TangentSpace 𝓘(ℝ, E) (x k))
    (hP : StandingAssumptions f g grad R) (hLt : 0 < Ltilde) (hL : L < Ltilde)
    (h31 : Assumption31 (objective f g) (x 0))
    (h33 : Assumption33 f g grad R L (x 0) Ω)
    (hinv : IsInverseRetractionOn R Rinv Ω) (h34 : Assumption34 Rinv Ω κ)
    (hrun : IsRPGRun grad g R Ltilde x η)
    (hsel : ∀ k, Rinv (x k) (x (k + 1)) = η k)
    (xstar : M) (hxstar : MapClusterPt xstar atTop x)
    (k : ℕ) (hk : 1 ≤ k) :
    objective f g (x k) - objective f g xstar ≤
      (1 / (k : ℝ)) * (Ltilde / 2 * ‖Rinv (x 0) xstar‖ ^ 2 +
        Ltilde * κ / (2 * beta L Ltilde) * (objective f g (x 0) - objective f g xstar)) := by sorry

end RiemProxGrad.Rate
