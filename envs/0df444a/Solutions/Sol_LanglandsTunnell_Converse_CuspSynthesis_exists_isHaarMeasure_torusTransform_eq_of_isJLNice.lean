    FiniteWhittaker.t0100, Units.val_mul, Matrix.map_mul]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [ArchC.diagOne, diagOne_coe_apply]
  rfl

private theorem t0540 (y : ℝ) (R : Matrix (Fin 2) (Fin 2) ℝ) :
    (ArchR.diagOne y * R).det = y * R.det := by
  rw [Matrix.det_mul]
  congr 1
  simp [ArchR.diagOne, Matrix.det_fin_two]

private theorem t0541 (y : ℂ) (R : Matrix (Fin 2) (Fin 2) ℂ) :
    (ArchC.diagOne y * R).det = y * R.det := by
  rw [Matrix.det_mul]
  congr 1
  simp [ArchC.diagOne, Matrix.det_fin_two]

