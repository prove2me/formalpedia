theorem solution (O M : Type) [CommRing O] [AddCommGroup M] [Module O M] (pi : O)
    [IsAdicComplete (Ideal.span {pi}) O] [IsHausdorff (Ideal.span {pi}) M]
    (hreg : ∀ m : M, pi • m = 0 → m = 0) {N : ℕ} (β : Fin N → M) (hβ : TypeDensity.ResidueBasisFamily pi β) :
    ∃ B : Module.Basis (Fin N) O M, ∀ i, B i = β i := by
  have hs := TypeDensity.residue_basis_family_spans O M pi β hβ
  exact ⟨.mk (TypeDensity.residue_basis_family_linearIndependent O M pi hreg β hβ) (by rw [hs]), by simp⟩
