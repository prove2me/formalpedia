theorem mem_ssJSet_of_frobeniusPair {K : Type} [Field K] [DecidableEq K] (q : ℕ) [Fact q.Prime] [CharP K q]
    [PerfectField K] {a b : K} (h : b = a ^ q ∨ b ^ q = a) (ha : a ∈ ssJSet q K) : b ∈ ssJSet q K := by
