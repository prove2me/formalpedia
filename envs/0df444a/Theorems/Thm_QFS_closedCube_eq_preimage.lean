variable {Γ : Configuration (EuclideanSpace ℝ (Fin d))} {θ : ℝ}

theorem QFS.closedCube_eq_preimage {h : ℝ} (hh : 0 ≤ h) (u : EuclideanSpace ℝ (Fin d)) :
    closedCube h u = (WithLp.ofLp : EuclideanSpace ℝ (Fin d) → (Fin d → ℝ)) ⁻¹'
        (Set.pi Set.univ (fun i => Icc (u i - h / 2) (u i + h / 2))) := by sorry
