-- Source module: Solutions.KFMLam
/-!
# KFM 5: the recursion exponent of `complexIface` is `λ = τ50 = 1 - 2^{-50}`

`KFN.lam_complex_lt_one` only gives `λ = log_m max(s_c/W_c, m^{τ50}, 1) < 1`.  The machine
budget (MACHINE-PLAN.md §5 (C)) needs `λ + c < λ'` with `c = 2^{-56}`, `λ' = 1 - 2^{-54}`.
Here: `s_c / W_c ≤ m^{τ50}` (**`sc_div_Wc_le`**), hence `Rb = m^{τ50}` and **`lam_complex_eq`**:
`λ = τ50`; **`lam_add_c_lt`**: `λ + 2^{-56} < 1 - 2^{-54}`.

Proof of the numeric inequality: `m^{2^{-50}} ≤ 1 + 2^{-40}` because
`(1+2^{-40})^{2^{50}} = ((1+2^{-40})^{2^{40}})^{2^{10}} ≥ 2^{1024} ≥ 10^6` (Bernoulli), and
`(s_c/W_c)(1 + 2^{-40}) ≤ 10^6` is a rational check.  (Numerals with real exponents are kept
abstract: `norm_num`/`linarith` would try to evaluate `10^6 ^ τ50`.)
-/

namespace NLogN.KFM

open NLogN.KFN

/-- Abstract core: if `a · 2^40 = 1`, `a ≥ 0`, then `10^6 ≤ (1+a)^(2^50)`. -/
theorem big_pow_core (a : ℝ) (ha0 : 0 ≤ a) (ha : ((2 ^ 40 : ℕ) : ℝ) * a = 1) :
    ((100 ^ 3 : ℕ) : ℝ) ≤ (1 + a) ^ (2 ^ 50 : ℕ) := by
  have hb : (2 : ℝ) ≤ (1 + a) ^ (2 ^ 40 : ℕ) := by
    have h := one_add_mul_le_pow (a := a) (by linarith) (2 ^ 40)
    rw [ha] at h
    generalize (1 + a) ^ (2 ^ 40 : ℕ) = y at h ⊢
    linarith
  have e50 : (2 ^ 50 : ℕ) = 2 ^ 40 * 2 ^ 10 := by norm_num
  rw [e50, pow_mul]
  calc ((100 ^ 3 : ℕ) : ℝ) ≤ (2 : ℝ) ^ (2 ^ 10 : ℕ) :=
        (show ((100 ^ 3 : ℕ) : ℝ) ≤ (2 : ℝ) ^ 20 by norm_num).trans
          (pow_le_pow_right₀ (by norm_num) (by norm_num))
    _ ≤ ((1 + a) ^ (2 ^ 40 : ℕ)) ^ (2 ^ 10 : ℕ) := pow_le_pow_left₀ (by norm_num) hb _

/-- `m^{2^{-50}} ≤ 1 + 2^{-40}` for `m = 10^6`. -/
theorem root_le : ((100 ^ 3 : ℕ) : ℝ) ^ ((2 : ℝ)⁻¹ ^ 50) ≤ 1 + (2 : ℝ)⁻¹ ^ 40 := by
  have ha : ((2 ^ 40 : ℕ) : ℝ) * (2 : ℝ)⁻¹ ^ 40 = 1 := by norm_num
  have hbig := big_pow_core _ (by positivity) ha
  have he : (2 : ℝ)⁻¹ ^ 50 = (((2 ^ 50 : ℕ) : ℕ) : ℝ)⁻¹ := by norm_num
  have hx0 : (0 : ℝ) ≤ 1 + (2 : ℝ)⁻¹ ^ 40 := by positivity
  generalize 1 + (2 : ℝ)⁻¹ ^ 40 = x at hbig hx0 ⊢
  rw [he]
  calc ((100 ^ 3 : ℕ) : ℝ) ^ ((((2 ^ 50 : ℕ) : ℕ) : ℝ)⁻¹)
      ≤ (x ^ (2 ^ 50 : ℕ)) ^ ((((2 ^ 50 : ℕ) : ℕ) : ℝ)⁻¹) :=
        Real.rpow_le_rpow (by positivity) hbig (by positivity)
    _ = x := Real.pow_rpow_inv_natCast hx0 (by norm_num)

end NLogN.KFM

end

