-- title:
--   Weighted seminorm topology on rapidly decreasing lattice sequences
-- statement:
--   Equip the lattice sequence submodule with the locally convex topology generated by the real weighted absolute sums.
-- source:
--   https://github.com/mccorvie/riemann-masullo/blob/8a05ee179a90e12e33a590c6412a9e9de416fa30/RiemannMasullo/AppD_SchwartzBruhat/Sec1a.lean#L574-L588

import Definitions.Def_RiemannMasullo_ElementarySchwartzTopology
import Theorems.Thm_RiemannMasullo_rapidDecaySequenceSeminorm_map_zero
import Theorems.Thm_RiemannMasullo_rapidDecaySequenceSeminorm_add_le
import Theorems.Thm_RiemannMasullo_rapidDecaySequenceSeminorm_smul
import Theorems.Thm_RiemannMasullo_rapidDecaySequenceSeminorm_neg
noncomputable section
namespace RiemannMasullo
variable {r : ℕ}
def rapidDecaySequenceSeminorm (j : ℕ) : Seminorm ℂ (rapidDecaySequenceSubmodule r) where
  toFun s := (rapidDecaySequenceBound j s.val).toReal
  map_zero' := rapidDecaySequenceSeminorm_map_zero j
  add_le' := rapidDecaySequenceSeminorm_add_le j
  smul' := rapidDecaySequenceSeminorm_smul j
  neg' := rapidDecaySequenceSeminorm_neg j

/-- Paper: Remark D.1.3.6, p. 753. The weighted absolute-sum seminorms generate
the locally convex topology on the rapidly decreasing lattice sequences. -/
abbrev RapidDecaySequence (r : ℕ) :=
  WithGeneratingSeminorms (rapidDecaySequenceSubmodule r) rapidDecaySequenceSeminorm

instance : CoeFun (RapidDecaySequence r) (fun _ ↦ (Fin r → ℤ) → ℂ) where
  coe s := (show rapidDecaySequenceSubmodule r from s).val
end RiemannMasullo


