theorem pre_bounds (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h : ℕ} (hh : h < bb ℓ K) :
    NLogN.KFV.preP D ℓ K long h + D ≤ (tgtL D ℓ K long).length := by
  have h1 := length_lstL_le_tgt D ℓ K long
  rw [length_lstL] at h1
  have : (bb ℓ K - 1 - h) * D + D ≤ bb ℓ K * D := by
    have : bb ℓ K - 1 - h + 1 ≤ bb ℓ K := by omega
    nlinarith
  unfold NLogN.KFV.preP; omega

