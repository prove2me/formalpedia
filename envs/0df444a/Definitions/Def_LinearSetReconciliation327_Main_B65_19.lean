/-- A callable polynomial square, overwriting the whole destination array
including its odd zero coefficients. -/
theorem squareProcedure_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ)
    (P : Program) (E : RAMEnv) (pc dst src L cap : ℕ) (p : F[X]) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile squareProcedure pc))
    (hw : 1 ≤ w) (hW : E.W = 8 * w) (hdet : DetAgrees E t N b ι)
    (hcap : cap = 2 * L) (hcapWord : cap < 2 ^ E.W)
    (hdstWord : dst < 2 ^ E.W) (hsrcWord : src < 2 ^ E.W)
    (hdst : dst + cap ≤ 2 ^ E.W) (hsrc : src + L ≤ 2 ^ E.W)
    (hdisj : src + L ≤ dst ∨ dst + cap ≤ src) (hp : PolynomialStored b m src L p)
    (hm64 : m 64 = dst) (hm65 : m 65 = src) (hm66 : m 66 = cap) :
    Sem P E pc (pc + 45) (boundaryState pc m)
      (fun k z => k ≤ 18 * cap + 29 ∧
        z = boundaryState (pc + 45) (writeArray dst m (fun i => enc b ((p ^ 2).coeff i)) cap)) := by
  obtain ⟨hArgsAt, hRestAt⟩ := At.seqStmt hAt
  obtain ⟨hSquareAt, hZeroAt⟩ := At.seqStmt hRestAt
  have hArgs : Sem P E pc (pc + 11) (boundaryState pc m)
      (fun k z => k ≤ 11 ∧ z = squareState b (pc + 11) dst src cap p m (fun _ => 0) 0) := by
    refine Sem.mono (Sem.block P E pc squareArgsCode _ hArgsAt (by simp [squareArgsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    exact ⟨by change k = 11 at hk; omega,
      hz.trans (squareArgs_spec b ι t N E pc dst src cap p m hw hW hdet hdstWord hsrcWord hcapWord hm64 hm65 hm66)⟩
  have hSquare := squareArray_spec b ι t N P E (pc + 11) dst src L cap p m (fun _ => 0)
    hSquareAt hw hW hdet hcap hcapWord hdst hsrc hdisj hp
  have hZero : Sem P E (pc + 29) (pc + 45)
      { squareState b (pc + 11) dst src cap p m (fun _ => 0) cap with pc := pc + 29 }
      (fun k z => k ≤ 16 ∧ z = boundaryState (pc + 45) (writeArray dst m (fun i => enc b ((p ^ 2).coeff i)) cap)) := by
    refine Sem.mono (Sem.block P E _ zeroRegsCode _ hZeroAt (by simp [zeroRegsCode]) rfl) ?_
    intro k z hQ
    obtain ⟨hk, hz⟩ := hQ
    refine ⟨by change k = 16 at hk; omega, ?_⟩
    rw [hz, zeroRegs_spec]
    rfl
  have hFull := Sem.seq_bound hArgs (fun z _ hz => by
    subst z
    exact Sem.seq_bound hSquare (fun z _ hz => by subst z; exact hZero))
  exact Sem.mono hFull (fun k z hQ => ⟨by omega, hQ.2⟩)

