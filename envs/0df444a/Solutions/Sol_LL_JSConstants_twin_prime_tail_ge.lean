def totalHeadBlocks : Nat :=
  Nat.add (Nat.add (sumAllBlocks 0 masks0) (sumAllBlocks 77 masks1))
    (Nat.add (sumAllBlocks 154 masks2) (sumAllBlocks 231 masks3))

lemma masks0_len : masks0.length = 77 := by decide +kernel
lemma masks1_len : masks1.length = 77 := by decide +kernel
lemma masks2_len : masks2.length = 77 := by decide +kernel
lemma masks3_len : masks3.length = 77 := by decide +kernel

lemma cop210_nodup : cop210.Nodup := by decide +kernel

lemma mem_cop210_of_coprime :
    ∀ r ∈ Finset.range 210, Nat.Coprime r 210 → r ∈ cop210 := by
  decide +kernel

lemma card_coprime_2310 :
    ((Finset.range 2310).filter (fun r => Nat.Coprime r 2310)).card = 480 := by
  decide +kernel

lemma head_blocks_bound : Nat.ble totalHeadBlocks 39602850000 = true := by
  decide +kernel

lemma head_blocks_le : totalHeadBlocks ≤ 39602850000 :=
  Nat.ble_eq.mp head_blocks_bound

lemma sumAllBlocks_append :
    ∀ (a b : List ℕ) (k : ℕ),
      sumAllBlocks k (a ++ b) = sumAllBlocks k a + sumAllBlocks (k + a.length) b
  | [], b, k => by simp [sumAllBlocks]
  | m :: a, b, k => by
    simp only [List.cons_append, sumAllBlocks, List.length_cons]
    rw [sumAllBlocks_append a b (Nat.add k 1)]
    change sumBlock k cop210 m + (sumAllBlocks (k + 1) a + sumAllBlocks (k + 1 + a.length) b) =
      (sumBlock k cop210 m + sumAllBlocks (k + 1) a) + sumAllBlocks (k + (a.length + 1)) b
    have hk : k + 1 + a.length = k + (a.length + 1) := by omega
    rw [hk, add_assoc]

lemma mod_210_mem_cop210 {n : ℕ} (hp : n.Prime) (h51 : 51 ≤ n) : n % 210 ∈ cop210 := by
  apply mem_cop210_of_coprime (n % 210) (Finset.mem_range.mpr (Nat.mod_lt n (by norm_num)))
  rw [Nat.coprime_iff_gcd_eq_one]
  by_contra hne
  obtain ⟨q, hqp, hq_rem, hq_210⟩ := Nat.Prime.not_coprime_iff_dvd.mp hne
  have hqn : q ∣ n := by
    have hdiv := Nat.div_add_mod n 210
    rw [← hdiv]
    exact dvd_add (dvd_mul_of_dvd_left hq_210 _) hq_rem
  have hqe : q = n := (Nat.prime_dvd_prime_iff_eq hqp hp).mp hqn
  rw [hqe] at hq_210
  have h210 : (210 : ℕ) = 2 * (3 * (5 * 7)) := by norm_num
  rw [h210] at hq_210
  rcases hp.dvd_mul.mp hq_210 with h | h
  · have := Nat.le_of_dvd (by norm_num) h; omega
  rcases hp.dvd_mul.mp h with h | h
  · have := Nat.le_of_dvd (by norm_num) h; omega
  rcases hp.dvd_mul.mp h with h | h <;> (have := Nat.le_of_dvd (by norm_num) h; omega)

lemma sumBlock_ge (k : ℕ) :
    ∀ (rs : List ℕ), rs.Nodup → ∀ (mask : ℕ) (S : Finset ℕ),
      (∀ n ∈ S, n.Prime ∧ 51 ≤ n ∧ n / 210 = k ∧ n % 210 ∈ rs) →
      (∑ n ∈ S, termUb n) ≤ sumBlock k rs mask
  | [], _, _, S, hS => by
    have hSe : S = ∅ := by
      refine Finset.eq_empty_of_forall_notMem fun n hn => ?_
      simpa using (hS n hn).2.2.2
    simp [hSe, sumBlock]
  | r :: rs, hnodup, mask, S, hS => by
    rw [List.nodup_cons] at hnodup
    rcases hnodup with ⟨hr_not_mem, hrs_nodup⟩
    set n0 : ℕ := 210 * k + r
    have hS_erase : ∀ n ∈ S.erase n0, n.Prime ∧ 51 ≤ n ∧ n / 210 = k ∧ n % 210 ∈ rs := by
      intro n hn
      rcases Finset.mem_erase.mp hn with ⟨hne, hnS⟩
      rcases hS n hnS with ⟨hp, h51, hdiv, hmod⟩
      refine ⟨hp, h51, hdiv, ?_⟩
      rcases List.mem_cons.mp hmod with hmr | hmrs
      · exfalso
        apply hne
        have := Nat.div_add_mod n 210
        omega
      · exact hmrs
    have ih := sumBlock_ge k rs hrs_nodup (Nat.shiftRight mask 6) (S.erase n0) hS_erase
    simp only [sumBlock]
    have hn0_eq : Nat.add (Nat.mul 210 k) r = n0 := rfl
    rw [hn0_eq]
    by_cases hn0S : n0 ∈ S
    · rcases hS n0 hn0S with ⟨hp0, h51_0, _, _⟩
      have hble50 : Nat.ble n0 50 = false :=
        Bool.eq_false_iff.mpr (fun h => by rw [Nat.ble_eq] at h; omega)
      simp only [hble50, Bool.false_eq_true, ↓reduceIte]
      set q := lookupPrime (Nat.land mask 63)
      have hcond :
          Bool.and (Nat.ble 2 q)
            (Bool.and (Nat.ble (Nat.add q 1) n0) (Nat.beq (Nat.mod n0 q) 0)) = false := by
        by_contra htrue
        simp only [Bool.not_eq_false, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq] at htrue
        rcases htrue with ⟨hq2, hqn0, hmod0⟩
        have hqdvd : q ∣ n0 := Nat.dvd_of_mod_eq_zero hmod0
        rcases hp0.eq_one_or_self_of_dvd q hqdvd with hq_eq | hq_eq <;>
          (change 2 ≤ q at hq2; change q + 1 ≤ n0 at hqn0; omega)
      simp only [hcond, Bool.false_eq_true, ↓reduceIte]
      have hsplit := (Finset.add_sum_erase S termUb hn0S).symm
      rw [hsplit]
      change termUb n0 + ∑ x ∈ S.erase n0, termUb x ≤
        termUb n0 + sumBlock k rs (Nat.shiftRight mask 6)
      omega
    · have herase : S.erase n0 = S := Finset.erase_eq_of_notMem hn0S
      rw [herase] at ih
      split_ifs
      · exact ih
      · exact ih
      · change ∑ n ∈ S, termUb n ≤ termUb n0 + sumBlock k rs (Nat.shiftRight mask 6)
        omega

lemma sumAllBlocks_ge :
    ∀ (ms : List ℕ) (k : ℕ) (S : Finset ℕ),
      (∀ n ∈ S, n.Prime ∧ 51 ≤ n ∧ k ≤ n / 210 ∧ n / 210 < k + ms.length) →
      (∑ n ∈ S, termUb n) ≤ sumAllBlocks k ms
  | [], k, S, hS => by
    have hSe : S = ∅ := by
      refine Finset.eq_empty_of_forall_notMem fun n hn => ?_
      have h := hS n hn
      simp at h
      omega
    simp [hSe, sumAllBlocks]
  | m :: ms, k, S, hS => by
    simp only [sumAllBlocks]
    rw [← Finset.sum_filter_add_sum_filter_not S (fun n => n / 210 = k) termUb]
    have h1 : (∑ n ∈ S.filter (fun n => n / 210 = k), termUb n) ≤ sumBlock k cop210 m := by
      refine sumBlock_ge k cop210 cop210_nodup m _ ?_
      intro n hn
      rcases Finset.mem_filter.mp hn with ⟨hnS, hdiv⟩
      rcases hS n hnS with ⟨hp, h51, _, _⟩
      exact ⟨hp, h51, hdiv, mod_210_mem_cop210 hp h51⟩
    have h2 : (∑ n ∈ S.filter (fun n => ¬ n / 210 = k), termUb n) ≤ sumAllBlocks (k + 1) ms := by
      refine sumAllBlocks_ge ms (k + 1) _ ?_
      intro n hn
      rcases Finset.mem_filter.mp hn with ⟨hnS, hndiv⟩
      rcases hS n hnS with ⟨hp, h51, hlo, hhi⟩
      simp only [List.length_cons] at hhi
      exact ⟨hp, h51, by omega, by omega⟩
    change _ ≤ sumBlock k cop210 m + sumAllBlocks (k + 1) ms
    omega

noncomputable def termReal (n : ℕ) : ℝ :=
  -Real.log (1 - 1 / ((n : ℝ) - 1) ^ 2)

lemma termReal_nonneg {n : ℕ} (h51 : 51 ≤ n) : 0 ≤ termReal n := by
  unfold termReal
  rw [neg_nonneg]
  apply Real.log_nonpos
  · have hn_real : (51 : ℝ) ≤ (n : ℝ) := by exact_mod_cast h51
    have hn1 : (50 : ℝ) ≤ (n : ℝ) - 1 := by linarith
    have hsq : (2500 : ℝ) ≤ ((n : ℝ) - 1) ^ 2 := by nlinarith
    have hdiv : 1 / ((n : ℝ) - 1) ^ 2 ≤ 1 / 2500 :=
      one_div_le_one_div_of_le (by norm_num) hsq
    linarith
  · have : 0 ≤ 1 / ((n : ℝ) - 1) ^ 2 := by positivity
    linarith

lemma termReal_le_termUb {n : ℕ} (h51 : 51 ≤ n) :
    termReal n ≤ (termUb n : ℝ) / (10000000000000 : ℝ) := by
  unfold termReal
  set m : ℕ := n - 1
  have hm50 : 50 ≤ m := by omega
  have hcast_m : (m : ℝ) = (n : ℝ) - 1 := by
    have h1 : 1 ≤ n := by omega
    simpa using (Nat.cast_sub (R := ℝ) h1)
  set A : ℕ := m * m
  have hA2500 : 2500 ≤ A := by
    dsimp [A]
    nlinarith
  have hA_cast : (A : ℝ) = ((n : ℝ) - 1) ^ 2 := by
    dsimp [A]
    rw [Nat.cast_mul, hcast_m, sq]
  set u : ℝ := 1 / (A : ℝ)
  have hA_pos : (0 : ℝ) < (A : ℝ) := by exact_mod_cast (show 0 < A by omega)
  have hu_pos : 0 < u := by positivity
  have hu_lt1 : |u| < 1 := by
    rw [abs_of_pos hu_pos]
    dsimp [u]
    rw [div_lt_one hA_pos]
    exact_mod_cast (show 1 < A by omega)
  have hlog := Real.abs_log_sub_add_sum_range_le hu_lt1 2
  simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, zero_add] at hlog
  rw [abs_of_pos hu_pos] at hlog
  norm_num at hlog
  have hlog_ub : -Real.log (1 - u) ≤ u + u ^ 2 / 2 + u ^ 3 / (1 - u) := by
    have := (abs_le.mp hlog).1
    linarith
  have hu_eq : 1 / ((n : ℝ) - 1) ^ 2 = u := by rw [← hA_cast]
  rw [hu_eq]
  set num : ℕ := 2 * (A * A) - A + 1
  set den : ℕ := 2 * (A * A) * (A - 1)
  have hden_pos_nat : 0 < den := by
    dsimp [den]
    have : 1 ≤ A - 1 := by omega
    positivity
  have hnum_cast : (num : ℝ) = 2 * (A : ℝ) ^ 2 - (A : ℝ) + 1 := by
    have hle : A ≤ 2 * (A * A) := by nlinarith
    dsimp [num]
    rw [Nat.cast_add, Nat.cast_sub (R := ℝ) hle]
    push_cast
    ring
  have hden_cast : (den : ℝ) = 2 * (A : ℝ) ^ 2 * ((A : ℝ) - 1) := by
    have hle1 : 1 ≤ A := by omega
    dsimp [den]
    rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_sub (R := ℝ) hle1]
    push_cast
    ring
  have hrat_eq : u + u ^ 2 / 2 + u ^ 3 / (1 - u) = (num : ℝ) / (den : ℝ) := by
    rw [hnum_cast, hden_cast]
    have hA1_ne : (A : ℝ) - 1 ≠ 0 := by
      have : (2500 : ℝ) ≤ (A : ℝ) := by exact_mod_cast hA2500
      linarith
    dsimp [u]
    field_simp
    ring
  have htermUb_eq : termUb n = (10000000000000 * num + den - 1) / den := rfl
  have hceil_nat : 10000000000000 * num ≤ termUb n * den := by
    rw [htermUb_eq]
    have hmod := Nat.div_add_mod (10000000000000 * num + den - 1) den
    have hlt := Nat.mod_lt (10000000000000 * num + den - 1) hden_pos_nat
    have h1 : 1 ≤ den := hden_pos_nat
    have hmul_comm : den * ((10000000000000 * num + den - 1) / den) =
        ((10000000000000 * num + den - 1) / den) * den := Nat.mul_comm _ _
    omega
  have hceil_real : (10000000000000 : ℝ) * (num : ℝ) ≤ (termUb n : ℝ) * (den : ℝ) := by
    exact_mod_cast hceil_nat
  have hden_pos_real : (0 : ℝ) < (den : ℝ) := by exact_mod_cast hden_pos_nat
  have hfrac_le : (num : ℝ) / (den : ℝ) ≤ (termUb n : ℝ) / (10000000000000 : ℝ) := by
    rw [div_le_div_iff₀ hden_pos_real (by norm_num)]
    linarith
  linarith

lemma termReal_tail_le {n : ℕ} (hp : n.Prime) (hP : 64680 ≤ n) :
    termReal n ≤
      (1 / (2310 : ℝ) ^ 2) *
        (1 / (((n / 2310 : ℕ) : ℝ) - 1 / 2) - 1 / (((n / 2310 : ℕ) : ℝ) + 1 / 2)) := by
  unfold termReal
  set u : ℝ := 1 / ((n : ℝ) - 1) ^ 2
  have hn_real : (64680 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hP
  have hn1 : (64679 : ℝ) ≤ (n : ℝ) - 1 := by linarith
