variable {G : Type} [Group G] {V : Type} [AddCommGroup V] [Module ℂ V]

theorem PositivityTheory.Rg.BcB.F.EigA.reps_spec (K : Subgroup G) (g : G) [Fintype (K ⧸ stabK K g)] :
    (∀ γ ∈ reps K g, ∃ k₁ ∈ K, ∃ k₂ ∈ K, γ = k₁ * g * k₂) ∧
      ∀ x : G, (∃ k₁ ∈ K, ∃ k₂ ∈ K, x = k₁ * g * k₂) → ∃! γ, γ ∈ reps K g ∧ γ⁻¹ * x ∈ K := by sorry
