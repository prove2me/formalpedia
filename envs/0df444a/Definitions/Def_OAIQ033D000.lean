    (hfr : IsCoprime f r) (hdiv : f ∣ g-r) : IsCoprime f g := by
  obtain ⟨q,hq⟩ := hdiv
  have hg : g = r + f*q := by rw [← hq]; ring
  rw [hg]
  exact hfr.add_mul_left_right q

