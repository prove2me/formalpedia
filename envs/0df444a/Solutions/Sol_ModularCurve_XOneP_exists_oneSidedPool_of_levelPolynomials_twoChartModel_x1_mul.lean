    @IsClosedImmersion.spec_of_surjective (CommRingCat.of ↥(ModularCurve.TwoChart.chartAlgFin A Kf j)) (CommRingCat.of (↥(ModularCurve.TwoChart.chartAlgFin A Kf j) ⧸ I))
