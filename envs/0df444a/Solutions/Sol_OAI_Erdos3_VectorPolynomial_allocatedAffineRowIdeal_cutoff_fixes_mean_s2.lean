theorem solution.{u_1, u_2, u_3, u_4, u_5, u_6, u_7} : type_of% @OAI.Erdos3.VectorPolynomial.allocatedAffineRowIdeal_cutoff_fixes_mean_s2_oai.{u_1, u_2, u_3, u_4, u_5, u_6, u_7} := @OAI.Erdos3.VectorPolynomial.allocatedAffineRowIdeal_cutoff_fixes_mean_s2_oai.{u_1, u_2, u_3, u_4, u_5, u_6, u_7}
