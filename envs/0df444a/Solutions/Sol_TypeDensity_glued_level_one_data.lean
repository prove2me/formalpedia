  have hPmon : P.Monic := hPprod ▸ Polynomial.monic_prod_of_monic _ _ fun Q _ ↦ (hterm Q _).1
  have hPdeg : P.natDegree + Dv none = TypeDensity.exceptionalDegree k Dv := by
    rw [hPprod, TypeDensity.exceptionalDegree, Finsupp.sum,
      Polynomial.natDegree_prod_of_monic (h := fun Q _ ↦ (hterm Q (Dv Q)).1),
      Finset.sum_congr rfl fun Q _ ↦ (hterm Q (Dv Q)).2, Finset.sum_add_distrib, Finset.sum_ite_eq']
