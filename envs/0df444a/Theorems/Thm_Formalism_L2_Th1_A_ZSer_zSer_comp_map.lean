local notation "FF[" W "](" a ", " b ")" =>
  MvPowerSeries.subst (![a, b] : Fin 2 → PowerSeries _) (fgl W)
variable {R : Type u} [CommRing R] (W : WeierstrassCurve R)

theorem Formalism.L2.Th1.A.ZSer.zSer_comp_map {S : Type v} [CommRing S] (φ : R →+* S) (m n : ℤ) :
    PowerSeries.map φ ((zSer W m).subst (zSer W n))
      = (zSer (W.map φ) m).subst (zSer (W.map φ) n) := by sorry
