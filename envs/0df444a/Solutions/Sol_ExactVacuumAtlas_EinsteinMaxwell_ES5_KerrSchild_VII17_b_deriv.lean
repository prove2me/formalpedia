section Alg
variable (x h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ : ℝ)

/-- 3A: the real `pcE` (incl. J-term) is `x · (x u r² + (2 - xZ) r + ρ)` up to a nonzero factor. -/
theorem quad_pcE (hx : x ≠ 0) (hF : F ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0) :
    x * (x * (1 - h * x) * (b₁ / b) ^ 2 + (2 - x * ((1 - h * x) * F₁ / F)) * (b₁ / b)
      + rhoE h Q J x F b ((1 - h * x) * F₁ / F) (A / x) (b * A₁) ((b ^ 2 - F) / x))
    = pcE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ / (F ^ 2 * b ^ 2 * (1 - h * x) ^ 2) := by
  unfold pcE rhoE
  generalize hu_def : 1 - h * x = u at hu ⊢
  field_simp
  subst hu_def
  ring

/-- 3A root selection: on the branch `0 < β + 2uxr`, `β + uxr ≠ 0`, the root is `rootE`'s form. -/
theorem root_eq {x u Z r ρ : ℝ} (hq : x * u * r ^ 2 + (2 - x * Z) * r + ρ = 0)
    (h1 : 0 < 2 - x * Z + 2 * u * x * r) (h2 : 0 < 2 - x * Z + u * x * r) :
    r = -2 * ρ / (2 - x * Z + √((2 - x * Z) ^ 2 - 4 * u * x * ρ)) := by
  have hΔ : (2 - x * Z) ^ 2 - 4 * u * x * ρ = (2 - x * Z + 2 * u * x * r) ^ 2 := by
    have : ρ = -(x * u * r ^ 2 + (2 - x * Z) * r) := by linarith
    rw [this]; ring
  rw [hΔ, Real.sqrt_sq h1.le, eq_div_iff (by linarith)]
  linear_combination 2 * hq

end Alg

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
