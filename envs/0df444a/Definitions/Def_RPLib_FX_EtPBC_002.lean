-- ===== S4.Def_RP_EtPBC_A_DescA =====
section

/-!
# S4-EtPBC-A, R4-T1a: descent of a torsor under a finite group along a flat cover (algebra)

`A → C` an algebra, `N` a finite abelian group, and a descent datum `D : Datum A C N`: complete orthogonal
idempotents `ε ν ∈ C ⊗ C` (the indicator functions of the values `ν` of a locally constant `N`-valued cocycle on
`Spec (C ⊗ C)`), trivial on the diagonal (`diag`) and satisfying the cocycle identity
`ε¹³_ν = ∑_α ε¹²_α ε²³_(ν - α)` in `C ⊗ C ⊗ C` (`cocycle`).

* `B D`: the `A`-subalgebra of `N → C` of the `f` with `f ν ⊗ 1 = ∑_m ε_m (1 ⊗ f (ν + m))` (functions on the
  trivial torsor `N × Spec C` that descend), `mem_B_iff` (`B = ker delta`).
* `delta'`, `key1`, `eq_sum_of_delta'`, `gOf`, `lmul'_gOf`, `delta'_gOf`, `cocycle'`: the base change of `delta`
  along `C` has kernel `N → C` (multiplication `m12` gives the retraction).
* **`theta_bijective`** (`C` flat over `A`): `C ⊗[A] B ≅ (N → C)`, `c ⊗ f ↦ c f`; `thetaEquiv`.
* With `C` faithfully flat: **`finite_B`**, **`etale_B`**, and `exists_prime_over` (`Spec B → Spec A` is onto).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.DescA

universe u

open TensorProduct

section Maps

variable (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]

/-- `x ↦ x ⊗ 1`. -/
abbrev j1 : C →ₐ[A] C ⊗[A] C := Algebra.TensorProduct.includeLeft

/-- `x ↦ 1 ⊗ x`. -/
abbrev j2 : C →ₐ[A] C ⊗[A] C := Algebra.TensorProduct.includeRight

/-- `x ⊗ y ↦ x ⊗ (y ⊗ 1)`. -/
abbrev e12 : C ⊗[A] C →ₐ[A] C ⊗[A] (C ⊗[A] C) :=
  Algebra.TensorProduct.map (AlgHom.id A C) (j1 A C)

/-- `x ⊗ y ↦ x ⊗ (1 ⊗ y)`. -/
abbrev e13 : C ⊗[A] C →ₐ[A] C ⊗[A] (C ⊗[A] C) :=
  Algebra.TensorProduct.map (AlgHom.id A C) (j2 A C)

/-- `x ⊗ y ↦ 1 ⊗ (x ⊗ y)`. -/
abbrev e23 : C ⊗[A] C →ₐ[A] C ⊗[A] (C ⊗[A] C) := Algebra.TensorProduct.includeRight

/-- `x ⊗ (y ⊗ z) ↦ x y ⊗ z`. -/
abbrev m12 : C ⊗[A] (C ⊗[A] C) →ₐ[A] C ⊗[A] C :=
  Algebra.TensorProduct.productMap (j1 A C) (AlgHom.id A (C ⊗[A] C))

theorem m12_e12 (x : C ⊗[A] C) : m12 A C (e12 A C x) = j1 A C (Algebra.TensorProduct.lmul' A x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    simp [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.map_tmul,
      Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.tmul_mul_tmul]
  | add x y hx hy => simp only [map_add, hx, hy]

theorem m12_e13 (x : C ⊗[A] C) : m12 A C (e13 A C x) = x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    simp [Algebra.TensorProduct.productMap_apply_tmul, Algebra.TensorProduct.map_tmul,
      Algebra.TensorProduct.tmul_mul_tmul]
  | add x y hx hy => simp only [map_add, hx, hy]

theorem m12_e23 (x : C ⊗[A] C) : m12 A C (e23 A C x) = x := by
  simp [Algebra.TensorProduct.productMap_apply_tmul, ← Algebra.TensorProduct.one_def]

theorem e12_j1 (c : C) : e12 A C (j1 A C c) = e13 A C (j1 A C c) := by
  simp [Algebra.TensorProduct.map_tmul]

theorem lmul'_j1 (c : C) : Algebra.TensorProduct.lmul' A (j1 A C c) = c := by
  simp [Algebra.TensorProduct.lmul'_apply_tmul]

end Maps

/-- A descent datum for the trivial `N`-torsor over `Spec C`: the indicator idempotents of an `N`-valued
cocycle on `Spec (C ⊗[A] C)`. -/
structure Datum (A C N : Type u) [CommRing A] [CommRing C] [Algebra A C] [AddCommGroup N] [Fintype N]
    [DecidableEq N] where
  ε : N → C ⊗[A] C
  mul_self : ∀ ν, ε ν * ε ν = ε ν
  mul_ne : ∀ ν μ, ν ≠ μ → ε ν * ε μ = 0
  sum_eq : ∑ ν, ε ν = 1
  diag : ∀ ν, Algebra.TensorProduct.lmul' A (ε ν) = if ν = 0 then 1 else 0
  cocycle : ∀ ν, e13 A C (ε ν) = ∑ α, e12 A C (ε α) * e23 A C (ε (ν - α))

namespace Datum

section Tensor

end Tensor

section FF

end FF

end Datum

end RamanujanPetersson.EtPBC.DescA

end

