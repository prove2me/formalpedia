private theorem integrand_eq_mul_prod_shellTerm
    (hW : ∀ L : List (HeightOneSpectrum (𝓞 ℚ)), (∀ v ∈ L, v ∉ T) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 ℚ) ℚ (↑T ∪ {v | v ∈ L}),
        Φ a = Φ (NumberField.Idele.partAt ℚ T a) * (L.map fun v => τ v (NumberField.Idele.ord ℚ v a)).prod)
    (hχU : ∀ u : (AdeleRing (𝓞 ℚ) ℚ)ˣ, (u : AdeleRing (𝓞 ℚ) ℚ).1 = 1 → (∀ v ∈ T, (u : AdeleRing (𝓞 ℚ) ℚ).2 v = 1) →
