theorem Formalism.IrreducibleCountingLemmas.GaloisIrreducibility.norm_one_add_mul (S : Type) [CommRing S] [Algebra ℤ S] [Module.Free ℤ S]
    [Module.Finite ℤ S] (c : ℤ) (y : S) :
    c ∣ Algebra.norm ℤ (1 + algebraMap ℤ S c * y) - 1 := by sorry
