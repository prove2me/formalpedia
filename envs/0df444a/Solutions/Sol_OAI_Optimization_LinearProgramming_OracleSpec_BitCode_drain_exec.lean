      simp [Memory.drained, next, Memory.pop, Memory.emit, hs, List.append_assoc]
    rw [finish] at rest
    have length : 2 * (b :: xs).length + 1 = 1 + (1 + (2 * xs.length + 1)) := by
      simp only [List.length_cons]; omega
    rw [length]
