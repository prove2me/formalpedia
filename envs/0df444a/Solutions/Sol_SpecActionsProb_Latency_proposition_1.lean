variable {P : Measure Ω} [IsProbabilityMeasure P] {α β p : ℝ}

lemma tail_of_law (hX : IsSpecModel P k α β p X) (j : Idx k) (c : ℝ) (hc : 0 < c)
    (hlaw : P.map (X j) = expMeasure c) :
    (0 ≤ᵐ[P] X j) ∧ ∀ s : ℝ, 0 ≤ s → P {ω | s < X j ω} = ENNReal.ofReal (Real.exp (-(c * s))) := by
  refine ⟨ae_of_ae_map (p := fun x : ℝ => 0 ≤ x) (hX.meas j).aemeasurable (by rw [hlaw]; exact expMeasure_nonneg c hc),
    fun s hs => ?_⟩
  have : P {ω | s < X j ω} = P.map (X j) (Ioi s) := by
    rw [Measure.map_apply (hX.meas j) measurableSet_Ioi]; rfl
  rw [this, hlaw, expMeasure_Ioi c hc s hs]

lemma intB (hX : IsSpecModel P k α β p X) (hβ : 0 < β) (t : ℕ) :
    Integrable (X (.real t)) P ∧ ∫ ω, X (.real t) ω ∂P = 1 / β := by
  obtain ⟨h1, h2⟩ := tail_of_law hX (.real t) β hβ (hX.lawB t)
  exact expTail P _ β hβ (hX.meas _) h1 fun s hs => h2 s hs.le

lemma intMin (hX : IsSpecModel P k α β p X) (hα : 0 < α) (hβ : 0 < β) (t : ℕ) :
    Integrable (fun ω => min (X (.spec t) ω) (X (.real t) ω)) P ∧
      ∫ ω, min (X (.spec t) ω) (X (.real t) ω) ∂P = 1 / (α + β) := by
  obtain ⟨a1, a2⟩ := tail_of_law hX (.spec t) α hα (hX.lawA t)
  obtain ⟨b1, b2⟩ := tail_of_law hX (.real t) β hβ (hX.lawB t)
  have hind : IndepFun (X (.spec t)) (X (.real t)) P :=
    indepFun_of hX (S := {Idx.spec t}) (T := {Idx.real t}) (by simp)
      (meas_mS X (mem_singleton _)) (meas_mS X (mem_singleton _))
  refine expTail P _ (α + β) (by linarith) ((hX.meas _).min (hX.meas _)) ?_ ?_
  · filter_upwards [a1, b1] with ω ha hb
    exact le_min ha hb
  · intro s hs
    have : {ω | s < min (X (.spec t) ω) (X (.real t) ω)} =
        X (.spec t) ⁻¹' Ioi s ∩ X (.real t) ⁻¹' Ioi s := by
      ext ω; simp
    rw [this, hind.measure_inter_preimage_eq_mul _ _ measurableSet_Ioi measurableSet_Ioi]
    change P {ω | s < X _ ω} * P {ω | s < X _ ω} = _
    rw [a2 s hs.le, b2 s hs.le, ← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add]
    congr 2; ring

lemma probHit (hX : IsSpecModel P k α β p X) (hp0 : 0 < p) (hp1 : p ≤ 1) (t : ℕ) :
    P.real (hitSet X t) = 1 - (1 - p) ^ k := by
  have hc : (hitSet X t)ᶜ = ⋂ i : Fin k, (fun i : Fin k => X (.branch t i)) i ⁻¹' {1}ᶜ := by
    ext ω; simp [hitSet, hitAt]
  have hinj : Function.Injective (fun i : Fin k => (Idx.branch t i : Idx k)) := by
    intro i j h; cases h; rfl
  have hind := hX.indep.precomp hinj
  have hmeas : P (hitSet X t)ᶜ = ENNReal.ofReal ((1 - p) ^ k) := by
    rw [hc, hind.meas_iInter (s := fun i => (fun i : Fin k => X (.branch t i)) i ⁻¹' {1}ᶜ)
      (fun i => ⟨{1}ᶜ, (measurableSet_singleton 1).compl, rfl⟩)]
    have : ∀ i : Fin k, P ((fun i : Fin k => X (.branch t i)) i ⁻¹' {1}ᶜ) = ENNReal.ofReal (1 - p) := by
      intro i
      simp only
      rw [← Measure.map_apply (hX.meas _) (measurableSet_singleton 1).compl, hX.lawG t i]
      simp [bernoulliReal, Measure.dirac_apply']
    simp only [this, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    rw [ENNReal.ofReal_pow (by linarith)]
  have hms : MeasurableSet (hitSet X t) := mS_le X hX.meas _ _ (hitSet_meas X t)
  have h1 : P (hitSet X t) = ENNReal.ofReal (1 - (1 - p) ^ k) := by
    rw [← compl_compl (hitSet X t), prob_compl_eq_one_sub hms.compl, hmeas, ← ENNReal.ofReal_one,
      ← ENNReal.ofReal_sub _ (pow_nonneg (by linarith) _)]
  rw [measureReal_def, h1, ENNReal.toReal_ofReal]
  have : (1 - p) ^ k ≤ 1 := pow_le_one₀ (by linarith) (by linarith)
  linarith

lemma intH (hX : IsSpecModel P k α β p X) (hp0 : 0 < p) (hp1 : p ≤ 1) (t : ℕ) :
    Integrable (hI X t) P ∧ ∫ ω, hI X t ω ∂P = 1 - (1 - p) ^ k := by
  have hms : MeasurableSet (hitSet X t) := mS_le X hX.meas _ _ (hitSet_meas X t)
  refine ⟨(integrable_const (1:ℝ)).indicator hms, ?_⟩
  rw [← probHit hX hp0 hp1 t]
  exact integral_indicator_one hms
lemma specRun_two (ω : Ω) (t n : ℕ) :
    specRun X ω t (n + 2) = hI X t ω * (min (X (.spec t) ω) (X (.real t) ω) + X (.real (t + 1)) ω
      + specRun X ω (t + 2) n) + (1 - hI X t ω) * (X (.real t) ω + specRun X ω (t + 1) (n + 1)) := by
  by_cases h : hitAt X t ω
  · have : hI X t ω = 1 := by simp [hI, hitSet, h]
    rw [this, specRun, if_pos h]; ring
  · have : hI X t ω = 0 := by simp [hI, hitSet, h]
    rw [this, specRun, if_neg h]; ring

lemma Bt_sub_Ge (t : ℕ) : Bt k t ⊆ Ge k t := by
  rintro _ ⟨i, rfl⟩; simp [Ge, ix]

lemma Ge_mono {s t : ℕ} (h : s ≤ t) : Ge k t ⊆ Ge k s := fun j hj => le_trans h hj

lemma measRun : ∀ n t : ℕ, Measurable[mS X (Ge k t)] (fun ω => specRun X ω t n) ∧
    Measurable[mS X (Ge k t)] (fun ω => specRun X ω t (n + 1)) := by
  intro n
  induction n with
  | zero =>
    intro t
    refine ⟨by simp only [specRun]; exact measurable_const, ?_⟩
    simp only [specRun]
    exact meas_mS X (S := Ge k t) (j := .real t) (by simp [Ge, ix])
  | succ n ih =>
    intro t
    refine ⟨(ih t).2, ?_⟩
    have e : (fun ω => specRun X ω t (n + 2)) = fun ω => hI X t ω * (min (X (.spec t) ω) (X (.real t) ω)
        + X (.real (t + 1)) ω + specRun X ω (t + 2) n) + (1 - hI X t ω) * (X (.real t) ω
        + specRun X ω (t + 1) (n + 1)) := funext fun ω => specRun_two ω t n
    rw [e]
    have hh : Measurable[mS X (Ge k t)] (hI X t) := (hI_meas X t).mono (mS_mono X (Bt_sub_Ge t)) le_rfl
    have hs : Measurable[mS X (Ge k t)] (X (.spec t)) := meas_mS X (by simp [Ge, ix])
    have hr : Measurable[mS X (Ge k t)] (X (.real t)) := meas_mS X (by simp [Ge, ix])
    have hr1 : Measurable[mS X (Ge k t)] (X (.real (t + 1))) := meas_mS X (by simp [Ge, ix])
    have h2 : Measurable[mS X (Ge k t)] (fun ω => specRun X ω (t + 2) n) :=
      (ih (t + 2)).1.mono (mS_mono X (Ge_mono (by omega))) le_rfl
    have h1 : Measurable[mS X (Ge k t)] (fun ω => specRun X ω (t + 1) (n + 1)) :=
      (ih (t + 1)).2.mono (mS_mono X (Ge_mono (by omega))) le_rfl
    exact (hh.mul (((hs.min hr).add hr1).add h2)).add ((measurable_const.sub hh).mul (hr.add h1))

lemma dis0 (t : ℕ) : Disjoint (Bt k t) (T0 k t) := by
  rw [Set.disjoint_left]; rintro _ ⟨i, rfl⟩ h; simp [T0] at h

lemma dis1 (t : ℕ) : Disjoint (Bt k t) (Ge k (t + 1)) := by
  rw [Set.disjoint_left]; rintro _ ⟨i, rfl⟩ h; simp [Ge, ix] at h

variable {P : Measure Ω} [IsProbabilityMeasure P] {α β p : ℝ}

lemma intRun (hX : IsSpecModel P k α β p X) (hα : 0 < α) (hβ : 0 < β) (hp0 : 0 < p) (hp1 : p ≤ 1) :
    ∀ n t : ℕ,
      (Integrable (fun ω => specRun X ω t n) P ∧ ∫ ω, specRun X ω t n ∂P =
        (n : ℝ) / β - α / (β * (α + β)) * SpecActions.hits (1 - (1 - p) ^ k) (n - 1)) ∧
      (Integrable (fun ω => specRun X ω t (n + 1)) P ∧ ∫ ω, specRun X ω t (n + 1) ∂P =
        ((n + 1 : ℕ) : ℝ) / β - α / (β * (α + β)) * SpecActions.hits (1 - (1 - p) ^ k) (n + 1 - 1)) := by
  set q := 1 - (1 - p) ^ k with hq
  intro n
  induction n with
  | zero =>
    intro t
    refine ⟨⟨by simp only [specRun]; exact integrable_const 0, by simp [specRun, SpecActions.hits]⟩, ?_⟩
    simp only [specRun]
    refine ⟨(intB hX hβ t).1, ?_⟩
    rw [(intB hX hβ t).2]; simp [SpecActions.hits]
  | succ n ih =>
    intro t
    refine ⟨(ih t).2, ?_⟩
    have e : (fun ω => specRun X ω t (n + 2)) = fun ω =>
        hI X t ω * min (X (.spec t) ω) (X (.real t) ω) + hI X t ω * X (.real (t + 1)) ω
        + hI X t ω * specRun X ω (t + 2) n + (1 - hI X t ω) * X (.real t) ω
        + (1 - hI X t ω) * specRun X ω (t + 1) (n + 1) :=
      funext fun ω => by rw [specRun_two ω t n]; ring
    have hh := hI_meas X t
    have hh' : Measurable[mS X (Bt k t)] (fun ω => 1 - hI X t ω) := measurable_const.sub hh
    obtain ⟨Hi, Hv⟩ := intH hX hp0 hp1 t
    have Hi' : Integrable (fun ω => 1 - hI X t ω) P := (integrable_const 1).sub Hi
    have Hv' : ∫ ω, (1 - hI X t ω) ∂P = 1 - q := by
      rw [integral_sub (integrable_const 1) Hi, Hv]; simp [hq]
    have hs : Measurable[mS X (T0 k t)] (X (.spec t)) := meas_mS X (by simp [T0])
    have hr : Measurable[mS X (T0 k t)] (X (.real t)) := meas_mS X (by simp [T0])
    have hr1 : Measurable[mS X (Ge k (t + 1))] (X (.real (t + 1))) := meas_mS X (by simp [Ge, ix])
    have h2 : Measurable[mS X (Ge k (t + 1))] (fun ω => specRun X ω (t + 2) n) :=
      ((measRun n (t + 2)).1).mono (mS_mono X (Ge_mono (by omega))) le_rfl
    have h1 : Measurable[mS X (Ge k (t + 1))] (fun ω => specRun X ω (t + 1) (n + 1)) :=
      (measRun n (t + 1)).2
    obtain ⟨I1, V1⟩ := prodInt hX (dis0 t) hh (hs.min hr) Hi (intMin hX hα hβ t).1
    obtain ⟨I2, V2⟩ := prodInt hX (dis1 t) hh hr1 Hi (intB hX hβ (t + 1)).1
    obtain ⟨I3, V3⟩ := prodInt hX (dis1 t) hh h2 Hi (ih (t + 2)).1.1
    obtain ⟨I4, V4⟩ := prodInt hX (dis0 t) hh' hr Hi' (intB hX hβ t).1
    obtain ⟨I5, V5⟩ := prodInt hX (dis1 t) hh' h1 Hi' (ih (t + 1)).2.1
    have J2 : Integrable (fun ω => hI X t ω * min (X (.spec t) ω) (X (.real t) ω)
        + hI X t ω * X (.real (t + 1)) ω) P := I1.add I2
    have J3 : Integrable (fun ω => hI X t ω * min (X (.spec t) ω) (X (.real t) ω)
        + hI X t ω * X (.real (t + 1)) ω + hI X t ω * specRun X ω (t + 2) n) P := J2.add I3
    have J4 : Integrable (fun ω => hI X t ω * min (X (.spec t) ω) (X (.real t) ω)
        + hI X t ω * X (.real (t + 1)) ω + hI X t ω * specRun X ω (t + 2) n
        + (1 - hI X t ω) * X (.real t) ω) P := J3.add I4
    refine ⟨by rw [e]; exact J4.add I5, ?_⟩
    rw [e, integral_add J4 I5, integral_add J3 I4, integral_add J2 I3, integral_add I1 I2, V1, V2, V3, V4, V5, Hv, Hv',
      (intMin hX hα hβ t).2, (intB hX hβ (t + 1)).2, (intB hX hβ t).2, (ih (t + 2)).1.2,
      (ih (t + 1)).2.2]
    have hb : β ≠ 0 := hβ.ne'
    have hab : α + β ≠ 0 := by linarith
    rcases n with _ | m
    · simp [SpecActions.hits]
      field_simp
      ring
    · simp only [show m + 1 + 1 + 1 - 1 = m + 2 by omega, show m + 1 - 1 = m by omega,
        show m + 1 + 1 - 1 = m + 1 by omega, SpecActions.hits]
      push_cast
      field_simp
      ring

