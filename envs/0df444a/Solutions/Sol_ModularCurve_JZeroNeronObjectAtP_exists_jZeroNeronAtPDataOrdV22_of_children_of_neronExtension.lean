private theorem _root_.ModularCurve.JZeroNeronObjectAtP.NeronExtension.smul_mem_extPts
    (heckeN : letI := heckeModuleBar (N₀ * p)
      ∀ t : HeckeAlg, ∃ φ : SchemeHomOver F.gN F.gN, ∀ x : JZero (N₀ * p), (F.ptsN (t • x)).1 = (F.ptsN x).1 ≫ φ.1)
    (t : HeckeAlg) {x : JZero (N₀ * p)} (hx : x ∈ F.extPts) :
    (letI := heckeModuleBar (N₀ * p); t • x) ∈ F.extPts := by
