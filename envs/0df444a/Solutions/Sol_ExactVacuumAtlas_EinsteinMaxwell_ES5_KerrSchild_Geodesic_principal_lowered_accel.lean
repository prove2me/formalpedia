section R05Seg6
/-! # VII-07 (F3b): exact actual acceleration of the principal null fields

Paper dictionary `g = esMetric f D A H w`, `D = m/(4fN)`, `A = m/f`, `H = N/m`, actual inverse
`esInverse`, `e = p' + w a'`, `Z = p'' + w a''`, `G = a' p'' - p' a''` (`Gfun`). For a radial
function `λ` the field `principalField λ = (x ↦ principalCoord … (λ (x 1)) x)` has coordinate
components `(e/f, λ, 0, w e/f - a'/H, w e/f - a'/H)`; VII-06's `kPlus`/`kMinus` are literally
`principalField (±√alphaSq)` (`rfl`). All derivatives are genuine; `λ` varies with `R` and its
derivative is eliminated only through the **eventual** identity `λ² = alphaSq` near the point.

Main results (no Einstein, Maxwell, BVP, conservation or `G = 0` input):
* `principal_lowered_accel`: `g·accel(K_λ) = (-λp'', (e/f) Z - a'a''/H, 0, -uλa'', -(1-u)λa'')`;
* `principal_accel_decomp`: `accel(K_λ) - (λZ/e) K_λ = (G/e) (0, a'/(DH), 0, λ/H, λ/H)` (`e ≠ 0`);
* `vii07_principal_acceleration` (both actual `k±`) and `vii07_principal_pregeodesic_iff_G`
  (`k₊` pregeodesic ⇔ `G(R) = 0` ⇔ `k₋` pregeodesic), and the nonzero-rescaling corollary. -/

open scoped ContDiff Topology Matrix
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.NullDirections

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic

theorem principalField_apply (f m N w p a lam : ℝ → ℝ) (x : Pt 5) :
    principalField f m N w p a lam x =
      ![eFun w p a (x 1) / f (x 1), lam (x 1), 0,
        w (x 1) * (eFun w p a (x 1) / f (x 1)) - deriv a (x 1) / Hfun m N (x 1),
        w (x 1) * (eFun w p a (x 1) / f (x 1)) - deriv a (x 1) / Hfun m N (x 1)] :=
  principalCoord_eq f m N w p a (lam (x 1)) x

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ}

/-! ## Genuine radial derivatives -/

theorem hasDerivAt_eFun (hP : PaperData I f m N w p a) {r : ℝ} (hr : r ∈ I) :
    HasDerivAt (eFun w p a)
      (deriv (deriv p) r + (deriv w r * deriv a r + w r * deriv (deriv a) r)) r :=
  (hP.d2p hr).add ((hP.dw hr).mul (hP.d2a hr))

/-- Genuine derivative of the actual discriminant `alphaSq = 4((N/m) e² - f (a')²)`. -/
theorem hasDerivAt_alphaSq (hP : PaperData I f m N w p a) {r : ℝ} (hr : r ∈ I) :
    HasDerivAt (alphaSq f m N w p a)
      (4 * ((deriv N r * m r - N r * deriv m r) / m r ^ 2 * eFun w p a r ^ 2 +
        N r / m r * (2 * eFun w p a r *
          (deriv (deriv p) r + (deriv w r * deriv a r + w r * deriv (deriv a) r))) -
        (deriv f r * deriv a r ^ 2 + f r * (2 * deriv a r * deriv (deriv a) r)))) r := by
  have h := ((((hP.dN hr).div (hP.dm hr) (hP.nm r hr)).mul
    ((hasDerivAt_eFun hP hr).pow 2)).sub ((hP.df hr).mul ((hP.d2a hr).pow 2))).const_mul 4
  exact h.congr_deriv (by
    simp only [Pi.pow_apply, Pi.div_apply, Nat.cast_ofNat, Nat.reduceSub, pow_one])

/-! ## Actual lowering of the principal vector (pointwise algebra) -/

/-- `g K_λ = (-p', D λ, 0, -u a', -(1-u) a')` for the actual metric, any `λ`. -/
theorem principal_lower {y : Pt 5} (hf : f (y 1) ≠ 0) (hm : m (y 1) ≠ 0) (hN : N (y 1) ≠ 0)
    (lam : ℝ) :
    metricMatrix (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w) y *ᵥ
        principalCoord f m N w p a lam y =
      ![-deriv p (y 1), Dfun f m N (y 1) * lam, 0, -(y 2 * deriv a (y 1)),
        -((1 - y 2) * deriv a (y 1))] := by
  rw [principalCoord_eq]
  funext b
  fin_cases b <;>
    simp [Matrix.mulVec, dotProduct, Fin.sum_univ_five, metricMatrix, esMetric, eFun, Hfun,
      Afun] <;>
    field_simp <;> ring

/-! ## The lowered actual acceleration of `principalField λ` -/

/-- For a vector with vanishing `u`-component only the radial slot of `Σ_j K^j ∂_j` survives on a
function of `(r, u)`. -/
theorem sum_pd_liftRU {K : Fin 5 → ℝ} (hK2 : K 2 = 0) (F : ℝ → ℝ → ℝ) (x : Pt 5) :
    ∑ j, K j * pd j (liftRU F) x = K 1 * deriv (fun s => F s (x 2)) (x 1) := by
  simp [Fin.sum_univ_five, pd_liftRU_zero, pd_liftRU_three, pd_liftRU_four, pd_liftRU_one, hK2]

theorem sum_pd_congr (K : Fin 5 → ℝ) {φ ψ : Pt 5 → ℝ} {O : Set (Pt 5)} (hO : IsOpen O)
    {x : Pt 5} (hx : x ∈ O) (h : Set.EqOn φ ψ O) :
    ∑ j, K j * pd j φ x = ∑ j, K j * pd j ψ x := by
  simp only [pd_congr_of_eqOn hO hx h]

/-! ## Exact decomposition and the pregeodesic criterion -/

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Geodesic
end R05Seg6

