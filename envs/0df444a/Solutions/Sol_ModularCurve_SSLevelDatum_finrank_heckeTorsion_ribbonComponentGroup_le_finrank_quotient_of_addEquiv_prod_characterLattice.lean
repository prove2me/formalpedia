theorem compS_diag_comm (ℓ : Nat.Primes) (x : ↥(characterLattice V) × ↥(characterLattice V)) :
    Q.compS (LinearMap.prodMap (Q.tV ℓ) (Q.tV ℓ) x) = LinearMap.prodMap (Q.tV ℓ) (Q.tV ℓ) (Q.compS x) := by
  apply Prod.ext
  · show Q.tV Q.s (Q.tV ℓ x.1) - Q.tV ℓ x.2 = Q.tV ℓ (Q.tV Q.s x.1 - x.2)
