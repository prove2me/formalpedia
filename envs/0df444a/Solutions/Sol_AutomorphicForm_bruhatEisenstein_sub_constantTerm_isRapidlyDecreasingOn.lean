section CharFactor

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

private def psiW (χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ) (t : ℝ) : ℂ :=
  ((χ₁ (realIdeleAt hw (expR (-t))) : ℂˣ) : ℂ) * ((χ₂ (realIdeleAt hw (expR t)) : ℂˣ) : ℂ)

variable {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}

private theorem isOneParamGroup_psiW
    (hc₁ : Continuous fun r : ℝˣ => ((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℝˣ => ((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ)) :
    IsOneParamGroup (psiW hw χ₁ χ₂) where
  map_zero := by simp [psiW, expR_zero]
  map_add s t := by
    simp only [psiW, neg_add, expR_add, map_mul, Units.val_mul]
    ring
  continuous := (hc₁.comp (continuous_expR.comp continuous_neg)).mul (hc₂.comp continuous_expR)

private theorem norm_psiW_le {τ : ℝ}
    (hs₁ : ∀ r : ℝˣ, ‖((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ |(r : ℝ)| ^ τ)
    (hs₂ : ∀ r : ℝˣ, ‖((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ |(r : ℝ)| ^ (-τ)) (t : ℝ) :
    ‖psiW hw χ₁ χ₂ t‖ ≤ 1 * Real.exp (-(2 * τ) * t) := by
  rw [psiW, norm_mul, one_mul]
  have h1 := hs₁ (expR (-t))
  have h2 := hs₂ (expR t)
  rw [coe_expR, abs_of_pos (Real.exp_pos _), ← Real.exp_mul] at h1
  rw [coe_expR, abs_of_pos (Real.exp_pos _), ← Real.exp_mul] at h2
  calc _ ≤ Real.exp (-t * τ) * Real.exp (t * -τ) := mul_le_mul h1 h2 (norm_nonneg _) (Real.exp_pos _).le
    _ = Real.exp (-(2 * τ) * t) := by rw [← Real.exp_add]; congr 1; ring

private theorem norm_iteratedDeriv_le_of_isOneParamGroup {Ψ : ℝ → ℂ} (hΨ : IsOneParamGroup Ψ) (j : ℕ) (t : ℝ) :
    ‖iteratedDeriv j Ψ t‖ ≤ ‖deriv Ψ 0‖ ^ j * ‖Ψ t‖ := by
  rw [mul_comm]; exact hΨ.norm_iteratedDeriv_le j t

end CharFactor
