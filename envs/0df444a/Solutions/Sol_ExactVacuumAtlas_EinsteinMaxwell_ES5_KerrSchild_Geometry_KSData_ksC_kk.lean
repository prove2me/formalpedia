include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (a : Fin 5) :
    ∑ p, ∑ q, ksC b bi v k a p q x * k x p * k x q = 0 := by
  have e : ∑ p, ∑ q, ksC b bi v k a p q x * k x p * k x q =
      ∑ p, k x p * ∑ q, ksC b bi v k a p q x * k x q := by
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun q _ => by ring
  rw [e]
  simp only [hD.ksC_M hx]
  have e2 : ∑ p, k x p * ((dprof v k x * k x a * lowerK b k x p
      + v x * accel b bi k x a * lowerK b k x p + v x * k x a * accL b bi k x p) / 2) =
      (dprof v k x * k x a * (∑ p, k x p * lowerK b k x p)
        + v x * accel b bi k x a * (∑ p, k x p * lowerK b k x p)
        + v x * k x a * (∑ p, k x p * accL b bi k x p)) / 2 := by
    simp only [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.sum_div]
    exact Finset.sum_congr rfl fun p _ => by ring
  rw [e2, hD.k_dot_lower hx, hD.k_dot_accL hx]
  ring
