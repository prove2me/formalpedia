theorem BianchiIX.coreBootstrap_strong_numerator {k r u v w c : ℝ} (hk : 6 ≤ k)
    (hr : 99 / 100 * k ≤ r) (hv : v ≤ r) (hc : -1 ≤ c)
    (hu : 0 ≤ u ∧ u ≤ (1 / 10000) / k) (hw : 0 ≤ w ∧ w ≤ (1 / 10000) / k) :
    -r / 2 - c + (v / r) * w + (u ^ 2 - w ^ 2) / (2 * r) ≤ -3 * k / 10 := by sorry
