-- Source module: Solutions.J6SegILSrc1
/-!
# B-line IL, source-table producers, part 1: managed states and register-program steps

All producers are register programs (`RS`, `NLogN.HReg`) run on managed states `encK s0 F`
(`Sp p (encK s0 F) (encK s0 F') C` for every base `s0`). The stacks the producers write are
`13, 14, 15, 30, 31, 32, 33, 43, 44`; the state is kept in the form `bS G a13 … a44` (those nine
stacks over `G`). The input stacks are parameters (any stack `< 56` outside that list, `Free`).

* `pushP`, `asgP`, `popP`: one step with the cost from a uniform register bound `2^A` and the
  expression degree `D` (`B = A·D + 1` bits, `J6Seg.PreT.mg_lt`).
* `encK_rebase`: move the managed contents of one stack into the base state (so the `rep`
  counters may start non-empty).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg.PreT

/-! ## Steps -/

theorem zsz_le_AD {a : ℤ} {A D : ℕ} (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) : zsz a ≤ A * D + 1 := by
  apply NLogN.zsz_le_of_abs
  have : (2 : ℤ) ^ A < 2 ^ (A * D + 1) :=
    pow_lt_pow_right₀ (by norm_num) (by nlinarith)
  linarith

theorem popP (s : IState HS) (F : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {A D : ℕ}
    (hi : i.val < 56) (hf : F i = a :: l) (ha : |a| ≤ 2 ^ A) (hD : 1 ≤ D) :
    Sp (.pop i) (encK s F) (encK s (update F i l)) (uC A D) := by
  refine (Sp.pop s F hi hf (zsz_le_AD ha hD)).mono ?_
  unfold uC; nlinarith

end J6Seg.Src

end

