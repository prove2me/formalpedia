theorem locIsoOnBase_of_iso {R : Type} [CommRing R] {X : Scheme.{0}} (g : X ⟶ Spec (CommRingCat.of R))
    {M M' : X.Modules} (e : M ≅ M') : LocIsoOnBase g M M' :=
  fun _ => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback (g ⁻¹ᵁ ⊤).ι).mapIso e⟩⟩

theorem isIso_of_isClosedImmersion_of_comp_eq_specMap {T R : Type} [CommRing T] [CommRing R] (φ : T →+* R)
    (hφ : Function.Injective φ) {Z : Scheme.{0}} (ι : Z ⟶ Spec (CommRingCat.of T)) [IsClosedImmersion ι]
    (ψ₀ : Spec (CommRingCat.of R) ⟶ Z) (h : ψ₀ ≫ ι = Spec.map (CommRingCat.ofHom φ)) : IsIso ι := by
  apply IsClosedImmersion.isIso_of_injective_of_isAffine

  have nat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ)
  have hinjφ : Function.Injective ((Spec.map (CommRingCat.ofHom φ)).appTop) := by
    intro a b hab
    have h1 := (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of T)).hom).1
    apply h1
    apply hφ
    have := congrArg (fun k => (k : _ → _) a) (congrArg (fun k => (ConcreteCategory.hom k : _ → _)) nat)
    have hb := congrArg (fun k => (k : _ → _) b) (congrArg (fun k => (ConcreteCategory.hom k : _ → _)) nat)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, CommRingCat.hom_ofHom] at this hb
    rw [← this, ← hb, hab]
  intro a b hab
  apply hinjφ
  rw [← h]
  simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, hab]

