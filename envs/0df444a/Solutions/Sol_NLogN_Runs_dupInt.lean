-- Source module: NLogNP.Item
namespace NLogN

variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

end NLogN

namespace NLogN

theorem zipL_copy : ∀ (c : Bool) (A B : List Bool), A = [] → (zipL fCopy c A B).1 = B
  | c, [], [] => by simp [zipL]
  | c, [], y :: B => by intro _; simp [zipL, fCopy, zipL_copy false [] B rfl]
  | _, _ :: _, _ => by intro h; cases h

end NLogN

