variable {R : Type} [CommRing R]

private theorem transposeInv3_mul
    (X Y : GL (Fin 3) R) : transposeInv3 (X * Y) = transposeInv3 X * transposeInv3 Y := by
  refine Units.ext ?_
  change Matrix.transpose (((X * Y)⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) =
    Matrix.transpose ((X⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) *
      Matrix.transpose ((Y⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R)
  rw [mul_inv_rev, Units.val_mul, Matrix.transpose_mul]

private theorem coe_transposeInv3_of_coe_inv_eq_diagonal {X : GL (Fin 3) R} {e : Fin 3 → R}
    (h : ((X⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) = Matrix.diagonal e) :
    (transposeInv3 X : Matrix (Fin 3) (Fin 3) R) = Matrix.diagonal e := by
  change Matrix.transpose ((X⁻¹ : GL (Fin 3) R) : Matrix (Fin 3) (Fin 3) R) = _
  rw [h, Matrix.diagonal_transpose]

private theorem transposeInv3_glScalar (z : Rˣ) :
    transposeInv3 (Matrix.GeneralLinearGroup.scalar (Fin 3) z) = Matrix.GeneralLinearGroup.scalar (Fin 3) z⁻¹ := by
  refine Units.ext ?_
  rw [coe_transposeInv3_of_coe_inv_eq_diagonal (e := fun _ => ((z⁻¹ : Rˣ) : R)) ?_, ScalarComponents.coe_glScalar,
    Matrix.scalar_apply]
  rw [← map_inv, ScalarComponents.coe_glScalar, Matrix.scalar_apply]

private theorem transposeInv3_glScalar_mul (z : Rˣ) (X : GL (Fin 3) R) :
    transposeInv3 (Matrix.GeneralLinearGroup.scalar (Fin 3) z * X) =
      Matrix.GeneralLinearGroup.scalar (Fin 3) z⁻¹ * transposeInv3 X := by
  rw [transposeInv3_mul, transposeInv3_glScalar]

private theorem lowerUnipotent21_mul_iotaGL_diagUnitGL2 (x : R) (b : Rˣ) :
    lowerUnipotent21 x * iotaGL (diagUnitGL2 b) = iotaGL (diagUnitGL2 b) * lowerUnipotent21 ((b : R) * x) := by
  refine Units.ext ?_
  rw [Units.val_mul, Units.val_mul, TorusPoints.coe_iotaGL_diagUnitGL2]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [lowerUnipotent21, Matrix.mul_apply, Matrix.diagonal]
  ring

private theorem dualWhittakerFn3_glScalar_mul {ω : Rˣ →* ℂˣ} {W : GL (Fin 3) R → ℂ}
    (hW : ∀ (z : Rˣ) (g : GL (Fin 3) R),
      W (Matrix.GeneralLinearGroup.scalar (Fin 3) z * g) = ((ω z : ℂˣ) : ℂ) * W g)
    (z : Rˣ) (X : GL (Fin 3) R) :
    dualWhittakerFn3 W (Matrix.GeneralLinearGroup.scalar (Fin 3) z * X) =
      ((ω z⁻¹ : ℂˣ) : ℂ) * dualWhittakerFn3 W X := by
  rw [dualWhittakerFn3_apply, dualWhittakerFn3_apply, transposeInv3_glScalar_mul, ← mul_assoc,
    ← ScalarComponents.glScalar_mul_comm, mul_assoc, hW]

