theorem CerednikDrinfeld.exists_mem_rationalHomSet_comp_eq_id_forall_mem_ker_of_image_kernelIdealSet_eq_image_mul
    {κ : Type} [Field κ] [IsAlgClosed κ] [DecidableEq κ]
    (q' : ℕ) [Fact q'.Prime] [CharP κ q']
    (X₀ : WeierstrassCurve κ) [X₀.IsElliptic] (hss : ∀ P : X₀.toAffine.Point, q' • P = 0 → P = 0)
    (a b : ℚ) (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsOrder Λ)
    (θ : ↥(WeierstrassCurve.rationalEndSubring κ X₀) →+* ℍ[ℚ, a, b])
    (hθ : Function.Injective θ) (hθΛ : Set.range θ = (Λ : Set ℍ[ℚ, a, b]))
    (W W' : WeierstrassCurve κ) [W.IsElliptic] [W'.IsElliptic]
    (χ : X₀.toAffine.Point →+ W.toAffine.Point) (hχ : χ ∈ WeierstrassCurve.rationalHomSet κ X₀ W) (hχ0 : χ ≠ 0)
    (χ' : X₀.toAffine.Point →+ W'.toAffine.Point) (hχ' : χ' ∈ WeierstrassCurve.rationalHomSet κ X₀ W') (hχ'0 : χ' ≠ 0)
    (c : ℍ[ℚ, a, b]) (hc0 : c ≠ 0)
    (hmul : θ '' WeierstrassCurve.kernelIdealSet κ X₀ W' χ' =
      (· * c) '' (θ '' WeierstrassCurve.kernelIdealSet κ X₀ W χ))
    (W₁ W₁' : WeierstrassCurve κ) [W₁.IsElliptic] [W₁'.IsElliptic]
    (ψ : W.toAffine.Point →+ W₁.toAffine.Point) (hψ : ψ ∈ WeierstrassCurve.rationalHomSet κ W W₁) (hψ0 : ψ ≠ 0)
    (ψ' : W'.toAffine.Point →+ W₁'.toAffine.Point) (hψ' : ψ' ∈ WeierstrassCurve.rationalHomSet κ W' W₁') (hψ'0 : ψ' ≠ 0)
    (hmul₂ : θ '' WeierstrassCurve.kernelIdealSet κ X₀ W₁' (ψ'.comp χ') =
      (· * c) '' (θ '' WeierstrassCurve.kernelIdealSet κ X₀ W₁ (ψ.comp χ))) :
    ∃ φ ∈ WeierstrassCurve.rationalHomSet κ W W', ∃ φ' ∈ WeierstrassCurve.rationalHomSet κ W' W,
      φ'.comp φ = AddMonoidHom.id _ ∧ φ.comp φ' = AddMonoidHom.id _ ∧
      (∃ (n : ℕ) (γ₀ : ↥(WeierstrassCurve.rationalEndSubring κ X₀)), n ≠ 0 ∧ θ γ₀ = (n : ℤ) • c ∧
        φ.comp (χ.comp ((γ₀ : AddMonoid.End (X₀.baseChange κ).toAffine.Point) :
          (X₀.baseChange κ).toAffine.Point →+ (X₀.baseChange κ).toAffine.Point)) = n • χ') ∧
      ∀ T ∈ ψ.ker, φ T ∈ ψ'.ker := by sorry
