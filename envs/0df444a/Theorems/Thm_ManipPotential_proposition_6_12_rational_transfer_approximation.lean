-- title:
--   Rational transfer-cone approximation at arbitrary precision
-- statement:
--   Let $D=DG(z_0)$, let $T=\operatorname{im}D$, and let $C=\operatorname{span}_{\ge0}(\mathcal T_{ij})$ be the nonnegative cone generated by the transfer vectors (17). Put $V=\ell_i-\ell_j$. If
--   $$
--   -V\in\operatorname{cl}(C+T),
--   $$
--   then for every $\eta>0$ there are a direction $v$, finitely many transfer vectors $u_1,\ldots,u_q\in\mathcal T_{ij}$, and nonnegative rational coefficients $\beta_1,\ldots,\beta_q$ such that
--   $$
--   \left\|\sum_{h=1}^q\beta_h u_h-(Dv-V)\right\|_\infty<\eta.
--   $$
--
--   This is the closure and rational-approximation part of Step 1. The rationality of the coefficients is essential: the subsequent path must consist of rational ballot profiles. The list is allowed to be empty and zero coefficients need not be discarded; both conventions are harmless in the finite construction.
--
--   **Formalization Note** The finite list is encoded by functions on `Fin q`, and rational coefficients are cast to real numbers only in the displayed approximation.
-- source:
--   Berker, Conitzer, Hartman, Liu, Oesterheld, How Many Votes Is a Lie Worth? Measuring Strategyproofness through Resource Augmentation, arXiv:2602.22838 (version of November 3, 2026, sha256 5a383ac5…), Proposition 6.12, Step 1, p.36, paragraph after Eq. (21): approximation of $c_0\in C$ and rational coefficients $\beta_h$.

import Mathlib
import Definitions.Def_ManipPotential_TransferVectors
import Definitions.Def_ManipPotential_ell
import Definitions.Def_ManipPotential_unitVec
import Definitions.Def_ManipPotential_ExtRanking

open scoped NNReal Pointwise

namespace ManipPotential

/-- Closure membership supplies a rational nonnegative transfer combination arbitrarily close to
`D v - (ℓ_i - ℓ_j)`, the first approximation in Proposition 6.12, Step 1. -/
theorem proposition_6_12_rational_transfer_approximation {m : ℕ} [NeZero m]
    (K : ℕ) (G : ((ExtRanking m → ℝ) × ℝ) → (Ranking m → ℝ))
    (z₀ : ((ExtRanking m → ℝ) × ℝ)) (i j : Fin m)
    (hmem :
      let D : ((ExtRanking m → ℝ) × ℝ) →ₗ[ℝ] (Ranking m → ℝ) :=
        (fderiv ℝ G z₀).toLinearMap
      let T : Submodule ℝ (Ranking m → ℝ) := LinearMap.range D
      let C : Submodule ℝ≥0 (Ranking m → ℝ) :=
        Submodule.span ℝ≥0 (TransferVectors ((K : ℝ) + 1) i j)
      (-(unitVec (ell i) - unitVec (ell j))) ∈
        closure ((C : Set (Ranking m → ℝ)) + (T : Set (Ranking m → ℝ))))
    (η : ℝ) (hη : 0 < η) :
    ∃ (v : ((ExtRanking m → ℝ) × ℝ)) (q : ℕ)
      (u : Fin q → Ranking m → ℝ) (β : Fin q → ℚ),
      (∀ h, u h ∈ TransferVectors ((K : ℝ) + 1) i j) ∧
      (∀ h, 0 ≤ β h) ∧
      ‖(∑ h, (β h : ℝ) • u h) -
        ((fderiv ℝ G z₀) v - (unitVec (ell i) - unitVec (ell j)))‖ < η := by sorry
