theorem NLogN.KFM.srcS_ok (d d' r : ℕ) (hd : 1 ≤ d) (hd' : d' ≤ d) (hr : 2 ∣ r)
    (hbig : 64 * d ^ 2 * (256 * d ^ 2).factorial ≤ r) :
    (∀ i : Fin d, Odd (srcS d d' r i)) ∧
    (∀ i j : Fin d, i ≠ j → Nat.Coprime (srcS d d' r i) (srcS d d' r j)) ∧
    ∀ i : Fin d, (4 * d - 2) * (if (i : ℕ) < d' then r / 2 else r) < 4 * d * srcS d d' r i ∧
      4 * d * srcS d d' r i ≤ (4 * d - 1) * (if (i : ℕ) < d' then r / 2 else r) := by sorry
