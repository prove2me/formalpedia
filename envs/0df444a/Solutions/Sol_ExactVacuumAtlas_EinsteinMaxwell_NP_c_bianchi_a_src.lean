theorem KNFam.smooth_weylFVar (I J A K : Fin 4) :
    ContDiffOn ℝ ∞ (weylFVar gK giK h EK B I J A K) {y | ((0 : ℝ), y) ∈ W} := by
  have := hK.fam.smooth_weylFVar ht I J A K
  rwa [hK.g0, hK.gi0, hK.E0] at this

