      (reciprocalToFiniteAffineScheme R h104).opensRange = (ordinaryInfinityChartMap R).opensRange := by
  let := reciprocalToFiniteAffineScheme_isOpenImmersion R h104
  let : IsOpenImmersion (ordinaryInfinityChartMap R) :=
    IsOpenImmersion.of_isLocalization (p R * (p R + t R))
  apply TopologicalSpace.Opens.ext
  ext a
  change ordinaryToFiniteAffineScheme R a ∈ Set.range (reciprocalToFiniteAffineScheme R h104) ↔
    a ∈ Set.range (PrimeSpectrum.comap (algebraMap (CoordinateRing R) (ordinaryInfinityLocalization R)))
  rw [reciprocalToFiniteAffineScheme_range,
    PrimeSpectrum.localization_away_comap_range (ordinaryInfinityLocalization R) (p R * (p R + t R))]
  change (infinityPatchElement R : CoordinateRing R) ∉ a.asIdeal ↔ p R * (p R + t R) ∉ a.asIdeal
  have he : (infinityPatchElement R : CoordinateRing R) = p R * (p R + t R) :=
    inclusion_infinityPatchElement R
  rw [he]

