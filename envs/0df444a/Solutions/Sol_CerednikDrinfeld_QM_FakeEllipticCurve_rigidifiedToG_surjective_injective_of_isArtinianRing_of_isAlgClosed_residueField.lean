  ·
    intro ψ x x' hxx'

    have hrB : IsNilpotent ((r : ℕ) : B) := by
      have hmem : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := by rw [← hunr]; exact Ideal.mem_span_singleton_self _
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
      have : ((r : ℕ) : B) = algebraMap 𝒪 B c * algebraMap 𝒪 B π := by
        rw [← map_natCast (algebraMap 𝒪 B), ← hc, map_mul]
      rw [this]
      exact (Commute.all _ _).isNilpotent_mul_left hB
    have hrkk : ((r : ℕ) : kk) = 0 := (hrB.map (q : B →+* kk) |>.eq_zero) |> fun h => by simpa using h
    haveI : CharP kk r := (CharP.charP_iff_prime_eq_zero Fact.out).mpr hrkk
    have hNB : IsUnit ((N : ℕ) : B) := by
      have hN0 : ((N : ℕ) : kk) ≠ 0 := by
        rw [Ne, CharP.cast_eq_zero_iff kk r]; exact hrN
      by_contra hu
      have hmem : ((N : ℕ) : B) ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal _).mpr hu
      rw [← hqker, RingHom.mem_ker, map_natCast] at hmem
      exact hN0 hmem
    have hqnil : IsNilpotent (RingHom.ker (q : B →+* kk)) := by
      rw [hqker]
      obtain ⟨n, hn⟩ := IsArtinianRing.isNilpotent_jacobson_bot (R := B)
      rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top] at hn
      exact ⟨n, hn⟩

    obtain ⟨nF, fF, hfF, hcov⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_cover_connected_isFormalModuleVia_pair coord hcoord B hrB x.1 x'.1
    have hunitF : ∃ i, IsUnit (fF i) := by
      by_contra hne
      push Not at hne
      have hle : Ideal.span (Set.range fF) ≤ IsLocalRing.maximalIdeal B := by
        rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact (IsLocalRing.mem_maximalIdeal _).mpr (hne i)
      rw [hfF] at hle
      exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top (top_le_iff.mp hle)
    obtain ⟨iF, hiF⟩ := hunitF
    haveI : IsLocalization.Away (fF iF) B :=
      IsLocalization.of_le_isUnit (S := Submonoid.powers (fF iF)) (by rintro y ⟨n, rfl⟩; exact hiF.pow n)
    obtain ⟨-, hFx, hFx'⟩ := hcov iF B
    obtain ⟨X, θ, hX⟩ := hFx x.1 (𝟙 _) (by rw [Algebra.algebraMap_self]; exact M7Asm2.isPullbackVia_id x.1)
    obtain ⟨X', θ', hX'⟩ := hFx' x'.1 (𝟙 _) (by rw [Algebra.algebraMap_self]; exact M7Asm2.isPullbackVia_id x'.1)

    obtain ⟨Eκ, g, hgsq, hgmul, hgact, hglev, -⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (q : B →+* kk) x.1
    have hg : FakeEllipticCurve.IsPullbackVia (q : B →+* kk) x.1 Eκ g := ⟨hgsq, hgmul, hgact, hglev⟩
    obtain ⟨ρκ, hρκ⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isPullbackVia_of_isPullbackVia
      𝒪 π Onr Λ A₀ B kk q ψ x.1 Eκ g hg x.2
    obtain ⟨Eκ', g', hgsq', hgmul', hgact', hglev', -⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.exists_isPullback_levelIff (q : B →+* kk) x'.1
    have hg' : FakeEllipticCurve.IsPullbackVia (q : B →+* kk) x'.1 Eκ' g' := ⟨hgsq', hgmul', hgact', hglev'⟩
    obtain ⟨ρκ', hρκ'⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isPullbackVia_of_isPullbackVia
      𝒪 π Onr Λ A₀ B kk q ψ x'.1 Eκ' g' hg' x'.2

    obtain ⟨e₀, he₀, he₀V, ib₀, hib₀, hib₀f, uA₀, huA₀, huA₀g, i₀, j₀, hcorr₀, T, hT, hTe₀⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isoVia_corr_and_formalIso_of_rigidifiedToG_eq_of_isArtinianRing hrr hrN 𝒪 hdvr π hπ hcomplete hres hunr K₀ Onr Fr hOnr_complete hOnr_max hOnr_alg hOnr_closed hFr ‹IsIndefiniteRamifiedExactlyAt _ _ r rbar› Λ hΛ hΛℤ coord hcoord A₀ X₀ hX₀ θ₀ hA₀ ι Φ hΦ hΦ4 M hM η hη E₀ hE₀ κ hκ n₀ β₀ hβ₀ Ξ hΞleg hΞnat hΞiso hΞdef B hB kk hkk q hq hqker ψ hrB
        x x' X X' θ θ' hX hX' ⟨Eκ, ρκ⟩ ⟨Eκ', ρκ'⟩ g hg hρκ g' hg' hρκ' hxx'
    obtain ⟨i, hi, hiso, -, rest⟩ :=
      CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.exists_isoVia_corr_of_isoVia_corr_of_formalIso_of_isNilpotent_ker
        𝒪 π Onr Λ hΛℤ coord hcoord A₀ B kk q hq hqnil hrB hNB ψ x x' X X' θ θ' hX hX' ⟨Eκ, ρκ⟩ ⟨Eκ', ρκ'⟩ g hg hρκ g' hg' hρκ'
        e₀ he₀ he₀V ib₀ hib₀ hib₀f uA₀ huA₀ huA₀g i₀ j₀ hcorr₀ T hT hTe₀
    exact ⟨i, hi, hiso, rest⟩

