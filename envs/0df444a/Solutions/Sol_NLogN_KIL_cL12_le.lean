/-- `⌈log_m e⌉ ≤ C e^τ` (Bernoulli: `(2^τ)^(k-1) ≥ 1 + (k-1)(2^τ-1)`). -/
theorem clog_le_rpow {m : ℕ} (hm : 2 ≤ m) {τ : ℝ} (hτ : 0 < τ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ e : ℕ, 1 ≤ e → (Nat.clog m e : ℝ) ≤ C * (e : ℝ) ^ τ := by
  set b : ℝ := (2 : ℝ) ^ τ
  have hb : 1 < b := Real.one_lt_rpow (by norm_num) hτ
  have hb1 : 0 < b - 1 := by linarith
  refine ⟨1 + 1 / (b - 1), by positivity, fun e he => ?_⟩
  have heτ : 1 ≤ (e : ℝ) ^ τ := Real.one_le_rpow (by exact_mod_cast he) hτ.le
  rcases Nat.lt_or_ge 1 e with he1 | he1
  · set k := Nat.clog m e
    have hk : 0 < k := Nat.clog_pos (by omega) he1
    have hlt : m ^ k.pred < e := Nat.pow_pred_clog_lt_self (by omega) he1
    have h2 : 2 ^ (k - 1) < e := lt_of_le_of_lt (Nat.pow_le_pow_left hm _) hlt
    have h3 : ((2 : ℝ) ^ (k - 1)) ^ τ ≤ (e : ℝ) ^ τ :=
      Real.rpow_le_rpow (by positivity) (by exact_mod_cast h2.le) hτ.le
    have h4 : ((2 : ℝ) ^ (k - 1)) ^ τ = b ^ (k - 1) := by
      have := pow_rpow_eq 2 (k - 1) τ
      simpa using this
    have h5 := one_add_mul_le_pow (show (-2 : ℝ) ≤ b - 1 by linarith) (k - 1)
    rw [show 1 + (b - 1) = b by ring] at h5
    have h6 : ((k - 1 : ℕ) : ℝ) * (b - 1) ≤ (e : ℝ) ^ τ := by linarith
    have h7 : ((k - 1 : ℕ) : ℝ) ≤ (e : ℝ) ^ τ / (b - 1) := by
      rw [le_div_iff₀ hb1]; exact h6
    have h8 : (k : ℝ) = ((k - 1 : ℕ) : ℝ) + 1 := by
      rw [Nat.cast_sub (by omega)]; simp
    rw [h8, add_mul, one_mul, div_mul_eq_mul_div, one_mul]
    linarith
  · rw [Nat.clog_of_right_le_one he1]
    simp only [Nat.cast_zero]
    positivity

end Cost

