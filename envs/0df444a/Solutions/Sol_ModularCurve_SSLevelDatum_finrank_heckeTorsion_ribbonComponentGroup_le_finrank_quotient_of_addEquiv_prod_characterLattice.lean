def Xp (Q : EngineDatum E V) : Type := ↥(characterLattice V) × ↥(characterLattice V)

def Y (Q : EngineDatum E V) : Type := ↥(ribbonKernel Q.D)

def Ld (Q : EngineDatum E V) : Type := Module.Dual ℤ ↥(characterLattice E)

def Xd (Q : EngineDatum E V) : Type := Module.Dual ℤ (↥(characterLattice V) × ↥(characterLattice V))

