variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ} {m : ℕ}

theorem IntMul.Kappa.R6.IL2.rowCodeU_runs {Kc : ℝ} (H13 : L13U tab l12 τ Kc) {I : List Sym}
    {k K e T S0 B r H : ℕ} {i j : Fin m} (hij : (i : ℕ) ≠ j) (hK : 6 ≤ K)
    (hp : PF m k K e T S0 B r) {u : IState HS} (hA : Agree (rowσ m k K e T S0 B r H i j) u)
    (zs : List GI) (R0 : List Item) (hg0 : u.G 0 = ints (gflat zs) ++ R0)
    (hl : zs.length = B * 2 ^ T * S0 * r) (hGB : GB H zs) :
    ∃ c, IRuns I tab (rowCodeU l12) u
        (u.upd 0 (ints (gflat (permRecs (rect (N0R m k K e T B i j) (N1R m k K e i j) (N2R m k K e i j)
          (N3R m k K e S0 i j) (m ^ k * K)) (rowAddAddr K (e % K) (m ^ k) (pxR i j) (pyR i j)) r zs))
          ++ R0)) c ∧
      (c : ℝ) ≤ bnd τ Kc K (m ^ k) (B * 2 ^ T * S0) r H +
        (cHd (zsz ((VbR T S0 B r H : ℕ) : ℤ)) : ℝ) := by sorry
