universe u
namespace QEC.Coding.BDL26RXLocalReplacement
theorem _root_.solution
    (P : TannerSquarePresentation) (A : TannerSquareAdmissible P)
    (x : P.X) (S : OddScale) (copy : Two)
    (word : Word Field (DoubleCylinderVertex P x S))
    (hword : wordLinearMapTranspose (rxCx P x S).boundary1 word = 0)
    (vertex : SubdivisionVertex P x S) :
    word (copy, vertex) =
      word (copy,
        (subdivisionOriginalBoundaryVertex P x S (A.xBoundaryRoot x)).1) := by
  rcases vertex with oldVertex | edgeInterior | faceInterior
  · exact rxCxCocycle_eq_on_oldVertex P A x S copy word hword oldVertex
  · rcases edgeInterior with ⟨edge, index⟩
    exact rxCxCocycle_eq_on_edgeInterior
      P A x S copy word hword edge index
  · rcases faceInterior with ⟨face, i, j⟩
    let gridI : Fin (S.half + 1) := ⟨i.1 + 1, by
      have := i.2
      have hhalf := S.half_pos
      omega⟩
    let gridJ : Fin (S.half + 1) := ⟨j.1 + 1, by
      have := j.2
      have hhalf := S.half_pos
      omega⟩
    have hgrid : subdivisionGridVertex P x S face gridI gridJ =
        Sum.inr (Sum.inr (face, i, j)) := by
      have hi0 : gridI.1 ≠ 0 := by simp [gridI]
      have him : gridI.1 ≠ S.half := by
        simp [gridI]
        have := i.2
        omega
      have hj0 : gridJ.1 ≠ 0 := by simp [gridJ]
      have hjm : gridJ.1 ≠ S.half := by
        simp [gridJ]
        have := j.2
        omega
      simp only [subdivisionGridVertex, hi0, him, hj0, hjm,
        dite_false, Sum.inr.injEq]
      apply Prod.ext
      · rfl
      · apply Prod.ext
        · apply Fin.ext
          change gridI.1 - 1 = i.1
          simp [gridI]
        · apply Fin.ext
          change gridJ.1 - 1 = j.1
          simp [gridJ]
    rw [← hgrid]
    exact (rxCxCocycle_gridVertex_eq_xCorner
      P x S copy face gridI gridJ word hword).trans
        (rxCxCocycle_faceXCorner_eq_boundaryRoot
          P A x S copy face word hword)
end QEC.Coding.BDL26RXLocalReplacement
