theorem IntMul.Kappa.R6.IL3H.wrapQ_zero {r n : ℕ} (hr : 0 < r) (hn : 0 < n) {e : ℕ} (Z : ℕ)
    (hZ : zsz ((2 * (2 * (n * r)) : ℕ) : ℤ) ≤ Z)
    {σ : Fin HS → Option ℤ} {ρ ρE : Fin HS} (hR : WReg σ ρ ρE (n * r) e)
    (s : IState HS) (hs : Agree σ s) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (xs : List (Fin r → ℂ)) (F x : ℕ) (hC : Clean0 f) (h0 : f 0 = gflat zs ++ l)
    (hxs : xs.length = n) (hx : RecRep r F zs (xs ++ List.replicate n 0)) (hb : GB x zs) :
    ∃ zs', RecRep r (F + e) zs' (xs ++ List.replicate n 0) ∧ GB (x + (e + 2) * 2) zs' ∧
      IRuns I iprog (wrapQ 2 1 ρ ρE (.skip : IStmt HS Pp)) (encK s f)
        (encK s (Function.update f 0 (gflat zs' ++ l))) (cWrapQ 2 (n * r) Z e 0 (fun _ => 1) x) := by sorry
