    change 1 - δ / κ < ‖(p : W)‖
    rw [hξ] at htriangle
    linarith
  have hppos : 0 < ‖p‖ := lt_trans hden hpbig
  have hpzero : p ≠ 0 := norm_pos_iff.mp hppos
  let η : W := ((‖p‖ : ℂ)⁻¹) • (p : W)
