/-- **Task 2, matrices.** A rational identity `A = E₁ Π E₂` whose matrices have all denominators
coprime to `N` maps to the identity of the reductions over `ZMod N`. -/
theorem redQ_matrix_identity {N : ℕ} {A E₁ P E₂ : QMat m}
    (hA : ∀ i j, Nat.Coprime (A i j).den N) (h₁ : ∀ i j, Nat.Coprime (E₁ i j).den N)
    (hP : ∀ i j, Nat.Coprime (P i j).den N) (h₂ : ∀ i j, Nat.Coprime (E₂ i j).den N)
    (h : A = E₁ * P * E₂) :
    A.map (redQ N) = E₁.map (redQ N) * P.map (redQ N) * E₂.map (redQ N) := by
  have hv : ∀ X : QMat m, (∀ i j, Nat.Coprime (X i j).den N) →
      (goodSub N).subtype.mapMatrix (X.map (toGood N)) = X := fun X hX => by
    ext i j; simp [toGood_val (hX i j)]
  have key : A.map (toGood N) = E₁.map (toGood N) * P.map (toGood N) * E₂.map (toGood N) := by
    apply Matrix.map_injective (f := ((↑) : goodSub N → ℚ)) Subtype.val_injective
    change (goodSub N).subtype.mapMatrix _ = (goodSub N).subtype.mapMatrix _
    rw [map_mul, map_mul, hv A hA, hv E₁ h₁, hv P hP, hv E₂ h₂, h]
  have := congrArg (redHom N).mapMatrix key
  rw [map_mul, map_mul] at this
  exact this

end Reduction

