theorem wF_le_NF (d s : ℕ) : wF d ≤ NF d s := by
  unfold NF
  calc wF d ≤ 2 * wF d + 1 := by omega
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) :=
        Nat.le_mul_of_pos_left _ (by positivity)
    _ ≤ _ := Nat.le_mul_of_pos_right _ (by positivity)

theorem NF_le {d s t : ℕ} (hd : 1 ≤ d) (hs : s < t) : NF d s ≤ 3654000 * d ^ 7 * t ^ 2 := by
  have hk : kF d ≤ d + 1 := by unfold kF; have := Nat.sqrt_le_self d; omega
  have hl : lamF d ≤ 2 * d ^ 2 := by
    unfold lamF
    calc d * kF d ≤ d * (d + 1) := Nat.mul_le_mul_left _ hk
