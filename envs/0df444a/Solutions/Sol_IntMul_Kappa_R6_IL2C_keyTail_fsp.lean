/-- **The index updates and pops** of `keyProgC`. -/
theorem keyTail_fsp_sol_aux {l : Lay} {K ρ G n L M Bb : ℕ} (hV : KVal l K ρ G n L M Bb)
    {s : IState HS} {G0 : Fin HS → List ℤ} {k : ℕ} (hk : k < M)
    {lm : List ℤ} (hm : G0 rm = (k : ℤ) :: lm) (hE : KEnv (encK s G0) l K ρ G n)
    {x t4 u2 y5 : ℕ} (hx : x < l.QL) (ht4 : t4 < l.QC) (hu2 : u2 < l.QC) (hy5 : y5 < l.QL) :
    FSp (.seq (.asg ky (scK kQL kSY ky rm)) (.seq (.asg ku (scK kQC kSU ku ky))
      (.seq (.push rK (scK kQC kST kt ku))
      (.seq (.pop ky) (.seq (.pop ku) (.seq (.pop kt) (.seq (.pop kx)
      (.seq (.pop pR) (.pop pN)))))))))
      (encK s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 y5))
      (encK s (Function.update G0 rK
        ((sc l.QC l.sT t4 (sc l.QC l.sU u2 (sc l.QL l.sY y5 k)) : ℕ) :: G0 rK))) (cTail Bb) := by
  have hOK := hV.ok
  have hQL1 := hV.ql1
  have hQC1 := hV.qc1
  have zB : ∀ z : ℕ, z ≤ 3 * M → zsz (z : ℤ) ≤ Bb := fun z hz => hV.zn hz
  -- the layout
  obtain ⟨kM, hkM, eM⟩ := hOK.kMT
  obtain ⟨a, ha, ea⟩ := hOK.kTU
  obtain ⟨b, hb, eb⟩ := hOK.kTY
  obtain ⟨d, hd, ed⟩ := hOK.kTX
  rw [hV.hM] at eM
  have pT := hOK.pT
  have pU := hOK.pU
  have pX := hOK.pX
  have pY := hOK.pY
  have hQT : l.QC * l.sT ≤ M := by rw [eM]; exact Nat.le_mul_of_pos_right _ hkM
  have hT1 : l.sT ≤ l.QC * l.sT := Nat.le_mul_of_pos_left _ hQC1
  have hQU : l.QC * l.sU ≤ l.sT := by rw [ea, mul_comm l.QC]; exact Nat.le_mul_of_pos_right _ ha
  have hQY : l.QL * l.sY ≤ l.sT := by rw [eb, mul_comm l.QL]; exact Nat.le_mul_of_pos_right _ hb
  have hQX : l.QL * l.sX ≤ l.sT := by rw [ed, mul_comm l.QL]; exact Nat.le_mul_of_pos_right _ hd
  have hMY : M = l.QL * l.sY * (l.QC * b * kM) := by rw [eM, eb]; ring
  have hMU : M = l.QC * l.sU * (l.QC * a * kM) := by rw [eM, ea]; ring
  have hMT : M = l.QC * l.sT * kM := eM
  have hQL1 := hV.ql1
  have hQC1 := hV.qc1
  have zB : ∀ z : ℕ, z ≤ 3 * M → zsz (z : ℤ) ≤ Bb := fun z hz => hV.zn hz
  have zM : ∀ z : ℕ, z ≤ M → zsz (z : ℤ) ≤ Bb := fun z hz => zB z (Nat.le_trans hz (Nat.le_mul_of_pos_left M (by norm_num)))
  have hEK : ∀ x' t' u' y' : ℕ, KEnv (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')) l K ρ G n :=
    fun x' t' u' y' => hE.congr (fun r hr => by
      simp only [kEnvRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
      exact encK_G_eq (KS_ne _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)
        (by decide) (by decide)))
  have hQYM : l.QL * l.sY ≤ M := le_trans hQY (le_trans hT1 hQT)
  have hQUM : l.QC * l.sU ≤ M := le_trans hQU (le_trans hT1 hQT)
  have hEf := hEK x t4 u2 y5
  obtain ⟨M1, fQL⟩ := hEf.ql
  obtain ⟨M2, fSY⟩ := hEf.sy
  obtain ⟨M3, fQC⟩ := hEf.qc
  obtain ⟨M4, fSU⟩ := hEf.su
  obtain ⟨M5, fST⟩ := hEf.st
  have fm : ∀ (x' t' u' y' : ℤ), (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')).G rm =
      .int (k : ℤ) :: (ints lm ++ s.G rm) := fun x' t' u' y' => by
    rw [encK_G, KS_ne _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide), hm]; rfl
  have fky : ∀ (x' t' u' y' : ℤ), (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')).G ky =
      .int y' :: (ints (G0 ky) ++ s.G ky) := fun x' t' u' y' => by rw [encK_G, KS_ky]; rfl
  have fku : ∀ (x' t' u' y' : ℤ), (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')).G ku =
      .int u' :: (ints (G0 ku) ++ s.G ku) := fun x' t' u' y' => by rw [encK_G, KS_ku]; rfl
  have fkt : ∀ (x' t' u' y' : ℤ), (encK s (KS G0 n ((2 : ℤ) ^ G) x' t' u' y')).G kt =
      .int t' :: (ints (G0 kt) ++ s.G kt) := fun x' t' u' y' => by rw [encK_G, KS_kt]; rfl
  set k1 := sc l.QL l.sY y5 k with hk1d
  have hk1 : k1 < M := by
    rw [hMY] at hk ⊢; exact sc_lt pY hy5 hk
  have E12 : ESp (scK kQL kSY ky rm) (encK s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 y5)) Bb (k1 : ℤ) :=
    eSc fQL fSY (fky _ _ _ _) (fm _ _ _ _) (by decide) (by decide) (by decide) (by decide)
      pY hQL1 hy5 hk.le hQYM zB
  have S12 := Sp.asgQ s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 y5) (i := ky) (by decide)
    (KS_ky _ _ _ _ _ _ _) (zM _ (le_trans hy5.le hV.qlM)) E12.clean E12.ok E12.bnd
  rw [E12.ev, KS_updy] at S12
  have hEf2 := hEK x t4 u2 k1
  obtain ⟨N3, gQC⟩ := hEf2.qc
  obtain ⟨N4, gSU⟩ := hEf2.su
  set k2 := sc l.QC l.sU u2 k1 with hk2d
  have hk2 : k2 < M := by
    rw [hMU] at hk1 ⊢; exact sc_lt pU hu2 hk1
  have E13 : ESp (scK kQC kSU ku ky) (encK s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 k1)) Bb (k2 : ℤ) :=
    eSc gQC gSU (fku _ _ _ _) (fky _ _ _ _) (by decide) (by decide) (by decide) (by decide)
      pU hQC1 hu2 hk1.le hQUM zB
  have S13 := Sp.asgQ s (KS G0 n ((2 : ℤ) ^ G) x t4 u2 k1) (i := ku) (by decide)
    (KS_ku _ _ _ _ _ _ _) (zM _ (le_trans hu2.le (le_trans hV.qcQL hV.qlM))) E13.clean E13.ok E13.bnd
  rw [E13.ev, KS_updu] at S13
  have hEf3 := hEK x t4 k2 k1
  obtain ⟨P3, hQC'⟩ := hEf3.qc
  obtain ⟨P5, hST'⟩ := hEf3.st
  set k3 := sc l.QC l.sT t4 k2 with hk3d
  have hk3 : k3 < M := by
    rw [hMT] at hk2 ⊢; exact sc_lt pT ht4 hk2
  have E14 : ESp (scK kQC kST kt ku) (encK s (KS G0 n ((2 : ℤ) ^ G) x t4 k2 k1)) Bb (k3 : ℤ) :=
    eSc hQC' hST' (fkt _ _ _ _) (fku _ _ _ _) (by decide) (by decide) (by decide) (by decide)
      pT hQC1 ht4 hk2.le hQT zB
  have S14 := Sp.pushQ s (KS G0 n ((2 : ℤ) ^ G) x t4 k2 k1) (i := rK) (by decide)
    E14.clean E14.ok E14.bnd
  rw [E14.ev, KS_ne _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide)] at S14
  -- the pops
  set H0 := Function.update (KS G0 n ((2 : ℤ) ^ G) x t4 k2 k1) rK ((k3 : ℤ) :: G0 rK) with hH0
  have P1 := Sp.pop s H0 (i := ky) (B := Bb) (by decide)
    (by rw [hH0, upd_ne (by decide), KS_ky]) (zM _ hk1.le)
  set H1 := Function.update H0 ky (G0 ky) with hH1
  have P2 := Sp.pop s H1 (i := ku) (B := Bb) (by decide)
    (by rw [hH1, upd_ne (by decide), hH0, upd_ne (by decide), KS_ku]) (zM _ hk2.le)
  set H2 := Function.update H1 ku (G0 ku) with hH2
  have P3 := Sp.pop s H2 (i := kt) (B := Bb) (by decide)
    (by rw [hH2, upd_ne (by decide), hH1, upd_ne (by decide), hH0, upd_ne (by decide), KS_kt])
    (zM _ (le_trans ht4.le (le_trans hV.qcQL hV.qlM)))
  set H3 := Function.update H2 kt (G0 kt) with hH3
  have P4 := Sp.pop s H3 (i := kx) (B := Bb) (by decide)
    (by rw [hH3, upd_ne (by decide), hH2, upd_ne (by decide), hH1, upd_ne (by decide), hH0,
      upd_ne (by decide), KS_kx])
    (zM _ (le_trans hx.le hV.qlM))
  set H4 := Function.update H3 kx (G0 kx) with hH4
  have P5 := Sp.pop s H4 (i := pR) (B := Bb) (by decide)
    (by rw [hH4, upd_ne (by decide), hH3, upd_ne (by decide), hH2, upd_ne (by decide), hH1,
      upd_ne (by decide), hH0, upd_ne (by decide), KS_pR])
    (by have := zM _ hV.RM; push_cast at this; exact this)
  set H5 := Function.update H4 pR (G0 pR) with hH5
  have P6 := Sp.pop s H5 (i := pN) (B := Bb) (by decide)
    (by rw [hH5, upd_ne (by decide), hH4, upd_ne (by decide), hH3, upd_ne (by decide), hH2,
      upd_ne (by decide), hH1, upd_ne (by decide), hH0, upd_ne (by decide), KS_pN])
    (zM _ hV.nM)
  have hfin : Function.update H5 pN (G0 pN) =
      Function.update G0 rK ((k3 : ℤ) :: G0 rK) := fin_upd G0 _ _ _ _ _ _ _
  rw [hfin] at P6
  refine ((FSp.of_norep rfl S12).seq ((FSp.of_norep rfl S13).seq
    ((FSp.of_norep rfl S14).seq ((FSp.of_norep rfl P1).seq ((FSp.of_norep rfl P2).seq
    ((FSp.of_norep rfl P3).seq ((FSp.of_norep rfl P4).seq ((FSp.of_norep rfl P5).seq
    (FSp.of_norep rfl P6))))))))).mono ?_
  simp only [cTail, scK, Ex.size]
  clear * -
  have h3 : Bb + 2 ≤ (Bb + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  omega

end IntMul.Kappa.R6.IL2C

