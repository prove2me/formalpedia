        rw [hh]
        exact address_pending b B (logicalIndexEquiv b e) 1 (by omega)
  have hedge : t.natReg 560 = CoreMemory.encodedEdge b e :=
    (ht.nat_frame (CorePending.nat_frame 560 (by omega) (by omega))).trans he
