    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | drop hi =>
    have := IOp.Step.drop (I := I) (s := IState.embed f s t) (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf] at this
    exact this
