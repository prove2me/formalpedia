theorem diagOneElem_inv (q : ℕ) [Fact q.Prime] (d : (ZMod q)ˣ) :
    (diagOneElem q d)⁻¹ = diagOneElem q d⁻¹ := by
  rw [inv_eq_iff_mul_eq_one]
  apply Units.ext
  rw [Units.val_mul, coe_diagOneElem, coe_diagOneElem, Units.val_one]
  rw [Matrix.mul_fin_two, Matrix.one_fin_two]
  simp only [mul_one, mul_zero, add_zero, zero_add, one_mul, zero_mul, Units.mul_inv]

theorem redQ_one_mem_hSubgroup (q : ℕ) [Fact q.Prime] (γ : SL(2, ℤ)) :
    (redQ q γ, (1 : (GaloisField q 2)ˣ)) ∈ hSubgroup q := by
  rw [DrinfeldCurve.mem_hSubgroup_iff, Units.ext_iff, DrinfeldCurve.coe_hChar_apply, Units.val_one]
  have hdet : ((redQ q γ : CuspidalType.GL2 q) : Matrix (Fin 2) (Fin 2) (ZMod q)).det = 1 := by
    show ((Matrix.SpecialLinearGroup.map (Int.castRingHom (ZMod q)) γ) : Matrix (Fin 2) (Fin 2) (ZMod q)).det = 1
    exact Matrix.SpecialLinearGroup.det_coe _
  rw [hdet]; simp

theorem eB_tau_eq {k E F : Type*} [Field k] [Field E] [Field F] [Algebra k E] [Algebra k F]
    (O : Type*) [CommRing O] [Algebra O E]
    (K₀ : IntermediateField k E) (F₀ : IntermediateField k F) (φ : K₀ ≃ₐ[k] F₀) (B₀ : Subalgebra O E)
    (hM0a' : ∀ f : E, f ∈ B₀ → f ∈ K₀)
    (B : Subring F) (eB : B₀ ≃+* B) (heB : ∀ b : B₀, ((eB b : B) : F) = ((φ ⟨(b : E), hM0a' _ b.2⟩ : F₀) : F))
    (τ : E ≃ₐ[k] E) (hτ : ∀ f : E, f ∈ K₀ → τ f ∈ K₀)
    (σ : F → F)
    (hστ : ∀ x : K₀, ((φ ⟨τ (x : E), hτ (x : E) x.2⟩ : F₀) : F) = σ ((φ x : F₀) : F))
    (x : B₀) (hx' : τ (x : E) ∈ B₀) (hf' : σ ((eB x : B) : F) ∈ B) :
    (⟨σ ((eB x : B) : F), hf'⟩ : B) = eB ⟨τ (x : E), hx'⟩ := by
  apply Subtype.ext
  show σ ((eB x : B) : F) = ((eB ⟨τ (x : E), hx'⟩ : B) : F)
  rw [heB, heB, ← hστ ⟨(x : E), hM0a' _ x.2⟩]

