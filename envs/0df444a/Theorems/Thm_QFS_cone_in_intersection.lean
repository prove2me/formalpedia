import Definitions.Def_QFS_Translate
import Definitions.Def_QFS_Defs
import Definitions.Def_QFS_Cubes
import Mathlib

set_option autoImplicit true
set_option relaxedAutoImplicit false
set_option maxSynthPendingDepth 3

open Real Set Metric Finset

open QFS

variable {d : ℕ}

/-! ## Definition 2.5: cubes -/

/-! ## Lemma 2.7 -/

theorem QFS.cone_in_intersection (V : Set (EuclideanSpace ℝ (Fin d))) {h : ℝ} (hh : 0 ≤ h)
    (x : EuclideanSpace ℝ (Fin d)) {ξ : EuclideanSpace ℝ (Fin d)} (hξ : ξ ∈ cube h x) :
    shift (shrink V (h * Real.sqrt d)) ξ ⊆ shift (shrink V (h / 2 * Real.sqrt d)) x ∧
      shift (shrink V (h / 2 * Real.sqrt d)) x ⊆ shift V ξ := by sorry
