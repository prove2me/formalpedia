-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:08:54.014895+00:00
-- url     : https://prove2.me/theorems/afc10fa6-b469-483d-92fd-a98dc849dae4
-- title:
--   (68) — $\|z_k-x^*\|\le\sqrt{\mathcal G(0)/(\alpha-1)}+\frac{2s}{\alpha-1}\sum_{j\ge0}(j+\alpha-1)\|g_j\|$
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, let $\Phi:\mathcal H\to\mathbb R\cup\{+\infty\}$ be proper, lower semicontinuous and convex, and let $\Psi:\mathcal H\to\mathbb R$ be convex and continuously differentiable with $L$-Lipschitz continuous gradient; write $\Theta=\Phi+\Psi$. Let $s>0$ with $sL<1$, let $(g_k)_{k\ge 0}$ be a sequence of perturbations in $\mathcal H$, and let $(x_k)_{k\ge0},(y_k)_{k\ge0}$ be generated by the perturbed inertial forward-backward algorithm (55):
--
--   $$y_k = x_k + \frac{k-1}{k+\alpha-1}(x_k-x_{k-1})\ (k\ge 1),\qquad x_{k+1}=\operatorname{prox}_{s\Phi}\big(y_k-s(\nabla\Psi(y_k)-g_k)\big)\ (k\ge 0),$$
--
--   with $y_0\in\mathcal H$ arbitrary.
--
--   Assume $\alpha\ge3$, $\sum_{k}k\|g_k\|<+\infty$, let $x^*$ be a minimizer of $\Theta$, and assume $\Phi(x_0)<+\infty$. Write $z_k=\frac{k+\alpha-1}{\alpha-1}y_k-\frac{k}{\alpha-1}x_k$ (59) and, for a minimizer $x^*$ of $\Theta$, $\mathcal G(k)=\frac{2s}{\alpha-1}(k+\alpha-2)^2\big(\Theta(x_k)-\Theta(x^*)\big)+(\alpha-1)\|z_k-x^*\|^2$. Then for every $k\ge0$,
--
--   $$\|z_k-x^*\|\le M:=\sqrt{\frac{\mathcal G(0)}{\alpha-1}}+\frac{2s}{\alpha-1}\sum_{j=0}^{\infty}(j+\alpha-1)\|g_j\| .$$
--
--   The sequence $(z_k)$ is therefore bounded; this is what makes the perturbation terms in (66) summable, and it feeds the constant of Theorem 5.1.
--
--   **Formalization Note.** $\Phi$ is `EReal`-valued with `IsProperClosedConvex`; $\operatorname{prox}_{s\Phi}$ is a map $P$ with `IsProx s Φ P`; $\Theta$ is the published `NesterovFB.Rates.theta Φ Ψ` (whose argument names are swapped relative to this paper: its first argument is the nonsmooth part). $L$ is a nonnegative real and "$0<s<1/L$" is written $0<s$, $sL<1$, so $L=0$ is allowed. The run is `IsPerturbedRun`. The hypothesis $\Phi(x_0)<+\infty$ is added so that $\mathcal G(0)$ is a real number; when $\Phi(x_0)=+\infty$ the page's $M$ is $+\infty$ and (68) says nothing.
-- source:
--   Attouch, Chbani, Peypouquet, Redont, Fast convergence of inertial dynamics and algorithms with asymptotic vanishing damping, Optimization Online preprint 5179 (Oct. 2015), p. 21, (68)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm
import Definitions.Def_InertialAVD_Algo_PerturbedRun

open Filter Topology NesterovFB.Rates

namespace InertialAVD.Algo

/-- (68), p. 21: under the hypotheses of Theorem 5.1 (and `Φ(x_0) < +∞`, so that `𝒢(0)` is
finite), for every `k ≥ 0`,
`‖z_k − x*‖ ≤ M := √(𝒢(0)/(α−1)) + 2s/(α−1) · ∑_{j=0}^∞ (j+α−1)‖g_j‖`. -/
theorem eq_68 {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Φ : H → EReal) (Ψ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (g : ℕ → H) (x y : ℕ → H)
    (hΦ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Φ)
    (hΨc : ConvexOn ℝ Set.univ Ψ) (hΨd : ContDiff ℝ 1 Ψ)
    (hL : LipschitzWith L (gradient Ψ))
    (hs : 0 < s) (hsL : s * (L : ℝ) < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Φ P)
    (hrun : IsPerturbedRun Ψ P α s g x y)
    (hα : 3 ≤ α)
    (hg : Summable (fun k : ℕ => (k : ℝ) * ‖g k‖))
    (xstar : H) (hxstar : ∀ v : H, theta Φ Ψ xstar ≤ theta Φ Ψ v)
    (hx0 : Φ (x 0) ≠ ⊤) :
    ∀ k : ℕ, ‖zSeq α x y k - xstar‖
      ≤ Real.sqrt ((energyG Φ Ψ α s x y xstar 0).toReal / (α - 1))
        + 2 * s / (α - 1) * pertSum α g := by sorry

end InertialAVD.Algo
