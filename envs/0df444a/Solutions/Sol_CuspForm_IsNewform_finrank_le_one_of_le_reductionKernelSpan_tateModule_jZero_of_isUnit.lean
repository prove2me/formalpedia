private theorem tmul_split (O : Type) [CommRing O] [Algebra ℤ_[lam] O] (b : O)
    (x : ModularCurve.TateModule lam (JZero M)) :
    b ⊗ₜ[ℤ_[lam]] x = b ⊗ₜ[ℤ_[lam]] (πT lam hsmul x) + b ⊗ₜ[ℤ_[lam]] (νT lam hsmul x) := by
  rw [← TensorProduct.tmul_add]
  congr 1
  apply Subtype.ext
  rw [Submodule.coe_add, νT_coe]
  exact (add_sub_cancel ((πT lam hsmul x : ModularCurve.TateModule lam (JZero M)) : ℕ → JZero M)
    (x : ℕ → JZero M)).symm

private theorem pow_baseChange_tmul (O : Type) [CommRing O] [Algebra ℤ_[lam] O] (m : ℕ) (b : O)
    (w : ModularCurve.TateModule lam (JZero M)) :
    ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m) (b ⊗ₜ[ℤ_[lam]] w) =
      b ⊗ₜ[ℤ_[lam]] (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) ^ m) w := by
  rw [← LinearMap.baseChange_pow, LinearMap.baseChange_tmul]

private theorem tmul_lam_smul (O : Type) [CommRing O] [Algebra ℤ_[lam] O] (b : O)
    (y : ModularCurve.TateModule lam (JZero M)) :
    b ⊗ₜ[ℤ_[lam]] ((lam : ℤ_[lam]) • y) = algebraMap ℤ_[lam] O lam • (b ⊗ₜ[ℤ_[lam]] y) := by
  rw [← TensorProduct.smul_tmul, Algebra.smul_def]
  exact (TensorProduct.smul_tmul' (algebraMap ℤ_[lam] O lam) b y).symm

private theorem nil_tmul (O : Type) [CommRing O] [Algebra ℤ_[lam] O] (m : ℕ)
    (hm : ∀ x ∈ LinearMap.ker (πT lam hsmul), ∃ y ∈ LinearMap.ker (πT lam hsmul),
      (heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩) ^ m) x = (lam : ℤ_[lam]) • y)
    (b : O) (x : ModularCurve.TateModule lam (JZero M)) :
    ∃ w : O ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M), (πT lam hsmul).baseChange O w = 0 ∧
      ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m) (b ⊗ₜ[ℤ_[lam]] x) =
        ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m)
            ((πT lam hsmul).baseChange O (b ⊗ₜ[ℤ_[lam]] x)) + algebraMap ℤ_[lam] O lam • w := by
  have hn := hm (νT lam hsmul x) (νT_mem_ker lam hsmul x)
  obtain ⟨y, hy, hxy⟩ := hn
  have t3 : (πT lam hsmul).baseChange O (b ⊗ₜ[ℤ_[lam]] y) = 0 := by
    rw [LinearMap.baseChange_tmul, LinearMap.mem_ker.mp hy, TensorProduct.tmul_zero]
  refine ⟨b ⊗ₜ[ℤ_[lam]] y, t3, ?_⟩
  have t1 : (πT lam hsmul).baseChange O (b ⊗ₜ[ℤ_[lam]] x) = b ⊗ₜ[ℤ_[lam]] πT lam hsmul x := by
    rw [LinearMap.baseChange_tmul]

  simp only [t1]
  simp only [tmul_split lam hsmul O b x, map_add]
  simp only [pow_baseChange_tmul lam hsmul O m]
  simp only [hxy]
  rw [tmul_lam_smul lam O b y]

private theorem nil_baseChange (O : Type) [CommRing O] [Algebra ℤ_[lam] O] :
    ∃ m : ℕ, ∀ z : O ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M), (πT lam hsmul).baseChange O z = 0 →
      ∃ w : O ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M), (πT lam hsmul).baseChange O w = 0 ∧
        ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m) z =
          algebraMap ℤ_[lam] O lam • w := by
  have h := πT_nil (M := M) lam hsmul
  obtain ⟨m, hm⟩ := h
  refine ⟨m, ?_⟩
  have key : ∀ z : O ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M),
      ∃ w : O ⊗[ℤ_[lam]] ModularCurve.TateModule lam (JZero M), (πT lam hsmul).baseChange O w = 0 ∧
        ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m) z =
          ((heckeEndZp hsmul (heckeGen ⟨lam, Fact.out⟩)).baseChange O ^ m)
              ((πT lam hsmul).baseChange O z) + algebraMap ℤ_[lam] O lam • w := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, by simp only [map_zero], by simp only [map_zero, smul_zero, add_zero]⟩
    | tmul b x => exact nil_tmul lam hsmul O m hm b x
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨w₁, hw₁, e₁⟩ := h₁
      obtain ⟨w₂, hw₂, e₂⟩ := h₂
      refine ⟨w₁ + w₂, by simp only [map_add, hw₁, hw₂, add_zero], ?_⟩
      simp only [map_add, e₁, e₂, smul_add]
      abel
  intro z hz
  obtain ⟨w, hw, e⟩ := key z
  exact ⟨w, hw, by simp only [e, hz, map_zero, zero_add]⟩

end FitT
