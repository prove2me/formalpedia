-- title:
--   Locally constant $H^1$ as a colimit over finite levels, and shrinking the curve
-- statement:
--   For a normal subgroup $\Gamma$ of a topological group acting on a discrete module $M$, the file shows that the finite-group $1$-cocycles of a quotient $\Gamma/N$ ($N$ open normal acting trivially on $M$) inflate to locally constant cocycles on $\Gamma$, that inflation is injective on cohomology, and that when $\Gamma$ is compact and the action continuous every class comes from a finite level: $$H^1(\Gamma, M) = \varinjlim_N H^1(\Gamma/N, M).$$ It also treats shrinking an open set $U_1 \subseteq U$: a quotient map of geometric fundamental groups whose kernel is generated by the inertia at the removed points induces a surjection $H^1_c(U_1) \to H^1_c(U)$.
--
--   **Formalization note.** Library module of a formalization of the Ramanujan-Petersson conjecture (etale fundamental groups, Kummer theory and tame ramification on affine curves over finite fields). It contains definitions together with proved lemmas (no `sorry`), so that later solution files can import them.
-- source:
--   J.-P. Serre, Galois Cohomology, Springer (1997), Chapter I, Section 2; J. S. Milne, Etale Cohomology, Princeton University Press (1980), Chapter I, Section 5 and Chapter V, Section 2

import Definitions.Def_RPLib_S4_CurveCohPair

/-!
# S4-CurveCoh, part 2: finite levels (colimit) and shrinking `U` (K0b)

* **Colimit.** For a finite level `Γ ⧸ N` (`N` open normal, acting trivially on `M`; for curves: a finite etale
  cover), Mathlib's finite-group 1-cocycles `cocycles₁` inflate to continuous cocycles (`inflZ1`); inflation is
  injective on cohomology (`inflZ1_eq_zero_iff`), and when `Γ` is compact and `ρ` continuous every class of `H1`
  comes from some finite level (`exists_finite_level`). So `H¹(Γ, M) = colim_N H¹(Γ ⧸ N, M)` (directed union).
* **Shrinking (K0b).** For `U₁ ⊆ U` (removed points `T`): `φ : π₁(U₁) → π₁(U)`, restricting to a quotient map
  `Γ₁ ↠ Γ` of geometric groups whose kernel is generated by the inertia at `T` (`KerGenByInertia`); boundary
  `S ⊕ T` of `U₁`. The descent `H¹_c(U₁) → H¹_c(U)` (`shrinkH1c`) is surjective (`shrinkH1c_surjective`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace RamanujanPetersson
namespace CurveCoh

noncomputable section

open groupCohomology

variable {k : Type} [CommRing k] {G : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  {M : Type} [AddCommGroup M] [Module k M] (ρ : Representation k G M) (Γ : Subgroup G)

/-! ## Finite levels and the colimit -/

section Finite

variable (N : Subgroup Γ) [N.Normal] (hN : N ≤ (ρ.comp Γ.subtype).ker)

/-- The representation of the finite level `Γ ⧸ N` on `M` (`N` acts trivially). -/
def repQ : Representation k (Γ ⧸ N) M := QuotientGroup.lift N (ρ.comp Γ.subtype) hN

theorem repQ_mk (g : Γ) : repQ ρ Γ N hN (g : Γ ⧸ N) = ρ g := rfl

theorem isLocallyConstant_comp_mk (hNo : IsOpen (N : Set Γ)) {X : Type} (f : Γ ⧸ N → X) :
    IsLocallyConstant (fun g : Γ => f (g : Γ ⧸ N)) := by
  rw [IsLocallyConstant.iff_exists_open]
  intro g
  refine ⟨(g * ·) '' (N : Set Γ), isOpenMap_mul_left g _ hNo, ⟨1, N.one_mem, mul_one g⟩, ?_⟩
  rintro _ ⟨n, hn, rfl⟩
  show f ((g * n : Γ) : Γ ⧸ N) = f g
  rw [QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff n).2 hn, mul_one]

/-- Inflation from the finite level `Γ ⧸ N` (`N` open): finite-level 1-cocycles (Mathlib's `cocycles₁`) are
continuous 1-cocycles of `Γ`. -/
def inflZ1 (hNo : IsOpen (N : Set Γ)) : cocycles₁ (Rep.of (repQ ρ Γ N hN)) →ₗ[k] Z1 ρ Γ where
  toFun f := ⟨fun g => f (g : Γ ⧸ N), isLocallyConstant_comp_mk Γ N hNo _, fun g h => by
    have h1 := (mem_cocycles₁_iff (A := Rep.of (repQ ρ Γ N hN)) f).1 f.2 g h
    dsimp only
    rw [QuotientGroup.mk_mul, h1, add_comm]
    rfl⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem inflZ1_apply (hNo : IsOpen (N : Set Γ)) (f : cocycles₁ (Rep.of (repQ ρ Γ N hN))) (g : Γ) :
    (inflZ1 ρ Γ N hN hNo f : Γ → M) g = f (g : Γ ⧸ N) := rfl

theorem inflZ1_mem_B1_iff (hNo : IsOpen (N : Set Γ)) (f : cocycles₁ (Rep.of (repQ ρ Γ N hN))) :
    ((inflZ1 ρ Γ N hN hNo f : Z1 ρ Γ) : Γ → M) ∈ B1 ρ Γ ↔ ⇑f ∈ coboundaries₁ (Rep.of (repQ ρ Γ N hN)) := by
  rw [coboundaries₁, LinearMap.mem_range]
  constructor
  · rintro ⟨-, m, hm⟩
    refine ⟨m, funext fun q => ?_⟩
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    exact (hm g).symm
  · rintro ⟨m, hm⟩
    exact ⟨(inflZ1 ρ Γ N hN hNo f).2, m, fun g => (congrFun hm (g : Γ ⧸ N)).symm⟩

/-- Inflation is injective on cohomology: an inflated class vanishes iff it vanishes at the finite level. -/
theorem inflZ1_eq_zero_iff (hNo : IsOpen (N : Set Γ)) (f : cocycles₁ (Rep.of (repQ ρ Γ N hN))) :
    H1.mk ρ Γ (inflZ1 ρ Γ N hN hNo f) = 0 ↔ H1π (Rep.of (repQ ρ Γ N hN)) f = 0 := by
  rw [H1π_eq_zero_iff, ← inflZ1_mem_B1_iff ρ Γ N hN hNo f, H1.mk, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.coe_subtype]

end Finite

/-- **`H¹` is the colimit over finite levels (covers).** If `Γ` is compact and `ρ` is continuous (open kernel on
`Γ`), every class of `H1` is inflated from a finite level `Γ ⧸ N`, `N` open normal; with `inflZ1_eq_zero_iff`
(inflation is injective) this is `H¹(Γ, M) = colim_N H¹(Γ ⧸ N, M)`. -/
theorem exists_finite_level [CompactSpace Γ] (hρ : IsOpen ((ρ.comp Γ.subtype).ker : Set Γ)) (x : H1 ρ Γ) :
    ∃ (N : Subgroup Γ) (_ : N.Normal) (hNo : IsOpen (N : Set Γ)) (hN : N ≤ (ρ.comp Γ.subtype).ker)
      (f : cocycles₁ (Rep.of (repQ ρ Γ N hN))), H1.mk ρ Γ (inflZ1 ρ Γ N hN hNo f) = x := by
  obtain ⟨c, rfl⟩ := Submodule.mkQ_surjective _ x
  have hW : IsClopen ({g : Γ | (c : Γ → M) g = 0} ∩ ((ρ.comp Γ.subtype).ker : Set Γ)) :=
    (c.2.1.isClopen_fiber 0).inter ⟨Subgroup.isClosed_of_isOpen _ hρ, hρ⟩
  obtain ⟨H, hH⟩ := IsTopologicalGroup.exist_openNormalSubgroup_sub_clopen_nhds_of_one hW
    ⟨Z1_one ρ Γ c.2, (ρ.comp Γ.subtype).ker.one_mem⟩
  have hN : H.toSubgroup ≤ (ρ.comp Γ.subtype).ker := fun n hn => (hH hn).2
  have hout : ∀ g : Γ, (c : Γ → M) (g : Γ ⧸ H.toSubgroup).out = (c : Γ → M) g := fun g => by
    obtain ⟨n, hn⟩ := QuotientGroup.mk_out_eq_mul H.toSubgroup g
    rw [hn, c.2.2 g n, (hH n.2).1, map_zero, add_zero]
  refine ⟨H.toSubgroup, H.isNormal', H.isOpen', hN, ⟨fun q => (c : Γ → M) q.out, ?_⟩, ?_⟩
  · rw [mem_cocycles₁_iff]
    intro q r
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective r
    show (c : Γ → M) ((g : Γ ⧸ H.toSubgroup) * (h : Γ ⧸ H.toSubgroup)).out =
      ρ g ((c : Γ → M) (h : Γ ⧸ H.toSubgroup).out) + (c : Γ → M) (g : Γ ⧸ H.toSubgroup).out
    rw [← QuotientGroup.mk_mul, hout, hout, hout, c.2.2 g h, add_comm]
  · exact congrArg (H1.mk ρ Γ) (Subtype.ext (funext fun g => hout g))

/-! ## Shrinking `U` (K0b) -/

section Shrink

variable [T1Space G] {G₁ : Type} [Group G₁] [TopologicalSpace G₁] [IsTopologicalGroup G₁] (φ : G₁ →* G)
  (Γ₁ : Subgroup G₁) (hΓ : ∀ g : Γ₁, φ g ∈ Γ) {S T : Type} (I : S → Subgroup G) (I₁ : S ⊕ T → Subgroup G₁)

/-- `π₁(U₁)^geo → π₁(U)^geo`. -/
def resΓ : Γ₁ →* Γ := (φ.comp Γ₁.subtype).codRestrict Γ hΓ

theorem resΓ_val (g : Γ₁) : ((resΓ Γ φ Γ₁ hΓ g : Γ) : G) = φ g := rfl

/-- The kernel of `Γ₁ → Γ` is the closed normal subgroup generated by the inertia groups at the removed points `T`
(for curves: "unramified over `U₁` and at `T`" is "unramified over `U`"). -/
def KerGenByInertia : Prop :=
  ∀ K : Subgroup Γ₁, K.Normal → IsClosed (K : Set Γ₁) →
    (∀ (t : T) (g : Γ₁), (g : G₁) ∈ I₁ (Sum.inr t) → g ∈ K) → (resΓ Γ φ Γ₁ hΓ).ker ≤ K

/-- The kernel elements on which a cocycle vanishes. -/
def kerZero {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁) : Subgroup Γ₁ where
  carrier := {g | resΓ Γ φ Γ₁ hΓ g = 1 ∧ c₁ g = 0}
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨by rw [map_mul, ha, hb, one_mul], ?_⟩
    rw [hc.2 a b, ha', hb', map_zero, add_zero]
  one_mem' := ⟨map_one _, Z1_one _ _ hc⟩
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    refine ⟨by rw [map_inv, ha, inv_one], ?_⟩
    rw [Z1_inv _ _ hc, ha', map_zero, neg_zero]

theorem phi_eq_one {g : Γ₁} (h : resΓ Γ φ Γ₁ hΓ g = 1) : φ g = 1 := by
  rw [← resΓ_val Γ φ Γ₁ hΓ, h, OneMemClass.coe_one]

theorem kerZero_normal {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁) : (kerZero ρ Γ φ Γ₁ hΓ hc).Normal := by
  constructor
  rintro g ⟨hg, hg'⟩ η
  have hres : resΓ Γ φ Γ₁ hΓ (η * g * η⁻¹) = 1 := by
    rw [map_mul, map_mul, hg, mul_one, map_inv, mul_inv_cancel]
  refine ⟨hres, ?_⟩
  have h0 : c₁ g = (ρ.comp φ) g 0 - 0 := by rw [hg', map_zero, sub_zero]
  rw [Z1_conj (ρ.comp φ) Γ₁ hc η g 0 h0]
  show ρ (φ (η * g * η⁻¹ : Γ₁)) _ - _ = 0
  rw [phi_eq_one Γ φ Γ₁ hΓ hres, map_one, Module.End.one_apply, sub_self]

theorem kerZero_isClosed {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁)
    (hcont : Continuous (resΓ Γ φ Γ₁ hΓ)) : IsClosed (kerZero ρ Γ φ Γ₁ hΓ hc : Set Γ₁) :=
  (isClosed_singleton.preimage hcont).inter (hc.1.isClosed_fiber 0)

/-- A relative cocycle of `U₁` vanishes on `ker(Γ₁ → Γ)`. -/
theorem vanish_on_ker (hT : ∀ (t : T) (g : Γ₁), (g : G₁) ∈ I₁ (Sum.inr t) → φ g = 1)
    (hK : KerGenByInertia Γ φ Γ₁ hΓ I₁) (hcont : Continuous (resΓ Γ φ Γ₁ hΓ))
    {p : (Γ₁ → M) × (S ⊕ T → M)} (hp : p ∈ Z1c (ρ.comp φ) Γ₁ I₁) (g : Γ₁) (hg : resΓ Γ φ Γ₁ hΓ g = 1) :
    p.1 g = 0 := by
  refine (hK (kerZero ρ Γ φ Γ₁ hΓ hp.1) (kerZero_normal ρ Γ φ Γ₁ hΓ hp.1)
    (kerZero_isClosed ρ Γ φ Γ₁ hΓ hp.1 hcont) (fun t g hg => ⟨?_, ?_⟩) hg).2
  · exact Subtype.ext (hT t g hg)
  · rw [hp.2 (Sum.inr t) g hg]
    show ρ (φ g) _ - _ = 0
    rw [hT t g hg, map_one, Module.End.one_apply, sub_self]

/-- A cocycle vanishing on the kernel is constant on the fibres. -/
theorem fiber_const {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁)
    (h0 : ∀ g : Γ₁, resΓ Γ φ Γ₁ hΓ g = 1 → c₁ g = 0) {g g' : Γ₁}
    (h : resΓ Γ φ Γ₁ hΓ g = resΓ Γ φ Γ₁ hΓ g') : c₁ g' = c₁ g := by
  have hk : resΓ Γ φ Γ₁ hΓ (g⁻¹ * g') = 1 := by rw [map_mul, map_inv, h, inv_mul_cancel]
  have := hc.2 g (g⁻¹ * g')
  rw [mul_inv_cancel_left, h0 _ hk, map_zero, add_zero] at this
  exact this

variable (hq : Topology.IsQuotientMap (resΓ Γ φ Γ₁ hΓ))

/-- The descended cochain `c(γ) = c₁(γ₁)` for any lift `γ₁` of `γ`. -/
def descend (c₁ : Γ₁ → M) : Γ → M := fun g => c₁ (Function.surjInv hq.surjective g)

theorem descend_apply {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁)
    (h0 : ∀ g : Γ₁, resΓ Γ φ Γ₁ hΓ g = 1 → c₁ g = 0) (g : Γ₁) :
    descend Γ φ Γ₁ hΓ hq c₁ (resΓ Γ φ Γ₁ hΓ g) = c₁ g :=
  fiber_const ρ Γ φ Γ₁ hΓ hc h0 (Function.surjInv_eq hq.surjective _).symm

theorem descend_mem_Z1 {c₁ : Γ₁ → M} (hc : c₁ ∈ Z1 (ρ.comp φ) Γ₁)
    (h0 : ∀ g : Γ₁, resΓ Γ φ Γ₁ hΓ g = 1 → c₁ g = 0) : descend Γ φ Γ₁ hΓ hq c₁ ∈ Z1 ρ Γ := by
  have hcomp : descend Γ φ Γ₁ hΓ hq c₁ ∘ resΓ Γ φ Γ₁ hΓ = c₁ :=
    funext (descend_apply ρ Γ φ Γ₁ hΓ hq hc h0)
  refine ⟨fun s => ?_, fun g h => ?_⟩
  · rw [← hq.isOpen_preimage, ← Set.preimage_comp, hcomp]
    exact hc.1 s
  · obtain ⟨g₁, rfl⟩ := hq.surjective g
    obtain ⟨h₁, rfl⟩ := hq.surjective h
    rw [← map_mul, descend_apply ρ Γ φ Γ₁ hΓ hq hc h0, descend_apply ρ Γ φ Γ₁ hΓ hq hc h0,
      descend_apply ρ Γ φ Γ₁ hΓ hq hc h0, hc.2 g₁ h₁]
    rfl

end Shrink

section ShrinkH1c

variable [T1Space G] {G₁ : Type} [Group G₁] [TopologicalSpace G₁] [IsTopologicalGroup G₁] (φ : G₁ →* G)
  (Γ₁ : Subgroup G₁) (hΓ : ∀ g : Γ₁, φ g ∈ Γ) {S T : Type} (I : S → Subgroup G) (I₁ : S ⊕ T → Subgroup G₁)

/-- The data of shrinking `U` to `U₁ = U ∖ T`: `Γ₁ ↠ Γ` is a quotient map, inertia at `s ∈ S` maps onto inertia,
inertia at `t ∈ T` dies in `π₁(U)`, and generates the kernel. -/
structure ShrinkData : Prop where
  quot : Topology.IsQuotientMap (resΓ Γ φ Γ₁ hΓ)
  inl_le : ∀ (s : S) (g : Γ₁), (g : G₁) ∈ I₁ (Sum.inl s) → φ g ∈ I s
  inl_surj : ∀ (s : S) (g : Γ), (g : G) ∈ I s →
    ∃ g₁ : Γ₁, (g₁ : G₁) ∈ I₁ (Sum.inl s) ∧ resΓ Γ φ Γ₁ hΓ g₁ = g
  inr_triv : ∀ (t : T) (g : Γ₁), (g : G₁) ∈ I₁ (Sum.inr t) → φ g = 1
  ker_gen : KerGenByInertia Γ φ Γ₁ hΓ I₁

variable {φ Γ₁ hΓ I I₁} (D : ShrinkData Γ φ Γ₁ hΓ I I₁)

/-- Descent of relative cocycles `Z¹_c(U₁) → Z¹_c(U)`: `(c₁, b) ↦ (c, b|_S)` with `c ∘ (Γ₁ → Γ) = c₁`. -/
def descZ1c : Z1c (ρ.comp φ) Γ₁ I₁ →ₗ[k] Z1c ρ Γ I where
  toFun p := ⟨(descend Γ φ Γ₁ hΓ D.quot p.1.1, fun s => p.1.2 (Sum.inl s)), by
    have h0 := vanish_on_ker ρ Γ φ Γ₁ hΓ I₁ D.inr_triv D.ker_gen D.quot.continuous p.2
    refine ⟨descend_mem_Z1 ρ Γ φ Γ₁ hΓ D.quot p.2.1 h0, fun s g hg => ?_⟩
    obtain ⟨g₁, hg₁, rfl⟩ := D.inl_surj s g hg
    show descend Γ φ Γ₁ hΓ D.quot p.1.1 (resΓ Γ φ Γ₁ hΓ g₁) = _
    rw [descend_apply ρ Γ φ Γ₁ hΓ D.quot p.2.1 h0, p.2.2 (Sum.inl s) g₁ hg₁]
    rfl⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem descZ1c_fst_apply (p : Z1c (ρ.comp φ) Γ₁ I₁) (g₁ : Γ₁) :
    (descZ1c ρ Γ D p : (Γ → M) × (S → M)).1 (resΓ Γ φ Γ₁ hΓ g₁) = (p : (Γ₁ → M) × (S ⊕ T → M)).1 g₁ :=
  descend_apply ρ Γ φ Γ₁ hΓ D.quot p.2.1
    (vanish_on_ker ρ Γ φ Γ₁ hΓ I₁ D.inr_triv D.ker_gen D.quot.continuous p.2) g₁

theorem descZ1c_snd_apply (p : Z1c (ρ.comp φ) Γ₁ I₁) (s : S) :
    (descZ1c ρ Γ D p : (Γ → M) × (S → M)).2 s = (p : (Γ₁ → M) × (S ⊕ T → M)).2 (Sum.inl s) := rfl

theorem descZ1c_mem_B1c (p : Z1c (ρ.comp φ) Γ₁ I₁)
    (hp : (p : (Γ₁ → M) × (S ⊕ T → M)) ∈ B1c (ρ.comp φ) Γ₁ I₁) :
    (descZ1c ρ Γ D p : (Γ → M) × (S → M)) ∈ B1c ρ Γ I := by
  obtain ⟨-, m, hm, hm'⟩ := hp
  refine ⟨(descZ1c ρ Γ D p).2, m, fun g => ?_, fun s => hm' (Sum.inl s)⟩
  obtain ⟨g₁, rfl⟩ := D.quot.surjective g
  rw [descZ1c_fst_apply, hm g₁]
  rfl

/-- **K0b.** The descent `H¹_c(U₁, F) → H¹_c(U, F)` (extension by zero along `U₁ ⊆ U`). -/
noncomputable def shrinkH1c : H1c (ρ.comp φ) Γ₁ I₁ →ₗ[k] H1c ρ Γ I :=
  Submodule.mapQ _ _ (descZ1c ρ Γ D) (fun p hp => descZ1c_mem_B1c ρ Γ D p hp)

theorem shrinkH1c_mk (p : Z1c (ρ.comp φ) Γ₁ I₁) :
    shrinkH1c ρ Γ D (H1c.mk (ρ.comp φ) Γ₁ I₁ p) = H1c.mk ρ Γ I (descZ1c ρ Γ D p) := rfl

include D in
/-- The inflation `(c ∘ (Γ₁ → Γ), b ⊔ 0)` of a relative cocycle of `U` is a relative cocycle of `U₁`. -/
theorem infl_mem_Z1c {p : (Γ → M) × (S → M)} (hp : p ∈ Z1c ρ Γ I) :
    ((fun g₁ => p.1 (resΓ Γ φ Γ₁ hΓ g₁)), Sum.elim p.2 0) ∈ Z1c (ρ.comp φ) Γ₁ I₁ := by
  refine ⟨⟨hp.1.1.comp_continuous D.quot.continuous, fun g h => ?_⟩, ?_⟩
  · show p.1 (resΓ Γ φ Γ₁ hΓ (g * h)) = p.1 (resΓ Γ φ Γ₁ hΓ g) + ρ (φ g) (p.1 (resΓ Γ φ Γ₁ hΓ h))
    rw [map_mul, hp.1.2]
    rfl
  · rintro (s | t) g hg
    · exact hp.2 s _ (D.inl_le s g hg)
    · have h1 : resΓ Γ φ Γ₁ hΓ g = 1 := Subtype.ext (D.inr_triv t g hg)
      show p.1 (resΓ Γ φ Γ₁ hΓ g) = ρ (φ g) 0 - 0
      rw [h1, map_zero, sub_zero]
      exact Z1_one ρ Γ hp.1

/-- **K0b (Katz p. 9).** `H¹_c(U₁, F) → H¹_c(U, F)` is surjective. -/
theorem shrinkH1c_surjective : Function.Surjective (shrinkH1c ρ Γ D) := by
  intro x
  obtain ⟨p, rfl⟩ := Submodule.mkQ_surjective _ x
  refine ⟨H1c.mk (ρ.comp φ) Γ₁ I₁ ⟨_, infl_mem_Z1c ρ Γ D p.2⟩, ?_⟩
  rw [shrinkH1c_mk]
  refine congrArg (H1c.mk ρ Γ I) (Subtype.ext (Prod.ext (funext fun g => ?_) rfl))
  obtain ⟨g₁, rfl⟩ := D.quot.surjective g
  exact descZ1c_fst_apply ρ Γ D _ g₁

end ShrinkH1c

end

