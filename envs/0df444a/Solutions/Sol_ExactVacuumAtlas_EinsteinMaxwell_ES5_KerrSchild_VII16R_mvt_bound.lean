theorem solution {g g' : ℝ → ℝ} {c₁ C δ : ℝ}
    (hd : ∀ x ∈ Ioo (0:ℝ) δ, HasDerivAt g (g' x) x)
    (hb : ∀ x ∈ Ioo (0:ℝ) δ, |g x - c₁ * x| ≤ C * x ^ 2) :
    ∀ x ∈ Ioo (0:ℝ) δ, ∃ ξ ∈ Ioo (0:ℝ) x, |g' ξ| ≤ |c₁| + 3 * |C| * δ := by
  intro x hx
  have hx0 := hx.1
  have hh : x / 2 ∈ Ioo (0:ℝ) δ := ⟨by linarith, by linarith [hx.2]⟩
  have hlt : x / 2 < x := by linarith
  have hcont : ContinuousOn g (Icc (x / 2) x) := fun y hy =>
    (hd y ⟨by linarith [hy.1], lt_of_le_of_lt hy.2 hx.2⟩).continuousAt.continuousWithinAt
  obtain ⟨ξ, hξ, hs⟩ := exists_hasDerivAt_eq_slope g g' hlt hcont
    (fun y hy => hd y ⟨by linarith [hy.1], lt_trans hy.2 hx.2⟩)
  refine ⟨ξ, ⟨by linarith [hξ.1], hξ.2⟩, ?_⟩
  have h1 := hb x hx
  have h2 := hb (x / 2) hh
  have hC1 : C * x ^ 2 ≤ |C| * x ^ 2 := mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity)
  have hC2 : C * (x / 2) ^ 2 ≤ |C| * (x / 2) ^ 2 :=
    mul_le_mul_of_nonneg_right (le_abs_self C) (by positivity)
  have hD : |(g' ξ - c₁) * (x / 2)| ≤ |C| * x ^ 2 + |C| * (x / 2) ^ 2 := by
    have e : (g' ξ - c₁) * (x / 2) = (g x - c₁ * x) - (g (x / 2) - c₁ * (x / 2)) := by
      rw [hs]; field_simp; ring
    rw [e]
    calc |(g x - c₁ * x) - (g (x / 2) - c₁ * (x / 2))|
        ≤ |g x - c₁ * x| + |g (x / 2) - c₁ * (x / 2)| := abs_sub _ _
      _ ≤ _ := by linarith
  rw [abs_mul, abs_of_pos (by linarith : (0:ℝ) < x / 2)] at hD
  have ht : |g' ξ - c₁| ≤ 5 / 2 * |C| * x := by
    have hpos : (0:ℝ) < x / 2 := by linarith
    refine le_of_mul_le_mul_right ?_ hpos
    nlinarith [abs_nonneg C]
  have hxd : 5 / 2 * |C| * x ≤ 3 * |C| * δ := by nlinarith [abs_nonneg C, hx.2]
  have := abs_sub_abs_le_abs_sub (g' ξ) c₁
  linarith
