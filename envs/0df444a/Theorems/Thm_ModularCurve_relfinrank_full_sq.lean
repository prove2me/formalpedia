theorem ModularCurve.relfinrank_full_sq (p : ℕ) [hp : Fact (Nat.Prime p)] : IntermediateField.relfinrank (IntermediateField.adjoin ℚ ({jq} : Set (LaurentSeries ℚ))) (modularFunctionFieldFull (p * p)) = dedekindPsi (p * p) := by sorry
