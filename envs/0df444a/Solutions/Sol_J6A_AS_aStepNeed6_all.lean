set_option linter.unusedSimpArgs false

namespace J6A.BD

open IntMul NLogN NLogN.KIL Function RS J6Seg.PJ J6A.PA

/-! ## Basic units -/

theorem uC_le (A D : ℕ) : J6Seg.Src.uC A D ≤ 10 ^ 7 * (D + 3) ^ 2 * (A + 2) ^ 2 := by
  unfold J6Seg.Src.uC
