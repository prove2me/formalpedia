theorem pmap_comp {W₁ W₂ W₃ : Y.Opens} (h₁₂ : W₂ ≤ W₁) (h₂₃ : W₃ ≤ W₂) (h₁₃ : W₃ ≤ W₁) (c : Γ(Y, W₁)) :
