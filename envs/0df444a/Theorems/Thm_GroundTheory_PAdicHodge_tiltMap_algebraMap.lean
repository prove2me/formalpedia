theorem GroundTheory.PAdicHodge.tiltMap_algebraMap (a : 𝒪K♭) :
    tiltMap p φ hφ (algebraMap 𝒪K♭ K♭ a) = algebraMap 𝒪L♭ L♭ (preTiltMap p φ hφ a) := by sorry
