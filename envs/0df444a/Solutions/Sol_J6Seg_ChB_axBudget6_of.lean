-- Source module: Solutions.J6SegAxBud8
/-!
# B-line axis budget 8: **`axBudget6_of`** (assembly of `AxBudget6`)

* `copy_facts`: the copy / swap descriptor facts at `Bs = axBcp6` (every value `≤ 2T`);
* **`axBudget6_of P hP ap : SideCost6 P ap → JBudget6 P ap → ChunkBudget6 P ap → AxBudget6 P ap`**
  (constants added, exponents maximised).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.ChB
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 J6Seg J6Seg.KR

theorem cU6_nonneg (P : Prm) (n A : ℕ) : 0 ≤ cU6 P n A := by
  have hdl := Side.dl_le_Ncost6 P n
  have h0 : (0 : ℝ) ≤ dP6 P n + ℓP6 P n := by positivity
  have hL := lgn_ge n
  unfold cU6 VP6
  have hN : (0 : ℝ) ≤ Ncost6 P n := by linarith
  have hA : (0 : ℝ) ≤ (Real.log (IntMul.lg n) + 1) ^ A := pow_nonneg (by linarith) _
  exact mul_nonneg (mul_nonneg (by positivity) hN) hA

theorem cU6_mono (P : Prm) (n : ℕ) {A A' : ℕ} (h : A ≤ A') : cU6 P n A ≤ cU6 P n A' := by
  have hdl := Side.dl_le_Ncost6 P n
  have h0 : (0 : ℝ) ≤ dP6 P n + ℓP6 P n := by positivity
  have hN : (0 : ℝ) ≤ Ncost6 P n := by linarith
  have hL := lgn_ge n
  unfold cU6 VP6
  exact mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hL h) (mul_nonneg (by positivity) hN)

theorem lift_cc {x Ci C ui u : ℝ} {D : ℕ} (hx : x ≤ Ci * ui / (D + 1)) (hCi : 0 ≤ Ci) (hC : Ci ≤ C)
    (hu0 : 0 ≤ ui) (hu : ui ≤ u) : x ≤ C * u / (D + 1) := by
  refine hx.trans (div_le_div_of_nonneg_right ?_ (by positivity))
  exact mul_le_mul hC hu hu0 (hCi.trans hC)

/-- **`AxBudget6` from its three halves.** -/
theorem axBudget6_of_sol_aux (P : Prm) (hP : P.Ok) (ap : AxPlan6) (hS : SideCost6 P ap)
    (hJ : JBudget6 P ap) (hC : ChunkBudget6 P ap) : AxBudget6 P ap := by
  obtain ⟨C1, A1, n1, hC1, h1⟩ := hS
  obtain ⟨C2, A2, n2, hC2, h2⟩ := hJ
  obtain ⟨C3, A3, n3, hC3, h3⟩ := hC
  obtain ⟨n4, h4⟩ := Side.axJ_ev P hP
  refine ⟨C1 + C2 + C3, max A1 (max A2 A3), max (max n1 n2) (max n3 n4), by linarith, ?_⟩
  intro n hn src hs D hD k hk
  have hn1 : n1 ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
  have hn2 : n2 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
  have hn3 : n3 ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
  have hn4 : n4 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
  have hSa := h1 n hn1 src hs D hD k hk
  have hJa := h2 n hn2 src hs D hD k hk
  have hCa := h3 n hn3 src hs D hD k hk
  have hAx := h4 n hn4 src hs D hD k hk
  have hcp := copy_facts ap hAx hD hk
  set Am := max A1 (max A2 A3)
  have u1 : cU6 P n A1 ≤ cU6 P n Am := cU6_mono P n (le_max_left _ _)
  have u2 : cU6 P n A2 ≤ cU6 P n Am :=
    cU6_mono P n (le_trans (le_max_left _ _) (le_max_right _ _))
  have u3 : cU6 P n A3 ≤ cU6 P n Am :=
    cU6_mono P n (le_trans (le_max_right _ _) (le_max_right _ _))
  have L1 : ∀ x : ℝ, x ≤ C1 * cU6 P n A1 / (D + 1) → x ≤ (C1 + C2 + C3) * cU6 P n Am / (D + 1) :=
    fun x hx => lift_cc hx hC1 (by linarith) (cU6_nonneg P n A1) u1
  have L2 : ∀ x : ℝ, x ≤ C2 * cU6 P n A2 / (D + 1) → x ≤ (C1 + C2 + C3) * cU6 P n Am / (D + 1) :=
    fun x hx => lift_cc hx hC2 (by linarith) (cU6_nonneg P n A2) u2
  have L3 : ∀ x : ℝ, x ≤ C3 * cU6 P n A3 / (D + 1) → x ≤ (C1 + C2 + C3) * cU6 P n Am / (D + 1) :=
    fun x hx => lift_cc hx hC3 (by linarith) (cU6_nonneg P n A3) u3
  unfold SideCostAt at hSa
  unfold JBudgetAt at hJa
  unfold ChunkBudgetAt at hCa
  dsimp only at hSa hJa hCa hcp
  obtain ⟨s1, s2, s3, s4, s5, s6, s7, s8⟩ := hSa
  obtain ⟨BkJ, Lj, Bx, j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, j15, jc⟩ := hJa
  obtain ⟨BI, BH, Bk, Lc, Ck, hF, cc⟩ := hCa
  unfold ChunkFacts at hF
  dsimp only at hF
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
    c20, c21, c22, c23, c24, c25, c26⟩ := hF
  obtain ⟨p1, p2, p3, p4, p5, p6, p7⟩ := hcp
  unfold AxBudgetAt
  dsimp only
  exact ⟨BI, BH, Bk, Lc, Ck, BkJ, Lj, Bx, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13,
    c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26,
    j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, j11, j12, j13, j14, j15,
    L1 _ s1, L1 _ s2, L3 _ cc, L2 _ jc, L1 _ s3, L1 _ s4, L1 _ s5, L1 _ s6, L1 _ s7, L1 _ s8,
    p1, p2, p3, p4, p5, p6, p7⟩

end J6Seg.ChB
end

