theorem NG.α2d : 4 * IntMul.OpenAI.R154.dP n ≤ αP n ^ 2 := by
  have hb := (IntMul.OpenAI.R154.P.NLogN.KFM.setup_facts h.hn).1
  have h1 : (4 * IntMul.OpenAI.R154.dP n) ^ 2 ≤ (αP n ^ 2) ^ 2 := by
    have : 16 * IntMul.OpenAI.R154.dP n ^ 2 ≤ 12 * IntMul.OpenAI.R154.dP n ^ 2 * bP n := by nlinarith
    calc (4 * IntMul.OpenAI.R154.dP n) ^ 2 = 16 * IntMul.OpenAI.R154.dP n ^ 2 := by ring
      _ ≤ 12 * IntMul.OpenAI.R154.dP n ^ 2 * bP n := this
      _ ≤ αP n ^ 4 := h.α4
      _ = (αP n ^ 2) ^ 2 := by ring
  exact (Nat.pow_le_pow_iff_left (by norm_num)).1 h1

