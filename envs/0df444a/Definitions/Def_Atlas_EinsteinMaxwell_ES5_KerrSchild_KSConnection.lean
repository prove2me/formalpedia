/-- Explicit covariant-derivative expression `(∇_c K)^a = ∂_c K^a + Σ_l Γ^a_{cl} K^l`. -/
noncomputable def covD (Γ : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ) (K : Pt 5 → Fin 5 → ℝ)
    (x : Pt 5) (c a : Fin 5) : ℝ :=
  pd c (fun y => K y a) x + ∑ l, Γ a c l x * K x l

/-- Difference of two connection families, `C = Γ − Γ̄`. -/
def cdiffOf (Γ Γb : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ) : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ :=
  fun a p q y => Γ a p q y - Γb a p q y

/-- Actual Kerr–Schild difference connection `C = Γ(g, gi) − Γ(b, bi)`. -/
noncomputable def ksC (b bi : Metric 5) (v : Pt 5 → ℝ) (k : Pt 5 → Fin 5 → ℝ) :
    Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ :=
  cdiffOf (christoffel (ksMetric b v k) (ksInverse bi v k)) (christoffel b bi)

/-- Lowered background derivative `β_{cd} = Σ_j b_{dj} (∇̄_c k)^j`. -/
noncomputable def covL (b bi : Metric 5) (k : Pt 5 → Fin 5 → ℝ) (x : Pt 5) (c d : Fin 5) : ℝ :=
  ∑ j, b d j x * covD (christoffel b bi) k x c j

/-- Lowered background Christoffel contraction `Σ_e Γ̄^e_{cd} ℓ_e`. -/
noncomputable def chrL (b bi : Metric 5) (k : Pt 5 → Fin 5 → ℝ) (x : Pt 5) (c d : Fin 5) : ℝ :=
  ∑ e, christoffel b bi e c d x * lowerK b k x e

/-- Lowered actual background acceleration `a_d = Σ_j b_dj (accel b bi k)^j`. -/
noncomputable def accL (b bi : Metric 5) (k : Pt 5 → Fin 5 → ℝ) (x : Pt 5) (d : Fin 5) : ℝ :=
  ∑ j, b d j x * accel b bi k x j

/-- Profile derivative along the KS vector, `k(v) = Σ_c k^c ∂_c v`. -/
noncomputable def dprof (v : Pt 5 → ℝ) (k : Pt 5 → Fin 5 → ℝ) (x : Pt 5) : ℝ :=
  ∑ c, k x c * pd c v x

/-- `∇̄_c h_{pq}` for `h = v ℓ ⊗ ℓ`: `∂_c v ℓ_p ℓ_q + v β_{cp} ℓ_q + v ℓ_p β_{cq}`. -/
noncomputable def nablaH (b bi : Metric 5) (v : Pt 5 → ℝ) (k : Pt 5 → Fin 5 → ℝ) (x : Pt 5)
    (c p q : Fin 5) : ℝ :=
  pd c v x * lowerK b k x p * lowerK b k x q + v x * covL b bi k x c p * lowerK b k x q
    + v x * lowerK b k x p * covL b bi k x c q

