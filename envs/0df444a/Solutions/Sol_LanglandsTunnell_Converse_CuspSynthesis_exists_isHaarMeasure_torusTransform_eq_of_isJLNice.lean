private def d117 (F : ℂ → ℂ) : Prop :=
  ∀ A B : ℝ, ∃ C D : ℝ, ∀ s : ℂ, A ≤ s.re → s.re ≤ B → ‖F s‖ ≤ C * Real.exp (D * |s.im|)

private theorem t0998 {F : ℂ → ℂ} (hF : LanglandsTunnell.LDatum.BoundedOnStrips F) :
    d117 F := by
  intro A B
  obtain ⟨C, hC⟩ := hF A B
  exact ⟨C, 0, fun s ha hb => by simpa using hC s ha hb⟩

private theorem d117.mul {F G : ℂ → ℂ} (hF : d117 F) (hG : d117 G) :
    d117 (F * G) := by
  intro A B
  obtain ⟨C₁, D₁, h₁⟩ := hF A B
  obtain ⟨C₂, D₂, h₂⟩ := hG A B
  refine ⟨|C₁| * |C₂|, D₁ + D₂, fun s ha hb => ?_⟩
  have e₁ : ‖F s‖ ≤ |C₁| * Real.exp (D₁ * |s.im|) :=
    (h₁ s ha hb).trans (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.exp_pos _).le)
  have e₂ : ‖G s‖ ≤ |C₂| * Real.exp (D₂ * |s.im|) :=
    (h₂ s ha hb).trans (mul_le_mul_of_nonneg_right (le_abs_self _) (Real.exp_pos _).le)
  calc ‖(F * G) s‖ = ‖F s‖ * ‖G s‖ := by simp
    _ ≤ (|C₁| * Real.exp (D₁ * |s.im|)) * (|C₂| * Real.exp (D₂ * |s.im|)) :=
        mul_le_mul e₁ e₂ (norm_nonneg _) (by positivity)
    _ = |C₁| * |C₂| * Real.exp ((D₁ + D₂) * |s.im|) := by rw [add_mul, Real.exp_add]; ring

private theorem t0999 : d117 (1 : ℂ → ℂ) :=
  t0998 fun _ _ => ⟨1, fun _ _ _ => by simp⟩

private theorem t1000 {ι : Type*} (t : Finset ι) (F : ι → ℂ → ℂ)
    (hF : ∀ i ∈ t, d117 (F i)) : d117 (∏ i ∈ t, F i) :=
  Finset.prod_induction F d117 (fun _ _ => d117.mul) t0999 hF

private theorem t1001 {ι : Type*} (t : Finset ι) (F : ι → ℂ → ℂ)
    (hF : ∀ i ∈ t, d117 (F i)) : d117 fun s => ∏ i ∈ t, F i s := by
  have h := t1000 t F hF
  convert h using 1
  ext s
  simp [Finset.prod_apply]

end VerticalStripBounds
