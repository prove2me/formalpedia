theorem _root_.solution (X : Data E r) {y b b' : Frame X.Ψ r} (hy : y ∈ X.dom)
    (h : rmul y b = rmul y b') : b = b' := by
  funext τ
  have h1 : mat y τ * mat b τ = mat y τ * mat b' τ := congrFun h τ
  have hu : IsUnit (mat y τ).det := isUnit_iff_ne_zero.mpr (hy τ).1
