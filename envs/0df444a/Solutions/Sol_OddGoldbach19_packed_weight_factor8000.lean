theorem ofDigits_range_sum (b n : ℕ) (f : ℕ→ℕ) :
    Nat.ofDigits b ((List.range n).map f)=∑ j∈range n,f j*b^j := by
  induction n with
  | zero => simp [Nat.ofDigits]
  | succ n ih =>
    rw [List.range_succ,List.map_append,Nat.ofDigits_append]
    simp only [List.length_map,List.length_range,List.map_singleton,Nat.ofDigits_singleton]
    rw [ih,sum_range_succ]
    ac_rfl

theorem ofDigits_blocks (b step n : ℕ) (f : ℕ→ℕ) :
    Nat.ofDigits b ((List.range (n*step)).map f)=
      Nat.ofDigits (b^step) ((List.range n).map fun i=>
        Nat.ofDigits b ((List.range step).map fun j=>f (step*i+j))) := by
  induction n with
  | zero => simp [Nat.ofDigits]
  | succ n ih =>
    rw [Nat.succ_mul,List.range_add,List.map_append,Nat.ofDigits_append]
    rw [List.range_succ,List.map_append,Nat.ofDigits_append]
    simp only [List.length_map,List.length_range,List.map_singleton,Nat.ofDigits_singleton,
      List.map_map,Function.comp_apply]
    rw [ih]
    have hp : b^(n*step)=(b^step)^n := by rw [←pow_mul,Nat.mul_comm n step]
    rw [hp]
    simp only [Nat.mul_comm n step,Function.comp_def]

theorem weight_reverse_sum (D b : ℕ) (w : ℕ→ℕ) :
    (∑ d∈Icc 1 D,w d*b^(D-d))=∑ j∈range D,w (D-j)*b^j := by
  apply sum_bij (fun d _=>D-d)
  · intro d hd
    have hh := mem_Icc.mp hd
    simp only [mem_range]
    omega
  · intro a ha c hc he
    have hha := mem_Icc.mp ha
    have hhc := mem_Icc.mp hc
    omega
  · intro j hj
    have hh := mem_range.mp hj
    refine ⟨D-j,?_,?_⟩
    · simp only [mem_Icc];omega
    · omega
  · intro d hd
    have hh := mem_Icc.mp hd
    rw [show D-(D-d)=d by omega]

def digit (D : ℕ) (w : ℕ→ℕ) (j : ℕ) : ℕ :=if j<D then w (D-j) else 0

theorem weight_as_digits (D N b : ℕ) (w : ℕ→ℕ) (hDN : D≤N) :
    (∑ d∈Icc 1 D,w d*b^(D-d))=Nat.ofDigits b ((List.range N).map (digit D w)) := by
  rw [weight_reverse_sum,ofDigits_range_sum]
  calc
    ∑ j∈range D,w (D-j)*b^j=∑ j∈range D,digit D w j*b^j := by
      apply sum_congr rfl
      intro j hj
      rw [digit,if_pos (mem_range.mp hj)]
    _ =∑ j∈range N,digit D w j*b^j := by
      apply sum_subset (range_mono hDN)
      intro j hj hnot
      have hh : ¬j<D := by simpa only [mem_range] using hnot
      simp [digit,hh]
end DenseChunks
