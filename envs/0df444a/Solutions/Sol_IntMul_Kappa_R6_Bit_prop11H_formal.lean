/-- **Generalized Prop. 11 from formal frames.** As `prop11H_labels`, with `LabOK` and
`ScalarOK` replaced by `FormalOK` (no label condition on gates). -/
theorem prop11H_formal_sol_aux {R : Type*} [CommRing R] {W T m : ℕ} [NeZero W] (C : QHNet R W T m)
    {q : ℕ} (hq : 1 ≤ q) (hm : 2 ≤ m) (hruns : C.RunsOK) (hE : ∀ f, C.EdgesOK (q ^ f))
    (hF : ∀ f, C.FormalOK (q ^ f)) {τ : ℝ} (hτ0 : 0 < τ) (hτ1 : τ ≤ 1)
    (hmom : histMoment C.hist m τ < W) :
    (∀ (e P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ depH m e ∣ L →
      xs.length = vol (P :: L :: hdShape A B Cs e q) →
      progH C q e P L A B Cs xs =
        pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
          (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs) ∧
    ∃ K : ℝ, ∀ (e : ℕ) (V : ℝ), 0 ≤ V → costH C e V ≤ K * V * (e : ℝ) ^ τ :=
  prop11H C hq hm (fun f => have : NeZero (q ^ f) := ⟨by positivity⟩
    ⟨hruns, C.idealOK_of_formal (hE f) (hF f)⟩) hτ0 hτ1 hmom

