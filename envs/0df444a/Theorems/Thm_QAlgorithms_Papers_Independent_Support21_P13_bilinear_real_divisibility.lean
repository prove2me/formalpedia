-- title:
--   Divisibility of the real bilinear expression
-- statement:
--   Let $x,y\in\mathbb Z[\omega]$ be primitive at base $\sqrt2$. If $\sqrt2$ divides each of $|x|^2$ and $|y|^2$ inside this ring, then
--
--   $$
--   \sqrt2\mid\operatorname{Re}(\sqrt2\,x\overline y)\quad\text{in }\mathbb Z[\omega].
--   $$
--
--   The real part is embedded as a real complex number and has a quotient in the cyclotomic integer ring. The internal $\sqrt2$ is retained, giving the bilinear divisibility interface used for norm sums.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 21, Proposition 5: divisibility of a real bilinear expression

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Proposition 5, PDF p.21: the internal sqrt(2) is essential. The quotient
witness lies in Z[omega], and its equality also supplies ring membership of the
real bilinear expression. No divisibility in C is substituted. -/
theorem bilinear_real_divisibility (x y : integralRing)
    (hx : gde (x : ℂ) = 0) (hy : gde (y : ℂ) = 0)
    (hnx : DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) (normSquared (x : ℂ)))
    (hny : DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) (normSquared (y : ℂ))) :
    DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ)
      (((((Real.sqrt 2 : ℝ) : ℂ) * (x : ℂ) * star (y : ℂ)).re : ℝ) : ℂ) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
