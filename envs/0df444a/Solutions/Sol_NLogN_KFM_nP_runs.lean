    have := sum_cNB_le J
    have hc : cNB J + 30 = 10 ^ 4 * (2 ^ J + 2) + 30 := rfl
    have e1 : 2 ^ (J + 1) = 2 * 2 ^ J := by ring
    rw [hc, e1]
    omega

theorem nLoop_runs (s : IState HS) (LA LR LP LS : List Item) (n : ℕ) :
    IRuns I iprog nLoop (nS1 s LA LR LP LS n 0) (nS1 s LA LR LP LS n (Nat.size (n + 1)))
      (10 ^ 4 * (2 ^ Nat.size (n + 1) + 3 * Nat.size (n + 1)) + 30) := by
  have h := IRuns.loop (I := I) (iprog := iprog) (i := gA) (f := isPosC) (p := nB)
    (fun k => nS1 s LA LR LP LS n k) cNB (Nat.size (n + 1))
    (by
      intro k hk
      have h2 : 2 ^ k ≤ n + 1 := Nat.lt_size.1 hk
      have hp : (2 : ℤ) ^ (n + 1 - 2 ^ k) ≠ 0 := by positivity
      have hp' : ¬ (2 : ℤ) ^ (n + 1 - 2 ^ k) < 0 := by rw [not_lt]; positivity
      simp +decide [nS1, IState.cl_def, cls, isPosC, aK, if_pos h2, hp, hp'])
    (by
      have h2 : ¬ 2 ^ Nat.size (n + 1) ≤ n + 1 := not_le.2 (Nat.lt_size_self _)
      simp +decide [nS1, IState.cl_def, cls, isPosC, aK, if_neg h2])
    (fun k hk => nB_runs s LA LR LP LS n k (Nat.lt_size.1 hk))
  refine h.mono ?_
  have := sum_cNB_le (Nat.size (n + 1))
  omega

set_option maxHeartbeats 2000000 in
theorem nB2_runs (s : IState HS) (LA LS LJ : List Item) (n k J : ℕ) (hJ : n < 2 ^ J) :
    IRuns I iprog nB2 (nT s LA LS LJ n (k + 1)) (nT s LA LS LJ n k) (cNB2 k J) := by
  set t0 := nT s LA LS LJ n (k + 1) with ht0
  obtain ⟨LR, hLR⟩ : ∃ L, s.G gR = L := ⟨_, rfl⟩
  obtain ⟨LT, hLT⟩ : ∃ L, s.G gT = L := ⟨_, rfl⟩
  set R : ℤ := (2 : ℤ) ^ (2 ^ k) with hR
  set a := n / 2 ^ (k + 1) with ha
  set e := n % 2 ^ (k + 1) with he
  set bit := n / 2 ^ k % 2 with hbit
  have hS : t0.G gS = .int R :: (ints (rl (k + 1)) ++ LS) := by
    simp +decide [ht0, nT, rl_succ (k + 1), prvK_succ, ints_cons, hR]
  have m1 := IRuns.mv (I := I) (iprog := iprog) (s := t0) (i := gS) (j := gR) (a := R)
    (L := ints (rl (k + 1)) ++ LS) (by decide) hS
  rw [show t0.G gR = LR by simp +decide [ht0, nT, hLR]] at m1
  set t1 := (t0.upd gS (ints (rl (k + 1)) ++ LS)).upd gR (.int R :: LR) with ht1
  have m2 := IRuns.const (I := I) (iprog := iprog) (s := t1) gT 2
  rw [show t1.G gT = LT by simp +decide [ht1, ht0, nT, hLT]] at m2
  set t2 := t1.upd gT (.int 2 :: LT) with ht2
  have m3 := IRuns.shl (I := I) (iprog := iprog) (s := t2) (i := gJ) (j := gT) (a := (a : ℤ)) (m := 1)
    (Li := LJ) (Lj := LT) (by decide) (by simp +decide [ht2, ht1, ht0, nT, ha]) (by simp +decide [ht2])
  set t3 := t2.upd gJ (.int ((a : ℤ) * 2 ^ 1) :: LJ) with ht3
  have m4 := IRuns.drop (I := I) (iprog := iprog) (s := t3) (i := gT) (a := 2) (L := LT)
    (by simp +decide [ht3, ht2])
  set t4 := t3.upd gT LT with ht4
  have m5 := IRuns.split (I := I) (iprog := iprog) (s := t4) (i := gA) (j := gR) (k := gT)
    (a := (2 : ℤ) ^ e) (m := 2 ^ k) (Li := LA) (Lj := LR)
    (by decide) (by decide) (by decide)
    (by simp +decide [ht4, ht3, ht2, ht1, ht0, nT, he]) (by simp +decide [ht4, ht3, ht2, ht1, hR])
  have e2 : ((2 : ℤ) ^ e) = ((2 ^ e : ℕ) : ℤ) := by push_cast; rfl
  rw [e2, Int.natAbs_natCast, sg_nat', sg_nat', show t4.G gT = LT by simp +decide [ht4]] at m5
  have hsplit := nmod_succ n k
  have hdiv := ndiv_succ n k
  have hlt : n % 2 ^ k < 2 ^ k := Nat.mod_lt _ (by positivity)
  have hb2 : bit < 2 := Nat.mod_lt _ (by norm_num)
  have m7c : ∀ (t : IState HS), t.G gR = .int R :: LR →
      IRuns I iprog (.op (.drop gR)) t (t.upd gR LR) (2 * zsz R + 2) := fun t h =>
    IRuns.drop (I := I) (iprog := iprog) h
  have hzR : zsz R = 2 ^ k + 1 := NLogN.zsz_two_pow _
  have hJa : zsz ((a : ℤ) * 2 ^ 1) ≤ J + 1 := by
    apply zsz_le_iff.2
    have : a ≤ n := Nat.div_le_self _ _
    have h2 : (2 : ℕ) ^ (J + 1) = 2 * 2 ^ J := by ring
    rw [show ((a : ℤ) * 2 ^ 1) = ((2 * a : ℕ) : ℤ) by push_cast; ring, Int.natAbs_natCast]
    omega
  have mc := moveIntCost_le (2 ^ k + 1)
  have sp := splitCost_le (2 ^ k)
  have sh1 := shlCost_le 1
  have ad := addIntCost_le (J + 1 + 1)
  have ad' := addIntCost_mono (show zsz ((a : ℤ) * 2 ^ 1) + zsz (1 : ℤ) ≤ J + 1 + 1 by
    rw [zsz_one]; omega)
  set t5 := (t4.upd gA (.int ((2 ^ e / 2 ^ 2 ^ k : ℕ) : ℤ) :: LA)).upd gT
    (.int ((2 ^ e % 2 ^ 2 ^ k : ℕ) : ℤ) :: LT) with ht5
  rcases Nat.lt_or_ge bit 1 with h0 | h1
  · -- bit 0: quotient 0, remainder 2^e
    have hb : bit = 0 := by omega
    have heq : e = n % 2 ^ k := by rw [he, hsplit, ← hbit, hb]; ring
    have hq : 2 ^ e / 2 ^ 2 ^ k = 0 := Nat.div_eq_of_lt (Nat.pow_lt_pow_right (by norm_num) (by omega))
    have hr : 2 ^ e % 2 ^ 2 ^ k = 2 ^ e := Nat.mod_eq_of_lt (Nat.pow_lt_pow_right (by norm_num) (by omega))
    rw [hq, hr] at ht5
    have b1 := IRuns.drop (I := I) (iprog := iprog) (s := t5) (i := gA) (a := 0) (L := LA)
      (by simp +decide [ht5])
    have b2 := IRuns.mv (I := I) (iprog := iprog) (s := t5.upd gA LA) (i := gT) (j := gA)
      (a := ((2 ^ e : ℕ) : ℤ)) (L := LT) (by decide) (by simp +decide [ht5])
    rw [show (t5.upd gA LA).G gA = LA by simp] at b2
    have it := IRuns.iteF (I := I) (iprog := iprog) (i := gA) (f := isPosC)
      (p := (.seq (.op (.drop gT)) (.seq (.op (.const gT 1)) (.op (.add gJ gT gJ))) : IStmt HS P))
      (s := t5) (by simp +decide [ht5, IState.cl_def, cls, isPosC]) (b1.seq b2)
    refine (m1.seq (m2.seq (m3.seq (m4.seq (m5.seq (it.seq (m7c _ ?_))))))).mono' ?_ ?_
    · simp +decide [ht5, ht4, ht3, ht2, ht1]
    · have hjv : ((a : ℤ) * 2 ^ 1) = ((n / 2 ^ k : ℕ) : ℤ) := by
        have hd' : n / 2 ^ k = 2 * a + bit := hdiv
        rw [hd', hb]; push_cast; ring
      have hev : ((2 ^ e : ℕ) : ℤ) = (2 : ℤ) ^ (n % 2 ^ k) := by rw [heq]; push_cast; rfl
      simp only [ht5, ht4, ht3, ht2, ht1, ht0, nT, hjv, hev]
      rw [← hLR, ← hLT]
      clear * -
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all +decide
    · have z5 : zsz ((2 ^ e : ℕ) : ℤ) ≤ 2 ^ k + 1 := by
        apply zsz_le_iff.2; rw [Int.natAbs_natCast]
        exact Nat.pow_lt_pow_right (by norm_num) (by omega)
      have mv5 := moveIntCost_le (zsz ((2 ^ e : ℕ) : ℤ))
      unfold cNB2
      rw [hzR] at *
      simp only [zsz_zero, show zsz (2 : ℤ) = 2 by simpa using NLogN.zsz_two_pow 1] at *
      nlinarith
  · -- bit 1: quotient 2^{n mod 2^k}, remainder 0
    have hb : bit = 1 := by omega
    have heq : e = n % 2 ^ k + 2 ^ k := by rw [he, hsplit, ← hbit, hb]; ring
    have hq : 2 ^ e / 2 ^ 2 ^ k = 2 ^ (n % 2 ^ k) := by
      rw [heq, pow_add, Nat.mul_div_cancel _ (by positivity)]
    have hr : 2 ^ e % 2 ^ 2 ^ k = 0 := by rw [heq, pow_add]; exact Nat.mul_mod_left _ _
    rw [hq, hr] at ht5
    have b1 := IRuns.drop (I := I) (iprog := iprog) (s := t5) (i := gT) (a := ((0 : ℕ) : ℤ)) (L := LT)
      (by simp +decide [ht5])
    have b2 := IRuns.const (I := I) (iprog := iprog) (s := t5.upd gT LT) gT 1
    rw [show (t5.upd gT LT).G gT = LT by simp] at b2
    have b3 := IRuns.add (I := I) (iprog := iprog) (s := (t5.upd gT LT).upd gT (.int 1 :: LT)) (i := gJ) (j := gT)
      (k := gJ) (a := (a : ℤ) * 2 ^ 1) (b := 1) (Li := LJ) (Lj := LT) (by decide)
      (by simp +decide [ht5, ht4, ht3]) (by simp)
    have hpos : ((2 ^ (n % 2 ^ k) : ℕ) : ℤ) ≠ 0 := by positivity
    have hpos' : ¬ ((2 ^ (n % 2 ^ k) : ℕ) : ℤ) < 0 := by rw [not_lt]; positivity
    have it := IRuns.iteT (I := I) (iprog := iprog) (i := gA) (f := isPosC)
      (q := (.seq (.op (.drop gA)) (.op (.mv gT gA)) : IStmt HS P))
      (s := t5) (by simp +decide [ht5, IState.cl_def, cls, isPosC, hpos, hpos']) (b1.seq (b2.seq b3))
    refine (m1.seq (m2.seq (m3.seq (m4.seq (m5.seq (it.seq (m7c _ ?_))))))).mono' ?_ ?_
    · simp +decide [ht5, ht4, ht3, ht2, ht1]
    · have hjv : ((a : ℤ) * 2 ^ 1 + 1) = ((n / 2 ^ k : ℕ) : ℤ) := by
        have hd' : n / 2 ^ k = 2 * a + bit := hdiv
        rw [hd', hb]; push_cast; ring
      have hev : ((2 ^ (n % 2 ^ k) : ℕ) : ℤ) = (2 : ℤ) ^ (n % 2 ^ k) := by push_cast; rfl
      simp only [ht5, ht4, ht3, ht2, ht1, ht0, nT, hjv, hev]
      rw [← hLR, ← hLT]
      clear * -
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all +decide
    · unfold cNB2
      rw [hzR] at *
      simp only [zsz_zero, Nat.cast_zero, zsz_one, show zsz (2 : ℤ) = 2 by simpa using NLogN.zsz_two_pow 1] at *
      nlinarith

theorem sum_cNB2_le (J : ℕ) : ∀ m : ℕ,
    ∑ k ∈ Finset.range m, (cNB2 k J + 30) ≤ 10 ^ 4 * (2 ^ m + m * J + 3 * m)
  | 0 => by simp
  | m + 1 => by
    rw [Finset.sum_range_succ]
    have := sum_cNB2_le J m
    have hc : cNB2 m J + 30 = 10 ^ 4 * (2 ^ m + J + 2) + 30 := rfl
    have e1 : 2 ^ (m + 1) = 2 * 2 ^ m := by ring
    have e2 : (m + 1) * J = m * J + J := by ring
    rw [hc, e1, e2]
    omega

theorem nT_top (s : IState HS) (LA LS LJ : List Item) (n k : ℕ) :
    (nT s LA LS LJ n k).G gS = .int (prvK k : ℤ) :: (ints (rl k) ++ LS) := by
  simp +decide [nT, rl_succ, ints_cons]

theorem nLoop2_runs (s : IState HS) (LA LS LJ : List Item) (n J : ℕ) (hJ : n < 2 ^ J) :
    IRuns I iprog nLoop2 (nT s LA LS LJ n J) (nT s LA LS LJ n 0)
      (10 ^ 4 * (2 ^ J + J * J + 3 * J) + 30) := by
  have h := IRuns.loop (I := I) (iprog := iprog) (i := gS) (f := isPosC) (p := nB2)
    (fun i => nT s LA LS LJ n (J - i)) (fun i => cNB2 (J - i - 1) J) J
    (by
      intro i hi
      obtain ⟨k, hk⟩ : ∃ k, J - i = k + 1 := ⟨J - i - 1, by omega⟩
      have hp : (2 : ℤ) ^ (2 ^ k) ≠ 0 := by positivity
      have hp' : ¬ (2 : ℤ) ^ (2 ^ k) < 0 := by rw [not_lt]; positivity
      beta_reduce
      rw [hk, IState.cl_def, nT_top, prvK_succ]
      simp [cls, isPosC, hp, hp'])
    (by
      beta_reduce
      rw [Nat.sub_self, IState.cl_def, nT_top]
      simp [cls, isPosC, prvK])
    (by
      intro i hi
      have e1 : J - i = (J - i - 1) + 1 := by omega
      have e2 : J - (i + 1) = J - i - 1 := by omega
      rw [e2, e1]
      have := nB2_runs (I := I) (iprog := iprog) s LA LS LJ n (J - i - 1) J hJ
      rwa [show J - i - 1 + 1 - 1 = J - i - 1 by omega])
  simp only [Nat.sub_zero, Nat.sub_self] at h
  refine h.mono ?_
  have hr := Finset.sum_range_reflect (fun k => cNB2 k J + 30) J
  have := sum_cNB2_le J J
  have e : ∑ i ∈ Finset.range J, (cNB2 (J - i - 1) J + 30) = ∑ k ∈ Finset.range J, (cNB2 k J + 30) := by
    rw [← hr]; refine Finset.sum_congr rfl (fun i hi => ?_); congr 2; omega
  omega

theorem nInit_runs (s : IState HS) (n : ℕ) (LN : List Item) (hN : s.G gN = .int ((2 : ℤ) ^ n) :: LN) :
    IRuns I iprog nInit s (nS1 s (s.G gA) (s.G gR) (s.G gP) (s.G gS) n 0) (dupCost (n + 1) + 17 + 6) := by
  have i1 := IRuns.dup (I := I) (iprog := iprog) (s := s) (i := gN) (j := gA) (a := (2 : ℤ) ^ n)
    (L := LN) (by decide) hN
  have i2 := IRuns.const (I := I) (iprog := iprog) (s := s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)) gR 2
  have i3 := IRuns.const (I := I) (iprog := iprog)
    (s := (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).upd gR
      (.int 2 :: (s.upd gA (.int ((2 : ℤ) ^ n) :: s.G gA)).G gR)) gP 0
  refine (i1.seq (i2.seq i3)).mono' ?_ ?_
  · simp only [nS1, aK_zero, pow_zero, pow_one, rl, List.range_zero, List.reverse_nil, List.map_nil,
      ints, List.nil_append]
    have : ((prvK 0 : ℕ) : ℤ) = 0 := by simp [prvK]
    rw [this]
    have : ((2 ^ n : ℕ) : ℤ) = (2 : ℤ) ^ n := by push_cast; rfl
    rw [this]
    clear i1 i2 i3; ((apply NLogN.IState.ext' <;> intros <;>
                             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                           split_ifs <;>
                         simp_all +decide))
  · rw [NLogN.zsz_two_pow]; simp only [zsz_zero]
    have : zsz (2 : ℤ) = 2 := by simpa using NLogN.zsz_two_pow 1
    omega

set_option maxHeartbeats 1000000 in
theorem nMid_runs (s : IState HS) (n : ℕ) (LA LS : List Item) (LN : List Item)
    (hN : s.G gN = .int ((2 : ℤ) ^ n) :: LN) :
    IRuns I iprog nMid (nS1 s LA (s.G gR) (s.G gP) LS n (Nat.size (n + 1)))
      (nT s LA LS (s.G gJ) n (Nat.size (n + 1))) (300 * (n + 2) + 400 * (2 ^ Nat.size (n + 1) + 2)) := by
  set J := Nat.size (n + 1) with hJ
  have hJ1 : 1 ≤ J := Nat.lt_size.2 (by norm_num)
  have hnJ : n < 2 ^ J := by have : n + 1 < 2 ^ J := Nat.lt_size_self _; omega
  have haJ : aK n J = 0 := by
    have : ¬ 2 ^ J ≤ n + 1 := not_le.2 (Nat.lt_size_self _)
    simp [aK, this]
  set u0 := nS1 s LA (s.G gR) (s.G gP) LS n J with hu0
  have a1 := IRuns.drop (I := I) (iprog := iprog) (s := u0) (i := gA) (a := 0) (L := LA)
    (by simp +decide [hu0, nS1, haJ])
  have a2 := IRuns.drop (I := I) (iprog := iprog) (s := u0.upd gA LA) (i := gR)
    (a := (2 : ℤ) ^ (2 ^ J)) (L := s.G gR) (by simp +decide [hu0, nS1])
  have a3 := IRuns.mv (I := I) (iprog := iprog) (s := (u0.upd gA LA).upd gR (s.G gR)) (i := gP) (j := gS)
    (a := (prvK J : ℤ)) (L := s.G gP) (by decide) (by simp +decide [hu0, nS1])
  rw [show ((u0.upd gA LA).upd gR (s.G gR)).G gS = ints (rl J) ++ LS by simp +decide [hu0, nS1]] at a3
  set u3 := (((u0.upd gA LA).upd gR (s.G gR)).upd gP (s.G gP)).upd gS
    (.int (prvK J : ℤ) :: (ints (rl J) ++ LS)) with hu3
  have a4 := IRuns.dup (I := I) (iprog := iprog) (s := u3) (i := gN) (j := gA) (a := (2 : ℤ) ^ n)
    (L := LN) (by decide) (by simp +decide [hu3, hu0, nS1, hN])
  rw [show u3.G gA = LA by simp +decide [hu3]] at a4
  have a5 := IRuns.const (I := I) (iprog := iprog) (s := u3.upd gA (.int ((2 : ℤ) ^ n) :: LA)) gJ 0
  refine (a1.seq (a2.seq (a3.seq (a4.seq a5)))).mono' ?_ ?_
  · have h1 : n % 2 ^ J = n := Nat.mod_eq_of_lt hnJ
    have h2 : n / 2 ^ J = 0 := Nat.div_eq_of_lt hnJ
    simp only [hu3, hu0, nS1, nT, h1, h2, rl_succ, ints_cons, List.cons_append, Nat.cast_zero]
    clear * -
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all +decide
  · clear a1 a2 a3 a4 a5
    have z1 := zsz_prvK J
    have z2 : zsz ((2 : ℤ) ^ (2 ^ J)) = 2 ^ J + 1 := NLogN.zsz_two_pow _
    have z3 : zsz ((2 : ℤ) ^ n) = n + 1 := NLogN.zsz_two_pow _
    have m1 := moveIntCost_le (zsz (prvK J : ℤ))
    have d1 := NLogN.dupCost_le (n + 1)
    rw [z2, z3, zsz_zero]
    omega

theorem nPost_runs (s : IState HS) (n : ℕ) :
    IRuns I iprog nPost (nT s (s.G gA) (s.G gS) (s.G gJ) n 0) (s.upd gJ (.int (n : ℤ) :: s.G gJ)) 10 := by
  have b1 := IRuns.drop (I := I) (iprog := iprog) (s := nT s (s.G gA) (s.G gS) (s.G gJ) n 0) (i := gS)
    (a := 0) (L := s.G gS) (by rw [nT_top]; simp [prvK, rl])
  have b2 := IRuns.drop (I := I) (iprog := iprog) (s := (nT s (s.G gA) (s.G gS) (s.G gJ) n 0).upd gS (s.G gS))
    (i := gA) (a := 1) (L := s.G gA) (by simp +decide [nT, Nat.mod_one])
  refine (b1.seq b2).mono' ?_ ?_
  · simp only [nT, pow_zero, Nat.div_one, Nat.mod_one]
    clear * -
    apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
      split_ifs <;> simp_all +decide
  · simp [zsz_zero, zsz_one]

