section
namespace WeldedPath.SingleCycleGraph

open Classical

section Insertion

variable {V I : Type*} [DecidableEq I]

def matchingGraph (K : SimpleGraph V) (a b : I → V) : SimpleGraph V :=
  K ⊔ SimpleGraph.fromRel (fun x y => ∃ i, x = a i ∧ y = b i)

theorem matching_edge_reachable (K : SimpleGraph V) (a b : I → V) (i : I) :
    (matchingGraph K a b).Reachable (a i) (b i) :=
  SimpleGraph.Reachable.mono le_sup_right (fromRel_reachable ⟨i, rfl, rfl⟩)

theorem matching_fixed_reachable (K : SimpleGraph V) (a b : I → V) {x y : V}
    (h : K.Reachable x y) : (matchingGraph K a b).Reachable x y :=
  SimpleGraph.Reachable.mono le_sup_left h

theorem reachable_map_by_paths {W : Type*} {H : SimpleGraph V} {K : SimpleGraph W} (f : V → W)
    (h : ∀ x y, H.Adj x y → K.Reachable (f x) (f y)) {x y : V}
    (hxy : H.Reachable x y) : K.Reachable (f x) (f y) := by
  obtain ⟨p⟩ := hxy
  induction p with
  | nil => exact SimpleGraph.Reachable.rfl
  | cons hadj p ih => exact (h _ _ hadj).trans ih

def insertedGraph (K : SimpleGraph V) (a b : I → V) (u j : I) : SimpleGraph V :=
  matchingGraph K a (fun i => b (Equiv.swap u j i))

theorem base_reachable_inserted (K : SimpleGraph V) (a b : I → V) (u j : I)
    (hu : K.Reachable (a u) (b u)) {x y : V}
    (hxy : (matchingGraph K a b).Reachable x y) :
    (insertedGraph K a b u j).Reachable x y := by
  have hleft : (insertedGraph K a b u j).Reachable (a u) (b j) := by
    simpa only [insertedGraph, Equiv.swap_apply_left] using
      matching_edge_reachable K a (fun i => b (Equiv.swap u j i)) u
  have hright : (insertedGraph K a b u j).Reachable (a j) (b u) := by
    simpa only [insertedGraph, Equiv.swap_apply_right] using
      matching_edge_reachable K a (fun i => b (Equiv.swap u j i)) j
  have hfixed : (insertedGraph K a b u j).Reachable (a u) (b u) :=
    matching_fixed_reachable K a _ hu
  have hdir (i : I) : (insertedGraph K a b u j).Reachable (a i) (b i) := by
    by_cases hiu : i = u
    · subst i; exact hfixed
    · by_cases hij : i = j
      · subst i; exact hright.trans (hfixed.symm.trans hleft)
      · simpa only [insertedGraph, Equiv.swap_apply_of_ne_of_ne hiu hij] using
          matching_edge_reachable K a (fun i => b (Equiv.swap u j i)) i
  apply reachable_transfer (H := matchingGraph K a b) (K := insertedGraph K a b u j) _ hxy
  intro x y h
  rcases h with h | ⟨_, h | h⟩
  · exact matching_fixed_reachable K a _ h.reachable
  · obtain ⟨i, rfl, rfl⟩ := h
    exact hdir i
  · obtain ⟨i, rfl, rfl⟩ := h
    exact (hdir i).symm

noncomputable def collapseComponent (K : SimpleGraph V) (root dst x : V) : V :=
  if K.Reachable root x then dst else x

theorem collapse_inserted_reachable (K : SimpleGraph V) (a b : I → V) (u j : I)
    (hu : K.Reachable (a u) (b u)) (hju : j ≠ u)
    (hsep : ∀ i, i ≠ u → ¬ K.Reachable (a u) (a i) ∧ ¬ K.Reachable (a u) (b i))
    {x y : V} (hxy : (insertedGraph K a b u j).Reachable x y) :
    (matchingGraph K a b).Reachable
      (collapseComponent K (a u) (b j) x) (collapseComponent K (a u) (b j) y) := by
  have hj := hsep j hju
  have hself : K.Reachable (a u) (a u) := SimpleGraph.Reachable.rfl
  let F := collapseComponent K (a u) (b j)
  have hdir (i : I) : (matchingGraph K a b).Reachable (F (a i)) (F (b (Equiv.swap u j i))) := by
    by_cases hiu : i = u
    · subst i
      simp only [F, collapseComponent, if_pos hself, Equiv.swap_apply_left, if_neg hj.2]
      exact SimpleGraph.Reachable.rfl
    · by_cases hij : i = j
      · subst i
        simpa only [F, collapseComponent, if_neg hj.1, Equiv.swap_apply_right, if_pos hu]
          using matching_edge_reachable K a b j
      · have hi := hsep i hiu
        simpa only [F, collapseComponent, if_neg hi.1,
          Equiv.swap_apply_of_ne_of_ne hiu hij, if_neg hi.2]
          using matching_edge_reachable K a b i
  apply reachable_map_by_paths F _ hxy
  intro x y h
  rcases h with hK | ⟨_, h | h⟩
  · by_cases hx : K.Reachable (a u) x
    · have hy := hx.trans hK.reachable
      simp only [F, collapseComponent, if_pos hx, if_pos hy]
      exact SimpleGraph.Reachable.rfl
    · have hy : ¬ K.Reachable (a u) y := fun hy => hx (hy.trans hK.reachable.symm)
      simpa only [F, collapseComponent, if_neg hx, if_neg hy] using
        matching_fixed_reachable K a b hK.reachable
  · obtain ⟨i, rfl, rfl⟩ := h
    exact hdir i
  · obtain ⟨i, rfl, rfl⟩ := h
    exact (hdir i).symm

theorem insertion_connectedOn_imp (K : SimpleGraph V) (a b : I → V) (u j k : I)
    (S : V → Prop) (hu : K.Reachable (a u) (b u)) (hju : j ≠ u) (hku : k ≠ u)
    (hsep : ∀ i, i ≠ u → ¬ K.Reachable (a u) (a i) ∧ ¬ K.Reachable (a u) (b i))
    (hjS : S (b j)) (hkS : S (b k))
    (hconn : ∀ x y, S x → S y → (insertedGraph K a b u j).Reachable x y) :
    ∀ x y, S x → S y → (insertedGraph K a b u k).Reachable x y := by
  have hj := hsep j hju
  have hk := hsep k hku
  have hanchors : (matchingGraph K a b).Reachable (b k) (b j) := by
    simpa only [collapseComponent, if_neg hk.2, if_neg hj.2] using
      collapse_inserted_reachable K a b u j hu hju hsep (hconn _ _ hkS hjS)
  have hanchors' := base_reachable_inserted K a b u k hu hanchors
  have hleft : (insertedGraph K a b u k).Reachable (a u) (b k) := by
    simpa only [insertedGraph, Equiv.swap_apply_left] using
      matching_edge_reachable K a (fun i => b (Equiv.swap u k i)) u
  have hcollapse (x : V) : (insertedGraph K a b u k).Reachable
      x (collapseComponent K (a u) (b j) x) := by
    by_cases hx : K.Reachable (a u) x
    · rw [collapseComponent, if_pos hx]
      exact (matching_fixed_reachable K a _ hx.symm).trans (hleft.trans hanchors')
    · rw [collapseComponent, if_neg hx]
  intro x y hx hy
  have hmid := collapse_inserted_reachable K a b u j hu hju hsep (hconn x y hx hy)
  have hmid' := base_reachable_inserted K a b u k hu hmid
  exact (hcollapse x).trans (hmid'.trans (hcollapse y).symm)

theorem insertion_connectedOn_iff (K : SimpleGraph V) (a b : I → V) (u j k : I)
    (S : V → Prop) (hu : K.Reachable (a u) (b u)) (hju : j ≠ u) (hku : k ≠ u)
    (hsep : ∀ i, i ≠ u → ¬ K.Reachable (a u) (a i) ∧ ¬ K.Reachable (a u) (b i))
    (hjS : S (b j)) (hkS : S (b k)) :
    (∀ x y, S x → S y → (insertedGraph K a b u j).Reachable x y) ↔
      (∀ x y, S x → S y → (insertedGraph K a b u k).Reachable x y) :=
  ⟨insertion_connectedOn_imp K a b u j k S hu hju hku hsep hjS hkS,
    insertion_connectedOn_imp K a b u k j S hu hku hju hsep hkS hjS⟩

end Insertion

end WeldedPath.SingleCycleGraph
end
-- END Solutions.SingleCycleGraphInsertion

