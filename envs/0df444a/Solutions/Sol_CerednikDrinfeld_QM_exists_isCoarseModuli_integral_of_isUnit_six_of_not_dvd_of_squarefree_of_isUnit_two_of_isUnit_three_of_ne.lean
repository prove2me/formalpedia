  obtain ⟨d₀, ⟨hd₀, hlaw⟩, -⟩ := hY.univ 𝒳 f (fun S _ s u => pt S s u.1) hiso hpb
  exact ⟨d₀, hd₀, fun S _ s u => (hlaw S s u).symm⟩

