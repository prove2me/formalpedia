    (hφ'n : IsNilpotent (RingHom.ker φ')) (hφ''n : IsNilpotent (RingHom.ker φ''))
    (x' : Gobj B' ψ') (x'' : Gobj B'' ψ'') (hx : Gmap φ' hφ' x' = Gmap φ'' hφ'' x'') :
    ∃! z : Gobj (pullbackRing φ' φ'') (pullbackStr φ' φ'' ψ' ψ'' (hφ'.trans hφ''.symm)),
