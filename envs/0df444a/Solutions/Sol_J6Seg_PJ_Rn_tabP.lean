namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function

section tab
variable {W Q R s t lam α : ℕ} {v : Vr} {c : Cs}

/-- **The line tables** `di, dd, Γ, Γ⁻¹`, reversed, on `SDI, SDD, SGM, SGI`. -/
theorem Rn.tabP_sol_aux (hc : c PreT.Cu = []) (hi : PreT.StIn2 v Q R s t lam α W) (hQW : Q ≤ W)
    (hDI : c SDI = []) (hDD : c SDD = []) (hGM : c SGM = []) (hGI : c SGI = [])
    (bdi : ∀ k < lam, |(mkTables Q R s t α).di k| ≤ 2 ^ W)
    (bdd : ∀ k < lam, |(mkTables Q R s t α).dd k| ≤ 2 ^ W)
    (bq : ∀ k < lam, |HvdH.expNeg Q s (2 * α ^ 2 * t * (k + 1))| ≤ 2 ^ W)
    (bG : ∀ k ≤ lam, |gamI Q s t α k| ≤ 2 ^ W)
    (bI : ∀ k < lam, |giI Q s t α k| ≤ 2 ^ W) :
    Rn tabP v c (fun v' => Fxk [4, 5, 11, 12] v v' ∧ BV W v')
      (update (update (update (update c SDI (diL Q R s t lam α).reverse) SDD
        (ddL Q R s t lam α).reverse) SGM (gamL Q R s t lam α).reverse) SGI
        (giL Q R s t lam α).reverse) (cTabP W Q R lam) := by
  unfold PJ.tabP cTabP
  -- di
  have R1 : Rn (PreT.stDI SDI) v c (fun v' => Fxk [11, 12] v v' ∧ BV W v')
      (update c SDI ((diL Q R s t lam α).reverse ++ c SDI)) _ :=
    ⟨PreT.wS v (mkTables Q R s t α).di lam, ⟨fun j hj => PreT.wS_oth v _ (fun h => hj (by simp [h])) (fun h => hj (by simp [h])) lam,
      PreT.wS_VB hi.vb _ hi.lam bdi lam le_rfl⟩,
      fun s0 => PreT.stDI_sp s0 v c (O := SDI) (by decide) (by decide) (by decide) hc hi.toStIn bdi⟩
  rw [hDI, List.append_nil] at R1
  refine Rn.seq R1 (fun v1 ⟨f1, b1⟩ => ?_)
  have g1 : ∀ j ∉ ([4, 5, 11, 12] : List (Fin HS)), v1 j = v j := fun j hj =>
    f1 j (fun h => hj (by simp only [List.mem_cons] at h ⊢; tauto))
  have SI : ∀ u : Vr, BV W u → (∀ j ∉ ([4, 5, 11, 12] : List (Fin HS)), u j = v j) →
      PreT.StIn2 u Q R s t lam α W := fun u bu g =>
    ⟨⟨bu, by rw [g 20 (by decide), hi.h20], by rw [g 21 (by decide), hi.h21],
      by rw [g 22 (by decide), hi.h22], by rw [g 23 (by decide), hi.h23],
      by rw [g 24 (by decide), hi.h24], by rw [g 25 (by decide), hi.h25], hi.lam, hi.A2⟩,
      by rw [g 9 (by decide), hi.h9], by rw [g 10 (by decide), hi.h10]⟩
  -- dd
  set c1 := update c SDI (diL Q R s t lam α).reverse with hc1
  have R2 : Rn (PreT.stDD SDD) v1 c1 (fun v' => Fxk [11, 12] v1 v' ∧ BV W v')
      (update c1 SDD ((ddL Q R s t lam α).reverse ++ c1 SDD)) _ :=
    ⟨PreT.wS v1 (mkTables Q R s t α).dd lam, ⟨fun j hj => PreT.wS_oth v1 _ (fun h => hj (by simp [h])) (fun h => hj (by simp [h])) lam,
      PreT.wS_VB b1 _ hi.lam bdd lam le_rfl⟩,
      fun s0 => PreT.stDD_sp s0 v1 c1 (O := SDD) (by decide) (by decide) (by decide)
        (by rw [hc1, update_of_ne (by decide), hc]) (SI v1 b1 g1).toStIn bdd⟩
  rw [show c1 SDD = [] by rw [hc1, update_of_ne (by decide), hDD], List.append_nil] at R2
  refine Rn.seq R2 (fun v2 ⟨f2, b2⟩ => ?_)
  have g2 : ∀ j ∉ ([4, 5, 11, 12] : List (Fin HS)), v2 j = v j := fun j hj => by
    rw [f2 j (fun h => hj (by simp only [List.mem_cons] at h ⊢; tauto)), g1 j hj]
  -- gam
  set c2 := update c1 SDD (ddL Q R s t lam α).reverse with hc2
  have n2 : ∀ j : Fin HS, j ≠ SDD → j ≠ SDI → c2 j = c j := fun j a b => by
    rw [hc2, update_of_ne a, hc1, update_of_ne b]
  have H3 := fun (s0 : IState HS) => PreT.stG_spX s0 v2 c2 (O := SGM) (eF := .reg 4) (by decide) (by decide) (by decide)
    (by rw [n2 _ (by decide) (by decide), hc]) (SI v2 b2 g2) hQW (PreT.inRg_reg (by decide)) rfl
    (by decide) (fun u cu => PreT.ok_RF (PreT.inRg_reg (by decide)) rfl) (gamI Q s t α)
    (fun k u cu h4 _ => by rw [PreT.ev_reg (by decide), h4]) bq (fun k hk => bG k hk.le)
    (fun k hk => bG (k + 1) hk)
  have R3 : Rn (PreT.stGam SGM) v2 c2 (fun v' => Fxk [4, 5, 11, 12] v2 v' ∧ BV W v')
      (update c2 SGM (PreT.rv (gamI Q s t α) lam ++ c2 SGM)) _ :=
    ⟨_, ⟨fun j hj => by
      simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
      exact (H3 sN).1 j hj.1 hj.2.1 hj.2.2.1 hj.2.2.2, (H3 sN).2.1⟩, fun s0 => (H3 s0).2.2⟩
  rw [show c2 SGM = [] by rw [n2 _ (by decide) (by decide), hGM], List.append_nil] at R3
  refine Rn.seq R3 (fun v3 ⟨f3, b3⟩ => ?_)
  have g3 : ∀ j ∉ ([4, 5, 11, 12] : List (Fin HS)), v3 j = v j := fun j hj => by
    rw [f3 j hj, g2 j hj]
  -- gi
  set c3 := update c2 SGM (PreT.rv (gamI Q s t α) lam) with hc3
  have n3 : ∀ j : Fin HS, j ≠ SGM → j ≠ SDD → j ≠ SDI → c3 j = c j := fun j a b d => by
    rw [hc3, update_of_ne a, n2 j b d]
  have H4 := fun (s0 : IState HS) => PreT.stG_spX s0 v3 c3 (O := SGI) (eF := PreT.giE) (by decide) (by decide) (by decide)
    (by rw [n3 _ (by decide) (by decide) (by decide), hc]) (SI v3 b3 g3) hQW
    (PreT.inRg_of (by decide)) (by decide) (by decide)
    (fun u cu => PreT.ok_ediv (PreT.ok_RF (PreT.inRg_of (by decide)) rfl)
      (PreT.ok_RF (PreT.inRg_of (by decide)) rfl))
    (giI Q s t α)
    (fun k u cu h4 h9 => by
      have := PreT.fdE_eval (s := s0) (c := cu) (v := u) h9 (.reg 9) (.reg 4)
      rw [PreT.ev_reg (by decide), PreT.ev_reg (by decide), h4, h9] at this
      exact this)
    bq bI (fun k hk => bG (k + 1) hk)
