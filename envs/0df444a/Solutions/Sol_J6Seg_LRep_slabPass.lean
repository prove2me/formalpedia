/-!
# B-line machine, sweep 2: the per-axis passes on line representations

A `(pre, n, post)` array `L` *represents* the lines `φ b c` (`LRep pre n post L φ`) when
`L[b (n·post) + a·post + c] = (φ b c)[a]`. The machine's passes act on representations:

* **`LRep_axisL`**: the in-place axis map applies `f` to every line;
* **`LRep_slabPass`**: a monotone slab pass (output slab `l` = `h l` of input slab `src l`, or
  zeros) applies `slabLine` to every line (selection, `J` gather and scatter, output);
* **`LRep_kerPass`**: expose `(A, m, post) → (A, post, m)` (`blkTg`), apply a kernel to each
  contiguous `m`-row (indexed by its block), expose back;
* **`LRep_split` / `LRep_join`**: `(pre, nc·λ, post)` is `(pre·nc, λ, post)`;
* **`LRep_chunkPass`**: the chunk kernel `chunksG g λ nc` on every line, by one `λ`-exposure.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM NLogN.KFY

namespace J6Seg

section passes
variable {α β : Type*} [Inhabited α] [Inhabited β]

/-! ## Slab passes -/

lemma length_slabOf (B : List α) (post : ℕ) (src : Option ℕ) (h : α → β)
    (hB : ∀ k, src = some k → (k + 1) * post ≤ B.length) :
    (slabOf B post src h).length = post := by
  unfold slabOf
  cases src with
  | none => simp
  | some k =>
    have := hB k rfl
    simp only [List.length_map, List.length_take, List.length_drop]
    rw [Nat.succ_mul] at this; omega

/-- **Slab passes on representations.** -/
theorem LRep_slabPass_sol_aux {pre n n' post : ℕ} (hn : 0 < n) (hp : 0 < post) {L : List α}
    {φ : ℕ → ℕ → List α} (hL : LRep pre n post L φ) (src : ℕ → Option ℕ) (h : ℕ → α → β)
    (hsrc : ∀ l < n', ∀ k, src l = some k → k < n) :
    LRep pre n' post (slabPass n n' post src h L) (fun b c => slabLine n' src h (φ b c)) := by
  obtain ⟨hch, hlen⟩ := chunk_blocks (n * post) pre (by positivity) L hL.1
  have hslab : ∀ B : List α, B.length = n * post → ∀ l < n',
      (slabOf B post (src l) (h l)).length = post := by
    intro B hB l hl
    apply length_slabOf
    intro k hk
    have := hsrc l hl k hk
    rw [hB]; exact Nat.mul_le_mul_right _ (by omega)
  have hinner : ∀ B : List α, B.length = n * post →
      ((List.range n').flatMap fun l => slabOf B post (src l) (h l)).length = n' * post := by
    intro B hB
    rw [List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform post]
    · simp
    · intro row hrow
      simp only [List.mem_map, List.mem_range] at hrow
      obtain ⟨l, hl, rfl⟩ := hrow
      exact hslab B hB l hl
  have hrows : ∀ row ∈ ((List.range pre).map fun i => (L.drop (i * (n * post))).take (n * post)).map
      (fun B => (List.range n').flatMap fun l => slabOf B post (src l) (h l)),
      row.length = n' * post := by
    intro row hrow
    simp only [List.mem_map] at hrow
    obtain ⟨B, hB, rfl⟩ := hrow
    exact hinner B (hlen B (List.mem_map.2 (by simpa using hB)))
  refine ⟨?_, fun b _ c _ => by simp [slabLine], fun b hb a ha c hc => ?_⟩
  · unfold slabPass
    rw [hch, List.flatMap_def, IntMul.HvdH.RefPf.length_flatten_uniform (n' * post) _ hrows]
    simp
  unfold slabPass
  rw [hch, List.flatMap_def, Nat.add_assoc, IntMul.HvdH.RefPf.flatten_getD_uniform (n' * post)
    default _ hrows b (by simp; exact hb) _ (lt_mul_of_split ha hc)]
  rw [List.getD_eq_getElem _ [] (by simp; exact hb), List.getElem_map, List.getElem_map,
    List.getElem_range]
  set B := (L.drop (b * (n * post))).take (n * post) with hBdef
  have hBl : B.length = n * post := hlen _ (List.mem_map.2 ⟨b, List.mem_range.2 hb, rfl⟩)
  have hrows2 : ∀ row ∈ (List.range n').map (fun l => slabOf B post (src l) (h l)),
      row.length = post := by
    intro row hrow
    simp only [List.mem_map, List.mem_range] at hrow
    obtain ⟨l, hl, rfl⟩ := hrow
    exact hslab B hBl l hl
  rw [List.flatMap_def, IntMul.HvdH.RefPf.flatten_getD_uniform post default _ hrows2 a
    (by simp; exact ha) c hc]
  rw [List.getD_eq_getElem _ [] (by simp; exact ha), List.getElem_map, List.getElem_range]
  rw [List.getD_eq_getElem (slabLine n' src h (φ b c)) _ (by simp [slabLine]; exact ha)]
  unfold slabLine
  rw [List.getElem_map, List.getElem_range]
  unfold slabOf
  rcases hs : src a with _ | k
  · simp
  · have hk := hsrc a ha k hs
    have hkc : k * post + c < n * post := lt_mul_of_split hk hc
    simp only []
    rw [List.getD_eq_getElem _ _ (by simp; omega), List.getElem_map]
    congr 1
    have h1 := getD_drop_take B (k * post) post c hc
    rw [List.getD_eq_getElem _ _ (by simp; omega)] at h1
    rw [h1, hBdef, getD_drop_take L _ _ _ hkc, ← Nat.add_assoc]
    exact hL.2.2 b hb k hk c hc

/-! ## Exposures and kernels on rows -/

/-! ## Reshaping `(pre, nc·λ, post) ↔ (pre·nc, λ, post)` -/

end passes

end J6Seg

