-- Source module: Solutions.KFNPieces
/-!
# KFN: digit pieces

`pcs m k base R`: the pieces `(level j, offset o)` of the base-`m` digit decomposition of the
bit range `[base, base + R)`: `R / m^k` pieces of level `k`, then the remainder at the lower
levels.  Every bit of the range is covered by exactly one piece (`countP_pcs`); there are at most
`R / m^k + k m` pieces (`length_pcs`).

Operators: `subOp g (tens A) = tensF (indicator)` (`subOp_tens`); implementations of
`tensF Fₐ` compose to `tensF (∏ₐ Fₐ)` (`sImpl_tensF_list`); a family of indicators of a
partition multiplies to `A` (`prod_ind`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFN

open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly

/-! ## The pieces -/

/-- Pieces `(level, offset)` of the range `[base, base + R)`. -/
def pcs (m : ℕ) : ℕ → ℕ → ℕ → List (ℕ × ℕ)
  | 0, base, R => (List.range R).map fun c => (0, base + c)
  | k + 1, base, R => (List.range (R / m ^ (k + 1))).map (fun c => (k + 1, base + c * m ^ (k + 1))) ++
      pcs m k (base + R / m ^ (k + 1) * m ^ (k + 1)) (R % m ^ (k + 1))

/-- Piece `p` covers bit `i`. -/
def covers (m : ℕ) (i : ℕ) (p : ℕ × ℕ) : Bool := decide (p.2 ≤ i ∧ i < p.2 + m ^ p.1)

