theorem solution (R : Type) [CommRing R] (t x : R)
    (hreg : TypeDensity.RegularParameterPair R t x) (hregSwap : TypeDensity.RegularParameterPair R x t)
    (beta : TypeDensity.BlowupRestriction R t x) (d j : ℕ)
    (h : TypeDensity.cechInputLattice R t x j ≤ (TypeDensity.cechOutputLattice R t x j).comap
