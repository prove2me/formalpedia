namespace AFT
end AFT
namespace AFT.FiniteDist
end AFT.FiniteDist






set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000

namespace InfoLossLAR.WorstCase
open AFT Matrix QAlgorithms.Complexity
open scoped BigOperators Classical

/-- The actual classical rank-one preprocessing, using the observed LWE response. -/
def larRankOnePreprocess {F K : Type*} [CommRing F] {d N : ℕ}
    (auxiliary : Fin N → F) (direction : K → (Fin d → F))
    (matrix : Matrix (Fin d) (Fin N) F) (response : Fin d → F) (mark : K) :
    Matrix (Fin d) (Fin N) F × K :=
  (-matrix+vecMulVec (response+direction mark) auxiliary,mark)



/-- The real block experiment samples the zero-fiber error, its independent
uniform output label, and the uniform public matrix independently. -/
noncomputable def larRankOneRealBlock {F K : Type*} [Field F] [Fintype F]
    [Fintype K] [Nonempty K] {d N : ℕ}
    (source : _root_.AFT.FiniteDist (Fin d → F)) (direction : K → (Fin d → F))
    (secret auxiliary : Fin N → F) : _root_.AFT.FiniteDist (Matrix (Fin d) (Fin N) F × K) :=
  (source.prod (_root_.AFT.FiniteDist.uniform K)).mix fun draw =>
    (_root_.AFT.FiniteDist.uniform (Matrix (Fin d) (Fin N) F)).map fun matrix =>
      _root_.InfoLossLAR.WorstCase.larRankOnePreprocess auxiliary direction matrix (matrix.mulVec secret+draw.1) draw.2

/-- The ideal LWE block has a uniform response independent of the public
matrix; the reduction still samples its independent uniform output label. -/
noncomputable def larRankOneIdealBlock {F K : Type*} [Field F] [Fintype F]
    [Fintype K] [Nonempty K] {d N : ℕ}
    (direction : K → (Fin d → F)) (auxiliary : Fin N → F) :
    _root_.AFT.FiniteDist (Matrix (Fin d) (Fin N) F × K) :=
  ((_root_.AFT.FiniteDist.uniform (Fin d → F)).prod (_root_.AFT.FiniteDist.uniform K)).mix fun draw =>
    (_root_.AFT.FiniteDist.uniform (Matrix (Fin d) (Fin N) F)).map fun matrix =>
      _root_.InfoLossLAR.WorstCase.larRankOnePreprocess auxiliary direction matrix draw.1 draw.2

/-- The literal uniform zero fiber, as a normalized law on the full input space. -/
noncomputable def larUniformZeroLaw {V K : Type*} [Fintype V] [Zero V] [Zero K]
    (label : V → K) (hzero : label 0=0) : _root_.AFT.FiniteDist V := by
  letI : Nonempty {x : V // label x=0} := ⟨⟨0,hzero⟩⟩
  exact (_root_.AFT.FiniteDist.uniform {x : V // label x=0}).map Subtype.val

































/-- Actual real-LWE preprocessing: one shared secret and independently
sampled errors/matrices/marks in every block, with one shared auxiliary vector. -/
noncomputable def prRankOneRealLAR (D : Family) (lam : ℕ) (pp : Str)
    (q N d ℓ t : ℕ) [Fact q.Prime] [NeZero q]
    (source : _root_.AFT.FiniteDist (Fin d → ZMod q))
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q)) : ℝ :=
  avg fun secret : Fin N → ZMod q => avg fun auxiliary : Fin N → ZMod q =>
    (_root_.AFT.FiniteDist.independent (fun _ : Fin t => _root_.InfoLossLAR.WorstCase.larRankOneRealBlock source direction secret auxiliary)).expectation
      (fun table => acceptProb D (encInput lam pp (encTable table)))

/-- Actual ideal-LWE preprocessing uses the same single shared auxiliary
vector and independently drawn uniform matrix/response/mark blocks. -/
noncomputable def prRankOneIdealLAR (D : Family) (lam : ℕ) (pp : Str)
    (q N d ℓ t : ℕ) [Fact q.Prime] [NeZero q]
    (direction : (Fin ℓ → ZMod q) → (Fin d → ZMod q)) : ℝ :=
  avg fun auxiliary : Fin N → ZMod q =>
    (_root_.AFT.FiniteDist.independent (fun _ : Fin t => _root_.InfoLossLAR.WorstCase.larRankOneIdealBlock direction auxiliary)).expectation
      (fun table => acceptProb D (encInput lam pp (encTable table)))

























end InfoLossLAR.WorstCase

end

