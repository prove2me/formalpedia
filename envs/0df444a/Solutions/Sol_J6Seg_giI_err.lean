-- Source module: Solutions.J6SegTab
/-!
# Segmented inverse (S2): construction of the constant tables

`mkTables P R s t α` (computable) fills the tables of `J6SegAlg` with
* `di u = expNeg P s (α²(t-s)u²)` (`≈ 2^P e^{-πα²θu²}`),
* `dd u = expPos (P+R) s (α²(t-s)u²) R` (`≈ 2^P e^{πα²θu²}`, needs `e^{πα²θu²} ≤ 2^R`),
* `gam`: `(q;q)_u` by the recurrence `Γ_{u+1} = Γ_u (1 - q^{u+1})` (`q^k` by `expNeg`),
* `gi u = 2^P / Γ_u` (`fdiv`), `ap/am c h = (-1)^h e^{-πα²(σ ± 2β_c)h} / Γ_h`,
* `cpl i h = expNeg P s² (α² K_{i,h})` (the entries of `E`, as in `Eapprox`).

`mkTables_ok`: `TabOK` with `E = 3λ + 3` and `Dm = D_{λ-1}`, for blocks of length `≤ λ`, as soon as
`200 (3λ+1) ≤ 2^P` and `D_{λ-1} ≤ 2^R`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section tab
variable {P R s t α : ℕ}

lemma sigma_ge (hs : 0 < s) (hst : s ≤ t) : 1 ≤ (t : ℝ) / s := by
  have hsR : (0 : ℝ) < s := by exact_mod_cast hs
  rw [le_div_iff₀ hsR, one_mul]; exact_mod_cast hst

/-- `|giI u - 2^P/(q;q)_u| ≤ 3u + 1`. -/
theorem giI_err_sol_aux (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hP : 1 ≤ P) {u : ℕ}
    (hu : 200 * (2 * (u : ℝ) + 1) ≤ 2 ^ P) :
    |(giI P s t α u : ℝ) - 2 ^ P * giR (α : ℝ) ((t : ℝ) / s) u| ≤ 3 * u + 1 := by
  have hσ := sigma_ge hs hst
  have hα' : (2 : ℝ) ≤ α := by exact_mod_cast hα
  have hS := two_pow_pos' P
  have hg := gamI_err (P := P) hs hst hα hP u
  set g := (gamI P s t α u : ℝ) with hgd
  set Γ := gamR (α : ℝ) ((t : ℝ) / s) u
  have hΓ0 := gamR_pos hα' hσ u
  have hΓ1 := gamR_le_one hα' hσ u
  have hΓl : 0.9999 ≤ Γ := by
    have := (inv_qpoch_bound (α : ℝ) ((t : ℝ) / s) hα' hσ u).2
    simp only [Γ, gamR]; nlinarith
  have hu0 : (0 : ℝ) ≤ u := Nat.cast_nonneg u
  rw [abs_le] at hg
  have hgl : 0.98 * 2 ^ P ≤ g := by nlinarith
  have hg0 : 0 < g := by linarith
  have hgi : (0 : ℤ) < gamI P s t α u := by
    have h0 : (0 : ℝ) < (gamI P s t α u : ℝ) := hg0
    exact_mod_cast h0
  have hf := fdiv_err P (2 ^ P) hgi
  push_cast at hf
  rw [← hgd] at hf
  have e1 : ((2 : ℝ) ^ P / 2 ^ P) / (g / 2 ^ P) = 2 ^ P / g := by field_simp
  rw [e1] at hf
  have hf' : |(giI P s t α u : ℝ) - 2 ^ P * 2 ^ P / g| ≤ 1 / 2 := by
    have e : (giI P s t α u : ℝ) - 2 ^ P * 2 ^ P / g =
        ((fdiv P (2 ^ P) (gamI P s t α u) : ℝ) / 2 ^ P - 2 ^ P / g) * 2 ^ P := by
      unfold giI; field_simp
    rw [e, abs_mul, abs_of_pos hS]
    have := mul_le_mul_of_nonneg_right hf hS.le
    refine this.trans (le_of_eq ?_); field_simp
  have hgiR : giR (α : ℝ) ((t : ℝ) / s) u = 1 / Γ := by simp [giR, Γ, gamR]
  rw [hgiR]
  have e2 : 2 ^ P * 2 ^ P / g - 2 ^ P * (1 / Γ) = 2 ^ P * (2 ^ P * Γ - g) / (g * Γ) := by
    field_simp
  have h2 : |2 ^ P * 2 ^ P / g - 2 ^ P * (1 / Γ)| ≤ 2.1 * u := by
    rw [e2, abs_div, abs_mul, abs_of_pos hS, abs_of_pos (mul_pos hg0 hΓ0),
      div_le_iff₀ (mul_pos hg0 hΓ0)]
    have h3 : |2 ^ P * Γ - g| ≤ 2 * u := by rw [abs_le]; constructor <;> linarith
    have h4 : 0.97 * 2 ^ P ≤ g * Γ := by nlinarith
    have h5 : 2 ^ P * |2 ^ P * Γ - g| ≤ 2 ^ P * (2 * u) :=
      mul_le_mul_of_nonneg_left h3 hS.le
    nlinarith
  have := abs_sub_le (giI P s t α u : ℝ) (2 ^ P * 2 ^ P / g) (2 ^ P * (1 / Γ))
  linarith

end tab

