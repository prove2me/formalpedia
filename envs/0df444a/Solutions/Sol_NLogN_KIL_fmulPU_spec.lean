-- Source module: Solutions.KIL4Div
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel

theorem cntR_le (p : ℕ → Bool) (n : ℕ) : cntR p n ≤ n := length_filter_range_le n p

theorem cSA_le (r c j : ℕ) : cSA r c j ≤ c := cntR_le _ _

theorem cntE_size (c a b : ℕ) : (cntE c a b).size = 9 := rfl

theorem clean_ndiv {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.ndiv a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem clean_nmod {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.nmod a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem cntE_clean (c a b : ℕ) : (cntE c a b).Clean :=
  clean_mul (clean_add (clean_mul (clean_ndiv (clean_reg (by decide)) (clean_lit _))
    (clean_lit _)) (clean_lit _)) (clean_reg (by decide))

/-- Evaluation, side conditions and bounds of `cntE` on a state with `Q` on `22`, `B` on `25`. -/
theorem cntE_facts {t : IState HS} {Q B c a b Bb : ℕ} {LQ LB : List Item}
    (hQ : t.G sQQ = .int Q :: LQ) (hB : t.G sPC = .int B :: LB) (hc : 0 < c) (ha : a ≤ c)
    (hab : Q / c * a + b ≤ Q) (zQ : zsz (Q : ℤ) ≤ Bb) (zc : zsz (c : ℤ) ≤ Bb)
    (zB : zsz (B : ℤ) ≤ Bb) (zQB : zsz ((Q * B : ℕ) : ℤ) ≤ Bb) :
    (cntE c a b).ok t ∧ (cntE c a b).eval t = (((Q / c * a + b) * B : ℕ) : ℤ) ∧
      (cntE c a b).Bnd t Bb := by
  have eQ : t.top sQQ = (Q : ℤ) := IState.top_eq hQ
  have eB : t.top sPC = (B : ℤ) := IState.top_eq hB
  have hle : ∀ m : ℕ, m ≤ Q → zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) zQ
  have hdiv : ((Q : ℤ) / (c : ℤ)) = ((Q / c : ℕ) : ℤ) := by push_cast; rfl
  have hdq : Q / c ≤ Q := Nat.div_le_self _ _
  have hqa : Q / c * a ≤ Q := le_trans (Nat.le_add_right _ _) hab
  have hb : b ≤ Q := le_trans (Nat.le_add_left _ _) hab
  refine ⟨⟨⟨⟨⟨IState.isInt_of hQ, trivial, by simp only [Ex.eval, eQ]; positivity, by
      show (0 : ℤ) < (c : ℤ); exact_mod_cast hc⟩, trivial⟩, trivial⟩, IState.isInt_of hB⟩, ?_, ?_⟩
  · simp only [cntE, Ex.eval, eQ, eB, hdiv]; push_cast; ring
  · simp only [cntE, Ex.Bnd, Ex.eval, eQ, eB, hdiv]
    refine ⟨⟨⟨⟨zQ, zc, hle _ hdq⟩, le_trans (NLogN.KIL.zsz_nat_le ha) zc,
      ?_⟩, le_trans (NLogN.KIL.zsz_nat_le hb) zQ, ?_⟩, zB, ?_⟩
    · rw [show ((Q / c : ℕ) : ℤ) * (a : ℤ) = ((Q / c * a : ℕ) : ℤ) by push_cast; ring]
      exact hle _ hqa
    · rw [show ((Q / c : ℕ) : ℤ) * (a : ℤ) + (b : ℤ) = ((Q / c * a + b : ℕ) : ℤ) by push_cast; ring]
      exact hle _ hab
    · rw [show (((Q / c : ℕ) : ℤ) * (a : ℤ) + (b : ℤ)) * (B : ℤ) = (((Q / c * a + b) * B : ℕ) : ℤ)
        by push_cast; ring]
      exact le_trans (NLogN.KIL.zsz_nat_le (Nat.mul_le_mul_right _ hab)) zQB

/-- Push a value on a free stack, run, pop it. -/
