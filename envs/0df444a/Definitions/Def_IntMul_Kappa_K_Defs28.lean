section
-- Source module: Solutions.KFUUClean
/-!
# KFUU §8e: clearing registers and lists

* `dropR X C n`: pop `n` (an expression) entries of `X`;
* `popsL L`: pop one entry of every register of `L`;
* `clrF F L`: `F` with the stacks of `L` emptied.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

def dropR (X C : Fin HS) (n : Ex HS) : RS := .rep C n (.pop X)

def popsL : List (Fin HS) → RS
  | [] => .skip
  | i :: L => .seq (.pop i) (popsL L)

def clrF (F : Fin HS → List ℤ) (L : List (Fin HS)) : Fin HS → List ℤ :=
  fun j => if j ∈ L then [] else F j

/-- `oD + 1`. -/
def nD1 : Ex HS := .add (.reg oD) (.lit 1)

/-- The registers holding one value at the end of `Φ`. -/
def Lp : List (Fin HS) := [rW, NLogN.KFUU.rU, oD, oPi, rU2, rCZ, nR, oI, oBv]

/-- The forward cleanup. -/
def cleanF : RS :=
  .seq (dropR pSR NLogN.KFUU.cL nD1) (.seq (dropR pSK NLogN.KFUU.cL nD1) (.seq (dropR pTK NLogN.KFUU.cL nD1) (.seq (dropR pTR NLogN.KFUU.cL nD1)
    (.seq (.pop nR) (NLogN.KFUU.popsL NLogN.KFUU.Lp)))))

def cClean (d B : ℕ) : ℕ := 10 ^ 6 * (d + 2) * (B + 2)

end NLogN.KFUU

end

section
-- Source module: Solutions.KFUUTrP
/-!
# KFUU §11b: the uniform axis rotation `transU`

`readT` reads `descTr w h bs = [w, h, k, b_0, …]` from `dP` (restored); `mkT` builds `2^h`,
the sizes `t_j = 2^{h+b_j}` (on `pTK` and `xB`), `nR = k`, `rCZ = 2`; the first `revU`
reverses all `k` axes; `midT` sets `rCZ = 2 t_0`, the sizes `t_{k-1}, …, t_1` on `pTR`,
`nR = k - 1`; the second `revU` reverses the first `k - 1` axes (inner block `2 t_0`);
`cleanT` clears. **`transU_runs`**: the result is `gflat (transposeL t_0 (V / t_0) zs)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

instance decLS_T (i : Fin HS) : Decidable (LS i) := by unfold LS; infer_instance

/-- The bits as a function. -/
def bLs (bs : List Bool) : ℕ → Bool := fun j => bs.getD j false

/-- `3 + k`. -/
def n3k : Ex HS := .add (.lit 3) (.reg oD)

def readT : RS :=
  .seq setA (.seq (mvL2 NLogN.KFUU.cL (.reg oD) NLogN.KFUU.bT NLogN.KFUU.hD dP) (NLogN.mvK NLogN.KFUU.hD dP NLogN.KFUU.cL n3k))

/-- The managed lists after `readT`. -/
def rdT (F0 : Fin HS → List ℤ) (w h : ℕ) (bs : List Bool) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update F0
    rW [(w : ℤ)]) NLogN.KFUU.rU [(h : ℤ)]) oD [(bs.length : ℤ)]) NLogN.KFUU.bT (KFM.bitsZ bs.length (bLs bs)).reverse

/-- `2^h`, the sizes, `nR = k`, `rCZ = 2`. -/
def mkT : RS :=
  .seq (.push rU2 (.pow2 (.reg NLogN.KFUU.rU))) (.seq NLogN.KFUU.tLoop (.seq (.push nR (.reg oD)) (.push rCZ (.lit 2))))

def mkTF (F1 : Fin HS → List ℤ) (h k : ℕ) (bL : ℕ → Bool) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
  (Function.update F1 rU2 [((2 ^ h : ℕ) : ℤ)]) NLogN.KFUU.bT []) pTK (tZ h bL k)) xB (tZ h bL k))
    nR [(k : ℤ)]) rCZ [2]

/-- `k - 1`. -/
def nK1 : Ex HS := .add (.reg oD) (.lit (-1))

/-- Between the reversals. -/
def midT : RS :=
  .seq (.asg rCZ (.add (.reg xB) (.reg xB))) (.seq (.pop xB)
    (.seq (NLogN.mvK xB pTR NLogN.KFUU.cL nK1) (.asg nR nK1)))

/-- The clearing. -/
def cleanT : RS :=
  .seq (dropR pTK NLogN.KFUU.cL (.reg oD)) (.seq (dropR pTR NLogN.KFUU.cL (.reg nR)) (NLogN.KFUU.popsL [rW, NLogN.KFUU.rU, oD, rU2, rCZ, nR]))

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- The uniform axis rotation. -/
def transU (pM eSw : Fin P) (sdS Dsc : Fin HS) : IStmt HS P :=
  .seq (RS.seq readT mkT).code
  (.seq (revU pM pTK eSw sdS Dsc)
  (.seq midT.code
  (.seq (revU pM pTR eSw sdS Dsc) cleanT.code)))

/-- The cost of `transU`. -/
noncomputable def cTr (K : ℝ) (w h : ℕ) (bs : List Bool) (B Z : ℕ) : ℕ :=
  10 ^ 9 * (bs.length + 1) * (B + 2) ^ 2 + 10 ^ 10 * (bs.length + 1) * (B + 2) ^ 2 +
    cRevU K h w 2 1 bs.length Z (vol (shP h bs)) +
    10 ^ 6 * (bs.length + 1) * (B + 2) ^ 2 +
    cRevU K h w (2 * 2 ^ (h + if bs.headD false then 1 else 0)) (2 ^ (h + if bs.headD false then 1 else 0))
      (bs.length - 1) Z (vol (shP h bs.tail.reverse)) +
    10 ^ 6 * (bs.length + 2) * (B + 2)

end Gen

end NLogN.KFUU

end

