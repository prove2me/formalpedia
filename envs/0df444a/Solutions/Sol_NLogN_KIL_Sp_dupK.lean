theorem Sp.dupK_sol_aux {X Y Z C : Fin HS} (hXY : X ≠ Y) (hXZ : X ≠ Z) (hYZ : Y ≠ Z) (hXC : X ≠ C)
    (hYC : Y ≠ C) (hZC : Z ≠ C) (hX5 : X.val < 56) (hY5 : Y.val < 56) (hZ5 : Z.val < 56)
    (hC5 : C.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L l : List ℤ)
    (hfX : f X = L ++ l) (hfC : f C = []) (Bb : ℕ) (hL : Bnd Bb L)
    (hn : zsz (L.length : ℤ) ≤ Bb) :
    Sp (dupK X Y Z C L.length) (encK s f)
      (encK s (Function.update (Function.update (Function.update f X l) Y (L.reverse ++ f Y)) Z
        (L.reverse ++ f Z))) (cDup L.length Bb) := by
  have H := Sp.rep (C := C) (n := .lit (L.length : ℤ)) (s := s) (F := dupSt f X Y Z L l)
    (N := L.length) (B := Bb)
    (c := (1 + 1) * 2000 * (Bb + 2) + (1 + 1) * 2000 * (Bb + 2) + (2 * Bb + 2))
    (b := .seq (.push Y (.reg X)) (.seq (.push Z (.reg X)) (.pop X))) hC5
    (fun k => by simp [dupSt, Function.update_apply, hXC.symm, hYC.symm, hZC.symm, hfC])
    (by simp [RS.writes, hXC.symm, hYC.symm, hZC.symm])
    (clean_lit _) trivial trivial hn rfl ?_
  · have e0 : dupSt f X Y Z L l 0 = f := by
      funext j; simp only [dupSt, Function.update_apply]
      split_ifs <;> simp_all
    have e1 : dupSt f X Y Z L l L.length = Function.update (Function.update
        (Function.update f X l) Y (L.reverse ++ f Y)) Z (L.reverse ++ f Z) := by
      simp [dupSt]
    rw [e0, e1] at H
    exact H.mono (by simp [cDup, Ex.size])
  · intro k hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : L.take (k + 1) = L.take k ++ [L[k]] := (List.take_concat_get' L k hk).symm
    obtain ⟨G, hG⟩ : ∃ G, G = Function.update (dupSt f X Y Z L l k) C [(L.length : ℤ) - k] :=
      ⟨_, rfl⟩
    rw [← hG]
    have hGX : G X = L[k] :: (L.drop (k + 1) ++ l) := by
      simp only [hG, dupSt, Function.update_apply, if_neg hXC, if_neg hXZ, if_neg hXY, if_true, hd,
        List.cons_append]
    have hb : zsz L[k] ≤ Bb := hL _ (List.getElem_mem hk)
    have h1 := Sp.push s G (i := Y) (e := .reg X) (B := Bb) hY5 (clean_reg hX5) (ok_reg hGX)
      trivial (bnd_reg hGX hb)
    rw [eval_reg hGX] at h1
    obtain ⟨G1, hG1⟩ : ∃ G1, G1 = Function.update G Y (L[k] :: G Y) := ⟨_, rfl⟩
    rw [← hG1] at h1
    have hG1X : G1 X = L[k] :: (L.drop (k + 1) ++ l) := by
      rw [hG1, Function.update_apply, if_neg hXY, hGX]
    have h2 := Sp.push s G1 (i := Z) (e := .reg X) (B := Bb) hZ5 (clean_reg hX5) (ok_reg hG1X)
      trivial (bnd_reg hG1X hb)
    rw [eval_reg hG1X] at h2
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 Z (L[k] :: G1 Z) := ⟨_, rfl⟩
    rw [← hG2] at h2
    have h3 := Sp.pop s G2 (i := X) (B := Bb) hX5 (by rw [hG2, Function.update_apply, if_neg hXZ, hG1X])
      hb
    have H3 := h1.seq (h2.seq h3)
    refine Sp.mono (Sp.congr H3 ?_) (by simp only [Ex.size]; omega)
    congr 1
    funext j
    simp only [hG2, hG1, hG, dupSt, Function.update_apply]
    by_cases h1 : j = X
    · simp only [h1, if_true, if_neg hXY, if_neg hXZ, if_neg hXC]
    by_cases h2 : j = Y
    · simp only [h2, if_true, if_neg hXY.symm, if_neg hYZ, if_neg hYC, if_neg hYZ.symm, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    by_cases h3 : j = Z
    · simp only [h3, if_true, if_neg hXZ.symm, if_neg hYZ.symm, if_neg hZC, ht,
        List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.cons_append]
    · simp only [h1, h2, h3, if_false]

