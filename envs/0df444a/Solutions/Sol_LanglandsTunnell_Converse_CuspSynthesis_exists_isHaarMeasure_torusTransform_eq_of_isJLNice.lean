          (fun y => by rw [hε, FiniteWhittaker.t0090 hv])
          (fun y => by rw [hblind _ (t0033 v _), one_mul])
          (fun y => by rw [← t0031, ← t0037, dF.central_eigen v hv]) y
        rwa [mul_one, one_mul, FiniteWhittaker.t0094 v (hωb v hv), t0031] at h
