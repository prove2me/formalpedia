namespace BetadGlue

private theorem glue {T L J F : Type*} [CommRing T] [CommRing L] [AddCommGroup J] [Module T J] [Monoid F]
    (V W : Submodule T J) (E : J → Prop) (π : T →+* L) (IL : Ideal L)
    (hπ : Function.Surjective π)
    (hEsmul : ∀ (t : T) (y : J), E y → E (t • y))
    (hSEAM : ∀ t : T, π t ∈ IL → ∀ v ∈ V, E (t • v))
    (hFAITH : ∀ t : T, (∀ v ∈ V, E (t • v)) → π t ∈ IL)
    (hCYC : ∃ e₀ : ↥V → Fˣ,
      (∀ v₁ v₂, e₀ (v₁ + v₂) = e₀ v₁ * e₀ v₂) ∧
      (∀ v : ↥V, E (v : J) → e₀ v = 1) ∧
      (∀ v : ↥V, (∀ t : T, e₀ (t • v) = 1) → E (v : J)))
    (hμ : ∀ x ∈ W, E x)
    (hmax : ∀ W' : Submodule T J, W' ≤ V → (∀ x ∈ W', E x) → W' ≤ W) :
    ∃ e : ↥V → L ⧸ IL → Fˣ,
      (∀ v₁ v₂ r, e (v₁ + v₂) r = e v₁ r * e v₂ r) ∧
      (∀ v r₁ r₂, e v (r₁ + r₂) = e v r₁ * e v r₂) ∧
      (∀ (t : T) (v) r, e (t • v) r = e v (((Ideal.Quotient.mk IL).comp π) t * r)) ∧
      (∀ r, (∀ v, e v r = 1) → r = 0) ∧
      (∀ v, (∀ r, e v r = 1) ↔ (v : J) ∈ W) := by
  obtain ⟨e₀, h1, h2, h4⟩ := hCYC

  have hbar : ∀ r : L ⧸ IL, ∃ t : T, ((Ideal.Quotient.mk IL).comp π) t = r := by
    intro r
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective r
    obtain ⟨t, ht⟩ := hπ a
    exact ⟨t, by rw [RingHom.comp_apply, ht]; exact ha⟩
  choose sec hsec using hbar

  have hker : ∀ s : T, ((Ideal.Quotient.mk IL).comp π) s = 0 → ∀ v : ↥V, e₀ (s • v) = 1 := by
    intro s hs v
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem] at hs
    exact h2 (s • v) (hSEAM s hs (v : J) v.2)
  have hshift : ∀ (t s : T), ((Ideal.Quotient.mk IL).comp π) s = 0 →
      ∀ v : ↥V, e₀ ((t + s) • v) = e₀ (t • v) := by
    intro t s hs v
    rw [add_smul, h1, hker s hs v, mul_one]

  have he0 : e₀ 0 = 1 := by
    have h := h1 0 0
    rw [add_zero] at h
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)
  have hK : ∀ v : ↥V, E (v : J) → ∀ t : T, e₀ (t • v) = 1 :=
    fun v hv t => h2 (t • v) (hEsmul t (v : J) hv)
  have hE0 : E ((0 : ↥V) : J) := h4 0 (fun t => by rw [smul_zero]; exact he0)

  have h5 : ∀ t : T, (∀ v : ↥V, e₀ (t • v) = 1) → π t ∈ IL := by
    intro t ht
    refine hFAITH t ?_
    intro v hv
    exact h4 (t • ⟨v, hv⟩) (fun s => by rw [← mul_smul, mul_comm, mul_smul]; exact ht _)
  refine ⟨fun v r => e₀ (sec r • v), ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro v₁ v₂ r
    show e₀ (sec r • (v₁ + v₂)) = e₀ (sec r • v₁) * e₀ (sec r • v₂)
    rw [smul_add]
    exact h1 _ _
  ·
    intro v r₁ r₂
    show e₀ (sec (r₁ + r₂) • v) = e₀ (sec r₁ • v) * e₀ (sec r₂ • v)
    have hs : ((Ideal.Quotient.mk IL).comp π) (sec (r₁ + r₂) - (sec r₁ + sec r₂)) = 0 := by
      rw [map_sub, map_add, hsec (r₁ + r₂), hsec r₁, hsec r₂, sub_self]
    have hcoef : sec (r₁ + r₂) = (sec r₁ + sec r₂) + (sec (r₁ + r₂) - (sec r₁ + sec r₂)) := by
      ring
    rw [hcoef, hshift _ _ hs, add_smul, h1]
  ·
    intro t v r
    show e₀ (sec r • t • v) = e₀ (sec (((Ideal.Quotient.mk IL).comp π) t * r) • v)
    have hs : ((Ideal.Quotient.mk IL).comp π)
        (sec r * t - sec (((Ideal.Quotient.mk IL).comp π) t * r)) = 0 := by
      rw [map_sub, map_mul, hsec r, hsec (((Ideal.Quotient.mk IL).comp π) t * r), mul_comm r,
        sub_self]
    have hcoef : sec r * t = sec (((Ideal.Quotient.mk IL).comp π) t * r) +
        (sec r * t - sec (((Ideal.Quotient.mk IL).comp π) t * r)) := by
      ring
    rw [← mul_smul, hcoef, hshift _ _ hs]
  ·
    intro r hr
    have hr' : ∀ v : ↥V, e₀ (sec r • v) = 1 := fun v => hr v
    have hmem : π (sec r) ∈ IL := h5 (sec r) hr'
    rw [← hsec r, RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem
  ·
    intro v
    constructor
    · intro hv
      have hv' : ∀ r : L ⧸ IL, e₀ (sec r • v) = 1 := fun r => hv r
      have hall : ∀ t : T, e₀ (t • v) = 1 := by
        intro t
        have hs : ((Ideal.Quotient.mk IL).comp π)
            (t - sec (((Ideal.Quotient.mk IL).comp π) t)) = 0 := by
          rw [map_sub, hsec, sub_self]
        have hcoef : t = sec (((Ideal.Quotient.mk IL).comp π) t) +
            (t - sec (((Ideal.Quotient.mk IL).comp π) t)) := by
          ring
        rw [hcoef, hshift _ _ hs]
        exact hv' _
      refine hmax
        { carrier := {y | y ∈ V ∧ E y}
          add_mem' := by
            intro a b ha hb
            refine ⟨V.add_mem ha.1 hb.1, ?_⟩
            have key : E (((⟨a, ha.1⟩ + ⟨b, hb.1⟩ : ↥V)) : J) := h4 _ (fun t => by
              rw [smul_add, h1, hK ⟨a, ha.1⟩ ha.2 t, hK ⟨b, hb.1⟩ hb.2 t, mul_one])
            exact key
          zero_mem' := ⟨V.zero_mem, hE0⟩
          smul_mem' := by
            intro t y hy
            exact ⟨V.smul_mem t hy.1, hEsmul t y hy.2⟩ } ?_ ?_ ⟨v.2, h4 v hall⟩
      · intro y hy
        exact hy.1
      · intro y hy
        exact hy.2
    · intro hvW r
      show e₀ (sec r • v) = 1
      exact h2 (sec r • v) (hμ _ (W.smul_mem (sec r) hvW))

end BetadGlue

theorem solution
    (p : ℕ) [Fact p.Prime] (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqp : q ≠ p)
    (Aq : ValuationSubring (AlgebraicClosure ℚ)) (_hAq : Aq.LiesOverPrime q) :
    letI := heckeModuleBar p
    ∀ k M : ℕ, ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
