/-- K0: value bound ⇒ value limit and slope limit. -/
theorem k0_slope {g : ℝ → ℝ} {c₀ c₁ C ε : ℝ} (hε : 0 < ε)
    (hb : ∀ x ∈ Ioo (0:ℝ) ε, |g x - (c₀ + c₁ * x)| ≤ C * x ^ 2) :
    Tendsto (fun x => (g x - c₀) / x) (𝓝[>] 0) (𝓝 c₁) := by
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have hx : Tendsto (fun x : ℝ => C * x) (𝓝[>] 0) (𝓝 0) := by
    have := ((continuous_const_mul C).tendsto 0).mono_left (nhdsWithin_le_nhds (s := Ioi 0))
    simpa using this
  refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_ hx
  filter_upwards [Ioo_mem_nhdsGT hε] with x hx
  have hx0 : 0 < x := hx.1
  have e : (g x - c₀) / x - c₁ = (g x - (c₀ + c₁ * x)) / x := by field_simp; ring
  rw [Real.norm_eq_abs, e, abs_div, abs_of_pos hx0, div_le_iff₀ hx0]
  nlinarith [hb x hx]

theorem k0_value {g : ℝ → ℝ} {c₀ c₁ C ε : ℝ} (hε : 0 < ε)
    (hb : ∀ x ∈ Ioo (0:ℝ) ε, |g x - (c₀ + c₁ * x)| ≤ C * x ^ 2) :
    Tendsto g (𝓝[>] 0) (𝓝 c₀) := by
  have hs := k0_slope hε hb
  have hid : Tendsto (fun x : ℝ => x) (𝓝[>] 0) (𝓝 0) := tendsto_id.mono_left nhdsWithin_le_nhds
  have h := tendsto_const_nhds (x := c₀) |>.add (hid.mul hs)
  rw [zero_mul, add_zero] at h
  refine h.congr' ?_
  filter_upwards [Ioo_mem_nhdsGT hε] with x hx
  field_simp [hx.1.ne']; ring

/-- K3: `g → 0` and `g′ → L` give `g x / x → L`. -/
theorem k3_slope {g g' : ℝ → ℝ} {ε L : ℝ} (hε : 0 < ε)
    (hd : ∀ x ∈ Ioo (0:ℝ) ε, HasDerivAt g (g' x) x)
    (h0 : Tendsto g (𝓝[>] 0) (𝓝 0)) (hl : Tendsto g' (𝓝[>] 0) (𝓝 L)) :
    Tendsto (fun x => g x / x) (𝓝[>] 0) (𝓝 L) :=
  HasDerivAt.lhopital_zero_right_on_Ioo hε hd (fun x _ => hasDerivAt_id x)
    (fun _ _ => one_ne_zero) h0 (tendsto_id.mono_left nhdsWithin_le_nhds) (by simpa using hl)

