section Lev

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

/-- **The two tests of a level** around the chain/node branch. -/
theorem lv_wrap_sol_aux {ι : Type*} [Fintype ι] [DecidableEq ι] {st : ι → ℕ} {n : ℕ}
    {rowC : IStmt HS Pp} {jL : Fin Pp} (hL : LevRH c σ K t S0 r H E e B) (hE1 : 1 ≤ E)
    (hm : 1 ≤ c.m) (Zr M : ℕ) (hMZ : zsz (M : ℤ) ≤ Zr) (hM : E + 2 * c.m + 1 ≤ M)
    (hZr : Zr + 2 ≤ r) {e' dw : ℕ} (CBE : ℝ) (cost0 : ℕ → ℕ)
    (Hin : SImplQ Isym tbl (fun s => Agree (σPush σ [((19 : Fin HS),
        (((ltNE c).val (vOf σ) : ℕ) : ℤ))]) s) 0 H r st n (tens Cm)
      (if (ltNE c).val (vOf σ) = 0 then chainC jL else nodeC c jL rowC) e' dw cost0)
    (hc : ∀ w, w + dw ≤ H →
      (cost0 w : ℝ) + 10 ^ 9 * (Yu r Zr H : ℝ) ≤ CBE * ((n * Yu r Zr H : ℕ) : ℝ)) :
    SImplQ Isym tbl (fun s => Agree σ s) 0 H r st n (tens Cm) (levCH c jL rowC) e' dw
      (fun _ => ⌊CBE * ((n * Yu r Zr H : ℕ) : ℝ)⌋₊) := by
  have hσ0 : σ 0 = none := hL.off 0 (by decide)
  have hnat : ∀ i ∈ [vk], ∃ n : ℕ, σ i = some (n : ℤ) := by
    intro i hi; simp only [List.mem_singleton] at hi; subst hi; exact ⟨_, hL.hk⟩
  have HT := sImplQ_test (I := Isym) (iprog := tbl) hσ0 19 (by decide) (by decide) (ltNE c) M Zr 7
    hMZ (regsLt_of_all (by simp [ltNE, NE.regs] <;> decide)) (by simp [ltNE, NE.size])
    (natR_of _ hnat (by simp [ltNE, NE.regs])) (by
      simp only [ltNE, NE.OK, NE.val, vOf_eq hL.hk]
      refine ⟨by omega, by omega, ?_⟩
      split_ifs <;> omega) Hin
  have HI := sImplQ_ite (I := Isym) (iprog := tbl) (i := vk)
    (fc := fun x => decide (x = NLogN.Cls.zero)) (p := .skip)
    (q := testC 19 (ltNE c) (chainC jL) (nodeC c jL rowC)) (by decide) false
    (fun s hs => by
      rw [cl_agree hs hL.hk]
      have h1 : ¬ ((E : ℤ) = 0) := by omega
      have h2 : ¬ ((E : ℤ) < 0) := by omega
      have h3 : E ≠ 0 := by omega
      simp [NLogN.cls, h1, h2, h3]) HT
  refine (HI.congrC rfl).mono (fun w _ hw => ?_)
  apply Nat.le_floor
  have h := hc w hw
  have hF := cFrame_Y 1 7 r Zr H
  have hz := yu_z1 r Zr H
  have hY8 := yu_8 r Zr H
  have hnat2 : cFrame 1 7 Zr + (cost0 w + 25) + (1 * (2 * Zr + 2) + 1) + 25 ≤
      cost0 w + 10 ^ 9 * Yu r Zr H := by
    generalize cFrame 1 7 Zr = f at hF ⊢
    generalize Yu r Zr H = Y at *
    omega
  have : ((cFrame 1 7 Zr + (cost0 w + 25) + (1 * (2 * Zr + 2) + 1) + 25 : ℕ) : ℝ) ≤
      (cost0 w : ℝ) + 10 ^ 9 * (Yu r Zr H : ℝ) := by exact_mod_cast hnat2
  linarith

end Lev

