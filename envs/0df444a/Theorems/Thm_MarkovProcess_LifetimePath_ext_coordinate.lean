variable {α : Type*} [TopologicalSpace α]











open MarkovProcess.LifetimePath in

theorem MarkovProcess.LifetimePath.ext_coordinate {ω η : LifetimePath α} (hlifetime : ω.lifetime = η.lifetime)
    (hcoordinate : ∀ t, coordinate t ω = coordinate t η) : ω = η := by sorry
