    exact ⟨i, hi, by rw [mul_assoc, inv_mul_cancel₀ ha0', mul_one]⟩
  have hu : (a' : K) * ((a : K))⁻¹ ∈ Ba := hdivBa a' haJ'
  have hu' : (a : K) * ((a' : K))⁻¹ ∈ Ba' := hdivBa' a haJ
  have huO : (a' : K) * ((a : K))⁻¹ ∈ O := hS ⟨_, hu⟩
  have hu'O' : (a : K) * ((a' : K))⁻¹ ∈ O' := hS' ⟨_, hu'⟩
  have huu' : ((a' : K) * ((a : K))⁻¹) * ((a : K) * ((a' : K))⁻¹) = 1 := by
    field_simp
  have hinvu : ((a' : K) * ((a : K))⁻¹)⁻¹ = (a : K) * ((a' : K))⁻¹ := by
    rw [mul_inv, inv_inv, mul_comm]
  have hinvu' : ((a : K) * ((a' : K))⁻¹)⁻¹ = (a' : K) * ((a : K))⁻¹ := by
    rw [mul_inv, inv_inv, mul_comm]

  have hinv_eq : ∀ (R : Subring K) (x v : K), x ≠ 0 → x * v = 1 → v = x⁻¹ := by
    intro R x v hx hxv
    calc v = x⁻¹ * (x * v) := by rw [← mul_assoc, inv_mul_cancel₀ hx, one_mul]
      _ = x⁻¹ := by rw [hxv, mul_one]
  by_cases hA : (a : K) * ((a' : K))⁻¹ ∈ O
  ·
    have hBa'O' : ∀ x : K, x ∈ Ba' → x ∈ O := by
      intro x hg
      rw [hBa', Subalgebra.mem_restrictScalars] at hg
      induction hg using Algebra.adjoin_induction with
      | mem x hx =>
          obtain ⟨i, hi, hx⟩ := hx
          have hx' : x = ((i : K) * ((a : K))⁻¹) * ((a : K) * ((a' : K))⁻¹) := by
            have : x = (i : K) * ((a' : K))⁻¹ := (eq_mul_inv_iff_mul_eq₀ ha0').mpr hx
            rw [this, mul_assoc, ← mul_assoc ((a : K))⁻¹, inv_mul_cancel₀ ha0, one_mul]
          rw [hx']
          exact O.mul_mem (hS ⟨_, hdivBa i hi⟩) hA
      | algebraMap c =>
          have hc : (algebraMap (↥C) K c) ∈ Ba := by
            rw [hBa, Subalgebra.mem_restrictScalars]
            exact Subalgebra.algebraMap_mem _ c
          exact hS ⟨_, hc⟩
      | add x y _ _ hx hy => exact O.add_mem hx hy
      | mul x y _ _ hx hy => exact O.mul_mem hx hy
    have hBa'O : ∀ g : ↥Ba', (g : K) ∈ O := fun g => hBa'O' (g : K) g.2
    by_cases hsep : ∃ g : ↥Ba', g ∉ P' ∧ ¬ IsUnit (⟨(g : K), hBa'O g⟩ : ↥O)
    · obtain ⟨g, hgP', hgnu⟩ := hsep
      have hg0 : (g : K) ≠ 0 := by
        intro h0; apply hgP'
        have : g = 0 := by ext; simpa using h0
        rw [this]; exact P'.zero_mem
      exact ⟨(g : K), hBa'O g, hS' g, hgnu, (isUnit_iff O' _ _).mpr ⟨((g : K))⁻¹, hinv' g hgP', mul_inv_cancel₀ hg0⟩⟩
    · push Not at hsep
      exfalso
      apply hne
      apply hEI
      intro f hf
      obtain ⟨g, h, hh, hfh⟩ := (hO' f).mp hf
      have hhu : IsUnit (⟨(h : K), hBa'O h⟩ : ↥O) := hsep h hh
      obtain ⟨v, hv, hhv⟩ := (isUnit_iff O _ _).mp hhu
      have : f = (g : K) * v := by
