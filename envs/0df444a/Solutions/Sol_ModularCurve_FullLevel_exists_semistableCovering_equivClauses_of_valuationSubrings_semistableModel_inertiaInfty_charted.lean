open ModularCurve.FullLevel.W1c
open ModularCurve.FullLevel.W1c.Plumbing (InTube InTubeJ inTubeJ_of_inTube inTubeJ_levelAutBar_smul_iff)

theorem comap_residue_eq {q : ℕ} [Fact q.Prime] {M' : ℕ} [NeZero M'] {A : ValuationSubring (AlgebraicClosure ℚ)}
    {Fbar : Type} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (C : ComponentChart A (fieldBar q M') Fbar) (σ : (fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M'))
    (f : fieldBar q M') (h : f ∈ (C.comap σ).integers) (h' : σ f ∈ C.integers) :
    (C.comap σ).residue ⟨f, h⟩ = C.residue ⟨σ f, h'⟩ := rfl
set_option synthInstance.maxHeartbeats 1600000 in
set_option maxHeartbeats 25600000 in

theorem solution
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (π : AlgebraicClosure ℚ) (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) (hπP : π ∈ A)
    (ι : GaloisField q 2 →+* IsLocalRing.ResidueField A)
    [IsDomain (DrinfeldCurve.CoordRing q (IsLocalRing.ResidueField A))]
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (OSS : ↥W → ValuationSubring (fieldBar q M'))

    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (hIg_inj : Function.Injective OIg)
    (hIg_perm : ∀ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      ∃ σ : Equiv.Perm (CuspidalType.ProjLine q),
        ∀ ℓ, (OIg ℓ).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OIg (σ ℓ))

    (hSS_A : ∀ s (x : AlgebraicClosure ℚ), algebraMap (AlgebraicClosure ℚ) (fieldBar q M') x ∈ OSS s ↔ x ∈ A)
    (hSS_over : ∀ (s : ↥W) (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
        (IntermediateField.inclusion hle f : fieldBar q M') ∈ OSS s ∧
        ∀ a : A, residue A a =
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
          ∃ h : (IntermediateField.inclusion hle f : fieldBar q M')
              - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s,
            (⟨_, h⟩ : OSS s) ∈ maximalIdeal (OSS s))
    (hSS_fix : ∀ (s : ↥W) (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      (OSS s).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OSS s)

    (hSS_tr : ∀ s : ↥W, ∃ t : fieldBar q M', t ∈ OSS s ∧ ∀ a : A,
      ∃ h : t - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s, IsUnit (⟨_, h⟩ : OSS s))

    (FSS₀ : ↥W → Type) [∀ s, Field (FSS₀ s)] [∀ s, Algebra (ResidueField A) (FSS₀ s)]
    [∀ s, IsCurveOver (ResidueField A) (FSS₀ s)] [∀ s, Algebra.EssFiniteType (ResidueField A) (FSS₀ s)]
    (CSS₀ : ∀ s, ComponentChart A (fieldBar q M') (FSS₀ s)) (hCSS₀ : ∀ s, (CSS₀ s).integers = OSS s) :
    letI : Algebra (GaloisField q 2) (IsLocalRing.ResidueField A) := ι.toAlgebra
    ∃ 𝒞 : SemistableCovering q M' A W,
      ∃ (M : AlgebraicCurve.SemistableModel A ↥(ModularCurve.FullLevel.fieldBar q M') 𝒞.sumFbar 𝒞.sumChart
          (fun e : CuspidalType.ProjLine q × ↥W => 𝒞.An e.1 e.2)
          (fun e => Sum.inl e.1) (fun e => Sum.inr e.2)
          (fun e => 𝒞.sumNode (Sum.inl e.1) e) (fun e => 𝒞.sumNode (Sum.inr e.2) e))
        (D : M.Descent),
      (∀ ℓ, (𝒞.CIg ℓ).integers = OIg ℓ) ∧ (∀ s, (𝒞.CSS s).integers = OSS s) ∧
      𝒞.EquivClauses ∧ 𝒞.W2Clauses π ι q ∧ 𝒞.LevelPinClauses hle R₀ ∧ 𝒞.InertiaClause π ∧
        𝒞.WidthClause ⟨π, hπP⟩ ∧ 𝒞.GenusClause ∧ 𝒞.DiscFibreClause ∧ 𝒞.CurveClause ∧ 𝒞.NaturalityClauses ∧
        𝒞.InertiaIgusaInftyClause := by
  classical

  obtain ⟨Cinf, RI, NIg, discI, coordI, SI, χ₀I, hCinf, hcusp, hsepI, htubeI, hRI, hCinfR, hresI, hnodesI, hNcard, hfamI, hstalkI,
      hSinertI, hdomI, hpmI, hpmoffI, hNstabI, hdiscstabI, hcoverI, hNI, hR₀O⟩ :=
    exists_inftyChart q hq M' hqM' A hA W hW hle R₀ hR₀ ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr π hπ hπP
  have hg := hIg
  choose γ₀ hγ₀ using hg

  have hlab1 : levelAutBar q M' ζ 1 = 1 := by
    have h := levelAutBar_mul q M' hqM' ζ 1 1 (one_mem _) (one_mem _)
    rw [mul_one] at h
    have h2 : levelAutBar q M' ζ 1 * levelAutBar q M' ζ 1 = levelAutBar q M' ζ 1 * 1 := by
      rw [mul_one]; exact h.symm
    exact mul_left_cancel h2
  let γ : CuspidalType.ProjLine q → SL(2, ℤ) := fun ℓ => if ℓ = lineInfty q then 1 else γ₀ ℓ
  have hγ : ∀ ℓ, γ ℓ ∈ Gamma0 M' ∧ redQ q (γ ℓ) • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ (γ ℓ)).toAlgHom.toRingHom := by
    intro ℓ
    by_cases hℓ : ℓ = lineInfty q
    · subst hℓ
      have e : γ (lineInfty q) = 1 := if_pos rfl
      refine ⟨e ▸ one_mem _, by rw [e, map_one, one_smul], ?_⟩
      rw [e, hlab1]
      ext f
      rw [ValuationSubring.mem_comap]
      rfl
    · have e : γ ℓ = γ₀ ℓ := if_neg hℓ
      rw [e]; exact hγ₀ ℓ
  have hγinf : γ (lineInfty q) = 1 := if_pos rfl
  let g : CuspidalType.ProjLine q → ((fieldBar q M') ≃ₐ[(AlgebraicClosure ℚ)] (fieldBar q M')) := fun ℓ => levelAutBar q M' ζ (γ ℓ)
  have hgInf : g (lineInfty q) = 1 := by
    show levelAutBar q M' ζ (γ (lineInfty q)) = 1
    rw [hγinf, hlab1]
  let CIg : ∀ ℓ : CuspidalType.ProjLine q, ComponentChart A (fieldBar q M') (xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M')) := fun ℓ => Cinf.comap (g ℓ)
  have hgmem : ∀ ℓ, g ℓ ∈ LevelAuts q M' := fun ℓ => levelAutBar_mem_levelAuts q M' ζ (hγ ℓ).1
  have hg' : ∀ ℓ, g ℓ ∈ LevelAuts q M' ∧ ∃ γ' : SL(2, ℤ), γ' ∈ Gamma0 M' ∧ redQ q γ' • lineInfty q = ℓ ∧ g ℓ = levelAutBar q M' ζ γ' :=
    fun ℓ => ⟨hgmem ℓ, γ ℓ, (hγ ℓ).1, (hγ ℓ).2.1, rfl⟩
  have hCIg : ∀ ℓ, ChartSpec q M' A (CIg ℓ) (OIg ℓ) W.card := fun ℓ => by
    have h := hCinf.comap (g ℓ) (hgmem ℓ)
    rw [← (hγ ℓ).2.2] at h
    exact h

  obtain ⟨xs, hxs_N, hxs_j⟩ := igusaNodesOver_leaf q hq M' hqM' A hA W hW hle R₀ hR₀ ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr RI hRI hR₀O NIg hNcard hNI g hg'
  have hxs_mem : ∀ ℓ s, xs ℓ s ∈ (CIg ℓ).nodes := fun ℓ s => by
    show xs ℓ s ∈ Cinf.nodes
    rw [hnodesI]; exact hxs_N ℓ s
  have hxs_over : ∀ ℓ, ∃ j : modularFunctionFieldC (ResidueField A) M' →+* xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M'),
      (∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
        ∃ hC : (IntermediateField.inclusion hle f : fieldBar q M') ∈ (CIg ℓ).integers,
          (CIg ℓ).residue ⟨_, hC⟩ = j (R₀.residue ⟨f, hf⟩)) ∧
      ∀ (s : ↥W) (g : modularFunctionFieldC (ResidueField A) M'),
        g ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring ↔
          j g ∈ (xs ℓ s).toValuationSubring := by
    intro ℓ
    obtain ⟨j, hj1, hj2, -, -⟩ := hxs_j ℓ
    refine ⟨j, fun f hf => ?_, hj2⟩
    obtain ⟨hC, e⟩ := hj1 f hf
    have hC' : (IntermediateField.inclusion hle f : fieldBar q M') ∈ (CIg ℓ).integers := by
      show _ ∈ (Cinf.comap (g ℓ)).integers
      rw [ComponentChart.mem_comap_integers, hCinfR]; exact hC
    refine ⟨hC', ?_⟩
    have hC'' : g ℓ (IntermediateField.inclusion hle f : fieldBar q M') ∈ Cinf.integers := by rw [hCinfR]; exact hC
    show (Cinf.comap (g ℓ)).residue ⟨_, hC'⟩ = _
    rw [comap_residue_eq Cinf (g ℓ) _ hC' hC'', hresI _ hC'' hC]; exact e

  have hxs_full : ∀ ℓ, ∃ j : modularFunctionFieldC (ResidueField A) M' →+* xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M'),
      (∀ (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
        ∃ hC : (IntermediateField.inclusion hle f : fieldBar q M') ∈ (CIg ℓ).integers,
          (CIg ℓ).residue ⟨_, hC⟩ = j (R₀.residue ⟨f, hf⟩)) ∧
      (∀ c : ResidueField A, j (algebraMap (ResidueField A) (modularFunctionFieldC (ResidueField A) M') c) =
          algebraMap (ResidueField A) (xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M')) c) ∧
      ∀ Q, Q ∈ (CIg ℓ).nodes ↔ ∃ s : ↥W, ∀ g' : modularFunctionFieldC (ResidueField A) M',
          g' ∈ (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring ↔
            j g' ∈ Q.toValuationSubring := by
    intro ℓ
    obtain ⟨j, hj1, -, hjκ, hjN⟩ := hxs_j ℓ
    refine ⟨j, fun f hf => ?_, hjκ, fun Q => ?_⟩
    · obtain ⟨hC, e⟩ := hj1 f hf
      have hC' : (IntermediateField.inclusion hle f : fieldBar q M') ∈ (CIg ℓ).integers := by
        show _ ∈ (Cinf.comap (g ℓ)).integers
        rw [ComponentChart.mem_comap_integers, hCinfR]; exact hC
      refine ⟨hC', ?_⟩
      have hC'' : g ℓ (IntermediateField.inclusion hle f : fieldBar q M') ∈ Cinf.integers := by rw [hCinfR]; exact hC
      show (Cinf.comap (g ℓ)).residue ⟨_, hC'⟩ = _
      rw [comap_residue_eq Cinf (g ℓ) _ hC' hC'', hresI _ hC'' hC]; exact e
    · show Q ∈ Cinf.nodes ↔ _
      rw [hnodesI]; exact hjN Q

  have hIgTube : ∀ ℓ, ∀ P ∈ (CIg ℓ).dom, ∀ s : ↥W, ¬ InTubeJ q M' A hle s P := by
    intro ℓ P hP s hT
    have hP' : g ℓ • P ∈ Cinf.dom := hP
    exact htubeI _ hP' s ((inTubeJ_smul_iff q M' hqM' A hA hle s ((hW s).mp s.2) (hgmem ℓ) P).mpr hT)
  have hIgSep : ∀ ℓ ℓ' (P : Place (AlgebraicClosure ℚ) (fieldBar q M')), P ∈ (CIg ℓ).dom → P ∈ (CIg ℓ').dom → ℓ = ℓ' := by
    intro ℓ ℓ' P hP hP'
    have h1 : g ℓ • P ∈ Cinf.dom := hP
    have h2 : g ℓ' • P ∈ Cinf.dom := hP'
    have hρ : g ℓ' * (g ℓ)⁻¹ ∈ LevelAuts q M' := Subgroup.mul_mem _ (hgmem ℓ') (Subgroup.inv_mem _ (hgmem ℓ))
    have hfix : (Cinf.comap (g ℓ' * (g ℓ)⁻¹)).integers = Cinf.integers := by
      by_contra hne
      exact hsepI _ hρ hne _ h1 (by rwa [mul_smul, inv_smul_smul])
    apply hIg_inj
    rw [(hγ ℓ).2.2, (hγ ℓ').2.2]
    ext f
    have e := SetLike.ext_iff.mp hfix (g ℓ f)
    rw [ComponentChart.mem_comap_integers, AlgEquiv.mul_apply, hCinf.integers_eq] at e
    show g ℓ f ∈ OIg (lineInfty q) ↔ g ℓ' f ∈ OIg (lineInfty q)
    rw [← e]
    congr! 2
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply]

  have hOrd : ∀ P : Place (AlgebraicClosure ℚ) (fieldBar q M'), (∀ s : ↥W, ¬ InTube q M' A hle R₀ s P) → ∃ ℓ, P ∈ (CIg ℓ).dom := by
    intro P hP
    obtain ⟨ℓ, Q, hQ, hPQ⟩ := ModularCurve.FullLevel.exists_levelAut_smul_mem_igusaDisc_of_forall_not_inTube q hq M' hqM' A hA W hle R₀ ζ OIg hIg_inf RI hRI NIg discI hNstabI hdiscstabI hcoverI g hg' P hP
    refine ⟨ℓ, ?_⟩
    show g ℓ • P ∈ Cinf.dom
    exact (hdomI _).mpr ⟨Q, hQ, hPQ⟩

  obtain ⟨FSS, instFS, instAS, CSS, An, An', xt, RSS, discS, coordS, hCSS, hdom, hmod, hmod0, hparam, hatt, huxs, huxt, hpart,
      hequiv, hgen, hwidth, hLP2, hRSS, hCSSint, hCSSres, hnodesS, hfamS, htransS, hdomS, hpmS, hpmoffS, hNstabS, hdiscstabS,
      hAnInert, hAnTubeC, hpermC, hAvoidC, hcoverC, htrC, hRingC, hHasseC⟩ :=
    exists_covering_data q hq M' hqM' A hA W hW hle R₀ hR₀ ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr FSS₀ CSS₀ hCSS₀ (fun _ => xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M')) CIg hCIg π hπ hπP xs hxs_mem hxs_over hOrd hIgSep hIgTube

  have hcuspmem : ∃ P ∈ (CIg (lineInfty q)).dom, P.toValuationSubring = qIntegersBar (AlgebraicClosure ℚ) (fieldBar q M') := by
    have hint : (CIg (lineInfty q)).integers = Cinf.integers := by
      rw [(hCIg (lineInfty q)).integers_eq, hCinf.integers_eq]
    have hdomeq : (CIg (lineInfty q)).dom = Cinf.dom := hCinf.dom_canonical _ (hgmem _) hint
    obtain ⟨P, hP, hPq⟩ := hcusp
    exact ⟨P, hdomeq ▸ hP, hPq⟩
  let 𝒞 : SemistableCovering q M' A W :=
    { FIg := fun _ => xHFunctionFieldC (ResidueField A) (q ^ 2 * M') (levelH q M'), FSS := FSS, CIg := CIg, CSS := CSS, An := An, An' := An', xs := xs, xt := xt,
      dom_eq := hdom, modulus_eq := hmod, modulus_ne_zero := hmod0, param_mul := hparam,
      isAttached := hatt, existsUnique_xs_eq := huxs, existsUnique_xt_eq := huxt, partition := hpart,
      cusp_mem := hcuspmem,
      hasPrincipalDivisors_Ig := fun ℓ => (hCIg ℓ).hasPrincipalDivisors,
      hasPrincipalDivisors_SS := fun s => (hCSS s).hasPrincipalDivisors,
      isRational_Ig := fun ℓ => (hCIg ℓ).isRational,
      isRational_SS := fun s => (hCSS s).isRational }

  have hEquiv : 𝒞.EquivClauses := by
    intro ζ' γ' hγ'
    obtain ⟨σ, hσ⟩ := hIg_perm ζ' γ' hγ'
    have hIgInt : ∀ ℓ, ((CIg ℓ).comap (levelAutBar q M' ζ' γ')).integers = (CIg (σ ℓ)).integers := by
      intro ℓ
      have e1 : ((CIg ℓ).comap (levelAutBar q M' ζ' γ')).integers =
          (OIg ℓ).comap (levelAutBar q M' ζ' γ').toAlgHom.toRingHom := by
        ext f; rw [ComponentChart.mem_comap_integers, (hCIg ℓ).integers_eq]; rfl
      rw [e1, hσ ℓ, (hCIg (σ ℓ)).integers_eq]
    have hSSInt : ∀ s, ((CSS s).comap (levelAutBar q M' ζ' γ')).integers = (CSS s).integers := by
      intro s
      have e1 : ((CSS s).comap (levelAutBar q M' ζ' γ')).integers =
          (OSS s).comap (levelAutBar q M' ζ' γ').toAlgHom.toRingHom := by
        ext f; rw [ComponentChart.mem_comap_integers, (hCSS s).integers_eq]; rfl
      rw [e1, hSS_fix s ζ' γ' hγ', (hCSS s).integers_eq]
    have hτmem : levelAutBar q M' ζ' γ' ∈ LevelAuts q M' := levelAutBar_mem_levelAuts q M' ζ' hγ'
    refine ⟨σ, fun ℓ => ⟨hIgInt ℓ, ?_⟩, fun s => ⟨hSSInt s, (hCSS s).dom_canonical _ hτmem (hSSInt s)⟩,
      hequiv ζ' γ' hγ' σ hσ⟩
    exact comap_comap_dom_eq_of_integers_eq Cinf hCinf.dom_canonical (g ℓ) (g (σ ℓ)) _
      (hgmem ℓ) (hgmem (σ ℓ)) hτmem (hIgInt ℓ)

