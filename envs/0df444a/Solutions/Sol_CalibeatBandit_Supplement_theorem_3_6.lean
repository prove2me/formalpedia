/-- A finite tape whose prefix is the first coordinate at each step. -/
@[reducible] def TrialTape (α : Type) : ℕ → Type u
  | 0 => ULift.{u} Unit
  | t + 1 => TrialTape α t × α

namespace TrialTape

instance measurableSpace {α : Type} [MeasurableSpace α] (t : ℕ) :
    MeasurableSpace (TrialTape.{u} α t) :=
  match t with
  | 0 => inferInstanceAs (MeasurableSpace (ULift.{u} Unit))
  | t + 1 => @MeasurableSpace.prod (TrialTape α t) α (measurableSpace t) inferInstance

instance finite {α : Type} [Finite α] (t : ℕ) : Finite (TrialTape.{u} α t) := by
  induction t with
  | zero => exact inferInstanceAs (Finite (ULift.{u} Unit))
  | succ t ih => let := ih; exact inferInstanceAs (Finite (TrialTape α t × α))

instance singletonClass {α : Type} [MeasurableSpace α] [MeasurableSingletonClass α] (t : ℕ) :
    MeasurableSingletonClass (TrialTape.{u} α t) := by
  induction t with
  | zero => exact inferInstanceAs (MeasurableSingletonClass (ULift.{u} Unit))
  | succ t ih =>
    let := ih
    exact inferInstanceAs (MeasurableSingletonClass (TrialTape α t × α))

noncomputable def law {α : Type} [MeasurableSpace α] (P : Measure α) :
    (t : ℕ) → Measure (TrialTape.{u} α t)
  | 0 => Measure.dirac (ULift.up ())
  | t + 1 => (law P t).prod P

instance probabilityLaw {α : Type} [MeasurableSpace α] (P : Measure α)
    [IsProbabilityMeasure P] (t : ℕ) : IsProbabilityMeasure (law.{u} P t) := by
  induction t with
  | zero => change IsProbabilityMeasure (Measure.dirac (ULift.up ())); infer_instance
  | succ t ih =>
    let := ih
    change IsProbabilityMeasure ((law P t).prod P)
    infer_instance

def take {α : Type} {n m : ℕ} (h : n ≤ m) : TrialTape.{u} α m → TrialTape α n :=
  Nat.leRec (motive := fun k _ => TrialTape α k → TrialTape α n) id
    (fun {_} _ p => p ∘ Prod.fst) h

@[simp] theorem take_refl {α : Type} (t : ℕ) : take.{u} (α := α) (le_refl t) = id := by
  simp [take]

@[simp] theorem take_succ {α : Type} {n m : ℕ} (h : n ≤ m) :
    take.{u} (α := α) (Nat.le_succ_of_le h) = take h ∘ Prod.fst :=
  Nat.leRec_succ _ _ h

theorem take_comp {α : Type} {n m k : ℕ} (hnm : n ≤ m) (hmk : m ≤ k) :
    take.{u} (α := α) hnm ∘ take hmk = take (hnm.trans hmk) := by
  induction hmk with
  | refl => simp
  | step h ih =>
    rw [take_succ h, take_succ (hnm.trans h)]
    exact congrArg (fun p => p ∘ Prod.fst) ih

theorem measurable_take {α : Type} [MeasurableSpace α] {n m : ℕ} (h : n ≤ m) :
    Measurable (take.{u} (α := α) h) := by
  induction h with
  | refl => rw [take_refl]; exact measurable_id
  | step h ih => rw [take_succ h]; exact ih.comp measurable_fst

theorem take_law {α : Type} [MeasurableSpace α] (P : Measure α) [IsProbabilityMeasure P]
    {n m : ℕ} (h : n ≤ m) : (law.{u} P m).map (take h) = law P n := by
  induction h with
  | refl => rw [take_refl, Measure.map_id]
  | step h ih =>
    rw [take_succ h]
    change ((law P _).prod P).map (take h ∘ Prod.fst) = _
    rw [← Measure.map_map (measurable_take h) measurable_fst, Measure.map_fst_prod,
      measure_univ, one_smul, ih]

def read {α : Type} {n : ℕ} (i : Fin n) (p : TrialTape.{u} α n) : α :=
  (take (Nat.succ_le_of_lt i.isLt) p).2

theorem measurable_read {α : Type} [MeasurableSpace α] {n : ℕ} (i : Fin n) :
    Measurable (read.{u} (α := α) i) := measurable_snd.comp (measurable_take _)

theorem read_take {α : Type} {n m : ℕ} (h : n ≤ m) (i : Fin n) (p : TrialTape.{u} α m) :
    read i (take h p) = read (Fin.castLE h i) p := by
  unfold read
  exact congrArg Prod.snd (congrFun (take_comp (Nat.succ_le_of_lt i.isLt) h) p)

@[simp] theorem read_last {α : Type} {n : ℕ} (p : TrialTape.{u} α (n + 1)) :
    read (Fin.last n) p = p.2 := by
  simp [read]

@[simp] theorem read_castSucc {α : Type} {n : ℕ} (i : Fin n)
    (p : TrialTape.{u} α (n + 1)) : read i.castSucc p = read i p.1 := by
  simp [read, Function.comp_apply]

/-- Information generated by the first `min t T` draws. -/
def filtration {α : Type} [MeasurableSpace α] (T : ℕ) :
    Filtration ℕ (measurableSpace.{u} (α := α) T) where
  seq t := MeasurableSpace.comap (take (min_le_right t T)) inferInstance
  mono' := by
    intro r s h
    have h' := min_le_min h (le_refl T)
    change MeasurableSpace.comap (take (min_le_right r T)) _ ≤
      MeasurableSpace.comap (take (min_le_right s T)) _
    rw [← take_comp h' (min_le_right s T), ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_take h').comap_le
  le' := fun t => (measurable_take (min_le_right t T)).comap_le

private theorem comap_take_congr {α : Type} [MeasurableSpace α] {T r s : ℕ}
    (he : r = s) (hr : r ≤ T) (hs : s ≤ T) :
    (measurableSpace.{u} (α := α) r).comap (take hr) =
      (measurableSpace.{u} (α := α) s).comap (take hs) := by
  subst s
  rfl

theorem filtration_eq {α : Type} [MeasurableSpace α] {T t : ℕ} (ht : t ≤ T) :
    filtration.{u} (α := α) T t = MeasurableSpace.comap (take ht) inferInstance := by
  change MeasurableSpace.comap (take (min_le_right t T)) _ = _
  exact comap_take_congr (min_eq_left ht) _ _

theorem measurable_step {α : Type} [MeasurableSpace α] {T t : ℕ} (ht : t < T)
    {β : Type*} [MeasurableSpace β] (f : TrialTape.{u} α (t + 1) → β) (hf : Measurable f) :
    Measurable[filtration (α := α) T (t + 1)] (f ∘ take (Nat.succ_le_of_lt ht)) := by
  rw [filtration_eq (Nat.succ_le_of_lt ht)]
  exact hf.comp (measurable_iff_comap_le.mpr le_rfl)

private theorem condExp_product_past {A B : Type*} [mA : MeasurableSpace A] [MeasurableSpace B]
    (μ : Measure A) (ν : Measure B) [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (f : A × B → ℝ) (hf : Measurable f) (hi : Integrable f (μ.prod ν)) :
    condExp (mA.comap (Prod.fst : A × B → A)) (μ.prod ν) f =ᵐ[μ.prod ν]
      fun p => ∫ b, f (p.1, b) ∂ν := by
  let g (a : A) := ∫ b, f (a, b) ∂ν
  have hm : Measurable g := hf.stronglyMeasurable.integral_prod_right'.measurable
  have hg : Integrable g μ := hi.integral_prod_left
  have hfst : Measurable[mA.comap (Prod.fst : A × B → A)] (Prod.fst : A × B → A) :=
    measurable_iff_comap_le.mpr le_rfl
  have hGi : Integrable (g ∘ Prod.fst) (μ.prod ν) := by
    have he : (μ.prod ν).map Prod.fst = μ := by rw [Measure.map_fst_prod, measure_univ, one_smul]
    have he' : Integrable g ((μ.prod ν).map Prod.fst) := by rw [he]; exact hg
    exact (integrable_map_measure hm.aestronglyMeasurable measurable_fst.aemeasurable).mp he'
  symm
  refine ae_eq_condExp_of_forall_setIntegral_eq measurable_fst.comap_le hi
    (fun _ _ _ => hGi.integrableOn) ?_ (hm.comp hfst).aestronglyMeasurable
  rintro s ⟨t, ht, rfl⟩ _
  have hset : (Prod.fst : A × B → A) ⁻¹' t = t ×ˢ (univ : Set B) := by ext p; simp
  change (∫ p in Prod.fst ⁻¹' t, (g ∘ Prod.fst) p ∂μ.prod ν) = ∫ p in Prod.fst ⁻¹' t, f p ∂μ.prod ν
  rw [hset, setIntegral_prod _ hGi.integrableOn, setIntegral_prod _ hi.integrableOn]
  simp only [Measure.restrict_univ]
  congr 1
  funext a
  change (∫ _ : B, g a ∂ν) = g a
  simp

