theorem GlobalTheory.DRFil.act_ext (ρ : Representation LL G V) (ρ' : Representation LL G V') (f : V →ₗ[LL] V')
    (hf : ∀ g v, f (ρ g v) = ρ' g (f v)) (g : G) (x : V ⊗[Qp] F) :
    actVdR PD ρ' g (ext Qp F f x) = ext Qp F f (actVdR PD ρ g x) := by sorry
