-- Source module: Solutions.R6CxNetEdge
/-!
# Merged frame changes for any number of address bits `m` (NC3, generic `m`)

`R6CxMerge.edgeStepsH` is stated for `m = h³` (through `NetComplexP8.EdgeP` on `Vc h`). Here the
same construction over `Fin m → ZMod 2` for any `m` (needed for `m = h² = 576`), with the edge
hypothesis `NetComplexP8.EdgeOK` (generic in `m`) and `NetComplexP8.edge_kernel`.

* `edgeStepsM w V U`: one merged chunk (row additions, one child of width `Fd V U`, row
  additions undone) on wire `w`;
* `edgeStepsM_den`: denotation `wireOp w (PhiK (qL V - qL U))`;
* `edgeStepsM_widths`: child widths `[Fd V U]` (none if `Fd V U = 0`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift NetComplexP8 NetComplexLabels

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {R : Type} [Fintype R] [DecidableEq R]

/-- Kernel list spec for an edge `U → V` over `Fin m`. -/
def KerSpecM (V U : Submodule (ZMod 2) (Fin m → ZMod 2)) (L : List (ℤ × (Fin m → ZMod 2))) : Prop :=
  (∀ p ∈ L, (p.1 = 1 ∨ p.1 = -1) ∧ p.2 ≠ 0) ∧ L.length = Fd V U ∧
    (∀ g, NetComplexInterface.PhiQ (qL V - qL U) g = L.foldr (fun p g' => NetComplexPhase.transK p.1 p.2 g') g) ∧
    ∃ B : Finset (Fin m → ZMod 2), NetComplexOrtho.Orthonormal2 B ∧ L.map Prod.snd = B.toList

/-- The orthonormal kernel list chosen for an edge. -/
noncomputable def kersM (V U : Submodule (ZMod 2) (Fin m → ZMod 2)) : List (ℤ × (Fin m → ZMod 2)) := by
  classical
  exact if hh : ∃ L, KerSpecM V U L then Classical.choose hh else []

/-- The merged frame change of an edge `U → V` on wire `w` (any `m`). -/
noncomputable def edgeStepsM (w : R) (V U : Submodule (ZMod 2) (Fin m → ZMod 2)) : List (HStep R m) :=
  mergedChunk w (kersM V U)

end IntMul.Kappa.R6.Cx

end

