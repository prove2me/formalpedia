/-! # Kerr–Newman BL: rational atoms and domains (ATLAS-IV-02)

Atoms (B3 class B notation wrappers): `Ui a r θ = 1/Σ` and `Wi θ = 1/sin θ` are reused unchanged from
`Atlas.Kerr.InAtoms` (same `Σ = r² + a² cos²θ`); `Di M a Q r = 1/Δ` is new. The derivative rules
below are the only analytic input of the generated tables.

Domains: `domReg M a Q = {Σ ≠ 0, Δ ≠ 0, sin θ ≠ 0}` (open, every real `M a Q`) and the target
`domKN M a Q = {r₊ < r, 0 < θ < π}`. On `domKN` with `0 < M`: `r > 0`, `Σ > 0`, `Δ > 0`,
`sin θ > 0`, hence `domKN ⊆ domReg`. Neither `a = 0` nor `Q = 0` is excluded; no point with
`Δ = 0` or `Σ = 0` lies in either set. -/

open Real

namespace ExactVacuumAtlas.EinsteinMaxwell.KN

open ExactVacuumAtlas.Kerr.In (Ui Wi)

/-! ## The regular set `domReg` -/

/-! ## The target domain `domKN` -/

theorem rPlus_ge (M a Q : ℝ) : M ≤ rPlus M a Q := by
  unfold rPlus; linarith [Real.sqrt_nonneg (M ^ 2 - a ^ 2 - Q ^ 2)]

theorem domKN_r_pos {M a Q : ℝ} (hM : 0 < M) {x : Pt 4} (hx : x ∈ domKN M a Q) : 0 < x 1 :=
  lt_of_lt_of_le hM (rPlus_ge M a Q) |>.trans hx.1

/-- `Δ > 0` on the exterior, for every real `M`, `a`, `Q` (no sub-extremality needed). -/
theorem domKN_Del_pos {M a Q : ℝ} {x : Pt 4} (hx : x ∈ domKN M a Q) :
    0 < Del M a Q (x 1) := by
  have hr : M + Real.sqrt (M ^ 2 - a ^ 2 - Q ^ 2) < x 1 := hx.1
  have hs := Real.sqrt_nonneg (M ^ 2 - a ^ 2 - Q ^ 2)
  have e : Del M a Q (x 1) = (x 1 - M) ^ 2 - (M ^ 2 - a ^ 2 - Q ^ 2) := by unfold Del; ring
  rw [e]
  rcases le_or_gt 0 (M ^ 2 - a ^ 2 - Q ^ 2) with h | h
  · have hsq := Real.sq_sqrt h
    nlinarith
  · nlinarith

theorem domKN_sin_pos {M a Q : ℝ} {x : Pt 4} (hx : x ∈ domKN M a Q) : 0 < sin (x 2) :=
  Real.sin_pos_of_pos_of_lt_pi hx.2.1 hx.2.2

theorem domKN_Sig_pos {M a Q : ℝ} (hM : 0 < M) {x : Pt 4} (hx : x ∈ domKN M a Q) :
    0 < Sig a (x 1) (x 2) := by
  have := domKN_r_pos hM hx
  unfold Sig; positivity

theorem domKN_subset_domReg {M a Q : ℝ} (hM : 0 < M) : domKN M a Q ⊆ domReg M a Q :=
  fun _ hx => ⟨(domKN_Sig_pos hM hx).ne', (domKN_Del_pos hx).ne', (domKN_sin_pos hx).ne'⟩

end ExactVacuumAtlas.EinsteinMaxwell.KN

