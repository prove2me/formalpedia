private structure CertWithSum where
  value : GramCertificate
  total : Int

private def checkedGram (c : CertWithSum) (bs : Frame) : Bool :=
  decide (0 < c.value.den) && c.value.terms.all (fun v => bs.contains v.1) &&
  (List.finRange 23).all (fun i => c.value.coord i == combination fastEntry c.value.terms i.val) &&
  (c.total == coordSum c.value.coord) && bs.all fun r =>
    decide (r < 1123) &&
      (9 * coordSum (fun i => fastEntry r i.val * c.value.coord i) - sumAt r * c.total ==
        (c.value.den : Int) * sumAt r)

private theorem checkedGram_sound (c : CertWithSum) (bs : Frame) (h : checkedGram c bs = true) :
    c.value.ok fastEntry bs = true := by
  simp only [checkedGram, GramCertificate.ok, Bool.and_eq_true, List.all_eq_true,
    beq_iff_eq, decide_eq_true_eq] at h ⊢
  obtain ⟨⟨⟨⟨hp,hm⟩,hv⟩,hs⟩,he⟩ := h
  refine ⟨⟨⟨hp,hm⟩,hv⟩,?_⟩
  intro r hr
  obtain ⟨hbound,hrow⟩ := he r hr
  have hsum := beq_iff_eq.mp (sumRangeAll r (Nat.zero_le _) (by simpa using hbound))
  simpa only [coordSum_eq, hsum, ← hs] using hrow

private def batchOK : List Frame → List CertWithSum → Bool
  | [], [] => true
  | b::bs, c::cs => checkedGram c b && batchOK bs cs
  | _, _ => false

private def Every (bs : Array Frame) : Prop :=
  ∀ b ∈ bs.toList, ∃ c : GramCertificate, c.ok fastEntry b = true

private theorem batch_sound : ∀ (bs : List Frame) (cs : List CertWithSum), batchOK bs cs = true →
    ∀ b ∈ bs, ∃ c : GramCertificate, c.ok fastEntry b = true
  | [], _, _, b, hb => by simp at hb
  | _ :: _, [], h, _, _ => by simp [batchOK] at h
  | b::bs, c::cs, h, x, hx => by
      have checks := Bool.and_eq_true_iff.mp h
      rcases List.mem_cons.mp hx with rfl | tail
      · exact ⟨c.value, checkedGram_sound c x checks.1⟩
      · exact batch_sound bs cs checks.2 x tail

private structure GramView where
  len : Nat
  pick : Nat → Frame
  sound : ∀ i, i < len → ∃ c : GramCertificate, c.ok fastEntry (pick i) = true

private def gramLeaf (xs : Array Frame) (n : Nat) (hs : xs.size=n) (h : Every xs) : GramView where
  len := n
  pick i := xs[i]?.getD []
  sound i hi := by
    have hxs : i < xs.size := by simpa only [hs] using hi
    apply h
    simp [Array.getElem?_eq_getElem hxs]

private def gramJoin (l r : GramView) (n : Nat) (hs : l.len+r.len=n) : GramView where
  len := n
  pick i := if i<l.len then l.pick i else r.pick (i-l.len)
  sound i hi := by
    split
    next hl => exact l.sound i hl
    next hl => exact r.sound (i-l.len) (by omega)

