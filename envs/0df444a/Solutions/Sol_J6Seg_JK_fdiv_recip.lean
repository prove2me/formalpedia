/-! ## Arithmetic -/

theorem fdiv_recip_sol_aux (P k : ℕ) (a pv : ℤ) (hpv : 0 < pv) (hN : |2 * (a * 2 ^ P) + pv| < 2 ^ k) :
    (2 * (a * 2 ^ P) + pv) * ivOf k pv / 2 ^ k +
      corr (2 * (a * 2 ^ P) + pv - (2 * (a * 2 ^ P) + pv) * ivOf k pv / 2 ^ k * (2 * pv))
        (2 * pv) = J6Seg.fdiv P a pv := by
  set N := 2 * (a * 2 ^ P) + pv with hNd
  set D := 2 * pv with hD
  have hD0 : 0 < D := by omega
  have hK0 : (0 : ℤ) < 2 ^ k := by positivity
  set iv := ivOf k pv with hiv
  have hivd : iv = 2 ^ k / D := rfl
  set q0 := N * iv / 2 ^ k with hq0
  have hq : J6Seg.fdiv P a pv = N / D := by
    simp only [J6Seg.fdiv, J6Seg.rq, hNd, hD]
  rw [hq]
  set q := N / D with hqd
  -- the reciprocal
  have i1 : D * iv ≤ 2 ^ k := by rw [hivd, mul_comm]; exact Int.ediv_mul_le _ hD0.ne'
  have i2 : 2 ^ k < D * (iv + 1) := by
    rw [hivd, mul_comm]; exact Int.lt_ediv_add_one_mul_self _ hD0
  set θ := 2 ^ k - D * iv with hθ
  have hθ0 : 0 ≤ θ := by omega
  have hθ1 : θ < D := by nlinarith
  -- the quotient by `2^k`
  have j1 : q0 * 2 ^ k ≤ N * iv := Int.ediv_mul_le _ hK0.ne'
  have j2 : N * iv < (q0 + 1) * 2 ^ k := Int.lt_ediv_add_one_mul_self _ hK0
  -- the exact quotient
  have k1 : q * D ≤ N := Int.ediv_mul_le _ hD0.ne'
  have k2 : N < (q + 1) * D := Int.lt_ediv_add_one_mul_self _ hD0
  -- |N| θ < 2^k D
  have hNθ : |N| * θ < 2 ^ k * D := by
    have h1 : |N| * θ ≤ |N| * D := mul_le_mul_of_nonneg_left hθ1.le (abs_nonneg _)
    have h2 : |N| * D < 2 ^ k * D := mul_lt_mul_of_pos_right hN hD0
    linarith
  have hNθ' : -(2 ^ k * D) < N * θ ∧ N * θ < 2 ^ k * D := by
    have := abs_mul N θ
    rw [abs_of_nonneg hθ0] at this
    have h := abs_lt.1 (show |N * θ| < 2 ^ k * D by rw [this]; exact hNθ)
    exact ⟨h.1, h.2⟩
  -- N * iv * D = N * 2^k - N θ
  have e1 : N * iv * D = N * 2 ^ k - N * θ := by rw [hθ]; ring
  have u1 : q0 * D < N + D := by
    have : q0 * 2 ^ k * D ≤ N * iv * D := mul_le_mul_of_nonneg_right j1 hD0.le
    have h3 : (q0 * D - N) * 2 ^ k < D * 2 ^ k := by nlinarith
    have := lt_of_mul_lt_mul_right h3 hK0.le
    linarith
  have u2 : N < (q0 + 2) * D := by
    have : N * iv * D < (q0 + 1) * 2 ^ k * D := mul_lt_mul_of_pos_right j2 hD0
    have h3 : (N - (q0 + 1) * D) * 2 ^ k < D * 2 ^ k := by nlinarith
    have := lt_of_mul_lt_mul_right h3 hK0.le
    linarith
  have lo : q - 1 ≤ q0 := by
    by_contra hc
    have : q0 + 2 ≤ q := by omega
    have : (q0 + 2) * D ≤ q * D := mul_le_mul_of_nonneg_right this hD0.le
    linarith
  have hi : q0 ≤ q + 1 := by
    by_contra hc
    have : q + 2 ≤ q0 := by omega
    have : (q + 2) * D ≤ q0 * D := mul_le_mul_of_nonneg_right this hD0.le
    linarith
  have cases : q0 = q - 1 ∨ q0 = q ∨ q0 = q + 1 := by omega
  unfold corr
  rcases cases with h | h | h
  · rw [h]
    have c1 : ¬ (N - (q - 1) * D < 0) := by nlinarith
    have c2 : ¬ (N - (q - 1) * D - D < 0) := by nlinarith
    rw [if_neg c1, if_neg c2]; ring
  · rw [h]
    have c1 : ¬ (N - q * D < 0) := by nlinarith
    have c2 : N - q * D - D < 0 := by nlinarith
    rw [if_neg c1, if_pos c2]; ring
  · rw [h]
    have c1 : N - (q + 1) * D < 0 := by nlinarith
    rw [if_pos c1]; ring

