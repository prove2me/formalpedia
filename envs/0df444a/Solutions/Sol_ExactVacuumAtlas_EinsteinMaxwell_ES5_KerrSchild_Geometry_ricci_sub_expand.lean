variable {Γ Γb : Fin 5 → Fin 5 → Fin 5 → Pt 5 → ℝ} {K : Pt 5 → Fin 5 → ℝ} {U : Set (Pt 5)}
  {x : Pt 5}
theorem solution (hΓ : ∀ a p q, DifferentiableAt ℝ (Γ a p q) x)
    (hΓb : ∀ a p q, DifferentiableAt ℝ (Γb a p q) x) (p q : Fin 5) :
    ricci Γ p q x = ricci Γb p q x + ∑ i, pd i (cdiffOf Γ Γb i p q) x
      - ∑ i, pd q (cdiffOf Γ Γb i p i) x + ∑ i, ∑ j, qTerm Γb (cdiffOf Γ Γb) x p q i j := by
  have hv : ∀ a b c, Γ a b c x = Γb a b c x + cdiffOf Γ Γb a b c x := fun a b c => by
    simp only [cdiffOf]; ring
  have hp : ∀ i a b c, pd i (Γ a b c) x = pd i (Γb a b c) x + pd i (cdiffOf Γ Γb a b c) x :=
    fun i a b c => by
      have e : cdiffOf Γ Γb a b c = fun y => Γ a b c y - Γb a b c y := rfl
      rw [e, pd_sub_at i (hΓ a b c) (hΓb a b c)]
      ring
  unfold ricci
  simp only [hv, hp]
  simp only [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  have e : ∑ j, ((Γb i i j x + cdiffOf Γ Γb i i j x) * (Γb j p q x + cdiffOf Γ Γb j p q x)
      - (Γb i q j x + cdiffOf Γ Γb i q j x) * (Γb j p i x + cdiffOf Γ Γb j p i x)) =
      ∑ j, (Γb i i j x * Γb j p q x - Γb i q j x * Γb j p i x)
        + ∑ j, qTerm Γb (cdiffOf Γ Γb) x p q i j := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun j _ => by unfold qTerm; ring
  rw [e]
  ring
