  have e₂ := hv_q m B hB' (ψ', P)
  rw [hcoeff m B hB' ψ ψ' P hψ] at e₁
  exact (e₁.symm.trans e₂ : (Θ B ⟨m + 1, hB'⟩ (ψ, P)).1 = (Θ B ⟨m + 1, hB'⟩ (ψ', P)).1)

