-- Source module: Solutions.KFCBase
/-!
# KFC base: fine-cost item-language loops

Item-language (`IStmt`) building blocks whose per-element cost is `O(1 + zsz a)` for the moved
entry `a`, with **no** binary loop counter per element:

* `mvW X Y`   : move integers from `X` to `Y` until the top of `X` is not an integer
                (delimiter-driven, cost `(76 w + 131)` per entry of bit size `≤ w`);
* `uloop C D b`: run `b` once per mark on the *unary counter* `C` (the marks are moved to `D`
                and then moved back, so the counter is restored); overhead `64` per iteration;
* `mvB X Y C D`: move exactly `n` integers, `n` = number of marks on `C`;
* `toU A X K K2`: push `n` marks on `X`, where `n ≥ 0` is the integer on top of `A`
                (binary counter, cost `O((n+1)(zsz n + 2))`; superseded by the linear
                `KFCUnary.toUL`, which the programs use);
* `clrM X`    : drop all marks on top of `X`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Classes and item lists -/

theorem marks_succ (n : ℕ) : marks (n + 1) = .mark :: marks n := rfl

theorem isMk_marks_succ (n : ℕ) (L : List Item) : isMk (cls (marks (n + 1) ++ L).head?) = true := by
  simp [marks, List.replicate_succ, isMk, cls]

theorem isMk_NM {L : List Item} (h : NM L) : isMk (cls L.head?) = false := by
  unfold NM at h; unfold isMk
  rcases L with _ | ⟨x, L⟩
  · simp [cls]
  · rcases x with a | _
    · simp only [List.head?_cons, cls]; split_ifs <;> simp
    · simp at h

/-! ## `mvW`: move integers until a delimiter -/

/-! ## Unary counted loops -/

theorem uloop_runs_sol_aux {C D : Fin HS} (hCD : C ≠ D) (n : ℕ) (T : ℕ → IState HS) (LC LD : List Item)
    (hLC : NM LC) (hLD : NM LD) (c : ℕ) (b : IStmt HS Pp)
    (hb : ∀ k < n, ∀ LC' LD', IRuns I iprog b (cf (T k) C D LC' LD') (cf (T (k + 1)) C D LC' LD') c) :
    IRuns I iprog (uloop C D b) (cf (T 0) C D (marks n ++ LC) LD)
      (cf (T n) C D (marks n ++ LC) LD) (n * (c + 64) + 60) := by
  -- first loop
  let ss : ℕ → IState HS := fun k => cf (T k) C D (marks (n - k) ++ LC) (marks k ++ LD)
  have h1 := IRuns.loop' (I := I) (iprog := iprog) (i := C) (f := isMk)
    (p := .seq (.op (.unmark C)) (.seq (.op (.mark D)) b)) ss (c + 2) n
    (by
      intro k hk
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      simp only [ss, cf, IState.cl_def, IState.upd_G, if_neg hCD, if_true, hj]
      exact isMk_marks_succ _ _)
    (by
      simp only [ss, cf, IState.cl_def, IState.upd_G, if_neg hCD, if_true, Nat.sub_self,
        marks_zero, List.nil_append]
      exact isMk_NM hLC)
    (by
      intro k hk
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      have hj' : n - (k + 1) = j := by omega
      have u1 := IRuns.unmark (I := I) (iprog := iprog) (s := ss k) (i := C)
        (L := marks j ++ LC) (by simp [ss, cf, hCD, hj, marks_succ])
      have u2 := IRuns.mark (I := I) (iprog := iprog) (s := (ss k).upd C (marks j ++ LC)) D
      have u3 := hb k hk (marks j ++ LC) (marks (k + 1) ++ LD)
      have e : ((ss k).upd C (marks j ++ LC)).upd D (.mark :: ((ss k).upd C (marks j ++ LC)).G D)
          = cf (T k) C D (marks j ++ LC) (marks (k + 1) ++ LD) := by
        simp only [ss, cf]
        apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
          split_ifs <;> simp_all [marks_succ]
      rw [e] at u2
      refine (u1.seq (u2.seq u3)).mono' ?_ (by omega)
      simp only [ss, hj'])
  -- second loop
  let tt : ℕ → IState HS := fun k => cf (T n) C D (marks k ++ LC) (marks (n - k) ++ LD)
  have h2 := IRuns.loop' (I := I) (iprog := iprog) (i := D) (f := isMk)
    (p := .seq (.op (.unmark D)) (.op (.mark C))) tt 2 n
    (by
      intro k hk
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      simp only [tt, cf, IState.cl_def, IState.upd_G, if_true, hj]
      exact isMk_marks_succ _ _)
    (by
      simp only [tt, cf, IState.cl_def, IState.upd_G, if_true, Nat.sub_self,
        marks_zero, List.nil_append]
      exact isMk_NM hLD)
    (by
      intro k hk
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      have hj' : n - (k + 1) = j := by omega
      have u1 := IRuns.unmark (I := I) (iprog := iprog) (s := tt k) (i := D)
        (L := marks j ++ LD) (by simp [tt, cf, hj, marks_succ])
      have u2 := IRuns.mark (I := I) (iprog := iprog) (s := (tt k).upd D (marks j ++ LD)) C
      refine (u1.seq u2).mono' ?_ le_rfl
      simp only [tt, cf, hj']
      apply IState.ext' <;> intros <;> simp only [IState.upd_G, IState.upd_ip, IState.upd_out] <;>
        split_ifs <;> simp_all [marks_succ])
  have e0 : ss 0 = cf (T 0) C D (marks n ++ LC) LD := by simp [ss]
  have e1 : ss n = tt 0 := by simp [ss, tt]
  have e2 : tt n = cf (T n) C D (marks n ++ LC) LD := by simp [tt]
  rw [e0, e1] at h1
  rw [e2] at h2
  refine (h1.seq h2).mono ?_
  nlinarith

