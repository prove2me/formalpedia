    (hvalb : ∀ x ∈ Ioo (0:ℝ) δ, |b x - (1 + b₁ * x)| ≤ C_b * x ^ 2)
    (hvalA : ∀ x ∈ Ioo (0:ℝ) δ, |A x - a₁ * x| ≤ C_A * x ^ 2)
