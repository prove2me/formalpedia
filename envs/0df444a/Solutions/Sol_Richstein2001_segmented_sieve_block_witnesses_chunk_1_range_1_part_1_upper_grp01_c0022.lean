/-- the factor pools: `k!` with `k` below the tier and `(k + 1) ^ 2` above it, then `PR` -/
def fpool (f : ℕ) : ℕ :=
  cond (Nat.blt f 9) (Nat.factorial 2) (cond (Nat.blt f 81) (Nat.factorial 8)
    (cond (Nat.blt f 6561) (Nat.factorial 80) (cond (Nat.blt f 31684) (Nat.factorial 177) PR)))

/-- `f` is prime: `f = 2`, or `2 ≤ f < 31623 ^ 2` and `f` is coprime to its tier's pool -/
def fOK (f : ℕ) : Bool :=
  Nat.beq f 2 || (Nat.ble 2 f && Nat.ble f 1000014128 && Nat.beq (Nat.gcd f (fpool f)) 1)

theorem fOK_prime (f : ℕ) (h : fOK f = true) : f.Prime := by
  unfold fOK at h
  rw [Bool.or_eq_true] at h
  rcases h with h | h
  · rw [Nat.eq_of_beq_eq_true h]
    exact Nat.prime_two
  · simp only [Bool.and_eq_true] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    have h1' := Nat.le_of_ble_eq_true h1
    have h2' := Nat.le_of_ble_eq_true h2
    have h3' := Nat.eq_of_beq_eq_true h3
    unfold fpool at h3'
    by_cases c1 : f < 9
    · rw [blt_t c1, cond_true] at h3'
      exact prime_of_coprime_fact 2 8 f (by norm_num) h1' (by omega) h3'
    rw [blt_f c1, cond_false] at h3'
    by_cases c2 : f < 81
    · rw [blt_t c2, cond_true] at h3'
      exact prime_of_coprime_fact 8 80 f (by norm_num) h1' (by omega) h3'
    rw [blt_f c2, cond_false] at h3'
    by_cases c3 : f < 6561
    · rw [blt_t c3, cond_true] at h3'
      exact prime_of_coprime_fact 80 6560 f (by norm_num) h1' (by omega) h3'
    rw [blt_f c3, cond_false] at h3'
    by_cases c4 : f < 31684
    · rw [blt_t c4, cond_true] at h3'
      exact prime_of_coprime_fact 177 31683 f (by norm_num) h1' (by omega) h3'
