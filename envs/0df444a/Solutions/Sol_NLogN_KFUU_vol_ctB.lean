open IntMul KIL KFB KFC KFT KFU AModel AModelL12
theorem solution (u cz : ℕ) (bs : List Bool) (hcz : 1 ≤ cz) :
    (2 ^ u) ^ bs.length * AModel.vol (NLogN.KFUU.ctB u cz bs) = AModel.vol (NLogN.KFUU.shP u bs) := by
  have h := NLogN.KFUU.vol_lay1 (u := u) (cz := cz) (bs := bs) 0
  rw [NLogN.KFUU.shape_lay0, AModel.vol_append, AModel.vol_append] at h
  simp only [AModel.vol_cons, AModel.vol_nil, mul_one] at h
  have hr : AModel.vol (List.replicate bs.length (2 ^ u)) = (2 ^ u) ^ bs.length := by
    simp [AModel.vol, List.prod_replicate]
  rw [hr] at h
  exact Nat.eq_of_mul_eq_mul_right hcz
    (by rw [← h]; ring : (2 ^ u) ^ bs.length * vol (ctB u cz bs) * cz = vol (shP u bs) * cz)
end
