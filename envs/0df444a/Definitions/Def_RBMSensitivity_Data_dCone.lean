-- title:
--   The cone $d(\alpha,x)$ of admissible directions
-- statement:
--   For $\alpha\in U$ and $x\in\partial G$,
--   $$d(\alpha,x):=\mathrm{cone}(\{d_i(\alpha),i\in\mathcal I(x)\})$$
--   is the cone generated by the admissible directions of reflection at $x$, and $d(\alpha,x):=\{0\}$ for $x\in G^\circ$. Here $\mathrm{cone}(E)$ is the set of finite nonnegative combinations of elements of $E$, with $\mathrm{cone}(\emptyset):=\{0\}$.
--
--   The RBM may be pushed only in directions of this cone.
-- source:
--   Lipshutz, Ramanan, Sensitivity analysis for the stationary distribution of RBM, arXiv:1907.00472v2, https://arxiv.org/abs/1907.00472v2, §2.1, (2.2), p.5

import Mathlib
import Definitions.Def_RBMSensitivity_Data
import Definitions.Def_RBMSensitivity_SimpleCone_I
open MeasureTheory ProbabilityTheory Filter Topology
open scoped NNReal ENNReal RealInnerProductSpace

namespace RBMSensitivity

/-- The cone `d(α, x) := cone({d_i(α), i ∈ I(x)})` of (2.2): arXiv:1907.00472v2, §2.1, p.5, with
`d(α, x) := {0}` for `x ∈ G°`.

**Formalization Note.** `PointedCone.hull` is the set of finite nonnegative combinations, and the hull
of `∅` is `{0}`, which is the convention of p.4 and gives the interior case at once. -/
def Data.dCone {J : ℕ} (D : Data J) (α : ℝ) (x : E J) : PointedCone ℝ (E J) :=
  PointedCone.hull ℝ ((fun i => D.d i α) '' D.I x)

end RBMSensitivity


