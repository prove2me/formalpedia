lemma negAll : ∀ c ∈ Set.Icc (1 / 200 : ℝ) (1 / 20), F c < 0 := by
  have := chain_sound (fun c => F c < 0) Box.okNeg Box.sound_neg negBoxes (1 / 200) (1 / 20)
    (by decide +kernel)
  simpa using this

lemma posAll : ∀ c ∈ Set.Icc (3 / 40 : ℝ) (5 / 36), 0 < F c := by
  have := chain_sound (fun c => 0 < F c) Box.okPos Box.sound_pos posBoxes (3 / 40) (5 / 36)
    (by decide +kernel)
  simpa using this

lemma dAll : ∀ c ∈ Set.Icc (1 / 20 : ℝ) (3 / 40), 0 < Fd c := by
  have := chain_sound (fun c => 0 < Fd c) Box.okD Box.sound_d dBoxes (1 / 20) (3 / 40)
    (by decide +kernel)
  simpa using this

lemma F_mono : StrictMonoOn F (Set.Icc (1 / 20 : ℝ) (3 / 40)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
  · intro x hx
    exact (F_deriv x (by linarith [hx.1])).continuousAt.continuousWithinAt
  · intro x hx
    rw [interior_Icc] at hx
    rw [(F_deriv x (by linarith [hx.1])).deriv]
    exact dAll x ⟨hx.1.le, hx.2.le⟩

lemma F_cont : ContinuousOn F (Set.Icc (1 / 20 : ℝ) (3 / 40)) := fun x hx =>
  (F_deriv x (by linarith [hx.1])).continuousAt.continuousWithinAt

lemma cutoff : ∃ cl : ℝ, 0 < cl ∧ cl < 5 / 36 ∧ ∀ c : ℝ, 0 < c → c < 5 / 36 →
    (cl < c → 0 < F c) ∧ (c < cl → F c < 0) := by
  have hA : F (1 / 20) < 0 := negAll _ ⟨by norm_num, le_refl _⟩
  have hB : 0 < F (3 / 40) := posAll _ ⟨le_refl _, by norm_num⟩
  obtain ⟨cl, ⟨hcl1, hcl2⟩, hFcl⟩ :=
    intermediate_value_Icc (by norm_num : (1 / 20 : ℝ) ≤ 3 / 40) F_cont ⟨hA.le, hB.le⟩
  refine ⟨cl, by linarith, by linarith, fun c hc0 hc1 => ⟨fun h => ?_, fun h => ?_⟩⟩
  · rcases le_total (3 / 40) c with h' | h'
    · exact posAll c ⟨h', hc1.le⟩
    · have := F_mono ⟨hcl1, hcl2⟩ ⟨by linarith, h'⟩ h
      linarith
  · rcases le_total c (1 / 200) with h' | h'
    · exact near_zero c hc0 h'
    rcases le_total c (1 / 20) with h'' | h''
    · exact negAll c ⟨h', h''⟩
    · have := F_mono ⟨h'', by linarith⟩ ⟨hcl1, hcl2⟩ h
      linarith

end BBD3aAux

open BBDisclosure.Total

theorem solution :
    ∃ cl : ℝ, 0 < cl ∧ cl < 5 / 36 ∧
      ∀ c : ℝ, 0 < c → c < 5 / 36 →
        (∃ s : SPE_U, IsSymSPE_U c s) ∧ (∃ s : SPE_BBD, IsSymSPE_BBD c s) ∧
        ∀ (sU : SPE_U) (sB : SPE_BBD), IsSymSPE_U c sU → IsSymSPE_BBD c sB →
          (cl < c → totalA_U c sU < totalA_BBD c sB ∧ totalB_U c sU < totalB_BBD c sB) ∧
          (c < cl → totalA_BBD c sB < totalA_U c sU ∧ totalB_BBD c sB < totalB_U c sU) := by
  obtain ⟨cl, h0, h1, hcl⟩ := BBD3aAux.cutoff
  refine ⟨cl, h0, h1, fun c hc0 hc1 => ⟨(equation_9 c hc0 hc1).1, (equation_17 c hc0 hc1).1,
    fun sU sB hU hB => ?_⟩⟩
  obtain ⟨hUA, hUB⟩ := (table_1_total_profits c hc0 hc1).1 sU hU
  obtain ⟨hBA, hBB⟩ := (table_1_total_profits c hc0 hc1).2 sB hB
  have key : ((730 - 891 * c) / 729
          - (1 + 24 * c + 117 * c ^ 2) / (27 * Real.sqrt (1 + 12 * c))
          - (1 - 594 * c - 29889 * c ^ 2) / (729 * Real.sqrt (1 + 108 * c)))
        - ((718 - 1134 * c) / 729
          - (16 - 189 * c - 10206 * c ^ 2) / (729 * Real.sqrt (1 + 27 * c)))
        = BBD3aAux.F c / 729 := by
    unfold BBD3aAux.F; ring
  rw [hUA, hUB, hBA, hBB]
  obtain ⟨k1, k2⟩ := hcl c hc0 hc1
  refine ⟨fun h => ?_, fun h => ?_⟩
  · have := k1 h
    constructor <;> linarith
  · have := k2 h
    constructor <;> linarith
