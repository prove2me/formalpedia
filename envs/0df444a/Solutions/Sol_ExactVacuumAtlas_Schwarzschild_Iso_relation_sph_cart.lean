open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.Iso

@[simp] theorem fromCart_0 (y : Pt 4) : fromCart y 0 = y 0 := rfl
@[simp] theorem fromCart_1 (y : Pt 4) : fromCart y 1 = rho y := rfl
@[simp] theorem fromCart_2 (y : Pt 4) : fromCart y 2 = Real.arccos (y 3 / rho y) := rfl
@[simp] theorem fromCart_3 (y : Pt 4) : fromCart y 3 = 2 * Real.arctan (y 2 / (rxy y + y 1)) := rfl

/-! ### Elementary facts about `rho`, `rxy` -/

theorem rxy_nonneg (y : Pt 4) : 0 ≤ rxy y := Real.sqrt_nonneg _
theorem rho_nonneg (y : Pt 4) : 0 ≤ rho y := Real.sqrt_nonneg _
theorem sq_rxy (y : Pt 4) : rxy y ^ 2 = y 1 ^ 2 + y 2 ^ 2 := Real.sq_sqrt (by positivity)
theorem sq_rho (y : Pt 4) : rho y ^ 2 = y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2 := Real.sq_sqrt (by positivity)

theorem continuous_rho : Continuous rho := by unfold rho; fun_prop
theorem continuous_rxy : Continuous rxy := by unfold rxy; fun_prop

theorem isOpen_domCartSlit (M : ℝ) : IsOpen (domCartSlit M) := by
  have h1 : IsOpen {y : Pt 4 | 0 < rho y} := isOpen_lt continuous_const continuous_rho
  have h2 : IsOpen {y : Pt 4 | rho y ≠ M / 2} := isOpen_ne_fun continuous_rho continuous_const
  have h3 : IsOpen {y : Pt 4 | 0 < rxy y + y 1} :=
    isOpen_lt continuous_const (continuous_rxy.add (continuous_apply 1))
  exact h1.inter (h2.inter h3)

theorem isOpen_domIsoChart (M : ℝ) : IsOpen (domIsoChart M) := by
  have h1 : IsOpen {x : Pt 4 | -π < x 3} := isOpen_lt continuous_const (continuous_apply 3)
  have h2 : IsOpen {x : Pt 4 | x 3 < π} := isOpen_lt (continuous_apply 3) continuous_const
  exact (isOpen_domIso M).inter (h1.inter h2)

variable {M : ℝ}

theorem rxy_pos_of_mem {y : Pt 4} (hy : y ∈ domCartSlit M) : 0 < rxy y := by
  rcases (rxy_nonneg y).lt_or_eq with h | h
  · exact h
  · exfalso
    have h0 : y 1 ^ 2 + y 2 ^ 2 = 0 := by rw [← sq_rxy y, ← h]; ring
    have h1 : y 1 = 0 := by nlinarith [sq_nonneg (y 1), sq_nonneg (y 2)]
    have := hy.2.2
    rw [← h, h1] at this
    linarith

theorem z_div_rho_bounds {y : Pt 4} (hy : y ∈ domCartSlit M) :
    -1 < y 3 / rho y ∧ y 3 / rho y < 1 := by
  have hρ := hy.1
  have hr := rxy_pos_of_mem hy
  have h : y 3 ^ 2 < rho y ^ 2 := by
    rw [sq_rho]
    have := sq_rxy y
    nlinarith
  obtain ⟨ha, hb⟩ := abs_lt_of_sq_lt_sq' h hρ.le
  constructor
  · rw [lt_div_iff₀ hρ]; linarith
  · rw [div_lt_one hρ]; exact hb

theorem fromCart_mem {y : Pt 4} (hy : y ∈ domCartSlit M) : fromCart y ∈ domIsoChart M := by
  obtain ⟨h1, h2⟩ := z_div_rho_bounds hy
  refine ⟨⟨hy.1, hy.2.1, Real.arccos_pos.mpr h2, Real.arccos_lt_pi.mpr h1⟩, ?_, ?_⟩
  · show -π < 2 * Real.arctan (y 2 / (rxy y + y 1))
    have := Real.neg_pi_div_two_lt_arctan (y 2 / (rxy y + y 1)); linarith
  · show 2 * Real.arctan (y 2 / (rxy y + y 1)) < π
    have := Real.arctan_lt_pi_div_two (y 2 / (rxy y + y 1)); linarith

theorem one_add_cos_pos {φ : ℝ} (h1 : -π < φ) (h2 : φ < π) : 0 < 1 + cos φ := by
  have h := Real.cos_half (by linarith : -π ≤ φ) (by linarith : φ ≤ π)
  have hpos : 0 < cos (φ / 2) := Real.cos_pos_of_mem_Ioo ⟨by linarith, by linarith⟩
  rw [h] at hpos
  have := Real.sqrt_pos.mp hpos
  linarith

theorem toCart_mem {x : Pt 4} (hx : x ∈ domIsoChart M) : toCart x ∈ domCartSlit M := by
  have hρ := hx.1.1
  have hθ := Real.sin_pos_of_pos_of_lt_pi hx.1.2.2.1 hx.1.2.2.2
  refine ⟨?_, ?_, ?_⟩
  · rw [rho_toCart hρ]; exact hρ
  · rw [rho_toCart hρ]; exact hx.1.2.1
  · rw [rxy_toCart hρ hθ, toCart_1]
    have hc := one_add_cos_pos hx.2.1 hx.2.2
    have e : x 1 * sin (x 2) + x 1 * sin (x 2) * cos (x 3) = x 1 * sin (x 2) * (1 + cos (x 3)) := by ring
    rw [e]; exact mul_pos (mul_pos hρ hθ) hc

/-! ### Mutual inverses -/

theorem fromCart_toCart {x : Pt 4} (hx : x ∈ domIsoChart M) : fromCart (toCart x) = x := by
  have hρ := hx.1.1
  have hθ := Real.sin_pos_of_pos_of_lt_pi hx.1.2.2.1 hx.1.2.2.2
  ext i; fin_cases i
  · rfl
  · show rho (toCart x) = x 1
    exact rho_toCart hρ
  · show Real.arccos (toCart x 3 / rho (toCart x)) = x 2
    rw [rho_toCart hρ, toCart_3, mul_div_cancel_left₀ _ hρ.ne']
    exact Real.arccos_cos hx.1.2.2.1.le hx.1.2.2.2.le
  · show 2 * Real.arctan (toCart x 2 / (rxy (toCart x) + toCart x 1)) = x 3
    rw [rxy_toCart hρ hθ, toCart_2, toCart_1]
    have hc : 0 < cos (x 3 / 2) := Real.cos_pos_of_mem_Ioo ⟨by linarith [hx.2.1], by linarith [hx.2.2]⟩
    have hs : sin (x 3) = 2 * sin (x 3 / 2) * cos (x 3 / 2) := by
      have := Real.sin_two_mul (x 3 / 2); rw [show 2 * (x 3 / 2) = x 3 by ring] at this; exact this
    have hcc : cos (x 3) = 2 * cos (x 3 / 2) ^ 2 - 1 := by
      have := Real.cos_two_mul (x 3 / 2); rw [show 2 * (x 3 / 2) = x 3 by ring] at this; exact this
    have e : x 1 * sin (x 2) * sin (x 3) / (x 1 * sin (x 2) + x 1 * sin (x 2) * cos (x 3))
        = tan (x 3 / 2) := by
      rw [Real.tan_eq_sin_div_cos, hs, hcc]
      have hden : x 1 * sin (x 2) + x 1 * sin (x 2) * (2 * cos (x 3 / 2) ^ 2 - 1)
          = 2 * x 1 * sin (x 2) * cos (x 3 / 2) ^ 2 := by ring
      rw [hden]
      field_simp
      try ring
    rw [e, Real.arctan_tan (by linarith [hx.2.1]) (by linarith [hx.2.2])]
    ring

theorem sin_arccos_z {y : Pt 4} (hy : y ∈ domCartSlit M) :
    sin (Real.arccos (y 3 / rho y)) = rxy y / rho y := by
  have hρ := hy.1
  rw [Real.sin_arccos]
  have hpos : 0 < y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2 := by rw [← sq_rho]; positivity
  have e : 1 - (y 3 / rho y) ^ 2 = (rxy y / rho y) ^ 2 := by
    rw [div_pow, div_pow, sq_rxy, sq_rho, one_sub_div hpos.ne']
    congr 1; ring
  rw [e]
  exact Real.sqrt_sq (div_nonneg (rxy_nonneg y) (rho_nonneg y))

theorem one_add_u_sq {y : Pt 4} (hy : y ∈ domCartSlit M) :
    1 + (y 2 / (rxy y + y 1)) ^ 2 = 2 * rxy y / (rxy y + y 1) := by
  have hd : rxy y + y 1 ≠ 0 := hy.2.2.ne'
  rw [div_pow, eq_div_iff hd]
  field_simp
  nlinarith [sq_rxy y]

theorem cos_two_arctan_u {y : Pt 4} (hy : y ∈ domCartSlit M) :
    cos (2 * Real.arctan (y 2 / (rxy y + y 1))) = y 1 / rxy y := by
  have hd : 0 < rxy y + y 1 := hy.2.2
  have hr := rxy_pos_of_mem hy
  rw [Real.cos_two_mul, Real.cos_arctan, div_pow, one_pow, Real.sq_sqrt (by positivity),
    one_add_u_sq hy]
  field_simp
  ring

theorem sin_two_arctan_u {y : Pt 4} (hy : y ∈ domCartSlit M) :
    sin (2 * Real.arctan (y 2 / (rxy y + y 1))) = y 2 / rxy y := by
  have hd : 0 < rxy y + y 1 := hy.2.2
  have hr := rxy_pos_of_mem hy
  have hsq := Real.mul_self_sqrt (show (0 : ℝ) ≤ 1 + (y 2 / (rxy y + y 1)) ^ 2 by positivity)
  rw [Real.sin_two_mul, Real.sin_arctan, Real.cos_arctan]
  have e : 2 * (y 2 / (rxy y + y 1) / √(1 + (y 2 / (rxy y + y 1)) ^ 2))
      * (1 / √(1 + (y 2 / (rxy y + y 1)) ^ 2))
      = 2 * (y 2 / (rxy y + y 1)) / (√(1 + (y 2 / (rxy y + y 1)) ^ 2) * √(1 + (y 2 / (rxy y + y 1)) ^ 2)) := by
    field_simp
  rw [e, hsq, one_add_u_sq hy]
  field_simp
  try ring

theorem toCart_fromCart {y : Pt 4} (hy : y ∈ domCartSlit M) : toCart (fromCart y) = y := by
  have hρ := hy.1
  have hr := rxy_pos_of_mem hy
  obtain ⟨h1, h2⟩ := z_div_rho_bounds hy
  ext i; fin_cases i
  · rfl
  · show rho y * sin (Real.arccos (y 3 / rho y)) * cos (2 * Real.arctan (y 2 / (rxy y + y 1))) = y 1
    rw [sin_arccos_z hy, cos_two_arctan_u hy]
    field_simp
  · show rho y * sin (Real.arccos (y 3 / rho y)) * sin (2 * Real.arctan (y 2 / (rxy y + y 1))) = y 2
    rw [sin_arccos_z hy, sin_two_arctan_u hy]
    field_simp
  · show rho y * cos (Real.arccos (y 3 / rho y)) = y 3
    rw [Real.cos_arccos h1.le h2.le]
    field_simp

/-! ### Smoothness of the inverse map -/

theorem contDiffOn_rho {U : Set (Pt 4)} (hU : ∀ y ∈ U, 0 < rho y) : ContDiffOn ℝ ∞ rho U :=
  ContDiffOn.sqrt (by fun_prop) fun y hy => (Real.sqrt_pos.mp (hU y hy)).ne'

theorem contDiffOn_rxy {U : Set (Pt 4)} (hU : ∀ y ∈ U, 0 < rxy y) : ContDiffOn ℝ ∞ rxy U :=
  ContDiffOn.sqrt (by fun_prop) fun y hy => (Real.sqrt_pos.mp (hU y hy)).ne'

theorem contDiffOn_fromCart (M : ℝ) : ContDiffOn ℝ ∞ fromCart (domCartSlit M) := by
  have hρ : ContDiffOn ℝ ∞ rho (domCartSlit M) := contDiffOn_rho fun y hy => hy.1
  have hr : ContDiffOn ℝ ∞ rxy (domCartSlit M) := contDiffOn_rxy fun y hy => rxy_pos_of_mem hy
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, fromCart_0,
    fromCart_1, fromCart_2, fromCart_3]
  · fun_prop
  · exact hρ
  · intro y hy
    obtain ⟨h1, h2⟩ := z_div_rho_bounds hy
    have hd : ContDiffAt ℝ ∞ (fun y : Pt 4 => y 3 / rho y) y :=
      ContDiffAt.div (by fun_prop) (hρ.contDiffAt ((isOpen_domCartSlit M).mem_nhds hy)) hy.1.ne'
    exact ((Real.contDiffAt_arccos h1.ne' h2.ne).comp y hd).contDiffWithinAt
  · refine contDiffOn_const.mul (ContDiffOn.arctan ?_)
    exact ContDiffOn.div (by fun_prop) (hr.add (by fun_prop)) fun y hy => hy.2.2.ne'

/-! ### The relation and the transported certificate -/

end ExactVacuumAtlas.Schwarzschild.Iso

-- ==== solution ====
open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable {M : ℝ}
theorem solution (M : ℝ) :
    CoordRelation (gIso M) (gIsoCart M) (domIsoChart M) (domCartSlit M) toCart fromCart jacCart where
  left_inv _ hx := fromCart_toCart hx
  right_inv _ hy := toCart_fromCart hy
  bijOn := Set.InvOn.bijOn ⟨fun _ hx => fromCart_toCart hx, fun _ hy => toCart_fromCart hy⟩
    (fun _ hx => toCart_mem hx) (fun _ hy => fromCart_mem hy)
  smooth := contDiffOn_toCart _
  smooth_inv := contDiffOn_fromCart M
  jacobian _ hx k i := hasDerivAt_pd_toCart (isOpen_domIsoChart M) hx k i
  pullback _ hx := pullback_cart M hx.1.1
