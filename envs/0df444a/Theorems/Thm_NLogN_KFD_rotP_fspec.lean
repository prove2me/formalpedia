theorem NLogN.KFD.rotP_fspec (t : IState HS) (xs : List ℤ) (as : ℕ → ℕ) (P Q B w Bb : ℕ)
    (R L1 L2 L4 L14 : List Item) (has : ∀ p, as p ≤ Q)
    (hlen : xs.length = P * Q * B) (hb : Bnd w xs) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P)
    (hV : zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int B :: L4)
    (h14 : t.G 14 = ints ((List.range P).map fun p => (as p : ℤ)) ++ L14) :
    FSp rotP t ((t.upd 0 (ints (AModel.pull [P, Q, B] [P, Q, B] (rotAddr Q as) 0 xs) ++ R)).upd 14 L14)
