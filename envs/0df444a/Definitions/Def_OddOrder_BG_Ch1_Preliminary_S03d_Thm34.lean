        have hcomm : Commute ((ψ : G) ^ k.val) (qq : G) := mul_inv_eq_iff_eq_mul.mp hcoe
        exact Subtype.ext (by rw [hφval r qq, ← hj, (hcomm.zpow_left j).eq, mul_inv_cancel_right])
      -- The restriction to `K` is irreducible (BG 2.2(a)) and faithful: `(dim M)² = |K/Z(K)|`.
      have hKres_irr : Representation.IsIrreducible (W.toRepresentation.comp K.subtype) :=
        restriction_isIrreducible_of_extraspecial (ρ := W.toRepresentation) hWf hKe (ψ : G) hgen
          (fun z hz => by rw [conjNormalMulAut_eq_conjAutOfNormal]; exact hxZ z hz)
      have hKres_f : Function.Injective (W.toRepresentation.comp K.subtype) := by
        intro a b hab
        simp only [MonoidHom.comp_apply, Subgroup.coe_subtype] at hab
        exact Subtype.ext (hWf hab)
      have hsq : Module.finrank F ↥W.toSubmodule ^ 2 = Nat.card (↥K ⧸ Subgroup.center ↥K) :=
        sq_finrank_eq_card_quotient_center (W.toRepresentation.comp K.subtype) hKres_f
          hKe.commutator_eq_center.le
      -- `K` nonabelian ⟹ `Z(K) ≠ ⊤` ⟹ `dim M ≥ 2`.
      have hcenter_ne_top : Subgroup.center ↥K ≠ ⊤ := fun htop => hK'ne (hZK_eq ▸ htop)
      have hV2 : 2 ≤ Module.finrank F ↥W.toSubmodule := by
        rcases Nat.lt_or_ge (Module.finrank F ↥W.toSubmodule) 2 with hlt | hge
        · exfalso
          have hdim1 : Module.finrank F ↥W.toSubmodule = 1 := by
            have hpos : 0 < Module.finrank F ↥W.toSubmodule := Module.finrank_pos
            omega
          rw [hdim1, one_pow] at hsq
          exact hcenter_ne_top (Subgroup.index_eq_one.mp hsq.symm)
        · exact hge
      -- `C_M(x) = 0`: the eigenvalue-`1` eigenspace of `ρ x` is trivial.
      have heig_bot : cyclicEigenspace ε
          (W.toRepresentation.asGroupHom (ψ : G) : Module.End F ↥W.toSubmodule) 0 = ⊥ := by
        rw [eq_bot_iff]
        intro m hm
        rw [mem_cyclicEigenspace_iff, pow_zero, one_smul] at hm
        have hψfixV : ρ (ψ : G) (m : V) = (m : V) := by
          have h := congrArg Subtype.val hm
          rwa [W.toRepresentation.asGroupHom_apply] at h
        let Stab : Subgroup G :=
          { carrier := {g | ρ g (m : V) = (m : V)}
            one_mem' := by simp only [Set.mem_ofPred_eq, map_one, Module.End.one_apply]
            mul_mem' := fun {a b} ha hb => by
              simp only [Set.mem_ofPred_eq, map_mul] at *
              rw [Module.End.mul_apply, hb, ha]
            inv_mem' := fun {a} ha => by
              simp only [Set.mem_ofPred_eq] at *
              have h1 : ρ a⁻¹ (ρ a (m : V)) = (m : V) := by
                rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
                  Module.End.one_apply]
              rwa [ha] at h1 }
        have hRStab : R ≤ Stab := by rw [← hψgenR]; exact (Subgroup.zpowers_le).mpr hψfixV
        have hm0 : (m : V) = 0 := hCV (m : V) (fun r => hRStab r.2)
        exact Submodule.coe_eq_zero.mp hm0
      have hCVeig : cyclicEigenspaceFinDim ε
          (W.toRepresentation.asGroupHom (ψ : G) : Module.End F ↥W.toSubmodule)
          (0 : Fin p) = 0 := by
        change Module.finrank F ↥(cyclicEigenspace ε
          (W.toRepresentation.asGroupHom (ψ : G) : Module.End F ↥W.toSubmodule)
          ((0 : Fin p) : ℕ)) = 0
        rw [show ((0 : Fin p) : ℕ) = 0 from rfl, heig_bot, finrank_bot]
      -- **Theorem 2.5**: `dim M = p - 1`.
      have hdim : (Module.finrank F ↥W.toSubmodule : ℤ) = (p : ℤ) - 1 :=
        finrank_eq_sub_one_of_extraspecial K W.toRepresentation hWf hKe (ψ : G) hxp hp.two_le
          hε hpF hcop_pK hgen hxZ hCP hV2 hCVeig
      -- **Parity contradiction**: `dim M = p - 1` is even, but `(dim M)² = |K/Z(K)|` is odd.
      have hdimN : Module.finrank F ↥W.toSubmodule = p - 1 := by
        have hp2 : 2 ≤ p := hp.two_le; omega
      have hdim_even : Even (Module.finrank F ↥W.toSubmodule) := by
        rw [hdimN]; exact Nat.Odd.sub_odd hpodd odd_one
      have hquot_odd : Odd (Nat.card (↥K ⧸ Subgroup.center ↥K)) :=
        Odd.of_dvd_nat hodd (dvd_trans (show Nat.card (↥K ⧸ Subgroup.center ↥K) ∣ Nat.card ↥K from
          ⟨Nat.card (Subgroup.center ↥K),
            Subgroup.card_eq_card_quotient_mul_card_subgroup _⟩) hKdvd)
      have hdim_odd : Odd (Module.finrank F ↥W.toSubmodule) :=
        Odd.of_dvd_nat (hsq ▸ hquot_odd) (dvd_pow_self _ two_ne_zero)
      exact (Nat.not_even_iff_odd.mpr hdim_odd) hdim_even

/-- **BG Theorem 3.4** (algebraically closed core).  `G` solvable of odd order, `K` a normal Hall
subgroup with prime-order complement `R`, `G` acting on `V/F` with `char F ∤ |G|` and `F`
algebraically closed.  If `C_V(R) = 0` then `[R, K] ⊆ C_K(V)`. -/
theorem thm34_algClosed
    {F : Type*} [Field F] [IsAlgClosed F]
    {G : Type*} [Group G] [Finite G] [Group.IsSolvable G]
    {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : Representation F G V) (K R : Subgroup G) [K.Normal]
    (hcompl : Subgroup.IsComplement' K R)
    (hHall : Nat.Coprime (Nat.card ↥K) (Nat.card ↥R))
    (hRp : ∃ p : ℕ, p.Prime ∧ Nat.card ↥R = p)
    (hodd : Odd (Nat.card G))
    (hchar : (Nat.card G : F) ≠ 0)
    (hCV : ∀ v : V, (∀ r : ↥R, ρ (r : G) v = v) → v = 0) :
    ∀ g ∈ ⁅R, K⁆, ρ g = 1 :=
  thm34_aux (Nat.card G) ρ K R hcompl hHall hRp hodd hchar hCV rfl

open OddOrder.RepresentationTheory in
/-- **BG Theorem 3.4** (general field).  `G` solvable of odd order, `K` a normal Hall subgroup with
prime-order complement `R`, `G` acting on `V/F` with `char F ∤ |G|` (any field `F`).  If
`C_V(R) = 0` then `[R, K] ⊆ C_K(V)`.

Reduces to the algebraically closed core `thm34_algClosed` by base change to the algebraic closure
`F̄` (BG (2.9)): `char F̄ ∤ |G|` and `C_{F̄⊗V}(R) = 0` transfer along `F → F̄`
(`invariants_baseChangeRepresentation_eq_bot`), and `ρ̄ g = 1 ⟹ ρ g = 1` descends because
`v ↦ 1 ⊗ v` is injective (`F̄` is faithfully flat over `F`). -/
theorem thm34
    {F : Type*} [Field F]
    {G : Type*} [Group G] [Finite G] [Group.IsSolvable G]
    {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : Representation F G V) (K R : Subgroup G) [K.Normal]
    (hcompl : Subgroup.IsComplement' K R)
    (hHall : Nat.Coprime (Nat.card ↥K) (Nat.card ↥R))
    (hRp : ∃ p : ℕ, p.Prime ∧ Nat.card ↥R = p)
    (hodd : Odd (Nat.card G))
    (hchar : (Nat.card G : F) ≠ 0)
    (hCV : ∀ v : V, (∀ r : ↥R, ρ (r : G) v = v) → v = 0) :
    ∀ g ∈ ⁅R, K⁆, ρ g = 1 := by
  -- `char F̄ ∤ |G|`.
  have hchar' : (Nat.card G : AlgebraicClosure F) ≠ 0 := by
    rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
    rwa [Ne, map_eq_zero_iff _ (algebraMap F (AlgebraicClosure F)).injective]
  -- `C_V(R) = 0` ⟹ `C_{F̄⊗V}(R) = 0` (vanishing of invariants survives base change).
  have hCVinv : Representation.invariants (ρ.comp R.subtype) = ⊥ := by
    rw [Submodule.eq_bot_iff]
    exact fun v hv => hCV v hv
  have hCVinv' : Representation.invariants
      ((baseChangeRepresentation (AlgebraicClosure F) ρ).comp R.subtype) = ⊥ := by
    rw [← baseChangeRepresentation_comp]
    exact invariants_baseChangeRepresentation_eq_bot (AlgebraicClosure F) (ρ.comp R.subtype) hCVinv
  have hCV' : ∀ v : TensorProduct F (AlgebraicClosure F) V,
      (∀ r : ↥R, baseChangeRepresentation (AlgebraicClosure F) ρ (r : G) v = v) → v = 0 := by
    intro v hv
    have hmem : v ∈ Representation.invariants
        ((baseChangeRepresentation (AlgebraicClosure F) ρ).comp R.subtype) := hv
    rwa [hCVinv', Submodule.mem_bot] at hmem
  -- apply the algebraically closed core over `F̄`, then descend `v ↦ 1 ⊗ v`.
  intro g hg
  have hbar : baseChangeRepresentation (AlgebraicClosure F) ρ g = 1 :=
    thm34_algClosed (baseChangeRepresentation (AlgebraicClosure F) ρ) K R hcompl hHall hRp hodd
      hchar' hCV' g hg
  apply LinearMap.ext
  intro v
  apply Module.FaithfullyFlat.tensorProduct_mk_injective (A := F) (B := AlgebraicClosure F) V
  have hmap := congrArg
    (fun f : TensorProduct F (AlgebraicClosure F) V →ₗ[AlgebraicClosure F]
      TensorProduct F (AlgebraicClosure F) V => f (1 ⊗ₜ[F] v)) hbar
  simpa using hmap

end OddOrder.BG.Ch1.S03d


