/-! # Partial derivatives: locality, genuine-derivative and smoothness lemmas

Reusable facts about `pd`, `christoffel`, `ricci`:
* locality: they only depend on the fields on an open neighbourhood (`*_congr_of_eqOn`);
* no junk values: on an open set where the fields are `C^∞`, every slice used by `pd` is
  differentiable and `pd` is its true derivative (`hasDerivAt_pd`);
* smoothness propagates: `pd` and `christoffel` of `C^∞` fields are `C^∞` (`contDiffOn_*`).
-/

open Filter Topology
open scoped ContDiff

namespace ExactVacuumAtlas

variable {n : ℕ}

theorem pd_const (c : ℝ) (i : Fin n) (x : Pt n) : pd i (fun _ => c) x = 0 := by
  simp [pd]

end ExactVacuumAtlas

-- ==== segment from Atlas/Core/Constant.lean ====
/-! # Metrics with constant components

If every component is a constant function, every `pd` vanishes. Then all Christoffel symbols
vanish, and so does the coordinate Ricci tensor, at every point. Dimension-generic. -/

namespace ExactVacuumAtlas

variable {n : ℕ}

theorem christoffel_eq_zero_of_const {g ginv : Metric n}
    (hg : ∀ i j, ∃ κ : ℝ, g i j = fun _ => κ) (a b c : Fin n) (x : Pt n) :
    christoffel g ginv a b c x = 0 := by
  have h : ∀ i j l, pd l (g i j) x = 0 := by
    intro i j l
    obtain ⟨κ, hκ⟩ := hg i j
    rw [hκ]
    exact pd_const κ l x
  simp [christoffel, h]

theorem ricciOf_eq_zero_of_const {g ginv : Metric n}
    (hg : ∀ i j, ∃ κ : ℝ, g i j = fun _ => κ) (b d : Fin n) (x : Pt n) :
    ricciOf g ginv b d x = 0 := by
  have e : christoffel g ginv = fun _ _ _ _ => 0 := by
    funext a b c y
    exact christoffel_eq_zero_of_const hg a b c y
  simp only [ricciOf, e, ricci, pd_const]
  simp

end ExactVacuumAtlas

-- ==== segment from Atlas/Minkowski/Cartesian.lean ====
/-!
# Minkowski space in Cartesian coordinates, any dimension `n + 1`

`ds² = -dt² + dx₁² + … + dxₙ²` (Müller–Grave, *Catalogue of Spacetimes*, eq. minkCart, `c = 1`).
Certified on all of `ℝⁿ⁺¹`. For release 0.1 the catalogue row is `n = 3`.
-/

open scoped ContDiff

namespace ExactVacuumAtlas.Minkowski

theorem metricMatrix_gCart (n : ℕ) (x : Pt (n + 1)) : metricMatrix (gCart n) x = eta n := by
  ext i j; rfl

theorem metricMatrix_giCart (n : ℕ) (x : Pt (n + 1)) : metricMatrix (giCart n) x = eta n := by
  ext i j; rfl

theorem eta_mul_eta (n : ℕ) : eta n * eta n = 1 := by
  rw [eta, Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
  congr 1
  funext i
  split_ifs <;> norm_num

theorem eta_symm (n : ℕ) (i j : Fin (n + 1)) : eta n i j = eta n j i := by
  by_cases h : i = j
  · rw [h]
  · simp [eta, Matrix.diagonal_apply_ne _ h, Matrix.diagonal_apply_ne _ (Ne.symm h)]

theorem cert (n : ℕ) : VacuumCertificate (gCart n) (giCart n) Set.univ where
  isOpen := isOpen_univ
  nonempty := Set.univ_nonempty
  symm _ _ i j := eta_symm n i j
  inv x _ := by rw [metricMatrix_gCart, metricMatrix_giCart, eta_mul_eta]
  smooth _ _ := contDiffOn_const
  smooth_inv _ _ := contDiffOn_const
  lorentz x _ := isLorentzian_of_frame 1 (by simp [metricMatrix_gCart])
  ricci_flat x _ b d := ricciOf_eq_zero_of_const (fun i j => ⟨eta n i j, rfl⟩) b d x

end ExactVacuumAtlas.Minkowski

