theorem simultaneous_dirichlet {p Q : ℕ} (hQ : 0 < Q) (u : Fin p → ℝ) :
    ∃ q : ℕ, 0 < q ∧ q ≤ Q ^ p ∧ ∃ z : Fin p → ℤ,
      ∀ i, |(q : ℝ) * u i - z i| ≤ 1 / (Q : ℝ) := by sorry
