-- Source module: Solutions.J6AIL20
/-!
# A lines, IL side 20: the leaves in contract form

For a descriptor stack `dA ∈ {30, 31}` holding `dL k pre post s t p α d` (entries below `2^W`):

* **`dupS`**: `.call j` with `iprog j = (dupP dA).code` is a `PassOK` step for `dupL 32`;
* **`fineS`**: `.call ju / .call jd` with `fsUp dA ea ey fl dF / fsDn dF` is a `SetupS` pair on
  `![dF]` building `descFine (p + 2) fl a y`;
* **`gathS`** / **`compS`**: `slUp (gP1 dA) 7 12 / slDn` and `slUp (cP1 dA) 7 4 / slDn` are
  `SetupS` pairs on `ρS` building the gather / compress slab register files,

each with its explicit cost (plus `2` for the call) below a given `C`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6A.LF

open IntMul NLogN NLogN.KIL NLogN.KFB Function RS J6Seg.PJ J6A.PA IntMul.Kappa.R6 IntMul.HvdH
open J6Seg.Ax (SetupS PassOK ρS slabV sZ)
open J6Seg.Slab (srcTab flatC)

/-- The one-register extension is an update. -/
theorem ext1 (dF : Fin HS) (V : List ℤ) (F : Fin HS → List ℤ) :
    extend ![dF] ![V] F = update F dF V := by
  funext j
  by_cases h : j = dF
  · subst h
    rw [update_self]
    have hi : Injective ![j] := fun a b _ => Subsingleton.elim a b
    exact hi.extend_apply ![V] F 0
  · rw [update_of_ne h, extend_apply']
    rintro ⟨a, ha⟩
    exact h (by rw [← ha]; fin_cases a; rfl)

theorem dA_cases {dA : Fin HS} (h1 : 30 ≤ dA.val) (h2 : dA.val ≤ 31) : dA = 30 ∨ dA = 31 := by
  rcases dA with ⟨v, hv⟩
  have : v = 30 ∨ v = 31 := by simp only at h1 h2; omega
  rcases this with rfl | rfl
  · left; rfl
  · right; rfl

theorem dA_facts {dA : Fin HS} (h1 : 30 ≤ dA.val) (h2 : dA.val ≤ 31) :
    dA ∉ rg ∧ dA.val < 56 ∧ dA ≠ sTmp ∧ dA ≠ cRdC ∧ dA ≠ 0 ∧ dA ≠ J6A.DP.T1 ∧
    dA ≠ J6A.DP.T2 ∧ dA ≠ J6A.DP.CC ∧ dA ≠ sZ ∧ dA ≠ cL ∧ dA ≠ 43 ∧ dA ≠ 44 ∧ dA ≠ 34 ∧
    dA ≠ 35 ∧ dA ≠ 36 := by
  rcases dA_cases h1 h2 with rfl | rfl <;> decide

/-- The frame of a one-register set-up. -/
theorem frame1 {F : Fin HS → List ℤ} {dA dF : Fin HS}
    (hF : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, ![dF] i ≠ j) → F j = [])
    (hρ : ∀ i, F (![dF] i) = []) : ∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → F j = [] := by
  intro j a b c
  by_cases h : j = dF
  · subst h; exact hρ 0
  · exact hF j a b c (fun i e => h (by rw [← e]; fin_cases i; rfl))

theorem rg_ne {j : Fin HS} (hj : j ∈ rg) : j ≠ 0 ∧ j ≠ sZ := by
  refine ⟨?_, ?_⟩ <;> (rintro rfl; revert hj; decide)

theorem tri_le {pre t post : ℕ} (h1 : 0 < pre) (h2 : 0 < t) (h3 : 0 < post) :
    pre ≤ pre * (t * post) ∧ t ≤ pre * (t * post) ∧ post ≤ pre * (t * post) := by
  have a : 1 ≤ t * post := Nat.mul_pos h2 h3
  refine ⟨?_, ?_, ?_⟩
  · calc pre = pre * 1 := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul_left _ a
  · calc t = 1 * (t * 1) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul h1 (Nat.mul_le_mul_left _ h3)
  · calc post = 1 * (1 * post) := by ring
      _ ≤ pre * (t * post) := Nat.mul_le_mul h1 (Nat.mul_le_mul_right _ h2)

theorem gflat_dupL (L : List GI) : ∀ K : ℕ, gflat (J6A.dupL K L) = J6A.dupL K (gflat L)
  | 0 => by simp [J6A.dupL, gflat]
  | K + 1 => by
    have e : ∀ {β : Type} (M : List β), J6A.dupL (K + 1) M = M ++ J6A.dupL K M := fun M => by
      simp [J6A.dupL, List.replicate_succ]
    rw [e, e, J6Seg.gflat_append, gflat_dupL L K]

section leaves
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The copy step -/

theorem dupS {dA : Fin HS} (h30 : 30 ≤ dA.val) (h31 : dA.val ≤ 31) {j : Fin Pp}
    (hj : iprog j = (J6A.DP.dupP dA).code)
    {k pre post sr t p α d W : ℕ} (hL : ∀ x ∈ dL k pre post sr t p α d, |x| < 2 ^ W)
    (hW8 : 8 ≤ 2 ^ W) (hN : 2 * (pre * (t * post)) ≤ 2 ^ W) (hpW : p + 2 ≤ W + 1) {C : ℝ}
    (hC : ((J6A.DP.cDupP W (2 * (pre * (t * post))) (W + 1) + 2 : ℕ) : ℝ) ≤ C) :
    PassOK I iprog (.call j) dA (dL k pre post sr t p α d)
      (fun L => L.length = pre * (t * post) ∧ GB (p + 2) L) (J6A.dupL 32) C := by
  intro s F L l hF hd h0 hPre
  obtain ⟨hlen, hgb⟩ := hPre
  obtain ⟨fr, f5, fT, fC, f0, f1, f2, f3, -⟩ := dA_facts h30 h31
  have hG : (gflat L).length = 2 * (pre * (t * post)) := by
    rw [J6Seg.gflat_length, hlen]
  have hz : zsz (((gflat L).length : ℕ) : ℤ) ≤ W + 1 := by
    apply J6A.DP.zszW1
    rw [hG, abs_of_nonneg (by positivity)]; exact_mod_cast hN
  have H := J6A.DP.dupP_sp fr f5 fT fC f0 f1 f2 f3 s F hF hd hL hW8 hN (gflat L) l h0 hG
    (J6Seg.bnd_gflat hgb hpW) hz
  rw [← gflat_dupL] at H
  refine ⟨_, IRuns.call (by rw [hj]; exact J6Seg.KR.Sp.ir H), ?_⟩
  rw [hG]; exact hC

/-! ## The fine set-ups -/

theorem fineS {dA dF : Fin HS} (h30 : 30 ≤ dA.val) (h31 : dA.val ≤ 31) (hFA : dF ≠ dA)
    {ea ey : Ex HS} (hea : OnRg ea) (hey : OnRg ey) (hpa : Plain ea = true)
    (hpy : Plain ey = true) {fl : ℕ} {ju jd : Fin Pp}
    (hju : iprog ju = J6A.FS.fsUp dA ea ey fl dF) (hjd : iprog jd = J6A.FS.fsDn dF)
    {k pre post sr t p α d W a y : ℕ} (hL : ∀ x ∈ dL k pre post sr t p α d, |x| < 2 ^ W)
    (hp : 1 ≤ p) (hα : 1 ≤ α) (hmW : sWidth p α + 4 ≤ W) (hfl : fl ≤ 2 ^ W)
    (hta : Tame (2 ^ W) ea) (hty : Tame (2 ^ W) ey)
    (hA : ∀ v c, PV pre post sr t p α W v → ev v c ea = a)
    (hY : ∀ v c, PV pre post sr t p α W v → ev v c ey = y) {C : ℝ}
    (hC1 : ((J6A.FS.cFsR W p (sWidth p α) ea ey fl +
      J6A.FS.cFsI ((p + 2 : ℕ) : ℤ) fl a y + 2 : ℕ) : ℝ) ≤ C)
    (hC2 : ((J6A.FS.cFsD (p + 2) fl a y + 2 : ℕ) : ℝ) ≤ C) :
    SetupS I iprog (.call ju) (.call jd) ![dF] dA (dL k pre post sr t p α d)
      ![descFine (p + 2) fl a y] C := by
  intro s F hF hρ hd
  obtain ⟨fr, f5, fT, fC, f0, f1, f2, f3, fZ, fL, -⟩ := dA_facts h30 h31
  have hE := frame1 hF hρ
  have hdF : F dF = [] := hρ 0
  have hQf := J6A.FS.Q_facts dF
  have hXQ : ∀ i, J6A.FS.Q dF i ≠ dA := fun i e => by
    have a1 := (hQf i).2.2.2.2.2.1; have a2 := (hQf i).2.2.2.2.2.2.1
    rw [e] at a1 a2; omega
  have hQ : ∀ i, F (J6A.FS.Q dF i) = [] := fun i => hE _
    (fun e => (hQf i).2.2.2.1 (by rw [e]; rfl)) (fun e => (hQf i).2.2.2.2.1 (by rw [e]; rfl))
    (hXQ i)
  have hrg : ∀ j ∈ rg, F j = [] := fun j hj => hE j (rg_ne hj).1 (rg_ne hj).2
    (fun e => fr (e ▸ hj))
  have h13 : F cL = [] := hE _ (by decide) (by decide) (Ne.symm fL)
  rw [ext1]
  refine ⟨⟨_, IRuns.call (by
    rw [hju]
    exact J6A.FS.fsUp_runs fr f5 fT fC hXQ hea hey hpa hpy s F hrg h13 hQ hdF hd hL hp hα hmW hfl
      hta hty hA hY), hC1⟩, ⟨_, IRuns.call (by
    rw [hjd]
    have H := J6A.FS.fsDn_runs (I := I) (iprog := iprog) s
      (update F dF (descFine (p + 2) fl a y)) dF (p + 2) fl a y []
      (by rw [update_self, List.append_nil])
    have e : update (update F dF (descFine (p + 2) fl a y)) dF [] = F := by
      rw [update_idem, ← hdF, update_eq_self]
    rwa [e] at H), hC2⟩⟩

/-! ## The slab set-ups -/

end leaves

end J6A.LF
end

