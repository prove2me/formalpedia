theorem act_cc (X : FormalODModule r B) (a : Zp2 r) (i : Fin 2) :
    MvPowerSeries.constantCoeff (X.act a i) = 0 := (X.isLawHom_act a).1 i

theorem cancel_right [IsNoetherianRing B] {φ g₁ g₂ : Series B}
    (hφ0 : ∀ i, MvPowerSeries.constantCoeff (φ i) = 0)
    {d : ℕ} (hφ : FormalODModule.HasKernelOfDegree φ d) (h : g₁.comp φ = g₂.comp φ) : g₁ = g₂ := by
  funext i
  exact FormalODModule.subst_injective_of_hasKernelOfDegree φ hφ0 hφ (g₁ i) (g₂ i) (congrFun h i)

private theorem _root_.RIGN.InstI1I2.hasHeight_map [IsNoetherianRing B] {B' : Type} [CommRing B'] (f : B →+* B')
    {X : FormalODModule r B} {h : ℕ} (hX : X.HasHeight h) : (X.map f).HasHeight h := by
  unfold FormalODModule.HasHeight at hX ⊢
  rw [FormalODModule.map_act]
  exact FormalODModule.hasKernelOfDegree_map f _ (act_cc X _) hX

p2m_export "RIGN.InstI1I2" "hasHeight_map"
