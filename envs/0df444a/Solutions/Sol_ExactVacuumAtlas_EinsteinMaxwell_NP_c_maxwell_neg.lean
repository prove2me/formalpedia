variable (hF : NPFamily g gi F E Θ W) (ht : NPTangent g F E W h f B)
include hF ht

theorem smooth_FfrFVar (A K : Fin 4) :
    ContDiffOn ℝ ∞ (FfrFVar (F 0) f (E 0) B A K) {y | ((0 : ℝ), y) ∈ W} :=
  contDiffOn_var_of hF.isOpen (Φ := fun ε y => FfrF (F ε) (E ε) A K y) (hF.j_FfrF A K)
    fun _ hy => hasDerivAt_FfrF hF ht hy A K

