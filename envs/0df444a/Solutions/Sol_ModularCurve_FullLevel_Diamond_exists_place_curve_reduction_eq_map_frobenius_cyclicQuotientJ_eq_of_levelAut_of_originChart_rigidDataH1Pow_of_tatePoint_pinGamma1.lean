theorem mem_of_pow_mem {L : Type} [Field L] (O : ValuationSubring L) {x : L} {n : ℕ} (hn : n ≠ 0)
    (h : x ^ n ∈ O) : x ∈ O := by
  rcases O.mem_or_inv_mem x with hx | hx
  · exact hx
  · by_cases hx0 : x = 0
    · rw [hx0]; exact O.zero_mem
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
    have e : x = x ^ (m + 1) * x⁻¹ ^ m := by
      rw [pow_succ', mul_assoc, ← mul_pow, mul_inv_cancel₀ hx0, one_pow, mul_one]
    rw [e]
    exact mul_mem h (pow_mem hx m)

theorem exists_frobTwist_pair (q : ℕ) [Fact q.Prime]
    (Ω₁ : Type) [Field Ω₁] [DecidableEq Ω₁] [CharP Ω₁ q] (O : ValuationSubring Ω₁)
    [DecidableEq (ResidueField ↥O)] [CharP (ResidueField ↥O) q]
    (W : WeierstrassCurve ↥O) (hΔ : (W.map (IsLocalRing.residue ↥O)).Δ ≠ 0)
    (N : ℕ) [NeZero N] (P : (W.map O.subtype).toAffine.Point) (hP : addOrderOf P = N)
    (hPred : addOrderOf (WeierstrassCurve.reduceHom hΔ P) = N) :
    ∃ (W' : WeierstrassCurve ↥O) (hΔ' : (W'.map (IsLocalRing.residue ↥O)).Δ ≠ 0)
      (P' : (W'.map O.subtype).toAffine.Point) (hP' : addOrderOf P' = N)
      (hP'red : addOrderOf (WeierstrassCurve.reduceHom hΔ' P') = N),
      (Quot.mk _ (⟨W'.map (IsLocalRing.residue ↥O), ⟨isUnit_iff_ne_zero.mpr hΔ'⟩, WeierstrassCurve.reduceHom hΔ' P', hP'red⟩ :
          ModularCurve.Gamma0Pair N (ResidueField ↥O)) : ModularCurve.ModuliPoint N (ResidueField ↥O)) =
        ModularCurve.ModuliPoint.map (frobenius (ResidueField ↥O) q)
          (Quot.mk _ (⟨W.map (IsLocalRing.residue ↥O), ⟨isUnit_iff_ne_zero.mpr hΔ⟩, WeierstrassCurve.reduceHom hΔ P, hPred⟩ :
            ModularCurve.Gamma0Pair N (ResidueField ↥O))) ∧
