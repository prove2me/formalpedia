theorem NLogN.AX.bapAxP_all (M : MulSpec) (p s t α m kb Bi Bo mm Φ Bacc Q Bq : ℕ) (rest : List ℕ)
    (hM : MulBnd M mm Φ) (H : BapHyp p s t α kb Bi Bo mm Bacc Q) (HT : TabHypB p s t α Bq)
    (hα : 1 ≤ α) (HQ : AxQ t s m kb Bi Bo Q) (hmr : m = rest.prod)
    (st : IState HS) (L : List (ℤ × ℤ)) (Rest : List Item) (hR : BapRegs p s t α m kb st)
    (hD : st.G gD = gints L ++ Rest) (hL : L.length = t * m) (hLB : GB Bi L) :
    bapAxP.run st = st.upd gD (gints (tensorGo [(s, bapL p s t α)] (t :: rest) L) ++ Rest) ∧
      bapAxP.ok M st ∧ bapAxP.cost M st ≤ bapAxCost p s t α m kb Bi mm Φ Bacc Q Bq ∧
      (tensorGo [(s, bapL p s t α)] (t :: rest) L).length = m * s ∧
      GB Bo (tensorGo [(s, bapL p s t α)] (t :: rest) L) := by sorry
