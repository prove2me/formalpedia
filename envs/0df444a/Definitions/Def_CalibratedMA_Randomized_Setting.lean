-- title:
--   Section 2 — randomized predictors, MA, ECE and calibrated multiaccuracy error
-- statement:
--   Let $\mathcal X$ be a measurable space of inputs. A **data distribution** $\mathcal D$ is a probability measure on $\mathcal X\times\mathbb R$ whose label coordinate $Y$ lies in $[0,1]$ almost surely; we write $(X,Y)\sim\mathcal D$.
--
--   A **randomized predictor** $Q=(Q_x)_{x\in\mathcal X}$ assigns to each input $x$ a probability distribution $Q_x$ on $[0,1]$, and depends measurably on $x$. When the predictor is evaluated, the realized prediction $P\sim Q_X$ is drawn independently of $Y$ conditionally on $X$; the joint law of $(X,Y,P)$ is
--   $$\mu_{\mathcal D,Q}(dx,dy,dp)=\mathcal D(dx,dy)\,Q_x(dp).$$
--   All expectations below are taken under $\mu_{\mathcal D,Q}$, so they include the prediction randomness.
--
--   For a finite class $\mathcal G$ of maps $g:\mathcal X\to[-1,1]$ the **multiaccuracy error**, the **expected calibration error** and the **calibrated multiaccuracy error** are
--   $$\mathrm{MA}(Q;\mathcal G)=\sup_{g\in\mathcal G}\big|\mathbb E[g(X)(Y-P)]\big|,\qquad \mathrm{ECE}(Q)=\mathbb E\,\big|\mathbb E[Y-P\mid P]\big|,$$
--   $$\mathrm{CMA}(Q;\mathcal G)=\max\{\mathrm{MA}(Q;\mathcal G),\mathrm{ECE}(Q)\}.$$
--   The conditional expectation in the ECE is taken with respect to the $\sigma$-algebra generated by $P$.
--
--   These are the error measures of the whole mission; the goal theorem bounds $\mathrm{CMA}$ for the output of Algorithm 1.
--
--   **Formalization Note.** A predictor is a map `Q : X → Measure ℝ`; `IsRandomizedPredictor Q` requires measurability of `Q` (Giry σ-algebra), that each `Q x` is a probability measure, and `Q x ([0,1]ᶜ) = 0`. The joint law is `D.bind (z ↦ (Q z.1).map (p ↦ (z.1, z.2, p)))`, which is the true joint law exactly when `Q` is measurable; every theorem that uses it assumes or concludes `IsRandomizedPredictor`. `MA` is a supremum over the finite subtype `G` (it is $0$ for $\mathcal G=\emptyset$), and `ECE` uses Mathlib's `condExp` for `MeasurableSpace.comap P`.
-- source:
--   Jiuyao Lu, Georgy Noarov, Aaron Roth, Calibrated Multiaccuracy: Deterministic and Randomized Sample Complexity, STOC 2027 submission #900 (October 2026), pp. 11–12, Section 2 (definitions of MA, ECE, CMA)

import Mathlib

open MeasureTheory

namespace CalibratedMA.Randomized

/-! # Section 2 — randomized predictors, MA, ECE and calibrated multiaccuracy error

Lu, Noarov, Roth, *Calibrated Multiaccuracy: Deterministic and Randomized Sample Complexity*,
STOC 2027 submission #900, Section 2, pp. 11–12.

A data distribution `D` is a probability measure on `X × ℝ` whose label coordinate lies in
`[0,1]` almost surely. A randomized predictor is a map `Q : X → Measure ℝ`; it is *admissible*
(`IsRandomizedPredictor`) when it is measurable (for the Giry σ-algebra on `Measure ℝ`) and every
`Q x` is a probability measure carried by `[0,1]`. The joint law of `(X, Y, P)`, with
`P ∼ Q_X` drawn independently of `Y` given `X`, is `D.bind (z ↦ (Q z.1).map (p ↦ (z.1, z.2, p)))`. -/

variable {X : Type*} [MeasurableSpace X]

/-- A data distribution on `X × [0,1]`: a probability measure on `X × ℝ` whose second
coordinate lies in `[0,1]` almost surely. -/
def IsLabeledDist (D : Measure (X × ℝ)) : Prop :=
  IsProbabilityMeasure D ∧ ∀ᵐ z ∂D, z.2 ∈ Set.Icc (0 : ℝ) 1

/-- A randomized predictor `Q = (Q_x)_{x ∈ X}`: each `Q x` is a probability distribution on
`[0,1]`, and `x ↦ Q x` is measurable. -/
def IsRandomizedPredictor (Q : X → Measure ℝ) : Prop :=
  Measurable Q ∧ ∀ x, IsProbabilityMeasure (Q x) ∧ Q x (Set.Icc (0 : ℝ) 1)ᶜ = 0

/-- The joint law of `(X, Y, P)`: `(X, Y) ∼ D` and, given `X = x`, the prediction `P ∼ Q x`,
independently of `Y`. Points are `(x, y, p)`. -/
noncomputable def jointLaw (D : Measure (X × ℝ)) (Q : X → Measure ℝ) : Measure (X × ℝ × ℝ) :=
  D.bind (fun z => (Q z.1).map (fun p => (z.1, z.2, p)))

/-- Multiaccuracy error `MA(Q; G) = sup_{g ∈ G} |E[g(X)(Y − P)]|` (`0` for `G = ∅`). -/
noncomputable def MA (D : Measure (X × ℝ)) (Q : X → Measure ℝ) (G : Finset (X → ℝ)) : ℝ :=
  ⨆ g : G, |∫ w, (g : X → ℝ) w.1 * (w.2.1 - w.2.2) ∂(jointLaw D Q)|

/-- Expected calibration error `ECE(Q) = E |E[Y − P | P]|`, the conditional expectation being
taken with respect to the σ-algebra generated by the prediction `P`, under the joint law. -/
noncomputable def ECE (D : Measure (X × ℝ)) (Q : X → Measure ℝ) : ℝ :=
  ∫ w, |(jointLaw D Q)[(fun v : X × ℝ × ℝ => v.2.1 - v.2.2) |
      MeasurableSpace.comap (fun v : X × ℝ × ℝ => v.2.2) inferInstance] w| ∂(jointLaw D Q)

/-- Calibrated multiaccuracy error `CMA(Q; G) = max{MA(Q; G), ECE(Q)}`. -/
noncomputable def CMA (D : Measure (X × ℝ)) (Q : X → Measure ℝ) (G : Finset (X → ℝ)) : ℝ :=
  max (MA D Q G) (ECE D Q)

end CalibratedMA.Randomized


