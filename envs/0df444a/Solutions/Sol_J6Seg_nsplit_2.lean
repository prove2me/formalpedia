/-!
# Segmented inverse (S2): the resampling system split into blocks, coupling and tail

For a valid block structure (`BlocksOK`: blocks are wrap-free runs `[st i, st i + len i)` that
partition `[0, s)`, coupling width `w ≤ s`):
* `MxG` (the block part of `N`, entries `δ_{ik} + e_{i,k-i}`) and `MiG` (its exact block inverse
  `D T⁻¹ D⁻¹` from the q-LU) satisfy `M M⁻¹ = I` (`hinvG`, via `eEx_recentre`, `MF_mul_MinvF`);
* row sums: `‖M - I‖, ‖Δ‖ ≤ 2^{-α²θ}` (`rowM`, `rowD`), hence `‖M⁻¹‖ ≤ 8/7` when `α²θ ≥ 3`;
* every coupling column lies in the capacitance set `Jlist` (`col_mem`);
* `nsplit`: `(N x)_i = (M x)_i + (Δ x)_i + drop`, `|drop| ≤ 4 e^{-πα² w(w+1)} ‖x‖`;
* `nearN`: `‖N d‖ ≤ ρ ⇒ ‖d‖ ≤ 8ρ/7` (`‖N - I‖ ≤ 1/8`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section glob
variable {s t α : ℕ} {B : Blocks}

lemma mem_blS {i k : ℕ} : k ∈ blS B i ↔ B.st i ≤ k ∧ k < B.st i + B.len i := by
  simp [blS]

lemma blS_self (hB : BlocksOK s t B) {i : ℕ} (hi : i < s) : i ∈ blS B i := by
  have := hB.cover i hi; rw [mem_blS]; omega

lemma blS_lt (hB : BlocksOK s t B) {i k : ℕ} (hi : i < s) (hk : k ∈ blS B i) : k < s := by
  have := hB.cover i hi; rw [mem_blS] at hk; omega

lemma mem_Hset {i : ℕ} {h : ℤ} (hh : h ∈ Hset B i) :
    -(B.w : ℤ) ≤ h ∧ h ≤ B.w ∧ h ≠ 0 ∧ ¬ ((B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i) := by
  unfold Hset at hh
  rw [mem_filter, mem_image] at hh
  obtain ⟨⟨j, hj, rfl⟩, h1, h2⟩ := hh
  rw [mem_range] at hj
  refine ⟨by omega, by omega, h1, h2⟩

lemma mem_Hset_of {i : ℕ} {h : ℤ} (h1 : -(B.w : ℤ) ≤ h) (h2 : h ≤ B.w) (h0 : h ≠ 0)
    (hout : ¬ ((B.st i : ℤ) ≤ i + h ∧ (i : ℤ) + h < B.st i + B.len i)) : h ∈ Hset B i := by
  unfold Hset
  rw [mem_filter, mem_image]
  exact ⟨⟨(h + B.w).toNat, by rw [mem_range]; omega, by omega⟩, h0, hout⟩

lemma toNat_emod_lt (hs : 0 < s) (a : ℤ) : (a % s).toNat < s := by
  have := Int.emod_lt_of_pos a (by exact_mod_cast hs : (0 : ℤ) < s)
  have := Int.emod_nonneg a (by exact_mod_cast hs.ne' : (s : ℤ) ≠ 0)
  omega

lemma sumN (hs : 0 < s) (hst : s ≤ t) (hx1 : 1 ≤ xθ s t α) (x : ℕ → ℝ) (X : ℝ)
    (hX : ∀ k < s, |x k| ≤ X) (i : ℕ) :
    Summable (fun h : ℤ => eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)) ∧
    |∑' h : ℤ, eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)| ≤ (2 : ℝ) ^ (-xθ s t α) * X := by
  have hsum := eEx_sum (s := s) (t := t) (α := α) hs hst hx1 (i : ℤ)
  have hX0 : 0 ≤ X := (abs_nonneg _).trans (hX 0 hs)
  have hb : ∀ h : ℤ, ‖eEx s t α i h * x ((((i : ℤ) + h) % s).toNat)‖ ≤ eEx s t α i h * X :=
