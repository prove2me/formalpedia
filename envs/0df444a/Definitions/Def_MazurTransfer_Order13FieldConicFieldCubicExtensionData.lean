import Definitions.Def_MazurTransfer_Order13FieldConicFunctionParameterData
import Definitions.Def_MazurTransfer_Order13FieldFunctionFieldGeneratorsData

noncomputable section
universe w
namespace MazurTransfer.Order13FieldConicFieldCubicExtension
open Polynomial
open GoodCharacteristicGeometryPublicProof.MazurTransfer.Order13GoodCharacteristicCurveModel
open Order13PellActualOrdinaryChart Order13FieldConicFunctionParameter
open Order13FieldDiamondQuotientFunctions RationalConicFunctionParameter
open Order13FieldFunctionFieldGenerators
variable (K : Type w) [Field K] [CharZero K]
local instance : Fact ((104 : K) ≠ 0) := ⟨by norm_num⟩
local instance : Algebra K (actualCurveFunctionField K) := actualCurveFunctionFieldAlgebra K
local instance : CharZero (actualCurveFunctionField K) := Algebra.charZero_of_charZero K _

def conicField : IntermediateField K (actualCurveFunctionField K) :=
  IntermediateField.adjoin K {(t K)}

theorem parameter_mem : (t K) ∈ (conicField K) := IntermediateField.subset_adjoin K _ (by simp)

theorem u_mem_of_parameter_mem (S : IntermediateField K (actualCurveFunctionField K))
    (ht : (t K) ∈ S) : (u K) ∈ S := by
  rw [← (u_parameter K)]
  exact S.div_mem
    (S.sub_mem (S.add_mem (pow_mem ht 2) (S.mul_mem (S.natCast_mem 4) ht)) S.one_mem)
    (S.sub_mem S.one_mem (pow_mem ht 2))

theorem v_mem_of_parameter_mem (S : IntermediateField K (actualCurveFunctionField K))
    (ht : (t K) ∈ S) : (v K) ∈ S := by
  rw [← (v_parameter K)]
  exact S.div_mem (S.mul_mem (S.natCast_mem 2) (S.add_mem S.one_mem (pow_mem ht 2)))
    (S.sub_mem S.one_mem (pow_mem ht 2))

theorem u_mem : (u K) ∈ (conicField K) := (u_mem_of_parameter_mem K) _ (parameter_mem K)
theorem v_mem : (v K) ∈ (conicField K) := (v_mem_of_parameter_mem K) _ (parameter_mem K)

theorem conic_coordinates_generate_parameter_field :
    IntermediateField.adjoin K {(u K), (v K)} = (conicField K) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · exact (u_mem K)
    · exact Set.mem_singleton_iff.mp hz ▸ (v_mem K)
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rcases Set.mem_singleton_iff.mp hz with rfl
    let S := IntermediateField.adjoin K {(u K), (v K)}
    have hu : (u K) ∈ S := IntermediateField.subset_adjoin K _ (by simp)
    have hv : (v K) ∈ S := IntermediateField.subset_adjoin K _ (by simp)
    exact S.div_mem (S.sub_mem hv (S.natCast_mem 2)) (S.add_mem hu S.one_mem)

theorem x_generates : IntermediateField.adjoin (conicField K) {xImage K} = ⊤ := by
  apply IntermediateField.restrictScalars_injective K
  rw [IntermediateField.restrictScalars_top]
  apply (intermediateField_eq_top K)
  · exact IntermediateField.subset_adjoin (conicField K) _ (by simp)
  · let S := IntermediateField.adjoin (conicField K) {xImage K}
    have hx : xImage K ∈ S := IntermediateField.subset_adjoin (conicField K) _ (by simp)
    have hv : (v K) ∈ S := S.algebraMap_mem ⟨(v K), (v_mem K)⟩
    rw [(y_recovered K)]
    exact S.mul_mem hv (S.mul_mem hx (S.add_mem hx S.one_mem))

def cubic : Polynomial (conicField K) :=
  X ^ 3 - C ⟨(u K), (u_mem K)⟩ * X ^ 2 - C (⟨(u K), (u_mem K)⟩ + 3) * X - 1

theorem cubic_monic : (cubic K).Monic := by
  unfold cubic
  monicity!

theorem cubic_degree : (cubic K).natDegree = 3 := by
  unfold cubic
  compute_degree!

theorem cubic_root : aeval (xImage K) (cubic K) = 0 := by
  simp only [cubic, map_sub, map_mul, map_pow, map_one, aeval_X, aeval_C]
  change xImage K ^ 3 - (u K) * xImage K ^ 2 - ((u K) + 3) * xImage K - 1 = 0
  exact (cubic_equation K)

theorem x_integral : IsIntegral (conicField K) (xImage K) := ⟨(cubic K), (cubic_monic K), (cubic_root K)⟩

theorem curveField_finite : FiniteDimensional (conicField K) (actualCurveFunctionField K) := by
  have := IntermediateField.adjoin.finiteDimensional (x_integral K)
  rw [(x_generates K)] at this
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

theorem curveField_degree_le_three : Module.finrank (conicField K) (actualCurveFunctionField K) ≤ 3 := by
  have H := Polynomial.natDegree_le_natDegree (minpoly.min (conicField K) (xImage K) (cubic_monic K) (cubic_root K))
  rw [(cubic_degree K)] at H
  rw [← IntermediateField.finrank_top', ← (x_generates K), IntermediateField.adjoin.finrank (x_integral K)]
  exact H

end MazurTransfer.Order13FieldConicFieldCubicExtension
#print axioms MazurTransfer.Order13FieldConicFieldCubicExtension.x_generates
#print axioms MazurTransfer.Order13FieldConicFieldCubicExtension.curveField_degree_le_three


