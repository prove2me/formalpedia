    have hμv := LanglandsTunnell.CubicInduction.BadPlaceBridges.isUnramifiedCharAt_of_not_isBadPlace K μ v hbad
    have he :=
      LanglandsTunnell.CubicInduction.BadPlaceBridges.ramificationIdx_under_eq_one_of_not_isBadPlace K μ v hbad
    have hfinF := LanglandsTunnell.CubicInduction.FibreDegree.primeFibre_finite K v
    have hc : ∀ 𝔓 ∈ primeFibre ℚ K v, inducedCoeff K μ 𝔓 ≠ 0 := fun 𝔓 h𝔓 => by
