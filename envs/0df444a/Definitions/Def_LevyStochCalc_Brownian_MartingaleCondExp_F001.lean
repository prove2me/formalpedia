/-!
# Conditional expectations of Brownian increments

For a Brownian motion `W` and times `0 ≤ s < t`, the σ-algebra generated by the increment
`W_t − W_s` is independent of the natural filtration `ℱ_s`, so that `𝔼[W_t − W_s | ℱ_s] = 0`,
`𝔼[(W_t − W_s)² | ℱ_s] = t − s` and `𝔼[W_s (W_t − W_s) | ℱ_s] = 0` almost surely. The
variance identity rests on the second moment `∫ x² ∂(gaussianReal 0 v) = v` of a centred
Gaussian law.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace LevyStochCalc.Brownian.Martingale

universe u

section ConditionalExpectations
variable {Ω : Type u} [MeasurableSpace Ω]

/-- The conditional expectation of a Brownian increment `W_t − W_s`, `0 ≤ s < t`, given the
natural filtration at time `s` vanishes. -/
lemma condExp_increment_eq_zero_aux
    {P : Measure Ω} [IsProbabilityMeasure P]
    (W : LevyStochCalc.Brownian.BrownianMotion P)
    {s t : ℝ} (hs : 0 ≤ s) (hst : s < t) :
    P[(fun ω => W.W t ω - W.W s ω) | (naturalFiltration W) s] =ᵐ[P]
      fun _ => 0 :=
  _root_.Prove2MeSourceProof.h_a84c271844f92ab4f91e21a0 W (naturalFiltration W) hs hst
    (increment_indep_naturalFiltration_aux W hs hst)
/-- **Gaussian second moment.** `∫ x² ∂(gaussianReal 0 v) = v`. -/
lemma gaussianReal_second_moment (v : NNReal) :
    ∫ x : ℝ, x^2 ∂(ProbabilityTheory.gaussianReal 0 v) = v := by
  have h_var : ProbabilityTheory.variance (fun x : ℝ => x)
      (ProbabilityTheory.gaussianReal 0 v) = v :=
    ProbabilityTheory.variance_fun_id_gaussianReal
  rw [ProbabilityTheory.variance_eq_integral measurable_id'.aemeasurable] at h_var
  simp only [ProbabilityTheory.integral_id_gaussianReal, sub_zero] at h_var
  exact h_var
end ConditionalExpectations

end LevyStochCalc.Brownian.Martingale


