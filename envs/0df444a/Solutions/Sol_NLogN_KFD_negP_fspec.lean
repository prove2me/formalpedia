section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
open NLogN
open IntMul RS
open NLogN.KFD
open KIL AModel
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (as : ℕ → ℕ) (P Q B w Bb : ℕ)
    (R L1 L2 L4 L14 : List NLogN.Item) (has : ∀ p, as p < Q)
    (hlen : xs.length = P * Q * B) (hb : NLogN.Bnd w xs) (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) (hP1 : 1 ≤ P)
    (hV : NLogN.zsz ((P * (Q * B) : ℕ) : ℤ) ≤ Bb)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int Q :: L2)
    (h4 : t.G 4 = .int B :: L4)
    (h14 : t.G 14 = NLogN.ints ((List.range P).map fun p => (as p : ℤ)) ++ L14) :
    NLogN.KFD.FSp NLogN.KIL.negP t ((t.upd 0 (NLogN.ints (AModel.pull [P, Q, B] [P, Q, B] (NLogN.KIL.refAddr Q as) 0 xs) ++ R)).upd 14 L14)
      (10 ^ 6 * (P * (Q * B) + 1) * (w + 2) + 10 ^ 8 * (Bb + 2) ^ 2) := by
  have H := NLogN.KFD.negP_fsp (NLogN.KIL.rBase t R L1 L2 L4 L14) (NLogN.KIL.recR xs Q B) P Q B w as
    (fun _ _ => NLogN.KIL.length_recR xs Q B _ _)
    (fun _ _ a ha => by
      simp only [NLogN.KIL.recR, List.mem_map, List.mem_range] at ha
      obtain ⟨b, -, rfl⟩ := ha; exact NLogN.KIL.bnd_getD hb _) has hB1 hQ1 hP1 Bb hV
  rw [NLogN.KIL.inR_recR hlen, NLogN.KIL.outN_recR xs P Q B as has, NLogN.KIL.encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4,
    NLogN.KIL.encK_rIO_eq t _ _ P Q B R L1 L2 L4 L14 h1 h2 h4] at H
  have e : (t.upd 0 (NLogN.ints xs ++ R)).upd 14 (NLogN.ints ((List.range P).map fun p => (as p : ℤ)) ++ L14)
      = t := by
    rw [← h0, ← h14, NLogN.IState.upd_self, NLogN.IState.upd_self]
  rw [e] at H
  refine (H.congr ?_).mono (NLogN.KFD.cNegF_le hB1 hQ1)
  simp [NLogN.ints]
end
