  faraday_frame hx A K

theorem EF_KN_zero (hx : x ∈ domReg M a Q) (u v : Fin 4 → ℂ) :
    ccontr (einsteinMaxwell gK giK FK) x u v = 0 := by
  simp [ccontr, (KN.certReg M a Q).einstein x hx]

variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
  {W : Set (ℝ × Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}

theorem KNFam.ricFVar_src (hK : KNFam M a Q g gi F E Θ W) (ht : NPTangent g F E W h f B)
    (hx0 : ((0 : ℝ), x) ∈ W) {A K : Fin 4} (h0 : etaNull A K = 0) :
    ricFVar gK giK h EK B A K x
      = 2 * ∑ C, ∑ D, (FfrFVar FK f EK B A C x * etaNull C D * FfrF FK EK K D x
          + FfrF FK EK A C x * etaNull C D * FfrFVar FK f EK B K D x) + LEfr M a Q h f A K x := by
  have hxD := hK.slice x hx0
  have e := NPFamily.ricFVar_eta0 hK.fam ht hx0 h0
  rw [hK.g0, hK.gi0, hK.F0, hK.E0] at e
  rw [e, EF_KN_zero hxD, EF_KN_zero hxD]
  ring

end kn

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg7

-- ==== solution ====
open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation
open ExactVacuumAtlas.EinsteinMaxwell.KN (Sig Del gKN giKN domReg domKN faradayKN)
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
attribute [-simp] Complex.ofReal_cos Complex.ofReal_sin
variable {M a Q : ℝ} {x : Pt 4}
local notation "gK" => gKN M a Q
local notation "giK" => giKN M a Q
local notation "EK" => knE M a Q
local notation "ΘK" => knTh M a Q
local notation "FK" => faradayKN a Q
variable {g gi : ℝ → Metric 4} {F : ℝ → TwoForm 4} {E Θ : ℝ → Fin 4 → Fin 4 → Pt 4 → ℂ}
  {W : Set (ℝ × Pt 4)} {h : Metric 4} {f : TwoForm 4} {B : Fin 4 → Fin 4 → Pt 4 → ℂ}
theorem solution (hK : KNFam M a Q g gi F E Θ W) (ht : NPTangent g F E W h f B)
    (hx0 : ((0 : ℝ), x) ∈ W) (A : Fin 4) :
    ricFVar gK giK h EK B A A x = LEfr M a Q h f A A x := by
  have hxD := hK.slice x hx0
  have hFa := (KN.certReg M a Q).antisymm x hxD
  have hfa := hK.fam.tangent_antisymm ht hx0
  have a01 := FfrFVar_antisymm (E := EK) (B := B) hFa hfa 0 1
  have a23 := FfrFVar_antisymm (E := EK) (B := B) hFa hfa 2 3
  fin_cases A <;>
  · rw [hK.ricFVar_src ht hx0 (by simp [etaNull])]
    simp only [Fin.sum_univ_four, FfrF_KN hxD]
    simp [etaNull]
    try simp [FfrFVar_self (E := EK) (B := B) hFa hfa]
