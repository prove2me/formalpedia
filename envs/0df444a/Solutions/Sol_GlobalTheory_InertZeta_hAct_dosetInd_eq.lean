    · have h' := mem_dosetOf_iff.2 h
      have hx : x ∈ s := h
      simp [dosetInd, Set.indicator_of_mem h', Set.indicator_of_mem hx]
    · have h' : x.out ∉ DoubleCoset.doubleCoset x₀.out (K : Set G) (K : Set G) := fun h' => h (mem_dosetOf_iff.1 h')
