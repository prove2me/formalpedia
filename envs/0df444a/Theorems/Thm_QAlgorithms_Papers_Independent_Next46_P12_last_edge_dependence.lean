-- title:
--   Lemma 3.9: content and interpolation depend only on the last edge
-- statement:
--   Let $k$ be a field and let $A_0\hookrightarrow A_1\hookrightarrow\cdots$ be a tower of finite-dimensional split semisimple unital $k$-algebras with $A_0\cong k$ and multiplicity-free restriction at every adjacent level. Write $\operatorname{Irr}(n)$ for its simple-module types and $\operatorname{Tab}(n)$ for the length-$n$ branching paths. Let $\epsilon(\lambda)$ act as identity on the simple of type $\lambda$ and zero on every other simple, and define $\epsilon_T=\prod_{i=1}^n\epsilon(\lambda_i)$ for $T=(\lambda_0,\ldots,\lambda_n)$, using the tower embeddings and the empty product $\epsilon_\varnothing=1$. Let $X_n$ be the algebra generated by the embedded level centers, with $X_0=A_0$. Let $(J_i)$ be a JM sequence. If length-$n$ paths $S,T$, with $n\ge1$, have the same terminal type and their prefixes have the same terminal type, then
--
--   $$c_S(n)=c_T(n),\qquad P_S(x)=P_T(x).$$
--
--   Here $P_T$ is the sibling interpolation polynomial of Definition 3.7. More explicitly, for the last edge $\mu\to\lambda$ put $d_{\mu\lambda}=a_\lambda-a_\mu$, where $a$ denotes the scalar of the corresponding central partial sum. Then $P_T(x)=\prod_{\nu:\mu\to\nu,\ \nu\ne\lambda}(x-d_{\mu\nu})/(d_{\mu\lambda}-d_{\mu\nu})$.
--
--   This makes the edge notation for the interpolation polynomials well-defined.
-- source:
--   Canonical idempotents of multiplicity-free families of algebras, arXiv:1606.08900v5, PDF p. 14, Lemma 3.9: content and interpolation depend only on the last edge

import Definitions.Def_QAlgorithms_Papers_Independent_Next46_P12

noncomputable section

open scoped BigOperators Classical

open Filter

namespace QAlgorithms.Papers.Independent.Next46.P12

universe u v w

variable {k : Type u} [Field k]

variable {A : Type v} [Ring A] [Algebra k A]

section TowerStatements

variable {AA : ℕ → Type v} [∀ n, Ring (AA n)] [∀ n, Algebra k (AA n)]

variable [∀ n, FiniteDimensional k (AA n)]

/-- Lemma 3.9, source PDF p. 14. The constructed polynomial, as well as its value,
depends only on the last edge. Competitors are outgoing neighbors of the predecessor. -/
theorem last_edge_dependence (D : Tower k AA) (J : (i : ℕ) → AA (i + 1))
    (hJ : IsJMSequence D J) (n : ℕ) :
    (∀ s t : TowerPath D (n + 1), towerTerminal D s = towerTerminal D t →
      towerTerminal D (towerPrefix D s n (by omega)) = towerTerminal D (towerPrefix D t n (by omega)) →
      lastContent D J s = lastContent D J t ∧ siblingPolynomial D J s = siblingPolynomial D J t) ∧
    (∀ t : TowerPath D (n + 1), siblingPolynomial D J t = edgePolynomial D J n
      (towerTerminal D (towerPrefix D t n (by omega))) (towerTerminal D t)) := by sorry

end TowerStatements

end QAlgorithms.Papers.Independent.Next46.P12

end
