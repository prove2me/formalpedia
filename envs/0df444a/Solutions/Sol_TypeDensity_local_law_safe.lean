                  (TypeDensity.lawProd ((TypeDensity.children (TypeDensity.State.single a c) P).map fun z ↦
                    TypeDensity.lawDescend z.1 (TypeDensity.stateLawFuel (TypeDensity.State.single a c).rank z.2)))) := by
        rw [TypeDensity.stateLawFuel]
        all_goals first | rfl | (intro a1 h; cases h; exact hc rfl)
      rw [hfuel]
      refine TypeDensity.law_safe_scale _ _ (fun q hq ↦ ?_) hT
      obtain ⟨hpos, -, hlt⟩ := TypeDensity.return_weight_bounds q c hq hc2
      have hne : (TypeDensity.Expr.pow .var (TypeDensity.tri c)).eval (q : ℚ) ≠ 0 := fun h0 ↦ by
