-- title:
--   Lemma 1 — CCA generates finitely many distinct cuts, and the set of distinct cuts eventually stops changing
-- statement:
--   For a stage $t\in\{2,\dots,T\}$ let
--   $$\mathcal G^k_t=\{(\beta^j_t,\alpha_{t,j}):\ j=1,\dots,k-1\}$$
--   be the set of distinct cuts on $\theta_t$ generated by CCA before iteration $k$. Then for every run of the batched scheme (DOASA, DOASA-N, any forward scenarios, any backward samples, any choice of extreme-point duals and of best-dual tie-breaks):
--
--   1. there is $m_t$ with $|\mathcal G^k_t|\le m_t$ for all $k$;
--   2. there is $k_t$ such that $\mathcal G^k_t=\mathcal G^{k_t}_t$ for all $k>k_t$.
--
--   The dimension of the dual vector $\rho$ grows with $k$, so the collection of extreme-point duals can be infinite; the lemma says the cut coefficients nevertheless take finitely many values. This finiteness is the engine of the finite-convergence argument.
--
--   **Formalization Note** $\mathcal G$ is a set of distinct values (the initial cut excluded, as printed); its size is measured with `Set.encard`, which is infinite on infinite sets. The bound $m_t$ may depend on the run ("consider any realization", p. 6). The hypothesis that collected duals are extreme points is part of the run; without it the lemma fails. Stage index $t$ of the paper is `s + 1` in Lean ($1\le s\le T-1$).
-- source:
--   Philpott & Guan, On the convergence of stochastic dual dynamic programming and related methods, authors' manuscript v24 (2008-02-25), p. 6, Lemma 1

import Mathlib
import Definitions.Def_SDDPConv_Doasa_Model
import Definitions.Def_SDDPConv_Doasa_Cuts
import Definitions.Def_SDDPConv_Doasa_Run

namespace SDDPConv.Doasa

/-- Lemma 1, p. 6: in every run of the batched scheme, for each stage the set `𝒢^k` of distinct
generated cuts has bounded cardinality and is eventually constant. -/
theorem lemma1 (I : Instance) (L : ℕ → ℝ) (sol : Oracle I)
    (F : ℕ → List (Scen I)) (S : ℕ → Scen I → (t : ℕ) → Finset (Fin (I.q t)))
    (cuts : ℕ → (t : ℕ) → List (Cut I t)) (D : ℕ → (t : ℕ) → Set (Dual I t))
    (hrun : IsBatchRun I L sol F S cuts D) :
    ∀ s, 1 ≤ s → s + 1 ≤ I.T →
      (∃ M : ℕ, ∀ k, (G I cuts k s).encard ≤ M) ∧
        ∃ K, ∀ k, K < k → G I cuts k s = G I cuts K s := by sorry

end SDDPConv.Doasa
