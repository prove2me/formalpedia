    (hX : s.G NLogN.CR.cX = .int (x : ℤ) :: LX) (hR : s.G NLogN.CR.cRB = .int (2 ^ b) :: LR)
    (hL : s.G NLogN.CR.cLR = .int L :: LL) (h1 : s.G 1 = .int S :: L1) (h2 : s.G 2 = .int kb :: L2)
    (h3 : s.G 3 = NLogN.natInts (NLogN.CR.keyL sl) ++ RK) (hLS : L ≤ S) :
    NLogN.CR.crtInP.ok M s ∧
      NLogN.CR.crtInP.run s = (s.upd 0 (NLogN.ints (crtIn sl (chunksL b L x)) ++ s.G 0)).upd NLogN.CR.cX LX := by
  have r1 := NLogN.CR.chunkPadP_spec M s b L x S LX LR LL L1 hX hR hL h1 hLS
