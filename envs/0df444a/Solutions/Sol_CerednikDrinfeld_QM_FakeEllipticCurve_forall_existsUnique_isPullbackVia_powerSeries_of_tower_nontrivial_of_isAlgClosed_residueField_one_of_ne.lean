namespace CompareAwayAuxP20

theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{0}} {t₁ t₂ : T ⟶ Spec (CommRingCat.of S)} (h : t₁ = t₂)
    (P Q : SchemeHomOver t₁ f) (P' Q' : SchemeHomOver t₂ f) (hP : P.1 = P'.1) (hQ : Q.1 = Q'.1) :
    (L.mul t₁ P Q).1 = (L.mul t₂ P' Q').1 := by
  subst h
  obtain rfl : P = P' := Subtype.ext hP
  obtain rfl : Q = Q' := Subtype.ext hQ
  rfl

theorem one_comp_of_mul {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ} {S S' : Type} [CommRing S] [CommRing S']
    (φ : S →+* S') (E : FakeEllipticCurve Λ N S) (E' : FakeEllipticCurve Λ N S') (g : E'.A ⟶ E.A)
    (hw : g ≫ E.f = E'.f ≫ Spec.map (CommRingCat.ofHom φ))
    (hmul : ∀ {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) (P Q : SchemeHomOver t' E'.f),
      (E'.L.mul t' P Q).1 ≫ g =
        (E.L.mul (t' ≫ Spec.map (CommRingCat.ofHom φ))
          ⟨P.1 ≫ g, by rw [Category.assoc, hw, ← Category.assoc, P.2]⟩
          ⟨Q.1 ≫ g, by rw [Category.assoc, hw, ← Category.assoc, Q.2]⟩).1)
    {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of S')) :
    (E'.L.one t').1 ≫ g = (E.L.one (t' ≫ Spec.map (CommRingCat.ofHom φ))).1 := by
  let e : SchemeHomOver (t' ≫ Spec.map (CommRingCat.ofHom φ)) E.f :=
    ⟨(E'.L.one t').1 ≫ g, by rw [Category.assoc, hw, ← Category.assoc, (E'.L.one t').2]⟩
  have key := hmul t' (E'.L.one t') (E'.L.one t')
  rw [E'.L.mul_one] at key
  have he : e = E.L.mul _ e e := Subtype.ext key
  letI := E.L.pointGroup (t' ≫ Spec.map (CommRingCat.ofHom φ))
  have h1 : e = 1 := mul_eq_left.mp he.symm
  show e.1 = (E.L.one _).1
  rw [h1]
  rfl

end CompareAwayAuxP20

namespace CompareAwayTau
variable {O : Type} [CommRing O] [IsLocalRing O]

noncomputable def tau0 (O : Type) [CommRing O] [IsLocalRing O] : PowerSeries O →+* DualNumber (ResidueField O) where
  toFun f := TrivSqZeroExt.inl (residue O (PowerSeries.coeff 0 f)) + TrivSqZeroExt.inr (residue O (PowerSeries.coeff 1 f))
  map_one' := by
    apply TrivSqZeroExt.ext <;> simp [PowerSeries.coeff_one]
  map_mul' f g := by
    apply TrivSqZeroExt.ext
    · simp [PowerSeries.coeff_mul, Finset.Nat.antidiagonal_zero]
    · simp [PowerSeries.coeff_mul, Finset.Nat.antidiagonal_succ, Finset.Nat.antidiagonal_zero, mul_comm]
  map_zero' := by apply TrivSqZeroExt.ext <;> simp
  map_add' f g := by apply TrivSqZeroExt.ext <;> simp [add_comm, add_left_comm]

theorem tau0_apply (f : PowerSeries O) :
    tau0 O f = TrivSqZeroExt.inl (residue O (PowerSeries.coeff 0 f)) + TrivSqZeroExt.inr (residue O (PowerSeries.coeff 1 f)) := rfl

theorem fst_tau0 (f : PowerSeries O) : (tau0 O f).fst = residue O (PowerSeries.coeff 0 f) := by
  simp [tau0_apply]

theorem snd_tau0 (f : PowerSeries O) : (tau0 O f).snd = residue O (PowerSeries.coeff 1 f) := by
  simp [tau0_apply]

theorem tau0_C : (tau0 O).comp (algebraMap O (PowerSeries O)) =
    (algebraMap (ResidueField O) (DualNumber (ResidueField O))).comp (residue O) := by
  apply RingHom.ext; intro a
  have h1 : (algebraMap (ResidueField O) (DualNumber (ResidueField O))) (residue O a) = TrivSqZeroExt.inl (residue O a) := rfl
  rw [RingHom.comp_apply, RingHom.comp_apply, h1, PowerSeries.algebraMap_eq]
  apply TrivSqZeroExt.ext
  · rw [fst_tau0, PowerSeries.coeff_zero_C, TrivSqZeroExt.fst_inl]
  · rw [snd_tau0, PowerSeries.coeff_C, if_neg one_ne_zero, map_zero, TrivSqZeroExt.snd_inl]

theorem tau0_X : tau0 O PowerSeries.X = DualNumber.eps := by
  apply TrivSqZeroExt.ext
  · rw [fst_tau0, PowerSeries.coeff_zero_X, map_zero, DualNumber.fst_eps]
  · rw [snd_tau0, PowerSeries.coeff_one_X, map_one, DualNumber.snd_eps]

theorem mem_maximalIdeal_powerSeries (f : PowerSeries O) :
    f ∈ maximalIdeal (PowerSeries O) ↔ PowerSeries.constantCoeff f ∈ maximalIdeal O := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff,
    PowerSeries.isUnit_iff_constantCoeff]

theorem tau0_mem (f : PowerSeries O) (hf : f ∈ maximalIdeal (PowerSeries O)) : (tau0 O f).fst = 0 := by
  rw [fst_tau0, residue_eq_zero_iff, PowerSeries.coeff_zero_eq_constantCoeff_apply]
  exact (mem_maximalIdeal_powerSeries f).mp hf

theorem sq_le_ker_tau0 : maximalIdeal (PowerSeries O) ^ (1 + 1) ≤ RingHom.ker (tau0 O) := by
  rw [pow_two, Ideal.mul_le]
  intro f hf g hg
  rw [RingHom.mem_ker, map_mul]
  apply TrivSqZeroExt.ext
  · rw [TrivSqZeroExt.fst_mul, tau0_mem f hf, zero_mul, TrivSqZeroExt.fst_zero]
  · rw [TrivSqZeroExt.snd_mul, tau0_mem f hf, tau0_mem g hg, zero_smul, MulOpposite.op_zero, zero_smul, add_zero,
      TrivSqZeroExt.snd_zero]

end CompareAwayTau

