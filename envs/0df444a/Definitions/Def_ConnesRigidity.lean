  spectralTorusWindow a b ∩ spectralArgCoordinates a b ⁻¹' shalomSectorA
def shalomSpectralSectorB (a b : A) : Set (DiscreteCharacterSpace A) :=
  spectralTorusWindow a b ∩ spectralArgCoordinates a b ⁻¹' shalomSectorB
