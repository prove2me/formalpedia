theorem solution (U : TypeDensity.SurfaceUniverse) (i : U.ι)
    (hnt : (U.M i).s.terminal = false) :
    (∀ a c : ℕ, (U.M i).s = TypeDensity.State.single a c → U.nonterminatingSet i ⊆ (⋂ k, U.returnEvent k i) ∪ ⋃
      k, U.badExitEvent k i) ∧ (∀ a b c h : ℕ, (U.M i).s = TypeDensity.State.crossing a b c h →
      U.nonterminatingSet i ⊆ U.badExitEvent 0 i) := by
  classical
  constructor
  · intro a c _ J hJ
    by_cases hall : J ∈ ⋂ k, U.returnEvent k i
    · exact Or.inl hall
    · right
      rw [Set.mem_iInter] at hall
      push Not at hall
      have hex : ∃ n, J ∉ U.returnEvent n i := hall
      have hn0 : Nat.find hex ≠ 0 := fun h0 ↦ (h0 ▸ Nat.find_spec hex) hJ.1
      obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hn0
      have hin : J ∈ U.returnEvent m i := by
        by_contra hc
        have := Nat.find_min' hex hc
        omega
      have hnot : J ∉ U.returnEvent (m+1) i := by
        rw [← Nat.succ_eq_add_one, ← hm]; exact Nat.find_spec hex
      rcases TypeDensity.mem_returnEvent_succ_or_badExitEvent U m i hnt J hJ hin with h | h
      · exact absurd h hnot
      · exact Set.mem_iUnion.2 ⟨m, h⟩
  · intro a b c h hs J hJ
    rcases TypeDensity.mem_returnEvent_succ_or_badExitEvent U 0 i hnt J hJ hJ.1 with h' | h'
    · exfalso
      simp only [TypeDensity.SurfaceUniverse.returnEvent, Set.mem_iUnion] at h'
      obtain ⟨⟨c', ⟨a', c'', hs', _⟩⟩, _⟩ := h'
      rw [hs] at hs'
      cases hs'
    · exact h'
