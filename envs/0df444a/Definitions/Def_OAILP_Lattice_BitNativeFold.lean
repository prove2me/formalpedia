namespace OAI
namespace Optimization
namespace LinearProgramming
namespace Lattice
namespace Bit

def copyPrefix {n : ℕ} (src old : Vector ℤ n) (p : Fin n) : Vector ℤ n :=
  Fin.foldl p.val (fun row j =>
    let i : Fin n := ⟨j.val,lt_trans j.isLt p.isLt⟩
    row.set i (src.get i)) old

end Bit
