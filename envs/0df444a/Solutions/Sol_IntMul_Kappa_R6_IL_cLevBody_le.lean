/-! ## Per-step cost: a template constant times `(V + 1)(Bb + 2)²` -/

theorem pushCost_eq (Bb : ℕ) : ∀ l : List (Fin HS × Ex HS),
    pushCost Bb l = pushSz l * 10 ^ 7 * (Bb + 2) ^ 2 + 1
