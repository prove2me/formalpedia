  obtain ⟨L, hL⟩ := top_toNat_G h h0; exact (log2P_spec _ s L hL).2.1

theorem expP_ok' (s : IState HS) (h5 : s.IsInt 5) (h0 : 0 ≤ s.top 5) (h6 : s.IsInt 6)
    (h7 : s.IsInt 7) : expP.ok s := by
