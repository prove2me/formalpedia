  refine ⟨?_, ?_, ?_⟩
  · rw [Nat.add_assoc, Nat.add_comm, Nat.add_mul_div_right _ _ hK, Nat.div_eq_of_lt hlow, Nat.zero_add]
  · have : (R / N0 * (K0 * N0) + g * N0 + R % N0) / N0 = R / N0 * K0 + g := by
      rw [show R / N0 * (K0 * N0) + g * N0 + R % N0 = R % N0 + (R / N0 * K0 + g) * N0 by ring,
        Nat.add_mul_div_right _ _ hN0, Nat.div_eq_of_lt hr, Nat.zero_add]
    rw [this, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hg]
  · rw [show R / N0 * (K0 * N0) + g * N0 + R % N0 = R % N0 + (R / N0 * K0 + g) * N0 by ring,
      Nat.add_mul_mod_self_right, Nat.mod_mod]

theorem srcRow_virt {L m : ℕ} (lay : Layout L m) {g h R C : ℕ} (hg : g < ThreeSumApsp.K0 L m) (hh : h < ThreeSumApsp.K0 L m) :
    srcRow lay (virt (ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) g R) (virt (ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) h C)
        = srcOf (ThreeSumApsp.K0 L m * ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) (g * ThreeSumApsp.K0 L m + h) R ∧
      srcCol lay (virt (ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) g R) (virt (ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) h C)
        = srcOf (ThreeSumApsp.K0 L m * ThreeSumApsp.K0 L m) (ThreeSumApsp.N0 L m) (g * ThreeSumApsp.K0 L m + h) C := by
  obtain ⟨hI1, hI2, hI3⟩ := virt_parts (R := R) hg (ThreeSumApsp.N0_pos L m)
  obtain ⟨hJ1, hJ2, hJ3⟩ := virt_parts (R := C) hh (ThreeSumApsp.N0_pos L m)
  unfold srcRow srcCol srcBlock bandOf blockOf bandSize srcOf
  simp only [hI1, hI2, hI3, hJ1, hJ2, hJ3]
  constructor <;> ring

end ThreeSumApsp.Batch
end
