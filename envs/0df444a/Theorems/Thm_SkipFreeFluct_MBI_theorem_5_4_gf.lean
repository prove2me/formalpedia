-- title:
--   Theorem 5.4 (first display), p. 15 — generating function of $y\mapsto\mathscr H^{[y}(x)$ for an MBI
-- statement:
--   Let $(X,\mathbb P)$ be a Markov branching process with immigration (MBI) with parameters $(\alpha,\mu,p,\beta,\nu,q)$ on $E=\{0,1,2,\dots\}$, with Q-matrix (5.1), branching mechanism $\psi$, immigration mechanism $\phi$, root $s_0$, and the sequences $W,\pi,\varpi$ of Lemma 5.1 (with $W(z)=0$ for $z\le -1$). For $x,y\ge 0$ let
--   $$\mathscr H^{[y}(x)=\sum_{l=0}^{y-x-1}\pi(y-x-1-l)\,\frac{(W\star\varpi)(l)}{l+x+1}\qquad(=0\text{ if }y\le x),$$.
--
--   Then for every $x\ge 0$ and $s\in[0,s_0)$ the series below converges and
--   $$\sum_{y\ge0}\mathscr H^{[y}(x)\,s^y=\int_0^s\frac{v^x}{\psi(v)}\exp\Big(\int_v^s\frac{\phi(u)}{\psi(u)}\,du\Big)\,dv.$$
--
--   This is the first identity of Theorem 5.4; it identifies the functions $\mathscr H^{[y}$ through their generating function and is the bridge between the resolvent formula of item (1) and the killed fundamental functions $H^{[y}$ of Section 3.
--
--   **Formalization Note** This is one item of `SkipFreeFluct.MBI.theorem_5_4`, stated verbatim with the same encodings (the MBI is the chain generated by `mbiQ P` on `Set.Ici (0 : ℤ)`; probabilities and the resolvent are $\mathbb R_{\ge0}\cup\{\infty\}$-valued path sums compared through `.toReal`; transience is $G(x,x)<\infty$ for all $x$, recurrence $G(x,x)=\infty$; MBP means $\beta=q=0$).
-- source:
--   Loeffen, Patie, Wang, Fluctuation Theory of Continuous-Time, Skip-Free Downward Markov Chains with Applications to Branching Processes with Immigration, arXiv:2208.14425v1, pp. 15–16, Theorem 5.4 (first display)

import Mathlib
import Definitions.Def_SkipFreeFluct_MBI_Chain
import Definitions.Def_SkipFreeFluct_MBI_Model
open scoped ENNReal Topology
open Filter MeasureTheory

namespace SkipFreeFluct.MBI

theorem theorem_5_4_gf (P : MBIParams) (hP : P.Valid) :
    ∀ x : ℕ, ∀ s ∈ Set.Ico 0 (s0 P),
      HasSum (fun y : ℕ => calH P y x * s ^ y)
        (∫ v in (0 : ℝ)..s,
          v ^ x / psi P v * Real.exp (∫ u in v..s, phiImm P u / psi P u)) := by sorry

end SkipFreeFluct.MBI
