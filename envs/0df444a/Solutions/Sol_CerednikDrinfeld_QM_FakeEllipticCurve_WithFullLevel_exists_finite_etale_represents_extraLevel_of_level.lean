section Via

variable {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N₀ : ℕ} {S T : Type} [CommRing S] [CommRing T]

theorem via_isPullback (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) : IsPullback g E'.f E.f (Spec.map (CommRingCat.ofHom φ)) :=
  hg.choose
theorem via_isHom (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) :
    Transfer.IsHom φ E.L E'.L g (via_isPullback φ E E' g hg) :=
  fun t P Q => Subtype.ext (hg.choose_spec.1 t P Q)
theorem via_act (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (x : ↥Λ) : E'.act x ≫ g = g ≫ E.act x :=
  hg.choose_spec.2.1 x

theorem kN_spec (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (N : ℕ) : ∃ gn : E'.L.schemeKer N ⟶ E.L.schemeKer N,
    IsPullback gn (E'.L.schemeKerStr N) (E.L.schemeKerStr N) (Spec.map (CommRingCat.ofHom φ)) ∧
    gn ≫ KerOps.ι E.L N = KerOps.ι E'.L N ≫ g :=
  RelativeGroupLaw.exists_isPullback_schemeKerStr_of_isPullback φ E.L E'.L g (via_isPullback φ E E' g hg)
    hg.choose_spec.1 N

def kN (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (N : ℕ) : E'.L.schemeKer N ⟶ E.L.schemeKer N :=
  (kN_spec φ E E' g hg N).choose
theorem kN_isPullback (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (N : ℕ) :
    IsPullback (kN φ E E' g hg N) (E'.L.schemeKerStr N) (E.L.schemeKerStr N) (Spec.map (CommRingCat.ofHom φ)) :=
  (kN_spec φ E E' g hg N).choose_spec.1
theorem kN_ι (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (N : ℕ) :
    kN φ E E' g hg N ≫ KerOps.ι E.L N = KerOps.ι E'.L N ≫ g := (kN_spec φ E E' g hg N).choose_spec.2

theorem kN_unique (φ : S →+* T) (E : FakeEllipticCurve Λ N₀ S) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ E.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ E E' g) (N : ℕ) (k : E'.L.schemeKer N ⟶ E.L.schemeKer N)
    (hk1 : k ≫ E.L.schemeKerStr N = E'.L.schemeKerStr N ≫ Spec.map (CommRingCat.ofHom φ))
    (hk2 : k ≫ KerOps.ι E.L N = KerOps.ι E'.L N ≫ g) : k = kN φ E E' g hg N := by
  apply KerOps.hom_ext E.L N
  · rw [hk2, kN_ι]
  · rw [hk1, (kN_isPullback φ E E' g hg N).w]

end Via
