  refine t0057 S P ?_ ?_ ?_ hunit z g
  ·
    intro z₁ z₂ h₁ h₂ x
    rw [map_mul, mul_assoc, h₁, h₂, map_mul, Units.val_mul, mul_assoc]
  ·
    intro w t x
    have h := FiniteWhittaker.t0091 a ε Winf dF.Wf (archUnitHom w t) 1
      ((archLocalChar ω w t : ℂˣ) : ℂ) 1
      (fun y => by rw [hε, FiniteWhittaker.t0088 fun v _ => t0038 w t v])
      (harch w t)
      (fun y => by
