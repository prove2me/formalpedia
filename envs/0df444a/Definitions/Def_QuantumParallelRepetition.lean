    simpa [exactRightRank, Equiv.trans_assoc] using h
  have hright : r = r' := Equiv.symm_bijective.injective hrightSymm
  subst r'
  have hreverseLeftRank :
      exactReverseLeftRank
          ({ coordinate := i, partition := p, leftOrder := l,
