section Scale

theorem le_Ap {A p x : ℕ} (hA : 1 ≤ A) (hp : 1 ≤ p) : x ≤ A * ((x + 1) ^ p - 1) := by
  have h1 : x + 1 ≤ (x + 1) ^ p := Nat.le_self_pow (by omega) _
  have h2 : (x + 1) ^ p - 1 ≤ A * ((x + 1) ^ p - 1) := Nat.le_mul_of_pos_left _ hA
  omega

theorem Gs_le {A p m x : ℕ} (hA : 1 ≤ A) (hp : 1 ≤ p) : Gs A p m x ≤ A * ((x + 1) ^ p - 1) := by
  unfold Gs; split_ifs
  · exact le_Ap hA hp
  · exact le_rfl

theorem Gs_ge {A p m x : ℕ} (h : 2 * m ≤ x) : Gs A p m x = A * ((x + 1) ^ p - 1) := by
  simp [Gs, show ¬ x < 2 * m by omega]

theorem add_pow_ge (a b p : ℕ) (hp : 1 ≤ p) : a ^ p + b ^ p ≤ (a + b) ^ p := by
  induction p, hp using Nat.le_induction with
  | base => simp
  | succ p hp ih =>
    rw [pow_succ, pow_succ, pow_succ]
    have h1 : a ^ p * a ≤ (a + b) ^ p * a := Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by omega) _)
    have h2 : b ^ p * b ≤ (a + b) ^ p * b := Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by omega) _)
    calc a ^ p * a + b ^ p * b ≤ (a + b) ^ p * a + (a + b) ^ p * b := by omega
      _ = (a + b) ^ p * (a + b) := by ring

/-- One child term: `2^p (sF + 1)^p ≤ (2s + 1)^p F^p` for `F ≥ 2`. -/
theorem child_pow {s F p : ℕ} (hF : 2 ≤ F) :
    2 ^ p * (s * F + 1) ^ p ≤ (2 * s + 1) ^ p * F ^ p := by
  rw [← mul_pow, ← mul_pow]
  apply Nat.pow_le_pow_left
  nlinarith

end Scale

