private theorem hasProd_apFactorPS_pow_five_complex :
    HasProd (fun n : ℕ => (apFactorPS ℂ 5 5 n)^5)
      ((qPochAPPS ℂ 5 5)^5) := by
  have h := hasProd_prod (s := (Finset.univ : Finset (Fin 5)))
