/-!
# Atlas V-03: complex-valued parameter calculus (joint smoothness, interchange, frame derivatives)

Complex-valued analogues of IV's `Atlas/EinsteinMaxwell/Variation/Joint.lean` (which treats real-valued families):
for a family `Φ : ℝ → Pt n → ℂ` that is jointly `C^∞` in `(ε, y)` on an open `W ⊆ ℝ × ℝⁿ`

* `contDiffOn_cpdC_joint`: coordinate derivatives `cpdC i (Φ ε) y` are again jointly `C^∞`;
* `hasDerivAt_param_of_jointC`: `ε ↦ Φ ε y` has a genuine derivative at every point of `W`;
* `hasDerivAt_cpdC_param` (**interchange**): `d/dε|_{ε₀} cpdC i (Φ ε) x = cpdC i ψ x` whenever `ψ y` is the
  genuine parameter derivative of `ε ↦ Φ ε y` on the open slice (symmetry of the second derivative);
* `contDiffOn_deriv_slice`: the parameter derivative `y ↦ ∂_ε Φ(ε₀, y)` is `C^∞` on the slice;
* `hasDerivAt_fdir_param`: the first variation of a frame derivative keeps the frame-variation term,
  `δ(D_A f) = Σ_μ b_A^μ ∂_μ f₀ + D_A δf`;
* complex matrix determinant / adjugate / left-inverse smoothness (copies of IV's real versions).

No new geometric object is defined here. -/

open Complex Filter Topology
open scoped ComplexConjugate Matrix ContDiff
open ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.Variation

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

/-! ### Complex matrix families: determinant, adjugate, left inverse -/

section inverse

variable {X : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]

theorem contDiffOn_detC_of {s : Set X} {A : X → Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) : ContDiffOn ℝ ∞ (fun p => (A p).det) s := by
  simp only [Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
  exact ContDiffOn.sum fun σ _ => contDiffOn_const.mul (contDiffOn_prod fun e _ => hA (σ e) e)

theorem contDiffOn_adjugateC_of {s : Set X} {A : X → Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) (a b : Fin n) :
    ContDiffOn ℝ ∞ (fun p => (A p).adjugate a b) s := by
  simp only [Matrix.adjugate_apply]
  refine contDiffOn_detC_of fun p q => ?_
  by_cases hp : p = b
  · subst hp
    simp only [Matrix.updateRow_self]
    exact contDiffOn_const
  · simp only [Matrix.updateRow_ne hp]
    exact hA p q

/-- On a set where `det A ≠ 0`, the matrix inverse of a `C^∞` complex matrix family is `C^∞`. -/
theorem contDiffOn_invC_of {s : Set X} {A : X → Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ a b, ContDiffOn ℝ ∞ (fun p => A p a b) s) (hdet : ∀ p ∈ s, (A p).det ≠ 0) (a b : Fin n) :
    ContDiffOn ℝ ∞ (fun p => (A p)⁻¹ a b) s := by
  have hd : ContDiffOn ℝ ∞ (fun p => ((A p).det)⁻¹) s := (contDiffOn_detC_of hA).inv hdet
  refine (hd.mul (contDiffOn_adjugateC_of hA a b)).congr fun p _ => ?_
  rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']

end inverse

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg6

