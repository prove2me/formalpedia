theorem solution (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
    (F : Polynomial (TypeDensity.BaseField O)) (σ : TypeDensity.FactorType) (hF : TypeDensity.HasPolynomialTypeF O F σ) :
    TypeDensity.ValidType σ ∧ TypeDensity.typeDegree σ=F.natDegree := by
  obtain ⟨gs, hgs, -, rfl, rfl, hfin⟩ := hF
  constructor
  · intro z hz
    rw [Multiset.mem_coe, List.mem_map] at hz
    obtain ⟨g, hg, rfl⟩ := hz
    have := TypeDensity.irreducible_factor_invariant_degree O g (hgs g hg).1 (hgs g hg).2 (hfin g hg)
    exact ⟨this.1, this.2.1⟩
  · induction gs with
    | nil => simp [TypeDensity.typeDegree]
    | cons g gs ih =>
      have hg := hgs g (by simp)
      have ht : ∀ h ∈ gs, h.Monic ∧ Irreducible h := fun h hh => hgs h (by simp [hh])
      have hm : gs.prod.Monic := by
        simpa using Polynomial.monic_multiset_prod_of_monic (gs : Multiset _) id
          (fun h hh => (ht h (by simpa using hh)).1)
      have := TypeDensity.irreducible_factor_invariant_degree O g hg.1 hg.2 (hfin g (by simp))
      have ih' := ih ht (fun h hh => hfin h (by simp [hh]))
      simp only [TypeDensity.typeDegree, List.map_cons, ← Multiset.cons_coe, Multiset.map_cons,
        Multiset.sum_cons, List.prod_cons] at ih' ⊢
      rw [Polynomial.Monic.natDegree_mul hg.1 hm, ih', this.2.2]
