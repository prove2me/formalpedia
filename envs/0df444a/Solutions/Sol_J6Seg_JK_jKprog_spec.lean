    e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp),
    e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp), e _ (by simp),
    e _ (by simp), e _ (by simp), e _ (by simp), kS_W, e _ (by simp),
    ⟨[], by simp +decide [kS, hdrSt, update_apply, jHdr]⟩,
    ⟨[], by simp +decide [kS, hdrSt, update_apply, jHdr]⟩,
    ⟨[], by simp +decide [kS, hdrSt, update_apply, jHdr]⟩,
