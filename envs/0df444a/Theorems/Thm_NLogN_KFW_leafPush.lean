theorem NLogN.KFW.leafPush {pl : List (Fin HS × Ex HS)} {U O : RS} {σ : Fin HS → Option ℤ} {X : ℕ}
    (hσ : SClean σ) (hw : NoW σ U) (hO : HRef O (RS.sub σ U) X) (hfo : KFD.fok O = true)
    (s : IState HS) (f : Fin HS → List ℤ) (Bb : ℕ)
    (hpl : PushOK (encK s f) Bb pl) (hv : ∀ q ∈ pl, zsz (q.2.eval (encK s f)) ≤ Bb)
    (h0 : (0 : Fin HS) ∉ pl.map Prod.fst) (hnd : (pl.map Prod.fst).Nodup)
    (hfe : ∀ q ∈ pl, f q.1 = [])
    (hag : ∀ i v, σ i = some v → (i, v) ∈ evalP (encK s f) pl)
    (ys : List ℤ) {c : ℕ}
    (H : FSp O (encK (pushSt s (evalP (encK s f) pl)) f)
      (encK (pushSt s (evalP (encK s f) pl)) (Function.update f 0 ys)) c) :
    IRuns I iprog (withPushI pl (fcode U)) (encK s f) (encK s (Function.update f 0 ys))
      (pushCost Bb pl + 400 * (c + X) + (pl.length * (2 * Bb + 2) + 1)) := by sorry
