/-! ## Cyclic convolution and pointwise products -/

/-- Cyclic convolution of length `K`, reduced mod `F`. -/
def cycZ (F : ℤ) (K : ℕ) (A B : List ℤ) : List ℤ :=
  (List.range K).map fun m => (∑ i ∈ Finset.range K, ∑ l ∈ Finset.range K,
    if (i + l) % K = m then A.getD i 0 * B.getD l 0 else 0) % F

/-- Pointwise products, reduced mod `F`. -/
def pmulZ (F : ℤ) : List ℤ → List ℤ → List ℤ
  | a :: A, b :: B => (a * b) % F :: pmulZ F A B
  | _, _ => []

