          jqModCd_mem_full (ResidueField A) a (Dvd.intro 1 hab)⟩ :
            modularFunctionFieldFullC (ResidueField A) a) =
          ⟨qExpand (ResidueField A) a (jqModC (ResidueField A)),
            jqModCd_mem_full (ResidueField A) a dvd_rfl⟩ := rfl
      rw [h2, hτ₂]

  obtain ⟨z, rfl⟩ := reductionModL_surjective p hℓp A hA y

  have h0 := congrArg (reductionModL A p) (heckeOperatorBar_self_add_frickeInvolutionBar_smul p z)
