theorem prime_eq_or_eq (𝔮₁ 𝔮₂ : Ideal ↥O) [𝔮₁.IsPrime] [𝔮₂.IsPrime] (h₁₂ : 𝔮₁ ≠ 𝔮₂)
    (ht₁ : t ∈ 𝔮₁) (ht₂ : t ∈ 𝔮₂) (hm₁ : 𝔮₁ ≠ maximalIdeal ↥O) (hm₂ : 𝔮₂ ≠ maximalIdeal ↥O)
    (𝔭 : Ideal ↥O) [𝔭.IsPrime] (htp : t ∈ 𝔭) (hmp : 𝔭 ≠ maximalIdeal ↥O) : 𝔭 = 𝔮₁ ∨ 𝔭 = 𝔮₂ := by
  have hπ' : maximalIdeal W = Ideal.span {π} := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mp hπ
  by_contra hne
  push Not at hne
  obtain ⟨hne₁, hne₂⟩ := hne
  have key := fun (P Q : Ideal ↥O) [P.IsPrime] [Q.IsPrime] (hPQ : P ≠ Q) (hP : t ∈ P) (hQ : t ∈ Q)
      (hPm : P ≠ maximalIdeal ↥O) (hQm : Q ≠ maximalIdeal ↥O) =>
    ModularCurve.UVCrossingModel.mem_iff_ringEquiv_adicCompletion_mem_span_or_swap_of_ne π hπ' E hE ι t ht P Q hPQ hP hQ hPm hQm

  have ext : ∀ (P Q : Ideal ↥O) (S : ↥O → Prop), (∀ f, f ∈ P ↔ S f) → (∀ f, f ∈ Q ↔ S f) → P = Q :=
    fun P Q S hP hQ => Ideal.ext fun f => (hP f).trans (hQ f).symm
  rcases key 𝔮₁ 𝔮₂ h₁₂ ht₁ ht₂ hm₁ hm₂ with ⟨a₁, a₂⟩ | ⟨a₁, a₂⟩
  · rcases key 𝔭 𝔮₁ hne₁ htp ht₁ hmp hm₁ with ⟨b₁, b₂⟩ | ⟨b₁, b₂⟩
    ·
      exact h₁₂ (ext _ _ _ b₂ a₂)
    ·
      exact hne₂ (ext _ _ _ b₁ a₂)
  · rcases key 𝔭 𝔮₁ hne₁ htp ht₁ hmp hm₁ with ⟨b₁, b₂⟩ | ⟨b₁, b₂⟩
    ·
      exact hne₂ (ext _ _ _ b₁ a₂)
    ·
      exact h₁₂ (ext _ _ _ b₂ a₂)

