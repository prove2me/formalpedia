    simp only [Ex.Plain, Bool.and_eq_true] at hp
    exact ⟨ok_of_plain s a hp.1 fun i hi => h i (by simp [Ex.regs, hi]),
      ok_of_plain s b hp.2 fun i hi => h i (by simp [Ex.regs, hi])⟩
  | .neg a, hp, h => ok_of_plain s a hp fun i hi => h i (by simp [Ex.regs, hi])
  | .sel c x y, hp, h => by
    simp only [Ex.Plain, Bool.and_eq_true] at hp
    refine ⟨ok_of_plain s c hp.1.1 fun i hi => h i (by simp [Ex.regs, hi]), ?_⟩
    split_ifs
    · exact ok_of_plain s x hp.1.2 fun i hi => h i (by simp [Ex.regs, hi])
    · exact ok_of_plain s y hp.2 fun i hi => h i (by simp [Ex.regs, hi])
  | .mul _ _, hp, _ | .shl _ _, hp, _ | .quo _ _, hp, _ | .rem _ _, hp, _ | .pow2 _, hp, _
  | .ndiv _ _, hp, _ | .nmod _ _, hp, _ => by simp [Ex.Plain] at hp

