theorem rs_step_1 : Nat.primesLE 1511 = insert 1511 (Nat.primesLE 1499) :=
  primesLE_insert_next 1499 1511 (by norm_num) (by norm_num)
    (by intro m hm1 hm2; interval_cases m <;> norm_num)
theorem rs_pnum_1 : ∏ p ∈ Nat.primesLE 1511, (p : ℕ) = rsPnum 1 := by
  rw [rs_step_1]
  exact rs_pnum_step_gen (Nat.primesLE 1499) 1511
    (fun h => absurd ((Nat.mem_primesLE.mp h).1) (by omega)) rs_pnum_0
theorem rs_pden_1 : ∏ p ∈ Nat.primesLE 1511, ((p : ℕ) - 1) = rsPden 1 := by
  rw [rs_step_1]
