-- title:
--   Corrected source-exact finite partition atom for Poisson region independence
-- statement:
--   The original finite partition atom indexed by a Finset, with the family C as an explicit argument. It replaces a previously submitted declaration with a malformed name binder.
-- source:
--   LevyStochCalc/Poisson/RegionPartition.lean original partitionAtom, Apache-2.0

import Mathlib
set_option autoImplicit false
universe u
namespace LevyStochCalc.Poisson
variable {𝓨 : Type u} [MeasurableSpace 𝓨] {n : ℕ} {C : Fin n → Set 𝓨}

variable (C) in
/-- The cell of the partition generated by `C` whose members lie in exactly the `C i` with
`i ∈ S`. -/
def partitionAtom (S : Finset (Fin n)) : Set 𝓨 :=
  {x | ∀ i, x ∈ C i ↔ i ∈ S} ∩ ⋃ i, C i
end LevyStochCalc.Poisson


