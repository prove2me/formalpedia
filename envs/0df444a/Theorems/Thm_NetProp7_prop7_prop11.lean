theorem NetProp7.prop7_prop11 :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q →
      (∀ K k, k ≤ K → ∀ (P L : ℕ) (A B Cs : Shape) (xs : List (ZMod 2)),
        Fintype.card (NetScalar.Wr NetProp7.ind₀) ^ k ∣ L →
        xs.length = vol (P :: L :: hdShape A B Cs ((100 ^ 3) ^ k) q) →
        AModel.prog ((bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q k P L A B Cs xs =
          pull (P :: L :: hdShape A B Cs ((100 ^ 3) ^ k) q)
            (P :: L :: hdShape A B Cs ((100 ^ 3) ^ k) q)
            (blockSwap (A.length + 2) (A.length + B.length + (100 ^ 3) ^ k + 2)
              ((100 ^ 3) ^ k)) 0 xs) ∧
      ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ K k V, 0 ≤ V →
        progCost ((bitQC NetProp7.ind₀).toCircuit (q ^ (100 ^ 3) ^ K)) q k V ≤
          K₀ * V * (((100 ^ 3 : ℕ) : ℝ) ^ k) ^ (1 - (2 : ℝ)⁻¹ ^ 50) := by sorry
