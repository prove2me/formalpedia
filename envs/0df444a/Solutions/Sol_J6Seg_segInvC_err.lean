    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hh
  have hb2' : b2 ^ 2 ≤ 1 / 4 := by
    have := sq_abs b2 ▸ pow_le_pow_left₀ (abs_nonneg b2) hb2 2; nlinarith
