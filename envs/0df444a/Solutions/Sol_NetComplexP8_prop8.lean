/-- **Proposition 8 (routes other than `X_a → Y_a`).** -/
theorem prop8_route (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4)) (u : T × T × T → Fin m → ZMod 2)
    (f : Wr ind → NetComplexInterface.Arr m) (w : Wr ind) (hw : ∀ a, w ≠ Sum.inl a) :
    netRun PhiQ (cxFixGatesL ℂ ind lab) (Min8 u) (Mout8 u) f (NetComplex.ρ ind w) = Cten (f w) := by
  apply phase_interface_full hcard hinj
  funext x
  rcases w with a | a | s
  · exact absurd rfl (hw a)
  · simp only [NetComplex.ρ, Mout8, Min8, Pi.sub_apply, qL_top, qL_bot, sub_zero]
  · simp only [NetComplex.ρ, Mout8, Min8, Pi.sub_apply, qL_top, qL_bot, sub_zero]

/-- **Proposition 8 (the route `X_a → Y_a`).** With `Z_{u_a}` applied to the physical input at
`X_a` and `i^{wt u_a} Z_{u_a}` to the output at `Y_a`, the route is `C^{⊗m}`. -/
theorem prop8_route_X (hcard : ∀ t, #(ind t) = 3) (hinj : Function.Injective ind)
    (lab : Option (GName T) → ((Fin m → ZMod 2) → ZMod 4)) (u : T × T × T → Fin m → ZMod 2)
    (hu : ∀ a, u a ⬝ᵥ u a = 1) (hodd : ∀ a, NetComplexPhase.wt (u a) % 2 = 1)
    (f : Wr ind → NetComplexInterface.Arr m) (a : T × T × T) (f' : NetComplexInterface.Arr m) (hf : f (Sum.inl a) = Zu (u a) f') :
    I ^ NetComplexPhase.wt (u a) • Zu (u a)
      (netRun PhiQ (cxFixGatesL ℂ ind lab) (Min8 u) (Mout8 u) f (NetComplex.ρ ind (Sum.inl a))) =
      Cten f' := by
  apply phase_interface_mixed_corrected hcard hinj lab _ _ f _ (u a) _ f' hf
  funext x
  simp only [NetComplex.ρ, Mout8, Min8, Pi.sub_apply]
  exact qL_line_perp_diff (u a) (hu a) (hodd a) x

end NetComplexProp8

