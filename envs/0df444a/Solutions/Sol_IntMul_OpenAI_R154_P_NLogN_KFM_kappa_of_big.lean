theorem sim_steps (I : List Sym) (hinp : ∀ p, inCode (inp (p + 1)) = I.getD p codeEnd)
    (hv : ∀ x < L, (code x).Valid L) {c c' : NLogN.Cfg S} {n : ℕ} (h : Steps I code c n c') :
    ∀ (hpc : c.pc < L), (∀ e ∈ c.ctl, e < L) →
    ∃ hpc' : c'.pc < L, (∀ e ∈ c'.ctl, e < L) ∧ ∃ t, t ≤ 2 * n ∧
