def zero : S110Q4 := ⟨0, 0, 0, 0⟩
def one : S110Q4 := ⟨1, 0, 0, 0⟩
def add (p q : S110Q4) : S110Q4 := ⟨p.a + q.a, p.b + q.b, p.c + q.c, p.d + q.d⟩
def mul (p q : S110Q4) : S110Q4 :=
  ⟨p.a * q.a - (p.b * q.d + p.c * q.c + p.d * q.b),
   p.a * q.b + p.b * q.a - (p.c * q.d + p.d * q.c),
   p.a * q.c + p.b * q.b + p.c * q.a - p.d * q.d,
   p.a * q.d + p.b * q.c + p.c * q.b + p.d * q.a⟩
def cj (p : S110Q4) : S110Q4 := ⟨p.a, -p.d, -p.c, -p.b⟩

def zeta8 : ℂ := Complex.exp (Complex.I * Real.pi / 4)

def ev (p : S110Q4) : ℂ := (p.a : ℂ) + p.b * zeta8 + p.c * zeta8 ^ 2 + p.d * zeta8 ^ 3

theorem zeta8_four : zeta8 ^ 4 = -1 := by
  unfold zeta8
  rw [← Complex.exp_nat_mul]
  rw [show ((4 : ℕ) : ℂ) * (Complex.I * Real.pi / 4) = Real.pi * Complex.I by push_cast; ring]
  exact Complex.exp_pi_mul_I

theorem zeta8_eq : zeta8 = ((Real.sqrt 2 / 2 : ℝ) : ℂ) * (1 + Complex.I) := by
  unfold zeta8
  rw [show Complex.I * Real.pi / 4 = ((Real.pi / 4 : ℝ) : ℂ) * Complex.I by push_cast; ring,
    Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_div_four,
    Real.sin_pi_div_four]
  ring

theorem conj_zeta8 : conj zeta8 = -zeta8 ^ 3 := by
  have hs : ((Real.sqrt 2 / 2 : ℝ) : ℂ) ^ 2 = 1 / 2 := by
    rw [← Complex.ofReal_pow, div_pow, Real.sq_sqrt (by norm_num)]; push_cast; ring
  rw [zeta8_eq, map_mul, Complex.conj_ofReal, map_add, map_one, Complex.conj_I]
  set s := ((Real.sqrt 2 / 2 : ℝ) : ℂ)
  have hI : Complex.I ^ 2 = -1 := Complex.I_sq
  linear_combination (s * (-2 + 2 * Complex.I)) * hs + (s ^ 3 * (3 + Complex.I)) * hI

theorem ev_mul (p q : S110Q4) : ev (mul p q) = ev p * ev q := by
  unfold ev mul
  push_cast
  linear_combination (-((p.b : ℂ) * q.d + p.c * q.c + p.d * q.b + (p.c * q.d + p.d * q.c) * zeta8
    + p.d * q.d * zeta8 ^ 2)) * zeta8_four

theorem ev_add (p q : S110Q4) : ev (add p q) = ev p + ev q := by
  unfold ev add; push_cast; ring

theorem ev_zero : ev zero = 0 := by unfold ev zero; simp

theorem ev_one : ev one = 1 := by unfold ev one; simp

theorem ev_cj (p : S110Q4) : ev (cj p) = conj (ev p) := by
  unfold ev cj
  simp only [map_add, map_mul, map_pow, map_ratCast, conj_zeta8]
  push_cast
