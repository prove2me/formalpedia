      have hval : ∀ a, AModel.Valid (Synth.binSh n) a →
          AModel.Valid (Synth.binSh n) (AModel.permIdx (AModel.bsIdx (Ls + t * K) (Ls + x * K) K) a) :=
        fun _ ha => Synth.valid_binSh_permIdx (fun _ hk => AModel.bsIdx_lt hij hjn hk) ha
      have hrr := NLogN.KFV.recRep_pull hx (Synth.binSh n) hxs hval
      rw [hbl] at hrr
      have hT : Synth.runArr n 0 (NLogN.KFV.opX D ℓ K long t) xs = AModel.pull (Synth.binSh n) (Synth.binSh n)
          (AModel.permIdx (AModel.bsIdx (Ls + t * K) (Ls + x * K) K)) 0 xs := by
        simp only [NLogN.KFV.opX, NLogN.KFV.opT, ← hN, ← hLs, hx_, if_neg hxt, Synth.runArr, List.foldl_cons,
          List.foldl_nil, Synth.LOp.inv]
      rw [hT]
      refine ⟨NLogN.KFV.zMv n (2 ^ ℓ) (AModel.bsIdx (Ls + t * K) (Ls + x * K) K) zs, hrr, NLogN.KFV.gb_pull hgb _ _ _,
        by simp [Synth.binSh, AModel.vol_replicate], NLogN.KFV.disk_pull hd _ _ _, ?_⟩
      refine Rm.mono' rfl ?_
      rw [if_neg hxt]; omega
  obtain ⟨zs', a1, a2, a3, a4, Rm⟩ := key
  -- the post-processing
  set v' := NLogN.KFB.gflat zs' ++ l with hv'
  set f1 := Function.update (Function.update F 0 v') NLogN.KFV.gV [(x : ℤ)] with hf1
  have Q1 := NLogN.KIL.Sp.pop (s := s) (f := f1) (i := NLogN.KFV.gV) (a := (x : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [hf1, Function.update_apply]) (zB _ (by omega))
  set f2 := Function.update f1 NLogN.KFV.gV [] with hf2
  have wI : NLogN.KFV.EV (NLogN.KIL.encK s f2) B (.add (.reg NLogN.KFV.gI) (.lit 1)) ((t : ℤ) + 1) :=
    (NLogN.KFV.EV.reg (L := s.G NLogN.KFV.gI) (by simp +decide [hf2, hf1, hF, NLogN.KFV.F2, Function.update_apply, NLogN.ints])
      (zB t (by omega))).add (NLogN.KFV.EV.lit (zB 1 (by omega))) (by exact_mod_cast zB (t + 1) (by omega))
  have S1 := NLogN.KIL.Sp.asgQ s f2 (i := NLogN.KFV.gI) (e := .add (.reg NLogN.KFV.gI) (.lit 1))
    (a := (t : ℤ)) (l := []) (B := B) (by decide)
    (by simp +decide [hf2, hf1, hF, NLogN.KFV.F2, Function.update_apply])
    (zB _ (by omega)) (by intro r hr; simp [NLogN.Ex.regs] at hr; subst hr; decide) wI.1 wI.2.2
  rw [wI.2.1] at S1
  have eF : Function.update f2 NLogN.KFV.gI [(t : ℤ) + 1] = Function.update (NLogN.KFV.F2 N (t + 1)) 0 v' := by
    funext j
    simp only [hf2, hf1, hF, NLogN.KFV.F2, Function.update_apply]
    split_ifs <;> simp_all +decide
  rw [eF] at S1
  have R3 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (p := NLogN.KFV.post3) (by simp [NLogN.KFV.post3, NLogN.KFV.stepI, NLogN.KFD.fok])
    (NLogN.KFD.FSp.of_norep (by simp [NLogN.KFV.post3, NLogN.KFV.stepI, NLogN.KFD.norep]) (Q1.seq S1))
  refine ⟨zs', a1, a2, a3, a4, ?_⟩
  have R := R1.seq (Rm.seq R3)
  rw [← NLogN.KFV.F2_G N s (t + 1) v'] at R
  refine R.mono' rfl ?_
  unfold IntMul.OpenAI.R129.P.NLogN.KFV.cBody3
  rw [hx_]
  generalize (if x = t then 1 else IntMul.OpenAI.R129.P.NLogN.KFV.cXch Kc NLogN.KFV.eE3 (.reg NLogN.KFV.gKk) NLogN.KFV.eM3 NLogN.KFV.eI3 (.reg NLogN.KFV.gWw) n ℓ K W B) = cc
  apply le_of_eq; ring
end
