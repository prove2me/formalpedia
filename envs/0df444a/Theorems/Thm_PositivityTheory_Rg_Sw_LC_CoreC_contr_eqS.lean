variable {m n : ℕ}

theorem PositivityTheory.Rg.Sw.LC.CoreC.contr_eqS (c : ℝ) (S : Finset (Fin m × Fin n × Bool →₀ ℕ)) {p : PX m n} (hp : p.support ⊆ S) :
    contr c p = ∑ s ∈ S, if Bal s then p.coeff s * piC c s else 0 := by sorry
