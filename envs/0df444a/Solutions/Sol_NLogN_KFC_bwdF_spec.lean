theorem cBlkB_ge (q M B w : ℕ) (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    M * (q * (B * kap w + 124) + 125) + 60 + (M * (q * B * kap w + 96) + 60 +
      (q * (2 * M * ((q * B + B) * kap w + 156) + 184) + 60 + (M * 65 + 60)))
      ≤ cBlkB q M B w + 1000 := by
  unfold cBlkB
  have hk : 200 ≤ kap w := by simp [kap]
  have h1 : q * M ≤ q * M * B := Nat.le_mul_of_pos_right _ hB
  have e : q * (2 * M * ((q * B + B) * kap w + 156) + 184) =
      2 * (q + 1) * kap w * (q * M * B) + 312 * (q * M) + 184 * q := by ring
  have e2 : M * (q * B * kap w + 96) = kap w * (q * M * B) + 96 * M := by ring
  have e3 : M * (q * (B * kap w + 124) + 125) = kap w * (q * M * B) + 124 * (q * M) + 125 * M := by
    ring
  rw [e, e2, e3]
  have h3 : (2 * q + 10) * kap w * (q * M * B) =
      2 * (q + 1) * kap w * (q * M * B) + 2 * (kap w * (q * M * B)) +
        6 * (kap w * (q * M * B)) := by ring
  rw [h3]
  have h4 : 200 * (q * M * B) ≤ kap w * (q * M * B) := Nat.mul_le_mul_right _ hk
  have h5 : q ≤ q * M := Nat.le_mul_of_pos_right _ hM
  have h6 : M ≤ q * M := Nat.le_mul_of_pos_left _ hq
  omega

theorem blkB_runs (s : IState HS) (q M B w : ℕ) (rr : ℕ → ℕ → List ℤ)
    (R0 LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (grpF rr q) 0 M) ++ R0) (hT : NI (s.G NLogN.KFC.sT))
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ y m, (rr y m).length = B) (hb : ∀ y m, Bnd w (rr y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog blkB s ((s.upd sX R0).upd NLogN.KFC.sO ((ints (flF (rowsOf rr M) 0 q)).reverse ++ s.G NLogN.KFC.sO))
      (cBlkB q M B w + 1000) := by
  have h1 := loadT_runs (I := I) (iprog := iprog) s q M B w rr R0 LCQ LDQ LCM LDM LCB LDB h0
    hCQ hDQ hLCQ hLDQ hCM hDM hLCM hLDM hCB hDB hLCB hLDB hr hb
  set s1 := (s.upd sX R0).upd NLogN.KFC.sT ((encF (grpF rr q) 0 M).reverse ++ s.G NLogN.KFC.sT)
  have h2 := backB_runs (I := I) (iprog := iprog) s1 M (q * B) w (grpF rr q) (s.G NLogN.KFC.sT) LCM LDM
    (by simp +decide [s1]) hT (by simp +decide [s1, hCM]) (by simp +decide [s1, hDM]) hLCM hLDM
    (fun m => by rw [length_grpF hr]) (fun m => bnd_grpF hb q m)
  set s2 := (s1.upd NLogN.KFC.sT (s.G NLogN.KFC.sT)).upd sA (encF (grpF rr q) 0 M ++ s1.G sA)
  have h3 := rowsB_runs (I := I) (iprog := iprog) s2 q M B w rr (s.G sA) LCQ LDQ LCM LDM LCB LDB
    (by simp +decide [s2, s1]) (by simpa +decide [s2, s1] using hT)
    (by simp +decide [s2, s1, hCQ]) (by simp +decide [s2, s1, hDQ]) hLCQ hLDQ
    (by simp +decide [s2, s1, hCM]) (by simp +decide [s2, s1, hDM]) hLCM hLDM
    (by simp +decide [s2, s1, hCB]) (by simp +decide [s2, s1, hDB]) hLCB hLDB hr hb
  set s3 := (s2.upd NLogN.KFC.sO ((ints (flF (rowsOf rr M) 0 q)).reverse ++ s2.G NLogN.KFC.sO)).upd sA
    (marks M ++ s.G sA)
  have h4 := clrA_runs (I := I) (iprog := iprog) s3 M (s.G sA) LCM LDM (by simp +decide [s3])
    (by simp +decide [s3, s2, s1, hCM]) (by simp +decide [s3, s2, s1, hDM]) hLCM hLDM
  refine (h1.seq (h2.seq (h3.seq h4))).mono' ?_ ?_
  · clear h1 h2 h3 h4
    simp only [s3, s2, s1]
    clear * -
    apply IState.ext'
    · intro x; simp only [IState.upd_G]
      split_ifs <;> (try subst_vars) <;> simp +decide at *
    · rfl
    · rfl
  · have := cBlkB_ge q M B w hB hq hM; omega

theorem allB_runs (s : IState HS) (P q M B w : ℕ) (r : ℕ → ℕ → ℕ → List ℤ)
    (R LCP LDP LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (KIL.blkOut r q M) 0 P) ++ R) (hT : NI (s.G NLogN.KFC.sT))
    (hCP : s.G sCP = marks P ++ LCP) (hDP : s.G sDP = LDP) (hLCP : NM LCP) (hLDP : NM LDP)
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ p y m, (r p y m).length = B) (hb : ∀ p y m, Bnd w (r p y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog allB s ((s.upd sX R).upd NLogN.KFC.sO
        ((ints (flF (KIL.blkIn r q M) 0 P)).reverse ++ s.G NLogN.KFC.sO))
      (P * (cBlkB q M B w + 1064) + 60) := by
  let T : ℕ → IState HS := fun p =>
    (s.upd sX (ints (flF (KIL.blkOut r q M) p (P - p)) ++ R)).upd NLogN.KFC.sO
      ((ints (flF (KIL.blkIn r q M) 0 p)).reverse ++ s.G NLogN.KFC.sO)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCP) (D := sDP) (by decide) P T LCP LDP
    hLCP hLDP (cBlkB q M B w + 1000) blkB (by
      intro k hk LC' LD'
      obtain ⟨j, hj⟩ : ∃ j, P - k = j + 1 := ⟨P - k - 1, by omega⟩
      have hj' : P - (k + 1) = j := by omega
      have H := blkB_runs (I := I) (iprog := iprog) (cf (T k) sCP sDP LC' LD') q M B w (r k)
        (ints (flF (KIL.blkOut r q M) (k + 1) j) ++ R) LCQ LDQ LCM LDM LCB LDB
        (by simp +decide [T, cf, hj, flF_succ, ints_append, blkOut_eq])
        (by simpa +decide [T, cf] using hT)
        (by simp +decide [T, cf, hCQ]) (by simp +decide [T, cf, hDQ]) hLCQ hLDQ
        (by simp +decide [T, cf, hCM]) (by simp +decide [T, cf, hDM]) hLCM hLDM
        (by simp +decide [T, cf, hCB]) (by simp +decide [T, cf, hDB]) hLCB hLDB (hr k) (hb k)
        hB hq hM
      refine H.mono' ?_ le_rfl
      simp only [T, hj']
      clear H
      ((apply NLogN.IState.ext' <;> intros <;>
               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
             split_ifs <;>
           simp_all +decide))
      rw [flF_snoc]; simp [ints_append, blkIn_eq])
  have e0 : cf (T 0) sCP sDP (marks P ++ LCP) LDP = s := by
    simp only [T, Nat.sub_zero, flF_zero, ints_nil, List.reverse_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;>
                                                                                                 simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                                                                               split_ifs <;>
                                                                                             simp_all +decide))
  have e1 : cf (T P) sCP sDP (marks P ++ LCP) LDP = (s.upd sX R).upd NLogN.KFC.sO
        ((ints (flF (KIL.blkIn r q M) 0 P)).reverse ++ s.G NLogN.KFC.sO) := by
    simp only [T, Nat.sub_self, flF_zero, ints_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;>
                                                                               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
                                                                             split_ifs <;>
                                                                           simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

theorem coreB_runs (s : IState HS) (P q M B w : ℕ) (r : ℕ → ℕ → ℕ → List ℤ)
    (R LCP LDP LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (KIL.blkOut r q M) 0 P) ++ R)
    (hCP : s.G sCP = marks P ++ LCP) (hDP : s.G sDP = LDP) (hLCP : NM LCP) (hLDP : NM LDP)
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ p y m, (r p y m).length = B) (hb : ∀ p y m, Bnd w (r p y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog coreB s (s.upd sX (ints (flF (KIL.blkIn r q M) 0 P) ++ R))
      (P * (cBlkB q M B w + 1064) + (flF (KIL.blkIn r q M) 0 P).length * kap w + 100) := by
  have m1 := IRuns.mark (I := I) (iprog := iprog) (s := s) NLogN.KFC.sO
  have m2 := IRuns.mark (I := I) (iprog := iprog) (s := s.upd NLogN.KFC.sO (.mark :: s.G NLogN.KFC.sO)) NLogN.KFC.sT
  set t2 := (s.upd NLogN.KFC.sO (.mark :: s.G NLogN.KFC.sO)).upd NLogN.KFC.sT (.mark :: (s.upd NLogN.KFC.sO (.mark :: s.G NLogN.KFC.sO)).G NLogN.KFC.sT)
  have hA := allB_runs (I := I) (iprog := iprog) t2 P q M B w r R LCP LDP LCQ LDQ LCM LDM LCB LDB
    (by simp +decide [t2, h0]) (by simp +decide [t2]; exact NI_mark _)
    (by simp +decide [t2, hCP]) (by simp +decide [t2, hDP]) hLCP hLDP
    (by simp +decide [t2, hCQ]) (by simp +decide [t2, hDQ]) hLCQ hLDQ
    (by simp +decide [t2, hCM]) (by simp +decide [t2, hDM]) hLCM hLDM
    (by simp +decide [t2, hCB]) (by simp +decide [t2, hDB]) hLCB hLDB hr hb hB hq hM
  set t7 := (t2.upd sX R).upd NLogN.KFC.sO ((ints (flF (KIL.blkIn r q M) 0 P)).reverse ++ t2.G NLogN.KFC.sO)
  have hw := mvW_runs (I := I) (iprog := iprog) (X := NLogN.KFC.sO) (Y := sX) (by decide) t7
    (flF (KIL.blkIn r q M) 0 P).reverse (.mark :: s.G NLogN.KFC.sO) w
    (by simp +decide [t7, t2, ints_reverse]) (NI_mark _)
    (fun x hx => bnd_flF (f := KIL.blkIn r q M) (fun p => by
      rw [blkIn_eq]; exact bnd_flF (fun y => bnd_flF (hb p y) 0 M) 0 q) 0 P x
      (by simpa using hx))
  set t8 := (t7.upd NLogN.KFC.sO (.mark :: s.G NLogN.KFC.sO)).upd sX
    (ints (flF (KIL.blkIn r q M) 0 P).reverse.reverse ++ t7.G sX)
  have u1 := IRuns.unmark (I := I) (iprog := iprog) (s := t8) (i := NLogN.KFC.sO) (L := s.G NLogN.KFC.sO)
    (by simp +decide [t8])
  have u2 := IRuns.unmark (I := I) (iprog := iprog) (s := t8.upd NLogN.KFC.sO (s.G NLogN.KFC.sO)) (i := NLogN.KFC.sT)
    (L := s.G NLogN.KFC.sT) (by simp +decide [t8, t7, t2])
  refine (m1.seq (m2.seq (hA.seq (hw.seq (u1.seq u2))))).mono' ?_ ?_
  · clear m1 m2 hA hw u1 u2
    simp only [t8, t7, t2, List.reverse_reverse]
    clear * -
    apply IState.ext'
    · intro x
      simp only [IState.upd_G]
      split_ifs <;> (try subst_vars) <;> simp +decide at *
    · rfl
    · rfl
  · simp only [List.length_reverse]; omega

theorem bnd_recOf' {w : ℕ} {xs : List ℤ} (hb : Bnd w xs) (q M B p y m : ℕ) :
    Bnd w (KIL.recOf' xs q M B p y m) := by
  intro a ha
  simp only [KIL.recOf', List.mem_map, List.mem_range] at ha
  obtain ⟨b, -, rfl⟩ := ha
  unfold List.getD
  rcases h : xs[((p * M + m) * q + y) * B + b]? with _ | x
  · simp [zsz_zero]
  · exact hb x (List.mem_of_getElem? h)

end KFC

end NLogN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open IntMul AModel
open NLogN.KFC
variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
theorem solution (t : NLogN.IState NLogN.HS) (xs : List ℤ) (P q M B w : ℕ) (R L1 L2 L3 L4 : List NLogN.Item)
    (hlen : xs.length = P * M * q * B) (hb : NLogN.Bnd w xs)
    (hB1 : 1 ≤ B) (hM1 : 1 ≤ M) (hq1 : 1 ≤ q) (hP1 : 1 ≤ P)
    (h0 : t.G 0 = NLogN.ints xs ++ R) (h1 : t.G 1 = .int P :: L1) (h2 : t.G 2 = .int q :: L2)
    (h3 : t.G 3 = .int M :: L3) (h4 : t.G 4 = .int B :: L4) :
    NLogN.IRuns I iprog NLogN.KFC.bwdF t (t.upd 0 (NLogN.ints (AModel.pull [P, M, q, B] [P, q, M, B] NLogN.KIL.gS 0 xs) ++ R))
      (NLogN.KFC.cBwdF P q M B w) := by
  set r := NLogN.KIL.recOf' xs q M B
  have hr : ∀ p y m, (r p y m).length = B := fun p y m => NLogN.KIL.length_recOf' xs q M B p y m
  have hbr : ∀ p y m, NLogN.Bnd w (r p y m) := fun p y m => NLogN.KFC.bnd_recOf' hb q M B p y m
  have hxs : xs = NLogN.KFC.flF (NLogN.KIL.blkOut r q M) 0 P := by rw [← NLogN.KFC.outF_eq, NLogN.KIL.outF_recOf' hlen]
  have hout : AModel.pull [P, M, q, B] [P, q, M, B] NLogN.KIL.gS 0 xs = NLogN.KFC.flF (NLogN.KIL.blkIn r q M) 0 P := by
    rw [← NLogN.KIL.inp_recOf', NLogN.KFC.inp_eq]
  rw [hout]
  have hlo : (NLogN.KFC.flF (NLogN.KIL.blkIn r q M) 0 P).length = P * q * M * B := by
    rw [NLogN.KFC.length_flF (G := q * (M * B)) (fun p => by
      rw [NLogN.KFC.blkIn_eq, NLogN.KFC.length_flF (G := M * B) (fun y => by
        simp only [NLogN.KFC.rowsOf]; rw [NLogN.KFC.length_flF (G := B) (fun m => hr p y m)])])]; ring
  set s1 := (t.upd NLogN.KFC.sCB (NLogN.KFC.marks B ++ .int 0 :: t.G NLogN.KFC.sCB)).upd NLogN.KFC.sDB (.int 0 :: t.G NLogN.KFC.sDB)
  set s2 := (s1.upd NLogN.KFC.sCM (NLogN.KFC.marks M ++ .int 0 :: s1.G NLogN.KFC.sCM)).upd NLogN.KFC.sDM (.int 0 :: s1.G NLogN.KFC.sDM)
  set s3 := (s2.upd NLogN.KFC.sCQ (NLogN.KFC.marks q ++ .int 0 :: s2.G NLogN.KFC.sCQ)).upd NLogN.KFC.sDQ (.int 0 :: s2.G NLogN.KFC.sDQ)
  set s4 := (s3.upd NLogN.KFC.sCP (NLogN.KFC.marks P ++ .int 0 :: s3.G NLogN.KFC.sCP)).upd NLogN.KFC.sDP (.int 0 :: s3.G NLogN.KFC.sDP)
  have c4 := NLogN.KFC.coreB_runs (I := I) (iprog := iprog) s4 P q M B w r R
    (.int 0 :: t.G NLogN.KFC.sCP) (.int 0 :: t.G NLogN.KFC.sDP) (.int 0 :: t.G NLogN.KFC.sCQ) (.int 0 :: t.G NLogN.KFC.sDQ)
    (.int 0 :: t.G NLogN.KFC.sCM) (.int 0 :: t.G NLogN.KFC.sDM) (.int 0 :: t.G NLogN.KFC.sCB) (.int 0 :: t.G NLogN.KFC.sDB)
    (by simp +decide [s4, s3, s2, s1, h0, ← hxs])
    (by simp +decide [s4, s3, s2, s1]) (by simp +decide [s4, s3, s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
    (by simp +decide [s4, s3, s2, s1]) (by simp +decide [s4, s3, s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
    (by simp +decide [s4, s3, s2, s1]) (by simp +decide [s4, s3, s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
    (by simp +decide [s4, s3, s2, s1]) (by simp +decide [s4, s3, s2, s1]) (NLogN.KFC.NM_int _ _) (NLogN.KFC.NM_int _ _)
    hr hbr hB1 hq1 hM1
  have w4 := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := 1) (C := NLogN.KFC.sCP) (D := NLogN.KFC.sDP) (X := NLogN.KFC.sX)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s3 P L1 _ (by simp +decide [s3, s2, s1, h1]) NLogN.KFC.coreB _ c4
  have w3 := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := 2) (C := NLogN.KFC.sCQ) (D := NLogN.KFC.sDQ) (X := NLogN.KFC.sX)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s2 q L2 _ (by simp +decide [s2, s1, h2]) _ _ w4
  have w2 := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := 3) (C := NLogN.KFC.sCM) (D := NLogN.KFC.sDM) (X := NLogN.KFC.sX)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s1 M L3 _ (by simp +decide [s1, h3]) _ _ w3
  have w1 := NLogN.KFC.wrap_runs (I := I) (iprog := iprog) (A := 4) (C := NLogN.KFC.sCB) (D := NLogN.KFC.sDB) (X := NLogN.KFC.sX)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) t B L4 _ h4 _ _ w2
  refine w1.mono ?_
  rw [hlo]
  unfold NLogN.KFC.cBwdF NLogN.KFC.cBlkB
  have hk : 200 ≤ NLogN.KFC.kap w := by simp [NLogN.KFC.kap]
  set V := P * q * M * B with hV
  have hPV : P ≤ V := by
    have : P ≤ P * q := Nat.le_mul_of_pos_right _ hq1
    have : P * q ≤ P * q * M := Nat.le_mul_of_pos_right _ hM1
    have : P * q * M ≤ V := Nat.le_mul_of_pos_right _ hB1
    omega
  have hqV : q ≤ V := by
    have : q ≤ P * q := Nat.le_mul_of_pos_left _ hP1
    have : P * q ≤ P * q * M := Nat.le_mul_of_pos_right _ hM1
    have : P * q * M ≤ V := Nat.le_mul_of_pos_right _ hB1
    omega
  have hMV : M ≤ V := by
    have : M ≤ P * q * M := Nat.le_mul_of_pos_left _ (Nat.mul_pos hP1 hq1)
    have : P * q * M ≤ V := Nat.le_mul_of_pos_right _ hB1
    omega
  have hBV : B ≤ V := Nat.le_mul_of_pos_left _ (Nat.mul_pos (Nat.mul_pos hP1 hq1) hM1)
  have e : P * ((2 * q + 10) * NLogN.KFC.kap w * (q * M * B) + 1064) = (2 * q + 10) * NLogN.KFC.kap w * V + 1064 * P := by
    rw [hV]; ring
  rw [e]
  have h7 : 1400 * V ≤ 7 * (NLogN.KFC.kap w * V) := by nlinarith
  have e2 : (2 * q + 18) * NLogN.KFC.kap w * V = (2 * q + 10) * NLogN.KFC.kap w * V + V * NLogN.KFC.kap w + 7 * (NLogN.KFC.kap w * V) := by
    ring
  rw [e2]
  omega
end
