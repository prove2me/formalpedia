theorem Lg_ge' : 1 ≤ Real.log (6 * (lg n : ℝ)) + 1 := by
  rw [six_lg' hn]
  have hb := (setup_facts hn).1
  have : (1 : ℝ) ≤ pP n := by exact_mod_cast (show 1 ≤ pP n by unfold pP; omega)
  have := Real.log_nonneg this; linarith

