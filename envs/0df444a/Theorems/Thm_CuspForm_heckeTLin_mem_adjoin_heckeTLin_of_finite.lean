-- title:
--   T_{ℓ_0} lies in the algebra generated by T_ℓ, ℓ notin S
-- statement:
--   Let $N$ be a non-zero natural number, let $S$ be a set of natural numbers which is assumed finite, and let $\ell_0$ be a prime with $\ell_0 \nmid N$. Write $S_2(\Gamma_0(N))$ for the space `CuspForm (CongruenceSubgroup.Gamma0 N) 2` of weight-two cusp forms for $\Gamma_0(N)$, and for a prime $p \nmid N$ let [`CuspForm.heckeTLin 2`](def/ModularForm_HeckeOperatorForms.html#L69) denote the $\mathbb{C}$-linear endomorphism of this space whose value on $f$ has underlying function $\mathrm{heckeT}\,2\,p\,f = \mathrm{heckeU}\,2\,p\,f + f \mid_{2} \mathrm{heckeDiagMatrix}\,p$ (the usual Hecke operator $T_p$ in weight two). The assertion is that the operator attached to $\ell_0$ belongs to the $\mathbb{C}$-subalgebra `Algebra.adjoin` of $\operatorname{End}_{\mathbb{C}} S_2(\Gamma_0(N))$ generated by the set of those endomorphisms $T$ for which there exists a prime $\ell$ with $\ell \nmid N$ and $\ell \notin S$ such that $T$ is the Hecke operator attached to $\ell$. Thus $T_{\ell_0}$ is a polynomial in the $T_\ell$ with $\ell$ prime, $\ell \nmid N$, $\ell \notin S$.
--
--   This is the standard consequence of the Atkin–Lehner newform decomposition together with strong multiplicity one: omitting finitely many primes from the list of Hecke operators does not shrink the algebra they generate in weight two and level $\Gamma_0(N)$. It is used to transfer statements about a single Hecke operator to the Hecke algebra generated by almost all $T_\ell$, for instance in the analysis of two-dimensional Hecke eigenspaces in the cohomological realisation of $S_2(\Gamma_0(N))$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_heckeTLin_mem_adjoin_heckeTLin_of_finite.lean

import Definitions.Def_ModularForm_HeckeOperatorForms
import Mathlib.RingTheory.Adjoin.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

theorem CuspForm.heckeTLin_mem_adjoin_heckeTLin_of_finite (N : ℕ) [NeZero N] (S : Set ℕ)
    (hSfin : S.Finite) {ℓ₀ : ℕ} (hℓ₀ : ℓ₀.Prime) (hℓ₀N : ¬ ℓ₀ ∣ N) :
    CuspForm.heckeTLin 2 hℓ₀ hℓ₀N ∈ Algebra.adjoin ℂ
      {T : Module.End ℂ (CuspForm (CongruenceSubgroup.Gamma0 N) 2) |
        ∃ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N), ℓ ∉ S ∧ T = CuspForm.heckeTLin 2 hℓ hℓN} := by sorry
