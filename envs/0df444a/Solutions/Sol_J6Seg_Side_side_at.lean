  have key : 10 ^ 8 * (B + 2) ^ 2 + 100000 * (2 * N + 1) * (B + 2) ≤
      10 ^ 9 * (W + 5) ^ 2 * (N * p) := by
    have a1 : (B + 2) ^ 2 ≤ (W + 5) ^ 2 * (N * p) := by
      calc (B + 2) ^ 2 ≤ ((W + 5) * p) ^ 2 := Nat.pow_le_pow_left hB 2
        _ = (W + 5) ^ 2 * (p * p) := by ring
        _ ≤ (W + 5) ^ 2 * (N * p) := Nat.mul_le_mul_left _ (Nat.mul_le_mul_right _ hpT)
    have a2 : (2 * N + 1) * (B + 2) ≤ 3 * (W + 5) ^ 2 * (N * p) := by
      have : W + 5 ≤ (W + 5) ^ 2 := Nat.le_self_pow (by norm_num) _
      calc (2 * N + 1) * (B + 2) ≤ (3 * N) * ((W + 5) * p) := Nat.mul_le_mul (by omega) hB
        _ = 3 * (W + 5) * (N * p) := by ring
        _ ≤ _ := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
    calc _ ≤ 10 ^ 8 * ((W + 5) ^ 2 * (N * p)) + 100000 * (3 * (W + 5) ^ 2 * (N * p)) := 
          Nat.add_le_add (Nat.mul_le_mul_left _ a1)
            (by rw [Nat.mul_assoc]; exact Nat.mul_le_mul_left _ a2)
      _ ≤ _ := by
          have : 10 ^ 8 * ((W + 5) ^ 2 * (N * p)) + 100000 * (3 * (W + 5) ^ 2 * (N * p)) =
              100300000 * ((W + 5) ^ 2 * (N * p)) := by ring
          rw [this]
          have : 10 ^ 9 * (W + 5) ^ 2 * (N * p) = 1000000000 * ((W + 5) ^ 2 * (N * p)) := by ring
          rw [this]; exact Nat.mul_le_mul_right _ (by norm_num)
