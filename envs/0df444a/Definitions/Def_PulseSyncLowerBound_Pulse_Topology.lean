-- title:
--   Finite complexes, geometric connectivity, edge paths and cocycles
-- statement:
--   A finite abstract simplicial complex is a finite family of finite faces closed under nonempty subsets; the optional empty face has no effect on vertices, paths, or the realization. Actual vertices are those with singleton faces, and edges are faces with two distinct vertices. The geometric realization consists of nonnegative barycentric coordinate functions supported on a face, with coordinates summing to one, in the induced topology.
--
--   The degree convention `ConnectedThrough X k` means that the realization is nonempty and its homotopy groups in every degree $0\le j<k$ are trivial at every base point. It therefore means homotopical $(k-1)$-connectivity, including nonempty $(-1)$-connectivity when $k=0$.
--
--   Edge paths allow repeated vertices. Their equivalence is generated by deleting a repeated adjacent vertex or the middle vertex of a triangle, and inverse moves. Simple connectivity means path connectivity and contractibility of every edge loop. An integer edge cocycle satisfies the triangle law, also on repeated vertices. An edge gradient is the difference of an integer vertex potential. Simplicial maps take every face to a face.
--
--   The homotopical and edge-path definitions are independent of the desired cocycle theorem.
-- source:
--   Joel Rybicki, STOC 2027 submission #508 (October 2026), pinned published-basis artifact; §§5.1–5.2; triangle identity (▲); PDF p.16–17 / printed p.14–15; papers/stoc2027-508/source.pdf; SHA-256 5237f877941c17d0913977954f4f4b6ccba70f65ceae5dc47f15029dbd68765f.

import Mathlib
import Mathlib.Topology.Homotopy.HomotopyGroup

noncomputable section

namespace PulseSyncLowerBound.Pulse

attribute [local instance] Classical.propDecidable Classical.decEq

/-- §5.1, PDF 16 / printed 14: finite complexes closed under nonempty subsets; an empty face is optional.
The ambient type need not consist entirely of actual vertices. -/
def IsFiniteComplex {V : Type} (X : Set (Finset V)) : Prop :=
  X.Finite ∧ ∀ s ∈ X, ∀ t : Finset V, t.Nonempty → t ⊆ s → t ∈ X

abbrev Vertices {V : Type} (X : Set (Finset V)) := {v : V // {v} ∈ X}

def IsEdge {V : Type} (X : Set (Finset V)) (u v : V) : Prop :=
  u ≠ v ∧ {u, v} ∈ X

/-- Geometric realization in barycentric coordinates, with the subspace topology
from the product of real lines. Only actual faces support points. -/
def Realization {V : Type} (X : Set (Finset V)) : Set (V → ℝ) :=
  {x | ∃ s ∈ X, (∀ v, 0 ≤ x v) ∧ (∀ v, v ∉ s → x v = 0) ∧ ∑ v ∈ s, x v = 1}

/-- k is one greater than the connectivity degree: k=0 means (-1)-connected.
All first k homotopy groups, including degree zero, are trivial. -/
def ConnectedThrough {V : Type} (X : Set (Finset V)) (k : ℕ) : Prop :=
  Nonempty (Realization X) ∧
    ∀ j : ℕ, j < k → ∀ x : Realization X,
      Subsingleton (HomotopyGroup.Pi j (Realization X) x)

/-- §5.2: repeated adjacent vertices are allowed. -/
def IsEdgePath {V : Type} (X : Set (Finset V)) (p : List V) : Prop :=
  p ≠ [] ∧ (∀ v ∈ p, {v} ∈ X) ∧ p.IsChain (fun u v => {u, v} ∈ X)

/-- The two elementary contractions, applied at any position of an edge path. -/
inductive Contraction {V : Type} (X : Set (Finset V)) : List V → List V → Prop
  | repeat (a b : List V) (u : V)
      (h : IsEdgePath X (a ++ u :: u :: b)) :
      Contraction X (a ++ u :: u :: b) (a ++ u :: b)
  | triangle (a b : List V) (u v w : V)
      (h : IsEdgePath X (a ++ u :: v :: w :: b)) (hf : {u, v, w} ∈ X) :
      Contraction X (a ++ u :: v :: w :: b) (a ++ u :: w :: b)

def EdgePathConnected {V : Type} (X : Set (Finset V)) : Prop :=
  ∀ u v : V, {u} ∈ X → {v} ∈ X → ∃ p : List V,
    IsEdgePath X p ∧ p.head? = some u ∧ p.getLast? = some v

/-- Simple connectivity is defined by contractions, independently of cocycles. -/
def EdgeSimplyConnected {V : Type} (X : Set (Finset V)) : Prop :=
  EdgePathConnected X ∧ ∀ (p : List V) (v : V),
    IsEdgePath X p → p.head? = some v → p.getLast? = some v →
      Relation.EqvGen (Contraction X) p [v]

/-- The triangle law includes repeated vertices. Values off edges are irrelevant. -/
def EdgeCocycle {V : Type} (X : Set (Finset V)) (ω : V → V → ℤ) : Prop :=
  ∀ u v w, {u, v, w} ∈ X → ω u v + ω v w = ω u w

def EdgeGradient {V : Type} (X : Set (Finset V)) (ω : V → V → ℤ) : Prop :=
  ∃ θ : V → ℤ, ∀ u v, {u, v} ∈ X → ω u v = θ v - θ u

/-- Simpliciality includes the assertion that images are actual target vertices. -/
def IsSimplicial {V W : Type} (X : Set (Finset V)) (Y : Set (Finset W))
    (F : V → W) : Prop := ∀ s ∈ X, s.image F ∈ Y

end PulseSyncLowerBound.Pulse


