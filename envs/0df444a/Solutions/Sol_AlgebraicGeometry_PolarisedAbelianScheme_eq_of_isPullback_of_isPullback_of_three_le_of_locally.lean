lemma map_finComb {S : Type u} [CommRing S] {A : Scheme.{u}} {f : A ⟶ Spec (CommRingCat.of S)}
    (L : RelativeGroupLaw S f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of S))
    (Φ : SchemeHomOver t f → SchemeHomOver t f) (hΦ : ∀ x y, Φ (L.mul t x y) = L.mul t (Φ x) (Φ y))
    {m : ℕ} (x : Fin m → SchemeHomOver t f) (c : Fin m → ℕ) :
    Φ (L.finComb t x c) = L.finComb t (Φ ∘ x) c := by
  letI := L.pointGroup t
  have hone : Φ 1 = 1 := by
    have h := hΦ 1 1
    change Φ (1 * 1) = Φ 1 * Φ 1 at h
    rw [mul_one] at h
    exact mul_left_cancel (h.symm.trans (mul_one _).symm)
  let Φ' : SchemeHomOver t f →* SchemeHomOver t f := { toFun := Φ, map_one' := hone, map_mul' := hΦ }
  change Φ' (List.ofFn fun i => x i ^ c i).prod = (List.ofFn fun i => (Φ ∘ x) i ^ c i).prod
  rw [map_list_prod, List.map_ofFn]
  refine congrArg (fun l => List.prod (List.ofFn l)) (funext fun i => ?_)
  change Φ' (x i ^ c i) = (Φ' (x i)) ^ c i
  exact map_pow Φ' _ _

end PasRigid

