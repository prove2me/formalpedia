  have hr : Eval CoreEdgeAddress.code u 10 r := CoreEdgeAddress.eval_code u
  have hrm := hum.command_frame b B K state hB hr CoreEdgeAddress.no_memory
    (fun k hk => CoreEdgeAddress.nat_frame k (by simp only [CoreHost.NatRegisters,List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
    (fun k _ => CoreEdgeAddress.real_frame k)
  have hrs := hus.command_frame B _ N g hr CoreEdgeAddress.no_memory (by decide)
    (fun k hk => CoreEdgeAddress.nat_frame k (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hk;omega))
  have haddr := CoreEdgeAddress.values B e.val u hum.layout.recordBase
    (by simpa only [CoreMemory.encodedEdge,logicalIndex_core_val] using hue) hum.captured.two
  have hptr : r.natReg 576 = CoreMemory.field b B (.inl e) 2 := by
    simpa [CoreMemory.field,logicalIndex_core_val,Nat.add_assoc] using haddr.tail
  let t : Data := {r with realMem := Function.update r.realMem (CoreMemory.field b B (.inl e) 2) (H b/Q b)}
  have ht : Eval (store 576 516) r 1 t := by simpa only [hptr,hrm.parameters.deletedCost] using eval_store r 576 516
  have htm := hrm.write_deletion_cost b B K state e r hB
  have hts := hrs.host_real_memory b B N g r _ (H b/Q b) (CoreHost.address_field b B (.inl e) 2 (by omega))
  have hte : t.natReg 560 = CoreMemory.encodedEdge b (.inl e) :=
    (hr.nat_frame (CoreEdgeAddress.nat_frame 560 (by omega))).trans hue
  exact ⟨t,Eval.seq hu (Eval.seq hr ht),htm,hts,hte⟩
