theorem h4_bOf_bd (S T : ℕ) (hS : 0 < S) (l : ℤ) :
    -(S : ℤ) ≤ 2 * bOf S T l ∧ 2 * bOf S T l ≤ S := by
  unfold bOf
  have hS' : (0 : ℤ) < 2 * S := by omega
  have h1 := Int.ediv_mul_le (2 * (T : ℤ) * l + S) (ne_of_gt hS')
  have h2 := Int.lt_ediv_add_one_mul_self (2 * (T : ℤ) * l + S) hS'
  constructor <;> nlinarith

theorem h4_eKz_ge (S T : ℕ) (hS : 0 < S) (hST : S ≤ T) (l h : ℤ) :
    (S : ℤ) ^ 2 * (|h| * (|h| - 1)) ≤ eKz S T l h := by
  rcases eq_or_ne h 0 with h0 | h0
  · subst h0; simp [eKz]
  unfold eKz
  obtain ⟨a1, a2⟩ := h4_bOf_bd S T hS l
  obtain ⟨b1, b2⟩ := h4_bOf_bd S T hS (l + h)
  have hS0 : (0 : ℤ) < S := by exact_mod_cast hS
  have hST' : (S : ℤ) ≤ T := by exact_mod_cast hST
  set x := bOf S T l
  set y := bOf S T (l + h)
  rcases lt_trichotomy h 0 with hh | hh | hh
  · rw [abs_of_neg hh]
    have e1 : 2 * (T * h + x) ≤ -(S : ℤ) * (2 * -h - 1) := by nlinarith
    have e2 : (S : ℤ) * (2 * -h - 1) ≥ 0 := by nlinarith
    nlinarith
  · exact absurd hh h0
  · rw [abs_of_pos hh]
    have e1 : 2 * (T * h + x) ≥ (S : ℤ) * (2 * h - 1) := by nlinarith
    have e2 : (S : ℤ) * (2 * h - 1) ≥ 0 := by nlinarith
    nlinarith

theorem h4_nat_tail (C r : ℝ) (hC : 0 ≤ C) (hr0 : 0 ≤ r) (hr1 : r < 1) (w : ℕ) (g : ℕ → ℝ)
    (hg0 : ∀ n, 0 ≤ g n) (hgz : ∀ n < w, g n = 0) (hgb : ∀ j, g (j + w) ≤ C * r ^ j) :
    Summable g ∧ ∑' n, g n ≤ C / (1 - r) := by
  have hgeo : Summable (fun j : ℕ => C * r ^ j) := (summable_geometric_of_lt_one hr0 hr1).mul_left C
  have hs : Summable (fun j => g (j + w)) :=
    Summable.of_nonneg_of_le (fun j => hg0 _) hgb hgeo
  have hsum : Summable g := (summable_nat_add_iff w).mp hs
  refine ⟨hsum, ?_⟩
  rw [← hsum.sum_add_tsum_nat_add w]
  have hz : ∑ i ∈ Finset.range w, g i = 0 :=
    Finset.sum_eq_zero fun i hi => hgz i (Finset.mem_range.mp hi)
  rw [hz, zero_add]
  calc ∑' j, g (j + w) ≤ ∑' j, C * r ^ j := Summable.tsum_le_tsum hgb hs hgeo
    _ = C / (1 - r) := by rw [tsum_mul_left, tsum_geometric_of_lt_one hr0 hr1, div_eq_mul_inv]

theorem h4_eEx_bd (S T A : ℕ) (hS : 0 < S) (hST : S ≤ T) (hA : 2 ≤ A) (l : ℤ) (w : ℕ) (k : ℕ)
    (h : ℤ) (hk : |h| = (k + w + 1 : ℕ)) :
