-- title:
--   An explicit catalogue of the 230 space groups of $\mathbb R^3$
-- statement:
--   An explicit catalogue of one crystallographic group of $\mathbb R^3$ for each of the $230$ space-group types of the *International Tables for Crystallography*, Vol. A, written as concrete subgroups of the Euclidean motion group of $E=\mathbb R^3$ (the objects of the LeanEval definition bundle).
--
--   **Lattice coordinates.** Two lattice bases are used: the standard orthonormal basis (`cubic`), and hexagonal axes $a_1=(1,0,0)$, $a_2=(-\tfrac12,\tfrac{\sqrt3}{2},0)$, $a_3=(0,0,1)$ (`hex`). Coordinates $u\in\mathbb R^3$ correspond to the point $u_1a_1+u_2a_2+u_3a_3$.
--
--   **Symmetry operations.** A symmetry operation is a pair $(R,t)$ of an integer $3\times3$ matrix $R$ and an integer vector $t$, standing for the affine map $u\mapsto Ru+t/12$ in lattice coordinates (every translation part occurring in the standard settings is a multiple of $1/12$). Its Euclidean realisation `SymOp.toIsom` is the isometry $g$ of $E$ with $g(u_1a_1+u_2a_2+u_3a_3)=\sum_i (Ru+t/12)_i\,a_i$ whenever such an isometry exists (it exists exactly when $R$ preserves the Gram matrix of the basis, which is the case for every operation used), and the identity otherwise.
--
--   **The groups.** A `SpaceGroupData` is a lattice basis together with a finite list of operations; its group `SpaceGroupData.toSubgroup` is the subgroup of the motion group generated by these operations together with the six lattice translations $\pm a_1,\pm a_2,\pm a_3$. The generators of type number $n$ were taken from the standard setting of ITA Vol. A (given by its Hall symbol: monoclinic groups with unique axis $b$, cell choice 1; origin choice 1 where two origins are tabulated; rhombohedral groups on hexagonal axes); the generated group, modulo lattice translations, is exactly the full list of coordinate triplets of that setting. The second member of each of the $11$ enantiomorphic pairs $(76,78)$, $(91,95)$, $(92,96)$, $(144,145)$, $(151,153)$, $(152,154)$, $(169,170)$, $(171,172)$, $(178,179)$, $(180,181)$, $(212,213)$ is realised as the image of the first member under the point inversion $x\mapsto -x$ (`SpaceGroupData.mirror`, which replaces every $(R,t)$ by $(R,-t)$).
--
--   **Index data.** `spaceGroupCatalog i` is the group of type number $i+1$. `affineRepIndex` lists the $219$ types other than the second members of the enantiomorphic pairs, `affineClassIndex i` is the position in that list of the representative of the affine class of type $i+1$, `enantiomorphicPairs` lists the $11$ pairs, and `sohnckeIndex` lists the $65$ Sohncke types (all operations of positive determinant).
-- source:
--   International Tables for Crystallography, Vol. A (T. Hahn, ed.), space-group tables 1–230 in their standard settings (via Hall symbols; S. R. Hall, Acta Cryst. A37 (1981) 517–525, and ITA Vol. B, Table A1.4.2.7). Enantiomorphic pairs and Sohncke types as in ITA Vol. A, Section 1.4 / Table 1.4.1 (230 types, 219 affine classes, 65 Sohncke types).

import Mathlib
import Definitions.Def_LeanEval_SpaceGroups_Definitions

/-!
# An explicit catalogue of the 230 space-group types

For each of the 230 space-group types of the *International Tables for Crystallography*,
Vol. A, we record a concrete crystallographic subgroup of the Euclidean motion group of
`E 3 = EuclideanSpace ℝ (Fin 3)`.

A group is described in *lattice coordinates*.  A lattice kind fixes a basis
`a₁, a₂, a₃` of `E 3` (the columns of `LatticeKind.basisMatrix`):

* `cubic`: the standard orthonormal basis;
* `hex`: `a₁ = (1, 0, 0)`, `a₂ = (-1/2, √3/2, 0)`, `a₃ = (0, 0, 1)` (hexagonal axes).

A symmetry operation `⟨R, t⟩` (an integer matrix `R` and an integer vector `t`) stands for
the affine map which, in lattice coordinates, is `u ↦ R u + t / 12`.  All translation
parts of space-group operations in the standard settings are multiples of `1/12`.

The group attached to a `SpaceGroupData` is the subgroup generated by the listed operations
together with the six lattice translations `±a₁, ±a₂, ±a₃`.

The generators were taken from the standard (first) Hall setting of every type, i.e. the
setting tabulated in ITA Vol. A (monoclinic groups with unique axis `b`, cell choice 1;
origin choice 1 where two origins are tabulated; rhombohedral groups on hexagonal axes).
The second member of each of the 11 enantiomorphic pairs is realised as the image of the
first member under the point inversion `x ↦ -x` (`SpaceGroupData.mirror`).
-/

namespace LeanEval
namespace Geometry
namespace SpaceGroupsProblem
namespace SpaceGroupCatalog

/-- The two lattice bases used by the catalogue. -/
inductive LatticeKind where
  /-- the standard orthonormal basis of `ℝ³` -/
  | cubic
  /-- hexagonal axes `(1,0,0)`, `(-1/2,√3/2,0)`, `(0,0,1)` -/
  | hex
  deriving DecidableEq

/-- The basis matrix of a lattice kind: its columns are the lattice basis vectors. -/
noncomputable def LatticeKind.basisMatrix : LatticeKind → Matrix (Fin 3) (Fin 3) ℝ
  | .cubic => 1
  | .hex => !![1, -1 / 2, 0; 0, √3 / 2, 0; 0, 0, 1]

/-- Twice the Gram matrix of the lattice basis (an integer matrix). -/
def LatticeKind.gram2 : LatticeKind → Matrix (Fin 3) (Fin 3) ℤ
  | .cubic => !![2, 0, 0; 0, 2, 0; 0, 0, 2]
  | .hex => !![2, -1, 0; -1, 2, 0; 0, 0, 2]

/-- Lattice coordinates `u ↦ u₁ a₁ + u₂ a₂ + u₃ a₃ ∈ E 3`. -/
noncomputable def LatticeKind.coordMap (k : LatticeKind) : (Fin 3 → ℝ) →ₗ[ℝ] E 3 :=
  (WithLp.linearEquiv 2 ℝ (Fin 3 → ℝ)).symm.toLinearMap ∘ₗ Matrix.toLin' k.basisMatrix

/-- A symmetry operation in lattice coordinates: `u ↦ rot u + tr / 12`. -/
structure SymOp where
  /-- the linear part, an integer matrix in lattice coordinates -/
  rot : Matrix (Fin 3) (Fin 3) ℤ
  /-- the translation part, in units of `1/12` of the lattice basis vectors -/
  tr : Fin 3 → ℤ
  deriving DecidableEq

/-- The affine map of lattice coordinates `u ↦ rot u + tr / 12`. -/
noncomputable def SymOp.coordAction (o : SymOp) (u : Fin 3 → ℝ) : Fin 3 → ℝ :=
  Matrix.mulVec (o.rot.map (Int.cast : ℤ → ℝ)) u + fun i => (o.tr i : ℝ) / 12

open Classical in
/-- The Euclidean isometry described by a symmetry operation in the lattice basis `k`:
the isometry `g` with `g (coordMap u) = coordMap (rot u + tr / 12)` for all `u`, whenever
such an isometry exists (it does for every operation used in the catalogue), and the
identity otherwise. -/
noncomputable def SymOp.toIsom (k : LatticeKind) (o : SymOp) : EuclideanIsom 3 :=
  if h : ∃ g : EuclideanIsom 3, ∀ u : Fin 3 → ℝ, g (k.coordMap u) = k.coordMap (o.coordAction u)
  then h.choose else 1

/-- The mirror image of an operation under conjugation by the point inversion `x ↦ -x`. -/
def SymOp.mirror (o : SymOp) : SymOp := ⟨o.rot, -o.tr⟩

/-- The six lattice translations `±a₁, ±a₂, ±a₃` (translation parts in units of `1/12`). -/
def latticeOps : List SymOp :=
  [⟨1, ![12, 0, 0]⟩, ⟨1, ![0, 12, 0]⟩, ⟨1, ![0, 0, 12]⟩,
   ⟨1, ![-12, 0, 0]⟩, ⟨1, ![0, -12, 0]⟩, ⟨1, ![0, 0, -12]⟩]

/-- Data for one space group: a lattice basis and a list of generating operations. -/
structure SpaceGroupData where
  /-- the lattice basis in which the operations are written -/
  kind : LatticeKind
  /-- generating operations (besides the lattice translations) -/
  gens : List SymOp
  deriving DecidableEq

/-- The mirror image of a space group under the point inversion `x ↦ -x`. -/
def SpaceGroupData.mirror (D : SpaceGroupData) : SpaceGroupData :=
  ⟨D.kind, D.gens.map SymOp.mirror⟩

/-- The subgroup of `EuclideanIsom 3` generated by the operations of `D` together with the
lattice translations. -/
noncomputable def SpaceGroupData.toSubgroup (D : SpaceGroupData) : Subgroup (EuclideanIsom 3) :=
  Subgroup.closure {g | ∃ o ∈ latticeOps ++ D.gens, g = o.toIsom D.kind}

