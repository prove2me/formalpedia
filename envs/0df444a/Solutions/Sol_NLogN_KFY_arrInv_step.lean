namespace NLogN.KFY

open IntMul IntMul.HvdH IntMul.HvdH.Ref NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP
open KFB (GI gflat)

theorem length_flatMap_chunk (n m : ℕ) (hn : 0 < n) (f : List GI → List GI)
    (hf : ∀ X : List GI, X.length = n → (f X).length = n) (L : List GI) (hL : L.length = m * n) :
    ((chunkL n L).flatMap f).length = m * n := by
  rw [List.length_flatMap]
  have hc : ∀ X ∈ chunkL n L, X.length = n := by
    intro X hX
    simp only [chunkL, List.mem_map, List.mem_range] at hX
    obtain ⟨i, hi, rfl⟩ := hX
    have hmn : (L.length + n - 1) / n = m := by
      rw [hL]
      rcases Nat.eq_zero_or_pos m with h | h
      · subst h; simp; omega
      · rw [show m * n + n - 1 = m * n + (n - 1) by omega, Nat.add_div_of_dvd_right
          (Dvd.intro_left m rfl), Nat.mul_div_cancel _ hn, Nat.div_eq_of_lt (by omega)]; simp
    rw [hmn] at hi
    simp only [List.length_take, List.length_drop, hL]
    have : (i + 1) * n ≤ m * n := Nat.mul_le_mul_right n hi
    rw [Nat.add_mul, one_mul] at this
    omega
  have hm : (chunkL n L).length = m := by
    simp only [chunkL, List.length_map, List.length_range, hL]
    rcases Nat.eq_zero_or_pos m with h | h
    · subst h; simp; omega
    · rw [show m * n + n - 1 = m * n + (n - 1) by omega, Nat.add_div_of_dvd_right
        (Dvd.intro_left m rfl), Nat.mul_div_cancel _ hn, Nat.div_eq_of_lt (by omega)]; simp
  have : (chunkL n L).map (fun X => (f X).length) = List.replicate m n := by
    rw [List.eq_replicate_iff]
    refine ⟨by simp [hm], fun b hb => ?_⟩
    obtain ⟨X, hX, rfl⟩ := List.mem_map.1 hb
    exact hf X (hc X hX)
  rw [this, List.sum_replicate, smul_eq_mul]

theorem stepL_length (R : List ℕ) (f : List GI → List GI) (hR : R ≠ [])
    (hpos : 0 < R.headD 1)
    (hf : ∀ X : List GI, X.length = R.headD 1 → (f X).length = R.headD 1) (L : List GI) :
    (stepL R f L).length = R.prod := by
  unfold stepL
  rw [length_flatMap_chunk (R.headD 1) R.tail.prod hpos f hf _ (length_transposeL _ _ _)]
  obtain ⟨a, R', rfl⟩ := List.exists_cons_of_ne_nil hR
  simp [mul_comm]

theorem stepL_disc {p : ℕ} (R : List ℕ) (f : List GI → List GI)
    (hf : ∀ X, DiscL p X → DiscL p (f X)) {L : List GI} (hL : DiscL p L) :
    DiscL p (stepL R f L) :=
  discL_stepL _ _ f hf hL

end NLogN.KFY

