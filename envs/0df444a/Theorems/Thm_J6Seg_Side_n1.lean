variable {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D k : ℕ} (ap : AxPlan6) (h : AxNum P n src D k)
include h

theorem J6Seg.Side.n1 :
    (axwd6 P n src k ap + 1) * (axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k + 1) *
        (axfC6 P n + 1) +
      (Nat.size (axpre6 P n D k * axnc6 P n k * 2 ^ axfC6 P n * axpost6 P n D k) +
        axwd6 P n src k ap + axfC6 P n + 4) ^ 2 ≤
      7 * (Wc ap + 9) ^ 2 * (TP6 P n * pP6 P n * (Nat.log 2 (bP6 n) + 1)) := by sorry
