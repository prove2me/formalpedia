theorem bnd_append {B : ℕ} {l l' : List ℤ} (h : Bnd B l) (h' : Bnd B l') : Bnd B (l ++ l') := by
  intro a ha
  rcases List.mem_append.1 ha with ha | ha
  · exact h a ha
  · exact h' a ha

end KIL

end NLogN

