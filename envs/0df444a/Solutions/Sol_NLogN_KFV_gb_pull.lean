section Pull

variable {α : Type*}

theorem mem_pull' {sh sh' : Shape} {g : List ℕ → List ℕ} {d : α} {xs : List α} {x : α}
    (hx : x ∈ pull sh sh' g d xs) : x ∈ xs ∨ x = d := by
  simp only [pull, List.mem_map, List.mem_range] at hx
  obtain ⟨j, -, rfl⟩ := hx
  rw [List.getD_eq_getElem?_getD]
  cases h : xs[encode sh (g (decode sh' j))]? with
  | none => right; rfl
  | some v => left; exact List.mem_of_getElem? h

end Pull

