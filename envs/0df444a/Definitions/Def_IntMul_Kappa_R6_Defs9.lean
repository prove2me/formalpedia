/-!
# Literal constants for the packed kernels

The constants of `R6ChkPack` as numeric literals (so that kernel reduction never recomputes them),
each proved equal to its definition by one kernel evaluation.
-/

namespace R6Chk

def R1L : ℕ := 
def M1L : ℕ := 
def R2L : ℕ := 0x1000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001000000010000000100000001
def R3L : ℕ := 
def LOWL : ℕ := 
def C832L : ℕ := 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
def BAD24L : ℕ := 
def BAD23L : ℕ := 

/-- `dotsP` with literal constants. -/
def dotsF (A B : ℕ) : ℕ := dotsK R1L M1L R2L R3L LOWL A B

/-- `tgt` with the literal constant. -/
def tgtF (o k : ℕ) : ℕ :=
  Nat.shiftLeft (Nat.div (Nat.sub (Nat.shiftLeft 1 (Nat.mul 832 k)) 1) C832L) (Nat.mul 32 o)

