set_option autoImplicit true
open ULHC ULHC.T
variable {α : Type} [DecidableEq α]
variable (NL : List α) (mid tgt : α → Bool) (edgeT : α → α → TimeM Bool) (w : α → ℕ)
namespace ULHC.T
theorem _root_.solution : ∀ k, (layerT NL mid tgt edgeT w k).ret =
    MP.layer NL mid tgt (fun a b => (edgeT a b).ret) w k
  | 0 => rfl
  | k + 1 => by
    simp only [layerT, MP.layer, ret_bind, nextT_ret, solution k]
end ULHC.T
