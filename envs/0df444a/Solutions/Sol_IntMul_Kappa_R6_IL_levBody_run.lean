  split_ifs with h1 h2
  · exact ⟨fun x hx => by simp at hx; omega, by simp; omega⟩
  · exact ⟨fun x hx => by simp at hx; have := (ρ ⟨n - T, h2⟩).2; omega, by simp; omega⟩
  · omega

