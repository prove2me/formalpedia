  have hP0 : (X ^ (l ^ d) - X : (ResidueField R)[X]) ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero _ hq
  have hroot : ∀ s : ℤ_[l] ⊗[ℤ] OE, chi (em 0) s ∈ (X ^ (l ^ d) - X : (ResidueField R)[X]).roots.toFinset := by
