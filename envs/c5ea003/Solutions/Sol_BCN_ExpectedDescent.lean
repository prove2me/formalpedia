open MeasureTheory
open scoped BigOperators

namespace BCN

variable {d : ℕ} {Ω : Type*} [MeasurableSpace Ω]
  {P : Objective d} {C : MomentConstants} {prob : Measure Ω}
  [IsProbabilityMeasure prob] {α : ℕ → ℝ}

lemma Run.w_memLp (R : Run P C prob α) (k : ℕ) : MemLp (R.w k) 2 prob := by
  induction k with
  | zero =>
    have hi : R.w 0 = fun _ ↦ R.w0 := funext R.initial
    rw [hi]
    exact memLp_const _
  | succ k ih =>
    exact (ih.sub ((R.g_squareIntegrable k).const_smul (α k))).ae_eq (R.update k).symm

lemma Run.gradient_adapted (R : Run P C prob α) (k : ℕ) :
    StronglyMeasurable[R.history k] (fun ω ↦ gradient P.F (R.w k ω)) :=
  P.gradient_continuous.comp_stronglyMeasurable (R.w_adapted k)

lemma Run.loss_adapted (R : Run P C prob α) (k : ℕ) :
    StronglyMeasurable[R.history k] (loss R k) :=
  P.continuous.comp_stronglyMeasurable (R.w_adapted k)

lemma Run.gradSq_adapted (R : Run P C prob α) (k : ℕ) :
    StronglyMeasurable[R.history k] (gradSq R k) :=
  (R.gradient_adapted k).norm.pow 2

lemma Run.gradient_memLp (R : Run P C prob α) (k : ℕ) :
    MemLp (fun ω ↦ gradient P.F (R.w k ω)) 2 prob := by
  have hb : MemLp (fun ω ↦ P.L * ‖R.w k ω‖ + ‖gradient P.F 0‖) 2 prob :=
    ((R.w_memLp k).norm.const_mul P.L).add (memLp_const _)
  apply hb.mono' ((R.gradient_adapted k).mono (R.history.le k)).aestronglyMeasurable
  filter_upwards with ω
  exact P.norm_gradient_le (R.w k ω)

lemma Run.gradSq_integrable (R : Run P C prob α) (k : ℕ) :
    Integrable (gradSq R k) prob :=
  (R.gradient_memLp k).norm.integrable_sq

lemma Objective.f_integrable_comp (P : Objective d) {X : Ω → Space d}
    (hX : MemLp X 2 prob) : Integrable (fun ω ↦ P.F (X ω)) prob := by
  have hb : Integrable (fun ω ↦ ‖P.F 0‖ + ‖gradient P.F 0‖ * ‖X ω‖ +
      P.L * ‖X ω‖ ^ 2) prob :=
    ((integrable_const _).add ((hX.integrable (by norm_num)).norm.const_mul _)).add
      (hX.norm.integrable_sq.const_mul _)
  exact hb.mono' (P.continuous.comp_aestronglyMeasurable hX.aestronglyMeasurable)
    (Filter.Eventually.of_forall (fun ω ↦ P.norm_f_le (X ω)))

lemma Run.loss_integrable (R : Run P C prob α) (k : ℕ) :
    Integrable (loss R k) prob :=
  P.f_integrable_comp (R.w_memLp k)

lemma Run.gap_integrable (R : Run P C prob α) (k : ℕ) :
    Integrable (fun ω ↦ P.F (R.w k ω) - optimalValue P) prob :=
  (R.loss_integrable k).sub (integrable_const _)

lemma Run.g_norm_sq_integrable (R : Run P C prob α) (k : ℕ) :
    Integrable (fun ω ↦ ‖R.g k ω‖ ^ 2) prob :=
  (R.g_squareIntegrable k).norm.integrable_sq

lemma Run.expectedGradSq_nonneg (R : Run P C prob α) (k : ℕ) :
    0 ≤ expectedGradSq R k :=
  integral_nonneg (fun _ ↦ sq_nonneg _)

lemma Run.gradientSum_eq_sum (R : Run P C prob α) (K : ℕ) :
    gradientSum R K = ∑ k ∈ Finset.range K, expectedGradSq R k := by
  exact integral_finsetSum _ (fun k _ ↦ R.gradSq_integrable k)

lemma Run.weightedGradientSum_eq_sum (R : Run P C prob α) (K : ℕ) :
    weightedGradientSum R K = ∑ k ∈ Finset.range K, α k * expectedGradSq R k := by
  rw [weightedGradientSum, integral_finsetSum _
    (fun k _ ↦ (R.gradSq_integrable k).const_mul (α k))]
  simp only [integral_const_mul, expectedGradSq]

lemma Run.expectedGap_eq (R : Run P C prob α) (k : ℕ) :
    expectedGap R k = (∫ ω, loss R k ω ∂prob) - optimalValue P := by
  change (∫ ω, loss R k ω - optimalValue P ∂prob) = _
  rw [integral_sub (R.loss_integrable k) (integrable_const _)]
  simp only [integral_const, probReal_univ, one_smul]

lemma Run.expectedGap_zero (R : Run P C prob α) :
    expectedGap R 0 = P.F R.w0 - optimalValue P := by
  simp [expectedGap, R.initial]

lemma Run.expected_loss_lower (R : Run P C prob α) (k : ℕ) :
    R.lower ≤ ∫ ω, loss R k ω ∂prob := by
  have h := integral_mono_ae (integrable_const R.lower) (R.loss_integrable k)
    ((R.in_region k).mono (fun ω hω ↦ R.lower_bound _ hω))
  simpa using h

lemma Run.loss_condExp (R : Run P C prob α) (k : ℕ) :
    prob[loss R k | R.history k] = loss R k :=
  condExp_of_stronglyMeasurable (R.history.le k) (R.loss_adapted k) (R.loss_integrable k)

lemma Run.gradSq_condExp (R : Run P C prob α) (k : ℕ) :
    prob[gradSq R k | R.history k] = gradSq R k :=
  condExp_of_stronglyMeasurable (R.history.le k) (R.gradSq_adapted k)
    (R.gradSq_integrable k)

