/-- Generic coefficient-field certificates spread to the exact principal-open target. -/
theorem transverse_sections_of_generic_certificates
    (K : Type*) [NontriviallyNormedField K] (hK : IsPhilipponBaseField K)
    (hgeometry :
    ∀ (M : MultiProjectiveSpace K) (W : Set M.Point),
      @IsClosed _ M.zariskiTopology W → @IsIrreducible _ M.zariskiTopology W →
      ∀ (α : M.FactorIndex → ℕ), (∀ i, α i ≤ M.ambientDimension i) →
      (∑ i, α i = locusDimension M W) →
      ∀ B : Set M.Point, @IsClosed _ M.zariskiTopology B → B ⊆ W →
      (W \ B).Nonempty →
      ∀ l : List M.FactorIndex, (∀ i, l.count i = α i) →
        ∀ b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1),
          (GenericMixedSections.jacobianIdeal
            (GenericMixedSections.normalizedIdeal M l W b)).map
              (GenericMixedSections.genericMap M l) = ⊤ ∧
          (GenericMixedSections.normalizedIdeal M l B b).map
            (GenericMixedSections.genericMap M l) = ⊤) :
    ∀ (M : MultiProjectiveSpace K) (W : Set M.Point),
      @IsClosed _ M.zariskiTopology W → @IsIrreducible _ M.zariskiTopology W →
      ∀ (α : M.FactorIndex → ℕ), (∀ i, α i ≤ M.ambientDimension i) →
      (∑ i, α i = locusDimension M W) →
      ∀ B : Set M.Point, @IsClosed _ M.zariskiTopology B → B ⊆ W →
      (W \ B).Nonempty →
      ∀ l : List M.FactorIndex, (∀ i, l.count i = α i) →
        ∃ F : MvPolynomial (Fin l.length × M.Variable) K, F ≠ 0 ∧
          ∀ c : Fin l.length → M.Variable → K,
            MvPolynomial.eval (Function.uncurry c) F ≠ 0 →
            Disjoint {x : M.Point | x ∈ W ∧
              ∀ j : Fin l.length, M.eval (MixedFlag.polynomial M l c j) x = 0} B ∧
            (∀ b : ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1),
              let J := MixedFlag.ideal M (M.vanishingIdeal W) l c l.length ⊔
                Ideal.span (Set.range (fun i : M.FactorIndex =>
                  (MvPolynomial.X (⟨i,b i⟩ : M.Variable) : M.CoordinateRing) - 1))
              ∀ a : M.Variable → K, (∀ P ∈ J, MvPolynomial.eval a P = 0) →
                ∃ Q : M.Variable → M.CoordinateRing, (∀ i, Q i ∈ J) ∧
                  MvPolynomial.eval a
                    (Matrix.of (fun i j => MvPolynomial.pderiv j (Q i))).det ≠ 0) := by
  classical
  intro M W hW hWi α hα hdim B hB hBW hWB l hl
  have hg := hgeometry M W hW hWi α hα hdim B hB hBW hWB l hl
  let Pivot := ∀ i : M.FactorIndex, Fin (M.ambientDimension i + 1)
  let I : Bool × Pivot → Ideal (UniversalRing M l) := fun s =>
    if s.1 then jacobianIdeal (normalizedIdeal M l W s.2)
    else normalizedIdeal M l B s.2
  have hI (s : Bool × Pivot) :
      (I s).map (map (algebraMap (CoeffRing M l) (FractionRing (CoeffRing M l)))) = ⊤ := by
    rcases s with ⟨t,b⟩
    cases t
    · simpa only [I, Bool.false_eq_true, if_false, genericMap] using (hg b).2
    · simpa only [I, if_true, genericMap] using (hg b).1
  obtain ⟨F, hF, hspread⟩ := finite_family_spreads (K := K) I hI
  refine ⟨F, hF, ?_⟩
  intro c hc
  have hs := hspread (eval (Function.uncurry c)) hc
  refine ⟨boundary_disjoint M l W B c ?_, ?_⟩
  · intro b
    have htop : (normalizedIdeal M l B b).map (map (eval (Function.uncurry c))) = ⊤ := by
      simpa only [I, Bool.false_eq_true, if_false] using hs (false,b)
    apply top_unique
    rw [← htop]
    exact specialize_normalizedIdeal_le M l B c b
  · intro b
    apply pointwise_of_jacobianIdeal_eq_top
    have htop : (jacobianIdeal (normalizedIdeal M l W b)).map
        (map (eval (Function.uncurry c))) = ⊤ := by
      simpa only [I, if_true] using hs (true,b)
    apply top_unique
    rw [← htop]
    exact map_jacobianIdeal_le _ _ _ (specialize_normalizedIdeal_le M l W c b)

end PhilipponMultiplicity.GenericMixedSections
end
