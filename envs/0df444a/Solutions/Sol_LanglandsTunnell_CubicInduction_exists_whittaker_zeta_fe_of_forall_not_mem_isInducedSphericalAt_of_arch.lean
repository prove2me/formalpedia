p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField NumberField.StandardAddChar

private noncomputable def aInfOf (a : ℚ) (ha : a ≠ 0) : (InfiniteAdeleRing ℚ)ˣ :=
  Units.map (algebraMap ℚ (InfiniteAdeleRing ℚ) : ℚ →* InfiniteAdeleRing ℚ) (Units.mk0 a ha)

private theorem coe_aInfOf (a : ℚ) (ha : a ≠ 0) :
    (aInfOf a ha : InfiniteAdeleRing ℚ) = algebraMap ℚ (InfiniteAdeleRing ℚ) a := rfl

private noncomputable def psiInfOf (a : ℚ) : AddChar (InfiniteAdeleRing ℚ) ℂ :=
  StandardAddChar.psiArch.compAddMonoidHom (AddMonoidHom.mulLeft (algebraMap ℚ (InfiniteAdeleRing ℚ) a))

private theorem psiInfOf_apply (a : ℚ) : ∀ x : InfiniteAdeleRing ℚ,
    psiInfOf a x = StandardAddChar.psiArch (algebraMap ℚ (InfiniteAdeleRing ℚ) a * x) := fun _ => rfl

private theorem compAddMonoidHom_inl_eq_psiInfOf (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (a : ℚ)
    (hψa : ∀ x, ψ x = StandardAddChar.psiQ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x)) :
    ψ.compAddMonoidHom (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)) = psiInfOf a := by
  ext x
  rw [AddChar.compAddMonoidHom_apply, hψa, psiInfOf_apply]
  show StandardAddChar.psiArch (algebraMap ℚ (InfiniteAdeleRing ℚ) a * x) *
      StandardAddChar.psiFin (algebraMap ℚ (FiniteAdeleRing (𝓞 ℚ) ℚ) a * 0) = _
  rw [mul_zero, AddChar.map_zero_eq_one, mul_one]

private theorem traceInfHom_rat (x : InfiniteAdeleRing ℚ) : traceInfHom ℚ x = x := by
  funext v
  rw [traceInfHom_apply, ratArchLine_apply, RingEquiv.symm_apply_eq]
  unfold infTraceSum
  rw [Fintype.sum_subsingleton _ v]
  have hm : InfinitePlace.mult v = 1 := InfinitePlace.mult_isReal ⟨v, isReal_rat_infinitePlace v⟩
  have hre : (InfinitePlace.Completion.extensionEmbedding v (x v)).re =
      InfinitePlace.Completion.extensionEmbeddingOfIsReal (isReal_rat_infinitePlace v) (x v) := by
    rw [← InfinitePlace.Completion.extensionEmbeddingOfIsReal_apply]
    exact Complex.ofReal_re _
  rw [hm, Nat.cast_one, one_mul, hre, InfinitePlace.Completion.ringEquivRealOfIsReal_apply]

private theorem compAddMonoidHom_inl_eq_psiInfOf_of_stdAddChar (ψ : AddChar (AdeleRing (𝓞 ℚ) ℚ) ℂ) (a : ℚ)
    (hψa : ∀ x, ψ x = stdAddChar ℚ (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) a * x)) :
    ψ.compAddMonoidHom (AddMonoidHom.inl (InfiniteAdeleRing ℚ) (FiniteAdeleRing (𝓞 ℚ) ℚ)) = psiInfOf a := by
  ext x
  rw [AddChar.compAddMonoidHom_apply, hψa, psiInfOf_apply]
  show psiArch (traceInfHom ℚ (algebraMap ℚ (InfiniteAdeleRing ℚ) a * x)) *
      psiFin ((adelicTraceData ℚ).traceFin (algebraMap ℚ (FiniteAdeleRing (𝓞 ℚ) ℚ) a * 0)) = _
  rw [mul_zero, map_zero, traceInfHom_rat, AddChar.map_zero_eq_one, mul_one]

end LanglandsTunnell.CubicInduction.ArchCharacterTie

