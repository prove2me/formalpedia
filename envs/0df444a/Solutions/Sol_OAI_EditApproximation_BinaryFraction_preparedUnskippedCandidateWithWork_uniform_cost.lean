namespace OAI

/-! Every child-grid list is constructed before the Cartesian product.
These bounds include the balanced endpoints, integer spacing and radius,
endpoint translations, and the two bounded grid loops. -/

namespace EditApproximation

theorem seedGridSpacingWithWork_bounds (b P B : ℕ)
    (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (seedGridSpacingWithWork b P).1.length ≤ B + 1 ∧
      (seedGridSpacingWithWork b P).2 ≤ 100 * (B + 2) ^ 2 := by
  let quotient := binaryNaturalDivModWithWork b P
  have hl := (bitDivModWithWork_lengths P.bits b.bits).1
  change quotient.1.length = b.bits.length at hl
  rw [Nat.size_eq_bits_len] at hl
  have hd := binaryNaturalDivModWithWork_cost b P
  have ht := wordLEWithWork_cost quotient.1 [true]
  change quotient.2.2 ≤ _ at hd
  simp only [List.length_cons, List.length_nil] at ht
  unfold seedGridSpacingWithWork
  dsimp only
  constructor
  · split_ifs
    · simp only [List.length_cons, List.length_nil]
      omega
    · change quotient.1.length ≤ B + 1
      omega
  · change quotient.2.2 + (wordLEWithWork quotient.1 [true]).2 + 2 ≤ _
    nlinarith only [hd, ht, hl, hb, hP, Nat.zero_le B]

theorem gridStateBoxBitBudget_mono_count (k l B : ℕ) (h : k ≤ l) :
    gridStateBoxBitBudget k B ≤ gridStateBoxBitBudget l B := by
  unfold gridStateBoxBitBudget gridPointsBitBudget
  gcongr

theorem wideChildGridWithWork_cost {nx ny M : ℕ} (parent : TargetInterval nx)
    (r : TargetInterval ny) (b P B : ℕ) (i : Fin M) (hPpos : 0 < P)
    (hnx : Nat.size nx ≤ B) (hny : Nat.size ny ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (wideChildGridWithWork parent r b P i).2 ≤ wideChildGridBitBudget P B := by
  let child := sourceChildWithWork parent i
  let spacing := seedGridSpacingWithWork b P
  let radius := binaryNaturalMulWithWork 10 b
  let leftOffset := saturatingSubtractWithWork child.1.lo parent.lo
  let rightOffset := saturatingSubtractWithWork child.1.hi parent.lo
  let left := binaryNaturalAddWithWork r.lo (bitWordValue leftOffset.1)
  let right := binaryNaturalAddWithWork r.lo (bitWordValue rightOffset.1)
  have hparent : Nat.size parent.lo ≤ B :=
    (Nat.size_le_size (parent.ordered.trans parent.valid)).trans hnx
  have hcl : Nat.size child.1.lo ≤ B :=
    (Nat.size_le_size (child.1.ordered.trans child.1.valid)).trans hnx
  have hch : Nat.size child.1.hi ≤ B := (Nat.size_le_size child.1.valid).trans hnx
  have hrlo : Nat.size r.lo ≤ B := (Nat.size_le_size (r.ordered.trans r.valid)).trans hny
  have hlo : Nat.size (bitWordValue leftOffset.1) ≤ B := by
    rw [saturatingSubtractWithWork_value]
    exact (Nat.size_le_size (Nat.sub_le _ _)).trans hcl
  have hro : Nat.size (bitWordValue rightOffset.1) ≤ B := by
    rw [saturatingSubtractWithWork_value]
    exact (Nat.size_le_size (Nat.sub_le _ _)).trans hch
  have hleft : Nat.size (bitWordValue left.1) ≤ B + 2 := by
    rw [binaryNaturalAddWithWork_value]
    exact (binaryNaturalAdd_size_le _ _).trans (by omega)
  have hright : Nat.size (bitWordValue right.1) ≤ B + 2 := by
    rw [binaryNaturalAddWithWork_value]
    exact (binaryNaturalAdd_size_le _ _).trans (by omega)
  have hspacing := seedGridSpacingWithWork_bounds b P B hb hP
  have hspacingCost : spacing.2 ≤ 100 * (B + 2) ^ 2 := hspacing.2
  have hgs : Nat.size (bitWordValue spacing.1) ≤ B + 1 :=
    (Nat.size_le.mpr (bitWordValue_lt_pow_length spacing.1)).trans hspacing.1
  have hrl := bitMulWithWork_length (10 : ℕ).bits b.bits
  change radius.1.length ≤ _ at hrl
  simp only [Nat.size_eq_bits_len] at hrl
  have hten : Nat.size 10 = 4 := by decide
  rw [hten] at hrl
  have hrs : Nat.size (bitWordValue radius.1) ≤ B + 9 :=
    (Nat.size_le.mpr (bitWordValue_lt_pow_length radius.1)).trans (by omega)
  have hg := seedGridSpacingWithWork_pos b P hPpos
  have hgrid := gridStateBoxWithWork_cost ny (bitWordValue spacing.1) (bitWordValue radius.1)
    (bitWordValue left.1) (bitWordValue right.1) (B + 12) hg
    (by omega) (by omega) (by omega) (by omega) (by omega)
  have hcount : 2 * bitWordValue radius.1 / bitWordValue spacing.1 + 2 ≤ 40 * P + 2 := by
    rw [binaryNaturalMulWithWork_value, seedGridSpacingWithWork_value b P hPpos]
    simpa only [show 2 * (10 * b) = 20 * b by omega] using seedGridSpacing_radius_count b P hPpos
  have hgrid' := hgrid.trans (gridStateBoxBitBudget_mono_count _ _ (B + 12) hcount)
  have hc := sourceChildWithWork_cost parent i B hnx hM
  have hrad := binaryNaturalMulWithWork_cost 10 b
  have hol := saturatingSubtractWithWork_cost child.1.lo parent.lo
  have hor := saturatingSubtractWithWork_cost child.1.hi parent.lo
  have hal := binaryNaturalAddWithWork_cost r.lo (bitWordValue leftOffset.1)
  have har := binaryNaturalAddWithWork_cost r.lo (bitWordValue rightOffset.1)
  change child.2 ≤ _ at hc
  change radius.2 ≤ _ at hrad
  change leftOffset.2 ≤ _ at hol
  change rightOffset.2 ≤ _ at hor
  change left.2 ≤ _ at hal
  change right.2 ≤ _ at har
  rw [hten] at hrad
  change child.2 + spacing.2 + radius.2 + leftOffset.2 + rightOffset.2 + left.2 + right.2 + _ + 8 ≤ _
  unfold wideChildGridBitBudget
  nlinarith only [hc, hspacingCost, hrad, hol, hor, hal, har, hgrid', hcl, hch, hparent,
    hrlo, hlo, hro, hb, Nat.zero_le B]

end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryPreparedRepresentativeWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! Complete representative work, with every endpoint grid construction
and every score/prefix predicate charged. Only input word bounds occur. -/

namespace EditApproximation
namespace BinaryFraction

theorem wideActionGridWithWork_complete_cost {nx ny : ℕ} (M : ℕ)
    (parent : TargetInterval nx) (center : TargetInterval ny) (b P B : ℕ)
    (hPpos : 0 < P) (hnx : Nat.size nx ≤ B) (hny : Nat.size ny ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b ≤ B) (hP : Nat.size P ≤ B) :
    (wideActionGridWithWork M parent center b P).2 ≤ wideMaterializationBitBudget M P B :=
  wideActionGridWithWork_cost M parent center b P _ hPpos
    (fun i => wideChildGridWithWork_cost parent center b P B i hPpos hnx hny hM hb hP)

end BinaryFraction
end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Geometry_LocalArithmeticBudget
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! The compiled optimizer counter specialized to the literal representative
bands. Preparation of the input arrays remains a separate finite loop. -/

namespace EditApproximation

theorem computedBandActions_length_le {nx ny M : ℕ} (parent : TargetInterval nx)
    (r : TargetInterval ny) (b P : ℕ) (tau theta velocity : ℚ)
    (child : Fin M → TargetInterval ny → ℚ) :
    (computedBandActions parent r b P tau theta velocity child).length ≤
      (wideActionList M parent r b P).length := by
  dsimp only [computedBandActions]
  split_ifs <;> first | exact List.length_filter_le _ _ | exact Nat.zero_le _

theorem representativeBandActions_length_le {α : Type*} (source target : List α) {M : ℕ}
    (parent : TargetInterval source.length) (r : TargetInterval target.length)
    (b P : ℕ) (tau theta : ℚ) (child : Fin M → TargetInterval target.length → ℚ) :
    (representativeBandActions source target parent r b P tau theta child).length ≤
      (wideActionList M parent r b P).length := by
  dsimp only [representativeBandActions]
  split_ifs <;> first | exact computedBandActions_length_le _ _ _ _ _ _ _ _ | exact Nat.zero_le _

end EditApproximation

end OAI
end

section
-- module Solutions.OAIQ361V3_EA.EditApproximation_Binary_BinaryPreparedUnskippedWork
set_option linter.all false
set_option linter.unusedVariables false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false

namespace OAI

/-! The complete unskipped-band constructor pays for both actual wide
grids, every prefix predicate, all child envelopes, and the final guards. -/

namespace EditApproximation
namespace BinaryFraction

theorem representativeCompleteBitBudget_mono_vertices (M v w B : ℕ) (h : v ≤ w) :
    representativeCompleteBitBudget M v B ≤ representativeCompleteBitBudget M w B := by
  unfold representativeCompleteBitBudget representativeTailBitBudget bandFromActionsBitBudget
    wideMinimumBitBudget bandPredicateBitBudget anchorGuardBitBudget bandToleranceBitBudget
    representativeGuardInputBudget naturalDistanceBitBudget
  dsimp only
  gcongr

theorem unskippedGuardBitBudget_mono_vertices (e b M v v' w w' B : ℕ)
    (hv : v ≤ v') (hw : w ≤ w') :
    unskippedGuardBitBudget e b M v w B ≤ unskippedGuardBitBudget e b M v' w' B := by
  unfold unskippedGuardBitBudget roundedBandBitBudget bandEnvelopeBitBudget
  dsimp only
  gcongr

theorem preparedUnskippedBitBudget_mono_vertices (e b M P v v' w w' B : ℕ)
    (hv : v ≤ v') (hw : w ≤ w') :
    preparedUnskippedBitBudget e b M P v w B ≤ preparedUnskippedBitBudget e b M P v' w' B := by
  have hr := representativeCompleteBitBudget_mono_vertices M w w' (4 * B + 20) hw
  have hg := unskippedGuardBitBudget_mono_vertices e b M v v' w w' B hv hw
  unfold preparedUnskippedBitBudget
  omega

theorem preparedUnskippedCandidateWithWork_cost {α : Type*} (source target : List α)
    {M : ℕ} (parent : TargetInterval source.length) (b P e B : ℕ)
    (hbpos : 0 < b) (hPpos : 0 < P) (tau F : BinaryFraction)
    (child initial : Fin M → TargetInterval target.length → BinaryFraction)
    (center : TargetInterval target.length)
    (hnx : Nat.size source.length + 2 ≤ B) (hny : Nat.size target.length + 2 ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b + 2 ≤ B) (hP : Nat.size P ≤ B)
    (he : e + 1 ≤ B) (htau : tau.width ≤ B) (hF : F.width ≤ B)
    (hchild : ∀ i q, (child i q).width ≤ B)
    (hinitial : ∀ i q, (initial i q).width ≤ B) :
    let band := preparedRepresentativeWithWork parent center (parent.hi - parent.lo) b P
      tau (inversePowerTwo e) child
    let wide := wideActionGridWithWork M parent center b P
    (preparedUnskippedCandidateWithWork source target parent b P e hbpos hPpos tau F
      child initial center).2 ≤ preparedUnskippedBitBudget e b M P band.1.length wide.1.length B := by
  dsimp only
  let band := preparedRepresentativeWithWork parent center (parent.hi - parent.lo) b P
    tau (inversePowerTwo e) child
  let wide := wideActionGridWithWork M parent center b P
  have htheta : (inversePowerTwo e).width ≤ B := by
    rw [inversePowerTwo_width]
    exact he
  have hband := preparedRepresentativeWithWork_complete_cost parent center b P B hPpos tau
    (inversePowerTwo e) child (by omega) (by omega) hM (by omega) hP htau htheta hchild
  have hwide := wideActionGridWithWork_complete_cost M parent center b P B hPpos
    (by omega) (by omega) hM (by omega) hP
  change band.2 ≤ wideMaterializationBitBudget M P B +
    representativeCompleteBitBudget M wide.1.length (4 * B + 20) + wide.1.length + 1 at hband
  change wide.2 ≤ wideMaterializationBitBudget M P B at hwide
  change (preparedUnskippedCandidateWithWork source target parent b P e hbpos hPpos tau F
    child initial center).2 ≤ preparedUnskippedBitBudget e b M P band.1.length wide.1.length B
  unfold preparedUnskippedCandidateWithWork
  dsimp only
  by_cases hempty : band.1 = []
  · rw [dite_eq_left hempty]
    change band.2 + 1 ≤ _
    unfold preparedUnskippedBitBudget
    omega
  · rw [dite_eq_right hempty]
    have hguard := unskippedGuardWithWork_cost parent center b e F band.1
      (wide.1.map Vector.get) hempty initial B hF hb hnx hny
      (fun action _ i => hinitial i (action i))
    simp only [List.length_map] at hguard
    split_ifs
    all_goals
      change band.2 + wide.2 +
        (unskippedGuardWithWork parent center b e F band.1 (wide.1.map Vector.get) hempty initial).2 +
          wide.1.length + _ ≤ _
      unfold preparedUnskippedBitBudget
      omega

theorem preparedUnskippedCandidateWithWork_uniform_cost_oai {α : Type*} (source target : List α)
    {M : ℕ} (parent : TargetInterval source.length) (b P e B : ℕ)
    (hbpos : 0 < b) (hPpos : 0 < P) (tau F : BinaryFraction)
    (child initial : Fin M → TargetInterval target.length → BinaryFraction)
    (center : TargetInterval target.length)
    (hnx : Nat.size source.length + 2 ≤ B) (hny : Nat.size target.length + 2 ≤ B)
    (hM : Nat.size M ≤ B) (hb : Nat.size b + 2 ≤ B) (hP : Nat.size P ≤ B)
    (he : e + 1 ≤ B) (htau : tau.width ≤ B) (hF : F.width ≤ B)
    (hchild : ∀ i q, (child i q).width ≤ B)
    (hinitial : ∀ i q, (initial i q).width ≤ B) :
    (preparedUnskippedCandidateWithWork source target parent b P e hbpos hPpos tau F
      child initial center).2 ≤ preparedUnskippedBitBudget e b M P
        ((40 * P + 2) ^ (2 * M)) ((40 * P + 2) ^ (2 * M)) B := by
  apply (preparedUnskippedCandidateWithWork_cost source target parent b P e B hbpos hPpos
    tau F child initial center hnx hny hM hb hP he htau hF hchild hinitial).trans
  apply preparedUnskippedBitBudget_mono_vertices
  · rw [preparedRepresentativeWithWork_value source target parent center b P hPpos]
    exact (representativeBandActions_length_le source target parent center b P tau.value
      (inversePowerTwo e).value (fun i q => (child i q).value)).trans
        (wideActionList_length_le M parent center b P hPpos)
  · have h := congrArg List.length (wideActionGridWithWork_value M parent center b P hPpos)
    simp only [List.length_map] at h
    rw [h]
    exact wideActionList_length_le M parent center b P hPpos

end BinaryFraction
end EditApproximation

end OAI
end

theorem solution.{u_1} : type_of% @OAI.EditApproximation.BinaryFraction.preparedUnskippedCandidateWithWork_uniform_cost_oai.{u_1} := @OAI.EditApproximation.BinaryFraction.preparedUnskippedCandidateWithWork_uniform_cost_oai.{u_1}
