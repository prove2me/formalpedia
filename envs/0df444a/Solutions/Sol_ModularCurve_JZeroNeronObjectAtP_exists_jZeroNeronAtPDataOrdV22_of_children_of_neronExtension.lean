theorem ModularCurve.JZeroNeronObjectAtP.exists_toricHull
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ)
    (hE1 : ∀ (m : ℕ), 0 < m → ∀ x ∈ O.toricPts m,
      degeneracyPushforwardPair N₀ p 0 x = 0 ∧ degeneracyPushforwardPair N₀ p 1 x = 0)
    (c : ℕ) (hc : 0 < c)
    (hE2 : ∀ (m : ℕ), 0 < m → ∀ x ∈ O.finPts m,
      degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 → c • x ∈ O.toricPts m)
    (hTF : ∀ (m : ℕ), O.toricPts m ≤ O.finPts m)
    (hTH : ∀ (m : ℕ), 0 < m → letI := heckeModuleBar (N₀ * p);
      ∀ (t : HeckeAlg), ∀ x ∈ O.toricPts m, t • x ∈ O.toricPts m) :
    ∃ T₀ : AddSubgroup (JZero (N₀ * p)),
      (∀ m, 0 < m → T₀ ⊓ jZeroTorsion (N₀ * p) m = O.toricPts m) ∧
      T₀ ≤ O.extPts ∧
      (∀ y ∈ T₀, degeneracyPushforwardPair N₀ p 0 y = 0 ∧ degeneracyPushforwardPair N₀ p 1 y = 0) ∧
      (∀ (t : HeckeAlg), ∀ y ∈ T₀, (letI := heckeModuleBar (N₀ * p); t • y) ∈ T₀) ∧
      (∀ σ ∈ A.decompositionSubgroup ℚ, ∀ y ∈ T₀, σ • y ∈ T₀) ∧
      (∀ x ∈ O.extPts, degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 →
        c • x ∈ T₀) := by
  classical
  letI hb : Module HeckeAlg (JZero (N₀ * p)) := heckeModuleBar (N₀ * p)
  have hTI : ∀ m m', 0 < m → 0 < m' → m ∣ m' → O.toricPts m = O.toricPts m' ⊓ jZeroTorsion (N₀ * p) m :=
    fun m m' _ hm' h => ModularCurve.JZeroNeronObjectAtP.toricPts_eq_inf N₀ p hpN₀ A hA Λ hΛ O m m' h hm'
  have htors : ∀ n, O.toricPts n ≤ jZeroTorsion (N₀ * p) n := fun n => (hTF n).trans (O.finPts_le_torsion n)
  have hmono : ∀ n n', 0 < n → 0 < n' → n ∣ n' → O.toricPts n ≤ O.toricPts n' := by
    intro n n' hn hn' h; rw [hTI n n' hn hn' h]; exact inf_le_left
  let EO : AddSubgroup (JZero (N₀ * p)) := O.extPts
  let K : AddSubgroup (JZero (N₀ * p)) :=
    EO ⊓ (degeneracyPushforwardPair N₀ p 0).ker ⊓ (degeneracyPushforwardPair N₀ p 1).ker
  let Tsup : AddSubgroup (JZero (N₀ * p)) := AddSubgroup.closure {y | ∃ n, 0 < n ∧ y ∈ O.toricPts n}
  let cK : AddSubgroup (JZero (N₀ * p)) := K.map (nsmulAddMonoidHom c)
  let T₀ : AddSubgroup (JZero (N₀ * p)) := Tsup ⊔ cK
  have hTsup_mem : ∀ y ∈ Tsup, ∃ n, 0 < n ∧ y ∈ O.toricPts n := by
    intro y hy
    induction hy using AddSubgroup.closure_induction with
    | mem y hy => exact hy
    | zero => exact ⟨1, Nat.one_pos, AddSubgroup.zero_mem _⟩
    | add y z _ _ hy hz =>
        obtain ⟨n, hn, hy⟩ := hy
        obtain ⟨n', hn', hz⟩ := hz
        refine ⟨n * n', Nat.mul_pos hn hn', AddSubgroup.add_mem _ ?_ ?_⟩
        · exact hmono n (n * n') hn (Nat.mul_pos hn hn') (dvd_mul_right n n') hy
        · exact hmono n' (n * n') hn' (Nat.mul_pos hn hn') (dvd_mul_left n' n) hz
    | neg y _ hy =>
        obtain ⟨n, hn, hy⟩ := hy
        exact ⟨n, hn, AddSubgroup.neg_mem _ hy⟩
  have hle_Tsup : ∀ n, 0 < n → O.toricPts n ≤ Tsup :=
    fun n hn y hy => AddSubgroup.subset_closure ⟨n, hn, hy⟩
  have hK_mem : ∀ {k}, k ∈ K ↔
      k ∈ EO ∧ degeneracyPushforwardPair N₀ p 0 k = 0 ∧ degeneracyPushforwardPair N₀ p 1 k = 0 := by
    intro k
    change k ∈ EO ⊓ _ ⊓ _ ↔ _
    rw [AddSubgroup.mem_inf, AddSubgroup.mem_inf, AddMonoidHom.mem_ker, AddMonoidHom.mem_ker, and_assoc]
  have hcK_mem : ∀ {y}, y ∈ cK ↔ ∃ k ∈ K, c • k = y := by
    intro y; exact AddSubgroup.mem_map
  have hT₀_mem : ∀ {y}, y ∈ T₀ ↔ ∃ t ∈ Tsup, ∃ u ∈ cK, t + u = y := by
    intro y; exact AddSubgroup.mem_sup

  have hT₀_le_EO : T₀ ≤ EO := by
    apply sup_le
    · intro y hy
      obtain ⟨n, hn, hy⟩ := hTsup_mem y hy
      exact O.finPts_le_extPts n (hTF n hy)
    · rintro y hy
      obtain ⟨k, hk, rfl⟩ := hcK_mem.mp hy
      exact AddSubgroup.nsmul_mem _ (hK_mem.mp hk).1 c

  have hT₀_ker : ∀ y ∈ T₀, degeneracyPushforwardPair N₀ p 0 y = 0 ∧ degeneracyPushforwardPair N₀ p 1 y = 0 := by
    intro y hy
    obtain ⟨t, ht, u, hu, rfl⟩ := hT₀_mem.mp hy
    obtain ⟨n, hn, ht⟩ := hTsup_mem t ht
    obtain ⟨k, hk, rfl⟩ := hcK_mem.mp hu
    obtain ⟨-, hk0, hk1⟩ := hK_mem.mp hk
    obtain ⟨ht0, ht1⟩ := hE1 n hn t ht
    refine ⟨?_, ?_⟩
    · rw [map_add, map_nsmul, ht0, hk0, nsmul_zero, add_zero]
    · rw [map_add, map_nsmul, ht1, hk1, nsmul_zero, add_zero]

  have toric_pos : ∀ m, 0 < m → T₀ ⊓ jZeroTorsion (N₀ * p) m = O.toricPts m := by
    intro m hm
    apply le_antisymm
    · rintro y ⟨hy, hym⟩
      obtain ⟨t, ht, u, hu, rfl⟩ := hT₀_mem.mp hy
      obtain ⟨n, hn, ht⟩ := hTsup_mem t ht
      obtain ⟨k, hk, rfl⟩ := hcK_mem.mp hu
      obtain ⟨hkE, hk0, hk1⟩ := hK_mem.mp hk

      have hM : 0 < n * m * c := Nat.mul_pos (Nat.mul_pos hn hm) hc
      have htn : n • t = 0 := mem_jZeroTorsion_iff.mp (htors n ht)
      have hym' : m • t + m • (c • k) = 0 := by rw [← nsmul_add]; exact mem_jZeroTorsion_iff.mp hym
      have hkM : k ∈ jZeroTorsion (N₀ * p) (n * m * c) := by
        rw [mem_jZeroTorsion_iff, ← smul_smul, ← smul_smul, eq_neg_of_add_eq_zero_right hym', neg_nsmul,
          smul_smul, mul_comm n m, ← smul_smul, htn, smul_zero, neg_zero]
      have hkfin : k ∈ O.finPts (n * m * c) := by
        rw [O.finPts_eq]; exact ⟨hkM, hkE⟩
      have hck : c • k ∈ O.toricPts (n * m * c) := hE2 _ hM k hkfin hk0 hk1
      have ht' : t ∈ O.toricPts (n * m * c) := hmono n (n * m * c) hn hM ⟨m * c, by ring⟩ ht
      rw [hTI m (n * m * c) hm hM ⟨n * c, by ring⟩]
      exact ⟨AddSubgroup.add_mem _ ht' hck, hym⟩
    · exact le_inf ((hle_Tsup m hm).trans le_sup_left) (htors m)

  have hT₀_hecke : ∀ (t : HeckeAlg), ∀ y ∈ T₀, t • y ∈ T₀ := by
    intro t y hy
    obtain ⟨a, ha, u, hu, rfl⟩ := hT₀_mem.mp hy
    rw [smul_add]
    refine AddSubgroup.add_mem _ (le_sup_left (a := Tsup) (b := cK) ?_) (le_sup_right (a := Tsup) (b := cK) ?_)
    · obtain ⟨n, hn, ha⟩ := hTsup_mem a ha
      exact hle_Tsup n hn (hTH n hn t a ha)
    · obtain ⟨k, hk, rfl⟩ := hcK_mem.mp hu
      obtain ⟨hkE, hk0, hk1⟩ := hK_mem.mp hk
      refine hcK_mem.mpr ⟨t • k, hK_mem.mpr ⟨O.smul_mem_extPts t hkE, ?_, ?_⟩,
        (map_nsmul (DistribSMul.toAddMonoidHom (JZero (N₀ * p)) t) c k).symm⟩
      · exact ModularCurve.degeneracyPushforwardPair_heckeAlg_smul_eq_zero N₀ p hpN₀ t k hk0 hk1 0
      · exact ModularCurve.degeneracyPushforwardPair_heckeAlg_smul_eq_zero N₀ p hpN₀ t k hk0 hk1 1

  have hT₀_dec : ∀ σ ∈ A.decompositionSubgroup ℚ, ∀ y ∈ T₀, σ • y ∈ T₀ := by
    intro σ hσ y hy
    obtain ⟨a, ha, u, hu, rfl⟩ := hT₀_mem.mp hy
    rw [smul_add]
    refine AddSubgroup.add_mem _ (le_sup_left (a := Tsup) (b := cK) ?_) (le_sup_right (a := Tsup) (b := cK) ?_)
    · obtain ⟨n, hn, ha⟩ := hTsup_mem a ha
      exact hle_Tsup n hn (O.galois_smul_mem_toricPts n σ hσ a ha)
    · obtain ⟨k, hk, rfl⟩ := hcK_mem.mp hu
      obtain ⟨hkE, hk0, hk1⟩ := hK_mem.mp hk
      refine hcK_mem.mpr ⟨σ • k, hK_mem.mpr ⟨O.galois_smul_mem_extPts σ hσ hkE, ?_, ?_⟩,
        (map_nsmul (DistribSMul.toAddMonoidHom (JZero (N₀ * p)) σ) c k).symm⟩
      · rw [O.degeneracyPushforwardPair_galois_smul hΛ, hk0]; exact smul_zero (A := JZero N₀) σ
      · rw [O.degeneracyPushforwardPair_galois_smul hΛ, hk1]; exact smul_zero (A := JZero N₀) σ
  exact ⟨T₀, toric_pos, hT₀_le_EO, hT₀_ker, hT₀_hecke, hT₀_dec, fun x hx h0 h1 =>
    le_sup_right (a := Tsup) (b := cK) (hcK_mem.mpr ⟨x, hK_mem.mpr ⟨hx, h0, h1⟩, rfl⟩)⟩

set_option maxHeartbeats 16000000 in

theorem solution
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) (F : O.NeronExtension)
    (hE1 : ∀ (m : ℕ), 0 < m → ∀ x ∈ O.toricPts m,
      degeneracyPushforwardPair N₀ p 0 x = 0 ∧ degeneracyPushforwardPair N₀ p 1 x = 0)
    (c : ℕ) (hc : 0 < c)
    (hE2 : ∀ (m : ℕ), 0 < m → ∀ x ∈ O.finPts m,
      degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 → c • x ∈ O.toricPts m)
    (hCT : ∀ (m : ℕ), 0 < m → Nat.card ↥(O.toricPts m) = m ^ O.toricRank)
    (hTF : ∀ (m : ℕ), O.toricPts m ≤ O.finPts m)
    (hCF : ∀ (m : ℕ), 0 < m → Nat.card ↥(O.finPts m) =
      m ^ (O.toricRank + 4 * genusFF (ResidueField ↥A) (modularFunctionFieldC (ResidueField ↥A) N₀)))
    (hFS : ∀ (m : ℕ), 0 < m → m.Coprime p →
      ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, A.IsFrobeniusAt σ p →
        ∀ x ∈ O.toricPts m, σ • σ • x = ((p : ℤ) ^ 2) • x)
    (hFH : HeckeInputsAll (N₀ * p) → HeckeOperatorsCommuteBar (N₀ * p) →
      ∀ (m : ℕ), 0 < m → m.Coprime p →
        ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, A.IsFrobeniusAt σ p →
          ∀ x ∈ O.toricPts m,
            σ • x = (letI := heckeModuleBar (N₀ * p); (((p : ℕ) : HeckeAlg) * heckeGen ⟨p, Fact.out⟩) • x))
    (hABQ : ∃ abq : ∀ m : ℕ, m.Coprime p → (↥(O.finPts m) →+ (JZero N₀ × JZero N₀)),
      (∀ (m : ℕ) (hm : m.Coprime p) (x : ↥(O.finPts m)), abq m hm x = 0 ↔ (x : JZero (N₀ * p)) ∈ O.toricPts m) ∧
      (∀ (m : ℕ) (hm : m.Coprime p),
        (abq m hm).range = (Submodule.torsionBy ℤ (JZero N₀ × JZero N₀) (m : ℤ)).toAddSubgroup) ∧
      (∀ (m m' : ℕ) (hm : m.Coprime p) (hm' : m'.Coprime p) (h : m ∣ m') (x : ↥(O.finPts m))
        (hx : (x : JZero (N₀ * p)) ∈ O.finPts m'), abq m' hm' ⟨x, hx⟩ = abq m hm x) ∧
      (∀ (m : ℕ) (hm : m.Coprime p) (ℓ : Nat.Primes), ¬ (ℓ : ℕ) ∣ N₀ * p → ∀ (x : ↥(O.finPts m))
        (hx : (letI := heckeModuleBar (N₀ * p); heckeGen ℓ • (x : JZero (N₀ * p))) ∈ O.finPts m),
        abq m hm ⟨_, hx⟩ = (letI := heckeModuleBar N₀; (heckeGen ℓ • (abq m hm x).1, heckeGen ℓ • (abq m hm x).2))) ∧
      (∀ (m : ℕ) (hm : m.Coprime p) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)
        (hσ : σ ∈ A.decompositionSubgroup ℚ) (x : ↥(O.finPts m))
        (hx : σ • (x : JZero (N₀ * p)) ∈ O.finPts m),
        abq m hm ⟨_, hx⟩ = (σ • (abq m hm x).1, σ • (abq m hm x).2)))
    (hS1 : HeckeInputsAll (N₀ * p) → HeckeOperatorsCommuteBar (N₀ * p) →
      HeckeInputsAll N₀ → HeckeOperatorsCommuteBar N₀ →
        ∀ 𝔪 : Ideal HeckeAlg, 𝔪.IsMaximal → ((p : ℕ) : HeckeAlg) ∈ 𝔪 →
          ∀ x ∈ O.finPts p, (letI := heckeModuleBar (N₀ * p); x ∈ heckeTorsion (JZero (N₀ * p)) 𝔪) →
            x ∉ O.toricPts p →
              (letI := heckeModuleBar N₀; HasLowerLevelTorsion (primesOf (N₀ * p)) 𝔪 (JZero N₀)))
    (hS2 : HeckeInputsAll (N₀ * p) → HeckeOperatorsCommuteBar (N₀ * p) →
      HeckeInputsAll N₀ → HeckeOperatorsCommuteBar N₀ →
        ∀ 𝔪 : Ideal HeckeAlg, 𝔪.IsMaximal → ((p : ℕ) : HeckeAlg) ∈ 𝔪 → heckeGen ⟨p, Fact.out⟩ ∉ 𝔪 →
          ∀ x ∈ O.finPts p, (letI := heckeModuleBar (N₀ * p); x ∈ heckeTorsion (JZero (N₀ * p)) 𝔪) →
            x ∉ O.toricPts p →
              (letI := heckeModuleBar N₀; heckeTorsion (JZero N₀) 𝔪 ≠ ⊥))
    (hIU : ∀ (m : ℕ), m.Coprime p →
      ∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ x ∈ jZeroTorsion (N₀ * p) m, σ • x - x ∈ O.toricPts m)
    (hII : ∀ (m : ℕ), 0 < m →
      ∀ σ ∈ A.inertiaSubgroupIn ℚ, ∀ x ∈ jZeroTorsion (N₀ * p) m, σ • x - x ∈ O.finPts m)
    (hTH : ∀ (m : ℕ), 0 < m → letI := heckeModuleBar (N₀ * p);
      ∀ (t : HeckeAlg), ∀ x ∈ O.toricPts m, t • x ∈ O.toricPts m)
    (hFHk : ∀ (m : ℕ), 0 < m → letI := heckeModuleBar (N₀ * p);
      ∀ (t : HeckeAlg), ∀ x ∈ O.finPts m, t • x ∈ O.finPts m)
    (hTM : ∀ (m : ℕ), m.Coprime p → letI := heckeModuleBar (N₀ * p);
      O.toricPts m ≤ (toricMonodromyPart (J := JZero (N₀ * p)) p (A.inertiaSubgroupIn ℚ)).toAddSubgroup) :
    ∃ 𝓓 : JZeroNeronAtPDataOrdV22 N₀ p hpN₀ A hA,
      (∀ m : ℕ, 0 < m → 𝓓.toric m = O.toricPts m) ∧
      (∀ m : ℕ, 0 < m → 𝓓.fin m = O.finPts m) ∧
      𝓓.toricRank = O.toricRank ∧
      𝓓.abelianRank = 2 * genusFF (ResidueField ↥A) (modularFunctionFieldC (ResidueField ↥A) N₀) ∧
      (∀ x ∈ 𝓓.toric 0, degeneracyPushforwardPair N₀ p 0 x = 0 ∧ degeneracyPushforwardPair N₀ p 1 x = 0) ∧
      (∃ c : ℕ, 0 < c ∧ ∀ x ∈ 𝓓.fin 0,
        degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 → c • x ∈ 𝓓.toric 0) := by
  classical
  letI hb : Module HeckeAlg (JZero (N₀ * p)) := heckeModuleBar (N₀ * p)
  have hpp : p.Prime := Fact.out
  have hp0 : 0 < p := hpp.pos

  haveI : IsDiscreteValuationRing ↥(shRing A) :=
    (ValuationSubring.isDiscreteValuationRing_comap_fixedField_inertiaSubgroupIn A p hA).1
  have hsep : IsSeparated F.gN := F.hN.separated

  let abq := hABQ.choose
  have habq_ker := hABQ.choose_spec.1
  have habq_range := hABQ.choose_spec.2.1
  have habq_compat := hABQ.choose_spec.2.2.1
  have habq_hecke := hABQ.choose_spec.2.2.2.1
  have habq_dec := hABQ.choose_spec.2.2.2.2

  have hINV : inertiaInvariants A (N₀ * p) ≤ F.extPts :=
    ModularCurve.JZeroNeronObjectAtP.NeronExtension.inertiaInvariants_le_extPts N₀ p hpN₀ A hA Λ hΛ O F
  have hHN := ModularCurve.JZeroNeronObjectAtP.NeronExtension.exists_hecke_endomorphism N₀ p hpN₀ A hA Λ hΛ O F
  have hDEC := ModularCurve.JZeroNeronObjectAtP.NeronExtension.extN_galois_smul N₀ p hpN₀ A hA Λ hΛ O F
  have hDIV := ModularCurve.JZeroNeronObjectAtP.exists_nsmul_eq N₀ p hpN₀ A hA Λ hΛ O

  have hHull := ModularCurve.JZeroNeronObjectAtP.exists_toricHull N₀ p hpN₀ A hA Λ hΛ O hE1 c hc hE2 hTF hTH
  let T₀ : AddSubgroup (JZero (N₀ * p)) := hHull.choose
  have toric_pos : ∀ m, 0 < m → T₀ ⊓ jZeroTorsion (N₀ * p) m = O.toricPts m := hHull.choose_spec.1
  have hT₀_le_EO : T₀ ≤ O.extPts := hHull.choose_spec.2.1
  have hT₀_ker := hHull.choose_spec.2.2.1
  have hT₀_hecke : ∀ (t : HeckeAlg), ∀ y ∈ T₀, t • y ∈ T₀ := hHull.choose_spec.2.2.2.1
  have hT₀_dec : ∀ σ ∈ A.decompositionSubgroup ℚ, ∀ y ∈ T₀, σ • y ∈ T₀ := hHull.choose_spec.2.2.2.2.1
  have hT₀_cK := hHull.choose_spec.2.2.2.2.2
  let EO : AddSubgroup (JZero (N₀ * p)) := O.extPts

  haveI : Finite (componentGroup O.width) := ModularCurve.finite_componentGroup_of_pos O.width O.width_pos
  haveI hΦfin : Finite (Φq O) :=
    Finite.of_surjective (liftΦ O) (liftΦ_surjective O)
  let spN : ↥F.extPts →+ componentGroup O.width := F.spN hsep
  let spec : ∀ m : ℕ, ↥(F.finPts m) →+ Φq O := fun m =>
    ((liftΦ O).comp spN).comp (AddSubgroup.inclusion (F.finPts_le_extPts m))
  have spec_apply : ∀ (m : ℕ) (x : ↥(F.finPts m)),
      spec m x = liftΦ O (spN ⟨x.1, F.finPts_le_extPts m x.2⟩) := fun m x => rfl

  have shadow : ∀ x : ↥F.extPts, ∃ y : ↥(inertiaInvariants A (N₀ * p)),
      spN x = O.comp y ∧ (x : JZero (N₀ * p)) - y ∈ O.extPts := fun x =>
    (O.comp_surjective (spN x)).elim fun y hy =>
      ⟨y, hy.symm, F.sub_mem_extPts_of_spN_eq hsep (x' := ⟨y, hINV y.2⟩)
        (hy.symm.trans (F.spN_eq_comp hsep ⟨y, hINV y.2⟩ y.2).symm)⟩

  have tors_smul_hecke : ∀ (m : ℕ) (t : HeckeAlg) {x : JZero (N₀ * p)},
      x ∈ jZeroTorsion (N₀ * p) m → t • x ∈ jZeroTorsion (N₀ * p) m := by
    intro m t x hx
    rw [mem_jZeroTorsion_iff] at hx ⊢
    calc m • t • x = t • (m • x) := (map_nsmul (DistribSMul.toAddMonoidHom (JZero (N₀ * p)) t) m x).symm
      _ = 0 := by rw [hx]; exact smul_zero t
  have tors_smul_gal : ∀ (m : ℕ) (σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) {x : JZero (N₀ * p)},
      x ∈ jZeroTorsion (N₀ * p) m → σ • x ∈ jZeroTorsion (N₀ * p) m := by
    intro m σ x hx
    rw [mem_jZeroTorsion_iff] at hx ⊢
    calc m • σ • x = σ • (m • x) := (map_nsmul (DistribSMul.toAddMonoidHom (JZero (N₀ * p)) σ) m x).symm
      _ = 0 := by rw [hx]; exact smul_zero (A := JZero (N₀ * p)) σ

  refine ⟨{
    toric := fun m => T₀ ⊓ jZeroTorsion (N₀ * p) m
    fin := O.finPts
    finPart := F.finPts
    toric_le_fin := ?toric_le_fin
    fin_le_finPart := ?fin_le_finPart
    finPart_le_torsion := F.finPts_le_torsion
    toric_inf := ?toric_inf
    fin_inf := ?fin_inf
    finPart_inf := ?finPart_inf
    invariants_le_finPart := ?invariants_le_finPart
    finPart_eq_of_coprime := ?finPart_eq_of_coprime
    toric_hecke := ?toric_hecke
    fin_hecke := ?fin_hecke
    finPart_hecke := ?finPart_hecke
    toric_dec := ?toric_dec
    fin_dec := ?fin_dec
    finPart_dec := ?finPart_dec
    inertia_toric := ?inertia_toric
    inertia_unipotent := ?inertia_unipotent
    abq := abq
    abq_ker := ?abq_ker
    abq_range := habq_range
    abq_compat := habq_compat
    abq_hecke := fun m hm ℓ hℓ x => habq_hecke m hm ℓ hℓ x _
    abq_dec := fun m hm σ hσ x => habq_dec m hm σ hσ x _
    Φ := Φq O
    instAddCommGroupΦ := inferInstance
    instFiniteΦ := hΦfin
    instModuleΦ := instModuleΦq O
    spec := spec
    spec_ker := ?spec_ker
    spec_range := ?spec_range
    spec_hecke := ?spec_hecke
    spec_inertia := ?spec_inertia
    spec_compat := ?spec_compat
    Φ_eisenstein := ?Φ_eisenstein
    toric_frob_sq := ?toric_frob_sq
    toric_frob_hecke := ?toric_frob_hecke
    toric_monodromy := ?toric_monodromy
    raynaud := ?raynaud
    toricRank := O.toricRank
    abelianRank := 2 * genusFF (ResidueField ↥A) (modularFunctionFieldC (ResidueField ↥A) N₀)
    card_toric := ?card_toric
    card_fin := ?card_fin
    fin_heckeTorsion_detects_lowerLevel := ?supp1
    fin_heckeTorsion_detects_lowerLevel_sameIdeal := ?supp2
    inertia_sub_mem_fin := fun m hm => hII m (Nat.pos_of_ne_zero hm)
    toric_card_heckeTorsion_le := ?mult }, ?pin_toric, fun m _ => rfl, rfl, rfl, ?E1zero, ?E2zero⟩

  case toric_le_fin =>
    intro m
    rw [O.finPts_eq, inf_comm]
    exact inf_le_inf_left _ hT₀_le_EO
  case fin_le_finPart =>
    intro m
    rw [O.finPts_eq, F.finPts_eq]
    exact inf_le_inf_left _ F.extPts_le_extPts
  case toric_inf =>
    intro m m' h
    rw [inf_assoc, inf_eq_right.mpr (jZeroTorsion_mono h)]
  case fin_inf =>
    intro m m' h
    rw [O.finPts_eq, O.finPts_eq, inf_comm (jZeroTorsion _ m'), inf_assoc, inf_eq_right.mpr (jZeroTorsion_mono h),
      inf_comm]
  case finPart_inf =>
    intro m m' h
    rw [F.finPts_eq, F.finPts_eq, inf_comm (jZeroTorsion _ m'), inf_assoc, inf_eq_right.mpr (jZeroTorsion_mono h),
      inf_comm]
  case invariants_le_finPart =>
    intro m x hx
    rw [F.finPts_eq]
    exact ⟨hx.1, hINV (mem_inertiaInvariants.mpr hx.2)⟩
  case finPart_eq_of_coprime =>

    intro m hmp
    have hm := pos_of_coprime hmp
    apply le_antisymm
    · intro x hx
      rw [F.finPts_eq] at hx
      obtain ⟨hxm, hxN⟩ := hx
      refine ⟨hxm, ?_⟩

      obtain ⟨y, -, hdiff⟩ := shadow ⟨x, hxN⟩
      have hmx : m • x = 0 := mem_jZeroTorsion_iff.mp hxm
      have hmy : m • (y : JZero (N₀ * p)) ∈ O.extPts := by
        have e1 : m • (y : JZero (N₀ * p)) = m • x - m • (x - y) := by rw [nsmul_sub, sub_sub_cancel]
        rw [e1, hmx, zero_sub]
        exact O.extPts.neg_mem (O.extPts.nsmul_mem hdiff m)
      obtain ⟨x', hx'I, hx'm, hx'e⟩ :=
        ModularCurve.JZeroNeronObjectAtP.exists_mem_inertiaInvariants_nsmul_eq_zero_sub_extendsToPlace
          N₀ p hpN₀ A hA Λ hΛ O m hm hmp y y.2 hmy
      have hfin : x - x' ∈ O.finPts m := by
        rw [O.finPts_eq]
        refine ⟨AddSubgroup.sub_mem _ hxm (mem_jZeroTorsion_iff.mpr hx'm), ?_⟩
        rw [← sub_add_sub_cancel x (y : JZero (N₀ * p)) x']
        exact O.extPts.add_mem hdiff hx'e
      have hinv := ModularCurve.JZeroNeronObjectAtP.finPts_le_inertiaInvariantTorsion
        N₀ p hpN₀ A hA Λ hΛ O m hm hmp hfin
      intro σ hσ
      have h1 := hinv.2 σ hσ
      have h2 := (mem_inertiaInvariants.mp hx'I) σ hσ
      rw [smul_sub, h2, sub_eq_iff_eq_add, sub_add_cancel] at h1
      exact h1
    · intro x hx
      rw [F.finPts_eq]
