theorem mvF_lay (mz : ℕ → ℕ) (bg : ℕ → Bool) (hmz : ∀ j, 1 ≤ mz j) (ax0 : List ℕ)
    (LA LF LG LC : List ℕ) (hnd : (LA ++ LF ++ LG ++ LC).Nodup)
    (hF : Full bg ax0 (LA ++ LF ++ LG ++ LC)) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0)
    (t : IState HS) (R : List Item) (h0 : t.G 0 = ints (Dl mz bg ax0 (LA ++ LF ++ LG ++ LC) xs0 0) ++ R) :
    IRuns I iprog (mvFC (AModel.vol (LA.map (asz mz))) (AModel.vol (LF.map (asz mz))) (AModel.vol (LG.map (asz mz)))
        (AModel.vol (LC.map (asz mz)))) t
      (t.upd 0 (ints (Dl mz bg ax0 (LA ++ LG ++ LF ++ LC) xs0 0) ++ R))
      (cFwdF (AModel.vol (LA.map (asz mz))) (AModel.vol (LF.map (asz mz))) (AModel.vol (LG.map (asz mz)))
        (AModel.vol (LC.map (asz mz))) w +
        cK4 (AModel.vol (LA.map (asz mz))) (AModel.vol (LF.map (asz mz))) (AModel.vol (LG.map (asz mz)))
          (AModel.vol (LC.map (asz mz)))) := by
  have H := mvFC_runs (I := I) (iprog := iprog) t (Dl mz bg ax0 (LA ++ LF ++ LG ++ LC) xs0 0)
    (LA.map (asz mz)) (LF.map (asz mz)) (LG.map (asz mz)) (LC.map (asz mz)) w R
    (by simp [Dl]) (NLogN.KFU.bnd_pull _ _ _ hx) (vol_pos mz hmz _) (vol_pos mz hmz _) (vol_pos mz hmz _)
    (vol_pos mz hmz _) h0
  have hP := pop_swapMid (nA := LA.length) (nF := LF.length) (nG := LG.length)
    (n := (LA ++ LG ++ LF ++ LC).length) (by simp; omega)
  have hg : KIL.swapMid LA.length LF.length LG.length (LA ++ LG ++ LF ++ LC) = LA ++ LF ++ LG ++ LC :=
    KIL.swapMid_app LA LF LG LC
  have hS := Dl_step mz bg hP ax0 (LA ++ LG ++ LF ++ LC) rfl (by rw [hg]; exact hnd)
    (by rw [hg]; exact hF) xs0 0
  rw [hg] at hS
  simp only [List.map_append, List.length_map] at H hS
  rw [hS] at H
  exact H

theorem mvB_lay (mz : ℕ → ℕ) (bg : ℕ → Bool) (hmz : ∀ j, 1 ≤ mz j) (ax0 : List ℕ)
    (LA LF LG LC : List ℕ) (hnd : (LA ++ LF ++ LG ++ LC).Nodup)
    (hF : Full bg ax0 (LA ++ LF ++ LG ++ LC)) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0)
    (t : IState HS) (R : List Item) (h0 : t.G 0 = ints (Dl mz bg ax0 (LA ++ LF ++ LG ++ LC) xs0 0) ++ R) :
    IRuns I iprog (mvBC (AModel.vol (LA.map (asz mz))) (AModel.vol (LG.map (asz mz))) (AModel.vol (LF.map (asz mz)))
        (AModel.vol (LC.map (asz mz)))) t
      (t.upd 0 (ints (Dl mz bg ax0 (LA ++ LG ++ LF ++ LC) xs0 0) ++ R))
      (cBwdF (AModel.vol (LA.map (asz mz))) (AModel.vol (LG.map (asz mz))) (AModel.vol (LF.map (asz mz)))
        (AModel.vol (LC.map (asz mz))) w +
        cK4 (AModel.vol (LA.map (asz mz))) (AModel.vol (LG.map (asz mz))) (AModel.vol (LF.map (asz mz)))
          (AModel.vol (LC.map (asz mz)))) := by
  have H := mvBC_runs (I := I) (iprog := iprog) t (Dl mz bg ax0 (LA ++ LF ++ LG ++ LC) xs0 0)
    (LA.map (asz mz)) (LF.map (asz mz)) (LG.map (asz mz)) (LC.map (asz mz)) w R
    (by simp [Dl]) (NLogN.KFU.bnd_pull _ _ _ hx) (vol_pos mz hmz _) (vol_pos mz hmz _) (vol_pos mz hmz _)
    (vol_pos mz hmz _) h0
  have hP := pop_swapMid (nA := LA.length) (nF := LF.length) (nG := LG.length)
    (n := (LA ++ LG ++ LF ++ LC).length) (by simp; omega)
  have hg : KIL.swapMid LA.length LF.length LG.length (LA ++ LG ++ LF ++ LC) = LA ++ LF ++ LG ++ LC :=
    KIL.swapMid_app LA LF LG LC
  have hS := Dl_step mz bg hP ax0 (LA ++ LG ++ LF ++ LC) rfl (by rw [hg]; exact hnd)
    (by rw [hg]; exact hF) xs0 0
  rw [hg] at hS
  simp only [List.map_append, List.length_map] at H hS
  rw [hS] at H
