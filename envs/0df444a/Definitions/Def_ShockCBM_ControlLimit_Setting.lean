-- title:
--   §3.1–§3.3 — shock degradation with Gamma and conjugate priors, Bayes posterior, predictive kernel of (Z, K), Bellman operator (10), value iteration (18), V and (19)
-- statement:
--   A component accumulates damage through a compound Poisson process: shocks arrive at an unknown rate $\Lambda$ and each shock causes an integer damage with pmf $f(\cdot\mid\Phi)$ from the natural exponential family generated by $h$ (see the definition `ShockCBM.ControlLimit.NEF`). The parameters have independent priors: $\Lambda\sim\mathrm{Gamma}(\alpha,\beta)$ with shape $\alpha$ and **rate** $\beta$, density $f_\Lambda(\lambda\mid\alpha,\beta)=\beta^\alpha\lambda^{\alpha-1}e^{-\beta\lambda}/\Gamma(\alpha)$ for $\lambda\ge 0$, and $\Phi$ has the conjugate density $f_\Phi(\phi\mid a,b)$ of (5).
--
--   **Bayesian learning.** After one period's signal $\theta=(k,y)$, consisting of $k$ shocks with damages $y_1,\dots,y_k$, the likelihood is
--   $$\mathcal L(\theta\mid\lambda,\phi)=\frac{e^{-\lambda}\lambda^{k}}{k!}\prod_{i=1}^{k}h(y_i)e^{\phi y_i-A(\phi)},$$
--   and the posterior density of $(\Lambda,\Phi)$ is given by Bayes' formula
--   $$\frac{\mathcal L(\theta\mid\lambda,\phi)f_\Lambda(\lambda\mid\alpha,\beta)f_\Phi(\phi\mid a,b)}{\iint\mathcal L(\theta\mid\lambda',\phi')f_\Lambda(\lambda'\mid\alpha,\beta)f_\Phi(\phi'\mid a,b)\,d\lambda'\,d\phi'} .$$
--
--   **Predictive law.** Given hyperparameters $(\alpha,\beta,a,b)$, the next period's shock count $K$ and damage $Z$ have joint pmf
--   $$\mathbb P[Z=z,K=k]=\int_{\mathbb R}\frac{e^{-\lambda}\lambda^k}{k!}f_\Lambda(\lambda\mid\alpha,\beta)\,d\lambda\cdot\int_\Theta f^{(k)}(z\mid\phi)f_\Phi(\phi\mid a,b)\,d\phi .$$
--
--   **The model.** The primitives are $h$, the hyperparameters $\alpha_0,\beta_0,a_0,b_0$, the preventive and corrective replacement costs $c_p,c_u$, the discount factor $\gamma$ and the failure threshold $\xi\in\mathbb N$. The standing assumptions are:
--   1. $\alpha_0,\beta_0,a_0,b_0>0$;
--   2. $0<c_p<c_u$;
--   3. $0<\gamma<1$;
--   4. $\xi\ge 1$;
--   5. $h\ge 0$;
--   6. for all $x,n\in\mathbb N$ the conjugate kernel $e^{(a_0+x)\phi-(b_0+n)A(\phi)}$ is integrable on $\Theta$ with positive integral.
--
--   **The collapsed MDP.** States are $s=(x,n,t)\in\mathbb N^3$ (degradation level, number of shocks, age), $s_0=(0,0,0)$, and the state's hyperparameters are $\alpha=\alpha_0+n$, $\beta=\beta_0+t$, $a=a_0+x$, $b=b_0+n$. Write $q_s(z,k)$ for the predictive pmf at these hyperparameters, $A(s)=(Z(s),K(s),1)$, and
--   $$\mathbb E_s[W(s+A(s))]=\sum_{z,k\in\mathbb N}q_s(z,k)\,W(x+z,n+k,t+1).$$
--   The Bellman operator of (10) is
--   $$(\mathcal TW)(s)=\begin{cases}c_u+\gamma\,\mathbb E[W(s_0+A(s_0))], & x\ge\xi,\\ \min\{c_p+\gamma\,\mathbb E[W(s_0+A(s_0))],\ \gamma\,\mathbb E_s[W(s+A(s))]\}, & x<\xi.\end{cases}$$
--   Value iteration (18) is $V^0=0$, $V^{m+1}=\mathcal TV^m$, and the value function is the pointwise limit $V(s)=\lim_{m\to\infty}V^m(s)$. Preventive replacement is optimal at $s$ when (19) holds:
--   $$c_p+\gamma\,\mathbb E[V(s_0+A(s_0))]\le\gamma\,\mathbb E_s[V(s+A(s))].$$
--   Finally $\mathbb P_s[Z=z]=\sum_k q_s(z,k)$ and $\mathbb P_s[Z\ge m]=\sum_{z\ge m}\mathbb P_s[Z=z]$.
--
--   **Formalization Note** Damages are integer valued. The predictive kernel is defined by the integrals, never by its closed form (6). $V$ is the value-iteration limit (Lean's `limUnder`), not an assumed solution of (10); the paper identifies it with the optimal discounted cost (9), whose first-period discounting differs from (10) by a positive factor that does not affect the optimal policy. The integrability field of the standing assumptions is not stated in the paper and is added so that the conjugate densities at every state $(x,n,t)\in\mathbb N^3$ (hyperparameters $(a_0+x,b_0+n)$), reachable or not, are well defined; it excludes binomial damages and every damage law with $h(0)=0$. The relation (19) is used only for $x<\xi$; ties count as "replace".
-- source:
--   Drent, Drent, Arts, Kapodistria, Real-Time Integrated Learning and Decision Making for Cumulative Shock Degradation, Manufacturing & Service Operations Management 25(1) (2023), doi:10.1287/msom.2022.1149, accepted manuscript, pp. 8–14, (1), (5), (6), (9), (10); p. 30, proof of Proposition 1; p. 32, (18); p. 33, (19)

import Mathlib
import Definitions.Def_ShockCBM_ControlLimit_NEF

namespace ShockCBM.ControlLimit

open MeasureTheory

/-! ### Bayesian learning of `(Λ, Φ)` (§3.2) -/

/-- The joint likelihood (proof of Proposition 1, p. 30) of one period's signal `θ = (k, y)`,
`y : Fin k → ℕ` the observed damages, given `Λ = lam`, `Φ = φ`:
`L(θ | λ, φ) = e^{−λ} λ^k / k! · ∏_{i} h(y_i) e^{φ y_i − A(φ)}`. -/
noncomputable def likelihood (h : ℕ → ℝ) (k : ℕ) (y : Fin k → ℕ) (lam φ : ℝ) : ℝ :=
  Real.exp (-lam) * lam ^ k / (Nat.factorial k : ℝ) *
    ∏ i, h (y i) * Real.exp (φ * (y i : ℝ) - logPartition h φ)

/-- The product prior `f_Λ(λ | α, β) · f_Φ(φ | a, b)`: Gamma with shape `α` and rate `β`, times the
conjugate density (5). -/
noncomputable def jointPrior (h : ℕ → ℝ) (α β a b lam φ : ℝ) : ℝ :=
  ProbabilityTheory.gammaPDFReal α β lam * conjDensity h a b φ

/-- The Bayes posterior density of `(Λ, Φ)` after the signal `(k, y)`: likelihood times prior,
divided by its integral over `ℝ × ℝ`. -/
noncomputable def posterior (h : ℕ → ℝ) (α β a b : ℝ) (k : ℕ) (y : Fin k → ℕ) (lam φ : ℝ) : ℝ :=
  likelihood h k y lam φ * jointPrior h α β a b lam φ /
    ∫ p : ℝ × ℝ, likelihood h k y p.1 p.2 * jointPrior h α β a b p.1 p.2

/-! ### The predictive law of `(Z, K)` -/

/-- `P[K = k | α, β] = ∫ e^{−λ} λ^k / k! · f_Λ(λ | α, β) dλ`. -/
noncomputable def countPart (α β : ℝ) (k : ℕ) : ℝ :=
  ∫ lam : ℝ, Real.exp (-lam) * lam ^ k / (Nat.factorial k : ℝ) *
    ProbabilityTheory.gammaPDFReal α β lam

/-- `P[Z = z | K = k, a, b] = ∫_Θ f^{(k)}(z | φ) f_Φ(φ | a, b) dφ`. -/
noncomputable def damagePart (h : ℕ → ℝ) (a b : ℝ) (k z : ℕ) : ℝ :=
  ∫ φ in natParamSpace h, conv h φ k z * conjDensity h a b φ

/-- The joint predictive pmf `P[Z = z, K = k | α, β, a, b]` of the next period's damage `Z` and
shock count `K`, with `Λ` and `Φ` independent with densities `f_Λ(·|α, β)` and `f_Φ(·|a, b)`. -/
noncomputable def predKernel (h : ℕ → ℝ) (α β a b : ℝ) (z k : ℕ) : ℝ :=
  countPart α β k * damagePart h a b k z

/-! ### The model and the collapsed MDP (§3.3) -/

/-- The primitives: damage base weights `h`, hyperparameters `α0, β0, a0, b0` (`β0` a rate),
preventive and corrective costs `cp, cu`, discount factor `γ`, failure threshold `ξ`. -/
structure Model where
  h : ℕ → ℝ
  α0 : ℝ
  β0 : ℝ
  a0 : ℝ
  b0 : ℝ
  cp : ℝ
  cu : ℝ
  γ : ℝ
  ξ : ℕ

/-- States `s = (x, n, t)`: degradation level, number of shocks, age. -/
abbrev State := ℕ × ℕ × ℕ

/-- The state of a new component, `s0 = (0, 0, 0)`. -/
def s0 : State := (0, 0, 0)

/-- The standing assumptions of §3. -/
structure Model.Standing (M : Model) : Prop where
  α0_pos : 0 < M.α0
  β0_pos : 0 < M.β0
  a0_pos : 0 < M.a0
  b0_pos : 0 < M.b0
  cp_pos : 0 < M.cp
  cp_lt_cu : M.cp < M.cu
  γ_pos : 0 < M.γ
  γ_lt_one : M.γ < 1
  one_le_ξ : 1 ≤ M.ξ
  h_nonneg : ∀ y, 0 ≤ M.h y
  conj_normalizable : ∀ x n : ℕ, ConjNormalizable M.h (M.a0 + x) (M.b0 + n)

/-- The predictive pmf `P_s[Z = z, K = k]` at the hyperparameters of the state `s = (x, n, t)`:
`α = α0 + n`, `β = β0 + t`, `a = a0 + x`, `b = b0 + n`. -/
noncomputable def Model.q (M : Model) (s : State) (z k : ℕ) : ℝ :=
  predKernel M.h (M.α0 + (s.2.1 : ℝ)) (M.β0 + (s.2.2 : ℝ)) (M.a0 + (s.1 : ℝ))
    (M.b0 + (s.2.1 : ℝ)) z k

/-- `E_s[W(s + A(s))]` with `A(s) = (Z(s), K(s), 1)`. -/
noncomputable def Model.Enext (M : Model) (s : State) (W : State → ℝ) : ℝ :=
  ∑' p : ℕ × ℕ, M.q s p.1 p.2 * W (s.1 + p.1, s.2.1 + p.2, s.2.2 + 1)

/-- The Bellman operator of (10). -/
noncomputable def Model.bellman (M : Model) (W : State → ℝ) (s : State) : ℝ :=
  if M.ξ ≤ s.1 then M.cu + M.γ * M.Enext s0 W
  else min (M.cp + M.γ * M.Enext s0 W) (M.γ * M.Enext s W)

/-- Value iteration (18) from `V^0 = 0`. -/
noncomputable def Model.valueIter (M : Model) : ℕ → State → ℝ
  | 0 => fun _ => 0
  | m + 1 => M.bellman (M.valueIter m)

/-- The value function `V(s) = lim_m V^m(s)`. -/
noncomputable def Model.V (M : Model) (s : State) : ℝ :=
  Filter.limUnder Filter.atTop (fun m => M.valueIter m s)

/-- (19): preventive replacement is optimal at `s` (used for `x < ξ`; ties count as replace). -/
def Model.ReplaceOptimal (M : Model) (s : State) : Prop :=
  M.cp + M.γ * M.Enext s0 M.V ≤ M.γ * M.Enext s M.V

/-- The pmf of the next period's damage `Z(s)`: `P_s[Z = z] = ∑_k P_s[Z = z, K = k]`. -/
noncomputable def Model.pmfZ (M : Model) (s : State) (z : ℕ) : ℝ :=
  ∑' k : ℕ, M.q s z k

/-- The tail `P_s[Z(s) ≥ m]`. -/
noncomputable def Model.tailZ (M : Model) (s : State) (m : ℕ) : ℝ :=
  ∑' z : ℕ, if m ≤ z then M.pmfZ s z else 0

end ShockCBM.ControlLimit


