-- ===== S4.Def_RP_EtPBC_A_NInd =====
section

/-!
# S4-EtPBC-A, M4(C,D,F): noetherian induction on supports

* `FGT Λ F`: `F` is a quotient of a finite sum `∐ Λ[W j]` with every `(W j).left` affine;
* `fgt_image`, `fgt_quotCut`; `mono_lift_of_stalk` (a stalkwise criterion for `biprod.lift a b` to be mono);
  `bcSurj_of_isZero`;
* `GenStep Λ g s`: the generic step: an `FGT` sheaf `F` with stalks zero off a nonempty closed `Z` maps to a sheaf
  with `BCSurj 0`, injectively on stalks over `V ∩ Z ≠ ∅` for some open `V`;
* **`embC_of_fgt`**: under `GenStep` (and `P` noetherian) every `FGT` sheaf embeds into a sheaf with `BCSurj 0`;
* **`bcSurj_zero_all`**: under `GenStep`, `BCSurj 0` holds for every sheaf (`P_s` compact, `g` universally closed).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian TopologicalSpace

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact

universe u

variable {Λ : Type u} [CommRing Λ] {P S : Scheme.{u}} (g : P ⟶ S) (s : GeomPt S)

variable (Λ) in
/-- `F` is a quotient of a finite sum of `Λ[W]` with `W` affine. -/
def FGT (F : EtSh Λ P) : Prop :=
  ∃ (J : Type u) (_ : Finite J) (W : J → P.Etale) (_ : ∀ j, IsAffine (W j).left)
    (e : (∐ fun j => freeSh Λ (W j)) ⟶ F), Epi e

theorem fgt_image {G : EtSh Λ P} {X : Scheme.{u}} (t : Finset X) (W : X → P.Etale) (hW : ∀ x, IsAffine (W x).left)
    (φ : (∐ fun x : t => freeSh Λ (W x.1)) ⟶ G) : FGT Λ (kernel (cokernel.π φ)) :=
  ⟨t, inferInstance, fun x => W x.1, fun x => hW x.1, Abelian.factorThruImage φ, epi_fti φ⟩

theorem fgt_quotCut (V : P.Opens) {F : EtSh Λ P} (hF : FGT Λ F) : FGT Λ (quotCut Λ V F) := by
  obtain ⟨J, hJ, W, hW, e, he⟩ := hF
  exact ⟨J, hJ, W, hW, e ≫ quotCutπ Λ V F, @epi_comp _ _ _ _ _ e he _ (epi_cokπ (openCutι Λ V F))⟩

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_EmbQ =====
section

/-!
# S4-EtPBC-A, R3 (degree `q` of M4): closure properties of `BCSurj q`, noetherian induction for a predicate

* `Delta.surjAt_of_isZero`, **`Delta.surjAt_biprod`** (abstract): surjectivity on germs in degree `q` holds for zero
  objects and passes to binary biproducts;
* **`bcSurj_succ_of_mono`**: `BCSurj (q+1)` passes from `H` to a subobject `F ↪ H` given `BCInj (q+1)` and
  `BCSurj q` for the cokernel (the epi four-lemma `Delta.surjAt_succ_of_ses`);
* `GenStepP Λ C`, `EmbP C`: the generic step and embeddability for an arbitrary predicate `C` on sheaves;
  **`embP_of_fgt`**: if `C` holds for zero sheaves and is closed under `⊞`, the generic step for `C` embeds every
  `FGT` sheaf into a sheaf satisfying `C` (`GenStep Λ g s = GenStepP Λ (BCSurj Λ g s 0)`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite Abelian TopologicalSpace

noncomputable section

namespace RamanujanPetersson.EtPBC.Delta

universe w v₁ u₁ v₂ u₂ v₃ u₃

end RamanujanPetersson.EtPBC.Delta

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact

universe u

variable {Λ : Type u} [CommRing Λ] {P S : Scheme.{u}}

variable (Λ) in
/-- The generic step for a predicate `C` on sheaves. -/
def GenStepP (C : EtSh Λ P → Prop) : Prop :=
  ∀ (Z : Set P), IsClosed Z → Z.Nonempty → ∀ F : EtSh Λ P, FGT Λ F → (∀ x ∉ Z, IsZero (stalk Λ F x)) →
    ∃ (V : P.Opens) (H : EtSh Λ P) (φ : F ⟶ H), C H ∧ ((V : Set P) ∩ Z).Nonempty ∧
      ∀ x ∈ (V : Set P) ∩ Z, Mono (((geomPtAt x).stalkF Λ).map φ)

/-- **Noetherian induction for a predicate**: every `FGT` sheaf embeds into a sheaf satisfying `C`. -/
theorem embP_of_fgt [NoetherianSpace P] (C : EtSh Λ P → Prop) (h0 : ∀ H : EtSh Λ P, IsZero H → C H)
    (h2 : ∀ H₁ H₂ : EtSh Λ P, C H₁ → C H₂ → C (H₁ ⊞ H₂)) (hE : GenStepP Λ C) (F : EtSh Λ P) (hF : FGT Λ F) :
    EmbP C F := by
  suffices h : ∀ Z : Closeds P, ∀ F : EtSh Λ P, FGT Λ F → (∀ x ∉ (Z : Set P), IsZero (stalk Λ F x)) → EmbP C F from
    h ⊤ F hF fun x hx => absurd (Set.mem_univ x) hx
  refine fun Z => WellFoundedLT.induction
    (motive := fun Z : Closeds P => ∀ F : EtSh Λ P, FGT Λ F → (∀ x ∉ (Z : Set P), IsZero (stalk Λ F x)) → EmbP C F) Z ?_
  intro Z ih F hF hZ
  by_cases hne : (Z : Set P).Nonempty
  · obtain ⟨V, H, φ, hH, ⟨x₀, hx₀V, hx₀Z⟩, hmono⟩ := hE Z Z.isClosed hne F hF hZ
    let Z' : Closeds P := ⟨(Z : Set P) \ (V : Set P), Z.isClosed.sdiff V.isOpen⟩
    have hlt : Z' < Z := SetLike.lt_iff_le_and_exists.2 ⟨fun x hx => hx.1, x₀, hx₀Z, fun h => h.2 hx₀V⟩
    have hQ : EmbP C (quotCut Λ V F) := by
      refine ih Z' hlt _ (fgt_quotCut V hF) fun x hx => ?_
      by_cases hxV : x ∈ V
      · exact isZero_stalk_quotCut V F (geomPtAt x) (mem_center_geomPtAt (W := (V : Set P)) hxV)
      · have hxZ : x ∉ (Z : Set P) := fun h => hx ⟨h, hxV⟩
        have := isIso_stalk_quotCutπ V F (geomPtAt x) (not_mem_center_geomPtAt (W := (V : Set P)) hxV)
        exact (hZ x hxZ).of_iso (asIso (((geomPtAt x).stalkF Λ).map (quotCutπ Λ V F))).symm
    have hm : Mono (biprod.lift φ (quotCutπ Λ V F)) := by
      apply mono_lift_of_stalk
      intro x
      by_cases hxV : x ∈ V
      · left
        by_cases hxZ : x ∈ (Z : Set P)
        · exact hmono x ⟨hxV, hxZ⟩
        · exact (hZ x hxZ).mono _
      · right
        exact @IsIso.mono_of_iso _ _ _ _ _
          (isIso_stalk_quotCutπ V F (geomPtAt x) (not_mem_center_geomPtAt (W := (V : Set P)) hxV))
    exact @embP_of_mono _ _ _ C h2 _ _ _ (biprod.lift φ (quotCutπ Λ V F)) hm ⟨H, 𝟙 H, inferInstance, hH⟩ hQ
  · have h0' : IsZero F := (isZero_iff_stalk Λ F).2 fun x => hZ x fun h => hne ⟨x, h⟩
    exact ⟨F, 𝟙 F, inferInstance, h0 F h0'⟩

end RamanujanPetersson.EtPBC

end

