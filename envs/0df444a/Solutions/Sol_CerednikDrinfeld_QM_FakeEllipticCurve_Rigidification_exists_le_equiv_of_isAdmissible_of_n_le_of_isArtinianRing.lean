theorem frob_qinv_baseChange [Fact r.Prime] {k : Type} [CommRing k] (hk : IsField k) [CharP k r]
    (Φ : FormalODModule r k) (hΦ4 : Φ.HasHeight 4) (j : ℕ)
    {D : Type} [CommRing D] (f fj : k →+* D) (hg : ∀ x, f x = (fj x) ^ (r ^ j)) :
    ∃ V : Series D, FormalODModule.IsODHom (Φ.map f) (Φ.map fj) V ∧
      (Rigidified.frobSeries (p := r) D j).comp V = (Φ.map f).act ((r : Zp2 r) ^ j) := by
  letI : Field k := hk.toField
  haveI : IsNoetherianRing k := inferInstance
  obtain ⟨Vk, hVk, hVkF, -⟩ :=
    CerednikDrinfeld.FormalODModule.exists_isODHom_map_iterateFrobenius_comp_X_pow_eq_act_pow Φ hΦ4 j
  have hFk : FormalODModule.IsODHom Φ (Φ.map (iterateFrobenius k r j)) (Rigidified.frobSeries (p := r) k j) := by
    have h := CerednikDrinfeld.FormalODModule.isODHom_frobSeries_map_of_forall_eq_pow (RingHom.id k) (iterateFrobenius k r j) j
      (CharP.cast_eq_zero k r) (fun x => by rw [RingHom.id_apply, iterateFrobenius_def]) Φ
    rwa [FormalODModule.map_id] at h
  have dFk : FormalODModule.HasKernelOfDegree (Rigidified.frobSeries (p := r) k j) (r ^ (2 * j)) :=
    CerednikDrinfeld.FormalODModule.hasKernelOfDegree_frobSeries k j
  have hFVk : (Rigidified.frobSeries (p := r) k j).comp Vk = (Φ.map (iterateFrobenius k r j)).act ((r : Zp2 r) ^ j) := by
    apply cancel_right (frobSeries_cc j) dFk
    rw [Series.comp_assoc _ _ _ hVk.constantCoeff (frobSeries_cc j)]
    show (Rigidified.frobSeries (p := r) k j).comp (Vk.comp fun i => (MvPowerSeries.X i : MvPowerSeries (Fin 2) k) ^ (r ^ j)) = _
    rw [hVkF, hFk.2.1]
  have hcompj : fj.comp (iterateFrobenius k r j) = f := by
    ext x
    rw [RingHom.comp_apply, iterateFrobenius_def, map_pow, ← hg]
  have eΦ : (Φ.map (iterateFrobenius k r j)).map fj = Φ.map f := by
    rw [FormalODModule.map_map, hcompj]
  refine ⟨Vk.map fj, ?_, ?_⟩
  · have h := hVk.map fj
    rwa [eΦ] at h
  · have h := congrArg (Series.map fj) hFVk
    rwa [Series.map_comp _ _ _ hVk.constantCoeff, frobSeries_map, ← FormalODModule.map_act, eΦ] at h

end frob

theorem inst_I1_I2
    {r : ℕ} [Fact r.Prime]
    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr] (Fr : Onr ≃ₐ[𝒪] Onr)
    (hOnr_max : (Ideal.span {algebraMap 𝒪 Onr π}).IsMaximal)
    (hFr : ∀ x : Onr, Fr x - x ^ r ∈ Ideal.span {algebraMap 𝒪 Onr π})
    (X₀ : FormalODModule r (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (hX₀ : X₀.HasHeight 4)
    (Φ : FormalODModule r (Onr ⧸ pIdeal r Onr)) (hΦ4 : Φ.HasHeight 4)
    (κ : (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) →+* (Onr ⧸ pIdeal r Onr))
    (n₀ : ℕ) (β₀ : Series (Onr ⧸ pIdeal r Onr)) (hβ₀ : FormalODModule.IsIsogenyOfHeight Φ (X₀.map κ) β₀ (4 * n₀))
    (N₀ : ℕ) (β₀' : Series (Onr ⧸ pIdeal r Onr)) (hβ₀'h : FormalODModule.IsODHom (X₀.map κ) Φ β₀')
    (hβ₀β₀' : β₀.comp β₀' = (X₀.map κ).act ((r : Zp2 r) ^ N₀))
    (S : Type) [CommRing S] [IsNoetherianRing S] [Algebra 𝒪 S] (ψS : Onr →ₐ[𝒪] S) (j : ℕ)
    (tx : Rigidified r Φ S) :
    ((X₀.map κ).map (residueMap (ψS : Onr →+* S))).HasHeight 4 ∧
    FormalODModule.IsIsogenyOfHeight
        (tx.Φbar ((frobTwist Onr Fr (-(j : ℤ)) ψS : Onr →ₐ[𝒪] S) : Onr →+* S))
        ((X₀.map κ).map (residueMap (ψS : Onr →+* S)))
        ((Series.map (residueMap (ψS : Onr →+* S)) β₀).comp
          (fun i => (MvPowerSeries.X i : MvPowerSeries (Fin 2) (S ⧸ pIdeal r S)) ^ (r ^ j)))
        (2 * j + 4 * n₀) ∧
    ∃ δ : Series (S ⧸ pIdeal r S),
      FormalODModule.IsODHom ((X₀.map κ).map (residueMap (ψS : Onr →+* S)))
        (tx.Φbar ((frobTwist Onr Fr (-(j : ℤ)) ψS : Onr →ₐ[𝒪] S) : Onr →+* S)) δ ∧
      ((Series.map (residueMap (ψS : Onr →+* S)) β₀).comp
          (fun i => (MvPowerSeries.X i : MvPowerSeries (Fin 2) (S ⧸ pIdeal r S)) ^ (r ^ j))).comp δ =
        ((X₀.map κ).map (residueMap (ψS : Onr →+* S))).act ((r : Zp2 r) ^ (N₀ + j)) := by
  classical

  have hπr : Ideal.span {algebraMap 𝒪 S π} ≤ pIdeal r S := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe]
    have : π ∈ Ideal.span {((r : ℕ) : 𝒪)} := hunr ▸ Ideal.subset_span rfl
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp this
    rw [← hc, map_mul, map_natCast]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  have hIdeal : pIdeal r Onr = Ideal.span {algebraMap 𝒪 Onr π} := by
    have e1 : pIdeal r Onr = Ideal.map (algebraMap 𝒪 Onr) (Ideal.span {((r : ℕ) : 𝒪)}) := by
      rw [Ideal.map_span, Set.image_singleton, map_natCast]
    rw [e1, hunr, Ideal.map_span, Set.image_singleton]
  haveI hmaxr : (pIdeal r Onr).IsMaximal := hIdeal ▸ hOnr_max
  have hkf : IsField (Onr ⧸ pIdeal r Onr) := (Ideal.Quotient.maximal_ideal_iff_isField_quotient _).mp hmaxr
  haveI hNk : IsNoetherianRing (Onr ⧸ pIdeal r Onr) := by
    letI : Field (Onr ⧸ pIdeal r Onr) := hkf.toField
    infer_instance
  haveI hmaxπ : (Ideal.span {algebraMap 𝒪 Onr π}).IsMaximal := hOnr_max
  letI : Field (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) := Ideal.Quotient.field _
  haveI : IsNoetherianRing (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) := inferInstance
  haveI hchar : CharP (Onr ⧸ pIdeal r Onr) r :=
    CharP.quotient Onr r (fun hu => hmaxr.ne_top (Ideal.span_singleton_eq_top.mpr hu))

  set k := Onr ⧸ pIdeal r Onr with hk
  set ψj : Onr →+* S := ((frobTwist Onr Fr (-(j : ℤ)) ψS : Onr →ₐ[𝒪] S) : Onr →+* S) with hψj
  set Sb := S ⧸ pIdeal r S with hSb
  set Y : FormalODModule r Sb := (X₀.map κ).map (residueMap (ψS : Onr →+* S)) with hY
  set Fj : Series Sb := fun i => (MvPowerSeries.X i : MvPowerSeries (Fin 2) Sb) ^ (r ^ j) with hFj
  have hFj_def : Fj = Rigidified.frobSeries (p := r) Sb j := rfl

  have hFrk : ∀ (k : ℕ) (z : Onr), Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 Onr π}) ((Fr ^ k) z) =
      (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 Onr π}) z) ^ (r ^ k) := by
    intro k z
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ', AlgEquiv.mul_apply, pow_succ, pow_mul, ← ih, ← map_pow, Ideal.Quotient.eq]
      exact hFr _
  have hg : ∀ x : Onr ⧸ pIdeal r Onr, residueMap (ψS : Onr →+* S) x = (residueMap ψj x) ^ (r ^ j) := by
    intro x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    set z : Onr := (Fr ^ (-(j : ℤ))) y with hz
    have hy : y = (Fr ^ j) z := by
      rw [hz, ← zpow_natCast, ← AlgEquiv.mul_apply, ← zpow_add, add_neg_cancel, zpow_zero, AlgEquiv.one_apply]
    have e1 : ψj y = (ψS : Onr →+* S) z := rfl
    show Ideal.Quotient.mk _ ((ψS : Onr →+* S) y) = (Ideal.Quotient.mk _ (ψj y)) ^ (r ^ j)
    rw [e1, ← map_pow, ← map_pow, Ideal.Quotient.eq]
    apply hπr
    have hmap : Ideal.map (ψS : Onr →+* S) (Ideal.span {algebraMap 𝒪 Onr π}) = Ideal.span {algebraMap 𝒪 S π} := by
      rw [Ideal.map_span, Set.image_singleton]
      congr 2
      exact ψS.commutes π
    rw [← map_sub, ← hmap]
    apply Ideal.mem_map_of_mem
    rw [← Ideal.Quotient.eq, hy, hFrk, map_pow]
  have hp0 : ((r : ℕ) : Sb) = 0 := by
    have : ((r : ℕ) : Sb) = Ideal.Quotient.mk (pIdeal r S) (r : S) := by rw [map_natCast]
    rw [this, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_singleton _)

  have hY4 : Y.HasHeight 4 := hasHeight_map _ (hasHeight_map _ hX₀)
  have hBβ : FormalODModule.IsODHom (Φ.map (residueMap (ψS : Onr →+* S))) Y
      (Series.map (residueMap (ψS : Onr →+* S)) β₀) := hβ₀.1.map _
  have hC : FormalODModule.IsODHom (Φ.map (residueMap ψj)) (Φ.map (residueMap (ψS : Onr →+* S))) Fj :=
    CerednikDrinfeld.FormalODModule.isODHom_frobSeries_map_of_forall_eq_pow _ _ j hp0 hg Φ
  have c_β₀ : ∀ i, MvPowerSeries.constantCoeff (β₀ i) = 0 := hβ₀.1.constantCoeff
  have dC : FormalODModule.HasKernelOfDegree Fj (r ^ (2 * j)) :=
    CerednikDrinfeld.FormalODModule.hasKernelOfDegree_frobSeries Sb j
  have dB : FormalODModule.HasKernelOfDegree (Series.map (residueMap (ψS : Onr →+* S)) β₀) (r ^ (4 * n₀)) :=
    CerednikDrinfeld.FormalODModule.hasKernelOfDegree_map _ β₀ c_β₀ hβ₀.2
  have dBC : FormalODModule.HasKernelOfDegree ((Series.map (residueMap (ψS : Onr →+* S)) β₀).comp Fj) (r ^ (2 * j + 4 * n₀)) := by
    rw [pow_add]
    exact CerednikDrinfeld.FormalODModule.HasKernelOfDegree.comp hC.constantCoeff hBβ.constantCoeff dC dB
  have hI1 : FormalODModule.IsIsogenyOfHeight (tx.Φbar ψj) Y ((Series.map (residueMap (ψS : Onr →+* S)) β₀).comp Fj)
      (2 * j + 4 * n₀) := ⟨hBβ.comp hC, dBC⟩

  obtain ⟨V, hVod, hFV⟩ := frob_qinv_baseChange hkf Φ hΦ4 j (residueMap (ψS : Onr →+* S)) (residueMap ψj) hg
  rw [← hFj_def] at hFV

  have hβ₀'S : FormalODModule.IsODHom Y (Φ.map (residueMap (ψS : Onr →+* S))) (Series.map (residueMap (ψS : Onr →+* S)) β₀') :=
    hβ₀'h.map _
  have hββ'S : (Series.map (residueMap (ψS : Onr →+* S)) β₀).comp (Series.map (residueMap (ψS : Onr →+* S)) β₀') =
      Y.act ((r : Zp2 r) ^ N₀) := by
    rw [← Series.map_comp _ _ _ hβ₀'h.constantCoeff, hβ₀β₀', ← FormalODModule.map_act]

  refine ⟨hY4, hI1, V.comp (Series.map (residueMap (ψS : Onr →+* S)) β₀'), hVod.comp hβ₀'S, ?_⟩
  show ((Series.map (residueMap (ψS : Onr →+* S)) β₀).comp Fj).comp (V.comp (Series.map (residueMap (ψS : Onr →+* S)) β₀')) =
    Y.act ((r : Zp2 r) ^ (N₀ + j))
  rw [Series.comp_assoc _ _ _ hC.constantCoeff (hVod.comp hβ₀'S).constantCoeff,
    ← Series.comp_assoc _ _ _ hVod.constantCoeff hβ₀'S.constantCoeff, hFV,
    ← hβ₀'S.2.1, ← Series.comp_assoc _ _ _ hβ₀'S.constantCoeff (act_cc _ _), hββ'S,
    ← FormalODModule.act_pow_add]

end RIGN.InstI1I2

