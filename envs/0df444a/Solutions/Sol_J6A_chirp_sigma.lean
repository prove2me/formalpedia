lemma ceilSqrt_le (p : ℕ) (hp : 1 ≤ p) : ceilSqrt p * ceilSqrt p ≤ 4 * p := by
  have h1 : Nat.sqrt p * Nat.sqrt p ≤ p := Nat.sqrt_le p
  have h2 : 1 ≤ Nat.sqrt p := Nat.le_sqrt.2 (by omega)
  unfold ceilSqrt
  split_ifs <;> nlinarith

lemma chirp_sigma_sol_aux (p s t α H : ℕ) (hs : 0 < s) (hst : s ≤ t) (hα : 2 ≤ α) (hp : 3 ≤ p)
    (hH : H ≤ 2 * sWidth p α) (hθ : 300 * (t - s) ≤ s) :
    Real.exp (Real.pi * (s * (t - s) * H ^ 2 : ℕ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ)) ≤ 2 ^ (p / 2) := by
  have ht : 0 < t := lt_of_lt_of_le hs hst
  have hc := ceilSqrt_le p (by omega)
  -- `300 s (t-s) H² ≤ 16 p t² α²`
  have hH2 : H ^ 2 ≤ 16 * p * α ^ 2 := by
    have : H * H ≤ (2 * sWidth p α) * (2 * sWidth p α) := Nat.mul_le_mul hH hH
    unfold sWidth at this
    nlinarith
  have hst2 : 300 * (s * (t - s)) ≤ t ^ 2 := by
    have : s * (300 * (t - s)) ≤ s * s := Nat.mul_le_mul_left _ hθ
    nlinarith
  have key : 300 * (s * (t - s) * H ^ 2) ≤ 16 * p * (t ^ 2 * α ^ 2) := by
    calc 300 * (s * (t - s) * H ^ 2) = (300 * (s * (t - s))) * H ^ 2 := by ring
      _ ≤ t ^ 2 * (16 * p * α ^ 2) := Nat.mul_le_mul hst2 hH2
      _ = 16 * p * (t ^ 2 * α ^ 2) := by ring
  have keyR : 300 * ((s * (t - s) * H ^ 2 : ℕ) : ℝ) ≤ 16 * p * ((t ^ 2 * α ^ 2 : ℕ) : ℝ) := by
    exact_mod_cast key
  have hden : (0 : ℝ) < ((t ^ 2 * α ^ 2 : ℕ) : ℝ) := by
    have : 0 < t ^ 2 * α ^ 2 := by positivity
    exact_mod_cast this
  have hx : Real.pi * (s * (t - s) * H ^ 2 : ℕ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ) ≤
      Real.pi * (16 * p / 300) := by
    rw [div_le_iff₀ hden]
    have := mul_le_mul_of_nonneg_left keyR Real.pi_pos.le
    have e : Real.pi * (16 * p / 300) * ((t ^ 2 * α ^ 2 : ℕ) : ℝ) =
        Real.pi * (16 * p * ((t ^ 2 * α ^ 2 : ℕ) : ℝ)) / 300 := by ring
    rw [e, le_div_iff₀ (by norm_num)]
    linarith
  have hpi := Real.pi_lt_d2
  have hl2 := Real.log_two_gt_d9
  have hp2 : ((p / 2 : ℕ) : ℝ) ≥ ((p : ℝ) - 1) / 2 := by
    have : p ≤ 2 * (p / 2) + 1 := by omega
    have : (p : ℝ) ≤ 2 * ((p / 2 : ℕ) : ℝ) + 1 := by exact_mod_cast this
    linarith
  have hpR : (3 : ℝ) ≤ p := by exact_mod_cast hp
  have e2 : (2 : ℝ) ^ (p / 2) = Real.exp (((p / 2 : ℕ) : ℝ) * Real.log 2) := by
    rw [← Real.log_rpow two_pos, Real.exp_log (by positivity), Real.rpow_natCast]
  rw [e2]
  apply Real.exp_le_exp.2
  refine hx.trans ?_
  have : Real.pi * (16 * p / 300) ≤ 3.15 * (16 * p / 300) :=
    mul_le_mul_of_nonneg_right hpi.le (by positivity)
  nlinarith

