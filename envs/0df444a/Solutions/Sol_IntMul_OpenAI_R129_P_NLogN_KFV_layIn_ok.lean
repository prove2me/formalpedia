    rw [List.getElem?_eq_getElem (by simp; omega), getElem_permIdx,
      List.getD_eq_getElem _ _ (by simp; omega), List.getElem_take, List.getElem?_eq_getElem]
  · rw [List.getElem?_append_right (by simp; omega), List.getElem?_drop]
    simp only [length_permIdx, List.length_take, min_eq_left ha]
    have : KFU.mvIdx nA nF nG i = i := by unfold KFU.mvIdx; split_ifs <;> omega
    rw [this]; congr 1; omega

