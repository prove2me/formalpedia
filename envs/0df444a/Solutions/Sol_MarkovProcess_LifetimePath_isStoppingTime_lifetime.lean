/-!
# Canonical filtration of lifetime paths

The raw canonical filtration is generated by the cemetery-valued coordinates up to each time.
The lifetime is a stopping time because death by time `t` is exactly the event that the time-`t`
coordinate is the cemetery state.
-/

open MeasureTheory
open scoped ENNReal

namespace MarkovProcess.LifetimePath

variable {alpha : Type*} [TopologicalSpace alpha] [MeasurableSpace alpha]

omit [MeasurableSpace alpha] in
/-- A coordinate is the cemetery state exactly at and after the lifetime. -/
theorem coordinate_eq_delta_iff (omega : LifetimePath alpha) (t : NNReal) :
    coordinate t omega = Cemetery.delta ↔ omega.lifetime ≤ (t : ENNReal) := by
  constructor
  · intro hcoordinate
    by_contra hlifetime
    exact coordinate_ne_delta_of_lt omega t (lt_of_not_ge hlifetime) hcoordinate
  · exact coordinate_of_le omega t



/-- The time-`t` coordinate is measurable for the canonical filtration at time `t`. -/
theorem measurable_coordinate_canonicalFiltration (t : NNReal) :
    Measurable[canonicalFiltration (alpha := alpha) t]
      (coordinate (α := alpha) t) := by
  apply Measurable.of_comap_le
  exact le_iSup_of_le (⟨t, Set.mem_Iic.mpr le_rfl⟩ : Set.Iic t) le_rfl





end MarkovProcess.LifetimePath


