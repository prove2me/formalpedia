theorem jVs_eq (wd f pre post : ℕ) :
    jVs (wd : ℤ) (pre : ℤ) (post : ℤ) ((2 ^ f : ℕ) : ℤ) (f : ℤ) = cVals wd f pre 1 post := by
  simp [jVs, cVals]

theorem flatT_ccRows_length (T : Tables) (B : Blocks) (L : List ℕ) (m : ℕ) :
    (JK.flatT (ccRows T B L m)).length = m * (2 * B.w + 2) := by
  induction m with
  | zero => simp [ccRows, JK.flatT]
  | succ m ih =>
    simp only [ccRows, JK.flatT] at ih ⊢
    rw [List.range_succ (n := m), List.map_append, List.flatMap_append, List.length_append, ih]
    simp [JK.rowT]
    ring

theorem hdr_eq (Q kJ w m nB : ℕ) (fs : List (List ℤ)) (bs : List (List ℤ × List ℤ × ℤ × ℤ))
    (cc : List (List ℤ)) (hfs : fs.length = m) (hnB : nB = JK.nBd bs) (bl : ℤ)
    (hbl : bl = ((JK.jBody kJ fs bs cc).length : ℤ)) :
    hdrL ((2 ^ Q : ℕ) : ℤ) ((2 ^ (Q + 1) : ℕ) : ℤ) ((2 ^ kJ : ℕ) : ℤ) (nB : ℤ) (w : ℤ) bl m ++
        JK.jBody kJ fs bs cc =
      tabsT (fun _ => JK.jTab Q kJ w (2 ^ Nat.clog 2 m) fs bs cc) 1 := by
  subst hbl hnB
  simp [tabsT, segT, JK.jTab, JK.jHdr, hdrL, hfs]
  ring

end J6Seg.PJ

end

