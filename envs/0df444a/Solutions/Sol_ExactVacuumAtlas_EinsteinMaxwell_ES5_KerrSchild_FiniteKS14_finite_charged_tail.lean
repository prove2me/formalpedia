variable {I : Set ℝ} {f m N w p a F b A : ℝ → ℝ} {s h ε Q J : ℝ}
theorem solution (hP : PaperData I f m N w p a)
    (hN : FactorizedN I N s h) (hB : PaperBVP I f m N w p a Q J)
    (hS : FiniteBranch6 I s ε f m a F b A) (hQ : Q ≠ 0) :
    ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧ ∀ R : ℝ, s + δ⁻¹ < R →
      R ∈ I ∧ 0 < f R ∧ 0 < m R ∧ 0 < N R ∧ 0 < alphaSq f m N w p a R := by
  obtain ⟨δ, hδ, hδε, hpos⟩ := finite_exists_positive_compact_tail hS h Q hQ
  refine ⟨δ, hδ, hδε, fun R hR => ?_⟩
  have hRs : δ⁻¹ < R - s := by linarith
  have hRs0 : 0 < R - s := lt_trans (inv_pos.mpr hδ) hRs
  set x := (R - s)⁻¹ with hxdef
  have hx0 : 0 < x := inv_pos.mpr hRs0
  have hxδ : x < δ := (inv_lt_comm₀ hRs0 hδ).mpr hRs
  have hxε : x ∈ Set.Ioo 0 ε := ⟨hx0, lt_of_lt_of_le hxδ hδε⟩
  have hRx : R = s + x⁻¹ := by rw [hxdef, inv_inv]; ring
  obtain ⟨hF, hb, hu, hD⟩ := hpos x ⟨by linarith, hxδ⟩
  obtain ⟨hf, hm, hNc, -⟩ := finite_chart_data hP hN hS hxε
  have hid := finite_alphaSq_compact_identity hP hN hB hS hxε
  have hub : 0 < (1 - h * x) * b x := mul_pos hu hb
  have hprod : (1 - h * x) * b x * 0 < (1 - h * x) * b x * alphaSq f m N w p a (s + x⁻¹) := by
    rw [mul_zero, hid]; positivity
  rw [hRx]
  refine ⟨FiniteRegularity13.FiniteBranch6.chart_mem hS hxε, ?_, ?_, ?_,
    lt_of_mul_lt_mul_left hprod hub.le⟩
  · rw [hf]; exact hF
  · rw [hm]; positivity
  · rw [hNc]; positivity
