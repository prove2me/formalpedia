section
-- Source module: NLogN.HFW3
/-!
# Fermat-ring convolution machine, part 3: procedure calls and the relocated transposition

* `difPrc` / `ditPrc`: `RM.prc` calls of procedure number `0` (DIF, `pc 1`) and `1` (DIT, `pc 2`),
  with total functional specifications reading the SS registers
  `DX = 8` (data), `DL = 9` (`2^j`), `DE = 10` (`2^E`), `RN = 2` (`2^n`), `RF = 3` (`2^n+1`).
* `trP`: the transposition `transP 1` relocated so that its data stack is `8`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

/-- The data stack of the transforms (`ssH DX`). -/
abbrev XD : Fin HS := 8
/-- `2^j` (`ssH DL`) -/
abbrev XL : Fin HS := 9
/-- `2^E` (`ssH DE`) -/
abbrev XE : Fin HS := 10
/-- `2^n` (`ssH RN`) -/
abbrev XN : Fin HS := 2
/-- `2^n + 1` (`ssH RF`) -/
abbrev XF : Fin HS := 3

def itInt : Item → ℤ
  | .int a => a
  | _ => 0

/-! ## Specifications of the transforms -/

/-- Number of entries transformed: `2^j` read from `XL`. -/
def tlen (s : IState HS) : ℕ := (s.top XL).toNat

/-- The transformed data read from the state. -/
def tdat (s : IState HS) : List ℤ := ((s.G XD).take (tlen s)).map itInt

def difF (s : IState HS) : IState HS :=
  s.upd XD (ints (difZ (s.top XF) (Nat.log2 (s.top XE).toNat) (Nat.log2 (tlen s)) (tdat s)) ++
    (s.G XD).drop (tlen s))

def ditF (s : IState HS) : IState HS :=
  s.upd XD (ints (ditZ (s.top XF) (Nat.log2 (s.top NLogN.FW.XN).toNat) (Nat.log2 (s.top XE).toNat)
    (Nat.log2 (tlen s)) (tdat s)) ++ (s.G XD).drop (tlen s))

def difC (s : IState HS) : ℕ := difCost (Nat.log2 (s.top NLogN.FW.XN).toNat) (Nat.log2 (tlen s))
def ditC (s : IState HS) : ℕ := ditCost (Nat.log2 (s.top NLogN.FW.XN).toNat) (Nat.log2 (tlen s))

/-- Precondition of the SS transforms. -/
def preT (s : IState HS) : Prop :=
  ∃ (n j E : ℕ) (A : List ℤ) (R LL LE LN LF : List Item), 1 ≤ n ∧ A.length = 2 ^ j ∧
    (j = 0 ∨ 2 ^ j * E = 2 * n) ∧ Canon (2 ^ n + 1) A ∧ s.G XD = ints A ++ R ∧
    s.G XL = .int (2 ^ j) :: LL ∧ s.G XE = .int (2 ^ E) :: LE ∧ s.G NLogN.FW.XN = .int (2 ^ n) :: LN ∧
    s.G XF = .int (2 ^ n + 1) :: LF

theorem difF_frame (s : IState HS) (j : Fin HS) (hj : j ∉ [XD]) : (difF s).G j = s.G j := by
  simp only [List.mem_singleton] at hj; simp [difF, IState.upd_G, hj]

theorem ditF_frame (s : IState HS) (j : Fin HS) (hj : j ∉ [XD]) : (ditF s).G j = s.G j := by
  simp only [List.mem_singleton] at hj; simp [ditF, IState.upd_G, hj]

/-- DIF on the top `2^j` entries of `XD` (procedure `pc 1`). -/
def difPrc : RM := .prc 0 difF difC preT [XD] difF_frame (fun s => ⟨rfl, rfl⟩)

/-- DIT on the top `2^j` entries of `XD` (procedure `pc 2`). -/
def ditPrc : RM := .prc 1 ditF ditC preT [XD] ditF_frame (fun s => ⟨rfl, rfl⟩)

/-! ## The procedures meet their specifications -/

section prc

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} (pc : ℕ → Fin P)

end prc

/-! ## The relocated transposition -/

/-- Swap the data stack `0` of `transP` with `XD = 8`. -/
def σT : Equiv.Perm (Fin HS) := swapsPerm [(0, 8)]

/-- Transpose the `n × m` integer array on top of `XD`; `n, m, kb` on `1, 2, 3`. -/
def trP : RM := (RM.rs (transP 1)).ren σT

end NLogN.FW

end

section
-- Source module: NLogN.HFW4
/-!
# Fermat-ring convolution machine, part 4: one level of a multi-axis transform

Registers (all levels):
* `XD = 8` the array, `XL = 9` `2^j`, `XE = 10` `2^E`, `XN = 2` `2^n`, `XF = 3` `2^n+1`;
* `PR = 13` number of blocks, `BS = 14` number of columns `B`, `KBR = 27` `kb`
  (`2^j B ≤ 2^kb`), `NN = 19` the array length;
* scratch: `YC = 4` (columns), `ZB = 5` (blocks), counters `C0 = 6`, `C1 = 7`, `C2 = 11`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

abbrev YC : Fin HS := 4
abbrev ZB : Fin HS := 5
abbrev C0 : Fin HS := 6
abbrev C1 : Fin HS := 7
abbrev C2 : Fin HS := 11
abbrev PR : Fin HS := 13
abbrev BS : Fin HS := 14
abbrev NN : Fin HS := 19
abbrev KBR : Fin HS := 27

/-! ## Transposition with parameters from registers -/

/-- Transpose the `top a × top b` array on `XD`. -/
def trWith (a b : Fin HS) : RM :=
  RM.seqL [.rs (.push 1 (.reg a)), .rs (.push 2 (.reg b)), .rs (.push 3 (.reg KBR)), trP,
    .rs (.pop 1), .rs (.pop 2), .rs (.pop 3)]

/-! ## List helpers -/

/-! ## The column loop -/

/-- The SS registers hold `2^j`, `2^E`, `2^n`, `2^n + 1`. -/
def RegsOK (n j E : ℕ) (t : IState HS) : Prop :=
  ∃ LL LE LN LF : List Item, t.G XL = .int (2 ^ j) :: LL ∧ t.G XE = .int (2 ^ E) :: LE ∧
    t.G NLogN.FW.XN = .int (2 ^ n) :: LN ∧ t.G XF = .int (2 ^ n + 1) :: LF

/-- A transform program on the top `2^j` entries of `XD`. -/
def TrOK (M : MulSpec) (T : RM) (g : List ℤ → List ℤ) (n j E cT : ℕ) : Prop :=
  ∀ (t : IState HS) (A : List ℤ) (R : List Item), A.length = 2 ^ j → Canon (2 ^ n + 1) A →
    t.G XD = ints A ++ R → RegsOK n j E t → Spec M T t (t.upd XD (ints (g A) ++ R)) cT

/-- Transforms keep length and canonical form. -/
def GOK (g : List ℤ → List ℤ) (n j : ℕ) : Prop :=
  ∀ A : List ℤ, A.length = 2 ^ j → Canon (2 ^ n + 1) A →
    (g A).length = 2 ^ j ∧ Canon (2 ^ n + 1) (g A)

def colBody (T : RM) : RM := .seq T (.rs (mvList XD YC C2 (.reg XL)))

def colLoop (T : RM) : RM := .rep C1 (.reg BS) (colBody T)

def colSt (g : List ℤ → List ℤ) (s : IState HS) (Cs : List (List ℤ)) (RD : List Item) (k : ℕ) :
    IState HS :=
  (s.upd XD (ints (Cs.drop k).flatten ++ RD)).upd YC (ints ((Cs.take k).flatMap g).reverse ++ s.G YC)

/-! ## One block -/

/-- `B · 2^j` -/
def cbE : Ex HS := .shl (.reg BS) (.reg XL)

def blkBody (T : RM) : RM :=
  RM.seqL [trWith XL BS, colLoop T, .rs (mvList YC XD C2 cbE), trWith BS XL,
    .rs (mvList XD NLogN.FW.ZB C2 cbE)]

/-- Cost of one block (`Cb = 2^j B` entries). -/
def blkCost (j B kb W cT : ℕ) : ℕ :=
  4 * 10 ^ 6 * (kb + 1) * (2 ^ j * B + 1) * (W + kb + 5) + 40000 * (W + 2) +
    (B * (cT + 2 ^ j * (14000 * (W + 2) + 30) + 12000 * (W + 2) + 62) + 4000 * (W + 2) + 32) +
    2 * (8000 * (W + 2) + 2 ^ j * B * (14000 * (W + 2) + 30) + 32)

def blkSt (g : List ℤ → List ℤ) (j B : ℕ) (s : IState HS) (Bl : List (List ℤ)) (RD : List Item)
    (k : ℕ) : IState HS :=
  (s.upd XD (ints (Bl.drop k).flatten ++ RD)).upd NLogN.FW.ZB
    (ints ((Bl.take k).flatMap (Ref.colMap j B g)).reverse ++ s.G NLogN.FW.ZB)

/-! ## One level -/

def lvlP (T : RM) : RM :=
  .seq (.rep C0 (.reg PR) (blkBody T)) (.rs (mvList NLogN.FW.ZB XD C2 (.reg NN)))

/-- Cost of one level with `pre` blocks. -/
def lvlCost (pre j B kb W cT : ℕ) : ℕ :=
  pre * (blkCost j B kb W cT + 8000 * (W + 2) + 30) + pre * (2 ^ j * B) * (14000 * (W + 2) + 30) +
    8000 * (W + 2) + 64

end NLogN.FW

end

section
-- Source module: NLogN.HFW5
/-!
# Fermat-ring convolution machine, part 5: passes over all axes

A level descriptor `(pre, j, E, B)` is stored as the four integers `pre, 2^j, 2^E, B`
(`encF`).  The forward pass reads the descriptors from `AXS = 15` (moving them to `AXR = 16`,
where they end up reversed); the backward pass reads them from `AXR` in reverse order and moves
them back.  Counter `CAX = 17`, number of levels on `NAX = 18`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FW

open IntMul IntMul.HvdH NLogN

abbrev AXS : Fin HS := 15
abbrev AXR : Fin HS := 16
abbrev CAX : Fin HS := 17
abbrev NAX : Fin HS := 18

/-! ## Cost of a level -/

/-! ## Reading descriptors -/

/-- Copy the top of `src` to `r` and move it to `dst`. -/
def rd (src dst r : Fin HS) : RM :=
  RM.seqL [.rs (.push r (.reg src)), .rs (.push dst (.reg src)), .rs (.pop src)]

/-- Move the top of `src` to `dst`. -/
def mv1 (src dst : Fin HS) : RM := RM.seqL [.rs (.push dst (.reg src)), .rs (.pop src)]

/-- A descriptor as a palindrome of eight integers. -/
def enc8 (d : Desc) : List ℤ :=
  [(d.1 : ℤ), 2 ^ d.2.1, 2 ^ d.2.2.1, (d.2.2.2 : ℤ), (d.2.2.2 : ℤ), 2 ^ d.2.2.1, 2 ^ d.2.1, (d.1 : ℤ)]

/-- Read a descriptor into `PR, XL, XE, BS`, moving its eight integers from `src` to `dst`. -/
def rd8 (src dst : Fin HS) : RM :=
  RM.seqL [rd src dst PR, rd src dst XL, rd src dst XE, rd src dst BS, mv1 src dst, mv1 src dst,
    mv1 src dst, mv1 src dst]

/-! ## One axis -/

def axBody (src dst : Fin HS) (T : RM) : RM :=
  RM.seqL [rd8 src dst, lvlP T, .rs (.pop PR), .rs (.pop XL), .rs (.pop XE), .rs (.pop BS)]

/-- Side conditions of a level descriptor for an array of length `N`. -/
def DescOK (n kb W N : ℕ) (d : Desc) : Prop :=
  d.1 * (2 ^ d.2.1 * d.2.2.2) = N ∧ 1 ≤ d.1 ∧ 1 ≤ d.2.2.2 ∧ N ≤ 2 ^ kb ∧ n + 1 ≤ W ∧
    d.2.1 + 1 ≤ W ∧ d.2.2.1 + 1 ≤ W ∧ kb + 1 ≤ W

/-! ## A pass over all levels -/

def passP (src dst : Fin HS) (T : RM) : RM := .rep CAX (.reg NAX) (axBody src dst T)

/-- All conditions on the levels of a pass. -/
def PassOK (M : MulSpec) (T : RM) (G : ℕ → ℕ → List ℤ → List ℤ) (cT : ℕ → ℕ) (n kb W N J : ℕ)
    (D : List Desc) : Prop :=
  ∀ d ∈ D, DescOK n kb W N d ∧ TrOK M T (G d.2.2.1 d.2.1) n d.2.1 d.2.2.1 (cT d.2.1) ∧
    GOK (G d.2.2.1 d.2.1) n d.2.1 ∧ d.2.1 ≤ J

def pSt (G : ℕ → ℕ → List ℤ → List ℤ) (src dst : Fin HS) (s : IState HS) (D : List Desc)
    (A : List ℤ) (RD Rs : List Item) (k : ℕ) : IState HS :=
  ((s.upd XD (ints (lvls G (D.take k) A) ++ RD)).upd src (ints ((D.drop k).flatMap enc8) ++ Rs)).upd
    dst (ints ((D.take k).flatMap enc8).reverse ++ s.G dst)

/-- Cost of a pass over `m` levels. -/
def passCost (m n kb W N J : ℕ) : ℕ :=
  m * (10 ^ 7 * (kb + 1) * N * (W + kb + 5) + 500000 * (n + 3) * (J + 1) * N + 98000 * (W + 2) + 30) +
    4000 * (W + 2) + 32

end NLogN.FW

end

