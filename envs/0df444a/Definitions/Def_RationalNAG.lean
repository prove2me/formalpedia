import Mathlib
import Definitions.Def_Coefficients
import Definitions.Def_FunctionClass

namespace FullFormalization

open scoped Gradient

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The `(x_k, y_k)` pair of the rational-momentum Nesterov method, source
(3.1)-(3.2).  `nagPair f L x₀ k = (x_k, y_k)`. -/
noncomputable def nagPair (f : E → ℝ) (L : ℝ) (x₀ : E) : ℕ → E × E
  | 0 => (x₀, x₀)
  | k + 1 =>
      let p := nagPair f L x₀ k
      let y' := p.1 - (1 / L) • ∇ f p.1
      (y' + mom k • (y' - p.2), y')

/-- `x_k`, the extrapolated iterate. -/
noncomputable def nagX (f : E → ℝ) (L : ℝ) (x₀ : E) (k : ℕ) : E :=
  (nagPair f L x₀ k).1

/-- `y_k`, the gradient-step iterate. -/
noncomputable def nagY (f : E → ℝ) (L : ℝ) (x₀ : E) (k : ℕ) : E :=
  (nagPair f L x₀ k).2



















