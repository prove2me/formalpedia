theorem nsmul_add' {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (m n : ℕ) (P : SchemeHomOver t E'.f) :
    E'.L.nsmul t (m + n) P = E'.L.mul t (E'.L.nsmul t m P) (E'.L.nsmul t n P) := by
