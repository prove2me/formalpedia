theorem trC_eq (w h : ℕ) (bs : List Bool) (R : List Item) (u : IState HS)
    (hX : u.G X = ints (descTr w h bs) ++ .mark :: R) :
    trC X Kc u = ⌈trBound Kc w h bs.length (vol (shPad h bs))⌉₊ + trOver w h bs.length := by
  have hb : NLogN.KFY.blk (u.G X) = ints (descTr w h bs) := by rw [hX, blk_ints]
  have hsh : trSh X u = shPad h bs := by
