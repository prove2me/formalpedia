variable {A R M : Type*} [CommRing A] [CommRing R] [AddCommGroup M] [Module A M]

theorem natCard_eq_card_ker_mul_card_range {X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
    (g : X →+ Y) : Nat.card X = Nat.card g.ker * Nat.card g.range := by
  rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g.ker,
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange g).toEquiv, Nat.mul_comm]

theorem smul_eq_zero_of_mem_torsionBySet {S : Set A} {a : A} (ha : a ∈ S) {x : M}
    (hx : x ∈ Submodule.torsionBySet A M S) : a • x = 0 :=
  (Submodule.mem_torsionBySet_iff S x).1 hx ⟨a, ha⟩

theorem mem_torsionBySet_span_singleton {a : A} {x : M} (h : a • x = 0) :
    x ∈ Submodule.torsionBySet A M (↑(Ideal.span ({a} : Set A)) : Set A) := by
  rw [Submodule.mem_torsionBySet_iff]
  rintro ⟨b, hb⟩
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 hb
  show (r * a) • x = 0
  rw [mul_smul, h, smul_zero]

theorem exists_hom_natCard_ker_le
    (η : A →+* R) (I : Ideal R) (W D F : AddSubgroup M) [Finite ↥D] [Finite ↥F]
    (hD : ∀ t : A, ∀ x ∈ D, t • x ∈ D)
    (h2 : ∀ w ∈ W, (2 : ℕ) • w ∈ D)
    (hF : ∀ w ∈ W, (2 : ℕ) • w = 0 → w ∈ F)
    (ι : ↥D →+ R ⧸ I)
    (hι : ∀ (t : A) (x : ↥D) (htx : t • (x : M) ∈ D),
      ι ⟨t • (x : M), htx⟩ = Ideal.Quotient.mk I (η t) * ι x) :
    ∃ g : ↥W →+ R ⧸ I,
      (∀ (t : A) (z : ↥W) (htz : t • (z : M) ∈ W),
        g ⟨t • (z : M), htz⟩ = Ideal.Quotient.mk I (η t) * g z) ∧
      Nat.card ↥g.ker ≤ Nat.card ↥F * Nat.card ↥ι.ker := by
  classical
  let τ : ↥W →+ ↥D := AddMonoidHom.mk' (fun w => ⟨(2 : ℕ) • (w : M), h2 w w.2⟩)
    (fun a b => Subtype.ext (by
      show (2 : ℕ) • ((a : M) + (b : M)) = (2 : ℕ) • (a : M) + (2 : ℕ) • (b : M)
      exact smul_add _ _ _))
  refine ⟨ι.comp τ, ?_, ?_⟩
  · intro t z htz
    have hmem : t • ((2 : ℕ) • (z : M)) ∈ D := hD t _ (h2 z z.2)
    have key : ι ⟨t • ((2 : ℕ) • (z : M)), hmem⟩ = Ideal.Quotient.mk I (η t) * ι (τ z) :=
      hι t (τ z) hmem
    have hτeq : τ ⟨t • (z : M), htz⟩ = ⟨t • ((2 : ℕ) • (z : M)), hmem⟩ := by
      apply Subtype.ext
      show (2 : ℕ) • (t • (z : M)) = t • ((2 : ℕ) • (z : M))
      rw [two_nsmul, two_nsmul, smul_add]
    rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply, hτeq]
    exact key
  · let K : AddSubgroup ↥W := (ι.comp τ).ker
    let τK : ↥K →+ ↥D := τ.comp K.subtype
    have hcard : Nat.card ↥K = Nat.card ↥τK.ker * Nat.card ↥τK.range :=
      natCard_eq_card_ker_mul_card_range τK
    have hrange : τK.range ≤ ι.ker := by
      rintro _ ⟨w, rfl⟩
      exact AddMonoidHom.mem_ker.2 (AddMonoidHom.mem_ker.1 w.2)
    have h1 : Nat.card ↥τK.range ≤ Nat.card ↥ι.ker := AddSubgroup.card_le_of_le hrange
    have hmemF : ∀ w : ↥τK.ker, (((w : ↥K) : ↥W) : M) ∈ F := fun w =>
      hF _ ((w : ↥K) : ↥W).2 (by
        have hw : ((τK (w : ↥K) : ↥D) : M) = ((0 : ↥D) : M) :=
          congrArg Subtype.val (AddMonoidHom.mem_ker.1 w.2)
        exact hw)
    have h2' : Nat.card ↥τK.ker ≤ Nat.card ↥F := by
      refine Nat.card_le_card_of_injective (fun w => (⟨_, hmemF w⟩ : ↥F)) ?_
      intro a b hab
      have hval := congrArg Subtype.val hab
      dsimp only at hval
      exact Subtype.ext (Subtype.ext (Subtype.ext hval))
    calc Nat.card ↥(ι.comp τ).ker = Nat.card ↥τK.ker * Nat.card ↥τK.range := hcard
      _ ≤ Nat.card ↥F * Nat.card ↥ι.ker := Nat.mul_le_mul h2' h1

theorem exists_hom_of_le
    (η : A →+* R) (I : Ideal R) (W F : AddSubgroup M) [Finite ↥F] (hWF : W ≤ F) :
    ∃ g : ↥W →+ R ⧸ I,
      (∀ (t : A) (z : ↥W) (htz : t • (z : M) ∈ W),
        g ⟨t • (z : M), htz⟩ = Ideal.Quotient.mk I (η t) * g z) ∧
      Nat.card ↥g.ker ≤ Nat.card ↥F := by
  haveI : Finite ↥W := Finite.of_injective _ (AddSubgroup.inclusion_injective hWF)
  refine ⟨0, fun t z htz => by rw [AddMonoidHom.zero_apply, AddMonoidHom.zero_apply, mul_zero], ?_⟩
  calc Nat.card ↥(0 : ↥W →+ R ⧸ I).ker ≤ Nat.card ↥W :=
        Nat.card_le_card_of_injective _ Subtype.val_injective
    _ ≤ Nat.card ↥F := AddSubgroup.card_le_of_le hWF

theorem glue
    (η : A →+* R) (I : Ideal R) (W D F : AddSubgroup M) [Finite ↥D] [Finite ↥F]
    (hD : ∀ t : A, ∀ x ∈ D, t • x ∈ D)
    (hF : ∀ w ∈ W, (2 : ℕ) • w = 0 → w ∈ F)
    (ι : ↥D →+ R ⧸ I)
    (hι : ∀ (t : A) (x : ↥D) (htx : t • (x : M) ∈ D),
      ι ⟨t • (x : M), htx⟩ = Ideal.Quotient.mk I (η t) * ι x)
    {C₁ : ℕ} (hker : Nat.card ↥ι.ker ≤ 2 ^ C₁)
    (hcases : (∀ w ∈ W, (2 : ℕ) • w ∈ D) ∨ W ≤ F) :
    ∃ g : ↥W →+ R ⧸ I,
      (∀ (t : A) (z : ↥W) (htz : t • (z : M) ∈ W),
        g ⟨t • (z : M), htz⟩ = Ideal.Quotient.mk I (η t) * g z) ∧
      Nat.card ↥g.ker ≤ 2 ^ (C₁ + Nat.card ↥F) := by
  rcases hcases with h2 | hWF
  · obtain ⟨g, hg, hgk⟩ := exists_hom_natCard_ker_le η I W D F hD h2 hF ι hι
    refine ⟨g, hg, hgk.trans ?_⟩
    calc Nat.card ↥F * Nat.card ↥ι.ker ≤ Nat.card ↥F * 2 ^ C₁ := Nat.mul_le_mul_left _ hker
      _ ≤ 2 ^ Nat.card ↥F * 2 ^ C₁ := Nat.mul_le_mul_right _ (Nat.le_of_lt Nat.lt_two_pow_self)
      _ = 2 ^ (C₁ + Nat.card ↥F) := by rw [pow_add, mul_comm]
  · obtain ⟨g, hg, hgk⟩ := exists_hom_of_le η I W F hWF
    exact ⟨g, hg, hgk.trans ((Nat.le_of_lt Nat.lt_two_pow_self).trans
      (Nat.pow_le_pow_right two_pos (Nat.le_add_left _ _)))⟩

end Generic

theorem two_nsmul_mem_of_mod_four {M : Type*} [AddCommGroup M] (D : AddSubgroup M)
    {k m : ℕ} (hk : k % 4 = 3) (hm : 2 ≤ m) {w : M}
    (hdisp : k • w - w ∈ D) (htor : (2 ^ m) • w = 0) : (2 : ℕ) • w ∈ D := by
  set q := k / 4 with hq
  have hk' : k = 2 * (2 * q + 1) + 1 := by omega
  have hdisp' : (2 * (2 * q + 1)) • w ∈ D := by
    have h1 : k • w - w = (2 * (2 * q + 1)) • w := by
      rw [hk', add_nsmul, one_nsmul, add_sub_cancel_right]
    rwa [h1] at hdisp
  have hcop : Nat.Coprime (2 * q + 1) (2 ^ m) :=
    Nat.Coprime.pow_right m (Nat.coprime_two_right.2 ⟨q, rfl⟩)
  have h1m : 1 < 2 ^ m := Nat.one_lt_two_pow (by omega)
  obtain ⟨u, -, hu⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop h1m
  set r := (2 * q + 1) * u / 2 ^ m with hr
  have hru : (2 * q + 1) * u = 2 ^ m * r + 1 := by
    have hdm := Nat.div_add_mod ((2 * q + 1) * u) (2 ^ m)
    rw [hu] at hdm
    exact hdm.symm
  have hmem : u • ((2 * (2 * q + 1)) • w) ∈ D := D.nsmul_mem hdisp' u
  have hX : 2 * (2 * q + 1) * u = 2 ^ m * (2 * r) + 2 := by
    calc 2 * (2 * q + 1) * u = 2 * ((2 * q + 1) * u) := by ring
      _ = 2 * (2 ^ m * r + 1) := by rw [hru]
      _ = 2 ^ m * (2 * r) + 2 := by ring
  have hcalc : u • ((2 * (2 * q + 1)) • w) = (2 : ℕ) • w := by
    rw [← mul_nsmul, hX, add_nsmul, mul_nsmul, htor, nsmul_zero, zero_add]
  rw [hcalc] at hmem
  exact hmem

theorem mod_four_eq_three {K : Type*} [Field K] {ζ : K} (hζ : ζ ^ 2 = -1) (h2 : (2 : K) ≠ 0)
    {k : ℕ} (h : ζ ^ k = ζ ^ 3) : k % 4 = 3 := by
  have hζ4 : ζ ^ 4 = 1 := by
    rw [show (4 : ℕ) = 2 * 2 from rfl, pow_mul, hζ, neg_one_sq]
  have hk : ζ ^ (k % 4) = ζ ^ 3 := by
    rw [← h]
    conv_rhs => rw [← Nat.div_add_mod k 4, pow_add, pow_mul, hζ4, one_pow, one_mul]
  have hlt : k % 4 < 4 := Nat.mod_lt _ (by norm_num)
  generalize hs : k % 4 = s at hk hlt
  obtain rfl | rfl | rfl | rfl : s = 0 ∨ s = 1 ∨ s = 2 ∨ s = 3 := by omega
  · exfalso; apply h2
    linear_combination (1 - ζ) * hk + (-ζ ^ 2 + ζ + 1) * hζ
  · exfalso; apply h2
    linear_combination (-ζ) * hk + (2 - ζ ^ 2) * hζ
  · exfalso; apply h2
    linear_combination (-(1 + ζ)) * hk + (2 - ζ ^ 2) * hζ
  · rfl

end KDMGDN3

theorem solution
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∃ C : ℕ, ∀ m : ℕ,
      ∀ n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ,
        (∀ σ, ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ m) = 1 → σ ζ = ζ ^ n σ) →
      ∀ W : AddSubgroup (JZero p), W ≤ eisensteinTorsionBar p 2 m →
        MultiplicativeTypeNat (B.inertiaSubgroupIn ℚ) n W →
      ∃ g : ↥W →+ (↥(heckeLatticeAlgebra p ∅) ⧸
            Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}),
        (∀ (t : HeckeAlg) (z : ↥W) (htz : t • (z : JZero p) ∈ W),
          g ⟨t • (z : JZero p), htz⟩ =
            Ideal.Quotient.mk (Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m})
              (((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) t) * g z) ∧
        Nat.card ↥g.ker ≤ 2 ^ C := by
  letI : Module HeckeAlg (JZero p) := heckeModuleBar p

  have hOD0 :=
    ModularCurve.exists_addSubgroup_le_eisensteinTorsionBar_inertia_smul_sub_mem_addMonoidHom_heckeLatticeAlgebra_quotient_natCard_ker_le
      p B hB
  obtain ⟨C₁, hOD⟩ := hOD0

  have hF0 := ModularCurve.heckeTorsion_jZero_finite_of_natCast_mem p
    (Ideal.span {((2 : ℕ) : HeckeAlg)}) 2 two_pos (Ideal.mem_span_singleton_self _)
  haveI hFfin : Finite ↥(heckeTorsion (JZero p) (Ideal.span {((2 : ℕ) : HeckeAlg)})).toAddSubgroup :=
    @Finite.of_injective _ ↥(heckeTorsion (JZero p) (Ideal.span {((2 : ℕ) : HeckeAlg)})) hF0
      (fun x => ⟨x.1, x.2⟩) (fun a b h => Subtype.ext (congrArg Subtype.val h))
  refine ⟨C₁ + Nat.card ↥(heckeTorsion (JZero p) (Ideal.span {((2 : ℕ) : HeckeAlg)})).toAddSubgroup, fun m n hn W hW hμ => ?_⟩
  have hμ' : ∀ σ ∈ B.inertiaSubgroupIn ℚ, ∀ x ∈ W, σ • x = n σ • x := hμ
  have hODm := hOD m
  obtain ⟨D, hDle, hDst, hDco, ι, hι, hker⟩ := hODm

  have h2P : ((2 : ℕ) : HeckeAlg) ∈ eisensteinMaximalIdeal p 2 :=
    natCast_mem_eisensteinMaximalIdeal p 2
  have h2Pm : ((2 ^ m : ℕ) : HeckeAlg) ∈ (eisensteinMaximalIdeal p 2) ^ m := by
    rw [Nat.cast_pow]; exact Ideal.pow_mem_pow h2P m
  have hB0 := ModularCurve.heckeTorsion_jZero_finite_of_natCast_mem p
    ((eisensteinMaximalIdeal p 2) ^ m) (2 ^ m) (pow_pos two_pos m) h2Pm
  haveI hBarfin : Finite ↥(eisensteinTorsionBar p 2 m) :=
    @Finite.of_injective _ ↥(heckeTorsion (JZero p) ((eisensteinMaximalIdeal p 2) ^ m)) hB0
      (fun x => ⟨x.1, x.2⟩) (fun a b h => Subtype.ext (congrArg Subtype.val h))
  haveI hDfin : Finite ↥D := Finite.of_injective _ (AddSubgroup.inclusion_injective hDle)

  have htor : ∀ w ∈ W, (2 ^ m) • w = 0 := by
    intro w hw
    have hw' : w ∈ Submodule.torsionBySet HeckeAlg (JZero p)
        (↑((eisensteinMaximalIdeal p 2) ^ m) : Set HeckeAlg) := hW hw
    have h0 := KDMGDN3.smul_eq_zero_of_mem_torsionBySet h2Pm hw'
    rwa [Nat.cast_smul_eq_nsmul] at h0

  have hF : ∀ w ∈ W, (2 : ℕ) • w = 0 → w ∈ (heckeTorsion (JZero p) (Ideal.span {((2 : ℕ) : HeckeAlg)})).toAddSubgroup := by
    intro w _ h2w
    have h2w' : ((2 : ℕ) : HeckeAlg) • w = 0 := by rw [Nat.cast_smul_eq_nsmul, h2w]
    exact KDMGDN3.mem_torsionBySet_span_singleton h2w'

  have hcases : (∀ w ∈ W, (2 : ℕ) • w ∈ D) ∨ W ≤ (heckeTorsion (JZero p) (Ideal.span {((2 : ℕ) : HeckeAlg)})).toAddSubgroup := by
    by_cases hm : 2 ≤ m
    · left

      have hσ0 :=
        ValuationSubring.exists_mem_inertiaSubgroupIn_apply_eq_pow_three_of_pow_four_eq_one B hB
      obtain ⟨σ, hσI, hσ⟩ := hσ0
      have hζ0 := IsAlgClosed.exists_pow_nat_eq (-1 : AlgebraicClosure ℚ) two_pos
