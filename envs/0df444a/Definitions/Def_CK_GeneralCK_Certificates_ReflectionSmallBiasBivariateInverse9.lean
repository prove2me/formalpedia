theorem inversePower9_eval (k : ℂ) (z : ℂ × ℂ) :
    eval k (mulTrunc 24 (parameter (-9)) inverseSum9) z = eval k inversePower9 z := by
  have he := eval_eq_of_degrees 24 k inversePower9_raw inversePower9 z
    (degreeBound_sound inversePower9_raw_bound) (degreeBound_sound inversePower9_result_bound)
    inversePower9_degrees
  change eval k (normalize inversePower9_raw) z = eval k inversePower9 z
  rw [eval_normalize]
  exact he

theorem inversePower9_approximates {k : ℂ} (hk : k ≠ 0) (hklog : k = (Real.log 2:ℂ)) :
    Approximates 24 k (fun z => ((meanFunction z)⁻¹)^9) inversePower9 := by
  have h23 := (lossPower23_approximates hk hklog).scale (7888725 : ℚ)
  have h22 := ((lossPower22_approximates hk hklog).scale (5852925 : ℚ)).addAppend h23
  have h21 := ((lossPower21_approximates hk hklog).scale (4292145 : ℚ)).addAppend h22
