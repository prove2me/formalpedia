theorem solution (p : ℕ) [Fact p.Prime]
    (q : ℕ) [Fact q.Prime] (hq2 : q ≠ 2) (hqn : q ∣ eisensteinNumerator p)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (S : JZeroNeronPrimaryTorsionSheaf p q A hA) :
    ∃ g : ℕ, ∃ C : ℤ, ∀ m : ℕ,
      ((S.invPins.inv m).δ : ℤ) ≤ (m : ℤ) * (g : ℤ) + C ∧
        (m : ℤ) * (g : ℤ) ≤ ((S.invPins.inv m).α : ℤ) + C := by
  classical
  letI := heckeModuleBar p
  have hp : p.Prime := Fact.out
  have hq : q.Prime := Fact.out
  haveI : NeZero q := ⟨hq.ne_zero⟩
  have hqp : q ≠ p := by
    intro h
    subst h
    have h1 : q ∣ q - 1 := hqn.trans (eisensteinNumerator_dvd q)
    have h2 := hq.two_le
    have h3 : q ≤ q - 1 := Nat.le_of_dvd (by omega) h1
    omega
  obtain ⟨Aq, hAq⟩ := ValuationSubring.exists_liesOverPrime_algebraicClosure_rat ⟨q, hq⟩

  obtain ⟨c, hc, hcomm⟩ := ModularCurve.exists_eisensteinPrimaryTorsionBar_eq_torsionBySet_span_sup_pow p q
  set I : Ideal HeckeAlg := Ideal.span {(q : HeckeAlg)} ⊔ eisensteinMaximalIdeal p q ^ c with hI
  have hqI : (q : HeckeAlg) ∈ I := Ideal.mem_sup_left (Ideal.subset_span rfl)
  have hPI : eisensteinMaximalIdeal p q ^ c ≤ I := le_sup_right
  have hIP : I ≤ eisensteinMaximalIdeal p q :=
    sup_le ((Ideal.span_singleton_le_iff_mem _).mpr (natCast_mem_eisensteinMaximalIdeal p q))
      (Ideal.pow_le_self hc.ne')

  have hfin : Finite ↥(Submodule.torsionBy ℤ (JZero p) (q : ℤ)) := by
    have := ModularCurve.jZeroTorsionFinite p q hq.pos
    exact this

  obtain ⟨e, C1, hJ⟩ := Submodule.natCard_torsionBySet_pow_linear_of_finite_torsionBy HeckeAlg (JZero p) q hfin I hqI
  obtain ⟨eT, C2, hT⟩ := ModularCurve.natCard_jZeroToricTorsion_inf_torsionBySet_pow_linearGrowth p q A hA I hqI

  let f : HeckeAlg →+* ↥(heckeLatticeAlgebra p ∅) := (latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)
  let IL : Ideal ↥(heckeLatticeAlgebra p ∅) := Ideal.map f I
  have hqIL : (q : ↥(heckeLatticeAlgebra p ∅)) ∈ IL := by
    have := Ideal.mem_map_of_mem f hqI
    rwa [map_natCast] at this
  obtain ⟨e0, C0, hL⟩ :=
    Ideal.card_quotient_pow_hilbertSamuel_linear_of_moduleFinite (↥(heckeLatticeAlgebra p ∅)) IL q hqIL
  obtain ⟨C5a, hW2a⟩ :=
    ModularCurve.exists_natCard_torsionBySet_jZero_le_sq_natCard_torsionBySet_heckeLatticeAlgebra_quotient_mul_pow p q I hqI
  obtain ⟨C5b, hW2b⟩ :=
    Ideal.exists_natCard_torsionBySet_quotient_span_natCast_pow_le_natCard_quotient_pow_mul_pow_of_moduleFinite
      (↥(heckeLatticeAlgebra p ∅)) IL q hqIL
  obtain ⟨C3, hC5⟩ :=
    ModularCurve.natCard_torsionBySet_pow_le_sq_natCard_jZeroToricTorsion_inf_mul p q hqp A hA I hqI
  obtain ⟨C4, hER⟩ :=
    ModularCurve.exists_natCard_heckeLatticeAlgebra_quotient_span_pow_sup_pow_le_natCard_eisensteinPrimaryTorsionBar_quotient_mul_pow
      p q hq2 hqp Aq hAq
  have hAL := ModularCurve.natCard_eisensteinPrimaryTorsionBar_quotient_eq_pow_alpha_of_multiplicativeTypeNat
    p q hq2 hqp A hA S Aq hAq
  have hDC := ModularCurve.exists_multiplicativeTypeNat_torsionBySet_pow_inertiaSubgroupIn p q hqp Aq hAq I hqI c hPI

  have hα : ∀ m, Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m) ≤ q ^ (S.invPins.inv m).α * q ^ C4 := by
    intro m
    obtain ⟨n, hn⟩ := P2MHybrid.cyc_char q m
    obtain ⟨W, hWle, hWmt, hWun⟩ := hDC m n hn
    obtain ⟨M, hM, hERM⟩ := hER m (c * m)

    rw [← hcomm m] at hWle hWun
    have h1 := hERM n hn W hWle hWmt hWun
    rw [hAL m n hn W hWle hWmt hWun] at h1

    have hle : Ideal.span {((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅))} ⊔
        (Ideal.map f (eisensteinMaximalIdeal p q)) ^ M ≤ IL ^ m := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_singleton_le_iff_mem]
        exact Ideal.pow_mem_pow hqIL m
      · calc (Ideal.map f (eisensteinMaximalIdeal p q)) ^ M
            ≤ (Ideal.map f (eisensteinMaximalIdeal p q)) ^ (c * m) := Ideal.pow_le_pow_right hM
          _ = ((Ideal.map f (eisensteinMaximalIdeal p q)) ^ c) ^ m := pow_mul _ _ _
          _ ≤ IL ^ m := by
              apply Ideal.pow_right_mono
              rw [← Ideal.map_pow]
              exact Ideal.map_mono hPI
    haveI : Finite (↥(heckeLatticeAlgebra p ∅) ⧸
        (Ideal.span {((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅))} ⊔ (Ideal.map f (eisensteinMaximalIdeal p q)) ^ M)) := by
      exact G1Aux.finite_quotient_of_natCast_mem _ (q ^ m) (pow_ne_zero m hq.ne_zero)
        (Ideal.mem_sup_left (Ideal.subset_span (Set.mem_singleton_iff.mpr (Nat.cast_pow q m))))
    have h2 : Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m) ≤ Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸
        (Ideal.span {((q : ℕ) ^ m : ↥(heckeLatticeAlgebra p ∅))} ⊔ (Ideal.map f (eisensteinMaximalIdeal p q)) ^ M)) :=
      Nat.card_le_card_of_surjective _ (Ideal.Quotient.factor_surjective hle)
    exact h2.trans h1

  have hW2 : ∀ m, Nat.card ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup ≤ Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m) ^ 2 * q ^ (2 * C5b + C5a) := by
    intro m
    calc Nat.card ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup
        ≤ _ ^ 2 * q ^ C5a := hW2a m
      _ ≤ (Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m) * q ^ C5b) ^ 2 * q ^ C5a :=
          Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (hW2b m) 2)
      _ = Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m) ^ 2 * q ^ (2 * C5b + C5a) := by ring

  have hTJ : ∀ m, Nat.card ↥(jZeroToricTorsion p A (q ^ m) ⊓ (Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup) ≤ Nat.card ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup := by
    intro m
    haveI hfinS : Finite ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)) := by
      apply Nat.finite_of_card_ne_zero
      intro h0
      have := (hJ m).2
      rw [h0, zero_mul] at this
      exact absurd this (not_le.mpr (pow_pos hq.pos _))
    haveI : Finite ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup := hfinS
    exact AddSubgroup.card_le_of_le inf_le_right

  have hδ : ∀ m, Nat.card ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup = q ^ (S.invPins.inv m).δ * Nat.card ↥(jZeroToricTorsion p A (q ^ m) ⊓ (Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup) := by
    intro m
    have := S.invPins.δ_pin m
    change Nat.card ↥(eisensteinPrimaryTorsionBar p q m) =
      q ^ (S.invPins.inv m).δ * Nat.card ↥(jZeroToricTorsion p A (q ^ m) ⊓ eisensteinPrimaryTorsionBar p q m) at this
    rw [hcomm m] at this
    exact this
  exact P2MHybrid.core q hq.one_lt
    (fun m => Nat.card ↥(Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup) (fun m => Nat.card ↥(jZeroToricTorsion p A (q ^ m) ⊓ (Submodule.torsionBySet HeckeAlg (JZero p) (↑(I ^ m) : Set HeckeAlg)).toAddSubgroup))
    (fun m => Nat.card (↥(heckeLatticeAlgebra p ∅) ⧸ IL ^ m)) (fun m => (S.invPins.inv m).δ) (fun m => (S.invPins.inv m).α)
    hδ e C1 hJ eT C2 hT e0 C0 hL (2 * C5b + C5a) hW2 C3 hC5 C4 hα hTJ

end S_ModularCurve_jZeroNeronTorsionSheaf_inv_linearGrowth_v5
