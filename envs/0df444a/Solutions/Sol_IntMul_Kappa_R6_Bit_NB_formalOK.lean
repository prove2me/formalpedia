  · unfold fin1
    by_cases hs : 3542 ≤ w ∧ w < 43619
    · rw [if_pos hs, d2 w (List.mem_range'_1.2 ⟨hs.1, by omega⟩), c2 w hw,
        seg1.1 w (by omega), slot_eq hs.1, k3s (by omega), h.mx b hb, lab1,
