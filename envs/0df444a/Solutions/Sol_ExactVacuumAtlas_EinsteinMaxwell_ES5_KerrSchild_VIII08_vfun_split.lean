open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII05
theorem solution {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) {R : ℝ} (hR : 3 < R) :
    vfun j q r R - j / R ^ 2
      = ∫ t in (0:ℝ)..(1 / R), (6 * t * beta j q t - t ^ 2 * r t) := by
  have hR0 : (0:ℝ) < R := by linarith
  have hu0 : (0:ℝ) ≤ 1 / R := by positivity
  have haG : aG = 1 / 3 := rfl
  have h1Ra : (1:ℝ) / R ≤ aG := by
    rw [haG]; exact one_div_le_one_div_of_le (by norm_num : (0:ℝ) < 3) (le_of_lt hR)
  have hcont : ContinuousOn (ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Gfun j q r) (Icc (0:ℝ) aG) :=
    continuousOn_Gfun (j := j) hqc hq hAq hr
  have hcontL : ContinuousOn (fun t : ℝ => 2 * j * t) (Icc (0:ℝ) aG) :=
    continuousOn_const.mul continuousOn_id
  have hshift : ContinuousOn (fun t : ℝ => 6 * t * beta j q t - t ^ 2 * r t) (Icc (0:ℝ) aG) :=
    continuousOn_Gshift (j := j) hqc hq hAq hr
  have hsub : Icc (0:ℝ) (1 / R) ⊆ Icc (0:ℝ) aG := Icc_subset_Icc le_rfl h1Ra
  have hI1 : IntervalIntegrable (fun t : ℝ => (2:ℝ) * j * t) volume (0:ℝ) (1 / R) :=
    (hcontL.mono hsub).intervalIntegrable_of_Icc hu0
  have hI2 : IntervalIntegrable (fun t : ℝ => 6 * t * beta j q t - t ^ 2 * r t) volume
      (0:ℝ) (1 / R) := (hshift.mono hsub).intervalIntegrable_of_Icc hu0
  have hcongr : (fun t : ℝ => ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Gfun j q r t)
      = fun t : ℝ => (2:ℝ) * j * t + (6 * t * beta j q t - t ^ 2 * r t) := by
    funext t; unfold ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII08.Gfun; ring
  have hfirst : ∫ t in (0:ℝ)..(1 / R), (2:ℝ) * j * t = j / R ^ 2 := by
    rw [intervalIntegral.integral_const_mul, integral_id]
    field_simp
    ring
  rw [vfun, hcongr, intervalIntegral.integral_add hI1 hI2, hfirst]
  ring
