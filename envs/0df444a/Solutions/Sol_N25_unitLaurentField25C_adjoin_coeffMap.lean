import Mathlib
import Definitions.Def_N25_Units
import Definitions.Def_N25_UnitAnalytic
import Definitions.Def_N25_UnitLaurentField
import Definitions.Def_N25_CoefficientMap
import Theorems.Thm_ModularCurve_qExpFunctionFieldC_eq_adjoin_image_coeffMap_qExpFunctionFieldC
import Theorems.Thm_N25_unitSeries25_coeffMap

/-! Coefficient extension of the two modular units and the fields they generate. -/
noncomputable section

namespace N25

/-- Extending coefficients in the field generated by the units gives the same two generators. -/
theorem _root_.solution (k K : Type*)
    [Field k] [Field K] [Algebra k K] :
    IntermediateField.adjoin K
      (ModularCurve.coeffMap (algebraMap k K) ''
        (unitLaurentField25C k : Set (LaurentSeries k))) = unitLaurentField25C K := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨x, hx, rfl⟩
    change x ∈ IntermediateField.adjoin k
      ({unitSeries25 k 0, unitSeries25 k 0 / unitSeries25 k 1} : Set (LaurentSeries k)) at hx
    induction hx using IntermediateField.adjoin_induction with
    | mem z hz =>
      rcases Set.mem_insert_iff.mp hz with rfl | hz
      · rw [unitSeries25_coeffMap]
        exact IntermediateField.subset_adjoin K _ (Set.mem_insert _ _)
      · have he : z = unitSeries25 k 0 / unitSeries25 k 1 := Set.mem_singleton_iff.mp hz
        subst z
        rw [map_div₀, unitSeries25_coeffMap, unitSeries25_coeffMap]
        exact IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))
    | algebraMap c =>
      rw [ModularCurve.algebraMap_laurentSeries_eq_single, ModularCurve.coeffMap_single,
        ← ModularCurve.algebraMap_laurentSeries_eq_single]
      exact IntermediateField.algebraMap_mem _ _
    | add z w _ _ hz hw =>
      rw [map_add]
      exact add_mem hz hw
    | mul z w _ _ hz hw =>
      rw [map_mul]
      exact mul_mem hz hw
    | inv z _ hz =>
      rw [map_inv₀]
      exact inv_mem hz
  · apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rcases Set.mem_insert_iff.mp hz with rfl | hz
    · apply IntermediateField.subset_adjoin K _
      exact ⟨unitSeries25 k 0,
        IntermediateField.subset_adjoin k _ (Set.mem_insert _ _),
        unitSeries25_coeffMap k K 0⟩
    · have he : z = unitSeries25 K 0 / unitSeries25 K 1 := Set.mem_singleton_iff.mp hz
      subst z
      apply IntermediateField.subset_adjoin K _
      refine ⟨unitSeries25 k 0 / unitSeries25 k 1,
        IntermediateField.subset_adjoin k _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)), ?_⟩
      rw [map_div₀, unitSeries25_coeffMap, unitSeries25_coeffMap]

end N25
