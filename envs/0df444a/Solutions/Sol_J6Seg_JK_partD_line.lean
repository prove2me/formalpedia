-- Source module: Solutions.J6SegJPre2
/-!
# `J` kernel precondition (JPre), part 2: entries and pivots of the elimination

`ElimOK P S L A η` bundles the hypotheses of `aseq_rows`/`geSolveS_eq` (near-identity rows with
`η + |L|²/2^P ≤ 1/2`, zero pattern, `PatOK`). Under it, on every trailing block `L.drop r`:

* `aseq_dev`: `|A_r(i,k)/2^P - δ_ik| ≤ 1/2`;
* `aseq_abs_le` / `aseq_int_le`: `|A_r(i,k)| ≤ (3/2) 2^P ≤ 2^{P+1}`; `aseq_zsz`: `zsz ≤ P + 1`;
* `aseq_off`: off the diagonal `|A_r(i,k)| ≤ 2^P/2`;
* `aseq_piv` / `aseq_piv_int`: the pivot `A_r(i,i) ≥ 2^P/2` (`≥ 2^{P-1}` in `ℤ`);
* `aseq_offsum`: the off-diagonal part of pivot row `r` sums to `≤ 2^P/2`;
* `fco_abs_le`: the forward multipliers satisfy `|F| ≤ 2^P + 1`.

`segReg_elim`: the capacitance of a line in the regime `SegReg` satisfies `ElimOK` on
`LJ` with the pattern `bandS (λ+w) (s-λ-w)`; `segReg_aseq` collects the bounds there.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

lemma getD_mem_drop {L : List ℕ} {q r : ℕ} (hqr : q ≤ r) (hr : r < L.length) :
    L.getD r 0 ∈ L.drop q := by
  rw [List.getD_eq_getElem _ _ hr, List.mem_drop_iff_getElem]
  exact ⟨r - q, by omega, by simp only [show q + (r - q) = r by omega]⟩

lemma getD_ne_of_nodup {L : List ℕ} (hnd : L.Nodup) {q r : ℕ} (hqr : q ≠ r) (hq : q < L.length)
    (hr : r < L.length) : L.getD q 0 ≠ L.getD r 0 := by
  rw [List.getD_eq_getElem _ _ hq, List.getD_eq_getElem _ _ hr]
  intro h
  exact hqr ((List.Nodup.getElem_inj_iff hnd).1 h)

section elim
variable {P : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ} {η : ℝ}

theorem aseq_dev (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) :
    |(Aseq P S L A r i k : ℝ) / 2 ^ P - kd i k| ≤ 1 / 2 :=
  (single_le_sum (f := fun k => |(Aseq P S L A r i k : ℝ) / 2 ^ P - kd i k|)
    (fun _ _ => abs_nonneg _) (List.mem_toFinset.2 hk)).trans
    (aseq_rows P S L A (fun _ => 0) η h.nd h.η0 h.ηs h.row h.zero h.pat r hr i hi)

theorem aseq_abs_le (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) :
    |(Aseq P S L A r i k : ℝ)| ≤ 3 / 2 * 2 ^ P := by
  have hS := two_pow_pos' P
  have hd := aseq_dev h hr hi hk
  have hkd : |kd i k| ≤ 1 := by unfold kd; split_ifs <;> norm_num
  have h1 : |(Aseq P S L A r i k : ℝ) / 2 ^ P| ≤ 3 / 2 := by
    have := abs_sub_abs_le_abs_sub ((Aseq P S L A r i k : ℝ) / 2 ^ P) (kd i k)
    linarith
  rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at h1
  exact h1

theorem aseq_off (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) (hik : i ≠ k) :
    |(Aseq P S L A r i k : ℝ)| ≤ 2 ^ P / 2 := by
  have hS := two_pow_pos' P
  have hd := aseq_dev h hr hi hk
  rw [kd_ne hik, sub_zero, abs_div, abs_of_pos hS, div_le_iff₀ hS] at hd
  linarith

theorem aseq_piv (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i : ℕ}
    (hi : i ∈ L.drop r) : (2 : ℝ) ^ P / 2 ≤ Aseq P S L A r i i := by
  have hS := two_pow_pos' P
  have hd := aseq_dev h hr hi hi
  rw [kd_self] at hd
  have := neg_abs_le ((Aseq P S L A r i i : ℝ) / 2 ^ P - 1)
  have h2 : 1 / 2 ≤ (Aseq P S L A r i i : ℝ) / 2 ^ P := by linarith
  rw [le_div_iff₀ hS] at h2
  linarith

theorem aseq_natAbs_lt (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) : (Aseq P S L A r i k).natAbs < 2 ^ (P + 1) := by
  have h1 := aseq_abs_le h hr hi hk
  have hS := two_pow_pos' P
  have : ((Aseq P S L A r i k).natAbs : ℝ) < ((2 ^ (P + 1) : ℕ) : ℝ) := by
    rw [Nat.cast_natAbs, Int.cast_abs]; push_cast; rw [pow_succ]; linarith
  exact_mod_cast this

theorem aseq_zsz (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i k : ℕ}
    (hi : i ∈ L.drop r) (hk : k ∈ L.drop r) : NLogN.zsz (Aseq P S L A r i k) ≤ P + 1 :=
  NLogN.zsz_le_of_lt (aseq_natAbs_lt h hr hi hk)

theorem aseq_piv_pos (h : ElimOK P S L A η) {r : ℕ} (hr : r ≤ L.length) {i : ℕ}
    (hi : i ∈ L.drop r) : 0 < Aseq P S L A r i i := by
  have := aseq_piv h hr hi
  have hS := two_pow_pos' P
  have : (0 : ℝ) < Aseq P S L A r i i := by linarith
  exact_mod_cast this

/-- The forward multipliers. -/
theorem fco_abs_le (h : ElimOK P S L A η) {r q : ℕ} (hqr : q < r) (hr : r < L.length) :
    |(fco P S L A r q : ℝ)| ≤ 2 ^ P + 1 := by
  have hS := two_pow_pos' P
  unfold fco
  split_ifs with hs
  · have hq : q < L.length := by omega
    have hmr := getD_mem_drop (L := L) hqr.le hr
    have hmq := getD_mem_drop (L := L) (le_refl q) hq
    have hoff := aseq_off h hq.le hmr hmq (getD_ne_of_nodup h.nd (by omega) hr hq)
    have hpv := aseq_piv h hq.le hmq
    have hpos := aseq_piv_pos h hq.le hmq
    have herr := fdiv_err P (Aseq P S L A q (L.getD r 0) (L.getD q 0)) hpos
    set a : ℝ := (Aseq P S L A q (L.getD r 0) (L.getD q 0) : ℝ)
    set y : ℝ := (Aseq P S L A q (L.getD q 0) (L.getD q 0) : ℝ)
    have hy : 0 < y := by linarith
    have e : a / 2 ^ P / (y / 2 ^ P) = a / y := by field_simp
    rw [e] at herr
    have hay : |a / y| ≤ 1 := by
      rw [abs_div, abs_of_pos hy, div_le_one hy]; linarith
    have h3 : |(fdiv P (Aseq P S L A q (L.getD r 0) (L.getD q 0))
        (Aseq P S L A q (L.getD q 0) (L.getD q 0)) : ℝ) / 2 ^ P| ≤ 1 + 1 / (2 * 2 ^ P) := by
      have := abs_sub_abs_le_abs_sub ((fdiv P (Aseq P S L A q (L.getD r 0) (L.getD q 0))
        (Aseq P S L A q (L.getD q 0) (L.getD q 0)) : ℝ) / 2 ^ P) (a / y)
      linarith
    rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at h3
    have : (1 + 1 / (2 * 2 ^ P)) * (2 : ℝ) ^ P = 2 ^ P + 1 / 2 := by field_simp
    linarith
  · simp; linarith

end elim

/-! ## The line in the regime -/

section reg
variable {P R s t lam w α : ℕ}

theorem segReg_elim (h : SegReg P R s t lam w α) :
    ∃ η : ℝ, η ≤ 1 / 4 ∧ (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8 ∧
      ElimOK P (bandS (lam + w) (s - lam - w)) (LJ s t lam w)
        (capI P (TT P R s t α) (BB s t lam w)) η := by
  obtain ⟨η, h0, h4, h8, hrow, hzero⟩ := segReg_cap h
  have hS := two_pow_pos' P
  refine ⟨η, h4, h8, ⟨LJ_nodup s t lam w, h0, ?_, hrow, hzero,
    bandS_patOK _ _ _ (LJ_sorted (s := s) (t := t) (lam := lam) (w := w))⟩⟩
  have : ((LJ s t lam w).length : ℝ) ^ 2 / 2 ^ P ≤
      (((LJ s t lam w).length : ℝ) + 1) ^ 2 / 2 ^ P :=
    div_le_div_of_nonneg_right (by nlinarith [(Nat.cast_nonneg (LJ s t lam w).length : (0 : ℝ) ≤ _)])
      hS.le
  linarith

end reg

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre4
/-!
# `J` kernel precondition (JPre), part 4: the intermediates of the kernel in closed form

For the streams `fsOf`/`bsOf` of a sorted line `L` (pattern `bandS mw c`, border `c ≤ ·`) and an
input `v` (`|L| ≤ |v|`), with the right-hand side `bv L v` (`bv (L_r) = v_r`):

* `fA_eq`: the forward accumulator after `r` rows is `accF r = [bt_{r-1}, …, bt_0]`;
* `bwdS_eq`: the backward state after `j` records is `(accZ (m-j), accB (m-j))` (the solution
  values `z_{m-j}, …, z_{m-1}` and their border part);
* the shapes of the streams (`fsOf_getElem_length`, `bsOf_getElem`, `WbOf_le`,
  `czOf_length`, `flOf_01`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK

lemma bv_at {L : List ℕ} (hnd : L.Nodup) (v : List ℤ) {r : ℕ} (hr : r < L.length) :
    bv L v (L.getD r 0) = v.getD r 0 := by
  unfold bv
  rw [List.getD_eq_getElem _ _ hr, List.Nodup.idxOf_getElem hnd r hr]

section line
variable {P : ℕ} {L : List ℕ} {mw c : ℕ} {A : ℕ → ℕ → ℤ}

lemma fsOf_length : (fsOf P L mw c A).length = L.length := by simp [fsOf]

lemma bsOf_length : (bsOf P L mw c A).length = L.length := by simp [bsOf]

lemma fsOf_getElem {r : ℕ} (hr : r < (fsOf P L mw c A).length) :
    (fsOf P L mw c A)[r] = fsW P (bandS mw c) L A r (cfOf L mw c r) := by
  simp [fsOf]

lemma fsOf_getElem_length (hsort : L.Pairwise (· < ·)) {r : ℕ}
    (hr : r < (fsOf P L mw c A).length) : (fsOf P L mw c A)[r].length ≤ r := by
  rw [fsOf_getElem]
  have hrm : r < L.length := by rw [fsOf_length] at hr; exact hr
  simp only [fsW, List.length_map, List.length_range]
  exact (fwdSupp_of (mw := mw) (c := c) hsort hrm).1

lemma bsOf_getElem {j : ℕ} (hj : j < (bsOf P L mw c A).length) :
    (bsOf P L mw c A)[j] =
      (cbOf P (bandS mw c) L A (c ≤ ·) (WbOf L mw (L.length - 1 - j)) (L.length - 1 - j),
        czOf P (bandS mw c) L A (c ≤ ·) (L.length - 1 - j),
        Aseq P (bandS mw c) L A (L.length - 1 - j) (L.getD (L.length - 1 - j) 0)
          (L.getD (L.length - 1 - j) 0), flOf L (c ≤ ·) (L.length - 1 - j)) := by
  simp [bsOf, List.getElem_reverse]

lemma WbOf_le (r : ℕ) : WbOf L mw r ≤ L.length - 1 - r := by
  unfold WbOf
  refine (card_filter_le _ _).trans ?_
  rw [Nat.card_Ioo]; omega

lemma czOf_length (r : ℕ) (Y : ℕ → ℤ) :
    (czOf P (bandS mw c) L A (c ≤ ·) r).length =
      (accB P (bandS mw c) L A Y (flOf L (c ≤ ·)) (r + 1)).length := by
  simp [czOf, bIdx, accB]

lemma flOf_01 (r : ℕ) : flOf L (c ≤ ·) r = 0 ∨ flOf L (c ≤ ·) r = 1 := by
  unfold flOf; split_ifs <;> simp

/-- **The forward accumulators.** -/
theorem fA_eq (hsort : L.Pairwise (· < ·)) (v : List ℤ) (hv : L.length ≤ v.length) :
    ∀ r ≤ L.length, fA P (fsOf P L mw c A) v r =
      accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := bv L v) r := by
  have hnd : L.Nodup := hsort.imp (fun h => ne_of_lt h)
  intro r
  induction r with
  | zero => intro _; rw [fA_zero]; simp [accF]
  | succ r ih =>
    intro hr
    have hrm : r < L.length := by omega
    have hfl : r < (fsOf P L mw c A).length := by rw [fsOf_length]; exact hrm
    rw [fA_succ P _ v hfl (by omega), ih (by omega), fsOf_getElem hfl]
    have hvr : v[r]'(by omega) = bv L v (L.getD r 0) := by
      rw [bv_at hnd v hrm, List.getD_eq_getElem _ _ (by omega)]
    rw [hvr]
    have hsupp := fwdSupp_of (mw := mw) (c := c) hsort hrm
    have e : bv L v (L.getD r 0) - dotF P (fsW P (bandS mw c) L A r (cfOf L mw c r))
        (accF (P := P) (S := bandS mw c) (L := L) (A := A) (b := bv L v) r) =
        btV P (bandS mw c) L A (bv L v) r := by
      rw [bt_window r (cfOf L mw c r) hrm.le hsupp]
      congr 1
      unfold dotF fsW
      simp only [List.length_map, List.length_range]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      simp only [Finset.mem_range] at hi
      have hc := hsupp.1
      rw [List.getD_eq_getElem _ _ (by simp; omega)]
      simp only [List.getElem_map, List.getElem_range]
      rw [accF_getD (by omega)]
    rw [e]
    unfold accF; rw [List.range_succ]; simp

end line

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre5
/-!
# `J` kernel precondition (JPre), part 5: value bounds

* `fmul_abs_le`, `dotF_abs_le`: `|fmul x y| ≤ |x||y|/2^P + 1/2`, and the dot product bound;
* `z_bound`: under `ElimOK`, `η ≤ 1/4`, `(|L|+1)²/2^P ≤ 1/8` and `|b| ≤ M`, every value of the
  sparse solve satisfies `|z| ≤ 4M + 2^P` (from `geSolve_bound` and `geSolveS_eq`);
* `bt_bound`: the forward values satisfy `|bt_r| ≤ 2 Z + 3/4 + |L|/2` when `|z| ≤ Z`
  (from the closed back substitution and `fdiv_err`);
* `cpl_abs_le`, `ccOf_abs_le`: the coupling entries are `≤ 2^P + 1`, the window coefficients
  `≤ (2w+1)(2^P+1)`.
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section vals
variable {P : ℕ} {S : ℕ → ℕ → Prop} [DecidableRel S] {L : List ℕ} {A : ℕ → ℕ → ℤ} {η : ℝ}

/-- **The solution values.** -/
theorem z_bound (h : ElimOK P S L A η) (hη : η ≤ 1 / 4)
    (hL : ((L.length : ℝ) + 1) ^ 2 / 2 ^ P ≤ 1 / 8) (b : ℕ → ℤ) {M : ℝ}
    (hb : ∀ i, |(b i : ℝ)| ≤ M) (hM : 0 ≤ M) :
    ∀ k, |(geSolveS P S L A b k : ℝ)| ≤ 4 * M + 2 ^ P := by
  have hS := two_pow_pos' P
  have hge := geSolveS_eq P S L A b η h.nd h.η0 h.ηs h.row h.zero h.pat
  have hB := (geSolve_bound P L A b η (M / 2 ^ P) h.nd h.η0 hη hL h.row
    (fun i _ => by rw [abs_div, abs_of_pos hS]; exact div_le_div_of_nonneg_right (hb i) hS.le)
    (by positivity)).1
  intro k
  by_cases hk : k ∈ L
  · rw [hge k]
    have := hB k hk
    rw [abs_div, abs_of_pos hS, div_le_iff₀ hS] at this
    have e : (4 * (M / 2 ^ P) + 1) * 2 ^ P = 4 * M + 2 ^ P := by field_simp
    linarith
  · rw [geSolveS_off P S L A b k hk]; simp; positivity

end vals

section cc
variable {P R s t lam w α : ℕ}

lemma cpl_abs_le (hs : 0 < s) (i : ℕ) (h : ℤ) :
    |((TT P R s t α).cpl i h : ℝ)| ≤ 2 ^ P + 1 := by
  show |(expNeg P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) : ℝ)| ≤ 2 ^ P + 1
  have hx0 : 0 ≤ π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ) := by positivity
  have hb := expNeg_err (P := P) (s := s ^ 2) (by positivity) (α ^ 2 * (eKz s t i h).toNat)
    (x := π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ)) rfl
  have he : Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))) ≤ 1 :=
    Real.exp_le_one_iff.2 (by linarith)
  have hp := Real.exp_pos (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ)))
  have hS := two_pow_pos' P
  have := abs_sub_abs_le_abs_sub (expNeg P (s ^ 2) (α ^ 2 * (eKz s t i h).toNat) : ℝ)
    (2 ^ P * Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))))
  rw [abs_of_pos (by positivity : (0 : ℝ) < 2 ^ P * Real.exp
    (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) / ((s ^ 2 : ℕ) : ℝ))))] at this
  have : (2 : ℝ) ^ P * Real.exp (-(π * ((α ^ 2 * (eKz s t i h).toNat : ℕ) : ℝ) /
      ((s ^ 2 : ℕ) : ℝ))) ≤ 2 ^ P := by nlinarith
  linarith

lemma ccOf_abs_le (hs : 0 < s) (L : List ℕ) (K r i : ℕ) :
    |(ccOf (TT P R s t α) (BB s t lam w) L K r i : ℝ)| ≤ (2 * w + 1) * (2 ^ P + 1) := by
  unfold ccOf
  rw [Int.cast_sum]
  refine (abs_sum_le_sum_abs _ _).trans ?_
  refine (sum_le_sum (g := fun _ => (2 : ℝ) ^ P + 1) (fun h _ => ?_)).trans ?_
  · split_ifs
    · exact cpl_abs_le hs _ _
    · simp; positivity
  · rw [sum_const, nsmul_eq_mul]
    have hc0 := Hset_card (B := BB s t lam w) (L.getD r 0)
    have hw : (BB s t lam w).w = w := rfl
    rw [hw] at hc0
    have hc : ((Hset (BB s t lam w) (L.getD r 0)).card : ℝ) ≤ 2 * w + 1 := by exact_mod_cast hc0
    have := two_pow_pos' P
    nlinarith

end cc

end J6Seg

end

section
-- Source module: Solutions.J6SegJPre6
/-!
# `J` kernel precondition (JPre), part 6: the explicit parameters and the table length

* `Xb0 P w Bv = max Bv P + size (2w+1) + 4`: the a-priori bit bound of every stream entry and
  intermediate of the `J` kernel on an input with `Bnd Bv`;
* `Bc0 s K G = size (G + 2K + 3s² + 2Ks + 10s)`: the counter bound;
* `jBody_len`: `|jBody| ≤ 3m² + 2Km + 7m` for streams of `m` rows with the line shapes;
* `zsz_of_abs`, `abs_of_bnd`: between `zsz` bounds and real bounds;
* `xb0_ge`: `2^{Xb0} ≥ 16 (2w+2) 2^{max Bv P}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL Function

lemma zsz_of_abs {a : ℤ} {X : ℕ} (h : |(a : ℝ)| < 2 ^ X) : zsz a ≤ X := by
  apply zsz_le_of_lt
  have : ((a.natAbs : ℕ) : ℝ) < ((2 ^ X : ℕ) : ℝ) := by
    rw [Nat.cast_natAbs, Int.cast_abs]; push_cast; exact h
  exact_mod_cast this

lemma abs_of_bnd {a : ℤ} {X : ℕ} (h : zsz a ≤ X) : |(a : ℝ)| < 2 ^ X := by
  have h1 := zsz_le_iff.1 h
  have : ((a.natAbs : ℕ) : ℝ) < ((2 ^ X : ℕ) : ℝ) := by exact_mod_cast h1
  rw [Nat.cast_natAbs, Int.cast_abs] at this; push_cast at this; exact this

lemma xb0_ge (P w Bv : ℕ) :
    16 * (2 * (w : ℝ) + 2) * 2 ^ (max Bv P) ≤ 2 ^ Xb0 P w Bv := by
  unfold Xb0
  have h1 : 2 * w + 1 < 2 ^ Nat.size (2 * w + 1) := Nat.lt_size_self _
  have h2 : ((2 * w + 2 : ℕ) : ℝ) ≤ ((2 ^ Nat.size (2 * w + 1) : ℕ) : ℝ) := by
    exact_mod_cast h1
  push_cast at h2
  rw [pow_add, pow_add]
  have : (0 : ℝ) < 2 ^ max Bv P := by positivity
  nlinarith

lemma length_flatMap_le {α : Type*} (l : List α) (g : α → List ℤ) (c : ℕ)
    (h : ∀ x ∈ l, (g x).length ≤ c) : (l.flatMap g).length ≤ l.length * c := by
  induction l with
  | nil => simp
  | cons a l ih =>
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    have h1 := h a (by simp)
    have h2 := ih (fun x hx => h x (by simp [hx]))
    rw [Nat.succ_mul]; omega

theorem jBody_len {k m K : ℕ} {fs : List (List ℤ)} {bs : List (List ℤ × List ℤ × ℤ × ℤ)}
    {cc : List (List ℤ)} (hfs : fs.length = m) (hbs : bs.length = m) (hcc : cc.length = m)
    (hf : ∀ r (h : r < fs.length), fs[r].length + 1 ≤ m)
    (hb : ∀ j (h : j < bs.length), bs[j].1.length ≤ m ∧ bs[j].2.1.length ≤ m)
    (hc : ∀ r (h : r < cc.length), cc[r].length = 2 * K + 1) :
    (jBody k fs bs cc).length ≤ 3 * m ^ 2 + 2 * K * m + 7 * m := by
  unfold jBody
  have h1 : (flatT fs).length ≤ fs.length * m := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [rowT, List.length_cons]; exact hf r hr
  have h2 : (flatB k bs).length ≤ bs.length * (2 * m + 5) := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.1 hx
    have := hb j hj
    simp only [recT, rowT, List.length_append, List.length_cons, List.length_nil]
    omega
  have h3 : (flatT cc).length ≤ cc.length * (2 * K + 2) := by
    apply length_flatMap_le
    intro x hx
    obtain ⟨r, hr, rfl⟩ := List.mem_iff_getElem.1 hx
    simp only [rowT, List.length_cons]; rw [hc r hr]
  rw [hfs] at h1; rw [hbs] at h2; rw [hcc] at h3
  simp only [List.length_append]
  have e : m * m + m * (2 * m + 5) + m * (2 * K + 2) = 3 * m ^ 2 + 2 * K * m + 7 * m := by ring
  omega

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegJPre7
/-!
# `J` kernel precondition (JPre), part 7: `PartD` and `JPre` for the streams of a line

**`partD_line`**: in the regime `SegReg P R s t λ w α`, with `K ≤ |LJ| ≤ G`, for every gathered
row part `v` of length `G` with `Bnd Bv v`, the streams `jFs`, `jBs`, `jCc` of the line satisfy
`PartD P k K G Xb Bc … v` for every `Xb ≥ Xb0 P w Bv`, `Bc ≥ Bc0 s K G` and
`k ≥ 2 Xb + 2 P + Bc + 6`.

**`jPre_line`**: the same for both parts of a `GI` row, i.e. `JPre`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Finset

namespace J6Seg.JK
open IntMul NLogN NLogN.KIL NLogN.KFB Function

section asm
variable {P R s t lam w α K G Bv Xb Bc k : ℕ}

set_option maxHeartbeats 1000000 in
/-- **`PartD` for the streams of a line.** -/
theorem partD_line_sol_aux (h : SegReg P R s t lam w α)
    (hK : K ≤ (LJ s t lam w).length) (hG : (LJ s t lam w).length ≤ G)
    (hXb : Xb0 P w Bv ≤ Xb) (hBc : Bc0 s K G ≤ Bc) (hk : 2 * Xb + 2 * P + Bc + 6 ≤ k)
    (v : List ℤ) (hv : v.length = G) (hvb : Bnd Bv v) :
    PartD P k K G Xb Bc (jFs P R s t lam w α) (jBs P R s t lam w α)
      (jCc P R s t lam w α K) v := by
  obtain ⟨η, hη4, hL8, hE⟩ := segReg_elim h
  have hsort := LJ_sorted (s := s) (t := t) (lam := lam) (w := w)
  have hS := two_pow_pos' P
  have hMP : (2 : ℝ) ^ P ≤ 2 ^ max Bv P := pow_le_pow_right₀ (by norm_num) (le_max_right _ _)
  have hMB : (2 : ℝ) ^ Bv ≤ 2 ^ max Bv P := pow_le_pow_right₀ (by norm_num) (le_max_left _ _)
  have hw0 : (0 : ℝ) ≤ w := Nat.cast_nonneg _
  have hP1 : (1 : ℝ) ≤ 2 ^ P := one_le_pow₀ (by norm_num)
  have hX : ∀ a : ℤ, |(a : ℝ)| ≤ 11 * (2 * w + 1) * 2 ^ max Bv P → zsz a ≤ Xb := by
    intro a ha
    apply zsz_of_abs
    have h1 := xb0_ge P w Bv
    have h2 : (2 : ℝ) ^ Xb0 P w Bv ≤ 2 ^ Xb := pow_le_pow_right₀ (by norm_num) hXb
    have : (0 : ℝ) < 2 ^ max Bv P := by positivity
    nlinarith
  have hup : ∀ y : ℝ, y ≤ 11 * 2 ^ max Bv P → y ≤ 11 * (2 * w + 1) * 2 ^ max Bv P := by
    intro y hy
    have : (0 : ℝ) < 2 ^ max Bv P := by positivity
    nlinarith
  have hXP : P + 1 ≤ Xb := by unfold Xb0 at hXb; omega
  have hXB : Bv ≤ Xb := by unfold Xb0 at hXb; omega
  have hfs : jFs P R s t lam w α = fsOf P (LJ s t lam w) (lam + w) (s - lam - w)
      (capI P (J6Seg.TT P R s t α) (BB s t lam w)) := rfl
  have hbs : jBs P R s t lam w α = bsOf P (LJ s t lam w) (lam + w) (s - lam - w)
      (capI P (J6Seg.TT P R s t α) (BB s t lam w)) := rfl
  have hcl : (jCc P R s t lam w α K).length = (LJ s t lam w).length := by simp [jCc]
  have hccr : ∀ r (hr : r < (jCc P R s t lam w α K).length),
      (jCc P R s t lam w α K)[r] = ccL P R s t lam w α K r := by
    intro r hr; simp [jCc]
  rw [hfs, hbs]
  set L := LJ s t lam w with hLd
  set m := L.length with hm
  set A := capI P (J6Seg.TT P R s t α) (BB s t lam w) with hAd
  set Sb := bandS (lam + w) (s - lam - w) with hSb
  have hms : m ≤ s := LJ_length_le_s s t lam w
  -- the input
  have hvl : m ≤ v.length := by omega
  have hbv : ∀ i, |(bv L v i : ℝ)| ≤ 2 ^ Bv := by
    intro i; unfold bv
    by_cases hi : L.idxOf i < v.length
    · rw [List.getD_eq_getElem _ _ hi]; exact (abs_of_bnd (hvb _ (List.getElem_mem _))).le
    · rw [List.getD_eq_default _ _ (by omega)]; simp only [Int.cast_zero, abs_zero]; positivity
  have hz0 := z_bound hE hη4 hL8 (bv L v) hbv (by positivity)
  have hz : ∀ q, |(geSolveS P Sb L A (bv L v) q : ℝ)| ≤ 11 * 2 ^ max Bv P := fun q => by
    have := hz0 q; linarith
  have hs8 := (segReg_num h).2.2.2.1
  have hmsR : (m : ℝ) ≤ s := by exact_mod_cast hms
  have hbt : ∀ r < m, |(btV P Sb L A (bv L v) r : ℝ)| ≤ 11 * 2 ^ max Bv P := by
    intro r hr
    have hz5 : ∀ q, |(geSolveS P Sb L A (bv L v) q : ℝ)| ≤ 5 * 2 ^ max Bv P := fun q => by
      have := hz0 q; linarith
    have := bt_bound hE (bv L v) hz5 hr
    have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg _
    have : (s : ℝ) + 1 ≤ ((s : ℝ) + 1) ^ 2 := by nlinarith
    linarith
  have hfA : ∀ r ≤ m, fA P (fsOf P L (lam + w) (s - lam - w) A) v r =
      accF (P := P) (S := Sb) (L := L) (A := A) (b := bv L v) r :=
    fun r hr => fA_eq hsort v hvl r hr
  have haccF : ∀ r ≤ m, Bnd Xb (accF (P := P) (S := Sb) (L := L) (A := A) (b := bv L v) r) := by
    intro r hr a ha
    unfold accF at ha
    rw [List.mem_reverse, List.mem_map] at ha
    obtain ⟨q, hq, rfl⟩ := ha
    rw [List.mem_range] at hq
    exact hX _ (hup _ (hbt q (by omega)))
  have hbw : ∀ j ≤ m, bwdS P (bsOf P L (lam + w) (s - lam - w) A)
      (accF (P := P) (S := Sb) (L := L) (A := A) (b := bv L v) m) j =
      (accZ P Sb L A (bv L v) (m - j), accB P Sb L A (bv L v) (flOf L (s - lam - w ≤ ·)) (m - j)) :=
    fun j hj => bwdS_eq hsort (bv L v) j hj
  have hzW : ∀ q, zsz (zW P Sb L A (bv L v) q) ≤ Xb := fun q => hX _ (hup _ (hz _))
  have hAs : ∀ r ≤ m, ∀ i ∈ L.drop r, ∀ k ∈ L.drop r, zsz (Aseq P Sb L A r i k) ≤ Xb :=
    fun r hr i hi k hk => (aseq_zsz hE hr hi hk).trans hXP
  -- the size of the table
  have hcz : ∀ r, (czOf P Sb L A (s - lam - w ≤ ·) r).length ≤ m := by
    intro r
    simp only [czOf, bIdx, List.length_map]
    exact (List.length_filter_le _ _).trans (by simp only [List.length_range']; omega)
  have hbody := jBody_len (k := k) (m := m) (K := K) (fs := fsOf P L (lam + w) (s - lam - w) A)
    (bs := bsOf P L (lam + w) (s - lam - w) A) (cc := jCc P R s t lam w α K) fsOf_length
    bsOf_length hcl
    (fun r hr => by
      have := fsOf_getElem_length hsort hr
      rw [fsOf_length] at hr; omega)
    (fun j hj => by
      rw [bsOf_getElem hj]
      refine ⟨?_, hcz _⟩
      simp only [cbOf, List.length_map, List.length_range]
      rw [bsOf_length] at hj
      refine (WbOf_le (L := L) (mw := lam + w) _).trans ?_
      omega)
    (fun r hr => by rw [hccr r hr]; simp [ccL])
  have hnum : G + 2 * m + 2 * K + (3 * m ^ 2 + 2 * K * m + 7 * m) < 2 ^ Bc := by
    have h1 : 3 * m ^ 2 + 2 * K * m + 9 * m ≤ 3 * s ^ 2 + 2 * K * s + 10 * s := by
      have h1 : m ^ 2 ≤ s ^ 2 := Nat.pow_le_pow_left hms 2
      have h2 : 2 * K * m ≤ 2 * K * s := Nat.mul_le_mul_left _ hms
      omega
    have h2 := Nat.lt_size_self (G + 2 * K + 3 * s ^ 2 + 2 * K * s + 10 * s)
    have h3 : 2 ^ Bc0 s K G ≤ 2 ^ Bc := Nat.pow_le_pow_right (by norm_num) hBc
    unfold Bc0 at h3
    omega
  refine ⟨hv, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hk⟩
  · rw [bsOf_length, fsOf_length]
  · rw [hcl, fsOf_length]
  · rw [fsOf_length]; exact hG
  · rw [fsOf_length]; exact hK
  · exact fun r hr => fsOf_getElem_length hsort hr
  · intro r hr
    have hr' : r < m := by rw [hcl] at hr; exact hr
    rw [hccr r hr, fsOf_length]
    simp only [ccL, List.length_map, List.length_range]
    omega
  · intro r hr a ha
    rw [fsOf_getElem hr] at ha
    simp only [fsW, List.mem_map, List.mem_range] at ha
    obtain ⟨i, hi, rfl⟩ := ha
    have hrm : r < m := by rw [fsOf_length] at hr; exact hr
    have hc := (fwdSupp_of (mw := lam + w) (c := s - lam - w) hsort hrm).1
    have := fco_abs_le hE (show r - 1 - i < r by omega) hrm
    exact hX _ (hup _ (by linarith))
  · intro r hr a ha
    rw [hccr r hr] at ha
    simp only [ccL, List.mem_map, List.mem_range] at ha
    obtain ⟨i, hi, rfl⟩ := ha
    have := ccOf_abs_le (P := P) (R := R) (t := t) (lam := lam) (w := w) (α := α) h.hs L K r i
    apply hX
    have : (0 : ℝ) < 2 ^ max Bv P := by positivity
    nlinarith
  · exact fun a ha => le_trans (hvb a ha) hXB
  · intro r hr
    rw [fsOf_length] at hr
    rw [hfA r hr]; exact haccF r hr
  · rw [fsOf_length, hfA m le_rfl]
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, haccF m le_rfl, ?_, ?_, ?_⟩
    · rw [bsOf_length]; unfold accF; rw [List.length_reverse, List.length_map, List.length_range]
    · intro j hj
      rw [bsOf_getElem hj]
      simp only [cbOf, List.length_map, List.length_range]
      rw [bsOf_length] at hj
      refine (WbOf_le (L := L) (mw := lam + w) _).trans ?_
      omega
    · intro j hj
      have hj' : j < m := by rw [bsOf_length] at hj; exact hj
      rw [bsOf_getElem hj, hbw j hj'.le, czOf_length _ (bv L v)]
      have e : m - j = m - 1 - j + 1 := by omega
      rw [e]
    · intro j hj
      have hj' : j < m := by rw [bsOf_length] at hj; exact hj
      rw [bsOf_getElem hj]
      exact (aseq_piv_pos hE (by omega) (getD_mem_drop le_rfl (by omega))).le
    · intro j hj
      rw [bsOf_getElem hj]; exact flOf_01 _
    · intro j hj a ha
      have hj' : j < m := by rw [bsOf_length] at hj; exact hj
      rw [bsOf_getElem hj] at ha
      simp only [cbOf, List.mem_map, List.mem_range] at ha
      obtain ⟨i, hi, rfl⟩ := ha
      split_ifs with hc
      · exact hAs _ (by omega) _ (getD_mem_drop le_rfl (by omega)) _
          (getD_mem_drop (by omega) hc.1)
      · exact hX 0 (by simp; positivity)
    · intro j hj a ha
      have hj' : j < m := by rw [bsOf_length] at hj; exact hj
      rw [bsOf_getElem hj] at ha
      simp only [czOf, bIdx, List.mem_map, List.mem_filter, List.mem_range'_1] at ha
      obtain ⟨q, ⟨⟨hq1, hq2⟩, _⟩, rfl⟩ := ha
      split_ifs with hc
      · exact hAs _ (by omega) _ (getD_mem_drop le_rfl (by omega)) _
          (getD_mem_drop (by omega) (by omega))
      · exact hX 0 (by simp; positivity)
    · intro j hj
      have hj' : j < m := by rw [bsOf_length] at hj; exact hj
      rw [bsOf_getElem hj]
      exact (aseq_zsz hE (by omega) (getD_mem_drop le_rfl (by omega))
        (getD_mem_drop le_rfl (by omega))).trans hXP
    · intro j hj a ha
      rw [bsOf_length] at hj
      rw [hbw j hj] at ha
      simp only [accZ, List.mem_map] at ha
      obtain ⟨q, _, rfl⟩ := ha
      exact hzW q
    · intro j hj a ha
      rw [bsOf_length] at hj
      rw [hbw j hj] at ha
      simp only [accB, List.mem_map] at ha
      obtain ⟨q, _, rfl⟩ := ha
      exact hzW q
    · rw [bsOf_length]
      have : m < 2 ^ Bc := by omega
      exact this
  · rw [fsOf_length]; omega

end asm

end J6Seg.JK

end

theorem solution : type_of% @J6Seg.JK.partD_line_sol_aux := @J6Seg.JK.partD_line_sol_aux
