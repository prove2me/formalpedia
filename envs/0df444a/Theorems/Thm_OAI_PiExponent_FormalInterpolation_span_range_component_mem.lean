-- title:
--   Components of an ideal element generated by homogeneous polynomials remain in the ideal
-- statement:
--   If all generators of an ideal are weighted homogeneous of one common degree, every weighted homogeneous component of every element of that ideal is again in the ideal.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.span_range_component_mem
    {d : Nat} (w : Fin d → ℚ) (D : Nat)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (f : MvPolynomial (Fin d) ℂ)
    (hf : f ∈ Ideal.span (Set.range p)) (a : ℚ) :
    MvPolynomial.weightedHomogeneousComponent w a f ∈ Ideal.span (Set.range p) := by sorry
