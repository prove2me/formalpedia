theorem CerednikDrinfeld.FormalODModule.act_pow_mem_span_and_exists_isODHom_comp_eq_act_pow_of_hasKernelOfDegree
    (p : ℕ) [Fact p.Prime] {B : Type} [CommRing B] [IsNoetherianRing B] (hp : IsNilpotent ((p : ℕ) : B))
    (X Y : FormalODModule p B) (ρ : Series B) (hρ : FormalODModule.IsODHom X Y ρ)
    (h : ℕ) (hdeg : FormalODModule.HasKernelOfDegree ρ (p ^ h)) :
    (∀ i : Fin 2, X.act ((p : Zp2 p) ^ h) i ∈ Ideal.span (Set.range ρ)) ∧
    ∃ δ : Series B, FormalODModule.IsODHom Y X δ ∧
      δ.comp ρ = X.act ((p : Zp2 p) ^ h) ∧ ρ.comp δ = Y.act ((p : Zp2 p) ^ h) := by sorry
