theorem length_flatMap_range {α : Type*} (X : ℕ → List α) (R : ℕ) :
    ∀ n, (∀ q < n, (X q).length = R) → ((List.range n).flatMap X).length = n * R
  | 0, _ => by simp
  | n + 1, hX => by
    rw [List.range_succ, List.flatMap_append, List.length_append,
      length_flatMap_range X R n (fun q hq => hX q (by omega))]
    simp [hX n (by omega), Nat.succ_mul]

theorem getD_flatMap_range {α : Type*} (X : ℕ → List α) (R : ℕ) (d : α) :
    ∀ n, (∀ q < n, (X q).length = R) → ∀ q c, q < n → c < R →
      ((List.range n).flatMap X).getD (q * R + c) d = (X q).getD c d
  | 0, _, q, c, hq, _ => by omega
  | n + 1, hX, q, c, hq, hc => by
    have hl := length_flatMap_range X R n (fun q hq => hX q (by omega))
    rw [List.range_succ, List.flatMap_append]
    rcases Nat.lt_or_ge q n with h | h
    · have : q * R + c < n * R := by
        have : (q + 1) * R ≤ n * R := Nat.mul_le_mul_right _ h
        rw [Nat.succ_mul] at this; omega
      rw [List.getD_append _ _ _ _ (by rw [hl]; exact this)]
      exact getD_flatMap_range X R d n (fun q hq => hX q (by omega)) q c h hc
    · have hqn : q = n := by omega
      subst hqn
      rw [List.getD_append_right _ _ _ _ (by rw [hl]; omega), hl]
      simp

