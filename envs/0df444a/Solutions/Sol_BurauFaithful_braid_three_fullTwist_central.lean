/-
`BurauFaithful.braid_three_fullTwist_central`: the square of the Garside element, equivalently
the full twist `(σ₁σ₂)³`, lies in the centre of `B₃` (Birman, *Braids, Links, and Mapping Class
Groups*, Ann. of Math. Studies 82, 1974, Chapter 1 and §3.3, Theorem 3.15, pp. 129--130: the
kernel of the specialization at `t = -1` is generated by `Δ⁴`, a power of this central element).

Proof: with `Δ = σ₁σ₂σ₁`, the braid relation gives `Δ σ₀ = σ₁ Δ` and `Δ σ₁ = σ₀ Δ` by a one-step
rewrite, hence `Δ²` commutes with `σ₀` and `σ₁`; since these generate `B₃`, `Δ²` is central.
Finally `Δ² = (σ₁σ₂)³` is the Garside identity.

Internally the proof works with `B₃` written as the presented group `PresentedGroup (braidRels 3)`
(the definition of `BraidsLinksMCG.ArtinBraidGroup`), which avoids mixing the two definitionally
equal types inside rewrites.
-/
import Definitions.Def_BraidsLinksMCG_ArtinBraidGroup

set_option autoImplicit false

open BraidsLinksMCG

theorem solution :
    (BraidsLinksMCG.sigma (n := 3) ⟨0, by decide⟩ *
        BraidsLinksMCG.sigma (n := 3) ⟨1, by decide⟩) ^ 3 ∈
      Subgroup.center (BraidsLinksMCG.ArtinBraidGroup 3) := by
  set D : PresentedGroup (BraidsLinksMCG.braidRels 3) :=
    PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 with hDdef
  -- the braid relation, as an equation in `B₃`
  have hmem : FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
      (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹ ∈
      Subgroup.normalClosure (BraidsLinksMCG.braidRels 3) :=
    Subgroup.subset_normalClosure (by
      rw [BraidsLinksMCG.braidRels]
      exact Or.inr ⟨0, 1, by decide, rfl⟩)
  have h1 : PresentedGroup.mk (BraidsLinksMCG.braidRels 3)
      (FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
        (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹) = 1 :=
    PresentedGroup.mk_eq_one_iff.mpr hmem
  have h2 : PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
      (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1)⁻¹ = 1 := by
    have hmid : PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
          PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
          PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1)⁻¹ =
        PresentedGroup.mk (BraidsLinksMCG.braidRels 3)
          (FreeGroup.of (0 : Fin 2) * FreeGroup.of 1 * FreeGroup.of 0 *
            (FreeGroup.of 1 * FreeGroup.of 0 * FreeGroup.of 1)⁻¹) := by
      simp only [PresentedGroup.of, map_mul, map_inv]
    exact hmid.trans h1
  have h : PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 :=
    mul_inv_eq_one.mp h2
  -- Garside: `Δ² = (σ₀σ₁)³`
  have hsq : D ^ 2 =
      (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
        PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 3 := by
    rw [hDdef]
    rw [pow_two, pow_three]
    nth_rewrite 2 [h]
    simp only [mul_assoc]
  -- `Δ σ₀ = σ₁ Δ` and `Δ σ₁ = σ₀ Δ`
  have hD0 : D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * D := by
    rw [hDdef]
    nth_rewrite 1 [h]
    group
  have hD1 : D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2) =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * D := by
    rw [hDdef]
    nth_rewrite 2 [h]
    group
  -- hence `Δ²` commutes with both generators
  have hz0 : D ^ 2 * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * D ^ 2 := by
    calc D ^ 2 * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)
        = (D * D) * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) := by
          simp only [pow_two]
      _ = D * (D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2)) := by
          simp only [mul_assoc]
      _ = D * (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * D) := by
          simp only [hD0]
      _ = (D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) * D := by
          simp only [mul_assoc]
      _ = (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * D) * D := by
          simp only [hD1]
      _ = PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * (D * D) := by
          simp only [mul_assoc]
      _ = PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * D ^ 2 := by
          simp only [pow_two]
  have hz1 : D ^ 2 * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2) =
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * D ^ 2 := by
    calc D ^ 2 * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)
        = (D * D) * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2) := by
          simp only [pow_two]
      _ = D * (D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (1 : Fin 2)) := by
          simp only [mul_assoc]
      _ = D * (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0 * D) := by
          simp only [hD1]
      _ = (D * PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 0) * D := by
          simp only [mul_assoc]
      _ = (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * D) * D := by
          simp only [hD0]
      _ = PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * (D * D) := by
          simp only [mul_assoc]
      _ = PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1 * D ^ 2 := by
          simp only [pow_two]
  -- `Δ²` is central: it commutes with the generators, which generate `B₃`
  have hgen : Subgroup.closure (Set.range (PresentedGroup.of :
      Fin 2 → PresentedGroup (BraidsLinksMCG.braidRels 3))) = ⊤ :=
    PresentedGroup.closure_range_of (BraidsLinksMCG.braidRels 3)
  have hle : Subgroup.closure (Set.range (PresentedGroup.of :
      Fin 2 → PresentedGroup (BraidsLinksMCG.braidRels 3))) ≤
      Subgroup.centralizer ({D ^ 2} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))) := by
    rw [Subgroup.closure_le]
    rintro x ⟨i, rfl⟩
    fin_cases i
    · refine Subgroup.mem_centralizer_iff.mpr ?_
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      exact hz0
    · refine Subgroup.mem_centralizer_iff.mpr ?_
      intro b hb
      rw [Set.mem_singleton_iff] at hb
      subst hb
      exact hz1
  have htop : (⊤ : Subgroup (PresentedGroup (BraidsLinksMCG.braidRels 3))) ≤
      Subgroup.centralizer ({D ^ 2} : Set (PresentedGroup (BraidsLinksMCG.braidRels 3))) := by
    rw [← hgen]
    exact hle
  have hz : D ^ 2 ∈ Subgroup.center (PresentedGroup (BraidsLinksMCG.braidRels 3)) := by
    rw [Subgroup.mem_center_iff]
    intro g
    exact (Subgroup.mem_centralizer_iff.mp (htop (Subgroup.mem_top g)) _ (Set.mem_singleton _)).symm
  have hgoal : (PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) (0 : Fin 2) *
      PresentedGroup.of (rels := BraidsLinksMCG.braidRels 3) 1) ^ 3 ∈
      Subgroup.center (PresentedGroup (BraidsLinksMCG.braidRels 3)) := by
    rw [← hsq]
    exact hz
  exact hgoal
