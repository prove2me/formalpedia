    (xs : List ℤ) (hlen : xs.length = AModel.vol (NLogN.KFU.shK d (NLogN.KFU.sP d sF))) :
    NLogN.KFU.PhiInvD h d bL sF μ (NLogN.KFU.PhiD h d bL sF μ xs) = xs := by
  rw [NLogN.KFU.PhiInvD_eq H h bL hst]
