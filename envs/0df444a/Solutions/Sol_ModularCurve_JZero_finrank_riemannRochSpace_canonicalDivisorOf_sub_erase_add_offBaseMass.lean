    {D : Divisor (AlgebraicClosure ℚ) (modularFunctionFieldBar N)} (hD : 0 ≤ D)
    (h : riemannRochSpace (D.erase (cuspInftyBar N) - Finsupp.single (cuspInftyBar N) (1 : ℤ)) = ⊥) :
    (Module.finrank (AlgebraicClosure ℚ)
        ↥(riemannRochSpace (canonicalDivisorOf hω - D.erase (cuspInftyBar N))) : ℤ)
      + offBaseMass N D = genusFF (AlgebraicClosure ℚ) (modularFunctionFieldBar N) := by
  have herase_eff : 0 ≤ D.erase (cuspInftyBar N) := by
    intro w
    by_cases hw : w = cuspInftyBar N
    · subst hw; simp
    · rw [Finsupp.erase_ne hw]; exact hD w
  have hB : Module.finrank (AlgebraicClosure ℚ) ↥(riemannRochSpace (D.erase (cuspInftyBar N))) = 1 :=
    finrank_riemannRochSpace_eq_one_of_sub_single_eq_bot N herase_eff (cuspInftyBar N) h
  have hE := finrank_riemannRochSpace_sub_finrank_canonicalDivisorOf_sub_eq N hω (D.erase (cuspInftyBar N))
  rw [degree_erase_cuspInftyBar, hB] at hE
