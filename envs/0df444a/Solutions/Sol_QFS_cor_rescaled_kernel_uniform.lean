/-- **Corollary 3.6** of Bux–Kassmann–Schulze, for `d ≥ 2`, with the constant
where the paper puts it: `C` depends on `d`, `ϑ`, `α` and `Λ` only, and in
particular neither on the configuration nor on the kernel nor on the scale.
For every `h > 0` the discrete kernel `ω^k_h` satisfies assumption (4) on
`hℤ^d`, for a configuration `Γ^h` whose apex angles are bounded below by a `ϑ'`
independent of `h`. -/
theorem solution {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2) (hd : 2 ≤ d)
    {α : ℝ} (hα : 0 < α) (hα2 : α ≤ 2) :
    ∃ θ' : ℝ, 0 < θ' ∧ θ' ≤ π / 2 ∧
      ∀ Λ : ℝ, 1 ≤ Λ →
      ∃ C : ℝ, 0 < C ∧
      ∀ Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d)), QFS.IsBounded Γ ϑ → QFS.CondMeas Γ →
      ∀ k : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞,
        QFS.KernelBounds Γ α Λ k →
      ∀ h : ℝ, 0 < h →
      ∃ Γ' : QFS.Configuration (EuclideanSpace ℝ (Fin d)),
        (∀ u, (Γ' u).apex = θ') ∧ QFS.IsBounded Γ' θ' ∧
        ∀ x ∈ QFS.scaledLattice d h, ∀ y ∈ QFS.scaledLattice d h, Real.sqrt d * h < ‖x - y‖ →
          ENNReal.ofReal C⁻¹ *
              ((QFS.indE (QFS.coneAt Γ' x) y + QFS.indE (QFS.coneAt Γ' y) x) * QFS.jumpKernel d α x y)
            ≤ QFS.discreteKernel d k h x y ∧
          QFS.discreteKernel d k h x y ≤ ENNReal.ofReal C * QFS.jumpKernel d α x y := by
  classical
  have hd1 : 0 < d := by omega
  have hsd : (0:ℝ) < Real.sqrt d := Real.sqrt_pos.mpr (by exact_mod_cast hd1)
  have hθ0 : (0:ℝ) < ϑ / 3 := by positivity
  have hθle : ϑ / 3 ≤ π / 2 := by linarith [pi_pos]
  obtain ⟨S, hSdef⟩ : ∃ S : Finset (EuclideanSpace ℝ (Fin d)),
      S = (QFS.ref_cones (E := EuclideanSpace ℝ (Fin d)) hϑ hϑ').choose := ⟨_, rfl⟩
  have hSnorm : ∀ v ∈ S, ‖v‖ = 1 := by
    rw [hSdef]; exact (QFS.ref_cones (E := EuclideanSpace ℝ (Fin d)) hϑ hϑ').choose_spec.1
  obtain ⟨e, he⟩ : ∃ e : EuclideanSpace ℝ (Fin d), ‖e‖ = 1 := by
    refine ⟨EuclideanSpace.single (⟨0, hd1⟩ : Fin d) (1:ℝ), ?_⟩
    simp
  have hSne : S.Nonempty := by
    obtain ⟨v, hv, -⟩ :=
      (QFS.ref_cones (E := EuclideanSpace ℝ (Fin d)) hϑ hϑ').choose_spec.2
        (fun _ => ⟨e, he, ϑ, hϑ, hϑ'⟩) ⟨hϑ, fun _ => le_rfl⟩ 0
    exact ⟨v, by rw [hSdef]; exact hv⟩
  obtain ⟨θ', hθ'0, hθ'le, hthin⟩ := QFS.lemma_new_config hd hsd hθ0 hθle S hSnorm
  refine ⟨θ', hθ'0, hθ'le, ?_⟩
  intro Λ hΛ1
  have hΛ0 : (0:ℝ) < Λ := lt_of_lt_of_le zero_lt_one hΛ1
  have hLpos : (0:ℝ) < (S.card : ℝ) := by exact_mod_cast Finset.card_pos.mpr hSne
  obtain ⟨C₀, hC₀def⟩ : ∃ C : ℝ,
      C = (2 * Real.sqrt d) ^ (-(d:ℝ) - α) * ((S.card : ℝ)⁻¹ * (S.card : ℝ)⁻¹) := ⟨_, rfl⟩
  have hC₀0 : (0:ℝ) < C₀ := by rw [hC₀def]; positivity
  refine ⟨max (Λ * (2 * Real.sqrt d) ^ ((d:ℝ) + 2)) (C₀ * Λ⁻¹)⁻¹,
    lt_of_lt_of_le (by positivity) (le_max_left _ _), ?_⟩
  intro Γ hΓ hmeas k hk h hh
  obtain ⟨F, hFdef⟩ : ∃ F : QFS.RefFamily Γ (ϑ / 3), F = QFS.refFamily hϑ hϑ' Γ hΓ := ⟨_, rfl⟩
  have hFaxes : F.axes = S := by rw [hFdef, hSdef]; rfl
  choose fav hfav using (fun u => QFS.exists_isFavoured F h u)
  have haxex : ∀ u : EuclideanSpace ℝ (Fin d), ∃ w : EuclideanSpace ℝ (Fin d), ‖w‖ = 1 ∧
      (u ∈ S → QFS.doubleCone w θ' ∩ QFS.lattice d
        ⊆ QFS.shrink (QFS.doubleCone u (ϑ / 3)) (Real.sqrt d) ∩ QFS.lattice d) := by
    intro u
    by_cases hu : u ∈ S
    · obtain ⟨w, hw, hsub⟩ := hthin u hu
      exact ⟨w, hw, fun _ => hsub⟩
    · exact ⟨e, he, fun hc => absurd hc hu⟩
  choose ax hax haxsub using haxex
  obtain ⟨Γ', hΓ'⟩ : ∃ Γ' : QFS.Configuration (EuclideanSpace ℝ (Fin d)),
      Γ' = fun u => (⟨ax (fav u), hax (fav u), θ', hθ'0, hθ'le⟩ :
        QFS.DCone (EuclideanSpace ℝ (Fin d))) := ⟨_, rfl⟩
  refine ⟨Γ', fun u => by rw [hΓ'], ⟨hθ'0, fun u => by rw [hΓ']⟩, ?_⟩
  intro x hx y hy hxy
  refine ⟨?_, ?_⟩
  swap
  · exact le_trans (QFS.discreteKernel_le' hk hα hα2 hh hx hy hxy)
      (mul_le_mul' (ENNReal.ofReal_le_ofReal (le_max_left _ _)) le_rfl)
  -- the lower bound
  have hind : ∀ u w : EuclideanSpace ℝ (Fin d), u ∈ QFS.scaledLattice d h →
      w ∈ QFS.scaledLattice d h →
      QFS.indE (QFS.coneAt Γ' u) w ≤ QFS.indE (F.shrunkAt (fav u) (h * Real.sqrt d) u) w := by
    intro u w hu hw
    refine QFS.indE_le_indE (fun hmem => ?_)
    rw [hΓ'] at hmem
    refine QFS.thin_cone_subset_scaled ?_ (hax (fav u)) hθ'0 hθ'le hh
      (haxsub (fav u) (by rw [← hFaxes]; exact (hfav u).1))
      ⟨hmem, QFS.sub_mem_scaledLattice hw hu⟩
    exact fun t ht p hp => QFS.smul_mem_doubleCone (F.norm_axes _
      (by rw [hFaxes, ← hFaxes]; exact (hfav u).1)) hθ0 hθle ht hp
  have hvolx := QFS.inv_card_le_volume_cubeCone_scaled F (by rw [hFaxes]; exact hSne) hh (hfav x)
  have hvoly := QFS.inv_card_le_volume_cubeCone_scaled F (by rw [hFaxes]; exact hSne) hh (hfav y)
  refine le_trans ?_ (QFS.discreteKernel_ge_volume_scaled hk hα F hmeas hh hx hy hxy
    (fav x) (fav y))
  have hLinv : ENNReal.ofReal ((S.card : ℝ)⁻¹) = ((F.axes.card : ℝ≥0∞))⁻¹ := by
    rw [hFaxes, ← ENNReal.ofReal_natCast S.card, ← ENNReal.ofReal_inv_of_pos hLpos]
  have hCle : ENNReal.ofReal (max (Λ * (2 * Real.sqrt d) ^ ((d:ℝ) + 2)) (C₀ * Λ⁻¹)⁻¹)⁻¹
      ≤ ENNReal.ofReal (C₀ * Λ⁻¹) := by
    refine ENNReal.ofReal_le_ofReal ?_
    rw [inv_le_comm₀ (by positivity) (by positivity)]
    exact le_max_right _ _
  refine le_trans (mul_le_mul' hCle le_rfl) ?_
  obtain ⟨B, hB⟩ : ∃ B : ℝ≥0∞, B = QFS.indE (QFS.coneAt Γ' x) y + QFS.indE (QFS.coneAt Γ' y) x := ⟨_, rfl⟩
  obtain ⟨B', hB'⟩ : ∃ B' : ℝ≥0∞, B' = QFS.indE (F.shrunkAt (fav x) (h * Real.sqrt d) x) y
      + QFS.indE (F.shrunkAt (fav y) (h * Real.sqrt d) y) x := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : ℝ≥0∞, J = ENNReal.ofReal ((2 * Real.sqrt d) ^ (-(d:ℝ) - α)
      * ‖x - y‖ ^ (-(d:ℝ) - α)) := ⟨_, rfl⟩
  rw [← hB, ← hB', ← hJ]
  have hcancel := QFS.ofReal_inv_pow_mul (d := d) hh
  have hJeq : ENNReal.ofReal (C₀ * Λ⁻¹) * (B * QFS.jumpKernel d α x y)
      = ENNReal.ofReal Λ⁻¹ * (B * J)
        * (ENNReal.ofReal ((S.card : ℝ)⁻¹) * ENNReal.ofReal ((S.card : ℝ)⁻¹)) := by
    rw [hJ, hC₀def, QFS.jumpKernel,
      ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ (2 * Real.sqrt d) ^ (-(d:ℝ) - α)),
      ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ (2 * Real.sqrt d) ^ (-(d:ℝ) - α) *
        ((S.card : ℝ)⁻¹ * (S.card : ℝ)⁻¹)),
      ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ (2 * Real.sqrt d) ^ (-(d:ℝ) - α)),
      ENNReal.ofReal_mul (by positivity : (0:ℝ) ≤ ((S.card : ℝ))⁻¹)]
    ring
  calc ENNReal.ofReal (C₀ * Λ⁻¹) * (B * QFS.jumpKernel d α x y)
      = ENNReal.ofReal Λ⁻¹ * (B * J)
          * (ENNReal.ofReal ((S.card : ℝ)⁻¹) * ENNReal.ofReal ((S.card : ℝ)⁻¹)) := hJeq
    _ = (ENNReal.ofReal ((h ^ (2 * d))⁻¹) *
          (ENNReal.ofReal (h ^ d) * ENNReal.ofReal (h ^ d))) *
        (ENNReal.ofReal Λ⁻¹ * (B * J)
          * (((F.axes.card : ℝ≥0∞))⁻¹ * ((F.axes.card : ℝ≥0∞))⁻¹)) := by
        rw [hcancel, one_mul, hLinv]
    _ = ENNReal.ofReal ((h ^ (2 * d))⁻¹) * (ENNReal.ofReal Λ⁻¹ * (B * J)
          * ((ENNReal.ofReal (h ^ d) * ((F.axes.card : ℝ≥0∞))⁻¹)
            * (ENNReal.ofReal (h ^ d) * ((F.axes.card : ℝ≥0∞))⁻¹))) := by ring
    _ ≤ ENNReal.ofReal ((h ^ (2 * d))⁻¹) * (ENNReal.ofReal Λ⁻¹ * (B' * J)
          * (volume (QFS.cubeCone Γ (F.cone (fav x)) h x)
            * volume (QFS.cubeCone Γ (F.cone (fav y)) h y))) := by
        refine mul_le_mul' le_rfl (mul_le_mul' (mul_le_mul' le_rfl (mul_le_mul' ?_ le_rfl))
