/-- The literature constant of a log-concave law is at most the operator norm of its covariance
times its affine covariance Poincaré constant. -/
theorem solution {μ : ProbabilityMeasure E}
    (hμ : FunctionalInequalities.KLS.LogConcave μ) {K : NNReal} (hK : FunctionalInequalities.Poincare.CovarianceGradient.Intrinsic.constant μ ≤ (K : ENNReal)) :
    FunctionalInequalities.Poincare.LocalSlope.Intrinsic.constant μ ≤ (K : ENNReal) * ENNReal.ofReal ‖FunctionalInequalities.Covariance.operator (μ : Measure E)‖ := by
  have hν : FunctionalInequalities.KLS.LogConcave (FunctionalInequalities.Probability.intrinsicMeasure μ) := hμ.intrinsicMeasure
  have hi : (interior (FunctionalInequalities.Probability.intrinsicMeasure μ : Measure (FunctionalInequalities.Probability.affineSupport μ).direction).support).Nonempty :=
    hμ.interior_intrinsic_support_nonempty
  have hac : (FunctionalInequalities.Probability.intrinsicMeasure μ : Measure (FunctionalInequalities.Probability.affineSupport μ).direction) ≪
      (Measure.addHaar : Measure (FunctionalInequalities.Probability.affineSupport μ).direction) :=
    hν.absolutelyContinuous_haar Measure.addHaar hi
  have hfr : (FunctionalInequalities.Probability.intrinsicMeasure μ : Measure (FunctionalInequalities.Probability.affineSupport μ).direction)
      (frontier (FunctionalInequalities.Probability.intrinsicMeasure μ : Measure (FunctionalInequalities.Probability.affineSupport μ).direction).support) = 0 :=
    hν.frontier_support_eq_zero hi
  have hlit : FunctionalInequalities.Poincare.LocalSlope.Intrinsic.constant μ =
      FunctionalInequalities.Poincare.L2Energy.constant (FunctionalInequalities.Probability.intrinsicMeasure μ)
        (FunctionalInequalities.Energy.LipschitzGradient.relaxation (FunctionalInequalities.Probability.intrinsicMeasure μ) Measure.addHaar hac) := by
    rw [← hμ.smoothTest_constant_eq_intrinsic_and_localSlope.2,
      FunctionalInequalities.Poincare.SmoothTest.constant_eq_lipschitz_408915f _ Measure.addHaar hac hfr]
  have hholds : FunctionalInequalities.Poincare.L2Energy.Holds (FunctionalInequalities.Probability.intrinsicMeasure μ)
      (FunctionalInequalities.Energy.CovarianceGradient.relaxation (FunctionalInequalities.Probability.intrinsicMeasure μ)) K := by
    have h : FunctionalInequalities.Poincare.CovarianceGradient.Intrinsic.Holds μ K := (FunctionalInequalities.Poincare.CovarianceGradient.Intrinsic.holds_iff_constant_le μ K).mpr hK
    rw [FunctionalInequalities.Poincare.CovarianceGradient.Intrinsic.Holds, FunctionalInequalities.Energy.CovarianceGradient.Intrinsic.energy_eq_relaxation_intrinsicMeasure] at h
    exact h
  have hcmp : ∀ f : (FunctionalInequalities.Energy.LipschitzGradient.relaxation (FunctionalInequalities.Probability.intrinsicMeasure μ)
      Measure.addHaar hac).domain,
      FunctionalInequalities.Energy.CovarianceGradient.relaxation (FunctionalInequalities.Probability.intrinsicMeasure μ) f.1 ≤
        (‖FunctionalInequalities.Covariance.operator (FunctionalInequalities.Probability.intrinsicMeasure μ : Measure (FunctionalInequalities.Probability.affineSupport μ).direction)‖₊ : ENNReal) *
          FunctionalInequalities.Energy.LipschitzGradient.relaxation (FunctionalInequalities.Probability.intrinsicMeasure μ) Measure.addHaar hac f.1 :=
    fun f ↦ FunctionalInequalities.Energy.CovarianceGradient.relaxation_le_mul_lipschitz_408915f
      (FunctionalInequalities.Probability.intrinsicMeasure μ) Measure.addHaar hac hfr f.1
      ((FunctionalInequalities.Energy.Functional.mem_domain _ _).mp f.2)
  have hle := FunctionalInequalities.Poincare.L2Energy.constant_le_mul_of_energy_le_mul hholds hcmp
