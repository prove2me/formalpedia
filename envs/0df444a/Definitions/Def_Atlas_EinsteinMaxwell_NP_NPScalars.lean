/-! ### NP spin coefficients (standard NP definitions, Atlas signature) -/

section spin

variable (g gi : Metric 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (x : Pt 4)

/-- `κ = g_H(m, ∇_l l) = g(l, ∇_l m)`. -/
noncomputable def npKappa : ℂ := omL g gi E Θ 0 0 2 x
/-- `σ = g_H(m, ∇_m l) = g(l, ∇_m m)`. -/
noncomputable def npSigma : ℂ := omL g gi E Θ 0 2 2 x
/-- `ρ = g_H(m, ∇_m̄ l) = g(l, ∇_m̄ m)`. -/
noncomputable def npRho : ℂ := omL g gi E Θ 0 3 2 x
/-- `τ = g_H(m, ∇_n l) = g(l, ∇_n m)`. -/
noncomputable def npTau : ℂ := omL g gi E Θ 0 1 2 x
/-- `ν = −g_H(m̄, ∇_n n) = −g(n, ∇_n m̄)`. -/
noncomputable def npNu : ℂ := -omL g gi E Θ 1 1 3 x
/-- `λ = −g_H(m̄, ∇_m̄ n) = −g(n, ∇_m̄ m̄)`. -/
noncomputable def npLambda : ℂ := -omL g gi E Θ 1 3 3 x
/-- `μ = −g_H(m̄, ∇_m n) = −g(n, ∇_m m̄)`. -/
noncomputable def npMu : ℂ := -omL g gi E Θ 1 2 3 x
/-- `π = −g_H(m̄, ∇_l n) = −g(n, ∇_l m̄)`. -/
noncomputable def npPi : ℂ := -omL g gi E Θ 1 0 3 x
/-- `ε = ½(g_H(n, ∇_l l) − g_H(m̄, ∇_l m))`. -/
noncomputable def npEps : ℂ := (-omL g gi E Θ 1 0 0 x + omL g gi E Θ 3 0 2 x) / 2
/-- `β = ½(g_H(n, ∇_m l) − g_H(m̄, ∇_m m))`. -/
noncomputable def npBeta : ℂ := (-omL g gi E Θ 1 2 0 x + omL g gi E Θ 3 2 2 x) / 2
/-- `γ = ½(g_H(n, ∇_n l) − g_H(m̄, ∇_n m))`. -/
noncomputable def npGamma : ℂ := (-omL g gi E Θ 1 1 0 x + omL g gi E Θ 3 1 2 x) / 2
/-- `α = ½(g_H(n, ∇_m̄ l) − g_H(m̄, ∇_m̄ m))`. -/
noncomputable def npAlpha : ℂ := (-omL g gi E Θ 1 3 0 x + omL g gi E Θ 3 3 2 x) / 2

end spin

/-! ### Weyl and Maxwell scalars (Hintz's definitions) -/

section scalars

variable (g gi : Metric 4) (E : Fin 4 → Fin 4 → Pt 4 → ℂ) (x : Pt 4)

/-- Hintz's Weyl contraction `C^H(e_i,e_j,e_k,e_l)` with `C^H = weyl (−g) (−gi)`. -/
noncomputable def weylH (I J A B : Fin 4) : ℂ :=
  ccontr4 (weyl (negMetric g) (negMetric gi)) x (fvec E I x) (fvec E J x) (fvec E A x) (fvec E B x)

/-- `Ψ₀ = −C₁₃₁₃`. -/ noncomputable def psi0 : ℂ := -weylH g gi E x 0 2 0 2
/-- `Ψ₁ = −C₁₂₁₃`. -/ noncomputable def psi1 : ℂ := -weylH g gi E x 0 1 0 2
/-- `Ψ₂ = −C₁₃₄₂`. -/ noncomputable def psi2 : ℂ := -weylH g gi E x 0 2 3 1
/-- `Ψ₃ = −C₁₂₄₂`. -/ noncomputable def psi3 : ℂ := -weylH g gi E x 0 1 3 1
/-- `Ψ₄ = −C₂₄₂₄`. -/ noncomputable def psi4 : ℂ := -weylH g gi E x 1 3 1 3

/-- `Φ₀ = F₁₃`. -/ noncomputable def phi0 (F : TwoForm 4) : ℂ := FfrF F E 0 2 x
/-- `Φ₁ = ½(F₁₂ + F₄₃)`. -/ noncomputable def phi1 (F : TwoForm 4) : ℂ := (FfrF F E 0 1 x + FfrF F E 3 2 x) / 2
/-- `Φ₂ = F₄₂`. -/ noncomputable def phi2 (F : TwoForm 4) : ℂ := FfrF F E 3 1 x

end scalars

/-! ### Frame relabelings: `m ↔ m̄` and the GHP prime `l ↔ n, m ↔ m̄` -/

/-- GHP prime on frame indices: `0 ↔ 1`, `2 ↔ 3`. -/
def prime23 : Fin 4 → Fin 4 := ![1, 0, 3, 2]

/-- Relabelled frame family `(E ∘ σ)`. -/
def relabel (σ : Fin 4 → Fin 4) (E : Fin 4 → Fin 4 → Pt 4 → ℂ) : Fin 4 → Fin 4 → Pt 4 → ℂ := fun A => E (σ A)

section relabel

variable {σ : Fin 4 → Fin 4}

end relabel

/-! ### The GHP prime dictionary -/

section prime

variable (g gi : Metric 4) (E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ) (x : Pt 4)

local notation "E'" => relabel prime23 E
local notation "Θ'" => relabel prime23 Θ

end prime

end ExactVacuumAtlas.EinsteinMaxwell.NP


