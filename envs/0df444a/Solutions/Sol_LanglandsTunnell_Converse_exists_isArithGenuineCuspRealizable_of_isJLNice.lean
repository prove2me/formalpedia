  obtain ⟨N, hN, E, ξ, φ, hne, hsc, hlev, hH, hC, hcont⟩ :=
    exists_realization_data K c u d₁ d₂ T hc hd₁ Pi S archR archC epsS ω hω hωunr hωb hωR hωC d dR dC dF
      hnvR hnvC hnvF hnice hnonEis _ rfl
  refine ⟨N, hN, ?_⟩
  unfold IsArithGenuineCuspRealizable IsGenuineCuspRealizable IsGenuineCuspRealizationAt
  exact ⟨
    { toFun := φ
      exists_ne_zero := hne
      centralChar := ξ
      smoothCusp := hsc
