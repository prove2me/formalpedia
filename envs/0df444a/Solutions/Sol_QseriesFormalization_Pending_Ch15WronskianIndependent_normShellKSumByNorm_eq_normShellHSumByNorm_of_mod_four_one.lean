  have hKprod :
      (∑ z ∈ (normShellBox N).product (normShellBox N),
        if z.1 ^ 2 + z.2 ^ 2 = 4 * (N : ℤ) + 1 then
          ((gaussK z : ℤ) : ℚ)
        else 0) =
        ∑ A ∈ normShellBox N, ∑ B ∈ normShellBox N,
          if A ^ 2 + B ^ 2 = 4 * (N : ℤ) + 1 then
            ((gaussK (A,B) : ℤ) : ℚ)
          else 0 := by
    exact Finset.sum_product (normShellBox N) (normShellBox N)
      (fun z : ℤ × ℤ =>
        if z.1 ^ 2 + z.2 ^ 2 = 4 * (N : ℤ) + 1 then
          ((gaussK z : ℤ) : ℚ)
        else 0)
  have hHprod :
      (∑ z ∈ (normShellBox N).product (normShellBox N),
        if z.1 ^ 2 + z.2 ^ 2 = 4 * (N : ℤ) + 1 then
          ((gaussH z : ℤ) : ℚ)
        else 0) =
        ∑ A ∈ normShellBox N, ∑ B ∈ normShellBox N,
          if A ^ 2 + B ^ 2 = 4 * (N : ℤ) + 1 then
            ((gaussH (A,B) : ℤ) : ℚ)
          else 0 := by
    exact Finset.sum_product (normShellBox N) (normShellBox N)
