theorem maximalIdeal_eq_span_of_ringEquiv {R S : Type*} [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
    (e : R ≃+* S) (ϖ : R) (h : maximalIdeal R = Ideal.span {ϖ}) : maximalIdeal S = Ideal.span {e ϖ} := by
  apply le_antisymm
  · intro x hx
    have hx' : e.symm x ∈ maximalIdeal R := by
      rw [mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu; apply hx
      have := hu.map e
      simpa using this
    rw [h, Ideal.mem_span_singleton'] at hx'
    obtain ⟨r, hr⟩ := hx'
    refine Ideal.mem_span_singleton'.mpr ⟨e r, ?_⟩
    rw [← map_mul, hr, RingEquiv.apply_symm_apply]
  · rw [Ideal.span_singleton_le_iff_mem, mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hϖ : ϖ ∈ maximalIdeal R := by rw [h]; exact Ideal.subset_span rfl
    apply (mem_maximalIdeal _).mp hϖ
    have := hu.map e.symm
    simpa using this

theorem valuationSubring_eq_top_of_isAlgebraic_of_finite (k K : Type*) [Field k] [Finite k] [Field K]
    [Algebra k K] [Algebra.IsAlgebraic k K] (O : ValuationSubring K) : O = ⊤ := by
  haveI : Module.Finite ℤ k := Module.Finite.of_finite
  haveI : Algebra.IsIntegral ℤ k := Algebra.IsIntegral.of_finite ℤ k
  haveI : Algebra.IsIntegral k K := Algebra.IsAlgebraic.isIntegral
  haveI : Algebra.IsIntegral ℤ K := Algebra.IsIntegral.trans k
  ext x
  refine ⟨fun _ => ValuationSubring.mem_top x, fun _ => ?_⟩
  have hx : IsIntegral ℤ x := Algebra.IsIntegral.isIntegral x
  have hx' : IsIntegral ↥O x := hx.tower_top
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥O) (K := K)).mp hx'
  rw [← hy]
  exact y.2

theorem isUnit_iff_ne_zero_and_inv_mem {K : Type*} [Field K] (A : ValuationSubring K) (x : K) (hx : x ∈ A) :
    IsUnit (⟨x, hx⟩ : ↥A) ↔ x ≠ 0 ∧ x⁻¹ ∈ A := by
  constructor
  · rintro ⟨u, hu⟩
    have h1 : ((u⁻¹ : (↥A)ˣ) : ↥A) * (⟨x, hx⟩ : ↥A) = 1 := by rw [← hu, Units.inv_mul]
    have h1' : (((u⁻¹ : (↥A)ˣ) : ↥A) : K) * x = 1 := by
      have := congrArg Subtype.val h1
      simpa using this
    have hx0 : x ≠ 0 := by
      intro h0; rw [h0, mul_zero] at h1'; exact zero_ne_one h1'
    refine ⟨hx0, ?_⟩
    have heq : (((u⁻¹ : (↥A)ˣ) : ↥A) : K) = x⁻¹ := eq_inv_of_mul_eq_one_left h1'
    rw [← heq]
    exact ((u⁻¹ : (↥A)ˣ) : ↥A).2
  · rintro ⟨hx0, hinv⟩
    refine isUnit_iff_exists_inv.mpr ⟨⟨x⁻¹, hinv⟩, ?_⟩
    apply Subtype.ext
    show x * x⁻¹ = 1
    exact mul_inv_cancel₀ hx0

theorem coe_mem_of_mem_maximalIdeal_of_le {F : Type*} [Field F] (W V : ValuationSubring F)
    (hV : ∀ f : F, f ∈ V → f ∈ W) (w : ↥W) (hw : w ∈ IsLocalRing.maximalIdeal ↥W) : (w : F) ∈ V := by
  by_contra hwV
  have hinv : (w : F)⁻¹ ∈ V := (V.mem_or_inv_mem _).resolve_left hwV
  have hw0 : (w : F) ≠ 0 := by
    intro h0; apply hwV; rw [h0]; exact V.zero_mem
  have hu : IsUnit (⟨(w : F), w.2⟩ : ↥W) :=
    (isUnit_iff_ne_zero_and_inv_mem W (w : F) w.2).mpr ⟨hw0, hV _ hinv⟩
  have hu' : IsUnit w := by simpa using hu
  exact (IsLocalRing.mem_maximalIdeal _).mp hw hu'

theorem exists_valuationSubring_apply_mem_iff {F E : Type*} [Field F] [Field E]
    (W : ValuationSubring F) (θ : ↥W →+* E) (hθ : Function.Surjective θ)
    (hker : ∀ w : ↥W, θ w = 0 → w ∈ IsLocalRing.maximalIdeal ↥W)
    (V : ValuationSubring F) (hV : ∀ f : F, f ∈ V → f ∈ W) :
    ∃ O : ValuationSubring E, ∀ w : ↥W, θ w ∈ O ↔ (w : F) ∈ V := by
  classical
  refine ⟨{ carrier := {z | ∃ w : ↥W, (w : F) ∈ V ∧ θ w = z}
            mul_mem' := ?_, one_mem' := ?_, add_mem' := ?_, zero_mem' := ?_, neg_mem' := ?_,
            mem_or_inv_mem' := ?_ }, ?_⟩
  · rintro a b ⟨w₁, h₁, rfl⟩ ⟨w₂, h₂, rfl⟩
    exact ⟨w₁ * w₂, by rw [MulMemClass.coe_mul]; exact V.mul_mem _ _ h₁ h₂, map_mul θ _ _⟩
  · exact ⟨1, by rw [OneMemClass.coe_one]; exact V.one_mem, map_one θ⟩
  · rintro a b ⟨w₁, h₁, rfl⟩ ⟨w₂, h₂, rfl⟩
    exact ⟨w₁ + w₂, by rw [AddMemClass.coe_add]; exact V.add_mem _ _ h₁ h₂, map_add θ _ _⟩
  · exact ⟨0, by rw [ZeroMemClass.coe_zero]; exact V.zero_mem, map_zero θ⟩
  · rintro a ⟨w, h, rfl⟩
    exact ⟨-w, by rw [NegMemClass.coe_neg]; exact V.neg_mem _ h, map_neg θ _⟩
  · intro z
    obtain ⟨w, rfl⟩ := hθ z
    by_cases hw : (w : F) ∈ V
    · exact Or.inl ⟨w, hw, rfl⟩
    · right
      have hinvV : (w : F)⁻¹ ∈ V := (V.mem_or_inv_mem _).resolve_left hw
      have hw0 : (w : F) ≠ 0 := by
        intro h0; apply hw; rw [h0]; exact V.zero_mem
      let w' : ↥W := ⟨(w : F)⁻¹, hV _ hinvV⟩
      have hww' : w * w' = 1 := Subtype.ext (mul_inv_cancel₀ hw0)
      have hθ1 : θ w * θ w' = 1 := by rw [← map_mul, hww', map_one]
      exact ⟨w', hinvV, eq_inv_of_mul_eq_one_right hθ1⟩
  · intro w
    constructor
    · rintro ⟨v, hv, hvw⟩
      have h0 : θ (w - v) = 0 := by rw [map_sub, hvw, sub_self]
      have hm : ((w - v : ↥W) : F) ∈ V := coe_mem_of_mem_maximalIdeal_of_le W V hV _ (hker _ h0)
      have heq : (w : F) = ((w - v : ↥W) : F) + (v : F) := by
        rw [AddSubgroupClass.coe_sub]; ring
      rw [heq]
      exact V.add_mem _ _ hm hv
    · intro h
      exact ⟨w, h, rfl⟩

theorem isDiscreteValuationRing_of_ringEquiv {R S : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [CommRing S] [IsDomain S] [IsLocalRing S] (e : R ≃+* S) : IsDiscreteValuationRing S := by
  haveI : IsPrincipalIdealRing S := IsPrincipalIdealRing.of_surjective e.toRingHom e.surjective
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hmax := maximalIdeal_eq_span_of_ringEquiv e ϖ ((IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ)
  refine IsDiscreteValuationRing.mk ?_
  rw [hmax, Ne, Ideal.span_singleton_eq_bot]
  intro h0
  exact hϖ.ne_zero (by simpa using congrArg e.symm h0)

theorem henselianLocalRing_of_ringEquiv {R S : Type*} [CommRing R] [HenselianLocalRing R] [CommRing S] [IsLocalRing S]
    (e : R ≃+* S) : HenselianLocalRing S where
  is_henselian := by
    intro f hf a₀ ha₀ hder
    have nonunit_symm : ∀ x : S, x ∈ maximalIdeal S → e.symm x ∈ maximalIdeal R := fun x hx => by
      rw [mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
      intro hu; apply hx; simpa using hu.map e
    have hf' : (f.map e.symm.toRingHom).Monic := hf.map _
    have h1 : Polynomial.eval (e.symm a₀) (f.map e.symm.toRingHom) ∈ maximalIdeal R := by
      rw [Polynomial.eval_map, show e.symm a₀ = e.symm.toRingHom a₀ from rfl, Polynomial.eval₂_at_apply]
      exact nonunit_symm _ ha₀
    have h2 : IsUnit (Polynomial.eval (e.symm a₀) (Polynomial.derivative (f.map e.symm.toRingHom))) := by
      rw [Polynomial.derivative_map, Polynomial.eval_map, show e.symm a₀ = e.symm.toRingHom a₀ from rfl,
        Polynomial.eval₂_at_apply]
      exact hder.map e.symm.toRingHom
    obtain ⟨a, ha, hclose⟩ := HenselianLocalRing.is_henselian _ hf' _ h1 h2
    refine ⟨e a, ?_, ?_⟩
    · have := ha.map (f := e.toRingHom)
      rwa [Polynomial.map_map, show e.toRingHom.comp e.symm.toRingHom = RingHom.id S from by ext x; simp,
        Polynomial.map_id] at this
    · have : e a - a₀ = e (a - e.symm a₀) := by simp
      rw [this, mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply (mem_maximalIdeal _).mp hclose
      simpa using hu.map e.symm

theorem transcendental_of_not_mem_range {K E : Type*} [Field K] [IsAlgClosed K] [Field E] [Algebra K E]
    (t : E) (ht : t ∉ Set.range (algebraMap K E)) : Transcendental K t := by
  intro halg
  apply ht
  haveI : Algebra.IsIntegral K ↥(IntermediateField.adjoin K ({t} : Set E)) :=
    (IntermediateField.isAlgebraic_adjoin_simple halg.isIntegral).isIntegral
  obtain ⟨r, hr⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
    (K := ↥(IntermediateField.adjoin K ({t} : Set E)))).2 ⟨t, IntermediateField.mem_adjoin_simple_self K t⟩
  refine ⟨r, ?_⟩
  have := congrArg (fun z : ↥(IntermediateField.adjoin K ({t} : Set E)) => (z : E)) hr
  simpa using this

theorem Place.ord_nonneg_of_mem {K F : Type*} [Field K] [Field F] [Algebra K F] (v : AlgebraicCurve.Place K F)
    {f : F} (hf : f ∈ v.toValuationSubring) : 0 ≤ v.ord f := by
  rcases eq_or_ne f 0 with rfl | hf0
  · simp
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨n, u, hu⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
      (x := (⟨f, hf⟩ : v.toValuationSubring)) (by simpa [Subtype.ext_iff] using hf0) hπ
  have hcoe : f = ((u : v.toValuationSubring) : F) * ((π : F) ^ (n : ℤ)) := by
    have h := congrArg (Subtype.val) hu
    push_cast at h
    rw [zpow_natCast]
    exact h
  rw [hcoe, v.ord_unit_smul_zpow u hπ (n : ℤ)]
  exact Int.natCast_nonneg n

theorem Place.mem_of_ord_nonneg {K F : Type*} [Field K] [Field F] [Algebra K F] (v : AlgebraicCurve.Place K F)
    {f : F} (hf : f ≠ 0) (h : 0 ≤ v.ord f) :
    f ∈ v.toValuationSubring := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨u, hu⟩ := v.exists_unit_mul_zpow hf hπ
  rw [hu, show v.ord f = (((v.ord f).toNat : ℕ) : ℤ) from (Int.toNat_of_nonneg h).symm,
    zpow_natCast]
  exact mul_mem (u : v.toValuationSubring).2 (pow_mem (π : v.toValuationSubring).2 _)

theorem inv_mem_of_isUnit {L : Type*} [Field L] (O : ValuationSubring L) (x : O) (hx : IsUnit x) :
    (x : L)⁻¹ ∈ O := by
  obtain ⟨u, hu⟩ := hx
  have h1 : (((u⁻¹ : (↥O)ˣ) : O) : L) * (x : L) = 1 := by
    rw [← hu, ← Subring.coe_mul O.toSubring, Units.inv_mul]; rfl
  have h2 : (((u⁻¹ : (↥O)ˣ) : O) : L) = (x : L)⁻¹ := eq_inv_of_mul_eq_one_left h1
  rw [← h2]; exact ((u⁻¹ : (↥O)ˣ) : O).2

theorem isUnit_of_inv_mem {L : Type*} [Field L] (O : ValuationSubring L) (x : O) (hx : (x : L) ≠ 0)
    (h : (x : L)⁻¹ ∈ O) : IsUnit x :=
  isUnit_iff_exists_inv.mpr ⟨⟨_, h⟩, Subtype.ext (mul_inv_cancel₀ hx)⟩

theorem exists_valuationSubring_forall_mem_iff {K L : Type*} [Field K] [Field L] (f : K →+* L)
    (V : ValuationSubring K) : ∃ W : ValuationSubring L, ∀ x : K, f x ∈ W ↔ x ∈ V := by
  obtain ⟨W, hW⟩ := (LocalSubring.map f V.toLocalSubring).exists_le_valuationSubring
  obtain ⟨hle, hloc⟩ := LocalSubring.le_def.mp hW
  have hsub : ∀ x : K, x ∈ V → f x ∈ W := fun x hx => hle ⟨x, hx, rfl⟩
  refine ⟨W, fun x => ⟨fun hx => ?_, hsub x⟩⟩
  by_contra hxV
  have hx0 : x ≠ 0 := by rintro rfl; exact hxV V.zero_mem
  have hinv : x⁻¹ ∈ V := (V.mem_or_inv_mem x).resolve_left hxV
  have hy : f x⁻¹ ∈ (LocalSubring.map f V.toLocalSubring).toSubring := ⟨x⁻¹, hinv, rfl⟩

  have hunitW : IsUnit (Subring.inclusion hle ⟨f x⁻¹, hy⟩) := by
    apply isUnit_of_inv_mem W _ (show f x⁻¹ ≠ 0 from (map_ne_zero f).mpr (inv_ne_zero hx0))
    show (f x⁻¹)⁻¹ ∈ W
    rw [map_inv₀, inv_inv]; exact hx
  have hunit : IsUnit (⟨f x⁻¹, hy⟩ : ↥(LocalSubring.map f V.toLocalSubring).toSubring) :=
    IsLocalHom.map_nonunit _ hunitW

  obtain ⟨u, hu⟩ := hunit
  have h1 : (((u⁻¹ : (↥(LocalSubring.map f V.toLocalSubring).toSubring)ˣ) :
      ↥(LocalSubring.map f V.toLocalSubring).toSubring) : L) * f x⁻¹ = 1 := by
    have := congrArg (fun z : ↥(LocalSubring.map f V.toLocalSubring).toSubring => (z : L)) (Units.inv_mul u)
    simp only [Subring.coe_mul, hu, Subring.coe_one] at this
    exact this
  have h2 : (((u⁻¹ : (↥(LocalSubring.map f V.toLocalSubring).toSubring)ˣ) :
      ↥(LocalSubring.map f V.toLocalSubring).toSubring) : L) = f x := by
    rw [map_inv₀] at h1
    have := eq_inv_of_mul_eq_one_left h1
    rw [inv_inv] at this; exact this
  have hmem : f x ∈ (LocalSubring.map f V.toLocalSubring).toSubring := by
    rw [← h2]
    exact ((u⁻¹ : (↥(LocalSubring.map f V.toLocalSubring).toSubring)ˣ) :
      ↥(LocalSubring.map f V.toLocalSubring).toSubring).2
  obtain ⟨z, hz, hzx⟩ := hmem
  have : z = x := f.injective hzx
  exact hxV (this ▸ hz)

theorem apply_mem_of_isAlgebraic {k K L : Type*} [Field k] [Field K] [Field L]
    [Algebra k K] [Algebra.IsAlgebraic k K] (φ : K →+* L)
    (W : ValuationSubring L) (hk : ∀ c : k, φ (algebraMap k K c) ∈ W) (x : K) : φ x ∈ W := by
  letI : Algebra K L := φ.toAlgebra
  letI : Algebra k L := (φ.comp (algebraMap k K)).toAlgebra
  haveI : IsScalarTower k K L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI : Algebra k ↥W := ((algebraMap k L).codRestrict W hk).toAlgebra
  haveI : IsScalarTower k ↥W L := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hint : IsIntegral k (algebraMap K L x) := ((Algebra.IsAlgebraic.isAlgebraic x).isIntegral).algebraMap
  have hint' : IsIntegral ↥W (algebraMap K L x) := hint.tower_top
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥W) (K := L)).mp hint'
  show algebraMap K L x ∈ W
  rw [← hy]; exact y.2

end SSC

set_option synthInstance.maxHeartbeats 1600000 in
set_option maxHeartbeats 0 in
theorem solution
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (π : AlgebraicClosure ℚ) (hπ : π ^ (q ^ 2 - 1) = (q : AlgebraicClosure ℚ)) (hπP : π ∈ A)
    (ζ : Idx q)
    (OIg : CuspidalType.ProjLine q → ValuationSubring (fieldBar q M'))
    (OSS : ↥W → ValuationSubring (fieldBar q M'))

    (hIg_inf : ∀ f : fieldBar q M', f ∈ OIg (lineInfty q) ↔
      ∃ x y : LaurentSeries A, coeffMap (IsLocalRing.residue A) y ≠ 0 ∧
        (f : LaurentSeries (AlgebraicClosure ℚ)) * coeffMap A.subtype y = coeffMap A.subtype x)
    (hIg : ∀ ℓ, ∃ γ : SL(2, ℤ), γ ∈ Gamma0 M' ∧ redQ q γ • lineInfty q = ℓ ∧
      OIg ℓ = (OIg (lineInfty q)).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom)
    (hIg_inj : Function.Injective OIg)
    (hIg_perm : ∀ (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      ∃ σ : Equiv.Perm (CuspidalType.ProjLine q),
        ∀ ℓ, (OIg ℓ).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OIg (σ ℓ))

    (hSS_A : ∀ s (x : AlgebraicClosure ℚ), algebraMap (AlgebraicClosure ℚ) (fieldBar q M') x ∈ OSS s ↔ x ∈ A)
    (hSS_over : ∀ (s : ↥W) (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
        (IntermediateField.inclusion hle f : fieldBar q M') ∈ OSS s ∧
        ∀ a : A, residue A a =
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
          ∃ h : (IntermediateField.inclusion hle f : fieldBar q M')
              - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s,
            (⟨_, h⟩ : OSS s) ∈ maximalIdeal (OSS s))
    (hSS_fix : ∀ (s : ↥W) (ζ' : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      (OSS s).comap (levelAutBar q M' ζ' γ).toAlgHom.toRingHom = OSS s)

    (hSS_tr : ∀ s : ↥W, ∃ t : fieldBar q M', t ∈ OSS s ∧ ∀ a : A,
      ∃ h : t - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s, IsUnit (⟨_, h⟩ : OSS s))

    (K₀ : Subfield (AlgebraicClosure ℚ)) [Algebra.IsAlgebraic ↥K₀ (AlgebraicClosure ℚ)] (hπK₀ : π ∈ K₀)
    (A₀ : Type) [CommRing A₀] [IsDomain A₀] [IsDiscreteValuationRing A₀] [HenselianLocalRing A₀]
    (ι : A₀ →+* ↥A) [IsLocalHom ι] (hι : Function.Injective ι)
    (hιK₀ : Set.range (fun a : A₀ => ((ι a : ↥A) : AlgebraicClosure ℚ)) =
      (A : Set (AlgebraicClosure ℚ)) ∩ (K₀ : Set (AlgebraicClosure ℚ)))
    (hres : Function.Surjective ((IsLocalRing.residue ↥A).comp ι))
    (ϖ₀ : A₀) (hϖ₀ : maximalIdeal A₀ = Ideal.span {ϖ₀})

    (hϖ₀π : ((ι ϖ₀ : ↥A) : AlgebraicClosure ℚ) = π)

    (F₀ : Subfield ↥(fieldBar q M'))
    (hF₀ : ∀ f : ↥(fieldBar q M'), f ∈ F₀ ↔ ∀ n : ℤ, ((f : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)).coeff n ∈ K₀)

    (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀)

    [Algebra A₀ ↥F₀]
    (hj₀ : ∀ a : A₀, ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') ((ι a : ↥A) : AlgebraicClosure ℚ))
    (s : ↥W) :
    ∃ (B : Subalgebra A₀ ↥F₀),

      B.FG ∧
      (∀ x : ↥F₀, _root_.IsIntegral ↥B x → x ∈ B) ∧
      (∀ x : ↥F₀, ∃ b c : ↥F₀, b ∈ B ∧ c ∈ B ∧ c ≠ 0 ∧ x * c = b) ∧
      (∀ 𝔮 : Ideal ↥B, 𝔮.IsPrime → Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔮 → ¬ 𝔮.IsMaximal →
        𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes) ∧
      (∀ 𝔭 : Ideal ↥B, 𝔭.IsPrime → 𝔭 ≠ ⊥ → ¬ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ 𝔭) →
        ∃ V : ValuationSubring ↥F₀, ∀ f : ↥F₀, f ∈ V ↔ ∃ b c : ↥B, c ∉ 𝔭 ∧ f * (c : ↥F₀) = (b : ↥F₀)) ∧

      (⟨_, hjF₀⟩ : ↥F₀) ∈ B ∧

      (∀ b : ↥B, ((b : ↥F₀) : ↥(fieldBar q M')) ∈ OSS s) ∧
      (∃ 𝔮₀ : Ideal ↥B, 𝔮₀.IsPrime ∧
        (∀ x : ↥F₀, (x : ↥(fieldBar q M')) ∈ OSS s ↔ ∃ b c : ↥B, c ∉ 𝔮₀ ∧ x * (c : ↥F₀) = (b : ↥F₀)) ∧
        ∀ 𝔮 : Ideal ↥B, 𝔮 ∈ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).minimalPrimes → 𝔮 = 𝔮₀) ∧

      (∀ ℓ : CuspidalType.ProjLine q, ¬ ∀ b : ↥B, ((b : ↥F₀) : ↥(fieldBar q M')) ∈ OIg ℓ) ∧
      (∀ s' : ↥W, (∀ b : ↥B, ((b : ↥F₀) : ↥(fieldBar q M')) ∈ OSS s') → s' = s) ∧

      Algebra.FormallySmooth A₀ ↥B ∧

      (∀ E : Finset (ValuationSubring ↥F₀),
        (∀ V ∈ E, (∀ f : ↥F₀, f ∈ V → (f : ↥(fieldBar q M')) ∈ OSS s) ∧
          (∃ f : ↥F₀, (f : ↥(fieldBar q M')) ∈ OSS s ∧ f ∉ V) ∧
          (∃ b : ↥B, (b : ↥F₀) ∉ V)) →
        E.card ≤ q + 1) := by
  classical

  obtain ⟨k₀, π₀, hπ₀A, hk₀set, hπ₀π, hdvr, hunif, hhens, hresk, hκ, ⟨ℓa, hℓa_prime, hℓa3, hℓaq, hℓaM', ζ₀, hζ₀⟩, hϖt, eT1, heT1⟩ :=
    ModularCurve.FullLevel.exists_admissible_smallConstants_of_descentBase q hq M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr K₀ hπK₀ A₀ ι hι hιK₀ hres ϖ₀ hϖ₀ hϖ₀π F₀ hF₀ hjF₀ hj₀
  have hk₀ : ∀ x : AlgebraicClosure ℚ, x ∈ k₀ ↔ x ∈ K₀ := fun x => by
    rw [← SetLike.mem_coe, hk₀set]; rfl

  let Kb : IntermediateField ↥k₀ (AlgebraicClosure ℚ) := ⊥
  have hKb : Kb = ⊥ := rfl
  let Ab : ValuationSubring ↥Kb := A.comap (algebraMap ↥Kb (AlgebraicClosure ℚ))
  have hAb : ∀ x : ↥Kb, x ∈ Ab ↔ (x : AlgebraicClosure ℚ) ∈ A := fun _ => Iff.rfl
  have hπKb : π ∈ Kb := by
    show π ∈ (⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))
    rw [IntermediateField.mem_bot]; exact ⟨π₀, hπ₀π⟩
  let ϖb : ↥Ab := ⟨⟨π, hπKb⟩, show algebraMap ↥Kb (AlgebraicClosure ℚ) ⟨π, hπKb⟩ ∈ A from hπP⟩
  have hKbset : Set.range (fun a : A₀ => ((ι a : ↥A) : AlgebraicClosure ℚ)) =
      (A : Set (AlgebraicClosure ℚ)) ∩ (Kb : Set (AlgebraicClosure ℚ)) := by
    rw [hιK₀]
    congr 1
    ext x
    rw [← hk₀set]
    show x ∈ k₀ ↔ x ∈ (⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ))
    rw [IntermediateField.mem_bot]
    exact ⟨fun hx => ⟨⟨x, hx⟩, rfl⟩, fun ⟨y, hy⟩ => hy ▸ y.2⟩
  obtain ⟨eB, heB⟩ := ValuationSubring.exists_ringEquiv_comap_of_range_eq_inter (F := ↥k₀) Kb A A₀ ι hι hKbset
  have hgenB : eB ϖ₀ = ϖb := by
    apply Subtype.ext; apply Subtype.ext
    show algebraMap ↥Kb (AlgebraicClosure ℚ) ((eB ϖ₀ : ↥(A.comap (algebraMap ↥Kb (AlgebraicClosure ℚ)))) : ↥Kb) = π
    rw [heB, hϖ₀π]
  have hϖb : maximalIdeal ↥Ab = Ideal.span {ϖb} := by
    rw [← hgenB]; exact SSC.maximalIdeal_eq_span_of_ringEquiv eB ϖ₀ hϖ₀
  have hϖb0 : ϖb ≠ 0 := by
    intro h0
    have : (π : AlgebraicClosure ℚ) = 0 := congrArg (fun z : ↥Ab => ((z : ↥Kb) : AlgebraicClosure ℚ)) h0
    have hq0 : (q : AlgebraicClosure ℚ) ≠ 0 := by exact_mod_cast (Fact.out : q.Prime).ne_zero
    apply hq0
    rw [← hπ, this, zero_pow]
    exact Nat.sub_ne_zero_of_lt (by nlinarith [(Fact.out : q.Prime).two_le])

  letI algk₀F : Algebra ↥k₀ ↥(fieldBar q M') :=
    ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).comp (algebraMap ↥k₀ (AlgebraicClosure ℚ))).toAlgebra
  have hF₀const : ∀ x : ↥k₀, algebraMap ↥k₀ ↥(fieldBar q M') x ∈ F₀ := by
    intro x
    rw [hF₀]
    intro n
    have h0 : (((algebraMap ↥k₀ ↥(fieldBar q M')) x : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)) =
        HahnSeries.C (x : AlgebraicClosure ℚ) := by
      show HahnSeries.ofPowerSeries ℤ (AlgebraicClosure ℚ) (algebraMap (AlgebraicClosure ℚ) (PowerSeries (AlgebraicClosure ℚ)) (x : AlgebraicClosure ℚ)) = _
      rw [← PowerSeries.C_eq_algebraMap, HahnSeries.ofPowerSeries_C]
    rw [h0, HahnSeries.C_apply]
    by_cases hn : n = 0
    · subst hn; rw [HahnSeries.coeff_single_same]; exact (hk₀ _).mp x.2
    · rw [HahnSeries.coeff_single_of_ne hn]; exact zero_mem K₀
  let F₀' : IntermediateField ↥k₀ ↥(fieldBar q M') := F₀.toIntermediateField hF₀const
  have hCHAR : ∀ f : ↥(fieldBar q M'), f ∈ F₀' ↔ ∀ n : ℤ, ∃ c : ↥k₀,
      ((f : ↥(fieldBar q M')) : LaurentSeries (AlgebraicClosure ℚ)).coeff n = ((c : ↥k₀) : AlgebraicClosure ℚ) := by
    intro f
    show f ∈ F₀ ↔ _
    rw [hF₀ f]
    exact ⟨fun h n => ⟨⟨_, (hk₀ _).mpr (h n)⟩, rfl⟩, fun h n => by obtain ⟨c, hc⟩ := h n; rw [hc]; exact (hk₀ _).mp c.2⟩
  have hMK := ModularCurve.FullLevel.exists_supersingularDVR_affineChart_nodes_of_levelField q hq M' hqM' A hA W hW hle R₀ hR₀ s
    k₀ π₀ hπ₀A hdvr hunif hhens hresk hκ ℓa hℓa_prime hℓa3 hℓaq hℓaM' ζ₀ hζ₀ π₀ hπ₀A hϖt Kb hKb Ab hAb ϖb hϖb hϖb0 F₀' hCHAR
  obtain ⟨W₀, hW₀⟩ := hMK
  obtain ⟨hK2a, hK2dvr, hK2unif, hK4, hK5W, B_DL, algDL, hM1, hM0a, hM0b, hM4fs, hM4fp, hM4dim, hM2a, hM2prime, hM2loc,
    hM5j, hM5aut, hM3, nodes, hcard, hEQV1, hEQV2, hSEP, hCOVER, hnode⟩ := hW₀

  have hconstF₀ : ∀ a : A₀, algebraMap A₀ ↥F₀ a = algebraMap ↥k₀ ↥F₀' ((eT1 a : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) : ↥k₀) := by
    intro a
    apply Subtype.ext
    rw [hj₀ a, ← heT1 a]
    rfl
  have hBF₀ : ∀ f : ↥(fieldBar q M'), f ∈ B_DL → f ∈ F₀ := fun f hf => by
    obtain ⟨hf', -⟩ := hM2a f hf; exact hf'

  have hB_const : ∀ a : A₀, ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) ∈ B_DL := by
    intro a
    have h1 := hM1 (eB a)
    have h2 : ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) =
        algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (((eB a : ↥(A.comap (algebraMap ↥Kb (AlgebraicClosure ℚ)))) : ↥Kb) : AlgebraicClosure ℚ) := by
      rw [hj₀ a]; congr 1; exact (heB a).symm
    rw [h2, ← h1]
    exact (@algebraMap ↥Ab ↥B_DL _ _ algDL (eB a)).2
  let B : Subalgebra A₀ ↥F₀ :=
    { carrier := {f | (f : ↥(fieldBar q M')) ∈ B_DL}
      mul_mem' := fun {a b} ha hb => B_DL.mul_mem ha hb
      one_mem' := B_DL.one_mem
      add_mem' := fun {a b} ha hb => B_DL.add_mem ha hb
      zero_mem' := B_DL.zero_mem
      algebraMap_mem' := fun a => hB_const a }
  have hB : ∀ f : ↥F₀, f ∈ B ↔ (f : ↥(fieldBar q M')) ∈ B_DL := fun _ => Iff.rfl

  let ψ : ↥B ≃+* ↥B_DL :=
    { toFun := fun f => ⟨((f : ↥F₀) : ↥(fieldBar q M')), f.2⟩
      invFun := fun g => ⟨⟨(g : ↥(fieldBar q M')), hBF₀ _ g.2⟩, g.2⟩
      left_inv := fun f => rfl
      right_inv := fun g => rfl
      map_mul' := fun a b => rfl
      map_add' := fun a b => rfl }
  letI algA₀BDL : Algebra A₀ ↥B_DL := ((@algebraMap ↥Ab ↥B_DL _ _ algDL).comp eB.toRingHom).toAlgebra
  have hψalg : ∀ a : A₀, ψ (algebraMap A₀ ↥B a) = @algebraMap A₀ ↥B_DL _ _ algA₀BDL a := by
    intro a
    apply Subtype.ext
    show ((algebraMap A₀ ↥F₀ a : ↥F₀) : ↥(fieldBar q M')) = ((@algebraMap ↥Ab ↥B_DL _ _ algDL (eB a) : ↥B_DL) : ↥(fieldBar q M'))
    rw [hM1 (eB a), hj₀ a]
    congr 1
    exact (heB a).symm
  let ψₐ : ↥B ≃ₐ[A₀] ↥B_DL := AlgEquiv.ofRingEquiv (f := ψ) hψalg

  letI algA₀Ab : Algebra A₀ ↥Ab := eB.toRingHom.toAlgebra
  haveI : IsScalarTower A₀ ↥Ab ↥B_DL := IsScalarTower.of_algebraMap_eq (fun a => rfl)
  haveI : @Algebra.Smooth ↥Ab _ ↥B_DL _ algDL := ⟨hM4fs, hM4fp⟩
  haveI hSmAb : Algebra.Smooth A₀ ↥Ab := by
    have e : A₀ ≃ₐ[A₀] ↥Ab := AlgEquiv.ofRingEquiv (f := eB) (fun a => rfl)
    haveI : Algebra.Smooth A₀ A₀ := {}
    exact Algebra.Smooth.of_equiv e
  haveI hSmBDL : Algebra.Smooth A₀ ↥B_DL := Algebra.Smooth.comp A₀ ↥Ab ↥B_DL
  haveI hSmB : Algebra.Smooth A₀ ↥B := Algebra.Smooth.of_equiv ψₐ.symm

  have hF₀'eq : ∀ f : ↥(fieldBar q M'),
      f ∈ IntermediateField.adjoin ↥k₀ (⇑(algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')) '' (↑Kb : Set (AlgebraicClosure ℚ))) ⊔ F₀' ↔ f ∈ F₀ := by
    intro f
    have hle : IntermediateField.adjoin ↥k₀ (⇑(algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')) '' (↑Kb : Set (AlgebraicClosure ℚ))) ≤ F₀' := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨x, hx, rfl⟩
      have hx' : (x : AlgebraicClosure ℚ) ∈ (⊥ : IntermediateField ↥k₀ (AlgebraicClosure ℚ)) := hx
      rw [IntermediateField.mem_bot] at hx'
      obtain ⟨y, rfl⟩ := hx'
      exact hF₀const y
    rw [sup_eq_right.mpr hle]
    rfl
  have hfrac : ∀ x : ↥F₀, ∃ b c : ↥F₀, b ∈ B ∧ c ∈ B ∧ c ≠ 0 ∧ x * c = b := by
    intro x
    obtain ⟨g, h, hh0, hxh⟩ := hM0b (x : ↥(fieldBar q M')) ((hF₀'eq _).mpr x.2)
    refine ⟨⟨(g : ↥(fieldBar q M')), hBF₀ _ g.2⟩, ⟨(h : ↥(fieldBar q M')), hBF₀ _ h.2⟩, g.2, h.2, ?_, Subtype.ext hxh⟩
    intro h0; exact hh0 (congrArg Subtype.val h0)

  have hmapA₀ : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) = Ideal.span {algebraMap A₀ ↥B ϖ₀} := by
    rw [hϖ₀, Ideal.map_span, Set.image_singleton]
  have hψϖ : ψ (algebraMap A₀ ↥B ϖ₀) = @algebraMap ↥Ab ↥B_DL _ _ algDL ϖb := by
    refine (hψalg ϖ₀).trans ?_
    exact congrArg (@algebraMap ↥Ab ↥B_DL _ _ algDL) hgenB
  have hmapψ : Ideal.map ψ.toRingHom (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)) =
      Ideal.span {@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb} := by
    rw [hmapA₀, Ideal.map_span, Set.image_singleton]
    exact congrArg (fun x : ↥B_DL => Ideal.span ({x} : Set ↥B_DL)) hψϖ
  have hprime : (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)).IsPrime := by
    have h1 : (Ideal.span {@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb}).IsPrime :=
      (Ideal.span_singleton_prime hM2prime.ne_zero).mpr hM2prime
    have h2 : Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) =
        (Ideal.span {@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb}).comap ψ.toRingHom := by
      rw [← hmapψ, Ideal.comap_map_of_bijective (f := ψ.toRingHom) ψ.bijective]
    rw [h2]; exact Ideal.comap_isPrime _ _

  have hdim1 : Ring.KrullDimLE 1 (↥B ⧸ Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)) := by
    have e : (↥B ⧸ Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀)) ≃+*
        (↥B_DL ⧸ Ideal.span {@algebraMap ↥Ab ↥B_DL _ _ algDL ϖb}) :=
      Ideal.quotientEquiv _ _ ψ hmapψ.symm
    rw [Ring.krullDimLE_iff, ringKrullDim_eq_of_ringEquiv e]
    exact Ring.krullDimLE_iff.mp hM4dim
  obtain ⟨hfg, hn, hdimB, hsmloc⟩ :=
    Algebra.Smooth.fg_and_isIntegral_mem_and_minimalPrimes_and_formallySmooth_localizationAtPrime B hfrac hprime hdim1

