open AlgebraicCurve ModularCurve

theorem solution
    {q : ℕ} [Fact q.Prime] (hq : 5 ≤ q) {k : Type*} [Field k] [CharP k q] [IsAlgClosed k] [DecidableEq k]
    (S₀ : Finset k) (hS₀ : ∀ a, a ∈ S₀ ↔ a ∈ ssJSet q k) :
    S₀.card = genusFF (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar q) + 1 := by
  have hqp : q.Prime := Fact.out
  haveI : NeZero q := ⟨hqp.ne_zero⟩
  haveI := ModularCurve.hasCanonicalDivisor_modularFunctionFieldBar q
  rw [← ModularCurve.genus_eq_genusFF_modularFunctionFieldBar q]
  have h2 : q ≠ 2 := by omega
  have h3 : q ≠ 3 := by omega
  have hodd : Odd q := hqp.odd_of_ne_two h2
  have hgen := ModularCurve.genus_modularFunctionFieldBar_eq_genusFormula_of_prime q hodd
  have hψ := ModularCurve.dedekindPsi_prime hqp
  have hc := ModularCurve.cuspCount_prime hqp
  have hν₂ := ModularCurve.nuTwo_prime hqp h2
  have hν₃ := ModularCurve.nuThree_prime hqp h3
  have hcard := ModularCurve.card_eq_of_ssJSet q hq k S₀ hS₀
  suffices key : (S₀.card : ℚ) = (AlgebraicCurve.genus (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar q) : ℚ) + 1 by
    exact_mod_cast key
  rw [hgen, genusFormula, hψ, hc, hν₂, hν₃, hcard]
  have hq3 : q % 3 ≠ 0 := fun h0 =>
    h3 ((Nat.prime_dvd_prime_iff_eq Nat.prime_three hqp).mp (Nat.dvd_of_mod_eq_zero h0)).symm
  have hq2 : q % 2 = 1 := Nat.odd_iff.mp hodd
  obtain ⟨a, ha⟩ : ∃ a, q / 12 = a := ⟨_, rfl⟩
  have hr : q % 12 = 1 ∨ q % 12 = 5 ∨ q % 12 = 7 ∨ q % 12 = 11 := by omega
  rcases hr with hr | hr | hr | hr
  · have e1 : q % 4 = 1 := by omega
    have e2 : q % 3 = 1 := by omega
    have e3 : q = 12 * a + 1 := by omega
    rw [e1, e2, ha]; norm_num; rw [e3]; push_cast; ring
  · have e1 : q % 4 = 1 := by omega
    have e2 : q % 3 = 2 := by omega
    have e3 : q = 12 * a + 5 := by omega
    rw [e1, e2, ha]; norm_num; rw [e3]; push_cast; ring
  · have e1 : q % 4 = 3 := by omega
    have e2 : q % 3 = 1 := by omega
    have e3 : q = 12 * a + 7 := by omega
    rw [e1, e2, ha]; norm_num; rw [e3]; push_cast; ring
  · have e1 : q % 4 = 3 := by omega
    have e2 : q % 3 = 2 := by omega
    have e3 : q = 12 * a + 11 := by omega
    rw [e1, e2, ha]; norm_num; rw [e3]; push_cast; ring

