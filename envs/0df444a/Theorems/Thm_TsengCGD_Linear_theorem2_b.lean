-- title:
--   Theorem 2(b) — under Assumption 2, CGD with the restricted Gauss–Seidel rule and Armijo steps: $F_c(x^k)\downarrow-\infty$ or Q-/R-linear convergence along $\mathcal T$
-- statement:
--   Consider problem (1): minimize $F_c(x)=f(x)+cP(x)$ with $c>0$, $P:\Re^n\to(-\infty,\infty]$ proper, convex and lower semicontinuous, and $f$ continuously differentiable on an open set containing $\operatorname{dom}P$. Assume that $\nabla f$ is $L$-Lipschitz on $\operatorname{dom}P$ for some $L\ge0$ (22).
--
--   Let $\{x^k\},\{H^k\},\{d^k\}$ be generated by the CGD method under Assumption 1 ($\bar\lambda I\succeq H^k\succeq\underline\lambda I$, $0<\underline\lambda\le\bar\lambda$), where $\{\mathcal J^k\}$ is chosen by the restricted Gauss–Seidel rule (12) with $\mathcal T\subseteq\{0,1,\dots\}$. Suppose further that
--
--   1. $F_c$ satisfies Assumption 2: the local Lipschitzian error bound (35) $\operatorname{dist}(x,\bar X)\le\tau\|d_I(x)\|$ on each level set near $\bar X$, with $\bar X\ne\emptyset$ the set of stationary points, and the proper separation of the isocost surfaces of $F_c$ on $\bar X$;
--   2. $P$ is block-separable with respect to $\mathcal J^k$ for all $k$;
--   3. $\{\alpha^k\}$ is chosen by the Armijo rule with $\sup_k\alpha^k_{\rm init}\le1$ and $\inf_k\alpha^k_{\rm init}>0$.
--
--   Then either $\{F_c(x^k)\}$ decreases to $-\infty$, or
--   $$\{F_c(x^k)\}_{k\in\mathcal T}\ \text{converges at least Q-linearly}\quad\text{and}\quad\{x^k\}_{k\in\mathcal T}\ \text{converges at least R-linearly.}$$
--
--   This is the paper's linear convergence theorem for the CGD method with cyclic (Gauss–Seidel-type) coordinate selection; it requires neither convexity of $f$ nor strong convexity, only the error bound and the separation property of Assumption 2 (§6 of the paper gives sufficient conditions for the error bound).
--
--   **Formalization Note** "$\{F_c(x^k)\}\downarrow-\infty$" is stated as: the values are nonincreasing and tend to $-\infty$. The rates are along $\mathcal T=\{t_0<t_1<\cdots\}$, i.e. for the sequences $i\mapsto F_c(x^{t_i})$ and $i\mapsto x^{t_i}$. Q-linear convergence includes convergence to a limit $v$ and eventually $|s_{i+1}-v|\le q|s_i-v|$ with $q<1$; R-linear convergence is $\|x^{t_i}-\bar x\|\le Cq^i$ for some $\bar x$, $C$ and $q<1$. "$\sup_k\alpha^k_{\rm init}\le1$" is $\alpha^k_{\rm init}\le1$ for all $k$, "$\inf_k\alpha^k_{\rm init}>0$" a positive lower bound. In Assumption 2, $\operatorname{dist}$ is `Metric.infDist` and "for any $\zeta\ge\min F_c$" is "for every real $\zeta$". $P$ is the pair (effective domain, finite values); coordinates are 0-based.
-- source:
--   Tseng and Yun, A coordinate gradient descent method for nonsmooth separable minimization, Math. Program. Ser. B 117 (2009), pp. 405–409, Theorem 2(b), with Assumption 2 (p. 404)

import Mathlib
import Definitions.Def_TsengCGD_Linear_Basic
open Filter Topology Finset Matrix
open scoped RealInnerProductSpace

namespace TsengCGD.Linear

theorem theorem2_b {n : ℕ} (f : TsengCGD.Global.Vec n → ℝ) (D : Set (TsengCGD.Global.Vec n)) (P : TsengCGD.Global.Vec n → ℝ) (c : ℝ)
    (hs : TsengCGD.Global.Standing f D P c) (J : ℕ → Finset (Fin n)) (H : ℕ → Matrix (Fin n) (Fin n) ℝ)
    (x d : ℕ → TsengCGD.Global.Vec n) (α : ℕ → ℝ) (hrun : TsengCGD.Global.IsCGDRun f D P c J H x d α)
    (lam lamBar : ℝ) (hA1 : TsengCGD.Global.Assumption1 H lam lamBar)
    (L : ℝ) (hL : GradLipOn f D L)
    (t : ℕ → ℕ) (hRGS : RestrictedGaussSeidel J t)
    (hA2a : Assumption2a f D P c) (hA2b : Assumption2b f D P c)
    (hsep : ∀ k, TsengCGD.Global.BlockSeparable D P (J k))
    (β σ γ : ℝ) (αinit : ℕ → ℝ) (harm : TsengCGD.Global.IsArmijo f D P c β σ γ αinit H x d α)
    (hinit1 : ∀ k, αinit k ≤ 1) (hinit : ∃ a > 0, ∀ k, a ≤ αinit k) :
    (Antitone (fun k => TsengCGD.Global.Fc f P c (x k)) ∧ Tendsto (fun k => TsengCGD.Global.Fc f P c (x k)) atTop atBot) ∨
      (QLinear (fun i => TsengCGD.Global.Fc f P c (x (t i))) ∧ RLinear (fun i => x (t i))) := by sorry

end TsengCGD.Linear
