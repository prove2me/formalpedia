theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨185157758117,185377660444⟩ ⟨754252735004,754290197068⟩ ⟨87944437547,97323271733⟩ := rfl
noncomputable def centerUpper : ℝ := (384216336497 / 1099511627776)
