    have hdc := Bit.depH_child hm hme hrm
    have hd2 : W ^ (Bit.depH m (ρ.2.2 * (e / m)) + 1) ∣ L :=
      (pow_dvd_pow W hdc).trans hdep
    rw [pow_succ'] at hd2
    have hL' : 1 ≤ L / W := Nat.div_pos (Nat.le_of_dvd (by omega) (hWL hme)) (by omega)
    exact ⟨hlt, hi, hj, Nat.dvd_div_of_mul_dvd hd2, hL', hr0, hrm⟩
  have hNq : 1 ≤ q ^ (e / m) := Nat.one_le_pow _ _ hq.pos
  have hpB : ∀ x ∈ List.replicate (e % m) q ++ B, 1 ≤ x := pos_app (pos_rep hq.pos) hB
  have hpC : ∀ x ∈ List.replicate (e % m) q ++ Cs, 1 ≤ x := pos_app (pos_rep hq.pos) hC
  have hchL : ∀ ρ ∈ runsL C, ∀ ys : List (ZMod 2), ys.length = v1 → (child ρ ys).length = v1 := by
    intro ρ hρ ys hys
    obtain ⟨e', he', hρ'⟩ := List.mem_flatMap.1 hρ
    obtain ⟨hr0, hrm, hi, hj⟩ := hruns e' he' ρ hρ'
    by_cases hlt : ρ.2.2 * (e / m) < e
    · have hc : child ρ ys = Bit.progH C q (ρ.2.2 * (e / m)) P (L / W)
          (A ++ List.replicate ρ.1 (q ^ (e / m)))
          (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
            ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m))))
          (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++ (List.replicate (e % m) q ++ Cs))
          ys := by simp only [hchild, dif_pos hlt]
      rw [hc, progH_length _ _ _ _ _ _ _ _ _ hm1, vol_child ρ hi hj]
      · intro hme'
        have hme : m ≤ e := by
          by_contra hne
          rw [Nat.div_eq_of_lt (by omega), mul_zero] at hme'
          omega
        obtain ⟨-, -, -, hdv, -, -, -⟩ := hrun ρ hρ hme
        have := Bit.depH_of_le hme' hm
        exact (dvd_pow_self W (by omega)).trans hdv
      · rw [vol_child ρ hi hj]; exact hys
    · have hc : child ρ ys = ys := by simp only [hchild, dif_neg hlt]
      rw [hc]; exact hys
  -- the child calls
  have hch : m ≤ e → ∀ ρ ∈ runsL C, ∀ (t' : IState HS) (R' : List Item) (ys : List (ZMod 2)),
      DescG t' (ρ.2.2 * (e / m)) P (L / W)
        (chDesc m (q ^ (e / m)) (vol A) (q ^ (e % m) * vol B) (q ^ (e % m) * vol Cs) ρ).1
        (chDesc m (q ^ (e / m)) (vol A) (q ^ (e % m) * vol B) (q ^ (e % m) * vol Cs) ρ).2.1
        (chDesc m (q ^ (e / m)) (vol A) (q ^ (e % m) * vol B) (q ^ (e % m) * vol Cs) ρ).2.2 →
      ys.length = v1 →
      IRuns I (tabG C q ad) (tabG C q ad 0) (t'.upd 0 (ints (enc2 ys) ++ R'))
        (t'.upd 0 (ints (enc2 (child ρ ys)) ++ R')) (c0 ρ) := by
    intro hme ρ hρ t' R' ys hD' hys
    obtain ⟨hlt, hi, hj, hdv, hL', hr0, hrm⟩ := hrun ρ hρ hme
    have hc : child ρ ys = Bit.progH C q (ρ.2.2 * (e / m)) P (L / W)
        (A ++ List.replicate ρ.1 (q ^ (e / m)))
        (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
          ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m))))
        (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++ (List.replicate (e % m) q ++ Cs))
        ys := by simp only [hchild, dif_pos hlt]
    have hcc : c0 ρ = costN C q Bb (ρ.2.2 * (e / m)) (V / W) := by simp only [hc0, dif_pos hlt]
    rw [hc, hcc]
    have hvc := vol_child (e := e) (P := P) (L' := L / W) (A := A) (B := B) (Cs := Cs) (q := q) ρ hi hj
    have hD'' : DescG t' (ρ.2.2 * (e / m)) P (L / W) (vol (A ++ List.replicate ρ.1 (q ^ (e / m))))
        (vol (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
          ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m)))))
        (vol (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++
          (List.replicate (e % m) q ++ Cs))) := by
      simp only [vol_append, vol_replicate]; exact hD'
    have hKM' : (m + q + T + W + 16) * (vol (P :: L / W :: hdShape
        (A ++ List.replicate ρ.1 (q ^ (e / m)))
        (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
          ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m))))
        (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++ (List.replicate (e % m) q ++ Cs))
        (ρ.2.2 * (e / m)) q) + 1) ≤ M := by
      rw [hvc, ← hv1, hv1V hme]
      exact le_trans (Nat.mul_le_mul_left _ (by have := Nat.div_le_self V W; omega)) hKM
    have H := ih (ρ.2.2 * (e / m)) hlt P (L / W) _ _ _ hP hL' (pos_app hA (pos_rep hNq))
      (pos_app (pos_rep hNq) (pos_app hpB (pos_rep hNq))) (pos_app (pos_rep hNq) hpC) hdv hKM' I
      t' R' ys hD'' (by rw [hvc]; exact hys)
    rw [hvc, ← hv1, hv1V hme] at H
    exact H
  -- the three parts
  have S1 := genE_sp (s0.upd 0 (ints (enc2 xs) ++ R)) hM hEB
  have S2 := gen_level (I := I) (tab := tabG C q ad) C s0 hm hq hqB hOK hruns hM hEB hP hL hA hB hC
    hWL hN3 child c0 hchL hch R xs hxs
  set ys := if m ≤ e then Bit.levelH C (q ^ (e / m)) P (L / W) A
    (List.replicate (e % m) q ++ B) (List.replicate (e % m) q ++ Cs) child xs else xs with hys
  have hysl : ys.length = V := by
    rw [hys]
    split_ifs with hme
    · exact levelH_length C q e P L A B Cs child xs hm1 (hWL hme)
    · exact hxs
  have S3 := gen_tail (I := I) (iprog := tabG C q ad) s0 hM hq.two_le hP hL hA hB hC hEB hVM R ys
    hysl
  have hprog : Bit.progH C q e P L A B Cs xs = Bit.tailSwaps (P :: L :: hdShape A B Cs e q)
      (A.length + 2 + m * (e / m)) (A.length + B.length + e + 2 + m * (e / m)) (e % m) ys := by
    rw [Bit.progH, hys]
    by_cases hme : m ≤ e
    · rw [if_pos hme, if_pos hme]
    · rw [if_neg hme, if_neg hme, Nat.div_eq_of_lt (by omega), Nat.mod_eq_of_lt (by omega),
        mul_zero, add_zero, add_zero]
  have hcg : cGenL C e v1 Bb c0 = cGenL C e (V / W) Bb c0 := by
    by_cases hme : m ≤ e
    · rw [hv1V hme]
    · simp only [cGenL, if_neg hme]
  have hcost : costN C q Bb e V = cGenE m q W T e Bb + (cGenL C e (V / W) Bb c0 +
      cTail q V Bb (e % m)) + 25 := costN_eq C q Bb e V
  rw [e0] at hdJ
  rw [e0, e0, hcost, ← hcg, hprog]
  exact IRuns.iteT hdJ ((S1.toIRuns (I := I) (iprog := tabG C q ad)).seq (S2.seq S3))

end

