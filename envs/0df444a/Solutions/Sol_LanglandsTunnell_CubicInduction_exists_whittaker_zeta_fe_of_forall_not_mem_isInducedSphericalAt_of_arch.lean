namespace RatIntegersAlgebra
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open NumberField

private theorem ratIntegers_ringHom_ext {S : Type*} [Ring S] (f g : 𝓞 ℚ →+* S) : f = g := by
  have h : f.comp (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) = g.comp (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) :=
    Subsingleton.elim _ _
  ext x
  have hx : x = (Rat.ringOfIntegersEquiv.symm : ℤ →+* 𝓞 ℚ) (Rat.ringOfIntegersEquiv x) :=
    (Rat.ringOfIntegersEquiv.symm_apply_apply x).symm
  rw [hx]
  exact RingHom.congr_fun h _

private theorem ratIntegers_algebra_eq (L : Type) [Field L] [NumberField L] (i : Algebra (𝓞 ℚ) (𝓞 L)) :
    i = NumberField.inst_ringOfIntegersAlgebra ℚ L :=
  Algebra.algebra_ext i (NumberField.inst_ringOfIntegersAlgebra ℚ L) fun r =>
    RingHom.congr_fun
      (ratIntegers_ringHom_ext (@algebraMap (𝓞 ℚ) (𝓞 L) _ _ i)
        (@algebraMap (𝓞 ℚ) (𝓞 L) _ _ (NumberField.inst_ringOfIntegersAlgebra ℚ L))) r

end LanglandsTunnell.CubicInduction.RatIntegersAlgebra

