variable {d : ℕ} {sF μ : ℕ → ℕ}

theorem NLogN.KFU.phiAddr_eq_Phi (H : CrtOK d sF μ) (k c : ℕ) (i : Fin d) :
    have : ∀ i : Fin d, NeZero (sF i) := fun i => ⟨by have := H.pos i i.2; omega⟩
    (phiAddr d sF μ k c).getD i 0 =
      (OpenAI.RCRT.Phi (fun i : Fin d => sF i) (fun i : Fin d => μ i)
        (k : ZMod (∏ i : Fin d, sF i)) i).val := by sorry
