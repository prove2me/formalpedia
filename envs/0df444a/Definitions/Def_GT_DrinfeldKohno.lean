-- title:
--   Drinfeld-Kohno Lie algebra $\mathfrak t_n$
-- statement:
--   For every natural number $n$ this file constructs the **Drinfeld-Kohno Lie algebra** $\mathfrak t_n$ over $\mathbb Q$, the Lie algebra of infinitesimal braid relations.
--
--   It is presented by generators and relations. The generators are symbols $t_{ij}$ indexed by ordered pairs $(i,j)$ of elements of $\{0,1,\dots,n-1\}$, and $\mathfrak t_n$ is the quotient of the free Lie $\mathbb Q$-algebra on those symbols by the Lie ideal generated by
--
--   1. $t_{ii} = 0$ for every index $i$;
--   2. $t_{ij} = t_{ji}$ for all indices $i, j$;
--   3. $[t_{ij}, t_{kl}] = 0$ whenever $i, j, k, l$ are pairwise distinct;
--   4. $[t_{ij},\, t_{ik} + t_{jk}] = 0$ whenever $i, j, k$ are pairwise distinct.
--
--   The quotient carries the Lie algebra structure inherited from the free Lie algebra, and the image of the generator indexed by $(i,j)$ is written $t_{ij}$.
--
--   $\mathfrak t_n$ is the associated graded of the pure braid Lie algebra, the coefficient Lie algebra of the Knizhnik-Zamolodchikov connection $\nabla = d - \tfrac{1}{2\pi i}\sum_{i<j} t_{ij}\, d\log(z_i - z_j)$, and the ambient Lie algebra in which the pentagon equation defining $\mathfrak{grt}_1$ is stated, for $n = 4$.
--
--   **Formalization Note.** Indices are elements of `Fin n`, so the source's $t_{12}, t_{13}, t_{23}, t_{14}, t_{24}, t_{34}$ in $\mathfrak t_4$ correspond to the pairs $(0,1), (0,2), (1,2), (0,3), (1,3), (2,3)$. Generators with equal indices are kept in the presentation and killed by the first relation family.
-- source:
--   Thomas Willwacher, The Grothendieck-Teichmüller Group, ETH Zürich lecture notes (in progress), 27 February 2014, Section 4.2, p. 45-46 (Drinfeld-Kohno Lie algebra t_n; Proposition 4.4, equations (4.7), (4.8), (4.9)); Thomas Willwacher, The Grothendieck-Teichmüller Group, ETH Zürich lecture notes (in progress), 27 February 2014, Section 5.2, p. 50, equation (5.2) (Knizhnik-Zamolodchikov connection with values in t_n)

import Mathlib

/-!
# The Drinfeld-Kohno Lie algebras `t n`

Willwacher, *The Grothendieck-Teichmüller Group* (ETH lecture notes, 27 Feb 2014),
Section 4.2, p. 45; Section 5.2, eq. (5.2).
-/

namespace GrothendieckTeichmuller

open FreeLieAlgebra

noncomputable section

/-- The defining relations of the Drinfeld-Kohno Lie algebra `t n`, as a subset of the
free Lie algebra over `ℚ` on the set of ordered pairs of indices:

* `t i i = 0`;
* `t i j = t j i`;
* `⁅t i j, t k l⁆ = 0` for `i, j, k, l` pairwise distinct (locality);
* `⁅t i j, t i k + t j k⁆ = 0` for `i, j, k` pairwise distinct (infinitesimal braid relation).
-/
def dkRelations (n : ℕ) : Set (FreeLieAlgebra ℚ (Fin n × Fin n)) :=
  {r |
    (∃ i : Fin n, r = of ℚ (i, i)) ∨
    (∃ i j : Fin n, r = of ℚ (i, j) - of ℚ (j, i)) ∨
    (∃ i j k l : Fin n, i ≠ j ∧ i ≠ k ∧ i ≠ l ∧ j ≠ k ∧ j ≠ l ∧ k ≠ l ∧
      r = ⁅of ℚ (i, j), of ℚ (k, l)⁆) ∨
    (∃ i j k : Fin n, i ≠ j ∧ i ≠ k ∧ j ≠ k ∧
      r = ⁅of ℚ (i, j), of ℚ (i, k) + of ℚ (j, k)⁆)}

/-- The Lie ideal generated by the Drinfeld-Kohno relations. -/
def dkIdeal (n : ℕ) : LieIdeal ℚ (FreeLieAlgebra ℚ (Fin n × Fin n)) :=
  LieSubmodule.lieSpan ℚ _ (dkRelations n)

/-- The Drinfeld-Kohno Lie algebra `t n` over `ℚ`: the free Lie algebra on the generators
`t i j` modulo the relations `dkRelations n`. -/
def DrinfeldKohno (n : ℕ) : Type :=
  FreeLieAlgebra ℚ (Fin n × Fin n) ⧸ dkIdeal n

namespace DrinfeldKohno

instance (n : ℕ) : AddCommGroup (DrinfeldKohno n) :=
  inferInstanceAs (AddCommGroup (FreeLieAlgebra ℚ (Fin n × Fin n) ⧸ dkIdeal n))

instance (n : ℕ) : Module ℚ (DrinfeldKohno n) :=
  inferInstanceAs (Module ℚ (FreeLieAlgebra ℚ (Fin n × Fin n) ⧸ dkIdeal n))

instance (n : ℕ) : LieRing (DrinfeldKohno n) :=
  inferInstanceAs (LieRing (FreeLieAlgebra ℚ (Fin n × Fin n) ⧸ dkIdeal n))

instance (n : ℕ) : LieAlgebra ℚ (DrinfeldKohno n) :=
  inferInstanceAs (LieAlgebra ℚ (FreeLieAlgebra ℚ (Fin n × Fin n) ⧸ dkIdeal n))

end DrinfeldKohno

/-- The standard generator `t i j` of the Drinfeld-Kohno Lie algebra `t n`. -/
def dkGen {n : ℕ} (i j : Fin n) : DrinfeldKohno n :=
  LieSubmodule.Quotient.mk (N := dkIdeal n) (of ℚ (i, j))

end

end GrothendieckTeichmuller


