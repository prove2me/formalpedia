-- Source module: Solutions.J6SegLn9
/-!
# Segmented inverse (S2), machine side 9: one complex line of `B₀`

The whole `B₀` line map (`B0seg = D̃' segJ C̃`) on a line `y` of `t` Gaussian items, as list
passes:

1. selection and scaling (`selC`): row `l < s` is the item `⌊(2tl + s)/(2s)⌋` times
   `2^{P-p-1}`, rows `s ≤ l < N` are `0`;
2. `segLineC` on the real and on the imaginary parts;
3. the output pass: floor by `2^{P-p}`, multiply by `d̃'_l`, round to zero by `2^p`
   (rows `≥ s` are `0`).

**`lineB_eq`**: entry `l < N` of `lineB y` is `B0seg … (y as a function) l`.
-/

open Finset

namespace J6Seg

section congr
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

theorem geSolveS_congr_b : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ) (b b' : ℕ → ℤ),
    (∀ k ∈ L, b k = b' k) → ∀ k, geSolveS P S L A b k = geSolveS P S L A b' k
  | [], _, _, _, _, _ => rfl
  | j :: L, A, b, b', h, k => by
    have hj := h j (List.mem_cons_self ..)
    have hrec : ∀ k, geSolveS P S L (stepA P S j A) (stepB P S j A b) k =
        geSolveS P S L (stepA P S j A) (stepB P S j A b') k :=
      geSolveS_congr_b L _ _ _ (fun i hi => by
        simp only [stepB, h i (List.mem_cons_of_mem _ hi), hj])
    rw [geSolveS_cons, geSolveS_cons]
    split_ifs
    · rw [hj]
      congr 2
      refine Finset.sum_congr rfl (fun k' _ => ?_)
      rw [hrec]
    · exact hrec k

theorem segInvS_congr {s t lam : ℕ} {T : Tables} {B : Blocks} (hB : BlocksOK s t B)
    {U U' : ℕ → ℤ} (h : ∀ v < s, U v = U' v) :
    ∀ l < s, segInvS P lam T B U l = segInvS P lam T B U' l := by
  intro l hl
  have hY := applyMinv_congr (T := T) P hB h
  have hJ : ∀ k ∈ Jlist B, k < s := by
    intro k hk
    unfold Jlist at hk
    rw [List.mem_filter, List.mem_range, hB.hs] at hk
    exact hk.1
  have hz := geSolveS_congr_b P (bandS (lam + B.w) (B.s - lam - B.w)) (Jlist B) (capI P T B)
    _ _ (fun k hk => hY k (hJ k hk))
  unfold segInvS
  try simp only []
  rw [hY l hl, funext hz]

end congr

section lineB
variable (p P R s t lam w α K : ℕ)

variable {p P R s t lam w α K}

lemma rowSel_lt (hst : s ≤ t) {l : ℕ} (hl : l < s) : rowSel s t l < t := by
  unfold rowSel
  rw [Nat.div_lt_iff_lt_mul (by omega)]
  have h1 : t * l + t ≤ t * s := by
    have := Nat.mul_le_mul_left t (show l + 1 ≤ s by omega)
    rw [Nat.mul_add, mul_one] at this; exact this
  nlinarith

lemma cSel_line (hst : s ≤ t) [NeZero t] (y : List (ℤ × ℤ)) {l : ℕ} (hl : l < s) :
    IntMul.HvdH.cSel s t (fun j => y.getD j (0, 0)) l = y.getD (rowSel s t l) (0, 0) := by
  unfold IntMul.HvdH.cSel
  rw [Nat.mod_eq_of_lt hl, ZMod.val_natCast,
    Nat.mod_eq_of_lt (show (2 * t * l + s) / (2 * s) < t from rowSel_lt hst hl)]
  rfl

/-- **The list passes compute `B₀`.** -/
theorem lineB_eq [NeZero t] (hl : 1 ≤ lam) (hs : 0 < s) (hst : s ≤ t) (hws : 2 * w < s)
    (hwK : w ≤ K) (hKm : 2 * K + 1 ≤ (LJ s t lam w).length) {nc : ℕ} (hsN : s ≤ nc * lam)
    (y : List (ℤ × ℤ))
    {l : ℕ} (hlN : l < nc * lam) :
    (lineB p P R s t lam w α K nc y).getD l (0, 0) =
      B0seg p P R lam w s t α (fun j => y.getD j (0, 0)) l := by
  have hB : BlocksOK s t (BB s t lam w) := mkBlocks_ok hs w (by omega)
  have hlen : ∀ g, nc * lam ≤ (selC p P s t (nc * lam) g y).length := fun g => by simp [selC]
  unfold lineB
  try simp only []
  rw [List.getD_eq_getElem _ _ (by simp; omega)]
  simp only [List.getElem_map, List.getElem_range]
  unfold B0seg IntMul.HvdH.Dapprox segJ
  split_ifs with hls
  · rw [segLineC_eq hl hs hws hwK hKm hsN (hlen _) hlN, if_pos hls,
      segLineC_eq hl hs hws hwK hKm hsN (hlen _) hlN, if_pos hls]
    have hcongr : ∀ (g : ℤ × ℤ → ℤ), ∀ v < s, (selC p P s t (nc * lam) g y).getD v 0 =
        g (IntMul.HvdH.cSel s t (fun j => y.getD j (0, 0)) v) * 2 ^ (P - p - 1) := by
      intro g v hv
      unfold selC
      rw [getD_range_map_any (by omega)]
      try beta_reduce
      rw [if_pos hv, cSel_line hst y hv]
    unfold segInvFullS segInvCS outE
    try simp only []
    rw [segInvS_congr P hB (hcongr Prod.fst) l hls, segInvS_congr P hB (hcongr Prod.snd) l hls]
    all_goals rfl
  · simp

end lineB

