  ESp.lit (zS hp hBb h0 h1)

omit hp hA hBb in
theorem hR_le (i j : ℕ) : NLogN.KFX.hR i j ≤ 2 := by unfold NLogN.KFX.hR; split_ifs <;> omega

theorem sHr : ESp eHr u Bb ((NLogN.KFX.hR i j : ℕ) : ℤ) := by
  have hi : (i : ℕ) < 1000000 := lt_of_lt_of_eq i.isLt mC_eq
  have hj : (j : ℕ) < 1000000 := lt_of_lt_of_eq j.isLt mC_eq
  have I0 : (0 : ℤ) ≤ ((i : ℕ) : ℤ) := Nat.cast_nonneg _
  have J0 : (0 : ℤ) ≤ ((j : ℕ) : ℤ) := Nat.cast_nonneg _
  have I1 : ((i : ℕ) : ℤ) ≤ 10 ^ 6 := by exact_mod_cast hi.le
  have J1 : ((j : ℕ) : ℤ) ≤ 10 ^ 6 := by exact_mod_cast hj.le
  have hIJ : ((i : ℕ) : ℤ) * ((j : ℕ) : ℤ) ≤ 10 ^ 12 := by nlinarith
  refine ESp.sel (ESp.neg (ESp.mul (sIp hp hA hBb) (sJp hp hA hBb)
    (zS hp hBb (by nlinarith) (by nlinarith))))
    (clean56 (by decide)) (clean56 (by decide)) (fun hl => ?_) (fun hl => ?_)
  · have h1 : (i : ℕ) ≠ 0 := by rintro h; simp [h] at hl
    have h2 : (j : ℕ) ≠ 0 := by rintro h; simp [h] at hl
    have : NLogN.KFX.hR i j = 0 := by simp [NLogN.KFX.hR, h1, h2]
    rw [this]; exact ESp.of_eq (sLit hp hBb 0 (by norm_num) (by norm_num)) (by simp)
  · have h0 : (i : ℕ) = 0 ∨ (j : ℕ) = 0 := by
      by_contra hc; push Not at hc
      have a1 : (0 : ℤ) < ((i : ℕ) : ℤ) := by exact_mod_cast Nat.pos_of_ne_zero hc.1
      have a2 : (0 : ℤ) < ((j : ℕ) : ℤ) := by exact_mod_cast Nat.pos_of_ne_zero hc.2
      have : (0 : ℤ) < ((i : ℕ) : ℤ) * ((j : ℕ) : ℤ) := mul_pos a1 a2
      exact hl (by linarith)
    have l1 := sLit (u := u) hp hBb 1 (by norm_num) (by norm_num)
    have pI0 : 0 ≤ (((i : ℕ) : ℤ) - 1) * (((i : ℕ) : ℤ) - 1) := mul_self_nonneg _
    have pJ0 : 0 ≤ (((j : ℕ) : ℤ) - 1) * (((j : ℕ) : ℤ) - 1) := mul_self_nonneg _
    have pI1 : (((i : ℕ) : ℤ) - 1) * (((i : ℕ) : ℤ) - 1) ≤ 10 ^ 12 := by nlinarith
    have pJ1 : (((j : ℕ) : ℤ) - 1) * (((j : ℕ) : ℤ) - 1) ≤ 10 ^ 12 := by nlinarith
    have pP : (((i : ℕ) : ℤ) - 1) * (((i : ℕ) : ℤ) - 1) *
        ((((j : ℕ) : ℤ) - 1) * (((j : ℕ) : ℤ) - 1)) ≤ 10 ^ 24 := by
