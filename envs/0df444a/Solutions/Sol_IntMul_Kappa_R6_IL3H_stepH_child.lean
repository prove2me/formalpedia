-- Source module: Solutions.R6IL3Child
/-!
# Round six, item language (I3): the child step of a node

`child w (pref m s) ∅` (normalized: the slots `< s`, forward) on role `w`: the frame `childFrH`
(`wP = 2^{Gs (sF)}`, `vX = Gs (sF)`, `vB = B/W`, `vk = s F`) around `wrapQ … (call jL)`.  The
slots `< s` of role `w` are the top `s F` bits `e - K i`, `i < s F`, so the call runs the level
procedure on `s F` bits at the same `e`.

* `rImplQ_push`: a frame around a role-stream statement (copy of `sImplQ_push`);
* `gsNE_OK`, `powNE_OK`: side conditions of the scale expressions;
* `levRH_child`, **`stepH_child`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.IL3H

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFG NLogN.KFH NLogN.KFN NLogN.KFW
  Complex P8Lift Butterfly IntMul.Kappa.R6.Cx

section Push

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {Q : IState HS → Prop} {lo hi : ℕ}
variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ] {r n : ℕ} {st : Fin m × κ → ℕ}

/-- **A frame** around a role-stream statement. -/
theorem rImplQ_push {Q' : IState HS → Prop} {A : ROp (Fin W) m κ}
    {U : IStmt HS Pp} {e dw : ℕ} {cost : ℕ → ℕ}
    (σ : Fin HS → Option ℤ) (hσ0 : σ 0 = none) (hQσ : ∀ s, Q s → Agree σ s)
    (pl : List (Fin HS × Ex HS)) (vl : List (Fin HS × ℤ)) (cp Bb : ℕ)
    (hP : PushSeq σ pl vl cp) (h0 : (0 : Fin HS) ∉ pl.map Prod.fst)
    (hBb : ∀ p ∈ vl, zsz p.2 ≤ Bb) (hQ' : ∀ s, Q s → Q' (pushSt s vl))
    (H : RImplQ I iprog Q' lo hi r n st A U e dw cost) :
    RImplQ I iprog Q lo hi r n st A (withPushI pl U) e dw
      (fun w => cp + cost w + (vl.length * (2 * Bb + 2) + 1)) := by
  intro s f zs l X F w hq hC h0' hx hX hb hlo hhi
  obtain ⟨zs', R, G, Hr⟩ := H (pushSt s vl) f zs l X F w (hQ' s hq) hC h0' hx hX hb hlo hhi
  have hfst := hP.fst
  have hne : ∀ p ∈ vl, p.1 ≠ 0 := by
    intro p hp h
    apply h0
    rw [← hfst]
    exact List.mem_map.2 ⟨p, hp, h⟩
  have hag : Agree σ (encK s f) := agree_clean0 hσ0 (hQσ s hq) hC
  have S1 := Sp.pushSeq pl vl σ cp hP (encK s f) hag
  rw [encK_pushSt s f vl (fun p hp => hC p.1 (hne p hp))] at S1
  set f' := Function.update f 0 (gflat zs' ++ l)
  have S3 := Sp.popsR Bb vl (encK s f') (fun p hp => ⟨hP.lt p hp, hBb p hp⟩)
  rw [encK_pushSt s f' vl (fun p hp => by
    simp only [f']; rw [Function.update_of_ne (hne p hp)]; exact hC p.1 (hne p hp)), hfst] at S3
  refine ⟨zs', R, G, ?_⟩
  have := (S1.toIRuns (I := I) (iprog := iprog)).seq (Hr.seq (S3.toIRuns (I := I) (iprog := iprog)))
  refine this.mono (le_of_eq ?_)
  ring

end Push

/-! ## The scale expressions -/

theorem Gs_mono {A p m : ℕ} (hA : 1 ≤ A) (hp : 1 ≤ p) {x y : ℕ} (hxy : x ≤ y) :
    Gs A p m x ≤ Gs A p m y := by
  by_cases hy : y < 2 * m
  · rw [Gs_lt (by omega), Gs_lt hy]; exact hxy
  · rw [Gs_ge (show 2 * m ≤ y by omega)]
    by_cases hx : x < 2 * m
    · rw [Gs_lt hx]; exact le_trans hxy (le_Ap hA hp)
    · rw [Gs_ge (show 2 * m ≤ x by omega)]
      exact Nat.mul_le_mul_left _ (Nat.sub_le_sub_right (Nat.pow_le_pow_left (by omega) _) _)

theorem Gs_le_pow {A p m x : ℕ} (hA : 1 ≤ A) (hp : 1 ≤ p) : Gs A p m x ≤ A * (x + 1) ^ p :=
  le_trans (Gs_le hA hp) (Nat.mul_le_mul_left _ (Nat.sub_le _ _))

/-! ## The child frame -/

theorem childVLH_keys (c : Cfg) (s F Bn : ℕ) (p : Fin HS × ℤ) (hp : p ∈ childVLH c s F Bn) :
    p.1 ∈ [wP, vX, vB, vk] := by
  simp only [childVLH, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl | rfl | rfl | rfl <;> simp

theorem childVLH_nodup (c : Cfg) (s F Bn : ℕ) : ((childVLH c s F Bn).map Prod.fst).Nodup := by
  simp only [childVLH, List.map_cons, List.map_nil]; decide

theorem σChildH_ne {σ : Fin HS → Option ℤ} {c : Cfg} {s F Bn : ℕ} {i : Fin HS}
    (hi : i ∉ [wP, vX, vB, vk]) : σChildH σ c s F Bn i = σ i :=
  σPush_ne _ _ _ (fun p hp hpi => hi (hpi ▸ childVLH_keys c s F Bn p hp))

theorem σChildH_val {σ : Fin HS → Option ℤ} {c : Cfg} {s F Bn : ℕ} {i : Fin HS} {v : ℤ}
    (hv : (i, v) ∈ childVLH c s F Bn) : σChildH σ c s F Bn i = some v :=
  σPush_mem _ _ _ _ (childVLH_nodup c s F Bn) hv

section ChildR

variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

/-- The child frame of a node is a level frame (same `e`: the slots `< s` are the top bits). -/
theorem levRH_child (hN : NodeRH c σ K t S0 r H E e B) (s : ℕ) :
    LevRH c (σChildH σ c s (E / c.m) (B / c.W)) K t S0 r H (s * (E / c.m)) e (B / c.W) := by
  have ne : ∀ i : Fin HS, i ∉ [wP, vX, vB, vk] →
      σChildH σ c s (E / c.m) (B / c.W) i = σ i := fun i hi => σChildH_ne hi
  refine ⟨fun i hi => ?_, fun i hi => ?_, fun i v hv => ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [ne i (by revert hi; revert i; decide)]; exact hN.lev.off i hi
  · rw [ne i (by revert hi; revert i; decide)]; exact hN.lev.offp i hi
  · rcases σPush_cases _ _ _ _ hv with ⟨p, hp, rfl⟩ | h'
    · have := childVLH_keys c s (E / c.m) (B / c.W) p hp
      simp only [List.mem_cons, List.not_mem_nil, or_false] at this
      rcases this with h1 | h1 | h1 | h1 <;> rw [h1] <;> decide
    · exact hN.lev.lt i v h'
  · rw [ne _ (by decide)]; exact hN.lev.hK
  · rw [ne _ (by decide)]; exact hN.lev.ht
  · rw [ne _ (by decide)]; exact hN.lev.hS
  · rw [ne _ (by decide)]; exact hN.lev.hr
  · rw [ne _ (by decide)]; exact hN.lev.hH
  · exact σChildH_val (by simp [childVLH])
  · rw [ne _ (by decide)]; exact hN.lev.hE
  · exact σChildH_val (by simp [childVLH])
  · exact σChildH_val (by simp [childVLH])

theorem wregP_child (hN : NodeRH c σ K t S0 r H E e B) (s : ℕ) :
    WReg (σChildH σ c s (E / c.m) (B / c.W)) wL wP (nN (B / c.W) t S0 * r) (c.G (s * (E / c.m))) :=
  ⟨sclean_of_lt (levRH_child hN s).lt, (levRH_child hN s).off,
    by rw [σChildH_ne (by decide)]; exact hN.gL, σChildH_val (by simp [childVLH])⟩

end ChildR

/-! ## The child step -/

section ChildStep

variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}
variable {c : Cfg} {σ : Fin HS → Option ℤ} {K t S0 r H E e B : ℕ}

theorem setFam_pref_subOp {m F s : ℕ} (hs : s ≤ m) :
    let g : Fin s × Fin F → Fin m × Fin F := fun p => (⟨p.1.val, lt_of_lt_of_le p.1.isLt hs⟩, p.2)
    subOp g (tens Cm : Op (Fin s × Fin F)) = tensF (setFam (κ := Fin F) (pref m s) Cm) := by
  intro g
  have hg : Function.Injective g := fun a b h => by
    simp only [g, Prod.mk.injEq, Fin.mk.injEq] at h
    exact Prod.ext (Fin.ext h.1) h.2
  rw [subOp_tens hg]
  congr 1; funext q
  simp only [setFam, mem_pref]
  have : (∃ k, g k = q) ↔ q.1.val < s := by
    constructor
    · rintro ⟨k, rfl⟩; exact k.1.isLt
    · intro h; exact ⟨(⟨q.1.val, h⟩, q.2), rfl⟩
  by_cases h : q.1.val < s
  · rw [if_pos (this.2 h), if_pos h]
  · rw [if_neg (fun h' => h (this.1 h')), if_neg h]

/-- **A child step** (normalized: slots `< s`, forward) from an implementation of the child level. -/
theorem stepH_child_sol_aux (hN : NodeRH c σ K t S0 r H E e B) (hQ : ∀ s, Q s → Agree σ s) (hhi : hi ≤ H)
    (hA : 1 ≤ c.Aw) (hp : 1 ≤ c.p) (hm : 1 ≤ c.m) (hW : 1 ≤ c.Wr)
    (hr : 1 ≤ r) (hS : 1 ≤ S0) (hBn : 1 ≤ B / c.W) (Z : ℕ)
    (hZ : zsz ((2 * (c.Wr * (nN (B / c.W) t S0 * r)) : ℕ) : ℤ) ≤ Z) (M Bz : ℕ)
    (hM : c.Aw * (E + 1) ^ c.p + (E + 1) ^ c.p + E + 2 * c.m + B + 1 ≤ M)
    (hMB : zsz (M : ℤ) ≤ Bz) (s : ℕ) (hs : s < c.m)
    {jL : Fin Pp} {rowC : IStmt HS Pp} (hj : tbl jL = levCH c jL rowC)
    (w : Fin c.Wr) (DWc : ℕ) (cIH : ℕ → ℕ)
    (IH : SImplQ Isym tbl (fun s' => Agree (σChildH σ c s (E / c.m) (B / c.W)) s') 0 H r
      (fun i : Fin (s * (E / c.m)) => 2 ^ (e - K * i.val) * S0) (nN (B / c.W) t S0)
      (tens Cm) (levCH c jL rowC) (c.G (s * (E / c.m))) DWc cIH) :
    RImplQ Isym tbl Q lo hi r (nN (B / c.W) t S0) (stH c.m K e (E / c.m) S0)
      ((HStep.child w (pref c.m s) ∅ : HStep (Fin c.Wr) c.m).den (chEx (κ := Fin (E / c.m))))
      (withPushI (childFrH c s) (wrapQ c.Wr w.val wL wP (.call jL)))
      (c.G (s * (E / c.m))) (DWc + (c.G (s * (E / c.m)) + 2) * c.Wr)
      (fun x => cChF c Bz (c.G (s * (E / c.m))) + cWrapQ c.Wr (nN (B / c.W) t S0 * r) Z
        (c.G (s * (E / c.m))) DWc (fun x => cIH x + 2) x +
        (4 * (2 * (Bz + c.G (s * (E / c.m)) + 1) + 2) + 1)) := by
  set F := E / c.m with hF
  set Bn := B / c.W with hBnd
  set σc := σChildH σ c s F Bn with hσc
  have IHc := (sImplQ_call (I := Isym) (lo := 0) (hi := H) hj IH).window (Nat.zero_le lo) hhi
  set g : Fin s × Fin F → Fin c.m × Fin F :=
    fun p => (⟨p.1.val, lt_of_lt_of_le p.1.isLt hs.le⟩, p.2) with hgd
  have hg : Function.Injective g := fun a b h => by
    simp only [g, Prod.mk.injEq, Fin.mk.injEq] at h
    exact Prod.ext (Fin.ext h.1) h.2
  set eqv : Fin s × Fin F ≃ Fin (s * F) := finProdFinEquiv
  have hst : (stH c.m K e F S0 ∘ g) ∘ eqv.symm = fun i : Fin (s * F) => 2 ^ (e - K * i.val) * S0 := by
    funext i
    simp only [Function.comp, stH, IL3F.posR, g, eqv, finProdFinEquiv_symm_apply, Fin.coe_divNat,
      Fin.coe_modNat]
    rw [Nat.mod_add_div]
  have h1 := sImplQ_equiv (I := Isym) (iprog := tbl) eqv.symm (stH c.m K e F S0 ∘ g) Cm
    (by rw [hst]; exact IHc)
  have h2 := sImplQ_subOp hg h1
  rw [setFam_pref_subOp hs.le] at h2
  have R := rImplQ_onRole (W := c.Wr) (by omega) w (by omega) (one_le_nN hBn hS)
    (stH c.m K e F S0) _ h2 (stH c.m K e F S0)
    ((HStep.child w (pref c.m s) ∅ : HStep (Fin c.Wr) c.m).den (chEx (κ := Fin F)))
    (fun X hX => by rw [HStep.den_child_exact, slotFam_empty, roleOpF_wireOp _ _ _ _ hX])
    Z hZ (wregP_child hN s) (fun s h => h)
  have hsF : s * F ≤ E := by
    have h1 : s * F ≤ c.m * F := Nat.mul_le_mul_right _ (by omega)
    have h2 : c.m * F ≤ E := Nat.mul_div_le E c.m
    omega
  have hGs : Gs c.Aw c.p c.m (s * F) ≤ Gs c.Aw c.p c.m E := Gs_mono hA hp hsF
  have hGM : Gs c.Aw c.p c.m (s * F) ≤ M := by
    have := Gs_le_pow (m := c.m) (x := s * F) hA hp
    have : (s * F + 1) ^ c.p ≤ (E + 1) ^ c.p := Nat.pow_le_pow_left (by omega) _
    have : c.Aw * (s * F + 1) ^ c.p ≤ c.Aw * (E + 1) ^ c.p := Nat.mul_le_mul_left _ this
    omega
  have hEM : E ≤ M := by omega
  have hBM : Bn ≤ M := by have := Nat.div_le_self B c.W; omega
  have P := pushSeq_child hN hA hp hm s hs M Bz hM hMB
  have H := rImplQ_push (I := Isym) (iprog := tbl) (Q := Q) (lo := lo) (hi := hi)
    (Q' := fun s' => Agree σc s') σ hN.zero hQ (childFrH c s) (childVLH c s F Bn)
    (cChF c Bz (c.G (s * F))) (Bz + c.G (s * F) + 1) P (by simp [childFrH, Fin.ext_iff])
    (by
      intro q hq
      simp only [childVLH, List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl | rfl | rfl
      · simp only [NLogN.zsz_two_pow, Cfg.G]; omega
      · exact le_trans (le_trans (zsz_natCast_le hGM) hMB) (by omega)
      · exact le_trans (le_trans (zsz_natCast_le hBM) hMB) (by omega)
      · exact le_trans (le_trans (zsz_natCast_le (le_trans hsF hEM)) hMB) (by omega))
    (fun s' hs' => agree_pushSt' _ (hQ s' hs')) R
  exact H

end ChildStep

end IntMul.Kappa.R6.IL3H

