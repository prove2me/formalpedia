section steps
variable {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  (s : IState HS) (F : Fin HS → List ℤ) (z ds : List ℤ) (v : Fin 19 → List ℤ) (B : ℕ)
include hW

theorem popR_sp (i : Fin 19) (x : ℤ) (l : List ℤ) (hvi : v i = x :: l) (hz : zsz x ≤ B) :
    Sp (.pop (σ i)) (encK s (SS σ dS F z ds v)) (encK s (SS σ dS F z ds (update v i l)))
      (2 * B + 2) := by
  have S := Sp.pop s (SS σ dS F z ds v) (i := σ i) (a := x) (l := l) (B := B) (hW.lt i)
    (by rw [SS_at hW, hvi]) hz
  rwa [SS_v hW] at S

end steps

