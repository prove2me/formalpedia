/- BEGIN Definitions.SCAFFOLD.ServerMoments -/
section SCAFFOLDBundleModule19
/-! Server displacement moments for SCAFFOLD Appendix E, PDF pp. 26-35,
Lemmas 12 and 16-19. The conditional moment uses the round-start history. -/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

variable {d N : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

def serverDisplacement (A : Run P ν S K T ηl ηg init) (r : ℕ) (ω : Ω) : Space d :=
  A.x (r + 1) ω - A.x r ω

def serverSecondMoment (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  ∫ ω, ‖serverDisplacement A r ω‖ ^ 2 ∂ν

def meanServerSecondMoment (A : Run P ν S K T ηl ηg init) (r : ℕ) : ℝ :=
  ∫ ω, ‖ν[serverDisplacement A r | A.history (roundTime K r)] ω‖ ^ 2 ∂ν

theorem Run.serverDisplacement_memLp (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) : MemLp (serverDisplacement A r) 2 ν :=
  (A.x_memLp (r + 1) (Nat.succ_le_of_lt hr)).sub (A.x_memLp r hr.le)

theorem serverSecondMoment_nonneg (A : Run P ν S K T ηl ηg init) (r : ℕ) :
    0 ≤ serverSecondMoment A r := integral_nonneg (fun _ ↦ sq_nonneg _)

theorem meanServerSecondMoment_nonneg (A : Run P ν S K T ηl ηg init) (r : ℕ) :
    0 ≤ meanServerSecondMoment A r := integral_nonneg (fun _ ↦ sq_nonneg _)

theorem neg_two_inner_le {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (x y : E) {ε : ℝ} (hε : 0 < ε) :
    -2 * ⟪x, y⟫_ℝ ≤ ε * ‖x‖ ^ 2 + ε⁻¹ * ‖y‖ ^ 2 := by
  have hh := sq_nonneg ‖ε • x + y‖
  rw [norm_add_sq_real, real_inner_smul_left, norm_smul, mul_pow,
    Real.norm_eq_abs, sq_abs] at hh
  apply (mul_le_mul_iff_right₀ hε).mp
  have heq : ε * (ε * ‖x‖ ^ 2 + ε⁻¹ * ‖y‖ ^ 2) = ε ^ 2 * ‖x‖ ^ 2 + ‖y‖ ^ 2 := by
    field_simp
  rw [heq]
  nlinarith

omit [StandardBorelSpace Ω] in
theorem integral_neg_two_inner_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [CompleteSpace E] {X Y : Ω → E}
    (hX : MemLp X 2 ν) (hY : MemLp Y 2 ν) {ε : ℝ} (hε : 0 < ε) :
    -2 * (∫ ω, ⟪X ω, Y ω⟫_ℝ ∂ν) ≤
      ε * (∫ ω, ‖X ω‖ ^ 2 ∂ν) + ε⁻¹ * (∫ ω, ‖Y ω‖ ^ 2 ∂ν) := by
  have h := integral_mono ((FedAvg.inner_integrable_of_memLp hX hY).const_mul (-2))
    ((hX.norm.integrable_sq.const_mul ε).add (hY.norm.integrable_sq.const_mul ε⁻¹))
    (fun ω ↦ neg_two_inner_le (X ω) (Y ω) hε)
  simp only [Pi.add_apply] at h
  rw [integral_add (hX.norm.integrable_sq.const_mul ε)
    (hY.norm.integrable_sq.const_mul ε⁻¹), integral_const_mul, integral_const_mul,
    integral_const_mul] at h
  exact h

omit [StandardBorelSpace Ω] in
theorem integral_inner_condExp_right {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [CompleteSpace E] {H : MeasurableSpace Ω}
    (hH : H ≤ mΩ) {X Y : Ω → E}
    (hX : MemLp X 2 ν) (hY : MemLp Y 2 ν) (hm : AEStronglyMeasurable[H] X ν) :
    (∫ ω, ⟪X ω, Y ω⟫_ℝ ∂ν) = ∫ ω, ⟪X ω, ν[Y | H] ω⟫_ℝ ∂ν := by
  have h := condExp_bilin_of_aestronglyMeasurable_left (innerSL ℝ) hm
    (FedAvg.inner_integrable_of_memLp (mΩ := mΩ) hX hY) (hY.integrable (by norm_num))
  have hi := integral_congr_ae h
  rw [integral_condExp hH] at hi
  exact hi

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule19
/- END Definitions.SCAFFOLD.ServerMoments -/

/- BEGIN Definitions.SCAFFOLD.BaseEnergy -/
section SCAFFOLDBundleModule20
/-!
Round-start local direction estimates for SCAFFOLD Appendix E.1, PDF pp. 28-29,
Lemma 14, and E.2, PDF pp. 33-34, Lemma 18. Stored true gradients and retained
oracle noise are separated; the whole stored control is not treated as fresh noise.
-/

noncomputable section
open MeasureTheory
open scoped BigOperators InnerProductSpace
namespace SCAFFOLD

theorem sum_shifted_controls_sq_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N : ℕ} (hN : 0 < N) (u a e : Fin N → E) :
    (∑ i, ‖u i + ((N : ℝ)⁻¹ • ∑ j, a j - a i) +
      ((N : ℝ)⁻¹ • ∑ j, e j - e i)‖ ^ 2) ≤
    4 * ∑ i, ‖u i‖ ^ 2 + 4 * ∑ i, ‖a i‖ ^ 2 + 2 * ∑ i, ‖e i‖ ^ 2 := by
  have hpoint (i : Fin N) := norm_add_sq_le_two
    (u i + ((N : ℝ)⁻¹ • ∑ j, a j - a i)) ((N : ℝ)⁻¹ • ∑ j, e j - e i)
  have hpoint' (i : Fin N) := norm_add_sq_le_two (u i) ((N : ℝ)⁻¹ • ∑ j, a j - a i)
  have hs := Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ hpoint i)
  have hs' := Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ hpoint' i)
  have ha := sum_centered_norm_sq_le hN a
  have he := sum_centered_norm_sq_le hN e
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, norm_sub_rev] at hs hs'
  nlinarith

theorem sum_const_add_centered_sq {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N : ℕ} (hN : 0 < N) (z : E) (v : Fin N → E) :
    ∑ i, ‖z + (v i - (N : ℝ)⁻¹ • ∑ j, v j)‖ ^ 2 =
      (N : ℝ) * ‖z‖ ^ 2 + ∑ i, ‖v i - (N : ℝ)⁻¹ • ∑ j, v j‖ ^ 2 := by
  simp_rw [norm_add_sq_real]
  simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul, ← Finset.mul_sum, ← inner_sum,
    sum_sub_mean_eq_zero hN, inner_zero_right, mul_zero, add_zero]

theorem sum_base_signal_sq_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {N : ℕ} (hN : 0 < N) (g a e : Fin N → E) :
    (∑ i, ‖g i + ((N : ℝ)⁻¹ • ∑ j, a j - a i) +
      ((N : ℝ)⁻¹ • ∑ j, e j - e i)‖ ^ 2) ≤
    2 * (N : ℝ) * ‖(N : ℝ)⁻¹ • ∑ i, g i‖ ^ 2 +
      2 * ∑ i, ‖g i - a i‖ ^ 2 + 2 * ∑ i, ‖e i‖ ^ 2 := by
  have hs := Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ norm_add_sq_le_two
    (g i + ((N : ℝ)⁻¹ • ∑ j, a j - a i)) ((N : ℝ)⁻¹ • ∑ j, e j - e i))
  have he := sum_centered_norm_sq_le hN e
  have hv := sum_centered_norm_sq_le hN (fun i ↦ g i - a i)
  have hid := sum_const_add_centered_sq hN ((N : ℝ)⁻¹ • ∑ i, g i)
    (fun i ↦ g i - a i)
  have hidpoint (i : Fin N) : (N : ℝ)⁻¹ • ∑ j, g j +
      ((g i - a i) - (N : ℝ)⁻¹ • ∑ j, (g j - a j)) =
      g i + ((N : ℝ)⁻¹ • ∑ j, a j - a i) := by
    simp only [Finset.sum_sub_distrib, smul_sub]
    abel
  simp_rw [hidpoint] at hid
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum, norm_sub_rev] at hs
  nlinarith

variable {d N : ℕ} {Ω : Type*} [MeasurableSpace Ω] [StandardBorelSpace Ω]
  {ν : Measure Ω} [IsProbabilityMeasure ν] {P : Problem d N}
  {S K T : ℕ} {ηl ηg : ℝ} {init : Initialization d N}

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
private theorem integral_mean_norm_sq (v : Fin N → Ω → Space d)
    (hv : ∀ i, MemLp (v i) 2 ν) :
    (∫ ω, (N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2 ∂ν) =
      (N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖v i ω‖ ^ 2 ∂ν := by
  rw [integral_const_mul, integral_finsetSum Finset.univ
    (fun i _ ↦ (hv i).norm.integrable_sq)]

omit [StandardBorelSpace Ω] [IsProbabilityMeasure ν] in
private theorem integrable_mean_norm_sq (v : Fin N → Ω → Space d)
    (hv : ∀ i, MemLp (v i) 2 ν) :
    Integrable (fun ω ↦ (N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2) ν :=
  (integrable_finsetSum Finset.univ (fun i _ ↦ (hv i).norm.integrable_sq)).const_mul _

theorem Run.mean_storedError_energy_le (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r ≤ T) :
    (N : ℝ)⁻¹ * (∑ i, ∫ ω, ‖storedError A r i ω‖ ^ 2 ∂ν) ≤ P.σ ^ 2 / K := by
  have hs := mul_le_mul_of_nonneg_left
    (Finset.sum_le_sum (s := Finset.univ) (fun i _ ↦ A.storedError_second_moment_le hr i))
    (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
  simpa only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    ← mul_assoc, inv_mul_cancel₀ hN, one_mul] using hs

theorem Run.baseEnergy_convex (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r ≤ T) {xstar : Space d} (hc : Convexity P 0)
    (hx : IsMinimizer P xstar) :
    baseEnergy A r ≤ 8 * P.β * expectedGap A xstar r +
      4 * controlEnergy A xstar r + 2 * P.σ ^ 2 / K := by
  have hmin : IsLocalMin (objective P.f) xstar := Filter.Eventually.of_forall hx
  have hgstar : gradient (objective P.f) xstar = 0 := by
    rw [gradient, hmin.fderiv_eq_zero, map_zero]
  have hstar : (N : ℝ)⁻¹ • ∑ i, gradient (P.f i) xstar = 0 := by
    rw [← P.gradient_objective, hgstar]
  let u (i : Fin N) (ω : Ω) := gradient (P.f i) (A.x r ω) - gradient (P.f i) xstar
  let a (i : Fin N) (ω : Ω) := storedSignal A r i ω - gradient (P.f i) xstar
  have ha (i : Fin N) : MemLp (a i) 2 ν :=
    (A.storedSignal_memLp hr i).sub (memLp_const _)
  have hform (ω : Ω) (i : Fin N) : u i ω + ((N : ℝ)⁻¹ • ∑ j, a j ω - a i ω) +
      ((N : ℝ)⁻¹ • ∑ j, storedError A r j ω - storedError A r i ω) =
      baseDirection A r i ω := by
    dsimp [u, a, storedError, baseDirection, meanControl]
    simp only [Finset.sum_sub_distrib, smul_sub, hstar]
    abel
  have hpoint (ω : Ω) : (N : ℝ)⁻¹ * ∑ i, ‖baseDirection A r i ω‖ ^ 2 ≤
      8 * P.β * (objective P.f (A.x r ω) - objective P.f xstar) +
      4 * ((N : ℝ)⁻¹ * ∑ i, ‖a i ω‖ ^ 2) +
      2 * ((N : ℝ)⁻¹ * ∑ i, ‖storedError A r i ω‖ ^ 2) := by
    have hs := mul_le_mul_of_nonneg_left
      (sum_shifted_controls_sq_le P.clients_pos (fun i ↦ u i ω) (fun i ↦ a i ω)
        (fun i ↦ storedError A r i ω))
      (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
    simp_rw [hform] at hs
    have hg := SCAFFOLD.GradientGrowth d N P xstar hc hx (A.x r ω)
    change (N : ℝ)⁻¹ * ∑ i, ‖u i ω‖ ^ 2 ≤ _ at hg
    nlinarith
  have hgap := A.gap_integrable xstar hr
  have haI := integrable_mean_norm_sq a ha
  have heI := integrable_mean_norm_sq (storedError A r) (A.storedError_memLp hr)
  have hbI := integrable_mean_norm_sq (baseDirection A r) (A.baseDirection_memLp hr)
  have hi := integral_mono hbI
    (((hgap.const_mul (8 * P.β)).add (haI.const_mul 4)).add (heI.const_mul 2)) hpoint
  have hfirst : Integrable (fun ω ↦
      8 * P.β * (objective P.f (A.x r ω) - objective P.f xstar) +
      4 * ((N : ℝ)⁻¹ * ∑ i, ‖a i ω‖ ^ 2)) ν :=
    (hgap.const_mul (8 * P.β)).add (haI.const_mul 4)
  simp only [Pi.add_apply] at hi
  rw [integral_add hfirst
      (heI.const_mul 2), integral_add (hgap.const_mul (8 * P.β)) (haI.const_mul 4)] at hi
  simp only [integral_const_mul] at hi
  have hba := integral_mean_norm_sq (baseDirection A r) (A.baseDirection_memLp hr)
  have haa := integral_mean_norm_sq a ha
  have hea := integral_mean_norm_sq (storedError A r) (A.storedError_memLp hr)
  simp only [integral_const_mul] at hba haa hea
  rw [hba, haa, hea] at hi
  change baseEnergy A r ≤ 8 * P.β * expectedGap A xstar r +
    4 * controlEnergy A xstar r + 2 * _ at hi
  have herr := A.mean_storedError_energy_le hr
  simp only [mul_div_assoc]
  linarith

theorem Run.signal_current_gradient_energy_le (A : Run P ν S K T ηl ηg none)
    {r : ℕ} (hr : r ≤ T) :
    (N : ℝ)⁻¹ * (∑ i, ∫ ω,
      ‖gradient (P.f i) (A.x r ω) - storedSignal A r i ω‖ ^ 2 ∂ν) ≤
        P.β ^ 2 * lagEnergy A r := by
  have hpoint (i : Fin N) (ω : Ω) :
      ‖gradient (P.f i) (A.x r ω) - storedSignal A r i ω‖ ^ 2 ≤
      P.β ^ 2 * (K : ℝ)⁻¹ * ∑ k : Fin K,
        ‖storedQuery A r k i ω - A.x r ω‖ ^ 2 := by
    rw [A.storedSignal_eq_queryMean, norm_sub_rev,
      ← Fin.sum_univ_eq_sum_range (fun k ↦ gradient (P.f i) (storedQuery A r k i ω)),
      ← average_sub_const A.steps_pos]
    apply (norm_average_sq_le A.steps_pos _).trans
    have hs := mul_le_mul_of_nonneg_left (Finset.sum_le_sum (s := Finset.univ)
      (fun (k : Fin K) _ ↦ pow_le_pow_left₀ (norm_nonneg _)
        (P.smooth i (storedQuery A r k i ω) (A.x r ω)) 2))
      (inv_nonneg.mpr (Nat.cast_nonneg K : (0 : ℝ) ≤ K))
    simpa only [mul_pow, ← Finset.mul_sum, mul_left_comm, mul_assoc] using hs
  have hint (i : Fin N) (k : Fin K) :
      Integrable (fun ω ↦ ‖storedQuery A r k i ω - A.x r ω‖ ^ 2) ν :=
    ((A.storedQuery_memLp hr k.isLt.le i).sub (A.x_memLp r hr)).norm.integrable_sq
  have hgrad (i : Fin N) := ((P.gradient_memLp_comp i (A.x_memLp r hr)).sub
    (A.storedSignal_memLp hr i)).norm.integrable_sq
  have hi (i : Fin N) := integral_mono (hgrad i)
    ((integrable_finsetSum Finset.univ (fun k _ ↦ hint i k)).const_mul
      (P.β ^ 2 * (K : ℝ)⁻¹)) (hpoint i)
  have hi' (i : Fin N) : (∫ ω,
      ‖gradient (P.f i) (A.x r ω) - storedSignal A r i ω‖ ^ 2 ∂ν) ≤
      P.β ^ 2 * (K : ℝ)⁻¹ * ∑ k : Fin K,
        ∫ ω, ‖storedQuery A r k i ω - A.x r ω‖ ^ 2 ∂ν := by
    simpa only [integral_const_mul, integral_finsetSum Finset.univ (fun k _ ↦ hint i k)]
      using hi i
  have hs := mul_le_mul_of_nonneg_left (Finset.sum_le_sum (s := Finset.univ)
    (fun i _ ↦ hi' i)) (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
  convert hs using 1
  simp only [lagEnergy, ← Finset.mul_sum, mul_inv_rev]
  have heq (i : Fin N) := Fin.sum_univ_eq_sum_range
    (fun k ↦ ∫ ω, ‖storedQuery A r k i ω - A.x r ω‖ ^ 2 ∂ν) (n := K)
  simp_rw [heq]
  ring

theorem Run.baseEnergy_nonconvex (A : Run P ν S K T ηl ηg none)
    {r : ℕ} (hr : r ≤ T) :
    baseEnergy A r ≤ 2 * (∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
      2 * P.β ^ 2 * lagEnergy A r + 2 * P.σ ^ 2 / K := by
  let g (i : Fin N) (ω : Ω) := gradient (P.f i) (A.x r ω)
  let v (i : Fin N) (ω : Ω) := g i ω - storedSignal A r i ω
  have hv (i : Fin N) : MemLp (v i) 2 ν :=
    (P.gradient_memLp_comp i (A.x_memLp r hr)).sub (A.storedSignal_memLp hr i)
  have hform (ω : Ω) (i : Fin N) : g i ω +
      ((N : ℝ)⁻¹ • ∑ j, storedSignal A r j ω - storedSignal A r i ω) +
      ((N : ℝ)⁻¹ • ∑ j, storedError A r j ω - storedError A r i ω) =
      baseDirection A r i ω := by
    dsimp [g, storedError, baseDirection, meanControl]
    simp only [Finset.sum_sub_distrib, smul_sub]
    abel
  have hpoint (ω : Ω) : (N : ℝ)⁻¹ * ∑ i, ‖baseDirection A r i ω‖ ^ 2 ≤
      2 * ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 +
      2 * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2) +
      2 * ((N : ℝ)⁻¹ * ∑ i, ‖storedError A r i ω‖ ^ 2) := by
    have hs := mul_le_mul_of_nonneg_left
      (sum_base_signal_sq_le P.clients_pos (fun i ↦ g i ω)
        (fun i ↦ storedSignal A r i ω) (fun i ↦ storedError A r i ω))
      (inv_nonneg.mpr (Nat.cast_nonneg N : (0 : ℝ) ≤ N))
    simp_rw [hform] at hs
    convert hs using 1
    have hN : (N : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt P.clients_pos
    rw [P.gradient_objective]
    dsimp [g, v]
    field_simp
  have hgI := (P.objectiveGradient_memLp_comp (A.x_memLp r hr)).norm.integrable_sq
  have hvI := integrable_mean_norm_sq v hv
  have heI := integrable_mean_norm_sq (storedError A r) (A.storedError_memLp hr)
  have hbI := integrable_mean_norm_sq (baseDirection A r) (A.baseDirection_memLp hr)
  have hi := integral_mono hbI
    (((hgI.const_mul 2).add (hvI.const_mul 2)).add (heI.const_mul 2)) hpoint
  have hfirst : Integrable (fun ω ↦
      2 * ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 +
      2 * ((N : ℝ)⁻¹ * ∑ i, ‖v i ω‖ ^ 2)) ν :=
    (hgI.const_mul 2).add (hvI.const_mul 2)
  simp only [Pi.add_apply] at hi
  rw [integral_add hfirst (heI.const_mul 2),
    integral_add (hgI.const_mul 2) (hvI.const_mul 2)] at hi
  simp only [integral_const_mul] at hi
  have hba := integral_mean_norm_sq (baseDirection A r) (A.baseDirection_memLp hr)
  have hva := integral_mean_norm_sq v hv
  have hea := integral_mean_norm_sq (storedError A r) (A.storedError_memLp hr)
  simp only [integral_const_mul] at hba hva hea
  rw [hba, hva, hea] at hi
  have herr := A.mean_storedError_energy_le hr
  have hsignal := A.signal_current_gradient_energy_le hr
  change (N : ℝ)⁻¹ * ∑ i, ∫ ω, ‖v i ω‖ ^ 2 ∂ν ≤ _ at hsignal
  change baseEnergy A r ≤ _ at hi
  simp only [mul_div_assoc]
  linarith

theorem Run.convex_drift_bound (A : Run P ν S K T ηl ηg init)
    {r : ℕ} (hr : r < T) (hg : 1 ≤ ηg)
    (ht : P.β * effectiveStep K ηl ηg ≤ 1 / 81)
    (ht0 : 0 ≤ P.β * effectiveStep K ηl ηg) {xstar : Space d}
    (hc : Convexity P 0) (hx : IsMinimizer P xstar) :
    driftEnergy A r ≤ (effectiveStep K ηl ηg) ^ 2 / ηg ^ 2 *
      (24 * P.β * expectedGap A xstar r + 12 * controlEnergy A xstar r +
        9 * P.σ ^ 2 / K) :=
  A.convex_drift_of_base hr hg ht ht0 (A.baseEnergy_convex hr.le hc hx)

theorem Run.nonconvex_drift_bound (A : Run P ν S K T ηl ηg none)
    {r : ℕ} (hr : r < T) (hg : 1 ≤ ηg)
    (ht : P.β * effectiveStep K ηl ηg ≤ 1 / 24)
    (ht0 : 0 ≤ P.β * effectiveStep K ηl ηg) :
    driftEnergy A r ≤ (effectiveStep K ηl ηg) ^ 2 / ηg ^ 2 *
      (5 * (∫ ω, ‖gradient (objective P.f) (A.x r ω)‖ ^ 2 ∂ν) +
        5 * P.β ^ 2 * lagEnergy A r + 7 * P.σ ^ 2 / K) :=
  A.nonconvex_drift_of_base hr hg ht ht0 (integral_nonneg (fun _ ↦ sq_nonneg _))
    (lagEnergy_nonneg A r) (A.baseEnergy_nonconvex hr.le)

end SCAFFOLD
end -- original EOF-open anonymous section
end SCAFFOLDBundleModule20
