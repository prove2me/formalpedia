open Polynomial

theorem CuspForm.isOrdinaryAt_of_point_of_isUnit_up_of_residual_isAbsolutelyIrreducible_of_residual_isOrdinaryAt
    (p : ℕ) [Fact p.Prime] (hp2 : p ≠ 2) (N : ℕ) [NeZero N] (S : Finset ℕ)
    (_hpS : p ∈ S) (_hNS : ∀ q : ℕ, q.Prime → q ∣ N → q ∈ S)
    (𝒪' : Type) [CommRing 𝒪'] [IsDomain 𝒪'] [IsDiscreteValuationRing 𝒪']
    [IsAdicComplete (IsLocalRing.maximalIdeal 𝒪') 𝒪'] [Finite (IsLocalRing.ResidueField 𝒪')]
    [CharZero 𝒪'] (_hp𝒪' : (p : 𝒪') ∈ IsLocalRing.maximalIdeal 𝒪')
    (χ : CuspForm.heckeAlgebra N 2 (↑S : Set ℕ) →+* 𝒪')
    (hpN : p ∣ N) (up : 𝒪')
    (hup : ∃ χ' : CuspForm.heckeAlgebra N 2 ((↑S : Set ℕ) \ {p}) →+* 𝒪',
      (∀ t : CuspForm.heckeAlgebra N 2 (↑S : Set ℕ),
        χ' (Subalgebra.inclusion (CuspForm.heckeAlgebra_mono Set.diff_subset) t) = χ t) ∧
      χ' (CuspForm.heckeAlgebra.U (Fact.out : p.Prime) hpN (by simp)) = up)
    (hunit : IsUnit up)
    (ρ : GaloisRepAdic 𝒪')
    (hirr : ρ.residual.IsAbsolutelyIrreducible)
    (hres : (GaloisRepAdic.ofResidualGaloisRep ρ.residual).IsOrdinaryAt p)
    (hfrob : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ (↑S : Set ℕ)),
        ∀ A : ValuationSubring (AlgebraicClosure ℚ), A.LiesOverPrime ℓ →
          ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, A.IsFrobeniusAt σ ℓ →
            LinearMap.charpoly (ρ.ρ σ) =
              X ^ 2 - C (χ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS)) * X + C ((ℓ : 𝒪'))) :
    ρ.IsOrdinaryAt p := by sorry
