lemma qlu_qpoch_succ (q : K) (n : ℕ) : qpoch q (n + 1) = qpoch q n * (1 - q ^ (n + 1)) := by
  simp [qpoch, Finset.prod_range_succ]

lemma qlu_qbin_zero_of_lt (q : K) : ∀ (n k : ℕ), n < k → qbin q n k = 0 := by
  intro n
  induction n with
  | zero => intro k hk; obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩; rfl
  | succ n ih =>
    intro k hk
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    show qbin q n k + q ^ (k + 1) * qbin q n (k + 1) = 0
    rw [ih k (by omega), ih (k + 1) (by omega)]; ring

lemma qlu_qbin_mul (q : K) : ∀ (n k : ℕ), k ≤ n →
    qbin q n k * qpoch q k * qpoch q (n - k) = qpoch q n := by
  intro n
  induction n with
  | zero => intro k hk; obtain rfl : k = 0 := by omega
            simp [qbin, qpoch]
  | succ n ih =>
    intro k hk
    rcases k with _ | k
    · simp [qbin, qpoch]
    · show (qbin q n k + q ^ (k + 1) * qbin q n (k + 1)) * qpoch q (k + 1) * qpoch q (n + 1 - (k + 1))
          = qpoch q (n + 1)
      rcases Nat.eq_or_lt_of_le (show k ≤ n by omega) with h | h
      · subst h
        rw [qlu_qbin_zero_of_lt q k (k + 1) (by omega)]
        have := ih k le_rfl
        simp only [Nat.sub_self] at this ⊢
        rw [qlu_qpoch_succ]
        simp [qpoch] at this ⊢
        linear_combination (1 - q ^ (k + 1)) * this
      · obtain ⟨m, rfl⟩ : ∃ m, n = k + 1 + m := ⟨n - (k + 1), by omega⟩
        have h1 := ih k (by omega)
        have h2 := ih (k + 1) (by omega)
        have e1 : k + 1 + m - k = m + 1 := by omega
        have e2 : k + 1 + m - (k + 1) = m := by omega
        have e3 : k + 1 + m + 1 - (k + 1) = m + 1 := by omega
        rw [e1] at h1; rw [e2] at h2; rw [e3]
        rw [qlu_qpoch_succ q k] at h2 ⊢
        rw [qlu_qpoch_succ q m] at h1 ⊢
        rw [qlu_qpoch_succ q (k + 1 + m)]
        linear_combination (1 - q ^ (k + 1)) * h1 + q ^ (k + 1) * (1 - q ^ (m + 1)) * h2

lemma qlu_qfall (q : K) (b : ℕ) : ∀ k : ℕ, qpoch q (k + b) = qpoch q b * qfall q (k + b) k := by
  intro k
  induction k with
  | zero => simp [qfall]
  | succ k ih =>
    have : qfall q (k + 1 + b) (k + 1) = (1 - q ^ (k + b + 1)) * qfall q (k + b) k := by
      unfold qfall
      rw [Finset.prod_range_succ']
      rw [mul_comm]
      congr 1
      · congr 2; omega
      · apply Finset.prod_congr rfl
        intro i hi
        congr 2
        omega
    rw [this, show k + 1 + b = (k + b) + 1 by omega, qlu_qpoch_succ, ih]; ring

lemma qlu_qfall_zero (q : K) (v k : ℕ) (h : v < k) : qfall q v k = 0 := by
  unfold qfall
  apply Finset.prod_eq_zero (i := v) (by simp; omega)
  simp

lemma qlu_term (x z : K) (hz : z ≠ 0) (k a b : ℕ) (hk : qpoch (x ^ 2) k ≠ 0)
    (ha : qpoch (x ^ 2) a ≠ 0) (hb : qpoch (x ^ 2) b ≠ 0) :
    qpoch (x ^ 2) (k + a) * (bP x z⁻¹ a * (qpoch (x ^ 2) k)⁻¹ * bP x z b) * qpoch (x ^ 2) (k + b)
      = x ^ ((((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs ^ 2) *
          z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) *
          (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) := by
  have h1 := qlu_qbin_mul (x ^ 2) (k + a) k (by omega)
  rw [Nat.add_sub_cancel_left] at h1
  have h2 := qlu_qfall (x ^ 2) b k
  set N := (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)).natAbs with hNdef
  have hN0 : (N : ℤ) ^ 2 = ((b : ℤ) - a) ^ 2 := by
    rw [hNdef, Int.natAbs_sq]; push_cast; ring
  have hN : N ^ 2 + 2 * (a * b) = a ^ 2 + b ^ 2 := by
    zify; linear_combination hN0
  have hx : x ^ (N ^ 2) * (x ^ 2) ^ (a * b) = x ^ (a ^ 2) * x ^ (b ^ 2) := by
    rw [← pow_mul, ← pow_add, ← pow_add, hN]
  have hzz : z ^ (((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ)) = z ^ b * (z ^ a)⁻¹ := by
    rw [show ((k + b : ℕ) : ℤ) - ((k + a : ℕ) : ℤ) = (b : ℤ) - (a : ℤ) by push_cast; ring,
      zpow_sub₀ hz, zpow_natCast, zpow_natCast, div_eq_mul_inv]
  rw [hzz, ← h1, h2]
  unfold bP
  rw [show x ^ (N ^ 2) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k * (x ^ 2) ^ (a * b)) =
      (x ^ (N ^ 2) * (x ^ 2) ^ (a * b)) * (z ^ b * (z ^ a)⁻¹) *
      (qbin (x ^ 2) (k + a) k * qfall (x ^ 2) (k + b) k) by ring, hx]
  rw [inv_pow]
  field_simp

theorem qlu_main (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    gaussToep x z n =
      Gam (x ^ 2) n * lowT (bP x z⁻¹) * GamInv (x ^ 2) n * upT (bP x z) * Gam (x ^ 2) n := by
  ext ⟨u, hu⟩ ⟨v, hv⟩
  simp only [Gam, GamInv]
  rw [mul_diagonal, mul_apply]
  simp only [mul_diagonal, diagonal_mul, gaussToep, lowT, upT]
  rw [Finset.sum_mul, Fin.sum_univ_eq_sum_range (fun k : ℕ =>
    (qpoch (x ^ 2) u * if k ≤ u then bP x z⁻¹ (u - k) else 0) * (qpoch (x ^ 2) k)⁻¹ *
      (if k ≤ v then bP x z (v - k) else 0) * qpoch (x ^ 2) v) n]
  rw [← Finset.sum_subset (range_subset_range.2 (show u + 1 ≤ n by omega)) ?_]
  · conv_lhs => rw [← mul_one (_ * _), ← qpascal_identity (x ^ 2) u v, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro k hk
    rw [mem_range] at hk
    rw [if_pos (by omega)]
    by_cases hkv : k ≤ v
    · rw [if_pos hkv]
      obtain ⟨a, rfl⟩ : ∃ a, u = k + a := ⟨u - k, by omega⟩
      obtain ⟨b, rfl⟩ : ∃ b, v = k + b := ⟨v - k, by omega⟩
      simp only [Nat.add_sub_cancel_left]
      rw [← qlu_term x z hz k a b (hq k (by omega)) (hq a (by omega)) (hq b (by omega))]
      ring
    · rw [if_neg hkv, qlu_qfall_zero _ _ _ (by omega)]; ring
  · intro k hk hk'
    simp only [mem_range] at hk hk'
    rw [if_neg (by omega)]; ring

lemma qlu_alt (x : K) (h : ℕ) :
    ∑ j ∈ range (h + 2), (-1 : K) ^ j * x ^ (j * (j - 1)) * qbin (x ^ 2) (h + 1) j = 0 := by
  set g : ℕ → K := fun j => (-1 : K) ^ j * x ^ (j * (j + 1)) * qbin (x ^ 2) h j with hg
  have hf : ∀ j : ℕ, (-1 : K) ^ (j + 1) * x ^ ((j + 1) * (j + 1 - 1)) * qbin (x ^ 2) (h + 1) (j + 1)
      = g (j + 1) - g j := by
    intro j
    simp only [hg, Nat.add_sub_cancel]
    show (-1 : K) ^ (j + 1) * x ^ ((j + 1) * j) *
        (qbin (x ^ 2) h j + (x ^ 2) ^ (j + 1) * qbin (x ^ 2) h (j + 1)) = _
    have e : x ^ ((j + 1) * j) * (x ^ 2) ^ (j + 1) = x ^ ((j + 1) * (j + 1 + 1)) := by
      rw [← pow_mul, ← pow_add]; congr 1; ring
    have e2 : x ^ ((j + 1) * j) = x ^ (j * (j + 1)) := by rw [mul_comm]
    rw [← e, e2]; ring
  rw [Finset.sum_range_succ', Finset.sum_congr rfl (fun j _ => hf j), Finset.sum_range_sub]
  simp only [hg, qlu_qbin_zero_of_lt (x ^ 2) h (h + 1) (by omega)]
  simp [qbin]

lemma qlu_conv_term (x w : K) (m r : ℕ) (hm : qpoch (x ^ 2) m ≠ 0) (hr : qpoch (x ^ 2) r ≠ 0)
    (hmr : qpoch (x ^ 2) (m + r) ≠ 0) :
    bP x w m * aP x w r = (-(x * w)) ^ (m + r) / qpoch (x ^ 2) (m + r) *
      ((-1 : K) ^ m * x ^ (m * (m - 1)) * qbin (x ^ 2) (m + r) m) := by
  have h1 := qlu_qbin_mul (x ^ 2) (m + r) m (by omega)
  rw [Nat.add_sub_cancel_left] at h1
  have hkey : x ^ (m ^ 2) * w ^ m = (-(x * w)) ^ m * ((-1 : K) ^ m * x ^ (m * (m - 1))) := by
    have : (-(x * w)) ^ m * (-1 : K) ^ m = (x * w) ^ m := by
      rw [← mul_pow]; congr 1; ring
    rw [← mul_assoc, this, mul_pow]
    rcases m with _ | m
    · simp
    · rw [Nat.add_sub_cancel, show (m + 1) ^ 2 = (m + 1) + (m + 1) * m by ring, pow_add]; ring
  have hb : qbin (x ^ 2) (m + r) m ≠ 0 := by
    intro h0; rw [h0] at h1; simp at h1; exact hmr h1.symm
  unfold bP aP
  rw [pow_add (-(x * w)) m r, ← h1]
  calc x ^ (m ^ 2) * w ^ m / qpoch (x ^ 2) m * ((-(x * w)) ^ r / qpoch (x ^ 2) r)
      = (x ^ (m ^ 2) * w ^ m) * (-(x * w)) ^ r / (qpoch (x ^ 2) m * qpoch (x ^ 2) r) := by
        rw [div_mul_div_comm]
    _ = ((-(x * w)) ^ m * ((-1 : K) ^ m * x ^ (m * (m - 1)))) * (-(x * w)) ^ r /
          (qpoch (x ^ 2) m * qpoch (x ^ 2) r) := by rw [hkey]
    _ = _ := by field_simp

lemma qlu_conv (x w : K) (h : ℕ) (hq : ∀ i ≤ h, qpoch (x ^ 2) i ≠ 0) :
    conv (bP x w) (aP x w) h = delta0 h := by
  rcases h with _ | h
  · simp [conv, bP, aP, delta0, qpoch]
  · unfold conv
    calc ∑ m ∈ range (h + 1 + 1), bP x w m * aP x w (h + 1 - m)
        = ∑ m ∈ range (h + 2), (-(x * w)) ^ (h + 1) / qpoch (x ^ 2) (h + 1) *
            ((-1 : K) ^ m * x ^ (m * (m - 1)) * qbin (x ^ 2) (h + 1) m) := by
          apply Finset.sum_congr rfl
          intro m hm
          rw [mem_range] at hm
          have := qlu_conv_term x w m (h + 1 - m) (hq m (by omega)) (hq _ (by omega))
            (by rw [show m + (h + 1 - m) = h + 1 by omega]; exact hq _ le_rfl)
          rwa [show m + (h + 1 - m) = h + 1 by omega] at this
      _ = 0 := by rw [← Finset.mul_sum, qlu_alt, mul_zero]
      _ = delta0 (h + 1) := by simp [delta0]

lemma qlu_lowT_mul (c d : ℕ → K) (n : ℕ) :
    (lowT c : Matrix (Fin n) (Fin n) K) * lowT d = lowT (conv c d) := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [mul_apply, lowT]
  rw [Fin.sum_univ_eq_sum_range (fun k => (if k ≤ i then c (i - k) else 0) *
    (if j ≤ k then d (k - j) else 0)) n]
  split_ifs with hji
  · rw [← Finset.sum_subset (range_subset_range.2 (show i + 1 ≤ n by omega)) ?_]
    · rw [← Finset.sum_range_reflect]
      unfold conv
      rw [← Finset.sum_subset (range_subset_range.2 (show i - j + 1 ≤ i + 1 by omega)) ?_]
      · apply Finset.sum_congr rfl
        intro m hm
        rw [mem_range] at hm
        rw [if_pos (by omega), if_pos (by omega)]
        congr 2 <;> omega
      · intro m hm hm'
        simp only [mem_range] at hm hm'
        split_ifs <;> first | (exfalso; omega) | simp
    · intro k hk hk'
      simp only [mem_range] at hk hk'
      rw [if_neg (by omega)]; ring
  · apply Finset.sum_eq_zero
    intro k _
    split_ifs <;> first | (exfalso; omega) | simp

lemma qlu_upT_mul (c d : ℕ → K) (n : ℕ) :
    (upT c : Matrix (Fin n) (Fin n) K) * upT d = upT (conv c d) := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [mul_apply, upT]
  rw [Fin.sum_univ_eq_sum_range (fun k => (if i ≤ k then c (k - i) else 0) *
    (if k ≤ j then d (j - k) else 0)) n]
  split_ifs with hij
  · rw [← Finset.sum_subset (range_subset_range.2 (show j + 1 ≤ n by omega)) ?_]
    · rw [show j + 1 = i + (j - i + 1) by omega, Finset.sum_range_add]
      rw [Finset.sum_eq_zero (s := range i), zero_add]
      · unfold conv
        apply Finset.sum_congr rfl
        intro m hm
        rw [mem_range] at hm
        rw [if_pos (by omega), if_pos (by omega)]
        congr 2 <;> omega
      · intro k hk
        rw [mem_range] at hk
        rw [if_neg (by omega)]; ring
    · intro k hk hk'
      simp only [mem_range] at hk hk'
      rw [if_neg (show ¬ k ≤ j by omega)]; ring
  · apply Finset.sum_eq_zero
    intro k _
    split_ifs <;> first | (exfalso; omega) | simp

lemma qlu_lowT_one (c : ℕ → K) (n : ℕ) (h : ∀ k < n, c k = delta0 k) :
    (lowT c : Matrix (Fin n) (Fin n) K) = 1 := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [lowT, one_apply, Fin.mk.injEq]
  split_ifs with h1 h2 h2
  · rw [h _ (by omega)]; simp [delta0]; omega
  · rw [h _ (by omega)]; simp [delta0]; omega
  · omega
  · rfl

lemma qlu_upT_one (c : ℕ → K) (n : ℕ) (h : ∀ k < n, c k = delta0 k) :
    (upT c : Matrix (Fin n) (Fin n) K) = 1 := by
  ext ⟨i, hi⟩ ⟨j, hj⟩
  simp only [upT, one_apply, Fin.mk.injEq]
  split_ifs with h1 h2 h2
  · rw [h _ (by omega)]; simp [delta0]; omega
  · rw [h _ (by omega)]; simp [delta0]; omega
  · omega
  · rfl

theorem qlu_inv_main (x z : K) (n : ℕ) (hz : z ≠ 0) (hq : ∀ i < n, qpoch (x ^ 2) i ≠ 0) :
    (gaussToep x z n)⁻¹ =
      GamInv (x ^ 2) n * upT (aP x z) * Gam (x ^ 2) n * lowT (aP x z⁻¹) * GamInv (x ^ 2) n := by
  have hT := qlu_main x z n hz hq
  have hΓ : Gam (x ^ 2) n * GamInv (x ^ 2) n = 1 := by
    rw [Gam, GamInv, diagonal_mul_diagonal, ← diagonal_one]
    congr 1; funext i; exact mul_inv_cancel₀ (hq i i.isLt)
  have hΓ' : GamInv (x ^ 2) n * Gam (x ^ 2) n = 1 := by
    rw [Gam, GamInv, diagonal_mul_diagonal, ← diagonal_one]
    congr 1; funext i; exact inv_mul_cancel₀ (hq i i.isLt)
  have hL : (lowT (bP x z⁻¹) : Matrix (Fin n) (Fin n) K) * lowT (aP x z⁻¹) = 1 := by
    rw [qlu_lowT_mul]; apply qlu_lowT_one
    intro k hk; exact qlu_conv x z⁻¹ k (fun i hi => hq i (by omega))
  have hU : (upT (bP x z) : Matrix (Fin n) (Fin n) K) * upT (aP x z) = 1 := by
    rw [qlu_upT_mul]; apply qlu_upT_one
    intro k hk; exact qlu_conv x z k (fun i hi => hq i (by omega))
  apply Matrix.inv_eq_right_inv
  rw [hT]
  simp only [Matrix.mul_assoc]
  rw [← Matrix.mul_assoc (Gam (x ^ 2) n) (GamInv (x ^ 2) n), hΓ, Matrix.one_mul,
    ← Matrix.mul_assoc (upT (bP x z)) (upT (aP x z)), hU, Matrix.one_mul,
    ← Matrix.mul_assoc (GamInv (x ^ 2) n) (Gam (x ^ 2) n), hΓ', Matrix.one_mul,
    ← Matrix.mul_assoc (lowT (bP x z⁻¹)) (lowT (aP x z⁻¹)), hL, Matrix.one_mul, hΓ]

