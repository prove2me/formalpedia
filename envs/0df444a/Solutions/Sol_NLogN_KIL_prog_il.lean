lemma length_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).length = 4 * m + 3 * (pivots W).length := by
  have h3 : ∀ ps : List (Fin m × Fin m), (addSteps ps : List (AModel.Step (m + m) Q)).length =
