open Real

namespace ExactVacuumAtlas.RNDeriv

/-- `d/du [K u + L + N/u] = K - N/u²`. -/
theorem affine_add_div (K L N r : ℝ) (hr : r ≠ 0) :
    HasDerivAt (fun u => K * u + L + N / u) (K - N / r ^ 2) r :=
  ((Deriv.affine K L r).fun_add (Deriv.div_self_prime N r hr)).congr_deriv (by ring)

end ExactVacuumAtlas.RNDeriv

