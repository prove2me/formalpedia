        MemoryFrame (rootSeedWritable Q0 cap t) m m') := by
  have hmul : cap ≤ t * cap := by simpa only [Nat.one_mul] using Nat.mul_le_mul_right cap ht
  have hQ0Word : Q0 < 2 ^ E.W := by omega
  have hSrcWord : src < 2 ^ E.W := by omega
