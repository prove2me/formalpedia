-- title:
--   Theorem 3.2 (Verification Theorem), p. 933 — the feedback policy generated by a DP minimizer is optimal, and v_0 = min_U J_0
-- statement:
--   Consider the Markov-modulated inventory model of Sethi and Cheng under the standing assumptions of §2. Let $\hat u_n(i,x)$, $n \in \langle 0, N-1\rangle$, be functions in $B_0$ attaining the infimum in the dynamic programming equation (3.2), and let $\hat U = (\hat u_0, \dots, \hat u_{N-1})$ be the policy they generate by (3.3):
--   $$\hat u_k = \hat u_k(i_k, \hat x_k), \qquad \hat x_{k+1} = \hat x_k + \hat u_k - \xi_k, \qquad \hat x_0 = x,\ i_0 = i.$$
--   Then for every initial state $i$ and surplus $x$:
--   1. $\hat U$ is an admissible decision;
--   2. it is optimal among all admissible history-dependent decisions,
--   $$J_0(i,x;\hat U) = v_0(i,x) = \min_{U \in \mathcal U} J_0(i,x;U); \qquad (3.4)$$
--   3. this optimal value equals the value $v_0(i,x)$ computed by the dynamic programming equations (3.2).
--
--   Together with Theorem 3.1 this shows that an optimal policy exists and can be taken to be of feedback (Markov) form.
--
--   **Formalization Note** $v_0$ in (3.4) is the value function (2.5), an infimum of the expected cost over all admissible history-dependent policies in $[0,\infty]$. The theorem identifies it with the solution of (3.2), which in Lean is a separate, real-valued object.
-- source:
--   Sethi and Cheng, Optimality of (s, S) policies in inventory models with Markovian demand, Oper. Res. 45(6) (1997), DOI 10.1287/opre.45.6.931, p. 933, Theorem 3.2 and (3.3)–(3.4)

import Mathlib
import Definitions.Def_BertsekasKConvex
import Definitions.Def_SethiChengSS_Finite_KConvexity
import Definitions.Def_SethiChengSS_Finite_Model
open MeasureTheory Filter Topology
open scoped ENNReal

namespace SethiChengSS.Finite

/-- Theorem 3.2 (Verification Theorem; Sethi–Cheng 1997, p. 933): if `û_n` (`n < N`) is in
`B_0` and attains the infimum in (3.2), then the policy `Û` it generates by (3.3) is admissible
and optimal among all admissible history-dependent policies, and (3.4)
`v_0(i, x) = min_U J_0(i, x, U)` holds, the common value being the DP function `v_0(i, x)`. -/
theorem theorem_3_2 {L : ℕ} (D : Data L) (N : ℕ) (hS : Standing D)
    (û : ℕ → Fin L → ℝ → ℝ) (hB0 : ∀ n < N, InB0 (û n))
    (hmin : ∀ n < N, ∀ i x,
      orderCost D n i (û n i x) + F D n (dpV D N (n + 1)) i (x + û n i x) =
        ⨅ u : {u : ℝ // 0 ≤ u}, (orderCost D n i u + F D n (dpV D N (n + 1)) i (x + u))) :
    ∀ i x, Admissible N (feedback û 0 x) ∧
      J D N 0 i x (feedback û 0 x) = value D N 0 i x ∧
      value D N 0 i x = ENNReal.ofReal (dpV D N 0 i x) := by sorry

end SethiChengSS.Finite
