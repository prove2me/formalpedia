variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] {p n : ℕ}

/-- Rational rows embedded in the standard Euclidean space. -/
def euclideanRow (b : Fin n → ℚ) : EuclideanSpace ℝ (Fin n) :=
  WithLp.toLp 2 (fun i => (b i : ℝ))

