    (hne : GGl k r z z' g ≠ 0) :
    ∃ (e' e'' : Fin (2 * r + k + 1) → ℂ) (Bs : Fin (k - 1) → Fin (2 * r + k + 1) → ℂ),
      (inWb k r e' ∧ herm (Hpk k r) e' z' = 0 ∧ herm (Hpk k r) e' e' = 1) ∧
      (inWb k r e'' ∧ herm (Hpk k r) e'' z = 0 ∧ herm (Hpk k r) e'' e'' = 1) ∧
      IsFrameOf k r [z', e'] Bs ∧ IsFrameOf k r [g⁻¹ *ᵥ z, z'] Bs ∧
      IsFrameOf k r [z, e''] (fun a => g *ᵥ Bs a) := by sorry
