      intro A B hAB d hfinB
      refine Finite.of_injective (fun s : MulAction.stabilizer (↥A) d =>
        (⟨⟨(s.1 : PGL(2, ↥(ValuationSubring.ratClosure A₂))), hAB s.1.2⟩, s.2⟩ : MulAction.stabilizer (↥B) d)) ?_
      intro s t h
      apply Subtype.ext; apply Subtype.ext
      have := congrArg (fun u : MulAction.stabilizer (↥B) d => ((u.1 : ↥B) : PGL(2, ↥(ValuationSubring.ratClosure A₂)))) h
      exact this
    intro j d
    cases j with
    | none => exact hinj _ _ (hle none) d (hstN d).1
    | some ℓ => exact hinj _ _ (hle (some ℓ)) d (hstL ℓ d).1

  have hAL := CerednikDrinfeld.CosetGraph.atkinLehner_relations_levelGroups_place hN hqN hq'N hqq' hq5 hq'5
    q q' (by assumption) (by assumption) (by first | exact hqq' | exact (Ne.symm hqq')) hdef₁ Λ₁ R₁ hΛ₁ hR₁ hRΛ₁
    n₁ hn₁ v₂ hv₂ s₂ sf₂ hs₂ Γ₂ hΓ₂0 hΓ₂ℓ w₂ wbar₂ hw₂ hwbar₂

  have hnormimg : ∀ (j : HeckeTower.Obj q q') (x : (ℍ[ℚ, a₁, b₁])ˣ), (Γ₂ j).map (MulAut.conj x).toMonoidHom = Γ₂ j →
      ∀ d : PGL(2, ↥(ValuationSubring.ratClosure A₂)), d ∈ (Γ₂ j).map ρ₂ ↔ (ρ₂ x)⁻¹ * d * ρ₂ x ∈ (Γ₂ j).map ρ₂ := by
    intro j x hx d
    have hx1 : ∀ y, y ∈ Γ₂ j → x * y * x⁻¹ ∈ Γ₂ j := fun y hy => by
      rw [← hx]; exact ⟨y, hy, rfl⟩
    have hx2 : ∀ y, y ∈ Γ₂ j → x⁻¹ * y * x ∈ Γ₂ j := fun y hy => by
      have : y ∈ (Γ₂ j).map (MulAut.conj x).toMonoidHom := by rw [hx]; exact hy
      obtain ⟨z, hz, hzy⟩ := this
      rw [MulEquiv.coe_toMonoidHom, MulAut.conj_apply] at hzy
      rw [← hzy]; group; exact hz
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨x⁻¹ * y * x, hx2 y hy, by rw [map_mul, map_mul, map_inv]⟩
    · rintro ⟨z, hz, hzd⟩
      refine ⟨x * z * x⁻¹, hx1 z hz, ?_⟩
      rw [map_mul, map_mul, map_inv, hzd]; group

  have hρc : ρ₂ (Units.map (algebraMap ℚ ℍ[ℚ, a₁, b₁]).toMonoidHom
      (Units.mk0 (q' : ℚ) (Nat.cast_ne_zero.mpr (Fact.out : q'.Prime).ne_zero))) = 1 := by
    rw [hρ₂]
    have : Units.map (ι₂ : ℍ[ℚ, a₁, b₁] →* Matrix (Fin 2) (Fin 2) ↥(ValuationSubring.ratClosure A₂))
        (Units.map (algebraMap ℚ ℍ[ℚ, a₁, b₁]).toMonoidHom (Units.mk0 (q' : ℚ) (Nat.cast_ne_zero.mpr (Fact.out : q'.Prime).ne_zero))) =
        Matrix.GeneralLinearGroup.scalar (Fin 2) (Units.map (algebraMap ℚ ↥(ValuationSubring.ratClosure A₂)).toMonoidHom
          (Units.mk0 (q' : ℚ) (Nat.cast_ne_zero.mpr (Fact.out : q'.Prime).ne_zero))) := by
      ext i k
      simp [Matrix.GeneralLinearGroup.scalar]
    rw [this, Matrix.ProjGenLinGroup.mk_scalar]

  have hrel_img : ∀ j : HeckeTower.Obj q q',
      ρ₂ (w₂ j) * ρ₂ (w₂ j) ∈ (Γ₂ j).map ρ₂ ∧ ρ₂ (wbar₂ j) * ρ₂ (wbar₂ j) ∈ (Γ₂ j).map ρ₂ ∧
      ρ₂ (w₂ j) * ρ₂ (wbar₂ j) * (ρ₂ (w₂ j))⁻¹ * (ρ₂ (wbar₂ j))⁻¹ ∈ (Γ₂ j).map ρ₂ := by
    intro j
    refine ⟨?_, ?_, ?_⟩
    · rw [← map_mul]; exact Subgroup.mem_map_of_mem ρ₂ (hAL j).2.2.1
    · have h5 := Subgroup.mem_map_of_mem ρ₂ (hAL j).2.2.2.2.1
      rw [map_mul, map_inv, hρc, inv_one, one_mul, map_mul] at h5
      exact h5
    · have h4 := Subgroup.mem_map_of_mem ρ₂ (hAL j).2.2.2.1
      simpa only [map_mul, map_inv] using h4

  have horbV : ∀ (j : HeckeTower.Obj q q') (x : PGL(2, ↥(ValuationSubring.ratClosure A₂))), x ∈ (Γ₂ j).map ρ₂ → ∀ v : LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂),
      (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) (x • v) : Mumford.QuotVert ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) v :=
    fun j x hx v => Quotient.sound ((hrelV _ _ _).2 ⟨x, hx, rfl⟩)

  have hz2 : ∀ x y : Multiplicative (ZMod 2), (x * y = 1 ↔ (x = 1 ↔ y = 1)) := by decide
  have liftχ : ∀ (H : Type) [Group H] (h₀ : H), h₀ * h₀ = 1 →
      ∃ f : ↥(A₂.decompositionSubgroup ℚ) →* H, ∀ τ, f τ = if χ₂ τ = 1 then 1 else h₀ := by
    intro H _ h₀ hh
    refine ⟨{ toFun := fun τ => if χ₂ τ = 1 then 1 else h₀, map_one' := by simp, map_mul' := ?_ }, fun τ => rfl⟩
    intro a b
    simp only [map_mul]
    by_cases ha : χ₂ a = 1 <;> by_cases hb : χ₂ b = 1
    · rw [if_pos ((hz2 _ _).2 (iff_of_true ha hb)), if_pos ha, if_pos hb, one_mul]
    · rw [if_neg (fun h => hb (((hz2 _ _).1 h).1 ha)), if_pos ha, if_neg hb, one_mul]
    · rw [if_neg (fun h => ha (((hz2 _ _).1 h).2 hb)), if_neg ha, if_pos hb, mul_one]
    · rw [if_pos ((hz2 _ _).2 (iff_of_false ha hb)), if_neg ha, if_neg hb, hh]

  have πVdata : ∀ j : HeckeTower.Obj q q', ∃ F : S₂ →* Equiv.Perm (V j),
      (∀ v : LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂), F σ₀₂ (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) v) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) (ρ₂ (w₂ j) • v)) ∧
      (∀ v : LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂), F σ₁₂ (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) v) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (LT.LatticeTree.Vertex R₀ ↥(ValuationSubring.ratClosure A₂))) (ρ₂ (wbar₂ j) • v)) ∧
      (∀ τ, χ₂ τ = 1 → F (ιS₂ τ) = 1) ∧ (∀ τ, χ₂ τ ≠ 1 → F (ιS₂ τ) = F σ₀₂) := by
    intro j
    obtain ⟨h₀, hh₀, hh₀'⟩ := mkPermV ((Γ₂ j).map ρ₂) (ρ₂ (w₂ j)) (hnormimg j (w₂ j) (hAL j).1)
    obtain ⟨h₁, hh₁, hh₁'⟩ := mkPermV ((Γ₂ j).map ρ₂) (ρ₂ (wbar₂ j)) (hnormimg j (wbar₂ j) (hAL j).2.1)
    obtain ⟨hsq0, hsq1, hcomm⟩ := hrel_img j
    have e00 : h₀ * h₀ = 1 := by
      ext x; induction x using Quotient.inductionOn with
      | h v => show h₀ (h₀ (Quotient.mk _ v)) = Quotient.mk _ v
               rw [hh₀, hh₀, smul_smul]; exact horbV j _ hsq0 v
    have e11 : h₁ * h₁ = 1 := by
      ext x; induction x using Quotient.inductionOn with
      | h v => show h₁ (h₁ (Quotient.mk _ v)) = Quotient.mk _ v
               rw [hh₁, hh₁, smul_smul]; exact horbV j _ hsq1 v
    have e01 : h₀ * h₁ = h₁ * h₀ := by
      ext x; induction x using Quotient.inductionOn with
      | h v => show h₀ (h₁ (Quotient.mk _ v)) = h₁ (h₀ (Quotient.mk _ v))
               rw [hh₁, hh₀, hh₀, hh₁, smul_smul, smul_smul]
               have : ρ₂ (w₂ j) * ρ₂ (wbar₂ j) = (ρ₂ (w₂ j) * ρ₂ (wbar₂ j) * (ρ₂ (w₂ j))⁻¹ * (ρ₂ (wbar₂ j))⁻¹) * (ρ₂ (wbar₂ j) * ρ₂ (w₂ j)) := by group
               rw [this, mul_smul]; exact horbV j _ hcomm _
    obtain ⟨f, hf⟩ := liftχ (Equiv.Perm (V j)) h₀ e00
    have hf0 : ∀ τ, f τ * h₀ = h₀ * f τ := fun τ => by
      rw [hf]; by_cases h : χ₂ τ = 1 <;> simp only [h, if_true, if_false, one_mul, mul_one]
    have hf1 : ∀ τ, f τ * h₁ = h₁ * f τ := fun τ => by
      rw [hf]; by_cases h : χ₂ τ = 1
      · simp only [h, if_true, one_mul, mul_one]
      · simp only [h, if_false]; exact e01
    obtain ⟨F, hFι, hF0, hF1⟩ := huniv₂ (Equiv.Perm (V j)) f h₀ h₁ e00 e11 e01 hf0 hf1
    refine ⟨F, fun v => by rw [hF0]; exact hh₀ v, fun v => by rw [hF1]; exact hh₁ v, fun τ hτ => ?_, fun τ hτ => ?_⟩
    · rw [hFι, hf, if_pos hτ]
    · rw [hFι, hf, if_neg hτ, hF0]
  choose πV₂ hπV0 hπV1 hπVe hπVo using πVdata

  have horbD : ∀ (j : HeckeTower.Obj q q') (x : PGL(2, ↥(ValuationSubring.ratClosure A₂))), x ∈ (Γ₂ j).map ρ₂ → ∀ d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart,
      (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) (x • d) : Mumford.QuotEdge ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) d :=
    fun j x hx d => Quotient.sound ((hrelD _ _ _).2 ⟨x, hx, rfl⟩)
  have houtrel : ∀ (j : HeckeTower.Obj q q') (d : (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart), ∃ x : PGL(2, ↥(ValuationSubring.ratClosure A₂)), x ∈ (Γ₂ j).map ρ₂ ∧
      (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) d : Mumford.QuotEdge ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))).out = x • d :=
    fun j d => (hrelD _ _ _).1 (Quotient.mk_out d)
  have hwT : ∀ j : HeckeTower.Obj q q', ρ₂ (w₂ j) ∉ Mumford.typePreserving PGL(2, ↥(ValuationSubring.ratClosure A₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) (LT.LatticeTree.stdVertex R₀ ↥(ValuationSubring.ratClosure A₂)) := hwodd
  have hwbT : ∀ j : HeckeTower.Obj q q', ρ₂ (wbar₂ j) ∈ Mumford.typePreserving PGL(2, ↥(ValuationSubring.ratClosure A₂)) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)) (LT.LatticeTree.stdVertex R₀ ↥(ValuationSubring.ratClosure A₂)) := by
    intro j
    apply (hTP _).1
    rw [hT']
    have hq'val : padicValRat q ((q' : ℕ) : ℚ) = 0 := by
      rw [← Nat.cast_id (q' : ℕ), padicValRat.of_nat]
      have hne : ¬ q ∣ q' := fun hd => absurd ((Nat.prime_dvd_prime_iff_eq Fact.out Fact.out).mp hd) (by first | exact hqq' | exact Ne.symm hqq')
      simp [padicValNat.eq_zero_of_not_dvd hne]
    cases j with
    | none => rw [hwbar₂.1.1, hq'val]; exact Even.zero
    | some ℓ => rw [(hwbar₂.2 ℓ).1, hq'val]; exact Even.zero
  have πEdata : ∀ j : HeckeTower.Obj q q', ∃ F : S₂ →* Equiv.Perm (E j),
      (∀ e : E j, ((F σ₀₂ e).1 : Mumford.QuotEdge ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) (ρ₂ (w₂ j) • e.1.out).symm) ∧
      (∀ e : E j, ((F σ₁₂ e).1 : Mumford.QuotEdge ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))) =
        Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) (ρ₂ (wbar₂ j) • e.1.out)) ∧
      (∀ τ, χ₂ τ = 1 → F (ιS₂ τ) = 1) ∧ (∀ τ, χ₂ τ ≠ 1 → F (ιS₂ τ) = F σ₀₂) := by
    intro j
    obtain ⟨h₀, -, hh₀⟩ := mkPermE ((Γ₂ j).map ρ₂) (hIMG1 j) (ρ₂ (w₂ j)) (hnormimg j (w₂ j) (hAL j).1)
    obtain ⟨h₁, hh₁, -⟩ := mkPermE ((Γ₂ j).map ρ₂) (hIMG1 j) (ρ₂ (wbar₂ j)) (hnormimg j (wbar₂ j) (hAL j).2.1)
    have hh₀ := hh₀ (hwT j)
    have hh₁ := hh₁ (hwbT j)
    obtain ⟨hsq0, hsq1, hcomm⟩ := hrel_img j

    have hconj0 : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₂)), x ∈ (Γ₂ j).map ρ₂ → ρ₂ (w₂ j) * x * (ρ₂ (w₂ j))⁻¹ ∈ (Γ₂ j).map ρ₂ := fun x hx => by
      rw [hnormimg j (w₂ j) (hAL j).1]; have e0 : (ρ₂ (w₂ j))⁻¹ * (ρ₂ (w₂ j) * x * (ρ₂ (w₂ j))⁻¹) * ρ₂ (w₂ j) = x := by group
      rw [e0]; exact hx
    have hconj1 : ∀ x : PGL(2, ↥(ValuationSubring.ratClosure A₂)), x ∈ (Γ₂ j).map ρ₂ → ρ₂ (wbar₂ j) * x * (ρ₂ (wbar₂ j))⁻¹ ∈ (Γ₂ j).map ρ₂ := fun x hx => by
      rw [hnormimg j (wbar₂ j) (hAL j).2.1]; have e0 : (ρ₂ (wbar₂ j))⁻¹ * (ρ₂ (wbar₂ j) * x * (ρ₂ (wbar₂ j))⁻¹) * ρ₂ (wbar₂ j) = x := by group
      rw [e0]; exact hx

    have eqE : ∀ (p p' : Equiv.Perm (E j)), (∀ e : E j, ((p e).1 : Mumford.QuotEdge ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂))) = (p' e).1) → p = p' :=
      fun p p' h => Equiv.ext fun e => Subtype.ext (h e)
    have e00 : h₀ * h₀ = 1 := by
      apply eqE; intro e
      show ((h₀ (h₀ e)).1 : Mumford.QuotEdge _ _) = e.1
      rw [hh₀ (h₀ e), hh₀ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j (((ρ₂ (w₂ j)) • e.1.out).symm)
      rw [hxe]
      simp only [Mumford.smul_dart_symm, SimpleGraph.Dart.symm_symm, smul_smul]
      have e1 : (ρ₂ (w₂ j)) * (x * (ρ₂ (w₂ j))) = ((ρ₂ (w₂ j)) * x * ((ρ₂ (w₂ j)))⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (w₂ j))) := by group
      have e2 : (ρ₂ (w₂ j)) * x * (ρ₂ (w₂ j)) = ((ρ₂ (w₂ j)) * x * ((ρ₂ (w₂ j)))⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (w₂ j))) := by group
      first
        | (rw [e1]; exact (horbD j _ (Subgroup.mul_mem _ (hconj0 x hx) hsq0) e.1.out).trans (Quotient.out_eq e.1))
        | (rw [e2]; exact (horbD j _ (Subgroup.mul_mem _ (hconj0 x hx) hsq0) e.1.out).trans (Quotient.out_eq e.1))
    have e11 : h₁ * h₁ = 1 := by
      apply eqE; intro e
      show ((h₁ (h₁ e)).1 : Mumford.QuotEdge _ _) = e.1
      rw [hh₁ (h₁ e), hh₁ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j ((ρ₂ (wbar₂ j)) • e.1.out)
      rw [hxe]
      simp only [smul_smul]
      have e1 : (ρ₂ (wbar₂ j)) * (x * (ρ₂ (wbar₂ j))) = ((ρ₂ (wbar₂ j)) * x * ((ρ₂ (wbar₂ j)))⁻¹) * ((ρ₂ (wbar₂ j)) * (ρ₂ (wbar₂ j))) := by group
      have e2 : (ρ₂ (wbar₂ j)) * x * (ρ₂ (wbar₂ j)) = ((ρ₂ (wbar₂ j)) * x * ((ρ₂ (wbar₂ j)))⁻¹) * ((ρ₂ (wbar₂ j)) * (ρ₂ (wbar₂ j))) := by group
      first
        | (rw [e1]; exact (horbD j _ (Subgroup.mul_mem _ (hconj1 x hx) hsq1) e.1.out).trans (Quotient.out_eq e.1))
        | (rw [e2]; exact (horbD j _ (Subgroup.mul_mem _ (hconj1 x hx) hsq1) e.1.out).trans (Quotient.out_eq e.1))
    have e01 : h₀ * h₁ = h₁ * h₀ := by
      apply eqE; intro e
      show ((h₀ (h₁ e)).1 : Mumford.QuotEdge _ _) = (h₁ (h₀ e)).1
      rw [hh₀ (h₁ e), hh₁ e, hh₁ (h₀ e), hh₀ e]
      obtain ⟨x, hx, hxe⟩ := houtrel j ((ρ₂ (wbar₂ j)) • e.1.out)
      obtain ⟨y, hy, hye⟩ := houtrel j (((ρ₂ (w₂ j)) • e.1.out).symm)
      rw [hxe, hye]
      simp only [Mumford.smul_dart_symm, smul_smul]

      have eL : ∀ z : PGL(2, ↥(ValuationSubring.ratClosure A₂)), (ρ₂ (w₂ j)) * (x * (ρ₂ (wbar₂ j))) = z ∨ (ρ₂ (w₂ j)) * x * (ρ₂ (wbar₂ j)) = z → z = ((ρ₂ (w₂ j)) * x * ((ρ₂ (w₂ j)))⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j))) := by
        rintro z (rfl | rfl) <;> group
      have eR : ∀ z : PGL(2, ↥(ValuationSubring.ratClosure A₂)), (ρ₂ (wbar₂ j)) * (y * (ρ₂ (w₂ j))) = z ∨ (ρ₂ (wbar₂ j)) * y * (ρ₂ (w₂ j)) = z →
          z = (((ρ₂ (wbar₂ j)) * y * ((ρ₂ (wbar₂ j)))⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j)) * ((ρ₂ (w₂ j)))⁻¹ * ((ρ₂ (wbar₂ j)))⁻¹)⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j))) := by
        rintro z (rfl | rfl) <;> group
      have hmL : (ρ₂ (w₂ j)) * x * ((ρ₂ (w₂ j)))⁻¹ ∈ (Γ₂ j).map ρ₂ := hconj0 x hx
      have hmR : ((ρ₂ (wbar₂ j)) * y * ((ρ₂ (wbar₂ j)))⁻¹) * ((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j)) * ((ρ₂ (w₂ j)))⁻¹ * ((ρ₂ (wbar₂ j)))⁻¹)⁻¹ ∈ (Γ₂ j).map ρ₂ :=
        Subgroup.mul_mem _ (hconj1 y hy) (Subgroup.inv_mem _ hcomm)
      have kL : (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) (((ρ₂ (w₂ j)) * (x * (ρ₂ (wbar₂ j)))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j))) • e.1.out.symm) := by
        rw [eL ((ρ₂ (w₂ j)) * (x * (ρ₂ (wbar₂ j)))) (Or.inl rfl), mul_smul]; exact horbD j _ hmL _
      have kL' : (Quotient.mk (MulAction.orbitRel ↥((Γ₂ j).map ρ₂) (BruhatTits.tree R₀ ↥(ValuationSubring.ratClosure A₂)).Dart) (((ρ₂ (w₂ j)) * x * (ρ₂ (wbar₂ j))) • e.1.out.symm) : Mumford.QuotEdge _ _) =
          Quotient.mk _ (((ρ₂ (w₂ j)) * (ρ₂ (wbar₂ j))) • e.1.out.symm) := by
        rw [eL ((ρ₂ (w₂ j)) * x * (ρ₂ (wbar₂ j))) (Or.inr rfl), mul_smul]; exact horbD j _ hmL _
