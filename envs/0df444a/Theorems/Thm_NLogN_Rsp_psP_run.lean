theorem NLogN.Rsp.psP_run (s t kb : ℕ) (hs : 0 < s) (hco : Nat.Coprime t s) (hkb : s ≤ 2 ^ kb)
    (W : List (ℤ × ℤ)) (hW : W.length = s) (τ : IState HS) (RU : List Item)
    (hU : τ.G CU = gints W ++ RU) (h2 : ∃ L, τ.G 2 = .int (kb : ℤ) :: L)
    (hk : ∃ R, τ.G KS = natInts (psKeys s t) ++ R) (hps : ∃ L, τ.G PS = .int (s : ℤ) :: L) (B : ℕ)
    (hB : ∀ z ∈ W, zsz z.1 ≤ B ∧ zsz z.2 ≤ B) (hsB : zsz (s : ℤ) ≤ B) :
    psP.ok τ ∧ psP.run τ = τ.upd CU (gints (psL s t W) ++ RU) ∧
      psP.cost τ ≤ 2 * 2000 * (B + 2) +
        10 ^ 6 * (kb + 1) * (s + 1) * (2 + 1) * (B + kb + 2 + 4) + (2 * B + 2) := by sorry
