theorem pd_g_eq_chr1 (hm : MetricData g gi U) {y : Pt n} (hy : y ∈ U) (a c e : Fin n) :
    pd c (g a e) y = chr1 g a c e y + chr1 g e c a y := by
  have s1 : pd a (g e c) y = pd a (g c e) y :=
    pd_congr_of_eqOn hm.isOpen hy (fun z hz => hm.symm z hz e c) a
  have s2 : pd c (g e a) y = pd c (g a e) y :=
    pd_congr_of_eqOn hm.isOpen hy (fun z hz => hm.symm z hz e a) c
  have s3 : pd e (g c a) y = pd e (g a c) y :=
    pd_congr_of_eqOn hm.isOpen hy (fun z hz => hm.symm z hz c a) e
  simp only [chr1]
  rw [s1, s2, s3]
