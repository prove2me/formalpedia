-- title:
--   Proposition 7.8 — (Q, τ_ψ(C)) is convex, compact and metrizable, and τ₁ and τ_ψ agree on Q
-- statement:
--   Assume the standing assumptions (S), and let $\mathcal Q\subset\mathcal P_\psi(\mathcal C)$ be the set (7.6),
--   $$\mathcal Q=\Big\{\mu\in\mathcal P_\psi(\mathcal C):\mu\sim\mathcal X,\ \int\Big(\frac{d\mu}{d\mathcal X}\Big)^2d\mathcal X\le M,\ \int\frac{d\mathcal X}{d\mu}\,d\mathcal X\le M\Big\},\qquad M=\max(M_2,M_{-1}).$$
--   Then $(\mathcal Q,\tau_\psi(\mathcal C))$ is convex, compact and metrizable. Moreover, $\tau_1(\mathcal C)$ and $\tau_\psi(\mathcal C)$ induce the same topology on $\mathcal Q$.
--
--   This is the compactness behind the fixed point argument: $\mathcal Q\times\mathcal M$ is the compact convex set $K$ to which Proposition 7.4 is applied.
--
--   **Formalization Note** Convexity is closure of $\mathcal Q$ under mixtures $s\mu+(1-s)\mu'$, $s\in[0,1]$, of the underlying measures. $\tau_\psi(\mathcal C)$ is the topology carried by $\mathcal P_\psi(\mathcal C)$, and $\tau_1(\mathcal C)$ is the topology generated by bounded measurable test functions; both are restricted to $\mathcal Q$.
-- source:
--   Carmona, Lacker, A probabilistic weak formulation of mean field games and applications, arXiv:1307.1152v2 (2014), Proposition 7.8, (7.6), p. 24

import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic
import Definitions.Def_WeakMFG_Existence_Model
import Definitions.Def_WeakMFG_Existence_Hyp
import Definitions.Def_WeakMFG_Existence_Reward
import Definitions.Def_WeakMFG_Existence_FixedPoint

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal NNReal Matrix

namespace WeakMFG.Existence

/-- Proposition 7.8 (Carmona–Lacker, arXiv:1307.1152v2, p. 24): the space `(Q, τ_ψ(C))` of (7.6)
is convex, compact and metrizable; moreover `τ₁(C)` and `τ_ψ(C)` induce the same topology on `Q`.
Formalization Notes: convexity is closure under mixtures `s μ + (1 − s) μ'` of the underlying
measures; `τ₁(C)` on `P_ψ(C)` is `tauTop ψ 1`, `τ_ψ(C)` is the instance `tauTop ψ ψ`. -/
theorem proposition_7_8 {d : ℕ} {T : ℝ≥0} (hT : 0 < T) {ψ : Path d T → ℝ}
    {EA : Type*} [NormedAddCommGroup EA] [NormedSpace ℝ EA] [MeasurableSpace EA] [BorelSpace EA]
    {A : Set EA} {Ω : Type*} [MeasurableSpace Ω] (B : Base d T Ω)
    (σ : ℝ≥0 → Path d T → Matrix (Fin d) (Fin d) ℝ)
    (b : ℝ≥0 → Path d T → Ppsi ψ → EA → (Fin d → ℝ))
    (f : ℝ≥0 → Path d T → Ppsi ψ → PA A → EA → ℝ) (g : Path d T → Ppsi ψ → ℝ)
    (X : ℝ≥0 → Ω → Fin d → ℝ) (Xp : Ω → Path d T)
    (hS : Standing B A ψ σ b f g X Xp) :
    (∀ μ ∈ Qset B A σ b Xp, ∀ μ' ∈ Qset B A σ b Xp, ∀ s : ℝ, 0 ≤ s → s ≤ 1 →
      ∀ ν : Ppsi ψ, ν.toMeasure = ENNReal.ofReal s • μ.toMeasure +
        ENNReal.ofReal (1 - s) • μ'.toMeasure → ν ∈ Qset B A σ b Xp) ∧
    IsCompact (Qset B A σ b Xp) ∧
    TopologicalSpace.MetrizableSpace (Qset B A σ b Xp) ∧
    TopologicalSpace.induced (Subtype.val : Qset B A σ b Xp → Ppsi ψ) (tauTop ψ (fun _ => 1)) =
      TopologicalSpace.induced (Subtype.val : Qset B A σ b Xp → Ppsi ψ) (tauTop ψ ψ) := by sorry

end WeakMFG.Existence
