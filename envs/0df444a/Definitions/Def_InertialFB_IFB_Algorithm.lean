-- title:
--   The objective $\Theta=\Phi+\Psi$, its argmin set, Hypothesis H and algorithm (IFB)
-- statement:
--   Let $H$ be a real Hilbert space, $\Phi : H \to \mathbb R\cup\{+\infty\}$ and $\Psi : H \to \mathbb R$. Write $\Theta = \Phi + \Psi$ and $\mathcal S = \operatorname{Argmin}\Theta = \{x \in H : \Theta(x) \le \Theta(y) \text{ for all } y\}$.
--
--   **Hypothesis H** for a constant $L_\Psi > 0$, parameters $a, b$ and a step size $\lambda$ consists of:
--
--   1. $H_\Phi$: $\Phi$ is proper, lower semicontinuous and convex;
--   2. $H_\Psi$: $\Psi$ is differentiable and $\nabla\Psi$ is Lipschitz continuous with constant $L_\Psi$, i.e. $\|\nabla\Psi(x) - \nabla\Psi(y)\| \le L_\Psi\|x-y\|$;
--   3. $H_\lambda$: $a, b > 0$ and
--   $$0 < \lambda < \Lambda = \min\left\{\frac1a,\ \frac{2(a+b)}{bL_\Psi}\right\};$$
--   4. $H_\Theta$: $\Theta$ is convex and bounded from below.
--
--   **Algorithm (IFB)** (Inertial Forward-Backward). Starting from any $(u_0, y_0) \in H\times H$, the sequences $(u_k), (y_k)$ satisfy, for every $k \ge 0$,
--   $$0 \in \frac{u_{k+1}-u_k}{\lambda} + \partial\Phi(u_{k+1}) + a u_k - b y_k, \qquad 0 = \frac{y_{k+1}-y_k}{\lambda} + \nabla\Psi(u_{k+1}) - a u_{k+1} + b y_{k+1}.$$
--   The first relation is an implicit (proximal) step on the nonsmooth part $\Phi$, the second an explicit step on the smooth part $\Psi$, evaluated at the new point $u_{k+1}$.
--
--   **Formalization Note** $\Theta$ is `EReal`-valued, $\Theta(x) = \Phi(x) + \Psi(x)$; "bounded from below" means some real $m$ satisfies $m \le \Theta(x)$ for all $x$. The step size $\lambda$ is written `lam` because `λ` is Lean syntax. $H_\lambda$ is stated as the two strict inequalities $\lambda < 1/a$ and $\lambda < 2(a+b)/(bL_\Psi)$, which together are $\lambda < \Lambda$. The paper does not say $L_\Psi > 0$; requiring it loses nothing, since a gradient that is Lipschitz with some constant is Lipschitz with every larger positive constant. (IFB) is encoded by the inclusion itself, $-\big(\frac{u_{k+1}-u_k}{\lambda} + a u_k - b y_k\big) \in \partial\Phi(u_{k+1})$, not through the proximity operator; `gradient` is Mathlib's Riesz-represented gradient.
-- source:
--   Attouch, Peypouquet & Redont, A Dynamical Approach to an Inertial Forward-Backward Algorithm for Convex Minimization, authors' manuscript (Aug 2013) of SIAM J. Optim. (2014), DOI 10.1137/130910294, p. 3 (algorithm (IFB)), p. 4 (Hypothesis H; S = Argmin Θ in Theorem 1)

import Mathlib
import Definitions.Def_InertialFB_IFB_ConvexAnalysis

open Filter Topology

namespace InertialFB.IFB

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The objective `Θ = Φ + Ψ : H → ℝ ∪ {+∞}`. -/
noncomputable def theta (Φ : H → EReal) (Ψ : H → ℝ) (x : H) : EReal :=
  Φ x + (Ψ x : EReal)

/-- `S = Argmin Θ`, the set of global minimizers of `Θ = Φ + Ψ`. -/
def argminSet (Φ : H → EReal) (Ψ : H → ℝ) : Set H :=
  {x | ∀ y, theta Φ Ψ x ≤ theta Φ Ψ y}

/-- Hypothesis **H** of Attouch–Peypouquet–Redont (p. 4), for the constant `L` (the Lipschitz
constant `L_Ψ` of `∇Ψ`), the parameters `a, b > 0` and the step size `lam` (= `λ`). -/
structure HypothesisH (Φ : H → EReal) (Ψ : H → ℝ) (L a b lam : ℝ) : Prop where
  /-- `H_Φ`: `Φ` is proper. -/
  phi_proper : IsProperFn Φ
  /-- `H_Φ`: `Φ` is lower semicontinuous. -/
  phi_lsc : LowerSemicontinuous Φ
  /-- `H_Φ`: `Φ` is convex. -/
  phi_convex : IsConvexFn Φ
  /-- `H_Ψ`: `Ψ` is differentiable. -/
  psi_diff : Differentiable ℝ Ψ
  /-- `H_Ψ`: the constant `L` is positive. -/
  L_pos : 0 < L
  /-- `H_Ψ`: `∇Ψ` is Lipschitz continuous with constant `L`. -/
  psi_grad_lipschitz : ∀ x y : H, ‖gradient Ψ x - gradient Ψ y‖ ≤ L * ‖x - y‖
  /-- `H_λ`: `a > 0`. -/
  a_pos : 0 < a
  /-- `H_λ`: `b > 0`. -/
  b_pos : 0 < b
  /-- `H_λ`: `λ > 0`. -/
  lam_pos : 0 < lam
  /-- `H_λ`: `λ < 1/a`. -/
  lam_lt_inv_a : lam < 1 / a
  /-- `H_λ`: `λ < 2(a+b)/(b L)`. -/
  lam_lt_bound : lam < 2 * (a + b) / (b * L)
  /-- `H_Θ`: `Θ = Φ + Ψ` is convex. -/
  theta_convex : IsConvexFn (theta Φ Ψ)
  /-- `H_Θ`: `Θ = Φ + Ψ` is bounded from below. -/
  theta_bdd_below : ∃ m : ℝ, ∀ x, (m : EReal) ≤ theta Φ Ψ x

/-- The sequences `(u k, y k)` are generated by algorithm (IFB) with parameters `a, b, lam`
from the initial pair `(u 0, y 0)`: for every `k`,
`0 ∈ (u(k+1) - u k)/λ + ∂Φ(u(k+1)) + a u k - b y k` and
`0 = (y(k+1) - y k)/λ + ∇Ψ(u(k+1)) - a u(k+1) + b y(k+1)`. -/
def IsIFBSeq (Φ : H → EReal) (Ψ : H → ℝ) (a b lam : ℝ) (u y : ℕ → H) : Prop :=
  ∀ k : ℕ,
    IsSubgradient Φ (u (k + 1)) (-((1 / lam) • (u (k + 1) - u k) + a • u k - b • y k)) ∧
    (1 / lam) • (y (k + 1) - y k) + gradient Ψ (u (k + 1)) - a • u (k + 1) + b • y (k + 1) = 0

end InertialFB.IFB


