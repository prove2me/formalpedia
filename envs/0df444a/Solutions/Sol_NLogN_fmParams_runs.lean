  | _ m ih =>
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · simp [nbits_zero, wval]
    · rw [nbits_pos hm.ne', wval, ih _ (Nat.div_lt_self hm (by norm_num))]
      by_cases h : m % 2 = 1 <;> simp [h] <;> omega

