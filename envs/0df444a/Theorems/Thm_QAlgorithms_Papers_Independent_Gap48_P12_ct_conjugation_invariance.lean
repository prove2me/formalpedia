-- title:
--   Section 4.1, unnumbered: T-conjugation invariance of C_T(C_1)
-- statement:
--   Let $C_1$ be the exact matrix group generated by $H,P$, and define
--
--   $$C_T(C_1)=\{TgT^{-1}:g\in C_1,\ TgT^{-1}\in C_1\}.$$
--
--   For every one-qubit unitary matrix $g$,
--
--   $$g\in C_T(C_1)\quad\Longleftrightarrow\quad TgT^{-1}\in C_T(C_1).$$
--
--   Here $T^{-1}=T^\dagger$. This is invariance of the intersection subgroup, with no centralizer requirement.
-- source:
--   Representation of Quantum Circuits with Clifford and $π/8$ Gates, arXiv:0806.3834v1, PDF p. 7, Section 4.1, unnumbered: T-conjugation invariance of C_T(C_1)

import Definitions.Def_QAlgorithms_Papers_Independent_Gap48_P12

noncomputable section

namespace QAlgorithms.Papers.Independent.Gap48.P12

local notation "Mat" => Matrix Bool Bool ℂ

local notation "Vec" => EuclideanSpace ℂ Bool

local notation "wordMatrix" => fun (B : CircuitBasis) (w : CircuitWord) =>
  QAlgorithms.Papers.Independent.Next46.P21.wordMatrix (chronologicalInstructions B w)

/-- PDF p.7, §4.1: invariance of the image/intersection subgroup under
conjugation by T. The quantified g is an arbitrary one-qubit unitary. -/
theorem ct_conjugation_invariance (g : Mat) (hg : g ∈ Matrix.unitaryGroup Bool ℂ) :
    g ∈ ctSet ↔ gateT * g * star gateT ∈ ctSet := by sorry

end QAlgorithms.Papers.Independent.Gap48.P12

