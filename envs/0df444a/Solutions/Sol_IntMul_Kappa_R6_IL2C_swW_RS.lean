    (h0 : t.G 0 = ints (flR recs (P * 2 ^ u * Mid * 2 ^ u * S)) ++ R0)
    (eP eG eS eU : Ex HS) (Bb : ℕ)
    (hBb : Bb ≤ zsz ((P * 2 ^ u * Mid * 2 ^ u * S * B : ℕ) : ℤ) + 3)
    (hsz : eP.size + eG.size + eS.size + eU.size ≤ 50)
    (nP : KFX.NoK eP) (nG : KFX.NoK eG) (nS : KFX.NoK eS) (nU : KFX.NoK eU)
    (E1 : ESp eP t Bb (P : ℤ)) (E2 : ESp eG t Bb (Mid : ℤ)) (E3 : ESp eS t Bb ((S * B : ℕ) : ℤ))
    (E4 : ESp eU t Bb (u : ℤ)) :
    ∃ c : ℕ, IRuns I tab (IL2.swE l12 eP eG eS eU) t
