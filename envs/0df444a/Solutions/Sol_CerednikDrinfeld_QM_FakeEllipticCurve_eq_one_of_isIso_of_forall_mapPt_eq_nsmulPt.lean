theorem one_ne_natCast_mul (hΛ : IsOrder Λ) (p : ℕ) (hp : 2 ≤ p) (m : ↥Λ) :
    (1 : ℍ[ℚ, a, b]) ≠ ((p : ℚ) : ℍ[ℚ, a, b]) * (m : ℍ[ℚ, a, b]) := by
  intro h

  let S : Subalgebra ℤ ℍ[ℚ, a, b] :=
    { carrier := Λ
      mul_mem' := fun hx hy => hΛ.mul_mem hx hy
      one_mem' := hΛ.one_mem
      add_mem' := fun hx hy => Λ.add_mem hx hy
      zero_mem' := Λ.zero_mem
      algebraMap_mem' := fun z => by
        show ((z : ℤ) : ℍ[ℚ, a, b]) ∈ Λ
        rw [← zsmul_one]
        exact Λ.smul_mem z hΛ.one_mem }
  have hfg : S.toSubmodule.FG := hΛ.fg
  have hint : IsIntegral ℤ (m : ℍ[ℚ, a, b]) := IsIntegral.of_mem_of_fg S hfg _ m.2

  have hp0 : (p : ℚ) ≠ 0 := by exact_mod_cast (show p ≠ 0 by omega)
  have hm : (m : ℍ[ℚ, a, b]) = (((p : ℚ)⁻¹ : ℚ) : ℍ[ℚ, a, b]) := by
    have := congrArg (fun x : ℍ[ℚ, a, b] => (((p : ℚ)⁻¹ : ℚ) : ℍ[ℚ, a, b]) * x) h
    simp only [mul_one] at this
    rw [← mul_assoc, ← QuaternionAlgebra.coe_mul, inv_mul_cancel₀ hp0, QuaternionAlgebra.coe_one, one_mul] at this
    exact this.symm
  have hint' : IsIntegral ℤ ((p : ℚ)⁻¹) := by
    have hinj : Function.Injective (algebraMap ℚ ℍ[ℚ, a, b]) := by
      rw [QuaternionAlgebra.coe_algebraMap]; exact QuaternionAlgebra.coe_injective
    rw [← isIntegral_algebraMap_iff (B := ℍ[ℚ, a, b]) hinj]
    show IsIntegral ℤ ((((p : ℚ)⁻¹ : ℚ) : ℍ[ℚ, a, b]))
    rw [← hm]; exact hint
  obtain ⟨y, hy⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).mp hint'
  have hy' : (y : ℚ) * p = 1 := by
    rw [show ((y : ℤ) : ℚ) = (algebraMap ℤ ℚ) y from rfl, hy, inv_mul_cancel₀ hp0]
  have hyz : y * (p : ℤ) = 1 := by exact_mod_cast hy'
  have : (p : ℤ) ∣ 1 := ⟨y, by rw [mul_comm]; exact hyz.symm⟩
  have : (p : ℤ) ≤ 1 := Int.le_of_dvd one_pos this
  omega

end ScalarAut29

