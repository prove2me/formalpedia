    rcases x with ⟨⟨i,j⟩, hx⟩
    have hx := mem_staircase.mp hx
    dsimp only at *
    apply Prod.ext
    · dsimp; split_ifs <;> omega
    · rfl

end UniversalTensorSquare

end
end

end OAI
end

