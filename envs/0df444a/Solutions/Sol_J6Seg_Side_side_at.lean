-- Source module: Solutions.J6SegSideCost5
/-!
# Side costs 5: **`sideCost6_all`**

Against `cU6 P n 2 = T p · Ncost6 · (log lg n + 1)^2` with `Ncost6 ≥ d + ℓ`, `d = D + 1`:
every side cost is `≤ Kc · cU6 P n 2 / (D + 1)` with
`Kc = 10^12 (W+15)^3 (W+x+14)^2 (Cfm+1)`, `W = 3 wA + wC`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- `d + ℓ ≤ Ncost6`. -/
theorem dl_le_Ncost6 (P : Prm) (n : ℕ) : (dP6 P n : ℝ) + ℓP6 P n ≤ Ncost6 P n := by
  unfold Ncost6 Ncost6R
  have hp1 : (1 : ℝ) ≤ pP6 P n := by
    have := b'P6_pos P n
    have : 1 ≤ pP6 P n := by unfold pP6; omega
    exact_mod_cast this
  have hp0 : (0 : ℝ) ≤ pP6 P n := by linarith
  have hd : (0 : ℝ) ≤ dP6 P n := Nat.cast_nonneg _
  have hl : (0 : ℝ) ≤ ℓP6 P n := Nat.cast_nonneg _
  have t1 : 0 ≤ (ℓP6 P n : ℝ) * (dP6 P n : ℝ) ^ P.lamp := mul_nonneg hl (Real.rpow_nonneg hd _)
  have t2 : 0 ≤ (dP6 P n : ℝ) * (pP6 P n : ℝ) ^ P.δ := mul_nonneg hd (Real.rpow_nonneg hp0 _)
  have t3 : 0 ≤ Real.logb 2 (pP6 P n) := Real.logb_nonneg (by norm_num) hp1
  have t4 : 0 ≤ (pP6 P n : ℝ) ^ P.δ := Real.rpow_nonneg hp0 _
  have t5 : 0 ≤ (ℓP6 P n : ℝ) * ((dP6 P n : ℝ) * Real.log (pP6 P n)) ^ P.τ :=
    mul_nonneg hl (Real.rpow_nonneg (mul_nonneg hd (Real.log_nonneg hp1)) _)
  linarith

/-- `log₂ b + 1 ≤ 2 (log lg n + 1)`. -/
theorem beta_le (n : ℕ) :
    ((Nat.log 2 (bP6 n) : ℕ) : ℝ) + 1 ≤ 2 * (Real.log (IntMul.lg n) + 1) := by
  have hb := bP6_pos n
  have h1 : 2 ^ Nat.log 2 (bP6 n) ≤ bP6 n := Nat.pow_log_le_self 2 (by omega)
  have h2 : ((2 : ℝ)) ^ Nat.log 2 (bP6 n) ≤ (IntMul.lg n : ℝ) := by
    show ((2 : ℝ)) ^ Nat.log 2 (bP6 n) ≤ (bP6 n : ℝ); exact_mod_cast h1
  have h3 := Real.log_le_log (by positivity) h2
  rw [Real.log_pow] at h3
  have hl2 := Real.log_two_gt_d9
  have hβ : (0 : ℝ) ≤ (Nat.log 2 (bP6 n) : ℝ) := Nat.cast_nonneg _
  nlinarith

/-- The final step. -/
theorem fin {Y M Kc Z d : ℝ} (hd : 0 < d) (hZ : 0 ≤ Z) (hM : M ≤ Kc) (hY : d * Y ≤ M * Z) :
    Y ≤ Kc * Z / d := by
  rw [le_div_iff₀ hd]
  calc Y * d = d * Y := by ring
    _ ≤ M * Z := hY
    _ ≤ Kc * Z := mul_le_mul_of_nonneg_right hM hZ

/-- Multiplying a non-`d` bound by `d ≤ Nc`. -/
theorem lift {Y M X Nc L d : ℝ} (hd : 0 ≤ d) (hdN : d ≤ Nc) (hX : 0 ≤ X) (hM : 0 ≤ M)
    (hY : Y ≤ M * X * L ^ 2) : d * Y ≤ M * (X * Nc * L ^ 2) := by
  have h0 : 0 ≤ M * X * L ^ 2 := by positivity
  calc d * Y ≤ d * (M * X * L ^ 2) := mul_le_mul_of_nonneg_left hY hd
    _ ≤ Nc * (M * X * L ^ 2) := mul_le_mul_of_nonneg_right hdN h0
    _ = M * (X * Nc * L ^ 2) := by ring

/-- The constants of `Kc`. -/
theorem K0_facts (W x Cf : ℝ) (hW : 0 ≤ W) (hx : 0 ≤ x) (hC : 0 ≤ Cf) :
    let K0 := (W + 15) ^ 3 * (W + x + 14) ^ 2 * (Cf + 1)
    1 ≤ K0 ∧ W + 11 ≤ K0 ∧ (W + 12) ^ 2 ≤ K0 ∧ Cf * (W + 10) * (W + x + 14) ^ 2 ≤ K0 := by
  intro K0
  have hA1 : 1 ≤ W + 15 := by linarith
  have hB1 : 1 ≤ W + x + 14 := by linarith
  have hBC : 1 ≤ (W + x + 14) ^ 2 * (Cf + 1) :=
    one_le_mul_of_one_le_of_one_le (one_le_pow₀ hB1) (by linarith)
  have hA3 : (W + 15) ^ 3 ≤ K0 := by
    show _ ≤ (W + 15) ^ 3 * (W + x + 14) ^ 2 * (Cf + 1)
    rw [mul_assoc]; exact le_mul_of_one_le_right (by positivity) hBC
  have hA2 : (W + 15) ^ 2 ≤ K0 := (pow_le_pow_right₀ hA1 (by norm_num)).trans hA3
  have hA : W + 15 ≤ K0 := (le_self_pow₀ hA1 (by norm_num)).trans hA3
  refine ⟨by linarith, by linarith, le_trans (by gcongr; linarith) hA2, ?_⟩
  show _ ≤ (W + 15) ^ 3 * (W + x + 14) ^ 2 * (Cf + 1)
  have e2 : W + 10 ≤ (W + 15) ^ 3 := (show W + 10 ≤ W + 15 by linarith).trans
    (le_self_pow₀ hA1 (by norm_num))
  calc Cf * (W + 10) * (W + x + 14) ^ 2 ≤ (Cf + 1) * (W + 15) ^ 3 * (W + x + 14) ^ 2 := by
        gcongr; linarith
    _ = _ := by ring

/-- The output-pass `fmB` term. -/
theorem fmB_term (P : Prm) (n W' p T m : ℕ) (hp : 1 ≤ p) (hm : m ≤ 64 * ((W' + 10) * p))
    (hlp : Real.log p + 1 ≤ ((P.x : ℝ) + 4) * (Real.log (IntMul.lg n) + 1)) :
    10 ^ 7 * (T : ℝ) * (KFM.fmB m : ℝ) ≤
      325 * 10 ^ 9 * ((NLogN.KFZ.Cfm : ℝ) * ((W' : ℝ) + 10) * ((W' : ℝ) + P.x + 14) ^ 2) *
        ((T : ℝ) * p) * (Real.log (IntMul.lg n) + 1) ^ 2 := by
  have hF := NLogN.KFZ.fmB_le_log ((W' + 10) * p) m (Nat.one_le_iff_ne_zero.2
      (Nat.mul_ne_zero (by omega) (by omega))) hm
  have hpp : (((W' + 10) * p : ℕ) : ℝ) = ((W' : ℝ) + 10) * p := by push_cast; ring
  rw [hpp] at hF
  have hL := lgn_ge n
  have hpR : (1 : ℝ) ≤ (p : ℝ) := by exact_mod_cast hp
  have hW0 : (0 : ℝ) ≤ W' := Nat.cast_nonneg _
  have hx0 : (0 : ℝ) ≤ P.x := Nat.cast_nonneg _
  have hlog : Real.log (((W' : ℝ) + 10) * p) + 1 ≤
      ((W' : ℝ) + P.x + 14) * (Real.log (IntMul.lg n) + 1) := by
    rw [Real.log_mul (by positivity) (by positivity)]
    have a := Real.log_le_sub_one_of_pos (show 0 < (W' : ℝ) + 10 by positivity)
    have : (W' : ℝ) + 10 ≤ ((W' : ℝ) + 10) * (Real.log (IntMul.lg n) + 1) :=
      le_mul_of_one_le_right (by positivity) hL
    nlinarith
  have hlog0 : 0 ≤ Real.log (((W' : ℝ) + 10) * p) + 1 := by
    have := Real.log_nonneg (show (1 : ℝ) ≤ ((W' : ℝ) + 10) * p by nlinarith); linarith
  have hsq := pow_le_pow_left₀ hlog0 hlog 2
  have hC0 : (0 : ℝ) ≤ NLogN.KFZ.Cfm := Nat.cast_nonneg _
  calc 10 ^ 7 * (T : ℝ) * (KFM.fmB m : ℝ) ≤ 10 ^ 7 * (T : ℝ) * (32500 * (NLogN.KFZ.Cfm : ℝ) *
        (((W' : ℝ) + 10) * p) * (((W' : ℝ) + P.x + 14) * (Real.log (IntMul.lg n) + 1)) ^ 2) := by
          gcongr; exact hF.trans (by gcongr)
    _ = _ := by ring

/-- **One axis.** -/
theorem side_at_sol_aux (P : Prm) (ap : AxPlan6) {n : ℕ} {src : ℕ → ℕ} {D k : ℕ}
    (h : AxNum P n src D k) (hD : dP6 P n = D + 1) :
    SideCostAt P ap n src D k (Kc P ap * cU6 P n 2 / (D + 1)) := by
  have hdR : ((D : ℝ) + 1) = (dP6 P n : ℝ) := by rw [hD]; push_cast; ring
  have hcU : cU6 P n 2 = ((TP6 P n : ℝ) * pP6 P n) * Ncost6 P n *
      (Real.log (IntMul.lg n) + 1) ^ 2 := rfl
  rw [hdR, hcU]
  have hd0 : (0 : ℝ) < dP6 P n := by have := h.d1; exact_mod_cast this
  have hdl := dl_le_Ncost6 P n
  have hℓ0 : (0 : ℝ) ≤ ℓP6 P n := Nat.cast_nonneg _
  have hdN : (dP6 P n : ℝ) ≤ Ncost6 P n := by linarith
  have hL := lgn_ge n
  have hβ := beta_le n
  have hX : (0 : ℝ) ≤ (TP6 P n : ℝ) * pP6 P n := by positivity
  have hNc : (0 : ℝ) ≤ Ncost6 P n := by linarith
  have hZ : (0 : ℝ) ≤ ((TP6 P n : ℝ) * pP6 P n) * Ncost6 P n *
      (Real.log (IntMul.lg n) + 1) ^ 2 := by positivity
  have hW0 : (0 : ℝ) ≤ (Wc ap : ℝ) := Nat.cast_nonneg _
  obtain ⟨hK1, hK11, hK12, hK6⟩ := K0_facts (Wc ap : ℝ) (P.x : ℝ) (NLogN.KFZ.Cfm : ℝ) hW0
    (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  have hKc : Kc P ap = 10 ^ 12 * (((Wc ap : ℝ) + 15) ^ 3 * ((Wc ap : ℝ) + P.x + 14) ^ 2 *
      ((NLogN.KFZ.Cfm : ℝ) + 1)) := rfl
  generalize ((Wc ap : ℝ) + 15) ^ 3 * ((Wc ap : ℝ) + P.x + 14) ^ 2 *
      ((NLogN.KFZ.Cfm : ℝ) + 1) = K0 at hK1 hK11 hK12 hK6 hKc
  have hK00 : 0 ≤ K0 := by linarith
  have hW9 : ((Wc ap : ℝ) + 9) ^ 2 ≤ K0 := le_trans (by gcongr; linarith) hK12
  have hW5 : ((Wc ap : ℝ) + 5) ^ 2 ≤ K0 := le_trans (by gcongr; linarith) hK12
  have hLL : Real.log (IntMul.lg n) + 1 ≤ (Real.log (IntMul.lg n) + 1) ^ 2 := by nlinarith
  have hL2 : 1 ≤ (Real.log (IntMul.lg n) + 1) ^ 2 := by nlinarith
  -- a non-`d` bound `Y ≤ M X` suffices
  have simple : ∀ (Y M : ℝ), M ≤ 10 ^ 12 * K0 → 0 ≤ M →
      Y ≤ M * ((TP6 P n : ℝ) * pP6 P n) → Y ≤ Kc P ap * (((TP6 P n : ℝ) * pP6 P n) *
        Ncost6 P n * (Real.log (IntMul.lg n) + 1) ^ 2) / (dP6 P n) := by
    intro Y M hM hM0 hY
    refine fin hd0 hZ (M := M) (by rw [hKc]; exact hM) (lift hd0.le hdN hX hM0 (hY.trans ?_))
    calc M * ((TP6 P n : ℝ) * pP6 P n) = M * ((TP6 P n : ℝ) * pP6 P n) * 1 := by ring
      _ ≤ _ := by gcongr
  dsimp only [SideCostAt]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- chunk fine
    rw [fineN]
    refine fin hd0 hZ (M := 14 * K0) (by rw [hKc]; linarith)
      (lift hd0.le hdN hX (by positivity) ((Nat.cast_le.2 (n1 ap h)).trans ?_))
