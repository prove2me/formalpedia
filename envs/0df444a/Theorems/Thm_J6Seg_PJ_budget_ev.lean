--   ```lean
--   theorem J6Seg.PJ.budget_ev (P : Prm) (hP : P.Ok) (K e : ℕ) :
--       ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
