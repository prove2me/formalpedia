theorem solution (R S : Type) [CommRing R] [CommRing S] (t x : R) (phi : R →+* S)
    (z : S) (hz : phi t * z = phi x) :
    ∃ psi : TypeDensity.BlowupChart R t x →+* S, (∀ a : R, psi (TypeDensity.chartBase R t x a) = phi a) ∧ psi
        (TypeDensity.chartSlope R t x) = z := by
  have hker : ∀ p ∈ Ideal.span {TypeDensity.blowupRelation R t x}, Polynomial.eval₂RingHom phi z p = 0 := by
    intro p hp
    rw [Ideal.mem_span_singleton'] at hp
    obtain ⟨q, rfl⟩ := hp
    simp [TypeDensity.blowupRelation, hz]
  exact ⟨Ideal.Quotient.lift _ (Polynomial.eval₂RingHom phi z) hker, fun a => by simp [TypeDensity.chartBase],
    by simp [TypeDensity.chartSlope]⟩
