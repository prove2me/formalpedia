  simp_rw [this, ← Finset.mul_sum]
  have hs : ∀ k : ZMod n, ∑ ρ : ZMod n, (ZMod.stdAddChar (ρ * (j - k)) : ℂ) =
      if j - k = 0 then (n : ℂ) else 0 := fun k => sum_stdAddChar_mul _
  simp_rw [hs, sub_eq_zero]
  have hn : (n : ℂ) ≠ 0 := by exact_mod_cast NeZero.ne n
