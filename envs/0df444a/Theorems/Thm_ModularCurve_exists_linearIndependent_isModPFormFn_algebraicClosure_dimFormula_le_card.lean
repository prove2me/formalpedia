open AlgebraicCurve ModularCurve

theorem ModularCurve.exists_linearIndependent_isModPFormFn_algebraicClosure_dimFormula_le_card
    (N : ℕ) [NeZero N] (m : ℕ) (hm : 1 ≤ m) :
    ∃ (d : ℕ) (G : Fin d → ↥(modularFunctionFieldFullC (AlgebraicClosure ℚ) N)),
      LinearIndependent (AlgebraicClosure ℚ) G ∧
      (∀ i, IsModPFormFn (AlgebraicClosure ℚ) m (G i : LaurentSeries (AlgebraicClosure ℚ))) ∧
      (2 * (m : ℚ) - 1) * (ModularCurve.genusFormula N - 1)
        + ((m / 2 : ℕ) : ℚ) * (ModularCurve.nuTwo N : ℚ) + ((2 * m / 3 : ℕ) : ℚ) * (ModularCurve.nuThree N : ℚ)
        + (m : ℚ) * (ModularCurve.cuspCount N : ℚ) ≤ (d : ℚ) := by sorry
