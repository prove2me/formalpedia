open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.PG
set_option maxHeartbeats 4000000
variable (M ε : ℝ)
theorem solution {M r : ℝ} (hM : 0 ≤ M) (hr : 0 < r) :
    HasDerivAt (fun u => HPG M u) (1 / (1 + qf M r)) r := by
  have hsr : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hs0 : Real.sqrt r ≠ 0 := hsr.ne'
  have hb0 : 0 ≤ Real.sqrt (2 * M) := Real.sqrt_nonneg _
  have hbsq : Real.sqrt (2 * M) ^ 2 = 2 * M := Real.sq_sqrt (by positivity)
  have hsb : 0 < Real.sqrt r + Real.sqrt (2 * M) := by positivity
  have hsb0 : Real.sqrt r + Real.sqrt (2 * M) ≠ 0 := hsb.ne'
  have hs : HasDerivAt (fun u : ℝ => Real.sqrt u) (1 / (2 * Real.sqrt r)) r :=
    Real.hasDerivAt_sqrt hr.ne'
  have hlog : HasDerivAt (fun u : ℝ => Real.log (Real.sqrt u + Real.sqrt (2 * M)))
      ((1 / (2 * Real.sqrt r)) / (Real.sqrt r + Real.sqrt (2 * M))) r :=
    (hs.add_const _).log hsb0
  have h : HasDerivAt (fun u => u - 2 * Real.sqrt (2 * M) * Real.sqrt u
      + 4 * M * Real.log (Real.sqrt u + Real.sqrt (2 * M)))
      (1 - 2 * Real.sqrt (2 * M) * (1 / (2 * Real.sqrt r))
        + 4 * M * ((1 / (2 * Real.sqrt r)) / (Real.sqrt r + Real.sqrt (2 * M)))) r :=
    ((hasDerivAt_id' r).sub (hs.const_mul (2 * Real.sqrt (2 * M)))).add (hlog.const_mul (4 * M))
  have hq : qf M r = Real.sqrt (2 * M) / Real.sqrt r := by
    unfold qf; exact Real.sqrt_div (by positivity) r
  have h1q : 1 + Real.sqrt (2 * M) / Real.sqrt r ≠ 0 := by positivity
  unfold HPG
  refine h.congr_deriv ?_
  rw [hq]
  have h4 : 4 * M = 2 * Real.sqrt (2 * M) ^ 2 := by rw [hbsq]; ring
  rw [h4]
  field_simp
  ring
