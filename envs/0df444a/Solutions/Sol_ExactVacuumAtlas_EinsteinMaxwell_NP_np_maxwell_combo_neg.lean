section R05Seg11
/-!
# Atlas V-02 (D): Maxwell sources in a null frame, NP Maxwell equations, the Maxwell combination

General, **off shell** (no Maxwell or Einstein equation assumed; IV's residuals `J = maxwellDiv`, a vector, and
`H = faradayCyclic`, a 3-form, appear as source terms with their own transformation laws):

* `frame_dF`: `H(e_A,e_B,e_C) = Σ_cyc D_A F_{BC} − Σ_K (c^K_{AB} F_{KC} + c^K_{BC} F_{KA} + c^K_{CA} F_{KB})`
  (3-form: all three slots contracted with frame vectors; no metric, no Christoffel symbol);
* `frame_divF`: `θ^B(J) = Σ_P D_P F^{PB} + Σ_{P,K} Ω_K^K_P F^{PB} + Σ_{P,R} Ω_P^B_R F^{PR}` (vector: the frame
  component is taken with the dual coframe `θ^B`; `F^{PR}` = frame components raised with `η`);
* NP Maxwell equations with sources (`np_maxwell_1`, `np_maxwell_3`, and the primed `np_maxwell_4`,
  `np_maxwell_2`), e.g. `DΦ₁ − δ̄Φ₀ − (π − 2α)Φ₀ − 2ρΦ₁ + κΦ₂ = ½(H(l,m̄,m) − θ^n(J))`;
* **Maxwell combination** (`np_maxwell_combo_core`): for every `C^∞` `f`,
  `(δ + X)(D − 2ρ)f − (D + Y)(δ − 2τ)f = 2f [2Ψ₁ + Δκ − δ̄σ + (τ̄ + π + 3α − β̄)σ − (3γ + γ̄ + μ − μ̄)κ] + κΔf − σδ̄f`,
  `X = π̄ − β − ᾱ − 2τ`, `Y = ε̄ − ε − ρ̄ − 2ρ` — the Ricci-tensor terms cancel identically (no field equation).
  Applied to `f = Φ₁` together with `np_maxwell_1/3` it is the geometric source of III's `res1d`; the primed
  version (`np_maxwell_combo_core_neg`) is the source of `res1dN`.
-/

open scoped ContDiff Matrix
open Complex

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}

/-! ### Frame-derivative calculus -/

section fdircalc

variable {n : ℕ} {E' : Fin n → Fin n → Pt n → ℂ} {V : Set (Pt n)} (hV : IsOpen V) {y : Pt n} (hy : y ∈ V)
include hV hy

theorem fdir_add_of {f h : Pt n → ℂ} (hf : ContDiffOn ℝ ∞ f V) (hh : ContDiffOn ℝ ∞ h V) (A : Fin n) :
    fdir E' A (fun z => f z + h z) y = fdir E' A f y + fdir E' A h y := by
  simp only [fdir, cpdC_add_of hV hy _ hf hh, mul_add, Finset.sum_add_distrib]

end fdircalc

theorem fdir_const_mul {n : ℕ} (E' : Fin n → Fin n → Pt n → ℂ) (c : ℂ) (f : Pt n → ℂ) (A : Fin n) (y : Pt n) :
    fdir E' A (fun z => c * f z) y = c * fdir E' A f y := by
  simp only [fdir, cpdC_const_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun μ _ => by ring

theorem contDiffOn_FfrF (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (A B : Fin 4) : ContDiffOn ℝ ∞ (FfrF F E A B) U := by
  have e : FfrF F E A B = fun z => ∑ μ, ∑ ν, (F μ ν z : ℂ) * E A μ z * E B ν z := by
    funext z; simp only [FfrF, ccontr, fvec]
  rw [e]
  exact ContDiffOn.sum fun μ _ => ContDiffOn.sum fun ν _ =>
    ((contDiffOn_ofReal (hFs μ ν)).mul (hF.smooth_E A μ)).mul (hF.smooth_E B ν)

/-! ### The 3-form `H = dF` in the frame -/

/-! ### The vector `J = ∇·F` in the frame -/

/-! ### NP Maxwell equations with the `J`, `H` sources -/

section npmax

variable {F : TwoForm 4}

theorem FfrF_swap_on (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) (A B : Fin 4) :
    Set.EqOn (FfrF F E B A) (fun y => -FfrF F E A B y) U :=
  fun y hy => ccontr_antisymm (hFa y hy) _ _

theorem fdir_FfrF_swap (hF : FrameData g gi E Θ U) (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y)
    {x : Pt 4} (hx : x ∈ U) (A B D : Fin 4) :
    fdir E D (FfrF F E B A) x = -fdir E D (FfrF F E A B) x := by
  rw [fdir_congr_of_eqOn hF.isOpen hx (FfrF_swap_on hFa A B)]
  have e : (fun y => -FfrF F E A B y) = fun y => (-1 : ℂ) * FfrF F E A B y := funext fun y => by ring
  rw [e, fdir_const_mul]; ring

theorem fdir_phi1 (hF : FrameData g gi E Θ U) (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U) {x : Pt 4} (hx : x ∈ U)
    (D : Fin 4) :
    fdir E D (fun z => phi1 E z F) x = (fdir E D (FfrF F E 0 1) x + fdir E D (FfrF F E 3 2) x) / 2 := by
  have e : (fun z => phi1 E z F) = fun z => (1 / 2 : ℂ) * (FfrF F E 0 1 z + FfrF F E 3 2 z) := funext fun z => by
    simp only [phi1]; ring
  rw [e, fdir_const_mul, fdir_add_of hF.isOpen hx (contDiffOn_FfrF hF hFs 0 1) (contDiffOn_FfrF hF hFs 3 2)]
  ring



/-- **NP Maxwell equation 2 with sources** (negative-spin side): `DΦ₂ − δ̄Φ₁ + λΦ₀ − 2πΦ₁ − (ρ − 2ε)Φ₂
= ½ (θ^m(J) − H(l, n, m̄))`. -/
theorem np_maxwell_2 (hN : NullFrameData g gi E Θ U) (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) :
    fdir E 0 (FfrF F E 3 1) x - fdir E 3 (fun z => phi1 E z F) x
      + npLambda g gi E Θ x * phi0 E x F - 2 * npPi g gi E Θ x * phi1 E x F
      - (npRho g gi E Θ x - 2 * npEps g gi E Θ x) * phi2 E x F
      = (Jfr g gi F Θ 2 x - Hfr F E 0 1 3 x) / 2 := by
  have hF := hN.toFrameData
  rw [fdir_phi1 hF hFs hx]
  ( (
  rw [frame_dF hN.toFrameData hFs hFa hx, frame_divF hN hFs hx]
  simp only [fdir_Fup hN.toFrameData hFs hx, Fup, Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL',
    hN.cL_eq_omL hx]
  ( (
  obtain ⟨e00, e01, e02, e03, e10, e11, e12, e13, e20, e21, e22, e23, e30, e31, e32, e33⟩ := eta_vals
  simp only [Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL', e00, e01, e02, e03, e10, e11, e12,
    e13, e20, e21, e22, e23, e30, e31, e32, e33, zero_mul, mul_zero, add_zero, zero_add, sub_zero, zero_sub,
    neg_zero, one_mul, mul_one, neg_mul, mul_neg, neg_neg, zero_div]
  try (clear e00 e01 e02 e03 e10 e11 e12 e13 e20 e21 e22 e23 e30 e31 e32 e33)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  simp only [npPi, npAlpha, npRho, npKappa, npMu, npGamma, npTau, npSigma, npLambda, npEps, npNu, npBeta,
    phi0, phi1, phi2]
  ( (
  have hd : ∀ C A, omL g gi E Θ C A C x = 0 := fun C A => by
    have h := hN.omL_antisymm hx C A C; linear_combination h / 2
  have a10 : ∀ A, omL g gi E Θ 1 A 0 x = -omL g gi E Θ 0 A 1 x := fun A => hN.omL_antisymm hx 1 A 0
  have a20 : ∀ A, omL g gi E Θ 2 A 0 x = -omL g gi E Θ 0 A 2 x := fun A => hN.omL_antisymm hx 2 A 0
  have a30 : ∀ A, omL g gi E Θ 3 A 0 x = -omL g gi E Θ 0 A 3 x := fun A => hN.omL_antisymm hx 3 A 0
  have a21 : ∀ A, omL g gi E Θ 2 A 1 x = -omL g gi E Θ 1 A 2 x := fun A => hN.omL_antisymm hx 2 A 1
  have a31 : ∀ A, omL g gi E Θ 3 A 1 x = -omL g gi E Θ 1 A 3 x := fun A => hN.omL_antisymm hx 3 A 1
  have a32 : ∀ A, omL g gi E Θ 3 A 2 x = -omL g gi E Θ 2 A 3 x := fun A => hN.omL_antisymm hx 3 A 2
  simp only [hd, a10, a20, a30, a21, a31, a32]
  try (clear hd a10 a20 a30 a21 a31 a32)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  ring))

/-- **NP Maxwell equation 4 with sources** (negative-spin side): `δΦ₂ − ΔΦ₁ + νΦ₀ − 2μΦ₁ − (τ − 2β)Φ₂
= ½ (H(n, m, m̄) − θ^l(J))`. -/
theorem np_maxwell_4 (hN : NullFrameData g gi E Θ U) (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) :
    fdir E 2 (FfrF F E 3 1) x - fdir E 1 (fun z => phi1 E z F) x
      + npNu g gi E Θ x * phi0 E x F - 2 * npMu g gi E Θ x * phi1 E x F
      - (npTau g gi E Θ x - 2 * npBeta g gi E Θ x) * phi2 E x F
      = (Hfr F E 1 2 3 x - Jfr g gi F Θ 0 x) / 2 := by
  have hF := hN.toFrameData
  rw [fdir_phi1 hF hFs hx]
  ( (
  rw [frame_dF hN.toFrameData hFs hFa hx, frame_divF hN hFs hx]
  simp only [fdir_Fup hN.toFrameData hFs hx, Fup, Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL',
    hN.cL_eq_omL hx]
  ( (
  obtain ⟨e00, e01, e02, e03, e10, e11, e12, e13, e20, e21, e22, e23, e30, e31, e32, e33⟩ := eta_vals
  simp only [Fin.sum_univ_four, NullFrameData.Omega_eq_omL, cfr_eq_cL', e00, e01, e02, e03, e10, e11, e12,
    e13, e20, e21, e22, e23, e30, e31, e32, e33, zero_mul, mul_zero, add_zero, zero_add, sub_zero, zero_sub,
    neg_zero, one_mul, mul_one, neg_mul, mul_neg, neg_neg, zero_div]
  try (clear e00 e01 e02 e03 e10 e11 e12 e13 e20 e21 e22 e23 e30 e31 e32 e33)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  simp only [npPi, npAlpha, npRho, npKappa, npMu, npGamma, npTau, npSigma, npLambda, npEps, npNu, npBeta,
    phi0, phi1, phi2]
  ( (
  have hd : ∀ C A, omL g gi E Θ C A C x = 0 := fun C A => by
    have h := hN.omL_antisymm hx C A C; linear_combination h / 2
  have a10 : ∀ A, omL g gi E Θ 1 A 0 x = -omL g gi E Θ 0 A 1 x := fun A => hN.omL_antisymm hx 1 A 0
  have a20 : ∀ A, omL g gi E Θ 2 A 0 x = -omL g gi E Θ 0 A 2 x := fun A => hN.omL_antisymm hx 2 A 0
  have a30 : ∀ A, omL g gi E Θ 3 A 0 x = -omL g gi E Θ 0 A 3 x := fun A => hN.omL_antisymm hx 3 A 0
  have a21 : ∀ A, omL g gi E Θ 2 A 1 x = -omL g gi E Θ 1 A 2 x := fun A => hN.omL_antisymm hx 2 A 1
  have a31 : ∀ A, omL g gi E Θ 3 A 1 x = -omL g gi E Θ 1 A 3 x := fun A => hN.omL_antisymm hx 3 A 1
  have a32 : ∀ A, omL g gi E Θ 3 A 2 x = -omL g gi E Θ 2 A 3 x := fun A => hN.omL_antisymm hx 3 A 2
  simp only [hd, a10, a20, a30, a21, a31, a32]
  try (clear hd a10 a20 a30 a21 a31 a32)))
  ( (
  have f10 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 1 x)
  have f20 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 2 x)
  have f30 := ccontr_antisymm (hFa x hx) (fvec E 0 x) (fvec E 3 x)
  have f21 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 2 x)
  have f31 := ccontr_antisymm (hFa x hx) (fvec E 1 x) (fvec E 3 x)
  have f32 := ccontr_antisymm (hFa x hx) (fvec E 2 x) (fvec E 3 x)
  have fdg : ∀ A, FfrF F E A A x = 0 := fun A => by
    have h := ccontr_antisymm (hFa x hx) (fvec E A x) (fvec E A x); unfold FfrF; linear_combination h / 2
  have g10 : ∀ D, fdir E D (FfrF F E 1 0) x = -fdir E D (FfrF F E 0 1) x := fun D => fdir_FfrF_swap hF hFa hx 0 1 D
  have g20 : ∀ D, fdir E D (FfrF F E 2 0) x = -fdir E D (FfrF F E 0 2) x := fun D => fdir_FfrF_swap hF hFa hx 0 2 D
  have g30 : ∀ D, fdir E D (FfrF F E 3 0) x = -fdir E D (FfrF F E 0 3) x := fun D => fdir_FfrF_swap hF hFa hx 0 3 D
  have g21 : ∀ D, fdir E D (FfrF F E 2 1) x = -fdir E D (FfrF F E 1 2) x := fun D => fdir_FfrF_swap hF hFa hx 1 2 D
  have g31 : ∀ D, fdir E D (FfrF F E 3 1) x = -fdir E D (FfrF F E 1 3) x := fun D => fdir_FfrF_swap hF hFa hx 1 3 D
  have g32 : ∀ D, fdir E D (FfrF F E 3 2) x = -fdir E D (FfrF F E 2 3) x := fun D => fdir_FfrF_swap hF hFa hx 2 3 D
  have gdg : ∀ D A, fdir E D (FfrF F E A A) x = 0 := fun D A => by
    have h := fdir_FfrF_swap hF hFa hx A A D; linear_combination h / 2
  change FfrF F E 1 0 x = -FfrF F E 0 1 x at f10
  change FfrF F E 2 0 x = -FfrF F E 0 2 x at f20
  change FfrF F E 3 0 x = -FfrF F E 0 3 x at f30
  change FfrF F E 2 1 x = -FfrF F E 1 2 x at f21
  change FfrF F E 3 1 x = -FfrF F E 1 3 x at f31
  change FfrF F E 3 2 x = -FfrF F E 2 3 x at f32
  simp only [f10, f20, f30, f21, f31, f32, fdg, g10, g20, g30, g21, g31, g32, gdg]
  try (clear f10 f20 f30 f21 f31 f32 fdg g10 g20 g30 g21 g31 g32 gdg)))
  ring))

end npmax

/-! ### The Maxwell combination (geometric source of `res1d`) -/

/-- **Maxwell combination, negative branch** (GHP prime of `np_maxwell_combo_core`, proved by applying it to the
primed frame): with `ρ' = omL 1 2 3 = −μ`, `τ' = omL 1 0 3 = −π`,
`(δ̄ + X')(Δ + 2μ)f − (Δ + Y')(δ̄ + 2π)f = 2f[2Ψ₃ − Dν + δλ + (π̄ + τ + 3β − ᾱ)λ − (3ε + ε̄ + ρ − ρ̄)ν] − νDf + λδf`,
`X' = 2π + α + β̄ − τ̄`, `Y' = 2μ + μ̄ + γ − γ̄`. -/
theorem np_maxwell_combo_core_neg (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) {f : Pt 4 → ℂ}
    (hf : ContDiffOn ℝ ∞ f U) :
    (fdir E 3 (fun z => fdir E 1 f z - 2 * omL g gi E Θ 1 2 3 z * f z) x
        + (2 * npPi g gi E Θ x + npAlpha g gi E Θ x + npBetaB g gi E Θ x - npTauB g gi E Θ x)
          * (fdir E 1 f x + 2 * npMu g gi E Θ x * f x))
      - (fdir E 1 (fun z => fdir E 3 f z - 2 * omL g gi E Θ 1 0 3 z * f z) x
        + (2 * npMu g gi E Θ x + npMuB g gi E Θ x + npGamma g gi E Θ x - npGammaB g gi E Θ x)
          * (fdir E 3 f x + 2 * npPi g gi E Θ x * f x))
      = 2 * f x * (2 * psi3 g gi E x + fdir E 0 (omL g gi E Θ 1 1 3) x - fdir E 2 (omL g gi E Θ 1 3 3) x
          + (npPiB g gi E Θ x + npTau g gi E Θ x + 3 * npBeta g gi E Θ x - npAlphaB g gi E Θ x)
            * npLambda g gi E Θ x
          - (3 * npEps g gi E Θ x + npEpsB g gi E Θ x + npRho g gi E Θ x - npRhoB g gi E Θ x)
            * npNu g gi E Θ x)
        - npNu g gi E Θ x * fdir E 0 f x + npLambda g gi E Θ x * fdir E 2 f x := by
  have hN' := hN.relabel prime23_invol etaNull_prime
  have h := np_maxwell_combo_core hN' hx hf
  rw [prime_psi1 g gi E Θ x hN hx] at h
  ( (
  simp only [fdir_relabel, omL_relabel_fun prime23_invol etaNull_prime, omL_relabel prime23_invol etaNull_prime,
    prime23_0, prime23_1, prime23_2, prime23_3, npSigma, npRho, npRhoB, npEps, npEpsB, npKappa, npTau, npPiB,
    npAlphaB, npBeta, npPi, npTauB, npGamma, npGammaB, npAlpha, npBetaB, npMu, npMuB, npLambda, npNu, npLambdaB,
    npNuB, npSigmaB, npKappaB, npBetaB, npAlphaB] at *))
  ( (
  have hd : ∀ C A, omL g gi E Θ C A C x = 0 := fun C A => by
    have h := hN.omL_antisymm hx C A C; linear_combination h / 2
  have a10 : ∀ A, omL g gi E Θ 1 A 0 x = -omL g gi E Θ 0 A 1 x := fun A => hN.omL_antisymm hx 1 A 0
  have a20 : ∀ A, omL g gi E Θ 2 A 0 x = -omL g gi E Θ 0 A 2 x := fun A => hN.omL_antisymm hx 2 A 0
  have a30 : ∀ A, omL g gi E Θ 3 A 0 x = -omL g gi E Θ 0 A 3 x := fun A => hN.omL_antisymm hx 3 A 0
  have a21 : ∀ A, omL g gi E Θ 2 A 1 x = -omL g gi E Θ 1 A 2 x := fun A => hN.omL_antisymm hx 2 A 1
  have a31 : ∀ A, omL g gi E Θ 3 A 1 x = -omL g gi E Θ 1 A 3 x := fun A => hN.omL_antisymm hx 3 A 1
  have a32 : ∀ A, omL g gi E Θ 3 A 2 x = -omL g gi E Θ 2 A 3 x := fun A => hN.omL_antisymm hx 3 A 2
  simp only [hd, a10, a20, a30, a21, a31, a32] at h ⊢
  try (clear hd a10 a20 a30 a21 a31 a32)))
  linear_combination h

theorem contDiffOn_phi1 (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U) :
    ContDiffOn ℝ ∞ (fun z => phi1 E z F) U := by
  have e : (fun z => phi1 E z F) = fun z => (1 / 2 : ℂ) * (FfrF F E 0 1 z + FfrF F E 3 2 z) :=
    funext fun z => by simp only [phi1]; ring
  rw [e]
  exact contDiffOn_const.mul ((contDiffOn_FfrF hF hFs 0 1).add (contDiffOn_FfrF hF hFs 3 2))

end ExactVacuumAtlas.EinsteinMaxwell.NP
end R05Seg11

-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hN : NullFrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) :
    (fdir E 3 (fun z => fdir E 2 (FfrF F E 3 1) z + npNu g gi E Θ z * phi0 E z F
          - (npTau g gi E Θ z - 2 * npBeta g gi E Θ z) * phi2 E z F - (Hfr F E 1 2 3 z - Jfr g gi F Θ 0 z) / 2) x
        + (2 * npPi g gi E Θ x + npAlpha g gi E Θ x + npBetaB g gi E Θ x - npTauB g gi E Θ x)
          * (fdir E 2 (FfrF F E 3 1) x + npNu g gi E Θ x * phi0 E x F
            - (npTau g gi E Θ x - 2 * npBeta g gi E Θ x) * phi2 E x F - (Hfr F E 1 2 3 x - Jfr g gi F Θ 0 x) / 2))
      - (fdir E 1 (fun z => fdir E 0 (FfrF F E 3 1) z + npLambda g gi E Θ z * phi0 E z F
          - (npRho g gi E Θ z - 2 * npEps g gi E Θ z) * phi2 E z F - (Jfr g gi F Θ 2 z - Hfr F E 0 1 3 z) / 2) x
        + (2 * npMu g gi E Θ x + npMuB g gi E Θ x + npGamma g gi E Θ x - npGammaB g gi E Θ x)
          * (fdir E 0 (FfrF F E 3 1) x + npLambda g gi E Θ x * phi0 E x F
            - (npRho g gi E Θ x - 2 * npEps g gi E Θ x) * phi2 E x F - (Jfr g gi F Θ 2 x - Hfr F E 0 1 3 x) / 2))
      = 2 * phi1 E x F * (2 * psi3 g gi E x + fdir E 0 (omL g gi E Θ 1 1 3) x - fdir E 2 (omL g gi E Θ 1 3 3) x
          + (npPiB g gi E Θ x + npTau g gi E Θ x + 3 * npBeta g gi E Θ x - npAlphaB g gi E Θ x)
            * npLambda g gi E Θ x
          - (3 * npEps g gi E Θ x + npEpsB g gi E Θ x + npRho g gi E Θ x - npRhoB g gi E Θ x)
            * npNu g gi E Θ x)
        - npNu g gi E Θ x * fdir E 0 (fun z => phi1 E z F) x
        + npLambda g gi E Θ x * fdir E 2 (fun z => phi1 E z F) x := by
  have hU := hN.isOpen
  have h4 : ∀ z ∈ U, fdir E 1 (fun w => phi1 E w F) z - 2 * omL g gi E Θ 1 2 3 z * phi1 E z F
      = fdir E 2 (FfrF F E 3 1) z + npNu g gi E Θ z * phi0 E z F
        - (npTau g gi E Θ z - 2 * npBeta g gi E Θ z) * phi2 E z F - (Hfr F E 1 2 3 z - Jfr g gi F Θ 0 z) / 2 := by
    intro z hz; have := np_maxwell_4 hN hFs hFa hz; simp only [npMu] at this ⊢; linear_combination -this
  have h2 : ∀ z ∈ U, fdir E 3 (fun w => phi1 E w F) z - 2 * omL g gi E Θ 1 0 3 z * phi1 E z F
      = fdir E 0 (FfrF F E 3 1) z + npLambda g gi E Θ z * phi0 E z F
        - (npRho g gi E Θ z - 2 * npEps g gi E Θ z) * phi2 E z F - (Jfr g gi F Θ 2 z - Hfr F E 0 1 3 z) / 2 := by
    intro z hz; have := np_maxwell_2 hN hFs hFa hz; simp only [npPi] at this ⊢; linear_combination -this
  have hc := np_maxwell_combo_core_neg hN hx (contDiffOn_phi1 hN.toFrameData hFs)
  have e4 : fdir E 1 (fun w => phi1 E w F) x + 2 * npMu g gi E Θ x * phi1 E x F
      = fdir E 1 (fun w => phi1 E w F) x - 2 * omL g gi E Θ 1 2 3 x * phi1 E x F := by simp only [npMu]; ring
  have e2 : fdir E 3 (fun w => phi1 E w F) x + 2 * npPi g gi E Θ x * phi1 E x F
      = fdir E 3 (fun w => phi1 E w F) x - 2 * omL g gi E Θ 1 0 3 x * phi1 E x F := by simp only [npPi]; ring
  rw [e4, e2, fdir_congr_of_eqOn hU hx (fun z hz => h4 z hz) 3, fdir_congr_of_eqOn hU hx (fun z hz => h2 z hz) 1,
    h4 x hx, h2 x hx] at hc
  exact hc
