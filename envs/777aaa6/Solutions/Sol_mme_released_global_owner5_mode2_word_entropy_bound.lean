/-- Actual coarse-coordinate pools of released outer words have a
certified total homogeneous entropy lower bound. -/
theorem solution :
    (1607243675 / 1000000000 : ℝ) ≤ (profile 5).words 2 0 := by
  have hx : ∀ j w, 0 ≤ x j w := by decide +kernel
  have hc : (1607243675 / 1000000000 : ℚ) ≤
      ∑ j, (∑ w, x j w) * (-(∑ w, (x j w / ∑ v, x j v) * upper j w)) := by
    decide +kernel
  have h := mme_rational_scaled_mass_entropy_sum_certificate x hx lower upper log_bounds
    1 (by norm_num) (1607243675 / 1000000000) hc
  have hid : ∀ j w, x j w = ∑ s : Fin 45,
      if (shape s).val 2 = j then
        ((alpha 5 s * ((jointRows 5 s).map
          (fun a => if atom a.1 2 = w then a.2 else 0)).sum : ℕ) : ℚ) /
            (denominator : ℚ) ^ 5 else 0 := by
    intro j w
    fin_cases j
    · exact mme_released_global_owner5_mode2_word_mass_row0 w
    · exact mme_released_global_owner5_mode2_word_mass_row1 w
    · exact mme_released_global_owner5_mode2_word_mass_row2 w
    · exact mme_released_global_owner5_mode2_word_mass_row3 w
    · exact mme_released_global_owner5_mode2_word_mass_row4 w
    · exact mme_released_global_owner5_mode2_word_mass_row5 w
    · exact mme_released_global_owner5_mode2_word_mass_row6 w
    · exact mme_released_global_owner5_mode2_word_mass_row7 w
    · exact mme_released_global_owner5_mode2_word_mass_row8 w
  have he (j : Fin 9) (w : Word) : (x j w : ℝ) =
      ∑ c : Shape, if c.val 2 = j then (profile 5).2 2 ⟨0, c⟩ w else 0 := by
    rw [hid, Rat.cast_sum, ← shapeEquiv.sum_comp]
    apply Finset.sum_congr rfl
    intro s hs
    change ((if (shape s).val 2 = j then _ else 0 : ℚ) : ℝ) =
      if (shape s).val 2 = j then (profile 5).2 2 ⟨0, shapeEquiv s⟩ w else 0
    split_ifs with hshape
    · exact (mme_released_global_profile_word_row 5 2 s w).symm
    · simp
  simp only [one_mul] at h
  simp_rw [he] at h
  simpa only [Rat.cast_div, Rat.cast_ofNat, GlobalCW.EntropyProfile.words] using h


