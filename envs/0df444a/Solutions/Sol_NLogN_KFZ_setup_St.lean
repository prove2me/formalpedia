    (er : ∀ j, j ≠ 0 → j ≠ pW → j ≠ tD → j ≠ NLogN.KFZ.qB → j ≠ qA → j ≠ qT → j ≠ qI → j ≠ rgP →
      j ≠ rgH → j ≠ rgD → j ≠ rgS → j ≠ rgK → G j = F0 j) :
    St F0 p h d σ K td z w tb ta tt ti = G := by
  funext j
  unfold St
  by_cases h0 : j = 0
  · subst h0; simp only [if_true]; exact e0.symm
  rw [if_neg h0]
  by_cases h1 : j = pW
  · subst h1; simp only [if_true]; exact e1.symm
  rw [if_neg h1]
  by_cases h2 : j = tD
  · subst h2; simp only [if_true]; exact e2.symm
  rw [if_neg h2]
  by_cases h3 : j = NLogN.KFZ.qB
  · subst h3; simp only [if_true]; exact e3.symm
  rw [if_neg h3]
  by_cases h4 : j = qA
  · subst h4; simp only [if_true]; exact e4.symm
  rw [if_neg h4]
  by_cases h5 : j = qT
  · subst h5; simp only [if_true]; exact e5.symm
  rw [if_neg h5]
  by_cases h6 : j = qI
  · subst h6; simp only [if_true]; exact e6.symm
  rw [if_neg h6]
  by_cases h7 : j = rgP
  · subst h7; simp only [if_true]; exact e7.symm
  rw [if_neg h7]
  by_cases h8 : j = rgH
  · subst h8; simp only [if_true]; exact e8.symm
  rw [if_neg h8]
  by_cases h9 : j = rgD
  · subst h9; simp only [if_true]; exact e9.symm
  rw [if_neg h9]
  by_cases h10 : j = rgS
  · subst h10; simp only [if_true]; exact e10.symm
  rw [if_neg h10]
  by_cases h11 : j = rgK
  · subst h11; simp only [if_true]; exact e11.symm
  rw [if_neg h11]
  exact (er j h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11).symm

