theorem permL_map (n : ℕ) (f g : ℕ → ℕ) (hf : ∀ j < n, f j < n) (hg : ∀ q < n, g q < n)
    (hfg : ∀ q < n, f (g q) = q) (hgf : ∀ j < n, g (f j) = j) (D : List (List ℤ)) :
    ((List.range n).map f).Perm (List.range ((List.range n).map f).length) ∧
      permL ((List.range n).map f) D = (List.range n).map fun q => D.getD (g q) [] := by
  have hnd : ((List.range n).map f).Nodup := by
    apply List.Nodup.map_on _ List.nodup_range
    intro x hx y hy hxy
    simp only [List.mem_range] at hx hy
    rw [← hgf x hx, ← hgf y hy, hxy]
  have hl : ((List.range n).map f).length = n := by simp
  refine ⟨?_, ?_⟩
  · rw [hl]
    apply List.Subperm.perm_of_length_le _ (by simp)
    apply hnd.subperm
    intro x hx
    simp only [List.mem_map, List.mem_range] at hx ⊢
    obtain ⟨j, hj, rfl⟩ := hx; exact hf j hj
  · unfold permL
    rw [hl]
    apply List.map_congr_left
    intro q hq
    rw [List.mem_range] at hq
    have hgq := hg q hq
    have e : ((List.range n).map f)[g q]'(by simp; exact hgq) = q := by simp [hfg q hq]
    rw [← e, List.Nodup.idxOf_getElem hnd]
    simp [hfg q hq]

theorem gRecs_flatten (V : List (ℤ × ℤ)) : (V.map gRec).flatten = pairInts V := by
  rw [pairInts_eq]; rfl

theorem gRecs_getD (n : ℕ) (g : ℕ → ℕ) (V : List (ℤ × ℤ)) (hg : ∀ q < n, g q < V.length) :
    ((List.range n).map fun q => (V.map gRec).getD (g q) []) =
      ((List.range n).map fun q => V.getD (g q) (0, 0)).map gRec := by
  simp only [List.map_map]
  apply List.map_congr_left
  intro q hq; rw [List.mem_range] at hq
  simp [List.getD_eq_getElem?_getD, hg q hq, Function.comp]

theorem psKeys_spec (s t : ℕ) (hs : 0 < s) (hco : Nat.Coprime t s) (D : List (List ℤ)) :
    (psKeys s t).Perm (List.range (psKeys s t).length) ∧
      permL (psKeys s t) D =
        (List.range s).map fun (q : ℕ) => D.getD ((t : ZMod s)⁻¹ * (q : ZMod s)).val [] := by
  have : NeZero s := ⟨by omega⟩
  have hu : (t : ZMod s)⁻¹ * (t : ZMod s) = 1 := by
    rw [mul_comm]; exact ZMod.coe_mul_inv_eq_one t hco
  have e : ∀ i : ℕ, t * i % s = ((t : ZMod s) * (i : ZMod s)).val := by
    intro i; rw [← Nat.cast_mul, ZMod.val_natCast]
  unfold psKeys
  refine NLogN.Rsp.permL_map s (fun (i : ℕ) => t * i % s)
    (fun (q : ℕ) => ((t : ZMod s)⁻¹ * (q : ZMod s)).val) (fun _ _ => Nat.mod_lt _ hs) (fun _ _ => ZMod.val_lt _) ?_ ?_ D
  · intro q hq
    simp only [e, ZMod.natCast_val, ZMod.cast_id', id, ← mul_assoc,
      ZMod.coe_mul_inv_eq_one t hco, one_mul, ZMod.val_natCast, Nat.mod_eq_of_lt hq]
  · intro q hq
    simp only [e, ZMod.natCast_val, ZMod.cast_id', id, ← mul_assoc, hu, one_mul,
      ZMod.val_natCast, Nat.mod_eq_of_lt hq]

theorem permL_psKeys (s t : ℕ) (hs : 0 < s) (hco : Nat.Coprime t s) (W : List (ℤ × ℤ))
