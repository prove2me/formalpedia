lemma val_act [NeZero Q] {a : List ℕ} (ha : AModel.Valid sh a) (i : Fin n) :
    (act Λ a i).val = a.getD (Λ.pos i) 0 := by
  rw [act, ZMod.val_natCast, Nat.mod_eq_of_lt (ha.digit_lt Λ i)]

theorem swapMap_eq_vmap [NeZero Q] (i j : Fin n) {a : List ℕ} (ha : AModel.Valid sh a) :
    swapMap Λ i j a = vmap Λ (fun x => x ∘ Equiv.swap i j) a := by
  have hl := ha.length_eq
  apply List.ext_getElem (by simp [swapMap, vmap])
  intro k h₁ h₂
  simp only [vmap] at h₂ ⊢
  rw [getElem_setAct]
  simp only [swapMap, List.getElem_set]
  have inj : ∀ p q : Fin n, ((Λ.pos p : ℕ) = Λ.pos q) ↔ p = q := fun p q =>
    ⟨fun h => Λ.mono.injective (Fin.ext h), fun h => h ▸ rfl⟩
  cases h : Λ.actIdx k with
  | none =>
    have := Λ.actIdx_none h
    simp [this i, this j]
  | some m =>
    have hk := Λ.actIdx_some h
    subst hk
    simp only [Function.comp_apply, val_act Λ ha, inj, Equiv.swap_apply_def]
    have hm : (Λ.pos m : ℕ) < a.length := by omega
    by_cases hmj : j = m
    · subst hmj
      by_cases hij : j = i
      · subst hij; simp
      · simp [hij]
    · by_cases hmi : i = m
      · subst hmi; simp [hmj]
      · simp [hmj, hmi, Ne.symm hmj, Ne.symm hmi, List.getElem?_eq_getElem hm]

end Swap

namespace Step

lemma invVec_vec {s : AModel.Step n Q} (hs : s.WF) (x : Fin n → ZMod Q) : s.invVec (s.vec x) = x := by
  cases s with
  | shift i u c => exact shiftInvVec_shiftVec hs.1 hs.2 x
  | swap i j => funext k; simp [vec, invVec]

variable [NeZero Q]

lemma addr_eq (s : AModel.Step n Q) {a : List ℕ} (ha : AModel.Valid sh a) : s.addr Λ a = vmap Λ s.vec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma inv_eq (s : AModel.Step n Q) {a : List ℕ} (ha : AModel.Valid sh a) : s.inv Λ a = vmap Λ s.invVec a := by
  cases s with
  | shift i u c => rfl
  | swap i j => exact swapMap_eq_vmap Λ i j ha

lemma valid_addr (s : AModel.Step n Q) {a : List ℕ} (ha : AModel.Valid sh a) : AModel.Valid sh (s.addr Λ a) := by
  rw [addr_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma valid_inv (s : AModel.Step n Q) {a : List ℕ} (ha : AModel.Valid sh a) : AModel.Valid sh (s.inv Λ a) := by
  rw [inv_eq Λ s ha]; exact valid_vmap Λ _ ha

lemma inv_addr {s : AModel.Step n Q} (hs : s.WF) {a : List ℕ} (ha : AModel.Valid sh a) :
    s.inv Λ (s.addr Λ a) = a := by
  rw [addr_eq Λ s ha, inv_eq Λ s (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
  convert vmap_id Λ ha using 2
  funext x; exact invVec_vec hs x

end Step

section Run
variable [NeZero Q]

lemma run_eq_vmap (steps : List (AModel.Step n Q)) {a : List ℕ} (ha : AModel.Valid sh a) :
    AModel.run Λ steps a = vmap Λ (runVec steps) a := by
  induction steps generalizing a with
  | nil => exact (vmap_id Λ ha).symm
  | cons s rest ih =>
    simp only [AModel.run, List.foldl_cons] at ih ⊢
    rw [Step.addr_eq Λ s ha, ih (valid_vmap Λ _ ha), vmap_vmap Λ _ _ ha]
    rfl

lemma valid_run (steps : List (AModel.Step n Q)) {a : List ℕ} (ha : AModel.Valid sh a) :
    AModel.Valid sh (AModel.run Λ steps a) := by
  rw [run_eq_vmap Λ steps ha]; exact valid_vmap Λ _ ha

lemma invChain_run {steps : List (AModel.Step n Q)} (hs : ∀ s ∈ steps, s.WF) {a : List ℕ}
    (ha : AModel.Valid sh a) : invChain Λ steps (AModel.run Λ steps a) = a := by
  induction steps generalizing a with
  | nil => rfl
  | cons s rest ih =>
    simp only [AModel.run, List.foldl_cons, invChain, List.foldr_cons, Function.comp_apply] at ih ⊢
    rw [ih (fun t ht => hs t (List.mem_cons_of_mem _ ht)) (Step.valid_addr Λ s ha),
      Step.inv_addr Λ (hs s List.mem_cons_self) ha]

lemma runArr_pull {α : Type*} (d : α) (steps : List (AModel.Step n Q)) (g : List ℕ → List ℕ)
    (xs : List α) :
    AModel.runArr Λ d steps (AModel.pull sh sh g d xs) = AModel.pull sh sh (g ∘ invChain Λ steps) d xs := by
  induction steps generalizing g with
  | nil => rfl
  | cons s rest ih =>
    simp only [AModel.runArr, List.foldl_cons] at ih ⊢
    rw [Step.arr, pull_comp _ _ (fun a ha => Step.valid_inv Λ s ha), ih]
    rfl

/-- The array action of a list of steps is a single pull by the composed inverse. -/
theorem runArr_eq_pull {α : Type*} (d : α) (steps : List (AModel.Step n Q)) {xs : List α}
    (hxs : xs.length = AModel.vol sh) : AModel.runArr Λ d steps xs = AModel.pull sh sh (invChain Λ steps) d xs := by
  conv_lhs => rw [← pull_id d hxs]
  rw [runArr_pull]; rfl

end Run

section Bruhat

lemma runVec_append (l₁ l₂ : List (AModel.Step n Q)) (x : Fin n → ZMod Q) :
    runVec (l₁ ++ l₂) x = runVec l₂ (runVec l₁ x) := by
  simp [runVec, List.foldl_append]

variable {E : Matrix (Fin n) (Fin n) (ZMod Q)}

lemma shiftStep_vec (hE : ∀ i j, i < j → E i j = 0) (i : Fin n) (x : Fin n → ZMod Q) :
    (shiftStep E i).vec x = Function.update x i ((E *ᵥ x) i) := by
  simp only [shiftStep, Step.vec, shiftVec]
  congr 1
  simp only [mulVec, dotProduct]
  have : ∀ j, E i j * x j =
      (if j = i then E i i * x i else 0) + (if j < i then E i j else 0) * x j := by
    intro j
    rcases lt_trichotomy j i with h | h | h
    · simp [h, h.ne]
    · subst h; simp
    · simp [h.ne', not_lt.2 h.le, hE i j h]
  rw [Finset.sum_congr rfl (fun j _ => this j), Finset.sum_add_distrib, Finset.sum_ite_eq']
  simp

lemma mulVec_congr_le (hE : ∀ i j, i < j → E i j = 0) {x y : Fin n → ZMod Q} {k : Fin n}
    (h : ∀ m, m ≤ k → x m = y m) : (E *ᵥ x) k = (E *ᵥ y) k := by
  simp only [mulVec, dotProduct]
  refine Finset.sum_congr rfl fun m _ => ?_
  by_cases hm : m ≤ k
  · rw [h m hm]
  · rw [hE k m (not_le.1 hm), zero_mul, zero_mul]

/-- Shifts applied in strictly decreasing target order: each shift reads only earlier
coordinates, which later shifts (with smaller targets) have not yet touched. -/
lemma runVec_shifts_aux (hE : ∀ i j, i < j → E i j = 0) (l : List (Fin n))
    (hl : l.Pairwise (· > ·)) (x : Fin n → ZMod Q) :
    runVec (l.map (shiftStep E)) x = fun k => if k ∈ l then (E *ᵥ x) k else x k := by
  induction l generalizing x with
  | nil => funext k; simp [runVec]
  | cons i l ih =>
    rw [List.pairwise_cons] at hl
    have h1 : runVec ((i :: l).map (shiftStep E)) x =
        runVec (l.map (shiftStep E)) ((shiftStep E i).vec x) := rfl
    rw [h1, ih hl.2, shiftStep_vec hE]
    funext k
    by_cases hk : k ∈ l
    · have hki : k < i := hl.1 k hk
      simp only [hk, if_true, List.mem_cons, or_true]
      refine mulVec_congr_le hE fun m hm => ?_
      rw [Function.update_of_ne (ne_of_lt (lt_of_le_of_lt hm hki))]
    · simp only [hk, if_false, List.mem_cons, or_false]
      by_cases hki : k = i
      · subst hki; simp
      · simp [hki]

