theorem solution (k m : ℕ) {x₀ : ℝ} (hx₀ : x₀ ∈ UG) : ContinuousAt (J k m) x₀ := by
  refine intervalIntegral.continuousAt_of_dominated_interval (μ := volume) (a := (0:ℝ)) (b := 1)
    (bound := fun _ => (12 / 7 : ℝ) ^ (m + 1))
    (Eventually.of_forall fun y => Measurable.aestronglyMeasurable (by fun_prop)) ?_ ?_ ?_
  · filter_upwards [UG_open.mem_nhds hx₀] with y hy
    refine ae_of_all _ fun t ht => ?_
    have htI : t ∈ Ι (0:ℝ) 1 := ht
    rw [uIoc_of_le (by norm_num : (0:ℝ) ≤ 1)] at htI
    exact abs_J_bound hy ⟨le_of_lt htI.1, htI.2⟩
  · exact intervalIntegrable_const
  · refine ae_of_all _ fun t ht => ?_
    have htI : t ∈ Ι (0:ℝ) 1 := ht
    rw [uIoc_of_le (by norm_num : (0:ℝ) ≤ 1)] at htI
    show ContinuousAt (fun y : ℝ => t ^ k * (1 - t * y)⁻¹ ^ (m + 1)) x₀
    have hne : (1 - t * x₀) ≠ 0 := by
      have := one_sub_mul_ge hx₀ ⟨le_of_lt htI.1, htI.2⟩
      linarith
    fun_prop (disch := exact hne)
