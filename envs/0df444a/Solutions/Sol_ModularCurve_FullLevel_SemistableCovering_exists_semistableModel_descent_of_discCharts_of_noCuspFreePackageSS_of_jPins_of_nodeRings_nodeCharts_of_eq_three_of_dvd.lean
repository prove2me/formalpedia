  (ModularCurve.isCurveOver_and_essFiniteType_laurentBaseChange_xHFunctionField
    (AlgebraicClosure ℚ) (q ^ 2 * M') (levelH q M')).2

theorem false_of_residue_eq_zero_of_mul_eq_one {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A F Fbar) (t g : F) (ht : t ∈ R.integers) (hg : g ∈ R.integers)
    (h0 : R.residue ⟨t, ht⟩ = 0) (h1 : t * g = 1) : False := by
  have hmul : (⟨t, ht⟩ : R.integers) * ⟨g, hg⟩ = 1 := Subtype.ext (by simpa using h1)
  have hu : IsUnit (⟨t, ht⟩ : R.integers) := IsUnit.of_mul_eq_one _ hmul
  exact R.residue_ne_zero_of_isUnit hu h0

theorem exists_mul_eq_one_of_residue_ne_zero {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A F Fbar) (t : F) (ht : t ∈ R.integers)
    (h : R.residue ⟨t, ht⟩ ≠ 0) : ∃ g ∈ R.integers.toSubring, t * g = 1 := by
  obtain ⟨v, hv⟩ := R.isUnit_of_residue_ne_zero h
  refine ⟨((v⁻¹ : R.integersˣ) : R.integers), ((v⁻¹ : R.integersˣ) : R.integers).2, ?_⟩
  have := congrArg Subtype.val v.mul_inv
  rw [hv] at this
  simpa using this

theorem exists_mul_eq_one_of_isUnit {F : Type*} [Field F] (N : Subring F) (u : N) (hu : IsUnit u) :
    ∃ u' ∈ N, (u : F) * u' = 1 := by
  obtain ⟨v, hv⟩ := hu
  refine ⟨((v⁻¹ : Nˣ) : N), ((v⁻¹ : Nˣ) : N).2, ?_⟩
  have := congrArg Subtype.val v.mul_inv
  rw [hv] at this
  simpa using this

theorem coe_mul_eq_of_eq_pow_mul {F : Type*} [Field F] (N : Subring F) (xn yn u : N) (c : F) (h : c ∈ N) (w : ℕ)
    (key : xn * yn = ⟨c, h⟩ ^ w * u) : (yn : F) * (xn : F) = c ^ w * (u : F) := by
  have := congrArg Subtype.val key
  simp only [Subring.coe_mul, SubmonoidClass.coe_pow] at this
  rw [mul_comm]
  exact this

theorem residue_ne_zero_of_ord_eq_one {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) (g : F)
    (h : v.ord g = 1) : g ≠ 0 := by
  rintro rfl
  rw [Place.ord_zero] at h
  exact zero_ne_one h

theorem localRing_le_of_specializes {F : Type*} [Field F] (X : Scheme) [IsIntegral X] (φ : F ≃+* X.functionField)
    {x y : X} (h : x ⤳ y) : SemistableModel.localRing X φ y ≤ SemistableModel.localRing X φ x := by
  rintro f ⟨g, rfl⟩
  refine ⟨(X.presheaf.stalkSpecializes h).hom g, ?_⟩
  simp only [RingHom.coe_comp, Function.comp_apply]
  congr 1
  change (X.presheaf.stalkSpecializes h ≫ X.presheaf.stalkSpecializes _).hom g = _
  rw [TopCat.Presheaf.stalkSpecializes_comp]
  rfl

theorem integers_eq_of_le {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
    {Fbar₁ Fbar₂ : Type*} [Field Fbar₁] [Algebra (ResidueField A) Fbar₁] [Field Fbar₂] [Algebra (ResidueField A) Fbar₂]
    (R₁ : RegularProlongation A F Fbar₁) (R₂ : RegularProlongation A F Fbar₂)
    (h : R₁.integers ≤ R₂.integers) : R₁.integers = R₂.integers := by
  refine le_antisymm h ?_
  intro f hf2
  by_contra hf1
  have hf0 : f ≠ 0 := by rintro rfl; exact hf1 (zero_mem _)
  obtain ⟨c, hc, hres⟩ := R₁.exists_smul_mem f⁻¹ (inv_ne_zero hf0)
  have hu1 : IsUnit (⟨c • f⁻¹, hc⟩ : R₁.integers) := R₁.isUnit_of_residue_ne_zero hres
  have hc0 : c ≠ 0 := R₁.smul_const_ne_zero hc hres
  obtain ⟨v, hv⟩ := hu1
  have hvinv : (((v⁻¹ : R₁.integersˣ) : R₁.integers) : F) = (c • f⁻¹)⁻¹ := by
    have h1 := congrArg Subtype.val v.mul_inv
    rw [hv] at h1
    simp only [MulMemClass.coe_mul, OneMemClass.coe_one] at h1
    exact ((mul_eq_one_iff_inv_eq₀ (by
      intro h0; rw [h0, zero_mul] at h1; exact zero_ne_one h1)).mp h1).symm
  have hcR2 : algebraMap L F c ∈ R₂.integers := by
    have : algebraMap L F c = (c • f⁻¹) * f := by
      rw [Algebra.smul_def, mul_assoc, inv_mul_cancel₀ hf0, mul_one]
    rw [this]
    exact mul_mem (h hc) hf2
  have hcA : c ∈ A := (R₂.algebraMap_mem_iff c).mp hcR2
  have hcR1 : algebraMap L F c ∈ R₁.integers := (R₁.algebraMap_mem_iff c).mpr hcA
  apply hf1
  have : f = algebraMap L F c * (c • f⁻¹)⁻¹ := by
    rw [Algebra.smul_def, mul_inv, inv_inv, ← mul_assoc, mul_inv_cancel₀ (by simpa using hc0), one_mul]
  rw [this, ← hvinv]
  exact mul_mem hcR1 ((v⁻¹ : R₁.integersˣ) : R₁.integers).2

theorem not_mem_maximalIdeal_of_mul_eq_one {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A F Fbar) (μ : A) (v : F) (hv : v ∈ R.integers)
    (h : algebraMap L F (μ : L) * v = 1) : μ ∉ maximalIdeal A := by
  intro hm
  have hμ0 : (μ : L) ≠ 0 := by
    intro h0; rw [h0, map_zero, zero_mul] at h; exact zero_ne_one h
  have hv' : (algebraMap L F (μ : L))⁻¹ = v := (mul_eq_one_iff_inv_eq₀ (by simpa using hμ0)).mp h
  have hinvA : (μ : L)⁻¹ ∈ A := (R.algebraMap_mem_iff _).mp (by rw [map_inv₀, hv']; exact hv)
  have hunitA : IsUnit μ :=
    ⟨⟨μ, ⟨(μ : L)⁻¹, hinvA⟩, Subtype.ext (mul_inv_cancel₀ hμ0), Subtype.ext (inv_mul_cancel₀ hμ0)⟩, rfl⟩
  exact (IsLocalRing.mem_maximalIdeal _).mp hm hunitA

theorem exists_const_mul_of_residue_eq_zero {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A F Fbar) (f : F) (hf : f ∈ R.integers) (hf0 : f ≠ 0) (hres : R.residue ⟨f, hf⟩ = 0) :
    ∃ (a : A) (c : L), a ∈ maximalIdeal A ∧ c • f ∈ R.integers ∧ (a : L) * c = 1 ∧
      f = algebraMap L F (a : L) * (c • f) := by
  obtain ⟨c, hc, hres'⟩ := R.exists_smul_mem f hf0
  have hc0 : c ≠ 0 := R.smul_const_ne_zero hc hres'
  have hunit : IsUnit (⟨c • f, hc⟩ : R.integers) := R.isUnit_of_residue_ne_zero hres'
  have hfmax : (⟨f, hf⟩ : R.integers) ∈ maximalIdeal R.integers := by
    rw [← R.ker_residue]; exact hres
  have hcA : c ∉ A := by
    intro hcA
    have hcR : algebraMap L F c ∈ R.integers := (R.algebraMap_mem_iff c).mpr hcA
    have : (⟨c • f, hc⟩ : R.integers) = ⟨algebraMap L F c, hcR⟩ * ⟨f, hf⟩ :=
      Subtype.ext (by simp only [MulMemClass.coe_mul]; exact Algebra.smul_def c f)
    apply (IsLocalRing.mem_maximalIdeal _).mp _ hunit
    rw [this]
    exact Ideal.mul_mem_left _ _ hfmax
  have hciA : c⁻¹ ∈ A := (A.mem_or_inv_mem c).resolve_left hcA
  refine ⟨⟨c⁻¹, hciA⟩, c, ?_, hc, ?_, ?_⟩
  · rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    apply hcA
    rw [← A.valuation_le_one_iff]
    have h1 := (A.valuation_eq_one_iff _).mp hu
    change A.valuation c⁻¹ = 1 at h1
    rw [map_inv₀, inv_eq_one] at h1
    exact h1.le
  · exact inv_mul_cancel₀ hc0
  · change f = algebraMap L F c⁻¹ * (c • f)
    rw [Algebra.smul_def, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hc0, map_one, one_mul]

theorem exists_const_mul_of_residue_eq_zero₂ {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar₁ Fbar₂ : Type*} [Field Fbar₁] [Algebra (ResidueField A) Fbar₁] [Field Fbar₂]
    [Algebra (ResidueField A) Fbar₂]
    (R₁ : RegularProlongation A F Fbar₁) (R₂ : RegularProlongation A F Fbar₂) (f : F)
    (h₁ : f ∈ R₁.integers) (h₂ : f ∈ R₂.integers) (hf0 : f ≠ 0)
    (hr₁ : R₁.residue ⟨f, h₁⟩ = 0) (hr₂ : R₂.residue ⟨f, h₂⟩ = 0) :
    ∃ (a : A) (c : L), a ∈ maximalIdeal A ∧ c • f ∈ R₁.integers ∧ c • f ∈ R₂.integers ∧
      f = algebraMap L F (a : L) * (c • f) := by
  obtain ⟨a₁, c₁, ha₁, hc₁, hac₁, hf₁⟩ := exists_const_mul_of_residue_eq_zero R₁ f h₁ hf0 hr₁
  obtain ⟨a₂, c₂, ha₂, hc₂, hac₂, hf₂⟩ := exists_const_mul_of_residue_eq_zero R₂ f h₂ hf0 hr₂
  obtain ⟨d, hd | hd⟩ := ValuationRing.cond a₁ a₂
  ·
    have hc : c₁ = (d : L) * c₂ := by
      have e1 : (a₂ : L) = a₁ * d := by rw [← hd]; rfl
      have ha₂0 : (a₂ : L) ≠ 0 := fun h0 => by rw [h0, zero_mul] at hac₂; exact zero_ne_one hac₂
      have ha₁0 : (a₁ : L) ≠ 0 := fun h0 => by rw [h0, zero_mul] at hac₁; exact zero_ne_one hac₁
      have : c₁ = (a₁ : L)⁻¹ := (mul_eq_one_iff_inv_eq₀ ha₁0).mp hac₁ |>.symm
      have : c₂ = (a₂ : L)⁻¹ := (mul_eq_one_iff_inv_eq₀ ha₂0).mp hac₂ |>.symm
      subst c₁ c₂
      have hd0 : (d : L) ≠ 0 := fun h0 => by rw [h0, mul_zero] at e1; exact ha₂0 e1
      rw [e1, mul_inv, mul_left_comm, mul_inv_cancel₀ hd0, mul_one]
    refine ⟨a₁, c₁, ha₁, hc₁, ?_, hf₁⟩
    have : c₁ • f = algebraMap L F (d : L) * (c₂ • f) := by
      rw [hc, Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
    rw [this]
    exact mul_mem ((R₂.algebraMap_mem_iff _).mpr d.2) hc₂
  · have hc : c₂ = (d : L) * c₁ := by
      have e1 : (a₁ : L) = a₂ * d := by rw [← hd]; rfl
      have ha₂0 : (a₂ : L) ≠ 0 := fun h0 => by rw [h0, zero_mul] at hac₂; exact zero_ne_one hac₂
      have ha₁0 : (a₁ : L) ≠ 0 := fun h0 => by rw [h0, zero_mul] at hac₁; exact zero_ne_one hac₁
      have : c₁ = (a₁ : L)⁻¹ := (mul_eq_one_iff_inv_eq₀ ha₁0).mp hac₁ |>.symm
      have : c₂ = (a₂ : L)⁻¹ := (mul_eq_one_iff_inv_eq₀ ha₂0).mp hac₂ |>.symm
      subst c₁ c₂
      have hd0 : (d : L) ≠ 0 := fun h0 => by rw [h0, mul_zero] at e1; exact ha₁0 e1
      rw [e1, mul_inv, mul_left_comm, mul_inv_cancel₀ hd0, mul_one]
    refine ⟨a₂, c₂, ha₂, ?_, hc₂, hf₂⟩
    have : c₂ • f = algebraMap L F (d : L) * (c₁ • f) := by
      rw [hc, Algebra.smul_def, Algebra.smul_def, map_mul, mul_assoc]
    rw [this]
    exact mul_mem ((R₁.algebraMap_mem_iff _).mpr d.2) hc₁

theorem residue_eq_transport {K F : Type*} [Field K] [Field F] [Algebra K F] {Q Q' : Place K F} (h : Q = Q')
    {g g' : F} (hg : g = g') (m : g ∈ Q.toValuationSubring) (m' : g' ∈ Q'.toValuationSubring) (c : K)
    (hc : IsLocalRing.residue ↥Q.toValuationSubring ⟨g, m⟩ = algebraMap K Q.ResidueField c) :
    IsLocalRing.residue ↥Q'.toValuationSubring ⟨g', m'⟩ = algebraMap K Q'.ResidueField c := by
  subst h hg
  exact hc

theorem ideal_eq_bot_or_eq_maximalIdeal_of_hrk {L : Type*} [Field L] (A : ValuationSubring L)
    (hrk : ∀ a b : ↥A, a ∈ maximalIdeal ↥A → b ≠ 0 → ∃ n : ℕ, b ∣ a ^ n) (p : Ideal ↥A) (hp : p.IsPrime) :
    p = ⊥ ∨ p = maximalIdeal ↥A := by
  by_cases h : p = ⊥
  · exact Or.inl h
  · right
    obtain ⟨b, hbp, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot h
    refine le_antisymm (IsLocalRing.le_maximalIdeal hp.ne_top) ?_
    intro a ha
    obtain ⟨n, c, hc⟩ := hrk a b ha hb0
    have : a ^ n ∈ p := by rw [hc]; exact Ideal.mul_mem_right _ _ hbp
    exact hp.mem_of_pow_mem n this

theorem exists_mem_of_isResidueDisc {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F]
    [Algebra L F] {Fbar : Type*} [Field Fbar] [Algebra (ResidueField A) Fbar]
    (R : RegularProlongation A F Fbar) {Q : Place (ResidueField A) Fbar} {D : Set (Place L F)} {z : F}
    (h : R.IsResidueDisc Q D z) : ∃ P, P ∈ D := by
  obtain ⟨-, hz, -, hbij, -, -⟩ := h.1
  obtain ⟨P, hP, -⟩ := hbij 0 (by rw [map_zero]; exact zero_lt_one)
  exact ⟨P, hP.1⟩

theorem not_reads_of_mem_nodes_of_forall_not_package
    {L : Type} [Field L] [IsAlgClosed L] (A : ValuationSubring L)
    (hrk : ∀ a b : ↥A, a ∈ maximalIdeal ↥A → b ≠ 0 → ∃ n : ℕ, b ∣ a ^ n)
    (hA : (A : Set L) ≠ Set.univ)
    [HenselianLocalRing ↥A]
    {F : Type} [Field F] [Algebra L F] [IsCurveOver L F] [Algebra.EssFiniteType L F]
    (X : Scheme.{0}) (toBase : X ⟶ Spec (CommRingCat.of ↥A))
    [IsIntegral X] [IsProper toBase] [Flat toBase] [LocallyOfFinitePresentation toBase]
    (φ : F ≃+* X.functionField)
    (hφ : ∀ a : ↥A, φ (algebraMap L F (a : L)) = SemistableModel.baseToFunctionField toBase a)
    (η : X) (hη : toBase.base η = closedPoint ↥A)
    {Fbar : Type} [Field Fbar] [Algebra (ResidueField ↥A) Fbar]
    (R : RegularProlongation A F Fbar)
    (hR : R.integers.toSubring = SemistableModel.localRing X φ η)
    (Nn : Finset (Place (ResidueField ↥A) Fbar))
    (hNoPkg : ∀ Q ∈ Nn, ∀ (S : Subring F) (φT : Polynomial ↥A →+* ↥S) (χ₀ : ↥S →+* ResidueField ↥A) (Dp : Set (Place L F)),
      ¬ (
            (∀ a : ↥A, algebraMap L F (a : L) ∈ S) ∧
            (φT).FormallySmooth ∧ (φT).FormallyUnramified ∧
            (∀ a : ↥A, ((φT (Polynomial.C a) : ↥(S)) : F) = algebraMap L F (a : L)) ∧
            (∀ a : ↥A, χ₀ (φT (Polynomial.C a)) = IsLocalRing.residue ↥A a) ∧
            χ₀ (φT Polynomial.X) = 0 ∧
            (∀ c : ↥A, IsLocalRing.residue ↥A c = 0 →
              ∃! χ : ↥(S) →+* ↥A, (∀ a : ↥A, χ (φT (Polynomial.C a)) = a) ∧
                (∀ f : ↥(S), IsLocalRing.residue ↥A (χ f) = χ₀ f) ∧ χ (φT Polynomial.X) = c) ∧
            (∀ f : ↥(S), ∃ hR : (f : F) ∈ R.integers, ∃ hm : R.residue ⟨(f : F), hR⟩ ∈ Q.toValuationSubring,
              IsLocalRing.residue ↥Q.toValuationSubring ⟨R.residue ⟨(f : F), hR⟩, hm⟩ =
                algebraMap (ResidueField ↥A) Q.ResidueField (χ₀ f)) ∧
            (∃ hR : ((φT Polynomial.X : ↥(S)) : F) ∈ R.integers,
              Q.ord (R.residue ⟨((φT Polynomial.X : ↥(S)) : F), hR⟩) = 1) ∧
            (∀ P, P ∈ Dp ↔ (P.IsRational ∧ (∀ f : ↥(S), (f : F) ∈ P.toValuationSubring ∧ P.evalAt (f : F) ∈ A) ∧
              (∀ f : ↥(S), A.valuation (P.evalAt (f : F)) < 1 ↔ χ₀ f = 0))) ∧
            (∀ χ : ↥(S) →+* ↥A, (∀ a : ↥A, χ (φT (Polynomial.C a)) = a) →
              (∀ f : ↥(S), IsLocalRing.residue ↥A (χ f) = χ₀ f) →
              ∃! P, P ∈ Dp ∧ ∀ f : ↥(S), P.evalAt (f : F) = ((χ f : ↥A) : L)) ∧
            (∀ P ∈ Dp, ∀ f : F, f ∈ P.toValuationSubring ↔
              ∃ g h : ↥(S), P.evalAt (h : F) ≠ 0 ∧ f * (h : F) = (g : F)) ∧
            (∀ f : F, f ≠ 0 → (∀ P ∈ Dp, P.ord f = 0) →
              ∃ (c : L) (u : (↥(S))ˣ), c ≠ 0 ∧ algebraMap L F c * f = ((u : ↥(S)) : F)) ∧
            (∀ f : F, f ∈ R.integers → (∀ P ∈ Dp, f ∈ P.toValuationSubring) → f ∈ S)))
    (Q : Place (ResidueField ↥A) Fbar) (hQ : Q ∈ Nn)
    (y : X) (hy : toBase.base y = closedPoint ↥A) (hyc : ∀ y' : X, y ⤳ y' → y' = y) (hηy : η ⤳ y) (hne : η ≠ y)
    (hys : y ∈ toBase.smoothLocus) :
    ¬ (∀ (f : F) (hf : f ∈ R.integers), f ∈ SemistableModel.localRing X φ y → R.residue ⟨f, hf⟩ ∈ Q.toValuationSubring) := by
  intro hread
  obtain ⟨Qy, φT, χ₀, Dp, _hrat, huq, hpk⟩ :=
    AlgebraicCurve.exists_smoothPointPackage_localRing_of_mem_smoothLocus_of_isProper A hrk hA X toBase φ hφ y hy hyc hys
      η hηy hne hη R hR
  have hQ' : Q = Qy := huq Q (fun f => by
    obtain ⟨hRf, -, -⟩ := hpk.2.2.2.2.2.2.2.1 f
    exact ⟨hRf, hread (f : F) hRf f.2⟩)
  subst hQ'
  exact hNoPkg Q hQ (SemistableModel.localRing X φ y) φT χ₀ Dp hpk

theorem residue_place_algebraMap {K Fbar : Type*} [Field K] [Field Fbar] [Algebra K Fbar]
    (Q : Place K Fbar) (c : K) :
    IsLocalRing.residue ↥Q.toValuationSubring ⟨algebraMap K Fbar c, Q.algebraMap_mem' c⟩ =
      algebraMap K Q.ResidueField c := by
  have ha : (⟨algebraMap K Fbar c, Q.algebraMap_mem' c⟩ : ↥Q.toValuationSubring) =
      algebraMap K ↥Q.toValuationSubring c := Subtype.ext (Q.coe_algebraMap c).symm
  rw [ha, ← ResidueField.algebraMap_eq, ← IsScalarTower.algebraMap_apply K ↥Q.toValuationSubring Q.ResidueField]

theorem false_of_chart_dominates_nodeRing
    {L F Fbar : Type*} [Field L] [Field F] [Algebra L F] [Field Fbar]
    {A : ValuationSubring L} [Algebra (ResidueField ↥A) Fbar]
    (R : RegularProlongation A F Fbar)
    (N : Finset (Place (ResidueField ↥A) Fbar))
    (disc : Place (ResidueField ↥A) Fbar → Set (Place L F)) (coord : Place (ResidueField ↥A) Fbar → F)
    (hDF : R.DiscFamily N disc coord)
    (hinf : {Q : Place (ResidueField ↥A) Fbar | Q ∉ N}.Infinite)
    (hfin : ∀ t : F, t ≠ 0 → {w : Place L F | w.ord t ≠ 0}.Finite)
    (N₀ : Subring F) [IsLocalRing ↥N₀] (C' : Subring L)
    (hconst : ∀ g : ↥N₀, ∃ (o : ↥C') (h : algebraMap L F (o : L) ∈ N₀), ¬ IsUnit (g - ⟨_, h⟩))
    (hC'A : ∀ c : L, c ∈ C' → c ∈ A)
    (hAN₀ : ∀ a : ↥A, a ∈ maximalIdeal ↥A → ∀ h : algebraMap L F (a : L) ∈ N₀, ¬ IsUnit (⟨_, h⟩ : ↥N₀))
    (Bx : Subring F) (hBxN₀ : ∀ f : F, f ∈ Bx → f ∈ N₀)
    (hN₀Bx : ∀ f : F, f ∈ N₀ ↔ ∃ g h : F, g ∈ Bx ∧ h ∈ Bx ∧ (∀ hh : h ∈ N₀, IsUnit (⟨h, hh⟩ : ↥N₀)) ∧ f * h = g)
    (Tg : Finset F)
    (hBxfg : Bx = Subring.closure ({f : F | ∃ c : L, c ∈ C' ∧ f = algebraMap L F c} ∪ (↑Tg : Set F)))
    (hBxR : ∀ f : F, f ∈ Bx → f ∈ R.integers)
    (H : ∀ (f : F) (hB : f ∈ Bx), ¬ IsUnit (⟨f, hBxN₀ f hB⟩ : ↥N₀) → R.residue ⟨f, hBxR f hB⟩ = 0)
    (dom : Set (Place L F))
    (hmem : ∀ P : Place L F, ((∀ f : F, f ∈ N₀ → f ∈ P.toValuationSubring) ∧
      (∀ f : ↥N₀, ¬ IsUnit f → ∃ h : P.evalAt (f : F) ∈ A, (⟨_, h⟩ : ↥A) ∈ maximalIdeal ↥A)) → P ∈ dom)
    (hdisj : ∀ (P : Place L F) (Q : Place (ResidueField ↥A) Fbar), Q ∉ N → P ∈ disc Q → P ∉ dom) : False := by
  classical
  have hCBx : ∀ c : L, c ∈ C' → algebraMap L F c ∈ Bx := fun c hc => by
    rw [hBxfg]; exact Subring.subset_closure (Or.inl ⟨c, hc, rfl⟩)

  let S : Set (Place L F) := ⋃ t ∈ (↑Tg : Set F), {w : Place L F | t ≠ 0 ∧ w.ord t ≠ 0}
  have hSfin : S.Finite := by
    refine Set.Finite.biUnion Tg.finite_toSet (fun t _ => ?_)
    by_cases ht : t = 0
    · have : {w : Place L F | t ≠ 0 ∧ w.ord t ≠ 0} = ∅ := by
        ext w; simp [ht]
      rw [this]; exact Set.finite_empty
    · exact (hfin t ht).subset (fun w hw => hw.2)
  let Bad : Set (Place (ResidueField ↥A) Fbar) := {Q | Q ∉ N ∧ ∃ w ∈ S, w ∈ disc Q}
  have hBadfin : Bad.Finite := by
    have hw : ∀ Q : ↥Bad, ∃ w : Place L F, w ∈ S ∧ w ∈ disc (Q : Place (ResidueField ↥A) Fbar) := fun Q => by
      obtain ⟨-, w, hwS, hwD⟩ := Q.2
      exact ⟨w, hwS, hwD⟩
    choose wit hwitS hwitD using hw
    haveI : Finite ↥S := hSfin.to_subtype
    have hfinBad : Finite ↥Bad := by
      refine Finite.of_injective (fun Q => (⟨wit Q, hwitS Q⟩ : ↥S)) ?_
      intro Q₁ Q₂ h
      have h' : wit Q₁ = wit Q₂ := congrArg Subtype.val h
      apply Subtype.ext
      exact hDF.2 _ _ Q₁.2.1 Q₂.2.1 (wit Q₁) (hwitD Q₁) (h' ▸ hwitD Q₂)
    exact Set.toFinite Bad

  obtain ⟨Q, hQN, hQgood⟩ : ∃ Q, Q ∉ N ∧ Q ∉ Bad := by
    obtain ⟨Q, hQ⟩ := (hinf.diff hBadfin).nonempty
    exact ⟨Q, hQ.1, hQ.2⟩
  obtain ⟨hDC, hPW, -⟩ := hDF.1 Q hQN
  obtain ⟨hDdata, hz, -, hbij, -, -⟩ := hDC
  have hTreg : ∀ t ∈ Tg, ∀ w ∈ disc Q, t ∈ w.toValuationSubring := by
    intro t ht w hw
    by_cases ht0 : t = 0
    · rw [ht0]; exact zero_mem _
    by_contra hnot
    have hord : w.ord t ≠ 0 := fun h0 => hnot (w.mem_toValuationSubring_of_ord_nonneg_alt ht0 h0.ge)
    have hwS : w ∈ S := by
      refine Set.mem_biUnion (Finset.mem_coe.mpr ht) ?_
      exact ⟨ht0, hord⟩
    exact hQgood ⟨hQN, w, hwS, hw⟩
  have hBxreg : ∀ f : F, f ∈ Bx → ∀ w ∈ disc Q, f ∈ w.toValuationSubring := by
    intro f hf w hw
    rw [hBxfg] at hf
    have hle : Subring.closure ({f : F | ∃ c : L, c ∈ C' ∧ f = algebraMap L F c} ∪ (↑Tg : Set F)) ≤
        w.toValuationSubring.toSubring := by
      rw [Subring.closure_le]
      rintro g (⟨c, -, rfl⟩ | hg)
      · exact w.algebraMap_mem' c
      · exact hTreg g hg w hw
    exact hle hf

  obtain ⟨P, ⟨hP, -⟩, -⟩ := hbij 0 (by rw [map_zero]; exact zero_lt_one)
  have hPrat : P.IsRational := (hDdata P hP).1

  have hnu : ∀ (g : F) (hB : g ∈ Bx), ¬ IsUnit (⟨g, hBxN₀ g hB⟩ : ↥N₀) →
      ∃ h : P.evalAt g ∈ A, (⟨_, h⟩ : ↥A) ∈ maximalIdeal ↥A := by
    intro g hB hgnu
    obtain ⟨hm, h, heq⟩ := hPW P hP hPrat g (hBxR g hB) (hBxreg g hB)
    refine ⟨h, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff]
    apply (algebraMap (ResidueField ↥A) Q.ResidueField).injective
    rw [heq, map_zero]
    have : (⟨R.residue ⟨g, hBxR g hB⟩, hm⟩ : ↥Q.toValuationSubring) = 0 := Subtype.ext (H g hB hgnu)
    rw [this, map_zero]

  have hun : ∀ (hh : F) (hB : hh ∈ Bx), IsUnit (⟨hh, hBxN₀ hh hB⟩ : ↥N₀) →
      ∃ h : P.evalAt hh ∈ A, (⟨_, h⟩ : ↥A) ∉ maximalIdeal ↥A := by
    intro hh hB hu
    obtain ⟨o, ho, hnuo⟩ := hconst ⟨hh, hBxN₀ hh hB⟩
    have hoA : (o : L) ∈ A := hC'A _ o.2
    have hoBx : algebraMap L F (o : L) ∈ Bx := hCBx _ o.2
    have hmBx : hh - algebraMap L F (o : L) ∈ Bx := Bx.sub_mem hB hoBx
    have hm_nu : ¬ IsUnit (⟨hh - algebraMap L F (o : L), hBxN₀ _ hmBx⟩ : ↥N₀) := by
      have : (⟨hh - algebraMap L F (o : L), hBxN₀ _ hmBx⟩ : ↥N₀) = ⟨hh, hBxN₀ hh hB⟩ - ⟨_, ho⟩ := rfl
      rw [this]; exact hnuo
    have ho_unit : IsUnit (⟨algebraMap L F (o : L), ho⟩ : ↥N₀) := by
      by_contra hon
      apply (IsLocalRing.mem_maximalIdeal _).mp ?_ hu
      have : (⟨hh, hBxN₀ hh hB⟩ : ↥N₀) = ⟨algebraMap L F (o : L), ho⟩ + ⟨hh - algebraMap L F (o : L), hBxN₀ _ hmBx⟩ :=
        Subtype.ext (by simp)
      rw [this]
      exact (maximalIdeal ↥N₀).add_mem ((IsLocalRing.mem_maximalIdeal _).mpr hon)
        ((IsLocalRing.mem_maximalIdeal _).mpr hm_nu)
    have ho_nm : (⟨(o : L), hoA⟩ : ↥A) ∉ maximalIdeal ↥A := fun hom => hAN₀ ⟨(o : L), hoA⟩ hom ho ho_unit
    have hres_m : R.residue ⟨hh - algebraMap L F (o : L), hBxR _ hmBx⟩ = 0 := H _ hmBx hm_nu
    have hres_h : R.residue ⟨hh, hBxR hh hB⟩ =
        algebraMap (ResidueField ↥A) Fbar (IsLocalRing.residue ↥A ⟨(o : L), hoA⟩) := by
      have hsplit : (⟨hh, hBxR hh hB⟩ : ↥R.integers) =
          ⟨algebraMap L F (o : L), (R.algebraMap_mem_iff _).mpr hoA⟩ + ⟨hh - algebraMap L F (o : L), hBxR _ hmBx⟩ :=
        Subtype.ext (by simp)
      rw [hsplit, map_add, hres_m, add_zero]
      exact R.residue_algebraMap ⟨(o : L), hoA⟩
    obtain ⟨hm, h, heq⟩ := hPW P hP hPrat hh (hBxR hh hB) (hBxreg hh hB)
    refine ⟨h, fun hmax => ?_⟩
    have hz0 : IsLocalRing.residue ↥A ⟨P.evalAt hh, h⟩ = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hmax
    have hcst : IsLocalRing.residue ↥Q.toValuationSubring ⟨R.residue ⟨hh, hBxR hh hB⟩, hm⟩ =
        algebraMap (ResidueField ↥A) Q.ResidueField (IsLocalRing.residue ↥A ⟨(o : L), hoA⟩) := by
      have : (⟨R.residue ⟨hh, hBxR hh hB⟩, hm⟩ : ↥Q.toValuationSubring) =
          ⟨algebraMap (ResidueField ↥A) Fbar (IsLocalRing.residue ↥A ⟨(o : L), hoA⟩), Q.algebraMap_mem' _⟩ :=
        Subtype.ext hres_h
      rw [this, residue_place_algebraMap]
    rw [hz0, map_zero, hcst] at heq
    have : IsLocalRing.residue ↥A ⟨(o : L), hoA⟩ = 0 :=
      (algebraMap (ResidueField ↥A) Q.ResidueField).injective (by rw [map_zero]; exact heq.symm)
    exact ho_nm ((IsLocalRing.residue_eq_zero_iff _).mp this)

  have key : ∀ f : F, f ∈ N₀ → f ∈ P.toValuationSubring ∧ ∃ h : P.evalAt f ∈ A,
      (∀ hf : f ∈ N₀, ¬ IsUnit (⟨f, hf⟩ : ↥N₀) → (⟨_, h⟩ : ↥A) ∈ maximalIdeal ↥A) := by
    intro f hf
    obtain ⟨g, hh, hgB, hhB, hhu, hfg⟩ := (hN₀Bx f).mp hf
    have hhU : IsUnit (⟨hh, hBxN₀ hh hhB⟩ : ↥N₀) := hhu (hBxN₀ hh hhB)
    obtain ⟨hA, hhnm⟩ := hun hh hhB hhU
    have hne : hh ≠ 0 := by
      intro h0
      apply not_isUnit_zero (M₀ := ↥N₀)
      have : (⟨hh, hBxN₀ hh hhB⟩ : ↥N₀) = 0 := Subtype.ext h0
      rw [← this]; exact hhU
    have hhP : hh ∈ P.toValuationSubring := hBxreg hh hhB P hP
    have hgP : g ∈ P.toValuationSubring := hBxreg g hgB P hP
    have hh0 : P.evalAt hh ≠ 0 := by
      intro h0
      apply hhnm
      have : (⟨P.evalAt hh, hA⟩ : ↥A) = 0 := Subtype.ext h0
      rw [this]; exact (maximalIdeal ↥A).zero_mem

    have hres : IsLocalRing.residue ↥P.toValuationSubring ⟨hh, hhP⟩ ≠ 0 := by
      intro hzr
      apply hh0
      have := P.algebraMap_evalAt hPrat hhP
      rw [hzr] at this
      exact (algebraMap L P.ResidueField).injective (this.trans (map_zero _).symm)
    have hUP : IsUnit (⟨hh, hhP⟩ : ↥P.toValuationSubring) := (IsLocalRing.residue_ne_zero_iff_isUnit _).mp hres
    obtain ⟨u, hu⟩ := hUP
    have hinv_val : (((u⁻¹ : (↥P.toValuationSubring)ˣ) : ↥P.toValuationSubring) : F) = hh⁻¹ := by
      have hmul := congrArg Subtype.val u.mul_inv
      rw [hu] at hmul
      have hmul' : hh * (((u⁻¹ : (↥P.toValuationSubring)ˣ) : ↥P.toValuationSubring) : F) = 1 := by simpa using hmul
      exact (eq_inv_of_mul_eq_one_right hmul').symm ▸ rfl
    have hhinvP : hh⁻¹ ∈ P.toValuationSubring := by rw [← hinv_val]; exact SetLike.coe_mem _
    have hf_eq : f = g * hh⁻¹ := by rw [← hfg, mul_assoc, mul_inv_cancel₀ hne, mul_one]
    have hev_inv : P.evalAt hh⁻¹ = (P.evalAt hh)⁻¹ := by
      have hm1 := P.evalAt_mul_of_mem hPrat hhP hhinvP
      rw [mul_inv_cancel₀ hne, P.evalAt_one] at hm1
      exact (eq_inv_of_mul_eq_one_right hm1.symm)
    have hevf : P.evalAt f = P.evalAt g * (P.evalAt hh)⁻¹ := by
      rw [hf_eq, P.evalAt_mul_of_mem hPrat hgP hhinvP, hev_inv]

    have hhAunit : IsUnit (⟨P.evalAt hh, hA⟩ : ↥A) := by
      by_contra hnu'; exact hhnm ((IsLocalRing.mem_maximalIdeal _).mpr hnu')
    obtain ⟨v, hv⟩ := hhAunit
    have hvinv : (((v⁻¹ : (↥A)ˣ) : ↥A) : L) = (P.evalAt hh)⁻¹ := by
      have hmul := congrArg Subtype.val v.mul_inv
      rw [hv] at hmul
      have hmul' : P.evalAt hh * (((v⁻¹ : (↥A)ˣ) : ↥A) : L) = 1 := by simpa using hmul
      exact eq_inv_of_mul_eq_one_right hmul'
    obtain ⟨-, hgA, -⟩ := hPW P hP hPrat g (hBxR g hgB) (hBxreg g hgB)
    have hfA : P.evalAt f ∈ A := by
      rw [hevf, ← hvinv]; exact A.mul_mem _ _ hgA (SetLike.coe_mem _)
    refine ⟨by rw [hf_eq]; exact mul_mem hgP hhinvP, hfA, fun hf' hfnu => ?_⟩

    have hgnu : ¬ IsUnit (⟨g, hBxN₀ g hgB⟩ : ↥N₀) := by
      intro hgU
      apply hfnu
      have : (⟨g, hBxN₀ g hgB⟩ : ↥N₀) = ⟨f, hf'⟩ * ⟨hh, hBxN₀ hh hhB⟩ := Subtype.ext hfg.symm
      rw [this] at hgU
      exact (IsUnit.mul_iff.mp hgU).1
    obtain ⟨hgA', hgm⟩ := hnu g hgB hgnu
    have : (⟨P.evalAt f, hfA⟩ : ↥A) = ⟨P.evalAt g, hgA'⟩ * ((v⁻¹ : (↥A)ˣ) : ↥A) :=
      Subtype.ext (by change P.evalAt f = P.evalAt g * (((v⁻¹ : (↥A)ˣ) : ↥A) : L); rw [hevf, hvinv])
    rw [this]
    exact (maximalIdeal ↥A).mul_mem_right _ hgm
  have hPdom : P ∈ dom := hmem P ⟨fun f hf => (key f hf).1, fun f hfnu => by
    obtain ⟨-, h, hm⟩ := key (f : F) f.2
    exact ⟨h, hm f.2 (by simpa using hfnu)⟩⟩
  exact hdisj P Q hQN hP hPdom

theorem finite_setOf_ord_ne_zero' {K F : Type*} [Field K] [Field F] [Algebra K F] [HasPrincipalDivisors K F]
    (t : F) (ht : t ≠ 0) : {w : Place K F | w.ord t ≠ 0}.Finite := by
  obtain ⟨D, hD, -⟩ := HasPrincipalDivisors.exists_divisor (K := K) t ht
  refine D.finite_support.subset (fun w hw => ?_)
  simp only [Function.mem_support, Set.mem_setOf_eq] at hw ⊢
  rwa [hD w]

theorem mem_and_not_isUnit_of_ord_pos {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F)
    {f : F} (hf : f ≠ 0) (h : 0 < v.ord f) :
    ∃ hm : f ∈ v.toValuationSubring, ¬ IsUnit (⟨f, hm⟩ : ↥v.toValuationSubring) := by
  refine ⟨v.mem_toValuationSubring_of_ord_nonneg_alt hf h.le, fun hu => ?_⟩
  obtain ⟨u, hu⟩ := hu
  have := v.ord_coe_unit u
  rw [hu] at this
  simp at this
  omega

theorem infinite_place_of_isCurveOver {K F : Type*} [Field K] [IsAlgClosed K] [Field F] [Algebra K F]
    [IsCurveOver K F] (Q₀ : Place K F) : Infinite (Place K F) := by
  classical
  haveI : HasPrincipalDivisors K F := IsCurveOver.hasPrincipalDivisors

  obtain ⟨t, ht⟩ : ∃ t : F, t ∉ Q₀.toValuationSubring := by
    by_contra h
    push_neg at h
    exact Q₀.ne_top' (eq_top_iff.mpr (fun x _ => h x))

  have hpole : ∀ a : K, t - algebraMap K F a ∉ Q₀.toValuationSubring := fun a hm =>
    ht (by simpa using add_mem hm (Q₀.algebraMap_mem' a))
  have hne : ∀ a : K, t - algebraMap K F a ≠ 0 := fun a h0 => hpole a (h0.symm ▸ zero_mem _)
  have hneg : ∀ a : K, Q₀.ord (t - algebraMap K F a) < 0 := fun a => by
    by_contra hge
    push_neg at hge
    exact hpole a (Q₀.mem_toValuationSubring_of_ord_nonneg_alt (hne a) hge)
  have hzero : ∀ a : K, ∃ v : Place K F, 0 < v.ord (t - algebraMap K F a) := by
    intro a
    obtain ⟨D, hD, hdeg⟩ := HasPrincipalDivisors.exists_divisor (K := K) (t - algebraMap K F a) (hne a)
    by_contra hall
    push_neg at hall

    have hdeg' : Divisor.degree D = ∑ v ∈ D.support, D v := by
      rw [Divisor.degree, Finsupp.liftAddHom_apply, Finsupp.sum]
      refine Finset.sum_congr rfl (fun v _ => ?_)
      rw [AddMonoidHom.mulRight_apply, IsCurveOver.deg_eq_one_of_isAlgClosed (K := K) v]
      simp
    have hsum : ∑ v ∈ D.support, D v < 0 := by
      have hQ₀ : Q₀ ∈ D.support := by
        rw [Finsupp.mem_support_iff, hD]; exact (hneg a).ne
      have hle : ∑ v ∈ D.support, D v ≤ D Q₀ := by
        rw [← Finset.add_sum_erase _ _ hQ₀]
        have : ∑ v ∈ D.support.erase Q₀, D v ≤ 0 :=
          Finset.sum_nonpos (fun v _ => by rw [hD]; exact hall v)
        linarith
      calc ∑ v ∈ D.support, D v ≤ D Q₀ := hle
        _ < 0 := by rw [hD]; exact hneg a
    rw [hdeg'] at hdeg
    exact absurd hdeg hsum.ne
  choose z hz using hzero
  refine Infinite.of_injective z (fun a b hab => ?_)
  by_contra hne'
  obtain ⟨hma, hua⟩ := mem_and_not_isUnit_of_ord_pos (z a) (hne a) (hz a)
  have hzb : 0 < (z a).ord (t - algebraMap K F b) := by rw [hab]; exact hz b
  obtain ⟨hmb, hub⟩ := mem_and_not_isUnit_of_ord_pos (z a) (hne b) hzb

  have hdiff : (⟨t - algebraMap K F a, hma⟩ : ↥(z a).toValuationSubring) -
      ⟨t - algebraMap K F b, hmb⟩ = ⟨algebraMap K F (b - a), (z a).algebraMap_mem' _⟩ :=
    Subtype.ext (by simp [map_sub])
  have hmax : (⟨algebraMap K F (b - a), (z a).algebraMap_mem' _⟩ : ↥(z a).toValuationSubring) ∈
      maximalIdeal ↥(z a).toValuationSubring := by
    rw [← hdiff]
    exact Ideal.sub_mem _ ((IsLocalRing.mem_maximalIdeal _).mpr hua) ((IsLocalRing.mem_maximalIdeal _).mpr hub)
  have hunit : IsUnit (⟨algebraMap K F (b - a), (z a).algebraMap_mem' _⟩ : ↥(z a).toValuationSubring) := by
    have hba : algebraMap K F (b - a) ≠ 0 := by rw [map_ne_zero]; exact sub_ne_zero.mpr (Ne.symm hne')
    refine ⟨⟨⟨algebraMap K F (b - a), (z a).algebraMap_mem' _⟩, ⟨(algebraMap K F (b - a))⁻¹, ?_⟩,
      Subtype.ext (mul_inv_cancel₀ hba), Subtype.ext (inv_mul_cancel₀ hba)⟩, rfl⟩
    rw [← map_inv₀]; exact (z a).algebraMap_mem' _
  exact (IsLocalRing.mem_maximalIdeal _).mp hmax hunit

end GAasm
