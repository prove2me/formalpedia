variable {n : ℕ}

theorem differentiableAt_jointC {φ : ℝ × Pt n → ℂ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hφ : ContDiffOn ℝ ∞ φ W) {p : ℝ × Pt n} (hp : p ∈ W) : DifferentiableAt ℝ φ p :=
  (hφ.contDiffAt (hW.mem_nhds hp)).differentiableAt (by simp)

theorem hasDerivAt_param_jointC {φ : ℝ × Pt n → ℂ} {p : ℝ × Pt n} (hd : DifferentiableAt ℝ φ p) :
    HasDerivAt (fun ε : ℝ => φ (ε, p.2)) (fderiv ℝ φ p ((1 : ℝ), (0 : Pt n))) p.1 := by
  have h1 : HasDerivAt (fun ε : ℝ => (ε, p.2)) ((1 : ℝ), (0 : Pt n)) p.1 :=
    (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
  have h2 : HasFDerivAt φ (fderiv ℝ φ p) (p.1, p.2) := hd.hasFDerivAt
  exact h2.comp_hasDerivAt p.1 h1

/-- The parameter derivative of a jointly `C^∞` complex family is `C^∞` on the open slice. -/
theorem contDiffOn_deriv_slice {Φ : ℝ → Pt n → ℂ} {W : Set (ℝ × Pt n)} (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ ∞ (fun p : ℝ × Pt n => Φ p.1 p.2) W) (ε₀ : ℝ) :
    ContDiffOn ℝ ∞ (fun y => deriv (fun ε => Φ ε y) ε₀) {y | (ε₀, y) ∈ W} := by
  have hd : ContDiffOn ℝ ∞ (fun p => fderiv ℝ (fun p : ℝ × Pt n => Φ p.1 p.2) p ((1 : ℝ), (0 : Pt n))) W :=
    (hΦ.fderiv_of_isOpen hW (by simp)).clm_apply contDiffOn_const
  have hc : ContDiffOn ℝ ∞ (fun y : Pt n => ((ε₀, y) : ℝ × Pt n)) {y | (ε₀, y) ∈ W} :=
    (contDiff_const.prodMk contDiff_id).contDiffOn
  refine (hd.comp hc fun y hy => hy).congr fun y hy => ?_
  exact (hasDerivAt_param_jointC (p := (ε₀, y)) (differentiableAt_jointC hW hΦ hy)).deriv

