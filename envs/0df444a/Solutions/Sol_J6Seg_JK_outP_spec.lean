theorem outP_spec_sol_aux {a b : List ℤ} {l lm : List ℤ} {B : ℕ} (h0 : F 0 = l) (hCR : F CR = [])
    (hM : F HM = (a.length : ℤ) :: lm) (hab : a.length = b.length) (hWR : F WR = a.reverse)
    (hWI : F WI = b.reverse) (haB : Bnd B a) (hbB : Bnd B b) (hzB : zsz (a.length : ℤ) ≤ B) :
    Sp outP (encK s F) (encK s (update (update (update F 0 (gflat (a.zip b) ++ l)) WR []) WI []))
      (a.length * 10 ^ 5 * (B + 2) + 10 ^ 5 * (B + 2)) := by
  set Fk : ℕ → Fin HS → List ℤ := fun k => update (update (update F 0
    (gflat ((a.reverse.take k).reverse.zip (b.reverse.take k).reverse) ++ l)) WR (a.reverse.drop k))
      WI (b.reverse.drop k) with hFk
  have e0 : Fk 0 = F := by
    funext j; simp only [hFk, List.take_zero, List.drop_zero, List.reverse_nil, List.zip_nil_left,
      gflat_nil, List.nil_append, update_apply]
    split_ifs with h1 h2 h3 <;> subst_vars <;> simp_all +decide
  have hl : a.reverse.length = a.length := List.length_reverse
  have hl' : b.reverse.length = a.length := by rw [List.length_reverse, hab]
  have H := Sp.rep (s := s) (C := CR) (n := .reg HM)
    (b := .seq (.push 0 (.reg WI)) (.seq (.pop WI) (.seq (.push 0 (.reg WR)) (.pop WR))))
    (F := Fk) (N := a.length) (B := B) (c := 10 ^ 4 * (B + 2)) (by decide)
    (fun k => by simp +decide [hFk, update_apply, hCR])
    (by simp +decide [RS.writes]) (RS.clean_of_lt (by decide)) (by rw [e0]; exact isInt_encK hM)
    trivial (by rw [e0]; simp only [Ex.Bnd, top_encK hM]; exact hzB)
    (by rw [e0]; simp [Ex.eval, top_encK hM]) (fun k hk => by
      have hka : k < a.reverse.length := by omega
      have hkb : k < b.reverse.length := by omega
      have ba : zsz a.reverse[k] ≤ B := haB _ (List.mem_reverse.1 (List.getElem_mem hka))
      have bb : zsz b.reverse[k] ≤ B := hbB _ (List.mem_reverse.1 (List.getElem_mem hkb))
      set H0 := update (Fk k) CR [(a.length : ℤ) - k] with hH0
      have gI : H0 WI = b.reverse[k] :: b.reverse.drop (k + 1) := by
        simp +decide [hH0, hFk, update_apply]; rw [List.drop_eq_getElem_cons hkb]; simp
      have s1 := Sp.push (s := s) (f := H0) (i := 0) (e := .reg WI) (B := B) (by decide)
        (RS.clean_of_lt (by decide)) (isInt_encK gI) trivial (by simp only [Ex.Bnd, top_encK gI]; exact bb)
      rw [show (Ex.reg (S := HS) WI).eval (encK s H0) = b.reverse[k] from top_encK gI] at s1
      have gI' : update H0 0 (b.reverse[k] :: H0 0) WI = b.reverse[k] :: b.reverse.drop (k + 1) := by
        rw [update_of_ne (by decide), gI]
      have s2 := Sp.pop (s := s) (f := _) (B := B) (by decide) gI' bb
      have gR : update (update H0 0 (b.reverse[k] :: H0 0)) WI (b.reverse.drop (k + 1)) WR =
          a.reverse[k] :: a.reverse.drop (k + 1) := by
        simp +decide [hH0, hFk, update_apply]; rw [List.drop_eq_getElem_cons hka]; simp
      have s3 := Sp.push (s := s) (f := _) (i := 0) (e := .reg WR) (B := B) (by decide)
        (RS.clean_of_lt (by decide)) (isInt_encK gR) trivial (by simp only [Ex.Bnd, top_encK gR]; exact ba)
      rw [show (Ex.reg (S := HS) WR).eval _ = a.reverse[k] from top_encK gR] at s3
      have gR' : update (update (update H0 0 (b.reverse[k] :: H0 0)) WI (b.reverse.drop (k + 1))) 0
          (a.reverse[k] :: update (update H0 0 (b.reverse[k] :: H0 0)) WI (b.reverse.drop (k + 1)) 0)
          WR = a.reverse[k] :: a.reverse.drop (k + 1) := by
        rw [update_of_ne (by decide), gR]
      have s4 := Sp.pop (s := s) (f := _) (B := B) (by decide) gR' ba
      refine ((s1.seq (s2.seq (s3.seq s4))).congr ?_).mono ?_
      · congr 1
        have ta : a.reverse.take (k + 1) = a.reverse.take k ++ [a.reverse[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hka]; rfl
        have tb : b.reverse.take (k + 1) = b.reverse.take k ++ [b.reverse[k]] := by
          rw [List.take_add_one, List.getElem?_eq_getElem hkb]; rfl
        have ra : (a.reverse.take (k + 1)).reverse = a.reverse[k] :: (a.reverse.take k).reverse := by
          rw [ta, List.reverse_append]; rfl
        have rb : (b.reverse.take (k + 1)).reverse = b.reverse[k] :: (b.reverse.take k).reverse := by
          rw [tb, List.reverse_append]; rfl
        funext j
        simp only [hH0, hFk, update_apply]
        by_cases j1 : j = 0
        · subst j1; rw [ra, rb]; simp +decide
        by_cases j2 : j = WR
        · subst j2; simp +decide
        by_cases j3 : j = WI
        · subst j3; simp +decide
        simp [j1, j2, j3]
      · simp only [Ex.size]; omega)
  rw [e0] at H
  refine (H.congr ?_).mono ?_
  · congr 1
    simp only [hFk]
    rw [List.take_of_length_le (by omega), List.take_of_length_le (by omega), List.reverse_reverse,
