  have w311 : w3 11 = (D SAM).getD (n - 1 - (k - tv)) 0 := by
    rw [hw3, update_of_ne (by decide), update_of_ne (by decide), hw2, update_self]
  have w312 : w3 12 = (D SGM).getD (lam - 1 - k) 0 := by rw [hw3, update_self]
  have g : geE.den w3 = if max tu tv ≤ k then 1 else 0 :=
    den_geE (by rw [q3 4 (by decide) (by decide) (by decide) (by decide), h4])
      (den_tUE (by rw [q3 1 (by decide) (by decide) (by decide) (by decide), h1])
        (by rw [q3 2 (by decide) (by decide) (by decide) (by decide), h2])
        (by rw [q3 3 (by decide) (by decide) (by decide) (by decide), h3])
