  have hdp : 2 * IntMul.OpenAI.R154.dP n * pP n ^ 2 < IntMul.OpenAI.Glue.TP n * LP n := by
    have hcube := cube_lt_pow (bP n) (by omega)
    have h1 : 2 * IntMul.OpenAI.R154.dP n * pP n ^ 2 ≤ 72 * bP n ^ 3 := by
