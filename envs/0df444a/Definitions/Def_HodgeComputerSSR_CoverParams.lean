    Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X,
    map_bW, map_cW]

lemma map_c0W : PairAlg.map (Polynomial.mapRingHom f) p.c0W = (p.map f).c0W := by
  rw [c0W, map_toUW]; simp only [c0W, c0_V0, c0_V1, c0_V2, inv9, inv27, inv81, map,
    map_add, map_sub, map_mul, map_pow, map_neg, map_ofNat]

lemma map_k2W : PairAlg.map (Polynomial.mapRingHom f) p.k2W = (p.map f).k2W := by
