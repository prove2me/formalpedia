variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem withL4_runs (p : IStmt HS Pp) (A q M Bb : ℕ) (hA : zsz (A : ℤ) ≤ Bb)
    (hq : zsz (q : ℤ) ≤ Bb) (hM : zsz (M : ℤ) ≤ Bb) (h2 : zsz (2 : ℤ) ≤ Bb) (t : IState HS)
    (xs ys : List ℤ) (R : List Item) (h0 : t.G 0 = ints xs ++ R) (cp : ℕ)
    (hp : ∀ u : IState HS, u.G 0 = ints xs ++ R → u.G 1 = .int (A : ℤ) :: t.G 1 →
      u.G 2 = .int (q : ℤ) :: t.G 2 → u.G 3 = .int (M : ℤ) :: t.G 3 →
      u.G 4 = .int 2 :: t.G 4 → IRuns I iprog p u (u.upd 0 (ints ys ++ R)) cp) :
    IRuns I iprog (withPushI (l4 A q M) p) t (t.upd 0 (ints ys ++ R))
      (pushCost Bb (l4 A q M) + cp + (4 * (2 * Bb + 2) + 1)) := by
  have hPO : PushOK t Bb (l4 A q M) := pushOK_low _ (lows4 _ _ _ _) (by
    intro p hp; simp only [l4, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl | rfl
    · exact goodE_lit hA
    · exact goodE_lit hq
    · exact goodE_lit hM
    · exact goodE_lit h2)
  have hv : ∀ x ∈ l4 A q M, zsz (x.2.eval t) ≤ Bb := by
    intro x hx; simp only [l4, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl <;> simpa [Ex.eval]
  have hev : evalP t (l4 A q M) = [(1, (A : ℤ)), (2, (q : ℤ)), (3, (M : ℤ)), (4, 2)] := rfl
  set u := pushSt t (evalP t (l4 A q M))
  have hu : ∀ i : Fin HS, u.G i = if i = 4 then .int 2 :: t.G 4 else
      if i = 3 then .int (M : ℤ) :: t.G 3 else if i = 2 then .int (q : ℤ) :: t.G 2 else
      if i = 1 then .int (A : ℤ) :: t.G 1 else t.G i := by
    intro i
    simp only [u, hev, pushSt]
    by_cases h4 : i = 4
    · subst h4; simp +decide [IState.upd_G]
    by_cases h3 : i = 3
    · subst h3; simp +decide [IState.upd_G]
    by_cases h2 : i = 2
    · subst h2; simp +decide [IState.upd_G]
    by_cases h1 : i = 1
    · subst h1; simp +decide [IState.upd_G]
    simp [IState.upd_G, h1, h2, h3, h4]
  have Mr := hp u (by rw [hu]; simp +decide [h0]) (by rw [hu]; simp +decide)
    (by rw [hu]; simp +decide) (by rw [hu]; simp +decide) (by rw [hu]; simp +decide)
  exact IRuns.withPushI (I := I) (iprog := iprog) (l4 A q M) p t Bb hPO hv
    (by simp +decide [l4]) ys R _ Mr |>.mono (by simp [l4])

/-- The first field move on a managed state: `seg ↦ mvL M q seg`. -/
theorem fwd_runs (A q M Bb w : ℕ) (hA : zsz (A : ℤ) ≤ Bb) (hq : zsz (q : ℤ) ≤ Bb)
    (hM : zsz (M : ℤ) ≤ Bb) (h2 : zsz (2 : ℤ) ≤ Bb) (hA1 : 1 ≤ A) (hq1 : 1 ≤ q) (hM1 : 1 ≤ M)
    (s : IState HS) (f : Fin HS → List ℤ) (seg : List GI) (L : List ℤ)
    (hl : seg.length = A * M * q) (hb : GB w seg) (h0 : f 0 = gflat seg ++ L) :
    IRuns I iprog (withPushI (l4 A q M) KFC.fwdF) (encK s f)
      (encK s (Function.update f 0 (gflat (mvL M q seg) ++ L)))
      (pushCost Bb (l4 A q M) + KFC.cFwdF A q M 2 w + (4 * (2 * Bb + 2) + 1)) := by
  have e0 : (encK s f).G 0 = ints (gflat seg) ++ (ints L ++ s.G 0) := by
    simp [h0, ints_append]
  have H := withL4_runs (I := I) (iprog := iprog) KFC.fwdF A q M Bb hA hq hM h2 (encK s f)
    (gflat seg) (gflat (mvL M q seg)) (ints L ++ s.G 0) e0 (KFC.cFwdF A q M 2 w) (by
      intro u u0 u1 u2 u3 u4
      rw [gflat_mvL (A := A) seg hl]
      exact KFC.fwdF_spec u (gflat seg) A q M 2 w _ _ _ _ _
        (by rw [length_gflat, hl]; ring) hb.bnd (by norm_num) hM1 hq1 hA1 u0 u1 u2 u3
        (by simpa using u4))
  refine H.mono' ?_ le_rfl
  rw [← List.append_assoc, ← ints_append, encK_upd]

/-! ## Parking the prefix -/

/-! ## The wrapper -/

end
