theorem NLogN.KFM.lemma19_fp (p s t α : ℕ) [NeZero s] [NeZero t] (hst : s < t) (hcop : Nat.Coprime s t)
    (hα : 2 ≤ α) (hαp : α ^ 2 ≤ p) (hx : s ≤ α ^ 2 * (t - s))
    (hp : 100 * (IntMul.HvdH.jIter p s t α * (10 * IntMul.HvdH.eWidth p α + 12) + 1) ≤ 2 ^ p)
    (hpA : 4 * (6 * IntMul.HvdH.sWidth p α + 4) ≤ 2 ^ p) :
    ∃ (A : (ZMod s → ℂ) →L[ℂ] (ZMod t → ℂ)) (B₀ : (ZMod t → ℂ) →L[ℂ] (ZMod s → ℂ)),
      ‖A‖ ≤ 1 ∧ ‖B₀‖ ≤ 1 ∧
      (∀ u, IntMul.OpenAI.RH.permS s t ((s : ℂ)⁻¹ • ZMod.dft u) =
        (2 : ℂ) ^ (2 * α ^ 2) • B₀ (IntMul.OpenAI.RH.permT s t ((t : ℂ)⁻¹ • ZMod.dft (A u)))) ∧
      IntMul.HvdH.FPApprox p (IntMul.HvdH.Sapprox p s t α) (NLogN.KFM.liftL A)
        (6 * IntMul.HvdH.sWidth p α + 4) ∧
      IntMul.HvdH.FPApprox p (B0P p s t α) (NLogN.KFM.liftL B₀)
        (IntMul.HvdH.jIter p s t α * (10 * IntMul.HvdH.eWidth p α + 12) + 4) ∧
      IntMul.HvdH.SupLip (NLogN.KFM.liftL A) ∧ IntMul.HvdH.SupLip (NLogN.KFM.liftL B₀) := by sorry
