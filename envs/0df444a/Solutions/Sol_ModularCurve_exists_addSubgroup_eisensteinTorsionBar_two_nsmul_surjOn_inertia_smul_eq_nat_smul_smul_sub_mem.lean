theorem mem_eisensteinTorsionBar_iff (m : ℕ) (x : JZero p) :
    x ∈ eisensteinTorsionBar p q m ↔
      letI := heckeModuleBar p
      ∀ t ∈ (eisensteinMaximalIdeal p q) ^ m, t • x = 0 := by
  letI := heckeModuleBar p
  change x ∈ Submodule.torsionBySet HeckeAlg (JZero p)
      (↑((eisensteinMaximalIdeal p q) ^ m) : Set HeckeAlg) ↔ _
  rw [Submodule.mem_torsionBySet_iff]
  constructor
  · intro h t ht
    exact h ⟨t, ht⟩
  · rintro h ⟨t, ht⟩
    exact h t ht

theorem nsmul_eq_zero_of_mem (m : ℕ) {x : JZero p} (hx : x ∈ eisensteinTorsionBar p q m) :
    q ^ m • x = 0 := by
  letI := heckeModuleBar p
  have hmem : ((q ^ m : ℕ) : HeckeAlg) ∈ (eisensteinMaximalIdeal p q) ^ m := by
    rw [Nat.cast_pow]
    exact Ideal.pow_mem_pow (natCast_mem_eisensteinMaximalIdeal p q) m
  have h := (mem_eisensteinTorsionBar_iff p q m x).1 hx _ hmem
  rwa [Nat.cast_smul_eq_nsmul] at h

theorem eisensteinTorsionBar_mono {m m' : ℕ} (h : m ≤ m') :
    eisensteinTorsionBar p q m ≤ eisensteinTorsionBar p q m' := by
  intro x hx
  rw [mem_eisensteinTorsionBar_iff] at hx ⊢
  intro t ht
  exact hx t (Ideal.pow_le_pow_right h ht)

