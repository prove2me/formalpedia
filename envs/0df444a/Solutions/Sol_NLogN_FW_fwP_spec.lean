theorem mdit_eq_lvls (F : ℤ) (n : ℕ) (ax : List (ℕ × ℕ)) (A : List ℤ)
    (hA : A.length = Ref.blockSize ax) :
    Ref.mdit F n ax A = lvls (Ref.ditZ F n) (descs ax 1).reverse A := by
  rw [mdit_lvls F n ax 1 A (by rw [hA]; ring), chunkL_short _ A (by rw [hA]; exact blockSize_pos _)
