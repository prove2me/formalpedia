-- title:
--   Executions of Charon: delivery, validation, retention, decisions, no-forgery and complete evidence
-- statement:
--   An execution consists of parameters, the authentication interface, a network and an adversary; the adversary gives each identity an arbitrary initial (or joining) cache and gives each Byzantine sender an arbitrary finite record set to send to each neighbour in each round. The canonical round-$q$ report of $u$ has the session of round $q$, round $q$, signer $u$ and the sorted list of $u$'s actual neighbours in $G_q$; correct $u$ signs it with its own key.
--   The retained cache of a correct process $i$ in round $r$ (the point just before forwarding) is obtained by normalizing, at round $r$ with the session of round $r$ and $F_{\mathrm{ret}}=\Gamma$: its previous cache if it was present in round $r-1$ and otherwise its arbitrary joining cache; every record sent to it in round $r-1$ over an edge of $G_{r-1}$ (a correct sender sends its whole retained cache, a Byzantine sender its adversarial set); and its own signed round-$r$ report. In round $r$ the assessed window is $e_r=r-L_{\mathrm{flood}}$, $s_r=e_r-\tau+1$; $i$ is eligible iff $r+1\ge\Gamma$ (so the full target window is nonnegative), it is present throughout $[s_r,r]$ and the session of $s_r$ equals that of round $r$; the decision is the Charon verdict on (public parameters, session of round $r$, $[s_r,e_r]$, eligibility bit, retained cache), and $\mu_i$ is that input's $\mu$.
--   *NoForgery* states the signature-security conditional: every adversary-supplied record that verifies under a non-Byzantine identity carries that identity's genuine canonical report for a round in which it is present. *Legal* = Admissible network, signatures produced by the signing function verify, NoForgery, and ReportsFit (every correct generated envelope fits its prescribed session/round bit-length bound). *Complete evidence* of $i$ in round $r$ for $[s,e]$: for every $q\in[s,e]$ and every correct $u\in V_q$, $i$'s retained cache contains a record with $u$'s round-$q$ payload. For a report generated by correct $v$ in round $q$: the holders $I_r$ (correct processes whose cache contains its payload), $k_r=|I_r|$, $u_r=|C_r\setminus I_r|$, and $b_r$ = number of uninformed correct processes with an informed correct neighbour in $G_r$. Helpers: $e=s+\tau-1$, the assessment round $e+L_{\mathrm{flood}}$, and *eligible verifier* $i$ for $[s,e]$: $i\notin B$, present throughout $[s,e+L_{\mathrm{flood}}]$, and the session of $s$ equals that of round $e+L_{\mathrm{flood}}$.
-- source:
--   Sengupta and Perrin (2026), Byzantine Partition Detection Under Churn, supplied 48-page artifact (venue metadata: STOC 2027 submission; citation basis published per source.meta.json; SHA-256 3f9994406f38c73927d0b5cc78d0dd05740de0f7d09e544b7b203eefe39cdb74), §§2.1–2.7, pp. 7–11; §3.1–3.2, pp. 12–13; Algorithm 1, p. 17; §4 preamble, p. 18; §4.2, p. 21

import Mathlib
import Definitions.Def_CharonChurn_Main_Network
import Definitions.Def_CharonChurn_Main_Reports
import Definitions.Def_CharonChurn_Main_Decision

namespace CharonChurn.Main

/-! # Executions of Charon (Sengupta–Perrin 2026, §§2.1–2.7 and Algorithm 1, pp. 7–17)

Round `r`: churn and topology are fixed (`N.V r`, `N.G r`); messages sent in round `r − 1` are
delivered to recipients present in round `r`; each correct process validates the delivered
evidence together with its retained cache and discards expired records, generates and caches its
signed report, sends the retained bundle to every current neighbour and assesses the delayed
window. Adversarial choices are arbitrary functions of the round, which covers every
history-adaptive strategy against this deterministic protocol. -/

/-- Adversarial inputs: the arbitrary mutable cache with which identity `i` starts (at round `0`
or when it joins) and the arbitrary finite record set that Byzantine `b` sends to `j` in round `r`
(`byz r b j`). Messages may be arbitrarily large finite sets. -/
structure Adversary where
  init : ℕ → Finset Record
  byz : ℕ → ℕ → ℕ → Finset Record

/-- An execution: parameters, authentication interface, network and adversary. -/
structure Execution where
  P : Params
  Cr : Crypto
  N : Network
  A : Adversary

namespace Execution

variable (E : Execution)

/-- Current physical neighbours of `u` in round `q`. -/
noncomputable def nbrs (u q : ℕ) : Finset ℕ := by
  classical
  exact (E.N.V q).filter (fun v => (E.N.G q).Adj u v)

/-- The canonical round-`q` report payload of `u`, Eq. (1): type `NBR`, version, session of round
`q`, round `q`, signer `u`, and the sorted list of its actual physical neighbours. -/
noncomputable def canon (u q : ℕ) : Payload :=
  ⟨NBR, VER, E.N.session q, q, u, (E.nbrs u q).sort (· ≤ ·)⟩

/-- The signed record that correct `u` generates in round `q`. -/
noncomputable def ownRecord (u q : ℕ) : Record :=
  ⟨E.canon u q, E.Cr.sign u (E.canon u q)⟩

/-- Retention horizon `F_ret = Γ`. -/
noncomputable def Fret : ℕ := Gamma E.P

/-- One correct-process update: validate `pool ∪ {own report}` at round `r` and normalize. -/
noncomputable def step (i r : ℕ) (pool : Finset Record) : Finset Record :=
  normalize E.Cr E.P.D (E.N.session r) r E.Fret (insert (E.ownRecord i r) pool)

/-- Retained evidence cache of process `i` in round `r`, immediately before forwarding (after
churn, delivery, validation, expiry and own-report generation). For `r + 1`: the previous cache
if `i` was present in round `r`, otherwise its arbitrary joining cache; plus every record sent to
`i` in round `r` over an edge of `G_r` (correct senders send their whole retained cache, Byzantine
senders send `byz`). Meaningful for correct `i ∈ V_r`. -/
noncomputable def cacheAt : ℕ → ℕ → Finset Record
  | 0 => fun i => E.step i 0 (E.A.init i)
  | r + 1 => fun i => by
      classical
      exact E.step i (r + 1)
        ((if i ∈ E.N.V r then cacheAt r i else E.A.init i) ∪
          (E.nbrs i r).biUnion (fun j => if j ∈ E.N.B then E.A.byz r j i else cacheAt r j))

/-- The window assessed in round `r`: `e_r = r − L_flood`, `s_r = e_r − τ + 1`. -/
noncomputable def winEnd (r : ℕ) : ℕ := r - Lflood E.P.n E.P.lam

noncomputable def winStart (r : ℕ) : ℕ := E.winEnd r + 1 - E.P.τ

/-- Eligibility of `i` in round `r` (from the execution model, not mutable state): present
throughout `[s_r, r]`, a full nonnegative target window (`Γ ≤ r + 1`), and the target
window inside the session active in round `r`. -/
def Eligible (r i : ℕ) : Prop :=
  Gamma E.P ≤ r + 1 ∧ (∀ m ∈ Finset.Icc (E.winStart r) r, i ∈ E.N.V m) ∧ E.N.session (E.winStart r) = E.N.session r

/-- The decision input of `i` in round `r`. -/
noncomputable def inputAt (r i : ℕ) : DecisionInput := by
  classical
  exact ⟨E.P.n, E.P.D, E.P.t, E.N.session r, E.winStart r, E.winEnd r,
    decide (E.Eligible r i), E.cacheAt r i⟩

/-- Decision `dec^r_i`, recomputed in round `r` from validated evidence. -/
noncomputable def decision (r i : ℕ) : Verdict := (E.inputAt r i).verdict

/-- `μ_i` of the assessment of `i` in round `r`. -/
noncomputable def muAt (r i : ℕ) : ℕ := (E.inputAt r i).mu

/-- No-forgery conditional (signature security, §2.5): every record that the adversary supplies
(in an arbitrary initial or joining cache, or in a Byzantine message) and that verifies under a
non-Byzantine identity `u` carries `u`'s genuine canonical report for a round in which `u` is
present. Records signed under Byzantine identities are unconstrained. -/
def NoForgery : Prop :=
  ∀ x : Record, ((∃ i, x ∈ E.A.init i) ∨ ∃ r b j, x ∈ E.A.byz r b j) →
    E.Cr.verify x.payload.signer x.payload x.sig = true → x.payload.signer ∉ E.N.B →
      x.payload.signer ∈ E.N.V x.payload.round ∧
        x.payload = E.canon x.payload.signer x.payload.round

/-- The prescribed maximum envelope lengths accommodate the correct reports (§§3.1, 3.7).
This is the format-compatibility condition on public encoding limits, not a delivery or evidence
completeness assumption. The limits may depend on the signed session and round, so no global
bound on the infinite identity supply is imposed. -/
def ReportsFit : Prop :=
  ∀ u q, u ∈ correctSet E.N q →
    (encRecord (E.ownRecord u q)).length ≤ E.Cr.maxReportBits (E.N.session q) q

/-- The standing assumptions of an execution: the network assumptions, signatures produced by the
signing interface verify, and no forgery under correct identities. -/
structure Legal : Prop where
  admissible : Admissible E.P E.N
  sign_verifies : ∀ u p, E.Cr.verify u p (E.Cr.sign u p) = true
  no_forgery : E.NoForgery
  reports_fit : E.ReportsFit

/-- Complete target-window evidence at `i` in round `r` (§4 preamble): for every target round
`q ∈ [s, e]` and every correct `u ∈ V_q`, `u`'s round-`q` report is retained. -/
def CompleteEvidence (r i s e : ℕ) : Prop :=
  ∀ q ∈ Finset.Icc s e, ∀ u ∈ correctSet E.N q, ∃ x ∈ E.cacheAt r i, x.payload = E.canon u q

/-- Holders `I_r` of the report generated by `v` in round `q`: correct processes of round `r`
holding its payload immediately before forwarding. -/
noncomputable def holders (v q r : ℕ) : Finset ℕ := by
  classical
  exact (correctSet E.N r).filter (fun i => ∃ x ∈ E.cacheAt r i, x.payload = E.canon v q)

/-- `k_r = |I_r|`. -/
noncomputable def kInf (v q r : ℕ) : ℕ := (E.holders v q r).card

/-- `u_r = |C_r \ I_r|`. -/
noncomputable def uUninf (v q r : ℕ) : ℕ := (correctSet E.N r \ E.holders v q r).card

/-- `b_r`: uninformed correct processes with an informed correct neighbour in `G_r`. -/
noncomputable def bBdry (v q r : ℕ) : ℕ := by
  classical
  exact ((correctSet E.N r \ E.holders v q r).filter
    (fun w => ∃ u ∈ E.holders v q r, (E.N.G r).Adj u w)).card

/-- End `e = s + τ − 1` of the `τ`-round target window starting at `s`. -/
def wEnd (s : ℕ) : ℕ := s + E.P.τ - 1

/-- Assessment round of the window starting at `s`: `r = e + L_flood` (so `e_r = e`, `s_r = s`). -/
noncomputable def assessAt (s : ℕ) : ℕ := E.wEnd s + Lflood E.P.n E.P.lam

/-- Decision input of `i` at the assessment of the window starting at `s`. -/
noncomputable def assessInput (s i : ℕ) : DecisionInput := E.inputAt (E.assessAt s) i

/-- `i` is an eligible correct verifier for the window `[s, e]`: correct, present throughout
`[s, e + L_flood]`, and the window lies in the session active at the assessment round. -/
def EligibleVerifier (s i : ℕ) : Prop :=
  i ∉ E.N.B ∧ (∀ m ∈ Finset.Icc s (E.assessAt s), i ∈ E.N.V m) ∧
    E.N.session s = E.N.session (E.assessAt s)

end Execution

end CharonChurn.Main


