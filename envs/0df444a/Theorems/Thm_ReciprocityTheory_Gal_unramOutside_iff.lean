theorem ReciprocityTheory.Gal.unramOutside_iff {H : Type*} [Group H] [TopologicalSpace H] [T2Space H]
    (ρ : G F Ω →* H) (hρ : Continuous ρ) :
    UnramOutside S ρ ↔ ∀ v ∉ S, ∀ A, IsPlaceOver A v → ∀ σ ∈ Inertia (F := F) A, ρ σ = 1 := by sorry
