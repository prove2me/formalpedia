-- title:
--   Integral factorisation of a Hecke eigencharacter with prescribed reduction
-- statement:
--   Let $\mathcal{O}$ be a characteristic-zero complete discrete valuation ring: a commutative domain which is a discrete valuation ring, adically complete for its maximal ideal, with finite residue field. Let $N \ge 1$ (i.e. $N$ nonzero) and let $S$ be a set of natural numbers, and write $\mathbb{T} =$ [`CuspForm.heckeAlgebra N 2 S`](def/CuspForm_HeckeAlgebra.html#L18) for the $\mathbb{Z}$-subalgebra of $\operatorname{End}_{\mathbb{C}}$ of the space of weight-two cusp forms on $\Gamma_0(N)$ generated by the operators $T_\ell$ for primes $\ell \nmid N$ with $\ell \notin S$ and $U_q$ for primes $q \mid N$ with $q \notin S$. Let $F$ be a field which is an $\mathcal{O}$-algebra with injective structure map, and let $\chi \colon \mathbb{T} \to F$ be a ring homomorphism. Suppose given residues $c_\ell \in \operatorname{ResidueField} \mathcal{O}$ for all primes $\ell \nmid N$, $\ell \notin S$, and $d_q \in \operatorname{ResidueField} \mathcal{O}$ for all primes $q \mid N$, $q \notin S$, such that for each such $\ell$ (resp. $q$) there is a monic $P \in \mathcal{O}[X]$ with $\chi(T_\ell)$ (resp. $\chi(U_q)$) a root of the image of $P$ in $F[X]$ and with the reduction of $P$ modulo the maximal ideal equal to $(X - c_\ell)^{\deg P}$ (resp. $(X - d_q)^{\deg P}$). Then there exists a type $\mathcal{O}'$ carrying the structure of a characteristic-zero commutative domain which is a discrete valuation ring, adically complete for its maximal ideal, with finite residue field, together with an $\mathcal{O}$-algebra structure making $\mathcal{O}'$ a finite $\mathcal{O}$-module with local structure map $\mathcal{O} \to \mathcal{O}'$, and an injective ring homomorphism $e \colon \mathcal{O}' \to F$ with $e \circ (\mathcal{O} \to \mathcal{O}') = (\mathcal{O} \to F)$, and further ring homomorphisms $\chi' \colon \mathbb{T} \to \mathcal{O}'$ and $\theta \colon \mathbb{T} \to \operatorname{ResidueField} \mathcal{O}$ such that $e \circ \chi' = \chi$, $\theta(T_\ell) = c_\ell$ and $\theta(U_q) = d_q$ on the generators, and for every $t \in \mathbb{T}$ the residue of $\chi'(t)$ in $\operatorname{ResidueField} \mathcal{O}'$ is the image of $\theta(t)$ under the map of residue fields induced by $\mathcal{O} \to \mathcal{O}'$.
--
--   This is the Deligne–Serre style descent of a Hecke eigensystem realised in a characteristic-zero field to a complete discrete valuation ring finite over the base, with control on the reduction of all Hecke eigenvalues. It is used to place an eigensystem whose generator values satisfy integral congruence conditions into an integral setting where reduction arguments apply, and is invoked in the analysis of parabolic Hecke-eigenclasses for $\Gamma_0$-level structures.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_heckeAlgebra_exists_ringHom_comp_eq_and_residue_eq_of_forall_isRoot_of_map_residue_eq_pow.lean

import Definitions.Def_CuspForm_HeckeAlgebra
import Mathlib.RingTheory.DiscreteValuationRing.Basic
import Mathlib.RingTheory.AdicCompletion.Basic
import Mathlib.RingTheory.LocalRing.ResidueField.Basic

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Polynomial IsLocalRing

theorem CuspForm.heckeAlgebra.exists_ringHom_comp_eq_and_residue_eq_of_forall_isRoot_of_map_residue_eq_pow
    {𝒪 : Type} [CommRing 𝒪] [IsDomain 𝒪] [IsDiscreteValuationRing 𝒪]
    [IsAdicComplete (maximalIdeal 𝒪) 𝒪] [Finite (ResidueField 𝒪)] [CharZero 𝒪]
    (N : ℕ) [NeZero N] (S : Set ℕ)
    (F : Type) [Field F] [Algebra 𝒪 F] (hF : Function.Injective (algebraMap 𝒪 F))
    (χ : CuspForm.heckeAlgebra N 2 S →+* F)
    (c : ∀ (ℓ : ℕ), ℓ.Prime → ¬ ℓ ∣ N → ℓ ∉ S → ResidueField 𝒪)
    (hT : ∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S),
      ∃ P : 𝒪[X], P.Monic ∧ (P.map (algebraMap 𝒪 F)).IsRoot (χ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS)) ∧
        P.map (residue 𝒪) = (X - C (c ℓ hℓ hℓN hℓS)) ^ P.natDegree)
    (d : ∀ (q : ℕ), q.Prime → q ∣ N → q ∉ S → ResidueField 𝒪)
    (hU : ∀ (q : ℕ) (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S),
      ∃ P : 𝒪[X], P.Monic ∧ (P.map (algebraMap 𝒪 F)).IsRoot (χ (CuspForm.heckeAlgebra.U hq hqN hqS)) ∧
        P.map (residue 𝒪) = (X - C (d q hq hqN hqS)) ^ P.natDegree) :
    ∃ (𝒪' : Type) (_ : CommRing 𝒪') (_ : IsDomain 𝒪') (_ : IsDiscreteValuationRing 𝒪')
      (_ : IsAdicComplete (maximalIdeal 𝒪') 𝒪') (_ : Finite (ResidueField 𝒪'))
      (_ : CharZero 𝒪') (_ : Algebra 𝒪 𝒪') (_ : Module.Finite 𝒪 𝒪')
      (_ : IsLocalHom (algebraMap 𝒪 𝒪')) (e : 𝒪' →+* F),
    Function.Injective e ∧ e.comp (algebraMap 𝒪 𝒪') = algebraMap 𝒪 F ∧
    ∃ (χ' : CuspForm.heckeAlgebra N 2 S →+* 𝒪') (θ : CuspForm.heckeAlgebra N 2 S →+* ResidueField 𝒪),
      e.comp χ' = χ ∧
      (∀ (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓN : ¬ ℓ ∣ N) (hℓS : ℓ ∉ S),
        θ (CuspForm.heckeAlgebra.T hℓ hℓN hℓS) = c ℓ hℓ hℓN hℓS) ∧
      (∀ (q : ℕ) (hq : q.Prime) (hqN : q ∣ N) (hqS : q ∉ S),
        θ (CuspForm.heckeAlgebra.U hq hqN hqS) = d q hq hqN hqS) ∧
      ∀ t : CuspForm.heckeAlgebra N 2 S,
        residue 𝒪' (χ' t) = ResidueField.map (algebraMap 𝒪 𝒪') (θ t) := by sorry
