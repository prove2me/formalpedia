      dsimp [s] at hn
      exact (Finset.mem_filter.mp hn).2.2
    rcases hnodd with ⟨k, hk⟩
    rcases hn0odd with ⟨k0, hk0⟩
    have hk0k : k0 ≤ k := by omega
    let j : ℕ := k - k0
    have heq : n0 + 2 * j = n := by
      dsimp [j]
      omega
    have hn0x : x < (n0 : ℝ) := by
      dsimp [s] at hn0mem
      exact (Finset.mem_filter.mp hn0mem).2.1
    have hny : (n : ℝ) ≤ y := by
      exact realOddInterval_upper x y (hx.trans hxy) n (by simpa [s] using hn)
