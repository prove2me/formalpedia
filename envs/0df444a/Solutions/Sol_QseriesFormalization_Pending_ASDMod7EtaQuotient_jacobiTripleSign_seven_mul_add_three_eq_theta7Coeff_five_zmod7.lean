/-- `n * (n + 1)` is divisible by 2. -/
theorem two_dvd_mul_succ (n : ℕ) : 2 ∣ n * (n + 1) := by
  rcases Nat.even_or_odd n with he | ho
  · obtain ⟨m, hm⟩ := he
    exact ⟨m * (n + 1), by rw [hm]; ring⟩
  · obtain ⟨m, hm⟩ := ho
    refine ⟨n * (m + 1), ?_⟩
    rw [hm]; ring

/-- `2 * T_n = n * (n + 1)`. -/
