set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxHeartbeats 1000000

open NLogN
open NLogN.KFM
open Complex
variable {ι κ : Type*} [Fintype ι] [Fintype κ]

theorem NLogN.KFM.chain_close (p b γ : ℕ) (S : ℝ) (hS0 : 0 ≤ S)
    -- exact maps
    {A : (κ → ℂ) → (ι → ℂ)} {QF : (ι → ℂ) → (ι → ℂ)} {B0 : (ι → ℂ) → (κ → ℂ)}
    {Mr : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} {θ θi a ck : ι → ℂ}
    (hA : LinC A) (hQF : LinC QF) (hB : LinC B0) (hMr : BilC Mr)
    (hQFa : ∀ x, a * (θi * Mr (θ * ck) (θ * (a * x))) = QF x)
    (hFc : ∀ w, ‖(2 : ℂ) ^ γ • B0 (QF (A w))‖ ≤ ‖w‖)
    -- computed procedures
    {At : (κ → ℂ) → (ι → ℂ)} {B0t : (ι → ℂ) → (κ → ℂ)} {Mrt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)}
    {θt θit at' bt : ι → ℂ} (εA εB Er : ℝ)
    (hAt : ∀ u, Grid p u → ‖u‖ ≤ 1 / 2 → ‖At u - A u‖ ≤ εA * hp p ∧ Grid p (At u))
    (hBt : ∀ y, Grid p y → ‖y‖ ≤ 1 → ‖B0t y - B0 y‖ ≤ εB * hp p)
    (hMrt : ∀ f g, Grid p f → Grid p g → ‖f‖ ≤ 1 → ‖g‖ ≤ 1 → ‖Mrt f g - Mr f g‖ ≤ Er * hp p)
    (hθ : Phases p θ θt) (hθi : Phases p θi θit) (ha : Phases p a at') (hb' : Phases p ck bt)
    (hbg : Grid p bt)
    (hθg : Grid p θit)
    -- sizes
    (hεA : εA * hp p ≤ 1 / 10) (hEr : Er * hp p ≤ 1 / 10)
    (hEs : (2 : ℝ) ^ γ * ((εA + (Er + 22) + εB) * hp p) ≤ 1 / 100)
    (hB2 : 2 * (2 : ℝ) ^ (2 * b + 4) * S ^ 2 *
      (3 * ((2 : ℝ) ^ γ * (εA + (Er + 22) + εB)) + 2) * hp p < 1)
    -- data
    {u v : κ → ℂ} (hu : Grid p u) (hv : Grid p v) (hu1 : ‖u‖ ≤ 1 / 4) (hv1 : ‖v‖ ≤ 1 / 4)
    {c : κ → ℂ}
    (hc : ∀ j, (2 : ℂ) ^ (2 * b + 4) * S * (S * cnj ((fun w => (2 : ℂ) ^ γ • B0 (QF (A w)))
      (cnj ((2 : ℂ) ^ γ • B0 (QF (A u)) * (2 : ℂ) ^ γ • B0 (QF (A v))))) j) = c j) :
    let Ft : (κ → ℂ) → (κ → ℂ) := fun w =>
      (2 : ℂ) ^ γ • B0t (chirpT p (mcT p Mrt θt θit) bt at' (At w))
    ∀ j, ‖(2 : ℂ) ^ (2 * b + 4) * S * (S * plusT Ft (QA p (Ft u * Ft v)) j) - c j‖ < 1 / 2 := by sorry
