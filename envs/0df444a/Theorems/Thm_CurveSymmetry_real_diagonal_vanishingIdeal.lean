theorem CurveSymmetry.real_diagonal_vanishingIdeal {P : BPoly} (hP : Irreducible P)
    (hinf : (realLocus P).Infinite) :
    vanishingIdeal ℂ (affineRealDiagonal P) = Ideal.span {P} := by sorry
