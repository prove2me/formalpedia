        (br - ar) ^ 2 * (5 * ar + br) / (6 * ar * ar * br * (ar + br)) := by
      have hm1 := mul_le_mul_of_nonneg_left hsimp (by positivity : 0 ≤ 1 / ar)
      have heq_alg : (1 / ar) * ((br - ar) * ((ar + br) ^ 2 + 8 * ar * br) / (6 * ar * br * (ar + br))) - (1 / ar - 1 / br) =
          (br - ar) ^ 2 * (5 * ar + br) / (6 * ar * ar * br * (ar + br)) := by
        field_simp; ring
      linarith [hinv2]
    have heq_nat : (br - ar) ^ 2 * (5 * ar + br) / (6 * ar * ar * br * (ar + br)) =
        (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * (5 * a + b) / (6 * a * a * b * (a + b)) := by
      dsimp [ar, br]; field_simp
    rw [heq_nat] at hsub_le
    have hbp : 0 < b := lt_of_lt_of_le hap hab
    have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
    have hden_pos : 0 < 6 * a * a * b * (a + b) := by positivity
    have hceil := le_mul_ceilDiv (a := W_scale * W_scale * D_den * (b - a) ^ 2 * (5 * a + b)) (b := 6 * a * a * b * (a + b)) hden_pos
    have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
    have hceilr : (W_scale : ℝ) * W_scale * D_den * ((b : ℝ) - a) ^ 2 * (5 * a + b) ≤
        (6 * (a : ℝ) * a * b * (a + b)) * (wDiag12 a b : ℝ) := by
      rw [← hsub]
      have hceil' : W_scale * W_scale * D_den * (b - a) ^ 2 * (5 * a + b) ≤ 6 * a * a * b * (a + b) * wDiag12 a b := by
        simpa [wDiag12, mul_assoc] using hceil
      exact_mod_cast hceil'
    have hle : (D_den : ℝ) * ((b : ℝ) - a) ^ 2 * (5 * a + b) / (6 * a * a * b * (a + b)) ≤
        (wDiag12 a b : ℝ) / (W_scale * W_scale) := by
      rw [div_le_div_iff₀ (by positivity) (mul_pos hWpos hWpos)]
      linarith
    exact le_trans hsub_le hle
  have hc_eq : ∫ x in Icc c d, (1 / x : ℝ) = ∫ t in c..d, (1 / t : ℝ) := by
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hcd]
  rw [hc_eq]
  have hI0 := wSimp_bound h0p h0
  have hT12_nn : 0 ≤ ∫ p in T12, (1 / (p.1 * p.1 * p.2) : ℝ) :=
    setIntegral_nonneg hT12_meas (fun p hp => div_nonneg zero_le_one (by
      have hp1 : 0 < p.1 := lt_of_lt_of_le har_pos hp.1.1
      have hp2 : 0 < p.2 := lt_of_lt_of_le har_pos hp.2.1.1
      positivity))
  exact mul_le_mul hI0 hT12_bound hT12_nn (by positivity)

lemma ordBox3_d012_weight {a b : ℕ} (hap : 0 < a) (hab : a ≤ b) :
    ∫ x in ordBox3 ((a : ℝ) / D_den) ((b : ℝ) / D_den)
                   ((a : ℝ) / D_den) ((b : ℝ) / D_den)
                   ((a : ℝ) / D_den) ((b : ℝ) / D_den),
      (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) ≤
      (wDiag012 a b : ℝ) / (W_scale * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  set ar := (a : ℝ) / D_den; set br := (b : ℝ) / D_den
  have har_pos : 0 < ar := div_pos (by exact_mod_cast hap) hDpos
  have harb : ar ≤ br := div_le_div_of_nonneg_right (by exact_mod_cast hab) (le_of_lt hDpos)
  set T := ordBox3 ar br ar br ar br
  have hT_meas : MeasurableSet T := ordBox3_measurable _ _ _ _ _ _
  have hpt : ∀ x ∈ T, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) ≤ 1 / (ar ^ 4) := by
    intro x hx
    rw [Fin.prod_univ_three]
    have hx0 : ar ≤ x 0 := hx.1.1
    have hx1 : ar ≤ x 1 := hx.2.1.1
    have hx2 : ar ≤ x 2 := hx.2.2.1.1
    have hx0p : 0 < x 0 := lt_of_lt_of_le har_pos hx0
    have hx1p : 0 < x 1 := lt_of_lt_of_le har_pos hx1
    have hx2p : 0 < x 2 := lt_of_lt_of_le har_pos hx2
    rw [one_div_le_one_div (by positivity) (by positivity)]
    have h1 : ar * ar ≤ x 0 * x 1 := mul_le_mul hx0 hx1 (le_of_lt har_pos) (le_trans (le_of_lt har_pos) hx0)
    have h2 : ar * ar ≤ x 2 * x 1 := mul_le_mul hx2 hx1 (le_of_lt har_pos) (le_trans (le_of_lt har_pos) hx2)
    have h3 : ar ^ 4 = (ar * ar) * (ar * ar) := by ring
    have h4 : x 0 * x 1 * x 2 * x 1 = (x 0 * x 1) * (x 2 * x 1) := by ring
    rw [h3, h4]
    exact mul_le_mul h1 h2 (by positivity) (by positivity)
  have hf_int : IntegrableOn (fun x : Fin 3 → ℝ => (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ)) T volume := by
    have hcomp : IsCompact (univ.pi fun _ : Fin 3 => Icc ar br) := isCompact_univ_pi fun _ => isCompact_Icc
    apply ContinuousOn.integrableOn_compact (hcomp.of_isClosed_subset
      (by
        simp only [T, ordBox3, setOf_and]
        exact (isClosed_Icc.preimage (continuous_apply 0)).inter
          ((isClosed_Icc.preimage (continuous_apply 1)).inter
            ((isClosed_Icc.preimage (continuous_apply 2)).inter
              ((isClosed_le (continuous_apply 0 : Continuous fun p : Fin 3 → ℝ => p 0) (continuous_apply 1)).inter
                (isClosed_le (continuous_apply (1 : Fin 3)) (continuous_apply (2 : Fin 3)))))))
      (fun x hx j _ => by fin_cases j <;> simp [hx.1, hx.2.1, hx.2.2.1]))
    refine continuousOn_const.div (by fun_prop) (fun x hx => by
      rw [Fin.prod_univ_three]
      have hx0 : 0 < x 0 := lt_of_lt_of_le har_pos hx.1.1
      have hx1 : 0 < x 1 := lt_of_lt_of_le har_pos hx.2.1.1
      have hx2 : 0 < x 2 := lt_of_lt_of_le har_pos hx.2.2.1.1
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero (ne_of_gt hx0) (ne_of_gt hx1)) (ne_of_gt hx2)) (ne_of_gt hx1))
  have hc_int : IntegrableOn (fun _ : Fin 3 → ℝ => (1 / (ar ^ 4) : ℝ)) T volume :=
    integrableOn_const (hs := by
      have hsub : T ⊆ univ.pi fun _ : Fin 3 => Icc ar br := fun x hx j _ => by
        fin_cases j <;> simp [hx.1, hx.2.1, hx.2.2.1]
      exact (lt_of_le_of_lt (measure_mono hsub) (isCompact_univ_pi fun _ => isCompact_Icc).measure_lt_top).ne)
  have hmono := setIntegral_mono_on hf_int hc_int hT_meas hpt
  rw [setIntegral_const] at hmono
  -- Compute volume.real T = (br - ar)^3 / 6 via e210
  set S210 : Set (ℝ × (ℝ × ℝ)) := {p | p.1 ∈ Icc ar br ∧ p.2.1 ∈ Icc ar br ∧ p.2.2 ∈ Icc ar br ∧ p.2.2 ≤ p.2.1 ∧ p.2.1 ≤ p.1}
  have hpre : T = e210 ⁻¹' S210 := by
    ext x
    simp only [T, ordBox3, S210, mem_setOf_eq, mem_preimage, e210_apply]
    tauto
  have hvol_eq : volume.real T = ∫ p in S210, (1 : ℝ) := by
    have h1 : ∫ _ in T, (1 : ℝ) = volume.real T := by simp
    rw [← h1, hpre]
    exact volume_preserving_e210.setIntegral_preimage_emb e210.measurableEmbedding (fun _ => (1 : ℝ)) S210
  have hS_int : ∫ p in S210, (1 : ℝ) = (br - ar) ^ 3 / 6 := by
    set box3R : Set (ℝ × (ℝ × ℝ)) := Icc ar br ×ˢ (Icc ar br ×ˢ Icc ar br)
    set cond : Set (ℝ × (ℝ × ℝ)) := {p | p.2.2 ≤ p.2.1 ∧ p.2.1 ≤ p.1}
    have hS_sub : S210 = box3R ∩ cond := by
      ext p; simp only [S210, box3R, cond, mem_inter_iff, mem_setOf_eq, mem_prod]; tauto
    have hcond_meas : MeasurableSet cond :=
      (measurableSet_le measurable_snd.snd measurable_snd.fst).inter
        (measurableSet_le measurable_snd.fst measurable_fst)
    rw [hS_sub, ← MeasureTheory.setIntegral_indicator hcond_meas]
    have hind_int : IntegrableOn (Set.indicator cond (fun _ : ℝ × (ℝ × ℝ) => (1 : ℝ))) box3R volume :=
      (integrableOn_const ((isCompact_Icc.prod (isCompact_Icc.prod isCompact_Icc)).measure_lt_top.ne)).indicator hcond_meas
    dsimp only [box3R]
    rw [Measure.volume_eq_prod ℝ (ℝ × ℝ), MeasureTheory.setIntegral_prod _ hind_int]
    have hmid : ∀ x2 ∈ Icc ar br,
        ∫ q in Icc ar br ×ˢ Icc ar br,
          Set.indicator cond (fun _ : ℝ × (ℝ × ℝ) => (1 : ℝ)) (x2, q) = (x2 - ar) ^ 2 / 2 := by
      intro x2 hx2
      set cond2 : Set (ℝ × ℝ) := {q | q.2 ≤ q.1 ∧ q.1 ≤ x2}
      have hcond2_meas : MeasurableSet cond2 :=
        (measurableSet_le measurable_snd measurable_fst).inter (measurableSet_le measurable_fst measurable_const)
      have heq_ind : (fun q : ℝ × ℝ => Set.indicator cond (fun _ : ℝ × (ℝ × ℝ) => (1 : ℝ)) (x2, q)) =
          Set.indicator cond2 (fun _ : ℝ × ℝ => (1 : ℝ)) := by
        ext q; simp [Set.indicator, cond, cond2]
      rw [heq_ind]
      have hind2_int : IntegrableOn (Set.indicator cond2 (fun _ : ℝ × ℝ => (1 : ℝ))) (Icc ar br ×ˢ Icc ar br) volume :=
        (integrableOn_const ((isCompact_Icc.prod isCompact_Icc).measure_lt_top.ne)).indicator hcond2_meas
      rw [Measure.volume_eq_prod ℝ ℝ, MeasureTheory.setIntegral_prod _ hind2_int]
      have hin : ∀ x1 ∈ Icc ar br,
          ∫ x0 in Icc ar br, Set.indicator cond2 (fun _ : ℝ × ℝ => (1 : ℝ)) (x1, x0) =
          if x1 ≤ x2 then x1 - ar else 0 := by
        intro x1 hx1
        by_cases h12 : x1 ≤ x2
        · rw [if_pos h12]
          have heq_in : ∫ x0 in Icc ar br, Set.indicator cond2 (fun _ : ℝ × ℝ => (1 : ℝ)) (x1, x0) =
              ∫ x0 in Icc ar x1, (1 : ℝ) := by
            rw [← MeasureTheory.integral_indicator measurableSet_Icc, ← MeasureTheory.integral_indicator measurableSet_Icc]
            congr 1; ext x0; simp only [Set.indicator, mem_Icc, cond2, mem_setOf_eq]
            by_cases h0a : ar ≤ x0 <;> by_cases h0b : x0 ≤ br <;> by_cases h01 : x0 ≤ x1 <;> simp [h0a, h0b, h01, h12]
            exfalso; linarith [hx1.2]
          rw [heq_in, MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx1.1]
          simp
        · rw [if_neg h12]
          have h0 : ∀ x0 ∈ Icc ar br, Set.indicator cond2 (fun _ : ℝ × ℝ => (1 : ℝ)) (x1, x0) = 0 := by
            intro x0 _; simp [Set.indicator, cond2, h12]
          rw [MeasureTheory.setIntegral_congr_fun measurableSet_Icc h0]; simp
      rw [MeasureTheory.setIntegral_congr_fun measurableSet_Icc hin]
      have heq_mid : ∫ x1 in Icc ar br, (if x1 ≤ x2 then x1 - ar else 0) =
          ∫ x1 in Icc ar x2, (x1 - ar) := by
        rw [← MeasureTheory.integral_indicator measurableSet_Icc, ← MeasureTheory.integral_indicator measurableSet_Icc]
        congr 1; ext x1; simp only [Set.indicator, mem_Icc]
        by_cases h1a : ar ≤ x1 <;> by_cases h1b : x1 ≤ br <;> by_cases h12 : x1 ≤ x2 <;> simp [h1a, h1b, h12]
        exfalso; linarith [hx2.2]
      rw [heq_mid, MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hx2.1]
      have hd : ∀ t : ℝ, HasDerivAt (fun x : ℝ => (x - ar) ^ 2 / 2) (t - ar) t := by
        intro t
        have hs := ((hasDerivAt_id t).sub_const ar).pow 2
        have he : (2 : ℝ) * (t - ar) ^ 1 / 2 = t - ar := by ring
        simpa [he] using hs.div_const 2
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t) (Continuous.intervalIntegrable (by fun_prop) _ _)]
      ring
    rw [MeasureTheory.setIntegral_congr_fun measurableSet_Icc hmid,
        MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le harb]
    have hd : ∀ t : ℝ, HasDerivAt (fun x : ℝ => (x - ar) ^ 3 / 6) ((t - ar) ^ 2 / 2) t := by
      intro t
      have hs := ((hasDerivAt_id t).sub_const ar).pow 3
      have he : (3 : ℝ) * (t - ar) ^ 2 / 6 = (t - ar) ^ 2 / 2 := by ring
      simpa [he] using hs.div_const 6
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t) (Continuous.intervalIntegrable (by fun_prop) _ _)]
    ring
  have hvol_le : ∫ x in T, (1 / ((∏ j : Fin 3, x j) * x 1) : ℝ) ≤ (br - ar) ^ 3 / (6 * ar ^ 4) := by
    rw [hvol_eq, hS_int, smul_eq_mul] at hmono
    exact hmono.trans_eq (by ring)
  have heq_nat : (br - ar) ^ 3 / (6 * ar ^ 4) = (D_den : ℝ) * ((b : ℝ) - a) ^ 3 / (6 * a ^ 4) := by
    dsimp [ar, br]; field_simp
  rw [heq_nat] at hvol_le
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hden_pos : 0 < 6 * a ^ 4 := by positivity
  have hceil := le_mul_ceilDiv (a := W_scale * W_scale * W_scale * D_den * (b - a) ^ 3) (b := 6 * a ^ 4) hden_pos
  have hsub : ((b - a : ℕ) : ℝ) = (b : ℝ) - a := Nat.cast_sub hab
  have hceilr : (W_scale : ℝ) * W_scale * W_scale * D_den * ((b : ℝ) - a) ^ 3 ≤
      (6 * (a : ℝ) ^ 4) * (wDiag012 a b : ℝ) := by
    rw [← hsub]
    have hceil' : W_scale * W_scale * W_scale * D_den * (b - a) ^ 3 ≤ 6 * a ^ 4 * wDiag012 a b := by
      simpa [wDiag012, mul_assoc] using hceil
    exact_mod_cast hceil'
  have hle : (D_den : ℝ) * ((b : ℝ) - a) ^ 3 / (6 * a ^ 4) ≤ (wDiag012 a b : ℝ) / (W_scale * W_scale * W_scale) := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    linarith
  exact le_trans hvol_le hle

lemma integral_subset_union_two {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℝ} {A B C U : Set α}
    (hsub : A ⊆ B ∪ C) (hf_nn : ∀ x ∈ U, 0 ≤ f x) (hU : IntegrableOn f U μ)
    (hBU : B ⊆ U) (hCU : C ⊆ U)
    (hAm : MeasurableSet A) (hBm : MeasurableSet B) (hCm : MeasurableSet C) :
    ∫ x in A, f x ∂μ ≤ ∫ x in B, f x ∂μ + ∫ x in C, f x ∂μ := by
  have h1 : ∫ x in A, f x ∂μ ≤ ∫ x in B ∪ C, f x ∂μ :=
    setIntegral_mono_set (hU.mono_set (union_subset hBU hCU))
      (ae_restrict_of_forall_mem (hBm.union hCm) (fun x hx => hf_nn x (union_subset hBU hCU hx)))
      hsub.eventuallyLE
  have hBC : B ∪ C = B ∪ (C \ B) := (union_diff_self).symm
  have h2 : ∫ x in B ∪ C, f x ∂μ = ∫ x in B, f x ∂μ + ∫ x in C \ B, f x ∂μ := by
    rw [hBC]
    exact setIntegral_union disjoint_sdiff_self_right (hCm.diff hBm) (hU.mono_set hBU) (hU.mono_set (diff_subset.trans hCU))
  have h3 : ∫ x in C \ B, f x ∂μ ≤ ∫ x in C, f x ∂μ :=
    setIntegral_mono_set (hU.mono_set hCU) (ae_restrict_of_forall_mem hCm (fun x hx => hf_nn x (hCU hx))) diff_subset.eventuallyLE
  exact le_trans h1 (h2.symm ▸ add_le_add (le_refl _) h3)

lemma integral_subset_union_three {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℝ} {A B C D U : Set α}
    (hsub : A ⊆ B ∪ (C ∪ D)) (hf_nn : ∀ x ∈ U, 0 ≤ f x) (hU : IntegrableOn f U μ)
    (hBU : B ⊆ U) (hCU : C ⊆ U) (hDU : D ⊆ U)
    (hAm : MeasurableSet A) (hBm : MeasurableSet B) (hCm : MeasurableSet C) (hDm : MeasurableSet D) :
    ∫ x in A, f x ∂μ ≤ ∫ x in B, f x ∂μ + ∫ x in C, f x ∂μ + ∫ x in D, f x ∂μ := by
  have h1 := integral_subset_union_two hsub hf_nn hU hBU (union_subset hCU hDU) hAm hBm (hCm.union hDm)
  have h2 := integral_subset_union_two (Subset.refl (C ∪ D)) hf_nn hU hCU hDU (hCm.union hDm) hCm hDm
  exact le_trans h1 ((add_le_add (le_refl _) h2).trans_eq (add_assoc _ _ _).symm)

lemma integral_subset_union_four {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {f : α → ℝ} {A B C D E U : Set α}
    (hsub : A ⊆ (B ∪ C) ∪ (D ∪ E)) (hf_nn : ∀ x ∈ U, 0 ≤ f x) (hU : IntegrableOn f U μ)
    (hBU : B ⊆ U) (hCU : C ⊆ U) (hDU : D ⊆ U) (hEU : E ⊆ U)
    (hAm : MeasurableSet A) (hBm : MeasurableSet B) (hCm : MeasurableSet C) (hDm : MeasurableSet D) (hEm : MeasurableSet E) :
    ∫ x in A, f x ∂μ ≤ ∫ x in B, f x ∂μ + ∫ x in C, f x ∂μ + ∫ x in D, f x ∂μ + ∫ x in E, f x ∂μ := by
  have h1 := integral_subset_union_two hsub hf_nn hU (union_subset hBU hCU) (union_subset hDU hEU) hAm (hBm.union hCm) (hDm.union hEm)
  have h2 := integral_subset_union_two (Subset.refl (B ∪ C)) hf_nn hU hBU hCU (hBm.union hCm) hBm hCm
  have h3 := integral_subset_union_two (Subset.refl (D ∪ E)) hf_nn hU hDU hEU (hDm.union hEm) hDm hEm
  exact le_trans h1 ((add_le_add h2 h3).trans_eq (by ring))

lemma domain_eq :
    domain r3FourteenLo r3FourteenHi =
      ordBox3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
              ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
              ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) := by
  have hlo0 : r3FourteenLo 0 = (A0_num : ℝ) / D_den := by simp [r3FourteenLo, A0_num, D_den]; norm_num
  have hhi0 : r3FourteenHi 0 = (B0_num : ℝ) / D_den := by simp [r3FourteenHi, B0_num, D_den]; norm_num
  have hlo1 : r3FourteenLo 1 = (A1_num : ℝ) / D_den := by simp [r3FourteenLo, A1_num, D_den]; norm_num
  have hhi1 : r3FourteenHi 1 = (B1_num : ℝ) / D_den := by simp [r3FourteenHi, B1_num, D_den]; norm_num
  have hlo2 : r3FourteenLo 2 = (A2_num : ℝ) / D_den := by simp [r3FourteenLo, A2_num, D_den]; norm_num
  have hhi2 : r3FourteenHi 2 = (B2_num : ℝ) / D_den := by simp [r3FourteenHi, B2_num, D_den]; norm_num
  ext x
  simp only [domain, ordBox3, mem_setOf_eq]
  constructor
  · rintro ⟨hm, hb⟩
    have h01 : x 0 ≤ x 1 := hm (by decide)
    have h12 : x 1 ≤ x 2 := hm (by decide)
    refine ⟨?_, ?_, ?_, h01, h12⟩
    · simpa [hlo0, hhi0] using hb 0
    · simpa [hlo1, hhi1] using hb 1
    · simpa [hlo2, hhi2] using hb 2
  · rintro ⟨hx0, hx1, hx2, h01, h12⟩
    refine ⟨?_, ?_⟩
    · intro i j hij
      fin_cases i <;> fin_cases j <;> simp at hij ⊢ <;> linarith
    · intro j; fin_cases j <;> [simpa [hlo0, hhi0] using hx0; simpa [hlo1, hhi1] using hx1; simpa [hlo2, hhi2] using hx2]

lemma integrand_integrableOn_root {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω) (φ : ℝ) :
    IntegrableOn (fun x : Fin 3 → ℝ => ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩))
      (ordBox3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
               ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
               ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den)) volume := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_den := by unfold A0_num D_den; positivity
  have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_den := by unfold A1_num D_den; positivity
  have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_den := by unfold A2_num D_den; positivity
  set R := ordBox3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
                   ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
                   ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den)
  have hR_meas : MeasurableSet R := ordBox3_measurable _ _ _ _ _ _
  have hR_comp : IsCompact R := by
    have hbox : IsCompact (univ.pi ![Icc ((A0_num : ℝ) / D_den) (B0_num / D_den),
                                    Icc ((A1_num : ℝ) / D_den) (B1_num / D_den),
                                    Icc ((A2_num : ℝ) / D_den) (B2_num / D_den)]) :=
      isCompact_univ_pi fun d => by fin_cases d <;> exact isCompact_Icc
    refine hbox.of_isClosed_subset ?_ (fun x hx d _ => by fin_cases d <;> simp [hx.1, hx.2.1, hx.2.2.1])
    simp only [R, ordBox3, setOf_and]
    exact (isClosed_Icc.preimage (continuous_apply 0)).inter
      ((isClosed_Icc.preimage (continuous_apply 1)).inter
        ((isClosed_Icc.preimage (continuous_apply 2)).inter
          ((isClosed_le (continuous_apply 0 : Continuous fun p : Fin 3 → ℝ => p 0) (continuous_apply 1)).inter
            (isClosed_le (continuous_apply (1 : Fin 3)) (continuous_apply (2 : Fin 3))))))
  have hω_meas : Measurable ω := by
    have h2 : ω = Set.indicator (Ici 1) ω := by
      ext u; by_cases hu : 1 ≤ u
      · simp [Set.indicator, hu]
      · simp [Set.indicator, hu, hz u (lt_of_not_ge hu)]
    rw [h2]
    intro t ht
    have hsub : Continuous (fun y : Ici (1 : ℝ) => ω y) := continuousOn_iff_continuous_restrict.mp hω.1
    have hpre1 : MeasurableSet ((fun y : Ici (1 : ℝ) => ω y) ⁻¹' t) := ht.preimage hsub.measurable
    have hemb : MeasurableEmbedding (Subtype.val : Ici (1 : ℝ) → ℝ) := MeasurableEmbedding.subtype_coe measurableSet_Ici
    have himg : MeasurableSet (Subtype.val '' ((fun y : Ici (1 : ℝ) => ω y) ⁻¹' t)) := hemb.measurableSet_image.mpr hpre1
    have heq : Set.indicator (Ici 1) ω ⁻¹' t =
        (Subtype.val '' ((fun y : Ici (1 : ℝ) => ω y) ⁻¹' t)) ∪ (if (0 : ℝ) ∈ t then (Ici (1 : ℝ))ᶜ else ∅) := by
      ext u
      simp only [mem_preimage, Set.indicator, mem_Ici, mem_union, mem_image, Subtype.exists, exists_and_right, exists_eq_right, mem_compl_iff]
      by_cases hu : 1 ≤ u
      · by_cases h0 : (0 : ℝ) ∈ t <;> simp [hu, h0]
      · by_cases h0 : (0 : ℝ) ∈ t <;> simp [hu, h0] <;> exact lt_of_not_ge hu
    rw [heq]
    exact himg.union (by split_ifs; exact measurableSet_Ici.compl; exact MeasurableSet.empty)
  have hf_meas : AEStronglyMeasurable
      (fun x : Fin 3 → ℝ => ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩))
      (volume.restrict R) := by
    refine (Measurable.div (hω_meas.comp ?_) ?_).aestronglyMeasurable
    · exact (measurable_const.sub (Finset.measurable_sum _ fun j _ => measurable_pi_apply j)).div (measurable_pi_apply 1)
    · exact (Finset.measurable_prod _ fun j _ => measurable_pi_apply j).mul (measurable_pi_apply 1)
  have hω_bd : ∃ M : ℝ, ∀ u : ℝ, ω u ≤ M := by
    have hcont : ContinuousOn ω (Icc 1 4) := hω.1.mono (fun u hu => hu.1)
    obtain ⟨M, hM⟩ := isCompact_Icc.exists_bound_of_continuousOn hcont
    refine ⟨max M (max 0 ((M4_val : ℝ) / S_scale)), fun u => ?_⟩
    by_cases hu1 : u < 1
    · rw [hz u hu1]; exact le_max_of_le_right (le_max_left _ _)
    · by_cases hu4 : 4 ≤ u
      · exact le_trans (buchstab_le_M4 hω u hu4) (le_max_of_le_right (le_max_right _ _))
      · have hu_in : u ∈ Icc 1 4 := ⟨le_of_not_gt hu1, le_of_not_ge hu4⟩
        exact le_trans (le_abs_self (ω u)) (le_trans (hM u hu_in) (le_max_left _ _))
  obtain ⟨M, hM⟩ := hω_bd
  set C : ℝ := max 0 M / ((A0_num / D_den) * (A1_num / D_den) * (A2_num / D_den) * (A1_num / D_den))
  refine IntegrableOn.of_bound hR_comp.measure_lt_top hf_meas C ?_
  filter_upwards [ae_restrict_mem hR_meas] with x hx
  have hx0 : (A0_num : ℝ) / D_den ≤ x 0 := hx.1.1
  have hx1 : (A1_num : ℝ) / D_den ≤ x 1 := hx.2.1.1
  have hx2 : (A2_num : ℝ) / D_den ≤ x 2 := hx.2.2.1.1
  have hden_pos : 0 < (∏ j : Fin 3, x j) * x ⟨1, by omega⟩ := by
    rw [Fin.prod_univ_three]
    have := lt_of_lt_of_le hA0 hx0; have := lt_of_lt_of_le hA1 hx1; have := lt_of_lt_of_le hA2 hx2
    positivity
  have hden_ge : (A0_num / D_den) * (A1_num / D_den) * (A2_num / D_den) * (A1_num / D_den) ≤
      (∏ j : Fin 3, x j) * x ⟨1, by omega⟩ := by
    rw [Fin.prod_univ_three]
    have h01 := mul_le_mul hx0 hx1 (le_of_lt hA1) (le_trans (le_of_lt hA0) hx0)
    have h012 := mul_le_mul h01 hx2 (le_of_lt hA2) (le_trans (mul_pos hA0 hA1).le h01)
    exact mul_le_mul h012 hx1 (le_of_lt hA1) (le_trans (mul_pos (mul_pos hA0 hA1) hA2).le h012)
  have hf_nn : 0 ≤ ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) :=
    div_nonneg (buchstab_nonneg hω hz _) (le_of_lt hden_pos)
  have hf_le : ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) ≤ C := by
    dsimp [C]
    exact div_le_div₀ (le_max_left 0 M) (le_trans (hM _) (le_max_right 0 M)) (mul_pos (mul_pos (mul_pos hA0 hA1) hA2) hA1) hden_ge
  rw [Real.norm_of_nonneg hf_nn]
  exact hf_le

lemma ordBox3_sub_s0 {x0a m x0b x1a x1b x2a x2b : ℝ} (h1 : x0a ≤ m) (h2 : m ≤ x0b) :
    ordBox3 x0a x0b x1a x1b x2a x2b ⊆ ordBox3 x0a m x1a x1b x2a x2b ∪ ordBox3 m x0b x1a x1b x2a x2b := by
  intro x hx
  cases le_total (x 0) m with
  | inl h => exact Or.inl ⟨⟨hx.1.1, h⟩, hx.2.1, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩
  | inr h => exact Or.inr ⟨⟨h, hx.1.2⟩, hx.2.1, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩

lemma ordBox3_sub_s1 {x0a x0b x1a m x1b x2a x2b : ℝ} :
    ordBox3 x0a x0b x1a x1b x2a x2b ⊆ ordBox3 x0a x0b x1a m x2a x2b ∪ ordBox3 x0a x0b m x1b x2a x2b := by
  intro x hx
  cases le_total (x 1) m with
  | inl h => exact Or.inl ⟨hx.1, ⟨hx.2.1.1, h⟩, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩
  | inr h => exact Or.inr ⟨hx.1, ⟨h, hx.2.1.2⟩, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩

lemma ordBox3_sub_s2 {x0a x0b x1a x1b x2a m x2b : ℝ} :
    ordBox3 x0a x0b x1a x1b x2a x2b ⊆ ordBox3 x0a x0b x1a x1b x2a m ∪ ordBox3 x0a x0b x1a x1b m x2b := by
  intro x hx
  cases le_total (x 2) m with
  | inl h => exact Or.inl ⟨hx.1, hx.2.1, ⟨hx.2.2.1.1, h⟩, hx.2.2.2.1, hx.2.2.2.2⟩
  | inr h => exact Or.inr ⟨hx.1, hx.2.1, ⟨h, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩

lemma ordBox3_sub_sd01 {a m b x2a x2b : ℝ} :
    ordBox3 a b a b x2a x2b ⊆
      ordBox3 a m a m x2a x2b ∪ (ordBox3 a m m b x2a x2b ∪ ordBox3 m b m b x2a x2b) := by
  intro x hx
  cases le_total (x 1) m with
  | inl h1 => exact Or.inl ⟨⟨hx.1.1, le_trans hx.2.2.2.1 h1⟩, ⟨hx.2.1.1, h1⟩, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩
  | inr h1 =>
      cases le_total (x 0) m with
      | inl h0 => exact Or.inr (Or.inl ⟨⟨hx.1.1, h0⟩, ⟨h1, hx.2.1.2⟩, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩)
      | inr h0 => exact Or.inr (Or.inr ⟨⟨h0, hx.1.2⟩, ⟨h1, hx.2.1.2⟩, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2⟩)

lemma ordBox3_sub_sd12 {x0a x0b a m b : ℝ} :
    ordBox3 x0a x0b a b a b ⊆
      ordBox3 x0a x0b a m a m ∪ (ordBox3 x0a x0b a m m b ∪ ordBox3 x0a x0b m b m b) := by
  intro x hx
  cases le_total (x 2) m with
  | inl h2 => exact Or.inl ⟨hx.1, ⟨hx.2.1.1, le_trans hx.2.2.2.2 h2⟩, ⟨hx.2.2.1.1, h2⟩, hx.2.2.2.1, hx.2.2.2.2⟩
  | inr h2 =>
      cases le_total (x 1) m with
      | inl h1 => exact Or.inr (Or.inl ⟨hx.1, ⟨hx.2.1.1, h1⟩, ⟨h2, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)
      | inr h1 => exact Or.inr (Or.inr ⟨hx.1, ⟨h1, hx.2.1.2⟩, ⟨h2, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)

lemma ordBox3_sub_sd012 {a m b : ℝ} :
    ordBox3 a b a b a b ⊆
      (ordBox3 a m a m a m ∪ ordBox3 a m a m m b) ∪ (ordBox3 a m m b m b ∪ ordBox3 m b m b m b) := by
  intro x hx
  cases le_total (x 2) m with
  | inl h2 =>
      have h1 : x 1 ≤ m := le_trans hx.2.2.2.2 h2
      have h0 : x 0 ≤ m := le_trans hx.2.2.2.1 h1
      exact Or.inl (Or.inl ⟨⟨hx.1.1, h0⟩, ⟨hx.2.1.1, h1⟩, ⟨hx.2.2.1.1, h2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)
  | inr h2 =>
      cases le_total (x 1) m with
      | inl h1 =>
          have h0 : x 0 ≤ m := le_trans hx.2.2.2.1 h1
          exact Or.inl (Or.inr ⟨⟨hx.1.1, h0⟩, ⟨hx.2.1.1, h1⟩, ⟨h2, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)
      | inr h1 =>
          cases le_total (x 0) m with
          | inl h0 => exact Or.inr (Or.inl ⟨⟨hx.1.1, h0⟩, ⟨h1, hx.2.1.2⟩, ⟨h2, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)
          | inr h0 => exact Or.inr (Or.inr ⟨⟨h0, hx.1.2⟩, ⟨h1, hx.2.1.2⟩, ⟨h2, hx.2.2.1.2⟩, hx.2.2.2.1, hx.2.2.2.2⟩)

lemma ordBox3_mono {a0 a0' b0' b0 a1 a1' b1' b1 a2 a2' b2' b2 : ℝ}
    (h0l : a0 ≤ a0') (h0r : b0' ≤ b0) (h1l : a1 ≤ a1') (h1r : b1' ≤ b1) (h2l : a2 ≤ a2') (h2r : b2' ≤ b2) :
    ordBox3 a0' b0' a1' b1' a2' b2' ⊆ ordBox3 a0 b0 a1 b1 a2 b2 :=
  fun _ hx => ⟨⟨le_trans h0l hx.1.1, le_trans hx.1.2 h0r⟩,
               ⟨le_trans h1l hx.2.1.1, le_trans hx.2.1.2 h1r⟩,
               ⟨le_trans h2l hx.2.2.1.1, le_trans hx.2.2.1.2 h2r⟩,
               hx.2.2.2.1, hx.2.2.2.2⟩

lemma evalBox_sound {ω : ℝ → ℝ} (hω : IsBuchstab ω) (hz : ZeroBelowOne ω) {φ : ℝ}
    {pa_n pb_n : ℕ} (hpa : (pa_n : ℝ) / D_den ≤ φ) (hpb : φ ≤ (pb_n : ℝ) / D_den) :
    ∀ (t : BoxTree) (x0a x0b x1a x1b x2a x2b : ℕ),
      validTree t x0a x0b x1a x1b x2a x2b = true →
      ordBox3 ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
              ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
              ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den) ⊆
      ordBox3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
              ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
              ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den) →
      ∫ x in ordBox3 ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                     ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                     ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den),
        ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩) ≤
      (evalBox pa_n pb_n t x0a x0b x1a x1b x2a x2b : ℝ) / ((S_scale : ℝ) * W_scale * W_scale * W_scale) := by
  have hDpos : (0 : ℝ) < D_den := by unfold D_den; positivity
  have hKpos : (0 : ℝ) < K_grid := by unfold K_grid; positivity
  have hSpos : (0 : ℝ) < S_scale := by unfold S_scale; positivity
  have hWpos : (0 : ℝ) < W_scale := by unfold W_scale; positivity
  have hint_root := integrand_integrableOn_root hω hz φ
  set f : (Fin 3 → ℝ) → ℝ := fun x => ω ((φ - ∑ j, x j) / x ⟨1, by omega⟩) / ((∏ j, x j) * x ⟨1, by omega⟩)
  have hf_nn : ∀ x ∈ ordBox3 ((A0_num : ℝ) / D_den) ((B0_num : ℝ) / D_den)
                             ((A1_num : ℝ) / D_den) ((B1_num : ℝ) / D_den)
                             ((A2_num : ℝ) / D_den) ((B2_num : ℝ) / D_den), 0 ≤ f x := by
    intro x hx
    have hA0 : (0 : ℝ) < (A0_num : ℝ) / D_den := by unfold A0_num D_den; positivity
    have hA1 : (0 : ℝ) < (A1_num : ℝ) / D_den := by unfold A1_num D_den; positivity
    have hA2 : (0 : ℝ) < (A2_num : ℝ) / D_den := by unfold A2_num D_den; positivity
    have hden_pos : 0 < (∏ j : Fin 3, x j) * x ⟨1, by omega⟩ := by
      rw [Fin.prod_univ_three]
      have := lt_of_lt_of_le hA0 hx.1.1
      have := lt_of_lt_of_le hA1 hx.2.1.1
      have := lt_of_lt_of_le hA2 hx.2.2.1.1
      positivity
    exact div_nonneg (buchstab_nonneg hω hz _) (le_of_lt hden_pos)
  intro t
  induction t with
  | lf =>
      intro x0a x0b x1a x1b x2a x2b hval hsub
      simp only [validTree, Bool.and_eq_true, Bool.or_eq_true, decide_eq_true_eq, beq_iff_eq] at hval
      rcases hval with ⟨⟨⟨⟨⟨⟨h0p, h0le⟩, h1p⟩, h1le⟩, h2p⟩, h2le⟩, hcases⟩
      set B := ordBox3 ((x0a : ℝ) / D_den) ((x0b : ℝ) / D_den)
                       ((x1a : ℝ) / D_den) ((x1b : ℝ) / D_den)
                       ((x2a : ℝ) / D_den) ((x2b : ℝ) / D_den)
      set k0 : ℕ := ((pa_n - x0b - 2 * x1b - x2b) * K_grid) / x1b
      set k1 : ℕ := ((pb_n - x0a - 2 * x1a - x2a) * K_grid) / x1a
      set ub : ℕ := buchstabUB k0 k1
      have h1b_pos : 0 < x1b := lt_of_lt_of_le h1p h1le
      have hpt : ∀ x ∈ B, f x ≤ ((ub : ℝ) / S_scale) * (1 / ((∏ j : Fin 3, x j) * x 1)) := by
        intro x hx
        have hx0 : (x0a : ℝ) / D_den ≤ x 0 ∧ x 0 ≤ (x0b : ℝ) / D_den := hx.1
        have hx1 : (x1a : ℝ) / D_den ≤ x 1 ∧ x 1 ≤ (x1b : ℝ) / D_den := hx.2.1
        have hx2 : (x2a : ℝ) / D_den ≤ x 2 ∧ x 2 ≤ (x2b : ℝ) / D_den := hx.2.2.1
        have hx0_pos : 0 < x 0 := lt_of_lt_of_le (div_pos (by exact_mod_cast h0p) hDpos) hx0.1
        have hx1_pos : 0 < x 1 := lt_of_lt_of_le (div_pos (by exact_mod_cast h1p) hDpos) hx1.1
        have hx2_pos : 0 < x 2 := lt_of_lt_of_le (div_pos (by exact_mod_cast h2p) hDpos) hx2.1
        have hden_pos : 0 < (∏ j : Fin 3, x j) * x 1 := by
          rw [Fin.prod_univ_three]; positivity
        have hsum : ∑ j : Fin 3, x j = x 0 + x 1 + x 2 := Fin.sum_univ_three x
        set u : ℝ := (φ - ∑ j, x j) / x 1
        have hlo_u : 1 ≤ u → 1 + (k0 : ℝ) / K_grid ≤ u := by
          intro hu1
          by_cases hsub0 : pa_n < x0b + 2 * x1b + x2b
          · have hk0_0 : k0 = 0 := by
              dsimp [k0]
              have : pa_n - x0b - 2 * x1b - x2b = 0 := by omega
              simp [this]
            rw [hk0_0]; norm_num; exact hu1
          · have hsub_ge : x0b + 2 * x1b + x2b ≤ pa_n := Nat.le_of_not_lt hsub0
            have hdiv_le : (k0 : ℝ) ≤ ((pa_n - x0b - 2 * x1b - x2b : ℕ) * K_grid : ℝ) / x1b := by
              have h1 : k0 * x1b ≤ (pa_n - x0b - 2 * x1b - x2b) * K_grid := Nat.div_mul_le_self _ _
              rw [le_div_iff₀ (by exact_mod_cast h1b_pos)]
              exact_mod_cast h1
            have hcast_sub : ((pa_n - x0b - 2 * x1b - x2b : ℕ) : ℝ) =
                (pa_n : ℝ) - x0b - 2 * x1b - x2b := by
              have h1 : pa_n - x0b - 2 * x1b - x2b = pa_n - (x0b + 2 * x1b + x2b) := by omega
              rw [h1, Nat.cast_sub hsub_ge]; push_cast; ring
            have hnum : (pa_n : ℝ) / D_den - (x0b : ℝ) / D_den - 2 * ((x1b : ℝ) / D_den) - (x2b : ℝ) / D_den ≤
                φ - x 0 - 2 * x 1 - x 2 := by linarith [hx0.2, hx1.2, hx2.2]
            have hnum_nn : 0 ≤ (pa_n : ℝ) / D_den - (x0b : ℝ) / D_den - 2 * ((x1b : ℝ) / D_den) - (x2b : ℝ) / D_den := by
              have : (0 : ℝ) ≤ (pa_n : ℝ) - x0b - 2 * x1b - x2b := by rw [← hcast_sub]; positivity
              have hdiv : (pa_n : ℝ) / D_den - (x0b : ℝ) / D_den - 2 * ((x1b : ℝ) / D_den) - (x2b : ℝ) / D_den =
                  ((pa_n : ℝ) - x0b - 2 * x1b - x2b) / D_den := by ring
              rw [hdiv]; exact div_nonneg this (le_of_lt hDpos)
            have hu_eq : u - 1 = (φ - x 0 - 2 * x 1 - x 2) / x 1 := by
              dsimp [u]; rw [hsum]; field_simp; ring
            have hle1 : ((pa_n : ℝ) - x0b - 2 * x1b - x2b) / x1b ≤ u - 1 := by
              rw [hu_eq]
              have h1 : ((pa_n : ℝ) - x0b - 2 * x1b - x2b) / x1b =
                  ((pa_n : ℝ) / D_den - x0b / D_den - 2 * (x1b / D_den) - x2b / D_den) / (x1b / D_den) := by
                field_simp
              rw [h1]
              exact div_le_div₀ (by linarith) hnum hx1_pos hx1.2
            have hle2 : (k0 : ℝ) / K_grid ≤ u - 1 := by
              have h2 : (k0 : ℝ) / K_grid ≤ ((pa_n - x0b - 2 * x1b - x2b : ℕ) : ℝ) / x1b := by
                rw [div_le_iff₀ hKpos]
                calc (k0 : ℝ) ≤ ((pa_n - x0b - 2 * x1b - x2b : ℕ) * K_grid : ℝ) / x1b := hdiv_le
                  _ = ((pa_n - x0b - 2 * x1b - x2b : ℕ) : ℝ) / x1b * K_grid := by ring
              rw [hcast_sub] at h2
              exact le_trans h2 hle1
            linarith
        have hhi_u : u < 1 + ((k1 : ℝ) + 1) / K_grid := by
