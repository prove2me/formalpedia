/-! ## Euler's pentagonal recurrence

Euler's identity `(∑ₙ p(n) qⁿ) · ∏_{i ≥ 1} (1 - qⁱ) = 1` and the pentagonal number theorem
`∏_{i ≥ 1} (1 - qⁱ) = ∑_{k ∈ ℤ} (-1)ᵏ q^{k(3k-1)/2}` (both available in Mathlib) give, on comparing
the coefficients of `qⁿ` for `n ≥ 1`,

  `p(n) = ∑_{k ≥ 1} (-1)^{k+1} (p(n - k(3k-1)/2) + p(n - k(3k+1)/2))`,

where terms with a negative argument are omitted. `partitionCountRec` evaluates exactly this
recurrence from the table of earlier values, so it agrees with `partitionCount` for every `n`
(`partitionCountRec_eq_partitionCount`). The concrete values `p(2), …, p(11)` below (and
`p(12), …` in the companion files) then follow by evaluating `partitionCountRec`, without
enumerating partitions. -/

section EulerRecurrence

open scoped PowerSeries.WithPiTopology

/-- The lower generalized pentagonal number `k(3k-1)/2` is Mathlib's `pentagonal k`. -/
theorem pentagonalLower_eq_pentagonal (k : Nat) : pentagonalLower k = pentagonal (k : ℤ) := by
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · rfl
  · have h : ((k * (3 * k - 1) / 2 : Nat) : ℤ) = (k : ℤ) * (3 * k - 1) / 2 := by
      simp [Int.natCast_ediv, Nat.cast_sub (by omega : 1 ≤ 3 * k)]
    rw [pentagonal_def, ← h, Int.toNat_natCast]
    rfl

/-- The upper generalized pentagonal number `k(3k+1)/2` is Mathlib's `pentagonal (-k)`. -/
theorem pentagonalUpper_eq_pentagonal (k : Nat) :
    pentagonalUpper k = pentagonal (-(k : ℤ)) := by
  have h : ((k * (3 * k + 1) / 2 : Nat) : ℤ) = (k : ℤ) * (3 * k + 1) / 2 := by
    simp [Int.natCast_ediv]
  rw [pentagonal_neg, ← h, Int.toNat_natCast]
  rfl

private theorem le_pentagonalLower (k : Nat) : k ≤ pentagonalLower k := by
  unfold pentagonalLower
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · exact Nat.zero_le _
  · rw [Nat.le_div_iff_mul_le (by norm_num)]
    exact Nat.mul_le_mul le_rfl (by omega)

private theorem pentagonalLower_le_pentagonalUpper (k : Nat) :
    pentagonalLower k ≤ pentagonalUpper k := by
  unfold pentagonalLower pentagonalUpper
  exact Nat.div_le_div_right (Nat.mul_le_mul le_rfl (by omega))

end EulerRecurrence
end Ch01
end QseriesFormalization

open QseriesFormalization QseriesFormalization.Ch01
open scoped PowerSeries.WithPiTopology
theorem solution {m k : Nat} (hk : k ≤ m) :
    PowerSeries.coeff k (PowerSeries.pentagonalSeries ℤ) =
      (if k = 0 then 1 else 0) +
      ∑ j ∈ Finset.range m, (-1 : ℤ) ^ (j + 1) *
        ((if k = pentagonalLower (j + 1) then 1 else 0) +
          (if k = pentagonalUpper (j + 1) then 1 else 0)) := by
  have hp0 : pentagonal 0 = 0 := rfl
  by_cases h : ∃ t : ℤ, pentagonal t = k
  · obtain ⟨t, rfl⟩ := h
    have h0 : pentagonal t = 0 ↔ t = 0 := by rw [← hp0, pentagonal_inj]
    rw [PowerSeries.coeff_pentagonalSeries_pentagonal, Int.coe_negOnePow]
    simp only [pentagonalLower_eq_pentagonal, pentagonalUpper_eq_pentagonal, pentagonal_inj, h0]
    rcases lt_trichotomy t 0 with ht | rfl | ht
    · obtain ⟨j0, rfl⟩ : ∃ j0 : Nat, t = -((j0 + 1 : Nat) : ℤ) :=
        ⟨(-t - 1).toNat, by
          have := Int.toNat_of_nonneg (show 0 ≤ -t - 1 by omega)
          push_cast; omega⟩
      have hj0 : j0 < m := by
        have := le_pentagonalLower (j0 + 1)
        have := pentagonalLower_le_pentagonalUpper (j0 + 1)
        rw [← pentagonalUpper_eq_pentagonal] at hk
        omega
      have hsum : ∀ j ∈ Finset.range m, (-1 : ℤ) ^ (j + 1) *
          ((if -((j0 + 1 : Nat) : ℤ) = ((j + 1 : Nat) : ℤ) then 1 else 0) +
            (if -((j0 + 1 : Nat) : ℤ) = -((j + 1 : Nat) : ℤ) then 1 else 0)) =
          if j = j0 then (-1 : ℤ) ^ (j0 + 1) else 0 := by
        intro j _
        split_ifs <;> first | omega | (subst_vars; ring)
      rw [Int.natAbs_neg, Int.natAbs_natCast]
      rw [if_neg (show -((j0 + 1 : Nat) : ℤ) ≠ 0 by omega), Finset.sum_congr rfl hsum]
      simp [hj0]
    · rw [if_pos rfl, Finset.sum_eq_zero]
      · simp
      · intro j _
        split_ifs <;> omega
    · obtain ⟨j0, rfl⟩ : ∃ j0 : Nat, t = ((j0 + 1 : Nat) : ℤ) :=
        ⟨(t - 1).toNat, by
          have := Int.toNat_of_nonneg (show 0 ≤ t - 1 by omega)
          push_cast; omega⟩
      have hj0 : j0 < m := by
        have := le_pentagonalLower (j0 + 1)
        rw [← pentagonalLower_eq_pentagonal] at hk
        omega
      have hsum : ∀ j ∈ Finset.range m, (-1 : ℤ) ^ (j + 1) *
          ((if ((j0 + 1 : Nat) : ℤ) = ((j + 1 : Nat) : ℤ) then 1 else 0) +
            (if ((j0 + 1 : Nat) : ℤ) = -((j + 1 : Nat) : ℤ) then 1 else 0)) =
          if j = j0 then (-1 : ℤ) ^ (j0 + 1) else 0 := by
        intro j _
        split_ifs <;> first | omega | (subst_vars; ring)
      rw [Int.natAbs_natCast]
      rw [if_neg (show ((j0 + 1 : Nat) : ℤ) ≠ 0 by omega), Finset.sum_congr rfl hsum]
      simp [hj0]
  · simp only [not_exists] at h
    have hk' : k ∉ Set.range pentagonal := by simpa using h
    rw [PowerSeries.coeff_pentagonalSeries_eq_zero ℤ hk']
    have hk0 : k ≠ 0 := fun hk0 => h 0 (hp0.trans hk0.symm)
    rw [if_neg hk0, zero_add]
    symm
    refine Finset.sum_eq_zero fun j _ => ?_
    rw [if_neg (fun e => h ((j + 1 : Nat) : ℤ) (by rw [e, pentagonalLower_eq_pentagonal])),
      if_neg (fun e => h (-((j + 1 : Nat) : ℤ)) (by rw [e, pentagonalUpper_eq_pentagonal]))]
    ring
