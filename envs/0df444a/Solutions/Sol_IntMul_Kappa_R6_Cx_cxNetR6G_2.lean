section
-- Source module: Solutions.R6CxNetTensor
/-!
# Lifting local labels of `𝔽₂^24` to `𝔽₂^576 = 𝔽₂^24 ⊗ 𝔽₂^24`

* `tens x y` (`x ⊗ y`), `ιR t : x ↦ x ⊗ t`, `ιL t : y ↦ t ⊗ y`; for a unit `t` both are isometries.
* Stage one (invocation `t`): `lift1 t L = L ⊗ t`; stage two: `lift2 t L = D0 t ⊔ t ⊗ L^⊥` with
  `D0 t = (t ⊗ 𝔽₂^24)^⊥`.
* `edge_lift1` / `edge_lift2`: local `EdgeOK` edges lift; `Fd_lift1` / `Fd_lift2`: residual widths
  are unchanged.
* Boundary edges (`up_E1` … `up_E5`) and the endpoint identity `lift2_line`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx.NetT

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2

lemma tens_e2 (x y : V24) (i j : Fin 24) : tens x y (e2 (i, j)) = x i * y j := by
  simp [tens]

theorem tens_dot (x y x' y' : V24) : tens x y ⬝ᵥ tens x' y' = (x ⬝ᵥ x') * (y ⬝ᵥ y') := by
  simp only [dotProduct]
  rw [← e2.sum_comp, Fintype.sum_prod_type, Finset.sum_mul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [tens_e2, tens_e2]; ring

lemma isoR {t : V24} (ht : t ⬝ᵥ t = 1) : IsoM (ιR t) := fun x y => by
  simp [tens_dot, ht]

lemma isoL {t : V24} (ht : t ⬝ᵥ t = 1) : IsoM (ιL t) := fun x y => by
  simp [tens_dot, ht]

variable {ι : V24 →ₗ[ZMod 2] V576}

lemma IsoM.injective (h : IsoM ι) : Function.Injective ι := by
  rw [← LinearMap.ker_eq_bot, eq_bot_iff]
  intro x hx
  rw [Submodule.mem_bot]
  have hy : ∀ y, x ⬝ᵥ y = 0 := fun y => by rw [← h, LinearMap.mem_ker.1 hx, zero_dotProduct]
  funext i
  have := hy (Pi.single i 1)
  simpa [dotProduct_single] using this

lemma finrank_map_iso (h : IsoM ι) (L : L24) : finrank (ZMod 2) (L.map ι) = finrank (ZMod 2) L :=
  (LinearEquiv.finrank_eq (Submodule.equivMapOfInjective ι h.injective L)).symm

lemma IsoM.nondeg (h : IsoM ι) {U : L24} (hU : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) U) :
    NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (U.map ι) := by
  intro z hz hzz
  obtain ⟨x, hx, rfl⟩ := hz
  have : x = 0 := hU x hx fun y hy => by
    have := hzz (ι y) ⟨y, hy, rfl⟩
    rw [bf_one, h] at this; rw [bf_one]; exact this
  simp [this]

lemma nondeg_sup {D W : L576} (hD : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) D)
    (hW : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) W) (hO : OrthS D W) :
    NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (D ⊔ W) := by
  intro z hz hzz
  obtain ⟨d, hd, w, hw, rfl⟩ := Submodule.mem_sup.1 hz
  have h1 : d = 0 := hD d hd fun y hy => by
    have := hzz y (Submodule.mem_sup_left hy)
    rw [bf_one, add_dotProduct, dotProduct_comm w y, hO y hy w hw, add_zero] at this
    rw [bf_one]; exact this
  have h2 : w = 0 := hW w hw fun y hy => by
    have := hzz y (Submodule.mem_sup_right hy)
    rw [bf_one, add_dotProduct, hO d hd y hy, zero_add] at this
    rw [bf_one]; exact this
  rw [h1, h2, add_zero]

lemma orthS_map {D : L576} (hO : ∀ d ∈ D, ∀ x, d ⬝ᵥ ι x = 0) (L : L24) : OrthS D (L.map ι) := by
  intro d hd z hz
  obtain ⟨x, -, rfl⟩ := hz
  exact hO d hd x

lemma nondeg_bot576 : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (⊥ : L576) :=
  fun x hx _ => (Submodule.mem_bot _).1 hx

lemma nondeg_bot24 : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) (⊥ : L24) :=
  fun x hx _ => (Submodule.mem_bot _).1 hx

lemma nondeg_top24 : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) (⊤ : L24) := by
  have := nondeg_dec (.coord FULL) rfl
  rwa [IntMul.Kappa.R6.Cx.NetF2.dec, show FULL = 16777215 from rfl, coordSp_full] at this

lemma nondeg_top576 : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (⊤ : L576) := by
  intro y _ hy
  funext i
  have := hy (Pi.single i 1) Submodule.mem_top
  rw [bf_one, dotProduct_single, mul_one] at this
  exact this

lemma det_one_ne {n : ℕ} : (1 : Matrix (Fin n) (Fin n) (ZMod 2)).det ≠ 0 := by
  rw [det_one]; exact one_ne_zero

/-- **Lifting an increasing edge** along an isometry, beside an orthogonal nondegenerate `D`. -/
theorem up_lift (hι : IsoM ι) {D : L576} (hD : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) D)
    (hO : ∀ d ∈ D, ∀ x, d ⬝ᵥ ι x = 0) {U V : L24} (h : Up U V) :
    Up (D ⊔ U.map ι) (D ⊔ V.map ι) := by
  obtain ⟨hU, hV, hle, hw⟩ := h
  refine ⟨nondeg_sup hD (hι.nondeg hU) (orthS_map hO U), nondeg_sup hD (hι.nondeg hV) (orthS_map hO V),
    sup_le_sup_left (Submodule.map_mono hle) D, ?_⟩
  rcases hw with rfl | ⟨w, hwV, hww, hwo⟩
  · exact Or.inl rfl
  · refine Or.inr ⟨ι w, Submodule.mem_sup_right ⟨w, hwV, rfl⟩, by rw [hι, hww], ?_⟩
    refine orth_sup (fun d hd => hO d hd w) ?_
    intro z hz
    obtain ⟨x, hx, rfl⟩ := hz
    rw [hι]; exact hwo x hx

/-- Complements reverse increasing edges. -/
theorem up_compl {U V : L24} (h : Up U V) : Up (orth 1 V) (orth 1 U) := by
  obtain ⟨hU, hV, hle, hw⟩ := h
  refine ⟨nondeg_orth one_isSymm hV det_one_ne, nondeg_orth one_isSymm hU det_one_ne, ?_, ?_⟩
  · intro y hy
    rw [mem_orth_one] at hy ⊢
    exact fun x hx => hy x (hle hx)
  · rcases hw with rfl | ⟨w, hwV, hww, hwo⟩
    · exact Or.inl rfl
    · refine Or.inr ⟨w, mem_orth_one.2 fun x hx => hwo x hx, hww, ?_⟩
      intro z hz
      rw [dotProduct_comm]
      exact mem_orth_one.1 hz w hwV

/-! ## The two lifts -/

variable {t : V24}

lemma D0_nondeg (ht : t ⬝ᵥ t = 1) : NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (D0 t) :=
  nondeg_orth one_isSymm ((isoL ht).nondeg nondeg_top24) det_one_ne

lemma D0_orth (d : V576) (hd : d ∈ D0 t) (x : V24) : d ⬝ᵥ ιL t x = 0 := by
  rw [dotProduct_comm]
  exact mem_orth_one.1 hd _ ⟨x, Submodule.mem_top, rfl⟩

lemma finrank_compl {n : ℕ} {U : Submodule (ZMod 2) (Fin n → ZMod 2)}
    (hU : NondegOn (1 : Matrix (Fin n) (Fin n) (ZMod 2)) U) :
    finrank (ZMod 2) U + finrank (ZMod 2) (orth 1 U) = n := by
  have := Submodule.finrank_add_eq_of_isCompl (isCompl_orth one_isSymm hU)
  rwa [Module.finrank_fin_fun] at this

lemma finrank_D0 (ht : t ⬝ᵥ t = 1) : finrank (ZMod 2) (D0 t) = 552 := by
  have := finrank_compl ((isoL ht).nondeg nondeg_top24)
  rw [finrank_map_iso (isoL ht), finrank_top, Module.finrank_fin_fun] at this
  rw [D0]
  exact Nat.add_left_cancel (this.trans (rfl : (576 : ℕ) = 24 + 552))

lemma finrank_lift1 (ht : t ⬝ᵥ t = 1) (L : L24) : finrank (ZMod 2) (lift1 t L) = finrank (ZMod 2) L :=
  finrank_map_iso (isoR ht) L

lemma arith1 {a b : ℕ} (h : b + a = 24) : 552 + a + b = 576 := by omega

lemma arith2 {a b c d : ℕ} (h1 : a + c = 576) (h2 : b + d = 576) :
    Int.natAbs ((a : ℤ) - b) = Int.natAbs ((c : ℤ) - d) := by omega

lemma finrank_lift2 (ht : t ⬝ᵥ t = 1) {L : L24}
    (hL : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) L) :
    finrank (ZMod 2) (lift2 t L) + finrank (ZMod 2) L = 576 := by
  have hc := finrank_compl hL
  have hO := nondeg_orth one_isSymm hL det_one_ne
  rw [lift2, finrank_sup_orth ((nondegOn_one_iff _).1 ((isoL ht).nondeg hO))
    (orthS_map (fun d hd x => D0_orth d hd x) _), finrank_D0 ht, finrank_map_iso (isoL ht)]
  exact arith1 hc

theorem edge_lift1 (ht : t ⬝ᵥ t = 1) {V U : L24} (h : EdgeOK V U) : EdgeOK (lift1 t V) (lift1 t U) := by
  have key : ∀ {A B : L24}, Up A B → Up (lift1 t A) (lift1 t B) := fun hAB => by
    have := up_lift (isoR ht) nondeg_bot576
      (fun d hd _ => by rw [(Submodule.mem_bot _).1 hd, zero_dotProduct]) hAB
    simpa only [bot_sup_eq, lift1] using this
  rcases h with h | h
  · exact Or.inl (key h)
  · exact Or.inr (key h)

theorem edge_lift2 (ht : t ⬝ᵥ t = 1) {V U : L24} (h : EdgeOK V U) : EdgeOK (lift2 t V) (lift2 t U) := by
  have key : ∀ {A B : L24}, Up A B → Up (lift2 t B) (lift2 t A) := fun hAB =>
    up_lift (isoL ht) (D0_nondeg ht) (fun d hd x => D0_orth d hd x) (up_compl hAB)
  rcases h with h | h
  · exact Or.inr (key h)
  · exact Or.inl (key h)

/-- The residual width of an edge is the dimension difference. -/
theorem Fd_eq_natAbs {n : ℕ} {V U : Submodule (ZMod 2) (Fin n → ZMod 2)} (h : EdgeOK V U) :
    Fd V U = Int.natAbs ((finrank (ZMod 2) V : ℤ) - finrank (ZMod 2) U) := by
  rcases h with h | h
  · have := Fd_up h
    rw [← this]; rfl
  · have := Fd_down h
    rw [← neg_sub, Int.natAbs_neg, ← this]; rfl

lemma nondeg_of_edge_left {n : ℕ} {V U : Submodule (ZMod 2) (Fin n → ZMod 2)} (h : EdgeOK V U) :
    NondegOn (1 : Matrix (Fin n) (Fin n) (ZMod 2)) V := by
  rcases h with h | h
  · exact h.2.1
  · exact h.1

lemma nondeg_of_edge_right {n : ℕ} {V U : Submodule (ZMod 2) (Fin n → ZMod 2)} (h : EdgeOK V U) :
    NondegOn (1 : Matrix (Fin n) (Fin n) (ZMod 2)) U := by
  rcases h with h | h
  · exact h.1
  · exact h.2.1

theorem Fd_lift1 (ht : t ⬝ᵥ t = 1) {V U : L24} (h : EdgeOK V U) :
    Fd (lift1 t V) (lift1 t U) = Fd V U := by
  rw [Fd_eq_natAbs (edge_lift1 ht h), Fd_eq_natAbs h, finrank_lift1 ht, finrank_lift1 ht]

theorem Fd_lift2 (ht : t ⬝ᵥ t = 1) {V U : L24} (h : EdgeOK V U) :
    Fd (lift2 t V) (lift2 t U) = Fd V U := by
  rw [Fd_eq_natAbs (edge_lift2 ht h), Fd_eq_natAbs h]
  exact arith2 (finrank_lift2 ht (nondeg_of_edge_left h)) (finrank_lift2 ht (nondeg_of_edge_right h))

/-! ## Boundary edges -/

lemma line_nondegM {n : ℕ} {u : Fin n → ZMod 2} (hu : u ⬝ᵥ u = 1) :
    NondegOn (1 : Matrix (Fin n) (Fin n) (ZMod 2)) (lineM u) := by
  apply nondegOn_span_singleton; rw [bf_one, hu]; exact one_ne_zero

lemma finrank_lineM {n : ℕ} {u : Fin n → ZMod 2} (hu : u ⬝ᵥ u = 1) :
    finrank (ZMod 2) (lineM u) = 1 :=
  finrank_span_singleton (by rintro rfl; simp at hu)

lemma finrank_perpM {n : ℕ} {u : Fin n → ZMod 2} (hu : u ⬝ᵥ u = 1) :
    finrank (ZMod 2) (orth 1 (lineM u)) + 1 = n := by
  have := finrank_compl (line_nondegM hu)
  rw [finrank_lineM hu] at this; omega

lemma mem_D0_tens {x : V24} (hx : t ⬝ᵥ x = 0) (y : V24) : tens x y ∈ D0 t := by
  rw [D0, mem_orth_one]
  intro z hz
  obtain ⟨y', -, rfl⟩ := hz
  rw [ιL_apply, tens_dot, hx, zero_mul]

lemma ev_unit (p : Fin 24) : ev p ⬝ᵥ ev p = 1 := by rw [ev_ev, if_pos ⟨rfl, p.isLt⟩]

lemma dot_ev_fin (v : V24) (p : Fin 24) : v ⬝ᵥ ev p = v p := by
  rw [dot_ev, dif_pos p.isLt]

lemma evv_unit (p q : Fin 24) : evv p q ⬝ᵥ evv p q = 1 := by
  rw [evv, tens_dot, ev_unit, ev_unit, mul_one]

lemma evv_mem_D0 {p : Fin 24} (hp : t p = 0) (q : Fin 24) : evv p q ∈ D0 t :=
  mem_D0_tens (by rw [dot_ev_fin, hp]) _

lemma evv_orth_R {s : V24} {q : Fin 24} (hq : s q = 0) (p : Fin 24) (L : L24) :
    NetComplexP8.Orth (lift1 s L) (evv p q) := by
  intro z hz
  obtain ⟨x, -, rfl⟩ := hz
  rw [ιR_apply, evv, tens_dot, dot_ev_fin, dot_ev_fin, hq, mul_zero]

lemma lift1_nondeg {s : V24} (hs : s ⬝ᵥ s = 1) {L : L24}
    (hL : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) L) :
    NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (lift1 s L) := (isoR hs).nondeg hL

lemma lift2_nondeg (ht : t ⬝ᵥ t = 1) {L : L24}
    (hL : NondegOn (1 : Matrix (Fin 24) (Fin 24) (ZMod 2)) L) :
    NondegOn (1 : Matrix (Fin 576) (Fin 576) (ZMod 2)) (lift2 t L) :=
  nondeg_sup (D0_nondeg ht) ((isoL ht).nondeg (nondeg_orth one_isSymm hL det_one_ne))
    (orthS_map (fun d hd x => D0_orth d hd x) _)

/-- E1: a fresh stage-two scratch role `⊥ → D0 t` (width 552). -/
theorem up_E1 (ht : t ⬝ᵥ t = 1) {p : Fin 24} (hp : t p = 0) : Up ⊥ (D0 t) :=
  ⟨nondeg_bot576, D0_nondeg ht, bot_le, Or.inr ⟨evv p p, evv_mem_D0 hp p, evv_unit p p, orth_bot _⟩⟩

theorem Fd_E1 (ht : t ⬝ᵥ t = 1) {p : Fin 24} (hp : t p = 0) : Fd (D0 t) ⊥ = 552 := by
  have := Fd_up (up_E1 ht hp)
  rw [finrank_D0 ht, finrank_bot] at this; omega

/-- E2: the stage-one output `t^⊥ ⊗ s → D0 t` (width 529). -/
theorem up_E2 (ht : t ⬝ᵥ t = 1) {s : V24} (hs : s ⬝ᵥ s = 1) {p q : Fin 24} (hp : t p = 0)
    (hq : s q = 0) : Up (lift1 s (orth 1 (lineM t))) (D0 t) := by
  refine ⟨lift1_nondeg hs (nondeg_orth one_isSymm (line_nondegM ht) det_one_ne), D0_nondeg ht, ?_,
    Or.inr ⟨evv p q, evv_mem_D0 hp q, evv_unit p q, evv_orth_R hq p _⟩⟩
  intro z hz
  obtain ⟨x, hx, rfl⟩ := hz
  exact mem_D0_tens ((mem_orth_one.1 hx) t (Submodule.mem_span_singleton_self t)) s

theorem Fd_E2 (ht : t ⬝ᵥ t = 1) {s : V24} (hs : s ⬝ᵥ s = 1) {p q : Fin 24} (hp : t p = 0)
    (hq : s q = 0) : Fd (D0 t) (lift1 s (orth 1 (lineM t))) = 529 := by
  have := Fd_up (up_E2 ht hs hp hq)
  have h2 := finrank_perpM ht
  rw [finrank_D0 ht, finrank_lift1 hs] at this
  have key : ∀ (F a : ℕ), a + 1 = 24 → (F : ℤ) = 552 - a → F = 529 := by intros; omega
  exact key _ _ h2 this

lemma orth_orth_line {s : V24} (hs : s ⬝ᵥ s = 1) : orth 1 (orth 1 (lineM s)) = lineM s := by
  symm
  apply Submodule.eq_of_le_of_finrank_eq
  · intro x hx
    rw [mem_orth_one]
    intro z hz
    rw [dotProduct_comm]; exact mem_orth_one.1 hz x hx
  · have h1 := finrank_compl (line_nondegM hs)
    have h2 := finrank_compl (nondeg_orth one_isSymm (line_nondegM hs) det_one_ne)
    omega

/-- E3: the stage-one output `𝔽₂^24 ⊗ s → lift2 t (s^⊥)` (width 529). -/
theorem up_E3 (ht : t ⬝ᵥ t = 1) {s : V24} (hs : s ⬝ᵥ s = 1) {p q : Fin 24} (hp : t p = 0)
    (hq : s q = 0) : Up (lift1 s ⊤) (lift2 t (orth 1 (lineM s))) := by
  have hnd := nondeg_orth one_isSymm (line_nondegM hs) det_one_ne
  refine ⟨lift1_nondeg hs nondeg_top24, lift2_nondeg ht hnd, ?_,
    Or.inr ⟨evv p q, Submodule.mem_sup_left (evv_mem_D0 hp q), evv_unit p q, evv_orth_R hq p _⟩⟩
  intro z hz
  obtain ⟨x, -, rfl⟩ := hz
  rw [ιR_apply]
  have hsplit : tens x s = tens (x - (t ⬝ᵥ x) • t) s + ιL t ((t ⬝ᵥ x) • s) := by
    funext k; simp [tens]; ring
  rw [hsplit]
  refine Submodule.add_mem_sup (mem_D0_tens ?_ s) ⟨(t ⬝ᵥ x) • s, ?_, rfl⟩
  · rw [dotProduct_sub, dotProduct_smul, ht, smul_eq_mul, mul_one, sub_self]
  · rw [orth_orth_line hs]
    exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self s)

theorem Fd_E3 (ht : t ⬝ᵥ t = 1) {s : V24} (hs : s ⬝ᵥ s = 1) {p q : Fin 24} (hp : t p = 0)
    (hq : s q = 0) : Fd (lift2 t (orth 1 (lineM s))) (lift1 s ⊤) = 529 := by
  have := Fd_up (up_E3 ht hs hp hq)
  have h1 := finrank_lift2 ht (nondeg_orth one_isSymm (line_nondegM hs) det_one_ne)
  have h2 := finrank_perpM hs
  rw [finrank_lift1 hs, finrank_top, Module.finrank_fin_fun] at this
  have key : ∀ (F a b : ℕ), a + b = 576 → b + 1 = 24 → (F : ℤ) = a - 24 → F = 529 := by
    intros; omega
  exact key _ _ _ h1 h2 this

/-- E4: the stage-one scratch output `𝔽₂^24 ⊗ s → ⊤` (width 552). -/
theorem up_E4 {s : V24} (hs : s ⬝ᵥ s = 1) {q : Fin 24} (hq : s q = 0) : Up (lift1 s ⊤) ⊤ :=
  ⟨lift1_nondeg hs nondeg_top24, nondeg_top576, le_top,
    Or.inr ⟨evv q q, Submodule.mem_top, evv_unit q q, evv_orth_R hq q _⟩⟩

theorem Fd_E4 {s : V24} (hs : s ⬝ᵥ s = 1) {q : Fin 24} (hq : s q = 0) : Fd ⊤ (lift1 s ⊤) = 552 := by
  have := Fd_up (up_E4 hs hq)
  rw [finrank_lift1 hs, finrank_top, finrank_top, Module.finrank_fin_fun, Module.finrank_fin_fun] at this
  omega

/-- E5: the correction move `⊤ → ⟨u⟩^⊥` (width 1). -/
theorem up_E5 {u : V576} (hu : u ⬝ᵥ u = 1) : Up (orth 1 (lineM u)) ⊤ :=
  ⟨nondeg_orth one_isSymm (line_nondegM hu) det_one_ne, nondeg_top576, le_top,
    Or.inr ⟨u, Submodule.mem_top, hu, fun z hz => by
      rw [dotProduct_comm]; exact mem_orth_one.1 hz u (Submodule.mem_span_singleton_self u)⟩⟩

/-- **Endpoint identity**: `lift2 t ⟨s⟩ = ⟨t ⊗ s⟩^⊥`. -/
theorem lift2_line (ht : t ⬝ᵥ t = 1) {s : V24} (hs : s ⬝ᵥ s = 1) :
    lift2 t (lineM s) = orth 1 (lineM (tens t s)) := by
  apply Submodule.eq_of_le_of_finrank_eq
  · refine sup_le ?_ ?_
    · intro z hz
      rw [mem_orth_one]
      intro x hx
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hx
      rw [smul_dotProduct, show tens t s = ιL t s from rfl, dotProduct_comm, D0_orth z hz s, smul_zero]
    · intro z hz
      obtain ⟨y, hy, rfl⟩ := hz
      rw [mem_orth_one]
      intro x hx
      obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hx
      rw [smul_dotProduct, ιL_apply, tens_dot, ht, one_mul,
        mem_orth_one.1 hy s (Submodule.mem_span_singleton_self s), smul_zero]
  · have h1 := finrank_lift2 ht (line_nondegM hs)
    have h2 := finrank_perpM (show tens t s ⬝ᵥ tens t s = 1 by rw [tens_dot, ht, hs, mul_one])
    rw [finrank_lineM hs] at h1
    have key : ∀ (a b : ℕ), a + 1 = 576 → b + 1 = 576 → a = b := by intros; omega
    exact key _ _ h1 h2

theorem lift2_bot (ht : t ⬝ᵥ t = 1) : lift2 t ⊥ = ⊤ := by
  apply Submodule.eq_top_of_finrank_eq
  have := finrank_lift2 ht nondeg_bot24
  rw [finrank_bot] at this
  rw [Module.finrank_fin_fun]
  exact this

end IntMul.Kappa.R6.Cx.NetT

end

section
-- Source module: Solutions.R6CxNetFrame
/-!
# Local frames of the two stage invocations

Stage one, invocation `b`: code `c` means `lift1 t_b (dec c)`. Stage two, invocation `a`: code `c`
means `lift2 t_a (dec c)`, except the boundary codes `ext k` of the incoming wires:
`ext 0` (fresh scratch) `= ⊥`, `ext 1` on `x_b` `= lift1 t_b (perp t_a)` (stage-one `y` output),
`ext 2` on `y_S` `= lift1 t_S ⊤` (stage-one `x` output).

`frame1` / `frame2`: the `NetLoc.Frame` hypotheses (move soundness via `edgeB_sound`, the lifts and
the boundary edges E1–E3); `width1` / `width2`: `WidthOK`.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetFr

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec

/-! ## Triple vectors -/

variable {d : Dat}

lemma tb_unit (h : TriOK d) {S : ℕ} (hS : S < NV) : tb d S ⬝ᵥ tb d S = 1 := by
  rw [tb, bitv_dot_self, h.pc S hS]; rfl

lemma tb_zero (h : TriOK d) {S : ℕ} (hS : S < NV) : ∃ p : Fin 24, tb d S p = 0 := by
  by_contra hc
  push Not at hc
  have hall : ∀ i : Fin 24, (d.tv S).testBit i = true := by
    intro i
    have := hc i
    rw [tb, bitv_apply] at this
    by_contra hb
    rw [if_neg hb] at this
    exact this rfl
  have := h.pc S hS
  rw [cntK, Finset.sum_congr rfl (fun i _ => if_pos (hall i))] at this
  simp at this

lemma dec_TOPC : NetF2.dec (Code.ofNat TOPC) = ⊤ := by
  rw [show Code.ofNat TOPC = .coord 16777215 from rfl]; exact coordSp_full

lemma dec_zero : NetF2.dec (Code.ofNat 0) = ⊥ := by
  rw [show Code.ofNat 0 = .coord 0 from rfl]
  show coordSp 0 = ⊥
  rw [coordSp]
  rw [Submodule.span_eq_bot]
  intro x hx
  simp [gC] at hx

lemma dec_perpC (tv : ℕ) : NetF2.dec (Code.ofNat (perpC tv)) = perpSp tv := by
  rw [show Code.ofNat (perpC tv) = .perp tv by
    simp only [Code.ofNat, perpC]
    have h1 : (2 + 4 * tv) % 4 = 2 := by omega
    have h2 : (2 + 4 * tv) / 4 = tv := by omega
    rw [h1, h2]; rfl]
  rfl

lemma lift2_top (t : V24) : lift2 t ⊤ = D0 t := by
  rw [lift2]
  have : orth 1 (⊤ : L24) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_bot]
    funext i
    have := (mem_orth_one.1 hx) (Pi.single i 1) Submodule.mem_top
    rw [dotProduct_comm, dotProduct_single, mul_one] at this
    exact this
  rw [this, Submodule.map_bot, sup_bot_eq]

/-! ## Stage one -/

lemma dist_eq (a b : ℕ) : NetSpec.dist a b = Int.natAbs ((a : ℤ) - b) := by unfold NetSpec.dist; omega

theorem frame1 (h : TriOK d) {b : ℕ} (hb : b < NV) {R : Type} [DecidableEq R] {ι : ℕ → R}
    (hinj : ∀ w < NL, ∀ w' < NL, ι w = ι w' → w = w') :
    Frame NL ι (labV1 d b) (fun _ c => labV1 d b c) mvOK1 where
  cap := by norm_num [NL, NetBT.CAP]
  inj := hinj
  labV_eq := fun _ _ _ => rfl
  sound := fun w o V _ _ hm => edge_lift1 (tb_unit h hb) (edgeB_sound hm)

theorem width1 (h : TriOK d) {b : ℕ} (hb : b < NV) :
    WidthOK NL (labV1 d b) (fun _ c => labV1 d b c) mvOK1 wd1 := by
  intro w o V _ _ hm
  have hE := edgeB_sound hm
  show Fd (labV1 d b V) (labV1 d b o) = _
  rw [labV1, labV1, Fd_lift1 (tb_unit h hb) hE, Fd_eq_natAbs hE,
    finrank_dec _ (okC_of_edgeB_left hm), finrank_dec _ (okC_of_edgeB_right hm), wd1, dist_eq]

/-! ## Stage two -/

lemma extOK_cases {w k V : ℕ} (h : extOK d w k V = true) :
    (k = 0 ∧ V = TOPC) ∨ (k = 1 ∧ w < NV ∧ V = TOPC) ∨
      (k = 2 ∧ NV ≤ w ∧ w < 2 * NV ∧ V = perpC (d.tv (w - NV))) := by
  unfold extOK at h
  by_cases h0 : k = 0
  · subst h0; simp at h; exact Or.inl ⟨rfl, h⟩
  · by_cases h1 : k = 1
    · subst h1; simp at h; exact Or.inr (Or.inl ⟨rfl, h⟩)
    · by_cases h2 : k = 2
      · subst h2; simp at h; exact Or.inr (Or.inr ⟨rfl, h.1.1, h.1.2, h.2⟩)
      · simp [h0, h1, h2] at h

/-- The data facts on the boundary moves (all indices in range). -/
lemma perp_eq (t : ℕ) : perpSp t = orth 1 (lineM (bitv t)) := rfl

theorem frame2 (h : TriOK d) {a : ℕ} (ha : a < NV) {R : Type} [DecidableEq R] {ι : ℕ → R}
    (hinj : ∀ w < NL, ∀ w' < NL, ι w = ι w' → w = w') :
    Frame NL ι (labV2 d a) (lab2 d a) (mvOK2 d) where
  cap := by norm_num [NL, NetBT.CAP]
  inj := hinj
  labV_eq := fun w c hc => by rw [lab2, if_neg hc]
  sound := by
    intro w o V hw hV hm
    unfold mvOK2 at hm
    by_cases ho : o % 4 = 3
    · rw [show Nat.beq (o % 4) 3 = true by rw [ho]; rfl, cond_true] at hm
      rw [lab2, if_pos ho]
      obtain ⟨p, hp⟩ := tb_zero h ha
      rcases extOK_cases hm with ⟨hk, hVe⟩ | ⟨hk, hwv, hVe⟩ | ⟨hk, hw1, hw2, hVe⟩ <;> rw [hVe]
      · rw [extLab, if_pos hk, labV2, dec_TOPC, lift2_top]
        exact Or.inl (NetT.up_E1 (tb_unit h ha) hp)
      · rw [extLab, if_neg (by omega), if_pos hk]
        rw [labV2]
        rw [dec_TOPC]
        rw [lift2_top]
        rw [dec_perpC]
        rw [perp_eq]
        obtain ⟨q, hq⟩ := tb_zero h hwv
        exact Or.inl (NetT.up_E2 (tb_unit h ha) (tb_unit h hwv) hp hq)
      · rw [extLab, if_neg (by omega), if_neg (by omega), labV2, dec_TOPC, dec_perpC, perp_eq]
        have hS : w - NV < NV := by omega
        obtain ⟨q, hq⟩ := tb_zero h hS
        exact Or.inl (NetT.up_E3 (tb_unit h ha) (tb_unit h hS) hp hq)
    · have hb : Nat.beq (o % 4) 3 = false := by
        cases hh : Nat.beq (o % 4) 3
        · rfl
        · exact absurd (Nat.eq_of_beq_eq_true hh) ho
      rw [hb, cond_false] at hm
      rw [lab2, if_neg ho]
      exact edge_lift2 (tb_unit h ha) (edgeB_sound hm)

theorem width2 (h : TriOK d) {a : ℕ} (ha : a < NV) :
    WidthOK NL (labV2 d a) (lab2 d a) (mvOK2 d) wd2 := by
  intro w o V hw hV hm
  unfold mvOK2 at hm
  by_cases ho : o % 4 = 3
  · rw [show Nat.beq (o % 4) 3 = true by rw [ho]; rfl, cond_true] at hm
    rw [lab2, if_pos ho, wd2, show Nat.beq (o % 4) 3 = true by rw [ho]; rfl, cond_true]
    obtain ⟨p, hp⟩ := tb_zero h ha
    rcases extOK_cases hm with ⟨hk, hVe⟩ | ⟨hk, hwv, hVe⟩ | ⟨hk, hw1, hw2, hVe⟩ <;> rw [hVe]
    · rw [extLab, if_pos hk, labV2, dec_TOPC, lift2_top, hk]
      exact NetT.Fd_E1 (tb_unit h ha) hp
    · rw [extLab, if_neg (by omega), if_pos hk, labV2, dec_TOPC, lift2_top, dec_perpC, perp_eq, hk]
      obtain ⟨q, hq⟩ := tb_zero h hwv
      exact NetT.Fd_E2 (tb_unit h ha) (tb_unit h hwv) hp hq
    · rw [extLab, if_neg (by omega), if_neg (by omega), labV2, dec_TOPC, dec_perpC, perp_eq, hk]
      have hS : w - NV < NV := by omega
      obtain ⟨q, hq⟩ := tb_zero h hS
      exact NetT.Fd_E3 (tb_unit h ha) (tb_unit h hS) hp hq
  · have hb : Nat.beq (o % 4) 3 = false := by
      cases hh : Nat.beq (o % 4) 3
      · rfl
      · exact absurd (Nat.eq_of_beq_eq_true hh) ho
    rw [hb, cond_false] at hm
    have hE := edgeB_sound hm
    rw [lab2, if_neg ho, labV2, labV2, Fd_lift2 (tb_unit h ha) hE, Fd_eq_natAbs hE,
      finrank_dec _ (okC_of_edgeB_left hm), finrank_dec _ (okC_of_edgeB_right hm), wd2, hb, cond_false,
      dist_eq]

end IntMul.Kappa.R6.Cx.NetFr

end

section
-- Source module: Solutions.R6CxNetRoles
/-!
# Global roles of the complex network and the invocation maps

Data roles (`W = 2N + 2vR`): `X(a,b)`, `Y(a,b)` (`a, b < v`), `A1(b,q)`, `A2(a,q)` (`q < R`).
Temporaries (`T = 48v + N`): `M1(b,j)`, `M2(a,j)` (`j < 24`), `τ(a,b)`.

`ι1 b` maps the local wires of stage-one invocation `b` (`x_t ↦ X(t,b)`, `y_S ↦ Y(S,b)`,
`a_q ↦ A1(b,q)`, `m_j ↦ M1(b,j)`), `ι2 a` those of stage-two invocation `a`
(`x_b ↦ Y(a,b)`, `y_S ↦ X(a,S)`, `a_q ↦ A2(a,q)`, `m_j ↦ M2(a,j)`). `g0`: the initial labels.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetFr

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec

lemma rW_ne_rT {n n' : ℕ} : rW n ≠ rT n' := by simp [rW, rT]

/-! ## Role indices -/

lemma rc_inj {r r' : Rl} (h : rc r = rc r') : r = r' := by
  rcases r with ⟨n, hn⟩ | ⟨n, hn⟩ <;> rcases r' with ⟨n', hn'⟩ | ⟨n', hn'⟩ <;> simp only [rc, Wn, Tn] at h hn hn'
  · exact congrArg _ (Fin.ext h)
  · omega
  · omega
  · exact congrArg _ (Fin.ext (Nat.add_left_cancel h))

lemma rc_rT {n : ℕ} (h : n < Tn) : rc (rT n) = Wn + n := by simp [rc, rT, Nat.mod_eq_of_lt h]

lemma rc_ι1 {b w : ℕ} (hb : b < NV) (hw : w < NL) : rc (ι1 b w) = f1 b w := by
  unfold ι1 f1
  simp only [NL, NV, NR] at hb hw
  split_ifs with h1 h2 h3
  · exact rc_rW (by simp only [xI, Wn, NV] at *; nlinarith)
  · have hk : w - NV < NV := by simp only [NV] at *; omega
    exact rc_rW (by simp only [yI, Wn, NN, NV] at *; nlinarith)
  · have hk : w - 2 * NV < NR := by simp only [NV, NR] at *; omega
    exact rc_rW (by simp only [a1I, Wn, NN, NV, NR] at *; nlinarith)
  · exact rc_rT (by simp only [m1I, Tn, NV, NR] at *; omega)

lemma rc_ι2 {a w : ℕ} (ha : a < NV) (hw : w < NL) : rc (ι2 a w) = f2 a w := by
  unfold ι2 f2
  simp only [NL, NV, NR] at ha hw
  split_ifs with h1 h2 h3
  · exact rc_rW (by simp only [yI, Wn, NN, NV] at *; nlinarith)
  · have hk : w - NV < NV := by simp only [NV] at *; omega
    exact rc_rW (by simp only [xI, Wn, NV] at *; nlinarith)
  · have hk : w - 2 * NV < NR := by simp only [NV, NR] at *; omega
    exact rc_rW (by simp only [a2I, Wn, NN, NV, NR] at *; nlinarith)
  · exact rc_rT (by simp only [m2I, Tn, NV, NR] at *; omega)

lemma f1_cases {b w : ℕ} (hb : b < NV) (hw : w < NL) :
    (w < NV ∧ f1 b w = w * NV + b) ∨ (NV ≤ w ∧ w < 2 * NV ∧ f1 b w = NN + (w - NV) * NV + b ∧ w - NV < NV) ∨
    (2 * NV ≤ w ∧ w < 2 * NV + NR ∧ f1 b w = 2 * NN + b * NR + (w - 2 * NV) ∧ w - 2 * NV < NR) ∨
    (2 * NV + NR ≤ w ∧ f1 b w = Wn + (24 * b + (w - (2 * NV + NR))) ∧ w - (2 * NV + NR) < 24) := by
  have e : f1 b w = if w < NV then _ else if w < 2 * NV then _ else if w < 2 * NV + NR then _ else _ := rfl
  rw [e]
  simp only [xI, yI, a1I, m1I]
  simp only [NL] at hw
  by_cases h1 : w < NV
  · left; rw [if_pos h1]; exact ⟨h1, rfl⟩
  · by_cases h2 : w < 2 * NV
    · right; left; rw [if_neg h1, if_pos h2]; refine ⟨by omega, h2, rfl, by omega⟩
    · by_cases h3 : w < 2 * NV + NR
      · right; right; left; rw [if_neg h1, if_neg h2, if_pos h3]
        refine ⟨by omega, h3, rfl, by omega⟩
      · right; right; right; rw [if_neg h1, if_neg h2, if_neg h3]
        refine ⟨by omega, rfl, by simp only [NR, NV] at *; omega⟩

lemma f2_cases {a w : ℕ} (ha : a < NV) (hw : w < NL) :
    (w < NV ∧ f2 a w = NN + a * NV + w) ∨ (NV ≤ w ∧ w < 2 * NV ∧ f2 a w = a * NV + (w - NV) ∧ w - NV < NV) ∨
    (2 * NV ≤ w ∧ w < 2 * NV + NR ∧ f2 a w = 2 * NN + NV * NR + a * NR + (w - 2 * NV) ∧ w - 2 * NV < NR) ∨
    (2 * NV + NR ≤ w ∧ f2 a w = Wn + (24 * NV + 24 * a + (w - (2 * NV + NR))) ∧ w - (2 * NV + NR) < 24) := by
  have e : f2 a w = if w < NV then _ else if w < 2 * NV then _ else if w < 2 * NV + NR then _ else _ := rfl
  rw [e]
  simp only [yI, xI, a2I, m2I]
  simp only [NL] at hw
  by_cases h1 : w < NV
  · left; rw [if_pos h1]; exact ⟨h1, rfl⟩
  · by_cases h2 : w < 2 * NV
    · right; left; rw [if_neg h1, if_pos h2]; refine ⟨by omega, h2, rfl, by omega⟩
    · by_cases h3 : w < 2 * NV + NR
      · right; right; left; rw [if_neg h1, if_neg h2, if_pos h3]
        refine ⟨by omega, h3, rfl, by omega⟩
      · right; right; right; rw [if_neg h1, if_neg h2, if_neg h3]
        refine ⟨by omega, rfl, by simp only [NR, NV] at *; omega⟩

lemma dmU {n B q r : ℕ} (hB : 0 < B) (h : n = r + B * q) (hr : r < B) : n / B = q ∧ n % B = r :=
  (Nat.div_mod_unique hB).2 ⟨h.symm, hr⟩

section
set_option maxRecDepth 10000

lemma d1_f1 {b w : ℕ} (hb : b < NV) (hw : w < NL) : d1 (f1 b w) = (b, w) := by
  have hB : (0 : ℕ) < NV := by norm_num [NV]
  rcases f1_cases hb hw with ⟨h1, e⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, e, hk⟩ <;> rw [e, d1]
  · rw [if_pos (by simp only [NN, NV] at *; nlinarith)]
    obtain ⟨q1, q2⟩ := dmU (n := w * NV + b) (q := w) (r := b) hB (by ring) hb
    rw [q1, q2]
  · rw [if_neg (by simp only [NN, NV] at *; omega), if_pos (by simp only [NN, NV] at *; omega)]
    obtain ⟨q1, q2⟩ := dmU (n := NN + (w - NV) * NV + b - NN) (q := w - NV) (r := b) hB
      (by simp only [NN, NV] at *; omega) hb
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)
  · rw [if_neg (by simp only [NN, NV, NR] at *; omega), if_neg (by simp only [NN, NV, NR] at *; omega),
      if_pos (by simp only [NN, NV, NR, Wn] at *; omega)]
    obtain ⟨q1, q2⟩ := dmU (n := 2 * NN + b * NR + (w - 2 * NV) - 2 * NN) (q := b) (r := w - 2 * NV)
      (by norm_num [NR]) (by simp only [NN, NV, NR] at *; omega) hk
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)
  · rw [if_neg (by simp only [NN, NV, NR, Wn] at *; omega), if_neg (by simp only [NN, NV, NR, Wn] at *; omega),
      if_neg (by simp only [NN, NV, NR, Wn] at *; omega)]
    obtain ⟨q1, q2⟩ := dmU (n := Wn + (24 * b + (w - (2 * NV + NR))) - Wn) (q := b)
      (r := w - (2 * NV + NR)) (by norm_num) (by omega) hk
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)

lemma d2_f2 {a w : ℕ} (ha : a < NV) (hw : w < NL) : d2 (f2 a w) = (a, w) := by
  have hB : (0 : ℕ) < NV := by norm_num [NV]
  rcases f2_cases ha hw with ⟨h1, e⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, h2, e, hk⟩ | ⟨h1, e, hk⟩ <;> rw [e, d2]
  · rw [if_neg (by simp only [NN, NV] at *; omega), if_pos (by simp only [NN, NV] at *; nlinarith)]
    obtain ⟨q1, q2⟩ := dmU (n := NN + a * NV + w - NN) (q := a) (r := w) hB
      (by simp only [NN, NV] at *; omega) h1
    rw [q1, q2]
  · rw [if_pos (by simp only [NN, NV] at *; nlinarith)]
    obtain ⟨q1, q2⟩ := dmU (n := a * NV + (w - NV)) (q := a) (r := w - NV) hB (by ring) hk
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)
  · rw [if_neg (by simp only [NN, NV, NR] at *; omega), if_neg (by simp only [NN, NV, NR] at *; omega),
      if_pos (by simp only [NN, NV, NR, Wn] at *; nlinarith)]
    obtain ⟨q1, q2⟩ := dmU (n := 2 * NN + NV * NR + a * NR + (w - 2 * NV) - (2 * NN + NV * NR)) (q := a)
      (r := w - 2 * NV) (by norm_num [NR]) (by simp only [NN, NV, NR] at *; omega) hk
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)
  · rw [if_neg (by simp only [NN, NV, NR, Wn] at *; omega), if_neg (by simp only [NN, NV, NR, Wn] at *; omega),
      if_neg (by simp only [NN, NV, NR, Wn] at *; omega)]
    obtain ⟨q1, q2⟩ := dmU (n := Wn + (24 * NV + 24 * a + (w - (2 * NV + NR))) - (Wn + 24 * NV)) (q := a)
      (r := w - (2 * NV + NR)) (by norm_num) (by omega) hk
    rw [q1, q2]; exact Prod.ext rfl (by simp only [NV, NR] at *; omega)

end

theorem ι1_eq {b b' w w' : ℕ} (hb : b < NV) (hb' : b' < NV) (hw : w < NL) (hw' : w' < NL)
    (e : ι1 b w = ι1 b' w') : b = b' ∧ w = w' := by
  have := congrArg (fun r => d1 (rc r)) e
  simp only [rc_ι1 hb hw, rc_ι1 hb' hw', d1_f1 hb hw, d1_f1 hb' hw', Prod.mk.injEq] at this
  exact this

theorem ι2_eq {a a' w w' : ℕ} (ha : a < NV) (ha' : a' < NV) (hw : w < NL) (hw' : w' < NL)
    (e : ι2 a w = ι2 a' w') : a = a' ∧ w = w' := by
  have := congrArg (fun r => d2 (rc r)) e
  simp only [rc_ι2 ha hw, rc_ι2 ha' hw', d2_f2 ha hw, d2_f2 ha' hw', Prod.mk.injEq] at this
  exact this

theorem ι1_inj {b : ℕ} (hb : b < NV) : ∀ w < NL, ∀ w' < NL, ι1 b w = ι1 b w' → w = w' :=
  fun _ hw _ hw' e => (ι1_eq hb hb hw hw' e).2

theorem ι2_inj {a : ℕ} (ha : a < NV) : ∀ w < NL, ∀ w' < NL, ι2 a w = ι2 a w' → w = w' :=
  fun _ hw _ hw' e => (ι2_eq ha ha hw hw' e).2

end IntMul.Kappa.R6.Cx.NetFr

