  unfold J6A.DP.rdN
  have r1 := Rn.rdK (W := W) (X := X) (dst := 1) (v := fun _ => 0) (c := c) hXr hX5 hXT hXC
    (by decide) (by decide) hc (j := 1) (by simp [J6A.PA.dL]) hv0 hL (by omega) (by simp)
  apply Rn.seq r1; intro v1 h1; subst h1
  have b1 : BV W (Function.update (Function.update (fun _ => (0 : ℤ)) rIx ((1 : ℕ) : ℤ)) 1
      ((J6A.PA.dL k pre post s t p α d)[1]'(by simp [J6A.PA.dL]))) :=
