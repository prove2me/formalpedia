namespace Native
open ExactQuantumFactoring.BitStackProgram Procedure

/-- Sum of the paper's certified per-child scores across every possible call at a node. -/
def scoreBudget (N : ℕ) : ℕ := 2*Moment.probes*(2*N)^274

/-- This polynomial can be generated by ten successive squarings on the data. -/
def machineBudget (N : ℕ) : ℕ := (2*N)^1024

private theorem double_pow_succ_le (k : ℕ) : 2*((2:ℕ)^k+1) ≤ 2^(k+2) := by
  have h := Nat.two_pow_pos k
  rw [pow_add]
  change 2*(2^k+1) ≤ 2^k*4
  omega

theorem scoreBudget_le_machineBudget (N : ℕ) : scoreBudget N ≤ machineBudget N := by
  cases N with
  | zero => simp [scoreBudget, machineBudget]
  | succ n =>
    let v := 2*(n+1)
    have hv : 2 ≤ v := by dsimp [v]; omega
    have hcoef : 2*Moment.probes ≤ (2:ℕ)^602 := by
      simpa only [Moment.probes] using double_pow_succ_le 600
    calc
      scoreBudget (n+1) = (2*Moment.probes)*v^274 := rfl
      _ ≤ v^602*v^274 := Nat.mul_le_mul_right _ (hcoef.trans (Nat.pow_le_pow_left hv 602))
      _ = v^(602+274) := (pow_add v 602 274).symm
      _ ≤ v^1024 := Nat.pow_le_pow_right (by omega : 0 < v) (by decide)
      _ = machineBudget (n+1) := rfl

private noncomputable def unarySquarePower (k : ℕ) :
    Procedure unaryCode unaryCode (fun n => n ^ (2 ^ k)) := by
  induction k with
  | zero => exact (identity unaryCode).congrFun (by simp)
  | succ k ih =>
    let square := unaryMul.comp ((identity unaryCode).pair (identity unaryCode))
    exact (square.comp ih).congrFun (by
      intro n
      change n^(2^k)*n^(2^k) = n^(2^(k+1))
      rw [pow_succ, Nat.mul_two, pow_add])

noncomputable def machineBudgetP : Procedure unaryCode unaryCode machineBudget := by
  let double := unaryAdd.comp ((identity unaryCode).pair (identity unaryCode))
  exact ((unarySquarePower 10).comp double).congrFun (by
    intro n
    change (n+n)^(2^10) = (2*n)^1024
    simpa only [Nat.two_mul n] using
      (congrArg (fun k : ℕ => (n+n)^k) (by decide : (2:ℕ)^10 = 1024)))

