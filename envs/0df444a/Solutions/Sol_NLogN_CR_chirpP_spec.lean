    (fun i hi _ => uW_ge q i (by simpa using hi))
  set z := (axIt (2 ^ q.e) 1 (2 * q.r))^[q.K - q.dh] (0, x)
  have hx2 : z.2 < (([] : List ℕ) ++ List.replicate q.dh (2 ^ (q.e - 1))).prod := by
    rw [a1, List.nil_append]
    rw [List.prod_append, List.prod_replicate, List.prod_replicate] at hx
    rw [List.prod_replicate]
    exact Nat.div_lt_of_lt_mul (by rw [mul_comm]; exact hx)
  obtain ⟨_, c2⟩ := axIt_iter (2 ^ (q.e - 1)) 2 (2 * q.r) (uW q) q.dh [] z.1 z.2 hx2
    (fun i _ hi => uW_lt q he i (by simpa using hi))
  have hlt := axIt_lt (2 ^ (q.e - 1)) 2 (2 * q.r) hM q.dh z
    (axIt_lt _ _ _ hM _ (0, x) hM)
  rw [wsum_nil, add_zero, List.nil_append, Nat.mod_eq_of_lt hlt] at c2
  rw [← a1, Nat.zero_add] at b1
  rw [c2, b1, chirpKey, NLogN.CR.tdims_eq q hdh.le]

theorem scanF_append (cur : ℤ × ℤ) : ∀ Z1 Z2 : List (List ℤ),
    scanF cur (Z1 ++ Z2) = scanF cur Z1 ++ scanF (curF cur Z1) Z2
  | [], Z2 => rfl
  | r :: Z1, Z2 => by
    simp only [List.cons_append, scanF, curF]
    split_ifs
    · rw [scanF_append cur Z1 Z2, List.cons_append]
    · exact scanF_append _ Z1 Z2

theorem scanF_single (cur : ℤ × ℤ) (r : List ℤ) :
    scanF cur [r] = if r.headD 0 % 2 = 1 then [(r.getD 1 0, cur)] else [] := by
  simp only [scanF]

theorem curF_append (cur : ℤ × ℤ) : ∀ Z1 Z2 : List (List ℤ),
    curF cur (Z1 ++ Z2) = curF (curF cur Z1) Z2
  | [], Z2 => rfl
  | r :: Z1, Z2 => by
    simp only [List.cons_append, curF]
    split_ifs
    · exact curF_append cur Z1 Z2
    · exact curF_append _ Z1 Z2

theorem tab_key (v : ℕ → ℤ × ℤ) (c : ℕ) : key (tabRec v c) = 2 * c := rfl
theorem req_key (κ : ℕ → ℕ) (x : ℕ) : key (reqRec κ x) = 2 * κ x + 1 := rfl

theorem tab_inj {v : ℕ → ℤ × ℤ} {c c' : ℕ} (h : tabRec v c = tabRec v c') : c = c' := by
  have := congrArg key h; rw [tab_key, tab_key] at this; omega

theorem tab_ne_req (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (c x : ℕ) : tabRec v c ≠ reqRec κ x := by
  intro h; have := congrArg key h; rw [tab_key, req_key] at this; omega

theorem scan_good (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) : ∀ (Z : List (List ℤ)) (cur : ℤ × ℤ),
    Z.Pairwise (fun a b => key a ≤ key b) → Z.Nodup → (∀ r ∈ Z, IsRec v κ r) →
    NLogN.CR.Good v κ cur Z → scanF cur Z = (reqXs Z).map fun (x : ℕ) => ((x : ℤ), v (κ x))
  | [], _, _, _, _, _ => rfl
  | r :: Z, cur, hs, hnd, hrec, hg => by
    rw [List.pairwise_cons] at hs
    rw [List.nodup_cons] at hnd
    rcases hrec r List.mem_cons_self with ⟨c, rfl⟩ | ⟨x0, rfl⟩
    · -- a table record
      have h2 : (tabRec v c).headD 0 % 2 = 0 := by simp [tabRec]
      simp only [scanF, h2, reqXs, List.filter_cons]
      simp only [show ¬ ((0 : ℤ) = 1) by decide, if_false, decide_false]
      refine scan_good v κ Z _ hs.2 hnd.2 (fun r hr => hrec r (List.mem_cons_of_mem _ hr)) ?_
      intro x hx
      rcases hg x (List.mem_cons_of_mem _ hx) with h | ⟨hc, hall⟩
      · rcases List.mem_cons.1 h with h | h
        · have := tab_inj h
          right
          refine ⟨by rw [this]; rfl, fun c' hc' => ?_⟩
          have hk := hs.1 _ hc'
          rw [tab_key, tab_key] at hk
          have hne : c' ≠ c := fun e => hnd.1 (e ▸ hc')
          omega
        · exact Or.inl h
      · have h1 := hall c List.mem_cons_self
        have hk := hs.1 _ hx
        rw [tab_key, req_key] at hk
        omega
    · -- a request
      have h2 : (reqRec κ x0).headD 0 % 2 = 1 := by
        simp only [reqRec, List.headD_cons]; omega
      simp only [scanF, h2, if_true, reqXs, List.filter_cons, decide_true, List.map_cons]
      have hcur : cur = v (κ x0) := by
        rcases hg x0 List.mem_cons_self with h | ⟨hc, _⟩
        · rcases List.mem_cons.1 h with h | h
          · exact absurd h (tab_ne_req v κ _ _)
          · have hk := hs.1 _ h
            rw [req_key, tab_key] at hk; omega
        · exact hc
      refine List.cons_eq_cons.2 ⟨?_, ?_⟩
      · simp [reqRec, hcur]
      · refine scan_good v κ Z cur hs.2 hnd.2 (fun r hr => hrec r (List.mem_cons_of_mem _ hr)) ?_
        intro x hx
        rcases hg x (List.mem_cons_of_mem _ hx) with h | ⟨hc, hall⟩
        · rcases List.mem_cons.1 h with h | h
          · exact absurd h (tab_ne_req v κ _ _)
          · exact Or.inl h
        · exact Or.inr ⟨hc, fun c hc' => hall c (List.mem_cons_of_mem _ hc')⟩

theorem req_inj {κ : ℕ → ℕ} {x x' : ℕ} (h : reqRec κ x = reqRec κ x') : x = x' := by
  simp only [reqRec, List.cons.injEq] at h; exact_mod_cast h.2.1

theorem mergeL_nodup (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) : (mergeL v κ R T).Nodup := by
  unfold mergeL
  rw [List.nodup_append]
  refine ⟨List.Nodup.map (fun a b h => tab_inj h) List.nodup_range,
    List.Nodup.map (fun a b h => req_inj h) List.nodup_range, ?_⟩
  intro a ha b hb hab
  simp only [List.mem_map] at ha hb
  obtain ⟨c, _, rfl⟩ := ha; obtain ⟨x, _, rfl⟩ := hb
  exact tab_ne_req v κ c x hab

theorem mergeL_mem (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) (r : List ℤ) (h : r ∈ mergeL v κ R T) :
    (∃ c < R, r = tabRec v c) ∨ (∃ x < T, r = reqRec κ x) := by
  simp only [mergeL, List.mem_append, List.mem_map, List.mem_range] at h
  rcases h with ⟨c, hc, rfl⟩ | ⟨x, hx, rfl⟩
  · exact Or.inl ⟨c, hc, rfl⟩
  · exact Or.inr ⟨x, hx, rfl⟩

theorem mergeL_length (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) :
    (mergeL v κ R T).length = R + T := by simp [mergeL]

theorem reqXs_perm (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T : ℕ) (Z : List (List ℤ))
    (hZ : Z.Perm (mergeL v κ R T)) : (reqXs Z).Perm (List.range T) := by
  have h1 := (hZ.filter (fun r => r.headD 0 % 2 = 1)).map (fun r => (r.getD 1 0).toNat)
  unfold reqXs
  refine h1.trans ?_
  have e1 : ((List.range R).map (tabRec v)).filter (fun r => r.headD 0 % 2 = 1) = [] := by
    rw [List.filter_eq_nil_iff]
    intro r hr
    simp only [List.mem_map] at hr
    obtain ⟨c, _, rfl⟩ := hr
    simp [tabRec]
  have e2 : ((List.range T).map (reqRec κ)).filter (fun r => r.headD 0 % 2 = 1) =
      (List.range T).map (reqRec κ) := by
    rw [List.filter_eq_self]
    intro r hr
    simp only [List.mem_map] at hr
    obtain ⟨x, _, rfl⟩ := hr
    simp [reqRec]
  rw [mergeL, List.filter_append, e1, e2, List.nil_append, List.map_map]
  have : ((fun r : List ℤ => (r.getD 1 0).toNat) ∘ reqRec κ) = id := by
    funext x; simp [reqRec]
  rw [this, List.map_id]

theorem key_nonneg_lt (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T kb : ℕ) (hκ : ∀ x < T, κ x < R)
    (hR : 2 * R ≤ 2 ^ kb) (r : List ℤ) (h : r ∈ mergeL v κ R T) :
    0 ≤ key r ∧ key r < 2 ^ kb := by
  rcases mergeL_mem v κ R T r h with ⟨c, hc, rfl⟩ | ⟨x, hx, rfl⟩
  · rw [tab_key]; constructor
    · positivity
    · have : 2 * c < 2 ^ kb := by omega
      exact_mod_cast this
  · rw [req_key]; constructor
    · positivity
    · have := hκ x hx
      have : 2 * κ x + 1 < 2 ^ kb := by omega
      exact_mod_cast this

/-- The scan of the sorted merge emits every request with its table value. -/
theorem scan_sorted (v : ℕ → ℤ × ℤ) (κ : ℕ → ℕ) (R T kb : ℕ) (hκ : ∀ x < T, κ x < R)
    (hR : 2 * R ≤ 2 ^ kb) (cur : ℤ × ℤ) :
    scanF cur (radixSort kb (mergeL v κ R T)) =
      (reqXs (radixSort kb (mergeL v κ R T))).map fun (x : ℕ) => ((x : ℤ), v (κ x)) := by
  set Z := radixSort kb (mergeL v κ R T) with hZ
  have hp : Z.Perm (mergeL v κ R T) := radixSort_perm kb _
  have hb : ∀ r ∈ Z, 0 ≤ key r ∧ key r < 2 ^ kb := fun r hr =>
    key_nonneg_lt v κ R T kb hκ hR r (hp.subset hr)
  have hs := radixSort_sorted kb (mergeL v κ R T)
    (fun r hr => (key_nonneg_lt v κ R T kb hκ hR r hr).1)
  rw [← hZ] at hs
  apply scan_good v κ Z cur
  · unfold SortedMod at hs
    refine hs.imp_of_mem ?_
    intro a b ha hb' hab
    rwa [Int.emod_eq_of_lt (hb a ha).1 (hb a ha).2, Int.emod_eq_of_lt (hb b hb').1 (hb b hb').2]
      at hab
  · exact hp.nodup_iff.2 (mergeL_nodup v κ R T)
  · intro r hr
    rcases mergeL_mem v κ R T r (hp.subset hr) with ⟨c, _, rfl⟩ | ⟨x, _, rfl⟩
    · exact Or.inl ⟨c, rfl⟩
    · exact Or.inr ⟨x, rfl⟩
  · intro x hx
    left
    rcases mergeL_mem v κ R T _ (hp.subset hx) with ⟨c, _, h⟩ | ⟨x', hx', h⟩
    · exact absurd h.symm (tab_ne_req v κ _ _)
    · rw [req_inj h]
      refine hp.mem_iff.2 ?_
      simp only [mergeL, List.mem_append, List.mem_map, List.mem_range]
      exact Or.inl ⟨κ x', hκ x' hx', rfl⟩

/-- Gathering by the request indices. -/
theorem permL_map (Kl : List ℕ) (T : ℕ) (hK : Kl.Perm (List.range T)) (f : ℕ → List ℤ) :
    permL Kl (Kl.map f) = (List.range T).map f := by
  have hl : Kl.length = T := by simpa using hK.length_eq
  unfold permL
  rw [hl]
  apply List.map_congr_left
  intro q hq
  have hm : q ∈ Kl := hK.mem_iff.2 hq
  have hi := List.idxOf_lt_length_iff.2 hm
  rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_map, List.getElem_idxOf hi]

end NLogN.CR

end

