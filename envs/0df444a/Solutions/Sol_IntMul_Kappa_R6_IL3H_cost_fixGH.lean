-- Source module: Solutions.KFWStep1
/-!
# KFW: the uniform local steps of a node (gate, permutation)

A node of level `k + 1` (child level `k`) acts on `W` role streams of `n = Bn 2^t S₀` records,
bits `Fin mC × Fin (mC^k)` at the positions `posR K e k`, strides `stN K e k S₀`.
Its registers are described by **`NodeR σ K t S0 r H k e B Bn`** (the level frame and the node
frame `nodeVals`, everything `< 56`, the gate and phase scratch registers free).

* `stepQ_gate`: a gate of atoms (`gateU`), via `KFN.rImpl_gate` and `gatePG_href`;
* `stepQ_perm`: a role permutation (`swapsG`), via `KFN.rImpl_perm` and `swapsG_href`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

theorem one_le_nN {Bn t S0 : ℕ} (hB : 1 ≤ Bn) (hS : 1 ≤ S0) : 1 ≤ nN Bn t S0 := by
  unfold nN
  have : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have := Nat.mul_le_mul (Nat.mul_le_mul hB this) hS
  simpa using this

end NLogN.KFW

end

