-- Source module: Solutions.KFBCanon
/-!
# KFB §0: fine Lemma 12 with the canonical item-size bound

`lemma12_fine` (KFEBit) bounds the cost by `K ((V+1) u^τ + (u+1)^cE (Bb+2)²)` for every item
size bound `Bb ≥ zsz (T (q² V + 1)²)`.  Here we take the minimal admissible `Bb` and absorb the
overhead term: since `u + 1 ≤ zsz V`, `Bb = O(zsz V)`, and `(zsz V)^k ≤ C_k · V`
(`polylog_le_lin`), the overhead is `≤ C (V + 1)`.

* `pow_le_two_pow`: for each `k` there is `C` with `n^k ≤ C 2^n` for all `n`.
* `zsz_canon_le`: `zsz (T (q² V + 1)²) ≤ A + 2 zsz V` with `A = zsz (T (q²+1)²)`.
* **`lemma12_fine_canon`**: `∃ T q₀, ∀ prime q > q₀, ∃ K' ≥ 0`, for all `u ≥ 1` and positive
  shapes, the fine program `l12F` interchanges the two `[2^u]` fields at a cost
  `c ≤ K' (V + 1) u^τ` (no `Bb` hypothesis left; the run uses `Bb = zsz (T (q² V + 1)²)`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel AModelL12 AModelRat AModelFac Finset KIL KFD KFE Filter

/-- Polynomial versus exponential: `n^k ≤ C 2^n`. -/
theorem pow_le_two_pow (k : ℕ) : ∃ C : ℝ, 0 ≤ C ∧ ∀ n : ℕ, (n : ℝ) ^ k ≤ C * 2 ^ n := by
  have ht := tendsto_pow_const_div_const_pow_of_one_lt k (r := 2) (by norm_num)
  obtain ⟨C, hC⟩ := ht.bddAbove_range
  refine ⟨max C 0, le_max_right _ _, fun n => ?_⟩
  have h1 : (n : ℝ) ^ k / 2 ^ n ≤ max C 0 := le_trans (hC ⟨n, rfl⟩) (le_max_left _ _)
  have h2 : (0 : ℝ) < 2 ^ n := by positivity
  rwa [div_le_iff₀ h2] at h1

/-- `2^(zsz V - 1) ≤ V` for `V ≥ 1`. -/
theorem two_pow_pred_zsz_le {V : ℕ} (hV : 1 ≤ V) : 2 ^ (zsz (V : ℤ) - 1) ≤ V := by
  by_contra h
  push Not at h
  have h' : zsz (V : ℤ) ≤ zsz (V : ℤ) - 1 := by
    rw [zsz_le_iff]; simpa using h
  have : 1 ≤ zsz (V : ℤ) := by
    by_contra h0
    have h00 : zsz (V : ℤ) ≤ 0 := by omega
    rw [zsz_le_iff] at h00
    simp at h00; omega
  omega

theorem two_pow_zsz_le {V : ℕ} (hV : 1 ≤ V) : 2 ^ zsz (V : ℤ) ≤ 2 * V := by
  have h1 := two_pow_pred_zsz_le hV
  have : 1 ≤ zsz (V : ℤ) := by
    by_contra h0
    have h00 : zsz (V : ℤ) ≤ 0 := by omega
    rw [zsz_le_iff] at h00
    simp at h00; omega
  calc 2 ^ zsz (V : ℤ) = 2 * 2 ^ (zsz (V : ℤ) - 1) := by
        rw [← pow_succ']; congr 1; omega
    _ ≤ 2 * V := by omega

theorem one_le_zsz {V : ℕ} (hV : 1 ≤ V) : 1 ≤ zsz (V : ℤ) := by
  by_contra h0
  have h00 : zsz (V : ℤ) ≤ 0 := by omega
  rw [zsz_le_iff] at h00
  simp at h00; omega

/-- The canonical item size: `zsz (T (q² V + 1)²) ≤ zsz (T (q²+1)²) + 2 zsz V`. -/
theorem zsz_canon_le (T q V : ℕ) (hV : 1 ≤ V) :
    zsz ((T * (q ^ 2 * V + 1) ^ 2 : ℕ) : ℤ) ≤
      zsz ((T * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ) + 2 * zsz (V : ℤ) := by
  rw [zsz_le_iff]
  simp only [Int.natAbs_natCast]
  have hA := natAbs_lt_zsz ((T * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ)
  have hL := natAbs_lt_zsz (V : ℤ)
  simp only [Int.natAbs_natCast] at hA hL
  have h1 : q ^ 2 * V + 1 ≤ (q ^ 2 + 1) * V := by nlinarith
  have h2 : T * (q ^ 2 * V + 1) ^ 2 ≤ T * (q ^ 2 + 1) ^ 2 * V ^ 2 := by
    calc T * (q ^ 2 * V + 1) ^ 2 ≤ T * ((q ^ 2 + 1) * V) ^ 2 :=
          Nat.mul_le_mul_left _ (Nat.pow_le_pow_left h1 2)
      _ = T * (q ^ 2 + 1) ^ 2 * V ^ 2 := by ring
  have h3 : V ^ 2 < (2 ^ zsz (V : ℤ)) ^ 2 := Nat.pow_lt_pow_left hL (by norm_num)
  set a := 2 ^ zsz ((T * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ)
  have h4 : T * (q ^ 2 + 1) ^ 2 * V ^ 2 < a * (2 ^ zsz (V : ℤ)) ^ 2 := by
    rcases Nat.eq_zero_or_pos (T * (q ^ 2 + 1) ^ 2) with h0 | h0
    · rw [h0, zero_mul]; positivity
    · calc T * (q ^ 2 + 1) ^ 2 * V ^ 2 < T * (q ^ 2 + 1) ^ 2 * (2 ^ zsz (V : ℤ)) ^ 2 :=
            Nat.mul_lt_mul_of_pos_left h3 h0
        _ ≤ a * (2 ^ zsz (V : ℤ)) ^ 2 := Nat.mul_le_mul_right _ hA.le
  calc T * (q ^ 2 * V + 1) ^ 2 < a * (2 ^ zsz (V : ℤ)) ^ 2 := lt_of_le_of_lt h2 h4
    _ = 2 ^ (zsz ((T * (q ^ 2 + 1) ^ 2 : ℕ) : ℤ) + 2 * zsz (V : ℤ)) := by
      rw [pow_add, ← pow_mul, mul_comm (zsz (V : ℤ)) 2]

/-- The overhead estimate: `(u+1)^c (Bb+2)² ≤ D (V+1)` for the canonical `Bb`, once `u+1 ≤ zsz V`. -/
theorem overhead_le (c A : ℕ) : ∃ D : ℝ, 0 ≤ D ∧ ∀ (u V Bb : ℕ), 1 ≤ V → u + 1 ≤ zsz (V : ℤ) →
    Bb ≤ A + 2 * zsz (V : ℤ) → ((u : ℝ) + 1) ^ c * ((Bb : ℝ) + 2) ^ 2 ≤ D * V := by
  obtain ⟨C, hC0, hC⟩ := pow_le_two_pow (c + 2)
  refine ⟨((A : ℝ) + 4) ^ 2 * C * 2, by positivity, fun u V Bb hV hu hB => ?_⟩
  set L := zsz (V : ℤ)
  have hL1 : 1 ≤ L := one_le_zsz hV
  have hL : (1 : ℝ) ≤ L := by exact_mod_cast hL1
  have h1 : ((u : ℝ) + 1) ≤ L := by exact_mod_cast hu
  have h2 : ((Bb : ℝ) + 2) ≤ ((A : ℝ) + 4) * L := by
    have : (Bb : ℝ) ≤ A + 2 * L := by exact_mod_cast hB
    nlinarith
  have h3 : ((u : ℝ) + 1) ^ c ≤ (L : ℝ) ^ c := pow_le_pow_left₀ (by positivity) h1 c
  have h4 : ((Bb : ℝ) + 2) ^ 2 ≤ (((A : ℝ) + 4) * L) ^ 2 := pow_le_pow_left₀ (by positivity) h2 2
  have h5 : (L : ℝ) ^ (c + 2) ≤ C * 2 ^ L := hC L
  have h6 : ((2 : ℝ) ^ L) ≤ 2 * V := by exact_mod_cast two_pow_zsz_le hV
  calc ((u : ℝ) + 1) ^ c * ((Bb : ℝ) + 2) ^ 2 ≤ (L : ℝ) ^ c * (((A : ℝ) + 4) * L) ^ 2 :=
        mul_le_mul h3 h4 (by positivity) (by positivity)
    _ = ((A : ℝ) + 4) ^ 2 * (L : ℝ) ^ (c + 2) := by ring
    _ ≤ ((A : ℝ) + 4) ^ 2 * (C * 2 ^ L) := mul_le_mul_of_nonneg_left h5 (by positivity)
    _ ≤ ((A : ℝ) + 4) ^ 2 * (C * (2 * V)) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h6 hC0) (by positivity)
    _ = ((A : ℝ) + 4) ^ 2 * C * 2 * V := by ring

end NLogN.KFB

