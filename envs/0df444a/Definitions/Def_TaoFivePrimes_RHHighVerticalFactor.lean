-- title:
--   Checked rational exponential factors for vertical contour steps
-- statement:
--   A1024-entry rational cache for exp(plus or minus pi*m/32768). Each record contains ordinary kernel proofs tying the proposed integers to the32-term negative-exponential program, reciprocal and quantitative finite guards. Analytic accuracy is proved separately. No sign, winding, count or RH assertion.
-- source:
--   Finite exponential Taylor bounds in the existing Platt contour construction, DOI10.1090/mcom/3198. Original surrounding attribution sometik179 c9908072-d99a-4431-aad8-a72c6352619a and Gabewhigham.

import Definitions.Def_TaoFivePrimes_RHHighGammaArithmetic
set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 1000000
namespace RHHighVerticalFactor
open RHHighLogData
noncomputable def input (m : Nat) : Nat := RHHighGammaArithmetic.P*D*m/(32768*10^50)
noncomputable def check (m x negative positive : Nat) : Bool := decide (
  1 ≤ m ∧ m≤1024 ∧ x=input m ∧ negative=RHHighNegativeExp.seed D x ∧
  positive=D*D/negative ∧ 2*x≤D ∧
  x*RHHighGenericExpHorner.horner (RHHighNegativeExp.en D) (x^2)≤
   RHHighGenericExpHorner.horner (RHHighNegativeExp.ep D) (x^2) ∧
  D≤2*negative ∧ negative≤D ∧ 8*positive≤9*D)
structure Record where
  m : Nat
  x : Nat
  negative : Nat
  positive : Nat
  valid : check m x negative positive=true
