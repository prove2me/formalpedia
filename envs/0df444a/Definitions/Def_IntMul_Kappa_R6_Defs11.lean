section
-- Source module: NLogN.HList
/-!
# Counted loops through a family of states

`rep_states`: if the body maps the `k`-th logical state (with the counter on top of `i`) to the
`(k+1)`-st, the loop computes the last one.  This is the interface used for list processing.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

theorem decSt_withCtr (i : Fin HS) (s t : IState HS) (N k : ℕ) :
    decSt i (withCtr i s N k t) = withCtr i s N (k + 1) t := by
  have e : ((N : ℤ) - k - 1) = (N : ℤ) - (k + 1 : ℕ) := by push_cast; ring
  simp only [decSt, withCtr, IState.upd_upd_same, IState.top, IState.upd_G, if_true,
    List.tail_cons, e]

theorem RepStates.repSt {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) :
    ∀ k ≤ (n.eval s).toNat, repSt i n b s k = withCtr i s (n.eval s).toNat k (S k) := by
  intro k
  induction k with
  | zero =>
    intro _
    have := h.nonneg
    have e : n.eval s = (((n.eval s).toNat : ℕ) : ℤ) - ((0 : ℕ) : ℤ) := by push_cast; omega
    simp only [RS.repSt, Function.iterate_zero, id, withCtr, h.h0]
    rw [← e]
  | succ k ih =>
    intro hk
    rw [RS.repSt, Function.iterate_succ_apply', ← RS.repSt, ih (by omega), h.step k (by omega)]
    exact decSt_withCtr i s _ _ _

theorem RepStates.run {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) : (rep i n b).run s = S (n.eval s).toNat := by
  rw [run_rep i n b s h.hw h.nonneg, h.repSt _ le_rfl]
  simp only [withCtr, IState.upd_upd_same]
  rw [← h.hG (n.eval s).toNat, IState.upd_self]

theorem RepStates.ok {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) (hi : i.val < 56) (hc : n.Clean) (hn : n.ok s)
    (hb : ∀ k < (n.eval s).toNat, b.ok (withCtr i s (n.eval s).toNat k (S k))) :
    (rep i n b).ok s :=
  ⟨hi, hc, hn, h.nonneg, h.hw, fun k hk => by rw [h.repSt k hk.le]; exact hb k hk⟩

end NLogN

end

section
-- Source module: NLogN.HRM
/-!
# Register programs with multiplication calls

`RM` extends the register programs `RS` by `mul k i j`, which pushes `top j * top i` onto `k`
by calling the multiplication procedure `pM` with the calling convention

  `ARG = 55 : a :: b :: L  ↦  (a * b) :: L`,

all other stacks unchanged.  The cost of a call and the inputs on which it may be used are a
parameter `M : MulSpec`; `RM.code_runs` holds whenever the procedure meets `MulOK M`.
-/

set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

theorem IOp.run_frame {o : IOp HS} {s s' : IState HS} {c : ℕ} (h : o.run s = some (s', c))
    (j : Fin HS) (hj : j ∉ o.stks) : s'.G j = s.G j := by
  cases o <;> simp only [IOp.stks, List.mem_cons, List.not_mem_nil, or_false, not_or] at hj <;>
    simp only [IOp.run] at h <;> (repeat' split at h) <;> (try simp at h) <;>
    (try split_ifs at h) <;> (try simp at h) <;>
    (try (obtain ⟨rfl, rfl⟩ := h)) <;> (try (obtain ⟨_, rfl, rfl⟩ := h)) <;>
    simp_all [IState.upd_G]

namespace RM

open RS (decSt decE asgCost)

/-! ## Frame -/

theorem run_G_of_not_mem : ∀ (p : RM) (s : IState HS) (j : Fin HS), j ∉ p.writes →
    (p.run s).G j = s.G j
  | rs p, s, j, h => RS.run_G_of_not_mem p s j h
  | mul k i i', s, j, h => by
    simp only [writes, List.mem_singleton] at h; simp [run, IState.upd_G, h]
  | seq a b, s, j, h => by
    simp only [writes, List.mem_append, not_or] at h
    simp only [run]; rw [run_G_of_not_mem b _ j h.2, run_G_of_not_mem a _ j h.1]
  | ite c a b, s, j, h => by
    simp only [writes, List.mem_append, not_or] at h
    simp only [run]; split_ifs
    · exact run_G_of_not_mem a _ j h.1
    · exact run_G_of_not_mem b _ j h.2
  | rep i n b, s, j, h => by
    simp only [writes, List.mem_cons, not_or] at h
    simp only [run, IState.upd_G, if_neg h.1]
    suffices H : ∀ k (t : IState HS), ((fun t => decSt i (b.run t))^[k] t).G j = t.G j by
      rw [H]; simp [IState.upd_G, h.1]
    intro k; induction k with
    | zero => intro t; rfl
    | succ k ih =>
      intro t
      rw [Function.iterate_succ_apply']
      have e := ih t
      generalize ((fun t => decSt i (b.run t))^[k] t) = X at e ⊢
      simp only [decSt, IState.upd_G, if_neg h.1]
      rw [run_G_of_not_mem b _ j h.2, e]
  | op o, s, j, h => by
    simp only [run]; split
    · rename_i r hr; exact IOp.run_frame hr j h
    · rfl
  | prc _ f _ _ w hf _, s, j, h => hf s j h

theorem repSt_G (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (hi : i ∉ b.writes) :
    ∀ k, (repSt i n b s k).G i = .int (n.eval s - k) :: s.G i := by
  intro k; induction k with
  | zero => simp [repSt, IState.upd_G]
  | succ k ih =>
    simp only [repSt, Function.iterate_succ_apply'] at ih ⊢
    generalize ((fun t => decSt i (b.run t))^[k] (s.upd i (.int (n.eval s) :: s.G i))) = X at ih ⊢
    have := run_G_of_not_mem b X i hi
    simp only [decSt, IState.upd_G, if_true, IState.top, this, ih, List.tail_cons]
    push_cast; ring_nf

/-! ## Reasoning lemmas -/

theorem run_rep (i : Fin HS) (n : Ex HS) (b : RM) (s : IState HS) (hw : i ∉ b.writes)
    (h0 : 0 ≤ n.eval s) :
    (rep i n b).run s = (repSt i n b s (n.eval s).toNat).upd i (s.G i) := by
  have := repSt_G i n b s hw (n.eval s).toNat
  simp only [repSt] at this
  simp only [run, repSt, this]; rfl

/-! ## Counted loops through a family of states -/

theorem RepStates.repSt' {i : Fin HS} {n : Ex HS} {b : RM} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) :
    ∀ k ≤ (n.eval s).toNat, repSt i n b s k = withCtr i s (n.eval s).toNat k (S k) := by
  intro k
  induction k with
  | zero =>
    intro _
    have := h.nonneg
    have e : n.eval s = (((n.eval s).toNat : ℕ) : ℤ) - ((0 : ℕ) : ℤ) := by push_cast; omega
    simp only [RM.repSt, Function.iterate_zero, id, withCtr, h.h0]
    rw [← e]
  | succ k ih =>
    intro hk
    rw [RM.repSt, Function.iterate_succ_apply', ← RM.repSt, ih (by omega), h.step k (by omega)]
    exact decSt_withCtr i s _ _ _

theorem RepStates.run {i : Fin HS} {n : Ex HS} {b : RM} {s : IState HS} {S : ℕ → IState HS}
    (h : RepStates i n b s S) : (rep i n b).run s = S (n.eval s).toNat := by
  rw [run_rep i n b s h.hw h.nonneg, h.repSt' _ le_rfl]
  simp only [withCtr, IState.upd_upd_same]
  rw [← h.hG (n.eval s).toNat, IState.upd_self]

theorem RepStates.ok {M : MulSpec} {i : Fin HS} {n : Ex HS} {b : RM} {s : IState HS}
    {S : ℕ → IState HS}
    (h : RepStates i n b s S) (hi : i.val < 56) (hc : n.Clean) (hn : n.ok s)
    (hb : ∀ k < (n.eval s).toNat, b.ok M (withCtr i s (n.eval s).toNat k (S k))) :
    (rep i n b).ok M s :=
  ⟨hi, hc, hn, h.nonneg, h.hw, fun k hk => by rw [h.repSt' k hk.le]; exact hb k hk⟩

end RM

end NLogN

end

section
-- Source module: NLogN.HLinCost
/-!
# Linear cost bounds for assignments, pushes and counted loops

Loop overhead is linear in the size of the counter, so a pass over `n` elements costs
`O(n · (C + log n))` rather than `O(n · log² n)`.
-/

namespace NLogN

open IntMul

namespace RS

theorem asgCost_le_lin (i : Fin HS) (e : Ex HS) (s : IState HS) (B : ℕ) (hl : e.Lin)
    (h : e.Bnd s B) (hi : zsz (s.top i) ≤ B) :
    asgCost i e s ≤ (e.size + 1) * 2000 * (B + 2) := by
  have h1 := Ex.cost_le_lin s B e hl h
  have h2 := Ex.zsz_eval_le s B e h
  simp only [asgCost, moveCost]; nlinarith

theorem pushCost_le_lin (e : Ex HS) (s : IState HS) (B : ℕ) (hl : e.Lin) (h : e.Bnd s B) :
    e.cost s + (2 * moveCost (zsz (e.eval s)) + 19) ≤ (e.size + 1) * 2000 * (B + 2) := by
  have h1 := Ex.cost_le_lin s B e hl h
  have h2 := Ex.zsz_eval_le s B e h
  simp only [moveCost]; nlinarith

theorem decCost_le (i : Fin HS) (t : IState HS) (B : ℕ) (h1 : zsz (t.top i) ≤ B)
    (h2 : zsz (t.top i + -1) ≤ B) (hB : 1 ≤ B) : asgCost i (decE i) t ≤ 8000 * (B + 2) := by
  have := asgCost_le_lin i (decE i) t B (by simp [decE, Ex.Lin])
    (by simp only [decE, Ex.Bnd, Ex.eval]; refine ⟨h1, ?_, h2⟩; rw [zsz_neg_r6c, zsz_one_r6c]; omega) h1
  have hs : (decE i).size = 3 := rfl
  rw [hs] at this; omega

end RS

/-- Shared step of the loop cost bounds: the decrement in iteration `k` reads `N - k`. -/
theorem withCtr_dec_le {B : ℕ} (i : Fin HS) (s t : IState HS) (n : Ex HS) (k : ℕ)
    (hk : k < (n.eval s).toNat) (hB : zsz (n.eval s) ≤ B) :
    RS.asgCost i (RS.decE i) (withCtr i s (n.eval s).toNat k t) ≤ 8000 * (B + 2) := by
  have hv : zsz (((n.eval s).toNat : ℤ) - k) ≤ B := le_trans (zsz_mono_r6c (by omega)) hB
  have hv' : zsz (((n.eval s).toNat : ℤ) - k + -1) ≤ B := le_trans (zsz_mono_r6c (by omega)) hB
  have h1 : 1 ≤ B := by
    by_contra hc
    have := (zsz_le_iff (z := n.eval s) (m := 0)).1 (by omega); simp at this; omega
  apply RS.decCost_le
  · simpa [IState.top, withCtr] using hv
  · simpa [IState.top, withCtr] using hv'
  · exact h1

theorem RepStates.cost_le_lin {i : Fin HS} {n : Ex HS} {b : RS} {s : IState HS}
    {S : ℕ → IState HS}
    (h : RepStates i n b s S) (B C : ℕ) (hl : n.Lin) (hn : n.Bnd s B)
    (hb : ∀ k < (n.eval s).toNat, b.cost (withCtr i s (n.eval s).toNat k (S k)) ≤ C) :
    (RS.rep i n b).cost s ≤ (n.size + 1) * 2000 * (B + 2) +
      (n.eval s).toNat * (C + 8000 * (B + 2) + 30) + 32 := by
  have hB := Ex.zsz_eval_le s B n hn
  have h1 := RS.pushCost_le_lin n s B hl hn
  have h2 : ∑ k ∈ Finset.range (n.eval s).toNat, (b.cost (RS.repSt i n b s k) +
      RS.asgCost i (RS.decE i) (b.run (RS.repSt i n b s k)) + 30) ≤
      (n.eval s).toNat * (C + 8000 * (B + 2) + 30) := by
    have := Finset.sum_le_sum (s := Finset.range (n.eval s).toNat)
      (f := fun k => b.cost (RS.repSt i n b s k) +
        RS.asgCost i (RS.decE i) (b.run (RS.repSt i n b s k)) + 30)
      (g := fun _ => C + 8000 * (B + 2) + 30) (fun k hk => by
        have hk' := Finset.mem_range.1 hk
        rw [h.repSt k hk'.le]
        have := hb k hk'
        rw [h.step k hk']
        have := withCtr_dec_le i s (S (k + 1)) n k hk' hB
        omega)
    simpa using this
  simp only [RS.cost]; omega

end NLogN

end

section
-- Source module: NLogN.HRen
/-!
# Renaming stacks and procedures of item-language programs

Given a map of stacks `f : Fin S → Fin S'` and a map of procedure indices `g : Fin P → Fin P'`,
`IStmt.ren f g` renames every stack `i` to `f i` and every call `j` to `g j`.  For injective `f`,
executions are simulated: a run from `s` to `s'` becomes a run from `embed f s t` to `embed f s' t`,
where `IState.embed f s t` is `t` with the stacks in the image of `f` overwritten by those of `s`
(and `ip`, `out` taken from `s`).  Stacks outside the image of `f` are untouched.
-/

namespace NLogN

open IntMul

variable {S S' P P' : ℕ}

section Inj

variable {f : Fin S → Fin S'} (hf : Function.Injective f)
include hf

theorem IState.embed_G (s : IState S) (t : IState S') (x : Fin S) :
    (IState.embed f s t).G (f x) = s.G x := hf.extend_apply _ _ _

omit hf in
theorem IState.embed_G_of_not (s : IState S) (t : IState S') (y : Fin S') (hy : ∀ x, f x ≠ y) :
    (IState.embed f s t).G y = t.G y :=
  Function.extend_apply' _ _ _ (by rintro ⟨x, hx⟩; exact hy x hx)

theorem IState.embed_upd (s : IState S) (t : IState S') (i : Fin S) (L : List Item) :
    IState.embed f (s.upd i L) t = (IState.embed f s t).upd (f i) L := by
  refine IState.ext' (fun y => ?_) rfl rfl
  by_cases hy : ∃ x, f x = y
  · obtain ⟨x, rfl⟩ := hy
    rw [IState.embed_G hf, IState.upd_G, IState.upd_G, IState.embed_G hf]
    by_cases h : x = i
    · simp [h]
    · simp [h, hf.ne h]
  · push Not at hy
    rw [IState.embed_G_of_not _ _ _ hy, IState.upd_G, if_neg (hy i).symm,
      IState.embed_G_of_not _ _ _ hy]

theorem IState.embed_cl (s : IState S) (t : IState S') (i : Fin S) :
    (IState.embed f s t).cl (f i) = s.cl i := by
  simp only [IState.cl, IState.embed_G hf]

variable {I : List Sym}

theorem IOp.Step.ren {o : IOp S} {s s' : IState S} {c : ℕ} (h : o.Step I s s' c)
    (t : IState S') : (o.ren f).Step I (IState.embed f s t) (IState.embed f s' t) c := by
  cases h with
  | add hij hi hj =>
    rename_i i j k a b Li Lj
    have := IOp.Step.add (I := I) (s := IState.embed f s t) (k := f k) (hf.ne hij)
      (by rw [IState.embed_G hf, hi]) (by rw [IState.embed_G hf, hj])
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | neg hi =>
    have := IOp.Step.neg (I := I) (s := IState.embed f s t) (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf] at this
    exact this
  | dup hij hi =>
    have := IOp.Step.dup (I := I) (s := IState.embed f s t) (hf.ne hij)
      (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | drop hi =>
    have := IOp.Step.drop (I := I) (s := IState.embed f s t) (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf] at this
    exact this
  | mv hij hi =>
    have := IOp.Step.mv (I := I) (s := IState.embed f s t) (hf.ne hij)
      (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | const c =>
    rename_i i
    have := IOp.Step.const (I := I) (s := IState.embed f s t) (i := f i) c
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | mark =>
    rename_i i
    have := IOp.Step.mark (I := I) (s := IState.embed f s t) (i := f i)
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | unmark hi =>
    have := IOp.Step.unmark (I := I) (s := IState.embed f s t) (by rw [IState.embed_G hf, hi])
    simp only [← IState.embed_upd hf] at this
    exact this
  | shl hij hi hj =>
    have := IOp.Step.shl (I := I) (s := IState.embed f s t) (hf.ne hij)
      (by rw [IState.embed_G hf, hi]) (by rw [IState.embed_G hf, hj])
    simp only [← IState.embed_upd hf] at this
    exact this
  | split hij hik hjk hi hj =>
    have := IOp.Step.split (I := I) (s := IState.embed f s t) (hf.ne hij) (hf.ne hik)
      (hf.ne hjk) (by rw [IState.embed_G hf, hi]) (by rw [IState.embed_G hf, hj])
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | read W hij hs0 hs1 hk hstop =>
    have := IOp.Step.read (I := I) (s := IState.embed f s t) W (hf.ne hij) hs0 hs1 hk hstop
    simp only [← IState.embed_upd hf, IState.embed_G hf] at this
    exact this
  | write hij hn hi hj =>
    have := IOp.Step.write (I := I) (s := IState.embed f s t) (hf.ne hij) hn
      (by rw [IState.embed_G hf, hi]) (by rw [IState.embed_G hf, hj])
    simp only [← IState.embed_upd hf] at this
    exact this
  | cat hij hik hjk ha hb hi hj hk =>
    have := IOp.Step.cat (I := I) (s := IState.embed f s t) (hf.ne hij) (hf.ne hik) (hf.ne hjk)
      ha hb (by rw [IState.embed_G hf, hi]) (by rw [IState.embed_G hf, hj])
      (by rw [IState.embed_G hf, hk])
    simp only [← IState.embed_upd hf] at this
    exact this

/-- **Simulation**: a renamed program runs on the embedded states, with the same cost. -/
theorem IExec.ren {iprog : Fin P → IStmt S P} {iprog' : Fin P' → IStmt S' P'} {g : Fin P → Fin P'}
    (hprog : ∀ j, iprog' (g j) = (iprog j).ren f g) {p : IStmt S P} {s s' : IState S} {c : ℕ}
    (h : IExec I iprog p s s' c) (t : IState S') :
    IExec I iprog' (p.ren f g) (IState.embed f s t) (IState.embed f s' t) c := by
  induction h with
  | skip s => exact .skip _
  | op h => exact .op (h.ren hf t)
  | seq _ _ ih₁ ih₂ => exact .seq ih₁ ih₂
  | iteT hc _ ih => exact .iteT (by rw [IState.embed_cl hf]; exact hc) ih
  | iteF hc _ ih => exact .iteF (by rw [IState.embed_cl hf]; exact hc) ih
  | loopT hc _ _ ih₁ ih₂ => exact .loopT (by rw [IState.embed_cl hf]; exact hc) ih₁ ih₂
  | loopF hc => exact .loopF (by rw [IState.embed_cl hf]; exact hc)
  | call _ ih => exact .call (by rw [hprog]; exact ih)

theorem IRuns.ren {iprog : Fin P → IStmt S P} {iprog' : Fin P' → IStmt S' P'} {g : Fin P → Fin P'}
    (hprog : ∀ j, iprog' (g j) = (iprog j).ren f g) {p : IStmt S P} {s s' : IState S} {c : ℕ}
    (h : IRuns I iprog p s s' c) (t : IState S') :
    IRuns I iprog' (p.ren f g) (IState.embed f s t) (IState.embed f s' t) c := by
  obtain ⟨c', hc, h⟩ := h
  exact ⟨c', hc, IExec.ren hf hprog h t⟩

end Inj

end NLogN

