    congr 1 <;> funext i <;> simp
  · have h' : P.δ q (fun i => T.cells i (T.head i)) = none := h q rfl
    simp only [MultitapeTM.step, toCfg, IntMul.Mach.compile, h']
    congr 1 <;> funext i <;> simp

