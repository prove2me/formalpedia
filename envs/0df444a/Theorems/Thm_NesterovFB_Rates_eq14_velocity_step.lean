-- title:
--   (14), p. 4 — Θ(x_{k+1}) + ‖x_{k+1} − x_k‖²/(2s) ≤ Θ(x_k) + (k−1)²/(k+α−1)²·‖x_k − x_{k−1}‖²/(2s)
-- statement:
--   Let $\mathcal H$ be a real Hilbert space, $\Psi:\mathcal H\to\mathbb R\cup\{+\infty\}$ proper, lower semicontinuous and convex, $\Phi:\mathcal H\to\mathbb R$ convex and continuously differentiable with $L$-Lipschitz gradient, $\Theta=\Psi+\Phi$, $0<s<1/L$, $\alpha\ge3$, and let $(x_k)$ be generated by algorithm (2). Then for every $k\ge1$,
--   $$\Theta(x_{k+1})+\frac1{2s}\|x_{k+1}-x_k\|^2\le\Theta(x_k)+\frac1{2s}\,\frac{(k-1)^2}{(k+\alpha-1)^2}\,\|x_k-x_{k-1}\|^2 .$$
--
--   With $\theta_k=\Theta(x_k)-\Theta(x^*)$ and $d_k=\frac1{2s}\|x_{k+1}-x_k\|^2$ this is the recursion (15), $\theta_{k+1}+d_k\le\theta_k+\frac{(k-1)^2}{(k+\alpha-1)^2}d_{k-1}$, which drives Fact 4 and Lemma 2.
--
--   **Formalization Note.** $0<s<1/L$ is written $sL<1$. The section's standing assumption $\operatorname{argmin}\Theta\neq\emptyset$ is not needed for this inequality and is not assumed; the statement is therefore slightly more general than the section's setting. Values of $\Theta$ are extended reals.
-- source:
--   Attouch and Peypouquet, The Rate of Convergence of Nesterov's Accelerated Forward-Backward Method is Actually Faster than 1/k^2, arXiv:1510.08740v4, p. 4, (14)

import Mathlib
import Definitions.Def_ThreeOpSplitting_ConvexRates_Problem
import Definitions.Def_NesterovFB_Rates_Algorithm

open Filter Topology InnerProductSpace

namespace NesterovFB.Rates

theorem eq14_velocity_step {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
    (Ψ : H → EReal) (Φ : H → ℝ) (L : NNReal) (s α : ℝ) (P : H → H) (x : ℕ → H)
    (hΨ : ThreeOpSplitting.ConvexRates.IsProperClosedConvex Ψ)
    (hΦc : ConvexOn ℝ Set.univ Φ) (hΦd : ContDiff ℝ 1 Φ)
    (hL : LipschitzWith L (gradient Φ))
    (hs : 0 < s) (hsL : s * L < 1)
    (hP : ThreeOpSplitting.ConvexRates.IsProx s Ψ P)
    (hrun : IsAccelFBRun Φ P α s x)
    (hα : 3 ≤ α) :
    ∀ k : ℕ, 1 ≤ k →
      theta Ψ Φ (x (k + 1)) + ((1 / (2 * s) * ‖x (k + 1) - x k‖ ^ 2 : ℝ) : EReal)
        ≤ theta Ψ Φ (x k) + ((1 / (2 * s) * (((k : ℝ) - 1) ^ 2 / ((k : ℝ) + α - 1) ^ 2)
            * ‖x k - x (k - 1)‖ ^ 2 : ℝ) : EReal) := by sorry

end NesterovFB.Rates
