import Definitions.Def_ProbabilityTheory_chapter_05_def_5_5to10_F000
import Mathlib.MeasureTheory.Measure.MeasureSpaceDef
import Mathlib.Probability.Independence.Basic
import Mathlib.Tactic

open MeasureTheory ProbabilityTheory

/-!
# Outline for thm_5_6: independence is stable under complementing one member

`def_5_5 μ A` is `ProbabilityTheory.iIndepSet A μ`, which by
`ProbabilityTheory.iIndepSet_iff_iIndep` is `iIndep (fun j => generateFrom {A j}) μ`:
independence of the family of singleton-generated σ-algebras.

Replacing `A i` by `(A i)ᶜ` does not change the generated σ-algebra at `i`
(complement closure, `gen_compl`) and does not touch the others, so pointwise
`generateFrom {(update A i (A i)ᶜ) j} ≤ generateFrom {A j}`
(`gen_fam_le_update_compl`); monotonicity
`ProbabilityTheory.iIndep_of_iIndep_of_le` then carries the independence over.
-/

namespace P2MHole01_0677bdcd
universe u_1
theorem solution {Ω : Type u_1} [inst : MeasurableSpace Ω] (s : Set Ω) :
  MeasurableSpace.generateFrom {sᶜ} = MeasurableSpace.generateFrom {s} := by
  apply le_antisymm
  · refine MeasurableSpace.generateFrom_le (m := MeasurableSpace.generateFrom {s}) ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst t
    exact (MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton s)).compl
  · refine MeasurableSpace.generateFrom_le (m := MeasurableSpace.generateFrom {sᶜ}) ?_
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst t
    exact by simpa using (MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton sᶜ)).compl
end P2MHole01_0677bdcd

/-- Complementing a set does not change the σ-algebra it generates:
    `{sᶜ}` and `{s}` generate the same `MeasurableSpace.generateFrom`.
    Idea: both directions of
    `MeasurableSpace.generateFrom.antisymm` via `MeasurableSpace.generateFrom_mono`,
    using that the σ-algebra generated by a singleton is closed under complement
    (`MeasurableSpace.compl measurable` / `sigma`-closure). -/
theorem gen_compl {Ω : Type _} [MeasurableSpace Ω] (s : Set Ω) :
    MeasurableSpace.generateFrom {sᶜ} = MeasurableSpace.generateFrom {s} := by
  (first | exact P2MHole01_0677bdcd.solution s | (apply P2MHole01_0677bdcd.solution <;> assumption))

/-- Pointwise, the σ-algebra generated by the `j`-th set of the family
    obtained from `A` by replacing `A i` with its complement is contained in
    the one generated by `A j` (equality at `j = i` by `gen_compl`, reflexivity
    otherwise; by `Function.update_apply`). -/
theorem gen_fam_le_update_compl {Ω : Type _} [MeasurableSpace Ω] {n : ℕ}
    (A : Fin n → Set Ω) (i : Fin n) :
    ∀ j, MeasurableSpace.generateFrom {(Function.update A i ((A i)ᶜ)) j} ≤
        MeasurableSpace.generateFrom {A j} := by
  intro j
  by_cases hij : j = i
  · rw [hij, Function.update_self]
    exact (gen_compl (A i)).le
  · rw [Function.update_apply, if_neg hij]

theorem solution {Ω : Type _} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {n : ℕ}
    (A : Fin n → Set Ω) (i : Fin n) (hA : def_5_5 μ A) :
    def_5_5 μ (Function.update A i ((A i)ᶜ)) := by
  have hA' : ProbabilityTheory.iIndep (fun j => MeasurableSpace.generateFrom {A j}) μ :=
    (ProbabilityTheory.iIndepSet_iff_iIndep A μ).1 hA
  have hle : ∀ j, MeasurableSpace.generateFrom {(Function.update A i ((A i)ᶜ)) j} ≤
      MeasurableSpace.generateFrom {A j} :=
    gen_fam_le_update_compl A i
  have hgoal : ProbabilityTheory.iIndep
      (fun j => MeasurableSpace.generateFrom {(Function.update A i ((A i)ᶜ)) j}) μ :=
    ProbabilityTheory.iIndep_of_iIndep_of_le hA' hle
  exact (ProbabilityTheory.iIndepSet_iff_iIndep (Function.update A i ((A i)ᶜ)) μ).2 hgoal
