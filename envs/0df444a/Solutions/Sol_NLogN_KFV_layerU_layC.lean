/-- Registers read from a round context through the managed array. -/
theorem RCtx.ev {L : LP} {fl : List Bool} {h : ℕ} {s : IState HS} (H : RCtx L fl h s) (v : List ℤ)
    {B : ℕ} (hB : 1 ≤ B) (hD : L.D ≤ B) (hl : L.ℓ ≤ B) (hb : L.b ≤ B) (hn : L.nL ≤ B) (hN : L.n ≤ B)
    (hh : h ≤ B) :
    EV (encK s (o0 v)) B (.reg NLogN.KFV.gD) (L.D : ℤ) ∧ EV (encK s (o0 v)) B (.reg gLl) (L.ℓ : ℤ) ∧
      EV (encK s (o0 v)) B (.reg gBb) (L.b : ℤ) ∧ EV (encK s (o0 v)) B (.reg gNL) (L.nL : ℤ) ∧
      EV (encK s (o0 v)) B (.reg gNn) (L.n : ℤ) ∧ EV (encK s (o0 v)) B (.reg gH) (h : ℤ) := by
  have G := H.gregs (f := o0 v) (fun j hj => o0_ne _ (gIn_ne_y hj).1)
  obtain ⟨L1, e1⟩ := G.d; obtain ⟨L2, e2⟩ := G.l; obtain ⟨L3, e3⟩ := G.b
  obtain ⟨L4, e4⟩ := G.nl; obtain ⟨L5, e5⟩ := G.n; obtain ⟨L6, e6⟩ := G.h
  exact ⟨EV.reg e1 (zsz_nat_le hD), EV.reg e2 (zsz_nat_le hl), EV.reg e3 (zsz_nat_le hb),
    EV.reg e4 (zsz_nat_le hn), EV.reg e5 (zsz_nat_le hN), EV.reg e6 (zsz_nat_le hh)⟩

theorem RG_ePre : RG ePre :=
  RG.add (RG.reg (by decide)) (RG.mul (RG.add (RG.add (RG.reg (by decide)) (RG.lit _))
    (RG.neg (RG.reg (by decide)))) (RG.reg (by decide)))

theorem RG_eSpre : RG eSpre :=
  RG.add (RG.add (RG.reg (by decide)) (RG.neg RG_ePre)) (RG.neg (RG.reg (by decide)))

