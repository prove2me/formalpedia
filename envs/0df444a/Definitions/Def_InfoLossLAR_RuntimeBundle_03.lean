    ((digits.flatMap (fun bit => [true,bit]))++false::suffix).foldl
        _root_.Integration9_9.LARPlatformEncoding.markedStep ((false,false),(acc,[])) =
      ((true,false),(digits.reverse++acc,suffix.reverse)) := by
  induction digits generalizing acc with
  | nil => simp [_root_.Integration9_9.LARPlatformEncoding.markedStep,_root_.Integration9_9.LARPlatformEncoding.marked_fold_stopped]
  | cons bit digits ih =>
    simp only [List.flatMap_cons,List.cons_append,List.nil_append,List.foldl_cons]
