    rcases hi with rfl | rfl | rfl | rfl
    exacts [⟨_, hC1.hK⟩, ⟨_, hC1.hD'⟩, ⟨_, h14'⟩, ⟨_, hC1.hρ⟩]
  have v1 := vOf_eq hC1.hK
  have v29 := vOf_eq hC1.hD'
  have v14 := vOf_eq h14'
  have v23 := vOf_eq hC1.hρ
  have hqD : qB ≤ D' := by omega
  have hKE : K * E ≤ K * D := Nat.mul_le_mul_left _ (by omega)
  have hKqB : K * qB ≤ K * D := Nat.mul_le_mul_left _ (by omega)
  have hKE1 : K * (E - 1) ≤ K * D := Nat.mul_le_mul_left _ (by omega)
  have hKEr : K * (D - q0 - qB) ≤ K * D := hKE
  have hKE1r : K * (D - q0 - qB - 1) ≤ K * D := hKE1
  have eT : ExV σ1 mtNE.toEx (t : ℤ) Zf := by
    have := exV_NE (σ := σ1) (e := mtNE) (natR_of _ hnat1 (by decide)) (M := 32 * N) hZf (by
      simp only [mtNE, dppNE, NE.OK, NE.val, v1, v29, v14]; omega)
    refine this.congr ?_
    simp only [mtNE, dppNE, NE.val, v1, v29, v14, ht, hE, hD']
  have eK : ExV σ1 dppNE.toEx (E : ℤ) Zf := by
    have := exV_NE (σ := σ1) (e := dppNE) (natR_of _ hnat1 (by decide)) (M := 32 * N) hZf (by
      simp only [dppNE, NE.OK, NE.val, v29, v14]; omega)
    refine this.congr ?_
    simp only [dppNE, NE.val, v29, v14, hE, hD']
  have eE : ExV σ1 meNE.toEx (e : ℤ) Zf := by
    have := exV_NE (σ := σ1) (e := meNE) (natR_of _ hnat1 (by decide)) (M := 32 * N) hZf (by
      simp only [meNE, dppNE, NE.OK, NE.val, v1, v29, v14, v23]
      have : D - q0 - qB - 1 = E - 1 := rfl
      omega)
    refine this.congr ?_
    simp only [meNE, dppNE, NE.val, v1, v29, v14, v23, he, hE, hD']
  have h2qB : 2 ^ (K * qB) ≤ 2 ^ (K * D) := Nat.pow_le_pow_right (by norm_num) hKqB
  have hS0N : S0 ≤ N := by
    have : S * 2 ^ (K * qB) ≤ S * 2 ^ (K * D) := Nat.mul_le_mul_left _ h2qB
    have h2 : S * 2 ^ (K * D) ≤ N := by
      rw [hN, hn]
      have := Nat.mul_le_mul_left (S * 2 ^ (K * D)) (Nat.mul_le_mul hP hr); nlinarith
    omega
  have eS : ExV σ1 msE (S0 : ℤ) Zf := by
    have rS1 := ExV.reg (B := Zf) hC1.hS (zb S (by omega))
    have ek := exV_NE (σ := σ1) (e := mkNE) (natR_of _ hnat1 (by decide)) (M := 32 * N) hZf (by
      simp only [mkNE, NE.OK, NE.val, v1, v14]; omega)
    have hkv : mkNE.val (vOf σ1) = K * qB := by simp only [mkNE, NE.val, v1, v14]
    rw [hkv] at ek
    have hp := ExV.pow2 ek (by positivity) (by
      rw [Int.toNat_natCast]; exact hpow _ (by omega))
    rw [Int.toNat_natCast] at hp
    exact (ExV.mul rS1 hp (zszN (n := S0) (by rw [hS0]; push_cast; ring) (by omega)
      (zb _ le_rfl))).congr (by rw [hS0]; push_cast; ring)
  have eB : ExV σ1 (.reg 20) (Bp : ℤ) Zf := ExV.reg hC1.hBp (zb Bp (by omega))
  have hGE : c.G E ≤ H := hGH
  have eX : ExV σ1 (.reg 15) ((c.G E : ℕ) : ℤ) Zf :=
    ExV.reg h15' (le_trans (zsz_natCast_le hGE) hHf)
  set l2 := midL c t S0 E e Bp with hl2
  have hok2 : FrXOK σ1 Zf 32 l2 := by
    intro x hx
    simp only [hl2, midL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eT⟩
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eS⟩
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eK⟩
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eE⟩
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eB⟩
    · exact ⟨by (try dsimp only); decide, clean_of_lt (by (try dsimp only); decide), by (try dsimp only); decide, eX⟩
  have hnr2 : NoRd [] l2 := by
    simp only [hl2, midL, NoRd]
    refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, trivial⟩
  have h02 : ∀ x ∈ l2, x.1 ≠ 0 := by
    intro x hx
    simp only [hl2, midL, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only); decide)
  set σ2 := σPush σ1 (l2.map fun x => (x.1, x.2.2)) with hσ2
  have hLev : LevRH c σ2 K t S0 r H E e Bp := by
    rw [hσ2, hl2, midL_V]; exact levRH_of6 hC1.base hC1.hK hC1.hr hC1.hH c _ _ _ _ _
  have hG2 : σ2 vG = some (G : ℤ) := by
    rw [hσ2, hl2, midL_V, σPush_ne _ _ _ (fun p hp e => by
      simp only [lev6, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;> ((try dsimp only at e); revert e; decide))]
    exact hG1
  -- the level call
  have hS01 : 1 ≤ S0 := Nat.mul_le_mul hS Nat.one_le_two_pow
  have hdS : 2 ^ ((E / c.m - 1) * G) ∣ S0 :=
    dvd_trans (pow_dvd_pow 2 hSd) (Dvd.intro_left _ rfl)
  have hem : e % K = ρ := by
    rw [he, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hρ]
  have hnpE : nN Bp t S0 = np := by
    simp only [nN, ht, hS0, hnp, hD'E, Nat.mul_add, pow_add]; ring
  have hZlev : zsz ((16 * (c.Wr * (Bp * 2 ^ t * S0 * r)) : ℕ) : ℤ) ≤ Z := by
    have e1 : Bp * 2 ^ t * S0 = np := hnpE
    rw [e1]
    refine le_trans (zsz_natCast_le ?_) hZl
    have : 16 * (np * r) ≤ 32 * N := by omega
    calc 16 * (c.Wr * (np * r)) = c.Wr * (16 * (np * r)) := by ring
      _ ≤ c.Wr * (32 * N) := Nat.mul_le_mul_left _ this
      _ = 32 * c.Wr * (P * 2 ^ (K * D) * S * r) := by rw [hN, hn]; ring
  have LQ := LV σ2 t S0 e Bp hLev hG2 hS01 hBp1 hdvd hdS (by omega)
    (by rw [hem]; have : K * (E - 1) + K = K * E := by
          rw [← Nat.mul_succ]; congr 1; omega
        omega) hZlev hV hGE
  have LC := sImplQ_call hL LQ
  rw [hnpE] at LC
  have hstI : (fun i : Fin E => 2 ^ (e - K * i.val) * S0) = stM K D S ρ q0 E := by
    funext y
    have hy := y.isLt
    simp only [stM, he, hS0]
    have h1 : ρ + K * (E - 1) - K * y.val = ρ + K * (E - 1 - y.val) := by
      have e1 : K * (E - 1 - y.val) + K * y.val = K * (E - 1) := by
        rw [← Nat.mul_add]; congr 1; omega
      omega
    have h2 : D - 1 - (q0 + y.val) = (E - 1 - y.val) + qB := by omega
    rw [h1, h2, Nat.mul_add, ← add_assoc, pow_add]; ring
  rw [hstI] at LC
  have FX1 := sImplQ_frX (I := Isym) (iprog := tbl) hσ10 l2 Zf 32 hok2 hnr2 h02 LC
  rw [hl2, midL_E] at FX1
  -- padding
  have hslM : SLaws (stM K D S ρ q0 E) n := by
    refine slaws_pow (fun y : Fin E => ρ + K * (D - 1 - (q0 + y.val))) ?_ (K * D) S P ?_
    · intro a b h
      simp only at h
      have h1 : K * (D - 1 - (q0 + a.val)) = K * (D - 1 - (q0 + b.val)) := by omega
      have h2 := Nat.eq_of_mul_eq_mul_left (by omega) h1
      exact Fin.ext (by have := a.isLt; have := b.isLt; omega)
    · intro y
      have := y.isLt
      have : K * (D - 1 - (q0 + y.val)) + K ≤ K * D := by
        rw [← Nat.mul_succ]; exact Nat.mul_le_mul_left _ (by omega)
      omega
  have PU := sImplQ_padU (Isym := Isym) (iprog := tbl) hslM hnnp hC1.base.lt hC1.base.off h17 h18
    FX1 Zf (zb _ (by
      have : (np - n) * r ≤ np * r := Nat.mul_le_mul_right _ (Nat.sub_le _ _); omega))
  have FX := sImplQ_frX (I := Isym) (iprog := tbl) hσ0 l Zf 32 hok hnr h0 PU
  rw [hl, KFW.padL_E] at FX
  -- to the layer bits
  set g : Fin E → Fin D := fun y => ⟨q0 + y.val, by have := y.isLt; omega⟩ with hg
  have hginj : Function.Injective g := fun a b h => Fin.ext (by
    have := congrArg Fin.val h; simp only [hg] at this; omega)
  have hst : stM K D S ρ q0 E = (fun x : Fin D => KFH.stT K D S ρ x) ∘ g := by
    funext y
    have hy := y.isLt
    show 2 ^ (ρ + K * (D - 1 - (q0 + y.val))) * S = KFH.stT K D S ρ (q0 + y.val)
    rw [show KFH.stT K D S ρ (q0 + y.val) = 2 ^ (ρ + K * (D - (q0 + y.val + 1))) * S from
      stT_eq (⟨q0 + y.val, by omega⟩ : Fin D)]
    have h3 : D - 1 - (q0 + y.val) = D - (q0 + y.val + 1) := by omega
    rw [h3]
  rw [hst] at FX
  have FS := sImplQ_subOp hginj FX
  rw [subOp_tens hginj] at FS
  have hT2 : (tensF fun i : Fin D => @ite _ (∃ k, g k = i) Fintype.decidableExistsFintype Cm 1) =
      tensF fun x : Fin D => if q0 ≤ x.val ∧ x.val < q0 + E then Cm else 1 := by
    congr 1; funext x
    have hex : (∃ k, g k = x) ↔ q0 ≤ x.val ∧ x.val < q0 + E := by
      constructor
      · rintro ⟨y, rfl⟩; simp only [hg]; have := y.isLt; omega
      · intro h; exact ⟨⟨x.val - q0, by omega⟩, Fin.ext (by simp only [hg]; omega)⟩
    by_cases h : q0 ≤ x.val ∧ x.val < q0 + E
    · rw [if_pos (hex.2 h), if_pos h]
    · rw [if_neg (fun e => h (hex.1 e)), if_neg h]
  rw [hT2] at FS
  refine FS.mono (fun w _ _ => le_of_eq ?_)
  simp only [cMid, cMidI, hl, hl2, KFW.padL, midL, List.length_cons, List.length_nil, Nat.reduceAdd]

end Mid

