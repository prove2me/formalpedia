/-! # Elementary facts about the Schwarzschild coordinate domains -/

open Real

namespace ExactVacuumAtlas.Schwarzschild

theorem domStd_D {M : ℝ} {x : Pt 4} (hx : x ∈ domStd M) : x 1 - 2 * M ≠ 0 :=
  sub_ne_zero.mpr hx.2.1

theorem isOpen_domStd (M : ℝ) : IsOpen (domStd M) := by
  have h1 : IsOpen {x : Pt 4 | 0 < x 1} := isOpen_lt continuous_const (continuous_apply 1)
  have h2 : IsOpen {x : Pt 4 | x 1 ≠ 2 * M} := isOpen_ne_fun (continuous_apply 1) continuous_const
  have h3 : IsOpen {x : Pt 4 | 0 < x 2} := isOpen_lt continuous_const (continuous_apply 2)
  have h4 : IsOpen {x : Pt 4 | x 2 < π} := isOpen_lt (continuous_apply 2) continuous_const
  exact h1.inter (h2.inter (h3.inter h4))

end ExactVacuumAtlas.Schwarzschild

