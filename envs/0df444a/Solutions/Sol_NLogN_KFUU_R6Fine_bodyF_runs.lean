section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- `i := i · 2^m`. -/
theorem shlN_runs {i j : Fin HS} (hij : i ≠ j) (t : IState HS) {a m : ℕ} {Li Lj : List Item}
    (hi : t.G i = .int (a : ℤ) :: Li) (hj : t.G j = .int ((2 ^ m : ℕ) : ℤ) :: Lj) :
    IRuns I iprog (.op (.shl i j)) t (t.upd i (.int ((a * 2 ^ m : ℕ) : ℤ) :: Li)) (200 * (m + 1)) := by
  have hj' : t.G j = .int ((2 : ℤ) ^ m) :: Lj := by rw [hj]; push_cast; rfl
  have h1 := IRuns.shl (I := I) (iprog := iprog) hij hi hj'
  refine h1.mono' (by push_cast; rfl) (shlCost_le m)

