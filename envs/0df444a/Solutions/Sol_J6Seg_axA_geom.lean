namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function
open IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf

/-- `2^h ≥ 512 p` for large `n`. -/
theorem t_big (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → 512 * pP6 P n ≤ 2 ^ hN6 P n := by
  obtain ⟨n₂, hE⟩ := ell_big P hP (P.x + 14)
  refine ⟨n₂, fun n hn => ?_⟩
  have E := hE n hn
  set b := bP6 n with hb
  set m := Nat.log 2 b with hm
  have hb1 : 1 ≤ b := bP6_pos n
  have hbm : b < 2 ^ (m + 1) := Nat.lt_pow_succ_log_self (by norm_num) b
  have hp : pP6 P n ≤ 6 * 2 ^ ((m + 1) * (1 + P.x)) := by
    have e : pP6 P n = 6 * b ^ (1 + P.x) := rfl
    rw [e, pow_mul]
    exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hbm.le _)
  have hsq : (m + 1) ≤ (m + 1) ^ 2 := by nlinarith
  have hl : (m + 1) * (1 + P.x) + 13 ≤ ℓP6 P n := by
    have : (P.x + 14) * (m + 1) ≤ (P.x + 14) * (m + 1) ^ 2 := Nat.mul_le_mul_left _ hsq
    nlinarith
  have hh : (m + 1) * (1 + P.x) + 12 ≤ hN6 P n := by unfold hN6; omega
  calc 512 * pP6 P n ≤ 512 * (6 * 2 ^ ((m + 1) * (1 + P.x))) := Nat.mul_le_mul_left _ hp
    _ ≤ 2 ^ 12 * 2 ^ ((m + 1) * (1 + P.x)) := by
        have : 0 < 2 ^ ((m + 1) * (1 + P.x)) := by positivity
        norm_num; omega
    _ = 2 ^ ((m + 1) * (1 + P.x) + 12) := by ring
    _ ≤ 2 ^ hN6 P n := Nat.pow_le_pow_right (by norm_num) hh

theorem pow2_dvd_tF6' (P : Prm) (n j e : ℕ) (he : 2 ^ e ≤ tF6 P n j) : 2 ^ e ∣ tF6 P n j := by
  unfold tF6 at he ⊢
  split_ifs at he ⊢
  · rw [← pow_succ] at he ⊢
    exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)
  · exact Nat.pow_dvd_pow 2 ((Nat.pow_le_pow_iff_right (by norm_num)).1 he)

end J6Seg
end

