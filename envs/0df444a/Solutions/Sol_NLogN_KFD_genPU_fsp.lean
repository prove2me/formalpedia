  set R : KS := {K with w := v :: rest, a := A0, c := Z0, o := sv :: O0}
  have h14 : toF R 14 = v :: rest := rfl
  have h12 : toF R 12 = sv :: O0 := rfl
  have hc : (mAdd Q (.reg 14) (.reg 12)).Clean :=
    mAdd_clean Q (clean_reg (by decide)) (clean_reg (by decide))
  have p1 := Sp.push s (toF R) (i := 11) (e := mAdd Q (.reg 14) (.reg 12)) (B := Bb) (by decide) hc
