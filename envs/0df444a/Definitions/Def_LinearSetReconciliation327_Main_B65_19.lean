  · exact padeWritable_le_rootComputeWritable R U D C TB cap addr h

/-- The factor is read from the old queue, while writes stay inside the next
queue.  The conditional footprint has no queue write on a constant factor. -/
theorem queue_keep_writable_le_node (R U D C TB cap QB T n degree addr : ℕ)
    (hroom : 0 < degree → n < T)
    (h : queueKeepWritable QB n cap degree addr) : rootNodeWritable R U D C TB cap QB T addr := by
  by_cases hp : 0 < degree
  · have hn := hroom hp
    have hm : (n + 1) * cap ≤ T * cap := Nat.mul_le_mul_right cap (Nat.succ_le_of_lt hn)
    dsimp [queueKeepWritable] at h
    rcases h with h1 | h1 | h1 | h1 | h1 | h1
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_90
    · obtain ⟨-, hlo, hhi⟩ := h1
      have h3 : n * cap + cap ≤ T * cap := by
        rw [show n * cap + cap = (n + 1) * cap by ring]
        exact hm
      have h4 : addr < QB + T * cap := by
        calc addr < QB + n * cap + cap := hhi
          _ = QB + (n * cap + cap) := by ring
          _ ≤ QB + T * cap := Nat.add_le_add_left h3 QB
      exact rootNodeWritable.of_queue (le_trans (Nat.le_add_right QB (n * cap)) hlo) h4
  · dsimp [queueKeepWritable] at h
    rcases h with h1 | h1 | h1 | h1 | h1 | h1
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_compute (rootComputeWritable.of_meta (by norm_num [rootComputeMeta]))
    · subst h1
      exact rootNodeWritable.of_90
    · obtain ⟨hpos, -, -⟩ := h1
      exact absurd hpos hp

theorem RootPersistent.of_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L src QB T : ℕ}
    {f : F[X]} {a : F} {m m' : ℕ → ℕ} (h : RootPersistent b R U D C TB ZB cap L src f a m)
    (hl : RootWorkspace R U D C TB ZB cap) (hQB : 128 ≤ QB)
    (hZQ : QB + T * cap ≤ ZB ∨ ZB + cap ≤ QB)
    (hSrc : ∀ i < cap, ¬ rootNodeWritable R U D C TB cap QB T (src + i))
    (hf : MemoryFrame (rootNodeWritable R U D C TB cap QB T) m m') :
    RootPersistent b R U D C TB ZB cap L src f a m' := by
  have hmeta (slot : ℕ) (hs : slot < 128) (hn : ¬ rootNodeMeta slot) : m' slot = m slot :=
    hf slot (hl.meta_readonly hQB slot hs hn)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
    h.factor.of_frame hf hSrc, h.zero.of_frame hf (hl.node_zero_readonly hZQ)⟩
  · exact (hmeta 76 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.length
  · exact (hmeta 77 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.dimension
  · exact (hmeta 78 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.unit
  · exact (hmeta 81 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.capacity
  · exact (hmeta 96 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.scalar
  · exact (hmeta 99 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.source
  · exact (hmeta 102 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedR
  · exact (hmeta 103 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedD
  · exact (hmeta 104 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedU
  · exact (hmeta 105 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedC
  · exact (hmeta 106 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedT
  · exact (hmeta 108 (by norm_num) (by norm_num [rootNodeMeta, rootComputeMeta])).trans h.fixedZ

/-- Computation-only frames are sufficient before either queue append. -/
theorem RootPersistent.of_compute_frame {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    {b : Module.Basis (Fin w) (ZMod 2) F} {R U D C TB ZB cap L src : ℕ}
    {f : F[X]} {a : F} {m m' : ℕ → ℕ} (h : RootPersistent b R U D C TB ZB cap L src f a m)
    (hl : RootWorkspace R U D C TB ZB cap) (hsrc : 128 ≤ src)
    (hSrc : ∀ i < cap, ¬ rootComputeWritable R U D C TB cap (src + i))
    (hf : MemoryFrame (rootComputeWritable R U D C TB cap) m m') :
    RootPersistent b R U D C TB ZB cap L src f a m' := by
  apply h.of_frame (QB := ZB + cap) (T := 0) hl (by have h' := hl.Zlow; omega) (Or.inr le_rfl) ?_
    (hf.mono (by intro addr ha; exact Or.inr (Or.inl ha)))
  intro i hi hbad
  rcases hbad with h90 | hwork | hqueue
  · omega
  · exact hSrc i hi hwork
  · simp only [Nat.zero_mul, Nat.add_zero] at hqueue
    omega

/-- Copy a work row while retaining all immutable root-node arguments.  The
precise single-array frame is retained for the other live work rows. -/
theorem rootCopy_spec {F : Type} [Field F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L rootSrc dstSlot srcSlot dst src : ℕ) (f q : F[X]) (a : F) (m : ℕ → ℕ)
    (hAt : At P pc (Stmt.compile (copyFromSlotsProcedure dstSlot srcSlot) pc))
    (hl : RootWorkspace R U D C TB ZB cap) (hp : RootPersistent b R U D C TB ZB cap L rootSrc f a m)
    (hrootSrc : 128 ≤ rootSrc)
    (hSrc : ∀ i < cap, ¬ rootComputeWritable R U D C TB cap (rootSrc + i))
    (hd : dst = R ∨ dst = U ∨ dst = D ∨ dst = C ∨ dst = TB)
    (hmeta : (81 : ℕ) < 2 ^ E.W) (hds : dstSlot < 2 ^ E.W) (hss : srcSlot < 2 ^ E.W)
    (hwe : w ≤ E.W) (hcap : 1 ≤ cap) (hsrc : 128 ≤ src)
    (hDstWord : dst + cap ≤ 2 ^ E.W) (hSrcWord : src + cap ≤ 2 ^ E.W)
    (hdisj : src + cap ≤ dst ∨ dst + cap ≤ src) (hq : PolynomialStored b m src cap q)
    (hmd : m dstSlot = dst) (hms : m srcSlot = src) :
    Sem P E pc (pc + 70) (boundaryState pc m)
      (fun k z => k ≤ 12 * cap + 60 ∧ ∃ m', z = boundaryState (pc + 70) m' ∧
        PolynomialStored b m' dst cap q ∧ RootPersistent b R U D C TB ZB cap L rootSrc f a m' ∧
        MemoryFrame (copyFromSlotsWritable dst cap) m m') := by
  have hdstLow : 128 ≤ dst := by
    have hR := hl.rows.Rlow
    have hU := hl.rows.Ulow
    have hD := hl.rows.Dlow
    have hC := hl.rows.Clow
    have hT := hl.Tlow
    omega
  have hCopy := copyFromSlots_spec b P E pc dstSlot srcSlot dst src cap q m hAt
    hmeta hds hss hwe hcap hdstLow hsrc hDstWord hSrcWord hdisj hq hmd hms hp.capacity
  refine Sem.mono hCopy ?_
  intro k z hQ
  obtain ⟨hk, m', hz, hq', hf⟩ := hQ
  have hcomp := hf.mono (hl.copy_writable hd)
  exact ⟨hk, m', hz, hq', hp.of_compute_frame hl hrootSrc hSrc hcomp, hf⟩

theorem resetRootMemory_frame (m : ℕ → ℕ) (R U D C TB cap : ℕ) :
    MemoryFrame (rootComputeWritable R U D C TB cap) m (resetRootMemory m R U D C) := by
  apply MemoryFrame.trans (MemoryFrame.trans (MemoryFrame.trans
    (MemoryFrame.update_allowed _ m 72 R (by simp [rootComputeWritable, rootComputeMeta]))
    (MemoryFrame.update_allowed _ _ 73 U (by simp [rootComputeWritable, rootComputeMeta])))
    (MemoryFrame.update_allowed _ _ 74 D (by simp [rootComputeWritable, rootComputeMeta])))
    (MemoryFrame.update_allowed _ _ 75 C (by simp [rootComputeWritable, rootComputeMeta]))

theorem keepFactor_positive {F : Type} [Field F] (f : F[X]) : ∀ g ∈ keepFactor f, 0 < g.natDegree := by
  intro g hg
  obtain ⟨heq, hne⟩ := (mem_keepFactor g f).mp hg
  rw [heq]
  exact Nat.pos_of_ne_zero hne

theorem frontier_append_keep_positive {F : Type} [Field F] (fs : List F[X]) (f : F[X])
    (hfs : ∀ g ∈ fs, 0 < g.natDegree) : ∀ g ∈ fs ++ keepFactor f, 0 < g.natDegree := by
  intro g hg
  rcases List.mem_append.mp hg with hleft | hright
  · exact hfs g hleft
  · exact keepFactor_positive f g hright

/-- The two gcd children fit even when the first child consumes the last
available queue slot; a constant second child does not occupy a slot. -/
theorem frontier_children_room {F : Type} [Field F] [DecidableEq F]
    (f p : F[X]) (fs : List F[X]) (T : ℕ) (hf : f ≠ 0)
    (hfs : ∀ g ∈ fs, 0 < g.natDegree) (hbudget : frontierMass fs + f.natDegree ≤ T) :
    (0 < (EuclideanDomain.gcd f p).natDegree → fs.length < T) ∧
    (0 < (EuclideanDomain.gcd f (p - 1)).natDegree → (fs ++ keepFactor (EuclideanDomain.gcd f p)).length < T) ∧
    frontierMass (fs ++ keepFactor (EuclideanDomain.gcd f p) ++ keepFactor (EuclideanDomain.gcd f (p - 1))) ≤ T := by
  have hsplit := split_degree_budget f p hf
  have hzero0 := Nat.zero_le (EuclideanDomain.gcd f p).natDegree
  have hzero1 := Nat.zero_le (EuclideanDomain.gcd f (p - 1)).natDegree
  have hlen := frontier_length_le_mass fs hfs
  have hlen' := frontier_length_le_mass (fs ++ keepFactor (EuclideanDomain.gcd f p))
    (frontier_append_keep_positive fs _ hfs)
  rw [frontierMass_append, frontierMass_keep] at hlen'
  refine ⟨by intro h; omega, by intro h; omega, ?_⟩
  rw [frontierMass_append, frontierMass_append, frontierMass_keep, frontierMass_keep]
  omega

/-- An already reduced splitter can enter the Euclidean routine in reversed
order without introducing a unit ambiguity in its exact gcd. -/
theorem gcd_swap_of_natDegree_lt {F : Type} [Field F] [DecidableEq F]
    (f p : F[X]) (hf : f ≠ 0) (hdeg : p.natDegree < f.natDegree) :
    EuclideanDomain.gcd f p = EuclideanDomain.gcd p f := by
  have hd : p.degree < f.degree := by
    by_cases hp : p = 0
    · simp [hp, Polynomial.degree_eq_natDegree hf]
    · rw [Polynomial.degree_eq_natDegree hp, Polynomial.degree_eq_natDegree hf]
      exact_mod_cast hdeg
  rw [EuclideanDomain.gcd_val f p, (Polynomial.mod_eq_self_iff hf).mpr hd]

