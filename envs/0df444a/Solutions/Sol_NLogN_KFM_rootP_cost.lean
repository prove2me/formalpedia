    (rootB m rv rd).cost (lpSt s NLogN.KFM.sI rd La v k c) ≤ (m + 2) * 10 ^ 9 * (Bv v + m + 2) ^ 2 := by
  obtain ⟨hv56, hd56, -, vI, vY, vJ, dI, dY, dJ, vd⟩ := h
  set B := Bv v + m with hB
  have hzB : ∀ z : ℤ, -(((v : ℤ) + 1) ^ 2) ≤ z → z ≤ ((v : ℤ) + 1) ^ 2 → zsz z ≤ B := fun z h1 h2 =>
    le_trans (zsz_le_Bv v z h1 h2) (by omega)
  have hv0 : (0 : ℤ) ≤ v := by positivity
  set u := lpSt s NLogN.KFM.sI rd La v k c with hu
  have uI : u.G NLogN.KFM.sI = .int ((v : ℤ) - k) :: s.G sI := lpSt_G_i _ _ _ _ _ _ _ (Ne.symm dI)
  have uD : u.G rd = .int c :: La := lpSt_G_a _ _ _ _ _ _ _
  have uV : u.G rv = .int (v : ℤ) :: LV := by rw [hu, lpSt_G_ne _ _ _ _ _ _ _ _ vI vd, hV]
  have uY : u.G sY = s.G sY := lpSt_G_ne _ _ _ _ _ _ _ _ (by decide) (Ne.symm dY)
  have ex : ((v : ℤ) - k) = ((v - k : ℕ) : ℤ) := by push_cast [hk.le]; ring
  set u1 := u.upd sY (.int ((v - k : ℕ) : ℤ) :: s.G sY) with hu1
  have r1 : (RS.push sY (.reg NLogN.KFM.sI)).run u = u1 := by
    simp only [RS.run, Ex.eval, IState.top_eq uI, uY, ex, hu1]
  have c1 : (RS.push sY (.reg NLogN.KFM.sI)).cost u ≤ 2 * 10 ^ 7 * (B + 2) ^ 2 := by
    have := pushCost_le (.reg NLogN.KFM.sI) u B (by
      simp only [Ex.Bnd, IState.top_eq uI]; apply hzB <;> nlinarith)
    simpa [RS.cost, Ex.size] using this
  have u1Y : u1.G sY = .int ((v - k : ℕ) : ℤ) :: s.G sY := by simp [hu1]
  have u1V : u1.G rv = .int (v : ℤ) :: LV := by simp [hu1, IState.upd_G, vY, uV]
  obtain ⟨k2, r2⟩ := satLoop_run rv hv56 vJ vY u1 v (v - k) (s.G sY) LV u1Y u1V (by omega) m
  -- inner loop cost
  have c2 : (RS.rep sJ (.lit (m : ℤ)) (.asg sY (satE rv))).cost u1 ≤
      (m + 1) * (25 * 10 ^ 7 * (B + 2) ^ 2) + 100 := by
    have hcap : (1 : ℤ) ≤ (v : ℤ) + 1 := by omega
    have hgl := genLoop_cost sJ sY (.lit (m : ℤ)) (.asg sY (satE rv)) u1 m (satG ((v : ℤ) + 1))
      ((v - k : ℕ) : ℤ) (s.G sY) (by decide) (by decide) (by intro j hj; simp [Ex.regs] at hj) trivial
      (by simp [Ex.eval]) (by simp [RS.writes]; decide) u1Y
      (by
        intro k' hk'
        set w := lpSt u1 sJ sY (s.G sY) m k' (accSeq (satG ((v : ℤ) + 1)) ((v - k : ℕ) : ℤ) k')
        have wY : w.G sY = .int (accSeq (satG ((v : ℤ) + 1)) ((v - k : ℕ) : ℤ) k') :: s.G sY :=
          lpSt_G_a _ _ _ _ _ _ _
        have wV : w.G rv = .int (v : ℤ) :: LV := by
          simp only [w]; rw [lpSt_G_ne _ _ _ _ _ _ _ _ vJ vY, u1V]
        refine ⟨⟨by decide, satE_clean hv56, ?_, IState.isInt_of wY⟩, ?_⟩
        · simp only [satE, Ex.ok]
          refine ⟨⟨⟨IState.isInt_of wV, trivial⟩, IState.isInt_of wY, IState.isInt_of wY⟩, ?_⟩
          split_ifs
          · exact ⟨IState.isInt_of wV, trivial⟩
          · exact ⟨IState.isInt_of wY, IState.isInt_of wY⟩
        · simp only [RS.run, wY, List.tail_cons]
          congr 2
          simp only [satE, Ex.eval, IState.top_eq wY, IState.top_eq wV, satG, sub_eq_add_neg])
      B (25 * 10 ^ 7 * (B + 2) ^ 2 - 4 * 10 ^ 7 * (B + 2) ^ 2 - 30)
      (by have := zsz_natCast_le_self' m; omega) (by unfold Bv at hB; omega) (by
        simp only [Ex.Bnd]; have := zsz_natCast_le_self' m; omega)
      (by
        intro k' hk'
        set w := lpSt u1 sJ sY (s.G sY) m k' (accSeq (satG ((v : ℤ) + 1)) ((v - k : ℕ) : ℤ) k')
        have hacc := accSeq_satSq ((v : ℤ) + 1) hcap ((v - k : ℕ) : ℤ) (by positivity)
          (by push_cast [hk.le]; omega) k'
        have wY : w.G sY = .int (accSeq (satG ((v : ℤ) + 1)) ((v - k : ℕ) : ℤ) k') :: s.G sY :=
          lpSt_G_a _ _ _ _ _ _ _
        have wV : w.G rv = .int (v : ℤ) :: LV := by
          simp only [w]; rw [lpSt_G_ne _ _ _ _ _ _ _ _ vJ vY, u1V]
        set a := accSeq (satG ((v : ℤ) + 1)) ((v - k : ℕ) : ℤ) k' with ha
        have ha0 : 0 ≤ a := by rw [hacc]; exact le_min (by positivity) (by omega)
        have ha1 : a ≤ (v : ℤ) + 1 := by rw [hacc]; exact min_le_right _ _
        have hb := satE_bnd rv w v a ha0 ha1 (IState.top_eq wV) (IState.top_eq wY)
        have := asgCost_le sY (satE rv) w B (Ex.Bnd_mono w (by omega) _ hb)
          (by rw [IState.top_eq wY]; apply hzB <;> nlinarith)
        have hs : (satE rv).size = 15 := rfl
        simp only [RS.cost]
        rw [hs] at this
        have : 30 ≤ 4 * 10 ^ 7 * (B + 2) ^ 2 := by nlinarith
        omega)
    have hsz : (Ex.lit (m : ℤ) : Ex HS).size = 1 := rfl
    rw [hsz] at hgl
    have h30 : 30 ≤ 4 * 10 ^ 7 * (B + 2) ^ 2 := by nlinarith
    have e : 25 * 10 ^ 7 * (B + 2) ^ 2 - 4 * 10 ^ 7 * (B + 2) ^ 2 - 30 + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30 =
        25 * 10 ^ 7 * (B + 2) ^ 2 := by omega
    rw [e] at hgl
    nlinarith
  set y := min (((v - k : ℕ) : ℤ) ^ (2 ^ m)) ((v : ℤ) + 1) with hy
  have hy0 : 0 ≤ y := le_min (by positivity) (by omega)
  have hy1 : y ≤ (v : ℤ) + 1 := min_le_right _ _
  set u2 := u1.upd sY (.int y :: s.G sY) with hu2
  have u2D : u2.G rd = .int c :: La := by simp [hu2, hu1, IState.upd_G, dY, uD]
  have u2V : u2.G rv = .int (v : ℤ) :: LV := by simp [hu2, hu1, IState.upd_G, vY, uV]
  have u2Y : u2.G sY = .int y :: s.G sY := by simp [hu2]
  set e : Ex HS := .add (.reg rd) (.sel (.add (.reg rv) (.neg (.reg sY))) (.lit 0) (.lit 1)) with he
  have c3 : (RS.asg rd e).cost u2 ≤ 10 * 10 ^ 7 * (B + 2) ^ 2 := by
    have hb : e.Bnd u2 B := by
      simp only [he, Ex.Bnd, Ex.eval, IState.top_eq u2D, IState.top_eq u2V, IState.top_eq u2Y]
      split_ifs <;> constructorm* _ ∧ _ <;> first | (apply hzB <;> nlinarith) | simp [zsz_zero, zsz_one]
      all_goals omega
    have := asgCost_le rd e u2 B hb (by rw [IState.top_eq u2D]; apply hzB <;> nlinarith)
    have hs : e.size = 9 := rfl
    simp only [RS.cost]; rw [hs] at this; omega
  set u3 := u2.upd rd (.int (c + rootInd m v (v - k)) :: La) with hu3
  have u3Y : u3.G sY = .int y :: s.G sY := by simp [hu3, IState.upd_G, Ne.symm dY, u2Y]
  have c4 : (RS.pop sY).cost u3 ≤ 2 * B + 2 := by
    simp only [RS.cost, IState.top_eq u3Y]
    have : zsz y ≤ B := hzB y (by nlinarith) (by nlinarith)
    omega
  have r3 : (RS.asg rd e).run u2 = u3 := by
    simp only [RS.run, he, Ex.eval, IState.top_eq u2D, IState.top_eq u2V, IState.top_eq u2Y, u2D,
      List.tail_cons, hu3]
    rw [hy, rootInd_eq]
  have hcost : (rootB m rv rd).cost u = (RS.push sY (.reg NLogN.KFM.sI)).cost u +
      ((RS.rep sJ (.lit (m : ℤ)) (.asg sY (satE rv))).cost ((RS.push sY (.reg NLogN.KFM.sI)).run u) +
        ((RS.asg rd e).cost ((RS.rep sJ (.lit (m : ℤ)) (.asg sY (satE rv))).run
            ((RS.push sY (.reg NLogN.KFM.sI)).run u)) +
          (RS.pop sY).cost ((RS.asg rd e).run ((RS.rep sJ (.lit (m : ℤ)) (.asg sY (satE rv))).run
            ((RS.push sY (.reg NLogN.KFM.sI)).run u))))) := rfl
  rw [hcost, r1, r2, r3]
  have h1 : (B + 2) ^ 2 ≥ 1 := Nat.one_le_pow _ _ (by omega)
  have h2 : B ≤ (B + 2) ^ 2 := by nlinarith
  have e2 : Bv v + m + 2 = B + 2 := by omega
  rw [e2]
  nlinarith

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFM
open IntMul RS
theorem solution (m : ℕ) (rv rd : Fin NLogN.HS) (h : NLogN.KFM.RootRegs rv rd) (s : NLogN.IState NLogN.HS) (v : ℕ)
    (LV : List NLogN.Item) (hV : s.G rv = .int (v : ℤ) :: LV) :
    (NLogN.KFM.rootP m rv rd).cost s ≤ (v + 1) * (m + 3) * 10 ^ 9 * (NLogN.KFM.Bv v + m + 2) ^ 2 := by
  have hR := h
  obtain ⟨hv56, hd56, -, vI, vY, vJ, dI, dY, dJ, vd⟩ := h
  set B := NLogN.KFM.Bv v + m with hB
  set s1 := s.upd rd (.int 0 :: s.G rd) with hs1
  have r1 : (NLogN.RS.push rd (.lit 0)).run s = s1 := by simp [NLogN.RS.run, NLogN.Ex.eval, hs1]
  have s1V : s1.G rv = .int (v : ℤ) :: LV := by simp [hs1, NLogN.IState.upd_G, vd, hV]
  have hB1 : 1 ≤ B := by simp only [hB, NLogN.KFM.Bv]; omega
  have hzv : NLogN.zsz (v : ℤ) ≤ B := by
    have := NLogN.KFM.zsz_le_Bv v v (by nlinarith) (by nlinarith); omega
  have c1 : (NLogN.RS.push rd (.lit 0)).cost s ≤ 2 * 10 ^ 7 * (B + 2) ^ 2 := by
    have := NLogN.RS.pushCost_le (.lit 0) s B (by simp [NLogN.Ex.Bnd, NLogN.zsz_zero])
    simpa [NLogN.RS.cost, NLogN.Ex.size] using this
  have c2 := NLogN.KFM.genLoop_cost NLogN.KFM.sI rd (.reg rv) (NLogN.KFM.rootB m rv rd) s1 v (NLogN.KFM.sumG (NLogN.KFM.rootInd m v) v) 0 (s.G rd)
    (Ne.symm dI) (by decide)
    (by intro j hj; simp [NLogN.Ex.regs] at hj; subst hj
        simp only [NLogN.zX_all, List.mem_cons, List.not_mem_nil, or_false]
        intro hh; rcases hh with hh | hh | hh | hh | hh | hh | hh | hh <;>
          (rw [hh] at hv56; exact absurd hv56 (by decide)))
    (NLogN.IState.isInt_of s1V) (by simp [NLogN.Ex.eval, NLogN.IState.top_eq s1V])
    (by simp (config := {decide := true}) [NLogN.KFM.rootB, NLogN.RS.writes, Ne.symm dI]) (by simp [hs1])
    (fun k hk => NLogN.KFM.rootB_run m rv rd hR s1 v LV (s.G rd) s1V k hk _)
    B ((m + 2) * 10 ^ 9 * (NLogN.KFM.Bv v + m + 2) ^ 2) hzv hB1
    (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq s1V]; exact hzv)
    (fun k hk => by
      have hb := NLogN.KFM.accSeq_rootInd_bounds m v k hk.le
      exact NLogN.KFM.rootB_cost m rv rd hR s1 v LV (s.G rd) s1V k hk _ hb.1 (by have := hb.2; omega))
  have hcost : (NLogN.KFM.rootP m rv rd).cost s = (NLogN.RS.push rd (.lit 0)).cost s +
      (NLogN.RS.rep NLogN.KFM.sI (.reg rv) (NLogN.KFM.rootB m rv rd)).cost ((NLogN.RS.push rd (.lit 0)).run s) := rfl
  rw [hcost, r1]
  have hsz : (NLogN.Ex.reg rv : NLogN.Ex NLogN.HS).size = 1 := rfl
  rw [hsz] at c2
  have e2 : NLogN.KFM.Bv v + m + 2 = B + 2 := by omega
  rw [e2] at c2 ⊢
  have h1 : (B + 2) ^ 2 ≥ 1 := Nat.one_le_pow _ _ (by omega)
  nlinarith
end
