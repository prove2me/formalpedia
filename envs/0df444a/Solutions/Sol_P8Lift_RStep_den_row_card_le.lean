variable {R : Type} [Fintype R] [DecidableEq R] {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

/-- **Sparsity of the local steps.** Every local step has at most `|R|` nonzero entries per
row (gates), and the other local steps at most one (monomial matrices). -/
theorem den_row_card_le_sol_aux (T : Op κ) (st : RStep R m) (hst : st.isChild = false)
    (p : R × Addr m κ) : (rowSupp (st.den T) p).card ≤ Fintype.card R := by
  have one : ∀ (q₀ : R × Addr m κ) (A : ROp R m κ), (∀ q, A p q ≠ 0 → q = q₀) →
      (rowSupp A p).card ≤ Fintype.card R := by
    intro q₀ A hA
    calc (rowSupp A p).card ≤ ({q₀} : Finset _).card := by
          apply card_le_card
          intro q hq
          simp only [rowSupp, mem_filter] at hq
          simp [hA q hq.2]
      _ = 1 := card_singleton _
      _ ≤ Fintype.card R := Fintype.card_pos_iff.2 ⟨p.1⟩
  cases st with
  | gate G =>
    calc (rowSupp _ p).card ≤ (univ.image fun r : R => (r, p.2)).card := by
          apply card_le_card
          intro q hq
          simp only [rowSupp, mem_filter, den] at hq
          simp only [mem_image, mem_univ, true_and]
          refine ⟨q.1, ?_⟩
          by_cases h : p.2 = q.2
          · rw [h]
          · simp [h] at hq
      _ ≤ Fintype.card R := card_image_le
  | rowAdd w i j hij =>
    refine one (p.1, if p.1 = w then rowAddr i j p.2 else p.2) _ fun q hq => ?_
    obtain ⟨q1, q2⟩ := q
    simp only [den] at hq
    by_cases h1 : p.1 = q1
    · rw [if_pos h1] at hq
      by_cases h2 : p.1 = w
      · rw [if_pos h2] at hq
        by_cases h3 : q2 = rowAddr i j p.2
        · rw [if_pos h2]; exact Prod.ext h1.symm h3
        · exact absurd (if_neg h3) hq
      · rw [if_neg h2] at hq
        by_cases h3 : p.2 = q2
        · rw [if_neg h2]; exact Prod.ext h1.symm h3.symm
        · exact absurd (if_neg h3) hq
    · exact absurd (if_neg h1) hq
  | phase w k₀ k₁ a =>
    refine one p _ fun q hq => ?_
    simp only [den, diagonal_apply] at hq
    by_contra h; exact hq (if_neg (Ne.symm h))
  | perm σ =>
    refine one (σ.symm p.1, p.2) _ fun q hq => ?_
    simp only [den] at hq
    split_ifs at hq with h
    · obtain ⟨h1, h2⟩ := h
      exact Prod.ext (by simp [h1]) h2.symm
    · exact absurd rfl hq
  | child w h fwd => simp [isChild] at hst

end RStep

