lemma isCoprime_of_checkBez {M : Poly1009} {d : ℕ} {Q : Poly1009} {uv : Poly1009 × Poly1009}
    (h : checkBez M d Q uv = true) : IsCoprime (toPoly M) (toPoly Q) := by
  rw [checkBez] at h
  exact isCoprime_of_bezout_congr (pmodRec_congr _ M d Q) h

lemma toPoly_coeff_getD (a : Poly1009) (n : ℕ) : (toPoly a).coeff n = a.getD n 0 := by
  induction a generalizing n with
  | nil => simp [toPoly]
  | cons x xs ih =>
    cases n with
    | zero => simp [toPoly]
    | succ m =>
      simp only [toPoly, Polynomial.coeff_add, Polynomial.coeff_C_succ, zero_add,
        Polynomial.coeff_X_mul, ih m, List.getD_cons_succ]

lemma toPoly_natDegree_le_length_sub_one (a : Poly1009) : (toPoly a).natDegree ≤ a.length - 1 := by
  rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
  intro n hn
  rw [toPoly_coeff_getD]
  have hle : a.length ≤ n := by omega
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hle]

lemma cb_h_m_list_monic : (toPoly cb_h_m_list).Monic ∧ (toPoly cb_h_m_list).natDegree = 2 := by
  have hle : (toPoly cb_h_m_list).natDegree ≤ 2 := toPoly_natDegree_le_length_sub_one cb_h_m_list
  have hc : (toPoly cb_h_m_list).coeff 2 = 1 := by rw [toPoly_coeff_getD]; decide
  have hge : 2 ≤ (toPoly cb_h_m_list).natDegree := Polynomial.le_natDegree_of_ne_zero (by rw [hc]; decide)
  have hdeg : (toPoly cb_h_m_list).natDegree = 2 := le_antisymm hle hge
  exact ⟨by rw [Polynomial.Monic, Polynomial.leadingCoeff, hdeg, hc], hdeg⟩

