-- title:
--   Finite generation from monomial relations in a homogeneous tail
-- statement:
--   For positive rational weights and a family of polynomials homogeneous in one common positive degree, if every monomial in the sufficiently high weighted-homogeneous tail belongs to the ideal generated by that family, then the polynomial ring is finite as a module over the algebra generated by the family.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_adjoin_of_homogeneous_monomial_tail
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : ℝ))
    (D : Nat) (hD : 0 < D)
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) (D : ℚ))
    (B : ℚ)
    (hmono : ∀ (e : Fin d →₀ Nat) (t : ℚ),
      B < t → MvPolynomial.IsWeightedHomogeneous w (MvPolynomial.monomial e (1 : ℂ)) t →
      MvPolynomial.monomial e (1 : ℂ) ∈ Ideal.span (Set.range p)) :
    Module.Finite (Algebra.adjoin ℂ (Set.range p)) (MvPolynomial (Fin d) ℂ) := by sorry
