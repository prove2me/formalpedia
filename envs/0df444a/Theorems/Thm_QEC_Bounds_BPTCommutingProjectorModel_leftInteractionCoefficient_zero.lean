theorem QEC.Bounds.BPTCommutingProjectorModel.leftInteractionCoefficient_zero
    {A B : Type u}
    [NormedAddCommGroup A] [InnerProductSpace Complex A] [Semantics.FiniteQuantumSystem A]
    [NormedAddCommGroup B] [InnerProductSpace Complex B] [Semantics.FiniteQuantumSystem B]
    (a a' : A) :
    leftInteractionCoefficient (0 : Semantics.Operator (Semantics.CompositeSystem A B)) a a' = 0 := by sorry
