private lemma site_trichotomy (a b : ZMod 2 × ZMod 2) :
    a ≠ 0 ↔ ((b ≠ 0 ∧ a = b) ∨ (a ≠ 0 ∧ b ≠ 0 ∧ a ≠ b) ∨ (a ≠ 0 ∧ b = 0)) := by
  revert a b; decide
