-- title:
--   §6.3 unnumbered: redundant binomial ray
-- statement:
--   The second binomial defect has the exact decomposition
--   $$W_M=\tfrac14W_S+\tfrac14(t^2-r_1)(3t^2-r_1).$$
--   Both summands are separability-valid, and the second is already nonnegative on every PSD input. The ray generated by $W_M$ is not extremal in the full degree-four separable tensor cone. The coefficient identity is stated together with its evaluation identity.
--
--   Here $R(X)_{ik,jl}=X_{ij,kl}$ is realignment, $r_k(X)=\operatorname{Tr}[(R(X)R(X)^*)^k]$, and all traces are ordinary unnormalized matrix traces. We write $t=\operatorname{Tr}X$, $X_A=\operatorname{Tr}_B X$, $X_B=\operatorname{Tr}_A X$, $\widetilde X=tX-X_A\otimes X_B$, $\widetilde r_k=r_k(\widetilde X)$, and $G=(t^2-\operatorname{Tr}X_A^2)(t^2-\operatorname{Tr}X_B^2)$. The notation $q_k$ means $\operatorname{Tr}[(X^{\Gamma_B})^k]$, where $\Gamma_B$ transposes the B factor.
-- source:
--   Optimal entanglement criteria from trace invariants, arXiv:2609.29471v1, PDF p. 44, §6.3 unnumbered: redundant binomial ray

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P19

noncomputable section

open scoped BigOperators ENNReal Matrix ComplexConjugate ComplexOrder

open Filter MeasureTheory

namespace QAlgorithms.Papers.Independent.Information100.P19

/-- §6.3 unnumbered: redundant binomial ray; arXiv:2609.29471v1, PDF pp.44. -/
theorem binomial_ray_redundant  :
    wM = (1/4 : ℝ) • wS + (1/4 : ℝ) • wRemainder ∧
    wM ∈ sepCone 4 ∧ wS ∈ sepCone 4 ∧ wRemainder ∈ sepCone 4 ∧
    ¬ Extreme (sepCone 4) wM ∧
    (∀ a b, 0<a → 0<b → ∀ X : Bip a b, X.IsHermitian →
      tensorEval wM X = defect 2 X ∧ tensorEval wS X = defect 3 X ∧
      tensorEval wRemainder X = (mass X^2-rMoment X 1)*(3*mass X^2-rMoment X 1)) ∧
    (∀ a b, 0<a → 0<b → ∀ X : Bip a b, X.PosSemidef → 0≤tensorEval wRemainder X) := by sorry

end QAlgorithms.Papers.Independent.Information100.P19

end
