-- title:
--   Lam–Litt conjecture: algebraic ODEs, bounded denominators, $\omega$-integrality
-- statement:
--   Definitions for the Lam–Litt conjecture on algebraic solutions of algebraic differential equations.
--
--   1. **Rational functions.** For a set of variables $\sigma$ and a commutative ring $K$, $K(x_\sigma)$ denotes the fraction field of the polynomial ring $K[x_\sigma]$.
--
--   2. **Solutions of algebraic ODEs.** Let $n\ge 0$, let $f\in\mathbb{Q}[[z]]$ and let $g\in\mathbb{Q}(x_0,x_1,\dots,x_n)$. Write $f^{(i)}$ for the $i$-th formal derivative of $f$. We say that $f$ *solves the algebraic ODE defined by $g$* if there are polynomials $p,q\in\mathbb{Q}[x_0,\dots,x_n]$ with $g=p/q$,
--   $$q\bigl(0,f(0),f'(0),\dots,f^{(n-1)}(0)\bigr)\neq 0,$$
--   and
--   $$f^{(n)}(z)\cdot q\bigl(z,f(z),\dots,f^{(n-1)}(z)\bigr)=p\bigl(z,f(z),\dots,f^{(n-1)}(z)\bigr)\quad\text{in }\mathbb{Q}[[z]].$$
--   In words: $f^{(n)}=g(z,f,f',\dots,f^{(n-1)})$ and $g$ is defined at the initial point $(0,f(0),\dots,f^{(n-1)}(0))$, i.e. $z=0$ is a non-singular point of the equation.
--
--   3. **Bounded denominators.** For $N\in\mathbb{N}$, $\mathbb{Z}[1/N]$ is the subring of $\mathbb{Q}$ generated by $1/N$. A power series $f=\sum_k a_k z^k$ has all coefficients in $\mathbb{Z}[1/N]$ if $a_k\in\mathbb{Z}[1/N]$ for every $k$.
--
--   4. **$\omega$-integrality.** For $\omega:\{\text{primes}\}\to\mathbb{Z}$ and a sequence $(a_j)$ of rationals, $(a_j)$ is $\omega$-integral if for every prime $p$ the numbers $a_0,a_1,\dots,a_{\omega(p)}$ lie in $\mathbb{Z}_{(p)}$, i.e. their reduced denominators are prime to $p$.
--
--   5. **Superlinear growth.** $\omega$ is superlinear if $\omega(p)/p\to\infty$ as $p\to\infty$ through the primes.
--
--   These are the notions in which the Lam–Litt conjecture and its partial results are stated.
--
--   **Formalization Note** In Lean, $1/0=0$, so $\mathbb{Z}[1/0]=\mathbb{Z}$; if $\omega(p)<0$ the $\omega$-integrality condition imposes nothing at $p$. The variable $x_0$ is evaluated at $z$ and $x_{i+1}$ at $f^{(i)}$.
-- source:
--   Formal Conjectures, FormalConjectures/LittProblems/1.lean (Lam--Litt conjecture); Y. H. J. Lam, D. Litt, Algebraicity and integrality of solutions to differential equations, https://arxiv.org/abs/2501.13175; D. Litt, Problem 1, https://www.problemsilike.com/1

import Mathlib

open MvPolynomial PowerSeries

namespace LamLitt

/-- The field of multivariate rational functions in variables indexed by `σ` over `K`:
the fraction field of `MvPolynomial σ K`. -/
abbrev MvRatFunc (σ K : Type*) [CommRing K] := FractionRing (MvPolynomial σ K)

/-- A power series `f` solves the algebraic ODE `f^{(n)} = g(z, f, f', …, f^{(n-1)})`, with `g`
defined at `(0, f(0), …, f^{(n-1)}(0))`: `g = p / q` with `q(0, f(0), …, f^{(n-1)}(0)) ≠ 0` and
`f^{(n)} · q(z, f, …, f^{(n-1)}) = p(z, f, …, f^{(n-1)})`. Variable `0` is `z`, variable
`i.succ` is `f^{(i)}`. -/
def IsSolutionOfAlgebraicODE (n : ℕ) (f : PowerSeries ℚ) (g : MvRatFunc (Fin (n + 1)) ℚ) : Prop :=
  let pt : Fin (n + 1) → PowerSeries ℚ := Fin.cases X (fun i : Fin n ↦ (derivative ℚ)^[i.val] f)
  ∃ p q : MvPolynomial (Fin (n + 1)) ℚ,
    g = (algebraMap _ _ p) / (algebraMap _ _ q) ∧
    q.eval (PowerSeries.constantCoeff ∘ pt) ≠ 0 ∧
    (derivative ℚ)^[n] f * MvPolynomial.aeval pt q = MvPolynomial.aeval pt p

/-- The subring `ℤ[1/N]` of `ℚ` (for `N = 0` this is `ℤ`, since `1/0 = 0` in Lean). -/
def ℤAdjoinInvNat (N : ℕ) : Subalgebra ℤ ℚ := Algebra.adjoin ℤ {(1 / N : ℚ)}

/-- Every coefficient of `f` lies in `ℤ[1/N]`. -/
def IsCoeffIntegralAdjointInvNat (f : PowerSeries ℚ) (N : ℕ) : Prop :=
  ∀ n : ℕ, coeff n f ∈ ℤAdjoinInvNat N

/-- `ω`-integrality: for each prime `p`, `a_0, …, a_{ω(p)}` have denominators prime to `p`
(no constraint at `p` when `ω(p) < 0`). -/
def omegaIntegral (ω : Nat.Primes → ℤ) (a : ℕ → ℚ) : Prop :=
  ∀ p : Nat.Primes, ∀ j : ℕ, (j : ℤ) ≤ ω p → Nat.Coprime (a j).den p

/-- `ω(p) / p → ∞` as the prime `p → ∞`. -/
def omegaSuperlinear (ω : Nat.Primes → ℤ) : Prop :=
  Filter.Tendsto (fun p : Nat.Primes ↦ (ω p : ℝ) / p)
    (Filter.comap (fun p : Nat.Primes ↦ (p : ℕ)) Filter.atTop) Filter.atTop

end LamLitt


