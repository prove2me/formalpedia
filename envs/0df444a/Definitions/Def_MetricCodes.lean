  MetricCodes.Spherical.OrthogonalPolynomialTransport.polynomialEquiv
    (blockIsometry (r := r) U)
def rowVector {r n : ℕ} (i : Fin (r + 1))
    (v : SpherePacking.Euclidean n) :
    SpherePacking.Euclidean ((r + 1) * n) :=
