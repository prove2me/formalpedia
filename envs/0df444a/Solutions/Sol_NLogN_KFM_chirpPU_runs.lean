theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {Δ φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ Δ + 2 → NLogN.zsz y ≤ Δ + 2 → M.Φ x y ≤ φ) (T : ℕ)
    (L : List (ℕ × ℕ)) (hL : ∀ p ∈ L, p.1 ≤ p.2 ∧ 0 < p.2 ∧ p.2 ≤ T)
    (hu : L.length * (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ ≤ 1)
    (st : NLogN.IState NLogN.HS) (LR L1 LXa RD : List NLogN.Item) (hR : st.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR)
    (hD : st.G NLogN.KFM.rDl = .int (Δ : ℤ) :: L1) (hX : st.G NLogN.KFM.aX = .int (L.length : ℤ) :: LXa)
    (hdS : st.G NLogN.KFM.dS = NLogN.ints (NLogN.KFM.descA 1 L) ++ RD) :
    NLogN.IRuns I iprog (NLogN.KFM.chirpPU pM) st
      ((st.upd NLogN.KFM.dS RD).upd NLogN.KFM.pQ1 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.chirpArrL Δ L)) ++ st.G NLogN.KFM.pQ1)) (NLogN.KFM.cChirpPU Δ φ L) := by
  have hu0 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ Δ := by positivity
  have hnear := NLogN.KFM.chirpArrL_near Δ T L hL hu
  have hGB : ∀ k ≤ L.length, NLogN.KFB.GB (Δ + 2) (NLogN.KFM.chirpArrL Δ (L.take k)) := by
    intro k hk z hz
    refine (hnear k hk z hz).bnd ?_
    refine le_trans ?_ hu
    have hk' : (k : ℝ) ≤ L.length := by exact_mod_cast hk
    have : (0 : ℝ) ≤ (8 * (T : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ Δ := by positivity
    nlinarith
  have k12 := NLogN.KFM.dupR_runs (I := I) (iprog := iprog) NLogN.KFM.pQ1 (by decide) Δ st LR hR
  set s0 := (st.upd NLogN.KFM.pQ1 (.int 0 :: st.G NLogN.KFM.pQ1)).upd NLogN.KFM.pQ1
    (.int (2 ^ Δ) :: (st.upd NLogN.KFM.pQ1 (.int 0 :: st.G NLogN.KFM.pQ1)).G NLogN.KFM.pQ1) with hs0
  let Tk : ℕ → NLogN.IState HS := fun k =>
    (s0.upd NLogN.KFM.dS (NLogN.ints (NLogN.KFM.descA (NLogN.KFM.nK L k) (L.drop k)) ++ RD)).upd NLogN.KFM.pQ1
      (NLogN.ints (NLogN.KFB.gflat (NLogN.KFM.chirpArrL Δ (L.take k))) ++ st.G NLogN.KFM.pQ1)
  have e0 : Tk 0 = s0 := by
    simp only [Tk, NLogN.KFM.nK, List.take_zero, List.drop_zero, List.map_nil, List.prod_nil]
    simp only [hs0]
    simp [NLogN.KFM.chirpArrL, NLogN.KFM.oneP, NLogN.ints, hdS]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
