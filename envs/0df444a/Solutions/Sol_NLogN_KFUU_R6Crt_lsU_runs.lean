      rw [e]; ((apply IState.ext' <;> (try intros) <;> (simp +decide only [IState.upd_G, IState.upd_ip, IState.upd_out, ↓reduceIte]) <;> (try split_ifs) <;> (try subst_vars) <;> (try simp_all +decide)))
