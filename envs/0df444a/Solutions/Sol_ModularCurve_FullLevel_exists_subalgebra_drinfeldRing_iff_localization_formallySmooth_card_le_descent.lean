              have hc'k : ((c' : ↥K₀) : AlgebraicClosure ℚ) ∈ k₀ := (hk₀ _).mpr c'.2
              have e : algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (algebraMap ↥K₀ (AlgebraicClosure ℚ) c') =
                  ((cK ⟨_, hc'k⟩ : ↥F₀) : ↥(fieldBar q M')) := rfl
              rw [e]
              exact (hVt' (cK ⟨_, hc'k⟩)).mpr (hcK ⟨_, hc'k⟩)

            obtain ⟨O', hO'⟩ : ∃ O' : ValuationSubring ↥(modularFunctionFieldBar M'),
