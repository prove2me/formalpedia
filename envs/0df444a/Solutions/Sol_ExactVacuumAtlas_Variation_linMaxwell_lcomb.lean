open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas
open ExactVacuumAtlas.Variation
variable {U : Set (Pt 4)} {g ginv h₁ h₂ : Metric 4} {F f₁ f₂ : TwoForm 4} (c₁ c₂ : ℝ)
variable (hU : IsOpen U) (hg : ∀ i j, ContDiffOn ℝ ∞ (g i j) U) (hgi : ∀ i j, ContDiffOn ℝ ∞ (ginv i j) U)
include hU hg hgi
variable {c₁ c₂} (hh₁ : ∀ i j, ContDiffOn ℝ ∞ (h₁ i j) U) (hh₂ : ∀ i j, ContDiffOn ℝ ∞ (h₂ i j) U)
include hh₁ hh₂
variable (hF : ∀ i j, ContDiffOn ℝ ∞ (F i j) U) (hf₁ : ∀ i j, ContDiffOn ℝ ∞ (f₁ i j) U)
  (hf₂ : ∀ i j, ContDiffOn ℝ ∞ (f₂ i j) U)
include hF
omit hg
include hf₁ hf₂
theorem solution {x : Pt 4} (hx : x ∈ U) (b : Fin 4) :
    linMaxwell g ginv F (lcomb c₁ h₁ c₂ h₂) (lcomb c₁ f₁ c₂ f₂) b x =
      c₁ * linMaxwell g ginv F h₁ f₁ b x + c₂ * linMaxwell g ginv F h₂ f₂ b x := by
  have e0 : ∀ i a b, pd i (raise2Var ginv (lcomb c₁ h₁ c₂ h₂) F (lcomb c₁ f₁ c₂ f₂) a b) x =
      c₁ * pd i (raise2Var ginv h₁ F f₁ a b) x + c₂ * pd i (raise2Var ginv h₂ F f₂ a b) x := by
    intro i a b
    rw [pd_congr_of_eqOn hU hx (fun y _ => raise2Var_lcomb (ginv := ginv) (F := F) c₁ c₂ a b y) i]
    exact pd_lcomb hU (contDiffOn_raise2Var hgi hF hh₁ hf₁ a b)
      (contDiffOn_raise2Var hgi hF hh₂ hf₂ a b) c₁ c₂ hx i
  have e1 := fun a b c => chrVar_lcomb hU hh₁ hh₂ (g := g) (ginv := ginv) (c₁ := c₁) (c₂ := c₂) hx a b c
  simp only [linMaxwell, e0, e1, raise2Var_lcomb]
  simp only [Fin.sum_univ_four]
  ring
