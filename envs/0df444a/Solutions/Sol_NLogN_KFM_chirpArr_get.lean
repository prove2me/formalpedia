theorem oprod_nil (Δ : ℕ) (B : List GI) : oprod Δ [] B = [] := rfl

theorem oprod_cons (Δ : ℕ) (a : GI) (A B : List GI) :
    oprod Δ (a :: A) B = B.map (gmulT Δ a) ++ oprod Δ A B := by
  simp [oprod, List.flatMap_cons]

theorem getElem?_oprod (Δ : ℕ) (B : List GI) {j : ℕ} (hj : j < B.length) :
    ∀ (A : List GI) (i : ℕ),
      (oprod Δ A B)[i * B.length + j]? = (A[i]?).map (fun a => gmulT Δ a B[j])
  | [], i => by simp [oprod_nil]
  | a :: A, 0 => by
    rw [oprod_cons, zero_mul, zero_add, List.getElem?_append_left (by simpa using hj)]
    simp [List.getElem?_eq_getElem hj]
  | a :: A, i + 1 => by
    rw [oprod_cons, List.getElem?_append_right (by simp; nlinarith)]
    have : (i + 1) * B.length + j - (List.map (gmulT Δ a) B).length = i * B.length + j := by
      simp only [List.length_map]; rw [Nat.succ_mul]; omega
    rw [this, getElem?_oprod Δ B hj A i]
    simp

