-- title:
--   Degree of the ℚ(j)-norm of g at Ogg's unit
-- statement:
--   Let $p$ be a prime. Work inside $F =$ `modularFunctionFieldFull p`, the subfield of the Laurent series field $\mathbb{Q}((\mathfrak q))$ generated over $\mathbb{Q}$ by the series $j(\mathfrak q^d)$ for the nonzero divisors $d \mid p$, and let $j =$ `IgusaScheme.jFull p` be the element of $F$ given by the $\mathfrak q$-expansion of the $j$-invariant. Assume the Laurent series $u =$ `modularUnitSeries p`, namely $\Delta(\mathfrak q)\,\Delta(\mathfrak q^{p})^{-1}$ (with $\Delta(\mathfrak q) = \mathfrak q\prod(1-\mathfrak q^{n})^{24}$ built from the Dedekind eta unit power series, and $\Delta(\mathfrak q^p)$ its substitution $\mathfrak q \mapsto \mathfrak q^{p}$), lies in $F$, and let $v \in F$ be either $u$ or $p^{12}u^{-1}$. Let $g \in \mathbb{Z}[T]$ be monic with $\deg g \ge 1$ and $g(0) \ne 0$, and let $N \in \mathbb{Z}[X]$ be a polynomial whose value at $j$ equals the image in $F$ of the norm $\mathrm{N}_{F/\mathbb{Q}(j)}(g(v))$, where $\mathbb{Q}(j)$ is the intermediate field $\mathbb{Q}$-generated by $j$ and the norm is `Algebra.norm` for $F$ over that subfield. Then $\deg N = \deg g \cdot (p-1)$, with $p-1$ taken in $\mathbb{N}$.
--
--   This records the degree of the $\mathbb{Q}(j)$-norm of a monic integral polynomial evaluated at Ogg's modular unit $\Delta(\mathfrak q)/\Delta(\mathfrak q^{p})$ on $X_0(p)$ (or at its Fricke transform $p^{12}/u$), the unit whose divisor is supported on the two cusps with order $\pm(p-1)$. It is used in the construction of the integral polynomial attached to $g(v)$ and in the determination of its leading coefficient, and thence in the rank computation for the quotient by the ideal generated by that evaluation.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_natDegree_eq_mul_of_aeval_jFull_eq_norm_aeval_modularUnitSeries.lean

import Mathlib
import Definitions.Def_ModularCurve_ModularUnit
import Definitions.Def_ModularCurve_IgusaScheme
import Definitions.Def_AlgebraicCurve_TwoChartIntegralModel

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve Polynomial

theorem ModularCurve.natDegree_eq_mul_of_aeval_jFull_eq_norm_aeval_modularUnitSeries
    (p : ℕ) [Fact p.Prime] [NeZero p]
    (hmem : modularUnitSeries p ∈ modularFunctionFieldFull p)
    (v : ↥(ModularCurve.modularFunctionFieldFull p))
    (hv : v = ⟨modularUnitSeries p, hmem⟩ ∨
      v = (p : ↥(ModularCurve.modularFunctionFieldFull p)) ^ 12 * (⟨modularUnitSeries p, hmem⟩)⁻¹)
    (g : Polynomial ℤ) (hg : g.Monic) (hD : 1 ≤ g.natDegree) (h0 : g.coeff 0 ≠ 0)
    (N : Polynomial ℤ)
    (hN : (Polynomial.aeval (IgusaScheme.jFull p) N : ↥(ModularCurve.modularFunctionFieldFull p)) =
      algebraMap ↥(IntermediateField.adjoin ℚ ({IgusaScheme.jFull p} : Set ↥(ModularCurve.modularFunctionFieldFull p))) ↥(ModularCurve.modularFunctionFieldFull p)
        (Algebra.norm ↥(IntermediateField.adjoin ℚ ({IgusaScheme.jFull p} : Set ↥(ModularCurve.modularFunctionFieldFull p))) (Polynomial.aeval v g))) :
    N.natDegree = g.natDegree * (p - 1) := by sorry
