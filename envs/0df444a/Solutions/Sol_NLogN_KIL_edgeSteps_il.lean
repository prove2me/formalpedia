    (NLogN.mvK X Y C n).ok s ∧
      (NLogN.mvK X Y C n).run s = (s.upd X R).upd Y ((ints L).reverse ++ s.G Y) := by
  have H := mvK_states hXY hXC hYC n s L R hX hn
