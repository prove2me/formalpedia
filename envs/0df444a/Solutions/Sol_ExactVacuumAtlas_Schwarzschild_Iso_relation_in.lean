open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable (M : ℝ)
theorem solution (hM : 0 < M) :
    CoordRelation (gIso M) (gStd M) (domIsoIn M) (domStdExt M) (toStd M) (fromStdIn M) (jacIso M) where
  left_inv x hx := fromStdIn_toStd M hM hx
  right_inv y hy := toStd_fromStdIn M hM hy
  bijOn := Set.InvOn.bijOn ⟨fun x hx => fromStdIn_toStd M hM hx, fun y hy => toStd_fromStdIn M hM hy⟩
    (fun _ hx => toStd_mem_in M hM hx) (fun _ hy => fromStdIn_mem M hM hy)
  smooth := contDiffOn_toStd_of M fun y hy => hy.1
  smooth_inv := contDiffOn_fromStdIn M hM.le
  jacobian _ hx k i := hasDerivAt_pd_toStd_in M hM hx k i
  pullback _ hx := pullback M hM.le hx.1 (ne_of_lt hx.2.1)
