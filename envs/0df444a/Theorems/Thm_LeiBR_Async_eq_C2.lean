-- title:
--   (C.2) — one asynchronous update: $\mathbb E\|x_{i,k+1}-x^*_i\| \le \alpha_{i,k} + a_\infty\max_j \mathbb E\|x_{j,k-\tau_{ij}(k)} - x^*_j\|$
-- statement:
--   Let Assumption 1(a)–(b) hold, let $\mu > 0$, let $\hat x$ be the proximal best-response map and $x^*$ a Nash equilibrium, and let $(x_k)$ be generated by Algorithm 3 with deterministic accuracies $\alpha_{i,k} \ge 0$. Then for every time $k$ and every player $i \in I_k$,
--   $$\mathbb E\big[\|x_{i,k+1} - x^*_i\|\big] \le \alpha_{i,k} + a_\infty \max_{j}\mathbb E\big[\|x_{j,k-\tau_{ij}(k)} - x^*_j\|\big].$$
--
--   This one-step recursion couples the error of an updating player to the errors of the outdated strategies it used; Lemma 7 is proved by iterating it over windows of length $B_1$.
--
--   **Formalization Note** The page leaves $\alpha_{i,k} \ge 0$ implicit (in Lemma 7 it is $\eta^{\beta_{i,k}}$); it is assumed here.
-- source:
--   Lei, Shanbhag, Pang & Sen, On Synchronous, Asynchronous, and Randomized Best-Response Schemes for Stochastic Nash Games, arXiv:1704.04578v2, p. 33, App. C, (C.2)

import Mathlib
import Definitions.Def_LeiBR_Async_Game
import Definitions.Def_LeiBR_Async_Model
import Definitions.Def_LeiBR_Async_Algorithm

namespace LeiBR.Async

open MeasureTheory

/-- Inequality (C.2) (App. C, p. 33): along Algorithm 3 with a deterministic accuracy sequence
`α_{i,k} ≥ 0`, for every time `k` and every updating player `i ∈ I_k`,
`E‖x_{i,k+1} − x*_i‖ ≤ α_{i,k} + a_∞ max_j E‖x_{j,k−τ_ij(k)} − x*_j‖`. -/
theorem eq_C2 {Ω : Type*} [mΩ : MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (F : Filtration ℕ mΩ) {N : ℕ} {n : Fin N → ℕ} (X : ∀ i, Set (LeiBR.Sync.Strat n i))
    (f : Fin N → LeiBR.Sync.Profile n → ℝ) (hA1 : Assumption1ab X f) (μ : ℝ) (hμ : 0 < μ)
    (xhat : LeiBR.Sync.Profile n → LeiBR.Sync.Profile n) (hxhat : LeiBR.Sync.IsProxBR X f μ xhat) (xs : LeiBR.Sync.Profile n)
    (hNE : LeiBR.Sync.IsNashEq X f xs) (I : ℕ → Finset (Fin N)) (τ : Fin N → Fin N → ℕ → ℕ)
    (α : Fin N → ℕ → ℝ) (hα : ∀ i k, 0 ≤ α i k) (x : ℕ → Ω → LeiBR.Sync.Profile n)
    (halg : IsAlgorithm3 P F X xhat I τ α x) :
    ∀ k, ∀ i ∈ I k,
      ∫ ω, ‖x (k + 1) ω i - xs i‖ ∂P ≤
        α i k + normInf (LeiBR.Sync.Gamma X f μ) * ⨆ j, ∫ ω, ‖x (k - τ i j k) ω j - xs j‖ ∂P := by sorry

end LeiBR.Async
