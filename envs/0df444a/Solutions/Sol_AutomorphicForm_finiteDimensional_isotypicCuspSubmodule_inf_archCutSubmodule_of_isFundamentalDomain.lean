        {g | NumberField.TateGlobal.ideleNorm F (Matrix.GeneralLinearGroup.det g) ∈ Set.Icc α β}))
    (ξ : (productionPinsOf F S
        (fun N => levelOne (𝓞 F) F N ⊓ finiteAdelicGL2Subgroup F) (fun v => heckeGen (𝓞 F) F v)
        (adelicBox F)).Z →* ℂˣ)
    (N : Ideal (𝓞 F)) (hN : N ≠ ⊥) (P : Finset (HeightOneSpectrum (𝓞 F)))
    (tys : ArchTypeFamily F) (Ψ : HeckeEigensystem F ℂ) :
    FiniteDimensional ℂ
      ↥(isotypicCuspSubmodule F
          (productionPinsOf F S
            (fun N => levelOne (𝓞 F) F N ⊓ finiteAdelicGL2Subgroup F) (fun v => heckeGen (𝓞 F) F v)
            (adelicBox F)) ξ N P Ψ
        ⊓ archCutSubmodule F tys) := by
  obtain ⟨T, c, hc, u, hcov⟩ := SiegelCovering.exists_finset_coversModCentre_iUnion_mul_centreCutSiegelSet F
  have _ := hSs
  have hle := isotypicCuspSubmodule_inf_archCutSubmodule_le_of_isFundamentalDomain_of_pos
    F α β hα hαβ S hS ξ N hN P tys Ψ c u (1 / 2) 2 T hc (by norm_num)
