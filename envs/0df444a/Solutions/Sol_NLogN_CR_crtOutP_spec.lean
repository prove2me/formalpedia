theorem flatten_map_single {α β : Type*} (l : List α) (g : α → β) :
    (l.map fun q => [g q]).flatten = l.map g := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [ih]

theorem permL_single (Kl : List ℕ) (D : List ℤ) (hK : ∀ q < Kl.length, Kl.idxOf q < D.length) :
