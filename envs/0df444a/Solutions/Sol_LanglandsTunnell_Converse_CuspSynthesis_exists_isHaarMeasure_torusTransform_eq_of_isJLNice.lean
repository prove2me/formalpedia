private theorem t0208 {x σ σ' : ℝ} (hx : 0 < x) (hσ' : σ' ≤ σ) {n : ℕ} (hn : σ - σ' ≤ n)
    (M : ℕ) :
    x ^ (-σ') * (1 + x) ^ (-((M + n : ℕ) : ℝ)) ≤ x ^ (-σ) * (1 + x) ^ (-(M : ℝ)) := by
  have h1x : 0 < 1 + x := by linarith
