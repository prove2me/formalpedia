theorem count_arith (q ψ m : ℕ) (hq : 2 ≤ q) :
    (q - 1) * (ψ * m * (q * (q ^ 2 - 1)) / 2) = ψ * m * ((q ^ 2 - 1) * (q ^ 2 - q)) / 2 := by
  obtain ⟨b, rfl⟩ : ∃ b, q = b + 2 := ⟨q - 2, by omega⟩
  have hb1 : b + 2 - 1 = b + 1 := by omega
  have hb2 : (b + 2) ^ 2 - 1 = (b + 1) * (b + 3) := by
    have : (b + 2) ^ 2 = (b + 1) * (b + 3) + 1 := by ring
    rw [this, Nat.add_sub_cancel]
  have hb3 : (b + 2) ^ 2 - (b + 2) = (b + 1) * (b + 2) := by
    have : (b + 2) ^ 2 = (b + 1) * (b + 2) + (b + 2) := by ring
    rw [this, Nat.add_sub_cancel]
  rw [hb1, hb2, hb3]
  set X : ℕ := ψ * m * ((b + 2) * ((b + 1) * (b + 3))) with hX
  have h2 : 2 ∣ X := by
    have h12 : 2 ∣ (b + 1) * (b + 2) := (Nat.even_mul_succ_self (b + 1)).two_dvd
    have : (b + 2) * ((b + 1) * (b + 3)) = (b + 1) * (b + 2) * (b + 3) := by ring
    rw [hX, this]
    exact Dvd.dvd.mul_left (Dvd.dvd.mul_right h12 _) _
  have hY : ψ * m * ((b + 1) * (b + 3) * ((b + 1) * (b + 2))) = (b + 1) * X := by
    rw [hX]; ring
  rw [hY, Nat.mul_div_assoc _ h2]

theorem exists_det_eq (q : ℕ) [NeZero q] (v : (ZMod q)ˣ) : ∃ g : Matrix (Fin 2) (Fin 2) ℤ,
    IsUnit (g.map (Int.castRingHom (ZMod q))).det ∧ ((g.det : ℤ) : ZMod q) = (v : ZMod q) := by
  refine ⟨!![(((v : ZMod q).val : ℕ) : ℤ), 0; 0, 1], ?_, ?_⟩
  · have h : (Matrix.map !![(((v : ZMod q).val : ℕ) : ℤ), 0; 0, 1] (Int.castRingHom (ZMod q))).det = (v : ZMod q) := by
      simp [Matrix.det_fin_two]
    rw [h]; exact Units.isUnit v
  · rw [Matrix.det_fin_two_of]
    simp only [mul_one, mul_zero, sub_zero, Int.cast_natCast, ZMod.natCast_zmod_val]

