-- Source module: Solutions.J6SegR6
/-!
# Segmented inverse (S2): the round-six regime

`r6_axis_hyps`: for every `P` with `P.Ok` there is `n₁` such that for `n ≥ n₁`, every admissible
source list (`SrcOK6`) and every axis `j < d`, the hypotheses of the segmented-inverse theorems
hold with `s = src j`, `t = tF6 j`, `α = αN6`:
`0 < s < t`, `2 ≤ α` and `α²θ = xθ s t α ≥ 3`.

Proof: `SrcOK6` forces the window `w_j = ⌊t/(8d²)⌋ ≥ 1`, so `t - s ≥ w_j ≥ t/(16d²)`; and
`α² ≥ 48 d²` as soon as `b' = b^{1+x} ≥ 3072 d³`, which holds for large `b` because
`d ≤ b^ε` and `3ε < 1 + x` (`Prm.Ok.three_eps`).
-/

open Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf IntMul.Kappa.R6

/-- `b^{1+x} ≥ 3072 b^{3ε}` for large `b`. -/
lemma big_b (P : Prm) (hP : P.Ok) : ∃ B : ℕ, 4 ≤ B ∧ ∀ b : ℕ, B ≤ b →
    3072 * ((b : ℝ) ^ P.ε) ^ 3 ≤ (b : ℝ) ^ (1 + P.x) := by
  set c : ℝ := 1 + P.x - 3 * P.ε with hc
  have hc0 : 0 < c := by have := hP.three_eps; rw [hc]; linarith
  set B0 : ℝ := (3072 : ℝ) ^ (1 / c)
  refine ⟨⌈B0⌉₊ + 4, by omega, fun b hb => ?_⟩
  have hbB : B0 ≤ b := by
    have := Nat.le_ceil B0
    have : ((⌈B0⌉₊ + 4 : ℕ) : ℝ) ≤ b := by exact_mod_cast hb
    push_cast at this; linarith
  have hb0 : (0 : ℝ) < b := by
    have : (4 : ℝ) ≤ b := by exact_mod_cast (show 4 ≤ b by omega)
    linarith
  have h1 : (3072 : ℝ) ≤ (b : ℝ) ^ c := by
    have := Real.rpow_le_rpow (by positivity) hbB hc0.le
    rwa [← Real.rpow_mul (by norm_num), one_div_mul_cancel hc0.ne', Real.rpow_one] at this
  have h2 : ((b : ℝ) ^ P.ε) ^ 3 = (b : ℝ) ^ (3 * P.ε) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hb0.le]; ring_nf
  have h3 : (b : ℝ) ^ (1 + P.x) = (b : ℝ) ^ (3 * P.ε) * (b : ℝ) ^ c := by
    rw [← Real.rpow_add hb0, ← Real.rpow_natCast]; congr 1; rw [hc]; push_cast; ring
  rw [h2, h3]
  have : 0 < (b : ℝ) ^ (3 * P.ε) := Real.rpow_pos_of_pos hb0 _
  nlinarith

/-- The round-six parameters in `ℕ` form: `0 < s < t`, `2 ≤ α`, `3 s ≤ α² (t - s)` (`α²θ ≥ 3`),
`6 d ≤ s`, `48 d² ≤ α² ≤ p`, `p < 48 d (α+1)²`, `3072 ≤ b'`. -/
theorem r6_axis_nat_sol_aux (P : Prm) (hP : P.Ok) : ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ,
    SrcOK6 P n src → ∀ j < dP6 P n,
      0 < src j ∧ src j < tF6 P n j ∧ 2 ≤ αN6 P n ∧
      3 * src j ≤ αN6 P n ^ 2 * (tF6 P n j - src j) ∧ 6 * dP6 P n ≤ src j ∧
      48 * dP6 P n ^ 2 ≤ αN6 P n ^ 2 ∧ αN6 P n ^ 2 ≤ pP6 P n ∧
      pP6 P n < 48 * dP6 P n * (αN6 P n + 1) ^ 2 ∧ 3072 ≤ b'P6 P n ∧ 1 ≤ dP6 P n := by
  obtain ⟨B, hB4, hB⟩ := big_b P hP
  obtain ⟨n₁, hn₁⟩ := eventually_b_ge B
  refine ⟨n₁, fun n hn src hsrc j hj => ?_⟩
  have hb := hn₁ n hn
  set b := bP6 n
  set d := dP6 P n
  have hd1 : 1 ≤ d := d_pos P hP (by omega)
  -- `b' ≥ 3072 d³`
  have hbd : 3072 * d ^ 3 ≤ b'P6 P n := by
    have h1 := hB b hb
    have h2 : (d : ℝ) ≤ (b : ℝ) ^ P.ε := d_le_beps P n
    have h3 : (d : ℝ) ^ 3 ≤ ((b : ℝ) ^ P.ε) ^ 3 := pow_le_pow_left₀ (by positivity) h2 3
    have : ((3072 * d ^ 3 : ℕ) : ℝ) ≤ ((b'P6 P n : ℕ) : ℝ) := by
      unfold b'P6; push_cast; linarith
    exact_mod_cast this
  -- `α² ≥ 48 d²`
  set a2 := α2P6 P n
  set α := αN6 P n
  have ha2 : 6 * b'P6 P n < 48 * d * (a2 + 1) := by
    have := Nat.lt_div_mul_add (a := 6 * b'P6 P n) (b := 48 * d) (by omega)
    have e : a2 = 6 * b'P6 P n / (48 * d) := rfl
    rw [e]; nlinarith
  have hsq : a2 < (α + 1) * (α + 1) := Nat.lt_succ_sqrt a2
  have hd384 : 384 * d ^ 2 < a2 + 1 := by
    have h1 : 48 * d * (384 * d ^ 2) ≤ 6 * b'P6 P n := by
      have : 48 * d * (384 * d ^ 2) = 6 * (3072 * d ^ 3) := by ring
      omega
    exact Nat.lt_of_mul_lt_mul_left (lt_of_le_of_lt h1 ha2)
  have hd2' : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd1
  have ha2' : 4 ≤ a2 := by omega
  have hα2 : 2 ≤ α := by
    have : 2 * 2 ≤ a2 := by omega
    exact Nat.le_sqrt.2 this
  have hαd : 48 * d ^ 2 ≤ α ^ 2 := by
    have h4 : a2 < 4 * α ^ 2 := by nlinarith
    omega
  -- the window
  have hlo := hsrc.lo j hj
  have hhi := hsrc.hi j hj
  set t := tF6 P n j
  set w := wnd6 P n j
  have hwdef : w = t / (8 * d ^ 2) := rfl
  have hw1 : 1 ≤ w := by omega
  have hd2 : 0 < 8 * d ^ 2 := by positivity
  have ht : t < 8 * d ^ 2 * (w + 1) := by
    rw [hwdef]; exact Nat.lt_mul_div_succ t hd2
  have hwt : 8 * d ^ 2 * w ≤ t := by rw [hwdef]; exact Nat.mul_div_le t _
  have hs0 : 0 < src j := by
    have : 2 * w ≤ t / 4 := by
      have : 8 * w ≤ t := le_trans (Nat.mul_le_mul_right w (by omega : 8 ≤ 8 * d ^ 2)) hwt
      omega
    omega
  have hkey : 3 * src j ≤ α ^ 2 * (t - src j) := by
    have h1 : w ≤ t - src j := by omega
    have h2 : 3 * t ≤ 48 * d ^ 2 * w := by
      have : 8 * d ^ 2 * (w + 1) ≤ 8 * d ^ 2 * (2 * w) := Nat.mul_le_mul_left _ (by omega)
      have e : 48 * d ^ 2 * w = 3 * (8 * d ^ 2 * (2 * w)) := by ring
      omega
    have h3 : 48 * d ^ 2 * w ≤ α ^ 2 * w := Nat.mul_le_mul_right _ hαd
    have h4 : α ^ 2 * w ≤ α ^ 2 * (t - src j) := Nat.mul_le_mul_left _ h1
    omega
  have h6d : 6 * d ≤ src j := by
    have e : 8 * d ^ 2 * w = 8 * (d ^ 2 * w) := by ring
    have h1 : d ^ 2 * 1 ≤ d ^ 2 * w := Nat.mul_le_mul_left _ hw1
    have h2 : 1 * w ≤ d ^ 2 * w := Nat.mul_le_mul_right w hd2'
    have h3 : d ≤ d ^ 2 := by nlinarith
    rw [e] at hwt
    generalize d ^ 2 * w = X at hwt h1 h2
    omega
  have hαp : α ^ 2 ≤ pP6 P n := by
    have h1 : α ^ 2 ≤ a2 := by
      exact Nat.sqrt_le' a2
    have h2 : a2 ≤ 6 * b'P6 P n := Nat.div_le_self _ _
    have e : pP6 P n = 6 * b'P6 P n := rfl
    omega
  have hpα : pP6 P n < 48 * d * (α + 1) ^ 2 := by
    have e : pP6 P n = 6 * b'P6 P n := rfl
    have h1 : 48 * d * (a2 + 1) ≤ 48 * d * (α + 1) ^ 2 :=
      Nat.mul_le_mul_left _ (by nlinarith)
    omega
  have hb' : 3072 ≤ b'P6 P n := by
    have : 3072 * 1 ≤ 3072 * d ^ 3 := Nat.mul_le_mul_left _ (Nat.one_le_pow _ _ hd1)
    omega
  exact ⟨hs0, by omega, hα2, hkey, h6d, hαd, hαp, hpα, hb', hd1⟩

end J6Seg

end

theorem solution : type_of% @J6Seg.r6_axis_nat_sol_aux := @J6Seg.r6_axis_nat_sol_aux
