section KumDec

variable {A K : Type} [CommRing A] [Field K] [Algebra A K] {Λ : Type} [AddCommGroup Λ] {N : ℕ} [NeZero N]
  {ζ : maxUnram A K} (hζ : IsPrimitiveRoot ζ N)

include hζ in
/-- `ζ ^ (N / d)` is a primitive `d`-th root of unity. -/
theorem primd {d : ℕ} (hdN : d ∣ N) : IsPrimitiveRoot (ζ ^ (N / d)) d := by
  have h0 : N / d ≠ 0 := by
    intro h
    have e := Nat.div_mul_cancel hdN
    rw [h, zero_mul] at e
    exact NeZero.ne N e.symm
  have h := hζ.pow_of_dvd h0 (Nat.div_dvd_of_dvd hdN)
  rwa [Nat.div_div_self hdN (NeZero.ne N)] at h

end KumDec

