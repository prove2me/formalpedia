-- title:
--   Eq. (42): the scalar boundary operators $\mathcal S_0\nabla\cdot\mathbf E$ and $\mathbf n\cdot\mathbf H$ on a perfectly conducting half-space
-- statement:
--   Let $k=\omega\sqrt{\varepsilon\mu}$ with $\operatorname{Re}k>0$, $\operatorname{Im}k\ge0$, let $(\xi,\eta)\ne(0,0)$ with $\beta=\sqrt{\xi^2+\eta^2-k^2}\ne0$, and let $(\mathbf E,\mathbf H)$ be the generalized Debye field in $z\ge0$ above the perfect conductor generated by the mean-zero sources $r=\widehat r\,e^{i(\xi x+\eta y)}$ and $q=\widehat q\,e^{i(\xi x+\eta y)}$, with $\mathbf j,\mathbf m$ as in eq. (35). Then on $z=0$,
--
--   $$\mathcal S_0\nabla\cdot\mathbf E=\sqrt\mu\,\big(\xi^2+\eta^2-k^2-ik\beta\big)\,\widehat g_0(\xi,\eta,0)\,\widehat g_k(\xi,\eta,0)\,\widehat r\,e^{i(\xi x+\eta y)},$$
--
--   $$\mathbf n\cdot\mathbf H=\sqrt\varepsilon\,\big(\beta-ik\big)\,\widehat g_k(\xi,\eta,0)\,\widehat q\,e^{i(\xi x+\eta y)},$$
--
--   where $\mathcal S_0\nabla\cdot\mathbf E$ is $\mathcal S_0$ applied to the divergence of the tangential part of $\mathbf E$ (eq. (38)). The first operator involves only $r$ and the second only $q$.
--
--   **Formalization Note** The statement is for one Fourier mode, on which the paper's operators act by the multipliers of eqs. (39)-(41); eq. (42) is its superposition over $(\xi,\eta)$ (the factor $e^{i(\xi x+\eta y)}$ is missing from the printed integrals). $\mathcal S_k$ acts as in eq. (40). The modes with $\xi^2+\eta^2=k^2$ are excluded.
-- source:
--   M. O'Neil, A generalized Debye source approach to electromagnetic scattering in layered media, arXiv:1310.4241v1 (2013), claim c009; Section V.A, eq. (42), PDF p. 10; eqs. (32)-(41), PDF pp. 9-10

import Mathlib
import Definitions.Def_Arxiv1310_4241_Basic

open MeasureTheory Filter Topology

namespace Arxiv1310_4241

theorem pec_debye_boundary_operators (ω : ℝ) (ε μ k : ℂ) (hkdef : k = wavenumber ω ε μ)
    (hk : IsCausalWavenumber k) (ξ η : ℝ) (hξη : (ξ, η) ≠ (0, 0))
    (hβ : sommerfeldRoot k ξ η ≠ 0) (r q : ℂ) (x y : ℝ) :
    laplaceSingleLayerOnMode ξ η (tangentialDivergence (pecE ω ε μ ξ η r q)) (pt x y 0) =
      csqrt μ * ((ξ : ℂ) ^ 2 + (η : ℂ) ^ 2 - k ^ 2 - Complex.I * k * sommerfeldRoot k ξ η) *
        ghat 0 ξ η 0 * ghat k ξ η 0 * r * planeWave ξ η x y ∧
    pecH ω ε μ ξ η r q (pt x y 0) 2 =
      csqrt ε * (sommerfeldRoot k ξ η - Complex.I * k) * ghat k ξ η 0 * q * planeWave ξ η x y := by sorry

end Arxiv1310_4241
