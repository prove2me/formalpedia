theorem Cube.mem_leaves_starAt (F : Finset (Fin L)) (τ : Leaf L) :
    τ ∈ Cube.leaves (Cube.starAt F τ) :=
  Cube.mem_leaves.2 fun ℓ => (em (ℓ ∈ F)).imp (if_pos ·) (if_neg ·)

