variable (k : Type) [CommRing k] (V : ℕ → Type)
  [∀ j, AddCommGroup (V j)] [∀ j, Module k (V j)]

/-- The difference map `x ↦ (x j - r j (x (j+1)))_j` of an inverse system `(V j, r j)`. -/
def towerDelta (r : ∀ j, V (j + 1) →ₗ[k] V j) : (∀ j, V j) →ₗ[k] (∀ j, V j) where
  toFun x j := x j - r j (x (j+1))
  map_add' x y := by ext j; simp only [Pi.add_apply, map_add]; abel
  map_smul' a x := by ext j; simp only [Pi.smul_apply, map_smul, smul_sub, RingHom.id_apply]

/-- The compatible threads of an inverse system: the kernel of `towerDelta`. -/
def towerThreads (r : ∀ j, V (j + 1) →ₗ[k] V j) : Submodule k (∀ j, V j) :=
  LinearMap.ker (towerDelta k V r)

end

/-- Power series in two variables `T = X 0`, `X = X 1` over `k`. -/
abbrev TwoSeries (k : Type) [CommRing k] := MvPowerSeries (Fin 2) k

/-- The first variable `T` of `k[[T,X]]`. -/
noncomputable def axisT (k : Type) [CommRing k] : TwoSeries k := MvPowerSeries.X 0

/-- The second variable `X` of `k[[T,X]]`. -/
noncomputable def axisX (k : Type) [CommRing k] : TwoSeries k := MvPowerSeries.X 1

/-- The principal monomial ideal `(T^a X^b)` of `k[[T,X]]`. -/
noncomputable def monomialIdeal (k : Type) [CommRing k] (a b : ℕ) : Ideal (TwoSeries k) :=
  Ideal.span {axisT k ^ a * axisX k ^ b}

/-- The model special fiber `k[[T,X]] / (T^a X^b)`. -/
abbrev SpecialFiber (k : Type) [CommRing k] (a b : ℕ) := TwoSeries k ⧸ monomialIdeal k a b

/-- The image of `T` in the special fiber. -/
noncomputable def fiberT (k : Type) [CommRing k] (a b : ℕ) : SpecialFiber k a b :=
  Ideal.Quotient.mk _ (axisT k)

/-- The image of `X` in the special fiber. -/
noncomputable def fiberX (k : Type) [CommRing k] (a b : ℕ) : SpecialFiber k a b :=
  Ideal.Quotient.mk _ (axisX k)

/-- The contact number of `f` and `t`: the length of `B / (f, t)` as a `B`-module. -/
def contact {B : Type} [CommRing B] (f t : B) : ℕ∞ :=
  Module.length B (B ⧸ Ideal.span {f,t})

/-- Principal ideals of `k[[T,X]]/(T^a)` with contact `c` against `T`. -/
def singleResidueIdeals (k : Type) [CommRing k] (a c : ℕ) :=
  {I : Ideal (SpecialFiber k a 0) // ∃ f, I=Ideal.span {f} ∧ contact f (fiberT k a 0)=c}

/-- Principal ideals of `k[[T,X]]/(T^a X^b)` with contacts `c` against `T` and `h` against `X`. -/
def crossingResidueIdeals (k : Type) [CommRing k] (a b c h : ℕ) :=
  {I : Ideal (SpecialFiber k a b) // ∃ f, I=Ideal.span {f} ∧
    contact f (fiberT k a b)=c ∧ contact f (fiberX k a b)=h}

section Surface

variable (O : Type) [CommRing O]

/-- The defining relation `π - u T^a X^b` of the concrete surface. -/
noncomputable def surfaceRelation (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) : TwoSeries O :=
  MvPowerSeries.C pi - (u : TwoSeries O) * axisT O ^ a * axisX O ^ b

/-- The principal ideal generated by `surfaceRelation`. -/
noncomputable def surfaceIdeal (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) : Ideal (TwoSeries O) :=
  Ideal.span {surfaceRelation O pi u a b}

/-- The concrete surface `O[[T,X]] / (π - u T^a X^b)`. -/
abbrev ConcreteSurface (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) :=
  TwoSeries O ⧸ surfaceIdeal O pi u a b

/-- The quotient map onto the concrete surface. -/
noncomputable def surfaceMk (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) :
    TwoSeries O →+* ConcreteSurface O pi u a b :=
  Ideal.Quotient.mk (surfaceIdeal O pi u a b)

/-- The image of `T` in the concrete surface. -/
noncomputable def surfaceT (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) : ConcreteSurface O pi u a b :=
  surfaceMk O pi u a b (axisT O)

/-- The image of `X` in the concrete surface. -/
noncomputable def surfaceX (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) : ConcreteSurface O pi u a b :=
  surfaceMk O pi u a b (axisX O)

/-- The image of the unit `u` in the concrete surface. -/
noncomputable def surfaceUnit (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) :
    (ConcreteSurface O pi u a b)ˣ :=
  Units.map (surfaceMk O pi u a b).toMonoidHom u

/-- The ideal `(T, X)` of `O[[T,X]]`. -/
noncomputable def variableIdeal : Ideal (TwoSeries O) := Ideal.span {axisT O, axisX O}

/-- The ideal `(t, x)` of the concrete surface generated by the images of `T` and `X`. -/
noncomputable def surfaceParameterIdeal (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ) :
    Ideal (ConcreteSurface O pi u a b) :=
  Ideal.span {surfaceT O pi u a b, surfaceX O pi u a b}

/-- Reduction of coefficients `O[[T,X]] → k[[T,X]]` to the residue field `k` of `O`. -/
noncomputable def residueSeries [IsLocalRing O] :
    TwoSeries O →+* TwoSeries (IsLocalRing.ResidueField O) :=
  MvPowerSeries.map (IsLocalRing.residue O)

end Surface

section Basis

variable {O M : Type} [CommRing O] [AddCommGroup M] [Module O M]

/-- `β` is a basis of `M / π M` over `O / π`: it spans modulo `π`, and its relations modulo `π`
have all coefficients divisible by `π`. -/
def ResidueBasisFamily (pi : O) {N : ℕ} (β : Fin N → M) : Prop :=
  (∀ m : M, ∃ z : Fin N → O, ∃ m' : M, m = (∑ i, z i • β i) + pi • m') ∧
  (∀ z : Fin N → O, (∃ m' : M, (∑ i, z i • β i) = pi • m') → ∀ i, pi ∣ z i)

end Basis

