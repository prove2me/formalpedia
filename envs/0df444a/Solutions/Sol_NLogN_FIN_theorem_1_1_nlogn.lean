open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref NLogN.ST NLogN.Top
theorem solution : IntMul.MulTimeBound fun n => n * Real.log n :=
  NLogN.FIN.final_of (10 ^ 4) le_rfl
end
