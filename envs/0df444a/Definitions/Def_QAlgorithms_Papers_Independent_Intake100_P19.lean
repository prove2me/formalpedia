-- title:
--   Definitions for Homotopy types of topological stacks
-- statement:
--   The objects the formalized statements of *Homotopy types of topological stacks* (arXiv:0808.3799) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `restrictedFunctor`: The actual restriction of a functor to two full subcategories (§7, PDF p. 14).
--   - `localizedFunctor`: The functor induced on actual category localizations by a functor carrying S-morphisms to T-morphisms (§7, PDF p. 14).
--   - `RightSpan`: An R-span X ← V → Y, with its actual apex and its left leg in R (§13, PDF pp. 28–29).
--   - `SpanHom`: A map of spans is any map of apices respecting both legs (§13, PDF p. 29). Its map is not required to be invertible or to belong to R.
--   - `spanStep`: A directed step is the existence of a map in the actual span category (§13, PDF p. 29).
--   - `SpanComponent`: `Quot` identifies the equivalence relation generated by directed steps: finite zigzags in the full category of spans, not only common refinements (§13, PDF p. 29).
--   - `honestSpan`: The honest arrow f is represented by (id,f) (§13, PDF p. 29).
--   - `composeSpan`: Compose spans using a pullback of the second denominator. Only pullbacks along R-morphisms are required (§13, PDF pp. 28–29).
--   - `spanValue`: The canonical value of a span in the actual localization is Q(r)⁻¹Q(g) (§13, PDF p. 29). The inverse is the explicit formal inverse.
--   - `elementaryRHomotopy`: Elementary R-homotopy uses one R-map with two specified sections and one common map out of its domain (§13, PDF p. 29).
--   - `RHomotopyQuotient`: Hom modulo the equivalence relation generated by elementary R-homotopy; `Quot` supplies reflexive, symmetric, and transitive closure (PDF p. 29).
-- source:
--   Homotopy types of topological stacks, arXiv:0808.3799v2, https://arxiv.org/abs/0808.3799v2

import Mathlib

/-!
Statements from Noohi, Homotopy types of topological stacks, arXiv:0808.3799v2.
Only the ordinary categorical results with complete local interfaces are stated.
The accompanying HARD.md and GAPS.json inventory every deferred plan node.
-/

noncomputable section

namespace QAlgorithms.Papers.Independent.Intake100.P19

open CategoryTheory CategoryTheory.Limits

universe uB vB uC vC

/-- The actual restriction of a functor to two full subcategories (§7, PDF p. 14). -/
def restrictedFunctor {B : Type uB} [Category.{vB} B]
    {C : Type uC} [Category.{vC} C] (F : B ⥤ C)
    (P : ObjectProperty B) (Q : ObjectProperty C)
    (hF : ∀ b, P b → Q (F.obj b)) : P.FullSubcategory ⥤ Q.FullSubcategory :=
  Q.lift (P.ι ⋙ F) (fun b => hF b.obj b.property)

example {B : Type uB} [Category.{vB} B]
    {C : Type uC} [Category.{vC} C] (F : B ⥤ C)
    (P : ObjectProperty B) (Q : ObjectProperty C)
    (hF : ∀ b, P b → Q (F.obj b)) (b : P.FullSubcategory) :
    ((restrictedFunctor F P Q hF).obj b).obj = F.obj b.obj := rfl

/-- The functor induced on actual category localizations by a functor carrying
S-morphisms to T-morphisms (§7, PDF p. 14). -/
def localizedFunctor {B : Type uB} [Category.{vB} B]
    {C : Type uC} [Category.{vC} C] (F : B ⥤ C)
    (S : MorphismProperty B) (T : MorphismProperty C)
    (hF : ∀ ⦃b b2 : B⦄ (f : b ⟶ b2), S f → T (F.map f)) :
    S.Localization ⥤ T.Localization :=
  Localization.Construction.lift (F ⋙ T.Q) (fun _ _ f hf => T.Q_inverts _ (hF f hf))

example {B : Type uB} [Category.{vB} B]
    {C : Type uC} [Category.{vC} C] (F : B ⥤ C)
    (S : MorphismProperty B) (T : MorphismProperty C)
    (hF : ∀ ⦃b b2 : B⦄ (f : b ⟶ b2), S f → T (F.map f)) :
    S.Q ⋙ localizedFunctor F S T hF = F ⋙ T.Q := by
  exact Localization.Construction.fac _ _

/-- An R-span X ← V → Y, with its actual apex and its left leg in R
(§13, PDF pp. 28–29). -/
structure RightSpan {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) where
  apex : C
  left : apex ⟶ X
  right : apex ⟶ Y
  left_mem : R left

/-- A map of spans is any map of apices respecting both legs (§13, PDF p. 29).
Its map is not required to be invertible or to belong to R. -/
@[ext]
structure SpanHom {C : Type uC} [Category.{vC} C]
    {R : MorphismProperty C} {X Y : C} (a b : RightSpan R X Y) where
  map : a.apex ⟶ b.apex
  left_comm : map ≫ b.left = a.left
  right_comm : map ≫ b.right = a.right

/-- The full ordinary category of spans and maps of spans (§13, PDF p. 29). -/
instance spanCategory {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) : Category (RightSpan R X Y) where
  Hom a b := SpanHom a b
  id a := ⟨𝟙 a.apex, by simp, by simp⟩
  comp f g :=
    ⟨f.map ≫ g.map, by rw [Category.assoc, g.left_comm, f.left_comm],
      by rw [Category.assoc, g.right_comm, f.right_comm]⟩
  id_comp := by
    intros
    apply SpanHom.ext
    exact Category.id_comp _
  comp_id := by
    intros
    apply SpanHom.ext
    exact Category.comp_id _
  assoc := by
    intros
    apply SpanHom.ext
    exact Category.assoc _ _ _

/-- A directed step is the existence of a map in the actual span category
(§13, PDF p. 29). -/
def spanStep {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) (a b : RightSpan R X Y) : Prop :=
  Nonempty (a ⟶ b)

/-- `Quot` identifies the equivalence relation generated by directed steps:
finite zigzags in the full category of spans, not only common refinements
(§13, PDF p. 29). -/
abbrev SpanComponent {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) := Quot (spanStep R X Y)

/-- The honest arrow f is represented by (id,f) (§13, PDF p. 29). -/
def honestSpan {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) [R.ContainsIdentities]
    {X Y : C} (f : X ⟶ Y) : RightSpan R X Y where
  apex := X
  left := 𝟙 X
  right := f
  left_mem := R.id_mem X

example {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) [R.ContainsIdentities]
    {X Y : C} (f : X ⟶ Y) : (honestSpan R f).right = f := rfl

example {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) (s : RightSpan R X Y) :
    spanStep R X Y s s := by
  exact ⟨𝟙 s⟩

/-- Compose spans using a pullback of the second denominator. Only pullbacks
along R-morphisms are required (§13, PDF pp. 28–29). -/
def composeSpan {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) [R.HasPullbacks]
    [R.IsStableUnderBaseChange] [R.IsStableUnderComposition]
    {X Y Z : C} (s : RightSpan R X Y) (t : RightSpan R Y Z) : RightSpan R X Z := by
  letI : HasPullback t.left s.right := R.hasPullback s.right t.left_mem
  exact
    { apex := pullback t.left s.right
      left := pullback.snd t.left s.right ≫ s.left
      right := pullback.fst t.left s.right ≫ t.right
      left_mem := R.comp_mem _ _ (R.pullback_snd _ _ t.left_mem) s.left_mem }

/-- The canonical value of a span in the actual localization is Q(r)⁻¹Q(g)
(§13, PDF p. 29). The inverse is the explicit formal inverse. -/
def spanValue {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) {X Y : C} (s : RightSpan R X Y) :
    R.Q.obj X ⟶ R.Q.obj Y :=
  Localization.Construction.wInv s.left s.left_mem ≫ R.Q.map s.right

/-- Elementary R-homotopy uses one R-map with two specified sections and
one common map out of its domain (§13, PDF p. 29). -/
def elementaryRHomotopy {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) {X Y : C} (f g : X ⟶ Y) : Prop :=
  ∃ (V : C) (r : V ⟶ X) (t t2 : X ⟶ V) (k : V ⟶ Y),
    R r ∧ t ≫ r = 𝟙 X ∧ t2 ≫ r = 𝟙 X ∧ t ≫ k = f ∧ t2 ≫ k = g

/-- Hom modulo the equivalence relation generated by elementary R-homotopy;
`Quot` supplies reflexive, symmetric, and transitive closure (PDF p. 29). -/
abbrev RHomotopyQuotient {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) (X Y : C) :=
  Quot (elementaryRHomotopy R : (X ⟶ Y) → (X ⟶ Y) → Prop)

example {C : Type uC} [Category.{vC} C]
    (R : MorphismProperty C) [R.ContainsIdentities]
    {X Y : C} (f : X ⟶ Y) : elementaryRHomotopy R f f := by
  exact ⟨X, 𝟙 X, 𝟙 X, 𝟙 X, f, R.id_mem X, by simp, by simp, by simp, by simp⟩

end QAlgorithms.Papers.Independent.Intake100.P19


