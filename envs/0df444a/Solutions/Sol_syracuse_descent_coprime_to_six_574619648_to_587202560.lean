/- The shortcut Collatz map. After a fixed parity prefix its value is affine
   on each residue class modulo a power of two. -/
private def halfStep (n : ℕ) : ℕ :=
  if n % 2 = 0 then n / 2 else (3 * n + 1) / 2

private def nextSlope (c t : ℕ) : ℕ :=
  if c % 2 = 0 then t else 3 * t

private theorem affineStep (c t k : ℕ) :
    halfStep (c + 2 * (t * k)) = halfStep c + nextSlope c t * k := by
  have hmod : (c + 2 * (t * k)) % 2 = c % 2 := by omega
  by_cases he : c % 2 = 0
  · simp [halfStep, nextSlope, hmod, he]
    omega
  · simp [halfStep, nextSlope, hmod, he, Nat.mul_assoc]
    omega


/- For all 0 ≤ r < 256 the eight-step map on n = r + 256k is
   offsets[r] + slopes[r] * k. The fields are generated by iterating
   halfStep on r and multiplying the slope by 3 at each odd step. -/
-- The two base-8192 tables pack the offset and slope of eight shortcut
-- steps for each of the 256 input residues. Their contents are checked below.
private def offsets : ℕ := 
private def slopes : ℕ := 
private def entry (table r : ℕ) : ℕ := (table >>> (13*r)) % 8192

private def jump (n : ℕ) : ℕ :=
  entry offsets (n % 256) + entry slopes (n % 256) * (n / 256)

private def multiplier : ℕ → ℕ → ℕ
  | 0, _ => 1
  | h+1, r => multiplier h (halfStep r) * nextSlope r 1

private theorem affineIter (h r k : ℕ) :
    halfStep^[h] (r+2^h*k) = halfStep^[h] r + multiplier h r*k := by
  induction h generalizing r k with
  | zero => simp [multiplier]
  | succ h ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply, pow_succ,
      show 2^h*2*k = 2*(1*(2^h*k)) by ring, affineStep,
      show nextSlope r 1 * (2^h*k) = 2^h*(nextSlope r 1*k) by ring, ih, multiplier]
    rw [Nat.mul_assoc]

private theorem tables (r : Fin 256) :
    entry offsets r = halfStep^[8] (r : ℕ) ∧ entry slopes r = multiplier 8 r := by
  revert r
  decide +kernel

private theorem jump_spec (n : ℕ) : jump n = halfStep^[8] n := by
  let r : Fin 256 := ⟨n%256, Nat.mod_lt _ (by decide)⟩
  obtain ⟨hc,ht⟩ := tables r
  have he : n%256 + 2^8*(n/256) = n := by omega
  unfold jump
  rw [show entry offsets (n%256) = _ from hc, show entry slopes (n%256) = _ from ht]
  exact (affineIter 8 (n%256) (n/256)).symm.trans (congrArg (halfStep^[8]) he)

private def falls (a : ℕ) : ℕ → ℕ → Bool
  | 0, c => Nat.blt c a
  | h + 1, c => bif Nat.blt c a then true else falls a h (jump c)

/-- Check the progression of starts a+s*k whose current values are c+t*k,
    with 0 ≤ k < 2^h. At a singleton, 64 eight-step jumps are available. -/
private def covers : ℕ → ℕ → ℕ → ℕ → ℕ → Bool
  | 0, a, _, c, _ => falls a 64 c
  | h + 1, a, s, c, t =>
    bif Nat.blt c a && Nat.ble t s then true
    else covers h a (2*s) (halfStep c) (nextSlope c t) &&
      covers h (a+s) (2*s) (halfStep (c+t)) (nextSlope (c+t) t)

private def Drops (c a : ℕ) : Prop := ∃ j : ℕ, halfStep^[j] c < a

private theorem dropsNow {c a : ℕ} (h : c < a) : Drops c a := ⟨0,h⟩

private theorem dropsBack {c a : ℕ} (h : Drops (halfStep c) a) : Drops c a := by
  obtain ⟨j,hj⟩ := h
  exact ⟨j+1, by rwa [Function.iterate_succ_apply]⟩

private theorem falls_sound (a h c : ℕ) (hc : falls a h c = true) : Drops c a := by
  induction h generalizing c with
  | zero => exact dropsNow (Nat.blt_eq.mp hc)
  | succ h ih =>
    cases e : Nat.blt c a with
    | true => exact dropsNow (Nat.blt_eq.mp e)
    | false =>
      simp only [falls, e, cond_false] at hc
      obtain ⟨j,hj⟩ := ih _ hc
      exact ⟨j+8, by rwa [Function.iterate_add_apply, ← jump_spec]⟩

private theorem covers_sound (h a s c t : ℕ) (hc : covers h a s c t = true)
    (k : ℕ) (hk : k < 2^h) : Drops (c+t*k) (a+s*k) := by
  induction h generalizing a s c t k with
  | zero =>
    have : k = 0 := by simpa using hk
    subst k
    simpa using falls_sound a 64 c hc
  | succ h ih =>
    cases e : Nat.blt c a && Nat.ble t s with
    | true =>
      simp only [Bool.and_eq_true, Nat.blt_eq, Nat.ble_eq] at e
      obtain ⟨hca,hts⟩ := e
      have hmul := Nat.mul_le_mul_right k hts
      exact dropsNow (by omega)
    | false =>
      simp only [covers, e, cond_false, Bool.and_eq_true] at hc
      have hk' : k / 2 < 2^h := by rw [pow_succ] at hk; omega
      rcases (show k = 2 * (k/2) ∨ k = 2 * (k/2) + 1 by omega) with he | ho
      · have h1 := ih _ _ _ _ hc.1 (k/2) hk'
        apply dropsBack
        rwa [show c+t*k = c+2*(t*(k/2)) by nth_rw 1 [he]; ring,
          affineStep, show a+s*k = a+(2*s)*(k/2) by nth_rw 1 [he]; ring]
      · have h1 := ih _ _ _ _ hc.2 (k/2) hk'
        apply dropsBack
        rwa [show c+t*k = (c+t)+2*(t*(k/2)) by nth_rw 1 [ho]; ring,
          affineStep, show a+s*k = (a+s)+(2*s)*(k/2) by nth_rw 1 [ho]; ring]

private theorem early (h a s c t : ℕ) (he : (Nat.blt c a && Nat.ble t s) = true) :
    covers (h+1) a s c t = true := by simp only [covers, he, cond_true]

private theorem branches (h a s c t : ℕ)
    (hl : covers h a (2*s) (halfStep c) (nextSlope c t) = true)
    (hr : covers h (a+s) (2*s) (halfStep (c+t)) (nextSlope (c+t) t) = true) :
    covers (h+1) a s c t = true := by
  simp only [covers, hl, hr, Bool.and_self, Bool.cond_self]

-- After two shortcut steps, 12k+a has slope 27 in either remaining class.
private theorem drops_class (a k : ℕ) (hk : k < 2^20)
    (h : covers 20 a 12 (halfStep^[2] a) (multiplier 2 a*3) = true) :
    Drops (a+12*k) (a+12*k) := by
  obtain ⟨j,hj⟩ := covers_sound 20 a 12 _ _ h k hk
  have htwo : halfStep^[2] (a+12*k) = halfStep^[2] a + (multiplier 2 a*3)*k := by
    calc
      halfStep^[2] (a+12*k) = halfStep^[2] (a+2^2*(3*k)) := by ring_nf
      _ = _ := by rw [affineIter, Nat.mul_assoc]
  exact ⟨j+2, by rwa [Function.iterate_add_apply, htwo]⟩

