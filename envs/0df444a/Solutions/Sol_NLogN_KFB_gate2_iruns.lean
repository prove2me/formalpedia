  have p2 := Sp.push s f1 (i := rB2) (e := .lit ((2 * B1 : ℕ) : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl _ (by omega))
  rw [show Ex.eval (encK s f1) (.lit ((2 * B1 : ℕ) : ℤ)) :: f1 rB2 = [((2 * B1 : ℕ) : ℤ)] by
    simp +decide [Ex.eval, f1, hC.b2]] at p2
  set f2 := Function.update f1 rB2 [((2 * B1 : ℕ) : ℤ)]
  have p3 := Sp.push s f2 (i := rB4) (e := .lit ((4 * B1 : ℕ) : ℤ)) (B := Z) (by decide)
    (clean_lit _) trivial trivial (zl _ (by omega))
