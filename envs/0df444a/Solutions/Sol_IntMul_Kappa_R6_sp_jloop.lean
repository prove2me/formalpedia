-- Source module: Solutions.J6SieveStep
/-!
# J6Sieve, part 3: one greedy step

If `Q` is a set of at most `Ω + 1` primes, all `> z = 4(Ω+1)`, and `H` exceeds the
explicit bound, then every interval `(A, A+H]` contains a `z`-rough integer
divisible by no element of `Q`.
-/

namespace J6Sieve
open Finset

/-- The greedy step. -/
theorem step (d X H A : ℕ) (Q : Finset ℕ) (hQp : ∀ q ∈ Q, q.Prime)
    (hQz : ∀ q ∈ Q, q ∉ P (zz d X)) (hQc : Q.card ≤ Om d X + 1) (hH : sieveBound d X < H) :
    ∃ n, A < n ∧ n ≤ A + H ∧ rough (zz d X) n ∧ ∀ q ∈ Q, ¬ q ∣ n :=
  step_core (zz d X) (Om d X) (kk d X) (mm d X) H A Q rfl
    (Nat.lt_pow_succ_log_self (by norm_num) _) rfl hQp hQz hQc hH

end J6Sieve

end

section
-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

lemma card_primeFactors_le_log (s : ℕ) (hs : s ≠ 0) : s.primeFactors.card ≤ Nat.log 2 s := by
  apply Nat.le_log_of_pow_le (by norm_num)
  calc 2 ^ s.primeFactors.card ≤ ∏ p ∈ s.primeFactors, p :=
        Finset.pow_card_le_prod _ _ _ fun p hp => (Nat.prime_of_mem_primeFactors hp).two_le
    _ ≤ s := Nat.le_of_dvd (Nat.pos_of_ne_zero hs) (Nat.prod_primeFactors_dvd s)

lemma rough_odd (z n : ℕ) (hz : 2 ≤ z) (h : rough z n) : Odd n := by
  have h2 : 2 ∈ P z := mem_P.2 ⟨hz, Nat.prime_two⟩
  exact Nat.odd_iff.2 (Nat.two_dvd_ne_zero.1 (h 2 h2))

end J6Sieve

end

