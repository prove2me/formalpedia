  CerednikDrinfeld.FormalODModule.isSpecial_and_hasHeight_four_of_isIso_of_isArtinianRing O ι X₀ A resA hs hc X w h.2.1

theorem Rig.existsUnique_P (hPRO : ProRep resR Xu wu)
    (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} {X : FormalODModule q A}
    {θ : RelativeGroupLaw.FormalCoordinates E.f 2} {w : (X.map resA).Hom X₀.toFormalODModule}
    (h : Rig coord θ₀ resA E g X θ w) :
    ∃! χ : R →ₐ[O] A, P resR Xu wu resA X w χ := by
  obtain ⟨hsp, hht⟩ := h.isSpecial_and_hasHeight (ι := ι) hs hc
  exact hPRO A resA hs hc X hsp hht w h.2.1

theorem Rig.transfer (hcoord : IsOrderCoord Λ q coord)
    (hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O)
    (hX₀ : u₀.1.IsFormalModuleVia coord X₀.toFormalODModule θ₀)
    (hs : Function.Surjective resA) (hc : resA.comp (algebraMap O A) = residue O)
    {E : FakeEllipticCurve Λ 1 A} {g : u₀.1.A ⟶ E.A} (hg : FakeEllipticCurve.IsPullbackVia resA E u₀.1 g)
    {X X' : FormalODModule q A} {θ θ' : RelativeGroupLaw.FormalCoordinates E.f 2}
    {w : (X.map resA).Hom X₀.toFormalODModule} {w' : (X'.map resA).Hom X₀.toFormalODModule}
    (h : Rig coord θ₀ resA E g X θ w) (h' : Rig coord θ₀ resA E g X' θ' w') :
    ∃ t : X.Hom X', t.IsIso ∧ w'.comp (t.map resA) = w := by
  letI instAk : Algebra A (ResidueField O) := resA.toAlgebra
  have hqA := isNilpotent_natCast hqO resA hs hc
  have hqk := isNilpotent_natCast_residueField hqO
  obtain ⟨hXθ, -, hwred⟩ := h
  obtain ⟨hXθ', -, hwred'⟩ := h'

  obtain ⟨t, htiso, htrel, -⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_hom_isIso_forall_apply_eq_apply_nilEval_of_isFormalModuleVia
      coord hcoord A hqA E X X' θ θ' hXθ hXθ'
  refine ⟨t, htiso, ?_⟩

  obtain ⟨θbar, hθbar, hred⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq
      coord A (ResidueField O) E u₀.1 g hg X θ hXθ

  obtain ⟨w₁, -, -, huniq⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_hom_isIso_forall_apply_eq_apply_nilEval_of_isFormalModuleVia
      coord hcoord (ResidueField O) hqk u₀.1 (X.map resA) X₀.toFormalODModule θbar θ₀ hθbar hX₀
  have hw : w = w₁ := by
    refine huniq w fun B'' _ _ J n hJ s hs' => ?_
    letI : Algebra A B'' := ((algebraMap (ResidueField O) B'').comp resA).toAlgebra
    haveI : IsScalarTower A (ResidueField O) B'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    apply pt_ext hg
    rw [hwred B'' J n hJ s hs', hred B'' s fun i => isNilpotent_of_mem (isNilpotent_of_pow_succ_eq_bot hJ) (hs' i)]
  have hw' : w'.comp (t.map resA) = w₁ := by
    refine huniq _ fun B'' _ _ J n hJ s hs' => ?_
    letI instAB : Algebra A B'' := ((algebraMap (ResidueField O) B'').comp resA).toAlgebra
    haveI : IsScalarTower A (ResidueField O) B'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
    apply pt_ext hg
    have hsn : ∀ i, IsNilpotent (s i) := fun i => isNilpotent_of_mem (isNilpotent_of_pow_succ_eq_bot hJ) (hs' i)

    set s' : Fin 2 → B'' := fun i => MvFormalGroup.nilEval n ((t.map resA).toSeries i) s with hs'_def
    have hs'mem : ∀ i, s' i ∈ J := fun i => nilEval_mem J n _ ((t.map resA).isODHom.constantCoeff i) s hs'
    have hcomp : (fun i => MvFormalGroup.nilEval n ((w'.comp (t.map resA)).toSeries i) s) =
        fun i => MvFormalGroup.nilEval n (w'.toSeries i) s' := by
      funext i
      exact nilEval_comp J n hJ hs' _ _ (t.map resA).isODHom.constantCoeff i

    have hs't : s' = fun i => MvFormalGroup.nilEval n (t.toSeries i) s := by
      funext i
      rw [hs'_def]
      show MvFormalGroup.nilEval n (MvPowerSeries.map resA (t.toSeries i)) s = _
      unfold MvFormalGroup.nilEval
      have htr : ∀ bnd : Fin 2 →₀ ℕ, MvPowerSeries.trunc' (ResidueField O) bnd (MvPowerSeries.map resA (t.toSeries i)) =
          MvPolynomial.map resA (MvPowerSeries.trunc' A bnd (t.toSeries i)) := by
        intro bnd
        ext m
        rw [MvPowerSeries.coeff_trunc', MvPolynomial.coeff_map, MvPowerSeries.coeff_trunc']
        split_ifs
        · exact MvPowerSeries.coeff_map resA m _
        · exact (map_zero resA).symm
      rw [htr, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, MvPolynomial.aeval_def]
      rfl
    rw [hcomp, hwred' B'' J n hJ s' hs'mem, hred B'' s hsn, hs't]
    exact congrArg Subtype.val (htrel B'' J n hJ s hs')
  rw [hw', hw]

theorem P.of_transfer {X X' : FormalODModule q A}
    {w : (X.map resA).Hom X₀.toFormalODModule} {w' : (X'.map resA).Hom X₀.toFormalODModule}
    (t : X.Hom X') (ht : t.IsIso) (htw : w'.comp (t.map resA) = w) {χ : R →ₐ[O] A}
    (hP : P resR Xu wu resA X' w' χ) : P resR Xu wu resA X w χ := by
  obtain ⟨hres, v', hv'iso, hv'⟩ := hP
  obtain ⟨tinv, ht₁, ht₂, htinv⟩ := HomAux.IsIso.exists_inv ht
  refine ⟨hres, tinv.comp v', HomAux.IsIso.comp htinv hv'iso, ?_⟩
  rw [← hv', ← htw, HomAux.map_comp, HomAux.comp_assoc, ← HomAux.comp_assoc (t.map resA), ← HomAux.map_comp, ht₂,
    HomAux.map_id, HomAux.id_comp]

theorem nilEval_map_toAlgebra {B B' C : Type} [CommRing B] [CommRing B'] [CommRing C] [Algebra B' C]
    (φ : B →+* B') (n : ℕ) (ψ : MvPowerSeries (Fin 2) B) (x : Fin 2 → C) :
    MvFormalGroup.nilEval n (MvPowerSeries.map φ ψ) x =
      @MvFormalGroup.nilEval B _ _ _ _ C _ ((algebraMap B' C).comp φ).toAlgebra n ψ x := by
  letI : Algebra B C := ((algebraMap B' C).comp φ).toAlgebra
  unfold MvFormalGroup.nilEval
  have htr : ∀ bnd : Fin 2 →₀ ℕ, MvPowerSeries.trunc' B' bnd (MvPowerSeries.map φ ψ) =
      MvPolynomial.map φ (MvPowerSeries.trunc' B bnd ψ) := by
    intro bnd
    ext m
    rw [MvPowerSeries.coeff_trunc', MvPolynomial.coeff_map, MvPowerSeries.coeff_trunc']
    split_ifs
    · exact MvPowerSeries.coeff_map φ m _
    · exact (map_zero φ).symm
  rw [htr, MvPolynomial.aeval_def, MvPolynomial.eval₂_map, MvPolynomial.aeval_def]
  rfl

theorem specOver_comp_specMap_algebraMap {S T : Type} [CommRing S] [CommRing T] [Algebra S T]
    (B'' : Type) [CommRing B''] [Algebra S B''] [Algebra T B''] [IsScalarTower S T B''] :
    Scheme.specOver (𝒪 := T) B'' ≫ Spec.map (CommRingCat.ofHom (algebraMap S T)) = Scheme.specOver (𝒪 := S) B'' := by
  show Spec.map _ ≫ Spec.map _ = Spec.map _
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]

section
variable (coord θ₀ resR Xu wu resA)

structure GHyp : Prop where
  hcoord : IsOrderCoord Λ q coord
  h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ
  hqO : algebraMap ℤ_[q] O (q : ℤ_[q]) ∈ maximalIdeal O
