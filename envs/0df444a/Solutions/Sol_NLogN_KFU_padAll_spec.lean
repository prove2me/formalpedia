    have h1 : AModel.vol A * (S[k] * AModel.vol Bs + (T[k] - S[k]) * AModel.vol Bs) ≤ AModel.vol T := by
      have : AModel.vol A * (S[k] * AModel.vol Bs + (T[k] - S[k]) * AModel.vol Bs) = AModel.vol (A ++ T[k] :: Bs) := by
        rw [AModel.vol_append, AModel.vol_cons, ← Nat.add_mul, Nat.add_sub_cancel' hle]
      rw [this, ← eM']
      apply NLogN.KFU.vol_le_of_forall₂
      conv_rhs => rw [← List.take_append_drop (k + 1) T]
      exact List.rel_append (NLogN.KFU.forall₂_refl' _) (List.forall₂_drop (k + 1) hF)
    have h2 : AModel.vol A ≤ AModel.vol T := NLogN.KFU.vol_take_le T hT k
    have h3 : 10 ^ 4 * (w + 1) * (AModel.vol A * (S[k] * AModel.vol Bs + (T[k] - S[k]) * AModel.vol Bs) + AModel.vol A + 1) ≤
        10 ^ 4 * (w + 1) * (2 * AModel.vol T + 1) := Nat.mul_le_mul_left _ (by omega)
    unfold NLogN.KFU.cScan at *
    nlinarith

theorem solution (S T : AModel.Shape) (hF : List.Forall₂ (· ≤ ·) S T) (hS : ∀ a ∈ S, 1 ≤ a)
    (w : ℕ) (xs : List ℤ) (hxs : xs.length = AModel.vol S) (hb : NLogN.Bnd w xs) (s : NLogN.IState NLogN.HS)
    (R : List NLogN.Item) (h0 : s.G 0 = NLogN.ints xs ++ R) :
    ∀ k ≤ S.length, NLogN.IRuns I iprog (NLogN.KFU.padAllC S T k) s
      (s.upd 0 (NLogN.ints (AModelL12.embed S (T.take k ++ S.drop k) 0 xs) ++ R)) (k * NLogN.KFU.cScan (AModel.vol T) w + 1) := by
  first
  | exact padAll_spec_aux
  | (intros; apply padAll_spec_aux <;> assumption)
end
