variable {d : ℕ}

/-- The triangle inequality for `‖·‖_∞`. -/
lemma solution (x y : EuclideanSpace ℝ (Fin d)) :
    QFS.infNorm (x + y) ≤ QFS.infNorm x + QFS.infNorm y := by
  refine QFS.infNorm_le (add_nonneg (QFS.infNorm_nonneg x) (QFS.infNorm_nonneg y)) (fun i => ?_)
  have h1 : |(x + y) i| = |x i + y i| := by simp
  rw [h1]
  exact (abs_add_le _ _).trans (add_le_add (QFS.le_infNorm x i) (QFS.le_infNorm y i))
