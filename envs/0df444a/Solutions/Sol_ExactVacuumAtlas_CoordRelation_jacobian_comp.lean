open scoped ContDiff

namespace ExactVacuumAtlas.CoordRelation

variable {g₁ g₂ g₃ : Metric 4} {U V W : Set (Pt 4)} {Φ₁ Ψ₁ Φ₂ Ψ₂ : Pt 4 → Pt 4}
  {J₁ J₂ : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ}

/-- The slice derivative of a component of `Φ₂` at a point of the open set `V` is the Jacobian
entry (uniqueness of derivatives). -/
theorem fderiv_single_eq (hV : IsOpen V) (h₂ : CoordRelation g₂ g₃ V W Φ₂ Ψ₂ J₂) {y : Pt 4}
    (hy : y ∈ V) (k j : Fin 4) :
    fderiv ℝ Φ₂ y (Pi.single j 1) k = J₂ y k j := by
  have hd : DifferentiableAt ℝ Φ₂ y :=
    (h₂.smooth.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
  have h1 : HasDerivAt (Function.update y j) (Pi.single j 1) (y j) := hasDerivAt_update y j (y j)
  have h2 : HasFDerivAt Φ₂ (fderiv ℝ Φ₂ y) (Function.update y j (y j)) := by
    rw [Function.update_eq_self]; exact hd.hasFDerivAt
  have h3 := HasFDerivAt.comp_hasDerivAt (x := y j) (hl := h2) (hf := h1)
  exact ((hasDerivAt_pi.mp h3) k).unique (h₂.jacobian y hy k j)

end ExactVacuumAtlas.CoordRelation

