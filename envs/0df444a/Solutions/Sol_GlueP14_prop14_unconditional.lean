theorem solution {P K D S ρ r : ℕ} (hρ : ρ < K) (p : ℕ)
    (xs : List (Fin r → ℂ)) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    Butterfly.prop14Proc (P := P) (S := S) hρ p (GlueP14.cRecC D) xs = Butterfly.QpArr p (Butterfly.layerH P K D S ρ hρ xs) ∧
    (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p (GlueP14.cRecC D) xs).length), ∀ c,
      ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p (GlueP14.cRecC D) xs)[j] c‖ ≤ 1) ∧
    (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p (GlueP14.cRecC D) xs).length)
      (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
      ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p (GlueP14.cRecC D) xs)[j] c - (Butterfly.layerH P K D S ρ hρ xs)[j] c‖
        < Real.sqrt 2 * 2⁻¹ ^ p) :=
