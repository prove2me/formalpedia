          (show k + 2 ≤ positiveDecoderBudget t w + 5 ∧
            decoderPost (N := N) b ι y { z with pc := pc + 5558 } from
              ⟨by omega, emptyDecoder_post b ι y _ ht hq.2.1 hq.2.2⟩))
        have hcost (k : ℕ) : 1 + (k + 1) = k + 2 := by omega
        simpa only [emptyDecoderStmt, Stmt.len, List.length_cons, List.length_nil, Nat.add_assoc, Nat.zero_add, hcost] using hb)
    simpa only [Cond.code, List.length_nil, positiveEntryStmt_length, emptyDecoderStmt, Stmt.len,
      List.length_cons, Nat.add_zero, decoderStmt_length, Nat.add_assoc] using hh
  have hFull := Sem.seq_bound hTest (fun z _ hz => by subst z; exact hCond)
  exact Sem.mono hFull (fun k z hq => ⟨by omega, hq.2⟩)

/-- The complete decoder is composable at any embedding address.  Its normal
exit leaves the base, count, and accept flag in registers 0, 1, and 2. -/
theorem decoderStmt_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {N t w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (y : Fin (t * w) → ZMod 2)
    (E : RAMEnv) (hN : 1 ≤ N) (htN : t ≤ N) (hW : E.W = 8 * w) (hdet : E.det = detStd t N b ι)
    (h0 : ∀ i < N, ι i ≠ 0) (hinj : Set.InjOn ι (Set.Iio N)) :
    StatementSpec decoderStmt E (decoderStart (8 * w) y [])
      (20000 * ((t : ℝ) + w + 1) ^ 6) (decoderPost (N := N) b ι y) := by
  intro P pc hAt
  refine Sem.mono (decoderStmt_spec_nat b ι y P E pc hAt hN htN hW hdet h0 hinj) ?_
  intro k z hq
  refine ⟨?_, hq.2⟩
  have hn : k + 1 ≤ 20000 * (t + w + 1) ^ 6 := le_trans (by omega) (decoderBudget_bound t w)
  exact_mod_cast hn

theorem pinsketchDecoder_halts {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {N t w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (y : Fin (t * w) → ZMod 2)
    (hN : 1 ≤ N) (htN : t ≤ N) (h0 : ∀ i < N, ι i ≠ 0) (hinj : Set.InjOn ι (Set.Iio N)) :
    ∃ s', HaltsWithin pinsketchDecoderProgram (detEnv (8 * w) (detStd t N b ι))
      (20000 * ((t : ℝ) + w + 1) ^ 6) (decoderStart (8 * w) y []) s' ∧ decoderPost (N := N) b ι y s' := by
  exact halts_of_statement_spec decoderStmt (detEnv (8 * w) (detStd t N b ι)) (decoderStart (8 * w) y [])
    (20000 * ((t : ℝ) + w + 1) ^ 6) (decoderPost (N := N) b ι y) rfl
    (decoderStmt_spec b ι y _ hN htN rfl rfl h0 hinj)

