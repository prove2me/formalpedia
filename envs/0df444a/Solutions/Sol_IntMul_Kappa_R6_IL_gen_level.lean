      IRuns I tab (tab 0) (t'.upd 0 (ints (enc2 ys) ++ R')) (t'.upd 0 (ints (enc2 (child ρ ys)) ++ R'))
        (c0 ρ))
    (R : List Item) (xs : List (ZMod 2)) (hxs : xs.length = vol (P :: L :: hdShape A B Cs e q)) :
    IRuns I tab (genL C)
      (encK (s0.upd 0 (ints (enc2 xs) ++ R))
        (regState (fDesc e P L (vol A) (vol B) (vol Cs))
          (vEnt m q W T e P L (vol A) (vol B) (vol Cs)) genD))
      (encK (s0.upd 0 (ints (enc2 (if m ≤ e then Bit.levelH C (q ^ (e / m)) P (L / W) A
          (List.replicate (e % m) q ++ B) (List.replicate (e % m) q ++ Cs) child xs else xs)) ++ R))
        (regState (fDesc e P L (vol A) (vol B) (vol Cs))
          (vEnt m q W T e P L (vol A) (vol B) (vol Cs)) genD))
      (cGenL C e (vol (P :: (L / W) :: hdShape A (List.replicate (e % m) q ++ B)
        (List.replicate (e % m) q ++ Cs) m (q ^ (e / m)))) Bb c0) := by
  obtain ⟨v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19⟩ :=
    vEnt_vals m q W T e P L (vol A) (vol B) (vol Cs)
  have hEBb := hEB.bounds
  set a := vol A with ha
  set b := vol B with hb
  set c := vol Cs with hc
  set f := e / m with hf
  set r := e % m with hr
  set N := q ^ f with hNdef
  set Fd := fDesc e P L a b c with hFd
  set vE := vEnt m q W T e P L a b c with hvE
  have hgF : (encK (s0.upd 0 (ints (enc2 xs) ++ R)) (regState Fd vE genD)).G gF =
      .int (f : ℤ) :: (ints (Fd gF) ++ (s0.upd 0 (ints (enc2 xs) ++ R)).G gF) := by
    rw [encK_G, regState_mem (by decide), v1]; rfl
  unfold cGenL
  by_cases hme : m ≤ e
  swap
  · -- no level
    have hf0 : f = 0 := Nat.div_eq_of_lt (by omega)
    rw [if_neg hme, if_neg hme]
    refine IRuns.iteT (by rw [cl_int _ _ _ _ hgF, hf0]; rfl) (IRuns.skip _)
  rw [if_pos hme, if_pos hme]
  -- the level
  have hf1 : 1 ≤ f := (Nat.le_div_iff_mul_le (by omega)).2 (by omega)
  have hq2 : 2 ≤ q := hq.two_le
  have hqN : q ≤ N := by
    calc q = q ^ 1 := (pow_one q).symm
      _ ≤ q ^ f := Nat.pow_le_pow_right hq.pos hf1
  have hN1 : 1 < N := by omega
  have : NeZero N := ⟨by omega⟩
  have hgF' : (fun c => c == Cls.zero)
      ((encK (s0.upd 0 (ints (enc2 xs) ++ R)) (regState Fd vE genD)).cl gF) = false := by
    have : (f : ℤ) ≠ 0 := by omega
    rw [cl_int _ _ _ _ hgF, if_neg this]
    split_ifs <;> rfl
  refine IRuns.iteF hgF' ?_
  have hm1 : 1 ≤ m := by omega
  have ha1 : 1 ≤ a := vol_pos_of hA
  have hb1 : 1 ≤ b := vol_pos_of hB
  have hc1 : 1 ≤ c := vol_pos_of hC
  have hd := hEB.desc
  have hlit := hEB.lit
  have hvv := hEB.vv
  have hNmM := hEB.Nm
  have hM1 : 1 ≤ M := by omega
  have hN3' : 2 * N ≤ (N + 1) ^ 3 := by
    have h3 : (N + 1) ^ 3 = (N + 1) * ((N + 1) * (N + 1)) := by ring
    have h4 : 2 ≤ (N + 1) * (N + 1) := le_trans (by omega : 2 ≤ (N + 1) * 1)
      (Nat.mul_le_mul_left _ (by omega))
    rw [h3]; exact le_trans (by omega : 2 * N ≤ (N + 1) * 2) (Nat.mul_le_mul_left _ h4)
  have hNM : N ≤ M := by omega
  have hWL' := hWL hme
  set L' := L / W with hL'
  have hLW : W * L' = L := Nat.mul_div_cancel' hWL'
  have hW1 : 1 ≤ W := NeZero.pos W
  have hL1' : 1 ≤ L' := by
    rcases Nat.eq_zero_or_pos L' with h | h
    · rw [h, Nat.mul_zero] at hLW; omega
    · exact h
  set B' := List.replicate r q ++ B with hB'
  set C' := List.replicate r q ++ Cs with hC'
  set rest := hdShape A B' C' m N with hrest
  set v := vol (P :: L' :: rest) with hv
  have hr1 : 1 ≤ q ^ r := Nat.one_le_pow _ _ (by omega)
  have hb1' : 1 ≤ q ^ r * b := Nat.mul_pos hr1 hb1
  have hc1' : 1 ≤ q ^ r * c := Nat.mul_pos hr1 hc1
  have hvE' : v = volE m q W e P L a b c := by
    rw [hv, hrest, hB', hC', hNdef, vol_lev]; rfl
  have hvM : (T + W) * v ≤ M := by rw [hvE']; exact hvv
  have hvM' : v ≤ M := le_trans (Nat.le_mul_of_pos_left _ (by omega)) hvM
  -- 1. push `-N`
  set X := ints (enc2 xs) ++ R with hX
  have hQtop : (regState Fd vE genD) sQQ = (N : ℤ) :: Fd sQQ := by rw [regState_mem (by decide), v3]
  have S1 := Sp.push (s0.upd 0 X) (regState Fd vE genD) (i := sNQ) (e := .neg (.reg sQQ)) (B := Bb)
    (by decide) (clean_reg (i := sQQ) (by decide)) (isInt_encK hQtop) trivial
    (by show zsz ((encK _ _).top sQQ) ≤ Bb; rw [top_encK hQtop]; exact le_trans (zsz_nat_le hNM) hM)
  have hev : (Ex.neg (Ex.reg sQQ)).eval (encK (s0.upd 0 X) (regState Fd vE genD)) = -(N : ℤ) := by
    simp only [Ex.eval, top_encK hQtop]
  have hsN : (regState Fd vE genD) sNQ = [] := by
    rw [regState_nmem (by decide), hFd, fDesc_free (by decide)]
  rw [hev, hsN] at S1
  set Fx := Function.update (regState Fd vE genD) sNQ [-(N : ℤ)] with hFx
  have hFx0 : Fx 0 = [] := by
    rw [hFx, Function.update_of_ne (by decide), regState_nmem (by decide), hFd,
      fDesc_free (by decide)]
  set t1 := encK s0 Fx with ht1
  have e1 : encK (s0.upd 0 X) Fx = t1.upd 0 X := (encK_upd0_free hFx0 X).symm
  rw [e1] at S1
  -- the level registers
  have gD : ∀ r ∈ genD, r ∉ descD := by decide
  have hreg : ∀ x ∈ genD, x ≠ sNQ → t1.G x = .int (vE x : ℤ) :: s0.G x := by
    intro x hx hxN
    rw [ht1, encK_G, hFx, Function.update_of_ne hxN, regState_mem hx, hFd, fDesc_free (gD x hx)]
    rfl
  have hvA : vol (P :: L' :: A) = P * L' * a := by simp only [vol_cons, ha]; ring
  have hvB : vol B' = q ^ r * b := by simp only [hB', vol_append, vol_replicate, hb]
  have hvC : vol C' = q ^ r * c := by simp only [hC', vol_append, vol_replicate, hc]
  have hG : LevH t1.G m W T N P L' f A B' C' :=
    { qq := ⟨_, by rw [hreg sQQ (by decide) (by decide), v3]⟩
      nq := ⟨s0.G sNQ, by rw [ht1, encK_G, hFx, Function.update_self]; rfl⟩
      xs := ⟨_, by rw [hreg rXs (by decide) (by decide), v14, hvA]⟩
      vb := ⟨_, by rw [hreg rVB (by decide) (by decide), v15, hvB]⟩
      vc := ⟨_, by rw [hreg rVC (by decide) (by decide), v16, hvC]⟩
      v := ⟨_, by rw [hreg rV (by decide) (by decide), v17, ← hvE']⟩
      wv := ⟨_, by rw [hreg rWV (by decide) (by decide), v18, ← hvE']⟩
      tv := ⟨_, by rw [hreg gTV (by decide) (by decide), v19, ← hvE']⟩
      p := ⟨s0.G dP, by
        rw [ht1, encK_G, hFx, Function.update_of_ne (by decide), regState_nmem (by decide), hFd,
          fDesc_mem _ _ _ _ _ _ (by decide)]
        simp +decide [vDesc, ints]⟩
      lp := ⟨_, by rw [hreg rLp (by decide) (by decide), v12]⟩
      a := ⟨_, by rw [hreg gA (by decide) (by decide), v13]⟩
      f := ⟨_, by rw [hreg gF (by decide) (by decide), v1]⟩ }
  -- the templates
  have hBb3 : zsz ((((q ^ f + 1) ^ 3 : ℕ)) : ℤ) ≤ Bb := le_trans (zsz_nat_le hN3) hM
  obtain ⟨hTOK, hcop⟩ := tok_edges C hq hqB hf1 (hOK f) hBb3
  have hpos : ∀ x ∈ P :: L' :: rest, 1 ≤ x := by
    have hrep : ∀ (k y : ℕ), 1 ≤ y → ∀ x ∈ List.replicate k y, 1 ≤ x :=
      fun k y hy x hx => (List.eq_of_mem_replicate hx) ▸ hy
    simp only [hrest, hdShape, hB', hC', List.forall_mem_cons, List.forall_mem_append, and_assoc]
    exact ⟨hP, hL1', hA, hrep _ _ (by omega), hrep _ _ (by omega), hB, hrep _ _ (by omega),
      hrep _ _ (by omega), hC⟩
  have hxs' : xs.length = vol (P :: W * L' :: rest) := by
    rw [hxs, hLW, hrest, hB', hC', hNdef, hr, hf, vol_lev_big P L A B Cs q m e hm1]
  -- the child calls
  set cC : ℕ × ℕ × ℕ → ℕ := fun ρ => cCallR m ρ Bb (c0 ρ) with hcC
  have hvol : v = (a * N ^ m) * (P * L' * (q ^ r * b) * N ^ m * (q ^ r * c)) := by
    rw [hvE', volE]; ring
  have hPL : 1 ≤ P * L' * (q ^ r * b) * N ^ m * (q ^ r * c) :=
    Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL1') hb1')
      (Nat.one_le_pow _ _ (by omega))) hc1'
  have hNk : ∀ k, k ≤ m → N ^ k ≤ N ^ m := fun k hk => Nat.pow_le_pow_right (by omega) hk
  have hcall : ∀ e' ∈ C.edges, ∀ ρ ∈ e'.runs, ∀ (t : IState HS) (R' : List Item)
      (ys : List (ZMod 2)), Inv t1.G t → ys.length = v →
      IRuns I tab (callR (0 : Fin 1) m ρ) (t.upd 0 (ints (enc2 ys) ++ R'))
        (t.upd 0 (ints (enc2 (child ρ ys)) ++ R')) (cC ρ) ∧ (child ρ ys).length = v := by
    intro e' he' ρ hρ t R' ys ht hys
    have hρR : ρ ∈ runsL C := List.mem_flatMap.2 ⟨e', he', hρ⟩
    obtain ⟨hr0, hrm, hi, hj⟩ := hruns e' he' ρ hρ
    obtain ⟨_, tF⟩ := inv_reg ht (r := gF) (by decide) (by decide) hG.f
    obtain ⟨_, tLp⟩ := inv_reg ht (r := rLp) (by decide) (by decide) hG.lp
    obtain ⟨_, tA⟩ := inv_reg ht (r := gA) (by decide) (by decide) hG.a
    obtain ⟨_, tQQ⟩ := inv_reg ht (r := sQQ) (by decide) (by decide) hG.qq
    obtain ⟨_, tB⟩ := inv_reg ht (r := rVB) (by decide) (by decide) hG.vb
    obtain ⟨_, tC⟩ := inv_reg ht (r := rVC) (by decide) (by decide) hG.vc
    obtain ⟨_, tP⟩ := inv_reg ht (r := dP) (by decide) (by decide) hG.p
    rw [hvB] at tB
    rw [hvC] at tC
    have hbA : a * N ^ ρ.1 ≤ M := by
      have h1 : a * N ^ ρ.1 ≤ a * N ^ m := Nat.mul_le_mul_left _ (hNk _ (by omega))
      have h2 : a * N ^ m ≤ v := by rw [hvol]; exact Nat.le_mul_of_pos_right _ hPL
      omega
    have hbB : N ^ (m - ρ.1 - ρ.2.2) * (q ^ r * b * N ^ ρ.2.1) ≤ M := by
      have h1 : N ^ (m - ρ.1 - ρ.2.2) * (q ^ r * b * N ^ ρ.2.1) ≤ N ^ m * (q ^ r * b * N ^ m) :=
        Nat.mul_le_mul (hNk _ (by omega)) (Nat.mul_le_mul_left _ (hNk _ (by omega)))
      have h2 : N ^ m * (q ^ r * b * N ^ m) ≤ v := by
        rw [hvE', volE]
        have h3 : 1 ≤ P * L' * a * (q ^ r * c) :=
          Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL1') ha1) hc1'
        calc N ^ m * (q ^ r * b * N ^ m) ≤ N ^ m * (q ^ r * b * N ^ m) * (P * L' * a * (q ^ r * c)) :=
              Nat.le_mul_of_pos_right _ h3
          _ = _ := by ring
      omega
    have hbC : N ^ (m - ρ.2.1 - ρ.2.2) * (q ^ r * c) ≤ M := by
      have h1 : N ^ (m - ρ.2.1 - ρ.2.2) * (q ^ r * c) ≤ N ^ m * (q ^ r * c) :=
        Nat.mul_le_mul_right _ (hNk _ (by omega))
      have h2 : N ^ m * (q ^ r * c) ≤ v := by
        rw [hvE', volE]
        have h3 : 1 ≤ P * L' * a * N ^ m * (q ^ r * b) :=
          Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.mul_pos hP hL1') ha1)
            (Nat.one_le_pow _ _ (by omega))) hb1'
        calc N ^ m * (q ^ r * c) ≤ N ^ m * (q ^ r * c) * (P * L' * a * N ^ m * (q ^ r * b)) :=
              Nat.le_mul_of_pos_right _ h3
          _ = _ := by ring
      omega
    have hfM : f ≤ M := le_trans (Nat.div_le_self _ _) (by omega)
    have hbE : ρ.2.2 * f ≤ M := by
      have h1 : ρ.2.2 * f ≤ m * f := Nat.mul_le_mul_right _ (by omega)
      have h2 : m * f ≤ e := Nat.mul_div_le e m
      omega
    have hbL : L' ≤ M := le_trans (Nat.div_le_self _ _) (by omega)
    refine ⟨callR_runs (0 : Fin 1) m ρ hi hj (child ρ) (c0 ρ) v
      (fun t' R'' ys' hD hys' => hch hme ρ hρR t' R'' ys' hD hys') hM hM1 (by omega) hNM hfM hbA
      hbB hbC hbE hbL ha1 hb1' hc1' (by omega) t tF tLp tA tQQ tB tC tP R' ys hys, ?_⟩
    exact hchL ρ hρR ys hys
  have S2 := levBody_run (I := I) (tab := tab) C (N := N) hN1 P L' f A B' C' hpos Bb hTOK hcop
    (le_trans (zsz_nat_le hvM) hM)
    (le_trans (zsz_nat_le (show 2 * N ≤ M by omega)) hM)
    t1.G hG child cC hcall t1 (fun _ _ => rfl) R xs hxs'
  have hc2 := cLevBody_le C P L' (vol rest) v Bb cC hP hL1' (vol_pos_of (fun x hx =>
    hpos x (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hx)))) (by rw [hv, vol_cons, vol_cons]; ring)
  -- 3. pop `sNQ`
  set Y := ints (enc2 (Bit.levelH C N P L' A B' C' child xs)) ++ R with hY
  have S3 := Sp.pop (s0.upd 0 Y) Fx (i := sNQ) (B := Bb) (by decide)
    (by rw [hFx, Function.update_self]) (by rw [zsz_neg]; exact le_trans (zsz_nat_le hNM) hM)
  have e3 : Function.update Fx sNQ [] = regState Fd vE genD := by
    rw [hFx, Function.update_idem, Function.update_eq_self_iff, hsN]
  rw [e3] at S3
  rw [← encK_upd0_free hFx0 Y] at S3
  have H := (S1.toIRuns (I := I) (iprog := tab)).seq (S2.seq (S3.toIRuns (I := I) (iprog := tab)))
  refine H.mono' rfl ?_
  have hsz : (Ex.neg (Ex.reg sQQ) : Ex HS).size = 2 := rfl
  rw [hsz]
  have : ((runsL C).map cC).sum = ((runsL C).map fun ρ => cCallR m ρ Bb (c0 ρ)).sum := rfl
  have hc2' : cLevBody C P L' (vol (hdShape A B' C' m N)) (vol (P :: L' :: hdShape A B' C' m N)) Bb cC
      ≤ levB C v Bb + ((runsL C).map cC).sum := hc2
  omega

end

end IntMul.Kappa.R6.IL

