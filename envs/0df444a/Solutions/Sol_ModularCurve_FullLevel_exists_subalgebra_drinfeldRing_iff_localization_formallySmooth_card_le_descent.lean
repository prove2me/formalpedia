    obtain ⟨g, hg, hgi, hcusp, hgs, hgs', hsep⟩ :=
      ModularCurve.FullLevel.exists_rational_integral_evalAt_ne_of_ne_ssPlaces q hq M' hqM' A hA W hW hle R₀ hR₀ s s'
