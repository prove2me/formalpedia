  let t' : O'' := algebraMap O' O'' t
  have hq : ∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ, P.IsFrobeniusAt σ lam →
      ∀ v : ρ.V, ρ.ρ σ (ρ.ρ σ v) - t' • ρ.ρ σ v + (lam : O'') • v ∈ L := by
    intro σ hσ v
    rw [hmemL, map_add, map_sub, map_smul, map_smul, heρ, heρ, halgK, halgK, map_natCast]
