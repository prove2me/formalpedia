/-!
# Ingoing Kerr: symmetry, inverse, `C^∞`, Lorentz signature on `domIn a`

The Lorentz frame avoids `Δ` entirely, so it is valid on the horizons `Δ = 0`. With
`ℓ = dv + a sin²θ dφ`, `m = dr + a sin²θ dφ`, the metric is
`−F ℓ² + 2 ℓ m + Σ dθ² + Σ (sin θ dφ)²`, `F = 1 − 2Mr/Σ`; the null block `[[−F, 1], [1, 0]]` is
diagonalised by `(1, (F−1)/2)`, `(1, (F+1)/2)` exactly as for Schwarzschild EF. Pulling back
through the coframe gives the columns of `frameIn`, with `frameInᵀ g frameIn = diag(−1, 1, Σ, Σ)`.
-/

open Real
open scoped ContDiff

namespace ExactVacuumAtlas.Kerr.In

theorem metricMatrix_gIn (M a : ℝ) (x : Pt 4) :
    metricMatrix (gIn M a) x =
      !![-Fk M a x, 1, 0, -Fk M a x * (a * sin (x 2) ^ 2) + a * sin (x 2) ^ 2;
         1, 0, 0, a * sin (x 2) ^ 2;
         0, 0, x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2, 0;
         -Fk M a x * (a * sin (x 2) ^ 2) + a * sin (x 2) ^ 2, a * sin (x 2) ^ 2, 0,
           -Fk M a x * (a * sin (x 2) ^ 2) ^ 2 + 2 * (a * sin (x 2) ^ 2) ^ 2
             + (x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2) * sin (x 2) ^ 2] := by
  ext i j; fin_cases i <;> fin_cases j <;> rfl

theorem frameIn_diag (M a : ℝ) (x : Pt 4) (hx : x ∈ domIn a) :
    (frameIn M a x).transpose * metricMatrix (gIn M a) x * frameIn M a x =
      Matrix.diagonal ![-1, 1, x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2, x 1 ^ 2 + a ^ 2 * cos (x 2) ^ 2] := by
  have hs := domIn_s hx
  rw [metricMatrix_gIn]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [frameIn, Matrix.mul_apply, Fin.sum_univ_four, Matrix.diagonal]
  all_goals (try field_simp)
  all_goals ring

theorem lorentz (M a : ℝ) (x : Pt 4) (hx : x ∈ domIn a) :
    IsLorentzian (metricMatrix (gIn M a) x) := by
  have hS := domIn_S_pos hx
  refine isLorentzian_of_diag (frameIn M a x) _ (frameIn_diag M a x hx) (by norm_num) ?_
  intro i hi
  fin_cases i
  · exact absurd rfl hi
  · show (0:ℝ) < 1; norm_num
  · exact hS
  · exact hS

theorem symm (M a : ℝ) (x : Pt 4) (i j : Fin 4) : gIn M a i j x = gIn M a j i x := by
  fin_cases i <;> fin_cases j <;> rfl

theorem inv (M a : ℝ) (x : Pt 4) (hx : x ∈ domIn a) :
    metricMatrix (giIn M a) x * metricMatrix (gIn M a) x = 1 := by
  have hS := domIn_S hx; have hs := domIn_s hx
  have hc : cos (x 2) ^ 2 = 1 - sin (x 2) ^ 2 := cos_sq' (x 2)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_four, metricMatrix, gIn, giIn, Matrix.one_apply]
  all_goals (try field_simp)
  all_goals (try rw [hc])
  all_goals (try ring_nf)
  all_goals (try (rw [hc] at *; ring_nf))
  all_goals (try (simp only [hc]; ring))

