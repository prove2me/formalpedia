    (hNr : s.G NLogN.KFV.vT = .int ((2 * (N * r) : ℕ) : ℤ) :: LM) (hZ : NLogN.KFC.NM (s.G NLogN.KFV.vZ)) :
    NLogN.IRuns I iprog (NLogN.KFV.kronU pM) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update f 0 (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ N zf zg) ++ l))) (NLogN.KFV.cKron N r p b ρ φ) := by
  set Bb := NLogN.zsz ((2 * (N * r) : ℕ) : ℤ) with hBb
  have gf := NLogN.KFV.gb_of_abs hzf
  have gg := NLogN.KFV.gb_of_abs hzg
  have lf : (NLogN.KFB.gflat zf).length = 2 * (N * r) := by simp [hlf]
  have lg : (NLogN.KFB.gflat zg).length = 2 * (N * r) := by simp [hlg]
  have eT : ∀ g : Fin NLogN.HS → List ℤ, g NLogN.KFV.vT = [] →
      (NLogN.KIL.encK s g).G NLogN.KFV.vT = .int (((NLogN.KFB.gflat zf).length : ℕ) : ℤ) :: LM := by
    intro g hg; simp [hg, hNr, lf]
  have eT' : ∀ g : Fin NLogN.HS → List ℤ, g NLogN.KFV.vT = [] →
      (NLogN.KIL.encK s g).G NLogN.KFV.vT = .int (((NLogN.KFB.gflat zg).length : ℕ) : ℤ) :: LM := by
    intro g hg; simp [hg, hNr, lg]
  have fT : f NLogN.KFV.vT = [] := hE NLogN.KFV.vT (by decide) (by decide)
  -- the four input moves
  have m1 := NLogN.KFD.FSp.mvR (X := 0) (Y := NLogN.KFV.vA) (C := NLogN.KFV.vL) (r := NLogN.KFV.vT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f (NLogN.KFB.gflat zf) (NLogN.KFB.gflat zg ++ l) h0 (eT f fT)
    (p + 2) Bb gf.bnd (by rw [lf])
  rw [hE NLogN.KFV.vA (by decide) (by decide), List.append_nil] at m1
  set f1 := Function.update (Function.update f 0 (NLogN.KFB.gflat zg ++ l)) NLogN.KFV.vA (NLogN.KFB.gflat zf).reverse with hf1
  have m2 := NLogN.KFD.FSp.mvR (X := 0) (Y := NLogN.KFV.vB) (C := NLogN.KFV.vL) (r := NLogN.KFV.vT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f1 (NLogN.KFB.gflat zg) l (by simp +decide [hf1])
    (eT' f1 (by simp +decide [hf1, fT])) (p + 2) Bb gg.bnd (by rw [lg])
  rw [show f1 NLogN.KFV.vB = [] by simp +decide [hf1, hE NLogN.KFV.vB (by decide) (by decide)], List.append_nil] at m2
  set f2 := Function.update (Function.update f1 0 l) NLogN.KFV.vB (NLogN.KFB.gflat zg).reverse with hf2
  have m3 := NLogN.KFD.FSp.mvR (X := NLogN.KFV.vA) (Y := NLogN.KFV.vX) (C := NLogN.KFV.vL) (r := NLogN.KFV.vT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f2 (NLogN.KFB.gflat zf).reverse [] (by simp +decide [hf2, hf1])
    (by have := eT f2 (by simp +decide [hf2, hf1, fT]); rwa [List.length_reverse])
    (p + 2) Bb (NLogN.bnd_reverse gf.bnd) (by rw [List.length_reverse, lf])
  rw [List.reverse_reverse, show f2 NLogN.KFV.vX = [] by simp +decide [hf2, hf1, hE NLogN.KFV.vX (by decide) (by decide)],
    List.append_nil, List.length_reverse] at m3
  set f3 := Function.update (Function.update f2 NLogN.KFV.vA []) NLogN.KFV.vX (NLogN.KFB.gflat zf) with hf3
  have m4 := NLogN.KFD.FSp.mvR (X := NLogN.KFV.vB) (Y := NLogN.KFV.vY) (C := NLogN.KFV.vL) (r := NLogN.KFV.vT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s f3 (NLogN.KFB.gflat zg).reverse [] (by simp +decide [hf3, hf2])
    (by have := eT' f3 (by simp +decide [hf3, hf2, hf1, fT]); rwa [List.length_reverse])
    (p + 2) Bb (NLogN.bnd_reverse gg.bnd) (by rw [List.length_reverse, lg])
  rw [List.reverse_reverse, show f3 NLogN.KFV.vY = [] by simp +decide [hf3, hf2, hf1, hE NLogN.KFV.vY (by decide) (by decide)],
    List.append_nil, List.length_reverse] at m4
  set f4 := Function.update (Function.update f3 NLogN.KFV.vB []) NLogN.KFV.vY (NLogN.KFB.gflat zg) with hf4
  -- the loop states
  obtain ⟨F, hF'⟩ : ∃ F : ℕ → Fin NLogN.HS → List ℤ, F = fun k => Function.update (Function.update
      (Function.update (Function.update f 0 l) NLogN.KFV.vX (NLogN.KFB.gflat (zf.drop (k * r)))) NLogN.KFV.vY
      (NLogN.KFB.gflat (zg.drop (k * r)))) NLogN.KFV.vO (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ k zf zg)).reverse := ⟨_, rfl⟩
  have hF0 : F 0 = f4 := by
    funext j
    by_cases e1 : j = 0
    · subst e1; simp +decide [hF', hf4, hf3, hf2, hf1]
    by_cases e2 : j = NLogN.KFV.vX
    · subst e2; simp +decide [hF', hf4, hf3, hf2, hf1]
    by_cases e3 : j = NLogN.KFV.vY
    · subst e3; simp +decide [hF', hf4, hf3, hf2, hf1]
    by_cases e4 : j = NLogN.KFV.vO
    · subst e4; simp +decide [hF', hf4, hf3, hf2, hf1, NLogN.KFV.kmulN, hE NLogN.KFV.vO (by decide) (by decide)]
    by_cases e5 : j = NLogN.KFV.vA
    · subst e5; simp +decide [hF', hf4, hf3, hf2, hf1, hE NLogN.KFV.vA (by decide) (by decide)]
    by_cases e6 : j = NLogN.KFV.vB
    · subst e6; simp +decide [hF', hf4, hf3, hf2, hf1, hE NLogN.KFV.vB (by decide) (by decide)]
    simp [hF', hf4, hf3, hf2, hf1, Function.update_of_ne, e1, e2, e3, e4, e5, e6]
  obtain ⟨sk, hsk⟩ : ∃ sk : ℕ → NLogN.IState NLogN.HS, sk = fun k => s.upd NLogN.KFV.vZ (NLogN.KFC.marks (N - k) ++ s.G NLogN.KFV.vZ) :=
    ⟨_, rfl⟩
  have fZ : f NLogN.KFV.vZ = [] := hE NLogN.KFV.vZ (by decide) (by decide)
  have FZ : ∀ k, F k NLogN.KFV.vZ = [] := fun k => by simp +decide [hF', fZ]
  -- toUL
  have t1 := NLogN.KFC.toUL_runs (I := I) (iprog := iprog) (A := NLogN.KFV.vRH) (X := NLogN.KFV.vZ) (by decide) (by decide)
    (by decide) (by decide) (by decide) (NLogN.KIL.encK s f4) N LN
    (by simp +decide [hf4, hf3, hf2, hf1, hE NLogN.KFV.vRH (by decide) (by decide), hN])
    (by simpa [show f4 NLogN.KFV.vZ = [] by simp +decide [hf4, hf3, hf2, hf1, fZ]] using hZ)
  rw [← NLogN.KIL.encK_upd_free s f4 NLogN.KFV.vZ (by simp +decide [hf4, hf3, hf2, hf1, fZ]),
    show (NLogN.KIL.encK s f4).G NLogN.KFV.vZ = s.G NLogN.KFV.vZ by simp +decide [hf4, hf3, hf2, hf1, fZ]] at t1
  -- one iteration
  have hπ := NLogN.KFV.πR_low (2 ^ p) r (NLogN.KFV.kG b r (2 ^ p)) ((2 : ℤ) ^ b) ((2 ^ b) ^ (2 * r)) (2 ^ (p + ρ))
  have body : ∀ k < N, NLogN.IRuns I iprog (.seq (.op (.unmark NLogN.KFV.vZ)) (NLogN.KFV.recU pM)) (NLogN.KIL.encK (sk k) (F k))
      (NLogN.KIL.encK (sk (k + 1)) (F (k + 1))) (1 + 2000 * NLogN.KFV.cRec r p b (p + ρ) φ) := by
    intro k hk
    have hNk : N - k = (N - (k + 1)) + 1 := by omega
    have u := NLogN.IRuns.unmark (I := I) (iprog := iprog) (s := NLogN.KIL.encK (sk k) (F k)) (i := NLogN.KFV.vZ)
      (L := NLogN.KFC.marks (N - (k + 1)) ++ s.G NLogN.KFV.vZ) (by simp [hsk, FZ, hNk, NLogN.KFC.marks_succ])
    rw [← NLogN.KIL.encK_upd_free _ _ NLogN.KFV.vZ (FZ k)] at u
    have esk : (sk k).upd NLogN.KFV.vZ (NLogN.KFC.marks (N - (k + 1)) ++ s.G NLogN.KFV.vZ) = sk (k + 1) := by
      simp [hsk]
    rw [esk] at u
    have hk1 : (k + 1) * r ≤ N * r := Nat.mul_le_mul_right _ hk
    have lx := NLogN.KFV.length_blk hlf hk
    have ly := NLogN.KFV.length_blk hlg hk
    have R := NLogN.KFV.recU_runs (I := I) (iprog := iprog) hM hdom (ρ := ρ) hΦ hb hr hbig (sk (k + 1)) (F k)
      (NLogN.KFV.blk r k zf) (NLogN.KFV.blk r k zg) (NLogN.KFB.gflat (zf.drop ((k + 1) * r))) (NLogN.KFB.gflat (zg.drop ((k + 1) * r)))
      (by simp +decide [hF']; rw [NLogN.KFV.drop_blk r k zf, NLogN.KFB.gflat_append])
      (by simp +decide [hF']; rw [NLogN.KFV.drop_blk r k zg, NLogN.KFB.gflat_append]) lx ly
      (fun z hz => hzf z (NLogN.KFV.mem_blk hz)) (fun z hz => hzg z (NLogN.KFV.mem_blk hz))
      ⟨by simp +decide [hF', hE NLogN.KFV.vA (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vB (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vC (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vE (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vPA (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vPB (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vPC (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vPE (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vM1 (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vM2 (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vM3 (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vM4 (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vZ (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFT.tX (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vRH (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vT (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vT2 (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vT4 (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vOR (by decide) (by decide)], by simp +decide [hF', hE NLogN.KFV.vOI (by decide) (by decide)],
        by simp +decide [hF', hE NLogN.KFV.vL (by decide) (by decide)]⟩
      (fun i v hv => by
        obtain ⟨L, hL⟩ := hP i v hv
        exact ⟨L, by simp [hsk]; rw [if_neg (by rintro rfl; exact absurd (NLogN.KFV.πR_some hv) (by decide))]; exact hL⟩)
      (by rw [hF']; exact (((hF.upd (by decide)).upd (by decide)).upd (by decide)).upd (by decide))
    refine (u.seq R).mono' ?_ le_rfl
    congr 1
    funext j
    simp only [hF', Function.update_apply]
    split_ifs <;> simp_all [NLogN.KFV.kmulN_succ, NLogN.KFB.gflat_append]
  -- the loop
  have LP := NLogN.IRuns.loop' (I := I) (iprog := iprog) (i := NLogN.KFV.vZ) (f := NLogN.KFC.isMk)
    (p := .seq (.op (.unmark NLogN.KFV.vZ)) (NLogN.KFV.recU pM)) (fun k => NLogN.KIL.encK (sk k) (F k))
    (1 + 2000 * NLogN.KFV.cRec r p b (p + ρ) φ) N
    (by
      intro k hk
      obtain ⟨j, hj⟩ : ∃ j, N - k = j + 1 := ⟨N - k - 1, by omega⟩
      simp only [NLogN.IState.cl_def]
      rw [show (NLogN.KIL.encK (sk k) (F k)).G NLogN.KFV.vZ = NLogN.KFC.marks (j + 1) ++ s.G NLogN.KFV.vZ by simp [hsk, FZ, hj]]
      exact NLogN.KFC.isMk_marks_succ _ _)
    (by
      simp only [NLogN.IState.cl_def]
      rw [show (NLogN.KIL.encK (sk N) (F N)).G NLogN.KFV.vZ = s.G NLogN.KFV.vZ by simp [hsk, FZ]]
      exact NLogN.KFC.isMk_NM hZ)
    body
  have e0 : NLogN.KIL.encK (s.upd NLogN.KFV.vZ (NLogN.KFC.marks N ++ s.G NLogN.KFV.vZ)) f4 = NLogN.KIL.encK (sk 0) (F 0) := by
    rw [hF0]; simp [hsk]
  rw [e0] at t1
  have eN : sk N = s := by simp [hsk, NLogN.KFC.marks]
  simp only [eN] at LP
  -- the output move
  have lK : (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ N zf zg)).reverse.length = 2 * (N * r) := by
    simp [NLogN.KFV.length_kmulN]
  have gK : NLogN.KFB.GB (b + 2) (NLogN.KFV.kmulN r p ρ N zf zg) := by
    intro z hz
    simp only [NLogN.KFV.kmulN, List.mem_flatMap, List.mem_range] at hz
    obtain ⟨j, hj, hz⟩ := hz
    exact NLogN.KFV.kmul_bnd hb hbig (fun z hz => hzf z (NLogN.KFV.mem_blk hz)) (fun z hz => hzg z (NLogN.KFV.mem_blk hz)) z hz
  have m5 := NLogN.KFD.FSp.mvR (X := NLogN.KFV.vO) (Y := 0) (C := NLogN.KFV.vL) (r := NLogN.KFV.vT) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by decide) s (F N) (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ N zf zg)).reverse []
    (by simp +decide [hF'])
    (Lr := LM) (by rw [lK]; simp +decide [hF', hE NLogN.KFV.vT (by decide) (by decide), hNr])
    (b + 2) Bb (NLogN.bnd_reverse gK.bnd) (by rw [lK])
  rw [List.reverse_reverse, lK] at m5
  have eF : Function.update (Function.update (F N) NLogN.KFV.vO []) 0
      (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ N zf zg) ++ F N 0) = Function.update f 0 (NLogN.KFB.gflat (NLogN.KFV.kmulN r p ρ N zf zg) ++ l) := by
    have dx : zf.drop (N * r) = [] := List.drop_eq_nil_of_le (by omega)
    have dy : zg.drop (N * r) = [] := List.drop_eq_nil_of_le (by omega)
    funext j
    by_cases e1 : j = 0
    · subst e1; simp +decide [hF']
    by_cases e2 : j = NLogN.KFV.vX
    · subst e2; simp +decide [hF', dx, hE NLogN.KFV.vX (by decide) (by decide)]
    by_cases e3 : j = NLogN.KFV.vY
    · subst e3; simp +decide [hF', dy, hE NLogN.KFV.vY (by decide) (by decide)]
    by_cases e4 : j = NLogN.KFV.vO
    · subst e4; simp +decide [hF', hE NLogN.KFV.vO (by decide) (by decide)]
    simp [hF', Function.update_of_ne, e1, e2, e3, e4]
  rw [eF] at m5
  have i1 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (by rw [NLogN.KFD.fok_mvK_eq]; decide) m1
  have i2 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (by rw [NLogN.KFD.fok_mvK_eq]; decide) m2
  have i3 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (by rw [NLogN.KFD.fok_mvK_eq]; decide) m3
  have i4 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (by rw [NLogN.KFD.fok_mvK_eq]; decide) m4
  have i5 := NLogN.KFD.FSp.irun (I := I) (iprog := iprog) (by rw [NLogN.KFD.fok_mvK_eq]; decide) m5
  simp only [lf, lg, show p + 2 + 2 = p + 4 by ring, show b + 2 + 2 = b + 4 by ring] at i1 i2 i3 i4 i5
  refine (i1.seq (i2.seq (i3.seq (i4.seq (t1.seq (LP.seq i5)))))).mono' rfl ?_
  simp only [NLogN.KFV.cKron]
  rw [← hBb]; omega
end
