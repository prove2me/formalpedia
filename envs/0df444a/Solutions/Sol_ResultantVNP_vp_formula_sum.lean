namespace WiredTransitionControl

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan IndexedStateEncoding
  IndexedPlanControl BooleanVerifierFormula WiredStackControl

variable {σ : Type}

noncomputable def planChecker (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    BoolFormula (Fin (totalWidth C.nodes.length D N)) :=
  IndexedPlanControl.planChecker C D
    (fun i => oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 i.succ))
    (oldVar C.nodes.length D N (inputCoord C.nodes.length D N ⟨0,hN⟩ 1))
    (fun j => planVar C.nodes.length D N j)

theorem planChecker_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (p : {p : Plan // p.bounded C.nodes.length D}) :
    (planChecker C D N hN).test (assignment C.nodes.length D N s t p) = true ↔
      p.val = plan C a b := by
  let m := C.nodes.length
  let input := fun i : Fin (tagWordLength m D) => oldVar m D N (stackCoord m D N 0 i.succ)
  let branch := oldVar m D N (inputCoord m D N ⟨0,hN⟩ 1)
  let output := fun j : Fin (planWidth m D) => planVar m D N j
  let v := assignment m D N s t p
  have hin : ∀ i, v (input i) = tagWord m D ⟨a,ha⟩ i := by
    intro i
    change assignment m D N s t p (oldVar m D N (stackCoord m D N 0 i.succ)) = _
    rw [assignment_old]
    exact stateWord_topTag m D N s a rest hp ha i
  have hbranch : v branch = b := by
    change assignment m D N s t p (oldVar m D N (inputCoord m D N ⟨0,hN⟩ 1)) = b
    rw [assignment_old]
    exact stateWord_inputHead m D N s hN b bits hb
  change (IndexedPlanControl.planChecker C D input branch output).test v = true ↔ _
  rw [planChecker_correct C D input branch output v ⟨a,ha⟩ hin]
  simp only [hbranch]
  have hout : ∀ j, v (output j) = planWord m D p j := by
    intro j
    exact assignment_plan m D N s t p j
  simp only [hout]
  constructor
  · intro h
    exact congrArg Subtype.val ((planWord_injective m D) (funext h))
  · intro h
    have he : p = boundedPlan C D ⟨a,ha⟩ b := Subtype.ext h
    intro j
    rw [he]

noncomputable def checker (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    BoolFormula (Fin (totalWidth C.nodes.length D N)) :=
  .and (planChecker C D N hN)
    (.and (WiredStackControl.checker C.nodes.length D N)
      (.and (WiredFactorControl.checker C.nodes.length D N) (WiredInputControl.checker C.nodes.length D N)))

/-- Under the stated running-state assumptions, acceptance is equivalent to
    both the proposed control plan and the complete next state being correct. -/
theorem checker_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t u : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val) (p : {p : Plan // p.bounded C.nodes.length D}) :
    (checker C D N hN).test (assignment C.nodes.length D N s u p) = true ↔
      p.val = plan C a b ∧ u.val = t.val := by
  simp only [checker,BoolFormula.test,Bool.and_eq_true]
  constructor
  · rintro ⟨hpcheck,hscheck,hfcheck,hicheck⟩
    have hplan := (planChecker_iff C D N hN s u a rest hp ha b bits hb p).mp hpcheck
    have he : p = boundedPlan C D ⟨a,ha⟩ b := Subtype.ext hplan
    subst p
    have hstack := WiredStackControl.checker_forces_stack C D N s t u a rest hp ha b bits hb hstep hscheck
    have hfactors := WiredFactorControl.checker_forces_factors C D N s t u a rest hp ha b bits hb hstep hfcheck
    have hinput := WiredInputControl.checker_forces_input C D N s t u a rest hp ha b bits hb hstep hicheck
    refine ⟨rfl,?_⟩
    cases hu : u.val with
    | mk up ub uf =>
      cases ht : t.val with
      | mk tp tb tf =>
        simp only [hu,ht] at hstack hfactors hinput ⊢
        subst tp; subst tb; subst tf; rfl
  · rintro ⟨hplan,hstate⟩
    have he : p = boundedPlan C D ⟨a,ha⟩ b := Subtype.ext hplan
    have hu : u = t := Subtype.ext hstate
    subst p
    subst u
    exact ⟨(planChecker_iff C D N hN s t a rest hp ha b bits hb _).mpr rfl,
      WiredStackControl.checker_accepts_step C D N s t a rest hp ha b bits hb hstep,
      WiredFactorControl.checker_accepts_step C D N s t a rest hp ha b bits hb hstep,
      WiredInputControl.checker_accepts_step C D N s t a rest hp ha b bits hb hstep⟩

theorem checker_nodes (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    (checker C D N hN).nodes ≤
      (2 * planWidth C.nodes.length D * (2 * IndexedTagControl.tagLookupBound C.nodes.length D + 8) + 8) +
      (38 * ((N+1)*(tagWordLength C.nodes.length D+1)) + 1) +
      (24 * (N*((3+(C.nodes.length+1))+1)) + 1) + (24 * (N*(1+1)) + 1) + 3 := by
  have hplan : (planChecker C D N hN).nodes ≤
      2 * planWidth C.nodes.length D * (2 * IndexedTagControl.tagLookupBound C.nodes.length D + 8) + 8 := by
    unfold planChecker
    exact IndexedPlanControl.planChecker_nodes C D _ _ _
  have hs := WiredStackControl.checker_nodes C.nodes.length D N
  have hf := WiredFactorControl.checker_nodes C.nodes.length D N
  have hi := WiredInputControl.checker_nodes C.nodes.length D N
  simp only [checker,BoolFormula.nodes]
  omega


end WiredTransitionControl

-- From Solutions.WiredTotalTransition

/-! Combine the running-state checker with a canonical halted-state update.
    The sentinel invariant supplies a nonempty input stream for running states. -/

namespace WiredTotalTransition

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan IndexedStateEncoding
  IndexedPlanControl BooleanVerifierFormula BooleanVectorControl WiredStackControl

variable {σ : Type}

def haltPlan (m D : ℕ) : {p : Plan // p.bounded m D} :=
  ⟨⟨[],false,none⟩, by simp [Plan.bounded]⟩

def haltChecker (m D N : ℕ) : BoolFormula (Fin (totalWidth m D N)) :=
  .and (equalChecker (stateWidth m D N) (oldVar m D N) (nextVar m D N))
    (constantChecker (planWidth m D) (planVar m D N) (planWord m D (haltPlan m D)))

theorem haltChecker_iff (m D N : ℕ) (s t : {s : State // admissible m D N s})
    (p : {p : Plan // p.bounded m D}) :
    (haltChecker m D N).test (assignment m D N s t p) = true ↔
      s.val = t.val ∧ p.val = (haltPlan m D).val := by
  simp only [haltChecker,BoolFormula.test,Bool.and_eq_true,equalChecker_correct,constantChecker_correct,
    assignment_old,assignment_next,assignment_plan]
  constructor
  · rintro ⟨hs,hp⟩
    exact ⟨congrArg Subtype.val ((stateWord_injective m D N) (funext hs)),
      congrArg Subtype.val ((planWord_injective m D) (funext hp))⟩
  · rintro ⟨hs,hp⟩
    have hst : s = t := Subtype.ext hs
    have hpt : p = haltPlan m D := Subtype.ext hp
    subst t
    subst p
    exact ⟨fun _ => rfl,fun _ => rfl⟩

noncomputable def checker (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    BoolFormula (Fin (totalWidth C.nodes.length D N)) :=
  let active := BoolFormula.bit (oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 0))
  .or (.and active (WiredTransitionControl.checker C D N hN))
    (.and (.not active) (haltChecker C.nodes.length D N))

theorem checker_running (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t u : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val) (p : {p : Plan // p.bounded C.nodes.length D}) :
    (checker C D N hN).test (assignment C.nodes.length D N s u p) = true ↔
      p.val = plan C a b ∧ u.val = t.val := by
  have htop : assignment C.nodes.length D N s u p
      (oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 0)) = true := by
    rw [assignment_old]
    exact stateWord_topPresent _ _ _ s a rest hp
  simp only [checker,BoolFormula.test,htop,Bool.true_and,Bool.not_true,Bool.false_and,Bool.or_false]
  exact WiredTransitionControl.checker_iff C D N hN s t u a rest hp ha b bits hb hstep p

theorem checker_halted (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s u : {s : State // admissible C.nodes.length D N s}) (hp : s.val.pending = [])
    (p : {p : Plan // p.bounded C.nodes.length D}) :
    (checker C D N hN).test (assignment C.nodes.length D N s u p) = true ↔
      s.val = u.val ∧ p.val = (haltPlan C.nodes.length D).val := by
  have htop : assignment C.nodes.length D N s u p
      (oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 0)) = false := by
    rw [assignment_old]
    exact stateWord_topAbsent _ _ _ s hp
  simp only [checker,BoolFormula.test,htop,Bool.false_and,Bool.not_false,Bool.true_and,Bool.false_or]
  exact haltChecker_iff _ _ _ s u p

theorem haltChecker_nodes (m D N : ℕ) :
    (haltChecker m D N).nodes ≤ 10 * stateWidth m D N + 10 * planWidth m D + 3 := by
  have h₁ := equalChecker_nodes (stateWidth m D N) (oldVar m D N) (nextVar m D N)
  have h₂ := constantChecker_nodes (planWidth m D) (planVar m D N) (planWord m D (haltPlan m D))
  simp only [haltChecker,BoolFormula.nodes]
  omega

theorem checker_nodes (C : Circuit σ) (D N : ℕ) (hN : 0 < N) :
    (checker C D N hN).nodes ≤
      (WiredTransitionControl.checker C D N hN).nodes +
        10 * stateWidth C.nodes.length D N + 10 * planWidth C.nodes.length D + 9 := by
  have hh := haltChecker_nodes C.nodes.length D N
  simp only [checker,BoolFormula.nodes]
  omega


end WiredTotalTransition

-- From Solutions.RawTransitionSoundness

/-! Soundness for arbitrary proposed next-state and plan bit strings. The
    induction for a transcript can therefore start with one valid encoded
    state and does not need to assume later bit strings already decode. -/

namespace RawTransitionSoundness

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan IndexedStateEncoding
  IndexedPlanControl BooleanVerifierFormula BooleanVectorControl WiredStackControl

variable {σ : Type}

theorem running_checker_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val)
    (next : Fin (stateWidth C.nodes.length D N) → Bool)
    (planBits : Fin (planWidth C.nodes.length D) → Bool) :
    (WiredTransitionControl.checker C D N hN).test
        (rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits) = true ↔
      planBits = planWord C.nodes.length D (boundedPlan C D ⟨a,ha⟩ b) ∧
      next = stateWord C.nodes.length D N t := by
  let m := C.nodes.length
  let old := stateWord m D N s
  let p := boundedPlan C D ⟨a,ha⟩ b
  let v := rawAssignment m D N old next planBits
  let input := fun i : Fin (tagWordLength m D) => oldVar m D N (stackCoord m D N 0 i.succ)
  let branch := oldVar m D N (inputCoord m D N ⟨0,hN⟩ 1)
  let output := fun j : Fin (planWidth m D) => planVar m D N j
  have hin : ∀ i, v (input i) = tagWord m D ⟨a,ha⟩ i := by
    intro i
    change rawAssignment m D N old next planBits (oldVar m D N (stackCoord m D N 0 i.succ)) = _
    rw [rawAssignment_old]
    exact stateWord_topTag m D N s a rest hp ha i
  have hbranch : v branch = b := by
    change rawAssignment m D N old next planBits (oldVar m D N (inputCoord m D N ⟨0,hN⟩ 1)) = _
    rw [rawAssignment_old]
    exact stateWord_inputHead m D N s hN b bits hb
  have hplan : (WiredTransitionControl.planChecker C D N hN).test v = true ↔
      planBits = planWord m D p := by
    change (IndexedPlanControl.planChecker C D input branch output).test v = true ↔ _
    rw [planChecker_correct C D input branch output v ⟨a,ha⟩ hin]
    simp only [hbranch]
    have hout : ∀ j, v (output j) = planBits j := by
      intro j
      exact rawAssignment_plan m D N old next planBits j
    simp only [hout]
    exact ⟨fun h => funext h, fun h j => congrFun h j⟩
  change (WiredTransitionControl.checker C D N hN).test v = true ↔ _
  simp only [WiredTransitionControl.checker,BoolFormula.test,Bool.and_eq_true]
  constructor
  · rintro ⟨hc,hs,hf,hi⟩
    have hpb := hplan.mp hc
    subst planBits
    refine ⟨rfl,?_⟩
    apply stateBits_ext m D N next (stateWord m D N t)
    · intro i j
      have hh := (WiredStackControl.checker_iff m D N v).mp hs i j
      rw [show v (nextVar m D N (stackCoord m D N i j)) = next (stackCoord m D N i j) from
        rawAssignment_next _ _ _ _ _ _ _,
        WiredStackControl.expected_raw_next_irrelevant m D N old next (stateWord m D N t) (planWord m D p)] at hh
      change next _ = (WiredStackControl.expected m D N i j).test (assignment m D N s t p) at hh
      rw [WiredStackControl.expected_step C D N s t a rest hp ha b bits hb hstep] at hh
      exact hh
    · intro i j
      have hh := (WiredFactorControl.checker_iff m D N v).mp hf i j
      rw [show v (nextVar m D N (factorCoord m D N i j)) = next (factorCoord m D N i j) from
        rawAssignment_next _ _ _ _ _ _ _,
        WiredFactorControl.expected_raw_next_irrelevant m D N old next (stateWord m D N t) (planWord m D p)] at hh
      change next _ = (WiredFactorControl.expected m D N i j).test (assignment m D N s t p) at hh
      rw [WiredFactorControl.expected_step C D N s t a rest hp ha b bits hb hstep] at hh
      exact hh
    · intro i j
      have hh := (WiredInputControl.checker_iff m D N v).mp hi i j
      rw [show v (nextVar m D N (inputCoord m D N i j)) = next (inputCoord m D N i j) from
        rawAssignment_next _ _ _ _ _ _ _,
        WiredInputControl.expected_raw_next_irrelevant m D N old next (stateWord m D N t) (planWord m D p)] at hh
      change next _ = (WiredInputControl.expected m D N i j).test (assignment m D N s t p) at hh
      rw [WiredInputControl.expected_step C D N s t a rest hp ha b bits hb hstep] at hh
      exact hh
  · rintro ⟨rfl,rfl⟩
    have hacc := (WiredTransitionControl.checker_iff C D N hN s t t a rest hp ha b bits hb hstep p).mpr ⟨rfl,rfl⟩
    simp only [WiredTransitionControl.checker,BoolFormula.test,Bool.and_eq_true] at hacc
    exact hacc

theorem total_running_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t : {s : State // admissible C.nodes.length D N s})
    (a : Tag) (rest : List Tag) (hp : s.val.pending = a :: rest)
    (ha : a.bounded C.nodes.length D) (b : Bool) (bits : List Bool) (hb : s.val.bits = b :: bits)
    (hstep : step C s.val = some t.val)
    (next : Fin (stateWidth C.nodes.length D N) → Bool)
    (planBits : Fin (planWidth C.nodes.length D) → Bool) :
    (WiredTotalTransition.checker C D N hN).test
        (rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits) = true ↔
      planBits = planWord C.nodes.length D (boundedPlan C D ⟨a,ha⟩ b) ∧
      next = stateWord C.nodes.length D N t := by
  have htop : rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits
      (oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 0)) = true := by
    rw [rawAssignment_old]
    exact stateWord_topPresent _ _ _ s a rest hp
  simp only [WiredTotalTransition.checker,BoolFormula.test,htop,Bool.true_and,Bool.not_true,
    Bool.false_and,Bool.or_false]
  exact running_checker_iff C D N hN s t a rest hp ha b bits hb hstep next planBits

theorem total_halted_iff (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s : {s : State // admissible C.nodes.length D N s}) (hp : s.val.pending = [])
    (next : Fin (stateWidth C.nodes.length D N) → Bool)
    (planBits : Fin (planWidth C.nodes.length D) → Bool) :
    (WiredTotalTransition.checker C D N hN).test
        (rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits) = true ↔
      planBits = planWord C.nodes.length D (WiredTotalTransition.haltPlan C.nodes.length D) ∧
      next = stateWord C.nodes.length D N s := by
  have htop : rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits
      (oldVar C.nodes.length D N (stackCoord C.nodes.length D N 0 0)) = false := by
    rw [rawAssignment_old]
    exact stateWord_topAbsent _ _ _ s hp
  simp only [WiredTotalTransition.checker,BoolFormula.test,htop,Bool.false_and,Bool.not_false,
    Bool.true_and,Bool.false_or,WiredTotalTransition.haltChecker,Bool.and_eq_true,
    equalChecker_correct,constantChecker_correct,rawAssignment_old,rawAssignment_next,rawAssignment_plan]
  constructor
  · rintro ⟨hn,hp'⟩
    exact ⟨funext hp',(funext hn).symm⟩
  · rintro ⟨hp',hn⟩
    subst planBits
    subst next
    exact ⟨fun _ => rfl,fun _ => rfl⟩


end RawTransitionSoundness

-- From Solutions.SentinelExecution

/-! Add one trailing zero to ensure the decoder input stays nonempty for the
    entire bounded run. The trailing zero does not affect the padding test. -/

namespace SentinelExecution

open ResultantVNP PermanentFoundation IndexedFactorMachine IndexedStateEncoding
  CircuitNormalizedFormula CircuitFixedCodes CircuitParseCodes MvPolynomial

variable {σ : Type}

theorem padding_append_false (bits : List Bool) :
    bits ++ [false] = List.replicate (bits ++ [false]).length false ↔
      bits = List.replicate bits.length false := by
  have hrep : List.replicate (bits.length + 1) false = List.replicate bits.length false ++ [false] := by
    rw [List.replicate_add]
    rfl
  simp only [List.length_append,List.length_cons,List.length_nil,Nat.zero_add,hrep,List.append_cancel_right_eq]

/-- Run the indexed decoder with a trailing zero and recover its original
    decoded weight from the final factor list and padding test. -/
theorem sentinel_run [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ s, run C N (some (initial C d (List.ofFn z ++ [false]))) = some s ∧
      s.pending = [] ∧ s.factors.length ≤ N ∧
      decodedWeight (boundedCircuitFormula C d) N z =
        if s.bits = List.replicate s.bits.length false then
          (s.factors.map (fun l => (leafFormula C l).value)).prod else 0 := by
  dsimp only
  let N := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
  let bits := List.ofFn z
  have hlen : bits.length = N := List.length_ofFn
  obtain ⟨T,suffix,fstate,hdecode,hfrun,hfpending,hfbits,hfprod,hfsize⟩ :=
    ParseFactorMachine.boundedCircuit_factors_extension C d hdegree bits [false] hlen
  let ainit := AddressFactorMachine.initial C d (bits ++ [false])
  have hasim := AddressFactorMachine.run_forget N (some ainit)
  rw [show (some ainit).map AddressFactorMachine.forget =
      some (ParseFactorMachine.initial (boundedCircuitFormula C d) (bits ++ [false])) by
        change some (AddressFactorMachine.forget ainit) = _
        exact congrArg some (AddressFactorMachine.initial_forget C d (bits ++ [false])), hfrun] at hasim
  obtain ⟨astate,harun,haforget⟩ := Option.map_eq_some_iff.mp hasim
  let iinit := initial C d (bits ++ [false])
  have hisim := run_forget C N (some iinit)
  rw [show (some iinit).map (forget C) = some ainit by
        change some (forget C iinit) = some ainit
        exact congrArg some (initial_forget C d (bits ++ [false])), harun] at hisim
  obtain ⟨s,hsrun,hsforget⟩ := Option.map_eq_some_iff.mp hisim
  have hpending : s.pending = [] := by
    have ha : astate.pending = [] := by
      have hh := congrArg ParseFactorMachine.State.pending haforget
      simp only [AddressFactorMachine.forget] at hh
      rw [hfpending] at hh
      cases he : astate.pending with
      | nil => rfl
      | cons x xs => simp [he] at hh
    have hh := congrArg AddressFactorMachine.State.pending hsforget
    simp only [forget] at hh
    rw [ha] at hh
    cases he : s.pending with
    | nil => rfl
    | cons x xs => simp [he] at hh
  have hbits : s.bits = suffix ++ [false] := by
    have h₁ := congrArg AddressFactorMachine.State.bits hsforget
    have h₂ := congrArg ParseFactorMachine.State.bits haforget
    simpa [forget,AddressFactorMachine.forget,hfbits] using h₁.trans h₂
  have hfactors : (s.factors.map (fun l => (leafFormula C l).value)).prod = T.value := by
    have h₁ := congrArg AddressFactorMachine.State.factors hsforget
    have h₂ := congrArg ParseFactorMachine.State.factors haforget
    have hh := h₁.trans h₂
    simp only [forget,AddressFactorMachine.forget] at hh
    rw [← hh] at hfprod
    simpa [List.map_map,Function.comp_def] using hfprod
  have hsize : s.factors.length ≤ N := by
    have h₁ := congrArg AddressFactorMachine.State.factors hsforget
    have h₂ := congrArg ParseFactorMachine.State.factors haforget
    have hh := congrArg List.length (h₁.trans h₂)
    simp only [forget,AddressFactorMachine.forget,List.length_map] at hh
    omega
  refine ⟨s,hsrun,hpending,hsize,?_⟩
  change decode (boundedCircuitFormula C d) (List.ofFn z) = some (T,suffix) at hdecode
  simp only [decodedWeight,hdecode,hbits,hfactors,padding_append_false]

/-- With the sentinel, every state reached in at most `N` steps has a
    nonempty input stream, so the ordinary transition checker applies. -/
theorem sentinel_input_nonempty (C : Circuit σ) (d N n : ℕ) (bits : List Bool)
    (hlen : bits.length = N) (hn : n ≤ N) (s : State)
    (hrun : run C n (some (initial C d (bits ++ [false]))) = some s) :
    s.bits ≠ [] := by
  have h := run_input_lower C n (initial C d (bits ++ [false])) s hrun
  have hpositive : 0 < s.bits.length := by simp only [initial,List.length_append,List.length_cons,
    List.length_nil,Nat.add_zero,hlen] at h; omega
  exact List.length_pos_iff.mp hpositive


end SentinelExecution

-- From Solutions.WiredTranscript

/-! Place one encoded state at each time and one encoded plan at each
    transition; reuse the verified one-step checker without introducing
    auxiliary variables inside the checker. -/

namespace WiredTranscript

open ResultantVNP IndexedNormalizedAddresses IndexedFactorMachine IndexedPlan IndexedStateEncoding
  IndexedPlanControl BooleanVerifierFormula WiredStackControl

variable {σ : Type}

def width (S P T : ℕ) : ℕ := (T+1)*S + T*P

def stateCoord (S P T : ℕ) (t : Fin (T+1)) (i : Fin S) : Fin (width S P T) :=
  Fin.castAdd (T*P) (finProdFinEquiv (t,i))

def planCoord (S P T : ℕ) (t : Fin T) (i : Fin P) : Fin (width S P T) :=
  Fin.natAdd ((T+1)*S) (finProdFinEquiv (t,i))

def stateAt (S P T : ℕ) (v : Fin (width S P T) → Bool) (t : Fin (T+1)) : Fin S → Bool :=
  fun i => v (stateCoord S P T t i)

def planAt (S P T : ℕ) (v : Fin (width S P T) → Bool) (t : Fin T) : Fin P → Bool :=
  fun i => v (planCoord S P T t i)

/-- A bit string contains exactly a sequence of state words and plan words. -/
def encode (S P T : ℕ) (states : Fin (T+1) → Fin S → Bool)
    (plans : Fin T → Fin P → Bool) : Fin (width S P T) → Bool :=
  Fin.append (fun u => states (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2)
    (fun u => plans (finProdFinEquiv.symm u).1 (finProdFinEquiv.symm u).2)

theorem stateAt_encode (S P T : ℕ) (states : Fin (T+1) → Fin S → Bool)
    (plans : Fin T → Fin P → Bool) (t : Fin (T+1)) :
    stateAt S P T (encode S P T states plans) t = states t := by
  funext i
  simp only [stateAt,stateCoord,encode,Fin.append_left,Equiv.symm_apply_apply]

theorem planAt_encode (S P T : ℕ) (states : Fin (T+1) → Fin S → Bool)
    (plans : Fin T → Fin P → Bool) (t : Fin T) :
    planAt S P T (encode S P T states plans) t = plans t := by
  funext i
  simp only [planAt,planCoord,encode,Fin.append_right,Equiv.symm_apply_apply]

theorem encode_eta (S P T : ℕ) (v : Fin (width S P T) → Bool) :
    encode S P T (stateAt S P T v) (planAt S P T v) = v := by
  funext i
  refine Fin.addCases (fun a => ?_) (fun b => ?_) i
  · have h := congrFun (stateAt_encode S P T (stateAt S P T v) (planAt S P T v)
        (finProdFinEquiv.symm a).1) (finProdFinEquiv.symm a).2
    simpa only [stateAt,stateCoord,Prod.mk.eta,Equiv.apply_symm_apply] using h
  · have h := congrFun (planAt_encode S P T (stateAt S P T v) (planAt S P T v)
        (finProdFinEquiv.symm b).1) (finProdFinEquiv.symm b).2
    simpa only [planAt,planCoord,Prod.mk.eta,Equiv.apply_symm_apply] using h

/-- Determinism at the canonical states gives a unique entire transcript,
    even when the proposed states and plans are arbitrary bit strings. -/
theorem unique_chain {S P T : ℕ}
    (rel : Fin T → (Fin S → Bool) → (Fin P → Bool) → (Fin S → Bool) → Prop)
    (states : Fin (T+1) → Fin S → Bool) (plans : Fin T → Fin P → Bool)
    (hdet : ∀ t p next, rel t (states t.castSucc) p next ↔
      p = plans t ∧ next = states t.succ)
    (v : Fin (width S P T) → Bool) :
    (stateAt S P T v 0 = states 0 ∧
      ∀ t, rel t (stateAt S P T v t.castSucc) (planAt S P T v t)
        (stateAt S P T v t.succ)) ↔ v = encode S P T states plans := by
  constructor
  · rintro ⟨hzero,hsteps⟩
    have hs : ∀ t : Fin (T+1), stateAt S P T v t = states t := by
      intro t
      induction t using Fin.induction with
      | zero => exact hzero
      | @succ i ih =>
        have h := hsteps i
        rw [ih] at h
        exact ((hdet i _ _).mp h).2
    have hp : ∀ t : Fin T, planAt S P T v t = plans t := by
      intro t
      have h := hsteps t
      rw [hs t.castSucc] at h
      exact ((hdet t _ _).mp h).1
    rw [← encode_eta S P T v, funext hs, funext hp]
  · intro h
    subst v
    simp only [stateAt_encode,planAt_encode]
    exact ⟨True.intro,fun t => (hdet t _ _).mpr ⟨rfl,rfl⟩⟩

/-- Select the old state, new state and plan for one transition. -/
def transitionWire (S P T : ℕ) (t : Fin T) : Fin (S + (S+P)) → Fin (width S P T) :=
  Fin.addCases (stateCoord S P T t.castSucc)
    (Fin.addCases (stateCoord S P T t.succ) (planCoord S P T t))

theorem transitionWire_assignment (S P T : ℕ) (v : Fin (width S P T) → Bool) (t : Fin T) :
    (v ∘ transitionWire S P T t) =
      Fin.append (stateAt S P T v t.castSucc) (Fin.append (stateAt S P T v t.succ) (planAt S P T v t)) := by
  funext i
  refine Fin.addCases (fun x => ?_) (fun y => ?_) i
  · simp [transitionWire,Function.comp_def,Fin.addCases_left,Fin.append_left,stateAt]
  · refine Fin.addCases (fun x => ?_) (fun z => ?_) y
    · simp [transitionWire,Function.comp_def,Fin.addCases_right,Fin.addCases_left,
        Fin.append_right,Fin.append_left,stateAt]
    · simp [transitionWire,Function.comp_def,Fin.addCases_right,Fin.append_right,planAt]

noncomputable def transitionChecks (C : Circuit σ) (D N T : ℕ) (hN : 0 < N) :
    List (BoolFormula (Fin (width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T))) :=
  List.ofFn fun t => (WiredTotalTransition.checker C D N hN).rename
    (transitionWire (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T t)

noncomputable def checker (C : Circuit σ) (D N T : ℕ) (hN : 0 < N) :
    BoolFormula (Fin (width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T)) :=
  conjunction (transitionChecks C D N T hN)

set_option backward.isDefEq.respectTransparency false in
theorem checker_correct (C : Circuit σ) (D N T : ℕ) (hN : 0 < N)
    (v : Fin (width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T) → Bool) :
    (checker C D N T hN).test v = true ↔
      ∀ t : Fin T, (WiredTotalTransition.checker C D N hN).test
        (rawAssignment C.nodes.length D N
          (stateAt _ _ _ v t.castSucc) (stateAt _ _ _ v t.succ) (planAt _ _ _ v t)) = true := by
  unfold totalWidth at *
  rw [checker,conjunction_test,List.all_eq_true]
  constructor
  · intro h t
    have hh := h _ (show (WiredTotalTransition.checker C D N hN).rename
        (transitionWire (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T t) ∈
          transitionChecks C D N T hN by exact List.mem_ofFn.mpr ⟨t,rfl⟩)
    rw [rename_test,transitionWire_assignment] at hh
    exact hh
  · intro h p hp
    obtain ⟨t,rfl⟩ := List.mem_ofFn.mp hp
    rw [rename_test,transitionWire_assignment]
    exact h t

/-- A deterministic sequence of encoded machine states has exactly one
    transcript accepted by the full checker when its initial state is fixed. -/
theorem checker_unique (C : Circuit σ) (D N T : ℕ) (hN : 0 < N)
    (states : Fin (T+1) → Fin (stateWidth C.nodes.length D N) → Bool)
    (plans : Fin T → Fin (planWidth C.nodes.length D) → Bool)
    (hdet : ∀ t p next,
      (WiredTotalTransition.checker C D N hN).test
        (rawAssignment C.nodes.length D N (states t.castSucc) next p) = true ↔
          p = plans t ∧ next = states t.succ)
    (v : Fin (width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T) → Bool) :
    (stateAt _ _ _ v 0 = states 0 ∧ (checker C D N T hN).test v = true) ↔
      v = encode _ _ _ states plans := by
  rw [checker_correct]
  exact unique_chain (fun _ old p next =>
    (WiredTotalTransition.checker C D N hN).test
      (rawAssignment C.nodes.length D N old next p) = true) states plans hdet v

/-- An actual machine step determines a unique accepted plan and next word. -/
theorem machine_step_has_plan (C : Circuit σ) (D N : ℕ) (hN : 0 < N)
    (s t : {s : State // admissible C.nodes.length D N s})
    (hbits : s.val.bits ≠ []) (hstep : step C s.val = some t.val) :
    ∃ p : Fin (planWidth C.nodes.length D) → Bool,
      ∀ next planBits,
        (WiredTotalTransition.checker C D N hN).test
          (rawAssignment C.nodes.length D N (stateWord C.nodes.length D N s) next planBits) = true ↔
            planBits = p ∧ next = stateWord C.nodes.length D N t := by
  cases hp : s.val.pending with
  | nil =>
    have heq : s.val = t.val := by
      simp only [step,hp] at hstep
      exact Option.some.inj hstep
    have hst : s = t := Subtype.ext heq
    subst t
    exact ⟨planWord C.nodes.length D (WiredTotalTransition.haltPlan C.nodes.length D),
      fun next planBits => RawTransitionSoundness.total_halted_iff C D N hN s hp next planBits⟩
  | cons a rest =>
    have ha : a.bounded C.nodes.length D := s.property.1.1 a (by simp [hp])
    cases hb : s.val.bits with
    | nil => exact (hbits hb).elim
    | cons b bits =>
      exact ⟨planWord C.nodes.length D (boundedPlan C D ⟨a,ha⟩ b),
        fun next planBits => RawTransitionSoundness.total_running_iff C D N hN
          s t a rest hp ha b bits hb hstep next planBits⟩

/-- Every bounded actual run with nonempty input has a unique accepted
    transcript, including the canonical plan bits at every step. -/
theorem machine_run_unique (C : Circuit σ) (D N T : ℕ) (hN : 0 < N)
    (runStates : Fin (T+1) → {s : State // admissible C.nodes.length D N s})
    (hbits : ∀ t : Fin T, (runStates t.castSucc).val.bits ≠ [])
    (hstep : ∀ t : Fin T, step C (runStates t.castSucc).val = some (runStates t.succ).val) :
    ∃ plans : Fin T → Fin (planWidth C.nodes.length D) → Bool,
      ∀ v : Fin (width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T) → Bool,
        (stateAt _ _ _ v 0 = stateWord C.nodes.length D N (runStates 0) ∧
          (checker C D N T hN).test v = true) ↔
        v = encode _ _ _ (fun t => stateWord C.nodes.length D N (runStates t)) plans := by
  classical
  have hex : ∀ t : Fin T, ∃ p : Fin (planWidth C.nodes.length D) → Bool,
      ∀ next planBits,
        (WiredTotalTransition.checker C D N hN).test
          (rawAssignment C.nodes.length D N
            (stateWord C.nodes.length D N (runStates t.castSucc)) next planBits) = true ↔
        planBits = p ∧ next = stateWord C.nodes.length D N (runStates t.succ) := by
    intro t
    exact machine_step_has_plan C D N hN _ _ (hbits t) (hstep t)
  let plans := fun t => Classical.choose (hex t)
  refine ⟨plans,fun v => checker_unique C D N T hN
    (fun t => stateWord C.nodes.length D N (runStates t)) plans ?_ v⟩
  intro t p next
  exact Classical.choose_spec (hex t) next p

/-- A successful sentinel run supplies the bounded states required above.
    The initial input has length `T+1`, and the last bit is the sentinel. -/
theorem sentinel_transcript (C : Circuit σ) (d T : ℕ) (z : Fin T → Bool)
    (last : State)
    (hfinal : run C T (some (initial C d (List.ofFn z ++ [false]))) = some last) :
    ∃ (states : Fin (T+1) → {s : State // admissible C.nodes.length (d+1) (T+1) s})
      (plans : Fin T → Fin (planWidth C.nodes.length (d+1)) → Bool),
      (∀ t, run C t.val (some (initial C d (List.ofFn z ++ [false]))) = some (states t).val) ∧
      ∀ v : Fin (width (stateWidth C.nodes.length (d+1) (T+1))
          (planWidth C.nodes.length (d+1)) T) → Bool,
        (stateAt _ _ _ v 0 = stateWord C.nodes.length (d+1) (T+1) (states 0) ∧
          (checker C (d+1) (T+1) T (by omega)).test v = true) ↔
        v = encode _ _ _ (fun t => stateWord C.nodes.length (d+1) (T+1) (states t)) plans := by
  classical
  let input := List.ofFn z ++ [false]
  have hlen : input.length = T+1 := by simp [input]
  have hex : ∀ t : Fin (T+1), ∃ s : State,
      run C t.val (some (initial C d input)) = some s ∧
        admissible C.nodes.length (d+1) (T+1) s := by
    intro t
    have ht : t.val ≤ T := by omega
    have hsplit : run C T (some (initial C d input)) =
        run C (T-t.val) (run C t.val (some (initial C d input))) := by
      conv_lhs => rw [show T = t.val + (T-t.val) by omega]
      exact run_add C t.val (T-t.val) _
    cases hrun : run C t.val (some (initial C d input)) with
    | none =>
      rw [hsplit,hrun,run_none] at hfinal
      cases hfinal
    | some s =>
      refine ⟨s,rfl,reached_admissible C d (T+1) t.val input ?_ ?_ s hrun⟩ <;> omega
  let states : Fin (T+1) → {s : State // admissible C.nodes.length (d+1) (T+1) s} :=
    fun t => ⟨Classical.choose (hex t),(Classical.choose_spec (hex t)).2⟩
  have hrun : ∀ t, run C t.val (some (initial C d input)) = some (states t).val :=
    fun t => (Classical.choose_spec (hex t)).1
  have hbits : ∀ t : Fin T, (states t.castSucc).val.bits ≠ [] := by
    intro t
    exact SentinelExecution.sentinel_input_nonempty C d T t.val (List.ofFn z)
      List.length_ofFn (by omega) _ (hrun t.castSucc)
  have hstep : ∀ t : Fin T, step C (states t.castSucc).val = some (states t.succ).val := by
    intro t
    have h := hrun t.succ
    have hsplit : t.succ.val = t.castSucc.val + 1 := rfl
    rw [hsplit,run_add,hrun t.castSucc] at h
    simpa [run] using h
  obtain ⟨plans,hunique⟩ := machine_run_unique C (d+1) (T+1) T (by omega) states hbits hstep
  exact ⟨states,plans,hrun,hunique⟩

/-- For the fixed Boolean code length, the unique transcript ends in the
    factor list and padding condition computing the decoded polynomial. -/
theorem decoded_transcript [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)) → Bool) :
    let T := 2 * ((C.size + 1) * d + 1) * ((C.size + 1) * (d + 3) + d + 2)
    ∃ (states : Fin (T+1) → {s : State // admissible C.nodes.length (d+1) (T+1) s})
      (plans : Fin T → Fin (planWidth C.nodes.length (d+1)) → Bool),
      (states (Fin.last T)).val.pending = [] ∧
      (CircuitFixedCodes.decodedWeight (CircuitNormalizedFormula.boundedCircuitFormula C d) T z =
        if (states (Fin.last T)).val.bits = List.replicate (states (Fin.last T)).val.bits.length false then
          ((states (Fin.last T)).val.factors.map (fun l => (leafFormula C l).value)).prod else 0) ∧
      ∀ v : Fin (width (stateWidth C.nodes.length (d+1) (T+1))
          (planWidth C.nodes.length (d+1)) T) → Bool,
        (stateAt _ _ _ v 0 = stateWord C.nodes.length (d+1) (T+1) (states 0) ∧
          (checker C (d+1) (T+1) T (by omega)).test v = true) ↔
        v = encode _ _ _ (fun t => stateWord C.nodes.length (d+1) (T+1) (states t)) plans := by
  dsimp only
  obtain ⟨last,hfinal,hpending,_,hweight⟩ := SentinelExecution.sentinel_run C d hdegree z
  obtain ⟨states,plans,hruns,hunique⟩ := sentinel_transcript C d _ z last hfinal
  have heq : (states (Fin.last _)).val = last := by
    have h := hruns (Fin.last _)
    simp only [Fin.val_last] at h
    rw [hfinal] at h
    exact (Option.some.inj h).symm
  refine ⟨states,plans,?_,?_,hunique⟩
  · simpa [heq] using hpending
  · simpa [heq] using hweight

set_option backward.isDefEq.respectTransparency false in
theorem checker_nodes (C : Circuit σ) (D N T : ℕ) (hN : 0 < N) :
    (checker C D N T hN).nodes = T * ((WiredTotalTransition.checker C D N hN).nodes + 1) + 1 := by
  rw [checker,conjunction_nodes]
  unfold totalWidth at *
  simp only [transitionChecks,List.length_ofFn,List.map_ofFn]
  have h : (BoolFormula.nodes ∘ fun t : Fin T =>
      (WiredTotalTransition.checker C D N hN).rename
        (transitionWire (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T t)) =
      (fun _ : Fin T => (WiredTotalTransition.checker C D N hN).nodes) := by
    funext t
    exact rename_nodes _ _
  rw [h]
  simp
  ring


end WiredTranscript

-- From Solutions.TranscriptInitialControl

/-! A linear-size checker for an initial word whose bits are either fixed
    constants or copies of input bits. -/

namespace TranscriptInitialControl

open BooleanVerifierFormula BooleanVectorControl IndexedTagControl

variable {σ : Type}

def expectedBit {q : ℕ} (input : Fin q → σ) (source : Option (Fin q))
    (constant : Bool) : BoolFormula σ :=
  match source with
  | none => .lit constant
  | some i => .bit (input i)

def initialChecks (q S : ℕ) (input : Fin q → σ) (word : Fin S → σ)
    (source : Fin S → Option (Fin q)) (constant : Fin S → Bool) : List (BoolFormula σ) :=
  List.ofFn fun i => bitEq (.bit (word i)) (expectedBit input (source i) (constant i))

def initialChecker (q S : ℕ) (input : Fin q → σ) (word : Fin S → σ)
    (source : Fin S → Option (Fin q)) (constant : Fin S → Bool) : BoolFormula σ :=
  conjunction (initialChecks q S input word source constant)

theorem initialChecker_correct (q S : ℕ) (input : Fin q → σ) (word : Fin S → σ)
    (source : Fin S → Option (Fin q)) (constant : Fin S → Bool) (v : σ → Bool) :
    (initialChecker q S input word source constant).test v = true ↔
      ∀ i, v (word i) = match source i with
        | none => constant i
        | some j => v (input j) := by
  rw [initialChecker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i
    have hh := h _ (show bitEq (.bit (word i)) (expectedBit input (source i) (constant i)) ∈
      initialChecks q S input word source constant by exact List.mem_ofFn.mpr ⟨i,rfl⟩)
    rw [bitEq_test] at hh
    cases hs : source i <;> simpa [expectedBit,hs,BoolFormula.test] using hh
  · intro h p hp
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
    rw [bitEq_test]
    cases hs : source i <;> simpa [expectedBit,hs,BoolFormula.test] using h i

theorem initialChecker_nodes (q S : ℕ) (input : Fin q → σ) (word : Fin S → σ)
    (source : Fin S → Option (Fin q)) (constant : Fin S → Bool) :
    (initialChecker q S input word source constant).nodes ≤ 10*S+1 := by
  rw [initialChecker,conjunction_nodes]
  have hsum : ((initialChecks q S input word source constant).map BoolFormula.nodes).sum ≤
      (initialChecks q S input word source constant).length * 9 := by
    have h := List.sum_le_sum (l := initialChecks q S input word source constant)
      (f := BoolFormula.nodes) (g := fun _ => 9) (by
        intro p hp
        obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
        cases hs : source i <;> simp [expectedBit,hs,bitEq_nodes,BoolFormula.nodes])
    simpa using h
  simp only [initialChecks,List.length_ofFn] at hsum ⊢
  omega

open ResultantVNP IndexedStateEncoding IndexedPlanControl

/-- Wire the external code and initial-state constraint to the transition
    transcript, with no extra variables beyond the transcript itself. -/
noncomputable def fullChecker {α : Type} (C : Circuit α) (D N T q : ℕ) (hN : 0 < N)
    (source : Fin (stateWidth C.nodes.length D N) → Option (Fin q))
    (constant : Fin (stateWidth C.nodes.length D N) → Bool) :
    BoolFormula (Fin (q + WiredTranscript.width (stateWidth C.nodes.length D N)
      (planWidth C.nodes.length D) T)) :=
  .and (initialChecker q _ (Fin.castAdd _)
      (fun i => Fin.natAdd q (WiredTranscript.stateCoord _ _ _ 0 i)) source constant)
    ((WiredTranscript.checker C D N T hN).rename (Fin.natAdd q))

theorem fullChecker_correct {α : Type} (C : Circuit α) (D N T q : ℕ) (hN : 0 < N)
    (source : Fin (stateWidth C.nodes.length D N) → Option (Fin q))
    (constant : Fin (stateWidth C.nodes.length D N) → Bool)
    (v : Fin (q + WiredTranscript.width (stateWidth C.nodes.length D N)
      (planWidth C.nodes.length D) T) → Bool) :
    (fullChecker C D N T q hN source constant).test v = true ↔
      (∀ i, v (Fin.natAdd q (WiredTranscript.stateCoord _ _ _ 0 i)) =
        match source i with
        | none => constant i
        | some j => v (Fin.castAdd _ j)) ∧
      (WiredTranscript.checker C D N T hN).test (fun i => v (Fin.natAdd q i)) = true := by
  simp only [fullChecker,BoolFormula.test,Bool.and_eq_true,initialChecker_correct,rename_test]
  rfl

theorem fullChecker_nodes {α : Type} (C : Circuit α) (D N T q : ℕ) (hN : 0 < N)
    (source : Fin (stateWidth C.nodes.length D N) → Option (Fin q))
    (constant : Fin (stateWidth C.nodes.length D N) → Bool) :
    (fullChecker C D N T q hN source constant).nodes ≤
      10 * stateWidth C.nodes.length D N + 2 + (WiredTranscript.checker C D N T hN).nodes := by
  have h := initialChecker_nodes q (stateWidth C.nodes.length D N)
    (Fin.castAdd (WiredTranscript.width (stateWidth C.nodes.length D N) (planWidth C.nodes.length D) T))
    (fun i => Fin.natAdd q (WiredTranscript.stateCoord (stateWidth C.nodes.length D N)
      (planWidth C.nodes.length D) T 0 i)) source constant
  simp only [fullChecker,BoolFormula.nodes,rename_nodes]
  omega


end TranscriptInitialControl

-- From Solutions.DecoderInitialState

/-! Instantiate the initial-word control for the decoder with a trailing
    zero sentinel. -/

namespace DecoderInitialState

open ResultantVNP IndexedFactorMachine IndexedNormalizedAddresses IndexedStateEncoding
  BoundedListEncoding TranscriptInitialControl

variable {σ : Type}

def initialState (C : Circuit σ) (d q : ℕ) (z : Fin q → Bool) :
    {s : State // admissible C.nodes.length (d+1) (q+1) s} :=
  ⟨initial C d (List.ofFn z ++ [false]),
    reached_admissible C d (q+1) 0 (List.ofFn z ++ [false]) (by simp) (by omega) _ (by rfl)⟩

/-- Input data slots copy the corresponding code bit; the presence bits,
    sentinel, and the stack and factor segments are fixed. -/
def source (m D q : ℕ) : Fin (stateWidth m D (q+1)) → Option (Fin q) :=
  Fin.addCases (fun _ => none) (Fin.addCases (fun _ => none) (fun u =>
    let p : Fin (q+1) × Fin (1+1) := finProdFinEquiv.symm u
    if h : p.1.val < q then
      if p.2 = 1 then some ⟨p.1.val,h⟩ else none
    else none))

theorem source_stack (m D q : ℕ) (i : Fin (q+2)) (j : Fin (tagWordLength m D+1)) :
    source m D q (stackCoord m D (q+1) i j) = none := by
  simp [source,stackCoord]

theorem source_factor (m D q : ℕ) (i : Fin (q+1)) (j : Fin ((3+(m+1))+1)) :
    source m D q (factorCoord m D (q+1) i j) = none := by
  simp [source,factorCoord]

theorem source_input (m D q : ℕ) (i : Fin (q+1)) (j : Fin (1+1)) :
    source m D q (inputCoord m D (q+1) i j) =
      if h : i.val < q then if j = 1 then some ⟨i.val,h⟩ else none else none := by
  simp only [source,inputCoord,Fin.addCases_right,Equiv.symm_apply_apply]

def reference (C : Circuit σ) (d q : ℕ) : Fin (stateWidth C.nodes.length (d+1) (q+1)) → Bool :=
  stateWord C.nodes.length (d+1) (q+1) (initialState C d q (fun _ => false))

theorem initial_word (C : Circuit σ) (d q : ℕ) (z : Fin q → Bool) :
    stateWord C.nodes.length (d+1) (q+1) (initialState C d q z) =
      fun i => match source C.nodes.length (d+1) q i with
        | none => reference C d q i
        | some j => z j := by
  apply stateBits_ext
  · intro i j
    rw [source_stack]
    simp only [stateWord_stackSlot,reference,initialState,initial]
  · intro i j
    rw [source_factor]
    simp only [stateWord_factorSlot,reference,initialState,initial]
  · intro i j
    rw [source_input]
    simp only [stateWord_inputSlot,reference,initialState,initial]
    refine Fin.cases ?_ (fun j => ?_) j
    · simp [slotAt_presence]
    · have hj : j = 0 := Subsingleton.elim _ _
      subst j
      by_cases hi : i.val < q
      · have hi' : i.val < (List.ofFn z).length := by simpa using hi
        simp [hi,slotAt,optionWord,bitWord,List.getElem?_append_left hi']
      · have heq : i.val = q := by omega
        simp [hi,heq,slotAt,optionWord,bitWord,List.getElem?_append_right]

/-- Fixing an input code leaves exactly one transcript accepted by the
    complete initial-state and transition checker. -/
theorem sentinel_verifier_unique (C : Circuit σ) (d q : ℕ) (z : Fin q → Bool)
    (last : State)
    (hfinal : run C q (some (initial C d (List.ofFn z ++ [false]))) = some last) :
    ∃! y : Fin (WiredTranscript.width (stateWidth C.nodes.length (d+1) (q+1))
      (IndexedPlanControl.planWidth C.nodes.length (d+1)) q) → Bool,
      (fullChecker C (d+1) (q+1) q q (by omega)
        (source C.nodes.length (d+1) q) (reference C d q)).test (Fin.append z y) = true := by
  obtain ⟨states,plans,hruns,hunique⟩ := WiredTranscript.sentinel_transcript C d q z last hfinal
  have hzero : states 0 = initialState C d q z := by
    apply Subtype.ext
    have h := hruns 0
    simp only [Fin.val_zero,run] at h
    exact (Option.some.inj h).symm
  have hiff (y : Fin (WiredTranscript.width (stateWidth C.nodes.length (d+1) (q+1))
      (IndexedPlanControl.planWidth C.nodes.length (d+1)) q) → Bool) :
      (fullChecker C (d+1) (q+1) q q (by omega)
        (source C.nodes.length (d+1) q) (reference C d q)).test (Fin.append z y) = true ↔
        y = WiredTranscript.encode _ _ _
          (fun t => stateWord C.nodes.length (d+1) (q+1) (states t)) plans := by
    rw [fullChecker_correct]
    simp only [Fin.append_left,Fin.append_right]
    rw [← hunique y]
    rw [hzero,initial_word]
    constructor
    · rintro ⟨h,ht⟩
      exact ⟨funext h,ht⟩
    · rintro ⟨h,ht⟩
      exact ⟨fun i => congrFun h i,ht⟩
  refine ⟨_,(hiff _).mpr rfl,?_⟩
  intro y hy
  exact (hiff y).mp hy

/-- The previously established parse bound ensures that this verifier has
    one witness for every code of the decoder's prescribed length. -/
theorem decoder_verifier_unique [DecidableEq σ] (C : Circuit σ) (d : ℕ)
    (hdegree : C.value.totalDegree ≤ d)
    (z : Fin (2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)) → Bool) :
    let q := 2 * ((C.size+1)*d+1) * ((C.size+1)*(d+3)+d+2)
    ∃! y : Fin (WiredTranscript.width (stateWidth C.nodes.length (d+1) (q+1))
      (IndexedPlanControl.planWidth C.nodes.length (d+1)) q) → Bool,
      (fullChecker C (d+1) (q+1) q q (by omega)
        (source C.nodes.length (d+1) q) (reference C d q)).test (Fin.append z y) = true := by
  dsimp only
  obtain ⟨last,hfinal,_,_,_⟩ := SentinelExecution.sentinel_run C d hdegree z
  exact sentinel_verifier_unique C d _ z last hfinal


end DecoderInitialState

-- From Solutions.IndexedFactorPayload

/-! Arithmetic payload for a sequence of one-hot symbolic leaf selectors.
    Unused slots may select a dedicated constant-one option. -/

namespace IndexedFactorPayload

open ResultantVNP PermanentFoundation IndexedFactorMachine BooleanVerifierFormula
  VNPNestedBooleanSum MvPolynomial IndexedNormalizedAddresses

theorem leafFormula_size (a : ℕ) (C : Circuit (Fin a)) (l : Leaf) :
    (leafFormula C l).size = 0 := by
  cases l with
  | zero => rfl
  | «variable» i => cases h : sourceNode C i <;> simp [leafFormula,variableFormula,h,Formula.size]
  | constantPart i => rfl

noncomputable def factorFormula (a : ℕ) (C : Circuit (Fin a)) : Option Leaf → Formula (Fin a)
  | none => .const 1
  | some l => leafFormula C l

theorem factorFormula_size (a : ℕ) (C : Circuit (Fin a)) (l : Option Leaf) :
    (factorFormula a C l).size = 0 := by
  cases l with
  | none => rfl
  | some l => exact leafFormula_size a C l

noncomputable def liftLeaf (a q : ℕ) (C : Circuit (Fin a)) (l : Option Leaf) : Formula (Fin (a+q)) :=
  renameFormula (Fin.castAdd q) (factorFormula a C l)

theorem liftLeaf_size (a q : ℕ) (C : Circuit (Fin a)) (l : Option Leaf) : (liftLeaf a q C l).size = 0 := by
  rw [liftLeaf,renameFormula_size,factorFormula_size]

theorem liftLeaf_eval (a q : ℕ) (C : Circuit (Fin a)) (l : Option Leaf) (z : Fin q → Fin 2) :
    witnessEval a q z (liftLeaf a q C l).value = (factorFormula a C l).value :=
  witnessEval_inputFormula a q (factorFormula a C l) z

noncomputable def leafChoices (a q : ℕ) (C : Circuit (Fin a)) (xs : List (Fin q × Option Leaf)) :
    List (Fin q × Formula (Fin (a+q))) :=
  xs.map fun x => (x.1,liftLeaf a q C x.2)

/-- Each factor slot sums its candidate symbolic leaves weighted by its
    witness selectors. -/
noncomputable def leafSelector (a q : ℕ) (C : Circuit (Fin a)) (xs : List (Fin q × Option Leaf)) :
    Formula (Fin (a+q)) := selectPayload a q (leafChoices a q C xs)

theorem leafSelector_size (a q : ℕ) (C : Circuit (Fin a)) (xs : List (Fin q × Option Leaf)) :
    (leafSelector a q C xs).size = 2 * xs.length := by
  rw [leafSelector,selectPayload_size]
  simp [leafChoices,List.map_map,liftLeaf_size,Function.comp_def]

theorem leafSelector_eval (a q : ℕ) (C : Circuit (Fin a)) (xs : List (Fin q × Option Leaf))
    (z : Fin q → Fin 2) :
    witnessEval a q z (leafSelector a q C xs).value =
      (xs.map (fun x => if witnessBool (z x.1) then (factorFormula a C x.2).value else 0)).sum := by
  rw [leafSelector,selectPayload_eval]
  simp [leafChoices,List.map_map,liftLeaf_eval,Function.comp_def]

/-- With one active selector, a factor slot evaluates to the selected leaf
    or to `1` when its selected option is the padding marker. -/
theorem leafSelector_oneHot (a q : ℕ) (C : Circuit (Fin a)) (xs : List (Fin q × Option Leaf))
    (hindices : (xs.map Prod.fst).Nodup) (i : Fin q) (l : Option Leaf) (z : Fin q → Fin 2)
    (hmem : (i,l) ∈ xs) (hon : witnessBool (z i) = true)
    (hoff : ∀ x ∈ xs, x.1 ≠ i → witnessBool (z x.1) = false) :
    witnessEval a q z (leafSelector a q C xs).value = (factorFormula a C l).value := by
  classical
  have hnodup : (leafChoices a q C xs).Nodup := by
    unfold leafChoices
    apply List.Nodup.map_on _ (List.Nodup.of_map Prod.fst hindices)
    intro x hx y hy he
    have hi : x.1 = y.1 := congrArg (fun z : Fin q × Formula (Fin (a+q)) => z.1) he
    exact List.inj_on_of_nodup_map hindices hx hy hi
  have hm : (i,liftLeaf a q C l) ∈ leafChoices a q C xs := by
    exact List.mem_map.mpr ⟨(i,l),hmem,rfl⟩
  have hz : ∀ x ∈ leafChoices a q C xs, x ≠ (i,liftLeaf a q C l) →
      witnessBool (z x.1) = false := by
    intro x hx hne
    obtain ⟨y,hy,rfl⟩ := List.mem_map.mp hx
    apply hoff y hy
    intro hidx
    have heq : y = (i,l) := List.inj_on_of_nodup_map hindices hy hmem hidx
    subst y
    exact hne rfl
  have hh := selectPayload_oneHot a q (leafChoices a q C xs) hnodup i (liftLeaf a q C l)
    z hm hon hz
  simpa [leafSelector,liftLeaf_eval] using hh

/-- Multiply the selectors of all fixed factor slots. -/
noncomputable def leafProduct (a q : ℕ) (C : Circuit (Fin a)) (slots : List (List (Fin q × Option Leaf))) :
    Formula (Fin (a+q)) := productPayload a q (slots.map (leafChoices a q C))

theorem leafProduct_size (a q : ℕ) (C : Circuit (Fin a)) (slots : List (List (Fin q × Option Leaf))) :
    (leafProduct a q C slots).size = 2 * (slots.map List.length).sum + slots.length := by
  induction slots with
  | nil => rfl
  | cons xs rest ih =>
    change (Formula.mul (leafSelector a q C xs) (leafProduct a q C rest)).size = _
    simp only [Formula.size,leafSelector_size,ih,List.map_cons,List.sum_cons,List.length_cons]
    omega

theorem leafProduct_eval (a q : ℕ) (C : Circuit (Fin a)) (slots : List (List (Fin q × Option Leaf)))
    (z : Fin q → Fin 2) :
    witnessEval a q z (leafProduct a q C slots).value =
      (slots.map (fun xs => (xs.map (fun x => if witnessBool (z x.1) then
        (factorFormula a C x.2).value else 0)).sum)).prod := by
  induction slots with
  | nil => simp [leafProduct,productPayload,Formula.value]
  | cons xs rest ih =>
    change witnessEval a q z (Formula.mul (leafSelector a q C xs) (leafProduct a q C rest)).value = _
    simp only [Formula.value,map_mul,leafSelector_eval,ih,List.map_cons,List.prod_cons]

def selects (q : ℕ) (z : Fin q → Fin 2) (xs : List (Fin q × Option Leaf)) (l : Option Leaf) : Prop :=
  (xs.map Prod.fst).Nodup ∧ ∃ i, (i,l) ∈ xs ∧ witnessBool (z i) = true ∧
    ∀ x ∈ xs, x.1 ≠ i → witnessBool (z x.1) = false

theorem leafProduct_oneHot (a q : ℕ) (C : Circuit (Fin a)) (slots : List (List (Fin q × Option Leaf)))
    (labels : List (Option Leaf)) (z : Fin q → Fin 2) (h : List.Forall₂ (selects q z) slots labels) :
    witnessEval a q z (leafProduct a q C slots).value =
      (labels.map (fun l => (factorFormula a C l).value)).prod := by
  induction h with
  | nil => simp [leafProduct,productPayload,Formula.value]
  | @cons xs l rest labels hx hrest ih =>
    obtain ⟨hn,i,hmem,hon,hoff⟩ := hx
    change witnessEval a q z (Formula.mul (leafSelector a q C xs) (leafProduct a q C rest)).value = _
    simp only [Formula.value,map_mul,List.map_cons,List.prod_cons]
    rw [leafSelector_oneHot a q C xs hn i l z hmem hon hoff,ih]

theorem padded_factor_product (a : ℕ) (C : Circuit (Fin a)) (factors : List Leaf) (padding : ℕ) :
    (((factors.map some ++ List.replicate padding none).map (fun l => (factorFormula a C l).value))).prod =
      (factors.map (fun l => (leafFormula C l).value)).prod := by
  simp [List.map_append,List.map_map,Function.comp_def,factorFormula,Formula.value]


end IndexedFactorPayload

-- From Solutions.BooleanLeafPayload

/-! A leaf selector whose controls are Boolean formulas rather than
    individual witness bits. This permits a factor's kind and index to be
    read directly from its two one-hot fields. -/

namespace BooleanLeafPayload

open ResultantVNP PermanentFoundation BooleanVerifierFormula IndexedFactorMachine IndexedFactorPayload
  VNPNestedBooleanSum MvPolynomial

noncomputable def selector (a q : ℕ) (C : Circuit (Fin a)) :
    List (BoolFormula (Fin q) × Option Leaf) → Formula (Fin (a+q))
  | [] => .const 0
  | (guard,leaf) :: rest =>
    .add (.mul (witnessFormula a q guard) (liftLeaf a q C leaf)) (selector a q C rest)

theorem selector_size (a q : ℕ) (C : Circuit (Fin a))
    (choices : List (BoolFormula (Fin q) × Option Leaf)) :
    (selector a q C choices).size ≤
      (choices.map (fun x => 7*x.1.nodes+2)).sum := by
  induction choices with
  | nil => rfl
  | cons choice rest ih =>
    rcases choice with ⟨guard,leaf⟩
    simp only [selector,Formula.size,List.map_cons,List.sum_cons,liftLeaf_size]
    have h := witnessFormula_size a q guard
    omega

theorem selector_eval (a q : ℕ) (C : Circuit (Fin a))
    (choices : List (BoolFormula (Fin q) × Option Leaf)) (z : Fin q → Fin 2) :
    witnessEval a q z (selector a q C choices).value =
      (choices.map (fun x => if x.1.test (fun i => witnessBool (z i)) then
        (factorFormula a C x.2).value else 0)).sum := by
  induction choices with
  | nil => simp [selector,Formula.value]
  | cons choice rest ih =>
    rcases choice with ⟨guard,leaf⟩
    simp only [selector,Formula.value,map_add,ih,List.map_cons,List.sum_cons]
    rw [map_mul,witnessFormula_eval,liftLeaf_eval]
    cases guard.test (fun i => witnessBool (z i)) <;> simp [bitValue]

/-- Exactly one true guard selects its corresponding factor, even when
    guards are compound formulas rather than single variables. -/
theorem selector_oneHot (a q : ℕ) (C : Circuit (Fin a))
    (choices : List (BoolFormula (Fin q) × Option Leaf)) (z : Fin q → Fin 2)
    (choice : BoolFormula (Fin q) × Option Leaf)
    (hn : choices.Nodup) (hmem : choice ∈ choices)
    (hon : choice.1.test (fun i => witnessBool (z i)) = true)
    (hoff : ∀ x ∈ choices, x ≠ choice → x.1.test (fun i => witnessBool (z i)) = false) :
    witnessEval a q z (selector a q C choices).value = (factorFormula a C choice.2).value := by
  classical
  rw [selector_eval,← List.sum_toFinset _ hn]
  rw [Finset.sum_eq_single choice]
  · simp [hon]
  · intro x hx hne
    rw [hoff x (List.mem_toFinset.mp hx) hne]
    rfl
  · intro h
    exact (h (List.mem_toFinset.mpr hmem)).elim

noncomputable def product (a q : ℕ) (C : Circuit (Fin a)) :
    List (List (BoolFormula (Fin q) × Option Leaf)) → Formula (Fin (a+q))
  | [] => .const 1
  | choices :: rest => .mul (selector a q C choices) (product a q C rest)

theorem product_size (a q : ℕ) (C : Circuit (Fin a))
    (slots : List (List (BoolFormula (Fin q) × Option Leaf))) :
    (product a q C slots).size ≤
      (slots.map (fun choices => (choices.map (fun x => 7*x.1.nodes+2)).sum+1)).sum := by
  induction slots with
  | nil => rfl
  | cons choices rest ih =>
    simp only [product,Formula.size,List.map_cons,List.sum_cons]
    have h := selector_size a q C choices
    omega

theorem product_eval (a q : ℕ) (C : Circuit (Fin a))
    (slots : List (List (BoolFormula (Fin q) × Option Leaf))) (z : Fin q → Fin 2) :
    witnessEval a q z (product a q C slots).value =
      (slots.map (fun choices => (choices.map (fun x =>
        if x.1.test (fun i => witnessBool (z i)) then (factorFormula a C x.2).value else 0)).sum)).prod := by
  induction slots with
  | nil => simp [product,Formula.value]
  | cons choices rest ih =>
    simp only [product,Formula.value,map_mul,selector_eval,ih,List.map_cons,List.prod_cons]


end BooleanLeafPayload

-- From Solutions.FactorSlotPayload

/-! Arithmetic interpretation of one encoded factor slot. -/

namespace FactorSlotPayload

open ResultantVNP PermanentFoundation BooleanVerifierFormula IndexedFactorMachine IndexedFactorPayload
  BooleanLeafPayload VNPNestedBooleanSum IndexedNormalizedAddresses MvPolynomial

def choices (q m : ℕ) (present : Fin q) (kind : Fin 3 → Fin q)
    (index : Fin (m+1) → Fin q) : List (BoolFormula (Fin q) × Option Leaf) :=
  [(.not (.bit present),none)] ++
    List.ofFn (fun i : Fin (m+1) =>
      (.and (.bit (kind 1)) (.bit (index i)),some (.variable i.val))) ++
    List.ofFn (fun i : Fin (m+1) =>
      (.and (.bit (kind 2)) (.bit (index i)),some (.constantPart i.val)))

noncomputable def slot (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) : Formula (Fin (a+q)) :=
  selector a q C (choices q m present kind index)

theorem slot_size (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) :
    (slot a q m C present kind index).size ≤ 50*(m+1)+20 := by
  have h := selector_size a q C (choices q m present kind index)
  simp only [choices,List.map_append,List.sum_append,List.map_cons,List.map_nil,
    List.sum_cons,List.sum_nil,List.map_ofFn,BoolFormula.nodes] at h
  simp only [List.ofFn_eq_map,← List.sum_toFinset _ (List.nodup_finRange _),List.toFinset_finRange,
    Function.comp_def,BoolFormula.nodes] at h
  simp at h
  change (selector a q C (choices q m present kind index)).size ≤ _
  simp only [choices,List.ofFn_eq_map,List.cons_append,List.nil_append]
  omega

theorem slot_eval (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) (z : Fin q → Fin 2) :
    witnessEval a q z (slot a q m C present kind index).value =
      (if witnessBool (z present) then 0 else 1) +
      (∑ i : Fin (m+1), if witnessBool (z (kind 1)) && witnessBool (z (index i)) then
        (leafFormula C (.variable i.val)).value else 0) +
      (∑ i : Fin (m+1), if witnessBool (z (kind 2)) && witnessBool (z (index i)) then
        (leafFormula C (.constantPart i.val)).value else 0) := by
  rw [slot,selector_eval]
  simp only [choices,List.map_append,List.sum_append,List.map_cons,List.map_nil,List.sum_cons,
    List.sum_nil,List.map_ofFn,Function.comp_apply,BoolFormula.test,factorFormula,Formula.value]
  simp only [List.ofFn_eq_map,← List.sum_toFinset _ (List.nodup_finRange _),List.toFinset_finRange]
  simp only [Function.comp_apply,BoolFormula.test,factorFormula,Formula.value,add_zero,map_one]
  cases h : witnessBool (z present) <;> simp [h]

theorem slot_absent (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) (z : Fin q → Fin 2)
    (hp : witnessBool (z present) = false)
    (hvar : witnessBool (z (kind 1)) = false)
    (hconst : witnessBool (z (kind 2)) = false) :
    witnessEval a q z (slot a q m C present kind index).value = 1 := by
  simp [slot_eval,hp,hvar,hconst]

theorem slot_zero (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) (z : Fin q → Fin 2)
    (hp : witnessBool (z present) = true)
    (hvar : witnessBool (z (kind 1)) = false)
    (hconst : witnessBool (z (kind 2)) = false) :
    witnessEval a q z (slot a q m C present kind index).value = 0 := by
  simp [slot_eval,hp,hvar,hconst]

theorem slot_variable (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) (z : Fin q → Fin 2)
    (i : Fin (m+1)) (hp : witnessBool (z present) = true)
    (hvar : witnessBool (z (kind 1)) = true)
    (hconst : witnessBool (z (kind 2)) = false)
    (hindex : ∀ j, witnessBool (z (index j)) = decide (i = j)) :
    witnessEval a q z (slot a q m C present kind index).value =
      (leafFormula C (.variable i.val)).value := by
  simp [slot_eval,hp,hvar,hconst,hindex]

theorem slot_constant (a q m : ℕ) (C : Circuit (Fin a)) (present : Fin q)
    (kind : Fin 3 → Fin q) (index : Fin (m+1) → Fin q) (z : Fin q → Fin 2)
    (i : Fin (m+1)) (hp : witnessBool (z present) = true)
    (hvar : witnessBool (z (kind 1)) = false)
    (hconst : witnessBool (z (kind 2)) = true)
    (hindex : ∀ j, witnessBool (z (index j)) = decide (i = j)) :
    witnessEval a q z (slot a q m C present kind index).value =
      (leafFormula C (.constantPart i.val)).value := by
  simp [slot_eval,hp,hvar,hconst,hindex]

/-- A present encoded leaf or an absent padding slot is interpreted as its
    leaf polynomial or as one, respectively. -/
theorem encoded_slot (a q m : ℕ) (C : Circuit (Fin a))
    (coord : Fin ((3+(m+1))+1) → Fin q) (z : Fin q → Fin 2)
    (o : Option {l : Leaf // l.bounded m})
    (hword : ∀ j, witnessBool (z (coord j)) =
      BoundedListEncoding.optionWord (o.map (leafWord m)) j) :
    witnessEval a q z (slot a q m C (coord 0)
      (fun k => coord (Fin.succ (Fin.castAdd (m+1) k)))
      (fun i => coord (Fin.succ (Fin.natAdd 3 i)))).value =
        (factorFormula a C (o.map Subtype.val)).value := by
  cases o with
  | none =>
    apply slot_absent a q m C _ _ _ z
    · simpa [BoundedListEncoding.optionWord] using hword 0
    · simpa [BoundedListEncoding.optionWord] using hword (Fin.succ (Fin.castAdd (m+1) (1 : Fin 3)))
    · simpa [BoundedListEncoding.optionWord] using hword (Fin.succ (Fin.castAdd (m+1) (2 : Fin 3)))
  | some x =>
    cases hx : x.val with
    | zero =>
      simp only [Option.map_some,factorFormula,hx]
      change _ = (leafFormula C .zero).value
      simp only [leafFormula,Formula.value,map_zero]
      apply slot_zero a q m C _ _ _ z
      · simpa [BoundedListEncoding.optionWord] using hword 0
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (1 : Fin 3)))
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (2 : Fin 3)))
    | «variable» n =>
      have hn : n < m := by simpa [hx,Leaf.bounded] using x.property
      let i : Fin (m+1) := ⟨n,by omega⟩
      simp only [Option.map_some,factorFormula,hx]
      change _ = (leafFormula C (.variable n)).value
      apply slot_variable a q m C _ _ _ z i
      · simpa [BoundedListEncoding.optionWord] using hword 0
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (1 : Fin 3)))
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (2 : Fin 3)))
      · intro j
        simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot,i]
          using hword (Fin.succ (Fin.natAdd 3 j))
    | constantPart n =>
      have hn : n < m := by simpa [hx,Leaf.bounded] using x.property
      let i : Fin (m+1) := ⟨n,by omega⟩
      simp only [Option.map_some,factorFormula,hx]
      change _ = (leafFormula C (.constantPart n)).value
      apply slot_constant a q m C _ _ _ z i
      · simpa [BoundedListEncoding.optionWord] using hword 0
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (1 : Fin 3)))
      · simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot]
          using hword (Fin.succ (Fin.castAdd (m+1) (2 : Fin 3)))
      · intro j
        simpa [BoundedListEncoding.optionWord,leafWord,boundedLeafEncoding,hx,Leaf.fields,oneHot,i]
          using hword (Fin.succ (Fin.natAdd 3 j))

/-- The selector can read a factor slot directly from a well-formed encoded
    machine state. -/
theorem state_slot (a q D N : ℕ) (C : Circuit (Fin a))
    (s : {s : State // IndexedStateEncoding.admissible C.nodes.length D N s})
    (i : Fin N) (wire : Fin (IndexedStateEncoding.stateWidth C.nodes.length D N) → Fin q)
    (z : Fin q → Fin 2)
    (hwire : ∀ j, witnessBool (z (wire j)) = IndexedStateEncoding.stateWord C.nodes.length D N s j) :
    witnessEval a q z (slot a q C.nodes.length C
      (wire (IndexedStateEncoding.factorCoord C.nodes.length D N i 0))
      (fun k => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
        (Fin.succ (Fin.castAdd (C.nodes.length+1) k))))
      (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
        (Fin.succ (Fin.natAdd 3 j))))).value =
      (factorFormula a C ((IndexedStateEncoding.factorItems C.nodes.length D N s)[i.val]?.map Subtype.val)).value := by
  apply encoded_slot a q C.nodes.length C
    (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i j)) z
    ((IndexedStateEncoding.factorItems C.nodes.length D N s)[i.val]?)
  intro j
  rw [hwire]
  simp only [IndexedStateEncoding.stateWord,IndexedStateEncoding.factorCoord,
    Fin.append_right,Fin.append_left,BoundedListEncoding.listWord_at,
    BoundedListEncoding.slotAt]

/-- Reading all padded slots and interpreting empty slots as one gives the
    product of the actual list. -/
theorem padded_product {α β : Type} [Monoid β] (n : ℕ) (xs : List α) (f : α → β)
    (h : xs.length ≤ n) :
    (List.ofFn (fun i : Fin n => (xs[i.val]?).elim 1 f)).prod = (xs.map f).prod := by
  induction n generalizing xs with
  | zero =>
    cases xs with
    | nil => simp
    | cons x xs => simp at h
  | succ n ih =>
    cases xs with
    | nil => simp [List.ofFn_const]
    | cons x xs =>
      rw [List.ofFn_succ]
      simp only [List.getElem?_cons_zero,Option.elim_some,List.prod_cons,List.map_cons]
      congr 1
      have ht : xs.length ≤ n := by simp only [List.length_cons] at h; omega
      simpa only [Fin.val_succ,List.getElem?_cons_succ] using ih xs ht

def multiply {α : Type} : List (Formula α) → Formula α
  | [] => .const 1
  | x :: xs => .mul x (multiply xs)

theorem multiply_eval (a q : ℕ) (fs : List (Formula (Fin (a+q)))) (z : Fin q → Fin 2) :
    witnessEval a q z (multiply fs).value = (fs.map (fun f => witnessEval a q z f.value)).prod := by
  induction fs with
  | nil => simp [multiply,Formula.value]
  | cons f fs ih => simp [multiply,Formula.value,ih]

theorem multiply_size {α : Type} (fs : List (Formula α)) :
    (multiply fs).size = (fs.map Formula.size).sum + fs.length := by
  induction fs with
  | nil => rfl
  | cons f fs ih => simp [multiply,Formula.size,ih]; omega

noncomputable def stateProduct (a q D N : ℕ) (C : Circuit (Fin a))
    (wire : Fin (IndexedStateEncoding.stateWidth C.nodes.length D N) → Fin q) : Formula (Fin (a+q)) :=
  multiply (List.ofFn fun i : Fin N => slot a q C.nodes.length C
    (wire (IndexedStateEncoding.factorCoord C.nodes.length D N i 0))
    (fun k => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
      (Fin.succ (Fin.castAdd (C.nodes.length+1) k))))
    (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
      (Fin.succ (Fin.natAdd 3 j)))))

theorem stateProduct_size (a q D N : ℕ) (C : Circuit (Fin a))
    (wire : Fin (IndexedStateEncoding.stateWidth C.nodes.length D N) → Fin q) :
    (stateProduct a q D N C wire).size ≤ N * (50*(C.nodes.length+1)+21) := by
  rw [stateProduct,multiply_size]
  have h := List.sum_le_sum (l := List.ofFn fun i : Fin N => slot a q C.nodes.length C
      (wire (IndexedStateEncoding.factorCoord C.nodes.length D N i 0))
      (fun k => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
        (Fin.succ (Fin.castAdd (C.nodes.length+1) k))))
      (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
        (Fin.succ (Fin.natAdd 3 j)))))
    (f := Formula.size) (g := fun _ => 50*(C.nodes.length+1)+20) (by
      intro x hx
      obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hx
      exact slot_size a q C.nodes.length C _ _ _)
  simp only [List.map_ofFn] at h
  simp [Function.comp_def] at h
  simp only [List.length_ofFn,List.map_ofFn,Function.comp_apply]
  simp only [Function.comp_def]
  nlinarith

theorem stateProduct_eval (a q D N : ℕ) (C : Circuit (Fin a))
    (s : {s : State // IndexedStateEncoding.admissible C.nodes.length D N s})
    (wire : Fin (IndexedStateEncoding.stateWidth C.nodes.length D N) → Fin q) (z : Fin q → Fin 2)
    (hwire : ∀ j, witnessBool (z (wire j)) = IndexedStateEncoding.stateWord C.nodes.length D N s j) :
    witnessEval a q z (stateProduct a q D N C wire).value =
      (s.val.factors.map (fun l => (leafFormula C l).value)).prod := by
  rw [stateProduct,multiply_eval,List.map_ofFn]
  let xs := IndexedStateEncoding.factorItems C.nodes.length D N s
  have heq : (List.ofFn (fun i : Fin N => witnessEval a q z
      (slot a q C.nodes.length C
        (wire (IndexedStateEncoding.factorCoord C.nodes.length D N i 0))
        (fun k => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
          (Fin.succ (Fin.castAdd (C.nodes.length+1) k))))
        (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
          (Fin.succ (Fin.natAdd 3 j))))).value)) =
      List.ofFn (fun i : Fin N => (xs[i.val]?).elim 1 (fun x => (leafFormula C x.val).value)) := by
    congr 1
    funext i
    have h := state_slot a q D N C s i wire z hwire
    cases hx : xs[i.val]? <;> simpa [xs,hx,factorFormula,Formula.value] using h
  change (List.ofFn (fun i : Fin N => witnessEval a q z
      (slot a q C.nodes.length C
        (wire (IndexedStateEncoding.factorCoord C.nodes.length D N i 0))
        (fun k => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
          (Fin.succ (Fin.castAdd (C.nodes.length+1) k))))
        (fun j => wire (IndexedStateEncoding.factorCoord C.nodes.length D N i
          (Fin.succ (Fin.natAdd 3 j))))).value)).prod = _
  rw [heq,padded_product N xs _]
  · have hv : xs.map Subtype.val = s.val.factors :=
      BoundedListEncoding.liftList_values _ _
    calc
      (xs.map (fun x => (leafFormula C x.val).value)).prod =
          ((xs.map Subtype.val).map (fun x => (leafFormula C x).value)).prod := by
            simp [List.map_map,Function.comp_def]
      _ = _ := by rw [hv]
  · simpa [xs,IndexedStateEncoding.factorItems,BoundedListEncoding.liftList_length] using s.property.2.2.1


end FactorSlotPayload

-- From Solutions.StatePaddingPayload

/-! Check that the decoder's remaining input contains only zero padding,
    and gate the factor product by that Boolean condition. -/

namespace StatePaddingPayload

open ResultantVNP PermanentFoundation BooleanVerifierFormula IndexedFactorMachine IndexedStateEncoding
  BoundedListEncoding FactorSlotPayload VNPNestedBooleanSum

def paddingChecks (q N : ℕ) (data : Fin N → Fin q) : List (BoolFormula (Fin q)) :=
  List.ofFn (fun i => .not (.bit (data i)))

def paddingChecker (q N : ℕ) (data : Fin N → Fin q) : BoolFormula (Fin q) :=
  conjunction (paddingChecks q N data)

theorem paddingChecker_correct (q N : ℕ) (data : Fin N → Fin q) (z : Fin q → Bool) :
    (paddingChecker q N data).test z = true ↔ ∀ i, z (data i) = false := by
  rw [paddingChecker,conjunction_test,List.all_eq_true]
  constructor
  · intro h i
    have hh := h _ (show BoolFormula.not (.bit (data i)) ∈ paddingChecks q N data by
      exact List.mem_ofFn.mpr ⟨i,rfl⟩)
    simpa [BoolFormula.test] using hh
  · intro h p hp
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hp
    simp [BoolFormula.test,h i]

theorem paddingChecker_nodes (q N : ℕ) (data : Fin N → Fin q) :
    (paddingChecker q N data).nodes = 3*N+1 := by
  simp only [paddingChecker,conjunction_nodes,paddingChecks,List.map_ofFn,List.length_ofFn]
  simp [Function.comp_def,BoolFormula.nodes]
  omega

theorem slot_data (bits : List Bool) (i : ℕ) :
    slotAt 1 bitWord bits i 1 = (bits[i]?).getD false := by
  cases h : bits[i]? <;> simp [slotAt,optionWord,bitWord,h]

theorem all_slots_zero (bits : List Bool) (N : ℕ) (hlen : bits.length ≤ N) :
    (∀ i : Fin N, (bits[i.val]?).getD false = false) ↔
      bits = List.replicate bits.length false := by
  rw [List.eq_replicate_length]
  constructor
  · intro h b hb
    obtain ⟨i,hi,rfl⟩ := List.getElem_of_mem hb
    have hh := h ⟨i,by omega⟩
    simpa [List.getElem?_eq_getElem hi] using hh
  · intro h i
    by_cases hi : i.val < bits.length
    · have hm : bits[i.val] ∈ bits := List.getElem_mem hi
      simpa [List.getElem?_eq_getElem hi] using h _ hm
    · simp [List.getElem?_eq_none (by omega : bits.length ≤ i.val)]

theorem state_padding_correct (q D N : ℕ) {σ : Type} (C : Circuit σ)
    (s : {s : State // admissible C.nodes.length D N s})
    (wire : Fin (stateWidth C.nodes.length D N) → Fin q) (z : Fin q → Fin 2)
    (hwire : ∀ j, witnessBool (z (wire j)) = stateWord C.nodes.length D N s j) :
    (paddingChecker q N (fun i => wire (inputCoord C.nodes.length D N i 1))).test
        (fun i => witnessBool (z i)) = true ↔
      s.val.bits = List.replicate s.val.bits.length false := by
  rw [paddingChecker_correct,← all_slots_zero s.val.bits N s.property.2.2.2]
  simp only [hwire,stateWord_inputSlot,slot_data]

noncomputable def statePayload (a q D N : ℕ) (C : Circuit (Fin a))
    (wire : Fin (stateWidth C.nodes.length D N) → Fin q) : Formula (Fin (a+q)) :=
  .mul (witnessFormula a q (paddingChecker q N (fun i => wire (inputCoord C.nodes.length D N i 1))))
    (stateProduct a q D N C wire)

theorem statePayload_eval (a q D N : ℕ) (C : Circuit (Fin a))
    (s : {s : State // admissible C.nodes.length D N s})
    (wire : Fin (stateWidth C.nodes.length D N) → Fin q) (z : Fin q → Fin 2)
    (hwire : ∀ j, witnessBool (z (wire j)) = stateWord C.nodes.length D N s j) :
    witnessEval a q z (statePayload a q D N C wire).value =
      if s.val.bits = List.replicate s.val.bits.length false then
        (s.val.factors.map (fun l => (leafFormula C l).value)).prod else 0 := by
  rw [statePayload,witness_filter,stateProduct_eval a q D N C s wire z hwire]
  have h := state_padding_correct q D N C s wire z hwire
  by_cases hz : s.val.bits = List.replicate s.val.bits.length false
  · rw [h.mpr hz]
    simp only [Bool.true_eq,if_true,if_pos hz]
  · have hb : (paddingChecker q N (fun i => wire (inputCoord C.nodes.length D N i 1))).test
        (fun i => witnessBool (z i)) = false := by
      cases hc : (paddingChecker q N (fun i => wire (inputCoord C.nodes.length D N i 1))).test
          (fun i => witnessBool (z i)) with
      | false => rfl
      | true => exact (hz (h.mp hc)).elim
    rw [hb]
    simp only [Bool.false_eq_true,if_false,if_neg hz]

theorem statePayload_size (a q D N : ℕ) (C : Circuit (Fin a))
    (wire : Fin (stateWidth C.nodes.length D N) → Fin q) :
    (statePayload a q D N C wire).size ≤
      7*(3*N+1) + N*(50*(C.nodes.length+1)+21)+1 := by
  have h := witness_filter_size a q (paddingChecker q N (fun i => wire (inputCoord C.nodes.length D N i 1)))
    (stateProduct a q D N C wire)
  rw [paddingChecker_nodes] at h
  have hp := stateProduct_size a q D N C wire
  exact le_trans h (by omega)


end StatePaddingPayload

-- From Solutions.CircuitCompactCorrect

namespace CircuitCompactCorrect

open ResultantVNP CircuitReferenceBound CircuitValueRecurrence MvPolynomial

variable {σ : Type}

/-- Compact renumbering preserves every relevant node's polynomial. -/
theorem compactValues_preserved (C : Circuit σ) (k : Fin (relevantPositions C).card) :
    (compactCircuit C).values.getD k.val 0 = C.values.getD (relevantAt C k) 0 := by
  have hmain : ∀ i, ∀ hi : i < (relevantPositions C).card,
      (compactCircuit C).values.getD i 0 =
        C.values.getD (relevantAt C ⟨i,hi⟩) 0 := by
    intro i
    induction i using Nat.strong_induction_on with
    | h i ih =>
      intro hi
      let k : Fin (relevantPositions C).card := ⟨i,hi⟩
      have hc : i < (compactCircuit C).nodes.length := by simp [compactCircuit,hi]
      have ho : relevantAt C k < C.nodes.length :=
        relevantPositions_lt_length C _ (relevantAt_mem C k)
      rw [values_step_full (compactCircuit C) i hc, values_step_full C (relevantAt C k) ho]
      have hn : (compactCircuit C).nodes[i]'hc = compactNode C k := by
        simp [compactCircuit,k]
      rw [hn]
      have hchild (j : ℕ) (hj : j ∈ nodeReferences (C.nodes[relevantAt C k]'ho)) :
          (compactCircuit C).values.getD (compactIndex C j) 0 = C.values.getD j 0 := by
        obtain ⟨hmem,hlt⟩ := compact_gate_inputs C k j hj
        have hh := ih (relevantRank C j hmem).val hlt (relevantRank C j hmem).isLt
        simpa [compactIndex,hmem,relevantAt_rank] using hh
      unfold compactNode
      cases h : C.nodes[relevantAt C k]'ho with
      | var x => rfl
      | const a => rfl
      | add x y =>
        have hx := hchild x (by simp [h,nodeReferences])
        have hy := hchild y (by simp [h,nodeReferences])
        simpa [Node.eval] using congrArg₂ (· + ·) hx hy
      | mul x y =>
        have hx := hchild x (by simp [h,nodeReferences])
        have hy := hchild y (by simp [h,nodeReferences])
        simpa [Node.eval] using congrArg₂ (· * ·) hx hy
  exact hmain k.val k.isLt

theorem output_mem_relevant (C : Circuit σ) : C.nodes.length - 1 ∈ relevantPositions C := by
  simp [relevantPositions]

/-- The last compact position is the original output position. -/
theorem compact_last_position (C : Circuit σ) :
    let m := (relevantPositions C).card
    ∀ hm : 0 < m, relevantAt C ⟨m - 1, by omega⟩ = C.nodes.length - 1 := by
  dsimp only
  intro hm
  let k : Fin (relevantPositions C).card := ⟨(relevantPositions C).card - 1, by omega⟩
  let out := C.nodes.length - 1
  have hout : out ∈ relevantPositions C := output_mem_relevant C
  have hpos : relevantAt C k < C.nodes.length :=
    relevantPositions_lt_length C _ (relevantAt_mem C k)
  have hlen : 0 < C.nodes.length := List.length_pos_iff.mpr C.nonempty
  have hle : relevantAt C k ≤ out := by dsimp [out]; omega
  change relevantAt C k = out
  by_contra hn
  have hlt : relevantAt C k < out := by omega
  have hrank := relevantRank_lt C (relevantAt C k) out (relevantAt_mem C k) hout hlt
  rw [relevantRank_at] at hrank
  have hbound := (relevantRank C out hout).isLt
  change k.val < (relevantRank C out hout).val at hrank
  dsimp [k] at hrank
  omega

private theorem getD_last {α : Type} (l : List α) (d : α) :
    l.getD (l.length - 1) d = l.getLastD d := by
  simp only [List.getD_eq_getElem?_getD, List.getLastD_eq_getLast?,
    List.getLast?_eq_getElem?]

/-- Pruning unreferenced nodes and renumbering the rest preserves output. -/
theorem compactCircuit_value (C : Circuit σ) : (compactCircuit C).value = C.value := by
  have hm : 0 < (relevantPositions C).card := by
    apply Finset.card_pos.mpr
    exact ⟨C.nodes.length - 1, output_mem_relevant C⟩
  let k : Fin (relevantPositions C).card := ⟨(relevantPositions C).card - 1, by omega⟩
  have h := compactValues_preserved C k
  have hp : relevantAt C k = C.nodes.length - 1 := compact_last_position C hm
  rw [hp] at h
  have hc : (compactCircuit C).values.length = (relevantPositions C).card := by
    rw [values_length]
    simp [compactCircuit]
  have ho := values_length C
  change (compactCircuit C).values.getLastD 0 = C.values.getLastD 0
  rw [← getD_last, ← getD_last, hc, ho]
  exact h

/-- Gate-counted circuits admit equivalent representations with only
    linearly many total nodes, including input leaves. -/
theorem compactCircuit_exists (C : Circuit σ) :
    ∃ D : Circuit σ, D.value = C.value ∧ D.nodes.length ≤ 2 * C.size + 1 ∧
      D.size ≤ 2 * C.size + 1 :=
  ⟨compactCircuit C, compactCircuit_value C, compactCircuit_node_bound C,
    compactCircuit_size_bound C⟩


end CircuitCompactCorrect

