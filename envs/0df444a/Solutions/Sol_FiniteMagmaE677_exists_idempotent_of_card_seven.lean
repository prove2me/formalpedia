  decide

/-- Every element of `Fin 7` is a numeral; the value `5` is the last case. -/
theorem cv5 (w : Fin 7) : w = 0 ∨ w = 1 ∨ w = 2 ∨ w = 3 ∨ w = 4 ∨ w = 6 ∨ w = 5 := by
