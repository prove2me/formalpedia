-- title:
--   Lee homology of a knot has rank $2$
-- statement:
--   For a knot diagram $D$ in normal form, the degree-zero Lee homology $H^0_{\mathrm{Lee}}(D)$ over $\mathbb{Q}$ is finite-dimensional of dimension $2$. This is Lee's theorem that the Lee homology of a knot is supported in homological degree $0$ with rank $2$, generated by the two orientation classes.
-- source:
--   Lee, An endomorphism of the Khovanov invariant, Adv. Math. 197 (2005) 554–586, https://arxiv.org/abs/math/0210213

import Mathlib
import Definitions.Def_ManolescuPiccirillo_PD
import Definitions.Def_ManolescuPiccirillo_Kirby
import Definitions.Def_ManolescuPiccirillo_Movie
import Definitions.Def_ManolescuPiccirillo_Lee1
import Definitions.Def_ManolescuPiccirillo_Lee2

namespace ManolescuPiccirillo
theorem lee_homology_rank (D : PD) (hD : D.IsKnot) (hN : D.NormalForm) :
    FiniteDimensional ℚ D.H0 ∧ Module.finrank ℚ D.H0 = 2 := by sorry
end ManolescuPiccirillo
