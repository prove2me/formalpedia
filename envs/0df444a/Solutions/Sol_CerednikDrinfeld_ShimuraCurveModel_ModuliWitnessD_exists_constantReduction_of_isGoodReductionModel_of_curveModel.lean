  have hjloc : ∀ x : O₀, IsUnit (j x) → IsUnit x := isUnit_of_isUnit_map_of_dvr j _ hℓ0 hℓnu

  obtain ⟨𝔐, e𝔐, he𝔐iso, he𝔐base, hptsx, -⟩ := hpts
  let ec : pullback w.πX w.sbar ≅ pullback w.πX (Spec.map (CommRingCat.ofHom (𝔅.subtype.comp i))) :=
    pullback.congrHom rfl hsbar
  have hec_fst : ec.hom ≫ pullback.fst _ _ = pullback.fst w.πX w.sbar := by
