                              B * (pairs.get iFin).2) / Int.ofNat dk
                 let curr := (Int.ofNat dkNext * (pairs.get iFin).2 -
                              B * (pairs.get iFin).1) / Int.ofNat dk
                 ((s.ν.getRow iFin).set km1 prev).set kFin curr).get jFin) =
