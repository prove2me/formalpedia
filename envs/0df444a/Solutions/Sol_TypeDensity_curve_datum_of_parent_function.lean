/-- A prime of the chart containing `t` contains the exceptional ideal. -/
private theorem chartExceptional_le (P : Ideal (BlowupChart R t x))
    (hP : chartBase R t x t ∈ P) : chartExceptional R t x ≤ P := by
  unfold chartExceptional
  rw [Ideal.span_le, Set.singleton_subset_iff]; exact hP

/-- A curve with nonzero reduction meets the exceptional line in finitely many overlap points. -/
private theorem points_finite [(Ideal.span ({t,x} : Set R)).IsMaximal]
    (e : (BlowupChart R t x ⧸ chartExceptional R t x) ≃+* Polynomial
        (R ⧸ Ideal.span ({t,x} : Set R)))
    (he : ∀ r : R, e (Ideal.Quotient.mk (chartExceptional R t x) (chartBase R t x r)) =
      Polynomial.C (Ideal.Quotient.mk (Ideal.span ({t,x} : Set R)) r))
    (heZ : e (Ideal.Quotient.mk (chartExceptional R t x) (chartSlope R t x)) = Polynomial.X)
    (F : BlowupChart R t x) (hF : e (Ideal.Quotient.mk (chartExceptional R t x) F) ≠ 0) :
    Finite {Q : Ideal (BlowupOverlap R t x) // Q.IsMaximal ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) ∈ Q ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) F ∈ Q} := by
  classical
  let := Ideal.Quotient.field (Ideal.span ({t,x} : Set R))
  set g := e (Ideal.Quotient.mk (chartExceptional R t x) F) with hg
  have key : ∀ Q : {Q : Ideal (BlowupOverlap R t x) // Q.IsMaximal ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) ∈ Q ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) F ∈ Q},
      ∃ φ ∈ UniqueFactorizationMonoid.normalizedFactors g,
        ((Q.1.comap (algebraMap (BlowupChart R t x) (BlowupOverlap R t x))).map
          (Ideal.Quotient.mk (chartExceptional R t x))).map e = Ideal.span {φ} := by
    rintro ⟨Q, hQm, hQt, hQF⟩
    have := hQm
    obtain ⟨hPm, -, hPt⟩ := overlap_exceptional_point_comap_maximal R t x Q hQt
    have := hPm
    obtain ⟨ψ, -, hirr, hmap, -, -⟩ := blowup_chart_exceptional_point_polynomial R t x e he heZ
      (Q.comap (algebraMap (BlowupChart R t x) (BlowupOverlap R t x))) hPt
    have hmem : g ∈ Ideal.span {ψ} := by
      rw [← hmap]
      exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem _ hQF)
    rw [Ideal.mem_span_singleton] at hmem
    obtain ⟨q, hq, hassoc⟩ :=
        UniqueFactorizationMonoid.exists_mem_normalizedFactors_of_dvd hF hirr hmem
    refine ⟨q, hq, ?_⟩
    rw [hmap]
    exact Ideal.span_singleton_eq_span_singleton.mpr hassoc
  choose φ hφ hφeq using key
  refine Finite.of_injective (β := (UniqueFactorizationMonoid.normalizedFactors g).toFinset)
    (fun Q => ⟨φ Q, Multiset.mem_toFinset.mpr (hφ Q)⟩) ?_
  intro Q1 Q2 h12
  have h12' : φ Q1 = φ Q2 := congrArg Subtype.val h12
  have hmaps := (hφeq Q1).trans (h12' ▸ (hφeq Q2).symm)
  rw [← Ideal.comap_symm, ← Ideal.comap_symm] at hmaps
  have hmaps' := Ideal.comap_injective_of_surjective _ e.symm.surjective hmaps
  have ht : ∀ Q : {Q : Ideal (BlowupOverlap R t x) // Q.IsMaximal ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) ∈ Q ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) F ∈ Q},
      chartExceptional R t x ≤ Q.1.comap (algebraMap (BlowupChart R t x) (BlowupOverlap R t x)) :=
    fun Q => chartExceptional_le t x _ Q.2.2.1
  have hc := quot_ext_eq _ _ _ (ht Q1) (ht Q2) hmaps'
  apply Subtype.ext
  rw [← IsLocalization.map_under (Submonoid.powers (chartSlope R t x)) (BlowupOverlap R t x) Q1.1,
    ← IsLocalization.map_under (Submonoid.powers (chartSlope R t x)) (BlowupOverlap R t x) Q2.1]
  exact congrArg _ hc

/-- There is at most one maximal ideal of the chart containing `t`, `x/t` and a given `F`. -/
private theorem zero_points_subsingleton [(Ideal.span ({t,x} : Set R)).IsMaximal]
    (e : (BlowupChart R t x ⧸ chartExceptional R t x) ≃+* Polynomial
        (R ⧸ Ideal.span ({t,x} : Set R)))
    (he : ∀ r : R, e (Ideal.Quotient.mk (chartExceptional R t x) (chartBase R t x r)) =
      Polynomial.C (Ideal.Quotient.mk (Ideal.span ({t,x} : Set R)) r))
    (heZ : e (Ideal.Quotient.mk (chartExceptional R t x) (chartSlope R t x)) = Polynomial.X)
    (F : BlowupChart R t x) :
    Subsingleton {P : Ideal (BlowupChart R t x) // P.IsMaximal ∧ chartBase R t x t ∈ P ∧
      chartSlope R t x ∈ P ∧ F ∈ P} := by
  constructor
  have key : ∀ P : {P : Ideal (BlowupChart R t x) // P.IsMaximal ∧ chartBase R t x t ∈ P ∧
      chartSlope R t x ∈ P ∧ F ∈ P},
      (P.1.map (Ideal.Quotient.mk (chartExceptional R t x))).map e = Ideal.span {Polynomial.X} := by
    rintro ⟨P, hPm, hPt, hPZ, -⟩
    have := hPm
    obtain ⟨ψ, -, -, hmap, hZ, -⟩ := blowup_chart_exceptional_point_polynomial R t x e he heZ P hPt
    rw [hmap, hZ.mp hPZ]
  intro P1 P2
  have hmaps := (key P1).trans (key P2).symm
  rw [← Ideal.comap_symm, ← Ideal.comap_symm] at hmaps
  have hmaps' := Ideal.comap_injective_of_surjective _ e.symm.surjective hmaps
  exact Subtype.ext
      (quot_ext_eq _ _ _ (chartExceptional_le t x _ P1.2.2.1)
        (chartExceptional_le t x _ P2.2.2.1) hmaps')

section Overlap

variable (beta : BlowupRestriction R t x)

/-- If `f = t^d F_A` on the `t`-chart and `f = x^d F_B` on the `x`-chart, then `F_A = Z^d F_B`
on the overlap, where `Z = x/t`. -/
private theorem overlap_relation (d : ℕ) (f : R) (FA : BlowupChart R t x) (FB : BlowupChart R x t)
    (hFA : algebraMap R (BlowupChart R t x) f = (chartBase R t x t) ^ d * FA)
    (hFB : algebraMap R (BlowupChart R x t) f = (chartBase R x t x) ^ d * FB)
    (hreg : Function.Injective (fun y : BlowupOverlap R t x =>
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) * y)) :
    algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA =
      (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartSlope R t x)) ^ d *
        beta.right FB := by
  apply IsLeftRegular.pow d (show IsLeftRegular _ from hreg)
  have h1 : algebraMap (BlowupChart R t x) (BlowupOverlap R t x)
      (algebraMap R (BlowupChart R t x) f) = beta.right (algebraMap R (BlowupChart R x t) f) := by
    rw [AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  have hx : beta.right (chartBase R x t x) =
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) *
        algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartSlope R t x) := by
    rw [← map_mul, blowup_chart_relation, chartBase_apply_eq_algebraMap,
      chartBase_apply_eq_algebraMap, AlgHom.commutes, ← IsScalarTower.algebraMap_apply]
  simp only
  rw [hFA, hFB, map_mul, map_mul, map_pow, map_pow, hx] at h1
  rw [h1]; ring

variable {beta} in
/-- At a maximal ideal `Q` of the overlap containing `F_A = Z^d F_B`, the transported local
equation of `F_A` generates the same ideal as `F_B` on the `x`-chart, and `F_B ∈ Q`. -/
private theorem right_common_point_span (d : ℕ) (FA : BlowupChart R t x)
    (FB : BlowupChart R x t)
    (hrel : algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA =
      (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartSlope R t x)) ^ d *
        beta.right FB)
    (Q : Ideal (BlowupOverlap R t x)) [hQ : Q.IsMaximal]
    (hQF : algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA ∈ Q)
    (Ψ : CompletedLocalAt (BlowupOverlap R t x) Q ≃+*
      CompletedLocalAt (BlowupChart R x t) (Q.comap beta.right.toRingHom))
    (hΨ : ∀ b : BlowupChart R x t, Ψ (completedPointMap (BlowupOverlap R t x) Q (beta.right b)) =
      completedPointMap (BlowupChart R x t) (Q.comap beta.right.toRingHom) b) :
    Ideal.span {Ψ (completedPointMap (BlowupOverlap R t x) Q
        (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA))} =
      Ideal.span {completedPointMap (BlowupChart R x t) (Q.comap beta.right.toRingHom) FB} ∧
      beta.right FB ∈ Q := by
  have hZu : IsUnit ((algebraMap (BlowupChart R t x) (BlowupOverlap R t x)
      (chartSlope R t x)) ^ d) := (IsLocalization.Away.algebraMap_isUnit _).pow d
  rw [hrel] at hQF ⊢
  refine ⟨?_, (hQ.isPrime.mem_or_mem hQF).resolve_left
    fun h => hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ h hZu)⟩
  rw [map_mul, map_mul, hΨ]
  exact Ideal.span_singleton_mul_left_unit ((hZu.map _).map Ψ) _

variable {beta} in
/-- A maximal ideal of the `x`-chart containing `x` and `F_B` but not the slope `t/x` is the
contraction of a maximal ideal of the overlap containing `t` and `F_A = Z^d F_B`. -/
private theorem right_point_of_overlap (d : ℕ) (FA : BlowupChart R t x) (FB : BlowupChart R x t)
    (hrel : algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA =
      (algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartSlope R t x)) ^ d *
        beta.right FB)
    (P : Ideal (BlowupChart R x t)) [P.IsMaximal] (hPx : chartBase R x t x ∈ P) (hPF : FB ∈ P)
    (hW : chartSlope R x t ∉ P) :
    ∃ Q : Ideal (BlowupOverlap R t x), (Q.IsMaximal ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) ∈ Q ∧
      algebraMap (BlowupChart R t x) (BlowupOverlap R t x) FA ∈ Q) ∧
      Q.comap beta.right.toRingHom = P := by
  let : Algebra (BlowupChart R x t) (BlowupOverlap R t x) := beta.right.toRingHom.toAlgebra
  have := blowup_overlap_isLocalization_right R t x beta
  obtain ⟨hQm, hQc⟩ := localization_map_maximal (S := BlowupOverlap R t x) (chartSlope R x t) P hW
  have ht : algebraMap (BlowupChart R t x) (BlowupOverlap R t x) (chartBase R t x t) =
      beta.right (chartBase R x t t) := by
    rw [chartBase_apply_eq_algebraMap, chartBase_apply_eq_algebraMap, AlgHom.commutes,
      ← IsScalarTower.algebraMap_apply]
  refine ⟨_, ⟨hQm, ?_, ?_⟩, hQc⟩
  · rw [ht, ← blowup_chart_relation]
    exact Ideal.mem_map_of_mem _ (Ideal.mul_mem_right _ _ hPx)
  · rw [hrel]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem (algebraMap _ _) hPF)

end Overlap

end General

section Concrete

variable (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [IsAdicComplete (IsLocalRing.maximalIdeal O) O] [Finite (IsLocalRing.ResidueField O)]
  (pi : O) (u : (TwoSeries O)ˣ) (a b : ℕ)

section Form

variable (d : ℕ) (c : Fin (d + 1) → ConcreteSurface O pi u a b)

/-- The local data of the curve `∑ cᵢ t^(d-i) x^i = 0` on the blow-up: its points on the
exceptional divisor (on the overlap, at `Z = 0` and at infinity), all of them listed, with local
equations `F_A = ∑ cᵢ Z^i` and `F_B = ∑ cᵢ W^(d-i)`. -/
private theorem exists_curve_datum_points (hpi : Irreducible pi) (ha : 0 < a)
    (hne : ∃ i : Fin (d + 1), c i ∉ Ideal.span {(surfaceT O pi u a b), (surfaceX O pi u a b)}) (beta : BlowupRestriction (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) :
    ∃ D : TwoChartCurveData (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) beta,
      (∀ i, D.g i = completedPointMap (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (D.Q i) (algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftForm O pi u a b d c)) ∧
        algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftForm O pi u a b d c) ∈ D.Q i) ∧
      (∀ Q : Ideal (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)), Q.IsMaximal → algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) ∈ Q →
        algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftForm O pi u a b d c) ∈ Q → ∃ i, D.Q i = Q) ∧
      (∀ k, D.g0 k = completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (D.P0 k) (leftForm O pi u a b d c) ∧ (leftForm O pi u a b d c) ∈ D.P0 k) ∧
      (∀ P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)), P.IsMaximal → chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P → chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ P →
        (leftForm O pi u a b d c) ∈ P → ∃ k, D.P0 k = P) ∧
      (∀ l, D.ginf l = completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) (D.Pinf l) (rightForm O pi u a b d c) ∧ (rightForm O pi u a b d c) ∈ D.Pinf l) ∧
      ∀ P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)), P.IsMaximal → chartBase (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ P → chartSlope (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P →
        (rightForm O pi u a b d c) ∈ P → ∃ l, D.Pinf l = P := by
  have : (Ideal.span ({(surfaceT O pi u a b), (surfaceX O pi u a b)} : Set (ConcreteSurface O pi u a b))).IsMaximal :=
    concrete_surface_parameterIdeal_isMaximal O pi hpi u a b ha
  have : IsNoetherianRing (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) := blowupChart_concrete_isNoetherianRing O pi u a b (surfaceT O pi u a b) (surfaceX O pi u a b)
  have : IsNoetherianRing (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) := blowupChart_concrete_isNoetherianRing O pi u a b (surfaceX O pi u a b) (surfaceT O pi u a b)
  obtain ⟨e, he, heZ⟩ := exceptional_line_equiv_chart_exceptional (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)
  have hgne := reduction_ne_zero (surfaceT O pi u a b) (surfaceX O pi u a b) e he heZ d c hne
  -- transversality and finiteness at the points of the `t`-chart on the exceptional divisor
  have hL : ∀ (P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))) [P.IsMaximal], chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P → _ := fun P _ hP =>
    concrete_strict_transform_transverse_finite O pi hpi u a b ha (leftForm O pi u a b d c)
      (fun h => hgne (by rw [h, map_zero])) P hP
  -- common points on the overlap
  let ι := {Q : Ideal (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) // Q.IsMaximal ∧
      algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) ∈ Q ∧ algebraMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftForm O pi u a b d c) ∈ Q}
  have hιmax : ∀ i : ι, i.1.IsMaximal := fun i => i.2.1
  have hιP (i : ι) := overlap_exceptional_point_comap_maximal (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) i.1 i.2.2.1
  choose Φ hΦ using fun i : ι => completed_point_transport_left (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) i.1
  choose Ψ hΨ using fun i : ι => completed_point_transport_right (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) beta i.1
  have heT (i : ι) : (Φ i).symm (completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) _ (chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b))) * 1 =
      completedPointMap (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) i.1 (overlapException (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) := by
    rw [mul_one, RingEquiv.symm_apply_eq]; exact (hΦ i _).symm
  -- points at `Z = 0` and at infinity
  let ι0 := {P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) // P.IsMaximal ∧ chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P ∧ chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ P ∧
    (leftForm O pi u a b d c) ∈ P}
  have : Subsingleton ι0 := zero_points_subsingleton (surfaceT O pi u a b) (surfaceX O pi u a b) e he heZ (leftForm O pi u a b d c)
  have hι0max : ∀ k : ι0, k.1.IsMaximal := fun k => k.2.1
  let ιinf :=
    {P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) // P.IsMaximal ∧ chartBase (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ P ∧ chartSlope (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P ∧ (rightForm O pi u a b d c) ∈ P}
  have hιinfmax : ∀ l : ιinf, l.1.IsMaximal := fun l => l.2.1
  have hinf (l : ιinf) :=
    concrete_infinity_point_completion O pi hpi u a b ha l.1 l.2.2.1 l.2.2.2.1
  have : Subsingleton ιinf := ⟨fun l1 l2 => Subtype.ext ((hinf l1).1.trans (hinf l2).1.symm)⟩
  have hinf' (l : ιinf) :=
    concrete_infinity_strict_transform_transverse_finite O pi hpi u a b ha d c hne l.1 l.2.2.1
      l.2.2.2.1
  let D : TwoChartCurveData (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) beta :=
    { ι := ι
      fin := points_finite (surfaceT O pi u a b) (surfaceX O pi u a b) e he heZ (leftForm O pi u a b d c) hgne
      Q := fun i => i.1
      inj := Subtype.val_injective
      onE := fun i => i.2.2.1
      g := fun i => (Φ i).symm (completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) _ (leftForm O pi u a b d c))
      transverse := fun i =>
        have := (hιP i).1
        mul_injective_quotient_transport _ isUnit_one (heT i) (hL _ (hιP i).2.2).1
      finite := fun i =>
        have := (hιP i).1
        transport_finite _ i.1 (Φ i) (hΦ i) _ _ (hL _ (hιP i).2.2).2.2
      leftIso := Φ
      leftIso_compat := hΦ
      rightIso := Ψ
      rightIso_compat := hΨ
      ι0 := ι0
      fin0 := Finite.of_subsingleton
      P0 := fun k => k.1
      maximal0 := fun k => k.2.1
      inj0 := Subtype.val_injective
      slope0 := fun k => k.2.2.2.1
      onE0 := fun k => k.2.2.1
      g0 := fun k => completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) k.1 (leftForm O pi u a b d c)
      transverse0 := fun k => (hL k.1 k.2.2.1).1
      finite0 := fun k => (hL k.1 k.2.2.1).2.2
      ιinf := ιinf
      fininf := Finite.of_subsingleton
      Pinf := fun l => l.1
      maximalinf := fun l => l.2.1
      injinf := Subtype.val_injective
      slopeinf := fun l => l.2.2.2.1
      onEinf := fun l => l.2.2.1
      ginf := fun l => completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) l.1 (rightForm O pi u a b d c)
      transverseinf := fun l => (hinf' l).1
      finiteinf := fun l => (hinf' l).2.2 }
  refine ⟨D, fun i => ⟨(Φ i).symm_apply_eq.2 (hΦ i (leftForm O pi u a b d c)).symm, i.2.2.2⟩,
    fun Q hQm hQt hQF => ⟨⟨Q, hQm, hQt, hQF⟩, rfl⟩,
    fun k => ⟨rfl, k.2.2.2.2⟩, fun P hPm hPt hPZ hPF => ⟨⟨P, hPm, hPt, hPZ, hPF⟩, rfl⟩,
    fun l => ⟨rfl, l.2.2.2.2⟩, fun P hPm hPx hPW hPF => ⟨⟨P, hPm, hPx, hPW, hPF⟩, rfl⟩⟩

/-- `curve_datum_of_parent_function` in the section notation, with the strict transforms
`F_A`, `F_B` of the form on the two charts. -/
private theorem exists_curve_datum_of_sum (hpi : Irreducible pi) (ha : 0 < a) (f : (ConcreteSurface O pi u a b))
    (hc : f = ∑ i : Fin (d + 1), c i * (surfaceT O pi u a b) ^ (d - i.val) * (surfaceX O pi u a b) ^ i.val)
    (hne : ∃ i : Fin (d + 1), c i ∉ Ideal.span {(surfaceT O pi u a b), (surfaceX O pi u a b)}) (beta : BlowupRestriction ((ConcreteSurface O pi u a b)) (surfaceT O pi u a b) (surfaceX O pi u a b)) :
    ∃ D : TwoChartCurveData ((ConcreteSurface O pi u a b)) (surfaceT O pi u a b) (surfaceX O pi u a b) beta,
      (∀ s : D.ι ⊕ D.ι0, leftData D s = completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftPoint D s) (leftForm O pi u a b d c) ∧
        (leftForm O pi u a b d c) ∈ leftPoint D s) ∧
      (∀ P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)), P.IsMaximal → (chartBase ((ConcreteSurface O pi u a b)) (surfaceT O pi u a b) (surfaceX O pi u a b)) (surfaceT O pi u a b) ∈ P → (leftForm O pi u a b d c) ∈ P →
        ∃ s : D.ι ⊕ D.ι0, leftPoint D s = P) ∧
      (∀ s : D.ι ⊕ D.ιinf, Ideal.span {rightData D s} =
        Ideal.span {completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) (rightPoint D s) (rightForm O pi u a b d c)} ∧ (rightForm O pi u a b d c) ∈ rightPoint D s) ∧
      (∀ P : Ideal (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)), P.IsMaximal → (chartBase ((ConcreteSurface O pi u a b)) (surfaceX O pi u a b) (surfaceT O pi u a b)) (surfaceX O pi u a b) ∈ P → (rightForm O pi u a b d c) ∈ P →
        ∃ s : D.ι ⊕ D.ιinf, rightPoint D s = P) ∧
      (∀ s : D.ι ⊕ D.ι0,
        strictTransformAt ((ConcreteSurface O pi u a b)) (surfaceT O pi u a b) (surfaceX O pi u a b) (leftPoint D s) d (Ideal.span {f}) = Ideal.span {leftData D s})
      ∧ ∀ s : D.ι ⊕ D.ιinf,
        strictTransformAt ((ConcreteSurface O pi u a b)) (surfaceX O pi u a b) (surfaceT O pi u a b) (rightPoint D s) d (Ideal.span {f}) =
          Ideal.span {rightData D s} := by
  -- Take the curve datum of `exists_curve_datum_points`; on each chart `f = t^d F_A = x^d F_B`
  -- with `t` (resp. `x`) regular, so the strict transforms are `(F_A)` and `(F_B)`.
  have : (Ideal.span ({(surfaceT O pi u a b), (surfaceX O pi u a b)} : Set (ConcreteSurface O pi u a b))).IsMaximal :=
    concrete_surface_parameterIdeal_isMaximal O pi hpi u a b ha
  have hFA : algebraMap (ConcreteSurface O pi u a b) (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) f = (chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b))^d * (leftForm O pi u a b d c) := by
    rw [hc]; exact algebraMap_sum_eq_left _ _ d c
  have hFB : algebraMap (ConcreteSurface O pi u a b) (BlowupChart (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) f = (chartBase (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))^d * (rightForm O pi u a b d c) := by
    rw [hc]; exact algebraMap_sum_eq_right _ _ d c
  have hrel := overlap_relation (surfaceT O pi u a b) (surfaceX O pi u a b) beta d f _ _ hFA hFB
    (nonzerodivisor_survives_localization (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b)) (chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))
      (blowup_exceptional_parameter_regular (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)
        (concrete_surface_regular_pair_tx O pi hpi.ne_zero u a b ha)))
  obtain ⟨D, hg, hQ, hg0, hP0, hginf, hPinf⟩ :=
    exists_curve_datum_points O pi u a b d c hpi ha hne beta
  have hleftP : ∀ s : D.ι ⊕ D.ι0,
      (leftPoint D s).IsMaximal ∧ chartBase (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ leftPoint D s := by
    rintro (i | k)
    · obtain ⟨h1, -, h2⟩ := overlap_exceptional_point_comap_maximal (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (D.Q i) (D.onE i)
      exact ⟨h1, h2⟩
    · exact ⟨D.maximal0 k, D.onE0 k⟩
  have c1 : ∀ s : D.ι ⊕ D.ι0, leftData D s = completedPointMap (BlowupChart (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) (leftPoint D s) (leftForm O pi u a b d c) ∧
      (leftForm O pi u a b d c) ∈ leftPoint D s := by
    rintro (i | k)
    · exact ⟨(congrArg (D.leftIso i) (hg i).1).trans (D.leftIso_compat i _), (hg i).2⟩
    · exact hg0 k
  have c5 : ∀ s : D.ι ⊕ D.ι0, strictTransformAt (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) (leftPoint D s) d (Ideal.span {f}) =
      Ideal.span {leftData D s} := by
    intro s
    have := (hleftP s).1
    rw [(c1 s).1]
    exact strictTransformAt_span_eq (surfaceT O pi u a b) (surfaceX O pi u a b) (leftPoint D s) d f (leftForm O pi u a b d c) hFA
      (concrete_left_point_exceptional_regular O pi hpi u a b ha (leftPoint D s) (hleftP s).2)
  refine ⟨D, c1, ?_, ?_, ?_, c5, ?_⟩
  · intro P hPm hPt hPF
    by_cases hZ : chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) ∈ P
    · obtain ⟨k, hk⟩ := hP0 P hPm hPt hZ hPF
      exact ⟨Sum.inr k, hk⟩
    · obtain ⟨hQm, hQc⟩ := localization_map_maximal (S := (BlowupOverlap (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b))) (chartSlope (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b)) P hZ
      obtain ⟨i, hi⟩ := hQ _ hQm (Ideal.mem_map_of_mem _ hPt) (Ideal.mem_map_of_mem _ hPF)
      exact ⟨Sum.inl i, (congrArg (Ideal.comap _) hi).trans hQc⟩
  · rintro (i | l)
    · change Ideal.span {D.rightIso i (D.g i)} = _ ∧ _
      rw [(hg i).1]
      exact right_common_point_span (surfaceT O pi u a b) (surfaceX O pi u a b) d _ _ hrel (D.Q i) (hg i).2 _ (D.rightIso_compat i)
    · exact ⟨congrArg (fun y => Ideal.span {y}) (hginf l).1, (hginf l).2⟩
  · intro P hPm hPx hPF
    by_cases hW : chartSlope (ConcreteSurface O pi u a b) (surfaceX O pi u a b) (surfaceT O pi u a b) ∈ P
    · obtain ⟨l, hl⟩ := hPinf P hPm hPx hW hPF
      exact ⟨Sum.inr l, hl⟩
    · obtain ⟨Q, ⟨hQm, hQt, hQF⟩, hQc⟩ := right_point_of_overlap (surfaceT O pi u a b) (surfaceX O pi u a b) d _ _ hrel P hPx hPF hW
      obtain ⟨i, rfl⟩ := hQ Q hQm hQt hQF
      exact ⟨Sum.inl i, hQc⟩
  · rintro (i | l)
    · rw [← strict_transform_common_point_transport (ConcreteSurface O pi u a b) (surfaceT O pi u a b) (surfaceX O pi u a b) beta D i d (Ideal.span {f}),
        c5 (Sum.inl i)]
      refine (Ideal.map_span _ _).trans ?_
      rw [Set.image_singleton]
      exact congrArg (fun y => Ideal.span {D.rightIso i y}) ((D.leftIso i).symm_apply_apply _)
    · change _ = Ideal.span {D.ginf l}
      rw [(hginf l).1]
      exact strictTransformAt_span_eq (surfaceX O pi u a b) (surfaceT O pi u a b) (D.Pinf l) d f (rightForm O pi u a b d c) hFB
        (concrete_infinity_point_completion O pi hpi u a b ha (D.Pinf l) (D.onEinf l)
          (D.slopeinf l)).2.2.2.2

end Form

end Concrete

end TypeDensity

open TypeDensity

theorem solution (O : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
    [Finite (IsLocalRing.ResidueField O)] (pi : O) (hpi : Irreducible pi) (u : (TypeDensity.TwoSeries O)ˣ)
    (a b : ℕ) (ha : 0 < a) (d : ℕ) (f : TypeDensity.ConcreteSurface O pi u a b)
    (c : Fin (d + 1) → TypeDensity.ConcreteSurface O pi u a b)
    (hc : f = ∑ i : Fin (d + 1),
      c i * (TypeDensity.surfaceT O pi u a b) ^ (d - i.val) * (TypeDensity.surfaceX O pi u a b) ^ i.val)
    (hne : ∃ i : Fin (d + 1), c i ∉ Ideal.span {(TypeDensity.surfaceT O pi u a b), (TypeDensity.surfaceX O pi u a b)})
    (beta : TypeDensity.BlowupRestriction (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b)
      (TypeDensity.surfaceX O pi u a b)) :
    ∃ D : TypeDensity.TwoChartCurveData (TypeDensity.ConcreteSurface O pi u a b) (TypeDensity.surfaceT O pi u a b)
      (TypeDensity.surfaceX O pi u a b) beta,
