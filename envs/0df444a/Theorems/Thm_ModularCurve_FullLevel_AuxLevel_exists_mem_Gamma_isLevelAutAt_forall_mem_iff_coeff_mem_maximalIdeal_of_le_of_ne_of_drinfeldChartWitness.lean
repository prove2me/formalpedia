theorem ModularCurve.FullLevel.AuxLevel.exists_mem_Gamma_isLevelAutAt_forall_mem_iff_coeff_mem_maximalIdeal_of_le_of_ne_of_drinfeldChartWitness
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ3 : 3 ≤ ℓ) (hℓq : ℓ ≠ q) (hℓM' : ¬ ℓ ∣ M')
    (L : Type) [Field L] [CharZero L]
    (ξ : L) (hξ : IsPrimitiveRoot ξ (q * ℓ))

