-- status  : Definition
-- author  : @tomasz
-- created : 2026-09-20T21:22:43.578746+00:00
-- url     : https://prove2.me/theorems/b98b7fe7-6f8d-487b-b429-5174f57d0f44
-- title:
--   Global chart relation ideals and common component families
-- statement:
--   Let $S_0,\ldots,S_4$ be complex-valued functions. For chart $j\in\{0,1\}$ write $d_j=S_0$ or $S_2$, respectively, and let
--
--   $$U_j=\{z\in\mathbb C:d_j(z)\ne0\}.$$
--
--   Use the previously defined chart coordinates $v_j$, normalized polynomial $Q_j$, and derivation $\delta_j$ in the fixed ring $A=\mathbb C[X_0,X_1,X_2,X_3]$. Define
--
--   $$K_j^{\mathrm{glob}}=\bigcap_{z\in U_j}\ker(\operatorname{eval}_{v_j(z)}),
--   \qquad J_j^{\mathrm{glob}}=K_j^{\mathrm{glob}}+(Q_j).$$
--
--   Thus the global kernel consists of the polynomials vanishing along the whole available chart orbit. These definitions make no assertion that it is the ideal of the full algebraic group. They do not identify the two affine charts with one another.
--
--   For a natural number $T$, let $P_r(J)$ denote the ideal generated by the iterates through order $r$ of the chart derivation on elements of $J$. Define the labeled candidate set
--
--   $$\mathcal C_{L,S,Q,T}=\{(j,i,\mathfrak p):j\in\{0,1\},\ i\in\{0,1,2\},\
--   \mathfrak p\in\operatorname{Min}(P_{iT}(J_j^{\mathrm{glob}}))\cap
--   \operatorname{Min}(P_{(i+1)T}(J_j^{\mathrm{glob}}))\}.$$
--
--   It does not depend on a chosen point in the chart. Finiteness is a theorem conclusion, rather than a field of the definition.
--
--   For fixed $L,S,Q,T,e$ and a finite set $Z\subset\mathbb C$, `GlobalChartBaseBudget L S Q T e Z` chooses a chart $j$ and $z\in Z\cap U_j$. For every candidate $(j,i,\mathfrak p)$ with $\mathfrak p\subseteq\ker\operatorname{eval}_{v_j(z)}$, it requires
--
--   $$\operatorname{length}_{A_{\mathfrak p}}\bigl(A_{\mathfrak p}/P_{iT}(J_j^{\mathrm{glob}})A_{\mathfrak p}\bigr)\le e.$$
--
--   This is the earlier chart budget with the local germ base replaced by the global chart base. Their equivalence under the entire-coordinate hypothesis is proved separately.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 5, pp. 380-382: global derivative ideals and finite families of components in the zero-estimate proof. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. The complete affine consistency theorem proves that the analytic-orbit germ kernel at any available chart point equals the ideal of relations vanishing on the entire available chart orbit. Thus the canonical base is independent of the point within each chart, and the labeled component candidates form one finite family. The old and global chart budget data are equivalent under the entire-coordinate hypothesis. Identification with the full algebraic-group ideal, gluing the two charts, locus selection and the uniform total-degree estimate remain outside this result.

import Definitions.Def_WeierstrassEllipticZeta_ChartOrbitBase

noncomputable section
namespace WeierstrassEllipticZeta
open TranscendenceTheory

/-- Relations vanishing at every available point of a fixed chart orbit. -/
def extensionGlobalChartKernel (S : Fin 5 → ℂ → ℂ) (c : Fin 2) :
    Ideal (MvPolynomial (Fin 4) ℂ) :=
  ⨅ (z : ℂ) (_ : S (extensionChartDenominator c) z ≠ 0),
    RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S c z))

/-- A single base ideal for all available points in the chart. -/
def extensionGlobalChartBaseIdeal (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (c : Fin 2) : Ideal (MvPolynomial (Fin 4) ℂ) :=
  extensionGlobalChartKernel S c ⊔ Ideal.span {extensionChartNormalize c Q}

/-- Chart, stage and prime labels for the common component candidates. -/
def globalChartCandidates (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T : ℕ) :
    Set (Fin 2 × Fin 3 × Ideal (MvPolynomial (Fin 4) ℂ)) :=
  {a | a.2.2 ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ a.1)
      (extensionGlobalChartBaseIdeal S Q a.1) (a.2.1.val * T)).minimalPrimes ∧
    a.2.2 ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ a.1)
      (extensionGlobalChartBaseIdeal S Q a.1) ((a.2.1.val + 1) * T)).minimalPrimes}

/-- The canonical chart budget expressed using the common global base ideal. -/
structure GlobalChartBaseBudget (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T e : ℕ) (Z : Finset ℂ) where
  chart : Fin 2
  z : ℂ
  z_mem : z ∈ Z
  chart_ne : S (extensionChartDenominator chart) z ≠ 0
  length_le : ∀ (i : Fin 3) (p : Ideal (MvPolynomial (Fin 4) ℂ)) [p.IsPrime],
    p ≤ RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S chart z)) →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionGlobalChartBaseIdeal S Q chart) (i.val * T)).minimalPrimes →
    p ∈ (differentialProlongation (extensionChartDerivation L.g₂ L.g₃ chart)
      (extensionGlobalChartBaseIdeal S Q chart) ((i.val + 1) * T)).minimalPrimes →
    Module.length (Localization.AtPrime p)
      ((Localization.AtPrime p) ⧸ (differentialProlongation
        (extensionChartDerivation L.g₂ L.g₃ chart)
        (extensionGlobalChartBaseIdeal S Q chart) (i.val * T)).map
        (algebraMap (MvPolynomial (Fin 4) ℂ) (Localization.AtPrime p))) ≤ (e : ℕ∞)

end WeierstrassEllipticZeta


