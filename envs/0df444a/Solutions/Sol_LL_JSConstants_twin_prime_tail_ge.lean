abbrev TailIdx :=
  ((((Finset.range 51).subtype (fun p : ℕ => p.Prime ∧ 2 < p) :
      Finset {p : ℕ // p.Prime ∧ 2 < p}) : Set {p : ℕ // p.Prime ∧ 2 < p})ᶜ :
      Set {p : ℕ // p.Prime ∧ 2 < p})

def pVal (x : TailIdx) : ℕ := ((x : {p : ℕ // p.Prime ∧ 2 < p}) : ℕ)

lemma pVal_prime (x : TailIdx) : (pVal x).Prime := x.1.2.1

lemma pVal_ge_51 (x : TailIdx) : 51 ≤ pVal x := by
  by_contra hlt
  have hmem : (x : {p : ℕ // p.Prime ∧ 2 < p}) ∈
      (Finset.range 51).subtype (fun p : ℕ => p.Prime ∧ 2 < p) := by
    rw [Finset.mem_subtype, Finset.mem_range]
    dsimp [pVal] at hlt
    omega
  exact x.2 hmem

lemma pVal_injective : Function.Injective pVal := by
  intro x y hxy
  exact Subtype.ext (Subtype.ext hxy)

lemma exp_neg_bound : (0.996044 : ℝ) ≤ Real.exp (-(39638 / 10000000 : ℝ)) := by
  set c : ℝ := 39638 / 10000000
  have hc0 : 0 ≤ c := by norm_num [c]
  have hc1 : c ≤ 1 := by norm_num [c]
  have hexp := Real.exp_bound' hc0 hc1 (n := 4) (by norm_num)
  simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty, zero_add,
    Nat.factorial] at hexp
  have hexp_le : Real.exp c ≤ (1 / 0.996044 : ℝ) := by
    dsimp [c] at hexp ⊢
    linarith
  rw [Real.exp_neg]
  have hexp_pos : 0 < Real.exp c := Real.exp_pos c
  rw [le_inv_comm₀ (by norm_num) hexp_pos]
  linarith

end LL_JSConstants_TailGeWork

theorem solution :
    (0.996044 : ℝ) ≤ ∏' x : ((((Finset.range 51).subtype (fun p : ℕ => p.Prime ∧ 2 < p) :
        Finset {p : ℕ // p.Prime ∧ 2 < p}) : Set {p : ℕ // p.Prime ∧ 2 < p})ᶜ :
        Set {p : ℕ // p.Prime ∧ 2 < p}),
      (1 - 1 / ((((x : {p : ℕ // p.Prime ∧ 2 < p}) : ℕ) : ℝ) - 1) ^ 2) := by
  open LL_JSConstants_TailGeWork in
  let g : TailIdx → ℝ := fun x => 1 - 1 / ((pVal x : ℝ) - 1) ^ 2
  let f : TailIdx → ℝ := fun x => -(1 / ((pVal x : ℝ) - 1) ^ 2)
  have hg_pos : ∀ x : TailIdx, 0 < g x := by
    intro x
    have h51 := pVal_ge_51 x
    have hn_real : (51 : ℝ) ≤ (pVal x : ℝ) := by exact_mod_cast h51
    have hn1 : (50 : ℝ) ≤ (pVal x : ℝ) - 1 := by linarith
    have hsq : (2500 : ℝ) ≤ ((pVal x : ℝ) - 1) ^ 2 := by nlinarith
    have hdiv : 1 / ((pVal x : ℝ) - 1) ^ 2 ≤ 1 / 2500 :=
      one_div_le_one_div_of_le (by norm_num) hsq
    dsimp [g]
    linarith
  have hinj_sub : Function.Injective (fun x : TailIdx => pVal x - 1) := by
    intro x y hxy
    dsimp only at hxy
    have hx := pVal_ge_51 x
    have hy := pVal_ge_51 y
    apply pVal_injective
    omega
  have hsum_nat : Summable (fun n : ℕ => 1 / (n : ℝ) ^ 2) := by simp [one_div]
  have hf_sum : Summable f := by
    have hcomp := hsum_nat.comp_injective hinj_sub
    have hpos : Summable (fun x : TailIdx => -f x) := by
      refine hcomp.congr fun x => ?_
      have hx1 : 1 ≤ pVal x := le_trans (by norm_num) (pVal_ge_51 x)
      simp [f, Nat.cast_sub hx1]
    simpa using hpos.neg
  have hlog_sum : Summable (fun x : TailIdx => Real.log (g x)) := by
    have h1 := Real.summable_log_one_add_of_summable hf_sum
    refine h1.congr fun x => ?_
    dsimp [g, f]
    rw [← sub_eq_add_neg]
  have htprod : Real.exp (∑' x : TailIdx, Real.log (g x)) = ∏' x : TailIdx, g x :=
    Real.rexp_tsum_eq_tprod hg_pos hlog_sum
  have htsum_neg_le : (∑' x : TailIdx, termReal (pVal x)) ≤ (39638 : ℝ) / 10000000 := by
    refine Real.tsum_le_of_sum_le (fun x => termReal_nonneg (pVal_ge_51 x)) fun F => ?_
    have hinjF : Set.InjOn pVal F := fun a _ b _ h => pVal_injective h
    rw [← Finset.sum_image hinjF]
    refine finite_prime_sum_le (F.image pVal) ?_
    intro n hn
    rcases Finset.mem_image.mp hn with ⟨x, _, rfl⟩
    exact ⟨pVal_prime x, pVal_ge_51 x⟩
  have htsum_eq :
      (∑' x : TailIdx, Real.log (g x)) = -(∑' x : TailIdx, termReal (pVal x)) := by
    have : (fun x : TailIdx => Real.log (g x)) = (fun x : TailIdx => -termReal (pVal x)) := by
      ext x
      simp [g, termReal]
    rw [this, tsum_neg]
  change (0.996044 : ℝ) ≤ ∏' x : TailIdx, g x
  rw [← htprod, htsum_eq]
  refine le_trans exp_neg_bound ?_
  rw [Real.exp_le_exp]
  linarith
