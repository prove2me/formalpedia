namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-- **Clearing the block registers** (block constants at the per-block bound). -/
theorem popF2_sol_aux (s : IState HS) (G : Fin HS → List ℤ) {r0 o dt du : List ℤ}
    {n pk b BH Bk c : ℕ} (hb1 : zsz (n : ℤ) ≤ BH) (hb2 : zsz ((2 * n : ℕ) : ℤ) ≤ BH)
    (hb3 : zsz (kG b (2 * n) (2 ^ pk)) ≤ Bk) (hb4 : zsz ((2 ^ b : ℤ) ^ (2 * (2 * n))) ≤ Bk)
    (hBc : zsz ((c + 1 : ℕ) : ℤ) ≤ BH) :
    Sp popRS
      (encK s (BF G r0 [] [] o dt du [(n : ℤ)] [((2 * n : ℕ) : ℤ)]
        [((2 * n : ℕ) : ℤ)] [kG b (2 * n) (2 ^ pk)] [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)]))
      (encK s (BF G r0 [] [] o dt du [] [] [] [] [] [(c : ℤ)]))
      (14000 * (BH + 2) + 2 * (2 * Bk + 2)) := by
  have p1 := sp_pop (s := s) (BF G r0 [] [] o dt du [(n : ℤ)] [((2 * n : ℕ) : ℤ)]
    [((2 * n : ℕ) : ℤ)] [kG b (2 * n) (2 ^ pk)] [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)])
    (i := bN) (B := BH) (by decide) BF_bn hb1
  simp only [BFu_bn] at p1
  have p2 := sp_pop (s := s) (BF G r0 [] [] o dt du [] [((2 * n : ℕ) : ℤ)]
    [((2 * n : ℕ) : ℤ)] [kG b (2 * n) (2 ^ pk)] [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)])
    (i := bN2) (B := BH) (by decide) BF_bn2 hb2
  simp only [BFu_bn2] at p2
  have p3 := sp_pop (s := s) (BF G r0 [] [] o dt du [] []
    [((2 * n : ℕ) : ℤ)] [kG b (2 * n) (2 ^ pk)] [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)])
    (i := kr) (B := BH) (by decide) BF_vr hb2
  simp only [BFu_vr] at p3
  have p4 := sp_pop (s := s) (BF G r0 [] [] o dt du [] [] [] [kG b (2 * n) (2 ^ pk)]
    [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)]) (i := kK) (B := Bk) (by decide) BF_vk hb3
  simp only [BFu_vk] at p4
  have p5 := sp_pop (s := s) (BF G r0 [] [] o dt du [] [] [] []
    [(2 ^ b) ^ (2 * (2 * n))] [((c + 1 : ℕ) : ℤ)]) (i := kJ) (B := Bk) (by decide) BF_vj hb4
  simp only [BFu_vj] at p5
  have hcB : zsz (c : ℤ) ≤ BH := le_trans (KIL.zsz_nat_le (Nat.le_succ c)) hBc
  have hbc : BF G r0 [] [] o dt du [] [] [] [] [] [((c + 1 : ℕ) : ℤ)] BC =
      ((c + 1 : ℕ) : ℤ) :: [] := BF_bc
  have e6 : ((c + 1 : ℕ) : ℤ) + -1 = (c : ℤ) := by push_cast; ring
  have p6 := Sp.asg s (BF G r0 [] [] o dt du [] [] [] [] [] [((c + 1 : ℕ) : ℤ)]) (i := BC)
    (e := .add (.reg BC) (.lit (-1))) (B := BH) (by decide) hbc hBc
    (clean_add (clean_reg (by decide)) (clean_lit _)) ⟨ok_reg hbc, trivial⟩ ⟨trivial, trivial⟩
    ⟨bnd_reg hbc hBc, by
      have := le_trans (KIL.zsz_nat_le (show 1 ≤ c + 1 by omega)) hBc
      show zsz (-1 : ℤ) ≤ BH; rw [zsz_neg]; simpa using this, by
      simp only [Ex.eval, top_encK hbc]; rw [e6]; exact hcB⟩
  simp only [Ex.eval, top_encK hbc, e6, BFu_bc] at p6
  refine (p1.seq (p2.seq (p3.seq (p4.seq (p5.seq p6))))).mono ?_
  simp only [Ex.size]; omega

end J6Seg.KR

end

theorem solution : type_of% @J6Seg.KR.popF2_sol_aux := @J6Seg.KR.popF2_sol_aux
