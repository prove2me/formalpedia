  have hQ := succ_mul_four_pow_le_nine_pow p.L
  have hK : p.K ≤ 4 ^ p.L :=
    (Nat.choose_le_two_pow p.L p.m).trans (Nat.pow_le_pow_left (by norm_num) _)
  have hD : p.D ≤ 4 ^ p.L := by
    change 4 ^ p.m ≤ 4 ^ p.L
    exact Nat.pow_le_pow_right (by norm_num) hmL
  have hL4 : p.L + 1 ≤ 4 ^ p.L :=
    Nat.lt_two_pow_self.trans_le (Nat.pow_le_pow_left (by norm_num) _)
  have hKK : p.KK ≤ p.K := Nat.sqrt_le _
  have hKND : p.K * p.N0 * p.D ≤ p.S7 := Theorem30.K_mul_N0_mul_D_le p.L p.m
  have hS7 : p.S7 ≤ 9 ^ p.L := Nat.pow_le_pow_left (by norm_num) _
  have hsqrt : Nat.sqrt p.K ≤ p.K := Nat.sqrt_le_self _
  have hLo : p.Lo ≤ p.L := Nat.sub_le _ _
  have hentries : p.KK * p.N0 * p.D ≤ p.S7 :=
    le_trans (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hKK)) hKND
  unfold Sec2.sharedShapeP Sec2.bandArrayShape
  change _ ≤ 7 * (Sec2.retW p.L p.m + (p.N + 1) * (p.L + 1)
    + p.nB * (Sec2.retW p.L p.m + p.L * p.S7))
  generalize Sec2.retW p.L p.m = R at *
  generalize 4 ^ p.L = F at *
  generalize 9 ^ p.L = G at *
  generalize p.S7 = S7 at *
  generalize p.K = K at *
  generalize p.KK * p.N0 * p.D = E at *
  generalize p.KK = KK at *
  generalize p.D = D at *
  generalize p.nB = nB at *
  generalize p.Lo = Lo at *
  generalize p.N = N at *
  generalize p.L = L at *
  generalize p.m = m at *
  have hFQ : F ≤ (L + 1) * F := Nat.le_mul_of_pos_left _ (Nat.succ_pos L)
