/-! # Trace identities for the dimension-generic Einstein–Maxwell residual (ATLAS-VI-01)

Total dimension `n` (indices `Fin n`), at a point `x` where `g` is symmetric and `ginv` is a left
inverse of `g` (`notes/MATH_CONTRACT_D5.md` §A, pure algebra, no new definitions):

* `trace_emStressD`: `g^{ab} S_ab = (1 − n/4) F²`;
* `trace_einsteinMaxwellD`: `g^{ab} E_ab = (1 − n/2) R − (2 − n/2) F²`;
* `ricciScalar_of_einstein_zero`: `E = 0`, `n ≠ 2` ⇒ `R = ((n − 4)/(n − 2)) F²`;
* `ricciOf_of_einstein_zero`: `E = 0`, `n ≠ 2` ⇒ `R_ab = 2 F_ac g^{cd} F_bd − g_ab F²/(n − 2)`;
* certificate forms: `n = 4 ⇒ R = 0`, `n = 5 ⇒ R = F²/3`. -/

open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.EinsteinMaxwell.D

variable {n : ℕ} {g ginv : Metric n} {F : TwoForm n} {x : Pt n}

/-- `g^{ab} g_ab = n` for a symmetric `g` with left inverse `ginv`. -/
theorem trace_ginv_g (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hsym : ∀ a b, g a b x = g b a x) :
    ∑ a : Fin n, ∑ b : Fin n, ginv a b x * g a b x = n := by
  have h : ∀ a, ∑ b, ginv a b x * g b a x = 1 := fun a => by
    have := congrFun (congrFun hinv a) a
    simpa [metricMatrix, Matrix.mul_apply] using this
  calc ∑ a : Fin n, ∑ b : Fin n, ginv a b x * g a b x
      = ∑ a : Fin n, ∑ b : Fin n, ginv a b x * g b a x :=
        Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => by rw [hsym a b]
    _ = ∑ _a : Fin n, (1 : ℝ) := Finset.sum_congr rfl fun a _ => h a
    _ = n := by simp

/-- `g^{ab} F_ac g^{cd} F_bd = F_ab F^ab` (index bookkeeping only). -/
theorem trace_FgF (ginv : Metric n) (F : TwoForm n) (x : Pt n) :
    ∑ a : Fin n, ∑ b : Fin n, ginv a b x * (∑ c : Fin n, ∑ d : Fin n, F a c x * ginv c d x * F b d x) =
      fieldSq ginv F x := by
  simp only [fieldSq, raise2, Finset.mul_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  refine Finset.sum_comm.trans ?_
  exact Finset.sum_congr rfl fun q _ => Finset.sum_congr rfl fun r _ =>
    Finset.sum_congr rfl fun s _ => by ring

/-- `g^{ab} S_ab = (1 − n/4) F²`. -/
theorem trace_emStressD (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hsym : ∀ a b, g a b x = g b a x) :
    ∑ a : Fin n, ∑ b : Fin n, ginv a b x * emStressD g ginv F a b x =
      (1 - (n : ℝ) / 4) * fieldSq ginv F x := by
  have e : ∀ a b, ginv a b x * emStressD g ginv F a b x =
      ginv a b x * (∑ c : Fin n, ∑ d : Fin n, F a c x * ginv c d x * F b d x) -
        fieldSq ginv F x / 4 * (ginv a b x * g a b x) := fun a b => by
    simp only [emStressD]; ring
  simp only [e, Finset.sum_sub_distrib, ← Finset.mul_sum, trace_FgF, trace_ginv_g hinv hsym]
  ring

/-- `g^{ab} E_ab = (1 − n/2) R − (2 − n/2) F²`. -/
theorem trace_einsteinMaxwellD (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hsym : ∀ a b, g a b x = g b a x) :
    ∑ a : Fin n, ∑ b : Fin n, ginv a b x * einsteinMaxwellD g ginv F a b x =
      (1 - (n : ℝ) / 2) * ricciScalar g ginv x - (2 - (n : ℝ) / 2) * fieldSq ginv F x := by
  have e : ∀ a b, ginv a b x * einsteinMaxwellD g ginv F a b x =
      ginv a b x * ricciOf g ginv a b x - ricciScalar g ginv x / 2 * (ginv a b x * g a b x) -
        2 * (ginv a b x * emStressD g ginv F a b x) := fun a b => by
    simp only [einsteinMaxwellD]; ring
  simp only [e, Finset.sum_sub_distrib, ← Finset.mul_sum, trace_ginv_g hinv hsym,
    trace_emStressD hinv hsym]
  simp only [ricciScalar]
  ring

/-- `E = 0` and `n ≠ 2` ⇒ `R = ((n − 4)/(n − 2)) F²`. -/
theorem ricciScalar_of_einstein_zero (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hsym : ∀ a b, g a b x = g b a x) (hE : ∀ a b, einsteinMaxwellD g ginv F a b x = 0)
    (hn : (n : ℝ) ≠ 2) :
    ricciScalar g ginv x = ((n : ℝ) - 4) / ((n : ℝ) - 2) * fieldSq ginv F x := by
  have hz : ∑ a : Fin n, ∑ b : Fin n, ginv a b x * einsteinMaxwellD g ginv F a b x = 0 := by
    simp [hE]
  rw [trace_einsteinMaxwellD hinv hsym] at hz
  have hn2 : (n : ℝ) - 2 ≠ 0 := sub_ne_zero.mpr hn
  rw [div_mul_eq_mul_div, eq_div_iff hn2]
  linear_combination (-2) * hz

/-- `E = 0` and `n ≠ 2` ⇒ `R_ab = 2 F_ac g^{cd} F_bd − g_ab F²/(n − 2)`. -/
theorem ricciOf_of_einstein_zero (hinv : metricMatrix ginv x * metricMatrix g x = 1)
    (hsym : ∀ a b, g a b x = g b a x) (hE : ∀ a b, einsteinMaxwellD g ginv F a b x = 0)
    (hn : (n : ℝ) ≠ 2) (a b : Fin n) :
    ricciOf g ginv a b x = 2 * (∑ c : Fin n, ∑ d : Fin n, F a c x * ginv c d x * F b d x) -
      g a b x * fieldSq ginv F x / ((n : ℝ) - 2) := by
  have hR := ricciScalar_of_einstein_zero hinv hsym hE hn
  have hn2 : (n : ℝ) - 2 ≠ 0 := sub_ne_zero.mpr hn
  have h := hE a b
  simp only [einsteinMaxwellD, emStressD] at h
  rw [hR] at h
  linear_combination (norm := skip) h
  field_simp
  ring

end ExactVacuumAtlas.EinsteinMaxwell.D
end R05Seg0

