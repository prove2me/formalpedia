-- title:
--   Theorem 2.19 — the stochastic subgradient method converges to the unique minimizer with probability one
-- statement:
--   Let $f : E_n \to \mathbb{R}$ be convex with a unique minimum point $x^*$. Let $(\Omega, \mathcal F, P)$ be a probability space with a filtration $(\mathcal F_k)_{k\ge 0}$, and consider the stochastic subgradient method
--   $$
--   x_{k+1} = x_k - h_k(x_k)\, g_\omega(x_k), \qquad k = 0, 1, \dots,
--   $$
--   started at a deterministic $x_0$, where the stepsize rules $h_k : E_n \to \mathbb{R}$ are Borel measurable and the random direction $g_k = g_\omega(x_k)$ drawn at iteration $k$ is $\mathcal F_{k+1}$-measurable. Assume that for every $k$, $g_k$ and $\|g_k\|^2$ are integrable, the conditional expectation $E\{g_k \mid \mathcal F_k\}$ is almost surely a subgradient of $f$ at $x_k$, and that the following conditions hold:
--
--   1. almost surely, $\sum_{k=0}^\infty h_k(x_k) = +\infty$ and $h_k(x_k) > 0$ for all $k$;
--   2. almost surely, $\sum_{k=0}^\infty h_k^2(x_k) < \infty$;
--   3. $E\{\|g_k\|^2 \mid \mathcal F_k\} \le c$ almost surely, $k = 0, 1, \dots$
--
--   Then with probability one
--   $$
--   \lim_{k\to\infty} \|x_k - x^*\| = 0 .
--   $$
--
--   This is the basic convergence theorem for the stochastic subgradient method (Ermoliev–Shor), the prototype of almost-sure convergence results for stochastic approximation in nonsmooth convex programming.
--
--   **Formalization Note** The book assumes that the distribution of $g_\omega(x_k)$ is determined by $x_k$ and does not depend on the past, and remarks that this is not essential; the filtration model used here contains that case (take $\mathcal F_k$ generated by the first $k$ random draws). Condition (iii) is printed as the unconditional bound $E\{\|g_\omega(x_k)\|^2\} \le c$; the proof uses the conditional bound in (2.42), which is what the book's standing assumption ("the characteristics of $g_\omega(x_k)$ are fully determined by $x_k$", with a bound for every point) gives, and that conditional form is assumed here. Since $h_k(x_k)$ is random, conditions (i)–(ii) are required almost surely.
-- source:
--   Shor, Minimization Methods for Non-Differentiable Functions, Springer 1985, pp. 45–46, stochastic subgradient method and Theorem 2.19

import Mathlib
import Definitions.Def_ShorNonsmooth_Stochastic_StochasticSubgradientMethod
open MeasureTheory Filter Topology

namespace ShorNonsmooth.Stochastic

/-- Shor (1985), p. 46, **Theorem 2.19**. Let `f` be convex on `E_n` with the unique minimum
point `xstar`, and let `x_k = stochIter h G x₀ k` be the stochastic subgradient method
`x_{k+1} = x_k - h_k(x_k) g_ω(x_k)` on a probability space `(Ω, μ)` with filtration `ℱ`
(`ℱ k` = the information available when `x_k` is computed). Assume the random vector
`G k = g_ω(x_k)` is `ℱ (k+1)`-measurable, integrable with integrable squared norm, that its
conditional expectation given `ℱ k` is a.s. a subgradient of `f` at `x_k`, and that
`E{‖g_ω(x_k)‖² | ℱ k} ≤ c` a.s. (the book's (iii), pinned to the per-point conditional form
used in (2.42)). If a.s. `h_k(x_k) > 0` for all `k`, `Σ h_k(x_k) = +∞` and
`Σ h_k(x_k)² < ∞` (conditions (i), (ii)), then `‖x_k - xstar‖ → 0` with probability one. -/
theorem stochastic_subgradient_converges_ae {n : ℕ} {Ω : Type*} {m0 : MeasurableSpace Ω}
    (μ : Measure Ω) [IsProbabilityMeasure μ] (ℱ : Filtration ℕ m0)
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ConvexOn ℝ Set.univ f)
    (xstar : EuclideanSpace ℝ (Fin n)) (hmin : xstar ∈ ShorNonsmooth.SubgradMethod.MinSet f)
    (huniq : ∀ y ∈ ShorNonsmooth.SubgradMethod.MinSet f, y = xstar)
    (h : ℕ → EuclideanSpace ℝ (Fin n) → ℝ) (hh_meas : ∀ k, Measurable (h k))
    (G : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (x₀ : EuclideanSpace ℝ (Fin n)) (c : ℝ)
    (hG_meas : ∀ k, StronglyMeasurable[ℱ (k + 1)] (G k))
    (hG_int : ∀ k, Integrable (G k) μ)
    (hG_sq_int : ∀ k, Integrable (fun ω => ‖G k ω‖ ^ 2) μ)
    (hG_mean : ∀ k, ∀ᵐ ω ∂μ, ShorNonsmooth.AlmostDiff.IsSubgradient f (stochIter h G x₀ k ω) ((μ[G k | ℱ k]) ω))
    (hG_sq : ∀ k, ∀ᵐ ω ∂μ, (μ[fun ω' => ‖G k ω'‖ ^ 2 | ℱ k]) ω ≤ c)
    (hh_pos : ∀ᵐ ω ∂μ, ∀ k, 0 < h k (stochIter h G x₀ k ω))
    (hh_div : ∀ᵐ ω ∂μ,
      Tendsto (fun N => ∑ k ∈ Finset.range N, h k (stochIter h G x₀ k ω)) atTop atTop)
    (hh_sq : ∀ᵐ ω ∂μ, Summable (fun k => h k (stochIter h G x₀ k ω) ^ 2)) :
    ∀ᵐ ω ∂μ, Tendsto (fun k => ‖stochIter h G x₀ k ω - xstar‖) atTop (𝓝 0) := by sorry

end ShorNonsmooth.Stochastic
