    simp only [ht2, ht1, IState.upd_G, run_push_G, run_pop_G]
    simp (config := {decide := true}) [tG 45 (by decide), NLogN.pSt]
  have c1 := pushCost_le_lin (.reg 3) t X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, IState.top_eq t3]; exact qk)
  have c2 := pushCost_le_lin (.reg 3) t2 X (by simp [Ex.Lin])
    (by simp only [Ex.Bnd, IState.top_eq v3]; exact qk)
  have c5 := asgCost_le_lin 45 (.add (.reg 45) (.lit (d + 1))) ((pop 3).run ((push 41 (.reg 3)).run t2))
    X (by simp [Ex.Lin])
    (by
      simp only [Ex.Bnd, Ex.eval, IState.top_eq v45]
      refine ⟨q4, by exact_mod_cast hXd, by exact_mod_cast q5⟩)
    (by rw [IState.top_eq v45]; exact q4)
  have c1' : (push 40 (.reg 3)).cost t ≤ (1 + 1) * 2000 * (X + 2) := c1
  have c2' : (push 41 (.reg 3)).cost t2 ≤ (1 + 1) * 2000 * (X + 2) := c2
  have c5' : (asg 45 (.add (.reg 45) (.lit (d + 1)))).cost ((pop 3).run ((push 41 (.reg 3)).run t2))
      ≤ (3 + 1) * 2000 * (X + 2) := c5
  have hsl : (Ex.lit (S := HS) (d : ℤ)).size = 1 := rfl
  rw [hsl, hlen] at cm
  simp only [pBody, cost_seq, cost_pop]
  rw [← ht1, hm.2, IState.top_eq v3']
  nlinarith

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
theorem solution (d n : ℕ) (Kl : List ℕ) (D : List (List ℤ)) (Rest RK : List NLogN.Item)
    (s : NLogN.IState NLogN.HS) (hKl : Kl.length = n) (hK : ∀ k ∈ Kl, k < n) (hD : D.length = n)
    (hDw : ∀ r ∈ D, r.length = d)
    (L1 : List NLogN.Item) (h0 : s.G 0 = NLogN.ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h3 : s.G 3 = NLogN.natInts Kl ++ RK) (X : ℕ)
    (hDB : ∀ r ∈ D, NLogN.Bnd X r) (hX2 : NLogN.zsz ((n * (d + 1) : ℕ) : ℤ) ≤ X)
    (hXd : NLogN.zsz ((d + 1 : ℕ) : ℤ) ≤ X) :
    (NLogN.pAttachP d).cost s ≤ 100000 * (n + 1) * (d + 1) * (X + 2) := by
  have H := NLogN.p_states d n Kl D Rest RK s hKl hD hDw L1 h1
  have g1 : (NLogN.pSt s Kl D Rest RK d 0).G 1 = .int n :: L1 := by
    rw [NLogN.pSt_G_other s Kl D Rest RK d 0 1 (by decide) (by decide) (by decide) (by decide)
      (by decide), h1]
  have e1 : (NLogN.Ex.reg (S := NLogN.HS) 1).eval (NLogN.pSt s Kl D Rest RK d 0) = n := by
    simp [NLogN.Ex.eval, NLogN.IState.top_eq g1]
  have hz : (NLogN.RS.push 45 (.lit 0)).run s = NLogN.pSt s Kl D Rest RK d 0 := by
    apply NLogN.IState.ext' _ (by simp [NLogN.pSt]) (by simp [NLogN.pSt])
    intro x
    simp only [NLogN.pSt, NLogN.IState.upd_G, NLogN.RS.run_push_G, NLogN.Ex.eval]
    by_cases x0 : x = 0
    · subst x0; simp (config := {decide := true}) [h0]
    by_cases x3 : x = 3
    · subst x3; simp (config := {decide := true}) [h3]
    by_cases x40 : x = 40
    · subst x40; simp (config := {decide := true}) [NLogN.pflat]
    by_cases x41 : x = 41
    · subst x41; simp (config := {decide := true}) [NLogN.natInts]
    split_ifs <;> simp_all
  have hloop : (NLogN.pLoop d).run (NLogN.pSt s Kl D Rest RK d 0) = NLogN.pSt s Kl D Rest RK d n := by
    rw [NLogN.pLoop, H.run, e1, Int.toNat_natCast]
  have hn : n ≤ n * (d + 1) := Nat.le_mul_of_pos_right _ (by omega)
  have qn : NLogN.zsz (n : ℤ) ≤ X := NLogN.zsz_le_of_nat_le hn hX2
  have cl := H.cost_le_lin X ((14000 * d + 21000) * (X + 2)) (by simp [NLogN.Ex.Lin])
    (by simp only [NLogN.Ex.Bnd]; rw [← NLogN.Ex.eval, e1]; exact qn) (by
      intro p hp
      rw [e1, Int.toNat_natCast] at hp ⊢
      exact NLogN.p_cost d n Kl D Rest RK s hKl hK hD hDw _ _ p hp X hDB hX2 hXd)
  rw [e1, Int.toNat_natCast] at cl
  have cl' : (NLogN.pLoop d).cost (NLogN.pSt s Kl D Rest RK d 0) ≤ (1 + 1) * 2000 * (X + 2) +
      n * ((14000 * d + 21000) * (X + 2) + 8000 * (X + 2) + 30) + 32 := cl
  set t := NLogN.pSt s Kl D Rest RK d n with ht
  have hpl := NLogN.pflat_length d Kl D hDw n (by omega)
  have t40 : t.G 40 = NLogN.ints (NLogN.pflat Kl D n).reverse ++ s.G 40 := by simp [ht, NLogN.pSt, NLogN.ints_reverse]
  have t45 : t.G 45 = .int (((NLogN.pflat Kl D n).reverse.length : ℕ) : ℤ) :: s.G 45 := by
    simp [ht, NLogN.pSt, hpl]
  have hpB : NLogN.Bnd X (NLogN.pflat Kl D n).reverse := by
    intro x hx
    simp only [List.mem_reverse, NLogN.pflat, List.mem_flatten, List.mem_map, List.mem_range] at hx
    obtain ⟨r, ⟨p, hp, rfl⟩, hx⟩ := hx
    simp only [NLogN.pRec, List.mem_cons] at hx
    rcases hx with rfl | hx
    · rw [List.getD_eq_getElem _ _ (by omega)]
      exact NLogN.zsz_le_of_nat_le (le_trans (hK _ (List.getElem_mem _)).le hn) hX2
    · rw [List.getD_eq_getElem _ _ (by omega : p < D.length)] at hx
      exact hDB _ (List.getElem_mem _) x hx
  have m1 := NLogN.mvK_spec (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 45) (NLogN.RS.clean_of_lt (by decide)) t _ (s.G 40) t40
    (NLogN.IState.isInt_of t45) (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t45])
  have c1 := NLogN.mvK_cost (X := 40) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (.reg 45)
    t _ (s.G 40) t40 (by simp [NLogN.Ex.eval, NLogN.IState.top_eq t45]) X hpB trivial
    (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t45, List.length_reverse, hpl]; exact hX2)
  set t2 := (t.upd 40 (s.G 40)).upd 0 ((NLogN.ints (NLogN.pflat Kl D n).reverse).reverse ++ t.G 0) with ht2
  have u41 : t2.G 41 = NLogN.ints (List.map (Nat.cast : ℕ → ℤ) Kl).reverse ++ s.G 41 := by
    simp only [ht2, NLogN.IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt, ← hKl, NLogN.natInts, NLogN.ints_reverse]
  have u1 : t2.G 1 = .int n :: L1 := by
    simp only [ht2, NLogN.IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt_G_other s Kl D Rest RK d n 1 (by decide)
      (by decide) (by decide) (by decide) (by decide), h1]
  have hkB : NLogN.Bnd X (List.map (Nat.cast : ℕ → ℤ) Kl).reverse := by
    intro x hx
    simp only [List.mem_reverse, List.mem_map] at hx
    obtain ⟨k, hk, rfl⟩ := hx
    exact NLogN.zsz_le_of_nat_le (le_trans (hK k hk).le hn) hX2
  have m2 := NLogN.mvK_spec (X := 41) (Y := 3) (C := 51) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide) (.reg 1) (NLogN.RS.clean_of_lt (by decide)) t2 _ (s.G 41) u41
    (NLogN.IState.isInt_of u1) (by simp [NLogN.Ex.eval, NLogN.IState.top_eq u1, hKl])
  have c2 := NLogN.mvK_cost (X := 41) (Y := 3) (C := 51) (by decide) (by decide) (by decide) (.reg 1)
    t2 _ (s.G 41) u41 (by simp [NLogN.Ex.eval, NLogN.IState.top_eq u1, hKl]) X hkB trivial
    (by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq u1]; exact qn)
  set t3 := (t2.upd 41 (s.G 41)).upd 3 ((NLogN.ints (List.map (Nat.cast : ℕ → ℤ) Kl).reverse).reverse ++
    t2.G 3) with ht3
  have u45 : t3.G 45 = .int ((n * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [ht3, ht2, NLogN.IState.upd_G]
    simp (config := {decide := true}) [ht, NLogN.pSt]
  have hs1 : (NLogN.Ex.reg (S := NLogN.HS) 45).size = 1 := rfl
  have hs2 : (NLogN.Ex.reg (S := NLogN.HS) 1).size = 1 := rfl
  rw [hs1, List.length_reverse, hpl] at c1
  rw [hs2, List.length_reverse, List.length_map, hKl] at c2
  simp only [NLogN.pAttachP, NLogN.cost_seq, NLogN.cost_push_lit0, NLogN.cost_pop]
  rw [hz, hloop, m1.2, m2.2, NLogN.IState.top_eq u45]
  have b1 : n * ((14000 * d + 21000) * (X + 2) + 8000 * (X + 2) + 30) ≤
      29030 * (n * ((d + 1) * (X + 2))) := by
    have : (14000 * d + 21000) * (X + 2) + 8000 * (X + 2) + 30 ≤ 29030 * ((d + 1) * (X + 2)) := by
      nlinarith
    calc _ ≤ n * (29030 * ((d + 1) * (X + 2))) := Nat.mul_le_mul_left _ this
      _ = _ := by ring
  have b2 : n * (d + 1) * (14000 * (X + 2)) = 14000 * (n * ((d + 1) * (X + 2))) := by ring
  have b3 : n * (14000 * (X + 2)) ≤ 14000 * (n * ((d + 1) * (X + 2))) := by
    have : X + 2 ≤ (d + 1) * (X + 2) := Nat.le_mul_of_pos_left _ (by omega)
    have := Nat.mul_le_mul_left n this; nlinarith
  have hA : X + 2 ≤ (d + 1) * (X + 2) := Nat.le_mul_of_pos_left _ (by omega)
  have e : 100000 * (n + 1) * (d + 1) * (X + 2) =
      100000 * (n * ((d + 1) * (X + 2))) + 100000 * ((d + 1) * (X + 2)) := by ring
  have qz : NLogN.zsz ((n * (d + 1) : ℕ) : ℤ) ≤ X := hX2
  rw [e]
  linarith
end
