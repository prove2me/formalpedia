private theorem divisorCount_cell {n : ℕ} (q : ℚ) (off : ℤ) (a b : ℕ) (ha : a < n) (hb : b < n)
    (v : Fin (n + 1)) :
    (divisorCount off fun ij : Fin n × Fin n ↦
