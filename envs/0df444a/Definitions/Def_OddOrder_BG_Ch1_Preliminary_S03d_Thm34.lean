    have hFixAinv : IsAInvariant φ Fix := by
      rw [OddOrder.Isaacs.Ch03.isAInvariant_iff_smul_mem]
      intro s g hg r
      rw [(hmemFix _).mp hg s]; exact (hmemFix _).mp hg r
    have hK'ne : commutator ↥K ≠ ⊤ :=
      (commutator_lt_self_of_isNilpotent_ambient (E := (⊤ : Subgroup ↥K)) (F := ⊤)
