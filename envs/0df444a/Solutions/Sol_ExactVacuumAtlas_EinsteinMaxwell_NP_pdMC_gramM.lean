-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}
theorem solution (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (μ : Fin n) :
    pdMC μ (gramM g E) x = (omegaC g gi E Θ μ x)ᵀ * gramM g E x + gramM g E x * omegaC g gi E Θ μ x := by
  have hU := hF.isOpen
  have hT := hF.smoothOnC_frMat
  have hg : SmoothOnC (cmat g) U := SmoothOnC.map_ofReal hF.metric.smoothOn
  have hcm : pdMC μ (cmat g) x = (GamC g gi μ x)ᵀ * cmat g x + cmat g x * GamC g gi μ x := by
    have e : cmat g = fun z => (metricMatrix g z).map (fun t : ℝ => (t : ℂ)) := rfl
    rw [e, pdMC_map_ofReal, pdM_metricMatrix hF.metric hx, map_ofReal_compat]
    rfl
  unfold gramM
  rw [pdMC_mul hU hx μ (hT.transpose'.mul hg) hT, pdMC_mul hU hx μ hT.transpose' hg, pdMC_transpose, hcm,
    pdMC_frMat hF hx μ]
  simp only [Matrix.transpose_sub, Matrix.transpose_mul]
  noncomm_ring
