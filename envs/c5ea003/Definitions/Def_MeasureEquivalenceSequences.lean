-- title:
--   Sequence relations, measure equivalence, and Borel reductions
-- statement:
--   Let $X=\mathbb R^{\mathbb N}$ and $C=\{0,1\}^{\mathbb N}$ carry their product Borel structures. For a real exponent $p$, define $x\,E_p\,y$ by summability of $|x_n-y_n|^p$, and define $x\,E_{c_0}\,y$ by $x_n-y_n\to0$. For probability measures $\mu,\nu$ on $C$, write $\mu\equiv_m\nu$ when $\mu\ll\nu$ and $\nu\ll\mu$. For a relation $E$ on $X$, define
--
--   $$E\le_B\equiv_m\quad\Longleftrightarrow\quad \exists f:X\to\mathcal P(C)\text{ Borel measurable},\ \forall x,y\in X,\ E(x,y)\Longleftrightarrow f(x)\equiv_m f(y).$$
--
--   The probability space uses the sigma-algebra generated by evaluations on Borel sets. The exponent restriction $p\ge1$ is imposed by the target theorems. These definitions fix the common interface of the two main results.
-- source:
--   Sequence-space equivalence relations and mutual absolute continuity, owner-supplied research manuscript, 24 October 2026; Introduction and Preliminaries; Classification.lean definitions LpDifference, NullDifference, MeasureEquivalent, BorelReduces.

import Mathlib.MeasureTheory.Measure.ProbabilityMeasure
import Mathlib.Analysis.SpecialFunctions.Pow.Real

/-! Source relations and actual mutual absolute continuity, using the canonical
product Borel structures and the evaluation sigma-algebra on probabilities. -/

open MeasureTheory Filter
open scoped Topology

namespace MeasureEquivalenceMission

abbrev RealSequences := ℕ → ℝ
abbrev CantorSpace := ℕ → Bool

def LpDifference (p : ℝ) (x y : RealSequences) : Prop :=
  Summable (fun n => |x n - y n| ^ p)

def NullDifference (x y : RealSequences) : Prop :=
  Tendsto (fun n => x n - y n) atTop (𝓝 0)

def MeasureEquivalent (μ ν : ProbabilityMeasure CantorSpace) : Prop :=
  (μ : Measure CantorSpace) ≪ ν ∧ (ν : Measure CantorSpace) ≪ μ

def BorelReducesToMeasureEquivalence (E : RealSequences → RealSequences → Prop) : Prop :=
  ∃ f : RealSequences → ProbabilityMeasure CantorSpace,
    Measurable f ∧ ∀ x y, E x y ↔ MeasureEquivalent (f x) (f y)

end MeasureEquivalenceMission


