open WeierstrassCurve FreyPackage CuspForm

theorem solution (P : FreyPackage) :
    ∀ M q : ℕ, P.ModularRepOfLevelNewAt M q → P.ModularRepOfLevelNewAtPinned M q := by
  rintro M q ⟨g, W, 𝔪, ⟨heig, hWmodel, hmax, hp, hcong⟩, hnew⟩
  refine ⟨g, 𝔪, heig, hmax, hp, ?_, hnew⟩
  intro ℓ hℓ hfcgood hℓM hℓp
  by_cases hWgood : W.IsGoodPrimeFor ℓ
  ·
    obtain ⟨a, ha_eq, ha_cong⟩ := hcong ℓ hℓ hWgood hℓM hℓp
    refine ⟨a, ha_eq, ?_⟩
    suffices heq : W.apOfModel ℓ = (freyCurveInt P).apOfModel ℓ by
      rw [← heq]; exact ha_cong

    have hfcmodel : (freyCurveInt P).IsIntegralModelOf P.freyCurve :=
      ⟨1, by rw [one_smul, FreyPackage.freyCurveInt_map]⟩
    rcases eq_or_ne ℓ 2 with h2 | h2
    ·
      subst h2
      exact absurd (by exact_mod_cast FreyPackage.two_dvd_freyCurveInt_delta P) hfcgood
    rcases eq_or_ne ℓ 3 with h3eq | h3ne
    ·
      subst h3eq
      rw [FreyPackage.freyCurveApOfModelThreeAgreement P W hWmodel hWgood,
          FreyCurve.freyCurveInt_apOfModel_three P hfcgood]
    ·
      exact FLT.ModelTransfer.apOfModel_eq_of_isIntegralModelOf
        hfcmodel hWmodel hℓ h2 h3ne hfcgood hWgood
  ·
    have hcw : P.IsCongruentWitness M g W 𝔪 := ⟨heig, hWmodel, hmax, hp, hcong⟩
    exact FreyPackage.routeAReversePinBadOnlySeam P M g W 𝔪 hcw ℓ hℓ hfcgood hℓM hℓp hWgood

end S_FreyPackage_modularRepOfLevelNewAtPinned_of_newAt
end P2MW
export P2MW.S_FreyPackage_modularRepOfLevelNewAtPinned_of_newAt (solution)
