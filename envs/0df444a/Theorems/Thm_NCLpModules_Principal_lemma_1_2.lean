-- title:
--   Lemma 1.2, p. 3 — closure(Mφ^{1/p}) = L^p s(φ) and closure(φ^{1/p}M) = s(φ)L^p, for finite-dimensional M
-- statement:
--   Let $\mathcal M\subseteq M_n(\mathbb C)$ be a unital $*$-subalgebra and $0<p<\infty$. A positive normal functional $\varphi$ on $\mathcal M$ has the form $\varphi(x)=\mathrm{Tr}(Dx)$ for a positive semidefinite density $D\in\mathcal M$; then $\varphi^{1/p}$ is the matrix $D^{1/p}$ and $s(\varphi)$ is the support projection $s(D)$ of $D$ (the projection onto its range). Then
--   $$\mathcal M\,D^{1/p}=L^p\,s(D),\qquad D^{1/p}\mathcal M=s(D)\,L^p,$$
--   that is, $\{xD^{1/p}:x\in\mathcal M\}=\{y\,s(D):y\in\mathcal M\}$ and $\{D^{1/p}x:x\in\mathcal M\}=\{s(D)\,y:y\in\mathcal M\}$.
--
--   The lemma identifies the cyclic submodules generated by a density with the corners of $L^p$ cut by its support; it is what makes the cyclic case of Theorem 2.5 land in $s(\langle\xi,\xi\rangle^{1/2})L^p$.
--
--   **Formalization Note** Finite-dimensional scope: $L^p(\mathcal M)=\mathcal M$ as a set, and the norm closures on the page are dropped because both sides are finite-dimensional subspaces, hence closed. The functional $\varphi$ is represented by its density $D$ ($D\in\mathcal M$, $D\succeq0$). $D^{1/p}$ is `cfc (fun t => t ^ (1/p)) D`; since $1/p\neq0$, zero eigenvalues are sent to $0$. The page states no range for $p$; its proof covers every $p>0$, so $0<p$ is assumed.
-- source:
--   Junge & Sherman, Noncommutative Lp modules, arXiv:math/0301044v2, p. 3, Lemma 1.2 (proof pp. 3–4)

import Mathlib
import Definitions.Def_NCLpModules_Principal_Model

namespace NCLpModules.Principal

open scoped Matrix ComplexOrder

theorem lemma_1_2 {n : ℕ} (M : StarSubalgebra ℂ (Matrix (Fin n) (Fin n) ℂ))
    {p : ℝ} (hp : 0 < p)
    (D : Matrix (Fin n) (Fin n) ℂ) (hDM : D ∈ M) (hD : D.PosSemidef) :
    {z | ∃ x ∈ M, z = x * cfc (fun t : ℝ => t ^ (1 / p)) D} =
        {z | ∃ y ∈ M, z = y * supportProj D} ∧
      {z | ∃ x ∈ M, z = cfc (fun t : ℝ => t ^ (1 / p)) D * x} =
        {z | ∃ y ∈ M, z = supportProj D * y} := by sorry

end NCLpModules.Principal
