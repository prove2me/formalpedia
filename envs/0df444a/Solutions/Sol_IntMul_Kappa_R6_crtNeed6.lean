theorem tF6_eq (P : Prm) (n : ℕ) (hl : 1 ≤ ℓP6 P n) (j : ℕ) (hj : j < dP6 P n) :
    tF6 P n j = 2 ^ OpenAI.RP.axExp (LP6 P n) (dP6 P n) ⟨j, hj⟩ := by
