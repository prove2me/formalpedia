/-- **B1: `SlabNeed6 P` for every `P.Ok`.** -/
theorem slabNeed6_sol_aux (P : Prm) (hP : P.Ok) : SlabNeed6 P := by
  intro dA hf h8 h56
  obtain ⟨n₁, hAx⟩ := axNum_ev P hP
  obtain ⟨n₂, hRg⟩ := axReg_of P hP
  obtain ⟨n₃, hNt⟩ := r6_axis_nat P hP
  obtain ⟨n₄, hBu⟩ := slabCost6_all P hP (Kb + 10000)
  obtain ⟨pk, zk, ck⟩ := park_ok hf h56
  refine ⟨8, USf dA, 0, 1, 2, 3, 4, 5, 6, 7, 1, 0, max (max n₁ n₂) (max n₃ n₄), by norm_num, ?_⟩
  intro n hn src hsrc D hD k hk tab E ext idx hidx Isym C
  have an := hAx n (by omega) src hsrc D hD k hk
  have ar : AxReg P n src D k := hRg n (by omega) src hsrc D hD k hk
  have hN := hNt n (by omega) src hsrc k (by omega)
  have hB := hBu n (by omega) src hsrc D hD k hk
  have R := reg_of hD hk an hN
  -- the budget
  have hC : ((B0 (pP6 P n) (dP6 P n) (src k) (tF6 P n k) (αN6 P n) : ℕ) : ℝ) + 2 ≤ C := by
    have e : C = 1 * cU6 P n 0 / (D + 1) := rfl
    rw [e, one_mul]
    exact hB
  have eD : descAx6 P n src D k = dsc k (preT P n D k) (postT P n D k) (src k) (tF6 P n k)
      (pP6 P n) (αN6 P n) (dP6 P n) := rfl
  have hN' : axnc6 P n k * axl6 P n = tF6 P n k := ar.hN
  have hG : 2 ^ Nat.clog 2 (Jlist (mkBlocks (src k) (tF6 P n k) (lamP (dP6 P n))
      (wF (dP6 P n)))).length ≤ 3 * tF6 P n k := an.Gt
  refine ⟨?_, ?_, ?_, ?_⟩
  · have e1 : slabV1 P n src D k = slabV (ctlOf (tF6 P n k) (tF6 P n k)
        (selSrc (src k) (tF6 P n k))
        (fun _ => ((2 ^ (segPF (pP6 P n) (dP6 P n) (src k) - pP6 P n - 1) : ℕ) : ℤ)))
        (preT P n D k) (postT P n D k) (tF6 P n k) [] [] := by
      rw [slabV1, ctl1, hN']; push_cast; rfl
    rw [eD, e1]
    exact setup_call (hidx 0) (hidx 1) (pass1 pk zk ck R) hC
  · have e3 : slabV3 P n src D k = slabV (ctlOf (tF6 P n k)
        (2 ^ Nat.clog 2 (Jlist (mkBlocks (src k) (tF6 P n k) (lamP (dP6 P n))
          (wF (dP6 P n)))).length)
        (jSrc (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))) (fun _ => 0))
        (preT P n D k) (postT P n D k)
        (2 ^ Nat.clog 2 (Jlist (mkBlocks (src k) (tF6 P n k) (lamP (dP6 P n))
          (wF (dP6 P n)))).length) [] [] := by
      rw [slabV3, ctl3, hN']; rfl
    rw [eD, e3]
    exact setup_call (hidx 2) (hidx 3) (pass3 pk zk ck R hG) hC
  · have e5 : slabV5 P n src D k = slabV (ctlOf
        (2 ^ Nat.clog 2 (Jlist (mkBlocks (src k) (tF6 P n k) (lamP (dP6 P n))
          (wF (dP6 P n)))).length) (tF6 P n k)
        (scSrc (src k) (tF6 P n k) (lamP (dP6 P n)) (wF (dP6 P n))) (fun _ => 0))
        (preT P n D k) (postT P n D k) (tF6 P n k) [] [] := by
      rw [slabV5, ctl5, hN']; rfl
    rw [eD, e5]
    exact setup_call (hidx 4) (hidx 5) (pass5 pk zk ck R hG) hC
  · have e7 : slabV7 P n src D k = slabV (ctlOf (tF6 P n k) (tF6 P n k) (fun l => some l)
        (argO (pP6 P n) (src k) (tF6 P n k) (αN6 P n))) (preT P n D k) (postT P n D k) (tF6 P n k)
        [((2 ^ (segPF (pP6 P n) (dP6 P n) (src k) - pP6 P n) : ℕ) : ℤ)]
        [((2 ^ pP6 P n : ℕ) : ℤ)] := by
