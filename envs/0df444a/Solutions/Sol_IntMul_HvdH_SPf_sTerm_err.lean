          mul_le_mul (div_le_div_of_nonneg_right hw hp2.le) (hU _) (norm_nonneg _) (by positivity)
      _ = 5 / 4 := by rw [this]; field_simp
  calc _ ≤ ‖toC (sTerm p s t α k U j) - (w : ℂ) * toC V / 2 ^ (2 * p)‖
        + ‖(w : ℂ) * toC V / 2 ^ (2 * p) -
