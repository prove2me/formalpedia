theorem GlobalTheory.InvDerMap.map_Dof_iterate {d : ℕ} (F : Fin d → PS R 2 d) (u : Fin d → R) (n : ℕ) (f : PS R 1 d) :
    MvPowerSeries.map φ ((Dof F u)^[n] f) =
      (Dof (fun i => MvPowerSeries.map φ (F i)) (fun i => φ (u i)))^[n] (MvPowerSeries.map φ f) := by sorry
