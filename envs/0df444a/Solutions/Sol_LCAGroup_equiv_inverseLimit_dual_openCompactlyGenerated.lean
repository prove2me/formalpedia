import Mathlib
import Theorems.Thm_LCAGroup_pontryagin_duality

open Topology

set_option autoImplicit false

namespace Sol_LCAGroup_equiv_inverseLimit_dual_openCompactlyGenerated

/-- Every compact subset of a locally compact topological group lies in an open subgroup
generated by a compact neighbourhood of the identity. -/
theorem exists_openCG_superset {A : Type*} [Group A] [TopologicalSpace A]
    [IsTopologicalGroup A] [LocallyCompactSpace A] {K : Set A} (hK : IsCompact K) :
    ∃ H : Subgroup A, (IsOpen (H : Set A) ∧
      ∃ U ∈ 𝓝 (1 : A), IsCompact U ∧ Subgroup.closure U = H) ∧ K ⊆ (H : Set A) := by
  obtain ⟨U, hU, hU₁⟩ := exists_compact_mem_nhds (1 : A)
  have hSub : U ∪ K ⊆ (Subgroup.closure (U ∪ K) : Set A) := Subgroup.subset_closure
  refine ⟨Subgroup.closure (U ∪ K), ⟨?_, U ∪ K, ?_, hU.union hK, rfl⟩,
    Set.subset_union_right.trans hSub⟩
  · exact (Subgroup.closure (U ∪ K)).isOpen_of_mem_nhds
      (Filter.mem_of_superset hU₁ (Set.subset_union_left.trans hSub))
  · exact Filter.mem_of_superset hU₁ Set.subset_union_left

end Sol_LCAGroup_equiv_inverseLimit_dual_openCompactlyGenerated

open Sol_LCAGroup_equiv_inverseLimit_dual_openCompactlyGenerated in
theorem solution
    (G : Type*) [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [T2Space G] [LocallyCompactSpace G] :
    ∃ γ : G →ₜ* ((H : {H : Subgroup (PontryaginDual G) //
          IsOpen (H : Set (PontryaginDual G)) ∧
            ∃ U ∈ 𝓝 (1 : PontryaginDual G), IsCompact U ∧ Subgroup.closure U = H}) →
        PontryaginDual H.1),
      (∀ (x : G) H (χ : H.1), γ x H χ = (χ : PontryaginDual G) x) ∧
      IsEmbedding γ ∧
      Set.range γ = {a | ∀ H J (h : H.1 ≤ J.1) (χ : H.1),
        a H χ = a J (Subgroup.inclusion h χ)} := by
  classical
  let I := {H : Subgroup (PontryaginDual G) //
          IsOpen (H : Set (PontryaginDual G)) ∧
            ∃ U ∈ 𝓝 (1 : PontryaginDual G), IsCompact U ∧ Subgroup.closure U = H}
  change ∃ γ : G →ₜ* ((H : I) → PontryaginDual H.1), _
  -- every compact set of characters lies in one of the subgroups
  have hCpt {K : Set (PontryaginDual G)} (hK : IsCompact K) : ∃ H : I, K ⊆ (H.1 : Set _) := by
    obtain ⟨H, hH, hKH⟩ := exists_openCG_superset hK
    exact ⟨⟨H, hH⟩, hKH⟩
  have hCover (χ : PontryaginDual G) : ∃ H : I, χ ∈ H.1 := by
    obtain ⟨H, hH⟩ := hCpt (isCompact_singleton (x := χ))
    exact ⟨H, hH (Set.mem_singleton χ)⟩
  -- the index set is directed
  have hDirected (H J : I) : ∃ L : I, H.1 ≤ L.1 ∧ J.1 ≤ L.1 := by
    obtain ⟨U, hU₁, hU, hUgen⟩ := H.2.2
    obtain ⟨V, hV₁, hV, hVgen⟩ := J.2.2
    have hSub : U ∪ V ⊆ (Subgroup.closure (U ∪ V) : Set (PontryaginDual G)) :=
      Subgroup.subset_closure
    refine ⟨⟨Subgroup.closure (U ∪ V),
      (Subgroup.closure (U ∪ V)).isOpen_of_mem_nhds
        (Filter.mem_of_superset hU₁ (Set.subset_union_left.trans hSub)),
      U ∪ V, Filter.mem_of_superset hU₁ Set.subset_union_left, hU.union hV, rfl⟩, ?_, ?_⟩
    · change H.1 ≤ Subgroup.closure (U ∪ V)
      rw [← hUgen]
      exact Subgroup.closure_mono Set.subset_union_left
    · change J.1 ≤ Subgroup.closure (U ∪ V)
      rw [← hVgen]
      exact Subgroup.closure_mono Set.subset_union_right
  -- restriction of characters of the dual to the subgroups
  let restrict (H : I) : PontryaginDual (PontryaginDual G) →ₜ* PontryaginDual H.1 :=
    PontryaginDual.map ⟨H.1.subtype, continuous_subtype_val⟩
  let R : PontryaginDual (PontryaginDual G) → ((H : I) → PontryaginDual H.1) :=
    fun ψ H ↦ restrict H ψ
  have hRapply (ψ : PontryaginDual (PontryaginDual G)) (H : I) (χ : H.1) :
      R ψ H χ = ψ χ.1 := rfl
  have hRcont : Continuous R := continuous_pi fun H ↦ (restrict H).continuous
  have hRinj : Function.Injective R := by
    intro ψ ψ' h
    refine PontryaginDual.ext fun χ ↦ ?_
    obtain ⟨H, hH⟩ := hCover χ
    have := congrArg (fun a ↦ a H ⟨χ, hH⟩) h
    simpa only [hRapply] using this
  have hRind : IsInducing R := by
    constructor
    refine le_antisymm (continuous_iff_le_induced.mp hRcont) ?_
    -- the topology of the bidual is induced from the compact-open topology
    change TopologicalSpace.induced R _ ≤
      TopologicalSpace.induced ContinuousMonoidHom.toContinuousMap ContinuousMap.compactOpen
    rw [ContinuousMap.compactOpen_eq, induced_generateFrom_eq]
    refine le_generateFrom fun s hs ↦ ?_
    obtain ⟨t, ⟨K, hK, U, hU, rfl⟩, rfl⟩ := hs
    obtain ⟨H, hKH⟩ := hCpt hK
    have hKH' : IsCompact (Subtype.val ⁻¹' K : Set H.1) :=
      IsEmbedding.subtypeVal.isInducing.isCompact_preimage' hK
        (by rw [Subtype.range_coe]; exact hKH)
    let V : Set (PontryaginDual H.1) := {φ | Set.MapsTo φ (Subtype.val ⁻¹' K) U}
    have hV : IsOpen V :=
      (ContinuousMap.isOpen_setOfPred_mapsTo hKH' (show IsOpen U from hU)).preimage
        (ContinuousMonoidHom.isInducing_toContinuousMap H.1 Circle).continuous
    refine isOpen_induced_iff.mpr ⟨(fun a ↦ a H) ⁻¹' V, hV.preimage (continuous_apply H), ?_⟩
    ext ψ
    simp only [Set.mem_preimage]
    constructor
    · intro h χ hχ
      exact h (show (⟨χ, hKH hχ⟩ : H.1) ∈ Subtype.val ⁻¹' K from hχ)
    · intro h χ hχ
      exact h hχ
  have hRemb : IsEmbedding R := ⟨hRind, hRinj⟩
  obtain ⟨e, he⟩ := LCAGroup.pontryagin_duality G
  let γ : G →ₜ* ((H : I) → PontryaginDual H.1) :=
    { toFun := fun x ↦ R (e x)
      map_one' := by
        funext H
        simp only [map_one]
        rfl
      map_mul' := fun x y ↦ by
        funext H
        simp only [map_mul]
        rfl
      continuous_toFun := hRcont.comp e.toHomeomorph.continuous }
  have hγ (x : G) : γ x = R (e x) := rfl
  have hEval (x : G) (H : I) (χ : H.1) : γ x H χ = (χ : PontryaginDual G) x := by
    rw [hγ, hRapply, he]
  refine ⟨γ, hEval, ?_, ?_⟩
  · exact hRemb.comp e.toHomeomorph.isEmbedding
  · ext a
    constructor
    · rintro ⟨x, rfl⟩ H J h χ
      rw [hEval, hEval]
      rfl
    · intro ha
      choose H hH using hCover
      let f : PontryaginDual G → Circle := fun χ ↦ a (H χ) ⟨χ, hH χ⟩
      -- compatibility makes the chosen subgroup irrelevant
      have hf (J : I) (χ : J.1) : f χ.1 = a J χ := by
        obtain ⟨L, h₁, h₂⟩ := hDirected (H χ.1) J
        exact (ha _ _ h₁ _).trans (ha _ _ h₂ χ).symm
      let ψ : PontryaginDual (PontryaginDual G) :=
        { toFun := f
          map_one' := (hf (H 1) 1).trans (map_one (a (H 1)))
          map_mul' := fun χ ξ ↦ by
            obtain ⟨L, hχ, hξ⟩ := hDirected (H χ) (H ξ)
            let χL : L.1 := ⟨χ, hχ (hH χ)⟩
            let ξL : L.1 := ⟨ξ, hξ (hH ξ)⟩
            exact (hf L (χL * ξL)).trans
              ((map_mul (a L) χL ξL).trans (congrArg₂ (· * ·) (hf L χL).symm (hf L ξL).symm))
          continuous_toFun := by
            rw [continuous_iff_continuousAt]
            intro χ
            have hComp : f ∘ (Subtype.val : (H χ).1 → PontryaginDual G) = a (H χ) :=
              funext (hf (H χ))
            have hc : ContinuousAt (f ∘ (Subtype.val : (H χ).1 → PontryaginDual G))
                (⟨χ, hH χ⟩ : (H χ).1) := by
              rw [hComp]
              exact (a (H χ)).continuous.continuousAt
            exact (H χ).2.1.isOpenEmbedding_subtypeVal.continuousAt_iff.mp hc }
      refine ⟨e.symm ψ, funext fun J ↦ PontryaginDual.ext fun χ ↦ ?_⟩
      rw [hγ, hRapply, e.apply_symm_apply]
      exact hf J χ
