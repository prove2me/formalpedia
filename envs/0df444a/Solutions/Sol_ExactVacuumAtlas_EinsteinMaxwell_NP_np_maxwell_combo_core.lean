theorem fdir_mul_of {f h : Pt n → ℂ} (hf : ContDiffOn ℝ ∞ f V) (hh : ContDiffOn ℝ ∞ h V) (A : Fin n) :
    fdir E' A (fun z => f z * h z) y = fdir E' A f y * h y + f y * fdir E' A h y := by
  simp only [fdir, cpdC_mul_of hV hy _ hf hh, mul_add, Finset.sum_add_distrib, Finset.sum_mul, Finset.mul_sum]
  congr 1 <;> exact Finset.sum_congr rfl fun μ _ => by ring

end fdircalc

theorem fdir_const_mul {n : ℕ} (E' : Fin n → Fin n → Pt n → ℂ) (c : ℂ) (f : Pt n → ℂ) (A : Fin n) (y : Pt n) :
    fdir E' A (fun z => c * f z) y = c * fdir E' A f y := by
  simp only [fdir, cpdC_const_mul, Finset.mul_sum]
  exact Finset.sum_congr rfl fun μ _ => by ring

