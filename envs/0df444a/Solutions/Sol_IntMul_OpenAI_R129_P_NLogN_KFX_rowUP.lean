/-- `encode` of a two-digit swap. -/
theorem encode_swapPos (sh : Shape) (a : List ℕ) {p q : ℕ} (hpq : p ≠ q) (hp : p < a.length)
    (hq : q < a.length) (hl : a.length ≤ sh.length) :
