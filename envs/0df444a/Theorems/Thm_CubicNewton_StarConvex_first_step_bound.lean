-- title:
--   Theorem 4 (item 1): if $f(x_0)-f^*\ge\tfrac32LD^3$ then $f(x_1)-f^*\le\tfrac12LD^3$
-- statement:
--   Let $F \subseteq \mathbb{R}^n$ be a closed convex set and $x_0 \in \operatorname{int} F$ a starting point such that the level set $\{x : f(x) \le f(x_0)\}$ lies in $\operatorname{int} F$. Let $f$ be twice differentiable on $F$ with gradient $f'$ and Hessian $f''$, and assume the Hessian is $L$-Lipschitz on $F$ with $L > 0$. Let $0 < L_0 \le L$ and let $x_0, x_1, \dots$ be generated by the cubic regularization of Newton method (3.3).
--
--   Assume that $f$ is star-convex (Definition 1) and that $F$ is bounded, with diameter $D = \operatorname{diam} F$. Let $x^*$ be a global minimizer of $f$ and $f^* = f(x^*)$. If
--
--   $$f(x_0) - f^* \ge \tfrac32 L D^3, \qquad \text{then} \qquad f(x_1) - f^* \le \tfrac12 L D^3 .$$
--
--   This is item 1 of Theorem 4: from a far-away start, a single step of the method brings the optimality gap below $\tfrac12 LD^3$, after which item 2 (the $O(1/k^2)$ rate) applies.
--
--   **Formalization Note** $D$ is `Metric.diam F` together with the hypothesis that $F$ is bounded. The derivatives are two-sided at every point of $F$. The iteration index is $0$-based as in the paper.
-- source:
--   Nesterov & Polyak, Cubic regularization of Newton method and its global performance, Math. Program. Ser. A 108 (2006) 177–205, DOI 10.1007/s10107-006-0706-8, p. 189, Theorem 4, item 1

import Mathlib
import Definitions.Def_CubicNewton_Shared_IsCubicNewtonRun
import Definitions.Def_CubicNewton_StarConvex_IsStarConvexFn

namespace CubicNewton.StarConvex

/-- Nesterov–Polyak 2006, Theorem 4, item 1, p. 189. Standing assumptions of Section 2: `F` closed
and convex, `x₀ ∈ int F`, the level set `{x : f(x) ≤ f(x₀)}` lies in `int F`, `f` twice
differentiable on `F` (gradient `g`, Hessian `H`), Assumption 1 (Hessian `L`-Lipschitz on `F`,
`L > 0`), and `0 < L₀ ≤ L`. Assume `f` is star-convex (Definition 1) and `F` is bounded, with
`D = diam F`. Let `x₀, x₁, …` be generated by method (3.3) and let `x*` be a global minimizer of
`f`, `f* = f(x*)`. If `f(x₀) − f* ≥ (3/2) L D³`, then `f(x₁) − f* ≤ ½ L D³`. -/
theorem first_step_bound {n : ℕ}
    (F : Set (EuclideanSpace ℝ (Fin n))) (f : EuclideanSpace ℝ (Fin n) → ℝ)
    (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (H : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin n))
    (L L₀ : ℝ) (x₀ : EuclideanSpace ℝ (Fin n))
    (hF_closed : IsClosed F) (hF_convex : Convex ℝ F)
    (hx₀ : x₀ ∈ interior F) (hlevel : {x | f x ≤ f x₀} ⊆ interior F)
    (hf : ∀ x ∈ F, HasGradientAt f (g x) x) (hg : ∀ x ∈ F, HasFDerivAt g (H x) x)
    (hL : 0 < L) (hLip : ∀ x ∈ F, ∀ y ∈ F, ‖H x - H y‖ ≤ L * ‖x - y‖)
    (hL₀ : 0 < L₀) (hL₀L : L₀ ≤ L)
    (hstar : IsStarConvexFn F f) (hF_bdd : Bornology.IsBounded F)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (M : ℕ → ℝ)
    (hrun : CubicNewton.Shared.IsCubicNewtonRun f g H L₀ L x₀ x M)
    (xs : EuclideanSpace ℝ (Fin n)) (hxs : ∀ y, f xs ≤ f y)
    (h0 : 3 / 2 * L * Metric.diam F ^ 3 ≤ f x₀ - f xs) :
    f (x 1) - f xs ≤ 1 / 2 * L * Metric.diam F ^ 3 := by sorry

end CubicNewton.StarConvex
