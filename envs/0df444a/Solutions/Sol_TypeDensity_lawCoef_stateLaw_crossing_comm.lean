    TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing a b c h)) = TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.crossing b a h c)) := by
  have h1 := (TypeDensity.state_law_unfold (.crossing a b c h) ⟨ha, hb, hc, hh⟩ rfl).2 a b c h rfl
  have h2 := (TypeDensity.state_law_unfold (.crossing b a h c) ⟨hb, ha, hh, hc⟩ rfl).2 b a h c rfl
  rw [h1, h2, TypeDensity.lawCoef_exitLaw_crossing a b c h ha hb hc hh,
    TypeDensity.lawCoef_exitLaw_crossing b a h c hb ha hh hc, Nat.min_comm h c]
  refine Finset.sum_congr rfl fun d _ ↦ ?_
  conv_rhs => rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun rt _ ↦ Finset.sum_congr rfl fun rx _ ↦ ?_
  have hp : (TypeDensity.divisorProbability (TypeDensity.State.crossing b a h c) d).rational
      = (TypeDensity.divisorProbability (TypeDensity.State.crossing a b c h) d).rational := by
    rw [TypeDensity.rational_divisorProbability_crossing b a h c d,
      TypeDensity.rational_divisorProbability_crossing a b c h d,
      Nat.add_comm (if d < h then 1 else 0)]
  rw [hp, Nat.add_comm b a, Nat.add_comm (b * h) (a * c), Nat.sub_right_comm d rx rt]
  by_cases hc1 : ((0 < rt ↔ d < c) ∧ (0 < rx ↔ d < h) ∧ rt + rx ≤ d)
