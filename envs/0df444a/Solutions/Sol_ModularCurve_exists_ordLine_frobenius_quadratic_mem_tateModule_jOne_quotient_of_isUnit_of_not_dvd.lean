  obtain ⟨L, hL1, hD, hI, hF⟩ := assemble r hr_mul
    (↑(P.decompositionSubgroup ℚ) : Set (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ))
    (↑(P.inertiaSubgroupIn ℚ) : Set (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ))
