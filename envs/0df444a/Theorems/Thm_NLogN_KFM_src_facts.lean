theorem NLogN.KFM.src_facts {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (j : ℕ) (hj : j < IntMul.OpenAI.Glue.dP n) :
    (j < dpN n → j ≤ srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n / 2)) ∧
    (dpN n ≤ j → j - dpN n ≤ srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n)) ∧
    2 ≤ srcN n j ∧ srcN n j ≤ IntMul.OpenAI.Glue.rP n ∧ Nat.Coprime (prodN n j) (srcN n j) := by sorry
