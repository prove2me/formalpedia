/-! ## The ℕ / ℝ cost comparison -/

/-! ## The theorem -/

/-- The empty extension list. -/
def ext0 : Fin 0 → IStmt HS (7 + 0) := fun k => k.elim0

/-- The reversal scratch stack (`18`, or `19` if the swap descriptor sits on `18`). -/
def dscOf (sdS : Fin HS) : Fin HS := if sdS = 18 then 19 else 18

/-- Our two procedures, in the merged table of size `7 + (E₁ + 0 + 0 + 2)`. -/
noncomputable def ownPhi (E₁ : ℕ) (entry : Fin (7 + E₁)) (sdS : Fin HS) :
    Fin 2 → IStmt HS (7 + (E₁ + 0 + 0 + 2)) := fun k =>
  if k.val = 0 then
    phiFU (KFM.pMul _) (KFM.gI E₁ (E₁ + 0 + 0 + 2) 0 (by omega) entry) sdS (dscOf sdS)
  else phiBU (KFM.pMul _) (KFM.gI E₁ (E₁ + 0 + 0 + 2) 0 (by omega) entry) sdS (dscOf sdS)

end NLogN.KFUU

