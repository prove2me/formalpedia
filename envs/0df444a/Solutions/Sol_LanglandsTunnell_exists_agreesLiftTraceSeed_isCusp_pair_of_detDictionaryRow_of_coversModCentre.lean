  rw [HeckeEigensystem.map_twist, HeckeEigensystem.map_twist] at h1

  have h2 : ((Ψ.map iotaZsqrtdNegTwo).twist fun v => iotaZsqrtdNegTwo (Ψ.b v)).AgreesAwayFromFinite
      ((Ψ.map iotaZsqrtdNegTwo).map (starRingEnd ℂ)) := by
    refine ⟨(T.subtype Nat.Prime).image ratPrime, fun v hv => ?_⟩
    set p : Nat.Primes := Rat.HeightOneSpectrum.primesEquiv (R := 𝓞 ℚ) v with hp
