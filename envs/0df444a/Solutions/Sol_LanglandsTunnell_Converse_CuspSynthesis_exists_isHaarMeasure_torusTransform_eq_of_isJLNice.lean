  rw [t0142, t0142, map_mul, map_mul, FiniteWhittaker.t0100,
    Units.val_mul, Matrix.map_mul]
  congr 1
  ext i j
  fin_cases i <;> fin_cases j <;> simp [ArchR.diagOne, diagOne_coe_apply]
  rfl

private theorem t0539 (w : InfinitePlace K) (hw : w.IsComplex) (a : (AdeleRing (𝓞 K) K)ˣ)
    (g : AdelicGL2 (𝓞 K) K) :
    complexComponent w hw (diagOne a * g) =
