    have hgne : ∀ ℓ : Nat.Primes, (ℓ : ℕ) ≠ s → g ℓ = LinearMap.prodMap (T ℓ) (T ℓ) := fun ℓ h => if_neg h
    have hg : ∀ a b, g a * g b = g b * g a := by
      intro a b
      refine LinearMap.ext fun x => ?_
      show g a (g b x) = g b (g a x)
      by_cases ha : (a : ℕ) = s
      · have ha' : a = ⟨s, hs⟩ := Subtype.ext ha
        subst ha'
        by_cases hb : (b : ℕ) = s
        · have hb' : b = ⟨s, hs⟩ := Subtype.ext hb
          subst hb'
          rfl
        · rw [hgs, hgne b hb]
          simp only [hC, LinearMap.prodMap_apply, map_sub, LinearMap.map_smul_of_tower, hTT ⟨s, hs⟩ b]
