section Alg
variable (x h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ : ℝ)

/-- 3C: on the real `paE = 0`, `S′ = c1 V + a1aux W + d1` and `x T′ + 2T = x (a1aux W - c1 V - d1)`
with `V′ = (x A₁ - A)/x²`, `W′ = b₁ A₁ + b A₂`. -/
theorem maxwell_id (hx : x ≠ 0) (hb : b ≠ 0) (hu : 1 - h * x ≠ 0)
    (hPA : paE x (1 - h * x) h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ = 0) :
    ((x * A₁ - A) / x ^ 2 + (b₁ * A₁ + b * A₂)
      = c1E h Q x F b ((F / b - 1) / x) * (A / x) + (1 / b - 1) / x * (b * A₁)
        + d1E h Q J x F b) ∧
    (x * ((x * A₁ - A) / x ^ 2 - (b₁ * A₁ + b * A₂)) + 2 * (A / x - b * A₁)
      = x * ((1 / b - 1) / x * (b * A₁) - c1E h Q x F b ((F / b - 1) / x) * (A / x)
        - d1E h Q J x F b)) := by
  have e1 := VII16R.e1_onshell x h Q J F F₁ F₂ b b₁ b₂ A A₁ A₂ hx hb hu hPA
  have hA2 : A₂ = (F * A / (x * b) + 2 * Q * F * b * x * (J + 2 * Q * A) / (1 - h * x) ^ 2
      - (1 * b + x * b₁) * A₁) / (x * b) := by
    rw [eq_div_iff (mul_ne_zero hx hb)]; linarith
  subst hA2
  unfold c1E d1E
  constructor <;> (field_simp; ring)

end Alg

