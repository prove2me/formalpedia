theorem swapE_le_sol_aux (τ K : ℝ) (hK : 0 ≤ K) (hτ0 : 0 ≤ τ) (hτ1 : τ ≤ 1) (w u : ℕ) (sh : Shape)
    (p T ℓ d : ℕ) (hlen : sh.length = 5) (hvol : vol sh = T) (hw : w = p + 2) (hp : 6 ≤ p)
    (hu : u ≤ ℓ * d) (hℓ : 1 ≤ ℓ) (hsz : Nat.size T + w + u + 1 ≤ 4 * p) (hpT : p ≤ T) :
    cSwNτ τ K w u sh ≤ K * (4 * (T : ℝ) * p * ((ℓ : ℝ) * ((d : ℝ) * Real.log p) ^ τ) +
      96 * (T : ℝ) * p) := by
  unfold cSwNτ
  rw [hvol, hlen]
  apply mul_le_mul_of_nonneg_left _ hK
  have hp0 : (6 : ℝ) ≤ p := by exact_mod_cast hp
  have hT0 : (p : ℝ) ≤ T := by exact_mod_cast hpT
  -- the exponent part
  have hlog : (1 : ℝ) ≤ Real.log p := by
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9; linarith
  have hu' : ((u : ℕ) : ℝ) ^ τ ≤ (ℓ : ℝ) * ((d : ℝ) * Real.log p) ^ τ := by
    have h1 : ((u : ℕ) : ℝ) ^ τ ≤ ((ℓ : ℝ) * d) ^ τ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast hu) hτ0
    have h2 : ((ℓ : ℝ) * d) ^ τ = (ℓ : ℝ) ^ τ * (d : ℝ) ^ τ :=
      Real.mul_rpow (Nat.cast_nonneg _) (Nat.cast_nonneg _)
    have h3 : (ℓ : ℝ) ^ τ ≤ ℓ := by
      have hℓ1 : (1 : ℝ) ≤ ℓ := by exact_mod_cast hℓ
      have := Real.rpow_le_rpow_of_exponent_le hℓ1 hτ1
      rwa [Real.rpow_one] at this
    have h4 : (d : ℝ) ^ τ ≤ ((d : ℝ) * Real.log p) ^ τ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by nlinarith [(Nat.cast_nonneg d : (0 : ℝ) ≤ d)]) hτ0
    have h5 : 0 ≤ (d : ℝ) ^ τ := Real.rpow_nonneg (Nat.cast_nonneg _) _
    have h6 : 0 ≤ (ℓ : ℝ) ^ τ := Real.rpow_nonneg (Nat.cast_nonneg _) _
    calc ((u : ℕ) : ℝ) ^ τ ≤ (ℓ : ℝ) ^ τ * (d : ℝ) ^ τ := h2 ▸ h1
      _ ≤ (ℓ : ℝ) * ((d : ℝ) * Real.log p) ^ τ :=
          mul_le_mul h3 h4 h5 (by positivity)
  have hA : ((w : ℝ) + 1) * ((T : ℝ) + 1) ≤ 4 * (T : ℝ) * p := by
    rw [hw]; push_cast; nlinarith
  have hA0 : 0 ≤ ((w : ℝ) + 1) * ((T : ℝ) + 1) := by positivity
  have hX0 : 0 ≤ ((u : ℕ) : ℝ) ^ τ := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hB : (((5 + 1) * (Nat.size T + w + u + 1) ^ 2 : ℕ) : ℝ) ≤ 96 * (T : ℝ) * p := by
    have : (5 + 1) * (Nat.size T + w + u + 1) ^ 2 ≤ 96 * T * p := by
      have : (Nat.size T + w + u + 1) ^ 2 ≤ (4 * p) ^ 2 := Nat.pow_le_pow_left hsz 2
      nlinarith
    exact_mod_cast this
  have := mul_le_mul hA hu' hX0 (by positivity)
  nlinarith

