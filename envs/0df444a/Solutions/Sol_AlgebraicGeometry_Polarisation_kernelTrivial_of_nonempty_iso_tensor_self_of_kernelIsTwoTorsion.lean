theorem locIso_of_iso {S' : Type} [CommRing S'] {X : Scheme.{0}} (g : X ⟶ Spec (CommRingCat.of S'))
    {M N : X.Modules} (e : M ≅ N) : LocIsoOnBase g M N :=
  fun _ => ⟨⊤, trivial, ⟨(Scheme.Modules.pullback _).mapIso e⟩⟩

theorem isInvertible_of_iso {X : Scheme.{0}} {M N : X.Modules} (e : M ≅ N) (h : Scheme.Modules.IsInvertible M) :
    Scheme.Modules.IsInvertible N := by
  refine ⟨fun x => ?_⟩
  obtain ⟨U, hx, ⟨eU⟩⟩ := h.1 x
  exact ⟨U, hx, ⟨(Scheme.Modules.pullback U.ι).mapIso e.symm ≪≫ eU⟩⟩

end KTH

