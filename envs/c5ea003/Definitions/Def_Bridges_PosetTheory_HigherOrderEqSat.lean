/-! ## Section 12: Higher-Order E-Graph Structures -/

/-- Semantic soundness of a higher-order e-graph. -/
def HOEGraphSound
    (sameClass : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → HOTerm Γ τ → Prop)
    (den : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → Env Γ → TyDenote τ) : Prop :=
  ∀ {Γ : Ctx} {τ : HOType} (t u : HOTerm Γ τ),
    sameClass t u → ∀ ρ : Env Γ, den t ρ = den u ρ

/-- A higher-order e-graph with a class relation and extraction function. -/
structure HOEGraph where
  /-- The e-class equivalence relation. -/
  sameClass : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → HOTerm Γ τ → Prop
  /-- Extract a representative from each class. -/
  extract : ∀ {Γ : Ctx} {τ : HOType}, HOTerm Γ τ → HOTerm Γ τ
  /-- The extracted term is in the same class. -/
  extract_sameClass : ∀ {Γ : Ctx} {τ : HOType} (t : HOTerm Γ τ),
    sameClass t (extract t)

/-! ## Section 13: Extraction Soundness (Theorem 4) -/



/-! ## Section 14: Quotient Normal Form Agreement (Theorem 5) -/

/-- An extraction relation: `t` extracts to `extracted`. -/
structure HOExtractsTo (eg : HOEGraph) {Γ : Ctx} {τ : HOType}
    (t extracted : HOTerm Γ τ) : Prop where
  sameClass : eg.sameClass t extracted

/-- A quotient normal form relation. -/
structure HOQuotientNF (eg : HOEGraph) {Γ : Ctx} {τ : HOType}
    (t qnf : HOTerm Γ τ) : Prop where
  sameClass : eg.sameClass t qnf


