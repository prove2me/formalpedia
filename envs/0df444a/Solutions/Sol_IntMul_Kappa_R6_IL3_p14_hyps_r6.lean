/-- `b^(1-ε) ≤ 2 ℓ`. -/
lemma b_rpow_le_two_ell (P : Prm) {n : ℕ} (hG : Good P n) :
    (bP6 n : ℝ) ^ (1 - P.ε) ≤ 2 * ℓP6 P n := by
  have hb0 : (0 : ℝ) < bP6 n := by exact_mod_cast (show 0 < bP6 n by have := hG.b_ge; omega)
  have hd0 : (0 : ℝ) < dP6 P n := by exact_mod_cast (show 0 < dP6 P n by have := hG.d_pos; omega)
  have he : (0 : ℝ) < (bP6 n : ℝ) ^ P.ε := Real.rpow_pos_of_pos hb0 _
  have hsplit : (bP6 n : ℝ) ^ (1 - P.ε) = (bP6 n : ℝ) / (bP6 n : ℝ) ^ P.ε := by
    rw [Real.rpow_sub hb0, Real.rpow_one]
  have h1 : (bP6 n : ℝ) / (bP6 n : ℝ) ^ P.ε ≤ (bP6 n : ℝ) / dP6 P n :=
    div_le_div_of_nonneg_left hb0.le hd0 hG.d_le
  have h2 := hG.ell_ge
  have h3 : (bP6 n : ℝ) / (2 * dP6 P n) = (bP6 n : ℝ) / dP6 P n / 2 := by ring
  rw [hsplit]; linarith

lemma mExp_pos (P : Prm) (hP : P.Ok) : 1 ≤ mExp P := by
  have h : 0 < 1 - P.ε := by linarith [hP.eps_lt]
  unfold mExp
  exact Nat.one_le_iff_ne_zero.mpr (by
    intro h0; rw [Nat.ceil_eq_zero] at h0; have : 0 < 1 / (1 - P.ε) := by positivity
    linarith)

/-- `b ≤ (2ℓ)^m`. -/
lemma b_le_ell_pow (P : Prm) (hP : P.Ok) {n : ℕ} (hG : Good P n) :
    bP6 n ≤ (2 * ℓP6 P n) ^ mExp P := by
