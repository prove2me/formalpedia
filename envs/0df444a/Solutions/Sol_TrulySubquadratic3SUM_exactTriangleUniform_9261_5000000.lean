    ThreeSumApsp.Spec.nineFirst (n + 1) lo = 0 :: ThreeSumApsp.Spec.nineFirst n lo := by
  rw [ThreeSumApsp.Spec.nineFirst, ThreeSumApsp.Spec.nineFirst, Nat.succ_sub h, List.replicate_succ, List.cons_append]

/-- The string of nines. -/
private theorem nineFirst_self_succ (n : ℕ) : ThreeSumApsp.Spec.nineFirst (n + 1) (n + 1) = 9 :: ThreeSumApsp.Spec.nineFirst n n := by
  simp [ThreeSumApsp.Spec.nineFirst, List.replicate_succ]

/-- Without strings of n digits there are no strings of n + 1 digits that begin below 9. -/
private theorem flatMap_map_nil (l : List ℕ) :
    l.flatMap (fun d => ([] : List (List ℕ)).map (d :: ·)) = [] :=
  List.flatMap_eq_nil_iff.2 fun _ _ => rfl

