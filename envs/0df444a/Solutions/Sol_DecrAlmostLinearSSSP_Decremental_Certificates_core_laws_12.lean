open Structured
lemma start_eval (s : Data) : Eval start s 2 (started s) := eval_sequence_atoms startAtoms s
lemma body_eval (s : Data) : Eval body s 2 (advanced s) := eval_sequence_atoms bodyAtoms s
lemma start_rep (x : ℝ) (s : Data) (hx : s.realReg 522 = x) (hunit : s.natReg 26 = 1) :
    Rep x (started s) ∧ (started s).natReg 526 = 0 := by
  constructor
  · constructor <;> simp [started,startAtoms,Atom.effect,instructionEffect,data,Data.machine,hx,hunit]
  · simp [started,startAtoms,Atom.effect,instructionEffect,data,Data.machine]
lemma advanced_fields (s : Data) (hunit : s.natReg 26 = 1) :
    (advanced s).natReg 526 = s.natReg 526+1 ∧
    (advanced s).realReg 526 = ((s.natReg 526+1 : ℕ) : ℝ) ∧
    (advanced s).realReg 522 = s.realReg 522 ∧ (advanced s).natReg 26 = 1 := by
  simp [advanced,bodyAtoms,Atom.effect,instructionEffect,data,Data.machine,hunit]
lemma loop_eval (x : ℝ) (s : Data) (h : Rep x s) :
    ∃ t cost, Eval loop s cost t ∧ t.natReg 526 = ⌈x⌉₊ ∧ t.realReg 526 = (⌈x⌉₊ : ℝ) ∧
      cost ≤ 4*(⌈x⌉₊-s.natReg 526)+2 := by
  have hbody : ∀ s, Rep x s → (Test.realLess 526 522).holds s →
      ∃ t cost, Eval body s cost t ∧ Rep x t ∧
        ⌈x⌉₊-t.natReg 526 < ⌈x⌉₊-s.natReg 526 ∧ cost ≤ 2 := by
    intro s hs htest
    have hlt : s.natReg 526 < ⌈x⌉₊ := by
      apply Nat.lt_ceil.mpr
      change s.realReg 526 < s.realReg 522 at htest
      rwa [hs.value,hs.target] at htest
    obtain ⟨hc,hv,ht,hu⟩ := advanced_fields s hs.unit
    have hrep : Rep x (advanced s) :=
      ⟨ht.trans hs.target,hu,by rw [hv,hc],by rw [hc];omega⟩
    exact ⟨advanced s,2,body_eval s,hrep,by rw [hc];omega,le_rfl⟩
  obtain ⟨t,cost,he,ht,hcost⟩ := loop_bounded (.realLess 526 522) body (Rep x)
    (fun s => ⌈x⌉₊-s.natReg 526) 2 hbody s h
  have hstop := eval_loop_stops (.realLess 526 522) body cost s t he
  have hxle : x ≤ (t.natReg 526 : ℝ) := by
    change ¬t.realReg 526 < t.realReg 522 at hstop
    rw [ht.value,ht.target] at hstop
    exact not_lt.mp hstop
  have heq : t.natReg 526 = ⌈x⌉₊ := le_antisymm ht.bound (Nat.ceil_le.mpr hxle)
  exact ⟨t,cost,he,heq,by simpa only [heq] using ht.value,hcost⟩
lemma code_eval (x : ℝ) (s : Data) (hx : s.realReg 522 = x) (hunit : s.natReg 26 = 1) :
    ∃ t cost, Eval (.seq start loop) s cost t ∧ t.natReg 526 = ⌈x⌉₊ ∧
      t.realReg 526 = (⌈x⌉₊ : ℝ) ∧ cost ≤ 4*⌈x⌉₊+4 := by
  have hh := start_rep x s hx hunit
  obtain ⟨t,cost,he,hn,hr,hcost⟩ := loop_eval x (started s) hh.1
  exact ⟨t,2+cost,Eval.seq (start_eval s) he,hn,hr,by rw [hh.2,Nat.sub_zero] at hcost;omega⟩
end DecrAlmostLinearSSSP.Decremental.CoreCeiling
