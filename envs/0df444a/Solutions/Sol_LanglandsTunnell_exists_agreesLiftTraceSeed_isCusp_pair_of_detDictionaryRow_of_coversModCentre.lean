    haveI := (LanglandsTunnell.P5.OctInhabitant.primeOver L ⟨(p : ℕ), p.2⟩).2.1
    haveI := (LanglandsTunnell.P5.OctInhabitant.primeOver L ⟨(p : ℕ), p.2⟩).2.2
    obtain ⟨M, -, -, hb, M', hM', ha, hd⟩ := hval (p : ℕ) p.2 hpT (LanglandsTunnell.P5.OctInhabitant.primeOver L ⟨(p : ℕ), p.2⟩).1
    rw [hvp, hp']
