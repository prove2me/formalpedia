-- title:
--   Acceptance sets $\mathcal A_\rho$ and the risk measure $\rho_{\mathcal A}$ generated by an acceptance set
-- statement:
--   Let $\mathcal X$ be a space of positions (bounded real functions on $\Omega$ containing the constants).
--
--   The **acceptance set** of a function $\rho:\mathcal X\to\mathbb R$ is its lower level set at zero,
--
--   $$\mathcal A_\rho=\{X\in\mathcal X\mid \rho(X)\le 0\}.$$
--
--   In general, a subset $\mathcal A\subseteq\mathcal X$ is called an **acceptance set** if
--
--   1. $\sup\{m\in\mathbb R\mid m\in\mathcal A\}=0$, where $m$ denotes the constant position, and
--   2. $X\in\mathcal A$, $Y\in\mathcal X$ and $Y\leqq X$ imply $Y\in\mathcal A$.
--
--   An acceptance set is **convex** if it is a convex subset of $\mathcal X$, and **coherent** if it is a convex cone. An acceptance set $\mathcal A$ generates the function
--
--   $$\rho_{\mathcal A}(X)=\inf\{m\in\mathbb R\mid X-m\in\mathcal A\},\qquad X\in\mathcal X.$$
--
--   Acceptance sets are the geometric counterpart of risk measures: the representation theorems of the mission are stated both through risk measures and through families of acceptance sets.
--
--   **Formalization Note** The supremum condition is stated as "$0$ is the least upper bound of $\{m\mid m\in\mathcal A\}$" (`IsLUB`), so it cannot hold vacuously for an empty or unbounded set. A coherent acceptance set is convex and closed under multiplication by every $t>0$. $\rho_{\mathcal A}$ is Lean's real `sInf`, which returns $0$ on an empty or unbounded-below set; for an acceptance set on bounded positions the set is nonempty and bounded below, so the value is the true infimum. It is used only with an acceptance set.
-- source:
--   Castagnoli, Cattelan, Maccheroni, Tebaldi, Wang, Star-Shaped Risk Measures, Operations Research 70(5) (2022), p. 2642, definition of 𝒜ρ, of acceptance sets and of ρ𝒜

import Mathlib
import Definitions.Def_StarShapedRisk_Representation_RiskMeasure

namespace StarShapedRisk.Representation

variable {Ω : Type*}

/-- The acceptance set of `ρ`: `A_ρ = {X ∈ 𝒳 | ρ X ≤ 0}` (Sec. 3, p. 2642). -/
def acceptanceSet (𝒳 : PositionSpace Ω) (ρ : 𝒳.carrier → ℝ) : Set 𝒳.carrier :=
  {X | ρ X ≤ 0}

/-- An acceptance set (p. 2642): `sup {m ∈ ℝ | m ∈ 𝒜} = 0`, stated as a least upper bound,
and `𝒜` is closed downwards: `X ∈ 𝒜`, `Y ≦ X` pointwise imply `Y ∈ 𝒜`. -/
def IsAcceptanceSet (𝒳 : PositionSpace Ω) (𝒜 : Set 𝒳.carrier) : Prop :=
  IsLUB {m : ℝ | 𝒳.const m ∈ 𝒜} 0 ∧
    ∀ X ∈ 𝒜, ∀ Y : 𝒳.carrier, (∀ ω, Y.1 ω ≤ X.1 ω) → Y ∈ 𝒜

/-- A convex acceptance set. -/
def IsConvexAcceptanceSet (𝒳 : PositionSpace Ω) (𝒜 : Set 𝒳.carrier) : Prop :=
  IsAcceptanceSet 𝒳 𝒜 ∧ Convex ℝ 𝒜

/-- A coherent acceptance set: an acceptance set that is a convex cone (convex and closed
under multiplication by every `t > 0`). -/
def IsCoherentAcceptanceSet (𝒳 : PositionSpace Ω) (𝒜 : Set 𝒳.carrier) : Prop :=
  IsAcceptanceSet 𝒳 𝒜 ∧ Convex ℝ 𝒜 ∧ ∀ t : ℝ, 0 < t → ∀ X ∈ 𝒜, t • X ∈ 𝒜

/-- The risk measure generated by `𝒜`: `ρ_𝒜 X = inf {m ∈ ℝ | X - m ∈ 𝒜}` (p. 2642).
Lean's `sInf` returns `0` on an empty or unbounded-below set; for an acceptance set the set is
nonempty and bounded below, so this is the true infimum. -/
noncomputable def riskOf (𝒳 : PositionSpace Ω) (𝒜 : Set 𝒳.carrier) (X : 𝒳.carrier) : ℝ :=
  sInf {m : ℝ | X - 𝒳.const m ∈ 𝒜}

end StarShapedRisk.Representation


