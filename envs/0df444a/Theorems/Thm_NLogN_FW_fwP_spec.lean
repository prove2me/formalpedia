theorem NLogN.FW.fwP_spec (M : MulSpec) {Φm : ℕ} (q : Ref.Params) (kb : ℕ) (hMB : MulBnd M (q.fn + 1) Φm)
    (hP : 1 ≤ q.P) (hK : q.K ≤ q.fn) (hlo : q.logOuter ≤ q.fn) (hkb : q.logOuter ≤ kb)
    (s : IState HS) (U V : List (ℤ × ℤ))
    (RU RV Rs LCR LCM LRW LFR LKB LKN LKR LXN LXF LNN LKBR LNAX LSH : List Item)
    (hUl : U.length = 2 ^ q.logOuter * q.r) (hVl : V.length = 2 ^ q.logOuter * q.r)
    (hUb : ∀ z ∈ U, |z.1| < 2 ^ q.P ∧ |z.2| < 2 ^ q.P)
    (hVb : ∀ z ∈ V, |z.1| < 2 ^ q.P ∧ |z.2| < 2 ^ q.P)
    (hU : s.G GU = gints U ++ RU) (hV : s.G VI = gints V ++ RV)
    (hCR : s.G CR = .int (2 ^ q.P) :: LCR) (hCM : s.G CM = .int (q.r : ℤ) :: LCM)
    (hRW : s.G RW = .int (2 ^ (2 * q.r * q.P)) :: LRW) (hFR : s.G FR = .int (2 ^ q.fn + 1) :: LFR)
    (hKB : s.G KB = .int (2 ^ q.P) :: LKB) (hKN : s.G KN = .int (2 ^ q.fn) :: LKN)
    (hKR : s.G KR = .int (q.r : ℤ) :: LKR)
    (hXN : s.G NLogN.FW.XN = .int (2 ^ q.fn) :: LXN) (hXF : s.G XF = .int (2 ^ q.fn + 1) :: LXF)
    (hNN : s.G NN = .int ((2 ^ q.logOuter : ℕ) : ℤ) :: LNN) (hKBR : s.G KBR = .int kb :: LKBR)
    (hNAX : s.G NAX = .int ((q.K - 1 : ℕ) : ℤ) :: LNAX)
    (hAXS : s.G AXS = ints ((descs q.outerAxes 1).flatMap enc8) ++ Rs)
    (hSH : s.G SH = .int (2 ^ (q.fn - q.logOuter)) :: LSH) :
    Spec M fwP s (((s.upd GU RU).upd VI RV).upd OUT (gints (Ref.fermatW q U V) ++ s.G OUT))
      (fwCost q kb Φm) := by sorry
