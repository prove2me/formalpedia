namespace J6Seg
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-! ## The parameters of axis `k` -/

section par
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)

def axp6 : ℕ := pP6 P n
def axd6 : ℕ := dP6 P n
def axs6 : ℕ := src k
def axt6 : ℕ := tF6 P n k
def axQ6 : ℕ := Q6 (axp6 P n) (axd6 P n) (axs6 src k)
def axR6 : ℕ := R6 (axp6 P n)
def axl6 : ℕ := lamP (axd6 P n)
def axw6 : ℕ := wF (axd6 P n)
def axα6 : ℕ := αN6 P n
def axnc6 : ℕ := axt6 P n k / axl6 P n
def axG6 : ℕ := Gj6 (axd6 P n) (axs6 src k) (axt6 P n k)
def axpre6 : ℕ := preT P n D k
def axpost6 : ℕ := postT P n D k
/-- `log₂ λ` (`λ = 2^fC`). -/
def axfC6 : ℕ := Nat.log 2 (lamF (axd6 P n))
/-- `log₂ G` (`G = 2^fJ`). -/
def axfJ6 : ℕ := Nat.clog 2 (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length

/-! ## The arrays of `axisPipe` -/

variable (L : List GI)

/-- Pass 1: the selection slab. -/
def arrS6 : List GI :=
  slabPass (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n) (axpost6 P n D k)
    (selSrc (axs6 src k) (axt6 P n k)) (selH (axp6 P n) (axQ6 P n src k)) L

/-- Pass 2: the chunk kernel. -/
def arrY6 : List GI :=
  kerPass (axl6 P n) (axpost6 P n D k) (axpre6 P n D k * axnc6 P n k)
    (fun b => liftG (chunkK (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axα6 P n) (b % axnc6 P n k))) (arrS6 P n src D k L)

/-- Pass 3: the gather of the near-boundary rows. -/
def arrJ6 : List GI :=
  slabPass (axnc6 P n k * axl6 P n) (axG6 P n src k) (axpost6 P n D k)
    (jSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ z => z) (arrY6 P n src D k L)

/-- Pass 4: the `J` kernel. -/
def arrW6 : List GI :=
  kerPass (axG6 P n src k) (axpost6 P n D k) (axpre6 P n D k)
    (fun _ => liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k))) (arrJ6 P n src D k L)

/-- Pass 5: the scatter. -/
def arrWp6 : List GI :=
  slabPass (axG6 P n src k) (axnc6 P n k * axl6 P n) (axpost6 P n D k)
    (scSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ z => z) (arrW6 P n src D k L)

/-- Pass 6: the chunk kernel again. -/
def arrY26 : List GI :=
  kerPass (axl6 P n) (axpost6 P n D k) (axpre6 P n D k * axnc6 P n k)
    (fun b => liftG (chunkK (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axα6 P n) (b % axnc6 P n k))) (arrWp6 P n src D k L)

/-- Pass 7: the output slab on `(Y, Y₂)`. -/
def arrOut6 : List GI :=
  slabPass (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n) (axpost6 P n D k) (fun l => some l)
    (outH (axp6 P n) (axQ6 P n src k) (axs6 src k) (axt6 P n k) (axα6 P n))
    (List.zip (arrY6 P n src D k L) (arrY26 P n src D k L))

end par

/-! ## The plan -/

/-- The plan of the axis program: `Plan6` and the exponents of the input bounds. -/
structure AxPlan6 where
  pl : Plan6
  /-- chunk input bound `X = 2^(xA·Q + xC)` -/
  xA : ℕ
  xC : ℕ
  /-- `J` a-priori size bound `Xb = xbA·Q + xbC` -/
  xbA : ℕ
  xbC : ℕ
  /-- `J` count width `Bc = bcA·Q + bcC` -/
  bcA : ℕ
  bcC : ℕ

section plan
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (k : ℕ) (ap : AxPlan6)

def axpk6 : ℕ := pk6 (axp6 P n) (axd6 P n) (axs6 src k) ap.pl
def axb6 : ℕ := b6 (axp6 P n) (axd6 P n) (axs6 src k) ap.pl
def axkJ6 : ℕ := kJ6 (axp6 P n) (axd6 P n) (axs6 src k) ap.pl
def axwd6 : ℕ := wd6 (axp6 P n) (axd6 P n) (axs6 src k) ap.pl
def axX6 : ℤ := 2 ^ (ap.xA * axQ6 P n src k + ap.xC)
def axXb6 : ℕ := ap.xbA * axQ6 P n src k + ap.xbC
/-- The counter bound of the `J` kernel: `Bc0 s K G + bcC` (size-based, `O(log s)`; `bcA` unused). -/
def axBc6 : ℕ :=
  Nat.size (axG6 P n src k + 2 * axw6 P n + 3 * axs6 src k ^ 2 + 2 * axw6 P n * axs6 src k +
    10 * axs6 src k) + ap.bcC

/-- The chunk tables of chunk `q` of axis `k`. -/
def axTC6 (q : ℕ) : List ℤ :=
  chunkTab6 (axp6 P n) (axd6 P n) (axs6 src k) (axt6 P n k) (axα6 P n) ap.pl q

/-- The `J` table of axis `k`. -/
def axTJ6 : List ℤ := jTab6 (axp6 P n) (axd6 P n) (axs6 src k) (axt6 P n k) (axα6 P n) ap.pl

/-- The `J` row precondition of axis `k` (`kerW`'s `Pre` in the `J` pass). -/
def axJPre6 : List GI → Prop :=
  JK.JPre (axQ6 P n src k) (axkJ6 P n src k ap) (axw6 P n) (axG6 P n src k) (axXb6 P n src k ap)
    (axBc6 P n src k ap)
    (JK.jFs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n) (axα6 P n))
    (JK.jBs (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n) (axα6 P n))
    (JK.jCc (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n) (axα6 P n)
      (axw6 P n))

end plan

/-! ## The value bounds (value-bounds worker; the `J` rows with B4) -/

/-- **`ValNeed6 P ap`.** In the round-six regime, for every axis `k ≤ D` and every input array `L`
of the axis (`|L| = ∏ t_i`, `GB (p + 2) L`, as in `AxisBody6`):
1. `GB wd` of `S, Y, Jg, W, Wp, Y₂`;
2. `KR.AB X` (both parts `≤ X` in modulus) of the chunk inputs `S` and `Wp`;
3. `JPre` of every `G`-row `lineAt G post Jg b c` (`b < pre`, `c < post`);
4. `GB wd` of the `J` kernel's output on every `JPre` row. -/
def ValNeed6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ n₁ : ℕ, ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src → ∀ D : ℕ, dP6 P n = D + 1 →
  ∀ k ≤ D,
    (∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
      GB (axwd6 P n src k ap) (arrS6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrJ6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrW6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrWp6 P n src D k L) ∧
      GB (axwd6 P n src k ap) (arrY26 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrS6 P n src D k L) ∧
      KR.AB (axX6 P n src k ap) (arrWp6 P n src D k L) ∧
      ∀ b < axpre6 P n D k, ∀ c < axpost6 P n D k,
        axJPre6 P n src k ap (lineAt (axG6 P n src k) (axpost6 P n D k) (arrJ6 P n src D k L) b c)) ∧
    (∀ x : List GI, axJPre6 P n src k ap x →
      GB (axwd6 P n src k ap) (liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k)
        (axl6 P n) (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k)) x))

/-! ## The budget (S2: plan constants and closed-form cost) -/

/-- `max_{m' ≤ m} mulCostH m'`: the cost of one table multiplication of operands with
`zsz a + zsz b ≤ m`. -/
def mulSup (m : ℕ) : ℕ := (Finset.range (m + 1)).sup KFM.mulCostH

/-- One counted move of `m` integers (`mvK` with the count in a register). -/
def cMvK1 (m B : ℕ) : ℕ := (1 + 1) * 2000 * (B + 2) + m * (14000 * (B + 2)) + 32

/-- The cost of the `0 → rZ` copy of `m` integers with entries of size `≤ B` (count, move,
duplicate-move, pop). -/
def cCopy (m B : ℕ) : ℕ := 10 ^ 8 * (B + 2) ^ 2 + cMvK1 m B + KR.cMvP m B + (2 * B + 2)

/-- The cost of the `0 ↔ rZ` swap (count, four moves, pop). -/
def cSwap (m B : ℕ) : ℕ := 10 ^ 8 * (B + 2) ^ 2 + 4 * cMvK1 m B + (2 * B + 2)

/-- The slab-pass costs (`Slab.passC` of `slabSc_runs`, `slabId_runs`, `slabOut_runs`). -/
def cSlabSc (pre n post Bu e : ℕ) : ℕ :=
  Slab.passC pre (n + n) (2 * post) (e + 2)
    (2 * Bu + 2 + (2 * moveCost Bu + 19) + (300 * (Bu + 1) + 200 * (e + 1)) +
      (2 * moveCost Bu + 19)) (pre * (n * (2 * post))) (Bu + (e + 2))

def cSlabId (pre n n' post Bu : ℕ) : ℕ :=
  Slab.passC pre (n + n') (2 * post) 1
    (2 * Bu + 2 + (2 * moveCost Bu + 19) + 300 * (Bu + 1) + (2 * moveCost Bu + 19))
    (pre * (n' * (2 * post))) Bu

def cSlabOut (pre n post Bu Ba e p : ℕ) : ℕ :=
  Slab.passC pre (n + n) (2 * post) Ba
    (2 * (2 * Bu + 2) + 2 * (2 * moveCost Bu + 19) +
      Slab.cItO (Bu + Ba + 2) e p + 2 * (2 * moveCost Bu + 19))
    (pre * (n * (2 * post))) (Bu + Ba + 1)

/-- The register bound of the copy / swap. -/
def axBcp6 (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) : ℕ :=
  axwd6 P n src k ap + Nat.size (2 * (List.ofFn (tD6 P n D)).prod) + 2

/-- **The budget of axis `k`** with the constant `Cc = C · cU6 P n A / (D + 1)`. -/
def AxBudgetAt (P : Prm) (ap : AxPlan6) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (Cc : ℝ) : Prop :=
  let p := axp6 P n; let Q := axQ6 P n src k; let R := axR6 P n; let lam := axl6 P n
  let pk := axpk6 P n src k ap; let b := axb6 P n src k ap; let wd := axwd6 P n src k ap
  let kJ := axkJ6 P n src k ap; let nc := axnc6 P n k; let G := axG6 P n src k
  let pre := axpre6 P n D k; let post := axpost6 P n D k
  let fC := axfC6 P n; let fJ := axfJ6 P n src k
  let NC := 2 * (pre * nc * post * 2 ^ fC); let NJ := 2 * (pre * 1 * post * 2 ^ fJ)
  let TC := tabsT (axTC6 P n src k ap) nc; let TJ := tabsT (fun _ => axTJ6 P n src k ap) 1
  let Bs := axBcp6 P ap n src D k
  ∃ (BI BH Bk Lc Ck BkJ Lj Bx : ℕ),
    -- the chunk kernel (`KR.chunkK2_rowBody6` with `Kt = 2^(R+2)`)
    1 ≤ b ∧ b + 4 ≤ BI ∧ 2 * pk + 4 ≤ BI ∧ Q + 3 ≤ BI ∧ zsz ((2 * lam : ℕ) : ℤ) ≤ BI ∧ BI ≤ BH ∧
    (2 : ℤ) ^ Q * 2 ^ (R + 2) ≤ 2 ^ pk ∧
    KR.Xs (((lam : ℤ) + 1) * 2 ^ (R + 2) + 1) (axX6 P n src k ap) 7 ≤ 2 ^ pk ∧
    4 * lam * 2 ^ (2 * pk) < 2 ^ (b - 1) ∧ pk + 1 ≤ wd ∧
    (∀ m, 1 ≤ m → m ≤ lam → ∀ v ∈ KR.blkHdr2 m b, zsz v ≤ BH) ∧
    (∀ q, ∀ v ∈ axTC6 P n src k ap q, zsz v ≤ BH) ∧
    (∀ q, KR.cKer2 pk b lam (mulSup (2 * BI)) (fun m => mulSup (2 * (b * (2 * m) + 2))) BI BH
      (descsOf (axs6 src k) (axt6 P n k) lam (TT Q R (axs6 src k) (axt6 P n k) (axα6 P n)) q) + 2
      ≤ Ck) ∧
    -- `kerW_run` for the chunk pass
    1 ≤ Bk ∧ wd ≤ Bk ∧ zsz (wd : ℤ) ≤ Bk ∧ zsz (fC : ℤ) ≤ Bk ∧ zsz ((pre * nc : ℕ) : ℤ) ≤ Bk ∧
    zsz (post : ℤ) ≤ Bk ∧ zsz (pre : ℤ) ≤ Bk ∧ zsz (nc : ℤ) ≤ Bk ∧
    zsz ((2 * 2 ^ fC : ℕ) : ℤ) ≤ Bk ∧ zsz (NC : ℤ) ≤ Bk ∧ zsz (TC.length : ℤ) ≤ Bk ∧
    zsz (Lc : ℤ) ≤ Bk ∧
    (∀ q < nc, Bnd Bk (axTC6 P n src k ap q) ∧ (axTC6 P n src k ap q).length ≤ Lc) ∧
    -- the `J` kernel (`JK.jKer_row`) and `kerW_run` for the `J` pass
    3 * kJ + 10 ≤ Bx ∧
    1 ≤ BkJ ∧ wd ≤ BkJ ∧ zsz (wd : ℤ) ≤ BkJ ∧ zsz (fJ : ℤ) ≤ BkJ ∧
    zsz ((pre * 1 : ℕ) : ℤ) ≤ BkJ ∧ zsz (post : ℤ) ≤ BkJ ∧ zsz (pre : ℤ) ≤ BkJ ∧
    zsz ((1 : ℕ) : ℤ) ≤ BkJ ∧ zsz ((2 * 2 ^ fJ : ℕ) : ℤ) ≤ BkJ ∧ zsz (NJ : ℤ) ≤ BkJ ∧
    zsz (TJ.length : ℤ) ≤ BkJ ∧ zsz (Lj : ℤ) ≤ BkJ ∧
    Bnd BkJ (axTJ6 P n src k ap) ∧ (axTJ6 P n src k ap).length ≤ Lj ∧
    -- the component costs
    cFine wd fC (pre * nc) post ≤ Cc ∧ cFine wd fJ (pre * 1) post ≤ Cc ∧
    (kerC Ck Bk (2 ^ fC) post Lc nc TC.length pre NC : ℝ) ≤ Cc ∧
    (kerC (JK.jC kJ (axw6 P n) G
        (JK.jFs Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n))
        (JK.jBs Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n))
        (JK.jCc Q R (axs6 src k) (axt6 P n k) lam (axw6 P n) (axα6 P n) (axw6 P n))
        (JK.uC (mulSup (2 * (kJ + 2))) Bx (axBc6 P n src k ap)) + 2)
      BkJ (2 ^ fJ) post Lj 1 TJ.length pre NJ : ℝ) ≤ Cc ∧
    (cSlabSc pre (nc * lam) post (p + 2) (Q - p - 1) : ℝ) ≤ Cc ∧
    (cSlabId pre (nc * lam) G post wd : ℝ) ≤ Cc ∧
    (cSlabId pre G (nc * lam) post wd : ℝ) ≤ Cc ∧
    (cSlabOut pre (nc * lam) post wd (2 * p + 6) (Q - p) p : ℝ) ≤ Cc ∧
    (cCopy (2 * (List.ofFn (tD6 P n D)).prod) Bs : ℝ) ≤ Cc ∧
    (cSwap (2 * (List.ofFn (tD6 P n D)).prod) Bs : ℝ) ≤ Cc ∧
    -- the copy / swap (`J6SegAxCopy`) at `Bs = axBcp6`: the descriptor values and the count
    2 ≤ Bs ∧ zsz (k : ℤ) ≤ Bs ∧ zsz ((axs6 src k : ℕ) : ℤ) ≤ Bs ∧ zsz ((axt6 P n k : ℕ) : ℤ) ≤ Bs ∧
    zsz ((axt6 P n k : ℤ) * post) ≤ Bs ∧ zsz ((pre : ℤ) * ((axt6 P n k : ℤ) * post)) ≤ Bs ∧
    zsz (2 * ((pre : ℤ) * ((axt6 P n k : ℤ) * post))) ≤ Bs

/-- **`AxBudget6 P ap`** (S2). -/
def AxBudget6 (P : Prm) (ap : AxPlan6) : Prop :=
  ∃ (C : ℝ) (A n₁ : ℕ), 0 ≤ C ∧ ∀ n, n₁ ≤ n → ∀ src : ℕ → ℕ, SrcOK6 P n src →
    ∀ D : ℕ, dP6 P n = D + 1 → ∀ k ≤ D, AxBudgetAt P ap n src D k (C * cU6 P n A / (D + 1))

end J6Seg

end

