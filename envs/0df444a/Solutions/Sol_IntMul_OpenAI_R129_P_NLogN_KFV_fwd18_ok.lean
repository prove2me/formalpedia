    have ha := Ex.congrG a (fun r hr => h r (by simp [Ex.regs, hr]))
    refine ⟨by simp only [Ex.eval, ha.1], ?_, fun B => ?_, ?_⟩
    · simp only [Ex.ok, ha.1, ha.2.1]
    · simp only [Ex.Bnd, ha.1, ha.2.2.1 B]
    · simp only [Ex.cost, ha.1, ha.2.2.2]
