theorem finrank_Ψa_le_finrank_Xp (𝔪 : Ideal HeckeAlg) [𝔪.IsMaximal] (heis : ¬ IsEventuallyEisenstein 𝔪) :
    Module.finrank (HeckeAlg ⧸ 𝔪) (Q.Ψa ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Ψa))) ≤
      Module.finrank (HeckeAlg ⧸ 𝔪) (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) := by
  classical
  have hex : ∃ ℓ : Nat.Primes, ℓ ∉ Q.S ∧ heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1) ∉ 𝔪 := by
    by_contra h
    push_neg at h
    exact heis ⟨Q.S, fun ℓ hℓ => h ℓ hℓ⟩
  obtain ⟨ℓ, hℓS, hu⟩ := hex
  obtain ⟨v, hv⟩ : ∃ v : HeckeAlg, v * (heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1)) - 1 ∈ 𝔪 := by
    have hne : (Ideal.Quotient.mk 𝔪 (heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1))) ≠ 0 := by
      rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
    letI := Ideal.Quotient.field 𝔪
    obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective ((Ideal.Quotient.mk 𝔪 (heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1)))⁻¹)
    refine ⟨v, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, hv, inv_mul_cancel₀ hne, sub_self]
  have hle : (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp)) ≤ (𝔪 • (⊤ : Submodule HeckeAlg Q.Ψa)).comap Q.θ := by
    rw [← Submodule.map_le_iff_le_comap, Submodule.map_smul'']
    exact Submodule.smul_mono le_rfl le_top
  let θbar : (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) →ₗ[HeckeAlg] (Q.Ψa ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Ψa))) :=
    Submodule.mapQ _ _ Q.θ hle
  have hsurj : Function.Surjective θbar := by
    intro c
    obtain ⟨ψ, rfl⟩ := Submodule.mkQ_surjective _ c
    obtain ⟨x, hx⟩ := Q.hcoker ψ ℓ hℓS
    refine ⟨Submodule.Quotient.mk (v • x), ?_⟩
    show Submodule.Quotient.mk (Q.θ (v • x)) = Submodule.Quotient.mk ψ
    rw [map_smul, ← hx, ← mul_smul, eq_comm, Submodule.Quotient.eq]
    have h1 : ψ - (v * (heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1))) • ψ =
        -((v * (heckeGen ℓ - (((ℓ : ℕ) : HeckeAlg) + 1)) - 1) • ψ) := by
      rw [sub_smul, one_smul]
      abel
    rw [h1]
    exact Submodule.neg_mem _ (Submodule.smul_mem_smul hv Submodule.mem_top)
  letI := Ideal.Quotient.field 𝔪
  haveI : Finite (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) := Q.finite_Xp_quot 𝔪
  haveI : Module.Finite (HeckeAlg ⧸ 𝔪) (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) := Module.Finite.of_finite
  let θk : (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) →ₗ[HeckeAlg ⧸ 𝔪] (Q.Ψa ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Ψa))) :=
    { θbar.toAddMonoidHom with
      map_smul' := fun r x => by
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective r
        exact θbar.map_smul r x }
  have hsurj' : Function.Surjective θk := hsurj
  calc Module.finrank (HeckeAlg ⧸ 𝔪) (Q.Ψa ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Ψa)))
        = Module.finrank (HeckeAlg ⧸ 𝔪) ↥(LinearMap.range θk) := by
          rw [LinearMap.range_eq_top.2 hsurj', finrank_top]
    _ ≤ Module.finrank (HeckeAlg ⧸ 𝔪) (Q.Xp ⧸ (𝔪 • (⊤ : Submodule HeckeAlg Q.Xp))) := LinearMap.finrank_range_le θk

end CokernelHalf
