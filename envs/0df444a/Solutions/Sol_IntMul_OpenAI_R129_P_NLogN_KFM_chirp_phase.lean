  have := repSt_inv i n body s (fun k t => t = lI St s i N k)
    (by rw [hN, lI, h0]; simp)
    (by
      intro k hk ht
      rw [hN, Int.toNat_natCast] at hk
      rw [ht, (hb k hk).2, lI_step])
  rw [hN, Int.toNat_natCast] at this
  exact this

/-- **The invariant loop.** -/
theorem loopI_run (i : Fin HS) (n : Ex HS) (body : RS) (s : IState HS) (N : ℕ)
    (St : ℕ → IState HS) (hi56 : i.val < 56) (hn : n.Clean) (hnok : n.ok s) (hN : n.eval s = N)
    (hw : i ∉ body.writes) (h0 : St 0 = s) (hSi : (St N).G i = s.G i)
    (hb : ∀ k < N, body.ok (lI St s i N k) ∧
      body.run (lI St s i N k) = (St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i)) :
    (NLogN.RS.rep i n body).ok s ∧ (NLogN.RS.rep i n body).run s = St N := by
  have hinv := loopI_inv i n body s N St hN h0 hb
  refine ⟨⟨hi56, hn, hnok, by rw [hN]; positivity, hw, fun k hk => ?_⟩, ?_⟩
  · rw [hN, Int.toNat_natCast] at hk
    rw [hinv k hk.le]; exact (hb k hk).1
  · rw [run_rep i n body s hw (by rw [hN]; positivity), hN, Int.toNat_natCast, hinv N le_rfl, lI,
      IState.upd_upd_same, ← hSi, IState.upd_self]

/-- **Cost of the invariant loop.** -/
theorem loopI_cost (i : Fin HS) (n : Ex HS) (body : RS) (s : IState HS) (N : ℕ)
    (St : ℕ → IState HS) (hN : n.eval s = N) (h0 : St 0 = s)
    (hb : ∀ k < N, body.ok (lI St s i N k) ∧
      body.run (lI St s i N k) = (St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i))
    (B C : ℕ) (hB : zsz (N : ℤ) ≤ B) (hB1 : 1 ≤ B) (hnB : n.Bnd s B)
    (hbc : ∀ k < N, body.cost (lI St s i N k) ≤ C) :
    (NLogN.RS.rep i n body).cost s ≤ (n.size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
      N * (C + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) + 32 := by
  have hinv := loopI_inv i n body s N St hN h0 hb
  have := rep_cost_le i n body s B (C + 4 * 10 ^ 7 * (B + 2) ^ 2) hnB (by
    intro k hk
    rw [hN, Int.toNat_natCast] at hk
    rw [hinv k hk.le, (hb k hk).2]
    have h1 := hbc k hk
    set u := (St (k + 1)).upd i (.int ((N : ℤ) - k) :: s.G i) with hu
    have htop : u.top i = (N : ℤ) - k := IState.top_eq (L := s.G i) (by simp [hu])
    have hz : zsz ((N : ℤ) - k) ≤ B := le_trans (zsz_mono (by omega)) hB
    have hz1 : zsz ((N : ℤ) - k + -1) ≤ B := le_trans (zsz_mono (by omega)) hB
    have h2 := asgCost_le i (decE i) u B
      (by
        simp only [decE, Ex.Bnd, Ex.eval, htop]
        refine ⟨hz, ?_, hz1⟩
        rw [zsz_neg, zsz_one]; exact hB1)
      (by rw [htop]; exact hz)
    have : (decE i).size = 3 := rfl
    rw [this] at h2
    omega)
  rw [hN, Int.toNat_natCast] at this
  exact this

