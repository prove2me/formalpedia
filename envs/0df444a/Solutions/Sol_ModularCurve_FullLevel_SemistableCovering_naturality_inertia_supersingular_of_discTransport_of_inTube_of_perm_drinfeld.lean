private def _root_.AlgebraicCurve.RegularProlongation.semiQuotEquiv : (R.integers ⧸ RingHom.ker R.residue) ≃+* (R.integers ⧸ RingHom.ker R.residue) :=
  Ideal.quotientEquiv (RingHom.ker R.residue) (RingHom.ker R.residue) (R.semiIntegersEquiv g hg) (by
    apply le_antisymm
    · intro x hx
      have : x = R.semiIntegersEquiv g hg ((R.semiIntegersEquiv g hg).symm x) :=
        ((R.semiIntegersEquiv g hg).apply_symm_apply x).symm
      rw [this]
      exact Ideal.mem_map_of_mem _ ((R.mem_ker_residue_iff_of_semiEquiv g hg _).mp (by rw [← this]; exact hx))
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact (R.mem_ker_residue_iff_of_semiEquiv g hg x).mpr hx)

