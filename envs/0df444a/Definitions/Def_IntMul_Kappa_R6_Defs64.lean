-- Source module: Solutions.J6SegILCtl2
/-!
# B-line IL, B1 follow-up: building the control list, §2 one table entry

**Register convention of the control builder** (all below `56`, none `0`, none in `26–29`;
`lA lC lD = 34–36` are the `rptX` counters, empty in the managed state):

| stack | role |
|---|---|
| `bX = 44` | the source table `srcTab src argOf n'` (input, restored) |
| `bN' = 20`, `bN = 21` | `n'`, `n` (inputs, one value each, preserved) |
| `bSv = 25` | the consumed table entries (scratch, emptied by the restore) |
| `bCur = 30` | the input position (scratch) |
| `bT = 33` | the reversed control list being built (scratch, emptied by the transfer) |
| `bCd = 24`, `bA = 23`, `bW = 22`, `bD = 32` | scratch of one entry |
| `rC = 45`, `rNC = 38` | outputs: `flatC cs` pushed on `rC`, `|cs|` pushed on `rNC` |

Here: `loopMV` (a variable-cost `rptX` over managed states) and **`entry_runs`** (one table
entry: the commands of one output slab pushed reversed onto `bT`, the position updated, the entry
saved on `bSv`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

abbrev bX : Fin HS := 44
abbrev bN' : Fin HS := 20
abbrev bN : Fin HS := 21
abbrev bW : Fin HS := 22
abbrev bA : Fin HS := 23
abbrev bCd : Fin HS := 24
abbrev bSv : Fin HS := 25
abbrev bCur : Fin HS := 30
abbrev bD : Fin HS := 32
abbrev bT : Fin HS := 33

/-! ## List level: one step -/

/-- The commands of one output slab with source `o` from position `cur`. -/
def stO (o : Option ℕ) (a : ℤ) (cur : ℕ) : List (ℤ × ℤ) :=
  match o with
  | none => [(0, 0)]
  | some k => List.replicate (k - cur) J6Seg.dropC ++ [(1, a)]

/-- The position after it. -/
def kO (o : Option ℕ) (cur : ℕ) : ℕ :=
  match o with
  | none => cur
  | some k => k

/-! ## Managed-state helpers -/

/-! ## The managed state of the builder -/

/-- The builder's registers over `G`. -/
def cS (G : Fin HS → List ℤ) (X Sv Cur T Cd A D W : List ℤ) : Fin HS → List ℤ :=
  update (update (update (update (update (update (update (update G bX X) bSv Sv) bCur Cur) bT T) bCd Cd) bA A) bD D) bW W

section cs
variable (G : Fin HS → List ℤ) (X Sv Cur T Cd A D W : List ℤ) (v : List ℤ)
@[simp] theorem cS_X : cS G X Sv Cur T Cd A D W bX = X := by simp +decide [cS]
@[simp] theorem cS_Sv : cS G X Sv Cur T Cd A D W bSv = Sv := by simp +decide [cS]
@[simp] theorem cS_Cur : cS G X Sv Cur T Cd A D W bCur = Cur := by simp +decide [cS]
@[simp] theorem cS_T : cS G X Sv Cur T Cd A D W bT = T := by simp +decide [cS]
@[simp] theorem cS_Cd : cS G X Sv Cur T Cd A D W bCd = Cd := by simp +decide [cS]
@[simp] theorem cS_A : cS G X Sv Cur T Cd A D W bA = A := by simp +decide [cS]
@[simp] theorem cS_D : cS G X Sv Cur T Cd A D W bD = D := by simp +decide [cS]
@[simp] theorem cS_W : cS G X Sv Cur T Cd A D W bW = W := by simp +decide [cS]
@[simp] theorem cS_lA : cS G X Sv Cur T Cd A D W lA = G lA := by simp +decide [cS]
@[simp] theorem cS_lC : cS G X Sv Cur T Cd A D W lC = G lC := by simp +decide [cS]
@[simp] theorem cS_lD : cS G X Sv Cur T Cd A D W lD = G lD := by simp +decide [cS]
theorem cS_upd_X : update (cS G X Sv Cur T Cd A D W) bX v = cS G v Sv Cur T Cd A D W := by
  funext x; by_cases hx : x = bX
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_Sv : update (cS G X Sv Cur T Cd A D W) bSv v = cS G X v Cur T Cd A D W := by
  funext x; by_cases hx : x = bSv
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_Cur : update (cS G X Sv Cur T Cd A D W) bCur v = cS G X Sv v T Cd A D W := by
  funext x; by_cases hx : x = bCur
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_T : update (cS G X Sv Cur T Cd A D W) bT v = cS G X Sv Cur v Cd A D W := by
  funext x; by_cases hx : x = bT
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_Cd : update (cS G X Sv Cur T Cd A D W) bCd v = cS G X Sv Cur T v A D W := by
  funext x; by_cases hx : x = bCd
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_A : update (cS G X Sv Cur T Cd A D W) bA v = cS G X Sv Cur T Cd v D W := by
  funext x; by_cases hx : x = bA
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_D : update (cS G X Sv Cur T Cd A D W) bD v = cS G X Sv Cur T Cd A v W := by
  funext x; by_cases hx : x = bD
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
theorem cS_upd_W : update (cS G X Sv Cur T Cd A D W) bW v = cS G X Sv Cur T Cd A D v := by
  funext x; by_cases hx : x = bW
  · subst hx; simp +decide [cS]
  · simp [cS, update_apply, hx]
end cs

/-! ## One entry -/

section entry
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- One drop command, pushed reversed. -/
def dropE : IStmt HS P := .seq (.op (.const bT (-1))) (.op (.const bT 0))

/-- The `none` branch: the zero command. -/
def zB : IStmt HS P := .seq (.op (.const bT 0)) (.op (.const bT 0))

/-- The `some k` branch: `k - cur` drops, the emit command, the new position `k`. -/
def eB : IStmt HS P :=
  .seq (.op (.dup bCd bW)) (.seq (.op (.dup bCur bD)) (.seq (.op (.neg bD)) (.seq
    (.op (.add bW bD bD)) (.seq (rptX bD lA lC lD dropE) (.seq (.op (.drop bD)) (.seq
    (.op (.const bT 1)) (.seq (.op (.dup bA bT)) (.seq (.op (.drop bCur))
    (.op (.dup bCd bCur))))))))))

/-- **One table entry.** -/
def entP : IStmt HS P :=
  .seq (.op (.mv bX bCd)) (.seq (.op (.mv bX bA)) (.seq
    (.ite bCd (fun c => c == .neg) zB eB) (.seq (.op (.mv bCd bSv)) (.op (.mv bA bSv)))))

/-- The cost bound of one entry with `d` drops. -/
def cEnt (Z d : ℕ) : ℕ := 21 * cU Z + 4000 * (d + 1)

end entry

end J6Seg.Slab

