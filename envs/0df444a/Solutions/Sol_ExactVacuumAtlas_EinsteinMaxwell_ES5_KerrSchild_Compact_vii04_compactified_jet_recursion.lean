set_option autoImplicit false
open Polynomial

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.FiniteJet

/-- Undivided certificate written directly in the coefficients of the polynomial Γ. -/
theorem gammaJet_certificate (M h J Q c : ℝ) :
    ((32 : ℝ) / 15) * J ^ 3 * Q ^ 5 =
      certP6 M h J Q c * (gammaJet M h J Q c).coeff 6
        + certP7 M h J Q c * (gammaJet M h J Q c).coeff 7
        - Q * M ^ 3 * (gammaJet M h J Q c).coeff 8 := by
  rw [gammaJet_coeff_six, gammaJet_coeff_seven, gammaJet_coeff_eight]
  have hid := elimination_identity M h J Q c
  unfold elimA at hid
  unfold certP6 certP7
  linear_combination hid

/-- The three Γ coefficients vanish iff the three G coefficients `C6 C7 C8` vanish
(triangular relation, no division). -/
theorem gammaJet_coeffs_zero_iff (M h J Q c : ℝ) :
    ((gammaJet M h J Q c).coeff 6 = 0 ∧ (gammaJet M h J Q c).coeff 7 = 0 ∧
        (gammaJet M h J Q c).coeff 8 = 0) ↔
      (C6 M h J Q c = 0 ∧ C7 M h J Q c = 0 ∧ C8 M h J Q c = 0) := by
  rw [gammaJet_coeff_six, gammaJet_coeff_seven, gammaJet_coeff_eight]
  constructor
  · rintro ⟨h6, h7, h8⟩
    have h7' : C7 M h J Q c = 0 := by rw [h6] at h7; linarith
    refine ⟨h6, h7', ?_⟩
    rw [h6, h7'] at h8; linarith
  · rintro ⟨h6, h7, h8⟩
    rw [h6, h7, h8]; norm_num

/-- Obstruction for the actual polynomial Γ. -/
theorem gammaJet_obstruction (M h J Q c : ℝ)
    (h6 : (gammaJet M h J Q c).coeff 6 = 0) (h7 : (gammaJet M h J Q c).coeff 7 = 0)
    (h8 : (gammaJet M h J Q c).coeff 8 = 0) : J ^ 3 * Q ^ 5 = 0 := by
  have hc := gammaJet_certificate M h J Q c
  rw [h6, h7, h8] at hc
  linear_combination ((15 : ℝ) / 32) * hc

theorem gammaJet_zero_branch (M h J Q c : ℝ)
    (h6 : (gammaJet M h J Q c).coeff 6 = 0) (h7 : (gammaJet M h J Q c).coeff 7 = 0)
    (h8 : (gammaJet M h J Q c).coeff 8 = 0) : J = 0 ∨ Q = 0 := by
