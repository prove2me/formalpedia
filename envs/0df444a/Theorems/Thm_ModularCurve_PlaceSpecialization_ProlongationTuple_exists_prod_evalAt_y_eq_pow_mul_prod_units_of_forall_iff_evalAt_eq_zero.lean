            ∏ᶠ (Q : PrimeSpectrum (UVCrossingModel W (π ^ E)))
              (_ : Q.asIdeal ∈ (Ideal.map (ι.toRingHom.comp (algebraMap ↥(R.nodeIntegersOver K w)
