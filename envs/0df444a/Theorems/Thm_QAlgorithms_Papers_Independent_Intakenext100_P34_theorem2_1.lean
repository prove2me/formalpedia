-- title:
--   The two presentations of the degenerate affine braid algebra
-- statement:
--   Let $C$ be a commutative unital ring with $2$ invertible, and $k\ge1$. Let $B_k$ be the algebra presented in (2.1)–(2.5). There is a $C$-algebra isomorphism from $B_k$ to the algebra generated by $t_w$ ($w\in S_k$), $\kappa_0,\ldots,\kappa_k$ and $\gamma_{i,j}$ for distinct $i,j\in\{0,\ldots,k\}$. Here permutations fix $0$. Its relations are
--   $$
--   t_ut_v=t_{uv},\quad t_w\kappa_it_{w^{-1}}=\kappa_{w(i)},\quad
--   t_w\gamma_{i,j}t_{w^{-1}}=\gamma_{w(i),w(j)},
--   $$
--   $$
--   [\kappa_i,\kappa_j]=[\kappa_i,\gamma_{\ell,m}]=0,\quad
--   \gamma_{i,j}=\gamma_{j,i},\quad
--   [\gamma_{p,r},\gamma_{\ell,m}]=0\quad(\{p,r\}\cap\{\ell,m\}=\varnothing),
--   $$
--   $$
--   [\gamma_{i,j},\gamma_{i,r}+\gamma_{j,r}]=0\quad(i,j,r\text{ pairwise distinct}).
--   $$
--   The isomorphism preserves $t_w,\kappa_0,\kappa_1$ and sends
--   $$
--   y_j\longmapsto\tfrac12\kappa_j+\sum_{0\le\ell<j}\gamma_{\ell,j}.
--   $$
--   Its inverse sends $\gamma_{0,1}$ to $y_1-\kappa_1/2$ and $\gamma_{j,j+1}$ to $y_{j+1}-t_{s_j}y_jt_{s_j}$. All remaining positive-index kappas, $\gamma_{0,m}$ and $\gamma_{i,j}$ are sent to the conjugates specified by (2.15), for every permutation with the stated endpoint images.
--
--   This identifies the two actual presentations, without specializing any kappa generator to a scalar.
-- source:
--   Affine and degenerate affine BMW algebras: The center, arXiv:1105.4207v2, PDF p. 4, Theorem 2.1

import Definitions.Def_QAlgorithms_Papers_Independent_Intakenext100_P34

namespace QAlgorithms.Papers.Independent.Intakenext100.P34

open QAlgorithms.Papers.Independent.Support21.P08 (Central)

noncomputable section

universe u

variable (C : Type u) [CommRing C]

/-- Theorem 2.1, PDF pp.4--6: an algebra isomorphism between the two
actual presentations, with the generator formulas (2.13)--(2.16).
The explicit unit whose value is 2 is the proof-used implicit hypothesis. -/
theorem theorem2_1 (k : ℕ) (hk : 0 < k) (two : Cˣ) (htwo : (two : C) = 2) :
    let first : Fin k := ⟨0,hk⟩
    ∃ e : DBraid C k ≃ₐ[C] GBraid C k,
      (∀ w, e (dbMap C k (dt C w)) = gbMap C k (gt C w)) ∧
      e (dbMap C k (dk C false)) = gbMap C k (gk C none) ∧
      e (dbMap C k (dk C true)) = gbMap C k (gk C (some first)) ∧
      (∀ j, e (dbMap C k (dy C j)) = gbMap C k (gY C k (↑two⁻¹ : C) j)) ∧
      e.symm (gbMap C k (gg C none (some first))) =
        dbMap C k (dy C first-algebraMap C (DFree C k) (↑two⁻¹ : C)*dk C true) ∧
      (∀ i : Adj k, e.symm (gbMap C k (gg C (some (adjacentLeft i)) (some (adjacentRight i)))) =
        dbMap C k (dg C i)) ∧
      (∀ (w : Equiv.Perm (Fin k)) (j : Fin k), w first = j →
        e.symm (gbMap C k (gk C (some j))) = dbMap C k (dt C w*dk C true*dt C w⁻¹) ∧
        e.symm (gbMap C k (gg C none (some j))) =
          dbMap C k (dt C w*(dy C first-algebraMap C (DFree C k) (↑two⁻¹ : C)*dk C true)*dt C w⁻¹)) ∧
      (∀ (i : Adj k) (w : Equiv.Perm (Fin k)) (a b : Fin k), i.val = 0 →
        w (adjacentLeft i) = a → w (adjacentRight i) = b →
        e.symm (gbMap C k (gg C (some a) (some b))) =
          dbMap C k (dt C w*dg C i*dt C w⁻¹)) := by sorry

end

end QAlgorithms.Papers.Independent.Intakenext100.P34
