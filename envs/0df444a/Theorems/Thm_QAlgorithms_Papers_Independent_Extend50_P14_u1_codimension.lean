-- title:
--   Exact U(1) qubit codimension
-- statement:
--   Let 2≤k≤n and let h_k be the real Lie algebra generated by k-local skew-Hermitian operators on n qubits commuting with total Z. The full invariant algebra is h_n. Then
--
--   $$\dim_{\mathbb R}h_n-\dim_{\mathbb R}h_k=n-k.$$
--
--   These are also the dimensions of the associated connected matrix groups. The locality range is inherited from Theorem 9.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 3, II.B / IV.C / Eq.(C8): exact U(1)-qubit codimension

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

/-- PDF p.24, C8: the k≥2 range is inherited from Theorem 9. All dimensions
are real; subtraction is in ℤ rather than truncated natural subtraction. -/
theorem u1_codimension (n k : ℕ) (hk : 2 ≤ k) (hkn : k ≤ n) :
    (Module.finrank ℝ (u1Lie n n) : ℤ) - (Module.finrank ℝ (u1Lie n k) : ℤ) =
      (n : ℤ) - (k : ℤ) := by sorry

end QAlgorithms.Papers.Independent.Extend50.P14

end
