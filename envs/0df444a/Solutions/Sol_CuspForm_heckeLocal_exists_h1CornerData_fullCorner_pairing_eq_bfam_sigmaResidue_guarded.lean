    rw [ModularCurve.Period.mem_parabolicHoms_iff] at h2 ⊢
    convert h2 using 2
    rw [← Nat.cast_smul_eq_nsmul 𝒪 (ℓ + 1) v, Nat.cast_add, Nat.cast_one]
  have hneb : ∀ d : (ZMod (N * r))ˣ, ∃ g : ↥(CohCarrier.hdataSub (N * r) H₀ (↑S : Set ℕ) 𝒪 (ResidueField 𝒪) Subtype.val hcomm θbar).opSubalgebra, (∀ v : H1 (N * r) H₀ 𝒪, g • v = diamondL (N * r) H₀ 𝒪 d v) ∧ g - 1 ∈ Sp.𝔪 i := by
    intro d
    have hPd : (∀ (q : ℕ) (hq : q.Prime) (hqL : q ∣ N * r), (CohCarrier.Gen.dia d : CohCarrier.Gen (N * r) (↑S : Set ℕ)) = CohCarrier.Gen.U q hq hqL → q ∣ N) :=
