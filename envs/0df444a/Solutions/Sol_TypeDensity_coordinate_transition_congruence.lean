theorem solution (O R : Type) [CommRing O] [CommRing R] [Algebra O R]
    (n : ℕ) (pi : O) (b : Fin n → R)
    [IsAdicComplete (Ideal.span {pi}) ((Fin n → O) × R)] (c : Fin n → R)
    (F : R ≃ₗ[O] ((Fin n → O) × R)) (h0 : R) (j : ℕ) (z w : Fin n → O)
    (hzw : TypeDensity.adicCongr (Ideal.span {pi}) j z w) :
    TypeDensity.adicCongr (Ideal.span {pi}) j (TypeDensity.idealTransition pi b c F h0 z)
      (TypeDensity.idealTransition pi b c F h0 w) := by
  let L : (Fin n → O) →ₗ[O] R :=
    { toFun := fun z => TypeDensity.coordinateLift b z
      map_add' := by
        intro x y
        simp [TypeDensity.coordinateLift, add_smul, Finset.sum_add_distrib]
      map_smul' := by
        intro r x
        simp [TypeDensity.coordinateLift, Finset.smul_sum, smul_smul] }
  have h1 := TypeDensity.linear_map_preserves_adic_congruence O _ _ (Ideal.span {pi}) L j z w hzw
  have h2 : TypeDensity.adicCongr (Ideal.span {pi}) j (h0 + TypeDensity.coordinateLift b z) (h0 + TypeDensity.coordinateLift b w) := by
    unfold TypeDensity.adicCongr at h1 ⊢
    have : h0 + TypeDensity.coordinateLift b z - (h0 + TypeDensity.coordinateLift b w) = L z - L w := by
      simp only [add_sub_add_left_eq_sub]; rfl
    rw [this]; exact h1
  have h3 := TypeDensity.normalizer_preserves_adic_congruence O R n pi c F j _ _ h2
  exact TypeDensity.linear_map_preserves_adic_congruence O _ _ (Ideal.span {pi})
    (LinearMap.fst O (Fin n → O) R) j _ _ h3
