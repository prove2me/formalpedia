    have hr : y 1 ≠ 0 := domRN_r hy
    have h1 : HasDerivAt (fun ε : ℝ => M + ε * m) m 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).mul_const m).const_add M
    have hq : HasDerivAt (fun ε : ℝ => Q + ε * q) q 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).mul_const q).const_add Q
    have h2 : HasDerivAt (fun ε : ℝ => (Q + ε * q) ^ 2) (2 * Q * q) 0 :=
      (hq.pow 2).congr_deriv (by norm_num)
    have h00 : HasDerivAt (fun ε : ℝ => -(1 - 2 * (M + ε * m) / y 1 + (Q + ε * q) ^ 2 / y 1 ^ 2))
        (2 * m / y 1 - 2 * Q * q / y 1 ^ 2) 0 := by
      refine ((((hasDerivAt_const (0 : ℝ) (1 : ℝ)).sub ((h1.const_mul 2).div_const (y 1))).add
        (h2.div_const (y 1 ^ 2))).neg).congr_deriv ?_
      ring
    fin_cases i <;> fin_cases j
    all_goals first
      | exact h00
      | exact hasDerivAt_const (0 : ℝ) _
  field y hy i j := by
    have h1 : HasDerivAt (fun ε : ℝ => Q + ε * q) q 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).mul_const q).const_add Q
    have h01 : HasDerivAt (fun ε : ℝ => -(Q + ε * q) / y 1 ^ 2) (-q / y 1 ^ 2) 0 := h1.neg.div_const _
    have h10 : HasDerivAt (fun ε : ℝ => (Q + ε * q) / y 1 ^ 2) (q / y 1 ^ 2) 0 := h1.div_const _
    fin_cases i <;> fin_cases j
    all_goals first
      | exact h01
      | exact h10
      | exact hasDerivAt_const (0 : ℝ) _

