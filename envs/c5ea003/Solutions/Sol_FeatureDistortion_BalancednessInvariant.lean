    {t : ℝ} (ht : 0 ≤ t) : f t = f 0 := by
  apply (convex_Ici (0 : ℝ)).is_const_of_fderivWithin_eq_zero
    (fun s hs ↦ (hf s hs).differentiableWithinAt) _ ht (by simp)
  intro s hs
  simpa using (hf s hs).hasFDerivWithinAt.fderivWithin (uniqueDiffOn_Ici 0 s hs)

lemma frozen_features_hasDerivWithinAt_zero {n d k : ℕ}
    {X : Vec d →L[ℝ] Vec n} {Y : Vec n} {v₀ : Vec k} {B₀ : Features d k}
    {γ : Trajectory d k} (hγ : IsFineTuningFlow X Y v₀ B₀ γ)
    {x : Vec d} (hx : x ∈ (rowSpace X)ᗮ) {t : ℝ} (ht : 0 ≤ t) :
    HasDerivWithinAt (fun s ↦ γ.features s x) 0 (Ici 0) t := by
  have hz : inner ℝ (X.adjoint (residual X Y (γ.head t) (γ.features t))) x = 0 :=
    Submodule.inner_right_of_mem_orthogonal
      (show X.adjoint (residual X Y (γ.head t) (γ.features t)) ∈ rowSpace X from
        ⟨_, rfl⟩) hx
  simpa [featureGradient, hz] using
    (hγ.2.2 t ht).2.clm_apply (hasDerivWithinAt_const t (Ici 0) x)

