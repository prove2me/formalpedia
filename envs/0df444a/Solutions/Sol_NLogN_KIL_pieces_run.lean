/-- **Counted loop with an item-language body and iteration-dependent costs.** -/
theorem IRuns.irepF {C : Fin HS} {n : Ex HS} {body : IStmt HS Pp} {s : IState HS}
    {F : ℕ → Fin HS → List ℤ} {N B : ℕ} (c : ℕ → ℕ) (hB1 : 1 ≤ B) (hC5 : C.val < 56)
    (hC : ∀ k, F k C = [])
    (hnc : n.Clean) (hno : n.ok (encK s (F 0))) (hnl : n.Lin) (hnb : n.Bnd (encK s (F 0)) B)
    (hn : n.eval (encK s (F 0)) = N)
    (hb : ∀ k < N, IRuns I iprog body (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (c k)) :
    IRuns I iprog (NLogN.KIL.irep C n body) (encK s (F 0)) (encK s (F N))
      ((n.size + 1) * 2000 * (B + 2) + ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) +
        (2 * B + 32)) := by
  have hzN : zsz (N : ℤ) ≤ B := by rw [← hn]; exact Ex.zsz_eval_le _ B n hnb
  have hz : ∀ k ≤ N, zsz ((N : ℤ) - k) ≤ B := fun k hk => by
    have : ((N : ℤ) - k) = ((N - k : ℕ) : ℤ) := by push_cast [Nat.cast_sub hk]; ring
    rw [this]; exact le_trans (NLogN.KIL.zsz_nat_le (Nat.sub_le _ _)) hzN
  have S1 := Sp.push s (F 0) (i := C) (e := n) (B := B) hC5 hnc hno hnl hnb
  rw [hn, hC 0] at S1
  set ss : ℕ → IState HS := fun k => encK s (Function.update (F k) C [(N : ℤ) - k])
  have hss0 : encK s (Function.update (F 0) C [(N : ℤ)]) = ss 0 := by simp [ss]
  rw [hss0] at S1
  have hcl : ∀ k, (ss k).cl C = if (N : ℤ) - k = 0 then Cls.zero else
      if (N : ℤ) - k < 0 then Cls.neg else Cls.pos := fun k =>
    cl_int (ss k) C _ (s.G C) (by simp [ss, ints])
  have hstep : ∀ k < N, IRuns I iprog (.seq body (RS.asg C (decE C)).code) (ss k) (ss (k + 1))
      (c k + (decE C).size.succ * 2000 * (B + 2)) := by
    intro k hk
    have h1 := hb k hk
    have htop : (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])).top C = (N : ℤ) - k :=
      top_encK (l := []) (by simp)
    have h2 := Sp.asg s (Function.update (F (k + 1)) C [(N : ℤ) - k]) (i := C) (e := decE C)
      (a := (N : ℤ) - k) (l := []) (B := B) hC5 (by simp) (hz k hk.le)
      (by intro j hj; simp only [decE, Ex.regs, List.append_nil] at hj; exact clean_of_lt hC5 j hj)
      (by simp only [decE, Ex.ok, and_true]; exact ok_reg (a := (N : ℤ) - k) (l := []) (by simp))
      ⟨trivial, trivial⟩
      (by
        simp only [decE, Ex.Bnd, Ex.eval, htop]
        refine ⟨hz k hk.le, by rw [zsz_neg_one']; exact hB1, ?_⟩
        have : (N : ℤ) - k + -1 = (N : ℤ) - (k + 1 : ℕ) := by push_cast; ring
        rw [this]; exact hz (k + 1) hk)
    have e2 : (decE C).eval (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) =
        (N : ℤ) - (k + 1 : ℕ) := by
      simp only [decE, Ex.eval, htop]; push_cast; ring
    rw [e2, Function.update_idem] at h2
    exact (h1.seq h2.toIRuns).mono (by simp [Nat.succ_eq_add_one])
  have L := IRuns.loop (I := I) (iprog := iprog) (i := C) (f := fun c => c != .zero)
    (p := .seq body (RS.asg C (decE C)).code) ss
    (fun k => c k + (decE C).size.succ * 2000 * (B + 2)) N
    (fun k hk => by rw [hcl k]; have : (N : ℤ) - k ≠ 0 := by omega
                    simp only [this, if_false]; split_ifs <;> rfl)
    (by rw [hcl N]; simp)
    hstep
  have S3 := Sp.pop s (Function.update (F N) C [(N : ℤ) - N]) (i := C) (a := (N : ℤ) - N) (l := [])
    (B := B) hC5 (by simp) (by simp [zsz_zero])
  rw [Function.update_idem, show Function.update (F N) C [] = F N by
    rw [← hC N, Function.update_eq_self]] at S3
  refine (S1.toIRuns.seq (L.seq S3.toIRuns)).mono ?_
  have hdec : (decE C).size.succ * 2000 * (B + 2) ≤ 8000 * (B + 2) := by
    simp only [decE, Ex.size]; omega
  have hsum : ∑ k ∈ Finset.range N, (c k + (decE C).size.succ * 2000 * (B + 2) + 30) ≤
      ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) :=
    Finset.sum_le_sum fun k _ => by omega
  generalize ∑ k ∈ Finset.range N, (c k + (decE C).size.succ * 2000 * (B + 2) + 30) = X1 at hsum ⊢
  generalize ∑ k ∈ Finset.range N, (c k + 8000 * (B + 2) + 30) = X2 at hsum ⊢
  generalize (n.size + 1) * 2000 * (B + 2) = X3
  omega

