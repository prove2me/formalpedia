theorem Subgroup.relIndex_map_map_of_ker_inf_le {G G' : Type} [Group G] [Group G'] (f : G →* G')
    (A B : Subgroup G) (hAB : A ≤ B) (hker : f.ker ⊓ B ≤ A) :
    (A.map f).relIndex (B.map f) = A.relIndex B := by
  rw [← Subgroup.relIndex_comap, Subgroup.comap_map_eq, ← Subgroup.inf_relIndex_right (A ⊔ f.ker) B,
    ← Subgroup.inf_relIndex_right A B]
  congr 1
  apply le_antisymm
  · rintro x ⟨hx, hxB⟩
    have hx' : x ∈ ((A ⊔ f.ker : Subgroup G) : Set G) := hx
    rw [Subgroup.mul_normal] at hx'
    obtain ⟨a, ha, z, hz, rfl⟩ := hx'
    refine ⟨?_, hxB⟩
    have hzB : z ∈ B := by
      have : a⁻¹ * (a * z) ∈ B := B.mul_mem (B.inv_mem (hAB ha)) hxB
      simpa using this
    exact A.mul_mem ha (hker ⟨hz, hzB⟩)
  · exact inf_le_inf_right _ le_sup_left

