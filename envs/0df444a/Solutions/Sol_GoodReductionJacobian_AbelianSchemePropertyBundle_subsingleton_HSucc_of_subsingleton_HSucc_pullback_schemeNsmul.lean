variable {R : Type u} [CommRing R] {V : Scheme.{u}} {π : V ⟶ Spec (.of R)}

section Functoriality

variable [IsSeparated π] (K : V.OrderedAffineCover) {F G H : OModulePresheaf π}

theorem HSuccMap_comp_apply (ψ : AffHom G H) (φ : AffHom F G) (i : ℕ) (x : F.HSucc K i) :
    (ψ.comp φ).HSuccMap K i x = ψ.HSuccMap K i (φ.HSuccMap K i x) := by
  induction x using Submodule.Quotient.induction_on with
  | H x =>
    rw [AffHom.HSuccMap_mk, AffHom.HSuccMap_mk, AffHom.HSuccMap_mk]
    rfl

theorem HSuccMap_eq_self_of_forall_app (φ : AffHom F F) (hφ : ∀ (U : V.affineOpens) (x : F.obj U.1), φ.app U x = x)
    (i : ℕ) (x : F.HSucc K i) : φ.HSuccMap K i x = x := by
  induction x using Submodule.Quotient.induction_on with
  | H x =>
    rw [AffHom.HSuccMap_mk]
    congr 1
    apply Subtype.ext
    funext s
    exact hφ _ _

theorem HSuccMap_injective_of_leftInverse (φ : AffHom F G) (ψ : AffHom G F)
    (h : ∀ (U : V.affineOpens) (x : F.obj U.1), ψ.app U (φ.app U x) = x) (i : ℕ) :
    Function.Injective (φ.HSuccMap K i) := by
  intro x y hxy
  have hx := HSuccMap_eq_self_of_forall_app K (ψ.comp φ) (fun U z => h U z) i x
  have hy := HSuccMap_eq_self_of_forall_app K (ψ.comp φ) (fun U z => h U z) i y
  rw [HSuccMap_comp_apply] at hx hy
  rw [← hx, ← hy, hxy]

end Functoriality

section Twist

variable {F G : OModulePresheaf π} (L : V.Modules)

def twistMap (φ : AffHom F G) : AffHom (F.twist L) (G.twist L) where
  app U :=
    { toFun := fun t => TensorProduct.map (φ.appSections U) LinearMap.id t
      map_add' := fun s t => map_add _ s t
      map_smul' := fun r t =>
        (TensorProduct.map (φ.appSections U) LinearMap.id).map_smul
          ((Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r) t }
  app_smul U a t := LinearMap.map_smul (TensorProduct.map (φ.appSections U) LinearMap.id) a t
  naturality {U U'} h := by
    refine LinearMap.ext fun t => ?_
    show TensorProduct.map (φ.appSections U) LinearMap.id (F.tensorResₛₗ (ofModules π L) h t) =
      G.tensorResₛₗ (ofModules π L) h (TensorProduct.map (φ.appSections U') LinearMap.id t)
    induction t using TensorProduct.induction_on with
    | zero => simp only [map_zero]
    | tmul x y =>
      rw [tensorResₛₗ_tmul, TensorProduct.map_tmul, TensorProduct.map_tmul, tensorResₛₗ_tmul]
      simp only [AffHom.appSections_apply, LinearMap.id_apply]
      rw [φ.naturality_apply h x]
    | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, map_add]

theorem twistMap_tmul (φ : AffHom F G) (U : V.affineOpens) (x : F.obj U.1) (y : Γ(L, U.1)) :
    (twistMap L φ).app U (show (F.twist L).obj U.1 from x ⊗ₜ[Γ(V, U.1)] (show (ofModules π L).obj U.1 from y)) =
      (show (G.twist L).obj U.1 from φ.app U x ⊗ₜ[Γ(V, U.1)] (show (ofModules π L).obj U.1 from y)) := rfl

end Twist

section UnitCounit

variable (π) {W : Scheme.{u}} (γ : W ⟶ V) (M : V.Modules)

def pfOne (U : V.Opens) : (pushforwardUnit π γ).obj U :=
  show Γ(W, γ ⁻¹ᵁ U) from 1

theorem pfOne_res {U U' : V.Opens} (h : U ≤ U') : (pushforwardUnit π γ).res h (pfOne π γ U') = pfOne π γ U :=
  map_one (W.presheaf.map (homOfLE ((TopologicalSpace.Opens.map γ.base).monotone h)).op).hom

def unitTwist : AffHom (ofModules π M) ((pushforwardUnit π γ).twist M) where
  app U :=
    { toFun := fun x => (show ((pushforwardUnit π γ).twist M).obj U.1 from pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] x)
      map_add' := fun x y => TensorProduct.tmul_add _ x y
      map_smul' := fun r x => by
        show pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] ((Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r • x) =
          (Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r • (pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] x)
        rw [TensorProduct.tmul_smul] }
  app_smul U a x := by
    show pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] (a • x) = a • (pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] x)
    rw [TensorProduct.tmul_smul]
  naturality {U U'} h := by
    refine LinearMap.ext fun x => ?_
    show pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] ((ofModules π M).res h x) =
      (pushforwardUnit π γ).tensorResₛₗ (ofModules π M) h (pfOne π γ U'.1 ⊗ₜ[Γ(V, U'.1)] x)
    rw [tensorResₛₗ_tmul, pfOne_res]

theorem unitTwist_app (U : V.affineOpens) (x : (ofModules π M).obj U.1) :
    (unitTwist π γ M).app U x =
      (show ((pushforwardUnit π γ).twist M).obj U.1 from pfOne π γ U.1 ⊗ₜ[Γ(V, U.1)] x) := rfl

def counitLin (U : V.Opens) :
    (OModulePresheaf.unit π).obj U ⊗[Γ(V, U)] (ofModules π M).obj U →ₗ[Γ(V, U)] (ofModules π M).obj U :=
  TensorProduct.lift (LinearMap.lsmul Γ(V, U) ((ofModules π M).obj U))

theorem counitLin_tmul (U : V.Opens) (a : (OModulePresheaf.unit π).obj U) (x : (ofModules π M).obj U) :
    counitLin π M U (a ⊗ₜ[Γ(V, U)] x) = (show Γ(V, U) from a) • x :=
  TensorProduct.lift.tmul _ _

def counitTwist : AffHom ((OModulePresheaf.unit π).twist M) (ofModules π M) where
  app U :=
    { toFun := fun t => counitLin π M U.1 t
      map_add' := fun s t => map_add _ s t
      map_smul' := fun r t => (counitLin π M U.1).map_smul
          ((Scheme.TwoAffineOpenCover.algebraOfHom π U.1).algebraMap r) t }
  app_smul U a t := (counitLin π M U.1).map_smul a t
  naturality {U U'} h := by
    refine LinearMap.ext fun t => ?_
    show counitLin π M U.1 ((OModulePresheaf.unit π).tensorResₛₗ (ofModules π M) h t) =
      (ofModules π M).res h (counitLin π M U'.1 t)
    induction t using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]; exact (map_zero _).symm
    | tmul a x =>
      rw [tensorResₛₗ_tmul, counitLin_tmul, counitLin_tmul]
      exact ((ofModules π M).res_smul h _ _).symm
    | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, map_add]

theorem counitTwist_app_tmul (U : V.affineOpens) (a : (OModulePresheaf.unit π).obj U.1) (x : (ofModules π M).obj U.1) :
    (counitTwist π M).app U (show ((OModulePresheaf.unit π).twist M).obj U.1 from a ⊗ₜ[Γ(V, U.1)] x) =
      (show Γ(V, U.1) from a) • x :=
  counitLin_tmul π M U.1 a x

end UnitCounit

