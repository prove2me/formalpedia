section Piece_ArA6c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA6c: the power-series solution of the coefficient system

Let `ŷ ∈ K[[x₀, …, x_n]]^N` solve `hs`, and let `finSuccEquiv ((g)(ŷ)) = P·U` be a Weierstrass factorization with
`(g)(ŷ)(0) = 0`. Dividing `ŷ_i` by `P⁴` gives remainders `R_i`; the coefficients of `P` and the `R_i` solve
`eqsys (theta1 K n) hs g d` over `K[[x']]` (`aSide_solution`), with the residues needed later: the lower coefficients
of `P` have constant term `0`, `R_i(0) = ŷ_i(0)`, and `V = g(R) /ₘ P` has `V(0) ≠ 0`.
-/

set_option autoImplicit false

open Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

/-- Evaluations at congruent points are congruent. -/
theorem aeval_sub_mem_span {E S : Type*} [CommRing E] [CommRing S] [Algebra E S] {N : ℕ} (y y' : Fin N → S) (q : S)
    (hy : ∀ i, y i - y' i ∈ Ideal.span {q}) (p : MvPolynomial (Fin N) E) :
    MvPolynomial.aeval y p - MvPolynomial.aeval y' p ∈ Ideal.span {q} := by
  have h := eval_add_sub_mem (MvPolynomial.map (algebraMap E S) p) y' (y - y')
  have hy' : y' + (y - y') = y := by
    funext i
    simp
  rw [hy', MvPolynomial.eval_map, MvPolynomial.eval_map, ← MvPolynomial.aeval_def, ← MvPolynomial.aeval_def] at h
  refine Ideal.span_le.mpr ?_ h
  rintro _ ⟨i, rfl⟩
  exact hy i

variable {K : Type*} [Field K]

/-- **The power-series solution of the coefficient system.** -/
theorem aSide_solution {n N r : ℕ} (hs : Fin r → MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K))
    (g : MvPolynomial (Fin N) (MvPolynomial (Fin (n + 1)) K)) (ŷ : Fin N → MvPowerSeries (Fin (n + 1)) K)
    (hh : ∀ j, MvPolynomial.aeval ŷ (hs j) = 0) (hg0 : MvPowerSeries.constantCoeff (MvPolynomial.aeval ŷ g) = 0)
    {P : Polynomial (MvPowerSeries (Fin n) K)} {U : PowerSeries (MvPowerSeries (Fin n) K)}
    (hPU : (MvPowerSeries.finSuccEquiv K n (MvPolynomial.aeval ŷ g)).IsWeierstrassFactorization P U) :
    0 < P.natDegree ∧ ∃ z : Unk P.natDegree N (4 * P.natDegree) → MvPowerSeries (Fin n) K,
      (∀ e, MvPolynomial.aeval z (eqsys (theta1 K n) hs g P.natDegree e) = 0) ∧
      (∀ l, MvPowerSeries.constantCoeff (z (Sum.inl l)) = 0) ∧
      (∀ i (k : Fin (4 * P.natDegree)), (k : ℕ) = 0 →
        MvPowerSeries.constantCoeff (z (Sum.inr (i, k))) = MvPowerSeries.constantCoeff (ŷ i)) ∧
      MvPowerSeries.constantCoeff ((evS (theta1 K n) _ g (Rz z) /ₘ Pz z).coeff 0) ≠ 0 := by
  classical
  haveI : IsDomain (MvPowerSeries (Fin n) K) := NoZeroDivisors.to_isDomain _
  have hP := hPU.isDistinguishedAt
  have hmon := hP.monic
  have hI : IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal _).ne_top
  have hsPU := hPU.eq_mul
  have hd : 0 < P.natDegree := by
    by_contra h0
    have hP1 : P = 1 := hmon.degree_le_zero_iff_eq_one.mp (natDegree_eq_zero_iff_degree_le_zero.mp (by omega))
    have hu : IsUnit (MvPowerSeries.finSuccEquiv K n (MvPolynomial.aeval ŷ g)) := by
      rw [hsPU, hP1, Polynomial.coe_one, one_mul]
      exact hPU.isUnit
    have h1 := MvPowerSeries.isUnit_iff_constantCoeff.mp (PowerSeries.isUnit_iff_constantCoeff.mp hu)
    rw [cc_cc_finSuccEquiv, hg0] at h1
    exact not_isUnit_zero h1
  have hP0c : MvPowerSeries.constantCoeff (P.coeff 0) = 0 := constantCoeff_eq_zero_of_mem (hP.mem hd)
  have hQ : (P ^ 4).IsDistinguishedAt (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K)) := by
    rw [pow_succ, pow_succ, pow_succ, pow_one]
    exact ((hP.mul hP).mul hP).mul hP
  have hnm : PowerSeries.constantCoeff (1 : PowerSeries (MvPowerSeries (Fin n) K)) ∉
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) := by
    rw [map_one]
    exact (Ideal.ne_top_iff_one _).mp hI
  have hQmap : ((P ^ 4 : Polynomial _) : PowerSeries (MvPowerSeries (Fin n) K)).map
      (IsLocalRing.residue (MvPowerSeries (Fin n) K)) ≠ 0 :=
    hQ.map_ne_zero_of_eq_mul _ 1 hnm (mul_one _).symm
  have hord : (((P ^ 4 : Polynomial _) : PowerSeries (MvPowerSeries (Fin n) K)).map
      (Ideal.Quotient.mk (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K)))).order.toNat = 4 * P.natDegree := by
    rw [← hQ.coe_natDegree_eq_order_map _ 1 hnm (mul_one _).symm, ENat.toNat_natCast, hmon.natDegree_pow]
  choose W R hWR using fun i => (MvPowerSeries.finSuccEquiv K n (ŷ i)).exists_isWeierstrassDivision hQmap
  have hRdeg : ∀ i, (R i).degree < ((4 * P.natDegree : ℕ) : WithBot ℕ) := fun i => by
    rw [← hord]
    exact (hWR i).degree_lt
  let z : Unk P.natDegree N (4 * P.natDegree) → MvPowerSeries (Fin n) K :=
    Sum.elim (fun l => P.coeff l) (fun il => (R il.1).coeff il.2)
  have hPz : Pz z = P := mkP_coeff P hmon
  have hRz : Rz z = R := funext fun i => mkR_coeff (R i) (hRdeg i)
  have hdiff : ∀ i, ŷ i - (MvPowerSeries.finSuccEquiv K n).symm (R i : PowerSeries _) ∈
      Ideal.span {(MvPowerSeries.finSuccEquiv K n).symm ((P ^ 4 : Polynomial _) : PowerSeries _)} := fun i => by
    refine Ideal.mem_span_singleton'.mpr ⟨(MvPowerSeries.finSuccEquiv K n).symm (W i), ?_⟩
    rw [← map_mul, mul_comm, eq_sub_iff_add_eq, ← map_add, ← (hWR i).eq_mul_add, AlgEquiv.symm_apply_apply]
  have hTay := aeval_sub_mem_span (E := MvPolynomial (Fin (n + 1)) K) ŷ _ _ hdiff
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hTay g)
  rw [← finSuccEquiv_symm_evS] at hc
  have hgV : ((evS (theta1 K n) (MvPowerSeries (Fin n) K) g R : Polynomial _) : PowerSeries _) =
      (P : PowerSeries _) * (U - MvPowerSeries.finSuccEquiv K n c * (P : PowerSeries _) ^ 3) := by
    calc ((evS (theta1 K n) (MvPowerSeries (Fin n) K) g R : Polynomial _) : PowerSeries _)
        = MvPowerSeries.finSuccEquiv K n ((MvPowerSeries.finSuccEquiv K n).symm
            ((evS (theta1 K n) (MvPowerSeries (Fin n) K) g R : Polynomial _) : PowerSeries _)) :=
          (AlgEquiv.apply_symm_apply _ _).symm
      _ = MvPowerSeries.finSuccEquiv K n (MvPolynomial.aeval ŷ g -
            c * (MvPowerSeries.finSuccEquiv K n).symm ((P ^ 4 : Polynomial _) : PowerSeries _)) := by
          rw [hc, sub_sub_cancel]
      _ = (P : PowerSeries _) * (U - MvPowerSeries.finSuccEquiv K n c * (P : PowerSeries _) ^ 3) := by
          rw [map_sub, map_mul, AlgEquiv.apply_symm_apply, hsPU, Polynomial.coe_pow]
          ring
  have hgdvd : P ∣ evS (theta1 K n) (MvPowerSeries (Fin n) K) g R := dvd_of_coe_dvd hI hP ⟨_, hgV⟩
  refine ⟨hd, z, eqsys_vanish_of_dvd _ hs g z (fun j => ?_) (by rw [hPz, hRz]; exact hgdvd),
    fun l => constantCoeff_eq_zero_of_mem (hP.mem l.isLt), fun i k hk => ?_, ?_⟩
  · rw [hPz, hRz]
    apply dvd_of_coe_dvd hI hQ
    obtain ⟨c', hc'⟩ := Ideal.mem_span_singleton'.mp (hTay (hs j))
    rw [hh j, zero_sub, ← finSuccEquiv_symm_evS] at hc'
    refine ⟨-(MvPowerSeries.finSuccEquiv K n c'), ?_⟩
    apply (MvPowerSeries.finSuccEquiv K n).symm.injective
    rw [map_mul, map_neg, AlgEquiv.symm_apply_apply, mul_neg, mul_comm, hc', neg_neg]
  · show MvPowerSeries.constantCoeff ((R i).coeff k) = _
    rw [hk]
    have h1 : MvPowerSeries.constantCoeff (PowerSeries.constantCoeff (MvPowerSeries.finSuccEquiv K n (ŷ i))) =
        MvPowerSeries.constantCoeff (PowerSeries.constantCoeff
          (((P ^ 4 : Polynomial _) : PowerSeries _) * W i + (R i : PowerSeries _))) := by
      rw [← (hWR i).eq_mul_add]
    rw [cc_cc_finSuccEquiv, map_add, map_add, map_mul, map_mul, Polynomial.coe_pow, map_pow, map_pow,
      Polynomial.constantCoeff_coe, Polynomial.constantCoeff_coe, hP0c, zero_pow four_ne_zero, zero_mul,
      zero_add] at h1
    exact h1.symm
  · rw [hPz, hRz]
    have hPV := modByMonic_add_div (evS (theta1 K n) (MvPowerSeries (Fin n) K) g R) P
    rw [(modByMonic_eq_zero_iff_dvd hmon).mpr hgdvd, zero_add] at hPV
    have hP0 : (P : PowerSeries (MvPowerSeries (Fin n) K)) ≠ 0 := by
      rw [Ne, Polynomial.coe_eq_zero_iff]
      exact hmon.ne_zero
    have hV : ((evS (theta1 K n) (MvPowerSeries (Fin n) K) g R /ₘ P : Polynomial _) : PowerSeries _) =
        U - MvPowerSeries.finSuccEquiv K n c * (P : PowerSeries _) ^ 3 := by
      apply mul_left_cancel₀ hP0
      rw [← Polynomial.coe_mul, hPV, hgV]
    rw [← Polynomial.constantCoeff_coe, hV, map_sub, map_mul, map_pow, Polynomial.constantCoeff_coe, map_sub,
      map_mul, map_pow, hP0c, zero_pow three_ne_zero, mul_zero, sub_zero]
    exact (MvPowerSeries.isUnit_iff_constantCoeff.mp (PowerSeries.isUnit_iff_constantCoeff.mp hPU.isUnit)).ne_zero

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA6c

/-! ### piece ArA2 -/
section Piece_ArA2


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA2: solutions in etale neighbourhoods

**`SolNbhd χ f c`**: the system `f` over `R` has a solution `y` in an etale neighbourhood `(R', χ')` of the `K`-point
`χ : R →+* K` with residues `χ' ∘ y = c` (the shape of `hensel_nbhd` and of the conclusion of `ArtinApproxAt`).

* `SolNbhd.refl`, `SolNbhd.hensel`: solutions in `R` itself; Hensel's lemma.
* `SolNbhd.trans`: a solution in an etale neighbourhood of an etale neighbourhood.
* `tensor_point`, `SolNbhd.baseChange`: base change along `R → B` with a compatible point of `B`.
* `away_point`: the point of `Localization.Away s` when `χ' s ≠ 0`.
* `SolNbhd.of_le` (equations in the ideal), `SolNbhd.of_rename` (forget variables).
-/

set_option autoImplicit false

noncomputable section

open TensorProduct

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Nbhd

variable {K : Type u} [Field K] {R : Type u} [CommRing R]

/-- The system `f` has a solution in an etale neighbourhood of `χ` with residues `c`. -/
def SolNbhd (χ : R →+* K) {n m : ℕ} (f : Fin m → MvPolynomial (Fin n) R) (c : Fin n → K) : Prop :=
  ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (χ' : R' →+* K)
    (y : Fin n → R'), (∀ a, χ' (algebraMap R R' a) = χ a) ∧ (∀ j, MvPolynomial.aeval y (f j) = 0) ∧
      ∀ i, χ' (y i) = c i

theorem SolNbhd.refl (χ : R →+* K) {n m : ℕ} {f : Fin m → MvPolynomial (Fin n) R} (y : Fin n → R)
    (hy : ∀ j, MvPolynomial.eval y (f j) = 0) : SolNbhd χ f fun i => χ (y i) :=
  ⟨R, inferInstance, inferInstance, inferInstance, χ, y, fun _ => rfl, fun j => hy j, fun _ => rfl⟩

theorem SolNbhd.hensel (χ : R →+* K) {r : ℕ} (g : Fin r → MvPolynomial (Fin r) R) (c : Fin r → K)
    (hc : ∀ j, MvPolynomial.eval₂ χ c (g j) = 0) (hJ : MvPolynomial.eval₂ χ c (jdet g) ≠ 0) : SolNbhd χ g c :=
  hensel_nbhd χ g c hc hJ

/-- A solution in an etale neighbourhood of an etale neighbourhood. -/
theorem SolNbhd.trans {χ : R →+* K} {R' : Type u} [CommRing R'] [Algebra R R'] [Algebra.Etale R R']
    {χ' : R' →+* K} (hχ' : ∀ a, χ' (algebraMap R R' a) = χ a) {n m : ℕ} {f : Fin m → MvPolynomial (Fin n) R}
    {c : Fin n → K} (h : SolNbhd χ' (fun j => MvPolynomial.map (algebraMap R R') (f j)) c) : SolNbhd χ f c := by
  obtain ⟨R'', i1, i2, i3, χ'', y, h1, h2, h3⟩ := h
  letI : Algebra R R'' := ((algebraMap R' R'').comp (algebraMap R R')).toAlgebra
  haveI : IsScalarTower R R' R'' := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : Algebra.Etale R R'' := Algebra.Etale.comp R R' R''
  refine ⟨R'', i1, inferInstance, inferInstance, χ'', y, fun a => ?_, fun j => ?_, h3⟩
  · rw [IsScalarTower.algebraMap_apply R R' R'', h1, hχ']
  · exact (MvPolynomial.aeval_map_algebraMap R' y (f j)).symm.trans (h2 j)

/-- The `K`-point of `B ⊗[R] R'` given by compatible points of `B` and `R'`. -/
theorem tensor_point {B R' : Type u} [CommRing B] [CommRing R'] [Algebra R B] [Algebra R R'] (ψ : B →+* K)
    (χ' : R' →+* K) (h : ∀ a, χ' (algebraMap R R' a) = ψ (algebraMap R B a)) :
    ∃ χ'' : B ⊗[R] R' →+* K, (∀ b, χ'' (algebraMap B (B ⊗[R] R') b) = ψ b) ∧
      ∀ x, χ'' (Algebra.TensorProduct.includeRight x) = χ' x := by
  letI : Algebra R K := (ψ.comp (algebraMap R B)).toAlgebra
  let f : B →ₐ[R] K := { toRingHom := ψ, commutes' := fun _ => rfl }
  let g : R' →ₐ[R] K := { toRingHom := χ', commutes' := h }
  refine ⟨(Algebra.TensorProduct.productMap f g).toRingHom, fun b => ?_, fun x => ?_⟩
  · show ψ b * χ' 1 = ψ b
    rw [map_one, mul_one]
  · show ψ 1 * χ' x = χ' x
    rw [map_one, one_mul]

/-- Base change of a solution along `R → B`, for a point `ψ` of `B` over `χ`. -/
theorem SolNbhd.baseChange {χ : R →+* K} {B : Type u} [CommRing B] [Algebra R B] {ψ : B →+* K}
    (hψ : ∀ a, ψ (algebraMap R B a) = χ a) {n m : ℕ} {f : Fin m → MvPolynomial (Fin n) R} {c : Fin n → K}
    (h : SolNbhd χ f c) : SolNbhd ψ (fun j => MvPolynomial.map (algebraMap R B) (f j)) c := by
  obtain ⟨R', i1, i2, i3, χ', y, h1, h2, h3⟩ := h
  obtain ⟨χ'', g1, g2⟩ := tensor_point ψ χ' fun a => (h1 a).trans (hψ a).symm
  refine ⟨B ⊗[R] R', inferInstance, inferInstance, inferInstance, χ'',
    fun i => Algebra.TensorProduct.includeRight (y i), g1, fun j => ?_, fun i => (g2 _).trans (h3 i)⟩
  have e := MvPolynomial.comp_aeval_apply y (Algebra.TensorProduct.includeRight : R' →ₐ[R] B ⊗[R] R') (f j)
  rw [h2 j, map_zero] at e
  exact (MvPolynomial.aeval_map_algebraMap B _ (f j)).trans e.symm

/-- The point of `Localization.Away s` extending `χ'` when `χ' s ≠ 0`. -/
theorem away_point {R' : Type u} [CommRing R'] (χ' : R' →+* K) (s : R') (hs : χ' s ≠ 0) :
    ∃ χ'' : Localization.Away s →+* K, ∀ x, χ'' (algebraMap R' (Localization.Away s) x) = χ' x :=
  ⟨IsLocalization.Away.lift s (Ne.isUnit hs), IsLocalization.Away.lift_eq s (Ne.isUnit hs)⟩

/-- Equations in the ideal generated by a solved system are solved. -/
theorem SolNbhd.of_le {χ : R →+* K} {n m m' : ℕ} {f : Fin m → MvPolynomial (Fin n) R}
    {g : Fin m' → MvPolynomial (Fin n) R} {c : Fin n → K} (hg : ∀ k, g k ∈ Ideal.span (Set.range f))
    (h : SolNbhd χ f c) : SolNbhd χ g c := by
  obtain ⟨R', i1, i2, i3, χ', y, h1, h2, h3⟩ := h
  refine ⟨R', i1, i2, i3, χ', y, h1, fun k => ?_, h3⟩
  have hle : Ideal.span (Set.range f) ≤
      RingHom.ker (MvPolynomial.aeval y : MvPolynomial (Fin n) R →ₐ[R] R') := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact RingHom.mem_ker.mpr (h2 j)
  exact RingHom.mem_ker.mp (hle (hg k))

/-- Forgetting variables: a solution of the renamed system restricts. -/
theorem SolNbhd.of_rename {χ : R →+* K} {n n' m : ℕ} (σ : Fin n → Fin n') {f : Fin m → MvPolynomial (Fin n) R}
    {c : Fin n' → K} (h : SolNbhd χ (fun j => MvPolynomial.rename σ (f j)) c) : SolNbhd χ f (c ∘ σ) := by
  obtain ⟨R', i1, i2, i3, χ', y, h1, h2, h3⟩ := h
  refine ⟨R', i1, i2, i3, χ', y ∘ σ, h1, fun j => ?_, fun i => h3 (σ i)⟩
  rw [← MvPolynomial.aeval_rename]
  exact h2 j

end Nbhd

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA2

/-! ### piece ArA3c -/
section Piece_ArA3c


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA3c: Tougeron's lemma with the strong congruence

**`tougeron_nbhd_strong`**: as `tougeron_nbhd`, and moreover the correction `d` (with `y' = y + δ d`) lies in the ideal
generated by `e`. Proof: the Hensel solution `z` of `e + z + q(z) = 0`, `q_j = Σ_k X_k b_{jk}` (`b ∈ (X)`), satisfies
`(1 + B(z)) z = -e`, so `det (1 + B(z)) · z ∈ (e)` (`cramer_mem`); `det (1 + B(z))` has residue `1`, and we localize
at it (`away_point`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

section TougeronStrong

variable {R : Type u} [CommRing R] {r N : ℕ}

theorem exists_X_mul_of_mem_sq {q : MvPolynomial (Fin r) R}
    (hq : q ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ^ 2) :
    ∃ b : Fin r → MvPolynomial (Fin r) R,
      (∀ k, b k ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R))) ∧
        q = ∑ k, MvPolynomial.X k * b k := by
  rw [sq] at hq
  refine Submodule.mul_induction_on (C := fun q => ∃ b : Fin r → MvPolynomial (Fin r) R,
      (∀ k, b k ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R))) ∧
        q = ∑ k, MvPolynomial.X k * b k) hq (fun a ha c hc => ?_) (fun a c ha hc => ?_)
  · obtain ⟨α, hα⟩ := Ideal.mem_span_range_iff_exists_fun.mp ha
    refine ⟨fun k => α k * c, fun k => Ideal.mul_mem_left _ _ hc, ?_⟩
    show a * c = ∑ k, MvPolynomial.X k * (α k * c)
    rw [← hα, Finset.sum_mul]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  · obtain ⟨b₁, hb₁, e₁⟩ := ha
    obtain ⟨b₂, hb₂, e₂⟩ := hc
    refine ⟨b₁ + b₂, fun k => Ideal.add_mem _ (hb₁ k) (hb₂ k), ?_⟩
    rw [e₁, e₂, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [Pi.add_apply, mul_add]

theorem chi_aeval {K : Type u} [Field K] {χ : R →+* K} {R' : Type u} [CommRing R'] [Algebra R R']
    {χ' : R' →+* K} (hχ' : ∀ a, χ' (algebraMap R R' a) = χ a) {z : Fin r → R'} (hz : ∀ j, χ' (z j) = 0)
    (p : MvPolynomial (Fin r) R) : χ' (MvPolynomial.aeval z p) = MvPolynomial.eval₂ χ 0 p := by
  have hk : χ'.comp (algebraMap R R') = χ := RingHom.ext hχ'
  have hz' : χ' ∘ z = 0 := funext hz
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left, hk, hz']

/-- **Cramer**: `(1 + B) z = -e` gives `det (1 + B) · z ∈ (e)`. -/
theorem cramer_mem {T : Type*} [CommRing T] (B : Matrix (Fin r) (Fin r) T) (z e : Fin r → T)
    (h : ∀ j, e j + z j + ∑ k, B j k * z k = 0) (l : Fin r) :
    (1 + B).det * z l ∈ Ideal.span (Set.range e) := by
  have hT : ∀ k, ∑ j, (1 + B) k j * z j = -e k := by
    intro k
    have h1 : ∑ j, (1 + B) k j * z j = z k + ∑ j, B k j * z j := by
      simp [Matrix.add_apply, add_mul, Finset.sum_add_distrib, Matrix.one_apply, ite_mul]
    rw [h1]
    linear_combination h k
  have hA : ∀ j, ((1 + B).adjugate * (1 + B)) l j = (1 + B).det * (1 : Matrix (Fin r) (Fin r) T) l j := by
    intro j
    rw [Matrix.adjugate_mul, Matrix.smul_apply, smul_eq_mul]
  have h3 : (1 + B).det * z l = -∑ k, (1 + B).adjugate l k * e k := by
    calc (1 + B).det * z l = ∑ j, (1 + B).det * (1 : Matrix (Fin r) (Fin r) T) l j * z j := by
          simp [Matrix.one_apply, mul_ite, ite_mul]
      _ = ∑ j, ∑ k, (1 + B).adjugate l k * (1 + B) k j * z j := by
          refine Finset.sum_congr rfl fun j _ => ?_
          rw [← hA j, Matrix.mul_apply, Finset.sum_mul]
      _ = ∑ k, (1 + B).adjugate l k * ∑ j, (1 + B) k j * z j := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j _ => ?_
          ring
      _ = -∑ k, (1 + B).adjugate l k * e k := by
          simp only [hT, mul_neg, Finset.sum_neg_distrib]
  rw [h3]
  exact (Ideal.neg_mem_iff _).mpr (Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩))

/-- The Hensel step of Tougeron's lemma: `e + X + q = 0` has a solution with residue `0`. -/
theorem tougeron_hensel {K : Type u} [Field K] (χ : R →+* K) (e : Fin r → R) (he : ∀ j, χ (e j) = 0)
    (q : Fin r → MvPolynomial (Fin r) R)
    (hq : ∀ j, q j ∈ Ideal.span (Set.range (MvPolynomial.X : Fin r → MvPolynomial (Fin r) R)) ^ 2) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (χ' : R' →+* K)
      (z : Fin r → R'), (∀ a, χ' (algebraMap R R' a) = χ a) ∧
        (∀ j, MvPolynomial.aeval z (MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 0) ∧ ∀ j, χ' (z j) = 0 := by
  have hc : ∀ j, MvPolynomial.eval₂ χ 0 (MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 0 := by
    intro j
    rw [MvPolynomial.eval₂_add, MvPolynomial.eval₂_add, MvPolynomial.eval₂_C, MvPolynomial.eval₂_X, he j,
      eval₂_zero_of_mem χ (Ideal.pow_le_self two_ne_zero (hq j)), Pi.zero_apply, add_zero, add_zero]
  have hm : (MvPolynomial.eval₂Hom χ (0 : Fin r → K)).mapMatrix
      (Matrix.of fun i j => MvPolynomial.pderiv i (MvPolynomial.C (e j) + MvPolynomial.X j + q j)) = 1 := by
    ext i j
    have h3 : MvPolynomial.eval₂Hom χ (0 : Fin r → K) (MvPolynomial.pderiv i (q j)) = 0 :=
      eval₂_zero_of_mem χ (pderiv_mem_of_mem_sq i (hq j))
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply, map_add, MvPolynomial.pderiv_C,
      zero_add, h3, add_zero]
    by_cases hij : i = j
    · subst hij
      rw [MvPolynomial.pderiv_X_self, map_one, Matrix.one_apply_eq]
    · rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hij), map_zero, Matrix.one_apply_ne hij]
  have hJ : MvPolynomial.eval₂ χ 0 (jdet fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) ≠ 0 := by
    have h1 := RingHom.map_det (MvPolynomial.eval₂Hom χ (0 : Fin r → K))
      (Matrix.of fun i j => MvPolynomial.pderiv i (MvPolynomial.C (e j) + MvPolynomial.X j + q j))
    rw [hm, Matrix.det_one] at h1
    have h2 : MvPolynomial.eval₂ χ 0 (jdet fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 1 := h1
    rw [h2]
    exact one_ne_zero
  obtain ⟨R', i1, i2, i3, χ', z, hχ', hz, hz0⟩ :=
    hensel_nbhd χ (fun j => MvPolynomial.C (e j) + MvPolynomial.X j + q j) 0 hc hJ
  exact ⟨R', i1, i2, i3, χ', z, hχ', hz, hz0⟩

/-- **Tougeron's lemma, strong form**: the correction lies in the ideal generated by `e`. -/
theorem tougeron_nbhd_strong {K : Type u} [Field K] (χ : R →+* K) (f : Fin r → MvPolynomial (Fin N) R)
    (S : Fin r → Fin N) (y : Fin N → R) (e : Fin r → R)
    (hf : ∀ j, MvPolynomial.eval y (f j) = (tmin f S y).det ^ 2 * e j) (he : ∀ j, χ (e j) = 0) :
    ∃ (R' : Type u) (_ : CommRing R') (_ : Algebra R R') (_ : Algebra.Etale R R') (χ' : R' →+* K)
      (y' d : Fin N → R'), (∀ a, χ' (algebraMap R R' a) = χ a) ∧ (∀ j, MvPolynomial.aeval y' (f j) = 0) ∧
        (∀ i, y' i = algebraMap R R' (y i) + algebraMap R R' (tmin f S y).det * d i) ∧ (∀ i, χ' (d i) = 0) ∧
          ∀ i, d i ∈ Ideal.span (Set.range fun j => algebraMap R R' (e j)) := by
  choose q hq hq2 using tougeron_taylor f S y e hf
  choose b hb hqb using fun j => exists_X_mul_of_mem_sq (hq j)
  obtain ⟨R₁, i1, i2, i3, χ₁, z, hχ₁, hz, hz0⟩ := tougeron_hensel χ e he q hq
  obtain ⟨Bm, hBm⟩ : ∃ Bm : Matrix (Fin r) (Fin r) R₁, ∀ j k, Bm j k = MvPolynomial.aeval z (b j k) :=
    ⟨Matrix.of fun j k => MvPolynomial.aeval z (b j k), fun _ _ => rfl⟩
  have hBz : ∀ j, algebraMap R R₁ (e j) + z j + ∑ k, Bm j k * z k = 0 := by
    intro j
    have h0 := hz j
    rw [hqb j, map_add, map_add, MvPolynomial.aeval_C, MvPolynomial.aeval_X, map_sum] at h0
    refine Eq.trans ?_ h0
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, MvPolynomial.aeval_X, hBm]
    exact mul_comm _ _
  have hs : ∀ l, (1 + Bm).det * z l ∈ Ideal.span (Set.range fun j => algebraMap R R₁ (e j)) :=
    cramer_mem Bm z (fun j => algebraMap R R₁ (e j)) hBz
  have hχs : χ₁ (1 + Bm).det = 1 := by
    have hmat : χ₁.mapMatrix (1 + Bm) = 1 := by
      ext j k
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.add_apply, map_add, hBm, chi_aeval hχ₁ hz0,
        eval₂_zero_of_mem χ (hb j k), add_zero, Matrix.one_apply, Matrix.one_apply]
      split_ifs <;> simp
    rw [RingHom.map_det, hmat, Matrix.det_one]
  obtain ⟨χ', hχ'⟩ := away_point χ₁ (1 + Bm).det (by rw [hχs]; exact one_ne_zero)
  refine ⟨Localization.Away (1 + Bm).det, inferInstance, inferInstance, inferInstance, χ',
    fun i => algebraMap R₁ _ (MvPolynomial.aeval z
      (MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i)),
    fun i => algebraMap R₁ _ (MvPolynomial.aeval z (tcor f S y i)), fun a => ?_, fun j => ?_, fun i => ?_,
    fun i => ?_, fun i => ?_⟩
  · rw [IsScalarTower.algebraMap_apply R R₁ (Localization.Away (1 + Bm).det), hχ', hχ₁]
  · have h1 := MvPolynomial.comp_aeval_apply
      (fun i => MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i) (MvPolynomial.aeval z) (f j)
    rw [hq2 j, map_mul, show MvPolynomial.aeval z (MvPolynomial.C (e j) + MvPolynomial.X j + q j) = 0 from hz j,
      mul_zero] at h1
    have h2 := MvPolynomial.comp_aeval_apply (fun i => MvPolynomial.aeval z
      (MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i))
        (IsScalarTower.toAlgHom R R₁ (Localization.Away (1 + Bm).det)) (f j)
    rw [← h1, map_zero] at h2
    exact h2.symm
  · show algebraMap R₁ _ (MvPolynomial.aeval z
        (MvPolynomial.C (y i) + MvPolynomial.C (tmin f S y).det * tcor f S y i)) =
      algebraMap R _ (y i) + algebraMap R _ (tmin f S y).det * algebraMap R₁ _ (MvPolynomial.aeval z (tcor f S y i))
    rw [map_add, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_C, map_add, map_mul,
      ← IsScalarTower.algebraMap_apply R R₁ (Localization.Away (1 + Bm).det),
      ← IsScalarTower.algebraMap_apply R R₁ (Localization.Away (1 + Bm).det)]
  · show χ' (algebraMap R₁ _ (MvPolynomial.aeval z (tcor f S y i))) = 0
    rw [hχ', chi_aeval hχ₁ hz0]
    exact eval₂_zero_of_mem χ (tcor_mem f S y i)
  · have hcz : (⇑(MvPolynomial.aeval z : MvPolynomial (Fin r) R →ₐ[R] R₁) ∘ MvPolynomial.X) = z :=
      funext fun j => MvPolynomial.aeval_X z j
    have hd1 : MvPolynomial.aeval z (tcor f S y i) ∈ Ideal.span (Set.range z) := by
      have h := Ideal.mem_map_of_mem (MvPolynomial.aeval z : MvPolynomial (Fin r) R →ₐ[R] R₁) (tcor_mem f S y i)
      rw [Ideal.map_span, ← Set.range_comp, hcz] at h
      exact h
    have hd2 : (1 + Bm).det * MvPolynomial.aeval z (tcor f S y i) ∈
        Ideal.span (Set.range fun j => algebraMap R R₁ (e j)) := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hd1
      rw [← hc, Finset.mul_sum]
      refine Ideal.sum_mem _ fun l _ => ?_
      rw [mul_left_comm]
      exact Ideal.mul_mem_left _ _ (hs l)
    have hd3 := Ideal.mem_map_of_mem (algebraMap R₁ (Localization.Away (1 + Bm).det)) hd2
    have hrange : (⇑(algebraMap R₁ (Localization.Away (1 + Bm).det)) ∘ fun j => algebraMap R R₁ (e j)) =
        fun j => algebraMap R (Localization.Away (1 + Bm).det) (e j) :=
      funext fun j => (IsScalarTower.algebraMap_apply R R₁ _ (e j)).symm
    rw [Ideal.map_span, ← Set.range_comp, hrange, map_mul] at hd3
    have hu : IsUnit (algebraMap R₁ (Localization.Away (1 + Bm).det) (1 + Bm).det) :=
      IsLocalization.Away.algebraMap_isUnit (x := (1 + Bm).det)
    exact (Ideal.unit_mul_mem_iff_mem _ hu).mp hd3

end TougeronStrong

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA3c

/-! ### piece ArA5b -/
section Piece_ArA5b


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA5b: solutions in etale neighbourhoods and automorphisms of the base

`SolNbhd.of_ringEquiv`: if `e` is a ring automorphism of `R` fixing the point `χ`, a solution in an etale
neighbourhood of the transformed system `e(f)` gives one of `f` (twist the structure map by `e`).
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K : Type u} [Field K] {R : Type u} [CommRing R]

theorem SolNbhd.of_ringEquiv {χ : R →+* K} (e : R ≃+* R) (he : ∀ a, χ (e a) = χ a) {n m : ℕ}
    {f : Fin m → MvPolynomial (Fin n) R} {c : Fin n → K}
    (h : SolNbhd χ (fun j => MvPolynomial.map e.toRingHom (f j)) c) : SolNbhd χ f c := by
  obtain ⟨R', i1, i2, i3, χ', y, h1, h2, h3⟩ := h
  have hE : ((algebraMap R R').comp e.toRingHom).Etale :=
    RingHom.Etale.stableUnderComposition e.toRingHom (algebraMap R R')
      (RingHom.Etale.of_bijective e.bijective) (RingHom.etale_algebraMap.mpr i3)
  refine ⟨R', i1, ((algebraMap R R').comp e.toRingHom).toAlgebra, hE.toAlgebra, χ', y, fun a => ?_, fun j => ?_,
    h3⟩
  · change χ' (algebraMap R R' (e a)) = χ a
    rw [h1, he]
  · have := h2 j
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map] at this
    exact this

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA5b

/-! ### piece ArA4a -/
section Piece_ArA4a


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA4a: linear algebra for the Jacobian datum

* `linearIndependent_row_of_sum`: if the rows `(A_j, M_j)` of a block matrix are linearly independent and `A = M C`,
  then the rows of `M` are linearly independent.
* `exists_minor_ne_zero`: an `r × N` matrix over a field with independent rows has an `r × r` minor
  `M.submatrix id S` with nonzero determinant.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

section LinAlg

variable {F : Type*} [Field F] {r n N : ℕ}

theorem linearIndependent_row_of_sum (A : Matrix (Fin r) (Fin n) F) (M : Matrix (Fin r) (Fin N) F)
    (C : Matrix (Fin N) (Fin n) F) (hAC : A = M * C)
    (h : LinearIndependent F fun j => Sum.elim (A j) (M j)) : LinearIndependent F M.row := by
  rw [Fintype.linearIndependent_iff] at h ⊢
  intro g hg
  apply h g
  have hk : ∀ k, ∑ j, g j * M j k = 0 := fun k => by
    have := congrFun hg k
    simpa [Finset.sum_apply, Matrix.row] using this
  funext v
  cases v with
  | inl i =>
    simp only [Finset.sum_apply, Pi.smul_apply, Sum.elim_inl, smul_eq_mul, Pi.zero_apply, hAC, Matrix.mul_apply,
      Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun k _ => ?_
    have e : ∑ j, g j * (M j k * C k i) = (∑ j, g j * M j k) * C k i := by
      rw [Finset.sum_mul]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [e, hk k, zero_mul]
  | inr k =>
    simp only [Finset.sum_apply, Pi.smul_apply, Sum.elim_inr, smul_eq_mul, Pi.zero_apply]
    exact hk k

theorem exists_minor_ne_zero (M : Matrix (Fin r) (Fin N) F) (hM : LinearIndependent F M.row) :
    ∃ S : Fin r → Fin N, (M.submatrix id S).det ≠ 0 := by
  have hrank : M.rank = r := by
    rw [Matrix.rank_eq_finrank_span_row, finrank_span_eq_card hM, Fintype.card_fin]
  have hspan : Submodule.span F (Set.range M.col) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [← Matrix.rank_eq_finrank_span_cols, hrank, Module.finrank_fin_fun]
  obtain ⟨κ, a, -, hsa, hli⟩ := exists_linearIndependent' F M.col
  rw [hspan] at hsa
  let b : Module.Basis κ F (Fin r → F) := Module.Basis.mk hli hsa.ge
  letI : Fintype κ := FiniteDimensional.fintypeBasisIndex b
  have hcard : Fintype.card κ = r := by
    rw [← Module.finrank_eq_card_basis b, Module.finrank_fin_fun]
  let eκ : Fin r ≃ κ := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨a ∘ eκ, ?_⟩
  have hcols : LinearIndependent F (M.submatrix id (a ∘ eκ)).col := by
    have e : (M.submatrix id (a ∘ eκ)).col = (M.col ∘ a) ∘ eκ := by
      funext k j
      rfl
    rw [e]
    exact hli.comp eκ eκ.injective
  exact ((Matrix.isUnit_iff_isUnit_det _).mp (Matrix.linearIndependent_cols_iff_isUnit.mp hcols)).ne_zero

end LinAlg

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA4a

/-! ### piece ArA7b1 -/
section Piece_ArA7b1


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA7b1: helpers and the Tougeron stage of the induction step

* `eval_map_comp`, `tmin_map`, `tmin_det_map`: evaluation and Tougeron minors commute with a ring map.
* `nzd_map`: a flat algebra map keeps nonzerodivisors.
* `SolNbhd.of_ringHom`: a solution along an etale ring map.
* `stage_one`: localize at `V`, apply `tougeron_nbhd_strong` to `h` at `y`; the new solution `y'` keeps the
  residues, `P` stays a nonzerodivisor, and `G(y') = G(y) + δ P² s`.
-/

set_option autoImplicit false

noncomputable section

open scoped nonZeroDivisors

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Helpers

variable {S T : Type u} [CommRing S] [CommRing T] {N r : ℕ}

theorem eval_map_comp (φ : S →+* T) (y : Fin N → S) (p : MvPolynomial (Fin N) S) :
    MvPolynomial.eval (fun i => φ (y i)) (MvPolynomial.map φ p) = φ (MvPolynomial.eval y p) := by
  rw [MvPolynomial.eval_map]
  exact (MvPolynomial.eval₂_comp φ y p).symm

theorem tmin_map (φ : S →+* T) (h : Fin r → MvPolynomial (Fin N) S) (U : Fin r → Fin N) (y : Fin N → S) :
    tmin (fun j => MvPolynomial.map φ (h j)) U (fun i => φ (y i)) = φ.mapMatrix (tmin h U y) := by
  ext k j
  simp only [tmin, Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply, MvPolynomial.pderiv_map,
    eval_map_comp]

theorem tmin_det_map (φ : S →+* T) (h : Fin r → MvPolynomial (Fin N) S) (U : Fin r → Fin N)
    (y : Fin N → S) :
    (tmin (fun j => MvPolynomial.map φ (h j)) U (fun i => φ (y i))).det = φ (tmin h U y).det := by
  rw [tmin_map, RingHom.map_det]

/-- A flat algebra map keeps nonzerodivisors. -/
theorem nzd_map [Algebra S T] [Module.Flat S T] {x : S} (hx : x ∈ S⁰) : algebraMap S T x ∈ T⁰ := by
  rw [mem_nonZeroDivisors_iff_right]
  intro a ha
  have hr := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := T) hx
  exact hr (show x • a = x • (0 : T) by rw [smul_zero, Algebra.smul_def, mul_comm, ha])

end Helpers

section Step

variable {K : Type u} [Field K] {S : Type u} [CommRing S]

/-- A solution along an etale ring map. -/
theorem SolNbhd.of_ringHom {T : Type u} [CommRing T] (ψ : S →+* K) (φ : S →+* T) (hφ : φ.Etale)
    (χ' : T →+* K) (hχ : ∀ a, χ' (φ a) = ψ a) {N m : ℕ} {f : Fin m → MvPolynomial (Fin N) S}
    (y : Fin N → T) (hy : ∀ j, MvPolynomial.eval₂ φ y (f j) = 0) {c : Fin N → K}
    (hc : ∀ i, χ' (y i) = c i) : SolNbhd ψ f c := by
  letI : Algebra S T := φ.toAlgebra
  haveI : Algebra.Etale S T := hφ
  exact ⟨T, inferInstance, inferInstance, inferInstance, χ', y, hχ, hy, hc⟩

/-- Stage one of the induction step: Tougeron (strong form) after inverting `V`. -/
theorem stage_one (ψ : S →+* K) {N r : ℕ} (h : Fin r → MvPolynomial (Fin N) S) (U : Fin r → Fin N)
    (G : MvPolynomial (Fin N) S) (y : Fin N → S) (P V : S) (W : Fin r → S) (hP : P ∈ S⁰) (hP0 : ψ P = 0)
    (hV : ψ V ≠ 0) (hW : ∀ j, MvPolynomial.eval y (h j) = P ^ 4 * W j)
    (hgV : (tmin h U y).det * MvPolynomial.eval y G = P * V) :
    ∃ (R₁ : Type u) (_ : CommRing R₁) (κ : S →+* R₁) (_ : κ.Etale) (χ₁ : R₁ →+* K) (y' : Fin N → R₁)
      (s : R₁), (∀ a, χ₁ (κ a) = ψ a) ∧ (∀ j, MvPolynomial.eval₂ κ y' (h j) = 0) ∧
        (∀ i, χ₁ (y' i) = ψ (y i)) ∧ κ P ∈ R₁⁰ ∧
          MvPolynomial.eval₂ κ y' G = κ (MvPolynomial.eval y G) + κ (tmin h U y).det * κ P ^ 2 * s := by
  obtain ⟨ψV, hψV⟩ := away_point ψ V hV
  obtain ⟨v, hv⟩ := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away V) V).exists_right_inv
  obtain ⟨e, he⟩ : ∃ e : Fin r → Localization.Away V, ∀ j, e j =
      (algebraMap S _ (MvPolynomial.eval y G) * v) ^ 2 * algebraMap S _ P ^ 2 * algebraMap S _ (W j) :=
    ⟨_, fun _ => rfl⟩
  have h1 : algebraMap S (Localization.Away V) (tmin h U y).det * algebraMap S _ (MvPolynomial.eval y G) =
      algebraMap S _ P * algebraMap S _ V := by
    rw [← map_mul, ← map_mul, hgV]
  have hf : ∀ j, MvPolynomial.eval (fun i => algebraMap S (Localization.Away V) (y i))
      (MvPolynomial.map (algebraMap S (Localization.Away V)) (h j)) =
      (tmin (fun j => MvPolynomial.map (algebraMap S (Localization.Away V)) (h j)) U
        (fun i => algebraMap S (Localization.Away V) (y i))).det ^ 2 * e j := by
    intro j
    rw [eval_map_comp, tmin_det_map, hW j, he j, map_mul, map_pow]
    linear_combination (-(algebraMap S (Localization.Away V) (tmin h U y).det *
      algebraMap S (Localization.Away V) (MvPolynomial.eval y G) + algebraMap S (Localization.Away V) P *
      algebraMap S (Localization.Away V) V) * v ^ 2 * algebraMap S (Localization.Away V) P ^ 2 *
      algebraMap S (Localization.Away V) (W j)) * h1 + (-(algebraMap S (Localization.Away V) V * v + 1) *
      algebraMap S (Localization.Away V) P ^ 4 * algebraMap S (Localization.Away V) (W j)) * hv
  have he0 : ∀ j, ψV (e j) = 0 := by
    intro j
    simp [he j, hψV, hP0]
  obtain ⟨R₁, i1, i2, i3, χ₁, y', d, hχ₁, hy', hyd, hd0, hdspan⟩ := tougeron_nbhd_strong ψV
    (fun j => MvPolynomial.map (algebraMap S (Localization.Away V)) (h j)) U
    (fun i => algebraMap S (Localization.Away V) (y i)) e hf he0
  obtain ⟨κ, hκ⟩ : ∃ κ : S →+* R₁, κ = (algebraMap (Localization.Away V) R₁).comp (algebraMap S _) :=
    ⟨_, rfl⟩
  have hκa : ∀ a, κ a = algebraMap (Localization.Away V) R₁ (algebraMap S _ a) := fun a => by
    rw [hκ, RingHom.comp_apply]
  have hA : ∀ (z : Fin N → R₁) (p : MvPolynomial (Fin N) S),
      MvPolynomial.aeval z (MvPolynomial.map (algebraMap S (Localization.Away V)) p) =
        MvPolynomial.eval₂ κ z p := by
    intro z p
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map, hκ]
  have hyd' : ∀ i, y' i = κ (y i) + κ (tmin h U y).det * d i := fun i => by
    rw [hyd i, tmin_det_map, hκa, hκa]
  have hle : Ideal.span (Set.range fun j => algebraMap (Localization.Away V) R₁ (e j)) ≤
      Ideal.span {κ P ^ 2} := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    show algebraMap (Localization.Away V) R₁ (e j) ∈ Ideal.span {κ P ^ 2}
    rw [he j, map_mul, map_mul, map_pow (algebraMap (Localization.Away V) R₁) (algebraMap S _ P), ← hκa]
    exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  choose t ht using fun i => Ideal.mem_span_singleton'.mp (hle (hdspan i))
  have hy : ∀ i, y' i - κ (y i) ∈ Ideal.span {κ (tmin h U y).det * κ P ^ 2} := fun i =>
    Ideal.mem_span_singleton'.mpr ⟨t i, by rw [hyd' i, ← ht i]; ring⟩
  obtain ⟨s, hs⟩ := Ideal.mem_span_singleton'.mp (aeval_sub_mem_span (E := Localization.Away V) y'
    (fun i => κ (y i)) _ hy (MvPolynomial.map (algebraMap S _) G))
  have hGy : MvPolynomial.eval₂ κ (fun i => κ (y i)) G = κ (MvPolynomial.eval y G) :=
    (MvPolynomial.eval₂_comp κ y G).symm
  rw [hA, hA, hGy] at hs
  have hPκ : κ P ∈ R₁⁰ := by
    rw [hκa]
    exact nzd_map (nzd_map hP)
  have hκE : κ.Etale := by
    rw [hκ]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway V)) (RingHom.etale_algebraMap.mpr i3)
  have hχκ : ∀ a, χ₁ (κ a) = ψ a := fun a => by rw [hκa, hχ₁, hψV]
  refine ⟨R₁, i1, κ, hκE, χ₁, y', s, hχκ, fun j => ?_, fun i => ?_, hPκ, ?_⟩
  · rw [← hA]
    exact hy' j
  · rw [hyd' i, map_add, map_mul, hd0 i, mul_zero, add_zero, hχκ]
  · linear_combination (-1 : R₁) * hs

end Step

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA7b1

/-! ### piece ArA4b -/
section Piece_ArA4b


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA4b: chain rule and rows from a minor

* `linearIndependent_row_of_minor`: a matrix with an `r × r` column-minor of nonzero determinant has independent rows.
* `derivation_aeval`: the chain rule `D (p (v)) = Σ_w (∂p/∂X_w)(v) · D (v w)` for a derivation `D`.
* `pderiv_relation`: for `h ∈ K[x, y]` vanishing at `(x, ŷ)` (`ŷ` power series), `∂h/∂x_i (ŷ) = - Σ_k ∂h/∂y_k (ŷ) · ∂ŷ_k/∂x_i`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

section ChainRule

theorem linearIndependent_row_of_minor {F : Type*} [Field F] {r m : ℕ} (M : Matrix (Fin r) (Fin m) F)
    (S : Fin r → Fin m) (hS : (M.submatrix id S).det ≠ 0) : LinearIndependent F M.row := by
  have h1 : LinearIndependent F (M.submatrix id S).row :=
    Matrix.linearIndependent_rows_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det _).mpr (Ne.isUnit hS))
  exact LinearIndependent.of_comp (LinearMap.funLeft F F S) h1

variable {K : Type*} [CommRing K] {σ : Type*} [Fintype σ] {B : Type*} [CommRing B] [Algebra K B]

/-- **Chain rule** for a `K`-derivation of `B` and a polynomial over `K` evaluated at `v`. -/
theorem derivation_aeval (D : Derivation K B B) (v : σ → B) (p : MvPolynomial σ K) :
    D (MvPolynomial.aeval v p) = ∑ w, MvPolynomial.aeval v (MvPolynomial.pderiv w p) * D (v w) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp [MvPolynomial.aeval_C, Derivation.map_algebraMap, MvPolynomial.pderiv_C]
  | add p q hp hq =>
    rw [map_add, map_add, hp, hq, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun w _ => ?_
    rw [map_add, map_add, add_mul]
  | mul_X p i hp =>
    rw [map_mul, MvPolynomial.aeval_X, Derivation.leibniz, hp, smul_eq_mul, smul_eq_mul]
    have e : ∀ w, MvPolynomial.aeval v (MvPolynomial.pderiv w (p * MvPolynomial.X i)) * D (v w) =
        MvPolynomial.aeval v p * (MvPolynomial.aeval v (MvPolynomial.pderiv w
          (MvPolynomial.X i : MvPolynomial σ K)) * D (v w)) +
        v i * (MvPolynomial.aeval v (MvPolynomial.pderiv w p) * D (v w)) := by
      intro w
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, map_add, map_mul, map_mul, MvPolynomial.aeval_X]
      ring
    rw [Finset.sum_congr rfl fun w _ => e w, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    have hX : ∑ w, MvPolynomial.aeval v (MvPolynomial.pderiv w (MvPolynomial.X i : MvPolynomial σ K)) *
        D (v w) = D (v i) := by
      rw [Finset.sum_eq_single i]
      · rw [MvPolynomial.pderiv_X_self, map_one, one_mul]
      · intro w _ hw
        rw [MvPolynomial.pderiv_X_of_ne (Ne.symm hw), map_zero, zero_mul]
      · intro hi
        exact absurd (Finset.mem_univ i) hi
    rw [hX]

/-- The `x`-derivatives of `h` at `(x, ŷ)` are determined by the `y`-derivatives when `h (x, ŷ) = 0`. -/
theorem pderiv_relation {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) (h : MvPolynomial (Fin n ⊕ Fin N) K)
    (hh : MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ) h = 0) (i : Fin n) :
    MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ) (MvPolynomial.pderiv (Sum.inl i) h) =
      -∑ k, MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ) (MvPolynomial.pderiv (Sum.inr k) h) *
        MvPowerSeries.pderiv K i (ŷ k) := by
  have h0 := derivation_aeval (MvPowerSeries.pderiv K i) (Sum.elim MvPowerSeries.X ŷ) h
  rw [hh, map_zero, Fintype.sum_sum_type] at h0
  have hx : ∑ i', MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ) (MvPolynomial.pderiv (Sum.inl i') h) *
      MvPowerSeries.pderiv K i (Sum.elim (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K) ŷ (Sum.inl i')) =
      MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ) (MvPolynomial.pderiv (Sum.inl i) h) := by
    rw [Finset.sum_eq_single i]
    · rw [Sum.elim_inl, MvPowerSeries.pderiv_X_self, mul_one]
    · intro i' _ hi'
      rw [Sum.elim_inl, MvPowerSeries.pderiv_X_of_ne hi', mul_zero]
    · intro hi
      exact absurd (Finset.mem_univ i) hi
  rw [hx] at h0
  simp only [Sum.elim_inr] at h0
  exact eq_neg_of_add_eq_zero_left h0.symm

end ChainRule

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA4b

/-! ### piece ArA7b2 -/
section Piece_ArA7b2


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA7b2: the finishing step of the induction over one ring

**`finish_step`**: over `S` with a point `ψ`, let `h` be equations with `G·f_j ∈ (h)` for all `j`, and `y` a point
with `h(y) = P⁴·W` and `δ(y)·G(y) = P·V` (`δ` the Tougeron minor `tmin h U`), where `P` is a nonzerodivisor,
`ψ P = 0` and `ψ V ≠ 0`. Then `f` has a solution in an etale neighbourhood of `ψ` with residues `ψ ∘ y`.
Proof: `stage_one`, then invert `w = V + δ²P s` (so `δ·G(y') = P·w`); `P` stays a nonzerodivisor (flat maps),
hence so does `G(y')`, and `G(y')·f_j(y') = 0` gives `f_j(y') = 0`.
-/

set_option autoImplicit false

noncomputable section

open scoped nonZeroDivisors

namespace RamanujanPetersson.EtPBC.Cov

universe u

section Finish

variable {K : Type u} [Field K] {S : Type u} [CommRing S]

theorem finish_step (ψ : S →+* K) {N m r : ℕ} (f : Fin m → MvPolynomial (Fin N) S)
    (h : Fin r → MvPolynomial (Fin N) S) (U : Fin r → Fin N) (G : MvPolynomial (Fin N) S)
    (hGf : ∀ j, G * f j ∈ Ideal.span (Set.range h)) (y : Fin N → S) (P V : S) (W : Fin r → S)
    (hP : P ∈ S⁰) (hP0 : ψ P = 0) (hV : ψ V ≠ 0) (hW : ∀ j, MvPolynomial.eval y (h j) = P ^ 4 * W j)
    (hgV : (tmin h U y).det * MvPolynomial.eval y G = P * V) : SolNbhd ψ f fun i => ψ (y i) := by
  obtain ⟨R₁, i1, κ, hκ, χ₁, y', s, hχ₁, hh, hres, hPκ, hG⟩ := stage_one ψ h U G y P V W hP hP0 hV hW hgV
  obtain ⟨w, hw⟩ : ∃ w : R₁, w = κ V + κ (tmin h U y).det ^ 2 * κ P * s := ⟨_, rfl⟩
  have hχw : χ₁ w ≠ 0 := by
    rw [hw, map_add, map_mul, map_mul, hχ₁ P, hP0, mul_zero, zero_mul, add_zero, hχ₁ V]
    exact hV
  have h1 : κ (tmin h U y).det * κ (MvPolynomial.eval y G) = κ P * κ V := by
    rw [← map_mul, ← map_mul, hgV]
  have h2' : κ (tmin h U y).det * MvPolynomial.eval₂ κ y' G = κ P * w := by
    rw [hG, hw]
    linear_combination h1
  obtain ⟨χ₂, hχ₂⟩ := away_point χ₁ w hχw
  have hu : IsUnit (algebraMap R₁ (Localization.Away w) w) :=
    IsLocalization.Away.algebraMap_isUnit (S := Localization.Away w) w
  obtain ⟨lam, hlam⟩ : ∃ lam : S →+* Localization.Away w, lam = (algebraMap R₁ _).comp κ := ⟨_, rfl⟩
  have hlama : ∀ a, lam a = algebraMap R₁ (Localization.Away w) (κ a) := fun a => by
    rw [hlam, RingHom.comp_apply]
  have hlamE : lam.Etale := by
    rw [hlam]
    exact RingHom.Etale.stableUnderComposition _ _ hκ
      (RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway w))
  have hΦ : ∀ p, MvPolynomial.eval₂ lam (fun i => algebraMap R₁ (Localization.Away w) (y' i)) p =
      algebraMap R₁ (Localization.Away w) (MvPolynomial.eval₂ κ y' p) := fun p => by
    rw [hlam]
    exact (MvPolynomial.eval₂_comp_left _ κ y' p).symm
  have hGΦ : lam (tmin h U y).det *
      MvPolynomial.eval₂ lam (fun i => algebraMap R₁ (Localization.Away w) (y' i)) G =
        lam P * algebraMap R₁ (Localization.Away w) w := by
    rw [hΦ, hlama, hlama, ← map_mul, ← map_mul, h2']
  have hPl : lam P ∈ (Localization.Away w)⁰ := by
    rw [hlama]
    exact nzd_map hPκ
  have hle : Ideal.span (Set.range h) ≤
      RingHom.ker (MvPolynomial.eval₂Hom lam fun i => algebraMap R₁ (Localization.Away w) (y' i)) := by
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    exact RingHom.mem_ker.mpr (by rw [MvPolynomial.coe_eval₂Hom, hΦ, hh j, map_zero])
  refine SolNbhd.of_ringHom ψ lam hlamE χ₂ (fun a => (congrArg χ₂ (hlama a)).trans ((hχ₂ _).trans (hχ₁ a)))
    (fun i => algebraMap R₁ (Localization.Away w) (y' i)) (fun j => ?_) (fun i => (hχ₂ _).trans (hres i))
  have h0 := RingHom.mem_ker.mp (hle (hGf j))
  rw [map_mul, MvPolynomial.coe_eval₂Hom] at h0
  generalize MvPolynomial.eval₂ lam (fun i => algebraMap R₁ (Localization.Away w) (y' i)) (f j) = X at h0 ⊢
  have h2 : X * algebraMap R₁ (Localization.Away w) w * lam P = 0 := by
    linear_combination (-X) * hGΦ + lam (tmin h U y).det * h0
  exact hu.mul_left_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp hPl _ h2)

end Finish

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA7b2

/-! ### piece ArA4e -/
section Piece_ArA4e


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA4e: the `y`-minor at a power-series point

For `ŷ ∈ K[[x]]^N` (`K` perfect) and `φ = (x, ŷ) : K[x, y] → K[[x]]`, `I = ker φ`:
`jacobian_minor` gives `h₁, …, h_r ∈ I`, an `r × r` minor `δ` of `∂h/∂y` with `φ δ ≠ 0`, and `G` with `φ G ≠ 0` and
`G · I ⊆ (h)`.
-/

set_option autoImplicit false

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K : Type u} [Field K]

/-- The evaluation `K[x, y] → K[[x]]`, `x ↦ x`, `y ↦ ŷ`. -/
abbrev evalHat {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) :
    MvPolynomial (Fin n ⊕ Fin N) K →ₐ[K] MvPowerSeries (Fin n) K :=
  MvPolynomial.aeval (Sum.elim MvPowerSeries.X ŷ)

theorem rows_fin {S : Type*} [Field S] {r n N : ℕ} (w : Fin r → Fin n ⊕ Fin N → S) (hw : LinearIndependent S w) :
    LinearIndependent S (Matrix.of fun j c => w j (finSumFinEquiv.symm c)).row := by
  have := hw.map' (LinearMap.funLeft S S finSumFinEquiv.symm)
    (LinearMap.ker_eq_bot.mpr (LinearMap.funLeft_injective_of_surjective _ _ _ finSumFinEquiv.symm.surjective))
  exact this

theorem rows_sum {S : Type*} [Field S] {r n N : ℕ} (M : Matrix (Fin r) (Fin (n + N)) S)
    (hM : LinearIndependent S M.row) : LinearIndependent S fun j (v : Fin n ⊕ Fin N) => M j (finSumFinEquiv v) := by
  have := hM.map' (LinearMap.funLeft S S finSumFinEquiv)
    (LinearMap.ker_eq_bot.mpr (LinearMap.funLeft_injective_of_surjective _ _ _ finSumFinEquiv.surjective))
  exact this

/-- Over `κ(I)`: a full `r × r` minor of the Jacobian of `h` not in `I`. -/
theorem full_minor_not_mem {n N : ℕ} (I : Ideal (MvPolynomial (Fin n ⊕ Fin N) K)) [I.IsPrime] {r : ℕ}
    (h : Fin r → MvPolynomial (Fin n ⊕ Fin N) K)
    (hrows : LinearIndependent (PRes I) (fun j (v : Fin n ⊕ Fin N) =>
      algebraMap (MvPolynomial (Fin n ⊕ Fin N) K) (PRes I) (MvPolynomial.pderiv v (h j)))) :
    ∃ T' : Fin r → Fin (n + N),
      (Matrix.of fun j k => MvPolynomial.pderiv (finSumFinEquiv.symm (T' k)) (h j)).det ∉ I := by
  obtain ⟨T', hT'⟩ := exists_minor_ne_zero _ (rows_fin _ hrows)
  refine ⟨T', fun hDI => hT' ?_⟩
  rw [← (res_eq_zero_iff I _).mpr hDI, RingHom.map_det]
  congr 1

/-- Over `Frac K[[x]]`: a `y`-minor not vanishing at `ŷ`. -/
theorem y_minor_ne_zero {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) {r : ℕ}
    (h : Fin r → MvPolynomial (Fin n ⊕ Fin N) K) (hh : ∀ j, evalHat ŷ (h j) = 0) (T' : Fin r → Fin (n + N))
    (hT' : evalHat ŷ (Matrix.of fun j k => MvPolynomial.pderiv (finSumFinEquiv.symm (T' k)) (h j)).det ≠ 0) :
    ∃ T : Fin r → Fin N, evalHat ŷ (Matrix.of fun j k => MvPolynomial.pderiv (Sum.inr (T k)) (h j)).det ≠ 0 := by
  have : IsDomain (MvPowerSeries (Fin n) K) := NoZeroDivisors.to_isDomain _
  let F := FractionRing (MvPowerSeries (Fin n) K)
  let ι : MvPolynomial (Fin n ⊕ Fin N) K →+* F :=
    (algebraMap (MvPowerSeries (Fin n) K) F).comp (evalHat ŷ).toRingHom
  have hι : ∀ p, ι p = 0 → evalHat ŷ p = 0 := fun p hp =>
    (IsFractionRing.injective (MvPowerSeries (Fin n) K) F) (hp.trans (map_zero _).symm)
  let MF : Matrix (Fin r) (Fin (n + N)) F := Matrix.of fun j c => ι (MvPolynomial.pderiv (finSumFinEquiv.symm c) (h j))
  have hMF : LinearIndependent F MF.row := by
    refine linearIndependent_row_of_minor MF T' fun h0 => hT' (hι _ ?_)
    rw [RingHom.map_det]
    exact h0
  let A : Matrix (Fin r) (Fin n) F := Matrix.of fun j i => ι (MvPolynomial.pderiv (Sum.inl i) (h j))
  let My : Matrix (Fin r) (Fin N) F := Matrix.of fun j k => ι (MvPolynomial.pderiv (Sum.inr k) (h j))
  let C : Matrix (Fin N) (Fin n) F := Matrix.of fun k i =>
    -algebraMap (MvPowerSeries (Fin n) K) F (MvPowerSeries.pderiv K i (ŷ k))
  have hAC : A = My * C := by
    ext j i
    have hr := pderiv_relation ŷ (h j) (hh j) i
    simp only [A, My, C, Matrix.of_apply, Matrix.mul_apply, ι, RingHom.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe]
    rw [hr, map_neg, map_sum, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [map_mul, mul_neg]
  have hsum : LinearIndependent F fun j => Sum.elim (A j) (My j) := by
    have h1 := rows_sum MF hMF
    have h2 : (fun j (v : Fin n ⊕ Fin N) => MF j (finSumFinEquiv v)) = fun j => Sum.elim (A j) (My j) := by
      funext j v
      cases v <;> simp [A, My, MF]
    rw [h2] at h1
    exact h1
  obtain ⟨T, hT⟩ := exists_minor_ne_zero My (linearIndependent_row_of_sum A My C hAC hsum)
  refine ⟨T, fun h0 => hT ?_⟩
  have e : ι (Matrix.of fun j k => MvPolynomial.pderiv (Sum.inr (T k)) (h j)).det = (My.submatrix id T).det := by
    rw [RingHom.map_det]
    rfl
  rw [← e]
  simp only [ι, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, h0, map_zero]

/-- **The `y`-minor**: Jacobian datum of `ker φ` with a `y`-minor not vanishing at `ŷ`. -/
theorem jacobian_minor [PerfectField K] {n N : ℕ} (ŷ : Fin N → MvPowerSeries (Fin n) K) :
    ∃ (r : ℕ) (h : Fin r → MvPolynomial (Fin n ⊕ Fin N) K) (T : Fin r → Fin N), (∀ j, evalHat ŷ (h j) = 0) ∧
      evalHat ŷ (Matrix.of fun j k => MvPolynomial.pderiv (Sum.inr (T k)) (h j)).det ≠ 0 ∧
      ∃ G, evalHat ŷ G ≠ 0 ∧ ∀ q, evalHat ŷ q = 0 → G * q ∈ Ideal.span (Set.range h) := by
  have : IsDomain (MvPowerSeries (Fin n) K) := NoZeroDivisors.to_isDomain _
  have hIp : (RingHom.ker (evalHat ŷ).toRingHom).IsPrime := RingHom.ker_isPrime _
  obtain ⟨r, h, hI, hrows, G, hG, hGI⟩ := jacobian_datum (RingHom.ker (evalHat ŷ).toRingHom)
  have hh : ∀ j, evalHat ŷ (h j) = 0 := fun j => RingHom.mem_ker.mp (hI j)
  obtain ⟨T', hT'⟩ := full_minor_not_mem _ h hrows
  obtain ⟨T, hT⟩ := y_minor_ne_zero ŷ h hh T' fun h0 => hT' (RingHom.mem_ker.mpr h0)
  exact ⟨r, h, T, hh, hT, G, fun h0 => hG (RingHom.mem_ker.mpr h0), fun q hq => hGI q (RingHom.mem_ker.mpr hq)⟩

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA4e

/-! ### piece ArA7a1 -/
section Piece_ArA7a1


/-!
# S4-EtPBC-A, A4 (Artin approximation), ArA7a1: the statement `AA n` and the glue for the induction step

* `AA K n`: every polynomial system over `K[x_1..x_n]` with a power-series solution `ŷ` has a solution in an etale
  neighbourhood of the origin with residues `ŷ(0)`.
* `AA.apply_fintype`: the same for finite index types of variables and equations.
* `etale_mapRingHom`, `etale_thetaS`, `point_thetaS`, `SolNbhd.trans_ringHom`: `K[x_0..x_n] → B'[X]` is etale and
  carries the origin to `eval₂ χ' 0`.
* `cc_coe`, `mkP_coeff_zero`, `mkR_coeff_zero`, `genV_map`, `tmin_evS`: coefficient glue.
-/

set_option autoImplicit false

noncomputable section

open Polynomial

namespace RamanujanPetersson.EtPBC.Cov

universe u

/-- Artin approximation for `K[x_1..x_n]` at the origin. -/
def AA (K : Type u) [Field K] (n : ℕ) : Prop :=
  ∀ (N m : ℕ) (f : Fin m → MvPolynomial (Fin N) (MvPolynomial (Fin n) K)) (ŷ : Fin N → MvPowerSeries (Fin n) K),
    (∀ j, MvPolynomial.aeval ŷ (f j) = 0) →
      SolNbhd (MvPolynomial.constantCoeff : MvPolynomial (Fin n) K →+* K) f
        fun i => MvPowerSeries.constantCoeff (ŷ i)

section PolyAlg

attribute [local instance] Polynomial.algebra

theorem etale_mapRingHom {B B' : Type u} [CommRing B] [CommRing B'] [Algebra B B'] [Algebra.Etale B B'] :
    (Polynomial.mapRingHom (algebraMap B B')).Etale :=
  RingHom.Etale.isStableUnderBaseChange B B' (Polynomial B) (Polynomial B')
    (RingHom.etale_algebraMap.mpr inferInstance)

end PolyAlg

section Glue

variable {K : Type u} [Field K]

theorem AA.apply_fintype {n : ℕ} (hA : AA K n) {ι E : Type} [Fintype ι] [Fintype E]
    (f : E → MvPolynomial ι (MvPolynomial (Fin n) K)) (ŷ : ι → MvPowerSeries (Fin n) K)
    (hf : ∀ e, MvPolynomial.aeval ŷ (f e) = 0) :
    ∃ (B' : Type u) (_ : CommRing B') (_ : Algebra (MvPolynomial (Fin n) K) B')
      (_ : Algebra.Etale (MvPolynomial (Fin n) K) B') (χ' : B' →+* K) (z : ι → B'),
      (∀ b, χ' (algebraMap (MvPolynomial (Fin n) K) B' b) = MvPolynomial.constantCoeff b) ∧ (∀ e, MvPolynomial.aeval z (f e) = 0) ∧
        ∀ u, χ' (z u) = MvPowerSeries.constantCoeff (ŷ u) := by
  classical
  obtain ⟨σ, hσ⟩ : ∃ σ : ι ≃ Fin (Fintype.card ι), σ = Fintype.equivFin ι := ⟨_, rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : E ≃ Fin (Fintype.card E), τ = Fintype.equivFin E := ⟨_, rfl⟩
  have hc : (fun k => ŷ (σ.symm k)) ∘ σ = ŷ := funext fun u => by simp
  obtain ⟨B', i1, i2, i3, χ', y, h1, h2, h3⟩ := hA (Fintype.card ι) (Fintype.card E)
    (fun k => MvPolynomial.rename σ (f (τ.symm k))) (fun k => ŷ (σ.symm k)) (fun k => by
      rw [MvPolynomial.aeval_rename, hc]
      exact hf _)
  refine ⟨B', i1, i2, i3, χ', fun u => y (σ u), h1, fun e => ?_, fun u => (h3 (σ u)).trans (by simp)⟩
  have h4 := h2 (τ e)
  rw [MvPolynomial.aeval_rename, Equiv.symm_apply_apply] at h4
  exact h4

theorem SolNbhd.trans_ringHom {S T : Type u} [CommRing S] [CommRing T] {χ : S →+* K} (φ : S →+* T)
    (hφ : φ.Etale) {χ' : T →+* K} (hχ : ∀ a, χ' (φ a) = χ a) {N m : ℕ} {f : Fin m → MvPolynomial (Fin N) S}
    {c : Fin N → K} (h : SolNbhd χ' (fun j => MvPolynomial.map φ (f j)) c) : SolNbhd χ f c := by
  letI : Algebra S T := φ.toAlgebra
  haveI : Algebra.Etale S T := hφ
  exact SolNbhd.trans (R' := T) hχ h

theorem etale_thetaS {n : ℕ} {B' : Type u} [CommRing B'] [Algebra (MvPolynomial (Fin n) K) B']
    [Algebra.Etale (MvPolynomial (Fin n) K) B'] : (thetaS (theta1 K n) B').Etale := by
  unfold thetaS
  exact RingHom.Etale.stableUnderComposition _ _
    (RingHom.Etale.of_bijective (MvPolynomial.finSuccEquiv K n).bijective) etale_mapRingHom

theorem point_thetaS {n : ℕ} {B' : Type u} [CommRing B'] [Algebra (MvPolynomial (Fin n) K) B'] (χ' : B' →+* K)
    (hχ' : ∀ b, χ' (algebraMap (MvPolynomial (Fin n) K) B' b) = MvPolynomial.constantCoeff b) (p : MvPolynomial (Fin (n + 1)) K) :
    Polynomial.eval₂RingHom χ' 0 (thetaS (theta1 K n) B' p) = MvPolynomial.constantCoeff p := by
  have hR : (Polynomial.eval₂RingHom χ' 0).comp (thetaS (theta1 K n) B') = MvPolynomial.constantCoeff := by
    refine MvPolynomial.ringHom_ext (fun a => ?_) (fun i => ?_)
    · simp [thetaS, MvPolynomial.finSuccEquiv_apply, hχ']
    · cases i using Fin.cases with
      | zero => simp [thetaS, MvPolynomial.finSuccEquiv_X_zero]
      | succ j => simp [thetaS, MvPolynomial.finSuccEquiv_X_succ, hχ']
  exact RingHom.congr_fun hR p

theorem cc_coe {n : ℕ} (b : MvPolynomial (Fin n) K) :
    MvPowerSeries.constantCoeff (algebraMap (MvPolynomial (Fin n) K) (MvPowerSeries (Fin n) K) b) =
      MvPolynomial.constantCoeff b := by
  rw [algebraMap_mvPolynomial_eq, ← MvPowerSeries.coeff_zero_eq_constantCoeff_apply, MvPolynomial.coeff_coe,
    MvPolynomial.constantCoeff_eq]

theorem mkP_coeff_zero {S : Type*} [CommRing S] {d : ℕ} (hd : 0 < d) (a : Fin d → S) :
    (mkP d a).coeff 0 = a ⟨0, hd⟩ := by
  rw [mkP, coeff_add, coeff_X_pow, if_neg (Nat.ne_of_lt hd), zero_add, finsetSum_coeff]
  simp only [coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single ⟨0, hd⟩]
  · simp
  · intro l _ hl
    rw [if_neg]
    intro h
    exact hl (Fin.ext h.symm)
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem mkR_coeff_zero {S : Type*} [CommRing S] {D : ℕ} (hD : 0 < D) (b : Fin D → S) :
    (mkR D b).coeff 0 = b ⟨0, hD⟩ := by
  rw [mkR, finsetSum_coeff]
  simp only [coeff_C_mul_X_pow]
  rw [Finset.sum_eq_single ⟨0, hD⟩]
  · simp
  · intro l _ hl
    rw [if_neg]
    intro h
    exact hl (Fin.ext h.symm)
  · intro h
    exact absurd (Finset.mem_univ _) h

theorem genV_map {B E S : Type*} [CommRing B] [CommRing E] [CommRing S] [Algebra B S] (θ : E →+* B[X])
    {d N D : ℕ} (g : MvPolynomial (Fin N) E) (z : Unk d N D → S) :
    ((evS θ _ g (genR B d N D)) /ₘ genP B d N D).map (MvPolynomial.aeval (R := B) z).toRingHom =
      evS θ S g (Rz z) /ₘ Pz z := by
  have hm : (genP B d N D).Monic := mkP_monic d _
  rw [map_divByMonic _ hm, map_genP, map_evS]
  simp only [map_genR]

theorem tmin_evS {B E S : Type*} [CommRing B] [CommRing E] [CommRing S] [Algebra B S] (θ : E →+* B[X])
    {N r : ℕ} (h : Fin r → MvPolynomial (Fin N) E) (U : Fin r → Fin N) (R : Fin N → S[X]) :
    (tmin (fun j => MvPolynomial.map (thetaS θ S) (h j)) U R).det =
      evS θ S (Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)).det R := by
  have hm : tmin (fun j => MvPolynomial.map (thetaS θ S) (h j)) U R =
      (MvPolynomial.eval₂Hom (thetaS θ S) R).mapMatrix (Matrix.of fun k j => MvPolynomial.pderiv (U k) (h j)) := by
    ext k j
    simp only [tmin, Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply, MvPolynomial.pderiv_map,
      MvPolynomial.eval_map, MvPolynomial.coe_eval₂Hom]
  rw [hm, ← RingHom.map_det]
  rfl

end Glue

end RamanujanPetersson.EtPBC.Cov
end

end Piece_ArA7a1


