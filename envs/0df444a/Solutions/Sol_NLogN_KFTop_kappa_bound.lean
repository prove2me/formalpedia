theorem coefF_ge {Kc : ℝ} (hKc : 0 ≤ Kc) (K D : ℕ) (hD : 1 ≤ D) : (2 : ℝ) ≤ coefF Kc K D := by
  unfold coefF
  have h1 := clF_ge hKc K D hD
  generalize clF Kc K D = c at h1 ⊢
  have h2 : (0 : ℝ) ≤ (((Nat.log (100 ^ 3) D + 1) * 100 ^ 3 : ℕ) : ℝ) := Nat.cast_nonneg _
  have h3 : (0 : ℝ) ≤ ((Nat.log (100 ^ 3) D * 71 : ℕ) : ℝ) := Nat.cast_nonneg _
  generalize (((Nat.log (100 ^ 3) D + 1) * 100 ^ 3 : ℕ) : ℝ) = a at h2 ⊢
  generalize ((Nat.log (100 ^ 3) D * 71 : ℕ) : ℝ) = b at h3 ⊢
  have := mul_nonneg h2 (le_trans (by norm_num) h1)
  linarith

