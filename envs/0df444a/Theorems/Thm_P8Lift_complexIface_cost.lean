theorem P8Lift.complexIface_cost :
    ∃ σc : ℝ, σc < 1 ∧ (sc : ℝ) / Wc = ((100 ^ 3 : ℕ) : ℝ) ^ σc ∧
      ∀ (u : ℕ), 1 ≤ u → ∀ (lam C₀ : ℝ), 0 ≤ lam → σc < lam → 0 ≤ C₀ →
        ∃ K₁ : ℝ, 0 ≤ K₁ ∧ ∀ (Cleaf : ℝ → ℝ), (∀ V, 0 ≤ V → Cleaf V ≤ C₀ * V * u) →
          ∀ k V, 0 ≤ V → recCost complexIface.toIface u
            (fun _ V => (complexIface.nloc * Wc : ℝ) * V) Cleaf k V ≤
            V * (K₁ * ((u : ℝ) * ((100 ^ 3 : ℕ) : ℝ) ^ k) ^ lam +
              C₀ * (((u : ℝ) * ((100 ^ 3 : ℕ) : ℝ) ^ k) ^ σc * (u : ℝ) ^ (1 - σc))) := by sorry
