theorem eNF_den {v : Vr} {d s : ℕ} (h6 : v 6 = lamF d) (h26 : v 26 = wF d) (h22 : v 22 = s) :
    eNF.den v = ((NF d s : ℕ) : ℤ) := by
  simp only [eNF, E.den, h6, h26, h22]; unfold NF; push_cast; ring

theorem seg_cast (p d s : ℕ) :
    (segPF p d s : ℤ) = p + 1 + (p : ℤ) / 7 + (Nat.size (NF d s) : ℤ) := by
  unfold segPF; push_cast; ring

/-- `NF`, `Q`, `2^Q`. -/
theorem Rn.ph3a_sol_aux {s p d W : ℕ} {c : Cs} (hcL : c cLC = []) {vb : Vr} (hb : BV W vb)
    (h1 : vb 1 = p) (h6 : vb 6 = lamF d) (h26 : vb 26 = wF d) (h22 : vb 22 = s)
    (h21 : vb 21 = ((p / 7 : ℕ) : ℤ))
    (bNF : NF d s + 1 < 2 ^ W) (bQ : 2 ^ (segPF p d s + 2) < 2 ^ W) (b1500 : 1500 + 8 < 2 ^ W) :
    Rn ph3a vb c (fun v => v 9 = ((2 ^ segPF p d s : ℕ) : ℤ) ∧ v 20 = segPF p d s ∧
      (∀ j : Fin HS, j ≠ 7 → j ≠ 8 → j ≠ 9 → j ≠ 11 → j ≠ 20 → v j = vb j) ∧
      BV W v) c (cPh3a W (NF d s) (segPF p d s)) := by
  have hsz : Nat.size (NF d s) ≤ NF d s := by rw [Nat.size_le]; exact Nat.lt_two_pow_self
  have hp2 : 2 ^ segPF p d s ≤ 2 ^ (segPF p d s + 2) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hQl : segPF p d s < 2 ^ (segPF p d s + 2) :=
    lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_right (by norm_num) (by omega))
  have hpos : (0 : ℤ) ≤ 2 ^ W := by positivity
  have hW1 : 1 ≤ 2 ^ W := Nat.one_le_two_pow
  have h21' : vb 21 = (p : ℤ) / 7 := by rw [h21]; push_cast; rfl
  have eN := eNF_den h6 h26 h22
  -- NF
  refine Rn.seq (Rn.asgs pA3 (by decide) (by simp [pA3, eNF, lbA, E.lb]; omega) hb (by
    simp only [pA3, BndA]
    refine ⟨?_, ?_, ?_, trivial⟩
    · rw [eN, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)
    · simp [E.den, hpos]
    · simp only [E.den, update_apply]; simp
      rw [eN, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)))
    (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  have a7 : runA pA3 vb 7 = NF d s := by simp [pA3, runA, update_apply, eN]
  have a11 : runA pA3 vb 11 = NF d s := by simp [pA3, runA, update_apply, E.den, eN]
  have a8 : runA pA3 vb 8 = 0 := by simp [pA3, runA, update_apply, E.den]
  have aF : ∀ j : Fin HS, j ≠ 7 → j ≠ 8 → j ≠ 11 → runA pA3 vb j = vb j := by
    intro j b7 b8 b11; simp [pA3, runA, update_apply, b7, b8, b11]
  refine Rn.seq (szL (x := NF d s) b1 a8 a11 a7 (by omega) hcL) (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  set u := update (update (runA pA3 vb) 8 (Nat.size (NF d s) : ℤ)) 11 0 with hu
  have u1 : u 1 = p := by rw [hu]; simp [update_apply, aF 1 (by decide) (by decide) (by decide), h1]
  have u21 : u 21 = (p : ℤ) / 7 := by
    rw [hu]; simp [update_apply, aF 21 (by decide) (by decide) (by decide), h21']
  have u8 : u 8 = Nat.size (NF d s) := by rw [hu]; simp [update_apply]
  -- Q
  refine Rn.seq (Rn.asgs pA4 (by decide) (by simp [pA4, lbA, E.lb]; omega) b1 (by
    simp only [pA4, BndA, E.den]
    refine ⟨?_, by simp; exact_mod_cast hW1, trivial⟩
    rw [u1, u21, u8, ← seg_cast, abs_of_nonneg (by positivity)]; exact_mod_cast (by omega)))
    (fun v1 ⟨e1, b1⟩ => ?_)
  subst e1
  have w20 : runA pA4 u 20 = segPF p d s := by
    simp only [pA4, runA, E.den]; rw [u1, u21, u8, ← seg_cast]; simp [update_apply]
  have w9 : runA pA4 u 9 = 1 := by simp [pA4, runA, update_apply, E.den]
  refine (pwL (x := 9) (rc := 20) (N := segPF p d s) (by decide) (by decide) (by decide) b1
    w9 w20 (by omega) (by omega) (by omega) hcL).mono (fun v1 ⟨e1, b1⟩ => ?_) le_rfl
  subst e1
  refine ⟨by simp, by simp [update_apply, w20], ?_, b1⟩
  intro j b7 b8 b9 b11 b20
  have : runA pA4 u j = u j := by simp [pA4, runA, update_apply, b9, b20]
  rw [update_apply, if_neg b9, this, hu, update_apply, if_neg b11, update_apply, if_neg b8,
    aF j b7 b8 b11]

end J6Seg.PJ

