theorem charP_residueField (Pl : ValuationSubring (AlgebraicClosure ℚ)) (hPl : Pl.LiesOverPrime p) :
    CharP (IsLocalRing.ResidueField ↥Pl) p :=
  ValuationSubring.charP_residueField_of_liesOverPrime p Pl hPl

