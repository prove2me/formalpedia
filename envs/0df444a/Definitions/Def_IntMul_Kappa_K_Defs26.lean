variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ)

/-! ### The chunk rounds are Proposition 14's layer -/

/-- `e = qK - 1 - (h - b)`. -/
def eIdx (h : ℕ) : ℕ := Synth.qq ℓ K * K - 1 - (h - bb ℓ K)
/-- The chunk group `j₀ = ⌊e/K⌋` of round `h`. -/
def jGrp (h : ℕ) : ℕ := eIdx ℓ K h / K
/-- The common offset `ρ = (h - b) mod K`. -/
def rhoOf (h : ℕ) : ℕ := (h - bb ℓ K) % K
/-- Prefix bits before chunk group `j₀`: `A = |Lst| + j₀ D K`. -/
def preA (h : ℕ) : ℕ := (lstL D ℓ K long).length + jGrp ℓ K h * D * K
/-- Suffix bits after chunk group `j₀`: `B = (q - 1 - j₀) D K`. -/
def sufB (h : ℕ) : ℕ := (Synth.qq ℓ K - 1 - jGrp ℓ K h) * D * K

lemma rhoOf_lt (hK : 0 < K) (h : ℕ) : rhoOf ℓ K h < K := Nat.mod_lt _ hK

end Paper

