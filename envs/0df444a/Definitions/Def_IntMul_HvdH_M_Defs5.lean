-- Source module: NLogN.HCrLoops
/-! # Small counted loops: popping, pushing zeros, pushing `0, …, n-1` (namespace `NLogN.CR`) -/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS

/-! ## Popping `n` integers -/

def dropN (i C : Fin HS) (n : Ex HS) : RS := rep C n (pop i)

/-! ## Pushing `n` zeros -/

def zerosP (i C : Fin HS) (n : Ex HS) : RS := rep C n (push i (.lit 0))

/-! ## Pushing `0, 1, …, n-1` (`0` on top) -/

def rangeP (i C : Fin HS) (n : Ex HS) : RS := rep C n (push i (.add (.reg C) (.lit (-1))))

def rangeZ (N k : ℕ) : List ℤ := (List.range k).map fun j => ((N - k + j : ℕ) : ℤ)

end NLogN.CR

end

