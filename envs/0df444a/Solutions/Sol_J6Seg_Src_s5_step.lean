theorem nB_sp (s0 : IState HS) (F : Fin HS → List ℤ) {A : ℕ} (hA : 2 ≤ A) :
    Sp nB (encK s0 F) (encK s0 (update F 44 ((-1) :: 0 :: F 44))) (4 * uC A DD) := by
  have h1 := lit_sp s0 F (i := 44) (by decide) 0 (by simp) (by decide) hA
  have h2 := lit_sp s0 (update F 44 (0 :: F 44)) (i := 44) (by decide) (-1)
    (by simp; exact one_le_pow₀ (by norm_num)) (by decide) hA
  simp only [update_self, update_idem] at h2
  exact (h1.seq h2).mono (by omega)

/-- The test `v > 0` for `v` on `R`. -/
theorem iteN (s0 : IState HS) (F : Fin HS → List ℤ) {R : Fin HS} (hR5 : R.val < 56) {v : ℤ}
    {l : List ℤ} (hRv : F R = v :: l) {A : ℕ} (hvA : |v| ≤ 2 ^ A) (hA : 2 ≤ A) {a b : RS}
    {t : IState HS} {C : ℕ} (ha : 0 < v → Sp a (encK s0 F) t C)
    (hb : ¬ 0 < v → Sp b (encK s0 F) t C) (hC : 10 * uC A DD ≤ C) :
    Sp (.ite (.neg (.reg R)) a b) (encK s0 F) t (2 * C + 200 * (A * DD + 1 + 1)) := by
  have hv : (Ex.neg (.reg R) : Ex HS).eval (encK s0 F) = -v := by
    simp only [Ex.eval, topv hRv]
  refine iteG s0 F (e := .neg (.reg R)) (clean_of_regs' (fun r hr => by
      simp only [Ex.regs, List.mem_cons, List.not_mem_nil, or_false] at hr
      subst hr; exact hR5)) (isInt_encK hRv) (by simp [Ex.Lin])
    (fun r hr => by
      simp only [Ex.regs, List.mem_cons, List.not_mem_nil, or_false] at hr
      subst hr; rw [topv hRv]; exact hvA) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg, DD])
    (fun h => ha (by rw [hv] at h; omega)) (fun h => hb (by rw [hv] at h; omega))
    (le_trans (Nat.mul_le_mul_right _ (by simp [Ex.size])) hC)

/-- The test `v < u` for `v` on `R` and `u + 1` on `43`. -/
theorem iteD (s0 : IState HS) (F : Fin HS → List ℤ) {R : Fin HS} (hR5 : R.val < 56) {v : ℤ}
    {l : List ℤ} (hRv : F R = v :: l) {u A : ℕ} (h43 : F 43 = ((u : ℤ) + 1) :: [])
    (hvA : |v| ≤ 2 ^ A) (huA : u + 1 ≤ 2 ^ A) (hA : 2 ≤ A) {a b : RS}
    {t : IState HS} {C : ℕ} (ha : v < u → Sp a (encK s0 F) t C)
    (hb : ¬ v < u → Sp b (encK s0 F) t C) (hC : 10 * uC A DD ≤ C) :
    Sp (.ite (.add (.reg R) (.neg jB)) a b) (encK s0 F) t (2 * C + 200 * (A * DD + 1 + 1)) := by
  have hv : (Ex.add (.reg R) (.neg jB) : Ex HS).eval (encK s0 F) = v - u := by
    simp only [jB, Ex.eval, topv h43, topv hRv]; ring
  refine iteG s0 F (e := .add (.reg R) (.neg jB)) (clean_of_regs' (fun r hr => by
      simp only [jB, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
        List.append_nil] at hr
      rcases hr with rfl | rfl
      · exact hR5
      · decide))
    ⟨isInt_encK hRv, ⟨isInt_encK h43, trivial⟩⟩ (by simp [jB, Ex.Lin])
    (fun r hr => by
      simp only [jB, Ex.regs, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
        List.append_nil] at hr
      rcases hr with rfl | rfl
      · rw [topv hRv]; exact hvA
      · rw [topv h43]; have := abs_nat_le huA; push_cast at this; exact this) hA
    (by simp [jB, J6Seg.PreT.Poly]) (by simp [jB, J6Seg.PreT.dg, DD])
    (fun h => ha (by rw [hv] at h; omega)) (fun h => hb (by rw [hv] at h; omega))
    (le_trans (Nat.mul_le_mul_right _ (by simp [Ex.size, jB])) hC)

