open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII04

/-! ## Limits of `Y`, `Y'`, `K_s`, `k_s(1/R)` at the horizon -/

/-- The primitive `x ↦ ∫₀ˣ k_s`. -/
noncomputable def Kprim (j : ℝ) (q : ℝ → ℝ) (u : ℝ) : ℝ := ∫ t in (0 : ℝ)..u, kfun j q t

/-! ## The horizon values of `b_s` and `b_s'` -/

/-- `b_s'(3⁺) = -K_s(1/3) + s(a)/18`. -/
noncomputable def MbFun (j : ℝ) (q : ℝ → ℝ) : ℝ := -Kfun j q 3 + sfun j q aG / 18

/-! ## The affine extension across `R = 3` -/

noncomputable def bext (j : ℝ) (q : ℝ → ℝ) (R : ℝ) : ℝ :=
  if R ≤ 3 then bfun j q 3 + MbFun j q * (R - 3) else bfun j q R

/-! ## `bext ∈ C¹` across the horizon -/

/-! ## `MagClass 3 (b_s)` -/

