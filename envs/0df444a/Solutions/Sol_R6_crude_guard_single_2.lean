/-!
# Round six: the crude depth guard (PR15 REPORT part B, ARCH G1)

`A e` is the coefficient-dependency depth of a `C`-layer of width `e` (OpenAI §5.4).  At width
`e ≥ T` a node is a sequence of at most `s` child invocations, each of width `≤ (m-1)e/m`
(stated as `m * c ≤ (m-1) * e`), plus `E` arithmetic of its own:
`A e ≤ E + Σ_{c ∈ cs} A c`.  Below the threshold `T` the depth is at most `L`.

* `R6.guard_gen`: `A e ≤ (E+L) (2 s^{max 0 (m (log e - log T) + 1)} - 1)` (any `s ≥ 2`).
* `R6.crude_guard`: with `T = d^β`, `L = 8 d^β`, for `e ≤ d`:
  `A e ≤ 2 (E + 8 d^β) s^{1 + m (1-β) log d}`.
* `R6.crude_guard_single`: the same for the one-child form `A e ≤ E + s A ((m-1) e / m)`.
* `R6.crude_guard_pow`: `A e ≤ C₀ d^{β + m(1-β) log s}`, `C₀ = 2 s (E+8)`.
* `R6.crude_guard_C1`, `R6.crude_guard_nat`: `A e ≤ C₀ d^{C1}` for `C1 ≥ 2 + m log s`
  (natural-number form for a guard width `Δ = C₀ d^{C1}`).
* `R6.level_unroll`: the level-indexed form `D (k+1) ≤ E + s D k` (the shape of `KFN.Eb L s`):
  `D k ≤ (E + D 0) (2 s^k - 1)`.

`s ≥ 2` is needed (for `s = 1` the depth is `≈ k E`, not `O(E)`).
-/

namespace R6

open Real

/-- The one-child form of the task: `A e ≤ E + s A ((m-1) e / m)`. -/
theorem crude_guard_single_sol_aux (E : ℝ) (s m : ℕ) (d β : ℝ) (A : ℕ → ℝ) (hm : 2 ≤ m) (hs : 2 ≤ s)
    (hβ : 0 ≤ β ∧ β ≤ 1) (hd : 1 ≤ d) (hE : 0 ≤ E)
    (hrec : ∀ e : ℕ, d ^ β ≤ e → A e ≤ E + s * A ((m - 1) * e / m))
    (hleaf : ∀ e : ℕ, (e : ℝ) < d ^ β → A e ≤ 8 * d ^ β) :
    ∀ e : ℕ, (e : ℝ) ≤ d → A e ≤ 2 * (E + 8 * d ^ β) * (s : ℝ) ^ (1 + m * (1 - β) * Real.log d) := by
  refine crude_guard E s m d β A hm hs hβ hd hE (fun e he => ?_) hleaf
  refine ⟨List.replicate s ((m - 1) * e / m), by simp, fun c hc => ?_, ?_⟩
  · rw [List.eq_of_mem_replicate hc]; exact Nat.mul_div_le _ _
  · simpa [List.map_replicate, List.sum_replicate, nsmul_eq_mul] using hrec e he

end R6

end

theorem solution : type_of% @R6.crude_guard_single_sol_aux := @R6.crude_guard_single_sol_aux
