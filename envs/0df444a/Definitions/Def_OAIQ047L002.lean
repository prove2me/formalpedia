noncomputable def sourceTorus (z : ℂ) (hz : ‖z‖=1) : SourceSU2 := by
  let A : Matrix (Fin 2) (Fin 2) ℂ := Matrix.diagonal (fun i => if i=0 then z else star z)
  have hzz : z*(starRingEnd ℂ) z=1 := by simpa [hz] using Complex.mul_conj' z
