-- title:
--   Two-divisibility of inertia displacements in Eisenstein torsion
-- statement:
--   Let $p$ be a prime and let $B$ be a valuation subring of $\overline{\mathbf Q} =$ `AlgebraicClosure ℚ` lying over $2$, in the sense that $2$ belongs to the nonunits of $B$. Write $J =$ `JZero p` for the degree-zero part of the divisor class group of the base-changed full modular function field of level $p$ over $\overline{\mathbf Q}$ (degree-zero divisors modulo principal ones), equipped with its action of $\overline{\mathbf Q} \simeq_{\mathbf Q} \overline{\mathbf Q}$ and with the Hecke-algebra module structure `heckeModuleBar p`, $\mathbf T =$ `HeckeAlg` $= \mathbf Z[X_\ell : \ell \text{ prime}]$. Let $D \le J$ be the additive subgroup generated by all displacements $\sigma \cdot x - x$, where $\sigma$ lies in the image of the inertia subgroup of $B$ over $\mathbf Q$ inside $\overline{\mathbf Q} \simeq_{\mathbf Q} \overline{\mathbf Q}$ and $x$ is annihilated by the $M$-th power of the Eisenstein ideal `eisensteinMaximalIdeal p 2` (the pullback along `eisensteinEval p` of the ideal $(2)$ of $\mathbf Z$) for some $M \in \mathbf N$. The assertion is: for every $m \in \mathbf N$ and every $y \in J[2^m] \cap D$ there exists $z \in J[2^{m+1}] \cap D$ with $2z = y$; here $J[2^k]$ denotes the $\mathbf Z$-torsion of $J$ at $2^k$.
--
--   This is the level-by-level $2$-divisibility of the inertia-displacement subgroup of the Eisenstein torsion of $J_0(p)$ at a place above $2$, in the style of Mazur's analysis of the Eisenstein ideal. It feeds the construction of a homomorphism out of the $2^m$-torsion displacement subgroups with controlled kernel, used in the multiplicative-type analysis of the $2$-adic Galois action.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_exists_two_nsmul_eq_of_mem_torsionBy_two_pow_inf_closure_inertia_smul_sub.lean

import Definitions.Def_ModularCurve_JZeroNeronTorsionSheafV4
import Definitions.Def_FLTPrelim_Ramification

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open ModularCurve

theorem ModularCurve.exists_two_nsmul_eq_of_mem_torsionBy_two_pow_inf_closure_inertia_smul_sub
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    ∀ m : ℕ, ∀ y ∈ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓
        AddSubgroup.closure
          {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
            ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x},
      ∃ z ∈ (Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ (m + 1))).toAddSubgroup ⊓
        AddSubgroup.closure
          {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
            ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x},
        2 • z = y := by sorry
