-- Source module: Solutions.KFV24Proc
/-!
# KFV §28: the uniform rounds and Lemma 16 (forward and opposite) as fixed IL code

* `layC e14`: the run-time dispatcher of the layer of round `h` (on `gH`): prefix (`h < b`),
  chunk (`h < ℓ - 1`, the Proposition 14 call `e14`), top. **`layerU_layC`**.
* `rndF`, `rndO`: forward round (`layer ; J_E`) and opposite round (`J_{-E} ; layer`).
* `fwdC e14`, `oppC e14`: `gH` is pushed (`ℓ` resp. `0`), a unary loop of `ℓ` rounds on the frame
  stacks `qX, qB, qZ` updates it, and it is popped. **`fwdC_ok`**, **`oppC_ok`**: they compute
  `procQc` / `procQIc` of the paper's layout (Lemma 16 computed forward / opposite procedure).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT AModel Butterfly

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## The code -/

/-- `h - b` (negative iff prefix round). -/
def eHB : Ex HS := .add (.reg gH) (.neg (.reg gBb))

/-- `h + 1 - ℓ` (negative iff not the top round). -/
def eHL : Ex HS := .add (.add (.reg gH) (.lit 1)) (.neg (.reg gLl))

/-- The layer of the current round. -/
def layC (e14 : Fin Pp) : IStmt HS Pp :=
  iteI eHB (fcode preC) (iteI eHL (chunkC e14) NLogN.KFV.topC)

/-- A forward round. -/
def rndF (e14 : Fin Pp) : IStmt HS Pp := .seq (layC e14) (twistU false)

/-- An opposite round. -/
def rndO (e14 : Fin Pp) : IStmt HS Pp := .seq (twistU true) (layC e14)

/-- `gH ← gH + d`. -/
def stepH (d : ℤ) : RS := .asg gH (.add (.reg gH) (.lit d))

/-- The forward procedure (rounds `ℓ-1, …, 0`). -/
def fwdC (e14 : Fin Pp) : IStmt HS Pp :=
  .seq (fcode (.push gH (.reg gLl)))
    (.seq (rptX gLl qX NLogN.KFV.qB qZ (.seq (fcode (stepH (-1))) (NLogN.KFV.rndF e14))) (fcode (.pop gH)))

/-- The opposite procedure (rounds `0, …, ℓ-1`). -/
def oppC (e14 : Fin Pp) : IStmt HS Pp :=
  .seq (fcode (.push gH (.lit 0)))
    (.seq (rptX gLl qX NLogN.KFV.qB qZ (.seq (rndO e14) (fcode (stepH 1)))) (fcode (.pop gH)))

/-! ## Contexts -/

/-- The context of the procedures: a round frame (any round register) and `p, W, Z`. -/
def PCtx (L : LP) (fl : List Bool) (p W Z : ℕ) (s : IState HS) : Prop :=
  ∃ s1 fG rG h0, s = encK s1 fG ∧ GRegs s1 fG L h0 ∧ fG gLG = fl.map fv ++ rG ∧
    (∀ j ∈ twFree, fG j = []) ∧ XR s p W Z

/-- The context of a round. -/
def RX (L : LP) (fl : List Bool) (h p W Z : ℕ) (s : IState HS) : Prop :=
  RCtx L fl h s ∧ XR s p W Z

/-- Cost of `stepH d`. -/
def cStepH (d : ℤ) (B : ℕ) : ℕ := ((Ex.add (.reg gH) (.lit d) : Ex HS).size + 1) * 2000 * (B + 2)

/-! ## The dispatcher -/

section Paper

open Synth GlueLayout GlueP14 GlueError

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

/-- Cost of the layer of round `h` (the branch taken). -/
def cLayC (h W B cCh : ℕ) : ℕ :=
  cIteB 4 B + cIteB 6 B +
    (if h < bb ℓ K then cLeafR (ePre.size + (Ex.reg NLogN.KFV.gD : Ex HS).size + eSpre.size)
      (NLogN.KFV.preP D ℓ K long h) D (sufP D ℓ K long h) ℓ W B
    else if h < ℓ - 1 then cCh
    else cTopC D ℓ K long ((Ex.lit 0 : Ex HS).size + (Ex.reg gNL : Ex HS).size +
      (Ex.add (.reg gNn) (.neg (.reg gNL)) : Ex HS).size) W B)

/-- The chunk rounds are implemented by `chunkC e14`. -/
def ChunkU (I : List Sym) (iprog : Fin Pp → IStmt HS Pp) (e14 : Fin Pp) (hK : 0 < K) (hℓ : 1 ≤ ℓ)
    (p W Z cCh : ℕ) : Prop :=
  ∀ h, bb ℓ K ≤ h → h < ℓ - 1 →
    LayerU (r := 2 ^ ℓ) I iprog (RX (pLP D ℓ K long) (flOf D long) h p W Z) (chunkC e14)
      (layerQc p (paperSel D ℓ K long hK hℓ h)) (2 ^ NLogN.KFV.nB D ℓ K long) p W cCh

/-- The bound `U` of the twists. -/
def TwB (U : ℕ) : Prop :=
  D ≤ U ∧ (tgtL D ℓ K long).length ≤ U ∧ 3 * 2 ^ (ℓ + 1) ≤ U ∧
    2 ^ (tgtL D ℓ K long).length + 1 ≤ U ∧ D * ℓ ≤ U

/-- Cost of a forward round. -/
def cRndF (h W B cCh U : ℕ) : ℕ :=
  cLayC D ℓ K long h W B cCh + cTwistU (tgtL D ℓ K long).length ℓ D h
    (genG (pLP D ℓ K long) (flOf D long) false h).length W (zsz (U : ℤ))

/-- Cost of an opposite round. -/
def cRndO (h W B cCh U : ℕ) : ℕ :=
  cTwistU (tgtL D ℓ K long).length ℓ D h
    (genG (pLP D ℓ K long) (flOf D long) true h).length W (zsz (U : ℤ)) + cLayC D ℓ K long h W B cCh

/-- Cost of the forward procedure. -/
def cFwd (W B cCh U : ℕ) : ℕ :=
  ((Ex.reg gLl : Ex HS).size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
    (((∑ k ∈ Finset.range ℓ, (cStepH (-1) B + cRndF D ℓ K long (ℓ - 1 - k) W B cCh U + 64)) +
      60 + cRpt ℓ + (dupCost (zsz (ℓ : ℤ)) + 17)) + (2 * B + 2))

/-- Cost of the opposite procedure. -/
def cOpp (W B cCh U : ℕ) : ℕ :=
  ((Ex.lit 0 : Ex HS).size + 1) * 10 ^ 7 * (B + 2) ^ 2 +
    (((∑ k ∈ Finset.range ℓ, (cRndO D ℓ K long k W B cCh U + cStepH 1 B + 64)) +
      60 + cRpt ℓ + (dupCost (zsz (ℓ : ℤ)) + 17)) + (2 * B + 2))

end Paper

end NLogN.KFV

end

