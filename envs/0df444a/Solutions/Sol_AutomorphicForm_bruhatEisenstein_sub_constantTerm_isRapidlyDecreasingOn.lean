section ArchDirTheta

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F}

private def archDirCθ (hw : w.IsComplex) (θ : ℝ) : ℝ →+ InfiniteAdeleRing F where
  toFun t := (Pi.single w ((ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I))) :
    (v : InfinitePlace F) → v.Completion)
  map_zero' := by rw [Complex.ofReal_zero, zero_mul, map_zero, Pi.single_zero]; rfl
  map_add' s t := by rw [Complex.ofReal_add, add_mul, map_add, Pi.single_add]; rfl

omit [NumberField F] in
private theorem archDirCθ_apply (hw : w.IsComplex) (θ t : ℝ) :
    archDirCθ hw θ t = (Pi.single w ((ringEquivComplexOfIsComplex hw).symm
      ((t : ℂ) * Complex.exp (θ * Complex.I))) : (v : InfinitePlace F) → v.Completion) := rfl

omit [NumberField F] in
private theorem archDirCθ_apply_self (hw : w.IsComplex) (θ t : ℝ) :
    archDirCθ hw θ t w = (ringEquivComplexOfIsComplex hw).symm ((t : ℂ) * Complex.exp (θ * Complex.I)) := by
  rw [archDirCθ_apply]; exact Pi.single_eq_same _ _

omit [NumberField F] in
private theorem archDirCθ_apply_of_ne (hw : w.IsComplex) (θ t : ℝ) {v : InfinitePlace F} (hvw : v ≠ w) :
    archDirCθ hw θ t v = 0 := by
  rw [archDirCθ_apply]; exact Pi.single_eq_of_ne hvw _

private theorem fst_mul_archDirCθ (hw : w.IsComplex) (τ : AdeleRing (𝓞 F) F) (θ t : ℝ) :
    τ.1 * archDirCθ hw θ t
      = archDirCθ hw (θ + (ringEquivComplexOfIsComplex hw (τ.1 w)).arg) (‖τ.1 w‖ * t) := by
  funext v
  show τ.1 v * archDirCθ hw θ t v
    = archDirCθ hw (θ + (ringEquivComplexOfIsComplex hw (τ.1 w)).arg) (‖τ.1 w‖ * t) v
  by_cases hv : v = w
  · subst hv
    rw [archDirCθ_apply_self, archDirCθ_apply_self]
    conv_lhs => rw [← RingEquiv.symm_apply_apply (ringEquivComplexOfIsComplex hw) (τ.1 v),
      ← map_mul]
    congr 1
    have hnorm : ‖ringEquivComplexOfIsComplex hw (τ.1 v)‖ = ‖τ.1 v‖ := by
      rw [ringEquivComplexOfIsComplex_apply]
      exact (isometry_extensionEmbedding v).norm_map_of_map_zero (map_zero _) _
    set E : ℂ := ringEquivComplexOfIsComplex hw (τ.1 v) with hE
    calc E * ((t : ℂ) * Complex.exp (θ * Complex.I))
        = (‖E‖ * Complex.exp (E.arg * Complex.I)) * ((t : ℂ) * Complex.exp (θ * Complex.I)) := by
          rw [Complex.norm_mul_exp_arg_mul_I]
      _ = ((‖E‖ : ℂ) * t) * (Complex.exp (θ * Complex.I) * Complex.exp (E.arg * Complex.I)) := by ring
      _ = ((‖τ.1 v‖ * t : ℝ) : ℂ) * Complex.exp (((θ + E.arg : ℝ) : ℂ) * Complex.I) := by
          rw [← Complex.exp_add, hnorm, Complex.ofReal_mul, Complex.ofReal_add, add_mul]
  · rw [archDirCθ_apply_of_ne hw θ t hv, archDirCθ_apply_of_ne hw _ _ hv, mul_zero]

private theorem ringEquiv_mixedSpace_archDirCθ (hw : w.IsComplex) (θ t : ℝ) :
    ringEquiv_mixedSpace F (archDirCθ hw θ t)
      = (t * Real.cos θ) • stdBasis F (Sum.inr (⟨w, hw⟩, 0))
        + (t * Real.sin θ) • stdBasis F (Sum.inr (⟨w, hw⟩, 1)) := by
  rw [ringEquiv_mixedSpace_apply, stdBasis_inr, stdBasis_inr]
  refine Prod.ext (funext fun v => ?_) (funext fun v => ?_)
  · have hv' : (v : InfinitePlace F) ≠ w := fun h => (not_isReal_iff_isComplex.mpr hw) (h ▸ v.2)
    show extensionEmbeddingOfIsReal v.2 (archDirCθ hw θ t v)
      = ((t * Real.cos θ) • (0 : {v : InfinitePlace F // v.IsReal} → ℝ)
        + (t * Real.sin θ) • (0 : {v : InfinitePlace F // v.IsReal} → ℝ)) v
    rw [archDirCθ_apply_of_ne hw θ t hv', map_zero, Pi.add_apply, Pi.smul_apply, Pi.zero_apply,
      smul_zero, Pi.smul_apply, Pi.zero_apply, smul_zero, add_zero]
  · show extensionEmbedding v.1 (archDirCθ hw θ t v)
      = ((t * Real.cos θ) • (Pi.single (⟨w, hw⟩ : {v : InfinitePlace F // v.IsComplex}) (cUnit 0)
          : {v : InfinitePlace F // v.IsComplex} → ℂ)
        + (t * Real.sin θ) • (Pi.single (⟨w, hw⟩ : {v : InfinitePlace F // v.IsComplex}) (cUnit 1)
          : {v : InfinitePlace F // v.IsComplex} → ℂ)) v
    rcases eq_or_ne v (⟨w, hw⟩ : {v : InfinitePlace F // v.IsComplex}) with rfl | hv
    · rw [archDirCθ_apply_self, ← ringEquivComplexOfIsComplex_apply hw, RingEquiv.apply_symm_apply,
        Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, Pi.smul_apply, Pi.single_eq_same,
        cUnit_zero, cUnit_one, Complex.real_smul, Complex.real_smul]
      rw [Complex.exp_mul_I]
      push_cast
      ring
    · have hv' : (v : InfinitePlace F) ≠ w := fun h => hv (Subtype.ext h)
      rw [archDirCθ_apply_of_ne hw θ t hv', map_zero, Pi.add_apply, Pi.smul_apply,
        Pi.single_eq_of_ne hv, Pi.smul_apply, Pi.single_eq_of_ne hv, smul_zero, smul_zero, add_zero]

private def dirCoordθ (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥) (θ : ℝ) : LevelIndex F 𝔫 h𝔫 → ℝ :=
  fun i => Real.cos θ * dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 0)) i
    + Real.sin θ * dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 1)) i

private theorem adelicTorusMap_archDirCθ (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥) (θ t : ℝ) :
    adelicTorusMap F 𝔫 h𝔫 (archDirCθ hw θ t) = dirFlow (dirCoordθ hw 𝔫 h𝔫 θ) t := by
  rw [adelicTorusMap_apply, ringEquiv_mixedSpace_archDirCθ]
  funext i
  rw [torusMap_apply, dirFlow_apply]
  congr 1
  rw [map_add, map_smul, map_smul, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply,
    smul_eq_mul, smul_eq_mul, dirCoordθ, dirCoordSig, dirCoordSig]
  ring

private theorem dirFreq_dirCoordθ (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥) (θ : ℝ)
    (m : LevelIndex F 𝔫 h𝔫 → ℤ) :
    dirFreq m (dirCoordθ hw 𝔫 h𝔫 θ)
      = Real.cos θ * dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 0)))
        + Real.sin θ * dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 1))) := by
  simp only [dirFreq, dirCoordθ]
  rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun i _ => ?_
  ring

private def pairFreq (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥) (m : LevelIndex F 𝔫 h𝔫 → ℤ) : ℝ :=
  Real.sqrt ((dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 0)))) ^ 2
    + (dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 1)))) ^ 2)

private theorem pairFreq_nonneg (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥)
    (m : LevelIndex F 𝔫 h𝔫 → ℤ) : 0 ≤ pairFreq hw 𝔫 h𝔫 m := Real.sqrt_nonneg _

private theorem exists_angle_dirFreq_eq_pairFreq (hw : w.IsComplex) (𝔫 : Ideal (𝓞 F)) (h𝔫 : 𝔫 ≠ ⊥)
    (m : LevelIndex F 𝔫 h𝔫 → ℤ) (hm : pairFreq hw 𝔫 h𝔫 m ≠ 0) :
    ∃ θ : ℝ, dirFreq m (dirCoordθ hw 𝔫 h𝔫 θ) = pairFreq hw 𝔫 h𝔫 m := by
  set ℓ₀ : ℝ := dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 0))) with hℓ₀
  set ℓ₁ : ℝ := dirFreq m (dirCoordSig F 𝔫 h𝔫 (Sum.inr (⟨w, hw⟩, 1))) with hℓ₁
  set z : ℂ := ⟨ℓ₀, ℓ₁⟩ with hz
  have hsq : pairFreq hw 𝔫 h𝔫 m ^ 2 = ℓ₀ ^ 2 + ℓ₁ ^ 2 := by
    simp only [pairFreq]
    exact Real.sq_sqrt (by positivity)
