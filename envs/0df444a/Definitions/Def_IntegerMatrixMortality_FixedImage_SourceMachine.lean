/-- Representatives of exactly the four triples in Table 2. -/
def mergeState (q : ℕ) : ℕ :=
  if q = 150 ∨ q = 270 then 45
  else if q = 151 ∨ q = 271 then 46
  else if q = 230 ∨ q = 256 then 200
  else if q = 231 ∨ q = 257 then 201 else q

def mapInstruction (f : ℕ → ℕ) : MachineInstruction → MachineInstruction
  | .inc c r => .inc c (f r)
  | .dec c r s => .dec c (f r) (f s)
  | .halt => .halt


