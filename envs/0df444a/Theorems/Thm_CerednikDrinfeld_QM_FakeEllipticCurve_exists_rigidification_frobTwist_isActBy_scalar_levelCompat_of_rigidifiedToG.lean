            (Ξ B ψ hB ⟨E, ρ⟩) (Ξ B (frobTwist Onr Fr (-1) ψ) hB ⟨E, ρm⟩) ∧
          (∀ (ℓ : ℕ) [Fact ℓ.Prime], ℓ ≠ r → IsUnit ((ℓ : ℕ) : B) → ∀ (K₀ : A₀.ExtraLevel ℓ) (C C' : E.ExtraLevel ℓ),
