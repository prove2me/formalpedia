open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp

/-- Relocation of the table builders. -/
def σB : Equiv.Perm (Fin HS) := swapsPerm [(49, 34), (50, 36), (23, 37), (22, 46), (6, 39), (8, 40)]

/-- Arithmetic side conditions of the table builders. -/
structure TabHyp (p s t α Bq : ℕ) : Prop where
  hBq : 4 * (s + t + 2 * HvdH.sWidth p α + 2) ^ 4 < 2 ^ Bq
  hEq : (4 * p + 35) * 2 ^ (2 * p) < 2 ^ Bq
  hK2 : α ^ 2 * t ^ 2 < 2 ^ Bq

/-- Registers read by the `S` table builder. -/
structure STabRegs (p s t α : ℕ) (st : IState HS) : Prop where
  rP : ∃ L, st.G aP = .int (p : ℤ) :: L
  rS : ∃ L, st.G aS = .int (s : ℤ) :: L
  rT : ∃ L, st.G aT = .int (t : ℤ) :: L
  rM : ∃ L, st.G aWd = .int (HvdH.sWidth p α : ℤ) :: L
  rB : ∃ L, st.G aBe = .int (HvdH.betaT p α) :: L
  rK : ∃ L, st.G aK2 = .int ((α ^ 2 * t ^ 2 : ℕ) : ℤ) :: L
