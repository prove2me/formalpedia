section Recursion

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

lemma replicate_split {N i m : ℕ} (hi : i < m) :
    List.replicate m N = List.replicate i N ++ N :: List.replicate (m - 1 - i) N := by
  rw [← List.replicate_succ, ← List.replicate_add]; congr 1; omega

/-- The child's shape is the stream shape. -/
lemma swShape_child (A B Cs : Shape) {m N : ℕ} (i j : Fin m) :
    swShape (A ++ List.replicate i N) (List.replicate (m - 1 - i) N ++ (B ++ List.replicate j N))
      (List.replicate (m - 1 - j) N ++ Cs) N = hdShape A B Cs m N := by
  simp only [swShape, hdShape, List.append_assoc]
  nth_rw 1 [replicate_split (N := N) i.2]
  rw [replicate_split (N := N) j.2]
  simp [List.append_assoc]

end Recursion

section CostDefs

variable {Wr R M : Type*} [Fintype Wr] [DecidableEq Wr] [AddGroup M]

lemma netCost_eq (fc : M → ℝ) (v : ℝ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      netCost fc v gates lab Mout = frameSum fc gates lab Mout + v * touched gates := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [netCost, frameSum, touched]
  | cons g gs ih =>
    intro lab Mout
    simp only [netCost, frameSum, touched, List.map_cons, List.sum_cons, Nat.cast_add] at ih ⊢
    rw [ih, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    ring

lemma frameSum_congr {β : Type*} [AddCommMonoid β] (Pr : M → Prop) (f g : M → β)
    (h : ∀ a, Pr a → f a = g a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M), FramesOK Pr gates lab Mout →
      frameSum f gates lab Mout = frameSum g gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout hF; exact Finset.sum_congr rfl fun w _ => h _ (hF w)
  | cons g gs ih =>
    intro lab Mout hF
    simp only [frameSum]
    rw [Finset.sum_congr rfl fun w hw => h _ (hF.1 w hw), ih _ _ hF.2]

lemma frameSum_lin (α β : M → ℝ) (v t : ℝ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      frameSum (fun a => α a * v + β a * t) gates lab Mout =
        frameSum α gates lab Mout * v + frameSum β gates lab Mout * t := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum, Finset.sum_add_distrib, Finset.sum_mul]
  | cons g gs ih =>
    intro lab Mout
    simp only [frameSum, ih, Finset.sum_add_distrib, ← Finset.sum_mul]
    ring

lemma frameSum_cast (f : M → ℕ) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M),
      ((frameSum f gates lab Mout : ℕ) : ℝ) = frameSum (fun a => (f a : ℝ)) gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout; simp [frameSum]
  | cons g gs ih => intro lab Mout; simp [frameSum, ih]

lemma frameSum_nonneg (f : M → ℝ) (hf : ∀ a, 0 ≤ f a) :
    ∀ (gates : List (NGate Wr R M)) (lab Mout : Wr → M), 0 ≤ frameSum f gates lab Mout := by
  intro gates
  induction gates with
  | nil => intro lab Mout; exact Finset.sum_nonneg fun w _ => hf _
  | cons g gs ih =>
    intro lab Mout
    exact add_nonneg (Finset.sum_nonneg fun w _ => hf _) (ih _ _)

end CostDefs

section StepCost

variable {n Q : ℕ}

lemma runCost_eq (T : ℝ → ℝ) (v : ℝ) (steps : List (AModel.Step n Q)) :
    runCost T v steps = (steps.countP (fun s => !s.isSwap) : ℝ) * v +
      (steps.countP Step.isSwap : ℝ) * T v := by
  induction steps with
  | nil => simp [runCost]
  | cons s l ih =>
    simp only [runCost, List.map_cons, List.sum_cons] at ih ⊢
    rw [ih, List.countP_cons, List.countP_cons]
    cases s.isSwap <;> simp <;> ring

lemma countP_not_add (steps : List (AModel.Step n Q)) :
    steps.countP (fun s => !s.isSwap) + steps.countP Step.isSwap = steps.length := by
  induction steps with
  | nil => rfl
  | cons s l ih =>
    rw [List.countP_cons, List.countP_cons, List.length_cons]
    cases s.isSwap <;> simp <;> omega

lemma length_revSteps (l : List (AModel.Step n Q)) : (revSteps l).length = l.length := by
  simp [revSteps]

variable {m : ℕ}

lemma length_shearSteps (E₁ W E₂ : Matrix (Fin m) (Fin m) (ZMod Q)) :
    (shearSteps E₁ W E₂).length = 4 * m + 3 * (pivots W).length := by
  have h3 : ∀ ps : List (Fin m × Fin m), (addSteps ps : List (AModel.Step (m + m) Q)).length =
      3 * ps.length := by
    intro ps
    induction ps with
    | nil => rfl
    | cons p ps ih =>
      have e : (addSteps (p :: ps) : List (AModel.Step (m + m) Q)) = pivotSteps p.1 p.2 ++ addSteps ps := by
        simp [addSteps]
      rw [e, List.length_append, ih]; simp [pivotSteps]; ring
  simp only [shearSteps, List.length_append, length_revSteps, h3]
  simp [hSteps, dSteps, hIdx, dIdx]
  ring

end StepCost

section ProgCost

variable {R : Type*} [CommRing R] {m W : ℕ}

lemma one_le_costConst (C : Circuit R m W) : 1 ≤ costConst C := by
  have h := frameSum_nonneg (fun A => (4 * m + 2 * pivRank C A : ℝ)) (fun A => by positivity)
    C.gates C.Min C.Mout
  rw [costConst]
  have : 0 ≤ (frameSum (fun A => (4 * m + 2 * pivRank C A : ℝ)) C.gates C.Min C.Mout +
    touched C.gates) / W := by positivity
  have : (0 : ℝ) ≤ m := by positivity
  linarith

end ProgCost

section Assembled

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- The chunk interchange on the digit shape: if the two chunks are runs of `e` radix-`q`
digits (`P :: L :: hdShape A B Cs e q`), swapping the two merged fields is the block swap of
the two digit runs. -/
theorem pull_swapPos_eq_blockSwap (P L : ℕ) (A B Cs : Shape) (e q : ℕ) (xs : List R) :
    AModel.pull (P :: L :: swShape A B Cs (q ^ e)) (P :: L :: swShape A B Cs (q ^ e))
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs =
      AModel.pull (P :: L :: hdShape A B Cs e q) (P :: L :: hdShape A B Cs e q)
        (blockSwap (A.length + 2) (A.length + B.length + e + 2) e) 0 xs := by
  have hg : ∀ k, k < e + e → (P :: L :: hdShape A B Cs e q).getD (AModel.hdPos A B e k + 2) 0 = q :=
    fun k hk => by simpa using hdShape_getD A B Cs e q k hk
  rw [pull_blockSwap (by omega) (by simp [length_hdShape]; omega) (fun k hk => by
      have h1 := hg k (by omega)
      have h2 := hg (e + k) (by omega)
      simp only [AModel.hdPos, if_pos hk, if_neg (show ¬ e + k < e by omega)] at h1 h2
