namespace M7Asm

variable {𝒪 : Type} [CommRing 𝒪] (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr] (Fr : Onr ≃ₐ[𝒪] Onr)
  {B B' : Type} [CommRing B] [Algebra 𝒪 B] [CommRing B'] [Algebra 𝒪 B']

theorem comp_frobTwist (φ : B →ₐ[𝒪] B') (n : ℤ) (ψ : Onr →ₐ[𝒪] B) :
    φ.comp (frobTwist Onr Fr n ψ) = frobTwist Onr Fr n (φ.comp ψ) := rfl

theorem frobTwist_frobTwist (m n : ℤ) (ψ : Onr →ₐ[𝒪] B) :
    frobTwist Onr Fr n (frobTwist Onr Fr m ψ) = frobTwist Onr Fr (m + n) ψ := by
  show (ψ.comp _).comp _ = ψ.comp _
  rw [AlgHom.comp_assoc, zpow_add]
  congr 1

theorem frobTwist_zero (ψ : Onr →ₐ[𝒪] B) : frobTwist Onr Fr 0 ψ = ψ := by
  show ψ.comp _ = ψ
  rw [zpow_zero]; ext x; rfl

end M7Asm

