open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {n : ℕ}
variable {g gi : Metric n} {E Θ : Fin n → Fin n → Pt n → ℂ} {U : Set (Pt n)}
theorem solution (hF : FrameData g gi E Θ U) {x : Pt n} (hx : x ∈ U) (C A B : Fin n) :
    bianchiX g gi E Θ C A B x + bianchiX g gi E Θ A B C x + bianchiX g gi E Θ B C A x = 0 := by
  set G : Fin n → Fin n → Fin n → Matrix (Fin n) (Fin n) ℂ := fun μ ν l =>
    pdMC μ (Fom g gi E Θ ν l) x + (omegaC g gi E Θ μ x * Fom g gi E Θ ν l x
      - Fom g gi E Θ ν l x * omegaC g gi E Θ μ x) with hGdef
  set Fm : Fin n → Fin n → Matrix (Fin n) (Fin n) ℂ := fun ν l => Fom g gi E Θ ν l x with hFm
  have hFa : ∀ ν l, Fm l ν = -Fm ν l := fun ν l => Fom_antisymm g gi E Θ ν l x
  have hX : ∀ C A B, bianchiX g gi E Θ C A B x
      = (∑ ν, ∑ l, (fdir E A (E C ν) x * E B l x) • Fm ν l + ∑ ν, ∑ l, (E A ν x * fdir E C (E B l) x) • Fm ν l)
        + ∑ μ, ∑ ν, ∑ l, (E C μ x * (E A ν x * E B l x)) • G μ ν l := by
    intro C A B
    unfold bianchiX
    rw [Dmat_Rfr hF hx, add_sub_assoc, comm_Omega_Rfr hF hx, sum_cfr_Rfr hF hx]
    simp only [hGdef, hFm, smul_add, Finset.sum_add_distrib, brk]
    have e : ∀ ν l, (fdir E C (E A ν) x * E B l x + E A ν x * fdir E C (E B l) x) • Fom g gi E Θ ν l x
        - ((fdir E C (E A ν) x - fdir E A (E C ν) x) * E B l x) • Fom g gi E Θ ν l x
        = (fdir E A (E C ν) x * E B l x) • Fom g gi E Θ ν l x
          + (E A ν x * fdir E C (E B l) x) • Fom g gi E Θ ν l x := by
      intro ν l; rw [← sub_smul, ← add_smul]; congr 1; ring
    have e2 : ∑ ν, ∑ l, (fdir E C (E A ν) x * E B l x + E A ν x * fdir E C (E B l) x) • Fom g gi E Θ ν l x
        - ∑ ν, ∑ l, ((fdir E C (E A ν) x - fdir E A (E C ν) x) * E B l x) • Fom g gi E Θ ν l x
        = ∑ ν, ∑ l, (fdir E A (E C ν) x * E B l x) • Fom g gi E Θ ν l x
          + ∑ ν, ∑ l, (E A ν x * fdir E C (E B l) x) • Fom g gi E Θ ν l x := by
      rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun ν _ => ?_
      rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun l _ => e ν l
    rw [← e2]
    abel
  rw [hX C A B, hX A B C, hX B C A]
  -- first-order terms cancel in pairs (antisymmetry of `Fom`)
  have p1 := sum2_antisymm_pair hFa (fun ν => fdir E A (E C ν) x) (fun l => E B l x)
  have p2 := sum2_antisymm_pair hFa (fun ν => E A ν x) (fun l => fdir E C (E B l) x)
  have p3 := sum2_antisymm_pair hFa (fun ν => fdir E B (E A ν) x) (fun l => E C l x)
  -- the second-order terms combine into the coordinate Bianchi identity
  have hT : ∑ μ, ∑ ν, ∑ l, (E C μ x * (E A ν x * E B l x)) • G μ ν l
      + ∑ μ, ∑ ν, ∑ l, (E A μ x * (E B ν x * E C l x)) • G μ ν l
      + ∑ μ, ∑ ν, ∑ l, (E B μ x * (E C ν x * E A l x)) • G μ ν l = 0 := by
    rw [sum3_rot (fun μ ν l => (E A μ x * (E B ν x * E C l x)) • G μ ν l),
      sum3_rot' (fun μ ν l => (E B μ x * (E C ν x * E A l x)) • G μ ν l), ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun μ _ => ?_
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun ν _ => ?_
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun l _ => ?_
    have hb := gauge_bianchi hF hx μ ν l
    have c1 : E A ν x * (E B l x * E C μ x) = E C μ x * (E A ν x * E B l x) := by ring
    have c2 : E B l x * (E C μ x * E A ν x) = E C μ x * (E A ν x * E B l x) := by ring
    rw [c1, c2, ← smul_add, ← smul_add]
    simp only [hGdef]
    rw [show pdMC μ (Fom g gi E Θ ν l) x + (omegaC g gi E Θ μ x * Fom g gi E Θ ν l x
        - Fom g gi E Θ ν l x * omegaC g gi E Θ μ x)
        + (pdMC ν (Fom g gi E Θ l μ) x + (omegaC g gi E Θ ν x * Fom g gi E Θ l μ x
        - Fom g gi E Θ l μ x * omegaC g gi E Θ ν x))
        + (pdMC l (Fom g gi E Θ μ ν) x + (omegaC g gi E Θ l x * Fom g gi E Θ μ ν x
        - Fom g gi E Θ μ ν x * omegaC g gi E Θ l x)) = 0 by rw [← hb]; abel, smul_zero]
  beta_reduce at p1 p2 p3
  set X1 := ∑ ν, ∑ l, (fdir E A (E C ν) x * E B l x) • Fm ν l
  set Y1 := ∑ ν, ∑ l, (E A ν x * fdir E C (E B l) x) • Fm ν l
  set X2 := ∑ ν, ∑ l, (fdir E B (E A ν) x * E C l x) • Fm ν l
  set Y2 := ∑ ν, ∑ l, (E B ν x * fdir E A (E C l) x) • Fm ν l
  set X3 := ∑ ν, ∑ l, (fdir E C (E B ν) x * E A l x) • Fm ν l
  set Y3 := ∑ ν, ∑ l, (E C ν x * fdir E B (E A l) x) • Fm ν l
  set T1 := ∑ μ, ∑ ν, ∑ l, (E C μ x * (E A ν x * E B l x)) • G μ ν l
  set T2 := ∑ μ, ∑ ν, ∑ l, (E A μ x * (E B ν x * E C l x)) • G μ ν l
  set T3 := ∑ μ, ∑ ν, ∑ l, (E B μ x * (E C ν x * E A l x)) • G μ ν l
  calc X1 + Y1 + T1 + (X2 + Y2 + T2) + (X3 + Y3 + T3)
      = (X1 + Y2) + (Y1 + X3) + (X2 + Y3) + (T1 + T2 + T3) := by abel
    _ = 0 := by rw [p1, p2, p3, hT]; abel
