theorem TypeDensity.cluster_rational_eval (n : ℕ) (σ : FactorType) :
    ∀ q : ℕ, PrimePower q →
      RatFunc.eval (RingHom.id ℚ) q (clusterExpr n σ).rational = (clusterExpr n σ).eval q := by sorry
