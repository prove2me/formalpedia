theorem Ideal.map_mem_minimalPrimes_span_singleton_of_apply_eq
    {S : Type*} [CommRing S] (γ : S ≃+* S) (π : S) (hγπ : γ π = π)
    {P : Ideal S} (hP : P ∈ (Ideal.span {π}).minimalPrimes) :
    P.map (γ : S →+* S) ∈ (Ideal.span {π}).minimalPrimes := by sorry
