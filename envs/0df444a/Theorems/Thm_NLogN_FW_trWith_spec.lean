theorem NLogN.FW.trWith_spec (M : MulSpec) (a b : Fin HS) (ha : a.val < 55) (hb : b.val < 55)
    (ha1 : a ≠ 1) (ha2 : a ≠ 2) (hb1 : b ≠ 1) (hb2 : b ≠ 2) (ha3 : a ≠ 3) (hb3 : b ≠ 3)
    (n m kb W : ℕ) (L : List ℤ) (Rest La Lb Lk : List Item) (s : IState HS)
    (hL : L.length = n * m) (hN : n * m ≤ 2 ^ kb) (hm : 1 ≤ m)
    (hX : s.G XD = ints L ++ Rest) (hA : s.G a = .int n :: La) (hB : s.G b = .int m :: Lb)
    (hK : s.G KBR = .int kb :: Lk) (hW : Bnd W L) (hnW : zsz (n : ℤ) ≤ W) (hmW : zsz (m : ℤ) ≤ W)
    (hkW : zsz (kb : ℤ) ≤ W) :
    Spec M (trWith a b) s (s.upd XD (ints (Ref.transposeL n m L) ++ Rest))
      (10 ^ 6 * (kb + 1) * (n * m + 1) * 2 * (W + kb + 5) + 20000 * (W + 2)) := by sorry
