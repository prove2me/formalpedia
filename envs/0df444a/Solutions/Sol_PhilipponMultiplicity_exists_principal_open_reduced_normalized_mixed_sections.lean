/-- The adjugate identity applies to relations with values in any module. -/
theorem det_smul_eq_zero
    {R N σ : Type*} [CommRing R] [AddCommGroup N] [Module R N] [Fintype σ] [DecidableEq σ]
    (A : Matrix σ σ R) (v : σ → N)
    (h : ∀ i, ∑ j, A i j • v j = 0) (i : σ) : A.det • v i = 0 := by
  classical
  have hh : ∑ j, A.adjugate i j • (∑ k, A j k • v k) = 0 := by simp [h]
  have heq : (∑ j, A.adjugate i j • (∑ k, A j k • v k)) =
      ∑ k, (A.adjugate * A) i k • v k := by
    simp only [Finset.smul_sum, smul_smul, Matrix.mul_apply, Finset.sum_smul]
    exact Finset.sum_comm
  rw [heq, Matrix.adjugate_mul] at hh
  simpa [Matrix.smul_apply, Matrix.one_apply, mul_ite] using hh

/-- Partial derivatives give the expansion of an arbitrary polynomial derivation. -/
theorem derivation_eq_sum
    {R N σ : Type*} [CommRing R] [AddCommGroup N] [Fintype σ] [DecidableEq σ]
    [Module R N] [Module (MvPolynomial σ R) N] [IsScalarTower R (MvPolynomial σ R) N]
    (d : Derivation R (MvPolynomial σ R) N) (P : MvPolynomial σ R) :
    d P = ∑ j, pderiv j P • d (X j) := by
  have h := congrArg d.liftKaehlerDifferential
    ((KaehlerDifferential.mvPolynomialBasis R σ).sum_repr
      (KaehlerDifferential.D R (MvPolynomial σ R) P))
  simpa only [map_sum, map_smul, KaehlerDifferential.mvPolynomialBasis_repr_apply,
    KaehlerDifferential.mvPolynomialBasis_apply,
    Derivation.liftKaehlerDifferential_comp_D] using h.symm

/-- The polynomial chain rule in an arbitrary quotient, with its actual nilpotents. -/
theorem quotient_differential
    {R σ : Type*} [CommRing R] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ R)) (P : MvPolynomial σ R) :
    KaehlerDifferential.D R (MvPolynomial σ R ⧸ I) (Ideal.Quotient.mk I P) =
      ∑ j, Ideal.Quotient.mk I (pderiv j P) •
        KaehlerDifferential.D R (MvPolynomial σ R ⧸ I) (Ideal.Quotient.mk I (X j)) := by
  let d := (KaehlerDifferential.D R (MvPolynomial σ R ⧸ I)).compAlgebraMap
    (MvPolynomial σ R)
  have h := derivation_eq_sum d P
  change KaehlerDifferential.D R (MvPolynomial σ R ⧸ I)
      (algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ I) P) =
    ∑ j, algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ I) (pderiv j P) •
      KaehlerDifferential.D R (MvPolynomial σ R ⧸ I)
        (algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ I) (X j))
  simp only [d, Derivation.compAlgebraMap_apply] at h
  rw [h]
  apply Finset.sum_congr rfl
  intro j _
  exact (IsScalarTower.algebraMap_smul (MvPolynomial σ R ⧸ I) (pderiv j P)
    (KaehlerDifferential.D R (MvPolynomial σ R ⧸ I)
      (algebraMap (MvPolynomial σ R) (MvPolynomial σ R ⧸ I) (X j)))).symm

/-- A square Jacobian determinant of equations in I annihilates all quotient differentials. -/
theorem jacobian_mem_annihilator
    {R σ : Type*} [CommRing R] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ R)) (F : σ → MvPolynomial σ R) (hF : ∀ i, F i ∈ I) :
    Ideal.Quotient.mk I (Matrix.of (fun i j => pderiv j (F i))).det ∈
      Module.annihilator (MvPolynomial σ R ⧸ I)
        (KaehlerDifferential R (MvPolynomial σ R ⧸ I)) := by
  classical
  let Q := MvPolynomial σ R ⧸ I
  let q : MvPolynomial σ R →+* Q := Ideal.Quotient.mk I
  let D := KaehlerDifferential.D R Q
  let A : Matrix σ σ Q := fun i j => q (pderiv j (F i))
  have hrel (i) : ∑ j, A i j • D (q (X j)) = 0 := by
    rw [← quotient_differential I (F i),
      Ideal.Quotient.eq_zero_iff_mem.mpr (hF i), map_zero]
  have hDX (j) : A.det • D (q (X j)) = 0 :=
    det_smul_eq_zero A (fun j => D (q (X j))) hrel j
  have hdet : q (Matrix.of (fun i j => pderiv j (F i))).det = A.det :=
    RingHom.map_det q _
  rw [hdet, Module.mem_annihilator]
  intro z
  have hz : z ∈ Submodule.span Q (Set.range D) := by
    rw [KaehlerDifferential.span_range_derivation]
    trivial
  induction hz using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨x, rfl⟩ := hz
      obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [quotient_differential, Finset.smul_sum]
      apply Finset.sum_eq_zero
      intro j _
      rw [smul_comm, hDX, smul_zero]
  | zero => exact smul_zero _
  | add x y _ _ hx hy => rw [smul_add, hx, hy, add_zero]
  | smul r x _ hx => rw [smul_comm, hx, smul_zero]

/-- Full-rank equations at every rational zero kill the global differential module.
The equations may depend on the point and need not generate I. -/
theorem formallyUnramified_of_pointwise_jacobian
    {K σ : Type*} [Field K] [IsAlgClosed K] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ K))
    (h : ∀ a : σ → K, (∀ P ∈ I, eval a P = 0) →
      ∃ F : σ → MvPolynomial σ K, (∀ i, F i ∈ I) ∧
        eval a (Matrix.of (fun i j => pderiv j (F i))).det ≠ 0) :
    Algebra.FormallyUnramified K (MvPolynomial σ K ⧸ I) := by
  classical
  let Q := MvPolynomial σ K ⧸ I
  let q : MvPolynomial σ K →+* Q := Ideal.Quotient.mk I
  let L := Module.annihilator Q (KaehlerDifferential K Q)
  constructor
  apply (Module.annihilator_eq_top_iff (R := Q) (M := KaehlerDifferential K Q)).mp
  change L = ⊤
  by_contra hL
  obtain ⟨m, hm, hLm⟩ := Ideal.exists_le_maximal L hL
  letI : m.IsMaximal := hm
  have hp : (m.comap q).IsMaximal := Ideal.comap_isMaximal_of_surjective q
    Ideal.Quotient.mk_surjective
  obtain ⟨a, ha⟩ := eq_vanishingIdeal_singleton_of_isMaximal K hp
  have hzero : ∀ P ∈ I, eval a P = 0 := by
    intro P hP
    have hmem : P ∈ m.comap q := by
      change q P ∈ m
      rw [show q P = 0 from Ideal.Quotient.eq_zero_iff_mem.mpr hP]
      exact m.zero_mem
    rw [ha] at hmem
    simpa [vanishingIdeal] using hmem
  obtain ⟨F, hFI, hdet⟩ := h a hzero
  have hd : (Matrix.of (fun i j => pderiv j (F i))).det ∈ m.comap q :=
    hLm (jacobian_mem_annihilator I F hFI)
  rw [ha] at hd
  exact hdet (by simpa [vanishingIdeal] using hd)

/-- The full-rank pointwise Jacobian criterion makes the original ideal radical. -/
theorem radical_of_pointwise_jacobian
    {K σ : Type*} [Field K] [IsAlgClosed K] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ K))
    (h : ∀ a : σ → K, (∀ P ∈ I, eval a P = 0) →
      ∃ F : σ → MvPolynomial σ K, (∀ i, F i ∈ I) ∧
        eval a (Matrix.of (fun i j => pderiv j (F i))).det ≠ 0) : I.IsRadical := by
  letI := formallyUnramified_of_pointwise_jacobian I h
  exact (Ideal.isRadical_iff_quotient_reduced I).mpr
    (Algebra.FormallyUnramified.isReduced_of_field K (MvPolynomial σ K ⧸ I))

/-- The same pointwise criterion also makes the quotient finite over the field. -/
theorem finite_quotient_of_pointwise_jacobian
    {K σ : Type*} [Field K] [IsAlgClosed K] [Fintype σ] [DecidableEq σ]
    (I : Ideal (MvPolynomial σ K))
    (h : ∀ a : σ → K, (∀ P ∈ I, eval a P = 0) →
      ∃ F : σ → MvPolynomial σ K, (∀ i, F i ∈ I) ∧
        eval a (Matrix.of (fun i j => pderiv j (F i))).det ≠ 0) :
    Module.Finite K (MvPolynomial σ K ⧸ I) := by
  letI := formallyUnramified_of_pointwise_jacobian I h
  exact Algebra.FormallyUnramified.finite_of_free K (MvPolynomial σ K ⧸ I)

