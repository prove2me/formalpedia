theorem tendsto_mmOf : Tendsto mmOf atTop atTop := by
  refine tendsto_atTop.2 fun M => eventually_atTop.2 ⟨2 ^ (M * M * (M * M)), fun n hn => ?_⟩
  have hk : M * M * (M * M) ≤ kOf n := by
