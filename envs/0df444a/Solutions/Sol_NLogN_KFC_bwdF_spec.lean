  refine List.map_congr_left fun b hb => ?_
  simp only [List.mem_range] at hp hm hy hb
  rw [NLogN.KIL.decode4 hp hy hm hb]
  simp [gS, encode4]

theorem length_recOf' (xs : List ℤ) (q M B p y m : ℕ) : (recOf' xs q M B p y m).length = B := by
  simp [recOf']

