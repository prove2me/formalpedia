                      (MetricCodes.Boolean.raiseAt a
                        (MetricCodes.Boolean.lowerAt a g))
                      (MetricCodes.Boolean.raiseAt a
                        (MetricCodes.Boolean.lowerAt a f))]
    _ = (∑ a : Fin n,
          MetricCodes.Boolean.dot f
