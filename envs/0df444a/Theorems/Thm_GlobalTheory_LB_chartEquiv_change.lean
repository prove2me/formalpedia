theorem GlobalTheory.LB.chartEquiv_change (hL : L.IsLB) (i j : L.ι) {V : X.Opens} (hi : V ≤ L.U i)
    (hj : V ≤ L.U j) (s : Γ(toMod L, V)) :
    chartEquiv hL i hi s =
      resG X (le_inf hi hj) (L.g i j : Γ(X, L.U i ⊓ L.U j)) * chartEquiv hL j hj s := by sorry
