  have hIG := ModularCurve.FullLevel.exists_igusaChart_localRing_eq_localization_formallySmooth_and_crossing_unique_of_normalModel_gen_j
      q hq M' hqM' A hA W hW hle R₀ hR₀ π hπ hπP ζ OIg OSS hIg_inf hIg hIg_inj hIg_perm hSS_A hSS_over hSS_fix hSS_tr
