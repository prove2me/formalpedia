  have w1S : w1.G xS = .int s :: LS := by simp (config := {decide := true}) [hw1, hS]
  set w2 := w1.upd xU (.int s :: w.G xU) with hw2
  have r2 : (RS.push xU (.reg xS)).run w1 = w2 := by
    have : w1.G xU = w.G xU := by simp (config := {decide := true}) [hw1]
    simp only [RS.run, Ex.eval, IState.top_eq w1S, hw2, this]
  have w2S : w2.G xS = .int s :: LS := by simp (config := {decide := true}) [hw2, w1S]
  refine ⟨?_, ?_, ?_⟩
  · simp only [RS.run] at r1 r2 ⊢
    rw [r1, r2]; simp [w2S]
  · refine ⟨⟨by decide, e4, e2, IState.isInt_of hM⟩, ?_⟩
    simp only [RS.run] at r1 ⊢
    rw [r1]
    refine ⟨⟨by decide, RS.clean_of_lt (by decide), IState.isInt_of w1S⟩, ?_⟩
    simp only [RS.run] at r2 ⊢
    rw [r2]; exact ⟨by decide, IState.isInt_of w2S⟩
  · simp only [RS.cost]
    rw [r1, r2]
    have c1 := RS.asgCost_le xM e w B e3 (by rw [IState.top_eq hM]; exact hNB)
    have c2 := RS.pushCost_le (.reg xS) w1 B (by simp [Ex.Bnd, IState.top_eq w1S, hsB])
    simp only [Ex.size] at c2
    rw [IState.top_eq w2S]
    have : 4 ≤ (B + 2) ^ 2 := by nlinarith
    nlinarith

