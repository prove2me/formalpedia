theorem ModularCurve.exists_nsmul_generator_idempotent_tower_heckeAlg_tateModule_inf_pi_closure_inertia_smul_sub
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∃ a b : ℕ,
      ∃ s₀ ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
        (fun _ => AddSubgroup.closure
          {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
            ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
      ∃ te : ℕ → HeckeAlg,
        (∀ m : ℕ,
          ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te m) *
              ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te m) -
            ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te m) ∈
              Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}) ∧
        (∀ m : ℕ,
          ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te (m + 1)) -
            ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te m) ∈
              Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}) ∧
        (∀ m : ℕ, ∀ s ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
          ∃ l ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
            te m • s - s = 2 ^ m • l) ∧
        (∀ m : ℕ, ∀ t : HeckeAlg,
          (∀ s ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
              (fun _ => AddSubgroup.closure
                {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                  ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
            ∃ l ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
              (fun _ => AddSubgroup.closure
                {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                  ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
              t • s = 2 ^ (m + b) • l) →
          ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) (te m) *
              ((latticeRestrictHom p ∅).toRingHom.comp (heckeEvalForms p 2)) t ∈
            Ideal.span {((2 : ℕ) : ↥(heckeLatticeAlgebra p ∅)) ^ m}) ∧
        (∀ m : ℕ, ∀ s ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
            (fun _ => AddSubgroup.closure
              {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
          ∃ t : HeckeAlg,
            t • s₀ ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
              (fun _ => AddSubgroup.closure
                {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                  ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) ∧
            ∃ l ∈ _root_.TateModule 2 (JZero p) ⊓ AddSubgroup.pi Set.univ
              (fun _ => AddSubgroup.closure
                {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
                  ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}),
              2 ^ a • s - t • s₀ = 2 ^ m • l) := by sorry
