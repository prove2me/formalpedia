import Definitions.Def_MasulloRH_RationalThetaGrid
import Mathlib.Analysis.Calculus.Deriv.Comp
import Mathlib.Analysis.Calculus.Deriv.Add

namespace MasulloRH.ThetaDerivativeCertificate
open GaussianApproximation CentralInterval InteriorEvaluator

def centerQ (j : ℤ) : ℚ := j/16
def cellBox (j : ℤ) : Box := (centerQ j,centerQ (j+1))
def samplingBox (j : ℤ) (k : ℕ) : Box :=
  if k=6 then cellBox j else point (centerQ (j+(k%2:ℕ)))
def orderFor (k : ℕ) := 2*(k/2)
def active (j : ℤ) := decide (-48 ≤ j ∧ j < 24)
def branch (j : ℤ) := decide (j < -12)
def S : ℤ := 10000000000
def W : ℕ := 268435456
def numerator (i : Fin 25) : ℕ := ![6004,13764,88282,318168,1083740,3113279,7689749,16228593,29197816,44641749,57839108,63350625,58559892,45666942,30076598,16760561,7925786,3189670,1095192,322057,81502,17276,3596,366,133] i
def coeff (i : Fin 25) : ℚ := (numerator i:ℚ)/W
def offset (i : Fin 25) : ℤ := 4*(i.val:ℤ)-32
def shift (i : Fin 25) : ℚ := centerQ (offset i)
noncomputable def err := residual 0 (fun i => (coeff i:ℂ)) (fun i => (shift i:ℝ))

def hornerB : List ℤ → Box → Box
  | [],_ => point 0
  | c::p,x => point c + mulB x (hornerB p x)
noncomputable def hornerR : List ℤ → ℝ → ℝ
  | [],_ => 0
  | c::p,x => c+x*hornerR p x
noncomputable def hornerSlope : List ℤ → ℝ → ℝ
  | [],_ => 0
  | _::p,x => hornerR p x+x*hornerSlope p x

def thetaCoeffs (b : Bool) (n : ℕ) : List ℤ :=
  match b,n with
  | false,0 => [1]
  | false,1 => [0,-2]
  | false,2 => [0,-4,4]
  | false,3 => [0,-8,24,-8]
  | false,4 => [0,-16,112,-96,16]
  | false,5 => [0,-32,480,-800,320,-32]
  | false,6 => [0,-64,1984,-5760,4160,-960,64]
  | true,0 => [1]
  | true,1 => [-1,2]
  | true,2 => [1,-8,4]
  | true,3 => [-1,26,-36,8]
  | true,4 => [1,-80,232,-128,16]
  | true,5 => [-1,242,-1320,1360,-400,32]
  | true,6 => [1,-728,7084,-12160,6320,-1152,64]
  | _,_ => []
def pulseCoeffs (n : ℕ) : List ℤ :=
  match n with
  | 0 => [1]
  | 1 => [0,-2]
  | 2 => [-2,0,4]
  | 3 => [0,12,0,-8]
  | 4 => [12,0,-48,0,16]
  | 5 => [0,-120,0,160,0,-32]
  | 6 => [-120,0,720,0,-480,0,64]
  | _ => []

def rho (b : Bool) : ℝ := if b then -1 else 0
def rate (b : Bool) : ℝ := if b then -2 else 2
noncomputable def baseU (b : Bool) (z : ℝ) := (if b then Real.pi/16 else Real.pi)*Real.exp (rate b*z)
noncomputable def pref (b : Bool) (z : ℝ) := if b then Real.exp (-z) else 2
noncomputable def tJet (b : Bool) (n : ℕ) (z : ℝ) : ℝ :=
  ∑ i : Index, (signQ i:ℝ)*(hornerR (thetaCoeffs b n) ((powerIndex i:ℝ)*baseU b z)*
    (pref b z*Real.exp (-((powerIndex i:ℝ)*baseU b z))))
noncomputable def unitValue (z : ℝ) := (1/Real.sqrt Real.pi)*Real.exp (-z^2)
noncomputable def pJet (n : ℕ) (z : ℝ) := hornerR (pulseCoeffs n) z*unitValue z

def splitTerm (d : Params) (i : Index) : Box :=
  let u := powerIndex i
  mulB d.pref (mulB (powB d.q (u/2)) (powB d.q (u-u/2)))
def thetaJB (b : Bool) (n : ℕ) (d : Params) : Box :=
  ∑ i : Index, mulB (point (signQ i))
    (mulB (hornerB (thetaCoeffs b n) (mulB (point (powerIndex i)) d.u)) (splitTerm d i))
def pulseJB (n : ℕ) (z : Box) := mulB (hornerB (pulseCoeffs n) z) (NineShift.uv z)

structure JetRow where
  vals : Array (ℤ × ℤ)
  tail : ℕ
  deriving Inhabited
def decoded (p : ℤ × ℤ) : Box := ((p.1:ℚ)/S,(p.2:ℚ)/S)
def col (r : JetRow) (k : ℕ) := decoded (r.vals[k]?.getD (0,0))
def tailQ (r : JetRow) : ℚ := (r.tail:ℚ)/S
def fits (inner outer : Box) : Bool := decide (outer.1 ≤ inner.1 ∧ inner.2 ≤ outer.2)
def zeroRow : JetRow := ⟨#[],1⟩
def majorant {R : Type*} [Semiring R] (h : R) (a : ℕ → R) : ℕ → ℕ → R
  | 0,i => a i
  | n+1,i => a i+h*majorant h a n (i+1)

