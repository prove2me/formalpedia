/-! ## Counting loops -/











































































end Light

end
end


theorem solution : ∀ {lim : Light.Limits} {P : Light.Program} {d : Nat} {s : Light.Stmt} {σ : Light.State} {T : Nat}
  {Q : Light.State → Prop},
  Light.Stmt.BlockSafe lim s σ → @LE.le.{0} Nat instLENat s.blockCost T → Q (s.after σ) → Light.Ends lim P d s σ T Q := by
  exact @Light.Ends.of_blockSafe_sourceProof

