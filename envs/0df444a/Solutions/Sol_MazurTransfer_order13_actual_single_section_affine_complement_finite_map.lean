noncomputable section
namespace MazurTransfer.Order13ReciprocalOrdinateIdentity
variable {A : Type*} [CommRing A]

theorem recovered_ordinate (x y t z u : A) (hx : x * z = 1)
    (hu : (x * t) * u = 1) (ht : t = y + x ^ 3 + x ^ 2 + 1)
    (hc : t ^ 2 - 2 * t * (x ^ 3 + x ^ 2 + 1) - 4 * x * (x + 1) = 0) :
    4 * (1 + z) * u + 1 + z + z ^ 3 = y * z ^ 3 := by
  have hx2 : x ^ 2 * z ^ 2 = 1 := by rw [← mul_pow,hx,one_pow]
  have hred : t ^ 2 * z ^ 2 - 2 * t * (x + 1 + z ^ 2) - 4 * (1 + z) = 0 := by
    linear_combination z ^ 2 * hc + (2 * t * x + 2 * t + 4) * hx2 + 4 * z * hx
  have hv : IsUnit (x * t) := ⟨⟨x * t,u,hu,by simpa only [mul_comm] using hu⟩,rfl⟩
  apply hv.mul_right_inj.mp
  linear_combination 4 * (1 + z) * hu - hred +
    t * (1 + z ^ 2 - y * z ^ 2) * hx + t * (x + 1) * hx2 + t * z ^ 2 * ht

end MazurTransfer.Order13ReciprocalOrdinateIdentity

universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open MazurTorsion.XOneThirteenAffineCurve
open Order13SingleSectionFiniteMapIdentities
variable (R : Type u) [CommRing R]

theorem infinityLocalizedInclusion_recoveredW :
    infinityLocalizedInclusion R (infinityRecoveredW R) =
      algebraMap (CoordinateRing R) (ordinaryInfinityLocalization R) (yCoordinate R) *
        infinityLocalizedInclusion R (infinityRecoveredZ R) ^ 3 := by
  let a : CoordinateRing R →+* ordinaryInfinityLocalization R := algebraMap _ _
  let x := a (xCoordinate R)
  let y := a (yCoordinate R)
  let tt := a (t R)
  let zz := infinityLocalizedInclusion R (infinityRecoveredZ R)
  let uu := infinityLocalizedInclusion R (infinityPInverse R)
  have hx : x * zz = 1 := ordinary_x_mul_infinityRecoveredZ R
  have hu : (x * tt) * uu = 1 := by
    have h := congrArg (infinityLocalizedInclusion R) (infinityP_mul_inverse R)
    rw [map_mul,map_one,infinityLocalizedInclusion_p] at h
    change a (xCoordinate R * t R) * uu = 1 at h
    simpa only [map_mul] using h
  have ht : tt = y + x ^ 3 + x ^ 2 + 1 := by
    dsimp [tt,t,Order13SingleSectionFiniteMapIdentities.a,x,y]
    simp only [map_add,map_pow,map_one]
    ring
  have hc : tt ^ 2 - 2 * tt * (x ^ 3 + x ^ 2 + 1) - 4 * x * (x + 1) = 0 := by
    simpa only [map_sub,map_mul,map_add,map_pow,map_one,_root_.map_ofNat,map_zero,tt,x]
      using congrArg a (candidate_equation R)
  have h := Order13ReciprocalOrdinateIdentity.recovered_ordinate x y tt zz uu hx hu ht hc
  simpa only [infinityRecoveredW,infinityRecoveredD,map_add,map_mul,map_pow,map_one,
    _root_.map_ofNat,zz,uu,y,a] using h

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13ReciprocalOrdinateIdentity.recovered_ordinate
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.infinityLocalizedInclusion_recoveredW

end
end

