      k p E.f E.L E.comm E.bundle 2 Hp hH hHp e he_mul he_nat 𝒦
  obtain ⟨φH, hpin, hprim, hnat⟩ := hθnat (E.act m) (E.act_over m)
    (fun t P Q => congrArg Subtype.val (E.act_hom m t P Q))

  have hp : ¬ p ∣ q * q' := fun hdiv => by
    have h0 : ((q * q' : ℕ) : k) = 0 := (CharP.cast_eq_zero_iff k p (q * q')).2 hdiv
    rw [h0] at hqq
    exact not_isUnit_zero hqq
  have htr := CerednikDrinfeld.QM.FakeEllipticCurve.trace_restrict_primitives_eq_intCast_of_charP_of_not_dvd
    hqq' hB Λ hΛ μ hμ star hstar k E Hp hH hHp e he_mul he_nat m φH hpin hprim n hmn hp

  obtain ⟨𝒲, lam, hlam⟩ :=
    AlgebraicGeometry.Scheme.OrderedAffineCover.exists_forall_le_preimage_of_compactSpace (Y := E.A) (n := 2)
      (fun _ => E.A) (fun j => if j = 0 then E.act m else 𝟙 E.A) (fun _ => 𝒦)
  have hlam0 : ∀ w, 𝒲.U w ≤ E.act m ⁻¹ᵁ 𝒦.U (lam 0 w) := fun w => by simpa using hlam 0 w
  have hlam1 : ∀ w, 𝒲.U w ≤ (𝟙 E.A) ⁻¹ᵁ 𝒦.U (lam 1 w) := fun w => by
    simpa [show ((1 : Fin 2) = 0) = False from by decide] using hlam 1 w

  have hmemA : ∀ x : ↥(primitives k Hp), cls (θ x) ∈ A₁ := fun x => hrange ▸ LinearMap.mem_range_self cls (θ x)
  let ψ : ↥(primitives k Hp) →ₗ[k] ↥A₁ := LinearMap.codRestrict A₁ (cls.comp θ) hmemA
  have hψ : ∀ x, (ψ x : H) = cls (θ x) := fun x => rfl
  have hψinj : Function.Injective ψ := by
    intro x y hxy
    have h0 : cls (θ (x - y)) = 0 := by
      rw [map_sub, map_sub]
      exact sub_eq_zero.mpr (by simpa [hψ] using congrArg Subtype.val hxy)
    have := hθinj (x - y) ((hker _).1 h0)
    exact sub_eq_zero.mp this
  have hψsurj : Function.Surjective ψ := by
    intro a
    obtain ⟨z, hz⟩ : (a : H) ∈ LinearMap.range cls := hrange.symm ▸ a.2
    obtain ⟨x, hx⟩ := hθsurj z
