variable [NeZero r]

def traceO : H1 (N * r) ⊤ 𝒪 →ₗ[𝒪] H1 N ⊤ 𝒪 × H1 N ⊤ 𝒪 :=
  (jDegL N (N * r) ⊤ ⊤ 1 𝒪 𝒪 (levelLE_one N r)).prod (jDegL N (N * r) ⊤ ⊤ r 𝒪 𝒪 (levelLE_r N r))

omit [IsLocalRing 𝒪] in
theorem traceO_apply (v : H1 (N * r) ⊤ 𝒪) :
    traceO N r 𝒪 v = (jDeg N (N * r) ⊤ ⊤ 1 𝒪 (levelLE_one N r) v,
      jDeg N (N * r) ⊤ ⊤ r 𝒪 (levelLE_r N r) v) := rfl

private def _root_.MidRankSol.trace (hr : r.Prime) : H1 (N * r) ⊤ 𝒪 →ₗ[R] H1 N ⊤ 𝒪 × H1 N ⊤ 𝒪 :=
  linearMapOfX (traceO N r 𝒪) fun g v => by
    haveI : NeZero g.ℓ := ⟨g.prime.ne_zero⟩
    rw [X_smul_V₁ N S r 𝒪 θ, traceO_apply, traceO_apply, Prod.smul_mk,
      X_smul_V₀ N S r 𝒪 θ, X_smul_V₀ N S r 𝒪 θ,
      jDeg_heckeT_comm_flat (levelLE_one N r) (Nat.coprime_one_right _) g.prime (gen_not_dvd hr g) v,
      jDeg_heckeT_comm_flat (levelLE_r N r) (gen_coprime hr g) g.prime (gen_not_dvd hr g) v]

