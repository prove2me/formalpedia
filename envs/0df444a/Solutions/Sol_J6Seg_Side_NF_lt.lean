namespace J6Seg.Side
open IntMul NLogN IntMul.Kappa.R6 J6Seg

/-- `NF < 2^p` from crude size bounds. -/
theorem NF_lt_sol_aux {d s t T b : ℕ} (hb : 64 ≤ b) (hdb : d ≤ b) (hst : s < t) (htT : t ≤ T)
    (hb6 : b ^ 6 ≤ T) {L : ℕ} (hTL : T = 2 ^ L) (hLb : L ≤ b) : NF d s < 2 ^ (6 * b) := by
  have hk : kF d ≤ 2 * b + 1 := by unfold kF; have := Nat.sqrt_le_self d; omega
  have hlF : lamF d + 1 ≤ 3 * b ^ 2 := by
    have : lamF d ≤ b * (2 * b + 1) := Nat.mul_le_mul hdb hk
    nlinarith
  have hb2 : b ^ 2 ≤ b ^ 6 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hX : (lamF d + 1) * (3 * lamF d + 3) + 1 ≤ b ^ 6 := by
    have e : (lamF d + 1) * (3 * lamF d + 3) + 1 = 3 * (lamF d + 1) ^ 2 + 1 := by ring
    rw [e]
    have : (lamF d + 1) ^ 2 ≤ (3 * b ^ 2) ^ 2 := Nat.pow_le_pow_left hlF 2
    have e6 : b ^ 6 = b ^ 2 * b ^ 4 := by ring
    have h4 : 64 * 64 ≤ b ^ 2 := by nlinarith
    nlinarith
  have hY : lamF d + 1 ≤ b ^ 6 := by
    have : 3 * b ^ 2 ≤ b ^ 6 := by
      have e6 : b ^ 6 = b ^ 2 * b ^ 4 := by ring
      have : 3 ≤ b ^ 4 := by nlinarith
      nlinarith
    omega
  have hZ : 2 * wF d + 1 ≤ b ^ 6 := by
    have : 2 * wF d + 1 ≤ 29 * b + 15 := by unfold wF; omega
    have : 29 * b + 15 ≤ b ^ 2 := by nlinarith
    omega
  have hW : (s + 1) ^ 2 ≤ T ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have hN : NF d s ≤ 1500 * b ^ 6 * b ^ 6 * b ^ 6 * T ^ 2 := by
    unfold NF
    exact Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul (Nat.mul_le_mul_left _ hX) hY) hZ) hW
  have hN2 : 1500 * b ^ 6 * b ^ 6 * b ^ 6 * T ^ 2 ≤ 1500 * T ^ 5 := by
    have : b ^ 6 * b ^ 6 * b ^ 6 ≤ T * T * T := Nat.mul_le_mul (Nat.mul_le_mul hb6 hb6) hb6
    calc 1500 * b ^ 6 * b ^ 6 * b ^ 6 * T ^ 2 = 1500 * (b ^ 6 * b ^ 6 * b ^ 6) * T ^ 2 := by ring
      _ ≤ 1500 * (T * T * T) * T ^ 2 := Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ this)
      _ = 1500 * T ^ 5 := by ring
  have hT5 : 1500 * T ^ 5 < 2 ^ (6 * b) := by
    rw [hTL, ← pow_mul]
    have : 1500 < 2 ^ 11 := by norm_num
    calc 1500 * 2 ^ (L * 5) < 2 ^ 11 * 2 ^ (L * 5) := Nat.mul_lt_mul_of_pos_right this (by positivity)
      _ = 2 ^ (11 + L * 5) := by rw [pow_add]
      _ ≤ 2 ^ (6 * b) := Nat.pow_le_pow_right (by norm_num) (by omega)
  omega

