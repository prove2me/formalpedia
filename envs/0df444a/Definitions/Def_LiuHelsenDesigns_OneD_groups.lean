-- title:
--   Folded SL and symplectic generators, full and projective Cliffords
-- statement:
--   Kassabov’s binary elementary matrices are read in a fixed folded physical order, with three register bits per coordinate cell. For general rank, the two overlapping SL blocks use the source’s AB and BC placement. Small ranks use elementary transvections; rank one uses the identity in SL and the six-element symplectic group directly.
--
--   $$\phi(g)=\operatorname{diag}(g,(g^{-1})^T).$$
--
--   The symplectic family is the image of the source’s twelve conjugations. The full Clifford group is generated by actual H, S and CNOT circuits, including discrete phases; its projective quotient removes its center. Symplectic actions are computed by conjugation of the Hermitian Pauli matrices $i^{x\cdot z}X^xZ^z$. A lift is a function, never assumed a homomorphism.
--
--   The imported fourteen-element family uses the opposite cyclic-shift orientation. sourceSigma transposes its matrices before folding, recovering the family of Eq. (205) as an actual set; the swapped off-diagonal block pairs range over the same list.
-- source:
--   Guoding Liu, Jonas Helsen, STOC 2027 submission #221 (October 2026), pp.30–46, Eqs.(175)–(178),(198)–(205),(236)–(259). https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/221.pdf

import Definitions.Def_LiuHelsenDesigns_OneD_designs
import Definitions.Def_LiuHelsenDesigns_OneD_elementary
import Definitions.Def_LiuHelsenDesigns_OneD_kazhdanBounds
import Definitions.Def_DepthOneQExp_sigma

noncomputable section
open scoped Matrix BigOperators ComplexConjugate

namespace LiuHelsenDesigns.OneD
attribute [local instance] Classical.decEq Classical.propDecidable

abbrev SL (ℓ : ℕ) := Matrix.SpecialLinearGroup (Fin ℓ) (ZMod 2)
abbrev Sp (ℓ : ℕ) := Matrix.symplecticGroup (Fin ℓ) (ZMod 2)
instance spFintype (ℓ : ℕ) : Fintype (Sp ℓ) := Fintype.ofFinite _

def extendBinaryMatrix (n m off : ℕ) (A : Matrix (Fin m) (Fin m) (ZMod 2)) :
    Matrix (Fin n) (Fin n) (ZMod 2) := fun i j =>
  if h : off ≤ i.val ∧ i.val < off+m ∧ off ≤ j.val ∧ j.val < off+m then
    A ⟨i.val-off,by omega⟩ ⟨j.val-off,by omega⟩ else if i = j then 1 else 0

/-- The physical order consists of folded coordinate cells, with three register
bits inside each cell. This is a relabeling of matrix coordinates, never a free
physical permutation between circuit layers. -/
def foldedCoordinate (s p : ℕ) : ℕ :=
  let r := p/3
  let a := if r%2 = 0 then r/2 else s-1-r/2
  (p%3)*s+a
def foldedMatrix (s : ℕ) (A : Matrix (Fin (3*s)) (Fin (3*s)) (ZMod 2)) :
    Matrix (Fin (3*s)) (Fin (3*s)) (ZMod 2) := fun i j =>
  if h : foldedCoordinate s i.val < 3*s ∧ foldedCoordinate s j.val < 3*s then
    A ⟨foldedCoordinate s i.val,h.1⟩ ⟨foldedCoordinate s j.val,h.2⟩ else 0

/-- The published sigma uses the opposite cyclic shift. Transposing the whole
family reverses that shift and swaps the off-diagonal block pair; those pairs
range over the same symmetric list. Its image is exactly the source's Eq. (205)
family before folding. On these involutions transpose is the inverse-transpose
group automorphism, so the referenced Kazhdan bound transports unchanged. -/
def sourceSigma (s : ℕ) (i : Fin 14) : Matrix (Fin (3*s)) (Fin (3*s)) (ZMod 2) :=
  (DepthOneQExp.sigma s i).valᵀ

def slMatrices (ℓ : ℕ) : Finset (Matrix (Fin ℓ) (Fin ℓ) (ZMod 2)) :=
  if ℓ < 6 then
    if ℓ = 1 then {1} else
      (Finset.univ.filter (fun p : Fin ℓ × Fin ℓ => p.1 ≠ p.2)).image
        (fun p => elementary p.1 p.2 (1 : ZMod 2))
  else
    (Finset.univ.image fun i : Fin 14 =>
      extendBinaryMatrix ℓ (3*(ℓ/3)) 0 (foldedMatrix (ℓ/3) (sourceSigma (ℓ/3) i))) ∪
    (Finset.univ.image fun i : Fin 14 =>
      extendBinaryMatrix ℓ (3*(ℓ/3)) (ℓ%3) (foldedMatrix (ℓ/3) (sourceSigma (ℓ/3) i)))

def slGenerators (ℓ : ℕ) : Finset (SL ℓ) :=
  Finset.univ.filter fun g => g.val ∈ slMatrices ℓ

def leviMatrix {ℓ : ℕ} (A : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2)) :=
  Matrix.fromBlocks A 0 0 A⁻¹ᵀ

def symplecticConjugators (ℓ : ℕ) : Finset (Matrix (Fin ℓ ⊕ Fin ℓ) (Fin ℓ ⊕ Fin ℓ) (ZMod 2)) :=
  let E₀ : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2) := fun i j => if i.val = 0 ∧ j.val = 0 then 1 else 0
  let E₁ : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2) := fun i j => if i.val = 1 ∧ j.val = 1 then 1 else 0
  let D : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2) := 1-E₀
  let W₁ : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2) := fun i j =>
    if (i.val%2 = 0 ∧ j.val = i.val+1) ∨ (j.val%2 = 0 ∧ i.val = j.val+1) then 1 else 0
  let W₂ : Matrix (Fin ℓ) (Fin ℓ) (ZMod 2) := fun i j =>
    if (i.val%2 = 1 ∧ j.val = i.val+1) ∨ (j.val%2 = 1 ∧ i.val = j.val+1) then 1 else 0
  let gs := ({1,Matrix.fromBlocks D E₀ E₀ D,
    Matrix.fromBlocks 1 0 E₁ 1,Matrix.fromBlocks 1 0 W₁ 1,
    Matrix.fromBlocks 1 0 W₂ 1,Matrix.fromBlocks 1 0 1 1} : Finset (Matrix _ _ (ZMod 2)))
  gs ∪ gs.image (fun g => Matrix.J (Fin ℓ) (ZMod 2) * g)

def spMatrices (ℓ : ℕ) : Finset (Matrix (Fin ℓ ⊕ Fin ℓ) (Fin ℓ ⊕ Fin ℓ) (ZMod 2)) :=
  ((symplecticConjugators ℓ).product (slMatrices ℓ)).image
    (fun p => p.1 * leviMatrix p.2 * p.1⁻¹)

/-- Rank one is handled directly, because its natural SL image is trivial. -/
def spGenerators (ℓ : ℕ) : Finset (Sp ℓ) :=
  if ℓ = 1 then Finset.univ else Finset.univ.filter fun g => g.val ∈ spMatrices ℓ

def CliffordGroup (n : ℕ) : Subgroup (Unitary n) :=
  Subgroup.closure {U | ∃ C : Circuit,
    LegalCircuit n C ∧ CliffordCircuit C ∧ (U : Mat n) = circuitMatrix n C}
abbrev Cl (n : ℕ) := CliffordGroup n
abbrev PCl (n : ℕ) := (Cl n) ⧸ Subgroup.center (Cl n)
def projectivize (n : ℕ) : Cl n →* PCl n := QuotientGroup.mk' (Subgroup.center (Cl n))

def RepresentsCl (n : ℕ) (C : Circuit) (U : Cl n) : Prop :=
  LegalCircuit n C ∧ CliffordCircuit C ∧ ((U.val : Unitary n) : Mat n) = circuitMatrix n C
def RepresentsPCl (n : ℕ) (C : Circuit) (U : PCl n) : Prop :=
  ∃ V : Cl n, RepresentsCl n C V ∧ projectivize n V = U

/-- Hermitian Pauli matrices with i^{x.z}, not a continuous phase normalizer. -/
def pauliMatrix (n : ℕ) (a : (Fin n ⊕ Fin n) → ZMod 2) : Mat n :=
  fun x y =>
    (Complex.I ^ (∑ i : Fin n, (a (.inl i)).val * (a (.inr i)).val)) *
    (∏ i : Fin n, if x i = Bool.xor (y i) ((a (.inl i)).val = 1) then
      (-1 : ℂ)^((a (.inr i)).val * boolNat (y i)) else 0)

def HasSymplecticAction {n : ℕ} (U : Cl n) (g : Sp n) : Prop :=
  ∀ a : (Fin n ⊕ Fin n) → ZMod 2, ∃ z : ℂ, ‖z‖ = 1 ∧
    ((U.val : Unitary n) : Mat n) * pauliMatrix n a * (((U.val : Unitary n) : Mat n))ᴴ =
      z • pauliMatrix n (g.val.mulVec a)

def HasProjectiveAction {n : ℕ} (U : PCl n) (g : Sp n) : Prop :=
  ∃ V : Cl n, projectivize n V = U ∧ HasSymplecticAction V g

def firstXMatrix (n : ℕ) : Mat n := circuitMatrix n [[(2,[0])]]

def projectiveLiftSet (n : ℕ) (f : Sp n → PCl n) : Set (PCl n) :=
  f '' (spGenerators n : Set (Sp n)) ∪
    projectivize n '' {U : Cl n | ((U.val : Unitary n) : Mat n) = firstXMatrix n}

end LiuHelsenDesigns.OneD


