theorem walk {P : Program} {d : ℕ} (C : OutDigitsPre lim μ x) :
    Ends lim P d outDigitsWalk
      ⟨Light.frame [x.gI, x.gJ, x.dI, x.dJ, x.aMASK, x.k0, x.L, x.wd, x.base, (0 : ℕ), (0 : ℕ)], μ⟩
