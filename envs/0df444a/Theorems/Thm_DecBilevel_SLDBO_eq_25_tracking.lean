-- title:
--   (25), p. 15 — the average tracker equals the average direction
-- statement:
--   Let $(x^k_i,y^k_i,v^k_i)$, the trackers $t^k_{\cdot,i}$ and the directions $d^k_{\cdot,i}$ be generated by Algorithm 1 from BOX 1, with step sizes $\alpha,\beta,\eta>0$, under Assumptions 2.1 and 2.2 ($n\ge1$, $\|v^0\|\le r_v$). Write $\bar z=\frac1n\sum_iz_i$. Then for every $k\ge0$
--   $$\bar t^k_x=\bar d^k_x,\qquad\bar x^{k+1}=\bar x^k-\alpha\bar d^k_x,$$
--   and likewise $\bar t^k_y=\bar d^k_y$, $\bar y^{k+1}=\bar y^k-\beta\bar d^k_y$, and $\bar t^k_v=\bar d^k_v$.
--
--   The averaged iterates therefore move along the averaged local directions, which is how the analysis compares $\bar x^k$ with a gradient step on $\Phi$.
--
--   **Formalization Note.** The page states the $x$ identities; the $y$ and $v$ identities are the ones the proofs of Lemma A.9 ("the relation $\bar d^k_y=\bar t^k_y$", p. 20) and Lemma A.10 ("$\bar d^k_v=\bar t^k_v$", p. 21) use. No identity is claimed for $\bar v^{k+1}$, because of the projection.
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 15, (25) in the proof of Lemma A.4

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem eq_25_tracking {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    avg (trX s k) = avg (dirX s k) ∧ avg (s (k + 1)).x = avg (s k).x - α • avg (dirX s k) ∧
    avg (trY s k) = avg (dirY s k) ∧ avg (s (k + 1)).y = avg (s k).y - β • avg (dirY s k) ∧
    avg (trV s k) = avg (dirV s k) := by sorry

end DecBilevel.SLDBO
