open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII17
open Filter Set Topology
open scoped ContDiff
theorem solution {k : ℕ} {G : ℝ → ℝ} (hG : PS G) (hE : ExtV (k + 1) G 0) {L : ℝ}
    (hL : Tendsto (deriv G) (𝓝[>] (0:ℝ)) (𝓝 L)) : ExtV k (fun x => G x / x) L := by
  have hPS : PS (fun x => G x / x) := hG.div PS.id ev_ne
  have hode : ∀ᶠ x in 𝓝[>] (0:ℝ),
      x * deriv (fun y => G y / y) x + (((0:ℕ) : ℝ) + 1) * (G x / x) = deriv G x := by
    filter_upwards [hG, ev_ne] with x hc hx0
    have hd : HasDerivAt (fun y => G y / y) ((deriv G x * x - G x * 1) / x ^ 2) x :=
      ((hc.differentiableAt (by simp)).hasDerivAt).div (hasDerivAt_id' x) hx0
    rw [hd.deriv]; field_simp; ring
  have hxM : Tendsto (fun x => x * (G x / x)) (𝓝[>] (0:ℝ)) (𝓝 0) := by
    refine hE.tendsto.congr' ?_
    filter_upwards [ev_ne] with x hx
    field_simp
  have hR := euler_RL k 0 hPS hode hxM (RL_succ.1 hE.RL).2
  have hlim := euler_lim hPS hode hxM hL
  simp only [Nat.cast_zero, zero_add, div_one] at hlim
  exact extV_of_RL hPS hR hlim
