-- ===== S4.Def_RP_EtPBC_A_O2Gl0 =====
section

/-!
# S4-EtPBC-A, O2 GLOB (O2Gl0): stage S0 of the global step

GLOB/REL PLAN v1, stage S0. For a cofinite open `U₀` of `P` and a chart `c : A1 k ⟶ P`:
* `exists_g_mem_of_ne`, `exists_g_of_finite`: finitely many nonzero primes of `k[X]`, none equal to `(X - a)`, have a
  common element `g` with `g(a) ≠ 0`;
* `A1pt_injective`, `exists_g_chart`: there is `g₀` with `g₀(a) ≠ 0` and `c(D(g₀)) ⊆ U₀ ∪ {c(X = a)}`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

open AlgebraicGeometry CategoryTheory Polynomial

noncomputable section

namespace RamanujanPetersson.EtPBC.EtDeg

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact
  RamanujanPetersson.EtCompact.Cech RamanujanPetersson.EtPBC.GenGeo RamanujanPetersson.EtPBC.EtMV
  RamanujanPetersson.EtPBC.EtKum RamanujanPetersson.EtPBC.EtShap

universe u

section Alg

variable {k : Type u} [Field k]

theorem exists_g_mem_of_ne (a : k) (y : PrimeSpectrum k[X]) (hbot : y.asIdeal ≠ ⊥)
    (ha : y.asIdeal ≠ Ideal.span {X - C a}) : ∃ g ∈ y.asIdeal, g.eval a ≠ 0 := by
  by_contra h
  push Not at h
  have hle : y.asIdeal ≤ Ideal.span {X - C a} := fun g hg =>
    Ideal.mem_span_singleton.mpr (dvd_iff_isRoot.mpr (h g hg))
  have hmax : y.asIdeal.IsMaximal := y.isPrime.isMaximal hbot
  have htop : Ideal.span {X - C a} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]; exact not_isUnit_X_sub_C a
  exact ha (hmax.eq_of_le htop hle)

end Alg

section Chart

variable {k : Type u} [Field k]

theorem A1pt_injective : Function.Injective (A1pt k) := by
  intro a b h
  have h' : Ideal.span {X - C a} = Ideal.span {X - C b} := congrArg PrimeSpectrum.asIdeal h
  have hm : X - C a ∈ Ideal.span {X - C b} := by
    rw [← h']; exact Ideal.mem_span_singleton_self _
  have hr := dvd_iff_isRoot.mp (Ideal.mem_span_singleton.mp hm)
  simp only [IsRoot, eval_sub, eval_X, eval_C, sub_eq_zero] at hr
  exact hr.symm

end Chart

end RamanujanPetersson.EtPBC.EtDeg

end

