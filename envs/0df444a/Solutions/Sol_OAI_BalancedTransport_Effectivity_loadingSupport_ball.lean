open OAI OAI.BalancedTransport OAI.BalancedTransport.Effectivity
open Recorder Coding BalancedTransport.Geometry
open scoped Classical


theorem solution {z : Space} {C : ℕ} (hz : ∀i, |z i| ≤ C) :
    loadingSupport z 1 ⊆ Metric.closedBall (0 : Space) (C+6 : ℕ) := by
  intro x hx
  rw [loadingSupport, mem_closedEnlargement] at hx
  rw [Metric.mem_closedBall, dist_zero_right, pi_norm_le_iff_of_nonneg (by positivity)]
  intro i
  have h := hx i
  have hzi := abs_le.mp (hz i)
  have hf : |fixedLabel i| ≤ 4 := by fin_cases i <;> norm_num [fixedLabel]
  have hfi := abs_le.mp hf
  have hC : (0:ℝ) ≤ C := Nat.cast_nonneg _
  have h1 : -(4:ℝ) - C ≤ min (fixedLabel i) (z i) := le_min (by linarith) (by linarith)
  have h2 : max (fixedLabel i) (z i) ≤ 4 + C := max_le (by linarith) (by linarith)
  rw [Real.norm_eq_abs, abs_le]
  push_cast
  constructor <;> linarith

