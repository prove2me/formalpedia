theorem solution (R M : Type) [CommRing R] [AddCommGroup M] [Module R M]
    (I : Ideal R) (r : M → M) (hr : TypeDensity.RaisesAdicOrder I r) (j : ℕ) (x y : M) :
    TypeDensity.adicCongr I j (TypeDensity.adicPerturb r x) (TypeDensity.adicPerturb r y) ↔ TypeDensity.adicCongr I j x y := by
  have mono : ∀ k, (I ^ (k+1) • ⊤ : Submodule R M) ≤ I ^ k • ⊤ := fun k =>
    Submodule.smul_mono_left (Ideal.pow_le_pow_right (Nat.le_succ k))
  have eq : TypeDensity.adicPerturb r x - TypeDensity.adicPerturb r y = (x - y) + (r x - r y) := by
    simp only [TypeDensity.adicPerturb]; abel
  constructor
  · intro h
    induction j with
    | zero => simp [TypeDensity.adicCongr]
    | succ k ih =>
      have h' : TypeDensity.adicCongr I k (TypeDensity.adicPerturb r x) (TypeDensity.adicPerturb r y) := mono k h
      have hk := hr k x y (ih h')
      unfold TypeDensity.adicCongr at h hk ⊢
      rw [eq] at h
      simpa using sub_mem h hk
  · intro h
    have hk := mono j (hr j x y h)
    unfold TypeDensity.adicCongr at h hk ⊢
    rw [eq]
    exact Submodule.add_mem _ h hk
