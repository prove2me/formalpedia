-- Source module: Solutions.R6BitProg
/-!
# Round six, bit side: the recursive interchange program for every width `e`

`progH C q e P L A B Cs` interchanges the two chunks of `e` radix-`q` digits of
`P :: L :: hdShape A B Cs e q`, for **every** `e` (not only `e = m^k`):

* `e < m`: `e` single digit swaps (`tailSwaps`);
* `e = m f + r`, `f ≥ 1`: one level (`levelH`) on the first `m f` digits of each chunk, viewed as
  `m` fields of size `q ^ f`, every run `(i, j, r')` of every edge being a recursive call of width
  `r' f < e`; then the `r` leftover digits by single digit swaps.

`progH_correct`: the denotation is the block swap of the two digit runs, when `C.OK (q ^ f)` for
all `f` and `W ^ depH m e ∣ L` (`depH` = recursion depth).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R]

/-! ## Digit swaps -/

/-! ## Digit shapes -/

section Shapes

lemma hdShape_child (A B Cs : Shape) {m N i j r : ℕ} (hi : i + r ≤ m) (hj : j + r ≤ m) :
    hdShape (A ++ List.replicate i N)
        (List.replicate (m - i - r) N ++ (B ++ List.replicate j N))
        (List.replicate (m - j - r) N ++ Cs) r N = hdShape A B Cs m N := by
  have e1 : ∀ X : List ℕ, List.replicate i N ++ (List.replicate r N ++
      (List.replicate (m - i - r) N ++ X)) = List.replicate m N ++ X := by
    intro X
    rw [← List.append_assoc, ← List.append_assoc, ← List.replicate_add, ← List.replicate_add]
    congr 2; omega
  have e2 : ∀ X : List ℕ, List.replicate j N ++ (List.replicate r N ++
      (List.replicate (m - j - r) N ++ X)) = List.replicate m N ++ X := by
    intro X
    rw [← List.append_assoc, ← List.append_assoc, ← List.replicate_add, ← List.replicate_add]
    congr 2; omega
  simp only [hdShape, List.append_assoc, e1, e2]

lemma vol_hdShape_digits (A B Cs : Shape) (m f q : ℕ) :
    vol (hdShape A B Cs m (q ^ f)) = vol (hdShape A B Cs (m * f) q) := by
  rw [vol_hdShape, vol_hdShape, ← pow_mul, mul_comm f m]

end Shapes

/-! ## Recursion depth -/

section Depth

lemma depH_of_le {m e : ℕ} (h : m ≤ e) (hm : 2 ≤ m) :
    depH m e = depH m ((m - 1) * (e / m)) + 1 := by
  rw [depH, dif_pos ⟨h, hm⟩]

lemma depH_of_not {m e : ℕ} (h : ¬ (m ≤ e ∧ 2 ≤ m)) : depH m e = 0 := by
  rw [depH, dif_neg h]

lemma depH_mono (m : ℕ) : ∀ e e', e ≤ e' → depH m e ≤ depH m e' := by
  intro e e'
  induction e' using Nat.strong_induction_on generalizing e with
  | _ e' ih =>
    intro hle
    by_cases h : m ≤ e ∧ 2 ≤ m
    · rw [depH_of_le h.1 h.2, depH_of_le (e := e') (by omega) h.2]
      have := ih ((m - 1) * (e' / m)) (depH_dec ⟨by omega, h.2⟩) ((m - 1) * (e / m))
        (Nat.mul_le_mul_left _ (Nat.div_le_div_right hle))
      omega
    · rw [depH_of_not h]; exact Nat.zero_le _

lemma depH_child {m e w : ℕ} (hm : 2 ≤ m) (he : m ≤ e) (hw : w < m) :
    depH m (w * (e / m)) + 1 ≤ depH m e := by
  rw [depH_of_le he hm]
  have := depH_mono m (w * (e / m)) ((m - 1) * (e / m)) (Nat.mul_le_mul_right _ (by omega))
  omega

end Depth

