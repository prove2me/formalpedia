open Filter Topology Complex
open scoped ContDiff Matrix

namespace ExactVacuumAtlas.EinsteinMaxwell.NP

variable {n : ℕ}

/-! ### `cpdC` -/

theorem contDiffOn_ofReal {f : Pt n → ℝ} {U : Set (Pt n)} (hf : ContDiffOn ℝ ∞ f U) :
    ContDiffOn ℝ ∞ (fun x => (f x : ℂ)) U :=
  ofRealCLM.contDiff.comp_contDiffOn hf

section rules

variable {U : Set (Pt n)} (hU : IsOpen U) {y : Pt n} (hy : y ∈ U) (i : Fin n)
include hU hy

theorem cpdC_mul_of {f g : Pt n → ℂ} (hf : ContDiffOn ℝ ∞ f U) (hg : ContDiffOn ℝ ∞ g U) :
    cpdC i (fun z => f z * g z) y = cpdC i f y * g y + f y * cpdC i g y := by
  have h := ((hasDerivAt_cpdC hU hf hy i).mul (hasDerivAt_cpdC hU hg hy i)).deriv
  simp only [Function.update_eq_self] at h
  exact h

theorem cpdC_sum_of {ι : Type*} (s : Finset ι) {f : ι → Pt n → ℂ}
    (hf : ∀ e ∈ s, ContDiffOn ℝ ∞ (f e) U) :
    cpdC i (fun z => ∑ e ∈ s, f e z) y = ∑ e ∈ s, cpdC i (f e) y :=
  (HasDerivAt.fun_sum fun e he => hasDerivAt_cpdC hU (hf e he) hy i).deriv

end rules

/-! ### Complex matrix fields -/

@[simp] theorem pdMC_apply (i : Fin n) (A : Pt n → Matrix (Fin n) (Fin n) ℂ) (y : Pt n) (a b : Fin n) :
    pdMC i A y a b = cpdC i (fun z => A z a b) y := rfl

namespace SmoothOnC

variable {U : Set (Pt n)} {A B : Pt n → Matrix (Fin n) (Fin n) ℂ}

theorem mul (hA : SmoothOnC A U) (hB : SmoothOnC B U) : SmoothOnC (fun y => A y * B y) U := by
  intro a b
  simp only [Matrix.mul_apply]
  exact ContDiffOn.sum fun c _ => (hA a c).mul (hB c b)

theorem map_ofReal {R : Pt n → Matrix (Fin n) (Fin n) ℝ} (hR : SmoothOn R U) :
    SmoothOnC (fun y => (R y).map (fun t : ℝ => (t : ℂ))) U :=
  fun a b => by simpa only [Matrix.map_apply] using contDiffOn_ofReal (hR a b)

end SmoothOnC

/-- The derivative of a complexified real matrix field is the complexified `pdM` (no hypothesis). -/
theorem pdMC_map_ofReal (i : Fin n) (R : Pt n → Matrix (Fin n) (Fin n) ℝ) (y : Pt n) :
    pdMC i (fun z => (R z).map (fun t : ℝ => (t : ℂ))) y = (pdM i R y).map (fun t : ℝ => (t : ℂ)) := by
  ext a b
  simp only [pdMC_apply, Matrix.map_apply, pdM_apply]
  exact cpdC_ofReal i (fun z => R z a b) y

section mrules

variable {U : Set (Pt n)} (hU : IsOpen U) {y : Pt n} (hy : y ∈ U) (i : Fin n)
  {A B : Pt n → Matrix (Fin n) (Fin n) ℂ}
include hU hy

/-- **Product rule.** -/
theorem pdMC_mul (hA : SmoothOnC A U) (hB : SmoothOnC B U) :
    pdMC i (fun z => A z * B z) y = pdMC i A y * B y + A y * pdMC i B y := by
  ext a b
  simp only [pdMC_apply, Matrix.mul_apply, Matrix.add_apply]
  rw [cpdC_sum_of hU hy i Finset.univ (fun c _ => (hA a c).mul (hB c b)), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun c _ => ?_
  exact cpdC_mul_of hU hy i (hA a c) (hB c b)

