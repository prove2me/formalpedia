    (hc : ∀ w, lo ≤ w → w + dw ≤ hi → c w ≤ c' w) :
    RImplQ I iprog Q lo hi r n st A U e dw c' := by
  intro s f zs l X F w hQ hC h0 hx hX hb h1 h2
  obtain ⟨zs', r1, b1, f1⟩ := h s f zs l X F w hQ hC h0 hx hX hb h1 h2
  exact ⟨zs', r1, b1, f1.mono (hc w h1 h2)⟩

end RQ

end NLogN.KFW

end

section
-- Source module: Solutions.J6SegILJKer2
/-!
# B-line IL, the `J` kernel (B4), part 2: specifications of multiplying register programs

`MSp M p s t c`: the multiplying register program `p : RM` (products through the
multiplication procedure with specification `M`) is executable from `s`, ends in `t` and costs
at most `c`; the analogue of `KIL.Sp`. Here: composition (`MSp.seq`), plain register programs
(`MSp.rs`), a multiplication on a managed state (`MSp.mul`: `Φm + O(X)` for `X`-bit operands,
given `MulBnd M X Φm`), the branch (`MSp.ite`), the counted loop through managed states
(`MSp.rep`, overhead quadratic only in the bit size of the *count*) and the compilation
(`MSp.irun`). Also `floorDivE` / `rsE`: the rounding `rs P` as linear work.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function

/-! ## Specifications -/

section msp
variable {M : MulSpec}

theorem MSp.mono {p : RM} {s t : IState HS} {c c' : ℕ} (h : MSp M p s t c) (hc : c ≤ c') :
    MSp M p s t c' := ⟨h.1, h.2.1, le_trans h.2.2 hc⟩

end msp

/-! ## The rounding as linear work -/

end J6Seg.JK

end

section
-- Source module: Solutions.J6SegKr10
/-!
# B3 (chunk kernel), part 10: the line's chunk kernel as a `RowBody6` procedure

* `blFrom_bnd`, `descsOf_ok`, `sumN_descsOf`: the block descriptors of a chunk have lengths
  `1 ≤ n ≤ λ`, tables of length `n`, and total length `≤ λ`;
* **`chunkK_rowBody6`**: if procedure `e` is `chunkI pM`, it is a `RowBody6` row kernel for the
  line's chunk kernel `liftG (chunkK P R s t λ α q)` with the tables
  `tabK P pk b λ diL giL gamL ddL (descsOf … q)` (= `chunkTab6` at the round-six parameters).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

section desc
variable {s t lam : ℕ}

theorem blFrom_bnd (hl : 1 ≤ lam) (c : ℕ) : ∀ (f st : ℕ), c * lam ≤ st →
    (∀ b ∈ blFrom s t lam (min s (c * lam + lam)) f st, 1 ≤ b.2 ∧ b.2 ≤ lam) ∧
    ((blFrom s t lam (min s (c * lam + lam)) f st).map Prod.snd).sum + st ≤
      max st (c * lam + lam)
  | 0, st, _ => by simp [blFrom]
  | f + 1, st, hst => by
    unfold blFrom
    split_ifs with h
    · have he := en_le_chunk (s := s) (t := t) hl hst (lt_of_lt_of_le h (min_le_right _ _))
      obtain ⟨ih1, ih2⟩ := blFrom_bnd hl c f (st + 1 + enF s t lam st) (by omega)
      refine ⟨fun b hb => ?_, ?_⟩
      · rcases List.mem_cons.1 hb with rfl | hb
        · simp only; omega
        · exact ih1 b hb
      · simp only [List.map_cons, List.sum_cons]
        have : max (st + 1 + enF s t lam st) (c * lam + lam) = c * lam + lam := by omega
        rw [this] at ih2
        omega
    · simp

theorem sumN_map (l : List (ℕ × ℕ)) (F G : ℕ → ℕ → ℤ) :
    sumN (l.map fun b => (b.2, (List.range b.2).map (F b.1), (List.range b.2).map (G b.1))) =
      (l.map Prod.snd).sum := by
  induction l with
  | nil => rfl
  | cons b l ih => simp only [List.map_cons, sumN, List.sum_cons]; rw [ih]

theorem sumN_descsOf (hl : 1 ≤ lam) (T : Tables) (c : ℕ) : sumN (descsOf s t lam T c) ≤ lam := by
  unfold descsOf chunkBl
  rw [sumN_map]
  have := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).2
  omega

theorem descsOf_ok (hl : 1 ≤ lam) (T : Tables) (c : ℕ) :
    ∀ d ∈ descsOf s t lam T c, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
      (∀ v ∈ d.2.1, ∃ h < d.1, ∃ c', v = T.am c' h) ∧ (∀ v ∈ d.2.2, ∃ h < d.1, ∃ c', v = T.ap c' h) := by
  intro d hd
  unfold descsOf chunkBl at hd
  obtain ⟨b, hb, rfl⟩ := List.mem_map.1 hd
  obtain ⟨h1, h2⟩ := (blFrom_bnd (s := s) (t := t) hl c lam (c * lam) le_rfl).1 b hb
  refine ⟨h1, by simp, by simp, h2, ?_, ?_⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩
  · intro v hv
    obtain ⟨h, hh, rfl⟩ := List.mem_map.1 hv
    exact ⟨h, List.mem_range.1 hh, b.1, rfl⟩

end desc

end J6Seg.KR

end

section
-- Source module: Solutions.J6SegILPre13
/-!
# B-line IL, pre-tables (B5), part 13: the block iteration (pure)

`bst e x` is the start of the block after the one at `x` (or `x` itself once `x ≥ e`);
`blFrom_succ`: one more round of fuel appends the block at `bst^[k] st` (if `< e`), and
`bst_iter_eq`: `bst^[k] st = st + Σ lengths`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.PreT

open IntMul IntMul.HvdH

section pure
variable (sN tN lam : ℕ)

theorem blFrom_len (e : ℕ) : ∀ k st, (J6Seg.blFrom sN tN lam e k st).length ≤ k
  | 0, _ => by simp [J6Seg.blFrom]
  | k + 1, st => by
    simp only [J6Seg.blFrom]
    split_ifs
    · simp only [List.length_cons]; have := blFrom_len e k (st + 1 + J6Seg.enF sN tN lam st); omega
    · simp

end pure

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre23
/-!
# B-line IL, pre-tables (B5′, `tabK2` layout), part 23: the block loop and chunk part A

`blkL2`, `partA2` are `blkL`, `partA` with `blkB2`; the descriptors are `dsEnc2 b`, all at width
`BW A` (no `BH`/`BD`, no `M`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL RS IntMul.HvdH

/-! ## Lengths and bounds of the new descriptors -/

theorem dsEnc2_length (b : ℕ) : ∀ ds : List (ℕ × List ℤ × List ℤ),
    (∀ d ∈ ds, d.2.1.length = d.1 ∧ d.2.2.length = d.1) →
    (J6Seg.KR.dsEnc2 b ds).length = 4 * ds.length + 2 * J6Seg.KR.sumN ds
  | [], _ => by simp [J6Seg.KR.dsEnc2, J6Seg.KR.sumN]
  | d :: ds, h => by
    have ih := dsEnc2_length b ds (fun d' hd' => h d' (List.mem_cons_of_mem _ hd'))
    have hd := h d List.mem_cons_self
    simp only [J6Seg.KR.dsEnc2, List.flatMap_cons, List.length_append] at ih ⊢
    simp only [J6Seg.KR.encD2, J6Seg.KR.blkHdr2, List.length_append, List.length_cons,
      List.length_nil, hd.1, hd.2, J6Seg.KR.sumN, List.length_cons, ih]
    ring

theorem hdr2_abs {n b A : ℕ} (hA : 2 ≤ A) (hn : n ≤ 2 ^ A) (hb : b ≤ 2 ^ A) :
    ∀ x ∈ J6Seg.KR.blkHdr2 n b, |x| < 2 ^ BW A := by
  have h1 : 2 * n * b ≤ 2 ^ (2 * A + 1) := by
    calc 2 * n * b ≤ 2 * 2 ^ A * 2 ^ A := Nat.mul_le_mul (Nat.mul_le_mul_left 2 hn) hb
      _ = 2 ^ (2 * A + 1) := by ring
  have h2 : 2 ^ (2 * A + 1) < 2 ^ BW A := Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega)
  have hA1 : 2 ^ A ≤ 2 ^ (2 * A + 1) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hA2 : 2 ^ A ≤ 2 ^ (2 * A) := Nat.pow_le_pow_right (by norm_num) (by omega)
  have hA3 : 2 ^ (2 * A + 1) = 2 * 2 ^ (2 * A) := by ring
  have hc : Nat.clog 2 (2 * n) ≤ 2 * n := by
    apply Nat.clog_le_of_le_pow
    exact (Nat.lt_two_pow_self (n := 2 * n)).le
  intro x hx
  simp only [J6Seg.KR.blkHdr2, List.mem_cons, List.not_mem_nil, or_false] at hx
  have key : ∀ m : ℕ, m ≤ 2 ^ (2 * A + 1) → |((m : ℕ) : ℤ)| < 2 ^ BW A := by
    intro m hm
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast lt_of_le_of_lt hm h2
  rcases hx with rfl | rfl | rfl | rfl
  · exact key n (by omega)
  · exact key _ (by omega)
  · exact key _ (by omega)
  · exact key _ h1

theorem dsEnc2_bnd {P R sN tN lam aN A b q : ℕ} (hl : 1 ≤ lam)
    (TB : TabB P R sN tN aN lam A) (hA : 2 ≤ A) (hbA : b ≤ 2 ^ A) (hlA : lam ≤ 2 ^ A) :
    NLogN.Bnd (BW A) (J6Seg.KR.dsEnc2 b (J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q)) := by
  intro x hx
  simp only [J6Seg.KR.dsEnc2, List.mem_flatMap] at hx
  obtain ⟨d, hd, hx⟩ := hx
  obtain ⟨h1, -, -, hdl, ham, hap⟩ := J6Seg.KR.descsOf_ok hl _ q d hd
  have hBW : (2 : ℤ) ^ A < 2 ^ BW A := by
    have : 2 ^ A < 2 ^ BW A := Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega)
    exact_mod_cast this
  apply NLogN.zsz_le_of_abs
  simp only [J6Seg.KR.encD2, List.mem_append] at hx
  rcases hx with (hx | hx) | hx
  · exact hdr2_abs hA (hdl.trans hlA) hbA x hx
  · obtain ⟨h, hh, c', rfl⟩ := ham x hx
    exact lt_of_le_of_lt (TB.am c' h (by omega)) hBW
  · obtain ⟨h, hh, c', rfl⟩ := hap x hx
    exact lt_of_le_of_lt (TB.ap c' h (by omega)) hBW

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre26
/-!
# B-line IL, pre-tables (B5′), part 26: `tabQ2` at the round-six parameters

`tabQ2 Q6 R6 s t (lamP d) α pk b q` is, by `rfl`, `KR.tabK2` with exactly the arguments of
`chunkTab6` (so a `chunkTab6 := KR.tabK2 …` redefinition makes `chunkStore2_sp` produce
`tabsT (chunkTab6 …) nc` directly).
-/

namespace J6Seg.PreT

open J6Seg

/-- `TabB` is monotone in the width `A`. -/
theorem TabB.mono {P R sN tN aN lam A A' : ℕ} (h : TabB P R sN tN aN lam A) (hA : A ≤ A') :
    TabB P R sN tN aN lam A' := by
  have e : (2 : ℤ) ^ A ≤ 2 ^ A' := pow_le_pow_right₀ (by norm_num) hA
  exact ⟨fun j => (h.en j).trans e, fun k hk => (h.di k hk).trans e, fun k hk => (h.dd k hk).trans e,
    fun k hk => (h.gam k hk).trans e, fun k hk => (h.gi k hk).trans e,
    fun c k hk => (h.am c k hk).trans e, fun c k hk => (h.ap c k hk).trans e⟩

end J6Seg.PreT

end

section
-- Source module: Solutions.J6SegILPre29
/-!
# B-line IL, pre-tables (B5′), part 29: size facts of the chunk-store output

For `T = tabsT (tabQ2 P R s t λ α pk b) nc` (the list `chunkStore2_sp` builds):

* `tabsT_tabQ2_length`: `|T| ≤ nc · (9 + 10 λ)`;
* `tabsT_tabQ2_bnd`: `NLogN.Bnd (BW A + P + pk + b + 2) T` (under `TabB … A`, `λ ≤ 2^A`, `2 ≤ A`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.PreT

open IntMul NLogN NLogN.KIL J6Seg

theorem tabQ2_length {P R sN tN lam aN pk b : ℕ} (hl : 1 ≤ lam) (q : ℕ) :
    (tabQ2 P R sN tN lam aN pk b q).length ≤ 8 + 10 * lam := by
  simp only [tabQ2, KR.tabK2, List.length_append, List.length_cons, List.length_nil,
    List.length_reverse, diL, giL, gamL, ddL, List.length_map, List.length_range]
  set ds := J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q
  have hlen := dsEnc2_length b ds (fun d hd => by
    obtain ⟨_, h2, h3, _⟩ := J6Seg.KR.descsOf_ok hl _ q d hd; exact ⟨h2, h3⟩)
  have hdl : ds.length ≤ lam := by
    simp only [ds, J6Seg.descsOf, J6Seg.chunkBl, List.length_map]
    exact blFrom_len sN tN lam _ lam _
  have hds : J6Seg.KR.sumN ds ≤ lam := J6Seg.KR.sumN_descsOf hl _ _
  omega

/-- **The entries of the chunk tables** are below `2^(BW A + P + pk + b + 2)`. -/
theorem tabsT_tabQ2_bnd_sol_aux {P R sN tN lam aN A pk b : ℕ} (hl : 1 ≤ lam) (hA : 2 ≤ A)
    (hlA : lam ≤ 2 ^ A) (TB : TabB P R sN tN aN lam A) (hbA : b ≤ 2 ^ A) (nc : ℕ) :
    NLogN.Bnd (BW A + P + pk + b + 2) (tabsT (tabQ2 P R sN tN lam aN pk b) nc) := by
  set B := BW A + P + pk + b + 2
  have mono : ∀ m : ℕ, m ≤ B → (2 : ℤ) ^ m ≤ 2 ^ B := fun m hm => pow_le_pow_right₀ (by norm_num) hm
  have hWB : (2 : ℤ) ^ BW A ≤ 2 ^ B := mono _ (by omega)
  have hAW : (2 : ℤ) ^ A < 2 ^ BW A := by
    have : 2 ^ A < 2 ^ BW A := Nat.pow_lt_pow_right (by norm_num) (by unfold BW; omega)
    exact_mod_cast this
  have small : ∀ m : ℕ, m ≤ 32 * 2 ^ A → |((m : ℕ) : ℤ)| < 2 ^ B := by
    intro m hm
    rw [abs_of_nonneg (by positivity)]
    have : m < 2 ^ (A + 6) := by rw [pow_add]; omega
    have h2 : 2 ^ (A + 6) ≤ 2 ^ B := Nat.pow_le_pow_right (by norm_num) (by simp only [B, BW]; omega)
    exact_mod_cast lt_of_lt_of_le this h2
  have pw : ∀ m : ℕ, m + 1 ≤ B → |(2 : ℤ) ^ m| < 2 ^ B := by
    intro m hm
    rw [abs_of_nonneg (by positivity)]
    exact lt_of_lt_of_le (pow_lt_pow_right₀ (by norm_num) (by omega)) (mono _ hm)
  have tab : ∀ x : ℤ, |x| ≤ 2 ^ A → |x| < 2 ^ B := fun x hx => lt_of_lt_of_le (hx.trans_lt hAW) hWB
  intro x hx
  simp only [tabsT, List.mem_flatMap, List.mem_range] at hx
  obtain ⟨q, -, hx⟩ := hx
  simp only [segT, List.mem_cons] at hx
  have hL := tabQ2_length (P := P) (R := R) (sN := sN) (tN := tN) (aN := aN) (pk := pk) (b := b) hl q
  rcases hx with rfl | hx
  · exact NLogN.zsz_le_of_abs <| small _ (by omega)
  set ds := J6Seg.descsOf sN tN lam (mkTables P R sN tN aN) q
  have hlen := dsEnc2_length b ds (fun d hd => by
    obtain ⟨_, h2, h3, _⟩ := J6Seg.KR.descsOf_ok hl _ q d hd; exact ⟨h2, h3⟩)
  have hdl : ds.length ≤ lam := by
    simp only [ds, J6Seg.descsOf, J6Seg.chunkBl, List.length_map]
    exact blFrom_len sN tN lam _ lam _
  have hds : J6Seg.KR.sumN ds ≤ lam := J6Seg.KR.sumN_descsOf hl _ _
  simp only [tabQ2, KR.tabK2, List.mem_append, List.mem_cons, List.not_mem_nil, or_false,
    List.mem_reverse, diL, giL, gamL, ddL, List.mem_map, List.mem_range] at hx
  rcases hx with (((((hx | hx | hx | hx | hx | hx | hx | hx) | ⟨k, hk, rfl⟩) | ⟨k, hk, rfl⟩) |
    ⟨k, hk, rfl⟩) | ⟨k, hk, rfl⟩) | hx
  · subst hx; exact NLogN.zsz_le_of_abs <| small _ (by omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| pw _ (by omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| pw _ (by omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| small _ (le_trans hdl (by omega))
  · subst hx; exact NLogN.zsz_le_of_abs <| small _ (by rw [hlen]; omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| pw _ (by omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| pw _ (by omega)
  · subst hx; exact NLogN.zsz_le_of_abs <| small _ (by omega)
  · exact NLogN.zsz_le_of_abs <| tab _ (TB.di k hk)
  · exact NLogN.zsz_le_of_abs <| tab _ (TB.gi k hk)
  · exact NLogN.zsz_le_of_abs <| tab _ (TB.gam k hk.le)
  · exact NLogN.zsz_le_of_abs <| tab _ (TB.dd k hk)
  · have h := dsEnc2_bnd (q := q) hl TB hA hbA hlA x hx
    exact h.trans (by omega)

end J6Seg.PreT

end

theorem solution : type_of% @J6Seg.PreT.tabsT_tabQ2_bnd_sol_aux := @J6Seg.PreT.tabsT_tabQ2_bnd_sol_aux
