-- title:
--   Maximal ideal of a fibre product at a pair of rational points
-- statement:
--   Let $k$ be a field and let $X, Y$ be schemes equipped with morphisms $f_X : X \to \operatorname{Spec} k$ and $f_Y : Y \to \operatorname{Spec} k$. Let $x : \operatorname{Spec} k \to X$ be a section of $f_X$, i.e. $x$ followed by $f_X$ is the identity of $\operatorname{Spec} k$, and likewise let $y : \operatorname{Spec} k \to Y$ satisfy that $y$ followed by $f_Y$ is the identity; thus $x$ and $y$ are $k$-rational points of $X$ and $Y$. Combining the two equalities gives $x \circ\!\!\cdot f_X = y \circ\!\!\cdot f_Y$ in diagrammatic order, so the universal property yields the induced morphism $\operatorname{Spec} k \to X \times_{\operatorname{Spec} k} Y$ given by `pullback.lift`; let $z$ be the image under it of the closed point of $\operatorname{Spec} k$, a point of the pullback scheme. The assertion is an equality of ideals of the stalk $\mathcal{O}_{X \times_k Y, z}$ (a local ring): its maximal ideal is the supremum of the ideal generated by the image of the maximal ideal of $\mathcal{O}_{X, \mathrm{pr}_1(z)}$ under the ring homomorphism underlying the stalk map of the first projection at $z$, and the ideal generated by the image of the maximal ideal of $\mathcal{O}_{Y, \mathrm{pr}_2(z)}$ under the stalk map of the second projection at $z$. No transport of stalks is involved: the stalks of the factors are taken at the images $\mathrm{pr}_1(z)$, $\mathrm{pr}_2(z)$ themselves.
--
--   This is the local (stalk-level) form of the classical statement that the Zariski tangent space of a product of $k$-schemes at a pair of rational points is the direct sum of the tangent spaces of the factors, in the shape $\mathfrak{m}_{X\times_k Y, z} = \mathfrak{m}_{X,x}\mathcal{O}_{X\times_k Y,z} + \mathfrak{m}_{Y,y}\mathcal{O}_{X\times_k Y,z}$. It is used in the study of the relative group law on a Jacobian with good reduction, where germs of the multiplication map are compared with the two projections modulo the square of the maximal ideal.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicGeometry_maximalIdeal_stalk_pullback_eq_map_stalkMap_fst_sup_map_stalkMap_snd_of_section.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

theorem AlgebraicGeometry.maximalIdeal_stalk_pullback_eq_map_stalkMap_fst_sup_map_stalkMap_snd_of_section
    {k : Type u} [Field k] {X Y : Scheme.{u}}
    (fX : X ⟶ Spec (CommRingCat.of k)) (fY : Y ⟶ Spec (CommRingCat.of k))
    (x : Spec (CommRingCat.of k) ⟶ X) (hx : x ≫ fX = 𝟙 _)
    (y : Spec (CommRingCat.of k) ⟶ Y) (hy : y ≫ fY = 𝟙 _) :
    IsLocalRing.maximalIdeal ((pullback fX fY).presheaf.stalk
        (pullback.lift x y (hx.trans hy.symm) (IsLocalRing.closedPoint k))) =
      (IsLocalRing.maximalIdeal (X.presheaf.stalk
          (pullback.fst fX fY (pullback.lift x y (hx.trans hy.symm) (IsLocalRing.closedPoint k))))).map
        ((pullback.fst fX fY).stalkMap
          (pullback.lift x y (hx.trans hy.symm) (IsLocalRing.closedPoint k))).hom ⊔
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk
          (pullback.snd fX fY (pullback.lift x y (hx.trans hy.symm) (IsLocalRing.closedPoint k))))).map
        ((pullback.snd fX fY).stalkMap
          (pullback.lift x y (hx.trans hy.symm) (IsLocalRing.closedPoint k))).hom := by sorry
