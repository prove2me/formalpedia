variable {F : Type} [Field F] (X : Scheme.{0}) [IsIntegral X] (φ : F ≃+* X.functionField)

noncomputable def θ (x : X) : X.presheaf.stalk x →+* F :=
  (φ.symm : X.functionField ≃+* F).toRingHom.comp (algebraMap (X.presheaf.stalk x) X.functionField)

theorem θ_injective (x : X) : Function.Injective (θ X φ x) :=
  φ.symm.injective.comp (IsFractionRing.injective (X.presheaf.stalk x) X.functionField)

theorem range_θ (x : X) : (θ X φ x).range = SemistableModel.localRing X φ x := rfl

noncomputable def locEquiv (x : X) : X.presheaf.stalk x ≃+* ↥(SemistableModel.localRing X φ x) :=
  RingEquiv.ofBijective ((θ X φ x).rangeRestrict) ⟨fun a b h => θ_injective X φ x (congrArg Subtype.val h),
    fun y => by obtain ⟨s, hs⟩ := y.2; exact ⟨s, Subtype.ext hs⟩⟩

theorem coe_locEquiv (x : X) (s : X.presheaf.stalk x) :
    ((locEquiv X φ x s : ↥(SemistableModel.localRing X φ x)) : F) = φ.symm (algebraMap _ X.functionField s) := rfl

scoped instance isLocalRing_localRing (x : X) : IsLocalRing ↥(SemistableModel.localRing X φ x) :=
  IsLocalRing.of_surjective' (locEquiv X φ x).toRingHom (locEquiv X φ x).surjective

noncomputable def LR (x : X) : LocalSubring F := ⟨SemistableModel.localRing X φ x⟩

theorem LR_toSubring (x : X) : (LR X φ x).toSubring = SemistableModel.localRing X φ x := rfl

theorem localRing_le_of_specializes {η x : X} (h : η ⤳ x) :
    SemistableModel.localRing X φ x ≤ SemistableModel.localRing X φ η := by
  rintro f ⟨s, rfl⟩
  refine ⟨(X.presheaf.stalkSpecializes h).hom s, ?_⟩
  show φ.symm _ = φ.symm _
  congr 1
  change (X.presheaf.stalkSpecializes h ≫ X.presheaf.stalkSpecializes _).hom s =
    (X.presheaf.stalkSpecializes _).hom s
  rw [TopCat.Presheaf.stalkSpecializes_comp]

theorem θ_germ_appTop {R : Type} [CommRing R] (f : X ⟶ Spec (CommRingCat.of R)) (x : X) (r : R) :
    θ X φ x ((X.presheaf.germ ⊤ x trivial).hom (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r))) =
      φ.symm (SemistableModel.baseToFunctionField f r) := by
  show φ.symm _ = φ.symm _
  congr 1
  show (X.presheaf.germ ⊤ x trivial ≫ X.presheaf.stalkSpecializes _).hom _ = _
  rw [TopCat.Presheaf.germ_stalkSpecializes]
  rfl

omit [IsIntegral X] in

theorem not_isUnit_germ_of_base_eq_closedPoint {R : Type} [CommRing R] [IsLocalRing R]
    (f : X ⟶ Spec (CommRingCat.of R)) (x : X)
    (hx : f.base x = closedPoint R) (r : R) (hr : r ∈ maximalIdeal R) :
    ¬ IsUnit ((X.presheaf.germ ⊤ x trivial).hom (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r))) := by
  intro hu
  have hx' : x ∈ X.basicOpen (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r)) :=
    (X.mem_basicOpen_top _ _).mpr hu
  rw [← Scheme.preimage_basicOpen_top] at hx'
  have hx'' : f.base x ∈ (Spec (CommRingCat.of R)).basicOpen ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom r) := hx'
  rw [basicOpen_eq_of_affine] at hx''
  rw [hx] at hx''
  exact (PrimeSpectrum.mem_basicOpen _ _).mp hx'' hr

variable {X} {φ}

theorem mem_maximalIdeal_iff_locEquiv (x : X) (s : X.presheaf.stalk x) :
    s ∈ maximalIdeal (X.presheaf.stalk x) ↔
      (locEquiv X φ x s) ∈ maximalIdeal ↥(SemistableModel.localRing X φ x) := by
  simp only [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
  exact (MulEquiv.isUnit_map (locEquiv X φ x).toMulEquiv (x := s)).not.symm

theorem centre_of_LR_le (x : X) (V : ValuationSubring F) (hV : LR X φ x ≤ V.toLocalSubring) :
    (∀ s : X.presheaf.stalk x, algebraMap (X.presheaf.stalk x) X.functionField s ∈
        V.comap (φ.symm : X.functionField ≃+* F).toRingHom) ∧
    (∀ s ∈ maximalIdeal (X.presheaf.stalk x), algebraMap (X.presheaf.stalk x) X.functionField s ∈
        (V.comap (φ.symm : X.functionField ≃+* F).toRingHom).nonunits) := by
  obtain ⟨hle, hloc⟩ := hV
  constructor
  · intro s
    rw [ValuationSubring.mem_comap]
    exact hle ⟨s, rfl⟩
  · intro s hs
    have hmem : φ.symm (algebraMap _ X.functionField s) ∈ V := hle ⟨s, rfl⟩

    have h1 : (locEquiv X φ x s) ∈ maximalIdeal _ := (mem_maximalIdeal_iff_locEquiv x s).mp hs
    have h2 : ¬ IsUnit (⟨φ.symm (algebraMap _ X.functionField s), hmem⟩ : V) := by
      intro hu
      apply (IsLocalRing.mem_maximalIdeal _).mp h1

      have := hloc.map_nonunit (locEquiv X φ x s)
      apply this
      convert hu <;> first | rfl | exact Iff.rfl | simp
    have h3 : φ.symm (algebraMap _ X.functionField s) ∈ V.nonunits :=
      (ValuationSubring.coe_mem_nonunits_iff (a := ⟨_, hmem⟩)).mpr h2

    rw [ValuationSubring.mem_nonunits_iff_or] at h3 ⊢
    rcases h3 with h3 | h3
    · left
      have : (φ.symm : X.functionField ≃+* F) (algebraMap _ X.functionField s) = 0 := h3
      exact (map_eq_zero_iff _ φ.symm.injective).mp this
    · right
      rw [ValuationSubring.mem_comap]
      intro h4
      apply h3
      have : (φ.symm : X.functionField ≃+* F).toRingHom (algebraMap _ X.functionField s)⁻¹ =
          (φ.symm (algebraMap _ X.functionField s))⁻¹ := map_inv₀ _ _
      rw [← this]
      exact h4

theorem LR_le_of_forall_iff {B : Set F} {M : Set F} (x : X) (V : ValuationSubring F)
    (hBV : B ⊆ V) (hcen : ∀ b ∈ B, b ∈ M ↔ b ∈ V.nonunits) (hzero : (0 : F) ∈ M)
    (hx : ∀ f : F, f ∈ SemistableModel.localRing X φ x ↔ ∃ b c : F, b ∈ B ∧ c ∈ B ∧ c ∉ M ∧ f * c = b) :
    LR X φ x ≤ V.toLocalSubring := by
  have key : ∀ f : F, f ∈ SemistableModel.localRing X φ x → f ∈ V ∧ (f ∉ V.nonunits → f⁻¹ ∈ SemistableModel.localRing X φ x) := by
    intro f hf
    obtain ⟨b, c, hb, hc, hcM, hfc⟩ := (hx f).mp hf
    have hcV : c ∉ V.nonunits := fun h => hcM ((hcen c hc).mpr h)
    have hc0 : c ≠ 0 := by rintro rfl; exact hcM hzero
    have hcinv : c⁻¹ ∈ V := by
      by_contra h
      exact hcV ((V.mem_nonunits_iff_or).mpr (Or.inr h))
    have hfeq : f = b * c⁻¹ := by rw [← hfc, mul_assoc, mul_inv_cancel₀ hc0, mul_one]
    refine ⟨hfeq ▸ V.mul_mem _ _ (hBV hb) hcinv, fun hfu => ?_⟩

    have hbV : b ∉ V.nonunits := by
      intro hbn
      apply hfu
      rw [hfeq]
      rw [ValuationSubring.mem_nonunits_iff] at hbn ⊢
      have h2 : V.valuation c⁻¹ ≤ 1 := (V.valuation_le_one_iff _).mpr hcinv
      calc V.valuation (b * c⁻¹) = V.valuation b * V.valuation c⁻¹ := map_mul _ _ _
        _ ≤ V.valuation b * 1 := mul_le_mul_right h2 _
        _ = V.valuation b := mul_one _
        _ < 1 := hbn
    have hbM : b ∉ M := fun h => hbV ((hcen b hb).mp h)
    have hb0 : b ≠ 0 := by rintro rfl; exact hbM hzero
    refine (hx f⁻¹).mpr ⟨c, b, hc, hb, hbM, ?_⟩
    rw [hfeq, mul_inv, inv_inv, mul_comm b⁻¹ c, mul_assoc, inv_mul_cancel₀ hb0, mul_one]
  refine ⟨fun f hf => (key f hf).1, ⟨?_⟩⟩
  intro a ha

  obtain ⟨v, hv⟩ := ha.exists_right_inv
  have hv' : (a : F) * (v : F) = 1 := congrArg Subtype.val hv
  have ha0 : (a : F) ≠ 0 := fun h => by rw [h, zero_mul] at hv'; exact zero_ne_one hv'
  have haV : (a : F) ∉ V.nonunits := by
    intro h
    rcases (V.mem_nonunits_iff_or).mp h with h | h
    · exact ha0 h
    · apply h
      rw [inv_eq_of_mul_eq_one_right hv']
      exact v.2
  have hinv := (key a a.2).2 haV
  exact ⟨⟨a, ⟨(a : F)⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ ha0), Subtype.ext (inv_mul_cancel₀ ha0)⟩, rfl⟩

theorem mem_nonunits_of_LR_le (x : X) (V : ValuationSubring F) (hV : LR X φ x ≤ V.toLocalSubring)
    (f : F) (hf : f ∈ SemistableModel.localRing X φ x) (hnu : ¬ IsUnit (⟨f, hf⟩ : ↥(SemistableModel.localRing X φ x))) :
    f ∈ V.nonunits := by
  obtain ⟨hle, hloc⟩ := hV
  have hfV : f ∈ V := hle hf
  have : ¬ IsUnit (⟨f, hfV⟩ : V) := by
    intro hu
    exact hnu (hloc.map_nonunit ⟨f, hf⟩ (by convert hu <;> first | rfl | exact Iff.rfl | simp))
  exact (ValuationSubring.coe_mem_nonunits_iff (a := ⟨f, hfV⟩)).mpr this

theorem LR_le_of_forall_iff' {R : Type} [CommRing R] [Algebra R F] (B : Subalgebra R F) (𝔪 : Ideal ↥B)
    (x : X) (V : ValuationSubring F)
    (hBV : ∀ b : ↥B, (b : F) ∈ V) (hcen : ∀ b : ↥B, b ∈ 𝔪 ↔ (b : F) ∈ V.nonunits)
    (hx : ∀ f : F, f ∈ SemistableModel.localRing X φ x ↔ ∃ b c : ↥B, c ∉ 𝔪 ∧ f * (c : F) = (b : F)) :
    LR X φ x ≤ V.toLocalSubring := by
  refine LR_le_of_forall_iff (B := (B : Set F)) (M := {f | ∃ h : f ∈ B, (⟨f, h⟩ : ↥B) ∈ 𝔪}) x V
    (fun b hb => hBV ⟨b, hb⟩) (fun b hb => ?_) ⟨B.zero_mem, 𝔪.zero_mem⟩ (fun f => (hx f).trans ?_)
  · exact ⟨fun ⟨h, hm⟩ => (hcen ⟨b, h⟩).mp hm, fun hn => ⟨hb, (hcen ⟨b, hb⟩).mpr hn⟩⟩
  · constructor
    · rintro ⟨b, c, hc, hfc⟩
      exact ⟨b, c, b.2, c.2, fun ⟨_, hm⟩ => hc hm, hfc⟩
    · rintro ⟨b, c, hb, hc, hcM, hfc⟩
      exact ⟨⟨b, hb⟩, ⟨c, hc⟩, fun hm => hcM ⟨hc, hm⟩, hfc⟩

omit [IsIntegral X] in

theorem mem_of_isIntegral_adjoin {R : Type} [CommRing R] [Algebra R F] (B : Subalgebra R F)
    (hBn : ∀ x : F, _root_.IsIntegral ↥B x → x ∈ B) (j : F) (hj : j ∈ B) (g : F)
    (hg : _root_.IsIntegral ↥(Algebra.adjoin R ({j} : Set F)) g) : g ∈ B := by
  apply hBn
  have hle : Algebra.adjoin R ({j} : Set F) ≤ B := Algebra.adjoin_le (Set.singleton_subset_iff.mpr hj)
  obtain ⟨p, hp, hp0⟩ := hg
  refine ⟨p.map (Subalgebra.inclusion hle).toRingHom, hp.map _, ?_⟩
  rw [Polynomial.eval₂_map]
  exact hp0

omit [IsIntegral X] in

theorem isUnit_of_isUnit_subring {K : Type} [Field K] (ψ : F →+* K) (S : Subring F) (O : ValuationSubring K)
    (hSO : ∀ f ∈ S, ψ f ∈ O) (g : F) (hg : g ∈ S) (hu : IsUnit (⟨g, hg⟩ : ↥S)) :
    IsUnit (⟨ψ g, hSO g hg⟩ : ↥O) := by
  obtain ⟨w, hw⟩ := hu.exists_right_inv
  have hw' : g * (w : F) = 1 := congrArg Subtype.val hw
  have h : ψ g * ψ w = 1 := by rw [← map_mul, hw', map_one]
  exact ⟨⟨⟨ψ g, hSO g hg⟩, ⟨ψ w, hSO _ w.2⟩, Subtype.ext h, Subtype.ext (by rw [mul_comm] at h; exact h)⟩, rfl⟩

