theorem nsmulPt_eq_nsmul' {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (n : ℕ) (P : SchemeHomOver t E'.f) :
    CerednikDrinfeld.QM.nsmulPt E'.L t n P = E'.L.nsmul t n P := by
