-- title:
--   Heights of roots bounded by height of coefficients
-- statement:
--   Let $\iota$ be any type, $t \subseteq \iota$ a finite subset, $\alpha \colon \iota \to \overline{\mathbb{Q}}$ a family of elements of an algebraic closure of $\mathbb{Q}$, and $m \colon \iota \to \mathbb{N}$ a family of multiplicities; let $n \in \mathbb{N}$ satisfy $\sum_{i \in t} m_i \le n$. Here `absLogHeight` assigns to a finite tuple $x$ of elements of $\overline{\mathbb{Q}}$ the quantity $[\,\mathbb{Q}(x) : \mathbb{Q}\,]^{-1} \cdot \mathrm{logHeight}(x)$, where $\mathbb{Q}(x)$ is the subfield of $\overline{\mathbb{Q}}$ generated by the entries of $x$ and $\mathrm{logHeight}$ is Mathlib's non-normalised logarithmic height of a tuple over that number field; thus it is the absolute logarithmic Weil height of the corresponding projective point, independent of the field of definition. The assertion is the inequality $$\sum_{i \in t} m_i \cdot h(\alpha_i : 1) \;\le\; h\big((c_0, c_1, \dots, c_n)\big) + \log \sqrt{n+1},$$ where $h$ denotes `absLogHeight`, the left-hand tuple is the two-element tuple $(\alpha_i, 1)$, and $c_k$ for $k \in \{0,\dots,n\}$ is the coefficient of $X^k$ in $\prod_{i \in t} (X - \alpha_i)^{m_i}$, the coefficients above the degree of this product being zero.
--
--   This is the standard comparison between the heights of the roots of a split polynomial and the height of its coefficient vector, with the archimedean loss $\log\sqrt{n+1}$ coming from the Mahler measure estimate. It is used for the one-root case [`AlgebraicCurve.absLogHeight_root_le_coeff`](thm.html#AlgebraicCurve.absLogHeight_root_le_coeff) and in the height comparison [`ModularCurve.JZero.ptsum_pointHt_le_divNaiveHeight`](thm.html#ModularCurve.JZero.ptsum_pointHt_le_divNaiveHeight) on the modular curve side.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_sum_absLogHeight_roots_le_coeff.lean

import Definitions.Def_ModularCurve_JZeroHeightForm

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem AlgebraicCurve.sum_absLogHeight_roots_le_coeff {ι : Type*} (t : Finset ι)
    (α : ι → AlgebraicClosure ℚ) (m : ι → ℕ) {n : ℕ} (hdeg : ∑ i ∈ t, m i ≤ n) :
    ∑ i ∈ t, (m i : ℝ) * absLogHeight ![α i, 1]
      ≤ absLogHeight (fun k : Fin (n + 1) =>
          (∏ i ∈ t, (Polynomial.X - Polynomial.C (α i)) ^ m i).coeff k)
        + Real.log (Real.sqrt (n + 1)) := by sorry
