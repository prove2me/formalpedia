variable {h : ℕ}

theorem IntMul.Kappa.R6.Bit.NB.side_edge_of (C : Matrix (Pr (h + 4)) (Fin (h + 4)) ℚ)
    (A : Matrix (Fin (h + 4)) (Fin (h + 4)) ℚ) (R : Matrix (Fin (h + 4)) (Pr (h + 4)) ℚ)
    (hB : ∀ i j : Fin (h + 4), i < j → (Te (h := h) * C) ⟨i.val, by have := two_k_le (h := h); omega⟩ j = 0)
    (hBd : ∀ i : Fin (h + 4), (Te (h := h) * C) ⟨i.val, by have := two_k_le (h := h); omega⟩ i ≠ 0)
    (hA : ∀ i j : Fin (h + 4), i < j → (R * Te' (h := h)) i
      ⟨(h + 4) * (h + 4) - (h + 4) + j.val, by have := two_k_le (h := h); omega⟩ = 0)
    (hAd : ∀ i : Fin (h + 4), (R * Te' (h := h)) i
      ⟨(h + 4) * (h + 4) - (h + 4) + i.val, by have := two_k_le (h := h); omega⟩ ≠ 0)
    (hM : C * A * R * (C * A * R) = C * A * R) (hAA : A * A = A) (r : ℕ) (hr : A.rank = r)
    (hrM : (qM (C * A * R)).rank = r)
    (hcor : h + 4 < 2 * r → (A.submatrix (fun l : Fin (h + 4 - r) => (⟨l.val, by omega⟩ : Fin (h + 4)))
        (fun c : Fin (h + 4 - r) => (⟨h + 4 - (h + 4 - r) + c.val, by omega⟩ : Fin (h + 4)))).det ≠ 0) :
    ∃ e : Edge ((h + 4) * (h + 4)), EdgeQ e (qM (C * A * R)) ∧ ∃ rs',
      e.runs = sideRuns (h + 4) ((h + 4) * (h + 4)) r ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
      (runPairs (sideRuns (h + 4) ((h + 4) * (h + 4)) r)).length + rs'.length = r := by sorry
