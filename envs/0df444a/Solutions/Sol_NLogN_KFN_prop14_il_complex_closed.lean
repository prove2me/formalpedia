    rw [← Real.rpow_natCast (m : ℝ) k, ← Real.rpow_mul (by positivity), mul_comm,
      Real.rpow_mul (by positivity), Real.rpow_natCast]
  have h2 : (2 * (m : ℝ) ^ k) ^ τ = (2 : ℝ) ^ τ * ((m : ℝ) ^ τ) ^ k := by
    rw [Real.mul_rpow (by norm_num) (by positivity), h2b]
