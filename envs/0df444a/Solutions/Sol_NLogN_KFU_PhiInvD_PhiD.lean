  have hk : m / 2 < IntMul.OpenAI.RCRT.Ppre sF d := by rw [NLogN.KFU.vol_SK] at h1; omega
  rw [NLogN.KFU.PhiD_at h d bL sF μ H.pos hst H.inv xs (m / 2) (m % 2) hk (Nat.mod_lt _ (by omega)),
    show 2 * (m / 2) + m % 2 = m by omega, List.getD_eq_getElem]
