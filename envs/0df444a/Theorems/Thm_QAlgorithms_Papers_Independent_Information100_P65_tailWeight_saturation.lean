-- title:
--   Lemma 3.2: Tail-weight saturation
-- statement:
--   Let $d\ge1$, let $\mu$ be a Young diagram of $N\ge0$ boxes and at most $d$ rows, and let $0\le n\le d$. Realize $V_\mu$ as the image of its Young symmetrizer in $(\mathbb C^d)^{\otimes N}$, and let $v_\mu$ be its unit highest-weight vector. Let $L_n(\mu)$ be the $\mathfrak{gl}_n$-submodule generated by $v_\mu$, where $\mathfrak{gl}_n$ acts on the first $n$ coordinates. If $v$ belongs to the integral weight space of weight $\theta$ and $\theta_a=\mu_a$ for $a>n$, then
--
--   $$v\in L_n(\mu).$$
--
--   Weight-space membership includes the zero vector. At $n=0$ the conclusion is membership in the highest-weight line; at $n=d$ it is membership in the whole module. This identifies the part of a representation detected by unchanged tail weights.
--
--   **Formalization Note** The Lie action is the sum of the matrix action over tensor sites, restricted to the Young image. Source coordinates $1,\ldots,d$ become Lean indices $0,\ldots,d-1$.
-- source:
--   Minimal output entropy for the channels that add or remove a box of a Young diagram, and a Pauli principle for every permutation symmetry, arXiv:2609.33498v1, PDF p. 14, Lemma 3.2: Tail-weight saturation

import Definitions.Def_QAlgorithms_Papers_Independent_Information100_P65

noncomputable section

namespace QAlgorithms.Papers.Independent.Information100.P65

attribute [local instance] Classical.propDecidable

/-- Lemma 3.2, tail-weight saturation (arxiv-2609.33498v1, PDF p.14).
The first n coordinates are zero-based indices less than n. No normalization
is imposed on a weight vector, and zero is included. -/
theorem tailWeight_saturation {d N : ℕ} (hd : 0 < d)
    (mu : QAlgorithms.Schur.Partition d N) (n : ℕ) (hn : n ≤ d)
    (theta : Fin d → ℤ) (v : QAlgorithms.Schur.schurModule mu)
    (hv : HasWeight mu theta v)
    (htail : ∀ a : Fin d, n ≤ a.val → theta a = (mu.val.rowLen a.val : ℤ)) :
    v ∈ cyclicModule mu n := by sorry

end QAlgorithms.Papers.Independent.Information100.P65

end
