def comapCover {X Y : Scheme.{u}} (i : Y ⟶ X) [IsAffineHom i] (𝒲 : X.TwoAffineOpenCover) :
    Y.TwoAffineOpenCover where
  U0 := i ⁻¹ᵁ 𝒲.U0
  U1 := i ⁻¹ᵁ 𝒲.U1
  isAffineOpen_U0 := 𝒲.isAffineOpen_U0.preimage _
  isAffineOpen_U1 := 𝒲.isAffineOpen_U1.preimage _
  sup_eq_top := by rw [← Scheme.Hom.preimage_sup, 𝒲.sup_eq_top]; rfl
  isAffineOpen_inf := by rw [← Scheme.Hom.preimage_inf]; exact 𝒲.isAffineOpen_inf.preimage _

theorem unitHomEquiv_top_ne_zero {Y : Scheme.{u}} (M : Y.Modules)
    (σ : (SheafOfModules.unit Y.ringCatSheaf : Y.Modules) ⟶ M) (hσ : σ ≠ 0) :
    (M.unitHomEquiv σ).1 (op ⊤) ≠ 0 := by
  intro h
  apply hσ
  apply M.unitHomEquiv.injective
  apply Subtype.ext
  funext U
  have hU : (M.unitHomEquiv σ).1 U =
      M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op ((M.unitHomEquiv σ).1 (op ⊤)) :=
    ((M.unitHomEquiv σ).2 (homOfLE (le_top : U.unop ≤ ⊤)).op).symm
  rw [hU, h]
  have h1 : (ConcreteCategory.hom (M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op)) 0 = 0 :=
    (ConcreteCategory.hom (M.presheaf.map (homOfLE (le_top : U.unop ≤ ⊤)).op)).map_zero
  have hv : SheafOfModules.Hom.val (0 : (SheafOfModules.unit Y.ringCatSheaf : Y.Modules) ⟶ M) = 0 :=
    (SheafOfModules.forget _).map_zero _ _
  have h2 : (M.unitHomEquiv 0).1 U = 0 := by
    simp only [SheafOfModules.unitHomEquiv_apply_coe, hv, PresheafOfModules.zero_app]
    rfl
  exact h1.trans h2.symm

