open scoped BigOperators ENNReal

theorem solution (O R : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R]
    (S : TypeDensity.SurfaceData O R) (hreg : TypeDensity.RegularParameterPair R S.t S.x) (J : Ideal R) (d : ℕ)
    (Dv : TypeDensity.ExceptionalDivisor (IsLocalRing.ResidueField R)) (hJ : TypeDensity.HasTangentDivisor O R S J d Dv) :
    TypeDensity.HasMultiplicity R J d := by
  obtain ⟨f, H, rfl, ⟨hH, hdeg, -, -⟩, hf⟩ := hJ
  obtain ⟨ht, hx⟩ := TypeDensity.surface_parameters_mem_maximal O R S
  set m := IsLocalRing.maximalIdeal R with hm
  have hspan : Ideal.span ({S.t, S.x} : Set R) = m := S.parameters
  have hlift : TypeDensity.tangentLift O R S d H ∈ m ^ d := by
    unfold TypeDensity.tangentLift
    refine Ideal.sum_mem _ fun i _ => ?_
    have h1 : S.t ^ (d - i.val) * S.x ^ i.val ∈ m ^ d := by
      have : m ^ (d - i.val) * m ^ i.val ≤ m ^ d := by
        rw [← pow_add]; apply Ideal.pow_le_pow_right; omega
      exact this (Ideal.mul_mem_mul (Ideal.pow_mem_pow ht _) (Ideal.pow_mem_pow hx _))
    rw [mul_assoc]
    exact Ideal.mul_mem_left _ _ h1
  have hpow : m ^ (d+1) ≤ m ^ d := Ideal.pow_le_pow_right (by omega)
  refine ⟨?_, ?_⟩
  · rw [Ideal.span_singleton_le_iff_mem]
    have h2 : f = (f - TypeDensity.tangentLift O R S d H) + TypeDensity.tangentLift O R S d H := by ring
    rw [h2]; exact Ideal.add_mem _ (hpow hf) hlift
  · intro hle
    have hfm : f ∈ m ^ (d+1) := hle (Ideal.mem_span_singleton_self f)
    have hlm : TypeDensity.tangentLift O R S d H ∈ m ^ (d+1) := by
      have h2 : TypeDensity.tangentLift O R S d H = f - (f - TypeDensity.tangentLift O R S d H) := by ring
      rw [h2]; exact Ideal.sub_mem _ hfm hf
    obtain ⟨i₀, hi₀⟩ : ∃ i : ℕ, H.coeff i ≠ 0 :=
      ⟨H.natDegree, Polynomial.leadingCoeff_ne_zero.mpr hH⟩
    have hi₀d : i₀ ≤ d := le_trans (Polynomial.le_natDegree_of_ne_zero hi₀) hdeg
    have : (Ideal.span ({S.t, S.x} : Set R)).IsMaximal := by rw [hspan]; infer_instance
    have key := TypeDensity.homogeneous_form_not_mem_pow_succ R S.t S.x hreg d
      (fun i => TypeDensity.residueRepresentative R (H.coeff i.val)) ⟨i₀, by omega⟩ (by
        rw [hspan, hm, ← IsLocalRing.residue_eq_zero_iff]
        have : IsLocalRing.residue R (TypeDensity.residueRepresentative R (H.coeff i₀)) = H.coeff i₀ :=
          Function.rightInverse_invFun (IsLocalRing.residue_surjective) _
        rw [this]; exact hi₀)
    apply key
    rw [hspan]
    exact hlm
