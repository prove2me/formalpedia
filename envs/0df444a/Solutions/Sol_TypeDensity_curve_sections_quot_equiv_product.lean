theorem solution (R : Type) [CommRing R] (t x : R)
    [(Ideal.span ({t,x} : Set R)).IsMaximal] [IsNoetherianRing (TypeDensity.BlowupChart R t x)]
    [IsNoetherianRing (TypeDensity.BlowupChart R x t)] (beta : TypeDensity.BlowupRestriction R t x) (D : TypeDensity.TwoChartCurveData R
    t x beta) (d : ℕ) (G : TypeDensity.GluedGenerators R t x beta d) (hG : ∀ j : ℕ,
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R t x)^j) (G.left j)} = TypeDensity.leftLevelKernel D j ∧
    Ideal.span {Ideal.Quotient.mk ((TypeDensity.chartExceptional R x t)^j) (G.right j)} = TypeDensity.rightLevelKernel D j)
    (j : ℕ) :
    ∃ E : TypeDensity.curveSectionsQuot R t x beta G j ≃+ TypeDensity.curveProduct D j, ∀ q : TypeDensity.curveSectionsQuot R t x beta G
      j, ∀ p : TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t,
      (q : (TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t) ⧸ TypeDensity.curveIdealLattice R t x beta G j) =
      (TypeDensity.curveIdealLattice R t x beta G j).mkQ p → E q = TypeDensity.sectionsToProduct D j p := by
  -- Strategy: identify the curve lattices with the local kernels, descend `sectionsToProduct` to
  -- the quotient, and check injectivity locally and surjectivity by chart-wise approximation.
  set α := algebraMap (TypeDensity.BlowupChart R t x) (TypeDensity.BlowupOverlap R t x) with hα
  have hmemL := TypeDensity.mem_commonLevelIdeal_iff_left D j
  have hmemR := TypeDensity.mem_commonLevelIdeal_iff_right D j
  -- the overlap curve ideal is the common kernel
  have hover : TypeDensity.overlapCurveIdeal R t x beta G j = TypeDensity.commonKernel D j := by
    rw [← (TypeDensity.two_chart_kernels_agree_on_overlap R t x beta D j).1,
      ← (TypeDensity.curve_ideal_lattice_eq_kernels R t x beta D d G hG j).1]
    rw [TypeDensity.leftCurveIdeal, Ideal.map_sup, Ideal.map_span, Set.image_singleton, TypeDensity.chartExceptional,
      Ideal.map_pow, Ideal.map_span, Set.image_singleton]
    rfl
  have hlat : ∀ p : TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t, p ∈ TypeDensity.curveIdealLattice R t x beta G j ↔
      p.1 ∈ TypeDensity.leftKernel D j ∧ p.2 ∈ TypeDensity.rightKernel D j := by
    intro p
    rw [← (TypeDensity.curve_ideal_lattice_eq_kernels R t x beta D d G hG j).1,
      ← (TypeDensity.curve_ideal_lattice_eq_kernels R t x beta D d G hG j).2]
    rfl
  have hsec : ∀ p : TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t, p ∈ TypeDensity.curveSections R t x beta G j ↔
      α p.1 - beta.right p.2 ∈ TypeDensity.commonKernel D j := by
    intro p
    rw [← hover]
    change α p.1 - (IsLocalization.Away.invSelf (TypeDensity.chartSlope R t x))^0 * beta.right p.2 ∈
      TypeDensity.overlapCurveIdeal R t x beta G j ↔ _
    rw [pow_zero, one_mul]
  have hkerL : ∀ a, a ∈ TypeDensity.leftKernel D j ↔
      ∀ s, TypeDensity.completedPointMap _ (TypeDensity.leftPoint D s) a ∈ TypeDensity.leftLevelIdeal D j s := fun a => by
    simp only [TypeDensity.leftKernel, TypeDensity.finiteSupportKernel, Ideal.mem_iInf, Ideal.mem_comap]
  have hkerR : ∀ b, b ∈ TypeDensity.rightKernel D j ↔
      ∀ s, TypeDensity.completedPointMap _ (TypeDensity.rightPoint D s) b ∈ TypeDensity.rightLevelIdeal D j s := fun b => by
    simp only [TypeDensity.rightKernel, TypeDensity.finiteSupportKernel, Ideal.mem_iInf, Ideal.mem_comap]
  have hkerC : ∀ c, c ∈ TypeDensity.commonKernel D j ↔
      ∀ i, TypeDensity.completedPointMap _ (D.Q i) c ∈ TypeDensity.commonLevelIdeal D j i := fun c => by
    simp only [TypeDensity.commonKernel, TypeDensity.finiteSupportKernel, Ideal.mem_iInf, Ideal.mem_comap]
  -- `sectionsToProduct` descends to the quotient by the curve ideal lattice
  let φ : (TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t) →+ TypeDensity.curveProduct D j :=
    (TypeDensity.sectionsToProduct D j).toAddMonoidHom
  have hN : (TypeDensity.curveIdealLattice R t x beta G j).toAddSubgroup ≤ φ.ker := by
    intro p hp
    rw [AddMonoidHom.mem_ker]
    obtain ⟨h1, h2⟩ := (hlat p).1 hp
    rw [hkerL] at h1
    rw [hkerR] at h2
    refine (TypeDensity.sectionsToProduct_eq_zero_iff D j p).2
      ⟨fun i => ?_, fun k => h1 (Sum.inr k), fun l => h2 (Sum.inr l)⟩
    rw [hmemL, D.leftIso_compat]
    exact h1 (Sum.inl i)
  let Ψ : ((TypeDensity.BlowupChart R t x × TypeDensity.BlowupChart R x t) ⧸ TypeDensity.curveIdealLattice R t x beta G j) →+
      TypeDensity.curveProduct D j := QuotientAddGroup.lift _ φ hN
  have hΨ : ∀ p, Ψ ((TypeDensity.curveIdealLattice R t x beta G j).mkQ p) = TypeDensity.sectionsToProduct D j p :=
    fun p => rfl
  let E₀ : TypeDensity.curveSectionsQuot R t x beta G j →+ TypeDensity.curveProduct D j :=
    Ψ.comp (TypeDensity.curveSectionsQuot R t x beta G j).subtype.toAddMonoidHom
  have hinj : Function.Injective E₀ := by
    rw [injective_iff_map_eq_zero]
    rintro ⟨q, hq⟩ h0
    obtain ⟨p, hp, rfl⟩ := Submodule.mem_map.1 hq
    obtain ⟨hc1, hc2, hc3⟩ := (TypeDensity.sectionsToProduct_eq_zero_iff D j p).1 h0
    apply Subtype.ext
    change (TypeDensity.curveIdealLattice R t x beta G j).mkQ p = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hlat]
    have hA : p.1 ∈ TypeDensity.leftKernel D j := by
      rw [hkerL]
      rintro (i | k)
      · have h := hc1 i
        rwa [hmemL, D.leftIso_compat] at h
      · exact hc2 k
    refine ⟨hA, ?_⟩
    rw [hkerR]
    rintro (i | l)
    · have hs := (hkerC _).1 ((hsec p).1 hp) i
      have hb : TypeDensity.completedPointMap _ (D.Q i) (beta.right p.2) ∈ TypeDensity.commonLevelIdeal D j i := by
        have := Ideal.sub_mem _ (hc1 i) hs
        rwa [map_sub, sub_sub_cancel] at this
      rw [hmemR, D.rightIso_compat] at hb
      exact hb
    · exact hc3 l
  have hsurj : Function.Surjective E₀ := by
    intro u
    obtain ⟨p, hp, rfl⟩ := TypeDensity.exists_sectionsToProduct_eq D j u
    have hs : p ∈ TypeDensity.curveSections R t x beta G j := by
      rw [hsec, hkerC]
      exact hp
    exact ⟨⟨(TypeDensity.curveIdealLattice R t x beta G j).mkQ p, Submodule.mem_map_of_mem hs⟩, rfl⟩
  refine ⟨AddEquiv.ofBijective E₀ ⟨hinj, hsurj⟩, ?_⟩
  intro q p hqp
  change Ψ q = _
  rw [hqp]
  exact hΨ p
