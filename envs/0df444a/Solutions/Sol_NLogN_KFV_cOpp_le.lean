section
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFV
open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError
variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)
theorem solution (hK : 0 < K) (hℓ : 1 ≤ ℓ) {W B cCh U : ℕ} (hDW : D ≤ W)
    (hS : 10 ^ 12 * (B + 2) ^ 3 ≤ 2 ^ ℓ) (hBW : B + 2 ≤ 6 * (W + 1)) (hDl : D * ℓ ≤ B)
    (hU : NLogN.zsz (U : ℤ) ≤ B) :
    NLogN.KFV.cOpp D ℓ K long W B cCh U ≤
      10 ^ 12 * (W + 1) * (2 ^ NLogN.KFV.nB D ℓ K long * 2 ^ ℓ) * (ℓ + (K + 2) * (D + 1)) + ℓ * cCh := by
  set X := 2 ^ NLogN.KFV.nB D ℓ K long * 2 ^ ℓ with hX
  have hX1 : 2 ^ ℓ ≤ X := Nat.le_mul_of_pos_left _ (Nat.two_pow_pos _)
  have hB2 : (B + 2) ^ 2 ≤ (B + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hD1 : 1 ≤ D := Nat.one_le_iff_ne_zero.2 (NeZero.ne D)
  have hlB : ℓ ≤ B := le_trans (Nat.le_mul_of_pos_left _ hD1) hDl
  have hs : ∀ k ∈ Finset.range ℓ, NLogN.KFV.cRndO D ℓ K long k W B cCh U + NLogN.KFV.cStepH 1 B + 64 ≤
      12 * 10 ^ 9 * (W + 1) * X + NLogN.KFV.brR18 D ℓ K long k cCh W := by
    intro k hk
    simp only [Finset.mem_range] at hk
    have := NLogN.KFV.rndO_le D ℓ K long hK hℓ (h := k) hk hDW hS hBW hDl hU (cCh := cCh)
    rw [← hX] at this
    have hc : NLogN.KFV.cStepH 1 B + 64 ≤ X := by unfold NLogN.KFV.cStepH; simp [NLogN.Ex.size]; nlinarith
    have hWX : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
    have e : 12 * 10 ^ 9 * (W + 1) * X = 12 * 10 ^ 9 * ((W + 1) * X) := by ring
    have e2 : 11 * 10 ^ 9 * (W + 1) * X = 11 * 10 ^ 9 * ((W + 1) * X) := by ring
    rw [e]; rw [e2] at this; omega
  have hsum := Finset.sum_le_sum hs
  have hR : ∑ i ∈ Finset.range ℓ, (12 * 10 ^ 9 * (W + 1) * X + NLogN.KFV.brR18 D ℓ K long i cCh W) =
      ℓ * (12 * 10 ^ 9 * (W + 1) * X) + ∑ h ∈ Finset.range ℓ, NLogN.KFV.brR18 D ℓ K long h cCh W := by
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, smul_eq_mul]
  rw [hR] at hsum
  have hb := NLogN.KFV.sum_brR18 D ℓ K long hK hℓ cCh W
  rw [← hX] at hb
  have hr := NLogN.KFT.cRpt_le ℓ
  have hd := NLogN.dupCost_le (NLogN.zsz (ℓ : ℤ))
  have hz : NLogN.zsz (ℓ : ℤ) ≤ ℓ := NLogN.zsz_natCast_le_self' ℓ
  have hsm : ((NLogN.Ex.lit 0 : NLogN.Ex NLogN.HS).size + 1) * 10 ^ 7 * (B + 2) ^ 2 + (60 + NLogN.KFT.cRpt ℓ +
      (NLogN.dupCost (NLogN.zsz (ℓ : ℤ)) + 17)) + (2 * B + 2) ≤ X := by
    simp only [NLogN.Ex.size]; nlinarith
  have hWX : X ≤ (W + 1) * X := Nat.le_mul_of_pos_left _ (by omega)
  unfold NLogN.KFV.cOpp
  have e1 : 10 ^ 12 * (W + 1) * X * (ℓ + (K + 2) * (D + 1)) =
      10 ^ 12 * ((W + 1) * X) * ℓ + 10 ^ 3 * ((K + 2) * (10 ^ 9 * (D + 1) * (W + 1) * X)) := by ring
  have e2 : ℓ * (12 * 10 ^ 9 * (W + 1) * X) = 12 * 10 ^ 9 * ((W + 1) * X) * ℓ := by ring
  have e3 : (K + 2) * (10 ^ 11 * (D + 1) * (W + 1) * X) =
      100 * ((K + 2) * (10 ^ 9 * (D + 1) * (W + 1) * X)) := by ring
  rw [e1]; rw [e2] at hsum; rw [e3] at hb
  have e4 : 10 ^ 12 * ((W + 1) * X) * ℓ = 10 ^ 12 * ((W + 1) * X * ℓ) := by ring
  have e5 : 12 * 10 ^ 9 * ((W + 1) * X) * ℓ = 12 * 10 ^ 9 * ((W + 1) * X * ℓ) := by ring
  have hl1 : (W + 1) * X ≤ (W + 1) * X * ℓ := Nat.le_mul_of_pos_right _ (by omega)
  rw [e4]; rw [e5] at hsum
  omega
end
