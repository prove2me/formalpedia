-- title:
--   Integral matrix model for Hecke operators on parabolic cohomology
-- statement:
--   Fix a positive integer $M$, a subgroup $H \le (\mathbb{Z}/M)^\times$ and a set $S$ of natural numbers; write $\Gamma =$ [`CohCarrier.GammaH M H`](def/CohCarrier_Level.html#L133) for the subgroup of $\mathrm{SL}_2(\mathbb{Z})$ obtained as the image of the preimage of $H$ under $\Gamma_0(M) \to (\mathbb{Z}/M)^\times$, $\gamma \mapsto d(\gamma) \bmod M$, and let [`CohCarrier.Gen M S`](def/CohCarrier_Inst.html#L13) be the index type whose elements are the symbols $T_\ell$ ($\ell$ prime, $\ell \notin S$, $\ell \nmid M$), $U_q$ ($q$ prime, $q \mid M$) and $\langle d \rangle$ ($d \in (\mathbb{Z}/M)^\times$), acting on $\mathrm{Hom}(\Gamma, A)$ through [`CohCarrier.opFamily`](def/CohCarrier_Inst.html#L91) (the transfer-type operator `heckeTL` for both $T_\ell$ and $U_q$, and `diamondL` for $\langle d \rangle$). The assertion is the existence of naturals $n, K$, matrices $T_g \in M_n(\mathbb{Z})$ for each generator $g$, matrices $u_1, \dots, u_K \in M_n(\mathbb{Z})$ and integers $c_{klm}$, $c^{(1)}_m$, $c^{(g)}_m$ such that $u_k u_l = \sum_m c_{klm} u_m$, $\sum_m c^{(1)}_m u_m = 1$, $\sum_m c^{(g)}_m u_m = T_g$ for every $g$, and each $u_k$ lies in the $\mathbb{Z}$-subalgebra of $M_n(\mathbb{Z})$ generated by the $T_g$; and such that for every commutative ring $R$ that is a domain of characteristic zero, the entrywise images of $u_1, \dots, u_K$ in $M_n(R)$ are $R$-linearly independent with $R$-span equal to the underlying submodule of the $R$-subalgebra generated by the images of the $T_g$, and there is an $R$-basis $(b_j)_{j \in \mathrm{Fin}\,n}$ of the submodule [`ModularCurve.Period.parabolicHoms R Γ R`](def/ModularCurve_PeriodMap.html#L62) of homomorphisms $\Gamma \to R$ vanishing on every $\gamma$ with $\mathrm{tr}(\gamma)^2 = 4$, satisfying $g \cdot b_j = \sum_i (T_g)_{ij}\, b_i$ for all generators $g$ and all $j$.
--
--   This provides an integral matrix model, uniform in characteristic-zero domain coefficients, of the Hecke and diamond operators on the parabolic cohomology $H^1_{\mathrm{par}}(\Gamma_H(M), R)$, together with a $\mathbb{Z}$-basis with integer structure constants of the ring they generate; in particular the listed operators preserve the parabolic submodule. It is used in the construction of the ordinary filtration and the associated Galois representation over $\mathbb{Z}_p$ attached to a non-Eisenstein ordinary maximal ideal of the Hecke algebra.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CohCarrier_exists_intMatrix_opFamily_basis_parabolicHoms.lean

import Mathlib
import Definitions.Def_CohCarrier_Inst
import Definitions.Def_ModularCurve_PeriodMap

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem CohCarrier.exists_intMatrix_opFamily_basis_parabolicHoms
    (M : ℕ) [NeZero M] (H : Subgroup (ZMod M)ˣ) (S : Set ℕ) :
    ∃ (n K : ℕ) (T : CohCarrier.Gen M S → Matrix (Fin n) (Fin n) ℤ) (u : Fin K → Matrix (Fin n) (Fin n) ℤ)
      (c : Fin K → Fin K → Fin K → ℤ) (c₁ : Fin K → ℤ) (cT : CohCarrier.Gen M S → Fin K → ℤ),
      (∀ k l : Fin K, u k * u l = ∑ m, c k l m • u m) ∧
      (∑ m, c₁ m • u m = 1) ∧
      (∀ g : CohCarrier.Gen M S, ∑ m, cT g m • u m = T g) ∧
      (∀ k : Fin K, u k ∈ Algebra.adjoin ℤ (Set.range T)) ∧
      ∀ (R : Type) [CommRing R] [IsDomain R] [CharZero R],
        LinearIndependent R (fun k : Fin K => (u k).map (Int.castRingHom R)) ∧
        Submodule.span R (Set.range fun k : Fin K => (u k).map (Int.castRingHom R)) =
          Subalgebra.toSubmodule
            (Algebra.adjoin R (Set.range fun g : CohCarrier.Gen M S => (T g).map (Int.castRingHom R))) ∧
        ∃ bR : Module.Basis (Fin n) R ↥(ModularCurve.Period.parabolicHoms R (CohCarrier.GammaH M H) R),
          ∀ (g : CohCarrier.Gen M S) (j : Fin n),
            CohCarrier.opFamily M H S R g
                ((bR j : ↥(ModularCurve.Period.parabolicHoms R (CohCarrier.GammaH M H) R)) :
                  CohCarrier.H1 M H R) =
              ∑ i, ((T g i j : ℤ) : R) •
                ((bR i : ↥(ModularCurve.Period.parabolicHoms R (CohCarrier.GammaH M H) R)) :
                  CohCarrier.H1 M H R) := by sorry
