theorem NLogN.KFN.p14WithI_iruns (hρ : ρ < K) (hD : 1 ≤ D) {r p w : ℕ} (hr : 1 ≤ r) (hS : 1 ≤ S)
    (hP : 1 ≤ P) {Cc : ℕ → IStmt HS Pp} {E dC : ℕ} {kC : ℕ → ℕ}
    (hCimpl : SImplI Isym iprog r (fun i : Fin D => KFH.stT K D S ρ i)
      (vol (Butterfly.layerShape P K D S)) (Butterfly.tens Cm : Butterfly.Op (Fin D)) Cc E dC kC)
    (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ) (xs : List (Fin r → ℂ))
    (hx : RecRep r p zs xs) (hl : xs.length = vol (Butterfly.layerShape P K D S))
    (h0 : f 0 = gflat zs ++ l) (hC : ClN f) (hb : NLogN.KFB.GB w zs)
    (hdisk : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    ∃ zs', RecRep r p zs' (Butterfly.prop14Proc (P := P) (S := S) hρ p
        (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs) ∧
      NLogN.KFB.GB (p + 1) zs' ∧
      (∀ j (h : j < (Butterfly.prop14Proc (P := P) (S := S) hρ p
          (Butterfly.tens Butterfly.Cm : Butterfly.Op (Fin D)) xs).length)
        (h' : j < (Butterfly.layerH P K D S ρ hρ xs).length), ∀ c,
        ‖(Butterfly.prop14Proc (P := P) (S := S) hρ p
