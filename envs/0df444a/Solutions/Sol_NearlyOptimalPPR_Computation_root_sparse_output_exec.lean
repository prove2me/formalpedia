-- Proof module: Solutions.RootSparseOutputExecution

set_option autoImplicit false
set_option maxRecDepth 10000
namespace NearlyOptimalPPR.Computation
noncomputable section

set_option maxHeartbeats 5000000 in
lemma root_sparse_output_exec (m : SolveModel) {n : ℕ} (g : InputGraph n) (ω : ℕ → Bool)
    (logical : RecursiveState n) (s : Fin n) (α ε : ℝ) (ell length : ℕ)
    (st : MachineState) (hh : st.scalar.halted=false)
    (pm : RecursiveMachineMemory g s α ε ell length logical st)
    (hStored : (logical.frames 0).active ⊆ logical.stored)
    (hOutside : ∀ v ∉ (logical.frames 0).active, prune (logical.frames 0).q logical.x v=0) :
    ∃ out, MachineEval m g ω rootSparseOutputCode st
      ((8*(16*(ell+3))+31)*(logical.frames 0).active.card+10) out ∧
      outputVector out.output=potentialOutput g.graph α (prune (logical.frames 0).q logical.x) ∧
      out.work=st.work+((8*(16*(ell+3))+31)*(logical.frames 0).active.card+10 : ℕ) ∧
      out.scalar.integerMemory=st.scalar.integerMemory ∧ out.scalar.core.mem=st.scalar.core.mem ∧
      out.scalar.queries=st.scalar.queries ∧ out.scalar.halted=false := by
  let f := pm.frames 0 (Nat.zero_le _)
  obtain ⟨pre,ep,h94,h41,h32,hI,hR,hW,hO,hH⟩ := root_sparse_output_prelude_exec m g ω
    (16*(ell+3)) (logical.frames 0).q (st.scalar.integerMemory (levelHeaderAddress 0 1)) st hh pm.width f.q rfl
  have h0 := (ep.pointer_frame 0 (by decide)).trans pm.zero
  have h30 := (ep.real_register_frame 30 (by decide)).trans pm.alphaRegister
  have hList : VertexListRep pre.scalar.integerMemory (st.scalar.integerMemory (levelHeaderAddress 0 1)) f.activeVertices f.activeFoot := by
    rw [hI]
    exact f.activeRep
  have hDegree : ∀ v ∈ f.activeVertices,
      pre.scalar.integerMemory (vertexRecordAddress (16*(ell+3)) v.val 0)=((g.neighbors v).length : ℤ) := by
    intro v hv
    rw [hI]
    apply pm.knownDegree v
    apply Finset.mem_insert_of_mem
    apply Finset.mem_union_left
    apply hStored
    rw [←f.activeSet]
    exact List.mem_toFinset.mpr hv
  have hPotential : ∀ v ∈ f.activeVertices,
      pre.scalar.core.mem (vertexRecordAddress (16*(ell+3)) v.val 0)=logical.x v := by
    intro v hv
    rw [hR]
    exact pm.potential v
  obtain ⟨out,el,hOutI,hOutR,hOutQ,hOutW,hOutO,hOutH⟩ :=
    pruned_output_loop_exec m g ω f.activeVertices (st.scalar.integerMemory (levelHeaderAddress 0 1)) f.activeFoot
      (16*(ell+3)) α (3*(logical.frames 0).q/8) logical.x pre hH h0 h41 h94 hList h30 h32 hPotential hDegree
  have hLength : f.activeVertices.length=(logical.frames 0).active.card := by
    rw [←f.activeSet,List.toFinset_card_of_nodup f.activeNodup]
  have ex : MachineEval m g ω rootSparseOutputCode st
      ((8*(16*(ell+3))+31)*(logical.frames 0).active.card+10) out := by
    have e := MachineEval.seq ep el
    rw [hLength] at e
    convert e using 1 <;> (first | rfl | omega)
  refine ⟨out,ex,?_,?_,hOutI.trans hI,hOutR.trans hR,hOutQ.trans (ep.query_frame (by decide)), hOutH⟩
  · rw [hOutO,hO,pm.output,List.nil_append]
    apply pruned_output_list_potential g α (logical.frames 0).q logical.x f.activeVertices f.activeNodup
    intro v hv
    apply hOutside
    rwa [←f.activeSet]
  · rw [hOutW,hW,hLength]
    push_cast
    ring

end
end NearlyOptimalPPR.Computation

set_option autoImplicit false
open Finset Matrix NearlyOptimalPPR.Computation
open NearlyOptimalPPR.Computation.SparseQueue
open scoped ENNReal
theorem solution : ∀ (m : SolveModel) {n : ℕ} (g : InputGraph n) (ω : ℕ → Bool)
    (logical : RecursiveState n) (s : Fin n) (α ε : ℝ) (ell length : ℕ)
    (st : MachineState) (hh : st.scalar.halted=false)
    (pm : RecursiveMachineMemory g s α ε ell length logical st)
    (hStored : (logical.frames 0).active ⊆ logical.stored)
    (hOutside : ∀ v ∉ (logical.frames 0).active, prune (logical.frames 0).q logical.x v=0),
∃ out, MachineEval m g ω rootSparseOutputCode st
      ((8*(16*(ell+3))+31)*(logical.frames 0).active.card+10) out ∧
      outputVector out.output=potentialOutput g.graph α (prune (logical.frames 0).q logical.x) ∧
      out.work=st.work+((8*(16*(ell+3))+31)*(logical.frames 0).active.card+10 : ℕ) ∧
      out.scalar.integerMemory=st.scalar.integerMemory ∧ out.scalar.core.mem=st.scalar.core.mem ∧
      out.scalar.queries=st.scalar.queries ∧ out.scalar.halted=false := by
  exact @NearlyOptimalPPR.Computation.root_sparse_output_exec
