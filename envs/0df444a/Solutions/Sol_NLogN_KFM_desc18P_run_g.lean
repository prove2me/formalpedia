-- Source module: Solutions.KFMSD
/-!
# KFM SD: the Prop 18 descriptor

`desc18 p ℓ K ts = [p, ℓ, K, D, t_0, …, t_{D−1}]` (KFMP18) with `D = d − 1`, `p = 6b` and
`t_j = r` exactly when `j ≥ d'` (else `r/2`). These are the first `d − 1` axes of the padded
shape `shR d (tP d (ℓ−1) bL)` of `Φ` (the last of the `d` axes is the record axis, `t_{d−1} = r`).

* `tsE`: `t_{j−1}` for `j = ix` (`sel`), so that the push loop over `j = 0..d−1` leaves a junk
  entry `t_{−1}` on top, which `pop` removes.
* **`desc18P dst`** (**`desc18P_run_n`**, **`desc18P_cost_n`** `≤ 10^12 (b+1)^3`). It reads
  `b` from `zB` and `d, K, ℓ, r, d'` from the setup registers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

theorem desc18_ints (p ℓ K : ℕ) (ts : List ℕ) :
    ints (desc18 p ℓ K ts) = .int (p : ℤ) :: .int (ℓ : ℤ) :: .int (K : ℤ) ::
      .int (ts.length : ℤ) :: ints (ts.map (fun a : ℕ => (a : ℤ))) := by
  simp [desc18, ints]
  induction ts <;> simp_all

theorem D18Regs.upd {t : IState HS} {n : ℕ} (h : D18Regs t n) (dst : Fin HS) (hd : D18Ok dst)
    (L : List Item) : D18Regs (t.upd dst L) n := by
  obtain ⟨-, h1, h2, h3, h4, h5, h6⟩ := hd.ne
  obtain ⟨⟨L1, e1⟩, ⟨L2, e2⟩, ⟨L3, e3⟩, ⟨L4, e4⟩, ⟨L5, e5⟩, ⟨L6, e6⟩⟩ := h
  exact ⟨⟨L1, by simp [Ne.symm h1, e1]⟩, ⟨L2, by simp [Ne.symm h2, e2]⟩,
    ⟨L3, by simp [Ne.symm h3, e3]⟩, ⟨L4, by simp [Ne.symm h4, e4]⟩,
    ⟨L5, by simp [Ne.symm h5, e5]⟩, ⟨L6, by simp [Ne.symm h6, e6]⟩⟩

theorem tsLoop_run (dst : Fin HS) (hd : D18Ok dst) (s : IState HS) (d d' r : ℕ)
    (LD LP LR : List Item) (hD : s.G zD = .int (d : ℤ) :: LD)
    (hDp : s.G zDp = .int (d' : ℤ) :: LP) (hR : s.G zR = .int (r : ℤ) :: LR) :
    (RS.rep mOc (.reg zD) (.push dst tsE)).ok s ∧ (RS.rep mOc (.reg zD) (.push dst tsE)).run s =
      s.upd dst (ints ((List.range d).map (tsV d' r)) ++ s.G dst) := by
  have hdO := hd.ne.1
  apply pushLoop_run _ dst hdO s d LD hD (by simp [RS.writes, Ne.symm hdO])
  intro L c hc1 hcd
  set u := (s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc) with hu
  have uO : u.G mOc = .int (c : ℤ) :: s.G mOc := by simp [hu]
  have uDp : u.G zDp = .int (d' : ℤ) :: LP := by
    simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.1, hDp]
  have uR : u.G zR = .int (r : ℤ) :: LR := by
    simp (config := {decide := true}) [hu, IState.upd_G, Ne.symm hd.ne.2.2.2.1, hR]
  refine ⟨⟨hd.lt, clean_of_regs _ (by decide), ?_⟩, ?_⟩
  · simp only [tsE, ixO, Ex.ok, Ex.eval, IState.top_eq uO, IState.top_eq uDp, IState.top_eq uR]
    refine ⟨⟨⟨⟨IState.isInt_of uO, trivial⟩, IState.isInt_of uDp⟩, trivial⟩, ?_⟩
    split_ifs
    · exact ⟨IState.isInt_of uR, trivial, by positivity, by norm_num⟩
    · exact IState.isInt_of uR
  · simp only [RS.run, tsE, ixO, Ex.eval, IState.top_eq uO, IState.top_eq uDp, IState.top_eq uR]
    rw [show u.G dst = L ++ s.G dst by simp [hu, IState.upd_G, hdO]]
    congr 3
    unfold tsV
    split_ifs <;> first | omega | (push_cast; omega)

theorem range_map_succ (d : ℕ) (hd : 1 ≤ d) (v : ℕ → ℤ) :
    (List.range d).map v = v 0 :: (List.range (d - 1)).map (fun j => v (j + 1)) := by
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  rw [List.range_succ_eq_map]; simp

theorem tsV_succ (d' r j : ℕ) : tsV d' r (j + 1) = ((if d' ≤ j then r else r / 2 : ℕ) : ℤ) := by
  unfold tsV; split_ifs <;> first | rfl | omega

end NLogN.KFM

end

section
-- Source module: Solutions.R6ZSD
/-!
# Round six, chirp: the Prop 18 descriptor for any parameters

The frozen `KFMSD.desc18P_run_n` / `desc18P_cost_n` with the values of `n` (`dP n, dpN n, rP n,
KP n, ℓP n, bP n`) replaced by free values `d₀ d₁ r₀ K₀ ℓ₀ b₀` on the registers.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS

theorem D18G.upd {t : IState HS} {d₀ d₁ r₀ K₀ ℓ₀ b₀ : ℕ} (h : D18G t d₀ d₁ r₀ K₀ ℓ₀ b₀)
    (dst : Fin HS) (hd : D18Ok dst) (L : List Item) : D18G (t.upd dst L) d₀ d₁ r₀ K₀ ℓ₀ b₀ := by
  obtain ⟨-, h1, h2, h3, h4, h5, h6⟩ := hd.ne
  obtain ⟨⟨L1, e1⟩, ⟨L2, e2⟩, ⟨L3, e3⟩, ⟨L4, e4⟩, ⟨L5, e5⟩, ⟨L6, e6⟩⟩ := h
  exact ⟨⟨L1, by simp [Ne.symm h1, e1]⟩, ⟨L2, by simp [Ne.symm h2, e2]⟩,
    ⟨L3, by simp [Ne.symm h3, e3]⟩, ⟨L4, by simp [Ne.symm h4, e4]⟩,
    ⟨L5, by simp [Ne.symm h5, e5]⟩, ⟨L6, by simp [Ne.symm h6, e6]⟩⟩

set_option maxHeartbeats 2000000 in
/-- **The Prop 18 descriptor for `n`.** -/
theorem desc18P_run_g_sol_aux (dst : Fin HS) (hd : D18Ok dst) {d₀ d₁ r₀ K₀ ℓ₀ b₀ : ℕ} (hd1 : 1 ≤ d₀)
    (t : IState HS)
    (h : D18G t d₀ d₁ r₀ K₀ ℓ₀ b₀) :
    (desc18P dst).ok t ∧ (desc18P dst).run t =
      t.upd dst (ints (desc18 ((6 * b₀)) (ℓ₀) (K₀) (tsG d₀ d₁ r₀)) ++ t.G dst) := by
  obtain ⟨LD, hD⟩ := h.hD
  obtain ⟨LP, hDp⟩ := h.hDp
  obtain ⟨LR, hR⟩ := h.hR
  obtain ⟨k1, r1⟩ := tsLoop_run dst hd t (d₀) (d₁) (r₀) LD LP LR hD hDp hR
  set vs := (List.range (d₀ - 1)).map (fun j => tsV (d₁) (r₀) (j + 1)) with hvs
  have hsplit := range_map_succ (d₀) hd1 (tsV (d₁) (r₀))
  set t1 := t.upd dst (ints ((List.range (d₀)).map (tsV (d₁) (r₀))) ++ t.G dst) with ht1
  have hX1 : t1.G dst = .int (tsV (d₁) (r₀) 0) :: (ints vs ++ t.G dst) := by
    rw [ht1, hvs]; simp [hsplit]
  set t2 := t.upd dst (ints vs ++ t.G dst) with ht2
  have r2 : (RS.pop dst).run t1 = t2 := by
    show t1.upd dst (t1.G dst).tail = t2
    rw [hX1, List.tail_cons, ht1, IState.upd_upd_same]
  have o2 : (RS.pop dst).ok t1 := ⟨hd.lt, IState.isInt_of hX1⟩
  have h2 : D18G t2 d₀ d₁ r₀ K₀ ℓ₀ b₀ := h.upd dst hd _
  obtain ⟨LD2, hD2⟩ := h2.hD
  set t3 := t2.upd dst (.int ((d₀ - 1 : ℕ) : ℤ) :: t2.G dst) with ht3
  have r3 : (RS.push dst dmE).run t2 = t3 := by
    simp only [RS.run, dmE, Ex.eval, IState.top_eq hD2, ht3]
    congr 3; omega
  have o3 : (RS.push dst dmE).ok t2 :=
    ⟨hd.lt, clean_of_regs _ (by decide), ⟨IState.isInt_of hD2, trivial⟩⟩
  have h3 : D18G t3 d₀ d₁ r₀ K₀ ℓ₀ b₀ := h2.upd dst hd _
  obtain ⟨LK3, hK3⟩ := h3.hK
  set t4 := t3.upd dst (.int (K₀ : ℤ) :: t3.G dst) with ht4
  have r4 : (RS.push dst (.reg zK)).run t3 = t4 := by
    simp only [RS.run, Ex.eval, IState.top_eq hK3, ht4]
  have o4 : (RS.push dst (.reg zK)).ok t3 :=
    ⟨hd.lt, clean_of_regs _ (by decide), IState.isInt_of hK3⟩
  have h4 : D18G t4 d₀ d₁ r₀ K₀ ℓ₀ b₀ := h3.upd dst hd _
  obtain ⟨LE4, hE4⟩ := h4.hEl
  set t5 := t4.upd dst (.int (ℓ₀ : ℤ) :: t4.G dst) with ht5
  have r5 : (RS.push dst (.reg zEl)).run t4 = t5 := by
    simp only [RS.run, Ex.eval, IState.top_eq hE4, ht5]
  have o5 : (RS.push dst (.reg zEl)).ok t4 :=
    ⟨hd.lt, clean_of_regs _ (by decide), IState.isInt_of hE4⟩
  have h5 : D18G t5 d₀ d₁ r₀ K₀ ℓ₀ b₀ := h4.upd dst hd _
  obtain ⟨LB5, hB5⟩ := h5.hB
  have r6 : (RS.push dst pE).run t5 = t5.upd dst (.int ((6 * b₀ : ℕ) : ℤ) :: t5.G dst) := by
    simp only [RS.run, pE, Ex.eval, IState.top_eq hB5]
    push_cast; rfl
  have o6 : (RS.push dst pE).ok t5 :=
    ⟨hd.lt, clean_of_regs _ (by decide), ⟨trivial, IState.isInt_of hB5⟩⟩
  have o5' : (RS.seq (.push dst (.reg zEl)) (.push dst pE)).ok t4 := ⟨o5, by rw [r5]; exact o6⟩
  have o4' : (RS.seq (.push dst (.reg zK)) (.seq (.push dst (.reg zEl)) (.push dst pE))).ok t3 :=
    ⟨o4, by rw [r4]; exact o5'⟩
  have o3' : (RS.seq (.push dst dmE) (.seq (.push dst (.reg zK)) (.seq (.push dst (.reg zEl))
      (.push dst pE)))).ok t2 := ⟨o3, by rw [r3]; exact o4'⟩
  have o1 : (tsP dst).ok t := ⟨k1, by rw [r1]; exact o2⟩
  have r1' : (tsP dst).run t = t2 := by simp only [tsP, RS.run_seq, r1]; exact r2
  refine ⟨⟨o1, by rw [r1']; exact o3'⟩, ?_⟩
  simp only [desc18P, RS.run_seq]
  rw [r1', r3, r4, r5, r6]
  simp only [ht5, ht4, ht3, ht2, IState.upd_upd_same, IState.upd_G, if_true, ite_true, ↓reduceIte]
  congr 1
  have hvsE : vs = (tsG d₀ d₁ r₀).map (fun a : ℕ => (a : ℤ)) := by
    rw [hvs, tsG, List.map_map]; congr 1; funext j; simp only [Function.comp, tsV_succ]
  rw [desc18_ints, ← hvsE, show (((tsG d₀ d₁ r₀).length : ℕ) : ℤ) = ((d₀ - 1 : ℕ) : ℤ) by simp [tsG]]
  simp only [List.cons_append]

end NLogN.KFM

end

theorem solution : type_of% @NLogN.KFM.desc18P_run_g_sol_aux := @NLogN.KFM.desc18P_run_g_sol_aux
