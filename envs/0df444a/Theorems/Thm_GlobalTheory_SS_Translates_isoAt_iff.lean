variable {R : Type} [CommRing R] {K : Type} [Field K] [Algebra R K] {A A' A'' : Over (Sp K)}

theorem GlobalTheory.SS.Translates.isoAt_iff {M : Model R A} {N : Model R A'} {f : A ⟶ A'} {y : M.Y.left} :
    IsoAt M N f y ↔ ∃ (X : Scheme.{0}) (i : X ⟶ M.Y.left) (g : X ⟶ N.Y.left) (o : X),
      IsOpenImmersion i ∧ IsOpenImmersion g ∧ Ext M N f i g ∧ i o = y := by sorry
