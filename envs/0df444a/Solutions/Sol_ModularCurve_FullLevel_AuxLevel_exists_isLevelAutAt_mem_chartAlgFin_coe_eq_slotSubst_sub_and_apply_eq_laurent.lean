namespace WRRead
open ModularCurve ModularCurve.LevelRelabelling

theorem read
    {A : Type} [CommRing A] (ℓ M' q : ℕ) [Fact q.Prime] [Fact ℓ.Prime]
    (hℓ : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsLevelPStructure W ℓ D → ModularCurve.IsLevelPStructure (C • W) ℓ (D.variableChange C))
    (hM : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (p k : ℕ) (h : Polynomial T), ModularCurve.IsGamma0PowAt W p k h →
        ModularCurve.IsGamma0PowAt (C • W) p k (ModularCurve.kernelVariableChangeDeg C (ModularCurve.gamma0PowDeg p k) h))
    (𝒢 : GroupLaws A) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity) (𝒯 : LevelTransport A 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    (hVC : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve.Projective T) (C : WeierstrassCurve.VariableChange T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (C • W))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (C • W)) ≤ (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsVariableChangeHom W C φ)
    (hCO : ∀ (T T' : Type) [CommRing T] [Algebra A T] [CommRing T'] [Algebra A T'] (f : T →ₐ[A] T')
      (W : WeierstrassCurve.Projective T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (W.map f.toRingHom))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (W.map f.toRingHom)) ≤
          (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsCoefficientHom W f.toRingHom φ)
    (L : Type) [Field L] [CharZero L] (ξ : L) (hξ : IsPrimitiveRoot ξ (q * ℓ))
    (K : IntermediateField L (LaurentSeries L)) [Algebra A ↥K]
    (P₀ : LevelModuliPackageAbs A (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum)
    (x_B : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Raw P₀.B₀) (hx_B : (Quot.mk _ x_B : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Pt P₀.B₀) = P₀.univ)
    (hΔB : IsUnit x_B.level.2.2.curve.Δ)
    (hone : ((𝒢 P₀.B₀ x_B.level.2.2.curve hΔB).one (𝟙 _)).1 = (kwZeroSect P₀.B₀ x_B.level.2.2.curve).1)
    (S_R : Section x_B.level.2.2.curve) (hS_R : IsSectionThrough S_R x_B.level.2.1.xQ x_B.level.2.1.yQ)
    (bx by_ : P₀.B₀) (hbxy : IsSectionThrough ((𝒢 P₀.B₀ x_B.level.2.2.curve hΔB).mul _ S_R x_B.level.2.2.P) bx by_)
    (f' : P₀.B₀ →ₐ[A] ↥K) (z : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Raw ↥K)
    (hz : (Quot.mk _ z : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Pt ↥K) = (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).toLevelModuliDatum.map f' P₀.univ)
    (Cz : WeierstrassCurve.VariableChange (LaurentSeries L))
    (hzc : haveI : NeZero (q * ℓ) := ⟨Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero⟩
      z.curve.map (algebraMap ↥K (LaurentSeries L)) = Cz • ModularCurve.tateBase L (q * ℓ))
    (hzK : z.level.2.1.map (algebraMap ↥K (LaurentSeries L)) =
      (ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit
        ![(q : ZMod (q * ℓ)), 0] ![0, -(q : ZMod (q * ℓ))]).variableChange Cz)
    (vP wP : Fin 2 → ZMod (q * ℓ)) (hvP : vP ≠ 0) (hsum : ![0, -(q : ZMod (q * ℓ))] + vP ≠ 0)
    (a b a' b' : ↥K) (hzP : IsSectionThrough z.level.2.2.P a b) (hzQ : IsSectionThrough z.level.2.2.Q a' b')
    (ha : (a : LaurentSeries L) = ((ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit vP wP).variableChange Cz).xP)
    (hb : (b : LaurentSeries L) = ((ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit vP wP).variableChange Cz).yP) :
    ∃ Cy : WeierstrassCurve.VariableChange (LaurentSeries L),
      ((f' bx : ↥K) : LaurentSeries L) = ((ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit
        (![0, -(q : ZMod (q * ℓ))] + vP) vP).variableChange Cy).xP ∧
      ((f' x_B.level.2.1.xQ : ↥K) : LaurentSeries L) = ((ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit
        ![(q : ZMod (q * ℓ)), 0] ![0, -(q : ZMod (q * ℓ))]).variableChange Cy).xQ ∧
      ((f' x_B.level.2.1.xP : ↥K) : LaurentSeries L) = ((ModularCurve.cuspData L (q * ℓ) (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit
        ![(q : ZMod (q * ℓ)), 0] ![0, -(q : ZMod (q * ℓ))]).variableChange Cy).xP := by
  letI hdecK : DecidableEq ↥K := fun a b => Classical.propDecidable (a = b)
  haveI hN : NeZero (q * ℓ) := ⟨Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero⟩
  set ξu : Lˣ := (hξ.isUnit (Nat.mul_ne_zero (Fact.out : q.Prime).ne_zero (Fact.out : ℓ.Prime).ne_zero)).unit with hξu

  have hmk : (Quot.mk _ ((rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).mapRing f' x_B) : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Pt ↥K) = Quot.mk _ z := by
    rw [hz, ← hx_B]; rfl
  obtain ⟨D₀, hD₀⟩ := ModularCurve.RigidWeierstrassData.exists_eq_act_of_mk_eq_mk (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯) _ _ hmk

  have hzcurve : z.curve = D₀ • x_B.curve.map f'.toRingHom := by rw [hD₀]; rfl
  have hzlev1 : z.level.2.1 = (x_B.level.2.1.map f'.toRingHom).variableChange D₀ := by
    have h := congrArg (fun w : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Raw ↥K => w.level.2.1) hD₀
    simpa only [WRLaws.level_snd_fst_act, WRLaws.level_snd_fst_mapRing] using h
  have hzlev2 : z.level.2.2 = 𝒯.act D₀ (𝒯.map f' x_B.level.2.2) := by
    have h := congrArg (fun w : (rigidDataPow A ℓ M' q hℓ hM 𝒢 𝒯).Raw ↥K => w.level.2.2) hD₀
    simpa only [WRLaws.level_snd_snd_act, WRLaws.level_snd_snd_mapRing] using h
  obtain ⟨hcB, -, -⟩ := x_B.isLevel.2.2

  have hKatz : (x_B.level.2.1.map f'.toRingHom).map (algebraMap ↥K (LaurentSeries L)) =
      (ModularCurve.cuspData L (q * ℓ) ξu ![(q : ZMod (q * ℓ)), 0] ![0, -(q : ZMod (q * ℓ))]).variableChange (D₀⁻¹.map (algebraMap ↥K (LaurentSeries L)) * Cz) := by
    rw [ModularCurve.LevelPData.variableChange_mul, ← hzK, ← ModularCurve.LevelPData.map_variableChange, hzlev1,
      WRTate.variableChange_variableChange_inv]
  have hKQx : (algebraMap ↥K (LaurentSeries L)) (f' x_B.level.2.1.xQ) = ((ModularCurve.cuspData L (q * ℓ) ξu ![(q : ZMod (q * ℓ)), 0] ![0, -(q : ZMod (q * ℓ))]).variableChange (D₀⁻¹.map (algebraMap ↥K (LaurentSeries L)) * Cz)).xQ := by
