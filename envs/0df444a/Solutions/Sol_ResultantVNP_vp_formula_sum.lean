-- From Solutions.CircuitDegreeTruncation

namespace CircuitDegreeTruncation

open MvPolynomial Finset

variable {σ : Type} [DecidableEq σ]

/-- Retain only the homogeneous components of total degree at most `d`. -/
noncomputable def truncate (d : ℕ) (p : MvPolynomial σ ℂ) : MvPolynomial σ ℂ :=
  ∑ k ∈ Finset.range (d + 1), homogeneousComponent k p

theorem homogeneousComponent_constant (k : ℕ) (a : ℂ) :
    homogeneousComponent k (C a : MvPolynomial σ ℂ) = if k = 0 then C a else 0 :=
  homogeneousComponent_of_mem (isHomogeneous_C σ a)

theorem homogeneousComponent_variable (k : ℕ) (x : σ) :
    homogeneousComponent k (X x : MvPolynomial σ ℂ) = if k = 1 then X x else 0 :=
  homogeneousComponent_of_mem (isHomogeneous_X ℂ x)

theorem homogeneousComponent_add (k : ℕ) (p q : MvPolynomial σ ℂ) :
    homogeneousComponent k (p + q) = homogeneousComponent k p + homogeneousComponent k q :=
  map_add (homogeneousComponent k) p q

theorem coeff_truncate (d : ℕ) (p : MvPolynomial σ ℂ) (s : σ →₀ ℕ) :
    coeff s (truncate d p) = if s.degree ≤ d then coeff s p else 0 := by
  classical
  simp only [truncate, coeff_sum, coeff_homogeneousComponent]
  by_cases h : s.degree ≤ d
  · have hs : s.degree ∈ Finset.range (d + 1) := Finset.mem_range.mpr (by omega)
    rw [Finset.sum_eq_single s.degree]
    · simp [h]
    · intro k _ hk
      simp [Ne.symm hk]
    · exact fun hn => (hn hs).elim
  · simp only [if_neg h]
    apply Finset.sum_eq_zero
    intro k hk
    have hne : s.degree ≠ k := by
      have hk' := Finset.mem_range.mp hk
      omega
    simp [hne]

/-- Truncation commutes with addition, even when high-degree terms cancel. -/
theorem truncate_add (d : ℕ) (p q : MvPolynomial σ ℂ) :
    truncate d (p + q) = truncate d p + truncate d q := by
  apply MvPolynomial.ext
  intro s
  simp only [coeff_truncate, coeff_add]
  split_ifs <;> simp

/-- Degrees above the cutoff in either factor cannot affect any coefficient
    at or below the cutoff in their product. -/
theorem truncate_mul (d : ℕ) (p q : MvPolynomial σ ℂ) :
    truncate d (p * q) = truncate d (truncate d p * truncate d q) := by
  classical
  apply MvPolynomial.ext
  intro s
  rw [coeff_truncate, coeff_truncate]
  by_cases hs : s.degree ≤ d
  · simp only [hs, if_true, coeff_mul]
    apply Finset.sum_congr rfl
    intro ab hab
    have hab' : ab.1 + ab.2 = s := HasAntidiagonal.mem_antidiagonal.mp hab
    have hdeg : ab.1.degree + ab.2.degree = s.degree := by
      simpa only [map_add] using congrArg Finsupp.degree hab'
    have ha : ab.1.degree ≤ d := by omega
    have hb : ab.2.degree ≤ d := by omega
    simp [coeff_truncate,ha,hb]
  · simp [hs]

/-- The degree-`k` part of a product is the convolution of the homogeneous
    parts of its factors. This remains valid when terms cancel. -/
theorem homogeneousComponent_mul (k : ℕ) (p q : MvPolynomial σ ℂ) :
    homogeneousComponent k (p * q) =
      ∑ i ∈ Finset.range (k + 1), homogeneousComponent i p * homogeneousComponent (k - i) q := by
  classical
  apply MvPolynomial.ext
  intro s
  simp only [coeff_homogeneousComponent, coeff_sum, coeff_mul]
  rw [Finset.sum_comm]
  by_cases hs : s.degree = k
  · simp only [hs, if_true]
    apply Finset.sum_congr rfl
    intro ab hab
    have hab' : ab.1 + ab.2 = s := HasAntidiagonal.mem_antidiagonal.mp hab
    have hdeg : ab.1.degree + ab.2.degree = k := by
      simpa only [map_add,hs] using congrArg Finsupp.degree hab'
    have ha : ab.1.degree ∈ Finset.range (k + 1) := Finset.mem_range.mpr (by omega)
    rw [Finset.sum_eq_single ab.1.degree]
    · have hb : ab.2.degree = k - ab.1.degree := by omega
      simp [hb]
    · intro i _ hi
      simp [Ne.symm hi]
    · exact fun hn => (hn ha).elim
  · simp only [hs, if_false]
    symm
    apply Finset.sum_eq_zero
    intro ab hab
    have hab' : ab.1 + ab.2 = s := HasAntidiagonal.mem_antidiagonal.mp hab
    have hdeg : ab.1.degree + ab.2.degree = s.degree := by
      simpa only [map_add] using congrArg Finsupp.degree hab'
    apply Finset.sum_eq_zero
    intro i hi
    have hi' := Finset.mem_range.mp hi
    by_cases ha : ab.1.degree = i
    · have hb : ab.2.degree ≠ k - i := by omega
      simp [hb]
    · simp [ha]

/-- Degree components produced by one circuit gate, using convolution for a
    multiplication gate and preserving the original gate's two input indices. -/
noncomputable def componentNode (vals : List (ℕ → MvPolynomial σ ℂ))
    (nd : ResultantVNP.Node σ) (k : ℕ) : MvPolynomial σ ℂ :=
  match nd with
  | .var x => if k = 1 then X x else 0
  | .const a => if k = 0 then C a else 0
  | .add i j => (vals.getD i (fun _ => 0)) k + (vals.getD j (fun _ => 0)) k
  | .mul i j => ∑ t ∈ Finset.range (k + 1),
      (vals.getD i (fun _ => 0)) t * (vals.getD j (fun _ => 0)) (k - t)

/-- The component-gate recurrence computes exactly the homogeneous component
    of the original gate, without assumptions on intermediate degree. -/
theorem componentNode_correct (vals : List (MvPolynomial σ ℂ))
    (nd : ResultantVNP.Node σ) (k : ℕ) :
    componentNode (vals.map (fun p t => homogeneousComponent t p)) nd k =
      homogeneousComponent k (nd.eval vals) := by
  have hg (i t : ℕ) :
      (vals.map (fun p t => homogeneousComponent t p)).getD i (fun _ => 0) t =
        homogeneousComponent t (vals.getD i 0) := by
    have hh := List.getD_map (l := vals) (d := (0 : MvPolynomial σ ℂ))
      (n := i) (fun p t => homogeneousComponent t p)
    simp only [map_zero] at hh
    exact congrFun hh t
  cases nd with
  | var x => exact (homogeneousComponent_variable k x).symm
  | const a => exact (homogeneousComponent_constant k a).symm
  | add i j => simp only [componentNode, ResultantVNP.Node.eval, hg, homogeneousComponent_add]
  | mul i j => simp only [componentNode, ResultantVNP.Node.eval, hg, homogeneousComponent_mul]

noncomputable def componentValues (C : ResultantVNP.Circuit σ) :
    List (ℕ → MvPolynomial σ ℂ) :=
  C.nodes.foldl (fun vals nd => vals ++ [componentNode vals nd]) []

private theorem component_fold (nodes : List (ResultantVNP.Node σ))
    (vals : List (MvPolynomial σ ℂ)) :
    nodes.foldl (fun cs nd => cs ++ [componentNode cs nd])
        (vals.map (fun p t => homogeneousComponent t p)) =
      (nodes.foldl (fun ps nd => ps ++ [nd.eval ps]) vals).map
        (fun p t => homogeneousComponent t p) := by
  induction nodes generalizing vals with
  | nil => rfl
  | cons nd rest ih =>
    simp only [List.foldl_cons]
    rw [← ih (vals ++ [nd.eval vals])]
    simp only [List.map_append, List.map_cons, List.map_nil]
    congr 2
    congr 1
    funext k
    exact componentNode_correct vals nd k

/-- The component recurrence tracks every node of the original circuit. -/
theorem componentValues_correct (C : ResultantVNP.Circuit σ) :
    componentValues C = C.values.map (fun p t => homogeneousComponent t p) := by
  simpa [componentValues, ResultantVNP.Circuit.values] using component_fold C.nodes []

/-- If the output polynomial has degree at most `d`, truncation recovers it
    exactly, regardless of the degrees of intermediate computations. -/
theorem truncate_eq_self (d : ℕ) (p : MvPolynomial σ ℂ) (hp : p.totalDegree ≤ d) :
    truncate d p = p := by
  apply MvPolynomial.ext
  intro s
  rw [coeff_truncate]
  by_cases hs : s.degree ≤ d
  · simp [hs]
  · have hz : coeff s p = 0 := by
      by_contra hc
      have hm : s ∈ p.support := mem_support_iff.mpr hc
      have hh := le_totalDegree hm
      change s.degree ≤ p.totalDegree at hh
      omega
    simp [hs,hz]

@[simp] theorem truncate_zero (d : ℕ) : truncate d (0 : MvPolynomial σ ℂ) = 0 := by
  simp [truncate]

@[simp] theorem truncate_idempotent (d : ℕ) (p : MvPolynomial σ ℂ) :
    truncate d (truncate d p) = truncate d p := by
  apply MvPolynomial.ext
  intro s
  simp only [coeff_truncate]
  split_ifs <;> rfl

theorem truncate_totalDegree_le (d : ℕ) (p : MvPolynomial σ ℂ) :
    (truncate d p).totalDegree ≤ d := by
  unfold MvPolynomial.totalDegree
  apply Finset.sup_le
  intro s hs
  change s.degree ≤ d
  by_contra hn
  have hc : coeff s (truncate d p) = 0 := by simp [coeff_truncate, hn]
  exact (mem_support_iff.mp hs) hc

/-- Truncated node evaluation agrees with truncating the original node,
    assuming its earlier inputs have already been truncated. -/
theorem node_eval_truncate (d : ℕ) (vals : List (MvPolynomial σ ℂ))
    (nd : ResultantVNP.Node σ) :
    truncate d (nd.eval (vals.map (truncate d))) = truncate d (nd.eval vals) := by
  have hg (i : ℕ) : (vals.map (truncate d)).getD i 0 = truncate d (vals.getD i 0) := by
    simpa only [truncate_zero] using
      List.getD_map (l := vals) (d := (0 : MvPolynomial σ ℂ)) (n := i) (truncate d)
  cases nd with
  | var x => rfl
  | const a => rfl
  | add i j =>
    simp only [ResultantVNP.Node.eval, hg, truncate_add, truncate_idempotent]
  | mul i j =>
    simp only [ResultantVNP.Node.eval, hg]
    exact (truncate_mul d _ _).symm

noncomputable def truncatedValues (d : ℕ) (C : ResultantVNP.Circuit σ) :
    List (MvPolynomial σ ℂ) :=
  C.nodes.foldl (fun vals nd => vals ++ [truncate d (nd.eval vals)]) []

private theorem truncated_fold (d : ℕ) (nodes : List (ResultantVNP.Node σ))
    (vals : List (MvPolynomial σ ℂ)) :
    nodes.foldl (fun ps nd => ps ++ [truncate d (nd.eval ps)]) (vals.map (truncate d)) =
      (nodes.foldl (fun ps nd => ps ++ [nd.eval ps]) vals).map (truncate d) := by
  induction nodes generalizing vals with
  | nil => rfl
  | cons nd rest ih =>
    simp only [List.foldl_cons]
    rw [← ih (vals ++ [nd.eval vals])]
    simp only [List.map_append, List.map_cons, List.map_nil, node_eval_truncate]

theorem truncatedValues_eq_map (d : ℕ) (C : ResultantVNP.Circuit σ) :
    truncatedValues d C = C.values.map (truncate d) := by
  simpa [truncatedValues, ResultantVNP.Circuit.values] using truncated_fold d C.nodes []

/-- Every intermediate polynomial in the truncated evaluation has bounded
    actual degree, including those that arose from cancellation. -/
theorem truncatedValues_degree_le (d : ℕ) (C : ResultantVNP.Circuit σ) :
    ∀ p ∈ truncatedValues d C, p.totalDegree ≤ d := by
  rw [truncatedValues_eq_map]
  intro p hp
  obtain ⟨q,_,rfl⟩ := List.mem_map.mp hp
  exact truncate_totalDegree_le d q

/-- Evaluating with truncation at every gate recovers the original output
    whenever the output's actual degree is at most the cutoff. -/
theorem circuit_output_truncation (d : ℕ) (C : ResultantVNP.Circuit σ)
    (hdegree : C.value.totalDegree ≤ d) :
    (truncatedValues d C).getLastD 0 = C.value := by
  rw [truncatedValues_eq_map]
  have hh := List.getLastD_map (f := truncate d) (l := C.values) (a := (0 : MvPolynomial σ ℂ))
  simp only [truncate_zero] at hh
  rw [hh, ← ResultantVNP.Circuit.value]
  exact truncate_eq_self d C.value hdegree


end CircuitDegreeTruncation

-- From Solutions.CircuitPositiveComponents

/-! The degree-zero component of a circuit gate can be replaced by a single
constant. For a positive-degree product, only the interior convolution terms
multiply two positive-degree components. This is the algebraic normalization
needed before bounding parse trees. -/

namespace CircuitPositiveComponents

open MvPolynomial Finset CircuitDegreeTruncation

variable {σ : Type}

theorem zero_component_is_constant (p : MvPolynomial σ ℂ) :
    homogeneousComponent 0 p = C (coeff 0 p) := by
  exact homogeneousComponent_zero p

/-- Split a positive-degree product into two scalar multiples and products of
    strictly positive-degree components. This identity allows degree-zero
    subcircuits to be collapsed, including in the presence of cancellation. -/
theorem positive_component_mul (k : ℕ) (p q : MvPolynomial σ ℂ) :
    homogeneousComponent (k + 1) (p * q) =
      C (coeff 0 p) * homogeneousComponent (k + 1) q +
      (∑ i ∈ Finset.range k,
        homogeneousComponent (i + 1) p * homogeneousComponent (k - i) q) +
      homogeneousComponent (k + 1) p * C (coeff 0 q) := by
  classical
  rw [homogeneousComponent_mul, Finset.sum_range_succ, Finset.sum_range_succ']
  simp only [Nat.add_sub_add_right, Nat.sub_self, Nat.sub_zero, zero_component_is_constant]
  ac_rfl

/-- Every interior multiplication strictly lowers the positive degree on
    both branches. This is the decreasing measure for a parse-tree bound. -/
theorem interior_degrees (k i : ℕ) (hi : i ∈ Finset.range k) :
    0 < i + 1 ∧ 0 < k - i ∧
      i + 1 < k + 1 ∧ k - i < k + 1 ∧
      (i + 1) + (k - i) = k + 1 := by
  have hi' := Finset.mem_range.mp hi
  omega

/-- Degree one has no interior products: only scalar multiplication remains. -/
theorem linear_component_mul (p q : MvPolynomial σ ℂ) :
    homogeneousComponent 1 (p * q) =
      C (coeff 0 p) * homogeneousComponent 1 q +
      homogeneousComponent 1 p * C (coeff 0 q) := by
  simpa using positive_component_mul 0 p q


end CircuitPositiveComponents

