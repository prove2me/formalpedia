-- Source module: Solutions.KFMSet18b
/-!
# KFM Set18b: the setup program of Proposition 18

The setup reads the descriptor `desc18 p ℓ K ts` on stack `dS18 = 33` and builds the register
frame `regs18 p ℓ K ts`:

* `prA`: move `p, ℓ, K, D` from the descriptor into `gPp, gLl, gKk, gD`;
* `prB`: move the axis lengths `t_0 … t_{D-1}` (reversed) onto the scratch stack `wS18 = 34`;
* `prC0`, `prC`: move them back one by one, pushing the flag `fv (t = 2^ℓ)` on `gLG` and updating
  the counter `nL` (`gNL`) and the mask (`gMk`);
* `prD`: push `D, K, ℓ, p` back onto the descriptor;
* `prE`: compute `b, q, Lst, n, 0, p+2, n+ℓ+8`.

Every state is an `encK s G` with `G` a chain of `Function.update`s; steps are
`spPush`/`spPush0`/`spAsg1`/`spPop`/`spMv` (each `≤ k · U B`, `U B = 10^7 (B+2)^2`), and
the states are compared pointwise with the tactic `ext18`.
Main result: **`spSetup`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2000000

namespace NLogN.KFV.S18M

open IntMul KIL RS Function Synth

/-- Scratch stack holding the reversed axis lengths. -/
abbrev wS18 : Fin HS := 34
/-- Loop counter stack. -/
abbrev cS18 : Fin HS := 35

/-- Move the top of `X` onto `Y`. -/
def mvE (X Y : Fin HS) : RS := .seq (.push Y (.reg X)) (.pop X)

/-- The cost unit. -/
def U (B : ℕ) : ℕ := 10 ^ 7 * (B + 2) ^ 2

/-! ## Single steps -/

section Steps

variable (s : IState HS) {A B : ℕ} (hA : 2 ≤ A) (hAB : A ^ 4 < 2 ^ B)
include hA hAB

end Steps

/-! ## The program -/

/-- Flag of the axis length on top of `wS18`: `-1` if `t ≥ 2^ℓ`, else `0`. -/
def fvE : Ex HS := .sel (.add (.reg wS18) (.neg (.pow2 (.reg gLl)))) (.lit 0) (.lit (-1))

def prA : RS := .seq (NLogN.KFV.S18M.mvE dS18 gPp) (.seq (NLogN.KFV.S18M.mvE dS18 gLl) (.seq (NLogN.KFV.S18M.mvE dS18 gKk) (NLogN.KFV.S18M.mvE dS18 NLogN.KFV.gD)))

def prB : RS := NLogN.mvK dS18 wS18 cS18 (.reg NLogN.KFV.gD)

def prC0 : RS := .seq (.push gNL (.lit 0)) (.push gMk (.lit 0))

def bodyC : RS :=
  .seq (.push gLG fvE)
    (.seq (.asg gNL (.add (.reg gNL) (.neg (.reg gLG))))
      (.seq (.asg gMk (.add (.add (.reg gMk) (.reg gMk)) (.neg (.reg gLG))))
        (NLogN.KFV.S18M.mvE wS18 dS18)))

def prC : RS := .rep cS18 (.reg NLogN.KFV.gD) NLogN.KFV.S18M.bodyC

def prD : RS :=
  .seq (.push dS18 (.reg NLogN.KFV.gD)) (.seq (.push dS18 (.reg gKk))
    (.seq (.push dS18 (.reg gLl)) (.push dS18 (.reg gPp))))

def prE : RS :=
  .seq (.push gBb (.nmod (.add (.reg gLl) (.lit (-1))) (.reg gKk)))
  (.seq (.push gQq (.ndiv (.add (.reg gLl) (.lit (-1))) (.reg gKk)))
  (.seq (.push gLst (.add (.reg gNL) (.mul (.reg gBb) (.reg NLogN.KFV.gD))))
  (.seq (.push gNn (.add (.reg gLst) (.mul (.mul (.reg NLogN.KFV.gD) (.reg gQq)) (.reg gKk))))
  (.seq (.push gH (.lit 0))
  (.seq (.push gWw (.add (.reg gPp) (.lit 2)))
    (.push gZz (.add (.add (.reg gNn) (.reg gLl)) (.lit 8))))))))

/-- **The setup program.** -/
def setupRS : RS := .seq prA (.seq prB (.seq prC0 (.seq prC (.seq prD prE))))

/-! ## States -/

/-- Natural numbers as integers. -/
def zs (l : List ℕ) : List ℤ := l.map fun t => (t : ℤ)

@[simp] theorem zs_nil : zs [] = [] := rfl
@[simp] theorem zs_cons (a : ℕ) (l : List ℕ) : zs (a :: l) = (a : ℤ) :: zs l := rfl

/-- `f` with the four scalar registers. -/
def G0 (p ℓ K D : ℕ) (f : Fin HS → List ℤ) : Fin HS → List ℤ :=
  update (update (update (update f gPp [(p : ℤ)]) gLl [(ℓ : ℤ)]) gKk [(K : ℤ)]) NLogN.KFV.gD [(D : ℤ)]

/-- During the flag loop: `a` still to do (reversed on `wS18`), `b` done (on `dS18`). -/
def GC (p ℓ K D : ℕ) (f : Fin HS → List ℤ) (a b : List ℕ) : Fin HS → List ℤ :=
  update (update (update (update (update (G0 p ℓ K D f) wS18 (zs a).reverse) dS18 (zs b))
    gLG ((fl18 ℓ b).map fv)) gNL [(nL18 ℓ b : ℤ)]) gMk [(mkOf (fl18 ℓ b) : ℤ)]

/-- After `prD`. -/
def SD (p ℓ K : ℕ) (ts : List ℕ) (f : Fin HS → List ℤ) : Fin HS → List ℤ :=
  update (GC p ℓ K ts.length f [] ts) dS18 (KFM.desc18 p ℓ K ts)

/-! ## The phases -/

section Phases

variable (s : IState HS) {A B : ℕ} (hA : 2 ≤ A) (hAB : A ^ 4 < 2 ^ B)
  (p ℓ K : ℕ) (ts : List ℕ) (f : Fin HS → List ℤ)
  (hf : ∀ j, j ≠ 0 → j ≠ dS18 → f j = [])
  (hℓ : 2 ≤ ℓ) (hK : 1 ≤ K)
  (hts : ∀ t ∈ ts, t = 2 ^ ℓ ∨ 2 * t = 2 ^ ℓ)
  (hpA : p + 2 ≤ A) (hℓA : 2 ^ ℓ ≤ A) (hKA : K ≤ A) (hDA : 2 ^ ts.length ≤ A)
  (hnA : n18 ℓ K ts + ℓ + 8 ≤ A)
include hA hAB hf hℓ hK hts hpA hℓA hKA hDA hnA

end Phases

end NLogN.KFV.S18M

end

