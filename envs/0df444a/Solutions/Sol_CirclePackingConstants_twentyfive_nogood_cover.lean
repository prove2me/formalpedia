/-!
# Cover lemma for the nogood library of 25 points

Every count vector on the 25 cells with entries at most 2, sum 25 and a zero entry contains a placed image of a
pattern of `Twentyfive.nogoods`. The proof is a kernel-checked certificate: a reflective checker (`runChunk`)
with a soundness proof.
-/

namespace Cover25

/-! ## Checker definitions

Patterns are pairs of 25-bit masks `(a, b)`; a pattern word is `a + 2^25 * b`. The checker enumerates the
double sets `B` by a depth-first search over the cells, pruned by placed nogoods made of doubles only, keeps
the sets of a fundamental domain of the symmetry group (three weight inequalities), and for each of them runs a
hitting-set search over the empty cells with a list of placed nogoods taken from the certificate.

The definitions use raw recursors and `Nat` primitives, which the kernel evaluates fast. -/

/-- `a` if `x = 0`, else `f x`. -/
def nz {α : Type} (x : Nat) (a : α) (f : Nat → α) : α := Nat.rec a (fun p _ => f (Nat.succ p)) x

/-- `k x`, with `x` evaluated first. -/
def force {α : Type} (x : Nat) (k : Nat → α) : α := Nat.rec (k 0) (fun p _ => k (Nat.succ p)) x

/-- Row reversal `i ↦ 4 - i` of a pattern word. -/
def flipI (u : Nat) : Nat := force u (fun u =>
  Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.shiftLeft (Nat.land u 0x3e00001f) 20)
    (Nat.shiftLeft (Nat.land u 0x7c00003e0) 10)) (Nat.land u 0xf800007c00))
    (Nat.shiftRight (Nat.land u 0x1f00000f8000) 10)) (Nat.shiftRight (Nat.land u 0x3e00001f00000) 20))

/-- Column reversal `j ↦ 4 - j` of a pattern word. -/
def flipJ (u : Nat) : Nat := force u (fun u =>
  Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.shiftLeft (Nat.land u 0x210842108421) 4)
    (Nat.shiftLeft (Nat.land u 0x421084210842) 2)) (Nat.land u 0x842108421084))
    (Nat.shiftRight (Nat.land u 0x1084210842108) 2)) (Nat.shiftRight (Nat.land u 0x2108421084210) 4))

/-- Transposition `(i, j) ↦ (j, i)` of a pattern word. -/
def swapIJ (u : Nat) : Nat := force u (fun u =>
  Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor (Nat.lor
    (Nat.shiftLeft (Nat.land u 0x20000010) 16) (Nat.shiftLeft (Nat.land u 0x410000208) 12))
    (Nat.shiftLeft (Nat.land u 0x8208004104) 8)) (Nat.shiftLeft (Nat.land u 0x104104082082) 4))
    (Nat.land u 0x2082083041041)) (Nat.shiftRight (Nat.land u 0x1041040820820) 4))
    (Nat.shiftRight (Nat.land u 0x820800410400) 8)) (Nat.shiftRight (Nat.land u 0x410000208000) 12))
    (Nat.shiftRight (Nat.land u 0x200000100000) 16))

/-- `f u` if `b ≠ 0`, else `u`. -/
def selF (b : Nat) (f : Nat → Nat) (u : Nat) : Nat := Nat.rec u (fun _ _ => f u) b

/-- Image of a pattern word under the symmetry `k` (bit 0: `flipI`, bit 1: `flipJ`, bit 2: `swapIJ`, in this
order). -/
def symU (k u : Nat) : Nat :=
  selF (Nat.land (Nat.shiftRight k 2) 1) swapIJ (selF (Nat.land (Nat.shiftRight k 1) 1) flipJ
    (selF (Nat.land k 1) flipI u))

/-- Field `t = 9 (di + 4) + (dj + 4)` (50 bits): the cells that leave the board under the translation
`(di, dj)`, in both halves of a pattern word. -/
