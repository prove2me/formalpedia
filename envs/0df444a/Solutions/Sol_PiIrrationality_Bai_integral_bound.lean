      + (96531589877154540182772467522174488579 / 163840000000000000000000000 : ℝ) * 20 * τ ^ 19 * (1 - τ)
      + (2338807416324233936159273801941 / 3906250000000000000 : ℝ) * τ ^ 20 := by
    simp only [certf, xx, NN, QQ, rho1, x0c, pr, pim]
    ring
  rw [e]
  exact key


/-- generic fundamental theorem of calculus along the segment `A + s D`, `c ≤ s ≤ d` -/
lemma seg_ftc (G f : ℂ → ℂ) (U : Set ℂ) (hG : ∀ z ∈ U, HasDerivAt G (f z) z)
    (hfc : ContinuousOn f U) (A D : ℂ) (c d : ℝ) (hcd : c ≤ d)
    (hU : ∀ s : ℝ, s ∈ Set.Icc c d → A + (s : ℂ) * D ∈ U) :
    G (A + (d : ℂ) * D) - G (A + (c : ℂ) * D) = ∫ s in c..d, f (A + (s : ℂ) * D) * D := by
  have hcont : ContinuousOn (fun s : ℝ => f (A + (s : ℂ) * D) * D) (Set.Icc c d) := by
    apply ContinuousOn.mul _ continuousOn_const
    apply hfc.comp (by fun_prop : Continuous (fun s : ℝ => A + (s : ℂ) * D)).continuousOn
    intro s hs; exact hU s hs
  have hint : IntervalIntegrable (fun s : ℝ => f (A + (s : ℂ) * D) * D) volume c d :=
    hcont.intervalIntegrable_of_Icc hcd
  rw [← intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun s : ℝ => G (A + (s : ℂ) * D))]
  · intro s hs
    have hs' : s ∈ Set.Icc c d := by rwa [Set.uIcc_of_le hcd] at hs
    have h1 : HasDerivAt (fun s : ℝ => A + (s : ℂ) * D) D s := by
      have := (((hasDerivAt_id s).ofReal_comp).mul_const D).const_add A
      simpa using this
    have h2 := (hG _ (hU s hs')).scomp s h1
    rw [smul_eq_mul, mul_comm] at h2
    exact h2
  · exact hint

lemma norm_le_two (w : ℂ) (h : w.re ^ 2 + w.im ^ 2 ≤ 4) : ‖w‖ ≤ 2 := by
  have : ‖w‖ ^ 2 ≤ 2 ^ 2 := by
    rw [Complex.sq_norm, Complex.normSq_apply]; nlinarith
  exact le_of_sq_le_sq (by simpa using this) (by norm_num)


lemma certf_neg (u v : ℝ) : certf u (-v) = certf u v := by
  unfold certf; rw [xx_neg, NN_neg]

lemma rho_bound : rho1 ^ 1857 * x0c ≤ Real.exp (-(2 * 6542.209753096835)) := by
  have h2 := log_two_bounds
  have h1 := log_q1_bounds
  have h3 := log_q2_bounds
  have hρpos : 0 < rho1 := by norm_num [rho1]
  have hx0pos : 0 < x0c := by norm_num [x0c]
  have e1 : rho1 * 1024 = 1735605965387748203 / 1953125000000000000 := by norm_num [rho1]
  have e2 : x0c / 512 = 1451394143 / 1024000000 := by norm_num [x0c]
  have l1 : Real.log (rho1 * 1024) = Real.log rho1 + 10 * Real.log 2 := by
    rw [Real.log_mul hρpos.ne' (by norm_num), show (1024 : ℝ) = 2 ^ 10 by norm_num, Real.log_pow]
    push_cast; ring
  have l2 : Real.log (x0c / 512) = Real.log x0c - 9 * Real.log 2 := by
    rw [Real.log_div hx0pos.ne' (by norm_num), show (512 : ℝ) = 2 ^ 9 by norm_num, Real.log_pow]
    push_cast; ring
  rw [e1] at l1
  rw [e2] at l2
  have hlog : 1857 * Real.log rho1 + Real.log x0c ≤ -(2 * 6542.209753096835) := by
    linarith [h1.2, h2.1, h2.2, h3.2]
  rw [← Real.exp_log (mul_pos (pow_pos hρpos 1857) hx0pos),
    Real.log_mul (pow_pos hρpos 1857).ne' hx0pos.ne', Real.log_pow]
  apply Real.exp_le_exp.2
  push_cast
  linarith

lemma F_le (t : ℂ) (hc : 0 ≤ certf t.re t.im) (hs : t.re ^ 2 + t.im ^ 2 ≤ 5) :
    ‖t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570‖ ≤
      Real.exp (-6542.209753096835) := by
  have hx : 0 < xx t.re t.im := by
    unfold xx
    nlinarith [sq_nonneg t.re, sq_nonneg t.im, sq_nonneg (25 - t.re ^ 2 + t.im ^ 2),
      mul_nonneg (sq_nonneg t.re) (sq_nonneg t.im)]
  have hcert : ((1857 : ℕ) : ℝ) * x0c * NN t.re t.im ≤
      rho1 * xx t.re t.im ^ 3 * ((((1857 : ℕ) : ℝ) + 1) * x0c - xx t.re t.im) := by
    have := hc
    unfold certf at this
    push_cast
    linarith
  have key := key_bound 1857 (by norm_num) rho1 x0c (by norm_num [rho1]) (by norm_num [x0c]) t hx
    hcert
  rw [show 2 * 1857 = 3714 from rfl, show 3 * 1857 - 1 = 5570 from rfl] at key
  have h2 : ‖t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570‖ ^ 2 ≤
      Real.exp (-6542.209753096835) ^ 2 := by
    refine key.trans (rho_bound.trans ?_)
    rw [← Real.exp_nat_mul]
    apply Real.exp_le_exp.2
    push_cast
    linarith
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (Real.exp_pos _).le (two_ne_zero)).1 h2

lemma R_eq (n : ℕ) (t : ℂ) : PiIrrationality.Bai.R n t =
    5 * (t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570) ^ n / (25 - t ^ 2) := by
  unfold PiIrrationality.Bai.R
  generalize (t ^ 4 + 6 * t ^ 2 + 25) = q
  generalize (25 - t ^ 2) = d
  rw [div_pow, mul_pow, ← pow_mul, ← pow_mul, ← pow_mul, pow_succ]
  ring

lemma R_bound (n : ℕ) (t : ℂ) (ρ : ℝ)
    (hF : ‖t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570‖ ≤ ρ)
    (hs : ‖t‖ ^ 2 ≤ 5) : ‖PiIrrationality.Bai.R n t‖ ≤ ρ ^ n / 4 := by
  rw [R_eq, norm_div, norm_mul, norm_pow]
  have hd : 20 ≤ ‖(25 : ℂ) - t ^ 2‖ := by
    have h := norm_sub_norm_le (25 : ℂ) (t ^ 2)
    rw [norm_pow] at h
    have h25 : ‖(25 : ℂ)‖ = 25 := by simp
    linarith
  have h5 : ‖(5 : ℂ)‖ = 5 := by simp
  have hρ : 0 ≤ ρ := (norm_nonneg _).trans hF
  have hFn : ‖t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570‖ ^ n ≤ ρ ^ n :=
    pow_le_pow_left₀ (norm_nonneg _) hF n
  rw [h5, div_le_iff₀ (by linarith)]
  have : 0 ≤ ρ ^ n := pow_nonneg hρ n
  nlinarith [norm_nonneg ((25 : ℂ) - t ^ 2), pow_nonneg (norm_nonneg
    (t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570)) n]

/-- pointwise data on an edge point with real coordinates `u, v` -/
lemma edge_pt (t : ℂ) (u v : ℝ) (hu : t.re = u) (hv : t.im = v) (hc : 0 ≤ certf u v)
    (hs : u ^ 2 + v ^ 2 ≤ 5) :
    ‖t‖ ^ 2 ≤ 5 ∧ ‖t ^ 3714 * (t ^ 4 + 6 * t ^ 2 + 25) ^ 3714 / (25 - t ^ 2) ^ 5570‖ ≤
      Real.exp (-6542.209753096835) := by
  subst hu hv
  refine ⟨?_, F_le t hc hs⟩
  rw [Complex.sq_norm, Complex.normSq_apply]; nlinarith


/-! ## The contour -/

noncomputable def ptP : ℂ := ⟨pr, pim⟩
noncomputable def ptPc : ℂ := ⟨pr, -pim⟩
def ptZ : ℂ := ⟨-1, 2⟩
def ptZc : ℂ := ⟨-1, -2⟩

/-- Every point of the segment `a → b` lies in `|t|² ≤ 5` and satisfies the `|f|` bound. -/
def EdgeOK (a b : ℂ) : Prop :=
  ∀ τ : ℝ, 0 ≤ τ → τ ≤ 1 →
    ‖a + (τ : ℂ) * (b - a)‖ ^ 2 ≤ 5 ∧
      ‖(a + (τ : ℂ) * (b - a)) ^ 3714 * ((a + (τ : ℂ) * (b - a)) ^ 4 + 6 * (a + (τ : ℂ) * (b - a)) ^ 2 + 25) ^ 3714 /
        (25 - (a + (τ : ℂ) * (b - a)) ^ 2) ^ 5570‖ ≤ Real.exp (-6542.209753096835)

lemma edgeOK_1 : EdgeOK 0 ptP := by
  intro τ h0 h1
  refine edge_pt _ (τ * pr) (τ * pim) (by simp [ptP]) (by simp [ptP]) (cert_edge1 τ h0 h1) ?_
  simp only [pr, pim]
  nlinarith [mul_nonneg h0 (sub_nonneg.2 h1)]

lemma edgeOK_2 : EdgeOK ptP ptZ := by
  intro τ h0 h1
  refine edge_pt _ (pr + τ * (-1 - pr)) (pim + τ * (2 - pim)) (by simp [ptP, ptZ])
    (by simp [ptP, ptZ]) (cert_edge2 τ h0 h1) ?_
  simp only [pr, pim]
  nlinarith [mul_nonneg h0 (sub_nonneg.2 h1)]

lemma edgeOK_3 : EdgeOK 0 ptPc := by
  intro τ h0 h1
  refine edge_pt _ (τ * pr) (-(τ * pim)) (by simp [ptPc]) (by simp [ptPc]) ?_ ?_
  · rw [certf_neg]; exact cert_edge1 τ h0 h1
  · simp only [pr, pim]
    nlinarith [mul_nonneg h0 (sub_nonneg.2 h1)]

lemma edgeOK_4 : EdgeOK ptPc ptZc := by
  intro τ h0 h1
  refine edge_pt _ (pr + τ * (-1 - pr)) (-(pim + τ * (2 - pim))) (by simp [ptPc, ptZc])
    (by simp [ptPc, ptZc]; ring) ?_ ?_
  · rw [certf_neg]; exact cert_edge2 τ h0 h1
  · simp only [pr, pim]
    nlinarith [mul_nonneg h0 (sub_nonneg.2 h1)]

lemma R_diff (n : ℕ) : DifferentiableOn ℂ (PiIrrationality.Bai.R n) (ball (0 : ℂ) 5) := by
  unfold PiIrrationality.Bai.R
  apply DifferentiableOn.div (by fun_prop) (by fun_prop)
  intro t ht
  rw [mem_ball_zero_iff] at ht
  apply pow_ne_zero
  intro h0
  have h1 : t ^ 2 = 25 := by linear_combination -h0
  have h2 : ‖t‖ ^ 2 = 25 := by rw [← norm_pow, h1]; simp
  nlinarith [norm_nonneg t]

lemma edge_G (n : ℕ) (G : ℂ → ℂ)
    (hG : ∀ z ∈ ball (0 : ℂ) 5, HasDerivAt G (PiIrrationality.Bai.R n z) z) (a b : ℂ)
    (hE : EdgeOK a b) :
    ‖G b - G a‖ ≤ ‖b - a‖ * (Real.exp (-6542.209753096835) ^ n / 4) := by
  have hmem : ∀ s : ℝ, s ∈ Set.Icc (0 : ℝ) 1 → a + (s : ℂ) * (b - a) ∈ ball (0 : ℂ) 5 := by
    intro s hs
    have h := (hE s hs.1 hs.2).1
    rw [mem_ball_zero_iff]
    nlinarith [norm_nonneg (a + (s : ℂ) * (b - a))]
  have h := seg_ftc G (PiIrrationality.Bai.R n) (ball (0 : ℂ) 5) hG (R_diff n).continuousOn a
    (b - a) 0 1 zero_le_one hmem
  have e1 : a + ((1 : ℝ) : ℂ) * (b - a) = b := by simp
  have e0 : a + ((0 : ℝ) : ℂ) * (b - a) = a := by simp
  rw [e1, e0] at h
  rw [h]
  have := intervalIntegral.norm_integral_le_of_norm_le_const
    (a := (0 : ℝ)) (b := 1) (C := (Real.exp (-6542.209753096835) ^ n / 4) * ‖b - a‖)
    (f := fun s : ℝ => PiIrrationality.Bai.R n (a + (s : ℂ) * (b - a)) * (b - a)) (by
      intro s hs
      rw [Set.uIoc_of_le zero_le_one] at hs
      rw [norm_mul]
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      exact R_bound n _ _ (hE s hs.1.le hs.2).2 (hE s hs.1.le hs.2).1)
  simpa [mul_comm] using this

lemma contour_bound (n : ℕ) :
    ‖PiIrrationality.Bai.J n‖ ≤ 2 * Real.exp (-6542.209753096835) ^ n := by
  obtain ⟨G, hG⟩ := (R_diff n).isExactOn_ball
  have hmem : ∀ s : ℝ, s ∈ Set.Icc (-2 : ℝ) 2 → (-1 : ℂ) + (s : ℂ) * Complex.I ∈ ball (0 : ℂ) 5 := by
    intro s hs
    rw [mem_ball_zero_iff]
    have h : ‖(-1 : ℂ) + (s : ℂ) * Complex.I‖ ^ 2 = 1 + s ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply]; simp; ring
    nlinarith [norm_nonneg ((-1 : ℂ) + (s : ℂ) * Complex.I), hs.1, hs.2]
  have hv := seg_ftc G (PiIrrationality.Bai.R n) (ball (0 : ℂ) 5) hG (R_diff n).continuousOn (-1)
    Complex.I (-2) 2 (by norm_num) hmem
  have hz2 : (-1 : ℂ) + ((2 : ℝ) : ℂ) * Complex.I = ptZ := by apply Complex.ext <;> simp [ptZ]
  have hz2c : (-1 : ℂ) + ((-2 : ℝ) : ℂ) * Complex.I = ptZc := by apply Complex.ext <;> simp [ptZc]
  rw [hz2, hz2c, intervalIntegral.integral_mul_const] at hv
  have hJ : ‖PiIrrationality.Bai.J n‖ = ‖G ptZ - G ptZc‖ := by
    rw [hv, norm_mul, Complex.norm_I, mul_one]
    unfold PiIrrationality.Bai.J
    rw [norm_neg]
  rw [hJ]
  have e : G ptZ - G ptZc = (G ptZ - G ptP) + (G ptP - G 0) - (G ptPc - G 0) - (G ptZc - G ptPc) := by
    ring
  rw [e]
  have b1 := edge_G n G hG ptP ptZ edgeOK_2
  have b2 := edge_G n G hG 0 ptP edgeOK_1
  have b3 := edge_G n G hG 0 ptPc edgeOK_3
  have b4 := edge_G n G hG ptPc ptZc edgeOK_4
  have l1 : ‖ptZ - ptP‖ ≤ 2 := norm_le_two _ (by simp [ptZ, ptP, pr, pim]; norm_num)
  have l2 : ‖ptP - 0‖ ≤ 2 := norm_le_two _ (by simp [ptP, pr, pim]; norm_num)
  have l3 : ‖ptPc - 0‖ ≤ 2 := norm_le_two _ (by simp [ptPc, pr, pim]; norm_num)
  have l4 : ‖ptZc - ptPc‖ ≤ 2 := norm_le_two _ (by simp [ptZc, ptPc, pr, pim]; norm_num)
  have hρ : 0 ≤ Real.exp (-6542.209753096835) ^ n / 4 := by positivity
  set ρ := Real.exp (-6542.209753096835) ^ n / 4 with hρdef
  have h1 := norm_sub_le ((G ptZ - G ptP) + (G ptP - G 0)) (G ptPc - G 0)
  have h2 := norm_sub_le ((G ptZ - G ptP) + (G ptP - G 0) - (G ptPc - G 0)) (G ptZc - G ptPc)
  have h3 := norm_add_le (G ptZ - G ptP) (G ptP - G 0)
  nlinarith [mul_le_mul_of_nonneg_right l1 hρ, mul_le_mul_of_nonneg_right l2 hρ,
    mul_le_mul_of_nonneg_right l3 hρ, mul_le_mul_of_nonneg_right l4 hρ]

end BaiDecay

theorem solution (n : ℕ) :
    ‖PiIrrationality.Bai.J n‖ ≤ 2 * Real.exp (-(6542.209753096835 * (n : ℝ))) := by
  have h := BaiDecay.contour_bound n
  rw [← Real.exp_nat_mul] at h
  convert h using 3
  ring
