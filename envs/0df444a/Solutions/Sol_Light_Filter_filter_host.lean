theorem Seg.keep (h : Seg μ a l) (hs : SameOn (Inside a l.length) μ μ' := by (( (try refine Light.SameOn.cell ?_)
                                                                                (intro x_m3 hx_m3)
                                                                                (first
                                                                                  | ((  (repeat
                                                                                            ((with_reducible rename Light.SameOn _ _ _ => h_m4);
                                                                                              (try have := h_m4 x_m3 (by omega)); (revert h_m4)))
                                                                                        (intros)
                                                                                        (try simp only [Function.update_apply, Light.wrote] at *)); (omega))
                                                                                  |
                                                                                    ((simp [] at hx_m3);
                                                                                      ( (repeat
                                                                                            ((with_reducible rename Light.SameOn _ _ _ => h_m5);
                                                                                              (try have := h_m5 x_m3 (by omega)); (revert h_m5)))
                                                                                        (intros)
                                                                                        (try simp only [Function.update_apply, Light.wrote] at *)); (omega))
                                                                                  | ( ( (repeat
                                                                                            ((with_reducible rename Light.SameOn _ _ _ => h_m6);
                                                                                              (try have := h_m6 x_m3 (by omega)); (revert h_m6)))
                                                                                        (intros)
                                                                                        (try simp only [Function.update_apply, Light.wrote] at *))
                                                                                      (fail "The cell x may have changed. Each equation ν' x = ν x above comes from a promise \
