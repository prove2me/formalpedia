theorem solution (O R : Type) [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] [CommRing R] [IsDomain R] [Algebra O R] [IsRegularLocalRing R]
    (S : TypeDensity.SurfaceData O R) (s : TypeDensity.State) (f h : R) (hf : Ideal.span {f} ∈ TypeDensity.surfaceStateSet O R S s) :
    Ideal.span {f + algebraMap O R S.pi * h} ∈ TypeDensity.surfaceStateSet O R S s := by
  have ht : S.t ∣ algebraMap O R S.pi := by
    rw [S.vertical]
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero S.a_pos.ne'
    rw [hk, pow_succ]
    exact ⟨S.unit * S.t ^ k * S.x ^ S.b, by ring⟩
  obtain ⟨-, hv, hm⟩ := hf
  refine ⟨⟨_, rfl⟩, hv, ?_⟩
  cases s with
  | single a c =>
    obtain ⟨h1, h2, h3⟩ := hm
    refine ⟨h1, h2, ?_⟩
    unfold TypeDensity.idealContact at *
    rw [TypeDensity.span_add_mul_sup_span_of_dvd _ _ _ _ ht]; exact h3
  | crossing a b c e =>
    obtain ⟨h1, h2, h3, h4⟩ := hm
    have hx : S.x ∣ algebraMap O R S.pi := by
      rw [S.vertical]
      have hb : 0 < S.b := h2 ▸ hv.2.1
      obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero hb.ne'
      rw [hk, pow_succ]
      exact ⟨S.unit * S.t ^ S.a * S.x ^ k, by ring⟩
    refine ⟨h1, h2, ?_, ?_⟩
    · unfold TypeDensity.idealContact at *
      rw [TypeDensity.span_add_mul_sup_span_of_dvd _ _ _ _ ht]; exact h3
    · unfold TypeDensity.idealContact at *
      rw [TypeDensity.span_add_mul_sup_span_of_dvd _ _ _ _ hx]; exact h4
