namespace PowerChunks

def powerSum (b : ℕ) (L : List ℕ) : ℕ :=(L.map fun e=>b^e).sum
def flattenAt (step offset : ℕ) : List (List ℕ)→List ℕ
  | [] => []
  | L::Ls => (L.map fun e=>offset+e)++flattenAt step (offset+step) Ls

theorem powerSum_shift (b offset : ℕ) (L : List ℕ) :
    powerSum b (L.map fun e=>offset+e)=b^offset*powerSum b L := by
  induction L with
  | nil => simp [powerSum]
  | cons e L ih => simp [powerSum,pow_add,mul_add] at ih ⊢;exact ih

theorem powerSum_append (b : ℕ) (I J : List ℕ) :
    powerSum b (I++J)=powerSum b I+powerSum b J := by
  simp [powerSum,List.map_append,List.sum_append]

theorem eval_flattenAt (b step offset : ℕ) (Ls : List (List ℕ)) :
    powerSum b (flattenAt step offset Ls)=
      b^offset*Nat.ofDigits (b^step) (Ls.map (powerSum b)) := by
  induction Ls generalizing offset with
  | nil => simp [flattenAt,powerSum,Nat.ofDigits]
  | cons L Ls ih =>
    rw [flattenAt,powerSum_append,powerSum_shift,ih]
    simp only [List.map_cons,Nat.ofDigits,pow_add,Nat.cast_id]
    ring
end PowerChunks
#print axioms PowerChunks.eval_flattenAt
