    have hwO : (sO ≫ ε₀.1) ≫ π₀ = 𝟙 _ ≫ sO := by rw [Category.assoc, ε₀.2, Category.comp_id, Category.id_comp]
    let Pt₀ : SchemeHomOver (𝟙 (Spec (CommRingCat.of ↥O))) π :=
      ⟨pullback.lift (sO ≫ ε₀.1) (𝟙 _) hwO ≫ inv e₀, by
        rw [Category.assoc, show inv e₀ ≫ π = pullback.snd π₀ (Spec.map (CommRingCat.ofHom j)) by rw [← he₀, IsIso.inv_hom_id_assoc],
          pullback.lift_snd]⟩
    have hPt₀ : Pt₀.1 ≫ e₀ ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom j)) = sO ≫ ε₀.1 := by
      show (pullback.lift (sO ≫ ε₀.1) (𝟙 _) hwO ≫ inv e₀) ≫ e₀ ≫ _ = _
      rw [Category.assoc, IsIso.inv_hom_id_assoc, pullback.lift_fst]
    have hwQ : (sQ ≫ ε₀.1) ≫ π₀ = 𝟙 _ ≫ sQ := by rw [Category.assoc, ε₀.2, Category.comp_id, Category.id_comp]
    let s₀ : {q : Spec (CommRingCat.of (AlgebraicClosure ℚ)) ⟶ 𝔐.C // q ≫ 𝔐.toBase = 𝟙 _} :=
      ⟨pullback.lift (sQ ≫ ε₀.1) (𝟙 _) hwQ ≫ inv e', by
        rw [Category.assoc, show inv e' ≫ 𝔐.toBase = pullback.snd π₀ sQ by rw [← he'snd, IsIso.inv_hom_id_assoc], pullback.lift_snd]⟩
    have hs₀ : s₀.1 ≫ e' ≫ pullback.fst π₀ (Spec.map (CommRingCat.ofHom iQ)) = Spec.map (CommRingCat.ofHom iQ) ≫ ε₀.1 := by
      show (pullback.lift (sQ ≫ ε₀.1) (𝟙 _) hwQ ≫ inv e') ≫ e' ≫ pullback.fst π₀ sQ = sQ ≫ ε₀.1
      rw [Category.assoc, IsIso.inv_hom_id_assoc, pullback.lift_fst]
    let P₀ : Place (AlgebraicClosure ℚ) F := 𝔐.pointEquivPlace s₀

    have hcondπ : pullback.fst π (Spec.map (CommRingCat.ofHom O.subtype)) ≫ π =
        pullback.snd π (Spec.map (CommRingCat.ofHom O.subtype)) ≫ Spec.map (CommRingCat.ofHom O.subtype) := pullback.condition
    have hcondk : pullback.fst π (Spec.map (CommRingCat.ofHom res)) ≫ π =
