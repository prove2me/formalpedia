  differentiableAt_of_contDiffOn hD.isOpen (hD.smooth i j) hx

theorem diff_k {x : Pt 5} (hx : x ∈ U) (i : Fin 5) : DifferentiableAt ℝ (fun y => k y i) x :=
  differentiableAt_of_contDiffOn hD.isOpen (hD.smooth_k i) hx

