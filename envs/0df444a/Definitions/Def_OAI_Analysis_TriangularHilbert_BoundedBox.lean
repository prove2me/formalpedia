section
namespace TriangularHilbert
open MeasureTheory Filter
open scoped Topology
noncomputable section

def closedBox (M : ℝ) : Set (ℝ×ℝ) := Set.Icc (-M) M ×ˢ Set.Icc (-M) M
def BoxSupport {E : Type uE} [Zero E] (f : ℝ×ℝ → E) (M : ℝ) : Prop :=
  ∀ z, f z ≠ 0 → |z.1| ≤ M ∧ |z.2| ≤ M

end
