-- Source module: Solutions.KFWC14
/-!
# KFW C-layer 14: the chain `LOGp → core → EACC → body`

`mainC jG` pushes the entry registers of the level loop (`logIn`) and calls it.  **`chainQ`**: from
the descriptor registers (`DescR`), `mainC jG` runs the whole uniform Proposition 14 core and leaves
`gflat zs* ++ l` on stack `0`, where `zs*` is the (unique) representation of `prop14Proc … xs`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

/-- The entry registers of the level loop. -/
def logIn : List (Fin HS × NE) :=
  [(11, .lit 0), (12, .lit 1), (13, .lit 1), (14, .lit 1), (15, .lit 1)]

/-- The core entry. -/
def mainC {Pp : ℕ} (jG : Fin Pp) : IStmt HS Pp := withPushI (fr logIn) (.call jG)

/-- The register bound used by the chain. -/
noncomputable def MbB (K P D w k q0 Bp : ℕ) : ℕ :=
  K * D + P + Bp + w + KFM.EwB NLogN.KFW.A0 D + Gc ^ (k + 1) + P8Lift.Wc ^ (k + 1) + mC ^ (k + 1) +
    ES (k + 1) + D + 72 * k + NLogN.KFW.cL + P8Lift.sc + mC + q0 + lowF ES k (D - q0) + 200

/-- The cost of the chain. -/
noncomputable def cChain (Kc : ℝ) (K S r H P D k q0 Bp Z Zr Bz w : ℕ) : ℕ :=
  cFrame 5 12 Bz + (cCore (NLogN.KFW.cBody Kc K S r H P D k q0 Bp Z Zr Bz w +
      (lowF (fun _ => 1) k (D - q0) + k + 1) * cEO Bz) Z Bz + (k + 1) * cEO Bz) +
    (5 * (2 * Bz + 2) + 1)

