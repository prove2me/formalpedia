  have hA : 0 ≤ A := mul_nonneg (TypeDensity.divisor_probability_pos _ hq _ _ 2 le_rfl).1.le
    (TypeDensity.density_value_arith _ hq (.const 1) (.const 1) (by simp [TypeDensity.Expr.eval])
