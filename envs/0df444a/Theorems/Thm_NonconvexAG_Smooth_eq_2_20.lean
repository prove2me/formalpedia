-- title:
--   (2.20) — Ψ(x^ag_k) ≤ Ψ(x^md_k) − β_k‖∇Ψ(x^md_k)‖² + (L_Ψβ_k²/2)‖∇Ψ(x^md_k)‖²
-- statement:
--   Let $\Psi:\mathbb R^n\to\mathbb R$ be differentiable with $L_\Psi$-Lipschitz gradient, $L_\Psi>0$, and let $x_k,x^{md}_k,x^{ag}_k$ be generated by Algorithm 1 from $x_0$ with step sizes $\alpha_1=1$, $\alpha_k\in(0,1)$ ($k\ge2$), $\beta_k>0$, $\lambda_k>0$. Then for every $k\ge1$,
--   $$\Psi(x^{ag}_k)\le\Psi(x^{md}_k)-\beta_k\|\nabla\Psi(x^{md}_k)\|^2+\frac{L_\Psi\beta_k^2}{2}\|\nabla\Psi(x^{md}_k)\|^2 .$$
--
--   It is the descent of the gradient step (2.4) and opens the proof of Theorem 1 b).
--
--   **Formalization Note** The statement is the outer ends of the chain (2.20).
-- source:
--   Ghadimi & Lan, Accelerated Gradient Methods for Nonconvex Nonlinear and Stochastic Programming, arXiv:1310.3787v1, p. 6, (2.20)

import Mathlib
import Definitions.Def_ConvexOptAlg_SmoothGD_Defs
import Definitions.Def_NonconvexAG_Smooth_AGRun

namespace NonconvexAG.Smooth

/-- (2.20), p. 6 (outer ends of the chain). -/
theorem eq_2_20 {n : ℕ} (Ψ : E n → ℝ) (g : E n → E n) (LΨ : ℝ)
    (hΨ : ConvexOptAlg.SmoothGD.IsBetaSmooth Ψ g LΨ) (hL : 0 < LΨ)
    (α β lam : ℕ → ℝ) (hstep : AGStepsizes α β lam) (x0 : E n) :
    ∀ k, 1 ≤ k →
      Ψ (xagSeq g α β lam x0 k) ≤ Ψ (xmdSeq g α β lam x0 k) - β k * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2
        + LΨ * β k ^ 2 / 2 * ‖g (xmdSeq g α β lam x0 k)‖ ^ 2 := by sorry

end NonconvexAG.Smooth
