          have hnle : ¬ (Ideal.map (algebraMap A₀ ↥B) (maximalIdeal A₀) ≤ P) := by
            intro hle'; apply hϖP; apply hle'
            show algebraMap A₀ ↥B ϖ₀ ∈ 𝔮₀
            rw [h𝔮₀span]; exact Ideal.mem_span_singleton_self _
