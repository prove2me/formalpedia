  have e2 : 2 ^ (P + 1) = 2 * 2 ^ P := by ring
  have hdig : decode (swSh W K P Q) (2 * k + c) =
      [k / 2 ^ (Q + 1), k / 2 ^ Q % 2, k / (2 * 2 ^ P) % 2 ^ (Q - P - 1), k / 2 ^ P % 2,
        2 * (k % 2 ^ P) + c] := by
    have hv : Valid (swSh W K P Q) [k / 2 ^ (Q + 1), k / 2 ^ Q % 2,
        k / (2 * 2 ^ P) % 2 ^ (Q - P - 1), k / 2 ^ P % 2, 2 * (k % 2 ^ P) + c] := by
      unfold swSh Valid
      refine List.Forall₂.cons ?_ (List.Forall₂.cons (Nat.mod_lt _ (by norm_num))
        (List.Forall₂.cons (Nat.mod_lt _ (by positivity)) (List.Forall₂.cons
          (Nat.mod_lt _ (by norm_num)) (List.Forall₂.cons ?_ List.Forall₂.nil))))
      · rw [Nat.div_lt_iff_lt_mul (by positivity), mul_assoc, ← eK]; exact hk
      · have := Nat.mod_lt k (show 2 ^ P > 0 by positivity)
