-- title:
--   Coleman–Mandula: relativistic kinematics
-- statement:
--   Relativistic kinematics used throughout the mission.
--
--   - **Four-vectors** $p=(p^0,p^1,p^2,p^3)\in\mathbb R^4$ and **three-momenta** $v\in\mathbb R^3$ (Euclidean space).
--   - The **Minkowski product** $p\cdot q = p^0q^0-p^1q^1-p^2q^2-p^3q^3$ (`mdot`) and the metric $\eta=\operatorname{diag}(1,-1,-1,-1)$ (`eta`).
--   - The forward **mass hyperboloid** $H_m=\{p : p\cdot p=m^2,\ p^0>0\}$ (`massShell m`); for $m=0$ this is the forward light cone without its apex.
--   - $\Lambda$ is a **proper orthochronous Lorentz transformation** (`IsLorentz`) iff $\Lambda^T\eta\Lambda=\eta$, $\det\Lambda=1$ and $\Lambda^0{}_0>0$; $X\in\mathfrak{so}(3,1)$ (`IsLorentzGen`) iff $X^T\eta+\eta X=0$; `lorentzExp X θ` is the matrix exponential $e^{\theta X}$.
--   - The **Mandelstam variable** $s(p,q)=(p+q)\cdot(p+q)$ (`mandelstamS`).
--   - The parametrisation of $H_m$ by spatial momentum: energy $E_m(v)=\sqrt{m^2+|v|^2}$ (`energy`), on-shell four-momentum $(E_m(v),v)$ (`onShell`), spatial part $(p^1,p^2,p^3)$ of a four-vector (`spatial`), and the parameter domain `shellDomain m`, equal to $\mathbb R^3$ if $m>0$ and to $\mathbb R^3\setminus\{0\}$ if $m=0$.
-- source:
--   S. Coleman and J. Mandula, All Possible Symmetries of the S Matrix, Phys. Rev. 159 (1967) 1251-1256, https://doi.org/10.1103/PhysRev.159.1251, Sec. I.A

import Mathlib

/-!
# Coleman–Mandula (1967): relativistic kinematics

Minkowski space with signature `(+,-,-,-)`, forward mass hyperboloids, proper orthochronous
Lorentz transformations and their Lie algebra `so(3,1)`, and the parametrisation of a mass
hyperboloid by the spatial momentum.

Source: S. Coleman and J. Mandula, *All Possible Symmetries of the S Matrix*,
Phys. Rev. 159 (1967) 1251–1256, Sec. I.A.
-/

namespace ColemanMandula

open Matrix

/-- Four-vectors `p = (p⁰, p¹, p², p³)` (contravariant components). -/
abbrev FourVec := Fin 4 → ℝ

/-- Spatial three-momenta. -/
abbrev ThreeVec := EuclideanSpace ℝ (Fin 3)

/-- The Minkowski product with signature `(+,-,-,-)`:
`p · q = p⁰q⁰ - p¹q¹ - p²q² - p³q³`. -/
def mdot (p q : FourVec) : ℝ :=
  p 0 * q 0 - p 1 * q 1 - p 2 * q 2 - p 3 * q 3

/-- The Minkowski metric `η = diag(1,-1,-1,-1)`. -/
def eta : Matrix (Fin 4) (Fin 4) ℝ :=
  Matrix.diagonal ![1, -1, -1, -1]

/-- The forward mass hyperboloid of mass `m`: `p · p = m²` and `p⁰ > 0`.
For `m = 0` this is the forward light cone with the origin removed. -/
def massShell (m : ℝ) : Set FourVec :=
  {p | mdot p p = m ^ 2 ∧ 0 < p 0}

/-- `Λ` is a proper orthochronous Lorentz transformation:
`Λᵀ η Λ = η`, `det Λ = 1` and `Λ⁰₀ > 0`. -/
def IsLorentz (Λ : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  Λᵀ * eta * Λ = eta ∧ Λ.det = 1 ∧ 0 < Λ 0 0

/-- `X` lies in the Lorentz Lie algebra `so(3,1)`: `Xᵀ η + η X = 0`. -/
def IsLorentzGen (X : Matrix (Fin 4) (Fin 4) ℝ) : Prop :=
  Xᵀ * eta + eta * X = 0

/-- The one-parameter group `θ ↦ exp(θ X)` of Lorentz transformations generated by `X`. -/
noncomputable def lorentzExp (X : Matrix (Fin 4) (Fin 4) ℝ) (θ : ℝ) :
    Matrix (Fin 4) (Fin 4) ℝ :=
  NormedSpace.exp (θ • X)

/-- The Mandelstam variable `s = (p + q)²` of a pair of four-momenta. -/
def mandelstamS (p q : FourVec) : ℝ :=
  mdot (p + q) (p + q)

/-- The energy `E_m(v) = √(m² + |v|²)` of a particle of mass `m` and spatial momentum `v`. -/
noncomputable def energy (m : ℝ) (v : ThreeVec) : ℝ :=
  Real.sqrt (m ^ 2 + ‖v‖ ^ 2)

/-- The on-shell four-momentum `(E_m(v), v)` with spatial momentum `v`. -/
noncomputable def onShell (m : ℝ) (v : ThreeVec) : FourVec :=
  ![energy m v, v 0, v 1, v 2]

/-- The spatial part `(p¹, p², p³)` of a four-vector. -/
noncomputable def spatial (p : FourVec) : ThreeVec :=
  WithLp.toLp 2 ![p 1, p 2, p 3]

/-- The set of spatial momenta that parametrise the mass hyperboloid of mass `m`:
all of `ℝ³` if `m > 0`, and `ℝ³ ∖ {0}` if `m = 0` (the apex of the cone is not a
momentum of a massless particle). -/
def shellDomain (m : ℝ) : Set ThreeVec :=
  {v | 0 < m ∨ v ≠ 0}

end ColemanMandula


