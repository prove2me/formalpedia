variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Theorem 4.17, PDF pp. 25–26. No assumed V-image condition; Euler derivations include zero. -/
theorem euler_affine_pairs_criterion (P : StructuralPresentation (G := G)) (ha : LieAdmissible (G := G))
    (hz : LieAlgebra.center ℝ G ≤ LieAlgebra.derivedSeries ℝ G 1)
    (x : G) (hn : AdNilpotent x) (hp : Pointed (orbitCone x)) :
    (∃ D : LieDerivation ℝ G G, EulerLinear D.toLinearMap ∧ D x = x ∧ ∀ l ∈ P.L, D l ∈ P.L) ↔
    ∃ h : P.L, EulerElement h ∧ ∃ A B : Submodule ℝ G, EulerModuleSplit P h A B ∧
      ⁅(h : G), lPart P x⁆ = lPart P x ∧ zPart P x ∈ bracketSpan A A ∧ vPart P x ∈ A ∧
      ThreeIndependent (bracketSpan A A) (bracketSpan B B)
        (bracketSpan A B ⊔ bracketSpan (fixedSpace P h) (fixedSpace P h)) := by sorry

end Derivations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
