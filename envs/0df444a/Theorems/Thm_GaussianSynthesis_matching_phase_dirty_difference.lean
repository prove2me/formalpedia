import Definitions.Def_DyadicCertificates
import Definitions.Def_GaussianLattice
import Definitions.Def_GaussianScalarCircuits
set_option autoImplicit true
open GaussianSynthesis
open GaussianParity

theorem GaussianSynthesis.matching_phase_dirty_difference (q : Nat) (old fresh : GInt) :
    gaussianDifference (repeatI q (add old fresh)) (repeatI q old) = repeatI q fresh := by sorry
