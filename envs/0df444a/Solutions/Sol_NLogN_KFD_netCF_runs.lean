    rw [eval_reg hG1X] at h2
    obtain ⟨G2, hG2⟩ : ∃ G2, G2 = Function.update G1 Z (L[k] :: G1 Z) := ⟨_, rfl⟩
    rw [← hG2] at h2
    have h3 := Sp.pop s G2 (i := X) (B := w) hX5 (by rw [hG2, Function.update_apply, if_neg hXZ, hG1X])
