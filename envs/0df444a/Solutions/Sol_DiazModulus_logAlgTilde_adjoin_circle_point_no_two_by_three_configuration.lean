import Mathlib
import Definitions.Def_DiazModulus
import Theorems.Thm_DiazModulus_rank_one_config_inverse_adjoin

open Complex ComplexConjugate

/-! # No `2 × 3` configuration in `ℒ̃ + Q̄u + Q̄ū` for a transcendental point of an algebraic circle

Take `K = Q̄`, `F` the subfield of `ℂ` generated by `ℒ̃`, and `V₀ = ℒ̃`. Every element of `ℒ̃` lies
in `F`, and `F` contains `Q̄`, because `ℒ̃` is a `Q̄`-subspace containing `1` (so `q = q • 1 ∈ ℒ̃`
for `q ∈ Q̄`). By hypothesis `u` is transcendental over `F`; in particular `u ≠ 0`. With
`ρ = u ū ∈ Q̄` one has `ū = ρ u⁻¹`, so `span_Q̄ {u, ū} ≤ span_Q̄ {u, u⁻¹}`. Given `Q̄`-independent
`x₀, x₁` and `y₀, y₁, y₂` with every `xᵢ yⱼ` in `ℒ̃ + Q̄u + Q̄ū`, all six products therefore lie in
`ℒ̃ + Q̄u + Q̄u⁻¹`, and the node `rank_one_config_inverse_adjoin` (adjoining `u` and `u⁻¹` to a
subspace of `F`) puts them in `ℒ̃`. The hypothesis `hSSE` says exactly that this cannot happen.
-/

open DiazModulus in
theorem solution
    (hSSE : ∀ (x : Fin 2 → ℂ) (y : Fin 3 → ℂ),
      LinearIndependent (↥Qbar) x → LinearIndependent (↥Qbar) y →
      ¬ (∀ i j, x i * y j ∈ LogAlgTilde))
    (u : ℂ) (hρ : IsAlgebraic ℚ (u * conj u))
    (hu : Transcendental (Subfield.closure (LogAlgTilde : Set ℂ)) u) :
    ¬ ∃ (x : Fin 2 → ℂ) (y : Fin 3 → ℂ), LinearIndependent (↥Qbar) x ∧
      LinearIndependent (↥Qbar) y ∧ ∀ i j, x i * y j ∈
        LogAlgTilde ⊔ Submodule.span Qbar ({u, conj u} : Set ℂ) := by
  rintro ⟨x, y, hx, hy, hxy⟩
  have hV : ∀ v ∈ LogAlgTilde, v ∈ Subfield.closure (LogAlgTilde : Set ℂ) :=
    fun v hv => Subfield.subset_closure hv
  have hKF : Qbar ≤ Subfield.closure (LogAlgTilde : Set ℂ) := fun q hq => hV q (by
    have := Submodule.smul_mem LogAlgTilde (⟨q, hq⟩ : Qbar)
      (Submodule.subset_span (Set.mem_insert 1 LogAlg))
    simpa [Subfield.smul_def] using this)
  have hu0 : u ≠ 0 := fun h => hu (h ▸ isAlgebraic_zero)
  have hle : Submodule.span Qbar ({u, conj u} : Set ℂ) ≤
      Submodule.span Qbar ({u, u⁻¹} : Set ℂ) := by
    rw [Submodule.span_le]
    rintro z (rfl | rfl)
    · exact Submodule.subset_span (Set.mem_insert _ _)
    · have := Submodule.smul_mem (Submodule.span Qbar ({u, u⁻¹} : Set ℂ))
        (⟨_, mem_Qbar_iff.mpr hρ⟩ : Qbar)
        (Submodule.subset_span (Set.mem_insert_of_mem u (Set.mem_singleton u⁻¹)))
      rwa [Subfield.smul_def, smul_eq_mul, show u * conj u * u⁻¹ = conj u by field_simp] at this
  exact hSSE x y hx hy (rank_one_config_inverse_adjoin Qbar _ hKF LogAlgTilde hV u hu x y hx hy
    fun i j => sup_le_sup_left hle _ (hxy i j))
