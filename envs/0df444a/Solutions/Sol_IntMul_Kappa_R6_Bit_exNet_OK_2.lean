-- Source module: Solutions.R6BitEx
/-!
# Round six, bit side: a sanity instance of `QHNet.OK`

`exNet`: `m = 2`, one role, no temporaries, a single edge with trivial Bruhat factors and the
two runs `H₀ ↔ D₀`, `H₁ ↔ D₁` (widths `1 < m`). It satisfies `QHNet.OK N` at every field size
(`exNet_OK`), via `idealOK_of_labels`. This checks that the hypotheses of `prop11H` are
consistent (non-vacuous); of course this network has no saving (`histMoment = 2 (1/2)^τ ≥ 1`).
-/

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R]

lemma redM_one (N : ℕ) : redM N (1 : QMat2 2) = 1 := by
  have h0 : redQ N 0 = 0 := redQ_zero N
  have h1 : redQ N 1 = 1 := by simpa using redQ_intCast N 1
  ext i j
  by_cases h : i = j
  · subst h; simp [redM, h1]
  · simp [redM, Matrix.one_apply_ne h, h0]

lemma exEdge_mat (N : ℕ) : edgeMat N exEdge = swapMat := by
  rw [edgeMat, exEdge]
  simp only [redM_one, one_mul, mul_one]
  have e0 : (finSumFinEquiv.symm (0 : Fin (2 + 2)) : Fin 2 ⊕ Fin 2) = Sum.inl 0 := by decide
  have e1 : (finSumFinEquiv.symm (1 : Fin (2 + 2)) : Fin 2 ⊕ Fin 2) = Sum.inl 1 := by decide
  have e2 : (finSumFinEquiv.symm (2 : Fin (2 + 2)) : Fin 2 ⊕ Fin 2) = Sum.inr 0 := by decide
  have e3 : (finSumFinEquiv.symm (3 : Fin (2 + 2)) : Fin 2 ⊕ Fin 2) = Sum.inr 1 := by decide
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [runPiv, swapMat, blk, Equiv.Perm.permMatrix, PEquiv.toMatrix, Equiv.toPEquiv,
      Equiv.swap_apply_def, e0, e1, e2, e3]

theorem exNet_OK_sol_aux (N : ℕ) [NeZero N] : (exNet (R := R)).OK N := by
  refine ⟨?_, idealOK_of_labels _ ?_ ⟨⟨trivial, trivial⟩, ?_⟩ ?_⟩
  · intro e he ρ hρ
    simp [exNet, QHNet.edges, progEdges, Instr.edgeOf] at he
    subst he
    simp [exEdge] at hρ
    rcases hρ with rfl | rfl <;> (unfold RunOK; decide)
  · intro e he
    simp [exNet, QHNet.edges, progEdges, Instr.edgeOf] at he
    subst he
    refine ⟨fun i j h => ?_, fun i j h => ?_, fun i => ?_, fun i => ?_⟩
    · simp [exEdge, Matrix.one_apply_ne (ne_of_lt h)]
    · simp [exEdge, Matrix.one_apply_ne (ne_of_lt h)]
    · have : redQ N 1 = 1 := by simpa using redQ_intCast N 1
      simp [exEdge, this]
    · have : redQ N 1 = 1 := by simpa using redQ_intCast N 1
      simp [exEdge, this]
  · intro w
    fin_cases w
    simp [exNet, labStepH, exEdge_mat]
  · intro v w
    fin_cases w
    simp [exNet, scalarStepH]

end IntMul.Kappa.R6.Bit

end

