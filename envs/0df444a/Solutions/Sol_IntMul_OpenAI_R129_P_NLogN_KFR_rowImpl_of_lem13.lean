theorem setBit_sub (ρ v : ℕ) (b : Fin 2) :
    (Butterfly.setBit ρ v b : ℤ) - v = ((b : ℤ) - (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ := by
