theorem claim_thinProductP : ∀ c : ℝ, ∃ (C : ℝ) (T : ℕ → ℕ → ℕ → ℝ → ℝ),
    lightModel.thinProduct T ∧ ∀ (N D w : ℕ) (u : ℝ), 1 ≤ D → D ^ 91 ≤ N ^ 5 →
