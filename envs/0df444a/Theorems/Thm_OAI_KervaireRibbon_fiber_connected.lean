-- title:
--   Each component fibre is connected
-- statement:
--   For permutations $\sigma,\theta$ of a finite set $D$, $k(\sigma,\theta)$ is the equivalence relation generated by their cycles (the components), $c(\cdot)$ counts cycles, and $(\sigma,\theta)$ is planar if $c(\sigma)+c(\theta)+c(\sigma\theta)=|D|+2\,\#k(\sigma,\theta)$. For a component $C$ of $(\sigma,\theta)$, let $\sigma_C,\theta_C$ be the restrictions of $\sigma$ and $\theta$ to $C$. Then the restricted pair is connected:
--   $$
--   k(\sigma_C,\theta_C)=C\times C .
--   $$
--
--   So each component of a ribbon diagram can be treated as a connected diagram of its own.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/ComponentFibers.lean#L52-L90

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression
import Definitions.Def_OAI_GroupTheory_Kervaire_ComponentFibers

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

theorem OAI.KervaireRibbon.fiber_connected (σ θ : Equiv.Perm D) (c : Quotient (components σ θ)) :
    components (fiberPerm σ (components σ θ) le_sup_left c)
      (fiberPerm θ (components σ θ) le_sup_right c) = ⊤ := by sorry
