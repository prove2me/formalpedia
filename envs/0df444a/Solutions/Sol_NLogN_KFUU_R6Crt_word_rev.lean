theorem getD_shr (Q i k μ : ℕ) (b : List ℕ) (p : ℕ) :
    (shr Q i k μ b).getD p 0 =
      if p = i ∧ i < b.length then (b.getD i 0 + Q - μ * b.getD k 0 % Q) % Q else b.getD p 0 := by
  by_cases hp : p = i ∧ i < b.length
  · obtain ⟨rfl, hi⟩ := hp
    rw [if_pos ⟨rfl, hi⟩]
    simp [shr, List.getD_eq_getElem?_getD, List.getElem?_set, hi]
  · rw [if_neg hp]
    simp only [shr, List.getD_eq_getElem?_getD, List.getElem?_set]
    by_cases h : i = p
    · subst h
      rw [if_pos rfl, if_neg (fun h' => hp ⟨rfl, h'⟩), List.getElem?_eq_none (by omega)]
    · rw [if_neg h]

theorem length_shr (Q i k μ : ℕ) (b : List ℕ) : (shr Q i k μ b).length = b.length := by
  simp [shr]

theorem cast_shr_digit {Q : ℕ} (hQ : 1 ≤ Q) (a c : ℕ) :
    (((a + Q - c % Q) % Q : ℕ) : ZMod Q) = (a : ZMod Q) - (c : ZMod Q) := by
  have h : c % Q ≤ a + Q := le_trans (Nat.mod_lt _ (by omega)).le (by omega)
  rw [ZMod.natCast_mod, Nat.cast_sub h, Nat.cast_add, ZMod.natCast_self, ZMod.natCast_mod]
  ring

theorem dg_shr {Q : ℕ} (hQ : 1 ≤ Q) (i k μ : ℕ) (b : List ℕ) (hi : i < b.length) (p : ℕ) :
    dg Q (shr Q i k μ b) p = if p = i then dg Q b i - (μ : ZMod Q) * dg Q b k else dg Q b p := by
  unfold dg
  rw [getD_shr]
  by_cases hp : p = i
  · subst hp; rw [if_pos ⟨rfl, hi⟩, if_pos rfl, cast_shr_digit hQ, Nat.cast_mul]
  · rw [if_neg (fun h => hp h.1), if_neg hp]

theorem getD_shr_ne (Q i k μ : ℕ) (b : List ℕ) {p : ℕ} (hp : p ≠ i) :
    (shr Q i k μ b).getD p 0 = b.getD p 0 := by
  rw [getD_shr, if_neg (fun h => hp h.1)]

theorem valid_shr {n Q : ℕ} {T : Shape} (hQ : 1 ≤ Q) {i k μ : ℕ} (hi : i < n) {b : List ℕ}
    (hb : Valid (SH n Q T) b) : Valid (SH n Q T) (shr Q i k μ b) := by
  rw [valid_iff] at hb ⊢
  obtain ⟨hl, hlt⟩ := hb
  refine ⟨by rw [length_shr, hl], fun p h1 h2 => ?_⟩
  rw [length_shr] at h1
  have e := getD_shr Q i k μ b p
  rw [List.getD_eq_getElem _ _ (by rw [length_shr]; exact h1), List.getD_eq_getElem _ _ h1] at e
  rw [e]
  split_ifs with h
  · obtain ⟨rfl, -⟩ := h
    have : (SH n Q T)[p] = Q := by
      simp only [SH, List.getElem_append_left (by simp; omega : p < (List.replicate n Q).length),
        List.getElem_replicate]
    rw [this]; exact Nat.mod_lt _ (by omega)
  · exact hlt p h1 h2

/-! ## The rotation sets -/

theorem length_lsetK (Q n m : ℕ) (sig : Bool) (μ : ℕ) :
    ∀ k (b : List ℕ), (lsetK Q n m sig μ k b).length = b.length
  | 0, b => rfl
  | k + 1, b => by
    simp only [lsetK, Function.comp_apply]; rw [length_lsetK Q n m sig μ k, length_shr]

theorem ctl_lt (sig : Bool) {m j : ℕ} (hj : j < m) : ctl sig m j < m := by
  unfold ctl; split_ifs <;> omega

theorem dg_lsetK {Q : ℕ} (hQ : 1 ≤ Q) {n m : ℕ} (hmn : 2 * m ≤ n) (sig : Bool) (μ : ℕ) :
    ∀ k, k ≤ m → ∀ (b : List ℕ), n ≤ b.length → ∀ p,
      dg Q (lsetK Q n m sig μ k b) p =
        if n - m ≤ p ∧ p < n - m + k then
          dg Q b p - (μ : ZMod Q) * dg Q b (ctl sig m (p - (n - m)))
        else dg Q b p
  | 0, _, b, _, p => by simp [lsetK]
  | k + 1, hk, b, hb, p => by
    simp only [lsetK, Function.comp_apply]
    have hl : n - m + k < b.length := by omega
    rw [dg_lsetK hQ hmn sig μ k (by omega) _ (by rw [length_shr]; exact hb)]
    have hc : ∀ j < m, ctl sig m j ≠ n - m + k := fun j hj => by have := ctl_lt sig hj; omega
    by_cases h1 : n - m ≤ p ∧ p < n - m + k
    · rw [if_pos h1, if_pos ⟨h1.1, by omega⟩, dg_shr hQ _ _ _ _ hl, if_neg (by omega),
        dg_shr hQ _ _ _ _ hl, if_neg (hc _ (by omega))]
    · rw [if_neg h1, dg_shr hQ _ _ _ _ hl]
      by_cases h2 : p = n - m + k
      · rw [if_pos h2, if_pos ⟨by omega, by omega⟩, h2, show n - m + k - (n - m) = k by omega]
      · rw [if_neg h2, if_neg (by omega)]

theorem getD_lsetK {Q n m : ℕ} (sig : Bool) (μ : ℕ) :
    ∀ k (b : List ℕ) p, (p < n - m ∨ n - m + k ≤ p) → (lsetK Q n m sig μ k b).getD p 0 = b.getD p 0
  | 0, b, p, _ => rfl
  | k + 1, b, p, hp => by
    simp only [lsetK, Function.comp_apply]
    rw [getD_lsetK sig μ k _ p (by omega), getD_shr_ne _ _ _ _ _ (by omega)]

theorem valid_lsetK {n Q : ℕ} {T : Shape} (hQ : 1 ≤ Q) {m : ℕ} (hmn : m ≤ n) (sig : Bool) (μ : ℕ) :
    ∀ k, k ≤ m → ∀ b, Valid (SH n Q T) b → Valid (SH n Q T) (lsetK Q n m sig μ k b)
  | 0, _, b, hb => hb
  | k + 1, hk, b, hb => by
    simp only [lsetK, Function.comp_apply]
    exact valid_lsetK hQ hmn sig μ k (by omega) _ (valid_shr hQ (by omega) hb)

/-! ## The block swap -/

theorem length_bsw {n m : ℕ} (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) :
    (bsw n m b).length = b.length := by
  simp only [bsw, List.length_append, List.length_drop, List.length_take]
  omega

theorem getD_bsw {n m : ℕ} (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) (p : ℕ) :
    (bsw n m b).getD p 0 =
      if p < m then b.getD (n - m + p) 0 else if p < n - m then b.getD p 0
      else if p < n then b.getD (p - (n - m)) 0 else b.getD p 0 := by
  simp only [bsw, List.getD_eq_getElem?_getD, List.getElem?_append, List.length_drop,
    List.length_take, List.getElem?_drop, List.getElem?_take, List.length_append]
  have e1 : min n b.length = n := by omega
  have e2 : min (n - m) b.length = n - m := by omega
  have e3 : min m b.length = m := by omega
  rw [e1, e2, e3]
  split_ifs <;> first | rfl | (exfalso; omega) | (congr 2; omega)

theorem dg_bsw {Q n m : ℕ} (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) (p : ℕ) :
    dg Q (bsw n m b) p =
      if p < m then dg Q b (n - m + p) else if p < n - m then dg Q b p
      else if p < n then dg Q b (p - (n - m)) else dg Q b p := by
  unfold dg; rw [getD_bsw hmn hb]; split_ifs <;> rfl

theorem valid_bsw {n Q : ℕ} {T : Shape} {m : ℕ} (hmn : 2 * m ≤ n) {b : List ℕ}
    (hb : Valid (SH n Q T) b) : Valid (SH n Q T) (bsw n m b) := by
  have hl := hb.length_eq
  have hlen : n ≤ b.length := by rw [hl]; simp [SH]
  rw [valid_iff] at hb ⊢
  obtain ⟨hl', hlt⟩ := hb
  refine ⟨by rw [length_bsw hmn hlen, hl'], fun p h1 h2 => ?_⟩
  rw [length_bsw hmn hlen] at h1
  have e := getD_bsw hmn hlen p
  rw [List.getD_eq_getElem _ _ (by rw [length_bsw hmn hlen]; exact h1)] at e
  rw [e]
  have hQ : ∀ q (hq : q < n) (h : q < b.length), b[q] < Q := by
    intro q hq h
    have := hlt q h (by rw [← hl']; exact h)
    simpa [SH, List.getElem_append_left (by simp; omega : q < (List.replicate n Q).length)] using this
  have hpQ : p < n → (SH n Q T)[p] = Q := fun hp => by
    simp only [SH, List.getElem_append_left (by simp; omega : p < (List.replicate n Q).length),
      List.getElem_replicate]
  split_ifs with c1 c2 c3
  · rw [hpQ (by omega), List.getD_eq_getElem _ _ (by omega)]; exact hQ _ (by omega) _
  · rw [List.getD_eq_getElem _ _ h1]; exact hlt p h1 h2
  · rw [hpQ c3, List.getD_eq_getElem _ _ (by omega)]; exact hQ _ (by omega) _
  · rw [List.getD_eq_getElem _ _ h1]; exact hlt p h1 h2

/-! ## The word -/

theorem valid_word {n Q : ℕ} {T : Shape} (hQ : 1 ≤ Q) {b : List ℕ} (hb : Valid (SH n Q T) b) :
    Valid (SH n Q T) (word Q n b) := by
  have h1 : n / 2 ≤ n := Nat.div_le_self _ _
  have h2 : 2 * (n / 2) ≤ n := Nat.mul_div_le n 2
  simp only [word, Function.comp_apply]
  repeat first
    | apply valid_lsetK hQ h1 _ _ _ le_rfl
    | apply valid_bsw h2
  exact hb

/-! ## The reversal identity -/

section Word

variable {Q n m : ℕ}

theorem dgL_x (hQ : 1 ≤ Q) (hmn : 2 * m ≤ n) (sig : Bool) (μ : ℕ) {b : List ℕ} (hb : n ≤ b.length)
    {j : ℕ} (hj : j < m) : dg Q (lsetK Q n m sig μ m b) j = dg Q b j := by
  rw [dg_lsetK hQ hmn sig μ m le_rfl b hb, if_neg (by omega)]

theorem dgL_y (hQ : 1 ≤ Q) (hmn : 2 * m ≤ n) (sig : Bool) (μ : ℕ) {b : List ℕ} (hb : n ≤ b.length)
    {j : ℕ} (hj : j < m) : dg Q (lsetK Q n m sig μ m b) (n - m + j) =
      dg Q b (n - m + j) - (μ : ZMod Q) * dg Q b (ctl sig m j) := by
  rw [dg_lsetK hQ hmn sig μ m le_rfl b hb, if_pos ⟨by omega, by omega⟩,
    show n - m + j - (n - m) = j by omega]

theorem dgL_mid (hQ : 1 ≤ Q) (hmn : 2 * m ≤ n) (sig : Bool) (μ : ℕ) {b : List ℕ} (hb : n ≤ b.length)
    {p : ℕ} (hp : p < n - m) : dg Q (lsetK Q n m sig μ m b) p = dg Q b p := by
  rw [dg_lsetK hQ hmn sig μ m le_rfl b hb, if_neg (by omega)]

theorem dgS_x (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) {j : ℕ} (hj : j < m) :
    dg Q (bsw n m b) j = dg Q b (n - m + j) := by
  rw [dg_bsw hmn hb, if_pos hj]

theorem dgS_y (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) {j : ℕ} (hj : j < m) :
    dg Q (bsw n m b) (n - m + j) = dg Q b j := by
  rw [dg_bsw hmn hb, if_neg (by omega), if_neg (by omega), if_pos (by omega),
    show n - m + j - (n - m) = j by omega]

theorem dgS_mid (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) {p : ℕ} (h1 : m ≤ p)
    (h2 : p < n - m) : dg Q (bsw n m b) p = dg Q b p := by
  rw [dg_bsw hmn hb, if_neg (by omega), if_pos h2]

theorem getD_bsw_hi (hmn : 2 * m ≤ n) {b : List ℕ} (hb : n ≤ b.length) {p : ℕ} (hp : n ≤ p) :
    (bsw n m b).getD p 0 = b.getD p 0 := by
  rw [getD_bsw hmn hb, if_neg (by omega), if_neg (by omega), if_neg (by omega)]

theorem cast_pred (hQ : 1 ≤ Q) : ((Q - 1 : ℕ) : ZMod Q) = -1 := by
  rw [Nat.cast_sub hQ, ZMod.natCast_self]; simp

theorem digit_lt {T : Shape} {c : List ℕ} (hc : Valid (SH n Q T) c) {p : ℕ} (hp : p < n) :
    c.getD p 0 < Q := by
  rw [valid_iff] at hc
  obtain ⟨hl, hlt⟩ := hc
  have hpl : p < c.length := by rw [hl]; simp [SH]; omega
  have := hlt p hpl (by rw [← hl]; exact hpl)
  rw [List.getD_eq_getElem _ _ hpl]
  simpa [SH, List.getElem_append_left (by simp; omega : p < (List.replicate n Q).length)] using this

theorem eq_of_cast {a c : ℕ} (ha : a < Q) (hc : c < Q) (h : (a : ZMod Q) = (c : ZMod Q)) : a = c := by
  have := congrArg ZMod.val h
  rwa [ZMod.val_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt ha, Nat.mod_eq_of_lt hc] at this

theorem getD_revH (b : List ℕ) (hb : n ≤ b.length) (p : ℕ) :
    (KFU.revH n b).getD p 0 = if p < n then b.getD (n - 1 - p) 0 else b.getD p 0 := by
  unfold KFU.revH
  simp only [List.getD_eq_getElem?_getD, List.getElem?_append, List.length_reverse,
    List.length_take, Nat.min_eq_left hb, List.getElem?_drop, List.getElem?_reverse',
    List.getElem?_take]
  split_ifs with h
  · rw [List.getElem?_reverse (by simp; omega), List.length_take, Nat.min_eq_left hb,
      List.getElem?_take_of_lt (by omega)]
  · congr 2; omega

/-- **The word is the reversal of the first `n` digits.** -/
theorem word_rev_sol_aux {T : Shape} (hQ : 2 ≤ Q) {b : List ℕ} (hb : Valid (SH n Q T) b) :
    word Q n b = KFU.revH n b := by
  have hQ1 : 1 ≤ Q := by omega
  set m := n / 2 with hm
  have h2m : 2 * m ≤ n := Nat.mul_div_le n 2
  have hodd : n - 2 * m ≤ 1 := by omega
  have hbl : n ≤ b.length := by rw [hb.length_eq]; simp [SH]
  set b9 := lsetK Q n m false (Q - 1) m b with hb9
  set b8 := lsetK Q n m true 1 m b9 with hb8
  set b7 := bsw n m b8 with hb7
  set b6 := lsetK Q n m false 1 m b7 with hb6
  set b5 := bsw n m b6 with hb5
  set b4 := lsetK Q n m false (Q - 1) m b5 with hb4
  set b3 := lsetK Q n m true 1 m b4 with hb3
  set b2 := bsw n m b3 with hb2
  set b1 := lsetK Q n m true (Q - 1) m b2 with hb1
  have hw : word Q n b = b1 := rfl
  -- lengths
  have l9 : n ≤ b9.length := by rw [hb9, length_lsetK]; exact hbl
  have l8 : n ≤ b8.length := by rw [hb8, length_lsetK]; exact l9
  have l7 : n ≤ b7.length := by rw [hb7, length_bsw h2m l8]; exact l8
  have l6 : n ≤ b6.length := by rw [hb6, length_lsetK]; exact l7
  have l5 : n ≤ b5.length := by rw [hb5, length_bsw h2m l6]; exact l6
  have l4 : n ≤ b4.length := by rw [hb4, length_lsetK]; exact l5
  have l3 : n ≤ b3.length := by rw [hb3, length_lsetK]; exact l4
  have l2 : n ≤ b2.length := by rw [hb2, length_bsw h2m l3]; exact l3
  have hc1 : ((1 : ℕ) : ZMod Q) = 1 := Nat.cast_one
  have hcm : ((Q - 1 : ℕ) : ZMod Q) = -1 := cast_pred hQ1
  have hσσ : ∀ j < m, m - 1 - (m - 1 - j) = j := fun j hj => by omega
  -- the x / y views, stage by stage
  have x9 : ∀ j < m, dg Q b9 j = dg Q b j := fun j hj => dgL_x hQ1 h2m _ _ hbl hj
  have y9 : ∀ j < m, dg Q b9 (n - m + j) = dg Q b (n - m + j) + dg Q b j := fun j hj => by
    rw [hb9, dgL_y hQ1 h2m _ _ hbl hj, hcm]; simp [ctl]
  have x8 : ∀ j < m, dg Q b8 j = dg Q b j := fun j hj => by rw [hb8, dgL_x hQ1 h2m _ _ l9 hj, x9 j hj]
  have y8 : ∀ j < m, dg Q b8 (n - m + j) =
      dg Q b (n - m + j) + dg Q b j - dg Q b (m - 1 - j) := fun j hj => by
    rw [hb8, dgL_y hQ1 h2m _ _ l9 hj, y9 j hj, hc1]; simp only [ctl, if_true]
    rw [x9 _ (by omega)]; ring
  have x7 : ∀ j < m, dg Q b7 j = dg Q b (n - m + j) + dg Q b j - dg Q b (m - 1 - j) := fun j hj => by
    rw [hb7, dgS_x h2m l8 hj, y8 j hj]
  have y7 : ∀ j < m, dg Q b7 (n - m + j) = dg Q b j := fun j hj => by
    rw [hb7, dgS_y h2m l8 hj, x8 j hj]
  have x6 : ∀ j < m, dg Q b6 j = dg Q b (n - m + j) + dg Q b j - dg Q b (m - 1 - j) :=
    fun j hj => by rw [hb6, dgL_x hQ1 h2m _ _ l7 hj, x7 j hj]
  have y6 : ∀ j < m, dg Q b6 (n - m + j) = dg Q b (m - 1 - j) - dg Q b (n - m + j) := fun j hj => by
    rw [hb6, dgL_y hQ1 h2m _ _ l7 hj, y7 j hj, hc1]; simp only [ctl, Bool.false_eq_true, if_false]
    rw [x7 j hj]; ring
  have x5 : ∀ j < m, dg Q b5 j = dg Q b (m - 1 - j) - dg Q b (n - m + j) := fun j hj => by
    rw [hb5, dgS_x h2m l6 hj, y6 j hj]
  have y5 : ∀ j < m, dg Q b5 (n - m + j) = dg Q b (n - m + j) + dg Q b j - dg Q b (m - 1 - j) :=
    fun j hj => by rw [hb5, dgS_y h2m l6 hj, x6 j hj]
  have x4 : ∀ j < m, dg Q b4 j = dg Q b (m - 1 - j) - dg Q b (n - m + j) := fun j hj => by
    rw [hb4, dgL_x hQ1 h2m _ _ l5 hj, x5 j hj]
  have y4 : ∀ j < m, dg Q b4 (n - m + j) = dg Q b j := fun j hj => by
    rw [hb4, dgL_y hQ1 h2m _ _ l5 hj, y5 j hj, hcm]; simp only [ctl, Bool.false_eq_true, if_false]
    rw [x5 j hj]; ring
  have x3 : ∀ j < m, dg Q b3 j = dg Q b (m - 1 - j) - dg Q b (n - m + j) := fun j hj => by
    rw [hb3, dgL_x hQ1 h2m _ _ l4 hj, x4 j hj]
  have y3 : ∀ j < m, dg Q b3 (n - m + j) = dg Q b (n - m + (m - 1 - j)) := fun j hj => by
    rw [hb3, dgL_y hQ1 h2m _ _ l4 hj, y4 j hj, hc1]; simp only [ctl, if_true]
    rw [x4 _ (by omega), hσσ j hj]; ring
  have x2 : ∀ j < m, dg Q b2 j = dg Q b (n - m + (m - 1 - j)) := fun j hj => by
    rw [hb2, dgS_x h2m l3 hj, y3 j hj]
  have y2 : ∀ j < m, dg Q b2 (n - m + j) = dg Q b (m - 1 - j) - dg Q b (n - m + j) := fun j hj => by
    rw [hb2, dgS_y h2m l3 hj, x3 j hj]
  have x1 : ∀ j < m, dg Q b1 j = dg Q b (n - m + (m - 1 - j)) := fun j hj => by
    rw [hb1, dgL_x hQ1 h2m _ _ l2 hj, x2 j hj]
  have y1 : ∀ j < m, dg Q b1 (n - m + j) = dg Q b (m - 1 - j) := fun j hj => by
    rw [hb1, dgL_y hQ1 h2m _ _ l2 hj, y2 j hj, hcm]; simp only [ctl, if_true]
    rw [x2 _ (by omega), hσσ j hj]; ring
  -- the middle and the tail
  have mid : ∀ p, m ≤ p → p < n - m → dg Q b1 p = dg Q b p := by
    intro p h1 h2
    rw [hb1, dgL_mid hQ1 h2m _ _ l2 h2, hb2, dgS_mid h2m l3 h1 h2, hb3, dgL_mid hQ1 h2m _ _ l4 h2,
      hb4, dgL_mid hQ1 h2m _ _ l5 h2, hb5, dgS_mid h2m l6 h1 h2, hb6, dgL_mid hQ1 h2m _ _ l7 h2,
      hb7, dgS_mid h2m l8 h1 h2, hb8, dgL_mid hQ1 h2m _ _ l9 h2, hb9, dgL_mid hQ1 h2m _ _ hbl h2]
  have tail : ∀ p, n ≤ p → b1.getD p 0 = b.getD p 0 := by
    intro p hp
    have g : ∀ (sig : Bool) (μ : ℕ) (c : List ℕ), (lsetK Q n m sig μ m c).getD p 0 = c.getD p 0 :=
      fun sig μ c => getD_lsetK sig μ m c p (Or.inr (by omega))
    rw [hb1, g, hb2, getD_bsw_hi h2m l3 hp, hb3, g, hb4, g, hb5, getD_bsw_hi h2m l6 hp, hb6, g,
      hb7, getD_bsw_hi h2m l8 hp, hb8, g, hb9, g]
  -- conclusion
  have v1 : Valid (SH n Q T) b1 := valid_word (T := T) hQ1 hb
  have vr : Valid (SH n Q T) (KFU.revH n b) := by
    have := KFU.valid_revH (P := List.replicate n Q) (Q := T) hb
    simpa [SH, List.reverse_replicate] using this
  rw [hw]
  apply List.ext_getElem (by rw [v1.length_eq, vr.length_eq])
  intro p h1 h2
  have e1 : b1[p] = b1.getD p 0 := (List.getD_eq_getElem _ _ h1).symm
  have e2 : (KFU.revH n b)[p] = (KFU.revH n b).getD p 0 := (List.getD_eq_getElem _ _ h2).symm
  rw [e1, e2, getD_revH b hbl]
  split_ifs with hp
  · apply eq_of_cast (digit_lt v1 hp) (by
      have := digit_lt vr hp; rwa [getD_revH b hbl, if_pos hp] at this)
    show dg Q b1 p = dg Q b (n - 1 - p)
    by_cases c1 : p < m
    · rw [x1 p c1]; congr 1; omega
    by_cases c2 : p < n - m
    · rw [mid p (by omega) c2]; congr 1; omega
    · obtain ⟨j, rfl⟩ : ∃ j, p = n - m + j := ⟨p - (n - m), by omega⟩
      rw [y1 j (by omega)]; congr 1; omega
  · exact tail p (by omega)

end Word

