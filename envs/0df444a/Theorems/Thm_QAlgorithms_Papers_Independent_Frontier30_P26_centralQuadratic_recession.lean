/-- Lemma 3.6, PDF p. 9. Ambient recession cone and central intersection are explicit. -/
theorem centralQuadratic_recession (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (x : G) :
    centralQuadraticCone P x ⊆ recession (orbitHull x) ∩ (LieAlgebra.center ℝ G : Set G) := by sorry

