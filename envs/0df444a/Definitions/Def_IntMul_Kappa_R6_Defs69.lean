-- Source module: Solutions.R6SPar
/-!
# Round-six setup, part 5: the parameter phase

From `n` (register `23`) and `b = lg n` (register `24`) the program `parP` computes
`d` (`25`, a count of `x ∈ [1, b]` with `x^c ≤ b^a`, `ε = a/c`), `b'` (`29`), `p` (`30`),
`L` (`31`, a count), `ℓ` (`32`), `h` (`33`), `d'` (`34`), `α² = ⌊p/(48d)⌋` (`52`),
`α` (`35`, a count over `[1, b']`) and the start value `1` of the product (`36`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFM RS Finset Function

noncomputable section

/-! ## Powers of a register -/

/-- `e^k` as a product. -/
def pwE (e : Ex HS) : ℕ → Ex HS
  | 0 => .lit 1
  | k + 1 => .mul e (pwE e k)

/-! ## The tests -/

/-- `x^c - b^a - 1` (`x` on `47`, `b` on `24`). -/
def tstD (a c : ℕ) : Ex HS :=
  .add (.add (pwE (.reg 47) c) (.neg (pwE (.reg 24) a))) (.lit (-1))

/-- `2^{x-1} b' - 4n` (`x` on `47`, `b'` on `29`, `n` on `23`). -/
def tstL : Ex HS :=
  .add (.mul (.pow2 (.add (.reg 47) (.lit (-1)))) (.reg 29)) (.neg (.mul (.lit 4) (.reg 23)))

/-- `x² - X - 1` (`x` on `47`, `X` on `52`). -/
def tstA : Ex HS := .add (.add (.mul (.reg 47) (.reg 47)) (.neg (.reg 52))) (.lit (-1))

/-- The parameter phase. -/
def parP (a c X : ℕ) : RS :=
  .seq (cntR 47 25 24 (tstD a c))
  (.seq (.push 29 (pwE (.reg 24) (1 + X)))
  (.seq (.push 30 (.mul (.lit 6) (.reg 29)))
  (.seq (cntR 47 31 24 tstL)
  (.seq (.push 32 (.ndiv (.add (.add (.reg 31) (.reg 25)) (.lit (-1))) (.reg 25)))
  (.seq (.push 33 (.add (.reg 32) (.lit (-1))))
  (.seq (.push 34 (.add (.mul (.reg 25) (.reg 32)) (.neg (.reg 31))))
  (.seq (.push 52 (.ndiv (.reg 30) (.mul (.lit 48) (.reg 25))))
  (.seq (cntR 47 35 29 tstA)
  (.push 36 (.lit 1))))))))))

/-- The cost of the parameter phase (in units `kU`). -/
def cPar (a c X b b' : ℕ) : ℕ := b * (2 * a + 2 * c + 31) + 15 * b' + 2 * X + 44

end

end IntMul.Kappa.R6

end

