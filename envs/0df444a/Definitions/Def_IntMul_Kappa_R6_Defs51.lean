-- Source module: Solutions.R6ChkBitDimDefs
/-!
# Bit round six (h = 23): kernel checker for node span dimensions

For a node with support `sup` (a set of triples of `Fin 23`), its rational span is
`S = span_ℚ {𝟙_t : t ∈ sup}`. A **dimension record** certifies `finrank S = d`:

* header (64 bits): `c` (8), `d` (8), `nc` (8), `md` (8), `Q` (32): a centre `c`, the claimed
  dimension, the number of components, the certificate mode and a coordinate mask `Q`;
* `nc` components (64 bits each): `X` (24), `Y` (24), `x0` (8); `Y = 0` marks a non-bipartite
  component with point set `X`, otherwise `(X, Y)` is a bipartition and `x0 ∈ X`;
* `d` triple indices (16 bits each), then the dual rows: for `md = 0` packed `F₂` rows
  (32-bit fields), for `md = 1` rows over `ℤ/3` (2-bit coordinates, 64-bit fields).

Upper bound: every `t ∈ sup` contains `c` and lies inside one component (crossing it, if
bipartite), so `S` lies in the subspace `Wp` cut out by `x_p = 0` off `V ∪ {c}`,
`Σ_X x = Σ_Y x` per bipartite component and `Σ_V x = 2 x_c`; on `Wp` the coordinates in `Q`
determine `x` (all of `V` is in `Q` except one `x0` per bipartite component), so
`finrank S ≤ |Q| = d`.
Lower bound: the `d` listed triples lie in `sup` and have a dual family mod 2 (resp. mod 3), so
their Gram-type integer matrix has odd (resp. prime-to-3) determinant and they are independent
over `ℚ`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit

open R6Chk

/-- Population count of the low `n` bits. -/
def popc (x : ℕ) (n : ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ) 0 (fun i ih => Nat.add ih (Nat.land (Nat.shiftRight x i) 1)) n

/-- All 23 points. -/
def PF : ℕ := 8388607
/-- All 1792 triple slots. -/
def TF : ℕ := Nat.sub (Nat.shiftLeft 1 1792) 1

/-- Point-set complement. -/
def pc (m : ℕ) : ℕ := Nat.xor m PF
/-- Triple-set complement (within the 1792 slots). -/
def tnot (m : ℕ) : ℕ := Nat.xor m TF

/-- Decoded component list `(X, Y, x0)`. -/
def compsDec (nc : ℕ) : ℕ → List (ℕ × ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → List (ℕ × ℕ × ℕ)) (fun _ => [])
    (fun _ ih s => (fieldOf s 24 0, fieldOf s 24 1, fieldOf s 8 6) :: ih (Nat.shiftRight s 64)) nc

/-- Decoded index list (16-bit fields). -/
def idxDec (d : ℕ) : ℕ → List ℕ :=
  Nat.rec (motive := fun _ => ℕ → List ℕ) (fun _ => [])
    (fun _ ih s => fieldOf s 16 0 :: ih (Nat.shiftRight s 16)) d

/-- Points of a component. -/
def cm (e : ℕ × ℕ × ℕ) : ℕ := Nat.lor e.1 e.2.1

/-- Components pairwise disjoint (and disjoint from `acc`). -/
def pwD (acc : ℕ) : List (ℕ × ℕ × ℕ) → Bool
  | [] => true
  | e :: L => Nat.beq (Nat.land acc (cm e)) 0 && pwD (Nat.lor acc (cm e)) L

/-- One component is well formed w.r.t. centre `c` and coordinate mask `Q`. -/
def compOK (c Q : ℕ) (e : ℕ × ℕ × ℕ) : Bool :=
  Nat.blt e.1 PF.succ && Nat.blt e.2.1 PF.succ && !(tb e.1 c) && !(tb e.2.1 c) &&
    Nat.beq (Nat.land e.1 e.2.1) 0 &&
    cond (Nat.beq e.2.1 0) (Nat.beq (Nat.land e.1 Q) e.1)
      (Nat.blt e.2.2 23 && tb e.1 e.2.2 &&
        Nat.beq (Nat.land (cm e) (pc Q)) (Nat.shiftLeft 1 e.2.2))

/-- Triples allowed by one component (as a 1792-bit mask). -/
def compMask (c : ℕ) (e : ℕ × ℕ × ℕ) : ℕ :=
  cond (Nat.beq e.2.1 0) (tnot (um (pc (Nat.lor e.1 (Nat.shiftLeft 1 c)))))
    (Nat.land (Nat.land (um e.1) (um e.2.1)) (tnot (um (pc (Nat.lor (cm e) (Nat.shiftLeft 1 c))))))

/-- Union of the component masks. -/
def orL (c : ℕ) : List (ℕ × ℕ × ℕ) → ℕ
  | [] => 0
  | e :: L => Nat.lor (compMask c e) (orL c L)

/-- Allowed triples: through `c` and allowed by some component. -/
def alw (c : ℕ) (L : List (ℕ × ℕ × ℕ)) : ℕ := Nat.land (star c) (orL c L)

/-- Pack the triples of an index list into 32-bit rows. -/
def triP : List ℕ → ℕ
  | [] => 0
  | i :: I => Nat.add (tri i) (Nat.shiftLeft (triP I) 32)

/-- `F₂` dual check: `A·Bᵀ = [I_d]` with `A` the listed triples. -/
def cert2 (d : ℕ) (I : List ℕ) (P : ℕ) : Bool :=
  let A := triP I
  let B := tk P d
  Nat.ble d 24 && okR BAD23L A && okR BAD23L B && Nat.beq (dotsF A B) (tgtF 0 d)

/-- `⟨triple i, y⟩` over `ℕ` (`y` with 2-bit coordinates). -/
def dot3 (i y : ℕ) : ℕ :=
  Nat.rec (motive := fun _ => ℕ) 0
    (fun p ih => Nat.add ih (Nat.mul (Nat.land (Nat.shiftRight (tri i) p) 1) (fieldOf y 2 p))) 23

/-- Mod-3 dual check (`d` rows of 64 bits). -/
def cert3 (d : ℕ) (I : List ℕ) (P : ℕ) : Bool :=
  allN d (fun b => let y := fieldOf P 64 b;
    allN d (fun a => Nat.beq (Nat.mod (dot3 (I.getD a 0) y) 3) (cond (Nat.beq a b) 1 0))) &&
  Nat.beq I.length d

/-- Record length in bits. -/
def recLen (R : ℕ) : ℕ :=
  let d := fieldOf R 8 1
  let nc := fieldOf R 8 2
  Nat.add (Nat.add (Nat.mul 64 (Nat.succ nc)) (Nat.mul 16 d))
    (Nat.mul (cond (Nat.beq (fieldOf R 8 3) 0) 32 64) d)

/-- Check one record against the support `sup`. -/
def recBody (sup c d md Q : ℕ) (L : List (ℕ × ℕ × ℕ)) (I : List ℕ) (P : ℕ) : Bool :=
  Nat.blt c 23 && Nat.blt Q PF.succ && Nat.beq (popc Q 23) d &&
    pwD 0 L && allL (compOK c Q) L && Nat.beq (Nat.land sup (alw c L)) sup &&
    allL (fun i => Nat.blt i 1771 && tb sup i) I &&
    cond (Nat.beq md 0) (cert2 d I P) (cert3 d I P)

def recChk (sup R : ℕ) : Bool :=
  let c := fieldOf R 8 0
  let d := fieldOf R 8 1
  let nc := fieldOf R 8 2
  let md := fieldOf R 8 3
  let Q := fieldOf R 32 1
  let s := Nat.shiftRight R (Nat.mul 64 (Nat.succ nc))
  recBody sup c d md Q (compsDec nc (Nat.shiftRight R 64)) (idxDec d s) (Nat.shiftRight s (Nat.mul 16 d))

/-- `cnt` consecutive records for nodes `k, k+1, …`. -/
def recsChk (sg : ℕ → ℕ) (cnt : ℕ) : ℕ → ℕ → Bool :=
  Nat.rec (motive := fun _ => ℕ → ℕ → Bool) (fun _ _ => true)
    (fun _ ih k s => recChk (sg k) s && ih (Nat.succ k) (Nat.shiftRight s (recLen s))) cnt

/-- An element: first node (16 bits), count (16 bits), then the records. -/
def dimChk (sg : ℕ → ℕ) (G : ℕ) : Bool :=
  recsChk sg (fieldOf G 16 1) (fieldOf G 16 0) (Nat.shiftRight G 32)

end R6Chk.Bit

end

section
-- Source module: Solutions.R6ChkBitDim
/-!
# Bit round six (h = 23): soundness of the node-dimension checker

`spanS sup = span_ℚ {𝟙_{tri i} : sup.testBit i}` (`𝟙_{tri i} ∈ ℚ^23` the indicator vector of the
`i`-th triple). `recChk_sound`: if `recChk sup R = true` then `finrank ℚ (spanS sup) = d`
(the record's claimed dimension); `dimChk_sound` lifts this to a whole element.
-/

set_option maxRecDepth 100000
set_option exponentiation.threshold 2000

namespace R6Chk.Bit

open R6Chk Matrix Module

/-! ## Independence over `ℚ` from a dual family modulo `q` -/

/-! ## Bit helpers -/

theorem land1 (x i : ℕ) : Nat.land (Nat.shiftRight x i) 1 = if x.testBit i then 1 else 0 := by
  rw [nland, nshr, Nat.and_one_is_mod, Nat.testBit_eq_decide_div_mod_eq, Nat.shiftRight_eq_div_pow]
  rcases Nat.mod_two_eq_zero_or_one (x / 2 ^ i) with h | h <;> simp [h]

/-- The points of a mask. -/
def F (m : ℕ) : Finset (Fin 23) := Finset.univ.filter fun p => m.testBit p = true

theorem popc_eq (x : ℕ) : ∀ n, popc x n = ∑ i ∈ Finset.range n, if x.testBit i then 1 else 0
  | 0 => rfl
  | n + 1 => by
    rw [Finset.sum_range_succ, ← popc_eq x n]
    show Nat.add (popc x n) (Nat.land (Nat.shiftRight x n) 1) = _
    rw [land1]; rfl

theorem popc_card (x : ℕ) : popc x 23 = (F x).card := by
  rw [popc_eq, F, Finset.card_filter, ← Fin.sum_univ_eq_sum_range (fun i => if x.testBit i then 1 else 0)]

/-! ## Table facts -/

theorem tri_chk : allN 1771 (fun i => Nat.blt (tri i) PF.succ && Nat.beq (popc (tri i) 23) 3) = true := by
  decide +kernel

theorem tri_spec {i : ℕ} (hi : i < 1771) : tri i < 2 ^ 23 ∧ (F (tri i)).card = 3 := by
  have := allN_spec tri_chk i hi
  simp only [Bool.and_eq_true, Nat.beq_eq, blt_dec, decide_eq_true_eq] at this
  exact ⟨this.1, popc_card _ ▸ this.2⟩

/-- Field `r` of `UMTj`, spelled out: triples meeting `{6j + t : r.testBit t}`. -/
def umq (j r : ℕ) : ℕ → ℕ :=
  Nat.rec (motive := fun _ => ℕ) 0 (fun t ih => Nat.lor ih (cond (tb r t) (star (Nat.add (Nat.mul 6 j) t)) 0))

/-! ## Mask semantics -/

/-- What one component mask allows at a triple `i < 1771`. -/
def CompAllows (c : ℕ) (e : ℕ × ℕ × ℕ) (i : ℕ) : Prop :=
  if e.2.1 = 0 then ∀ p < 23, (tri i).testBit p = true → e.1.testBit p = true ∨ p = c
  else (∃ p < 23, e.1.testBit p = true ∧ (tri i).testBit p = true) ∧
    (∃ p < 23, e.2.1.testBit p = true ∧ (tri i).testBit p = true) ∧
    ∀ p < 23, (tri i).testBit p = true → e.1.testBit p = true ∨ e.2.1.testBit p = true ∨ p = c

/-- Components pairwise disjoint. -/
def DisjC (e e' : ℕ × ℕ × ℕ) : Prop := cm e &&& cm e' = 0

instance : Std.Symm DisjC := ⟨fun a b (h : cm a &&& cm b = 0) => by
  show cm b &&& cm a = 0; rw [Nat.land_comm]; exact h⟩

/-! ## The rational span and the upper bound -/

/-- Indicator vector of triple `i`. -/
def tvQ (i : ℕ) : Fin 23 → ℚ := fun p => if (tri i).testBit p = true then 1 else 0

/-- The rational span of the triples of `sup`. -/
def spanS (sup : ℕ) : Submodule ℚ (Fin 23 → ℚ) :=
  Submodule.span ℚ {v | ∃ i, sup.testBit i = true ∧ v = tvQ i}

/-- Union of the components. -/
def vM : List (ℕ × ℕ × ℕ) → ℕ
  | [] => 0
  | e :: L => cm e ||| vM L

def sumOn (m : ℕ) (x : Fin 23 → ℚ) : ℚ := ∑ p ∈ F m, x p

/-- The subspace cut out by the component data. -/
def Wp (c : ℕ) (L : List (ℕ × ℕ × ℕ)) : Submodule ℚ (Fin 23 → ℚ) where
  carrier := {x | (∀ p : Fin 23, (vM L).testBit p = false → (p : ℕ) ≠ c → x p = 0) ∧
    (∀ e ∈ L, e.2.1 ≠ 0 → sumOn e.1 x = sumOn e.2.1 x) ∧ sumOn (vM L) x = 2 * sumOn (2 ^ c) x}
  zero_mem' := ⟨fun _ _ _ => rfl, fun _ _ _ => by simp [sumOn], by simp [sumOn]⟩
  add_mem' := by
    rintro x y ⟨hx1, hx2, hx3⟩ ⟨hy1, hy2, hy3⟩
    refine ⟨fun p h1 h2 => by simp [hx1 p h1 h2, hy1 p h1 h2], fun e he h => ?_, ?_⟩
    · simp only [sumOn, Pi.add_apply, Finset.sum_add_distrib] at hx2 hy2 ⊢
      rw [hx2 e he h, hy2 e he h]
    · simp only [sumOn, Pi.add_apply, Finset.sum_add_distrib] at hx3 hy3 ⊢
      rw [hx3, hy3]; ring
  smul_mem' := by
    rintro a x ⟨hx1, hx2, hx3⟩
    refine ⟨fun p h1 h2 => by simp [hx1 p h1 h2], fun e he h => ?_, ?_⟩
    · simp only [sumOn, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum] at hx2 ⊢
      rw [hx2 e he h]
    · simp only [sumOn, Pi.smul_apply, smul_eq_mul, ← Finset.mul_sum] at hx3 ⊢
      rw [hx3]; ring

/-- Componentwise data facts used by the upper bound. -/
structure CompFacts (c Q : ℕ) (e : ℕ × ℕ × ℕ) : Prop where
  cX : e.1.testBit c = false
  cY : e.2.1.testBit c = false
  XY : e.1 &&& e.2.1 = 0
  nb : e.2.1 = 0 → F e.1 ⊆ F Q
  bp : e.2.1 ≠ 0 → ∃ x0 : Fin 23, x0 ∈ F e.1 ∧ ∀ p ∈ F (cm e), p ∉ F Q → p = x0
  hX : e.1 < 2 ^ 23
  hY : e.2.1 < 2 ^ 23

/-! ## Lower bound -/

/-- Integer indicator vector of a mask. -/
def bz (m : ℕ) : Fin 23 → ℤ := fun p => if m.testBit p = true then 1 else 0

/-! ## Assembly -/

/-- Decoded `(node, dimension)` pairs. -/
def recsDec (cnt : ℕ) : ℕ → ℕ → List (ℕ × ℕ) :=
  Nat.rec (motive := fun _ => ℕ → ℕ → List (ℕ × ℕ)) (fun _ _ => [])
    (fun _ ih k s => (k, fieldOf s 8 1) :: ih (Nat.succ k) (Nat.shiftRight s (recLen s))) cnt

/-- The `(node, dimension)` pairs of an element. -/
def dimList (G : ℕ) : List (ℕ × ℕ) := recsDec (fieldOf G 16 1) (fieldOf G 16 0) (Nat.shiftRight G 32)

/-! ## Label nesting from the DAG checks -/

