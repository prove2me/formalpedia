-- title:
--   Sigma algebra at a lattice-valued stopping time
-- statement:
--   The sigma algebra generated by ambient-measurable events A such that A intersected with {τ ≤ u} belongs to the filtration at u for every u. Under the stopping-time condition this family is already a sigma algebra, as in (8.6).
-- source:
--   Stewart N. Ethier and Thomas G. Kurtz, Markov Processes: Characterization and Convergence, Wiley, 1986, Chapter 2 §8, Theorem 8.7, printed pp. 87–88 (PDF pp. 96–97); conventions and (8.6) on printed p. 85 (PDF p. 94).

import Mathlib

open MeasureTheory Filter
open scoped Topology ENNReal

namespace EthierKurtz

def directedStoppedSigma {I Ω : Type*} [Preorder I] [mΩ : MeasurableSpace Ω]
    (ℱ : Filtration I mΩ) (τ : Ω → I) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom
    {A : Set Ω | MeasurableSet A ∧
      ∀ u : I, MeasurableSet[ℱ u] (A ∩ {ω | τ ω ≤ u})}

end EthierKurtz


