-- Source module: Solutions.R6BitNBNetB
/-!
# Round six, bit network: frame labels (`LabGates` for the whole program)

At field size `N`, under `EOK ch N` (flag basis, good denominators and the frame matrices of the
chosen edges), the whole program is label consistent from the initial labels `L0`, and the final
labels are: `swapMat` on `X(a, s)`, `A₁`, `A₂`, and `Φ₂(a, ND(s + 1))` on `Y(a, s)`.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac

/-- Hypotheses at field size `N`. -/
structure EOK (ch : Ch) (N : ℕ) : Prop where
  hS : ch.S * ch.Si = 1
  hSi : ch.Si * ch.S = 1
  gS : GoodM N ch.S
  gSi : GoodM N ch.Si
  gPc : ∀ c < 38286, GoodM N (Pc c)
  gPl : ∀ b < 1771, GoodM N (Pl b)
  m1 : ∀ b < 1771, ∀ o < 38286, ∀ c < 38286, nestOK o c = true →
    edgeMat N (ch.e1 b o c) = redM N (pswQ (K ch.S ch.Si (Dm o c) (Pl b)))
  m2 : ∀ a < 1771, ∀ o < 38286, ∀ c < 38286, nestOK o c = true →
    edgeMat N (ch.e2 a o c) = redM N (pswQ (K ch.S ch.Si (Pl a) (Dm o c)))
  mx : ∀ b < 1771, edgeMat N (ch.ex b) = redM N (pswQ (K ch.S ch.Si 1 (1 - Pl b)))
  mn : ∀ a < 1771, ∀ t < 1771, edgeMat N (ch.en a t) = redM N (pswQ (K ch.S ch.Si (1 - Pl a) (1 - Pl t)))
  mi : ∀ a < 1771, edgeMat N (ch.ei a) = redM N (pswQ (K ch.S ch.Si (1 - Pl a) 1))
  mc : ∀ a < 1771, ∀ s < 1771, edgeMat N (ch.ec a s) = redM N (pswQ (K ch.S ch.Si (Pl a) (Pl s)))

noncomputable def lab1 (ch : Ch) (N b c : ℕ) : FMat 529 N := redM N (Φ₁ ch.S ch.Si b c)
noncomputable def lab2 (ch : Ch) (N a c : ℕ) : FMat 529 N := redM N (Φ₂ ch.S ch.Si a c)

/-! ## Stage facts -/

section Lab

variable {ch : Ch} {N : ℕ} (h : EOK ch N)
include h

/-- Final labels of stage one. -/
noncomputable def fin1 (ch : Ch) (N b w : ℕ) : FMat 529 N :=
  if 3542 ≤ w ∧ w < 43619 then swapMat else lab1 ch N b (codeOf SG1_11 w)

/-! ## Block two -/

noncomputable def pre2 (ch : Ch) (N a w : ℕ) : FMat 529 N :=
  if w < 1771 then lab1 ch N w (cPT a) else if w < 3542 then lab1 ch N (w - 1771) cHIGH
  else if w < 43619 then 1 else if w < 43642 then lab2 ch N a (codeOf SG2_0 w) else swapMat

noncomputable def fin2 (ch : Ch) (N a w : ℕ) : FMat 529 N :=
  if w < 43642 then lab2 ch N a (codeOf SG2_10 w) else lab2 ch N a (cND (w - 43642 + 1))

/-- Correction wires. -/
def cw (s j : ℕ) : ℕ := if j = 0 then wU s else if j = 1 then wY s else wX s

/-- Correction pre/post labels. -/
noncomputable def cf (ch : Ch) (N a s j : ℕ) : FMat 529 N :=
  if j = 0 then swapMat else if j = 1 then swapMat else lab2 ch N a (cND (s + 1))
noncomputable def cg (ch : Ch) (N a s j : ℕ) : FMat 529 N :=
  if j = 1 then swapMat else lab2 ch N a (cND (s + 1))

attribute [local irreducible] LabGates

end Lab

/-! ## The whole program -/

/-- Initial labels. -/
noncomputable def L0 (ch : Ch) (N : ℕ) : Wr → FMat 529 N
  | .inl g => if g.val < 3136441 then lab1 ch N (g.val % 1771) (cND (g.val / 1771 + 1)) else 1
  | .inr t => if t.val < 40733 then lab1 ch N (t.val / 23) (codeOf SG1_0 (43619 + t.val % 23))
      else if t.val < 81466 then lab2 ch N ((t.val - 40733) / 23) (codeOf SG2_0 (43619 + (t.val - 40733) % 23))
      else swapMat

end IntMul.Kappa.R6.Bit.NB

end

