section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS
set_option maxHeartbeats 1000000
theorem solution (d n m kb B : ℕ) (D : List (List ℤ)) (Rest : List Item) (s : IState HS)
    (hD : D.length = n * m) (hDw : ∀ r ∈ D, r.length = d) (hN : n * m ≤ 2 ^ kb) (hm : 1 ≤ m)
    (L1 L2 L3 : List Item) (h0 : s.G 0 = ints D.flatten ++ Rest) (h1 : s.G 1 = .int n :: L1)
    (h2 : s.G 2 = .int m :: L2) (h3 : s.G 3 = .int kb :: L3) (hDB : ∀ r ∈ D, Bnd B r) :
    (transP d).cost s ≤ 10 ^ 6 * (kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4) := by
  set X := B + kb + d + 2 with hX
  have hXB : ∀ r ∈ D, NLogN.Bnd X r := fun r hr x hx => le_trans (hDB r hr x hx) (by omega)
  have hpow : 2 ^ kb * (d + 1) < 2 ^ (kb + d + 1) := by
    rw [show kb + d + 1 = kb + (d + 1) by ring, pow_add]
    exact Nat.mul_lt_mul_of_pos_left Nat.lt_two_pow_self (by positivity)
  have hX1 : NLogN.zsz ((n * m + n : ℕ) : ℤ) ≤ X := by
    have hn : n ≤ n * m := Nat.le_mul_of_pos_right _ hm
    have h4 : 2 ^ (kb + 2) = 2 ^ kb * 4 := by rw [pow_add]; norm_num
    have h5 : 0 < 2 ^ kb := by positivity
    have : n * m + n < 2 ^ (kb + 2) := by rw [h4]; omega
    exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
  have hX2 : NLogN.zsz ((n * m * (d + 1) : ℕ) : ℤ) ≤ X := by
    have : n * m * (d + 1) < 2 ^ (kb + d + 1) :=
      lt_of_le_of_lt (Nat.mul_le_mul_right _ hN) hpow
    exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
  have hXd : NLogN.zsz ((d + 1 : ℕ) : ℤ) ≤ X := by
    have : d + 1 < 2 ^ (d + 1) := Nat.lt_two_pow_self
    exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
  have hA := NLogN.attachP_spec d n m D Rest s hD hDw L1 L2 h0 h1 h2
  have cA := NLogN.attachP_cost d n m D Rest s hD hDw hm L1 L2 h0 h1 h2 X hXB hX1 hX2 hXd
  set s1 := (((s.upd 0 (NLogN.ints (NLogN.kflat n m D (n * m)) ++ Rest)).upd 42 (.int (n : ℤ) :: s.G 42)).upd 45
        (.int ((n * m * (d + 1) : ℕ) : ℤ) :: s.G 45)).upd 54 (.int ((n * m : ℕ) : ℤ) :: s.G 54)
    with hs1
  set K := (List.range (n * m)).map (NLogN.keyRec n m D) with hK
  have hKw : ∀ r ∈ K, r.length = d + 1 := by
    intro r hr; simp only [hK, List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    simp only [NLogN.keyRec, List.length_cons, List.getD_eq_getElem _ _ (by omega : p < D.length),
      hDw _ (List.getElem_mem _)]
  have hKB : ∀ r ∈ K, NLogN.Bnd X r := by
    intro r hr; simp only [hK, List.mem_map, List.mem_range] at hr
    obtain ⟨p, hp, rfl⟩ := hr
    intro x hx
    simp only [NLogN.keyRec, List.mem_cons] at hx
    rcases hx with rfl | hx
    · have h1' := NLogN.tpos_lt n m p hp
      have : (p % m) * n + p / m < 2 ^ kb := lt_of_lt_of_le h1' hN
      exact le_trans (NLogN.zsz_nat_le_of_lt this) (by omega)
    · rw [List.getD_eq_getElem _ _ (by omega : p < D.length)] at hx
      exact hXB _ (List.getElem_mem _) x hx
  have hKl : K.length = n * m := by simp [hK]
  have s10 : s1.G 0 = NLogN.ints K.flatten ++ Rest := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [hK, NLogN.kflat]
  have s154 : s1.G 54 = .int K.length :: s.G 54 := by simp [hs1, hK]
  have s13 : s1.G 3 = .int kb :: L3 := by
    simp only [hs1, NLogN.IState.upd_G]; simp (config := {decide := true}) [h3]
  have hW := NLogN.sortW_spec (d + 1) kb s1 K Rest hKw (by omega) (s.G 54) L3 s10 s154 s13
  have cW := NLogN.sortW_cost (d + 1) kb s1 K Rest hKw (by omega) (s.G 54) L3 s10 s154 s13 X hKB
    (by rw [hKl]; exact hX2) (by omega) hXd
  rw [hKl] at cW
  set S := NLogN.radixSort kb K with hS
  have hSw : ∀ r ∈ S, r.length = d + 1 := fun r hr => hKw r ((NLogN.radixSort_perm kb K).subset hr)
  have hSB : ∀ r ∈ S, NLogN.Bnd X r := fun r hr => hKB r ((NLogN.radixSort_perm kb K).subset hr)
  have hSl : S.length = K.length := (NLogN.radixSort_perm kb K).length_eq
  set s2 := s1.upd 0 (NLogN.ints S.flatten ++ Rest) with hs2
  have s254 : s2.G 54 = .int S.length :: s.G 54 := by
    simp only [hs2, NLogN.IState.upd_G]; simp (config := {decide := true}) [hSl, s154]
  have s245 : s2.G 45 = .int ((n * m * (d + 1) : ℕ) : ℤ) :: s.G 45 := by
    simp only [hs2, hs1, NLogN.IState.upd_G]; simp (config := {decide := true})
  have hP := NLogN.stripP_spec d S Rest s2 hSw (s.G 54) s254 (by simp [hs2]) (NLogN.IState.isInt_of s245)
  have cP := NLogN.stripP_cost d S Rest s2 hSw (s.G 54) s254 (by simp [hs2]) _ (s.G 45) s245 X hSB
    (by rw [hSl, hKl]; exact hX2) hXd hX2
  rw [hSl, hKl] at cP
  set s3 := (s2.upd 0 (NLogN.ints (S.map List.tail).flatten ++ Rest)).upd 45
        (.int ((S.length * d : ℕ) : ℤ) :: (s2.G 45).tail) with hs3
  have s354 : s3.G 54 = .int S.length :: s.G 54 := by
    simp only [hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s254]
  have s345 : ((NLogN.RS.pop 54).run s3).G 45 = .int ((S.length * d : ℕ) : ℤ) :: s.G 45 := by
    simp only [NLogN.RS.run_pop_G, hs3, NLogN.IState.upd_G]; simp (config := {decide := true}) [s245]
  have s342 : ((NLogN.RS.pop 45).run ((NLogN.RS.pop 54).run s3)).G 42 = .int (n : ℤ) :: s.G 42 := by
    simp only [NLogN.RS.run_pop_G, hs3, hs2, hs1, NLogN.IState.upd_G]; simp (config := {decide := true})
  have p1 : NLogN.zsz (S.length : ℤ) ≤ X := by
    rw [hSl, hKl]; exact NLogN.zsz_le_of_nat_le (Nat.le_mul_of_pos_right _ (by omega)) hX2
  have p2 : NLogN.zsz ((S.length * d : ℕ) : ℤ) ≤ X := by
    rw [hSl, hKl]; exact NLogN.zsz_le_of_nat_le (Nat.mul_le_mul_left _ (by omega)) hX2
  have p3 : NLogN.zsz (n : ℤ) ≤ X := NLogN.zsz_le_of_nat_le (by omega) hX1
  simp only [NLogN.transP, NLogN.cost_seq, NLogN.cost_pop]
  rw [hA.2, hW.2, hP.2, NLogN.IState.top_eq s354, NLogN.IState.top_eq s345, NLogN.IState.top_eq s342]
  have hX2' : X + 2 = B + kb + d + 4 := by omega
  rw [hX2'] at cA cW cP
  have e1 : 200000 * (kb + 1) * (n * m * (d + 1) + 1) * (B + kb + d + 4) ≤
      200000 * (kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4) := by
    have h : n * m * (d + 1) + 1 ≤ (n * m + 1) * (d + 1) := by nlinarith
    calc 200000 * (kb + 1) * (n * m * (d + 1) + 1) * (B + kb + d + 4)
        ≤ 200000 * (kb + 1) * ((n * m + 1) * (d + 1)) * (B + kb + d + 4) :=
          Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h)
      _ = _ := by ring
  have e2 : 100000 * (n * m + 1) * (d + 1) * (B + kb + d + 4) ≤
      100000 * (kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4) := by
    have : 1 ≤ kb + 1 := by omega
    nlinarith [Nat.zero_le ((n * m + 1) * (d + 1) * (B + kb + d + 4))]
  have e3 : 50000 * (n * m + 1) * (d + 1) * (B + kb + d + 4) ≤
      50000 * (kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4) := by
    nlinarith [Nat.zero_le ((n * m + 1) * (d + 1) * (B + kb + d + 4))]
  have e4 : 9000 * (B + kb + d + 4) + 6 * (B + kb + d + 4) ≤
      9006 * (kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4) := by
    have : 1 ≤ (kb + 1) * (n * m + 1) * (d + 1) := Nat.one_le_iff_ne_zero.2 (by positivity)
    nlinarith
  have e5 := Nat.zero_le ((kb + 1) * (n * m + 1) * (d + 1) * (B + kb + d + 4))
  linarith only [cA, cW, cP, e1, e2, e3, e4, e5, p1, p2, p3, hX2']
