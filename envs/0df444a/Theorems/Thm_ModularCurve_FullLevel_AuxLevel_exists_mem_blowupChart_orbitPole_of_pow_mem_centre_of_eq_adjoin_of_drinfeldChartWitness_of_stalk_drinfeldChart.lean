              (∀ c : ↥(chartAlgFin A (↥K) j), (c : ↥K) ∈ V) →
              (∀ (c : ↥(chartAlgFin A (↥K) j)) (hc : τ.symm (c : ↥K) ∈ chartAlgFin A (↥K) j),
                  (⟨τ.symm (c : ↥K), hc⟩ : ↥(chartAlgFin A (↥K) j)) ∈ y'' → ∀ hcV : (c : ↥K) ∈ V, (⟨(c : ↥K), hcV⟩ : ↥V) ∈ maximalIdeal ↥V) →
              b ∉ V) := by sorry
