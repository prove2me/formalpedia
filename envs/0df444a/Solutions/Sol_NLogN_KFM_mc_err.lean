open Complex
variable {ι : Type*} [Fintype ι]
theorem solution (p : ℕ) {Mr Mrt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)} (hMr : NLogN.KFM.BilC Mr) (Er : ℝ)
    (hMrt : ∀ a b, NLogN.KFM.Grid p a → NLogN.KFM.Grid p b → ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ‖Mrt a b - Mr a b‖ ≤ Er * NLogN.KFM.hp p)
    {θ θt θi θit : ι → ℂ} (hθ : NLogN.KFM.Phases p θ θt) (hθi : NLogN.KFM.Phases p θi θit)
    {f g : ι → ℂ} (hf : ‖f‖ ≤ 1) (hg : ‖g‖ ≤ 7 / 10) (hE : Er * NLogN.KFM.hp p ≤ 3 / 10) :
    ‖NLogN.KFM.mcT p Mrt θt θit f g - θi * Mr (θ * f) (θ * g)‖ ≤ (Er + 12) * NLogN.KFM.hp p ∧
      ‖NLogN.KFM.mcT p Mrt θt θit f g‖ ≤ 7 / 10 + Er * NLogN.KFM.hp p := by
  have h0 := NLogN.KFM.hp_pos p
  obtain ⟨ef, nf⟩ := NLogN.KFM.phase_err p θ θt f hθ.e hθ.t hθ.t1 hf
  obtain ⟨eg, ng⟩ := NLogN.KFM.phase_err p θ θt g hθ.e hθ.t hθ.t1 (hg.trans (by norm_num))
  set f' := NLogN.KFM.QA p (θt * f)
  set g' := NLogN.KFM.QA p (θt * g)
  have nθf : ‖θ * f‖ ≤ 1 := (NLogN.KFM.norm_mul_le' _ _).trans (by
    have : ‖θ‖ ≤ 1 := NLogN.KFM.pi_le zero_le_one hθ.e
    nlinarith [norm_nonneg θ, norm_nonneg f])
  have hh := hMrt f' g' (NLogN.KFM.QA_grid _ _) (NLogN.KFM.QA_grid _ _) (nf.trans hf) (ng.trans (hg.trans (by norm_num)))
  set h' := Mrt f' g'
  have hb := NLogN.KFM.bil_err hMr (θ * f) f' (θ * g) g'
  have hMn : ‖Mr f' g'‖ ≤ 7 / 10 := (hMr.le _ _).trans (by
    nlinarith [norm_nonneg f', norm_nonneg g', nf.trans hf, ng.trans hg])
  have hh1 : ‖h'‖ ≤ 7 / 10 + Er * NLogN.KFM.hp p := by
    have := norm_sub_norm_le h' (Mr f' g'); linarith
  obtain ⟨eo, no⟩ := NLogN.KFM.phase_err p θi θit h' hθi.e hθi.t hθi.t1 (by linarith)
  refine ⟨?_, no.trans hh1⟩
  have nθi : ‖θi‖ ≤ 1 := NLogN.KFM.pi_le zero_le_one hθi.e
  have e1 : NLogN.KFM.mcT p Mrt θt θit f g - θi * Mr (θ * f) (θ * g) =
      (NLogN.KFM.QA p (θit * h') - θi * h') + θi * (h' - Mr f' g') + θi * (Mr f' g' - Mr (θ * f) (θ * g)) := by
    simp only [NLogN.KFM.mcT]; ring
  rw [e1]
  have t2 : ‖θi * (h' - Mr f' g')‖ ≤ Er * NLogN.KFM.hp p :=
    (NLogN.KFM.norm_mul_le' _ _).trans (by nlinarith [norm_nonneg (h' - Mr f' g'), norm_nonneg θi])
  have t3 : ‖θi * (Mr f' g' - Mr (θ * f) (θ * g))‖ ≤ 8 * NLogN.KFM.hp p := by
    refine (NLogN.KFM.norm_mul_le' _ _).trans ?_
    have : ‖Mr f' g' - Mr (θ * f) (θ * g)‖ ≤ 8 * NLogN.KFM.hp p := by
      refine hb.trans ?_
      have n1 : ‖g'‖ ≤ 1 := ng.trans (hg.trans (by norm_num))
      nlinarith [norm_nonneg (f' - θ * f), norm_nonneg (g' - θ * g), norm_nonneg g',
        norm_nonneg (θ * f)]
    nlinarith [norm_nonneg (Mr f' g' - Mr (θ * f) (θ * g)), norm_nonneg θi]
  calc _ ≤ ‖NLogN.KFM.QA p (θit * h') - θi * h'‖ + ‖θi * (h' - Mr f' g')‖ +
        ‖θi * (Mr f' g' - Mr (θ * f) (θ * g))‖ := norm_add₃_le
    _ ≤ 4 * NLogN.KFM.hp p + Er * NLogN.KFM.hp p + 8 * NLogN.KFM.hp p := add_le_add (add_le_add eo t2) t3
    _ = (Er + 12) * NLogN.KFM.hp p := by ring
end
