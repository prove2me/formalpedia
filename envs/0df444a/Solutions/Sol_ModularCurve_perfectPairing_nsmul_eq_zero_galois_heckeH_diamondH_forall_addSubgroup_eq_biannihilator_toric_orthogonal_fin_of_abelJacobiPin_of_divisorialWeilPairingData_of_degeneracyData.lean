    (translation_mem_GammaH M H) hT' (heckeBetaHBar Qb M H ℓ)

theorem separableAlong_of_charZero {F F' : Type*} [Field F] [Field F'] [Algebra Qb F] [Algebra Qb F']
    (φ : F →ₐ[Qb] F') (hφ : φ.toRingHom.IsIntegral) : SeparableAlong Qb φ := by
  letI := algebraAlong φ
