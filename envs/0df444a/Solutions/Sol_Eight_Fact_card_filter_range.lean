open Eight
open Groundwork Groundwork.Prog PaddedDescent.F Finset
open Eight.Fact
namespace Eight.Fact
theorem _root_.solution (t : ℕ) (p : ℕ → Bool) : #((range t).filter fun s => p s = true) = (List.range t).countP p := by
  induction t with
  | zero => simp
  | succ t ih =>
    rw [range_add_one, filter_insert, List.range_succ, List.countP_append]
    by_cases h : p t = true
    · rw [if_pos h, card_insert_of_notMem (by simp), ih]; simp [h]
    · rw [if_neg h, ih]; simp [h]
end Eight.Fact
