-- title:
--   §4, p. 13 — a consistent extreme base satisfies $x(v) \le f(R(v)) - f(R(v) \setminus \{v\})$
-- statement:
--   Let $V$ be a finite nonempty set, $f$ submodular on $V$ with $f(\emptyset) = 0$, and $D = (V, F)$ a digraph with $F \subseteq V \times V$. Let $x$ be the extreme base generated by a linear ordering of $V$ consistent with $D$, and $R(v)$ the set of vertices reachable from $v$ in $D$ (including $v$). Then for each $v \in V$
--   $$x(v) \le f(R(v)) - f(R(v) \setminus \{v\}).$$
--
--   This bounds every component of the starting base of Fix by $\eta$ of (4.1).
-- source:
--   Iwata, Fleischer & Fujishige, A Combinatorial, Strongly Polynomial-Time Algorithm for Minimizing Submodular Functions, arXiv:math/0004089v1, p. 13, §4 (consistent extreme bases)

import Mathlib
import Definitions.Def_IwataFF_SFM_Basic
import Definitions.Def_IwataFF_SFM_Phase
import Definitions.Def_IwataFF_SFM_Main

namespace IwataFF.SFM

/-- §4, p. 13 (arXiv:math/0004089v1): an extreme base generated by a linear ordering consistent
with `D = (V, F)` satisfies `x(v) ≤ f(R(v)) − f(R(v) \ {v})` for each `v ∈ V`. -/
theorem consistent_base_bound {α : Type} [DecidableEq α] (V : Finset α) (hV : V.Nonempty)
    (f : Finset α → ℝ) (hsub : SubmodularOn V f) (hf0 : f ∅ = 0)
    (F : Finset (α × α)) (hF : ∀ e ∈ F, e.1 ∈ V ∧ e.2 ∈ V)
    (L : List α) (hL : IsOrdering V L) (hcons : IsConsistent F L) :
    ∀ v ∈ V, greedy f L v ≤ f (reach V F v) - f ((reach V F v).erase v) := by sorry

end IwataFF.SFM
