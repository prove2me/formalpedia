/-! # One-variable derivative shapes

Explicit `HasDerivAt` witnesses for the few expression shapes that occur in closed-form
metric and Christoffel tables. Closed forms are written in exactly these shapes, so each table
entry is certified by one of these lemmas (no symbolic differentiation is trusted).
-/

open Real

namespace ExactVacuumAtlas.Deriv

theorem div_self_prime (K r : ℝ) (hr : r ≠ 0) : HasDerivAt (fun u => K / u) (-K / r ^ 2) r := by
  refine ((hasDerivAt_const r K).fun_div (hasDerivAt_id' r) hr).congr_deriv ?_
  field_simp
  ring

end ExactVacuumAtlas.Deriv

