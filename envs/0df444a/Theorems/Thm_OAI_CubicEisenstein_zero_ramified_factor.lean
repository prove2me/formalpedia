theorem OAI.CubicEisenstein.zero_ramified_factor (s : ℂ) (hs : 1<s.re) :
    (∑'u:Eisˣ,∑'n:ℕ,((3^(n+2):ℕ):ℂ)^(-s)*
      arithmeticResidueSum 0 (u.val*lambda^(n+2)))=
      2*((3:ℂ)^(3*s-3)-1)⁻¹ := by sorry
