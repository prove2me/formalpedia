-- title:
--   Lemma 12.20 — the back-pressure fluid equation (milestone)
-- statement:
--   **Lemma 12.20.** For a packet network operating under the back-pressure control policy, each
--   fluid limit path satisfies $$\hat Z(t)\cdot R\dot{\hat D}(t) = \max_{s\in\langle S\rangle}
--   \hat Z(t)\cdot Rs$$ at each regular point $t\ge 0$ (Eq. 12.44), in addition to
--   (12.31)–(12.36).
--
--   The book's proof reduces the maximum over $\langle S\rangle$ to a maximum over the finite set
--   $S$ (a linear functional on a polytope is maximized at an extreme point), then shows that any
--   schedule $s$ with strictly smaller objective than the maximizer $s^*$ has $\dot{\hat T}_s(t) =
--   0$ — the discrete-time analog of Lemma 9.10/9.11 (mission VIII).
--
--   **Formalization note.** The fluid limit paths are those of the processes generated by the
--   back-pressure policy $f$ (mission XII's Definition 12.14 for `P` with `hBP`), so the
--   back-pressure property enters through the policy itself rather than through a separately
--   hypothesized raw-path optimality condition.
-- source:
--   Dai & Harrison, Processing Networks: Fluid Models and Stability, pre-publication draft 2020-4-2, p. 242, Lemma 12.20, Eq. (12.44)

import Mathlib
import Definitions.Def_ProcessingNetworks_PacketNetworks_BackPressurePolicy
import Definitions.Def_ProcessingNetworks_PacketNetworks_BPFluidModel

namespace ProcessingNetworks.PacketNetworks

/-- Lemma 12.20, Dai & Harrison p. 242 (PDF p. 258): for a packet network operating under the
back-pressure control policy `f` (the primitives' policy function), each fluid limit path
`(D̂,T̂,Ẑ)` (Definition 12.14, for the processes generated by `f`) satisfies the back-pressure
fluid equation (12.44) in addition to (12.31)-(12.36). -/
theorem back_pressure_fluid_equation
    {I J : ℕ} {Ω : Type*} (dat : PacketNetworkData I J) (S : Finset (Fin J → ℕ))
    (P : PacketPrimitives I J Ω) (hBP : IsBackPressurePolicy dat S P.f) (lam : Fin I → ℝ)
    (Dh : ℝ → Fin J → ℝ) (Th : ℝ → (Fin J → ℕ) → ℝ) (Zh : ℝ → Fin I → ℝ)
    (hFL : IsFluidLimitPath dat P S lam Dh Th Zh) :
    SatisfiesBackPressureFluidEquation dat S Dh Th Zh := by sorry

end ProcessingNetworks.PacketNetworks
