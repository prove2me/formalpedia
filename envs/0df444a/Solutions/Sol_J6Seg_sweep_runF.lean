section ax
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp}
  {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {Cx : ℝ}
  {pf : ℕ → List GI → List GI}
  (hX : AxisBodyF P n src D pf Isym tbl eX dA Cx) (hD : dP6 P n = D + 1)
include hW hX hD

/-- The list invariant along the sweep. -/
theorem sweep_inv (Q : List GI → Prop)
    (hpipe : ∀ k ≤ D, ∀ L : List GI, Q L → Q (pf k L))
    (ys : List GI) (hys : Q ys) :
    ∀ k ≤ D + 1, Q (pipeSweep (pf) k ys) := by
  intro k
  induction k with
  | zero => intro _; exact hys
  | succ k ih =>
    intro hk
    exact hpipe k (by omega) _ (ih (by omega))

theorem swL_run (B : ℕ) (hb : SwB P n src D B) (Q : List GI → Prop)
    (hQ : ∀ L, Q L → L.length = TW P n D ∧ GB (pP6 P n + 2) L)
    (hpipe : ∀ k ≤ D, ∀ L : List GI, Q L → Q (pf k L))
    (s : IState HS) (F : Fin HS → List ℤ) (ys : List GI) (l : List ℤ) (hys : Q ys) :
    IRuns Isym tbl (swL σ dS dA eX)
      (encK s (SS σ dS F (gflat ys ++ l) (svW src D) (vK P n src D 0)))
      (encK s (SS σ dS F (gflat (pipeSweep (pf) (D + 1) ys) ++ l) []
        (vK P n src D (D + 1))))
      ((1 + 1) * 2000 * (B + 2) + (D + 1) * (cAx ⌊Cx⌋₊ B + 8000 * (B + 2) + 30) +
        (2 * B + 32)) := by
  have hkB : D + 1 ≤ B := by have := hb.hB; omega
  have h3 : SS σ dS F (gflat (pipeSweep (pf) 0 ys) ++ l) ((svW src D).drop 0)
      (vK P n src D 0) (σ 3) = [((D + 1 : ℕ) : ℤ)] := by
    rw [SS_at hW]; simp [vK, vH, update_apply]
  have H := IRuns.irep (I := Isym) (iprog := tbl) (C := σ 17) (n := .reg (σ 3))
    (body := axB σ dS dA eX) (s := s)
    (F := fun k => SS σ dS F (gflat (pipeSweep (pf) k ys) ++ l)
      ((svW src D).drop k) (vK P n src D k))
    (N := D + 1) (B := B) (c := cAx ⌊Cx⌋₊ B) (by linarith [hb.two]) (hW.lt 17)
    (fun k => by rw [SS_at hW]; simp [vK, vH, update_apply]) (clean_reg (hW.lt 3)) (ok_reg h3)
    trivial (bnd_reg h3 (le_trans (zsz_natCast_le_self _) hkB)) (eval_reg h3) (by
      intro k hk
      simp only [SS_v hW]
      obtain ⟨h1, h2⟩ := hQ _ (sweep_inv hW hX hD Q hpipe ys hys k (by omega))
      exact axB_run hW hX hD B k (by omega) hb s F _ l _ h1 h2)
  have hd : (svW src D).drop (D + 1) = [] := by
    rw [List.drop_eq_nil_of_le (by rw [svW_len])]
  rw [show pipeSweep (pf) 0 ys = ys from rfl, List.drop_zero, hd] at H
  exact H

end ax

end J6Seg

end

