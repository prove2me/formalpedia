open scoped ContDiff
open Matrix Filter Topology
open ExactVacuumAtlas
theorem solution {U : Set (Pt 4)} (hU : IsOpen U) {Φ : Pt 4 → Pt 4}
    (hΦ : ContDiffOn ℝ ∞ Φ U) {J : Pt 4 → Matrix (Fin 4) (Fin 4) ℝ} {x : Pt 4} (hx : x ∈ U)
    (hJ : ∀ k i : Fin 4, HasDerivAt (fun u : ℝ => Φ (Function.update x i u) k) (J x k i) (x i))
    (v : Pt 4) : fderiv ℝ Φ x v = J x *ᵥ v := by
  have hd : DifferentiableAt ℝ Φ x := (hΦ.contDiffAt (hU.mem_nhds hx)).differentiableAt (by simp)
  have hsingle : ∀ j k, fderiv ℝ Φ x (Pi.single j 1) k = J x k j := by
    intro j k
    have h1 : HasDerivAt (Function.update x j) (Pi.single j 1) (x j) := hasDerivAt_update x j (x j)
    have h2 : HasFDerivAt Φ (fderiv ℝ Φ x) (Function.update x j (x j)) := by
      rw [Function.update_eq_self]; exact hd.hasFDerivAt
    have h3 := HasFDerivAt.comp_hasDerivAt (x := x j) (hl := h2) (hf := h1)
    exact ((hasDerivAt_pi.mp h3) k).unique (hJ k j)
  have hv : v = ∑ j : Fin 4, v j • (Pi.single j (1 : ℝ) : Pt 4) := by
    ext m; simp [Finset.sum_apply, Pi.single_apply]
  ext k
  rw [hv, map_sum]
  simp only [map_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [hsingle j k, mul_comm]
  simp [Pi.single_apply]
