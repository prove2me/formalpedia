-- url     : https://prove2.me/theorems/8ed51396-5ef5-49b9-8ef9-fb64e8137d6c
-- title:
--   The coefficient field of an MTT eigenform
-- statement:
--   For a normalized algebraic cuspidal eigenform $f$, define its coefficient field $K_f\subset\overline{\mathbf Q}$ to be the subfield generated by all Fourier coefficients $a_n(f)$ and all values of its nebentype $\varepsilon_f$:
--
--   $$
--   K_f=\mathbf Q\bigl(a_n(f),\varepsilon_f(a):n\ge0,\ a\in\mathbf Z/N\mathbf Z\bigr).
--   $$
--
--   The definition bundle records that every Fourier coefficient, every prime Hecke eigenvalue, and every nebentype value belongs to $K_f$. In the normalization of `MTT.Eigenform`, the Hecke eigenvalue at a prime $\ell$ is the Fourier coefficient $a_\ell(f)$.
-- source:
--   Kriz--Nordentoft, Horizontal p-adic L-functions, arXiv:2310.20678v3, Section 4, p. 27, especially equation (4.2), https://arxiv.org/pdf/2310.20678

import Definitions.Def_MTT_Arithmetic

set_option autoImplicit false
noncomputable section

namespace MTT

namespace Eigenform

/-- The coefficient field of an MTT eigenform: the subfield of `Qbar`
generated by all Fourier coefficients and all values of the nebentype. -/
def coefficientField
    {N k : ℕ} {ι : Qbar →+* ℂ} (f : Eigenform N k ι) : Subfield Qbar :=
  Subfield.closure (Set.range f.coeff ∪ Set.range f.epsilon)

theorem coeff_mem_coefficientField
    {N k : ℕ} {ι : Qbar →+* ℂ} (f : Eigenform N k ι) (n : ℕ) :
    f.coeff n ∈ f.coefficientField :=
  Subfield.subset_closure (Set.mem_union_left _ ⟨n, rfl⟩)

/-- Every prime Hecke eigenvalue belongs to the coefficient field.  In the
normalization used by `MTT.Eigenform`, this eigenvalue is `f.coeff l`. -/
theorem heckeEigenvalue_mem_coefficientField
    {N k : ℕ} {ι : Qbar →+* ℂ} (f : Eigenform N k ι)
    (l : ℕ) (_hl : l.Prime) :
    f.coeff l ∈ f.coefficientField :=
  f.coeff_mem_coefficientField l

theorem nebentype_mem_coefficientField
    {N k : ℕ} {ι : Qbar →+* ℂ} (f : Eigenform N k ι) (a : ZMod N) :
    f.epsilon a ∈ f.coefficientField :=
  Subfield.subset_closure (Set.mem_union_right _ ⟨a, rfl⟩)

end Eigenform

end MTT


