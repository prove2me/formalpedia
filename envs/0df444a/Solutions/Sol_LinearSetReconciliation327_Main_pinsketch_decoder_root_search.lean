theorem rootFactorProcedure_spec {F : Type} [Field F] [DecidableEq F] [Algebra (ZMod 2) F] {w : ℕ}
    (b : Module.Basis (Fin w) (ZMod 2) F) (ι : ℕ → F) (t N : ℕ) (P : Program) (E : RAMEnv)
    (pc R U D C TB ZB cap L Q0 Q1 : ℕ) (fs0 : List F[X]) (m : ℕ → ℕ)
