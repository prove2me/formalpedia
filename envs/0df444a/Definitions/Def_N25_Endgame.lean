namespace N25.Endgame

abbrev Qbar := AlgebraicClosure ℚ
abbrev Γ25 : Subgroup (Matrix.SpecialLinearGroup (Fin 2) ℤ) :=
  CohCarrier.GammaH 25 N25.H25

abbrev FQ := ModularCurve.xHFunctionField 25 N25.H25
abbrev FG := ModularCurve.xHFunctionFieldBar 25 N25.H25
abbrev FBase (K : Type*) [Field K] :=
  ModularCurve.xHFunctionFieldC K 25 N25.H25

/-- The canonical coefficient algebra, exposed to avoid scalar-tower search. -/
instance FBaseAlgebra25 (K : Type*) [Field K] : Algebra K (FBase K) :=
  (FBase K).algebra

abbrev QPlace := AlgebraicCurve.Place ℚ FQ
abbrev GPlace := AlgebraicCurve.Place Qbar FG

def IsRationalGeomPlace (P : GPlace) : Prop :=
  P.deg = 1 ∧
    ∀ σ : N25.Gal, ModularCurve.arithmeticGalois FQ σ • P = P

abbrev RationalGeomPlace := {P : GPlace // IsRationalGeomPlace P}

noncomputable def emb25 : FQ →ₐ[ℚ] FG :=
  { toFun := fun f => ⟨ModularCurve.coeffEmb Qbar f,
      ModularCurve.coeffEmb_mem_laurentBaseChange Qbar f.property⟩
    map_zero' := Subtype.ext (map_zero _)
    map_one' := Subtype.ext (map_one _)
    map_add' := fun f g => Subtype.ext (map_add (ModularCurve.coeffEmb Qbar) (f : LaurentSeries ℚ) (g : LaurentSeries ℚ))
    map_mul' := fun f g => Subtype.ext (map_mul (ModularCurve.coeffEmb Qbar) (f : LaurentSeries ℚ) (g : LaurentSeries ℚ))
    commutes' := fun q => Subtype.ext (by
      exact RingHom.congr_fun (RingHom.ext_rat
        ((ModularCurve.coeffEmb Qbar).comp (FQ.toSubfield.subtype.comp (algebraMap ℚ FQ)))
        (FG.toSubfield.subtype.comp (algebraMap ℚ FG))) q) }

theorem coe_emb25 (f : FQ) :
    (emb25 f : LaurentSeries Qbar) =
      ModularCurve.coeffEmb Qbar (f : LaurentSeries ℚ) := rfl

def jBase25 (K : Type*) [Field K] : FBase K :=
  ⟨ModularCurve.jqModC K,
    ModularCurve.intFormRatiosC_subset K Γ25
      (ModularCurve.jqModC_mem_intFormRatiosC K Γ25)⟩

abbrev j25 : FQ := jBase25 ℚ

abbrev κ (A : ValuationSubring Qbar) := IsLocalRing.ResidueField A
abbrev FSpecial (A : ValuationSubring Qbar) := FBase (κ A)
abbrev SpecialPlace (A : ValuationSubring Qbar) :=
  AlgebraicCurve.Place (κ A) (FSpecial A)
abbrev SpecialPic (A : ValuationSubring Qbar) :=
  AlgebraicCurve.Pic0 (κ A) (FSpecial A)

structure RedDatum25 (ℓ : ℕ) [Fact ℓ.Prime] where
  A : ValuationSubring Qbar
  hA : A.LiesOverPrime ℓ
  charp : CharP (κ A) ℓ
  hred : ModularCurve.ReductionInputsQExpModL A Γ25

attribute [instance] RedDatum25.charp

abbrev red25 {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    N25.J →+ SpecialPic D.A :=
  ModularCurve.reductionQExpModL D.A Γ25

abbrev redPlace25 {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    GPlace → SpecialPlace D.A :=
  ModularCurve.placeReductionQExpModL D.hred

abbrev frobPic25 {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    SpecialPic D.A →+ SpecialPic D.A :=
  ModularCurve.qExpFrobeniusPushforwardModL (κ D.A) Γ25 ℓ

abbrev frobPlace25 {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    SpecialPlace D.A → SpecialPlace D.A :=
  ModularCurve.qExpFrobeniusPlaceModL (κ D.A) Γ25 ℓ

def RedFixed25 {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    AddSubgroup (SpecialPic D.A) :=
  (frobPic25 D - AddMonoidHom.id (SpecialPic D.A)).ker

noncomputable def redFixedEquivFixedPoints25
    {ℓ : ℕ} [Fact ℓ.Prime] (D : RedDatum25 ℓ) :
    ↥(RedFixed25 D) ≃ Function.fixedPoints (frobPic25 D) where
  toFun x := ⟨x.val, by
    have h := x.property
    change frobPic25 D x.val - x.val = 0 at h
    exact sub_eq_zero.mp h⟩
  invFun x := ⟨x.val, by
    change frobPic25 D x.val - x.val = 0
    exact sub_eq_zero.mpr x.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

structure CuspChoice25 where
  hQ : ∃ j : FQ, (ModularCurve.qSeriesBar ℚ FQ j).order = -1
  hG : ∃ j : FG, (ModularCurve.qSeriesBar Qbar FG j).order = -1
  tauQ : FQ ≃ₐ[ℚ] FQ

end N25.Endgame


