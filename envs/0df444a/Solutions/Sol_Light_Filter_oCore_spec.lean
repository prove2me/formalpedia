theorem oAddr_eq_place {t i : ℕ} (hi : i < X.w t) :
    oAddr X.n (X.WI t) (X.WJ t) i = X.place t i := by
  rw [oAddr, HostData.getD_WI hi, HostData.getD_WJ hi, HostData.rowOf_mul_add_colOf]

/-- The answer of the counting solver for the query pair number i. -/
theorem oAns_getD (hv : X.Valid) {t i : ℕ} (ht : t < X.m) (hi : i < X.w t) :
    (thinOut X.n X.D (X.matX t) (X.matY t) (X.WI t) (X.WJ t)).getD i 0 =
      oCnt X (t / X.chunkCount * (X.n * X.n) + oAddr X.n (X.WI t) (X.WJ t) i) := by
  have hiI : i < (X.WI t).length := by rw [hv.length_WI ht]; exact hi
  have hiJ : i < (X.WJ t).length := by rw [hv.length_WJ ht]; exact hi
  have hzip : i < ((X.WI t).zip (X.WJ t)).length := by rw [List.length_zip]; omega
  rw [oAddr_eq_place hi, oCnt, ← oThinEntry_eq_cntOf hv ht hi, ← HostData.getD_WI hi,
    ← HostData.getD_WJ hi, thinOut, List.getD_eq_getElem _ _ (by simpa using hzip),
    List.getElem_map, List.getElem_zip, List.getD_eq_getElem _ _ hiI,
    List.getD_eq_getElem _ _ hiJ]

