-- title:
--   Finite generator expansion for powers of a spanned ideal
-- statement:
--   A member of the nth power of an ideal generated by a finite family is a finite sum of coefficients times products of exactly n generators, with each product recorded by its generator multiplicities.

import Mathlib.RingTheory.MvPolynomial.Ideal

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.finite_span_pow_mem_expansion
    {σ : Type*} [Fintype σ] {R : Type*} [CommSemiring R]
    (f : σ → R) (n : Nat) (p : R)
    (hp : p ∈ (Ideal.span (Set.range f)) ^ n) :
    ∃ (m : Nat) (b : Fin m → σ → Nat) (q : Fin m → R),
      (∀ j, (∑ i, b j i) = n) ∧
      p = ∑ j, (∏ i, f i ^ (b j i)) * q j := by sorry
