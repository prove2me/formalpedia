  obtain ⟨n₂, hS₂, hn₂, hnorm₂, hsq₂, -⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_finiteIdele_meetOrder_isEichlerOrder_mul_of_not_dvd
