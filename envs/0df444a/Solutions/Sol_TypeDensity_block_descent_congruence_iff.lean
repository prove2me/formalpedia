  have hδ := TypeDensity.natDegree_pos_of_isUnramifiedLift hΦ
  obtain ⟨B, hBm, hBd, hBr, hBp, -, hs, -⟩ := TypeDensity.selectBlock_spec O Φ hΦ r hδ a ha
