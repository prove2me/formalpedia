theorem Formalism.DivisionValues.StepBAux.majAt_eq {d : ℕ} (X : InfinitePlace K → Matrix (Fin d) (Fin d) ℂ) (v : InfinitePlace K)
    (x y : Fin d → K) :
    Formalism.HermitianLatticesTheory.majAt (Pi.basisFun K (Fin d)) X v x y =
      star (cvec v.embedding x) ⬝ᵥ (met X v *ᵥ cvec v.embedding y) := by sorry
