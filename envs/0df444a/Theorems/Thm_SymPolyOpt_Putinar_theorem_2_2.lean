-- title:
--   Theorem 2.2 (Putinar), p. 4 — under Assumption 2.1, L is integration against a probability measure on K iff L(1) = 1 and L ≥ 0 on the quadratic module
-- statement:
--   Let $g_1,\dots,g_m\in\mathbb R[X_1,\dots,X_n]$ and let $K=\{x\in\mathbb R^n: g_j(x)\ge0,\ j=1,\dots,m\}$ satisfy Assumption 2.1: $K$ is compact, and some $u=u_0+\sum_{j=1}^m u_jg_j$ with sums of squares $u_0,\dots,u_m$ has a compact superlevel set $\{u\ge0\}$. Let $L:\mathbb R[X]\to\mathbb R$ be linear. Then there is a Borel probability measure $\mu$ supported on $K$ with
--   $$L(p)=\int p\,d\mu\qquad\text{for all }p\in\mathbb R[X]$$
--   if and only if $L(1)=1$ and
--   $$L\Big(s_0+\sum_{j=1}^m s_jg_j\Big)\ge0$$
--   for all sums of squares $s_0,\dots,s_m\in\mathbb R[X]$.
--
--   This is Putinar's Positivstellensatz in its dual (moment) form. It characterizes the moment functionals of measures on a compact basic semialgebraic set by positivity on the quadratic module generated by the $g_j$, and it is the input of the moment relaxation (2.4) and of the symmetric version, Theorem 3.2.
--
--   **Formalization Note** "Supported on $K$" is $\mu(\mathbb R^n\setminus K)=0$; $K$ is closed, so this is the paper's $\mu\in\mathcal P(K)$. Since $\mu$ is a probability measure carried by the compact set $K$, every polynomial is $\mu$-integrable, so the integrals are genuine.
-- source:
--   Riener, Theobald, Jansson Andrén and Lasserre, Exploiting symmetries in SDP-relaxations for polynomial optimization, arXiv:1103.0486v3, p. 4, Theorem 2.2 (Putinar [32]); P(K) defined after (2.3), p. 4

import Mathlib
import Definitions.Def_SymPolyOpt_Putinar_Setting

namespace SymPolyOpt.Putinar

open MeasureTheory MvPolynomial

theorem theorem_2_2 {n m : ℕ} (g : Fin m → MvPolynomial (Fin n) ℝ) (hA : Assumption21 g)
    (L : MvPolynomial (Fin n) ℝ →ₗ[ℝ] ℝ) :
    (∃ μ : Measure (Fin n → ℝ), IsProbabilityMeasure μ ∧ μ (feasK g)ᶜ = 0 ∧
        ∀ p, L p = ∫ x, eval x p ∂μ) ↔
      (L 1 = 1 ∧ ∀ (s₀ : MvPolynomial (Fin n) ℝ) (s : Fin m → MvPolynomial (Fin n) ℝ),
        IsSumSq s₀ → (∀ j, IsSumSq (s j)) → 0 ≤ L (s₀ + ∑ j, s j * g j)) := by sorry

end SymPolyOpt.Putinar
