    calc (8 * b + 17 + 2) ^ 2 ≤ (19 * (b + 1)) ^ 2 := Nat.pow_le_pow_left (by omega) 2
      _ = 361 * (b + 1) ^ 2 := by ring
  calc (N + 1) * S * 10 ^ 7 * (8 * b + 17 + 2) ^ 2
      ≤ (300 * (b + 1) ^ 2) * 41 * 10 ^ 7 * (361 * (b + 1) ^ 2) := by gcongr
    _ ≤ 10 ^ 15 * (b + 1) ^ 4 := by ring_nf; nlinarith [Nat.zero_le ((b + 1) ^ 4)]

theorem RS.cost_seq' (a b : RS) (s : IState HS) : (RS.seq a b).cost s = a.cost s + b.cost (a.run s) :=
  rfl

theorem RS.cost_asg' (i : Fin HS) (e : Ex HS) (s : IState HS) : (RS.asg i e).cost s = asgCost i e s :=
  rfl

theorem RS.cost_push' (i : Fin HS) (e : Ex HS) (s : IState HS) :
    (RS.push i e).cost s = e.cost s + (2 * moveCost (zsz (e.eval s)) + 19) := rfl

end NLogN.KFM

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFM
open IntMul IntMul.OpenAI.Glue IntMul.OpenAI.RP RS
set_option maxHeartbeats 4000000
theorem solution (n : ℕ) (hn : IntMul.OpenAI.Glue.n0 ≤ n) (s : NLogN.IState NLogN.HS) (LD LR : List NLogN.Item)
    (hD : s.G NLogN.KFM.zD = .int (IntMul.OpenAI.Glue.dP n : ℤ) :: LD) (hR : s.G NLogN.KFM.zR = .int (IntMul.OpenAI.Glue.rP n : ℤ) :: LR) :
    NLogN.KFM.setupC.cost s ≤ 4 * 10 ^ 15 * (IntMul.OpenAI.Glue.bP n + 1) ^ 4 := by
  obtain ⟨hb, hd1, hdb, hd2, -, -, -, hbig, hr, -, hr64, hQ3⟩ := NLogN.KFM.setup_facts hn
  obtain ⟨A, hA⟩ : ∃ A, A = 2 ^ (IntMul.OpenAI.Glue.bP n + 2) := ⟨_, rfl⟩
  have hbA : 2 ^ IntMul.OpenAI.Glue.bP n * 4 = A := by rw [hA, pow_add]; norm_num
  have hb2 : IntMul.OpenAI.Glue.bP n < 2 ^ IntMul.OpenAI.Glue.bP n := Nat.lt_two_pow_self
  have h2A : 2 ≤ A := by omega
  have hAB : ∀ k ≤ 8, A ^ k < 2 ^ (8 * IntMul.OpenAI.Glue.bP n + 17) := fun k hk => by rw [hA]; exact NLogN.KFM.AB_ok _ k hk
  set Bn := 8 * IntMul.OpenAI.Glue.bP n + 17 with hBn
  set d := IntMul.OpenAI.Glue.dP n with hdd
  set r := IntMul.OpenAI.Glue.rP n with hrr
  set D := 256 * d ^ 2 with hDd
  set F := D.factorial with hFd
  have hF1 : 1 ≤ F := Nat.one_le_iff_ne_zero.2 (Nat.factorial_ne_zero _)
  have hD1 : 1 ≤ D := by have : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd1; omega
  have hDb : D ≤ 256 * IntMul.OpenAI.Glue.bP n := by omega
  have hFr : F ≤ r := by
    have : 1 ≤ 64 * d ^ 2 := by have : 1 ≤ d ^ 2 := Nat.one_le_pow _ _ hd1; omega
    nlinarith
  have hdd' : (d : ℤ) * d = ((d ^ 2 : ℕ) : ℤ) := by push_cast; ring
  have hb256 : 256 * IntMul.OpenAI.Glue.bP n < 2 ^ IntMul.OpenAI.Glue.bP n := by
    have h1 := IntMul.OpenAI.Glue.cube_lt_pow (IntMul.OpenAI.Glue.bP n) (by omega)
    have h2 : IntMul.OpenAI.Glue.bP n ^ 3 = IntMul.OpenAI.Glue.bP n * (IntMul.OpenAI.Glue.bP n * IntMul.OpenAI.Glue.bP n) := by ring
    have h3 : 4 ≤ IntMul.OpenAI.Glue.bP n * IntMul.OpenAI.Glue.bP n := by nlinarith
    have h4 : IntMul.OpenAI.Glue.bP n * 4 ≤ IntMul.OpenAI.Glue.bP n * (IntMul.OpenAI.Glue.bP n * IntMul.OpenAI.Glue.bP n) := Nat.mul_le_mul_left _ h3
    rw [h2] at h1
    omega
  have hFA : D.factorial + D + 1 ≤ A := by rw [← hFd]; omega
  -- F = D!
  have hDe : NLogN.KFM.DE.eval s = (D : ℤ) := by
    simp only [NLogN.KFM.DE, NLogN.Ex.eval, NLogN.IState.top_eq hD, hDd]; push_cast; ring
  have c1 := NLogN.KFM.prodP_cost NLogN.KFM.DE NLogN.KFM.zQ s D (by decide) (by decide) (NLogN.KFM.clean_of_regs _ (by decide))
    (by decide) (by simp [NLogN.KFM.DE, NLogN.Ex.ok, NLogN.IState.isInt_of hD]) hDe Bn
    (NLogN.KFM.zsz_of_abs (A := A) (k := 1) (by rw [Nat.abs_cast, pow_one]; exact_mod_cast hFA)
      (hAB 1 (by norm_num)))
    (NLogN.KFM.exSm_bnd A Bn s h2A _ (by
      simp only [NLogN.KFM.DE, NLogN.KFM.exSm, NLogN.IState.top_eq hD]; constructorm* _ ∧ _; (all_goals
                                                                                                first
                                                                                                | assumption
                                                                                                | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                                                | ((norm_num); (done))
                                                                                                | ((norm_num); (omega))
                                                                                                | omega
                                                                                                | positivity
                                                                                                |
                                                                                                  ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                                                        first
                                                                                                        | ((norm_num); (done))
                                                                                                        | omega);
                                                                                                    (done)))) (hAB _ (by decide)))
  obtain ⟨k1, r1⟩ := NLogN.KFM.prodP_run NLogN.KFM.DE NLogN.KFM.zQ s D (by decide) (by decide) (NLogN.KFM.clean_of_regs _ (by decide))
    (by decide) (by simp [NLogN.KFM.DE, NLogN.Ex.ok, NLogN.IState.isInt_of hD]) hDe
  set t1 := s.upd NLogN.KFM.zQ (.int (F : ℤ) :: s.G NLogN.KFM.zQ) with ht1
  have t1Q : t1.G NLogN.KFM.zQ = .int (F : ℤ) :: s.G zQ := by simp [ht1]
  have t1D : t1.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht1, NLogN.IState.upd_G, hD]
  have t1R : t1.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht1, NLogN.IState.upd_G, hR]
  have hDe1 : NLogN.KFM.DE.eval t1 = (D : ℤ) := by
    simp only [NLogN.KFM.DE, NLogN.Ex.eval, NLogN.IState.top_eq t1D, hDd]; push_cast; ring
  -- Q
  have hQe : NLogN.KFM.QE.eval t1 = (NLogN.KFM.srcQ d r : ℤ) := by
    simp only [NLogN.KFM.QE, NLogN.Ex.eval, NLogN.IState.top_eq t1Q, NLogN.IState.top_eq t1R, hDe1, NLogN.KFM.srcQ, ← hDd, ← hFd]
    norm_cast
  have h2FD : (0 : ℤ) < 2 * (F : ℤ) * D := by
    have : (1 : ℤ) ≤ F := by exact_mod_cast hF1
    have : (1 : ℤ) ≤ D := by exact_mod_cast hD1
    positivity
  have c2 := NLogN.RS.asgCost_le NLogN.KFM.zQ NLogN.KFM.QE t1 Bn (NLogN.KFM.exSm_bnd A Bn t1 h2A _ (by
      simp only [NLogN.KFM.QE, NLogN.KFM.exSm, NLogN.IState.top_eq t1Q, NLogN.IState.top_eq t1R, NLogN.Ex.eval, hDe1]
      simp only [NLogN.KFM.DE, NLogN.KFM.exSm, NLogN.IState.top_eq t1D]
      constructorm* _ ∧ _; (all_goals
                              first
                              | assumption
                              | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                              | ((norm_num); (done))
                              | ((norm_num); (omega))
                              | omega
                              | positivity
                              |
                                ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                      first
                                      | ((norm_num); (done))
                                      | omega);
                                  (done)))) (hAB _ (by decide)))
    (by
      rw [NLogN.IState.top_eq t1Q]
      exact NLogN.KFM.zsz_of_abs (A := A) (k := 1) (by rw [Nat.abs_cast, pow_one]; exact_mod_cast (by omega))
        (hAB 1 (by norm_num)))
  set Q := NLogN.KFM.srcQ d r with hQd
  set t2 := s.upd NLogN.KFM.zQ (.int (Q : ℤ) :: s.G NLogN.KFM.zQ) with ht2
  have r2 : (NLogN.RS.asg NLogN.KFM.zQ NLogN.KFM.QE).run t1 = t2 := by
    simp only [NLogN.RS.run, hQe, t1Q, List.tail_cons]; rw [ht1, NLogN.IState.upd_upd_same]
  have t2Q : t2.G NLogN.KFM.zQ = .int (Q : ℤ) :: s.G zQ := by simp [ht2]
  have t2D : t2.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht2, NLogN.IState.upd_G, hD]
  have t2R : t2.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht2, NLogN.IState.upd_G, hR]
  have hQ1 : 1 ≤ Q := by
    have : 0 < Q := by rw [hQd]; unfold NLogN.KFM.srcQ; positivity
    omega
  have h4dQ : (0 : ℤ) < 4 * (d : ℤ) * Q := by
    have : (1 : ℤ) ≤ d := by exact_mod_cast hd1
    have : (1 : ℤ) ≤ Q := by exact_mod_cast hQ1
    positivity
  -- M_{r/2}
  have hh2 : (NLogN.Ex.ndiv (.reg NLogN.KFM.zR) (.lit 2)).eval t2 = ((r / 2 : ℕ) : ℤ) := by
    simp only [NLogN.Ex.eval, NLogN.IState.top_eq t2R]; omega
  have c3 := NLogN.RS.pushCost_le (NLogN.KFM.ME (.ndiv (.reg NLogN.KFM.zR) (.lit 2))) t2 Bn (NLogN.KFM.exSm_bnd A Bn t2 h2A _ (by
      simp only [NLogN.KFM.ME, NLogN.KFM.exSm, NLogN.IState.top_eq t2R, NLogN.IState.top_eq t2D, NLogN.IState.top_eq t2Q, NLogN.Ex.eval]
      constructorm* _ ∧ _; (all_goals
                              first
                              | assumption
                              | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                              | ((norm_num); (done))
                              | ((norm_num); (omega))
                              | omega
                              | positivity
                              |
                                ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                      first
                                      | ((norm_num); (done))
                                      | omega);
                                  (done)))) (hAB _ (by decide)))
  set t3 := t2.upd NLogN.KFM.zMh (.int (NLogN.KFM.srcM d r (r / 2) : ℤ) :: t2.G NLogN.KFM.zMh) with ht3
  have r3 : (NLogN.RS.push NLogN.KFM.zMh (NLogN.KFM.ME (.ndiv (.reg NLogN.KFM.zR) (.lit 2)))).run t2 = t3 := by
    simp only [NLogN.RS.run, NLogN.KFM.ME_eval t2 _ d _ _ LD _ t2D t2Q hh2 hd1 (NLogN.KFM.ME_h4 d r _ hd1 hr64 le_rfl), ht3,
      NLogN.KFM.srcM, ← hQd]
  have t3Q : t3.G NLogN.KFM.zQ = .int (Q : ℤ) :: s.G zQ := by
    simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2Q]
  have t3D : t3.G NLogN.KFM.zD = .int (d : ℤ) :: LD := by simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2D]
  have t3R : t3.G NLogN.KFM.zR = .int (r : ℤ) :: LR := by simp (config := {decide := true}) [ht3, NLogN.IState.upd_G, t2R]
  -- M_r
  have c4 := NLogN.RS.pushCost_le (NLogN.KFM.ME (.reg NLogN.KFM.zR)) t3 Bn (NLogN.KFM.exSm_bnd A Bn t3 h2A _ (by
      simp only [NLogN.KFM.ME, NLogN.KFM.exSm, NLogN.IState.top_eq t3R, NLogN.IState.top_eq t3D, NLogN.IState.top_eq t3Q, NLogN.Ex.eval]
      constructorm* _ ∧ _; (all_goals
                              first
                              | assumption
                              | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                              | ((norm_num); (done))
                              | ((norm_num); (omega))
                              | omega
                              | positivity
                              |
                                ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                      first
                                      | ((norm_num); (done))
                                      | omega);
                                  (done)))) (hAB _ (by decide)))
  have hs1 : NLogN.KFM.DE.size + 10 = 15 := by decide
  have hs2 : NLogN.KFM.QE.size + 1 = 18 := by decide
  have hs3 : (NLogN.KFM.ME (.ndiv (.reg NLogN.KFM.zR) (.lit 2))).size + 1 = 21 := by decide
  have hs4 : (NLogN.KFM.ME (.reg NLogN.KFM.zR)).size + 1 = 19 := by decide
  rw [hs1] at c1; rw [hs2] at c2; rw [hs3] at c3; rw [hs4] at c4
  have e1 := NLogN.KFM.cfin D 15 (IntMul.OpenAI.Glue.bP n) (by nlinarith) (by norm_num)
  have e2 := NLogN.KFM.cfin 0 18 (IntMul.OpenAI.Glue.bP n) (by nlinarith) (by norm_num)
  have e3 := NLogN.KFM.cfin 0 21 (IntMul.OpenAI.Glue.bP n) (by nlinarith) (by norm_num)
  have e4 := NLogN.KFM.cfin 0 19 (IntMul.OpenAI.Glue.bP n) (by nlinarith) (by norm_num)
  rw [← hBn] at e1 e2 e3 e4
  rw [NLogN.KFM.setupC, NLogN.KFM.RS.cost_seq', NLogN.KFM.RS.cost_seq', NLogN.KFM.RS.cost_seq', NLogN.KFM.RS.cost_asg', NLogN.KFM.RS.cost_push',
    NLogN.KFM.RS.cost_push', r1, r2, r3]
  omega
end
