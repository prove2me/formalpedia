      (hcell D ((hS D).1 hD)).2.2 A, (hlawD D hD m₀ hm₀).2, mul_right_comm, ← div_eq_mul_inv,
      TypeDensity.projective_cell_conditional_density O htop n (TypeDensity.divisorVector k n D)
