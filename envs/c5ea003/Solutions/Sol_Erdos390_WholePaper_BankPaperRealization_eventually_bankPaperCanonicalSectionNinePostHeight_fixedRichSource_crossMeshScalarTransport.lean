          bankPaperCanonicalSectionNinePostHeightPhysicalIntervals
          (roughCanonicalBridgeRelevantLedgerFamily depth n)
          hsep₁ hremaining₁ := by
    simpa only [
      Bsource₁,
      bankPaperCanonicalSectionNineCoherentSourceBridge_sampleData] using
