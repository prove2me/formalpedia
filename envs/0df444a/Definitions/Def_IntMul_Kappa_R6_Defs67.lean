section
-- Source module: Solutions.J6SegAxis4
/-!
# B-line axis program (`AxisU6`), part 4: `AxisBody6` from the nine steps

The pass maps of axis `k` as functions of the pass input (`gY6`, `gJ6`, `gW6`, `gWp6`, `gO6`;
pass 1 is `arrS6`), so that the arrays of `J6SegAxisIface` are their compositions (`rfl`).

`AxStepsAt … k C`: the nine steps of axis `k` are `PassOK` / `Pass2OK` for these maps, the arrays
of every admissible input satisfy the step preconditions, and the step costs sum to `≤ C`.

**`axisBody6_of_steps`**: if procedure `eX` is `axProg st1 … st7` and the steps hold for every
`k ≤ D`, then `AxisBody6 P n src D Isym tbl eX dA (C + 2)`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

section maps
variable (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ)

/-- Passes 2, 6: the chunk kernel. -/
def gY6 (S : List GI) : List GI :=
  kerPass (axl6 P n) (axpost6 P n D k) (axpre6 P n D k * axnc6 P n k)
    (fun b => liftG (chunkK (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axα6 P n) (b % axnc6 P n k))) S

/-- Pass 3: the gather. -/
def gJ6 (Y : List GI) : List GI :=
  slabPass (axnc6 P n k * axl6 P n) (axG6 P n src k) (axpost6 P n D k)
    (jSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ z => z) Y

/-- Pass 4: the `J` kernel. -/
def gW6 (J : List GI) : List GI :=
  kerPass (axG6 P n src k) (axpost6 P n D k) (axpre6 P n D k)
    (fun _ => liftG (jKer (axQ6 P n src k) (axR6 P n) (axs6 src k) (axt6 P n k) (axl6 P n)
      (axw6 P n) (axα6 P n) (axw6 P n) (axG6 P n src k))) J

/-- Pass 5: the scatter. -/
def gWp6 (W : List GI) : List GI :=
  slabPass (axG6 P n src k) (axnc6 P n k * axl6 P n) (axpost6 P n D k)
    (scSrc (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)) (fun _ z => z) W

/-- Pass 7: the output slab. -/
def gO6 (Y Y₂ : List GI) : List GI :=
  slabPass (axnc6 P n k * axl6 P n) (axnc6 P n k * axl6 P n) (axpost6 P n D k) (fun l => some l)
    (outH (axp6 P n) (axQ6 P n src k) (axs6 src k) (axt6 P n k) (axα6 P n)) (List.zip Y Y₂)

end maps

/-- **The nine steps of axis `k`.** -/
def AxStepsAt {Pp : ℕ} (Isym : List Sym) (tbl : Fin Pp → IStmt HS Pp)
    (st1 st2 stc st3 st4 st5 st6 sts st7 : IStmt HS Pp) (dA : Fin HS)
    (P : Prm) (n : ℕ) (src : ℕ → ℕ) (D k : ℕ) (C : ℝ) : Prop :=
  ∃ (P1 P2 P3 P4 P5 P6 : List GI → Prop) (Pc Ps P7 : List GI → List GI → Prop)
    (C1 C2 Cc C3 C4 C5 C6 Cs C7 : ℝ),
    PassOK Isym tbl st1 dA (descAx6 P n src D k) P1 (arrS6 P n src D k) C1 ∧
    PassOK Isym tbl st2 dA (descAx6 P n src D k) P2 (gY6 P n src D k) C2 ∧
    Pass2OK Isym tbl stc dA (descAx6 P n src D k) Pc (fun A _ => (A, A)) Cc ∧
    PassOK Isym tbl st3 dA (descAx6 P n src D k) P3 (gJ6 P n src D k) C3 ∧
    PassOK Isym tbl st4 dA (descAx6 P n src D k) P4 (gW6 P n src D k) C4 ∧
    PassOK Isym tbl st5 dA (descAx6 P n src D k) P5 (gWp6 P n src D k) C5 ∧
    PassOK Isym tbl st6 dA (descAx6 P n src D k) P6 (gY6 P n src D k) C6 ∧
    Pass2OK Isym tbl sts dA (descAx6 P n src D k) Ps (fun A B => (B, A)) Cs ∧
    Pass2OK Isym tbl st7 dA (descAx6 P n src D k) P7 (fun A B => (gO6 P n src D k A B, [])) C7 ∧
    (∀ L : List GI, L.length = (List.ofFn (tD6 P n D)).prod → GB (pP6 P n + 2) L →
      P1 L ∧ P2 (arrS6 P n src D k L) ∧ Pc (arrY6 P n src D k L) [] ∧
      P3 (arrY6 P n src D k L) ∧ P4 (arrJ6 P n src D k L) ∧ P5 (arrW6 P n src D k L) ∧
      P6 (arrWp6 P n src D k L) ∧ Ps (arrY26 P n src D k L) (arrY6 P n src D k L) ∧
      P7 (arrY6 P n src D k L) (arrY26 P n src D k L)) ∧
    C1 + C2 + Cc + C3 + C4 + C5 + C6 + Cs + C7 ≤ C

end J6Seg.Ax

end

end

