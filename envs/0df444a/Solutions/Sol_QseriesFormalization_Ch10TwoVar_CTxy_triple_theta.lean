      · rw [if_pos ⟨h.1, by omega, by omega⟩, if_pos h]
      · rw [if_neg (fun hc => h ⟨hc.1, by omega⟩), if_neg h]
    · intro m hm
      rw [if_neg (by rintro ⟨_, _, hmk⟩; exact hm (by omega))]
