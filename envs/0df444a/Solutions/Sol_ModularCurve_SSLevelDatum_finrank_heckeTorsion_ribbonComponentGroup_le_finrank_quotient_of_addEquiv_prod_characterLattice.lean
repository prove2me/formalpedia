    intro x
    have h : (LinearMap.quotKerEquivOfSurjective Q.δ₀ hs).symm (Q.δ₀ x) = Submodule.Quotient.mk x := by
      rw [LinearEquiv.symm_apply_eq]
      rfl
    show ((LinearMap.ker Q.δ₀).liftQ _ hker) ((LinearMap.quotKerEquivOfSurjective Q.δ₀ hs).symm (Q.δ₀ x)) = _
    rw [h]
    rfl
  refine ⟨(id (l' ∘ₗ Q.αinv) : Q.Xd), ?_⟩
  refine LinearMap.ext fun x => ?_
  show l' (Q.αinv (Q.αadj (Q.δ₀ x))) = (id l : Module.Dual ℤ ↥(characterLattice E)) x
  rw [αinv_αadj, hl']

theorem eq_zero_of_widthPairing_self {ι : Type} [Fintype ι] (w : ι → ℕ) (hw : ∀ i, 0 < w i) (x : ι → ℤ)
    (h : widthPairing w x x = 0) : x = 0 := by
  rw [widthPairing_apply] at h
  have hnn : ∀ i ∈ Finset.univ, 0 ≤ (w i : ℤ) * (x i * x i) :=
    fun i _ => mul_nonneg (by exact_mod_cast (hw i).le) (mul_self_nonneg (x i))
  have hz := (Finset.sum_eq_zero_iff_of_nonneg hnn).1 h
  funext i
  have hi := hz i (Finset.mem_univ i)
  have hw' : (w i : ℤ) ≠ 0 := by exact_mod_cast (hw i).ne'
  have := (mul_eq_zero.1 hi).resolve_left hw'
  exact mul_self_eq_zero.1 this

theorem hgL : Function.Injective Q.gL := by
  intro x y hxy
  have h : Q.gL (x - y) = 0 := by rw [map_sub, hxy, sub_self]
  have h2 : widthPairing (fun e => (Q.D.w e : ℕ)) (x - y).1 (x - y).1 = 0 := by
    have := LinearMap.congr_fun h (x - y)
    exact this
  have h3 := eq_zero_of_widthPairing_self (fun e => (Q.D.w e : ℕ)) (fun e => (Q.D.w e).pos) _ h2
  have h4 : x - y = 0 := Subtype.ext h3
  exact sub_eq_zero.1 h4

theorem hsq (x : Q.Xp) : Q.gL (Q.σ x) = Q.κd (Q.gX x) := by
  refine LinearMap.ext fun y => ?_
  show widthPairing (fun e => (Q.D.w e : ℕ)) (Q.σ₀ x).1 y.1 = Q.gX₀ x (Q.αadj (Q.δ₀ y))
  rw [gX₀_apply]
  show widthPairing (fun e => (Q.D.w e : ℕ)) (Q.padj 0 (-x.1.1) + Q.padj 1 ((Q.TV Q.s).mulVec x.1.1 - x.2.1)) y.1 =
    widthPairing Q.wV x.1.1 (-((degeneracyMatrix Q.D.a).mulVec y.1) + (Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1)) +
    widthPairing Q.wV x.2.1 (-((degeneracyMatrix Q.D.b).mulVec y.1))
  have e1 : widthPairing (fun e => (Q.D.w e : ℕ)) (Q.padj 0 (-x.1.1) + Q.padj 1 ((Q.TV Q.s).mulVec x.1.1 - x.2.1)) y.1 =
      widthPairing (fun e => (Q.D.w e : ℕ)) y.1 (Q.padj 0 (-x.1.1)) +
        widthPairing (fun e => (Q.D.w e : ℕ)) y.1 (Q.padj 1 ((Q.TV Q.s).mulVec x.1.1 - x.2.1)) := by
    rw [widthPairing_comm, map_add]
  have e2 : widthPairing (fun e => (Q.D.w e : ℕ)) y.1 (Q.padj 0 (-x.1.1)) =
      -widthPairing Q.wV x.1.1 ((degeneracyMatrix Q.D.a).mulVec y.1) := by
    rw [Q.hadj0, map_neg, widthPairing_comm]
  have e3 : widthPairing (fun e => (Q.D.w e : ℕ)) y.1 (Q.padj 1 ((Q.TV Q.s).mulVec x.1.1 - x.2.1)) =
      widthPairing Q.wV x.1.1 ((Q.adjV Q.s).mulVec ((degeneracyMatrix Q.D.b).mulVec y.1)) -
        widthPairing Q.wV x.2.1 ((degeneracyMatrix Q.D.b).mulVec y.1) := by
    rw [Q.hadj1, map_sub, widthPairing_comm Q.wV _ ((Q.TV Q.s).mulVec _), Q.adjV_law,
      widthPairing_comm Q.wV _ x.2.1]
  rw [e1, e2, e3, map_add, map_neg, map_neg]
  abel

