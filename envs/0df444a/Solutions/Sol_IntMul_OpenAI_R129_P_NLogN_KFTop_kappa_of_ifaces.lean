    intro i1 i2
    exact @H Isym n hn hn₁ i1 i2
  have key : ∀ d, IntMul.OpenAI.R129.dP n = d → lineG Isym ext eA eB dS C₀ A n d := by
    rintro d rfl; exact @h0
  exact @key _ hD

