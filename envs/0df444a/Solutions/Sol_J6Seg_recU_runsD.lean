    simp only [reN, List.map_map, imF]
    rw [List.getD_eq_getElem _ _ (by simpa using hh'), List.getD_eq_getElem _ _ hh']
    simp only [List.getElem_map, Function.comp, offG, Prod.fst_swap]
    exact Int.toNat_of_nonneg (hc _ (List.getElem_mem hh'))
