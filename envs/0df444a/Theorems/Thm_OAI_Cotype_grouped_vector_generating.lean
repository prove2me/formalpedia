open OAI OAI.Cotype
open scoped BigOperators
open Polynomial
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {m : ℕ}

theorem OAI.Cotype.grouped_vector_generating (g : Cube m → ℝ) (x : ℝ) :
    (∑ l ∈ Finset.range (m+1), levelFourier g l * x^l) =
      biasedExpectation g (fun _ => x) := by sorry
