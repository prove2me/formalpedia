-- Source module: Solutions.R6CxStep
/-!
# Round six, complex side: networks with slot-set children and temporaries (`Prop8IfaceH`)

Design decision 2 of `jain6/ARCH.md`. Compared with `P8Lift.Prop8IfaceR`:

* a child step `child w S neg` acts on a **slot set** `S ⊆ Fin m` of role `w` (all columns),
  with a **sign set** `neg`: with exact children it applies `C⁻¹` on the slots of `neg ∩ S`
  and `C` on the other slots of `S` (implemented as `(-i)^{|neg ∩ S||κ|} Z_N C^{⊗(S×κ)} Z_N`,
  one forward call of width `|S|`, by (17));
* roles are `Fin W ⊕ Fin T`: `W` data/scratch roles and `T` temporaries;
* correctness (**clean temporaries**): temporaries start at zero and are discarded, so only the
  data-to-data block of the denotation is constrained: it is block diagonal with `C^{⊗(Fin m × κ)}`
  on every role `inl _` (`DataCorrect`). This is Jain's tape model (a copy is a fresh zero
  stream, erased after use); `targetH` (dirty temporaries restored) implies it (`dataCorrect_of_targetH`);
* `hist`: the multiset of child widths `|S|` is `histMS h` (`n_w` children of width `w`),
  and every child width is `< m`.

Local steps are those of `P8Lift.RStep` (gates, row additions, phases, role permutations).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift

lemma histMS_cons (p : ℕ × ℕ) (h : List (ℕ × ℕ)) :
    histMS (p :: h) = Multiset.replicate p.2 p.1 + histMS h := by
  simp [histMS]

/-- Sum of `g` over the multiset `histMS h` is `∑ n_w g(w)`. -/
lemma histMS_sum_map {M : Type*} [AddCommMonoid M] (h : List (ℕ × ℕ)) (g : ℕ → M) :
    ((histMS h).map g).sum = (h.map fun p => p.2 • g p.1).sum := by
  induction h with
  | nil => simp
  | cons p h ih =>
    rw [histMS_cons, Multiset.map_add, Multiset.sum_add, ih, List.map_cons, List.sum_cons,
      Multiset.map_replicate, Multiset.sum_replicate]

