/-- Formal smoothness of a fraction field spreads to a nonempty principal open. -/
lemma exists_smooth_principal_open_of_formallySmooth_fractionField
    (R A F : Type u) [CommRing R] [CommRing A] [IsDomain A] [Field F]
    [Algebra R A] [Algebra A F] [Algebra R F] [IsScalarTower R A F]
    [IsFractionRing A F] [Algebra.FinitePresentation R A] [Algebra.FormallySmooth R F] :
    ∃ a : A, a ≠ 0 ∧ Algebra.Smooth R (Localization.Away a) := by
  let p : Ideal A := ⊥
  letI : p.IsPrime := by dsimp only [p]; infer_instance
  let L := Localization.AtPrime p
  letI : IsFractionRing A L := by
    simpa only [p, Ideal.primeCompl_bot] using
      (Localization.isLocalization (M := (⊥ : Ideal A).primeCompl))
  let e : F ≃ₐ[R] L :=
    (IsLocalization.algEquiv (nonZeroDivisors A) F L).restrictScalars R
  letI : Algebra.FormallySmooth R L := Algebra.FormallySmooth.of_equiv e
  letI : Algebra.IsSmoothAt R p := inferInstanceAs (Algebra.FormallySmooth R L)
  obtain ⟨a, ha, hs⟩ := Algebra.IsSmoothAt.exists_notMem_smooth (R := R) (A := A) p
  exact ⟨a, by simpa only [p, Ideal.mem_bot] using ha, hs⟩

end PhilipponAlterationProjection



