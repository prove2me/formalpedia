open TypeDensity
open scoped BigOperators ENNReal
open MeasureTheory Polynomial
variable {K : Type} [Field K]

theorem solution (f : K[X]) (n : ℕ) (hn : f.natDegree = n) (hf : f ≠ 0)
    (h : resultant f (derivative f) n (n - 1) ≠ 0) : f.Separable := by
  rw [TypeDensity.resultant_deriv_eq f n hn] at h
  have h2 : resultant f (derivative f) ≠ 0 := right_ne_zero_of_mul h
  rw [Ne, resultant_eq_zero_iff] at h2
  push Not at h2
  exact h2 (Or.inl hf)
