    NLogN.mvK, tgtR, othR, RS.writes, segBody]
  simp +decide

/-- **Pass 1.** -/
theorem p1_fsp {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) {Bb : ℕ} (hB2 : 2 ≤ Bb) (hbig : 4 * g.V < 2 ^ Bb)
    (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B) (hbits : ∀ m, Bnd 1 (recs m))
    (s : IState HS) (G0 : Fin HS → List ℤ) (hC : G0 rC = []) (hc1 : G0 NLogN.KFL.c1 = []) :
    FSp (p1Prog K ρ f g) (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 0))
      (NLogN.KIL.encK s (NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 g.recG.V))
      (cLp g.recG.V (cP1 K f g.B Bb) Bb) := by
  have hMV := recG_V_le g hg
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  push_cast at hb4
  refine FSp.repLit (F := fun k => NLogN.KFL.P1 (keyR K ρ f g) recs g.recG.V G0 k) (by decide)
    (fun k => by simp +decide [NLogN.KFL.P1, Function.update_apply, hc1]) (c1_notin K ρ f g)
    (zsz_of_le hb4 (by rw [abs_of_nonneg (by positivity)]; push_cast; omega)) ?_
  intro k hk
  rw [P1_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide), P1_upd _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide)]
  exact p1B_fsp hK hρK hf hg hQe hB2 hbig recs hlen hbits s _
    (by rw [upd_ne (by decide)]; exact hC) hk

end NLogN.KFL

