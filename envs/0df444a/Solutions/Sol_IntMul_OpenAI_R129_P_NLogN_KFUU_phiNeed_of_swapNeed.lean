/-- The real cost absorption, for either direction (`V' ≤ V_T`, `c + (d+1) ≤ natCost + (d+1)·q`
with `q = ⌈cSwV K w h V'⌉`). -/
theorem absorb (K : ℝ) (hK : 0 ≤ K) (w h d : ℕ) (bL : ℕ → Bool) (sF : ℕ → ℕ) (hh : 1 ≤ h)
    (hs : ∀ j < d, 1 ≤ sF j) (hst : ∀ j < d, sF j ≤ 2 ^ (h + if bL j then 1 else 0))
    (V' : ℕ) (hV' : V' ≤ vol (NLogN.KFU.shR d (tP d h bL))) (c : ℕ)
    (hc : c + (d + 1) ≤ natCost w d (vol (NLogN.KFU.shR d (tP d h bL))) (vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)))
        (vol ((List.range (d - 1)).map sF))
        (w + h + 3 * d + zsz ((vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) : ℕ) : ℤ) + 3)
        (zsz ((vol (NLogN.KFU.shR d (tP d h bL)) : ℕ) : ℤ) + w + h + 3)
        (zsz ((2 * vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) : ℕ) : ℤ) + d) (zsz ((2 * vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) : ℕ) : ℤ)) +
      (d + 1) * ⌈cSwV K w h (V' * 1)⌉₊) :
    (c : ℝ) ≤ ((C1 : ℝ) + 781 * K) * IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF := by
  set VT := vol (NLogN.KFU.shR d (tP d h bL)) with hVT
  set VS := vol (NLogN.KFU.shR d (NLogN.KFU.sP d sF)) with hVS
  set PM := vol ((List.range (d - 1)).map sF) with hPM
  set Bb := zsz ((2 * VS : ℕ) : ℤ) with hBb
  have hd := VT_ge d h bL hh
  have hST : VS ≤ VT := VS_le_VT d h bL sF hst
  obtain ⟨hP1, hPS⟩ := PM_le d sF hs
  have hS2 : 2 ≤ VS := by
    have := Pv_pos sF hs d le_rfl
    rw [hVS, VS_eq]; omega
  have hd0 : d = 0 → PM = 1 := by intro h0; subst h0; simp [hPM, vol]
  have N1 := natCost_le w h d VT VS PM hd hST hS2 hP1 hPS hd0
  have N2 := swq_le w h d VT VS V' hd hST hV'
  set T := (d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2 + d * cRb d w VS PM Bb
    with hT
  -- cPhiU ≥ T and ≥ the K term
  have hτ : 0 ≤ (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS := Real.rpow_nonneg (Nat.cast_nonneg _) _
  have hX0 : 0 ≤ ((w : ℝ) + 1) * ((VT : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS := by positivity
  have hM0 : (0 : ℝ) ≤ (KFU.cMv VT w : ℝ) := Nat.cast_nonneg _
  have hmid := nn_mid d w VT _ hτ
  have hmid2 := nn_mid2 d w VT _ hτ
  have hsw0 : 0 ≤ cSwV K w h (V' * 1) := cSwV_nonneg K hK w h _
  have hPhi : IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF = 3 * (((d + 1) * cScan VT w + 1 : ℕ) : ℝ) +
      3 * ((d : ℝ) + 1) * (KFU.cMv VT w + 1 + 1 * ((w : ℝ) + 1) * ((VT : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS) +
      ((d * cRb d w VS PM Bb + 1 : ℕ) : ℝ) +
      (((d + 1) * (h + w + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) := by
    unfold IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU cPhi; rfl
  have c1 : (0 : ℝ) ≤ (((d + 1) * cScan VT w : ℕ) : ℝ) := Nat.cast_nonneg _
  have c2 : (0 : ℝ) ≤ (((d + 1) * (h + w + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) := Nat.cast_nonneg _
  have c3 : (0 : ℝ) ≤ ((d * cRb d w VS PM Bb : ℕ) : ℝ) := Nat.cast_nonneg _
  have eT : (T : ℝ) = (((d + 1) * cScan VT w : ℕ) : ℝ) +
      (((d + 1) * (h + w + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) + ((d * cRb d w VS PM Bb : ℕ) : ℝ) := by
    rw [hT, Nat.cast_add, Nat.cast_add]
  have hPhi' : IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF = 3 * ((((d + 1) * cScan VT w : ℕ) : ℝ) + 1) +
      3 * ((d : ℝ) + 1) *
        ((KFU.cMv VT w : ℝ) + 1 + 1 * ((w : ℝ) + 1) * ((VT : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS) +
      (((d * cRb d w VS PM Bb : ℕ) : ℝ) + 1) +
      (((d + 1) * (h + w + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) := by
    rw [hPhi, Nat.cast_add, Nat.cast_one, Nat.cast_add (d * cRb d w VS PM Bb), Nat.cast_one]
  have hTle : (T : ℝ) ≤ IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF := by
    rw [hPhi', eT]; linarith
  have hKle : ((d : ℝ) + 1) * ((w : ℝ) + 1) * ((VT : ℝ) + 1) * (h : ℝ) ^ IntMul.OpenAI.R129.P.NLogN.KFS.τS ≤
      IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF := by
    rw [hPhi']; linarith
  have hQ : (((d + 1) * (h + w + Nat.size VS + 1) ^ 2 : ℕ) : ℝ) +
      (((d + 1) * cScan VT w : ℕ) : ℝ) ≤ IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF := by
    rw [eT] at hTle; linarith
  have hcPos : 0 ≤ IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF := le_trans (Nat.cast_nonneg _) hTle
  clear hPhi hPhi'
  -- the ceiling
  have hq : (⌈cSwV K w h (V' * 1)⌉₊ : ℝ) < cSwV K w h (V' * 1) + 1 := Nat.ceil_lt_add_one hsw0
  have hc' : (c : ℝ) + ((d : ℝ) + 1) ≤ (C1 : ℝ) * T + ((d : ℝ) + 1) * ⌈cSwV K w h (V' * 1)⌉₊ := by
    have := le_trans hc (Nat.add_le_add_right N1 _)
    exact_mod_cast this
  have N2' : (d + 1) * ((5 + 1) * (Nat.size (V' * 1) + w + h + 1) ^ 2) ≤
      780 * ((d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2) := by
    rw [mul_one]
    calc (d + 1) * ((5 + 1) * (Nat.size V' + w + h + 1) ^ 2)
        = 6 * ((d + 1) * (Nat.size V' + w + h + 1) ^ 2) := by ring
      _ ≤ 6 * (130 * ((d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2)) :=
          Nat.mul_le_mul_left 6 N2
      _ = 780 * ((d + 1) * cScan VT w + (d + 1) * (h + w + Nat.size VS + 1) ^ 2) := by ring
  have hsw := swap_part K hK w h d V' VT (IntMul.OpenAI.R129.P.NLogN.KFM.cPhiU w h d bL sF) ((d + 1) * cScan VT w)
    ((d + 1) * (h + w + Nat.size VS + 1) ^ 2) hV' hKle hQ N2'
  exact absorb_alg (c : ℝ) ((d : ℝ) + 1) (C1 : ℝ) (T : ℝ) _ _ _ K hc' hq (cast_succ_nonneg d)
    (Nat.cast_nonneg _) hTle hsw

end IntMul.OpenAI.R129.P.NLogN.KFUU
