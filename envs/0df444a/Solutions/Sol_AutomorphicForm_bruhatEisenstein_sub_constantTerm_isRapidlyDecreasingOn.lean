variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private theorem exists_chart_angles (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) {m : ℝ} (hm : 0 < m)
    (hm' : m < 1 / 2) {a b η : ℝ} (hη : 0 < η) (hab : a ≤ b)
    (hguard : ∀ u ∈ Set.Icc (a - η) (b + η), 1 / 2 - m ≤ lineQSq g z₀ θ u) :
    ∃ μf ψf δf : ℝ → ℝ, ContDiff ℝ ∞ μf ∧ ContDiff ℝ ∞ ψf ∧ ContDiff ℝ ∞ δf ∧
      (∀ t ∈ Set.Icc a b,
        kC g (z₀ + t * Complex.exp (θ * Complex.I))
          = dPhiMat (μf t / 2)
            * ((rotGLC (ψf t / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
            * dPhiMat (δf t)
            * ((rotGLC (ψf t / 2 + Real.pi / 2) : GL (Fin 2) ℂ) : Matrix (Fin 2) (Fin 2) ℂ)
            * dPhiMat (μf t / 2))
      ∧ (∀ k t, |iteratedDeriv (k + 1) μf t|
          ≤ (k ! : ℝ) * (Real.sqrt (normSq (Complex.exp (θ * Complex.I) * g 1 1))
              / ‖botQ g z₀ + t * (Complex.exp (θ * Complex.I) * g 1 1)‖) ^ (k + 1))
      ∧ (∀ u ∈ Set.Icc (a - η) (b + η),
          Complex.exp ((μf u : ℂ) * Complex.I) * lineQhat g z₀ θ u
            = (‖lineQhat g z₀ θ u‖ : ℂ))
      ∧ δf = (fun t => -Real.arcsin ((linePhat g z₀ θ (chartClamp a b η t)).im))
      ∧ (∀ t, Real.cos (ψf t)
          = (linePhat g z₀ θ (chartClamp a b η t)).re / Real.cos (δf t))
      ∧ (∀ t, Real.sin (ψf t)
          = -Real.sqrt (lineQSq g z₀ θ (chartClamp a b η t)) / Real.cos (δf t)) := by
  have hWconv : Convex ℝ (Set.Icc (a - η) (b + η)) := convex_Icc _ _
  have hclmem : ∀ t, chartClamp a b η t ∈ Set.Icc (a - η) (b + η) :=
    chartClamp_mem hη hab
  have hclid : ∀ t ∈ Set.Icc a b, chartClamp a b η t = t := fun t ht =>
    chartClamp_of_mem hη ht

  have hQpos : ∀ u ∈ Set.Icc (a - η) (b + η), 0 < lineQSq g z₀ θ u := fun u hu =>
    lt_of_lt_of_le (by linarith) (hguard u hu)
  have hQne : ∀ u ∈ Set.Icc (a - η) (b + η),
      botQ g (z₀ + u * Complex.exp (θ * Complex.I)) ≠ 0 := by
    intro u hu h0
    have hp := hQpos u hu
    rw [lineQSq, lineQhat, h0, zero_div, normSq_zero] at hp
    exact lt_irrefl 0 hp

  obtain ⟨μf, hμs, hμprop, hμtow⟩ := exists_smooth_arg_branch (botQ g z₀)
    (Complex.exp (θ * Complex.I) * g 1 1) hWconv (by
      intro u hu
      have hne := hQne u hu
      rw [botQ_line] at hne
      exact hne)
  have hμQ : ∀ u ∈ Set.Icc (a - η) (b + η),
      Complex.exp ((μf u : ℂ) * Complex.I) * lineQhat g z₀ θ u
        = (‖lineQhat g z₀ θ u‖ : ℂ) := by
    intro u hu
    have h1 := hμprop u hu
    have hrpos := radC_line_pos hg z₀ θ u
    rw [lineQhat, botQ_line, ← mul_div_assoc, h1, norm_div, Complex.ofReal_div]
    congr 1
    have hnr : ‖((radC g (z₀ + (u : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) : ℝ) : ℂ)‖
        = radC g (z₀ + (u : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) := by
      simp [abs_of_pos hrpos]
    rw [hnr]

  have hPim : ContDiff ℝ ∞ fun t => (linePhat g z₀ θ (chartClamp a b η t)).im :=
    Complex.imCLM.contDiff.comp ((contDiff_linePhat hg z₀ θ).comp (contDiff_chartClamp a b η))
  have hPbound : ∀ t, (linePhat g z₀ θ (chartClamp a b η t)).im ^ 2 ≤ 1 / 2 + m := by
    intro t
    have hrow := normSq_linePhat_add_lineQSq hg z₀ θ (chartClamp a b η t)
    have hql := hguard _ (hclmem t)
    have hns : (linePhat g z₀ θ (chartClamp a b η t)).im ^ 2
        ≤ normSq (linePhat g z₀ θ (chartClamp a b η t)) := by
