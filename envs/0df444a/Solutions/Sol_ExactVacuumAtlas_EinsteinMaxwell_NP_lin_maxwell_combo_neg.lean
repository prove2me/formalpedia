theorem eq_of_hasDerivAt_slice {W : Set (ℝ × Pt 4)} (hW : IsOpen W) {x : Pt 4} (hx : ((0 : ℝ), x) ∈ W)
    {φ ψ : ℝ → ℂ} {L L' : ℂ} (hφ : HasDerivAt φ L 0) (hψ : HasDerivAt ψ L' 0)
