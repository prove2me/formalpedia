local notation "L" i => MvPowerSeries.coeff (Finsupp.single i 1)
local notation "cc" => MvPowerSeries.constantCoeff

theorem Formalism.L2.Th1.A.Fgl2.inv_map {R : Type u} {S : Type v} [CommRing R] [CommRing S] (φ : R →+* S)
    (W : WeierstrassCurve R) :
    PowerSeries.map φ (MvPowerSeries.subst (![X, iSer W] : Fin 2 → R⟦X⟧) (fgl W))
      = MvPowerSeries.subst (![X, iSer (W.map φ)] : Fin 2 → S⟦X⟧) (fgl (W.map φ)) := by sorry
