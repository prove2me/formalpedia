private theorem integral_comp_levelTorusMap_add (a₀ : 𝔸) {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    (G : UnitAddTorus (LevelIndex F 𝔫 h𝔫) → E') :
    ∫ t, G (levelTorusMap 𝔫 h𝔫 t + levelTorusMap 𝔫 h𝔫 a₀) ∂(boxMeasure F) = ∫ t, G (levelTorusMap 𝔫 h𝔫 t) ∂(boxMeasure F) := by
  set f : 𝔸 → E' := fun t => G (levelTorusMap 𝔫 h𝔫 t) with hf
  have hshift : (fun t => G (levelTorusMap 𝔫 h𝔫 t + levelTorusMap 𝔫 h𝔫 a₀)) = fun t => f (a₀ + t) := by
    funext t; simp only [hf, map_add, add_comm]
  rw [hshift]
  simp only [boxMeasure, ProbabilityTheory.cond, integral_smul_measure]
  congr 1
  calc ∫ t in adelicBox F, f (a₀ + t) ∂adelicAddHaar (𝓞 F) F
      = ∫ t in S F a₀, f t ∂adelicAddHaar (𝓞 F) F := setIntegral_box_comp_add f a₀
    _ = ∫ t in S F 0, f t ∂adelicAddHaar (𝓞 F) F :=
        (isAddFundamentalDomain_S F a₀).setIntegral_eq (isAddFundamentalDomain_S F 0) fun k t => by
          show f (ι k + t) = f t
          simp only [hf, levelTorusMap_algebraMap_add]
    _ = ∫ t in adelicBox F, f t ∂adelicAddHaar (𝓞 F) F := by rw [S_zero]

private theorem map_levelTorusMap_boxMeasure :
    Measure.map (levelTorusMap 𝔫 h𝔫) (boxMeasure F) = torusMeasure (LevelIndex F 𝔫 h𝔫) :=
  map_eq_torusMeasure (measurable_levelTorusMap 𝔫 h𝔫).aemeasurable
    (isAddLeftInvariant_map_of_forall_integral (measurable_levelTorusMap 𝔫 h𝔫).aemeasurable (levelTorusMap_surjective 𝔫 h𝔫)
      fun a₀ G => integral_comp_levelTorusMap_add 𝔫 h𝔫 a₀ G)

private theorem integral_comp_levelTorusMap_eq_integral_torus {E' : Type*} [NormedAddCommGroup E'] [NormedSpace ℝ E']
    {G : UnitAddTorus (LevelIndex F 𝔫 h𝔫) → E'} (hG : Continuous G) :
    ∫ t, G (levelTorusMap 𝔫 h𝔫 t) ∂(boxMeasure F) = ∫ θ, G θ ∂(torusMeasure (LevelIndex F 𝔫 h𝔫)) := by
  rw [← map_levelTorusMap_boxMeasure 𝔫 h𝔫, integral_map (measurable_levelTorusMap 𝔫 h𝔫).aemeasurable hG.aestronglyMeasurable]

private theorem measure_leg :
    ∀ (h : AdeleRing (𝓞 F) F → ℂ),
      (∀ (k : F) (t : AdeleRing (𝓞 F) F), h (algebraMap F (AdeleRing (𝓞 F) F) k + t) = h t) →
      (∀ n ∈ 𝔫, ∀ o ∈ NumberField.AdelicBox.integralFiniteAdeles (𝓞 F) F, ∀ t : AdeleRing (𝓞 F) F,
        h (t + mkAdele F 0 (algebraMap F (IsDedekindDomain.FiniteAdeleRing (𝓞 F) F) ((n : 𝓞 F) : F) * o)) = h t) →
      Continuous h →
      ∫ t, h t ∂(@ProbabilityTheory.cond _ (NumberField.AdelicHaar.adeleBorel (𝓞 F) F)
          (NumberField.AdelicHaar.adelicAddHaar (𝓞 F) F) (adelicBox F))
        = UnitAddTorus.mFourierCoeff
            (torusLift (adelicTorusMap F 𝔫 h𝔫) (adelicTorusMap_surjective F 𝔫 h𝔫) (archRestrict h)) 0 := by
  intro h hF hU hc
  show ∫ t, h t ∂(boxMeasure F) = _
  have hper : IsKerPeriodic (adelicTorusMap F 𝔫 h𝔫) (archRestrict h) := isKerPeriodic_archRestrict (h𝔫 := h𝔫) hF hU
  have hG : Continuous (torusLift (adelicTorusMap F 𝔫 h𝔫) (adelicTorusMap_surjective F 𝔫 h𝔫) (archRestrict h)) :=
    continuous_torusLift (isOpenQuotientMap_adelicTorusMap F 𝔫 h𝔫) hper (continuous_archRestrict hc)
  rw [mFourierCoeff_zero, ← integral_comp_levelTorusMap_eq_integral_torus 𝔫 h𝔫 hG]
  exact integral_congr_ae (ae_of_all _ fun t => apply_eq_torusLift_levelTorusMap 𝔫 h𝔫 hF hU t)

end MeasureLeg
