theorem QFS.renormalization_apex_shrink {ϑ : ℝ} (hϑ : 0 < ϑ) (hϑ' : ϑ ≤ π / 2)
    {v : EuclideanSpace ℝ (Fin d)} (hv : ‖v‖ = 1) {ℓ : ℝ} (hℓ : 0 < ℓ)
    {x y : EuclideanSpace ℝ (Fin d)}
    (hdist : apexShrinkConst d ϑ * ℓ ≤ ‖x - y‖) (hy : y ∈ shift (cone v (ϑ / 2)) x) :
