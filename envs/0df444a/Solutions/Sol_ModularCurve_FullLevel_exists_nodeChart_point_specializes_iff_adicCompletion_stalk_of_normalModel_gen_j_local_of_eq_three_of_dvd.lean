theorem vs_inv_mem_of_isUnit {K : Type*} [Field K] (V : ValuationSubring K) (x : K) (hx : x ∈ V)
    (hu : IsUnit (⟨x, hx⟩ : ↥V)) : x⁻¹ ∈ V := by
  have h1 : (⟨x, hx⟩ : ↥V) ∉ maximalIdeal ↥V := fun h => (mem_maximalIdeal _).mp h hu
  rw [← ValuationSubring.coe_mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or] at h1
  push Not at h1
  exact h1.2

theorem vs_isUnit_of_inv_mem {K : Type*} [Field K] (V : ValuationSubring K) (x : K) (hx : x ∈ V)
    (hx0 : x ≠ 0) (hinv : x⁻¹ ∈ V) : IsUnit (⟨x, hx⟩ : ↥V) :=
  ⟨⟨⟨x, hx⟩, ⟨x⁻¹, hinv⟩, Subtype.ext (mul_inv_cancel₀ hx0), Subtype.ext (inv_mul_cancel₀ hx0)⟩, rfl⟩

theorem vs_mem_maximalIdeal_iff {K : Type*} [Field K] (V : ValuationSubring K) (x : K) (hx : x ∈ V) :
    (⟨x, hx⟩ : ↥V) ∈ maximalIdeal ↥V ↔ x = 0 ∨ x⁻¹ ∉ V := by
  rw [← ValuationSubring.coe_mem_nonunits_iff, ValuationSubring.mem_nonunits_iff_or]

theorem vs_eq_of_le_of_nonunits {K : Type*} [Field K] (V₁ V₂ : ValuationSubring K) (hle : V₁ ≤ V₂)
    (hdom : ∀ x : K, x ∈ V₁.nonunits → x ∈ V₂.nonunits) : V₁ = V₂ :=
  le_antisymm hle (ValuationSubring.nonunits_le_nonunits.mp hdom)

theorem vs_eq_of_le_of_maximalIdeal {K : Type*} [Field K] (V₁ V₂ : ValuationSubring K) (hle : V₁ ≤ V₂)
    (hdom : ∀ (x : K) (h₁ : x ∈ V₁), (⟨x, h₁⟩ : ↥V₁) ∈ maximalIdeal ↥V₁ → (⟨x, hle h₁⟩ : ↥V₂) ∈ maximalIdeal ↥V₂) :
    V₁ = V₂ := by
  refine vs_eq_of_le_of_nonunits V₁ V₂ hle fun x hx => ?_
  have h₁ : x ∈ V₁ := ValuationSubring.nonunits_le hx
  have h2 := hdom x h₁ ((ValuationSubring.coe_mem_nonunits_iff (a := (⟨x, h₁⟩ : ↥V₁))).mp hx)
  exact (ValuationSubring.coe_mem_nonunits_iff (a := (⟨x, hle h₁⟩ : ↥V₂))).mpr h2

