variable {E : ℕ} {I : List Sym} {iprog : Fin (7 + E) → IStmt HS (7 + E)}

theorem M_runsG_sol_aux (j : Fin (7 + E)) (d18 : Fin HS) (hd0 : d18 ≠ 0)
    {p h d σ K B : ℕ} (hB : RB p h d σ K B) (hM : MG p h d σ K)
    (Bd : ℕ) (hBd : ∀ x ∈ dsG p h d σ K, zsz x ≤ Bd)
    (s : IState HS) (G : Fin HS → List ℤ) (hR : Regs G p h d σ K) (ZF ZG : List GI) (l : List ℤ)
    (h0 : G 0 = gflat ZF ++ gflat ZG ++ l) (hX : G (X18 d18) = [])
    (zh : List GI) (c : ℕ)
    (hcall : IRuns I iprog (.call j)
      (encK (bgS s G d18 l) (fC d18 (gflat ZF ++ gflat ZG ++ []) (dsG p h d σ K)))
      (encK (bgS s G d18 l) (Function.update (fC d18 (gflat ZF ++ gflat ZG ++ [])
        (dsG p h d σ K)) 0 (gflat zh ++ []))) c) :
    IRuns I iprog (Mcall j d18) (encK s G) (encK s (Function.update G 0 (gflat zh ++ l)))
      (c + cM B Bd (p / 6) (dsG p h d σ K).length) := by
  set X := X18 d18 with hXd
  set Y := Y18 d18 with hYd
  set DD := dsG p h d σ K with hDD
  have hXY : X ≠ Y := X18_ne_Y18 d18
  have hXD : X ≠ d18 := X18_ne d18
  have hYD : Y ≠ d18 := Y18_ne d18
  have hXr : X ∉ regL := by
    rcases X18_mem d18 with e | e <;> rw [hXd, e] <;> decide
  -- mark
  set s1 := s.upd X (.mark :: s.G X) with hs1
  have k1 : IRuns I iprog (.op (.mark X)) (encK s G) (encK s1 G) 1 := by
    refine (IRuns.mark (I := I) (iprog := iprog) (s := encK s G) X).mono' ?_ le_rfl
    refine IState.ext' (fun i => ?_) rfl rfl
    by_cases e : i = X
    · subst e; simp [hs1, hX]
    · simp [hs1, e]
  -- the register program
  set vs : List (Fin HS × ℤ) := [(zD, (d : ℤ)), (zDp, ((d - σ : ℕ) : ℤ)), (zR, 2 ^ (h + 1)),
      (zK, (K : ℤ)), (zEl, ((h + 1 : ℕ) : ℤ)), (zB, ((p / 6 : ℕ) : ℤ))] with hvs
  obtain ⟨q1, -⟩ := hR.s18 (s := s1) hB
  have hR' : Regs (Function.update G X DD) p h d σ K := hR.upd X hXr DD
  obtain ⟨-, q3⟩ := hR'.s18 (s := s1) hB
  have hnd : (vs.map Prod.fst).Nodup := by rw [hvs]; ((simp only [List.map_cons, List.map_nil]; decide))
  set t := encK s1 (pushF G vs) with ht
  have tv : ∀ (i : Fin HS) (v : ℤ), (i, v) ∈ vs → t.G i = .int v :: (ints (G i) ++ s1.G i) := by
    intro i v hv
    rw [ht, encK_G, pf_top hnd hv]; rfl
  have hD18 : D18G t d (d - σ) (2 ^ (h + 1)) K (h + 1) (p / 6) := by
    refine ⟨⟨ints (G zD) ++ s1.G zD, ?_⟩, ⟨ints (G zDp) ++ s1.G zDp, ?_⟩,
      ⟨ints (G zR) ++ s1.G zR, ?_⟩, ⟨ints (G zK) ++ s1.G zK, ?_⟩, ⟨ints (G zEl) ++ s1.G zEl, ?_⟩,
      ⟨ints (G zB) ++ s1.G zB, ?_⟩⟩
    · rw [tv zD (d : ℤ) List.mem_cons_self]
    · rw [tv zDp _ (List.mem_cons_of_mem _ List.mem_cons_self)]
    · rw [tv zR _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self))]
      push_cast; rfl
    · rw [tv zK _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        List.mem_cons_self)))]
    · rw [tv zEl _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ List.mem_cons_self))))]
    · rw [tv zB _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ (List.mem_cons_of_mem _
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)))))]
  obtain ⟨o2, r2⟩ := desc18P_run_g X (X18_ok d18) hM.d1 t hD18
  have c2 := desc18P_cost_g X (X18_ok d18) hM.b8 hM.d1 hM.db hM.r hM.Kd hM.lb (Nat.sub_le _ _) t hD18
  have hXk : X ∉ vs.map Prod.fst := by
    rw [hvs]; rcases X18_mem d18 with e | e <;> rw [hXd, e] <;> ((simp only [List.map_cons, List.map_nil]; decide))
  have q2 : Sp (desc18P X) t (encK s1 (pushF (Function.update G X DD) vs))
      (10 ^ 12 * (p / 6 + 1) ^ 3) := by
    refine ⟨o2, ?_, c2⟩
    rw [r2, ← pushF_update _ _ _ _ hXk, ← encK_upd, ht, encK_G, pushF_apply_ne _ _ _ hXk, hX]
    simp [ints, hDD, dsG, hM.p6]
  have k2 := rsW (I := I) (iprog := iprog) ((q1.seq (q2.seq q3)) :
    Sp (rs18 X) (encK s1 G) (encK s1 (Function.update G X DD)) _)
  -- xfer
  have hX2 : (encK s1 (Function.update G X DD)).G X = ints DD ++ .mark :: s.G X := by
    simp [hs1]
  have k3 := xfer_runs (I := I) (iprog := iprog) X Y d18 hXY hXD hYD Bd DD hBd _ _ hX2
  have e3 : ((encK s1 (Function.update G X DD)).upd X (s.G X)).upd d18
      (ints DD ++ .mark :: (encK s1 (Function.update G X DD)).G d18) =
      encK (bgS s G d18 l) (fC d18 (gflat ZF ++ gflat ZG ++ []) DD) := by
    refine IState.ext' (fun i => ?_) rfl rfl
    by_cases e1 : i = d18
    · subst e1
      simp [bgS, fC, hs1, hd0, Ne.symm hXD, hXD]
    · by_cases e2 : i = X
      · have hX0 : X ≠ 0 := by
          rcases X18_mem d18 with e | e <;> rw [hXd, e] <;> decide
        subst e2; simp [bgS, fC, hs1, e1, hX, hXD, hX0]
      · by_cases e0 : i = 0
        · subst e0; simp [bgS, fC, hs1, Ne.symm hd0, e2, h0, ints_append]
        · simp [bgS, fC, hs1, e0, e1, e2]
  rw [e3] at k3
  -- unxfer
  have hU : (encK (bgS s G d18 l) (Function.update (fC d18 (gflat ZF ++ gflat ZG ++ []) DD) 0
      (gflat zh ++ []))).G d18 = ints DD ++ .mark :: (ints (G d18) ++ s.G d18) := by
    simp [bgS, fC, hd0]
  have k5 := unxfer_runs (I := I) (iprog := iprog) d18 Bd DD hBd _ _ hU
  have e5 : (encK (bgS s G d18 l) (Function.update (fC d18 (gflat ZF ++ gflat ZG ++ []) DD) 0
      (gflat zh ++ []))).upd d18 (ints (G d18) ++ s.G d18) =
      encK s (Function.update G 0 (gflat zh ++ l)) := by
    refine IState.ext' (fun i => ?_) rfl rfl
    by_cases e1 : i = d18
    · subst e1; simp [hd0, Ne.symm hd0]
    · by_cases e0 : i = 0
      · subst e0; simp [bgS, ints_append, e1]
      · simp [bgS, fC, e0, e1]
  rw [e5] at k5
  refine (k1.seq (k2.seq (k3.seq (hcall.seq k5)))).mono ?_
  unfold cM; omega

end Call

