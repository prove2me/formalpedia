lemma runL_dl (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) (h : ∀ o ∈ l, ∀ o' ∈ l, o.1 ≠ o'.2.1) :
    runL l Λ = Λ + dl l Λ := by
  rw [runL_par l Λ h]; rfl

lemma dl_off (l : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) (w : ℕ) (h : ∀ o ∈ l, o.1 ≠ w) : dl l Λ w = 0 :=
  sum_zero_of _ _ fun o ho => if_neg (h o ho)

lemma dl_append (a b : List (ℕ × ℕ × ℤ)) (Λ : ℕ → Vt) : dl (a ++ b) Λ = dl a Λ + dl b Λ := by
  funext w; simp [dl, List.sum_append]

/-! ## The blocks of the stage programs -/

lemma centreOps_mem {sg : ℤ} {srcw : ℕ → ℕ} {o : ℕ × ℕ × ℤ} (h : o ∈ centreOps d sg srcw) :
    ∃ S < NV, ∃ c ∈ centreL (d.tv S), o = (yw S, srcw c.1, sg * c.2) := by
  unfold centreOps at h
  obtain ⟨S, hS, h⟩ := List.mem_flatMap.1 h
  obtain ⟨c, hc, rfl⟩ := List.mem_map.1 h
  exact ⟨S, List.mem_range.1 hS, c, hc, rfl⟩

lemma injOps_mem (hlen : d.pieces.length = NV) {sg : ℤ} {o : ℕ × ℕ × ℤ} (h : o ∈ injOps d sg) :
    ∃ S < NV, ∃ p ∈ d.pieces.getD S [], o = (yw S, aw p.1, sg * p.2) := by
  unfold injOps at h
  rw [zip_range_eq _ _ hlen []] at h
  obtain ⟨x, hx, h⟩ := List.mem_flatMap.1 h
  obtain ⟨S, hS, rfl⟩ := List.mem_map.1 hx
  obtain ⟨p, hp, rfl⟩ := List.mem_map.1 h
  exact ⟨S, List.mem_range.1 hS, p, hp, rfl⟩

lemma centreL_lt (tv : ℕ) : ∀ c ∈ centreL tv, c.1 < 24 := by
  intro c hc
  unfold centreL at hc
  cases h : tv.testBit 23 <;> rw [h] at hc <;> simp at hc <;>
    rcases hc with rfl | ⟨i, hi, _, rfl⟩ <;> simp <;> omega

lemma rdV_eq (Λ : ℕ → Vt) (S : ℕ) : rdV d Λ S = rdVs d (fun j => aw (d.rs j)) Λ S := by
  simp [rdV, rdVs, rdL, List.map_append, List.sum_append, List.map_map, Function.comp]; rfl

lemma dl_RB (hlen : d.pieces.length = NV) (sg : ℤ) (srcw : ℕ → ℕ) (Λ : ℕ → Vt) {S : ℕ} (hS : S < NV) :
    dl (RB d sg srcw) Λ (yw S) = (sg : ℂ) • rdVs d srcw Λ S := by
  rw [RB, dl_append, Pi.add_apply]
  unfold dl
  rw [centre_sum d sg srcw Λ hS, inj_sum d hlen sg Λ hS, rdVs, smul_add]
  congr 1
  · rw [List.smul_sum, List.map_map]; congr 1
    apply List.map_congr_left; intro c _
    simp only [Function.comp, smul_smul]; congr 1; push_cast; ring
  · rw [List.smul_sum, List.map_map]; congr 1
    apply List.map_congr_left; intro c _
    simp only [Function.comp, smul_smul]; congr 1; push_cast; ring

lemma rdVs_add (srcw : ℕ → ℕ) (A B : ℕ → Vt) (S : ℕ) :
    rdVs d srcw (A + B) S = rdVs d srcw A S + rdVs d srcw B S := by
  simp only [rdVs, Pi.add_apply, smul_add]
  rw [show ∀ (L : List (ℕ × ℤ)) (f g : ℕ × ℤ → Vt), (L.map fun p => f p + g p).sum = (L.map f).sum + (L.map g).sum
    from fun L f g => List.sum_map_add]
  rw [show ∀ (L : List (ℕ × ℤ)) (f g : ℕ × ℤ → Vt), (L.map fun p => f p + g p).sum = (L.map f).sum + (L.map g).sum
    from fun L f g => List.sum_map_add]
  abel

/-! ## Facts about the blocks -/

lemma RB_par (sg : ℤ) (srcw : ℕ → ℕ) (hlen : d.pieces.length = NV)
    (hsw : ∀ S < NV, ∀ j < 24, srcw j ≠ yw S) : ∀ o ∈ RB d sg srcw, ∀ o' ∈ RB d sg srcw, o.1 ≠ o'.2.1 := by
  intro o ho o' ho'
  have hy : ∃ S < NV, o.1 = yw S := by
    rcases List.mem_append.1 ho with h | h
    · obtain ⟨S, hS, c, _, rfl⟩ := centreOps_mem d h; exact ⟨S, hS, rfl⟩
    · obtain ⟨S, hS, p, _, rfl⟩ := injOps_mem d hlen h; exact ⟨S, hS, rfl⟩
  obtain ⟨S, hS, e⟩ := hy
  rw [e]
  rcases List.mem_append.1 ho' with h | h
  · obtain ⟨S', _, c, hc, rfl⟩ := centreOps_mem d h; exact (hsw S hS c.1 (centreL_lt _ c hc)).symm
  · obtain ⟨S', _, p, _, rfl⟩ := injOps_mem d hlen h; exact (aw_ne_yw hS).symm

lemma RB_dst (sg : ℤ) (srcw : ℕ → ℕ) (hlen : d.pieces.length = NV) (w : ℕ) (hw : ∀ S < NV, w ≠ yw S) :
    ∀ o ∈ RB d sg srcw, o.1 ≠ w := by
  intro o ho
  rcases List.mem_append.1 ho with h | h
  · obtain ⟨S, hS, c, _, rfl⟩ := centreOps_mem d h; exact (hw S hS).symm
  · obtain ⟨S, hS, p, _, rfl⟩ := injOps_mem d hlen h; exact (hw S hS).symm

lemma XS_par (k : ℤ) : ∀ o ∈ XS d k, ∀ o' ∈ XS d k, o.1 ≠ o'.2.1 := by
  intro o ho o' ho'
  obtain ⟨t, _, rfl⟩ := List.mem_map.1 ho
  obtain ⟨t', ht', rfl⟩ := List.mem_map.1 ho'
  exact aw_ne_xw (List.mem_range.1 ht')

lemma XS_dst (k : ℤ) (w : ℕ) (hw : ∀ t < NV, w ≠ aw (d.src t)) : ∀ o ∈ XS d k, o.1 ≠ w := by
  intro o ho
  obtain ⟨t, ht, rfl⟩ := List.mem_map.1 ho
  exact (hw t (List.mem_range.1 ht)).symm

lemma CP_par (hrs : ∀ j < 24, d.rs j < NR) : ∀ o ∈ CP d, ∀ o' ∈ CP d, o.1 ≠ o'.2.1 := by
  intro o ho o' ho'
  obtain ⟨j, _, rfl⟩ := List.mem_map.1 ho
  obtain ⟨j', hj', rfl⟩ := List.mem_map.1 ho'
  exact (aw_ne_mw (hrs j' (List.mem_range.1 hj'))).symm

lemma CP_dst (w : ℕ) (hw : ∀ j < 24, w ≠ mw j) : ∀ o ∈ CP d, o.1 ≠ w := by
  intro o ho
  obtain ⟨j, hj, rfl⟩ := List.mem_map.1 ho
  exact (hw j (List.mem_range.1 hj)).symm

lemma dl_CP (Λ : ℕ → Vt) {j : ℕ} (hj : j < 24) : dl (CP d) Λ (mw j) = Λ (aw (d.rs j)) := by
  unfold dl CP
  rw [List.map_map, sum_range_single _ 24 hj]
  · simp [cf]
  · intro i _ hne
    simp only [Function.comp]
    rw [if_neg (fun h => hne (mw_inj h))]

lemma dl_XS (k : ℤ) (Λ : ℕ → Vt) {q : ℕ} :
    dl (XS d k) Λ (aw q) = ∑ t ∈ Finset.range NV, (if t < NV ∧ d.src t = q then ((k : ℂ) / 2) else 0) • Λ (xw t) := by
  unfold dl XS
  rw [List.map_map, list_sum_range]
  apply Finset.sum_congr rfl
  intro t ht
  have ht' := Finset.mem_range.1 ht
  simp only [Function.comp, cf]
  by_cases e : d.src t = q
  · subst e; simp [ht']
  · rw [if_neg (fun h => e (aw_inj h)), if_neg (fun h => e h.2), zero_smul]

lemma rdL_lt (hR : RdOK d) {S : ℕ} (hS : S < NV) : ∀ p ∈ rdL d S, p.1 < NR := by
  intro p hp
  rcases List.mem_append.1 hp with h | h
  · obtain ⟨c, hc, rfl⟩ := List.mem_map.1 h; exact hR.1 _ (centreL_lt _ c hc)
  · exact hR.2 S hS p h

lemma rdV_off (hR : RdOK d) (J : ℕ → Vt) (hJ : OffA J) {S : ℕ} (hS : S < NV) : rdV d J S = 0 := by
  unfold rdV
  apply sum_zero_of
  intro p hp
  rw [hJ _ (rdL_lt d hR hS p hp), smul_zero]

lemma rdV_add (A B : ℕ → Vt) (S : ℕ) : rdV d (A + B) S = rdV d A S + rdV d B S := by
  rw [rdV_eq, rdV_eq, rdV_eq, rdVs_add]

lemma sum_half {α : Type*} (L : List α) (a : α → ℤ) (c : α → ℕ) :
    (L.map fun p => (a p : ℂ) / 2 * (c p : ℂ)).sum = (((L.map fun p => a p * (c p : ℤ)).sum : ℤ) : ℂ) / 2 := by
  induction L with
  | nil => simp
  | cons p L ih => simp only [List.map_cons, List.sum_cons, ih]; push_cast; ring

/-- **The mask identity on states**: the readout of the gate run on the placed inputs is `x_S`. -/
theorem rd_mask (hg : GOK (d.gates.flatMap gq)) (hR : RdOK d) (hM : MaskOK d) (Pz : ℕ → Vt) (X : ℕ → Vt)
    (hPz : ∀ q < NR, Pz (aw q) = ∑ t ∈ Finset.range NV, (place d.src NV q t : ℂ) • X t) {S : ℕ} (hS : S < NV) :
    rdV d (runL (slotOps (d.gates.flatMap gq)) Pz) S = X S := by
  have h1 := runL_slots (Finset.range NV) X (d.gates.flatMap gq) Pz (place d.src NV)
    (fun o ho => ⟨(hg o ho).1, (hg o ho).2.1⟩) hPz
  unfold rdV
  rw [List.map_congr_left (fun p hp => by rw [h1 p.1 (rdL_lt d hR hS p hp)]), list_sum_finset]
  rw [Finset.sum_eq_single_of_mem S (Finset.mem_range.2 hS)]
  · simp only [smul_smul]
    rw [list_sum_smul]
    have := hM S hS S
    rw [if_pos rfl] at this
    rw [sum_half, this]; norm_num
  · intro u _ hu
    simp only [smul_smul]
    rw [list_sum_smul]
    have := hM S hS u
    rw [if_neg hu] at this
    rw [sum_half, this]; simp

/-! ## The op lists of the stages -/

lemma ops_xSpec (lab : ℕ → ℕ) (k : ℤ) (l : List ℕ) :
    (l.map (xSpec d lab k)).flatMap Spec.ops = l.map fun t => (aw (d.src t), xw t, k) := by
  induction l with
  | nil => rfl
  | cons t l ih => simp only [List.map_cons, List.flatMap_cons, ih]; rfl

lemma ops_gates1 (gs : List Gate) : (gs.map gateSpec).flatMap Spec.ops = Lops gs := by
  induction gs with
  | nil => rfl
  | cons g gs ih => simp only [List.map_cons, List.flatMap_cons, ih]; rfl

lemma ops_pieceSpecs (sg : ℤ) : (pieceSpecs d sg).flatMap Spec.ops = injOps d sg := by
  unfold pieceSpecs injOps
  generalize (List.range NV).zip d.pieces = l
  induction l with
  | nil => rfl
  | cons p l ih => simp only [List.map_cons, List.flatMap_cons, ih]

lemma ops_copySpecs : (copySpecs d).flatMap Spec.ops = CP d := by
  unfold copySpecs CP
  generalize List.range 24 = l
  induction l with
  | nil => rfl
  | cons p l ih => simp only [List.map_cons, List.flatMap_cons, ih]; rfl

/-- The ops of stage one. -/
theorem ops1_eq : (specs1 d).flatMap Spec.ops =
    Lops d.gates ++ RB d (-1) (fun j => aw (d.rs j)) ++ negOps (Lops d.gates) ++ XS d 2 ++ Lops d.gates ++
      CP d ++ RB d 1 mw ++ negOps (Lops d.gates) ++ XS d (-2) := by
  simp only [specs1, pre1, gates1, post1, post1a, post1b, List.flatMap_append, List.flatMap_cons,
    List.flatMap_nil, ops_xSpec, ops_gates1, ops_pieceSpecs, ops_copySpecs, Dat.gates, RB, XS,
    List.append_nil, List.append_assoc]

/-! ## Stage effects -/

lemma neg_sum_map {α : Type*} (L : List α) (f : α → Vt) : (L.map fun x => -f x).sum = -(L.map f).sum := by
  induction L with
  | nil => simp
  | cons a L ih => simp only [List.map_cons, List.sum_cons, ih, neg_add]

lemma dl_XS_neg (k : ℤ) (A B : ℕ → Vt) (h : ∀ t < NV, A (xw t) = B (xw t)) :
    dl (XS d (-k)) B = -dl (XS d k) A := by
  funext w
  unfold dl XS
  simp only [List.map_map, Pi.neg_apply]
  rw [← neg_sum_map]
  apply congrArg List.sum
  apply List.map_congr_left
  intro t ht
  simp only [Function.comp, cf]
  rw [h t (List.mem_range.1 ht)]
  split_ifs <;> simp [neg_div, neg_smul]

lemma rdVs_mw (A B : ℕ → Vt) (S : ℕ) (h1 : ∀ j < 24, A (mw j) = B (aw (d.rs j)))
    (h2 : ∀ p ∈ d.pieces.getD S [], A (aw p.1) = B (aw p.1)) :
    rdVs d mw A S = rdVs d (fun j => aw (d.rs j)) B S := by
  unfold rdVs
  congr 1
  · congr 1; exact List.map_congr_left fun c hc => by rw [h1 c.1 (centreL_lt _ c hc)]
  · congr 1; exact List.map_congr_left fun p hp => by rw [h2 p hp]

lemma offA_add {J K : ℕ → Vt} (hJ : OffA J) (hK : OffA K) : OffA (J + K) := fun q hq => by
  simp [hJ q hq, hK q hq]

lemma Pz_place (hsrc : ∀ t < NV, d.src t < NR) (A : ℕ → Vt) (q : ℕ) :
    dl (XS d 2) A (aw q) = ∑ t ∈ Finset.range NV, (place d.src NV q t : ℂ) • A (xw t) := by
  rw [dl_XS]
  apply Finset.sum_congr rfl
  intro t _
  rw [place_apply]
  split_ifs <;> simp

/-- **Stage one**: `y_S += x_S`; `x` and the dirty scratch `a` are restored (temporaries `m` clean). -/
theorem stage1_sol_aux (hg : GOK (d.gates.flatMap gq)) (hlen : d.pieces.length = NV) (hsrc : ∀ t < NV, d.src t < NR)
    (hR : RdOK d) (hM : MaskOK d) (Λ : ℕ → Vt) (hm : ∀ j < 24, Λ (mw j) = 0) :
    (∀ S < NV, runL ((specs1 d).flatMap Spec.ops) Λ (yw S) = Λ (yw S) + Λ (xw S)) ∧
    (∀ q < NR, runL ((specs1 d).flatMap Spec.ops) Λ (aw q) = Λ (aw q)) ∧
    (∀ t < NV, runL ((specs1 d).flatMap Spec.ops) Λ (xw t) = Λ (xw t)) := by
  have hG : Lops d.gates = slotOps (d.gates.flatMap gq) := Lops_eq _
  rw [ops1_eq, hG]
  simp only [runL_append]
  set gl := d.gates.flatMap gq
  set P := runL (slotOps gl) Λ with hP
  have e1 : runL (RB d (-1) (fun j => aw (d.rs j))) P = P + dl (RB d (-1) (fun j => aw (d.rs j))) P :=
    runL_dl _ _ (RB_par d _ _ hlen fun S hS _ _ => aw_ne_yw hS)
  set δ1 := dl (RB d (-1) (fun j => aw (d.rs j))) P with hδ1d
  have hδ1 : OffA δ1 := fun q _ => dl_off _ _ _ (RB_dst d _ _ hlen _ fun S hS => aw_ne_yw hS)
  have e2 : runL (negOps (slotOps gl)) (P + δ1) = Λ + δ1 := by
    rw [runL_nG_junk hg _ _ hδ1, hP, runL_G_inv hg]
  have e3 : runL (XS d 2) (Λ + δ1) = Λ + δ1 + dl (XS d 2) (Λ + δ1) := runL_dl _ _ (XS_par d 2)
  set Pz := dl (XS d 2) (Λ + δ1) with hPzd
  have e4 : runL (slotOps gl) (Λ + δ1 + Pz) = runL (slotOps gl) (Λ + Pz) + δ1 := by
    rw [add_right_comm, runL_G_junk hg _ _ hδ1]
  set Λ3 := runL (slotOps gl) (Λ + Pz) + δ1 with hΛ3
  have e5 : runL (CP d) Λ3 = Λ3 + dl (CP d) Λ3 := runL_dl _ _ (CP_par d hR.1)
  set Mc := dl (CP d) Λ3 with hMcd
  have hMc : OffA Mc := fun q hq => dl_off _ _ _ (CP_dst d _ fun j _ => aw_ne_mw hq)
  have e6 : runL (RB d 1 mw) (Λ3 + Mc) = Λ3 + Mc + dl (RB d 1 mw) (Λ3 + Mc) :=
    runL_dl _ _ (RB_par d _ _ hlen fun S hS _ _ => mw_ne_yw hS)
  set δ2 := dl (RB d 1 mw) (Λ3 + Mc) with hδ2d
  have hδ2 : OffA δ2 := fun q _ => dl_off _ _ _ (RB_dst d _ _ hlen _ fun S hS => aw_ne_yw hS)
  have e7 : runL (negOps (slotOps gl)) (Λ3 + Mc + δ2) = Λ + Pz + (δ1 + Mc + δ2) := by
    rw [show Λ3 + Mc + δ2 = runL (slotOps gl) (Λ + Pz) + (δ1 + Mc + δ2) by rw [hΛ3]; abel]
    rw [runL_nG_junk hg _ _ (offA_add (offA_add hδ1 hMc) hδ2), runL_G_inv hg]
  have e8 : runL (XS d (-2)) (Λ + Pz + (δ1 + Mc + δ2)) =
      Λ + Pz + (δ1 + Mc + δ2) + dl (XS d (-2)) (Λ + Pz + (δ1 + Mc + δ2)) := runL_dl _ _ (XS_par d _)
  rw [e1, e2, e3, e4, e5, e6, e7, e8]
  -- values of the increments on the wire classes
  have xP : ∀ t < NV, Pz (xw t) = 0 := fun t ht => by
    rw [hPzd]; exact dl_off _ _ _ (XS_dst d _ _ fun t' _ => (aw_ne_xw ht).symm)
  have x1 : ∀ t < NV, δ1 (xw t) = 0 := fun t ht => dl_off _ _ _ (RB_dst d _ _ hlen _ fun S _ => (yw_ne_xw ht).symm)
  have x2 : ∀ t < NV, Mc (xw t) = 0 := fun t ht => dl_off _ _ _ (CP_dst d _ fun j _ => (mw_ne_xw ht).symm)
  have x3 : ∀ t < NV, δ2 (xw t) = 0 := fun t ht => dl_off _ _ _ (RB_dst d _ _ hlen _ fun S _ => (yw_ne_xw ht).symm)
  have eneg : dl (XS d (-2)) (Λ + Pz + (δ1 + Mc + δ2)) = -Pz := by
    apply dl_XS_neg
    intro t ht
    simp [xP t ht, x1 t ht, x2 t ht, x3 t ht]
  rw [eneg]
  have fin : Λ + Pz + (δ1 + Mc + δ2) + -Pz = Λ + (δ1 + Mc + δ2) := by abel
  rw [fin]
  refine ⟨fun S hS => ?_, fun q hq => ?_, fun t ht => ?_⟩
  · have yM : Mc (yw S) = 0 := dl_off _ _ _ (CP_dst d _ fun j _ => (mw_ne_yw hS).symm)
    have y1 : δ1 (yw S) = -rdV d P S := by
      rw [hδ1d, dl_RB d hlen _ _ _ hS, rdV_eq]; simp
    have y2 : δ2 (yw S) = rdV d Λ3 S := by
      rw [hδ2d, dl_RB d hlen _ _ _ hS, rdV_eq]
      simp only [Int.cast_one, one_smul]
      apply rdVs_mw
      · intro j hj
        have m3 : Λ3 (mw j) = 0 := by
          rw [hΛ3, Pi.add_apply, runL_G_off hg _ _ fun q hq => (aw_ne_mw hq).symm]
          simp only [Pi.add_apply, hm j hj]
          rw [hPzd, hδ1d, dl_off _ _ _ (XS_dst d _ _ fun t ht => (aw_ne_mw (hsrc t ht)).symm),
            dl_off _ _ _ (RB_dst d _ _ hlen _ fun S hS => mw_ne_yw hS)]
          simp
        rw [Pi.add_apply, m3, zero_add, hMcd, dl_CP d _ hj]
      · intro p hp
        rw [Pi.add_apply, hMc _ (hR.2 S hS p hp), add_zero]
    have hX : rdV d (runL (slotOps gl) Pz) S = (Λ + δ1) (xw S) :=
      rd_mask d hg hR hM Pz (fun t => (Λ + δ1) (xw t)) (fun q _ => Pz_place d hsrc _ q) hS
    have r3 : rdV d Λ3 S = rdV d P S + (Λ + δ1) (xw S) := by
      rw [hΛ3, runL_add, rdV_add, rdV_add, hX, rdV_off d hR _ hδ1 hS, ← hP]; abel
    simp only [Pi.add_apply, y1, y2, yM, r3, x1 S hS]
    abel
  · simp [hδ1 q hq, hMc q hq, hδ2 q hq]
  · simp [x1 t ht, x2 t ht, x3 t ht]

end IntMul.Kappa.R6.Cx.NetEff

end

theorem solution.{u_1} : type_of% @IntMul.Kappa.R6.Cx.NetEff.stage1_sol_aux.{u_1} := @IntMul.Kappa.R6.Cx.NetEff.stage1_sol_aux.{u_1}
