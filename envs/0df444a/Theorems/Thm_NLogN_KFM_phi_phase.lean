  IntMul.OpenAI.RCost
variable {P P' : ℕ} {Isym : List Sym} {iprog : Fin P → IStmt HS P}
  {ext : Fin P' → IStmt HS (7 + P')} {g : Fin (7 + P') → Fin P}
  (hprog : ∀ j, iprog (g j) = (kTable ext j).ren id g)
  {n D : ℕ} (hn : n0 ≤ n) (hD : dP n = D + 1)
include hprog hn

theorem NLogN.KFM.phi_phase {eF eB : Fin (7 + P')} {dS : Fin HS} {C₀ : ℝ} (hd0 : dS ≠ 0)
    (hP : phiG Isym ext eF eB dS C₀ (pP n + 2) (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n) (muN n))
    (Bd : ℕ) (hBd : ∀ x ∈ descPhiN n, zsz x ≤ Bd)
    (t : IState HS) (hR : BaseOK t n) (xs : List ℤ) (R0 : List Item)
    (h0 : t.G 0 = ints xs ++ R0) (hxw : Bnd (pP n + 2) xs) :
    (xs.length = vol (KFU.shK (IntMul.OpenAI.Glue.dP n) (KFU.sP (IntMul.OpenAI.Glue.dP n) (srcN n))) →
      ∃ c : ℕ, IRuns Isym iprog (callW (descPhiP (bX dS) rPw) (bX dS) (bY dS) dS (g eF)) t
        (t.upd 0 (ints (KFU.PhiD (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n) (muN n) xs) ++ R0)) c ∧
        (c : ℝ) ≤ kPhi n Bd C₀) ∧
    (xs.length = vol (KFU.shR (IntMul.OpenAI.Glue.dP n) (KFU.tP (IntMul.OpenAI.Glue.dP n) (ℓP n - 1) (bLn n))) →
      ∃ c : ℕ, IRuns Isym iprog (callW (descPhiP (bX dS) rPw) (bX dS) (bY dS) dS (g eB)) t
        (t.upd 0 (ints (KFU.PhiInvD (ℓP n - 1) (IntMul.OpenAI.Glue.dP n) (bLn n) (srcN n) (muN n) xs) ++ R0)) c ∧
        (c : ℝ) ≤ kPhi n Bd C₀) := by sorry
