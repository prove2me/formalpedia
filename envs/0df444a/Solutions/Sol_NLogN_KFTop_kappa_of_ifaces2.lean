  | _ :: _, _, 0, h => by simp at h
  | _ :: ts, x, i + 1, h => digL_ge ts _ i (by simp at h; omega)

theorem boxIdxs_getElem? : ∀ (dims : List ℕ) (x : ℕ), x < dims.prod →
    (boxIdxs dims)[x]? = some ((List.range dims.length).map (digL dims x))
  | [], x, hx => by
    simp at hx; subst hx; simp [boxIdxs]
  | n :: ns, x, hx => by
    have hP : 0 < ns.prod := by
      rcases Nat.eq_zero_or_pos ns.prod with h | h
      · simp [h] at hx
      · exact h
    have hq : x / ns.prod < n := by
      rw [Nat.div_lt_iff_lt_mul hP]; simpa [mul_comm] using hx
    have hr : x % ns.prod < ns.prod := Nat.mod_lt _ hP
    have e : x = x / ns.prod * ns.prod + x % ns.prod := (Nat.div_add_mod' x ns.prod).symm
    rw [boxIdxs]
    conv_lhs => rw [e]
    rw [getElem?_flatMap_const n ns.prod _ (fun _ _ => by simp [length_boxIdxs]) _ _ hq hr,
      List.getElem?_map, boxIdxs_getElem? ns _ hr]
    simp only [Option.map_some]
    congr 1
    rw [List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map]
    congr 1
    all_goals (try simp [digL, Nat.mod_eq_of_lt hq])
    all_goals (try (apply List.map_congr_left; intro i _; simp [digL, Function.comp]))

