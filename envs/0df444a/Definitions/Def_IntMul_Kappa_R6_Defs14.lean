namespace NLogN.KFUU.R6Crt

open IntMul KIL KFB KFC KFT KFU AModel AModelL12 NLogN.KFUU

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P} {τ : ℝ}

/-- The cost of one composite swap (as a natural number). -/
noncomputable def cSwp (τ K : ℝ) (Q u n w Z c2 : ℕ) : ℕ :=
  ⌈cSwNτ τ K w (u * (n / 2)) [1, Q ^ (n / 2), Q ^ (n - 2 * (n / 2)), Q ^ (n / 2), c2]⌉₊ + 40 * cU Z

def mainU (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (lsU true true) (.seq (swpU eSw dS Dsc) (.seq (lsU true false) (.seq (lsU false true)
  (.seq (swpU eSw dS Dsc) (.seq (lsU false false) (.seq (swpU eSw dS Dsc) (.seq (lsU true false)
    (lsU false true))))))))

/-- The cost of `mainU`. -/
noncomputable def cMain (τ K : ℝ) (Q u n w Z c2 V : ℕ) : ℕ :=
  6 * cLs n V Q w Z (n / 2) + 3 * cSwp τ K Q u n w Z c2

end Gen

end NLogN.KFUU.R6Crt

end

