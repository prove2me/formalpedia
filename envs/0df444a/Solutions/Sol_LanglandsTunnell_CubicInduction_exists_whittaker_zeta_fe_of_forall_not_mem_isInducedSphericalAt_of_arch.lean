private theorem eq_one_or_eq_neg_one_of_forall_valued_algebraMap_eq_one (a : ℚ) (ha : a ≠ 0)
    (hu : ∀ v : HeightOneSpectrum (𝓞 ℚ), Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1) :
    a = 1 ∨ a = -1 := by
  have hval : ∀ v : HeightOneSpectrum (𝓞 ℚ), v.valuation ℚ a = 1 := by
    intro v
    exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' (v := v) a).symm.trans (hu v)
  have hmem : a ∈ (algebraMap (𝓞 ℚ) ℚ).range :=
    IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one (R := 𝓞 ℚ) ℚ a fun v => (hval v).le
  have hmem' : a⁻¹ ∈ (algebraMap (𝓞 ℚ) ℚ).range :=
    IsDedekindDomain.HeightOneSpectrum.mem_integers_of_valuation_le_one (R := 𝓞 ℚ) ℚ a⁻¹ fun v => by
      rw [map_inv₀, hval v, inv_one]
  obtain ⟨b, hb⟩ := hmem
  obtain ⟨b', hb'⟩ := hmem'
  have hbb : b * b' = 1 := by
    apply FaithfulSMul.algebraMap_injective (𝓞 ℚ) ℚ
    rw [map_mul, map_one, hb, hb', mul_inv_cancel₀ ha]
  have hunit : IsUnit (Rat.ringOfIntegersEquiv b) := (IsUnit.of_mul_eq_one b' hbb).map Rat.ringOfIntegersEquiv
  have hab : a = ((Rat.ringOfIntegersEquiv b : ℤ) : ℚ) := by
    rw [Rat.ringOfIntegersEquiv_apply_coe, hb]
  rcases Int.isUnit_iff.1 hunit with h1 | h1
  · left
    rw [hab, h1, Int.cast_one]
  · right
    rw [hab, h1, Int.cast_neg, Int.cast_one]

private theorem mul_self_eq_one_of_forall_valued_algebraMap_eq_one (a : ℚ) (ha : a ≠ 0)
    (hu : ∀ v : HeightOneSpectrum (𝓞 ℚ), Valued.v (algebraMap ℚ (v.adicCompletion ℚ) a) = 1) :
    a * a = 1 := by
  rcases eq_one_or_eq_neg_one_of_forall_valued_algebraMap_eq_one a ha hu with rfl | rfl <;> norm_num

private theorem localChar_mul_pow_three_apply (ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (v : HeightOneSpectrum (𝓞 ℚ))
    (u : (v.adicCompletion ℚ)ˣ) :
    localChar (ω * χ ^ 3) v u = localChar ω v u * localChar χ v u ^ 3 := by
  simp only [localChar, MonoidHom.comp_apply, MonoidHom.mul_apply, MonoidHom.pow_apply]

private theorem unitsAt_principal_eq (v : HeightOneSpectrum (𝓞 ℚ)) (u : ℚˣ) (α : (v.adicCompletion ℚ)ˣ)
    (hα : (α : v.adicCompletion ℚ) = algebraMap ℚ (v.adicCompletion ℚ) (u : ℚ)) :
    unitsAt v (Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) : ℚ →* AdeleRing (𝓞 ℚ) ℚ) u) = α := by
  apply Units.ext
  rw [unitsAt_val, hα]
  rfl

private theorem unitsAtInfinity_principal_eq_archIdeleHom (u : ℚˣ)
    (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hE : ∀ x : (InfiniteAdeleRing ℚ)ˣ, M4aHerbrand.infPart (E x) = x ∧ RatIdele.finPart (E x) = 1)
    (aInf : (InfiniteAdeleRing ℚ)ˣ)
    (haInf : (aInf : InfiniteAdeleRing ℚ) = algebraMap ℚ (InfiniteAdeleRing ℚ) (u : ℚ)) :
    archIdeleHom (unitsAtInfinity (Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) : ℚ →* AdeleRing (𝓞 ℚ) ℚ) u))
      = E aInf := by
  apply Units.ext
  rw [LanglandsTunnell.CubicInduction.archIdeleHom_apply_coe, unitsAtInfinity_val]
  have h1 : ((E aInf : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).1 = (aInf : InfiniteAdeleRing ℚ) :=
    congrArg Units.val (hE aInf).1
  have h2 : ((E aInf : (AdeleRing (𝓞 ℚ) ℚ)ˣ) : AdeleRing (𝓞 ℚ) ℚ).2 = 1 :=
    congrArg Units.val (hE aInf).2
  refine Prod.ext ?_ ?_
  · rw [h1, haInf]
    rfl
  · rw [h2]

private theorem apply_archIdeleHom_mul_prod_localChar_mul_pow_three_eq_one (ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hω : IsAdmissibleTwist ℚ ω) (hχ : IsAdmissibleTwist ℚ χ) (N : Finset (HeightOneSpectrum (𝓞 ℚ)))
    (hωN : ∀ v ∉ N, IsUnramifiedCharAt ω v) (hχN : ∀ v ∉ N, IsUnramifiedCharAt χ v)
    (y : (AdeleRing (𝓞 ℚ) ℚ)ˣ) (hy : y * y = 1) (hy1 : ω y = 1) (hy2 : χ y = 1) :
    (ω * χ ^ 3) (archIdeleHom (unitsAtInfinity y)) * ∏ v ∈ N, localChar (ω * χ ^ 3) v (unitsAt v y)
      = 1 := by
  have hc : Continuous ⇑(ω * χ ^ 3) := by
    have h : ⇑(ω * χ ^ 3) = fun x => ω x * χ x ^ 3 := by
      ext x
      simp
    rw [h]
    exact hω.2.1.mul (hχ.2.1.pow 3)
  have hN : ∀ v ∉ N, IsUnramifiedCharAt (ω * χ ^ 3) v := by
    intro v hv t ht ht'
    rw [localChar_mul_pow_three_apply, hωN v hv t ht ht', hχN v hv t ht ht', one_pow, one_mul]
  have hy' : (ω * χ ^ 3) y = 1 := by
    rw [MonoidHom.mul_apply, MonoidHom.pow_apply, hy1, hy2, one_pow, one_mul]
  exact LanglandsTunnell.CubicInduction.TwistUnits.apply_archIdeleHom_mul_prod_localChar_eq_one (ω * χ ^ 3) hc N hN
    hy hy'

private theorem apply_mul_prod_localChar_mul_pow_three_eq_one (ω χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ)
    (hω : IsAdmissibleTwist ℚ ω) (hχ : IsAdmissibleTwist ℚ χ) (S T : Finset (HeightOneSpectrum (𝓞 ℚ))) (hST : S ⊆ T)
    (hωS : ∀ v ∉ S, IsUnramifiedCharAt ω v) (hχT : ∀ v ∉ T, IsUnramifiedCharAt χ v)
    (a : ℚ) (ha : a = 1 ∨ a = -1) (α : ∀ v : HeightOneSpectrum (𝓞 ℚ), (v.adicCompletion ℚ)ˣ)
    (hα : ∀ v : HeightOneSpectrum (𝓞 ℚ), ((α v : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)
      = algebraMap ℚ (v.adicCompletion ℚ) a)
    (E : (InfiniteAdeleRing ℚ)ˣ →* (AdeleRing (𝓞 ℚ) ℚ)ˣ)
    (hE : ∀ x : (InfiniteAdeleRing ℚ)ˣ, M4aHerbrand.infPart (E x) = x ∧ RatIdele.finPart (E x) = 1)
    (aInf : (InfiniteAdeleRing ℚ)ˣ)
    (haInf : (aInf : InfiniteAdeleRing ℚ) = algebraMap ℚ (InfiniteAdeleRing ℚ) a) :
    ω (E aInf) * χ (E aInf) ^ 3 * (∏ v ∈ S, (localChar ω v (α v) * localChar χ v (α v) ^ 3))
        * ∏ v ∈ T \ S, localChar χ v (α v) ^ 3
      = 1 := by
  have ha0 : a ≠ 0 := by
    rcases ha with rfl | rfl <;> norm_num
  have haa : a * a = 1 := by
    rcases ha with rfl | rfl <;> norm_num
  set u : ℚˣ := Units.mk0 a ha0 with hu_def
  have hua : (u : ℚ) = a := rfl
  have huu : u * u = 1 := Units.ext (by rw [Units.val_mul, hua, haa, Units.val_one])
  set y : (AdeleRing (𝓞 ℚ) ℚ)ˣ := Units.map (algebraMap ℚ (AdeleRing (𝓞 ℚ) ℚ) : ℚ →* AdeleRing (𝓞 ℚ) ℚ) u with hy_def
  have hyy : y * y = 1 := by
    rw [← map_mul, huu, map_one]
  have hK := apply_archIdeleHom_mul_prod_localChar_mul_pow_three_eq_one ω χ hω hχ T
    (fun v hv => hωS v fun hvS => hv (hST hvS)) hχT _ hyy (hω.1 u) (hχ.1 u)
  rw [hy_def] at hK
  rw [unitsAtInfinity_principal_eq_archIdeleHom u E hE aInf (by rw [hua]; exact haInf), MonoidHom.mul_apply,
    MonoidHom.pow_apply,
    Finset.prod_congr rfl fun v _ => by
      rw [localChar_mul_pow_three_apply, unitsAt_principal_eq v u (α v) (by rw [hua]; exact hα v)],
    ← Finset.prod_sdiff hST] at hK
  have hαα : ∀ v : HeightOneSpectrum (𝓞 ℚ), α v * α v = 1 := fun v =>
    Units.ext (by rw [Units.val_mul, hα v, ← map_mul, haa, map_one, Units.val_one])
  have hαmem : ∀ v : HeightOneSpectrum (𝓞 ℚ), ((α v : (v.adicCompletion ℚ)ˣ) : v.adicCompletion ℚ)
      ∈ v.adicCompletionIntegers ℚ := by
    intro v
    rw [hα v]
    rcases ha with rfl | rfl
    · rw [map_one]
      exact one_mem _
    · rw [map_neg, map_one]
      exact neg_mem (one_mem _)
  have hω1 : ∀ v ∈ T \ S, localChar ω v (α v) = 1 := by
    intro v hv
    have hinv : (α v)⁻¹ = α v := inv_eq_of_mul_eq_one_right (hαα v)
    refine hωS v (Finset.mem_sdiff.1 hv).2 (α v) (hαmem v) ?_
    rw [hinv]
    exact hαmem v
  rw [Finset.prod_congr rfl fun v hv => by rw [hω1 v hv, one_mul]] at hK
  rw [← hK]
  simp only [mul_assoc, mul_comm, mul_left_comm]

