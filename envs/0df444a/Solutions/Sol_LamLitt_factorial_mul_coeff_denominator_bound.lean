/-!
# `k! · aₖ` has denominators bounded by a geometric progression

For a power series `f = ∑ aₖ zᵏ ∈ ℚ⟦z⟧` solving an algebraic ODE
`f⁽ⁿ⁾ = (p/q)(z, f, …, f⁽ⁿ⁻¹⁾)` with `q(0, f(0), …) ≠ 0`, there is `D ≥ 1` with
`D^(k+1) · k! · aₖ ∈ ℤ` for all `k`.

Proof idea: with `u = q(z, f, …)⁻¹`, the subring `B ⊆ ℚ⟦z⟧` generated by `D·z`, `D·f⁽ⁱ⁾`
(`i < n`) and `D·u` has integral constant coefficients and satisfies `D^E · ∂B ⊆ B`.
Since `D^a · f ∈ B`, we get `D^(kE+a) · f⁽ᵏ⁾ ∈ B`, whose constant coefficient is
`D^(kE+a) · k! · aₖ`.
-/

set_option autoImplicit false

open PowerSeries

namespace LamLittAuxS1

/-- (9) `m! · [X^m] f^{(k)} = (m+k)! · [X^{m+k}] f`. -/
lemma factorial_mul_coeff_iterate (k : ℕ) : ∀ (f : ℚ⟦X⟧) (m : ℕ),
    (m.factorial : ℚ) * coeff m ((d⁄dX ℚ)^[k] f)
      = ((m + k).factorial : ℚ) * coeff (m + k) f := by
  induction k with
  | zero => intro f m; simp
  | succ k ih =>
    intro f m
    rw [Function.iterate_succ_apply, ih, coeff_derivative, show m + (k + 1) = m + k + 1 by ring,
      Nat.factorial_succ]
    push_cast
    ring

lemma constantCoeff_iterate (k : ℕ) (f : ℚ⟦X⟧) :
    constantCoeff ((d⁄dX ℚ)^[k] f) = (k.factorial : ℚ) * coeff k f := by
  have h := factorial_mul_coeff_iterate k f 0
  simpa [coeff_zero_eq_constantCoeff_apply] using h

/-- A finite set of rationals has a common positive denominator. -/
lemma exists_common_den (E : Finset ℚ) :
    ∃ D : ℕ, 0 < D ∧ ∀ x ∈ E, ∃ m : ℤ, (D : ℚ) * x = (m : ℚ) := by
  classical
  refine ⟨∏ r ∈ E, r.den, Finset.prod_pos fun r _ => r.den_pos, fun x hx => ?_⟩
  obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem (fun r : ℚ => r.den) hx
  refine ⟨c * x.num, ?_⟩
  rw [hc]
  push_cast
  rw [mul_comm (x.den : ℚ), mul_assoc, Rat.den_mul_eq_num]

/-- (0) the constant coefficient commutes with polynomial evaluation. -/
lemma constantCoeff_aeval {σ : Type*} (pt : σ → ℚ⟦X⟧) (r : MvPolynomial σ ℚ) :
    constantCoeff (MvPolynomial.aeval pt r) = MvPolynomial.eval (constantCoeff ∘ pt) r := by
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_comp_left]
  have h : (constantCoeff (R := ℚ)).comp (algebraMap ℚ ℚ⟦X⟧) = RingHom.id ℚ := by
    ext x; simp
  rw [h]; rfl

lemma deriv_natCast_mul (N : ℕ) (h : ℚ⟦X⟧) :
    d⁄dX ℚ ((N : ℚ⟦X⟧) * h) = (N : ℚ⟦X⟧) * d⁄dX ℚ h := by
  rw [Derivation.leibniz, Derivation.map_natCast, smul_zero, add_zero, smul_eq_mul]

lemma deriv_pow_mul (D m : ℕ) (h : ℚ⟦X⟧) :
    d⁄dX ℚ ((D : ℚ⟦X⟧) ^ m * h) = (D : ℚ⟦X⟧) ^ m * d⁄dX ℚ h := by
  rw [← Nat.cast_pow]; exact deriv_natCast_mul _ _

/-- Leibniz-rule closure induction: if `c · ∂s ∈ B'` for all generators `s`, then
`c · ∂h ∈ B'` for all `h` in the subring generated by them (provided the generators lie in
`B'`). -/
lemma deriv_closure (c : ℚ⟦X⟧) (S : Set ℚ⟦X⟧) (B' : Subring ℚ⟦X⟧) (hS : S ⊆ B')
    (hgen : ∀ s ∈ S, c * d⁄dX ℚ s ∈ B') :
    ∀ h ∈ Subring.closure S, c * d⁄dX ℚ h ∈ B' := by
  intro h hh
  have hle : Subring.closure S ≤ B' := Subring.closure_le.mpr hS
  induction hh using Subring.closure_induction with
  | mem x hx => exact hgen x hx
  | zero => simp
  | one => simp
  | add x y _ _ hx hy => rw [map_add, mul_add]; exact B'.add_mem hx hy
  | neg x _ hx => rw [map_neg, mul_neg]; exact B'.neg_mem hx
  | mul x y hx' hy' hx hy =>
    have e : c * d⁄dX ℚ (x * y) = x * (c * d⁄dX ℚ y) + y * (c * d⁄dX ℚ x) := by
      rw [Derivation.leibniz]; simp only [smul_eq_mul]; ring
    rw [e]
    exact B'.add_mem (B'.mul_mem (hle hx') hy) (B'.mul_mem (hle hy') hx)

/-- (3) the constant coefficient is an integer on a subring whose generators have integer
constant coefficient. -/
lemma constantCoeff_int_closure (S : Set ℚ⟦X⟧)
    (hgen : ∀ s ∈ S, ∃ m : ℤ, constantCoeff s = (m : ℚ)) :
    ∀ h ∈ Subring.closure S, ∃ m : ℤ, constantCoeff h = (m : ℚ) := by
  intro h hh
  induction hh using Subring.closure_induction with
  | mem x hx => exact hgen x hx
  | zero => exact ⟨0, by simp⟩
  | one => exact ⟨1, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx; obtain ⟨b, hb⟩ := hy
    exact ⟨a + b, by rw [map_add, ha, hb]; push_cast; rfl⟩
  | neg x _ hx =>
    obtain ⟨a, ha⟩ := hx
    exact ⟨-a, by rw [map_neg, ha]; push_cast; rfl⟩
  | mul x y _ _ hx hy =>
    obtain ⟨a, ha⟩ := hx; obtain ⟨b, hb⟩ := hy
    exact ⟨a * b, by rw [map_mul, ha, hb]; push_cast; rfl⟩

/-- (4) weighted evaluation. -/
lemma aeval_mem {σ : Type*} (D : ℕ) (pt : σ → ℚ⟦X⟧) (B : Subring ℚ⟦X⟧)
    (hpt : ∀ j, (D : ℚ⟦X⟧) * pt j ∈ B) (r : MvPolynomial σ ℚ)
    (hr : ∀ s, ∃ m : ℤ, (D : ℚ) * MvPolynomial.coeff s r = (m : ℚ))
    (e : ℕ) (he : r.totalDegree ≤ e) :
    (D : ℚ⟦X⟧) ^ (e + 1) * MvPolynomial.aeval pt r ∈ B := by
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq, Finset.mul_sum]
  refine Subring.sum_mem _ fun s hs => ?_
  have hdeg : ∑ i ∈ s.support, s i ≤ e := le_trans (MvPolynomial.le_totalDegree hs) he
  obtain ⟨m, hm⟩ := hr s
  have hcoef : (D : ℚ⟦X⟧) * algebraMap ℚ ℚ⟦X⟧ (MvPolynomial.coeff s r) = (m : ℚ⟦X⟧) := by
    have h1 : ((D : ℚ⟦X⟧)) = algebraMap ℚ ℚ⟦X⟧ (D : ℚ) := by simp
    rw [h1, ← map_mul, hm]; simp
  have hprod : ∏ i ∈ s.support, ((D : ℚ⟦X⟧) * pt i) ^ s i
      = (D : ℚ⟦X⟧) ^ (∑ i ∈ s.support, s i) * ∏ i ∈ s.support, pt i ^ s i := by
    simp_rw [mul_pow]; rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum]
  have key : (D : ℚ⟦X⟧) ^ (e + 1)
        * (algebraMap ℚ ℚ⟦X⟧ (MvPolynomial.coeff s r) * ∏ i ∈ s.support, pt i ^ s i)
      = (m : ℚ⟦X⟧) * (D : ℚ⟦X⟧) ^ (e - ∑ i ∈ s.support, s i)
        * ∏ i ∈ s.support, ((D : ℚ⟦X⟧) * pt i) ^ s i := by
    rw [hprod, ← hcoef]
    obtain ⟨t, ht⟩ := Nat.exists_eq_add_of_le hdeg
    rw [ht, Nat.add_sub_cancel_left]
    ring
  rw [key]
  exact B.mul_mem (B.mul_mem (intCast_mem B m) (B.pow_mem (natCast_mem B D) _))
    (Subring.prod_mem _ fun i _ => B.pow_mem (hpt i) _)


/-- Abstract form of steps (2)–(7): the subring `B` generated by `D • pt j` and `D • u`
has integer constant coefficients and is stable under `D^E • ∂`. -/
theorem stage {σ : Type*} (D : ℕ) (pt : σ → ℚ⟦X⟧) (p q : MvPolynomial σ ℚ) (u : ℚ⟦X⟧)
    (hu : MvPolynomial.aeval pt q * u = 1)
    (hp : ∀ s, ∃ m : ℤ, (D : ℚ) * MvPolynomial.coeff s p = (m : ℚ))
    (hq : ∀ s, ∃ m : ℤ, (D : ℚ) * MvPolynomial.coeff s q = (m : ℚ))
    (hpt0 : ∀ j, ∃ m : ℤ, (D : ℚ) * constantCoeff (pt j) = (m : ℚ))
    (hu0 : ∃ m : ℤ, (D : ℚ) * constantCoeff u = (m : ℚ))
    (hder : ∀ j, d⁄dX ℚ (pt j) = 1 ∨ (∃ j', d⁄dX ℚ (pt j) = pt j') ∨
      d⁄dX ℚ (pt j) = MvPolynomial.aeval pt p * u) :
    ∃ B : Subring ℚ⟦X⟧,
      (∀ h ∈ B, ∃ m : ℤ, constantCoeff h = (m : ℚ)) ∧
      (∀ h ∈ B, (D : ℚ⟦X⟧) ^ (p.totalDegree + q.totalDegree + 3) * d⁄dX ℚ h ∈ B) ∧
      (∀ j, (D : ℚ⟦X⟧) * pt j ∈ B) ∧
      (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * MvPolynomial.aeval pt p ∈ B ∧
      (D : ℚ⟦X⟧) * u ∈ B := by
  set S₀ : Set ℚ⟦X⟧ := Set.range (fun j => (D : ℚ⟦X⟧) * pt j)
  set S : Set ℚ⟦X⟧ := S₀ ∪ {(D : ℚ⟦X⟧) * u}
  set B₀ : Subring ℚ⟦X⟧ := Subring.closure S₀
  set B : Subring ℚ⟦X⟧ := Subring.closure S
  have hB₀B : B₀ ≤ B := Subring.closure_mono Set.subset_union_left
  have hptB₀ : ∀ j, (D : ℚ⟦X⟧) * pt j ∈ B₀ := fun j => Subring.subset_closure ⟨j, rfl⟩
  have huB : (D : ℚ⟦X⟧) * u ∈ B := Subring.subset_closure (Or.inr rfl)
  have hDB : ∀ e : ℕ, (D : ℚ⟦X⟧) ^ e ∈ B := fun e => B.pow_mem (natCast_mem B D) e
  have hPv : (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * MvPolynomial.aeval pt p ∈ B₀ :=
    aeval_mem D pt B₀ hptB₀ p hp _ le_rfl
  have hQv : (D : ℚ⟦X⟧) ^ (q.totalDegree + 1) * MvPolynomial.aeval pt q ∈ B₀ :=
    aeval_mem D pt B₀ hptB₀ q hq _ le_rfl
  -- stage 1: derivatives of elements of `B₀`
  have hst1 : ∀ h ∈ B₀, (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * d⁄dX ℚ h ∈ B := by
    refine deriv_closure _ S₀ B (fun x hx => Subring.subset_closure (Or.inl hx)) ?_
    rintro _ ⟨j, rfl⟩
    show (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * d⁄dX ℚ ((D : ℚ⟦X⟧) * pt j) ∈ B
    rw [deriv_natCast_mul]
    rcases hder j with h1 | ⟨j', h1⟩ | h1
    · rw [h1, mul_one]; exact B.mul_mem (hDB _) (natCast_mem B D)
    · rw [h1]; exact B.mul_mem (hDB _) (hB₀B (hptB₀ j'))
    · rw [h1]
      have e : (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * ((D : ℚ⟦X⟧) * (MvPolynomial.aeval pt p * u))
          = ((D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * MvPolynomial.aeval pt p) * ((D : ℚ⟦X⟧) * u) := by
        ring
      rw [e]; exact B.mul_mem (hB₀B hPv) huB
  -- stage 2: derivative of the generator `D • u`
  have hdu : d⁄dX ℚ u = -(u * u * d⁄dX ℚ (MvPolynomial.aeval pt q)) := by
    have h := congrArg (d⁄dX ℚ) hu
    rw [Derivation.leibniz, Derivation.map_one_eq_zero] at h
    simp only [smul_eq_mul] at h
    have e : d⁄dX ℚ u = (MvPolynomial.aeval pt q * u) * d⁄dX ℚ u := by rw [hu, one_mul]
    rw [e]; linear_combination u * h
  have hst2 : (D : ℚ⟦X⟧) ^ (p.totalDegree + q.totalDegree + 3) * d⁄dX ℚ ((D : ℚ⟦X⟧) * u) ∈ B := by
    have h1 := hst1 _ hQv
    rw [deriv_pow_mul] at h1
    have e : (D : ℚ⟦X⟧) ^ (p.totalDegree + q.totalDegree + 3) * d⁄dX ℚ ((D : ℚ⟦X⟧) * u)
        = -(((D : ℚ⟦X⟧) * u) * ((D : ℚ⟦X⟧) * u) * ((D : ℚ⟦X⟧) ^ (p.totalDegree + 1)
            * ((D : ℚ⟦X⟧) ^ (q.totalDegree + 1) * d⁄dX ℚ (MvPolynomial.aeval pt q)))) := by
      rw [deriv_natCast_mul, hdu]; ring
    rw [e]
    exact B.neg_mem (B.mul_mem (B.mul_mem huB huB) h1)
  -- (7)
  have hst : ∀ h ∈ B, (D : ℚ⟦X⟧) ^ (p.totalDegree + q.totalDegree + 3) * d⁄dX ℚ h ∈ B := by
    refine deriv_closure _ S B Subring.subset_closure ?_
    rintro x (hx | hx)
    · have h1 := hst1 x (Subring.subset_closure hx)
      have e : (D : ℚ⟦X⟧) ^ (p.totalDegree + q.totalDegree + 3) * d⁄dX ℚ x
          = (D : ℚ⟦X⟧) ^ (q.totalDegree + 2) * ((D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * d⁄dX ℚ x) := by
        ring
      rw [e]; exact B.mul_mem (hDB _) h1
    · rw [Set.mem_singleton_iff] at hx; rw [hx]; exact hst2
  -- (3)
  have hint : ∀ h ∈ B, ∃ m : ℤ, constantCoeff h = (m : ℚ) := by
    refine constantCoeff_int_closure S ?_
    rintro x (⟨j, rfl⟩ | hx)
    · obtain ⟨m, hm⟩ := hpt0 j
      exact ⟨m, by rw [map_mul, map_natCast, hm]⟩
    · rw [Set.mem_singleton_iff] at hx
      obtain ⟨m, hm⟩ := hu0
      exact ⟨m, by rw [hx, map_mul, map_natCast, hm]⟩
  exact ⟨B, hint, hst, fun j => hB₀B (hptB₀ j), hB₀B hPv, huB⟩

/-- Steps (8)–(10): iterate the derivative bound and read off constant coefficients. -/
theorem conclude (D : ℕ) (f : ℚ⟦X⟧) (B : Subring ℚ⟦X⟧) (E a : ℕ)
    (hint : ∀ h ∈ B, ∃ m : ℤ, constantCoeff h = (m : ℚ))
    (hst : ∀ h ∈ B, (D : ℚ⟦X⟧) ^ E * d⁄dX ℚ h ∈ B)
    (hf : (D : ℚ⟦X⟧) ^ a * f ∈ B) (k : ℕ) :
    ∃ m : ℤ, ((D ^ (E + a) : ℕ) : ℚ) ^ (k + 1) * ((k.factorial : ℚ) * coeff k f) = (m : ℚ) := by
  have hk : ∀ k : ℕ, (D : ℚ⟦X⟧) ^ (k * E + a) * (d⁄dX ℚ)^[k] f ∈ B := by
    intro k
    induction k with
    | zero => simpa using hf
    | succ k ih =>
      have h1 := hst _ ih
      rw [deriv_pow_mul] at h1
      rw [Function.iterate_succ_apply']
      have e : (D : ℚ⟦X⟧) ^ ((k + 1) * E + a) * d⁄dX ℚ ((d⁄dX ℚ)^[k] f)
          = (D : ℚ⟦X⟧) ^ E * ((D : ℚ⟦X⟧) ^ (k * E + a) * d⁄dX ℚ ((d⁄dX ℚ)^[k] f)) := by ring
      rw [e]; exact h1
  obtain ⟨m, hm⟩ := hint _ (hk k)
  rw [map_mul, map_pow, map_natCast, constantCoeff_iterate] at hm
  refine ⟨(D : ℤ) ^ (E + k * a) * m, ?_⟩
  push_cast
  rw [← hm]; ring

/-- The statement, with the `let` of the definition unfolded. -/
theorem main {n : ℕ} (f : ℚ⟦X⟧) (pt : Fin (n + 1) → ℚ⟦X⟧)
    (hpt : pt = Fin.cases X (fun i : Fin n ↦ (d⁄dX ℚ)^[i.val] f))
    (p q : MvPolynomial (Fin (n + 1)) ℚ)
    (hq0 : MvPolynomial.eval (constantCoeff ∘ pt) q ≠ 0)
    (heq : (d⁄dX ℚ)^[n] f * MvPolynomial.aeval pt q = MvPolynomial.aeval pt p) :
    ∃ D : ℕ, 0 < D ∧ ∀ k : ℕ, ∃ m : ℤ,
      (D : ℚ) ^ (k + 1) * ((k.factorial : ℚ) * coeff k f) = (m : ℚ) := by
  classical
  have hptz : pt 0 = X := by rw [hpt]; rfl
  have hpts : ∀ i : Fin n, pt i.succ = (d⁄dX ℚ)^[i.val] f := by
    intro i; simp only [hpt, Fin.cases_succ]
  have hQ0 : constantCoeff (MvPolynomial.aeval pt q) ≠ 0 := by
    rw [constantCoeff_aeval]; exact hq0
  obtain ⟨u, hu⟩ : ∃ u : ℚ⟦X⟧, MvPolynomial.aeval pt q * u = 1 :=
    ⟨_, PowerSeries.mul_inv_cancel _ hQ0⟩
  have hn : (d⁄dX ℚ)^[n] f = MvPolynomial.aeval pt p * u := by
    rw [← heq, mul_assoc, hu, mul_one]
  obtain ⟨D, hDpos, hD⟩ := exists_common_den
    (p.support.image (fun s => MvPolynomial.coeff s p)
      ∪ q.support.image (fun s => MvPolynomial.coeff s q)
      ∪ Finset.univ.image (fun j => constantCoeff (pt j)) ∪ {constantCoeff u})
  have hp : ∀ s, ∃ m : ℤ, (D : ℚ) * MvPolynomial.coeff s p = (m : ℚ) := by
    intro s
    by_cases hs : s ∈ p.support
    · refine hD _ ?_
      simp only [Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inl ⟨s, hs, rfl⟩))
    · rw [MvPolynomial.notMem_support_iff.mp hs]; exact ⟨0, by simp⟩
  have hq : ∀ s, ∃ m : ℤ, (D : ℚ) * MvPolynomial.coeff s q = (m : ℚ) := by
    intro s
    by_cases hs : s ∈ q.support
    · refine hD _ ?_
      simp only [Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inr ⟨s, hs, rfl⟩))
    · rw [MvPolynomial.notMem_support_iff.mp hs]; exact ⟨0, by simp⟩
  have hpt0 : ∀ j, ∃ m : ℤ, (D : ℚ) * constantCoeff (pt j) = (m : ℚ) := by
    intro j
    refine hD _ ?_
    simp only [Finset.mem_union, Finset.mem_image]
    exact Or.inl (Or.inr ⟨j, Finset.mem_univ j, rfl⟩)
  have hu0 : ∃ m : ℤ, (D : ℚ) * constantCoeff u = (m : ℚ) := by
    exact hD _ (Finset.mem_union_right _ (Finset.mem_singleton_self _))
  have hder : ∀ j, d⁄dX ℚ (pt j) = 1 ∨ (∃ j', d⁄dX ℚ (pt j) = pt j') ∨
      d⁄dX ℚ (pt j) = MvPolynomial.aeval pt p * u := by
    intro j
    refine Fin.cases ?_ (fun i => ?_) j
    · left; rw [hptz, derivative_X]
    · have hi1 : d⁄dX ℚ (pt i.succ) = (d⁄dX ℚ)^[i.val + 1] f := by
        rw [hpts, Function.iterate_succ_apply']
      rw [hi1]
      by_cases hi : i.val + 1 < n
      · right; left
        exact ⟨Fin.succ ⟨i.val + 1, hi⟩, (hpts ⟨i.val + 1, hi⟩).symm⟩
      · right; right
        have hin : i.val + 1 = n := by omega
        rw [hin, hn]
  obtain ⟨B, hint, hst, hptB, hPvB, huB⟩ := stage D pt p q u hu hp hq hpt0 hu0 hder
  have hf : (D : ℚ⟦X⟧) ^ (p.totalDegree + 2) * f ∈ B := by
    by_cases h0 : 0 < n
    · have h1 := hptB (Fin.succ ⟨0, h0⟩)
      rw [hpts] at h1
      have e : (D : ℚ⟦X⟧) ^ (p.totalDegree + 2) * f
          = (D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * ((D : ℚ⟦X⟧) * f) := by ring
      rw [e]; exact B.mul_mem (B.pow_mem (natCast_mem B D) _) h1
    · have h0' : n = 0 := by omega
      have hf' : (d⁄dX ℚ)^[n] f = f := by rw [h0']; rfl
      have e : (D : ℚ⟦X⟧) ^ (p.totalDegree + 2) * f
          = ((D : ℚ⟦X⟧) ^ (p.totalDegree + 1) * MvPolynomial.aeval pt p) * ((D : ℚ⟦X⟧) * u) := by
        rw [← hf', hn]; ring
      rw [e]; exact B.mul_mem hPvB huB
  exact ⟨D ^ (p.totalDegree + q.totalDegree + 3 + (p.totalDegree + 2)), Nat.pow_pos hDpos,
    fun k => conclude D f B _ _ hint hst hf k⟩

end LamLittAuxS1

open LamLitt PowerSeries in
theorem solution {n : ℕ} (f : PowerSeries ℚ)
    (g : MvRatFunc (Fin (n + 1)) ℚ) (hODE : IsSolutionOfAlgebraicODE n f g) :
    ∃ D : ℕ, 0 < D ∧ ∀ k : ℕ, ∃ m : ℤ,
      (D : ℚ) ^ (k + 1) * ((k.factorial : ℚ) * PowerSeries.coeff k f) = (m : ℚ) := by
  obtain ⟨p, q, -, hq0, heq⟩ := hODE
  exact LamLittAuxS1.main f _ rfl p q hq0 heq
