    intro i hi; have := hrow i hi; rw [hfs, sum_insert hjL'] at this; exact this
  have hηh : η ≤ 1 / 2 := by
    have : 0 ≤ ((n : ℝ) + 1) ^ 2 / S := by positivity
    linarith
  have hrj := hrow' j (List.mem_cons_self ..)
