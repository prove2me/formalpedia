theorem solution (R : Type) [CommRing R] (t x : R) (hreg : TypeDensity.RegularParameterPair R t x)
    (j : ℕ) :
    LinearMap.ker (TypeDensity.surfaceToCechInput R t x j) = (Ideal.span {t,x})^j := by
  ext r
  rw [TypeDensity.mem_ker_surfaceToCechInput_iff]
  constructor
  · rintro ⟨hA, -⟩
    induction j generalizing r with
    | zero => simp
    | succ j ih =>
      exact TypeDensity.mem_span_pow_succ_of_chartBase_mem R t x hreg j r
          (ih r (Ideal.pow_le_pow_right (Nat.le_succ j) hA)) hA
  · intro hr
    refine ⟨TypeDensity.chartBase_mem_chartExceptional_pow R t x j r hr, ?_⟩
    rw [Set.pair_comm] at hr
    exact TypeDensity.chartBase_mem_chartExceptional_pow R x t j r hr
