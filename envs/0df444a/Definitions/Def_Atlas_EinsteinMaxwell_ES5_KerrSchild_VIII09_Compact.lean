noncomputable def J (k m : ℕ) (x : ℝ) : ℝ :=
  ∫ t in (0:ℝ)..1, t ^ k * (1 - t * x)⁻¹ ^ (m + 1)

/-! ## Definitions of the six probe profiles -/

noncomputable def Hc (x : ℝ) : ℝ := J 0 0 x
noncomputable def Gc (x : ℝ) : ℝ := J 1 0 x
noncomputable def HcD (x : ℝ) : ℝ := J 1 1 x
noncomputable def GcD (x : ℝ) : ℝ := J 2 1 x
noncomputable def HcDD (x : ℝ) : ℝ := 2 * J 2 2 x
noncomputable def GcDD (x : ℝ) : ℝ := 2 * J 3 2 x

/-! ## Continuity of the probe profiles -/

 

/-! ## Continuity of the second derivative profiles -/

/-! ## C² regularity -/

/-! ## Endpoint values from the integrals -/

/-! ## The averaged-logarithm profiles -/

/-- `Ubar x = -(2-3x) H x / 36 - 1/24 - x/4 + 3x²/16`. -/
noncomputable def Ubar (x : ℝ) : ℝ := -(2 - 3 * x) * Hc x / 36 - 1 / 24 - x / 4 + 3 * x ^ 2 / 16

/-- `Zbar x = -G x / 24 + (4+3x) H x / 72 - 1/12 - x/4 + 3x²/16`. -/
noncomputable def Zbar (x : ℝ) : ℝ := -Gc x / 24 + (4 + 3 * x) * Hc x / 72 - 1 / 12 - x / 4
  + 3 * x ^ 2 / 16

/-- `Zbar' x = -G' x / 24 + H x / 24 + (4+3x) H' x / 72 - 1/4 + 3x/8`. -/
noncomputable def ZbarD (x : ℝ) : ℝ := -GcD x / 24 + Hc x / 24 + (4 + 3 * x) * HcD x / 72
  - 1 / 4 + 3 * x / 8

/-! ## The two closed identities: `H - x G = 1` and `x H = -log (1-x)` -/

/-! ## Endpoint values of the profiles -/

/-! ## Transport: the anchor profiles are the transported compact profiles -/

/-! ## The closed cubic source profiles -/

/-- `n x = 1 - 4x + 3x²` (the compactified `N / R² · R²` factor). -/
noncomputable def nG (x : ℝ) : ℝ := 1 - 4 * x + 3 * x ^ 2

/-- The closed Maxwell cubic source `Q3 x = (3/8)[2Z̄ - Ū + n(Z̄ + x Z̄′) + (8-9x)x Ū]`. -/
noncomputable def Q3 (x : ℝ) : ℝ :=
  (3 / 8) * (2 * Zbar x - Ubar x + nG x * (Zbar x + x * ZbarD x) + (8 - 9 * x) * x * Ubar x)

/-- The closed angular cubic source `R3 x = (-2 + 9x/4)(Ū + Z̄)`. -/
noncomputable def R3 (x : ℝ) : ℝ := (-2 + 9 * x / 4) * (Ubar x + Zbar x)

/-- The actual Maxwell cubic source, `q3_j x = j³ Q3 x`. -/
noncomputable def q3j (j : ℝ) (x : ℝ) : ℝ := j ^ 3 * Q3 x

/-- The actual angular cubic source, `r3_j x = j³ R3 x`. -/
noncomputable def r3j (j : ℝ) (x : ℝ) : ℝ := j ^ 3 * R3 x

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VIII09


