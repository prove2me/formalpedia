  exact NLogN.Rsp.gresP_okc M mm Φ B (2 * p) 1 hM s0 _ U _ _ _ _ t RU LKs LKa LKN LR LN LNR LNW RW RD hs
    (NLogN.Rsp.sOff_lt _ _ hs) (NLogN.Rsp.sTab_length p _ t α) (NLogN.Rsp.sTab_rows p _ t α) (NLogN.Rsp.sDel_length _ t)
    (NLogN.Rsp.pre_sDel_le _ t ht) hU hKs hKa hKN hR hN hNR hNW hW hD rfl hu hWB hAcc hmB hLB hpB hnB htB
