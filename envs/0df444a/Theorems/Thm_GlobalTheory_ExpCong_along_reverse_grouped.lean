variable {A k ι : Type} [CommRing A] [CommRing k] (D : ι → A → A) (c : A →+* k)

theorem GlobalTheory.ExpCong.along_reverse_grouped (L : List ι) (m : ι → ℕ) (f : A) :
    along D (grouped L m).reverse f = L.foldr (fun l g => (D l)^[m l] g) f := by sorry
