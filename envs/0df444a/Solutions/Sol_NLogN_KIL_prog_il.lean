theorem valid_app_split {X Y : Shape} {a : List ℕ} (h : Valid (X ++ Y) a) :
    ∃ a1 a2, a = a1 ++ a2 ∧ Valid X a1 ∧ Valid Y a2 := by
  induction X generalizing a with
  | nil => exact ⟨[], a, rfl, List.Forall₂.nil, h⟩
  | cons x X ih =>
    rcases h with _ | ⟨hx, h⟩
    obtain ⟨a1, a2, rfl, h1, h2⟩ := ih h
    exact ⟨_ :: a1, a2, rfl, List.Forall₂.cons hx h1, h2⟩

theorem valid_cons_split {q : ℕ} {Y : Shape} {a : List ℕ} (h : Valid (q :: Y) a) :
    ∃ y a', a = y :: a' ∧ y < q ∧ Valid Y a' := by
  rcases h with _ | ⟨hx, h⟩
  exact ⟨_, _, rfl, hx, h⟩

