/-!
# B-line IL, B1 follow-up: building the control list, §3 list facts and the pair transfer

* `pos src argOf j`: the input position after the first `j` output slabs; `pos_succ`, `pos_mono`,
  `pos_le_n`, `sum_tele` (the drops of the entries telescope to `pos`).
* `length_ctlOf`: `|ctlOf n n' src argOf| = n + n'` for a monotone source.
* `srcTab_drop`: the table seen from entry `j`.
* `pairMove_runs`: `rptX X (mv i j; mv i j)` moves a reversed list of `2L` entries back in order.
* `cS_upd_G`, `cS_self`: the builder state over other registers.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## Positions -/

variable {n n' : ℕ} {src : ℕ → Option ℕ} (argOf : ℕ → ℤ)

/-! ## The pair transfer -/

section pm
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- **Moving a reversed list of pairs back**, `rptX X (mv i j; mv i j)`. -/
theorem pairMove_runs_sol_aux {i j X : Fin HS} (hij : i ≠ j) (hXA : X ≠ lA)
    (Φ : List ℤ → List ℤ → Fin HS → List ℤ) (hi : ∀ A B, Φ A B i = A) (hj : ∀ A B, Φ A B j = B)
    (hup : ∀ A B v w, update (update (Φ A B) i v) j w = Φ v w)
    (hA : ∀ A B, Φ A B lA = []) (hC : ∀ A B, Φ A B lC = []) (hD : ∀ A B, Φ A B lD = [])
    (L : ℕ) {LM : List ℤ} (hX : ∀ A B, Φ A B X = (L : ℤ) :: LM) (fc A0 B0 : List ℤ)
    (hfc : fc.length = 2 * L) {Z : ℕ} (hZ : ∀ y ∈ fc, zsz y ≤ Z) (s : IState HS) :
    IRuns I iprog (rptX X lA lC lD (.seq (.op (.mv i j)) (.op (.mv i j))))
      (encK s (Φ (fc.reverse ++ A0) B0)) (encK s (Φ A0 (fc ++ B0)))
      (L * (2 * cU Z) + 3000 * (L + 1)) := by
  have H := loopMV (I := I) (iprog := iprog) hXA L s
    (fun t => Φ ((fc.take (2 * L - 2 * t)).reverse ++ A0) (fc.drop (2 * L - 2 * t) ++ B0))
    (fun t => hA _ _) (fun t => hC _ _) (fun t => hD _ _) (LM := LM) (hX _ _)
    (.seq (.op (.mv i j)) (.op (.mv i j))) (fun _ => 2 * cU Z) ?_
  · simp only [Finset.sum_const, Finset.card_range, smul_eq_mul, Nat.mul_zero, Nat.sub_zero,
      Nat.sub_self, List.take_zero, List.drop_zero, List.reverse_nil, List.nil_append] at H
    rw [List.take_of_length_le (by omega), List.drop_of_length_le (by omega),
      List.nil_append] at H
    exact H
  · intro t ht s'
    obtain ⟨r, hr⟩ : ∃ r, 2 * L - 2 * t = r + 2 := ⟨2 * L - 2 * t - 2, by omega⟩
    have hr' : 2 * L - 2 * (t + 1) = r := by omega
    have hrl : r + 1 < fc.length := by omega
    rw [hr, hr']
    have ed : fc.drop r = fc[r] :: fc[r + 1] :: fc.drop (r + 2) := by
      rw [List.drop_eq_getElem_cons (by omega), List.drop_eq_getElem_cons hrl]
    have et : fc.take (r + 2) = fc.take r ++ [fc[r], fc[r + 1]] := by
      rw [List.take_add, ed]; rfl
    rw [et, ed, List.reverse_append]
    simp only [List.reverse_cons, List.reverse_nil, List.nil_append, List.singleton_append,
      List.cons_append, List.append_assoc]
    have m1 := mvM (I := I) (iprog := iprog) s'
      (Φ (fc[r + 1] :: fc[r] :: ((fc.take r).reverse ++ A0)) (fc.drop (r + 2) ++ B0)) hij
      (hi _ _)
    rw [hj, hup] at m1
    have m2 := mvM (I := I) (iprog := iprog) s'
      (Φ (fc[r] :: ((fc.take r).reverse ++ A0)) (fc[r + 1] :: (fc.drop (r + 2) ++ B0))) hij
      (hi _ _)
    rw [hj, hup] at m2
    refine (m1.seq m2).mono ?_
    have c1 := NLogN.KFUU.mv_le_cU (hZ _ (List.getElem_mem hrl))
    have c2 := NLogN.KFUU.mv_le_cU (hZ _ (List.getElem_mem (show r < fc.length by omega)))
    omega

end pm

