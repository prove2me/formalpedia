namespace QEC.Coding.BDL26RXLocalReplacement
theorem _root_.solution
    {Vertex Edge : Type} [Fintype Vertex] [Fintype Edge]
    [DecidableEq Vertex] [DecidableEq Edge]
    (edgeStart edgeEnd : Edge → Vertex) (root vertex : Vertex)
    (path : UndirectedPath edgeStart edgeEnd root vertex)
    (word : Word Field Vertex)
    (hword : wordLinearMapTranspose (graphBoundary edgeStart edgeEnd) word = 0) :
    word vertex = word root := by
  induction path with
  | nil => rfl
  | @step u v path edge connects ih =>
      have hedge := congrFun hword edge
      rw [wordLinearMapTranspose_graphBoundary_apply] at hedge
      change word (edgeStart edge) + word (edgeEnd edge) = 0 at hedge
      have heq : word (edgeStart edge) = word (edgeEnd edge) := by
        rw [← sub_eq_zero]
        simpa [sub_eq_add_neg, neg_eq_self] using hedge
      rcases connects with connects | connects
      · calc
          word v = word (edgeEnd edge) := congrArg word connects.2.symm
          _ = word (edgeStart edge) := heq.symm
          _ = word u := congrArg word connects.1
          _ = word root := ih
      · calc
          word v = word (edgeStart edge) := congrArg word connects.1.symm
          _ = word (edgeEnd edge) := heq
          _ = word u := congrArg word connects.2
          _ = word root := ih
end QEC.Coding.BDL26RXLocalReplacement
