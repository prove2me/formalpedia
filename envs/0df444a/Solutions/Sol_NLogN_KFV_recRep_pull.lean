section Pull

variable {α : Type*}

theorem getD_pull' (sh sh' : Shape) (g : List ℕ → List ℕ) (d : α) (xs : List α) {j : ℕ}
    (hj : j < vol sh') : (pull sh sh' g d xs).getD j d = xs.getD (encode sh (g (decode sh' j))) d := by
  rw [List.getD_eq_getElem _ _ (by simp; exact hj), getElem_pull]

/-- Entry `(j, c)` of the extended pull. -/
theorem getD_pull_snoc (sh : Shape) (r : ℕ) {g : List ℕ → List ℕ}
    (hg : ∀ a, Valid sh a → Valid sh (g a)) (d : α) (zs : List α) {j c : ℕ} (hj : j < vol sh)
    (hc : c < r) :
    (pull (sh ++ [r]) (sh ++ [r]) (extA sh.length g) d zs).getD (j * r + c) d =
      zs.getD (encode sh (g (decode sh j)) * r + c) d := by
  have hr : 0 < r := by omega
  have hjr : j * r + c < vol sh * r := by
    have : (j + 1) * r ≤ vol sh * r := Nat.mul_le_mul_right _ hj
    nlinarith
  rw [getD_pull' _ _ _ _ _ (by rw [vol_append]; simpa using hjr), KFS.decode_snoc sh r hjr]
  have e1 : (j * r + c) / r = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt hc, zero_add]
  have e2 : (j * r + c) % r = c := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
  rw [e1, e2]
  have hdl : (decode sh j).length = sh.length := AModel.length_decode _ _
  unfold extA
  rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega),
    List.drop_append_of_le_length (by omega), List.drop_of_length_le (by omega), List.nil_append,
    KFS.encode_snoc sh r (hg _ (valid_decode hj)).length_eq]

end Pull

