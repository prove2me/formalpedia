variable {K : Type} [Field K] (U : PowerSeries K)

theorem ReciprocityTheory.ChartRestriction.L1.homS_monomial (m i : ℕ) (hi : i ≤ m) (a : K) :
    homS U m (monomial i a) = PowerSeries.C a * U ^ i * PowerSeries.X ^ (2 * (m - i)) := by sorry
