theorem hne_closed_bare
    (𝒟 : X2ToricEig.Pkg N q A) (hlq : lam ≠ q)
    (g : CuspForm (CongruenceSubgroup.Gamma0 (N * q)) 2) (hg : g.IsNewform)
    (hsmul : ∀ (a : ℤ_[lam]) (x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) (n : ℕ),
      ((a • x : ↥(ModularCurve.TateModule lam (JZero (N * q)))) : ℕ → JZero (N * q)) n =
