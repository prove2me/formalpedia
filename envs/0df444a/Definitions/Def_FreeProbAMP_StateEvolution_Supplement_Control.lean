-- title:
--   Admissible Brownian controls (3.1)–(3.2) and the control cost $J_\alpha$ (3.3)
-- statement:
--   Let $(B_t)_{t\ge0}$ be a real process on a probability space $(\Omega,\mathcal F,\mathbb P)$ and let $\mathbb F=(\mathcal F_t)_{t\ge0}$ be its completed natural filtration: $\mathcal F_t$ is generated by $(B_s)_{s\le t}$ and the $\mathbb P$-null sets.
--
--   For a horizon $T\ge0$, a process $b=(b_t)_{t\ge0}$ is an **admissible control** if
--
--   1. $b$ is $\mathbb F$-predictable;
--   2. $b_s\ge0$ almost surely for every $s\ge0$;
--   3. $\int_0^T\mathbb E[b_s^2]\,ds<\infty$;
--   4. the Itô integral $G_t=\int_0^t b_s\,dB_s$ satisfies $G_T\in\{-1,+1\}$ almost surely.
--
--   These are conditions (3.1)–(3.2). For $\alpha>0$ the **control cost** (3.3) is
--
--   $$J_\alpha(b)=\int_0^T\Big(\sqrt{\mathbb E[b_s^2]}-\sqrt\alpha\,\mathbb E[b_s]\Big)^2ds .$$
--
--   The cost measures, time by time, how far the second moment of the control is from $\alpha$ times its squared mean; it is the quantity that governs the spectral norm achieved by the signing algorithm of Theorem 3.2.
--
--   **Formalization Note.** The filtration is the published `ABPOnline.brownFiltration` (augmentation by the measurable null sets). Predictability is Mathlib's `IsStronglyPredictable`. The Itô integral is the published relation `You2015.Shared.IsItoIntegral` (an $L^2$ limit of simple adapted integrals) applied to $b_s\mathbf 1_{\{s\le T\}}$, so that $G_t=\int_0^{t\wedge T}b_s\,dB_s$. Time integrals are lower Lebesgue integrals over $s\in[0,T]$; $J_\alpha$ is converted to a real number and is finite for admissible controls.
-- source:
--   August Chen, Ahmed El Alaoui, STOC 2027 submission #1182 (October 2026), pp. 6–7, (3.1)–(3.3)

import Mathlib
import Definitions.Def_ABPOnline_brownFiltration
import Definitions.Def_You2015_Shared_Ito

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal
set_option autoImplicit false
noncomputable section

namespace FreeProbAMP.StateEvolution.Supplement

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The completed natural filtration `𝔽 = (𝓕_t)_{t ≥ 0}` of the Brownian motion `B`
(Chen–El Alaoui, STOC 2027 submission #1182, p. 6): the published
`ABPOnline.brownFiltration`, i.e. `σ(B_s : s ≤ t)` augmented by the `P`-null sets. -/
abbrev brownianFiltration (P : Measure Ω) (B : ℝ≥0 → Ω → ℝ) : Filtration ℝ≥0 ‹MeasurableSpace Ω› :=
  ABPOnline.brownFiltration P B

/-- A control satisfying (3.1)–(3.2), submission pp. 6–7, for the horizon `T ≥ 0`:
`b = (b_t)_{t ≥ 0}` is predictable for the completed natural filtration of `B`,
`b_s ≥ 0` almost surely for every `s`, `∫_0^T E[b_s^2] ds < ∞`, and the Itô integral
`G_t = ∫_0^t b_s dB_s` satisfies `G_T ∈ {-1, +1}` almost surely.

The Itô integral is the published relation `You2015.Shared.IsItoIntegral` applied to the
integrand `b_s 1_{s ≤ T}`, so that `G_t = ∫_0^{t ∧ T} b_s dB_s`; its value at `T` is the
source's `G_T`. -/
def AdmissibleControl (P : Measure Ω) (B : ℝ≥0 → Ω → ℝ) (T : ℝ≥0)
    (b : ℝ≥0 → Ω → ℝ) : Prop :=
  IsStronglyPredictable (brownianFiltration P B) b ∧
  (∀ s : ℝ≥0, ∀ᵐ ω ∂P, 0 ≤ b s ω) ∧
  (∫⁻ s in Set.Icc (0 : ℝ) T, ∫⁻ ω, ‖b s.toNNReal ω‖ₑ ^ 2 ∂P) < ⊤ ∧
  ∃ G : ℝ≥0 → Ω → ℝ,
    You2015.Shared.IsItoIntegral P (brownianFiltration P B) B
      (fun s ω => if s ≤ T then b s ω else 0) G ∧
    ∀ᵐ ω ∂P, G T ω = 1 ∨ G T ω = -1

/-- The control cost (3.3), submission p. 7:
`J_α(b) = ∫_0^T ( √(E[b_s^2]) - √α · E[b_s] )^2 ds`.
The outer integral is a lower Lebesgue integral of a nonnegative integrand, converted to a
real number; for an admissible control it is finite. -/
def controlCost (P : Measure Ω) (α : ℝ) (T : ℝ≥0) (b : ℝ≥0 → Ω → ℝ) : ℝ :=
  (∫⁻ s in Set.Icc (0 : ℝ) T,
    ENNReal.ofReal ((Real.sqrt (∫ ω, b s.toNNReal ω ^ 2 ∂P)
      - Real.sqrt α * ∫ ω, b s.toNNReal ω ∂P) ^ 2)).toReal

end FreeProbAMP.StateEvolution.Supplement


