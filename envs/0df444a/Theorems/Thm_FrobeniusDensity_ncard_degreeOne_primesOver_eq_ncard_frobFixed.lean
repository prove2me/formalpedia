-- title:
--   Degree-one primes over ℓ count Frobenius-fixed cosets of G/H
-- statement:
--   Let $L$ be a number field that is Galois over $\mathbb{Q}$, write $G = L \simeq_{\mathbb{Q}} L$ for its automorphism group, let $H \le G$ be a subgroup and let $E$ be an intermediate field of $L/\mathbb{Q}$ with `IsGaloisGroup H E L`, i.e. $H$ is the Galois group of $L/E$. Let $\ell$ be a prime number and let $Q_0$ be a prime ideal of $\mathcal{O}_L$ lying over the ideal of $\mathbb{Z}$ generated by $\ell$, namely [`FrobeniusDensity.ratPrimeIdeal ℓ`](def/TaylorWiles_Primes.html#L42) $= (\ell)$, and assume the inertia subgroup `Q₀.inertia (L ≃ₐ[ℚ] L)` is trivial. Since $Q_0$ lies over $(\ell)$ it is non-zero, so the residue ring $\mathcal{O}_L / Q_0$ is finite, which is what makes the arithmetic Frobenius `arithFrobAt ℤ (L ≃ₐ[ℚ] L) Q₀` $\in G$ available. The assertion is an equality of two cardinalities, each taken as the `Set.ncard` of a set: on one side, the set of prime ideals $\mathfrak{q}$ of $\mathcal{O}_E$ lying over $(\ell)$ whose residue ring $\mathcal{O}_E/\mathfrak{q}$ has exactly $\ell$ elements (that is, the degree-one primes of $E$ above $\ell$); on the other, the set of cosets $x \in G/H$ fixed by the action of $\mathrm{arithFrobAt}(Q_0)$.
--
--   This is the orbit-counting step of Frobenius's density theorem, converting the number of degree-one primes of $E = L^H$ above $\ell$ into a count of cosets in $G/H$ fixed by a Frobenius element at a chosen prime above $\ell$. It feeds the density statement [`FrobeniusDensity.statement_of_degOneAsymptotic`](thm.html#FrobeniusDensity.statement_of_degOneAsymptotic) and is used in the Langlands–Tunnell part via [`LanglandsTunnell.towerDirichletDensity_add_of_orderOf_eq_eight`](thm.html#LanglandsTunnell.towerDirichletDensity_add_of_orderOf_eq_eight).
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_FrobeniusDensity_ncard_degreeOne_primesOver_eq_ncard_frobFixed.lean

import Definitions.Def_TaylorWiles_Primes
import Mathlib.NumberTheory.RamificationInertia.Galois
import Mathlib.FieldTheory.Fixed
import Mathlib.GroupTheory.GroupAction.Quotient

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

open NumberField Ideal

theorem FrobeniusDensity.ncard_degreeOne_primesOver_eq_ncard_frobFixed
    {L : Type*} [Field L] [NumberField L] [IsGalois ℚ L]
    {H : Subgroup (L ≃ₐ[ℚ] L)} {E : IntermediateField ℚ L} [IsGaloisGroup H E L]
    {ℓ : ℕ} (hℓ : ℓ.Prime) (Q₀ : Ideal (𝓞 L)) [Q₀.IsPrime]
    [Q₀.LiesOver (FrobeniusDensity.ratPrimeIdeal ℓ)] (hinertia : Q₀.inertia (L ≃ₐ[ℚ] L) = ⊥) :
    haveI : Finite ((𝓞 L) ⧸ Q₀) :=
      FrobeniusDensity.finite_quotient_of_ne_bot
        (FrobeniusDensity.ne_bot_of_liesOver_ratPrimeIdeal hℓ)
    {𝔮 ∈ (FrobeniusDensity.ratPrimeIdeal ℓ).primesOver (𝓞 E) |
      Nat.card ((𝓞 E) ⧸ 𝔮) = ℓ}.ncard
      = {x : (L ≃ₐ[ℚ] L) ⧸ H | arithFrobAt ℤ (L ≃ₐ[ℚ] L) Q₀ • x = x}.ncard := by sorry
