/-- Level-dependent version of `power_width_time`. -/
theorem batch_time (m W s : ℕ) (lam C C₀ : ℝ) (hm : 2 ≤ m) (hW : 1 ≤ W)
    (hs : (s : ℝ) / W < (m : ℝ) ^ lam) (hC : 0 ≤ C) (hC₀ : 0 ≤ C₀) :
    ∃ K₁ : ℝ, 0 ≤ K₁ ∧ ∀ (u : ℝ), 0 ≤ u → ∀ T : ℕ → ℝ → ℝ,
      (∀ V, 0 ≤ V → T 0 V ≤ C₀ * V * u) →
      (∀ k V, 0 ≤ V → T (k + 1) V ≤ C * V * (u * (m : ℝ) ^ (k + 1)) ^ lam
          + s * T k (V / W)) →
      ∀ k V, 0 ≤ V → T k V ≤ V * (K₁ * (u * (m : ℝ) ^ k) ^ lam + C₀ * ((s : ℝ) / W) ^ k * u) := by
  set a : ℝ := (s : ℝ) / W
  set b : ℝ := (m : ℝ) ^ lam
  have hm0 : (0 : ℝ) < m := by exact_mod_cast (show 0 < m by omega)
  have hb : 0 < b := rpow_pos_of_pos hm0 _
  have ha : 0 ≤ a := by positivity
  have hq : a / b < 1 := (div_lt_one hb).2 hs
  have hq0 : 0 ≤ a / b := div_nonneg ha hb.le
  refine ⟨C / (1 - a / b), div_nonneg hC (by linarith), ?_⟩
  set K₁ := C / (1 - a / b)
  have hK1 : C + a / b * K₁ = K₁ := by
    have hD : (1 - a / b) ≠ 0 := ne_of_gt (by linarith)
    show C + a / b * (C / (1 - a / b)) = C / (1 - a / b)
    rw [eq_div_iff hD, add_mul, mul_assoc, div_mul_cancel₀ _ hD]; ring
  intro u hu T h0 hstep k
  have hX : ∀ k : ℕ, (u * (m : ℝ) ^ (k + 1)) ^ lam = b * (u * (m : ℝ) ^ k) ^ lam := by
    intro k
    rw [pow_succ, ← mul_assoc, mul_rpow (by positivity) hm0.le, mul_comm]
  induction k with
  | zero =>
    intro V hV
    have := h0 V hV
    have hK0 : 0 ≤ K₁ * (u * (m : ℝ) ^ 0) ^ lam := mul_nonneg (div_nonneg hC (by linarith)) (by positivity)
    simp only [pow_zero, mul_one] at hK0 ⊢
    nlinarith
  | succ k ih =>
    intro V hV
    have hVW : 0 ≤ V / W := by positivity
    have h1 := hstep k V hV
    have h2 := ih (V / W) hVW
    have hs0 : (0 : ℝ) ≤ s := Nat.cast_nonneg s
    have h3 : (s : ℝ) * T k (V / W) ≤ s * (V / W * (K₁ * (u * (m : ℝ) ^ k) ^ lam + C₀ * a ^ k * u)) :=
      mul_le_mul_of_nonneg_left h2 hs0
    have hsV : (s : ℝ) * (V / W) = V * a := by simp only [a]; ring
    rw [hX] at h1 ⊢
    set X := (u * (m : ℝ) ^ k) ^ lam
    have e1 : (s : ℝ) * (V / W * (K₁ * X + C₀ * a ^ k * u)) = V * (a * K₁ * X + C₀ * a ^ (k + 1) * u) := by
      rw [← mul_assoc, hsV]; ring
    have e2 : a * K₁ * X = b * X * (a / b * K₁) := by field_simp
    calc T (k + 1) V ≤ C * V * (b * X) + s * T k (V / W) := h1
      _ ≤ C * V * (b * X) + V * (a * K₁ * X + C₀ * a ^ (k + 1) * u) := by linarith
      _ = V * (b * X * (C + a / b * K₁) + C₀ * a ^ (k + 1) * u) := by rw [e2]; ring
      _ = V * (K₁ * (b * X) + C₀ * a ^ (k + 1) * u) := by rw [hK1]; ring

/-- Leaf contribution: `(s/W)^k u ≤ (u m^k)^σ u^{1-σ}` when `s/W ≤ m^σ`. -/
theorem leaf_contribution (m W s k : ℕ) (σ u : ℝ) (hm : 2 ≤ m) (hu : 0 ≤ u)
    (hs : (s : ℝ) / W ≤ (m : ℝ) ^ σ) :
    ((s : ℝ) / W) ^ k * u ≤ (u * (m : ℝ) ^ k) ^ σ * u ^ (1 - σ) := by
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have h1 : ((s : ℝ) / W) ^ k ≤ ((m : ℝ) ^ σ) ^ k := pow_le_pow_left₀ (by positivity) hs k
  rcases hu.lt_or_eq with hu | hu
  · have : (u * (m : ℝ) ^ k) ^ σ * u ^ (1 - σ) = ((m : ℝ) ^ σ) ^ k * u := by
      rw [mul_rpow hu.le (by positivity), mul_comm (u ^ σ), mul_assoc, ← rpow_add hu,
        add_sub_cancel, rpow_one, ← rpow_natCast, ← rpow_natCast, ← rpow_mul hm0,
        ← rpow_mul hm0, mul_comm (k : ℝ) σ, mul_comm]
    rw [this]; exact mul_le_mul_of_nonneg_right h1 hu.le
  · subst hu; simp only [mul_zero]; positivity

/-- Combined node bound in the paper's form `O(e^λ + e^σ u^{1-σ})`. -/
theorem batch_time_sigma (m W s : ℕ) (lam σ C C₀ : ℝ) (hm : 2 ≤ m) (hW : 1 ≤ W)
    (hsσ : (s : ℝ) / W ≤ (m : ℝ) ^ σ) (hσl : σ < lam) (hC : 0 ≤ C) (hC₀ : 0 ≤ C₀) :
    ∃ K₁ : ℝ, 0 ≤ K₁ ∧ ∀ (u : ℝ), 0 ≤ u → ∀ T : ℕ → ℝ → ℝ,
      (∀ V, 0 ≤ V → T 0 V ≤ C₀ * V * u) →
      (∀ k V, 0 ≤ V → T (k + 1) V ≤ C * V * (u * (m : ℝ) ^ (k + 1)) ^ lam
          + s * T k (V / W)) →
      ∀ k V, 0 ≤ V → T k V ≤ V * (K₁ * (u * (m : ℝ) ^ k) ^ lam +
          C₀ * ((u * (m : ℝ) ^ k) ^ σ * u ^ (1 - σ))) := by
  have hm1 : (1 : ℝ) < m := by exact_mod_cast (show 1 < m by omega)
  have hs : (s : ℝ) / W < (m : ℝ) ^ lam :=
    lt_of_le_of_lt hsσ (rpow_lt_rpow_of_exponent_lt hm1 hσl)
  obtain ⟨K₁, hK₁, h⟩ := batch_time m W s lam C C₀ hm hW hs hC hC₀
  refine ⟨K₁, hK₁, fun u hu T h0 hstep k V hV => ?_⟩
  have := h u hu T h0 hstep k V hV
  have hl := leaf_contribution m W s k σ u hm hu hsσ
  have : C₀ * ((s : ℝ) / W) ^ k * u ≤ C₀ * ((u * (m : ℝ) ^ k) ^ σ * u ^ (1 - σ)) := by
    rw [mul_assoc]; exact mul_le_mul_of_nonneg_left hl hC₀
  nlinarith

end Butterfly

