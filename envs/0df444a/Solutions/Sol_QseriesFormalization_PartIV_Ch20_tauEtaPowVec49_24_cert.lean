  rw [← tauEta24List_49_eq]
  apply List.ext_getElem
  · simp [tauEta24List, tauListMul_length]
  · intro j h1 h2
    have hj : j < 49 + 1 := by simpa using h1
    have hs := tauEtaPowVec_spec ℤ 49 24 ⟨j, hj⟩
    have hf := tauEta24List_getD 49 j (by omega)
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h2, Option.getD_some] at hf
    try simp only [Int.cast_id] at hs
    rw [hf, ← hs]
    (try simp only [Vector.getElem_toList]) <;> rfl
