      = x * ((1 / b x - 1) / x * Wf b A x - c1E h Q x (F x) (b x) ((F x / b x - 1) / x) * Vf A x
        - d1E h Q J x (F x) (b x)) := by
  filter_upwards [ev_ne, S.eb, ev_u h, S.cb, S.cA, S.hPA] with x hx hb hu cb cA hPA
    using (maxwell_deriv hx hb hu cb cA hPA).2
theorem dder : ∀ᶠ x in 𝓝[>] (0:ℝ),
    x * deriv (fun y => Df F b y + h) x + 2 * (Df F b x + h)
      = x * rdE h Q J x (F x) (b x) (Zf h F x) (Vf A x) (Wf b A x) (Df F b x) (rf b x)
          ((F x - 1) / x) := by
  filter_upwards [ev_ne, S.eF, S.eb, ev_u h, S.cF, S.cb, S.hPC] with x hx hF hb hu cF cb hPC
  rw [deriv_add_const]
  exact d_deriv hx hF hb hu cF cb hPC

end Std

