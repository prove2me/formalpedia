/-!
# Round six: the crude depth guard (PR15 REPORT part B, ARCH G1)

`A e` is the coefficient-dependency depth of a `C`-layer of width `e` (OpenAI §5.4).  At width
`e ≥ T` a node is a sequence of at most `s` child invocations, each of width `≤ (m-1)e/m`
(stated as `m * c ≤ (m-1) * e`), plus `E` arithmetic of its own:
`A e ≤ E + Σ_{c ∈ cs} A c`.  Below the threshold `T` the depth is at most `L`.

* `R6.guard_gen`: `A e ≤ (E+L) (2 s^{max 0 (m (log e - log T) + 1)} - 1)` (any `s ≥ 2`).
* `R6.crude_guard`: with `T = d^β`, `L = 8 d^β`, for `e ≤ d`:
  `A e ≤ 2 (E + 8 d^β) s^{1 + m (1-β) log d}`.
* `R6.crude_guard_single`: the same for the one-child form `A e ≤ E + s A ((m-1) e / m)`.
* `R6.crude_guard_pow`: `A e ≤ C₀ d^{β + m(1-β) log s}`, `C₀ = 2 s (E+8)`.
* `R6.crude_guard_C1`, `R6.crude_guard_nat`: `A e ≤ C₀ d^{C1}` for `C1 ≥ 2 + m log s`
  (natural-number form for a guard width `Δ = C₀ d^{C1}`).
* `R6.level_unroll`: the level-indexed form `D (k+1) ≤ E + s D k` (the shape of `KFN.Eb L s`):
  `D k ≤ (E + D 0) (2 s^k - 1)`.

`s ≥ 2` is needed (for `s = 1` the depth is `≈ k E`, not `O(E)`).
-/

namespace R6

open Real

/-- **Crude depth guard** (several children). -/
theorem crude_guard_sol_aux (E : ℝ) (s m : ℕ) (d β : ℝ) (A : ℕ → ℝ) (hm : 2 ≤ m) (hs : 2 ≤ s)
    (hβ : 0 ≤ β ∧ β ≤ 1) (hd : 1 ≤ d) (hE : 0 ≤ E)
    (hrec : ∀ e : ℕ, d ^ β ≤ e → ∃ cs : List ℕ, cs.length ≤ s ∧
      (∀ c ∈ cs, m * c ≤ (m - 1) * e) ∧ A e ≤ E + (cs.map A).sum)
    (hleaf : ∀ e : ℕ, (e : ℝ) < d ^ β → A e ≤ 8 * d ^ β) :
    ∀ e : ℕ, (e : ℝ) ≤ d → A e ≤ 2 * (E + 8 * d ^ β) * (s : ℝ) ^ (1 + m * (1 - β) * Real.log d) := by
  have hd0 : 0 < d := by linarith
  have hT : 0 < d ^ β := Real.rpow_pos_of_pos hd0 β
  have hg := guard_gen E (8 * d ^ β) (d ^ β) s m A hm hs hE (by positivity) hT hrec hleaf
  intro e he
  have hs1 : (1 : ℝ) ≤ s := by exact_mod_cast (by omega : 1 ≤ s)
  have hlogd : 0 ≤ Real.log d := Real.log_nonneg hd
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hlT : Real.log (d ^ β) = β * Real.log d := Real.log_rpow hd0 β
  have hle : max 0 ((m : ℝ) * (Real.log e - Real.log (d ^ β)) + 1) ≤ 1 + m * (1 - β) * Real.log d := by
    apply max_le (by have : 0 ≤ (m : ℝ) * (1 - β) * Real.log d := by
                       have : 0 ≤ 1 - β := by linarith
                       positivity
                     linarith)
    have hle' : Real.log e ≤ Real.log d := by
      rcases Nat.eq_zero_or_pos e with h | h
      · subst h; simp [hlogd]
      · exact Real.log_le_log (by exact_mod_cast h) he
    rw [hlT]
    have : (m : ℝ) * (Real.log e - β * Real.log d) ≤ m * (Real.log d - β * Real.log d) :=
      mul_le_mul_of_nonneg_left (by linarith) hm0
    nlinarith
  have hp := Real.rpow_le_rpow_of_exponent_le hs1 hle
  have hp1 : (1 : ℝ) ≤ (s : ℝ) ^ (max 0 ((m : ℝ) * (Real.log e - Real.log (d ^ β)) + 1)) :=
    Real.one_le_rpow hs1 (le_max_left _ _)
  have hEL : 0 ≤ E + 8 * d ^ β := by positivity
  calc A e ≤ _ := hg e
    _ ≤ (E + 8 * d ^ β) * (2 * (s : ℝ) ^ (1 + m * (1 - β) * Real.log d)) := by
        apply mul_le_mul_of_nonneg_left _ hEL; linarith
    _ = _ := by ring

end R6

end

theorem solution : type_of% @R6.crude_guard_sol_aux := @R6.crude_guard_sol_aux
