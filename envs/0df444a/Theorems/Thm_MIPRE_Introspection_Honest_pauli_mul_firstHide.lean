variable {F ι : Type*} [Field F] [Fintype F] [DecidableEq F] [Algebra (ZMod 2) F]
  [Fintype ι] [DecidableEq ι] {ℓ : ℕ}

theorem MIPRE.Introspection.Honest.pauli_mul_firstHide (P : CL.CLFun F ι ℓ) (x : ι → F)
    (v : (ι → F) × (ι → F) × (ι → F)) :
    proj wX x * firstHideOp P v = if firstHideAnswer P x = v then proj wX x else 0 := by sorry
