open IsDedekindDomain NumberField

section

variable {L : Type*} [NormedField L]

private theorem coe_mul_apply_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (i j : Fin 3) :
    ((t * k : GL (Fin 3) L) : Matrix (Fin 3) (Fin 3) L) i j = d i * (k : Matrix (Fin 3) (Fin 3) L) i j := by
  rw [Units.val_mul, ht, Matrix.diagonal_mul]

private theorem lastRowSup_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (h2 : d 2 = 1) :
    lastRowSup (t * k) = lastRowSup k := by
  simp only [lastRowSup, coe_mul_apply_of_coe_eq_diagonal t k d ht, h2, one_mul]

private theorem lastRowEucl_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (h2 : d 2 = 1) :
    lastRowEucl (t * k) = lastRowEucl k := by
  simp only [lastRowEucl, coe_mul_apply_of_coe_eq_diagonal t k d ht, h2, one_mul]

private theorem bottomMinor_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (j j' : Fin 3) :
    bottomMinor (t * k) j j' = d 1 * d 2 * bottomMinor k j j' := by
  simp only [bottomMinor, coe_mul_apply_of_coe_eq_diagonal t k d ht]
  ring

private theorem minorSup_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (h2 : d 2 = 1) :
    minorSup (t * k) = ‖d 1‖ * minorSup k := by
  simp only [minorSup, bottomMinor_mul_of_coe_eq_diagonal t k d ht, h2, mul_one, norm_mul]
  rw [mul_max_of_nonneg _ _ (norm_nonneg _), mul_max_of_nonneg _ _ (norm_nonneg _)]

private theorem minorEucl_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) (h2 : d 2 = 1) :
    minorEucl (t * k) = ‖d 1‖ * minorEucl k := by
  simp only [minorEucl, bottomMinor_mul_of_coe_eq_diagonal t k d ht, h2, mul_one, norm_mul]
  rw [show ∀ x y z : ℝ, (‖d 1‖ * x) ^ 2 + (‖d 1‖ * y) ^ 2 + (‖d 1‖ * z) ^ 2 =
      ‖d 1‖ ^ 2 * (x ^ 2 + y ^ 2 + z ^ 2) from fun x y z => by ring,
    Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (norm_nonneg _)]

private theorem detSize_mul_of_coe_eq_diagonal (t k : GL (Fin 3) L) (d : Fin 3 → L)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal d) :
    detSize (t * k) = ‖d 0 * d 1 * d 2‖ * detSize k := by
  simp only [detSize, Units.val_mul, ht, Matrix.det_mul, Matrix.det_diagonal, norm_mul, Fin.prod_univ_three]

private theorem detSize_mul_lastRow_div_minor_sq_mul (t k : GL (Fin 3) L) (b c : L) (hc : c ≠ 0)
    (ht : (t : Matrix (Fin 3) (Fin 3) L) = Matrix.diagonal ![b * c, c, 1]) (r m : GL (Fin 3) L → ℝ)
    (hr : r (t * k) = r k) (hm : m (t * k) = ‖c‖ * m k) :
    detSize (t * k) * r (t * k) / m (t * k) ^ 2 = ‖b‖ * (detSize k * r k / m k ^ 2) := by
  rw [detSize_mul_of_coe_eq_diagonal t k _ ht, hr, hm]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons,
    mul_one, norm_mul]
  have hc' : ‖c‖ ≠ 0 := norm_ne_zero_iff.2 hc
  rw [show (‖c‖ * m k) ^ 2 = ‖c‖ * ‖c‖ * m k ^ 2 by ring,
    show ‖b‖ * ‖c‖ * ‖c‖ * detSize k * r k = ‖c‖ * ‖c‖ * (‖b‖ * (detSize k * r k)) by ring,
    mul_div_mul_left _ _ (mul_ne_zero hc' hc'), mul_div_assoc]

private theorem minor_div_lastRow_sq_mul (t k : GL (Fin 3) L) (c : L) (r m : GL (Fin 3) L → ℝ)
    (hr : r (t * k) = r k) (hm : m (t * k) = ‖c‖ * m k) :
    m (t * k) / r (t * k) ^ 2 = ‖c‖ * (m k / r k ^ 2) := by
  rw [hr, hm, mul_div_assoc]

end
