-- title:
--   Weight-one form on Γ₁(M) with v vartheta j = w²
-- statement:
--   Let $M$ be a natural number with $5 \le M$ (and $M \neq 0$). The assertion is the existence of a modular form $w$ of weight $1$ for the group $\Gamma_1(M)$, regarded as a subgroup of $\mathrm{GL}_2(\mathbb{R})$, together with a Laurent series $v \in \mathbb{C}((q))$, such that three conditions hold. First, $w \neq 0$. Second, $v$ lies in [`ModularCurve.laurentBaseChange ℂ (ModularCurve.qExpFunctionFieldC ℚ (Gamma1 M))`](def/ModularCurve_LaurentCoeff.html#L103), that is, in the intermediate field of $\mathbb{C}((q))$ over $\mathbb{C}$ generated by the coefficientwise images under $\mathbb{Q} \to \mathbb{C}$ of the elements of `qExpFunctionFieldC ℚ (Gamma1 M)`, the subfield of $\mathbb{Q}((q))$ generated over $\mathbb{Q}$ by all quotients $\mathrm{intSeriesC}\,\mathbb{Q}\,p_f / \mathrm{intSeriesC}\,\mathbb{Q}\,p_g$ in which $f$ and $g$ are modular forms of some common weight $k$ for $\Gamma_1(M)$, $p_f$ and $p_g$ are integral power series satisfying the predicate `IsIntegralQExp` with respect to $f$ and $g$, and $\mathrm{intSeriesC}\,\mathbb{Q}\,p_g \neq 0$. Third, $v \cdot \vartheta j = \bigl(\text{$q$-expansion of } w\bigr)^2$ in $\mathbb{C}((q))$, where $\vartheta j$ is `thetaL ℂ (jqModC ℂ)`, the operator $f \mapsto q\,\mathrm{d}f/\mathrm{d}q$ applied to $q^{-1}\cdot(E_4^3 \cdot \mathrm{dedekindEtaUnitInv})$ with coefficients pushed to $\mathbb{C}$, and the square is that of the image of `UpperHalfPlane.qExpansion 1 w` in $\mathbb{C}((q))$.
--
--   This supplies the odd-weight analogue of the multiplier $(\vartheta j)^m$: a square root of a suitable power of $\vartheta j$ up to a function on $X_1(M)$, realised by a non-zero weight-one form such as an Eisenstein series attached to an odd Dirichlet character. It is used by [`ModularForm.exists_linearIndependent_gamma1_dimFormula_le_card_of_odd`](thm.html#ModularForm.exists_linearIndependent_gamma1_dimFormula_le_card_of_odd) in the proof of the upper bound for the dimension of spaces of modular forms of odd weight on $\Gamma_1(M)$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularForm_exists_gamma1_weightOne_ne_zero_and_mul_thetaL_eq_qExpansion_sq.lean

import Mathlib
import Definitions.Def_ModularCurve_X1
import Definitions.Def_ModularCurve_JqCoeff
import Definitions.Def_ModularCurve_LaurentCoeff
import Definitions.Def_ModularCurve_QExpansionDiff
import Definitions.Def_AlgebraicCurve_Repartitions

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open CongruenceSubgroup ModularCurve
open scoped MatrixGroups ModularForm

theorem ModularForm.exists_gamma1_weightOne_ne_zero_and_mul_thetaL_eq_qExpansion_sq
    (M : ℕ) [NeZero M] (hM : 5 ≤ M) :
    ∃ (w : ModularForm (Gamma1 M) 1) (v : LaurentSeries ℂ), w ≠ 0 ∧
      v ∈ ModularCurve.laurentBaseChange ℂ (ModularCurve.qExpFunctionFieldC ℚ (CongruenceSubgroup.Gamma1 M)) ∧
      v * ModularCurve.thetaL ℂ (ModularCurve.jqModC ℂ) =
        HahnSeries.ofPowerSeries ℤ ℂ (UpperHalfPlane.qExpansion 1 w) ^ 2 := by sorry
