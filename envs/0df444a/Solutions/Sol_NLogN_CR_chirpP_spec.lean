theorem two_r (q : Params) : (2 : ℕ) ^ (q.e + 1) = 2 * q.r := by
  rw [Params.r, pow_succ, mul_comm]

theorem reqBody_spec (q : Params) (he : 1 ≤ q.e) (hdh : q.dh < q.K) (w : IState HS)
