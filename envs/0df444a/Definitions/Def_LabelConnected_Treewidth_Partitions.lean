-- title:
--   Partitions of a finite set, their join, cuts, and the matrices Φ_U and Ψ_U over F_2
-- statement:
--   Let $U$ be a finite set. For partitions $\pi, \pi'$ of $U$, the **join** $\pi \vee \pi'$ is their finest common coarsening: two elements are in the same block if a sequence of identifications from $\pi$ or $\pi'$ connects them. $\Phi_U$ is the matrix over $\mathbb F_2$ with rows and columns indexed by the partitions of $U$ and
--   $$\Phi_U[\pi, \pi'] = 1 \iff \pi \vee \pi' = \{U\}.$$
--   Fix $u_0 \in U$; a **cut** is a set $\kappa \subseteq U$ with $u_0 \in \kappa$. $\Psi_U$ has rows indexed by partitions and columns by cuts, with $\Psi_U[\pi, \kappa] = 1$ iff every block of $\pi$ is contained in $\kappa$ or in $U \setminus \kappa$ ($\pi$ **respects** $\kappa$).
--
--   **Formalization Note.** `UPartition U := Finpartition (Finset.univ : Finset U)`; `join` via `Relation.EqvGen` of "same block of π or of π′" and `Finpartition.ofSetoid`; `Cut u₀` the subtype of `Finset U` containing `u₀`; entries in `ZMod 2`; `Respects`, `Phi`, `Psi`.
-- source:
--   Klasing, Mertzios, Molter, Morawietz, Spirakis, Recognizing Label-Connected Graphs, arXiv:2611.05144 (PDF sha256 8dde27a5…), §6.1, p. 28, Compressing the Partitions

import Mathlib

open Classical

namespace LabelConnected.Treewidth

/-! # The partition matrices `Φ_U` and `Ψ_U` over `𝔽₂`

Klasing, Mertzios, Molter, Morawietz, Spirakis, *Recognizing Label-Connected Graphs*,
arXiv:2611.05144 (PDF sha256 8dde27a5…), §6.1, "Compressing the Partitions", p. 28: "For partitions
π, π′ of a set U, let π ∨ π′ denote their finest common coarsening: two elements are in the same
block if a sequence of identifications from π or π′ connects them. For a nonempty set U, let ΦU be
the matrix over F2 with rows and columns indexed by the partitions of U, where ΦU[π, π′] = 1 if and
only if π ∨ π′ = {U}. Fix an element u0 ∈ U, and call a set κ ⊆ U with u0 ∈ κ a cut. Let ΨU be the
matrix with rows indexed by partitions and columns indexed by cuts, where ΨU[π, κ] = 1 if and only
if every block of π is contained in κ or in U \ κ."

**Formalization Note.** `U` is a finite type; a partition of `U` is a `Finpartition` of
`Finset.univ`. The join `π ∨ π′` is built from the equivalence relation generated by "same block of
`π`" and "same block of `π′`" (`Relation.EqvGen`). `F₂` is `ZMod 2`. -/

variable {U : Type} [Fintype U] [DecidableEq U]

/-- Partitions of the finite set `U`. -/
abbrev UPartition (U : Type) [Fintype U] [DecidableEq U] := Finpartition (Finset.univ : Finset U)

/-- The setoid of `π ∨ π′`: the equivalence relation generated by the blocks of `π` and of `π′`. -/
def joinSetoid (π π' : UPartition U) : Setoid U :=
  Relation.EqvGen.setoid fun x y => π.part x = π.part y ∨ π'.part x = π'.part y

/-- `π ∨ π′`, the finest common coarsening of `π` and `π′`. -/
noncomputable def join (π π' : UPartition U) : UPartition U :=
  Finpartition.ofSetoid (joinSetoid π π')

/-- Cuts: subsets `κ ⊆ U` containing the fixed element `u₀`. -/
abbrev Cut (u₀ : U) := {κ : Finset U // u₀ ∈ κ}

/-- `Φ_U[π, π′] = 1` iff `π ∨ π′ = {U}`. -/
noncomputable def Phi (U : Type) [Fintype U] [DecidableEq U] :
    Matrix (UPartition U) (UPartition U) (ZMod 2) :=
  fun π π' => if (join π π').parts = {Finset.univ} then 1 else 0

/-- `π` respects the cut `κ`: every block of `π` lies in `κ` or in `U \ κ`. -/
def Respects (π : UPartition U) (κ : Finset U) : Prop :=
  ∀ b ∈ π.parts, b ⊆ κ ∨ b ⊆ Finset.univ \ κ

/-- `Ψ_U[π, κ] = 1` iff every block of `π` is contained in `κ` or in `U \ κ`. -/
noncomputable def Psi (u₀ : U) : Matrix (UPartition U) (Cut u₀) (ZMod 2) :=
  fun π κ => if Respects π κ.1 then 1 else 0

end LabelConnected.Treewidth


