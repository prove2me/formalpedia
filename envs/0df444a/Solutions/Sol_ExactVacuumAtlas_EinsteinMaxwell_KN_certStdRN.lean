-- ==== solution ====
open Real
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.KN
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
theorem solution (M Q : ℝ) (hM : 0 < M) :
    EinsteinMaxwellCertificate (RNStd.gStdRN M Q) (RNStd.giStdRN M Q) (RNStd.faradayStdRN Q)
      (RNStd.domStdRN M Q) := by
  have h := (cert M 0 Q hM).congr (fun i j => (gA0 M Q i j).mono (domKN_subset_domReg hM))
    (fun i j => (giA0 M Q i j).mono (domKN_subset_domReg hM))
    (fun i j => (FA0 M Q i j).mono (domKN_subset_domReg hM))
  exact h.of_eq_dom (domKN_a0 M Q)
