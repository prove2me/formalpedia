-- title:
--   Corollary 6.3 — valid lifting of a restricted cut
-- statement:
--   This is Corollary 6.3 of Balas's *Disjunctive Programming*, described in the text as "a
--   more transparent way" of stating Theorem 6.2's same underlying fact.
--
--   If $\alpha^R x^R \ge \beta$ is the lift-and-project cut generated by solving `(CGLP)^R`, then
--   $\alpha x \ge \beta$ is a valid lifting to the full solution space of `(CGLP)`, with
--
--   $$
--   \alpha_i = \begin{cases} \alpha^R_i, & i \in R, \\ \max\{\alpha^1_i, \alpha^2_i\}, & i
--   \notin R, \end{cases} \qquad \alpha^1_i = u^R \tilde A^R_i,\ \ \alpha^2_i = v^R \tilde
--   A^R_i,
--   $$
--
--   where $\tilde A^R_i$ is the subvector of $\tilde A_i$ restricted to the reduced problem's row
--   set. This avoids Theorem 6.2's block-indexed extra-row bookkeeping entirely: the same $\max$
--   formula is obtained directly, and the corollary asserts explicitly that the resulting extension is
--   feasible for the full `(CGLP)`.
--
--   **Formalization Note.** Feasibility of the extension is verified using an explicit fresh row per
--   variable (`AtilExt`, `BtilExt`: row type `M ⊕ Fin n`), each fresh row carrying a single unit
--   coefficient at its own variable's column — the same device Theorem 6.2 uses, made fully explicit
--   here since Corollary 6.3's own formula does not depend on which literal row-block position a
--   book-reader would assign to it.
-- source:
--   Balas, Disjunctive Programming, Springer 2018, DOI 10.1007/978-3-030-00148-3, p. 84, Corollary 6.3

import Mathlib
import Definitions.Def_Disjunctive_LiftProject_Basic

namespace Disjunctive.LiftProject

/-- Corollary 6.3 (Balas §6.4, p. 84, [20]): the lift-and-project cut `α^R x^R ≥ β` generated by
solving the reduced `(CGLP)^R` extends to a valid lifting `αx ≥ β` for the full `(CGLP)`, with
`α_i = α^R_i` for `i ∈ R` and `α_i = max{α¹_i, α²_i}` for `i ∉ R`. -/
theorem valid_lifting_restricted_cut {n : ℕ} {M : Type*} [Fintype M]
    (Atil : Matrix M (Fin n) ℝ) (btil : M → ℝ) (MR : Finset M) (R : Finset (Fin n))
    (j : Fin n) (hj : j ∈ R) (αR : Fin n → ℝ) (uR vR : M → ℝ) (u0R v0R β : ℝ)
    (hFeas : IsCGLPRFeasible Atil btil MR R j αR uR u0R vR v0R β) :
    ∃ α : Fin n → ℝ, ∃ u v : M ⊕ Fin n → ℝ,
      (∀ i ∈ R, α i = αR i) ∧
        (∀ i ∉ R, α i = max (Alpha1 Atil uR MR i) (Alpha2 Atil vR MR i)) ∧
        IsCGLPFeasible (AtilExt Atil) (BtilExt btil) j α u u0R v v0R β := by sorry

end Disjunctive.LiftProject
