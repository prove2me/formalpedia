/-! ### Section 4: Computable `Poly1009` Arithmetic & All 23 `(ZMod 1009)[U]` Bézout Witnesses -/

abbrev Poly1009 := List (ZMod 1009)

namespace Poly1009

def toPoly : Poly1009 → (ZMod 1009)[X]
  | [] => 0
  | a :: l => C a + X * toPoly l

def pzero : Poly1009 := []
def pone : Poly1009 := [1]
def pX : Poly1009 := [0, 1]
def pC (c : ZMod 1009) : Poly1009 := [c]

def padd : Poly1009 → Poly1009 → Poly1009
  | [], b => b
  | a, [] => a
  | a :: as, b :: bs => (a + b) :: padd as bs

def pneg : Poly1009 → Poly1009
  | [] => []
  | a :: as => (-a) :: pneg as

def psub (a b : Poly1009) : Poly1009 := padd a (pneg b)

def psmul (c : ZMod 1009) : Poly1009 → Poly1009
  | [] => []
  | a :: as => (c * a) :: psmul c as

def pmul : Poly1009 → Poly1009 → Poly1009
  | [], _ => []
  | a :: as, b => padd (psmul a b) (0 :: pmul as b)

def ppow (a : Poly1009) : ℕ → Poly1009
  | 0 => pone
  | n + 1 => pmul (ppow a n) a

def pshift : ℕ → Poly1009 → Poly1009
  | 0, a => a
  | n + 1, a => 0 :: pshift n a

def pderivAux (k : ℕ) : Poly1009 → Poly1009
  | [] => []
  | a :: as => ((k : ZMod 1009) * a) :: pderivAux (k + 1) as

def pderiv : Poly1009 → Poly1009
  | [] => []
  | _ :: as => pderivAux 1 as

def pnormRev : Poly1009 → Poly1009
  | [] => []
  | a :: as => if a == 0 then pnormRev as else a :: as

def pnorm (a : Poly1009) : Poly1009 := (pnormRev a.reverse).reverse

def peq (a b : Poly1009) : Bool := pnorm a == pnorm b

/-- One reduction step modulo a monic polynomial `M` of degree `d`. -/
def pmodStep (M : Poly1009) (d : ℕ) (a : Poly1009) : Poly1009 :=
  let a' := pnorm a
  match a'.reverse with
  | [] => []
  | lc :: _ =>
    if a'.length ≤ d then a'
    else pnorm (psub a' (psmul lc (pshift (a'.length - 1 - d) M)))

def pmodRec : ℕ → Poly1009 → ℕ → Poly1009 → Poly1009
  | 0, _, _, a => pnorm a
  | fuel + 1, M, d, a => pmodRec fuel M d (pmodStep M d a)

lemma toPoly_padd (a b : Poly1009) : toPoly (padd a b) = toPoly a + toPoly b := by
  induction a generalizing b with
  | nil => simp [padd, toPoly]
  | cons x xs ih =>
    cases b with
    | nil => simp [padd, toPoly]
    | cons y ys =>
      simp only [padd, toPoly, map_add, ih ys]
      ring

lemma toPoly_pneg (a : Poly1009) : toPoly (pneg a) = -toPoly a := by
  induction a with
  | nil => simp [pneg, toPoly]
  | cons x xs ih => simp only [pneg, toPoly, map_neg, ih]; ring

lemma toPoly_psub (a b : Poly1009) : toPoly (psub a b) = toPoly a - toPoly b := by
  rw [psub, toPoly_padd, toPoly_pneg, sub_eq_add_neg]

lemma toPoly_psmul (c : ZMod 1009) (a : Poly1009) : toPoly (psmul c a) = C c * toPoly a := by
  induction a with
  | nil => simp [psmul, toPoly]
  | cons x xs ih => simp only [psmul, toPoly, map_mul, ih]; ring

lemma toPoly_pmul (a b : Poly1009) : toPoly (pmul a b) = toPoly a * toPoly b := by
  induction a with
  | nil => simp [pmul, toPoly]
  | cons x xs ih =>
    simp only [pmul, toPoly_padd, toPoly_psmul, toPoly, map_zero, zero_add, ih]
    ring

lemma toPoly_ppow (a : Poly1009) (n : ℕ) : toPoly (ppow a n) = toPoly a ^ n := by
  induction n with
  | zero => simp [ppow, pone, toPoly]
  | succ n ih => simp [ppow, toPoly_pmul, ih, pow_succ]

lemma toPoly_pshift (n : ℕ) (a : Poly1009) : toPoly (pshift n a) = X ^ n * toPoly a := by
  induction n with
  | zero => simp [pshift]
  | succ n ih => simp only [pshift, toPoly, map_zero, zero_add, ih, pow_succ']; ring

lemma toPoly_pderivAux (k : ℕ) (hk : 1 ≤ k) (a : Poly1009) :
    toPoly (pderivAux k a) * X ^ (k - 1) = (X ^ k * toPoly a).derivative := by
  induction a generalizing k with
  | nil => simp [pderivAux, toPoly]
  | cons x xs ih =>
    cases k with
    | zero => omega
    | succ m =>
      have hih := ih (m + 2) (by omega)
      rw [show m + 2 - 1 = m + 1 by omega] at hih
      simp only [Nat.add_sub_cancel] at hih ⊢
      have hsplit : X ^ (m + 1) * (C x + X * toPoly xs) =
          C x * X ^ (m + 1) + X ^ (m + 2) * toPoly xs := by ring
      simp only [pderivAux, toPoly]
      rw [hsplit, derivative_add, derivative_mul, derivative_C, zero_mul, zero_add,
        derivative_X_pow, Nat.add_sub_cancel, ← hih]
      simp only [map_mul, map_add, map_natCast, map_one, Nat.cast_add, Nat.cast_one]
      ring

lemma toPoly_pderiv (a : Poly1009) : toPoly (pderiv a) = (toPoly a).derivative := by
  cases a with
  | nil => simp [pderiv, toPoly]
  | cons x xs =>
    have h := toPoly_pderivAux 1 (by omega) xs
    simp only [Nat.sub_self, pow_zero, mul_one, pow_one] at h
    simp only [pderiv, toPoly, derivative_add, derivative_C, zero_add, h]

lemma toPoly_append (a b : Poly1009) :
    toPoly (a ++ b) = toPoly a + X ^ a.length * toPoly b := by
  induction a with
  | nil => simp [toPoly]
  | cons x xs ih => simp only [List.cons_append, List.length_cons, toPoly, ih, pow_succ']; ring

lemma toPoly_pnormRev_reverse (a : Poly1009) : toPoly (pnormRev a).reverse = toPoly a.reverse := by
  induction a with
  | nil => rfl
  | cons x xs ih =>
    simp only [pnormRev]
    by_cases hx : x == 0
    · simp only [hx, ↓reduceIte, ih, List.reverse_cons, toPoly_append, toPoly]
      have hx0 : x = 0 := by simpa using hx
      simp [hx0]
    · simp [hx]

lemma toPoly_pnorm (a : Poly1009) : toPoly (pnorm a) = toPoly a := by
  rw [pnorm, toPoly_pnormRev_reverse, List.reverse_reverse]

lemma toPoly_eq_of_peq {a b : Poly1009} (h : peq a b = true) : toPoly a = toPoly b := by
  have heq : pnorm a = pnorm b := by simpa [peq] using h
  rw [← toPoly_pnorm a, ← toPoly_pnorm b, heq]

/-- Polynomial congruence modulo `M` in `(ZMod 1009)[X]`. -/
def CongrMod (M a b : (ZMod 1009)[X]) : Prop := M ∣ a - b

lemma CongrMod.refl (M a : (ZMod 1009)[X]) : CongrMod M a a := by simp [CongrMod]
lemma CongrMod.symm {M a b : (ZMod 1009)[X]} (h : CongrMod M a b) : CongrMod M b a := by
  rcases h with ⟨q, hq⟩; exact ⟨-q, by linear_combination -hq⟩
lemma CongrMod.trans {M a b c : (ZMod 1009)[X]} (h1 : CongrMod M a b) (h2 : CongrMod M b c) :
    CongrMod M a c := by
  rcases h1 with ⟨q1, h1⟩; rcases h2 with ⟨q2, h2⟩; exact ⟨q1 + q2, by linear_combination h1 + h2⟩
lemma CongrMod.add {M a1 a2 b1 b2 : (ZMod 1009)[X]}
    (h1 : CongrMod M a1 b1) (h2 : CongrMod M a2 b2) : CongrMod M (a1 + a2) (b1 + b2) := by
  rcases h1 with ⟨q1, h1⟩; rcases h2 with ⟨q2, h2⟩; exact ⟨q1 + q2, by linear_combination h1 + h2⟩
lemma CongrMod.sub {M a1 a2 b1 b2 : (ZMod 1009)[X]}
    (h1 : CongrMod M a1 b1) (h2 : CongrMod M a2 b2) : CongrMod M (a1 - a2) (b1 - b2) := by
  rcases h1 with ⟨q1, h1⟩; rcases h2 with ⟨q2, h2⟩; exact ⟨q1 - q2, by linear_combination h1 - h2⟩
lemma CongrMod.neg {M a b : (ZMod 1009)[X]} (h : CongrMod M a b) : CongrMod M (-a) (-b) := by
  rcases h with ⟨q, hq⟩; exact ⟨-q, by linear_combination -hq⟩
lemma CongrMod.mul {M a1 a2 b1 b2 : (ZMod 1009)[X]}
    (h1 : CongrMod M a1 b1) (h2 : CongrMod M a2 b2) : CongrMod M (a1 * a2) (b1 * b2) := by
  rcases h1 with ⟨q1, h1⟩; rcases h2 with ⟨q2, h2⟩
  exact ⟨q1 * a2 + b1 * q2, by linear_combination a2 * h1 + b1 * h2⟩

lemma pmodStep_congr (M : Poly1009) (d : ℕ) (a : Poly1009) :
    CongrMod (toPoly M) (toPoly a) (toPoly (pmodStep M d a)) := by
  dsimp only [pmodStep]
  set a' := pnorm a
  cases hrev : a'.reverse with
  | nil =>
    dsimp only
    have ha0 : a' = [] := List.reverse_eq_nil_iff.mp hrev
    rw [← toPoly_pnorm a]
    change CongrMod _ (toPoly a') _
    rw [ha0]; exact CongrMod.refl _ _
  | cons lc _ =>
    dsimp only
    split_ifs with hlen
    · rw [← toPoly_pnorm a]; exact CongrMod.refl _ _
    · rw [toPoly_pnorm, toPoly_psub, toPoly_psmul, toPoly_pshift, ← toPoly_pnorm a]
      exact ⟨C lc * X ^ (a'.length - 1 - d), by ring⟩

lemma pmodRec_congr (fuel : ℕ) (M : Poly1009) (d : ℕ) (a : Poly1009) :
    CongrMod (toPoly M) (toPoly a) (toPoly (pmodRec fuel M d a)) := by
  induction fuel generalizing a with
  | zero => rw [pmodRec, toPoly_pnorm]; exact CongrMod.refl _ _
  | succ f ih => exact (pmodStep_congr M d a).trans (ih _)

lemma isCoprime_of_bezout_congr {M R u v : Poly1009} {Q : (ZMod 1009)[X]}
    (hcong : CongrMod (toPoly M) Q (toPoly R))
    (hbez : peq (padd (pmul u M) (pmul v R)) pone = true) :
    IsCoprime (toPoly M) Q := by
  have heq := toPoly_eq_of_peq hbez
  simp only [toPoly_padd, toPoly_pmul, pone, toPoly, mul_zero, add_zero, map_one] at heq
  rcases hcong with ⟨q, hq⟩
  refine ⟨toPoly u - toPoly v * q, toPoly v, ?_⟩
  linear_combination heq + toPoly v * hq

