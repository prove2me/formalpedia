-- name    : ErrBoundCplx.ISTA.theorem_25
-- status  : Open
-- author  : @mikedeng1
-- created : 2026-10-07T21:09:20.8524+00:00
-- url     : https://prove2.me/theorems/ab239ae9-2b7c-48e1-8b5e-67f29498134b
-- title:
--   Theorem 25 — ISTA converges to a minimizer with f(x_k) − min f ≤ (f(x₀) − min f)/q^k and ‖x_k − x*‖ ≤ C√(f(x₀) − min f)/q^((k−1)/2), q = 1 + 2aγ_R/b²
-- statement:
--   Let $\mu > 0$, $A \in \mathbb R^{m\times n}$, $d \in \mathbb R^m$ and $f(x) = \mu\|x\|_1 + \frac12\|Ax - d\|^2$ on $\mathbb R^n$, with $L = \|A^TA\|$ (spectral norm) and $S = \operatorname{argmin} f$. Let the stepsizes satisfy $0 < \lambda^- \le \lambda_k \le \lambda^+ < 2/L$, and let $(x_k)$ be generated by ISTA,
--   $$x_{k+1} = \operatorname{prox}_{\lambda_k\mu\|\cdot\|_1}\big(x_k - \lambda_k(A^TAx_k - A^Td)\big), \qquad k \ge 0,$$
--   from an arbitrary $x_0 \in \mathbb R^n$. Put $a = \frac{1}{\lambda^+} - \frac L2$ and $b = \frac{1}{\lambda^-} + L$ (35), and $R = \max\big(\frac{f(x_0)}{\mu}, 1 + \frac{\|d\|^2}{2\mu}\big)$. Let $\gamma_R > 0$ be a constant for which the error bound (9) holds on the $\ell_1$ ball of radius $R$:
--   $$f(x) - \min f \ge 2\gamma_R \operatorname{dist}^2(x, S) \qquad \text{whenever } \|x\|_1 \le R$$
--   (by Lemma 10, the value (10) is such a constant). Then $(x_k)$ converges to a minimizer $x^*$ of $f$, and
--   $$f(x_k) - \min f \le \frac{f(x_0) - \min f}{q^k} \qquad \forall k \ge 0, \qquad (36)$$
--   $$\|x_k - x^*\| \le C\,\frac{\sqrt{f(x_0) - \min f}}{q^{\frac{k-1}{2}}} \qquad \forall k \ge 1, \qquad (37)$$
--   where
--   $$q = 1 + \frac{2a\gamma_R}{b^2} \qquad\text{and}\qquad C = \frac{1}{\sqrt a}\left(1 + \frac{1}{ab^{-2}\gamma_R\sqrt{1 + \frac{1}{2ab^{-2}\gamma_R}}}\right).$$
--
--   The theorem gives ISTA a linear (geometric) complexity bound with explicit constants, in place of the classical $O(1/k)$ bound, as a consequence of the error bound of the $\ell_1$-regularized least squares objective.
--
--   **Formalization Note** The page leaves $\gamma_R$ implicit ("$\gamma_R$ is known to exist and is bounded from above by the constant given in (10)"); the theorem is stated for every $\gamma_R > 0$ satisfying (9) on the ball of radius $R$, which is the role $\gamma_R$ plays in the proof and includes the value (10). The stepsize condition $\lambda^+ < 2/L$ is written $\lambda^+ L < 2$, which covers $A = 0$. $q^k$ is a natural power and $q^{(k-1)/2}$ a real power. $\min f$ is the infimum of $f$; that it is attained follows from the conclusion. The prox is the published `IsProx` predicate (minimizer over all of $\mathbb R^n$), and the spectral norm is the operator norm of $x \mapsto Mx$ between Euclidean spaces.
-- source:
--   arXiv:1510.08234v3, Theorem 25, p. 24, (36), (37), with §5.3, pp. 23–24, (35)

import Mathlib
import Definitions.Def_BoydADMM_Prox_Basic
import Definitions.Def_ErrBoundCplx_ISTA_Lasso
open BoydADMM.Prox
open Filter Topology
open scoped Matrix

namespace ErrBoundCplx.ISTA

/-- arXiv:1510.08234v3, Theorem 25 (complexity bounds for ISTA), p. 24, with the setting of §5.3,
pp. 23–24. Let `μ > 0`, `A ∈ ℝ^{m×n}`, `d ∈ ℝ^m`, `f(x) = μ‖x‖₁ + ½‖Ax − d‖²`,
`L = ‖AᵀA‖` (spectral norm), stepsizes `0 < λ₋ ≤ λ_k ≤ λ₊` with `λ₊ L < 2`, and `(x_k)` the ISTA
sequence from an arbitrary `x₀`. Let `a = 1/λ₊ − L/2`, `b = 1/λ₋ + L` (35),
`R = max(f(x₀)/μ, 1 + ‖d‖²/(2μ))`, and let `γ_R > 0` be any constant for which the error bound
(9) `f(x) − min f ≥ 2γ_R dist²(x, S)` holds on `{‖x‖₁ ≤ R}`. With `q = 1 + 2aγ_R/b²` and
`C = a^{−1/2}(1 + 1/(ab⁻²γ_R √(1 + 1/(2ab⁻²γ_R))))`, `x_k` converges to a minimizer `x*` and
`f(x_k) − min f ≤ (f(x₀) − min f)/q^k` for `k ≥ 0` (36),
`‖x_k − x*‖ ≤ C √(f(x₀) − min f) / q^((k−1)/2)` for `k ≥ 1` (37). -/
theorem theorem_25 {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (d : EuclideanSpace ℝ (Fin m)) (μ : ℝ) (hμ : 0 < μ)
    (lam : ℕ → ℝ) (lamMinus lamPlus : ℝ) (hlm : 0 < lamMinus)
    (hlo : ∀ k, lamMinus ≤ lam k) (hhi : ∀ k, lam k ≤ lamPlus)
    (hLp : lamPlus * specNorm (Aᵀ * A) < 2)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (hx : IsISTASeq A d μ lam x)
    (γR : ℝ) (hγ : 0 < γR)
    (hEB : ∀ y : EuclideanSpace ℝ (Fin n),
      l1Norm y ≤ max (lassoObj A d μ (x 0) / μ) (1 + ‖d‖ ^ 2 / (2 * μ)) →
      2 * γR * Metric.infDist y (lassoArgmin A d μ) ^ 2 ≤ lassoObj A d μ y - lassoMin A d μ) :
    let L : ℝ := specNorm (Aᵀ * A)
    let a : ℝ := 1 / lamPlus - L / 2
    let b : ℝ := 1 / lamMinus + L
    let q : ℝ := 1 + 2 * a * γR / b ^ 2
    let C : ℝ := 1 / Real.sqrt a *
      (1 + 1 / (a * b⁻¹ ^ 2 * γR * Real.sqrt (1 + 1 / (2 * a * b⁻¹ ^ 2 * γR))))
    ∃ xstar ∈ lassoArgmin A d μ, Tendsto x atTop (𝓝 xstar) ∧
      (∀ k : ℕ, lassoObj A d μ (x k) - lassoMin A d μ ≤
        (lassoObj A d μ (x 0) - lassoMin A d μ) / q ^ k) ∧
      ∀ k : ℕ, 1 ≤ k → ‖x k - xstar‖ ≤
        C * Real.sqrt (lassoObj A d μ (x 0) - lassoMin A d μ) / q ^ (((k : ℝ) - 1) / 2) := by sorry

end ErrBoundCplx.ISTA
