-- Source module: Solutions.R6CxNetEdge
/-!
# Merged frame changes for any number of address bits `m` (NC3, generic `m`)

`R6CxMerge.edgeStepsH` is stated for `m = h³` (through `NetComplexP8.EdgeP` on `Vc h`). Here the
same construction over `Fin m → ZMod 2` for any `m` (needed for `m = h² = 576`), with the edge
hypothesis `NetComplexP8.EdgeOK` (generic in `m`) and `NetComplexP8.edge_kernel`.

* `edgeStepsM w V U`: one merged chunk (row additions, one child of width `Fd V U`, row
  additions undone) on wire `w`;
* `edgeStepsM_den`: denotation `wireOp w (PhiK (qL V - qL U))`;
* `edgeStepsM_widths`: child widths `[Fd V U]` (none if `Fd V U = 0`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.Cx

open Matrix Finset Complex Butterfly P8Lift NetComplexP8 NetComplexLabels

variable {m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]
variable {R : Type} [Fintype R] [DecidableEq R]

lemma ne_zero_of_dotM {v : Fin m → ZMod 2} (hv : v ⬝ᵥ v = 1) : v ≠ 0 := by
  rintro rfl; simp at hv

theorem kerSpecM_of_edgeOK {V U : Submodule (ZMod 2) (Fin m → ZMod 2)} (hE : EdgeOK V U) :
    ∃ L, KerSpecM V U L := by
  obtain ⟨B, hB, -, hcard, L, hLB, hpm, hPhi⟩ := edge_kernel hE
  refine ⟨L, fun p hp => ⟨hpm p hp, ?_⟩, ?_, hPhi, B, hB, hLB⟩
  · have : p.2 ∈ B.toList := hLB ▸ List.mem_map_of_mem hp
    exact ne_zero_of_dotM (hB.1 _ (Finset.mem_toList.1 this))
  · rw [← List.length_map (f := Prod.snd), hLB, Finset.length_toList, hcard]

lemma kersM_spec {V U : Submodule (ZMod 2) (Fin m → ZMod 2)} (hE : EdgeOK V U) :
    KerSpecM V U (kersM V U) := by
  have hh := kerSpecM_of_edgeOK hE
  unfold kersM
  rw [dif_pos hh]
  exact Classical.choose_spec hh

/-- **Merged edge, any `m`.** -/
theorem edgeStepsM_den (w : R) {V U : Submodule (ZMod 2) (Fin m → ZMod 2)} (hE : EdgeOK V U) :
    denListH (chEx (κ := κ)) (edgeStepsM w V U) = wireOp w (PhiK (qL V - qL U)) := by
  obtain ⟨hs, hlen, hPhi, B, hB, hLB⟩ := kersM_spec hE
  rw [edgeStepsM, mergedChunk_den w _ (fun p hp => (hs p hp).1)
    (lin_indep_of_orthonormal _ B hB hLB), PhiK, PhiMat_kernels _ _ hPhi]

end IntMul.Kappa.R6.Cx

end

