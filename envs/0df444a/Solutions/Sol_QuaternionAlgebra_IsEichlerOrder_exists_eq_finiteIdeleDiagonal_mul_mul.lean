variable {v : HeightOneSpectrum (𝓞 ℚ)}
  (φ : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ ≃+* Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ))
  (hφ : ∀ t : v.adicCompletion ℚ, φ ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] t) = t • (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ)))
  (ψ : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ ≃+*
      ℍ[v.adicCompletion ℚ, algebraMap ℚ (v.adicCompletion ℚ) a, algebraMap ℚ (v.adicCompletion ℚ) b])
  (hψ : ∀ (z : ℍ[ℚ, a, b]) (t : v.adicCompletion ℚ),
      ψ (z ⊗ₜ[ℚ] t) = t • (⟨algebraMap ℚ (v.adicCompletion ℚ) z.re,
        algebraMap ℚ (v.adicCompletion ℚ) z.imI, algebraMap ℚ (v.adicCompletion ℚ) z.imJ,
        algebraMap ℚ (v.adicCompletion ℚ) z.imK⟩ :
          ℍ[v.adicCompletion ℚ, algebraMap ℚ (v.adicCompletion ℚ) a, algebraMap ℚ (v.adicCompletion ℚ) b]))

include hψ in
theorem psi_one_tmul (t : v.adicCompletion ℚ) :
    ψ ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] t) =
      ((t : v.adicCompletion ℚ) : ℍ[v.adicCompletion ℚ, algebraMap ℚ (v.adicCompletion ℚ) a, algebraMap ℚ (v.adicCompletion ℚ) b]) := by
  rw [hψ]
  ext <;> simp

include hψ in
theorem symm_smul (t : v.adicCompletion ℚ)
    (ξ : ℍ[v.adicCompletion ℚ, algebraMap ℚ (v.adicCompletion ℚ) a, algebraMap ℚ (v.adicCompletion ℚ) b]) :
    ψ.symm (t • ξ) = ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] t) * ψ.symm ξ := by
  apply ψ.injective
  rw [ψ.apply_symm_apply, ψ.map_mul, psi_one_tmul ψ hψ, ψ.apply_symm_apply, QuaternionAlgebra.coe_mul_eq_smul]

include hφ hψ in

theorem det_eq_nrd (x : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ) :
    (φ x).det = QuaternionAlgebra.nrd (ψ x) := by
  set ξ := ψ x with hξ
  have hx : x = ψ.symm ξ := by rw [hξ, ψ.symm_apply_apply]
  have hrel : φ x * φ x = QuaternionAlgebra.trd ξ • φ x - QuaternionAlgebra.nrd ξ • (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ)) := by
    have h0 : x * x = ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] QuaternionAlgebra.trd ξ) * x - ((1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] QuaternionAlgebra.nrd ξ) := by
      have := congrArg ψ.symm (mul_self_eq' ξ)
      rw [ψ.symm.map_mul, ψ.symm.map_sub, symm_smul ψ hψ, symm_smul ψ hψ, ψ.symm.map_one, mul_one, ← hx] at this
      exact this
    rw [← φ.map_mul, h0, φ.map_sub, φ.map_mul, hφ, hφ, mat_smul_mul, one_mul]
  have hCH := cayley_hamilton_two (φ x)
  have hdiff : (QuaternionAlgebra.trd ξ - (φ x).trace) • φ x =
      (QuaternionAlgebra.nrd ξ - (φ x).det) • (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ)) := by
    rw [sub_smul, sub_smul, sub_eq_sub_iff_sub_eq_sub, ← hrel, ← hCH]
  by_cases hs : QuaternionAlgebra.trd ξ - (φ x).trace = 0
  · rw [hs, zero_smul] at hdiff
    have h00 := congrFun (congrFun hdiff 0) 0
    simp only [Matrix.zero_apply, Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one] at h00
    exact (sub_eq_zero.mp h00.symm).symm
  · have hXs : φ x = ((QuaternionAlgebra.trd ξ - (φ x).trace)⁻¹ * (QuaternionAlgebra.nrd ξ - (φ x).det)) •
        (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ)) := by
      have := congrArg (fun M : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ) => (QuaternionAlgebra.trd ξ - (φ x).trace)⁻¹ • M) hdiff
      simp only [smul_smul, inv_mul_cancel₀ hs, one_smul] at this
      exact this
    obtain ⟨c, hc⟩ : ∃ c : v.adicCompletion ℚ, φ x = c • (1 : Matrix (Fin 2) (Fin 2) (v.adicCompletion ℚ)) := ⟨_, hXs⟩
    have hx1 : x = (1 : ℍ[ℚ, a, b]) ⊗ₜ[ℚ] c := by
      apply φ.injective; rw [hc, hφ]
    have hξc : ξ = ((c : v.adicCompletion ℚ) : ℍ[v.adicCompletion ℚ, algebraMap ℚ (v.adicCompletion ℚ) a,
        algebraMap ℚ (v.adicCompletion ℚ) b]) := by rw [hξ, hx1, psi_one_tmul ψ hψ]
    rw [hc, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin, hξc, QuaternionAlgebra.nrd_coe]

end LocalDetNrd

theorem det_mem {w : HeightOneSpectrum (𝓞 ℚ)} (M : Matrix (Fin 2) (Fin 2) (w.adicCompletion ℚ))
    (hM : ∀ i j, M i j ∈ w.adicCompletionIntegers ℚ) :
    M.det ∈ w.adicCompletionIntegers ℚ := by
  rw [Matrix.det_fin_two]
  exact sub_mem (mul_mem (hM 0 0) (hM 1 1)) (mul_mem (hM 0 1) (hM 1 0))

theorem v_eq_one_of_mul_eq_one {w : HeightOneSpectrum (𝓞 ℚ)} {d e : w.adicCompletion ℚ}
    (hd : d ∈ w.adicCompletionIntegers ℚ) (he : e ∈ w.adicCompletionIntegers ℚ) (hde : d * e = 1) :
    Valued.v d = 1 := by
  have h1 : Valued.v d ≤ 1 := (HeightOneSpectrum.mem_adicCompletionIntegers (𝓞 ℚ) ℚ w).1 hd
  have h2 : Valued.v e ≤ 1 := (HeightOneSpectrum.mem_adicCompletionIntegers (𝓞 ℚ) ℚ w).1 he
  have h3 : Valued.v d * Valued.v e = 1 := by rw [← map_mul, hde, map_one]
  refine le_antisymm h1 ?_
  calc (1 : WithZero (Multiplicative ℤ)) = Valued.v d * Valued.v e := h3.symm
    _ ≤ Valued.v d * 1 := mul_le_mul_right h2 _
    _ = Valued.v d := mul_one _

theorem v_nrd_coord_eq_one_of_mem_localBoxUnits {q' : ℕ} (hdef : QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q')
    {Λ : Submodule ℤ ℍ[ℚ, a, b]} (hΛ : QuaternionAlgebra.IsMaximalOrder Λ) (w : HeightOneSpectrum (𝓞 ℚ))
    {t : (ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ)ˣ} (ht : t ∈ Submodule.localBoxUnits Λ w) :
    Valued.v (QuaternionAlgebra.nrd (coord w (t : ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ))) = 1 := by
  have hprod : QuaternionAlgebra.nrd (coord w (t : ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ)) *
      QuaternionAlgebra.nrd (coord w ((t⁻¹ : (ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ)ˣ) : ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ)) = 1 := by
    rw [← nrd_mul, ← map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, map_one, QuaternionAlgebra.nrd_one]
  by_cases hqw : (q' : 𝓞 ℚ) ∈ w.asIdeal
  ·
    have hdiv : ∀ z : ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ, z ≠ 0 → IsUnit z := (hdef.2.2 w).mpr hqw
    have h1 := (QuaternionAlgebra.IsMaximalOrder.mem_localBox_iff_nrd_mem_adicCompletionIntegers_of_forall_isUnit hΛ w hdiv
      (coord w) (coord_formula w) _).mp ht.1
    have h2 := (QuaternionAlgebra.IsMaximalOrder.mem_localBox_iff_nrd_mem_adicCompletionIntegers_of_forall_isUnit hΛ w hdiv
      (coord w) (coord_formula w) _).mp ht.2
    exact v_eq_one_of_mul_eq_one h1 h2 hprod
  ·
    have hΛE : QuaternionAlgebra.IsEichlerOrder Λ 1 :=
      ⟨Λ, Λ, hΛ, hΛ, le_antisymm (le_inf le_rfl le_rfl) inf_le_left, AddSubgroup.relIndex_self _⟩
    have h1w : ((1 : ℕ) : 𝓞 ℚ) ∉ w.asIdeal := by
      rw [Nat.cast_one]; exact (Ideal.ne_top_iff_one _).1 w.isPrime.ne_top
    obtain ⟨φ, hφ, hφΛ⟩ :=
      QuaternionAlgebra.IsEichlerOrder.exists_ringEquiv_mem_localBox_iff_of_notMem hdef hΛE w hqw h1w
    have h1 := det_mem _ ((hφΛ _).1 ht.1)
    have h2 := det_mem _ ((hφΛ _).1 ht.2)
    rw [det_eq_nrd φ hφ (coord w) (coord_formula w)] at h1 h2
    exact v_eq_one_of_mul_eq_one h1 h2 hprod

theorem main (q' : ℕ) [Fact q'.Prime] (hq5 : 5 ≤ q') (hdef : QuaternionAlgebra.IsDefiniteRamifiedExactlyAt a b q')
    {N : ℕ} {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : QuaternionAlgebra.IsEichlerOrder R N)
    (r : ℕ) [Fact r.Prime] (hrq' : r ≠ q')
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ((r : ℕ) : 𝓞 ℚ) ∈ v.asIdeal)
    (x : (𝔸ℍ)ˣ) :
    ∃ (γ : (ℍ[ℚ, a, b])ˣ) (g u : (𝔸ℍ)ˣ),
      u ∈ Submodule.finiteIdeleStabilizer R ∧
      (∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (g : 𝔸ℍ) = 1) ∧
      x = Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ * g * u := by
  classical
  have hr : r.Prime := Fact.out
  have hq'p : q'.Prime := Fact.out
  have hq'2 : q' ≠ 2 := by omega
  have hRo : QuaternionAlgebra.IsOrder R := hR.isOrder
  obtain ⟨Λ, hΛ, -, -⟩ := hR.exists_le_isMaximalOrder
  have hΛo : QuaternionAlgebra.IsOrder Λ := hΛ.isOrder
  have hΛE : QuaternionAlgebra.IsEichlerOrder Λ 1 :=
    ⟨Λ, Λ, hΛ, hΛ, le_antisymm (le_inf le_rfl le_rfl) inf_le_left, AddSubgroup.relIndex_self _⟩
  have hr1 : ¬ r ∣ 1 := fun h => hr.ne_one (Nat.dvd_one.mp h)

  obtain ⟨γ₁, g₁, u₁, hu₁, hg₁, hx⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_eq_finiteIdeleDiagonal_mul_mul_of_squarefree_of_not_dvd
      q' hq5 hdef (N := 1) squarefree_one Λ hΛ hΛE le_rfl r hrq' hr1 v hv x

  have hu₁w := (QuaternionAlgebra.IsOrder.mem_finiteIdeleStabilizer_iff_forall_map_finiteAdeleEvalAt_mem_localBoxUnits
    Λ hΛo u₁).mp hu₁
  set ε : (w : HeightOneSpectrum (𝓞 ℚ)) → w.adicCompletion ℚ := fun w =>
    QuaternionAlgebra.nrd (coord w (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (u₁ : 𝔸ℍ))) with hε
  have hεv : ∀ w : HeightOneSpectrum (𝓞 ℚ), Valued.v (ε w) = 1 := by
    intro w
    have h := v_nrd_coord_eq_one_of_mem_localBoxUnits hdef hΛ w (hu₁w w)
    rw [Units.coe_map] at h
    exact h

  obtain ⟨u₀, hu₀, hu₀n⟩ :=
    QuaternionAlgebra.IsEichlerOrder.exists_mem_finiteIdeleStabilizer_forall_nrd_eq hq'2 hdef hR ε hεv

  have hynorm : ∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v →
      ∀ φ : ℍ[ℚ, a, b] ⊗[ℚ] w.adicCompletion ℚ ≃+*
          ℍ[w.adicCompletion ℚ, algebraMap ℚ (w.adicCompletion ℚ) a, algebraMap ℚ (w.adicCompletion ℚ) b],
        (∀ (z : ℍ[ℚ, a, b]) (t : w.adicCompletion ℚ),
          φ (z ⊗ₜ[ℚ] t) = t • (⟨algebraMap ℚ (w.adicCompletion ℚ) z.re,
            algebraMap ℚ (w.adicCompletion ℚ) z.imI, algebraMap ℚ (w.adicCompletion ℚ) z.imJ,
            algebraMap ℚ (w.adicCompletion ℚ) z.imK⟩ :
              ℍ[w.adicCompletion ℚ, algebraMap ℚ (w.adicCompletion ℚ) a, algebraMap ℚ (w.adicCompletion ℚ) b])) →
        QuaternionAlgebra.nrd (φ (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (((u₁ * u₀⁻¹ : (𝔸ℍ)ˣ)) : 𝔸ℍ))) = 1 := by
    intro w _ φ hφ
    have e0 : QuaternionAlgebra.nrd (φ (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (u₀ : 𝔸ℍ))) *
        QuaternionAlgebra.nrd (φ (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w ((u₀⁻¹ : (𝔸ℍ)ˣ) : 𝔸ℍ))) = 1 := by
      rw [← nrd_mul, ← map_mul, ← map_mul, ← Units.val_mul, mul_inv_cancel, Units.val_one, map_one, map_one,
        QuaternionAlgebra.nrd_one]
    have e1 : QuaternionAlgebra.nrd (φ (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (u₁ : 𝔸ℍ))) = ε w := by
      show _ = QuaternionAlgebra.nrd (coord w (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (u₁ : 𝔸ℍ)))
      rw [chart_eq_coord w φ hφ]
    rw [Units.val_mul, map_mul, map_mul, nrd_mul, e1, ← hu₀n w φ hφ]
    exact e0

  have hqv : (q' : 𝓞 ℚ) ∉ v.asIdeal := natCast_not_mem_of_ne hr hq'p hrq' hv
  have hsplit : ∃ z : ℍ[ℚ, a, b] ⊗[ℚ] v.adicCompletion ℚ, z ≠ 0 ∧ ¬ IsUnit z := by
    by_contra hcon
    push_neg at hcon
    exact hqv ((hdef.2.2 v).mp hcon)
  obtain ⟨β, g', u', -, hu', hg', hyeq⟩ :=
    QuaternionAlgebra.IsOrder.exists_nrd_eq_one_and_eq_finiteIdeleDiagonal_mul_mul_of_forall_nrd_eq_one
      hdef.1 hdef.2.1 hRo v hsplit (u₁ * u₀⁻¹) hynorm

  refine ⟨γ₁ * β,
    (Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] β)⁻¹ * g₁ * Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] β * g',
    u' * u₀, Subgroup.mul_mem _ hu' hu₀, ?_, ?_⟩
  · intro w hw
    have hg₁w : Units.map (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w).toRingHom.toMonoidHom g₁ = 1 :=
      Units.ext (hg₁ w hw)
    have hg'w : Units.map (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w).toRingHom.toMonoidHom g' = 1 :=
      Units.ext (hg' w hw)
    have h : Units.map (Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w).toRingHom.toMonoidHom
        ((Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] β)⁻¹ * g₁ * Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] β * g') = 1 := by
      rw [map_mul, map_mul, map_mul, map_inv, hg₁w, hg'w, mul_one, mul_one, inv_mul_cancel]
    have h' := congrArg Units.val h
    rw [Units.coe_map, Units.val_one] at h'
    exact h'
  · have hu₁eq : u₁ = Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] β * g' * u' * u₀ := by
      rw [← hyeq, inv_mul_cancel_right]
    rw [hx, hu₁eq, map_mul]
    group

end QuaternionAlgebra.IsEichlerOrder.SAGen

end

open IsDedekindDomain NumberField _root_.QuaternionAlgebra _root_.P2MW.S_QuaternionAlgebra_IsEichlerOrder_exists_eq_finiteIdeleDiagonal_mul_mul.QuaternionAlgebra in
theorem solution
    {a b : ℚ} (q' : ℕ) [Fact q'.Prime] (hq5 : 5 ≤ q') (hdef : IsDefiniteRamifiedExactlyAt a b q')
    {N : ℕ} [NeZero N]
    {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : IsEichlerOrder R N)
    (r : ℕ) [Fact r.Prime] (hrq' : r ≠ q')
    (v : HeightOneSpectrum (𝓞 ℚ)) (hv : ((r : ℕ) : 𝓞 ℚ) ∈ v.asIdeal)
    (x : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) :
    ∃ (γ : (ℍ[ℚ, a, b])ˣ) (g u : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ),
      u ∈ Submodule.finiteIdeleStabilizer R ∧
      (∀ w : HeightOneSpectrum (𝓞 ℚ), w ≠ v →
        Submodule.finiteAdeleEvalAt ℍ[ℚ, a, b] w (g : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) = 1) ∧
      x = Submodule.finiteIdeleDiagonal ℍ[ℚ, a, b] γ * g * u :=
  QuaternionAlgebra.IsEichlerOrder.SAGen.main q' hq5 hdef hR r hrq' v hv x

end S_QuaternionAlgebra_IsEichlerOrder_exists_eq_finiteIdeleDiagonal_mul_mul
