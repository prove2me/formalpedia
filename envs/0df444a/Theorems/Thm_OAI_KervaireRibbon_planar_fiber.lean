-- title:
--   Components of a planar pair are planar
-- statement:
--   For permutations $\sigma,\theta$ of a finite set $D$, $k(\sigma,\theta)$ is the equivalence relation generated by their cycles (the components), $c(\cdot)$ counts cycles, and $(\sigma,\theta)$ is planar if $c(\sigma)+c(\theta)+c(\sigma\theta)=|D|+2\,\#k(\sigma,\theta)$. If $(\sigma,\theta)$ is planar, then for every component $C$ the restricted pair $(\sigma_C,\theta_C)$ is planar:
--   $$
--   c(\sigma_C)+c(\theta_C)+c(\sigma_C\theta_C)=|C|+2 .
--   $$
--
--   So every component of a planar ribbon diagram is a connected genus-zero diagram.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/ComponentFibers.lean#L96-L130

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression
import Definitions.Def_OAI_GroupTheory_Kervaire_ComponentFibers

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

theorem OAI.KervaireRibbon.planar_fiber (σ θ : Equiv.Perm D) (hp : planar σ θ) (c : Quotient (components σ θ)) :
    planar (fiberPerm σ (components σ θ) le_sup_left c)
      (fiberPerm θ (components σ θ) le_sup_right c) := by sorry
