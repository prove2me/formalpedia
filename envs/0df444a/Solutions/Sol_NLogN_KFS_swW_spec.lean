lemma valid_swapPos {sh : Shape} {p q : ℕ} (hp : p < sh.length) (hq : q < sh.length)
    (hs : sh.getD p 0 = sh.getD q 0) {a : List ℕ} (ha : AModel.Valid sh a) :
    AModel.Valid sh (swapPos p q a) := by
