theorem upd3s {F : Fin HS → List ℤ} {a b : Fin HS} (hab : a ≠ b) (Q v : List ℤ) :
    update (update (update F a Q) b v) a (F a) = update F b v := by
  funext j
  by_cases h1 : j = a
  · subst h1; simp [hab]
  · simp [update_apply, h1]

section ax
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {eX : Fin Pp}
  {σ : Fin 19 → Fin HS} {dS dA : Fin HS} (hW : SwOK σ dS dA)
  {P : Prm} {n : ℕ} {src : ℕ → ℕ} {D : ℕ} {Cx : ℝ}
  {pf : ℕ → List GI → List GI}
  (hX : AxisBodyF P n src D pf Isym tbl eX dA Cx) (hD : dP6 P n = D + 1)
include hW hX hD

theorem axB_run_sol_aux (B k : ℕ) (hk : k ≤ D) (hb : SwB P n src D B) (s : IState HS)
    (F : Fin HS → List ℤ) (L : List GI) (l c17 : List ℤ) (hlen : L.length = TW P n D)
    (hgb : GB (pP6 P n + 2) L) :
    IRuns Isym tbl (axB σ dS dA eX)
      (encK s (SS σ dS F (gflat L ++ l) ((svW src D).drop k) (update (vK P n src D k) 17 c17)))
      (encK s (SS σ dS F (gflat (pf k L) ++ l) ((svW src D).drop (k + 1))
        (update (vK P n src D (k + 1)) 17 c17))) (cAx ⌊Cx⌋₊ B) := by
  have zle : ∀ x : ℕ, x ≤ B → zsz (x : ℤ) ≤ B := fun x hx =>
    le_trans (zsz_natCast_le_self x) hx
  obtain ⟨hpre, ht, hpost, hpt⟩ := le_TW_pre P n D k hk
  have hkB : D + 1 ≤ B := by have := hb.hB; omega
  have P1 := (axP1_sp hW P n src D B k hk hb s F (gflat L ++ l) c17).toIRuns
    (I := Isym) (iprog := tbl)
  set G := SS σ dS F (gflat L ++ l) ((svW src D).drop (k + 1)) (wK P n src D k c17) with hG
  set xs : List ℤ := [((D + 1 : ℕ) : ℤ), (αN6 P n : ℤ), (pP6 P n : ℤ), (tF6 P n k : ℤ),
    (src k : ℤ), (postT P n D k : ℤ), (preT P n D k : ℤ), (k : ℤ)] with hxs
  have D2 := dups_run (I := Isym) (iprog := tbl) s dA B (axRegs σ) xs G rfl
    (fun r hr => by
      simp only [axRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> exact hW.neA _)
    (fun i h1 h2 => by
      simp only [axRegs, List.length_cons, List.length_nil] at h1
      interval_cases i <;> simp [axRegs, hxs, hG, SS_at hW, wK, vK, vH, update_apply])
    (fun x hx => by
      simp only [hxs, List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact zle _ hkB
      · exact hb.α
      · exact hb.p
      · exact zle_of hb.T ht
      · exact hb.s k hk
      · exact zle_of hb.T hpost
      · exact zle_of hb.T hpre
      · exact zle _ (by omega))
  have hxr : xs.reverse = descAx6 P n src D k := by
    simp [hxs, descAx6, hD]
  rw [hxr] at D2
  obtain ⟨c, R, hc⟩ := ax_callF hX hW.A0 k hk s G L l (SS_at0 hW ..) hlen hgb
  have D3 := drops_run (I := Isym) (iprog := tbl) s dA B (descAx6 P n src D k) (G dA)
    (update (update G dA (descAx6 P n src D k ++ G dA)) 0 (gflat (pf k L) ++ l))
    (by rw [update_of_ne hW.A0, update_self])
    (fun x hx => by
      simp only [descAx6, List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact zle _ (by omega)
      · exact zle_of hb.T hpre
      · exact zle_of hb.T hpost
      · exact hb.s k hk
      · exact zle_of hb.T ht
      · exact hb.p
      · exact hb.α
      · rw [hD]; exact zle _ hkB)
  rw [upd3s hW.A0, hG, SS_z hW] at D3
  have hl8 : (descAx6 P n src D k).length = 8 := rfl
  rw [hl8] at D3
  have P2 := (axP2_sp hW P n src D B k hk hb s F (gflat (pf k L) ++ l)
    ((svW src D).drop (k + 1)) c17).toIRuns (I := Isym) (iprog := tbl)
  have hcf : c ≤ ⌊Cx⌋₊ := Nat.le_floor hc
  refine (P1.seq (D2.seq (R.seq (D3.seq P2)))).mono ?_
  simp only [axRegs, List.length_cons, List.length_nil, cAx]
  omega

end ax

