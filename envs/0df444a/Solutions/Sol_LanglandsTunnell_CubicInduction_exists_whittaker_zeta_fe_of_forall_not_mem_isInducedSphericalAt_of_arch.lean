p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField
open scoped BigOperators

open LanglandsTunnell.CubicInduction.LocalFactorProduct

private theorem glMap_longWeyl3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B) :
    Matrix.GeneralLinearGroup.map f (longWeyl3 : GL (Fin 3) A) = (longWeyl3 : GL (Fin 3) B) := by
  apply Units.ext
  show f.mapMatrix !![0, 0, 1; 0, 1, 0; 1, 0, 0] = !![0, 0, 1; 0, 1, 0; 1, 0, 0]
  rw [RingHom.mapMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

private theorem glMap_transposeInv3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B) (g : GL (Fin 3) A) :
    Matrix.GeneralLinearGroup.map f (transposeInv3 g) = transposeInv3 (Matrix.GeneralLinearGroup.map f g) :=
  Units.ext rfl

private theorem glMap_longWeyl3_mul_transposeInv3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B)
    (g : GL (Fin 3) A) :
    Matrix.GeneralLinearGroup.map f (longWeyl3 * transposeInv3 g) =
      longWeyl3 * transposeInv3 (Matrix.GeneralLinearGroup.map f g) := by
  rw [map_mul, glMap_longWeyl3, glMap_transposeInv3]

private theorem componentAt3_longWeyl3_mul_transposeInv3 (v : HeightOneSpectrum (𝓞 ℚ)) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (longWeyl3 * transposeInv3 g) = longWeyl3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g) :=
  glMap_longWeyl3_mul_transposeInv3 ((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)) g

private theorem archComponent3_longWeyl3_mul_transposeInv3 (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (longWeyl3 * transposeInv3 g) = longWeyl3 * transposeInv3 (archComponent3 (𝓞 ℚ) ℚ g) :=
  glMap_longWeyl3_mul_transposeInv3 (AdelicLevel.adeleArch (𝓞 ℚ) ℚ) g

private theorem dualWhittakerFn3_adelicProduct (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ)
    (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ) :
    dualWhittakerFn3 (adelicProduct Warch Wloc) =
      adelicProduct (dualWhittakerFn3 Warch) (fun v => dualWhittakerFn3 (Wloc v)) := by
  funext g
  simp only [dualWhittakerFn3_apply, adelicProduct, archComponent3_longWeyl3_mul_transposeInv3,
    componentAt3_longWeyl3_mul_transposeInv3]

private theorem dualWhittakerFn3_adelicProduct_apply (Warch : GL (Fin 3) (InfiniteAdeleRing ℚ) → ℂ)
    (Wloc : (v : HeightOneSpectrum (𝓞 ℚ)) → LocalGL3 v → ℂ) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    dualWhittakerFn3 (adelicProduct Warch Wloc) g =
      dualWhittakerFn3 Warch (archComponent3 (𝓞 ℚ) ℚ g) *
        ∏ᶠ v, dualWhittakerFn3 (Wloc v) (componentAt3 (𝓞 ℚ) ℚ v g) := by
  rw [dualWhittakerFn3_adelicProduct]
  rfl

private theorem glMap_lowerUnipotent21 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B) (x : A) :
    Matrix.GeneralLinearGroup.map f (lowerUnipotent21 x) = lowerUnipotent21 (f x) := by
  apply Units.ext
  show f.mapMatrix !![1, 0, 0; x, 1, 0; 0, 0, 1] = !![1, 0, 0; f x, 1, 0; 0, 0, 1]
  rw [RingHom.mapMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

private theorem componentAt3_lowerUnipotent21 (v : HeightOneSpectrum (𝓞 ℚ)) (x : AdeleRing (𝓞 ℚ) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (lowerUnipotent21 x) = lowerUnipotent21 (x.2 v) :=
  glMap_lowerUnipotent21 ((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)) x

private theorem archComponent3_lowerUnipotent21 (x : AdeleRing (𝓞 ℚ) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (lowerUnipotent21 x) = lowerUnipotent21 x.1 :=
  glMap_lowerUnipotent21 (AdelicLevel.adeleArch (𝓞 ℚ) ℚ) x

private theorem glMap_weylPrime3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B) :
    Matrix.GeneralLinearGroup.map f (weylPrime3 : GL (Fin 3) A) = (weylPrime3 : GL (Fin 3) B) := by
  apply Units.ext
  show f.mapMatrix !![1, 0, 0; 0, 0, 1; 0, 1, 0] = !![1, 0, 0; 0, 0, 1; 0, 1, 0]
  rw [RingHom.mapMatrix_apply]
  ext i j
  fin_cases i <;> fin_cases j <;> simp

private theorem glMap_weylPrime3_mul_transposeInv3 {A B : Type} [CommRing A] [CommRing B] (f : A →+* B)
    (g : GL (Fin 3) A) :
    Matrix.GeneralLinearGroup.map f (weylPrime3 * transposeInv3 g) =
      weylPrime3 * transposeInv3 (Matrix.GeneralLinearGroup.map f g) := by
  rw [map_mul, glMap_weylPrime3, glMap_transposeInv3]

private theorem componentAt3_weylPrime3_mul_transposeInv3 (v : HeightOneSpectrum (𝓞 ℚ)) (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    componentAt3 (𝓞 ℚ) ℚ v (weylPrime3 * transposeInv3 g) = weylPrime3 * transposeInv3 (componentAt3 (𝓞 ℚ) ℚ v g) :=
  glMap_weylPrime3_mul_transposeInv3 ((AdelicLevel.finAdeleEval (𝓞 ℚ) ℚ v).comp (AdelicLevel.adeleFin (𝓞 ℚ) ℚ)) g

private theorem archComponent3_weylPrime3_mul_transposeInv3 (g : AdelicGL 3 (𝓞 ℚ) ℚ) :
    archComponent3 (𝓞 ℚ) ℚ (weylPrime3 * transposeInv3 g) = weylPrime3 * transposeInv3 (archComponent3 (𝓞 ℚ) ℚ g) :=
  glMap_weylPrime3_mul_transposeInv3 (AdelicLevel.adeleArch (𝓞 ℚ) ℚ) g

private theorem weylPrime3_mem_localMaximalCompact3 (v : HeightOneSpectrum (𝓞 ℚ)) :
    (weylPrime3 : LocalGL3 v) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · show Valued.v ((!![1, 0, 0; 0, 0, 1; 0, 1, 0] : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1
    fin_cases i <;> fin_cases j <;> simp
  · show Valued.v ((!![1, 0, 0; 0, 0, 1; 0, 1, 0] : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1
    fin_cases i <;> fin_cases j <;> simp

private theorem longWeyl3_mem_localMaximalCompact3 (v : HeightOneSpectrum (𝓞 ℚ)) :
    (longWeyl3 : LocalGL3 v) ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff]
  refine ⟨fun i j => ?_, fun i j => ?_⟩
  · show Valued.v ((!![0, 0, 1; 0, 1, 0; 1, 0, 0] : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1
    fin_cases i <;> fin_cases j <;> simp
  · show Valued.v ((!![0, 0, 1; 0, 1, 0; 1, 0, 0] : Matrix (Fin 3) (Fin 3) (v.adicCompletion ℚ)) i j) ≤ 1
    fin_cases i <;> fin_cases j <;> simp

private theorem transposeInv3_mem_localMaximalCompact3 {v : HeightOneSpectrum (𝓞 ℚ)} {k : LocalGL3 v}
    (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) : transposeInv3 k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v := by
  rw [mem_localMaximalCompact3_iff] at hk ⊢
  exact ⟨fun i j => hk.2 j i, fun i j => hk.1 j i⟩

private theorem weylPrime3_mul_transposeInv3_mem_localMaximalCompact3 {v : HeightOneSpectrum (𝓞 ℚ)} {k : LocalGL3 v}
    (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    weylPrime3 * transposeInv3 k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
  Subgroup.mul_mem _ (weylPrime3_mem_localMaximalCompact3 v) (transposeInv3_mem_localMaximalCompact3 hk)

private theorem longWeyl3_mul_transposeInv3_mem_localMaximalCompact3 {v : HeightOneSpectrum (𝓞 ℚ)} {k : LocalGL3 v}
    (hk : k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v) :
    longWeyl3 * transposeInv3 k ∈ localMaximalCompact3 (𝓞 ℚ) ℚ v :=
  Subgroup.mul_mem _ (longWeyl3_mem_localMaximalCompact3 v) (transposeInv3_mem_localMaximalCompact3 hk)

end LanglandsTunnell.CubicInduction.DualProduct

