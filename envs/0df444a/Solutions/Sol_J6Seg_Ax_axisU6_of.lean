attribute [local irreducible] fmA Cfm

theorem Ncost6_ge_one (P : Prm) (hP : P.Ok) (n : ℕ) : 1 ≤ Ncost6 P n := by
  unfold Ncost6 Ncost6R
  have hp1 : (1 : ℝ) ≤ pP6 P n := by
    have := b'P6_pos P n
    have : 1 ≤ pP6 P n := by unfold pP6; omega
