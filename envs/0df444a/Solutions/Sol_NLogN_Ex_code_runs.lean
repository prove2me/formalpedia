    ⟨hWQ, hWR, hWT⟩, ⟨hQR, hQT⟩, hRT⟩ := hd'
  have hAX' := Ne.symm hAX; have hAY' := Ne.symm hAY; have hAW' := Ne.symm hAW; have hAQ' := Ne.symm hAQ; have hAR' := Ne.symm hAR; have hAT' := Ne.symm hAT; have hXY' := Ne.symm hXY; have hXW' := Ne.symm hXW; have hXQ' := Ne.symm hXQ; have hXR' := Ne.symm hXR; have hXT' := Ne.symm hXT; have hYW' := Ne.symm hYW; have hYQ' := Ne.symm hYQ; have hYR' := Ne.symm hYR; have hYT' := Ne.symm hYT; have hWQ' := Ne.symm hWQ; have hWR' := Ne.symm hWR; have hWT' := Ne.symm hWT; have hQR' := Ne.symm hQR; have hQT' := Ne.symm hQT; have hRT' := Ne.symm hRT
