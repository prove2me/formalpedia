/-- Placements of one class with pattern word `u0`. `item` is a sequence of 7-bit codes, lowest first:
`code ≥ 82` sets the current image `v` to `symU (code - 82) u0`; a smaller code translates `v` by
`t = code - 1` and appends the result to `acc` (50-bit fields, newest lowest) if it stays on the board. -/
def plcGo (u0 fuel : Nat) : Nat → Nat → Nat → Nat :=
  Nat.rec (motive := fun _ => Nat → Nat → Nat → Nat) (fun _ _ acc => acc)
    (fun _ ih item v acc => force acc (fun acc => nz item acc (fun item =>
      force (Nat.land item 127) (fun code => Bool.rec
        (Bool.rec (ih (Nat.shiftRight item 7) v acc)
          (ih (Nat.shiftRight item 7) v (Nat.add (Nat.mul acc 1125899906842624)
            (Nat.land (Nat.shiftRight (Nat.shiftLeft v
              (Nat.add (Nat.mul 5 (Nat.div (Nat.sub code 1) 9)) (Nat.mod (Nat.sub code 1) 9))) 24)
              1125899906842623)))
          (Nat.beq (Nat.land v (Nat.land (Nat.shiftRight BADT (Nat.mul 50 (Nat.sub code 1)))
            1125899906842623)) 0))
        (force (Nat.land (symU (Nat.land (Nat.sub code 82) 7) u0) 1125899906842623)
          (fun v => ih (Nat.shiftRight item 7) v acc))
        (Nat.ble 82 code))))) fuel

/-- Table of the placed nogoods of all classes (`pl` gives the codes of each class). -/
def gtb (lib : List (Nat × Nat)) : List Nat → Nat → Nat :=
  List.rec (motive := fun _ => List Nat → Nat → Nat) (fun _ acc => acc)
    (fun x _ ih pl acc => List.rec (motive := fun _ => Nat) acc
      (fun item pl' _ => force (force (Nat.lor (Nat.land x.1 33554431)
        (Nat.shiftLeft (Nat.land x.2 33554431) 25)) (fun u0 => plcGo u0 400 item u0 acc))
          (fun acc' => ih pl' acc')) pl) lib

/-- Weights of the fundamental domain: field `m` (60 bits) belongs to the cell `24 - m` and holds
`w1 + 2^20 w2 + 2^40 w3`. -/
