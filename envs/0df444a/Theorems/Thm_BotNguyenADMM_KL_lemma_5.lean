-- title:
--   Lemma 5 — estimates for ‖z^{k+1} − z^k‖, ‖y^{k+1}‖² and ‖y^{k+1} − y^k‖ along the iterates
-- statement:
--   Suppose Assumption 1 holds and $\{(x^k,z^k,y^k)\}_{k\ge0}$ is generated by Algorithm 1 or Algorithm 2. Then:
--   1. for every $k\ge1$,
--   $$\|z^{k+1}-z^k\|\le\|A\|\,\|x^{k+1}-x^k\|+\|Ax^{k+1}-z^{k+1}\|+\|Ax^k-z^k\|=\|A\|\,\|x^{k+1}-x^k\|+\tfrac1{\rho r}\|y^{k+1}-y^k\|+\tfrac1{\rho r}\|y^k-y^{k-1}\|;$$
--   2. for every $k\ge0$,
--   $$\tfrac1{2r}\|y^{k+1}\|^2\le\tfrac{T_1}2\|A^*(y^{k+1}-y^k)\|^2+\tfrac{T_0}r\|\nabla h(x^{k+1})\|^2+\tfrac{C_1}4\|x^{k+1}-x^k\|^2;$$
--   3. for every $k\ge1$,
--   $$\|y^{k+1}-y^k\|\le C_3\|x^{k+1}-x^k\|+C_4\|x^k-x^{k-1}\|+T_2\big(\|A^*(y^k-y^{k-1})\|-\|A^*(y^{k+1}-y^k)\|\big),$$
--   with $C_3$, $C_4$, $T_2$ as defined in the paper (they depend on the algorithm, $\rho$, $L$, $\mu_1$ and $\lambda_{\min}(AA^*)$).
--
--   These estimates control the $z$- and $y$-increments by the $x$-increments; (iii) is what lets the finite length of $\{x^k\}$ transfer to $\{y^k\}$ and $\{z^k\}$.
--
--   **Formalization Note** $\lambda_{\min}(AA^*)$ and $\mu_1$ are the parameters `lam`, `μ₁` of `Assumption1`; $\|A\|$ is the operator norm.
-- source:
--   Boţ and Nguyen, The proximal ADMM in the nonconvex setting, arXiv:1801.01994v2, pp. 12–13, Lemma 5, (39)–(41)

import Mathlib
import Definitions.Def_NonconvexSplitting_Shared_StandingAssumptions
import Definitions.Def_NonconvexSplitting_Shared_LimitingSubdiff
import Definitions.Def_BotNguyenADMM_KL_Setting
open NonconvexSplitting.Shared BotNguyenADMM.KL
open Filter Topology
open scoped RealInnerProductSpace

namespace BotNguyenADMM.KL

/-- Lemma 5 (pp. 12–13). Under Assumption 1, for a sequence generated by Algorithm 1 or
Algorithm 2:
(i) for every `k ≥ 1`, (39): `‖zᵏ⁺¹ − zᵏ‖ ≤ ‖A‖‖xᵏ⁺¹ − xᵏ‖ + ‖Axᵏ⁺¹ − zᵏ⁺¹‖ + ‖Axᵏ − zᵏ‖`, and the
right-hand side equals `‖A‖‖xᵏ⁺¹ − xᵏ‖ + (1/(ρr))‖yᵏ⁺¹ − yᵏ‖ + (1/(ρr))‖yᵏ − yᵏ⁻¹‖`;
(ii) for every `k ≥ 0`, (40):
`(1/(2r))‖yᵏ⁺¹‖² ≤ (T₁/2)‖A*(yᵏ⁺¹ − yᵏ)‖² + (T₀/r)‖∇h(xᵏ⁺¹)‖² + (C₁/4)‖xᵏ⁺¹ − xᵏ‖²`;
(iii) for every `k ≥ 1`, (41):
`‖yᵏ⁺¹ − yᵏ‖ ≤ C₃‖xᵏ⁺¹ − xᵏ‖ + C₄‖xᵏ − xᵏ⁻¹‖ + T₂(‖A*(yᵏ − yᵏ⁻¹)‖ − ‖A*(yᵏ⁺¹ − yᵏ)‖)`. -/
theorem lemma_5 {n m : ℕ} (v : Variant) (P : Data n m) (hA : Assumption1 v P)
    (x : ℕ → E n) (z y : ℕ → E m) (hrun : IsRun v P x z y) :
    (∀ k, 1 ≤ k →
      ‖z (k + 1) - z k‖ ≤ ‖P.A‖ * ‖x (k + 1) - x k‖ + ‖P.A (x (k + 1)) - z (k + 1)‖
          + ‖P.A (x k) - z k‖ ∧
      ‖P.A‖ * ‖x (k + 1) - x k‖ + ‖P.A (x (k + 1)) - z (k + 1)‖ + ‖P.A (x k) - z k‖
        = ‖P.A‖ * ‖x (k + 1) - x k‖ + 1 / (P.ρ * P.r) * ‖y (k + 1) - y k‖
          + 1 / (P.ρ * P.r) * ‖y k - y (k - 1)‖) ∧
    (∀ k, 1 / (2 * P.r) * ‖y (k + 1)‖ ^ 2 ≤
      T1 P / 2 * ‖ContinuousLinearMap.adjoint P.A (y (k + 1) - y k)‖ ^ 2
        + T0 P / P.r * ‖gradient P.h (x (k + 1))‖ ^ 2 + C1 v P / 4 * ‖x (k + 1) - x k‖ ^ 2) ∧
    (∀ k, 1 ≤ k →
      ‖y (k + 1) - y k‖ ≤ C3 v P * ‖x (k + 1) - x k‖ + C4 v P * ‖x k - x (k - 1)‖
        + T2 P * (‖ContinuousLinearMap.adjoint P.A (y k - y (k - 1))‖
          - ‖ContinuousLinearMap.adjoint P.A (y (k + 1) - y k)‖)) := by sorry

end BotNguyenADMM.KL
