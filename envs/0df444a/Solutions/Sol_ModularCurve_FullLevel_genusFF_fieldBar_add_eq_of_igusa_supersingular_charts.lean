def integersEquivOfEqComap (C : ComponentChart A F Fbar₁) (R : RegularProlongation A F Fbar₂) (τ : F ≃ₐ[L] F)
    (h : C.integers = R.integers.comap τ.toAlgHom.toRingHom) : C.integers ≃+* R.integers where
  toFun x := ⟨τ x, (SetLike.ext_iff.mp h (x : F)).mp x.2⟩
  invFun y := ⟨τ.symm y, (SetLike.ext_iff.mp h (τ.symm y : F)).mpr
    (show τ (τ.symm y) ∈ R.integers by rw [AlgEquiv.apply_symm_apply]; exact y.2)⟩
  left_inv x := Subtype.ext (τ.symm_apply_apply x)
  right_inv y := Subtype.ext (τ.apply_symm_apply y)
  map_mul' x y := Subtype.ext (map_mul τ (x : F) (y : F))
  map_add' x y := Subtype.ext (map_add τ (x : F) (y : F))

@[scoped simp] theorem coe_integersEquivOfEqComap (C : ComponentChart A F Fbar₁) (R : RegularProlongation A F Fbar₂)
    (τ : F ≃ₐ[L] F) (h : C.integers = R.integers.comap τ.toAlgHom.toRingHom) (x : C.integers) :
    ((integersEquivOfEqComap C R τ h x : R.integers) : F) = τ x := rfl

def algEquivOfIntegersEqComap (C : ComponentChart A F Fbar₁) (R : RegularProlongation A F Fbar₂) (τ : F ≃ₐ[L] F)
    (h : C.integers = R.integers.comap τ.toAlgHom.toRingHom) : Fbar₁ ≃ₐ[ResidueField A] Fbar₂ :=
  AlgEquiv.ofRingEquiv
    (f := (residueFieldEquiv C).symm.trans
      ((IsLocalRing.ResidueField.mapEquiv (integersEquivOfEqComap C R τ h)).trans R.residueFieldEquiv'))
    (by
      intro k
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective k
      have h₁ := C.residue_algebraMap a
      have h₂ := R.residue_algebraMap a
      rw [← h₁, RingEquiv.trans_apply, RingEquiv.trans_apply, ← residueFieldEquiv_residue, RingEquiv.symm_apply_apply,
        IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue,
        AlgebraicCurve.RegularProlongation.residueFieldEquiv'_residue, ← h₂]
      congr 1
      exact Subtype.ext (AlgEquiv.commutes τ (a : L)))

end Generic
