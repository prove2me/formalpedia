private theorem one_le_shape {δ : ℝ} (e : ℕ) (hδ1 : δ ≤ 1) {p : SizeBound} (hs : 1 ≤ p.s) :
    1 ≤ shape δ e p :=
  one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le
    (Real.one_le_rpow (Nat.one_le_cast.2 hs) (by linarith)) (one_le_log_add_one_pow p.s e))
    (one_le_pow₀ (one_le_one_add_logU p.u))

/-- Below the size `N`, brute force. -/
private theorem dominated_bruteForce' {δ : ℝ} (e N : ℕ) (hδ0 : 0 ≤ δ) :
    Dominated (fun p : SizeBound => (1 ≤ p.s ∧ 1 ≤ p.u) ∧ p.s < N)
      (fun p => (p.s : ℝ) ^ 3 * (1 + logU p.u)) (shape δ e) := by
  refine .of_le_const_mul (C := (N : ℝ) ^ δ) (by positivity) fun p hp => ?_
  have hlog := one_le_log_add_one_pow p.s e
  have hwords := one_le_one_add_logU p.u
  have hs0 : (0 : ℝ) < p.s := Nat.cast_pos.2 hp.1.1
  have hsplit : (p.s : ℝ) ^ 3 = (p.s : ℝ) ^ δ * (p.s : ℝ) ^ (3 - δ) := by
    rw [← Real.rpow_add hs0, ← Real.rpow_natCast]
    congr 1
    push_cast
    ring
  have hsmall : (p.s : ℝ) ^ δ ≤ (N : ℝ) ^ δ :=
    Real.rpow_le_rpow hs0.le (Nat.cast_le.2 hp.2.le) hδ0
  calc (p.s : ℝ) ^ 3 * (1 + logU p.u)
      = (p.s : ℝ) ^ δ * ((p.s : ℝ) ^ (3 - δ) * 1 * (1 + logU p.u) ^ 1) := by rw [hsplit]; ring
    _ ≤ (N : ℝ) ^ δ * ((p.s : ℝ) ^ (3 - δ) * (Real.log p.s + 1) ^ e * (1 + logU p.u) ^ 2) := by
        gcongr
        norm_num

private theorem le_rpow_max_log_div' {s : ℕ} {u : ℝ} (hs : 3 ≤ s) (hu : 1 ≤ u) :
    u ≤ (s : ℝ) ^ max 1 (Real.log u / Real.log s) := by
  have hs0 : (0 : ℝ) < s := Nat.cast_pos.2 (by omega)
  have hlogs : 1 ≤ Real.log s := Real.one_le_log_natCast_of_three_le hs
  calc u = (s : ℝ) ^ (Real.log u / Real.log s) := by
        rw [Real.rpow_def_of_pos hs0, mul_div_cancel₀ _ (by linarith),
          Real.exp_log (zero_lt_one.trans_le hu)]
    _ ≤ (s : ℝ) ^ max 1 (Real.log u / Real.log s) :=
        Real.rpow_le_rpow_of_exponent_le (Nat.one_le_cast.2 (by omega)) (le_max_right _ _)

private theorem max_log_div_le' {s : ℕ} {u : ℝ} (hs : 3 ≤ s) (hu : 1 ≤ u) :
    max 1 (Real.log u / Real.log s) ≤ 1 + logU u := by
  refine max_le (one_le_one_add_logU u) ?_
  linarith [div_le_self (Real.log_nonneg hu) (Real.one_le_log_natCast_of_three_le hs),
    log_le_logU (zero_lt_one.trans_le hu)]

/-- From the size `max n₀ 3` on: the explicit bound with `κ = max 1 (log u / log s)`. -/
private theorem dominated_explicit' {T : ℕ → ℝ → ℝ} {K δ : ℝ} {e n₀ : ℕ}
    (hb : ∀ (n : ℕ) (κ u : ℝ), n₀ ≤ n → 1 ≤ κ → u ≤ (n : ℝ) ^ κ →
      T n u ≤ K * (κ * ((n : ℝ) ^ (3 - δ) * Real.log n ^ e))) :
    Dominated (fun p : SizeBound => (1 ≤ p.s ∧ 1 ≤ p.u) ∧ ¬ p.s < max n₀ 3)
      (fun p => T p.s p.u) (shape δ e) := by
  have h3 : ∀ p : SizeBound, ¬ p.s < max n₀ 3 → 3 ≤ p.s := fun p hp =>
    le_of_max_le_right (not_lt.1 hp)
  refine (Dominated.of_exists_const (g := fun p => max 1 (Real.log p.u / Real.log p.s) *
    ((p.s : ℝ) ^ (3 - δ) * Real.log p.s ^ e)) ⟨K, fun p hp => ?_⟩ fun p _ => ?_).trans
    (.of_le fun p hp => ?_)
  · exact hb p.s _ p.u (le_of_max_le_left (not_lt.1 hp.2)) (le_max_left _ _)
      (le_rpow_max_log_div' (h3 p hp.2) hp.1.2)
  · positivity
  · have hκ := max_log_div_le' (h3 p hp.2) hp.1.2
    have hlog := Real.log_natCast_nonneg p.s
    have hwords := le_self_pow₀ (one_le_one_add_logU p.u) two_ne_zero
    calc max 1 (Real.log p.u / Real.log p.s) * ((p.s : ℝ) ^ (3 - δ) * Real.log p.s ^ e)
        ≤ (1 + logU p.u) ^ 2 * ((p.s : ℝ) ^ (3 - δ) * (Real.log p.s + 1) ^ e) := by
          gcongr
          · exact hκ.trans hwords
          · linarith
      _ = shape δ e p := by ring

end Theorem19Mid

open Theorem19Mid in
/-- From the explicit form of Theorem 19 from a threshold `n₀` on, brute force for small
instances and two closure properties: Exact Triangle in time
`K s^{3-δ} (log s + 1)^e (1 + log u)²` for all `s` and `u` (as `exactTriangleUniform_of_explicit`). -/
theorem exactTriangleUniform_of_explicitAt (M : DetTimeModel) {δ : ℝ} (e n₀ : ℕ) (hδ0 : 0 ≤ δ)
    (hδ1 : δ ≤ 1) (hex : Claim.Theorem_19_explicitAt M δ e n₀) (hbf : Claim.BruteForce M)
    (hch : Closure.ChooseBySize M) (hmono : Closure.MonoExactTriangle M) :
    Claim.ExactTriangleUniform M δ e := by
  obtain ⟨K, T, hT, hb⟩ := hex
  obtain ⟨C, hbf⟩ := hbf
  obtain ⟨C₀, hch⟩ := hch (max n₀ 3)
  have hshape : ∀ p : SizeBound, 1 ≤ p.s ∧ 1 ≤ p.u → 1 ≤ shape δ e p := fun p hp =>
    one_le_shape e hδ1 hp.1
  have hsmall := (dominated_bruteForce' e (max n₀ 3) hδ0).const_mul_of_nonneg C fun p _ =>
    mul_nonneg (by positivity) (zero_le_one.trans (one_le_one_add_logU p.u))
  obtain ⟨K', hK'0, hK'⟩ := (Dominated.ite hsmall (dominated_explicit' hb) fun p hp =>
    zero_le_one.trans (hshape p hp)).add (.const C₀ hshape)
  refine ⟨1 + K', le_add_of_nonneg_right hK'0,
    hmono _ _ (fun s u hs hu => ?_) (hch _ T hbf hT)⟩
  exact (hK' ⟨s, u⟩ ⟨hs, hu⟩).trans (mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one)
    (zero_le_one.trans (hshape ⟨s, u⟩ ⟨hs, hu⟩)))

namespace Theorem19Mid

/-- **The costs added up**, for one size, in terms of `D`: every term is
`O(κ n³ D^{-11/300} log² n)`.  `t` is the time of one call of the detection algorithm, at the middle
dimension `Dm`, `C` its constant, and `C'` the constant of Theorem 17. -/
theorem total_le {n D g Dm : ℕ} {κ C C' t : ℝ} (hκ : 1 ≤ κ) (hC : 0 ≤ C) (hC' : 0 ≤ C')
    (hD16 : 16 ≤ D) (hD17 : D ^ 17 ≤ n) (hDm1 : 1 ≤ Dm) (hDmD : Dm ≤ D)
    (hg1 : (D : ℝ) ^ (11 / 300 : ℝ) ≤ g) (hg2 : (g : ℝ) ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ))
    (hDm_le : (Dm : ℝ) ≤ 2 * (D : ℝ) ^ (289 / 300 : ℝ))
    (hDm_ge : (D : ℝ) ^ (289 / 300 : ℝ) ≤ 8 * Dm)
    (ht : t ≤ C * ((n : ℝ) ^ 2 * Real.log Dm ^ 2 / (Dm : ℝ) ^ (0.07618 : ℝ)
        + (queryCap n D : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) * Real.log Dm + (n : ℝ) * Dm
        + queryCap n D + 1)) :
    4 * (n : ℝ) * g * (t + C' * ((n : ℝ) ^ 2 / Real.sqrt D))
        + C' * (termScans n g κ + termPrime strassen n D + termBuild n D g)
      ≤ (104 * C + 12 * C') *
        (κ * ((n : ℝ) ^ 3 * (D : ℝ) ^ (-(11 / 300 : ℝ)) * Real.log n ^ 2)) := by
  -- Positivity and the logarithms.
  have hD1 : (1 : ℝ) ≤ D := by exact_mod_cast (show 1 ≤ D by omega)
  have hD0 : (0 : ℝ) < D := zero_lt_one.trans_le hD1
  have hDn : D ≤ n := (Nat.le_self_pow (by norm_num) D).trans hD17
  have hn1 : (1 : ℝ) ≤ n := hD1.trans (Nat.cast_le.2 hDn)
  have hn0 : (0 : ℝ) < n := zero_lt_one.trans_le hn1
  have hDm0 : (0 : ℝ) < Dm := by exact_mod_cast hDm1
  have hg0 : (0 : ℝ) < g := (Real.rpow_pos_of_pos hD0 _).trans_le hg1
  have hL1 : 1 ≤ Real.log n := Real.one_le_log_natCast_of_three_le (by omega)
  have hLDm0 : 0 ≤ Real.log Dm := Real.log_natCast_nonneg Dm
  have hLDm : Real.log Dm ≤ Real.log n :=
    Real.log_le_log hDm0 (Nat.cast_le.2 (hDmD.trans hDn))
  have hsqrt0 : 0 < Real.sqrt D := Real.sqrt_pos.2 hD0
  have hsqrt : Real.sqrt D = (D : ℝ) ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow _
  have hw : (queryCap n D : ℝ) ≤ (n : ℝ) ^ 2 / Real.sqrt D := Nat.floor_le (by positivity)
  have hw0 : (0 : ℝ) ≤ queryCap n D := Nat.cast_nonneg _
  set E := (D : ℝ) ^ (-(11 / 300 : ℝ)) with hE
  have hE0 : 0 < E := Real.rpow_pos_of_pos hD0 _
  set L := Real.log n with hL
  set S := (n : ℝ) ^ 3 * E with hS
  have hS0 : 0 < S := by positivity
  set X := κ * ((n : ℝ) ^ 3 * E * L ^ 2) with hX
  have hL2 : L ≤ L ^ 2 := le_self_pow₀ hL1 two_ne_zero
  have hSX : S ≤ X := by
    rw [hX]
    calc S = 1 * (S * 1) := by ring
      _ ≤ κ * (S * L ^ 2) := by
          gcongr
          exact one_le_pow₀ hL1
  have hSLX : S * L ≤ X := by
    rw [hX]
    calc S * L = 1 * (S * L) := by ring
      _ ≤ κ * (S * L ^ 2) := by gcongr
  have hSL2X : S * L ^ 2 ≤ X := by
    rw [hX]
    calc S * L ^ 2 = 1 * (S * L ^ 2) := by ring
      _ ≤ κ * (S * L ^ 2) := by gcongr
  have hκSLX : κ * (S * L) ≤ X := by
    rw [hX]
    gcongr
  -- Powers of `D`.
  have hpow : ∀ a b : ℝ, a ≤ b → (D : ℝ) ^ a ≤ (D : ℝ) ^ b := fun a b h =>
    Real.rpow_le_rpow_of_exponent_le hD1 h
  have hDsq : (D : ℝ) ^ (2 : ℝ) ≤ n := by
    rw [Real.rpow_two]
    exact_mod_cast (Nat.pow_le_pow_right (by omega) (by norm_num)).trans hD17
  -- `g / √D ≤ 2 D^{-11/300}`.
  have hgsqrt : (g : ℝ) / Real.sqrt D ≤ 2 * E := by
    rw [div_le_iff₀ hsqrt0]
    calc (g : ℝ) ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ) := hg2
      _ ≤ 2 * (D : ℝ) ^ (-(11 / 300 : ℝ) + 1 / 2) := by exact mul_le_mul_of_nonneg_left (hpow _ _ (by norm_num)) (by norm_num)
      _ = 2 * E * Real.sqrt D := by rw [Real.rpow_add hD0, hsqrt, hE]; ring
  -- `g D ≤ 2 n D^{-11/300}`.
  have hgD : (g : ℝ) * D ≤ 2 * n * E :=
    calc (g : ℝ) * D ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ) * (D : ℝ) ^ (1 : ℝ) := by
          rw [Real.rpow_one]; gcongr
      _ = 2 * (D : ℝ) ^ (11 / 300 + 1 : ℝ) := by rw [Real.rpow_add hD0]; ring
      _ ≤ 2 * (D : ℝ) ^ (-(11 / 300 : ℝ) + 2) := by exact mul_le_mul_of_nonneg_left (hpow _ _ (by norm_num)) (by norm_num)
      _ = 2 * E * (D : ℝ) ^ (2 : ℝ) := by rw [Real.rpow_add hD0, hE]; ring
      _ ≤ 2 * E * n := by gcongr
      _ = 2 * n * E := by ring
  have hg_le : (g : ℝ) ≤ 2 * n * E :=
    (le_mul_of_one_le_right hg0.le hD1).trans hgD
  -- The preprocessing part of a call: `g / Dm^{0.07618} ≤ 16 D^{-11/300}`.
  have hA : (g : ℝ) / (Dm : ℝ) ^ (0.07618 : ℝ) ≤ 16 * E := by
    have h8 : ((D : ℝ) ^ (289 / 300 : ℝ)) ^ (0.07618 : ℝ) ≤ 8 * (Dm : ℝ) ^ (0.07618 : ℝ) :=
      calc ((D : ℝ) ^ (289 / 300 : ℝ)) ^ (0.07618 : ℝ) ≤ (8 * (Dm : ℝ)) ^ (0.07618 : ℝ) :=
            Real.rpow_le_rpow (by positivity) hDm_ge (by norm_num)
        _ = (8 : ℝ) ^ (0.07618 : ℝ) * (Dm : ℝ) ^ (0.07618 : ℝ) :=
            Real.mul_rpow (by norm_num) hDm0.le
        _ ≤ (8 : ℝ) ^ (1 : ℝ) * (Dm : ℝ) ^ (0.07618 : ℝ) := by
            gcongr
            exacts [by norm_num, by norm_num]
        _ = 8 * (Dm : ℝ) ^ (0.07618 : ℝ) := by rw [Real.rpow_one]
    rw [div_le_iff₀ (Real.rpow_pos_of_pos hDm0 _)]
    calc (g : ℝ) ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ) := hg2
      _ ≤ 2 * (D : ℝ) ^ (-(11 / 300 : ℝ) + 289 / 300 * 0.07618) :=
          mul_le_mul_of_nonneg_left (hpow _ _ (by norm_num)) (by norm_num)
      _ = 2 * E * ((D : ℝ) ^ (289 / 300 : ℝ)) ^ (0.07618 : ℝ) := by
          rw [Real.rpow_add hD0, ← Real.rpow_mul hD0.le, hE]; ring
      _ ≤ 2 * E * (8 * (Dm : ℝ) ^ (0.07618 : ℝ)) := by gcongr
      _ = 16 * E * (Dm : ℝ) ^ (0.07618 : ℝ) := by ring
  -- The query part of a call: `g Dm^{0.44274} / √D ≤ 4 D^{-11/300}`.
  have hB : (g : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) / Real.sqrt D ≤ 4 * E := by
    have h2 : (Dm : ℝ) ^ (0.44274 : ℝ) ≤ 2 * (D : ℝ) ^ (289 / 300 * 0.44274 : ℝ) :=
      calc (Dm : ℝ) ^ (0.44274 : ℝ) ≤ (2 * (D : ℝ) ^ (289 / 300 : ℝ)) ^ (0.44274 : ℝ) :=
            Real.rpow_le_rpow hDm0.le hDm_le (by norm_num)
        _ = (2 : ℝ) ^ (0.44274 : ℝ) * (D : ℝ) ^ (289 / 300 * 0.44274 : ℝ) := by
            rw [Real.mul_rpow (by norm_num) (by positivity), ← Real.rpow_mul hD0.le]
        _ ≤ (2 : ℝ) ^ (1 : ℝ) * (D : ℝ) ^ (289 / 300 * 0.44274 : ℝ) := by
            gcongr
            exacts [by norm_num, by norm_num]
        _ = 2 * (D : ℝ) ^ (289 / 300 * 0.44274 : ℝ) := by rw [Real.rpow_one]
    rw [div_le_iff₀ hsqrt0]
    calc (g : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ)
        ≤ (2 * (D : ℝ) ^ (11 / 300 : ℝ)) * (2 * (D : ℝ) ^ (289 / 300 * 0.44274 : ℝ)) :=
          mul_le_mul hg2 h2 (by positivity) (by positivity)
      _ = 4 * (D : ℝ) ^ (11 / 300 + 289 / 300 * 0.44274 : ℝ) := by
          rw [Real.rpow_add hD0]; ring
      _ ≤ 4 * (D : ℝ) ^ (-(11 / 300 : ℝ) + 1 / 2) := by exact mul_le_mul_of_nonneg_left (hpow _ _ (by norm_num)) (by norm_num)
      _ = 4 * E * Real.sqrt D := by rw [Real.rpow_add hD0, hsqrt, hE]; ring
  -- The five parts of a call.
  have hcA : 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 * Real.log Dm ^ 2 / (Dm : ℝ) ^ (0.07618 : ℝ))
      ≤ 64 * X :=
    calc 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 * Real.log Dm ^ 2 / (Dm : ℝ) ^ (0.07618 : ℝ))
        = 4 * (n : ℝ) ^ 3 * Real.log Dm ^ 2 * ((g : ℝ) / (Dm : ℝ) ^ (0.07618 : ℝ)) := by ring
      _ ≤ 4 * (n : ℝ) ^ 3 * L ^ 2 * (16 * E) := by gcongr
      _ = 64 * (S * L ^ 2) := by rw [hS]; ring
      _ ≤ 64 * X := by gcongr
  have hcB : 4 * (n : ℝ) * g * ((queryCap n D : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) * Real.log Dm)
      ≤ 16 * X :=
    calc 4 * (n : ℝ) * g * ((queryCap n D : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) * Real.log Dm)
        ≤ 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 / Real.sqrt D * (Dm : ℝ) ^ (0.44274 : ℝ) * L) := by
          gcongr
      _ = 4 * (n : ℝ) ^ 3 * L * ((g : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) / Real.sqrt D) := by ring
      _ ≤ 4 * (n : ℝ) ^ 3 * L * (4 * E) := by gcongr
      _ = 16 * (S * L) := by rw [hS]; ring
      _ ≤ 16 * X := by gcongr
  have hcC : 4 * (n : ℝ) * g * ((n : ℝ) * Dm) ≤ 8 * X :=
    calc 4 * (n : ℝ) * g * ((n : ℝ) * Dm) ≤ 4 * (n : ℝ) * g * ((n : ℝ) * D) := by
          gcongr; try exact_mod_cast hDmD
      _ = 4 * (n : ℝ) ^ 2 * ((g : ℝ) * D) := by ring
      _ ≤ 4 * (n : ℝ) ^ 2 * (2 * n * E) := by gcongr
      _ = 8 * S := by rw [hS]; ring
      _ ≤ 8 * X := by gcongr
  have hsq : 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 / Real.sqrt D) ≤ 8 * X :=
    calc 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 / Real.sqrt D)
        = 4 * (n : ℝ) ^ 3 * ((g : ℝ) / Real.sqrt D) := by ring
      _ ≤ 4 * (n : ℝ) ^ 3 * (2 * E) := by gcongr
      _ = 8 * S := by rw [hS]; ring
      _ ≤ 8 * X := by gcongr
  have hcW : 4 * (n : ℝ) * g * (queryCap n D : ℝ) ≤ 8 * X :=
    (by gcongr : 4 * (n : ℝ) * g * (queryCap n D : ℝ)
      ≤ 4 * (n : ℝ) * g * ((n : ℝ) ^ 2 / Real.sqrt D)).trans hsq
  have hc1 : 4 * (n : ℝ) * g * 1 ≤ 8 * X :=
    calc 4 * (n : ℝ) * g * 1 ≤ 4 * (n : ℝ) * (2 * n * E) := by rw [mul_one]; gcongr
      _ = 8 * ((n : ℝ) ^ 2 * E) := by ring
      _ ≤ 8 * S := by
          rw [hS]; gcongr; all_goals first | exact hn1 | norm_num
      _ ≤ 8 * X := by gcongr
  have hcall : 4 * (n : ℝ) * g * t ≤ C * (104 * X) :=
    calc 4 * (n : ℝ) * g * t
        ≤ 4 * (n : ℝ) * g * (C * ((n : ℝ) ^ 2 * Real.log Dm ^ 2 / (Dm : ℝ) ^ (0.07618 : ℝ)
          + (queryCap n D : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) * Real.log Dm + (n : ℝ) * Dm
          + queryCap n D + 1)) := by gcongr
      _ = C * (4 * (n : ℝ) * g * ((n : ℝ) ^ 2 * Real.log Dm ^ 2 / (Dm : ℝ) ^ (0.07618 : ℝ))
          + 4 * (n : ℝ) * g * ((queryCap n D : ℝ) * (Dm : ℝ) ^ (0.44274 : ℝ) * Real.log Dm)
          + 4 * (n : ℝ) * g * ((n : ℝ) * Dm) + 4 * (n : ℝ) * g * (queryCap n D : ℝ)
          + 4 * (n : ℝ) * g * 1) := by ring
      _ ≤ C * (104 * X) := by gcongr; linarith
  -- The additional time of Theorem 17.
  have hscans : termScans n g κ ≤ X :=
    calc termScans n g κ = κ * ((n : ℝ) ^ 3 * L) * (1 / (g : ℝ)) := by
          unfold termScans; rw [hL]; ring
      _ ≤ κ * ((n : ℝ) ^ 3 * L) * E := by
          gcongr
          rw [hE, Real.rpow_neg hD0.le, ← one_div]
          exact one_div_le_one_div_of_le (Real.rpow_pos_of_pos hD0 _) hg1
      _ = κ * (S * L) := by rw [hS]; ring
      _ ≤ X := hκSLX
  have hprime : termPrime strassen n D ≤ X := by
    have hDn' : (D : ℝ) ^ (2 : ℝ) ≤ (n : ℝ) ^ (2 / 17 : ℝ) := by
      have h17 : (D : ℝ) ^ (17 : ℝ) ≤ n := by
        rw [show (17 : ℝ) = ((17 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
        exact_mod_cast hD17
      calc (D : ℝ) ^ (2 : ℝ) = ((D : ℝ) ^ (17 : ℝ)) ^ (2 / 17 : ℝ) := by
            rw [← Real.rpow_mul hD0.le]; norm_num
        _ ≤ (n : ℝ) ^ (2 / 17 : ℝ) := Real.rpow_le_rpow (by positivity) h17 (by norm_num)
    calc termPrime strassen n D = (n : ℝ) ^ Real.logb 2 7 * (D : ℝ) ^ (3 / 2 : ℝ) := rfl
      _ ≤ (n : ℝ) ^ Real.logb 2 7 * (D : ℝ) ^ (-(11 / 300 : ℝ) + 2) := by
          exact mul_le_mul_of_nonneg_left (hpow _ _ (by norm_num)) (by positivity)
      _ = E * ((n : ℝ) ^ Real.logb 2 7 * (D : ℝ) ^ (2 : ℝ)) := by
          rw [Real.rpow_add hD0, hE]; ring
      _ ≤ E * ((n : ℝ) ^ Real.logb 2 7 * (n : ℝ) ^ (2 / 17 : ℝ)) := by gcongr
      _ = E * (n : ℝ) ^ (Real.logb 2 7 + 2 / 17) := by rw [Real.rpow_add hn0]
      _ ≤ E * (n : ℝ) ^ (3 : ℝ) := by
          exact mul_le_mul_of_nonneg_left
            (Real.rpow_le_rpow_of_exponent_le hn1 (by linarith [Real.logb_two_seven_lt])) hE0.le
      _ = S := by rw [hS, Real.rpow_ofNat]; ring
      _ ≤ X := hSX
  have hbuild : termBuild n D g ≤ 2 * X :=
    calc termBuild n D g = (n : ℝ) ^ 2 * ((g : ℝ) * D) := by unfold termBuild; ring
      _ ≤ (n : ℝ) ^ 2 * (2 * n * E) := by gcongr
      _ = 2 * S := by rw [hS]; ring
      _ ≤ 2 * X := by gcongr
  have hread : 4 * (n : ℝ) * g * (C' * ((n : ℝ) ^ 2 / Real.sqrt D)) ≤ C' * (8 * X) :=
    calc 4 * (n : ℝ) * g * (C' * ((n : ℝ) ^ 2 / Real.sqrt D))
        = C' * (4 * (n : ℝ) * g * ((n : ℝ) ^ 2 / Real.sqrt D)) := by ring
      _ ≤ C' * (8 * X) := by gcongr
  have hextra : C' * (termScans n g κ + termPrime strassen n D + termBuild n D g)
      ≤ C' * (4 * X) := by
    gcongr
    linarith
  calc 4 * (n : ℝ) * g * (t + C' * ((n : ℝ) ^ 2 / Real.sqrt D))
        + C' * (termScans n g κ + termPrime strassen n D + termBuild n D g)
      = 4 * (n : ℝ) * g * t + 4 * (n : ℝ) * g * (C' * ((n : ℝ) ^ 2 / Real.sqrt D))
        + C' * (termScans n g κ + termPrime strassen n D + termBuild n D g) := by ring
    _ ≤ C * (104 * X) + C' * (8 * X) + C' * (4 * X) := by linarith
    _ = (104 * C + 12 * C') * X := by ring

/-- The sizes from which on the computation works: `n^{13/228} ≥ 17`, so that `D ≥ 16`, and
`n^{113/68400} ≥ 2^91`, so that the middle dimension is at most `n^{5/91}`. -/
theorem eventually_large : ∀ᶠ n : ℕ in Filter.atTop,
    (17 : ℝ) ≤ (n : ℝ) ^ (13 / 228 : ℝ) ∧ (2 : ℝ) ^ 91 ≤ (n : ℝ) ^ (113 / 68400 : ℝ) := by
  have h := fun (a : ℝ) (ha : 0 < a) =>
    (tendsto_rpow_atTop ha).comp (tendsto_natCast_atTop_atTop (R := ℝ))
  filter_upwards [(h (13 / 228) (by norm_num)).eventually_ge_atTop 17,
    (h (113 / 68400) (by norm_num)).eventually_ge_atTop ((2 : ℝ) ^ 91)] with n h1 h2
  exact ⟨h1, h2⟩

end Theorem19Mid

open Theorem19Mid in
/-- **Theorem 19 with the true middle dimension**: from Theorem 17 with `D = ⌊n^{13/228}⌋` and
`g = ⌈D^{11/300}⌉` and from `Claim.LopDetectP`, Exact Triangle in time
`O(κ n^{3−143/68400} log² n)` from some size on.  `143/68400 = (11/300)(13/228)`. -/
theorem theorem19_mid (M : DetTimeModel)
    (h17 : Claim.Theorem_17_mid M strassen (fun n => paramDr 13 228 n)
      (fun n => paramGr 11 300 (paramDr 13 228 n)))
    (hlop : Claim.LopDetectP M) : ∃ n₀, Claim.Theorem_19_explicitAt M (143 / 68400) 2 n₀ := by
  obtain ⟨C', hC', h17⟩ := h17
  obtain ⟨C, Td, hC, hTd, hlop⟩ := hlop
  obtain ⟨T, hT, h17⟩ := h17 Td hTd
  obtain ⟨n₀, hn₀⟩ := Filter.eventually_atTop.1 eventually_large
  refine ⟨n₀, 2 * (104 * C + 12 * C'), T, hT, fun n κ u hn hκ hu => ?_⟩
  obtain ⟨hbig, h91⟩ := hn₀ n hn
  have hn0 : (0 : ℝ) < n := by
    rcases Nat.eq_zero_or_pos n with h | h
    · subst h
      rw [Nat.cast_zero, Real.zero_rpow (by norm_num)] at hbig
      norm_num at hbig
    · exact_mod_cast h
  -- Step 1: the parameters.
  set D := paramDr 13 228 n with hDdef
  set g := paramGr 11 300 D with hgdef
  have hDlt : (n : ℝ) ^ (13 / 228 : ℝ) < D + 1 := by
    simpa only [Nat.cast_ofNat] using rpow_lt_paramDr_add_one (a := 13) (b := 228) (by norm_num) n
  have hDle : (D : ℝ) ≤ (n : ℝ) ^ (13 / 228 : ℝ) := by
    simpa only [Nat.cast_ofNat] using paramDr_le_rpow (a := 13) (b := 228) (by norm_num) n
  have hD16 : 16 ≤ D := by
    have : (16 : ℝ) ≤ D := by linarith
    exact_mod_cast this
  have hD1 : 1 ≤ D := by omega
  have hD1r : (1 : ℝ) ≤ D := by exact_mod_cast hD1
  have hD0 : (0 : ℝ) < D := zero_lt_one.trans_le hD1r
  have hD17 : D ^ 17 ≤ n := by
    have h228 : D ^ 228 ≤ n ^ 13 := Spec.rootFloor_pow_le (by norm_num) _
    have h : (D ^ 17) ^ 13 ≤ n ^ 13 := by
      rw [← pow_mul]
      exact (Nat.pow_le_pow_right hD1 (by norm_num)).trans h228
    exact (Nat.pow_le_pow_iff_left (by norm_num)).1 h
  have hDn : D ≤ n := (Nat.le_self_pow (by norm_num) D).trans hD17
  have hg1 : (D : ℝ) ^ (11 / 300 : ℝ) ≤ g := by
    simpa only [Nat.cast_ofNat] using rpow_le_paramGr (c := 11) (e := 300) (by norm_num) hD1
  have hgpow1 : (1 : ℝ) ≤ (D : ℝ) ^ (11 / 300 : ℝ) := Real.one_le_rpow hD1r (by norm_num)
  have hg2 : (g : ℝ) ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ) := by
    have h := paramGr_lt_rpow_add_one (c := 11) (e := 300) (by norm_num) hD1
    simp only [Nat.cast_ofNat] at h
    linarith
  have hgpos : 1 ≤ g := one_le_paramGr 11 300 D
  have hg0 : (0 : ℝ) < g := by exact_mod_cast hgpos
  have hgsqrt : (g : ℝ) ≤ Real.sqrt D := by
    have htwo : (2 : ℝ) ≤ (D : ℝ) ^ (1 / 4 : ℝ) :=
      calc (2 : ℝ) = (16 : ℝ) ^ (1 / 4 : ℝ) := by
            rw [show (16 : ℝ) = 2 ^ (4 : ℝ) by norm_num, ← Real.rpow_mul (by norm_num)]
            norm_num
        _ ≤ (D : ℝ) ^ (1 / 4 : ℝ) :=
            Real.rpow_le_rpow (by norm_num) (by exact_mod_cast hD16) (by norm_num)
    calc (g : ℝ) ≤ 2 * (D : ℝ) ^ (11 / 300 : ℝ) := hg2
      _ ≤ (D : ℝ) ^ (1 / 4 : ℝ) * (D : ℝ) ^ (1 / 4 : ℝ) :=
          mul_le_mul htwo (Real.rpow_le_rpow_of_exponent_le hD1r (by norm_num)) (by positivity)
            (by positivity)
      _ = Real.sqrt D := by
          rw [Real.sqrt_eq_rpow, ← Real.rpow_add hD0]
          norm_num
  -- The middle dimension `Dm` is between `D^{289/300}/8` and `2 D^{289/300}`.
  have hDmD : midDim D g ≤ D := Light.Sec3.midDim_le hgpos
  have hs4 : 4 ≤ Nat.sqrt D := Nat.le_sqrt'.2 (by omega)
  have hq1 : 1 ≤ Spec.pieceSizeNat D g := (Nat.lt_ceilDiv_iff hgpos).2 (by omega)
  have hDm4 : 4 ≤ midDim D g := by
    unfold midDim
    nlinarith
  have hsplit : (D : ℝ) = (D : ℝ) ^ (11 / 300 : ℝ) * (D : ℝ) ^ (289 / 300 : ℝ) := by
    rw [← Real.rpow_add hD0]
    norm_num
  have hDm_le : (midDim D g : ℝ) ≤ 2 * (D : ℝ) ^ (289 / 300 : ℝ) := by
    have hq := pieceSize_le_two_mul_sqrt_div hgpos hgsqrt
    have hcast : (midDim D g : ℝ) = (pieceSize D g : ℝ) * (Nat.sqrt D : ℝ) := by
      rw [midDim, Spec.pieceSizeNat_eq D hgpos]
      push_cast
      ring
    have hs : (Nat.sqrt D : ℝ) ≤ Real.sqrt D := Real.nat_sqrt_le_real_sqrt
    rw [hcast]
    calc (pieceSize D g : ℝ) * (Nat.sqrt D : ℝ) ≤ 2 * Real.sqrt D / g * Real.sqrt D := by
          gcongr
      _ = 2 * (D : ℝ) / g := by
          rw [show 2 * Real.sqrt D / g * Real.sqrt D = 2 * (Real.sqrt D * Real.sqrt D) / g by ring,
            Real.mul_self_sqrt hD0.le]
      _ ≤ 2 * (D : ℝ) / (D : ℝ) ^ (11 / 300 : ℝ) := by
          gcongr
      _ = 2 * (D : ℝ) ^ (289 / 300 : ℝ) := by
          have hpos : 0 < (D : ℝ) ^ (11 / 300 : ℝ) := Real.rpow_pos_of_pos hD0 _
          have hdiv : (D : ℝ) / (D : ℝ) ^ (11 / 300 : ℝ) = (D : ℝ) ^ (289 / 300 : ℝ) := by
            rw [div_eq_iff hpos.ne', mul_comm]
            exact hsplit
          rw [mul_div_assoc, hdiv]
  have hDm_ge : (D : ℝ) ^ (289 / 300 : ℝ) ≤ 8 * midDim D g := by
    have hsq : Nat.sqrt D ≤ Spec.pieceSizeNat D g * g := (Nat.ceilDiv_le_iff hgpos).1 le_rfl
    have hlt := Nat.lt_succ_sqrt' D
    have hnat : D ≤ 4 * (midDim D g * g) := by
      unfold midDim
      rw [Nat.succ_eq_add_one] at hlt
      nlinarith
    have hreal : (D : ℝ) ≤ 4 * ((midDim D g : ℝ) * g) := by exact_mod_cast hnat
    have hpos : 0 < (D : ℝ) ^ (11 / 300 : ℝ) := Real.rpow_pos_of_pos hD0 _
    have h' : (D : ℝ) ^ (11 / 300 : ℝ) * (D : ℝ) ^ (289 / 300 : ℝ)
        ≤ (D : ℝ) ^ (11 / 300 : ℝ) * (8 * midDim D g) := by
      rw [← hsplit]
      calc (D : ℝ) ≤ 4 * ((midDim D g : ℝ) * g) := hreal
        _ ≤ 4 * ((midDim D g : ℝ) * (2 * (D : ℝ) ^ (11 / 300 : ℝ))) := by gcongr
        _ = (D : ℝ) ^ (11 / 300 : ℝ) * (8 * midDim D g) := by ring
    exact le_of_mul_le_mul_left h' hpos
  -- The regime of `Claim.LopDetectP`: `Dm^91 ≤ n^5`.
  have hreg : midDim D g ^ 91 ≤ n ^ 5 := by
    have hDe : (D : ℝ) ^ (289 / 300 * 91 : ℝ) ≤ (n : ℝ) ^ (13 / 228 * (289 / 300 * 91) : ℝ) := by
      rw [Real.rpow_mul hn0.le]
      exact Real.rpow_le_rpow hD0.le hDle (by norm_num)
    have h : ((midDim D g : ℝ)) ^ 91 ≤ (n : ℝ) ^ 5 :=
      calc ((midDim D g : ℝ)) ^ 91 ≤ (2 * (D : ℝ) ^ (289 / 300 : ℝ)) ^ 91 := by gcongr
        _ = (2 : ℝ) ^ 91 * (D : ℝ) ^ (289 / 300 * 91 : ℝ) := by
            rw [mul_pow, ← Real.rpow_natCast ((D : ℝ) ^ (289 / 300 : ℝ)) 91, ← Real.rpow_mul hD0.le]
            norm_num
        _ ≤ (n : ℝ) ^ (113 / 68400 : ℝ) * (n : ℝ) ^ (13 / 228 * (289 / 300 * 91) : ℝ) := by
            gcongr
        _ = (n : ℝ) ^ ((5 : ℕ) : ℝ) := by
            rw [← Real.rpow_add hn0]
            norm_num
        _ = (n : ℝ) ^ 5 := Real.rpow_natCast _ _
    exact_mod_cast h
  -- Step 2: Theorem 17 and one call.
  have ht := hlop n (midDim D g) (queryCap n D) (by omega) hreg
  have hT' := h17 n κ u hD16 hDn hgpos hgsqrt hκ hu
  -- Step 3: the costs added up.
  have htot := total_le hκ hC hC' hD16 hD17 (by omega) hDmD hg1 hg2 hDm_le hDm_ge ht
  -- `D ≥ n^{13/228}/2` gives `D^{-11/300} ≤ 2 n^{-143/68400}`.
  have hsave : (D : ℝ) ^ (-(11 / 300 : ℝ)) ≤ 2 * (n : ℝ) ^ (-(143 / 68400 : ℝ)) := by
    have hroot : 0 < (n : ℝ) ^ (13 / 228 : ℝ) := Real.rpow_pos_of_pos hn0 _
    have hlow : (n : ℝ) ^ (13 / 228 : ℝ) / 2 ≤ D := by linarith
    calc (D : ℝ) ^ (-(11 / 300 : ℝ)) ≤ ((n : ℝ) ^ (13 / 228 : ℝ) / 2) ^ (-(11 / 300 : ℝ)) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) hlow (by norm_num)
      _ = ((n : ℝ) ^ (13 / 228 : ℝ)) ^ (-(11 / 300 : ℝ)) / (2 : ℝ) ^ (-(11 / 300 : ℝ)) :=
          Real.div_rpow hroot.le (by norm_num) _
      _ = (2 : ℝ) ^ (11 / 300 : ℝ) * (n : ℝ) ^ (-(143 / 68400 : ℝ)) := by
          rw [← Real.rpow_mul hn0.le, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), div_inv_eq_mul,
            mul_comm]
          norm_num
      _ ≤ (2 : ℝ) ^ (1 : ℝ) * (n : ℝ) ^ (-(143 / 68400 : ℝ)) := by
          gcongr <;> norm_num
      _ = 2 * (n : ℝ) ^ (-(143 / 68400 : ℝ)) := by rw [Real.rpow_one]
  have hcube : (n : ℝ) ^ 3 * (n : ℝ) ^ (-(143 / 68400 : ℝ)) = (n : ℝ) ^ (3 - 143 / 68400 : ℝ) := by
    rw [sub_eq_add_neg, Real.rpow_add hn0, Real.rpow_ofNat]
  calc T n u ≤ _ := hT'
    _ ≤ (104 * C + 12 * C') *
          (κ * ((n : ℝ) ^ 3 * (D : ℝ) ^ (-(11 / 300 : ℝ)) * Real.log n ^ 2)) := htot
    _ ≤ (104 * C + 12 * C') *
          (κ * ((n : ℝ) ^ 3 * (2 * (n : ℝ) ^ (-(143 / 68400 : ℝ))) * Real.log n ^ 2)) := by
        gcongr
    _ = 2 * (104 * C + 12 * C') * (κ * ((n : ℝ) ^ (3 - 143 / 68400 : ℝ) * Real.log n ^ 2)) := by
        rw [← hcube]
        ring

end ThreeSumApsp

