theorem leafOp_eq (u : ℕ) : leafOp u = Butterfly.tens Cm := by
  rw [leafOp, tens_eq_prod_kerAt Butterfly.Cm (List.finRange u) (List.nodup_finRange u)
    (List.mem_finRange), List.map_map]; rfl

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

/-- **Correctness of the recursion**: the depth-`k` program computes `C^{⊗}` on its
`u m^k` selected bits. -/
theorem recOp_eq : ∀ k, recOp I u k = Butterfly.tens Butterfly.Cm
  | 0 => leafOp_eq u
  | k + 1 => by
    rw [recOp, recOp_eq k, I.correct (Lvl u m k)]
    exact roleBlock_roleDiag (W := W) (Butterfly.tens Butterfly.Cm : Op (Fin m × Lvl u m k)) 0

