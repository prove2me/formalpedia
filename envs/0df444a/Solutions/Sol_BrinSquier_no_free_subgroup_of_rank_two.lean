/-- The derived subgroup of a free group of rank two is not abelian.
Witnesses: the commutators `⁅a,b⁆` and `⁅a,b²⁆`, separated in `S₄`. -/
theorem free2_commutator_not_comm :
    ¬ ∀ u ∈ commutator (FreeGroup (Fin 2)), ∀ v ∈ commutator (FreeGroup (Fin 2)),
        u * v = v * u := by
  intro hcomm
  have hu : ⁅FreeGroup.of (0 : Fin 2), FreeGroup.of (1 : Fin 2)⁆
      ∈ commutator (FreeGroup (Fin 2)) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  have hv : ⁅FreeGroup.of (0 : Fin 2), FreeGroup.of (1 : Fin 2) ^ 2⁆
      ∈ commutator (FreeGroup (Fin 2)) :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  have key := hcomm _ hu _ hv
  set x : Equiv.Perm (Fin 4) := Equiv.swap 2 3 with hx
  set y : Equiv.Perm (Fin 4) := Equiv.swap 0 1 * Equiv.swap 1 2 with hy
  set φ : FreeGroup (Fin 2) →* Equiv.Perm (Fin 4) :=
    FreeGroup.lift (fun i : Fin 2 => if i = 0 then x else y) with hφ
  have h1 : φ (FreeGroup.of (0 : Fin 2)) = x := by simp [hφ]
  have h2 : φ (FreeGroup.of (1 : Fin 2)) = y := by simp [hφ]
  have hbad := congrArg φ key
  simp only [commutatorElement_def, map_mul, map_inv, map_pow, h1, h2] at hbad
  rw [hx, hy] at hbad
  revert hbad
  decide

/-- A cyclic group has no injective `ℤ²`. -/
lemma no_zsq_of_isCyclic {K : Type*} [Group K] [IsCyclic K] (u v : K)
    (hinj : Function.Injective (fun p : ℤ × ℤ => u ^ p.1 * v ^ p.2)) : False := by
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := K)
  obtain ⟨i, hi⟩ := Subgroup.mem_zpowers_iff.mp (hg u)
  obtain ⟨j, hj⟩ := Subgroup.mem_zpowers_iff.mp (hg v)
  have e1 : u ^ j * v ^ (-i) = 1 := by
    rw [← hi, ← hj, ← zpow_mul, ← zpow_mul, ← zpow_add,
      show i * j + j * (-i) = 0 by ring, zpow_zero]
  have e2 : ((j, -i) : ℤ × ℤ) = (0, 0) := hinj (by simpa using e1)
  have hj0 : j = 0 := congrArg Prod.fst e2
  have hi0 : i = 0 := by
    have := congrArg Prod.snd e2; simpa using neg_eq_zero.mp this
  have hu1 : u = 1 := by rw [← hi, hi0, zpow_zero]
  have hv1 : v = 1 := by rw [← hj, hj0, zpow_zero]
  have : ((1, 0) : ℤ × ℤ) = (0, 0) := hinj (by simp [hu1, hv1])
  simpa using congrArg Prod.fst this

/-- The subgroup generated by a commuting pair is abelian. -/
lemma closure_pair_comm {K : Type*} [Group K] {u v : K} (h : u * v = v * u) :
    ∀ x ∈ Subgroup.closure ({u, v} : Set K), ∀ y ∈ Subgroup.closure ({u, v} : Set K),
      x * y = y * x := by
  have step1 : Subgroup.closure ({u, v} : Set K) ≤ Subgroup.centralizer ({u, v} : Set K) := by
    rw [Subgroup.closure_le]
    intro z hz
    simp only [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro w hw
    rcases hz with rfl | rfl <;> rcases hw with rfl | rfl
    · rfl
    · exact h.symm
    · exact h
    · rfl
  have step2 : Subgroup.closure ({u, v} : Set K)
      ≤ Subgroup.centralizer (Subgroup.closure ({u, v} : Set K) : Set K) := by
    rw [Subgroup.closure_le]
    intro z hz
    simp only [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
    intro w hw
    have := step1 hw
    rw [Subgroup.mem_centralizer_iff] at this
    exact (this z hz).symm
  intro x hx y hy
  have := step2 hx
  rw [Subgroup.mem_centralizer_iff] at this
  exact (this y hy).symm

theorem slopeAtBot_one_mul {f g : ℝ ≃o ℝ} (hf : SlopeAtBot f 1) (hg : SlopeAtBot g 1) :
    SlopeAtBot (f * g) 1 := by
  obtain ⟨b1, M1, h1⟩ := hf
  obtain ⟨b2, M2, h2⟩ := hg
  refine ⟨b1 + b2, min M2 (M1 - b2), fun y hy => ?_⟩
  have hy2 : y < M2 := lt_of_lt_of_le hy (min_le_left _ _)
  have hy1 : y + b2 < M1 := by have := lt_of_lt_of_le hy (min_le_right _ _); linarith
  show f (g y) = 1 * y + (b1 + b2)
  rw [h2 y hy2]
  have : (1:ℝ) * y + b2 = y + b2 := by ring
  rw [this, h1 (y + b2) hy1]; ring

theorem slopeAtTop_one_mul {f g : ℝ ≃o ℝ} (hf : SlopeAtTop f 1) (hg : SlopeAtTop g 1) :
    SlopeAtTop (f * g) 1 := by
  obtain ⟨b1, M1, h1⟩ := hf
  obtain ⟨b2, M2, h2⟩ := hg
  refine ⟨b1 + b2, max M2 (M1 - b2), fun y hy => ?_⟩
  have hy2 : y > M2 := lt_of_le_of_lt (le_max_left _ _) hy
  have hy1 : y + b2 > M1 := by have := lt_of_le_of_lt (le_max_right _ _) hy; linarith
  show f (g y) = 1 * y + (b1 + b2)
  rw [h2 y hy2]
  have : (1:ℝ) * y + b2 = y + b2 := by ring
  rw [this, h1 (y + b2) hy1]; ring

theorem slopeAtBot_one_inv {f : ℝ ≃o ℝ} (hf : SlopeAtBot f 1) : SlopeAtBot f⁻¹ 1 := by
  obtain ⟨b, M, h⟩ := hf
  refine ⟨-b, M + b, fun w hw => ?_⟩
  have hy : w - b < M := by linarith
  have hfy : f (w - b) = w := by rw [h (w - b) hy]; ring
  show f⁻¹ w = 1 * w + -b
  have : f (f⁻¹ w) = f (w - b) := by rw [RelIso.apply_inv_self, hfy]
  have := f.injective this
  rw [this]; ring

theorem slopeAtTop_one_inv {f : ℝ ≃o ℝ} (hf : SlopeAtTop f 1) : SlopeAtTop f⁻¹ 1 := by
  obtain ⟨b, M, h⟩ := hf
  refine ⟨-b, M + b, fun w hw => ?_⟩
  have hy : w - b > M := by linarith
  have hfy : f (w - b) = w := by rw [h (w - b) hy]; ring
  show f⁻¹ w = 1 * w + -b
  have : f (f⁻¹ w) = f (w - b) := by rw [RelIso.apply_inv_self, hfy]
  have := f.injective this
  rw [this]; ring

lemma isPLF_one : IsPLF (1 : ℝ ≃o ℝ) := ⟨∅, fun x _ => ⟨1, one_pos, 1, 0, fun y _ => by simp⟩⟩

lemma isPLFSlopeOne_one : IsPLFSlopeOne (1 : ℝ ≃o ℝ) :=
  ⟨isPLF_one, ⟨0, 0, fun y _ => by simp⟩, ⟨0, 0, fun y _ => by simp⟩⟩

/-- The slope-one piecewise-linear maps form a subgroup. -/
def PLFSO : Subgroup (ℝ ≃o ℝ) where
  carrier := {h | IsPLFSlopeOne h}
  one_mem' := isPLFSlopeOne_one
  mul_mem' := by
    rintro a b ⟨ha, hab, hat⟩ ⟨hb, hbb, hbt⟩
    exact ⟨isPLF_mul ha hb, slopeAtBot_one_mul hab hbb, slopeAtTop_one_mul hat hbt⟩
  inv_mem' := by
    rintro a ⟨ha, hab, hat⟩
    exact ⟨isPLF_inv ha, slopeAtBot_one_inv hab, slopeAtTop_one_inv hat⟩

end BS_goal

open BS_goal in
theorem solution (f g : ℝ ≃o ℝ) (hf : IsPLF f) (hg : IsPLF g) :
    ¬ Function.Injective (FreeGroup.lift ![f, g]) := by
  intro hinj
  set L : FreeGroup (Fin 2) →* (ℝ ≃o ℝ) := FreeGroup.lift ![f, g] with hL
  -- every element of the range is piecewise linear
  have hPLF : ∀ w : FreeGroup (Fin 2), IsPLF (L w) := by
    intro w
    induction w with
    | C1 => simpa using isPLF_one
    | of i => fin_cases i <;> simp [hL] <;> assumption
    | inv_of i ih => rw [map_inv]; exact isPLF_inv ih
    | mul x y hx hy => rw [map_mul]; exact isPLF_mul hx hy
  -- the image of the derived subgroup lands in PLFSO
  set G : Subgroup (ℝ ≃o ℝ) := Subgroup.map L (commutator (FreeGroup (Fin 2))) with hGdef
  have hG : ∀ h ∈ G, IsPLFSlopeOne h := by
    have hle : commutator (FreeGroup (Fin 2)) ≤ Subgroup.comap L PLFSO := by
      rw [show commutator (FreeGroup (Fin 2)) = ⁅(⊤ : Subgroup (FreeGroup (Fin 2))), ⊤⁆ from rfl,
        Subgroup.commutator_le]
      intro p _ q _
      simp only [Subgroup.mem_comap, commutatorElement_def, map_mul, map_inv]
      refine ⟨?_, (slope_one_commutator (hPLF p) (hPLF q)).1,
        (slope_one_commutator (hPLF p) (hPLF q)).2⟩
      exact isPLF_mul (isPLF_mul (isPLF_mul (hPLF p) (hPLF q)) (isPLF_inv (hPLF p)))
        (isPLF_inv (hPLF q))
    intro h hh
    obtain ⟨w, hw, rfl⟩ := hh
    exact hle hw
  -- the image of the derived subgroup is not abelian
  have hne : ¬ ∀ a ∈ G, ∀ b ∈ G, a * b = b * a := by
    intro habel
    refine free2_commutator_not_comm (fun u hu v hv => hinj ?_)
    have := habel (L u) ⟨u, hu, rfl⟩ (L v) ⟨v, hv, rfl⟩
    rw [map_mul, map_mul]
    exact this
  -- apply the dichotomy (3.2)
  obtain ⟨u', hu', v', hv', hcomm', hinj'⟩ := BrinSquier.zsq_of_not_abelian G hG hne
  obtain ⟨U, hU, hLU⟩ := hu'
  obtain ⟨V, hV, hLV⟩ := hv'
  -- pull the copy of ℤ² back into the free group
  have hUV : U * V = V * U := by
    apply hinj; rw [map_mul, map_mul, hLU, hLV]; exact hcomm'
  have hinjUV : Function.Injective (fun p : ℤ × ℤ => U ^ p.1 * V ^ p.2) := by
    intro p q hpq
    refine hinj' ?_
    have := congrArg L hpq
    simpa [map_mul, map_zpow, hLU, hLV] using this
  -- that copy sits in an abelian subgroup of a free group, hence in a cyclic one
  set H : Subgroup (FreeGroup (Fin 2)) := Subgroup.closure ({U, V} : Set (FreeGroup (Fin 2)))
    with hHdef
  have hUmem : U ∈ H := Subgroup.subset_closure (by simp)
  have hVmem : V ∈ H := Subgroup.subset_closure (by simp)
  have hHab : ∀ a ∈ H, ∀ b ∈ H, a * b = b * a := closure_pair_comm hUV
  have : IsCyclic H := BrinSquier.abelian_subgroup_of_free_isCyclic H hHab
  refine no_zsq_of_isCyclic (⟨U, hUmem⟩ : H) (⟨V, hVmem⟩ : H) ?_
  intro p q hpq
  refine hinjUV ?_
  have := congrArg (Subtype.val) hpq
  simpa using this
