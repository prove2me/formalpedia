theorem geom_sum_first_difference_identity
    (a : ℕ → ℂ) (z : ℂ) (N : ℕ) :
    (1 - z) * (∑ n ∈ Finset.range (N + 1), a n * z ^ n) =
      a 0 +
        (∑ j ∈ Finset.range N, (a (j + 1) - a j) * z ^ (j + 1)) -
        a N * z ^ (N + 1) := by
  induction N with
  | zero => simp; ring
  | succ N ih =>
      rw [Finset.sum_range_succ (f := fun n => a n * z ^ n) (n := N + 1)]
      rw [Finset.sum_range_succ
        (f := fun j => (a (j + 1) - a j) * z ^ (j + 1)) (n := N)]
      rw [mul_add, ih]
      rw [pow_succ]
      ring
theorem norm_geom_sum_le_first_boundary_variation
    (a : ℕ → ℂ) (z : ℂ) (N : ℕ) (hz : ‖z‖ = 1) :
    ‖1 - z‖ * ‖∑ n ∈ Finset.range (N + 1), a n * z ^ n‖ ≤
      ‖a 0‖ + (∑ j ∈ Finset.range N, ‖a (j + 1) - a j‖) + ‖a N‖ := by
  have hprod :
      ‖1 - z‖ * ‖∑ n ∈ Finset.range (N + 1), a n * z ^ n‖ =
        ‖(1 - z) * (∑ n ∈ Finset.range (N + 1), a n * z ^ n)‖ := by
    rw [norm_mul]
  rw [hprod, geom_sum_first_difference_identity]
  calc
    ‖a 0 + (∑ j ∈ Finset.range N, (a (j + 1) - a j) * z ^ (j + 1)) -
        a N * z ^ (N + 1)‖
        ≤ ‖a 0 + (∑ j ∈ Finset.range N,
              (a (j + 1) - a j) * z ^ (j + 1))‖ +
            ‖a N * z ^ (N + 1)‖ := norm_sub_le _ _
    _ ≤ (‖a 0‖ + ‖∑ j ∈ Finset.range N,
              (a (j + 1) - a j) * z ^ (j + 1)‖) +
            ‖a N * z ^ (N + 1)‖ :=
          add_le_add (norm_add_le _ _) le_rfl
    _ ≤ (‖a 0‖ + ∑ j ∈ Finset.range N,
              ‖(a (j + 1) - a j) * z ^ (j + 1)‖) +
            ‖a N * z ^ (N + 1)‖ := by
          gcongr
          exact norm_sum_le _ _
    _ = ‖a 0‖ + (∑ j ∈ Finset.range N, ‖a (j + 1) - a j‖) + ‖a N‖ := by
          simp [norm_mul, norm_pow, hz]
theorem norm_geom_sum_le_first_boundary_variation_div
    (a : ℕ → ℂ) (z : ℂ) (N : ℕ) (hz : ‖z‖ = 1) (hz1 : z ≠ 1) :
    ‖∑ n ∈ Finset.range (N + 1), a n * z ^ n‖ ≤
      (‖a 0‖ + (∑ j ∈ Finset.range N, ‖a (j + 1) - a j‖) + ‖a N‖) /
        ‖1 - z‖ := by
  have hpos : 0 < ‖1 - z‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hz1.symm)
  apply (le_div_iff₀ hpos).2
  simpa [mul_comm] using norm_geom_sum_le_first_boundary_variation a z N hz
