theorem toF_free (k : NLogN.KIL.KS) (j : Fin HS) (h1 : 14 < j.val) (h2 : j.val < 30 ∨ 33 < j.val) :
    toF k j = [] := by
  obtain ⟨v, hv⟩ := j
  simp only at h1 h2
  unfold toF
  split <;> simp_all

theorem encK_upd_free (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) (hf : f i = [])
    (L : List Item) : NLogN.KIL.encK (s.upd i L) f = (NLogN.KIL.encK s f).upd i L := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = i
  · subst h; simp [hf]
  · simp [h]

theorem eval_regF {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} (hf : f i = [])
    {a : ℤ} {L : List Item} (h : s.G i = .int a :: L) : (Ex.reg i).eval (NLogN.KIL.encK s f) = a :=
  IState.top_eq (L := L) (by simp [hf, h])

theorem ok_regF {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} (hf : f i = [])
    {a : ℤ} {L : List Item} (h : s.G i = .int a :: L) : (Ex.reg i).ok (NLogN.KIL.encK s f) :=
  IState.isInt_of (L := L) (a := a) (by simp [hf, h])

theorem bnd_regF {s : IState HS} {f : Fin HS → List ℤ} {i : Fin HS} (hf : f i = [])
    {a : ℤ} {L : List Item} (h : s.G i = .int a :: L) {B : ℕ} (ha : zsz a ≤ B) :
    (Ex.reg i).Bnd (NLogN.KIL.encK s f) B := by
  have e := eval_regF hf h; simp only [Ex.eval] at e
  simp only [Ex.Bnd]; rw [e]; exact ha

/-- A push of any expression on a general state. -/
theorem Sp.pushE (t : IState HS) {i : Fin HS} {e : Ex HS} {B : ℕ} (hi : i.val < 56)
    (hc : e.Clean) (hok : e.ok t) (hB : e.Bnd t B) :
    Sp (.push i e) t (t.upd i (.int (e.eval t) :: t.G i)) ((e.size + 1) * 10 ^ 7 * (B + 2) ^ 2) :=
  ⟨⟨hi, hc, hok⟩, rfl, pushCost_le e t B hB⟩

theorem RSim.sel {π : PMap} (r : Fin HS) {br br' : ℕ → RS} (h : ∀ v, RSim π (br v) (br' v)) :
    ∀ k m, RSim π (NLogN.KIL.sel r br k m) (NLogN.KIL.sel r br' k m)
  | _, 0 => .skip
  | k, 1 => h k
  | k, m + 2 => .ite (ESim.refl π _) (h k) (RSim.sel r h (k + 1) (m + 1))

theorem cntR_add (p : ℕ → Bool) (m : ℕ) :
    ∀ k, cntR p (m + k) = cntR p m + cntR (fun i => p (m + i)) k
  | 0 => by simp [cntR]
  | k + 1 => by
    have IH := cntR_add p m k
    unfold cntR at IH ⊢
    rw [← Nat.add_assoc, List.range_succ, List.range_succ, List.filter_append,
      List.filter_append, List.length_append, List.length_append, IH]
    by_cases h : p (m + k) <;> simp [h, List.filter_cons] <;> omega

theorem periodic_mul {p : ℕ → Bool} {c : ℕ} (hp : ∀ y, p (y + c) = p y) :
    ∀ a i, p (c * a + i) = p i
  | 0, i => by simp
  | a + 1, i => by
    rw [show c * (a + 1) + i = (c * a + i) + c by ring, hp, periodic_mul hp a i]

theorem cntR_periodic {p : ℕ → Bool} {c : ℕ} (hp : ∀ y, p (y + c) = p y) (r : ℕ) :
    ∀ a, cntR p (c * a + r) = a * cntR p c + cntR p r
  | 0 => by simp
  | a + 1 => by
    have e1 := cntR_add p (c * a) r
    have e2 := cntR_add p (c * a) c
    have h1 : (fun i => p (c * a + i)) = p := funext fun i => periodic_mul hp a i
    rw [h1] at e1 e2
    have IH := cntR_periodic hp r a
    rw [e1] at IH
    rw [show c * (a + 1) + r = c * a + c + r by ring, cntR_add p (c * a + c) r, e2]
    have h2 : (fun i => p (c * a + c + i)) = p := funext fun i => by
      rw [show c * a + c + i = c * (a + 1) + i by ring, periodic_mul hp]
    rw [h2]
    have : cntR p (c * a) = a * cntR p c := by omega
    rw [this]; ring

theorem cntR_congr {p p' : ℕ → Bool} {n : ℕ} (h : ∀ y < n, p y = p' y) : cntR p n = cntR p' n := by
  unfold cntR
  congr 1
  exact List.filter_congr (fun y hy => h y (List.mem_range.1 hy))

theorem sig_mod (Q c v : ℕ) : sig Q c v = sig (Q % c) c v := by
  simp only [sig, ZMod.natCast_mod]

theorem cntS_eq {Q c : ℕ} (hc : 0 < c) (j : ℕ) :
    cntS Q c j = Q / c * cSA (Q % c) c j + cSB (Q % c) c j := by
  have H := cntR_periodic (p := fun y => decide (sig Q c (y % c) ≤ j)) (c := c)
    (fun y => by simp) (Q % c) (Q / c)
  rw [Nat.div_add_mod] at H
  have e1 : cntS Q c j = cntR (fun y => decide (sig Q c (y % c) ≤ j)) Q := rfl
  rw [e1, H]
  unfold cSA cSB
  rw [cntR_congr (p' := fun v => decide (sig (Q % c) c v ≤ j)) (fun y hy => by
      simp only [Nat.mod_eq_of_lt hy, sig_mod Q c y]),
    cntR_congr (n := Q % c) (p' := fun v => decide (sig (Q % c) c v ≤ j)) (fun y hy => by
      simp only [Nat.mod_eq_of_lt (lt_trans hy (Nat.mod_lt Q hc)), sig_mod Q c y])]

theorem passS_eq_T (Q c B j : ℕ) :
    passS Q c B j = passST (Q % c) c j (.lit Q) (.lit B) (.lit ((cntS Q c j * B : ℕ) : ℤ)) := by
  unfold passS passST bodyS bodyST
  congr 4; congr 1
  funext v
  unfold brS brST
  rw [sig_mod Q c v]

theorem rsim_passST {π : PMap} (r c j : ℕ) {eQ eQ' eB eB' eC eC' : Ex HS} (hQ : ESim π eQ eQ')
    (hB : ESim π eB eB') (hC : ESim π eC eC') :
    RSim π (passST r c j eQ eB eC) (passST r c j eQ' eB' eC') := by
  unfold passST bodyST
  refine .seq (.push _ (.lit _)) (.seq (.rep _ hQ (.seq (RSim.sel _ (fun v => ?_) _ _)
    (.asg _ (ESim.refl _ _)))) (.seq (.pop _) (RSim.mvK _ _ _ hC)))
  unfold brST
  split_ifs
  · exact RSim.mvK _ _ _ hB
  · exact RSim.mvK _ _ _ hB
  · exact .skip

theorem passST_writes (r c j : ℕ) (eQ eB eC : Ex HS) (x : Fin HS)
    (hx : x ∉ ([0, 10, 11, 12, 13, 31, 33] : List (Fin HS))) : x ∉ (passST r c j eQ eB eC).writes := by
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
  simp only [passST, bodyST, RS.writes, NLogN.mvK, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, not_or]
  refine ⟨hx.2.2.2.2.1, ⟨hx.2.2.2.2.2.1, sel_not_writes _ _ (fun v => ?_) _ _, hx.2.2.2.2.1⟩,
    hx.2.2.2.2.1, hx.2.2.2.2.2.2, ⟨hx.2.1, hx.2.2.1⟩⟩
  unfold brST
  split_ifs <;> simp [RS.writes, NLogN.mvK] <;> tauto

end NLogN.KIL

