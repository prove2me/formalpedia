-- Source module: Solutions.J6SegAxis1
/-!
# B-line axis program (`AxisU6`), part 1: the pass contracts and the chain

The axis program of `AxisBody6` is a sequence of passes, each in the convention of `FineBody6`
(only stack `0`, the descriptor stack `dA` and, for the two-array steps, `rZ = 53` are nonempty):

    pass1 (slabSc) ; pass2 (chunk kernel) ; copy (Y → rZ) ; pass3 (gather) ; pass4 (J kernel) ;
    pass5 (scatter) ; pass6 (chunk kernel) ; swap (0 ↔ rZ) ; pass7 (slabOut)

* `PassOK Isym tbl st dA desc Pre g C`: `st` maps the array `L` on stack `0` to `g L`
  (precondition `Pre L`), reading `desc` on `dA`, cost `≤ C`.
* `Pass2OK Isym tbl st dA desc Pre g C`: the same for the pair (stack `0`, stack `rZ`):
  `(A, B) ↦ g A B`. The copy is `g A [] = (A, A)`, the swap `g A B = (B, A)`, the output pass
  `g Y Y₂ = (out, [])`.
* `axis_chain`: the nine steps compose (the copy of `Y` on `rZ` is carried through passes 3–6 in
  the base state).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

noncomputable section

namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

/-- Moving one stack into the base state. -/
theorem encK_rebase' (s : IState HS) (F : Fin HS → List ℤ) (C : Fin HS) :
    encK s F = encK (encK s (update (fun _ => []) C (F C))) (update F C []) := by
  refine encK_split s (fun j => ?_)
  by_cases h : j = C
  · subst h; simp
  · simp [h]

section chain
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {dA : Fin HS} {desc : List ℤ}

/-- A pass with a carried array on `sZ`. -/
theorem pass_carry {st : IStmt HS Pp} {Pre : List GI → Prop} {g : List GI → List GI} {C : ℝ}
    (h : PassOK Isym tbl st dA desc Pre g C) (hZ0 : sZ ≠ (0 : Fin HS)) (hZA : sZ ≠ dA)
    (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l : List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ dA → j ≠ sZ → F j = []) (hd : F dA = desc) (h0 : F 0 = gflat L ++ l)
    (hP : Pre L) :
    ∃ c : ℕ, IRuns Isym tbl st (encK s F) (encK s (update F 0 (gflat (g L) ++ l))) c ∧
      (c : ℝ) ≤ C := by
  set s' := encK s (update (fun _ => []) sZ (F sZ))
  obtain ⟨c, hc, hcC⟩ := h s' (update F sZ []) L l
    (fun j h1 h2 => by
      by_cases h3 : j = sZ
      · subst h3; simp
      · rw [update_of_ne h3]; exact hF j h1 h2 h3)
    (by rw [update_of_ne (Ne.symm hZA)]; exact hd)
    (by rw [update_of_ne (Ne.symm hZ0)]; exact h0) hP
  refine ⟨c, ?_, hcC⟩
  rw [encK_rebase' s F sZ, encK_rebase' s (update F 0 (gflat (g L) ++ l)) sZ,
    update_of_ne hZ0]
  convert hc using 2
  funext j
  by_cases h1 : j = sZ
  · subst h1; simp [update_of_ne hZ0]
  · by_cases h2 : j = 0
    · subst h2; simp [h1]
    · simp [update_of_ne h1, update_of_ne h2]

/-- **The chain.** -/
theorem axis_chain_sol_aux {st1 st2 stc st3 st4 st5 st6 sts st7 : IStmt HS Pp}
    {P1 P2 P3 P4 P5 P6 : List GI → Prop} {Pc Ps P7 : List GI → List GI → Prop}
    {g1 g2 g3 g4 g5 g6 : List GI → List GI} {g7 : List GI → List GI → List GI}
    {C1 C2 Cc C3 C4 C5 C6 Cs C7 : ℝ}
    (h1 : PassOK Isym tbl st1 dA desc P1 g1 C1) (h2 : PassOK Isym tbl st2 dA desc P2 g2 C2)
    (hc : Pass2OK Isym tbl stc dA desc Pc (fun A _ => (A, A)) Cc)
    (h3 : PassOK Isym tbl st3 dA desc P3 g3 C3) (h4 : PassOK Isym tbl st4 dA desc P4 g4 C4)
    (h5 : PassOK Isym tbl st5 dA desc P5 g5 C5) (h6 : PassOK Isym tbl st6 dA desc P6 g6 C6)
    (hs : Pass2OK Isym tbl sts dA desc Ps (fun A B => (B, A)) Cs)
    (h7 : Pass2OK Isym tbl st7 dA desc P7 (fun A B => (g7 A B, [])) C7)
    (hZ0 : sZ ≠ (0 : Fin HS)) (hZA : sZ ≠ dA) (hA0 : dA ≠ 0)
    (s : IState HS) (F : Fin HS → List ℤ) (L : List GI) (l : List ℤ)
    (hF : ∀ j, j ≠ 0 → j ≠ dA → F j = []) (hd : F dA = desc) (h0 : F 0 = gflat L ++ l)
    (hp1 : P1 L) (hp2 : P2 (g1 L)) (hpc : Pc (g2 (g1 L)) [])
    (hp3 : P3 (g2 (g1 L))) (hp4 : P4 (g3 (g2 (g1 L)))) (hp5 : P5 (g4 (g3 (g2 (g1 L)))))
    (hp6 : P6 (g5 (g4 (g3 (g2 (g1 L))))))
    (hps : Ps (g6 (g5 (g4 (g3 (g2 (g1 L)))))) (g2 (g1 L)))
    (hp7 : P7 (g2 (g1 L)) (g6 (g5 (g4 (g3 (g2 (g1 L))))))) :
    ∃ c : ℕ, IRuns Isym tbl (axProg st1 st2 stc st3 st4 st5 st6 sts st7) (encK s F)
      (encK s (update F 0
        (gflat (g7 (g2 (g1 L)) (g6 (g5 (g4 (g3 (g2 (g1 L))))))) ++ l))) c ∧
      (c : ℝ) ≤ C1 + C2 + Cc + C3 + C4 + C5 + C6 + Cs + C7 := by
  have hFZ : F sZ = [] := hF sZ hZ0 hZA
  set H : List ℤ → List ℤ → Fin HS → List ℤ := fun a b => update (update F 0 a) sZ b with hH
  have H0 : ∀ a b, H a b 0 = a := fun a b => by simp [hH, update_of_ne hZ0.symm]
  have HZ : ∀ a b, H a b sZ = b := fun a b => by simp [hH]
  have HA : ∀ a b, H a b dA = desc := fun a b => by
    simp [hH, update_of_ne hZA.symm, update_of_ne hA0, hd]
  have HE : ∀ a b j, j ≠ 0 → j ≠ dA → j ≠ sZ → H a b j = [] := fun a b j h1 h2 h3 => by
    simp [hH, update_of_ne h1, update_of_ne h3, hF j h1 h2]
  have HE' : ∀ a j, j ≠ 0 → j ≠ dA → H a [] j = [] := fun a j h1 h2 => by
    by_cases h3 : j = sZ
    · subst h3; exact HZ a []
    · exact HE a [] j h1 h2 h3
  have U0 : ∀ a b a', update (H a b) 0 a' = H a' b := fun a b a' => by
    funext j
    by_cases h1 : j = 0
    · subst h1; simp [H0]
    · rw [update_of_ne h1]
      by_cases h3 : j = sZ
      · subst h3; simp [HZ]
      · simp [hH, update_of_ne h1, update_of_ne h3]
  have UZ : ∀ a b b', update (H a b) sZ b' = H a b' := fun a b b' => by
    simp [hH]
  have eF : F = H (gflat L ++ l) [] := by
    funext j
    by_cases h1 : j = 0
    · subst h1; rw [H0, h0]
    · by_cases h3 : j = sZ
      · subst h3; rw [HZ, hFZ]
      · simp [hH, update_of_ne h1, update_of_ne h3]
  set S := g1 L
  set Y := g2 S
  set Jg := g3 Y
  set W := g4 Jg
  set Wp := g5 W
  set Y2 := g6 Wp
  obtain ⟨c1, r1, k1⟩ := h1 s (H (gflat L ++ l) []) L l (HE' _) (HA _ _) (H0 _ _) hp1
  rw [U0] at r1
  obtain ⟨c2, r2, k2⟩ := h2 s (H (gflat S ++ l) []) S l (HE' _) (HA _ _) (H0 _ _) hp2
  rw [U0] at r2
  obtain ⟨cc, rc, kc⟩ := hc s (H (gflat Y ++ l) []) Y [] l []
    (HE _ _) (HA _ _) (H0 _ _) (by rw [HZ]; rfl) hpc
  simp only [U0, UZ, List.append_nil] at rc
  obtain ⟨c3, r3, k3⟩ := pass_carry h3 hZ0 hZA s (H (gflat Y ++ l) (gflat Y)) Y l
    (HE _ _) (HA _ _) (H0 _ _) hp3
  rw [U0] at r3
  obtain ⟨c4, r4, k4⟩ := pass_carry h4 hZ0 hZA s (H (gflat Jg ++ l) (gflat Y)) Jg l
    (HE _ _) (HA _ _) (H0 _ _) hp4
  rw [U0] at r4
  obtain ⟨c5, r5, k5⟩ := pass_carry h5 hZ0 hZA s (H (gflat W ++ l) (gflat Y)) W l
    (HE _ _) (HA _ _) (H0 _ _) hp5
  rw [U0] at r5
  obtain ⟨c6, r6, k6⟩ := pass_carry h6 hZ0 hZA s (H (gflat Wp ++ l) (gflat Y)) Wp l
    (HE _ _) (HA _ _) (H0 _ _) hp6
  rw [U0] at r6
  obtain ⟨cs, rs, ks⟩ := hs s (H (gflat Y2 ++ l) (gflat Y)) Y2 Y l []
    (HE _ _) (HA _ _) (H0 _ _) (by rw [HZ, List.append_nil]) hps
  simp only [U0, UZ, List.append_nil] at rs
  obtain ⟨c7, r7, k7⟩ := h7 s (H (gflat Y ++ l) (gflat Y2)) Y Y2 l []
    (HE _ _) (HA _ _) (H0 _ _) (by rw [HZ, List.append_nil]) hp7
  simp only [U0, UZ, List.append_nil] at r7
  refine ⟨c1 + (c2 + (cc + (c3 + (c4 + (c5 + (c6 + (cs + c7))))))), ?_, ?_⟩
  · have R := r1.seq (r2.seq (rc.seq (r3.seq (r4.seq (r5.seq (r6.seq (rs.seq r7)))))))
    have eE : update F 0 (gflat (g7 Y Y2) ++ l) = H (gflat (g7 Y Y2) ++ l) (gflat []) := by
      rw [eF, U0]; rfl
    rw [eE]
    rw [eF]
    exact R
  · push_cast; linarith

end chain

end J6Seg.Ax

end

