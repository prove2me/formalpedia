namespace LPCA

open CategoryTheory

universe u

variable {V : Type u} [DecidableEq V] [Fintype V]
variable (k : Type u) [Field k]

theorem link_singleton_faces_subset_deletion (K : Complex V) (i : V) :
    (link K {i}).faces ⊆ (deletion K i).faces := by
  intro F hF
  obtain ⟨hFK, hd, _⟩ := Finset.mem_filter.mp hF
  exact Finset.mem_filter.mpr ⟨hFK, Finset.disjoint_singleton_right.mp hd⟩

theorem linkComplement_faces_subset_deletion (K : Complex V) (i : V) :
    (restrictComplex (link K {i}) (complementEmbedding i)).faces ⊆
      (restrictComplex (deletion K i) (complementEmbedding i)).faces :=
  restrictComplex_faces_mono (link_singleton_faces_subset_deletion K i) (complementEmbedding i)









/-- The underlying field map is exactly the original rho, restricted to
its actual homogeneous subspaces. -/
noncomputable def vertexAttachmentPieceMap (rank : V ↪ ℕ)
    (K : Complex V) (i : V) (b : {v : V // v ≠ i} → ℤ) (q : ℕ) :
    ModuleCat.of k (supportCohomologyPiece k ((complementEmbedding i).trans rank)
      (restrictComplex (deletion K i) (complementEmbedding i)) Finset.univ b q) ⟶
    ModuleCat.of k (supportCohomologyPiece k ((complementEmbedding i).trans rank)
      (restrictComplex (link K {i}) (complementEmbedding i)) Finset.univ b q) :=
  supportCohomologyPieceRestriction k ((complementEmbedding i).trans rank)
    (linkComplement_faces_subset_deletion K i) Finset.univ b q

@[reassoc] theorem vertexAttachmentPieceMap_naturality (rank : V ↪ ℕ)
    {K L : Complex V} (h : K.faces ⊆ L.faces) (i : V)
    (b : {v : V // v ≠ i} → ℤ) (q : ℕ) :
    supportCohomologyPieceRestriction k ((complementEmbedding i).trans rank)
        (restrictComplex_faces_mono (deletion_faces_mono h i) (complementEmbedding i))
        Finset.univ b q ≫ vertexAttachmentPieceMap k rank K i b q =
      vertexAttachmentPieceMap k rank L i b q ≫
        supportCohomologyPieceRestriction k ((complementEmbedding i).trans rank)
          (restrictComplex_faces_mono (link_faces_mono h {i}) (complementEmbedding i))
          Finset.univ b q := by
  dsimp only [vertexAttachmentPieceMap]
  rw [supportCohomologyPieceRestriction_comp, supportCohomologyPieceRestriction_comp]

noncomputable def vertexAttachmentPieceTransformation (rank : V ↪ ℕ)
    (K : Complex V) (f : Finset V → ℝ) (hf : FiltrationMonotone K f) (i : V)
    (b : {v : V // v ≠ i} → ℤ) (q : ℕ) :
    vertexDeletionPiecePersistence k rank K f hf i b q ⟶
      vertexLinkPiecePersistence k rank K f hf i b q where
  app t := vertexAttachmentPieceMap k rank (level K f hf (OrderDual.ofDual t)) i b q
  naturality _s _t h := vertexAttachmentPieceMap_naturality k rank
    (level_faces_mono K f hf (leOfHom h)) i b q

/-- The attachment arrow under Hochster is ordinary restriction on links,
with the exact same signs and reduced degree as the persistence formula. -/
@[reassoc] theorem vertexAttachmentPieceMap_hochster (rank : V ↪ ℕ)
    (K : Complex V) (i : V) (b : {v : V // v ≠ i} → ℤ) (q : ℕ)
    (hb : positiveSupport b = ∅) :
    vertexAttachmentPieceMap k rank K i b q ≫
        (canonicalHochsterSupportPieceIso k ((complementEmbedding i).trans rank)
          (restrictComplex (link K {i}) (complementEmbedding i)) b q hb).hom =
      (canonicalHochsterSupportPieceIso k ((complementEmbedding i).trans rank)
          (restrictComplex (deletion K i) (complementEmbedding i)) b q hb).hom ≫
        reducedFaceCohomologyRestriction k ((complementEmbedding i).trans rank)
          (link_faces_mono (linkComplement_faces_subset_deletion K i) (negativeSupport b))
          ((q : ℤ) - ((negativeSupport b).card : ℤ) - 1) :=
  canonicalHochsterSupportPieceIso_restriction k ((complementEmbedding i).trans rank)
    (linkComplement_faces_subset_deletion K i) b q hb

end LPCA


