    (hF0 : ∀ j, j ≠ 0 → j ≠ dTJ → F0 j = []) (hT : F0 dTJ = jTab P k K G fs bs cc)
    (h0 : F0 0 = gflat x ++ l) (hP : JPre P k K G Xb Bc fs bs cc x) (hBx : 3 * k + 10 ≤ Bx) :
    MSp M jKprog (encK s F0)
      (encK s (update F0 0 (gflat (liftG (jKerG P K G fs.length fs bs cc) x) ++ l)))
      (jC k K G fs bs cc (uC Φm Bx Bc)) := by
  obtain ⟨hxl, hDr, hDi⟩ := hP
  set m := fs.length with hmd
  set re := x.map Prod.fst with hre
  set im := x.map Prod.snd with him
