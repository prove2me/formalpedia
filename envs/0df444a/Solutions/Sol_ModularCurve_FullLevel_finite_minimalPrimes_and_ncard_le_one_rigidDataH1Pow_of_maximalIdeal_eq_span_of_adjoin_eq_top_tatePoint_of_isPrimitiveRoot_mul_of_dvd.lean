    let y := (rigidDataH1Pow A₀ ℓ M' q hℓ hM hL 𝒢 𝒯).toLevelModuliDatum.map
      ((IsScalarTower.toAlgHom A₀ (P₀.B₀ ⧸ 𝔭) (FractionRing (P₀.B₀ ⧸ 𝔭))).comp (Ideal.Quotient.mkₐ A₀ 𝔭)) P₀.univ
