namespace DirectionalTransience

lemma quenched_prefixDetermined_future {d : ℕ} (ω : Environment d) (x : Lattice d)
    (n : ℕ) (A : Set (Path d)) (hA : PrefixDetermined n A)
    (B : Lattice d → Set (Path d)) (hB : ∀ y, MeasurableSet (B y)) :
    quenchedKernel (ω,x) (A ∩ FutureEvent B n) =
      ∫⁻ X in A, quenchedKernel (ω,X n) (B (X n)) ∂quenchedKernel (ω,x) := by
  let C : Set ((i : Finset.Iic n) → Lattice d) := {f | extendPrefix n f ∈ A}
  have he : (fun X : Path d => Preorder.frestrictLe n X) ⁻¹' C = A := by
    ext X
    exact hA (extendPrefix n (Preorder.frestrictLe n X)) X
      (fun j hj => by rw [extendPrefix_apply _ _ _ hj]; rfl)
  simpa only [he] using quenched_past_future ω x n C B hB

lemma tubeEndpoint_future {d : ℕ} (ℓ : Vector d) (f : Direction d) (x : Lattice d)
    (θ z : ℝ) (s : ℕ) (ω : Environment d) (B : Lattice d → Set (Path d))
    (hB : ∀ y, MeasurableSet (B y)) :
    (∫⁻ y, quenchedKernel (ω,y) (B y) ∂tubeEndpoint ℓ f x θ z s ω) =
      quenchedKernel (ω,x) (⋃ n, TubePrefixAt ℓ f x θ z s n ∩ FutureEvent B n) := by
  rw [tubeEndpoint,lintegral_sum_measure]
  rw [measure_iUnion (fun n m hnm => (tubePrefixAt_disjoint ℓ f x θ z s hnm).mono
    Set.inter_subset_left Set.inter_subset_left)
    (fun n => (measurableSet_tubePrefixAt ℓ f x θ z s n).inter (measurableSet_futureEvent B hB n))]
  apply tsum_congr; intro n
  rw [lintegral_map (measurable_of_countable _) (measurable_pi_apply n)]
  exact (quenched_prefixDetermined_future ω x n _ (tubePrefixAt_prefix ℓ f x θ z s n) B hB).symm

lemma tubeEndpointMixture_future {d : ℕ} (ℓ : Vector d) (f : Direction d)
    (θ z : ℝ) (s : ℕ) (π : Measure (Lattice d)) (ω : Environment d)
    (B : Lattice d → Set (Path d)) (hB : ∀ y, MeasurableSet (B y)) :
    (∫⁻ y, quenchedKernel (ω,y) (B y) ∂tubeEndpointMixture ℓ f θ z s π ω) =
      ∫⁻ x, quenchedKernel (ω,x) (⋃ n, TubePrefixAt ℓ f x θ z s n ∩ FutureEvent B n) ∂π := by
  rw [tubeEndpointMixture,lintegral_sum_measure,lintegral_countable']
  apply tsum_congr; intro x
  rw [lintegral_smul_measure,smul_eq_mul,tubeEndpoint_future ℓ f x θ z s ω B hB,mul_comm]

end DirectionalTransience

