theorem cSwapEF_le (q V Bb : ℕ) :
    cSwapEF NLogN.KIL.swA (.lit (q : ℤ)) swB swC6 q V Bb 1 + 2 * ((2 + 1 + 1) * 10 ^ 7 * (Bb + 2) ^ 2) ≤
      cSw1F q V Bb := by
  unfold cSwapEF cSw1F
  rw [pushCost_eq, pushCost_eq]
  have e1 : pushSz [((1 : Fin HS), NLogN.KIL.swA), ((2 : Fin HS), Ex.lit (q : ℤ)), (3, Ex.mul swB (.lit (q : ℤ))),
      (4, swC6)] = 18 := rfl
  have e2 : pushSz [((1 : Fin HS), NLogN.KIL.swA), ((2 : Fin HS), Ex.lit (q : ℤ)), (3, swB),
      (4, Ex.mul (.lit (q : ℤ)) swC6)] = 18 := rfl
  rw [e1, e2]
  have hB : Bb + 2 ≤ (Bb + 2) ^ 2 := Nat.le_self_pow (by norm_num) _
  simp only [KFC.kap]
  generalize (Bb + 2) ^ 2 = Y at hB ⊢
  have e3 : (2 * q + 67) * (76 * 1 + 200) * V + (2 * q + 69) * (76 * 1 + 200) * V =
      (4 * q + 136) * 276 * V := by ring
  omega

end NLogN.KFE

