set_option autoImplicit false

open AlgebraicCurve

namespace CNT

theorem natCard_torsion_eq (K F : Type*) [Field K] [Field F] [Algebra K F] (n : ℕ) :
    Nat.card (Pic0.torsion K F n) = Nat.card {x : Pic0 K F // n • x = 0} := by
  refine Nat.card_congr (Equiv.subtypeEquivRight (fun x => ?_))
  show x ∈ Pic0.torsion K F n ↔ n • x = 0
  rw [Pic0.mem_torsion, natCast_zsmul]

end CNT

theorem solution
    (K F : Type*) [Field K] [Field F] [Algebra K F] [IsAlgClosed K] [CharZero K]
    [IsCurveOver K F] [Algebra.EssFiniteType K F]
    (ℓ : ℕ) [Fact ℓ.Prime] (k : ℕ) :
    Nat.card (Pic0.torsion K F (ℓ ^ k)) = ℓ ^ (2 * genusFF K F * k) := by
  have hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F := by
    obtain ⟨t, ht, hfd, -⟩ := AlgebraicCurve.IsCurveOver.exists_separating_transcendental (K := K) (F := F)
    exact ⟨t, ht, hfd⟩
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hℓK : (ℓ : K) ≠ 0 := Nat.cast_ne_zero.mpr hℓ0
  have hdiv : ∀ m : ℕ, m ≠ 0 → ∀ x : Pic0 K F, ∃ y : Pic0 K F, m • y = x :=
    fun m hm x => AlgebraicCurve.Pic0.exists_nsmul_eq K F hfg m hm x
  have hfin : ∀ n : ℕ, n ≠ 0 → Finite {x : Pic0 K F // n • x = 0} := fun n hn =>
    (AlgebraicCurve.Pic0.finite_and_card_torsion_le_of_natCast_ne_zero K F hfg n hn (Nat.cast_ne_zero.mpr hn)).1
  have h1 : Nat.card {x : Pic0 K F // ℓ • x = 0} = ℓ ^ (2 * genusFF K F) := by
    rw [← CNT.natCard_torsion_eq]
    exact AlgebraicCurve.Pic0.natCard_torsion_prime_eq_pow_two_mul_genusFF_of_natCast_ne_zero K F hfg ℓ hℓK
  rw [CNT.natCard_torsion_eq]
  induction k with
  | zero =>
    rw [pow_zero, mul_zero, pow_zero]
    have h : ∀ x : Pic0 K F, 1 • x = 0 ↔ x = 0 := fun x => by rw [one_smul]
    rw [Nat.card_congr (Equiv.subtypeEquivRight h), Nat.card_eq_one_iff_unique]
    exact ⟨⟨fun a b => Subtype.ext (a.2.trans b.2.symm)⟩, ⟨⟨0, rfl⟩⟩⟩
  | succ k ih =>
    rw [pow_succ', (card_torsion_mul_of_divisible hdiv ℓ (ℓ ^ k) hℓ0 (hfin ℓ hℓ0)
      (hfin (ℓ ^ k) (pow_ne_zero k hℓ0))).2, h1, ih, ← pow_add]
    congr 1
    ring

end S_AlgebraicCurve_Pic0_natCard_torsion_pow_eq_pow_two_mul_genusFF_mul_of_charZero
