      -((x : ℤ) + 1) = -((y : ℤ) + 1) → x = y := fun x _ y _ h => by omega
  have himg : ∀ j ∈ Finset.range N,
      (if -((j : ℤ) + 1) = 0 then d else c0 (-(-((j : ℤ) + 1) + 1)).toNat)
          • v.uniformizer ^ (-((j : ℤ) + 1))
