open NLogN
open IntMul
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}
set_option maxHeartbeats 4000000

theorem NLogN.fmMain_runs (pF pD pT pP : Fin P) (hPD : iprog pD = difBody pD)
    (hPT : iprog pT = ditBody pT) (hPP : iprog pP = pow2Body pP) (N C : ℕ)
    (hFM : FMSpec pF iprog I (fmN' N) C)
    (hN1 : 1 ≤ N) (hB : fmB N ≤ fmL N / 2) (hKM : 2 ^ fmK N * fmM N = N) (hM1 : 1 ≤ fmM N)
    (hnt : 2 * fmM N + 2 * fmK N + 4 ≤ fmN' N) (hnN : fmN' N ≤ N) (hℓ : fmL N ≤ N)
    (s : IState NS) (a b : ℤ) (LA LP LN LF : List Item) (ha : 0 ≤ a ∧ a ≤ 2 ^ N)
    (hb : 0 ≤ b ∧ b ≤ 2 ^ N) (hA : s.G ARG = .int a :: .int b :: LA)
    (hP : s.G PRM = .int N :: LP) (hN : s.G RN = .int (2 ^ N) :: LN)
    (hF : s.G RF = .int (2 ^ N + 1) :: LF) :
    IRuns I iprog (fmMain pF pD pT pP) s (s.upd ARG (.int ((a * b) % (2 ^ N + 1)) :: LA))
      (2 ^ fmK N * C + fmLevelCost N) := by sorry
