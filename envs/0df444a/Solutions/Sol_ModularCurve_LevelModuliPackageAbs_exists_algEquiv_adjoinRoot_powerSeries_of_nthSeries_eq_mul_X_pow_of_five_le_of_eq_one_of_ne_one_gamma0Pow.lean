    rw [WeierstrassCurve.map_map]
  have hord : ∀ F : FormalGroup k, F.toPowerSeries = (xet.curve.map ψet.toRingHom).formalGroupLawFixed →
      ∃ u : PowerSeries k, IsUnit u ∧ F.nthSeries q = u * PowerSeries.X ^ q := by
    intro F hF
    refine WeierstrassCurve.exists_isUnit_nthSeries_eq_mul_X_pow_of_variableChange
      (Cb • xet.curve.map ψet.toRingHom) Cb⁻¹ q F₀ F ?_ ?_ hF₀
    · rw [hF₀W, hxkc, E1]
    · rw [inv_smul_smul]; exact hF
  exact ⟨ρ, ψet, χa.toRingHom, hΔk, Qk, hρ, hχψ, ⟨φc, hφc, hcoef, hpin⟩, hQk, ⟨hhk, hDk, hyk, hρyk⟩, hord, hQ0⟩

