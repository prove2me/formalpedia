theorem pushSeq_cost (B : ℕ) : ∀ (l : List (Fin HS × Ex HS)) (t : IState HS), PBnd B l t →
    (NLogN.KFM.pushSeq l).cost t ≤ (l.map fun p => p.2.size + 1).sum * 10 ^ 7 * (B + 2) ^ 2 + 1
  | [], t, _ => by simp [NLogN.KFM.pushSeq, RS.cost]
  | [(r, e)], t, h => by
      have := RS.pushCost_le e t B h.1
      simp only [NLogN.KFM.pushSeq, rsCost_push, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      nlinarith
  | (r, e) :: (q :: l), t, h => by
      have h1 := RS.pushCost_le e t B h.1
      have h2 := pushSeq_cost B (q :: l) _ h.2
      show (RS.seq (.push r e) (NLogN.KFM.pushSeq (q :: l))).cost t ≤ _
      rw [rsCost_seq, rsCost_push]
      have : (RS.push r e).run t = t.upd r (.int (e.eval t) :: t.G r) := rfl
      rw [this]
      simp only [List.map_cons, List.sum_cons] at h2 ⊢
      nlinarith

theorem parQ_eq : parQ = NLogN.KFM.pushSeq Lq := rfl

theorem Lq_size : (Lq.map fun p => p.2.size + 1).sum ≤ 200 := by decide

