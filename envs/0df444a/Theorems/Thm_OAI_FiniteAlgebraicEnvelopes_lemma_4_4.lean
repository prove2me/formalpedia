-- title:
--   Lemma 4.4 (interchanging and splitting corners)
-- statement:
--   Let $R$ be a (possibly noncommutative) unital ring and $E, F, d, d^* \in R$ satisfy $EF = FE = 0$, $E^2 = E$, $F^2 = F$, $d = FdE$, $d^* = Ed^*F$, $d^*d = E$, $dd^* = F$ (the equivalence data of equation (17) in the source). Let $\psi : R \to R$ be additive and multiplicative, and suppose $E, F, d, d^*$ each commute with every value of $\psi$.
--
--   For $z$ in the kernel of the matrix representation $\pi : \mathrm{St}_6(R) \to \mathrm{GL}_6(R)$, let $z_E$ and $z_F$ denote the images of $z$ under the coefficient endomorphisms $x_{ij}(a) \mapsto x_{ij}(\psi(a)E)$ and $x_{ij}(a) \mapsto x_{ij}(\psi(a)F)$ respectively (`steinCoeffMap`). Then $z_E = z_F$.
--
--   This is the preprint's Lemma 4.4 ("interchanging and splitting corners"), the key technical step toward Theorem 4.1. Its proof puts $b = d + d^* + 1 - E - F$ (so $b^2=1$ and $bEb=F$) and $D = h_{12}(b)h_{34}(b)h_{56}(b)$ for the diagonal elements $h_{ij}(a) = w_{ij}(a)w_{ij}(-1)$, $w_{ij}(a) = x_{ij}(a)x_{ji}(-a^{-1})x_{ij}(a)$ built from the Steinberg relations (equations 20–21). Conjugation by $D$ sends every generator's coefficient $y$ to $byb$, so $D z_E D^{-1} = z_F$; since $z_E$ lies in the corner subgroup generated by $E$-coefficient roots with identity matrix, Lemma 4.3 makes it central, giving $D z_E D^{-1} = z_E$ and hence $z_E = z_F$.
--
--   **Formalization Note.** The preprint fixes $n = 6$ throughout; this formalization keeps that fixed value (via `SteinbergGroup 6 R`) since equation (21)'s three disjoint pairs $(1,2),(3,4),(5,6)$ exhaust the index set only at $n=6$. The coefficient maps and the hypotheses that $\psi$ respects the ring operations and that $E,F,d,d^*$ commute with $\psi(R)$ are stated as explicit hypotheses, matching the source's "suppose all four elements commute with $\psi(R)$".
-- source:
--   OpenAI Math Release (2026-09-23), "Finite algebraic envelopes and the Boone-Higman conjecture", Section 4, p. 12-13, Lemma 4.4

import Mathlib
import Definitions.Def_BooneHigman_Steinberg
import Definitions.Def_OAI_FiniteAlgebraicEnvelopes_steinCoeffMap

namespace OAI
namespace FiniteAlgebraicEnvelopes

universe u

variable {n : ℕ} {R : Type u} [Ring R]

theorem lemma_4_4 {E F d dstar : R} (hEE : E * E = E) (hFF : F * F = F) (hEF : E * F = 0)
    (hFE : F * E = 0) (hd : d = F * d * E) (hdstar : dstar = E * dstar * F)
    (hdstard : dstar * d = E) (hddstar : d * dstar = F)
    (psi : R → R) (hpsi_add : ∀ a b : R, psi (a + b) = psi a + psi b)
    (hpsi_mul : ∀ a b : R, psi (a * b) = psi a * psi b)
    (hEpsi : ∀ a : R, E * psi a = psi a * E) (hFpsi : ∀ a : R, F * psi a = psi a * F)
    (hdpsi : ∀ a : R, d * psi a = psi a * d) (hdstarpsi : ∀ a : R, dstar * psi a = psi a * dstar)
    (haddE : ∀ a b : R, psi (a + b) * E = psi a * E + psi b * E)
    (hmulE : ∀ a b : R, psi (a * b) * E = (psi a * E) * (psi b * E))
    (haddF : ∀ a b : R, psi (a + b) * F = psi a * F + psi b * F)
    (hmulF : ∀ a b : R, psi (a * b) * F = (psi a * F) * (psi b * F))
    (z : SteinbergGroup 6 R) (hz : steinPi z = 1) :
    steinCoeffMap (fun a => psi a * E) haddE hmulE z =
      steinCoeffMap (fun a => psi a * F) haddF hmulF z := by sorry

end FiniteAlgebraicEnvelopes
end OAI
