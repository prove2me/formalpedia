  have hb : y / 2 ^ j % 2 < 2 := Nat.mod_lt _ (by norm_num)
  unfold gc
  rcases Nat.mod_two_eq_zero_or_one (y / 2 ^ j) with h0 | h0 <;> rw [h0] <;> push_cast <;> ring

