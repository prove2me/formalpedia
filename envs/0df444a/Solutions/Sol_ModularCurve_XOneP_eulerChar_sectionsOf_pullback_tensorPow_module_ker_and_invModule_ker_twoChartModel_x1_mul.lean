section Monoidal
variable {C : Type*} [Category C] [MonoidalCategory C]

noncomputable def isoOfTensorIsoUnit {A A' B' : C} (eA : A ⊗ A' ≅ 𝟙_ C) (e : A' ⊗ B' ≅ 𝟙_ C) : A ≅ B' :=
  (ρ_ A).symm ≪≫ whiskerLeftIso A e.symm ≪≫ (α_ A A' B').symm ≪≫ whiskerRightIso eA B' ≪≫ λ_ B'

noncomputable def foldrCongr {ι : Type*} (A B : ι → C) (e : ∀ i, A i ≅ B i) {N N' : C} (eN : N ≅ N') :
    (l : List ι) → l.foldr (fun i M => A i ⊗ M) N ≅ l.foldr (fun i M => B i ⊗ M) N'
  | [] => eN
  | (a :: l) => (e a ⊗ᵢ foldrCongr A B e eN l)

end Monoidal
