-- title:
--   Proposition 5.1, p. 11 — for (5.1) under Assumptions 1, 2, 3, 6, λₖ → λ_*, vₖ → v_*, and λ̄ₖ = λₖ for k large
-- statement:
--   Consider the equality-constrained problem (5.1), minimize $f(x)$ subject to $h_1(x)=0$, $h_2(x)=0$, with $f,h_1,h_2$ continuously differentiable. Let $\{x_k\}$ be generated by Algorithm 3.1 with the safeguard of §5.1 ($\bar\lambda_{k+1}$ is the projection of $\lambda_{k+1}=\bar\lambda_k+\rho_kh_1(x_k)$ on the box $[\bar\lambda_{\min},\bar\lambda_{\max}]$), and suppose:
--
--   1. (Assumption 1) $x_k\to x_*$;
--   2. (Assumption 2) $h_1(x_*)=0$ and $h_2(x_*)=0$;
--   3. (Assumption 3) the gradients $\nabla[h_1(x_*)]_1,\dots,\nabla[h_1(x_*)]_{m_1},\nabla[h_2(x_*)]_1,\dots,\nabla[h_2(x_*)]_{m_2}$ are linearly independent;
--   4. $\lambda_*\in\mathbb R^{m_1}$, $v_*\in\mathbb R^{m_2}$ are Lagrange multipliers at $x_*$: $\nabla f(x_*)+\nabla h_1(x_*)\lambda_*+\nabla h_2(x_*)v_*=0$;
--   5. (Assumption 6) $[\lambda_*]_i\in([\bar\lambda_{\min}]_i,[\bar\lambda_{\max}]_i)$ for every $i$.
--
--   Then
--   $$\lim_{k\to\infty}\lambda_k=\lambda_*,\qquad \lim_{k\to\infty}v_k=v_*,\qquad \bar\lambda_k=\lambda_k\ \text{for } k \text{ large enough}.$$
--
--   The proposition says that the safeguarded estimates eventually coincide with the first-order multiplier estimates, which is what lets the proof of Theorem 5.4 replace $\bar\lambda_k$ by $\lambda_k$.
--
--   **Formalization Note** $\lambda_*$, $v_*$ appear on the page only through Assumption 5, which Proposition 5.1 does not list; they are pinned by the first-order part of Assumption 5 (they are Lagrange multipliers at $x_*$), and Assumption 3 makes them unique. "$\bar\lambda_k=\lambda_k$ for $k$ large" is stated as $\bar\lambda_{k+1}=\lambda_{k+1}$ eventually, with $\lambda_{k+1}$ = `P.lamNext x ρ lamBar k`. Problem (5.1) is (2.1) with $p_1=p_2=0$, so the inequality data live on `Fin 0`.
-- source:
--   Andreani, Birgin, Martínez & Schuverdt, On augmented Lagrangian methods with general lower-level constraints, HAL hal-01295437v1, p. 11, Proposition 5.1 (with Assumptions 1, 2, 3, 6 and the Definition of §5.1)

import Mathlib
import Definitions.Def_AugLagLLC_Penalty_SecondOrder

open Filter
open scoped Topology

namespace AugLagLLC.Penalty

/-- Proposition 5.1, p. 11: under Assumptions 1, 2, 3 and 6, with `λ_*`, `v_*` Lagrange
multipliers of (5.1) at `x_*` (Assumption 5(a)), the multiplier estimates converge,
`λₖ → λ_*` and `vₖ → v_*`, and the safeguard is eventually inactive: `λ̄ₖ = λₖ` for `k` large.
`P.lamNext x ρ lamBar k` is `λₖ₊₁`. -/
theorem prop_5_1
    {n m1 m2 : ℕ} (P : Problem n m1 0 m2 0) (hP : P.IsC1)
    {τ γ ρ1 : ℝ} {lamMin lamMax : Fin m1 → ℝ} {muMax : Fin 0 → ℝ} {ε : ℕ → ℝ}
    (hpar : Problem.IsParams τ γ ρ1 lamMin lamMax muMax ε)
    {x : ℕ → EuclideanSpace ℝ (Fin n)} {ρ : ℕ → ℝ} {lamBar : ℕ → Fin m1 → ℝ}
    {muBar : ℕ → Fin 0 → ℝ} {v : ℕ → Fin m2 → ℝ} {u : ℕ → Fin 0 → ℝ}
    -- Assumption 1: a run of Algorithm 3.1 on (5.1), with the safeguard Definition of §5.1
    (hrun : P.IsProjRun τ γ ρ1 lamMin lamMax muMax ε x ρ lamBar muBar v u)
    {xs : EuclideanSpace ℝ (Fin n)} (hlim : Tendsto x atTop (𝓝 xs))
    -- Assumption 2
    (hfeas : xs ∈ P.Omega1 ∩ P.Omega2)
    -- Assumption 3
    (hLI : LinearIndependent ℝ
      (Sum.elim (fun i => gradient (P.h1 i) xs) (fun i => gradient (P.h2 i) xs)))
    -- `λ_*`, `v_*`: Lagrange multipliers at `x_*` (first-order part of Assumption 5)
    (lamS : Fin m1 → ℝ) (vS : Fin m2 → ℝ) (hmult : gradient (P.lagr0 lamS vS) xs = 0)
    -- Assumption 6
    (hbox : ∀ i, lamMin i < lamS i ∧ lamS i < lamMax i)
    :
    Tendsto (P.lamNext x ρ lamBar) atTop (𝓝 lamS) ∧ Tendsto v atTop (𝓝 vS) ∧
      ∀ᶠ k in atTop, lamBar (k + 1) = P.lamNext x ρ lamBar k := by sorry

end AugLagLLC.Penalty
