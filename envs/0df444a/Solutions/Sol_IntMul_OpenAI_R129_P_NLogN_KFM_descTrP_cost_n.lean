    (RS.rep mOc (.reg NLogN.KFM.zD) Bd).cost s ≤ 2 * 10 ^ 7 * (B + 2) ^ 2 +
      d * (C + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) + 32 := by
  set St : ℕ → IState HS := fun k => s.upd dst (ints (NLogN.KFM.pushL v d k) ++ s.G dst) with hSt
  have H := loopI_cost mOc (.reg NLogN.KFM.zD) Bd s d St (by simp [Ex.eval, IState.top_eq hD])
    (by simp [hSt, NLogN.KFM.pushL])
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      have := hB (ints (NLogN.KFM.pushL v d k)) (d - k) (by omega) (by omega)
      refine ⟨this.1, ?_⟩
      rw [this.2]
      apply IState.ext' _ (by simp [hSt]) (by simp [hSt])
      intro j
      simp only [hSt, IState.upd_G]
      by_cases j1 : j = mOc
      · subst j1; simp [Ne.symm hdO]
      by_cases j2 : j = dst
      · subst j2
        simp only [if_pos rfl, if_neg hdO]
        rw [pushL_succ v d k hk, ints_cons]
        rfl
      · simp [j1, j2])
    B C hzd hB1 (by show zsz (s.top NLogN.KFM.zD) ≤ B; rw [IState.top_eq hD]; exact hzd)
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      exact hbc _ _ (by omega) (by omega))
  have hs : (Ex.reg NLogN.KFM.zD : Ex HS).size = 1 := rfl
  rw [hs] at H
  have e : (1 + 1) * 10 ^ 7 * (B + 2) ^ 2 = 2 * 10 ^ 7 * (B + 2) ^ 2 := by ring
  rw [e] at H
  exact H

end NLogN.KFM

