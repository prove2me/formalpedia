      (.lit ((a * T.length : ℕ) : ℤ))) (gStageT (.reg sNQ) (.reg NLogN.KIL.sSA) (.reg sSC) (.reg sSM)
      (.reg sSAM)) :=
    rsim_gStageT (.par rfl) (.par rfl) (.par rfl) (.par rfl) (.par rfl)
  have hw := notw_of_idx (l := [(sNQ, -(Q : ℤ)), (NLogN.KIL.sSA, (a : ℤ)), (sSC, (c : ℤ)),
    (sSM, (T.length : ℤ)), (sSAM, ((a * T.length : ℕ) : ℤ))])
