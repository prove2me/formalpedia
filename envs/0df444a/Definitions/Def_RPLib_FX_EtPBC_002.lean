noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

open RamanujanPetersson.EtPBC.Z3

universe u

variable (K : Type u) [Field K] {V : Scheme.{u}} (gV : V ⟶ Spec (CommRingCat.of K)) {Y : Scheme.{u}} [IsAffine V] (R' : Type u) [CommRing R'] [Algebra Γ(V, ⊤) R']

section Chart

end Chart

section Res

variable {U U' : Y.Opens} (hU : IsAffineOpen U) (hU' : IsAffineOpen U') (hle : U' ≤ U) [Algebra Γ(V, ⊤) Γ(Y, U)] [Algebra Γ(V, ⊤) Γ(Y, U')] (φ : Γ(Y, U) →ₐ[Γ(V, ⊤)] Γ(Y, U')) (hφ : φ.toRingHom = (Y.presheaf.map (homOfLE hle).op).hom)

/-- The chart transition `R' ⊗ Γ(Y, U) → R' ⊗ Γ(Y, U')`. -/
abbrev tmap : CommRingCat.of (R' ⊗[Γ(V, ⊤)] Γ(Y, U)) ⟶ CommRingCat.of (R' ⊗[Γ(V, ⊤)] Γ(Y, U')) :=
