-- Source module: Solutions.J6SegLn10
/-!
# Segmented inverse (S2), machine side 10: the solver maps zero to zero

`B₀` must send an all-zero line to an all-zero line (the padded entries of the tensor stay
exactly zero). The only non-obvious step is the rounded division `fdiv P 0 d = 0`, true for
`d ≥ 0`: every pivot of the elimination is positive in the near-identity regime.

* `PivPos`, **`geSolveS_zero`**: nonnegative pivots give `geSolveS … 0 = 0`;
* **`pivPos_of`**: the hypotheses of `geSolveS_eq` give nonnegative pivots (same induction);
* **`segInvS_zero`** (hypotheses of `segInvS_eq`), **`segInvFullS_zero`** (parameter
  hypotheses of `segInvFullS_err`).
-/

open Finset Real

namespace J6Seg
open IntMul.HvdH IntMul.HvdH.JPf J6QLU

section piv
variable (P : ℕ) (S : ℕ → ℕ → Prop) [DecidableRel S]

/-- **The near-identity hypotheses give positive pivots.** -/
theorem pivPos_of_sol_aux : ∀ (L : List ℕ) (A : ℕ → ℕ → ℤ)
    (b : ℕ → ℤ) (η : ℝ), L.Nodup → 0 ≤ η → η + (L.length : ℝ) ^ 2 / 2 ^ P ≤ 1 / 2 →
    (∀ i ∈ L, ∑ k ∈ L.toFinset, |(A i k : ℝ) / 2 ^ P - kd i k| ≤ η) →
    (∀ i ∈ L, ∀ k ∈ L, ¬ S i k → A i k = 0) → PatOK S L → PivPos P S L A := by
  intro L
  induction L with
  | nil => intro _ _ _ _ _ _ _ _ _; trivial
  | cons j L ih =>
  intro A b η hnd hη0 hηs hrow hzero hpat
  rw [List.nodup_cons] at hnd
  obtain ⟨hjL, hnd⟩ := hnd
  obtain ⟨hcl, hpat⟩ := hpat
  set Sc : ℝ := 2 ^ P with hSdef
  have hS : 0 < Sc := two_pow_pos' P
  set n : ℕ := L.length with hn
  have hlen : ((j :: L).length : ℝ) = n + 1 := by simp [hn]
  rw [hlen] at hηs
  have hnn : (0 : ℝ) ≤ n := Nat.cast_nonneg _
  have hfs : (j :: L).toFinset = insert j L.toFinset := by simp
  have hjL' : j ∉ L.toFinset := by simpa using hjL
  set a : ℕ → ℕ → ℝ := fun i k => (A i k : ℝ) / Sc with ha
  have hrow' : ∀ i ∈ j :: L, |a i j - kd i j| + ∑ k ∈ L.toFinset, |a i k - kd i k| ≤ η := by
    intro i hi; have := hrow i hi; rw [hfs, sum_insert hjL'] at this; exact this
  have hηh : η ≤ 1 / 2 := by
    have : 0 ≤ ((n : ℝ) + 1) ^ 2 / Sc := by positivity
    linarith
  have hrj := hrow' j (List.mem_cons_self ..)
  rw [kd_self] at hrj
  have hsum0 : 0 ≤ ∑ k ∈ L.toFinset, |a j k - kd j k| := sum_nonneg fun _ _ => abs_nonneg _
  have hajj : 1 / 2 ≤ a j j := by have := neg_abs_le (a j j - 1); linarith
  have hajjp : 0 < a j j := by linarith
  have hAjj : 0 < A j j := by
    have : (0 : ℝ) < A j j := by
      have := mul_pos hajjp hS; simp only [ha] at this; rwa [div_mul_cancel₀ _ hS.ne'] at this
    exact_mod_cast this
  have hj : j ∈ j :: L := List.mem_cons_self ..
  have hL : ∀ i ∈ L, i ∈ j :: L := fun i hi => List.mem_cons_of_mem _ hi
  -- the dense Schur complement
  set f : ℕ → ℤ := fun i => fdiv P (A i j) (A j j) with hf
  set A' : ℕ → ℕ → ℤ := fun i k => A i k - fmul P (f i) (A j k) with hA'
  set b' : ℕ → ℤ := fun i => b i - fmul P (f i) (b j) with hb'
  set AS : ℕ → ℕ → ℤ := fun i k => if S i j ∧ S j k then A i k - fmul P (f i) (A j k) else A i k
    with hAS
  set bS : ℕ → ℤ := fun i => if S i j then b i - fmul P (f i) (b j) else b i with hbS
  -- off the pattern, the update is zero
  have hfz : ∀ i ∈ L, ¬ S i j → f i = 0 := fun i hi h => by
    simp only [hf]; rw [hzero i (hL i hi) j hj h]; exact fdiv_zero P hAjj
  have hAAS : ∀ i ∈ L, ∀ k ∈ L, AS i k = A' i k := by
    intro i hi k hk
    simp only [hAS, hA']
    split_ifs with h
    · rfl
    · rcases not_and_or.1 h with h1 | h1
      · rw [hfz i hi h1, fmul_zero_left]; ring
      · rw [hzero j hj k (hL k hk) h1, fmul_zero_right]; ring
  have hbbS : ∀ i ∈ L, bS i = b' i := by
    intro i hi
    simp only [hbS, hb']
    split_ifs with h
    · rfl
    · rw [hfz i hi h, fmul_zero_left]; ring
  -- the dense Schur complement is near the identity (as in `geSolve_resid`)
  set η' : ℝ := η + ((n : ℝ) + 1) / (2 * Sc) with hη'
  have hferr : ∀ i, |(f i : ℝ) / Sc - a i j / a j j| ≤ 1 / (2 * Sc) := fun i => fdiv_err P _ hAjj
  have hmu : ∀ i k, |(fmul P (f i) (A j k) : ℝ) / Sc - (f i : ℝ) / Sc * a j k| ≤ 1 / (2 * Sc) :=
    fun i k => fmul_err P _ _
  have hA'v : ∀ i k, (A' i k : ℝ) / Sc = a i k - (fmul P (f i) (A j k) : ℝ) / Sc := by
    intro i k; simp only [hA', ha]; push_cast; ring
  have hjk : ∀ k ∈ L.toFinset, kd j k = 0 := fun k hk =>
    kd_ne (fun (h : j = k) => hjL (h ▸ List.mem_toFinset.1 hk))
  have hRj : ∑ k ∈ L.toFinset, |a j k| ≤ η := by
    have : ∑ k ∈ L.toFinset, |a j k - kd j k| = ∑ k ∈ L.toFinset, |a j k| :=
      sum_congr rfl fun k hk => by rw [hjk k hk, sub_zero]
    linarith [abs_nonneg (a j j - 1)]
  have hschur := schur_row (a := a) hjL hηh hrow'
  have hrowA' : ∀ i ∈ L, ∑ k ∈ L.toFinset, |(A' i k : ℝ) / Sc - kd i k| ≤ η' := by
    intro i hi
    have hdiff : ∀ k ∈ L.toFinset, |(A' i k : ℝ) / Sc - kd i k| ≤
        |a i k - a i j * a j k / a j j - kd i k| + (|a j k| / (2 * Sc) + 1 / (2 * Sc)) := by
      intro k _
      rw [hA'v]
      have e : a i k - (fmul P (f i) (A j k) : ℝ) / Sc - kd i k =
          (a i k - a i j * a j k / a j j - kd i k) +
          ((a i j / a j j - (f i : ℝ) / Sc) * a j k -
            ((fmul P (f i) (A j k) : ℝ) / Sc - (f i : ℝ) / Sc * a j k)) := by
        field_simp; ring
      rw [e]
      refine (abs_add_le _ _).trans (add_le_add le_rfl ?_)
      refine (abs_sub _ _).trans (add_le_add ?_ (hmu i k))
      rw [abs_mul, abs_sub_comm, div_eq_mul_inv |a j k|, mul_comm |a j k|]
      exact mul_le_mul_of_nonneg_right (by have := hferr i; rw [one_div] at this; exact this)
        (abs_nonneg _)
    refine (sum_le_sum hdiff).trans ?_
    rw [sum_add_distrib, sum_add_distrib, ← sum_div, sum_const, nsmul_eq_mul,
      List.card_toFinset, List.Nodup.dedup hnd]
    have h1 := hschur i hi
    have h2 : (∑ k ∈ L.toFinset, |a j k|) / (2 * Sc) ≤ 1 / (2 * Sc) :=
      div_le_div_of_nonneg_right (by linarith) (by positivity)
    have e : ((L.length : ℕ) : ℝ) * (1 / (2 * Sc)) = (n : ℝ) / (2 * Sc) := by rw [hn]; ring
    rw [e]
    have e2 : ((n : ℝ) + 1) / (2 * Sc) = 1 / (2 * Sc) + (n : ℝ) / (2 * Sc) := by ring
    rw [hη', e2]; linarith
  have hη'0 : 0 ≤ η' := by positivity
  have hη's : η' + (n : ℝ) ^ 2 / Sc ≤ 1 / 2 := by
    have e : η' + (n : ℝ) ^ 2 / Sc = η + ((n : ℝ) + 1 + 2 * n ^ 2) / (2 * Sc) := by
      rw [hη']; field_simp; ring
    have e2 : ((n : ℝ) + 1) ^ 2 / Sc = (2 * ((n : ℝ) + 1) ^ 2) / (2 * Sc) := by field_simp
    rw [e]; rw [e2] at hηs
    have : ((n : ℝ) + 1 + 2 * n ^ 2) / (2 * Sc) ≤ (2 * ((n : ℝ) + 1) ^ 2) / (2 * Sc) :=
      div_le_div_of_nonneg_right (by nlinarith) (by positivity)
    linarith
  -- rows and zero pattern for `AS`
  have hrowAS : ∀ i ∈ L, ∑ k ∈ L.toFinset, |(AS i k : ℝ) / 2 ^ P - kd i k| ≤ η' := by
    intro i hi
    refine le_trans (le_of_eq ?_) (hrowA' i hi)
    exact sum_congr rfl fun k hk => by rw [hAAS i hi k (List.mem_toFinset.1 hk)]
  have hzeroAS : ∀ i ∈ L, ∀ k ∈ L, ¬ S i k → AS i k = 0 := by
    intro i hi k hk hik
    rw [hAAS i hi k hk]
    simp only [hA']
    have : ¬ (S i j ∧ S j k) := fun h => hik (hcl i hi k hk h.1 h.2)
    rcases not_and_or.1 this with h1 | h1
    · rw [hfz i hi h1, fmul_zero_left, hzero i (hL i hi) k (hL k hk) hik]; ring
    · rw [hzero j hj k (hL k hk) h1, fmul_zero_right, hzero i (hL i hi) k (hL k hk) hik]; ring
  have hIH := ih AS bS η' hnd hη'0 hη's hrowAS hzeroAS hpat
  exact ⟨hAjj.le, hIH⟩

end piv

end J6Seg

end

theorem solution : type_of% @J6Seg.pivPos_of_sol_aux := @J6Seg.pivPos_of_sol_aux
