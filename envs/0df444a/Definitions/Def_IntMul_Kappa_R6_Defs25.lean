section
-- Source module: Solutions.R6CxNetFinal
/-!
# Track B: the round-six complex network as a `Prop8IfaceH`

`net = Z_u on every X ++ steps of CH ++ i^{wt u} Z_u on every Y ++ (X ↔ Y)`, on the roles
`Fin 207387136 ⊕ Fin 4193728`.

* `net_correct`: for every column type `κ`, the data block of its denotation is `C^{⊗}` on every
  data role (clean temporaries), from `prog_sim` with the initial labels `g0`, the final labels
  `gF_*` and the logical effect `ΛF_*`, as in `P8Lift.prog_correct`;
* `net_widths`: its child widths are `progWidths CH` (histogram `cxR6`, all `< 576`).

**`cxNetR6 : ∃ T, Nonempty (Prop8IfaceH 207387136 T 576 Jain.cxR6)`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000
set_option synthInstance.maxSize 512

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw Complex Butterfly P8Lift

/-! ## Role decoding -/

/-- Pair index of an `X`/`Y` role. -/
def xy (r : Rl) : ℕ := if rc r < NN then rc r else rc r - NN

/-- The correction vector of an `X`/`Y` role. -/
def ua (r : Rl) : Fin 576 → ZMod 2 := Uv (xy r / NV) (xy r % NV)

def uN (r : Rl) : Fin 576 → ℕ := fun i => 2 * (ua r i).val

lemma NN_lt : 2 * NN < Wn := by norm_num [NN, NV, Wn]

lemma rc_inl (w : Fin Wn) : rc (Sum.inl w : Rl) = w.val := rfl

lemma inl_eq_rW (w : Fin Wn) : (Sum.inl w : Rl) = rW w.val := by
  unfold rW; congr 1; exact Fin.ext (Nat.mod_eq_of_lt w.isLt).symm

lemma rW_rc {r : Rl} (h : rc r < Wn) : rW (rc r) = r := by
  rcases r with w | n
  · rw [rc_inl, ← inl_eq_rW]
  · exfalso; simp only [rc] at h; omega

/-! ## Phases and the role permutation -/

noncomputable def preR (r : Rl) : List (RStep Rl 576) :=
  if rc r < NN then [RStep.phase r 0 0 (uN r)] else []

noncomputable def postR (r : Rl) : List (RStep Rl 576) :=
  if NN ≤ rc r ∧ rc r < 2 * NN then [RStep.phase r 0 (NetComplexPhase.wt (ua r)) (uN r)] else []

variable {κ : Type} [Fintype κ] [DecidableEq κ]

variable (κ) in
noncomputable def preOpR (r : Rl) : Op (Fin 576 × κ) :=
  if rc r < NN then colT (ZuMat (ua r)) else 1

variable (κ) in
noncomputable def postOpR (r : Rl) : Op (Fin 576 × κ) :=
  if NN ≤ rc r ∧ rc r < 2 * NN then
    (I ^ NetComplexPhase.wt (ua r)) ^ Fintype.card κ • colT (ZuMat (ua r)) else 1

/-- `X(a,b) ↔ Y(a,b)`. -/
def σf (r : Rl) : Rl :=
  if rc r < NN then rW (rc r + NN) else if rc r < 2 * NN then rW (rc r - NN) else r

lemma σf_invol (r : Rl) : σf (σf r) = r := by
  unfold σf
  by_cases h1 : rc r < NN
  · have hc : rc (rW (rc r + NN)) = rc r + NN := rc_rW (by have := NN_lt; omega)
    rw [if_pos h1, hc, if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel, rW_rc (by have := NN_lt; omega)]
  · rw [if_neg h1]
    by_cases h2 : rc r < 2 * NN
    · have hc : rc (rW (rc r - NN)) = rc r - NN := rc_rW (by have := NN_lt; omega)
      rw [if_pos h2, hc, if_pos (by omega), Nat.sub_add_cancel (by omega), rW_rc (by have := NN_lt; omega)]
    · rw [if_neg h2, if_neg h1, if_neg h2]

def σE : Equiv.Perm Rl := ⟨σf, σf, σf_invol, σf_invol⟩

/-! ## The network -/

/-- **The round-six complex network.** -/
noncomputable def net : List (HStep Rl 576) :=
  ((univ : Finset Rl).toList.flatMap preR).map HStep.ofR ++ progSteps CH ++
    ((univ : Finset Rl).toList.flatMap postR).map HStep.ofR ++ [HStep.perm σE]

/-! ## Correctness -/

end IntMul.Kappa.R6.Cx.NetG

namespace IntMul.Kappa.R6.Cx

open NetG NetFr

end IntMul.Kappa.R6.Cx

end

section
-- Source module: R6Pk.R6CxNetG
/-!
# The round-six complex network in the item-language gate class (`GClassH`)

`R6CxNetFinal.net` uses `mergedChunk` (an opaque `Classical.choose` of `merge_chunk`) for its frame
changes; its steps cannot be inspected. `netG` is the same network with every merged chunk replaced by
the explicit `chunkH` (row additions, one child, row additions) chosen from `merge_identity`: same
denotation, same child widths. Its only gates are the chunk gates `GOp.mat`:

* `z_d += (k/2) z_s` with `d ≠ s` (all local ops, `C1`, `C2`): `|k|` KFG atoms `(d, s, sign k, h = 1)`;
* `z_X += -2 z_X` (`C3`): the `±1` diagonal `-1` at `X`.

**`cxNetR6G : ∃ T (J : Prop8IfaceH 207387136 T 576 Jain.cxR6) A, GClassH J A`.**
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw Complex Butterfly P8Lift

/-! ## Local ops act on two distinct wires -/

section LocalDist

variable (d : Dat)

/-- Every op has distinct target and source. -/
def LD (l : List (ℕ × ℕ × ℤ)) : Prop := ∀ o ∈ l, o.1 ≠ o.2.1

/-- Specs whose ops are all `LD`. -/
def LDs (ss : List Spec) : Prop := ∀ s ∈ ss, LD s.ops

end LocalDist

/-! ## Explicit merged chunks -/

/-- The merge condition of a kernel list. -/
def MC (L : List (ℤ × (Fin 576 → ZMod 2))) : Prop :=
  L ≠ [] ∧ (∀ p ∈ L, p.1 = 1 ∨ p.1 = -1) ∧ LIndep L

lemma merge_ex (L : List (ℤ × (Fin 576 → ZMod 2))) (hL : MC L) :
    ∃ t : List (Fin 576 × Fin 576) × Finset (Fin 576) × Finset (Fin 576), t.2.1.card = L.length ∧
      ∀ (κ : Type) [Fintype κ] [DecidableEq κ],
        (_root_.IntMul.Kappa.R6.Cx.PL t.1.reverse * signedOp (chEx (κ := κ)) t.2.1 t.2.2 *
          _root_.IntMul.Kappa.R6.Cx.PL t.1 : Op (Fin 576 × κ)) =
          colT (L.map fun p => Tk p.1 p.2).prod := by
  obtain ⟨js, S, neg, h1, -, h3⟩ := merge_identity (fun k : Fin L.length => (L.get k).1)
    (fun k => hL.2.1 _ (List.get_mem L k)) _ hL.2.2
  exact ⟨(js, S, neg), h1, fun κ _ _ => by rw [h3 κ, prod_finRange_get]⟩

open Classical in
/-- The explicit merged chunk: `chunkH` with the data of `merge_identity`. -/
noncomputable def mcG (w : Rl) (L : List (ℤ × (Fin 576 → ZMod 2))) : List (HStep Rl 576) :=
  if hL : MC L then
    chunkH w (Classical.choose (merge_ex L hL)).1 (Classical.choose (merge_ex L hL)).2.1
      (Classical.choose (merge_ex L hL)).2.2
  else []

/-! ## The network with explicit merged chunks -/

/-- Steps of a chunk, with explicit merged chunks. -/
noncomputable def stepsG (C : GChunk Rl 576) : List (HStep Rl 576) :=
  C.mv.flatMap (fun p => mcG p.1 (kersM C.V p.2)) ++ C.ops.map fun o => HStep.gate o.mat

noncomputable def progStepsG (cs : List (GChunk Rl 576)) : List (HStep Rl 576) := cs.flatMap stepsG

/-- **The network with explicit merged chunks.** -/
noncomputable def netG : List (HStep Rl 576) :=
  ((univ : Finset Rl).toList.flatMap preR).map HStep.ofR ++ progStepsG CH ++
    ((univ : Finset Rl).toList.flatMap postR).map HStep.ofR ++ [HStep.perm σE]

/-! ## The gates of `netG` -/

/-! ## The ops of `CH` -/

/-- An op of `CH`: `z_d += (k/2) z_s` with `d ≠ s`, or `z_X += -2 z_X`. -/
def OpK (o : GOp Rl) : Prop := (o.dst ≠ o.src ∧ ∃ k : ℤ, o.c = (k : ℂ) / 2) ∨ (o.dst = o.src ∧ o.c = -2)

/-! ## Ops as KFG atoms -/

open IntMul.Kappa.R6.IL3H

/-- The atom of `z_d += (sign k / 2) z_s`. -/
def atK (d s : Rl) (k : ℤ) : NLogN.KFG.Atom := ⟨rc d, rc s, (k.sign, 0), 1⟩

/-- The gate-class predicate of one op with atom bound `A`. -/
def GP (o : GOp Rl) (A : ℕ) : Prop :=
  (∃ as : List NLogN.KFG.Atom, as.length ≤ A ∧ (∀ a ∈ as, a.Ok (Wn + Tn) ∧ a.h ≤ 1) ∧ NLogN.KFG.NoTS as ∧
      o.mat = (NLogN.KFG.gateMat (Wn + Tn) as).submatrix (roleEqv Wn Tn) (roleEqv Wn Tn)) ∨
    (∃ U : Finset Rl, o.mat = Matrix.diagonal fun w => if w ∈ U then -1 else 1)

end IntMul.Kappa.R6.Cx.NetG

namespace IntMul.Kappa.R6.Cx

open NetG NetFr IL3H

end IntMul.Kappa.R6.Cx

