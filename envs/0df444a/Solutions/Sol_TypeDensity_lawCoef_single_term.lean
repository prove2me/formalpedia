theorem solution (a n : ℕ) (ha : 0 < a) (hn : 0 < n)
    (P : TypeDensity.TangentPattern (TypeDensity.State.single a n).degree) (hP : TypeDensity.Allowed (TypeDensity.State.single a n) P) :
    TypeDensity.lawCoef (TypeDensity.lawScale (.mul (TypeDensity.tangentCount (TypeDensity.State.single a n) P)
        (TypeDensity.divisorProbability (TypeDensity.State.single a n) P.d.val))
        (TypeDensity.lawProd ((TypeDensity.children (TypeDensity.State.single a n) P).map fun z ↦ TypeDensity.lawDescend z.1 (TypeDensity.stateLaw z.2)))) =
        TypeDensity.scalar ((TypeDensity.divisorCount 0 P.other).rational * (TypeDensity.divisorProbability (TypeDensity.State.single a n)
        P.d.val).rational) * ((if P.rt.val = 0 then 1 else TypeDensity.lawCoef
        (TypeDensity.stateLaw (TypeDensity.State.crossing a a P.rt.val (n - P.d.val)))) *
        ∏ ij : Fin (TypeDensity.State.single a n).degree × Fin (TypeDensity.State.single a n).degree,
        (TypeDensity.adamsCoef (ij.1.val + 1) (TypeDensity.lawCoef (TypeDensity.stateLaw (TypeDensity.State.single a (ij.2.val + 1))))) ^
        (P.other ij).val) := by
  have hv : ∀ z ∈ TypeDensity.children (TypeDensity.State.single a n) P, z.2.Valid :=
    TypeDensity.children_valid (TypeDensity.State.single a n) ⟨ha, hn⟩ P hP
  rw [TypeDensity.lawCoef_lawScale, TypeDensity.Expr.rational_mul]
  congr 1
  have hch : TypeDensity.children (TypeDensity.State.single a n) P =
      (if P.rt.val=0 then [] else [(1,TypeDensity.State.crossing a a P.rt.val (n-P.d.val))]) ++
      TypeDensity.otherChildren a P.other := rfl
  have hoth := TypeDensity.lawCoef_otherChildren a _ ha P.other
  rw [TypeDensity.lawCoef_lawProd, List.map_map] at hoth
  rw [TypeDensity.lawCoef_lawProd, List.map_map, hch, List.map_append, List.prod_append, ← hoth,
    TypeDensity.prod_lawCoef_optional_child _ _ ?_]
  all_goals first | rfl | exact fun h1 ↦ hv (1, _) (by rw [hch]; simp [h1])
