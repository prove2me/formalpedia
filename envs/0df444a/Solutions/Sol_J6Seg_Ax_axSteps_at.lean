/-- A bound on all entries passes to the rows (the padding is `0`). -/
theorem AB_lineAt {X : ℤ} (hX : 0 ≤ X) {L : List GI} (h : KR.AB X L) (m post b c : ℕ) :
    KR.AB X (lineAt m post L b c) := by
  intro z hz
  simp only [lineAt, List.mem_map, List.mem_range] at hz
  obtain ⟨a, _, rfl⟩ := hz
  rcases lt_or_ge (b * (m * post) + a * post + c) L.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact h _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ hi, default_GI]; simp [hX]

theorem bnd_of_GB {w : ℕ} {L : List GI} (h : GB w L) : ∀ u ∈ gflat L, zsz u ≤ w :=
  GB.bnd h

