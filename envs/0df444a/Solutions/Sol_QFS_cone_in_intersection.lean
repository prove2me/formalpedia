variable {d : ℕ}

/-- **Lemma 2.7** of Bux–Kassmann–Schulze. For each `x` and each `ξ ∈ A_h(x)`,
`V_{h√d}[ξ] ⊆ V_{(h/2)√d}[x] ⊆ V[ξ]`.

The paper states this for a cone `V`; its proof uses nothing about `V`, and we
record the general version. -/
theorem solution (V : Set (EuclideanSpace ℝ (Fin d))) {h : ℝ} (hh : 0 ≤ h)
    (x : EuclideanSpace ℝ (Fin d)) {ξ : EuclideanSpace ℝ (Fin d)} (hξ : ξ ∈ QFS.cube h x) :
    QFS.shift (QFS.shrink V (h * Real.sqrt d)) ξ ⊆ QFS.shift (QFS.shrink V (h / 2 * Real.sqrt d)) x ∧
      QFS.shift (QFS.shrink V (h / 2 * Real.sqrt d)) x ⊆ QFS.shift V ξ := by
  have hℓ : (0 : ℝ) ≤ h / 2 * Real.sqrt d := by positivity
  have hnorm : ‖ξ - x‖ ≤ h / 2 * Real.sqrt d := by
    have := QFS.cube_subset_closedBall x hξ
    rwa [Metric.mem_closedBall, dist_eq_norm] at this
  have h2 : 2 * (h / 2 * Real.sqrt d) = h * Real.sqrt d := by ring
  have := QFS.shift_shrink_sandwich V hℓ x hnorm
  rwa [h2] at this
