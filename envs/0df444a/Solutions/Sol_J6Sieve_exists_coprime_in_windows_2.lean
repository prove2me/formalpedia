-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

lemma rough_odd (z n : ℕ) (hz : 2 ≤ z) (h : rough z n) : Odd n := by
  have h2 : 2 ∈ P z := mem_P.2 ⟨hz, Nat.prime_two⟩
  exact Nat.odd_iff.2 (Nat.two_dvd_ne_zero.1 (h 2 h2))

/-- **Main theorem.** -/
theorem exists_coprime_in_windows_sol_aux (d X H : ℕ) (A : Fin d → ℕ) (hA : ∀ i, A i + H ≤ X)
    (hH : sieveBound d X < H) :
    ∃ s : Fin d → ℕ, (∀ i, Odd (s i) ∧ A i < s i ∧ s i ≤ A i + H) ∧
      Pairwise (fun i j => Nat.Coprime (s i) (s j)) := by
  let A' : ℕ → ℕ := fun i => if h : i < d then A ⟨i, h⟩ else 0
  have hA' : ∀ i < d, A' i + H ≤ X := by
    intro i hi; simp only [A', dif_pos hi]; exact hA _
  obtain ⟨s, hs, hcop⟩ := greedy d X H A' hA' hH d le_rfl
  have hz : 2 ≤ zz d X := by simp only [zz]; omega
  refine ⟨fun i => s i.val, ?_, ?_⟩
  · intro i
    have h := hs i.val i.isLt
    simp only [A', dif_pos i.isLt] at h
    exact ⟨rough_odd _ _ hz h.1, h.2.1, h.2.2⟩
  · intro i j hij
    exact hcop i.val i.isLt j.val j.isLt (fun h => hij (Fin.ext h))

end J6Sieve

end

theorem solution : type_of% @J6Sieve.exists_coprime_in_windows_sol_aux := @J6Sieve.exists_coprime_in_windows_sol_aux
