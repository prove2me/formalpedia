-- title:
--   Trajectory law, randomized tests and their error probabilities, departure/transition/retained counts, and the positive geometric clock
-- statement:
--   Let $R$ be an $n\times n$ transition matrix and $x$ a state.
--
--   - **Trajectory law.** A path of $t$ transitions is $\omega=(\omega_0,\dots,\omega_t)$; its probability under $R$ from $x$ is $\Pr_{R,x}(\omega)=\mathbf 1\{\omega_0=x\}\prod_{s<t}R_{\omega_s\omega_{s+1}}$ (p. 6).
--   - **Tests.** A test with budget $m$ is a function $\varphi$ from paths of $m$ transitions to $[0,1]$, the probability of rejecting after seeing the path (internal randomness is averaged out). Its rejection probability is $\sum_\omega\Pr_{R,x}(\omega)\varphi(\omega)$ and its acceptance probability is $\sum_\omega\Pr_{R,x}(\omega)(1-\varphi(\omega))$.
--   - **Counts** of a path (p. 8): departures $N_i=\#\{s<t:\omega_s=i\}$, transitions $C_{ij}=\#\{s<t:\omega_s=i,\omega_{s+1}=j\}$, and the list of destinations of the successive departures from $i$ in chronological order ($Y_1,\dots,Y_N$ of §5.1).
--   - **Retained counts** (§5.1, §5.4): deleting the final departure from every visited state leaves the *retained* departures from $i$ — those followed later by another departure from $i$. Their number is $L_i=(N_i-1)_+$, and $D_{ij}$ counts the retained transitions $i\to j$.
--   - **Geometric clock.** $\Pr(T=t)=M^{-1}(1-M^{-1})^{t-1}$ for $t\ge1$ (a positive geometric time of mean $M$). For a function $f(t,\omega)$ of the stopping time and the path, $\mathbb E[f]=\sum_{t\ge1}\Pr(T=t)\sum_\omega\Pr_{R,x}(\omega)f(t,\omega)$, with $T$ independent of the chain; **integrability** means that the same series with $|f|$ converges. Probabilities of events are expectations of indicators.
--
--   **Formalization Note.** The expectation is a `tsum`, which is $0$ when the series diverges; every theorem that bounds an expectation also asserts integrability, so no bound holds by default.
-- source:
--   Jianhao Jia, Identity Testing of Markov Chains from a Single Trajectory, STOC 2027 submission (manuscript sha256 cf0995fc…), p. 6 (trajectories), p. 7 (the testing problem), p. 8 (counts), p. 24 §5.1 and p. 29 §5.4 (retained counts), p. 31 (the geometric time)

import Mathlib

set_option autoImplicit false

open Finset

namespace MarkovIdentityTest.Reversible

/-- Probability of the path `ω = (ω 0, …, ω t)` of `t` transitions under the transition matrix
`R` started from `x` (p. 6 / PDF 8): `1{ω 0 = x} · ∏_{s<t} R (ω s) (ω (s+1))`. -/
noncomputable def trajProb {n : ℕ} (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n) (t : ℕ)
    (ω : Fin (t + 1) → Fin n) : ℝ :=
  (if ω 0 = x then 1 else 0) * ∏ s : Fin t, R (ω s.castSucc) (ω s.succ)

/-- Rejection probability of a (randomized) test `φ` with budget `m` transitions when the
trajectory is generated by `R` from `x`: `∑_ω Pr_{R,x}(ω) φ(ω)`, where `φ(ω) ∈ [0, 1]` is the
probability that the test rejects after seeing `ω`. -/
noncomputable def rejectProb {n m : ℕ} (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n)
    (φ : (Fin (m + 1) → Fin n) → ℝ) : ℝ :=
  ∑ ω, trajProb R x m ω * φ ω

/-- Acceptance probability `∑_ω Pr_{R,x}(ω) (1 - φ(ω))` of the test `φ`. -/
noncomputable def acceptProb {n m : ℕ} (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n)
    (φ : (Fin (m + 1) → Fin n) → ℝ) : ℝ :=
  ∑ ω, trajProb R x m ω * (1 - φ ω)

/-- Departure count `Nᵢ(t) = ∑_{s<t} 1{X_s = i}` (p. 8 / PDF 10). -/
def departures {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i : Fin n) : ℕ :=
  (univ.filter fun s : Fin t => ω s.castSucc = i).card

/-- Transition count `Cᵢⱼ(t) = ∑_{s<t} 1{X_s = i, X_{s+1} = j}` (p. 8 / PDF 10). -/
def transitions {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i j : Fin n) : ℕ :=
  (univ.filter fun s : Fin t => ω s.castSucc = i ∧ ω s.succ = j).card

/-- The destinations of the successive departures from `i`, in chronological order
(`Y₁, …, Y_N` of §5.1). -/
def departureDests {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i : Fin n) : List (Fin n) :=
  ((univ.filter fun s : Fin t => ω s.castSucc = i).sort (· ≤ ·)).map fun s => ω s.succ

/-- The retained departure times from `i`: every departure from `i` except the last one
(the final departure from every visited state is deleted, §5.1 / §5.4). -/
def retainedTimes {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i : Fin n) : Finset (Fin t) :=
  univ.filter fun s : Fin t => ω s.castSucc = i ∧ ∃ s' : Fin t, s < s' ∧ ω s'.castSucc = i

/-- Retained length `Lᵢ(t) = (Nᵢ(t) - 1)₊`. -/
def retainedLength {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i : Fin n) : ℕ :=
  (retainedTimes ω i).card

/-- Retained transition count `Dᵢⱼ(t)`: transitions `i → j` among the retained departures. -/
def retainedCount {n t : ℕ} (ω : Fin (t + 1) → Fin n) (i j : Fin n) : ℕ :=
  ((retainedTimes ω i).filter fun s => ω s.succ = j).card

/-- The positive geometric law with mean `M`: `Pr(T = t) = M⁻¹ (1 - M⁻¹)^{t-1}` for `t ≥ 1`,
and `0` at `t = 0`. -/
noncomputable def geomPmf (M : ℝ) (t : ℕ) : ℝ :=
  if t = 0 then 0 else (1 / M) * (1 - 1 / M) ^ (t - 1)

/-- Expectation of `f(T, X₀, …, X_T)` where `T` is an independent positive geometric time with
mean `M` and `X` is the chain `R` started from `x`:
`∑_{t} Pr(T = t) ∑_ω Pr_{R,x}(ω) f t ω`. Only meaningful together with `GeomIntegrable`. -/
noncomputable def geomExp {n : ℕ} (M : ℝ) (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n)
    (f : (t : ℕ) → (Fin (t + 1) → Fin n) → ℝ) : ℝ :=
  ∑' t, geomPmf M t * ∑ ω, trajProb R x t ω * f t ω

/-- `f(T, X₀, …, X_T)` has finite expectation: the series of absolute values converges. -/
def GeomIntegrable {n : ℕ} (M : ℝ) (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n)
    (f : (t : ℕ) → (Fin (t + 1) → Fin n) → ℝ) : Prop :=
  Summable fun t => geomPmf M t * ∑ ω, trajProb R x t ω * |f t ω|

/-- Probability of an event of `(T, X₀, …, X_T)`. -/
noncomputable def geomProb {n : ℕ} (M : ℝ) (R : Matrix (Fin n) (Fin n) ℝ) (x : Fin n)
    (E : (t : ℕ) → (Fin (t + 1) → Fin n) → Prop) : ℝ :=
  geomExp M R x fun t ω => by classical exact if E t ω then 1 else 0

end MarkovIdentityTest.Reversible


