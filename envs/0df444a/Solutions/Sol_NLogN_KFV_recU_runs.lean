theorem valN_eq_sum (b : ℕ) : ∀ cs : List ℕ,
    valN b cs = ∑ h ∈ Finset.range cs.length, cs.getD h 0 * (2 ^ b) ^ h
  | [] => by simp [valN]
  | c :: cs => by
    rw [valN, valN_eq_sum b cs, List.length_cons, Finset.sum_range_succ']
