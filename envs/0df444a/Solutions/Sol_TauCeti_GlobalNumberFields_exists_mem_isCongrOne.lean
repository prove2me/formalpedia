/-! ### Generators congruent to one modulo a modulus -/





/-- **A generator congruent to one inside an ideal comaximal with the finite part.**  For a nonzero
ideal `D` with `D ⊔ 𝔪₀ = ⊤` there is an algebraic integer `a ∈ D` whose image in `Kˣ` is congruent
to one modulo `𝔪`.

Comaximality produces an element of `D` congruent to one modulo `𝔪₀`, and
`NumberField.exists_isTotallyPositive_sub_mem` moves it inside `D * 𝔪₀` — hence without changing
either condition — to make it nonzero and positive at every real place. -/
theorem solution {𝔪 : _root_.TauCeti.GlobalNumberFields.Modulus K} {D : _root_.Ideal (𝓞 K)} (hD : D ≠ ⊥)
    (hcop : D ⊔ 𝔪.finitePart = ⊤) :
    ∃ (a : 𝓞 K) (x : Kˣ), a ∈ D ∧ (x : K) = a ∧ _root_.TauCeti.GlobalNumberFields.IsCongrOne 𝔪 x := by
  obtain ⟨u, hu, t, ht, hut⟩ :=
    Submodule.mem_sup.mp (hcop ▸ _root_.Submodule.mem_top : (1 : 𝓞 K) ∈ D ⊔ 𝔪.finitePart)
  have hH : D * 𝔪.finitePart ≠ ⊥ := fun h ↦
    (Ideal.mul_eq_bot.mp h).elim hD 𝔪.finitePart_ne_bot
  obtain ⟨b, hb0, hbu, hbpos⟩ := _root_.NumberField.exists_isTotallyPositive_sub_mem hH u
  have hbD : b ∈ D := by
    simpa only [_root_.sub_add_cancel] using D.add_mem (_root_.Ideal.mul_le_left hbu) hu
  have hb1 : b - 1 ∈ 𝔪.finitePart := by
    have hu1 : u - 1 ∈ 𝔪.finitePart := by
      rw [← hut, _root_.sub_add_eq_sub_sub, _root_.sub_self, _root_.zero_sub]
      exact 𝔪.finitePart.neg_mem ht
    simpa only [_root_.sub_add_sub_cancel] using
      𝔪.finitePart.add_mem (_root_.Ideal.mul_le_right hbu) hu1
  exact ⟨b, _root_.Units.mk0 (b : K) (RingOfIntegers.coe_ne_zero_iff.mpr hb0), hbD, _root_.rfl,
    _root_.TauCeti.GlobalNumberFields.isCongrOne_of_sub_one_mem _root_.rfl hb1 fun w _ ↦ isTotallyPositive_iff.mp hbpos w.1 w.2⟩

