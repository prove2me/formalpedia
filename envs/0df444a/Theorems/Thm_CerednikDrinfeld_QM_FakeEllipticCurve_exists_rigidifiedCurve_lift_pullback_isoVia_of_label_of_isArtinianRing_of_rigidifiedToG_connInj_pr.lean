          ∃ (hS : IsNilpotent (algebraMap 𝒪 S π)) (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp χC)
            (hS₀ : IsNilpotent (algebraMap 𝒪 S₀ π))
            (hψS₀ : (p.restrictScalars 𝒪).comp ψS = (IsScalarTower.toAlgHom 𝒪 C S₀).comp χC)
            (u : FakeEllipticCurve.WithFullLevel Λ N n S₀)
            (ρ : FakeEllipticCurve.Rigidification r π A₀ ((p.restrictScalars 𝒪).comp ψS) u.1),
            ptR S₀ ((p.restrictScalars 𝒪).comp ψS) hψS₀ u ρ = x₀ ∧
            (∃ Pn : u.1.FullLevel n, FakeEllipticCurve.Rigidification.IsNormLevelTransport Fr θ₀ κ β₀ Φ ι coord P₀ ρ Pn ∧
