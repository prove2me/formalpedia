/-! # Locality and linearity of the explicit first-variation operators (ATLAS-IV-03)

* Locality (`*_congr`): on an open set `V`, the operators only depend on the background `(g, ginv, F)`
  and the perturbation `(h, f)` on `V` (every coordinate derivative is local, `pd_congr_of_eqOn`).
* Linearity on the admissible class (open `U`, background and perturbations `C^∞` on `U`, order `∞`):
  `linEinstein`, `linMaxwell`, `linFaraday` of `lcomb c₁ h₁ c₂ h₂`, `lcomb c₁ f₁ c₂ f₂` are the same real
  linear combinations of the values (`*_lcomb`); additivity (`*_add`) and real homogeneity (`*_smul`) are
  the special cases. Perturbations are arbitrary `C^∞` functions of all four coordinates (no symmetry,
  stationarity or analyticity assumption). Stated for the physical dimension `4`. -/

open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell

namespace ExactVacuumAtlas.Variation

/-! ## Locality -/

section congr

variable {n : ℕ} {V : Set (Pt n)} {g g' ginv ginv' h h' : Metric n} {F F' f f' : TwoForm n}

theorem chrVar_congr (hV : IsOpen V) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V) (hh : ∀ i j, Set.EqOn (h i j) (h' i j) V)
    (a b c : Fin n) : Set.EqOn (chrVar g ginv h a b c) (chrVar g' ginv' h' a b c) V := by
  intro y hy
  have e1 : ∀ i j, ginv i j y = ginv' i j y := fun i j => hgi i j hy
  have e2 : ∀ i j, h i j y = h' i j y := fun i j => hh i j hy
  have e3 : ∀ i j k, pd k (g i j) y = pd k (g' i j) y := fun i j k => pd_congr_of_eqOn hV hy (hg i j) k
  have e4 : ∀ i j k, pd k (h i j) y = pd k (h' i j) y := fun i j k => pd_congr_of_eqOn hV hy (hh i j) k
  simp only [chrVar, invVar, e1, e2, e3, e4]

theorem ricciVar_congr (hV : IsOpen V) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V) (hh : ∀ i j, Set.EqOn (h i j) (h' i j) V)
    (b d : Fin n) : Set.EqOn (ricciVar g ginv h b d) (ricciVar g' ginv' h' b d) V := by
  intro y hy
  have e1 : ∀ a b c, chrVar g ginv h a b c y = chrVar g' ginv' h' a b c y :=
    fun a b c => chrVar_congr hV hg hgi hh a b c hy
  have e2 : ∀ i a b c, pd i (chrVar g ginv h a b c) y = pd i (chrVar g' ginv' h' a b c) y :=
    fun i a b c => pd_congr_of_eqOn hV hy (chrVar_congr hV hg hgi hh a b c) i
  have e3 : ∀ a b c, christoffel g ginv a b c y = christoffel g' ginv' a b c y :=
    fun a b c => christoffel_congr_of_eqOn hV hg hgi a b c hy
  simp only [ricciVar, ricciLin, e1, e2, e3]

theorem ricciScalar_congr (hV : IsOpen V) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V) :
    Set.EqOn (ricciScalar g ginv) (ricciScalar g' ginv') V := by
  intro y hy
  have e1 : ∀ i j, ginv i j y = ginv' i j y := fun i j => hgi i j hy
  have e2 : ∀ i j, ricciOf g ginv i j y = ricciOf g' ginv' i j y :=
    fun i j => ricciOf_congr_of_eqOn hV hg hgi hy i j
  simp only [ricciScalar, e1, e2]

theorem scalarVar_congr (hV : IsOpen V) (hg : ∀ i j, Set.EqOn (g i j) (g' i j) V)
    (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V) (hh : ∀ i j, Set.EqOn (h i j) (h' i j) V) :
    Set.EqOn (scalarVar g ginv h) (scalarVar g' ginv' h') V := by
  intro y hy
  have e1 : ∀ i j, ginv i j y = ginv' i j y := fun i j => hgi i j hy
  have e2 : ∀ i j, h i j y = h' i j y := fun i j => hh i j hy
  have e3 : ∀ i j, ricciOf g ginv i j y = ricciOf g' ginv' i j y :=
    fun i j => ricciOf_congr_of_eqOn hV hg hgi hy i j
  have e4 : ∀ i j, ricciVar g ginv h i j y = ricciVar g' ginv' h' i j y :=
    fun i j => ricciVar_congr hV hg hgi hh i j hy
  simp only [scalarVar, invVar, e1, e2, e3, e4]

theorem raise2_congr (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V)
    (hF : ∀ i j, Set.EqOn (F i j) (F' i j) V) (a b : Fin n) :
    Set.EqOn (raise2 ginv F a b) (raise2 ginv' F' a b) V := by
  intro y hy
  have e1 : ∀ i j, ginv i j y = ginv' i j y := fun i j => hgi i j hy
  have e2 : ∀ i j, F i j y = F' i j y := fun i j => hF i j hy
  simp only [raise2, e1, e2]

theorem raise2Var_congr (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) V)
    (hh : ∀ i j, Set.EqOn (h i j) (h' i j) V) (hF : ∀ i j, Set.EqOn (F i j) (F' i j) V)
    (hf : ∀ i j, Set.EqOn (f i j) (f' i j) V) (a b : Fin n) :
    Set.EqOn (raise2Var ginv h F f a b) (raise2Var ginv' h' F' f' a b) V := by
  intro y hy
  have e1 : ∀ i j, ginv i j y = ginv' i j y := fun i j => hgi i j hy
  have e2 : ∀ i j, h i j y = h' i j y := fun i j => hh i j hy
  have e3 : ∀ i j, F i j y = F' i j y := fun i j => hF i j hy
  have e4 : ∀ i j, f i j y = f' i j y := fun i j => hf i j hy
  simp only [raise2Var, invVar, e1, e2, e3, e4]

end congr

