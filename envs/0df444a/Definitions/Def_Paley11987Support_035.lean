def selectedEquiv : Fin 11987 ≃ Vertex11987 :=
  Fintype.equivOfCardEq (by rw [Fintype.card_fin,vertex11987_card])



def tournamentOfCore {V : Type*} [Fintype V] [DecidableEq V] {k : ℕ}
    (G : Core V) (e : Fin k ≃ V) : Tournament k where
  Adj i j := G.Adj (e i) (e j)
  loopless i := G.irreflexive (e i)
  edge_compl := by
    intro i j hij
    exact ⟨G.asymmetric _ _, fun hn => (G.oriented _ _ (e.injective.ne hij)).resolve_right hn⟩









def selectedTournament : Tournament 11987 := tournamentOfCore core11987 selectedEquiv









