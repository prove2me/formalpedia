/-! ## The next power of two -/

theorem gI_eq (m : ℕ) : ∀ k, gI m k = 2 ^ min k (Nat.clog 2 m)
  | 0 => by simp [gI]
  | k + 1 => by
    rw [gI, Function.iterate_succ_apply', ← gI, gI_eq m k]
    by_cases hk : k < Nat.clog 2 m
    · have h1 : 2 ^ k < m := by
        by_contra h
        have := (Nat.clog_le_iff_le_pow (by norm_num : 1 < 2)).2 (not_lt.1 h)
        omega
      rw [min_eq_left hk.le, if_pos h1, min_eq_left (by omega), pow_succ]; ring
    · have h1 : m ≤ 2 ^ Nat.clog 2 m := Nat.le_pow_clog (by norm_num) m
      rw [min_eq_right (by omega), if_neg (by omega), min_eq_right (by omega)]

theorem clog_le_self (m : ℕ) : Nat.clog 2 m ≤ m :=
  (Nat.clog_le_iff_le_pow (by norm_num : 1 < 2)).2 (Nat.lt_two_pow_self).le

theorem gI_self (m : ℕ) : gI m m = 2 ^ Nat.clog 2 m := by
  rw [gI_eq, min_eq_right (clog_le_self m)]

theorem gI_le (m k : ℕ) : gI m k ≤ 2 ^ Nat.clog 2 m := by
  rw [gI_eq]; exact Nat.pow_le_pow_right (by norm_num) (min_le_right _ _)

theorem cgP_sp_sol_aux (s0 : IState HS) (F : Fin HS → List ℤ) {R Y : Fin HS} (hR5 : R.val < 56)
    (hY5 : Y.val < 56) (hRY : R ≠ Y) (hY43 : Y ≠ 43) (hR43 : R ≠ 43) (h43 : F 43 = []) {m A : ℕ}
    {LR : List ℤ} (hFR : F R = (m : ℤ) :: LR) (hmA : 2 ^ Nat.clog 2 m ≤ 2 ^ A) (hA : 2 ≤ A) :
    Sp (cgP R Y) (encK s0 F) (encK s0 (update F Y (((2 ^ Nat.clog 2 m : ℕ) : ℤ) :: F Y)))
      (2 * uC A DD + (m + 1) * ((2 * (10 * uC A DD) + 200 * (A * DD + 1 + 1)) + uC A DD)) := by
  have hm : m ≤ 2 ^ A := le_trans (Nat.le_pow_clog (by norm_num) m) hmA
  have h1 := lit_sp s0 F (i := Y) hY5 1 (by simp; exact one_le_pow₀ (by norm_num)) (by decide) hA
