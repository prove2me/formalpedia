section
-- Source module: Solutions.R6IL2CKeyRun
/-!
# Round six, compact controls (I2C): the run of the key program

**`keyProgC_fsp`**: `keyProgC` pushes `keyC l K ρ G n L k` on `rK` (all other registers restored).
The pushes are `keyPush_fsp` (part A), the eleven updates `keyMid_fsp` (part B); here the index
updates and pops (`keyTail_fsp`) and the assembly.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-- **The key program.** -/
theorem keyProgC_fsp {l : Lay} {K ρ G n L M Bb : ℕ} (hV : KVal l K ρ G n L M Bb)
    {s : IState HS} {G0 : Fin HS → List ℤ} (hc : G0 rC = []) {k : ℕ} (hk : k < M)
    {lm : List ℤ} (hm : G0 rm = (k : ℤ) :: lm) (hE : KEnv (encK s G0) l K ρ G n) :
    FSp keyProgC (encK s G0)
      (encK s (Function.update G0 rK ((keyC l K ρ G n L k : ℤ) :: G0 rK))) (cKeyC Bb n) := by
  have hx : gc l.QL l.sX k < l.QL := gc_lt hV.ql1 _
  have ht : gc l.QC l.sT k < l.QC := gc_lt hV.qc1 _
  have hu : gc l.QC l.sU k < l.QC := gc_lt hV.qc1 _
  have hy : gc l.QL l.sY k < l.QL := gc_lt hV.ql1 _
  obtain ⟨t4, u2, y4, hPsi, ht4, hu2, hy5, hmid⟩ :=
    keyMid_fsp hV hc hE hx ht hu hy
  have hT := keyTail_fsp hV hk hm hE hx ht4 hu2 hy5
  have hkey : keyC l K ρ G n L k =
      sc l.QC l.sT t4 (sc l.QC l.sU u2 (sc l.QL l.sY (Tl K ρ n (gc l.QL l.sX k) y4) k)) := by
    unfold keyC Lay.stepP
    show l.set (TlS K ρ n (gc l.QL l.sX k) (Psi K ρ G n L (gc l.QL l.sX k)
      ⟨gc l.QC l.sT k, gc l.QC l.sU k, gc l.QL l.sY k⟩)) k = _
    rw [hPsi]; rfl
  rw [hkey]
  refine (keyPush_fsp hV hk hm hE (hmid hT)).mono ?_
  simp only [cKeyC, cPush, cMid, cTail]
  clear * -
  omega

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CCorrU
/-!
# Round six, compact controls (I2C): the register-driven correction

`corrV kp` is `corrG kp B M A` with `B, M, A` read from the registers `1, 2, 3`;
`corrVC = corrV keyProgC`; `corrLC eB eM eA` pushes the three parameters and runs it.

**`corrLC_runs`**: on `flR recs M` (layout in the registers, `KEnv`), `corrLC` computes
`flR (recs ∘ corrC) M`, where `corrC = stepP (Sfw ∘ TlS)` inverts the key `keyC`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.IL2C

open NLogN NLogN.KFL NLogN.KIL NLogN.KFD NLogN.KFW NLogN.KFX IntMul RS AModel

/-! ## The uniform program -/

theorem σV_none (b m a : ℤ) {i : Fin HS} (h : 4 ≤ i.val) : σV b m a i = none := by
  simp only [σV]
  split_ifs <;> subst_vars <;> first | rfl | (exfalso; revert h; decide)

theorem sclean_σV (b m a : ℤ) : SClean (σV b m a) := by
  intro i hi
  have : i.val ≤ 3 := by
    by_contra hc
    rw [σV_none b m a (by omega)] at hi
    simp at hi
  exact notMem_zX (by omega)

theorem corrV_sub (kp : RS) (B M A : ℕ) :
    RS.sub (σV (B : ℤ) (M : ℤ) (A : ℤ)) (corrV kp) =
      corrG (RS.sub (σV (B : ℤ) (M : ℤ) (A : ℤ)) kp) B M A := by
  simp only [corrV, p1ProgV, p1BV, brBV, badBV, goodBV, radixProgV, passBV, entLoopV, entBV,
    bucketV, p3ProgV, p3BV, NLogN.mvK, RS.sub, Ex.sub]
  simp only [corrG, p1ProgG, p1BG, brB, badB, goodB, radixProg, passB, entLoop, entB,
    bucket, p3Prog, p3B, NLogN.mvK]
  rfl

theorem touch_keyProgC : ∀ i ∈ touch keyProgC, 4 ≤ i.val := by decide +kernel

theorem keyProgC_sub (b m a : ℤ) : RS.sub (σV b m a) keyProgC = keyProgC :=
  RS.sub_id _ _ (fun i hi => σV_none b m a (touch_keyProgC i hi))

theorem writes_corrVC : ∀ i ∈ corrVC.writes, i.val = 0 ∨ 4 ≤ i.val := by decide +kernel

theorem noW_corrVC (b m a : ℤ) : NoW (σV b m a) corrVC := by
  intro i hi
  rcases writes_corrVC i hi with h | h
  · have : i = 0 := Fin.ext h
    subst this; rfl
  · exact σV_none _ _ _ h

theorem fok_corrVC : fok corrVC = true := by decide +kernel

theorem c1_keyProgC : c1 ∉ keyProgC.writes := by decide +kernel

/-! ## The inverse of the key -/

namespace Lay

variable {l : Lay} {K ρ G n L : ℕ}

theorem stepP_congr {F F' : ℕ → CS → CS} (h : ∀ x c, l.BoxL c → F x c = F' x c) (hok : l.OK)
    (m : ℕ) : l.stepP F m = l.stepP F' m := by
  unfold stepP; rw [h _ _ (box_cs hok m)]

theorem box_TlS' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K) (hL : ρ + n * K ≤ L)
    {c : CS} (hc : l.BoxL c) (x : ℕ) : l.BoxL (TlS K ρ n x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢
  exact ⟨hc.1, hc.2.1, (Tl_spec hK hL x hc.2.2).1⟩

theorem box_Psi' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (x : ℕ) :
    l.BoxL (Psi K ρ G n L x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢; exact box_Psi (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x hc

theorem box_Sfw' (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) {c : CS} (hc : l.BoxL c) (x : ℕ) :
    l.BoxL (Sfw K ρ G n L x c) := by
  rw [boxL_iff hQC hQL] at hc ⊢; exact box_Sfw (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x hc

theorem TlS_TlS (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K) (hL : ρ + n * K ≤ L) {c : CS} (hc : l.BoxL c)
    (x : ℕ) : TlS K ρ n x (TlS K ρ n x c) = c := by
  obtain ⟨t, u, y⟩ := c
  have hy : y < 2 ^ L := by rw [← hQL]; exact hc.2.2
  simp only [TlS]; rw [Tl_Tl hK hL x hy]

end Lay

section Inv

variable {l : Lay} {K ρ G n L : ℕ}

theorem keyC_corrC (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) (m : ℕ) : keyC l K ρ G n L (corrC l K ρ G n L m) = m := by
  unfold keyC corrC
  rw [Lay.stepP_stepP h (fun x c hc => Lay.box_TlS' hQC hQL hK hL (Lay.box_Psi' hQC hQL hc x) x)
    (fun x c hc => Lay.box_Sfw' hQC hQL (Lay.box_TlS' hQC hQL hK hL hc x) x)]
  rw [Lay.stepP_congr (F' := fun _ c => c) (fun x c hc => by
    have hb := Lay.box_TlS' hQC hQL hK hL hc x
    rw [Psi_Sfw (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x ((Lay.boxL_iff hQC hQL _).1 hb), Lay.TlS_TlS hQL hK hL hc]) h]
  exact Lay.stepP_id h m

theorem corrC_keyC (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) (m : ℕ) : corrC l K ρ G n L (keyC l K ρ G n L m) = m := by
  unfold keyC corrC
  rw [Lay.stepP_stepP h (fun x c hc => Lay.box_Sfw' hQC hQL (Lay.box_TlS' hQC hQL hK hL hc x) x)
    (fun x c hc => Lay.box_TlS' hQC hQL hK hL (Lay.box_Psi' hQC hQL hc x) x)]
  rw [Lay.stepP_congr (F' := fun _ c => c) (fun x c hc => by
    have hb := Lay.box_Psi' (K := K) (ρ := ρ) hQC hQL hc x
    rw [Lay.TlS_TlS hQL hK hL hb, Sfw_Psi (K := K) (ρ := ρ) (G := G) (n := n) (L := L) x ((Lay.boxL_iff hQC hQL _).1 hc)]) h]
  exact Lay.stepP_id h m

theorem keyC_lt (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) {m : ℕ} (hm : m < l.M) : keyC l K ρ G n L m < l.M :=
  Lay.stepP_lt h (fun x c hc => Lay.box_TlS' hQC hQL hK hL (Lay.box_Psi' hQC hQL hc x) x) hm

theorem corrC_lt (h : l.OK) (hQC : l.QC = Qc G n) (hQL : l.QL = 2 ^ L) (hK : 1 ≤ K)
    (hL : ρ + n * K ≤ L) {m : ℕ} (hm : m < l.M) : corrC l K ρ G n L m < l.M :=
  Lay.stepP_lt h (fun x c hc => Lay.box_Sfw' hQC hQL (Lay.box_TlS' hQC hQL hK hL hc x) x) hm

end Inv

/-! ## The run -/

set_option maxHeartbeats 4000000 in
theorem corrLC_runs_sol_aux {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}
    {l : Lay} {K ρ G n L B : ℕ} (hB : 1 ≤ B)
    (hV : KVal l K ρ G n L l.M (zsz ((l.M * B : ℕ) : ℤ) + 3))
    (t : IState HS) (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = B)
    (hbits : ∀ m, Bnd 1 (recs m)) (R0 : List Item) (h0 : t.G 0 = ints (flR recs l.M) ++ R0)
    (hE : KEnv t l K ρ G n) {eB eM eA : Ex HS} {Bb : ℕ}
    (hsz : ((corrPlC eB eM eA).map fun p => p.2.size + 1).sum ≤ 30)
    (n1 : NoLow eB) (n2 : NoLow eM) (n3 : NoLow eA)
    (E1 : ESp eB t Bb (B : ℤ)) (E2 : ESp eM t Bb (l.M : ℤ))
    (E3 : ESp eA t Bb (zsz ((l.M * B : ℕ) : ℤ) : ℤ)) :
    IRuns I iprog (corrLC eB eM eA) t
      (t.upd 0 (ints (flR (fun d => recs (corrC l K ρ G n L d)) l.M) ++ R0))
      (30 * 10 ^ 7 * (Bb + 2) ^ 2 + 1 +
        400 * cCorrG (cKeyC (zsz ((l.M * B : ℕ) : ℤ) + 3) n) B l.M (zsz ((l.M * B : ℕ) : ℤ))
          (nMv (keyC l K ρ G n L) l.M) (zsz ((l.M * B : ℕ) : ℤ) + 3) +
        (3 * (2 * Bb + 2) + 1)) := by
  set M := l.M with hMd
  set A := zsz ((M * B : ℕ) : ℤ) with hAd
  set Bb' := zsz ((M * B : ℕ) : ℤ) + 3 with hBb'
  have hOK := hV.ok
  have hQC := hV.qc
  have hQL := hV.ql
  have hM1 : 1 ≤ M := hOK.pM
  set pl := corrPlC eB eM eA
  have hEp : ∀ p ∈ pl, ∃ v, ESp p.2 t Bb v := by
    intro p hp
    simp only [pl, corrPlC, List.mem_cons, List.not_mem_nil, or_false] at hp
    rcases hp with rfl | rfl | rfl
    exacts [⟨_, E1⟩, ⟨_, E2⟩, ⟨_, E3⟩]
  have hpl : PushOK t Bb pl := by
    refine pushOK_of (by
      intro p hp; simp only [pl, corrPlC, List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl | rfl <;> (dsimp only; decide)) ?_ hEp
    intro p hp r hr hm
    simp only [pl, corrPlC, List.mem_cons, List.not_mem_nil, or_false] at hp
    simp only [pl, corrPlC, List.map_cons, List.map_nil, List.mem_cons, List.not_mem_nil,
      or_false] at hm
    have : 13 ≤ r.val := by
      rcases hp with rfl | rfl | rfl
      · exact n1 r hr
      · exact n2 r hr
      · exact n3 r hr
    rcases hm with rfl | rfl | rfl <;> revert this <;> decide
  have ev : evalP t pl = [(1, (B : ℤ)), (2, (M : ℤ)), (3, (A : ℤ))] := by
    simp only [evalP, pl, corrPlC, List.map_cons, List.map_nil, E1.ev, E2.ev, E3.ev]
  have hnd : (pl.map Prod.fst).Nodup := by
    simp only [pl, corrPlC, List.map_cons, List.map_nil]; decide
  set u := pushSt t (evalP t pl)
  have hu0 : u.G 0 = ints (flR recs M) ++ R0 := by
    rw [pushSt_G_of_not_mem _ _ _ (by
      rw [evalP_fst]; simp only [pl, corrPlC, List.map_cons, List.map_nil]; decide), h0]
  -- the key program on the background `u.upd 0 R0`
  have hEu : ∀ r ∈ kEnvRegs, (u.upd 0 R0).G r = t.G r := by
    intro r hr
    have hr0 : r ≠ 0 := by
      simp only [kEnvRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    have hr1 : r ∉ (evalP t pl).map Prod.fst := by
      rw [evalP_fst]
      simp only [kEnvRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
      simp only [pl, corrPlC, List.map_cons, List.map_nil]
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    simp only [IState.upd_G, if_neg hr0]
    exact pushSt_G_of_not_mem _ _ _ hr1
  have hkp : KeyOK keyProgC (u.upd 0 R0) (keyC l K ρ G n L) M (cKeyC Bb' n) := by
    intro G0 k lm hc hG0 hk hm
    refine keyProgC_fsp hV hc hk hm (hE.congr ?_)
    intro r hr
    rw [encK_G, hG0 r hr, hEu r hr]; rfl
  have S := corrG_fsp hB hM1 (corrC_keyC hOK hQC hQL hV.hK hV.hL)
    (keyC_corrC hOK hQC hQL hV.hK hV.hL) (fun m hm => keyC_lt hOK hQC hQL hV.hK hV.hL hm)
    (fun m hm => corrC_lt hOK hQC hQL hV.hK hV.hL hm) c1_keyProgC recs hlen hbits (u.upd 0 R0) hkp
  have e0 : encK (u.upd 0 R0) (Function.update (fun _ => []) 0 (flR recs M)) = u := by
    rw [← encK_upd, encK_nil, IState.upd_G, if_pos rfl, IState.upd_upd_same, ← hu0,
      IState.upd_self]
  have e2 : encK (u.upd 0 R0) (Function.update (fun _ => []) 0
      (flR (fun d => recs (corrC l K ρ G n L d)) M)) =
      u.upd 0 (ints (flR (fun d => recs (corrC l K ρ G n L d)) M) ++ R0) := by
    rw [← encK_upd, encK_nil, IState.upd_G, if_pos rfl, IState.upd_upd_same]
  rw [e0, e2] at S
  set σ := σV (B : ℤ) (M : ℤ) (A : ℤ)
  have hag : Agree σ u := by
    refine agree_pushSt t _ (by rw [evalP_fst]; exact hnd) (fun i v hv => ?_)
    rw [ev]
    simp only [σ, σV] at hv
    split_ifs at hv <;> subst_vars <;> cases hv <;> simp
  have hO : HRef (corrG keyProgC B M A) (RS.sub σ corrVC) 0 := by
    rw [corrVC, corrV_sub, keyProgC_sub]; exact HRef.refl _
  have SU := FSp.uni (sclean_σV _ _ _) (noW_corrVC _ _ _) hO hag S
  have W := KFD.IRuns.withPushI (I := I) (iprog := iprog) pl (fcode corrVC) t Bb hpl
    (pushVals_le hEp) (by simp only [pl, corrPlC, List.map_cons, List.map_nil]; decide)
    (flR (fun d => recs (corrC l K ρ G n L d)) M) R0 _ (SU.irun fok_corrVC)
  refine W.mono ?_
  have hpc := pushCost_le_size Bb pl 30 hsz
  have hl3 : pl.length = 3 := rfl
  rw [hl3]
  simp only [hBb', hAd] at hpc ⊢
  omega

end IntMul.Kappa.R6.IL2C

end

theorem solution : type_of% @IntMul.Kappa.R6.IL2C.corrLC_runs_sol_aux := @IntMul.Kappa.R6.IL2C.corrLC_runs_sol_aux
