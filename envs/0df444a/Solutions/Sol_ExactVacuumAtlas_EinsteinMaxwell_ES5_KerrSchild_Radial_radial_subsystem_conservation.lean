section R05Seg2
/-! # VII-02 (F2a): paper-gauge dictionary for the VI equal-spin radial functions

Real functions `f, m, N, w, p, a` of the VI radial variable `R` (the paper's squared radius;
no areal-coordinate change is made). On an open set `I` they are `C^∞` and `f, m, N` vanish
nowhere (`PaperData`, regularity and non-vanishing only — no field equation, no conservation
law, no sign). The dictionary to the VI data `ESData I B D A H W Φ Ψ` is

  `B = f, D = m/(4 f N), A = m/f, H = N/m, W = w, Φ = p, Ψ = a`,

and the derived functions are `e = p' + w a'`, `F = f/N`, `q = (N/f) e`, `K = N²/(f m)`,
`ℓ = K w' - 4 q a`, `G = a' p'' - p' a''`. All derivative lemmas below are genuine `HasDerivAt`
statements at points of `I`, obtained from `hasDerivAt_of_cd` / `cd_deriv` and the product,
quotient and power rules. -/

open scoped ContDiff
open ExactVacuumAtlas.EinsteinMaxwell.ES5

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial

variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}

namespace PaperData

theorem df (hP : PaperData I f m N w p a) (hr : r ∈ I) : HasDerivAt f (deriv f r) r :=
  hasDerivAt_of_cd hP.isOpen hP.cf hr
theorem dm (hP : PaperData I f m N w p a) (hr : r ∈ I) : HasDerivAt m (deriv m r) r :=
  hasDerivAt_of_cd hP.isOpen hP.cm hr
theorem dN (hP : PaperData I f m N w p a) (hr : r ∈ I) : HasDerivAt N (deriv N r) r :=
  hasDerivAt_of_cd hP.isOpen hP.cN hr
theorem dw (hP : PaperData I f m N w p a) (hr : r ∈ I) : HasDerivAt w (deriv w r) r :=
  hasDerivAt_of_cd hP.isOpen hP.cw hr

theorem da (hP : PaperData I f m N w p a) (hr : r ∈ I) : HasDerivAt a (deriv a r) r :=
  hasDerivAt_of_cd hP.isOpen hP.ca hr
theorem d2w (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv w) (deriv (deriv w) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.cw) hr
theorem d2p (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv p) (deriv (deriv p) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.cp) hr
theorem d2a (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (deriv a) (deriv (deriv a) r) r :=
  hasDerivAt_of_cd hP.isOpen (cd_deriv hP.isOpen hP.ca) hr

theorem n4fN (hP : PaperData I f m N w p a) (hr : r ∈ I) : 4 * f r * N r ≠ 0 :=
  mul_ne_zero (mul_ne_zero four_ne_zero (hP.nf r hr)) (hP.nN r hr)

end PaperData

/-! ## Genuine derivatives of the dictionary and derived functions at points of `I` -/

theorem hasDerivAt_Dfun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (Dfun f m N) ((deriv m r * (4 * f r * N r) -
      m r * (4 * deriv f r * N r + 4 * f r * deriv N r)) / (4 * f r * N r) ^ 2) r :=
  (hP.dm hr).div (((hP.df hr).const_mul 4).mul (hP.dN hr)) (hP.n4fN hr)

theorem hasDerivAt_Afun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (Afun f m) ((deriv m r * f r - m r * deriv f r) / f r ^ 2) r :=
  (hP.dm hr).div (hP.df hr) (hP.nf r hr)

theorem hasDerivAt_Hfun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (Hfun m N) ((deriv N r * m r - N r * deriv m r) / m r ^ 2) r :=
  (hP.dN hr).div (hP.dm hr) (hP.nm r hr)

theorem hasDerivAt_Kfun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (Kfun f m N) ((2 * N r * deriv N r * (f r * m r) -
      N r ^ 2 * (deriv f r * m r + f r * deriv m r)) / (f r * m r) ^ 2) r :=
  (((hP.dN hr).pow 2).div ((hP.df hr).mul (hP.dm hr))
    (mul_ne_zero (hP.nf r hr) (hP.nm r hr))).congr_deriv (by norm_num)

/-- `q' = (N/f)' e + (N/f) e'` with `e' = p'' + w' a' + w a''`. -/
theorem hasDerivAt_qFun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (qFun f N w p a) ((deriv N r * f r - N r * deriv f r) / f r ^ 2 *
      (deriv p r + w r * deriv a r) + N r / f r *
      (deriv (deriv p) r + (deriv w r * deriv a r + w r * deriv (deriv a) r))) r :=
  ((hP.dN hr).div (hP.df hr) (hP.nf r hr)).mul
    ((hP.d2p hr).add ((hP.dw hr).mul (hP.d2a hr)))

/-- `ℓ' = K' w' + K w'' - 4 (q' a + q a')`. -/
theorem hasDerivAt_ellFun (hP : PaperData I f m N w p a) (hr : r ∈ I) :
    HasDerivAt (ellFun f m N w p a)
      ((2 * N r * deriv N r * (f r * m r) - N r ^ 2 * (deriv f r * m r + f r * deriv m r)) /
          (f r * m r) ^ 2 * deriv w r + Kfun f m N r * deriv (deriv w) r -
        (4 * ((deriv N r * f r - N r * deriv f r) / f r ^ 2 * (deriv p r + w r * deriv a r) +
            N r / f r * (deriv (deriv p) r + (deriv w r * deriv a r +
              w r * deriv (deriv a) r))) * a r + 4 * qFun f N w p a r * deriv a r)) r :=
  ((hasDerivAt_Kfun hP hr).mul (hP.d2w hr)).sub
    (((hasDerivAt_qFun hP hr).const_mul 4).mul (hP.da hr))

end ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
end R05Seg2

