theorem NLogN.KFM.gmulP_kTable {E : ℕ} (ext : Fin E → IStmt HS (7 + E)) {I : List Sym} (w Δ : ℕ)
    (s : IState HS) (zs ts : List GI) (R0 RW LR : List Item) (hlen : ts.length = zs.length)
    (h0 : s.G 0 = ints (gflat zs) ++ R0) (hW : s.G pW = ints (gflat ts) ++ RW)
    (hR : s.G pR = .int (2 ^ Δ) :: LR) (hz : NLogN.KFB.GB w zs) (ht : NLogN.KFB.GB w ts) :
    IRuns I (kTable ext) (gmulP (pMul E) zs.length) s
      ((s.upd 0 (ints (gflat (List.zipWith (gmulT Δ) zs ts)) ++ R0)).upd pW RW)
