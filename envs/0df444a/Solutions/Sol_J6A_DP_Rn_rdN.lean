theorem small_le8 {W : ℕ} (hW : 8 ≤ 2 ^ W) {a : ℕ} (ha : a ≤ 8) : |((a : ℕ) : ℤ)| ≤ 2 ^ W := by
  rw [abs_of_nonneg (by positivity)]
  have : ((a : ℕ) : ℤ) ≤ 8 := by exact_mod_cast ha
  have h8 : (8 : ℤ) ≤ 2 ^ W := by exact_mod_cast hW
  linarith

