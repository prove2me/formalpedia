  have hes : ∀ (k : T) (x : M), e.symm (k ⊗ₜ[R] x) = k ⊗ₜ[S] ((1 : S) ⊗ₜ[R] x) := fun k x =>
    (e.symm_apply_eq).mpr (he k x).symm
  have hinj1 : ∀ x y : M, (1 : T) ⊗ₜ[R] x = (1 : T) ⊗ₜ[R] y → x = y := by
    intro x y hxy
    have h := Module.Flat.rTensor_preserves_injective_linearMap (M := M) (Algebra.linearMap R T) hinj
    have h1 : ∀ z : M, (Algebra.linearMap R T).rTensor M ((TensorProduct.lid R M).symm z) =
        (1 : T) ⊗ₜ[R] z := fun z => by
      rw [TensorProduct.lid_symm_apply, LinearMap.rTensor_tmul, Algebra.linearMap_apply, map_one]
