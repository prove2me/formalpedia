-- name    : BirkhoffGlobalSection_EHRegularization_Poly
-- status  : Definition
-- author  : @Mazecto
-- created : 2026-10-02T10:27:05.108158+00:00
-- url     : https://prove2.me/theorems/c6e3fbc7-6be4-4c18-88e0-7423cbf7fa35
-- title:
--   Polynomial form of the elliptic-hyperbolic / Levi-Civita Hamiltonian identity
-- statement:
--   `EHPoly.GP` is the centred-left elliptic-hyperbolic Hamiltonian evaluated at the image of a Levi-Civita point, written as a polynomial in $z_0,z_1,w_0,w_1$, $S=S_r+iS_i$ ($S=\sqrt{1-2z^2}$) and $q=\sqrt2$; `EHPoly.KP` is the Levi-Civita Hamiltonian without its singular term. `G_poly_identity`: $GP=2(S_r^2+S_i^2)\,KP-2\mu|z|^2$ modulo $S^2=1-2z^2$ and $q^2=2$ (a `linear_combination` with generated cofactors).
-- source:
--   Liu--Salomao, https://arxiv.org/html/2506.17867v2#S9.SS2 (elliptic-hyperbolic regularization, Section 9.2); explicit transport to the platform's Levi-Civita normalization constructed and verified here (momentum shift p -> p + (0, 1/2 - mu) between the barycentric rotating frame and the elliptic centre).

import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring
import Mathlib.Data.Real.Basic

/-! The EH/LC Hamiltonian identity as a pure polynomial identity (generated by eh_gen_poly.py). -/

namespace EHPoly

set_option maxHeartbeats 4000000

/-- The EH Hamiltonian at the transported point, written in `z0 z1 w0 w1`, `S = Sr + i Si`, `q`. -/
noncomputable def GP (z0 z1 w0 w1 Sr Si q mu c : ℝ) : ℝ :=
  -Si^6*mu*q^2*z0^2/2 - Si^6*mu*q^2*z1^2/2 + Si^6*q^2*z0^2/4 + Si^6*q^2*z1^2/4 - 3*Si^4*Sr^2*mu*q^2*z0^2/2 - 3*Si^4*Sr^2*mu*q^2*z1^2/2 + 3*Si^4*Sr^2*q^2*z0^2/4 + 3*Si^4*Sr^2*q^2*z1^2/4 - Si^4*mu*q^2*z0^2 - Si^4*mu*q^2*z1^2 + Si^4*q^2*w0*z1 + Si^4*q^2*w1*z0 + Si^4*q^2*z0^2/2 + Si^4*q^2*z1^2/2 + 2*Si^3*Sr*q^2*w0*z0 - 2*Si^3*Sr*q^2*w1*z1 - 3*Si^2*Sr^4*mu*q^2*z0^2/2 - 3*Si^2*Sr^4*mu*q^2*z1^2/2 + 3*Si^2*Sr^4*q^2*z0^2/4 + 3*Si^2*Sr^4*q^2*z1^2/4 + Si^2*c*q^2*z0^2 + Si^2*c*q^2*z1^2 + Si^2*mu*q^6*z0^6/2 + 3*Si^2*mu*q^6*z0^4*z1^2/2 + 3*Si^2*mu*q^6*z0^2*z1^4/2 + Si^2*mu*q^6*z1^6/2 - Si^2*mu*q^2*w0*z1 - Si^2*mu*q^2*w1*z0 - Si^2*mu*q^2*z0^2/2 - Si^2*mu*q^2*z1^2/2 + Si^2*mu - Si^2*q^6*z0^6/4 - 3*Si^2*q^6*z0^4*z1^2/4 - 3*Si^2*q^6*z0^2*z1^4/4 - Si^2*q^6*z1^6/4 + Si^2*q^2*w0^2/2 + Si^2*q^2*w0*z1 + Si^2*q^2*w1^2/2 + Si^2*q^2*w1*z0 + Si^2*q^2*z0^2/4 + Si^2*q^2*z1^2/4 - Si^2 + 2*Si*Sr^3*q^2*w0*z0 - 2*Si*Sr^3*q^2*w1*z1 - Sr^6*mu*q^2*z0^2/2 - Sr^6*mu*q^2*z1^2/2 + Sr^6*q^2*z0^2/4 + Sr^6*q^2*z1^2/4 + Sr^4*mu*q^2*z0^2 + Sr^4*mu*q^2*z1^2 - Sr^4*q^2*w0*z1 - Sr^4*q^2*w1*z0 - Sr^4*q^2*z0^2/2 - Sr^4*q^2*z1^2/2 + Sr^2*c*q^2*z0^2 + Sr^2*c*q^2*z1^2 + Sr^2*mu*q^6*z0^6/2 + 3*Sr^2*mu*q^6*z0^4*z1^2/2 + 3*Sr^2*mu*q^6*z0^2*z1^4/2 + Sr^2*mu*q^6*z1^6/2 - Sr^2*mu*q^2*w0*z1 - Sr^2*mu*q^2*w1*z0 - Sr^2*mu*q^2*z0^2/2 - Sr^2*mu*q^2*z1^2/2 + Sr^2*mu - Sr^2*q^6*z0^6/4 - 3*Sr^2*q^6*z0^4*z1^2/4 - 3*Sr^2*q^6*z0^2*z1^4/4 - Sr^2*q^6*z1^6/4 + Sr^2*q^2*w0^2/2 + Sr^2*q^2*w0*z1 + Sr^2*q^2*w1^2/2 + Sr^2*q^2*w1*z0 + Sr^2*q^2*z0^2/4 + Sr^2*q^2*z1^2/4 - Sr^2 - mu*q^2*z0^2 - mu*q^2*z1^2

/-- The Levi-Civita Hamiltonian without its singular term `-mu|z|²/√D`. -/
noncomputable def KP (z0 z1 w0 w1 mu c : ℝ) : ℝ :=
  c*z0^2 + c*z1^2 - mu*w0*z1 - mu*w1*z0 + mu/2 + w0^2/2 - 2*w0*z0^2*z1 - 2*w0*z1^3 + w1^2/2 + 2*w1*z0^3 + 2*w1*z0*z1^2 - 1/2

/-- The EH Hamiltonian at the transported point, as a polynomial in `z, w, S = √(1-2z²)`
(`Sr, Si`), `q = √2`; equals `2 |S|² K - 2 mu |z|²` modulo `S² = 1 - 2z²`, `q² = 2`. -/
theorem G_poly_identity (z0 z1 w0 w1 Sr Si q mu c : ℝ)
    (h1 : Sr ^ 2 - Si ^ 2 = 1 - 2 * (z0 ^ 2 - z1 ^ 2))
    (h2 : 2 * Sr * Si = -(4 * z0 * z1)) (h3 : q ^ 2 = 2) :
    GP z0 z1 w0 w1 Sr Si q mu c =
      2 * (Sr ^ 2 + Si ^ 2) * KP z0 z1 w0 w1 mu c - 2 * mu * (z0 ^ 2 + z1 ^ 2) := by
  unfold GP KP
  linear_combination (Si^4*mu*z0^2 + Si^4*mu*z1^2 - Si^4*z0^2/2 - Si^4*z1^2/2 + 2*Si^2*mu*z0^4 + Si^2*mu*z0^2 - 2*Si^2*mu*z1^4 + Si^2*mu*z1^2 - 2*Si^2*w0*z1 - 2*Si^2*w1*z0 - Si^2*z0^4 - Si^2*z0^2/2 + Si^2*z1^4 - Si^2*z1^2/2 - Sr^4*mu*z0^2 - Sr^4*mu*z1^2 + Sr^4*z0^2/2 + Sr^4*z1^2/2 + 2*Sr^2*mu*z0^4 + Sr^2*mu*z0^2 - 2*Sr^2*mu*z1^4 + Sr^2*mu*z1^2 - 2*Sr^2*w0*z1 - 2*Sr^2*w1*z0 - Sr^2*z0^4 - Sr^2*z0^2/2 + Sr^2*z1^4 - Sr^2*z1^2/2) * h1 + (-2*Si^3*Sr*mu*z0^2 - 2*Si^3*Sr*mu*z1^2 + Si^3*Sr*z0^2 + Si^3*Sr*z1^2 + 4*Si^2*mu*z0^3*z1 + 4*Si^2*mu*z0*z1^3 + 2*Si^2*w0*z0 - 2*Si^2*w1*z1 - 2*Si^2*z0^3*z1 - 2*Si^2*z0*z1^3 - 2*Si*Sr^3*mu*z0^2 - 2*Si*Sr^3*mu*z1^2 + Si*Sr^3*z0^2 + Si*Sr^3*z1^2 + 4*Sr^2*mu*z0^3*z1 + 4*Sr^2*mu*z0*z1^3 + 2*Sr^2*w0*z0 - 2*Sr^2*w1*z1 - 2*Sr^2*z0^3*z1 - 2*Sr^2*z0*z1^3) * h2 + (-Si^6*mu*z0^2/2 - Si^6*mu*z1^2/2 + Si^6*z0^2/4 + Si^6*z1^2/4 - 3*Si^4*Sr^2*mu*z0^2/2 - 3*Si^4*Sr^2*mu*z1^2/2 + 3*Si^4*Sr^2*z0^2/4 + 3*Si^4*Sr^2*z1^2/4 - Si^4*mu*z0^2 - Si^4*mu*z1^2 + Si^4*w0*z1 + Si^4*w1*z0 + Si^4*z0^2/2 + Si^4*z1^2/2 + 2*Si^3*Sr*w0*z0 - 2*Si^3*Sr*w1*z1 - 3*Si^2*Sr^4*mu*z0^2/2 - 3*Si^2*Sr^4*mu*z1^2/2 + 3*Si^2*Sr^4*z0^2/4 + 3*Si^2*Sr^4*z1^2/4 + Si^2*c*z0^2 + Si^2*c*z1^2 + Si^2*mu*q^4*z0^6/2 + 3*Si^2*mu*q^4*z0^4*z1^2/2 + 3*Si^2*mu*q^4*z0^2*z1^4/2 + Si^2*mu*q^4*z1^6/2 + Si^2*mu*q^2*z0^6 + 3*Si^2*mu*q^2*z0^4*z1^2 + 3*Si^2*mu*q^2*z0^2*z1^4 + Si^2*mu*q^2*z1^6 - Si^2*mu*w0*z1 - Si^2*mu*w1*z0 + 2*Si^2*mu*z0^6 + 6*Si^2*mu*z0^4*z1^2 + 6*Si^2*mu*z0^2*z1^4 - Si^2*mu*z0^2/2 + 2*Si^2*mu*z1^6 - Si^2*mu*z1^2/2 - Si^2*q^4*z0^6/4 - 3*Si^2*q^4*z0^4*z1^2/4 - 3*Si^2*q^4*z0^2*z1^4/4 - Si^2*q^4*z1^6/4 - Si^2*q^2*z0^6/2 - 3*Si^2*q^2*z0^4*z1^2/2 - 3*Si^2*q^2*z0^2*z1^4/2 - Si^2*q^2*z1^6/2 + Si^2*w0^2/2 + Si^2*w0*z1 + Si^2*w1^2/2 + Si^2*w1*z0 - Si^2*z0^6 - 3*Si^2*z0^4*z1^2 - 3*Si^2*z0^2*z1^4 + Si^2*z0^2/4 - Si^2*z1^6 + Si^2*z1^2/4 + 2*Si*Sr^3*w0*z0 - 2*Si*Sr^3*w1*z1 - Sr^6*mu*z0^2/2 - Sr^6*mu*z1^2/2 + Sr^6*z0^2/4 + Sr^6*z1^2/4 + Sr^4*mu*z0^2 + Sr^4*mu*z1^2 - Sr^4*w0*z1 - Sr^4*w1*z0 - Sr^4*z0^2/2 - Sr^4*z1^2/2 + Sr^2*c*z0^2 + Sr^2*c*z1^2 + Sr^2*mu*q^4*z0^6/2 + 3*Sr^2*mu*q^4*z0^4*z1^2/2 + 3*Sr^2*mu*q^4*z0^2*z1^4/2 + Sr^2*mu*q^4*z1^6/2 + Sr^2*mu*q^2*z0^6 + 3*Sr^2*mu*q^2*z0^4*z1^2 + 3*Sr^2*mu*q^2*z0^2*z1^4 + Sr^2*mu*q^2*z1^6 - Sr^2*mu*w0*z1 - Sr^2*mu*w1*z0 + 2*Sr^2*mu*z0^6 + 6*Sr^2*mu*z0^4*z1^2 + 6*Sr^2*mu*z0^2*z1^4 - Sr^2*mu*z0^2/2 + 2*Sr^2*mu*z1^6 - Sr^2*mu*z1^2/2 - Sr^2*q^4*z0^6/4 - 3*Sr^2*q^4*z0^4*z1^2/4 - 3*Sr^2*q^4*z0^2*z1^4/4 - Sr^2*q^4*z1^6/4 - Sr^2*q^2*z0^6/2 - 3*Sr^2*q^2*z0^4*z1^2/2 - 3*Sr^2*q^2*z0^2*z1^4/2 - Sr^2*q^2*z1^6/2 + Sr^2*w0^2/2 + Sr^2*w0*z1 + Sr^2*w1^2/2 + Sr^2*w1*z0 - Sr^2*z0^6 - 3*Sr^2*z0^4*z1^2 - 3*Sr^2*z0^2*z1^4 + Sr^2*z0^2/4 - Sr^2*z1^6 + Sr^2*z1^2/4 - mu*z0^2 - mu*z1^2) * h3

end EHPoly


