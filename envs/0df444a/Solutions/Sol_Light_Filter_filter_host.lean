section
open ThreeSumApsp
open Light
open Light.Filter
open ThreeSumApsp.Spec Light.Sec3
variable {lim : Limits}
theorem solution :
    (∀ (P : Program) (po : ℕ) (To : List ℕ → ℕ) (needo : List ℕ → Light.Need),
      SolvesN oracleTask P po To needo →
      ∃ (R : Program) (p' : ℕ), Light.Solves aeTask (P ++ R) p' (filterTime To) (filterNeed needo)) ∧
    (∀ needo, PolyNeedN needo → PolyNeed (filterNeed needo)) :=
  ⟨fun P po _ _ hsol => ⟨hostProcs P.length po, P.length + 18, filter_solves hsol⟩,
    fun _ h => filterNeed_poly h⟩
end
