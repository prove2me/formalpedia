variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem zipL_zero : ∀ (l : List Bool), (zipL fZero false [] l).1 = List.replicate l.length false
  | [] => by simp [zipL]
  | y :: l => by simp [zipL, fZero, zipL_zero l, List.replicate_succ]

theorem codeBit_ne_of {s : Sym} (h0 : s ≠ 0) (h1 : s ≠ 1) (b : Bool) : codeBit b ≠ s := by
  cases b
  · exact fun h => h0 h.symm
  · exact fun h => h1 h.symm

