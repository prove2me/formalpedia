-- Source module: Solutions.KFMK0
/-!
# KFM K0: merging the interface tables into one `kTable`

`P18IL`, `PhiNeed` and `TransNeed` each give their own `kTable ext_i` (`7 + E_i` procedures).
The machine has one table. `mTable` merges them with kmain's own procedures `own`:

`mExt = [ext_1 (renamed), ext_2 (renamed), ext_3 (renamed), own]`, `E = E₁ + E₂ + E₃ + E₀`.

* `IStmt.ren_ren`: renaming twice is renaming by the composites.
* `gI off`: the index map of a table into the merged one (the first `7` fixed, the extensions
  shifted by `off`).
* **`mTable_g1/g2/g3`**: `kTable mExt (g j) = (kTable ext_i j).ren id g`, the hypothesis of
  `IRuns.relabel`. So every run in `kTable ext_i` is a run in the merged table, same cost.
* `mTable_own`: kmain's own procedures sit at `7 + E₁ + E₂ + E₃ + k`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul

section Ren

variable {S S' S'' P P' P'' : ℕ}

theorem IOp.ren_ren (f : Fin S → Fin S') (f' : Fin S' → Fin S'') (o : IOp S) :
    (o.ren f).ren f' = o.ren (f' ∘ f) := by
  cases o <;> rfl

theorem IStmt.ren_ren (f : Fin S → Fin S') (g : Fin P → Fin P') (f' : Fin S' → Fin S'')
    (g' : Fin P' → Fin P'') : ∀ p : IStmt S P, (p.ren f g).ren f' g' = p.ren (f' ∘ f) (g' ∘ g)
  | .skip => rfl
  | .op o => by simp only [IStmt.ren, IOp.ren_ren]
  | .seq p q => by simp only [IStmt.ren, IStmt.ren_ren f g f' g' p, IStmt.ren_ren f g f' g' q]
  | .ite i c p q => by
    simp only [IStmt.ren, IStmt.ren_ren f g f' g' p, IStmt.ren_ren f g f' g' q]; rfl
  | .loop i c p => by simp only [IStmt.ren, IStmt.ren_ren f g f' g' p]; rfl
  | .call j => rfl

end Ren

section Merge

variable {E₁ E₂ E₃ E₀ E : ℕ}

theorem gI_gL (Ei E off : ℕ) (h : off + Ei ≤ E) : gI Ei E off h ∘ gL Ei = gL E := by
  funext j; simp [gI, gL]

theorem gI_gM (Ei E off : ℕ) (h : off + Ei ≤ E) : gI Ei E off h ∘ gM Ei = gM E := by
  funext j; have := j.isLt; apply Fin.ext
  show (gI Ei E off h (gM Ei j)).val = (gM E j).val
  unfold gI gM
  split_ifs with hh
  · rfl
  · simp at hh; omega

variable (ext₁ : Fin E₁ → IStmt HS (7 + E₁)) (ext₂ : Fin E₂ → IStmt HS (7 + E₂))
  (ext₃ : Fin E₃ → IStmt HS (7 + E₃)) (own : Fin E₀ → IStmt HS (7 + (E₁ + E₂ + E₃ + E₀)))

end Merge

end NLogN.KFM

