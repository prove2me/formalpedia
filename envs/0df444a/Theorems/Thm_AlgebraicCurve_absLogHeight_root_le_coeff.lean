-- title:
--   Height of a root bounded by height of coefficients
-- statement:
--   Let $p$ be a polynomial in one variable over a fixed algebraic closure $\overline{\mathbb{Q}}$ of $\mathbb{Q}$, assumed monic, and let $z \in \overline{\mathbb{Q}}$ satisfy $p(z) = 0$. Write $d = \deg p$ for the natural-number degree of $p$. Here, for a finite family $x : \iota \to \overline{\mathbb{Q}}$, `absLogHeight x` denotes the absolute logarithmic height of the tuple $x$: the field $\mathbb{Q}(x_i : i \in \iota)$ generated by the entries is finite over $\mathbb{Q}$, and `absLogHeight x` is $[\mathbb{Q}(x_i : i) : \mathbb{Q}]^{-1}$ times the (non-normalised) logarithmic height `Height.logHeight` of the tuple regarded as a family of elements of that number field. The assertion is the inequality of real numbers
--   $$\mathrm{absLogHeight}(z, 1) \;\le\; \mathrm{absLogHeight}\big(p_0, p_1, \dots, p_d\big) + \log\sqrt{d+1},$$
--   where on the left the two-element tuple $(z,1)$ is indexed by `Fin 2` and on the right the tuple of coefficients $p_k =$ `p.coeff k` is indexed by $k \in$ `Fin (d+1)`.
--
--   This is the standard comparison between the Weil height of a root of a polynomial over $\overline{\mathbb{Q}}$ and the height of its coefficient vector, in the one-root form; it is the shape consumed by [`ModularCurve.JZero.exists_pointHt_le_absLogHeight_jCoord`](thm.html#ModularCurve.JZero.exists_pointHt_le_absLogHeight_jCoord) in the height estimates attached to the modular curve.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_AlgebraicCurve_absLogHeight_root_le_coeff.lean

import Definitions.Def_ModularCurve_JZeroHeightForm

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

theorem AlgebraicCurve.absLogHeight_root_le_coeff {p : Polynomial (AlgebraicClosure ℚ)}
    (hmonic : p.Monic) {z : AlgebraicClosure ℚ} (hroot : p.eval z = 0) :
    absLogHeight ![z, 1]
      ≤ absLogHeight (fun k : Fin (p.natDegree + 1) => p.coeff k)
        + Real.log (Real.sqrt (p.natDegree + 1)) := by sorry
