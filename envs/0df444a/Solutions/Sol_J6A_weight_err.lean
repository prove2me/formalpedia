open Complex

namespace J6A

open IntMul.HvdH IntMul.HvdH.SPf

/-! ## 1. Block geometry and tables -/

/-! ## 2. Geometry facts -/

lemma kcB_bounds (H k : ℕ) (hH : 1 ≤ H) : -(H : ℤ) ≤ kapB H k ∧ kapB H k < H := by
  unfold kapB kcB
  have h2 : 0 < 2 * H := by omega
  have a1 := Nat.div_add_mod k (2 * H)
  have a2 := Nat.mod_lt k h2
  have e : k / (2 * H) * (2 * H) = 2 * H * (k / (2 * H)) := Nat.mul_comm _ _
  generalize k / (2 * H) * (2 * H) = X at e ⊢
  generalize k % (2 * H) = R at a1 a2
  rw [← e] at a1
  constructor <;> omega

lemma kap_natAbs_le (H k : ℕ) (hH : 1 ≤ H) : (kapB H k).natAbs ≤ H := by
  obtain ⟨h1, h2⟩ := kcB_bounds H k hH; omega

/-! ## 3. The exponent split -/

lemma expo_split (s t H k : ℕ) (ht : 0 < t) (hst : s ≤ t) (α : ℕ) (hα : 0 < α) (j : ℤ) :
    -(Real.pi * (aNum s t H k j : ℝ) / ((t ^ 3 * α ^ 2 : ℕ) : ℝ)) +
      -(Real.pi * (gNum s t H k j : ℝ) / ((t ^ 3 * α ^ 2 : ℕ) : ℝ)) +
      Real.pi * (cNum s t H k : ℝ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ) =
      -(Real.pi * ((j : ℝ) - (s * k : ℝ) / t) ^ 2 / α ^ 2) := by
  have htR : (0 : ℝ) < t := by exact_mod_cast ht
  have hαR : (0 : ℝ) < α := by exact_mod_cast hα
  unfold aNum gNum cNum
  have hts : ((t - s : ℕ) : ℝ) = (t : ℝ) - s := by rw [Nat.cast_sub hst]
  have hkap : (kapB H k : ℝ) = (k : ℝ) - kcB H k := by unfold kapB; push_cast; ring
  push_cast [Nat.cast_pow, Nat.cast_natAbs, Int.cast_abs, sq_abs, hts]
  rw [hkap]
  field_simp
  ring

/-- **The weight split**: `e^{-π(j - sk/t)²/α²} = a · g · C`. -/
lemma ew_split (s t H k : ℕ) (ht : 0 < t) (hst : s ≤ t) (α : ℕ) (hα : 0 < α) (j : ℤ) :
    Real.exp (-(Real.pi * (aNum s t H k j : ℝ) / ((t ^ 3 * α ^ 2 : ℕ) : ℝ))) *
      Real.exp (-(Real.pi * (gNum s t H k j : ℝ) / ((t ^ 3 * α ^ 2 : ℕ) : ℝ))) *
      Real.exp (Real.pi * (cNum s t H k : ℝ) / ((t ^ 2 * α ^ 2 : ℕ) : ℝ)) = ew s t α k j := by
  rw [← Real.exp_add, ← Real.exp_add, expo_split s t H k ht hst α hα j]; rfl

/-! ## 4. One term -/

lemma exp_neg_le_one' (x : ℝ) (hx : 0 ≤ x) : Real.exp (-x) ≤ 1 := by
  rw [Real.exp_le_one_iff]; linarith

