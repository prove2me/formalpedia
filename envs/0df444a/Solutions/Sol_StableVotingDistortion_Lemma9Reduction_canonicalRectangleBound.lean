def RowTree.covers (inside : Piece → Prop) : RowTree → ℚ → ℚ → Prop
  | .leaf p, a, b => inside p ∧ p.lo=a ∧ p.hi=b
  | .branch t l r,a,b => l.covers inside a t ∧ r.covers inside t b

theorem RowTree.lookup_correct (inside : Piece → Prop) (tree : RowTree) {a b x : ℚ}
    (ok : tree.covers inside a b) (ha : a≤x) (hb : x≤b) :
    inside (tree.lookup x) ∧ (tree.lookup x).lo≤x ∧ x≤(tree.lookup x).hi := by
  induction tree generalizing a b with
  | leaf p =>
    obtain ⟨hp,le,re⟩ := ok
    exact ⟨hp,le ▸ ha,re ▸ hb⟩
  | branch pivot left right ihL ihR =>
    by_cases e : x≤pivot
    · simpa only [lookup,if_pos e] using ihL ok.1 ha e
    · simpa only [lookup,if_neg e] using ihR ok.2 (le_of_not_ge e) hb

theorem tree_score_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qvalue x=qscore x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qvalue,qscore_exact,score_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

theorem tree_primitive_eq {tree : RowTree} (h : tree.covers (· ∈ pieces) 0 1) {x : ℚ}
    (hx : x∈Icc 0 1) : (tree.lookup x).qprimitive x=qprimitive x := by
  obtain ⟨hp,l,r⟩ := tree.lookup_correct _ h hx.1 hx.2
  apply Rat.cast_injective (α:=ℝ)
  rw [Piece.cast_qprimitive,qprimitive_exact,primitive_on_piece hp ⟨by exact_mod_cast l,by exact_mod_cast r⟩]

end StableVotingDistortion.PaperCurve
