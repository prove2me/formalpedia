    rw [hC, ← map_mul]
    exact wal_incl_int v _ (hΛ y hy i)
  | zero => intro i; simp
  | add x w _ _ hx hw => intro i; rw [Pi.add_apply, mul_add]; exact add_mem (hx i) (hw i)
  | smul s x _ hx =>
    intro i
    rw [Pi.smul_apply, Subring.smul_def, smul_eq_mul, mul_left_comm]
    exact mul_mem s.2 (hx i)
