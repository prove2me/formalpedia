-- title:
--   Homogeneous components preserve a homogeneous generated ideal
-- statement:
--   Every weighted homogeneous component of a polynomial in an ideal generated by polynomials homogeneous of the same positive weighted degree is still in that ideal.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.span_mem_weightedHomogeneousComponent
    {d m : Nat} (w : Fin d → ℚ) (D : ℚ) (hD : 0 < D)
    (p : Fin m → MvPolynomial (Fin d) ℂ)
    (hp : ∀ j, MvPolynomial.IsWeightedHomogeneous w (p j) D) :
    ∀ f : MvPolynomial (Fin d) ℂ,
      f ∈ Ideal.span (Set.range p) →
      ∀ r : ℚ,
        MvPolynomial.weightedHomogeneousComponent w r f ∈ Ideal.span (Set.range p) := by sorry
