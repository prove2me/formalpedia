-- title:
--   Global continuity of the local convolution function
-- statement:
--   Let $G$ be a Hausdorff locally compact second-countable topological group and let $A$ be a Hausdorff locally compact second-countable abelian topological group with a continuous action of $G$ by automorphisms, written $g\cdot a$. Let $F:G\times G\to A$ be a Borel measurable two-cocycle, with pointwise identity
--   $$
--   F(g,h)+F(gh,k)=g\cdot F(h,k)+F(g,hk),\qquad F(1,g)=F(g,1)=0.
--   $$
--   Assume that $F$ is continuous on $U_F\times U_F$, where $U_F$ is an open identity neighborhood. Let $E=A\times_F G$, with multiplication $(a,g)(b,h)=(a+g\cdot b+F(g,h),gh)$ and inverse $(a,g)^{-1}=(-g^{-1}\cdot(a+F(g,g^{-1})),g^{-1})$. Equip $E$ with the topology generated by left translates of the rectangles $U_A\times U_G$, where $U_A,U_G$ are open identity neighborhoods and $F$ is continuous on $U_G\times U_G$. Write $e=(0,1)$ and $\pi(a,g)=g$.
--
--   Let $\mu$ be a nonzero Borel measure on $E$ with the properties obtained in Remark 4: it is finite on compact sets, and $\mu(xW)=\mu(W)$ for every $x\in E$ and Borel $W$ whose closure is compact.
--
--   Let $U_2\subseteq G$ be a symmetric relatively compact open identity neighborhood satisfying $\overline{U_2}\,\overline{U_2}\subseteq U_F$. Let $M\subseteq E$ be Borel measurable and symmetric, with $e\in M$, $M\subseteq\pi^{-1}(U_2)$, and $0<\mu(M)<\infty$.
--
--   Define $u:E\to\mathbb R$ by $u(x)=\mu(M\cap xM)$, using the real value of this finite mass. Then
--   $$
--   \mu(M\cap xM)<\infty\quad(x\in E),\qquad u\text{ is continuous on all of }E.
--   $$
--   The finite-mass bound makes the real-valued convolution well-defined, and the conclusion is global continuity.
-- source:
--   On Cohomology theory for topological groups, arXiv:1009.4519v1, PDF p. 19, Lemma 7: convolution continuity

import Definitions.Def_QAlgorithms_Papers_Independent_Intakethird100_P08

namespace QAlgorithms.Papers.Independent.Intakethird100.P08

open Set MeasureTheory

open scoped BigOperators Topology CompactlySupported

section ConstructedExtension

variable {G A : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [T2Space G] [LocallyCompactSpace G] [SecondCountableTopology G]
  [MeasurableSpace G] [BorelSpace G]
  [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
  [T2Space A] [LocallyCompactSpace A] [SecondCountableTopology A]
  [MeasurableSpace A] [BorelSpace A]

/-- Lemma 7, PDF pp. 19--21: global continuity of u(x)=mu(M intersect xM).
The explicit finite-mass clause justifies toReal; no infinite mass is silently
converted to zero. The proof's dropped projection on p. 19 is not propagated. -/
theorem lemma7 (D : LocalCocycle G A) (mu : Measure (ExtensionPoint D))
    (hmu : IsLeftInvariantMeasure D mu) (U : Set G) (M : Set (ExtensionPoint D))
    (hM : IsLocalSteinhausSet D mu U M) :
    (∀ x : ExtensionPoint D, mu (M ∩ (actionTwistedMul D x) '' M) < ⊤) ∧
    Continuous (localConvolution D mu M) := by sorry

end ConstructedExtension

end QAlgorithms.Papers.Independent.Intakethird100.P08
