    bornProb ((U ⊗ₖ W) *ᵥ ψ) (U * A * Uᴴ) Y = bornProb ψ A (Wᴴ * Y * W) := by
  rw [bornProb_kronecker_mulVec, conjTranspose_mul_conj_mul hU]
end
