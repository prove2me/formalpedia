        (∀ τ : ↥(A.decompositionSubgroup ℚ),
          (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) ∈ A.inertiaSubgroupIn ℚ → χ τ = 1) ∧
        (∀ φ : ↥(A.decompositionSubgroup ℚ),
          A.IsFrobeniusAt (φ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) r → χ φ ≠ 1) ∧

        (∀ τ, χ τ = 1 → actZ τ = 1) ∧
        (∀ τ, χ τ ≠ 1 → ∀ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
          ((actZ τ x : ↥(ribbonKernel (classSetDegeneracyData Rd nd))) : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) =
            fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) ∧

        (∀ x y x' y' : ↥(ribbonKernel (classSetDegeneracyData Rd nd)),
          ((x' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) = fun c => - (x : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) →
          ((y' : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) = fun c => - (y : ClassSet (Submodule.finiteIdeleStabilizer (meetOrder Rd nd)) → ℤ) (classSetShift _ nd c)) →
            𝒰.P.Q x' y' = 𝒰.P.Q x y) ∧

        𝒰.P.HeckeAdjointable (classSetHeckeData N r Λd Rd nd) ∧

        Function.Injective ιT ∧
        (∀ t : T, IsOfFinAddOrder t → t ∈ ιT.range) ∧
        (∀ (τ : ↥(A.decompositionSubgroup ℚ)) (c : M.J),
          ιT (M.galJ (τ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) c) = galT τ (ιT c)) ∧

        (∀ (ℓ : Nat.Primes) (u : 𝒰.P.TorusPoints) (c : M.J), u ∈ 𝒰.P.U → 𝒰.eFull u = ιT c →
          𝒰.eFull (𝒰.P.precomp (heckeKernelMap (classSetHeckeData N r Λd Rd nd) ℓ) u) = ιT (M.heckeJSigned ε (heckeGen ℓ) c)))

section comap
open CerednikDrinfeld.Mumford
variable {E V : Type} [Fintype E] [DecidableEq V]

def euComap {r : ℕ} [Fact r.Prime] {D : DegeneracyData E V}
    {A : ValuationSubring (AlgebraicClosure ℚ)} {hA : A.LiesOverPrime r}
    {T : Type} [AddCommGroup T]
    {S : Type} [Group S] {scalar : S →* ↥(A.decompositionSubgroup ℚ)}
    {actZ : S →* (↥(ribbonKernel D) ≃ₗ[ℤ] ↥(ribbonKernel D))} {gal : S →* AddAut T}
    (𝒰 : EquivariantUniformization r D A hA T S scalar actZ gal)
    {S' : Type} [Group S'] (f : S' →* S) (scalar' : S' →* ↥(A.decompositionSubgroup ℚ))
    (hsc : ∀ σ' : S', scalar (f σ') = scalar' σ') :
    EquivariantUniformization r D A hA T S' scalar' (actZ.comp f) (gal.comp f) where
  K := 𝒰.K
  ord := 𝒰.ord
  ord_spec := 𝒰.ord_spec
  inertia_K := 𝒰.inertia_K
  hensel_K := 𝒰.hensel_K
  P := 𝒰.P
  eFull := 𝒰.eFull
  eFull_surjective := 𝒰.eFull_surjective
  eFull_ker := 𝒰.eFull_ker
  Q_equiv σ' s hs x y := 𝒰.Q_equiv (f σ') s (by intro c; rw [hs c, hsc σ']) x y
  eFull_equiv σ' s hs u := 𝒰.eFull_equiv (f σ') s (by intro c; rw [hs c, hsc σ']) u

def conjAct {Z₁ Z₂ : Type} [AddCommGroup Z₁] [AddCommGroup Z₂] [Module ℤ Z₁] [Module ℤ Z₂]
    {S : Type} [Group S] (e : Z₁ ≃ₗ[ℤ] Z₂) (act : S →* (Z₁ ≃ₗ[ℤ] Z₁)) : S →* (Z₂ ≃ₗ[ℤ] Z₂) where
  toFun σ := (e.symm.trans (act σ)).trans e
  map_one' := by ext x; simp
  map_mul' σ τ := by ext x; simp [LinearEquiv.mul_apply]

theorem conjAct_apply {Z₁ Z₂ : Type} [AddCommGroup Z₁] [AddCommGroup Z₂] [Module ℤ Z₁] [Module ℤ Z₂]
    {S : Type} [Group S] (e : Z₁ ≃ₗ[ℤ] Z₂) (act : S →* (Z₁ ≃ₗ[ℤ] Z₁)) (σ : S) (z : Z₂) :
    conjAct e act σ z = e (act σ (e.symm z)) := rfl

end comap
