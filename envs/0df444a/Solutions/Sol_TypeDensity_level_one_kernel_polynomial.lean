        Ideal.span {φ s ^ r} ∧
      Module.length (TypeDensity.CompletedLocalAt (TypeDensity.BlowupChart R t x) (P s))
        (TypeDensity.CompletedLocalAt (TypeDensity.BlowupChart R t x) (P s) ⧸
          TypeDensity.finiteLocalCurveIdeal (TypeDensity.BlowupChart R t x) (P s) (TypeDensity.chartBase R t x t) (g s) 1) =
        (r : ℕ∞) := fun s => by
    obtain ⟨L, hL⟩ := hfin s
    obtain ⟨r, -, hr, hrlen⟩ := TypeDensity.contracted_level_one_ideal_is_irreducible_power R t x e
