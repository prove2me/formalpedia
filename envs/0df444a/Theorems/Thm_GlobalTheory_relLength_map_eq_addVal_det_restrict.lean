variable {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {V : Type*} [AddCommGroup V] [Module R V] {ι : Type*} [Fintype ι] [DecidableEq ι]

theorem GlobalTheory.relLength_map_eq_addVal_det_restrict {A : Submodule R V} [Module.Free R A]
    [Module.Finite R A] (g : V →ₗ[R] V) (hg : ∀ x ∈ A, g x ∈ A) :
    relLength A (A.map g) = addVal R (LinearMap.det (g.restrict hg)) := by sorry
