theorem NLogN.EX.bPhase_all (M : MulSpec) (q : Params) (kb mm Φ Bacc Q Bq Bx CB : ℕ) (BB : ℕ → ℕ)
    (hM : MulBnd M mm Φ) (hsl : q.s.length = q.K) (hst : ∀ i < q.K, sK q i ≤ tK q i)
    (hα : 1 ≤ q.α) (hBx : Vx q kb < 2 ^ Bx) (H : ∀ k < q.K, BAx q kb mm Bacc Q Bq BB k)
    (hCB : ∀ k < q.K,
      bapAxCost q.p (sK q k) (tK q k) q.α (mB q k) kb (BB k) mm Φ Bacc Q Bq ≤ CB)
    (Y : List (ℤ × ℤ)) (w : IState HS) (R RSt LN : List Item) (hg : Glob q kb w)
    (hD : w.G gD = gints Y ++ R) (hL : Y.length = NLogN.EX.TT q) (hLB : GB (BB 0) Y)
    (hS : w.G xS = ints (NLogN.EX.sl q) ++ RSt) (hPN : w.G gPN = .int (NLogN.EX.TT q : ℤ) :: LN) :
    bPhase.run w = w.upd gD (gints (tensorGo (fwdAxB q) q.tdims Y) ++ R) ∧ bPhase.ok M w ∧
      bPhase.cost M w ≤ bLoopCost q CB Bx + phOver q.K Bx ∧
