theorem dvd_of_rho_eq_zero [IsDomain R] (θ : WithConv (H →ₗ[R] R)) (hθ : rho p θ = 0) :
    (p : WithConv (H →ₗ[R] R)) ∣ θ := by
  have h : ∀ a : H, (p : R) ∣ θ.ofConv a := by
    intro a
    apply hker
    have := congrArg (fun ψ : D => ψ ((1 : ZMod p) ⊗ₜ[R] a)) hθ
    simp only [rho_tmul, mul_one] at this
    exact this
  by_cases hp0 : (p : R) = 0
  · have hθ0 : θ = 0 := by
      rw [← WithConv.toConv_ofConv θ, ← WithConv.toConv_zero]
      congr 1
      refine LinearMap.ext fun a => ?_
      have ha := h a
      rw [hp0, zero_dvd_iff] at ha
      exact ha
    rw [hθ0]
    exact dvd_zero _
  choose c hc using h
  let χ : H →ₗ[R] R :=
    { toFun := c
      map_add' := fun a b => by
        apply mul_left_cancel₀ hp0
        rw [mul_add, ← hc, ← hc, ← hc, map_add]
      map_smul' := fun r a => by
        apply mul_left_cancel₀ hp0
        rw [RingHom.id_apply, smul_eq_mul, mul_left_comm, ← hc, ← hc, map_smul, smul_eq_mul] }
  refine ⟨WithConv.toConv χ, ?_⟩
  rw [← nsmul_eq_mul, ← WithConv.toConv_ofConv θ, ← WithConv.toConv_smul]
  congr 1
  refine LinearMap.ext fun a => ?_
  rw [LinearMap.smul_apply, nsmul_eq_mul]
  exact hc a

