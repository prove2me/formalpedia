private theorem inv_measure_adelicBox_mul_integral_eq_prod_mul_integral_mixedSpace
    (Φ : AdeleRing (𝓞 ℚ) ℚ → ℂ) (f : InfiniteAdeleRing ℚ → ℂ)
    (h : ∀ v : HeightOneSpectrum (𝓞 ℚ), v.adicCompletion ℚ → ℂ)
    (hΦ : ∀ x : AdeleRing (𝓞 ℚ) ℚ, Φ x = f x.1 * ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), h v (x.2 v))
    (h₁ : ∀ v ∉ S, ∀ y : v.adicCompletion ℚ, y ∈ v.adicCompletionIntegers ℚ → h v y = 1)
    (h₀ : ∀ v ∉ S, ∀ y : v.adicCompletion ℚ, y ∉ v.adicCompletionIntegers ℚ → h v y = 0) :
    ((adelicAddHaar (𝓞 ℚ) ℚ (adelicBox ℚ)).toReal : ℂ)⁻¹ * ∫ x, Φ x ∂(adelicAddHaar (𝓞 ℚ) ℚ) =
      (∏ v ∈ S, (((μ v).real (v.adicCompletionIntegers ℚ : Set (v.adicCompletion ℚ)) : ℂ)⁻¹ *
          ∫ y, h v y ∂(μ v))) *
        ∫ y : mixedEmbedding.mixedSpace ℚ, f ((InfiniteAdeleRing.ringEquiv_mixedSpace ℚ).symm y) := by
  letI : MeasurableSpace (FiniteAdeleRing (𝓞 ℚ) ℚ) := borel _
  haveI : BorelSpace (FiniteAdeleRing (𝓞 ℚ) ℚ) := ⟨rfl⟩
  let ν : Measure (FiniteAdeleRing (𝓞 ℚ) ℚ) := Measure.addHaar
  haveI : ν.IsAddHaarMeasure := Measure.isAddHaarMeasure_addHaarMeasure _
  letI : MeasurableSpace (AdeleRing (𝓞 ℚ) ℚ) := adeleBorel (𝓞 ℚ) ℚ
  haveI : BorelSpace (AdeleRing (𝓞 ℚ) ℚ) := borelSpace_adeleBorel (𝓞 ℚ) ℚ
  haveI : (adelicAddHaar (𝓞 ℚ) ℚ).IsAddHaarMeasure := isAddHaarMeasure_adelicAddHaar (𝓞 ℚ) ℚ

  have hpure := NumberField.AdelicBox.inv_measure_adelicBox_mul_integral_pureTensor_eq ℚ (adelicAddHaar (𝓞 ℚ) ℚ) ν
    (fun y => f ((InfiniteAdeleRing.ringEquiv_mixedSpace ℚ).symm y))
    (fun z => ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), h v (z v))
  simp only [RingEquiv.symm_apply_apply] at hpure

  have hset : (∫ z, ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), h v (z v) ∂ν) =
      ∫ z in {z : FiniteAdeleRing (𝓞 ℚ) ℚ |
          ∀ v : HeightOneSpectrum (𝓞 ℚ), v ∉ S → z v ∈ v.adicCompletionIntegers ℚ},
        ∏ᶠ v : HeightOneSpectrum (𝓞 ℚ), h v (z v) ∂ν :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero fun z hz =>
      finprod_eq_zero_of_exists S h h₁ h₀ z hz).symm
  have hfactor := EisensteinGeneral.Factorization.inv_measure_mul_setIntegral_integralOffSet_finprod_eq ℚ ν S μ h h₁
  simp only [hΦ]
  rw [hpure, arch_constant_rat, one_mul, hset, ← measureReal_def, hfactor]
  exact mul_comm _ _

end LanglandsTunnell.CubicInduction.ProductShapeIntegral

