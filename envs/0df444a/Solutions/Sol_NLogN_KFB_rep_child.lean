theorem sum_bits_window (d : ℕ → ℕ) (hd : ∀ p, d p < 2) (K q : ℕ) : ∀ L, q + L ≤ K →
    (∑ p ∈ Finset.range K, d p * 2 ^ p) / 2 ^ q % 2 ^ L =
      ∑ c ∈ Finset.range L, d (q + c) * 2 ^ c
  | 0, _ => by simp [Nat.mod_one]
  | L + 1, h => by
    rw [Nat.mod_pow_succ, sum_bits_window d hd K q L (by omega), Finset.sum_range_succ,
      Nat.div_div_eq_div_mul, ← pow_add, sum_bits_div d hd K (q + L) (by omega)]
    ring

theorem sidx_lt {n : ℕ} (σ : Fin n → Fin 2) : sidx σ < 2 ^ n := by
  have : sidx σ = ∑ c ∈ Finset.range n,
      (if h : c < n then (σ ⟨c, h⟩).val else 0) * 2 ^ c := by
    unfold sidx
    rw [← Fin.sum_univ_eq_sum_range (fun c => (if h : c < n then (σ ⟨c, h⟩).val else 0) * 2 ^ c)]
    refine Finset.sum_congr rfl fun c _ => ?_
    simp [c.isLt]
  rw [this]
  exact sum_bits_lt _ (fun p => by split_ifs <;> simp [Fin.isLt]; omega) n

/-- The slot-`h` window of the address index. -/
theorem aidx_slot {m n : ℕ} (b : Fin m × Fin n → Fin 2) (h : Fin m) :
    aidx b / 2 ^ (n * h.val) % 2 ^ n = sidx (Butterfly.slotBits b h) := by
  rw [aidx_eq, sum_bits_window _ (adig_lt b) _ _ n (by
    have := h.isLt
    calc n * h.val + n = n * (h.val + 1) := by ring
      _ ≤ n * m := Nat.mul_le_mul_left _ this
      _ = m * n := by ring)]
  unfold sidx
  rw [← Fin.sum_univ_eq_sum_range (fun c => adig b (n * h.val + c) * 2 ^ c)]
  refine Finset.sum_congr rfl fun c _ => ?_
  have hc : n * h.val + c.val < m * n := by
    have := h.isLt
    calc n * h.val + c.val < n * h.val + n := by omega
      _ = n * (h.val + 1) := by ring
      _ ≤ n * m := Nat.mul_le_mul_left _ this
      _ = m * n := by ring
  have e : finProdFinEquiv.symm (⟨n * h.val + c.val, hc⟩ : Fin (m * n)) = (h, c) := by
    apply finProdFinEquiv.injective
    rw [Equiv.apply_symm_apply]; ext; simp [finProdFinEquiv]; ring
  simp only [adig, dif_pos hc, e, Butterfly.slotBits]

theorem aidx_updS {m n : ℕ} (b : Fin m × Fin n → Fin 2) (h : Fin m) (σ : Fin n → Fin 2) :
    (aidx (updS b h σ) : ℤ) = aidx b + ((sidx σ : ℤ) - sidx (Butterfly.slotBits b h)) *
      ((2 ^ (n * h.val) : ℕ) : ℤ) := by
  have hs : (aidx (updS b h σ) : ℤ) - aidx b = ∑ p : Fin m × Fin n,
      (((updS b h σ p).val : ℤ) - (b p).val) * ((2 ^ (finProdFinEquiv p).val : ℕ) : ℤ) := by
    unfold aidx; push_cast; rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun p _ => by ring
  have hs2 : ∑ p : Fin m × Fin n,
      (((updS b h σ p).val : ℤ) - (b p).val) * ((2 ^ (finProdFinEquiv p).val : ℕ) : ℤ) =
      ((sidx σ : ℤ) - sidx (Butterfly.slotBits b h)) * ((2 ^ (n * h.val) : ℕ) : ℤ) := by
    rw [Fintype.sum_prod_type, Finset.sum_eq_single h]
    · unfold sidx Butterfly.slotBits updS
      push_cast
      rw [← Finset.sum_sub_distrib, Finset.sum_mul]
      refine Finset.sum_congr rfl fun c _ => ?_
      simp only [if_pos rfl, finProdFinEquiv_apply_val, if_true]
      rw [pow_add]; ring
    · intro r _ hr
      refine Finset.sum_eq_zero fun c _ => ?_
      simp [updS, hr]
    · simp
  linarith

@[simp] theorem length_mvL (X Y : ℕ) (zs : List GI) : (NLogN.KFB.mvL X Y zs).length = zs.length := by
  simp [NLogN.KFB.mvL]

theorem getD_mvL (X Y : ℕ) (zs : List GI) (k : ℕ) (hk : k < zs.length) :
    (NLogN.KFB.mvL X Y zs).getD k 0 = zs.getD (g4 X Y k) 0 := by
  simp [NLogN.KFB.mvL, List.getD_eq_getElem?_getD, hk]

theorem slotBits_updS {m n : ℕ} (b : Fin m × Fin n → Fin 2) (h : Fin m) (σ : Fin n → Fin 2) :
    Butterfly.slotBits (updS b h σ) h = σ := by
  funext c; simp [Butterfly.slotBits, updS]

theorem updS_slot {m n : ℕ} (b q : Fin m × Fin n → Fin 2) (h : Fin m)
    (hq : ∀ h', h' ≠ h → ∀ j, b (h', j) = q (h', j)) : updS b h (Butterfly.slotBits q h) = q := by
  funext ⟨r, c⟩
  by_cases hr : r = h
  · subst hr; simp [updS, Butterfly.slotBits]
  · simp [updS, hr, hq r hr c]

theorem den_child_mulVec {W m n : ℕ} (w : Fin W) (h : Fin m) (U : Butterfly.Op (Fin n))
    (x : Fin W × (Fin m × Fin n → Fin 2) → ℂ) (p : Fin W × (Fin m × Fin n → Fin 2)) :
    ((P8Lift.RStep.childR w h U).mulVec x) p =
      if p.1 = w then ∑ σ', U (Butterfly.slotBits p.2 h) σ' * x (w, updS p.2 h σ') else x p := by
  simp only [Matrix.mulVec, dotProduct, P8Lift.RStep.childR]
  by_cases hw : p.1 = w
  · rw [if_pos hw]
    let g : (Fin n → Fin 2) → Fin W × (Fin m × Fin n → Fin 2) := fun σ' => (w, updS p.2 h σ')
    have hg : Function.Injective g := by
      intro a b e
      have := congrArg (fun q => Butterfly.slotBits q.2 h) e
      simpa [g, slotBits_updS] using this
    rw [← Finset.sum_subset (Finset.subset_univ (Finset.univ.image g)), Finset.sum_image
      (fun a _ b _ e => hg e)]
    · refine Finset.sum_congr rfl fun σ' _ => ?_
      have hag : ∀ h', h' ≠ h → ∀ j, p.2 (h', j) = updS p.2 h σ' (h', j) := by
        intro h' hh j; simp [updS, hh]
      simp only [g, hw, if_true, if_pos hag, slotBits_updS]
    · rintro ⟨q1, q2⟩ _ hq
      by_cases h1 : p.1 = q1
      · rw [if_pos h1, if_pos hw]
        by_cases hag : ∀ h', h' ≠ h → ∀ j, p.2 (h', j) = q2 (h', j)
        · exfalso; apply hq
          refine Finset.mem_image.2 ⟨Butterfly.slotBits q2 h, Finset.mem_univ _, ?_⟩
          simp only [g, updS_slot _ _ _ hag]; rw [← hw, h1]
        · rw [if_neg hag, zero_mul]
      · rw [if_neg h1, zero_mul]
  · rw [if_neg hw, Finset.sum_eq_single p]
    · simp [hw]
    · rintro ⟨q1, q2⟩ _ hq
      by_cases h1 : p.1 = q1
      · rw [if_pos h1, if_neg hw, if_neg, zero_mul]
        intro h2; exact hq (Prod.ext h1.symm h2.symm)
      · rw [if_neg h1, zero_mul]
    · simp

theorem getD_chL (N off q M : ℕ) (F : List GI → List GI) (zs : List GI)
    (hF : (F (NLogN.KFB.mvL M q ((zs.drop off).take N))).length = N) (h : off + N ≤ zs.length) (i : ℕ) :
    (chL N off q M F zs).getD i 0 =
      if off ≤ i ∧ i < off + N then (NLogN.KFB.mvL q M (F (NLogN.KFB.mvL M q ((zs.drop off).take N)))).getD (i - off) 0
      else zs.getD i 0 := by
  have ht : (zs.take off).length = off := by simp; omega
  have hm : (NLogN.KFB.mvL q M (F (NLogN.KFB.mvL M q ((zs.drop off).take N)))).length = N := by rw [length_mvL, hF]
  unfold chL
  by_cases h1 : i < off
  · rw [if_neg (by omega), List.getD_append _ _ _ _ (by omega), getD_take' _ _ _ h1]
  rw [List.getD_append_right _ _ _ _ (by omega), ht]
  by_cases h2 : i < off + N
  · rw [if_pos ⟨by omega, h2⟩, List.getD_append _ _ _ _ (by omega)]
  · rw [if_neg (by omega), List.getD_append_right _ _ _ _ (by omega), hm, NLogN.KFB.getD_drop']
    congr 1; omega

theorem length_chL (N off q M : ℕ) (F : List GI → List GI) (zs : List GI)
    (hF : (F (NLogN.KFB.mvL M q ((zs.drop off).take N))).length = N) (h : off + N ≤ zs.length) :
    (chL N off q M F zs).length = zs.length := by
  unfold chL; simp only [List.length_append, length_mvL, hF, List.length_take, List.length_drop]
  omega

/-- Index arithmetic of the two field moves. -/
theorem g4_child (q M j s' : ℕ) (hq : 0 < q) (hM : 0 < M) (hs : s' < q) :
    g4 M q ((j / (q * M) * M + j % M) * q + s') = (j / (q * M) * q + s') * M + j % M := by
  unfold g4
  have hjM := Nat.mod_lt j hM
  have e1 : ((j / (q * M) * M + j % M) * q + s') % q = s' := by
    rw [Nat.mul_comm, Nat.mul_add_mod, Nat.mod_eq_of_lt hs]
  have e2 : ((j / (q * M) * M + j % M) * q + s') / q = j / (q * M) * M + j % M := by
    rw [Nat.mul_comm, Nat.mul_add_div hq, Nat.div_eq_of_lt hs, add_zero]
  have e3 : ((j / (q * M) * M + j % M) * q + s') / (M * q) = j / (q * M) := by
    rw [Nat.mul_comm M q, ← Nat.div_div_eq_div_mul, e2, Nat.mul_comm (j / (q * M)) M, Nat.mul_add_div hM,
      Nat.div_eq_of_lt hjM, add_zero]
  have e4 : (j / (q * M) * M + j % M) % M = j % M := by
    rw [Nat.mul_comm, Nat.mul_add_mod, Nat.mod_mod]
  rw [e1, e3, e2, e4]

theorem aidx_updS_g4 {m n : ℕ} (b : Fin m × Fin n → Fin 2) (h : Fin m) (σ : Fin n → Fin 2) :
    aidx (updS b h σ) = (aidx b / (2 ^ n * 2 ^ (n * h.val)) * 2 ^ n + sidx σ) * 2 ^ (n * h.val) +
      aidx b % 2 ^ (n * h.val) := by
  have H := aidx_updS b h σ
  have hs := aidx_slot b h
  have d1 := Nat.div_add_mod (aidx b) (2 ^ (n * h.val))
  have d2 := Nat.div_add_mod (aidx b / 2 ^ (n * h.val)) (2 ^ n)
  rw [Nat.div_div_eq_div_mul, hs, Nat.mul_comm (2 ^ (n * h.val))] at d2
  zify at d1 d2 ⊢
  push_cast at H d1 d2 ⊢
  generalize (aidx b : ℤ) = J at *
  generalize ((aidx b / 2 ^ (n * h.val) : ℕ) : ℤ) = D at *
  linear_combination H - (2 : ℤ) ^ (n * h.val) * d2 - d1

end NLogN.KFB

