    (hn : n.Clean) (hnok : n.ok s) (hN : n.eval s = N) (hw : i ∉ body.writes)
    (ha : s.G a = .int a0 :: La)
    (hb : ∀ k < N, body.ok (NLogN.KFM.lpSt s i a La N k (NLogN.KFM.accSeq G a0 k)) ∧
