  rw [lab2, Φ₂_low h.hS h.hSi, redM_pswQ_one]

/-- Stage-one move condition. -/
theorem hE1 {b : ℕ} (hb : b < 1771) :
    ∀ chk ∈ cs1, ∀ mv ∈ chk.2.1, edgeMat N (ch.e1 b mv.2 chk.1) * lab1 ch N b mv.2 = lab1 ch N b chk.1 := by
