section HasValue

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

theorem hasValue_smul (g : SemilinearAut K F) {v : Place K F} {x : F} {a : K} (h : v.HasValue x a) :
    (g • v).HasValue (g • x) (SemilinearAut.baseAut g a) := by
  obtain ⟨hx, hres⟩ := h
  have hmem : g • x ∈ (g • v).toValuationSubring := by
    rw [SemilinearAut.smul_toValuationSubring]
    exact ValuationSubring.smul_mem_pointwise_smul g x v.toValuationSubring hx
  refine ⟨hmem, ?_⟩

  have key : residue (g • v).toValuationSubring ⟨g • x, hmem⟩ =
      SemilinearAut.smulResidueRingEquiv g v (residue v.toValuationSubring ⟨x, hx⟩) := by
    show _ = IsLocalRing.ResidueField.mapEquiv _ (IsLocalRing.residue _ _)
    rw [IsLocalRing.ResidueField.mapEquiv_apply, IsLocalRing.ResidueField.map_residue]
    rfl
  rw [key, hres, SemilinearAut.smulResidueRingEquiv_algebraMap]

end HasValue

