/-- A separating finite transcendence basis yields formal smoothness over the field generated
by all but one parameter. -/
lemma formallySmooth_of_one_parameter_basis
    (K F : Type u) [Field K] [Field F] [Algebra K F]
    (S T : Finset F) (x : S)
    (hb : IsTranscendenceBasis K ((↑) : S → F))
    (hT : (T : Set F) = (S : Set F) \ {x.val})
    [Algebra.IsSeparable (IntermediateField.adjoin K (S : Set F)) F] :
    Algebra.FormallySmooth (IntermediateField.adjoin K (T : Set F)) F := by
  classical
  let L := IntermediateField.adjoin K (T : Set F)
  let M := IntermediateField.adjoin L ({x.val} : Set F)
  have hset : (T : Set F) ∪ {x.val} = (S : Set F) := by
    rw [hT]
    exact Set.diff_union_of_subset (Set.singleton_subset_iff.mpr x.property)
  have hM : M.restrictScalars K = IntermediateField.adjoin K (S : Set F) := by
    rw [IntermediateField.adjoin_adjoin_left, hset]
  let e : (IntermediateField.adjoin K (S : Set F)) ≃+* M :=
    (IntermediateField.equivOfEq hM.symm).toRingEquiv
  have he : (algebraMap M F).comp e.toRingHom =
      (RingEquiv.refl F).toRingHom.comp
        (algebraMap (IntermediateField.adjoin K (S : Set F)) F) := by
    exact RingHom.ext (fun _ => rfl)
  letI : Algebra.IsSeparable M F :=
    Algebra.IsSeparable.of_equiv_equiv e (RingEquiv.refl F) he
  have hsep : Algebra.IsSeparable
      (IntermediateField.adjoin L (Set.range (fun _ : Unit => x.val))) F := by
    rw [Set.range_const]
    infer_instance
  letI := hsep
  exact Algebra.FormallySmooth.of_algebraicIndependent_of_isSeparable
    (one_parameter_basis K F S T x hb hT).1

end PhilipponAlterationProjection



