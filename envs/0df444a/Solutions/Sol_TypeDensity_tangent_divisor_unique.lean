    · exact heq
    · exact absurd (hM.1.trans (Ideal.pow_le_pow_right hgt)) hM'.2
  subst hdd
  refine ⟨rfl, ?_⟩
  obtain ⟨f, H, hJ, ⟨hH0, hHd, hHnone, hHfac⟩, hf⟩ := h
  obtain ⟨f', H', hJ', ⟨hH0', hHd', hHnone', hHfac'⟩, hf'⟩ := h'
  have hass : Associated f f' := by
    rw [← Ideal.span_singleton_eq_span_singleton, ← hJ, ← hJ']
  obtain ⟨u, hu⟩ := hass
  have hfm : f ∈ m ^ d := hM.1 (hJ ▸ Ideal.subset_span rfl)
  have hsurj : Function.Surjective (IsLocalRing.residue R) := Ideal.Quotient.mk_surjective
  have hrr : ∀ c, IsLocalRing.residue R (TypeDensity.residueRepresentative R c) = c := fun c =>
    Function.invFun_eq (hsurj c)
  set ub := IsLocalRing.residue R (u : R) with hub
  set w := TypeDensity.residueRepresentative R ub with hw
  have huw : (u : R) - w ∈ m := by
    rw [hm, ← IsLocalRing.ker_residue, RingHom.mem_ker, map_sub, hw, hrr, sub_self]
  have hdiff : TypeDensity.tangentLift O R S d H' - w * TypeDensity.tangentLift O R S d H ∈ m ^ (d+1) := by
    have e : TypeDensity.tangentLift O R S d H' - w * TypeDensity.tangentLift O R S d H =
      -(f' - TypeDensity.tangentLift O R S d H') + f * ((u : R) - w) + w * (f - TypeDensity.tangentLift O R S d H) := by
      rw [← hu]; ring
    rw [e]
    refine Ideal.add_mem _ (Ideal.add_mem _ (neg_mem hf') ?_) (Ideal.mul_mem_left _ _ hf)
    rw [pow_succ]
    exact Ideal.mul_mem_mul hfm huw
  have : (Ideal.span ({S.t, S.x} : Set R)).IsMaximal := by
    rw [S.parameters]; exact IsLocalRing.maximalIdeal.isMaximal R
  have hcoef : ∀ i : Fin (d+1),
      TypeDensity.residueRepresentative R (H'.coeff i.val) - w * TypeDensity.residueRepresentative R (H.coeff i.val) ∈
        m := by
    by_contra! hcon
    obtain ⟨i₀, hi₀⟩ := hcon
    rw [hm, ← S.parameters] at hi₀
    refine TypeDensity.homogeneous_form_not_mem_pow_succ R S.t S.x hreg d (fun i ↦ TypeDensity.residueRepresentative R
      (H'.coeff i.val) - w * TypeDensity.residueRepresentative R (H.coeff i.val)) i₀ hi₀ ?_
    rw [S.parameters]
    convert hdiff using 1
    unfold TypeDensity.tangentLift
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun i _ ↦ by ring
  have hub0 : ub ≠ 0 := by
    rw [hub]; exact (u.isUnit.map (IsLocalRing.residue R)).ne_zero
  have hHH : H' = Polynomial.C ub * H := by
