    (hle : ∀ y ∈ KG, sfun j q y ≤ sfun j' q' y) {R : ℝ} (hR : 3 < R) :
    bfun j' q' R ≤ bfun j q R := by
  have hK := Kfun_mono (j := j) (j' := j') hqc hq'c hq hAq hq'' hAq' hle hR
  have hY : 0 < Y R := Y_pos (le_of_lt hR)
  have h := mul_le_mul_of_nonpos_left hK (by linarith : -Y R ≤ 0)
  unfold bfun
  linarith

