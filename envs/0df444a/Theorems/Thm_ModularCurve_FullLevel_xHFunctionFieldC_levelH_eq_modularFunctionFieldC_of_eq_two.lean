open ModularCurve ModularCurve.FullLevel

theorem ModularCurve.FullLevel.xHFunctionFieldC_levelH_eq_modularFunctionFieldC_of_eq_two
    (q : ℕ) [Fact q.Prime] (hq2 : q = 2) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (κ : Type) [Field κ] [CharP κ q] [IsAlgClosed κ] [DecidableEq κ] :
    xHFunctionFieldC κ (q ^ 2 * M') (levelH q M') = modularFunctionFieldC κ M' := by sorry
