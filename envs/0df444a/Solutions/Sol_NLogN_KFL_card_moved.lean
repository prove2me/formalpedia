    (hhy : 0 ≤ hy ∧ hy < 2 ^ (K - ρ)) (hhz : 0 ≤ hz ∧ hz < 2 ^ (K - ρ))
    (hu : ∀ i < f - 1, 0 ≤ u i ∧ u i < 2 ^ K) (hw : ∀ i < f - 1, 0 ≤ w i ∧ w i < 2 ^ K)
    (hu' : ∀ i < f - 1, 0 ≤ (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1 ∧
      (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1 < 2 ^ K)
    (hw' : ∀ i < f - 1, 0 ≤ (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2 ∧
      (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2 < 2 ^ K) :
    pline K ρ f x l (packed K ρ (f - 1) loy u hy, packed K ρ (f - 1) loz w hz) =
      (packed K ρ (f - 1) loy (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).1) hy,
       packed K ρ (f - 1) loz (fun i => (l.apply (Butterfly.ctl K ρ x i) (u i, w i)).2) hz) := by
