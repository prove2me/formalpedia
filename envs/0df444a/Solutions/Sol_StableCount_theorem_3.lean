theorem hR1 : hR 1 = 346573640280 / 10 ^ 12 := by rw [hR_small 1 (by norm_num), hp1]; norm_num
theorem hR2 : hR 2 = 156726247027 / 10 ^ 12 := by rw [hR_small 2 (by norm_num), hp2]; norm_num
