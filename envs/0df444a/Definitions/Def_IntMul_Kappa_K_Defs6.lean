section
-- Source module: Solutions.NetComplexOrtho
/-!
# Orthonormal bases of binary symmetric spaces (end of the proof of Lemma 6)

On `V = ι → 𝔽₂` with the dot product: every subspace `E` that is nondegenerate and either zero
or nonalternating (contains a vector of norm one) has an orthonormal basis: a finite set of
pairwise orthogonal norm-one vectors spanning `E`; its cardinality is `dim E`.

The proof follows the paper: pick a unit vector `w₀ ∈ E`. If `E ∩ w₀^⊥` is zero or
nonalternating, split off `w₀`. Otherwise `E ∩ w₀^⊥` is alternating, nonzero and
nondegenerate; choose `a, b` in it with `a · b = 1`; then `w = w₀ + a` is a unit vector and
`w₀ + b` is a unit vector orthogonal to `w`, so `E ∩ w^⊥` is nonalternating. Split off `w` and
recurse (`E ∩ w^⊥` is nondegenerate and has dimension `dim E - 1`).
-/

set_option linter.unusedSectionVars false

namespace NetComplexOrtho

open Matrix Finset Module

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma zmod2_add_self (a : ZMod 2) : a + a = 0 := by revert a; decide

lemma zmod2_cases (a : ZMod 2) : a = 0 ∨ a = 1 := by revert a; decide

/-- Nondegeneracy of a subspace for the dot product. -/
def Nondeg (E : Submodule (ZMod 2) (ι → ZMod 2)) : Prop :=
  ∀ x ∈ E, (∀ y ∈ E, x ⬝ᵥ y = 0) → x = 0

/-- The hyperplane `w^⊥`. -/
def perp (w : (ι → ZMod 2)) : Submodule (ZMod 2) (ι → ZMod 2) where
  carrier := {y | w ⬝ᵥ y = 0}
  add_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq] at *
    rw [dotProduct_add, ha, hb, add_zero]
  zero_mem' := by simp
  smul_mem' c x hx := by
    simp only [Set.mem_ofPred_eq] at *
    rw [dotProduct_smul, hx, smul_zero]

lemma mem_perp {w y : (ι → ZMod 2)} : y ∈ perp w ↔ w ⬝ᵥ y = 0 := Iff.rfl

lemma norm_add (x y : (ι → ZMod 2)) : (x + y) ⬝ᵥ (x + y) = x ⬝ᵥ x + y ⬝ᵥ y := by
  rw [add_dotProduct, dotProduct_add, dotProduct_add, dotProduct_comm y x]
  have := NetComplexOrtho.zmod2_add_self (x ⬝ᵥ y)
  linear_combination this

/-- `E = ⟨w⟩ + (E ∩ w^⊥)` for a unit `w ∈ E`. -/
lemma split (E : Submodule (ZMod 2) (ι → ZMod 2)) {w : (ι → ZMod 2)} (hw : w ∈ E) (hww : w ⬝ᵥ w = 1) :
    E = (Submodule.span (ZMod 2) {w}) ⊔ (E ⊓ perp w) := by
  apply le_antisymm
  · intro y hy
    have : y = (w ⬝ᵥ y) • w + (y - (w ⬝ᵥ y) • w) := by abel
    rw [this]
    refine Submodule.add_mem_sup (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self w))
      ⟨E.sub_mem hy (E.smul_mem _ hw), ?_⟩
    show w ⬝ᵥ _ = 0
    rw [dotProduct_sub, dotProduct_smul, hww, smul_eq_mul, mul_one, sub_self]
  · exact sup_le ((Submodule.span_singleton_le_iff_mem _ _).2 hw) inf_le_left

lemma nondeg_perp (E : Submodule (ZMod 2) (ι → ZMod 2)) (hE : Nondeg E) {w : (ι → ZMod 2)} (hw : w ∈ E)
    (hww : w ⬝ᵥ w = 1) : Nondeg (E ⊓ perp w) := by
  intro x hx hxy
  apply hE x hx.1
  intro y hy
  have hy' := hy
  rw [split E hw hww] at hy'
  obtain ⟨p, hp, q, hq, rfl⟩ := Submodule.mem_sup.1 hy'
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hp
  rw [dotProduct_add, hxy q hq, dotProduct_smul, dotProduct_comm, hx.2, smul_zero, add_zero]

lemma finrank_perp (E : Submodule (ZMod 2) (ι → ZMod 2)) {w : (ι → ZMod 2)} (hw : w ∈ E) (hww : w ⬝ᵥ w = 1) :
    finrank (ZMod 2) ↥(E ⊓ perp w) + 1 = finrank (ZMod 2) E := by
  have hw0 : w ≠ 0 := by rintro rfl; simp at hww
  have hdisj : (Submodule.span (ZMod 2) {w}) ⊓ (E ⊓ perp w) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨hx1, hx2⟩ := Submodule.mem_inf.1 hx
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hx1
    have : w ⬝ᵥ (c • w) = 0 := (Submodule.mem_inf.1 hx2).2
    rw [dotProduct_smul, hww, smul_eq_mul, mul_one] at this
    simp [this]
  have := Submodule.finrank_sup_add_finrank_inf_eq (Submodule.span (ZMod 2) {w}) (E ⊓ perp w)
  rw [← split E hw hww, hdisj, finrank_bot, add_zero, finrank_span_singleton hw0] at this
  omega

/-- The key step: a unit vector `w ∈ E` such that `E ∩ w^⊥` is zero or nonalternating. -/
lemma good_unit (E : Submodule (ZMod 2) (ι → ZMod 2)) (hE : Nondeg E) {w₀ : (ι → ZMod 2)} (hw₀ : w₀ ∈ E)
    (hn₀ : w₀ ⬝ᵥ w₀ = 1) :
    ∃ w ∈ E, w ⬝ᵥ w = 1 ∧ (E ⊓ perp w = ⊥ ∨ ∃ c ∈ E ⊓ perp w, c ⬝ᵥ c = 1) := by
  by_cases h : E ⊓ perp w₀ = ⊥ ∨ ∃ c ∈ E ⊓ perp w₀, c ⬝ᵥ c = 1
  · exact ⟨w₀, hw₀, hn₀, h⟩
  push Not at h
  obtain ⟨hne, halt⟩ := h
  obtain ⟨a, ha, ha0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  have hnd := nondeg_perp E hE hw₀ hn₀
  have : ¬ ∀ y ∈ E ⊓ perp w₀, a ⬝ᵥ y = 0 := fun hall => ha0 (hnd a ha hall)
  push Not at this
  obtain ⟨b, hb, hab⟩ := this
  have hab1 : a ⬝ᵥ b = 1 := (NetComplexOrtho.zmod2_cases _).resolve_left hab
  have hzero : ∀ c ∈ E ⊓ perp w₀, c ⬝ᵥ c = 0 := fun c hc =>
    (NetComplexOrtho.zmod2_cases _).resolve_right (halt c hc)
  refine ⟨w₀ + a, E.add_mem hw₀ ha.1, ?_, Or.inr ⟨w₀ + b, ⟨E.add_mem hw₀ hb.1, ?_⟩, ?_⟩⟩
  · rw [norm_add, hn₀, hzero a ha, add_zero]
  · show (w₀ + a) ⬝ᵥ (w₀ + b) = 0
    rw [add_dotProduct, dotProduct_add, dotProduct_add, hn₀, mem_perp.1 hb.2,
      dotProduct_comm a w₀, mem_perp.1 ha.2, hab1]
    decide
  · rw [norm_add, hn₀, hzero b hb, add_zero]

/-- An orthonormal family. -/
def Orthonormal2 (B : Finset (ι → ZMod 2)) : Prop :=
  (∀ b ∈ B, b ⬝ᵥ b = 1) ∧ ∀ b ∈ B, ∀ c ∈ B, b ≠ c → b ⬝ᵥ c = 0

/-- **Orthonormal basis theorem over `𝔽₂`.** A nondegenerate subspace that is zero or contains
a vector of norm one has an orthonormal basis. -/
theorem exists_orthonormal_basis :
    ∀ (n : ℕ) (E : Submodule (ZMod 2) (ι → ZMod 2)), finrank (ZMod 2) E = n → Nondeg E →
      (E = ⊥ ∨ ∃ x ∈ E, x ⬝ᵥ x = 1) →
      ∃ B : Finset (ι → ZMod 2), (∀ b ∈ B, b ∈ E) ∧ Orthonormal2 B ∧ Submodule.span (ZMod 2) ↑B = E := by
  intro n
  induction n with
  | zero =>
    intro E hn _ _
    refine ⟨∅, by simp, ⟨by simp, by simp⟩, ?_⟩
    rw [Finset.coe_empty, Submodule.span_empty]
    exact (Submodule.finrank_eq_zero.1 hn).symm
  | succ n ih =>
    intro E hn hE hcase
    rcases hcase with hbot | ⟨w₀, hw₀, hn₀⟩
    · rw [hbot, finrank_bot] at hn; omega
    obtain ⟨w, hw, hww, hgood⟩ := good_unit E hE hw₀ hn₀
    have hfin := finrank_perp E hw hww
    obtain ⟨B, hBE, ⟨hB1, hB2⟩, hBspan⟩ :=
      ih (E ⊓ perp w) (by omega) (nondeg_perp E hE hw hww) hgood
    have hwB : w ∉ B := fun h => by
      have : w ⬝ᵥ w = 0 := (hBE w h).2
      rw [hww] at this
      exact one_ne_zero this
    refine ⟨insert w B, ?_, ⟨?_, ?_⟩, ?_⟩
    · intro b hb
      rcases Finset.mem_insert.1 hb with rfl | hb
      · exact hw
      · exact (hBE b hb).1
    · intro b hb
      rcases Finset.mem_insert.1 hb with rfl | hb
      · exact hww
      · exact hB1 b hb
    · intro b hb c hc hbc
      rcases Finset.mem_insert.1 hb with e1 | hb' <;> rcases Finset.mem_insert.1 hc with e2 | hc'
      · exact absurd (e1.trans e2.symm) hbc
      · subst e1; exact (hBE c hc').2
      · subst e2; rw [dotProduct_comm]; exact (hBE b hb').2
      · exact hB2 b hb' c hc' hbc
    · rw [Finset.coe_insert, Submodule.span_insert, hBspan, ← split E hw hww]

/-- An orthonormal family is linearly independent. -/
theorem orthonormal_linearIndependent {B : Finset (ι → ZMod 2)} (hB : Orthonormal2 B) :
    LinearIndependent (ZMod 2) ((↑) : B → (ι → ZMod 2)) := by
  rw [linearIndependent_iff']
  intro s g hg i hi
  have := congrArg (fun x => (i : (ι → ZMod 2)) ⬝ᵥ x) hg
  simp only [dotProduct_sum, dotProduct_smul, dotProduct_zero, smul_eq_mul] at this
  rw [Finset.sum_eq_single i] at this
  · rwa [hB.1 i i.2, mul_one] at this
  · intro j _ hji
    rw [hB.2 i i.2 j j.2 (fun e => hji (Subtype.ext e.symm)), mul_zero]
  · intro h; exact absurd hi h

/-- **Orthonormal basis theorem, with cardinality.** -/
theorem exists_orthonormal_basis_card (E : Submodule (ZMod 2) (ι → ZMod 2)) (hE : Nondeg E)
    (hcase : E = ⊥ ∨ ∃ x ∈ E, x ⬝ᵥ x = 1) :
    ∃ B : Finset (ι → ZMod 2), (∀ b ∈ B, b ∈ E) ∧ Orthonormal2 B ∧ Submodule.span (ZMod 2) ↑B = E ∧
      B.card = finrank (ZMod 2) E := by
  obtain ⟨B, h1, h2, h3⟩ := exists_orthonormal_basis _ E rfl hE hcase
  refine ⟨B, h1, h2, h3, ?_⟩
  rw [← h3, finrank_span_set_eq_card (orthonormal_linearIndependent h2)]
  simp

end NetComplexOrtho

end

section
-- Source module: Solutions.NetComplexLabels
/-!
# Labels of the complex network over `𝔽₂` (§3.3, §3.5)

The label field of the complex construction is `F = 𝔽₂^h` with the ordinary dot product
(`NetLabels.bf` with Gram matrix `1`), and `F^{⊗3}` with Gram `1 ⊗ 1 ⊗ 1 = 1`.

1. `bf_one`: `bf 1 x y = x · y`; `nondegOn_one_iff`: `NondegOn 1 = NetComplexOrtho.Nondeg`.
2. Triples: `t_T · t_T = 1`, distinct triples with even intersection are orthogonal, triple
   lines are nondegenerate; `u_a · u_a = 1` for `u_a = t_{a₁} ⊗ t_{a₂} ⊗ t_{a₃}`, `U_a`
   nondegenerate; tensor products of nondegenerate labels are nondegenerate.
3. Projections through orthonormal bases: `P_E x = ∑_{v ∈ B} (v · x) v`; for nested
   nondegenerate labels `U ≤ V` whose residual `E = V ∩ U^⊥` has an orthonormal basis `B`,
   `q_V(x) - q_U(x) ≡ ∑_{v∈B} wt(v)[v·x] (mod 4)` with `q_U(x) = wt(P_U x)`.
4. Terminal labels: `q_0 = 0`, `q_F = wt`, and for a unit line `U = ⟨u⟩` with odd weight,
   `q_{U^⊥}(x) - q_U(x) ≡ wt(x) + 2[u·x] (mod 4)` — the hypotheses of
   `NetComplexInterface.phase_interface_full` / `phase_interface_mixed`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace NetComplexLabels

open Matrix Finset Module NetLabels NetComplexPhase
open scoped Kronecker

/-! ## 1. The dot product as a label form -/

section Dot

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

lemma bf_one (x y : ι → ZMod 2) : bf (1 : Matrix ι ι (ZMod 2)) x y = x ⬝ᵥ y := by
  simp [bf]

lemma one_isSymm : (1 : Matrix ι ι (ZMod 2)).IsSymm := Matrix.isSymm_one

lemma nondegOn_one_iff (E : Submodule (ZMod 2) (ι → ZMod 2)) :
    NondegOn (1 : Matrix ι ι (ZMod 2)) E ↔ NetComplexOrtho.Nondeg E := by
  simp only [NondegOn, NetComplexOrtho.Nondeg, bf_one]

lemma mem_orth_one {U : Submodule (ZMod 2) (ι → ZMod 2)} {y : ι → ZMod 2} :
    y ∈ orth (1 : Matrix ι ι (ZMod 2)) U ↔ ∀ x ∈ U, x ⬝ᵥ y = 0 := by
  rw [mem_orth]; simp only [bf_one]

end Dot

/-! ## 2. Triples over `𝔽₂` -/

section Triples

variable {h : ℕ}

lemma dot_ind (S T : Finset (Fin h)) :
    ind (ZMod 2) S ⬝ᵥ ind (ZMod 2) T = ((S ∩ T).card : ZMod 2) :=
  ind_dotProduct_ind S T

/-- `t_T · t_T = 1` for a triple. -/
theorem dot_triple_self (T : Finset (Fin h)) (hT : T.card = 3) :
    ind (ZMod 2) T ⬝ᵥ ind (ZMod 2) T = 1 := by
  rw [dot_ind, Finset.inter_self, hT]; rfl

/-- Complex neighbours (even intersection) are orthogonal. -/
theorem dot_triple_neighbors (S T : Finset (Fin h)) (hST : (S ∩ T).card % 2 = 0) :
    ind (ZMod 2) S ⬝ᵥ ind (ZMod 2) T = 0 := by
  rw [dot_ind, ZMod.natCast_eq_zero_iff]; omega

end Triples

/-! ## 3. Projections through orthonormal bases and the phase difference -/

section Proj

variable {m : ℕ}

lemma vmv (v y : (Fin m → ZMod 2)) : Matrix.vecMulVec v v *ᵥ y = (v ⬝ᵥ y) • v := by
  funext i
  simp only [Matrix.mulVec, Matrix.vecMulVec, dotProduct, Matrix.of_apply, Pi.smul_apply,
    smul_eq_mul, Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  ring

/-- `P_E x = ∑_{v ∈ B} (v · x) v` for an orthonormal basis `B` of `E`. -/
theorem proj_eq_sum (E : Submodule (ZMod 2) (Fin m → ZMod 2)) (hE : NondegOn (1 : Matrix (Fin m) (Fin m) _) E)
    (B : Finset (Fin m → ZMod 2)) (hBE : ∀ b ∈ B, b ∈ E) (hB : NetComplexOrtho.Orthonormal2 B)
    (hspan : Submodule.span (ZMod 2) (↑B : Set (Fin m → ZMod 2)) = E) (x : (Fin m → ZMod 2)) :
    proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) E *ᵥ x = ∑ v ∈ B, (v ⬝ᵥ x) • v := by
  have hP := proj_unique one_isSymm hE (∑ v ∈ B, Matrix.vecMulVec v v) ?_ ?_
  · rw [← hP, Matrix.sum_mulVec]
    refine Finset.sum_congr rfl fun v _ => ?_
    rw [vmv]
  · intro y
    rw [Matrix.sum_mulVec]
    exact E.sum_mem fun v hv => by
      rw [vmv]
      exact E.smul_mem _ (hBE v hv)
  · intro y
    rw [mem_orth_one]
    intro z hz
    rw [← hspan] at hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      rw [dotProduct_sub, Matrix.sum_mulVec, dotProduct_sum]
      rw [Finset.sum_eq_single z]
      · rw [vmv, dotProduct_smul, hB.1 z hz, smul_eq_mul, mul_one, dotProduct_comm, sub_self]
      · intro v hv hvz
        rw [vmv, dotProduct_smul, hB.2 z hz v hv (Ne.symm hvz), smul_zero]
      · intro h; exact absurd hz h
    | zero => simp
    | add a b _ _ ha hb => rw [add_dotProduct, ha, hb, add_zero]
    | smul c a _ ha => rw [smul_dotProduct, ha, smul_zero]

/-- The phase label `q_U(x) = wt(P_U x) mod 4`. -/
noncomputable def qL (U : Submodule (ZMod 2) (Fin m → ZMod 2)) (x : (Fin m → ZMod 2)) : ZMod 4 :=
  (NetComplexPhase.wt (proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) U *ᵥ x) : ZMod 4)

/-- **Phase difference along an edge.** For nested nondegenerate labels `U ≤ V` whose
residual `E = V ∩ U^⊥` has an orthonormal basis `B`,
`q_V(x) - q_U(x) ≡ ∑_{v ∈ B} wt(v) [v · x] (mod 4)`. -/
theorem qL_diff (U V : Submodule (ZMod 2) (Fin m → ZMod 2))
    (hU : NondegOn (1 : Matrix (Fin m) (Fin m) (ZMod 2)) U)
    (hV : NondegOn (1 : Matrix (Fin m) (Fin m) (ZMod 2)) V) (hUV : U ≤ V)
    (B : Finset (Fin m → ZMod 2)) (hBE : ∀ b ∈ B, b ∈ V ⊓ orth 1 U) (hB : NetComplexOrtho.Orthonormal2 B)
    (hspan : Submodule.span (ZMod 2) (↑B : Set (Fin m → ZMod 2)) = V ⊓ orth 1 U) (x : (Fin m → ZMod 2)) :
    qL V x - qL U x = ((∑ v ∈ B, (v ⬝ᵥ x).val * NetComplexPhase.wt v : ℕ) : ZMod 4) := by
  have hE := nondeg_diff one_isSymm hU hV hUV
  have hPV : proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) V *ᵥ x =
      proj 1 U *ᵥ x + ∑ v ∈ B, (v ⬝ᵥ x) • v := by
    rw [← proj_eq_sum _ hE B hBE hB hspan, ← proj_sub_proj one_isSymm hU hV hUV,
      Matrix.sub_mulVec]
    abel
  rw [qL, qL, hPV, wt_orth_sum]
  · ring
  · intro v hv
    exact (mem_orth_one.1 (hBE v hv).2) _ (proj_mulVec_mem one_isSymm hU x)
  · exact fun j hj k hk hjk => hB.2 j hj k hk hjk

/-- `q_0 = 0`. -/
theorem qL_bot (x : (Fin m → ZMod 2)) : qL ⊥ x = 0 := by
  have : proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) ⊥ *ᵥ x = 0 := by
    have h := proj_mulVec_mem (G := (1 : Matrix (Fin m) (Fin m) (ZMod 2))) one_isSymm
      (U := ⊥) (fun y hy _ => (Submodule.mem_bot _).1 hy) x
    exact (Submodule.mem_bot _).1 h
  rw [qL, this]
  simp [NetComplexPhase.wt, supp]

/-- `q_F = wt`. -/
theorem qL_top (x : (Fin m → ZMod 2)) : qL ⊤ x = (NetComplexPhase.wt x : ZMod 4) := by
  have hT : NondegOn (1 : Matrix (Fin m) (Fin m) (ZMod 2)) ⊤ := by
    intro y _ hy
    funext i
    have := hy (Pi.single i 1) Submodule.mem_top
    rw [bf_one, dotProduct_single, mul_one] at this
    exact this
  rw [qL, proj_mulVec_of_mem one_isSymm hT Submodule.mem_top]

/-- The projection onto a unit line: `P_{⟨u⟩} x = (u · x) u`. -/
theorem proj_line (u : (Fin m → ZMod 2)) (hu : u ⬝ᵥ u = 1) (x : (Fin m → ZMod 2)) :
    proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) (ZMod 2 ∙ u) *ᵥ x = (u ⬝ᵥ x) • u := by
  have hE : NondegOn (1 : Matrix (Fin m) (Fin m) (ZMod 2)) (ZMod 2 ∙ u) :=
    nondegOn_span_singleton _ (by rw [bf_one, hu]; decide)
  rw [proj_eq_sum _ hE {u} (by simp [Submodule.mem_span_singleton_self])
    ⟨by simp [hu], by simp⟩ (by simp), Finset.sum_singleton]

/-- `P_{⟨u⟩^⊥} x = x + (u · x) u` over `𝔽₂`. -/
theorem proj_line_perp (u : (Fin m → ZMod 2)) (hu : u ⬝ᵥ u = 1) (x : (Fin m → ZMod 2)) :
    proj (1 : Matrix (Fin m) (Fin m) (ZMod 2)) (orth 1 (ZMod 2 ∙ u)) *ᵥ x = x + (u ⬝ᵥ x) • u := by
  have hE : NondegOn (1 : Matrix (Fin m) (Fin m) (ZMod 2)) (ZMod 2 ∙ u) :=
    nondegOn_span_singleton _ (by rw [bf_one, hu]; decide)
  rw [proj_orth one_isSymm hE (by rw [det_one]; exact one_ne_zero), Matrix.sub_mulVec,
    Matrix.one_mulVec, proj_line u hu, sub_eq_add_neg]
  congr 1
  funext i
  simp only [Pi.neg_apply, Pi.smul_apply, smul_eq_mul]
  generalize u ⬝ᵥ x * u i = a
  exact (by decide : ∀ a : ZMod 2, -a = a) a

/-- **The pair `X_a → Y_a`.** For a unit vector `u` of odd weight (e.g. `u_a`, weight 27),
`q_{⟨u⟩^⊥}(x) - q_{⟨u⟩}(x) ≡ wt(x) + 2[u · x] (mod 4)`. -/
theorem qL_line_perp_diff (u : (Fin m → ZMod 2)) (hu : u ⬝ᵥ u = 1) (hodd : NetComplexPhase.wt u % 2 = 1) (x : (Fin m → ZMod 2)) :
    qL (orth 1 (ZMod 2 ∙ u)) x - qL (ZMod 2 ∙ u) x =
      ((NetComplexPhase.wt x + 2 * (u ⬝ᵥ x).val : ℕ) : ZMod 4) := by
  rw [qL, qL, proj_line_perp u hu, proj_line u hu]
  set c := u ⬝ᵥ x
  -- `x = (x + c u) + c u` with orthogonal summands
  have horth : (x + c • u) ⬝ᵥ (c • u) = 0 := by
    simp only [add_dotProduct, dotProduct_smul, smul_dotProduct, smul_eq_mul, hu, mul_one]
    rw [dotProduct_comm x u]
    show c * (c + c) = 0
    rw [NetComplexOrtho.zmod2_add_self, mul_zero]
  have hx := wt_add_mod4 (x + c • u) (c • u) horth
  have hxx : x + c • u + c • u = x := by
    rw [add_assoc, ← add_smul]
    have : c + c = 0 := NetComplexOrtho.zmod2_add_self c
    rw [this, zero_smul, add_zero]
  rw [hxx] at hx
  push_cast
  rw [hx, wt_smul]
  push_cast
  obtain ⟨k, hk⟩ : ∃ k, NetComplexPhase.wt u = 2 * k + 1 := ⟨NetComplexPhase.wt u / 2, by omega⟩
  rw [hk]
  push_cast
  ring_nf
  have h4 : (4 : ZMod 4) = 0 := rfl
  rcases NetComplexOrtho.zmod2_cases c with hc | hc
  · rw [hc]; simp
  · rw [hc]; simp; ring_nf; linear_combination (-1 - (k : ZMod 4)) * h4

end Proj

end NetComplexLabels

end


