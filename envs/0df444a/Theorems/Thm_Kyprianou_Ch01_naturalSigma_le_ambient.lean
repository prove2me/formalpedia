-- title:
--   The generated natural filtration is a sub-sigma-algebra of the ambient measurable space
-- statement:
--   If every process evaluation is measurable in the ambient sigma-algebra, then the raw natural sigma-algebra generated by observations through each time s is a sub-sigma-algebra of that ambient space.
-- source:
--   Kyprianou (2006) Chapter 1, natural-filtration framework for Lévy processes and stopping times.

import Mathlib
import Definitions.Def_Kyprianou_Ch01_McKeanBrownianStopping
import Definitions.Def_PerfCorrMSQ_NaturalFiltration
open MeasureTheory ProbabilityTheory Kyprianou.Ch01
open scoped NNReal ENNReal
set_option autoImplicit false

theorem Kyprianou.Ch01.naturalSigma_le_ambient
    {Ω : Type*} [MeasurableSpace Ω]
    (X : ℝ≥0 → Ω → ℝ)
    (hmeas : ∀ t : ℝ≥0, Measurable (X t))
    (s : ℝ≥0) :
    naturalSigma X s ≤ (inferInstance : MeasurableSpace Ω) := by sorry
