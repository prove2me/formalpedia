open IntMul IntMul.Kappa IntMul.Kappa.R6
open AModel AModelL12 IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFT NLogN.RS IntMul.HvdH IntMul.OpenAI.RT IntMul.OpenAI.RC IntMul.OpenAI.Glue IntMul.OpenAI.RCost NLogN.KFM Complex NLogN.KFZ
variable {E : ℕ} {ix : Ix6 (7 + E)} {Isym : List Sym} {tab : Fin 1 → IStmt HS 1}
  {extM : Fin E → IStmt HS (7 + E)} {Q : Q6} {D : ℕ}
  [instS : ∀ i, NeZero (Q.sB D i)] [instT : ∀ i, NeZero (Q.tB D i)]

theorem IntMul.Kappa.R6.mul_phase6 (C : BigCtx6 ix Isym tab extM Q D) (t : IState HS) (hR : Q.Base t) (x y : ℕ)
    (hx : x < 2 ^ Q.n) (hy : y < 2 ^ Q.n) (hA : t.G ARGM = [.int (y : ℤ), .int (x : ℤ)])
    (h0 : t.G 0 = []) (hW : t.G pW = []) :
    ∃ (zsZ : List GI) (Z Ux Uy : ((i : Fin (D + 1)) → ZMod (Q.sB D i)) → ℂ) (c : ℕ),
      IRuns Isym (IL.kTableP tab extM) (mulP6 ix) t
        (((t.upd ARGM []).upd pW []).upd 0 (ints (gflat zsZ))) c ∧
      RepPad Q.p (Q.sB D) (Q.tB D) zsZ Z ∧ GB (wU6 Q D) zsZ ∧
      ‖Z - Rperm (Q.sB D) (Q.tB D) (dftM (Q.sB D) (cnj (QA Q.p (Ux * Uy))))‖ ≤ Q.Es * hp Q.p ∧
      ‖Ux - Rperm (Q.sB D) (Q.tB D)
        (dftM (Q.sB D) (fun k => (2 : ℂ)⁻¹ ^ (Q.b + 2) * ubar6 C x k))‖ ≤ Q.Es * hp Q.p ∧
      ‖Uy - Rperm (Q.sB D) (Q.tB D)
        (dftM (Q.sB D) (fun k => (2 : ℂ)⁻¹ ^ (Q.b + 2) * ubar6 C y k))‖ ≤ Q.Es * hp Q.p ∧
      (c : ℝ) ≤ kMul6 C := by sorry
