  obtain ⟨A, hA⟩ := NLogN.KFN.prop14_il_complex (Isym := Isym) (iprog := iprog)
  refine ⟨A, _, NLogN.KFN.lam_complex_nonneg, NLogN.KFN.lam_complex_lt_one,
