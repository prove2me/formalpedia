-- Source module: NLogN.HFwW1
/-!
# Wrapping the Fermat convolution `fwP` as an abstract `LProg2` (part 1)

The frame (stacks outside `GL.myW`, values on top, arbitrary contents below):

* `KB = 32`: `2^P`, `KN = 33`: `2^fn`, `KR = 34`: `r`, `RW = 52`: `2^(2rP)`, `FR = 53`: `2^fn + 1`,
* `wLO = 35`: `2^logOuter`, `wKB = 36`: `kb`, `wKM = 37`: `K - 1`, `wSH = 38`: `2^(fn - logOuter)`,
* `wDS = 39`: `ints ((descs q.outerAxes 1).flatMap enc8) ++ _`.

Inputs `wI1 = GU = 45` (`gints U`), `wI2 = 40` (`gints V`), output `wO = 41`.

`fwWrap`: push copies of the registers `fwP` reads inside `myW`, move the descriptors from `wDS` to
`AXS` and `V` from `wI2` to `VI` (order preserving), run `fwP`, move the result from `OUT` to `wO`
and the descriptors back (order preserving), pop the copies.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.FWW

open IntMul IntMul.HvdH NLogN NLogN.FW

abbrev wLO : Fin HS := 35
abbrev wKB : Fin HS := 36
abbrev wKM : Fin HS := 37
abbrev wSH : Fin HS := 38
abbrev wDS : Fin HS := 39
abbrev wI1 : Fin HS := 45
abbrev wI2 : Fin HS := 40
abbrev wO : Fin HS := 41

/-- The frame the wrapper needs (only stacks outside `myW ++ [45, 40, 41]`). -/
structure FwCtx (q : Ref.Params) (kb : ℕ) (s : IState HS) : Prop where
  vKB : ∃ L, s.G NLogN.KB = .int (2 ^ q.P) :: L
  vKN : ∃ L, s.G NLogN.KN = .int (2 ^ q.fn) :: L
  vKR : ∃ L, s.G KR = .int (q.r : ℤ) :: L
  vRW : ∃ L, s.G RW = .int (2 ^ (2 * q.r * q.P)) :: L
  vFR : ∃ L, s.G FR = .int (2 ^ q.fn + 1) :: L
  vLO : ∃ L, s.G wLO = .int ((2 ^ q.logOuter : ℕ) : ℤ) :: L
  vKBR : ∃ L, s.G wKB = .int (kb : ℤ) :: L
  vKM : ∃ L, s.G wKM = .int ((q.K - 1 : ℕ) : ℤ) :: L
  vSH : ∃ L, s.G wSH = .int (2 ^ (q.fn - q.logOuter)) :: L
  vDS : ∃ R, s.G wDS = ints ((descs q.outerAxes 1).flatMap enc8) ++ R

/-- The precondition on the two inputs. -/
def FwPre (q : Ref.Params) (U V : List (ℤ × ℤ)) : Prop :=
  U.length = 2 ^ q.logOuter * q.r ∧ V.length = 2 ^ q.logOuter * q.r ∧
    (∀ z ∈ U, |z.1| < 2 ^ q.P ∧ |z.2| < 2 ^ q.P) ∧ (∀ z ∈ V, |z.1| < 2 ^ q.P ∧ |z.2| < 2 ^ q.P)

/-! ## Count expressions -/

/-- `2 · 2^logOuter · r`: the number of integers of a Gaussian list of length `T`. -/
def cT : Ex HS := .shl (.add (.reg wLO) (.reg wLO)) (.reg KR)

/-- `8 (K - 1)`: the number of descriptor integers. -/
def cD : Ex HS := .shl (.reg wKM) (.lit 8)

/-! ## Order-preserving transfers as `Spec`s -/

/-! ## Facts about `fermatW` -/

/-! ## The program -/

/-- Copies of the frame values into the registers `fwP` reads. -/
def pushL : List RM :=
  [.rs (.push CR (.reg NLogN.KB)), .rs (.push CM (.reg KR)), .rs (.push NLogN.FW.XN (.reg NLogN.KN)),
    .rs (.push XF (.reg FR)), .rs (.push NN (.reg wLO)), .rs (.push KBR (.reg wKB)),
    .rs (.push NAX (.reg wKM)), .rs (.push SH (.reg wSH))]

/-- Remove the copies. -/
def popL : List RM :=
  [.rs (.pop CR), .rs (.pop CM), .rs (.pop NLogN.FW.XN), .rs (.pop XF), .rs (.pop NN), .rs (.pop KBR),
    .rs (.pop NAX), .rs (.pop SH)]

/-- The core: descriptors to `AXS`, `V` to `VI`, `fwP`, result to `wO`, descriptors back. -/
def coreL : List RM :=
  [GL.xferP wDS AXS cD, GL.xferP wI2 VI cT, fwP, GL.xferP OUT wO cT, GL.xferP AXS wDS cD]

def fwWrap : RM := .seq (RM.seqL pushL) (.seq (RM.seqL coreL) (RM.seqL popL))

/-- The cost of `fwWrap`. -/
def fwWCost (q : Ref.Params) (kb Φm : ℕ) : ℕ :=
  fwCost q kb Φm + 10 ^ 6 * (2 ^ q.logOuter * q.r + 1) * (fwW2 q kb + 2) +
    10 ^ 6 * (q.K + 1) * (fwW q kb + 2)

/-! ## The main specification -/

/-! ## `run`, `ok`, `cost` -/

section corollaries

variable (M : MulSpec) {Φm : ℕ} (q : Ref.Params) (kb : ℕ) (hMB : MulBnd M (q.fn + 1) Φm)
    (hP : 1 ≤ q.P) (hK : q.K ≤ q.fn) (hlo : q.logOuter ≤ q.fn) (hkb : q.logOuter ≤ kb)
    (s : IState HS) (hC : FwCtx q kb s) (U V : List (ℤ × ℤ)) (R1 R2 : List Item)
