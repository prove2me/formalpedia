lemma gZ_add_mul (s t : ℕ) (ht : Even t) (htp : 0 < t) (x m : ℤ) :
    gZ s t (x + t * m) = gZ s t x := by
  obtain ⟨h, hh⟩ := ht
  unfold gZ
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast htp.ne'
  have e : -(π * I * s * ((x + t * m : ℤ) : ℂ) ^ 2 / t) =
      -(π * I * s * (x : ℂ) ^ 2 / t) + ((-(s * (x * m + h * m ^ 2)) : ℤ) : ℂ) * (2 * π * I) := by
    have : (t : ℂ) = 2 * h := by rw [hh]; push_cast; ring
    have hh0 : (h : ℂ) ≠ 0 := by
      intro h0; apply ht0; rw [this, h0, mul_zero]
    push_cast
    rw [this]
    field_simp
    ring
  rw [e, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one]

lemma gZ_congr (s t : ℕ) (ht : Even t) (htp : 0 < t) (x y : ℤ)
    (hxy : (x : ZMod t) = (y : ZMod t)) : gZ s t x = gZ s t y := by
  rw [ZMod.intCast_eq_intCast_iff_dvd_sub] at hxy
  obtain ⟨m, hm⟩ := hxy
  have : y = x + t * m := by linarith
  rw [this, gZ_add_mul s t ht htp]

lemma conj_gZ (s t : ℕ) (x : ℤ) :
    (starRingEnd ℂ) (gZ s t x) = Complex.exp (π * I * s * x ^ 2 / t) := by
  unfold gZ
  rw [← Complex.exp_conj]
  congr 1
  simp [map_div₀]
  ring

/-- One-dimensional kernel identity: `ā_j a_{j-k} ā_k = e^{2πi s j k / t}`. -/
lemma chirp_kernel (s t : ℕ) [NeZero t] (ht : Even t) (j k : ZMod t) :
    (starRingEnd ℂ) (gch s t j) * gch s t (j - k) * (starRingEnd ℂ) (gch s t k) =
      ZMod.stdAddChar ((s : ZMod t) * j * k) := by
  have htp : 0 < t := Nat.pos_of_ne_zero (NeZero.ne t)
  have h1 : gch s t (j - k) = gZ s t ((j.val : ℤ) - k.val) := by
    unfold gch
    apply gZ_congr s t ht htp
    push_cast
    simp [ZMod.natCast_zmod_val]
  have h2 : (s : ZMod t) * j * k = (((s : ℤ) * j.val * k.val : ℤ) : ZMod t) := by
    push_cast; simp [ZMod.natCast_zmod_val]
  rw [h1, h2, ZMod.stdAddChar_coe]
  unfold gch
  rw [conj_gZ, conj_gZ]
  unfold gZ
  rw [← Complex.exp_add, ← Complex.exp_add]
  congr 1
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast htp.ne'
  push_cast
  field_simp
  ring

/-- **Lemma 21, identity (36)**: `Q F_t u = ā · (a ∗ (ā · u)) / T`. -/
theorem lemma21_chirp (s t : Fin d → ℕ) [∀ i, NeZero (t i)] (ht : ∀ i, Even (t i))
    (u : ((i : Fin d) → ZMod (t i)) → ℂ) (j : (i : Fin d) → ZMod (t i)) :
    Qperm s t (dftM t u) j =
      (∏ i, (t i : ℂ))⁻¹ * ((starRingEnd ℂ) (chirp s t j) *
        ∑ k, chirp s t (j - k) * ((starRingEnd ℂ) (chirp s t k) * u k)) := by
  simp only [Qperm, dftM]
  congr 1
  rw [Finset.mul_sum]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  have hk : (∏ i, (ZMod.stdAddChar (-(k i * -((s i : ZMod (t i)) * j i))) : ℂ)) =
      (starRingEnd ℂ) (chirp s t j) * chirp s t (j - k) * (starRingEnd ℂ) (chirp s t k) := by
    simp only [chirp, map_prod, ← Finset.prod_mul_distrib, Pi.sub_apply]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    rw [chirp_kernel (s i) (t i) (ht i)]
    congr 1; ring
  rw [hk]; ring

