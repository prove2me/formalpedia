theorem blkI2_runs_sol_aux {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {b n pk φD φT B BH : ℕ} (hΦD : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φD)
    (hΦT : ∀ x y : ℤ, zsz x ≤ b * (2 * n) + 2 → zsz y ≤ b * (2 * n) + 2 → M.Φ x y ≤ φT)
    (hb : 1 ≤ b) (hn1 : 1 ≤ n) (hbig : 2 * (2 * n) * 2 ^ (2 * pk) < 2 ^ (b - 1))
