theorem ModularCurve.FullLevel.klevel_drinfeldInertia_of_affineChart_poles_hasse_commonChart_nodes_igusaSep_inertia
    (q : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
