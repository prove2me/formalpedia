-- title:
--   Discounted control systems with i.i.d. disturbances: history-dependent policies, expected discounted cost, optimal value (Appendix A, Eq. (12))
-- statement:
--   This file sets up the general infinite-horizon discounted decision problem used for the infinite-horizon results of Gallego and Özer (2001), extending the policy objective (12) of Appendix A from a finite horizon $T$ to $T=\infty$.
--
--   1. **Control system.** A control system with state space $S$, actions $A$ and disturbances $W$ consists of a transition map $(s,a,w)\mapsto \mathrm{next}(s,a,w)$, a one-period cost $c(s,a)\in\mathbb R$, and a feasibility relation saying which actions are allowed in state $s$.
--
--   2. **Policies.** A policy $\pi$ prescribes, for each period $k=0,1,2,\dots$ and each disturbance sequence $\omega=(w_0,w_1,\dots)$, an action $\pi_k(\omega)$. From an initial state $s_0$ the states are $s_0$ and $s_{k+1}=\mathrm{next}(s_k,\pi_k(\omega),w_k)$. The policy is **admissible** from $s_0$ if every $\pi_k$ is measurable, $\pi_k(\omega)$ depends only on $w_0,\dots,w_{k-1}$ (non-anticipative; arbitrary dependence on the past is allowed, so history-dependent policies are included), and along every disturbance sequence every action is feasible in the state where it is taken.
--
--   3. **Stationary policies.** A stationary policy is a map $\sigma:S\to A$; run from $s_0$ it takes the action $\sigma(s_k)$ in the current state.
--
--   4. **Expected discounted cost and optimal value.** Let $w_0,w_1,\dots$ be independent with common law $\nu$ and let $c_k(\omega)=c(s_k,\pi_k(\omega))$. The expected discounted cost of $\pi$ from $s_0$ is the extended real number
--   $$
--   B^\alpha(s_0\mid\pi)=\mathbb E\Big[\sum_{k\ge0}(\alpha^k c_k)^+\Big]-\mathbb E\Big[\sum_{k\ge0}(\alpha^k c_k)^-\Big]\in[-\infty,+\infty],
--   $$
--   and the optimal value is $\inf\{B^\alpha(s_0\mid\pi):\pi \text{ admissible from } s_0\}$. A stationary policy $\sigma$ is **optimal from $s_0$** if, run from $s_0$, it is admissible and its cost equals the optimal value.
--
--   **Formalization Note.** Time runs forward ($k$ periods after the start). The cost is split into positive and negative parts so that it is defined for every policy without integrability conditions; when the negative part is finite (as for costs bounded below and $0\le\alpha<1$) it is the expectation of the discounted sum. Policies are deterministic; randomized policies are not in the class. The design follows the platform definition `FZEchelon.Discounted.ControlSystem`, which has scalar disturbances; here the disturbance space is an arbitrary measurable space, because a period's disturbance in this model is the whole demand vector.
-- source:
--   Gallego, Özer, Integrating Replenishment Decisions with Advance Demand Information, Management Science 47(10):1344–1360 (2001), p. 1356, Appendix A, Eq. (12) and the definition of J_t(x_t, O_t) as an infimum over all policies including history-dependent ones

import Mathlib

open MeasureTheory

namespace GallegoOzerADI.PositiveSetup.Supplement

/-- A discrete-time control system driven by i.i.d. disturbances `w ∈ W` (for the inventory
model, the demand vector of a period): from state `s`, action `a` and disturbance `w` the next
state is `next s a w`; the one-period cost is `cost s a`; `feasible s a` says which actions are
allowed in state `s`. -/
structure ControlSystem (S A W : Type*) where
  /-- the transition `(s, a, w) ↦ s'` -/
  next : S → A → W → S
  /-- the one-period cost of action `a` in state `s` -/
  cost : S → A → ℝ
  /-- the actions allowed in state `s` -/
  feasible : S → A → Prop

/-- A deterministic history-dependent policy: `π k ω` is the action in period `k = 0, 1, …`
(time runs forward) along the disturbance sequence `ω = (w₀, w₁, …)`. Only non-anticipative
policies are admissible. -/
abbrev Policy (A W : Type*) := ℕ → (ℕ → W) → A

namespace ControlSystem

variable {S A W : Type*} (sys : ControlSystem S A W)

/-- The action in period `k` depends only on the disturbances `w₀, …, w_{k-1}` already
observed. -/
def NonAnticipative (π : Policy A W) : Prop :=
  ∀ (k : ℕ) (ω ω' : ℕ → W), (∀ j < k, ω j = ω' j) → π k ω = π k ω'

/-- The state sequence generated by `π` from `s₀` along `ω`:
`traj 0 = s₀`, `traj (k+1) = next (traj k) (π k ω) (ω k)`. -/
def traj (π : Policy A W) (s₀ : S) (ω : ℕ → W) : ℕ → S
  | 0 => s₀
  | k + 1 => sys.next (traj π s₀ ω k) (π k ω) (ω k)

/-- An admissible policy from `s₀`: every `π k` is measurable (product σ-algebra on
disturbance sequences), `π` is non-anticipative, and along **every** disturbance sequence every
action is feasible in the state where it is taken. -/
def Admissible [MeasurableSpace A] [MeasurableSpace W] (π : Policy A W) (s₀ : S) : Prop :=
  (∀ k, Measurable (π k)) ∧ NonAnticipative π ∧
    ∀ (ω : ℕ → W) (k : ℕ), sys.feasible (sys.traj π s₀ ω k) (π k ω)

/-- The state sequence of the stationary policy `σ : S → A` started at `s₀`. -/
def statTraj (σ : S → A) (s₀ : S) (ω : ℕ → W) : ℕ → S
  | 0 => s₀
  | k + 1 => sys.next (statTraj σ s₀ ω k) (σ (statTraj σ s₀ ω k)) (ω k)

/-- The stationary policy `σ`, run from `s₀`, as a history-dependent policy: in period `k` it
takes the action `σ` of the current state. -/
def stationary (σ : S → A) (s₀ : S) : Policy A W :=
  fun k ω => σ (sys.statTraj σ s₀ ω k)

/-- The expected total discounted cost of `π` from `s₀` when the disturbances are i.i.d. with
law `ν` (product law `Measure.infinitePi`): with `c_k(ω)` the cost of period `k`, weighted by
`α ^ k`, it is the extended real `E[∑ₖ (αᵏ c_k)⁺] − E[∑ₖ (αᵏ c_k)⁻]`. -/
noncomputable def discCost [MeasurableSpace W] (α : ℝ) (ν : Measure W) [IsProbabilityMeasure ν]
    (π : Policy A W) (s₀ : S) : EReal :=
  ((∫⁻ ω, ∑' k, ENNReal.ofReal (α ^ k * sys.cost (sys.traj π s₀ ω k) (π k ω))
      ∂(Measure.infinitePi fun _ : ℕ => ν) : ENNReal) : EReal) -
  ((∫⁻ ω, ∑' k, ENNReal.ofReal (-(α ^ k * sys.cost (sys.traj π s₀ ω k) (π k ω)))
      ∂(Measure.infinitePi fun _ : ℕ => ν) : ENNReal) : EReal)

/-- The optimal value of the infinite-horizon discounted problem from `s₀`: the infimum of
`discCost` over all admissible (history-dependent) policies from `s₀`. -/
noncomputable def optimalValue [MeasurableSpace A] [MeasurableSpace W] (α : ℝ) (ν : Measure W)
    [IsProbabilityMeasure ν] (s₀ : S) : EReal :=
  ⨅ (π : Policy A W) (_ : sys.Admissible π s₀), sys.discCost α ν π s₀

/-- The stationary policy `σ` is optimal from `s₀`: run from `s₀` it is admissible and its
expected discounted cost equals the optimal value. -/
def IsOptimalFrom [MeasurableSpace A] [MeasurableSpace W] (α : ℝ) (ν : Measure W)
    [IsProbabilityMeasure ν] (σ : S → A) (s₀ : S) : Prop :=
  sys.Admissible (sys.stationary σ s₀) s₀ ∧
    sys.discCost α ν (sys.stationary σ s₀) s₀ = sys.optimalValue α ν s₀

end ControlSystem

end GallegoOzerADI.PositiveSetup.Supplement


