theorem srcE_spec (u : IState HS) (ix : Ex HS) (d' Q Mh Mf j : ℕ) (h : SrcRegs u d' Q Mh Mf)
    (hix : ix.eval u = j) (hok : ix.ok u) (hj : (j < d' → j ≤ Mh) ∧ (d' ≤ j → j - d' ≤ Mf)) :
    (NLogN.KFM.srcE ix).ok u ∧ (NLogN.KFM.srcE ix).eval u = (srcV d' Q Mh Mf j : ℤ) := by
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩⟩ := h
  constructor
  · simp only [NLogN.KFM.srcE, Ex.ok, Ex.eval, hix, IState.top_eq h1]
    refine ⟨trivial, IState.isInt_of h2, ⟨hok, IState.isInt_of h1⟩, ?_⟩
    split_ifs
    · exact ⟨IState.isInt_of h3, hok⟩
    · exact ⟨IState.isInt_of h4, hok, IState.isInt_of h1⟩
  · simp only [NLogN.KFM.srcE, Ex.eval, hix, IState.top_eq h1, IState.top_eq h2, IState.top_eq h3,
      IState.top_eq h4, srcV]
    by_cases hjd : j < d'
    · rw [if_pos (by omega), if_pos hjd]
      push_cast [Nat.cast_sub (hj.1 hjd)]; ring
    · rw [if_neg (by omega), if_neg hjd]
      push_cast [Nat.cast_sub (hj.2 (by omega)), Nat.cast_sub (show d' ≤ j by omega)]; ring

theorem accSeq_pm (s : ℕ) (g : ℕ → ℕ) :
    ∀ k, accSeq (fun k c => (c * (g k : ℤ)) % (s : ℤ)) 1 k = (pmSeq s g k : ℤ)
  | 0 => by simp [accSeq, pmSeq]
  | k + 1 => by rw [accSeq, accSeq_pm s g k, pmSeq]; push_cast; rfl

theorem pm_prod (s : ℕ) (g : ℕ → ℕ) (hs : 2 ≤ s) (i : ℕ) :
    pmSeq s (fun t => g (i - 1 - t)) i = (∏ j ∈ Finset.range i, g j) % s := by
  rw [pmSeq_eq _ _ hs]
  congr 1
  rw [← Finset.prod_range_reflect g i]

/-- Lookups in a loop state that only touches `mIc` and one other scratch stack. -/
theorem SrcRegs.lp {u : IState HS} {d' Q Mh Mf : ℕ} (h : SrcRegs u d' Q Mh Mf) (a : Fin HS)
    (ha : a.val < 6) (La : List Item) (N k : ℕ) (c : ℤ) :
    SrcRegs (lpSt u mIc a La N k c) d' Q Mh Mf := by
  unfold lpSt
  refine (h.upd mIc (by decide) _).upd a ?_ _
  refine ⟨?_, ?_, ?_, ?_⟩ <;> intro he <;> rw [he] at ha <;> exact absurd ha (by decide)

