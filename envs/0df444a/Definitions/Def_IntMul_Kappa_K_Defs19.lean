section
-- Source module: Solutions.KFMErr
/-!
# KFM 14: the error chain of the computed pipeline (§9.7.1), abstract form

Arrays are functions `ι → ℂ` with the sup norm; `hp = 2^{-p}`. Every computed procedure is
an arbitrary function with an error bound on grid inputs (`Grid p f`: `Q_p f = f`), so the IL
denotations (and `P18IL`) plug in later.

* `QA p f`: `Q_p` on every entry; `QA_grid`, `norm_QA_le`, `norm_QA_sub_le` (`≤ √2 hp`).
* **`phase_err`**: `‖Q_p(ẽ·x) - e·x‖ ≤ 4hp`, `‖Q_p(ẽ·x)‖ ≤ ‖x‖` (unit phases, `|ẽ-e| ≤ 2hp`).
* `BilC M`: bilinear contraction; **`bil_err`**.
* **`mc_err`**: the computed complex convolution `Q_p(θ̃⁻ · M̃r(Q_p(θ̃⁺f), Q_p(θ̃⁺g)))` is within
  `(Er + 12) hp` of `θ⁻ · Mr(θ⁺ f, θ⁺ g)` (one operand of norm `≤ .7`).
* **`chirp_err`**: `Q_p(ã · M̃C(ã, Q_p(ã · x)))` is within `(Ec + 10) hp` of `a · MC(a, a · x)`.
* **`source_err`**: `2^γ B̃₀(C̃(Ã u))` is within `2^γ (εA + Ec + εB) hp` of `2^γ B₀(QF(A u))`.
* **`pipeline_err`**: with `z = Q_p(F̃u · F̃v)` and `F̃⁺ = conj ∘ F̃ ∘ conj`,
  `‖F̃⁺ z - G(Fu · Fv)‖ ≤ (3Es + 2) hp`.
-/

namespace NLogN.KFM

open Complex

noncomputable section

/-- The grid step `2^{-p}`. -/
abbrev hp (p : ℕ) : ℝ := (2 : ℝ)⁻¹ ^ p

section Arr

variable {ι : Type*} [Fintype ι]

/-- `Q_p` on every entry. -/
def QA (p : ℕ) (f : ι → ℂ) : ι → ℂ := fun i => Butterfly.Qp p (f i)

/-- Grid arrays: fixed by `Q_p`. -/
def Grid (p : ℕ) (f : ι → ℂ) : Prop := QA p f = f

/-- Entrywise conjugation. -/
def cnj (f : ι → ℂ) : ι → ℂ := fun i => starRingEnd ℂ (f i)

end Arr

/-! ## Bilinear contractions -/

section Bil

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- A bilinear contraction on arrays. -/
structure BilC (M : (ι → ℂ) → (ι → ℂ) → (κ → ℂ)) : Prop where
  sub : ∀ a a' b b', M a' b' - M a b = M (a' - a) b' + M a (b' - b)
  le : ∀ a b, ‖M a b‖ ≤ ‖a‖ * ‖b‖

/-- A linear contraction on arrays. -/
structure LinC (L : (ι → ℂ) → (κ → ℂ)) : Prop where
  sub : ∀ a b, L a - L b = L (a - b)
  le : ∀ a, ‖L a‖ ≤ ‖a‖

end Bil

/-! ## The computed complex convolution `M̃_C` (§9.4.1) -/

section MC

variable {ι : Type*} [Fintype ι]

/-- `M̃_C(f, g) = Q_p(θ̃⁻ · M̃r(Q_p(θ̃⁺ f), Q_p(θ̃⁺ g)))`. -/
def mcT (p : ℕ) (Mrt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)) (θt θit : ι → ℂ) (f g : ι → ℂ) : ι → ℂ :=
  QA p (θit * Mrt (QA p (θt * f)) (QA p (θt * g)))

/-- Phase data: exact unit phases `θ`, `θ⁻`, grid approximations within `2hp`, all of modulus `≤ 1`. -/
structure Phases (p : ℕ) (θ θt : ι → ℂ) : Prop where
  e : ∀ i, ‖θ i‖ ≤ 1
  t : ∀ i, ‖θt i - θ i‖ ≤ 2 * hp p
  t1 : ∀ i, ‖θt i‖ ≤ 1

end MC

/-! ## The computed chirp transform (§9.5) -/

section Chirp

variable {ι : Type*} [Fintype ι]

/-- `C̃(x) = Q_p(ã · M̃C(b̃, Q_p(ã · x)))` (kernel `b̃`, endpoint phases `ã`). -/
def chirpT (p : ℕ) (MCt : (ι → ℂ) → (ι → ℂ) → (ι → ℂ)) (bt at' x : ι → ℂ) : ι → ℂ :=
  QA p (at' * MCt bt (QA p (at' * x)))

end Chirp

/-! ## The source transform (§9.5.1) -/

section Source

variable {ι κ : Type*} [Fintype ι] [Fintype κ]

end Source

/-! ## The pipeline (§9.7.2) -/

section Pipe

variable {κ : Type*} [Fintype κ]

/-- `F̃⁺(z) = conj F̃(conj z)`. -/
def plusT (Ft : (κ → ℂ) → (κ → ℂ)) (z : κ → ℂ) : κ → ℂ := cnj (Ft (cnj z))

end Pipe

end

end NLogN.KFM

end

section
-- Source module: Solutions.KFMErr3
/-!
# KFM 14: the exact side of the error chain

The exact maps of §9.4–9.7 as `LinC` / `BilC` instances, and the identities `chain_close` needs.

* `avg_le`: a normalized sum of terms of modulus `≤ C` has modulus `≤ C`.
* **`linC_clm`** (CLMs of norm `≤ 1`), **`linC_RF`** (`R F_s`), **`linC_QF`** (`Q F_t`).
* `mrX t f g`: the normalized ring convolution on the box `∏_{i ≤ D} ℤ/t_i`: cyclic on the first
  `D` axes, negacyclic on the last (coefficient) axis, divided by `T = ∏ t_i`; **`bilC_mrX`**.
* **`mc_exact`**: twisting the last coordinate by `ζ^k` (`ζ^{t_D} = -1`) turns `mrX` into the
  normalized cyclic convolution `(f ∗ g)/T` (§9.4, pointwise form of `RTw.MC_eq`).
* **`chirp_exact`**: `ā · ((a ∗ (ā · x))/T) = Q F_t x` (Lemma 21, (36)).
* **`final_exact`**: `2^{2b+4} S · (S · conj RF_s(conj(RF_s u · RF_s v))) = ū ∗ v̄` (`pipeline_exact`).
* **`chain_concrete`**: `chain_close` with all exact maps instantiated (Lemma 19/20 witnesses
  `tensCLM (kerA M.A)`, `tensCLM (kerB M.B)`); only the computed procedures remain as hypotheses.
-/

namespace NLogN.KFM

open Complex IntMul.OpenAI.RT IntMul.OpenAI.RC

noncomputable section

/-! ## Averages -/

variable {d : ℕ}

/-! ## The twisted ring convolution -/

variable {D : ℕ}

/-- The normalized ring convolution on `∏_{i ≤ D} ℤ/t_i`: cyclic on the first `D` axes and
negacyclic on the last axis, divided by `T = ∏ t_i`. -/
def mrX (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    ((i : Fin (D + 1)) → ZMod (t i)) → ℂ := fun j =>
  (∏ i, (t i : ℂ))⁻¹ * ∑ k, f k * g (j - k) *
    (if (k (Fin.last D)).val ≤ (j (Fin.last D)).val then 1 else -1)

/-- The twist `θ_j = ζ^{j_D}` of the last coordinate. -/
def twX (t : Fin (D + 1) → ℕ) (ζ : ℂ) : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ :=
  fun j => ζ ^ (j (Fin.last D)).val

/-! ## The chain with the exact maps instantiated -/

end

end NLogN.KFM

end

