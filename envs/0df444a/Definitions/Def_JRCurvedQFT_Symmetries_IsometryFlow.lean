-- title:
--   One-parameter group of isometries; reflected ($\xi\in\mathfrak g_-$) and reflection-invariant ($\xi\in\mathfrak g_+$) flows
-- statement:
--   A **one-parameter group of isometries** of $M$ is a jointly smooth map $(\alpha,p)\mapsto\phi_\alpha(p)$ with $\phi_0=\mathrm{id}$, $\phi_{\alpha+\beta}=\phi_\alpha\circ\phi_\beta$ and each $\phi_\alpha$ an isometry. It is the form in which a Killing field $\xi$ enters the theory.
--
--   The flow is **reflected** if $\theta\phi_\alpha\theta=\phi_{-\alpha}$ (equivalently $\theta_*\xi=-\xi$, $\xi\in\mathfrak g_-$), and **reflection-invariant** if $\theta\phi_\alpha\theta=\phi_\alpha$ (equivalently $\theta_*\xi=\xi$, $\xi\in\mathfrak g_+$).
-- source:
--   Jaffe, Ritter, Quantum Field Theory on Curved Backgrounds. II. Spacetime Symmetries, arXiv:0704.0052v1, §4.1, pp. 6–7; (4.5), p. 8; Definition 5.1, p. 9

import Mathlib
import Definitions.Def_JRCurvedQFT_SharpTime_StaticStructure

open scoped Manifold ContDiff ENNReal Topology InnerProductSpace
open Bundle MeasureTheory

namespace JRCurvedQFT.Symmetries

variable {d : ℕ} {M : Type} [EMetricSpace M]
  [ChartedSpace (EuclideanSpace ℝ (Fin d)) M]
  [RiemannianBundle (fun (x : M) ↦ TangentSpace 𝓘(ℝ, EuclideanSpace ℝ (Fin d)) x)]

/-- A **one-parameter group of isometries** of `M`, the form in which a Killing field enters
Theorem 6.4.

Jaffe, Ritter, *Quantum Field Theory on Curved Backgrounds. II. Spacetime Symmetries*, arXiv:0704.0052v1, §4.1, pp. 6–7: "X ↦ ξ_X is a bijection of g onto the set of analytic homomorphisms ℝ → G"
and the 1-parameter group `φ_s = exp(sX)` is the flow generated by `X`; Theorem 6.4, p. 11: "a
Killing field ... with associated one-parameter group of isometries {φ_α}_{α∈ℝ}".

**Formalization Note** Reading 1: a Killing field on the complete manifold `M` is encoded by its
flow: jointly smooth, `φ_0 = id`, `φ_{α+β} = φ_α ∘ φ_β`, and each `φ_α` an isometry. -/
structure IsometryFlow (M : Type) [EMetricSpace M]
    [ChartedSpace (EuclideanSpace ℝ (Fin d)) M] where
  /-- The map `φ_α`. -/
  toFun : ℝ → M → M
  map_zero : ∀ p, toFun 0 p = p
  map_add : ∀ α β p, toFun (α + β) p = toFun α (toFun β p)
  smooth : ContMDiff (𝓘(ℝ, ℝ).prod 𝓘(ℝ, EuclideanSpace ℝ (Fin d)))
    𝓘(ℝ, EuclideanSpace ℝ (Fin d)) ∞ (fun q : ℝ × M => toFun q.1 q.2)
  isometry : ∀ α, Isometry (toFun α)

/-- `ξ ∈ g₋`: the isometries of the flow are **reflected**, `θ φ_α θ = φ_α⁻¹ = φ_{−α}`
(Definition 5.1, p. 9, and (4.5), p. 8: `θ_* ξ = −ξ`). -/
def IsometryFlow.IsReflected (S : JRCurvedQFT.SharpTime.StaticStructure (d := d) M) (φ : IsometryFlow (d := d) M) : Prop :=
  ∀ α p, S.reflection (φ.toFun α (S.reflection p)) = φ.toFun (-α) p

/-- `ξ ∈ g₊`: the isometries of the flow are **reflection-invariant**, `θ φ_α θ = φ_α`
(Definition 5.1, p. 9, and (4.5), p. 8: `θ_* ξ = ξ`). -/
def IsometryFlow.IsReflectionInvariant (S : JRCurvedQFT.SharpTime.StaticStructure (d := d) M)
    (φ : IsometryFlow (d := d) M) : Prop :=
  ∀ α p, S.reflection (φ.toFun α (S.reflection p)) = φ.toFun α p

end JRCurvedQFT.Symmetries


