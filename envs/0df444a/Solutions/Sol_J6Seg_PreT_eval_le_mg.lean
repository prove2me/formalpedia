theorem tmod_abs_le (a b : ℤ) : |a.tmod b| ≤ |a| + |b| := by
  have h1 : (a.tmod b).natAbs ≤ a.natAbs := by
    rw [Int.natAbs_tmod]; exact Nat.mod_le _ _
  have h2 : |a.tmod b| ≤ |a| := by
    rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]; exact_mod_cast h1
  have := abs_nonneg b; linarith

theorem emod_abs_le (a b : ℤ) : |a % b| ≤ |a| + |b| := by
  rcases eq_or_ne b 0 with h | h
  · subst h; simp
  · have h1 := Int.emod_nonneg a h
    have h2 := Int.emod_lt a h
    rw [abs_of_nonneg h1]
    have := abs_nonneg a
    have e : (b.natAbs : ℤ) = |b| := (Int.abs_eq_natAbs b).symm
    linarith

theorem eval_le_mg_sol_aux (s : IState HS) (V : Fin HS → ℕ) :
    ∀ e : Ex HS, (∀ i ∈ e.regs, |s.top i| ≤ V i) → |e.eval s| ≤ mg V e
  | .reg i, h => by simp only [Ex.eval, mg]; exact h i (by simp [Ex.regs])
  | .lit c, _ => by simp only [Ex.eval, mg]; rw [Int.abs_eq_natAbs]
  | .add a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hb := eval_le_mg_sol_aux s V b (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    exact (abs_add_le _ _).trans (by linarith)
  | .neg a, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simpa only [Ex.regs] using hi))
    simpa [Ex.eval, mg] using ha
  | .mul a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hb := eval_le_mg_sol_aux s V b (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    rw [abs_mul]
    have := mul_le_mul ha hb (abs_nonneg _) (by positivity)
    linarith [abs_nonneg (a.eval s)]
  | .shl a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hb := eval_le_mg_sol_aux s V b (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    rw [abs_mul]
    have := mul_le_mul ha hb (abs_nonneg _) (by positivity)
    linarith [abs_nonneg (a.eval s)]
  | .quo a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    have h2 := Int.natAbs_tdiv_le_natAbs (a.eval s) (b.eval s)
    have h3 : |(a.eval s).tdiv (b.eval s)| ≤ |a.eval s| := by
      rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]; exact_mod_cast h2
    have : (0 : ℤ) ≤ (mg V b : ℤ) := by positivity
    linarith
  | .rem a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hb := eval_le_mg_sol_aux s V b (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    have := tmod_abs_le (a.eval s) (b.eval s); linarith
  | .pow2 a, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simpa only [Ex.regs] using hi))
    simp only [Ex.eval, mg]; push_cast
    have h1 : (a.eval s).toNat ≤ mg V a := by
      have : ((a.eval s).toNat : ℤ) ≤ mg V a := by
        have := le_abs_self (a.eval s); omega
      exact_mod_cast this
    have h2 : (2 : ℤ) ^ (a.eval s).toNat ≤ 2 ^ mg V a := pow_le_pow_right₀ (by norm_num) h1
    rw [abs_of_pos (by positivity)]
    have : (0 : ℤ) ≤ (mg V a : ℤ) := by positivity
    linarith
  | .sel c x y, h => by
    have hx := eval_le_mg_sol_aux s V x (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hy := eval_le_mg_sol_aux s V y (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    have : (0 : ℤ) ≤ (mg V c : ℤ) := by positivity
    have : (0 : ℤ) ≤ (mg V x : ℤ) := by positivity
    have : (0 : ℤ) ≤ (mg V y : ℤ) := by positivity
    split_ifs <;> linarith
  | .ndiv a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    have h2 := Int.natAbs_ediv_le_natAbs (a.eval s) (b.eval s)
    have h3 : |a.eval s / b.eval s| ≤ |a.eval s| := by
      rw [Int.abs_eq_natAbs, Int.abs_eq_natAbs]; exact_mod_cast h2
    have : (0 : ℤ) ≤ (mg V b : ℤ) := by positivity
    linarith
  | .nmod a b, h => by
    have ha := eval_le_mg_sol_aux s V a (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    have hb := eval_le_mg_sol_aux s V b (fun i hi => h i (by simp only [Ex.regs, List.mem_append]; tauto))
    simp only [Ex.eval, mg]; push_cast
    have := emod_abs_le (a.eval s) (b.eval s); linarith

