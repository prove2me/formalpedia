theorem slot_field
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    {L : Type u} [Field L] (O : ValuationSubring L)
    (𝒜 𝒟 : FakeEllipticCurve Λ N ↥O)
    (Φ : 𝒜.A ⟶ 𝒟.A) (hΦ : Φ ≫ 𝒟.f = 𝒜.f)
    (hΦ_mul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (P Q : SchemeHomOver t 𝒜.f),
      mapPt Φ hΦ (𝒜.L.mul t P Q) = 𝒟.L.mul t (mapPt Φ hΦ P) (mapPt Φ hΦ Q))
    (Ψ : 𝒟.A ⟶ 𝒜.A) (hΨ : Ψ ≫ 𝒜.f = 𝒟.f)
    (n : ℕ) (hn : 0 < n)
    (hΨΦ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (P : SchemeHomOver t 𝒜.f),
      mapPt Ψ hΨ (mapPt Φ hΦ P) = nsmulPt 𝒜.L t n P)
    (hΦΨ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (Q : SchemeHomOver t 𝒟.f),
      mapPt Φ hΦ (mapPt Ψ hΨ Q) = nsmulPt 𝒟.L t n Q)
    (s : ↥(Spec (CommRingCat.of ↥O))) :
    IsFinite (pullback.snd Φ (𝒟.f.fiberι s)) ∧ Flat (pullback.snd Φ (𝒟.f.fiberι s)) ∧
      Surjective (pullback.snd Φ (𝒟.f.fiberι s)) :=
  K1vFibre.isFinite_flat_surjective_pullback_snd_fiberι 𝒜 𝒟 Φ hΦ Ψ hΨ n hn hΨΦ s

theorem solution
    {a b : ℚ} {Λ : Submodule ℤ ℍ[ℚ, a, b]} {N : ℕ}
    {L : Type u} [Field L] (O : ValuationSubring L)
    (𝒜 𝒟 : FakeEllipticCurve Λ N ↥O)
    (Φ : 𝒜.A ⟶ 𝒟.A) (hΦ : Φ ≫ 𝒟.f = 𝒜.f)
    (hΦ_mul : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (P Q : SchemeHomOver t 𝒜.f),
      mapPt Φ hΦ (𝒜.L.mul t P Q) = 𝒟.L.mul t (mapPt Φ hΦ P) (mapPt Φ hΦ Q))
    (Ψ : 𝒟.A ⟶ 𝒜.A) (hΨ : Ψ ≫ 𝒜.f = 𝒟.f)
    (n : ℕ) (hn : 0 < n)
    (hΨΦ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (P : SchemeHomOver t 𝒜.f),
      mapPt Ψ hΨ (mapPt Φ hΦ P) = nsmulPt 𝒜.L t n P)
    (hΦΨ : ∀ {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of ↥O)) (Q : SchemeHomOver t 𝒟.f),
      mapPt Φ hΦ (mapPt Ψ hΨ Q) = nsmulPt 𝒟.L t n Q) :
    IsFinite Φ ∧ Flat Φ ∧ LocallyOfFinitePresentation Φ ∧ Surjective Φ := by
  have hfield := slot_field O 𝒜 𝒟 Φ hΦ hΦ_mul Ψ hΨ n hn hΨΦ hΦΨ

  haveI : Smooth 𝒜.f := 𝒜.bundle.smooth
  haveI : Smooth 𝒟.f := 𝒟.bundle.smooth
  haveI : IsProper 𝒜.f := 𝒜.bundle.proper
  haveI : IsProper 𝒟.f := 𝒟.bundle.proper

  have hlfp : LocallyOfFinitePresentation Φ := LocallyOfFinitePresentation.of_comp_eq Φ 𝒜.f 𝒟.f hΦ
  haveI : IsProper Φ := IsProper.of_comp_eq Φ 𝒜.f 𝒟.f hΦ

  haveI : LocallyQuasiFinite Φ :=
    K1vAux.locallyQuasiFinite_of_forall_isFinite_pullback_snd_fiberι 𝒟.f Φ (fun s => (hfield s).1)
  have hfin : IsFinite Φ := IsFinite.of_isProper_of_locallyQuasiFinite Φ

  have hflat : Flat Φ :=
    AlgebraicGeometry.flat_of_locallyOfFinitePresentation_of_forall_flat_pullback_snd_fibre 𝒜.f 𝒟.f Φ hΦ
      (fun s => (hfield s).2.1)

  have hsurj : Surjective Φ :=
    K1vAux.surjective_of_forall_surjective_pullback_snd_fiberι 𝒟.f Φ (fun s => (hfield s).2.2)
  exact ⟨hfin, hflat, hlfp, hsurj⟩

