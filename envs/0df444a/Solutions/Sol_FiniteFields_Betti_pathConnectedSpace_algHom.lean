namespace FiniteFields.Betti

theorem _root_.solution (A : Type) [CommRing A] [IsDomain A]
    [Algebra ℂ A] [Algebra.FiniteType ℂ A] :
    @PathConnectedSpace (A →ₐ[ℂ] ℂ)
      (TopologicalSpace.induced (fun φ : A →ₐ[ℂ] ℂ ↦ (⇑φ : A → ℂ)) inferInstance) :=
  Connected.pathConnectedSpace_algHom_proof A

