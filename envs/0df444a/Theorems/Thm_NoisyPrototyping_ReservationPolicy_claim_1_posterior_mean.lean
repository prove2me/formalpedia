namespace NoisyPrototyping.ReservationPolicy
open MeasureTheory
theorem claim_1_posterior_mean (f : ℝ × ℝ → ℝ) (hf_nonneg : ∀ z, 0 ≤ f z)
    (hf_meas : Measurable f) (μ : Measure (ℝ × ℝ))
    (hμ : μ = (volume : Measure (ℝ × ℝ)).withDensity (fun z => ENNReal.ofReal (f z)))
    [IsProbabilityMeasure μ] (hint : Integrable (fun z : ℝ × ℝ => z.1) μ) :
    (fun z : ℝ × ℝ => Q f z.2) =ᵐ[μ]
      μ[fun z : ℝ × ℝ => z.1 | MeasurableSpace.comap Prod.snd inferInstance] := by sorry
end NoisyPrototyping.ReservationPolicy
