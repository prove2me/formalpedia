-- title:
--   Coordinate-power relations span by bounded coordinate products
-- statement:
--   Every polynomial lies in the module span over the algebra generated by `g` of the products of coordinate powers with each exponent below its corresponding `n i`. This captures the weighted-degree reduction: use `heq` to replace a coordinate power whenever an exponent reaches its bound, move each generator factor into the base algebra, and induct on the strictly decreasing weighted degree of the remaining factor.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.bounded_coordinate_monomials_span
    {d k : Nat} (w : Fin d → Rat) (hw : ∀ i, 0 < (w i : Real))
    (D : Real) (hD : 0 < D) (g : Fin k → MvPolynomial (Fin d) Complex)
    (hhom : ∀ j, (g j).IsWeightedHomogeneous (fun i => (w i : Real)) D)
    (n : Fin d → Nat) (hn : ∀ i, 0 < n i)
    (c : Fin d → Fin k → MvPolynomial (Fin d) Complex)
    (heq : ∀ i, (MvPolynomial.X i : MvPolynomial (Fin d) Complex) ^ n i =
      ∑ j : Fin k, c i j * g j)
    (hc : ∀ i j, (c i j).IsWeightedHomogeneous (fun l => (w l : Real))
      ((n i : Real) * (w i : Real) - D)) :
    Submodule.span (Algebra.adjoin Complex (Set.range g))
      (Set.range fun e : {e : Fin d → Nat // ∀ i, e i < n i} =>
        ∏ i : Fin d, (MvPolynomial.X i : MvPolynomial (Fin d) Complex) ^ e.1 i) = ⊤ := by sorry
