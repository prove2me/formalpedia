      (contDiffOn_const.mul (hr I B))).add (contDiffOn_const.mul (hr I A))).div_const 2
  have hG : ContDiffOn ℝ ∞ (fun z => (ricciScalar g gi z : ℂ) * (cA * cD - cB * cC) / 6) U :=
    (hR.mul contDiffOn_const).div_const 6
