/-! # VII-05 (F2c2): independent smooth extensions at inverse radius zero

The VII-04 pullbacks `pull s f x = f(s + x⁻¹)`, `pullM s m x = x · m(s + x⁻¹)` are total
functions, and Lean's `0⁻¹ = 0` gives the literal value `pullM s m 0 = 0`
(`literal_pullM_zero`). A smooth branch at `x = 0` with `b(0) = 1` therefore can **not** be
phrased with the literal `pullM` (`literal_pullM_not_branch`).

`SmoothBranch I s ε f m a F b A` instead records *independent* real functions `F b A`, `C^∞` on
`U = (-ε, ε)`, equal to the pullbacks **only on `(0, ε)`**, with the three leading values
`F(0) = b(0) = 1`, `A(0) = 0` and the chart tail `(s + ε⁻¹, ∞) ⊆ I`. This is an *additional*
regularity assumption at infinity (a selected smooth branch); it is not derived from
`PaperData` at finite radii or from bare asymptotic flatness. The structure contains no field
equation, no `PaperBVP`/`FactorizedN`, no `G` condition, no Taylor coefficient beyond the three
leading values, and no residual, Γ or `J`/`Q` condition. The labels `M = -F'(0)`, `c = A'(0)`
are definitions, not hypotheses.

On the open set `(0, ε)` the matching transfers values, first and second derivatives
(`Set.EqOn.deriv`), hence the four real compactified residuals and `realGamma`
(`realP*_congr`, `realGamma_congr`). Nothing is transferred at the single point `x = 0`. -/

open scoped ContDiff

namespace ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.SmoothExt

open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Compact

/-! ## The literal totalized pullback at zero -/

/-! ## Chart membership and positive-side transfer -/

section Transfer

variable {V : Set ℝ} (hV : IsOpen V) {F b A F' b' A' : ℝ → ℝ}
  (hF : Set.EqOn F F' V) (hb : Set.EqOn b b' V) (hA : Set.EqOn A A' V) {x : ℝ} (hx : x ∈ V)
include hV hF hb hA hx

theorem realPM_congr (h Q J : ℝ) : realPM h Q J F b A x = realPM h Q J F' b' A' x := by
  unfold realPM
  rw [(hF.deriv hV).deriv hV hx, hF.deriv hV hx, hF hx, (hb.deriv hV).deriv hV hx,
    hb.deriv hV hx, hb hx, (hA.deriv hV).deriv hV hx, hA.deriv hV hx, hA hx]

theorem realPA_congr (h Q J : ℝ) : realPA h Q J F b A x = realPA h Q J F' b' A' x := by
  unfold realPA
  rw [(hF.deriv hV).deriv hV hx, hF.deriv hV hx, hF hx, (hb.deriv hV).deriv hV hx,
    hb.deriv hV hx, hb hx, (hA.deriv hV).deriv hV hx, hA.deriv hV hx, hA hx]

theorem realPC_congr (h Q J : ℝ) : realPC h Q J F b A x = realPC h Q J F' b' A' x := by
  unfold realPC
  rw [(hF.deriv hV).deriv hV hx, hF.deriv hV hx, hF hx, (hb.deriv hV).deriv hV hx,
    hb.deriv hV hx, hb hx, (hA.deriv hV).deriv hV hx, hA.deriv hV hx, hA hx]

omit hF hb hA hx in
theorem deltaFun_congr {g g' : ℝ → ℝ} (hg : Set.EqOn g g' V) :
    Set.EqOn (deltaFun g) (deltaFun g') V := fun y hy => by
  simp only [deltaFun]; rw [hg.deriv hV hy]

theorem realGamma_congr (h Q J : ℝ) :
    realGamma h Q J F b A x = realGamma h Q J F' b' A' x := by
  have hsq : Set.EqOn (fun y => y ^ 2 * F y) (fun y => y ^ 2 * F' y) V := fun y hy => by
    simp only; rw [hF hy]
  unfold realGamma
  rw [deltaFun_congr hV (deltaFun_congr hV hA) hx, deltaFun_congr hV hsq hx,
    deltaFun_congr hV hA hx, hF hx, hb hx, hA hx]

end Transfer

