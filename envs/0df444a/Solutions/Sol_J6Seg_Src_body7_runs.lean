/-!
# B-line IL, B1 follow-up: building the control list, §3 list facts and the pair transfer

* `pos src argOf j`: the input position after the first `j` output slabs; `pos_succ`, `pos_mono`,
  `pos_le_n`, `sum_tele` (the drops of the entries telescope to `pos`).
* `length_ctlOf`: `|ctlOf n n' src argOf| = n + n'` for a monotone source.
* `srcTab_drop`: the table seen from entry `j`.
* `pairMove_runs`: `rptX X (mv i j; mv i j)` moves a reversed list of `2L` entries back in order.
* `cS_upd_G`, `cS_self`: the builder state over other registers.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## Positions -/

theorem ctlAux_snd_indep (src : ℕ → Option ℕ) (argOf argOf' : ℕ → ℤ) :
    ∀ (ls : List ℕ) (cur : ℕ),
      (J6Seg.ctlAux src argOf ls cur).2 = (J6Seg.ctlAux src argOf' ls cur).2
  | [], cur => rfl
  | l :: ls, cur => by
    simp only [J6Seg.ctlAux]
    cases src l with
    | none => exact ctlAux_snd_indep src argOf argOf' ls cur
    | some k => exact ctlAux_snd_indep src argOf argOf' ls k

theorem pos_succ (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (j : ℕ) :
    pos src argOf (j + 1) = kO (src j) (pos src argOf j) := by
  unfold pos; rw [List.range_succ, ctlAux_snoc, stepK_eq]

variable {n n' : ℕ} {src : ℕ → Option ℕ} (argOf : ℕ → ℤ)

theorem pos_le_src (hs : J6Seg.MonoSrc n n' src) {j k : ℕ} (hj : j < n') (hk : src j = some k) :
    pos src argOf j ≤ k := by
  have h := (srcFrom_range_take hs j hj k hk).1
  unfold pos; rw [ctlAux_snd_indep src argOf (fun _ => 0)]; exact h

theorem pos_le_n (hs : J6Seg.MonoSrc n n' src) {j : ℕ} (hj : j ≤ n') : pos src argOf j ≤ n :=
  ctlAux_pos_le hs argOf j hj

theorem length_aux (hs : J6Seg.MonoSrc n n' src) :
    ∀ j ≤ n', (J6Seg.ctlAux src argOf (List.range j) 0).1.length = pos src argOf j + j
  | 0, _ => rfl
  | j + 1, hj => by
    have ih := length_aux hs j (by omega)
    rw [List.range_succ, ctlAux_snoc, List.length_append, stepC_eq, ih]
    have hp := pos_succ src argOf j
    unfold pos at hp ih ⊢
    rw [hp]
    cases hk : src j with
    | none => simp [stO, kO]; omega
    | some k =>
      have := pos_le_src argOf hs (j := j) (by omega) hk
      unfold pos at this
      simp [stO, kO]; omega

theorem length_ctlOf (hs : J6Seg.MonoSrc n n' src) :
    (J6Seg.ctlOf n n' src argOf).length = n + n' := by
  unfold J6Seg.ctlOf
  rw [List.length_append, List.length_replicate, length_aux argOf hs n' le_rfl]
  have := pos_le_n argOf hs (j := n') le_rfl
  unfold pos at this ⊢
  omega

