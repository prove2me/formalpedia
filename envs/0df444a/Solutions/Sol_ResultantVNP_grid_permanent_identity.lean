  · intro i
    exact (Fin.sum_univ_eq_sum_range (fun k : ℕ => (a ((i.val : ZMod m),(k : ZMod m))).1.1.val) m).trans
      (row_total a ha _)
  · intro j
    exact (Fin.sum_univ_eq_sum_range (fun k : ℕ => (a ((k : ZMod m),(j.val : ZMod m))).1.1.val) m).trans
      (column_total a ha _)

