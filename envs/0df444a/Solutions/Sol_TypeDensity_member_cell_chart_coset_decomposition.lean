    ∃ reps : Finset (Fin m.s.degree → m.O),
      (∀ z : Fin m.s.degree → m.O, ∃! z₀, z₀ ∈ reps ∧ TypeDensity.adicCongr (Ideal.span {m.S.pi}) Mlev z z₀) ∧
      (∀ z₀ : Fin m.s.degree → m.O, MeasurableSet (TypeDensity.coordinateCoset m.S.pi Mlev z₀)) ∧
      (reps : Set (Fin m.s.degree → m.O)).PairwiseDisjoint
      (fun z₀ => TypeDensity.coordinateCoset m.S.pi Mlev z₀) ∧ ∀ i : m.atlas.ι,
        TypeDensity.coordinateIdeal m.S.pi (m.atlas.chart i).f (m.atlas.chart i).b ⁻¹' m.toMeasured.cell c =
        ⋃ z₀ ∈ reps.filter
        (fun z₀ => TypeDensity.coordinateIdeal m.S.pi (m.atlas.chart i).f (m.atlas.chart i).b z₀ ∈
        m.toMeasured.cell c), TypeDensity.coordinateCoset m.S.pi Mlev z₀ := by
  obtain ⟨reps, hreps⟩ :=
      TypeDensity.coordinate_coset_representatives_exist m.O m.S.pi
      (by rw [m.hS_pi]; exact m.hpi) m.s.degree Mlev
  have hmax : Ideal.span {m.S.pi} = IsLocalRing.maximalIdeal m.O := by
    rw [m.hS_pi]; exact ((m.hpi).maximalIdeal_eq).symm
  have hmeas : ∀ z₀ : Fin m.s.degree → m.O, MeasurableSet (TypeDensity.coordinateCoset m.S.pi Mlev z₀) := by
    intro z₀
    have h := TypeDensity.finite_coordinate_borel_cylinders m.O (IsLocalRing.maximalIdeal m.O) m.htop m.s.degree
    have : @MeasurableSet _
        (TypeDensity.adicCylinderSpace (IsLocalRing.maximalIdeal m.O) (Fin m.s.degree → m.O))
        (TypeDensity.coordinateCoset m.S.pi Mlev z₀) := MeasurableSpace.measurableSet_generateFrom
      (.inr ⟨Mlev, z₀, by unfold TypeDensity.coordinateCoset; rw [hmax]⟩)
    rwa [← h] at this
  refine ⟨reps, hreps, hmeas, fun z₁ h₁ z₂ h₂ hne ↦ Set.disjoint_left.2 fun z hz1 hz2 ↦ ?_, ?_⟩
  · obtain ⟨w, _, hw⟩ := hreps z
    exact hne ((hw z₁ ⟨h₁, hz1⟩).trans (hw z₂ ⟨h₂, hz2⟩).symm)
  intro i
  obtain ⟨hinj, -, -⟩ := TypeDensity.concrete_member_charts m i
  have hf : Ideal.span {(m.atlas.chart i).f} ∈ TypeDensity.surfaceStateSet m.O m.R m.S m.s :=
    m.atlas.cover.symm.subset <| Set.mem_iUnion.2
