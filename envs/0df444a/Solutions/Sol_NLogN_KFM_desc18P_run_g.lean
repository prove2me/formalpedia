-- Source module: Solutions.KFMS7
/-!
# KFM S7: the source and inverse lists in IL (run lemmas)

Scratch stacks `1–5` (setup is a leaf procedure, UNIFORM amendment): `mOc = 1` outer counter,
`mS = 2` the source `s_i`, `mP = 3` the running product, `mM = 4` the sum, `mIc = 5` the inner
counter. The parameters are read from `zDp, zQ, zMh, zMf` (KFMS3).

* `srcE ix`: `s_j = 1 + Q·(j < d' ? M_h − j : M_f − (j − d'))` for `j = ix` (**`srcE_spec`**).
* `muB dst`: for `i = (top of mOc) − 1`, computes `P_i mod s_i` by a product loop, then
  `μ_i = Σ_{y=1}^{s_i} y·[y P_i ≡ 1]` by a sum loop, and pushes `μ_i` on `dst`
  (**`muB_run`**).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul RS

/-! ## The product loop -/

/-! ## The sum loop -/

/-! ## One inverse -/

/-! ## Loops that push one value per index -/

theorem pushL_succ (v : ℕ → ℤ) (d k : ℕ) (hk : k < d) :
    pushL v d (k + 1) = v (d - k - 1) :: pushL v d k := by
  unfold pushL
  rw [List.range_succ_eq_map, List.map_cons, List.map_map]
  congr 1
  all_goals first
    | (congr 1; omega)
    | (apply List.map_congr_left
       intro t _
       show v (d - (k + 1) + (t + 1)) = v (d - k + t)
       congr 1; omega)

theorem pushL_full (v : ℕ → ℤ) (d : ℕ) : pushL v d d = (List.range d).map v := by
  simp [pushL]

/-- **Push loop.** `rep mOc (reg zD) B` with `d` on `zD`, where `B` pushes `v (c−1)` on `dst`
when the counter is `c`, leaves `v 0, …, v (d−1)` on top of `dst`. -/
theorem pushLoop_run (B : RS) (dst : Fin HS) (hdO : dst ≠ mOc) (s : IState HS) (d : ℕ)
    (LD : List Item) (hD : s.G zD = .int (d : ℤ) :: LD) (hw : mOc ∉ B.writes) (v : ℕ → ℤ)
    (hB : ∀ (L : List Item) (c : ℕ), 1 ≤ c → c ≤ d →
      B.ok ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) ∧
      B.run ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) =
        ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)).upd dst
          (.int (v (c - 1)) :: L ++ s.G dst)) :
    (RS.rep mOc (.reg zD) B).ok s ∧ (RS.rep mOc (.reg zD) B).run s =
      s.upd dst (ints ((List.range d).map v) ++ s.G dst) := by
  set St : ℕ → IState HS := fun k => s.upd dst (ints (pushL v d k) ++ s.G dst) with hSt
  have H := loopI_run mOc (.reg zD) B s d St (by decide) (clean_of_regs _ (by decide))
    (IState.isInt_of hD) (by simp [Ex.eval, IState.top_eq hD]) hw
    (by simp [hSt, pushL]) (by simp [hSt, IState.upd_G, Ne.symm hdO])
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      have := hB (ints (pushL v d k)) (d - k) (by omega) (by omega)
      refine ⟨this.1, ?_⟩
      rw [this.2]
      apply IState.ext' _ (by simp [hSt]) (by simp [hSt])
      intro j
      simp only [hSt, IState.upd_G]
      by_cases j1 : j = mOc
      · subst j1; simp [Ne.symm hdO]
      by_cases j2 : j = dst
      · subst j2
        simp only [if_pos rfl, if_neg hdO]
        rw [pushL_succ v d k hk, ints_cons, show d - k - 1 = d - k - 1 from rfl]
        rfl
      · simp [j1, j2])
  have e : St d = s.upd dst (ints ((List.range d).map v) ++ s.G dst) := by
    simp only [hSt, pushL_full]
  rw [e] at H
  exact H

end NLogN.KFM

