      ub (((sa - 3 * hi1) * 256) / hi1) (((sb - 3 * lo1) * 256) / lo1) * wDiagIn lo1 hi1
    let w1 := wInvSqIn lo1 hi1
    let offTerm :=
      w1 * sumRange (j + 1) (N12 - (j + 1)) fun k =>
        let lo2 := A1_num + k * h
        let hi2 := lo2 + h
        ub (((sa - 2 * hi1 - hi2) * 256) / hi1) (((sb - 2 * lo1 - lo2) * 256) / lo1) * wInv lo2 hi2
    diagTerm + offTerm

