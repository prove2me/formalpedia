  have hns0 : ¬ Smooth (pullback.snd c (s' ≫ specMap R A)) := by
    intro h
    apply hns
    rw [← hφ2]
    infer_instance
  obtain ⟨M₁, M₂, i₁, i₂, hci₁, hci₂, n, a, b, 𝒲₀, h1, h2, hcov, hinj, hnode, hnode', hred, hU0₁, hU0₂, hU1₁, hU1₂,
    hε, hUtr, hnotU, hyU, W₁, hW₁, hW₁oi⟩ := hbad k (s' ≫ specMap R A) hns0
