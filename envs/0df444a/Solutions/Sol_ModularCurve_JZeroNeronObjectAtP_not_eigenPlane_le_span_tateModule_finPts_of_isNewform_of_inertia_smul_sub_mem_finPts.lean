  have hmod : val ^ 2 ≡ val [MOD lam ^ (n' + 1)] :=
    nat_modEq_of_cast_sub_mem_span hmemO'' (n' + 1) (val ^ 2) val hfinal

  have hcop : Nat.Coprime val (lam ^ (n' + 1)) := by
    have hu := ZMod.val_coe_unit_coprime
      (Units.map (PadicInt.toZModPow (n' + 1)).toMonoidHom
