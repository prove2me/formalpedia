  obtain ⟨hpbE', -, -, -⟩ := ρ'.isPullback_Eb
  have hib_eq : ib = hb :=
    hpbE'.hom_ext (by rw [hhb₁, hib₁, Iso.refl_hom, Category.comp_id]) (by rw [hhb₂, hib₂])
  have hibP : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ'.Eb x₀.2.Eb ib := hib_eq ▸ hhb₃
  have hubP := CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.comp _ (RingHom.id _) ρ.Eb ρ'.Eb x₀.2.Eb ub' ib hub'₁ hibP
