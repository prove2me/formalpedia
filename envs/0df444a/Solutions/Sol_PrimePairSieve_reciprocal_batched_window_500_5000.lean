lemma rows_valid : rows.all rowCheck = true := by
  rw [← fastRowCheck_eq]
  decide +kernel

lemma rows_sorted : (rows.map Row.n).IsChain (· < ·) := by decide +kernel

lemma log_667 : Real.log (4*(667:ℝ)) ≤ (19723/2500) := by
  have h := Real.log_div_le_sum_range_add (x := ((155/1179):ℝ)) (by norm_num) (by norm_num) 2
  norm_num [Finset.sum_range_succ] at h
  have heq : Real.log (2668:ℝ) = 11*Real.log 2 + Real.log ((667/512):ℝ) := by
    rw [show (2668:ℝ) = 2^11*(667/512) by norm_num, Real.log_mul (by norm_num) (by norm_num), Real.log_pow]
    norm_num
  norm_num
  rw [heq]
  linarith [Real.log_two_lt_d9]

lemma cell_500 (z : ℝ) (hl : 500 ≤ z) (hu : z ≤ 667) :
    Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant) /
      (1-((z+1)*(Real.log (4*z)^2/(2*TaoFivePrimes.twinPrimeConstant))/(16*z^2))) ≤
      ∑ n ∈ Finset.Icc 1 ⌊z⌋₊, weight n/(1+(n:ℝ)/z) := by
  apply PrimePairSieve.reciprocal_base_denominator_interval_certificate 500 667 (19723/2500) z
    (by norm_num) hl hu log_667 (by norm_num)
  have hi : roundedSum 100000000 500 rows = 2497451447 := by decide +kernel
  have hb := endpoint_lower 100000000 500 (by norm_num) (by norm_num) rows rows_sorted rows_valid
  rw [hi] at hb
  have hr : ((19723/2500):ℝ)^2/(5/2)/(1-((500+1)/(16*500^2))*((19723/2500)^2/(5/2))) ≤ (2497451447:ℝ)/100000000 := by norm_num
  simpa [weight] using hr.trans hb

