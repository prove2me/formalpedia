theorem GlobalTheory.HL.Inhab.hf_sum_left (L : LocE F E) {n : ℕ} (H : Matrix (Fin n) (Fin n) E) {ι : Type} (s : Finset ι)
    (a : ι → Fin n → E) (y : Fin n → E) : hf L H (∑ i ∈ s, a i) y = ∑ i ∈ s, hf L H (a i) y := by sorry
