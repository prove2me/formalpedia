  have hv : AModel.Valid (Butterfly.layerShape P K D S) (AModel.decode (Butterfly.layerShape P K D S) j) := AModel.valid_decode hj
  have hk := Butterfly.kernel_pair (Butterfly.layerSel P K D S ρ hρ) i A xs hv
  rw [AModel.encode_decode hj] at hk
