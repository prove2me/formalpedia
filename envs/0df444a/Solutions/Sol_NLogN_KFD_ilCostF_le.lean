theorem ilCostF_le_coeff (W K Kb Kd S q Bb : ℕ) (hW : 1 ≤ W) :
    ∀ j V, (ilCostF W K Kb Kd S q Bb j V : ℝ) ≤
      ((V : ℝ) + (W : ℝ) ^ j) * coeffSeq S W ((K : ℝ) * ((q : ℝ) + 1)) j +
        ((Kb : ℝ) + (S : ℝ) * Kd) * ((S : ℝ) + 1) ^ j * ((Bb : ℝ) + 2) ^ 2 := by
  set C : ℝ := (K : ℝ) * ((q : ℝ) + 1) with hC
  have hC0 : 0 ≤ C := by positivity
  have hY : (0 : ℝ) ≤ ((Bb : ℝ) + 2) ^ 2 := by positivity
  intro j
  induction j with
  | zero =>
    intro V
    simp only [ilCostF, coeffSeq, pow_zero]
    push_cast
    have : (0 : ℝ) ≤ (S : ℝ) * Kd * ((Bb : ℝ) + 2) ^ 2 := by positivity
    nlinarith
  | succ j ih =>
    intro V
    have hW0 : (0 : ℝ) < W := by exact_mod_cast hW
    have hc : 0 ≤ coeffSeq S W C j := by
      clear ih
      induction j with
      | zero => exact hC0
      | succ k ihk => simp only [coeffSeq]; positivity
    have h1 := ih (V / W)
    have hdiv : ((V / W : ℕ) : ℝ) ≤ (V : ℝ) / W := Nat.cast_div_le
    simp only [ilCostF, coeffSeq]
    push_cast
    set Y := ((Bb : ℝ) + 2) ^ 2 with hYd
    set c := coeffSeq S W C j
    have hWj : (1 : ℝ) ≤ (W : ℝ) ^ (j + 1) := one_le_pow₀ (by exact_mod_cast hW)
    have hS0 : (0 : ℝ) ≤ S := Nat.cast_nonneg S
    have hP : (1 : ℝ) + S * ((S : ℝ) + 1) ^ j ≤ ((S : ℝ) + 1) ^ (j + 1) := by
      have : (1 : ℝ) ≤ ((S : ℝ) + 1) ^ j := one_le_pow₀ (by linarith)
      rw [pow_succ]; nlinarith
    have hrec : (S : ℝ) * (ilCostF W K Kb Kd S q Bb j (V / W) : ℝ) ≤
        ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((S : ℝ) / W * c) +
          (S : ℝ) * (((Kb : ℝ) + (S : ℝ) * Kd) * ((S : ℝ) + 1) ^ j * Y) := by
      have e1 : ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((S : ℝ) / W * c) =
          (S : ℝ) * (((V : ℝ) / W + (W : ℝ) ^ j) * c) := by
        field_simp; ring
      rw [e1, ← mul_add]
      apply mul_le_mul_of_nonneg_left _ hS0
      refine le_trans h1 ?_
      gcongr
    have hlin : (K : ℝ) * ((V : ℝ) + 1) ≤ ((V : ℝ) + (W : ℝ) ^ (j + 1)) * C := by
      rw [hC]
      have hV0 : (0 : ℝ) ≤ V := Nat.cast_nonneg V
      have hq : (1 : ℝ) ≤ (q : ℝ) + 1 := by have := (Nat.cast_nonneg q : (0 : ℝ) ≤ q); linarith
      have hK0 : (0 : ℝ) ≤ K := Nat.cast_nonneg K
      have a : (V : ℝ) + 1 ≤ (V : ℝ) + (W : ℝ) ^ (j + 1) := by linarith
      calc (K : ℝ) * ((V : ℝ) + 1) ≤ (K : ℝ) * ((V : ℝ) + (W : ℝ) ^ (j + 1)) :=
            mul_le_mul_of_nonneg_left a hK0
        _ ≤ (K : ℝ) * ((V : ℝ) + (W : ℝ) ^ (j + 1)) * ((q : ℝ) + 1) := le_mul_of_one_le_right
            (by positivity) hq
        _ = _ := by ring
    have hov : (Kb : ℝ) * Y + (S : ℝ) * ((Kd : ℝ) * Y) +
        (S : ℝ) * (((Kb : ℝ) + (S : ℝ) * Kd) * ((S : ℝ) + 1) ^ j * Y) ≤
        ((Kb : ℝ) + (S : ℝ) * Kd) * ((S : ℝ) + 1) ^ (j + 1) * Y := by
      have hKK : (0 : ℝ) ≤ ((Kb : ℝ) + (S : ℝ) * Kd) * Y := by positivity
      have := mul_le_mul_of_nonneg_left hP hKK
      nlinarith
    nlinarith

