-- title:
--   Erdős 287 finite extension with a shared Proth prime
-- statement:
--   Let $M$ be the maximum denominator in a strictly increasing exact unit-fraction representation of one. If $M$ lies between $1+\lfloor1359(2^{3217}-2)/500\rfloor$ and the exact upper endpoint in the Lean statement, approximately $3.56834450\cdot10^{969}$, then there is a consecutive gap of at least three.
-- source:
--   Erdős Problem 287, https://www.erdosproblems.com/287. Shared Proth prime, bounded cofactor omissions and exact interval overlap.

import Mathlib

theorem Erdos287.gap_three_in_shared_anchor_proth_extension (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hlo :  ≤ f (k - 1)) (hhi : f (k - 1) ≤ ) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
