open Finset Real

namespace J6Seg
open J6QLU

section stage
variable (P : ℕ)

lemma dgI_eq_sum (c x : ℕ → ℤ) (u : ℕ) : dgI P c x u = rs P (∑ k ∈ {u}, c k * x k) := by
  simp [dgI, fmul]

lemma dg_eq_sum (c x : ℕ → ℝ) (u : ℕ) : dg c x u = ∑ k ∈ {u}, c k * x k := by simp [dg]

/-- diagonal stage error -/
lemma dg_stage {ct xt : ℕ → ℤ} {c x : ℕ → ℝ} {u : ℕ} {ec δ X C : ℝ}
    (hc : |(ct u : ℝ) / 2 ^ P - c u| ≤ ec) (hC : |c u| ≤ C)
    (hx : |(xt u : ℝ) / 2 ^ P - x u| ≤ δ) (hX : |(xt u : ℝ) / 2 ^ P| ≤ X)
    (hec : 0 ≤ ec) (hδ : 0 ≤ δ) :
    |(dgI P ct xt u : ℝ) / 2 ^ P - dg c x u| ≤ 1 / (2 * 2 ^ P) + ec * X + C * δ := by
  rw [dgI_eq_sum, dg_eq_sum]
  have := sum_stage P (I := {u}) (ct := ct) (xt := xt) (c := c) (x := x) (ec := ec) (δ := δ)
    (X := X) (C := C) (by simpa using hc) (by simpa using hC) (by simpa using hx)
    (by simpa using hX) hec hδ
  simpa using this

/-- lower Toeplitz stage error -/
lemma lw_stage {ct xt : ℕ → ℤ} {c x : ℕ → ℝ} {u : ℕ} {ec δ X C : ℝ}
    (hc : ∀ k ≤ u, |(ct (u - k) : ℝ) / 2 ^ P - c (u - k)| ≤ ec)
    (hC : ∑ k ∈ range (u + 1), |c (u - k)| ≤ C)
    (hx : ∀ k ≤ u, |(xt k : ℝ) / 2 ^ P - x k| ≤ δ) (hX : ∀ k ≤ u, |(xt k : ℝ) / 2 ^ P| ≤ X)
    (hec : 0 ≤ ec) (hδ : 0 ≤ δ) :
    |(lwI P ct xt u : ℝ) / 2 ^ P - lw c x u| ≤ 1 / (2 * 2 ^ P) + (u + 1) * ec * X + C * δ := by
  have := sum_stage P (I := range (u + 1)) (ct := fun k => ct (u - k)) (xt := xt)
    (c := fun k => c (u - k)) (x := x) (ec := ec) (δ := δ) (X := X) (C := C)
    (fun k hk => hc k (by simp at hk; omega)) hC (fun k hk => hx k (by simp at hk; omega))
    (fun k hk => hX k (by simp at hk; omega)) hec hδ
  rw [card_range] at this; push_cast at this
  exact this

/-- upper Toeplitz stage error -/
lemma up_stage {n : ℕ} {ct xt : ℕ → ℤ} {c x : ℕ → ℝ} {u : ℕ} {ec δ X C : ℝ}
    (hc : ∀ k, u ≤ k → k < n → |(ct (k - u) : ℝ) / 2 ^ P - c (k - u)| ≤ ec)
    (hC : ∑ k ∈ Ico u n, |c (k - u)| ≤ C)
    (hx : ∀ k < n, |(xt k : ℝ) / 2 ^ P - x k| ≤ δ) (hX : ∀ k < n, |(xt k : ℝ) / 2 ^ P| ≤ X)
    (hec : 0 ≤ ec) (hδ : 0 ≤ δ) (hX0 : 0 ≤ X) :
    |(upI P n ct xt u : ℝ) / 2 ^ P - up n c x u| ≤ 1 / (2 * 2 ^ P) + n * ec * X + C * δ := by
  have := sum_stage P (I := Ico u n) (ct := fun k => ct (k - u)) (xt := xt)
    (c := fun k => c (k - u)) (x := x) (ec := ec) (δ := δ) (X := X) (C := C)
    (fun k hk => hc k (by simp at hk; omega) (by simp at hk; omega)) hC
    (fun k hk => hx k (by simp at hk; omega))
    (fun k hk => hX k (by simp at hk; omega)) hec hδ
  refine this.trans ?_
  have : ((Ico u n).card : ℝ) ≤ n := by rw [Nat.card_Ico]; exact_mod_cast Nat.sub_le n u
  have h2 : 0 ≤ ec * X := mul_nonneg hec hX0
  nlinarith

end stage

/-! ### The block solve -/

section blk
variable (P : ℕ) (α σ b : ℝ)

lemma ulp_div {x : ℤ} {y E : ℝ} (h : |(x : ℝ) - 2 ^ P * y| ≤ E) :
    |(x : ℝ) / 2 ^ P - y| ≤ E / 2 ^ P := by
  have hS := two_pow_pos' P
  have e : (x : ℝ) / 2 ^ P - y = ((x : ℝ) - 2 ^ P * y) / 2 ^ P := by field_simp
  rw [e, abs_div, abs_of_pos hS]; exact div_le_div_of_nonneg_right h hS.le

variable {P α σ b}

/-- **Block solve error.** -/
theorem blkI_err_sol_aux {T : Tables} {a n : ℕ} {E B Dm : ℝ} (hα : 2 ≤ α) (hσ : 1 ≤ σ)
    (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2) (hT : BlkTab P α σ b T a n E)
    (hE : 0 ≤ E) (hB : 0 ≤ B) (hDm : ∀ u < n, ddR α σ u ≤ Dm)
    (hP : 8 * (((n : ℝ) + 1) * E + 1) * (B + 1) ≤ 2 ^ P)
    (z : ℕ → ℤ) (hz : ∀ u < n, |(z u : ℝ) / 2 ^ P| ≤ B) :
    ∀ u < n, |(blkI P T a n z u : ℝ) / 2 ^ P - blkE α σ b n (fun k => (z k : ℝ) / 2 ^ P) u| ≤
      9 * Dm * (((n : ℝ) + 1) * E + 1) * (B + 1) / 2 ^ P := by
  intro u0 hu0
  have hS : (0 : ℝ) < 2 ^ P := two_pow_pos' P
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((n : ℝ) + 1) * E + 1 := ⟨_, rfl⟩
  rw [← hK] at hP ⊢
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  have hnE : 0 ≤ ((n : ℝ) + 1) * E := mul_nonneg (by linarith) hE
  have hK1 : 1 ≤ K := by linarith
  obtain ⟨X, hX⟩ : ∃ X : ℝ, X = 1.2 * (B + 1) := ⟨_, rfl⟩
  obtain ⟨yS, hyS⟩ : ∃ yS : ℝ, yS = 1.2 * K * (B + 1) / 2 ^ P := ⟨_, rfl⟩
  have hX0 : 0 ≤ X := by rw [hX]; positivity
  have hyS0 : 0 ≤ yS := by rw [hyS]; positivity
  have hyS1 : 6.31 * yS ≤ 1 := by
    rw [hyS, ← mul_div_assoc, div_le_one hS]; nlinarith
  have hEX : 0 ≤ E * X := mul_nonneg hE hX0
  have hmain : ∀ m : ℝ, 0 ≤ m → m ≤ (n : ℝ) + 1 → 1 / (2 * 2 ^ P) + m * (E / 2 ^ P) * X ≤ yS := by
    intro m hm0 hm
    have e : 1 / (2 * (2 : ℝ) ^ P) + m * (E / 2 ^ P) * X = (1 / 2 + m * E * X) / 2 ^ P := by
      field_simp
    rw [e, hyS]
    apply div_le_div_of_nonneg_right _ hS.le
    have : m * E * X ≤ ((n : ℝ) + 1) * E * X := by
      have := mul_le_mul_of_nonneg_right hm hEX; nlinarith
    rw [hX, hK] at *; nlinarith [mul_nonneg hnE hB]
  have hbD : 1 / (2 * 2 ^ P) + E / 2 ^ P * X ≤ yS := by
    have := hmain 1 (by norm_num) (by linarith); simpa using this
  have hbL : ∀ u < n, 1 / (2 * 2 ^ P) + ((u : ℝ) + 1) * (E / 2 ^ P) * X ≤ yS := by
    intro u hu
    have : (u : ℝ) + 1 ≤ n := by exact_mod_cast hu
    exact hmain _ (by positivity) (by linarith)
  have hbU : 1 / (2 * 2 ^ P) + (n : ℝ) * (E / 2 ^ P) * X ≤ yS := hmain _ hn0 (by linarith)
  have hDm1 : 1 ≤ Dm := le_trans (one_le_ddR hσ 0) (hDm 0 (by omega))
  have hES : 0 ≤ E / 2 ^ P := div_nonneg hE hS.le
  -- conversion of table hypotheses to real units
  have tdi : ∀ u < n, |(T.di u : ℝ) / 2 ^ P - diR α σ u| ≤ E / 2 ^ P :=
    fun u hu => ulp_div P (hT.di u hu)
  have tgi : ∀ u < n, |(T.gi u : ℝ) / 2 ^ P - giR α σ u| ≤ E / 2 ^ P :=
    fun u hu => ulp_div P (hT.gi u hu)
  have tgam : ∀ u < n, |(T.gam u : ℝ) / 2 ^ P - gamR α σ u| ≤ E / 2 ^ P :=
    fun u hu => ulp_div P (hT.gam u hu)
  have tap : ∀ h < n, |(T.ap a h : ℝ) / 2 ^ P - aplus α σ b h| ≤ E / 2 ^ P :=
    fun h hh => ulp_div P (hT.ap h hh)
  have tam : ∀ h < n, |(T.am a h : ℝ) / 2 ^ P - aminus α σ b h| ≤ E / 2 ^ P :=
    fun h hh => ulp_div P (hT.am h hh)
  have tdd : ∀ u < n, |(T.dd u : ℝ) / 2 ^ P - ddR α σ u| ≤ E * Dm / 2 ^ P := by
    intro u hu
    refine (ulp_div P (hT.dd u hu)).trans (div_le_div_of_nonneg_right ?_ hS.le)
    exact mul_le_mul_of_nonneg_left (hDm u hu) hE
  have hcomp : ∀ {d e ζ : ℝ}, |ζ| ≤ 1.104 * B → |d - ζ| ≤ e → e ≤ 1 → |d| ≤ X := by
    intro d e ζ h1 h2 h3
    have := abs_sub_abs_le_abs_sub d ζ
    rw [hX]; linarith
  -- the stages
  set ζ0 : ℕ → ℝ := fun k => (z k : ℝ) / 2 ^ P with hζ0
  set ζ1 := dg (diR α σ) ζ0
  set ζ2 := dg (giR α σ) ζ1
  set ζ3 := lw (aminus α σ b) ζ2
  set ζ4 := dg (gamR α σ) ζ3
  set ζ5 := up n (aplus α σ b) ζ4
  set ζ6 := dg (giR α σ) ζ5
  set z1 := dgI P T.di z
  set z2 := dgI P T.gi z1
  set z3 := lwI P (T.am a) z2
  set z4 := dgI P T.gam z3
  set z5 := upI P n (T.ap a) z4
  set z6 := dgI P T.gi z5
  have hgi : ∀ u, |giR α σ u| ≤ 1.0001 := fun u => by
    rw [abs_of_pos (giR_pos hα hσ u)]; exact giR_le hα hσ u
  have hgam : ∀ u, |gamR α σ u| ≤ 1 := fun u => by
    rw [abs_of_pos (gamR_pos hα hσ u)]; exact gamR_le_one hα hσ u
  have hdi : ∀ u, |diR α σ u| ≤ 1 := fun u => by
    rw [abs_of_pos (diR_pos u)]; exact diR_le_one hσ u
  -- stage 1
  have b1 : ∀ u < n, |ζ1 u| ≤ B := by
    intro u hu; simp only [ζ1, dg, abs_mul]
    exact (mul_le_of_le_one_left (abs_nonneg _) (hdi u)).trans (hz u hu)
  have e1 : ∀ u < n, |(z1 u : ℝ) / 2 ^ P - ζ1 u| ≤ 1 * yS := by
    intro u hu
    have := dg_stage P (ct := T.di) (xt := z) (c := diR α σ) (x := ζ0) (u := u) (ec := E / 2 ^ P)
      (δ := 0) (X := X) (C := 1) (tdi u hu) (hdi u) (by simp [ζ0])
      (by rw [hX]; linarith [hz u hu]) hES le_rfl
    linarith
  have x1 : ∀ u < n, |(z1 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (by linarith [b1 u hu]) (e1 u hu) (by linarith)
  -- stage 2
  have b2 : ∀ u < n, |ζ2 u| ≤ 1.0001 * B := by
    intro u hu; simp only [ζ2, dg, abs_mul]
    exact mul_le_mul (hgi u) (b1 u hu) (abs_nonneg _) (by norm_num)
  have e2 : ∀ u < n, |(z2 u : ℝ) / 2 ^ P - ζ2 u| ≤ 2.0001 * yS := by
    intro u hu
    have := dg_stage P (ct := T.gi) (xt := z1) (c := giR α σ) (x := ζ1) (u := u)
      (ec := E / 2 ^ P) (δ := 1 * yS) (X := X) (C := 1.0001) (tgi u hu) (hgi u) (e1 u hu)
      (x1 u hu) hES (by linarith)
    linarith
  have x2 : ∀ u < n, |(z2 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (by linarith [b2 u hu]) (e2 u hu) (by linarith)
  -- stage 3
  have b3 : ∀ u < n, |ζ3 u| ≤ 1.0502 * B := by
    intro u hu; simp only [ζ3, lw]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ range (u + 1), |aminus α σ b (u - k) * ζ2 k|
        ≤ ∑ k ∈ range (u + 1), |aminus α σ b (u - k)| * (1.0001 * B) :=
          sum_le_sum fun k hk => by
            rw [abs_mul]; exact mul_le_mul_of_nonneg_left (b2 k (by simp at hk; omega))
              (abs_nonneg _)
      _ = (∑ k ∈ range (u + 1), |aminus α σ b (u - k)|) * (1.0001 * B) := by rw [sum_mul]
      _ ≤ 1.05 * (1.0001 * B) := mul_le_mul_of_nonneg_right (lw_rowsum hα hσ hx hb u)
          (by positivity)
      _ ≤ 1.0502 * B := by nlinarith
  have e3 : ∀ u < n, |(z3 u : ℝ) / 2 ^ P - ζ3 u| ≤ 3.1002 * yS := by
    intro u hu
    have := lw_stage P (ct := T.am a) (xt := z2) (c := aminus α σ b) (x := ζ2) (u := u)
      (ec := E / 2 ^ P) (δ := 2.0001 * yS) (X := X) (C := 1.05)
      (fun k hk => tam _ (by omega)) (lw_rowsum hα hσ hx hb u)
      (fun k hk => e2 k (by omega)) (fun k hk => x2 k (by omega)) hES (by linarith)
    have := hbL u hu
    linarith
  have x3 : ∀ u < n, |(z3 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (by linarith [b3 u hu]) (e3 u hu) (by linarith)
  -- stage 4
  have b4 : ∀ u < n, |ζ4 u| ≤ 1.0502 * B := by
    intro u hu; simp only [ζ4, dg, abs_mul]
    exact (mul_le_of_le_one_left (abs_nonneg _) (hgam u)).trans (b3 u hu)
  have e4 : ∀ u < n, |(z4 u : ℝ) / 2 ^ P - ζ4 u| ≤ 4.1002 * yS := by
    intro u hu
    have := dg_stage P (ct := T.gam) (xt := z3) (c := gamR α σ) (x := ζ3) (u := u)
      (ec := E / 2 ^ P) (δ := 3.1002 * yS) (X := X) (C := 1) (tgam u hu) (hgam u) (e3 u hu)
      (x3 u hu) hES (by linarith)
    linarith
  have x4 : ∀ u < n, |(z4 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (by linarith [b4 u hu]) (e4 u hu) (by linarith)
  -- stage 5
  have b5 : ∀ u < n, |ζ5 u| ≤ 1.1028 * B := by
    intro u hu; simp only [ζ5, up]
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ Ico u n, |aplus α σ b (k - u) * ζ4 k|
        ≤ ∑ k ∈ Ico u n, |aplus α σ b (k - u)| * (1.0502 * B) :=
          sum_le_sum fun k hk => by
            rw [abs_mul]; exact mul_le_mul_of_nonneg_left (b4 k (by simp at hk; omega))
              (abs_nonneg _)
      _ = (∑ k ∈ Ico u n, |aplus α σ b (k - u)|) * (1.0502 * B) := by rw [sum_mul]
      _ ≤ 1.05 * (1.0502 * B) := mul_le_mul_of_nonneg_right (up_rowsum hα hσ hx hb n u)
          (by positivity)
      _ ≤ 1.1028 * B := by nlinarith
  have e5 : ∀ u < n, |(z5 u : ℝ) / 2 ^ P - ζ5 u| ≤ 5.3053 * yS := by
    intro u hu
    have := up_stage P (n := n) (ct := T.ap a) (xt := z4) (c := aplus α σ b) (x := ζ4) (u := u)
      (ec := E / 2 ^ P) (δ := 4.1002 * yS) (X := X) (C := 1.05)
      (fun k hk1 hk2 => tap _ (by omega)) (up_rowsum hα hσ hx hb n u)
      e4 x4 hES (by linarith) hX0
    linarith
  have x5 : ∀ u < n, |(z5 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (by linarith [b5 u hu]) (e5 u hu) (by linarith)
  -- stage 6
  have b6 : ∀ u < n, |ζ6 u| ≤ 1.104 * B := by
    intro u hu; simp only [ζ6, dg, abs_mul]
    calc |giR α σ u| * |ζ5 u| ≤ 1.0001 * (1.1028 * B) :=
          mul_le_mul (hgi u) (b5 u hu) (abs_nonneg _) (by norm_num)
      _ ≤ 1.104 * B := by nlinarith
  have e6 : ∀ u < n, |(z6 u : ℝ) / 2 ^ P - ζ6 u| ≤ 6.306 * yS := by
    intro u hu
    have := dg_stage P (ct := T.gi) (xt := z5) (c := giR α σ) (x := ζ5) (u := u)
      (ec := E / 2 ^ P) (δ := 5.3053 * yS) (X := X) (C := 1.0001) (tgi u hu) (hgi u) (e5 u hu)
      (x5 u hu) hES (by linarith)
    linarith
  have x6 : ∀ u < n, |(z6 u : ℝ) / 2 ^ P| ≤ X := fun u hu =>
    hcomp (b6 u hu) (e6 u hu) (by linarith)
  -- stage 7
  have hdd : |ddR α σ u0| ≤ Dm := by rw [abs_of_pos (ddR_pos u0)]; exact hDm u0 hu0
  have h7 := dg_stage P (ct := T.dd) (xt := z6) (c := ddR α σ) (x := ζ6) (u := u0)
    (ec := E * Dm / 2 ^ P) (δ := 6.306 * yS) (X := X) (C := Dm) (tdd u0 hu0) hdd (e6 u0 hu0)
    (x6 u0 hu0) (by positivity) (by linarith)
  have h7a : 1 / (2 * 2 ^ P) + E * Dm / 2 ^ P * X ≤ Dm * yS := by
    have e : E * Dm / 2 ^ P * X = Dm * (E / 2 ^ P * X) := by ring
    have h1 : 1 / (2 * (2 : ℝ) ^ P) ≤ Dm * (1 / (2 * 2 ^ P)) :=
      le_mul_of_one_le_left (by positivity) hDm1
    calc 1 / (2 * 2 ^ P) + E * Dm / 2 ^ P * X ≤ Dm * (1 / (2 * 2 ^ P)) + Dm * (E / 2 ^ P * X) := by
          rw [e]; linarith
      _ = Dm * (1 / (2 * 2 ^ P) + E / 2 ^ P * X) := by ring
      _ ≤ Dm * yS := mul_le_mul_of_nonneg_left hbD (by linarith)
  have hfin : 9 * Dm * K * (B + 1) / 2 ^ P = 7.5 * (Dm * yS) := by rw [hyS]; ring
  have hDy : 0 ≤ Dm * yS := mul_nonneg (by linarith) hyS0
  show |(dgI P T.dd z6 u0 : ℝ) / 2 ^ P - dg (ddR α σ) ζ6 u0| ≤ 9 * Dm * K * (B + 1) / 2 ^ P
  rw [hfin]
  have : Dm * (6.306 * yS) = 6.306 * (Dm * yS) := by ring
  linarith

end blk

