    (c : ℕ) (hc : 2 ≤ c)
    (InB : ∀ (e : ℕ) (T : Type) [CommRing T] [Algebra C T],
        SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C T))) (ξ e ≫ Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))) → Prop)
