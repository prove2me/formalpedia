open NLogN
open NLogN.KFV
open IntMul KIL KFB KFH Synth AModel AModelL12
variable {r F : ℕ}
theorem solution {zs : List NLogN.KFB.GI} {xs : List (Fin r → ℂ)} (h : NLogN.KFH.RecRep r F zs xs) (sh : AModel.Shape)
    (hxs : xs.length = AModel.vol sh) {g : List ℕ → List ℕ} (hg : ∀ a, AModel.Valid sh a → AModel.Valid sh (g a)) :
    NLogN.KFH.RecRep r F (AModel.pull (sh ++ [r]) (sh ++ [r]) (NLogN.KFV.extA sh.length g) 0 zs) (AModel.pull sh sh g 0 xs) := by
  refine ⟨by simp [AModel.vol_append], fun j c hj => ?_⟩
  simp only [AModel.length_pull] at hj
  have hv := hg _ (AModel.valid_decode hj)
  have he := AModel.encode_lt hv
  rw [NLogN.KFV.getD_pull_snoc sh r hg 0 zs hj c.2, NLogN.KFV.getD_pull' _ _ _ _ _ hj]
  exact h.2 _ c (by rw [hxs]; exact he)
end
