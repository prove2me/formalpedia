theorem map_smul_of_map_heckeGen {M N : Type} [AddCommGroup M] [Module HeckeAlg M]
    [AddCommGroup N] [Module HeckeAlg N] (f : M →+ N)
    (hf : ∀ (ℓ : Nat.Primes) (x : M), f (heckeGen ℓ • x) = heckeGen ℓ • f x)
    (t : HeckeAlg) (x : M) : f (t • x) = t • f x := by
  revert x
  apply MvPolynomial.induction_on (motive := fun t : HeckeAlg => ∀ x : M, f (t • x) = t • f x) t
  · intro a x
    rw [eq_intCast MvPolynomial.C a, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul, map_zsmul]
  · intro p q hp hq x
    rw [add_smul, map_add, hp, hq, add_smul]
  · intro p n hp x
    rw [mul_smul, mul_smul, hp (MvPolynomial.X n • x), show f (MvPolynomial.X n • x) = MvPolynomial.X n • f x from hf n x]

def mkHeckeLinear {M N : Type} [AddCommGroup M] [Module HeckeAlg M]
    [AddCommGroup N] [Module HeckeAlg N] (f : M →+ N)
    (hf : ∀ (ℓ : Nat.Primes) (x : M), f (heckeGen ℓ • x) = heckeGen ℓ • f x) : M →ₗ[HeckeAlg] N where
  toFun := f
  map_add' := f.map_add
  map_smul' t x := map_smul_of_map_heckeGen f hf t x

@[scoped simp] theorem mkHeckeLinear_apply {M N : Type} [AddCommGroup M] [Module HeckeAlg M]
    [AddCommGroup N] [Module HeckeAlg N] (f : M →+ N)
    (hf : ∀ (ℓ : Nat.Primes) (x : M), f (heckeGen ℓ • x) = heckeGen ℓ • f x) (x : M) :
    mkHeckeLinear f hf x = f x := rfl

theorem dual_restrict_surjective_of_saturated {ι : Type} [Fintype ι] (L Y : Submodule ℤ (ι → ℤ)) (hYL : Y ≤ L)
    (htf : ∀ (n : ℤ) (x : ι → ℤ), n ≠ 0 → x ∈ L → n • x ∈ Y → x ∈ Y) :
    Function.Surjective (Submodule.inclusion hYL).dualMap := by
  set Y'' : Submodule ℤ ↥L := Y.comap L.subtype with hY''
  haveI : Module.Finite ℤ ↥L := Module.Finite.of_injective L.subtype L.injective_subtype
  haveI : NoZeroSMulDivisors ℤ (↥L ⧸ Y'') := by
    refine ⟨fun {n q} h => ?_⟩
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective Y'' q
    by_cases hn : n = 0
    · exact Or.inl hn
    · right
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      rw [Submodule.mkQ_apply] at h
      have h' : (Submodule.Quotient.mk (n • x) : ↥L ⧸ Y'') = 0 := by
        simpa [Submodule.Quotient.mk_smul] using h
      rw [Submodule.Quotient.mk_eq_zero] at h'
      show (x : ι → ℤ) ∈ Y
      exact htf n x hn x.2 h'
  haveI : Module.Finite ℤ (↥L ⧸ Y'') := Module.Finite.quotient ℤ Y''
  haveI : Module.Free ℤ (↥L ⧸ Y'') := Module.free_of_finite_type_torsion_free'
  obtain ⟨sct, hsct⟩ := Module.projective_lifting_property Y''.mkQ (LinearMap.id : (↥L ⧸ Y'') →ₗ[ℤ] (↥L ⧸ Y''))
    (Submodule.mkQ_surjective Y'')
  let π : ↥L →ₗ[ℤ] ↥L := LinearMap.id - sct ∘ₗ Y''.mkQ
  have hπ : ∀ x, π x ∈ Y'' := fun x => by
    rw [← Submodule.ker_mkQ Y'', LinearMap.mem_ker]
    have h1 := LinearMap.congr_fun hsct (Y''.mkQ x)
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at h1
    show Y''.mkQ (x - sct (Y''.mkQ x)) = 0
    rw [map_sub, h1]
    exact sub_self _
  let e : ↥Y'' ≃ₗ[ℤ] ↥Y := Submodule.comapSubtypeEquivOfLe hYL
  intro g
  refine ⟨g ∘ₗ e.toLinearMap ∘ₗ LinearMap.codRestrict Y'' π hπ, ?_⟩
  apply LinearMap.ext
  intro y
  rw [LinearMap.dualMap_apply]
  show g (e ⟨π (Submodule.inclusion hYL y), hπ _⟩) = g y
  congr 1
  have hy0 : Y''.mkQ (Submodule.inclusion hYL y) = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    show (y : ι → ℤ) ∈ Y
    exact y.2
  have hπy : π (Submodule.inclusion hYL y) = Submodule.inclusion hYL y := by
    show Submodule.inclusion hYL y - sct (Y''.mkQ (Submodule.inclusion hYL y)) = _
    rw [hy0, map_zero, sub_zero]
  apply Subtype.ext
  show ((π (Submodule.inclusion hYL y) : ↥L) : ι → ℤ) = (y : ι → ℤ)
  rw [hπy]
  rfl

theorem finrank_eq_of_natCard_eq {k A B : Type} [Field k] [AddCommGroup A] [Module k A] [AddCommGroup B] [Module k B]
    [Finite A] [Finite B] (h : Nat.card A = Nat.card B) : Module.finrank k A = Module.finrank k B := by
  by_cases hk : Finite k
  · haveI := Fintype.ofFinite k
    haveI := Fintype.ofFinite A
    haveI := Fintype.ofFinite B
    haveI : Module.Finite k A := Module.Finite.of_finite
    haveI : Module.Finite k B := Module.Finite.of_finite
    have hA := Module.card_eq_pow_finrank (K := k) (V := A)
    have hB := Module.card_eq_pow_finrank (K := k) (V := B)
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, hA, hB] at h
    exact Nat.pow_right_injective Fintype.one_lt_card h
  ·
    rw [not_finite_iff_infinite] at hk
    have hsub : ∀ (C : Type) [AddCommGroup C] [Module k C] [Finite C], Subsingleton C := by
      intro C _ _ _
      by_contra hC
      rw [not_subsingleton_iff_nontrivial] at hC
      obtain ⟨c, hc⟩ := exists_ne (0 : C)
      have hinj : Function.Injective fun a : k => a • c := smul_left_injective k hc
      haveI := hk
      haveI := Finite.of_injective _ hinj
      exact not_finite k
    haveI := hsub A
    haveI := hsub B
    rw [Module.finrank_zero_of_subsingleton, Module.finrank_zero_of_subsingleton]

theorem subsingleton_of_two_smul_surjective (W : Type) [AddCommGroup W] [Module.Finite ℤ W] [Module.Free ℤ W]
    (h2 : Function.Surjective fun w : W => (2 : ℤ) • w) : Subsingleton W := by
  classical
  let b := Module.Free.chooseBasis ℤ W
  by_contra hW
  rw [not_subsingleton_iff_nontrivial] at hW
  haveI : Nonempty (Module.Free.ChooseBasisIndex ℤ W) := by
    by_contra he
    rw [not_nonempty_iff] at he
    haveI := he
    exact (not_nontrivial_iff_subsingleton.2 (b.repr.toEquiv.subsingleton)) hW
  obtain ⟨i⟩ := (inferInstance : Nonempty (Module.Free.ChooseBasisIndex ℤ W))
  obtain ⟨u, hu⟩ := h2 (b i)
  have h := congrArg (fun w => b.repr w i) hu
  simp only [map_smul, Finsupp.smul_apply, smul_eq_mul, Module.Basis.repr_self, Finsupp.single_eq_same] at h
  omega

theorem finite_quot_smul_top {R : Type} [CommRing R] (N : Type) [AddCommGroup N] [Module R N]
    (hN : Module.Finite ℤ N) (𝔪 : Ideal R) [𝔪.IsMaximal] :
    Finite (N ⧸ (𝔪 • (⊤ : Submodule R N))) := by
  classical
  haveI := hN
  letI : Field (R ⧸ 𝔪) := Ideal.Quotient.field 𝔪

  have hfin : Module.Finite ℤ (N ⧸ (𝔪 • (⊤ : Submodule R N))) :=
    Module.Finite.of_surjective ((𝔪 • (⊤ : Submodule R N)).mkQ.restrictScalars ℤ) (by
      intro w
      obtain ⟨n, rfl⟩ := Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule R N)) w
      exact ⟨n, rfl⟩)

  have hkill : ∀ (r : R), r ∈ 𝔪 → ∀ w : (N ⧸ (𝔪 • (⊤ : Submodule R N))), r • w = 0 := by
    intro r hr w
    obtain ⟨n, rfl⟩ := Submodule.mkQ_surjective _ w
    rw [Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    exact Submodule.smul_mem_smul hr Submodule.mem_top
  by_cases hp : ringChar (R ⧸ 𝔪) = 0
  ·
    haveI : CharZero (R ⧸ 𝔪) := by
      haveI := ringChar.charP (R ⧸ 𝔪); rw [hp] at this; exact CharP.charP_to_charZero (R ⧸ 𝔪)
    have hunit : ∀ n : ℤ, n ≠ 0 → ∃ r : R, ((r * n - 1 : R)) ∈ 𝔪 := by
      intro n hn
      have hne : ((n : R ⧸ 𝔪)) ≠ 0 := by exact_mod_cast hn
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective ((n : R ⧸ 𝔪))⁻¹
      refine ⟨r, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, map_mul, hr, map_intCast, inv_mul_cancel₀ hne, sub_self]
    have hdiv : ∀ n : ℤ, n ≠ 0 → ∀ w : (N ⧸ (𝔪 • (⊤ : Submodule R N))), ∃ u : (N ⧸ (𝔪 • (⊤ : Submodule R N))), n • u = w := by
      intro n hn w
      obtain ⟨r, hr⟩ := hunit n hn
      refine ⟨r • w, ?_⟩
      have h0 := hkill _ hr w
      rw [sub_smul, one_smul, sub_eq_zero, mul_smul] at h0
      rw [smul_comm]
      rwa [Int.cast_smul_eq_zsmul] at h0
    have htf : ∀ (n : ℤ) (w : (N ⧸ (𝔪 • (⊤ : Submodule R N)))), n • w = 0 → n = 0 ∨ w = 0 := by
      intro n w hnw
      by_cases hn : n = 0
      · exact Or.inl hn
      · right
        obtain ⟨r, hr⟩ := hunit n hn
        have h0 := hkill _ hr w
        rw [sub_smul, one_smul, sub_eq_zero, mul_smul, Int.cast_smul_eq_zsmul, hnw, smul_zero] at h0
        exact h0.symm
    haveI : NoZeroSMulDivisors ℤ (N ⧸ (𝔪 • (⊤ : Submodule R N))) := ⟨fun {n w} h => htf n w h⟩
    haveI : Module.Finite ℤ (N ⧸ (𝔪 • (⊤ : Submodule R N))) := hfin
    haveI : Module.Free ℤ (N ⧸ (𝔪 • (⊤ : Submodule R N))) := Module.free_of_finite_type_torsion_free'
    haveI : Subsingleton (N ⧸ (𝔪 • (⊤ : Submodule R N))) := subsingleton_of_two_smul_surjective (N ⧸ (𝔪 • (⊤ : Submodule R N))) (fun w => hdiv 2 (by norm_num) w)
    infer_instance
  ·
    have hpmem : ((ringChar (R ⧸ 𝔪) : R)) ∈ 𝔪 := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_natCast]
      exact ringChar.Nat.cast_ringChar
    have htor : AddMonoid.IsTorsion (N ⧸ (𝔪 • (⊤ : Submodule R N))) := by
      intro w
      rw [isOfFinAddOrder_iff_nsmul_eq_zero]
      refine ⟨ringChar (R ⧸ 𝔪), Nat.pos_of_ne_zero hp, ?_⟩
      have := hkill _ hpmem w
      rwa [Nat.cast_smul_eq_nsmul] at this
    haveI : AddGroup.FG (N ⧸ (𝔪 • (⊤ : Submodule R N))) := Module.Finite.iff_addGroup_fg.1 hfin
    exact AddCommGroup.finite_of_fg_torsion (N ⧸ (𝔪 • (⊤ : Submodule R N))) htor

