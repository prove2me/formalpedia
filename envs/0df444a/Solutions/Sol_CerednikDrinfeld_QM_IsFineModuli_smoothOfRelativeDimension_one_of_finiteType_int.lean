  haveI : IsNoetherianRing (Γ(Spec (CommRingCat.of 𝒪), ⊤) : Type) :=
    isNoetherianRing_of_ringEquiv 𝒪 (Scheme.ΓSpecIso (CommRingCat.of 𝒪)).symm.commRingCatIsoToRingEquiv
  rw [HasRingHomProperty.iff_of_source_openCover (P := @LocallyOfFinitePresentation) M.affineCover]
  intro i
  have hft : ((M.affineCover.f i ≫ πM).appTop).hom.FiniteType :=
    (HasRingHomProperty.iff_of_source_openCover (P := @LocallyOfFiniteType) M.affineCover).mp hlft i
  exact RingHom.FinitePresentation.of_finiteType.mp hft

