-- title:
--   Coordinate powers from a homogeneous monomial tail
-- statement:
--   Under positive rational weights, if every monomial of weighted degree greater than B belongs to the ideal generated by p, then a common positive power of every variable belongs to that ideal. When d = 0, the coordinate conclusion is vacuous.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Real.Basic
import Mathlib.Data.Complex.Basic
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.coordinate_powers_from_monomial_tail_73aae4b1_866b_4d65_aa9b_b11def2b6aef
    {d : Nat} (w : Fin d → ℚ) (hw : ∀ i, 0 < (w i : ℝ))
    (m : Nat) (p : Fin m → MvPolynomial (Fin d) ℂ)
    (B : ℚ)
    (hmono : ∀ (e : Fin d →₀ Nat) (t : ℚ),
      B < t → MvPolynomial.IsWeightedHomogeneous w (MvPolynomial.monomial e (1 : ℂ)) t →
      MvPolynomial.monomial e (1 : ℂ) ∈ Ideal.span (Set.range p)) :
    ∃ N : Nat, 0 < N ∧ ∀ i : Fin d,
      MvPolynomial.monomial (Finsupp.single i N) (1 : ℂ) ∈ Ideal.span (Set.range p) := by sorry
