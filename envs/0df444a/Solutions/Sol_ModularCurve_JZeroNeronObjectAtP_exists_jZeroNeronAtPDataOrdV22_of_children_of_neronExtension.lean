private theorem _root_.ModularCurve.JZeroNeronObjectAtP.ext_iff (x : JZero (N₀ * p)) :
    O.Ext x ↔ ∃ s : SchemeHomOver Λ.σA O.g,
      O.pts x = GoodReductionJacobian.schemeHomOverComp (barPt A) Λ.hσA s := by
