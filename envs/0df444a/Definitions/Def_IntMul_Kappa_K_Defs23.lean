section
-- Source module: Solutions.KFMSm
/-!
# KFM Sm: bit bounds for register expressions from bounds on their atoms

`exSmS A s e`: every register, literal and `2^a` that `e` reads is at most `A` in absolute value,
and every divisor is positive. `exDgS e` is a degree (sums add one, products add). Then
`|e.eval s| ≤ A^{exDgS e}` (**`exSmS_abs`**), and `A^{exDgS e} < 2^B` gives `e.Bnd s B`
(**`exSmS_bnd`**), which is the hypothesis of the RS cost lemmas.
-/

set_option linter.unusedSimpArgs false

namespace NLogN.KFM

open IntMul RS

/-- Atom bounds (see the module doc). -/
def exSmS (A : ℕ) (s : IState HS) : Ex HS → Prop
  | .reg i => |s.top i| ≤ (A : ℤ)
  | .lit c => |c| ≤ (A : ℤ)
  | .add a b | .mul a b => exSmS A s a ∧ exSmS A s b
  | .neg a => exSmS A s a
  | .ndiv a b | .nmod a b => exSmS A s a ∧ exSmS A s b ∧ 0 < b.eval s
  | .pow2 a => exSmS A s a ∧ 0 ≤ a.eval s ∧ 2 ^ (a.eval s).toNat ≤ A
  | .sel c x y => exSmS A s c ∧ exSmS A s x ∧ exSmS A s y
  | _ => False

/-- The degree. -/
def exDgS : Ex HS → ℕ
  | .reg _ | .lit _ => 1
  | .add a b => max (exDgS a) (exDgS b) + 1
  | .mul a b => exDgS a + exDgS b
  | .neg a | .pow2 a => exDgS a
  | .ndiv a b | .nmod a b => max (exDgS a) (exDgS b)
  | .sel c x y => max (exDgS c) (max (exDgS x) (exDgS y))
  | _ => 1

end NLogN.KFM

end

