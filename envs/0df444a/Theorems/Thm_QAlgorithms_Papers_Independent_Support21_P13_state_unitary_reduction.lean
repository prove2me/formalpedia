-- title:
--   First-column lifting with at most seven prepended T gates
-- statement:
--   Let $U\in U(2)$ have all entries in $R$, and let a chronological H/T word $c$ have the same first column as $U$. Put $z=U_{00}$ and $w=U_{10}$. There are $k,k'\in\{0,\ldots,7\}$ such that
--
--   $$
--   U=\begin{pmatrix}z&-\overline w\omega^k\\w&\overline z\omega^k\end{pmatrix},\quad
--   \det M(c)=\omega^{k'},\quad
--   U=M(c)T^{r},\qquad r=(k+8-k')\bmod8.
--   $$
--
--   Consequently the chronological list consisting of $r$ T gates followed by $c$ implements $U$ and has length at most $|c|+7$. Conversely any exact circuit for $U$ already prepares its first column from $|0\rangle$, with the same length. This makes the constant synthesis overhead explicit.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 5, §3 unnumbered: lifting first-column preparation to an exact unitary

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Section 3, PDF pp.4-5: lift any exact first-column preparation to U by right
multiplication with T^r, 0<=r<8. The chronological correction is prepended.
Conversely, a circuit for U prepares its first column without extra gates. -/
theorem state_unitary_reduction (U : Matrix Bool Bool ℂ)
    (hU : U ∈ Matrix.unitaryGroup Bool ℂ) (hring : EntriesInRing U)
    (c : List HTLetter) (hcol : ∀ b, htWordMatrix c b false = U b false) :
    ∃ k kp : Fin 8,
      U = phaseCompletion (U false false) (U true false) (k.val : ℤ) ∧
      (htWordMatrix c).det = (QAlgorithms.gateT true true) ^ kp.val ∧
      let r := (k.val + 8 - kp.val) % 8
      htWordMatrix (List.replicate r HTLetter.t ++ c) = U ∧
      (List.replicate r HTLetter.t ++ c).length ≤ c.length + 7 := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
