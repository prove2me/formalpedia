noncomputable def bcIso (g : X₀ ⟶ X) [IsIso g] (hg : g ≫ πX = πX₀) :
    pullback πX₀ (Spec.map (CommRingCat.ofHom i)) ≅ pullback πX (Spec.map (CommRingCat.ofHom i)) where
  hom := pullback.lift (pullback.fst _ _ ≫ g) (pullback.snd _ _) (by rw [Category.assoc, hg, pullback.condition])
  inv := pullback.lift (pullback.fst _ _ ≫ inv g) (pullback.snd _ _)
    (by rw [Category.assoc, ← hg, IsIso.inv_hom_id_assoc, pullback.condition])
  hom_inv_id := by
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst, Category.id_comp]
      rw [← Category.assoc, pullback.lift_fst, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    · simp only [Category.assoc, pullback.lift_snd, Category.id_comp]
  inv_hom_id := by
    apply pullback.hom_ext
    · simp only [Category.assoc, pullback.lift_fst, Category.id_comp]
      rw [← Category.assoc, pullback.lift_fst, Category.assoc, IsIso.inv_hom_id, Category.comp_id]
    · simp only [Category.assoc, pullback.lift_snd, Category.id_comp]

@[scoped simp] theorem bcIso_hom_fst (g : X₀ ⟶ X) [IsIso g] (hg : g ≫ πX = πX₀) :
    (bcIso i πX₀ πX g hg).hom ≫ pullback.fst _ _ = pullback.fst _ _ ≫ g := pullback.lift_fst _ _ _

@[scoped simp] theorem bcIso_hom_snd (g : X₀ ⟶ X) [IsIso g] (hg : g ≫ πX = πX₀) :
    (bcIso i πX₀ πX g hg).hom ≫ pullback.snd _ _ = pullback.snd _ _ := pullback.lift_snd _ _ _

end BaseChangeIso

