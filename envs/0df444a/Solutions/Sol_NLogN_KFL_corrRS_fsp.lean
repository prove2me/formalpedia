theorem solution {K ρ f : ℕ} (hK : 1 ≤ K) (hρK : ρ < K) (hf : 1 ≤ f) {g : NLogN.KFL.Geo} (hg : g.Pos)
    (hQe : g.Q = 2 ^ (f * K)) (recs : ℕ → List ℤ) (hlen : ∀ m, (recs m).length = g.B)
    (hbits : ∀ m, NLogN.Bnd 1 (recs m)) (s : NLogN.IState NLogN.HS) :
    NLogN.KFD.FSp (NLogN.KFL.corrRS K ρ f g (NLogN.zsz (g.V : ℤ))) (NLogN.KIL.encK s (Function.update (fun _ => []) 0 (NLogN.KFL.flR recs g.recG.V)))
      (NLogN.KIL.encK s (Function.update (fun _ => []) 0 (NLogN.KFL.flR (fun d => recs (NLogN.KFL.corrR K ρ f g d)) g.recG.V)))
      (NLogN.KFL.cCorr K f g (NLogN.zsz (g.V : ℤ)) (NLogN.KFL.nMv (NLogN.KFL.keyR K ρ f g) g.recG.V) (NLogN.zsz (g.V : ℤ) + 3)) := by
  set κ := NLogN.KFL.keyR K ρ f g
  set γ := NLogN.KFL.corrR K ρ f g
  set M := g.recG.V
  set A := NLogN.zsz (g.V : ℤ)
  set Bb := NLogN.zsz (g.V : ℤ) + 3
  have hV : g.V < 2 ^ A := by
    have := NLogN.natAbs_lt_zsz (g.V : ℤ); simpa using this
  have hbig : 4 * g.V < 2 ^ Bb := by
    have : 2 ^ Bb = 8 * 2 ^ A := by simp only [Bb, A]; rw [pow_add]; ring
    omega
  have hB2 : 2 ≤ Bb := by omega
  have hb4 : ((4 * g.V : ℕ) : ℤ) < 2 ^ Bb := by exact_mod_cast hbig
  have hW : ∀ n : ℕ, n ≤ 4 * g.V → NLogN.zsz (n : ℤ) ≤ Bb := fun n hn => NLogN.KFL.zsz_of_le hb4 (by
    rw [abs_of_nonneg (by positivity)]; exact_mod_cast hn)
  have hMV : M ≤ g.V := NLogN.KFL.recG_V_le g hg
  have hBV : g.B ≤ g.V := by
    have := hg.v; rw [NLogN.KFL.Geo.V_rec g] at this ⊢
    exact Nat.le_mul_of_pos_left _ (Nat.pos_of_mul_pos_right this)
  have hMB : M * g.B = g.V := (NLogN.KFL.Geo.V_rec g).symm
  have hVp := hg.v
  have hγκ : ∀ m, γ (κ m) = m := NLogN.KFL.corrR_keyR hg hQe
  have hκγ : ∀ m, κ (γ m) = m := NLogN.KFL.keyR_corrR hg hQe
  have hκ : ∀ m < M, κ m < M := fun m hm => NLogN.KFL.keyR_lt hg hQe hm
  have hγ : ∀ m < M, γ m < M := fun m hm => NLogN.KFL.corrR_lt hg hQe hm
  have hAW : A ≤ 4 * g.V := by
    have := NLogN.zsz_le_of_lt (z := (g.V : ℤ)) (m := g.V) (by simpa using Nat.lt_two_pow_self)
    omega
  set Gn : Fin NLogN.HS → List ℤ := fun _ => []
  -- pushes
  have S1 := NLogN.KIL.Sp.push s (Function.update Gn 0 (NLogN.KFL.flR recs M)) (i := NLogN.KFL.rm) (e := .lit 0) (B := Bb)
    (by decide) (NLogN.KIL.clean_lit _) trivial trivial (by rw [NLogN.Ex.Bnd, NLogN.zsz_zero]; omega)
  simp only [NLogN.Ex.eval] at S1
  have S2 := NLogN.KIL.Sp.push s (Function.update (Function.update Gn 0 (NLogN.KFL.flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (NLogN.KFL.flR recs M) NLogN.KFL.rm)) (i := NLogN.KFL.rNB) (e := .lit 0) (B := Bb)
    (by decide) (NLogN.KIL.clean_lit _) trivial trivial (by rw [NLogN.Ex.Bnd, NLogN.zsz_zero]; omega)
  simp only [NLogN.Ex.eval] at S2
  have e2 : Function.update (Function.update (Function.update Gn 0 (NLogN.KFL.flR recs M)) NLogN.KFL.rm
      ((0 : ℤ) :: Function.update Gn 0 (NLogN.KFL.flR recs M) NLogN.KFL.rm)) NLogN.KFL.rNB ((0 : ℤ) :: Function.update
      (Function.update Gn 0 (NLogN.KFL.flR recs M)) NLogN.KFL.rm ((0 : ℤ) :: Function.update Gn 0 (NLogN.KFL.flR recs M) NLogN.KFL.rm) NLogN.KFL.rNB) =
      NLogN.KFL.P1 κ recs M Gn 0 := by
    funext r
    simp only [NLogN.KFL.P1, Gn]
    by_cases a1 : r = NLogN.KFL.rNB
    · subst a1; simp +decide [NLogN.KFL.nMv]
    by_cases a2 : r = NLogN.KFL.rm
    · subst a2; simp +decide
    by_cases a3 : r = 0
    · subst a3; simp +decide [NLogN.KFL.restR_zero]
    simp [Function.update_apply, a1, a2, a3, NLogN.KFL.stkF, NLogN.KFL.stkK, NLogN.KFL.flL]
  rw [e2] at S2
  -- pass 1
  have SP1 := NLogN.KFL.p1_fsp hK hρK hf hg hQe hB2 hbig recs hlen hbits s Gn rfl rfl
  have g3 : NLogN.KFL.P1 κ recs M Gn M NLogN.KFL.rm = (M : ℤ) :: [] := by simp +decide [NLogN.KFL.P1, Function.update_apply, Gn]
  have S3 := NLogN.KIL.Sp.pop s (NLogN.KFL.P1 κ recs M Gn M) (B := Bb) (by decide) g3 (hW _ (by omega))
  set G3 := Function.update (NLogN.KFL.P1 κ recs M Gn M) NLogN.KFL.rm []
  -- the sort
  set E := NLogN.KFL.ent0 κ M recs
  have hE : ∀ e ∈ E, e.2.length = g.B ∧ NLogN.Bnd 1 e.2 ∧ e.1 ≤ 4 * g.V := by
    intro e he
    simp only [E, NLogN.KFL.ent0, List.mem_map] at he
    obtain ⟨m, hm, rfl⟩ := he
    have hmM := (NLogN.KFL.mem_mvL.1 hm).1
    refine ⟨by simp [hlen], fun a ha => hbits m a (by simpa using ha), ?_⟩
    have := hκ m hmM; simp only; omega
  have hEl : E.length = NLogN.KFL.nMv κ M := NLogN.KFL.length_ent0 κ recs M
  have hEM : E.length ≤ M := by rw [hEl]; exact NLogN.KFL.nMv_le κ M
  have hEW : (E.length + 1) * (g.B + 1) ≤ 4 * g.V := by nlinarith
  have hK0 : E.map (NLogN.KFL.kh 0) = NLogN.KFL.stkK (NLogN.KFL.mvP κ) (fun m => (κ m : ℤ)) M := (NLogN.KFL.stkK_ent0 κ recs M).symm
  have hB0 : E.flatMap Prod.snd = NLogN.KFL.stkF (NLogN.KFL.mvP κ) (fun m => (recs m).reverse) M :=
    (NLogN.KFL.stkF_ent0 κ recs M).symm
  have SR := NLogN.KFL.radix_fsp hB2 hW hAW s G3 E hE hEW (kk0 := []) (kb0 := []) (lnb := [])
    (by rw [hK0]; simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by rw [hB0]; simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn]) (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn])
    (by simp +decide [G3, NLogN.KFL.P1, Function.update_apply, Gn, hEl])
  rw [NLogN.KFL.sort_moved hγκ hκγ hκ hγ (le_of_lt (lt_of_le_of_lt hMV hV)) recs, hEl] at SR
  set Gn' := Function.update Gn NLogN.KFL.rNB [(NLogN.KFL.nMv κ M : ℤ)]
  have e4 : Function.update (Function.update G3 NLogN.KFL.sKK ((NLogN.KFL.ent1 κ γ M recs).map (NLogN.KFL.kh A) ++ []))
      NLogN.KFL.sKB ((NLogN.KFL.ent1 κ γ M recs).flatMap Prod.snd ++ []) = NLogN.KFL.P3 κ γ recs M A Gn' M := by
    rw [← NLogN.KFL.stkK_ent1 κ γ recs M A, ← NLogN.KFL.stkF_ent1 κ γ recs M]
    funext r
    simp only [G3, NLogN.KFL.P1, NLogN.KFL.P3, Gn', Gn]
    by_cases a1 : r = NLogN.KFL.sKB
    · subst a1; simp +decide
    by_cases a2 : r = NLogN.KFL.sKK
    · subst a2; simp +decide
    by_cases a3 : r = NLogN.KFL.rm
    · subst a3; simp +decide
    by_cases a4 : r = NLogN.KFL.rNB
    · subst a4; simp +decide
    by_cases a5 : r = NLogN.KFL.sFL
    · subst a5; simp +decide
    by_cases a6 : r = NLogN.KFL.sT
    · subst a6; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [NLogN.KFL.restR_full]
    simp [Function.update_apply, a1, a2, a3, a4, a5, a6, a7]
  rw [e4] at SR
  -- pass 3
  have SP3 := NLogN.KFL.p3_fsp (A := A) (M := M) hγκ hB2 hlen hbits (hW _ (by omega))
    (fun d hd => hW _ (le_trans (Nat.div_le_self _ _) (by omega))) (hW _ (by omega)) s Gn' rfl
  have g5 : NLogN.KFL.P3 κ γ recs M A Gn' 0 NLogN.KFL.rNB = (NLogN.KFL.nMv κ M : ℤ) :: [] := by
    simp +decide [NLogN.KFL.P3, Function.update_apply, Gn', Gn]
  have S5 := NLogN.KIL.Sp.pop s (NLogN.KFL.P3 κ γ recs M A Gn' 0) (B := Bb) (by decide) g5
    (hW _ (by have := NLogN.KFL.nMv_le κ M; omega))
  have e5 : Function.update (NLogN.KFL.P3 κ γ recs M A Gn' 0) NLogN.KFL.rNB [] =
      Function.update (fun _ => []) 0 (NLogN.KFL.flR (fun d => recs (γ d)) M) := by
    funext r
    simp only [NLogN.KFL.P3, Gn', Gn]
    by_cases a1 : r = NLogN.KFL.rNB
    · subst a1; simp +decide
    by_cases a7 : r = 0
    · subst a7; simp +decide [NLogN.KFL.restR_zero]
    simp +decide [Function.update_apply, a1, a7, NLogN.KFL.stkF, NLogN.KFL.stkK, NLogN.KFL.flL]
  rw [e5] at S5
  have H := (NLogN.KFD.FSp.of_norep rfl S1).seq ((NLogN.KFD.FSp.of_norep rfl S2).seq (SP1.seq ((NLogN.KFD.FSp.of_norep rfl S3).seq
    (SR.seq (SP3.seq (NLogN.KFD.FSp.of_norep rfl S5))))))
  refine H.mono ?_
  clear H S1 S2 SP1 S3 SR SP3 S5
  have : NLogN.KFD.cLp M (NLogN.KFL.cP3 g.B Bb) Bb = NLogN.KFD.cLp g.recG.V (NLogN.KFL.cP3 g.B Bb) Bb := rfl
  simp only [NLogN.KFL.cCorr, NLogN.Ex.size]
  omega
end
