variable {F : Type} [Field F] [ValuativeRel F] [TopologicalSpace F]
variable {E : Type} [CommRing E] [Algebra F E] [TopologicalSpace E]
variable {L : LocE F E} {r k : ℕ} (S : Frames L r k)

theorem GlobalTheory.HL.Defect.det_gens {n n' : S.GLV} (hn : n ∈ S.N) (hn' : n' ∈ S.N') :
    (Matrix.of fun i j => hf L S.Hm (gens S (fun b => n (S.f b)) (fun b => n' (S.f' b)) i)
      (gens S (fun b => n (S.f b)) (fun b => n' (S.f' b)) j)).det =
      (-1) ^ (r + 1) * algebraMap F E S.th⁻¹ ^ (2 * (r + 1)) * S.G := by sorry
