theorem chunkL_eq {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n) :
    chunkL n L = (List.range m).map fun i => (L.drop (i * n)).take n := by
  have : (L.length + n - 1) / n = m := by
    rw [hL]
    have : m * n + n - 1 = m * n + (n - 1) := by omega
    rw [this, Nat.add_comm, Nat.add_mul_div_right _ _ hn, Nat.div_eq_of_lt (by omega)]; simp
  simp only [chunkL, this]

theorem range_chunks_flatten {α : Type*} (n : ℕ) :
    ∀ (m : ℕ) (L : List α), L.length = m * n →
      ((List.range m).map fun i => (L.drop (i * n)).take n).flatten = L
  | 0, L, h => by simp at h; simp [List.eq_nil_of_length_eq_zero (by simpa using h)]
  | m + 1, L, h => by
    rw [List.range_succ_eq_map, List.map_cons, List.map_map, List.flatten_cons]
    have ih := range_chunks_flatten n m (L.drop n) (by simp [h]; ring_nf; omega)
    have e : ((fun i => (L.drop (i * n)).take n) ∘ Nat.succ) =
        fun i => ((L.drop n).drop (i * n)).take n := by
      funext i; simp [List.drop_drop, Nat.succ_mul]; ring_nf
    rw [e, ih]; simp

theorem chunkL_flatten {α : Type*} (n m : ℕ) (L : List α) (hn : 0 < n) (hL : L.length = m * n) :
    (chunkL n L).flatten = L := by
