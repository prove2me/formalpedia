-- Source module: NLogN.HCrIn
/-!
# Chunking, `crtIn` and `evalDigits` as register programs (namespace `NLogN.CR`)
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul IntMul.HvdH IntMul.HvdH.Ref RS

abbrev cX : Fin HS := 30

/-! ## Chunking and zero padding onto stack `0` -/

/-- `x` on `cX` (consumed), the ruler `2^b` on `cRB`, `L` on `cLR`, `S ≥ L` on `1`:
pushes `padL (chunksL b L x) S` onto `0`. -/
def chunkPadP : RM :=
  .seq (.rs (NLogN.CR.zerosP 0 kC1 (.add (.reg 1) (.neg (.reg cLR)))))
  (.seq (chunkP cX cRB kT kC1 (.reg cLR))
  (.rs (NLogN.RS.seq (mvK kT 0 kC3 (.reg cLR)) (pop cX))))

/-- **`crtIn ∘ chunksL`**: chunk `x`, pad, and permute by the keys on `3`. -/
def crtInP : RM := .seq chunkPadP (.rs (permP 1))

/-! ## `evalDigits` -/

/-- Nonnegative digits `c` on `CA` (consumed, `c₀` on top), `2^b` on `CR`, `|c|` on `CM`:
pushes `evalDigits b c` onto `CY`. -/
def evalP : RM := .seq (.rs (push CY (.lit 0))) carryP

end NLogN.CR

