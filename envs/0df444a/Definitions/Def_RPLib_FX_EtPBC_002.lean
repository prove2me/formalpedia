  have i1 := ConcreteCategory.congr_hom (Iso.hom_inv_id_app (pullStalkIso f Λ s) G) a₁
  have i2 := ConcreteCategory.congr_hom (Iso.hom_inv_id_app (pullStalkIso f Λ s) G) a₂
  refine i1.symm.trans (Eq.trans ?_ i2)
  exact congrArg ((pullStalkIso f Λ s).inv.app G).hom h

end RamanujanPetersson.EtPBC

