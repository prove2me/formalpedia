variable {A : Type*} [NonUnitalCStarAlgebra A]

theorem OAI.MainGap.Her_cut_lower {a : A} (ha : 0 ≤ a) {δ : ℝ} (hδ : 0 ≤ δ)
    {p : A} (hp : p ∈ Her (cut a δ)) :
    δ • (star p * p) ≤ star p * a * p := by sorry
