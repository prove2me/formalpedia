          Algebra.norm W (Ideal.Quotient.mk Q.asIdeal (ι (algebraMap ↥(R.nodeIntegersOver K w) _ c.y))) = π ^ n Q * (u Q : W)) ∧
      ((∏ V ∈ S, V.evalAt ((c.y : ↥(modularFunctionFieldBar (N * q)))) : AlgebraicClosure ℚ) :
