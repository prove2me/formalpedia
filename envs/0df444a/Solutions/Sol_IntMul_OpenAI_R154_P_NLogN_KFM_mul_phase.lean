variable (h : ℕ) (bL : ℕ → Bool) (sF μ : ℕ → ℕ) (H : CrtOK d sF μ)
/-- **`Φ` as a padded array.** -/
theorem phiD_pad (hsw : ∀ j < d, sF j ≤ tP d h bL j) (xs : List ℤ) {zs : List GI}
    (hz : gflat zs = PhiD h d bL sF μ xs) :
    haveI := sBox_ne sF μ H
    zs.length = (List.ofFn (tBox d h bL)).prod ∧ PadZ (sBox d sF) (tBox d h bL) zs ∧
    ∀ k : (i : Fin d) → ZMod (sBox d sF i),
      zs.getD (encode (List.ofFn (tBox d h bL)) (kL k)) 0 =
        (xs.getD (2 * ((NLogN.KFM.eB sF μ H).symm k).val) 0, xs.getD (2 * ((NLogN.KFM.eB sF μ H).symm k).val + 1) 0) := by
  haveI := sBox_ne sF μ H
  refine ⟨?_, ?_, ?_⟩
  · have := congrArg List.length hz
    rw [length_gflat, PhiD, length_embed, shR_tBox, vol, List.prod_append] at this
    simp at this; omega
  · intro x hx hn
    have hlen : (decode (List.ofFn (tBox d h bL)) x).length = (List.ofFn (tBox d h bL)).length :=
      AModel.length_decode _ _
    have hval : ∀ c < 2, (PhiD h d bL sF μ xs).getD (2 * x + c) 0 = 0 := by
      intro c hc
      have e : 2 * x + c = encode (NLogN.KFU.shR d (tP d h bL)) (decode (List.ofFn (tBox d h bL)) x ++ [c]) := by
        rw [shR_tBox, encode_snoc2 _ _ hlen c, encode_decode hx]
      rw [e]
      apply PhiD_zero
      · rw [shR_tBox]
        have hv := valid_decode hx
        exact List.rel_append hv (List.Forall₂.cons hc List.Forall₂.nil)
      · intro hvS
        apply hn
        intro i
        obtain ⟨-, hlt⟩ := valid_shR_lt hvS
        have := hlt i (by omega)
        rw [decode_ofFn] at this
        simpa [fnL, NLogN.KFU.sP, List.getD_eq_getElem?_getD, List.getElem?_append_left, i.2, sBox] using this
    have h0' := hval 0 (by norm_num)
    rw [add_zero] at h0'
    rw [getD_of_gflat hz x, h0', hval 1 (by norm_num)]; rfl
  · intro k
    haveI : NeZero (∏ i, sBox d sF i) :=
      ⟨Finset.prod_ne_zero_iff.2 (fun i _ => (sBox_ne sF μ H i).out)⟩
    set κ := ((NLogN.KFM.eB sF μ H).symm k).val
    have hk : (κ : ZMod (∏ i, sBox d sF i)) = (NLogN.KFM.eB sF μ H).symm k := ZMod.natCast_zmod_val _
    have hκ : κ < OpenAI.RCRT.Ppre sF d := by rw [← Ppre_eq]; exact ZMod.val_lt _
    have hs : ∀ j < d, 1 ≤ sF j := H.pos
    rw [getD_of_gflat hz]
    have e : ∀ c, 2 * encode (List.ofFn (tBox d h bL)) (kL k) + c =
        encode (NLogN.KFU.shR d (tP d h bL)) (phiAddr d sF μ κ c) := by
      intro c; rw [encode_phiAddr h bL sF μ H, hk, AddEquiv.apply_symm_apply]
    have e0 : 2 * encode (List.ofFn (tBox d h bL)) (kL k) =
        encode (NLogN.KFU.shR d (tP d h bL)) (phiAddr d sF μ κ 0) := by
      have := e 0; rwa [add_zero] at this
