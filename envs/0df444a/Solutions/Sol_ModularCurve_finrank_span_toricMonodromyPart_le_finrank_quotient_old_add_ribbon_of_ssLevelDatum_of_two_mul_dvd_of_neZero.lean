  have hq5 : 5 ≤ q := five_le_of_dvd_sub_one (Fact.out : p.Prime) hp2 hq hq1

  obtain ⟨n₁, hcol₁, n₂, hcol₂, padj, hlat, hcommE, hcommV, hinter, hkst, hwsymE, hwsymV, hn₁, hn₂,
