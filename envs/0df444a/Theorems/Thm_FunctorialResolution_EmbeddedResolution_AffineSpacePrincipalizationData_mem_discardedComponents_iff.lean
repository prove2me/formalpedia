open FunctorialResolution.EmbeddedResolution.AffineSpacePrincipalizationData
variable {k : Type u} [Field k] [CharZero k] {Y : Scheme.{u}} [AlgebraicGeometry.IsAffine Y]
  {pY : Y ⟶ Spec (CommRingCat.of k)} [AlgebraicGeometry.LocallyOfFiniteType pY]
  (S : AffineSpacePrincipalizationData k Y pY)

theorem FunctorialResolution.EmbeddedResolution.AffineSpacePrincipalizationData.mem_discardedComponents_iff (i : ℕ) (C : Set ↥(S.strictTransform i)) :
    C ∈ S.discardedComponents i ↔
      C ∈ irreducibleComponents ↥(S.strictTransform i) ∧
        (S.strictTransformι i).base '' C ⊆ ((S.ambientCenter i).support : Set ↥(S.ambientLevel i)) := by sorry
