theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨168005376724,168225279050⟩ ⟨755621205279,755664325852⟩ ⟨77189564560,90925763327⟩ := rfl
noncomputable def centerUpper : ℝ := (173402476705 / 549755813888)
