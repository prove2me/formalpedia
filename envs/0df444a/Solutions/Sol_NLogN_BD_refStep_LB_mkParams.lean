theorem copS_getD (K dh r i : ℕ) (hi : i < K) :
    (copS K dh r).getD i 1 = 1 + copQ K r *
      (if i < dh then ((4 * K - 1) * (r / 2) - 4 * K) / (4 * K * copQ K r) - i
       else ((4 * K - 1) * r - 4 * K) / (4 * K * copQ K r) - (i - dh)) := by
  simp [copS, List.getD_eq_getElem?_getD, hi]

theorem copS_upper_aux (K Q X i : ℕ) (hX : 4 * K ≤ X) :
    4 * K * (1 + Q * ((X - 4 * K) / (4 * K * Q) - i)) ≤ X := by
  set m := (X - 4 * K) / (4 * K * Q)
  have h1 : m * (4 * K * Q) ≤ X - 4 * K := Nat.div_mul_le_self _ _
  have h2 : 4 * K * (Q * (m - i)) ≤ m * (4 * K * Q) := by
    calc 4 * K * (Q * (m - i)) ≤ 4 * K * (Q * m) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.sub_le _ _))
      _ = m * (4 * K * Q) := by ring
  rw [mul_add, mul_one]
  omega

theorem copS_upper (K dh r i : ℕ) (hK : 1 ≤ K) (hr : 4 ≤ r) (hi : i < K) :
    4 * K * (copS K dh r).getD i 1 ≤ (4 * K - 1) * (if i < dh then r / 2 else r) := by
  rw [NLogN.BD.copS_getD K dh r i hi]
  split_ifs with h
  · apply copS_upper_aux
    have : 2 ≤ r / 2 := by omega
    have : (4 * K - 1) * 2 ≤ (4 * K - 1) * (r / 2) := Nat.mul_le_mul_left _ this
    omega
  · apply copS_upper_aux
    have : (4 * K - 1) * 4 ≤ (4 * K - 1) * r := Nat.mul_le_mul_left _ hr
    omega

theorem jIter_le (p s t α K : ℕ) (hK : 1 ≤ K) (h : 4 * K * s ≤ (4 * K - 1) * t) :
    jIter p s t α ≤ 4 * K * p / α ^ 2 + 1 := by
  unfold jIter
  obtain ⟨k, rfl⟩ : ∃ k, K = k + 1 := ⟨K - 1, by omega⟩
  have e4 : 4 * (k + 1) - 1 = 4 * k + 3 := by omega
  rw [e4] at h
  set d := t - s
  set A := α ^ 2
  set Qd := 4 * (k + 1) * p / A
  rcases Nat.eq_zero_or_pos (A * d) with h0 | h0
  · rw [h0, Nat.div_zero]; exact Nat.zero_le _
  have hA : 0 < A := Nat.pos_of_mul_pos_right h0
  have hd : 0 < d := Nat.pos_of_mul_pos_left h0
  have hst : s ≤ t := by
    have : 4 * (k + 1) * s ≤ 4 * (k + 1) * t := h.trans (Nat.mul_le_mul_right _ (by omega))
    exact Nat.le_of_mul_le_mul_left this (by omega)
  have hs : s ≤ 4 * (k + 1) * d := by
    have e : 4 * (k + 1) * d + 4 * (k + 1) * s = 4 * (k + 1) * t := by
      rw [← mul_add]; congr 1; omega
    have : (4 * k + 3) * t + t = 4 * (k + 1) * t := by ring
    omega
  have hQ : 4 * (k + 1) * p < A * (Qd + 1) := Nat.lt_mul_div_succ _ hA
  have hps : p * s ≤ 4 * (k + 1) * p * d := by
    calc p * s ≤ p * (4 * (k + 1) * d) := Nat.mul_le_mul_left _ hs
      _ = 4 * (k + 1) * p * d := by ring
  have hQd : (4 * (k + 1) * p + 1) * d ≤ A * (Qd + 1) * d := Nat.mul_le_mul_right _ hQ
  have : p * s + A * d - 1 < (Qd + 2) * (A * d) := by
    have e1 : (Qd + 2) * (A * d) = A * (Qd + 1) * d + A * d := by ring
    have e2 : (4 * (k + 1) * p + 1) * d = 4 * (k + 1) * p * d + d := by ring
    omega
  have := (Nat.div_lt_iff_lt_mul h0).2 this
  omega

theorem te_pow (q : Params) (i : ℕ) (he : 1 ≤ q.e) :
    2 ^ q.te i = if i < q.dh then 2 ^ q.e / 2 else 2 ^ q.e := by
  unfold Params.te
  split_ifs
  · rw [show 2 ^ q.e = 2 * 2 ^ (q.e - 1) by rw [← pow_succ']; congr 1; omega]
    simp
  · rfl

theorem mk_s_upper (K N : ℕ) (hK : 1 ≤ K) (he : 2 ≤ (mkParams K N).e) (i : ℕ) (hi : i < K) :
    4 * K * (mkParams K N).s.getD i 1 ≤ (4 * K - 1) * 2 ^ (mkParams K N).te i := by
  rw [te_pow _ i (by omega)]
  have hr : 4 ≤ 2 ^ (mkParams K N).e :=
    le_trans (by norm_num) (Nat.pow_le_pow_right (by norm_num) he)
  exact copS_upper K _ _ i hK hr hi

theorem mk_HJ (K N : ℕ) (hK : 1 ≤ K) (he : 2 ≤ (mkParams K N).e) : HJ (mkParams K N) := by
  intro i hi
  exact jIter_le _ _ _ _ K hK (mk_s_upper K N hK he i hi)

theorem mk_S_le (K N : ℕ) (hK : 1 ≤ K) (he : 2 ≤ (mkParams K N).e) :
    (mkParams K N).S ≤ 2 ^ (K * (mkParams K N).e) := by
  set q := mkParams K N
  have hs : q.s = copS K q.dh (2 ^ q.e) := rfl
  have hle : ∀ x ∈ q.s, x ≤ 2 ^ q.e := by
    intro x hx
    rw [hs] at hx
    obtain ⟨i, hi, rfl⟩ : ∃ i, i < K ∧ (copS K q.dh (2 ^ q.e)).getD i 1 = x := by
      simp only [copS, List.mem_map, List.mem_range] at hx
      obtain ⟨i, hi, rfl⟩ := hx
      exact ⟨i, hi, by simp [copS, List.getD_eq_getElem?_getD, hi]⟩
    have h := mk_s_upper K N hK he i hi
    rw [← hs]
    have ht : 2 ^ q.te i ≤ 2 ^ q.e := Nat.pow_le_pow_right (by norm_num) (by unfold Params.te; split_ifs <;> omega)
    have : 4 * K * q.s.getD i 1 ≤ 4 * K * 2 ^ q.e :=
      h.trans (Nat.mul_le_mul (by omega) ht)
    exact Nat.le_of_mul_le_mul_left this (by omega)
  have := List.prod_le_pow_card q.s (2 ^ q.e) hle
  have hl : q.s.length = K := by rw [hs]; simp [copS]
  rw [hl, ← pow_mul, mul_comm] at this
  exact this

theorem pow_big (n : ℕ) (hn : 160 ≤ n) : 102400 * (4 * n + 26) ^ 2 ≤ 2 ^ n := by
  induction n, hn using Nat.le_induction with
  | base => norm_num
  | succ n hn ih =>
    calc 102400 * (4 * (n + 1) + 26) ^ 2 ≤ 2 * (102400 * (4 * n + 26) ^ 2) := by nlinarith
      _ ≤ 2 * 2 ^ n := by omega
      _ = 2 ^ (n + 1) := by ring

theorem Bq_le_pow (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N) :
    Bq (mkParams K N) ≤ 2 ^ ((mkParams K N).p + Xq (mkParams K N) (Nat.size (mkParams K N).b)) := by
  have h := pf_of_large K hK N hN
  have hp := h.p_eq
  have hX := h.X64
  have hB64 := h.B64
  have hEb := h.Eb
  have hbB := h.bB
  have hbig := h.b_big
  have hP := h.P_eq
  have hα2 := h.α1
  set q := mkParams K N with hq
  have qK : q.K = K := rfl
  have qα : q.α = K * (ceilSqrt (ceilSqrt q.b) + 2) := rfl
  set b := q.b
  set B := Nat.size b
  set p := q.p
  set α := q.α
  have hb1 : 1 ≤ b := by omega
  have hp5 : p ≤ 5 * b := by omega
  have hα1 : 1 ≤ α := by omega
  have hαb : α ≤ b := by
    have : α ≤ α ^ 2 := by nlinarith
    have : α ^ 2 ≤ 6 * K * α ^ 2 := Nat.le_mul_of_pos_left _ (by omega)
    omega
  -- the basic factors
  have h4 : 4 * p + 35 ≤ 2 ^ (B + 6) := by
    rw [pow_add]; norm_num; omega
  have hcS : cSq q ≤ 2 ^ (3 * B + 10) := by
    unfold cSq cS1 sWidth
    have hcs : ceilSqrt p ≤ p := NLogN.BD.ceilSqrt_le_self p
    have h1 : ceilSqrt p * α ≤ 5 * b * b := Nat.mul_le_mul (hcs.trans hp5) hαb
    have hbb : b * b < 2 ^ B * 2 ^ B := Nat.mul_lt_mul'' hbB hbB
    have h2 : 2 * (ceilSqrt p * α) + 1 ≤ 2 ^ (2 * B + 4) := by
      rw [show 2 * B + 4 = B + B + 4 by ring, pow_add, pow_add]; norm_num; nlinarith
    calc (2 * (ceilSqrt p * α) + 1) * (4 * p + 35) ≤ 2 ^ (2 * B + 4) * 2 ^ (B + 6) :=
          Nat.mul_le_mul h2 h4
      _ = 2 ^ (3 * B + 10) := by rw [← pow_add]; ring_nf
  have hcE : cE1 p α ≤ 2 ^ (2 * B + 10) := by
    unfold cE1 eWidth
    have h1 : (ceilSqrt p + α - 1) / α ≤ ceilSqrt p + α - 1 := Nat.div_le_self _ _
    have hcs : ceilSqrt p ≤ p := NLogN.BD.ceilSqrt_le_self p
    have h2 : 2 * ((ceilSqrt p + α - 1) / α + 1) + 1 ≤ 2 ^ (B + 4) := by
      rw [pow_add]; norm_num; omega
    calc (2 * ((ceilSqrt p + α - 1) / α + 1) + 1) * (4 * p + 35) ≤ 2 ^ (B + 4) * 2 ^ (B + 6) :=
          Nat.mul_le_mul h2 h4
      _ = 2 ^ (2 * B + 10) := by rw [← pow_add]; ring_nf
  set J := Jm q
  set Z := B + 6 + (2 * B + 11) * J
  have hcB : cBq q ≤ 2 ^ Z := by
    unfold cBq cB1
    have hJ : J ≤ 2 ^ J := Nat.lt_two_pow_self.le
    have hE : cE1 p α ^ J ≤ 2 ^ ((2 * B + 10) * J) := by
      rw [pow_mul]; exact Nat.pow_le_pow_left hcE J
    calc (4 * p + 35) * (J * cE1 p α ^ J) ≤ 2 ^ (B + 6) * (2 ^ J * 2 ^ ((2 * B + 10) * J)) :=
          Nat.mul_le_mul h4 (Nat.mul_le_mul hJ hE)
      _ = 2 ^ Z := by rw [← pow_add, ← pow_add]; congr 1; ring
  have hBC : BC q = 2 ^ (p + 9) := by
    unfold BC
    rw [hP, show 2 * p + q.logT + 8 = (p + q.logT) + (p + 8) by ring, pow_add,
      Nat.mul_div_cancel_left _ (by positivity), ← pow_succ']
  have hBF : BF q ≤ 2 ^ (K * Z + (p + 9)) := by
    unfold BF
    rw [hBC, qK]
    calc cBq q ^ K * 2 ^ (p + 9) ≤ (2 ^ Z) ^ K * 2 ^ (p + 9) :=
          Nat.mul_le_mul_right _ (Nat.pow_le_pow_left hcB K)
      _ = 2 ^ (K * Z + (p + 9)) := by rw [← pow_mul, ← pow_add, mul_comm Z K]
  have hBW : BW q ≤ 2 ^ (p + 19 + 2 * (K * Z)) := by
    unfold BW
    apply Nat.div_le_of_le_mul
    calc 2 * BF q * BF q ≤ 2 * 2 ^ (K * Z + (p + 9)) * 2 ^ (K * Z + (p + 9)) :=
          Nat.mul_le_mul (Nat.mul_le_mul_left _ hBF) hBF
      _ = 2 ^ p * 2 ^ (p + 19 + 2 * (K * Z)) := by
          rw [← pow_succ', ← pow_add, ← pow_add,
            show K * Z + (p + 9) + 1 + (K * Z + (p + 9)) = p + (p + 19 + 2 * (K * Z)) by ring]
  have hmax : max (2 ^ p) (BW q) ≤ 2 ^ (p + 19 + 2 * (K * Z)) :=
    max_le (Nat.pow_le_pow_right (by norm_num) (by omega)) hBW
