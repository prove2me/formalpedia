private theorem twist_by_b_eq_conj_of_liftValuedAt {a b : ℂ} {M : _root_.LanglandsTunnell.Lift48.Mat}
    (hM : M ∈ Submonoid.closure ({Slift, Tlift} : Set _root_.LanglandsTunnell.Lift48.Mat))
    (ha : a = AutomorphicForm.iotaZsqrtdNegTwo M.trace) (hb : b = AutomorphicForm.iotaZsqrtdNegTwo M.det) :
    b * a = starRingEnd ℂ a ∧ b ^ 2 * b = starRingEnd ℂ b := by
  subst ha; subst hb
  refine ⟨?_, ?_⟩
  · rw [conj_iotaZsqrtdNegTwo, star_trace_eq_trace_mul_det hM, map_mul, mul_comm]
  · rw [conj_iotaZsqrtdNegTwo, star_det_eq_det hM, ← map_pow, det_sq_eq_one hM, map_one, one_mul]

