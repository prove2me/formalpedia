  unfold _root_.InfoLossLAR.WorstCase.chiG
  simp_rw [_root_.InfoLossLAR.WorstCase.Integration.latticeGaussian_toReal_eq σ hσ]
  rw [← tsum_div_const]
  apply tsum_congr
  intro x
  change (if _root_.InfoLossLAR.WorstCase.modq q x = e then _ else _) = _
  split_ifs <;> simp
theorem chiG_sum_one (q d : ℕ) [NeZero q] (σ : ℝ) (hσ : 0 < σ) :
    ∑ e : Fin d → ZMod q, _root_.InfoLossLAR.WorstCase.chiG q d σ e = 1 := by
