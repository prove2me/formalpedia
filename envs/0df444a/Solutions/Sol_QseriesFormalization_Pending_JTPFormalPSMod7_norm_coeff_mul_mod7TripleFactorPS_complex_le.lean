      ‖P.coeff k - P.coeff (k - (r + m * N))‖
          ≤ ‖P.coeff k‖ + ‖P.coeff (k - (r + m * N))‖ := norm_sub_le _ _
      _ ≤ B + B := add_le_add (hP k) (hP (k - (r + m * N)))
      _ = 2 * B := by ring
  · rw [if_neg hle, sub_zero]
    linarith [hP k]

