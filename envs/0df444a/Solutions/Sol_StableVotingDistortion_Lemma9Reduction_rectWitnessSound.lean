section
set_option autoImplicit true
namespace StableVotingDistortion.PaperMiddle
open Set PaperBox PaperBox.Bounds
open PaperCurve (anchor deviation)
noncomputable section

private theorem coord_anchor {b : Bounds} {x : ℝ} (hx : b.Holds x) (s : Bounds) : b.Holds (anchor b s:ℝ) := by
  unfold anchor;split_ifs
  · exact ⟨hx.1.trans hx.2,le_rfl⟩
  · exact ⟨le_rfl,hx.1.trans hx.2⟩
  · exact midpoint_inside hx

private theorem coord_dev {b s : Bounds} {x m : ℝ} (hx : b.Holds x) (hm : s.Holds m) :
    m*(x-(anchor b s:ℝ)) ≤ (deviation b s:ℝ) := by
  by_cases h : 0 ≤ s.lo
  · have hn : (0:ℝ) ≤ s.lo := by exact_mod_cast h
    simpa [anchor,deviation,h] using mul_nonpos_of_nonneg_of_nonpos (hn.trans hm.1) (sub_nonpos.mpr hx.2)
  by_cases n : s.hi ≤ 0
  · have hn : (s.hi:ℝ) ≤ 0 := by exact_mod_cast n
    simpa [anchor,deviation,h,n] using mul_nonpos_of_nonpos_of_nonneg (hm.2.trans hn) (sub_nonneg.mpr hx.1)
  simpa [anchor,deviation,h,n] using centered_deviation hx hm

theorem fastCellAccept_sound {S : Bounds → Bounds} {k l : Knot} (hkl : rank k<rank l)
    (hS : ∀ {d : Bounds} {x y : ℝ},PaperCurve.lamQ ≤ d.lo → d.hi ≤ 1 → d.Holds x → d.Holds y →
      Secants PaperCurve.totalScore x y (S d)) {b c d : Bounds} {p q z : ℝ}
    (hp : b.Holds p) (hq : c.Holds q) (hz : d.Holds z)
    (hqp : q ≤ p) (hpz : p ≤ z) (base : cellReal k l p q 1 ≤ 0) (yes : fastCellAccept S k l b c d=true) :
    cellReal k l p q z ≤ 0 := by
  let s := cellP k l b c d
  let t := cellQ k l b c d
  let v := cellZ S k l b c d
  let a := anchor b s
  let j := anchor c t
  let e := anchor d v
  have H : d.hi<b.lo ∨ b.hi<c.lo ∨
    (qRank k ≤ b.lo ∧ b.hi ≤ qRank l ∧ PaperCurve.lamQ ≤ d.lo ∧ d.hi ≤ 1 ∧
      ((d.hi=1 ∧ 0 ≤ v.lo) ∨ cellPoint k l a j e+deviation b s+deviation c t+deviation d v ≤ 0)) := of_decide_eq_true yes
  rcases H with ha|ha|⟨ak,al,hl,hh,h⟩
  · have hi : (d.hi:ℝ) < b.lo := by exact_mod_cast ha
    exact (hpz.not_gt (hz.2.trans_lt (hi.trans_le hp.1))).elim
  · have hi : (b.hi:ℝ) < c.lo := by exact_mod_cast ha
    exact (hqp.not_gt (hp.2.trans_lt (hi.trans_le hq.1))).elim
  have hdom {w : ℝ} (hw : b.Holds w) : w∈Icc (rank k) (rank l) := by
    rw [← qRank_cast,← qRank_cast]
    exact ⟨(by exact_mod_cast ak : (qRank k:ℝ) ≤ b.lo).trans hw.1,
      hw.2.trans (by exact_mod_cast al : (b.hi:ℝ) ≤ qRank l)⟩
  rcases h with ⟨hd,hv⟩|top
  · have h₁ : (d.hi:ℝ)=1 := by exact_mod_cast hd
    have h₀ : d.Holds 1 := ⟨(hz.1.trans hz.2).trans_eq h₁,h₁.ge⟩
    obtain ⟨m,hm,em⟩ := cellZ_sound hkl hp hq hz h₀ (hdom hp) (hS hl hh hz h₀)
    have nn : (0:ℝ) ≤ v.lo := by exact_mod_cast hv
    have hn := mul_nonneg (nn.trans hm.1) (sub_nonneg.mpr (hz.2.trans_eq h₁))
    dsimp only at em;linarith only [base,em,hn]
  · have ha : b.Holds (a:ℝ) := coord_anchor hp _
    have hj : c.Holds (j:ℝ) := coord_anchor hq _
    have he : d.Holds (e:ℝ) := coord_anchor hz _
    obtain ⟨s₁,h₁,e₁⟩ := cellP_sound hkl ha hp hj he (hdom ha) (hdom hp)
    obtain ⟨s₂,h₂,e₂⟩ := cellQ_sound hkl hp hj hq he (hdom hp)
    obtain ⟨s₃,h₃,e₃⟩ := cellZ_sound hkl hp hq he hz (hdom hp) (hS hl hh he hz)
    have c₁ := coord_dev hp h₁
    have c₂ := coord_dev hq h₂
    have c₃ := coord_dev hz h₃
    change s₁*(p-(a:ℝ)) ≤ (deviation b s:ℝ) at c₁
    change s₂*(q-(j:ℝ)) ≤ (deviation c t:ℝ) at c₂
    change s₃*(z-(e:ℝ)) ≤ (deviation d v:ℝ) at c₃
    have hsum : (cellPoint k l a j e:ℝ)+(deviation b s:ℝ)+(deviation c t:ℝ)+(deviation d v:ℝ) ≤ 0 := by exact_mod_cast top
    rw [cellPoint_exact hkl (hdom ha)] at hsum
    dsimp only at e₁ e₂ e₃
    linarith only [e₁,e₂,e₃,c₁,c₂,c₃,hsum]

theorem cell_of_fast_tree {S : Bounds → Bounds} (k l : Knot) (hkl : rank k<rank l)
    (hm : (k,l)∈adjacentCells) (T : Cover 3)
    (hS : ∀ {d : Bounds} {x y : ℝ}, PaperCurve.lamQ ≤ d.lo → d.hi ≤ 1 → d.Holds x → d.Holds y →
      Secants PaperCurve.totalScore x y (S d))
    (ok : T.verify (fastRectTest S k l) ![⟨qRank k,qRank l⟩,⟨0,min (qRank l) PaperCurve.lamQ⟩,
      ⟨max (qRank k) PaperCurve.lamQ,1⟩]=true) : CellCovered k l := by
  intro p q z hp hq hz base
  have eq (y : ℝ) : cellReal k l p q y=physicalResidual p q y := by
    simp [cellReal,physicalResidual,penaltyLP,← entry_on_adjacent _ hm hp]
  rw [← eq]; rw [← eq] at base
  apply cover_sound (P:=fun t => t 1 ≤ t 0 → t 0 ≤ t 2 → cellReal k l (t 0) (t 1) 1 ≤ 0 →
    cellReal k l (t 0) (t 1) (t 2) ≤ 0) (ok:=fastRectTest S k l)
    (fun _ y _ hi h₁ h₂ hb => fastCellAccept_sound hkl hS (hi 0) (hi 1) (hi 2) h₁ h₂ hb y)
    T _ ok ![p,q,z] _ (hq.2.trans (min_le_left _ _)) ((le_max_left _ _).trans hz.1) base
  intro i
  fin_cases i
  · simpa [Holds,qRank_cast] using hp
  · change (⟨0,min (qRank l) PaperCurve.lamQ⟩:Bounds).Holds q
    simp only [Holds,Rat.cast_zero,Rat.cast_min,qRank_cast]
    exact ⟨hq.1,hq.2.trans (min_le_min_right _ hp.2)⟩
  · change (⟨max (qRank k) PaperCurve.lamQ,1⟩:Bounds).Holds z
    simp only [Holds,Rat.cast_max,Rat.cast_one,qRank_cast]
    exact ⟨(max_le_max_right _ hp.1).trans hz.1,hz.2⟩

end
end StableVotingDistortion.PaperMiddle
end

section
set_option autoImplicit true
namespace StableVotingDistortion.PaperEndpoint
open Set PaperCurve
noncomputable section

/-- Slopes of a local quadratic, evaluated in rational arithmetic at the endpoints. -/
def startSlope (r : Piece) : ℚ := r.c 1
def endSlope (r : Piece) : ℚ := r.c 1+2*r.c 2*(r.hi-r.lo)
def tailRow (r : Piece) : Prop := r.c 3=0 ∧ r.c 4=0 ∧ r.c 5=0 ∧ r.c 6=0 ∧ r.c 2 ≤ 0
instance (r : Piece) : Decidable (tailRow r) := inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _))

/-- Decreasing one-sided derivatives from each post-λ row to its successor. -/
def descendingFrom (start : ℚ) : List Piece → Prop
  | [] => True
  | r::rs => startSlope r ≤ start ∧ tailRow r ∧ descendingFrom (endSlope r) rs
instance descendingFrom_decidable (start : ℚ) (ps : List Piece) : Decidable (descendingFrom start ps) := by
  induction ps generalizing start with
  | nil => exact isTrue trivial
  | cons r rs ih => letI := ih (endSlope r);exact inferInstanceAs (Decidable (_ ∧ _ ∧ _))

private theorem row_slope {r : Piece} (ht : tailRow r) (x : ℝ) :
    r.slope x=(r.c 1:ℝ)+2*(r.c 2:ℝ)*(x-r.lo) := by
  obtain ⟨a,b,c,d,_⟩ := ht
  simp [Piece.slope,Piece.slopeCoeffs,horner,a,b,c,d];ring

private theorem row_antitone {r : Piece} (ht : tailRow r) : Antitone r.slope := by
  intro x y hxy
  rw [row_slope ht,row_slope ht]
  have hc : (r.c 2:ℝ) ≤ 0 := by exact_mod_cast ht.2.2.2.2
  nlinarith only [mul_nonpos_of_nonneg_of_nonpos (sub_nonneg.mpr hxy) hc]

private theorem row_start {r : Piece} (h : tailRow r) : r.slope r.lo=(startSlope r:ℝ) := by
  rw [row_slope h];simp [startSlope]
private theorem row_end {r : Piece} (h : tailRow r) : r.slope r.hi=(endSlope r:ℝ) := by
  rw [row_slope h];push_cast [endSlope];ring

private theorem row_after {ps : List Piece} {a b : Knot} (hc : Chain a ps b) {r : Piece} (hr : r∈ps) : a.x ≤ r.lo := by
  induction ps generalizing a with
  | nil => cases hr
  | cons p ps ih =>
    obtain ⟨rfl,hh,ch⟩ := hc
    obtain he|he := List.mem_cons.mp hr
    · subst r;exact le_rfl
    · exact hh.le.trans (ih ch he)

private theorem all_below {ps : List Piece} {a b : Knot} (hc : Chain a ps b) {k : ℚ}
    (hd : descendingFrom k ps) {r : Piece} (hr : r∈ps) {x : ℝ} (hx : x ∈ Icc (r.lo:ℝ) r.hi) :
    r.slope x ≤ (k:ℝ) := by
  induction ps generalizing a k with
  | nil => cases hr
  | cons p ps ih =>
    obtain ⟨_,hw,ch⟩ := hc
    obtain ⟨h₀,hp,h₁⟩ := hd
    have hstart : p.slope p.lo ≤ k := by rw [row_start hp];exact_mod_cast h₀
    obtain he|he := List.mem_cons.mp hr
    · subst r;exact ((row_antitone hp) hx.1).trans hstart
    · have ht := ih ch h₁ he
      have hw' : (p.lo:ℝ) ≤ p.hi := by exact_mod_cast hw.le
      exact ht.trans (by rw [← row_end hp];exact ((row_antitone hp) hw').trans hstart)

/-- The proof uses adjacent-row checks, so the certificate size is linear in the
number of local pieces, including the possible jump of each derivative. -/
theorem descending_slopes {ps : List Piece} {a b : Knot} (hc : Chain a ps b) {k : ℚ}
    (hd : descendingFrom k ps) {r s : Piece} (hr : r∈ps) (hs : s∈ps) {x y : ℝ}
    (hx : x ∈ Icc (r.lo:ℝ) r.hi) (hy : y ∈ Icc (s.lo:ℝ) s.hi) (hxy : x<y) : s.slope y ≤ r.slope x := by
  induction ps generalizing a k with
  | nil => cases hr
  | cons p ps ih =>
    obtain ⟨_,hw,ch⟩ := hc
    obtain ⟨h₀,hp,h₁⟩ := hd
    rcases List.mem_cons.mp hr with hr|hr <;> rcases List.mem_cons.mp hs with hs|hs
    · subst r;subst s;exact row_antitone hp hxy.le
    · subst r;have ht := all_below ch h₁ hs hy
      rw [← row_end hp] at ht
      exact ht.trans (row_antitone hp hx.2)
    · subst s;have hl := row_after ch hr
      have hl' : (p.hi:ℝ) ≤ r.lo := by exact_mod_cast hl
      exact (hxy.not_ge ((hy.2.trans hl').trans hx.1)).elim
    · exact ih ch h₁ hr hs

/-- The prefix rows either lie entirely before λ, or start the decreasing slope chain.
The prefix can be discarded when checking concavity on [λ,1]. -/
def slopeChain (start : ℚ) : List Piece → Prop
  | [] => True
  | p::ps => if p.hi ≤ lamQ then slopeChain start ps else descendingFrom start (p::ps)
instance slopeChain_decidable (k : ℚ) (ps : List Piece) : Decidable (slopeChain k ps) := by
  induction ps with
  | nil => exact isTrue trivial
  | cons r rs ih => unfold slopeChain;split <;> infer_instance

theorem post_slopes {ps : List Piece} {a b : Knot} (hc : Chain a ps b) {k : ℚ}
    (hd : slopeChain k ps) {r s : Piece} (hr : r∈ps) (hs : s∈ps) {x y : ℝ}
    (hx : x ∈ Icc (r.lo:ℝ) r.hi) (hy : y ∈ Icc (s.lo:ℝ) s.hi) (hl : lam<x) (hxy : x<y) : s.slope y ≤ r.slope x := by
  induction ps generalizing a with
  | nil => cases hr
  | cons p ps ih =>
    unfold slopeChain at hd
    split at hd
    · rename_i h
      rcases hc with ⟨_,_,ch⟩
      have he : (p.hi:ℝ) ≤ lam := by unfold lam;exact_mod_cast h
      rcases List.mem_cons.mp hr with hr|hr
      · subst r;exact (hl.not_ge (hx.2.trans he)).elim
      rcases List.mem_cons.mp hs with hs|hs
      · subst s;exact ((hl.trans hxy).not_ge (hy.2.trans he)).elim
      · exact ih ch hd hr hs
    · exact descending_slopes hc hd hr hs hx hy hxy

end
end StableVotingDistortion.PaperEndpoint
end

