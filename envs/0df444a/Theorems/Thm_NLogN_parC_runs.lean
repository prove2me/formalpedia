theorem NLogN.parC_runs (pP : Fin P) (hP : iprog pP = pow2Body pP) (s : IState NS) (N M k : ℕ)
    (L1 L2 LL : List Item) (hM : M ≤ N) (hk : k ≤ N)
    (hQ : (2 * M + 2 * k + 3) / 2 ^ k + 1 ≤ N)
    (hT1 : s.G T1 = .int k :: L1) (hT2 : s.G T2 = .int M :: L2)
    (hDL : s.G DL = .int (2 ^ k) :: LL) :
    IRuns I iprog (NLogN.parC pP) s
      ((((s.upd T2 (.int ((2 * M + 2 * k + 3) / 2 ^ k + 1 : ℕ) :: L2)).upd NLogN.T3
        (.int (((2 * M + 2 * k + 3) / 2 ^ k + 1) * 2 ^ k : ℕ) :: s.G NLogN.T3)).upd RQ
          (.int (2 ^ ((2 * M + 2 * k + 3) / 2 ^ k + 1)) :: s.G RQ)).upd NLogN.DE
            (.int (2 ^ (2 * ((2 * M + 2 * k + 3) / 2 ^ k + 1))) :: s.G NLogN.DE))
      (70000 * (N + 3)) := by sorry
