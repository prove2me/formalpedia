-- title:
--   §1–§2, pp. 410–415 — Assumptions 1–4, the stacked notation, ρ_w, the DSGT recursion (4) and the noise σ-algebras F_k
-- statement:
--   This file sets up the distributed stochastic gradient tracking (DSGT) model of Pu and Nedić.
--
--   A network of $n$ agents minimizes $f(x)=\frac1n\sum_{i=1}^n f_i(x)$ over $x\in\mathbb R^p$ (problem (1)). Agent $i$ holds a local copy $x_i\in\mathbb R^p$ and a tracker $y_i\in\mathbb R^p$; stacked, $\mathbf x=[x_1,\dots,x_n]^\top\in\mathbb R^{n\times p}$. The following objects are defined.
--
--   1. **Stacked notation.** The average $\bar x=\frac1n\mathbf 1^\top\mathbf x=\frac1n\sum_i x_i$; the squared Frobenius norm $\|\mathbf x\|^2=\sum_i\|x_i\|^2$; the consensus error $\|\mathbf x-\mathbf 1\bar x\|^2=\sum_i\|x_i-\bar x\|^2$; the mixing $(\mathbf W\mathbf x)_i=\sum_j w_{ij}x_j$; the Frobenius inner product; the Frobenius norm $\|\mathbf M\|=\big(\sum_{i,j}M_{ij}^2\big)^{1/2}$ of an $n\times n$ matrix; $\nabla f(x)=\frac1n\sum_i\nabla f_i(x)$ and $h(\mathbf x)=\frac1n\sum_i\nabla f_i(x_i)$.
--   2. **$\rho_w$**, the spectral norm of $\mathbf W-\frac1n\mathbf 1\mathbf 1^\top$.
--   3. **Assumption 1** (stochastic oracle). Samples $\xi_{i,k}\in\mathbb R^d$ (agent $i$, time $k$) are measurable and mutually independent over all pairs $(i,k)$; $g_i:\mathbb R^p\times\mathbb R^d\to\mathbb R^p$ is jointly measurable; for every $k$, $i$ and fixed $x$,
--   $$\mathbb E[g_i(x,\xi_{i,k})]=\nabla f_i(x),\qquad \mathbb E\big[\|g_i(x,\xi_{i,k})-\nabla f_i(x)\|^2\big]\le\sigma^2,\quad\sigma>0,$$
--   with both integrands integrable.
--   4. **Assumption 2.** Each $f_i$ has gradient $\nabla f_i$, is $\mu$-strongly convex ($\langle\nabla f_i(x)-\nabla f_i(x'),x-x'\rangle\ge\mu\|x-x'\|^2$, $\mu>0$) and has $L$-Lipschitz gradient; $p\ge1$.
--   5. **Assumptions 3–4.** $\mathbf W$ is nonnegative and doubly stochastic ($\mathbf W\mathbf 1=\mathbf 1$, $\mathbf 1^\top\mathbf W=\mathbf 1^\top$), $w_{ii}>0$ for some $i$, $w_{ij}>0\Rightarrow w_{ji}>0$, and the graph joining $i\ne j$ when $w_{ij}>0$ is connected.
--   6. **$x^*$** is a minimizer of $f$.
--   7. **DSGT (4)** with stepsizes $\alpha_k$: $x_{i,0}$ is a deterministic starting point, $y_{i,0}=g_i(x_{i,0},\xi_{i,0})$, and
--   $$x_{i,k+1}=\sum_j w_{ij}(x_{j,k}-\alpha_k y_{j,k}),\qquad y_{i,k+1}=\sum_j w_{ij}y_{j,k}+g_i(x_{i,k+1},\xi_{i,k+1})-g_i(x_{i,k},\xi_{i,k}).$$
--   8. **$\mathcal F_k$**, the σ-algebra generated by $\xi_0,\dots,\xi_{k-1}$, where $\xi_j=(\xi_{1,j},\dots,\xi_{n,j})$.
--
--   These objects are shared by every statement of the mission.
--
--   **Formalization Note** The paper's noise space $\mathbb R^m$ is written $\mathbb R^d$, because $m$ also names the stepsize offset in $\alpha_k=\theta/(m+k)$. The paper's "each random vector $\xi_i$ is independent" is read as mutual independence of all $\xi_{i,k}$; its conditioning "$\mid x$" on a deterministic $x$ becomes the unconditional statement for each fixed $x$. Joint measurability of $g_i$ and $p\ge1$ are technical additions (without $p\ge1$, $\mathbb R^0$ satisfies Assumption 2 for any $\mu>L$). $\rho_w$ is the operator norm of `Matrix.toEuclideanCLM`. Uniqueness of $x^*$ is a consequence of Assumption 2 and is not assumed.
-- source:
--   Pu & Nedić, Math. Program. 187 (2021), (1) and Assumption 1, p. 410; §1.3 and Assumptions 2–3, pp. 413–414; (4), (5), Assumption 4 and Lemma 1 (definition of ρ_w), pp. 414–415; §3, p. 419 (F_k)

import Mathlib

namespace StochGradTrack.Dimin

open MeasureTheory ProbabilityTheory

/-- The decision space `ℝᵖ` (rows of `ℝ^{1×p}` such as `x*` and `x̄` are also `E p`). -/
abbrev E (p : ℕ) := EuclideanSpace ℝ (Fin p)

/-- Squared Frobenius norm `‖x‖²` of a stacked variable `x ∈ ℝ^{n×p}` (row `i` is agent `i`).
The Pi norm on `Fin n → E p` is the sup norm, so it is never used. -/
noncomputable def frobSq {n p : ℕ} (x : Fin n → E p) : ℝ := ∑ i, ‖x i‖ ^ 2

/-- The average `x̄ = (1/n) 1ᵀ x`. -/
noncomputable def avg {n p : ℕ} (x : Fin n → E p) : E p := (n : ℝ)⁻¹ • ∑ i, x i

/-- The consensus error `‖x − 1 x̄‖² = Σᵢ ‖xᵢ − x̄‖²`. -/
noncomputable def consErr {n p : ℕ} (x : Fin n → E p) : ℝ := ∑ i, ‖x i - avg x‖ ^ 2

/-- Mixing `W x`: row `i` is `Σⱼ wᵢⱼ xⱼ`. -/
noncomputable def mix {n p : ℕ} (W : Matrix (Fin n) (Fin n) ℝ) (x : Fin n → E p) : Fin n → E p :=
  fun i => ∑ j, W i j • x j

/-- Frobenius inner product `⟨x, y⟩ = Σᵢ ⟨xᵢ, yᵢ⟩`. -/
noncomputable def frobInner {n p : ℕ} (x y : Fin n → E p) : ℝ := ∑ i, inner ℝ (x i) (y i)

/-- Frobenius norm of an `n × n` matrix, used for `‖W − I‖`. -/
noncomputable def frobNorm {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  Real.sqrt (∑ i, ∑ j, M i j ^ 2)

/-- `ρ_w`: the spectral norm (operator norm on Euclidean space) of `W − (1/n) 1 1ᵀ`. -/
noncomputable def rhoW {n : ℕ} (W : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  ‖Matrix.toEuclideanCLM (n := Fin n) (𝕜 := ℝ) (W - (n : ℝ)⁻¹ • Matrix.of (fun _ _ => (1 : ℝ)))‖

/-- The gradient `∇f(x) = (1/n) Σᵢ ∇fᵢ(x)` of the average objective. -/
noncomputable def gradAvg {n p : ℕ} (gradf : Fin n → E p → E p) (x : E p) : E p :=
  (n : ℝ)⁻¹ • ∑ i, gradf i x

/-- `h(x) = (1/n) 1ᵀ ∇F(x) = (1/n) Σᵢ ∇fᵢ(xᵢ)` for a stacked `x`. -/
noncomputable def hAgg {n p : ℕ} (gradf : Fin n → E p → E p) (x : Fin n → E p) : E p :=
  (n : ℝ)⁻¹ • ∑ i, gradf i (x i)

/-- Assumption 1 (stochastic oracle). `ξ k i` is the sample `ξ_{i,k}` of agent `i` at time `k`, valued in
`ℝ^d` (the paper's `ℝ^m`; renamed because `m` is the stepsize offset). All samples are mutually independent
over agents and times; `gᵢ` is jointly measurable; for every fixed `x`, `gᵢ(x, ξ_{i,k})` is unbiased for
`∇fᵢ(x)` with variance at most `σ²`. -/
structure Assumption1 {n p d : ℕ} {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (gradf : Fin n → E p → E p) (g : Fin n → E p → E d → E p) (ξ : ℕ → Fin n → Ω → E d) (σ : ℝ) :
    Prop where
  sigma_pos : 0 < σ
  meas_xi : ∀ k i, Measurable (ξ k i)
  indep : iIndepFun (fun q : ℕ × Fin n => ξ q.1 q.2) P
  meas_g : ∀ i, Measurable (Function.uncurry (g i))
  unbiased : ∀ k i x, Integrable (fun ω => g i x (ξ k i ω)) P ∧ ∫ ω, g i x (ξ k i ω) ∂P = gradf i x
  variance : ∀ k i x, Integrable (fun ω => ‖g i x (ξ k i ω) - gradf i x‖ ^ 2) P ∧
    ∫ ω, ‖g i x (ξ k i ω) - gradf i x‖ ^ 2 ∂P ≤ σ ^ 2

/-- Assumption 2: each `fᵢ` is differentiable with gradient `gradf i`, `μ`-strongly convex (in the
monotone-gradient form) with `L`-Lipschitz gradient; `p ≥ 1`. -/
structure Assumption2 {n p : ℕ} (f : Fin n → E p → ℝ) (gradf : Fin n → E p → E p) (μ L : ℝ) : Prop where
  dim_pos : 0 < p
  hasGrad : ∀ i x, HasGradientAt (f i) (gradf i x) x
  mu_pos : 0 < μ
  strong : ∀ i x x', μ * ‖x - x'‖ ^ 2 ≤ inner ℝ (gradf i x - gradf i x') (x - x')
  lipschitz : ∀ i x x', ‖gradf i x - gradf i x'‖ ≤ L * ‖x - x'‖

/-- Assumptions 3–4: `W` is nonnegative and doubly stochastic with some positive diagonal entry; its support
is symmetric (undirected graph) and the graph with edges `{i, j}`, `i ≠ j`, `wᵢⱼ > 0` is connected. -/
structure Assumption34 {n : ℕ} (W : Matrix (Fin n) (Fin n) ℝ) : Prop where
  nonneg : ∀ i j, 0 ≤ W i j
  row_sum : ∀ i, ∑ j, W i j = 1
  col_sum : ∀ j, ∑ i, W i j = 1
  diag_pos : ∃ i, 0 < W i i
  symm_support : ∀ i j, 0 < W i j → 0 < W j i
  connected : (SimpleGraph.fromRel (fun i j : Fin n => 0 < W i j)).Connected

/-- `x*` minimizes `f = (1/n) Σᵢ fᵢ` (problem (1)). -/
def IsMinimizer {n p : ℕ} (f : Fin n → E p → ℝ) (xstar : E p) : Prop :=
  ∀ x, (∑ i, f i xstar) / n ≤ (∑ i, f i x) / n

/-- The DSGT recursion (4) for a stepsize sequence `α`, started at a deterministic `x0` with
`y_{i,0} = gᵢ(x_{i,0}, ξ_{i,0})`. The value at `k` is the pair `(x_k, y_k)`. -/
noncomputable def dsgt {n p d : ℕ} {Ω : Type*} (α : ℕ → ℝ) (W : Matrix (Fin n) (Fin n) ℝ)
    (g : Fin n → E p → E d → E p) (ξ : ℕ → Fin n → Ω → E d) (x0 : Fin n → E p) :
    ℕ → Ω → (Fin n → E p) × (Fin n → E p)
  | 0, ω => (x0, fun i => g i (x0 i) (ξ 0 i ω))
  | k + 1, ω =>
    let x := (dsgt α W g ξ x0 k ω).1
    let y := (dsgt α W g ξ x0 k ω).2
    let x' := mix W (fun i => x i - α k • y i)
    (x', fun i => mix W y i + (g i (x' i) (ξ (k + 1) i ω) - g i (x i) (ξ k i ω)))

/-- The iterates `x_k`. -/
noncomputable def xs {n p d : ℕ} {Ω : Type*} (α : ℕ → ℝ) (W : Matrix (Fin n) (Fin n) ℝ)
    (g : Fin n → E p → E d → E p) (ξ : ℕ → Fin n → Ω → E d) (x0 : Fin n → E p) (k : ℕ) (ω : Ω) :
    Fin n → E p :=
  (dsgt α W g ξ x0 k ω).1

/-- The trackers `y_k`. -/
noncomputable def ys {n p d : ℕ} {Ω : Type*} (α : ℕ → ℝ) (W : Matrix (Fin n) (Fin n) ℝ)
    (g : Fin n → E p → E d → E p) (ξ : ℕ → Fin n → Ω → E d) (x0 : Fin n → E p) (k : ℕ) (ω : Ω) :
    Fin n → E p :=
  (dsgt α W g ξ x0 k ω).2

set_option warn.classDefReducibility false in
/-- `F_k = σ(ξ₀, …, ξ_{k−1})` with `ξ_j = (ξ_{1,j}, …, ξ_{n,j})`; `F₀` is trivial. -/
noncomputable def noiseSigma {n d : ℕ} {Ω : Type*} (ξ : ℕ → Fin n → Ω → E d) (k : ℕ) :
    MeasurableSpace Ω :=
  ⨆ j, ⨆ (_ : j < k), MeasurableSpace.comap (fun ω i => ξ j i ω) inferInstance

end StochGradTrack.Dimin


