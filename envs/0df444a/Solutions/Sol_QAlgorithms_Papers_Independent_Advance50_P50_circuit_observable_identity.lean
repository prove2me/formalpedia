      ((y 0 == if (0 : Fin 3) = t then xor (x t) (x c) else x 0) &&
      (y 1 == if (1 : Fin 3) = t then xor (x t) (x c) else x 1) &&
      (y 2 == if (2 : Fin 3) = t then xor (x t) (x c) else x 2)) = true := by
    simp only [funext_iff, Fin.forall_fin_succ, Fin.forall_fin_zero_pi, Function.update_apply,
      Bool.and_eq_true, beq_iff_eq]
    simp [Fin.forall_fin_succ, and_assoc]
