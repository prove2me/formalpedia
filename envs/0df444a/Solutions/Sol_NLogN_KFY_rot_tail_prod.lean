theorem solution {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) (k : ℕ) (hk : k < IntMul.OpenAI.Glue.dP n) :
    ((List.ofFn (NLogN.KFM.tB n)).rotate k).tail.prod = 2 ^ (IntMul.OpenAI.Glue.LP n - (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k)) := by
  have hl : k < (List.ofFn (NLogN.KFM.tB n)).length := by simpa using hk
  have hp := NLogN.KFY.prod_tB hn
  have hr : ((List.ofFn (NLogN.KFM.tB n)).rotate k).prod = 2 ^ IntMul.OpenAI.Glue.LP n := by
    rw [(List.rotate_perm _ _).prod_eq, hp]
  have hc := NLogN.KFY.rotate_head_cons _ k hl
  rw [hc, List.prod_cons] at hr
  simp only [List.getElem_ofFn] at hr
  rw [NLogN.KFY.tB_eq hn k hk] at hr
  change 2 ^ (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k) * _ = _ at hr
  have hdvd : 2 ^ (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k) ∣ 2 ^ IntMul.OpenAI.Glue.LP n := ⟨_, hr.symm⟩
  have hle := (Nat.pow_dvd_pow_iff_le_right (by norm_num : 1 < 2)).1 hdvd
  have e : 2 ^ IntMul.OpenAI.Glue.LP n = 2 ^ (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k) * 2 ^ (IntMul.OpenAI.Glue.LP n - (IntMul.OpenAI.Glue.ℓP n - 1 + NLogN.KFY.bN n k)) := by
    rw [← pow_add]; congr 1; omega
  rw [e] at hr
  exact (Nat.eq_of_mul_eq_mul_left (by positivity) hr)
end
