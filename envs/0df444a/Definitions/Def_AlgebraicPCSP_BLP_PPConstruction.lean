-- title:
--   Templates over possibly infinite domains and pp-constructibility (Definition 4.9, with Definitions 2.23, 4.6, 4.7)
-- statement:
--   **pp-formulas (Definition 2.23).** A primitive positive formula over a signature is an existentially quantified conjunction of atoms $(v_{j_1},\dots,v_{j_k})\in R$ and equalities $v_{j_1}=v_{j_2}$, with finitely many quantified variables, atoms and equalities. For a structure $\mathbf A$, $\Psi^{\mathbf A}(\mathbf a)$ means that the formula holds in $\mathbf A$ at the assignment $\mathbf a$ of its free variables.
--
--   **pp-powers (Definition 4.7).** A PCSP template $(\mathbf A',\mathbf B')$ is an $n$-th *pp-power* of $(\mathbf A,\mathbf B)$ if $A'=A^n$, $B'=B^n$ and, viewing $k$-ary relations on $A^n$ and $B^n$ as $kn$-ary relations on $A$ and $B$, each relation $R$ of the new signature is defined by **one** pp-formula $\Psi_R$ over $(\mathbf A,\mathbf B)$:
--   $$R^{\mathbf A'}=\{\mathbf t\mid \Psi_R^{\mathbf A}(\mathbf t)\},\qquad R^{\mathbf B'}=\{\mathbf t\mid \Psi_R^{\mathbf B}(\mathbf t)\}.$$
--
--   **Homomorphic relaxations (Definition 4.6).** For similar templates, $(\mathbf A',\mathbf B')$ is a relaxation of $(\mathbf A,\mathbf B)$ if there are homomorphisms $h_A:\mathbf A'\to\mathbf A$ and $h_B:\mathbf B\to\mathbf B'$.
--
--   **pp-constructibility (Definition 4.9).** $(\mathbf A',\mathbf B')$ is pp-constructible from $(\mathbf A,\mathbf B)$ if there is a finite sequence $(\mathbf A,\mathbf B)=(\mathbf A_1,\mathbf B_1),\dots,(\mathbf A_k,\mathbf B_k)=(\mathbf A',\mathbf B')$ of templates in which each $(\mathbf A_{i+1},\mathbf B_{i+1})$ is a pp-power or a homomorphic relaxation of $(\mathbf A_i,\mathbf B_i)$. "pp-constructible from $\mathbf D$" means pp-constructible from $(\mathbf D,\mathbf D)$.
--
--   Theorem 7.9(4) applies these notions to sequences that start at a finite reduct of $\mathbf Q_{\mathrm{conv}}$, so the domains in a sequence may be infinite.
--
--   **Formalization Note** pp-formulas, pp-powers and homomorphic relaxations are the shared definitions `AlgebraicPCSP.Theory.PPFormula`, `IsPPPower` and `IsRelaxation`, which carry no finiteness of domains; the signature of a pp-formula may be infinite (as for $\mathbf Q_{\mathrm{conv}}$). This item defines only the bundled `Template` and `PPConstructible`, because the shared `Template` requires finite nonempty domains. The free variables of a pp-power's defining formula are indexed by $[k]\times[n]$. A `Template` bundles a finite signature with arities $\ge 1$, two domains (with no finiteness requirement) and the two structures; `PPConstructible` is the inductive closure under appending a pp-power or a relaxation, and a relaxation step requires the new pair to be a PCSP template. The exponent $n=0$ is not excluded (the paper does not exclude it).
-- source:
--   L. Barto, J. Bulín, A. Krokhin, J. Opršal, Algebraic approach to promise constraint satisfaction, arXiv:1811.00970v3, pp. 14, 25–26, Definitions 2.23, 2.24(1), 4.6, 4.7, 4.9

import Mathlib
import Definitions.Def_PCSPBLPAff_Symmetric_Setting
import Definitions.Def_AlgebraicPCSP_Theory_PPConstruction

namespace AlgebraicPCSP.BLP

open PCSPBLPAff.Symmetric

/-- A pair `(𝔸, 𝔹)` of similar structures, bundled with its signature and domains so that a
sequence of pairs may change them (Definition 4.9, p. 26). The signature is finite and all
arities are `≥ 1` (Definition 2.2, p. 8). The domains may be **infinite**: the sequences of
Theorem 7.9(4) start at a finite reduct of `Q_conv`, whose domain is `ℚ`. -/
structure Template : Type 1 where
  /-- The signature (relation symbols). -/
  τ : Type
  /-- The arities. -/
  ar : τ → ℕ
  /-- The domain of `𝔸`. -/
  A : Type
  /-- The domain of `𝔹`. -/
  B : Type
  [finτ : Finite τ]
  ar_pos : ∀ R, 0 < ar R
  /-- The first structure. -/
  𝔸 : RelStruct τ ar A
  /-- The second structure. -/
  𝔹 : RelStruct τ ar B

attribute [instance] Template.finτ

/-- Bundle a pair of similar structures over a finite signature with positive arities as a
`Template`. -/
def Template.of {τ : Type} [Finite τ] {ar : τ → ℕ} {A B : Type} (𝔸 : RelStruct τ ar A)
    (𝔹 : RelStruct τ ar B) (har : ∀ R, 0 < ar R) : Template :=
  { τ := τ, ar := ar, A := A, B := B, ar_pos := har, 𝔸 := 𝔸, 𝔹 := 𝔹 }

/-- `T'` is pp-constructible from `T` (Definition 4.9, p. 26): there is a finite sequence
`T = T₁, …, T_k = T'` of templates in which each `T_{i+1}` is a pp-power of `T_i`
(Definition 4.7) or a homomorphic relaxation of `T_i` (Definition 4.6). The reflexive-transitive
closure is generated by appending one step at the end. A relaxation step requires the new pair
to be a PCSP template (`A'' → B''`), as Definition 4.6 assumes; a pp-power of a PCSP template is
one automatically. Domains are not required to be finite. -/
inductive PPConstructible (T : Template) : Template → Prop
  /-- The one-element sequence. -/
  | refl : PPConstructible T T
  /-- Append an `n`-th pp-power of the last template. -/
  | power {T' : Template} (hT' : PPConstructible T T') (n : ℕ) (τ'' : Type) [Finite τ'']
      (ar'' : τ'' → ℕ) (har'' : ∀ R, 0 < ar'' R)
      (𝔸'' : RelStruct τ'' ar'' (Fin n → T'.A)) (𝔹'' : RelStruct τ'' ar'' (Fin n → T'.B))
      (hpow : @AlgebraicPCSP.Theory.IsPPPower T'.τ τ'' T'.ar ar'' T'.A T'.B n T'.𝔸 T'.𝔹 𝔸'' 𝔹'') :
      PPConstructible T
        (Template.of (A := Fin n → T'.A) (B := Fin n → T'.B) 𝔸'' 𝔹'' har'')
  /-- Append a homomorphic relaxation `(𝔸'', 𝔹'')` of the last template. -/
  | relax {T' : Template} (hT' : PPConstructible T T') (A'' B'' : Type)
      (𝔸'' : RelStruct T'.τ T'.ar A'') (𝔹'' : RelStruct T'.τ T'.ar B'')
      (htemp : IsPromiseTemplate 𝔸'' 𝔹'') (hrel : AlgebraicPCSP.Theory.IsRelaxation T'.𝔸 T'.𝔹 𝔸'' 𝔹'') :
      PPConstructible T (Template.of 𝔸'' 𝔹'' T'.ar_pos)

end AlgebraicPCSP.BLP


