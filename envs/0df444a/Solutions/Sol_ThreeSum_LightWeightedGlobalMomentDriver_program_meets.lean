theorem _root_.solution {originalB nB originalC nC leftWeight rightWeight matrix count out terms : ℕ} {backend : List ℤ}
    (xl yl zl xr yr zr : List ℤ) (steps : List (ℕ × ℕ)) (cost : (ℕ × ℕ) → ℕ) (score : ℕ → ℕ → ℕ → ℤ) (μ : ℕ → ℤ)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d < lim.depth) (hwindow : matrix + terms * count ≤ leftWeight)
    (hspace : leftWeight ≤ lim.space) (htermsWord : (terms : ℤ) ≤ lim.word)
    (hstep :
      ∀ i < steps.length,
        ∀ ν,
          TernaryMomentMatrixInvariant.Holds μ matrix count terms leftWeight (steps.take i) score ν →
            Meets lim
              (LightWeightedGlobalMomentSourceProgram.program xl yl zl xr yr zr (steps.getD i (0, 0)).1
                (steps.getD i (0, 0)).2)
              138 (d + 1)
              (LightTernaryMomentChannelStep.args originalB nB originalC nC leftWeight rightWeight matrix count out
                backend)
              ν (cost (steps.getD i (0, 0)))
              (fun _ ξ =>
                TernaryMomentMatrixInvariant.Holds μ matrix count terms leftWeight (steps.take (i + 1)) score ξ)) :
    Meets lim (program xl yl zl xr yr zr steps terms (9 + backend.length)) (139 * steps.length + 1) d
      (LightTernaryMomentChannelStep.args originalB nB originalC nC leftWeight rightWeight matrix count out backend) μ
      (time steps cost terms count (9 + backend.length))
      (fun _ ν => TernaryMomentMatrixInvariant.Holds μ matrix count terms leftWeight steps score ν) :=
  by
  let vals :=
    LightTernaryMomentChannelStep.args originalB nB originalC nC leftWeight rightWeight matrix count out backend
  have hlen : vals.length = 9 + backend.length := by simp [vals, LightTernaryMomentChannelStep.args]; omega
  have hmain :
    (program xl yl zl xr yr zr steps terms (9 + backend.length))[139 * steps.length + 1]? =
      some (body steps terms (9 + backend.length)) :=
    by
    unfold program
    rw [List.getElem?_append_right (by simp), library_length]
    have he : 139 * steps.length + 1 - 139 * steps.length = 1 := by omega
    rw [he]
    rfl
  have hfill : (program xl yl zl xr yr zr steps terms (9 + backend.length))[139 * steps.length]? = some fillBody :=
    by
    unfold program
    rw [List.getElem?_append_right (by simp), library_length, Nat.sub_self]
    rfl
  have hmulWord : (terms : ℤ) * (count : ℤ) ≤ lim.word :=
    by
    have hh : terms * count ≤ lim.space := by omega
    have hz : (terms : ℤ) * (count : ℤ) ≤ (lim.space : ℤ) := by exact_mod_cast hh
    exact hz.trans hw
  have hcountWord : (count : ℤ) ≤ lim.word ∨ terms = 0 :=
    by
    by_cases ht : 0 < terms
    · left
      have hm : count ≤ terms * count := by nlinarith
      exact (Int.ofNat_le.mpr (show count ≤ lim.space by omega)).trans hw
    ·
      exact
        Or.inr
          (by omega)
            -- Variable reads themselves are safe; multiplication is charged and bounded.
            
  apply Meets.of_body hmain
  unfold body time
  refine
    Ends.callThen (LightTernaryMomentAccumulate.zero_meets hfill μ hw (hwindow.trans hspace)) ?_ (ha := by
      ( (try have := _root_.Light.Std.space_le (by assumption))
        (try have := _root_.Light.Std.const_le (by assumption))
        simp [_root_.Light.Limits.Addr, _root_.abs_le, -_root_.abs_mul, LightTernaryMomentChannelStep.args] <;> omega))
      (hd := hd) (hT := by
      first
      | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost, _root_.List.map_cons,
            _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, ]
          first
          | omega
          | (ring_nf; omega))
      | omega
      |
        (simp [] <;> first
            | omega
            | (ring_nf; omega)))
  intro r ν ⟨hzero, hkeep⟩
  have hI : TernaryMomentMatrixInvariant.Holds μ matrix count terms leftWeight [] score ν :=
    TernaryMomentMatrixInvariant.zero score hzero hkeep
  let I : ℕ → (ℕ → ℤ) → Prop := fun i ξ =>
    TernaryMomentMatrixInvariant.Holds μ matrix count terms leftWeight (steps.take i) score ξ
  have hloc : ∀ i < vals.length, Function.update (frame vals) (9 + backend.length) r i = frame vals i :=
    by
    intro i hi
    rw [Function.update_of_ne (by omega)]
  have hs :
    ∀ i < (labels steps).length,
      ∀ ξ,
        I i ξ →
          Meets lim (program xl yl zl xr yr zr steps terms (9 + backend.length)) (entry ((labels steps).getD i (0, 0)))
            (d + 1) vals ξ (cost (steps.getD ((labels steps).getD i (0, 0)).1 (0, 0))) (fun _ ζ => I (i + 1) ζ) :=
    by
    intro i hi ξ hξ
    have hi' : i < steps.length := by simpa [labels] using hi
    have hl : (labels steps).getD i (0, 0) = (i, 0) :=
      by
      rw [List.getD_eq_getElem _ _ hi]
      simp [labels]
    rw [hl]
    exact
      (library_meets xl yl zl xr yr zr steps hi' (hstep i hi' ξ hξ)).append
        [fillBody, body steps terms (9 + backend.length)]
  have hh :=
    LightTernaryFixedChannelLoop.ends (labels steps) entry (fun c => cost (steps.getD c.1 (0, 0))) vals
      (Function.update (frame vals) (9 + backend.length) r) ν I hd hloc (by simpa [I] using hI) hs
  rw [hlen] at hh
  apply
    hh.mono
      (by
        first
        | ( simp only [_root_.Light.Stmt.blockCost, _root_.Light.Cond.cost, _root_.Light.Expr.cost,
              _root_.List.map_cons, _root_.List.map_nil, _root_.List.sum_cons, _root_.List.sum_nil, ]
            first
            | omega
            | (ring_nf; omega))
        | omega
        |
          (simp [] <;> first
              | omega
              | (ring_nf; omega)))
  intro σ hσ
  simpa only [I, labels, List.length_map, List.length_range, List.take_length] using hσ
end ThreeSum.LightWeightedGlobalMomentDriver
