section
-- Source module: Solutions.KFV56Final
/-!
# KFV §56: the uniform Proposition 18 (`P18IL`) from the uniform Proposition 14

* `P14Uat A`: `P14U` with its constant `A` named (so `P14U ↔ ∃ A, P14Uat A`).
* `total18`: the exact cost of a call of the Proposition 18 entry (setup, core, teardown).
* `Cost18`: the asymptotic cost bound of `total18` (proved separately).
* **`p18IL_of`**: `P14Uat A → EwB18 A → Par18Need → Cost18 → KFM.P18IL`.

The table is `kTable (ext18 nU U e su td q)`: the Proposition 14 procedures, the uniform swap
`KFW.swGU q` and the body `body18`; the entry is `ent18 nU`, the descriptor stack `dS18 = 33`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError
open IntMul.OpenAI.Glue IntMul.OpenAI.RCost

/-- `P14U` at a named constant `A`. -/
def P14Uat (A : ℕ) : Prop :=
  ∃ (nU : ℕ) (U : ∀ E : ℕ, (Fin nU → Fin (7 + E)) → Fin nU → IStmt HS (7 + E))
    (entry : Fin nU) (dS14 : Fin HS) (C₀ : ℝ),
    dS14 = 36 ∧ 0 ≤ C₀ ∧
    ∀ (E : ℕ) (ext : Fin E → IStmt HS (7 + E)) (idx : Fin nU → Fin (7 + E)),
      (∀ i, KFM.kTable ext (idx i) = U E idx i) →
      ∀ Isym : List Sym, P14Need Isym (KFM.kTable ext) (idx entry) dS14 A C₀

/-- The register bound of the program. -/
def B18 (p ℓ K : ℕ) (ts : List ℕ) : ℕ :=
  (p + 2) + (n18 ℓ K ts + ℓ + 8) + ts.length * qq ℓ K + ts.length + 1

/-- The twist bound. -/
def U18 (ℓ K : ℕ) (ts : List ℕ) : ℕ := 2 ^ (n18 ℓ K ts + ℓ + 3)

/-- The Kronecker register bound. -/
def BK18 (p ℓ K : ℕ) (ts : List ℕ) : ℕ := 2 * (NLogN.KFV.kb p ℓ * 2 ^ ℓ) + p + n18 ℓ K ts + ℓ + 8

/-- The multiplication cost bound. -/
def φ18 (p ℓ : ℕ) : ℕ := KFM.fmB (2 * (NLogN.KFV.kb p ℓ * 2 ^ ℓ + 2))

/-- The setup / teardown cost bound. -/
def cSet18 (Cs p ℓ K : ℕ) (ts : List ℕ) : ℕ := Cs * (ts.length + ℓ + K + zsz (p : ℤ) + 2) ^ 4

/-- **The exact cost of a Proposition 18 call.** -/
noncomputable def total18 (C₀ Kc : ℝ) (Cs p ℓ K : ℕ) (ts : List ℕ) [NeZero ts.length] : ℕ :=
  let D := ts.length
  let lg := long18 ℓ ts
  let n := n18 ℓ K ts
  let B := B18 p ℓ K ts
  let U := U18 ℓ K ts
  let cCh := cChunk D ℓ K lg (p + 2) B C₀
  cSet18 Cs p ℓ K ts +
    (cCore18 (cLayIn D ℓ K lg Kc n (p + 2) B + NLogN.KFV.cFwd D ℓ K lg (p + 2) B cCh U)
      (cOpp D ℓ K lg (p + 2) B cCh U + cLayOut D ℓ K lg Kc n (p + 2) B)
      n ℓ p B (BK18 p ℓ K ts) (φ18 p ℓ) + cSet18 Cs p ℓ K ts) + 2

/-- **The asymptotic cost of a Proposition 18 call** (for every choice of the constants of the
Proposition 14 call, the swap and the setup). -/
def Cost18 : Prop :=
  ∀ (C₀ Kc : ℝ) (Cs : ℕ), 0 ≤ C₀ → 0 ≤ Kc →
    ∃ (C : ℝ) (A' n₁ : ℕ), 0 ≤ C ∧ ∀ n : ℕ, IntMul.OpenAI.Glue.n0 ≤ n → n₁ ≤ n →
    ∀ (ts : List ℕ) [NeZero ts.length], ts.length + 1 = IntMul.OpenAI.Glue.dP n →
      (∀ t ∈ ts, t = IntMul.OpenAI.Glue.rP n ∨ 2 * t = IntMul.OpenAI.Glue.rP n) →
      (total18 C₀ Kc Cs (pP n) (ℓP n) (KP n) ts : ℝ) ≤
        C * ((ts.prod * IntMul.OpenAI.Glue.rP n * (pP n + 3) : ℕ) : ℝ) *
          Ncost (6 * (IntMul.lg n : ℝ)) (IntMul.OpenAI.Glue.dP n) (KP n) (ℓP n) (αP n) *
          (Real.log (6 * (IntMul.lg n : ℝ)) + 1) ^ A'

/-! ## Arithmetic of the frame -/

end NLogN.KFV

end

