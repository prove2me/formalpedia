open OAI OAI.ReflexiveFixedPoints OAI.ReflexiveFixedPoints.OrderedTree
variable (T : OrderedTree) {i j : ℕ}

theorem OAI.ReflexiveFixedPoints.OrderedTree.lt_descendantLo_iff_ancestorLE_lt (h : i ≤ j)
    (v : T.Node i) (s : T.Node j) :
    s.val < T.descendantLo h v ↔ T.ancestorLE h s < v := by sorry
