      set c := NLogN.KFM.pmSeq s (fun t => g (i - 1 - t)) k with hc
      have hcs : c < s := NLogN.KFM.pmSeq_nonneg_lt s _ hs k
      set t := NLogN.KFM.lpSt u NLogN.KFM.mIc NLogN.KFM.mP LP i k (c : ℤ) with ht
      have tI : t.G NLogN.KFM.mIc = .int ((i : ℤ) - k) :: u.G mIc := by
        simp (config := {decide := true}) [ht, NLogN.KFM.lpSt, NLogN.IState.upd_G]
      have tP : t.G NLogN.KFM.mP = .int (c : ℤ) :: LP := by simp [ht, NLogN.KFM.lpSt]
      have tS : t.G NLogN.KFM.mS = .int (s : ℤ) :: LS := by
        simp (config := {decide := true}) [ht, NLogN.KFM.lpSt, NLogN.IState.upd_G, hS]
      have hR := h.lp NLogN.KFM.mP (by decide) LP i k (c : ℤ)
      have hik : |(i : ℤ) - k| ≤ (A : ℤ) := by rw [abs_le]; constructor <;> omega
      have hsm : NLogN.KFM.exSmS A t (.nmod (.mul (.reg NLogN.KFM.mP) (NLogN.KFM.srcE NLogN.KFM.ixI)) (.reg NLogN.KFM.mS)) := by
        refine ⟨⟨?_, NLogN.KFM.srcE_sm A hA2 t d' Q Mh Mf hR hb NLogN.KFM.mIc _ _ tI hik⟩, ?_, ?_⟩
        · simp only [NLogN.KFM.exSmS, NLogN.IState.top_eq tP]; (all_goals
                                                                  first
                                                                  | assumption
                                                                  | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                  | ((norm_num); (done))
                                                                  | ((norm_num); (omega))
                                                                  | omega
                                                                  | positivity
                                                                  |
                                                                    ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                          first
                                                                          | ((norm_num); (done))
                                                                          | omega);
                                                                      (done)))
        · simp only [NLogN.KFM.exSmS, NLogN.IState.top_eq tS]; (all_goals
                                                                  first
                                                                  | assumption
                                                                  | ((rw [Nat.abs_cast]); (exact_mod_cast (by omega)))
                                                                  | ((norm_num); (done))
                                                                  | ((norm_num); (omega))
                                                                  | omega
                                                                  | positivity
                                                                  |
                                                                    ((apply_rules [mul_pos, Int.natCast_pos.2] <;>
                                                                          first
                                                                          | ((norm_num); (done))
                                                                          | omega);
                                                                      (done)))
        · simp only [NLogN.Ex.eval, NLogN.IState.top_eq tS]; omega
      have := NLogN.RS.asgCost_le NLogN.KFM.mP (.nmod (.mul (.reg NLogN.KFM.mP) (NLogN.KFM.srcE NLogN.KFM.ixI)) (.reg NLogN.KFM.mS)) t B
        (NLogN.KFM.exSmS_bnd A B t hA2 _ hsm (hE.dg _ (by simp only [NLogN.KFM.exDgS, NLogN.KFM.srcE, NLogN.KFM.ixI]; norm_num)))
        (by rw [NLogN.IState.top_eq tP]; exact hE.zsz_nat (by omega))
      show NLogN.RS.asgCost NLogN.KFM.mP _ t ≤ 35 * K
      calc _ ≤ _ := this
        _ ≤ 35 * K := by rw [hK, ← mul_assoc]; exact Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ hpE))
  have hsz : NLogN.KFM.ixO.size = 3 := rfl
  rw [hsz] at H
  have e1 : (3 + 1) * 10 ^ 7 * (B + 2) ^ 2 = 4 * K := by rw [hK]; ring
  have e2 : 4 * 10 ^ 7 * (B + 2) ^ 2 = 4 * K := by rw [hK]; ring
  simp only [e1, e2] at H
  have h1 : i * (35 * K + 4 * K + 30) ≤ i * (40 * K) := Nat.mul_le_mul_left _ (by omega)
  nlinarith
end
