lemma rho_nonneg (h : ℝ) : 0 ≤ rho h := Real.smoothTransition.nonneg _

lemma rho_le_one (h : ℝ) : rho h ≤ 1 := Real.smoothTransition.le_one _

lemma rt_low {τ : ℝ} (h : τ < Real.log 2) : rt τ = 0 := by
  unfold rt
  rw [rho_zero ((Real.lt_log_iff_exp_lt (by norm_num)).mp h).le]
