-- title:
--   Coordinate generation by exact-degree product components
-- statement:
--   For each coordinate, some positive power lies in the ideal generated by the exact-`kD` components of the indexed k-fold products. Derive this by raising the original coordinate relation to the kth ideal power, expanding that power of the finitely generated ideal into products of its generators, and proving that each such product is the exact-`kD` component of the corresponding polynomial product. The component identity follows from the support bounds: in any contributing weight decomposition totaling kD, all k factor weights must equal D. The case d=0 is vacuous; `hk` supplies the positive exponent after raising the original one.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.scaledProduct_coordinate_generation
    {d : Nat} (w : Fin d → Rat) (D : Real) (k : Nat) (hk : 0 < k)
    (n : Nat) (f : Fin n → MvPolynomial (Fin d) Complex)
    (hweight : ∀ j, ∀ a ∈ (f j).support,
      ∑ l, (w l : Real) * (a l : Real) ≤ D)
    (hgen : ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
      MvPolynomial.X i ^ e ∈ Ideal.span (Set.range (fun j =>
        MvPolynomial.weightedHomogeneousComponent
          (fun l => (w l : Real)) D (f j))))
    (N : Nat) (eFin : Fin N ≃ (Fin k → Fin n)) :
    ∀ i : Fin d, ∃ e : Nat, 0 < e ∧
      MvPolynomial.X i ^ e ∈ Ideal.span (Set.range (fun j : Fin N =>
        MvPolynomial.weightedHomogeneousComponent
          (fun l => (w l : Real)) ((k : Real) * D)
          (∏ t : Fin k, f (eFin j t)))) := by sorry
