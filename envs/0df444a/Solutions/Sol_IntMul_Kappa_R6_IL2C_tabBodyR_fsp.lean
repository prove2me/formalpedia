open NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## Parameter registers -/

theorem ESp.ofG' {t : IState HS} {x : Fin HS} {v : ℤ} {L : List Item} {Bb : ℕ}
    (h : t.G x = .int v :: L) (hx : x.val < 56) (hb : zsz v ≤ Bb) : ESp (.reg x) t Bb v :=
  ⟨KFL.clean_all _ (by simp [Ex.regs, hx]), IState.isInt_of h,
    by show zsz (t.top x) ≤ Bb; rw [IState.top_eq h]; exact hb, IState.top_eq h⟩

/-- A register read through a managed state whose managed part does not touch it. -/
theorem encK_G_eq {s : IState HS} {F F' : Fin HS → List ℤ} {r : Fin HS} (h : F' r = F r) :
    (encK s F').G r = (encK s F).G r := by simp [h]

/-! ## The loop -/

theorem segFR_rA (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ) :
    segFR F tf ru rv rw a u v w k rA = (a + segSum tf ru rv rw w u v k) :: (F rA).tail := by
  simp only [segFR]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide),
    Function.update_self]

theorem segFR_rU (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ) :
    segFR F tf ru rv rw a u v w k rU = (u / ru ^ k) :: (F rU).tail := by
  simp only [segFR]; rw [upd_ne (by decide), upd_ne (by decide), Function.update_self]

theorem segFR_rV (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ) :
    segFR F tf ru rv rw a u v w k rV = (v / rv ^ k) :: (F rV).tail := by
  simp only [segFR]; rw [upd_ne (by decide), Function.update_self]

theorem segFR_rW (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ) :
    segFR F tf ru rv rw a u v w k rW = (w * rw ^ k) :: (F rW).tail := by
  simp only [segFR]; rw [Function.update_self]

theorem segFR_ne (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ) (k : ℕ)
    {j : Fin HS} (h1 : j ≠ rA) (h2 : j ≠ rU) (h3 : j ≠ rV) (h4 : j ≠ rW) :
    segFR F tf ru rv rw a u v w k j = F j := by
  simp only [segFR]; rw [upd_ne h4, upd_ne h3, upd_ne h2, upd_ne h1]

theorem geom_le {r : ℤ} (hr : 2 ≤ r) (k : ℕ) : ∑ i ∈ Finset.range k, r ^ i ≤ r ^ k - 1 := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ, pow_succ]
    have : 0 ≤ r ^ k := by positivity
    nlinarith

theorem segSum_abs {tf : ℤ → ℤ → ℤ} {Tm : ℤ} (htf : ∀ a b, |tf a b| ≤ Tm) {ru rv rw w : ℤ}
    (hrw : 2 ≤ rw) (hw : 0 ≤ w) (u v : ℤ) (k : ℕ) :
    |segSum tf ru rv rw w u v k| ≤ Tm * w * (rw ^ k - 1) := by
  unfold segSum
  refine le_trans (Finset.abs_sum_le_sum_abs _ _) ?_
  have h1 : ∀ i ∈ Finset.range k, |w * rw ^ i * tf (u / ru ^ i) (v / rv ^ i)| ≤ Tm * w * rw ^ i := by
    intro i _
    rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ w * rw ^ i)]
    have := htf (u / ru ^ i) (v / rv ^ i)
    have hp : (0 : ℤ) ≤ w * rw ^ i := by positivity
    nlinarith
  refine le_trans (Finset.sum_le_sum h1) ?_
  rw [← Finset.mul_sum]
  have := geom_le hrw k
  have hT : 0 ≤ Tm := le_trans (abs_nonneg _) (htf 0 0)
  have h2 : 0 ≤ Tm * w := by positivity
  nlinarith

theorem segFR_zero (F : Fin HS → List ℤ) (tf : ℤ → ℤ → ℤ) (ru rv rw a u v w : ℤ)
    (hA0 : (F rA).head? = some a) (hU0 : (F rU).head? = some u) (hV0 : (F rV).head? = some v)
    (hW0 : (F rW).head? = some w) : segFR F tf ru rv rw a u v w 0 = F := by
  have e : ∀ (L : List ℤ) (x : ℤ), L.head? = some x → x :: L.tail = L := by
    intro L x h; cases L with
    | nil => simp at h
    | cons y L => simp at h; simp [h]
  funext j
  simp only [segFR, segSum, Finset.range_zero, Finset.sum_empty, add_zero, pow_zero,
    Int.ediv_one, mul_one, Function.update_apply]
  split_ifs with h1 h2 h3 h4
  · subst h1; exact e _ _ hW0
  · subst h2; exact e _ _ hV0
  · subst h3; exact e _ _ hU0
  · subst h4; exact e _ _ hA0
  · rfl

/-- **The segment loop.** -/
theorem segLoopR_fsp {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ} (hT : SegTR T tf Bb Tm Rv)
    (s : IState HS) (F : Fin HS → List ℤ) (hF : F rC = []) {ru rv rw : ℤ}
    {Lu Lv Lw LR LN : List Item}
    (hRu : (encK s F).G pRu = .int ru :: Lu) (hRv : (encK s F).G pRv = .int rv :: Lv)
    (hRw : (encK s F).G pRw = .int rw :: Lw) (hRR : (encK s F).G pR = .int Rv :: LR)
    (hru : 0 < ru) (hrv : 0 < rv) (hrw : 2 ≤ rw)
    (zru : zsz ru ≤ Bb) (zrv : zsz rv ≤ Bb) (zrw : zsz rw ≤ Bb)
    (a u v w : ℤ) (hu : 0 ≤ u) (hv : 0 ≤ v) (hw : 0 < w)
    (n : ℕ) (hNn : (encK s F).G pN = .int (n : ℤ) :: LN)
    (hub : zsz u ≤ Bb) (hvb : zsz v ≤ Bb) (hnb : zsz (n : ℤ) ≤ Bb) (hTm : 1 ≤ Tm)
    (hbig : |a| + Tm * w * rw ^ n < 2 ^ Bb) :
    FSp (segLoopR T) (encK s (segFR F tf ru rv rw a u v w 0))
      (encK s (segFR F tf ru rv rw a u v w n)) (cLp n (cSegItR T Bb) Bb) := by
  have hC : ∀ k, segFR F tf ru rv rw a u v w k rC = [] := fun k => by
    rw [segFR_ne _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide)]; exact hF
  refine FSp.repReg (F := fun k => segFR F tf ru rv rw a u v w k) (by decide) (by decide) hC
    (by simp +decide [segBodyR, RS.writes]) (L := LN)
    (by rw [encK_G_eq (segFR_ne _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide)
      (by decide))]; exact hNn) hnb ?_
  intro k hk
  have hFk : ∀ r : Fin HS, r ≠ rA → r ≠ rU → r ≠ rV → r ≠ rW →
      (encK s (segFR F tf ru rv rw a u v w k)).G r = (encK s F).G r := fun r h1 h2 h3 h4 =>
    encK_G_eq (segFR_ne _ _ _ _ _ _ _ _ _ _ h1 h2 h3 h4)
  exact FSp.of_norep (by simp [segBodyR, norep])
    (segBodyR_sp hT s F hRu hRv hRw hRR hru hrv hrw zru zrv zrw a u v w hu hv hw n hub hvb hTm
      hbig k hk _)

end IntMul.Kappa.R6.IL2C

end

section
-- Source module: Solutions.R6IL2CTab
/-!
# Round six, compact controls (I2C): uniform offset tables and rotations

`tabGenR sgn T` pushes on stack 14 the table `p ↦ (sgn · segSum tf ru rv rw w0 (p/d1) (p/d2) n) mod Q`
(`p = P-1, …, 0`), all parameters on registers:
`1: P, 2: Q, 3: d1, 5: d2, 6: ru, 7: rv, 8: rw, 9: w0, 10: n, 11: R` (the term `T` may read `R`).
`rotR` pushes the parameters, runs the table generator and the record rotation `KFC.rotF`
(`rotR_runs`).
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace IntMul.Kappa.R6.IL2C

open AModel NLogN NLogN.KFL NLogN.KIL NLogN.KFD IntMul RS

/-! ## Parameters -/

theorem ne13 {r x : Fin HS} (hr : r.val < 13) (hx : 13 ≤ x.val) : r ≠ x := fun h => by
  subst h; omega

theorem LowEq.refl (G : Fin HS → List ℤ) : LowEq G G := fun _ _ => rfl

theorem LowEq.upd {G' G : Fin HS → List ℤ} (h : LowEq G' G) {i : Fin HS} (hi : 13 ≤ i.val)
    (l : List ℤ) : LowEq (Function.update G' i l) G := fun r hr => by
  rw [upd_ne (ne13 hr hi)]; exact h r hr

theorem LowEq.segFR {G' G : Fin HS → List ℤ} (h : LowEq G' G) (tf : ℤ → ℤ → ℤ)
    (ru rv rw a u v w : ℤ) (k : ℕ) : LowEq (segFR G' tf ru rv rw a u v w k) G := fun r hr => by
  rw [segFR_ne _ _ _ _ _ _ _ _ _ _ (ne13 hr (by decide)) (ne13 hr (by decide))
    (ne13 hr (by decide)) (ne13 hr (by decide))]
  exact h r hr

theorem TPar.of {s : IState HS} {G G' : Fin HS → List ℤ} {Q d1 d2 : ℕ} {ru rv rw w0 Rv : ℤ} {n : ℕ}
    (hp : TPar (encK s G) Q d1 d2 ru rv rw w0 Rv n) (h : LowEq G' G) :
    TPar (encK s G') Q d1 d2 ru rv rw w0 Rv n := by
  have e : ∀ r : Fin HS, r.val < 13 → (encK s G').G r = (encK s G).G r :=
    fun r hr => encK_G_eq (h r hr)
  obtain ⟨⟨L1, h1⟩, ⟨L2, h2⟩, ⟨L3, h3⟩, ⟨L4, h4⟩, ⟨L5, h5⟩, ⟨L6, h6⟩, ⟨L7, h7⟩, ⟨L8, h8⟩,
    ⟨L9, h9⟩⟩ := hp
  exact ⟨⟨L1, by rw [e _ (by decide)]; exact h1⟩, ⟨L2, by rw [e _ (by decide)]; exact h2⟩,
    ⟨L3, by rw [e _ (by decide)]; exact h3⟩, ⟨L4, by rw [e _ (by decide)]; exact h4⟩,
    ⟨L5, by rw [e _ (by decide)]; exact h5⟩, ⟨L6, by rw [e _ (by decide)]; exact h6⟩,
    ⟨L7, by rw [e _ (by decide)]; exact h7⟩, ⟨L8, by rw [e _ (by decide)]; exact h8⟩,
    ⟨L9, by rw [e _ (by decide)]; exact h9⟩⟩

/-! ## The expressions -/

theorem argE_sp {s : IState HS} {G : Fin HS → List ℤ} {r : Fin HS} (hr : r.val < 56) {N d : ℕ}
    {LP : List ℤ} {L : List Item} {Bb : ℕ} (hP : G KFL.rP = (N : ℤ) :: LP)
    (hd : (encK s G).G r = .int (d : ℤ) :: L) (hN : 1 ≤ N) (hd0 : 0 < d) (hB1 : 1 ≤ Bb)
    (zN : zsz (N : ℤ) ≤ Bb) (zd : zsz (d : ℤ) ≤ Bb) :
    ESp (argE r) (encK s G) Bb (((N - 1) / d : ℕ) : ℤ) := by
  have e1 : (N : ℤ) + -1 = ((N - 1 : ℕ) : ℤ) := by omega
  have E1 := ESp.add (ESp.reg (Bb := Bb) (by decide) hP zN)
    (ESp.lit (t := encK s G) (c := -1) (by rw [zsz_neg, zsz_one]; exact hB1))
    (by rw [e1]; exact le_trans (KIL.zsz_nat_le (Nat.sub_le _ _)) zN)
  rw [e1] at E1
  have e2 : (((N - 1) / d : ℕ) : ℤ) = ((N - 1 : ℕ) : ℤ) / (d : ℤ) := Int.natCast_div _ _
  rw [e2]
  exact ESp.ndiv E1 (ESp.ofG' hd hr zd) (by positivity) (by exact_mod_cast hd0)
    (by rw [← e2]; exact le_trans (KIL.zsz_nat_le (le_trans (Nat.div_le_self _ _)
      (Nat.sub_le _ _))) zN)

/-! ## One table entry -/

set_option maxHeartbeats 4000000 in
theorem tabBodyR_fsp_sol_aux {T : Ex HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ} {Tm Rv : ℤ} (hT : SegTR T tf Bb Tm Rv)
    (sgn : ℤ) (hs : sgn = 1 ∨ sgn = -1) {Q d1 d2 n : ℕ} {ru rv rw w0 : ℤ}
    (hv : TVal Q d1 d2 ru rv rw w0 Tm n Bb)
    (s : IState HS) (G : Fin HS → List ℤ) (hp : TPar (encK s G) Q d1 d2 ru rv rw w0 Rv n)
    (N : ℕ) (hN : 1 ≤ N) (zN : zsz (N : ℤ) ≤ Bb)
    {LP : List ℤ} (hGq : G KFL.rP = (N : ℤ) :: LP) (hGc : G rC = []) :
    FSp (tabBodyR sgn T) (encK s G)
      (encK s (Function.update (Function.update G 14
        ((tabE sgn tf ru rv rw w0 d1 d2 Q n (N - 1) : ℤ) :: G 14)) KFL.rP (((N : ℤ) - 1) :: LP)))
      (cTabR T Bb n) := by
  obtain ⟨hQ, hd1, hd2, hru, hrv, hrw, hw0, hTm, hB2, zru, zrv, zrw, zw0, zn, zd1, zd2, hQQ,
    hbig⟩ := hv
  have hB1 : 1 ≤ Bb := by omega
  have hQQ0 : (0 : ℤ) < (Q : ℤ) * Q := by
    have : (0 : ℤ) < Q := by exact_mod_cast hQ
    positivity
  have zl : ∀ v : ℤ, |v| ≤ 2 * ((Q : ℤ) * Q) → zsz v ≤ Bb := fun v hv => KFL.zsz_of_le hbig hv
  have hQle : (Q : ℤ) ≤ (Q : ℤ) * Q := by
    have : (1 : ℤ) ≤ Q := by exact_mod_cast hQ
    nlinarith
  have zQ : zsz (Q : ℤ) ≤ Bb := zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)
  have zQQ : zsz ((Q : ℤ) * Q) ≤ Bb := zl _ (by rw [abs_of_nonneg (by positivity)]; linarith)
  -- step 1, 2: the arguments
  obtain ⟨L3, p3⟩ := hp.d1
  obtain ⟨L5, p5⟩ := hp.d2
  obtain ⟨L9, p9⟩ := hp.w0
  set u : ℕ := (N - 1) / d1
  set v : ℕ := (N - 1) / d2
  have zu : zsz (u : ℤ) ≤ Bb :=
    le_trans (KIL.zsz_nat_le (le_trans (Nat.div_le_self _ _) (Nat.sub_le _ _))) zN
  have zv : zsz (v : ℤ) ≤ Bb :=
    le_trans (KIL.zsz_nat_le (le_trans (Nat.div_le_self _ _) (Nat.sub_le _ _))) zN
  have E1 := argE_sp (by decide) hGq p3 hN hd1 hB1 zN zd1
  have S1 := Sp.pushQ s G (i := rU) (by decide) E1.clean E1.ok E1.bnd
  rw [E1.ev] at S1
  set G1 := Function.update G rU ((u : ℤ) :: G rU)
  have l1 : LowEq G1 G := (LowEq.refl G).upd (by decide) _
  have g1q : G1 KFL.rP = (N : ℤ) :: LP := by simp only [G1]; rw [upd_ne (by decide)]; exact hGq
  have E2 := argE_sp (r := 5) (by decide) g1q (by rw [encK_G_eq (l1 5 (by decide))]; exact p5) hN hd2 hB1
    zN zd2
  have S2 := Sp.pushQ s G1 (i := rV) (by decide) E2.clean E2.ok E2.bnd
  rw [E2.ev] at S2
  set G2 := Function.update G1 rV ((v : ℤ) :: G1 rV)
  have l2 : LowEq G2 G := l1.upd (by decide) _
  have E3 : ESp (.reg pW0) (encK s G2) Bb w0 :=
    ESp.ofG' (by rw [encK_G_eq (l2 pW0 (by decide))]; exact p9) (by decide) zw0
  have S3 := Sp.pushQ s G2 (i := rW) (by decide) E3.clean E3.ok E3.bnd
  rw [E3.ev] at S3
  set G3 := Function.update G2 rW (w0 :: G2 rW)
  have S4 := Sp.pushQ s G3 (i := rA) (e := .lit 0) (B := Bb) (by decide) (clean_lit _) trivial
    (by simp only [Ex.Bnd, zsz_zero]; omega)
  simp only [Ex.eval] at S4
  set G4 := Function.update G3 rA ((0 : ℤ) :: G3 rA)
  have l4 : LowEq G4 G := ((l2.upd (by decide) _).upd (by decide) _)
  -- the segment loop
  have g4A : G4 rA = 0 :: G rA := by
    simp only [G4]; rw [Function.update_self]; simp only [G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
  have g4W : G4 rW = w0 :: G rW := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [Function.update_self]
    simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]
  have g4V : G4 rV = (v : ℤ) :: G rV := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [Function.update_self]; simp only [G1]; rw [upd_ne (by decide)]
  have g4U : G4 rU = (u : ℤ) :: G rU := by
    simp only [G4]; rw [upd_ne (by decide)]; simp only [G3]; rw [upd_ne (by decide)]
    simp only [G2]; rw [upd_ne (by decide)]; simp only [G1]; rw [Function.update_self]
  have g4o : ∀ j, j ≠ rA → j ≠ rU → j ≠ rV → j ≠ rW → G4 j = G j := by
    intro j h1 h2 h3 h4
    simp only [G4, G3, G2, G1]; rw [upd_ne h1, upd_ne h4, upd_ne h3, upd_ne h2]
  have g4c : G4 rC = [] := by rw [g4o rC (by decide) (by decide) (by decide) (by decide)]; exact hGc
  have hp4 := hp.of l4
  obtain ⟨Lu, pu⟩ := hp4.ru
  obtain ⟨Lv, pv⟩ := hp4.rv
  obtain ⟨Lw, pw⟩ := hp4.rw
  obtain ⟨LR, pR'⟩ := hp4.R
  obtain ⟨LN, pN'⟩ := hp4.n
  have hbig' : |(0 : ℤ)| + Tm * w0 * rw ^ n < 2 ^ Bb := by
    simp only [abs_zero, zero_add]; linarith
  have SL := segLoopR_fsp hT s G4 g4c pu pv pw pR' hru hrv hrw zru zrv zrw 0 u v w0
    (by positivity) (by positivity) hw0 n pN' zu zv zn hTm hbig'
  have e0 : segFR G4 tf ru rv rw 0 u v w0 0 = G4 :=
    segFR_zero _ _ _ _ _ _ _ _ _ (by simp [g4A]) (by simp [g4U]) (by simp [g4V]) (by simp [g4W])
  rw [e0] at SL
  set G5 := segFR G4 tf ru rv rw 0 u v w0 n
  set o := segSum tf ru rv rw w0 u v n with ho_def
  have g5A : G5 rA = o :: G rA := by
    simp only [G5]; rw [segFR_rA, g4A, zero_add]; rfl
  have hoabs := segSum_abs (ru := ru) (rv := rv) hT.abs hrw hw0.le (u : ℤ) (v : ℤ) n
  have hTw : 0 ≤ Tm * w0 := by
    have : (0 : ℤ) ≤ Tm := by omega
    positivity
  have hoQ : |o| ≤ (Q : ℤ) * Q := by
    have : Tm * w0 * (rw ^ n - 1) ≤ Tm * w0 * rw ^ n := by nlinarith
    linarith
  have hso : |sgn * o| ≤ (Q : ℤ) * Q := by
    rcases hs with rfl | rfl <;> simp [abs_neg] <;> linarith
  have hpos : 0 ≤ sgn * o + (Q : ℤ) * Q := by have := abs_le.1 hso; linarith
  -- the entry
  have l5 : LowEq G5 G := l4.segFR _ _ _ _ _ _ _ _ _
  obtain ⟨Lq, pq⟩ := (hp.of l5).q
  have EQ : ESp (.reg 2) (encK s G5) Bb (Q : ℤ) := ESp.ofG' pq (by decide) zQ
  have EA : ESp (.mul (.lit sgn) (.reg rA)) (encK s G5) Bb (sgn * o) :=
    ESp.mul (ESp.lit (zl _ (by rcases hs with rfl | rfl <;> simp <;> nlinarith)))
      (ESp.reg (by decide) g5A (zl _ (by linarith))) (zl _ (by linarith))
  have ES : ESp (.add (.mul (.lit sgn) (.reg rA)) (.mul (.reg 2) (.reg 2))) (encK s G5) Bb
      (sgn * o + (Q : ℤ) * Q) :=
    ESp.add EA (ESp.mul EQ EQ zQQ) (zl _ (by rw [abs_of_nonneg hpos]; have := abs_le.1 hso; linarith))
  have E6 : ESp (amtR sgn) (encK s G5) Bb ((sgn * o + (Q : ℤ) * Q) % Q) :=
    ESp.nmod ES EQ hpos (by exact_mod_cast hQ) (zl _ (by
      have h1 := Int.emod_nonneg (sgn * o + (Q : ℤ) * Q) (by exact_mod_cast hQ.ne' : (Q : ℤ) ≠ 0)
      have h2 := Int.emod_lt_of_pos (sgn * o + (Q : ℤ) * Q) (by exact_mod_cast hQ : (0 : ℤ) < Q)
      rw [abs_of_nonneg h1]; linarith))
  have S6 := Sp.pushQ s G5 (i := 14) (by decide) E6.clean E6.ok E6.bnd
  rw [E6.ev] at S6
  set ent := (sgn * o + (Q : ℤ) * Q) % Q
  set G6 := Function.update G5 14 (ent :: G5 14)
  -- pops
  have g6A : G6 rA = o :: G rA := by simp only [G6]; rw [upd_ne (by decide)]; exact g5A
  have S7 := Sp.pop s G6 (B := Bb) (by decide) g6A (zl _ (by linarith))
  set G7 := Function.update G6 rA (G rA)
  have g7W : G7 rW = w0 * rw ^ n :: G rW := by
    simp only [G7, G6]
    rw [upd_ne (by decide), upd_ne (by decide)]; simp only [G5]; rw [segFR_rW, g4W]; rfl
  have S8 := Sp.pop s G7 (B := Bb) (by decide) g7W (zl _ (by
    rw [abs_of_nonneg (by positivity)]
    have : w0 * rw ^ n ≤ Tm * w0 * rw ^ n := by
      have : 0 ≤ w0 * rw ^ n := by positivity
      nlinarith
