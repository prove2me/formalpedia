namespace Hirsch.SelectedActiveRows

open Set Hirsch.CutActiveSupport

/-- Fixing the nonzero mass row first permits a square original-row subsystem.
No selected rows, spanning test, inverse, or determinant is supplied. -/
theorem mass_preserving_square {n : ℕ} (hn : 0 < n)
    {A : Type*} [Fintype A] (rows : A → Fin n → ℝ)
    (hind : LinearIndependent ℝ (fun i => ((1 : ℝ), fun j : A => rows j i))) :
    ∃ J : Finset A, J.card + 1 = n ∧
      ∀ (mass : ℝ) (values : J → ℝ), ∃! u : Fin n → ℝ,
        (∑ i, u i) = mass ∧
          ∀ j : J, (∑ i, u i * rows j.val i) = values j := by
  classical
  let f : Option A → (Fin n → ℝ) := fun j => match j with
    | none => fun _ => 1
    | some j => rows j
  have hsingle : LinearIndepOn ℝ f ({none} : Set (Option A)) := by
    apply LinearIndepOn.singleton'
    intro c hc
    have h := congrFun hc ⟨0, hn⟩
    simpa only [f, Pi.smul_apply, Pi.zero_apply, smul_eq_mul, mul_one] using h
  obtain ⟨B, hBsub, hbase, hspan, hB⟩ :=
    exists_linearIndepOn_extension hsingle (Set.subset_univ _)
  have hnone : (none : Option A) ∈ B := hbase (Set.mem_singleton _)
  let J : Finset A := Finset.univ.filter (fun j => some j ∈ B)
  have hJ : ∀ j : A, j ∈ J ↔ some j ∈ B := by
    intro j
    simp only [J, Finset.mem_filter, Finset.mem_univ, true_and]
  let emb : Option J → B := fun j => match j with
    | none => ⟨none, hnone⟩
    | some j => ⟨some j.val, (hJ j.val).mp j.property⟩
  have hemb : Function.Injective emb := by
    intro i j hij
    have he := congrArg (fun z : B => z.val) hij
    cases i with
    | none =>
      cases j with
      | none => rfl
      | some j => cases he
    | some i =>
      cases j with
      | none => cases he
      | some j =>
        have hv : i.val = j.val := Option.some.inj he
        exact congrArg some (Subtype.ext hv)
  have hBind : LinearIndependent ℝ (fun j : B => f j.val) := hB
  have hselected : LinearIndependent ℝ (fun j : Option J => f (emb j).val) :=
    hBind.comp emb hemb
  have hupper : J.card + 1 ≤ n := by
    have h := hselected.fintype_card_le_finrank
    simpa only [Module.finrank_pi, Fintype.card_fin, Fintype.card_option,
      Fintype.card_coe] using h
  let E : (Fin n → ℝ) →ₗ[ℝ] (ℝ × (J → ℝ)) :=
    { toFun := fun u => ((∑ i, u i), fun j => ∑ i, u i * rows j.val i)
      map_add' := by
        intro u v
        apply Prod.ext
        · change (∑ i, (u+v) i) = (∑ i, u i) + (∑ i, v i)
          simp only [Pi.add_apply, Finset.sum_add_distrib]
        · funext j
          change (∑ i, (u+v) i * rows j.val i) =
            (∑ i, u i * rows j.val i) + (∑ i, v i * rows j.val i)
          simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
      map_smul' := by
        intro c u
        apply Prod.ext
        · change (∑ i, (c • u) i) = c * (∑ i, u i)
          simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum]
        · funext j
          change (∑ i, (c • u) i * rows j.val i) = c * (∑ i, u i * rows j.val i)
          simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, mul_assoc] }
  have hker : ∀ u : Fin n → ℝ, E u = 0 → u = 0 := by
    intro u hu
    have hmass : (∑ i, u i) = 0 := congrArg Prod.fst hu
    let D : (Fin n → ℝ) →ₗ[ℝ] ℝ :=
      { toFun := fun z => ∑ i, u i * z i
        map_add' := by
          intro z w
          simp only [Pi.add_apply, mul_add, Finset.sum_add_distrib]
        map_smul' := by
          intro c z
          simp only [Pi.smul_apply, smul_eq_mul, Finset.mul_sum, RingHom.id_apply]
          apply Finset.sum_congr rfl
          intro i _
          ring }
    have hle : Submodule.span ℝ (f '' B) ≤ LinearMap.ker D := by
      apply Submodule.span_le.mpr
      rintro z ⟨j, hj, rfl⟩
      change D (f j) = 0
      cases j with
      | none =>
          change (∑ i, u i * (1 : ℝ)) = 0
          simpa only [mul_one] using hmass
      | some j =>
        let q : J := ⟨j, (hJ j).mpr hj⟩
        have h := congrArg (fun z : ℝ × (J → ℝ) => z.2 q) hu
        exact h
    have hall : ∀ j : A, (∑ i, u i * rows j i) = 0 := by
      intro j
      exact hle (hspan ⟨some j, Set.mem_univ _, rfl⟩)
    have hzero : (∑ i, u i • ((1 : ℝ), fun j : A => rows j i)) = 0 := by
      apply Prod.ext
      · simpa [sum_fst] using hmass
      · funext j
        simpa [sum_snd, Finset.sum_apply, smul_eq_mul] using hall j
    have hz := Fintype.linearIndependent_iff.mp hind u hzero
    funext i
    exact hz i
  have hinj : Function.Injective E := by
    intro u v huv
    apply sub_eq_zero.mp
    apply hker (u-v)
    rw [map_sub, huv, sub_self]
  have hlower : n ≤ J.card + 1 := by
    have h := LinearMap.finrank_le_finrank_of_injective hinj
    simpa only [Module.finrank_pi, Module.finrank_prod, Module.finrank_self,
      Fintype.card_fin, Fintype.card_coe, Nat.add_comm] using h
  have hcard : J.card + 1 = n := le_antisymm hupper hlower
  have hdim : Module.finrank ℝ (Fin n → ℝ) =
      Module.finrank ℝ (ℝ × (J → ℝ)) := by
    simp only [Module.finrank_pi, Module.finrank_prod, Module.finrank_self,
      Fintype.card_fin, Fintype.card_coe]
    omega
  have hsurj : Function.Surjective E :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mp hinj
  refine ⟨J, hcard, ?_⟩
  intro mass values
  obtain ⟨u, hu⟩ := hsurj (mass, values)
  refine ⟨u, ⟨congrArg Prod.fst hu, ?_⟩, ?_⟩
  · intro j
    exact congrArg (fun z : ℝ × (J → ℝ) => z.2 j) hu
  · intro v hv
    apply hinj
    have he : E v = (mass, values) := by
      apply Prod.ext
      · exact hv.1
      · funext j
        exact hv.2 j
    exact he.trans hu.symm

end Hirsch.SelectedActiveRows

/-- Select both a positive support and exactly n-1 original active cuts.
Together with total mass, their square system is bijective for arbitrary real
data and recovers the actual weights; no row selector or inverse is assumed. -/
theorem solution
    (m d : ℕ) (S : Set (Fin d → ℝ))
    (C : Fin m → (Fin d → ℝ) →ₗ[ℝ] ℝ) (b : Fin m → ℝ)
    (x : Fin d → ℝ)
    (hx : x ∈ (convexHull ℝ S ∩ {y | ∀ j, C j y ≤ b j}).extremePoints ℝ) :
    ∃ (n : ℕ) (v : Fin n → Fin d → ℝ) (w : Fin n → ℝ)
      (J : Finset {j : Fin m // C j x = b j}),
      (∀ i, v i ∈ S) ∧ (∀ i, 0 < w i) ∧ (∑ i, w i) = 1 ∧
      (∑ i, w i • v i) = x ∧
      LinearIndependent ℝ (fun i => ((1 : ℝ), v i)) ∧
      n ≤ d + 1 ∧ J.card + 1 = n ∧
      (∀ (mass : ℝ) (values : J → ℝ), ∃! u : Fin n → ℝ,
        (∑ i, u i) = mass ∧
          ∀ j : J, (∑ i, u i * C j.val.val (v i)) = values j) ∧
      (∀ u : Fin n → ℝ, (∑ i, u i) = 1 →
        (∀ j : J, (∑ i, u i * C j.val.val (v i)) = b j.val.val) → u = w) := by
  classical
  obtain ⟨n,v,w,hvS,hwpos,hw1,hwx,hvind,himage,hnd,hna,hall⟩ :=
    accepted_positive_support m d S C b x hx
  have hn : 0 < n := by
    by_contra hn
    have hn0 : n = 0 := by omega
    subst n
    simp at hw1
  obtain ⟨J,hcard,hsquare⟩ := Hirsch.SelectedActiveRows.mass_preserving_square hn
    (fun j : {j : Fin m // C j x = b j} => fun i => C j.val (v i)) himage
  refine ⟨n,v,w,J,hvS,hwpos,hw1,hwx,hvind,hnd,hcard,hsquare,?_⟩
  intro u hu1 hu
  obtain ⟨z,hz,hunique⟩ := hsquare 1 (fun j => b j.val.val)
  have hw : ∀ j : J, (∑ i, w i * C j.val.val (v i)) = b j.val.val := by
    intro j
    have h := congrArg (C j.val.val) hwx
    simpa only [map_sum, map_smul, smul_eq_mul, j.val.property] using h
  exact (hunique u ⟨hu1,hu⟩).trans (hunique w ⟨hw1,hw⟩).symm

#print axioms Hirsch.SelectedActiveRows.mass_preserving_square
#print axioms solution
