/-!
# B-line IL, the `J` kernel (B4), part 4: the dot loop as a whole, loops with varying bodies

* `MSp.repS`: the counted loop through managed states with an iteration-dependent body cost
  (`∑ k < N, c k`);
* `dotP_spec`: `dotP X` adds `dotF P cs acc` to `SUM`, consumes `|cs|` table entries onto `TT`
  and restores `X`, at cost `(|cs| + 1) · uC`;
* the a-priori bounds of the fixed-point dot products (`fmul_abs_lt`, `dotF_take_abs_le`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.JK

open IntMul NLogN NLogN.KIL Function Finset

/-! ## Loops with varying bodies -/

/-! ## The dot loop as a whole -/

section dot
variable {P : ℕ} {F : Fin HS → List ℤ} {X : Fin HS} {cs acc R T0 : List ℤ} {S0 : ℤ} {Ls : List ℤ}

theorem bnd_getElem {B : ℕ} {l : List ℤ} (h : Bnd B l) (i : ℕ) (hi : i < l.length) :
    zsz l[i] ≤ B := h _ (List.getElem_mem hi)

end dot

/-! ## A-priori bounds -/

theorem rs_natAbs_le (P : ℕ) (z : ℤ) : (J6Seg.rs P z).natAbs ≤ 2 * z.natAbs + 2 ^ P := by
  rw [rs_eq]
  refine le_trans (Int.natAbs_ediv_le_natAbs _ _) ?_
  refine le_trans (Int.natAbs_add_le _ _) ?_
  rw [Int.natAbs_mul, Int.natAbs_pow]; simp

theorem fmul_natAbs_lt (P Xb : ℕ) {x y : ℤ} (hx : zsz x ≤ Xb) (hy : zsz y ≤ Xb) :
    (J6Seg.fmul P x y).natAbs < 2 ^ (2 * Xb + P + 2) := by
  have h1 := rs_natAbs_le P (x * y)
  have hx' := zsz_le_iff.1 hx
  have hy' := zsz_le_iff.1 hy
  have hxy : (x * y).natAbs < 2 ^ (2 * Xb) := by
    rw [Int.natAbs_mul, two_mul, pow_add]
    exact Nat.mul_lt_mul'' hx' hy'
  have e1 : 2 ^ (2 * Xb + P + 2) = 4 * (2 ^ (2 * Xb) * 2 ^ P) := by rw [pow_add, pow_add]; ring
  have e2 : 1 ≤ 2 ^ P := Nat.one_le_two_pow
  have e3 : 1 ≤ 2 ^ (2 * Xb) := Nat.one_le_two_pow
  have : 2 ^ (2 * Xb) ≤ 2 ^ (2 * Xb) * 2 ^ P := Nat.le_mul_of_pos_right _ (by omega)
  have : 2 ^ P ≤ 2 ^ (2 * Xb) * 2 ^ P := Nat.le_mul_of_pos_left _ (by omega)
  simp only [J6Seg.fmul]
  omega

theorem getD_bnd {B : ℕ} {l : List ℤ} (h : Bnd B l) (i : ℕ) : zsz (l.getD i 0) ≤ B := by
  rcases lt_or_ge i l.length with hi | hi
  · rw [List.getD_eq_getElem _ _ hi]; exact bnd_getElem h i hi
  · rw [List.getD_eq_default _ _ hi, zsz_zero]; omega

theorem dotF_natAbs_le (P Xb : ℕ) {cs acc : List ℤ} (hc : Bnd Xb cs) (ha : Bnd Xb acc) :
    (dotF P cs acc).natAbs ≤ cs.length * 2 ^ (2 * Xb + P + 2) := by
  unfold dotF
  refine le_trans (Int.natAbs_sum_le _ _) ?_
  have := Finset.sum_le_sum (s := range cs.length)
    (f := fun i => (J6Seg.fmul P (cs.getD i 0) (acc.getD i 0)).natAbs)
    (g := fun _ => 2 ^ (2 * Xb + P + 2))
    (fun i _ => (fmul_natAbs_lt P Xb (getD_bnd hc i) (getD_bnd ha i)).le)
  simpa using this

theorem bnd_take {B : ℕ} {l : List ℤ} (h : Bnd B l) (k : ℕ) : Bnd B (l.take k) :=
  fun a ha => h a (List.mem_of_mem_take ha)

theorem bnd_drop {B : ℕ} {l : List ℤ} (h : Bnd B l) (k : ℕ) : Bnd B (l.drop k) :=
  fun a ha => h a (List.mem_of_mem_drop ha)

/-- Partial dot sums have at most `2 Xb + P + Bc + 3` bits (for `|cs| < 2^Bc`). -/
theorem dotF_take_zsz (P Xb Bc : ℕ) {cs acc : List ℤ} (hc : Bnd Xb cs) (ha : Bnd Xb acc)
    (hl : cs.length < 2 ^ Bc) (k : ℕ) :
    (dotF P (cs.take k) acc).natAbs < 2 ^ (2 * Xb + P + Bc + 2) := by
  have h := dotF_natAbs_le P Xb (bnd_take hc k) ha
  have hk : (cs.take k).length < 2 ^ Bc := by simp; omega
  have e : 2 ^ (2 * Xb + P + Bc + 2) = 2 ^ Bc * 2 ^ (2 * Xb + P + 2) := by
    rw [← pow_add]; ring_nf
  rw [e]
  calc (dotF P (cs.take k) acc).natAbs ≤ (cs.take k).length * 2 ^ (2 * Xb + P + 2) := h
    _ < 2 ^ Bc * 2 ^ (2 * Xb + P + 2) :=
      Nat.mul_lt_mul_of_pos_right hk (by positivity)

end J6Seg.JK

end

