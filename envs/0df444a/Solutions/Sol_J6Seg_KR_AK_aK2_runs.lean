  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

theorem sp_dropR {X C R : Fin HS} (hXC : X ≠ C) (hRC : R ≠ C) (hRX : R ≠ X) (hX5 : X.val < 56)
