import Definitions.Def_AT260939824_ClopenMarkers
import Init
import Mathlib.Combinatorics.SimpleGraph.Basic
import Mathlib.Order.Monotone.Basic
import Mathlib.Topology.Clopen

set_option autoImplicit false

/-!
# A clopen maximal independent set from a countable clopen independent cover

This is the maximal-independent-set part of Lemma 3.1 of
arXiv:2609.39824. The graph-neighbor operator is assumed to preserve clopen
sets, as happens for graphs generated by finitely many homeomorphisms.
The existence of the countable independent cover is a separate input.
-/
namespace AbelianTargets
end AbelianTargets
open AbelianTargets
universe u
variable {X : Type u} (G : SimpleGraph X)
variable {G}

theorem solution (C : ℕ → Set X)
    (hindep : ∀ n, GraphIndependent G (C n)) (n : ℕ) :
    GraphIndependent G (markerAccumulation G C n) := by
  induction n with
  | zero =>
      intro x hx
      exact False.elim hx
  | succ n ih =>
      intro x hx y hy hadj
      rcases hx with hx | hx
      · rcases hy with hy | hy
        · exact ih x hx y hy hadj
        · exact hy.2 ⟨x, hx, hadj⟩
      · rcases hy with hy | hy
        · exact hx.2 ⟨y, hy, hadj.symm⟩
        · exact hindep n x hx.1 y hy.1 hadj
