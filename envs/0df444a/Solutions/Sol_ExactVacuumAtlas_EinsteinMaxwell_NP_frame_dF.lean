-- ==== solution ====
open scoped ContDiff Matrix
open Complex
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.NP
variable {g gi : Metric 4} {E Θ : Fin 4 → Fin 4 → Pt 4 → ℂ} {U : Set (Pt 4)}
theorem solution (hF : FrameData g gi E Θ U) {F : TwoForm 4} (hFs : ∀ i j, ContDiffOn ℝ ∞ (F i j) U)
    (hFa : ∀ y ∈ U, ∀ i j, F i j y = -F j i y) {x : Pt 4} (hx : x ∈ U) (A B C : Fin 4) :
    Hfr F E A B C x = fdir E A (FfrF F E B C) x + fdir E B (FfrF F E C A) x + fdir E C (FfrF F E A B) x
      - ∑ K, (cfr E Θ K A B x * FfrF F E K C x + cfr E Θ K B C x * FfrF F E K A x
        + cfr E Θ K C A x * FfrF F E K B x) := by
  rw [Finset.sum_add_distrib, Finset.sum_add_distrib, sum_cfr_FfrF hF F hx, sum_cfr_FfrF hF F hx,
    sum_cfr_FfrF hF F hx, fdir_FfrF hF hFs hx, fdir_FfrF hF hFs hx, fdir_FfrF hF hFs hx]
  have a10 := hFa x hx 1 0; have a20 := hFa x hx 2 0; have a30 := hFa x hx 3 0
  have a21 := hFa x hx 2 1; have a31 := hFa x hx 3 1; have a32 := hFa x hx 3 2
  have d0 : F 0 0 x = 0 := by have := hFa x hx 0 0; linarith
  have d1 : F 1 1 x = 0 := by have := hFa x hx 1 1; linarith
  have d2 : F 2 2 x = 0 := by have := hFa x hx 2 2; linarith
  have d3 : F 3 3 x = 0 := by have := hFa x hx 3 3; linarith
  simp only [Hfr, faradayCyclic, brk, Fin.sum_univ_four, a10, a20, a30, a21, a31, a32, d0, d1, d2, d3]
  push_cast
  ring
