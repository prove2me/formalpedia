    funext ω s
    ring
  have hmc : Measurable (Function.uncurry fun ω s => (-1 : ℝ) * H ω s) := hfun ▸ hmn
  have hpc : LevyStochCalc.Probability.ProgressivelyMeasurable ℱ fun ω s => (-1 : ℝ) * H ω s := hfun ▸ hpn
