open Matrix
variable {k l : ℕ+}
noncomputable section
theorem _root_.solution (j : Fin l) : (l : Fin <| l + 1) ≠ j := by
  intro h
  have hv := congrArg Fin.val h
  change (l : ℕ) % ((l : ℕ) + 1) = (j : ℕ) % ((l : ℕ) + 1) at hv
  rw [Nat.mod_eq_of_lt (Nat.lt_succ_self _), Nat.mod_eq_of_lt (Nat.lt_trans j.isLt (Nat.lt_succ_self _))] at hv
  have := j.isLt
  omega
