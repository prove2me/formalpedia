      = snorm (outerUnVec (auxVec (F := F) (n := n) aux)) (aOp (φA * P * φAᴴ - bOp τ)) := by
  rw [registerState_eq_outerUnVec]
  exact snorm_comp_regSwap_alice _ φA P τ
