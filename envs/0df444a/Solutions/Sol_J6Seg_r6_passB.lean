section
-- Source module: Solutions.J6SegLn11
/-!
# Segmented inverse (S2), machine side 11: the `B₀` tensor pass

Axis by axis (`tensorGo`, as the frozen `KFY.passB`), every `t_i`-line `X` is replaced by the
`t_i` values `B0seg … (X as a function) l` (zero for `l ≥ s_i`): this is what `lineB` computes
(`lineB_list`, with `n_c λ = t_i`).

**`passBseg`**: for per-axis maps `Bm i` with `‖Bm i‖ ≤ 1/2`, the per-axis bound `9` of
`r6_axisMaps_fit` and `B0seg 0 = 0`, from `RepFull ys y`, `‖y‖ ≤ 1`:
`RepPad` of the result, every entry in the disc (`GB (p+2)`), and
`‖vOf − tensCLM (kerB Bm) y‖ ≤ 9 d · 2^{-p}`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open Complex

namespace J6Seg
open IntMul IntMul.HvdH IntMul.HvdH.Ref IntMul.HvdH.RefPf NLogN.KFM NLogN.KFY IntMul.OpenAI.RT
open NLogN.KFB (GI gflat)

/-! ## `lineB` as a list map -/

theorem lineB_list {p P R s t lam w α K nc : ℕ} [NeZero t] (hl : 1 ≤ lam) (hs : 0 < s)
    (hst : s ≤ t) (hws : 2 * w < s) (hwK : w ≤ K) (hKm : 2 * K + 1 ≤ (LJ s t lam w).length)
    (hsN : s ≤ nc * lam) (y : List (ℤ × ℤ)) :
    lineB p P R s t lam w α K nc y =
      (List.range (nc * lam)).map (B0seg p P R lam w s t α fun j => y.getD j (0, 0)) := by
  apply List.ext_getElem (by simp [lineB])
  intro l h1 h2
  have hl' : l < nc * lam := by simpa using h2
