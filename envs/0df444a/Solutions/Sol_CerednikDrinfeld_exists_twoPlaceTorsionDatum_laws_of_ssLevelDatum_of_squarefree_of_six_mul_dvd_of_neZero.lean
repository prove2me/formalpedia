theorem congruenceLevel_self {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) :
    congruenceLevel Λ Λ = Submodule.finiteIdeleStabilizer Λ := by
  ext u
  refine ⟨fun hu => hu.1, fun hu => ⟨hu, hu, fun x hx => ?_⟩⟩
  refine sub_mem ?_ hx
  have h := MulAction.mem_stabilizer_iff.mp hu
  have hx' : (u : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) * x ∈
      (u • ((Submodule.finiteAdeleBox Λ : AddSubgroup (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)) :
        Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ))) :=
    Set.smul_mem_smul_set hx
  rw [h] at hx'
  exact hx'

theorem finite_classSet_of_isOrder {a b : ℚ} (ha : a < 0) (hb : b < 0) (Λ : Submodule ℤ ℍ[ℚ, a, b])
    (hΛ : IsOrder Λ) : Finite (ClassSet (Submodule.finiteIdeleStabilizer Λ)) := by
  have h := QuaternionAlgebra.finite_classSet_congruenceLevel ha hb Λ Λ hΛ le_rfl 1 one_ne_zero
    (fun x hx => by simpa using hx)
  rwa [congruenceLevel_self] at h

theorem finiteAdeleBox_mul_mem {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : IsOrder R)
    {x y : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ}
    (hx : x ∈ Submodule.finiteAdeleBox R) (hy : y ∈ Submodule.finiteAdeleBox R) :
    x * y ∈ Submodule.finiteAdeleBox R := by
  unfold Submodule.finiteAdeleBox at hx hy ⊢
  induction hy using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨z', hz', a', ha', rfl⟩ := hy
    induction hx using AddSubgroup.closure_induction with
    | mem x hx =>
      obtain ⟨z, hz, a₀, ha₀, rfl⟩ := hx
      refine AddSubgroup.subset_closure ⟨z * z', hR.mul_mem hz hz', a₀ * a', fun v => ?_, ?_⟩
      · exact mul_mem (ha₀ v) (ha' v)
      · rw [Algebra.TensorProduct.tmul_mul_tmul]
    | zero => rw [zero_mul]; exact zero_mem _
    | add x x' _ _ ihx ihx' => rw [add_mul]; exact add_mem ihx ihx'
    | neg x _ ih => convert neg_mem ih using 1; exact neg_mul x (z' ⊗ₜ[ℚ] a')
  | zero => rw [mul_zero]; exact zero_mem _
  | add y y' _ _ ih ih' => rw [mul_add]; exact add_mem ih ih'
  | neg y _ ih => convert neg_mem ih using 1; exact mul_neg x y

theorem one_mem_finiteAdeleBox {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : IsOrder R) :
    (1 : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) ∈ Submodule.finiteAdeleBox R :=
  AddSubgroup.subset_closure ⟨1, hR.one_mem, 1, fun v => one_mem _, by rw [Algebra.TensorProduct.one_def]⟩

theorem stab_meetOrder_le {R : Submodule ℤ ℍ[ℚ, a, b]} (hR : IsOrder R)
    {n : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ} (hS : IsOrder (meetOrder R n)) :
    Submodule.finiteIdeleStabilizer (meetOrder R n) ≤ Submodule.finiteIdeleStabilizer R := by
  intro u hu
  have hSR : Submodule.finiteAdeleBox (meetOrder R n) ≤ Submodule.finiteAdeleBox R :=
    AddSubgroup.closure_mono fun x ⟨z, hz, c, hc, e⟩ => ⟨z, (inf_le_left : meetOrder R n ≤ R) hz, c, hc, e⟩
  rw [Submodule.mem_finiteIdeleStabilizer_iff] at hu ⊢
  have h1S := one_mem_finiteAdeleBox hS

  have huS : (u : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) ∈
      ((Submodule.finiteAdeleBox (meetOrder R n) : AddSubgroup _) : Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)) := by
    rw [← hu]
    exact ⟨1, h1S, by dsimp only; rw [smul_eq_mul, mul_one]⟩
  have huinvS : ((u⁻¹ : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) ∈
      ((Submodule.finiteAdeleBox (meetOrder R n) : AddSubgroup _) : Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)) := by
    have h1 : (1 : ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ) ∈
        u • ((Submodule.finiteAdeleBox (meetOrder R n) : AddSubgroup _) : Set (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)) := by
      rw [hu]; exact h1S
    obtain ⟨x, hx, hx1⟩ := h1
    dsimp only at hx1
    rw [smul_eq_mul] at hx1
    have hxe : x = ((u⁻¹ : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : _) := by
      calc x = ((u⁻¹ : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : _) * ((u : _) * x) := by
              rw [← mul_assoc, Units.inv_mul, one_mul]
        _ = _ := by rw [hx1, mul_one]
    rw [← hxe]; exact hx
  apply Set.Subset.antisymm
  · rintro _ ⟨x, hx, rfl⟩
    dsimp only
    rw [smul_eq_mul]
    exact finiteAdeleBox_mul_mem hR (hSR huS) hx
  · intro x hx
    refine ⟨((u⁻¹ : (ℍ[ℚ, a, b] ⊗[ℚ] FiniteAdeleRing (𝓞 ℚ) ℚ)ˣ) : _) * x,
      finiteAdeleBox_mul_mem hR (hSR huinvS) hx, ?_⟩
    dsimp only
    rw [smul_eq_mul, ← mul_assoc, Units.mul_inv, one_mul]

