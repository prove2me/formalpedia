    centerALowerYBox.Contains (Y (lower E8TAxisProd0114PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0114PaddedInputs.centerAInput.alpha = ((4115470352964345628383522602588716836376840310 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
