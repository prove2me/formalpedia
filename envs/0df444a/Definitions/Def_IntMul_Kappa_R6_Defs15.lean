-- Source module: Solutions.R6CrtNeed
/-!
# CRT reversal §12: **`CrtNeed6`**

`crtNeed6 : ∀ P, P.Ok → CrtNeed6 P`.

The table is `mTab4 tab ext₁ ext0 ext0 ext0 own` with `ext₁` the table of `IL.SwapNeedτ tab P.τ`
and `own = [phiFE, phiBE]` (KFUU's uniform `Φ`, `Φ⁻¹` with the reversal `revE`, whose phase 2 uses
three composite swaps of `h⌊d/2⌋`-bit digits and six digit-selector rotation sets instead of
KFUU's `⌊d/2⌋` single-digit swaps). `RowUCP` is not used.

Cost: `c ≤ C₀ · T p · Ncost6` with `A = 0`, from

* the frozen part (`natCost`, `O((d+1) T p)` once `d + 1 ≤ 2^h`),
* the rest of `p2E` (`O((d+1) T p)` once `d + 1 ≤ 2^h` and `T ≥ poly(b)`),
* three composite swaps, each `≤ K (4 T p ℓ (d ln p)^τ + 96 T p)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6

open IntMul NLogN NLogN.KIL NLogN.KFB NLogN.KFM AModel NLogN.KFUU NLogN.KFUU.R6Crt NLogN.KFU

noncomputable section

/-! ## Parameter facts -/

/-! ## Eventual sizes -/

/-- The pointwise conditions used by the cost absorption. -/
structure CrtBig (P : Prm) (n : ℕ) : Prop where
  good : Good P n
  d2 : 2 ≤ dP6 P n
  l2 : 2 ≤ ℓP6 P n
  dh : dP6 P n + 1 ≤ 2 ^ hN6 P n
  T_big : (dP6 P n + 2) * (CU * (3 * pP6 P n + 1) ^ 2 + 15 * pP6 P n + 10 ^ 4) ≤ TP6 P n

/-! ## The cost absorption -/

/-- The constant. -/
def C0crt (K : ℝ) : ℝ := (C1 : ℝ) * 10 ^ 6 + 10 ^ 13 + 300 * K + 3

/-! ## The theorem -/

/-- Our two procedures, in the merged table `mTab4 tab ext₁ ext0 ext0 ext0 own`. -/
noncomputable def ownCrt (E₁ : ℕ) (entry : Fin (7 + E₁)) (sdS : Fin HS) :
    Fin 2 → IStmt HS (7 + (E₁ + 0 + 0 + 0 + 2)) := fun k =>
  if k.val = 0 then
    phiFE (KFM.pMul _) (g4₁ E₁ 0 0 0 2 entry) sdS (dscOf sdS)
  else phiBE (KFM.pMul _) (g4₁ E₁ 0 0 0 2 entry) sdS (dscOf sdS)

end

end IntMul.Kappa.R6

