    apply join (List.all_eq_true.mp mass_tests10)
    apply join (List.all_eq_true.mp mass_tests11)
    apply join (List.all_eq_true.mp mass_tests12)
    apply join (List.all_eq_true.mp mass_tests13)
    apply join (List.all_eq_true.mp mass_tests14)
    apply join (List.all_eq_true.mp mass_tests15)
    apply join (List.all_eq_true.mp mass_tests16)
    apply join (List.all_eq_true.mp mass_tests17)
    apply join (List.all_eq_true.mp mass_tests18)
    apply join (List.all_eq_true.mp mass_tests19)
    apply join (List.all_eq_true.mp mass_tests20)
    apply join (List.all_eq_true.mp mass_tests21)
    apply join (List.all_eq_true.mp mass_tests22)
    apply join (List.all_eq_true.mp mass_tests23)
    exact List.all_eq_true.mp mass_tests24
  intro m hm;obtain ⟨h,hc⟩ := Bool.and_eq_true_iff.mp (H m hm);exact ⟨h,List.all_eq_true.mp hc⟩

