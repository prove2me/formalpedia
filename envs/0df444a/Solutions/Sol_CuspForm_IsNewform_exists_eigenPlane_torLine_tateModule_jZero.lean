namespace ComponentScaling

variable {N q : ℕ} [NeZero N] [Fact q.Prime] {hqN : ¬ q ∣ N} {A : ValuationSubring (AlgebraicClosure ℚ)}
  {hA : A.LiesOverPrime q} (𝒟 : SemistableToricDatum.ToricDatum N q hqN A hA)

attribute [local instance] SemistableToricDatum.ToricDatum.instAddCommGroupΦ SemistableToricDatum.ToricDatum.instFiniteΦ

theorem card_smul_mem_fin (m : ℕ) (x : JZero (N * q))
    (hx : x ∈ inertiaInvariantTorsion (N * q) A m) : Nat.card 𝒟.Φ • x ∈ 𝒟.fin m := by

  have hfP : x ∈ 𝒟.finPart m := 𝒟.invariants_le_finPart m hx

  have hfP' : Nat.card 𝒟.Φ • x ∈ 𝒟.finPart m := nsmul_mem hfP (Nat.card 𝒟.Φ)

  have hspec0 : 𝒟.spec m ⟨Nat.card 𝒟.Φ • x, hfP'⟩ = 0 := by
    have heq : (⟨Nat.card 𝒟.Φ • x, hfP'⟩ : ↥(𝒟.finPart m))
        = Nat.card 𝒟.Φ • (⟨x, hfP⟩ : ↥(𝒟.finPart m)) := rfl
    rw [heq, map_nsmul]
    exact card_nsmul_eq_zero'

  exact (𝒟.spec_ker m ⟨Nat.card 𝒟.Φ • x, hfP'⟩).mp hspec0

