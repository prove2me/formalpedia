  have hKeep0 := queueKeepProcedure_spec b P E (pc + 1679) QB out0 cap T gs g0 m2 hKeep0At
    (by omega) hwe hcapPos hQB hlo0 hQWord hword0 hroom.1 hdisj0 hgs2 hstored0 hG0 hm284 hm290 hp2.capacity h970
  obtain ⟨_, k3, z3, hRun3, hPc3, hCost3, hRegs3, hCount3, hQueue3, hf23raw⟩ := hKeep0
  let m3 := z3.mem
