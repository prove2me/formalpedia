    [TopologicalSpace O] [IsTopologicalRing O] [CompactSpace O] [T2Space O]
    [SecondCountableTopology O] [MeasurableSpace O] [BorelSpace O]
    (htop : IsAdic (IsLocalRing.maximalIdeal O)) (n : ℕ)
    (v : Fin (n + 1) → IsLocalRing.ResidueField O) (hv : v ≠ 0) :
    MeasurableSet (TypeDensity.projectiveCell O n v) ∧
      TypeDensity.coefficientMeasure O (n+1) (TypeDensity.projectiveCell O n v) =
        ((Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞) - 1) *
          (Nat.card (IsLocalRing.ResidueField O) : ℝ≥0∞)⁻¹ ^ (n+1) := by
  obtain ⟨hcard, hne, hfin⟩ := TypeDensity.scalar_class_card (IsLocalRing.ResidueField O) n v hv
  set S := hfin.toFinset with hS
  have heq : TypeDensity.projectiveCell O n v = ⋃ w ∈ S, {a : Fin (n+1) → O | residueVector O a = w} := by
    ext a
    simp only [TypeDensity.projectiveCell, Set.mem_ofPred_eq, Set.mem_iUnion, hS, Set.Finite.mem_toFinset,
      exists_prop, exists_eq_right']
    exact ⟨fun h => h.2, fun h => ⟨(TypeDensity.primitive_iff_residue_ne_zero O n a).2 (hne _ h), h⟩⟩
  have hmeas : ∀ w ∈ S, MeasurableSet {a : Fin (n+1) → O | residueVector O a = w} :=
    fun w _ => (TypeDensity.residue_vector_fiber_mass O htop n w).1
  refine ⟨heq ▸ Finset.measurableSet_biUnion S hmeas, ?_⟩
  rw [heq, MeasureTheory.measure_biUnion_finset _ hmeas]
  · simp only [fun w => (TypeDensity.residue_vector_fiber_mass O htop n w).2]
    rw [Finset.sum_const, nsmul_eq_mul]
    congr 1
    have : S.card = Nat.card (IsLocalRing.ResidueField O) - 1 := by
