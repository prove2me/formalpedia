namespace OAI.JointLogSeparation
theorem _root_.solution (t : ℝ) : (logPhase t).HasTemperateGrowth := by
  let c : ℂ := ((2 * Real.pi * t : ℝ) : ℂ) * Complex.I
  have hd (x : ℝ) : HasDerivAt (logPhase t) (c * logPhase t x) x := by
    have h := ((Complex.ofRealCLM.hasDerivAt (x := x)).const_mul c).cexp
    simp only [Complex.ofRealCLM_apply, Complex.ofReal_one, mul_one] at h
    have he (y : ℝ) : Complex.exp (c * (y : ℂ)) = logPhase t y := by
      unfold c logPhase
      congr 1
      push_cast
      ring
    simp_rw [he] at h
    simpa only [mul_comm] using h
  have hi (n : ℕ) : iteratedDeriv n (logPhase t) = fun x => c ^ n * logPhase t x := by
    induction n with
    | zero => funext x; simp
    | succ n ih =>
      rw [iteratedDeriv_succ, ih]
      funext x
      rw [show deriv (fun y => c ^ n * logPhase t y) x =
          c ^ n * (c * logPhase t x) from ((hd x).const_mul _).deriv]
      simp only [pow_succ]
      ring
  refine ⟨?_, fun n => ⟨0, ‖c‖ ^ n, ?_⟩⟩
  · unfold logPhase
    exact ((Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul contDiff_const).cexp
  · intro x
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hi]
    simp only [norm_mul, norm_pow, logPhase_norm, mul_one, pow_zero, le_refl]
end OAI.JointLogSeparation
