/-- Lower bounds of `Ncost`. -/
theorem Ncost_ge {p d K ℓ α : ℝ} (hp : 1 ≤ p) (hd : 1 ≤ d) (hK : 0 ≤ K) (hℓ : 0 ≤ ℓ)
    (hα : 0 ≤ α) :
    d * K + p * K ^ (τ - 1) + ℓ * d ^ lam' + (ℓ + Real.logb 2 p + 1) ≤ Ncost p d K ℓ α := by
  unfold Ncost
  have h0 : 0 ≤ ℓ ^ τ := Real.rpow_nonneg hℓ _
  have h1 : 0 ≤ d ^ 2 * (1 + ℓ ^ τ) := by positivity
  have hp0 : 0 ≤ p := by linarith
  have hd0 : 0 ≤ d := by linarith
  have h2 : 0 ≤ d * p ^ (1 / 2 + δ) * α :=
    mul_nonneg (mul_nonneg hd0 (Real.rpow_nonneg hp0 _)) hα
  have h3 : 0 ≤ d * p ^ δ := mul_nonneg hd0 (Real.rpow_nonneg hp0 _)
  have h4 : 0 ≤ p ^ δ := Real.rpow_nonneg hp0 _
  linarith

