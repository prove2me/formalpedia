-- Source module: Solutions.R6P18Par
/-!
# Round six, Proposition 18: the numeric side conditions at the round-six parameters

`Par6 P Ew K₀ n` collects every numeric hypothesis of the Proposition 18 program (the frozen
`Par18Need` list with `D = d - 1`, `K = ℓ - 1`, `p = pP6`) together with the guard bound
`Ew D ≤ p + 2` and the three size hypotheses of `IL3.P14NeedH'` (constant `K₀`, at `D = d - 1`).
**`par6`**: they all hold for large `n` (for `P.Ok`, a guard with `EwOK6 P Ew`, any `K₀`).

Every condition is "polynomial in `b` below `2^K`" (**`big_K`**: `b ≤ (2ℓ)^m`), except the guard
(`ε C₁ < 1 + x`) and `P14NeedH'` (3) (`IL3.p14_hyps_r6`, i.e. `ε (2 - lamp) < 1`).
-/

set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.P18

open IntMul NLogN Real IntMul.Kappa.R6.IL3

noncomputable section

/-- **The numeric side conditions of Proposition 18 at round six.** -/
structure Par6 (P : Prm) (Ew : ℕ → ℕ) (K₀ : ℕ) (n : ℕ) : Prop where
  good : Good P n
  b64 : 64 ≤ bP6 n
  d3 : 3 ≤ dP6 P n
  K6 : 6 ≤ KP6 P n
  Kl : KP6 P n + 1 = ℓP6 P n
  c3 : 80 * ((dP6 P n - 1) * ℓP6 P n + ℓP6 P n + 8) *
    ((dP6 P n - 1) * ℓP6 P n + ℓP6 P n + 8 + 2) ≤ 2 ^ KP6 P n
  p7 : 2 * pP6 P n + 7 < 2 ^ KP6 P n
  c8 : 2 * (2 * ((dP6 P n - 1) * ℓP6 P n + ℓP6 P n + 8) + 4) ^ 3 + 2 ≤ 2 ^ KP6 P n
  c9 : (KP6 P n * (dP6 P n - 1) + 11) * ((dP6 P n - 1) * ℓP6 P n + ℓP6 P n + 8 + 2) ≤
    2 ^ KP6 P n
  ov : ∀ B ≤ pP6 P n + 2 + ((dP6 P n - 1) * ℓP6 P n + ℓP6 P n + 8) + (dP6 P n - 1) * ℓP6 P n +
    (dP6 P n - 1) + 1, 10 ^ 12 * (B + 2) ^ 3 + 16 * KFUU.cU B ≤ 2 ^ KP6 P n
  err : 2 * 2 ^ ((dP6 P n - 1) * ℓP6 P n) * (3 * ℓP6 P n + 1) ≤ 2 ^ (pP6 P n / 2)
  Dl : (dP6 P n - 1) * ℓP6 P n ≤ bP6 n + bP6 n
  bp : bP6 n ≤ b'P6 P n
  ew : Ew (dP6 P n - 1) ≤ b'P6 P n
  n1 : ∀ N : ℕ, N < 2 ^ (6 * bP6 n) → zsz (N : ℤ) ≤ pP6 P n
  n2 : (pP6 P n + K₀) ^ 5 ≤ 2 ^ KP6 P n
  n3 : ((K₀ * (dP6 P n - 1) * (zsz (pP6 P n : ℤ) + 1) : ℕ) : ℝ) ≤
    KP6 P n * ((dP6 P n - 1 : ℕ) : ℝ) ^ P.lamp

end

end IntMul.Kappa.R6.P18

end

section
-- Source module: Solutions.R6P18Cost
/-!
# Round six, Proposition 18: the cost

**`total6`**: the exact cost of a call of the Proposition 18 entry of `ext6` (setup, core with the
layout programs, Lemma 16 procedures with the round-six chunk cost `cChunk6`, teardown).
**`cost6`**: for every choice of the constants of the Proposition 14 call, the swap and the setup,
`total6 ≤ C · cU6 P n 1` whenever the side conditions `Par6` hold and the input has
`∏ t_i · r = T` records. The rows: layout `d`, rounds `ℓ + d`, chunk calls
`ℓ d^lamp (zsz p + 1)`, Kronecker products `(ℓ + log₂ p + 1)(ln p + 1)`, setup and moves `O(1)`
(all per bit, against `Ncost6 · (log lg n + 1)`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFV.R6P

open IntMul RS KIL KFD KFB KFH KFC KFT Synth AModel AModelL12 GlueLayout GlueP14 GlueError
open IntMul.Kappa.R6 IntMul.Kappa.R6.P18

/-- **The exact cost of a Proposition 18 call** (round six). -/
noncomputable def total6 (C₀ lamp Kc : ℝ) (Cs p ℓ K : ℕ) (ts : List ℕ) [NeZero ts.length] : ℕ :=
  let D := ts.length
  let lg := long18 ℓ ts
  let n := n18 ℓ K ts
  let B := B18 p ℓ K ts
  let U := U18 ℓ K ts
  let cCh := cChunk6 D ℓ K lg (p + 2) B C₀ lamp p
  cSet18 Cs p ℓ K ts +
    (cCore18 (cLayIn D ℓ K lg Kc n (p + 2) B + cFwd D ℓ K lg (p + 2) B cCh U)
      (cOpp D ℓ K lg (p + 2) B cCh U + cLayOut D ℓ K lg Kc n (p + 2) B)
      n ℓ p B (BK18 p ℓ K ts) (φ18 p ℓ) + cSet18 Cs p ℓ K ts) + 2

end NLogN.KFV.R6P

end

section
-- Source module: Solutions.R6FineIdx
/-!
# Fine-bit exposure §1: index lemmas and the stage lists

The data `xs = gflat zs` of shape `S = [a, N, y, 2]` (`N = 2^f`) is moved one bit of the
`N` axis at a time.

* `gF L`: the stage address `[i, h, r, l, c]` of `[a, H, y, L, 2]` (`H L = N`, the `l` axis holds
  the bits already moved behind `y`) reads `[i, h L + l, r, c]` of `S`.
  **`stepF`**: one `mvFU` move (`A = [a, H]`, `F = [2]`, `G = [y]`, `C = [L, 2]`) takes stage
  `(2H, L)` to stage `(H, 2L)`. **`stF_zero`**, **`stF_end`**: the stage `(N, 1)` is `xs`, the
  stage `(1, N)` is `gflat (blkT N y a zs)`.
* `gB L`: the same for `S = [a, y, N, 2]`, the stage `[a, H, y, L, 2]` reading `[i, r, h L + l, c]`.
  **`stepB`** (`mvBU`, `A = [a, H]`, `F = [y]`, `G = [2]`, `C = [L, 2]`): stage `(H, 2L)` to
  stage `(2H, L)`. **`stB_zero`**, **`stB_end`**.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFUU.R6Fine

open IntMul AModel NLogN.KFB IntMul.Kappa.R6

/-! ## Generic pull facts -/

/-! ## The stage maps -/

/-- Forward stage map: `[i, h, r, l, c] ↦ [i, h L + l, r, c]`. -/
def gF (L : ℕ) (b : List ℕ) : List ℕ :=
  [b.getD 0 0, b.getD 1 0 * L + b.getD 3 0, b.getD 2 0, b.getD 4 0]

/-- Backward stage map: `[i, h, r, l, c] ↦ [i, r, h L + l, c]`. -/
def gB (L : ℕ) (b : List ℕ) : List ℕ :=
  [b.getD 0 0, b.getD 2 0, b.getD 1 0 * L + b.getD 3 0, b.getD 4 0]

/-- The forward stage `(H, L)` of `xs` (shape `[a, N, y, 2]`). -/
def stF (a N y H L : ℕ) (xs : List ℤ) : List ℤ := pull [a, N, y, 2] [a, H, y, L, 2] (gF L) 0 xs

/-- The backward stage `(H, L)` of `xs` (shape `[a, y, N, 2]`). -/
def stB (a N y H L : ℕ) (xs : List ℤ) : List ℤ := pull [a, y, N, 2] [a, H, y, L, 2] (gB L) 0 xs

@[simp] theorem length_stF (a N y H L : ℕ) (xs : List ℤ) :
    (stF a N y H L xs).length = vol [a, H, y, L, 2] := by simp [stF]

@[simp] theorem length_stB (a N y H L : ℕ) (xs : List ℤ) :
    (stB a N y H L xs).length = vol [a, H, y, L, 2] := by simp [stB]

