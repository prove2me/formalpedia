namespace NLogN.Rsp

open IntMul NLogN RS

theorem rn_inv_upd (σ : Equiv.Perm (Fin HS)) (τ : IState HS) (i : Fin HS) (L : List Item) :
    ((τ.rn σ⁻¹).upd i L).rn σ = τ.upd (σ i) L := by
  rw [IState.rn_upd, IState.rn_rn_inv]

/-- `permP` relocated by `σ`. -/
theorem permR_spec (σ : Equiv.Perm (Fin HS)) (hσ : FixHi σ) (d n kb B : ℕ) (Kl : List ℕ)
    (D : List (List ℤ)) (Rest RK : List Item) (τ : IState HS) (hKl : Kl.length = n)
    (hK : Kl.Perm (List.range n)) (hD : D.length = n) (hDw : ∀ r ∈ D, r.length = d)
    (hN : n ≤ 2 ^ kb) (L1 L2 : List Item)
    (h0 : τ.G (σ 0) = ints D.flatten ++ Rest) (h1 : τ.G (σ 1) = .int n :: L1)
    (h2 : τ.G (σ 2) = .int kb :: L2) (h3 : τ.G (σ 3) = natInts Kl ++ RK)
    (hDB : ∀ r ∈ D, Bnd B r) :
    ((permP d).ren σ).ok τ ∧
      ((permP d).ren σ).run τ = τ.upd (σ 0) (ints (permL Kl D).flatten ++ Rest) ∧
      ((permP d).ren σ).cost τ ≤ 10 ^ 6 * (kb + 1) * (n + 1) * (d + 1) * (B + kb + d + 4) := by
  have e : τ = (τ.rn σ⁻¹).rn σ := (IState.rn_rn_inv σ τ).symm
  have g0 : (τ.rn σ⁻¹).G 0 = ints D.flatten ++ Rest := by rw [rn_inv_G, h0]
  have g1 : (τ.rn σ⁻¹).G 1 = .int n :: L1 := by rw [rn_inv_G, h1]
  have g2 : (τ.rn σ⁻¹).G 2 = .int kb :: L2 := by rw [rn_inv_G, h2]
  have g3 : (τ.rn σ⁻¹).G 3 = natInts Kl ++ RK := by rw [rn_inv_G, h3]
  have hs := permP_spec d n kb Kl D Rest RK (τ.rn σ⁻¹) hKl hK hD hDw hN L1 L2 g0 g1 g2 g3
  have hc := permP_cost d n kb B Kl D Rest RK (τ.rn σ⁻¹) hKl hK hD hDw hN L1 L2 g0 g1 g2 g3 hDB
  refine ⟨?_, ?_, ?_⟩
  · rw [e, RS.ok_ren hσ]; exact hs.1
  · rw [e, RS.run_ren, hs.2, rn_inv_upd, IState.rn_rn_inv]
  · rw [e, RS.cost_ren]; exact hc

theorem σs_fix : FixHi σs := swapsPerm_fixHi _ rfl

theorem σs_vals : σs 0 = CU ∧ σs 1 = 1 ∧ σs 2 = 2 ∧ σs 3 = KS := by decide +kernel

theorem gints_recs (V : List (ℤ × ℤ)) : ints (V.map gRec).flatten = gints V := by
  rw [gRecs_flatten, gints_eq_ints']

theorem gRecs_w (V : List (ℤ × ℤ)) : ∀ r ∈ V.map gRec, r.length = 2 := by
  intro r hr; simp only [List.mem_map] at hr; obtain ⟨z, _, rfl⟩ := hr; rfl

end NLogN.Rsp

end

section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.Rsp
open IntMul NLogN RS
theorem solution (s t kb : ℕ) (hs : 0 < s) (hco : Nat.Coprime t s) (hkb : s ≤ 2 ^ kb)
    (W : List (ℤ × ℤ)) (hW : W.length = s) (τ : NLogN.IState NLogN.HS) (RU : List NLogN.Item)
    (hU : τ.G NLogN.Rsp.CU = NLogN.gints W ++ RU) (h2 : ∃ L, τ.G 2 = .int (kb : ℤ) :: L)
    (hk : ∃ R, τ.G NLogN.Rsp.KS = NLogN.natInts (NLogN.Rsp.psKeys s t) ++ R) (hps : ∃ L, τ.G NLogN.Rsp.PS = .int (s : ℤ) :: L) (B : ℕ)
    (hB : ∀ z ∈ W, NLogN.zsz z.1 ≤ B ∧ NLogN.zsz z.2 ≤ B) (hsB : NLogN.zsz (s : ℤ) ≤ B) :
    NLogN.Rsp.psP.ok τ ∧ NLogN.Rsp.psP.run τ = τ.upd NLogN.Rsp.CU (NLogN.gints (NLogN.Rsp.psL s t W) ++ RU) ∧
      NLogN.Rsp.psP.cost τ ≤ 2 * 2000 * (B + 2) +
        10 ^ 6 * (kb + 1) * (s + 1) * (2 + 1) * (B + kb + 2 + 4) + (2 * B + 2) := by
  obtain ⟨L2, h2⟩ := h2; obtain ⟨R3, h3⟩ := hk; obtain ⟨Lp, hp⟩ := hps
  obtain ⟨e0, e1, e2, e3⟩ := NLogN.Rsp.σs_vals
  have hK := (NLogN.Rsp.psKeys_spec s t hs hco []).1
  rw [NLogN.Rsp.psKeys_length] at hK
  have hev : (NLogN.Ex.reg NLogN.Rsp.PS : NLogN.Ex NLogN.HS).eval τ = s := by simp (config := {decide := true}) [NLogN.Ex.eval, NLogN.IState.top, hp]
  set τ1 := τ.upd 1 (.int (s : ℤ) :: τ.G 1) with hτ1
  have r1 : (NLogN.RS.push 1 (.reg NLogN.Rsp.PS)).run τ = τ1 := NLogN.Rsp.push_run_v 1 _ τ _ hev
  have h := NLogN.Rsp.permR_spec NLogN.Rsp.σs NLogN.Rsp.σs_fix 2 s kb B (NLogN.Rsp.psKeys s t) (W.map NLogN.Rsp.gRec) RU R3 τ1 (NLogN.Rsp.psKeys_length s t)
    hK (by simp (config := {decide := true}) [hW]) (NLogN.Rsp.gRecs_w W) hkb (τ.G 1) L2 (by rw [e0, hτ1]; simp (config := {decide := true}) [hU, NLogN.Rsp.gints_recs])
    (by rw [e1, hτ1]; simp (config := {decide := true})) (by rw [e2, hτ1]; simp (config := {decide := true}) [h2]) (by rw [e3, hτ1]; simp (config := {decide := true}) [h3])
    (by intro r hr x hx; simp only [List.mem_map] at hr; obtain ⟨z, hz, rfl⟩ := hr
        simp only [NLogN.Rsp.gRec, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl | rfl
        · exact (hB z hz).1
        · exact (hB z hz).2)
  rw [e0, NLogN.Rsp.permL_psKeys s t hs hco W hW, NLogN.Rsp.gints_recs] at h
  have g1 : (τ1.upd NLogN.Rsp.CU (NLogN.gints (NLogN.Rsp.psL s t W) ++ RU)).G 1 = .int (s : ℤ) :: τ.G 1 := by
    rw [hτ1]; simp (config := {decide := true})
  have r3 := NLogN.Rsp.pop_run_v 1 _ _ _ g1
  have hpc : (NLogN.RS.push 1 (.reg NLogN.Rsp.PS)).cost τ ≤ 2 * 2000 * (B + 2) := by
    have := NLogN.RS.pushCost_le_lin (.reg NLogN.Rsp.PS) τ B (by simp (config := {decide := true}) [NLogN.Ex.Lin]) (by simpa [NLogN.Ex.Bnd, NLogN.IState.top, hp] using hsB)
    simpa [NLogN.RS.cost, NLogN.Ex.size] using this
  refine ⟨?_, ?_, ?_⟩
  · simp only [NLogN.Rsp.psP, NLogN.RS.ok, NLogN.RS.run_seq, r1, h.2.1]
    exact ⟨⟨by decide, NLogN.RS.clean_of_lt (by decide), NLogN.IState.isInt_of hp⟩, h.1, by decide,
      NLogN.IState.isInt_of g1⟩
  · simp only [NLogN.Rsp.psP, NLogN.RS.run_seq, r1, h.2.1, r3]
    refine NLogN.IState.ext' (fun x => ?_) (by simp [hτ1]) (by simp [hτ1])
    by_cases hx : x = 1
    · subst hx; simp (config := {decide := true}) [hτ1]
    · by_cases hc : x = NLogN.Rsp.CU
      · subst hc; simp (config := {decide := true}) [hτ1]
      · simp (config := {decide := true}) [hτ1, hx, hc]
  · simp only [NLogN.Rsp.psP, NLogN.RS.cost_seq', NLogN.RS.run_seq, r1, h.2.1]
    have hpop : (NLogN.RS.pop 1).cost (τ1.upd NLogN.Rsp.CU (NLogN.gints (NLogN.Rsp.psL s t W) ++ RU)) ≤ 2 * B + 2 := by
      simp only [NLogN.RS.cost, NLogN.IState.top_eq g1]; omega
    have := h.2.2
    omega
end
