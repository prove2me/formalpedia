theorem solution {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    Tendsto (fun R : ℝ => R ^ 3 * (vfun j q r R - j / R ^ 2)) atTop
      (𝓝 (2 * sigmaB j q - r 0 / 3)) := by
