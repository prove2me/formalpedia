/-! ## `B_s` and its substitution identity -/

/-- The segment average `B_s(x) = (1/3)∫₀¹ AcK(x + t(a-x)) s(x + t(a-x)) dt`. -/
noncomputable def Bfun (j : ℝ) (q : ℝ → ℝ) (x : ℝ) : ℝ :=
  (1 / 3) * ∫ t in (0 : ℝ)..1, AcK (x + t * (aG - x)) * sfun j q (x + t * (aG - x))

/-! ## `k_s` and its endpoint values -/

/-- `k_s(x) = x B_s(x)/((1 - x) AcK(x)²)`. -/
noncomputable def kfun (j : ℝ) (q : ℝ → ℝ) (x : ℝ) : ℝ :=
  x * Bfun j q x / ((1 - x) * AcK x ^ 2)

/-! ## `F_s(t) = AcK(t) s(t)`, and `B_s` as a quotient -/

/-- The integrand `F_s(t) = AcK(t) · s(t)`. -/
noncomputable def Ffun (j : ℝ) (q : ℝ → ℝ) (t : ℝ) : ℝ := AcK t * sfun j q t

/-! ## Continuity of `B_s` and `k_s` on `[0, b]` for `b < 1/3` -/

/-! ## `b_s` -/

/-- `K_s(R) = ∫₀^(1/R) k_s`. -/
noncomputable def Kfun (j : ℝ) (q : ℝ → ℝ) (R : ℝ) : ℝ :=
  ∫ t in (0 : ℝ)..(1 / R), kfun j q t

/-- `b_s(R) = -Y(R) K_s(R)`. -/
noncomputable def bfun (j : ℝ) (q : ℝ → ℝ) (R : ℝ) : ℝ :=
  -Y R * Kfun j q R

/-! ## `AcK(1/R) = aY R` -/

/-! ## The two integral representations of `P Y² (b/Y)'` -/

/-- `∫₃ᴿ Y(t) s(1/t)/t³ dt`. -/
noncomputable def Ifun (j : ℝ) (q : ℝ → ℝ) (R : ℝ) : ℝ :=
  ∫ t in (3 : ℝ)..R, Y t * sfun j q (1 / t) / t ^ 3

/-- `∫_{1/R}^{a} AcK(t) s(t) dt`. -/
noncomputable def Hfun (j : ℝ) (q : ℝ → ℝ) (R : ℝ) : ℝ :=
  ∫ t in (1 / R)..aG, AcK t * sfun j q t

