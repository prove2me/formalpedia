private theorem law_eq_one_of_mul_self {B T : Scheme.{0}} {R : Type} [CommRing R]
    {f : B ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f) (t : T ⟶ Spec (CommRingCat.of R))
    (a : SchemeHomOver t f) (h : L.mul t a a = a) : a = L.one t := by
  calc a = L.mul t (L.one t) a := (L.one_mul t a).symm
    _ = L.mul t (L.mul t (L.inv t a) a) a := by rw [L.inv_mul_cancel]
    _ = L.mul t (L.inv t a) (L.mul t a a) := by rw [L.mul_assoc]
    _ = L.mul t (L.inv t a) a := by rw [h]
    _ = L.one t := L.inv_mul_cancel t a

private theorem law_eq_inv_of_mul_eq_one {B T : Scheme.{0}} {R : Type} [CommRing R]
    {f : B ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f) (t : T ⟶ Spec (CommRingCat.of R))
    (a b : SchemeHomOver t f) (h : L.mul t a b = L.one t) : b = L.inv t a := by
  calc b = L.mul t (L.one t) b := (L.one_mul t b).symm
    _ = L.mul t (L.mul t (L.inv t a) a) b := by rw [L.inv_mul_cancel]
    _ = L.mul t (L.inv t a) (L.mul t a b) := by rw [L.mul_assoc]
    _ = L.mul t (L.inv t a) (L.one t) := by rw [h]
    _ = L.inv t a := L.mul_one t _

private theorem law_inv_natural {B T T' : Scheme.{0}} {R : Type} [CommRing R]
    {f : B ⟶ Spec (CommRingCat.of R)} (L : RelativeGroupLaw R f) (t : T ⟶ Spec (CommRingCat.of R))
    (t' : T' ⟶ Spec (CommRingCat.of R)) (ψ : T' ⟶ T) (hψ : ψ ≫ t = t') (a : SchemeHomOver t f) :
    GoodReductionJacobian.schemeHomOverComp ψ hψ (L.inv t a) =
      L.inv t' (GoodReductionJacobian.schemeHomOverComp ψ hψ a) := by
  apply law_eq_inv_of_mul_eq_one
  rw [← L.mul_natural, L.mul_inv_cancel, L.one_natural]

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.pts_zero : O.pts 0 = O.L.one (genPt p) := by
  apply law_eq_one_of_mul_self
  rw [← O.pts_add, add_zero]

p2m_export "ModularCurve.JZeroNeronObjectAtP" "pts_zero"
theorem pts_neg (x : JZero (N₀ * p)) : O.pts (-x) = O.L.inv (genPt p) (O.pts x) := by
  apply law_eq_inv_of_mul_eq_one
  rw [← O.pts_add, add_neg_cancel, pts_zero]

private theorem _root_.ModularCurve.JZeroNeronObjectAtP.ext_zero : O.Ext 0 := by
  rw [ext_iff]
  exact ⟨O.L.one Λ.σA, by rw [pts_zero, O.L.one_natural]⟩

p2m_export "ModularCurve.JZeroNeronObjectAtP" "ext_zero"
private theorem _root_.ModularCurve.JZeroNeronObjectAtP.ext_add {x y : JZero (N₀ * p)} (hx : O.Ext x) (hy : O.Ext y) : O.Ext (x + y) := by
  rw [ext_iff] at hx hy ⊢
  obtain ⟨s, hs⟩ := hx
  obtain ⟨s', hs'⟩ := hy
  exact ⟨O.L.mul Λ.σA s s', by rw [O.pts_add, hs, hs', O.L.mul_natural]⟩

p2m_export "ModularCurve.JZeroNeronObjectAtP" "ext_add"
private theorem _root_.ModularCurve.JZeroNeronObjectAtP.ext_neg {x : JZero (N₀ * p)} (hx : O.Ext x) : O.Ext (-x) := by
  rw [ext_iff] at hx ⊢
  obtain ⟨s, hs⟩ := hx
  exact ⟨O.L.inv Λ.σA s, by rw [pts_neg, hs, law_inv_natural]⟩

