/-!
# B-line IL, `J` pre-table (B5-J), `jTab` part D5: the inner loops of `serP`

`Rn.czL` (border scan), `Rn.wbL` (band-window count), `Rn.cbL` (band-window push),
`Rn.cnL` (forward-window count), `Rn.fsL` (forward push): each as an `Rn` of a `forL` on
stack `51`, pushing its list (reversed) onto `41`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem frm_trans {A B C : List (Fin HS)} {u w w' : Vr} (h1 : ∀ i ∉ A, w i = u i)
    (h2 : ∀ i ∉ B, w' i = w i) (hA : ∀ i ∈ A, i ∈ C) (hB : ∀ i ∈ B, i ∈ C) :
    ∀ i ∉ C, w' i = u i := fun i hi => by
  rw [h2 i (fun h => hi (hB i h)), h1 i (fun h => hi (hA i h))]

theorem frm_upd {A : List (Fin HS)} {u w : Vr} (h : ∀ i ∉ A, w i = u i) {j : Fin HS} (hj : j ∈ A)
    (a : ℤ) : ∀ i ∉ A, update w j a i = u i := fun i hi => by
  rw [update_of_ne (by rintro rfl; exact hi hj)]; exact h i hi

theorem Fx.frm {Q kk m mw cB : ℕ} {A : List (Fin HS)} {u w : Vr} (h : Fx Q kk m mw cB u)
    (hf : ∀ i ∉ A, w i = u i) (hA : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), j ∉ A) :
    Fx Q kk m mw cB w := h.of (fun j hj => hf j (hA j hj))

theorem StS.upd {m : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {c : Cs} (h : StS m L Mf c) {j : Fin HS}
    (hj : j ≠ 14 ∧ j ≠ 30) (l : List ℤ) : StS m L Mf (update c j l) :=
  ⟨by rw [update_of_ne (Ne.symm hj.1)]; exact h.1, by rw [update_of_ne (Ne.symm hj.2)]; exact h.2⟩

theorem cnt_gt_le (p : ℕ → Prop) [DecidablePred p] {r : ℕ} (hp : ∀ q, p q → r < q) :
    ∀ m, ((List.range m).filter (fun q => p q)).length ≤ m - 1 - r
  | 0 => by simp
  | m + 1 => by
    have ih := cnt_gt_le p hp m
    rw [List.range_succ, List.filter_append, List.length_append]
    by_cases h : p m
    · have := hp m h; simp [h]; omega
    · simp [h]; omega

theorem cnt_succ (p : ℕ → Prop) [DecidablePred p] (k : ℕ) :
    (((List.range (k + 1)).filter (fun q => p q)).length : ℤ) =
      (((List.range k).filter (fun q => p q)).length : ℤ) + (if p k then 1 else 0) := by
  rw [List.range_succ, List.filter_append, List.length_append]
  by_cases h : p k <;> simp [h]

theorem cnt_le_self (p : ℕ → Prop) [DecidablePred p] (k : ℕ) :
    ((List.range k).filter (fun q => p q)).length ≤ k := by
  have := List.length_filter_le (fun q => decide (p q)) (List.range k); simpa using this

theorem wbN_le (m mw : ℕ) (L : List ℕ) (r : ℕ) : wbN m mw L r ≤ m - 1 - r :=
  cnt_gt_le _ (fun q h => h.1) m

end J6Seg.PJ

