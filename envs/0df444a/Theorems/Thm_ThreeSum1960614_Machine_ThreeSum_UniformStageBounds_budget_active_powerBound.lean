theorem ThreeSum1960614.Machine.ThreeSum.UniformStageBounds.budget_active_powerBound (k : ℕ) :
    _root_.ThreeSum1960614.Machine.ThreeSum.StageBounds.PowerBound (_root_.ThreeSum1960614.Machine.ThreeSum.StageBounds.activeCount (_root_.ThreeSum1960614.Machine.ThreeSum.UniformStageBounds.falseBudget k))
      (2 - _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.epsilon * (1 / 2 - _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.bandShift - _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.kappa - _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.entropyRatio * (1 + _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.boxSaving - 2 * _root_.ThreeSum1960614.Machine.ThreeSum.Parameters.bandShift))) := by sorry
