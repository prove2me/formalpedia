-- title:
--   Simple types, applicative terms, deterministic higher-order recursion schemes, typing, order and safety
-- statement:
--   **Simple types** are generated by the ground type $o$ and the right-associative arrow $\sigma\to\tau$. Every type has the form $\sigma_1\to\cdots\to\sigma_r\to o$. The **order** is
--   $$\operatorname{ord}(o)=0,\qquad \operatorname{ord}(\sigma\to\tau)=\max\{\operatorname{ord}(\sigma)+1,\operatorname{ord}(\tau)\}.$$
--   A terminal of arity $r$ has type $o^r\to o$.
--
--   1. **Terms.** Applicative terms are $t::=x\mid F\mid a\mid t\,t$ (parameters, nonterminals, terminals, application). There is no $\lambda$-abstraction.
--   2. **Schemes.** A deterministic higher-order recursion scheme (HORS) $G$ consists of a finite ranked alphabet $\Sigma$ (a list of arities), a finite list of typed nonterminals, a start symbol $S$, and exactly one rule $F\,x_1\cdots x_r\to t_F$ per nonterminal $F:\sigma_1\to\cdots\to\sigma_r\to o$, whose body $t_F$ is a term over the parameters $x_i:\sigma_i$, the terminals and the declared nonterminals.
--   3. **Validity.** $G$ is well formed when there is one rule per nonterminal, $S$ is declared with type $o$, and every body has type $o$ in the context of its parameters (type inference rejects ill-typed terms and undeclared references).
--   4. **Order of a scheme.** The maximum order of its nonterminal types.
--   5. **Safety** (Section 3, after Haddad et al., Definition 1). A type $\sigma_1\to\cdots\to\sigma_r\to o$ is **homogeneous** if every $\sigma_i$ is homogeneous and $\operatorname{ord}(\sigma_1)\ge\cdots\ge\operatorname{ord}(\sigma_r)$. A rule is safe if its nonterminal and all subterms of its body have homogeneous types, and every application operand $s$ (in $u\,s$) satisfies $\operatorname{ord}(s)\le\operatorname{ord}(x)$ for every rule parameter $x$ occurring in $s$. The function part $u$ carries no inequality of its own, and nonterminals are not parameters. A scheme is safe if all its rules are.
--   6. **Alphabets.** $\Sigma_0=\{z:0,a:1,b:3\}$ and $\Sigma_2=\{e:0,d:2\}$.
--
--   These objects are the syntax of the whole mission: every language, compiler and semantic statement is about schemes of this form.
--
--   **Formalization Note** Nonterminals, terminals and parameters are natural-number indices; parameter $x_{i+1}$ of a rule is `var i`. Validity, order and safety are Boolean syntax-directed checks. $\Sigma_0$ is the arity list `[0, 1, 3]` (terminal 0 is $z$, 1 is $a$, 2 is $b$) and $\Sigma_2$ is `[0, 2]` (0 is $e$, 1 is $d$). The types and schemes carry derived `Encodable` instances, which fix the natural-number codes of the input languages.
-- source:
--   Mingkun Xiao, Yixuan Sun, Tree Equivalence of Higher-Order Recursion Schemes Is Undecidable, STOC 2027 submission #421 (October 2026), source.pdf SHA-256 e875d09ced029e3f5cb114abba049e4a2b1bdaa9b064c98b0d71f2ec7451c7af, Section 3, printed p. 10 / PDF p. 12 (types, schemes, safety; order Equation (5), printed p. 5 / PDF p. 7); alphabets Σ₀, Σ₂ printed pp. 1, 3 / PDF pp. 3, 5

import Mathlib

namespace TreeEquivalenceHORS.Equivalence

/-! # Syntax of deterministic higher-order recursion schemes (Section 3, PDF p. 12 / printed p. 10)

Simple types, applicative terms, schemes, typing, validity, order and safety.
Every check here is a finite syntax-directed Boolean test. -/

/-- Simple types, generated by the ground type `o` and the arrow `σ → τ`
(right associative: `arr σ (arr τ ρ)` is `σ → τ → ρ`). -/
inductive Ty : Type where
  | o : Ty
  | arr : Ty → Ty → Ty
  deriving DecidableEq, Encodable, Repr

namespace Ty

/-- The order of a type, Equation (5): `ord(o) = 0`, `ord(σ → τ) = max(ord(σ) + 1, ord(τ))`. -/
def ord : Ty → ℕ
  | o => 0
  | arr σ τ => max (σ.ord + 1) τ.ord

/-- The curried argument types: `args (σ₁ → ⋯ → σᵣ → o) = [σ₁, …, σᵣ]`. -/
def args : Ty → List Ty
  | o => []
  | arr σ τ => σ :: τ.args

/-- `ofArgs [σ₁, …, σᵣ] = σ₁ → ⋯ → σᵣ → o`. -/
def ofArgs : List Ty → Ty
  | [] => o
  | σ :: l => arr σ (ofArgs l)

/-- Homogeneity (Section 3, Safety): `σ₁ → ⋯ → σᵣ → o` is homogeneous iff every `σᵢ` is
homogeneous and `ord(σ₁) ≥ ⋯ ≥ ord(σᵣ)`. Written recursively: `σ → τ` is homogeneous iff
`σ` and `τ` are, and the first argument type of `τ` (if any) has order at most `ord(σ)`. -/
def homog : Ty → Bool
  | o => true
  | arr σ τ => σ.homog && τ.homog &&
      (match τ with
       | o => true
       | arr σ' _ => decide (σ'.ord ≤ σ.ord))

end Ty

/-- The type `oʳ → o` of a terminal of arity `r`. -/
def termTy (r : ℕ) : Ty := Ty.ofArgs (List.replicate r Ty.o)

/-- Applicative terms `t ::= x | F | a | t t` (Section 3). Rule parameters are positional:
`var i` is the `i`-th parameter `xᵢ₊₁` of the enclosing rule; `nt F` is the `F`-th declared
nonterminal; `tm c` is the `c`-th terminal of the ranked alphabet. There is no λ-syntax. -/
inductive Tm : Type where
  | var : ℕ → Tm
  | nt : ℕ → Tm
  | tm : ℕ → Tm
  | app : Tm → Tm → Tm
  deriving DecidableEq, Encodable, Repr

namespace Tm

/-- Left-associated application `h t₁ ⋯ tₙ`. -/
def apps (h : Tm) (l : List Tm) : Tm := l.foldl Tm.app h

/-- Head and argument list: `spine (h t₁ ⋯ tₙ) = (h, [t₁, …, tₙ])` for `h` not an application. -/
def spine : Tm → Tm × List Tm
  | app t u => ((spine t).1, (spine t).2 ++ [u])
  | var i => (var i, [])
  | nt F => (nt F, [])
  | tm c => (tm c, [])

/-- The rule parameters occurring in a term. -/
def vars : Tm → List ℕ
  | var i => [i]
  | app t u => t.vars ++ u.vars
  | nt _ => []
  | tm _ => []

end Tm

/-- A deterministic higher-order recursion scheme (Section 3):
* `alphabet` — the finite ranked alphabet; terminal `c` has arity `alphabet[c]` and type `oʳ → o`;
* `nts` — the finite typed list of nonterminals; nonterminal `F` has type `nts[F]`;
* `rules` — exactly one rule per nonterminal: if `nts[F] = σ₁ → ⋯ → σᵣ → o`, the rule is
  `F x₁ ⋯ xᵣ → rules[F]`, where the body may use the parameters `var 0, …, var (r-1)`
  (distinct by construction, `xᵢ₊₁ : σᵢ₊₁`);
* `start` — the start symbol `S`, which must have type `o`. -/
structure HORS : Type where
  alphabet : List ℕ
  nts : List Ty
  rules : List Tm
  start : ℕ
  deriving DecidableEq, Encodable

namespace HORS

/-- Type inference for a term in the parameter context `ctx`, returning `none` for an ill-typed
term or an undeclared reference (parameter, nonterminal or terminal out of range). -/
def typeOf (G : HORS) (ctx : List Ty) : Tm → Option Ty
  | .var i => ctx[i]?
  | .nt F => G.nts[F]?
  | .tm c => (G.alphabet[c]?).map termTy
  | .app t u =>
      match G.typeOf ctx t, G.typeOf ctx u with
      | some (.arr σ τ), some σ' => if σ = σ' then some τ else none
      | _, _ => none

/-- The rule of nonterminal `F` is well formed: its body has type `o` in the context of its
parameters `x₁ : σ₁, …, xᵣ : σᵣ`, where `nts[F] = σ₁ → ⋯ → σᵣ → o`. -/
def ruleOK (G : HORS) (F : ℕ) : Bool :=
  match G.nts[F]?, G.rules[F]? with
  | some τ, some body => G.typeOf τ.args body == some Ty.o
  | _, _ => false

/-- Validity of a scheme: one rule per nonterminal, a start symbol of type `o`, and every rule
well typed with ground body and only declared references. -/
def valid (G : HORS) : Bool :=
  G.rules.length == G.nts.length && G.nts[G.start]? == some Ty.o &&
    (List.range G.nts.length).all G.ruleOK

/-- `G` is a well-formed scheme. -/
def Valid (G : HORS) : Prop := G.valid = true

/-- The order of a scheme: the maximum order of its nonterminal types. -/
def order (G : HORS) : ℕ := (G.nts.map Ty.ord).foldr max 0

/-- Safety of a body subterm (Section 3, following [HMOS17, Definition 1]): the subterm and all of
its subterms have homogeneous types, and at every application `u s` the operand `s` satisfies
`ord(s) ≤ ord(x)` for every rule parameter `x` occurring in `s`. The function part `u` has no
inequality of its own; nonterminals and terminals are not parameters. -/
def safeTm (G : HORS) (ctx : List Ty) : Tm → Bool
  | .app u s =>
      (match G.typeOf ctx (.app u s) with
       | some σ => σ.homog
       | none => false) &&
      G.safeTm ctx u && G.safeTm ctx s &&
      (match G.typeOf ctx s with
       | some σs => s.vars.all fun x =>
           match ctx[x]? with
           | some τx => decide (σs.ord ≤ τx.ord)
           | none => false
       | none => false)
  | t =>
      match G.typeOf ctx t with
      | some σ => σ.homog
      | none => false

/-- A rule is safe if its nonterminal type is homogeneous and its body is safe. -/
def ruleSafe (G : HORS) (F : ℕ) : Bool :=
  match G.nts[F]?, G.rules[F]? with
  | some τ, some body => τ.homog && G.safeTm τ.args body
  | _, _ => false

/-- A scheme is safe if all its rules are safe. -/
def Safe (G : HORS) : Prop := ((List.range G.nts.length).all G.ruleSafe) = true

end HORS

/-- The intermediate ranked alphabet `Σ₀ = {z : 0, a : 1, b : 3}`: terminal `0` is `z`,
terminal `1` is `a`, terminal `2` is `b`. -/
def sigma0 : List ℕ := [0, 1, 3]

/-- The final ranked alphabet `Σ₂ = {e : 0, d : 2}`: terminal `0` is `e`, terminal `1` is `d`. -/
def sigma2 : List ℕ := [0, 2]

end TreeEquivalenceHORS.Equivalence


