theorem hop₁ (g : Gen M ↑S) (w : ↥(Wpar ℤ_[p] M Hs)) :
    ((op₁ T p g • w : ↥(Wpar ℤ_[p] M Hs)) : H1 M Hs ℤ_[p]) = opFamily M Hs ↑S ℤ_[p] g (w : H1 M Hs ℤ_[p]) := by

  let f₁ : ↥(Wpar ℤ_[p] M Hs) →ₗ[ℤ_[p]] H1 M Hs ℤ_[p] :=
    (Wpar ℤ_[p] M Hs).subtype ∘ₗ Matrix.toLin IB.bp IB.bp (TC T ℤ_[p] g)
  let f₂ : ↥(Wpar ℤ_[p] M Hs) →ₗ[ℤ_[p]] H1 M Hs ℤ_[p] := (opFamily M Hs ↑S ℤ_[p] g).domRestrict (Wpar ℤ_[p] M Hs)
  have hf : f₁ = f₂ := by
    refine IB.bp.ext fun j => ?_
    show ((Matrix.toLin IB.bp IB.bp (TC T ℤ_[p] g) (IB.bp j) : ↥(Wpar ℤ_[p] M Hs)) : H1 M Hs ℤ_[p]) =
