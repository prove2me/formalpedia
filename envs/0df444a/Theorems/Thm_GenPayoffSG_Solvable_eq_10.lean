-- title:
--   Eq. (10), p. 19 — the expected fictitious hitting count E_σ[ζ_i(r, n, θ(r))] equals the probability of reaching Q between stage n and θ
-- statement:
--   Let $\Gamma$ be a stochastic game, $\sigma$ a strategy profile, $s$ an initial state and $i$ a player. Let $Q\subseteq H$ be a set of histories no one of which is an extension of another ($h\prec h'$ holds for no $h,h'\in Q$). Let $n\ge 2$ and let $\theta$ be a stopping time with values in $\mathbb N\cup\{\infty\}$ for the filtration $(\mathcal F^k)_k$ generated by the histories of each stage. With $\Lambda_i$ and $\zeta_i$ as in (8) and (9),
--   $$\mathbf E_\sigma\big[\zeta_i(r,n,\theta(r))\big]=\mathbf P_\sigma\big(r^k\in Q\text{ for some }k\in\{n,n+1,\dots,\theta(r)\}\big).\tag{10}$$
--   Here $\mathbf P_\sigma=\mathbf P_{s,\sigma}$ is the law of the run from the initial state $s$ and $r^k$ is the prefix of the run $r$ in stage $k$.
--
--   In the proof of Theorem 4.9, (10) with $\theta=\infty$ expresses the probability that a deviating player reaches a history where its minmax value is high as an expectation of the fictitious hitting count.
--
--   **Formalization Note** Both sides are in $[0,\infty]$ (`lintegral` and a measure value). Lean indices are shifted by one: $m_0=n-1\ge 1$, the Lean stopping time $\theta'$ is $\theta-1$ (with respect to `Filtration.piLE`, whose $m$-th σ-algebra is generated by the first $m+1$ coordinates, i.e. the paper's $\mathcal F^{m+1}$), and the event is that `frestrictLe m r` $\in Q$ for some $m$ with $m_0\le m\le\theta'(r)$. The hypothesis $Q\subseteq H$ is `Feasible`; prefix-freeness is stated as: if $q,q'\in Q$ and $q'$ extends $q$ then $q=q'$. The action in the summand of (9) is the action player $i$ takes at $r^{k-1}$ (see the definition item `ReachQ`).
-- source:
--   Flesch & Solan, Stochastic Games with General Payoff Functions, arXiv:2208.12096v1, p. 19, §4.4 Step 1, Eq. (10) (with (8), (9) on p. 18)

import Mathlib
import Definitions.Def_GenPayoffSG_Solvable_ReachQ

namespace GenPayoffSG.Solvable

open MeasureTheory ProbabilityTheory ENNReal

variable {I S : Type} [Fintype I] [DecidableEq I] [Nonempty I]
  [Countable S] [Nonempty S] {A : I → Type}
  [∀ i, Fintype (A i)] [∀ i, Nonempty (A i)] [∀ i, DecidableEq (A i)]

theorem eq_10 (G : Game I S A) (σ : Profile G) (s : S) (Q : Set (Σ n, Hist I S A n))
    (hQH : ∀ q ∈ Q, Feasible G q.2)
    (hQ : ∀ q ∈ Q, ∀ q' ∈ Q, Extends q.2 q'.2 → q = q')
    (i : I) (m₀ : ℕ) (hm₀ : 1 ≤ m₀)
    (θ : Run I S A → ℕ∞) (hθ : IsStoppingTime Filtration.piLE θ) :
    ∫⁻ r, fictCount G σ Q i r m₀ (θ r) ∂(playMeasure G σ 0 (initHist s)) =
      playMeasure G σ 0 (initHist s)
        {r | ∃ m : ℕ, m₀ ≤ m ∧ (m : ℕ∞) ≤ θ r ∧
          (⟨m, Preorder.frestrictLe m r⟩ : Σ k, Hist I S A k) ∈ Q} := by sorry

end GenPayoffSG.Solvable
