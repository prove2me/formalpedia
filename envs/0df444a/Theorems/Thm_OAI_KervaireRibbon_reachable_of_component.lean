-- title:
--   Components are reachable by forward steps
-- statement:
--   Let $\sigma,\theta$ be permutations of a finite set $D$. If $x$ and $y$ lie in the same component of the relation generated by the cycles of $\sigma$ and $\theta$, then $y$ is reachable from $x$ by finitely many forward steps:
--   $$
--   x\to\cdots\to y,\qquad\text{each step }d\mapsto\sigma d\text{ or }d\mapsto\theta d .
--   $$
--
--   Inverse steps are never needed, because permutations of finite sets have finite order.
-- source:
--   https://github.com/openai/math/blob/1581d4cbdd69a0faf34b2089614fe2a814316a6a/lean/OAI/GroupTheory/Kervaire/ComponentFibers.lean#L223-L240

import Mathlib
import Definitions.Def_Kervaire
import Definitions.Def_OAI_GroupTheory_Kervaire_Reductions
import Definitions.Def_OAI_GroupTheory_Kervaire_PermutationCycles
import Definitions.Def_OAI_GroupTheory_Kervaire_Components
import Definitions.Def_OAI_GroupTheory_Kervaire_Suppression
import Definitions.Def_OAI_GroupTheory_Kervaire_ComponentFibers

open OAI OAI.KervaireRibbon
open Equiv Equiv.Perm
open scoped Classical
variable {D : Type*} [Fintype D] [DecidableEq D]

omit [DecidableEq D] in
theorem OAI.KervaireRibbon.reachable_of_component (σ θ : Perm D) {x y : D} (h : components σ θ x y) :
    Relation.ReflTransGen (fun d f ↦ f = σ d ∨ f = θ d) x y := by sorry
