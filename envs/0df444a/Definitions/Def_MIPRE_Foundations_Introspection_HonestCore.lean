/-! # The honest Introspect and Sample measurements

These are the concrete measurements from the completeness proof in
`introspection.tex`. Every answer label is retained. Their products vanish on
unrealizable pairs of question labels; source PCC is only used for labels
generated by a common seed.
-/

noncomputable section

namespace MIPRE.Introspection.Honest

open Finset Matrix Classical
open scoped Kronecker
set_option linter.unusedSectionVars false

variable {F ι A : Type*} [Field F] [Fintype F] [DecidableEq F]
  [Fintype ι] [DecidableEq ι] [Fintype A] [DecidableEq A] {ℓ : ℕ}

/-- The first bit selects Sample rather than Introspect; the second is the original role. -/
abbrev CoreType := Bool × Bool

def coreType {P : Type*} (t : CoreType) : QuestionType P ℓ :=
  .inr ((if t.1 then .sample else .introspect), t.2)

def displayed (L : Bool → CL.CLFun F ι ℓ) (t : CoreType) (z : ι → F) : ι → F :=
  if t.1 then z else (L t.2).eval z

def originalQuestion (L : Bool → CL.CLFun F ι ℓ) (t : CoreType) (y : ι → F) : ι → F :=
  if t.1 then (L t.2).eval y else y

@[simp] theorem originalQuestion_displayed (L : Bool → CL.CLFun F ι ℓ)
    (t : CoreType) (z : ι → F) : originalQuestion L t (displayed L t z) = (L t.2).eval z := by
  cases h : t.1 <;> simp [originalQuestion, displayed, h]

variable (L : Bool → CL.CLFun F ι ℓ) (D : (ι → F) → (ι → F) → A → A → Bool)

abbrev sourceGame := SampledGame.game (L false).eval (L true).eval D

variable (R : SyncStrategy (sourceGame L D).doubled)

/-- The actual honest register/auxiliary measurement for each of the four core types. -/
def coreOp (t : CoreType) (ya : (ι → F) × A) :
    Matrix ((ι → F) × Fin R.d) ((ι → F) × Fin R.d) ℂ :=
  conditionalReadout (displayed L t) (fun y => R.P.M (t.2, originalQuestion L t y)) ya

end MIPRE.Introspection.Honest


