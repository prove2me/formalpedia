theorem TensorProduct.exists_pow_smul_eq_one_tmul (p : ℕ) [Fact p.Prime] {M : Type*} [AddCommGroup M] [Module ℤ_[p] M]
    (v : ℚ_[p] ⊗[ℤ_[p]] M) : ∃ c : ℕ, ∃ m : M, ((p : ℚ_[p]) ^ c) • v = (1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] m := by
  induction v using TensorProduct.induction_on with
  | zero => exact ⟨0, 0, by simp⟩
  | tmul q m =>
    obtain ⟨c, a, ha⟩ := PadicInt.exists_pow_mul_eq_coe p q
    refine ⟨c, a • m, ?_⟩
    rw [TensorProduct.smul_tmul', smul_eq_mul, ha, TensorProduct.tmul_smul, ← algebraMap_smul ℚ_[p] a,
      TensorProduct.smul_tmul', smul_eq_mul, mul_one]
    rfl
  | add v w hv hw =>
    obtain ⟨c, m, hm⟩ := hv
    obtain ⟨d, n, hn⟩ := hw
    refine ⟨c + d, ((p ^ d : ℕ) : ℤ_[p]) • m + ((p ^ c : ℕ) : ℤ_[p]) • n, ?_⟩
    have e1 : ((p : ℚ_[p]) ^ (c + d)) • v = (1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] (((p ^ d : ℕ) : ℤ_[p]) • m) := by
      rw [pow_add, mul_comm, mul_smul, hm, TensorProduct.tmul_smul,
        ← algebraMap_smul (A := ℚ_[p]) (R := ℤ_[p]) _ ((1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] m)]
      simp
    have e2 : ((p : ℚ_[p]) ^ (c + d)) • w = (1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] (((p ^ c : ℕ) : ℤ_[p]) • n) := by
      rw [pow_add, mul_smul, hn, TensorProduct.tmul_smul,
        ← algebraMap_smul (A := ℚ_[p]) (R := ℤ_[p]) _ ((1 : ℚ_[p]) ⊗ₜ[ℤ_[p]] n)]
      simp
    rw [smul_add, e1, e2, ← TensorProduct.tmul_add]

