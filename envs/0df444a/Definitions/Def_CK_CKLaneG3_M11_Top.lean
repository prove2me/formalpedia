    InUVT (uvtBox []) μ.a μ.b μ.meanEntropy →
      (∃ q ∈ ArchTree.archTree.leavesR [], (goodLabel 6) q.2 = false ∧
        InUVT (uvtBox q.1) μ.a μ.b μ.meanEntropy) ∨ PsiSem k μ :=
  residual_of_leafFacts ArchTree.archTree [] root_leafFacts

/-- Coordinator leaf-family shape (BRIEF §7, (O)): every archived leaf with owner label 6 satisfies `SemUVT` on its full leaf image. -/
