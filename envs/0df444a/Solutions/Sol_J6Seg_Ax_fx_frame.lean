namespace J6Seg.Ax
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function

section fx
variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {stUp stDn : IStmt HS Pp}
  {eF eB : Fin Pp} {dF dA : Fin HS} {desc : List ℤ} {C₀ Cs : ℝ}

/-- The common frame: the set-up, a `FineBody6`-style call, the tear-down. -/
theorem fx_frame_sol_aux (w f a y : ℕ) (hF0 : dF ≠ 0) (hFA : dF ≠ dA) (hA0 : dA ≠ 0)
    (hSet : SetupS Isym tbl stUp stDn ![dF] dA desc ![descFine w f a y] Cs)
    {e : Fin Pp} {g : List GI → List GI} {Ce : ℝ}
    (he : ∀ (s : IState HS) (F : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
      (∀ j, j ≠ 0 → j ≠ dF → F j = []) → F dF = descFine w f a y → F 0 = gflat zs ++ l →
      zs.length = a * (2 ^ f * y) → GB w zs →
      ∃ c : ℕ, IRuns Isym tbl (.call e) (encK s F)
        (encK s (Function.update F 0 (gflat (g zs) ++ l))) c ∧ (c : ℝ) ≤ Ce) :
    PassOK Isym tbl (fxSt stUp stDn e) dA desc
      (fun L => L.length = a * (2 ^ f * y) ∧ GB w L) g (2 * Cs + Ce) := by
  intro s F L l hF hd h0 ⟨hlen, hgb⟩
  have hρ : ∀ i : Fin 1, (![dF] : Fin 1 → Fin HS) i = dF := fun i => by fin_cases i; rfl
  have hFd : F dF = [] := hF dF hF0 hFA
  have hS1 : ∀ G : Fin HS → List ℤ, (∀ j, j ≠ 0 → j ≠ dA → G j = []) →
      (∀ j, j ≠ 0 → j ≠ sZ → j ≠ dA → (∀ i, (![dF] : Fin 1 → Fin HS) i ≠ j) → G j = []) :=
    fun G hG j h1 _ h3 _ => hG j h1 h3
  obtain ⟨⟨cu, ru, ku⟩, -⟩ := hSet s F (hS1 F hF) (fun i => by rw [hρ]; exact hFd) hd
  -- the extended state: `F` with the descriptor on `dF`
  have hext : ∀ G : Fin HS → List ℤ, extend ![dF] ![descFine w f a y] G =
      update G dF (descFine w f a y) := by
    intro G; funext j
    by_cases hj : j = dF
    · subst j
      have := (show Injective (![dF] : Fin 1 → Fin HS) from fun a b _ => Subsingleton.elim a b)
      rw [update_self]
      exact this.extend_apply _ G (0 : Fin 1)
    · rw [update_of_ne hj]
      exact extend_apply' _ _ _ (fun ⟨i, hi⟩ => hj (by rw [← hi, hρ]))
  rw [hext] at ru
  -- the call, on the split-off state
  set H : Fin HS → List ℤ := fun j => if j = 0 then F 0 else if j = dF then descFine w f a y
    else [] with hHd
  set Gb : Fin HS → List ℤ := fun j => if j = 0 then [] else if j = dF then [] else F j
    with hGb
  have hsplit : ∀ v : List ℤ, ∀ j, update (update F dF (descFine w f a y)) 0 v j =
      update H 0 v j ++ Gb j := by
    intro v j
    by_cases h1 : j = 0
    · subst j; simp [hHd, hGb]
    · by_cases h2 : j = dF
      · subst j; simp [hHd, hGb, h1]
      · simp [hHd, hGb, h1, h2, update_of_ne h1, update_of_ne h2]
  have e1 : encK s (update F dF (descFine w f a y)) = encK (encK s Gb) H := by
    refine encK_split s (fun j => ?_)
    have := hsplit (F 0) j
    rwa [show update (update F dF (descFine w f a y)) 0 (F 0) = update F dF (descFine w f a y)
      by rw [update_eq_self_iff.2 (by rw [update_of_ne (Ne.symm hF0)])],
      show update H 0 (F 0) = H by rw [update_eq_self_iff.2 (by simp [hHd])]] at this
  have e2 : ∀ v, encK s (update (update F dF (descFine w f a y)) 0 v) =
      encK (encK s Gb) (update H 0 v) := fun v => encK_split s (hsplit v)
  obtain ⟨ce, re, ke⟩ := he (encK s Gb) H L l
    (fun j h1 h2 => by simp [hHd, h1, h2]) (by simp [hHd, hF0]) (by simp [hHd, h0]) hlen hgb
  rw [← e1, ← e2] at re
  -- the tear-down
  have hG0 : ∀ j, j ≠ 0 → j ≠ dA → update F 0 (gflat (g L) ++ l) j = [] :=
    fun j h1 h2 => by rw [update_of_ne h1]; exact hF j h1 h2
  obtain ⟨-, ⟨cd, rd, kd⟩⟩ := hSet s (update F 0 (gflat (g L) ++ l)) (hS1 _ hG0)
    (fun i => by rw [hρ, update_of_ne hF0]; exact hFd) (by rw [update_of_ne hA0]; exact hd)
  rw [hext, update_comm hF0.symm] at rd
  exact ⟨cu + (ce + cd), ru.seq (re.seq rd), by push_cast; linarith⟩

end fx

end J6Seg.Ax

end

