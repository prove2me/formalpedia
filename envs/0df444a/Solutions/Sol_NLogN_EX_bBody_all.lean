    simp only [Ex.Bnd, Ex.bnd_upd s j L B a h.1, Ex.bnd_upd s j L B b h.2]
  | .ndiv a b, h | .nmod a b, h => by
    simp only [Ex.regs, List.mem_append, not_or] at h
    simp only [Ex.Bnd, Ex.bnd_upd s j L B a h.1, Ex.bnd_upd s j L B b h.2, Ex.eval_upd s j L a h.1,
      Ex.eval_upd s j L b h.2]
  | .neg a, h => by simp only [Ex.regs] at h; simp only [Ex.Bnd, Ex.bnd_upd s j L B a h]
  | .pow2 a, h => by
    simp only [Ex.regs] at h; simp only [Ex.Bnd, Ex.bnd_upd s j L B a h, Ex.eval_upd s j L a h]
  | .sel c x y, h => by
    simp only [Ex.regs, List.mem_append, not_or] at h
    simp only [Ex.Bnd, Ex.bnd_upd s j L B c h.1.1, Ex.bnd_upd s j L B x h.1.2,
      Ex.bnd_upd s j L B y h.2, Ex.eval_upd s j L c h.1.1]

end NLogN.CR

end

