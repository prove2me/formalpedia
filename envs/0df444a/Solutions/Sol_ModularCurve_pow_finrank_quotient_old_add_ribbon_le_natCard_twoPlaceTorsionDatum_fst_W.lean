section Eval

variable {M : Type*} [AddCommGroup M]

theorem isMulCommutative_adjoin_of_comm (f : Nat.Primes → Module.End ℤ M)
    (h : ∀ ℓ ℓ', f ℓ * f ℓ' = f ℓ' * f ℓ) :
    IsMulCommutative (Algebra.adjoin ℤ (Set.range f)) :=
  Algebra.isMulCommutative_adjoin ℤ (by
    rintro _ ⟨ℓ, rfl⟩ _ ⟨ℓ', rfl⟩
    exact h ℓ ℓ')

open scoped IsMulCommutative in

noncomputable def evalAux (f : Nat.Primes → Module.End ℤ M) (h : ∀ ℓ ℓ', f ℓ * f ℓ' = f ℓ' * f ℓ) :
    HeckeAlg →ₐ[ℤ] (Algebra.adjoin ℤ (Set.range f) : Subalgebra ℤ (Module.End ℤ M)) :=
  haveI := isMulCommutative_adjoin_of_comm f h
  MvPolynomial.aeval fun ℓ =>
    (⟨f ℓ, Algebra.subset_adjoin (Set.mem_range_self ℓ)⟩ : Algebra.adjoin ℤ (Set.range f))

noncomputable def evalOfComm (f : Nat.Primes → Module.End ℤ M) (h : ∀ ℓ ℓ', f ℓ * f ℓ' = f ℓ' * f ℓ) :
    HeckeAlg →+* Module.End ℤ M :=
  ((Algebra.adjoin ℤ (Set.range f)).val.comp (evalAux f h)).toRingHom

open scoped IsMulCommutative in
theorem evalOfComm_heckeGen (f : Nat.Primes → Module.End ℤ M) (h : ∀ ℓ ℓ', f ℓ * f ℓ' = f ℓ' * f ℓ)
    (ℓ : Nat.Primes) : evalOfComm f h (heckeGen ℓ) = f ℓ := by
  haveI := isMulCommutative_adjoin_of_comm f h
  have hX : evalAux f h (heckeGen ℓ) = ⟨f ℓ, Algebra.subset_adjoin (Set.mem_range_self ℓ)⟩ :=
    MvPolynomial.aeval_X _ ℓ
  show ((evalAux f h (heckeGen ℓ) : Algebra.adjoin ℤ (Set.range f)) : Module.End ℤ M) = f ℓ
  rw [hX]

end Eval

section Std

variable {E V : Type} [Fintype E] [Fintype V] [DecidableEq V]

def StdStable (D : DegeneracyData E V) (H : HeckeData D) : Prop :=
  ∀ (ℓ : Nat.Primes) (φ : Module.Dual ℤ ↥(ribbonKernel D)),
    ribbonComponentGroupProj D φ = 0 → ribbonComponentGroupProj D (φ ∘ₗ heckeKernelMap H ℓ) = 0

theorem heckeKernelMap_comm {D : DegeneracyData E V} (H : HeckeData D) (ℓ ℓ' : Nat.Primes)
    (z : ↥(ribbonKernel D)) :
    heckeKernelMap H ℓ (heckeKernelMap H ℓ' z) = heckeKernelMap H ℓ' (heckeKernelMap H ℓ z) := by
  apply Subtype.ext
  show (H.T ℓ).mulVec ((H.T ℓ').mulVec (z : E → ℤ)) = (H.T ℓ').mulVec ((H.T ℓ).mulVec (z : E → ℤ))
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, (H.comm ℓ ℓ').eq]

variable {D : DegeneracyData E V} {H : HeckeData D}

noncomputable def stdGen (hst : StdStable D H) (ℓ : Nat.Primes) :
    ribbonComponentGroup D →ₗ[ℤ] ribbonComponentGroup D :=
  (LinearMap.range (ribbonGram D)).mapQ (LinearMap.range (ribbonGram D)) (heckeKernelMap H ℓ).dualMap
    (fun φ hφ => by
      rw [Submodule.mem_comap]
      have h0 : ribbonComponentGroupProj D φ = 0 := (Submodule.Quotient.mk_eq_zero _).mpr hφ
      exact (Submodule.Quotient.mk_eq_zero _).mp (hst ℓ φ h0))

theorem stdGen_proj (hst : StdStable D H) (ℓ : Nat.Primes) (φ : Module.Dual ℤ ↥(ribbonKernel D)) :
    stdGen hst ℓ (ribbonComponentGroupProj D φ) = ribbonComponentGroupProj D (φ ∘ₗ heckeKernelMap H ℓ) :=
  rfl

theorem stdGen_comm (hst : StdStable D H) (ℓ ℓ' : Nat.Primes) :
    stdGen hst ℓ * stdGen hst ℓ' = stdGen hst ℓ' * stdGen hst ℓ := by
  apply LinearMap.ext
  intro ψ
  obtain ⟨φ, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range (ribbonGram D)) ψ
  show stdGen hst ℓ (stdGen hst ℓ' (ribbonComponentGroupProj D φ)) =
    stdGen hst ℓ' (stdGen hst ℓ (ribbonComponentGroupProj D φ))
  rw [stdGen_proj, stdGen_proj, stdGen_proj, stdGen_proj, LinearMap.comp_assoc, LinearMap.comp_assoc]
  have hc : heckeKernelMap H ℓ' ∘ₗ heckeKernelMap H ℓ = heckeKernelMap H ℓ ∘ₗ heckeKernelMap H ℓ' := by
    apply LinearMap.ext
    intro z
    exact (heckeKernelMap_comm H ℓ ℓ' z).symm
  rw [hc]

noncomputable def stdHecke (hst : StdStable D H) : HeckeAlg →+* Module.End ℤ (ribbonComponentGroup D) :=
  evalOfComm (stdGen hst) (stdGen_comm hst)

theorem stdHecke_heckeGen_proj (hst : StdStable D H) (ℓ : Nat.Primes) (φ : Module.Dual ℤ ↥(ribbonKernel D)) :
    stdHecke hst (heckeGen ℓ) (ribbonComponentGroupProj D φ) =
      ribbonComponentGroupProj D (φ ∘ₗ heckeKernelMap H ℓ) := by
  show evalOfComm (stdGen hst) (stdGen_comm hst) (heckeGen ℓ) (ribbonComponentGroupProj D φ) = _
  rw [evalOfComm_heckeGen]
  exact stdGen_proj hst ℓ φ

end Std

section Local

variable {p : ℕ} {E V : Type} [Fintype E] [Fintype V] [DecidableEq V]
  {A : ValuationSubring (AlgebraicClosure ℚ)}

theorem stdStable_of_localLaws (Dm : JPrimeTorsionDatum p E V A) {r : ℕ} [Fact r.Prime]
    (L : Dm.LocalLaws r) : StdStable Dm.D Dm.H := by
  intro ℓ φ hφ
  have h0mem : Dm.hecke (heckeGen ℓ) ((0 : ↥Dm.invariants) : Dm.T) ∈ Dm.invariants := by
    rw [ZeroMemClass.coe_zero, map_zero]; exact zero_mem _
  have h0 : Dm.sp 0 = ribbonComponentGroupProj Dm.D φ := by rw [map_zero]; exact hφ.symm
  have h1 := L.sp_hecke ℓ 0 h0mem φ h0
  rw [← h1]
  have hz : Dm.hecke (heckeGen ℓ) ((0 : ↥Dm.invariants) : Dm.T) = 0 := by
    rw [ZeroMemClass.coe_zero, map_zero]
  have hz' : (⟨Dm.hecke (heckeGen ℓ) ((0 : ↥Dm.invariants) : Dm.T), h0mem⟩ : ↥Dm.invariants) = 0 :=
    Subtype.ext hz
  exact (congrArg Dm.sp hz').trans (map_zero Dm.sp)

end Local

section Arith

theorem not_mem_incongruent (𝔪 : Ideal HeckeAlg) [h𝔪 : 𝔪.IsMaximal] {p q' : ℕ} (hpp : p.Prime)
    (hpm : (p : HeckeAlg) ∈ 𝔪) (hq' : q'.Prime) (hnew : heckeGen ⟨q', hq'⟩ ^ 2 - 1 ∈ 𝔪)
    (hq'1 : ¬ (p : ℤ) ∣ (q' : ℤ) - 1) :
    ((q' : HeckeAlg) - 1) * heckeGen ⟨q', hq'⟩ ∉ 𝔪 := by
  intro hmem
  have hne : 𝔪 ≠ ⊤ := h𝔪.ne_top
  rcases h𝔪.isPrime.mem_or_mem hmem with h1 | h2
  · have hcop : IsCoprime (p : ℤ) ((q' : ℤ) - 1) :=
      (Prime.coprime_iff_not_dvd (Nat.prime_iff_prime_int.mp hpp)).mpr hq'1
    obtain ⟨a, b, hab⟩ := hcop
    apply hne
    rw [Ideal.eq_top_iff_one]
    have hcast : (a : HeckeAlg) * (p : HeckeAlg) + (b : HeckeAlg) * ((q' : HeckeAlg) - 1) = 1 := by
      have := congrArg (Int.cast : ℤ → HeckeAlg) hab
      push_cast at this
      exact this
    rw [← hcast]
    exact 𝔪.add_mem (𝔪.mul_mem_left _ hpm) (𝔪.mul_mem_left _ h1)
  · apply hne
    rw [Ideal.eq_top_iff_one]
    have hsq : heckeGen ⟨q', hq'⟩ ^ 2 ∈ 𝔪 := 𝔪.pow_mem_of_mem h2 2 (by norm_num)
    have h3 := 𝔪.sub_mem hsq hnew
    rwa [sub_sub_cancel] at h3

theorem five_le_of_dvd_sub_one {p q : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) (hq : q.Prime)
    (h : (p : ℤ) ∣ (q : ℤ) - 1) : 5 ≤ q := by
  have hp3 : 3 ≤ p := by
    rcases hp.eq_two_or_odd' with h2 | hodd
    · exact absurd h2 hp2
    · have := hp.two_le
      obtain ⟨k, hk⟩ := hodd
      omega
  have hq2 := hq.two_le
  have hdvd : p ∣ q - 1 := by
    have hc : ((q - 1 : ℕ) : ℤ) = (q : ℤ) - 1 := by
      rw [Nat.cast_sub (by omega), Nat.cast_one]
    rw [← hc, Int.natCast_dvd_natCast] at h
    exact h
  have hle : p ≤ q - 1 := Nat.le_of_dvd (by omega) hdvd
  have hq4 : q ≠ 4 := by
    rintro rfl
    exact absurd hq (by decide)
  omega

variable {L : Type*} [AddCommGroup L] [Module HeckeAlg L]

theorem finite_quotient (p : ℕ) (hp : p.Prime) (𝔪 : Ideal HeckeAlg) [Module.Finite ℤ L]
    (hpm : (p : HeckeAlg) ∈ 𝔪) : Finite (L ⧸ (𝔪 • (⊤ : Submodule HeckeAlg L))) := by
  haveI : AddGroup.FG L := (Module.Finite.iff_addGroup_fg).mp inferInstance
  haveI : AddGroup.FG (L ⧸ (𝔪 • (⊤ : Submodule HeckeAlg L))) :=
    AddGroup.fg_of_surjective (f := (Submodule.mkQ (𝔪 • (⊤ : Submodule HeckeAlg L))).toAddMonoidHom)
      (Submodule.mkQ_surjective _)
  refine AddCommGroup.finite_of_fg_torsion _ fun v => ?_
  refine isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨p, hp.pos, ?_⟩
  obtain ⟨l, rfl⟩ := Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule HeckeAlg L)) v
  rw [← map_nsmul, ← Nat.cast_smul_eq_nsmul HeckeAlg p l, Submodule.mkQ_apply,
    Submodule.Quotient.mk_eq_zero]
  exact Submodule.smul_mem_smul hpm Submodule.mem_top

end Arith

section Groth

variable {p : ℕ} {E V : Type} [Fintype E] [Fintype V] [DecidableEq V]
  {A : ValuationSubring (AlgebraicClosure ℚ)}

theorem hecke_mem_invariants (Dm : JPrimeTorsionDatum p E V A) (x : HeckeAlg) {t : Dm.T}
    (ht : t ∈ Dm.invariants) : Dm.hecke x t ∈ Dm.invariants := by
  simp only [JPrimeTorsionDatum.invariants, AddSubgroup.mem_iInf, AddMonoidHom.mem_ker,
    AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddEquiv.coe_toAddMonoidHom, sub_eq_zero] at ht ⊢
  intro σ hσ
  rw [Dm.comm σ x t, ht σ hσ]

def PI (Dm : JPrimeTorsionDatum p E V A) (𝔪 : Ideal HeckeAlg) : AddSubgroup Dm.T where
  carrier := {t | t ∈ Dm.invariants ∧ ∀ x ∈ 𝔪, Dm.hecke x t ∈ Dm.toric}
  zero_mem' := ⟨Dm.invariants.zero_mem, fun x _ => by rw [map_zero]; exact Dm.toric.zero_mem⟩
  add_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    exact ⟨Dm.invariants.add_mem ha hb, fun x hx => by
      rw [map_add]; exact Dm.toric.add_mem (ha' x hx) (hb' x hx)⟩
  neg_mem' := by
    rintro a ⟨ha, ha'⟩
    exact ⟨Dm.invariants.neg_mem ha, fun x hx => by rw [map_neg]; exact Dm.toric.neg_mem (ha' x hx)⟩

theorem PI_le_invariants (Dm : JPrimeTorsionDatum p E V A) (𝔪 : Ideal HeckeAlg) :
    PI Dm 𝔪 ≤ Dm.invariants := fun _ ht => ht.1

noncomputable def spPI (Dm : JPrimeTorsionDatum p E V A) (𝔪 : Ideal HeckeAlg) :
    ↥(PI Dm 𝔪) →+ ribbonComponentGroup Dm.D :=
  Dm.sp.comp (AddSubgroup.inclusion (PI_le_invariants Dm 𝔪))

theorem spPI_apply (Dm : JPrimeTorsionDatum p E V A) (𝔪 : Ideal HeckeAlg) (t : ↥(PI Dm 𝔪)) :
    spPI Dm 𝔪 t = Dm.sp ⟨(t : Dm.T), t.2.1⟩ := rfl

theorem groth_count (Dm : JPrimeTorsionDatum p E V A) (𝔪 : Ideal HeckeAlg) (hp : (p : HeckeAlg) ∈ 𝔪)
    (htoric : ∀ (x : HeckeAlg) (t : Dm.T), t ∈ Dm.toric → Dm.hecke x t ∈ Dm.toric)
    (hle : Dm.toric ≤ Dm.invariants)
    (hker : ∀ t : ↥Dm.invariants, Dm.sp t = 0 ↔ (t : Dm.T) ∈ Dm.toric)
    (hrange : ∀ ψ : ribbonComponentGroup Dm.D, ψ ∈ Dm.sp.range ↔ p • ψ = 0)
    (heckeΨ : HeckeAlg →+* Module.End ℤ (ribbonComponentGroup Dm.D))
    (hsp : ∀ (x : HeckeAlg) (t : ↥Dm.invariants) (ht : Dm.hecke x (t : Dm.T) ∈ Dm.invariants),
      Dm.sp ⟨Dm.hecke x (t : Dm.T), ht⟩ = heckeΨ x (Dm.sp t)) :
    Nat.card ↥Dm.toric * Nat.card {ψ : ribbonComponentGroup Dm.D // ∀ x ∈ 𝔪, heckeΨ x ψ = 0} =
      Nat.card {t : Dm.T // t ∈ Dm.invariants ∧ ∀ x ∈ 𝔪, Dm.hecke x t ∈ Dm.toric} := by
  classical
  set g := spPI Dm 𝔪 with hg

  have hker_g : ∀ t : ↥(PI Dm 𝔪), t ∈ g.ker ↔ (t : Dm.T) ∈ Dm.toric := by
    intro t
    rw [AddMonoidHom.mem_ker, hg, spPI_apply]
    exact hker ⟨(t : Dm.T), t.2.1⟩
  have htoricPI : ∀ t : Dm.T, t ∈ Dm.toric → t ∈ PI Dm 𝔪 := fun t ht =>
    ⟨hle ht, fun x _ => htoric x t ht⟩
  have eker : ↥g.ker ≃ ↥Dm.toric :=
    { toFun := fun t => ⟨((t : ↥(PI Dm 𝔪)) : Dm.T), (hker_g t.1).mp t.2⟩
      invFun := fun t => ⟨⟨(t : Dm.T), htoricPI t t.2⟩, (hker_g _).mpr t.2⟩
      left_inv := fun t => rfl
      right_inv := fun t => rfl }

  have hrange_g : ∀ ψ : ribbonComponentGroup Dm.D, ψ ∈ g.range ↔ ∀ x ∈ 𝔪, heckeΨ x ψ = 0 := by
    intro ψ
    constructor
    · rintro ⟨t, rfl⟩ x hx
      have h1 := hsp x ⟨(t : Dm.T), t.2.1⟩ (hecke_mem_invariants Dm x t.2.1)
      have h2 : Dm.sp ⟨Dm.hecke x (t : Dm.T), hecke_mem_invariants Dm x t.2.1⟩ = 0 :=
        (hker ⟨_, hecke_mem_invariants Dm x t.2.1⟩).mpr (t.2.2 x hx)
      exact (h1.symm.trans h2 : heckeΨ x (Dm.sp ⟨(t : Dm.T), t.2.1⟩) = 0)
    · intro hψ
      have hpψ : p • ψ = 0 := by
        have h1 := hψ (p : HeckeAlg) hp
        rwa [map_natCast, Module.End.natCast_apply] at h1
      obtain ⟨t, ht⟩ := (hrange ψ).mpr hpψ
      have htPI : (t : Dm.T) ∈ PI Dm 𝔪 := by
        refine ⟨t.2, fun x hx => ?_⟩
        have h2 := hsp x t (hecke_mem_invariants Dm x t.2)
        rw [ht, hψ x hx] at h2
        exact (hker ⟨_, _⟩).mp h2
      refine ⟨⟨(t : Dm.T), htPI⟩, ?_⟩
      rw [hg, spPI_apply, ← ht]
  have erange : ↥g.range ≃ {ψ : ribbonComponentGroup Dm.D // ∀ x ∈ 𝔪, heckeΨ x ψ = 0} :=
    Equiv.subtypeEquivRight hrange_g

  have hL := AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup g.ker
  have hq : Nat.card (↥(PI Dm 𝔪) ⧸ g.ker) = Nat.card ↥g.range :=
    Nat.card_congr (QuotientAddGroup.quotientKerEquivRange g).toEquiv
  rw [hq, Nat.card_congr erange, Nat.card_congr eker, mul_comm] at hL
  rw [← hL]
  rfl

end Groth

section Leg

variable {p : ℕ} [Fact p.Prime]
  {E₁ V₁ E₂ V₂ : Type} [Fintype E₁] [Fintype V₁] [DecidableEq V₁] [Fintype E₂] [Fintype V₂] [DecidableEq V₂]
  {D₁ : DegeneracyData E₁ V₁} {H₁ : HeckeData D₁} {D₂ : DegeneracyData E₂ V₂} {H₂ : HeckeData D₂}
  {A₁ A₂ : ValuationSubring (AlgebraicClosure ℚ)}

theorem numeric {a cΨ cPI cP cTW cW : ℕ} (ha : 0 < a) (hEA : a * cΨ = cPI) (hPI : cPI ≤ cP)
    (hR1 : cTW * cP ≤ cW * a) : cTW * cΨ ≤ cW := by
  have h1 : a * (cTW * cΨ) ≤ a * cW := by
    calc a * (cTW * cΨ) = cTW * (a * cΨ) := by ring
      _ = cTW * cPI := by rw [hEA]
      _ ≤ cTW * cP := Nat.mul_le_mul_left _ hPI
      _ ≤ cW * a := hR1
      _ = a * cW := mul_comm _ _
  exact Nat.le_of_mul_le_mul_left h1 ha

