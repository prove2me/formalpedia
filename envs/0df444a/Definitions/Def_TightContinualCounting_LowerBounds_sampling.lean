-- title:
--   Uniform laws, history filtration, flipped joint law, and tagging probability
-- statement:
--   The uniform law on a nonempty finite set $A$ is its counting measure divided by $|A|$. The history filtration of a finite tree path process is generated by all its values up to the given time.
--
--   For any family $F(x)$ of probability laws on an arbitrary measurable space $\mathcal Y$, define its uniform mixture $\bar F=2^{-n}\sum_x F(x)$. The joint law obtained by sampling independent uniform $X\in\{0,1\}^n$ and $J\in[n]$ and then drawing from $F(X\oplus e_J)$ is
--
--   $$
--   \nu_F=\frac1{n2^n}\sum_x\sum_j(\operatorname{Dirac}_j\otimes F(x\oplus e_j)).
--   $$
--
--   For the counting mechanism, write $m=4^H$, $q=km\le n$ and let $Y_j(x,W)$ be the shifted residual defined above. Its tagging probability is
--
--   $$
--   p_\phi=\frac1{m2^m}\sum_{x\in\{0,1\}^m}\sum_{j\in[m]} M(E_k(x))\{W:S_\phi(j,Y_j(x,W))\ge H/4\}.
--   $$
--
--   This is sampling $X,J$ independently and drawing $W$ conditionally on $X$, with no dependence of the mechanism randomization on $J$. It applies to continuous and unbounded output laws. The joint-law identity in Lemma 6 expresses independence without restricting the output space to a finite set.
--
--   **Formalization Note** These are finite mixtures of measures or their event masses, not sums over possible output atoms. Only the discrete inputs and leaf indices are summed. Empty finite types give zero measure, and the statements using an index $J\in[n]$ assume $n\ge1$.
-- source:
--   Charlie Harrison, Ethan Leeman, Tight Lower Bounds for Differentially Private Continual Counting, STOC 2027 submission #1453 (October 2026), Definition 7 and Lemma 6 p.6; Lemma 10 p.9; sampling in Lemmas 11–12 pp.10,13

import Mathlib
import Definitions.Def_TightContinualCounting_LowerBounds_tree

open MeasureTheory
open scoped ENNReal

namespace TightContinualCounting.LowerBounds

/-- Uniform law on a nonempty finite discrete type; empty type gives the zero measure. -/
noncomputable def uniformFinite (α : Type*) [Fintype α] [MeasurableSpace α] : Measure α :=
  (Fintype.card α : ℝ≥0∞)⁻¹ • Measure.count

/-- The history filtration of the finite path-sum process (Definition 7 and Lemma 10). -/
noncomputable def pathFiltration (H : ℕ) (w : ℕ → ℕ → Fin 4 → ℝ) :
    Filtration (Fin (H + 1)) (inferInstance : MeasurableSpace (Fin (4 ^ H))) :=
  Filtration.natural (fun (t : Fin (H + 1)) (j : Fin (4 ^ H)) => pathSum H w t.val j)
    (fun _ => (measurable_of_finite _).stronglyMeasurable)

/-- Uniform input mixture for an arbitrary measurable output space. -/
noncomputable def averagedLaw {n : ℕ} {Y : Type*} [MeasurableSpace Y]
    (F : (Fin n → Bool) → Measure Y) : Measure Y :=
  (Fintype.card (Fin n → Bool) : ℝ≥0∞)⁻¹ • ∑ x, F x

/-- Law of (J,f(X xor e_J)), with fresh randomization described by F for each input. -/
noncomputable def flippedJointLaw {n : ℕ} {Y : Type*} [MeasurableSpace Y]
    (F : (Fin n → Bool) → Measure Y) : Measure (Fin n × Y) :=
  ((Fintype.card (Fin n → Bool) : ℝ≥0∞) * n)⁻¹ •
    ∑ x, ∑ j : Fin n, (Measure.dirac j).prod (F (flip x j))

/-- Average over independent uniform X,J and W with law M(E_k(X)); no support assumption. -/
noncomputable def taggingProbability {n : ℕ} (H k : ℕ) (hq : k * 4 ^ H ≤ n)
    (M : (Fin n → Bool) → Measure (Fin n → ℝ)) (a : ℝ) (φ : ProbeRule) : ℝ≥0∞ :=
  ((Fintype.card (Fin (4 ^ H) → Bool) : ℝ≥0∞) * (4 ^ H : ℕ))⁻¹ *
    ∑ x : Fin (4 ^ H) → Bool, ∑ j : Fin (4 ^ H),
      M (expand n k x) {W | (H : ℝ) / 4 ≤ score H k a φ j (shiftedResidual H k hq x W j)}

end TightContinualCounting.LowerBounds


