variable {h : ℕ} {T : Type*} [Fintype T] [DecidableEq T] {ind : T → Finset (Fin h)}

variable (ind) in
/-- The triple of a gate name (`∅` for central gates, where it is unused). -/
def tri : Option T → Finset (Fin h)
  | some t => ind t
  | none => ∅

/-- Physical time of row `r` at stage `j` (stage 2 runs the inverse schedule backwards). -/
def time (j : Fin 3) (r : Fin 8) : ℕ := if j = 1 then 7 - r.val else r.val

/-- The `B`-factor of the table-(6) label at time `r`. -/
def Ψ1f (r : ℕ) (S : Finset (Fin h)) : Submodule (ZMod 2) (Vh h) := if r = 0 then L1 S else ⊤

/-- The `P`-factor of the table-(6) label at time `r`. -/
def Ψ2f : ℕ → Finset (Fin h) → Submodule (ZMod 2) (Vh h)
  | 2, S => L1 S
  | 3, _ => ⊤
  | 5, S => Pp S
  | 6, _ => ⊤
  | 7, _ => ⊤
  | _, _ => ⊥

variable (ind) in
/-- **Table (6)**: the label of every gate of the corrected complex network (`none` = the final
sign gate on the `X` outputs, label `F`). -/
def labS : Option (GName T) → Submodule (ZMod 2) (Vc h)
  | none => ⊤
  | some (j, p, (r, o)) =>
    lab j (ind p.1) (ind p.2) (Ψ1f (NetComplexP8.time j r) (tri ind o)) (Ψ2f (NetComplexP8.time j r) (tri ind o))

variable (ind) in
/-- `u_a = t_{a₁} ⊗ t_{a₂} ⊗ t_{a₃}`. -/
def uA (a : T × T × T) : Vc h := t3 (tt (ind a.1)) (tt (ind a.2.1)) (tt (ind a.2.2))

variable (ind) in
/-- Source labels: `U_a` on `X_a`, zero elsewhere. -/
def MinS : Wr ind → Submodule (ZMod 2) (Vc h)
  | Sum.inl a => Submodule.span (ZMod 2) {NetComplexP8.uA ind a}
  | Sum.inr _ => ⊥

variable (ind) in
/-- Sink labels: `U_a^⊥` on `Y_a`, `F` elsewhere. -/
def MoutS : Wr ind → Submodule (ZMod 2) (Vc h)
  | Sum.inr (Sum.inl a) => NetLabels.orth 1 (Submodule.span (ZMod 2) {NetComplexP8.uA ind a})
  | _ => ⊤

lemma pj_zero (a : T × T × T) : pj 0 a = (a.2.1, a.2.2) := rfl
lemma cj_zero (a : T × T × T) : cj 0 a = a.1 := rfl
lemma pj_one (a : T × T × T) : pj 1 a = (a.1, a.2.2) := rfl
lemma cj_one (a : T × T × T) : cj 1 a = a.2.1 := rfl
lemma pj_two (a : T × T × T) : pj 2 a = (a.1, a.2.1) := rfl
lemma cj_two (a : T × T × T) : cj 2 a = a.2.2 := rfl

