-- title:
--   The verifiable sets of a basis, plus the whole space, form a sub-basis
-- statement:
--   Let $B$ be a basis of the experimental domain $\mathcal D$. Then $U(B)\cup\{X\}$ is a sub-basis of the natural topology of $X$: the topology generated by these sets equals the natural topology.
-- source:
--   G. Carcassi, C. A. Aidala, Assumptions of Physics, Ver. 3.0 (Dec 31, 2025), https://assumptionsofphysics.org/book — Part II, Chapter 1 (pp. 101–146), Proposition 1.60, p. 137

import Mathlib
import Definitions.Def_AoP_ExperimentalDomains

namespace AssumptionsOfPhysics
theorem generateFrom_basis_eq {Ω : Type*} (D : ExperimentalDomain Ω) (B : Set (Set Ω))
    (hB : IsBasis D.stmts B) :
    TopologicalSpace.generateFrom (D.verifiableSet '' B ∪ {Set.univ}) =
      ExperimentalDomain.naturalTopology D := by sorry
end AssumptionsOfPhysics
