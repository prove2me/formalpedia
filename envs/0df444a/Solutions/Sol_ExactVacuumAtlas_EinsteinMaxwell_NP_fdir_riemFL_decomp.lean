theorem solution (hN : NullFrameData g gi E Θ U) {x : Pt 4} (hx : x ∈ U) (C I J A B : Fin 4) :
    fdir E C (riemFL g gi E Θ I J A B) x = fdir E C (weylF g gi E I J A B) x
      + (etaNull I A * fdir E C (ricF g gi E J B) x - etaNull I B * fdir E C (ricF g gi E J A) x
        - etaNull J A * fdir E C (ricF g gi E I B) x + etaNull J B * fdir E C (ricF g gi E I A) x) / 2
      - fdir E C (fun z => (ricciScalar g gi z : ℂ)) x
        * (etaNull I A * etaNull J B - etaNull I B * etaNull J A) / 6 := by
  have hF := hN.toFrameData
  have hU := hF.isOpen
  have hw := contDiffOn_weylF hF I J A B
  have hr : ∀ P Q, ContDiffOn ℝ ∞ (ricF g gi E P Q) U := contDiffOn_ricF hF
  have hR : ContDiffOn ℝ ∞ (fun z => (ricciScalar g gi z : ℂ)) U :=
    contDiffOn_ofReal (contDiffOn_ricciScalar hF.metric)
