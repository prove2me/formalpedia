-- title:
--   QECCertificates: finrank span L le of mem of subset
-- statement:
--   **A rank upper bound from redundant generators (set form)**: if every row of `L`
--   lies in `spanL A`, then `dim spanL L ≤ A.length`. The list `A` need not be a prefix of `L`,
--   since `spanL` sees only the underlying set, so picking `head` rows of `L` that span the whole
--   list and having the whole list generated by those `head` generators come to the same thing.
--   This form also applies when a spanning subset is not a prefix of the row list.
--
--   Source: https://github.com/LeanPool/lean-pool/blob/e110decb9d02249d99fa85a144e6a659dea91440/LeanPool/QECCertificates/GF2/RankEchelon.lean#L535-L539
-- source:
--   https://github.com/LeanPool/lean-pool/blob/e110decb9d02249d99fa85a144e6a659dea91440/LeanPool/QECCertificates/GF2/RankEchelon.lean#L535-L539

module
public import Definitions.Def_LeanPool_QECCertificates_GF2_RankCertificate
public import Definitions.Def_LeanPool_QECCertificates_GF2_RankEchelon
set_option autoImplicit true
@[expose] public section
public section
open QECCertificates
open scoped BigOperators
variable {n : ℕ}

theorem QECCertificates.finrank_spanL_le_of_mem_of_subset {A L : List (Vec n)}
    (h : ∀ v ∈ L, v ∈ spanL A) :
    Module.finrank (ZMod 2) (spanL L) ≤ A.length := by sorry
