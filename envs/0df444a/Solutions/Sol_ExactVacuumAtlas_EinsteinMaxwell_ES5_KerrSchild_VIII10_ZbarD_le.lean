/-! ## The pointwise inverse lower bound -/

/-- On `KG × [0,1]` the inverse factor is at least `1`. -/
theorem one_le_inv_KG {x t : ℝ} (hx : x ∈ KG) (ht : t ∈ Icc (0:ℝ) 1) :
    (1 : ℝ) ≤ (1 - t * x)⁻¹ := by
  have hge := one_sub_mul_ge_KG hx ht
  obtain ⟨ht0, ht1⟩ := ht
  obtain ⟨hx0, hx1⟩ := hx
  have hpos : (0:ℝ) < 1 - t * x := by linarith
  have hle : 1 - t * x ≤ 1 := by
    have : 0 ≤ t * x := mul_nonneg ht0 hx0
    linarith
  exact (one_le_inv₀ hpos).mpr hle

/-- On `KG × [0,1]` the squared inverse factor is at least `1`. -/
theorem one_le_inv_sq_KG {x t : ℝ} (hx : x ∈ KG) (ht : t ∈ Icc (0:ℝ) 1) :
    (1 : ℝ) ≤ (1 - t * x)⁻¹ ^ 2 := by
  have hinv := one_le_inv_KG hx ht
  have hpow : (1:ℝ) ^ 2 ≤ (1 - t * x)⁻¹ ^ 2 := pow_le_pow_left₀ (by norm_num) hinv 2
  simpa using hpow

/-- Integrability of the `Gc` integrand on `[0,1]`. -/
theorem intervalIntegrable_Gc_integrand {x : ℝ} (hx : x ∈ KG) :
    IntervalIntegrable (fun t : ℝ => t * (1 - t * x)⁻¹) volume 0 1 := by
  simpa only [pow_one, zero_add] using
    intervalIntegrable_J (k := 1) (m := 0) (KG_subset_UG hx)

/-- Integrability of the `GcD` integrand on `[0,1]`. -/
theorem intervalIntegrable_GcD_integrand {x : ℝ} (hx : x ∈ KG) :
    IntervalIntegrable (fun t : ℝ => t ^ 2 * (1 - t * x)⁻¹ ^ 2) volume 0 1 := by
  simpa only [Nat.reduceAdd] using
    intervalIntegrable_J (k := 2) (m := 1) (KG_subset_UG hx)

/-! ## The three lower bounds -/

/-- `1/2 ≤ Gc x` on `KG`. -/
theorem half_le_Gc {x : ℝ} (hx : x ∈ KG) : (1 / 2 : ℝ) ≤ Gc x := by
  rw [Gc_eq]
  have hmono : (∫ t in (0:ℝ)..1, t) ≤ ∫ t in (0:ℝ)..1, t * (1 - t * x)⁻¹ :=
    intervalIntegral.integral_mono_on (μ := volume) (a := (0:ℝ)) (b := 1) (by norm_num)
      intervalIntegrable_id (intervalIntegrable_Gc_integrand hx)
      (fun t ht => le_mul_of_one_le_right ht.1 (one_le_inv_KG hx ht))
  have hid : (∫ t in (0:ℝ)..1, t) = 1 / 2 := by
    rw [integral_id]; norm_num
  rw [hid] at hmono
  exact hmono

/-- `1/3 ≤ GcD x` on `KG`. -/
theorem third_le_GcD {x : ℝ} (hx : x ∈ KG) : (1 / 3 : ℝ) ≤ GcD x := by
  rw [GcD_eq]
  have hmono : (∫ t in (0:ℝ)..1, t ^ 2) ≤ ∫ t in (0:ℝ)..1, t ^ 2 * (1 - t * x)⁻¹ ^ 2 :=
    intervalIntegral.integral_mono_on (μ := volume) (a := (0:ℝ)) (b := 1) (by norm_num)
      (Continuous.intervalIntegrable (continuous_id.pow 2) 0 1)
      (intervalIntegrable_GcD_integrand hx)
      (fun t ht => le_mul_of_one_le_right (pow_nonneg ht.1 2) (one_le_inv_sq_KG hx ht))
  have hid : (∫ t in (0:ℝ)..1, t ^ 2) = 1 / 3 := by
    rw [integral_pow]; norm_num
  rw [hid] at hmono
  exact hmono

/-! ## The upper bound on `Hc` -/

/-- `Hc x ≤ 5/4` on `KG`, from the exact identity `Hc = 1 + x Gc`. -/
theorem Hc_le_five_quarters {x : ℝ} (hx : x ∈ KG) : Hc x ≤ 5 / 4 := by
  obtain ⟨hx0, hx1⟩ := hx
  have hid : Hc x - x * Gc x = 1 := Hc_sub_mul_Gc (KG_subset_UG ⟨hx0, hx1⟩)
  have hG := abs_Gc_le_K ⟨hx0, hx1⟩
  have hGle : Gc x ≤ 3 / 4 := (abs_le.mp hG).2
  have hG0 : (0:ℝ) ≤ Gc x := by
    have := half_le_Gc ⟨hx0, hx1⟩
    linarith
  have hxG : x * Gc x ≤ (1 / 3) * (3 / 4) :=
    mul_le_mul hx1 hGle hG0 (by norm_num)
  linarith

