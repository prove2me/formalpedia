-- title:
--   Lemma 3.11 — $J:q'^\infty=I(V)$ for $J=(q,\,q'y_2-r_2,\dots,q'y_n-r_n)$
-- statement:
--   Let $K$ be algebraically closed and $V\subseteq K^{m+n}$ an equidimensional variety of dimension $m$ such that $y_1$ is a primitive element for $V$, with general projection $Q$, and $q,r_2,\dots,r_n$ as in eq. (1); let $q'=\partial q/\partial y_1$ and $J\subseteq K[x,y]$ the ideal generated by $q,\ q'y_2-r_2,\dots,q'y_n-r_n$. Then
--   $$
--   J:q'^{\infty}=I,
--   $$
--   where $I=I(V)$ is the ideal of polynomials vanishing on $V$ and $J:q'^\infty=\{f : q'^kf\in J \text{ for some } k\}$.
--
--   This is the third condition of Definition 3.3: $q,r_2,\dots,r_n$ is a geometric resolution of $V$.
--
--   **Formalization Note** $q,q',r_j\in K[x][y_1]$ are embedded in $K[x,y]$ with $y_1$ as the polynomial variable; both sides are compared as sets of polynomials.
--
--   Differences from the source:
--   - encoding: the standing assumption of §3.2 and Q as constructed in Lemmas 3.5–3.6 → hypotheses IsPrimitiveY1 V and IsGeneralProjection V Q; reason: the section's standing assumption written as binders; Q characterized over K determines the same polynomial
-- source:
--   Andrews, Garg, Oliveira, Schost, Some algebraic and geometric computations in CH via Chow forms, arXiv:2611.05289 (held version, sha256 75e796c6…), Lemma 3.11, p.26 (PDF p.28)

import Mathlib
import Definitions.Def_ChowFormsCH_IsPrimitiveY1
import Definitions.Def_ChowFormsCH_IsGeneralProjection

set_option autoImplicit false

namespace ChowFormsCH

/-- **Lemma 3.11** (Andrews–Garg–Oliveira–Schost, *Some algebraic and geometric computations in CH
via Chow forms*, arXiv:2611.05289, held version, sha256 75e796c6…, p.26). For an equidimensional
variety `V ⊂ K^{m+n}` of dimension `m` such that `y₁` is a primitive element for `V`, with `Q` the
general projection, `q, r₂, …, rₙ` as in eq. (1), `q′ = ∂q/∂y₁`, and `J ⊂ K[x, y]` the ideal
generated by `q, q′y₂ − r₂, …, q′yₙ − rₙ`: `J : q′^∞ = I`, where `I = I(V)`.

**Formalization Note** `K` is algebraically closed. `q, q′, r_j ∈ K[x][y₁]` are embedded in
`K[x, y]` by `embXY1`; `J : q′^∞ = {f : ∃ k, q′^k f ∈ J}` (saturation) and
`I(V) = {f : f vanishes on V}`. -/
theorem lemma_3_11 {K : Type} [Field K] [IsAlgClosed K] {m n : ℕ} [NeZero n]
    (V : Set (AffSp (Fin m ⊕ Fin n) K)) (hV : IsPrimitiveY1 V)
    (Q : Polynomial (MvPolynomial (Fin n ⊕ Fin m) K)) (hQ : IsGeneralProjection V Q) :
    {f : MvPolynomial (Fin m ⊕ Fin n) K | ∃ k : ℕ,
        embXY1 (Polynomial.derivative (resQ Q)) ^ k * f ∈
          Ideal.span ({embXY1 (resQ Q)} ∪
            Set.range fun j : {j : Fin n // j ≠ 0} =>
              embXY1 (Polynomial.derivative (resQ Q)) * MvPolynomial.X (Sum.inr j.1)
                - embXY1 (resR Q j.1))}
      = {f : MvPolynomial (Fin m ⊕ Fin n) K |
          ∀ v ∈ V, MvPolynomial.eval (show Fin m ⊕ Fin n → K from v) f = 0} := by sorry

end ChowFormsCH
