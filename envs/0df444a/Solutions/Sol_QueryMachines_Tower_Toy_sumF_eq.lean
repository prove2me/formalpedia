namespace QueryMachines.Tower.Toy
theorem _root_.solution : ∀ (l : ℕ) (f : List Bool → Option ℕ), sumF l f = ((words l).map fun q => (f q).getD 0).sum
  | 0, f => by simp [sumF, words]
  | l + 1, f => by simp [sumF, words, solution l, List.map_map, Function.comp_def]
end QueryMachines.Tower.Toy
