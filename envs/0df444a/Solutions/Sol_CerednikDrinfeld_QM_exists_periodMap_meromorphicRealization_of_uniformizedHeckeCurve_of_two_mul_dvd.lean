theorem eventually_nhdsNE_smul_iff (g : GL (Fin 2) ℝ) (τ : UpperHalfPlane) (P : UpperHalfPlane → Prop) :
    (∀ᶠ z in 𝓝[≠] (g • τ), P z) ↔ ∀ᶠ z in 𝓝[≠] τ, P (g • z) := by
  rw [show g • τ = Homeomorph.smul g τ from rfl, ← (Homeomorph.smul g).map_punctured_nhds_eq τ,
    Filter.eventually_map]
  rfl

