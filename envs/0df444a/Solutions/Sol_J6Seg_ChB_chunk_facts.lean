/-!
# B-line value bounds 4: size arithmetic at `Q = segPF p d s`

All from the definition `segPF p d s = p + 1 + p/7 + size (NF d s)`, with
`NF d s ≥ (λ_F + 1)(2w + 1)(s + 1)²` (no regime hypotheses):
`p + 1 ≤ Q`, `7(R + 2) ≤ Q + 13`, `log₂ λ_F < Q`, `size (2w+1) ≤ Q`, `(s+1)² < 2^Q`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Val
open J6Seg

section ar
variable (p d s : ℕ)

theorem NF_pos_factors : (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 ≤ NF d s := by
  unfold NF
  have h1 : 1 ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) := by omega
  calc (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2
      = 1 * (lamF d + 1) * (2 * wF d + 1) * (s + 1) ^ 2 := by ring
    _ ≤ 1500 * ((lamF d + 1) * (3 * lamF d + 3) + 1) * (lamF d + 1) * (2 * wF d + 1) *
        (s + 1) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_right
        exact h1

theorem NF_lt_Q : NF d s < 2 ^ segPF p d s := by
  have h := Nat.lt_size_self (NF d s)
  exact h.trans_le (Nat.pow_le_pow_right (by norm_num) (by unfold segPF; omega))

theorem le_NF_lam : lamF d + 1 ≤ NF d s := by
  have := NF_pos_factors d s
  have h2 : 1 ≤ (2 * wF d + 1) * (s + 1) ^ 2 := Nat.one_le_iff_ne_zero.2 (by positivity)
  calc lamF d + 1 = (lamF d + 1) * 1 := by ring
    _ ≤ (lamF d + 1) * ((2 * wF d + 1) * (s + 1) ^ 2) := Nat.mul_le_mul_left _ h2
    _ = _ := by ring
    _ ≤ _ := this

theorem sevenR_le_Q : 7 * (p / 7 + 2) ≤ segPF p d s + 13 := by
  unfold segPF; omega

theorem log_lam_lt_Q : Nat.log 2 (lamF d) < segPF p d s := by
  have h1 : lamF d < 2 ^ segPF p d s :=
    lt_of_lt_of_le (by have := le_NF_lam d s; omega) (NF_lt_Q p d s).le
  by_cases h0 : lamF d = 0
  · rw [h0, Nat.log_zero_right]; unfold segPF; omega
  · have h2 := Nat.pow_log_le_self 2 h0
    have h3 : 2 ^ Nat.log 2 (lamF d) < 2 ^ segPF p d s := lt_of_le_of_lt h2 h1
    exact (Nat.pow_lt_pow_iff_right (by norm_num)).1 h3

end ar

end J6Seg.Val

