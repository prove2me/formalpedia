    (hcN : NLogN.GL.IsCnt cN) (p Q N : ℕ) (s : NLogN.IState NLogN.HS) (A U : List (ℤ × ℤ)) (R1 R2 LN LP : List NLogN.Item)
    (hA : s.G NLogN.GL.gZA = NLogN.gints A ++ R1) (hU : s.G NLogN.GL.gD = NLogN.gints U ++ R2) (hlA : A.length = N)
    (hlU : U.length = N) (hN : s.G cN = .int N :: LN) (hP : s.G NLogN.GL.gPP = .int (2 ^ p) :: LP)
    (hAb : NLogN.GL.GB m A) (hUb : NLogN.GL.GB m U) (hmQ : 2 * m + 1 ≤ Q) (hpQ : p + 1 ≤ Q)
    (hNQ : NLogN.zsz ((2 * N : ℕ) : ℤ) ≤ Q) :
    (NLogN.GL.zipP σ cN).run s = (s.upd NLogN.GL.gZA R1).upd NLogN.GL.gD (NLogN.gints (List.zipWith (NLogN.GL.gzF σ p) A U) ++ R2) ∧
    (NLogN.GL.zipP σ cN).ok M s ∧
    (NLogN.GL.zipP σ cN).cost M s ≤ N * (4 * Φm + 200000 * (Q + 2)) + 20000 * (Q + 2) := by
  have hne := NLogN.GL.isCnt_ne hcN
  simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hne
  obtain ⟨c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19,
    c20, c21, c22, c23⟩ := hne
  obtain ⟨f1, f2, f3, f4, f5, f6, f7, f8⟩ := NLogN.GL.cnt2_facts cN hcN s N LN Q hN hNQ
  have L := NLogN.GL.loop21 M (NLogN.GL.zipBody σ) NLogN.GL.gZA NLogN.GL.gD NLogN.GL.gZB NLogN.GL.gC1 NLogN.GL.gU1 NLogN.GL.genc NLogN.GL.genc NLogN.GL.genc (NLogN.GL.gzF σ p) s A U R1 R2
    (4 * Φm + 80000 * (Q + 2)) N Q (.reg cN) (by decide) hA hU hlA hlU f5 (NLogN.GL.zipBody_writes σ)
    (by
      intro x hx y hy t r1 r2 o hfr ht1 ht2 _
      have tP : t.G NLogN.GL.gPP = .int (2 ^ p) :: LP := by rw [hfr NLogN.GL.gPP (by decide), hP]
      have ht1' : t.G NLogN.GL.gZA = .int x.1 :: .int x.2 :: r1 := by simpa [NLogN.GL.genc] using ht1
      have ht2' : t.G NLogN.GL.gD = .int y.1 :: .int y.2 :: r2 := by simpa [NLogN.GL.genc] using ht2
      refine ⟨?_, NLogN.GL.zipBody_ok M hM σ p t x y r1 r2 LP ht1' ht2' tP (hAb x hx).1 (hAb x hx).2
          (hUb y hy).1 (hUb y hy).2,
        NLogN.GL.zipBody_cost M hM σ p Q t x y r1 r2 LP ht1' ht2' tP (hAb x hx).1 (hAb x hx).2
          (hUb y hy).1 (hUb y hy).2 hmQ hpQ⟩
      rw [NLogN.GL.zipBody_run σ p t x y r1 r2 LP ht1' ht2' tP]
      simp [NLogN.GL.genc])
    (by decide) f6 f7 trivial f8
  obtain ⟨Lr, Lo, Lc⟩ := L
  set W := List.zipWith (NLogN.GL.gzF σ p) A U with hW
  have hWl : W.length = N := by simp [hW, hlA, hlU]
  have hWb : NLogN.GL.GB (2 * m + 1) W := by
    intro w hw
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hw
    simp only [hW, List.getElem_zipWith]
    have hiA : i < A.length := by simp [hW] at hi; omega
    have hiU : i < U.length := by simp [hW] at hi; omega
    exact NLogN.GL.gzF_bnd σ p m _ _ (hAb _ (List.getElem_mem hiA)).1 (hAb _ (List.getElem_mem hiA)).2
      (hUb _ (List.getElem_mem hiU)).1 (hUb _ (List.getElem_mem hiU)).2
  set s1 := ((s.upd NLogN.GL.gZA R1).upd NLogN.GL.gD R2).upd NLogN.GL.gZB ((W.flatMap NLogN.GL.genc).reverse ++ s.G NLogN.GL.gZB) with hs1
  have s1B : s1.G NLogN.GL.gZB = NLogN.ints (NLogN.pairInts W).reverse ++ s.G gZB := by
    simp [hs1, NLogN.GL.flatMap_genc, NLogN.GL.gints_rev]
  have s1N : s1.G cN = .int N :: LN := by simp [hs1, c1, c2, c3, hN]
  obtain ⟨g1, g2, g3, g4, -⟩ := NLogN.GL.cnt2_facts cN hcN s1 N LN Q s1N hNQ
  obtain ⟨r2, o2, k2⟩ := NLogN.GL.mv_all M NLogN.GL.gZB NLogN.GL.gD NLogN.GL.gCV (NLogN.GL.cnt2 cN) s1 (NLogN.pairInts W).reverse (s.G NLogN.GL.gZB) Q
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) s1B
    (by rw [g1]; simp [NLogN.GL.pairInts_length, hWl]) g2 g3 (NLogN.GL.cnt2_lin cN) g4
    (by
      intro x hx
      exact (NLogN.GL.GB_pairInts hWb x (List.mem_reverse.1 hx)).trans (by omega))
  refine ⟨?_, ⟨Lo, ?_⟩, ?_⟩
  · show (NLogN.RM.rs _).run ((NLogN.RM.rep _ _ _).run s) = _
    rw [Lr, r2]
    apply NLogN.IState.ext' _ (by simp [hs1]) (by simp [hs1])
    intro x
    rw [List.reverse_reverse, ← NLogN.GL.gints_eq_ints]
    by_cases h1 : x = NLogN.GL.gD
    · subst h1; simp (config := {decide := true}) [hs1]
    by_cases h2 : x = NLogN.GL.gZB
    · subst h2; simp (config := {decide := true}) [hs1]
    by_cases h3 : x = NLogN.GL.gZA
    · subst h3; simp (config := {decide := true}) [hs1]
    simp [hs1, h1, h2, h3]
  · rw [Lr]; exact o2
  · show (NLogN.RM.rep _ _ _).cost M s + (NLogN.RM.rs _).cost M ((NLogN.RM.rep _ _ _).run s) ≤ _
    rw [Lr]
    simp only [List.length_reverse, NLogN.GL.pairInts_length, hWl, NLogN.GL.cnt2_size, NLogN.Ex.size] at Lc k2
    nlinarith
end
