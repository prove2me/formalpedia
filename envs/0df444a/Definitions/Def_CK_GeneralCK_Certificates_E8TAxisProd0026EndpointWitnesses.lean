    centerALowerYBox.Contains (Y (lower E8TAxisProd0026PaddedInputs.centerAInput.alpha)) := by
  have e : lower E8TAxisProd0026PaddedInputs.centerAInput.alpha = ((1899443256066344012630337314537754309230211955 : ℤ) : ℝ) / (scale precision : ℝ) := rfl
