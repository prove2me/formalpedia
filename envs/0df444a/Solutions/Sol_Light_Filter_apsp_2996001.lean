  omega

/-- `cap ≤ n²`. -/
theorem oCap_le (n p : ℕ) : oCap n p ≤ n * n := by
  rw [oCap, Nat.ceilDiv_eq_add_pred_div]
  rcases Nat.eq_zero_or_pos p with rfl | hp
  · simp
  · rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp; omega
    · have : 1 ≤ n * n := Nat.one_le_iff_ne_zero.2 (by positivity)
      have : n * n + p ≤ p * (n * n) + 1 := by nlinarith
      exact Nat.div_le_of_le_mul (by omega)

/-- `p · cap ≥ n²`. -/
theorem le_mul_oCap {n p : ℕ} (hp : 1 ≤ p) : n * n ≤ oCap n p * p := by
  rw [oCap, Nat.ceilDiv_eq_add_pred_div]
  have h1 := Nat.div_add_mod (n * n + p - 1) p
  have h2 := Nat.mod_lt (n * n + p - 1) (show 0 < p by omega)
  generalize (n * n + p - 1) / p = q at *
  generalize (n * n + p - 1) % p = r at *
  rw [Nat.mul_comm] at h1
  omega

/-- The number of blocks. -/
theorem oData_h (n s p : ℕ) (AB BC AC : List ℤ) :
    (oData n s p AB BC AC).h = (n + s - 1) / s := Nat.ceilDiv_eq_add_pred_div _ _

/-- There are at most `2p` chunks. -/
theorem oData_chunkCount_le {n s p : ℕ} {AB BC AC : List ℤ} (hn : 1 ≤ n) (hp : 1 ≤ p) :
    (oData n s p AB BC AC).chunkCount ≤ 2 * p := by
  have hv : ∀ i, (oData n s p AB BC AC).RAB.getD i 0 < p := fun i => by
