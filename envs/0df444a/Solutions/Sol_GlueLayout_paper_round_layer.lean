namespace GlueLayout

open Finset Butterfly AModel Synth

/-! ## 0. Bit arithmetic -/

/-! ## 1. Selected bits given by positions; transport -/

variable {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]

/-! ## 2. Slot arrangements are coordinate layouts -/

/-! ## 3. Chunk positions are Proposition 14's `layerSel` -/

/-! ## 4. The paper's layout `tgtL` -/

section Paper

variable (D ℓ K : ℕ) [NeZero D] (long : Fin D → Bool)

lemma length_tgtL (hK : 0 < K) (hℓ : 1 ≤ ℓ) :
    (tgtL D ℓ K long).length = (lstL D ℓ K long).length + D * qq ℓ K * K := by
  rw [(tgtL_perm D ℓ K long hK hℓ).length_eq, length_initL D ℓ K long hK hℓ]

variable {R : Type*} [CommRing R] [Algebra ℂ R] (y : Rˣ)

/-! ### The chunk rounds are Proposition 14's layer -/

/-- **Lemma 16 ↔ Proposition 14.** For a slot `b ≤ h < b + qK`, every axis takes part in round
`h`, and the round's selected bits act exactly as `layerSel (2^A) K D (2^B) ρ`: bit
`ρ = (h-b) mod K` of each of the `D` consecutive `K`-bit chunks of group `j₀` (`tgt_slot`). -/
theorem paper_round_layer_sol_aux (hK : 0 < K) (hℓ : 1 ≤ ℓ) {h : ℕ} (hb : bb ℓ K ≤ h)
    (hh : h < bb ℓ K + qq ℓ K * K) (M : M2) {X : Type*} [AddCommMonoid X] [Module ℂ X]
    (xs : List X) :
    selOp (paperSel D ℓ K long hK hℓ h) (tens M) xs =
      selOp (layerSel (2 ^ preA D ℓ K long h) K D (2 ^ sufB D ℓ K h) (rhoOf ℓ K h)
        (rhoOf_lt ℓ K hK h)) (tens M) xs := by
  have hbq : bb ℓ K + qq ℓ K * K = ℓ - 1 := by
    unfold bb qq; rw [Nat.mul_comm]; exact Nat.mod_add_div _ _
  have hall : ∀ i, i ∈ partAxes (al D ℓ long) h := by
    intro i
    simp only [partAxes, Finset.mem_filter, Finset.mem_univ, true_and]
    unfold al; split_ifs <;> omega
  set ee := eIdx ℓ K h with hee
  have he : ee < qq ℓ K * K := by simp only [hee, eIdx]; omega
  have hj : ee / K < qq ℓ K := by rw [Nat.div_lt_iff_lt_mul hK]; exact he
  have hm : ee % K < K := Nat.mod_lt _ hK
  have hS := paperArr D ℓ K long hK hℓ
  refine chunk_bridge (rhoOf_lt ℓ K hK h) (A := preA D ℓ K long h) (B := sufB D ℓ K h) ?_
    (slotPos hS h (partAxes (al D ℓ long) h) partAxes_lt) (Equiv.subtypeUnivEquiv hall) ?_ M xs
  · -- the length
    rw [length_tgtL D ℓ K long hK hℓ]
    unfold preA sufB jGrp
    rw [← hee]
    have : ee / K * D * K + D * K + (qq ℓ K - 1 - ee / K) * D * K = D * qq ℓ K * K := by
      have hq : ee / K + 1 + (qq ℓ K - 1 - ee / K) = qq ℓ K := by omega
      calc ee / K * D * K + D * K + (qq ℓ K - 1 - ee / K) * D * K
          = (ee / K + 1 + (qq ℓ K - 1 - ee / K)) * D * K := by ring
        _ = D * qq ℓ K * K := by rw [hq]; ring
    omega
  · intro i
    show spos D (tgtL D ℓ K long) i h = _
    obtain ⟨hslot, hoff⟩ := tgt_slot D ℓ K long hK i hb hh
    have hee' : qq ℓ K * K - 1 - (h - bb ℓ K) = ee := rfl
    rw [hee'] at hslot hoff
    have hlt : (lstL D ℓ K long).length + (ee / K * D + i) * K + ee % K <
        (tgtL D ℓ K long).length := by
      rw [length_tgtL D ℓ K long hK hℓ]
      have h1 : (ee / K * D + i) * K + K ≤ D * qq ℓ K * K := by
        have : ee / K * D + i + 1 ≤ D * qq ℓ K := by
          have : (ee / K + 1) * D ≤ qq ℓ K * D := Nat.mul_le_mul_right _ hj
          have hi := i.isLt
          nlinarith
        calc (ee / K * D + i) * K + K = (ee / K * D + i + 1) * K := by ring
          _ ≤ D * qq ℓ K * K := Nat.mul_le_mul_right _ this
      omega
    unfold spos
    rw [List.getD_eq_getElem _ _ hlt] at hslot
    rw [← hslot, hS.nodup.idxOf_getElem _ hlt]
    unfold preA jGrp rhoOf
    rw [← hee]
    have : (ee / K * D + i) * K = ee / K * D * K + i * K := by ring
    omega

end Paper

end GlueLayout

