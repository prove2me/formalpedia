variable {W T m : ℕ} [NeZero W]

theorem foldl_pull_length (sh : Shape) (l : List (ℕ × ℕ)) (xs : List (ZMod 2))
    (h : xs.length = vol sh) :
    (l.foldl (fun ys pr => pull sh sh (swapPos pr.1 pr.2) 0 ys) xs).length = vol sh := by
  induction l generalizing xs with
  | nil => exact h
  | cons pr l ih => exact ih _ (length_pull _ _ _ _ _)

theorem tailSwaps_length (sh : Shape) (c c' r : ℕ) (xs : List (ZMod 2)) (h : xs.length = vol sh) :
    (Bit.tailSwaps sh c c' r xs).length = vol sh :=
  foldl_pull_length sh _ xs h

theorem levelH_length (C : Bit.QHNet (ZMod 2) W T m) (q e P L : ℕ) (A B Cs : Shape)
    (child : ℕ × ℕ × ℕ → List (ZMod 2) → List (ZMod 2)) (xs : List (ZMod 2)) (hm : 1 ≤ m)
    (hWL : W ∣ L) :
    (Bit.levelH C (q ^ (e / m)) P (L / W) A (List.replicate (e % m) q ++ B)
      (List.replicate (e % m) q ++ Cs) child xs).length = vol (P :: L :: hdShape A B Cs e q) := by
  simp only [Bit.levelH, length_rowMerge]
  rw [Nat.mul_div_cancel' hWL, vol_lev_big P L A B Cs q m e hm]

theorem progH_length (C : Bit.QHNet (ZMod 2) W T m) (q e P L : ℕ) (A B Cs : Shape)
    (xs : List (ZMod 2)) (hm : 1 ≤ m) (hWL : m ≤ e → W ∣ L)
    (hxs : xs.length = vol (P :: L :: hdShape A B Cs e q)) :
    (Bit.progH C q e P L A B Cs xs).length = vol (P :: L :: hdShape A B Cs e q) := by
  rw [Bit.progH]
  split_ifs with he
  · exact tailSwaps_length _ _ _ _ _ (levelH_length C q e P L A B Cs _ xs hm (hWL he))
  · exact tailSwaps_length _ _ _ _ _ hxs

theorem pos_app {X Y : Shape} (hX : ∀ x ∈ X, 1 ≤ x) (hY : ∀ x ∈ Y, 1 ≤ x) : ∀ x ∈ X ++ Y, 1 ≤ x := by
  intro x hx
  rcases List.mem_append.1 hx with h | h
  · exact hX x h
  · exact hY x h

theorem pos_rep {k y : ℕ} (hy : 1 ≤ y) : ∀ x ∈ List.replicate k y, 1 ≤ x :=
  fun x hx => (List.eq_of_mem_replicate hx) ▸ hy

/-- The child stream volume is the level stream volume. -/
theorem vol_child {q e P L' : ℕ} {A B Cs : Shape} (ρ : ℕ × ℕ × ℕ) (hi : ρ.1 + ρ.2.2 ≤ m)
    (hj : ρ.2.1 + ρ.2.2 ≤ m) :
    vol (P :: L' :: hdShape (A ++ List.replicate ρ.1 (q ^ (e / m)))
      (List.replicate (m - ρ.1 - ρ.2.2) (q ^ (e / m)) ++
        ((List.replicate (e % m) q ++ B) ++ List.replicate ρ.2.1 (q ^ (e / m))))
      (List.replicate (m - ρ.2.1 - ρ.2.2) (q ^ (e / m)) ++ (List.replicate (e % m) q ++ Cs))
      (ρ.2.2 * (e / m)) q) =
    vol (P :: L' :: hdShape A (List.replicate (e % m) q ++ B) (List.replicate (e % m) q ++ Cs) m
      (q ^ (e / m))) := by
  simp only [vol_cons]
  rw [← Bit.vol_hdShape_digits, Bit.hdShape_child _ _ _ hi hj]

theorem level_vol {q e P L : ℕ} {A B Cs : Shape} (hm : 1 ≤ m) (hWL : W ∣ L) :
    vol (P :: L / W :: hdShape A (List.replicate (e % m) q ++ B) (List.replicate (e % m) q ++ Cs) m
      (q ^ (e / m))) = vol (P :: L :: hdShape A B Cs e q) / W := by
