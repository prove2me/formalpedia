variable {P K D S ρ : ℕ}
theorem solution {r F Δ : ℕ} {zs : List NLogN.KFB.GI} {xs : List (Fin r → ℂ)}
    (h : NLogN.KFH.RecRep r (F + Δ) zs xs) (hd : ∀ z ∈ zs, (2 : ℤ) ^ Δ ∣ z.1 ∧ (2 : ℤ) ^ Δ ∣ z.2) :
    NLogN.KFH.RecRep r F (zs.map (NLogN.KFH.gtr Δ)) xs := by
  refine ⟨by simp [h.1], fun j c hj => ?_⟩
  have hjr : j * r + c < zs.length := by
    rw [h.1]; have := c.isLt
    calc j * r + c < j * r + r := by omega
      _ = (j + 1) * r := by ring
      _ ≤ xs.length * r := Nat.mul_le_mul_right _ hj
  have e := h.2 j c hj
  rw [List.getD_eq_getElem _ _ (by simpa using hjr), List.getElem_map]
  rw [List.getD_eq_getElem _ _ hjr] at e
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩⟩ := hd _ (List.getElem_mem hjr)
  have hg : NLogN.KFH.gtr Δ zs[j * r + ↑c] = (a, b) := by
    simp only [NLogN.KFH.gtr, ha, hb]
    rw [Int.mul_tdiv_cancel_left _ (pow_ne_zero _ two_ne_zero), Int.mul_tdiv_cancel_left _ (pow_ne_zero _ two_ne_zero)]
  have hz : NLogN.KFB.toC zs[j * r + ↑c] = 2 ^ Δ * NLogN.KFB.toC (a, b) := by
    rw [show zs[j * r + ↑c] = ((2 : ℤ) ^ Δ * a, (2 : ℤ) ^ Δ * b) by
      rw [← ha, ← hb]]
    simp [NLogN.KFB.toC]; ring
  rw [hg]
  rw [hz, pow_add] at e
  have h2 : (2 : ℂ) ^ Δ ≠ 0 := pow_ne_zero _ two_ne_zero
  apply mul_left_cancel₀ h2
  rw [e]; ring
end
