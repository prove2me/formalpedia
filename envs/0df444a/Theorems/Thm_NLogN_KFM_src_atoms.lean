theorem NLogN.KFM.src_atoms {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) :
    let A := 2 ^ (2 * bP n + 2)
    dpN n ≤ A ∧ srcQ (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) ≤ A ∧ srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n / 2) ≤ A ∧
      srcM (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.rP n) (IntMul.OpenAI.Glue.rP n) ≤ A ∧ IntMul.OpenAI.Glue.dP n ≤ A ∧ IntMul.OpenAI.Glue.rP n * IntMul.OpenAI.Glue.rP n ≤ A := by sorry
