open OAI OAI.CriticalZ3 OAI.CriticalZ3.Coarse OAI.CriticalZ3.Coarse.Exploration
open _root_.MeasureTheory ProbabilityTheory Classical Filter Topology Function
open scoped ENNReal BigOperators Matrix
open _root_.MeasureTheory ProbabilityTheory Classical InfiniteConditioning
variable {m : Model} {r : ℕ}


theorem solution (s : Exploration m r) (q : Set.Icc (0:ℝ) 1) (δ : ℝ) (ω : m.Config) :
    s.visited ⊆ (s.advance q δ ω).visited := by
  intro x hx
  unfold Exploration.visited at hx ⊢
  unfold Exploration.advance
  rcases hq : s.queue with _ | ⟨t, ts⟩
  · simpa [hq] using hx
  · simp only [hq, Finset.mem_union, List.mem_toFinset, List.mem_map, List.map_cons,
      List.mem_cons, Finset.mem_insert, List.map_append, List.mem_append] at hx ⊢
    rcases hx with hx | hx | hx
    · exact Or.inl (Or.inr hx)
    · exact Or.inl (Or.inl hx)
    · exact Or.inr (Or.inl hx)

