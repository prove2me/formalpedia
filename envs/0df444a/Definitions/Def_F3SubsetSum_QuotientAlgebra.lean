-- title:
--   Annihilating polynomials $f_i$, candidate set $\mathcal C$ and the ideal $J$ (eqs. (25)–(27))
-- statement:
--   Let $q\ge3$ be prime, $S=\mathbb F_q[x_1,\dots,x_n]$, and $(A,b)\in\mathbb F_q^{n\times m}\times\mathbb F_q^m$ with columns $a_1,\dots,a_m$ of $A$. Put
--
--   $$
--   L_i(x)=\langle a_i,x\rangle,\qquad f_i(x)=(L_i(x)-b_i)(L_i(x)-b_i+1).
--   $$
--
--   The **candidate set** is $\mathcal C=\{u\in\mathbb F_q^n : f_i(u)=0\text{ for all }i\in[m]\}$; since $f_i(u)=0$ exactly when $b_i-L_i(u)\in\{0,1\}$, the planted secret of a Binary-Error LWE instance lies in $\mathcal C$. The ideal
--
--   $$
--   J=(f_1,\dots,f_m,\ x_1^q-x_1,\dots,x_n^q-x_n)\subseteq S
--   $$
--
--   collects the sample equations and the field equations; the quotient $S/J$ encodes $\mathcal C$ (Claim 4.1, Corollary 4.2).
--
--   **Formalization Note** The linear form of $a\in K^n$ is $\sum_j a_jx_j$; `cols A i` is column $i$ of $A$.
-- source:
--   Kothari, Metger, O'Donnell, Shutty, Wu, Exponential quantum speedup for F_3^n-Subset-Sum? Or, rigorous classical algorithms for Binary-Error LWE, arXiv:2609.40321v1, §4.1, eqs. (25)–(27), p.17

import Mathlib

namespace F3SubsetSum

open MvPolynomial

/-- **The linear form** `L(x) = ⟨a, x⟩ = Σ_j a_j x_j ∈ K[x_1, …, x_n]` of a vector `a ∈ Kⁿ`.
Kothari, Metger, O'Donnell, Shutty, Wu, arXiv:2609.40321v1, eq. (25), p.17:
"L_i(x) = ⟨a_i, x⟩". -/
noncomputable def linForm {K : Type*} [CommRing K] {n : ℕ} (a : Fin n → K) :
    MvPolynomial (Fin n) K :=
  ∑ j, C (a j) * X j

/-- **The columns** `a_1, …, a_m ∈ Kⁿ` of a matrix `A ∈ K^{n×m}` (p.17: "let a_i denote column i
of A"): `cols A i j = A j i`. -/
def cols {K : Type*} {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) : Fin m → Fin n → K :=
  fun i j => A j i

/-- **The annihilating polynomial** `f_i(x) = (L_i(x) − b_i)(L_i(x) − b_i + 1)` of sample `i`
(eq. (25), p.17), where `L_i = ⟨a_i, x⟩` and `a_i` is column `i` of `A ∈ F_q^{n×m}`. It vanishes
at `u ∈ F_qⁿ` exactly when `b_i − L_i(u) ∈ {0, 1}`. -/
noncomputable def fPoly {q n m : ℕ} (A : Matrix (Fin n) (Fin m) (ZMod q)) (b : Fin m → ZMod q)
    (i : Fin m) : MvPolynomial (Fin n) (ZMod q) :=
  (linForm (cols A i) - C (b i)) * (linForm (cols A i) - C (b i) + 1)

/-- **The candidate set** `𝒞 = {u ∈ F_qⁿ : f_i(u) = 0 for all i ∈ [m]}` (eq. (26), p.17). For a
Binary-Error LWE instance `b = A⊤s + e` with `e ∈ {0,1}^m`, the planted secret `s` lies in `𝒞`;
"there is a unique candidate s" means `𝒞 = {s}`. -/
def candidates {q n m : ℕ} (A : Matrix (Fin n) (Fin m) (ZMod q)) (b : Fin m → ZMod q) :
    Set (Fin n → ZMod q) :=
  {u | ∀ i, eval u (fPoly A b i) = 0}

/-- **The ideal** `J = (f_1, …, f_m, x_1^q − x_1, …, x_n^q − x_n) ⊆ S = F_q[x_1, …, x_n]`
(eq. (27), p.17), generated by the annihilating polynomials and the field equations. -/
noncomputable def idealJ {q n m : ℕ} (A : Matrix (Fin n) (Fin m) (ZMod q)) (b : Fin m → ZMod q) :
    Ideal (MvPolynomial (Fin n) (ZMod q)) :=
  Ideal.span (Set.range (fPoly A b) ∪ Set.range fun j : Fin n => (X j) ^ q - X j)

end F3SubsetSum


