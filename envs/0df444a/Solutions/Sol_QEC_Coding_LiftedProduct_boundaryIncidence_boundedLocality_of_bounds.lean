    (D : Data F G aRow aCol bRow bCol) {B : Nat}
    (hrow1 : ∀ c0, (boundary1RowSupport D c0).card ≤ B)
    (hrow2 : ∀ c2, (boundary2RowSupport D c2).card ≤ B)
    (hcol : ∀ q, ((boundaryIncidence D).variableSupport q).card ≤ B) :
