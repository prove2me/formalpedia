theorem ModularCurve.UVCrossingModel.exists_ringEquiv_quotient_span_U_quotient_span_V {W : Type*} [CommRing W] (π : W) : ∃ e : (UVCrossingModel W π ⧸ Ideal.span {U π}) ≃+* (UVCrossingModel W π ⧸ Ideal.span {V π}), ∀ x : UVCrossingModel W π, e (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ (crossingSwap π x) := by sorry
