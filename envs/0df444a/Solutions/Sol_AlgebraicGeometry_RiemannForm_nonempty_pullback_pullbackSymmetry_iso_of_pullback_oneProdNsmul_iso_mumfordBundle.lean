  let 𝓟' := Sσ.obj 𝓟
  have h𝓟' : Scheme.Modules.IsInvertible 𝓟' := h𝓟.pullback σ
  have h₂' : Nonempty (S.obj 𝓟' ≅ 𝟙_ _) := h₃
  have h₃' : Nonempty (S.obj (Sσ.obj 𝓟') ≅ 𝟙_ _) := by
    obtain ⟨e⟩ := h₂; exact ⟨S.mapIso (eσσ 𝓟) ≪≫ e⟩

  obtain ⟨eP⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_oneProdNsmul_iso_tensorPow_of_birigidified
    k f L hc hA g hdim 𝓟 h𝓟 h₂ h₃ ℓ
  obtain ⟨eP'⟩ := AlgebraicGeometry.Polarisation.nonempty_pullback_oneProdNsmul_iso_tensorPow_of_birigidified
