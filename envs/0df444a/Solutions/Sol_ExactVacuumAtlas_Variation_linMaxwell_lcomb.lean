/-! ## Linearity (4D, admissible `C^∞` class) -/

theorem pd_lcomb {n : ℕ} {U : Set (Pt n)} (hU : IsOpen U) {u v : Pt n → ℝ} (hu : ContDiffOn ℝ ∞ u U)
    (hv : ContDiffOn ℝ ∞ v U) (c₁ c₂ : ℝ) {y : Pt n} (hy : y ∈ U) (i : Fin n) :
    pd i (fun z => c₁ * u z + c₂ * v z) y = c₁ * pd i u y + c₂ * pd i v y := by
  rw [pd_add_of hU hy i (contDiffOn_const.mul hu) (contDiffOn_const.mul hv),
    pd_const_mul_of hU hy i c₁ hu, pd_const_mul_of hU hy i c₂ hv]

section lin

variable {U : Set (Pt 4)} {g ginv h₁ h₂ : Metric 4} {F f₁ f₂ : TwoForm 4} (c₁ c₂ : ℝ)

theorem invVar_lcomb (a b : Fin 4) (y : Pt 4) :
    invVar ginv (lcomb c₁ h₁ c₂ h₂) a b y = c₁ * invVar ginv h₁ a b y + c₂ * invVar ginv h₂ a b y := by
  simp only [invVar, lcomb, Fin.sum_univ_four]
  ring

theorem raise2Var_lcomb (a b : Fin 4) (y : Pt 4) :
    raise2Var ginv (lcomb c₁ h₁ c₂ h₂) F (lcomb c₁ f₁ c₂ f₂) a b y =
      c₁ * raise2Var ginv h₁ F f₁ a b y + c₂ * raise2Var ginv h₂ F f₂ a b y := by
  simp only [raise2Var, invVar_lcomb]
  simp only [lcomb, Fin.sum_univ_four]
