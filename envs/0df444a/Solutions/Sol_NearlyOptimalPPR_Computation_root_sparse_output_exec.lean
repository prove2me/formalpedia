set_option maxHeartbeats 2400000 in
lemma pruned_output_loop_exec (m : SolveModel) {n : ℕ} (g : InputGraph n) (ω : ℕ → Bool)
    (vertices : List (Fin n)) (head : ℤ) (F : Finset ℤ) (width : ℕ) (α clip : ℝ) (z : Fin n → ℝ)
    (st : MachineState) (hh : st.scalar.halted=false)
    (h0 : st.scalar.core.ptrs 0=0) (h41 : st.scalar.core.ptrs 41=(width : ℤ)) (hhead : st.scalar.core.ptrs 94=head)
    (h : VertexListRep st.scalar.integerMemory head vertices F) (ha : st.scalar.core.regs 30=α) (hClip : st.scalar.core.regs 32=clip)
    (hz : ∀ v ∈ vertices, st.scalar.core.mem (vertexRecordAddress width v.val 0)=z v)
    (hdeg : ∀ v ∈ vertices, st.scalar.integerMemory (vertexRecordAddress width v.val 0)=((g.neighbors v).length : ℤ)) :
    ∃ out, MachineEval m g ω prunedOutputLoopCode st ((8*width+31)*vertices.length+1) out ∧
      out.scalar.integerMemory=st.scalar.integerMemory ∧ out.scalar.core.mem=st.scalar.core.mem ∧
      out.scalar.queries=st.scalar.queries ∧ out.work=st.work+((8*width+31)*vertices.length+1 : ℕ) ∧
      out.output=st.output++vertices.map (fun v => ((v.val : ℤ),α*((g.neighbors v).length : ℝ)*max (z v-clip) 0)) ∧ out.scalar.halted=false := by
  induction vertices generalizing st head F with
  | nil =>
    have hhead' : st.scalar.core.ptrs 94=0 := hhead.trans h.nil.1
    refine ⟨payUnit st,MachineEval.pointerDone hh (by rw [hhead',h0]),rfl,rfl,rfl,by simp [payUnit,pcSet],by simp [payUnit,pcSet],hh⟩
  | cons v vertices ih =>
    obtain ⟨next,S,hpos,hkey,hchild,hnext,hTail,hF,hsep⟩ := h.cons_view
    obtain ⟨mid,eb,hm94,hmI,hmR,hmQ,hmW,hmO,hmH⟩ := pruned_output_body_exec m g ω (payUnit st) hh width head next v α (z v) clip
      h0 h41 hhead hkey hnext (hdeg v (by simp)) ha hClip (hz v (by simp))
    have hm0 := (eb.pointer_frame 0 (by decide)).trans h0
    have hm41 := (eb.pointer_frame 41 (by decide)).trans h41
    have hm30 := (eb.real_register_frame 30 (by decide)).trans ha
    have hm32 := (eb.real_register_frame 32 (by decide)).trans hClip
    have hmTail : VertexListRep mid.scalar.integerMemory next vertices S := by rw [hmI]; exact hTail
    have hmz : ∀ u ∈ vertices, mid.scalar.core.mem (vertexRecordAddress width u.val 0)=z u := by
      intro u hu; rw [hmR]; exact hz u (by simp [hu])
    have hmd : ∀ u ∈ vertices, mid.scalar.integerMemory (vertexRecordAddress width u.val 0)=((g.neighbors u).length : ℤ) := by
      intro u hu; rw [hmI]; exact hdeg u (by simp [hu])
    obtain ⟨out,er,hoI,hoR,hoQ,hoW,hoO,hoH⟩ := ih next S (payUnit mid) hmH hm0 hm41 hm94 hmTail hm30 hm32 hmz hmd
    have ex : MachineEval m g ω prunedOutputLoopCode st ((8*width+31)*(v::vertices).length+1) out := by
      have e := MachineEval.pointerNext (r:=94) (s:=0) hh (by rw [hhead,h0]; omega) eb er
      convert e using 1 <;> (first | rfl | simp only [List.length_cons]; ring)
    refine ⟨out,ex,hoI.trans hmI,hoR.trans hmR,hoQ.trans hmQ,?_,?_,hoH⟩
    · rw [hoW,payUnit_work,hmW,payUnit_work]
      push_cast
      simp only [List.length_cons]
      push_cast
      ring
    · rw [hoO]
      change mid.output++_ = _
      rw [hmO]
      simp [payUnit,pcSet,List.append_assoc]

end
