set_option linter.unusedSimpArgs false

namespace NLogN.Rsp

open IntMul NLogN RS

/-- The weight: `0` for `h = 0`, else the `expNeg` value on `19`. -/
def wEE : Ex HS := .sel (.neg (.mul hE hE)) (.reg 19) (.lit 0)

/-- The `E` weight program. -/
def eWP : RS :=
  NLogN.RS.seq (push 16 (.reg TP)) (NLogN.RS.seq (push 17 (.reg TK2)) (NLogN.RS.seq (push 18 XEE) (NLogN.RS.seq expNegP
    (NLogN.RS.seq (push NLogN.Rsp.BW wEE) (NLogN.RS.seq (pop 19) (NLogN.RS.seq (pop 18) (NLogN.RS.seq (pop 17) (pop 16))))))))

def eWf (p s t m A K2 : ℕ) (i l : ℕ) : ℤ :=
  if i = m then 0 else HvdH.expNeg p K2 (A * (HvdH.eKz s t l ((i : ℤ) - m)).toNat)

def eWCost (p Bq : ℕ) : ℕ := 400 * 10 ^ 7 * (Bq + 2) ^ 2 + expNegCost p Bq Bq

