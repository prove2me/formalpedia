-- Source module: Solutions.J6SegKs1
/-!
# B3′, part 1: computing the Kronecker constants of a block in the kernel

`kgRS` (with `j` on `kK`, `m = b·2n` on `kJ`, `2^pk` on `kc`, `2^b` on `kB`, scratch `vX, vY, CN`):
`acc := 2^pk`, `ρ := 2^b`; `j` times `acc := acc + acc·ρ`, `ρ := ρ·ρ` (so `acc = KFV.kG b 2^k 2^pk`,
`ρ = 2^(b 2^k)`); then `kJ := 2^m`, `kK := acc mod 2^m = KFV.kG b (2n) 2^pk`, `kJ := 2^m · 2^m`.
Cost `O(j · b 2^j + pow2Cost m)` — linear in `n b` up to the factor `j = clog₂ 2n`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

/-! ## `kG` arithmetic -/

theorem kG_succ (b r : ℕ) (c : ℤ) : KFV.kG b (r + 1) c = KFV.kG b r c + c * (2 ^ b : ℤ) ^ r := by
  simp [KFV.kG, Finset.sum_range_succ]

theorem kG_zero (b : ℕ) (c : ℤ) : KFV.kG b 0 c = 0 := by simp [KFV.kG]

theorem kG_add (b r : ℕ) (c : ℤ) : ∀ k, KFV.kG b (r + k) c = KFV.kG b r c + (2 ^ b : ℤ) ^ r * KFV.kG b k c
  | 0 => by simp [kG_zero]
  | k + 1 => by
    rw [← Nat.add_assoc, kG_succ, kG_add b r c k, kG_succ, pow_add]; ring

theorem kG_nonneg (b : ℕ) {c : ℤ} (hc : 0 ≤ c) : ∀ r, 0 ≤ KFV.kG b r c
  | 0 => by simp [kG_zero]
  | r + 1 => by rw [kG_succ]; have := kG_nonneg b hc r; positivity

theorem kG_lt (b : ℕ) {c : ℤ} (hc : 0 ≤ c) (hcb : c < 2 ^ b) : ∀ r, KFV.kG b r c < (2 ^ b : ℤ) ^ r
  | 0 => by simp [kG_zero]
  | r + 1 => by
    rw [kG_succ, pow_succ]
    have h1 := kG_lt b hc hcb r
    have h2 : (0 : ℤ) < (2 ^ b : ℤ) ^ r := by positivity
    nlinarith

theorem kG_double (b r : ℕ) (c : ℤ) :
    KFV.kG b (2 * r) c = KFV.kG b r c + KFV.kG b r c * (2 ^ b : ℤ) ^ r := by
  rw [two_mul, kG_add]; ring

theorem kG_mod (b : ℕ) {c : ℤ} (hc : 0 ≤ c) (hcb : c < 2 ^ b) {m R : ℕ} (h : m ≤ R) :
    (KFV.kG b R c).tmod ((2 ^ b : ℤ) ^ m) = KFV.kG b m c := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  rw [Int.tmod_eq_emod_of_nonneg (kG_nonneg b hc _), kG_add, Int.add_mul_emod_self_left]
  exact Int.emod_eq_of_lt (kG_nonneg b hc _) (kG_lt b hc hcb _)

/-! ## `2^m` by `pow2` -/

theorem sp_asgPow2 (s : IState HS) (f : Fin HS → List ℤ) {i : Fin HS} {m : ℕ} {l : List ℤ}
    {B : ℕ} (hi : i.val < 56) (hf : f i = (m : ℤ) :: l) (hm : zsz (m : ℤ) ≤ B)
    (hmB : m + 1 ≤ B) :
    Sp (.asg i (.pow2 (.reg i))) (encK s f) (encK s (Function.update f i ((2 : ℤ) ^ m :: l)))
      (cP2 m B) := by
  refine ⟨⟨hi, clean_reg hi, ⟨ok_reg hf, by simp [Ex.eval, top_encK hf]⟩, isInt_encK hf⟩, ?_, ?_⟩
  · simp only [RS.run]
    rw [← encK_upd]; simp [hf, ints, Ex.eval, top_encK hf]
  · have hr := Ex.cost_le_lin (encK s f) B (.reg i) trivial (bnd_reg hf hm)
    have h2 : zsz ((2 : ℤ) ^ m) ≤ B := by rw [zsz_two_pow]; exact hmB
    simp only [Ex.size] at hr
    simp only [RS.cost, RS.asgCost, Ex.cost, Ex.eval, top_encK hf, Int.toNat_natCast]
    simp only [Ex.cost, top_encK hf] at hr
    have mv : ∀ x y : ℕ, x ≤ y → moveCost x ≤ moveCost y := fun x y h => by
      unfold moveCost; nlinarith
    have := mv _ _ hm; have := mv _ _ h2
    unfold cP2; omega

/-! ## The constants of one block -/

theorem clean_shl {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.shl a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem clean_rem {a b : Ex HS} (ha : a.Clean) (hb : b.Clean) : (Ex.rem a b).Clean := by
  intro j hj
  simp only [Ex.regs, List.mem_append] at hj
  rcases hj with hj | hj
  · exact ha j hj
  · exact hb j hj

theorem zsz_lt_pow {x : ℤ} {M : ℕ} (h0 : 0 ≤ x) (h : x < 2 ^ M) : zsz x ≤ M :=
  NLogN.zsz_le_of_abs (by rw [abs_of_nonneg h0]; exact h)

set_option maxHeartbeats 4000000 in
/-- **The block constants by doubling.** -/
theorem sp_kg_sol_aux (s : IState HS) (F : Fin HS → List ℤ) {pk b j n Bk : ℕ}
    (hX : F vX = []) (hY : F vY = []) (hCN : F CN = []) (hc : F kc = [2 ^ pk])
    (hB : F kB = [2 ^ b]) (hK : F kK = [(j : ℤ)]) (hJ : F kJ = [((b * (2 * n) : ℕ) : ℤ)])
    (hpk : pk < b) (hnj : 2 * n ≤ 2 ^ j) (hBk : b * 2 ^ j + 2 ≤ Bk)
    (hBm : 2 * (b * (2 * n)) + 2 ≤ Bk) (hBj : zsz (j : ℤ) ≤ Bk) :
    Sp kgRS (encK s F) (encK s (Function.update (Function.update F kK [KFV.kG b (2 * n) (2 ^ pk)])
      kJ [(2 ^ b) ^ (2 * (2 * n))])) (cKG j (b * (2 * n)) Bk) := by
  set m := b * (2 * n) with hm
  set c : ℤ := 2 ^ pk with hcdef
  have c0 : 0 ≤ c := by positivity
  have cb : c < 2 ^ b := pow_lt_pow_right₀ (by norm_num) hpk
  let A : ℕ → ℤ := fun k => KFV.kG b (2 ^ k) c
  let Rr : ℕ → ℤ := fun k => 2 ^ (b * 2 ^ k)
  have hAlt : ∀ k, 0 ≤ A k ∧ A k < 2 ^ (b * 2 ^ k) := fun k =>
    ⟨kG_nonneg b c0 _, by have := kG_lt b c0 cb (2 ^ k); rwa [← pow_mul] at this⟩
  have hjm : ∀ k ≤ j, b * 2 ^ k ≤ b * 2 ^ j := fun k hk =>
    Nat.mul_le_mul_left _ (Nat.pow_le_pow_right (by norm_num) hk)
  have hAz : ∀ k ≤ j, zsz (A k) ≤ Bk := fun k hk =>
    le_trans (zsz_lt_pow (hAlt k).1 (hAlt k).2) (by have := hjm k hk; omega)
  have hRz : ∀ k ≤ j, zsz (Rr k) ≤ Bk := fun k hk => by
    simp only [Rr]; rw [zsz_two_pow]; have := hjm k hk; omega
  let Fk : ℕ → Fin HS → List ℤ := fun k =>
    Function.update (Function.update F vX [A k]) vY [Rr k]
  have FkX : ∀ k, Fk k vX = [A k] := fun k => by
    simp only [Fk]; rw [Function.update_of_ne (by decide), Function.update_self]
  have FkY : ∀ k, Fk k vY = [Rr k] := fun k => by simp only [Fk]; rw [Function.update_self]
  have FkO : ∀ k (x : Fin HS), x ≠ vX → x ≠ vY → Fk k x = F x := fun k x h1 h2 => by
    simp only [Fk]; rw [Function.update_of_ne h2, Function.update_of_ne h1]
  -- the two pushes
  have p1 := sp_pushR (s := s) F (i := vX) (j := kc) (B := Bk) (by decide) (by decide) hc
    (by rw [zsz_two_pow]; have := hjm 0 (Nat.zero_le _); simp at this; omega)
  rw [hX] at p1
  have p2 := sp_pushR (s := s) (Function.update F vX [c]) (i := vY) (j := kB) (B := Bk) (by decide)
    (by decide) (by rw [Function.update_of_ne (by decide), hB])
    (by rw [zsz_two_pow]; have := hjm 0 (Nat.zero_le _); simp at this; omega)
  rw [Function.update_of_ne (by decide), hY] at p2
  have e0 : Function.update (Function.update F vX [c]) vY [2 ^ b] = Fk 0 := by
    simp only [Fk, A, Rr, pow_zero, mul_one]
    congr 2; rw [show (1 : ℕ) = 0 + 1 from rfl, kG_succ, kG_zero]; simp
  rw [e0] at p2
  -- the doubling loop
  have hb : ∀ k < j, Sp kgBody (encK s (Function.update (Fk k) CN [(j : ℤ) - k]))
      (encK s (Function.update (Fk (k + 1)) CN [(j : ℤ) - k])) (20000 * (Bk + 2)) := by
    intro k hk
    set g := Function.update (Fk k) CN [(j : ℤ) - k] with hg
    have gX : g vX = A k :: [] := by rw [hg, Function.update_of_ne (by decide), FkX]
    have gY : g vY = Rr k :: [] := by rw [hg, Function.update_of_ne (by decide), FkY]
    have hk1 : k + 1 ≤ j := hk
    have hRk : Rr k = 2 ^ (b * 2 ^ k) := rfl
    have hprod : A k * Rr k < 2 ^ (b * 2 ^ (k + 1)) := by
      rw [pow_succ, show b * (2 ^ k * 2) = b * 2 ^ k + b * 2 ^ k by ring, pow_add]
      exact mul_lt_mul_of_pos_right (hAlt k).2 (by positivity)
    have hsum : A k + A k * Rr k = A (k + 1) := by
      simp only [A, Rr]; rw [pow_succ, mul_comm (2 ^ k) 2, kG_double, pow_mul]
    have hpz : zsz (A k * Rr k) ≤ Bk := le_trans (zsz_lt_pow (by
      have := (hAlt k).1; positivity) hprod) (by have := hjm (k + 1) hk1; omega)
    have hsz : zsz (A k + A k * Rr k) ≤ Bk := by rw [hsum]; exact hAz (k + 1) hk1
    have s1 := Sp.asg s g (i := vX) (e := .add (.reg vX) (.shl (.reg vX) (.reg vY))) (B := Bk)
      (by decide) gX (hAz k (by omega)) (clean_add (clean_reg (by decide))
        (clean_shl (clean_reg (by decide)) (clean_reg (by decide))))
      ⟨ok_reg gX, ok_reg gX, ok_reg gY, b * 2 ^ k, by simp only [Ex.eval, top_encK gY]; rfl⟩
      ⟨trivial, trivial, trivial⟩
      ⟨bnd_reg gX (hAz k (by omega)), ⟨bnd_reg gX (hAz k (by omega)), bnd_reg gY (hRz k (by omega)),
        by simp only [Ex.eval, top_encK gX, top_encK gY]; exact hpz⟩,
        by simp only [Ex.eval, top_encK gX, top_encK gY]; exact hsz⟩
    simp only [Ex.eval, top_encK gX, top_encK gY, hsum] at s1
    set g1 := Function.update g vX [A (k + 1)] with hg1
    have g1Y : g1 vY = Rr k :: [] := by rw [hg1, Function.update_of_ne (by decide), gY]
    have hRR : Rr k * Rr k = Rr (k + 1) := by
      simp only [Rr]; rw [← pow_add]; congr 1; rw [pow_succ]; ring
    have s2 := Sp.asg s g1 (i := vY) (e := .shl (.reg vY) (.reg vY)) (B := Bk)
      (by decide) g1Y (hRz k (by omega)) (clean_shl (clean_reg (by decide)) (clean_reg (by decide)))
      ⟨ok_reg g1Y, ok_reg g1Y, b * 2 ^ k, by simp only [Ex.eval, top_encK g1Y]; rfl⟩
      ⟨trivial, trivial⟩
      ⟨bnd_reg g1Y (hRz k (by omega)), bnd_reg g1Y (hRz k (by omega)),
        by simp only [Ex.eval, top_encK g1Y]; rw [hRR]; exact hRz (k + 1) hk1⟩
    simp only [Ex.eval, top_encK g1Y, hRR] at s2
    have ef : Function.update g1 vY [Rr (k + 1)] = Function.update (Fk (k + 1)) CN [(j : ℤ) - k] := by
      simp only [hg1, hg, Fk]
      funext x
      by_cases h1 : x = vX
      · subst h1; simp (config := {decide := true}) [Function.update_apply]
      by_cases h2 : x = vY
      · subst h2; simp (config := {decide := true}) [Function.update_apply]
      by_cases h3 : x = CN
      · subst h3; simp (config := {decide := true}) [Function.update_apply]
      simp [Function.update_apply, h1, h2, h3]
    rw [ef] at s2
    exact (s1.seq s2).mono (by simp only [Ex.size]; omega)
  have hFkC : ∀ k, Fk k CN = [] := fun k => by rw [FkO k CN (by decide) (by decide), hCN]
  have hFkK : ∀ k, Fk k kK = (j : ℤ) :: [] := fun k => by rw [FkO k kK (by decide) (by decide), hK]
  have R := Sp.rep (C := CN) (n := .reg kK) (b := kgBody) (s := s) (F := Fk) (N := j) (B := Bk)
    (c := 20000 * (Bk + 2)) (by decide) hFkC (by decide) (clean_reg (by decide))
    (ok_reg (hFkK 0)) trivial (bnd_reg (hFkK 0) hBj) (eval_reg (hFkK 0)) hb
  -- the closing steps
  have hJj : Fk j kJ = (m : ℤ) :: [] := by rw [FkO j kJ (by decide) (by decide), hJ]
  have a4 := sp_asgPow2 s (Fk j) (i := kJ) (m := m) (l := []) (B := Bk) (by decide) hJj
    (le_trans (KIL.zsz_nat_le (show m ≤ 2 * m + 2 by omega)) (le_trans (by
      have : zsz ((2 * m + 2 : ℕ) : ℤ) ≤ 2 * m + 2 := by
        exact zsz_lt_pow (by positivity) (by exact_mod_cast Nat.lt_two_pow_self)
      exact this) hBm)) (by omega)
  set f4 := Function.update (Fk j) kJ [(2 : ℤ) ^ m] with hf4
  have f4K : f4 kK = (j : ℤ) :: [] := by rw [hf4, Function.update_of_ne (by decide), hFkK]
  have f4X : f4 vX = A j :: [] := by rw [hf4, Function.update_of_ne (by decide), FkX]
  have f4J : f4 kJ = (2 : ℤ) ^ m :: [] := by rw [hf4, Function.update_self]
  have hmod : (A j).tmod (2 ^ m) = KFV.kG b (2 * n) c := by
    simp only [A]; rw [hm, pow_mul]; exact kG_mod b c0 cb hnj
  have hmz : zsz ((2 : ℤ) ^ m) ≤ Bk := by rw [zsz_two_pow]; omega
  have a5 := Sp.asg s f4 (i := kK) (e := .rem (.reg vX) (.reg kJ)) (B := Bk) (by decide) f4K hBj
    (clean_rem (clean_reg (by decide)) (clean_reg (by decide)))
    ⟨ok_reg f4X, ok_reg f4J, m, by simp only [Ex.eval, top_encK f4J]⟩ ⟨trivial, trivial⟩
    ⟨bnd_reg f4X (hAz j le_rfl), bnd_reg f4J hmz⟩
  simp only [Ex.eval, top_encK f4X, top_encK f4J, hmod] at a5
  set f5 := Function.update f4 kK [KFV.kG b (2 * n) c] with hf5
  have f5J : f5 kJ = (2 : ℤ) ^ m :: [] := by rw [hf5, Function.update_of_ne (by decide), f4J]
  have hmm : (2 : ℤ) ^ m * 2 ^ m = (2 ^ b) ^ (2 * (2 * n)) := by
    rw [← pow_add, ← pow_mul, hm]; ring_nf
  have a6 := Sp.asg s f5 (i := kJ) (e := .shl (.reg kJ) (.reg kJ)) (B := Bk) (by decide) f5J hmz
    (clean_shl (clean_reg (by decide)) (clean_reg (by decide)))
    ⟨ok_reg f5J, ok_reg f5J, m, by simp only [Ex.eval, top_encK f5J]⟩ ⟨trivial, trivial⟩
    ⟨bnd_reg f5J hmz, bnd_reg f5J hmz, by
      simp only [Ex.eval, top_encK f5J]; rw [← pow_add, zsz_two_pow]; omega⟩
  simp only [Ex.eval, top_encK f5J, hmm] at a6
  set f6 := Function.update f5 kJ [(2 ^ b : ℤ) ^ (2 * (2 * n))] with hf6
  have f6X : f6 vX = A j :: [] := by
    rw [hf6, Function.update_of_ne (by decide), hf5, Function.update_of_ne (by decide), f4X]
