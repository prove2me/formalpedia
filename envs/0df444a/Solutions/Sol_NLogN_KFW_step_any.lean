theorem xp_Y (r Z H : ℕ) : Xp Z ≤ 90000000 * Yu r Z H := by
  unfold Xp Xq
  have := yu_z2 r Z H
  omega

/-- A windowed sum of step costs. -/
theorem costL_win {α : Type*} (cost : α → ℕ → ℕ) (dw : α → ℕ) (b : α → ℕ) (H : ℕ) :
    ∀ l : List α, (∀ a ∈ l, ∀ x, x + dw a ≤ H → cost a x ≤ b a) →
      ∀ x, x + (l.map dw).sum ≤ H → costL cost dw l x ≤ (l.map b).sum + 1
  | [], _, x, _ => by simp [costL]
  | a :: l, h, x, hx => by
    simp only [costL, List.map_cons, List.sum_cons] at hx ⊢
    have h1 := h a List.mem_cons_self x (by omega)
    have h2 := costL_win cost dw b H l (fun c hc => h c (List.mem_cons_of_mem _ hc)) (x + dw a)
      (by omega)
    omega

/-- **The role wrapper.** -/
theorem cWrapQ_Y {W n r Z H e dw x : ℕ} (hW : 1 ≤ W) (hn : 1 ≤ n) (c : ℕ → ℕ)
    (hx : x + dw + (e + 2) * W + e ≤ 2 * H + 16) :
    cWrapQ W (n * r) Z e dw c x ≤ c x + 10 ^ 12 * (W + 2) * ((W * n) * Yu r Z H) := by
  unfold cWrapQ
  have h1 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x + dw + (e + 2) * W) (D := e) hW hn
    (by omega)
  have h2 := xp_Y r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have hWP : W * Y ≤ P := by
    rw [hP]; exact Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_right _ (by omega))
  have k1 : (W + 2) * cAtom (x + dw + (e + 2) * W) e (n * r) W Z ≤ (W + 2) * (1000000 * P) := by
    have : 1000000 * (W * n) * Y = 1000000 * P := by rw [hP]; ring
    rw [this] at h1
    exact Nat.mul_le_mul_left _ h1
  have k2 : 3 * (W * Xp Z) ≤ 270000000 * P := by
    have : W * Xp Z ≤ W * (90000000 * Y) := Nat.mul_le_mul_left _ h2
    have e1 : W * (90000000 * Y) = 90000000 * (W * Y) := by ring
    omega
  have k3 : 3 ≤ 3 * P := by
    have : 1 ≤ P := le_trans (by omega) hYP
    omega
  have e2 : 10 ^ 12 * (W + 2) * P = 10 ^ 12 * (W * P) + 2 * 10 ^ 12 * P := by ring
  have e3 : (W + 2) * (1000000 * P) = 1000000 * (W * P) + 2000000 * P := by ring
  have hWP' : P ≤ W * P := Nat.le_mul_of_pos_left _ hW
  omega

/-- **A gate of atoms.** -/
theorem cost_gate {n r Z H x : ℕ} (hn : 1 ≤ n) (as : List KFG.Atom) (hA : as.length ≤ NLogN.KFW.A0)
    (hok : ∀ a ∈ as, a.Ok P8Lift.Wc ∧ a.h ≤ 1) (hx : x + (3 * as.length + 3 * P8Lift.Wc) ≤ H) :
    400 * (cGateC P8Lift.Wc (n * r) Z as.length x + xGate as Z) ≤
      Mloc * ((P8Lift.Wc * n) * Yu r Z H) := by
  have hlev := (levOf_props hok).2.2.2
  unfold cGateC xGate Mloc
  have hW : 1 ≤ P8Lift.Wc := by norm_num
  generalize P8Lift.Wc = W at hW hlev hx ⊢
  have h1 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x + 3 * as.length) (D := 1) hW hn
    (by omega)
  have h2 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x + 3 * as.length + 3 * W) (D := 1) hW hn
    (by omega)
  have h3 := xp_Y r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : 1000000 * (W * n) * Y = 1000000 * P := by rw [hP]; ring
  rw [e1] at h1 h2
  set L := as.length
  set V := (levOf W as).length
  set c1 := cAtom (x + 3 * L) 1 (n * r) W Z
  set c2 := cAtom (x + 3 * L + 3 * W) 1 (n * r) W Z
  have k1 : L * c1 ≤ NLogN.KFW.A0 * (1000000 * P) := Nat.mul_le_mul hA h1
  have k2 : W * c2 ≤ W * (1000000 * P) := Nat.mul_le_mul_left _ h2
  have k3 : L * Xp Z + V * Xp Z ≤ (NLogN.KFW.A0 + W) * (90000000 * P) := by
    have : L * Xp Z + V * Xp Z = (L + V) * Xp Z := by ring
    rw [this]
    exact Nat.mul_le_mul (by omega) (h3.trans (Nat.mul_le_mul_left _ hYP))
  have k4 : 400 * (L * c1 + W * c2 + 2 + (L * Xp Z + V * Xp Z)) ≤
      400 * (100000000 * ((NLogN.KFW.A0 + W + 1) * P)) := by
    apply Nat.mul_le_mul_left
    have : 1 ≤ P := le_trans (by omega) hYP
    have e : 100000000 * ((NLogN.KFW.A0 + W + 1) * P) = 100000000 * (NLogN.KFW.A0 * P) + 100000000 * (W * P) +
      100000000 * P := by ring
    have e2 : NLogN.KFW.A0 * (1000000 * P) = 1000000 * (NLogN.KFW.A0 * P) := by ring
    have e3 : W * (1000000 * P) = 1000000 * (W * P) := by ring
    have e4 : (NLogN.KFW.A0 + W) * (90000000 * P) = 90000000 * (NLogN.KFW.A0 * P) + 90000000 * (W * P) := by ring
    omega
  refine k4.trans ?_
  have : 400 * (100000000 * ((NLogN.KFW.A0 + W + 1) * P)) = (4 * 10 ^ 10 * (NLogN.KFW.A0 + W + 1)) * P := by ring
  rw [this]
  apply Nat.mul_le_mul_right
  have h5 : NLogN.KFW.A0 + W + 1 ≤ (W + NLogN.KFW.A0 + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + NLogN.KFW.A0 + 10))
  calc 4 * 10 ^ 10 * (NLogN.KFW.A0 + W + 1) ≤ 10 ^ 13 * 1 * (W + NLogN.KFW.A0 + 10) ^ 2 := by
        have := Nat.mul_le_mul_left (4 * 10 ^ 10) h5
        nlinarith
    _ ≤ 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_left; omega

/-- **A permutation of the roles.** -/
theorem cost_perm {n r Z H x : ℕ} (hn : 1 ≤ n) (π : Equiv.Perm (Fin P8Lift.Wc)) (hx : x ≤ H) :
    400 * ((P8Lift.Wc * cAtom x 0 (n * r) P8Lift.Wc Z + 1) + (permSw π).length * Xp Z) ≤
      Mloc * ((P8Lift.Wc * n) * Yu r Z H) := by
  have hl := (permSw_spec π).1
  unfold Mloc
  have hW : 1 ≤ P8Lift.Wc := by norm_num
  generalize (permSw π).length = q at hl ⊢
  generalize P8Lift.Wc = W at hW hl ⊢
  have h1 := cAtom_Y (r := r) (Z := Z) (H := H) (x := x) (D := 0) hW hn (by omega)
  have h3 := xp_Y r Z H
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have e1 : 1000000 * (W * n) * Y = 1000000 * P := by rw [hP]; ring
  rw [e1] at h1
  have k1 : W * cAtom x 0 (n * r) W Z ≤ W * (1000000 * P) := Nat.mul_le_mul_left _ h1
  have k3 : q * Xp Z ≤ W * (90000000 * P) := Nat.mul_le_mul hl (h3.trans (Nat.mul_le_mul_left _ hYP))
  have k4 : 400 * ((W * cAtom x 0 (n * r) W Z + 1) + q * Xp Z) ≤ (4 * 10 ^ 10 * (W + 1)) * P := by
    have : 1 ≤ P := le_trans (by omega) hYP
    have e : (4 * 10 ^ 10 * (W + 1)) * P = 4 * 10 ^ 10 * (W * P) + 4 * 10 ^ 10 * P := by ring
    have e3 : W * (1000000 * P) = 1000000 * (W * P) := by ring
    have e4 : W * (90000000 * P) = 90000000 * (W * P) := by ring
    omega
  refine k4.trans (Nat.mul_le_mul_right _ ?_)
  have h5 : W + 1 ≤ (W + NLogN.KFW.A0 + 10) ^ 2 :=
    le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + NLogN.KFW.A0 + 10))
  calc 4 * 10 ^ 10 * (W + 1) ≤ 10 ^ 13 * 1 * (W + NLogN.KFW.A0 + 10) ^ 2 := by
        have := Nat.mul_le_mul_left (4 * 10 ^ 10) h5
        nlinarith
    _ ≤ 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 := by
        apply Nat.mul_le_mul_right; apply Nat.mul_le_mul_left; omega

theorem cFrame_Y (N sz r Z H : ℕ) : cFrame N sz Z ≤ N * (sz + 1) * 10 ^ 8 * Yu r Z H + 1 := by
  unfold cFrame
  have h1 := yu_z2 r Z H
  have h2 := moveCost_Y Z r H
  set Y := Yu r Z H
  have : sz * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost Z + 19) ≤ (sz + 1) * 10 ^ 8 * Y := by
    have a : sz * 10 ^ 7 * (Z + 2) ^ 2 ≤ sz * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h1
    have hY8 := yu_8 r Z H
    have e : (sz + 1) * 10 ^ 8 * Y = sz * 10 ^ 7 * Y + (9 * sz * 10 ^ 7 * Y + 10 ^ 8 * Y) := by ring
    omega
  have := Nat.mul_le_mul_left N this
  have e : N * ((sz + 1) * 10 ^ 8 * Y) = N * (sz + 1) * 10 ^ 8 * Y := by ring
  omega

/-- **A phase step** (body and wrapper). -/
theorem cost_phase {Bn t S0 r Z H x : ℕ} (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (v : ℤ) (hv : zsz v ≤ Z)
    (εE : Ex HS) (hsz : εE.size ≤ 12 * mC + 27) (hx : x + 2 * P8Lift.Wc ≤ H) :
    cWrapQ P8Lift.Wc (nN Bn t S0 * r) Z 0 0 (cPhStep Z v εE Bn t S0 r) x ≤
      Mph * ((P8Lift.Wc * nN Bn t S0) * Yu r Z H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hW : 1 ≤ P8Lift.Wc := by norm_num
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := 0) (dw := 0) (x := x) hW hn
    (cPhStep Z v εE Bn t S0 r) (by omega)
  have h2 := cPhU_Y (r := r) (Z := Z) (H := H) (x := x) (t := t) hS hBn (by omega) εE hsz
  have h3 := yu_z2 r Z H
  have h4 : moveCost (zsz v) ≤ 50 * Yu r Z H := (moveCost_mono hv).trans (moveCost_Y Z r H)
  have h5 := yu_z1 r Z H
  unfold cPhStep cpU at h1 ⊢
  unfold Mph
  generalize P8Lift.Wc = W at hW h1 hx ⊢
  set n := nN Bn t S0
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  set P := W * n * Y with hP
  have hYP : Y ≤ P := Nat.le_mul_of_pos_left _ (by omega)
  have hnYP : n * Y ≤ P := by rw [hP]; exact Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_left _ hW)
  have e1 : 10 ^ 12 * (W + 2) * (W * n * Y) = 10 ^ 12 * (W + 2) * P := rfl
  have e2 : 1000000000 * (12 * mC + 27 + 2) * n * Y = 1000000000 * (12 * mC + 29) * (n * Y) := by
    ring
  rw [e2] at h2
  have k2 : 1000000000 * (12 * mC + 29) * (n * Y) ≤ 1000000000 * (12 * mC + 29) * P :=
    Nat.mul_le_mul_left _ hnYP
  have k3 : 7 * 10 ^ 7 * (Z + 2) ^ 2 + (2 * moveCost (zsz v) + 19) + 1 + (1 * (2 * Z + 2) + 1) ≤
      10 ^ 9 * P := by
    have : 7 * 10 ^ 7 * (Z + 2) ^ 2 ≤ 7 * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h3
    omega
  have k4 : 10 ^ 12 * (W + 2) * P + 1000000000 * (12 * mC + 29) * P + 10 ^ 9 * P ≤
      10 ^ 12 * (12 * mC + 30) * (W + 3) * P := by
    have e : 10 ^ 12 * (12 * mC + 30) * (W + 3) * P = 10 ^ 12 * (12 * mC + 30) * (W * P) +
        3 * 10 ^ 12 * (12 * mC + 30) * P := by ring
    have e' : 10 ^ 12 * (W + 2) * P = 10 ^ 12 * (W * P) + 2 * 10 ^ 12 * P := by ring
    have hm : 1 ≤ 12 * mC + 30 := by omega
    have a : 10 ^ 12 * (W * P) ≤ 10 ^ 12 * (12 * mC + 30) * (W * P) := by
      have := Nat.mul_le_mul_left (10 ^ 12) (Nat.le_mul_of_pos_left (W * P) hm)
      calc 10 ^ 12 * (W * P) ≤ 10 ^ 12 * ((12 * mC + 30) * (W * P)) := this
        _ = 10 ^ 12 * (12 * mC + 30) * (W * P) := by ring
    have b : 2 * 10 ^ 12 * P + 1000000000 * (12 * mC + 29) * P + 10 ^ 9 * P ≤
        3 * 10 ^ 12 * (12 * mC + 30) * P := by
      have e3 : 3 * 10 ^ 12 * (12 * mC + 30) * P = 36 * 10 ^ 12 * (mC * P) + 90 * 10 ^ 12 * P := by
        ring
      have e4 : 1000000000 * (12 * mC + 29) * P = 12 * 10 ^ 9 * (mC * P) + 29 * 10 ^ 9 * P := by
        ring
      omega
    omega
  omega

/-- **A `±1` role diagonal** (at most `W` phase steps). -/
theorem cost_fixG {Bn t S0 r Z H k x : ℕ} (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (hZ : 3 ≤ Z)
    (U : Finset (Fin P8Lift.Wc))
    (hx : x + ((negSteps (m := mC) U.toList).map (fun _ => 0 + (0 + 2) * P8Lift.Wc)).sum ≤ H) :
    costL (phCostF Z Bn t S0 r k) (fun _ => 0 + (0 + 2) * P8Lift.Wc) (negSteps (m := mC) U.toList)
      x ≤ Mloc * ((P8Lift.Wc * nN Bn t S0) * Yu r Z H) := by
  set P := (P8Lift.Wc * nN Bn t S0) * Yu r Z H with hP
  have H1 := costL_win (phCostF Z Bn t S0 r k) (fun _ => 0 + (0 + 2) * P8Lift.Wc) (fun _ => Mph * P)
    H (negSteps (m := mC) U.toList) (fun a ha x hx => by
      simp only [negSteps, List.mem_map] at ha
      obtain ⟨w, -, rfl⟩ := ha
      simp only [phCostF]
      refine cost_phase hS hBn _ ?_ _ ?_ (by omega)
      · have : (((2 + 0 * mC ^ k) % 4 : ℕ) : ℤ) = 2 := by norm_num
        rw [this, NLogN.zsz_two]; omega
      · rw [εTab_size, List.length_ofFn]; exact le_of_eq (by ring)) x hx
  refine H1.trans ?_
  have hlen : (negSteps (m := mC) U.toList).length ≤ P8Lift.Wc := by
    simp only [negSteps, List.length_map, Finset.length_toList]
    exact (Finset.card_le_univ U).trans (by simp)
  simp only [List.map_const', List.sum_replicate, smul_eq_mul]
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hP1 : 1 ≤ P := by
    have h8 := yu_8 r Z H
    have h1 : 1 ≤ P8Lift.Wc * nN Bn t S0 := by
      have := Nat.mul_le_mul (show 1 ≤ P8Lift.Wc by norm_num) hn
      simpa using this
    have := Nat.mul_le_mul h1 (le_trans (by norm_num) h8 : 1 ≤ Yu r Z H)
    rw [hP]; simpa using this
  unfold Mloc Mph
  generalize (negSteps (m := mC) U.toList).length = q at hlen ⊢
  generalize P8Lift.Wc = W at hlen ⊢
  have k1 : q * (10 ^ 12 * (12 * mC + 30) * (W + 3) * P) ≤
      W * (10 ^ 12 * (12 * mC + 30) * (W + 3) * P) := Nat.mul_le_mul_right _ hlen
  have k2 : W * (10 ^ 12 * (12 * mC + 30) * (W + 3) * P) + 1 ≤
      10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 * P := by
    have a : W * (W + 3) + 1 ≤ (W + NLogN.KFW.A0 + 10) ^ 2 := by
      have h := Nat.pow_le_pow_left (show W + 10 ≤ W + NLogN.KFW.A0 + 10 by omega) 2
      nlinarith [h]
    have : W * (10 ^ 12 * (12 * mC + 30) * (W + 3) * P) + 1 ≤
        10 ^ 12 * (12 * mC + 30) * (W * (W + 3) + 1) * P := by
      have e : 10 ^ 12 * (12 * mC + 30) * (W * (W + 3) + 1) * P =
          W * (10 ^ 12 * (12 * mC + 30) * (W + 3) * P) + 10 ^ 12 * (12 * mC + 30) * P := by ring
      have : 1 ≤ 10 ^ 12 * (12 * mC + 30) * P := by
        have : 0 < 10 ^ 12 * (12 * mC + 30) := by positivity
        have := Nat.mul_le_mul (this : 1 ≤ 10 ^ 12 * (12 * mC + 30)) hP1
        simpa using this
      omega
    refine this.trans ?_
    have := Nat.mul_le_mul_left (10 ^ 12 * (12 * mC + 30)) a
    have e : 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 =
        10 * (10 ^ 12 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2) := by ring
    rw [e]
    have : 10 ^ 12 * (12 * mC + 30) * (W * (W + 3) + 1) ≤
        10 * (10 ^ 12 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2) := by omega
    exact Nat.mul_le_mul_right _ this
  omega

/-- **The child wrapper** overhead (`cIH` constant). -/
theorem cost_child {Bn t S0 r Z H k DWc x c : ℕ} (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (fwd : Bool)
    (hx : x + (DWc + (ES k + 2) * P8Lift.Wc) ≤ H) :
    cWrapQ P8Lift.Wc (nN Bn t S0 * r) Z (ES k) DWc
      (fun x => cFrame 5 6 Z + cChildF (fun _ => c) (cPhZ Z Z Bn t S0 r) DWc fwd x +
        (5 * (2 * Z + 2) + 1)) x ≤ c + Mloc * ((P8Lift.Wc * nN Bn t S0) * Yu r Z H) := by
  have hn : 1 ≤ nN Bn t S0 := one_le_nN hBn hS
  have hW : 1 ≤ P8Lift.Wc := by norm_num
  have hEW : ES k ≤ (ES k + 2) * P8Lift.Wc := by nlinarith
  have h1 := cWrapQ_Y (r := r) (Z := Z) (H := H) (e := ES k) (dw := DWc) (x := x) hW hn
    (fun x => cFrame 5 6 Z + cChildF (fun _ => c) (cPhZ Z Z Bn t S0 r) DWc fwd x +
        (5 * (2 * Z + 2) + 1)) (by omega)
  have hZ : ∀ y, y ≤ H → cPhZ Z Z Bn t S0 r y ≤ 10 ^ 9 * 31 * (nN Bn t S0 * Yu r Z H) := by
    intro y hy
    unfold cPhZ
    have h2 := cPhU_Y (r := r) (Z := Z) (H := H) (x := y) (t := t) hS hBn (by omega)
      (εLit NLogN.KFW.vE vK vF ((2 % 4 : ℕ) : ℤ)) (le_of_eq (εLit_size _ _ _ _))
    have h3 := yu_z2 r Z H
    have h4 := moveCost_Y Z r H
    have h5 := yu_z1 r Z H
    set Y := Yu r Z H
    have hnY : Y ≤ nN Bn t S0 * Y := Nat.le_mul_of_pos_left _ hn
    have e : 1000000000 * (27 + 2) * nN Bn t S0 * Y = 29 * 10 ^ 9 * (nN Bn t S0 * Y) := by ring
    rw [e] at h2
    have : 5 * 10 ^ 7 * (Z + 2) ^ 2 ≤ 5 * 10 ^ 7 * Y := Nat.mul_le_mul_left _ h3
    omega
  have hc : cChildF (fun _ => c) (cPhZ Z Z Bn t S0 r) DWc fwd x ≤
      c + 2 + 2 * (10 ^ 9 * 31 * (nN Bn t S0 * Yu r Z H)) := by
    unfold cChildF
    cases fwd
    · simp only [Bool.false_eq_true, if_false]
      have := hZ x (by omega)
      have := hZ (x + DWc) (by omega)
      omega
    · simp only [if_true]; omega
  have hF := cFrame_Y 5 6 r Z H
  refine h1.trans ?_
  unfold Mloc
  generalize P8Lift.Wc = W at hW ⊢
  set n := nN Bn t S0
  set Y := Yu r Z H
  have hY8 := yu_8 r Z H
  have h5 := yu_z1 r Z H
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
  have hnY : n * Y ≤ W * n * Y := Nat.mul_le_mul_right _ (Nat.le_mul_of_pos_left _ hW)
  have hYn : Y ≤ n * Y := Nat.le_mul_of_pos_left _ hn
  set P := W * n * Y with hP
  have hP1 : 1 ≤ P := by omega
  have k : 5 * (6 + 1) * 10 ^ 8 * Y + 1 + 2 + 2 * (10 ^ 9 * 31 * (n * Y)) + (5 * (2 * Z + 2) + 1) +
      10 ^ 12 * (W + 2) * P ≤ 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 * P := by
    have a : (W + 2) + 1 ≤ (W + NLogN.KFW.A0 + 10) ^ 2 :=
      le_trans (by omega) (Nat.le_self_pow (by norm_num) (W + NLogN.KFW.A0 + 10))
    have b : 10 ^ 12 * ((W + 2) + 1) * P ≤ 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 * P := by
      apply Nat.mul_le_mul_right
      have : 10 ^ 12 * ((W + 2) + 1) ≤ 10 ^ 12 * (W + NLogN.KFW.A0 + 10) ^ 2 := Nat.mul_le_mul_left _ a
      have : 10 ^ 12 * (W + NLogN.KFW.A0 + 10) ^ 2 ≤ 10 ^ 13 * (12 * mC + 30) * (W + NLogN.KFW.A0 + 10) ^ 2 :=
        Nat.mul_le_mul_right _ (by omega)
      omega
    have e : 10 ^ 12 * ((W + 2) + 1) * P = 10 ^ 12 * (W + 2) * P + 10 ^ 12 * P := by ring
    omega
  omega

end NLogN.KFW

