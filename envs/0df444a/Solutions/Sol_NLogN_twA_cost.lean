  have zX' : zsz (octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).1 ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zY' : zsz (octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2 ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zYp' : zsz (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2 else -(octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2) ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zRe' : zsz (rot4 ((8 * ((j : ℤ) % k) / k + 1) / 2 % 4) ((octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).1, (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2 else -(octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2))).1 ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zIm' : zsz (rot4 ((8 * ((j : ℤ) % k) / k + 1) / 2 % 4) ((octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).1, (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2 else -(octExp n k (if 8 * ((j : ℤ) % k) / k % 2 < 1 then (8 * ((j : ℤ) % k) % k).toNat else ((k : ℤ) - 8 * ((j : ℤ) % k) % k).toNat)).2))).2 ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by omega
  have zl3 : zsz (3 : ℤ) ≤ twBB n (zsz (j : ℤ)) (zsz (k : ℤ)) := by
    have := zsz_natCast_le_self' 3; push_cast at this; omega
  exact ⟨zn, zj, zk, zl8, zl4, zl2, zl1, zl3, zJ', zE', zQ', zR', zkjk', zkEk', zC1', zC'', z2Q', zQ1', zH', z4H', zT', zT1', zT2', zT3', zkR', zA', zX', zY', zYp', zRe', zIm'⟩

end NLogN

end

section
set_option linter.unusedSimpArgs false
open NLogN
open IntMul RS IntMul.HvdH
set_option maxHeartbeats 4000000
theorem solution (n k j : ℕ) (s : NLogN.IState NLogN.HS) (L28 L29 L53 : List NLogN.Item)
    (h28 : s.G 28 = .int n :: L28) (h29 : s.G 29 = .int k :: L29)
    (h53 : s.G 53 = .int j :: L53) :
    NLogN.twA.cost s ≤ 10 ^ 12 * (NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) + 6) ^ 2 := by
  obtain ⟨zn, zj, zk, zl8, zl4, zl2, zl1, zl3, zJ', zE', zQ', zR', zkjk', zkEk', zC1', zC'', z2Q', zQ1', zH', z4H', zT', zT1', zT2', zT3', zkR', zA', zX', zY', zYp', zRe', zIm'⟩ := NLogN.tw_facts n k j
  generalize NLogN.twBB n (NLogN.zsz (j : ℤ)) (NLogN.zsz (k : ℤ)) = Bb at *
  simp (config := {decide := true}) only [NLogN.twA, NLogN.RS.seqL, NLogN.RS.run_seq, NLogN.RS.cost]
  refine le_trans (add_le_add (NLogN.RS.pushCost_le _ _ (Bb + 2 + 2)
      (NLogN.Ex.ediv_bnd _ _ _ (Bb + 2) ⟨?_, NLogN.emod_bnd _ _ _ Bb ?_ ?_ ?_ ?_, ?_⟩ ?_))
    (add_le_add (NLogN.RS.pushCost_le _ _ (Bb + 2 + 2)
      (NLogN.emod_bnd _ _ _ (Bb + 2) ⟨?_, NLogN.emod_bnd _ _ _ Bb ?_ ?_ ?_ ?_, ?_⟩ ?_ ?_ ?_))
    (add_le_add (NLogN.RS.pushCost_le _ _ (Bb + 2) (NLogN.emod_bnd _ _ _ Bb ?_ ?_ ?_ ?_))
    (add_le_add (NLogN.RS.pushCost_le _ _ (Bb + 2 + 2)
      (NLogN.emod_bnd _ _ _ (Bb + 2) (NLogN.Ex.ediv_bnd _ _ _ Bb ⟨?_, ?_, ?_⟩ ?_) ?_ ?_ ?_))
    (add_le_add (NLogN.RS.pushCost_le _ _ Bb ?_)
    (add_le_add (NLogN.RS.pushCost_le _ _ Bb ?_)
    (NLogN.RS.pushCost_le _ _ Bb (NLogN.sel_bnd _ _ _ _ _ ?_ (NLogN.Ex.max0_bnd _ _ _ ?_)
      (NLogN.Ex.max0_bnd _ _ _ ?_))))))))) ?_
  all_goals simp (config := {decide := true}) only [NLogN.Ex.Bnd, NLogN.Ex.eval,
    NLogN.IState.top, NLogN.RS.run_push_G, NLogN.IState.upd_G, h28, h29, h53, if_true,
    if_false, List.tail_cons, NLogN.Ex.ediv_eval, NLogN.Ex.emod_eval, NLogN.Ex.max0_eval, NLogN.aE_eval, NLogN.qE, NLogN.rE, NLogN.cE, NLogN.tE,
    NLogN.jkE, Int.toNat_natCast, NLogN.zsz_neg]
  all_goals (repeat' apply And.intro)
  all_goals first
    | with_reducible assumption
    | (apply Nat.le_add_right_of_le; with_reducible assumption)
    | (apply Nat.le_add_right_of_le; apply Nat.le_add_right_of_le; with_reducible assumption)
    | skip
  simp only [NLogN.Ex.emod, NLogN.Ex.ediv, NLogN.Ex.fdiv, NLogN.Ex.max0, NLogN.aE, NLogN.Ex.size]
  have h1 : (Bb + 2) ^ 2 ≤ (Bb + 6) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h2 : (Bb + 2 + 2) ^ 2 ≤ (Bb + 6) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  have h3 : (Bb + 2 + 2 + 2) ^ 2 ≤ (Bb + 6) ^ 2 := Nat.pow_le_pow_left (by omega) 2
  generalize (Bb + 6) ^ 2 = Z at *
  generalize (Bb + 2) ^ 2 = Y1 at *
  generalize (Bb + 2 + 2) ^ 2 = Y2 at *
  generalize (Bb + 2 + 2 + 2) ^ 2 = Y3 at *
  linarith
end
