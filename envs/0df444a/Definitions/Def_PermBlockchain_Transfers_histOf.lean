-- title:
--   The public history of an action profile
-- statement:
--   In the supply-chain model of Iyengar, Saleh, Sethuraman and Wang, two vendors $h,l$ supply $4m$ manufacturers, each of a type $(q_i,\xi_i)\in\{A,B\}\times\{h,l\}$, and a unit mass of consumers buys from the manufacturers or takes an outside option.
--
--   Given an action profile $(a_i,P_i,\Psi_i)_{i\in M}$, its public history is $(\{a_i\}_{i\in M},\{P_i\}_{i\in M})$.
-- source:
--   Iyengar, Saleh, Sethuraman, Wang, Economics of Permissioned Blockchain Adoption, SSRN 3602376 (version of 2022-08-19), proof of Proposition 4.9, p. 36 (PDF p. 37)

import Mathlib
import Definitions.Def_PermBlockchain_Transfers_Act
import Definitions.Def_PermBlockchain_Transfers_Hist

namespace PermBlockchain.Transfers

/-- **The public history generated by an action profile: adoption decisions and consumer prices.**
Iyengar, Saleh, Sethuraman, Wang, *Economics of Permissioned Blockchain Adoption*,
SSRN 3602376 (version of 2022-08-19), proof of Proposition 4.9, p. 36 (PDF p. 37), `G_k = σ(t_k, φ_k, {a_i, P_i}_{i∈M})`. -/
def histOf {m : ℕ} (α : Mfr m → Act) : Hist m :=
  (fun i => (α i).1, fun i => (α i).2.1)

end PermBlockchain.Transfers


