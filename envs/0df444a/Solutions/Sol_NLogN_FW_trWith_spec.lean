section
-- Source module: NLogN.HSort
set_option linter.unusedSimpArgs false

namespace NLogN

open IntMul RS

theorem mvK_states {X Y C : Fin HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (n : Ex HS)
    (s : IState HS) (L : List ℤ) (R : List Item) (hX : s.G X = ints L ++ R)
    (hn : n.eval s = L.length) :
    RepStates C n (NLogN.RS.seq (push Y (.reg X)) (pop X)) s (mvSt_s X Y s L R) where
  nonneg := by rw [hn]; positivity
  hw := by simp [RS.writes, hXC.symm, hYC.symm]
  h0 := by simp [mvSt_s, ← hX]
  hG := fun k => by simp [mvSt_s, hXC.symm, hYC.symm]
  step := by
    intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have ht : L.take (k + 1) = L.take k ++ [L[k]] := (List.take_concat_get' L k hk).symm
    apply run_ext _ (by simp [withCtr, mvSt_s]) (by simp [withCtr, mvSt_s])
    intro j
    simp only [run_seq, run_push_G, run_pop_G, withCtr, mvSt_s, IState.upd_G, Ex.eval, IState.top]
    by_cases h1 : j = X
    · rw [h1, hd]
      simp only [if_neg hXY, if_neg hXC, ite_true, ints_cons, List.cons_append, List.tail_cons]
    by_cases h2 : j = Y
    · rw [h2, hd, ht]
      simp only [if_neg hXY.symm, if_neg hYC, if_neg hXC, ite_true, ints_cons, List.cons_append,
        ints_append, List.reverse_append, List.reverse_cons, List.reverse_nil, List.nil_append,
        List.singleton_append, List.map_cons, List.map_nil, ints, List.append_assoc, List.map_append]
      simp [hXY]
    · simp [h1, h2]

theorem mvK_spec {X Y C : Fin HS} (hXY : X ≠ Y) (hXC : X ≠ C) (hYC : Y ≠ C) (hX5 : X.val < 56)
    (hY5 : Y.val < 56) (hC5 : C.val < 56) (n : Ex HS) (hnc : n.Clean) (s : IState HS)
    (L : List ℤ) (R : List Item) (hX : s.G X = ints L ++ R) (hno : n.ok s)
    (hn : n.eval s = L.length) :
    (mvK X Y C n).ok s ∧
      (mvK X Y C n).run s = (s.upd X R).upd Y ((ints L).reverse ++ s.G Y) := by
  have H := mvK_states hXY hXC hYC n s L R hX hn
  refine ⟨H.ok hC5 hnc hno ?_, ?_⟩
  · intro k hk
    rw [hn, Int.toNat_natCast] at hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    have e1 : (withCtr C s (n.eval s).toNat k (mvSt_s X Y s L R k)).G X =
        .int L[k] :: (ints (L.drop (k + 1)) ++ R) := by
      simp only [withCtr, mvSt_s, IState.upd_G, if_neg hXY, if_neg hXC, ite_true]
      rw [hd]; rfl
    refine ⟨⟨hY5, clean_of_lt hX5, IState.isInt_of e1⟩, hX5, ?_⟩
    apply IState.isInt_of (L := ints (L.drop (k + 1)) ++ R) (a := L[k])
    simp [run_push_G, hXY, e1]
  · rw [mvK, H.run, hn, Int.toNat_natCast]
    simp [mvSt_s]

theorem radixSort_succ (kb : ℕ) (R : List (List ℤ)) :
    radixSort (kb + 1) R = radixPass kb (radixSort kb R) := by
  simp [radixSort, List.range_succ, List.foldl_append]

theorem radixPass_perm (k : ℕ) (R : List (List ℤ)) : List.Perm (radixPass k R) R := by
  unfold radixPass
  have := List.filter_append_perm (fun r => keyBit k r) R
  exact (List.perm_append_comm.trans this)

theorem radixSort_perm (kb : ℕ) (R : List (List ℤ)) : List.Perm (radixSort kb R) R := by
  induction kb with
  | zero => simp [radixSort]
  | succ kb ih => rw [radixSort_succ]; exact (radixPass_perm _ _).trans ih

theorem bitE_eval (t : IState HS) (a : ℤ) (L : List Item) (k : ℕ) (h0 : t.G 0 = .int a :: L)
    (h52 : t.top 52 = 2 ^ k) : bitE.eval t = -((a.tdiv (2 ^ k)).tmod 2) := by
  simp [bitE, Ex.eval, IState.top_eq h0, h52]

theorem bitE_neg_iff (t : IState HS) (a : ℤ) (r : List ℤ) (L : List Item) (k : ℕ)
    (h0 : t.G 0 = .int a :: L) (h52 : t.top 52 = 2 ^ k) :
    bitE.eval t < 0 ↔ keyBit k (a :: r) = true := by
  rw [bitE_eval t a L k h0 h52]; simp [keyBit]

theorem passSt_G_other (k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (j : ℕ)
    (x : Fin HS) (h0 : x ≠ 0) (h46 : x ≠ 46) (h47 : x ≠ 47) (h48 : x ≠ 48) (h49 : x ≠ 49) :
    (passSt k s R Rest j).G x = s.G x := by
  simp [passSt, h0, h46, h47, h48, h49]

section
variable (k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (j : ℕ)
theorem passSt_G0 : (passSt k s R Rest j).G 0 = ints (R.drop j).flatten ++ Rest := by
  simp only [passSt, IState.upd_G]; simp (config := {decide := true})
theorem passSt_G46 : (passSt k s R Rest j).G 46 =
    ints (((R.take j).filter (keyBit k)).flatten.reverse) ++ s.G 46 := by
  simp only [passSt, IState.upd_G]; simp (config := {decide := true})
theorem passSt_G47 : (passSt k s R Rest j).G 47 =
    ints (((R.take j).filter (fun r => !keyBit k r)).flatten.reverse) ++ s.G 47 := by
  simp only [passSt, IState.upd_G]; simp (config := {decide := true})
theorem passSt_G48 : (passSt k s R Rest j).G 48 =
    .int (((R.take j).filter (keyBit k)).flatten.length) :: s.G 48 := by
  simp only [passSt, IState.upd_G]; simp (config := {decide := true})
theorem passSt_G49 : (passSt k s R Rest j).G 49 =
    .int (((R.take j).filter (fun r => !keyBit k r)).flatten.length) :: s.G 49 := by
  simp only [passSt, IState.upd_G]; simp (config := {decide := true})
end

theorem withCtr_G (i : Fin HS) (s t : IState HS) (N k : ℕ) (x : Fin HS) :
    (withCtr i s N k t).G x = if x = i then .int ((N : ℤ) - k) :: s.G i else t.G x := by
  simp [withCtr]

theorem withCtr_G_ne {i : Fin HS} (s t : IState HS) (N k : ℕ) {x : Fin HS} (h : x ≠ i) :
    (withCtr i s N k t).G x = t.G x := by
  simp [withCtr, h]

theorem pass_step (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L52 : List Item)
    (h52 : s.G 52 = .int (2 ^ k) :: L52) (N j : ℕ) (hj : j < R.length) (S0 : IState HS) :
    (recBody w).ok (withCtr 50 S0 N j (passSt k s R Rest j)) ∧
    (recBody w).run (withCtr 50 S0 N j (passSt k s R Rest j)) =
      withCtr 50 S0 N j (passSt k s R Rest (j + 1)) := by
  have hd : R.drop j = R[j] :: R.drop (j + 1) := List.drop_eq_getElem_cons hj
  have htk : R.take (j + 1) = R.take j ++ [R[j]] := (List.take_concat_get' R j hj).symm
  have hlen : R[j].length = w := hR _ (List.getElem_mem hj)
  obtain ⟨a, r', hr⟩ : ∃ a r', R[j] = a :: r' := by
    rcases h : R[j] with _ | ⟨a, r'⟩
    · rw [h] at hlen; simp at hlen; omega
    · exact ⟨a, r', rfl⟩
  generalize ht : withCtr 50 S0 N j (passSt k s R Rest j) = t
  have tG : ∀ x, x ≠ 50 → t.G x = (passSt k s R Rest j).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have tG0 : t.G 0 = ints R[j] ++ (ints (R.drop (j + 1)).flatten ++ Rest) := by
    rw [tG 0 (by decide), passSt_G0, hd, List.flatten_cons, ints_append, List.append_assoc]
  have tG0' : t.G 0 = .int a :: (ints r' ++ (ints (R.drop (j + 1)).flatten ++ Rest)) := by
    rw [tG0, hr]; rfl
  have tG52 : t.G 52 = .int (2 ^ k) :: L52 := by
    rw [tG 52 (by decide), passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide)
      (by decide) (by decide), h52]
  have t52 : t.top 52 = 2 ^ k := IState.top_eq tG52
  have hbit := bitE_neg_iff t a r' _ k tG0' t52
  have hok : ∀ (Y : Fin HS), Y.val < 56 → (0 : Fin HS) ≠ Y → Y ≠ 51 →
      (mvK 0 Y 51 (.lit w)).ok t ∧ (mvK 0 Y 51 (.lit w)).run t =
        (t.upd 0 (ints (R.drop (j + 1)).flatten ++ Rest)).upd Y ((ints R[j]).reverse ++ t.G Y) := by
    intro Y hY h0Y hYC
    exact mvK_spec h0Y (by decide) hYC (by decide) hY (by decide) (.lit w)
      (by intro i hi; simp [Ex.regs] at hi) t R[j] _ tG0 trivial (by simp [Ex.eval, hlen])
  have hbok : bitE.Clean ∧ bitE.ok t := by
    refine ⟨?_, ?_⟩
    · intro i hi; simp [bitE, Ex.regs] at hi; rcases hi with rfl | rfl <;> decide
    · simp only [bitE, Ex.ok]
      exact ⟨⟨IState.isInt_of tG0', IState.isInt_of tG52, k, t52⟩, trivial, 1, by norm_num [Ex.eval]⟩
  have hcl : ∀ x : Fin HS, x.val < 56 → (Ex.add (.reg x) (.lit (w : ℤ))).Clean := by
    intro x hx i hi; simp [Ex.regs] at hi; subst hi; exact clean_of_lt hx _ (by simp [Ex.regs])
  by_cases hb : keyBit k (a :: r') = true
  · have hc : bitE.eval t < 0 := hbit.2 hb
    obtain ⟨hk1, hk2⟩ := hok 46 (by decide) (by decide) (by decide)
    have hf1 : (R.take (j + 1)).filter (keyBit k) = (R.take j).filter (keyBit k) ++ [R[j]] := by
      rw [htk, List.filter_append]; simp [hr, hb]
    have hf2 : (R.take (j + 1)).filter (fun r => !keyBit k r) =
        (R.take j).filter (fun r => !keyBit k r) := by
      rw [htk, List.filter_append]; simp [hr, hb]
    have t48 : t.G 48 = .int (((R.take j).filter (keyBit k)).flatten.length) :: s.G 48 := by
      rw [tG 48 (by decide), passSt_G48]
    have u48 : ((t.upd 0 (ints (R.drop (j + 1)).flatten ++ Rest)).upd 46
        ((ints R[j]).reverse ++ t.G 46)).G 48 =
        .int (((R.take j).filter (keyBit k)).flatten.length) :: s.G 48 := by
      simp only [IState.upd_G]; simp (config := {decide := true}) [t48]
    constructor
    · refine ⟨hbok.1, hbok.2, ?_⟩
      rw [if_pos hc]
      refine ⟨hk1, ?_⟩
      rw [hk2]
      exact ⟨by decide, hcl 48 (by decide), ⟨IState.isInt_of u48, trivial⟩, IState.isInt_of u48⟩
    · show (if bitE.eval t < 0 then _ else _) = _
      rw [if_pos hc, run_seq, hk2]
      apply run_ext _ (by rw [← ht]; simp [withCtr, passSt]) (by rw [← ht]; simp [withCtr, passSt])
      intro x
      rw [run_asg_G]
      by_cases x50 : x = 50
      · subst x50
        rw [← ht]; simp only [IState.upd_G, withCtr_G]; simp (config := {decide := true})
      rw [withCtr_G_ne _ _ _ _ x50]
      by_cases x0 : x = 0
      · subst x0
        simp only [IState.upd_G]; simp (config := {decide := true}) [passSt_G0]
      by_cases x46 : x = 46
      · subst x46
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G46, hf1, ints_append, ints_reverse, tG]
      by_cases x48 : x = 48
      · subst x48
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G48, hf1, Ex.eval, IState.top_eq u48, hlen, t48]
      by_cases x47 : x = 47
      · subst x47
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G47, hf2, tG]
      by_cases x49 : x = 49
      · subst x49
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G49, hf2, tG]
      simp only [IState.upd_G, if_neg x0, if_neg x46, if_neg x48]
      rw [tG x x50, passSt_G_other _ _ _ _ _ _ x0 x46 x47 x48 x49,
        passSt_G_other _ _ _ _ _ _ x0 x46 x47 x48 x49]
  · have hc : ¬ bitE.eval t < 0 := fun h => hb (hbit.1 h)
    obtain ⟨hk1, hk2⟩ := hok 47 (by decide) (by decide) (by decide)
    have hf1 : (R.take (j + 1)).filter (keyBit k) = (R.take j).filter (keyBit k) := by
      rw [htk, List.filter_append]; simp [hr, hb]
    have hf2 : (R.take (j + 1)).filter (fun r => !keyBit k r) =
        (R.take j).filter (fun r => !keyBit k r) ++ [R[j]] := by
      rw [htk, List.filter_append]; simp [hr, hb]
    have t48 : t.G 49 = .int (((R.take j).filter (fun r => !keyBit k r)).flatten.length) :: s.G 49 := by
      rw [tG 49 (by decide), passSt_G49]
    have u48 : ((t.upd 0 (ints (R.drop (j + 1)).flatten ++ Rest)).upd 47
        ((ints R[j]).reverse ++ t.G 47)).G 49 =
        .int (((R.take j).filter (fun r => !keyBit k r)).flatten.length) :: s.G 49 := by
      simp only [IState.upd_G]; simp (config := {decide := true}) [t48]
    constructor
    · refine ⟨hbok.1, hbok.2, ?_⟩
      rw [if_neg hc]
      refine ⟨hk1, ?_⟩
      rw [hk2]
      exact ⟨by decide, hcl 49 (by decide), ⟨IState.isInt_of u48, trivial⟩, IState.isInt_of u48⟩
    · show (if bitE.eval t < 0 then _ else _) = _
      rw [if_neg hc, run_seq, hk2]
      apply run_ext _ (by rw [← ht]; simp [withCtr, passSt]) (by rw [← ht]; simp [withCtr, passSt])
      intro x
      rw [run_asg_G]
      by_cases x50 : x = 50
      · subst x50
        rw [← ht]; simp only [IState.upd_G, withCtr_G]; simp (config := {decide := true})
      rw [withCtr_G_ne _ _ _ _ x50]
      by_cases x0 : x = 0
      · subst x0
        simp only [IState.upd_G]; simp (config := {decide := true}) [passSt_G0]
      by_cases x46 : x = 47
      · subst x46
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G47, hf2, ints_append, ints_reverse, tG]
      by_cases x48 : x = 49
      · subst x48
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G49, hf2, Ex.eval, IState.top_eq u48, hlen, t48]
      by_cases x47 : x = 46
      · subst x47
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G46, hf1, tG]
      by_cases x49 : x = 48
      · subst x49
        simp only [IState.upd_G]
        simp (config := {decide := true}) [passSt_G48, hf1, tG]
      simp only [IState.upd_G, if_neg x0, if_neg x46, if_neg x48]
      rw [tG x x50, passSt_G_other _ _ _ _ _ _ x0 x47 x46 x49 x48,
        passSt_G_other _ _ _ _ _ _ x0 x47 x46 x49 x48]

theorem passSt_zero (k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (h0 : s.G 0 = ints R.flatten ++ Rest) :
    passSt k s R Rest 0 = (push 49 (.lit 0)).run ((push 48 (.lit 0)).run s) := by
  apply IState.ext' _ (by simp [passSt]) (by simp [passSt])
  intro x
  simp only [passSt, IState.upd_G, run_push_G, Ex.eval]
  by_cases x0 : x = 0
  · subst x0; simp (config := {decide := true}) [h0]
  split_ifs <;> simp_all

theorem pass_states (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L52 : List Item)
    (h1 : s.G 1 = .int R.length :: L1) (h52 : s.G 52 = .int (2 ^ k) :: L52) :
    RepStates 50 (.reg 1) (recBody w) (passSt k s R Rest 0) (passSt k s R Rest) where
  nonneg := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L1) (a := R.length)]
    · positivity
    · rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  hw := by simp (config := {decide := true}) [recBody, mvK, RS.writes]
  h0 := rfl
  hG := fun j => by
    rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide),
      passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)]
  step := by
    intro j hj
    have e : (Ex.reg (S := HS) 1).eval (passSt k s R Rest 0) = R.length := by
      simp only [Ex.eval]
      rw [IState.top_eq (L := L1) (a := R.length)]
      rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
    rw [e, Int.toNat_natCast] at hj ⊢
    exact (pass_step w k s R Rest hR hw L52 h52 _ j hj _).2

theorem passP_spec (w k : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 L52 : List Item)
    (h0 : s.G 0 = ints R.flatten ++ Rest)
    (h1 : s.G 1 = .int R.length :: L1) (h52 : s.G 52 = .int (2 ^ k) :: L52) :
    (NLogN.passP w).ok s ∧ (NLogN.passP w).run s = s.upd 0 (ints (radixPass k R).flatten ++ Rest) := by
  have H := pass_states w k s R Rest hR hw L1 L52 h1 h52
  have e1 : (Ex.reg (S := HS) 1).eval (passSt k s R Rest 0) = R.length := by
    simp only [Ex.eval]
    rw [IState.top_eq (L := L1) (a := R.length)]
    rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
  have hz := passSt_zero k s R Rest h0
  have hloop : (passLoop w).run (passSt k s R Rest 0) = passSt k s R Rest R.length := by
    rw [passLoop, H.run, e1, Int.toNat_natCast]
  have hlok : (passLoop w).ok (passSt k s R Rest 0) := by
    refine H.ok (by decide) (clean_of_lt (by decide)) ?_ ?_
    · apply IState.isInt_of (L := L1) (a := R.length)
      rw [passSt_G_other _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide), h1]
    · intro j hj
      rw [e1, Int.toNat_natCast] at hj ⊢
      exact (pass_step w k s R Rest hR hw L52 h52 _ j hj _).1
  set t3 := passSt k s R Rest R.length with ht3
  set ones := R.filter (keyBit k)
  set zeros := R.filter (fun r => !keyBit k r)
  have g46 : t3.G 46 = ints ones.flatten.reverse ++ s.G 46 := by
    rw [ht3, passSt_G46, List.take_length]
  have g48 : t3.G 48 = .int ones.flatten.length :: s.G 48 := by
    rw [ht3, passSt_G48, List.take_length]
  have g0 : t3.G 0 = Rest := by rw [ht3, passSt_G0]; simp
  have m1 := mvK_spec (X := 46) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (.reg 48) (clean_of_lt (by decide)) t3 ones.flatten.reverse (s.G 46)
    g46 (IState.isInt_of g48) (by simp [Ex.eval, IState.top_eq g48])
  set t4 := (t3.upd 46 (s.G 46)).upd 0 ((ints ones.flatten.reverse).reverse ++ t3.G 0) with ht4
  have g47 : t4.G 47 = ints zeros.flatten.reverse ++ s.G 47 := by
    simp only [ht4, IState.upd_G]
    simp (config := {decide := true}) [ht3, passSt_G47, List.take_length]; rfl
  have g49 : t4.G 49 = .int zeros.flatten.length :: s.G 49 := by
    simp only [ht4, IState.upd_G]
    simp (config := {decide := true}) [ht3, passSt_G49, List.take_length]; rfl
  have g40 : t4.G 0 = ints ones.flatten ++ Rest := by
    simp [ht4, g0, ints_reverse]
  have m2 := mvK_spec (X := 47) (Y := 0) (C := 51) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (.reg 49) (clean_of_lt (by decide)) t4 zeros.flatten.reverse (s.G 47)
    g47 (IState.isInt_of g49) (by simp [Ex.eval, IState.top_eq g49])
  set t5 := (t4.upd 47 (s.G 47)).upd 0 ((ints zeros.flatten.reverse).reverse ++ t4.G 0) with ht5
  have g549 : t5.G 49 = .int zeros.flatten.length :: s.G 49 := by
    simp only [ht5, IState.upd_G]; simp (config := {decide := true}) [g49]
  have g548 : t5.G 48 = .int ones.flatten.length :: s.G 48 := by
    simp only [ht5, ht4, IState.upd_G]; simp (config := {decide := true}) [g48]
  have hrun : (NLogN.passP w).run s = (pop 48).run ((pop 49).run t5) := by
    simp only [NLogN.passP, run_seq]
    rw [← hz, hloop, m1.2, m2.2]
  refine ⟨?_, ?_⟩
  · refine ⟨⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩,
      ⟨by decide, by intro i hi; simp [Ex.regs] at hi, trivial⟩, ?_⟩
    rw [← hz]
    refine ⟨hlok, ?_⟩
    rw [hloop]
    refine ⟨m1.1, ?_⟩
    rw [m1.2]
    refine ⟨m2.1, ?_⟩
    rw [m2.2]
    refine ⟨⟨by decide, IState.isInt_of g549⟩, by decide, ?_⟩
    apply IState.isInt_of (L := s.G 48) (a := ones.flatten.length)
    simp only [run_pop_G]; simp (config := {decide := true}) [g548]
  · rw [hrun]
    apply run_ext _ (by simp [ht5, ht4, ht3, passSt]) (by simp [ht5, ht4, ht3, passSt])
    intro x
    simp only [run_pop_G, IState.upd_G]
    by_cases x0 : x = 0
    · subst x0
      simp (config := {decide := true}) [ht5, g40, radixPass, ints_append, ints_reverse]; rfl
    by_cases x48 : x = 48
    · subst x48; simp (config := {decide := true}) [g548]
    by_cases x49 : x = 49
    · subst x49; simp (config := {decide := true}) [g549]
    simp only [if_neg x0, if_neg x48, if_neg x49]
    by_cases x47 : x = 47
    · subst x47; simp (config := {decide := true}) [ht5]
    by_cases x46 : x = 46
    · subst x46; simp (config := {decide := true}) [ht5, ht4]
    simp only [ht5, ht4, IState.upd_G, if_neg x0, if_neg x47, if_neg x46]
    rw [ht3, passSt_G_other _ _ _ _ _ _ x0 x46 x47 x48 x49]

theorem sortSt_G_other (s : IState HS) (R : List (List ℤ)) (Rest : List Item) (k : ℕ) (x : Fin HS)
    (h0 : x ≠ 0) (h52 : x ≠ 52) : (sortSt s R Rest k).G x = s.G x := by
  simp [sortSt, h0, h52]

theorem sort_step (w : ℕ) (s : IState HS) (R : List (List ℤ)) (Rest : List Item)
    (hR : ∀ r ∈ R, r.length = w) (hw : 1 ≤ w) (L1 : List Item)
    (h1 : s.G 1 = .int R.length :: L1) (S0 : IState HS) (N k : ℕ) :
    (sortBody w).ok (withCtr 53 S0 N k (sortSt s R Rest k)) ∧
    (sortBody w).run (withCtr 53 S0 N k (sortSt s R Rest k)) =
      withCtr 53 S0 N k (sortSt s R Rest (k + 1)) := by
  generalize ht : withCtr 53 S0 N k (sortSt s R Rest k) = t
  have hp := radixSort_perm k R
  have tG : ∀ x, x ≠ 53 → t.G x = (sortSt s R Rest k).G x := fun x hx => by
    rw [← ht, withCtr_G_ne _ _ _ _ hx]
  have t0 : t.G 0 = ints (radixSort k R).flatten ++ Rest := by
    rw [tG 0 (by decide)]; simp [sortSt]
  have t1 : t.G 1 = .int (radixSort k R).length :: L1 := by
    rw [tG 1 (by decide), sortSt_G_other _ _ _ _ _ (by decide) (by decide), h1, hp.length_eq]
  have t52 : t.G 52 = .int (2 ^ k) :: s.G 52 := by
    rw [tG 52 (by decide)]; simp [sortSt]
  have hP := NLogN.passP_spec w k t (radixSort k R) Rest
    (fun r hr => hR r (hp.subset hr)) hw L1 (s.G 52) t0 t1 t52
  have u52 : (t.upd 0 (ints (radixPass k (radixSort k R)).flatten ++ Rest)).G 52 =
      .int (2 ^ k) :: s.G 52 := by
    simp only [IState.upd_G]; simp (config := {decide := true}) [t52]
  refine ⟨⟨hP.1, ?_⟩, ?_⟩
  · rw [hP.2]
    refine ⟨by decide, ?_, ⟨IState.isInt_of u52, trivial, 1, by simp [Ex.eval]⟩,
      IState.isInt_of u52⟩
    intro i hi; simp [Ex.regs] at hi; subst hi; decide
  · rw [sortBody, run_seq, hP.2]
    apply run_ext _ (by rw [← ht]; simp [withCtr, sortSt]) (by rw [← ht]; simp [withCtr, sortSt])
    intro x
    rw [run_asg_G]
    by_cases x53 : x = 53
    · subst x53
      rw [← ht]; simp only [IState.upd_G, withCtr_G]; simp (config := {decide := true})
    rw [withCtr_G_ne _ _ _ _ x53]
    by_cases x52 : x = 52
    · subst x52
      simp only [IState.upd_G]
      simp (config := {decide := true}) [sortSt, Ex.eval, IState.top_eq u52, pow_succ, t52]
    by_cases x0 : x = 0
