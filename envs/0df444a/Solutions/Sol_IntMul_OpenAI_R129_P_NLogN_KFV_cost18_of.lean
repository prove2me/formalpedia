  have e1 : (2 * X + 1) * (250 * (p + 4) + 10 ^ 4) ≤ 10 ^ 6 * Y := by
    have : (2 * X + 1) * (250 * (p + 4) + 10 ^ 4) ≤ (3 * X) * (250 * (p + ℓ + 3) + 10 ^ 5) :=
      Nat.mul_le_mul (by omega) (by omega)
    have h2 : (3 * X) * (250 * (p + ℓ + 3) + 10 ^ 5) = 750 * Y + 3 * 10 ^ 5 * X := by rw [hY]; ring
    linarith
  have e2 : (2 * X + 1) * (250 * (2 * p + ℓ + 3 + 4) + 10 ^ 4) ≤ 10 ^ 6 * Y := by
    have : (2 * X + 1) * (250 * (2 * p + ℓ + 3 + 4) + 10 ^ 4) ≤
