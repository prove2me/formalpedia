-- Source module: Solutions.KFY17Par
/-!
# KFY 17: the numeric parameters of the passes

For `n` the bit sizes of the line programs (uniform over the axes):

* `lq = ⌊log₂(4p + 35)⌋ + 1`, `Jb = ⌊4dp/α²⌋ + 1` (a bound of every `jIter p s t α`, from the
  source window `4d s ≤ (4d − 1) t`), `mm = 3p + 2lq + 4 + (2lq + 1) Jb` (the multiplier width),
  `Bacc`, `Bo`, `Q`, `Bq`, the register environment `A = 2^E`, `B = 8E + 1`;
* **`sapHypN`**, **`tabHypN`**, **`axQAN`**, **`bapHypN`**, **`tabHypBN`**, **`axBndN`**,
  **`axBndBN`**, **`mulBndN`**: the hypotheses of `passA_all` / `passB_all`.

The facts of `n` used (`NF n`) come from KFQ `chainSizes` and KFMSetup `srcS_ok_n`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.OpenAI.Glue NLogN.GL NLogN.AX NLogN.Rsp

noncomputable section

def lqN (n : ℕ) : ℕ := Nat.log 2 (4 * pP n + 35) + 1
def JbN (n : ℕ) : ℕ := 4 * IntMul.OpenAI.Glue.dP n * pP n / αP n ^ 2 + 1
def mmN (n : ℕ) : ℕ := 3 * pP n + 2 * lqN n + 4 + (2 * lqN n + 1) * JbN n
def BaccN (n : ℕ) : ℕ := 2 * mmN n + 4 * lqN n + ℓP n + 2 * pP n + 8
def BoN (n : ℕ) : ℕ := pP n + 2 + mmN n + 3 * lqN n
def QN (n : ℕ) : ℕ := BoN n + IntMul.OpenAI.Glue.LP n + ℓP n + 4
def BqN (n : ℕ) : ℕ := 24 * (ℓP n + 2 * lqN n + 4) + 2 * pP n + lqN n + 2
def EN (n : ℕ) : ℕ := 2 * pP n + IntMul.OpenAI.Glue.LP n + 2 * ℓP n + 2 * lqN n + 8
def AN (n : ℕ) : ℕ := 2 ^ EN n
def BN (n : ℕ) : ℕ := 8 * EN n + 1

/-- The closed bound of `mulCostH` (KFMMul `mulCostH_le`). -/
def ΦF (m : ℕ) : ℕ :=
  (8 * fmA + 10 ^ 7 + 10 ^ 5) * (m + 1) * (zsz ((m + 1 : ℕ) : ℤ) + 2) *
    (zsz (((zsz ((m + 1 : ℕ) : ℤ) + 2) ^ 4 : ℕ) : ℤ) + 1)
def ΦN (n : ℕ) : ℕ := ΦF (2 * mmN n)

/-- The multiplication spec of the merged table. -/
def MS : MulSpec := ⟨fun a b => KFM.mulCostH (zsz a + zsz b), fun _ _ => True⟩

/-! ## The facts of `n` -/

/-- The facts of `n` used by the parameter proofs. -/
structure NF (n : ℕ) : Prop where
  hn : IntMul.OpenAI.Glue.n0 ≤ n
  α2 : 2 ≤ αP n
  αp : αP n ^ 2 ≤ pP n
  d2 : 2 ≤ IntMul.OpenAI.Glue.dP n
  win : ∀ k < IntMul.OpenAI.Glue.dP n, 2 ≤ KFM.srcN n k ∧ Odd (KFM.srcN n k) ∧
    4 * IntMul.OpenAI.Glue.dP n * KFM.srcN n k ≤ (4 * IntMul.OpenAI.Glue.dP n - 1) * tN n k

/-! ## Per-axis consequences -/

/-- The per-axis facts. -/
structure AxF (n k : ℕ) : Prop where
  s0 : 0 < KFM.srcN n k
  st : KFM.srcN n k < tN n k
  co : Nat.Coprime (KFM.srcN n k) (tN n k)
  sw : KFM.srcN n k ≤ 4 * IntMul.OpenAI.Glue.dP n * (tN n k - KFM.srcN n k)
  tr : tN n k ≤ 2 ^ ℓP n
  t2 : 2 ≤ tN n k
  J : HvdH.jIter (pP n) (KFM.srcN n k) (tN n k) (αP n) ≤ JbN n

