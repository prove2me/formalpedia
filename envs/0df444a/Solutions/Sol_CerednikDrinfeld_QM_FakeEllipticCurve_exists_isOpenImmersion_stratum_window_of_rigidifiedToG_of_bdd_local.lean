        deg (ChartDict3.pad hΛℤ ρ i j) = c ^ i * deg ρ ∧ deg' (ChartDict3.pad hΛℤ ρ i j) = c ^ j * deg' ρ)
    (hprod : ∀ {T : Type} [CommRing T] [Algebra 𝒪 T] {ψT : Onr →ₐ[𝒪] T} {E : FakeEllipticCurve Λ N T}
