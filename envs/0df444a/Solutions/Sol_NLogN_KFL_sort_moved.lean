namespace NLogN.KFL

theorem rpass_perm (i : ℕ) (E : List Ent) : (rpass i E).Perm E := List.filter_append_perm _ _

theorem rsort_perm : ∀ (i : ℕ) (E : List Ent), (rsort i E).Perm E
  | 0, E => List.Perm.refl _
  | i + 1, E => (rpass_perm i _).trans (rsort_perm i E)

theorem bit_cases (n i : ℕ) : n / 2 ^ i % 2 = 0 ∨ n / 2 ^ i % 2 = 1 := Nat.mod_two_eq_zero_or_one _

theorem rpass_pw (i : ℕ) (E : List Ent) (h : E.Pairwise (RO i)) :
    (rpass i E).Pairwise (RO (i + 1)) := by
  rw [rpass, List.pairwise_append]
  have key : ∀ n : ℕ, n % 2 ^ (i + 1) = n % 2 ^ i + 2 ^ i * (n / 2 ^ i % 2) :=
    fun n => Nat.mod_pow_succ
  refine ⟨?_, ?_, ?_⟩
  · refine (h.filter _).imp_of_mem (fun {a b} ha hb hab => ?_)
    rw [List.mem_filter] at ha hb
    simp only [bitP, decide_eq_true_eq] at ha hb
    unfold RO at *; rw [key a.1, key b.1, ha.2, hb.2]; omega
  · refine (h.filter _).imp_of_mem (fun {a b} ha hb hab => ?_)
    rw [List.mem_filter] at ha hb
    simp only [bitP, Bool.not_eq_true', decide_eq_false_iff_not] at ha hb
    have ha2 : a.1 / 2 ^ i % 2 = 0 := by have := bit_cases a.1 i; omega
    have hb2 : b.1 / 2 ^ i % 2 = 0 := by have := bit_cases b.1 i; omega
    unfold RO at *; rw [key a.1, key b.1, ha2, hb2]; omega
  · intro a ha b hb
    rw [List.mem_filter] at ha hb
    simp only [bitP, decide_eq_true_eq, Bool.not_eq_true', decide_eq_false_iff_not] at ha hb
    have hb2 : b.1 / 2 ^ i % 2 = 0 := by have := bit_cases b.1 i; omega
    have hlt : b.1 % 2 ^ i < 2 ^ i := Nat.mod_lt _ (by positivity)
    unfold RO; rw [key a.1, key b.1, ha.2, hb2]; omega

theorem rsort_pw : ∀ (i : ℕ) (E : List Ent), (rsort i E).Pairwise (RO i)
  | 0, E => List.pairwise_of_forall (fun a b => by simp [RO, Nat.mod_one])
  | i + 1, E => rpass_pw i _ (rsort_pw i E)

/-- **The radix sort sorts.** -/
theorem rsort_eq {A : ℕ} {E L : List Ent} (hk : ∀ e ∈ E, e.1 < 2 ^ A)
    (hnd : (E.map Prod.fst).Nodup) (hp : L.Perm E) (hs : L.Pairwise (fun a b => b.1 < a.1)) :
    rsort A E = L := by
  have hp' := rsort_perm A E
  apply List.Perm.eq_of_pairwise (le := fun a b => b.1 < a.1)
  · intro a b _ _ h1 h2; omega
  · have hnd' : ((rsort A E).map Prod.fst).Nodup := (hp'.map _).nodup_iff.2 hnd
    rw [List.Nodup, List.pairwise_map] at hnd'
    refine ((rsort_pw A E).and hnd').imp_of_mem (fun {a b} ha hb hab => ?_)
    have ha' := hk a (hp'.subset ha)
    have hb' := hk b (hp'.subset hb)
    obtain ⟨h1, h2⟩ := hab
    unfold RO at h1; rw [Nat.mod_eq_of_lt ha', Nat.mod_eq_of_lt hb'] at h1
    omega
  · exact hs
  · exact hp'.trans hp.symm

