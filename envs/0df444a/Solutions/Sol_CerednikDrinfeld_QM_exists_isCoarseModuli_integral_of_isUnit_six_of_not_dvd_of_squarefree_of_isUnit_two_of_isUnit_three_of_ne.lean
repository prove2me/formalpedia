theorem ReduceINT.base_level
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (N : ℕ) [NeZero N] (hqN : ¬ q ∣ N) (hq'N : ¬ q' ∣ N) (hNsq : Squarefree N)
    (𝒪 : Type) [CommRing 𝒪] [IsDomain 𝒪] [CharZero 𝒪] (hN : IsUnit ((N : ℕ) : 𝒪)) (h2 : IsUnit ((2 : ℕ) : 𝒪))
    (h3 : IsUnit ((3 : ℕ) : 𝒪)) (m : ℕ) (hm : 3 ≤ m) (hmu : IsUnit ((m : ℕ) : 𝒪)) :
    ∃ (M : Scheme.{0}) (πM : M ⟶ Spec (CommRingCat.of 𝒪))
      (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
        FakeEllipticCurve.WithFullLevel Λ N m S → SchemeHomOver s πM)
      (G : Type) (_ : Group G) (_ : Fintype G) (ρ : G →* Aut M) (χ : G → ↥Λ)
      (X : Scheme.{0}) (πX : X ⟶ Spec (CommRingCat.of 𝒪)) (π : M ⟶ X)
      (pt : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)), FakeEllipticCurve Λ N S → SchemeHomOver s πX),
      IsFineModuli Λ N m M πM ptF ∧ IsLevelTwistAction Λ N m M πM ptF G ρ χ ∧
      π ≫ πX = πM ∧ (∀ g : G, (ρ g).hom ≫ π = π) ∧
      (∀ (T : Scheme.{0}) (f : M ⟶ T), (∀ g : G, (ρ g).hom ≫ f = f) → ∃! f' : X ⟶ T, π ≫ f' = f) ∧
      IsCoarseModuli Λ N X πX pt ∧
      (∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪))
        (u : FakeEllipticCurve.WithFullLevel Λ N m S), (pt S s u.1).1 = (ptF S s u).1 ≫ π) ∧
      IsIntegral X ∧ Flat πX ∧ IsSeparated πX ∧ LocallyOfFiniteType πX ∧ QuasiCompact πX ∧
      (IsUnit ((6 * q * q' : ℕ) : 𝒪) → SmoothOfRelativeDimension 1 πX) ∧
      (∀ x : M, ∃ U : M.Opens, IsAffineOpen U ∧ x ∈ U ∧ ∀ g : G, (ρ g).hom ⁻¹ᵁ U = U) ∧
      IsSeparated πM ∧ QuasiCompact πM ∧ LocallyOfFiniteType πM ∧
      (IsUnit ((6 * q * q' : ℕ) : 𝒪) → SmoothOfRelativeDimension 1 πM) := by
  obtain ⟨M, πM, ptF, hM, hsep, hqc, hlft, hAF, hsm⟩ :=
    CerednikDrinfeld.QM.exists_isFineModuli_of_isUnit_two_of_isUnit_three hqq' hB Λ hΛ N m hm 𝒪 hN hmu h2 h3
  haveI : NeZero m := ⟨by omega⟩
  obtain ⟨G, instG, instF, ρ, χ, hρ⟩ :=
    CerednikDrinfeld.QM.IsFineModuli.exists_isLevelTwistAction Λ hΛ.isOrder N m hM
  letI := instG; letI := instF
  have hadm := AlgebraicGeometry.Scheme.forall_exists_isAffineOpen_invariant_of_isSeparated_of_finset πM hsep hAF ρ
  obtain ⟨X, π, hπ, hint, haff, hsurj, horbit, hsec, hinv, hopen, hcat⟩ :=
    AlgebraicGeometry.Scheme.exists_quotient_of_finite_of_forall_exists_isAffineOpen_invariant ρ hadm
  obtain ⟨πX, hπX⟩ := (hcat _ πM hρ.over_base).exists
  obtain ⟨pt, hX, hpt⟩ := CerednikDrinfeld.QM.IsFineModuli.exists_isCoarseModuli_of_quotient_of_isIndefiniteRamifiedExactlyAt hqq' hB Λ hΛ N m hmu hM hρ
    X πX π hπX hπ hint haff hsurj horbit hsec hinv hopen hcat
  obtain ⟨hXsep, hXqc⟩ :=
    AlgebraicGeometry.Scheme.isSeparated_and_quasiCompact_of_isIntegralHom_of_surjective πM πX π hπX hint hsurj hsep hqc
  obtain ⟨hXint, hXflat, hXlft⟩ := stub_quot_integral_flat_lft hqq' hB Λ hΛ N m hqN hq'N hNsq hm 𝒪 hN h2 h3 hmu hM hρ
    X πX π hπX hπ hint haff hsurj horbit hsec hinv hopen hcat hX hXsep
  refine ⟨M, πM, ptF, G, instG, instF, ρ, χ, X, πX, π, pt, hM, hρ, hπX, hπ, hcat, hX, hpt, hXint, hXflat, hXsep, hXlft, hXqc,
    fun hu => ?_, hadm, hsep, hqc, hlft, fun hu => hsm (ReduceINT.isUnit_qq'_of_six hu)⟩
  exact CerednikDrinfeld.QM.IsFineModuli.smoothOfRelativeDimension_one_of_quotient_of_isUnit_six hqq' hB Λ hΛ N m hm 𝒪 hN hmu hu hM (hsm (ReduceINT.isUnit_qq'_of_six hu)) hρ G (MonoidHom.id G)
    (fun _ _ h => h) X πX π hπX hπ hint haff hsurj horbit hsec hinv hopen hcat

