variable {k i r' : ℕ}

theorem PIQnLT.dot_liftVec (w u : Fin (2 * r' + k + 1) → ℂ) :
    star (liftVec k i r' w) ⬝ᵥ liftVec k i r' u = star w ⬝ᵥ u := by sorry
