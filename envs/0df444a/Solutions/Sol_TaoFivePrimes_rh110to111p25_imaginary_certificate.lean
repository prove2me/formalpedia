lemma complex_identity (x y : ℝ) :
    (∑ n ∈ Finset.range 40, (c n:ℂ)*((y:ℂ)-Complex.I*x)^n)-
      (realValue x y:ℂ)= -Complex.I*((x*CertifiedLocalPolynomial.bivariatePowerValue 7 15 a
        (4*x^2) ((4/5)*(y+1/2))):ℂ) := by
  norm_num [c,TaoFivePrimes_RH110p5RoundedCoefficients,Finset.sum_range_succ,
    CertifiedLocalPolynomial.bivariatePowerValue,
    a,entry,powerMatrix,Fin.sum_univ_succ,realValue]
  push_cast
  ring_nf
  norm_num [Complex.I_pow_eq_pow_mod]
  try simp only [Complex.I_sq,Complex.I_pow_three,pow_zero,pow_one]
  apply Complex.ext <;>
    simp [←Complex.ofReal_pow,Complex.mul_re,Complex.mul_im] <;> ring

lemma imaginary_identity (s : ℂ) :
    (TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH110p5RoundedCoefficients
      40 (221/2) s).im = -((s.re-1/2)*
      CertifiedLocalPolynomial.bivariatePowerValue 7 15 a
        (4*(s.re-1/2)^2) ((4/5)*(s.im-110))) := by
  have h := complex_identity (s.re-1/2) (s.im-221/2)
  have hw : -Complex.I*(s-RH1000Analytic.CertifiedLocalXi.center (221/2)) =
      ((s.im-221/2:ℝ):ℂ)-Complex.I*((s.re-1/2:ℝ):ℂ) := by
    apply Complex.ext <;> simp [RH1000Analytic.CertifiedLocalXi.center] <;> ring
  unfold TaoFivePrimes_RHLocalRoundedPolynomial
  simp only [hw]
  have hr := congrArg Complex.im h
  simp only [Complex.sub_im,Complex.ofReal_im,sub_zero,Complex.mul_im,
    Complex.I_re,Complex.I_im,Complex.ofReal_re,zero_mul,zero_add,one_mul] at hr
  have he : (4/5:ℝ)*(s.im-221/2+1/2)=(4/5)*(s.im-110) := by ring
  rw [he] at hr
  simp only [c,Complex.ofReal_div,Complex.ofReal_intCast] at hr
  simp only [Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,mul_zero,sub_zero] at hr
  simp only [Complex.ofReal_intCast]
  norm_num only [Complex.neg_re,Complex.neg_im,Complex.I_re,Complex.I_im, zero_mul, zero_add, neg_one_mul] at hr
  norm_num only
  exact hr

open scoped unitInterval
attribute [local irreducible] a r b
lemma ratio_positive (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : 110 ≤ s.im) (hb : s.im ≤ (445/4:ℝ)) :
    3 ≤ CertifiedLocalPolynomial.bivariatePowerValue 7 15 a
      (4*(s.re-1/2)^2) ((4/5)*(s.im-110)) := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(4/5)*(s.im-110),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 15 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 7
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, (3:ℝ)≤(b i j:ℝ) := by
    intro i j
    exact_mod_cast bernstein_checked.2.2 i j
  exact CertifiedLocalPolynomial.bivariate_bernstein_lower 7 15 a r b hr hc 3 hl x y
end Imag107

theorem solution (s : ℂ) (h0 : 0 ≤ s.re) (h1 : s.re ≤ 1)
    (ha : 110 ≤ s.im) (hb : s.im ≤ (445/4:ℝ)) :
    (3:ℝ)*|s.re-1/2| ≤
      |(TaoFivePrimes_RHLocalRoundedPolynomial TaoFivePrimes_RH110p5RoundedCoefficients
        40 (221/2) s).im| := by
  have hp := Imag107.ratio_positive s h0 h1 ha hb
  rw [Imag107.imaginary_identity,abs_neg,abs_mul,abs_of_nonneg (by linarith :
    0 ≤ CertifiedLocalPolynomial.bivariatePowerValue 7 15 Imag107.a
      (4*(s.re-1/2)^2) ((4/5)*(s.im-110)))]
  simpa only [mul_comm] using mul_le_mul_of_nonneg_left hp (abs_nonneg (s.re-1/2))
