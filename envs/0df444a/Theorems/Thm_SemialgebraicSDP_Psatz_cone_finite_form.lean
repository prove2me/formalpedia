-- title:
--   §4.2 — $P(S)=\{p+\sum q_ib_i\}$ for a finite set $S$
-- statement:
--   Let $S=\{a_1,\dots,a_m\}\subseteq\mathbb R[x_1,\dots,x_n]$ be finite and let $M(a_i)$ be the multiplicative monoid generated by the $a_i$ (finite products, the empty product $1$ included). Then
--   $$
--   P(S)=\Big\{p+\sum_{i=1}^r q_ib_i \;\Big|\; r\in\mathbb N,\ p,q_1,\dots,q_r\in P(\emptyset),\ b_1,\dots,b_r\in M(a_i)\Big\}.
--   $$
--   This is the explicit description of the cone generated by finitely many polynomials that is used to parameterize Positivstellensatz certificates.
--
--   **Formalization Note** The finite set is the range of a family $a:\{1,\dots,m\}\to\mathbb R[x]$ ($m=0$ allowed); the monoid is the submonoid closure of that range.
-- source:
--   Parrilo, Semidefinite programming relaxations for semialgebraic problems, Math. Program. Ser. B 96 (2003) 293–320, pp. 304–305, §4.2, display at the top of p. 305

import Mathlib
import Definitions.Def_SemialgebraicSDP_Psatz_Cone

namespace SemialgebraicSDP.Psatz

open MvPolynomial

theorem cone_finite_form {n m : ℕ} (a : Fin m → MvPolynomial (Fin n) ℝ) :
    cone (Set.range a) =
      {x | ∃ (r : ℕ) (p : MvPolynomial (Fin n) ℝ) (q b : Fin r → MvPolynomial (Fin n) ℝ),
        p ∈ cone ∅ ∧ (∀ i, q i ∈ cone ∅) ∧ (∀ i, b i ∈ Submonoid.closure (Set.range a)) ∧
        x = p + ∑ i, q i * b i} := by sorry

end SemialgebraicSDP.Psatz
