-- title:
--   Theorem 3.1(iii), p. 9 — a feasible accumulation point of the penalty method at which the PSCQ holds is B-stationary
-- statement:
--   Consider the constrained DC program (1.1) under its standing assumptions. Let $\{x^k\}$ be generated by Algorithm 3.1: for inputs $\epsilon>0$, $\rho_0>0$, $\sigma>1$, $\eta_k\ge 0$ with $\eta_k\to 0$ and exponent $p\ge 1$, each $x^k\in X$ satisfies
--
--   $$
--   F_{\rho_k}(x^k)\le Q_{\rho_k}(x;x^k,j_0,\mathbb J)+\eta_k\qquad\forall x\in X,\ j_0\in\mathcal J_{0,\epsilon}(x^k),\ \mathbb J\in\mathcal J_\epsilon(x^k),
--   $$
--
--   with $\rho_k=\rho_0\sigma^k$. Assume that $\{x^k\}_{k\in\mathcal K}$ converges to $x^\infty$ for some subsequence $\mathcal K$. If $x^\infty\in\Omega$, $\mathcal I_=(x^\infty)\neq\emptyset$, and the PSCQ holds for $\Omega$ at $x^\infty$, then $x^\infty$ is a B-stationary point of (1.1):
--
--   $$
--   F'(x^\infty;d)\ge 0\qquad\forall d\in\mathcal T_\Omega(x^\infty).
--   $$
--
--   This is the paper's main convergence result for its penalty method. Unlike the earlier result of Pang, Razaviyayn and Alvarado, it does not require the maximizing piece of each $\psi_i$ at $x^\infty$ to be unique, and it uses the weaker pointwise Slater condition.
--
--   **Formalization Note** The subsequence is a strictly increasing $K:\mathbb N\to\mathbb N$ with $x^{K(k)}\to x^\infty$. B-stationarity is over the Bouligand tangent cone of $\Omega$ (positive scalings) and asserts that $F'(x^\infty;d)$ exists and is $\ge 0$. The theorem quantifies over every run; it does not claim that runs exist.
-- source:
--   Lu, Sun & Zhou, Penalty and augmented Lagrangian methods for constrained DC programming, arXiv:2111.09263v1, p. 9, Theorem 3.1(iii)

import Mathlib
import Definitions.Def_ClarkeGradients_MaxFunctions_HasOneSidedDirDeriv
import Definitions.Def_DCPenalty_Penalty_Problem
import Definitions.Def_DCPenalty_Penalty_Stationarity
import Definitions.Def_DCPenalty_Penalty_Algorithm

namespace DCPenalty.Penalty

open Filter Topology

/-- Theorem 3.1(iii), p. 9: let `{x^k}` be generated by Algorithm 3.1 and let `{x^k}_{k ∈ 𝒦}`
converge to `x^∞`. If `x^∞ ∈ Ω`, `𝓘_=(x^∞) ≠ ∅` and the PSCQ holds for `Ω` at `x^∞`, then `x^∞`
is a B-stationary point of problem (1.1). -/
theorem theorem_3_1_iii {n m : ℕ} (P : DCProblem n m) (hP : P.Standing)
    {p ε ρ0 σ : ℝ} {η : ℕ → ℝ} {x : ℕ → EuclideanSpace ℝ (Fin n)}
    (hrun : P.IsPenaltyRun p ε ρ0 σ η x)
    {K : ℕ → ℕ} (hK : StrictMono K) {xinf : EuclideanSpace ℝ (Fin n)}
    (hlim : Tendsto (x ∘ K) atTop (𝓝 xinf))
    (hfeas : xinf ∈ P.Ω) (hact : (P.Ieq xinf).Nonempty) (hpscq : P.PSCQ xinf) :
    P.IsBStationary xinf := by sorry

end DCPenalty.Penalty
