theorem Ex.okBnd_sub {s : IState HS} (hs : Agree σ s) (B : ℕ) :
    ∀ e : Ex HS, e.ok s → e.Bnd s B → (Ex.sub σ e).ok s ∧ (Ex.sub σ e).Bnd s B
  | .reg i, h1, h2 => by
