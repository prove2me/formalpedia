[OFFLINE-WRITTEN, build-pending; risk: low (`rfl` field goals)] -/
def swapKLRS : ((ℤ × ℤ) × (ℤ × ℤ)) ≃ ((ℤ × ℤ) × (ℤ × ℤ))
    where
  toFun := fun p => (p.2, p.1)
  invFun := fun q => (q.2, q.1)
  left_inv := by rintro ⟨⟨k, l⟩, ⟨r, s⟩⟩; rfl
  right_inv := by rintro ⟨⟨r, s⟩, ⟨k, l⟩⟩; rfl

