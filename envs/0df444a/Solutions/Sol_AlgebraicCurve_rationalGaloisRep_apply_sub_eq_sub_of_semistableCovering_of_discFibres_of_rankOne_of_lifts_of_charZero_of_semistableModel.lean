theorem rational_of_integral (p : ℕ) [Fact p.Prime] (J : Type) [AddCommGroup J]
    (G : Type) [Monoid G] [DistribMulAction G J] (g g' : G)
    (H : ∀ x : TateModule p J,
      TateModule.rep p J G g' (TateModule.rep p J G g x - x) = TateModule.rep p J G g x - x) :
    ∀ v : ModularCurve.RationalTateModule p J,
      ModularCurve.rationalGaloisRep p J G g' (ModularCurve.rationalGaloisRep p J G g v - v) =
        ModularCurve.rationalGaloisRep p J G g v - v := by
  intro v
  induction v using TensorProduct.induction_on with
  | zero => simp
  | tmul a x =>
      rw [ModularCurve.rationalGaloisRep_tmul, ← TensorProduct.tmul_sub, ModularCurve.rationalGaloisRep_tmul, H]
  | add u v hu hv =>
      have hsplit : ModularCurve.rationalGaloisRep p J G g (u + v) - (u + v) =
          (ModularCurve.rationalGaloisRep p J G g u - u) + (ModularCurve.rationalGaloisRep p J G g v - v) := by
        rw [map_add]; abel
      rw [hsplit, map_add, hu, hv]

