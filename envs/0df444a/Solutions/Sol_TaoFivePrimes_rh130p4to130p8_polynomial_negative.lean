    (7/10) ≤ -(TaoFivePrimes_RHLocalRationalPolynomial TaoFivePrimes_RH128RoundedCoefficients14 (10^14)
      40 (256/2) s).re := by
  let x : Set.Icc (0:ℝ) 1 := ⟨4*(s.re-1/2)^2,⟨by positivity,by
    nlinarith [mul_nonneg h0 (show 0≤1-s.re by linarith)]⟩⟩
  let y : Set.Icc (0:ℝ) 1 := ⟨(5/2)*(s.im-(652/5)),⟨by linarith,by linarith⟩⟩
  have hr : ∀ i, r i=TaoZetaNumerics.bernsteinTransform 21 (a i) := by
    intro i
    funext j
    exact bernstein_checked.1 i j
  have hc : ∀ j, (fun i => b i j)=TaoZetaNumerics.bernsteinTransform 10
      (fun i => r i j) := by
    intro j
    funext i
    exact bernstein_checked.2.1 i j
  have hl : ∀ i j, ((7/10):ℝ)≤(b i j:ℝ) := by
    intro i j
    have hr : ((7/10:ℚ):ℝ) ≤ (b i j:ℝ) := Rat.cast_le.mpr (bernstein_checked.2.2 i j)
    norm_num at hr ⊢
    exact hr
  have hh := CertifiedLocalPolynomial.bivariate_bernstein_lower 10 21 a r b hr hc (7/10) hl x y
  rw [power_identity]
  exact hh
end Negative107

