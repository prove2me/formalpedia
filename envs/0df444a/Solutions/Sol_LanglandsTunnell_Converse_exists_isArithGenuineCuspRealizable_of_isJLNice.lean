    (theForm d archR archC dR dC dF) (fun β g => seriesTerm d archR archC dR dC dF g β) h α
    (fun γ hγ => whittakerCoefficient_const_one_eq_zero _ _ _ (stdAddChar K) stdAddChar_isGlobalAddChar h γ hγ)
