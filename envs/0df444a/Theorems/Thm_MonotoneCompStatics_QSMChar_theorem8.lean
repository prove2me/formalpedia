-- title:
--   Theorem 8 — f is quasisupermodular iff a strictly increasing transformation makes it supermodular on every sublattice {x₁, x₂, x₁ ∨ x₂, x₁ ∧ x₂}
-- statement:
--   Let $X$ be a lattice and $f : X \to \mathbb{R}$. Then $f$ is quasisupermodular if and only if there exists a function $g : \mathbb{R} \times X \times X \to \mathbb{R}$ such that
--
--   1. for every fixed $(x_1, x_2) \in X^2$, the map $r \mapsto g(r, x_1, x_2)$ is strictly increasing, and
--   2. for every $x_1, x_2 \in X$, the function $x \mapsto g(f(x), x_1, x_2)$ is supermodular on the sublattice $\{x_1, x_2, x_1 \vee x_2, x_1 \wedge x_2\}$:
--
--   $$
--   g(f(u), x_1, x_2) + g(f(v), x_1, x_2) \le g(f(u \vee v), x_1, x_2) + g(f(u \wedge v), x_1, x_2)
--   \quad \text{for all } u, v \in \{x_1, x_2, x_1 \vee x_2, x_1 \wedge x_2\}.
--   $$
--
--   Thus quasisupermodularity is exactly "local supermodularizability": on each sublattice generated by two points, some strictly increasing reparametrization of the values of $f$ is supermodular. The transformation may depend on the pair $(x_1, x_2)$; Example 1 shows that a single transformation for all of $X$ need not exist.
--
--   **Formalization Note** $g : \mathbb{R} \times X \times X \to \mathbb{R}$ is curried as `g : ℝ → X → X → ℝ`. Quasisupermodularity of $f$ is `QuasiSupermodularOn f Set.univ`; supermodularity on the sublattice is the published `SupermodularOn` relativized to the set `{x₁, x₂, x₁ ⊔ x₂, x₁ ⊓ x₂}`, which is closed under join and meet; "strictly increasing" is `StrictMono`.
-- source:
--   Milgrom and Shannon, Monotone Comparative Statics, Econometrica 62 (1994), p. 165 (PDF p. 10), Theorem 8; proof on p. 166 (PDF p. 11)

import Mathlib
import Definitions.Def_Supermodularity_Monotonicity_SupermodularOn
import Definitions.Def_MonotoneCompStatics_Monotonicity_QuasiSupermodularOn

namespace MonotoneCompStatics.QSMChar

/-- Theorem 8 (p. 165): `f` is quasisupermodular on the lattice `X` if and only if there is
`g : ℝ → X → X → ℝ`, strictly increasing in its first argument for every fixed `(x₁, x₂)`, such
that for every `x₁, x₂` the function `x ↦ g (f x) x₁ x₂` is supermodular on the sublattice
`{x₁, x₂, x₁ ⊔ x₂, x₁ ⊓ x₂}`. -/
theorem theorem8 {X : Type*} [Lattice X] (f : X → ℝ) :
    MonotoneCompStatics.Monotonicity.QuasiSupermodularOn f Set.univ ↔
      ∃ g : ℝ → X → X → ℝ, (∀ x₁ x₂, StrictMono (fun r => g r x₁ x₂)) ∧
        ∀ x₁ x₂, Supermodularity.Monotonicity.SupermodularOn (fun x => g (f x) x₁ x₂)
          {x₁, x₂, x₁ ⊔ x₂, x₁ ⊓ x₂} := by sorry

end MonotoneCompStatics.QSMChar
