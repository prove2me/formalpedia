    have e1 : |w * rw ^ k * tf uk vk| = w * rw ^ k * |tf uk vk| := by
      rw [abs_mul, abs_of_pos (by positivity : (0:ℤ) < w * rw ^ k)]
    have e2 : w * rw ^ k * |tf uk vk| ≤ w * rw ^ k * Tm :=
      mul_le_mul_of_nonneg_left htf (by positivity)
    have e3 : w * rw ^ k * Tm ≤ Tm * w * rw ^ n := by
      have : w * rw ^ k ≤ w * rw ^ n := mul_le_mul_of_nonneg_left hpn hw.le
      nlinarith
    have := abs_nonneg a
    linarith
  have hnew : a + segSum tf ru rv rw w u v (k + 1) =
      a + segSum tf ru rv rw w u v k + w * rw ^ k * tf uk vk := by
    rw [segSum_succ]; ring
  have hnewb : zsz (a + segSum tf ru rv rw w u v (k + 1)) ≤ Bb := by
    apply KFL.zsz_le_of_abs
    have h1 := abs_add_le a (segSum tf ru rv rw w u v (k + 1))
    have : Tm * w * (rw ^ (k + 1) - 1) ≤ Tm * w * rw ^ n := by
      have : 0 ≤ Tm * w := by positivity
      nlinarith
    linarith
  have S1 := Sp.asgQ s G (i := rA) (e := .add (.reg rA) (.mul (.reg rW) T)) (by decide) gA hab
    (clean_add (clean_reg (by decide)) (clean_mul (clean_reg (by decide)) hT.clean))
    ⟨ok_reg gA, ok_reg gW, hTo⟩
    ⟨bnd_reg gA hab, ⟨bnd_reg gW hwk, hTb, by simp only [Ex.eval]; rw [top_encK gW, eT]; exact hmulb⟩,
      by simp only [Ex.eval]; rw [top_encK gA, top_encK gW, eT, ← hnew]; exact hnewb⟩
  have ev1 : (Ex.add (.reg rA) (.mul (.reg rW) T)).eval (encK s G) =
      a + segSum tf ru rv rw w u v (k + 1) := by
    simp only [Ex.eval]; rw [top_encK gA, top_encK gW, eT, hnew]
  rw [ev1] at S1
  -- step 2: u
  set G1 := Function.update G rA ((a + segSum tf ru rv rw w u v (k + 1)) :: (F rA).tail) with hG1
  have g1U : G1 rU = uk :: (F rU).tail := by simp only [G1]; rw [upd_ne (by decide)]; exact gU
  have E2 : ESp (.ndiv (.reg rU) (.reg pRu)) (encK s G1) Bb (uk / ru) :=
    ESp.ndiv (ESp.reg (by decide) g1U hukb)
      (ESp.ofG' (pRuG G1 (by
        simp only [G1]; rw [upd_ne (by decide)]
        exact hGo pRu (by decide) (by decide) (by decide) (by decide) (by decide)))
        (by decide) zru) huk hru
      (le_trans (zsz_ediv_le huk hru) hukb)
  have S2 := Sp.asgQ s G1 (i := rU) (e := .ndiv (.reg rU) (.reg pRu)) (by decide) g1U hukb
    E2.clean E2.ok E2.bnd
  rw [E2.ev, ediv_pow_succ hru] at S2
  -- step 3: v
  set G2 := Function.update G1 rU ((u / ru ^ (k + 1)) :: (F rU).tail) with hG2
  have g2V : G2 rV = vk :: (F rV).tail := by
    simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]; exact gV
  have E3 : ESp (.ndiv (.reg rV) (.reg pRv)) (encK s G2) Bb (vk / rv) :=
    ESp.ndiv (ESp.reg (by decide) g2V hvkb)
      (ESp.ofG' (pRvG G2 (by
        simp only [G2, G1]; rw [upd_ne (by decide), upd_ne (by decide)]
        exact hGo pRv (by decide) (by decide) (by decide) (by decide) (by decide))) (by decide) zrv)
      hvk hrv (le_trans (zsz_ediv_le hvk hrv) hvkb)
  have S3 := Sp.asgQ s G2 (i := rV) (e := .ndiv (.reg rV) (.reg pRv)) (by decide) g2V hvkb
    E3.clean E3.ok E3.bnd
  rw [E3.ev, ediv_pow_succ hrv] at S3
  -- step 4: w
  set G3 := Function.update G2 rV ((v / rv ^ (k + 1)) :: (F rV).tail) with hG3
  have g3W : G3 rW = (w * rw ^ k) :: (F rW).tail := by
    simp only [G3, G2, G1]
    rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]; exact gW
  have hw1 : zsz (w * rw ^ (k + 1)) ≤ Bb := by
    apply KFL.zsz_le_of_abs
    rw [abs_of_pos (by positivity)]
    have : w * rw ^ (k + 1) ≤ w * rw ^ n := mul_le_mul_of_nonneg_left hpn1 hw.le
    have := abs_nonneg a
    linarith
  have E4 : ESp (.mul (.reg rW) (.reg pRw)) (encK s G3) Bb (w * rw ^ k * rw) :=
    ESp.mul (ESp.reg (by decide) g3W hwk)
      (ESp.ofG' (pRwG G3 (by
        simp only [G3, G2, G1]; rw [upd_ne (by decide), upd_ne (by decide), upd_ne (by decide)]
        exact hGo pRw (by decide) (by decide) (by decide) (by decide) (by decide))) (by decide) zrw)
      (by rw [mul_assoc, ← pow_succ]; exact hw1)
  have S4 := Sp.asgQ s G3 (i := rW) (e := .mul (.reg rW) (.reg pRw)) (by decide) g3W hwk
    E4.clean E4.ok E4.bnd
  rw [E4.ev, mul_assoc, ← pow_succ] at S4
  have H := S1.seq (S2.seq (S3.seq S4))
  refine (H.congr ?_).mono ?_
  · congr 1; funext j
    simp only [G3, G2, G1, G, segFR, Function.update_apply]
    by_cases h1 : j = rW
    · subst h1; simp +decide
    by_cases h2 : j = rV
    · subst h2; simp +decide
    by_cases h3 : j = rU
    · subst h3; simp +decide
    by_cases h4 : j = rA
    · subst h4; simp +decide
    simp only [h1, h2, h3, h4, if_false]
  · simp only [cSegItR, Ex.size]
    have hB : 0 ≤ (Bb + 2) ^ 2 := Nat.zero_le _
    generalize (Bb + 2) ^ 2 = X at *
    generalize T.size = t
    ring_nf; omega

end IntMul.Kappa.R6.IL2C

