        hσc0 hr hS hBn hK hKec hect Z hZ hZec _ (3 * Fintype.card (Fin (NLogN.KFW.mC ^ k))) Bz hu
        (by decide) hcl2 (NLogN.KFW.zszN rfl (Nat.mod_le _ _) (le_trans (NLogN.zsz_natCast_le (by
