            min stages (Nat.ceil (Real.sqrt (target : ℝ))) = stages :=
          Nat.min_eq_left (Nat.le_of_lt hlt)
        have hnext :
            min (stages + 1) (Nat.ceil (Real.sqrt (target : ℝ))) =
              stages + 1 :=
