      D.hinf (m.toMeasured.cellDegree c) J (D.point j)) = Ideal.span {TypeDensity.localCurve Df (ee j)} := by
  let φc : Df.ι → TypeDensity.AffineDirection (ResidueField m.R) := fun i => Classical.choose (hm.common i)
