theorem _root_.solution {n g owner j : ℕ} {r : Record} (hj : j < (row n g owner r).length) :
    (row n g owner r)[j]=⟨owner,start g r.a+j⟩ := by
  unfold row at hj ⊢
  split_ifs with hf
  · simp only [List.getElem_map,List.getElem_range]
  · simp [hf] at hj
end ThreeSum.BandRawA
