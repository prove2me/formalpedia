/-! ## The window bound on an axis -/

/-- The number facts of the window on an axis. -/
theorem win_num_sol_aux {d s t : ℕ} (hd1 : 1 ≤ d) (hs : 0 < s) (hst : s ≤ t) (h8 : 8 * d ^ 2 ≤ t)
    (hts : 8 * d ^ 2 * (t - s) ≤ 2 * t) (x : ℕ) :
    ((LJ s t (lamP d) (wF d)).toFinset.filter
      (fun j => x ≤ j ∧ j ≤ x + (lamP d + wF d))).card ≤ 182 * wF d := by
  have hl : 1 ≤ lamP d := Nat.one_le_two_pow
  have h := win_le (t := t) (lam := lamP d) hs hst hl (wF d) x (lamP d + wF d)
  have hk : kF d ≤ 2 * d := by unfold kF; have := Nat.sqrt_le_self d; omega
  have hk1 : 1 ≤ kF d := by unfold kF; omega
  have hlam : lamF d < 2 * lamP d := by
    have := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) (lamF d)
    unfold lamP; rw [pow_succ] at this; omega
  have hw : wF d = 7 * kF d := rfl
  have hlF : lamF d = d * kF d := rfl
  have hkl : kF d ≤ lamF d := by rw [hlF]; exact Nat.le_mul_of_pos_left _ hd1
  have hwl : wF d ≤ 14 * lamP d := by omega
  have hq : (lamP d + wF d + 2 * wF d) / lamP d ≤ 43 := by
    apply Nat.div_le_of_le_mul; omega
  have hlam2 : lamP d ≤ 2 * d ^ 2 := by
    have : lamF d ≤ 2 * d ^ 2 := by rw [hlF]; nlinarith
    have := Nat.pow_log_le_self 2 (show lamF d ≠ 0 by omega)
    unfold lamP; omega
  have hY : lamP d + wF d + 2 * wF d + 1 ≤ 88 * d ^ 2 := by nlinarith
  have hts2 : (t - s) * (lamP d + wF d + 2 * wF d + 1) ≤ 44 * s := by
    have h1 : (t - s) * (lamP d + wF d + 2 * wF d + 1) ≤ (t - s) * (88 * d ^ 2) :=
      Nat.mul_le_mul_left _ hY
    have h2 : (t - s) * (88 * d ^ 2) = 11 * (8 * d ^ 2 * (t - s)) := by ring
    have h3 : t ≤ 2 * s := by
      have : 8 * (t - s) ≤ 8 * d ^ 2 * (t - s) :=
        Nat.mul_le_mul_right _ (by nlinarith)
      omega
    omega
  generalize ((LJ s t (lamP d) (wF d)).toFinset.filter
      (fun j => x ≤ j ∧ j ≤ x + (lamP d + wF d))).card = z at h ⊢
  generalize (lamP d + wF d + 2 * wF d) / lamP d = A at h hq
  have h4 : s * A + s * 3 ≤ s * 46 := by
    have := Nat.mul_le_mul_left s hq; omega
  have h5 : s * z ≤ 2 * wF d * (91 * s) := by
    refine h.trans (Nat.mul_le_mul_left _ ?_)
    rw [Nat.mul_add]; omega
  have h6 : s * z ≤ s * (182 * wF d) := by
    calc s * z ≤ 2 * wF d * (91 * s) := h5
      _ = s * (182 * wF d) := by ring
  exact Nat.le_of_mul_le_mul_left h6 hs

end J6Seg.Side
end

