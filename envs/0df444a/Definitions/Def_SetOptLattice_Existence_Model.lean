-- title:
--   §2–§4, pp. 3–24 — inf-extension, Ψ-hull, P(Z,Ψ), lattice infimum, (ε,Ψ)-infimizers, minimizers and solutions, Hausdorff convergence
-- statement:
--   This file sets up the framework of Crespi, Hamel, Rocca and Schrage for set optimization with values in a complete lattice of sets generated by a family of scalar functions.
--
--   Let $(Z,\preceq)$ be a preordered set and let $\overline{\mathbb R}=\mathbb R\cup\{\pm\infty\}$. Let $\Psi$ be a family of functions $\psi\colon Z\to\overline{\mathbb R}$ (monotone with respect to $\preceq$ in every theorem that uses them). The following objects are defined.
--
--   1. **Inf-extension (2.1).** For $D\subseteq Z$,
--   $$\psi^\triangle(D)=\inf_{z\in D}\psi(z),\qquad \psi^\triangle(\emptyset)=+\infty .$$
--   2. **Set relation.** $D_1\preceq_\Psi D_2$ if and only if $\psi^\triangle(D_1)\le\psi^\triangle(D_2)$ for every $\psi\in\Psi$.
--   3. **Ψ-hull.** $\operatorname{cl}_\Psi D=\bigcap_{\psi\in\Psi}\{z\in Z\mid \psi^\triangle(D)\le\psi(z)\}$, and $D$ is **Ψ-closed**, $D\in\mathcal P(Z,\Psi)$, when $D=\operatorname{cl}_\Psi D$ (2.5).
--   4. **Lattice infimum.** For a family $\mathcal A$ of subsets of $Z$, $\operatorname{cl}_\Psi\bigcup_{A\in\mathcal A}A$; for $f\colon X\to\mathcal P(Z,\Psi)$ and $M\subseteq X$, $\inf f[M]=\operatorname{cl}_\Psi\bigcup_{x\in M}f(x)$. Proposition 2.3 shows that this is the infimum of $\{f(x)\mid x\in M\}$ in the complete lattice $(\mathcal P(Z,\Psi),\supseteq)$.
--   5. **Tolerance bound.** For $a\in\overline{\mathbb R}$ and $\varepsilon\ge 0$, the right-hand side of Definitions 3.1 and 3.2:
--   $$b(a,\varepsilon)=\begin{cases}a+\varepsilon, & a\neq-\infty,\\ -1/\varepsilon, & a=-\infty,\end{cases}\qquad -1/0=-\infty .$$
--   6. **$(\varepsilon,\Psi)$-infimizer (Definition 3.1).** A non-empty $M\subseteq X$ with $\psi^\triangle(\inf f[M])\le b(\psi^\triangle(\inf f[X]),\varepsilon)$ for all $\psi\in\Psi$.
--   7. **Minimizers (Definition 3.2).** $\operatorname{Min}(f,\varepsilon,\Psi)$ is the set of $x\in X$ for which some $\psi\in\Psi$ satisfies $\psi^\triangle(f(x))\le b(\psi^\triangle(\inf f[X]),\varepsilon)$; $\operatorname{Min}(f,\varepsilon+,\Psi)$ is the set of $x$ such that for every $\delta>0$ some $\psi\in\Psi$ satisfies $\psi^\triangle(f(x))\le b(\psi^\triangle(\inf f[X]),\varepsilon+\delta)$.
--   8. **Solutions (Definition 3.7).** $M$ is an $(\varepsilon,\Psi)$-solution (an $(\varepsilon+,\Psi)$-solution) of (P) if it is an $(\varepsilon,\Psi)$-infimizer contained in $\operatorname{Min}(f,\varepsilon,\Psi)$ (in $\operatorname{Min}(f,\varepsilon+,\Psi)$).
--   9. **Sublevel sets.** $L_\varphi(r)=\{x\in X\mid\varphi(x)\le r\}$ for $\varphi\colon X\to\overline{\mathbb R}$ and $r\in\mathbb R$.
--   10. **Hausdorff convergence.** For sets $A_\varepsilon$, $A_0$ in a topological group $X$: for every neighbourhood $U$ of $0$ there is $\delta>0$ with $A_\varepsilon\subseteq A_0+U$ (upper) and $A_0\subseteq A_\varepsilon+U$ (lower) for all $\varepsilon\in(0,\delta)$.
--
--   These are the objects of problem (P), minimize $f(x)$ over $x\in X$, whose existence theory the mission formalizes.
--
--   **Formalization Note** Extended reals are Lean's `EReal`; the empty infimum is $\top=+\infty$. A $\mathcal P(Z,\Psi)$-valued map is a map $f\colon X\to\mathcal P(Z)$ with the hypothesis that every $f(x)$ is Ψ-closed, so the lattice structure of Proposition 2.3 is a theorem, not part of the definitions. The case $-1/0=-\infty$ is a separate branch because Lean's real division gives $-1/0=0$. "Hausdorff converges" is not defined in the paper; the definition above is the one the proof of Theorem 4.3 (p. 24) uses, with $\varepsilon\downarrow 0$ through positive reals.
-- source:
--   Crespi, Hamel, Rocca, Schrage, arXiv:1812.03300v1, pp. 3–4, (2.1), (2.5), Proposition 2.3; p. 13 (problem (P)); pp. 14–16, Definitions 3.1, 3.2, 3.7; p. 23, Proposition 4.1 (sublevel sets); p. 24 (Hausdorff convergence, from the proof of Theorem 4.3)

import Mathlib

namespace SetOptLattice.Existence

open Set Filter Topology
open scoped Pointwise

/-- (2.1) The inf-extension `ψ△(D) = inf_{z ∈ D} ψ(z)` of `ψ : Z → ℝ ∪ {±∞}`.
The `EReal` infimum over `D = ∅` is `⊤ = +∞`, the paper's convention. -/
noncomputable def infExt {Z : Type*} (ψ : Z → EReal) (D : Set Z) : EReal := ⨅ z ∈ D, ψ z

/-- The set relation `D₁ ⪯_Ψ D₂ ⇔ ∀ ψ ∈ Ψ, ψ△(D₁) ≤ ψ△(D₂)` (p. 3). -/
def SetLE {Z : Type*} (Ψ : Set (Z → EReal)) (D₁ D₂ : Set Z) : Prop :=
  ∀ ψ ∈ Ψ, infExt ψ D₁ ≤ infExt ψ D₂

/-- The hull `cl_Ψ D = ⋂_{ψ ∈ Ψ} {z ∈ Z | ψ△(D) ≤ ψ(z)}` (p. 3). -/
def clPsi {Z : Type*} (Ψ : Set (Z → EReal)) (D : Set Z) : Set Z :=
  {z | ∀ ψ ∈ Ψ, infExt ψ D ≤ ψ z}

/-- `D ∈ P(Z, Ψ)`, i.e. `D = cl_Ψ D` (2.5). -/
def IsPsiClosed {Z : Type*} (Ψ : Set (Z → EReal)) (D : Set Z) : Prop := clPsi Ψ D = D

/-- `cl_Ψ ⋃_{A ∈ 𝒜} A`, the formula of Proposition 2.3 for the infimum of `𝒜 ⊆ P(Z, Ψ)`
with respect to `⊇` (Proposition 2.3 proves that it is the greatest lower bound). -/
def latInf {Z : Type*} (Ψ : Set (Z → EReal)) (𝒜 : Set (Set Z)) : Set Z := clPsi Ψ (⋃₀ 𝒜)

/-- `inf f[M]`, the infimum of `{f x | x ∈ M}` in `(P(Z, Ψ), ⊇)`. -/
def infImage {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (M : Set X) : Set Z :=
  latInf Ψ (f '' M)

/-- The right-hand side of Definitions 3.1 and 3.2: `a + ε` if `a ≠ -∞`, and `-1/ε` if
`a = -∞`, with the convention `-1/0 = -∞`. -/
noncomputable def epsBound (a : EReal) (ε : ℝ) : EReal :=
  if a = ⊥ then (if ε = 0 then ⊥ else ((-1 / ε : ℝ) : EReal)) else a + (ε : EReal)

/-- Definition 3.1: a non-empty `M ⊆ X` is an `(ε, Ψ)`-infimizer of `f`. -/
def IsInfimizer {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (ε : ℝ) (M : Set X) :
    Prop :=
  M.Nonempty ∧ ∀ ψ ∈ Ψ, infExt ψ (infImage Ψ f M) ≤ epsBound (infExt ψ (infImage Ψ f univ)) ε

/-- Definition 3.2: `Min (f, ε, Ψ)`, the set of `(ε, Ψ)`-minimizers of `f`. -/
def MinSet {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (ε : ℝ) : Set X :=
  {x | ∃ ψ ∈ Ψ, infExt ψ (f x) ≤ epsBound (infExt ψ (infImage Ψ f univ)) ε}

/-- Definition 3.2: `Min (f, ε+, Ψ)`, the set of `(ε+, Ψ)`-minimizers of `f`
(`∀ δ > 0, ∃ ψ ∈ Ψ, …`). -/
def MinPlusSet {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (ε : ℝ) : Set X :=
  {x | ∀ δ : ℝ, 0 < δ →
    ∃ ψ ∈ Ψ, infExt ψ (f x) ≤ epsBound (infExt ψ (infImage Ψ f univ)) (ε + δ)}

/-- Definition 3.7: `M` is an `(ε, Ψ)`-solution of (P). -/
def IsSolution {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (ε : ℝ) (M : Set X) :
    Prop :=
  IsInfimizer Ψ f ε M ∧ M ⊆ MinSet Ψ f ε

/-- Definition 3.7: `M` is an `(ε+, Ψ)`-solution of (P). -/
def IsPlusSolution {X Z : Type*} (Ψ : Set (Z → EReal)) (f : X → Set Z) (ε : ℝ) (M : Set X) :
    Prop :=
  IsInfimizer Ψ f ε M ∧ M ⊆ MinPlusSet Ψ f ε

/-- The sublevel set `L_φ(r) = {x ∈ X | φ(x) ≤ r}` for real `r` (Proposition 4.1). -/
def sublevel {X : Type*} (φ : X → EReal) (r : ℝ) : Set X := {x | φ x ≤ (r : EReal)}

/-- Hausdorff convergence of `A ε` to `A₀` as `ε ↓ 0`: for every neighbourhood `U` of `0`,
eventually `A ε ⊆ A₀ + U` (upper) and `A₀ ⊆ A ε + U` (lower), as used in the proof of
Theorem 4.3, p. 24. -/
def HausdorffConverges {X : Type*} [TopologicalSpace X] [AddZeroClass X]
    (A : ℝ → Set X) (A₀ : Set X) : Prop :=
  ∀ U ∈ 𝓝 (0 : X), ∀ᶠ ε in 𝓝[>] (0 : ℝ), A ε ⊆ A₀ + U ∧ A₀ ⊆ A ε + U

end SetOptLattice.Existence


