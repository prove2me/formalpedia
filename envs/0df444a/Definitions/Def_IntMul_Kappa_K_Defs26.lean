section
-- Source module: Solutions.KFY16PassAB
/-!
# KFY 16: the `A` pass and the `B₀` pass

* `progA X Kc = passP wA (axA X Kc)`, **`passA_all`**: the array becomes
  `tensorGo (mapsA p α s t) (ofFn t) zs` (the list pipeline of `KFY1Pad.passA`);
* `progB X Kc = passP wB (axB X Kc)`, **`passB_all`**: `tensorGo (mapsB p α s t) (ofFn t) ys`.

The arrays keep the invariant `length = ∏ t_i`, `DiscL p` (which gives `GB (p + 2)`), using an
`M : AxisMaps` (`disc_sapL`, `disc_b0Pad`).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFY

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.AX NLogN.Rsp

noncomputable def progA (X : Fin HS) (Kc : ℝ) : RM := passP wA (axA X Kc)
noncomputable def progB (X : Fin HS) (Kc : ℝ) : RM := passP NLogN.KFY.wB (NLogN.KFY.axB X Kc)

/-- `t_k`. -/
noncomputable def tN (n k : ℕ) : ℕ := 2 ^ (IntMul.OpenAI.Glue.ℓP n - 1 + bN n k)
/-- `m_k = ∏_{i ≠ k} t_i`. -/
noncomputable def mN (n k : ℕ) : ℕ := 2 ^ (IntMul.OpenAI.Glue.LP n - (IntMul.OpenAI.Glue.ℓP n - 1 + bN n k))

/-- The `A` line maps. -/
noncomputable def fsA (n : ℕ) (k : ℕ) : List KFB.GI → List KFB.GI :=
  sapL (IntMul.OpenAI.Glue.pP n) ((List.ofFn (KFM.sB n)).getD k 1) ((List.ofFn (KFM.tB n)).getD k 1) (IntMul.OpenAI.Glue.αP n)

/-- The `B₀` line maps. -/
noncomputable def fsB (n : ℕ) (k : ℕ) : List KFB.GI → List KFB.GI :=
  b0Pad (IntMul.OpenAI.Glue.pP n) ((List.ofFn (KFM.sB n)).getD k 1) ((List.ofFn (KFM.tB n)).getD k 1) (IntMul.OpenAI.Glue.αP n)

/-- The array invariant. -/
def ArrInv (n : ℕ) (X : List KFB.GI) : Prop :=
  X.length = (List.ofFn (KFM.tB n)).prod ∧ DiscL (IntMul.OpenAI.Glue.pP n) X

end NLogN.KFY

end

