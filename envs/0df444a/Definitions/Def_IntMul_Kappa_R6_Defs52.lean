-- Source module: R6Pk.R6BitNBNetD
/-!
# Round six, bit network: the edges (flag basis) and good primes

The frame basis `S`, `S⁻¹` and every edge come from `flagBasis` (labels `(xv T, yv T)`, idempotents
`Dm o c` for nested moves and `Pl b`). Out-of-range parameters give the trivial edge, so all edges
of the network lie in one finite set `E0`; `good_edges` / `good_mats` give a prime bound `q₀`
above which `EOK`, `EdgesOK` and `FormalOK` hold mod every prime power.
-/

set_option linter.unusedSectionVars false
set_option maxRecDepth 10000
set_option linter.constructorNameAsVariable false

namespace IntMul.Kappa.R6.Bit.NB

open Matrix R6Chk R6Chk.Bit R6Chk.Bit.Loc AModel AModelFac
open scoped Kronecker

/-! ## Choosing edges -/

def dfltE : Edge 529 := ⟨1, [], 1⟩

open Classical in
noncomputable def pickE (P : Edge 529 → Prop) : Edge 529 :=
  if h : ∃ e, P e then Classical.choose h else dfltE

def SideR (r : ℕ) (rs : List (ℕ × ℕ × ℕ)) : Prop :=
  ∃ rs', rs = sideRuns 23 529 r ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
    (runPairs (sideRuns 23 529 r)).length + rs'.length = r

def DataR (rs : List (ℕ × ℕ × ℕ)) : Prop :=
  ∃ rs', rs = dataRuns 23 529 ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧ rs'.length = 24

def AuxR (rs : List (ℕ × ℕ × ℕ)) : Prop := rs = auxRuns 19

def PE (q : Matrix (Fin 529) (Fin 529) ℚ) (R : List (ℕ × ℕ × ℕ) → Prop) (e : Edge 529) : Prop :=
  EdgeQ e q ∧ R e.runs

/-! ## The flag basis -/

noncomputable def Lab0 : Finset (V23 × V23) := (Finset.range 1771).image fun T => (xv T, yv T)

/-- Nested move index pairs (irreducible: products of big ranges make the elaborator unfold
`List.range`). -/
noncomputable def idxD : Finset (ℕ × ℕ) :=
  ((Finset.range 38286) ×ˢ (Finset.range 38286)).filter (fun p => nestOK p.1 p.2 = true)

def I3 : Finset (ℕ × ℕ × ℕ) := Finset.range 1771 ×ˢ (Finset.range 38286 ×ˢ Finset.range 38286)

def I2 : Finset (ℕ × ℕ) := Finset.range 1771 ×ˢ Finset.range 1771

attribute [irreducible] idxD I3 I2

noncomputable def Pis0 : Finset M23 := idxD.image (fun p => Dm p.1 p.2) ∪ (Finset.range 1771).image Pl

attribute [irreducible] Pis0

/-- The flag-basis property (the statement of `flagBasis` for `Lab0`, `Pis0`). -/
abbrev FB0 (S : Matrix (Fin ((19 + 4) * (19 + 4))) (Pr (19 + 4)) ℚ)
    (Sinv : Matrix (Pr (19 + 4)) (Fin ((19 + 4) * (19 + 4))) ℚ) : Prop :=
  S * Sinv = 1 ∧ Sinv * S = 1 ∧
      (∀ p ∈ Lab0, AuxE (h := 19) (S * ((1 : Matrix (Fin (19 + 4)) (Fin (19 + 4)) ℚ) ⊗ₖ
          (1 - vecMulVec p.1 p.2)) * Sinv) ∧
        AuxE (h := 19) (S * ((1 - vecMulVec p.1 p.2) ⊗ₖ (1 : Matrix (Fin (19 + 4)) (Fin (19 + 4)) ℚ)) *
          Sinv)) ∧
      (∀ p ∈ Lab0, ∀ A ∈ Pis0, SideE (h := 19) (S * (A ⊗ₖ vecMulVec p.1 p.2) * Sinv) A.rank ∧
        SideE (h := 19) (S * (vecMulVec p.1 p.2 ⊗ₖ A) * Sinv) A.rank) ∧
      (∀ p₁ ∈ Lab0, ∀ p₂ ∈ Lab0,
        DataE (h := 19) (S * ((1 - vecMulVec p₁.1 p₁.2) ⊗ₖ (1 - vecMulVec p₂.1 p₂.2)) * Sinv))

/-- The flag basis (chosen by `Classical.epsilon`, so the definition carries no proof). -/
noncomputable def S0 : Matrix (Fin 529) (Pr 23) ℚ := Classical.epsilon (fun S => ∃ Sinv, FB0 S Sinv)
noncomputable def Si0 : Matrix (Pr 23) (Fin 529) ℚ := Classical.epsilon (fun Sinv => FB0 S0 Sinv)

/-! ## The network's edges -/

noncomputable def ch0 : Ch where
  S := S0
  Si := Si0
  e1 b o c := if b < 1771 ∧ o < 38286 ∧ c < 38286 then
    pickE (PE (K S0 Si0 (Dm o c) (Pl b)) (SideR (rkC o c))) else dfltE
  e2 a o c := if a < 1771 ∧ o < 38286 ∧ c < 38286 then
    pickE (PE (K S0 Si0 (Pl a) (Dm o c)) (SideR (rkC o c))) else dfltE
  ex b := if b < 1771 then pickE (PE (K S0 Si0 1 (1 - Pl b)) AuxR) else dfltE
  en a t := if a < 1771 ∧ t < 1771 then pickE (PE (K S0 Si0 (1 - Pl a) (1 - Pl t)) DataR) else dfltE
  ei a := if a < 1771 then pickE (PE (K S0 Si0 (1 - Pl a) 1) AuxR) else dfltE
  ec a s := if a < 1771 ∧ s < 1771 then pickE (PE (K S0 Si0 (Pl a) (Pl s)) (SideR 1)) else dfltE

noncomputable instance instDecEqEdge : DecidableEq (Edge 529) := Classical.decEq _

noncomputable def E0 : Finset (Edge 529) :=
  (I3.image fun p => ch0.e1 p.1 p.2.1 p.2.2) ∪ (I3.image fun p => ch0.e2 p.1 p.2.1 p.2.2) ∪
    ((Finset.range 1771).image ch0.ex) ∪ (I2.image fun p => ch0.en p.1 p.2) ∪
    ((Finset.range 1771).image ch0.ei) ∪ (I2.image fun p => ch0.ec p.1 p.2) ∪ {dfltE}

attribute [irreducible] E0

/-! ## Every edge of the program is one of the chosen families -/

def Fam (ch : Ch) (e : Edge 529) : Prop :=
  (∃ b o c, e = ch.e1 b o c) ∨ (∃ a o c, e = ch.e2 a o c) ∨ (∃ b, e = ch.ex b) ∨
    (∃ a t, e = ch.en a t) ∨ (∃ a, e = ch.ei a) ∨ (∃ a s, e = ch.ec a s)

/-! ## Good primes -/

noncomputable def M0 : Finset M23 := (Finset.range 38286).image Pc ∪ (Finset.range 1771).image Pl

noncomputable def EM0 : Finset (QMat2 529) := E0.image Edge.E₁ ∪ E0.image Edge.E₂

end IntMul.Kappa.R6.Bit.NB

