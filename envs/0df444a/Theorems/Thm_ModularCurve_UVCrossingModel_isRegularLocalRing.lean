open ModularCurve ModularCurve.UVCrossingModel

theorem ModularCurve.UVCrossingModel.isRegularLocalRing {W : Type*} [CommRing W] [IsNoetherianRing W] [IsLocalRing W] [IsDomain W] {π : W} (hW : IsLocalRing.maximalIdeal W = Ideal.span {π}) (hπ0 : π ≠ 0) : IsRegularLocalRing (UVCrossingModel W π) := by sorry
