theorem _root_.solution {x : V} {e : ℤ} (hx : G.Cas x = ((e : ℤ) : K) • x) (cs : List ℤ) (he : e ∈ cs) :
    G.cprod cs x = 0 := by
  rw [cprod_eig_lemma G hx cs]
  have h0 : (cs.map (fun c => (((e - c : ℤ)) : K))).prod = 0 :=
    List.prod_eq_zero (List.mem_map.mpr ⟨e, he, by simp⟩)
  rw [h0, zero_smul]
end Formalism.CountingSumsFrames.TO.GlX
