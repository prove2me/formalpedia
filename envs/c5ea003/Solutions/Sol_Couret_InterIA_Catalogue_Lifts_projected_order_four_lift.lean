theorem p2m_local_projected_order_four_lift (m : ℕ) (hm : 0 < m) (r : ZMod (2*m))
    (ho : addOrderOf (projection m r)=4) : 4 • r=m := by
  have hz : projection m (4 • r)=0 := by
    rw [map_nsmul]
    have h := addOrderOf_nsmul_eq_zero (projection m r)
    simpa only [ho] using h
  rcases (projection_kernel m hm (4 • r)).mp hz with h|h
  · have hdouble : (r+r)+(r+r)=0 := by
      calc (r+r)+(r+r)=4 • r := by rw [show (4 : ℕ)=2+2 from rfl,add_nsmul,two_nsmul]
           _=0 := h
    have hp : 2 • projection m r=0 := by
      rcases Couret.InterIA.L4.doubling_kernel m hm (r+r) hdouble with he|he
      · have hp := congrArg (projection m) he
        simpa only [map_add,map_zero,two_nsmul] using hp
      · have hp := congrArg (projection m) he
        simpa only [map_add,projection_half,two_nsmul] using hp
    have hf : addOrderOf (projection m r) ∣ 2 := addOrderOf_dvd_iff_nsmul_eq_zero.mpr hp
    rw [ho] at hf
    norm_num at hf
  · exact h





