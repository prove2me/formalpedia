private theorem t0497 {μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ} (hμ : IsIdeleClassChar (𝓞 K) K μ)
    (hμu : ∀ z, ‖((μ z : ℂˣ) : ℂ)‖ = 1) (d : JLData K S epsS ω) (dF : FinWhittakerDatum K S Pi)
