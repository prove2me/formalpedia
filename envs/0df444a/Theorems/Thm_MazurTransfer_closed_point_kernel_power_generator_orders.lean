-- title:
--   Valuation orders of generators of powers of arbitrary closed-point kernel ideals
-- statement:
--   Let $X$ be an integral scheme separated over a field $K$, and let $P:\operatorname{Spec}L\hookrightarrow X$ be a closed point, with arbitrary residue field $L$. Suppose the $n$th power of its kernel ideal is generated by $g$ on an affine open $U$. For a closed point $y\in U$, let $v$ be the function-field place whose valuation ring is the image of the stalk at $y$. Then
--   \[
--   \operatorname{ord}_v(g)=
--   \begin{cases}
--   n,&y=P(\operatorname{Spec}L),\\
--   0,&y\ne P(\operatorname{Spec}L).
--   \end{cases}
--   \]
--   Here $g$ is mapped from the actual affine coordinate ring to the actual function field. This computes the divisor represented by a closed-point ideal and its powers, including at nonrational points, for the arithmetic Picard correspondence.
-- source:
--   Official Anthropic FLT at 6e837e75355538c7f80bab5b956861e86c4eacc2, Apache-2.0, https://github.com/anthropics/fermats-last-theorem/tree/6e837e75355538c7f80bab5b956861e86c4eacc2 . Separately checked arbitrary-residue-field adaptations by Vas and contributors, downstream MazurTheorem WIP at 54d43d8dda8a6fcf069cc02a815f850d762c5c0c, Apache-2.0, https://github.com/Vilin97/MazurTheorem/tree/54d43d8dda8a6fcf069cc02a815f850d762c5c0c . Original theorem statements are preserved.

import Mathlib
import Definitions.Def_AlgebraicCurve_DivisorClassGroup
import Definitions.Def_AlgebraicCurve_CurveModel
import Definitions.Def_AlgebraicCurve_RelCartier
open CategoryTheory AlgebraicGeometry AlgebraicCurve

theorem MazurTransfer.closed_point_kernel_power_generator_orders.{u}
    {K : Type u} [Field K] {X : Scheme.{u}} (x : X ⟶ Spec (CommRingCat.of K))
    [IsIntegral X] [IsSeparated x]
    {L : Type u} [Field L] (P : Spec (CommRingCat.of L) ⟶ X) [IsClosedImmersion P] (n : ℕ)
    (U : X.Opens) (hU : IsAffineOpen U) (g : Γ(X, U)) (hg : (P.ker ^ n).ideal ⟨U, hU⟩ = Ideal.span {g})
    (y : X) (hyU : y ∈ U) (hy : IsClosed ({y} : Set X))
    (v : letI := (AlgebraicCurve.baseToFunctionField x).toAlgebra
      AlgebraicCurve.Place K X.functionField)
    (hv : letI := (AlgebraicCurve.baseToFunctionField x).toAlgebra
      (algebraMap (X.presheaf.stalk y) X.functionField).range = v.toValuationSubring.toSubring) :
    letI := (AlgebraicCurve.baseToFunctionField x).toAlgebra
    haveI : Nonempty U := ⟨⟨y, hyU⟩⟩
    (P.base (IsLocalRing.closedPoint L) = y → v.ord (algebraMap Γ(X, U) X.functionField g) = n) ∧
      (P.base (IsLocalRing.closedPoint L) ≠ y → v.ord (algebraMap Γ(X, U) X.functionField g) = 0) := by sorry
