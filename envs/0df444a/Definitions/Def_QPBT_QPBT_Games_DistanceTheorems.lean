/-! # State-dependent distance calculus

This module records the consistency and state-dependent distance estimates used
throughout the quantum Pauli basis test. The statements retain explicit
constants that the paper absorbs into asymptotic notation.

The operator-level inequalities they rest on live in
`MIPStarRE.QPBT.Games.DistanceTheorems.Calculus`.

## References

The source results run from blueprint `fact:agreement` through
`lem:close-strategies-have-close-values`, with paper origin
`references/qpbt-paper/06_nonlocal_games_and_mipstar.tex:295-461` and
`:531-540`. The observable conversion lemmas come from
`references/qpbt-paper/14_analysis_of_the_pauli_basis_test.tex:95-131`.
-/

@[expose] public section

open scoped BigOperators Matrix MatrixOrder ComplexOrder

namespace MIPStarRE.QPBT

open LIDT.MIPStarRE.LDT hiding Measurement
open LIDT.MIPStarRE.Quantum DistanceCalculus





/-- The product POVM whose effects are Kronecker products of the two factor effects. -/
noncomputable def tensorMeasurement
    {α β I J : Type*} [Fintype α] [Fintype β]
    [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]
    (A : _root_.LIDT.MIPStarRE.Quantum.Measurement α I) (B : _root_.LIDT.MIPStarRE.Quantum.Measurement β J) :
    _root_.LIDT.MIPStarRE.Quantum.Measurement (α × β) (I × J) :=
  _root_.LIDT.MIPStarRE.Quantum.Measurement.ofSumEqOne
    (fun ab => _root_.MIPStarRE.QPBT.heteroKron (A.effect ab.1) (B.effect ab.2))
    (fun ab => _root_.LIDT.MIPStarRE.Quantum.kronecker_nonneg (A.pos ab.1) (B.pos ab.2))
    (by
      change ∑ ab : α × β, _root_.LIDT.MIPStarRE.LDT.opTensor (A.effect ab.1) (B.effect ab.2) = 1
      rw [Fintype.sum_prod_type]
      calc
        (∑ a : α, ∑ b : β, _root_.LIDT.MIPStarRE.LDT.opTensor (A.effect a) (B.effect b)) =
            ∑ a : α, _root_.LIDT.MIPStarRE.LDT.leftTensor (A.effect a) *
              (∑ b : β, _root_.LIDT.MIPStarRE.LDT.rightTensor (B.effect b)) := by
          apply Finset.sum_congr rfl
          intro a _
          rw [Matrix.mul_sum]
          apply Finset.sum_congr rfl
          intro b _
          exact (_root_.LIDT.MIPStarRE.LDT.leftTensor_mul_rightTensor_eq_opTensor _ _).symm
        _ = 1 := by
          rw [_root_.LIDT.MIPStarRE.LDT.rightTensor_finset_sum, B.sum_eq_one, _root_.LIDT.MIPStarRE.LDT.rightTensor_one]
          simp_rw [Matrix.mul_one]
          rw [_root_.LIDT.MIPStarRE.LDT.leftTensor_finset_sum, A.sum_eq_one, _root_.LIDT.MIPStarRE.LDT.leftTensor_one])





























