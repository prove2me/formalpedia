-- Source module: Solutions.KIL4Shift
/-!
# KIL4: the uniform Lemma 10 shift body

`shFracU k d nst neg` depends only on the fixed fraction `k / d`, the sign and the number `nst`
of offset-table stages.  It reads every size parameter from the parameter stacks:

* `22` `Q`, `23` `-Q`, `24` `vol A`, `25` `vol C`, `26` `vol A·(Q·vol C)`, `27` `Q·vol C`;
* the stage stacks `34 … 37` (radix, control, suffix volume, radix·suffix volume of every table
  stage, last stage on top), consumed by the table generator `genPU`.

`shFracU_spec`: for any stage list `ac` whose table is the table of `A.zip (csOf Λ c A)`, the body
computes `shiftArr Λ i (fracU Q k d neg) c 0 xs`, exactly as KIL3's `shFrac`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KIL

open IntMul RS AModel AModelL12

/-- The uniform `shP`: table from the stage stacks, then `rotP` with parameters from registers. -/
def shPU (nst : ℕ) : RS :=
  .seq (genPU nst) (.seq (.push 1 (.reg sPA)) (.seq (.push 2 (.reg sQQ)) (.seq (.push 4 (.reg sPC))
    (.seq rotP (.seq (.pop 1) (.seq (.pop 2) (.pop 4)))))))

/-- The uniform `shN`. -/
def shNU (nst : ℕ) : RS :=
  .seq (genPU nst) (.seq (.push 1 (.reg sPA)) (.seq (.push 2 (.reg sQQ)) (.seq (.push 4 (.reg sPC))
    (.seq NLogN.KIL.negP (.seq (.pop 1) (.seq (.pop 2) (.pop 4)))))))

/-- Cost bound of `shPU`/`shNU`. -/
def cShiftUU (nst V Bb : ℕ) : ℕ := 10 ^ 9 * (nst + 1) * (V + 1) * (Bb + 2) + 2 * 10 ^ 8 * (Bb + 2) ^ 2

/-- The stage stacks hold the stage list `ac`. -/
structure StgOK (t : IState HS) (Q : ℕ) (ac : List (ℕ × ℕ)) (LA LC LM LAM : List Item) : Prop where
  hA : t.G sSA = ints (ac.reverse.map fun p => (p.1 : ℤ)) ++ LA
  hC : t.G sSC = ints (ac.reverse.map fun p => (p.2 : ℤ)) ++ LC
  hM : t.G sSM = ints (stgM ac.reverse []) ++ LM
  hAM : t.G sSAM = ints (stgAM ac.reverse []) ++ LAM

section Body

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- The post state of the uniform table shifts: stack `0` replaced, stage stacks consumed. -/
def postSt (t : IState HS) (ys : List ℤ) (R LA LC LM LAM : List Item) : IState HS :=
  ((((t.upd 0 (ints ys ++ R)).upd sSA LA).upd sSC LC).upd sSM LM).upd sSAM LAM

/-- **The uniform shift body** `y ↦ ±k·d⁻¹·y` controlled shift. -/
def shFracU (k d nst : ℕ) (neg : Bool) : RS :=
  .seq (.seq (fdivPU d) (fmulPU k)) (if neg then shNU nst else shPU nst)

def cShiftFU (k d nst V Bb : ℕ) : ℕ :=
  ((k + 1) ^ 2 + (d + 1) ^ 2) * 10 ^ 9 * (V + 1) * (Bb + 2) ^ 2 + cShiftUU nst V Bb

end Body

end NLogN.KIL

end

