section
-- Source module: Solutions.KFWImpl
/-!
# KFW: implementations by a single (uniform) program, parameters in the background

`SImplQ I iprog Q lo hi r st n T U e dw cost`: as `KFN.SImplI`, but

* the code `U` is **one** `IStmt` (not a family indexed by the width);
* the background `s` satisfies `Q s` (it holds the run-time parameters in registers);
* every managed stack other than the data stack `0` is empty (`Clean0 f`);
* the input width `w` lies in a window: `lo ≤ w` and `w + dw ≤ hi`.

`RImplQ` likewise.  Composition lemmas: `SImplQ.comp`, `RImplQ.comp`, `rImplQ_list`,
`sImplQ_of_rImplQ_roleDiag`; leaves from register programs: `sImplQ_leaf`, `rImplQ_leaf`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex P8Lift Butterfly

theorem Clean0.upd0 {f : Fin HS → List ℤ} (h : Clean0 f) (v : List ℤ) :
    Clean0 (Function.update f 0 v) := by
  intro j hj; rw [Function.update_of_ne hj]; exact h j hj

theorem Clean0.clN {f : Fin HS → List ℤ} (h : Clean0 f) : ClN f := by
  refine ⟨⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
    ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩,
    ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩ <;> exact h _ (by decide)

theorem agree_encK {σ : Fin HS → Option ℤ} {s : IState HS} (hs : Agree σ s)
    {f : Fin HS → List ℤ} (hf : ∀ j, (σ j).isSome → f j = []) : Agree σ (encK s f) := by
  intro i v hv
  obtain ⟨L, hL⟩ := hs i v hv
  refine ⟨L, ?_⟩
  rw [encK_G, hf i (by simp [hv]), hL]; rfl

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

end NLogN.KFW

end

