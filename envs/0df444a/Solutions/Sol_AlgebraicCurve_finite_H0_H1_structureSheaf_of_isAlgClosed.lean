  have hne1 : 𝒱.U1 ≠ ⊤ := ne_top_of_isAffineOpen' hNA 𝒱.isAffineOpen_U1
  obtain ⟨-, ⟨v₀, -⟩, -⟩ :=
    placesOf_union_eq_univ_of_sup_eq_top c 𝒱.U0 𝒱.U1 𝒱.sup_eq_top hne0 hne1

  have hC : ConstantsAreBase K C.functionField :=
