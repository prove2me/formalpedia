theorem levCore {ℓ a s : ℕ} (hy : y ^ (2 ^ ℓ) = -1) (ha : a ≤ ℓ + 1) (hs : s < a) (x c : ℕ) :
    yp y (twE ℓ (a - 1 - s) x) *
