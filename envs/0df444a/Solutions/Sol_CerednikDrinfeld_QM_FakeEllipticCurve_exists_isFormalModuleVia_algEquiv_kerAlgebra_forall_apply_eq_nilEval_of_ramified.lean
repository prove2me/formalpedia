theorem solution
    {q q' : ℕ} [Fact q.Prime] [Fact q'.Prime] (hqq' : q' ≠ q)
    {a b : ℚ} (hB : IsIndefiniteRamifiedExactlyAt a b q q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ)
    {N : ℕ} {p : ℕ} [Fact p.Prime]
    (k : Type) [Field k] [CharP k p]
    (E : FakeEllipticCurve Λ N k)

    (H : Type) [CommRing H] [HopfAlgebra k H]
    (e : ∀ (T : Type) [CommRing T] [Algebra k T],
      WithConv (H →ₐ[k] T) ≃ E.L.torsionSubset (Spec.map (CommRingCat.ofHom (algebraMap k T))) p)
    (he_nat : ∀ (T T' : Type) [CommRing T] [Algebra k T] [CommRing T'] [Algebra k T']
        (g' : T →ₐ[k] T') (φ : WithConv (H →ₐ[k] T)),
      ((e T' (.toConv (g'.comp φ.ofConv))).val : SchemeHomOver _ E.f).1 =
        Spec.map (CommRingCat.ofHom g'.toRingHom) ≫ (e T φ).val.1)
    (hp : p = q ∨ p = q') :
    ∃ (coord : ↥Λ → Zp2 p × Zp2 p) (_ : IsOrderCoord Λ p coord) (X : FormalODModule p k)
      (θ : RelativeGroupLaw.FormalCoordinates E.f 2) (_ : E.IsFormalModuleVia coord X θ) (ν : ℕ)
      (Φ : FormalODModule.KerAlgebra (X.F.nthSeries p) ≃ₐ[k] H),

      (∀ (T : Type) [CommRing T] [Algebra k T] (χ : H →ₐ[k] T),
        (∃ J : Ideal T, J ^ (ν + 1) = ⊥ ∧
          ∀ i, χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))) ∈ J) ∧
        (∀ G : MvPowerSeries (Fin 2) k,
          χ (Φ (Ideal.Quotient.mk _ G)) =
            MvFormalGroup.nilEval ν G (fun i => χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))))) ∧
        ((e T (.toConv χ)).val : SchemeHomOver _ E.f) =
          θ T (fun i => χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))))) ∧

      (∀ (T : Type) [CommRing T] [Algebra k T] (J : Ideal T) (n : ℕ), J ^ (n + 1) = ⊥ →
        ∀ s : Fin 2 → T, (∀ i, s i ∈ J) → (∀ i, MvFormalGroup.nilEval n (X.F.nthSeries p i) s = 0) →
          ∃ χ : H →ₐ[k] T, ∀ i, χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))) = s i) := by
  classical
  have hp0 : 0 < p := (Fact.out : p.Prime).pos

  obtain ⟨coord, hcoord⟩ : ∃ coord : ↥Λ → Zp2 p × Zp2 p, IsOrderCoord Λ p coord := by
    rcases hp with hpq | hpq
    · subst hpq
      exact CerednikDrinfeld.QM.exists_isOrderCoord_of_isMaximalOrder hB Λ hΛ
    · subst hpq
      exact CerednikDrinfeld.QM.exists_isOrderCoord_of_isMaximalOrder
        (R2PinKit.isIndefiniteRamifiedExactlyAt_symm hB) Λ hΛ
  have h1 : (1 : ℍ[ℚ, a, b]) ∈ Λ := hΛ.1.one_mem
  have hq : IsNilpotent ((p : ℕ) : k) := ⟨1, by rw [pow_one]; exact CharP.cast_eq_zero k p⟩

  obtain ⟨X, θ, hE⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.exists_isFormalModuleOf_of_isLocalRing coord hcoord k hq E

  obtain ⟨hfin, -, -, -⟩ := CerednikDrinfeld.QM.FakeEllipticCurve.isFinite_flat_schemeKerStr_and_finrank_eq_pow_four E p hp0
  haveI := hfin
  haveI : IsAffine (E.L.schemeKer p) := isAffine_of_isAffineHom (E.L.schemeKerStr p)
  let R : Type := Γ(E.L.schemeKer p, ⊤)
  let φ₀ : k →+* R := (E.L.schemeKerStr p).appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of k)).inv.hom
  letI : Algebra k R := φ₀.toAlgebra
  let eR : Spec (CommRingCat.of R) ≅ E.L.schemeKer p := (E.L.schemeKer p).isoSpec.symm
  have heR : eR.hom ≫ E.L.schemeKerStr p = Spec.map (CommRingCat.ofHom (algebraMap k R)) := by
    show (E.L.schemeKer p).isoSpec.inv ≫ E.L.schemeKerStr p = Spec.map (CommRingCat.ofHom φ₀)
    rw [← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv, ← Spec.map_comp]
    congr 1

  obtain ⟨ι, hι⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_algEquiv_forall_coe_equiv_eq_specMap_comp_of_torsion_points_equiv
      k E.f E.L p H e he_nat R eR heR

  have hφ0 : ∀ i, MvPowerSeries.constantCoeff (X.F.nthSeries p i) = 0 := by
    rw [← X.act_natCast]; exact (X.isLawHom_act _).1
  have hinf : ∀ (B' : Type) [CommRing B'] [Algebra k B'] (P : SchemeHomOver (Scheme.specOver (𝒪 := k) B') E.f),
      E.L.nsmul (Scheme.specOver (𝒪 := k) B') p P = E.L.one (Scheme.specOver (𝒪 := k) B') →
      ∃ J : Ideal B', IsNilpotent J ∧ E.L.IsInfinitesimal J P := by
    intro B' _ _ P hP
    refine CerednikDrinfeld.QM.FakeEllipticCurve.exists_isNilpotent_isInfinitesimal_of_nsmulPt_pow_eq_one_of_one_mem
      coord hcoord h1 k hq E X θ hE B' 1 P ?_
    rw [pow_one, R2PinKit.nsmulPt_eq_nsmul]
    exact hP
  have hφ : ∀ (B' : Type) [CommRing B'] [Algebra k B'] (J : Ideal B') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B', (∀ i, s i ∈ J) →
        θ B' (fun i => MvFormalGroup.nilEval n (X.F.nthSeries p i) s) =
          E.L.nsmul (Scheme.specOver (𝒪 := k) B') p (θ B' s) := by
    intro B' _ _ J n hJ s hs
    have hfun : (fun i => MvFormalGroup.nilEval n (X.F.nthSeries p i) s) =
        ((fun t : Fin 2 → B' => X.F.nilMul n t s)^[p] 0) := by
      funext i
      exact MvFormalGroup.nilEval_nthSeries_eq_iterate_nilMul X.F J n hJ s hs p i
    rw [hfun]
    obtain ⟨-, -, -, hhom⟩ := hE.1.2 B' J n hJ
    have hmem : ∀ m : ℕ, ∀ i, ((fun t : Fin 2 → B' => X.F.nilMul n t s)^[m] 0) i ∈ J := by
      intro m
      induction m with
      | zero => intro i; exact J.zero_mem
      | succ m ih =>
        rw [Function.iterate_succ_apply']
        exact R2PinKit.nilMul_mem X.F J n _ s ih hs
    have key : ∀ m : ℕ, θ B' ((fun t : Fin 2 → B' => X.F.nilMul n t s)^[m] 0) =
        E.L.nsmul (Scheme.specOver (𝒪 := k) B') m (θ B' s) := by
      intro m
      induction m with
      | zero => exact R2PinKit.theta_zero E.L X.F θ hE.1 B'
      | succ m ih =>
        rw [Function.iterate_succ_apply', hhom _ _ (hmem m) hs, ih]
        rfl
    exact key p

  obtain ⟨J, ν, s₀, hJ, hν, hs₀, hθs₀, ⟨Eq, hEq⟩⟩ :=
    GoodReductionJacobian.RelativeGroupLaw.exists_algEquiv_kerAlgebra_apply_mk_eq_nilEval_of_isFormalCoordinates_of_forall_isInfinitesimal
      E.L X.F θ hE.1 (X.F.nthSeries p) hφ0 p hφ hinf R eR heR
  let Φ : FormalODModule.KerAlgebra (X.F.nthSeries p) ≃ₐ[k] H := Eq.trans ι.symm

  have hcoordχ : ∀ (T : Type) [CommRing T] [Algebra k T] (χ : H →ₐ[k] T) (i : Fin 2),
      χ (Φ (Ideal.Quotient.mk _ (MvPowerSeries.X i))) = (χ.comp (ι.symm : R →ₐ[k] H)) (s₀ i) := by
    intro T _ _ χ i
    show χ (ι.symm (Eq (Ideal.Quotient.mk _ (MvPowerSeries.X i)))) = χ (ι.symm (s₀ i))
