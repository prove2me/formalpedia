section
-- Source module: Solutions.J6SegILSrc16
/-!
# B-line IL, source-table producers, part 16: pass 3 and pass 5 bodies

Both start with `ljP 22 23 24 26` (`LJ` on `30`, `|LJ|` on `31`, block starts / lengths on `32` /
`33`) and `cgP 31 46` (`G = 2^⌈log₂ |LJ|⌉` on `46`), and end with `cleanLJ` (dropping the `ljP`
output).

* `body3`: `gthP 46` (gather table over `G` slabs), `ctlPh 23 46` (`n = t`, `n' = G`), `cntP 3 4 46`;
* `body5`: `scP 23` (scatter table over `t` slabs), `ctlPh 46 23` (`n = G`, `n' = t`), `cntP 3 4 23`.

Input registers (as left by `parP`): `3 = pre`, `4 = post`, `22 = s`, `23 = t`, `24 = λ`, `26 = w`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.Src

open IntMul NLogN NLogN.KIL Function RS J6Seg
open J6Seg.PreT hiding rg RF RF_in RF_out upd_RF_in upd_RF_out cE InRg
open J6Seg.Slab (srcTab flatC ctlB ctlCost)

/-- Drop the `ljP` output. -/
def cleanLJ : RS := .seq (dropP 31 30 1) (.seq (.pop 31) (.seq (dropP 22 32 1) (dropP 22 33 1)))

/-- Its cost. -/
def cleanC (A m s : ℕ) : ℕ :=
  (m + 1) * ((1 + 1) * uC A DD + uC A DD) + (uC A DD + ((s + 1) * ((1 + 1) * uC A DD + uC A DD) +
    (s + 1) * ((1 + 1) * uC A DD + uC A DD)))

/-! ## Pass 3 -/

/-- Before the control phase. -/
def a3 : RS := .seq (ljP 22 23 24 26) (.seq (cgP 31 46) (gthP 46))

/-- After the control phase. -/
def b3 : RS := .seq (cntP 3 4 46) (.seq (.pop 46) cleanLJ)

/-- **The pass-3 body.** -/
def body3 {Pp : ℕ} : IStmt HS Pp := .seq a3.code (.seq (ctlPh 23 46) b3.code)

/-- The `cgP` cost. -/
def cgC (A m : ℕ) : ℕ := 2 * uC A DD + (m + 1) * ((2 * (10 * uC A DD) + 200 * (A * DD + 1 + 1)) + uC A DD)

/-- The pass-3 cost. -/
def cost3 (A s t m G : ℕ) : ℕ :=
  ljCost s A + (cgC A m + (m + G + 2) * (40 * uC A DD)) + (ctlPhC A t G +
    (30 * uC A DD + (uC A DD + cleanC A m s)))

end J6Seg.Src

end

