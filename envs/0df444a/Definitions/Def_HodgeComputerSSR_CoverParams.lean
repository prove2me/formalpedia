-- Congruence of modular Pair1009 operations wrt P34_m_list!
def PairCongrP (x y : PairAlg (ZMod 1009)[X]) : Prop :=
  CongrMod (toPoly P34_m_list) x.c0 y.c0 ∧ CongrMod (toPoly P34_m_list) x.c1 y.c1

lemma PairCongrP.refl (x : PairAlg (ZMod 1009)[X]) : PairCongrP x x :=
  ⟨CongrMod.refl _ _, CongrMod.refl _ _⟩
lemma PairCongrP.trans {x y z : PairAlg (ZMod 1009)[X]} (h1 : PairCongrP x y) (h2 : PairCongrP y z) :
    PairCongrP x z := ⟨h1.1.trans h2.1, h1.2.trans h2.2⟩
lemma mP34_congr (a : Poly1009) : CongrMod (toPoly P34_m_list) (toPoly a) (toPoly (mP34 a)) := by
  rw [mP34]; exact pmodRec_congr _ _ _ _

lemma PairCongrP.qmod (x : Pair1009) : PairCongrP (pairToAlg x) (pairToAlg (qmodP x)) :=
  ⟨mP34_congr x.1, mP34_congr x.2⟩
lemma PairCongrP.add {x1 x2 : PairAlg (ZMod 1009)[X]} {y1 y2 : Pair1009}
    (h1 : PairCongrP x1 (pairToAlg y1)) (h2 : PairCongrP x2 (pairToAlg y2)) :
    PairCongrP (PairAlg.add x1 x2) (pairToAlg (qaddP y1 y2)) := by
  have hraw : PairCongrP (PairAlg.add x1 x2) (PairAlg.add (pairToAlg y1) (pairToAlg y2)) :=
    ⟨h1.1.add h2.1, h1.2.add h2.2⟩
  rw [qaddP]
  exact PairCongrP.trans hraw (by rw [← pairToAlg_qadd]; exact PairCongrP.qmod _)
lemma PairCongrP.sub {x1 x2 : PairAlg (ZMod 1009)[X]} {y1 y2 : Pair1009}
    (h1 : PairCongrP x1 (pairToAlg y1)) (h2 : PairCongrP x2 (pairToAlg y2)) :
    PairCongrP (PairAlg.sub x1 x2) (pairToAlg (qsubP y1 y2)) := by
  have hraw : PairCongrP (PairAlg.sub x1 x2) (PairAlg.sub (pairToAlg y1) (pairToAlg y2)) :=
    ⟨h1.1.sub h2.1, h1.2.sub h2.2⟩
  rw [qsubP]
  exact PairCongrP.trans hraw (by rw [← pairToAlg_qsub]; exact PairCongrP.qmod _)
lemma PairCongrP.sc {s : (ZMod 1009)[X]} {t : Poly1009} {x : PairAlg (ZMod 1009)[X]} {y : Pair1009}
    (hs : s = toPoly t) (hx : PairCongrP x (pairToAlg y)) :
    PairCongrP (PairAlg.smul s x) (pairToAlg (qscP t y)) := by
  have hm : CongrMod (toPoly P34_m_list) s (toPoly (mP34 t)) := hs ▸ mP34_congr t
  have hraw : PairCongrP (PairAlg.smul s x) (PairAlg.smul (toPoly (mP34 t)) (pairToAlg y)) :=
    ⟨hm.mul hx.1, hm.mul hx.2⟩
  rw [qscP]
  exact PairCongrP.trans hraw (by rw [← pairToAlg_qsc]; exact PairCongrP.qmod _)
lemma PairCongrP.mul {x1 x2 : PairAlg (ZMod 1009)[X]} {y1 y2 : Pair1009}
    (h1 : PairCongrP x1 (pairToAlg y1)) (h2 : PairCongrP x2 (pairToAlg y2)) :
    PairCongrP (params1009.pmul x1 x2) (pairToAlg (qmulP y1 y2)) := by
  have hraw : PairCongrP (params1009.pmul x1 x2) (params1009.pmul (pairToAlg y1) (pairToAlg y2)) := by
    constructor
    · exact (h1.1.mul h2.1).sub ((h1.2.mul h2.2).mul (CongrMod.refl _ _))
    · exact ((h1.1.mul h2.2).add (h1.2.mul h2.1)).sub ((h1.2.mul h2.2).mul (CongrMod.refl _ _))
  exact PairCongrP.trans hraw (by rw [← pairToAlg_qmul]; exact PairCongrP.qmod _)
lemma PairCongrP.nm {x : PairAlg (ZMod 1009)[X]} {y : Pair1009}
    (h : PairCongrP x (pairToAlg y)) :
    CongrMod (toPoly P34_m_list) (params1009.pnm x) (toPoly (mP34 (qnm y))) := by
  have hraw : CongrMod (toPoly P34_m_list) (params1009.pnm x) (params1009.pnm (pairToAlg y)) := by
    simp only [CoverParams.pnm, PairAlg.nm, sq]
    exact ((h.1.mul h.1).sub ((h.1.mul h.2).mul (CongrMod.refl _ _))).add ((h.2.mul h.2).mul (CongrMod.refl _ _))
  rw [← toPoly_qnm] at hraw
  exact hraw.trans (mP34_congr (qnm y))

lemma dH_dS_hom_congrP {s q : PairAlg (ZMod 1009)[X]} {sy qy : Pair1009}
    (hs : PairCongrP s (pairToAlg sy)) (hq : PairCongrP q (pairToAlg qy)) :
    PairCongrP (params1009.dH_dS_hom s q) (pairToAlg (c_dH_dS_homP sy qy)) := by
  have hC (c : ZMod 1009) : C c = toPoly [c] := by simp [toPoly]
  have hN (n : ℕ) : (n : (ZMod 1009)[X]) = toPoly [(n : ZMod 1009)] := by simp [toPoly]
  have hX : (X : (ZMod 1009)[X]) = toPoly [0, 1] := by simp [toPoly]
  have hCX2 (c : ZMod 1009) : C c * X ^ 2 = toPoly [0, 0, c] := by simp [toPoly]; ring
  unfold CoverParams.dH_dS_hom c_dH_dS_homP
  have hs3q := PairCongrP.sub hs (PairCongrP.sc (hN 3) hq)
  have ht1 := PairCongrP.sc (hCX2 (-4 * params1009.inv81)) (PairCongrP.mul hs3q hs3q)
  have hs2 := PairCongrP.mul hs hs; have hsq := PairCongrP.mul hs hq; have hq2 := PairCongrP.mul hq hq
  have hmid := PairCongrP.add (PairCongrP.sub
    (PairCongrP.sc (hC (143 * params1009.inv81)) hs2)
    (PairCongrP.sc (hC (184 * params1009.inv27)) hsq))
    (PairCongrP.sc (hC (52 * params1009.inv9)) hq2)
  have ht2 := PairCongrP.sc hX hmid
  have hf1 := PairCongrP.sub (PairCongrP.sc (hN 5) hs) (PairCongrP.sc (hN 9) hq)
  have hf2 := PairCongrP.sub (PairCongrP.sc (hN 15) hs) (PairCongrP.sc (hN 9) hq)
  have ht3 := PairCongrP.sc (hC (-25 * params1009.inv243)) (PairCongrP.mul hf1 hf2)
  exact PairCongrP.add (PairCongrP.add ht1 ht2) ht3

lemma dH_dQ_hom_congrP {s q v0 : PairAlg (ZMod 1009)[X]} {sy qy vy : Pair1009}
    (hs : PairCongrP s (pairToAlg sy)) (hq : PairCongrP q (pairToAlg qy)) (hv : PairCongrP v0 (pairToAlg vy)) :
    PairCongrP (params1009.dH_dQ_hom s q v0) (pairToAlg (c_dH_dQ_homP sy qy vy)) := by
  have hC (c : ZMod 1009) : C c = toPoly [c] := by simp [toPoly]
  have hN (n : ℕ) : (n : (ZMod 1009)[X]) = toPoly [(n : ZMod 1009)] := by simp [toPoly]
  have hX : (X : (ZMod 1009)[X]) = toPoly [0, 1] := by simp [toPoly]
  have hCX2 (c : ZMod 1009) : C c * X ^ 2 = toPoly [0, 0, c] := by simp [toPoly]; ring
  unfold CoverParams.dH_dQ_hom c_dH_dQ_homP
  have hs3q := PairCongrP.sub hs (PairCongrP.sc (hN 3) hq)
  have ht1 := PairCongrP.sc (hCX2 (4 * params1009.inv27)) (PairCongrP.mul hs3q hs3q)
  have hs2 := PairCongrP.mul hs hs; have hsq := PairCongrP.mul hs hq; have hq2 := PairCongrP.mul hq hq
  have hqv := PairCongrP.mul hq hv; have hv2 := PairCongrP.mul hv hv
  have hmid := PairCongrP.add (PairCongrP.add (PairCongrP.sub (PairCongrP.add
    (PairCongrP.sc (hC (-92 * params1009.inv27)) hs2)
    (PairCongrP.sc (hC (104 * params1009.inv9)) hsq))
    (PairCongrP.sc (hC (22 * params1009.inv3)) hq2))
    (PairCongrP.sc (hC (10 * params1009.inv7)) hqv))
    (PairCongrP.sc (hC (10 * params1009.inv7)) hv2)
  have ht2 := PairCongrP.sc hX hmid
  have hf1 := PairCongrP.sub (PairCongrP.sc (hN 5) hs) (PairCongrP.sc (hN 9) hq)
  have ht3 := PairCongrP.sc (hC (50 * params1009.inv27)) (PairCongrP.mul hs hf1)
  exact PairCongrP.add (PairCongrP.add ht1 ht2) ht3

lemma nm_detM_W_congrP :
    CongrMod (toPoly P34_m_list) (params1009.pnm params1009.detM_W) (toPoly c_nm_detMP) := by
  have hC (c : ZMod 1009) : C c = toPoly [c] := by simp [toPoly]
  have hCX (c : ZMod 1009) : C c * X = toPoly [0, c] := by simp [toPoly]
  have h0 : PairCongrP (PairAlg.zero : PairAlg (ZMod 1009)[X]) (pairToAlg ([], [])) := by
    exact ⟨by simp [PairAlg.zero, pairToAlg, toPoly, CongrMod],
           by simp [PairAlg.zero, pairToAlg, toPoly, CongrMod]⟩
  have hA : PairCongrP params1009.A_sub (pairToAlg (qmodP (qsc (pneg c_cb_h) c_d0_z))) := by
    rw [CoverParams.A_sub, ← toPoly_c_cb_h, ← toPoly_pneg, ← pairToAlg_c_d0_z, ← pairToAlg_qsc]
    exact PairCongrP.qmod _
  have hB : PairCongrP params1009.B_sub (pairToAlg (qmodP (qsub (qsc c_ca_h c_d0_z) (qmul c_c0W c_d1_z)))) := by
    rw [CoverParams.B_sub, ← toPoly_c_ca_h, ← pairToAlg_c_d0_z, ← pairToAlg_c_c0W,
      ← pairToAlg_c_d1_z, ← pairToAlg_qsc, ← pairToAlg_qmul, ← pairToAlg_qsub]
    exact PairCongrP.qmod _
  have hCc : PairCongrP params1009.C_sub (pairToAlg (qmodP (qmul c_W (qsc c_cb_h c_d1_z)))) := by
    rw [CoverParams.C_sub, ← pairToAlg_c_W, ← toPoly_c_cb_h, ← pairToAlg_c_d1_z,
      ← pairToAlg_qsc, ← pairToAlg_qmul]
    exact PairCongrP.qmod _
  unfold CoverParams.detM_W c_nm_detMP c_detM_WP
  dsimp only
  have hxS := PairCongrP.sub (PairCongrP.sc (hC params1009.S) hCc) (PairCongrP.sc (hC params1009.T) hA)
  have hxQ := PairCongrP.sub (PairCongrP.sc (hC params1009.Q) hCc) (PairCongrP.sc (hC params1009.T) hB)
  have ha2 := dH_dS_hom_congrP hA hB
  have ha0 := dH_dS_hom_congrP hxS hxQ
  have ha1 := PairCongrP.sub (PairCongrP.sub (dH_dS_hom_congrP (PairCongrP.add hA hxS) (PairCongrP.add hB hxQ)) ha2) ha0
  have hb2 := dH_dQ_hom_congrP hA hB h0
  have hb0 := dH_dQ_hom_congrP hxS hxQ hCc
  have hb1 := PairCongrP.add (PairCongrP.sub (PairCongrP.sub (dH_dQ_hom_congrP (PairCongrP.add hA hxS) (PairCongrP.add hB hxQ) h0) hb2)
    (dH_dQ_hom_congrP hxS hxQ h0)) (PairCongrP.sc (hCX (10 * params1009.inv7)) (PairCongrP.mul hB hCc))
  have hd20 := PairCongrP.sub (PairCongrP.mul ha2 hb0) (PairCongrP.mul ha0 hb2)
  have hd21 := PairCongrP.sub (PairCongrP.mul ha2 hb1) (PairCongrP.mul ha1 hb2)
  have hd10 := PairCongrP.sub (PairCongrP.mul ha1 hb0) (PairCongrP.mul ha0 hb1)
  exact PairCongrP.nm (PairCongrP.sub (PairCongrP.mul hd20 hd20) (PairCongrP.mul hd21 hd10))

