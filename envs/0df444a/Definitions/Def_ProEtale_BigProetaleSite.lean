-- title:
--   $\ell$-adic coefficients and free sheaves on the big pro-étale site
-- statement:
--   Mathlib defines the $\ell$-adic cohomology of a scheme $X$ on the small pro-étale site of $X$. This file sets up the corresponding objects on the **big pro-étale site**, the category of all schemes with the pro-étale topology (`Scheme.proetaleTopology`).
--
--   1. `bigEllAdicSheaf ℓ`: the sheaf $U \mapsto \operatorname{Map}_{\mathrm{cont}}(U, \mathbb Z_\ell)$ of continuous $\mathbb Z_\ell$-valued functions on all schemes $U$. Its restriction to weakly étale $X$-schemes is the coefficient sheaf of `X.EllAdicCohomology ℓ`.
--   2. `proetaleFreeSheaf X`: the free abelian sheaf generated by a scheme $X$, i.e. the sheafification of $U \mapsto \mathbb Z[\operatorname{Hom}(U, X)]$. Morphisms from it to an abelian sheaf $F$ correspond to sections of $F$ over $X$, so the groups $\operatorname{Ext}^n$ from it to $F$ are the cohomology groups of $X$ with coefficients in $F$ computed on the big site.
--
--   The file also records that abelian sheaves on the big pro-étale site admit sheafification and form a Grothendieck abelian category.
--
--   **Formalization Note** This file is written for the mission; it is not extracted from the Lean project the other definition files come from. For schemes in `Scheme.{u}` the sheaves take values in `Ab.{u + 1}`, as for `EllAdicCohomology`.
-- source:
--   Written for this mission. The coefficient sheaf follows Mathlib's `AlgebraicGeometry.Scheme.ellAdicSheaf` (B. Bhatt, P. Scholze, The pro-étale topology for schemes, https://arxiv.org/abs/1309.1198 (v2, 17 Dec 2014), Definition 6.8.1 and Lemma 4.2.12). The big-site formulation of ℓ-adic cohomology is the one used in the original Alpöge–Claude formalization (mirrored at github.com/CocoSgt/riemann-hypothesis-lean, Lean v4.33.1, Mathlib 0df444a; published without a license).

import Mathlib

/-!
# `ℓ`-adic coefficients and free sheaves on the big pro-étale site

Mathlib defines the `ℓ`-adic cohomology of a scheme `X` on the small pro-étale site of `X`
(`AlgebraicGeometry.Scheme.EllAdicCohomology`). This file sets up the corresponding objects on
the big pro-étale site of all schemes, `AlgebraicGeometry.Scheme.proetaleTopology`: the sheaf
of continuous `ℤ_[ℓ]`-valued functions and the free abelian sheaf generated by a scheme. The
`Ext`-groups from the latter to the former are the `ℓ`-adic cohomology groups of `X` computed
on the big site.

Written for the Prove2me mission on the pro-étale topology; it is not part of the Lean
project the other definition files of the mission are extracted from.
-/

universe u

open CategoryTheory Limits

namespace AlgebraicGeometry.Scheme

instance hasSheafify_proetaleTopology_ab :
    HasSheafify proetaleTopology.{u} Ab.{u + 1} := by
  have : EssentiallySmall.{u + 1} Scheme.{u} := inferInstance
  infer_instance

instance isGrothendieckAbelian_sheaf_proetaleTopology_ab :
    IsGrothendieckAbelian.{u + 1} (Sheaf proetaleTopology.{u} Ab.{u + 1}) := by
  have : EssentiallySmall.{u + 1} Scheme.{u} := inferInstance
  exact Sheaf.isGrothendieckAbelian_of_essentiallySmall proetaleTopology.{u} Ab.{u + 1}

/-- The sheaf `U ↦ C(U, ℤ_[ℓ])` of continuous `ℤ_[ℓ]`-valued functions on the big pro-étale
site of all schemes, with values in `Ab.{u + 1}`. Its restriction to the small pro-étale site
of a scheme `X` is the coefficient sheaf of `X.EllAdicCohomology ℓ`. -/
noncomputable def bigEllAdicSheaf (ℓ : ℕ) [Fact ℓ.Prime] :
    Sheaf proetaleTopology.{u} Ab.{u + 1} :=
  (sheafCompose _ AddCommGrpCat.uliftFunctor.{u + 1}).obj
    ⟨continuousMapPresheafAb (ℤ_[ℓ]), .of_le proetaleTopology_le_fpqcTopology <|
      isSheaf_fpqcTopology_continuousMapPresheafAb _⟩

/-- The free abelian sheaf on the big pro-étale site generated by a scheme `X`: the
sheafification of `U ↦ ℤ[Hom(U, X)]`. Morphisms from it to an abelian sheaf `F` correspond
to sections of `F` over `X`. -/
noncomputable def proetaleFreeSheaf (X : Scheme.{u}) :
    Sheaf proetaleTopology.{u} Ab.{u + 1} :=
  (presheafToSheaf proetaleTopology.{u} Ab.{u + 1}).obj
    (uliftYoneda.{u + 1}.obj X ⋙ AddCommGrpCat.free)

end AlgebraicGeometry.Scheme


