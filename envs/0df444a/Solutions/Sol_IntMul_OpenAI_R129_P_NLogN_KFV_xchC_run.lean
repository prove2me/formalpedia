theorem merge2_blockSwap {sh : Shape} {i j r : ℕ} (hij : i + r ≤ j) (hj : j + r ≤ sh.length)
    (hsz : ∀ k < r, sh.getD (i + k) 0 = sh.getD (j + k) 0) {a : List ℕ}
