  have h2 : ContDiff ℝ ∞ (fun x : Pt 4 => Complex.cos ((x 2 : ℝ) : ℂ)) :=
    (Complex.contDiff_cos.restrict_scalars ℝ).comp (Complex.ofRealCLM.contDiff.comp (contDiff_apply ℝ ℝ 2))
  exact h1.add (contDiff_const.mul (contDiff_const.mul h2))

