  have hout : NLogN.KFY.sapOutQ p s t α Y = NLogN.KFY.stepL R (IntMul.HvdH.Ref.sapL p s t α) Xs := by
    unfold NLogN.KFY.sapOutQ NLogN.KFY.stepL
    rw [hRd, IntMul.OpenAI.R154.P.NLogN.KFY.rot_head hn k hk, IntMul.OpenAI.R154.P.NLogN.KFY.rot_tail_prod hn k hk]
    congr 1
    funext x
    exact NLogN.KFY.sapL_take p s t α (by omega) x
  rw [hout] at S
  have S' : NLogN.KFY.sapAxQ.run t5 = t5.upd 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFY.stepL R (IntMul.HvdH.Ref.sapL p s t α) Xs)) ++ R0) ∧
      NLogN.KFY.sapAxQ.ok M t5 ∧ NLogN.KFY.sapAxQ.cost M t5 ≤ NLogN.KFY.sapAxCostQ p s t α m mm Φ Bacc Q Bq := by
    refine ⟨by rw [S.1, NLogN.KFY.gints_eq], S.2.1, S.2.2.1⟩
  -- bounds of the pushed values
  have hbd5 : ∀ q ∈ NLogN.KFY.regsA, q.2.Bnd t4 B ∧ q.2.size ≤ 20 ∧ NLogN.zsz (q.2.eval t4) ≤ B := by
    have hWnr : NLogN.zsz (NLogN.KFY.nrE.eval t4) ≤ B := by rw [hnr]; exact hzs _ hWA
    have hnrB : NLogN.KFY.nrE.Bnd t4 B := by
      simp only [NLogN.KFY.nrE, NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4W]
      refine ⟨⟨hzs _ (by omega), hzs _ (by omega), ?_⟩, by rw [NLogN.zsz_one]; exact hB1, ?_⟩
      · rw [show (W : ℤ) + W = ((2 * W : ℕ) : ℤ) by push_cast; ring]; exact hzs _ (by omega)
      · rw [show (W : ℤ) + W + 1 = ((2 * W + 1 : ℕ) : ℤ) by push_cast; ring]; exact hzs _ hWA
    intro q hq
    simp only [NLogN.KFY.regsA, List.mem_cons, List.not_mem_nil, or_false] at hq
    rcases hq with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4P]; exact ⟨hzs _ hpAA, by decide, hzs _ hpAA⟩
    · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4S]; exact ⟨hzs _ hsA, by decide, hzs _ hsA⟩
    · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4T]; exact ⟨hzs _ htA, by decide, hzs _ htA⟩
    · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4W]; exact ⟨hzs _ (by omega), by decide, hzs _ (by omega)⟩
    · have hbt : IntMul.HvdH.betaT p α = ((2 ^ p / (2 * α) : ℕ) : ℤ) := rfl
      have hbA : 2 ^ p / (2 * α) ≤ A := le_trans (Nat.div_le_self _ _) (by omega)
      have hαA' : α ≤ A := by
        have : α ≤ α ^ 2 * IntMul.OpenAI.R154.rP n ^ 2 := by
          have h1r : 1 ≤ IntMul.OpenAI.R154.rP n ^ 2 := Nat.one_le_pow _ _ (by omega)
          have h2r : α ≤ α ^ 2 := by rw [pow_two]; exact Nat.le_mul_self α
          exact le_trans h2r (Nat.le_mul_of_pos_right _ h1r)
        omega
      refine ⟨?_, by decide, ?_⟩
      · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4P, NLogN.IState.top_eq t4A]
        refine ⟨⟨hzs _ hpAA, by simp; omega⟩, ⟨hzs _ hαA', hzs _ hαA', ?_⟩, ?_⟩
        · rw [show (α : ℤ) + α = ((2 * α : ℕ) : ℤ) by push_cast; ring]; exact hzs _ (by omega)
        · rw [hbeta, hbt]; exact hzs _ hbA
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4P, NLogN.IState.top_eq t4A]; rw [hbeta, hbt]; exact hzs _ hbA
    · have hαA' : α * α ≤ A := by
        have : α * α ≤ α ^ 2 * IntMul.OpenAI.R154.rP n ^ 2 := by
          have : 1 ≤ IntMul.OpenAI.R154.rP n ^ 2 := Nat.one_le_pow _ _ (by omega)
          rw [← pow_two]; exact Nat.le_mul_of_pos_right _ (by omega)
        omega
      have htt : t * t ≤ A := by
        have : t * t ≤ α ^ 2 * IntMul.OpenAI.R154.rP n ^ 2 := by
          have h1t : t * t ≤ IntMul.OpenAI.R154.rP n ^ 2 := by rw [pow_two]; exact Nat.mul_le_mul htr htr
          have h2t : 1 ≤ α ^ 2 := Nat.one_le_pow _ _ (by omega)
          calc t * t ≤ IntMul.OpenAI.R154.rP n ^ 2 := h1t
            _ = 1 * IntMul.OpenAI.R154.rP n ^ 2 := (Nat.one_mul _).symm
            _ ≤ α ^ 2 * IntMul.OpenAI.R154.rP n ^ 2 := Nat.mul_le_mul_right _ h2t
        omega
      have hat : α * α * (t * t) ≤ A := by
        have : α * α * (t * t) ≤ α ^ 2 * IntMul.OpenAI.R154.rP n ^ 2 := by
          rw [pow_two, pow_two]; exact Nat.mul_le_mul le_rfl (Nat.mul_le_mul htr htr)
        omega
      refine ⟨?_, by decide, ?_⟩
      · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4A, NLogN.IState.top_eq t4T]
        refine ⟨⟨hzs _ (by omega), hzs _ (by omega), by exact_mod_cast hzs _ hαA'⟩,
          ⟨hzs _ htA, hzs _ htA, by exact_mod_cast hzs _ htt⟩, by exact_mod_cast hzs _ hat⟩
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4A, NLogN.IState.top_eq t4T]; exact_mod_cast hzs _ hat
    · exact ⟨hnrB, by decide, hWnr⟩
    · have hsO : NLogN.Rsp.sOff s W ≤ A := le_trans (Nat.mod_lt _ (by omega)).le hsA
      refine ⟨?_, by decide, ?_⟩
      · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4S, NLogN.IState.top_eq t4W]
        rw [hWmod, hsOff]
        refine ⟨⟨hzs _ hsA, ⟨hzs _ hWA2, hzs _ hsA, ?_⟩, ?_⟩, hzs _ hsA, hzs _ hsO⟩
        · (try rw [NLogN.zsz_neg]); exact hzs _ (by omega)
        · rw [show (s : ℤ) + -((W % s : ℕ) : ℤ) = ((s - W % s : ℕ) : ℤ) by omega]
          exact hzs _ (by omega)
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4S, NLogN.IState.top_eq t4W]; rw [hWmod, hsOff]
        exact hzs _ hsO
    · refine ⟨⟨by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t4S]; exact hzs _ hsA, hnrB, ?_⟩, by decide, ?_⟩
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4S]; rw [hnr]
        exact_mod_cast hzs (s + (2 * W + 1)) hsW
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4S]; rw [hnr]
        exact_mod_cast hzs (s + (2 * W + 1)) hsW
    · refine ⟨?_, by decide, ?_⟩
      · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4P]
        refine ⟨⟨hzs _ hpAA, hzs _ hpAA, ?_⟩, by omega⟩
        rw [show (p : ℤ) + p = ((2 * p : ℕ) : ℤ) by push_cast; ring]; exact hzs _ h2pA
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4P]
        rw [show ((p : ℤ) + (p : ℤ)).toNat = 2 * p by omega]
        exact_mod_cast hzs (2 ^ (2 * p)) hpA
    · have htW : t * (2 * W + 1) ≤ A := by
        have : t * (2 * W + 1) ≤ IntMul.OpenAI.R154.rP n * (2 * W + 1) := Nat.mul_le_mul_right _ htr
        omega
      refine ⟨⟨by simp only [NLogN.Ex.Bnd, NLogN.IState.top_eq t4T]; exact hzs _ htA, hnrB, ?_⟩, by decide, ?_⟩
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4T]; rw [hnr]; exact_mod_cast hzs _ htW
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4T]; rw [hnr]; exact_mod_cast hzs _ htW
    · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4M]; exact ⟨hzs _ hmA, by decide, hzs _ hmA⟩
    · refine ⟨?_, by decide, ?_⟩
      · simp only [NLogN.Ex.Bnd, NLogN.Ex.eval, NLogN.IState.top_eq t4M, NLogN.IState.top_eq t4T]
        exact ⟨hzs _ hmA, hzs _ htA, by exact_mod_cast hzs _ hmtA⟩
      · simp only [NLogN.Ex.eval, NLogN.IState.top_eq t4M, NLogN.IState.top_eq t4T]; exact_mod_cast hzs _ hmtA
  have B4b := NLogN.KFY.brk_all M NLogN.KFY.regsA NLogN.KFY.sapAxQ t4 0 (NLogN.ints (NLogN.KFB.gflat (NLogN.KFY.stepL R (IntMul.HvdH.Ref.sapL p s t α) Xs)) ++ R0) _ B 20
    pk5 (by decide) hbd5 S'
  have hregs : NLogN.KFY.regsA.length = 13 := rfl
  rw [hregs] at B4b
  -- assemble step 4
  have B4 := NLogN.GL.seq_all _ _ t2 t4 _ _ _ B4a B4b
  rw [ht4d, NLogN.IState.upd_upd_same] at B4
  have B3 := NLogN.KFY.brk_all M [(NLogN.KFY.yT, NLogN.KFY.tE), (NLogN.KFY.yM, NLogN.KFY.mE)] _ t1 0 _ _ B 20 pk2 (by decide)
    (by
      intro q hq; simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
