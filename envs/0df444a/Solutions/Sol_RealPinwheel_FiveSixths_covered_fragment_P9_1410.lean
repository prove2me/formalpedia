    ∃ j : Fin 7968, codeBox (codeFunctionP9 j.val) d := by
  have hc : fragmentObligations 7968 codeFunctionP9 fragmentContextP9_1410 fragmentTreeP9_1410 := by
    unfold fragmentTreeP9_1410
    apply fragmentComputed_sound
    decide +kernel
  exact fragment_sound 7968 codeFunctionP9 fragmentContextP9_1410 fragmentTreeP9_1410 hc d hΓ
