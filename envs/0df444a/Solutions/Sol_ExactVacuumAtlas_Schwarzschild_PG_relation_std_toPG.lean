/-!
# Standard ↔ Eddington–Finkelstein: the actual coordinate map on the overlap

On the overlap `domStd M` (`r > 0`, `r ≠ 2M`, `0 < θ < π`; both the exterior and, for `M > 0`, the
interior component) we prove, for `ε = ±1`:

* `toEF M ε` and `fromEF M ε` are `C^∞` on `domStd M`, map `domStd M` into itself (⊆ `domEF`) and
  are mutually inverse (globally on the overlap, hence a diffeomorphism of `domStd M` onto itself);
* the Jacobian of `toEF` is the explicit matrix `jac`, its entries are the genuine partial
  derivatives (`HasDerivAt`, not junk values), and `det jac = 1`;
* pull-back identity: `gStd = jacᵀ · (gEF ∘ toEF) · jac` componentwise.

Statements on `r = 2M` are **not** obtained from this relation; they come from the direct EF
certificate on the larger domain `domEF` (`EF.cert`).
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild

namespace ExactVacuumAtlas.Schwarzschild.EFRelation

variable (M ε : ℝ)

@[simp] theorem toEF_0 (x : Pt 4) : toEF M ε x 0 = x 0 + ε * (x 1 + 2 * M * log (x 1 - 2 * M)) := rfl
@[simp] theorem toEF_1 (x : Pt 4) : toEF M ε x 1 = x 1 := rfl
@[simp] theorem toEF_2 (x : Pt 4) : toEF M ε x 2 = x 2 := rfl
@[simp] theorem toEF_3 (x : Pt 4) : toEF M ε x 3 = x 3 := rfl
@[simp] theorem fromEF_0 (y : Pt 4) : fromEF M ε y 0 = y 0 - ε * (y 1 + 2 * M * log (y 1 - 2 * M)) := rfl
@[simp] theorem fromEF_1 (y : Pt 4) : fromEF M ε y 1 = y 1 := rfl
@[simp] theorem fromEF_2 (y : Pt 4) : fromEF M ε y 2 = y 2 := rfl
@[simp] theorem fromEF_3 (y : Pt 4) : fromEF M ε y 3 = y 3 := rfl

theorem fromEF_toEF (x : Pt 4) : fromEF M ε (toEF M ε x) = x := by
  funext i; fin_cases i <;> simp

theorem toEF_fromEF (y : Pt 4) : toEF M ε (fromEF M ε y) = y := by
  funext i; fin_cases i <;> simp

theorem toEF_mem {x : Pt 4} (hx : x ∈ domStd M) : toEF M ε x ∈ domStd M := by
  simpa [domStd] using hx

theorem fromEF_mem {y : Pt 4} (hy : y ∈ domStd M) : fromEF M ε y ∈ domStd M := by
  simpa [domStd] using hy

theorem mapsTo_toEF : Set.MapsTo (toEF M ε) (domStd M) (domStd M) := fun _ hx => toEF_mem M ε hx

theorem bijOn_toEF : Set.BijOn (toEF M ε) (domStd M) (domStd M) :=
  Set.InvOn.bijOn ⟨fun x _ => fromEF_toEF M ε x, fun y _ => toEF_fromEF M ε y⟩
    (mapsTo_toEF M ε) (fun _ hy => fromEF_mem M ε hy)

theorem contDiffOn_toEF : ContDiffOn ℝ ∞ (toEF M ε) (domStd M) := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, toEF_0, toEF_1,
    toEF_2, toEF_3] <;>
    fun_prop (disch := (intro y hy; exact domStd_D hy))

theorem contDiffOn_fromEF : ContDiffOn ℝ ∞ (fromEF M ε) (domStd M) := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, fromEF_0,
    fromEF_1, fromEF_2, fromEF_3] <;>
    fun_prop (disch := (intro y hy; exact domStd_D hy))

/-- All sixteen Jacobian entries are the `pd` partial derivatives of the components of `toEF`. -/
theorem pd_toEF {x : Pt 4} (hx : x ∈ domStd M) (k i : Fin 4) :
    pd i (fun y => toEF M ε y k) x = jac M ε x k i := by
  fin_cases k <;> fin_cases i <;>
    first
    | exact (hasDerivAt_toEF_0_r M ε hx).deriv.trans (by simp [jac])
    | simp [pd, jac, Function.update_apply]

/-- No junk derivatives: each component of `toEF` has the Jacobian entry as genuine derivative. -/
theorem hasDerivAt_pd_toEF {x : Pt 4} (hx : x ∈ domStd M) (k i : Fin 4) :
    HasDerivAt (fun u => toEF M ε (Function.update x i u) k) (jac M ε x k i) (x i) := by
  rw [← pd_toEF M ε hx k i]
  have hc : ContDiffOn ℝ ∞ (fun y => toEF M ε y k) (domStd M) :=
    (contDiffOn_pi.mp (contDiffOn_toEF M ε)) k
  exact hasDerivAt_pd (isOpen_domStd M) hc hx i

end ExactVacuumAtlas.Schwarzschild.EFRelation

