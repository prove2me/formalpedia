        Module.Finite (GaloisRep.ratLocalizedAt p) H ∧
        Module.Flat (GaloisRep.ratLocalizedAt p) H ∧
        Coalgebra.IsCocomm (GaloisRep.ratLocalizedAt p) H ∧
        ∃ e : WithConv (H →ₐ[GaloisRep.ratLocalizedAt p] AlgebraicClosure ℚ) ≃ P,
          (∀ f g, e (f * g) = e f + e g) ∧
