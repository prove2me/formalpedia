variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

private theorem exists_slice_iteratedDeriv_bound {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}
    {φ : AdelicGL2 (𝓞 F) F → ℂ} (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (hφc : Continuous φ)
    (hK : IsArchKFiniteAt F w φ) {τ : ℝ} (hτ : 0 ≤ τ)
    (hc₁ : Continuous fun r : ℝˣ => ((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ))
    (hc₂ : Continuous fun r : ℝˣ => ((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ))
    (hs₁ : ∀ r : ℝˣ, ‖((χ₁ (realIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ |(r : ℝ)| ^ τ)
    (hs₂ : ∀ r : ℝˣ, ‖((χ₂ (realIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ |(r : ℝ)| ^ (-τ))
    (E : ℝ → AdeleRing (𝓞 F) F) (hEw : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y)
    (hEv : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE2 : ∀ y, (E y).2 = 0) :
    ∃ (m : ℕ) (kv : Fin m → AdelicGL2 (𝓞 F) F), (∀ i, kv i ∈ archRowIsometrySubgroup F w) ∧
      ∀ S : Set (AdelicGL2 (𝓞 F) F), IsCompact S → ∀ n : ℕ, ∃ C : ℝ, 0 ≤ C ∧
        ∀ x ∈ S, ∀ (a : AdeleRing (𝓞 F) F) (y : ℝ),
          ‖iteratedDeriv n (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)) y‖
            ≤ C * max 1 ‖(a + E y).1 w‖ ^ (-(2 * τ))
                * ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖ := by

  obtain ⟨m, kv, c, hkv, hcs, -, hcC, hexp⟩ := exists_expansion (archRowIsometrySubgroup F w) φ hφc hK
    (rhoW hw) (rhoW_mem hw) (rhoW_zero hw) (rhoW_add hw) (continuous_rhoW hw) Real.two_pi_pos (rhoW_periodic hw)
  refine ⟨m, kv, hkv, fun S hS n => ?_⟩

  have hΨg : IsOneParamGroup (psiW hw χ₁ χ₂) := isOneParamGroup_psiW hw hc₁ hc₂
  have hκ : 0 ≤ ‖deriv (psiW hw χ₁ χ₂) 0‖ := norm_nonneg _
  have hΨd := norm_iteratedDeriv_le_of_isOneParamGroup hΨg
  have hΨM := norm_psiW_le hw hs₁ hs₂

  obtain ⟨Cc, hCc0, hCc⟩ := exists_uniform_coeff_bound hcC n

  have hTS : IsCompact ((fun x => toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) '' S) :=
    hS.image (continuous_toRealGL_archComponent hw)
  obtain ⟨C, hC0, hC⟩ := exists_uniform_bound hTS n hκ hCc0 (by positivity : 0 ≤ 2 * τ)

  obtain ⟨B₁, hB₁⟩ := hS.exists_bound_of_continuousOn
    ((continuous_det_GL.comp (continuous_toRealGL_archComponent hw)).continuousOn)
  have hB' : 0 < max B₁ 1 := lt_max_of_lt_right one_pos
  refine ⟨C * max B₁ 1 ^ τ, mul_nonneg hC0 (Real.rpow_nonneg hB'.le τ), fun x hx a y => ?_⟩
  have hg : (gOf hw x).det ≠ 0 := gOf_det_ne_zero hw x

  have hc₀ : ‖((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)‖ ≤ max B₁ 1 ^ τ := by
    refine (hs₁ _).trans ?_
    rw [coe_detUnit, abs_neg]
    refine Real.rpow_le_rpow (abs_nonneg _) ?_ hτ
    exact ((Real.norm_eq_abs _).symm.le.trans (hB₁ x hx)).trans (le_max_left _ _)

  have hfun : (fun y => φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x))
      = fun y => ∑ i, (((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)
              * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i))
          * ((fun u => psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) u)) * c i (angle (gOf hw x) u))
              (ringEquivRealOfIsReal hw (a.1 w) + y)) :=
    funext fun y => slice_translate_eq hw hφ hexp x a hEw hEv hE2 y
  have hmm : ∀ i, ContDiff ℝ ∞ (fun u => psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) u)) * c i (angle (gOf hw x) u)) :=
    fun i => contDiff_mul_comp hg hΨg.contDiff (hcs i)
  rw [hfun, iteratedDeriv_sum_const_mul_shift _ _ hmm n (ringEquivRealOfIsReal hw (a.1 w)) y]

  have key : ∀ i, ‖(((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)
        * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i))
        * iteratedDeriv n (fun u => psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) u)) * c i (angle (gOf hw x) u))
            (ringEquivRealOfIsReal hw (a.1 w) + y)‖
      ≤ (max B₁ 1 ^ τ * ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖)
          * (C * max 1 |ringEquivRealOfIsReal hw (a.1 w) + y| ^ (-(2 * τ))) := by
    intro i
    rw [norm_mul, norm_mul]
    refine mul_le_mul (mul_le_mul_of_nonneg_right hc₀ (norm_nonneg _)) ?_ (norm_nonneg _) (by positivity)
    have h := hC (toRealGL hw (archComponent F w (glArch (𝓞 F) F x))) ⟨x, hx, rfl⟩ (psiW hw χ₁ χ₂) (c i)
      hΨg.contDiff (hcs i) hΨd (fun j hj θ => hCc i j hj θ) 1 hΨM (ringEquivRealOfIsReal hw (a.1 w) + y)
    rw [mul_one] at h
    exact h
  calc ‖∑ i, (((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)
            * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i))
          * iteratedDeriv n (fun u => psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) u)) * c i (angle (gOf hw x) u))
              (ringEquivRealOfIsReal hw (a.1 w) + y)‖
      ≤ ∑ i, ‖(((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)
            * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i))
          * iteratedDeriv n (fun u => psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) u)) * c i (angle (gOf hw x) u))
              (ringEquivRealOfIsReal hw (a.1 w) + y)‖ := norm_sum_le _ _
    _ ≤ ∑ i, (max B₁ 1 ^ τ * ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖)
          * (C * max 1 |ringEquivRealOfIsReal hw (a.1 w) + y| ^ (-(2 * τ))) :=
        Finset.sum_le_sum fun i _ => key i
    _ = C * max B₁ 1 ^ τ * max 1 ‖(a + E y).1 w‖ ^ (-(2 * τ))
          * ∑ i, ‖φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) * kv i)‖ := by
        rw [norm_fst_translate hw a hEw y, Finset.mul_sum]
        exact Finset.sum_congr rfl fun i _ => by ring

end Estimate
