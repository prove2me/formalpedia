variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsComplex)
variable {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ}

private theorem norm_psiWC_le {τ : ℝ}
    (hs₁ : ∀ r : ℂˣ, ‖((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ τ)
    (hs₂ : ∀ r : ℂˣ, ‖((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ (-τ)) (t : ℝ) :
    ‖psiWC hw χ₁ χ₂ t‖ ≤ Real.exp (-(2 * τ) * t) := by
  rw [psiWC, norm_mul]
  have h1 := hs₁ (expCUnit (-t))
  have h2 := hs₂ (expCUnit t)
  rw [coe_expCUnit, Complex.norm_of_nonneg (Real.exp_pos _).le, ← Real.exp_mul] at h1
  rw [coe_expCUnit, Complex.norm_of_nonneg (Real.exp_pos _).le, ← Real.exp_mul] at h2
  calc _ ≤ Real.exp (-t * τ) * Real.exp (t * -τ) :=
        mul_le_mul h1 h2 (norm_nonneg _) (Real.exp_pos _).le
    _ = Real.exp (-(2 * τ) * t) := by
        rw [← Real.exp_add]
        congr 1
        ring

private theorem norm_psiWC_log_radC_le {τ : ℝ} (hτ : 0 ≤ τ)
    (hs₁ : ∀ r : ℂˣ, ‖((χ₁ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ τ)
    (hs₂ : ∀ r : ℂˣ, ‖((χ₂ (complexIdeleAt hw r) : ℂˣ) : ℂ)‖ ≤ ‖(r : ℂ)‖ ^ (-τ))
    {g : Matrix (Fin 2) (Fin 2) ℂ} (hg : g.det ≠ 0) (z : ℂ) :
    ‖psiWC hw χ₁ χ₂ (Real.log (radC g z))‖
      ≤ Real.sqrt (radFloorC g) ^ (-(2 * τ)) * max 1 ‖z‖ ^ (-(2 * τ)) := by
  refine (norm_psiWC_le hw hs₁ hs₂ _).trans ?_
  have hr := radC_pos hg z
  have h1 : Real.exp (-(2 * τ) * Real.log (radC g z)) = radC g z ^ (-(2 * τ)) := by
    rw [Real.rpow_def_of_pos hr]
    congr 1
    ring
  rw [h1]
  exact radC_rpow_neg_le hg (by linarith) z

private theorem norm_iteratedFDeriv_psiWC_line_le (hΨ : IsOneParamGroup (psiWC hw χ₁ χ₂))
    {g : Matrix (Fin 2) (Fin 2) ℂ} (hg : g.det ≠ 0) (z₀ : ℂ) (θ : ℝ) {n i : ℕ} (hin : i ≤ n) (r : ℝ) :
    ‖iteratedFDeriv ℝ i
        (fun r : ℝ => psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))) r‖
      ≤ n ! * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n * (n ! * hatRatio g) ^ n)
          * ‖psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))‖ := by
  have hA : 0 < Real.sqrt (botNormSqC g) := Real.sqrt_pos.mpr (botNormSqC_pos g hg)
  have hdet := det_lineMat_ne_zero hg z₀ θ
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : ℝ → ℂ,
      Φ = fun s => psiWC hw χ₁ χ₂ (Real.log (Real.sqrt (botNormSqC g)) + s) := ⟨_, rfl⟩
  have hΦmul : Φ = fun s => psiWC hw χ₁ χ₂ (Real.log (Real.sqrt (botNormSqC g))) * psiWC hw χ₁ χ₂ s := by
    rw [hΦ]
    funext s
    exact hΨ.map_add _ s
  have hΦcd : ContDiff ℝ ∞ Φ := by
    rw [hΦ]
    exact hΨ.contDiff.comp (contDiff_const.add contDiff_id)
  have hΦd : ∀ (j : ℕ) (t : ℝ), ‖iteratedDeriv j Φ t‖ ≤ ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ j * ‖Φ t‖ := by
    intro j t
    have h := M4aP3B.PlaceEstimate.norm_iteratedDeriv_le_of_isOneParamGroup hΨ j t
    rw [hΦmul, iteratedDeriv_const_mul _ ((hΨ.contDiff.of_le (by exact_mod_cast le_top)).contDiffAt),
      norm_mul, norm_mul]
    calc ‖psiWC hw χ₁ χ₂ (Real.log (Real.sqrt (botNormSqC g)))‖ * ‖iteratedDeriv j (psiWC hw χ₁ χ₂) t‖
        ≤ ‖psiWC hw χ₁ χ₂ (Real.log (Real.sqrt (botNormSqC g)))‖
            * (‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ j * ‖psiWC hw χ₁ χ₂ t‖) :=
          mul_le_mul_of_nonneg_left h (norm_nonneg _)
      _ = _ := by ring
  have hval : ∀ u : ℝ, Φ (Real.log (rad (lineMat g z₀ θ) u))
      = psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + u * Complex.exp (θ * Complex.I)))) := by
    intro u
    simp only [hΦ]
    rw [radC_line_eq hg z₀ θ u, Real.log_mul hA.ne' (rad_pos hdet u).ne']
  have hfun : (fun r : ℝ => psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I)))))
      = fun r : ℝ => Φ (Real.log (rad (lineMat g z₀ θ) r)) := by
    funext u
    exact (hval u).symm
  rw [hfun]
  refine (norm_iteratedFDeriv_comp_log_rad_le hdet hΦcd (norm_nonneg (deriv (psiWC hw χ₁ χ₂) 0)) hΦd hin
    r).trans ?_
  rw [hval r]
  have h0 : (0 : ℝ) ≤ towerD (lineMat g z₀ θ) n := zero_le_one.trans (one_le_towerD n)
  have hT : towerD (lineMat g z₀ θ) n ^ n ≤ (n ! * hatRatio g) ^ n :=
    pow_le_pow_left₀ h0 (towerD_lineMat_le hg z₀ θ n) n
  have hv : (0 : ℝ)
      ≤ ‖psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))‖ := norm_nonneg _
  have hκ : (0 : ℝ) ≤ max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n := by positivity
  calc (n ! : ℝ) * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n
          * ‖psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))‖)
        * towerD (lineMat g z₀ θ) n ^ n
      ≤ n ! * (max 1 ‖deriv (psiWC hw χ₁ χ₂) 0‖ ^ n
          * ‖psiWC hw χ₁ χ₂ (Real.log (radC g (z₀ + r * Complex.exp (θ * Complex.I))))‖)
        * (n ! * hatRatio g) ^ n :=
        mul_le_mul_of_nonneg_left hT (mul_nonneg (Nat.cast_nonneg _) (mul_nonneg hκ hv))
    _ = _ := by ring

end PsiLeg
