open MeasureTheory MeasurableSpace Set AvramDividend.Classical
open scoped ENNReal NNReal

/-- The *original* filtration's predictable time-history sigma algebra,
crossed with an arbitrary mark sigma algebra, is generated by marked
adapted past rectangles. The adapted family is itself countably spanning. -/
theorem solution
    {Ω ι E : Type*} [mΩ : MeasurableSpace Ω]
    [LinearOrder ι] [OrderBot ι] [mE : MeasurableSpace E]
    (𝓕 : Filtration ι mΩ)
    [mHist : MeasurableSpace (ι × Ω)]
    (hHist : mHist = 𝓕.predictable) :
    let G : Set (Set (ι × Ω)) :=
      {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
                S = ({⊥} ×ˢ A)) ∨
           (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
                S = (Set.Ioi i ×ˢ A))}
    MeasurableSpace.generateFrom
        (Set.image2 (· ×ˢ ·) G {C : Set E | MeasurableSet C}) =
      @Prod.instMeasurableSpace (ι × Ω) E mHist mE := by
  classical
  let G : Set (Set (ι × Ω)) :=
    {S | (∃ A : Set Ω, MeasurableSet[𝓕 ⊥] A ∧
              S = ({⊥} ×ˢ A)) ∨
         (∃ i : ι, ∃ A : Set Ω, MeasurableSet[𝓕 i] A ∧
              S = (Set.Ioi i ×ˢ A))}
  change MeasurableSpace.generateFrom
      (Set.image2 (· ×ˢ ·) G {C : Set E | MeasurableSet C}) =
    @Prod.instMeasurableSpace (ι × Ω) E mHist mE
  let g : ℕ → Set (ι × Ω) := fun n =>
    if n = 0 then ({⊥} ×ˢ (Set.univ : Set Ω))
    else Set.Ioi (⊥ : ι) ×ˢ (Set.univ : Set Ω)
  have hgmem (n : ℕ) : g n ∈ G := by
    by_cases hn : n = 0
    · left
      refine ⟨Set.univ, MeasurableSet.univ, ?_⟩
      simp [g, hn]
    · right
      refine ⟨⊥, Set.univ, MeasurableSet.univ, ?_⟩
      simp [g, hn]
  have hcover : (⋃ n, g n) = Set.univ := by
    ext x
    constructor
    · intro _
      trivial
    · intro _
      by_cases hb : x.1 = ⊥
      · refine Set.mem_iUnion.mpr ⟨0, ?_⟩
        simp [g, hb]
      · refine Set.mem_iUnion.mpr ⟨1, ?_⟩
        have hlt : (⊥ : ι) < x.1 :=
          lt_of_le_of_ne (show (⊥ : ι) ≤ x.1 from bot_le) (Ne.symm hb)
        simp [g, hlt]
  have hSpan : IsCountablySpanning G := ⟨g, hgmem, hcover⟩
  have hG : MeasurableSpace.generateFrom G = mHist := by
    rw [hHist]
    exact (avram_wave4_p1_predictable_adapted_rectangle_sigma_generator 𝓕).symm
  have hD :
      MeasurableSpace.generateFrom {C : Set E | MeasurableSet C} = mE :=
    generateFrom_measurableSet
  exact generateFrom_eq_prod hG hD hSpan isCountablySpanning_measurableSet