theorem inv_one {R : Type u} [CommRing R] {X : Scheme.{u}} {f : X ⟶ Spec (CommRingCat.of R)}
    (G : RelativeGroupLaw R f) {T : Scheme.{u}} (t : T ⟶ Spec (CommRingCat.of R)) :
    G.inv t (G.one t) = G.one t := by
  have h := G.inv_mul_cancel t (G.one t)
  rw [G.mul_one] at h
  exact h

theorem zsmulSection_one {T : Type u} [CommRing T] {W : WeierstrassCurve.Projective T}
    (G : RelativeGroupLaw T (projModelStrCR W)) (n : ℤ) :
    ModularCurve.LevelRelabelling.zsmulSection G n (G.one (𝟙 _)) = G.one (𝟙 _) := by
  cases n with
  | ofNat k =>
    show G.nsmul _ k (G.one _) = G.one _
    exact G.nsmul_unit _ k
  | negSucc k =>
    show G.inv _ (G.nsmul _ (k + 1) (G.one _)) = G.one _
    rw [G.nsmul_unit]
    exact inv_one G _

theorem zlinComb_one_one {T : Type u} [CommRing T] {W : WeierstrassCurve.Projective T}
    (G : RelativeGroupLaw T (projModelStrCR W)) (a b : ℤ) :
    ModularCurve.LevelRelabelling.zlinComb G (G.one (𝟙 _)) (G.one (𝟙 _)) a b = G.one (𝟙 _) := by
  unfold ModularCurve.LevelRelabelling.zlinComb
  rw [zsmulSection_one, zsmulSection_one, G.mul_one]

theorem relabel_eq_of_eq_one {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
    (𝒢 : GroupLaws A) (g : Matrix (Fin 2) (Fin 2) ℤ) (x : RawDrinfeldPair T) (hΔ : IsUnit x.curve.Δ)
    (hP : x.P = (𝒢 T x.curve hΔ).one (𝟙 _)) (hQ : x.Q = (𝒢 T x.curve hΔ).one (𝟙 _)) :
    ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel 𝒢 g x hΔ = x := by
  obtain ⟨c, P, Q⟩ := x
  simp only [ModularCurve.LevelRelabelling.RawDrinfeldPair.relabel]
  simp only at hP hQ
  rw [hP, hQ, zlinComb_one_one, zlinComb_one_one]

theorem eq_of_eq_one {A : Type u} [CommRing A] {T : Type u} [CommRing T] [Algebra A T]
    (𝒢 : GroupLaws A) (x x' : RawDrinfeldPair T) (hΔ : IsUnit x.curve.Δ) (hΔ' : IsUnit x'.curve.Δ)
    (hc : x'.curve = x.curve)
    (hP : x.P = (𝒢 T x.curve hΔ).one (𝟙 _)) (hQ : x.Q = (𝒢 T x.curve hΔ).one (𝟙 _))
    (hP' : x'.P = (𝒢 T x'.curve hΔ').one (𝟙 _)) (hQ' : x'.Q = (𝒢 T x'.curve hΔ').one (𝟙 _)) :
    x' = x := by
  obtain ⟨c, P, Q⟩ := x
  obtain ⟨c', P', Q'⟩ := x'
  simp only at hc
  subst hc
  simp only at hP hQ hP' hQ'
  rw [hP, hQ, hP', hQ']

theorem isGamma1Point_variableChange {A : Type u} [CommRing A] {W : WeierstrassCurve A} {ℓ : ℕ}
    {D : ModularCurve.LevelPData A} (h : ModularCurve.IsGamma1Point W ℓ D) (C : WeierstrassCurve.VariableChange A) :
    ModularCurve.IsGamma1Point (C • W) ℓ (D.variableChange C) where
  equation_P := ModularCurve.IsLevelPStructure.equation_variableChange_aux C h.equation_P
  preΨ_P := by
    rw [ModularCurve.LevelPData.variableChange_xP, WeierstrassCurve.eval_prePsi_variableChange, h.preΨ_P, mul_zero]
  xQ_eq := by rw [ModularCurve.LevelPData.variableChange_xQ, ModularCurve.LevelPData.variableChange_xP, h.xQ_eq]
  yQ_eq := by rw [ModularCurve.LevelPData.variableChange_yQ, ModularCurve.LevelPData.variableChange_yP, h.xQ_eq, h.yQ_eq]

theorem baseChange_self {F : Type u} [Field F] (W : WeierstrassCurve F) : W.baseChange F = W := by
  show W.map (algebraMap F F) = W
  rw [Algebra.algebraMap_self, WeierstrassCurve.map_id]

theorem det2 (γ : SL(2, ℤ)) : γ 0 0 * γ 1 1 - γ 0 1 * γ 1 0 = 1 := by
  have h := Matrix.SpecialLinearGroup.det_coe γ
  rwa [Matrix.det_fin_two] at h

theorem mul_apply_11 (A B : SL(2, ℤ)) : (A * B) 1 1 = A 1 0 * B 0 1 + A 1 1 * B 1 1 := by
  rw [Matrix.SpecialLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_two]

theorem inv_apply_11 (A : SL(2, ℤ)) : (A⁻¹) 1 1 = A 0 0 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; rfl

theorem inv_apply_00 (A : SL(2, ℤ)) : (A⁻¹) 0 0 = A 1 1 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; rfl

theorem inv_apply_10 (A : SL(2, ℤ)) : (A⁻¹) 1 0 = -A 1 0 := by
  rw [Matrix.SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]; rfl

theorem lowerLeft_mod {M' ℓ : ℕ} (hℓ : ℓ ∣ M') {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') :
    ((γ 1 0 : ℤ) : ZMod ℓ) = 0 := by
  have := CongruenceSubgroup.Gamma0_mem.mp hγ
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at this ⊢
  exact dvd_trans (Int.natCast_dvd_natCast.mpr hℓ) this

theorem diag_mod {M' ℓ : ℕ} (hℓ : ℓ ∣ M') {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') :
    ((γ 0 0 : ℤ) : ZMod ℓ) * ((γ 1 1 : ℤ) : ZMod ℓ) = 1 := by
  have h10 := lowerLeft_mod hℓ hγ
  have := congrArg (fun z : ℤ => (z : ZMod ℓ)) (det2 γ)
  simp only [Int.cast_sub, Int.cast_mul, Int.cast_one, h10, mul_zero, sub_zero] at this
  exact this

theorem inv_11_mod {M' ℓ : ℕ} (hℓ : ℓ ∣ M') {γ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') :
    (((γ⁻¹) 1 1 : ℤ) : ZMod ℓ) * ((γ 1 1 : ℤ) : ZMod ℓ) = 1 := by
  rw [inv_apply_11]; exact diag_mod hℓ hγ

theorem mul_11_mod {M' ℓ : ℕ} (hℓ : ℓ ∣ M') {γ δ : SL(2, ℤ)} (hγ : γ ∈ CongruenceSubgroup.Gamma0 M') :
    (((γ * δ) 1 1 : ℤ) : ZMod ℓ) = ((γ 1 1 : ℤ) : ZMod ℓ) * ((δ 1 1 : ℤ) : ZMod ℓ) := by
  rw [mul_apply_11]; push_cast; rw [lowerLeft_mod hℓ hγ, zero_mul, zero_add]

theorem exists_emb (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (m : ℕ) [NeZero m]
    (ξ : ↥k₀) (hξ : IsPrimitiveRoot ξ m) :
    ∃ ι : ↥k₀ →+* ℂ, ι ξ = Complex.exp (2 * Real.pi * Complex.I / m) := by
  haveI hQbar : Algebra.IsAlgebraic ℚ (AlgebraicClosure ℚ) := by
    have h := AlgebraicClosure.isAlgebraic ℚ
    convert h
    rfl
    rfl
  haveI : Algebra.IsAlgebraic ℚ ↥k₀ :=
    Algebra.IsAlgebraic.of_injective (k₀.val) (k₀.val).toRingHom.injective
  have hmin : minpoly ℚ ξ = Polynomial.cyclotomic m ℚ :=
    (Polynomial.cyclotomic_eq_minpoly_rat hξ (Nat.pos_of_ne_zero (NeZero.ne m))).symm
  have hroot : Complex.exp (2 * Real.pi * Complex.I / m) ∈ (minpoly ℚ ξ).rootSet ℂ := by
    rw [hmin, Polynomial.mem_rootSet]
    refine ⟨Polynomial.cyclotomic_ne_zero m ℚ, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map, Polynomial.map_cyclotomic]
    exact (Polynomial.isRoot_cyclotomic_iff.mpr (Complex.isPrimitiveRoot_exp m (NeZero.ne m))).eq_zero
  rw [← Algebra.IsAlgebraic.range_eval_eq_rootSet_minpoly ℂ ξ] at hroot
  obtain ⟨ψ, hψ⟩ := hroot
  exact ⟨ψ.toRingHom, hψ⟩

def negVC {R : Type u} [CommRing R] (W : WeierstrassCurve R) : WeierstrassCurve.VariableChange R := ⟨-1, 0, -W.a₁, -W.a₃⟩

theorem negVC_u {R : Type u} [CommRing R] (W : WeierstrassCurve R) : (((negVC W).u⁻¹ : Rˣ) : R) = -1 := by
  simp [negVC]

theorem negVC_smul {R : Type u} [CommRing R] (W : WeierstrassCurve R) : negVC W • W = W := by
  have hu := negVC_u W
  ext <;> simp only [WeierstrassCurve.variableChange_a₁, WeierstrassCurve.variableChange_a₂, WeierstrassCurve.variableChange_a₃,
      WeierstrassCurve.variableChange_a₄, WeierstrassCurve.variableChange_a₆, hu] <;> simp [negVC] <;> ring

theorem kernelVariableChangeDeg_negVC {R : Type u} [CommRing R] (W : WeierstrassCurve R) (d : ℕ) (h : Polynomial R) :
    ModularCurve.kernelVariableChangeDeg (negVC W) d h = h := by
  unfold ModularCurve.kernelVariableChangeDeg
  rw [negVC_u]
  have hu : ((((negVC W).u : Rˣ) : R)) = -1 := by simp [negVC]
  have hr : (negVC W).r = 0 := rfl
  rw [hu, hr]
  simp [Even.neg_one_pow ⟨d, (two_mul d)⟩]

theorem variableChange_negVC_xP {R : Type u} [CommRing R] (W : WeierstrassCurve R) (D : ModularCurve.LevelPData R) :
    (D.variableChange (negVC W)).xP = D.xP := by
  rw [ModularCurve.LevelPData.variableChange_xP, negVC_u]; simp [negVC]

theorem variableChange_negVC_yP {R : Type u} [CommRing R] (W : WeierstrassCurve R) (D : ModularCurve.LevelPData R) :
    (D.variableChange (negVC W)).yP = W.toAffine.negY D.xP D.yP := by
  rw [ModularCurve.LevelPData.variableChange_yP, negVC_u, WeierstrassCurve.Affine.negY]; simp [negVC]; ring

theorem act_negVC_eq_of_eq_one {A : Type} [CommRing A] (𝒢 : GroupLaws A) (h𝒢 : 𝒢.IsChordTangent) (h𝒢O : 𝒢.IsOriginIdentity)
    (q : ℕ) (𝒯 : LevelTransport A 𝒢 q) (h𝒯 : 𝒯.IsSectionTransport)
    (hVC : ∀ (T : Type) [CommRing T] [Algebra A T] (W : WeierstrassCurve.Projective T) (C : WeierstrassCurve.VariableChange T),
      ∃ (φ : projModelGradingCR W →+*ᵍ projModelGradingCR (C • W))
        (_ : HomogeneousIdeal.irrelevant (projModelGradingCR (C • W)) ≤ (HomogeneousIdeal.irrelevant (projModelGradingCR W)).map φ),
        IsVariableChangeHom W C φ)
    (K : Type) [Field K] [Algebra A K] (x : RawDrinfeldPair K) (hΔ : IsUnit x.curve.Δ)
    (hP : x.P = (𝒢 K x.curve hΔ).one (𝟙 _)) (hQ : x.Q = (𝒢 K x.curve hΔ).one (𝟙 _)) :
    𝒯.act ⟨-1, 0, -x.curve.a₁, -x.curve.a₃⟩ x = x := by
  obtain ⟨hc, hP', hQ'⟩ := LevelTransport.exists_act_neg_comp_eqToHom_eq_inv 𝒢 h𝒢 h𝒢O q 𝒯 h𝒯 hVC K x hΔ
  rw [hP, StabH1.inv_one] at hP'
  rw [← hP] at hP'
  rw [hQ, StabH1.inv_one] at hQ'
  rw [← hQ] at hQ'
  generalize hz : 𝒯.act ⟨-1, 0, -x.curve.a₁, -x.curve.a₃⟩ x = z at hc hP' hQ'
  obtain ⟨c', P', Q'⟩ := z
  simp only at hc
  subst hc
  simp only [eqToHom_refl, Category.comp_id] at hP' hQ'
  have eP : P' = x.P := Subtype.ext hP'
  have eQ : Q' = x.Q := Subtype.ext hQ'
  rw [eP, eQ]

end StabH1

theorem solution
    (q : ℕ) [Fact q.Prime] (hq3 : q = 3) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (ℓg : ℕ) (hℓg : ℓg.Prime) (hℓg12 : ℓg % 12 = 11) (hℓgM' : ℓg ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (s : ↥W)

    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (π₀ : ↥k₀) (hπ : (π₀ : (AlgebraicClosure ℚ)) ∈ A)
    (hdvr : IsDiscreteValuationRing ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))
    (hunif : maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) =
      Ideal.span {(⟨π₀, hπ⟩ : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))})
    (hhens : HenselianLocalRing ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))
    (hres : IsAlgClosed (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))))
    (hκ : ∀ a : (AlgebraicClosure ℚ), a ∈ A → ∃ c : ↥k₀, (c : (AlgebraicClosure ℚ)) ∈ A ∧ ∃ h : a - c ∈ A, (⟨_, h⟩ : A) ∈ maximalIdeal A)

    (ξ : ↥k₀) (hξ : IsPrimitiveRoot ξ q)

    (H₁ : Subgroup (ZMod (q ^ 2 * M'))ˣ)
    (hH₁ : H₁ = ModularCurve.FullLevel.levelH q M' ⊓ (ZMod.unitsMap (Dvd.dvd.mul_left hℓgM' (q ^ 2))).ker)
    (Kℓ : IntermediateField ↥k₀ (LaurentSeries ↥k₀))
    (hKℓ : Kℓ = ModularCurve.laurentBaseChange ↥k₀
      (ModularCurve.xHFunctionField (q ^ 2 * M') H₁))
    [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥Kℓ] [IsScalarTower ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥k₀ ↥Kℓ]
    (jℓ : ↥Kℓ) (hjℓ : ((jℓ : LaurentSeries ↥k₀)) = ModularCurve.coeffEmb ↥k₀ ModularCurve.jq) [Fact (jℓ ≠ 0)]

    (y : Ideal ↥(chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ)) (hy : y.IsMaximal)
    (hϖy : algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ) ⟨π₀, hπ⟩ ∈ y)
    (hss : ∀ (Ω : Type) [Field Ω] [CharP Ω q] [IsAlgClosed Ω] [DecidableEq Ω]
      (φ : ↥(chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ) →+* Ω), RingHom.ker φ = y → φ (jChartFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ) ∈ ModularCurve.ssJSet q Ω)

    (hover :
    (∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
      (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
          ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
      ∀ (hgK : (coeffEmb ↥k₀ g) ∈ Kℓ)
        (hgC : (⟨_, hgK⟩ : ↥Kℓ) ∈ AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ),
      ∀ (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A),
        residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
        (⟨⟨_, hgK⟩, hgC⟩ : ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ)) -
            algebraMap ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) ↥(AlgebraicCurve.TwoChartIntegralModel.chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ) ⟨c, hc⟩ ∈ y))

    (E : WeierstrassCurve (ResidueField ↥A)) [E.IsElliptic] (Cyc : AddSubgroup E.toAffine.Point)
    (hcyc : IsAddCyclic Cyc) (hcardCyc : Nat.card Cyc = M')
    (hP : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring =
      (moduliPlace (ResidueField ↥A) M' E Cyc).toValuationSubring.comap
        (IntermediateField.inclusion (modularFunctionFieldC_le_full (ResidueField ↥A) M')).toRingHom) :
    Nat.card {τ : ↥Kℓ ≃ₐ[↥k₀] ↥Kℓ //

        (∃ γ : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma q ∧ γ ∈ CongruenceSubgroup.Gamma0 M' ∧ ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ γ⁻¹ Kℓ τ) ∧

        (∀ (b : ↥(chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ)) (hb : τ (b : ↥Kℓ) ∈ chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ), b ∈ y ↔ (⟨τ (b : ↥Kℓ), hb⟩ : ↥(chartAlgFin ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) (↥Kℓ) jℓ)) ∈ y)} =
    Nat.card {ι : E.toAffine.Point →+ E.toAffine.Point //
        ι ∈ WeierstrassCurve.rationalHomSet (ResidueField ↥A) E E ∧
        (∃ ι' ∈ WeierstrassCurve.rationalHomSet (ResidueField ↥A) E E, ι'.comp ι = AddMonoidHom.id _ ∧ ι.comp ι' = AddMonoidHom.id _) ∧
        Cyc.map ι = Cyc} := by
  classical
  have hqp : q.Prime := Fact.out
  haveI hqne : NeZero q := ⟨hqp.ne_zero⟩
  have hq2 : q ≠ 2 := by omega
  haveI hresI : IsAlgClosed (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) := hres
  have hqmem : ((q : ℕ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) ∈ maximalIdeal ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have hqA : ((q : ℕ) : ↥A) ∈ maximalIdeal ↥A := by
      have hq' : (((q : ℕ) : ↥A) : AlgebraicClosure ℚ) = (q : AlgebraicClosure ℚ) := by norm_cast
      rw [← ValuationSubring.coe_mem_nonunits_iff, hq']; exact hA
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hqA
    apply hqA
    obtain ⟨v, hv⟩ := hu
    refine isUnit_iff_exists_inv.mpr ⟨⟨(((v⁻¹ : (↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))ˣ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) : ↥k₀), ((v⁻¹ : (↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))))ˣ) : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))).2⟩, Subtype.ext ?_⟩
    have e := congrArg (fun z : ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) => (((z : ↥k₀)) : AlgebraicClosure ℚ)) v.mul_inv
    rw [hv] at e
    push_cast at e ⊢
    simpa using e
  haveI hcharκ : CharP (ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) q := by
    have h0 : ((q : ℕ) : ResidueField ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))) = 0 := by
      rw [← map_natCast (IsLocalRing.residue ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ)))), IsLocalRing.residue_eq_zero_iff]; exact hqmem
    exact (CharP.charP_iff_prime_eq_zero hqp).mpr h0
  have hℓgpf : ℓg ∈ M'.primeFactors := Nat.mem_primeFactors.mpr ⟨hℓg, hℓgM', NeZero.ne M'⟩
  have hℓodd : Odd ℓg := by rw [Nat.odd_iff]; omega
  have hℓ11 : 11 ≤ ℓg := by omega
  haveI : Fact ℓg.Prime := ⟨hℓg⟩
  haveI : NeZero ℓg := ⟨hℓg.ne_zero⟩
  have hcop : Nat.Coprime q M' := (Nat.Prime.coprime_iff_not_dvd hqp).mpr hqM'

  have hιξ : ∃ ι : ↥k₀ →+* ℂ, ι ξ = Complex.exp (2 * Real.pi * Complex.I / q) := StabH1.exists_emb k₀ q ξ hξ

  have hexist := ModularCurve.FullLevel.exists_isLevelAutAt_of_mem_gamma0_of_eq_levelH_inf_ker q M' hqM' ℓg hℓgM' ↥k₀ ξ hξ H₁ hH₁ Kℓ hKℓ
  obtain ⟨huniq, hmul, hone⟩ :=
    ModularCurve.FullLevel.isLevelAutAt_unique_mul_one_of_exists_ringHom_of_eq_levelH_inf_ker
      q M' hqM' ℓg hℓgM' ↥k₀ ξ hξ hιξ H₁ hH₁ Kℓ hKℓ
  have hfaith := ModularCurve.FullLevel.intCast_apply_eq_one_of_isLevelAutAt_one_of_eq_levelH_inf_ker
      q hq2 M' hqM' ℓg hℓgM' ↥k₀ ξ hξ hιξ H₁ hH₁ Kℓ hKℓ

  have hdet : ∀ γ γ' : SL(2, ℤ), γ ∈ CongruenceSubgroup.Gamma q → γ ∈ CongruenceSubgroup.Gamma0 M' →
      γ' ∈ CongruenceSubgroup.Gamma q → γ' ∈ CongruenceSubgroup.Gamma0 M' →
      ∀ τ τ' : ↥Kℓ ≃ₐ[↥k₀] ↥Kℓ, ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ γ⁻¹ Kℓ τ → ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ γ'⁻¹ Kℓ τ' →
      ((γ 1 1 : ℤ) : ZMod ℓg) = ((γ' 1 1 : ℤ) : ZMod ℓg) → τ = τ' := by
    intro γ γ' hγq hγ0 hγ'q hγ'0 τ τ' hτ hτ' hd

    have hδq : γ'⁻¹ * γ ∈ CongruenceSubgroup.Gamma q := Subgroup.mul_mem _ (Subgroup.inv_mem _ hγ'q) hγq
    have hδ0 : γ'⁻¹ * γ ∈ CongruenceSubgroup.Gamma0 M' := Subgroup.mul_mem _ (Subgroup.inv_mem _ hγ'0) hγ0
    have hδd : (((γ'⁻¹ * γ) 1 1 : ℤ) : ZMod ℓg) = 1 := by
      rw [StabH1.mul_11_mod hℓgM' (Subgroup.inv_mem _ hγ'0), hd, StabH1.inv_11_mod hℓgM' hγ'0]
    have h1 : ModularCurve.FullLevel.IsLevelAutAt ↥k₀ q ξ q (q ^ 2 * M') H₁ (γ'⁻¹ * γ) Kℓ 1 := hone _ hδq hδ0 hδd
    have h2 := hmul γ⁻¹ (γ'⁻¹ * γ) (Subgroup.inv_mem _ hγ0) hδ0 τ 1 hτ h1
    rw [mul_one, mul_inv_cancel_right] at h2
    exact huniq γ'⁻¹ (Subgroup.inv_mem _ hγ'0) τ τ' h2 hτ'

  obtain ⟨γm, hγmq, hγm0, hγmd⟩ :=
    CongruenceSubgroup.exists_mem_Gamma_mem_Gamma0_intCast_apply_eq_of_coprime_of_dvd q M' hcop ℓg hℓgM' (-1)
  obtain ⟨τm, hτm⟩ := hexist γm hγm0
  have hγmd' : ((γm 1 1 : ℤ) : ZMod ℓg) = -1 := by rw [hγmd]; simp
  have hτmne : τm ≠ 1 := by
    intro h
    rw [h] at hτm
    have h1 := hfaith γm⁻¹ (Subgroup.inv_mem _ hγmq) (Subgroup.inv_mem _ hγm0) hτm
    have h2 := StabH1.inv_11_mod hℓgM' hγm0
    rw [h1, hγmd', one_mul] at h2

    have h3 : ((2 : ℕ) : ZMod ℓg) = 0 := by
      have : (1 : ZMod ℓg) + 1 = 0 := by
        calc (1 : ZMod ℓg) + 1 = -1 + 1 := by rw [h2]
          _ = 0 := neg_add_cancel 1
      exact_mod_cast this
    rw [ZMod.natCast_eq_zero_iff] at h3
    have := Nat.le_of_dvd (by norm_num) h3
    omega

  haveI hκac : IsAlgClosed (ResidueField ↥A) := ValuationSubring.isAlgClosed_residueField_algebraicClosure_rat A
  haveI hκch : CharP (ResidueField ↥A) q := by
    have hq' : ((q : ↥A) : AlgebraicClosure ℚ) = (q : AlgebraicClosure ℚ) := by norm_cast
    have hmem : (q : ↥A) ∈ maximalIdeal ↥A := by
      rw [← ValuationSubring.coe_mem_nonunits_iff, hq']; exact hA
    have h0 : ((q : ℕ) : ResidueField ↥A) = 0 := by
      rw [← map_natCast (IsLocalRing.residue ↥A), IsLocalRing.residue_eq_zero_iff]; exact hmem
    exact (CharP.charP_iff_prime_eq_zero hqp).mpr h0
  have hsW : (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) ∈ ssPlaces q M' (ResidueField ↥A) := (hW _).mp s.2
  have hw := ModularCurve.two_mul_placeWidthChar_eq_natCard_rationalAut_map_eq_of_toValuationSubring_eq_comap_moduliPlace_of_prime q M' hqM'
    E Cyc hcyc hcardCyc (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) hP
  have hpwc := ModularCurve.placeWidthChar_eq_one_of_mem_ssPlaces_of_eq_three_of_dvd hq3 (K := ResidueField ↥A) hqM' ℓg hℓg hℓg12 hℓgM' hsW
  rw [hpwc, mul_one] at hw
  rw [← hw]

  obtain ⟨𝒢, 𝒯, h𝒢, h𝒢O, h𝒯, hVC, hCO⟩ :=
    WeierstrassCurve.DrinfeldGlobal.exists_groupLaws_levelTransport_isChordTangent_isOriginIdentity_isSectionTransport ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) q
  have hℓT : ∀ (T : Type) [CommRing T] [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
      (D : ModularCurve.LevelPData T), ModularCurve.IsGamma1Point W ℓg D →
        ModularCurve.IsGamma1Point (C • W) ℓg (D.variableChange C) :=
    fun T _ _ W C D h => StabH1.isGamma1Point_variableChange h C
  have hMT : ∀ (T : Type) [CommRing T] [Algebra ↥(A.comap (algebraMap ↥k₀ (AlgebraicClosure ℚ))) T] (W : WeierstrassCurve T) (C : WeierstrassCurve.VariableChange T)
