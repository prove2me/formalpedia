/-!
# A lines, IL side 5: the run of the `A` kernel

**`aK_runs`**: on the managed state with the kernel table `aKTab …` on `dT`, the row
`gflat x ++ l` on stack `0` and every other stack empty, `aKprog pM` leaves
`gflat (aKerL w2 bk win Q aTab rTab cTab x) ++ l` on stack `0` and everything else as it was,
at cost `cAK …`. The entry bounds: `|x| ≤ X0`, `|aTab| ≤ 2^Q Ka`, `|rTab| ≤ 2^Q Kr`,
`|cTab| ≤ 2^Q Kc`, and every stage value `≤ 2^pk`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.KR.AK

open IntMul NLogN NLogN.KIL NLogN.KFD NLogN.KFB NLogN.KFV

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

lemma AB_padG {X : ℤ} (hX : 0 ≤ X) {r : ℕ} {y : List GI} (h : AB X y) : AB X (J6Seg.padG r y) := by
  intro w hw
  rcases List.mem_append.1 hw with hw | hw
  · exact h w hw
