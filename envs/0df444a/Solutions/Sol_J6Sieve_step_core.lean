    |(((Ioc A (A + H)).filter (d ∣ ·)).card : ℝ) - (H : ℝ) / d| ≤ 1 := by
  rw [count_mul]
  have hab : A / d ≤ (A + H) / d := Nat.div_le_div_right (by omega)
  have h1 := Nat.div_add_mod (A + H) d
  have h2 := Nat.mod_lt (A + H) hd
  have h3 := Nat.div_add_mod A d
  have h4 := Nat.mod_lt A hd
  set b := (A + H) / d
  set a := A / d
  set r := (A + H) % d
  set s := A % d
  have hdR : (0:ℝ) < d := by exact_mod_cast hd
  have key : (H : ℝ) = d * ((b : ℝ) - a) + (r - s) := by
    have : (A : ℝ) + H = d * b + r := by exact_mod_cast h1.symm
    have : (A : ℝ) = d * a + s := by exact_mod_cast h3.symm
    linarith
  have hr : (r : ℝ) < d := by exact_mod_cast h2
  have hs : (s : ℝ) < d := by exact_mod_cast h4
  have hr0 : (0:ℝ) ≤ r := by positivity
  have hs0 : (0:ℝ) ≤ s := by positivity
  rw [Nat.cast_sub hab, key, abs_le]
  constructor
  · rw [le_sub_iff_add_le, add_div, mul_div_cancel_left₀ _ hdR.ne']
    have : (r - s : ℝ) / d ≤ 1 := by rw [div_le_one hdR]; linarith
    linarith
