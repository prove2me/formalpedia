section Inertia

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

theorem mem_inertiaSubgroupIn_iff {A : ValuationSubring L} {σ : L ≃ₐ[K] L} :
    σ ∈ A.inertiaSubgroupIn K ↔
      ∃ h : σ ∈ A.decompositionSubgroup K, (⟨σ, h⟩ : A.decompositionSubgroup K) ∈ A.inertiaSubgroup K := by
  constructor
  · rintro ⟨⟨τ, hτ⟩, hτI, rfl⟩
    exact ⟨hτ, hτI⟩
  · rintro ⟨h, hI⟩
    exact ⟨⟨σ, h⟩, hI, rfl⟩

theorem apply_mem_iff {A : ValuationSubring L} {σ : L ≃ₐ[K] L}
    (hσ : σ ∈ A.decompositionSubgroup K) (x : L) : σ x ∈ A ↔ x ∈ A := by
  have hσ' : σ⁻¹ • A = A :=
    MulAction.mem_stabilizer_iff.mp ((A.decompositionSubgroup K).inv_mem hσ)
  calc σ x ∈ A ↔ σ • x ∈ A := Iff.rfl
    _ ↔ x ∈ σ⁻¹ • A := by rw [ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem, inv_inv]
    _ ↔ x ∈ A := by rw [hσ']

theorem residue_apply_eq {A : ValuationSubring L} {σ : L ≃ₐ[K] L} (hσ : σ ∈ A.inertiaSubgroupIn K)
    {x : L} (hx : x ∈ A) :
    IsLocalRing.residue A ⟨σ x, (apply_mem_iff (mem_inertiaSubgroupIn_iff.mp hσ).1 x).mpr hx⟩ =
      IsLocalRing.residue A ⟨x, hx⟩ := by
  obtain ⟨hd, hI⟩ := mem_inertiaSubgroupIn_iff.mp hσ
  set a : A := ⟨x, hx⟩
  set g : A.decompositionSubgroup K := ⟨σ, hd⟩
  have hker : MulSemiringAction.toRingAut (A.decompositionSubgroup K)
      (IsLocalRing.ResidueField A) g = 1 := MonoidHom.mem_ker.mp hI
  have happ : (MulSemiringAction.toRingAut (A.decompositionSubgroup K)
      (IsLocalRing.ResidueField A) g) (IsLocalRing.residue A a)
      = g • (IsLocalRing.residue A a) := rfl
  have hres : IsLocalRing.residue A (g • a) = IsLocalRing.residue A a := by
    rw [IsLocalRing.ResidueField.residue_smul, ← happ, hker]
    rfl
  have hcoe : (g • a : A) = ⟨σ x, (apply_mem_iff hd x).mpr hx⟩ := Subtype.ext rfl
  rw [← hcoe]
  exact hres

end Inertia

section Comap

variable {F : Type*} [Field F]

def comapEquiv (e : F ≃+* F) (O : ValuationSubring F) : ↥(O.comap e.toRingHom) ≃+* ↥O where
  toFun x := ⟨e x, x.2⟩
  invFun y := ⟨e.symm y, by
    show e.toRingHom (e.symm y) ∈ O
    rw [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply]
    exact y.2⟩
  left_inv x := Subtype.ext (e.symm_apply_apply x)
  right_inv y := Subtype.ext (e.apply_symm_apply y)
  map_mul' x y := Subtype.ext (map_mul e (x : F) (y : F))
  map_add' x y := Subtype.ext (map_add e (x : F) (y : F))

@[scoped simp] theorem coe_comapEquiv_apply (e : F ≃+* F) (O : ValuationSubring F) (x : ↥(O.comap e.toRingHom)) :
    ((comapEquiv e O x : ↥O) : F) = e x := rfl

theorem isUnit_comap_iff (e : F ≃+* F) (O : ValuationSubring F) (x : ↥(O.comap e.toRingHom)) :
    IsUnit x ↔ IsUnit (comapEquiv e O x) :=
  ⟨fun h => h.map (comapEquiv e O), fun h => by
    have h2 := h.map (comapEquiv e O).symm
    rwa [RingEquiv.symm_apply_apply] at h2⟩

theorem mem_maximalIdeal_comap_iff (e : F ≃+* F) (O : ValuationSubring F) (x : ↥(O.comap e.toRingHom)) :
    x ∈ maximalIdeal ↥(O.comap e.toRingHom) ↔ comapEquiv e O x ∈ maximalIdeal ↥O := by
  rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, mem_nonunits_iff,
    isUnit_comap_iff]

theorem mem_comap_equiv_iff (e : F ≃+* F) (O : ValuationSubring F) (x : F) :
    x ∈ O.comap e.toRingHom ↔ e x ∈ O :=
  Iff.rfl

theorem algEquiv_toRingHom_apply {K : Type*} [Field K] [Algebra K F] (e : F ≃ₐ[K] F) (x : F) :
    e.toAlgHom.toRingHom x = e x :=
  rfl

end Comap

section GenericPins

variable {K F : Type*} [Field K] [Field F] [Algebra K F] (A : ValuationSubring K) (O : ValuationSubring F)
  (g : SemilinearAut K F)

theorem smul_eq_toRingAut (f : F) : g • f = SemilinearAut.toRingAut g f := rfl

theorem pinA (hgA : ∀ x : K, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hO : ∀ x : K, algebraMap K F x ∈ O ↔ x ∈ A) :
    ∀ x : K, algebraMap K F x ∈ O.comap (SemilinearAut.toRingAut g).toRingHom ↔ x ∈ A := by
  intro x
  rw [mem_comap_equiv_iff, ← smul_eq_toRingAut, SemilinearAut.smul_algebraMap, hO]
  exact hgA x

theorem pinII (hgA : ∀ x : K, SemilinearAut.baseAut g x ∈ A ↔ x ∈ A)
    (hO : ∃ t : F, t ∈ O ∧ ∀ a : A, ∃ h : t - algebraMap K F (a : K) ∈ O, IsUnit (⟨_, h⟩ : O)) :
    ∃ t : F, t ∈ O.comap (SemilinearAut.toRingAut g).toRingHom ∧
      ∀ a : A, ∃ h : t - algebraMap K F (a : K) ∈ O.comap (SemilinearAut.toRingAut g).toRingHom,
        IsUnit (⟨_, h⟩ : ↥(O.comap (SemilinearAut.toRingAut g).toRingHom)) := by
  obtain ⟨t, ht, htu⟩ := hO
  let e : F ≃+* F := SemilinearAut.toRingAut g
  refine ⟨e.symm t, ?_, ?_⟩
  · rw [mem_comap_equiv_iff, RingEquiv.apply_symm_apply]
    exact ht
  · intro a
    obtain ⟨h1, h2⟩ := htu ⟨SemilinearAut.baseAut g (a : K), (hgA a).mpr a.2⟩
    have hval : e (e.symm t - algebraMap K F (a : K)) = t - algebraMap K F (SemilinearAut.baseAut g (a : K)) := by
      rw [map_sub, RingEquiv.apply_symm_apply, ← smul_eq_toRingAut, SemilinearAut.smul_algebraMap]
    have hm : e.symm t - algebraMap K F (a : K) ∈ O.comap e.toRingHom := by
      rw [mem_comap_equiv_iff, hval]
      exact h1
    refine ⟨hm, ?_⟩
    rw [isUnit_comap_iff]
    have hx : comapEquiv e O ⟨_, hm⟩ = ⟨_, h1⟩ := Subtype.ext hval
    rw [hx]
    exact h2

theorem ord_nonneg_smul_of_fixed (j f : F) (hj : g • j = j)
    (h : ∀ P : Place K F, 0 ≤ P.ord j → 0 ≤ P.ord f) :
    ∀ P : Place K F, 0 ≤ P.ord j → 0 ≤ P.ord (g • f) := by
  intro P hP
  have e1 : P.ord (g • f) = (g⁻¹ • P).ord f := by
    have := AlgebraicCurve.SemilinearAut.ord_smul g (g⁻¹ • P) f
    rwa [smul_inv_smul] at this
  have e2 : P.ord j = (g⁻¹ • P).ord j := by
    have := AlgebraicCurve.SemilinearAut.ord_smul g (g⁻¹ • P) j
    rwa [smul_inv_smul, hj] at this
  rw [e1]
  exact h _ (e2 ▸ hP)

end GenericPins

section Modular

variable (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']

local notation "Lbar" => AlgebraicClosure ℚ
local notation "GG" => ModularCurve.arithmeticGalois (xHFunctionField (q ^ 2 * M') (levelH q M'))
local notation "G₀" => ModularCurve.arithmeticGalois (modularFunctionFieldFull M')

theorem smul_inclusion (hle : modularFunctionFieldBar M' ≤ fieldBar q M') (τ : Lbar ≃ₐ[ℚ] Lbar)
    (f : ↥(modularFunctionFieldBar M')) :
    GG τ • (IntermediateField.inclusion hle f : fieldBar q M') = IntermediateField.inclusion hle (G₀ τ • f) := by
  apply Subtype.ext
  rw [IntermediateField.coe_inclusion, ModularCurve.coe_arithmeticGalois_smul, ModularCurve.coe_arithmeticGalois_smul,
    IntermediateField.coe_inclusion]

theorem smul_algebraMap_fieldBar (τ : Lbar ≃ₐ[ℚ] Lbar) (x : Lbar) :
    GG τ • algebraMap Lbar ↥(fieldBar q M') x = algebraMap Lbar ↥(fieldBar q M') (τ x) := by
  rw [SemilinearAut.smul_algebraMap, ModularCurve.baseAut_arithmeticGalois]
  rfl

theorem smul_jHat (τ : Lbar ≃ₐ[ℚ] Lbar) :
    G₀ τ • (⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) =
      ⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ := by
  apply Subtype.ext
  rw [ModularCurve.coe_arithmeticGalois_smul]
  exact coeffMap_coeffEmb τ jq

theorem smul_levelAutBar_apply (hqM' : ¬ q ∣ M') (τ : Lbar ≃ₐ[ℚ] Lbar) (ζ : Idx q) (γ : SL(2, ℤ)) (hγ : γ ∈ Gamma0 M')
    (f : fieldBar q M') :
    GG τ • (levelAutBar q M' ζ γ f) = levelAutBar q M' (τ • ζ) γ (GG τ • f) := by
  have h := ModularCurve.FullLevel.arithmeticGalois_mul_ofAlgAut_levelAutBar_inv_smul q M' hqM' τ (τ • ζ) γ hγ
  rw [inv_smul_smul] at h
  have h2 := congrArg (fun s : SemilinearAut Lbar ↥(fieldBar q M') => s • f) h
  simp only [mul_smul, SemilinearAut.ofAlgAut_smul] at h2
  exact h2

def gS (τ : Lbar ≃ₐ[ℚ] Lbar) : SemilinearAut Lbar ↥(fieldBar q M') := GG τ

theorem gS_smul (τ : Lbar ≃ₐ[ℚ] Lbar) (f : fieldBar q M') : gS q M' τ • f = GG τ • f := rfl

theorem smul_inclusion_gS (hle : modularFunctionFieldBar M' ≤ fieldBar q M') (τ : Lbar ≃ₐ[ℚ] Lbar)
    (f : ↥(modularFunctionFieldBar M')) :
    gS q M' τ • (IntermediateField.inclusion hle f : fieldBar q M') = IntermediateField.inclusion hle (G₀ τ • f) := by
  rw [gS_smul]
  exact smul_inclusion q M' hle τ f

theorem smul_algebraMap_gS (τ : Lbar ≃ₐ[ℚ] Lbar) (x : Lbar) :
    gS q M' τ • algebraMap Lbar ↥(fieldBar q M') x = algebraMap Lbar ↥(fieldBar q M') (τ x) := by
  rw [gS_smul]
  exact smul_algebraMap_fieldBar q M' τ x

theorem toRingAut_gS_algebraMap (τ : Lbar ≃ₐ[ℚ] Lbar) (x : Lbar) :
    SemilinearAut.toRingAut (gS q M' τ) (algebraMap Lbar ↥(fieldBar q M') x) = algebraMap Lbar ↥(fieldBar q M') (τ x) :=
  (smul_eq_toRingAut (gS q M' τ) _).symm.trans (smul_algebraMap_gS q M' τ x)

theorem baseAut_gS_apply (τ : Lbar ≃ₐ[ℚ] Lbar) (x : Lbar) : SemilinearAut.baseAut (gS q M' τ) x = τ x := rfl

theorem smul_levelAutBar_apply_gS (hqM' : ¬ q ∣ M') (τ : Lbar ≃ₐ[ℚ] Lbar) (ζ : Idx q) (γ : SL(2, ℤ))
    (hγ : γ ∈ Gamma0 M') (f : fieldBar q M') :
    gS q M' τ • (levelAutBar q M' ζ γ f) = levelAutBar q M' (τ • ζ) γ (gS q M' τ • f) := by
  rw [gS_smul, gS_smul]
  exact smul_levelAutBar_apply q M' hqM' τ ζ γ hγ f

theorem pinFix (hqM' : ¬ q ∣ M') (τ : Lbar ≃ₐ[ℚ] Lbar) (O : ValuationSubring ↥(fieldBar q M'))
    (hO : ∀ (ζ : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' → O.comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom = O) :
    ∀ (ζ : Idx q) (γ : SL(2, ℤ)), γ ∈ Gamma0 M' →
      (O.comap (SemilinearAut.toRingAut (gS q M' τ)).toRingHom).comap (levelAutBar q M' ζ γ).toAlgHom.toRingHom =
        O.comap (SemilinearAut.toRingAut (gS q M' τ)).toRingHom := by
  intro ζ' γ hγ
  ext x
  rw [ValuationSubring.mem_comap, mem_comap_equiv_iff, mem_comap_equiv_iff, algEquiv_toRingHom_apply,
    ← smul_eq_toRingAut (gS q M' τ), ← smul_eq_toRingAut (gS q M' τ), smul_levelAutBar_apply_gS q M' hqM' τ ζ' γ hγ x]
  have hfix := SetLike.ext_iff.mp (hO (τ • ζ') γ hγ) (gS q M' τ • x)
  rw [ValuationSubring.mem_comap, algEquiv_toRingHom_apply] at hfix
  exact hfix

