variable {R : Type*} [CommRing R] {Mx My Ms : Type*} [AddCommGroup Mx] [AddCommGroup My]
  [AddCommGroup Ms] [Module R Mx] [Module R My] [Module R Ms]

theorem IntMul.Kappa.R6.Bit.word_dirty (hy : ∀ z : My, z + z = 0) (hs : ∀ z : Ms, z + z = 0)
    (A A' : Ms →ₗ[R] Ms) (hA : ∀ z, A' (A z) = z) (B : Ms →ₗ[R] My) (C : Mx →ₗ[R] Ms)
    (x : Mx) (y : My) (s : Ms) :
    let s1 := A s
    let y1 := y + B s1
    let s2 := A' s1
    let s3 := s2 + C x
    let s4 := A s3
    let y2 := y1 + B s4
    let s5 := A' s4
    let s6 := s5 + C x
    s6 = s ∧ y2 = y + B (A (C x)) := by sorry
