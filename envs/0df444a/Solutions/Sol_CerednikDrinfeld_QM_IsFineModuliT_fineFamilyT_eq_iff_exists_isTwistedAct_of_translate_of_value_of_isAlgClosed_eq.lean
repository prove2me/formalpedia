theorem idem_field {k : Type} [Field k] (x : k) (h : IsIdempotentElem x) : x = 0 ∨ x = 1 := by
  have hx : x * (x - 1) = 0 := by rw [mul_sub, mul_one, h.eq, sub_self]
  rcases mul_eq_zero.mp hx with h0 | h1
  · exact Or.inl h0
  · exact Or.inr (sub_eq_zero.mp h1)

theorem isUnit_natCast_of_ne {r : ℕ} [hr : Fact r.Prime] {𝒪 : Type} [CommRing 𝒪] (π : 𝒪)
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    (k : Type) [Field k] [Algebra 𝒪 k] (hk : IsNilpotent (algebraMap 𝒪 k π))
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓr : ℓ ≠ r) : IsUnit ((ℓ : ℕ) : k) := by
  have hπ : algebraMap 𝒪 k π = 0 := hk.eq_zero
  have hrk : ((r : ℕ) : k) = 0 := by
    have hmem : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := by
      rw [← hunr]; exact Ideal.mem_span_singleton_self _
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
    have h2 := congrArg (algebraMap 𝒪 k) hc
    rwa [map_mul, hπ, mul_zero, map_natCast, eq_comm] at h2
  rw [isUnit_iff_ne_zero]
  intro hℓk
  have hcop : IsCoprime ((ℓ : ℤ) : k) ((r : ℤ) : k) :=
    (Nat.isCoprime_iff_coprime.mpr ((Nat.coprime_primes hℓ hr.out).mpr hℓr)).intCast
  rw [Int.cast_natCast, Int.cast_natCast, hℓk, hrk] at hcop
  exact not_isCoprime_zero_zero hcop

end TFSol

