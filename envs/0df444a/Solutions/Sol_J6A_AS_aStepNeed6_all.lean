  unfold J6A.FS.cFsD; omega

/-! ## The copy step -/

theorem cDupP_le (W n Bb : ℕ) :
    J6A.DP.cDupP W n Bb ≤ 10 ^ 8 * (n + 1) * (Bb + 2) + 10 ^ 15 * (W + 2) ^ 2 := by
