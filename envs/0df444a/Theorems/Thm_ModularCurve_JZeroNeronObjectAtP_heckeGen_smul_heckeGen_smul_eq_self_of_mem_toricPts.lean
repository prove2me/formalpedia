open ModularCurve ModularCurve.JZeroNeronObjectAtP

theorem ModularCurve.JZeroNeronObjectAtP.heckeGen_smul_heckeGen_smul_eq_self_of_mem_toricPts
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p)
    (Λ : JZeroNeronObjectAtP.LevelData N₀ p A) (hΛ : Λ.IsJacobian)
    (O : JZeroNeronObjectAtP N₀ p hpN₀ A hA Λ) :
    letI := heckeModuleBar (N₀ * p)
    ∀ (m : ℕ), 0 < m → ∀ x ∈ O.toricPts m,
      (heckeGen ⟨p, Fact.out⟩ : HeckeAlg) • ((heckeGen ⟨p, Fact.out⟩ : HeckeAlg) • x) = x := by sorry
