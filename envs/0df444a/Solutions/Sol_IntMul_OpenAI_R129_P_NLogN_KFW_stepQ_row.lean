theorem pf_swap {W : ℕ} (a b : Fin W) (w : ℕ) : pf (Equiv.swap a b) w = nsw a.val b.val w := by
  unfold pf nsw
  by_cases hw : w < W
  · rw [dif_pos hw]
    by_cases e1 : w = a.val
    · have : (⟨w, hw⟩ : Fin W) = a := Fin.ext e1
      rw [this, Equiv.swap_apply_left, if_pos e1]
    · by_cases e2 : w = b.val
      · have : (⟨w, hw⟩ : Fin W) = b := Fin.ext e2
