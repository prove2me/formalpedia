  have hST := NLogN.KFM.sCmp_le_T hn hD
  have hVT : AModel.vol (NLogN.KFU.shR (IntMul.OpenAI.Glue.dP n) (NLogN.KFU.tP (IntMul.OpenAI.Glue.dP n) (IntMul.OpenAI.Glue.ℓP n - 1) (NLogN.KFM.bLn n))) = 2 * IntMul.OpenAI.Glue.TP n := by
