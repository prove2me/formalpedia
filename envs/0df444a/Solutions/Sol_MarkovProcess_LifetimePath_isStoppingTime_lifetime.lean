/-!
# Canonical filtration of lifetime paths

The raw canonical filtration is generated by the cemetery-valued coordinates up to each time.
The lifetime is a stopping time because death by time `t` is exactly the event that the time-`t`
coordinate is the cemetery state.
-/

open MeasureTheory
open scoped ENNReal


variable {alpha : Type*} [TopologicalSpace alpha] [MeasurableSpace alpha]









namespace MarkovProcess.LifetimePath

end MarkovProcess.LifetimePath
open MarkovProcess.LifetimePath
theorem solution :
    IsStoppingTime (canonicalFiltration (alpha := alpha))
      (lifetime : LifetimePath alpha → ENNReal) := by
  intro t
  have hdelta : MeasurableSet ({Cemetery.delta} : Set (Cemetery alpha)) := by
    simpa only [Set.range_unique] using
      (measurableSet_range_inr :
        MeasurableSet (Set.range (Sum.inr : Unit → alpha ⊕ Unit)))
  have hevent : {omega : LifetimePath alpha | omega.lifetime ≤ (t : ENNReal)} =
      coordinate (α := alpha) t ⁻¹' {Cemetery.delta} := by
    ext omega
    simpa only [Set.mem_ofPred_eq, Set.mem_preimage, Set.mem_singleton_iff] using
      (coordinate_eq_delta_iff omega t).symm
  show MeasurableSet[canonicalFiltration (alpha := alpha) t]
    {omega : LifetimePath alpha | omega.lifetime ≤ (t : ENNReal)}
  rw [hevent]
  exact (measurable_coordinate_canonicalFiltration t) hdelta
