  let f : (n : ℕ) → TypeDensity.TwoSeries O' →+* S ⧸ I ^ n := fun n ↦
    TypeDensity.nilpotentEval ((Ideal.Quotient.mk (I ^ n)).comp κ) (Ideal.Quotient.mk (I ^ n) e)
      (Ideal.Quotient.mk (I ^ n) z) (nil n e he) (nil n z hz)
  have hgen := fun n ↦ TypeDensity.nilpotentEval_apply_generators O' (S ⧸ I ^ n)
      ((Ideal.Quotient.mk (I ^ n)).comp κ) (Ideal.Quotient.mk (I ^ n) e)
      (Ideal.Quotient.mk (I ^ n) z) (nil n e he) (nil n z hz)
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
    intro m n hle
    obtain ⟨hC, hT, hX⟩ := hgen n
