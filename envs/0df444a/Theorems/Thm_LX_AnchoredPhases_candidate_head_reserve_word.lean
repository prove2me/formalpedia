variable {n : ℕ} [NeZero n]

theorem LX.AnchoredPhases.candidate_head_reserve_word (hn : 2 ≤ n) (p : State n) (a : Fin n)
    (hh : 0 < height p a) :
    ∃ v : List Letter, p*eval v=1 ∧
      (v.length : ℤ) ≤ (height p a : ℤ)*(n-height p a-1)+
        (height p a+2)*(n-1)-height p a := by sorry
