section steps
variable {s : IState HS}

theorem sp_pushL (f : Fin HS → List ℤ) {i : Fin HS} (c : ℤ) {B : ℕ} (hi : i.val < 56)
    (hc : zsz c ≤ B) :
    Sp (.push i (.lit c)) (encK s f) (encK s (Function.update f i (c :: f i))) (4000 * (B + 2)) := by
  have h := Sp.push s f (i := i) (e := .lit c) (B := B) hi (clean_lit c) trivial trivial hc
  exact h.mono (by simp only [Ex.size]; omega)

theorem sp_pop (f : Fin HS → List ℤ) {i : Fin HS} {a : ℤ} {l : List ℤ} {B : ℕ}
    (hi : i.val < 56) (hf : f i = a :: l) (ha : zsz a ≤ B) :
    Sp (.pop i) (encK s f) (encK s (Function.update f i l)) (2 * B + 2) := Sp.pop s f hi hf ha

end steps

/-! ## Moving pairs -/

/-! ## Zeros, drops, duplicating moves -/

theorem sp_zeroR {Y C R : Fin HS} (hYC : Y ≠ C) (hRC : R ≠ C) (hRY : R ≠ Y) (hY5 : Y.val < 56)
    (hC5 : C.val < 56) (hR5 : R.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (N : ℕ)
    (lr : List ℤ) (hC : f C = []) (hR : f R = (N : ℤ) :: lr) (B : ℕ) (hn : zsz (N : ℤ) ≤ B) :
    Sp (zeroR Y C R) (encK s f) (encK s (Function.update f Y (List.replicate N 0 ++ f Y)))
      (cMvP N B) := by
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update f Y (List.replicate k 0 ++ f Y)
  have hF0 : F 0 = f := by funext j; simp only [F, Function.update_apply]; split_ifs with h <;> simp [h]
  have hFC : ∀ k, F k C = [] := fun k => by simp only [F, Function.update_apply, if_neg hYC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (.push Y (.lit 0)) (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (30000 * (B + 2)) := by
    intro k hk
    refine ((sp_pushL (s := s) _ 0 (B := B) hY5 (by simp [zsz_zero])).congr ?_).mono (by omega)
    congr 1; funext j
    simp only [F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hYC.symm]
    by_cases h2 : j = Y
    · subst h2; simp [hYC, List.replicate_succ]
    · simp [h1, h2]
  have H := Sp.rep (C := C) (n := .reg R) (b := .push Y (.lit 0)) (s := s) (F := F) (N := N) (B := B)
    (c := 30000 * (B + 2)) hC5 hFC (by simp [RS.writes, hYC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0] at H
  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

theorem sp_dropR {X C R : Fin HS} (hXC : X ≠ C) (hRC : R ≠ C) (hRX : R ≠ X) (hX5 : X.val < 56)
    (hC5 : C.val < 56) (hR5 : R.val < 56) (s : IState HS) (f : Fin HS → List ℤ) (L lx lr : List ℤ)
    (hX : f X = L ++ lx) (hC : f C = []) (hR : f R = (L.length : ℤ) :: lr) (B : ℕ)
    (hL : Bnd B L) (hn : zsz (L.length : ℤ) ≤ B) :
    Sp (dropR X C R) (encK s f) (encK s (Function.update f X lx)) (cMvP L.length B) := by
  set N := L.length with hN
  let F : ℕ → Fin HS → List ℤ := fun k => Function.update f X (L.drop k ++ lx)
  have hF0 : F 0 = f := by
    funext j; simp only [F, Function.update_apply, List.drop_zero]; split_ifs with h <;> simp [h, hX]
  have hFN : F N = Function.update f X lx := by simp only [F, hN, List.drop_length, List.nil_append]
  have hFC : ∀ k, F k C = [] := fun k => by simp only [F, Function.update_apply, if_neg hXC.symm, hC]
  have hFR : F 0 R = (N : ℤ) :: lr := by rw [hF0, hR]
  have hbody : ∀ k < N, Sp (.pop X) (encK s (Function.update (F k) C [(N : ℤ) - k]))
      (encK s (Function.update (F (k + 1)) C [(N : ℤ) - k])) (30000 * (B + 2)) := by
    intro k hk
    have hd : L.drop k = L[k] :: L.drop (k + 1) := List.drop_eq_getElem_cons hk
    refine ((sp_pop (s := s) _ (i := X) (a := L[k]) (l := L.drop (k + 1) ++ lx) hX5
      (by simp only [F, Function.update_apply, if_neg hXC, if_true, hd, List.cons_append])
      (hL _ (List.getElem_mem hk))).congr ?_).mono (by omega)
    congr 1; funext j
    simp only [F, Function.update_apply]
    by_cases h1 : j = C
    · subst h1; simp [hXC.symm]
    by_cases h2 : j = X
    · subst h2; simp [hXC]
    · simp [h1, h2]
  have H := Sp.rep (C := C) (n := .reg R) (b := .pop X) (s := s) (F := F) (N := N) (B := B)
    (c := 30000 * (B + 2)) hC5 hFC (by simp [RS.writes, hXC.symm]) (clean_reg hR5) (ok_reg hFR)
    trivial (bnd_reg hFR hn) (by rw [eval_reg hFR]) hbody
  rw [hF0, hFN] at H
  refine H.mono ?_
  unfold cMvP; simp only [Ex.size]; nlinarith

