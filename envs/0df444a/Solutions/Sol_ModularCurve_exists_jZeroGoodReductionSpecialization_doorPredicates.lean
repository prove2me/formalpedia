theorem separable_map_ratFunc_of_ringHom {k L : Type*} [Field k] [Field L] (e : k →+* L)
    (Φ : Polynomial (Polynomial ℤ))
    (h : ((Φ.map (Polynomial.mapRingHom (Int.castRingHom L))).map
      (algebraMap (Polynomial L) (RatFunc L))).Separable) :
    ((Φ.map (Polynomial.mapRingHom (Int.castRingHom k))).map
      (algebraMap (Polynomial k) (RatFunc k))).Separable := by
  classical
  have hφ : (Polynomial k)⁰ ≤ (Polynomial L)⁰.comap (Polynomial.mapRingHom e) := by
    intro p hp
    simp only [Submonoid.mem_comap, mem_nonZeroDivisors_iff_ne_zero, Polynomial.coe_mapRingHom] at hp ⊢
    exact (Polynomial.map_ne_zero_iff e.injective).mpr hp
  let ψ : RatFunc k →+* RatFunc L := RatFunc.mapRingHom (Polynomial.mapRingHom e) hφ
  have hψ : ∀ p : Polynomial k, ψ (algebraMap _ (RatFunc k) p) = algebraMap _ (RatFunc L) (p.map e) := by
    intro p
    show (RatFunc.mapRingHom (Polynomial.mapRingHom e) hφ : RatFunc k → RatFunc L) (algebraMap _ _ p) = _
    rw [RatFunc.coe_mapRingHom_eq_coe_map]
    have := RatFunc.map_apply_div (Polynomial.mapRingHom e) hφ p 1
    simpa using this
  have hcomp : (ψ.comp (algebraMap (Polynomial k) (RatFunc k))).comp (Polynomial.mapRingHom (Int.castRingHom k))
      = (algebraMap (Polynomial L) (RatFunc L)).comp (Polynomial.mapRingHom (Int.castRingHom L)) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp only [eq_intCast, map_intCast]
    · simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_X, hψ]
  rw [← Polynomial.separable_map ψ, Polynomial.map_map, Polynomial.map_map, hcomp, ← Polynomial.map_map]
  exact h

