def posTerm (j : ℕ) : ℕ × ℕ := (posTerms.getD (j / 24) []).getD (j % 24) (0, 0)

def termShape (j p : ℕ) : ℕ := (seedTerm (posTerm j).1 (posTerm j).2).shape.getD p 0

def termGalpha (j : ℕ) : ℕ := galphaAt (posTerm j).1 (posTerm j).2

def termRegion (j ρ : ℕ) : ℕ := (seedTerm (posTerm j).1 (posTerm j).2).region.getD ρ 0

/-- Split probability numerator (over `denominator`) of the left-half physical shape `c`. -/
def termAlpha (j ρ : ℕ) (c : List ℕ) : ℕ :=
  ((seedTerm (posTerm j).1 (posTerm j).2).alpha.getD ρ []).getD
    ((seedTerm (posTerm j).1 (posTerm j).2).splits.idxOf c) 0

/-- Level-2 split parameter numerator of the child with physical shape `c` in region `ρ`. -/
def termS0 (j ρ : ℕ) (c : List ℕ) : ℕ :=
  match (seedTerm (posTerm j).1 (posTerm j).2).children.find? (fun x ↦ x.1 = ρ ∧ x.2.1 = c) with
  | some x => x.2.2
  | none => 0

def elementary : List (List ℕ) := [[0, 0, 2], [0, 1, 1], [0, 2, 0], [1, 0, 1], [1, 1, 0], [2, 0, 0]]

def listSub (a e : List ℕ) : List ℕ := [a.getD 0 0 - e.getD 0 0, a.getD 1 0 - e.getD 1 0, a.getD 2 0 - e.getD 2 0]

/-- Joint weight (over `denominator`) of the level-1 split `e, a - e` of a level-2 shape `a`. -/
def jointWeight (a : List ℕ) (s0 : ℕ) (e : List ℕ) : ℕ :=
  if e ∈ elementary ∧ e.getD 0 0 ≤ a.getD 0 0 ∧ e.getD 1 0 ≤ a.getD 1 0 ∧ e.getD 2 0 ≤ a.getD 2 0 ∧
      listSub a e ∈ elementary then
    if a.getD 0 0 = 0 ∨ a.getD 1 0 = 0 ∨ a.getD 2 0 = 0 then
      if 4 ∈ a then denominator
      else if 3 ∈ a then denominator / 2
      else if e = listSub a e then denominator - 2 * s0 else s0
    else if 2 ∈ e ∨ 2 ∈ listSub a e then s0 else denominator / 2 - s0
  else 0

/-- Mode-`k` level-2 word marginal (over `denominator`) of the child with shape `a`. -/
def childP (a : List ℕ) (s0 k w0 w1 : ℕ) : ℕ :=
  (elementary.map fun e ↦
    if e.getD k 0 = w0 ∧ (listSub a e).getD k 0 = w1 then jointWeight a s0 e else 0).sum

def invRoles : Fin 6 → Fin 3 → Fin 3 :=
  ![![0, 1, 2], ![0, 2, 1], ![1, 0, 2], ![2, 0, 1], ![1, 2, 0], ![2, 1, 0]]

/-- Physical coordinates of a step-coordinate triple in region `ρ`. -/
def physOf (ρ : Fin 6) (v : Fin 3 → ℕ) : List ℕ := [v (invRoles ρ 0), v (invRoles ρ 1), v (invRoles ρ 2)]

