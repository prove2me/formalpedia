-- title:
--   Lemma A.3, (21), p. 14 — consensus contraction of v
-- statement:
--   Under Assumptions 2.1 and 2.2, let $\{v^k_i\}$ and $\{t^k_{v,i}\}$ be generated by Algorithm 1 from BOX 1 with any step sizes $\alpha,\beta,\eta>0$. For every $k\ge0$,
--   $$\sum_{i=1}^n\|v^{k+1}_i-\bar v^{k+1}\|^2\le\rho\sum_{i=1}^n\|v^k_i-\bar v^k\|^2+\frac{\rho^2\eta^2}{1-\rho}\sum_{i=1}^n\|t^k_{v,i}-\bar t^k_v\|^2.$$
--
--   This is the consensus recursion for the projected linear-system variable $v$.
--
--   **Formalization Note.** Standing assumptions: $n\ge1$, $\|v^0\|\le r_v$, and the projection radius is $r_v=L_{F,0}/\sigma$.
-- source:
--   Dong, Ma, Yang, Yin, A Single-Loop Algorithm for Decentralized Bilevel Optimization, arXiv:2311.08945v3, p. 14, Lemma A.3, (21)

import Mathlib
import Definitions.Def_DecBilevel_SLDBO_Setting

namespace DecBilevel.SLDBO

theorem lemma_A_3 {n p q : ℕ} (hn : 0 < n) (W : Matrix (Fin n) (Fin n) ℝ) (ρ : ℝ)
    (F f : Fin n → E p → E q → ℝ) (σ LF0 LF1 Lf1 Lf2 : ℝ) (α β η : ℝ)
    (hα : 0 < α) (hβ : 0 < β) (hη : 0 < η) (x0 : E p) (y0 v0 : E q)
    (hA21 : Assumption21 F f σ LF0 LF1 Lf1 Lf2) (hA22 : Assumption22 W ρ)
    (hv0 : ‖v0‖ ≤ rv σ LF0) (k : ℕ) :
    let s := run W F f α β η (rv σ LF0) x0 y0 v0
    ∑ i, ‖(s (k + 1)).v i - avg (s (k + 1)).v‖ ^ 2 ≤
      ρ * ∑ i, ‖(s k).v i - avg (s k).v‖ ^ 2 +
      ρ ^ 2 * η ^ 2 / (1 - ρ) * ∑ i, ‖trV s k i - avg (trV s k)‖ ^ 2 := by sorry

end DecBilevel.SLDBO
