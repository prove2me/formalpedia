theorem CS_par (u : Fin HS → ℤ) (q : ℤ) {j : Fin HS} (hj : ¬ Wk j) (h1 : j ≠ 1) (h6 : j ≠ 6)
    (h7 : j ≠ 7) (h8 : j ≠ 8) : CS u q j = u j := by
