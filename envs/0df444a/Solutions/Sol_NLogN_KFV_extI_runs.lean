theorem mvE {X Y : Fin HS} (hXY : X ≠ Y) (s : IState HS) (f : Fin HS → List ℤ) (a : ℤ)
    (l : List ℤ) (hX : f X = a :: l) :
    IRuns I iprog (.op (.mv X Y)) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update f X l) Y (a :: f Y))) (2 * moveCost (zsz a) + 19) := by
  refine (IRuns.mv (I := I) (iprog := iprog) (L := ints l ++ s.G X) hXY
    (by simp [hX, ints])).mono' ?_ le_rfl
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h1 : j = Y
  · subst h1; simp [ints, Ne.symm hXY]
  by_cases h2 : j = X
  · subst h2; simp [h1]
  · simp [h1, h2]

theorem digE (b e M S x : ℕ) (hx : x < 2 ^ (b * M)) (s : IState HS) (f : Fin HS → List ℤ)
    (l : List ℤ) (hX : f tX = (x : ℤ) :: l) :
    IRuns I iprog (digI b e M S) (NLogN.KIL.encK s f)
      (NLogN.KIL.encK s (Function.update (Function.update f tX l) 0 (gflat (digG b e M S x) ++ f 0)))
      (cDig b e M S) := by
  refine (digI_spec (I := I) (iprog := iprog) b e M S x hx (NLogN.KIL.encK s f) (ints l ++ s.G tX)
    (by simp [hX, ints])).mono' ?_ le_rfl
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h1 : j = 0
  · subst h1; simp [NLogN.ints_append]
  by_cases h2 : j = tX
  · subst h2; simp [h1]
  · simp [h1, h2]

theorem rho_congr {H : ℤ} {q q' : ℕ → ℤ} : ∀ j, (∀ k < j, q k = q' k) → rho H q j = rho H q' j
  | 0, _ => rfl
  | j + 1, h => by
    show (q j + rho H q j - cent H (q j + rho H q j)) / (2 * H) =
      (q' j + rho H q' j - cent H (q' j + rho H q' j)) / (2 * H)
    rw [h j (by omega), rho_congr j (fun k hk => h k (by omega))]

theorem cdig_congr {H : ℤ} {q q' : ℕ → ℤ} {j : ℕ} (h : ∀ k ≤ j, q k = q' k) :
    cdig H q j = cdig H q' j := by
  unfold cdig
  rw [h j le_rfl, rho_congr j (fun k hk => h k hk.le)]

theorem chk_getD {b M x j : ℕ} (hj : j < M) : (chk b M x).getD j 0 = NLogN.KFV.qd b x j := by
  rw [List.getD_eq_getElem _ _ (by simp [length_chk]; exact hj)]
  simp [chk, NLogN.KFV.qd]

theorem digG_zero (b M x : ℕ) : digG b 0 M M x = dpair (chk b M x) := by
  simp [digG, dpair]

theorem fok_carL (H B : ℤ) (J : ℕ) : NLogN.KFD.fok (carL H B J) = true := by
  simp +decide [carL, carB, NLogN.KFD.fok, touch, xHE, Ex.regs, NLogN.KFD.scr]

theorem fok_fldP (O : Fin HS) (hO : O = vOR ∨ O = vOI) (Δ n : ℕ) : NLogN.KFD.fok (fldP O Δ n) = true := by
  rcases hO with rfl | rfl <;> simp +decide [fldP, fldB, NLogN.KFD.fok, touch, Ex.regs, NLogN.KFD.scr]

end NLogN.KFV

end

