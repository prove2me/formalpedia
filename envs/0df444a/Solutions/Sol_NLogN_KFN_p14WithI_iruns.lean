-- Source module: Solutions.KFHRec
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

/-- Disk outputs truncate to numerators of at most `p + 1` bits. -/
theorem GB_trunc_disk {r p : ℕ} {zs : List GI} {xs : List (Fin r → ℂ)} (h : RecRep r p zs xs)
    (hd : ∀ j (hj : j < xs.length) c, ‖xs[j] c‖ ≤ 1) : NLogN.KFB.GB (p + 1) zs := by
  intro z hz
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hz
  have hr : 0 < r := by
    have h1 : zs.length = xs.length * r := h.1
    have : xs.length * r ≠ 0 := by omega
    exact Nat.pos_of_ne_zero (right_ne_zero_of_mul this)
  set j := i / r
  have hj : j < xs.length := by
    rw [h.1] at hi; exact (Nat.div_lt_iff_lt_mul hr).2 hi
  set c : Fin r := ⟨i % r, Nat.mod_lt _ hr⟩
  have hi' : i = j * r + c := by simp [j, c, Nat.div_add_mod']
  have e := h.2 j c hj
  rw [← hi', List.getD_eq_getElem _ _ hi, List.getD_eq_getElem _ _ hj] at e
  have hn := hd j hj c
  have hz : ‖NLogN.KFB.toC zs[i]‖ ≤ 2 ^ p := by
    rw [e, norm_mul]; simp only [norm_pow, Complex.norm_ofNat]
    calc (2 : ℝ) ^ p * ‖xs[j] c‖ ≤ 2 ^ p * 1 := by gcongr
      _ = 2 ^ p := mul_one _
  have k : ∀ a : ℤ, |(a : ℝ)| ≤ 2 ^ p → zsz a ≤ p + 1 := by
    intro a ha
    apply zsz_le_of_lt
    have : (a.natAbs : ℝ) ≤ 2 ^ p := by rw [Nat.cast_natAbs]; exact_mod_cast ha
    have : a.natAbs ≤ 2 ^ p := by exact_mod_cast this
    rw [pow_succ]; have := Nat.one_le_two_pow (n := p); omega
  have hre : (NLogN.KFB.toC zs[i]).re = zs[i].1 := by simp [NLogN.KFB.toC]
  have him : (NLogN.KFB.toC zs[i]).im = zs[i].2 := by simp [NLogN.KFB.toC]
  constructor
  · apply k; rw [← hre]; exact (Complex.abs_re_le_norm _).trans hz
  · apply k; rw [← him]; exact (Complex.abs_im_le_norm _).trans hz

theorem fok_truncP (Δ N : ℕ) : NLogN.KFD.fok (truncP Δ N) = true := by
  simp only [truncP, NLogN.KFD.fok, fok_mvK_eq, Bool.and_true, Bool.true_and]
  simp only [truncLoop, quoE, NLogN.KFD.fok, touch, Ex.regs, List.append_nil, List.nil_append]
  decide

end NLogN.KFH

end

section
-- Source module: Solutions.KFHKer
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFH

open IntMul RS AModel KIL KFD KFB Complex

variable {P K D S ρ : ℕ}

theorem layerShape_drop (P K D S i : ℕ) (hi : i < D) :
    (Butterfly.layerShape P K D S).drop (i + 2) = List.replicate (D - (i + 1)) (2 ^ K) ++ [S] := by
  simp only [Butterfly.layerShape, List.cons_append, List.drop_succ_cons]
  rw [List.drop_append_of_le_length (by simp; omega), List.drop_replicate]

theorem stS_eq (K D S i : ℕ) (hi : i < D) : stS K D S i = (2 ^ K) ^ (D - (i + 1)) * S := by
  simp [stS, layerShape_drop 1 K D S i hi, vol]

theorem vol_layer (P K D S : ℕ) :
    vol (Butterfly.layerShape P K D S) = P * (2 ^ K) ^ D * S := by
  simp [Butterfly.layerShape, vol]; ring

theorem grpG_mul (hρ : ρ < K) (i : ℕ) (hi : i < D) :
    grpG P K ρ i * (2 * stT K D S ρ i) = vol (Butterfly.layerShape P K D S) := by
  rw [vol_layer, grpG, stT, stS_eq K D S i hi]
  have e1 : (2 : ℕ) ^ K = 2 ^ (K - ρ - 1) * 2 * 2 ^ ρ := by
    rw [← pow_succ, ← pow_add]; congr 1; omega
  have e2 : (2 ^ K) ^ D = (2 ^ K) ^ i * 2 ^ K * (2 ^ K) ^ (D - (i + 1)) := by
    rw [← pow_succ, ← pow_add]; congr 1; omega
  rw [e2, e1]; ring

theorem setBit_sub (ρ v : ℕ) (b : Fin 2) :
    (Butterfly.setBit ρ v b : ℤ) - v = ((b : ℤ) - (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ := by
  have h1 := Butterfly.setBit_eq ρ v b
  have h2 := Butterfly.setBit_eq ρ v (Butterfly.getBit ρ v)
  rw [Butterfly.setBit_getBit] at h2
  have : ((Butterfly.setBit ρ v b : ℕ) : ℤ) - ((v : ℕ) : ℤ) =
      (((2 * (v / 2 ^ (ρ + 1)) + b) * 2 ^ ρ + v % 2 ^ ρ : ℕ) : ℤ) -
      (((2 * (v / 2 ^ (ρ + 1)) + (Butterfly.getBit ρ v : ℕ)) * 2 ^ ρ + v % 2 ^ ρ : ℕ) : ℤ) := by
    rw [← h1]; nth_rewrite 2 [h2]; rfl
  rw [this]; push_cast; ring

theorem kerP_fsp (s : IState HS) (hρ : ρ < K) (i : Fin D) {M : M2G} (hM : M.Ok) {r w : ℕ}
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hlen : zs.length = vol (Butterfly.layerShape P K D S) * r)
    (h0 : f 0 = gflat zs ++ l) (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz ((kerZ K D S ρ P r i : ℕ) : ℤ) ≤ Z) :
    FSp (kerP K D S ρ P r i M) (encK s f)
      (encK s (Function.update f 0 (gflat (qopL [M] (stT K D S ρ i * r) (grpG P K ρ i) zs) ++ l)))
      (cKer K D S ρ P r i w Z) ∧
    NLogN.KFB.GB (w + 2) (qopL [M] (stT K D S ρ i * r) (grpG P K ρ i) zs) := by
  have hG := grpG_mul (P := P) (S := S) hρ i i.isLt
  have hGB1 : grpG P K ρ i * (2 * (stT K D S ρ i * r) * [M].length) = zs.length := by
    rw [hlen, ← hG]; simp; ring
  refine ⟨?_, GB_qopL [M] (by simpa using hM) zs hb _⟩
  have H := qopW_fsp s w (stT K D S ρ i * r) (grpG P K ρ i) 0 [M] (by simpa using hM) f [] zs l rfl
    hGB1.le (by simpa using h0) hC (by simpa using hb) Z (by simpa [kerZ] using hZ)
  rw [hGB1, List.drop_length, List.append_nil, List.nil_append] at H
  exact H

theorem fok_kerP (K D S ρ P r : ℕ) (i : ℕ) (M : M2G) : NLogN.KFD.fok (kerP K D S ρ P r i M) = true :=
  fok_qopW _ _ _ _

end NLogN.KFH

end

