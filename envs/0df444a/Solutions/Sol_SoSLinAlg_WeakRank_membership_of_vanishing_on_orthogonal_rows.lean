section
open MvPolynomial
noncomputable section
namespace SoSLinAlg.WeakRank.Dev.Leaf.PartT
open SoSLinAlg.WeakRank SoSLinAlg.WeakRank.Dev.Leaf
theorem mem_two {σ : Type*} {a b v : σ} (h : v ∈ (Finsupp.single a 1 + Finsupp.single b 1 : σ →₀ ℕ).support) :
    v = a ∨ v = b := by
  classical
  rcases Finset.mem_union.mp (Finsupp.support_add h) with h | h
  · exact Or.inl (Finset.mem_singleton.mp (Finsupp.support_single_subset h))
  · exact Or.inr (Finset.mem_singleton.mp (Finsupp.support_single_subset h))

theorem mu_disj {n r : ℕ} (I J : Finset (Fin n)) (hIJ : I.card + J.card ≤ r) :
    Pairwise fun l l' => Disjoint (mu I J hIJ l).support (mu I J hIJ l').support := by
  intro l l' hll'
  rw [Finset.disjoint_left]
  intro v h1 h2
  apply hll'
  obtain ⟨⟨i, j⟩, hi, hj⟩ := l
  obtain ⟨⟨i', j'⟩, hi', hj'⟩ := l'
  dsimp only at hi hj hi' hj'
  simp only [mu, col] at h1 h2
  rcases mem_two h1 with rfl | rfl <;> rcases mem_two h2 with h | h <;>
    simp only [Sum.inl.injEq, Sum.inr.injEq, Prod.mk.injEq, Fin.mk.injEq, reduceCtorEq] at h
  · obtain ⟨rfl, h⟩ := h
    have := pos_inj hj hj' (by omega)
    subst this; rfl
  · obtain ⟨rfl, h⟩ := h
    have := pos_inj hi hi' (by omega)
    subst this; rfl

end SoSLinAlg.WeakRank.Dev.Leaf.PartT
end
