theorem baseChange_rationalGaloisRep_mul_add_natCast {J : Type} [AddCommGroup J] (ℓ : ℕ) [Fact ℓ.Prime]
    (E : Type*) [Field E] [Algebra ℚ_[ℓ] E] {G : Type} [Group G] [DistribMulAction G J]
    (g : G) (Φ : J →+ J) (c : ℕ) :
