set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false

namespace J6Seg.PJ

open IntMul NLogN NLogN.KIL RS Function E

theorem Fx.of {Q kk m mw cB : ℕ} {u u' : Vr} (h : Fx Q kk m mw cB u)
    (h' : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), u' j = u j) : Fx Q kk m mw cB u' := by
  obtain ⟨a, b, c, d, e, f⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    [rw [h' 9 (by decide)]; rw [h' 10 (by decide)]; rw [h' 11 (by decide)];
     rw [h' 12 (by decide)]; rw [h' 21 (by decide)]; rw [h' 28 (by decide)]] <;> assumption

section pieces
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {u : Vr} {c : Cs}

theorem BdS.two (h : BdS W m L Mf) : (2 : ℕ) ≤ 2 ^ W :=
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) h.1

end pieces

end J6Seg.PJ

