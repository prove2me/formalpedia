variable {Pp : ℕ} {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp} {Q : IState HS → Prop}
  {lo hi : ℕ}

/-- **The uniform leaf.** -/
theorem sImplQ_leafU {σ : Fin HS → Option ℤ} {K t S0 r H e B : ℕ}
    (hL : LevR σ K t S0 r H 0 e B) (hQ : ∀ s, Q s → Agree σ s) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hr : 1 ≤ r) (het : e < t) (Z : ℕ) (hZ : zsz ((12 * (B * 2 ^ t * S0 * r)) : ℕ) ≤ Z)
    (Bq : ℕ) (hBq : zsz ((4 * (B * 2 ^ t * S0 * r)) : ℕ) ≤ Bq) :
    SImplQ Isym tbl Q lo hi r (fun i : Fin (mC ^ 0) => 2 ^ (e - K * i.val) * S0) (B * 2 ^ t * S0)
      (Butterfly.tens Cm) leafC (ES 0) 2 (fun w => 400 * (ck (B * 2 ^ t * S0 * r) Z w + xLeaf Bq)) := by
  set N := B * 2 ^ t * S0 * r with hN
  have hbq : ∀ x : ℕ, x ≤ 4 * N → zsz (x : ℤ) ≤ Bq := fun x hx => le_trans (zsz_natCast_le hx) hBq
  have h2t : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have hSr : 1 ≤ S0 * r := Nat.mul_le_mul hS hr
  have hNt : 2 ^ t ≤ N := by
    have : 1 ≤ B * S0 * r := Nat.mul_le_mul (Nat.mul_le_mul hB hS) hr
    have e1 : N = 2 ^ t * (B * S0 * r) := by rw [hN]; ring
    rw [e1]; exact Nat.le_mul_of_pos_right _ this
  have ht1 : t + 1 ≤ Bq := by
    have h1 : zsz ((2 : ℤ) ^ t) = t + 1 := NLogN.zsz_two_pow t
    have h2 : zsz (((2 ^ t : ℕ) : ℤ)) ≤ Bq := hbq _ (by omega)
    push_cast at h2; omega
  have hte : t < 2 ^ t := Nat.lt_two_pow_self
  -- the parameters
  set B1 := KFH.stT t 1 S0 e 0 * r with hB1
  have hB1v : B1 = 2 ^ e * (S0 * r) := by
    rw [hB1, KFH.stT, KFH.stS_eq t 1 S0 0 (by norm_num)]; simp; ring
  set G := KFH.grpG B t e 0 with hG
  have hGv : G = B * 2 ^ (t - e - 1) := by rw [hG, KFH.grpG]; simp
  have hpe : 2 ^ e * 2 ^ (t - e - 1) * 2 = 2 ^ t := by
    rw [← pow_add, ← pow_succ]; congr 1; omega
  have hGB : G * B1 * 2 = N := by rw [hGv, hB1v, hN, ← hpe]; ring
  have hB1N : B1 ≤ N := by
    rw [hB1v, hN]
    have : 2 ^ e ≤ 2 ^ t := Nat.pow_le_pow_right (by norm_num) het.le
    have : 2 ^ e * (S0 * r) ≤ 2 ^ t * (S0 * r) := Nat.mul_le_mul_right _ this
    have : 2 ^ t * (S0 * r) ≤ B * 2 ^ t * S0 * r := by
      have := Nat.mul_le_mul_right (2 ^ t * (S0 * r)) hB
      calc 2 ^ t * (S0 * r) = 1 * (2 ^ t * (S0 * r)) := (one_mul _).symm
        _ ≤ B * (2 ^ t * (S0 * r)) := this
        _ = B * 2 ^ t * S0 * r := by ring
    omega
  have hGN : G ≤ N := by
    have : 1 ≤ B1 := by rw [hB1v]; exact Nat.mul_le_mul Nat.one_le_two_pow hSr
    have := Nat.mul_le_mul_left G this
    omega
  have hcovσ : ∀ j : Fin HS, j ∈ [NLogN.KFW.vE, vS, vR, NLogN.KFW.vB, NLogN.KFW.vT] → (σ j).isSome := by
    intro j hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl | rfl | rfl
    · rw [hL.hE]; rfl
    · rw [hL.hS]; rfl
    · rw [hL.hr]; rfl
    · rw [hL.hB]; rfl
    · rw [hL.ht]; rfl
  -- expression values
  have v2e : ExV σ (.pow2 (.reg NLogN.KFW.vE)) ((2 ^ e : ℕ) : ℤ) Bq :=
    (ExV.pow2 (ExV.reg hL.hE (hbq e (by omega))) (by positivity)
      (by rw [Int.toNat_natCast]; omega)).congr (by rw [Int.toNat_natCast]; push_cast; ring)
  have vSr : ExV σ (.mul (.reg vS) (.reg vR)) ((S0 * r : ℕ) : ℤ) Bq :=
    (ExV.mul (ExV.reg hL.hS (hbq S0 (by
        have : S0 ≤ S0 * r := Nat.le_mul_of_pos_right _ (by omega)
        have : S0 * r ≤ B1 := by rw [hB1v]; exact Nat.le_mul_of_pos_left _ (by positivity)
        omega)))
      (ExV.reg hL.hr (hbq r (by
        have : r ≤ S0 * r := Nat.le_mul_of_pos_left _ (by omega)
        have : S0 * r ≤ B1 := by rw [hB1v]; exact Nat.le_mul_of_pos_left _ (by positivity)
        omega)))
      (NLogN.KFW.zszN (n := S0 * r) (by push_cast; ring) (by
        have : S0 * r ≤ B1 := by rw [hB1v]; exact Nat.le_mul_of_pos_left _ (by positivity)
        omega) hBq)).congr (by push_cast; ring)
  have vB1 : ExV σ eB1L ((B1 : ℕ) : ℤ) Bq :=
    (ExV.mul v2e vSr (NLogN.KFW.zszN (n := B1) (by rw [hB1v]; push_cast; ring) (by omega) hBq)).congr
      (by rw [hB1v]; push_cast; ring)
  have vB2 : ExV σ (.mul (.lit 2) eB1L) ((2 * B1 : ℕ) : ℤ) Bq :=
    (ExV.mul (ExV.lit (hbq 2 (by omega))) vB1
      (NLogN.KFW.zszN (n := 2 * B1) (by push_cast; ring) (by omega) hBq)).congr (by push_cast; ring)
  have vB4 : ExV σ (.mul (.lit 4) eB1L) ((4 * B1 : ℕ) : ℤ) Bq :=
    (ExV.mul (ExV.lit (hbq 4 (by omega))) vB1
      (NLogN.KFW.zszN (n := 4 * B1) (by push_cast; ring) (by omega) hBq)).congr (by push_cast; ring)
  have hexp : ((t : ℤ) + -(e : ℤ) + -1) = ((t - e - 1 : ℕ) : ℤ) := by
    rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
  have vexp : ExV σ (.add (.add (.reg NLogN.KFW.vT) (.neg (.reg NLogN.KFW.vE))) (.lit (-1))) ((t - e - 1 : ℕ) : ℤ) Bq :=
    (ExV.add (ExV.add (ExV.reg hL.ht (hbq t (by omega))) (ExV.neg (ExV.reg hL.hE (hbq e (by omega))))
      (NLogN.KFW.zszN (n := t - e) (by rw [Nat.cast_sub het.le]; ring) (by omega) hBq))
      (ExV.lit (by rw [zsz_neg]; exact hbq 1 (by omega)))
      (NLogN.KFW.zszN hexp (by omega) hBq)).congr hexp
  have vG : ExV σ eGL ((G : ℕ) : ℤ) Bq :=
    (ExV.mul (ExV.reg hL.hB (hbq B (by
        have : B ≤ G := by rw [hGv]; exact Nat.le_mul_of_pos_right _ (by positivity)
        omega)))
      (ExV.pow2 vexp (by positivity) (by rw [Int.toNat_natCast]; omega))
      (NLogN.KFW.zszN (n := G) (by rw [Int.toNat_natCast, hGv]; push_cast; ring) (by omega) hBq)).congr
      (by rw [Int.toNat_natCast, hGv]; push_cast; ring)
  have vN : ExV σ (.mul (.lit ((4 * [MC].length : ℕ) : ℤ)) (.mul eGL eB1L))
      ((2 * (G * (2 * B1 * [MC].length)) : ℕ) : ℤ) Bq :=
    (ExV.mul (ExV.lit (hbq _ (by simp; omega)))
      (ExV.mul vG vB1 (NLogN.KFW.zszN (n := G * B1) (by push_cast; ring) (by omega) hBq))
      (NLogN.KFW.zszN (n := 4 * (G * B1)) (by simp) (by omega) hBq)).congr
      (by simp; ring)
  have cov : ∀ ex : Ex HS, (∀ j ∈ ex.regs, j ∈ [NLogN.KFW.vE, vS, vR, NLogN.KFW.vB, NLogN.KFW.vT]) →
      ∀ j ∈ ex.regs, (σ j).isSome := fun ex h j hj => hcovσ j (h j hj)
  have rB1 : ∀ j ∈ eB1L.regs, j ∈ [NLogN.KFW.vE, vS, vR, NLogN.KFW.vB, NLogN.KFW.vT] := by
