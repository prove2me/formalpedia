    ∀ (Ts : List (NLogN.KIL.TSh m)) (xs : List ℤ), (∀ T ∈ Ts, NLogN.KIL.TOK T N Bb) →
      xs.length = AModel.vol (P :: L :: AModel.hdShape A B Cs m N) → NLogN.Bnd w xs → t.G 0 = NLogN.ints xs ++ R →
