        (.ndiv (.reg 4) (.mul (.lit 16) (.reg 8))) = ((t / (16 * HH p α) : ℕ) : ℤ) := by
      simp only [ev_ndiv, ev_mul, ev_lit, h4, h8]; push_cast; rfl
    rw [e10]
    refine ⟨by simp [hV16, k1], by simp [hV16, k2], by simp [hV16, k3], by simp [hV16, k4],
      by simp [hV16, k5], by simp [hV16, k6], (by simp [hV16, k7]; exact hmdef), (by simp [hV16, k8, HH, hmdef] <;> exact hmdef),
      by simp [hV16], by simp, by simp [hV16], (by simp [hV16, hmdef] <;> exact hmdef), ?_⟩
    refine bnd b17 ?_
    exact (Nat.div_le_self _ _).trans htW.le

