theorem eisensteinIdeal_le : eisensteinIdeal p ≤ eisensteinMaximalIdeal p q := by
  intro t ht
  rw [eisensteinIdeal, mem_eigenIdeal_iff] at ht
  rw [mem_eisensteinMaximalIdeal_iff]
  have h0 : eisensteinEval p t = 0 := ht
  rw [h0]
  exact dvd_zero _

