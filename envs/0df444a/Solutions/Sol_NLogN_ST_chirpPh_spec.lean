  | .skip, s, _ => by simp [RS.cost, qsz]; nlinarith [Nat.zero_le B]
  | .asg i e, s, ⟨hb, hi⟩ => by
    have := asgCost_le i e s B hb hi
    simp only [RS.cost, qsz]; nlinarith
  | .push i e, s, hb => by
    have := pushCost_le e s B hb
    simp only [RS.cost, qsz]; nlinarith
  | .pop i, s, h => by
    simp only [QB] at h
    simp only [RS.cost, qsz]; nlinarith
  | .seq a b, s, ⟨ha, hb⟩ => by
    have h1 := cost_le_QB B a s ha
    have h2 := cost_le_QB B b _ hb
    simp only [RS.cost, qsz]; nlinarith
  | .ite c a b, s, ⟨hb, hab⟩ => by
    have h0 := Ex.cost_le s B c hb
    have hz := Ex.zsz_eval_le s B c hb
    simp only [RS.cost, qsz, moveCost]
    split_ifs at hab ⊢ with hc
    · have h1 := cost_le_QB B a s hab
      nlinarith
    · have h1 := cost_le_QB B b s hab
      nlinarith
  | .rep _ _ _, s, h => h.elim

