  have hgen_sp : ∀ i, toBase.base (gen i) = closedPoint ↥A := fun i =>
    (hsp_iff (gen i)).mpr (by rw [hgen]; exact hgen₀_cl i)
  have hnd_sp : ∀ e, toBase.base (nd e) = closedPoint ↥A := fun e =>
