theorem layA_cons (j : ℕ) (L : List ℕ) : layA bg (j :: L) = atm bg j ++ layA bg L := by
  simp [layA]

theorem layA_append (L M : List ℕ) : layA bg (L ++ M) = layA bg L ++ layA bg M := by
  simp [layA]

theorem mem_atm {j x : ℕ} : x ∈ atm bg j → x / 2 = j := by
  unfold atm; intro h; simp only [List.mem_cons] at h
  rcases h with rfl | h
  · omega
  · split_ifs at h <;> simp at h; omega

theorem mem_layA {L : List ℕ} {x : ℕ} (h : x ∈ layA bg L) : x / 2 ∈ L := by
  simp only [layA, List.mem_flatMap] at h
  obtain ⟨j, hj, hx⟩ := h
  rw [mem_atm bg hx]; exact hj

theorem nodup_layA : ∀ (L : List ℕ), L.Nodup → (layA bg L).Nodup
  | [], _ => by simp [layA]
  | j :: L, h => by
    rw [layA_cons, List.nodup_append]
    obtain ⟨hj, hL⟩ := List.nodup_cons.1 h
    refine ⟨?_, nodup_layA L hL, ?_⟩
    · unfold atm; split_ifs <;> simp
    · intro x hx y hy hxy; subst hxy
      have := mem_layA bg hy
      rw [mem_atm bg hx] at this
      exact hj this

theorem full_layA (L : List ℕ) : Full bg L (layA bg L) := by
  intro j hj
  simp only [layA, List.mem_flatMap]
  refine ⟨⟨j, hj, by simp [atm]⟩, fun hb => ⟨j, hj, by simp [atm, hb]⟩⟩

theorem vol_atm (j : ℕ) : AModel.vol ((atm bg j).map (asz mz)) = tz mz bg j := by
  unfold atm tz asz; split_ifs <;> simp [AModel.vol] <;> omega

theorem vol_layA : ∀ (L : List ℕ), AModel.vol ((layA bg L).map (asz mz)) = AModel.vol (L.map (tz mz bg))
  | [] => by simp [layA, AModel.vol]
  | j :: L => by
    rw [layA_cons, List.map_append, vol_append, vol_atm, vol_layA L]; simp

