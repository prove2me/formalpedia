-- title:
--   §3.2.1, §5.3: the ℓ1-regularized least squares objective, its minimizers, the spectral norm, ISTA, and the matrices M, [Ãᵀ, μ̃ᵀ]ᵀ
-- statement:
--   Fix $\mu \in \mathbb R$, $A \in \mathbb R^{m\times n}$ and $d \in \mathbb R^m$; vectors carry the Euclidean norm.
--
--   1. **Spectral norm.** For a real matrix $M$, $\|M\|$ is its operator norm between Euclidean spaces, the largest singular value of $M$.
--   2. **Objective.** $f(x) = \mu\|x\|_1 + \tfrac12\|Ax - d\|^2$ for $x \in \mathbb R^n$, where $\|x\|_1 = \sum_i |x_i|$.
--   3. **Minimum and minimizers.** $\min f = \inf_{x\in\mathbb R^n} f(x)$ and $S = \operatorname{argmin} f = \{x : f(x) = \min f\}$.
--   4. **ISTA.** A sequence $(x_k)_{k\in\mathbb N}$ with stepsizes $(\lambda_k)$ is generated by the iterative shrinkage thresholding algorithm if, for every $k \ge 0$,
--   $$x_{k+1} = \operatorname{prox}_{\lambda_k\mu\|\cdot\|_1}\big(x_k - \lambda_k(A^TAx_k - A^Td)\big),$$
--   where $\operatorname{prox}_\varphi(v)$ is the minimizer of $\varphi(y) + \tfrac12\|y - v\|^2$ over $y \in \mathbb R^n$. The starting point $x_0$ is arbitrary.
--   5. **The matrices of Lemma 10.** $M$ is the $(2^n + 1) \times (n + 1)$ matrix whose rows are $(e_s, -1)$ for the $2^n$ sign vectors $e_s \in \{\pm1\}^n$, plus the last row $(0, \dots, 0, 1)$. The $(m + 1) \times (n + 1)$ matrix $[\tilde A^T, \tilde\mu^T]^T$ has rows $(A_j, 0)$, $j = 1, \dots, m$ (that is, $\tilde A = [A, 0]$), and the last row $\tilde\mu = (0, \dots, 0, \mu)$.
--
--   The objective is the model of sparse inverse problems; ISTA is the forward-backward method applied to $g = \mu\|\cdot\|_1$ and $h = \tfrac12\|A\cdot - d\|^2$, whose gradient is Lipschitz with constant $L = \|A^TA\|$.
--
--   **Formalization Note** $\mathbb R^n$ is `EuclideanSpace ℝ (Fin n)` and matrices act by `Matrix.toEuclideanLin`; the spectral norm is the norm of the associated continuous linear map, not Mathlib's default entrywise matrix norm. $\|\cdot\|_1$ and the prox predicate are the published `l1Norm` and `IsProx` of `BoydADMM.Prox.Basic` (`IsProx Set.univ φ 1 v x`: $x$ minimizes $\varphi(y) + \tfrac12\|y - v\|^2$). $\min f$ is the real infimum, which is the true infimum because $f \ge 0$ when $\mu \ge 0$. The paper calls the data vector $b$ in §3.2.1 and $d$ in §5.3; $d$ is used throughout, since $b$ also names the constant of (H2). The rows of $M$ are indexed by `Option (Fin n → Bool)` (`none` = the last row) and the columns of both matrices by `Option (Fin n)` (`none` = the extra coordinate $y$); the order of the rows is irrelevant, as the page says.
-- source:
--   arXiv:1510.08234v3, §3.2.1, p. 10 (objective, S, footnote 5 spectral norm) and p. 11 (Ã, μ̃, M); §5.3, p. 23 (f, L = ‖AᵀA‖, (ISTA)); §2.1, p. 5 (prox)

import Mathlib
import Definitions.Def_BoydADMM_Prox_Basic
open BoydADMM.Prox
open scoped Matrix

namespace ErrBoundCplx.ISTA

/-- Footnote 5, p. 10: the spectral (operator) norm `‖M‖` of a real matrix, i.e. the operator
norm of `x ↦ Mx` between Euclidean spaces (the largest singular value of `M`). Not Mathlib's
default (entrywise sup) matrix norm. -/
noncomputable def specNorm {ι κ : Type*} [Fintype ι] [Fintype κ] [DecidableEq κ]
    (M : Matrix ι κ ℝ) : ℝ :=
  ‖LinearMap.toContinuousLinearMap (Matrix.toEuclideanLin M)‖

/-- §3.2.1, p. 10 and §5.3, p. 23: the ℓ1-regularized least squares objective
`f(x) = μ‖x‖₁ + ½‖Ax − d‖²` on `ℝⁿ`, with `A ∈ ℝ^{m×n}` and `d ∈ ℝ^m`. -/
noncomputable def lassoObj {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (d : EuclideanSpace ℝ (Fin m)) (μ : ℝ) (x : EuclideanSpace ℝ (Fin n)) : ℝ :=
  μ * l1Norm x + 1 / 2 * ‖Matrix.toEuclideanLin A x - d‖ ^ 2

/-- `min f`, as the infimum of `f` over `ℝⁿ` (`f ≥ 0` when `μ ≥ 0`, so the infimum is that of
a set bounded below). -/
noncomputable def lassoMin {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (d : EuclideanSpace ℝ (Fin m)) (μ : ℝ) : ℝ :=
  ⨅ x, lassoObj A d μ x

/-- `S = argmin f = {x | f(x) = min f}` (p. 10). -/
def lassoArgmin {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ)
    (d : EuclideanSpace ℝ (Fin m)) (μ : ℝ) : Set (EuclideanSpace ℝ (Fin n)) :=
  {x | lassoObj A d μ x = lassoMin A d μ}

/-- (ISTA), §5.3, p. 23: `x_{k+1} = prox_{λ_k μ ‖·‖₁}(x_k − λ_k(AᵀA x_k − Aᵀd))` for every
`k ≥ 0`, from an arbitrary `x₀`. The prox of §2.1 (p. 5), `prox_φ(v) = argmin_y φ(y) + ½‖y − v‖²`,
is written with the published predicate `IsProx Set.univ φ 1 v` (minimizer of
`φ(y) + (1/2)‖y − v‖²` over all of `ℝⁿ`), with `φ = λ_k μ ‖·‖₁`. -/
def IsISTASeq {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (d : EuclideanSpace ℝ (Fin m))
    (μ : ℝ) (lam : ℕ → ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n)) : Prop :=
  ∀ k : ℕ, IsProx Set.univ (fun z => lam k * μ * l1Norm z) 1
    (x k - lam k • (Matrix.toEuclideanLin (Aᵀ * A) (x k) - Matrix.toEuclideanLin Aᵀ d))
    (x (k + 1))

/-- The sign vector `e_s ∈ {±1}ⁿ` attached to `s : Fin n → Bool` (`+1` where `s i` holds). -/
def signVec {n : ℕ} (s : Fin n → Bool) (i : Fin n) : ℝ := if s i then 1 else -1

/-- The matrix `M` of p. 11, of size `(2ⁿ + 1) × (n + 1)`: rows `(e_s, −1)` for the `2ⁿ` sign
vectors `e_s` (indexed by `some s`, `s : Fin n → Bool`, in no particular order) and the last row
`(0, …, 0, 1)` (indexed by `none`). The `n + 1` columns are indexed by `Option (Fin n)`:
`some i` is the coordinate `x_i`, `none` the extra coordinate `y`. -/
def hoffmanM (n : ℕ) : Matrix (Option (Fin n → Bool)) (Option (Fin n)) ℝ :=
  fun r c => match r, c with
    | some s, some i => signVec s i
    | some _, none => -1
    | none, some _ => 0
    | none, none => 1

/-- The `(m + 1) × (n + 1)` matrix `[Ãᵀ, μ̃ᵀ]ᵀ` of p. 11: rows `(A_j, 0)` for `j = 1, …, m`
(indexed by `some j`; `Ã = [A, 0]`) and the last row `μ̃ = (0, …, 0, μ)` (indexed by `none`).
Columns as in `hoffmanM`. -/
def hoffmanE {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (μ : ℝ) :
    Matrix (Option (Fin m)) (Option (Fin n)) ℝ :=
  fun r c => match r, c with
    | some j, some i => A j i
    | some _, none => 0
    | none, some _ => 0
    | none, none => μ

end ErrBoundCplx.ISTA


