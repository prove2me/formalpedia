set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.CR

open IntMul RS

theorem zerosP_states (i C : Fin HS) (hiC : i ≠ C) (n : Ex HS) (s : IState HS) (N : ℕ)
    (hne : n.eval s = N) :
    RepStates C n (push i (.lit 0)) s (fun k => s.upd i (ints (List.replicate k 0) ++ s.G i)) where
  nonneg := by rw [hne]; omega
  hw := by simp [RS.writes, Ne.symm hiC]
  h0 := by simp
