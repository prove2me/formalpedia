variable (hD : KSData b bi v k U)
include hD
theorem solution {x : Pt 5} (hx : x ∈ U) (c : Fin 5) :
    ∑ a, lowerK b k x a * ∑ l, christoffel b bi a c l x * k x l =
      (∑ p, ∑ q, pd c (b p q) x * k x p * k x q) / 2 := by
  have e1 : ∑ a, lowerK b k x a * ∑ l, christoffel b bi a c l x * k x l =
      ∑ m, ∑ l, k x m * k x l * ∑ a, b m a x * christoffel b bi a c l x := by
    calc ∑ a, lowerK b k x a * ∑ l, christoffel b bi a c l x * k x l
        = ∑ a, ∑ m, ∑ l, b a m x * k x m * (christoffel b bi a c l x * k x l) :=
          Finset.sum_congr rfl fun a _ => by
            unfold lowerK
            rw [Finset.sum_mul]
            exact Finset.sum_congr rfl fun m _ => by rw [Finset.mul_sum]
      _ = ∑ m, ∑ a, ∑ l, b a m x * k x m * (christoffel b bi a c l x * k x l) :=
          Finset.sum_comm
      _ = ∑ m, ∑ l, ∑ a, b a m x * k x m * (christoffel b bi a c l x * k x l) :=
          Finset.sum_congr rfl fun m _ => Finset.sum_comm
      _ = _ := Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun l _ => by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl fun a _ => by rw [hD.symm x hx a m]; ring
  rw [e1]
  simp only [hD.lower_bchr hx]
  have e3 : ∑ m, ∑ l, k x m * k x l * pd m (b c l) x =
      ∑ m, ∑ l, k x m * k x l * pd l (b m c) x := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun m _ => by
      rw [hD.pd_b_symm hx m c l]; ring
  have e4 : ∑ m, ∑ l, k x m * k x l *
      ((pd l (b m c) x + pd c (b m l) x - pd m (b c l) x) / 2) =
      ((∑ m, ∑ l, k x m * k x l * pd l (b m c) x)
        + (∑ m, ∑ l, pd c (b m l) x * k x m * k x l)
        - (∑ m, ∑ l, k x m * k x l * pd m (b c l) x)) / 2 := by
    simp only [Finset.sum_div, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun m _ => Finset.sum_congr rfl fun l _ => by ring
  rw [e4, e3]
