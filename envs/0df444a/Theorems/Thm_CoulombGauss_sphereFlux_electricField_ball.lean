-- title:
--   Flux of a charged ball through its boundary sphere is $Q/\varepsilon_0$
-- statement:
--   Let $\varepsilon_0>0$, $c\in\mathbb R^3$, $R>0$, and let $\rho$ be integrable and bounded on the open ball $B_R(c)$. Let $\mathbf E_{B_R}$ be the field generated by the charge density $\rho$ restricted to $B_R(c)$. Then its outward flux through the boundary sphere equals the enclosed charge divided by $\varepsilon_0$:
--   $$
--   \oint_{\partial B_R(c)}\mathbf E_{B_R}\cdot d\mathbf S=\frac{Q(R)}{\varepsilon_0},\qquad Q(R)=\int_{B_R(c)}\rho(r')\,d^3r' .
--   $$
--
--   In the source this is the sentence "The RHS is the electric flux generated by a charged sphere, and so $\Phi(R)=Q(R)/\varepsilon_0=\frac1{\varepsilon_0}\int_{B_R(\mathbf r_0)}\rho$".
--
--   **Formalization Note** Boundedness of $\rho$ on the ball guarantees that the field is well defined and integrable on the sphere, where the charges touch it; in the source $\rho$ is continuous on an open set containing the closed ball, which implies it.
-- source:
--   Wikipedia, "Coulomb's law", https://en.wikipedia.org/wiki/Coulomb%27s_law (snapshot supplied as PDF, 30 Sep 2026), section "Relation to Gauss's law" -> "Deriving Gauss's law from Coulomb's law", box "Proof (without Dirac Delta)" (PDF pp. 8-9).

import Mathlib
import Definitions.Def_CoulombGauss_basic
open MeasureTheory Filter Topology Metric

namespace CoulombGauss
theorem sphereFlux_electricField_ball (ε₀ : ℝ) (hε₀ : 0 < ε₀)
    (ρ : Vec3 → ℝ) (c : Vec3) (R : ℝ) (hR : 0 < R) (hρ : IntegrableOn ρ (ball c R))
    (hbdd : ∃ M : ℝ, ∀ x ∈ ball c R, |ρ x| ≤ M) :
    sphereFlux (electricField ε₀ ρ (ball c R)) c R = (1 / ε₀) * ∫ x in ball c R, ρ x := by sorry
end CoulombGauss
