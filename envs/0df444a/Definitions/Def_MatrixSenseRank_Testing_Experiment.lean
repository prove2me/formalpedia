-- title:
--   Independent noisy experiments and the label-only LowRankTester
-- statement:
--   For a scalar input law $D$, let $D^{\otimes n}$ be the law of independent coordinates. For $w\in\mathbb R^n$ and independent noise with law $\eta$, the label law is the pushforward of $D^{\otimes n}\otimes\eta$ by $(x,e)\mapsto\sum_iw_ix_i+e$. A test satisfies the sparsity guarantee at $k,\varepsilon,C$ if it accepts $k$-sparse vectors with probability at least $9/10$ and rejects vectors at relative distance at least $\varepsilon$ with probability at least $9/10$, for every dimension and every $1/C\le\|w\|_2\le C$.
--
--   For a fixed real matrix $A\in\mathbb R^{n\times m}$, the observation law is generated by independent standard Gaussian vectors $g\in\mathbb R^n$, $h\in\mathbb R^m$, and independent $e\sim\eta$:
--   $$X_{ij}=g_ih_j,\qquad y=\sum_{i,j}A_{ij}X_{ij}+e.$$
--   Each observation uses fresh independent draws. Given a label-only Boolean kernel $K$, the construction is
--   $$\operatorname{LowRankTester}(K)((X_t,y_t)_{t<T})=K((y_t)_{t<T}).$$
--   This is composition with label projection, so it cannot access the hidden matrix or singular basis. Matrix acceptance is the acceptance integral of this kernel under the product observation law.
--
--   The polynomial-bound helper is the natural ceiling of $a(1+\sum_i x_i)^d$. The theorems quantify $a>0$ and the integer degree $d\ge1$ before every instance parameter; the helper itself asserts no bound or correctness.
--
--   **Formalization Note** Matrices carry their finite-dimensional Borel sigma algebra. Every pushforward map is a continuous finite polynomial in its coordinates; the label projection is explicitly measurable in the kernel construction. The sparsity guarantee is a predicate used in theorem conclusions, never a field or hypothesis asserting that a desired tester exists.
-- source:
--   Yiqiao Bao, Anindya De, Shivam Nadimpalli, Rocco A. Servedio, Chenyang Sun, Nathan White, STOC 2027 submission #380 (October 2026), §1.2, Eq. (2) and noise convention, printed pp. 1–3 / PDF pp. 2–4; §6, Theorems 3 and 14 and LowRankTester construction, printed pp. 26–28 / PDF pp. 27–29; https://github.com/sigact-stoc/stoc2027/releases/download/papers-1/380.pdf; PDF SHA-256 6e4e46ced4dfe65bbe94e4cec3e8230032914efef9d87b0f544bbea151a00c3b.

import Mathlib
import Definitions.Def_MatrixSenseRank_Testing_Geometry
import Definitions.Def_MatrixSenseRank_Testing_Moments
import Definitions.Def_MatrixSenseRank_Testing_StatisticalTest

set_option autoImplicit false
open MeasureTheory ProbabilityTheory
open scoped BigOperators

namespace MatrixSenseRank.Testing

/-- The observation matrix carries its finite-dimensional Borel sigma algebra. -/
instance matrixMeasurableSpace (n m : ℕ) : MeasurableSpace (Matrix (Fin n) (Fin m) ℝ) :=
  borel (Matrix (Fin n) (Fin m) ℝ)

instance matrixBorelSpace (n m : ℕ) : BorelSpace (Matrix (Fin n) (Fin m) ℝ) := ⟨rfl⟩

noncomputable def coordinateLaw (D : Measure ℝ) (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => D)

def linearLabel {n : ℕ} (w : Fin n → ℝ) (p : (Fin n → ℝ) × ℝ) : ℝ :=
  (∑ i, w i * p.1 i) + p.2

noncomputable def labelLaw {n : ℕ} (D η : Measure ℝ) (w : Fin n → ℝ) : Measure ℝ :=
  Measure.map (linearLabel w) ((coordinateLaw D n).prod η)

/-- Relative sparsity testing, uniform in dimension and the hidden nonzero vector. -/
def SparsityGuarantee {T : ℕ} (test : StatisticalTest ℝ T)
    (D η : Measure ℝ) (k : ℕ) (ε C : ℝ) : Prop :=
  ∀ (n : ℕ) (w : Fin n → ℝ), 0 < n →
    1 / C ≤ vectorNorm w → vectorNorm w ≤ C →
    (IsSparse k w → (9 : ℝ) / 10 ≤ acceptance test (labelLaw D η w)) ∧
    (ε ≤ sparseDistance k w → acceptance test (labelLaw D η w) ≤ (1 : ℝ) / 10)

def measurement {n m : ℕ} (g : Fin n → ℝ) (h : Fin m → ℝ) : Matrix (Fin n) (Fin m) ℝ :=
  fun i j => g i * h j

def matrixObservation {n m : ℕ} (A : Matrix (Fin n) (Fin m) ℝ)
    (p : ((Fin n → ℝ) × (Fin m → ℝ)) × ℝ) : Matrix (Fin n) (Fin m) ℝ × ℝ :=
  let X := measurement p.1.1 p.1.2
  (X, (∑ i, ∑ j, A i j * X i j) + p.2)

/-- Actual independent Gaussian/noise experiment, not a law on singular coordinates. -/
noncomputable def observationLaw {n m : ℕ} (η : Measure ℝ)
    (A : Matrix (Fin n) (Fin m) ℝ) : Measure (Matrix (Fin n) (Fin m) ℝ × ℝ) :=
  Measure.map (matrixObservation A)
    (((coordinateLaw (gaussianReal 0 1) n).prod
      (coordinateLaw (gaussianReal 0 1) m)).prod η)

/-- §6 construction: discard X and run the fixed label-only Boolean kernel. -/
def LowRankTester {n m T : ℕ} (test : StatisticalTest ℝ T) :
    StatisticalTest (Matrix (Fin n) (Fin m) ℝ × ℝ) T :=
  ⟨test.val.comap (fun s i => (s i).2)
      (measurable_pi_iff.mpr (fun i => measurable_snd.comp (measurable_pi_apply i))), by
    have : IsMarkovKernel test.val := test.property
    infer_instance⟩

noncomputable def matrixAcceptance {n m T : ℕ} (test : StatisticalTest ℝ T)
    (η : Measure ℝ) (A : Matrix (Fin n) (Fin m) ℝ) : ℝ :=
  acceptance (LowRankTester test) (observationLaw η A)

/-- A fixed absolute polynomial, expressed as a power of one plus the sum of arguments. -/
noncomputable def polynomialBound (a : ℝ) (d : ℕ) (xs : List ℝ) : ℕ :=
  ⌈a * (1 + xs.sum) ^ d⌉₊

end MatrixSenseRank.Testing


