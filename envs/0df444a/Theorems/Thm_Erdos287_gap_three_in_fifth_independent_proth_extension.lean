-- title:
--   Fifth independently generated Proth extension interval
-- statement:
--   For an increasing unit-fraction representation of $1$ by at least two denominators greater than $1$, some gap is at least three if the largest denominator is in the exact closed interval $[L,U]$ in the Lean statement. The approximate bounds are $4.15045406157\times10^{882}$ and $6.69708429961\times10^{884}$.
-- source:
--   Erdős Problem 287, https://www.erdosproblems.com/287. Independently computed Proth certificates.

import Mathlib

theorem Erdos287.gap_three_in_fifth_independent_proth_extension (k : ℕ) (hk : 2 ≤ k) (f : ℕ → ℕ)
    (hf1 : ∀ i, i < k → 1 < f i)
    (hmono : ∀ i j, i < j → j < k → f i < f j)
    (hsum : ∑ i ∈ Finset.range k, (1 : ℚ) / f i = 1)
    (hlo :  ≤ f (k - 1)) (hhi : f (k - 1) ≤ ) :
    ∃ i, i + 1 < k ∧ 3 ≤ f (i + 1) - f i := by sorry
