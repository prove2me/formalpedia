-- Source module: Solutions.R6ChkBitSup
/-!
# Bit round six (h = 23): the node-support lookup

`supT` stores the 1771-bit support masks of the 36 513 nodes of the gm-side DAG, 16 nodes per
leaf (1792-bit fields), in a depth-12 binary tree; `supG k` is the support of node `k`.
-/

set_option maxRecDepth 100000

namespace R6Chk.Bit

/-- The whole support tree (depth 12). -/
noncomputable def supT : BT := BT.node (BT.node supT0 supT1) (BT.node supT2 (BT.leaf 0))

/-- Support mask of node `k`. -/
noncomputable def supG (k : ℕ) : ℕ := fieldOf (btGet supT 12 (Nat.shiftRight k 4)) 1792 (Nat.land k 15)

end R6Chk.Bit

end

