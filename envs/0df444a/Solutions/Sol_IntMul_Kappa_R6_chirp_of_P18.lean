section
-- Source module: Solutions.KFZCall
/-!
# KFZ Call: the Prop 18 call inside the chirp procedure

**`Mcall j d18`**: mark the free leaf stack `X`, build the Prop 18 descriptor on `X` at run time
(`desc18P`, registers from `p, h, d, σ, K`), move it to the descriptor stack `d18` of the Prop 18
procedure over a mark (`xfer`), call `j`, and remove the descriptor again (`unxfer`).

**`M_runs`**: the call runs on the state `encK (bgS s G d18 l) (fC …)`: stack `0` holds exactly the
two record arrays, `d18` exactly the descriptor, every other managed stack is empty, and all other
contents (our tables, registers, the rest of stack `0`, the old contents of `d18`) are in the
unmanaged part `bgS`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue

theorem fC_ne (d18 : Fin HS) (Z D : List ℤ) (i : Fin HS) (h0 : i ≠ 0) (h1 : i ≠ d18) :
    fC d18 Z D i = [] := by
  simp [fC, Function.update_of_ne h0, Function.update_of_ne h1]

theorem fC_d18 (d18 : Fin HS) (Z D : List ℤ) : fC d18 Z D d18 = D := by simp [fC]

theorem fC_0 (d18 : Fin HS) (hd : d18 ≠ 0) (Z D : List ℤ) : fC d18 Z D 0 = Z := by
  simp [fC, Function.update_of_ne (Ne.symm hd)]

end NLogN.KFZ

end

section
-- Source module: Solutions.KFZPhase
/-!
# KFZ Phase: the rounded phase tables satisfy `Phases`

The tables are computed at precision `Δ = p + g` and rounded to precision `p` (`KFH.gtr g`).
`Phases` asks for `|θ̃ − θ| ≤ 2·2^{−p}` **and** `|θ̃| ≤ 1`. The second needs more than the
generic `gtr_err`: a grid point of `2^{−p}ℤ[i]` of modulus above `1` has modulus at least
`√(1 + 4^{−p})`, so the table error before rounding must be below about `4^{−p}`.

* **`Qp_unit`**: `‖v − X‖ ≤ 2^{−2p−2}`, `‖X‖ ≤ 1` ⟹ `‖Q_p v − X‖ ≤ 2hp` and `‖Q_p v‖ ≤ 1`.
* **`phases_QA`**: the array form.
* **`norm_chirp_le`**, `norm_twX`, `zeta_pow`: the exact phases.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul KIL KFB NLogN.KFM Complex

noncomputable section

section Arr

variable {ι : Type*} [Fintype ι]

/-- **Rounded tables are phase tables.** -/
theorem phases_QA (p : ℕ) {θ v : ι → ℂ} (hθ : ∀ i, ‖θ i‖ ≤ 1)
    (hv : ∀ i, ‖v i - θ i‖ ≤ (2 : ℝ)⁻¹ ^ (2 * p + 2)) : Phases p θ (QA p v) :=
  ⟨hθ, fun i => (Qp_unit p (hθ i) (hv i)).1, fun i => (Qp_unit p (hθ i) (hv i)).2⟩

/-- Conjugate phase tables. -/
theorem Phases.cnj' {p : ℕ} {θ θt : ι → ℂ} (h : Phases p θ θt) :
    Phases p (fun i => starRingEnd ℂ (θ i)) (cnj θt) :=
  ⟨fun i => by rw [Complex.norm_conj]; exact h.e i,
   fun i => by
     simp only [cnj]; rw [← map_sub, Complex.norm_conj]; exact h.t i,
   fun i => by simp only [cnj]; rw [Complex.norm_conj]; exact h.t1 i⟩

end Arr

/-! ## The exact phases -/

theorem norm_chirp_le {d : ℕ} (s t : Fin d → ℕ) (j : (i : Fin d) → ZMod (t i)) :
    ‖IntMul.OpenAI.RC.chirp s t j‖ ≤ 1 := by
  unfold IntMul.OpenAI.RC.chirp
  rw [norm_prod]
  refine Finset.prod_le_one (fun _ _ => norm_nonneg _) fun i _ => ?_
  exact norm_exp_phase (-(Real.pi * s i * ((j i).val : ℝ) ^ 2 / t i)) _ (by
    push_cast; ring)

theorem norm_zetaR (r : ℕ) : ‖zetaR r‖ = 1 := by
  unfold zetaR
  have : (2 * Real.pi * I * ((1 : ℕ) : ℂ) / ((2 * r : ℕ) : ℂ)) =
      ((2 * Real.pi / (2 * r : ℕ) : ℝ) : ℂ) * I := by push_cast; ring
  rw [this, Complex.norm_exp_ofReal_mul_I]

theorem zetaR_pow (r : ℕ) (hr : 0 < r) : zetaR r ^ r = -1 := by
  unfold zetaR
  rw [← Complex.exp_nat_mul]
  have hr' : (r : ℂ) ≠ 0 := by exact_mod_cast hr.ne'
  rw [show (r : ℂ) * (2 * Real.pi * I * ((1 : ℕ) : ℂ) / ((2 * r : ℕ) : ℂ)) = Real.pi * I by
    push_cast; field_simp]
  exact Complex.exp_pi_mul_I

theorem norm_twX {D : ℕ} (t : Fin (D + 1) → ℕ) (r : ℕ) (K : (i : Fin (D + 1)) → ZMod (t i)) :
    ‖twX t (zetaR r) K‖ ≤ 1 := by
  simp [twX, norm_pow, norm_zetaR]

theorem twX_inv {D : ℕ} (t : Fin (D + 1) → ℕ) (r : ℕ) (K : (i : Fin (D + 1)) → ZMod (t i)) :
    (twX t (zetaR r) K)⁻¹ = starRingEnd ℂ (twX t (zetaR r) K) := by
  have h : ‖twX t (zetaR r) K‖ = 1 := by simp [twX, norm_pow, norm_zetaR]
  have h2 : Complex.normSq (twX t (zetaR r) K) = 1 := by
    rw [Complex.normSq_eq_norm_sq, h]; norm_num
  rw [Complex.inv_def, h2]; simp

end

end NLogN.KFZ

end

section
-- Source module: Solutions.KFZRec
/-!
# KFZ Rec: the box arrays as `P18IL` record lists

`P18IL` takes and returns row-major lists of records of `r` coefficients (`RecRep r p`). On the
box `t` with last axis `t_D = r` these are the `RepFull` arrays (`KFMBridge.recL`, `boxOf`):

* `ptB_rec`: the index `j·r + c` is the box point `fullIdx t j c`.
* `castR`: transport of records along `t_D = r` (the identity after `subst`).
* **`rec_in`**: `RepFull p t zs w` gives `RecRep r p zs (castR (recL t w))`, length `∏_{i<D} t_i`.
* **`rec_out`**: a `RecRep` output with the `P18IL` bound gives `RepFull p t zh h` with
  `‖h − mrX t f g‖ ≤ E`.
* **`GB_of_repFull`**: arrays of norm `≤ 2^k` have `p + k + 2`-bit numerators.
* **`mrtCall`**: the per-call map `M̃r` (`h` at the actual operands, `mrX` elsewhere).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul KIL KFB NLogN.KFM NLogN.KFH Complex

noncomputable section

variable {D : ℕ}

theorem prod_box (t : Fin (D + 1) → ℕ) : (tsOf t).prod * t (Fin.last D) = ∏ i, t i := by
  rw [tsOf_prod, Fin.prod_univ_castSucc]

theorem ptB_rec (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (j c : ℕ) (hc : c < t (Fin.last D)) :
    ptB t (j * t (Fin.last D) + c) = fullIdx t j c := by
  have hr : 0 < t (Fin.last D) := Nat.pos_of_ne_zero (NeZero.ne _)
  have hdiv : (j * t (Fin.last D) + c) / t (Fin.last D) = j := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hr, Nat.div_eq_of_lt hc, zero_add]
  have hmod : (j * t (Fin.last D) + c) % t (Fin.last D) = c := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hc]
  funext i
  refine Fin.lastCases ?_ (fun k => ?_) i
  · simp only [ptB, fullIdx, Fin.val_last, lt_irrefl, if_false]; rw [boxIx_last, hmod]
  · simp only [ptB, fullIdx, Fin.val_castSucc, k.isLt, if_true]
    rw [boxIx_castSucc t hr, hdiv]; rfl

@[simp] theorem castR_rfl {a : ℕ} (L : List (Fin a → ℂ)) : castR rfl L = L := by
  simp [castR]

theorem norm_rec_le (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (w : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {C : ℝ}
    (hC : 0 ≤ C) (hw : ‖w‖ ≤ C) : ∀ v ∈ recL t w, ‖v‖ ≤ C := by
  intro v hv
  simp only [recL, List.mem_map] at hv
  obtain ⟨j, -, rfl⟩ := hv
  exact pi_le hC fun c => (norm_le_pi_norm w _).trans hw

theorem rec_in (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (r : ℕ) (hr : t (Fin.last D) = r)
    (p : ℕ) {zs : List GI} {w : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ} (h : RepFull p t zs w) :
    RecRep r p zs (castR hr (recL t w)) ∧ (castR hr (recL t w)).length = (tsOf t).prod ∧
      (‖w‖ ≤ 1 → ∀ v ∈ castR hr (recL t w), ‖v‖ ≤ 1) := by
  subst hr
  simp only [castR_rfl]
  refine ⟨⟨?_, fun j c hj => ?_⟩, recL_length t w, fun hw => norm_rec_le t w zero_le_one hw⟩
  · rw [RepFull.length h, recL_length, prod_box]
  · rw [recL_length] at hj
    have hx : j * t (Fin.last D) + c < (List.ofFn t).prod := by
      rw [prod_ofFn', ← prod_box]; nlinarith [c.isLt]
    have := h.2 _ hx
    rw [show (fun i => ((boxIx t (j * t (Fin.last D) + c) i : ℕ) : ZMod (t i))) =
      fullIdx t j c from ptB_rec t j c c.isLt, gC_eq_toC] at this
    rw [this, recL_getD t w hj]

theorem boxOf_fullIdx (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (xs : List (Fin (t (Fin.last D)) → ℂ)) (j : ℕ) (hj : j < (tsOf t).prod)
    (c : Fin (t (Fin.last D))) : boxOf t xs (fullIdx t j c) = xs.getD j 0 c := by
  simp only [boxOf]
  have e : (Equiv.ofBijective _ (phiB_bij t)).symm (fullIdx t j c) = (⟨j, hj⟩, c) :=
    (Equiv.ofBijective _ (phiB_bij t)).symm_apply_apply (⟨j, hj⟩, c)
  rw [e]

theorem rec_out (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)] (r : ℕ) (hr : t (Fin.last D) = r)
    (p : ℕ) (f g : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {zh : List GI}
    {xh : List (Fin r → ℂ)} {E : ℝ} (hE : 0 ≤ E) (hrep : RecRep r p zh xh)
    (hl : xh.length = (tsOf t).prod)
    (herr : ∀ j < (tsOf t).prod, ∀ k : Fin r,
      ‖xh.getD j 0 k - (mrL r (tsOf t) (castR hr (recL t f)) (castR hr (recL t g))).getD j 0 k‖ ≤ E) :
    RepFull p t zh (boxOf t (castR hr.symm xh)) ∧
      ‖boxOf t (castR hr.symm xh) - mrX t f g‖ ≤ E := by
  subst hr
  simp only [castR_rfl] at *
  refine ⟨⟨?_, fun x hx => ?_⟩, mrt_err_of_list t f g hE hl herr⟩
  · rw [hrep.1, hl, prod_box, prod_ofFn']
  · have hr0 : 0 < t (Fin.last D) := Nat.pos_of_ne_zero (NeZero.ne _)
    rw [prod_ofFn', ← prod_box] at hx
    have hj : x / t (Fin.last D) < (tsOf t).prod := by rw [Nat.div_lt_iff_lt_mul hr0]; exact hx
    have hc : x % t (Fin.last D) < t (Fin.last D) := Nat.mod_lt _ hr0
    have ex : x = x / t (Fin.last D) * t (Fin.last D) + x % t (Fin.last D) :=
      (Nat.div_add_mod' x _).symm
    have hp := ptB_rec t (x / t (Fin.last D)) (x % t (Fin.last D)) hc
    rw [← ex] at hp
    rw [show (fun i => ((boxIx t x i : ℕ) : ZMod (t i))) = ptB t x from rfl, hp,
      boxOf_fullIdx t xh _ hj ⟨_, hc⟩, gC_eq_toC]
    have := hrep.2 (x / t (Fin.last D)) ⟨_, hc⟩ (by rw [hl]; exact hj)
    simp only at this
    rw [← ex] at this
    exact this

/-! ## Bit sizes -/

theorem zsz_of_norm {p k : ℕ} {z : GI} (h : ‖toC z‖ ≤ 2 ^ (p + k)) :
    zsz z.1 ≤ p + k + 2 ∧ zsz z.2 ≤ p + k + 2 := by
  have h1 : |(toC z).re| ≤ 2 ^ (p + k) := (Complex.abs_re_le_norm _).trans h
  have h2 : |(toC z).im| ≤ 2 ^ (p + k) := (Complex.abs_im_le_norm _).trans h
  simp only [toC, add_re, intCast_re, mul_re, I_re, mul_zero, intCast_im, I_im, mul_one,
    sub_self, add_zero, add_im, mul_im, zero_add] at h1 h2
  have hp : (2 : ℝ) ^ (p + k) < 2 ^ (p + k + 2) := pow_lt_pow_right₀ (by norm_num) (by omega)
  constructor
  · apply zsz_le_of_lt
    have : ((z.1.natAbs : ℕ) : ℝ) < ((2 ^ (p + k + 2) : ℕ) : ℝ) := by
      rw [Nat.cast_natAbs]; push_cast
      have : |((z.1 : ℤ) : ℝ)| = ((|z.1| : ℤ) : ℝ) := by push_cast; rfl
      linarith [this]
    exact_mod_cast this
  · apply zsz_le_of_lt
    have : ((z.2.natAbs : ℕ) : ℝ) < ((2 ^ (p + k + 2) : ℕ) : ℝ) := by
      rw [Nat.cast_natAbs]; push_cast
      linarith
    exact_mod_cast this

theorem GB_of_repFull {d : ℕ} {p k : ℕ} {t : Fin d → ℕ} [∀ i, NeZero (t i)] {zs : List GI}
    {w : ((i : Fin d) → ZMod (t i)) → ℂ} (h : RepFull p t zs w) (hw : ‖w‖ ≤ 2 ^ k) :
    GB (p + k + 2) zs := by
  intro z hz
  obtain ⟨x, hx, rfl⟩ := List.getElem_of_mem hz
  apply zsz_of_norm
  have hx' : x < (List.ofFn t).prod := by rw [← h.1]; exact hx
  have := h.2 x hx'
  rw [List.getD_eq_getElem _ _ hx, gC_eq_toC] at this
  rw [this, norm_mul, norm_pow, Complex.norm_ofNat, pow_add]
  exact mul_le_mul_of_nonneg_left ((norm_le_pi_norm w _).trans hw) (by positivity)

/-! ## The per-call ring convolution -/

theorem mrtCall_eq (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g h : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) : mrtCall t f g h f g = h := by
  simp [mrtCall]

theorem mrtCall_err (t : Fin (D + 1) → ℕ) [∀ i, NeZero (t i)]
    (f g h : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) {E : ℝ} (hE : 0 ≤ E)
    (hh : ‖h - mrX t f g‖ ≤ E) (a b : ((i : Fin (D + 1)) → ZMod (t i)) → ℂ) :
    ‖mrtCall t f g h a b - mrX t a b‖ ≤ E := by
  unfold mrtCall
  split_ifs with hab
  · obtain ⟨rfl, rfl⟩ := hab; exact hh
  · simpa using hE

end

end NLogN.KFZ

end

section
-- Source module: Solutions.KFZMath
/-!
# KFZ Math: the four fixed tables of the chirp procedure

For a box `t : Fin (D+1) → ℕ` (every `t_i ∈ {2^h, 2^{h+1}}`, `t_D = 2^{h+1}`), sources `s ≤ t`,
the working precision `Δ = 2p + 2h + d + 8` and the shift `g = p + 2h + d + 8` (`p + g = Δ`):

* `A0 = chirpArr Δ`, `bL = A0.map (gtr g)` (`b̃ = Q_p(chirp)`), `aL = conj bL` (`ã`);
* `τ = twTab Δ (2r) 1 r` rounded by `gtr g`, `tL = τ` repeated `∏_{i<D} t_i` times (`θ̃`),
  `iL = conj tL` (`θ̃⁻`).

The precision bound `d (8T² + 2) 2^{-Δ} ≤ 2^{-(2p+2)}` makes them `Phases` (`phases_QA`).
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM Complex

noncomputable section

/-! ## Precision -/

theorem hp_trade (X k m : ℕ) (hX : X ≤ 2 ^ k) : (X : ℝ) * (2 : ℝ)⁻¹ ^ (m + k) ≤ (2 : ℝ)⁻¹ ^ m := by
  rw [pow_add]
  have h1 : (X : ℝ) ≤ 2 ^ k := by exact_mod_cast hX
  have h2 : (2 : ℝ) ^ k * (2 : ℝ)⁻¹ ^ k = 1 := by rw [← mul_pow]; norm_num
  have h3 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ m := by positivity
  have h4 : (0 : ℝ) ≤ (2 : ℝ)⁻¹ ^ k := by positivity
  calc (X : ℝ) * ((2 : ℝ)⁻¹ ^ m * (2 : ℝ)⁻¹ ^ k) = (2 : ℝ)⁻¹ ^ m * ((X : ℝ) * (2 : ℝ)⁻¹ ^ k) := by
        ring
    _ ≤ (2 : ℝ)⁻¹ ^ m * ((2 : ℝ) ^ k * (2 : ℝ)⁻¹ ^ k) := by gcongr
    _ = _ := by rw [h2, mul_one]

theorem dlV_split (p h d : ℕ) : dlV p h d = (2 * p + 2) + (2 * h + d + 6) := by unfold dlV; ring

theorem p_gV (p h d : ℕ) : p + gV p h d = dlV p h d := by unfold gV dlV; ring

theorem chirp_prec (p h d : ℕ) :
    (d : ℝ) * (8 * ((2 ^ (h + 1) : ℕ) : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ dlV p h d ≤
      (2 : ℝ)⁻¹ ^ (2 * p + 2) := by
  have hN : d * (8 * (2 ^ (h + 1)) ^ 2 + 2) ≤ 2 ^ (2 * h + d + 6) := by
    have h1 : d ≤ 2 ^ d := (Nat.lt_two_pow_self).le
    have h2 : 8 * (2 ^ (h + 1)) ^ 2 + 2 ≤ 2 ^ (2 * h + 6) := by
      have : (2 ^ (h + 1)) ^ 2 = 2 ^ (2 * h + 2) := by rw [← pow_mul]; ring_nf
      rw [this]
      have e : 2 ^ (2 * h + 6) = 16 * 2 ^ (2 * h + 2) := by
        rw [show 2 * h + 6 = (2 * h + 2) + 4 by ring, pow_add]; ring
      have : 1 ≤ 2 ^ (2 * h + 2) := Nat.one_le_two_pow
      omega
    calc d * (8 * (2 ^ (h + 1)) ^ 2 + 2) ≤ 2 ^ d * 2 ^ (2 * h + 6) := Nat.mul_le_mul h1 h2
      _ = 2 ^ (2 * h + d + 6) := by rw [← pow_add]; ring_nf
  have := hp_trade _ _ (2 * p + 2) hN
  rw [← dlV_split] at this
  calc (d : ℝ) * (8 * ((2 ^ (h + 1) : ℕ) : ℝ) ^ 2 + 2) * (2 : ℝ)⁻¹ ^ dlV p h d =
      ((d * (8 * (2 ^ (h + 1)) ^ 2 + 2) : ℕ) : ℝ) * (2 : ℝ)⁻¹ ^ dlV p h d := by push_cast; ring
    _ ≤ _ := this

theorem tw_prec (p h d : ℕ) :
    4 * ((2 ^ (h + 1) : ℕ) : ℝ) * (2 : ℝ)⁻¹ ^ dlV p h d ≤ (2 : ℝ)⁻¹ ^ (2 * p + 2) := by
  have hN : 4 * 2 ^ (h + 1) ≤ 2 ^ (2 * h + d + 6) := by
    calc 4 * 2 ^ (h + 1) = 2 ^ (h + 3) := by rw [pow_add, pow_add]; ring
      _ ≤ _ := Nat.pow_le_pow_right (by norm_num) (by omega)
  have := hp_trade _ _ (2 * p + 2) hN
  rw [← dlV_split] at this
  calc 4 * ((2 ^ (h + 1) : ℕ) : ℝ) * (2 : ℝ)⁻¹ ^ dlV p h d =
      ((4 * 2 ^ (h + 1) : ℕ) : ℝ) * (2 : ℝ)⁻¹ ^ dlV p h d := by push_cast; ring
    _ ≤ _ := this

theorem prec_le_one (p : ℕ) : (2 : ℝ)⁻¹ ^ (2 * p + 2) ≤ 1 :=
  pow_le_one₀ (by norm_num) (by norm_num)

/-! ## The tables -/

variable (p h D : ℕ) (sv t : Fin (D + 1) → ℕ)

theorem length_A0 : (A0 p h D sv t).length = ∏ i, t i := length_chirpArr _ _ _ _
theorem length_bLz : (bLz p h D sv t).length = ∏ i, t i := by
  rw [bLz, List.length_map, length_A0]
theorem length_aLz : (aLz p h D sv t).length = ∏ i, t i := by
  rw [aLz, List.length_map, length_bLz]

theorem length_τz : (τz p h D).length = 2 ^ (h + 1) := by rw [τz, List.length_map, length_twz]

variable {t} in
theorem length_tLz (htl : t (Fin.last D) = 2 ^ (h + 1)) : (tLz p h D t).length = ∏ i, t i := by
  rw [tLz, length_repl, length_τz, ← htl, Fin.prod_univ_castSucc]

variable {t} in
theorem length_iLz (htl : t (Fin.last D) = 2 ^ (h + 1)) : (iLz p h D t).length = ∏ i, t i := by
  rw [iLz, List.length_map, length_tLz p h D htl]

variable {p h D sv t}

section Box

variable [∀ i, NeZero (t i)]

theorem zt_eq (h : ℕ) :
    zt h = exp (2 * Real.pi * I * ((1 : ℕ) : ℂ) / ((2 ^ (h + 2) : ℕ) : ℂ)) := by
  unfold zt zetaR
  congr 2
  push_cast; ring

theorem bt_eq : decB p t (bLz p h D sv t) = QA p (decB (dlV p h (D + 1)) t (A0 p h D sv t)) := by
  rw [bLz, decB_gtr, p_gV]

theorem phases_bt (hst : ∀ i, sv i ≤ t i) (hT : ∀ i, t i ≤ 2 ^ (h + 1)) :
    Phases p (IntMul.OpenAI.RC.chirp sv t) (decB p t (bLz p h D sv t)) := by
  rw [bt_eq]
  refine phases_QA p (norm_chirp_le sv t) (fun K => ?_)
  rw [A0, decB_chirpArr]
  have hpr := chirp_prec p h (D + 1)
  refine (chirpEnt_err _ sv t hst (2 ^ (h + 1)) hT ?_ K).trans ?_
  · exact hpr.trans (prec_le_one p)
  · exact_mod_cast hpr

theorem grid_bt : Grid p (decB p t (bLz p h D sv t)) := by rw [bt_eq]; exact QA_grid _ _

theorem at_eq : decB p t (aLz p h D sv t) = cnj (decB p t (bLz p h D sv t)) := by
  rw [aLz, decB_gconj]

theorem phases_at (hst : ∀ i, sv i ≤ t i) (hT : ∀ i, t i ≤ 2 ^ (h + 1)) :
    Phases p (fun j => (starRingEnd ℂ) (IntMul.OpenAI.RC.chirp sv t j))
      (decB p t (aLz p h D sv t)) := by
  rw [at_eq]; exact Phases.cnj' (phases_bt hst hT)

theorem θt_eq (htl : t (Fin.last D) = 2 ^ (h + 1)) :
    decB p t (tLz p h D t) = QA p (twv p h D t) := by
  funext K
  rw [tLz, decB_repl p t (τz p h D) (by rw [length_τz, htl]) K, τz,
    getD_map0 (by simp [KFH.gtr]), toC_gtr, p_gV]
  rfl

theorem twv_err (htl : t (Fin.last D) = 2 ^ (h + 1)) (K : (i : Fin (D + 1)) → ZMod (t i)) :
    ‖twv p h D t K - twX t (zt h) K‖ ≤ (2 : ℝ)⁻¹ ^ (2 * p + 2) := by
  have hm : (K (Fin.last D)).val < 2 ^ (h + 1) := by
    have := ZMod.val_lt (K (Fin.last D)); omega
  have hu : ((2 ^ (h + 1) : ℕ) : ℝ) * (4 * (2 : ℝ)⁻¹ ^ dlV p h (D + 1)) ≤ 1 := by
    have := (tw_prec p h (D + 1)).trans (prec_le_one p); linarith
  have e := twTab_err (dlV p h (D + 1)) (2 ^ (h + 2)) 1 (2 ^ (h + 1)) (by positivity) hu _ hm
  unfold twv twX
  rw [zt_eq, List.getD_eq_getElem _ _ (by rw [length_twz]; exact hm)]
  refine e.trans ?_
  have := tw_prec p h (D + 1)
  push_cast at this ⊢
  linarith

theorem phases_θt (htl : t (Fin.last D) = 2 ^ (h + 1)) :
    Phases p (twX t (zt h)) (decB p t (tLz p h D t)) := by
  rw [θt_eq htl]
  exact phases_QA p (fun K => norm_twX t _ K) (twv_err htl)

theorem θit_eq : decB p t (iLz p h D t) = cnj (decB p t (tLz p h D t)) := by
  rw [iLz, decB_gconj]

theorem phases_θit (htl : t (Fin.last D) = 2 ^ (h + 1)) :
    Phases p (fun j => (twX t (zt h) j)⁻¹) (decB p t (iLz p h D t)) := by
  rw [θit_eq]
  have e : (fun j => (twX t (zt h) j)⁻¹) = fun j => (starRingEnd ℂ) (twX t (zt h) j) := by
    funext j; exact twX_inv t _ j
  rw [e]; exact Phases.cnj' (phases_θt htl)

theorem zt_pow (htl : t (Fin.last D) = 2 ^ (h + 1)) : zt h ^ t (Fin.last D) = -1 := by
  rw [htl]; exact zetaR_pow _ (by positivity)

/-! ## Norms and bit sizes -/

theorem Phases.norm_le {ι : Type*} [Fintype ι] {θ θt : ι → ℂ} (hP : Phases p θ θt) : ‖θt‖ ≤ 1 :=
  pi_le zero_le_one hP.t1

theorem gb_of_box {zs : List GI} (hl : zs.length = ∏ i, t i) (hn : ‖decB p t zs‖ ≤ 1) :
    GB (p + 2) zs := by
  have := GB_of_repFull (k := 0) (repFull_decB p t zs hl) (by simpa using hn)
  simpa using this

end Box

end

end NLogN.KFZ

end

section
-- Source module: Solutions.KFZParam
/-!
# KFZ Param: the chirp procedure parameters for `n`

For `n ≥ n0` and `dP n = D + 1`: `h = ℓ - 1`, `σ = D + 1 - dpN n`, bits `bs`, sources `ss`.
`tBD n D i = 2^{h + bit i}`, `(D+1) h + σ = L`, `∏ t = 2^L`, the setup descriptor is
`descChirpN n`, the chirp-table descriptor is `descT (sBD n D) (tBD n D)`, and the register width
`B` satisfies `RB` and `B ≤ 5 p`.
-/

set_option autoImplicit false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFZ

open IntMul NLogN.KIL KFB NLogN.KFM IntMul.OpenAI.Glue IntMul.OpenAI.RP

noncomputable section

theorem sum_bits (a : ℕ) : ∀ m : ℕ,
    ((List.range m).map (fun j => if a ≤ j then 1 else 0)).sum = m - a
  | 0 => by simp
  | m + 1 => by
    rw [List.range_succ, List.map_append, List.sum_append, sum_bits a m]
    simp only [List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
    split_ifs <;> omega

theorem prod_bits (a h : ℕ) : ∀ m : ℕ,
    ∏ j ∈ Finset.range m, 2 ^ (h + if a ≤ j then 1 else 0) = 2 ^ (m * h + (m - a))
  | 0 => by simp
  | m + 1 => by
    rw [Finset.prod_range_succ, prod_bits a h m, ← pow_add]
    congr 1
    split_ifs <;> (rw [Nat.succ_mul]; omega)

end

end NLogN.KFZ

