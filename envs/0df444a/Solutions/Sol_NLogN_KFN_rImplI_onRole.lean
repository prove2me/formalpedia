    (hC.p.upd0 _) B3
  refine ⟨NLogN.KFG.swapsL L (NLogN.KFN.swL w.val) zs3, ?_, ?_, ?_⟩
  · have R4 := NLogN.KFN.rec_of_enc hr (Y := fun v => Y2 (σ v)) (fun v => hY2 _) E4 (fun v j hj c => by
      beta_reduce; rw [hsw v, NLogN.KFN.yR_val hr Y2 (σ v) j c])
    have hfam : (fun v => Y2 (σ v)) = Function.update X w (NLogN.KFN.selOpF st' n Tw (X w)) := by
      funext v
      simp only [Y2, X1, Function.update_apply]
