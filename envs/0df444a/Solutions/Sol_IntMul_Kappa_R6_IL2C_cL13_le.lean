-- Source module: Solutions.KFDRot
/-!
# KFD: the fine block rotation `rotP`

Fine specification of KILRot's `rotP` (program unchanged).  Every record move is a fine `mvK`
(`O(B·(w+2))` for a record of `B` entries of size `≤ w`), every per-block number (`Q`, `a_p`,
`Q - a_p`) is bounded by `Q` itself (`zsz Q ≤ Q`), so a block of `Q` records costs
`O(Q·B·(w+2))`; one multiplication `P·Q·B` per call costs `O((Bb+2)^2)`.

`rotP_fspec`: `rotP` at cost `≤ 10^6 (P·Q·B + 1)(w + 2) + 10^8 (Bb + 2)^2`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul RS

namespace KFD

open KIL AModel

section Proof

variable (s : IState HS) (r : ℕ → ℕ → List ℤ) (P Q B w : ℕ) (as : ℕ → ℕ)

theorem cRotF_le {P Q B w Bb : ℕ} (hB1 : 1 ≤ B) (hQ1 : 1 ≤ Q) :
    cRotF P Q B w Bb ≤ 10 ^ 6 * (P * (Q * B) + 1) * (w + 2) + 10 ^ 8 * (Bb + 2) ^ 2 := by
  unfold cRotF cRBlkF cRecF
  have hQB : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB1
  have h1 : P * Q ≤ P * (Q * B) := Nat.mul_le_mul_left _ hQB
  have h2 : P * (Q * (B + 1)) ≤ 2 * (P * (Q * B)) := by nlinarith
  have hw : 2 ≤ w + 2 := by omega
  set V := P * (Q * B)
  have e1 : P * (4 * (8000 * (Q + 2) + (1500 * Q + 1200) + Q * (3000 * (B + 1) * (w + 2))) +
      (2 * Q + 2) + 1100) = 4 * 8000 * (P * Q) + 4 * 16000 * P + 4 * 1500 * (P * Q) + 4 * 1200 * P +
      12000 * (P * (Q * (B + 1))) * (w + 2) + 2 * (P * Q) + 2 * P + 1100 * P := by ring
  have hPV : P ≤ V := le_trans (Nat.le_mul_of_pos_right _ hQ1) h1
  have hB2 : Bb + 2 ≤ (Bb + 2) ^ 2 := by nlinarith
  rw [e1]
  have h4 : 12000 * (P * (Q * (B + 1))) * (w + 2) ≤ 24000 * V * (w + 2) := by
    have := Nat.mul_le_mul_right (w + 2) (Nat.mul_le_mul_left 12000 h2); nlinarith
  have h5 : V * (w + 2) ≥ V * 2 := Nat.mul_le_mul_left _ hw
  have h6 : V * (250 * (w + 2)) = 250 * (V * (w + 2)) := by ring
  have e2 : 10 ^ 6 * (V + 1) * (w + 2) = 10 ^ 6 * (V * (w + 2)) + 10 ^ 6 * (w + 2) := by ring
  rw [h6, e2]
  nlinarith

end Proof

end KFD

end NLogN

