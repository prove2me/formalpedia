theorem encK_upd (s : IState HS) (f : Fin HS → List ℤ) (i : Fin HS) (l : List ℤ) :
    (NLogN.KIL.encK s f).upd i (ints l ++ s.G i) = NLogN.KIL.encK s (Function.update f i l) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases h : j = i
  · subst h; simp
  · simp [h]

