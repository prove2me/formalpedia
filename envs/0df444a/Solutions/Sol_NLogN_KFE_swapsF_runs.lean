    obtain ⟨y, a2, rfl, hy, h2⟩ := valid_cons_split h1
    obtain ⟨b, a3, rfl, hb, h3⟩ := valid_app_split h2
    obtain ⟨x, c, rfl, hx, hc⟩ := valid_cons_split h3
