theorem fAnalytic_eq_gAnalytic (q : ℂ) (hq : ‖q‖ < 1) :
    fAnalytic q = gAnalytic q := by
  unfold fAnalytic gAnalytic
  exact jacobiIdentity_pochhammer q hq

