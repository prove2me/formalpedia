set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.FWW
open IntMul IntMul.HvdH NLogN NLogN.FW
theorem solution (M : NLogN.MulSpec) (q : Ref.Params) (kb : ℕ) (hP : 1 ≤ q.P)
    (hkb : q.logOuter ≤ kb) (U V : List (ℤ × ℤ))
    (hUl : U.length = 2 ^ q.logOuter * q.r) (hVl : V.length = 2 ^ q.logOuter * q.r) :
    (Ref.fermatW q U V).length = 2 ^ q.logOuter * q.r ∧
      ∀ p ∈ Ref.fermatW q U V, |p.1| < 2 ^ (q.P + 2) ∧ |p.2| < 2 ^ (q.P + 2) := by
  constructor
  · have hr1 : 1 ≤ q.r := Nat.one_le_two_pow
    have hfn : q.fn = 4 * q.r * q.P := rfl
    have hfn1 : 1 ≤ q.fn := by rw [hfn]; nlinarith
    have her : q.e < q.r := Nat.lt_two_pow_self
    have hrfn : q.r ≤ q.fn := by rw [hfn]; nlinarith
    set W := NLogN.FW.fwW q kb with hWd
    have hW1 : 2 * q.fn + kb + 3 = W := rfl
    set N := 2 ^ q.logOuter with hNd
    set D := NLogN.FW.descs q.outerAxes 1 with hDd
    have hNkb : N ≤ 2 ^ kb := Nat.pow_le_pow_right (by norm_num) hkb
    have hLD : NLogN.FW.LvlOK q.fn kb W N q.e D := NLogN.FW.lvlOK_params q kb W
    have hJ : q.e + 1 ≤ W := by omega
    have hWW : 2 * q.fn + kb + 3 ≤ W := le_rfl
    have pF := NLogN.FW.passOK_dif M q.fn kb W N q.e D hLD hfn1 hNkb hWW hJ
    have pT := NLogN.FW.passOK_dit M q.fn kb W N q.e D.reverse hLD.reverse hfn1 hNkb hWW hJ
    set EA := (Ref.chunkL q.r U).map (NLogN.FW.encRes q.P q.r) with hEA
    set EB := (Ref.chunkL q.r V).map (NLogN.FW.encRes q.P q.r) with hEB
    have hEAl : EA.length = N := by
      rw [hEA, List.length_map]; exact NLogN.FW.chunkL_length_mul _ _ hr1 U hUl
    have hEBl : EB.length = N := by
      rw [hEB, List.length_map]; exact NLogN.FW.chunkL_length_mul _ _ hr1 V hVl
    have hEAc : NLogN.Canon (2 ^ q.fn + 1) EA := fun x hx => by
      rw [hEA, List.mem_map] at hx; obtain ⟨b, _, rfl⟩ := hx; exact NLogN.FW.encRes_canon _ _ _
    have hEBc : NLogN.Canon (2 ^ q.fn + 1) EB := fun x hx => by
      rw [hEB, List.mem_map] at hx; obtain ⟨b, _, rfl⟩ := hx; exact NLogN.FW.encRes_canon _ _ _
    set FA := NLogN.FW.lvls (NLogN.FW.Gd q.fn) D EA with hFA
    set FB := NLogN.FW.lvls (NLogN.FW.Gd q.fn) D EB with hFB
    obtain ⟨hFAl, hFAc⟩ := NLogN.FW.lvls_all M _ _ _ _ _ _ _ _ D pF EA hEAl hEAc
    obtain ⟨hFBl, hFBc⟩ := NLogN.FW.lvls_all M _ _ _ _ _ _ _ _ D pF EB hEBl hEBc
    set PM := Ref.pmulZ (2 ^ q.fn + 1) FA FB with hPM
    have hPMl : PM.length = N := by rw [hPM, NLogN.FW.length_pmulZ _ _ _ (by rw [hFAl, hFBl]), hFAl]
    have hPMc : NLogN.Canon (2 ^ q.fn + 1) PM := NLogN.FW.canon_pmulZ'' _ _ _
    set CC := NLogN.FW.lvls (NLogN.FW.Gt q.fn) D.reverse PM with hCC
    obtain ⟨hCCl, hCCc⟩ := NLogN.FW.lvls_all M _ _ _ _ _ _ _ _ D.reverse pT PM hPMl hPMc
    rw [NLogN.FW.fermatW_eq q U V hEAl hEBl hPMl, NLogN.FW.length_flatMap_decBlk, List.length_map, hCCl]
  · intro p hp
    unfold Ref.fermatW at hp
    simp only [List.mem_flatMap] at hp
    obtain ⟨z, _, hp⟩ := hp
    obtain ⟨b1, b2⟩ := NLogN.FW.decBlk_bound _ _ _ z p hp
    have h4 : (2 : ℤ) * 2 ^ q.P < 2 ^ (q.P + 2) := by
      rw [pow_add]; have : (0 : ℤ) < 2 ^ q.P := by positivity
      nlinarith
    exact ⟨b1.trans_lt h4, b2.trans_lt h4⟩
end
