theorem corner_smul_comm {𝒪 : Type} [CommRing 𝒪] {𝕋 : Type} [CommRing 𝕋] [Algebra 𝒪 𝕋]
    {V : Type} [AddCommGroup V] [Module 𝒪 V] [Module 𝕋 V] [IsScalarTower 𝒪 𝕋 V]
    (cd : CornerData (𝒪 := 𝒪) 𝕋 V) (a : cd.cornerRing) (c : 𝒪) (m : cd.cornerModule) :
    a • (c • m) = c • (a • m) := by
  apply Subtype.ext
  rw [IdempotentSplitting.coe_cornerSmul, Submodule.coe_smul_of_tower, Submodule.coe_smul_of_tower,
    IdempotentSplitting.coe_cornerSmul, smul_comm]

