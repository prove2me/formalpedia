variable {K}

private theorem inducedCoeff_mul_comp_idelicNorm_of_isUnramifiedCharAt (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K)) (hμ : IsUnramifiedCharAt μ 𝔓)
    (he : (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hχ : IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ))) :
    inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      inducedCoeff K μ 𝔓 *
        ((χ (uniformizerIdele ℚ (𝔓.under (𝓞 ℚ))) : ℂˣ) : ℂ) ^
          (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal := by
  have hval := apply_idelicNorm_uniformizerIdele K χ 𝔓 hχ
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hT : IsUnramifiedCharAt (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 := by
    refine isUnramifiedCharAt_of_hasConductorExponentAt_zero ?_
    have hw := hasConductorExponentAt_comp_norm_of_ramificationIdx_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ he _ 0
      (hasConductorExponentAt_zero_of_isUnramifiedCharAt hχ)
    have hsplit := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
    rw [show localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = _ from hsplit]
    exact hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K _ _ _ 0
      (hasConductorExponentAt_zero_of_isUnramifiedCharAt hμ) hw
  rw [inducedCoeff, inducedCoeff, if_pos hT, if_pos hμ, MonoidHom.mul_apply, MonoidHom.comp_apply, hval,
    Units.val_mul, Units.val_pow_eq_pow_val]

private theorem inducedCoeff_mul_comp_idelicNorm_of_not_isUnramifiedCharAt (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K)) (hμ : IsUnramifiedCharAt μ 𝔓)
    (he : (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1)
    (hc : Continuous (localChar χ (𝔓.under (𝓞 ℚ)))) (hχ : ¬ IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ))) :
    inducedCoeff K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = 0 := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  obtain ⟨a, ha⟩ := exists_hasConductorExponentAt_of_continuous ℚ (𝔓.under (𝓞 ℚ)) _ hc
  have ha0 : a ≠ 0 := by
    rintro rfl
    exact hχ (isUnramifiedCharAt_of_hasConductorExponentAt_zero ha)
  have hw := hasConductorExponentAt_comp_norm_of_ramificationIdx_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ he _ a ha
  have hT : HasConductorExponentAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) a := by
    have hsplit := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
    rw [show localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = _ from hsplit]
    rw [show ∀ f g : (𝔓.adicCompletion K)ˣ →* ℂˣ, f * g = g * f from fun f g => mul_comm f g]
    exact hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K _ _ _ a hw
      (hasConductorExponentAt_zero_of_isUnramifiedCharAt hμ)
  rw [inducedCoeff, if_neg]
  intro hunr
  exact ha0 (hasConductorExponentAt_unique K 𝔓 hT (hasConductorExponentAt_zero_of_isUnramifiedCharAt hunr))

end

private theorem exists_mem_normOneIdeles_mul_comp_idelicNorm_ne_one (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ)
    (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (hχ : IsAdmissibleTwist ℚ χ)
    (hT : IsAdmissibleTwist K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm))
    (hnormAdm : ∀ t : ℝ, IsAdmissibleTwist ℚ (normPowChar ℚ t))
    (hnormQ : ∀ (t : ℝ) (v : HeightOneSpectrum (𝓞 ℚ)), IsUnramifiedCharAt (normPowChar ℚ t) v)
    (hnormK : ∀ (t : ℝ) (𝔓 : HeightOneSpectrum (𝓞 K)), IsUnramifiedCharAt (normPowChar K t) 𝔓)
    (hns : ¬ (∃ η : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ, IsAdmissibleTwist ℚ η ∧
      ∀ 𝔓 : HeightOneSpectrum (𝓞 K), IsUnramifiedCharAt μ 𝔓 →
        IsUnramifiedCharAt η (𝔓.under (𝓞 ℚ)) →
        ((μ (uniformizerIdele K 𝔓) : ℂˣ) : ℂ) =
          ((η (uniformizerIdele ℚ (𝔓.under (𝓞 ℚ))) : ℂˣ) : ℂ) ^
            (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal)) :
    ∃ x ∈ normOneIdeles K, (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) x ≠ 1 := by
  by_contra hcon
  have hall : ∀ x ∈ normOneIdeles K, (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) x = 1 :=
    fun x hx => Classical.not_not.mp fun h => hcon ⟨x, hx, h⟩
  obtain ⟨t, ht⟩ := exists_eq_normPowChar_of_forall_mem_normOneIdeles K _ hT.2.1 hT.2.2 hall
  refine hns ⟨χ⁻¹ * normPowChar ℚ t, isAdmissibleTwist_mul ℚ (isAdmissibleTwist_inv ℚ hχ) (hnormAdm t),
    fun 𝔓 hμ𝔓 hη => ?_⟩

  have hχv : IsUnramifiedCharAt χ (𝔓.under (𝓞 ℚ)) := by
    intro u hu hu'
    have h1 := hη u hu hu'
    have h2 := hnormQ t (𝔓.under (𝓞 ℚ)) u hu hu'
    have h3 : localChar (χ⁻¹ * normPowChar ℚ t) (𝔓.under (𝓞 ℚ)) u =
        (localChar χ (𝔓.under (𝓞 ℚ)) u)⁻¹ * localChar (normPowChar ℚ t) (𝔓.under (𝓞 ℚ)) u := rfl
    rw [h3, h2, mul_one, inv_eq_one] at h1
    exact h1

  have hK := ite_isUnramifiedCharAt_normPowChar_apply_uniformizerIdele_eq_absNorm_cpow_neg K t 𝔓
  rw [if_pos (hnormK t 𝔓), ← ht, MonoidHom.mul_apply, MonoidHom.comp_apply,
    apply_idelicNorm_uniformizerIdele K χ 𝔓 hχv, Units.val_mul, Units.val_pow_eq_pow_val] at hK
  have hQ := ite_isUnramifiedCharAt_normPowChar_apply_uniformizerIdele_eq_absNorm_cpow_neg ℚ t
    (𝔓.under (𝓞 ℚ))
  rw [if_pos (hnormQ t _)] at hQ

  have habs : (Ideal.absNorm 𝔓.asIdeal : ℂ) =
      ((Ideal.absNorm (𝔓.under (𝓞 ℚ)).asIdeal : ℕ) : ℂ) ^ (𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal := by
    obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
    haveI : 𝔓.asIdeal.LiesOver (𝔓.under (𝓞 ℚ)).asIdeal := Ideal.over_under 𝔓.asIdeal
    have h := Ideal.absNorm_eq_pow_inertiaDeg_of_liesOver 𝔓.asIdeal (𝔓.under (𝓞 ℚ)).asIdeal
      (𝔓.under (𝓞 ℚ)).isPrime (𝔓.under (𝓞 ℚ)).ne_bot
    exact_mod_cast h
  have hχ0 : ((χ (uniformizerIdele ℚ (𝔓.under (𝓞 ℚ))) : ℂˣ) : ℂ) ≠ 0 := Units.ne_zero _
  rw [MonoidHom.mul_apply, MonoidHom.inv_apply, Units.val_mul, Units.val_inv_eq_inv_val, hQ, mul_pow,
    inv_pow]
  have hlt : -Real.pi < (((𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal : ℕ) : ℝ) *
      (((Ideal.absNorm (𝔓.under (𝓞 ℚ)).asIdeal : ℕ) : ℂ)).arg := by
    simp [Complex.natCast_arg, Real.pi_pos]
  have hle : (((𝔓.under (𝓞 ℚ)).asIdeal.inertiaDeg' 𝔓.asIdeal : ℕ) : ℝ) *
      (((Ideal.absNorm (𝔓.under (𝓞 ℚ)).asIdeal : ℕ) : ℂ)).arg ≤ Real.pi := by
    simp [Complex.natCast_arg, Real.pi_pos.le]
  rw [habs, ← Complex.cpow_nat_mul' hlt hle, Complex.cpow_nat_mul] at hK
  rw [← hK, mul_comm ((μ (uniformizerIdele K 𝔓) : ℂˣ) : ℂ), ← mul_assoc, inv_mul_cancel₀ (pow_ne_zero _ hχ0),
    one_mul]

end LanglandsTunnell.CubicInduction.TwistLegs

