lemma cb_sq : Butterfly.cb ^ 2 = -I / 2 := by
  simp only [Butterfly.cb]; ring_nf; rw [I_sq]; ring

/-- (14): `H0 = b S C S`. -/
theorem H0_eq : H0 = Butterfly.cb • (Butterfly.Sm * Butterfly.Cm * Butterfly.Sm) := by
