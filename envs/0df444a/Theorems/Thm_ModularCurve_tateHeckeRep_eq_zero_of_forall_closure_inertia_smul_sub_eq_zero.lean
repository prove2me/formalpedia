theorem ModularCurve.tateHeckeRep_eq_zero_of_forall_closure_inertia_smul_sub_eq_zero
    (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    letI := heckeModuleBar p
    ∀ α ∈ Algebra.adjoin ℤ_[2] (Set.range fun t : HeckeAlg => tateHeckeRep 2 (JZero p) t),
      (∀ s : _root_.TateModule 2 (JZero p),
        (∀ n : ℕ, (s : ℕ → JZero p) n ∈ AddSubgroup.closure {w : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ, ∃ x ∈ eisensteinTorsionBar p 2 M, w = σ • x - x}) → α s = 0) →
      ∀ x : _root_.TateModule 2 (JZero p),
        (∀ n : ℕ, ∃ M : ℕ, (x : ℕ → JZero p) n ∈ eisensteinTorsionBar p 2 M) → α x = 0 := by sorry
