-- title:
--   Lemma A.3: Three tests for a pointed cone generated by a translate
-- statement:
--   Let $C$ be a pointed closed convex cone in a finite-dimensional real vector space $V$, and let $x\in V$. Then
--
--   $$\operatorname{cone}(x+C)=\overline{\mathbb R_{\ge0}x+C},$$
--
--   and the following are equivalent: this cone is pointed; $(x+C)\cap(-C)\subseteq\{0\}$; and $0\notin x+C$ or $x=0$. The closure is essential. At $x=0$ the criterion reduces to pointedness of $C$. This gives a complete test for translated cones.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 28, Lemma A.3: Three tests for a pointed cone generated by a translate

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

section Geometry

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Lemma A.3, PDF p. 28: three tests and the closed radial-sum identity. -/
theorem translatedCone_pointed_criteria [FiniteDimensional ℝ E] (C : Set E) (x : E)
    (hc : ClosedCone C) (hp : Pointed C) :
    closedConeHull (translatedSubset x C) = closure (setSum {y | ∃ t : ℝ, 0 ≤ t ∧ y = t • x} C) ∧
    (Pointed (closedConeHull (translatedSubset x C)) ↔ translatedSubset x C ∩ (Neg.neg '' C) ⊆ ({0} : Set E)) ∧
    (Pointed (closedConeHull (translatedSubset x C)) ↔ (0 : E) ∉ translatedSubset x C ∨ x = 0) := by sorry

end Geometry

end

end QAlgorithms.Papers.Independent.Frontier30.P26
