-- title:
--   Coloured cut norm (3.72), coloured cut distance (3.73) and pure coloured graphons on $[0,1]$
-- statement:
--   For coloured graphons $(W_1,\Psi_1)$, $(W_2,\Psi_2)$ on $[0,1]$ with Lebesgue measure $\lambda$, the **coloured cut norm** is
--   $$
--   \|(W_1,\Psi_1)-(W_2,\Psi_2)\|_\square=\|W_1-W_2\|_\square+\sum_{i=1}^\kappa\|\psi_{1,i}-\psi_{2,i}\|_{L^1},
--   $$
--   and the **coloured cut distance** is
--   $$
--   \delta_\square(W_1,W_2)=\inf_{\varphi_1,\varphi_2}\|W_1^{\varphi_1}-W_2^{\varphi_2}\|_\square ,
--   $$
--   the infimum over measure-preserving bijections $\varphi_1,\varphi_2:[0,1]\to[0,1]$, where $(W,\Psi)^\varphi=(W^\varphi,\Psi\circ\varphi)$. A coloured graphon on $[0,1]$ is **pure** if its colouring is the point mass of a measurable $\chi:[0,1]\to[\kappa]$.
--
--   These are the metrics of Theorem 3.21, which compares them with the topology of §2.4 and with convergence of coloured graph limits.
--
--   **Formalization Note** $[0,1]$ is `unitInterval` with `volume` and its Borel σ-field. A measure-preserving bijection is a bijective measure-preserving map: a Borel bijection of $[0,1]$ has a Borel inverse (Lusin–Souslin), which is then measure-preserving, so this is the paper's class. The infimum is over a nonempty set (identity maps) bounded below by $0$. `colCutTop` is the topology generated by the open balls of (3.72) on `KGraphon volume κ`, and `IsPureKGraphon` says the colouring is `ofColour χ` for a measurable $\chi$.
-- source:
--   Janson, Lo, McDiarmid, Skeja, Skerman, Graphon Colourings and Limits of Graph Partitions, arXiv:2610.38599 (held version, sha256 3d198813a65d248922299a3380e10f238dbc5dcd3be060f7810b462bd5d3d10f), §3.3, (3.72)–(3.73), p.27; Definition 2.1, p.6

import Mathlib
import Definitions.Def_GraphonCheeger_Supplement_KGraphon

open MeasureTheory

set_option warn.classDefReducibility false

namespace GraphonCheeger.Supplement

/-!
# The coloured cut norm (3.72) and the coloured cut distance (3.73) on `[0, 1]`

Janson, Lo, McDiarmid, Skeja, Skerman, *Graphon Colourings and Limits of Graph Partitions*,
arXiv:2610.38599 (held version, sha256 3d198813…), §3.3, (3.72)–(3.73), p.27; pure coloured
graphons, Def. 2.1, p.6.

**Formalization Note.**
* Only graphons on `[0, 1] = unitInterval` with Lebesgue measure (`volume`) are considered (§3.3).
* `colCutNorm W₁ Ψ₁ W₂ Ψ₂ = ‖W₁ − W₂‖_□ + Σ_i ‖ψ_{1,i} − ψ_{2,i}‖_{L¹}` (3.72).
* `colCutDist` (3.73) is the infimum of `colCutNorm` of the pullbacks over pairs of measure-preserving
  bijections `φ₁, φ₂ : [0, 1] → [0, 1]`. A Borel measurable bijection of `[0, 1]` has a Borel
  measurable inverse (Lusin–Souslin), which is then measure-preserving too, so
  "bijective and measure-preserving" is the paper's class of maps. The set is nonempty (identity
  maps) and bounded below by `0`.
* `colCutTop` is the metric topology of (3.72) on `W_κ([0, 1])`, generated by its open balls.
* A pure coloured graphon is one whose colouring is `ofColour χ` for a measurable `χ : [0,1] → [κ]`
  (`IsPureKGraphon`).
-/

/-- The coloured cut norm `‖(W₁, Ψ₁) − (W₂, Ψ₂)‖_□ = ‖W₁ − W₂‖_□ + Σ_{i=1}^κ ‖ψ_{1,i} − ψ_{2,i}‖_{L¹}`
((3.72), p.27). -/
noncomputable def colCutNorm {κ : ℕ} (W₁ : unitInterval → unitInterval → ℝ)
    (Ψ₁ : unitInterval → Fin κ → ℝ) (W₂ : unitInterval → unitInterval → ℝ)
    (Ψ₂ : unitInterval → Fin κ → ℝ) : ℝ :=
  cutNorm volume (fun x y => W₁ x y - W₂ x y) + ∑ i, ∫ x, |Ψ₁ x i - Ψ₂ x i|

/-- The coloured cut distance `δ_□(W₁, W₂) = inf_{φ₁, φ₂} ‖W₁^{φ₁} − W₂^{φ₂}‖_□` ((3.73), p.27),
over measure-preserving bijections `φ₁, φ₂ : [0, 1] → [0, 1]`, with `(W, Ψ)^φ = (W^φ, Ψ ∘ φ)`. -/
noncomputable def colCutDist {κ : ℕ} (W₁ : unitInterval → unitInterval → ℝ)
    (Ψ₁ : unitInterval → Fin κ → ℝ) (W₂ : unitInterval → unitInterval → ℝ)
    (Ψ₂ : unitInterval → Fin κ → ℝ) : ℝ :=
  sInf {r : ℝ | ∃ φ₁ φ₂ : unitInterval → unitInterval,
    Function.Bijective φ₁ ∧ MeasurePreserving φ₁ volume volume ∧
    Function.Bijective φ₂ ∧ MeasurePreserving φ₂ volume volume ∧
    r = colCutNorm (pullback φ₁ W₁) (fun x => Ψ₁ (φ₁ x)) (pullback φ₂ W₂) (fun x => Ψ₂ (φ₂ x))}

/-- The metric topology of the coloured cut norm (3.72) on `W_κ([0, 1])` (§3.3, p.27),
generated by its open balls. -/
def colCutTop (κ : ℕ) : TopologicalSpace (KGraphon (volume : MeasureTheory.Measure unitInterval) κ) :=
  TopologicalSpace.generateFrom {U | ∃ (p : KGraphon (volume : Measure unitInterval) κ) (r : ℝ),
    0 < r ∧ U = {q | colCutNorm q.W q.Ψ p.W p.Ψ < r}}

/-- A pure coloured graphon on `[0, 1]` (Def. 2.1, p.6): its colouring is the point-mass
colouring of a measurable `χ : [0, 1] → [κ]`. -/
def IsPureKGraphon {κ : ℕ} (p : KGraphon (volume : Measure unitInterval) κ) : Prop :=
  ∃ χ : unitInterval → Fin κ, Measurable χ ∧ p.Ψ = ofColour χ

end GraphonCheeger.Supplement


