theorem saL_length (P : Prm) (n j : ℕ) : (saL P n j).length = j := by simp [saL]
theorem maL_length (P : Prm) (n j : ℕ) : (maL P n j).length = j := by simp [maL]

theorem saL_rev (P : Prm) (n j : ℕ) :
    (saL P n j).reverse = (List.range j).map fun i => (src6 P n i : ℤ) := by simp [saL]

theorem maL_rev (P : Prm) (n j : ℕ) :
    (maL P n j).reverse = (List.range j).map fun i => (muR6 (src6 P n) i : ℤ) := by simp [maL]

theorem bitL_eq (P : Prm) (n : ℕ) : bitL (dpN6 P n) (dP6 P n) = bitsZ (dP6 P n) (bL6 P n) := by
  simp [bitL, bitsZ, bL6]

theorem mem_saL {P : Prm} {n j : ℕ} {z : ℤ} (h : z ∈ saL P n j) : ∃ i < j, z = src6 P n i := by
  simp only [saL, List.mem_reverse, List.mem_map, List.mem_range] at h
  obtain ⟨i, hi, rfl⟩ := h; exact ⟨i, hi, rfl⟩

theorem mem_maL {P : Prm} {n j : ℕ} {z : ℤ} (h : z ∈ maL P n j) :
    ∃ i < j, z = muR6 (src6 P n) i := by
  simp only [maL, List.mem_reverse, List.mem_map, List.mem_range] at h
  obtain ⟨i, hi, rfl⟩ := h; exact ⟨i, hi, rfl⟩

