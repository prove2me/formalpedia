variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

theorem length_csOf (c : Fin n → ZMod Q) (A : Shape) : (csOf Λ c A).length = A.length := by
  simp [csOf]

theorem lf_csOf [NeZero Q] (c : Fin n → ZMod Q) (A : Shape) (D : List ℕ)
    (hD : D.length = A.length) :
    ((lf (csOf Λ c A) D : ℕ) : ZMod Q) = ∑ j, c j * ((D.getD (Λ.pos j) 0 : ℕ) : ZMod Q) := by
  rw [lf_eq_sum _ _ (by rw [length_csOf, hD]), length_csOf]
  push_cast
