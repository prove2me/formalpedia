  · unfold tOffline32P
    have := Nat.mul_le_mul_right (tQuery31 ratParamsP D₀ + 30) hw
    omega
  · have := Nat.mul_le_mul_right (D₀ + 1) (show w + 1 ≤ w' + 1 by omega)
    omega

private theorem le_pow_twentyP {Q x : ℕ} (hQ : 1 ≤ Q) (i : ℕ) (hi : i ≤ 20) (h : x ≤ Q ^ i) :
    x ≤ Q ^ 20 :=
  h.trans (Nat.pow_le_pow_right hQ hi)

private theorem two_pow_absorb {a R : ℕ} (hR : 1 ≤ R) (ha : 1 ≤ a) :
    2 ^ 11 * R + a ≤ 2 ^ (11 + a) * R := by
