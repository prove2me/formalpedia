theorem group4_degrees (d : ℕ) (hd : d<24) :
    equalityCheck (aPart d group4_raw) (aPart d group4) = true := by
  interval_cases d
  · exact group4_degree0
  · exact group4_degree1
  · exact group4_degree2
  · exact group4_degree3
  · exact group4_degree4
  · exact group4_degree5
  · exact group4_degree6
  · exact group4_degree7
