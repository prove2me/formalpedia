-- Source module: Solutions.J6SegVal7
/-!
# B-line value bounds 7: the `J`-kernel facts in the round-six regime, and `ValNeed6`

* `w_le_LJ`: the first `w` positions are near-boundary, so `w ≤ |LJ s t λ w|` when `w ≤ s`.
* `jNeed6_of`: `P.Ok → JNeed6 P` (from B4: `r6_segReg`, `JK.jPre_line`, `JK.jKerG_out_bnd`).
* **`valNeed6_all`**: `P.Ok → ChunkTabBnd6 P → ∀ ap, ValCond6 ap → ValNeed6 P ap`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace J6Seg.Val
open IntMul NLogN NLogN.KIL NLogN.KFB IntMul.Kappa.R6 Function J6Seg

/-- **`w ≤ |LJ|`** (the positions `j < w` are near the left boundary of their block). -/
theorem w_le_LJ {s t lam w : ℕ} (hw : w ≤ s) : w ≤ (LJ s t lam w).length := by
  unfold LJ Jlist
  have hs : (mkBlocks s t lam w).s = s := rfl
  have e : List.range s = List.range w ++ (List.range (s - w)).map (w + ·) := by
    rw [← List.range_add]; congr 1; omega
  rw [hs, e, List.filter_append, List.length_append]
  have : (List.range w).filter (nearB (mkBlocks s t lam w)) = List.range w := by
    rw [List.filter_eq_self]
    intro j hj
    rw [List.mem_range] at hj
    have h1 : (mkBlocks s t lam w).st j ≤ j := stF_le j
    have h2 : (mkBlocks s t lam w).w = w := rfl
    unfold nearB
    rw [h2]
    simp only [decide_eq_true_eq]
    left; omega
  rw [this, List.length_range]
  omega

/-- **The `J`-kernel facts on every round-six axis.** -/
theorem jNeed6_of (P : Prm) (hP : P.Ok) : JNeed6 P := by
  obtain ⟨n₁, hR⟩ := r6_segReg P hP
  refine ⟨n₁, fun n hn src hsrc D hD k hk => ?_⟩
  have h := hR n hn src hsrc k (by omega)
  have hG : (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length ≤ axG6 P n src k :=
    Nat.le_pow_clog (by norm_num) _
  have hK : axw6 P n ≤ (LJ (axs6 src k) (axt6 P n k) (axl6 P n) (axw6 P n)).length :=
    w_le_LJ h.hw
  refine ⟨h.hw, fun Bv x hx h1 h2 y hy => ?_, fun Bv Xb Bc kk hXb hBc hk x hx h1 h2 => ?_⟩
  · have := JK.jKerG_out_bnd (K := axw6 P n) h hG x hx h1 h2 y hy
    unfold JK.jWb at this
    exact this
  · exact JK.jPre_line h hK hG hXb hBc hk x hx h1 h2

/-- **`ValNeed6`** in the round-six regime, from the chunk-table bound (B5) and the plan
conditions. -/
theorem valNeed6_all (P : Prm) (hP : P.Ok) (hT : ChunkTabBnd6 P) :
    ∀ ap, ValCond6 ap → ValNeed6 P ap :=
  valNeed6_of P hT (jNeed6_of P hP)

end J6Seg.Val
end

end

