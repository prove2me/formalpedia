theorem ModularCurve.SSHeckeV2.mem_modPMod_sub_of_resQFun_eq_zero (p : ℕ) [Fact p.Prime] (hp5 : 5 ≤ p) (K : Type) [Field K] [CharP K p] [IsAlgClosed K] [DecidableEq K] (N : ℕ) [NeZero N]
    (hN : (N : K) ≠ 0)
    (k : ℤ) (hk : (p : ℤ) + 2 ≤ k) (φ : PowerSeries K) (hφ : φ ∈ ModPForms.modPMod N k K)
    (h0 : ModularCurve.resQFun p N K hp5 k φ = 0) :
    φ ∈ ModPForms.modPMod N (k - ((p : ℤ) - 1)) K := by sorry
