theorem solution (hP : PaperData I f m N w p a) {x : Pt 5}
    (hx : x ∈ esDomain I) {lam : ℝ → ℝ} {lam' : ℝ} (hlam : HasDerivAt lam lam' (x 1))
    (hsq : ∀ᶠ r in 𝓝 (x 1), lam r ^ 2 = alphaSq f m N w p a r) (he : eFun w p a (x 1) ≠ 0)
    (hl0 : lam (x 1) ≠ 0) :
    PregeodesicAt (esMetric f (Dfun f m N) (Afun f m) (Hfun m N) w)
        (esInverse f (Dfun f m N) (Afun f m) (Hfun m N) w) (principalField f m N w p a lam) x ↔
      Gfun p a (x 1) = 0 := by
  have hdec := principal_accel_decomp hP hx hlam hsq he
  rw [sub_eq_iff_eq_add] at hdec
  have hf0 := hP.nf _ hx.1
  have hH0 : Hfun m N (x 1) ≠ 0 := div_ne_zero (hP.nN _ hx.1) (hP.nm _ hx.1)
  constructor
  · rintro ⟨κ, hκ⟩
    rw [hκ] at hdec
    have h0 := congrFun hdec 0
    have h3 := congrFun hdec 3
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, principalField_apply, Matrix.cons_val,
      Fin.isValue, mul_zero, zero_add] at h0 h3
    have hT : eFun w p a (x 1) / f (x 1) ≠ 0 := div_ne_zero he hf0
    have hκ' : κ = lam (x 1) * (deriv (deriv p) (x 1) + w (x 1) * deriv (deriv a) (x 1)) /
        eFun w p a (x 1) := mul_right_cancel₀ hT h0
    rw [hκ'] at h3
    have h3' : Gfun p a (x 1) / eFun w p a (x 1) * (lam (x 1) / Hfun m N (x 1)) = 0 := by
      linarith
    rcases mul_eq_zero.mp h3' with h | h
    · exact (div_eq_zero_iff.mp h).resolve_right he
    · exact absurd ((div_eq_zero_iff.mp h).resolve_right hH0) hl0
  · intro hG
    refine ⟨lam (x 1) * (deriv (deriv p) (x 1) + w (x 1) * deriv (deriv a) (x 1)) /
      eFun w p a (x 1), ?_⟩
    rw [hdec, hG, zero_div, zero_smul, zero_add]
