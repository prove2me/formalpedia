variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Lemma 3.16, PDF p. 13. Faithful action is essential; generation is not asserted. -/
theorem inducedLCone_pointed (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) (hf : FaithfulAction P) (Cz : Set G)
    (hz : Cz ⊆ (LieAlgebra.center ℝ G : Set G)) (hc : ClosedCone Cz) (hp : Pointed Cz) :
    ClosedCone (inducedLCone P Cz) ∧ Pointed (inducedLCone P Cz) ∧ Invariant (inducedLCone P Cz) := by sorry

end Presentations

end

