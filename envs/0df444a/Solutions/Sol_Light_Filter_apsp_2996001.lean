theorem sOf_eq (n : ℕ) : sOf n = 2 ^ jOf n := rfl

theorem cKOf_eq (n : ℕ) : cKOf n = jOf n + 1 := Nat.size_pow

theorem jOf_mul_le (n : ℕ) : 10 ^ 7 * jOf n ≤ 284225 * kOf n := by
