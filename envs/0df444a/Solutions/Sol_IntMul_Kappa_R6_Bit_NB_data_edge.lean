/-! ## Data entrance edges -/

section Data

variable {h : ℕ}

theorem data_edge_sol_aux (x₁ y₁ x₂ y₂ : Fin (h + 4) → ℚ) (h₁ : y₁ ⬝ᵥ x₁ = 1) (h₂ : y₂ ⬝ᵥ x₂ = 1)
    (hu : x₁ ⟨0, by omega⟩ * x₂ ⟨0, by omega⟩ ≠ 0)
    (hv : y₁ ⟨h + 3, by omega⟩ * y₂ ⟨h + 3, by omega⟩ ≠ 0)
    (hT : ∀ l (hl1 : 1 ≤ l) (hl2 : l ≤ h + 2),
      x₁ ⟨l, by omega⟩ * y₁ ⟨h + 3, by omega⟩ + x₂ ⟨l, by omega⟩ * y₂ ⟨h + 3, by omega⟩ ≠ 0)
    (hdet : (Matrix.of fun i j : Fin (2 * h + 7) =>
      cor ((1 - vecMulVec x₁ y₁) ⊗ₖ (1 - vecMulVec x₂ y₂)) i.val j.val).det ≠ 0) :
    ∃ e : Edge ((h + 4) * (h + 4)),
      EdgeQ e (qM ((1 - vecMulVec x₁ y₁) ⊗ₖ (1 - vecMulVec x₂ y₂))) ∧ ∃ rs',
      e.runs = dataRuns (h + 4) ((h + 4) * (h + 4)) ++ rs' ∧ (∀ ρ ∈ rs', ρ.2.2 = 1) ∧
      rs'.length = h + 5 := by
  set M := (1 - vecMulVec x₁ y₁) ⊗ₖ (1 - vecMulVec x₂ y₂) with hMdef
  have hk := two_k_le (h := h)
  have hk2 : 2 * (2 * h + 7) < (h + 4) * (h + 4) := by nlinarith
  have hmm : (h + 4) * (h + 4) = (h + 3) * (h + 3) + (2 * h + 7) := by ring
  have hMM : M * M = M := by
    rw [hMdef, ← mul_kronecker_mul, one_sub_vmv_idem x₁ y₁ h₁, one_sub_vmv_idem x₂ y₂ h₂]
  have hq := qM_idem hMM
  have hrank : (qM M).rank = (h + 4) * (h + 4) - (2 * h + 7) := by
    have h1 := rank_eq_trace (qM M) hq
    rw [qM_trace, hMdef, trace_kronecker, trace_one_sub_vmv x₁ y₁ h₁,
      trace_one_sub_vmv x₂ y₂ h₂] at h1
    have h2 : (qM M).rank = (h + 3) * (h + 3) := by
      apply Nat.cast_injective (R := ℚ); rw [h1]; push_cast; ring
    omega
  -- the corner
  set Cp : Matrix (Fin (2 * h + 7)) (Fin (2 * h + 7)) ℚ := (qM M).submatrix
    (fun l : Fin (2 * h + 7) => (⟨l.val, by omega⟩ : Fin ((h + 4) * (h + 4))))
    (fun r : Fin (2 * h + 7) => (⟨(h + 4) * (h + 4) - (2 * h + 7) + r.val, by omega⟩ :
      Fin ((h + 4) * (h + 4)))) with hCp
  have hCe : ∀ i j : Fin (2 * h + 7), Cp i j = cor M i.val j.val := by
    intro i j
    rw [hCp, submatrix_apply, ← qM_corner M i.val j.val i.isLt j.isLt]
  have hdetC : Cp.det ≠ 0 := by
    have : Cp = Matrix.of fun i j : Fin (2 * h + 7) => cor M i.val j.val := by
      ext i j; rw [hCe]; rfl
    rw [this]; exact hdet
  have hmid := fun i (h1 : 2 * h + 7 ≤ i) (h2 : i < (h + 4) * (h + 4) - (2 * h + 7)) =>
    isPiv_mid (k := 2 * h + 7) (by omega) (qM M) hq hrank hdetC h1 h2
  -- the rank-one block
  set B : Matrix (Fin (2 * h + 7)) (Fin (h + 4)) ℚ :=
    Matrix.of fun i γ => Cp i ⟨h + 3 + γ.val, by omega⟩ with hBdef
  have hBe : ∀ i γ, B i γ = cor M i.val (h + 3 + γ.val) := fun i γ => by
    rw [hBdef, of_apply, hCe]
  have hcorner : ∀ l, 1 ≤ l → l ≤ h + 2 →
      IsPiv (qM M) l ((h + 4) * (h + 4) - (2 * h + 7) + (h + 3 + l)) := by
    intro l hl1 hl2
    have hB1 : IsPiv B l l := by
      refine isPiv_rank1_lower B (fun i => dU x₁ x₂ i.val) (fun γ => dV y₁ y₂ γ.val)
        (fun i γ hiγ => by rw [hBe]; exact data_upper x₁ y₁ x₂ y₂ _ _ hiγ γ.isLt)
        (by omega) (by omega) ?_ ?_ l hl1 (by omega) (by omega) ?_
      · simp only [dU, dif_pos (show (0 : ℕ) < h + 3 by omega)]; exact hu
      · simp only [dV, show h + 4 - 1 = h + 3 by omega, lt_irrefl, dif_neg, not_false_eq_true]
        exact hv
      · rw [hBe]
        simp only
        rw [data_diag x₁ y₁ x₂ y₂ l hl1 hl2]
        intro e
        apply hT l hl1 hl2
        linarith
    have hB2 : IsPiv Cp l (h + 3 + l) :=
      isPiv_block Cp B le_rfl (by omega) (fun i j => rfl) hB1
    exact isPiv_block (qM M) Cp (by omega) (by omega) (fun i j => rfl) hB2
  have hok : ∀ ρ ∈ dataRuns (h + 4) ((h + 4) * (h + 4)), RunOK ((h + 4) * (h + 4)) ρ := by
    intro ρ hρ
    simp only [dataRuns, List.mem_cons, List.mem_nil_iff, or_false] at hρ
    rcases hρ with rfl | rfl <;> refine ⟨?_, ?_, ?_, ?_⟩ <;> simp only <;>
      generalize (h + 4) * (h + 4) = M' at hk2 ⊢ <;> omega
  have hnd : (runPairs (dataRuns (h + 4) ((h + 4) * (h + 4)))).Nodup := by
    rw [dataRuns, runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil, List.nodup_append]
    refine ⟨nodup_run _ _ _, nodup_run _ _ _, ?_⟩
    intro a ha b hb hab
    rw [mem_run] at ha hb
    obtain ⟨k, hk1, rfl⟩ := ha
    obtain ⟨k', hk2', rfl⟩ := hb
    simp only [Prod.mk.injEq] at hab
    omega
  have hp : ∀ p ∈ runPairs (dataRuns (h + 4) ((h + 4) * (h + 4))), IsPiv (qM M) p.1 p.2 := by
    intro p hp
    rw [dataRuns, runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil, List.mem_append,
      mem_run, mem_run] at hp
    rcases hp with ⟨t, ht, rfl⟩ | ⟨t, ht, rfl⟩
    · exact hmid _ (by omega) (by generalize (h + 4) * (h + 4) = M' at hk2 ht ⊢; omega)
    · have := hcorner (1 + t) (by omega) (by omega)
      have key : (h + 4) * (h + 4) - (2 * h + 7) + (h + 3 + (1 + t)) =
          (h + 4) * (h + 4) - (h + 4) + 1 + t := by
        generalize (h + 4) * (h + 4) = M' at hk2 ⊢; omega
      rw [key] at this
      exact this
  obtain ⟨e, he, rs', h1, h2, h3⟩ := edge_singles (by omega) (qM M) hq _ hok hnd hp
  refine ⟨e, he, rs', h1, h2, ?_⟩
  rw [hrank, dataRuns, runPairs_cons, runPairs_cons, runPairs_nil, List.append_nil,
    List.length_append, length_run, length_run] at h3
  generalize (h + 4) * (h + 4) = M' at hk2 h3
  omega

end Data

end IntMul.Kappa.R6.Bit.NB

end

theorem solution : type_of% @IntMul.Kappa.R6.Bit.NB.data_edge_sol_aux := @IntMul.Kappa.R6.Bit.NB.data_edge_sol_aux
