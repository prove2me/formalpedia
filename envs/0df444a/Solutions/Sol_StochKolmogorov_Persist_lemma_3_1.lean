-- ===== L31 =====
section FlatM_L31
open MeasureTheory ProbabilityTheory Filter Set
open scoped ENNReal NNReal Topology BigOperators
set_option autoImplicit false

namespace ItoLib
open EthierKurtz StochKolmogorov.Persist

/-- Lemma 3.1 of the source, all clauses. -/
theorem lemma_3_1_proof {n : ℕ} (hn : 0 < n) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (C : Coeffs n) (B : ℝ≥0 → Ω → SDEState n)
    (hB : IsStandardBrownian P B) (c : SDEState n) (γb : ℝ) (hA : Assumption11 C c γb) :
    (∀ x ∈ orthant n, ∃ Y : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y) ∧
    (∀ x ∈ orthant n, ∀ Y Y' : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y →
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y' →
      ∀ᵐ ω ∂P, ∀ t, Y t ω = Y' t ω) ∧
    (∀ I : Finset (Fin n), ∀ x ∈ faceOpen I, ∀ Y : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y →
      ∀ᵐ ω ∂P, ∀ t, Y t ω ∈ faceOpen I) ∧
    (∀ δ₀ : ℝ, IsDelta0 C γb δ₀ →
      BddAbove ((bracket35 C c γb δ₀) '' orthant n) ∧
      ∀ p ∈ openOrthant n, l1 p ≤ δ₀ → ∀ x ∈ openOrthant n, ∀ Y : ℝ≥0 → Ω → SDEState n,
        SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y → ∀ t : ℝ≥0,
          ∫⁻ ω, ENNReal.ofReal (Vfun c p (Y t ω) ^ δ₀) ∂P ≤
            ENNReal.ofReal (Real.exp (δ₀ * Hconst C c γb δ₀ * t) * Vfun c p x ^ δ₀)) :=
  ⟨fun _ hx => kolm_exists P C B hB c γb hA hx, kolm_unique P C B hB hA.2.1,
    fun _ _ hx _ hY => face_inv C hB hA.2.1 hx hY,
    fun δ₀ hδ => ⟨bracket35_bddAbove C c γb δ₀ hA hδ,
      fun _ hp hpl _ hx _ hY t => moment_36 hn hB hA hδ hp hpl hx hY t⟩⟩

end ItoLib


end FlatM_L31

open StochKolmogorov.Persist in
open EthierKurtz in
theorem solution {n : ℕ} (hn : 0 < n) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (C : Coeffs n) (B : ℝ≥0 → Ω → SDEState n)
    (hB : IsStandardBrownian P B) (c : SDEState n) (γb : ℝ) (hA : Assumption11 C c γb) :
    -- existence of a strong solution from every `x ∈ ℝⁿ₊`
    (∀ x ∈ orthant n, ∃ Y : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y) ∧
    -- pathwise uniqueness
    (∀ x ∈ orthant n, ∀ Y Y' : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y →
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y' →
      ∀ᵐ ω ∂P, ∀ t, Y t ω = Y' t ω) ∧
    -- the solution started in `ℝ^{I,◦}₊` stays there forever with probability one
    (∀ I : Finset (Fin n), ∀ x ∈ faceOpen I, ∀ Y : ℝ≥0 → Ω → SDEState n,
      SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y →
      ∀ᵐ ω ∂P, ∀ t, Y t ω ∈ faceOpen I) ∧
    -- `H < ∞` in (3.5), and (3.6)
    (∀ δ₀ : ℝ, IsDelta0 C γb δ₀ →
      BddAbove ((bracket35 C c γb δ₀) '' orthant n) ∧
      ∀ p ∈ openOrthant n, l1 p ≤ δ₀ → ∀ x ∈ openOrthant n, ∀ Y : ℝ≥0 → Ω → SDEState n,
        SolvesBrownianSDE P (diffusion C) (drift C) B (fun _ => x) Y → ∀ t : ℝ≥0,
          ∫⁻ ω, ENNReal.ofReal (Vfun c p (Y t ω) ^ δ₀) ∂P ≤
            ENNReal.ofReal (Real.exp (δ₀ * Hconst C c γb δ₀ * t) * Vfun c p x ^ δ₀)) := by
  exact ItoLib.lemma_3_1_proof hn P C B hB c γb hA
