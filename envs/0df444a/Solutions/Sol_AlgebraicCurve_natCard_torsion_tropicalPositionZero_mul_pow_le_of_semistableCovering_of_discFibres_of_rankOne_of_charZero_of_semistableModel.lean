    · intro h; exact absurd (Finset.mem_univ i) h
  have hsum_apply_ann : ∀ (G : Fin n → Divisor L F), (∀ i, ∀ P ∈ (G i).support, P ∈ (C i).dom) →
      ∀ e, ∀ P ∈ (An e).dom, (∑ j, G j) P = 0 := by
    intro G hG e P hP
    rw [Finsupp.finsetSum_apply]
    refine Finset.sum_eq_zero (fun j _ => ?_)
    by_contra hne
    exact ((hchart_unique j P (hG j P (Finsupp.mem_support_iff.mpr hne))).2 e) hP

  have htors : ∀ (c : Pic0 L F) (hc : c ∈ S),
      ((ℓ ^ K : ℕ) : ℤ) • NodalPic0.mk src tgt xs xt ⟨_, hadm (Dc c hc) (hDc c hc).1 (hDc c hc).2.1⟩ = 0 := by
    intro c hc
    obtain ⟨hdomc, hdegc, hdeg0, hmkc⟩ := hDc c hc
    have hc0 : ((ℓ ^ K : ℕ) : ℤ) • c = 0 := by rw [hS] at hc; exact hc.1

    have hprin : ((ℓ ^ K : ℕ) : ℤ) • (∑ i, Dc c hc i) ∈ Divisor.principal (K := L) (F := F) := by
      have h0 : Pic0.mk (((ℓ ^ K : ℕ) : ℤ) • (⟨∑ i, Dc c hc i, hdeg0⟩ : Divisor.degZero (K := L) (F := F))) = 0 := by
        rw [Pic0.mk, ← QuotientAddGroup.mk'_apply, map_zsmul, QuotientAddGroup.mk'_apply, ← Pic0.mk, hmkc, hc0]
      rw [Pic0.mk, QuotientAddGroup.eq_zero_iff, AddSubgroup.mem_addSubgroupOf] at h0
      exact h0
    obtain ⟨f, hf0, hf⟩ := hprin
    have hIN := AlgebraicCurve.isNodalPrincipal_mapDomain_placeMap_of_forall_ord_eq_zero_of_semistableCovering_of_rankOne
      A π hπ hπ0 hrk F n m Fbar hratBar C hratF An An' src tgt xs xt w hpair hw hatt hnodes f hf0
      (fun i => ((ℓ ^ K : ℕ) : ℤ) • Dc c hc i)
      (fun i P hP => hdomc i P (Finsupp.support_smul hP))
      (fun i P hP => by
        rw [← hf P]
        show (((ℓ ^ K : ℕ) : ℤ) • Dc c hc i) P = (((ℓ ^ K : ℕ) : ℤ) • ∑ j, Dc c hc j) P
