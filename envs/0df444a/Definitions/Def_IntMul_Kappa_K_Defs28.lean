-- Source module: Solutions.KFUURev7
/-!
# KFUU §2g: phase 2 in IL (one iteration)

`p2B` divides `M` by `U²`, calls the swap entry with the descriptor
`[w, u, 1, 3, 5, U^k, U, U^{n-2-2k}, U, U^k·Bh]`, and multiplies `A = U^k` and `C = U^k·Bh` by `U`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN.KFUU

open IntMul KIL KFB KFC KFT KFU AModel AModelL12

section Gen

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}

/-- `i := i / 2^m` (an exact division), the remainder through `k`. -/
def divE (i j k : Fin HS) : IStmt HS P := .seq (.op (.split i j k)) (.op (.drop k))

/-- The cost of one `SwapNeed` call on a 5-field shape of volume `V`. -/
noncomputable def cSwV (K : ℝ) (w u V : ℕ) : ℝ :=
  K * (((w : ℝ) + 1) * ((V : ℝ) + 1) * (u : ℝ) ^ KFS.τS +
    (((5 + 1) * (Nat.size V + w + u + 1) ^ 2 : ℕ) : ℝ))

/-- One iteration of phase 2. -/
def p2B (eSw : Fin P) (dS Dsc : Fin HS) : IStmt HS P :=
  .seq (divE NLogN.KFUU.rM rU2 tq) (.seq (divE NLogN.KFUU.rM rU2 tq) (.seq (swS eSw dS Dsc)
    (.seq (.op (.shl rA rU2)) (.op (.shl NLogN.KFUU.rB rU2)))))

end Gen

end NLogN.KFUU

end

