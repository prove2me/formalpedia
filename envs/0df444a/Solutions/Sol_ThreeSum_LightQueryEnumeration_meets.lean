section


/-!
# Query-coordinate lists and weighted subset semantics

The coordinate list has one entry per set bit of the query. Its powers
form a compact weight table for the output-sensitive enumeration routine.
-/

namespace ThreeSum.QueryCoordinates

open Finset ThreeSum.SubsetAddress
open scoped BigOperators





























@[simp] theorem positions_length {W : ℕ} (Q : Finset (Fin W)) :
    (positions Q W).length = Q.card := by
  rw [← List.toFinset_card_of_nodup (positions_nodup Q W),positions_toFinset,natPositions_card]




@[simp] theorem selectedPowers_length {W : ℕ} (Q : Finset (Fin W)) (j : ℕ) :
    (selectedPowers Q j).length = (positions Q j).length := by simp [selectedPowers]










@[simp] theorem selectedPowers_sum {W : ℕ} (Q : Finset (Fin W)) :
    (selectedPowers Q W).sum = subsetMask Q := by
  rw [selectedPowers,← List.sum_toFinset _ (positions_nodup Q W),positions_toFinset]
  rfl




theorem total_getD (xs : List ℕ) :
    LightWeightedEnumeration.total (fun i => xs[i]?.getD 0) xs.length = xs.sum := by
  unfold LightWeightedEnumeration.total
  rw [← Fin.sum_univ_eq_sum_range]
  simpa using Fin.sum_univ_getElem xs

@[simp] theorem total_weights {W : ℕ} (Q : Finset (Fin W)) :
    LightWeightedEnumeration.total (weights Q) Q.card = subsetMask Q := by
  rw [← positions_length Q,← selectedPowers_length Q W]
  exact (total_getD (selectedPowers Q W)).trans (selectedPowers_sum Q)














































































































































































end ThreeSum.QueryCoordinates

end

section


/-!
# Constructing the compact coordinate-weight table of a query mask

A width-sized scan tests each bit using the checked deletion routine and
appends the corresponding power of two. The output has one cell per set
bit, while the available buffer and scratch are only linear in the width.
-/

namespace ThreeSum.LightQueryWeights

open Light ThreeSum.SubsetAddress ThreeSum.MaskErase ThreeSum.LightSubsetAddress
open QueryCoordinates

variable {lim : Limits} {P : Program}















































































































































theorem weights_of_segment {μ : ℕ → ℤ} {W dst : ℕ} {Q : Finset (Fin W)}
    (hseg : SegN μ dst (selectedPowers Q W)) :
    LightWeightedEnumeration.Weights μ dst Q.card (weights Q) := by
  intro i hi
  have hi' : i < (selectedPowers Q W).length := by simpa using hi
  simpa only [weights,List.getD_eq_getElem _ _ hi',List.getElem?_eq_getElem hi',Option.getD_some]
    using hseg.read hi'





end ThreeSum.LightQueryWeights

end

section


/-!
# A complete output-sensitive subset enumerator inside an arbitrary query mask

The routine constructs its own compact coordinate weights, then invokes
the existing recursion on the number of selected coordinates. Every emitted
word is already a global mask; no ambient layer or Boolean cube is scanned.
-/

namespace ThreeSum.LightQueryEnumeration

open Light ThreeSum.SubsetAddress ThreeSum.LightSubsetAddress QueryCoordinates

variable {lim : Limits} {P : Program}










theorem meets_sourceProof {pMain pWeights pPowers pErase pEnum : ℕ}
    (hmain : P[pMain]? = some (body pWeights pEnum))
    (hweights : P[pWeights]? = some (LightQueryWeights.body pPowers pErase))
    (hpowers : P[pPowers]? = some powTableBody)
    (herase : P[pErase]? = some (LightMaskErase.body pErase))
    (henum : P[pEnum]? = some (LightSubsetEnumeration.body pEnum))
    {μ : ℕ → ℤ} {W t dst work d : ℕ} (Q : Finset (Fin W))
    (hw : (lim.space : ℤ) ≤ lim.word)
    (hspace : work+(2*W+2) ≤ lim.space)
    (hword : ((2^(W+1) : ℕ) : ℤ) ≤ lim.word)
    (ht : t ≤ Q.card+1)
    (hdst : dst+Q.card.choose t ≤ work)
    (hd : d+W+2 ≤ lim.depth) :
    Meets lim P pMain d [W,subsetMask Q,t,dst,work] μ (time W Q.card t)
      (fun r μ' => r = (Q.card.choose t : ℤ) ∧
        SegN μ' dst ((missingSets Q t).map subsetMask) ∧
        LightWeightedEnumeration.Weights μ' work Q.card (weights Q) ∧
        KeptBut μ μ' work dst (Q.card.choose t)) := by
  have hc : Q.card ≤ W := by simpa using Finset.card_le_univ Q
  have hm : (subsetMask Q : ℤ) ≤ lim.word := by
    have hh : subsetMask Q ≤ 2^(W+1) :=
      (Nat.le_of_lt (subsetMask_isMask Q).1).trans
        (Nat.pow_le_pow_right (by decide) (by omega))
    exact (by exact_mod_cast hh : (subsetMask Q : ℤ) ≤ ((2^(W+1) : ℕ) : ℤ)).trans hword
  apply Meets.of_body hmain
  unfold body time
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (refine Light.Ends.setToThen (work + W + 1 : ℕ) ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightQueryWeights.time, LightSubsetEnumeration.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightQueryWeights.time, LightSubsetEnumeration.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightQueryWeights.time,
                LightSubsetEnumeration.time] <;>
              omega)));
    (try with_unfolding_none refine Light.Ends.skip ?_)
  have hbuild := LightQueryWeights.meets (d := d+1) (μ := μ)
    (dst := work) (work := work+W+1) hweights hpowers herase Q
    hw (by omega) (by omega) hword (by omega)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (hbuild _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen hbuild ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightQueryWeights.time, LightSubsetEnumeration.time]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightQueryWeights.time, LightSubsetEnumeration.time] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightQueryWeights.time,
                LightSubsetEnumeration.time] <;>
              omega)));
    (on_goal -1 =>
        ((rintro count μ₁ ⟨hcount, hseg, _, hkept₀⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  have hwtable := LightQueryWeights.weights_of_segment hseg
  have henumCall := LightWeightedEnumeration.meets (W := Q.card) (U := subsetMask Q)
    henum hw (by omega) hm Q.card t 0 dst μ₁ le_rfl ht
    (by simp) hdst hwtable (d+1) (by omega)
  focus
    ((((first
            | refine Light.Ends.seqSelf ?_
            | refine Light.Ends.skipLast ?_));
        (repeat
            with_unfolding_none
              first
              | refine Light.Ends.seqAssoc ?_
              | refine Light.Ends.skipThen ?_)));
    (first
      | refine Light.Ends.callToThen (henumCall _ (by omega)) ?_ ?_ ?_ ?_
      | refine Light.Ends.callToThen henumCall ?_ ?_ ?_ ?_);
    (on_goal -1 =>
        first
        |
          ((simp only [Light.Stmt.blockCost, Light.Cond.cost, Light.Expr.cost,
                List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
                LightQueryWeights.time, LightSubsetEnumeration.time, hcount]);
            (first
              | omega
              | ((ring_nf); (omega))))
        | omega
        |
          (simp [LightQueryWeights.time, LightSubsetEnumeration.time, hcount] <;>
              first
              | omega
              | ((ring_nf); (omega))));
    (on_goal -1 => omega);
    (on_goal -1 =>
        (((try have := Light.Std.space_le (by assumption)));
          ((try have := Light.Std.const_le (by assumption)));
          (simp [Light.Limits.Addr, abs_le, -abs_mul, LightQueryWeights.time,
                LightSubsetEnumeration.time, hcount] <;>
              omega)));
    (on_goal -1 =>
        ((rintro res μ₂ ⟨hres, hout, hkept₁⟩);
          (try with_unfolding_none refine Light.Ends.skip ?_)))
  refine ⟨by simpa using hres,?_,?_,?_⟩
  · simpa only [output_missingSets] using hout
  · intro i hi
    change μ₂ (work+i) = _
    rw [hkept₁ (work+i) (Or.inr (by omega))]
    exact hwtable i hi
  · intro i hi
    exact (hkept₁ i hi.2).trans (hkept₀ i ⟨by omega,Or.inl hi.1⟩)






























end ThreeSum.LightQueryEnumeration

end


