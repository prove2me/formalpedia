theorem Fx.of {Q kk m mw cB : ℕ} {u u' : Vr} (h : Fx Q kk m mw cB u)
    (h' : ∀ j ∈ ([9, 10, 11, 12, 21, 28] : List (Fin HS)), u' j = u j) : Fx Q kk m mw cB u' := by
  obtain ⟨a, b, c, d, e, f⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    [rw [h' 9 (by decide)]; rw [h' 10 (by decide)]; rw [h' 11 (by decide)];
     rw [h' 12 (by decide)]; rw [h' 21 (by decide)]; rw [h' 28 (by decide)]] <;> assumption

section pieces
variable {Q kk m mw cB W : ℕ} {L : List ℕ} {Mf : ℕ → ℕ → ℤ} {u : Vr} {c : Cs}

theorem BdS.two (h : BdS W m L Mf) : (2 : ℕ) ≤ 2 ^ W :=
  calc 2 = 2 ^ 1 := by norm_num
    _ ≤ 2 ^ W := Nat.pow_le_pow_right (by norm_num) h.1

theorem BdS.Lb (h : BdS W m L Mf) : ∀ y ∈ L.map (fun j : ℕ => (j : ℤ)), |y| ≤ 2 ^ W := by
  intro y hy; simp only [List.mem_map] at hy; obtain ⟨j, hj, rfl⟩ := hy
  simp only [Nat.abs_cast]; exact_mod_cast h.2.2.1 j hj

/-- **After a record or row.** -/
theorem Rn.bTails (hB : BdS W m L Mf) (hv : BV W u) {n t : ℕ} (h3 : u 3 = n) (h23 : u 23 = t)
    (ht : t + n + 1 ≤ 2 ^ W) :
    Rn (progL bTail) u c (fun u' => u' 23 = ((t + n + 1 : ℕ) : ℤ) ∧
      (∀ i ∉ ([23] : List (Fin HS)), u' i = u i) ∧ BV W u')
      (update c 41 ((n : ℤ) :: c 41)) (costL W (m * m + m) bTail) := by
  have h2W := hB.two
  have hok : OkL W (m * m + m) bTail (u, c) := by
    simp (disch := decide) only [bTail, OkL, runL, Ins.run, Ins.ok, E.den, update_of_ne,
      update_self, h3, h23]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    done
  have h := Rn.insL hB.2.1 bTail hv hok
  have hc : (runL bTail (u, c)).2 = update c 41 ((n : ℤ) :: c 41) := by
    simp (disch := decide) only [bTail, runL, Ins.run, E.den, h3]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, hb⟩
  · simp (disch := decide) only [bTail, runL, Ins.run, E.den, update_of_ne, update_self, h3, h23]
    push_cast; ring
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    simp only [bTail, runL, Ins.run, update_apply, hi, if_false]

/-- **Head of a forward row.** -/
theorem Rn.fHeads (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r' : ℕ} (h1 : u 1 = r') (hr : r' < m) :
    Rn (progL fHead) u c (fun u' => u' 5 = ((m - 1 - r' : ℕ) : ℤ) ∧
      u' 4 = Lg L (m - 1 - r') ∧ u' 3 = 0 ∧
      (∀ i ∉ ([3, 4, 5, 29] : List (Fin HS)), u' i = u i) ∧ BV W u') c
      (costL W (m * m + m) fHead) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  obtain ⟨hM, hL⟩ := hS
  have h2W := hB.two
  have eq : (m : ℤ) - 1 - r' = ((m - 1 - r' : ℕ) : ℤ) := by omega
  have hok : OkL W (m * m + m) fHead (u, c) := by
    simp (disch := decide) only [fHead, OkL, runL, Ins.run, Ins.ok, E.den, update_of_ne,
      update_self, h1, f28, hL, eq, Int.toNat_natCast, castL_getD, List.length_map, hLm]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    all_goals first | exact hB.Lb | (rw [abs_of_nonneg (by positivity)]; exact_mod_cast (show m - 1 - r' ≤ 2 ^ W by have := hB.2.1; nlinarith)) | skip
    done
  have h := Rn.insL hB.2.1 fHead hv hok
  have hc : (runL fHead (u, c)).2 = c := by simp only [fHead, runL, Ins.run]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, ?_, ?_, hb⟩
  · simp (disch := decide) only [fHead, runL, Ins.run, E.den, update_of_ne, update_self, h1, f28, eq]
  · simp (disch := decide) only [fHead, runL, Ins.run, E.den, update_of_ne, update_self, h1, f28,
      eq, hL, Int.toNat_natCast, castL_getD]
  · simp (disch := decide) only [fHead, runL, Ins.run, E.den, update_of_ne, update_self]
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    obtain ⟨i3, i4, i5, i29⟩ := hi
    simp only [fHead, runL, Ins.run, update_apply, i3, i4, i5, i29, if_false]

/-- **Forward-window count step.** -/
theorem Rn.cnIs (hF : Fx Q kk m mw cB u) (hS : StS m L Mf c) (hB : BdS W m L Mf)
    (hLm : L.length = m) (hv : BV W u) {r j n : ℕ} (h5 : u 5 = r) (h2 : u 2 = j) (hj : j < m)
    (h4 : u 4 = Lg L r) (h3 : u 3 = n) (hn : n + 1 ≤ 2 ^ W) :
    Rn (progL cnI) u c (fun u' =>
      u' 3 = (n : ℤ) + (if j < r ∧ Lg L r ≤ Lg L j + mw then 1 else 0) ∧
      (∀ i ∉ ([3, 7, 29] : List (Fin HS)), u' i = u i) ∧ BV W u') c
      (costL W (m * m + m) cnI) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  obtain ⟨hM, hL⟩ := hS
  have h2W := hB.two
  have hval : (n : ℤ) + (if (j : ℤ) < r then 1 else 0) *
      (1 - if ((Lg L j : ℕ) : ℤ) + (mw : ℤ) < ((Lg L r : ℕ) : ℤ) then 1 else 0) =
      (n : ℤ) + (if j < r ∧ Lg L r ≤ Lg L j + mw then 1 else 0) := by
    split_ifs <;> first | rfl | omega | (exfalso; omega) | simp_all | omega
  have hok : OkL W (m * m + m) cnI (u, c) := by
    simp (disch := decide) only [cnI, OkL, runL, Ins.run, Ins.ok, E.den, update_of_ne,
      update_self, h5, h2, h3, h4, f11, hL, Int.toNat_natCast, castL_getD, List.length_map, hLm,
      den_ltE, hval]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    all_goals first | exact hB.Lb | (split_ifs <;> (rw [abs_le]; constructor <;> push_cast <;> omega)) | skip
    done
  have h := Rn.insL hB.2.1 cnI hv hok
  have hc : (runL cnI (u, c)).2 = c := by simp only [cnI, runL, Ins.run]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, hb⟩
  · simp (disch := decide) only [cnI, runL, Ins.run, E.den, update_of_ne, update_self, h5, h2,
      h3, h4, f11, hL, Int.toNat_natCast, castL_getD, den_ltE, hval]
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hi
    obtain ⟨i3, i7, i29⟩ := hi
    simp only [cnI, runL, Ins.run, update_apply, i3, i7, i29, if_false]

/-- **The forward window.** -/
theorem Rn.fMids (hF : Fx Q kk m mw cB u) (hB : BdS W m L Mf) (hv : BV W u) {r n : ℕ}
    (h5 : u 5 = r) (h4 : u 4 = Lg L r) (h3 : u 3 = n) (hn : n ≤ 2 ^ W) (hr : r ≤ 2 ^ W) :
    Rn (progL fMid) u c (fun u' => u' 3 = ((cond (decide (cB ≤ Lg L r)) r n : ℕ) : ℤ) ∧
      (∀ i ∉ ([3] : List (Fin HS)), u' i = u i) ∧ BV W u') c (costL W (m * m + m) fMid) := by
  obtain ⟨f9, f10, f11, f12, f21, f28⟩ := hF
  have h2W := hB.two
  have hval : (if ((Lg L r : ℕ) : ℤ) - (cB : ℤ) < 0 then (n : ℤ) else (r : ℤ)) =
      ((cond (decide (cB ≤ Lg L r)) r n : ℕ) : ℤ) := by
    by_cases h : cB ≤ Lg L r
    · simp [h]
    · simp [h]
  have hok : OkL W (m * m + m) fMid (u, c) := by
    simp (disch := decide) only [fMid, OkL, runL, Ins.run, Ins.ok, E.den, h3, h4, h5, f12, hval]
    and_intros
    all_goals (first | assumption | assumption_mod_cast | (push_cast; omega) | positivity | decide | (refine le_trans (b := 2) (by decide) ?_; assumption) | (rw [abs_le]; split_ifs <;> constructor <;> linarith) | skip)
    all_goals first | (cases decide (cB ≤ Lg L r) <;> simp only [cond_true, cond_false, Nat.abs_cast] <;> first | exact_mod_cast hn | exact_mod_cast hr) | skip
    done
  have h := Rn.insL hB.2.1 fMid hv hok
  have hc : (runL fMid (u, c)).2 = c := by simp only [fMid, runL, Ins.run]
  rw [hc] at h
  refine h.mono (fun u' hu => ?_) le_rfl
  obtain ⟨e, hb⟩ := hu
  subst e
  refine ⟨?_, ?_, hb⟩
  · simp (disch := decide) only [fMid, runL, Ins.run, E.den, update_self, h3, h4, h5, f12, hval]
  · intro i hi
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hi
    simp only [fMid, runL, Ins.run, update_apply, hi, if_false]

end pieces

end J6Seg.PJ

