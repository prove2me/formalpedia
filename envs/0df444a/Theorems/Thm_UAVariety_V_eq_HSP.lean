-- title:
--   Tarski's theorem V = HSP
-- statement:
--   $L$ is a signature without relation symbols; an algebra is a type in `Type u` with an $L$-structure (`Alg L`), and $K$ is a class of algebras. $H(K)$, $S(K)$, $P(K)$ are the classes of homomorphic images, of algebras embeddable in, and of algebras isomorphic to direct products (over any index type in `Type u`, possibly empty) of members of $K$; $K$ is a variety if it is closed under $H$, $S$ and $P$. $V(K)$ is the intersection of all varieties containing $K$. Then $S(H(K))\subseteq H(S(K))$, $P(S(K))\subseteq S(P(K))$, $P(H(K))\subseteq H(P(K))$, and $V(K)=H(S(P(K)))$.
-- source:
--   S. Burris, H. P. Sankappanavar, A Course in Universal Algebra, Millennium Edition (2012), https://www.math.uwaterloo.ca/~snburris/htdocs/ualg.html, Ch. II, Lemma 9.2 and Theorem 9.5 (Tarski)

import Definitions.Def_UAVariety_defs

universe u v w

open FirstOrder FirstOrder.Language

namespace UAVariety

variable {L : FirstOrder.Language.{u, v}} [L.IsAlgebraic]

/-- B&S Lemma 9.2 (`SH ≤ HS`, `PS ≤ SP`, `PH ≤ HP`) and Tarski's Theorem 9.5: the variety
generated by `K` is `HSP K`. -/
theorem V_eq_HSP (K : Set (Alg L)) :
    (S (H K) ⊆ H (S K) ∧ P (S K) ⊆ S (P K) ∧ P (H K) ⊆ H (P K)) ∧
      V K = H (S (P K)) := by sorry

end UAVariety
