variable {R : Type*} [CommRing R] {m W : ℕ}

variable (C : Circuit R m W) {N : ℕ} [NeZero N] (P L' : ℕ) (A B Cs : Shape)

theorem implΦ_eqφ {φ : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N)}
    {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) (X : IMat m) (hX : FacAtφ N φ C.fac X) :
    implΦ C N P L' A B Cs child X =
      ⇑(streamΦ (R := R) P L' (hdShape A B Cs m N) (shearπ (hdLayout A B Cs m N) φ)
        (shearπ_valid _ _) X) := by
  obtain ⟨hE₁, hE₂, hd₁, hd₂, hW, hA'⟩ := hX
  set Λ := hdLayout A B Cs m N
  have hE₁' : ∀ i j, i < j → castM N (C.fac X).1 i j = 0 := fun i j h => by
    simp [castM, hE₁ i j h]
  have hE₂' : ∀ i j, i < j → castM N (C.fac X).2.2 i j = 0 := fun i j h => by
    simp [castM, hE₂ i j h]
  have hd₁' : ∀ i, IsUnit (castM N (C.fac X).1 i i) := fun i => by simpa [castM] using hd₁ i
  have hd₂' : ∀ i, IsUnit (castM N (C.fac X).2.2 i i) := fun i => by simpa [castM] using hd₂ i
  have hW' : ∀ i j, castM N (C.fac X).2.1 i j = 0 ∨ castM N (C.fac X).2.1 i j = 1 := by
    intro i j; rcases hW i j with h | h <;> simp [castM, h]
  funext f i
  have hl : (List.ofFn f).length = vol (P :: L' :: hdShape A B Cs m N) := by simp
  simp only [implΦ, AModel.edgeSteps]
  rw [runC_eq_runArr _ child 0 _ (childOK_swap P L' A B Cs hch _
      (fun a b h => shearSteps_swap_HD h)) hl,
    ← shear_via_pivots_array (Λ.cons2 P L') hE₁' hE₂' hd₁' hd₂' hW' hA' 0 _ hl,
    ← pull_congr (g := rowLift (shearπ Λ φ X))
      (fun a ha => by rw [shearπ, rowLift_amap Λ _ ha]),
    pull_eq_ofFn_funLeft _ _ (fun _ ha => valid_rowLift (shearπ_valid Λ _ X) ha),
    List.getD_eq_getElem _ _ (by simp only [List.length_ofFn]; exact i.2), List.getElem_ofFn]
  simp only [streamΦ, LinearMap.funLeft_apply]
  rw [List.getD_eq_getElem _ _ (by simp only [List.length_ofFn]; exact Fin.isLt _),
    List.getElem_ofFn]

variable [NeZero W]

theorem levelR_correct_amapφ {φ : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N)} {I0 : IMat m}
    (hOK : OKφ C N φ I0)
    {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) {xs : List R}
    (hxs : xs.length = vol (P :: W * L' :: hdShape A B Cs m N)) :
    levelR C N P L' A B Cs child xs =
      pull (P :: W * L' :: hdShape A B Cs m N) (P :: W * L' :: hdShape A B Cs m N)
        (amap ((hdLayout A B Cs m N).cons2 P (W * L')) swapMat) 0 xs := by
  have hnet := netRunF_congr (FacAtφ N φ C.fac) (implΦ C N P L' A B Cs child)
    (fun X => ⇑(streamΦ (R := R) P L' (hdShape A B Cs m N)
      (shearπ (hdLayout A B Cs m N) φ) (shearπ_valid _ _) X))
    (fun X hX => implΦ_eqφ C P L' A B Cs hch X hX) C.gates C.Min C.Mout hOK.frames
  simp only [netRunF_coe] at hnet
  simp only [levelR]
  simp only [hnet]
  rw [shear_network (hdLayout A B Cs m N) φ P W L' C.gates hOK.gatesOK C.ρ
    hOK.route C.Min C.Mout I0 hOK.unit hOK.one]
  exact (interchange_via_shear_array _ _ (fun _ _ => rfl) 0 xs hxs).symm

theorem levelR_correctφ {φ : IMat m →+ Matrix (Fin m) (Fin m) (ZMod N)} {I0 : IMat m}
    (hOK : OKφ C N φ I0)
    {child : Fin (m + m) → Fin (m + m) → List R → List R}
    (hch : ChildOK P L' A B Cs (N := N) child) {xs : List R}
    (hxs : xs.length = vol (P :: W * L' :: swShape A B Cs (N ^ m))) :
    levelR C N P L' A B Cs child xs =
      pull (P :: W * L' :: swShape A B Cs (N ^ m)) (P :: W * L' :: swShape A B Cs (N ^ m))
        (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs := by
  have hxs' : xs.length = vol (P :: W * L' :: hdShape A B Cs m N) := by
    rw [hxs]; simp only [vol_cons, vol_hdShape]
  set Λb := (hdLayout A B Cs m N).cons2 P (W * L')
  have hc : ∀ i : Fin m, (Λb.pos (Fin.castAdd m i) : ℕ) = (A.length + 2) + i := fun i => by
    simp only [Λb, Layout.cons2_pos, hdLayout_pos, hdPos_castAdd]; omega
  have hc' : ∀ j : Fin m, (Λb.pos (Fin.natAdd m j) : ℕ) = (A.length + B.length + m + 2) + j :=
    fun j => by simp only [Λb, Layout.cons2_pos, hdLayout_pos, hdPos_natAdd]; omega
  have hsize : ∀ t : Fin (m + m),
      (P :: W * L' :: hdShape A B Cs m N).getD (Λb.pos t) 0 = N := fun t => by
    rw [List.getD_eq_getElem _ _ (Λb.pos t).2]; simpa using Λb.size t
  rw [levelR_correct_amapφ C P L' A B Cs hOK hch hxs',
    pull_congr (g' := blockSwap (A.length + 2) (A.length + B.length + m + 2) m)
      (fun a ha => amap_swapMat_eq_blockSwap Λb hc hc' (by omega) ha),
    pull_blockSwap (by omega) (by simp [length_hdShape]; omega) (fun k hk => by
      rw [← hc ⟨k, hk⟩, ← hc' ⟨k, hk⟩, hsize, hsize]),
    mergeShape2_hdShape, show A.length + B.length + m + 2 + 1 - m = A.length + B.length + 3 by
      omega]

end Level

section Recursion

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- `prog_correct` with a general frame action at each level, up to a level bound `K`. -/
theorem prog_correctφ (C : Circuit R m W) {q : ℕ} (hq : 1 ≤ q) {K : ℕ}
    (hOK : ∀ k < K, ∃ φ I0, OKφ C (q ^ m ^ k) φ I0) :
    ∀ k ≤ K, ∀ (P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ k ∣ L →
      xs.length = vol (P :: L :: swShape A B Cs (q ^ m ^ k)) →
      AModel.prog C q k P L A B Cs xs =
        pull (P :: L :: swShape A B Cs (q ^ m ^ k)) (P :: L :: swShape A B Cs (q ^ m ^ k))
          (swapPos (A.length + 2) (A.length + B.length + 3)) 0 xs := by
  intro k
  induction k with
  | zero => intro _ P L A B Cs xs _ _; simp [AModel.prog]
  | succ k ih =>
    intro hk P L A B Cs xs hL hxs
    have : NeZero (q ^ m ^ k) := ⟨by positivity⟩
    obtain ⟨L', rfl⟩ : W ∣ L := (dvd_pow_self W (Nat.succ_ne_zero k)).trans hL
    have hL' : W ^ k ∣ L' := by
      rw [pow_succ'] at hL
      exact Nat.dvd_of_mul_dvd_mul_left (NeZero.pos W) hL
    have hdiv : W * L' / W = L' := Nat.mul_div_cancel_left L' (NeZero.pos W)
    have hpow : (q ^ m ^ k) ^ m = q ^ m ^ (k + 1) := by rw [← pow_mul, ← pow_succ]
    simp only [AModel.prog, hdiv]
    rw [← hpow] at hxs ⊢
    obtain ⟨φ, I0, hk'⟩ := hOK k (by omega)
    refine levelR_correctφ C P L' A B Cs hk' ?_ hxs
    intro i j ys hys
    simp only [Fin.val_castAdd, Fin.val_natAdd, Nat.add_sub_cancel_left,
      show m + m - 1 - (m + j) = m - 1 - j by omega]
    rw [ih (by omega) P L' _ _ _ ys hL' (by rw [swShape_child]; exact hys), swShape_child]
    have := i.2
    congr 2
    · simp
    · simp; omega

end Recursion

section QCirc

variable {m : ℕ}

lemma matDen_pos (M : QMat m) : 0 < matDen M :=
  Finset.prod_pos fun _ _ => Finset.prod_pos fun _ _ => Rat.den_pos _

lemma den_dvd_matDen (M : QMat m) (i j : Fin m) : (M i j).den ∣ matDen M :=
  (Finset.dvd_prod_of_mem (fun j => (M i j).den) (Finset.mem_univ j)).trans
    (Finset.dvd_prod_of_mem (fun i => ∏ j, (M i j).den) (Finset.mem_univ i))

lemma ratM_intM {D : ℕ} {M : QMat m} (h : LabOK D M) : ratM (intM D M) = (D : ℚ) • M := by
  ext i j
  obtain ⟨k, hk⟩ := h i j
  have e : (D : ℚ) * M i j = ((k * (M i j).num : ℤ) : ℚ) := by
    rw [hk]; push_cast; rw [← Rat.mul_den_eq_num (M i j)]; ring
  simp only [ratM, intM, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul]
  rw [e, Rat.num_intCast]

lemma ratM_injective : Function.Injective (ratM : IMat m → QMat m) :=
  fun X Y h => by
    ext i j
    have := congrFun (congrFun h i) j
    simpa [ratM] using this

lemma ratM_sub (X Y : IMat m) : ratM (X - Y) = ratM X - ratM Y := by
  ext i j; simp [ratM]

lemma intM_sub {D : ℕ} {a b : QMat m} (ha : LabOK D a) (hb : LabOK D b) :
    ratM (intM D a - intM D b) = (D : ℚ) • (a - b) := by
  rw [ratM_sub, ratM_intM ha, ratM_intM hb, smul_sub]

end QCirc

namespace QCircuit

variable {R : Type*} [CommRing R] {m W : ℕ}

lemma den_pos (C : QCircuit R m W) : 0 < C.den := by
  unfold AModelRat.QCircuit.den
  refine Nat.mul_pos (Nat.mul_pos ?_ (Finset.prod_pos fun w _ => matDen_pos _))
    (Finset.prod_pos fun w _ => matDen_pos _)
  apply List.prod_pos
  intro x hx
  obtain ⟨g, -, rfl⟩ := List.mem_map.1 hx
  exact matDen_pos _

lemma labOK_gate (C : QCircuit R m W) {g : NGate (Fin W) R (QMat m)} (hg : g ∈ C.gates) :
    LabOK C.den g.2.2 := fun i j =>
  (den_dvd_matDen _ i j).trans (Dvd.dvd.mul_right (Dvd.dvd.mul_right
    (List.dvd_prod (List.mem_map.2 ⟨g, hg, rfl⟩)) _) _)

lemma labOK_Min (C : QCircuit R m W) (w : Fin W) : LabOK C.den (C.Min w) := fun i j =>
  (den_dvd_matDen _ i j).trans (Dvd.dvd.mul_right (Dvd.dvd.mul_left
    (Finset.dvd_prod_of_mem (fun w => matDen (C.Min w)) (Finset.mem_univ w)) _) _)

lemma labOK_Mout (C : QCircuit R m W) (w : Fin W) : LabOK C.den (C.Mout w) := fun i j =>
  (den_dvd_matDen _ i j).trans (Dvd.dvd.mul_left
    (Finset.dvd_prod_of_mem (fun w => matDen (C.Mout w)) (Finset.mem_univ w)) _)

lemma pivRank_toCircuit (C : QCircuit R m W) (Q : ℕ) (X : IMat m) :
    pivRank (C.toCircuit Q) X = (((C.den : ℚ)⁻¹ • ratM X).rank) :=
  card_piQ _

lemma pivRank_toCircuit_eq (C : QCircuit R m W) (Q : ℕ) :
    pivRank (C.toCircuit Q) = pivRank (C.toCircuit 1) :=
  funext fun X => by rw [pivRank_toCircuit, pivRank_toCircuit]

lemma costConst_toCircuit (C : QCircuit R m W) (Q : ℕ) :
    costConst (C.toCircuit Q) = costConst (C.toCircuit 1) := by
  rw [costConst, costConst, pivRank_toCircuit_eq]; rfl

/-- Every frame-change pair of the rational run has `LabOK` labels. -/
lemma framesOK2_labOK (C : QCircuit R m W) :
    FramesOK2 (fun a b => LabOK C.den a ∧ LabOK C.den b) C.gates C.Min C.Mout :=
  framesOK2_of_lab _ _ _ _ (fun _ hg => C.labOK_gate hg) C.labOK_Min C.labOK_Mout

lemma rankSum_toCircuit (C : QCircuit R m W) (Q : ℕ) :
    rankSum (C.toCircuit Q) = frameSum (fun A => A.rank) C.gates C.Min C.Mout := by
  rw [rankSum, frameSum_eq2, frameSum_eq2]
  change frameSum2 _ (mapG (intM C.den) C.gates) (fun w => intM C.den (C.Min w))
    (fun w => intM C.den (C.Mout w)) = _
  rw [frameSum2_mapG]
  apply frameSum2_congr
  refine framesOK2_mono (fun a b h => ?_) _ _ _ C.framesOK2_labOK
  rw [pivRank_toCircuit, intM_sub h.1 h.2, smul_smul,
    inv_mul_cancel₀ (by exact_mod_cast C.den_pos.ne'), one_smul]

end QCircuit

section Main

variable {R : Type*} [CommRing R] {m W : ℕ} [NeZero W]

/-- **Proposition 11 for circuits with rational labels.** Given a circuit with labels in
`Matrix (Fin m) (Fin m) ℚ`, gates OK, the scalar routing `ρ`, `Mout (ρ w) − Min w = 1` over `ℚ`,
and `s / W < m ^ τ` with `s = Σ_e rank_ℚ A_e` over all frame changes `A_e`, there is `q₀` such that
for every prime `q > q₀` and every level bound `K`, the program run on the integer circuit
`C.toCircuit (q ^ m ^ K)` (labels `D • M`, scaled frame action `D⁻¹ •`, Lemma 10 factors the lifts
mod `q ^ m ^ K` of the rational Bruhat factors of each `A_e`) satisfies:
1. at every level `k ≤ K`, it interchanges the two chunks of `m ^ k` radix-`q` digits;
2. its cost is `≤ K₀ V (m ^ k) ^ τ` with `K₀` independent of `K`. -/
theorem prop11_ratLabels (C : QCircuit R m W) (hm : 2 ≤ m)
    (gatesOK : ∀ g ∈ C.gates, g.OK)
    (route : ∀ (v : Fin W → R) w, scalarRun C.gates v (C.ρ w) = v w)
    (unit : ∀ w, C.Mout (C.ρ w) - C.Min w = 1) {τ : ℝ} (hτ : 0 < τ ∧ τ < 1)
    (hs : ((frameSum (fun A : QMat m => A.rank) C.gates C.Min C.Mout : ℕ) : ℝ) / W <
      (m : ℝ) ^ τ) :
    ∃ q₀ : ℕ, ∀ q, q.Prime → q₀ < q →
      (∀ K k, k ≤ K → ∀ (P L : ℕ) (A B Cs : Shape) (xs : List R), W ^ k ∣ L →
        xs.length = vol (P :: L :: hdShape A B Cs (m ^ k) q) →
        AModel.prog (C.toCircuit (q ^ m ^ K)) q k P L A B Cs xs =
          pull (P :: L :: hdShape A B Cs (m ^ k) q) (P :: L :: hdShape A B Cs (m ^ k) q)
            (blockSwap (A.length + 2) (A.length + B.length + m ^ k + 2) (m ^ k)) 0 xs) ∧
      ∃ K₀ : ℝ, 0 ≤ K₀ ∧ ∀ K k V, 0 ≤ V →
        progCost (C.toCircuit (q ^ m ^ K)) q k V ≤ K₀ * V * ((m : ℝ) ^ k) ^ τ := by
  classical
  set D := C.den with hDdef
  have hD0 : 0 < D := C.den_pos
  set S := (frameMS C.gates C.Min C.Mout).toFinset with hS
  have hPi : ∀ Q, FramesOK (PiOK (C.toCircuit Q).fac) (C.toCircuit Q).gates (C.toCircuit Q).Min
      (C.toCircuit Q).Mout := fun Q =>
    framesOK_of_mem _ _ _ _ fun a _ => piQ_01 _
  have hrank : ∀ Q, (rankSum (C.toCircuit Q) : ℝ) / W < (m : ℝ) ^ τ := fun Q => by
    rw [QCircuit.rankSum_toCircuit]; exact hs
  refine ⟨max 2 (D + ∑ A ∈ S, facBoundQ A), fun q hq hlt => ⟨fun K k hk P L A B Cs xs hL hxs => ?_, ?_⟩⟩
  · have hDq : Nat.Coprime D q := coprime_of_lt hq hD0 (by omega)
    have hgood : ∀ A ∈ S, GoodAtQ q A := fun A hA => goodAtQ_of_lt A hq (by
      have := Finset.single_le_sum (f := facBoundQ) (fun _ _ => Nat.zero_le _) hA
      omega)
    -- the rational frame changes all lie in `S`
    have hFS : FramesOK2 (fun a b => a - b ∈ S) C.gates C.Min C.Mout :=
      (framesOK_iff2 _ _ _ _).1 (framesOK_of_mem (fun A => A ∈ S) _ _ _
        fun a ha => Multiset.mem_toFinset.2 ha)
    have hOK : ∀ k' < K, ∃ φ I0, OKφ (C.toCircuit (q ^ m ^ K)) (q ^ m ^ k') φ I0 := by
      intro k' hk'
      have hN : q ^ m ^ k' ∣ q ^ m ^ K := pow_dvd_pow q (Nat.pow_le_pow_right (by omega) hk'.le)
      have hDN : Nat.Coprime D (q ^ m ^ k') := hDq.pow_right _
      refine ⟨phiD (q ^ m ^ k') D, (D : ℤ) • (1 : IMat m),
        mapG_OK _ _ gatesOK, fun v w => ?_, fun w => ?_, ?_, ?_⟩
      · show scalarRun (mapG (intM C.den) C.gates) v (C.ρ w) = v w
        rw [scalarRun_mapG]; exact route v w
      · show intM D (C.Mout (C.ρ w)) - intM D (C.Min w) = _
        apply ratM_injective
        rw [intM_sub (C.labOK_Mout _) (C.labOK_Min _), unit]
        ext i j
        simp only [ratM, Matrix.map_apply, Matrix.smul_apply, Matrix.one_apply, smul_eq_mul]
        split_ifs <;> simp [hDdef]
      · ext i j
        simp only [phiD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Matrix.smul_apply, castM,
          Matrix.map_apply, smul_eq_mul, Matrix.one_apply]
        split_ifs
        · simp only [mul_one, eq_intCast, Int.cast_natCast]
          exact ZMod.inv_mul_of_unit _ ((ZMod.isUnit_iff_coprime D _).2 hDN)
        · simp
      · rw [framesOK_iff2]
        change FramesOK2 _ (mapG (intM C.den) C.gates) (fun w => intM C.den (C.Min w))
          (fun w => intM C.den (C.Mout w))
        apply framesOK2_mapG
        refine framesOK2_mono (fun a b h => ?_) _ _ _
          (framesOK2_and _ _ _ C.framesOK2_labOK hFS)
        exact facAtφ_facD hq hN hDq hD0 (hgood _ h.2) (intM_sub h.1.1 h.1.2)
    rw [prog_correctφ _ (by omega) hOK k hk P L A B Cs xs hL
      (by rw [hxs]; simp only [vol_cons, vol_hdShape]), pull_swapPos_eq_blockSwap]
  · set C1 := C.toCircuit 1
    obtain ⟨K₀, hK0, hK⟩ := power_width_time m W (rankSum C1) τ (costConst C1) hm
      (NeZero.pos W) hτ (hrank 1) (by linarith [one_le_costConst C1])
    refine ⟨K₀, hK0, fun K => ?_⟩
    have hc := QCircuit.costConst_toCircuit C (q ^ m ^ K)
    have hr : rankSum (C.toCircuit (q ^ m ^ K)) = rankSum C1 := by
      rw [QCircuit.rankSum_toCircuit, QCircuit.rankSum_toCircuit]
    refine hK (progCost (C.toCircuit (q ^ m ^ K)) q) (fun V hV => ?_) (fun k V _ => ?_)
    · simp only [progCost]
      nlinarith [one_le_costConst C1]
    · have hN : 1 < q ^ m ^ k := Nat.one_lt_pow (by positivity) (by
        have := hq.two_le; omega)
      simp only [progCost]
      rw [levelCost_eqZ _ hN (hPi _), hc, hr]

end Main

end AModelRat

end

