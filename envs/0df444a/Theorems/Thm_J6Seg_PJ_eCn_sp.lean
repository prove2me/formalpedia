theorem J6Seg.PJ.eCn_sp (pl : Plan6) {k pre post s t p α d W M B : ℕ} {Zn : Fin HS}
    (hZ : Zn ∉ rg) (hZ5 : Zn.val < 56) (hZT : Zn ≠ sTmp) (hZC : Zn ≠ cRdC) (hZ2 : Zn ≠ sT2)
    (hZx : Zn ≠ J6Seg.PJ.sSt ∧ Zn ≠ sX ∧ Zn ≠ sOut ∧ Zn ≠ sLn ∧ Zn ≠ cLC ∧ Zn ≠ 13 ∧ Zn ≠ 51 ∧ Zn ≠ 53 ∧
      Zn ≠ 54 ∧ Zn ≠ PreT.Cu)
    (oN : Fin 19 → Fin HS) (hinj : Injective oN) (hlt : ∀ i, (oN i).val < 56)
    (hx : ∀ i, oN i ≠ sX ∧ oN i ≠ sLn ∧ oN i ≠ sOut ∧ oN i ≠ sT2 ∧ oN i ≠ cLC) (hZo : ∀ i, oN i ≠ Zn)
    (hW : parBig pl.kA pl.kC pl.wA pl.wC k pre post s t p α d < 2 ^ W)
    (bpk : pl.pkA * segPF p d s + pl.pkC ≤ 2 ^ W) (bb : pl.bA * segPF p d s + pl.bC ≤ 2 ^ W)
    (bl : pl.pkA + pl.pkC + pl.bA + pl.bC + 2 ≤ 2 ^ W)
    (hPA : segPF p d s ≤ W) (hA2 : 2 ≤ W)
    (TB : PreT.TabB (segPF p d s) (p / 7) s t α (lamP d) W)
    (hpkM : pl.pkA * segPF p d s + pl.pkC ≤ M) (hbM : pl.bA * segPF p d s + pl.bC ≤ M)
    (hncA : t / lamP d * lamP d ≤ 2 ^ W) (hncA' : t / lamP d * (9 + 10 * lamP d) ≤ 2 ^ W)
    (hvB : ∀ a ∈ cVals (pl.wA * segPF p d s + pl.wC) (Nat.log 2 (lamF d)) pre (t / lamP d) post,
      zsz a ≤ B)
    (hlB : zsz ((tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
      (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)).length : ℤ) ≤ B)
    (hTB : Bnd B (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
      (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)))
    (s0 : IState HS) :
    Sp (eCn pl Zn oN) (encK s0 (F0 Zn (dsc k pre post s t p α d)))
      (encK s0 (extend oN (kerRegs (pl.wA * segPF p d s + pl.wC) (pl.wA * segPF p d s + pl.wC)
        (Nat.log 2 (lamF d)) pre (t / lamP d) post
        (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
          (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)))
        (F0 Zn (dsc k pre post s t p α d))))
      (cECn pl W d (NF d s) (segPF p d s) (lamP d) (p / 7) M (t / lamP d) B
        (tabsT (PreT.tabQ2 (segPF p d s) (p / 7) s t (lamP d) α
          (pl.pkA * segPF p d s + pl.pkC) (pl.bA * segPF p d s + pl.bC)) (t / lamP d)).length) := by sorry
