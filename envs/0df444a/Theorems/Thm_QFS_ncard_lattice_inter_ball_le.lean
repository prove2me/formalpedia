variable {d : ℕ}

lemma QFS.ncard_lattice_inter_ball_le (a : EuclideanSpace ℝ (Fin d)) (R : ℝ) :
    (ball a R ∩ lattice d).ncard ≤ (2 * ⌈R⌉₊ + 1) ^ d := by sorry
