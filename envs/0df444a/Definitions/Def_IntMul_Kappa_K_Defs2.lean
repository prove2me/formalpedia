section
-- Source module: Solutions.ButterflyTensor
/-!
# §5.1 Phase-frame identities and tensor products on selected bits

The `2 × 2` matrices of §5.1 of the OpenAI preprint "Integer multiplication below n log n":
`H0 = ½[[1,1],[1,-1]]`, `S = diag(1,i)`, `Z = diag(1,-1)`, `X = [[0,1],[1,0]]`,
`C = HSH = aI + bX` with `a = (1+i)/2`, `b = (1-i)/2`, and the identities (13), (14), (17), (18).

Tensor products over an arbitrary finite set `ι` of selected bits:
`tensF A x y = ∏ i, A i (x i) (y i)` for a family `A : ι → M₂`.
-/

namespace Butterfly

open Matrix Complex Finset

/-- `2 × 2` complex matrices. -/
abbrev M2 := Matrix (Fin 2) (Fin 2) ℂ

/-- `H0 = ½ [[1,1],[1,-1]]`, the normalized butterfly `(u,v) ↦ ((u+v)/2, (u-v)/2)`. -/
noncomputable def H0 : M2 := !![1 / 2, 1 / 2; 1 / 2, -1 / 2]
/-- `S = diag(1, i)`. -/
def Sm : M2 := !![1, 0; 0, I]
/-- `Z = diag(1, -1)`. -/
def Zm : M2 := !![1, 0; 0, -1]
/-- The bit flip `X`. -/
def Xm : M2 := !![0, 1; 1, 0]
/-- `a = (1+i)/2`. -/
noncomputable def ca : ℂ := (1 + I) / 2
/-- `b = (1-i)/2`. -/
noncomputable def cb : ℂ := (1 - I) / 2
/-- The auxiliary two-point kernel `C = aI + bX` (13). -/
noncomputable def Cm : M2 := Butterfly.ca • (1 : M2) + Butterfly.cb • Xm
/-- Its inverse `C⁻¹ = bI + aX` (14). -/
noncomputable def Cinv : M2 := Butterfly.cb • (1 : M2) + Butterfly.ca • Xm

lemma Cm_eq : Butterfly.Cm = !![Butterfly.ca, Butterfly.cb; Butterfly.cb, Butterfly.ca] := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [Butterfly.Cm, Xm]

lemma Cinv_eq : Cinv = !![Butterfly.cb, Butterfly.ca; Butterfly.ca, Butterfly.cb] := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [Cinv, Xm]

/-- (14): `C⁻¹ = -i Z C Z`. -/
theorem Cinv_eq_ZCZ : Cinv = (-I) • (Zm * Butterfly.Cm * Zm) := by
  rw [Cm_eq, Cinv_eq]
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [Zm, Matrix.mul_apply, Fin.sum_univ_two, Butterfly.ca, Butterfly.cb] <;> ring_nf <;> simp [I_sq] <;> ring

/-! ## Tensor products on selected bits -/

section Tensor

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- Tensor product of a family of `2 × 2` matrices over the selected bits `ι`. -/
def tensF (A : ι → M2) : Matrix (ι → Fin 2) (ι → Fin 2) ℂ := fun x y => ∏ i, A i (x i) (y i)

/-- Tensor power of one `2 × 2` matrix. -/
def tens (A : M2) : Matrix (ι → Fin 2) (ι → Fin 2) ℂ := tensF (fun _ => A)

/-- The tensor product is multiplicative. -/
theorem tensF_mul (A B : ι → M2) : tensF (fun i => A i * B i) = tensF A * tensF B := by
  ext x z
  simp only [tensF, Matrix.mul_apply]
  rw [Fintype.prod_sum]
  simp only [← Finset.prod_mul_distrib]

theorem tensF_smul (c : ι → ℂ) (A : ι → M2) :
    tensF (fun i => c i • A i) = (∏ i, c i) • tensF A := by
  ext x y
  simp [tensF, Finset.prod_mul_distrib]

theorem tens_mul (A B : M2) : (Butterfly.tens (A * B) : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    Butterfly.tens A * Butterfly.tens B := tensF_mul _ _

theorem tens_smul (c : ℂ) (A : M2) :
    (Butterfly.tens (c • A) : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) = c ^ Fintype.card ι • Butterfly.tens A := by
  rw [Butterfly.tens, tensF_smul (fun _ => c), Finset.prod_const, Finset.card_univ]; rfl

/-- (17): `(C⁻¹)^{⊗f} = (-i)^f Z^{⊗f} C^{⊗f} Z^{⊗f}`. -/
theorem tens_Cinv : (Butterfly.tens Cinv : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    (-I) ^ Fintype.card ι • (Butterfly.tens Zm * Butterfly.tens Butterfly.Cm * Butterfly.tens Zm) := by
  rw [Cinv_eq_ZCZ, tens_smul, tens_mul, tens_mul]

/-- Number of selected bits equal to one. -/
def wt (x : ι → Fin 2) : ℕ := ∑ i, (x i : ℕ)

/-- The phase diagonal `S_D`: `(S_D z)(x) = i^{x_1+⋯+x_D} z(x)`. -/
noncomputable def SD : Matrix (ι → Fin 2) (ι → Fin 2) ℂ := diagonal fun x => I ^ Butterfly.wt x

/-- The sign diagonal `Z^{⊗}`: `(-1)^{x_1+⋯+x_D}`. -/
noncomputable def ZD : Matrix (ι → Fin 2) (ι → Fin 2) ℂ := diagonal fun x => (-1) ^ Butterfly.wt x

lemma diag2_tens (u v : ℂ) : (Butterfly.tens !![u, 0; 0, v] : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    diagonal fun x => ∏ i, (if x i = 0 then u else v) := by
  ext x y
  simp only [Butterfly.tens, tensF, diagonal_apply]
  by_cases h : x = y
  · subst h; simp only [if_true]
    refine Finset.prod_congr rfl fun i _ => ?_
    rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h0 | h1 <;> simp [*]
  · simp only [h, if_false]
    obtain ⟨i, hi⟩ : ∃ i, x i ≠ y i := by
      by_contra hc; push Not at hc; exact h (funext hc)
    apply Finset.prod_eq_zero (mem_univ i)
    rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h0 | h0 <;>
    rcases Fin.exists_fin_two.1 ⟨y i, rfl⟩ with h1 | h1 <;> simp_all

lemma prod_phase (c : ℂ) (x : ι → Fin 2) :
    ∏ i, (if x i = 0 then (1 : ℂ) else c) = c ^ Butterfly.wt x := by
  rw [Butterfly.wt, ← Finset.prod_pow_eq_pow_sum]
  congr 1; ext i
  rcases Fin.exists_fin_two.1 ⟨x i, rfl⟩ with h | h <;> simp [h]

theorem tens_Zm : (Butterfly.tens Zm : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) = ZD := by
  rw [Zm, diag2_tens, ZD]; congr 1; funext x; exact prod_phase (-1) x

/-- (17) with the `S_D`/`Z_D` diagonals named. -/
theorem tens_Cinv' : (Butterfly.tens Cinv : Matrix (ι → Fin 2) (ι → Fin 2) ℂ) =
    (-I) ^ Fintype.card ι • (ZD * Butterfly.tens Butterfly.Cm * ZD) := by
  rw [tens_Cinv, tens_Zm]

end Tensor

/-! ## (15): address permutations conjugate translations -/

section Translate

