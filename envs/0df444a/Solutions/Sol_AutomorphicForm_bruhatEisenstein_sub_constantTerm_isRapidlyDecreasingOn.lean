section Slice

variable {F : Type} [Field F] [NumberField F] {w : InfinitePlace F} (hw : w.IsReal)

private theorem slice_eq {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ) (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) :
    φ (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = ((χ₁ (realIdeleAt hw (detUnit hw x)) : ℂˣ) : ℂ)
          * psiW hw χ₁ χ₂ (Real.log (rad (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w))))
          * φ (awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
              * rhoW hw (angle (gOf hw x) (ringEquivRealOfIsReal hw (a.1 w)))) := by
  rw [inducedSection_weyl_unipotent hw hφ x a, charFactor_eq hw χ₁ χ₂]
  rfl

private theorem ringEquiv_fst_translate (a : AdeleRing (𝓞 F) F) {E : ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y) (y : ℝ) :
    ringEquivRealOfIsReal hw ((a + E y).1 w) = ringEquivRealOfIsReal hw (a.1 w) + y := by
  show ringEquivRealOfIsReal hw (a.1 w + (E y).1 w) = _
  rw [hEw, map_add, RingEquiv.apply_symm_apply]

private theorem norm_fst_translate (a : AdeleRing (𝓞 F) F) {E : ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y) (y : ℝ) :
    ‖(a + E y).1 w‖ = |ringEquivRealOfIsReal hw (a.1 w) + y| := by
  rw [← Real.norm_eq_abs, ← ringEquiv_fst_translate hw a hEw y, norm_ringEquivRealOfIsReal]

private theorem awayFrom_translate (a : AdeleRing (𝓞 F) F) {E : ℝ → AdeleRing (𝓞 F) F}
    (hEv : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE2 : ∀ y, (E y).2 = 0)
    (x : AdelicGL2 (𝓞 F) F) (y : ℝ) :
    awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)
      = awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x) :=
  awayFrom_weyl_unipotent_eq_of_agree F w
    (fun v hvw => show a.1 v + (E y).1 v = a.1 v by rw [hEv y v hvw, add_zero])
    (show a.2 + (E y).2 = a.2 by rw [hE2 y, add_zero]) x

private theorem slice_translate_eq {χ₁ χ₂ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {φ : AdelicGL2 (𝓞 F) F → ℂ}
    (hφ : IsInducedSection (𝓞 F) F χ₁ χ₂ φ)
    {m : ℕ} {kv : Fin m → AdelicGL2 (𝓞 F) F} {c : Fin m → ℝ → ℂ}
    (hexp : ∀ (θ : ℝ) (x : AdelicGL2 (𝓞 F) F), φ (x * rhoW hw θ) = ∑ i, c i θ * φ (x * kv i))
    (x : AdelicGL2 (𝓞 F) F) (a : AdeleRing (𝓞 F) F) {E : ℝ → AdeleRing (𝓞 F) F}
    (hEw : ∀ y, (E y).1 w = (ringEquivRealOfIsReal hw).symm y)
    (hEv : ∀ y (v : InfinitePlace F), v ≠ w → (E y).1 v = 0) (hE2 : ∀ y, (E y).2 = 0) (y : ℝ) :
    φ (adelicWeyl (𝓞 F) F * unipotentGL2 (a + E y) * x)
