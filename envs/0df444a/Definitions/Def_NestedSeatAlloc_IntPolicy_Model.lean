-- title:
--   §1–§2, pp. 129–131, Eqs. (8)–(9), (20), (31) — nested fare-class revenue R_k, expected revenue ER_k, subdifferential, optimality
-- statement:
--   This file fixes the model of Brumelle and McGill's analysis of seat allocation on a single flight leg with an unlimited number of nested fare classes.
--
--   **Fare classes, demands, fares.** Classes are numbered $k = 1, 2, \dots$, class $1$ carrying the highest fare. The demand of class $k$ is a random variable $X_k \ge 0$ on a probability space $(\Omega, \mathcal F, P)$, and each booking of class $k$ earns the fare $f_k$. The standing assumptions of §1 (p. 129) are collected in the predicate *seat model*:
--   1. $P$ is a probability measure;
--   2. every $X_k$ is measurable and nonnegative;
--   3. the demands $X_1, X_2, \dots$ are mutually independent;
--   4. the fares are strictly decreasing, $f_1 > f_2 > \cdots$.
--
--   **Protection-level policies.** A policy of the class $\mathcal P$ (pp. 129–130) is a vector $p = (p_1, p_2, \dots)$ with $p_k \ge 0$: $p_k$ seats are protected for the nest of the $k$ highest classes, and a request of class $k+1$ is accepted only while more than $p_k$ seats remain.
--
--   **Revenue** (8)–(9), p. 130. For a demand vector $x = (x_1, x_2, \dots)$ and $s$ available seats,
--   $$R_1[s; p; x] = \begin{cases} f_1 s & 0 \le s < x_1, \\ f_1 x_1 & x_1 \le s, \end{cases}$$
--   $$R_{k+1}[s; p; x] = \begin{cases} R_k[s; p; x] & 0 \le s < p_k, \\ (s - p_k) f_{k+1} + R_k[p_k; p; x] & p_k \le s < p_k + x_{k+1}, \\ x_{k+1} f_{k+1} + R_k[s - x_{k+1}; p; x] & p_k + x_{k+1} \le s. \end{cases}$$
--   The expected revenue is $ER_k[s; p; X] = E\,R_k[s; p; X]$, and $E\{R_k[s; p; X] \mid X_k = y\}$ denotes the expected revenue with the class-$k$ demand frozen at the value $y$.
--
--   **Subdifferential** (p. 131). For $g : \mathbb R \to \mathbb R$ and $t \ge 0$, $c \in \delta g[t]$ means $\delta_+ g[t] \le c \le \delta_- g[t]$, where $\delta_+$ and $\delta_-$ are the right and left derivatives, with the convention $\delta_- g[0] = +\infty$. Condition (20) of Theorem 1 is
--   $$f_{k+1} \in \delta ER_k[p_k; (p_0, \dots, p_{k-1}); X], \qquad k = 1, 2, \dots$$
--
--   **Optimality** (p. 130: "find a vector $p$ that maximizes the expected revenue $ER_k[s; p; X]$ for all $k$"). A policy $p$ is *optimal* if $ER_k[s; q; X] \le ER_k[s; p; X]$ for every policy $q \in \mathcal P$, every $k \ge 1$ and every $s \ge 0$.
--
--   **Condition (31)** (p. 134). With $A_k(p) = [X_1 > p_1 \cap X_1 + X_2 > p_2 \cap \dots \cap X_1 + \dots + X_k > p_k]$,
--   $$f_1 \Pr[A_k(p)] = f_{k+1} \qquad \text{for all } k \ge 1.$$
--
--   These objects are the vocabulary of every statement of the mission: the concavity results (Lemma 1, Corollary 1), the derivative formulas (27), (32), (37), and the optimality theorems (Theorems 1 and 3).
--
--   **Formalization Note** Classes are indexed by $\mathbb N$ starting from $1$; index $0$ is the paper's dummy and is never read, and $R_0 \equiv 0$ by convention. Seats, demands and protection levels are real numbers, as in the paper's nonsmooth approach. Expectations are Bochner integrals. $E\{\cdot \mid X_k = y\}$ is the integral with the $k$-th coordinate of the demand vector replaced by $y$; because the demands are independent, this is a version of the conditional expectation given $X_k$, and statements "with probability 1" become statements for every $y \ge 0$. One-sided derivatives are `HasDerivWithinAt` on $[t, \infty)$ and $(-\infty, t]$ and are required to exist; the convention $\delta_- g[0] = +\infty$ is the disjunct $t = 0$. The seat model also carries $X_0$ (measurable, nonnegative, part of the independent family), which no statement reads. Fares are not assumed positive.
-- source:
--   Brumelle & McGill (1993), Operations Research 41(1), §1–§2, pp. 129–131, Eqs. (8)–(9); Theorem 1 (20), p. 131; Lemma 2 (31), p. 134

import Mathlib

namespace NestedSeatAlloc.IntPolicy

open MeasureTheory ProbabilityTheory

/-- The revenue `R_k[s; p; x]` generated by the `k` highest fare classes when `s` seats are available
(Brumelle–McGill 1993, Eqs. (8)–(9), p. 130). Classes are numbered from `1`, the highest fare: `f k` is the
fare of class `k`, `x k` its demand, and `p k` the number of seats protected for the nest of classes
`1, …, k`. `R_{k+1}` reads only `p 1, …, p k`, `x 1, …, x (k+1)` and `f 1, …, f (k+1)`. Index `0` is not used
by the paper; `revenue f p x 0 s = 0`. -/
noncomputable def revenue (f p x : ℕ → ℝ) : ℕ → ℝ → ℝ
  | 0, _ => 0
  | 1, s => if s < x 1 then f 1 * s else f 1 * x 1
  | k + 2, s =>
      if s < p (k + 1) then revenue f p x (k + 1) s
      else if s < p (k + 1) + x (k + 2) then
        (s - p (k + 1)) * f (k + 2) + revenue f p x (k + 1) (p (k + 1))
      else x (k + 2) * f (k + 2) + revenue f p x (k + 1) (s - x (k + 2))

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The expected revenue `ER_k[s; p; X] = E[R_k[s; p; X]]` (p. 130) of the `k` highest fare classes with
`s` seats available, when the demands are the random variables `X k : Ω → ℝ` on `(Ω, P)`. -/
noncomputable def expRevenue (P : Measure Ω) (X : ℕ → Ω → ℝ) (f p : ℕ → ℝ) (k : ℕ) (s : ℝ) : ℝ :=
  ∫ ω, revenue f p (fun i => X i ω) k s ∂P

/-- `E{R_k[s; p; X] | X_k = y}` (pp. 131–134): the expected revenue of the `k` highest fare classes with the
demand of class `k` frozen at the value `y`. The demands being independent, this is a version of the
conditional expectation of `R_k[s; p; X]` given `X_k`, evaluated at `X_k = y`. -/
noncomputable def condRevenue (P : Measure Ω) (X : ℕ → Ω → ℝ) (f p : ℕ → ℝ) (k : ℕ) (y s : ℝ) : ℝ :=
  ∫ ω, revenue f p (Function.update (fun i => X i ω) k y) k s ∂P

/-- The standing assumptions of §1 (p. 129): `P` is a probability measure; the demands `X 1, X 2, …` are
measurable, nonnegative and stochastically independent; the fares are strictly decreasing,
`f 1 > f 2 > ⋯`. -/
structure IsSeatModel (P : Measure Ω) (X : ℕ → Ω → ℝ) (f : ℕ → ℝ) : Prop where
  isProb : IsProbabilityMeasure P
  meas : ∀ k, Measurable (X k)
  indep : iIndepFun X P
  nonneg : ∀ k ω, 0 ≤ X k ω
  fare_strictAnti : ∀ k, 1 ≤ k → f (k + 1) < f k

/-- A fixed protection-level policy (the class `𝒫`, pp. 129–130): `p k ≥ 0` seats are protected for the nest
of the `k` highest fare classes, `k ≥ 1`. The paper's dummy `p₀ = 0` is never read. -/
def IsProtectionPolicy (p : ℕ → ℝ) : Prop :=
  ∀ k, 1 ≤ k → 0 ≤ p k

/-- `c ∈ δg[t]` (p. 131): `δ₊g[t] ≤ c ≤ δ₋g[t]`, where `δ₊` and `δ₋` are the right and left derivatives,
both required to exist, with the convention `δ₋g[0] = +∞`. -/
def InSubdiff (g : ℝ → ℝ) (t c : ℝ) : Prop :=
  (∃ r, HasDerivWithinAt g r (Set.Ici t) t ∧ r ≤ c) ∧
    (t = 0 ∨ ∃ l, HasDerivWithinAt g l (Set.Iic t) t ∧ c ≤ l)

/-- Condition (20) (Theorem 1, p. 131): `f_{k+1} ∈ δER_k[p_k; (p₀, …, p_{k−1}); X]` for `k = 1, 2, …`. -/
def SubdiffCondition (P : Measure Ω) (X : ℕ → Ω → ℝ) (f p : ℕ → ℝ) : Prop :=
  ∀ k, 1 ≤ k → InSubdiff (expRevenue P X f p k) (p k) (f (k + 1))

/-- Optimality (p. 130: "find a vector p that maximizes the expected revenue `ER_k[s; p; X]` for all k"): for
every `k ≥ 1` and every number `s ≥ 0` of available seats, no protection-level policy `q` has a larger expected
revenue than `p`. -/
def IsOptimal (P : Measure Ω) (X : ℕ → Ω → ℝ) (f p : ℕ → ℝ) : Prop :=
  ∀ q, IsProtectionPolicy q → ∀ k, 1 ≤ k → ∀ s, 0 ≤ s →
    expRevenue P X f q k s ≤ expRevenue P X f p k s

/-- The event `[X₁ > p₁ ∩ X₁ + X₂ > p₂ ∩ ⋯ ∩ X₁ + ⋯ + X_k > p_k]` of (31) (p. 134). -/
def nestEvent (X : ℕ → Ω → ℝ) (p : ℕ → ℝ) (k : ℕ) : Set Ω :=
  {ω | ∀ j ∈ Finset.Icc 1 k, p j < ∑ i ∈ Finset.Icc 1 j, X i ω}

/-- Condition (31) (Lemma 2, p. 134): `f₁ Pr[X₁ > p₁ ∩ ⋯ ∩ X₁ + ⋯ + X_k > p_k] = f_{k+1}` for all `k ≥ 1`. -/
def ProbCondition (P : Measure Ω) (X : ℕ → Ω → ℝ) (f p : ℕ → ℝ) : Prop :=
  ∀ k, 1 ≤ k → f 1 * P.real (nestEvent X p k) = f (k + 1)

end NestedSeatAlloc.IntPolicy


