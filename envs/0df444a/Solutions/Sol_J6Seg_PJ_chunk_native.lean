namespace J6Seg.TabBnd
open IntMul.HvdH IntMul.HvdH.JPf J6QLU J6Seg

variable {P R s t α lam : ℕ}

lemma int_abs_of_real {x : ℤ} {A : ℕ} (h : |(x : ℝ)| ≤ (2 : ℝ) ^ A) : |x| ≤ 2 ^ A := by
  have : ((|x| : ℤ) : ℝ) ≤ ((2 ^ A : ℤ) : ℝ) := by push_cast; exact h
  exact_mod_cast this

/-- From an ulp bound `|x - 2^P y| ≤ E` with `|y| ≤ 2^R · 1.0001`, `E ≤ 2^P`: `|x| ≤ 2^(P+R+2)`. -/
lemma abs_of_err {x : ℤ} {y E : ℝ} (h : |(x : ℝ) - 2 ^ P * y| ≤ E) (hy : |y| ≤ 2 * 2 ^ R)
    (hE : E ≤ 2 ^ P) (hR1 : (1 : ℝ) ≤ 2 ^ R) : |x| ≤ 2 ^ (P + R + 2) := by
  apply int_abs_of_real
  have hS : (0 : ℝ) < 2 ^ P := by positivity
  have e : (2 : ℝ) ^ (P + R + 2) = 4 * 2 ^ P * 2 ^ R := by rw [pow_add, pow_add]; ring
  rw [e]
  have h1 : |(x : ℝ)| ≤ |(x : ℝ) - 2 ^ P * y| + |2 ^ P * y| := by
    have := abs_add_le ((x : ℝ) - 2 ^ P * y) (2 ^ P * y); simpa using this
  rw [abs_mul, abs_of_pos hS] at h1
  have h2 : 2 ^ P * |y| ≤ 2 ^ P * (2 * 2 ^ R) := mul_le_mul_of_nonneg_left hy hS.le
  nlinarith

