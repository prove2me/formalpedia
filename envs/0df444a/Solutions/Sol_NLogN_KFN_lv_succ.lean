theorem sum_le_count' {α : Type*} (p : α → Bool) (x y : ℕ) (f : α → ℕ) :
    ∀ l : List α, (∀ a ∈ l, f a ≤ if p a then x else y) →
      (l.map f).sum ≤ l.countP p * x + l.length * y
  | [], _ => by simp
  | a :: l, hf => by
    have ih := sum_le_count' p x y f l (fun b hb => hf b (List.mem_cons_of_mem _ hb))
    have ha := hf a List.mem_cons_self
    simp only [List.map_cons, List.sum_cons, List.countP_cons, List.length_cons]
    split_ifs at ha with hp
    · simp only [hp, if_true]; nlinarith
    · simp only [hp, Bool.false_eq_true, if_false, add_zero]; nlinarith

theorem sum_ite_le' {α : Type*} (p : α → Bool) (x y : ℝ) (hy : 0 ≤ y) (f : α → ℝ) :
    ∀ l : List α, (∀ a ∈ l, f a ≤ if p a then x else y) →
      (l.map f).sum ≤ (l.countP p : ℝ) * x + (l.length : ℝ) * y
  | [], _ => by simp
  | a :: l, hf => by
    have ih := sum_ite_le' p x y hy f l (fun b hb => hf b (List.mem_cons_of_mem _ hb))
    have ha := hf a List.mem_cons_self
    simp only [List.map_cons, List.sum_cons, List.countP_cons, List.length_cons]
    split_ifs at ha with hp
    · simp only [hp, if_true]; push_cast; linarith
    · simp only [hp, Bool.false_eq_true, if_false, add_zero]; push_cast; linarith

section Ind

variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}

/-- **Every step of the network has an implementation with the step bounds.** -/
theorem step_ok (hGc : GClass J A) (hrow : RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k Ek DWk Wk : ℕ} {ck : ℝ} (IH : Lv Isym iprog K W m r Z Ψ k Ek DWk Wk ck)
    (pos : Fin m × Fin (m ^ k) → ℕ) (hinj : Function.Injective pos) {t S0 B : ℕ}
    (hpos : ∀ p, pos p < t) (haff : AffK2 K t m k pos) (hS : 1 ≤ S0) (hB : 1 ≤ B)
    (hdvd : W ^ k ∣ B) (hZ : zsz ((16 * (W * nR t S0 B * r)) : ℕ) ≤ Z) (O : ℕ)
    (hO1 : DWk + (Ek + 2) * W + Ek + 4 ≤ O) (hO2 : dwloc W A + 5 ≤ O)
    (a : RStep (Fin W) m) (ha : a ∈ J.net) :
    ∃ (code : ℕ → IStmt HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      RImplI Isym iprog r (nR t S0 B) (fun p => 2 ^ pos p * S0) (a.den (Butterfly.tens Cm)) code e dw cost ∧
      e ≤ (if a.isChild then Ek else 1) ∧
      dw ≤ (if a.isChild then DWk + (Ek + 2) * W else dwloc W A) ∧
      ∀ w, (cost w : ℝ) ≤ (if a.isChild then ck * ((nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + Wk) : ℝ)
          else 0) +
        ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) * ((W * nR t S0 B : ℕ) : ℝ) *
          (Xf r Ψ (w + O) : ℝ) := by
  have hG0 : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ := mul_nonneg hCR (by positivity)
  have lift : ∀ (cost : ℕ → ℕ),
      (∀ w, cost w ≤ alN W A * (W * nR t S0 B) * Xf r Ψ (w + O)) →
      ∀ w, (cost w : ℝ) ≤ 0 + ((alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) *
        ((W * nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + O) : ℝ) := by
    intro cost hc w
    have h1 : (cost w : ℝ) ≤ (alN W A : ℝ) * ((W * nR t S0 B : ℕ) : ℝ) * (Xf r Ψ (w + O) : ℝ) := by
      exact_mod_cast hc w
    have h2 : (0 : ℝ) ≤ CR * ((m : ℝ) ^ k + 1) ^ τ * ((W * nR t S0 B : ℕ) : ℝ) *
        (Xf r Ψ (w + O) : ℝ) := by positivity
    rw [zero_add, add_mul, add_mul]; linarith
  cases a with
  | gate G =>
    rcases hGc G ha with ⟨as, hA, hok, hts, rfl⟩ | ⟨U, rfl⟩
    · obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_gate (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
        pos hS hB (zsz_role2 hZ) as hA hok hts O hO2
      exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
        by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
    · obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_fixG (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
        pos hinj hpos hS hB hZ U O hO2
      exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
        by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | rowAdd w0 i j hij =>
    obtain ⟨c, e, d, k', R, he, hd, hk⟩ := step_row (A := A) hrow hCR hτ hW hr hΨm hZΨ pos hinj
      hpos haff hS hB hZ w0 i j hij O hO2
    exact ⟨c, e, d, k', R, by simpa [RStep.isChild] using he, by simpa [RStep.isChild] using hd,
      fun w => by simpa [RStep.isChild] using hk w⟩
  | phase w0 k₀ k₁ a =>
    obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_phase (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
      pos hpos hS hB hZ w0 k₀ k₁ a O hO2
    exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
      by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | perm σ =>
    obtain ⟨c, e, d, k', hf, R, he, hd, hk⟩ := step_perm (k := k) (A := A) (Ψ := Ψ) hW hr hΨm hZΨ
      pos hS hB (zsz_role2 hZ) σ O hO2
    exact ⟨fun _ => fcode c, e, d, k', R.toI hf, by simpa [RStep.isChild] using he,
      by simpa [RStep.isChild] using hd, by simpa [RStep.isChild] using lift k' hk⟩
  | child w0 h fwd =>
    obtain ⟨c, e, d, k', R, he, hd, hk⟩ := step_child (A := A) IH _ hG0 hW hr hΨm hZΨ pos hinj
      hpos haff hS hB hdvd hZ w0 h fwd O hO1
    exact ⟨c, e, d, k', R, by simpa [RStep.isChild] using he, by simpa [RStep.isChild] using hd,
      fun w => by simpa [RStep.isChild] using hk w⟩

end Ind

end NLogN.KFN

end

section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
open NLogN
open NLogN.KFN
open IntMul RS AModel KIL KFD KFB KFG KFH Complex P8Lift Butterfly
variable {Pp : ℕ} {Isym : List Sym} {iprog : Fin Pp → IStmt HS Pp}
variable {K : ℕ}
variable {W m s : ℕ} (J : Prop8IfaceR W m s) {A r Z : ℕ} {Ψ : ℕ → ℕ} {CR τ : ℝ}
theorem solution (hGc : NLogN.KFN.GClass J A) (hrow : NLogN.KFN.RowHyp Isym iprog K m r Z Ψ CR τ) (hCR : 0 ≤ CR) (hτ : 0 ≤ τ)
    (hW : 1 ≤ W) (hr : 1 ≤ r) (hΨm : Monotone Ψ) (hZΨ : ∀ v, Z + 2 ≤ Ψ v)
    {k Ek DWk Wk : ℕ} {ck : ℝ} (hck : 0 ≤ ck) (IH : NLogN.KFN.Lv Isym iprog K W m r Z Ψ k Ek DWk Wk ck) :
    NLogN.KFN.Lv Isym iprog K W m r Z Ψ (k + 1) (J.net.length + s * Ek)
      (s * (DWk + (Ek + 2) * W) + J.net.length * NLogN.KFN.dwloc W A)
      (s * (DWk + (Ek + 2) * W) + J.net.length * NLogN.KFN.dwloc W A +
        (DWk + (Ek + 2) * W + Ek + NLogN.KFN.dwloc W A + 10) + Wk)
      ((s / W : ℝ) * ck + ((s + J.net.length : ℕ) : ℝ) *
        ((NLogN.KFN.alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ) + 1) := by
  intro pos' t S0 B hinj hpos haff' hS hB hdvd hZ
  obtain ⟨c, hc⟩ := hdvd
  set B' := W ^ k * c with hB'def
  have hBB : B = W * B' := by rw [hc, pow_succ]; ring
  have hB' : 1 ≤ B' := by
    rcases Nat.eq_zero_or_pos B' with h | h
    · rw [hBB, h] at hB; simp at hB
    · exact h
  have hdvd' : W ^ k ∣ B' := ⟨c, rfl⟩
  set eqv : Fin m × Fin (m ^ k) ≃ Fin (m ^ (k + 1)) :=
    finProdFinEquiv.trans (finCongr (pow_succ' m k).symm)
  set pos : Fin m × Fin (m ^ k) → ℕ := fun p => pos' (eqv p)
  have hinj' : Function.Injective pos := hinj.comp eqv.injective
  have hpos' : ∀ p, pos p < t := fun p => hpos _
  have haff : NLogN.KFN.AffK2 K t m k pos := by
    obtain ⟨e, he, ht⟩ := haff'
    refine ⟨e, fun p => ?_, ht⟩
    have := he (eqv p)
    have hv : (eqv p).val = p.2.val + m ^ k * p.1.val := by
      simp [eqv, finProdFinEquiv]
    rw [hv] at this
    exact this
  have hZn : NLogN.zsz ((16 * (W * NLogN.KFN.nR t S0 B' * r)) : ℕ) ≤ Z := by
    have : W * NLogN.KFN.nR t S0 B' * r = B * 2 ^ t * S0 * r := by rw [hBB]; unfold NLogN.KFN.nR; ring
    rw [this]; exact hZ
  set L := J.net.length
  set O := DWk + (Ek + 2) * W + Ek + NLogN.KFN.dwloc W A + 10 with hOdef
  set G' := (NLogN.KFN.alN W A : ℝ) + CR * ((m : ℝ) ^ k + 1) ^ τ
  have hG' : 0 ≤ G' := by positivity
  have hO1 : DWk + (Ek + 2) * W + Ek + 4 ≤ O := by rw [hOdef]; omega
  have hO2 : NLogN.KFN.dwloc W A + 5 ≤ O := by rw [hOdef]; omega
  haveI : Inhabited (ℕ → NLogN.IStmt NLogN.HS Pp) := ⟨fun _ => .skip⟩
  have hstep : ∀ a, a ∈ J.net → ∃ (code : ℕ → NLogN.IStmt NLogN.HS Pp) (e dw : ℕ) (cost : ℕ → ℕ),
      NLogN.KFN.RImplI Isym iprog r (NLogN.KFN.nR t S0 B') (fun p => 2 ^ pos p * S0) (a.den (Butterfly.tens Butterfly.Cm)) code e dw cost ∧
      e ≤ (if a.isChild then Ek else 1) ∧
      dw ≤ (if a.isChild then DWk + (Ek + 2) * W else NLogN.KFN.dwloc W A) ∧
      ∀ w, (cost w : ℝ) ≤ (if a.isChild then ck * ((NLogN.KFN.nR t S0 B' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + Wk) : ℝ)
          else 0) + G' * ((W * NLogN.KFN.nR t S0 B' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + O) : ℝ) :=
    fun a ha => NLogN.KFN.step_ok J hGc hrow hCR hτ hW hr hΨm hZΨ IH pos hinj' hpos' haff hS hB'
      hdvd' hZn O hO1 hO2 a ha
  choose! code e dw cost hP using hstep
  have N := NLogN.KFN.sImpl_node J (by omega) (by omega) (NLogN.KFN.slaws_pow pos hinj' t S0 B' hpos')
    (fun p => NLogN.KFN.dvd_pow_lay pos t S0 B' hpos' p) code e dw cost (fun a ha => (hP a ha).1)
  have N' := NLogN.KFN.sImpl_equiv eqv (fun i => 2 ^ pos' i * S0) Butterfly.Cm N
  have hn : W * (B' * 2 ^ t * S0) = B * 2 ^ t * S0 := by rw [hBB]; ring
  rw [hn] at N'
  have hcount : J.net.countP P8Lift.RStep.isChild = s := J.count
  have hdw : (J.net.map dw).sum ≤ s * (DWk + (Ek + 2) * W) + L * NLogN.KFN.dwloc W A := by
    have := NLogN.KFN.sum_le_count' P8Lift.RStep.isChild _ _ dw J.net (fun a ha => (hP a ha).2.2.1)
    rw [hcount] at this; exact this
  refine ⟨_, _, _, _, N', ?_, hdw, fun w => ?_⟩
  · have := NLogN.KFN.sum_le_count' P8Lift.RStep.isChild _ _ e J.net (fun a ha => (hP a ha).2.1)
    rw [hcount] at this; omega
  -- the cost
  set n' := NLogN.KFN.nR t S0 B'
  set DW' := s * (DWk + (Ek + 2) * W) + L * NLogN.KFN.dwloc W A
  set Wh := DW' + O + Wk
  set bd : P8Lift.RStep (Fin W) m → ℕ → ℝ := fun a v =>
    (if a.isChild then ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + Wk) : ℝ) else 0) +
      G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + O) : ℝ)
  have hXm : ∀ a b, a ≤ b → (NLogN.KFN.Xf r Ψ a : ℝ) ≤ (NLogN.KFN.Xf r Ψ b : ℝ) := fun a b h => by
    exact_mod_cast NLogN.KFN.Xf_mono hΨm h
  have hmono : ∀ a, Monotone (bd a) := by
    intro a u v huv
    simp only [bd]
    have h2 : G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (u + O) : ℝ) ≤
        G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + O) : ℝ) :=
      mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
    split_ifs
    · have h1 : ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (u + Wk) : ℝ) ≤ ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (v + Wk) : ℝ) :=
        mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
      linarith
    · linarith
  have C := NLogN.KFN.costL_le cost dw bd hmono J.net (fun a ha => (hP a ha).2.2.2) w
  set X1 := (NLogN.KFN.Xf r Ψ (w + DW' + Wk) : ℝ)
  set y := G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + DW' + O) : ℝ)
  have hy : 0 ≤ y := by positivity
  have S := NLogN.KFN.sum_ite_le' P8Lift.RStep.isChild (ck * ((n' : ℕ) : ℝ) * X1 + y) y hy
    (fun a => bd a (w + (J.net.map dw).sum)) J.net (fun a ha => by
      simp only [bd]
      have h2 : G' * ((W * n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + (J.net.map dw).sum + O) : ℝ) ≤ y :=
        mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
      split_ifs
      · have h1 : ck * ((n' : ℕ) : ℝ) * (NLogN.KFN.Xf r Ψ (w + (J.net.map dw).sum + Wk) : ℝ) ≤
            ck * ((n' : ℕ) : ℝ) * X1 :=
          mul_le_mul_of_nonneg_left (hXm _ _ (by omega)) (by positivity)
        linarith
      · linarith)
  rw [hcount] at S
  -- assemble
  have hXW1 : (1 : ℝ) ≤ (NLogN.KFN.Xf r Ψ (w + Wh) : ℝ) := by
    have : 1 ≤ NLogN.KFN.Xf r Ψ (w + Wh) := by unfold NLogN.KFN.Xf; have := hZΨ (w + Wh); omega
    exact_mod_cast this
  set XW := (NLogN.KFN.Xf r Ψ (w + Wh) : ℝ)
  have hX1 : X1 ≤ XW := hXm _ _ (by omega)
  have hXO : (NLogN.KFN.Xf r Ψ (w + DW' + O) : ℝ) ≤ XW := hXm _ _ (by omega)
  have hn1 : 1 ≤ n' := NLogN.KFN.one_le_nR hS hB'
  have hWr : (W : ℝ) ≠ 0 := by
    have : (1 : ℝ) ≤ W := by exact_mod_cast hW
    linarith
  have hNW : ((B * 2 ^ t * S0 : ℕ) : ℝ) = (W : ℝ) * (n' : ℝ) := by
    have : B * 2 ^ t * S0 = W * n' := by rw [hBB]; simp only [n', NLogN.KFN.nR]; ring
    rw [this]; push_cast; ring
  have hNWn : ((W * n' : ℕ) : ℝ) = (W : ℝ) * (n' : ℝ) := by push_cast; ring
  have hN1 : (1 : ℝ) ≤ (W : ℝ) * (n' : ℝ) := by
    have : 1 ≤ W * n' := Nat.mul_le_mul hW hn1
    exact_mod_cast this
  rw [hNW]
  have hy' : y ≤ G' * ((W : ℝ) * (n' : ℝ)) * XW := by
    simp only [y]; rw [hNWn]
    exact mul_le_mul_of_nonneg_left hXO (by positivity)
  have hs1 : (s : ℝ) * (ck * (n' : ℝ) * X1) ≤ (s / W : ℝ) * ck * ((W : ℝ) * (n' : ℝ)) * XW := by
    have e : (s / W : ℝ) * ck * ((W : ℝ) * (n' : ℝ)) * XW = (s : ℝ) * (ck * (n' : ℝ) * XW) := by
      field_simp
    rw [e]
    apply mul_le_mul_of_nonneg_left _ (by positivity)
    exact mul_le_mul_of_nonneg_left hX1 (by positivity)
  have h1W : (1 : ℝ) ≤ ((W : ℝ) * (n' : ℝ)) * XW := by nlinarith
  have hL : ((L : ℕ) : ℝ) * y ≤ ((L : ℕ) : ℝ) * (G' * ((W : ℝ) * (n' : ℝ)) * XW) :=
    mul_le_mul_of_nonneg_left hy' (by positivity)
  have hS' : (s : ℝ) * y ≤ (s : ℝ) * (G' * ((W : ℝ) * (n' : ℝ)) * XW) :=
    mul_le_mul_of_nonneg_left hy' (by positivity)
  calc (NLogN.KFN.costL cost dw J.net w : ℝ)
      ≤ (J.net.map fun a => bd a (w + (J.net.map dw).sum)).sum + 1 := C
    _ ≤ (s : ℝ) * (ck * ((n' : ℕ) : ℝ) * X1 + y) + (L : ℝ) * y + 1 := by linarith
    _ ≤ ((s / W : ℝ) * ck + ((s + L : ℕ) : ℝ) * G' + 1) * ((W : ℝ) * (n' : ℝ)) * XW := by
      push_cast
      nlinarith
end
