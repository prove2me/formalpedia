    have hNv : n.eval s = N := by omega
    have hG := NLogN.RS.repSt_G i n b s hw
    have hloop := IRuns.loop (I := I) (iprog := iprog) (i := i) (f := fun c => c != .zero)
      (p := .seq b.code (.seq ((decE i).code zX) (.seq (.op (.drop i)) (.op (.mv zX.V i)))))
