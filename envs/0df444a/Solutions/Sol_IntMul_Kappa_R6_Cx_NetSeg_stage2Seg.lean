-- Source module: Solutions.R6CxNetFast
/-!
# A kernel-fast form of `progChk` (moves only)

`progK` runs the moves of a spec list in continuation-passing style, with recursor-based tree
access written in raw `Nat` primitives and forced accumulators (kernel evaluation is
call-by-name). The op condition of `chunkOK` is not evaluated: it follows from `OpsIn` (every op
wire is one of the spec's wires, hence at `V` after the moves).

`progK_sound`: a passing `progK` gives a passing `progChk`, and the continuation holds at the
final state with the accumulated packed histogram and move count.
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Cx.NetFast

noncomputable section

open NetBT NetLoc

lemma getR_eq : ∀ (t : BT) (p j : ℕ), getR t p j = t.get p j
  | .leaf v, p, j => rfl
  | .node l r, p, j => by
    show cond _ (getR l _ j) (getR r _ j) = _
    rw [getR_eq l, getR_eq r]; rfl

lemma setR_eq : ∀ (t : BT) (p j x : ℕ), setR t p j x = t.set p j x
  | .leaf v, p, j, x => rfl
  | .node l r, p, j, x => by
    show cond _ (BT.node (setR l _ j x) r) (BT.node l (setR r _ j x)) = _
    rw [setR_eq l, setR_eq r]; rfl

lemma ggR_eq (t : BT) (i : ℕ) : ggR t i = gget t i := getR_eq _ _ _
lemma gsR_eq (t : BT) (i x : ℕ) : gsR t i x = gset t i x := setR_eq _ _ _ _

lemma beqR_eq : ∀ a b : BT, beqR a b = BT.beq a b
  | .leaf a, .leaf b => rfl
  | .leaf _, .node _ _ => rfl
  | .node _ _, .leaf _ => rfl
  | .node l r, .node l' r' => by
    show (beqR l l' && beqR r r') = _
    rw [beqR_eq l l', beqR_eq r r']; rfl

lemma finK_spec {H C : ℕ} {S t : BT} {h c : ℕ} (hk : finK H C S t h c = true) : h = H ∧ c = C ∧ t = S := by
  simp only [finK, Bool.and_eq_true, Nat.beq_eq, beqR_eq] at hk
  exact ⟨hk.1.1, hk.1.2, BT.eq_of_beq _ _ hk.2⟩

lemma mvK_cons (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) (V : ℕ) (k : BT → ℕ → ℕ → Bool)
    (w : ℕ) (ws : List ℕ) (t : BT) (h c : ℕ) :
    mvK nl mvOK wd V k (w :: ws) t h c =
      cond (Nat.blt w nl) (cond (Nat.beq (gget t w) V) (mvK nl mvOK wd V k ws t h c)
        (cond (mvOK w (gget t w) V)
          (mvK nl mvOK wd V k ws (gset t w V) (HB ^ wd w (gget t w) V + h) (c + 1)) false)) false := by
  have e : mvK nl mvOK wd V k (w :: ws) t h c =
      cond (Nat.blt w nl) (cond (Nat.beq (ggR t w) V) (mvK nl mvOK wd V k ws t h c)
        (cond (mvOK w (ggR t w) V)
          (force (Nat.add (Nat.pow HB (wd w (ggR t w) V)) h)
            (force (Nat.succ c) (mvK nl mvOK wd V k ws (gsR t w V) (Nat.add (Nat.pow HB (wd w (ggR t w) V)) h)
              (Nat.succ c)))) false)) false := rfl
  rw [e]
  simp only [force_eq, ggR_eq, gsR_eq]
  rfl

theorem mvK_sound (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) (V : ℕ) (k : BT → ℕ → ℕ → Bool) :
    ∀ (ws : List ℕ) (t : BT) (h c : ℕ), mvK nl mvOK wd V k ws t h c = true →
      (∀ w ∈ ws, w < nl) ∧ ((mvRun V ws t).1.all fun p => mvOK p.1 p.2 V) = true ∧
      k (mvRun V ws t).2 (h + hsum wd V (mvRun V ws t).1) (c + (mvRun V ws t).1.length) = true
  | [], t, h, c, hk => ⟨by simp, rfl, by have hk' : k t h c = true := hk; simpa [mvRun, hsum] using hk'⟩
  | w :: ws, t, h, c, hk => by
    rw [mvK_cons] at hk
    cases hw : Nat.blt w nl
    · rw [hw] at hk; simp at hk
    rw [hw, cond_true] at hk
    have hw' : w < nl := Nat.le_of_ble_eq_true hw
    simp only [mvRun]
    cases hb : Nat.beq (gget t w) V
    · rw [hb, cond_false] at hk
      cases hm : mvOK w (gget t w) V
      · rw [hm] at hk; simp at hk
      rw [hm, cond_true] at hk
      obtain ⟨k1, k2, k3⟩ := mvK_sound nl mvOK wd V k ws _ _ _ hk
      refine ⟨?_, ?_, ?_⟩
      · intro x hx; rcases List.mem_cons.1 hx with rfl | hx; exacts [hw', k1 x hx]
      · simp only [cond_false, List.all_cons, hm, Bool.true_and]; exact k2
      · simp only [cond_false, hsum, List.length_cons]
        convert k3 using 2 <;> ring
    · rw [hb, cond_true] at hk
      obtain ⟨k1, k2, k3⟩ := mvK_sound nl mvOK wd V k ws _ _ _ hk
      refine ⟨?_, ?_, ?_⟩
      · intro x hx; rcases List.mem_cons.1 hx with rfl | hx; exacts [hw', k1 x hx]
      · simpa only [cond_true] using k2
      · simpa only [cond_true] using k3

lemma progK_cons (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) (k : BT → ℕ → ℕ → Bool)
    (s : Spec) (ss : List Spec) (t : BT) (h c : ℕ) :
    progK nl mvOK wd k (s :: ss) t h c =
      cond (Nat.blt s.V SM && !(Nat.beq (s.V % 4) 3)) (mvK nl mvOK wd s.V (progK nl mvOK wd k ss) s.ws t h c)
        false := rfl

/-- **Soundness of the fast check.** -/
theorem progK_sound (nl : ℕ) (mvOK : ℕ → ℕ → ℕ → Bool) (wd : ℕ → ℕ → ℕ → ℕ) (k : BT → ℕ → ℕ → Bool)
    (hnl : nl ≤ CAP) :
    ∀ (ss : List Spec) (t : BT) (h c : ℕ), t.wf 8 = true → (∀ s ∈ ss, OpsIn s) →
      progK nl mvOK wd k ss t h c = true →
      (progChk nl mvOK wd ss t).1 = true ∧
      k (progRun ss t).2 (h + (progChk nl mvOK wd ss t).2.1) (c + (progChk nl mvOK wd ss t).2.2.1) = true
  | [], t, h, c, _, _, hk => ⟨rfl, by have hk' : k t h c = true := hk; simpa [progChk, progRun] using hk'⟩
  | s :: ss, t, h, c, hwf, hops, hk => by
    rw [progK_cons] at hk
    cases hV : (Nat.blt s.V SM && !(Nat.beq (s.V % 4) 3))
    · rw [hV] at hk; simp at hk
    rw [hV, cond_true] at hk
    simp only [Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hV
    obtain ⟨m1, m2, m3⟩ := mvK_sound nl mvOK wd s.V _ s.ws t h c hk
    have hwf' := mvRun_wf s.V s.ws t hwf
    obtain ⟨p1, p2⟩ := progK_sound nl mvOK wd k hnl ss _ _ _ hwf'
      (fun s' hs' => hops s' (List.mem_cons_of_mem _ hs')) m3
    have hget : ∀ x ∈ s.ws, gget (mvRun s.V s.ws t).2 x = s.V := fun x hx => by
      rw [mvRun_get s.V hV.1 s.ws t hwf (fun w hw => lt_of_lt_of_le (m1 w hw) hnl) x
        (lt_of_lt_of_le (m1 x hx) hnl), if_pos hx]
    have hc : chunkOK nl mvOK s (mvRun s.V s.ws t).1 (mvRun s.V s.ws t).2 = true := by
      simp only [chunkOK, Bool.and_eq_true, Nat.blt_eq, List.all_eq_true, Bool.not_eq_true',
        Nat.beq_eq]
      refine ⟨⟨⟨⟨hV.1, hV.2⟩, m1⟩, by simpa [List.all_eq_true] using m2⟩, fun o ho => ?_⟩
      obtain ⟨hd, hs⟩ := hops s List.mem_cons_self o ho
      exact ⟨⟨⟨m1 _ hd, m1 _ hs⟩, hget _ hd⟩, hget _ hs⟩
    refine ⟨by simp only [progChk, hc, p1, Bool.true_and], ?_⟩
    simp only [progChk, progRun]
    convert p2 using 2 <;> ring

end

end IntMul.Kappa.R6.Cx.NetFast

