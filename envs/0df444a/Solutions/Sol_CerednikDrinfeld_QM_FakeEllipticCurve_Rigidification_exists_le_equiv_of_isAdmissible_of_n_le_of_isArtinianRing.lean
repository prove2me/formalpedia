theorem nilEval_mem {B : Type} [CommRing B] {g : ℕ} (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (m : ℕ)
    (φ : MvPowerSeries (Fin g) B) (hφ : φ.constantCoeff = 0) (s : Fin g → B') (hs : ∀ i, s i ∈ J) :
    MvFormalGroup.nilEval m φ s ∈ J := by
  classical
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  unfold MvFormalGroup.nilEval
  have hs0 : (fun i => (Ideal.Quotient.mkₐ B J) (s i)) = 0 := by
    funext i
    exact (Ideal.Quotient.eq_zero_iff_mem).mpr (hs i)
  have e1 : (Ideal.Quotient.mkₐ B J)
      (MvPolynomial.aeval s (MvPowerSeries.trunc' B (Finsupp.equivFunOnFinite.symm fun _ => m) φ)) =
      MvPolynomial.aeval (fun i => (Ideal.Quotient.mkₐ B J) (s i))
        (MvPowerSeries.trunc' B (Finsupp.equivFunOnFinite.symm fun _ => m) φ) := by
    rw [← MvPolynomial.comp_aeval, AlgHom.comp_apply]
  change (Ideal.Quotient.mkₐ B J) _ = 0
  rw [e1, hs0, MvPolynomial.aeval_zero]
  have : MvPolynomial.constantCoeff (MvPowerSeries.trunc' B (Finsupp.equivFunOnFinite.symm fun _ => m) φ) = 0 := by
    change MvPolynomial.coeff 0 _ = 0
    rw [MvPowerSeries.coeff_trunc', if_pos (show (0 : Fin g →₀ ℕ) ≤ _ from bot_le), MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
    exact hφ
  rw [this, map_zero]

theorem eq_of_forall_nilEval_eq {B : Type} [CommRing B] {g : ℕ} (φ ψ : MvPowerSeries (Fin g) B)
    (hφψ : ∀ (B' : Type) [CommRing B'] [Algebra B B'] (J : Ideal B') (m : ℕ), J ^ (m + 1) = ⊥ →
      ∀ s : Fin g → B', (∀ i, s i ∈ J) → MvFormalGroup.nilEval m φ s = MvFormalGroup.nilEval m ψ s) : φ = ψ := by
  classical
  ext e
  set m : ℕ := e.degree with hm
  let I : Ideal (MvPolynomial (Fin g) B) := MvPolynomial.idealOfVars (Fin g) B ^ (m + 1)
  have hJ : (Ideal.map (Ideal.Quotient.mk I) (MvPolynomial.idealOfVars (Fin g) B)) ^ (m + 1) = ⊥ := by
    rw [← Ideal.map_pow, Ideal.map_quotient_self]
  have hs : ∀ i : Fin g, Ideal.Quotient.mk I (MvPolynomial.X i) ∈
      Ideal.map (Ideal.Quotient.mk I) (MvPolynomial.idealOfVars (Fin g) B) :=
    fun i => Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
  have key := hφψ (MvPolynomial (Fin g) B ⧸ I) _ m hJ (fun i => Ideal.Quotient.mk I (MvPolynomial.X i)) hs
  have hev : ∀ p : MvPolynomial (Fin g) B,
      MvPolynomial.aeval (fun i => Ideal.Quotient.mk I (MvPolynomial.X i)) p = Ideal.Quotient.mk I p := by
    intro p
    have : MvPolynomial.aeval (R := B) (fun i => Ideal.Quotient.mk I (MvPolynomial.X i)) =
        Ideal.Quotient.mkₐ B I := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X]
      rfl
    exact congrArg (fun F => F p) this
  unfold MvFormalGroup.nilEval at key
  rw [hev, hev, Ideal.Quotient.eq, MvPolynomial.mem_pow_idealOfVars_iff'] at key
  have hdeg : e.degree < m + 1 := by omega
  have := key e hdeg
  rw [MvPolynomial.coeff_sub, sub_eq_zero, MvPowerSeries.coeff_trunc', MvPowerSeries.coeff_trunc'] at this
  have hle : e ≤ Finsupp.equivFunOnFinite.symm (fun _ : Fin g => m) := by
    rw [Finsupp.le_def]
    intro i
    rw [Finsupp.coe_equivFunOnFinite_symm]
    exact (Finsupp.le_degree i e).trans (le_of_eq hm.symm)
  simpa [hle] using this

theorem exists_germ_dual
    {r N : ℕ} [Fact r.Prime]
    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ1 : (1 : ℍ[ℚ, a, b]) ∈ Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)
    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))
    (X₀ : FormalODModule r (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π})) (θ₀ : RelativeGroupLaw.FormalCoordinates A₀.f 2)
    (hA₀ : A₀.IsFormalModuleVia coord X₀ θ₀)
    (S : Type) [CommRing S] [IsNoetherianRing S] [Algebra 𝒪 S] (hBr : IsNilpotent ((r : ℕ) : S)) (ψS : Onr →ₐ[𝒪] S)
    (x : FakeEllipticCurve.RigidifiedCurve r π A₀ S ψS)
    (X : FormalODModule r S) (θ : RelativeGroupLaw.FormalCoordinates x.1.f 2) (hXθ : x.1.IsFormalModuleVia coord X θ)
    (σ : Series (S ⧸ Ideal.span {algebraMap 𝒪 S π})) (hσ0 : ∀ i, MvPowerSeries.constantCoeff (σ i) = 0)
    (hrep : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] [Algebra S B'']
        [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B''],
        algebraMap S B'' = (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (Ideal.Quotient.mk _) →
        algebraMap (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'' =
          (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) →
        ∀ (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
          ∀ PA : Spec (CommRingCat.of B'') ⟶ x.2.Ab.A,
            PA ≫ x.2.Ab.f = Spec.map (CommRingCat.ofHom (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'')) →
            PA ≫ x.2.gA = (θ₀ B'' s).1 →
              PA ≫ x.2.φ' ≫ x.2.gb = (θ B'' (fun i => MvFormalGroup.nilEval m (σ i) s)).1) :
    ∃ τ : Series (S ⧸ Ideal.span {algebraMap 𝒪 S π}),
      FormalODModule.IsODHom (X.map (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π})))
        (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS)) τ ∧
      τ.comp σ = (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS)).act ((r : Zp2 r) ^ x.2.d) ∧
      σ.comp τ = (X.map (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π}))).act ((r : Zp2 r) ^ x.2.d) := by
  classical
  letI instOL : Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) :=
    (FakeEllipticCurve.Rigidification.residueLeg π ψS).toAlgebra
  obtain ⟨θA, hθA, hθAg⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord
      (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) A₀ x.2.Ab x.2.gA x.2.isPullback_Ab X₀ θ₀ hA₀
  obtain ⟨θE, hθE, hθEg⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.IsPullbackVia.exists_isFormalModuleVia_map_and_comp_eq coord
      S (S ⧸ Ideal.span {algebraMap 𝒪 S π}) x.1 x.2.Eb x.2.gb x.2.isPullback_Eb X θ hXθ
  have hLr : IsNilpotent ((r : ℕ) : (S ⧸ Ideal.span {algebraMap 𝒪 S π})) := by
    simpa using hBr.map (Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 S π}))
  obtain ⟨hφ, hφ', mulφ, mulφ', actφ, actφ', compφ⟩ := x.2.isIsogenyPair
  have hrd : (((r ^ x.2.d : ℕ) : ℚ) : ℍ[ℚ, a, b]) ∈ Λ := by exact_mod_cast hΛℤ ((r ^ x.2.d : ℕ) : ℤ)

  obtain ⟨qhat, hqOD, hqrep⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isODHom_forall_comp_eq_apply_nilEval_of_isFormalModuleVia coord hcoord hLr
      x.2.Ab x.2.Eb x.2.φ' hφ' mulφ' actφ' _ θA hθA _ θE hθE
  have hqrep' : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] [Algebra S B'']
      [Algebra (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B''],
      algebraMap S B'' = (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (Ideal.Quotient.mk _) →
      algebraMap (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) B'' =
        (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'').comp (FakeEllipticCurve.Rigidification.residueLeg π ψS) →
      ∀ (J : Ideal B'') (m : ℕ), J ^ (m + 1) = ⊥ → ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        ∀ PA : Spec (CommRingCat.of B'') ⟶ x.2.Ab.A,
          PA ≫ x.2.Ab.f = Spec.map (CommRingCat.ofHom (algebraMap (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'')) →
          PA ≫ x.2.gA = (θ₀ B'' s).1 →
            PA ≫ x.2.φ' ≫ x.2.gb = (θ B'' (fun i => MvFormalGroup.nilEval m (qhat i) s)).1 := by
    intro B'' _ _ _ _ h1 h2 J m hJ s hs PA hPAf hPAg
    haveI : IsScalarTower S (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'' := IsScalarTower.of_algebraMap_eq (fun y => by rw [h1]; rfl)
    haveI : IsScalarTower (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}) (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B'' :=
      IsScalarTower.of_algebraMap_eq (fun y => by rw [h2]; rfl)
    have hsn : ∀ i, IsNilpotent (s i) := fun i => ⟨m + 1, by
      have h := Ideal.pow_mem_pow (hs i) (m + 1)
      rwa [hJ, Ideal.mem_bot] at h⟩
    have hPA : PA = (θA B'' s).1 := by
      apply x.2.isPullback_Ab.1.hom_ext
      · rw [hPAg, hθAg B'' s hsn]
      · rw [hPAf]; exact (θA B'' s).2.symm
    have hqn : ∀ i, IsNilpotent (MvFormalGroup.nilEval m (qhat i) s) := fun i =>
      ⟨m + 1, by
        have hmem := (MvFormalGroup.nilEval_subst_of_mem J m hJ s hs qhat hqOD.constantCoeff (MvPowerSeries.X 0)).1 i
        have h := Ideal.pow_mem_pow hmem (m + 1)
        rwa [hJ, Ideal.mem_bot] at h⟩
    rw [hPA, ← Category.assoc, hqrep B'' J m hJ s hs, hθEg B'' _ hqn]
  have hσq : σ = qhat :=
    CerednikDrinfeld.QM.FakeEllipticCurve.Rigidification.eq_of_represents_of_represents_of_constantCoeff_eq_zero
      𝒪 π Onr Λ coord A₀ θ₀ S ψS x.1 x.2 X θ hXθ σ qhat hσ0 hqOD.constantCoeff hrep hqrep'
  have hσrep : ∀ (B'' : Type) [CommRing B''] [Algebra (S ⧸ Ideal.span {algebraMap 𝒪 S π}) B''] (J : Ideal B'') (n : ℕ), J ^ (n + 1) = ⊥ →
      ∀ s : Fin 2 → B'', (∀ i, s i ∈ J) →
        (θA B'' s).1 ≫ x.2.φ' = (θE B'' (fun i => MvFormalGroup.nilEval n (σ i) s)).1 := by
    rw [hσq]; exact hqrep
  have hσOD : FormalODModule.IsODHom (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS))
      (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))) σ := by rw [hσq]; exact hqOD

  obtain ⟨τ, hτOD, hτrep⟩ :=
    CerednikDrinfeld.QM.FakeEllipticCurve.exists_isODHom_forall_comp_eq_apply_nilEval_of_isFormalModuleVia coord hcoord hLr
      x.2.Eb x.2.Ab x.2.φ hφ mulφ actφ _ θE hθE _ θA hθA

  have hcastA : (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS)).act ((r : Zp2 r) ^ x.2.d) =
      (((r ^ x.2.d : ℕ) : MvFormalGroup.End (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS)).F)).toPowerSeries := by
    rw [← Nat.cast_pow, FormalODModule.act_natCast, MvFormalGroup.End.toPowerSeries_natCast]
  have hcastE : (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))).act ((r : Zp2 r) ^ x.2.d) =
      (((r ^ x.2.d : ℕ) : MvFormalGroup.End (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))).F)).toPowerSeries := by
    rw [← Nat.cast_pow, FormalODModule.act_natCast, MvFormalGroup.End.toPowerSeries_natCast]
  refine ⟨τ, hτOD, ?_, ?_⟩
  ·
    rw [hcastA]
    funext i
    apply eq_of_forall_nilEval_eq
    intro B' _ _ J m hJ s hs
    obtain ⟨-, hinj, -, -⟩ := hθA.1.2 B' J m hJ
    have hmemL : ∀ i, MvFormalGroup.nilEval m ((τ.comp σ) i) s ∈ J := fun i =>
      nilEval_mem B' J m _ (Series.constantCoeff_comp hτOD.constantCoeff hσ0 i) s hs
    have hmemR : ∀ i, MvFormalGroup.nilEval m
        ((((r ^ x.2.d : ℕ) : MvFormalGroup.End (X₀.map (FakeEllipticCurve.Rigidification.residueLeg π ψS)).F)).toPowerSeries i) s ∈ J :=
      fun i => nilEval_mem B' J m _ (MvFormalGroup.Hom.constantCoeff_eq_zero _ i) s hs
    have key := hinj _ _ hmemL hmemR (by
      apply Subtype.ext
      rw [CerednikDrinfeld.QM.FakeEllipticCurve.apply_nilEval_natCast_eq_mapPt_act_of_isFormalModuleVia x.2.Ab coord hcoord _ θA hθA
        hΛ1 (r ^ x.2.d) hrd B' J m hJ s hs, mapPt_coe, ← (compφ hrd).2, ← Category.assoc, hσrep B' J m hJ s hs,
        hτrep B' J m hJ _ (fun j => nilEval_mem B' J m _ (hσ0 j) s hs)]
      exact congrArg Subtype.val (congrArg (θA B') (funext fun j => (MvFormalGroup.nilEval_subst_of_mem J m hJ s hs σ hσ0 (τ j)).2)))
    exact congrFun key i
  ·
    change σ.comp τ = (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))).act ((r : Zp2 r) ^ x.2.d)
    rw [hcastE]
    funext i
    apply eq_of_forall_nilEval_eq
    intro B' _ _ J m hJ s hs
    obtain ⟨-, hinj, -, -⟩ := hθE.1.2 B' J m hJ
    have hmemL : ∀ i, MvFormalGroup.nilEval m ((σ.comp τ) i) s ∈ J := fun i =>
      nilEval_mem B' J m _ (Series.constantCoeff_comp hσ0 hτOD.constantCoeff i) s hs
    have hmemR : ∀ i, MvFormalGroup.nilEval m
        ((((r ^ x.2.d : ℕ) : MvFormalGroup.End (X.map (algebraMap S (S ⧸ Ideal.span {algebraMap 𝒪 S π}))).F)).toPowerSeries i) s ∈ J :=
      fun i => nilEval_mem B' J m _ (MvFormalGroup.Hom.constantCoeff_eq_zero _ i) s hs
    have key := hinj _ _ hmemL hmemR (by
      apply Subtype.ext
      rw [CerednikDrinfeld.QM.FakeEllipticCurve.apply_nilEval_natCast_eq_mapPt_act_of_isFormalModuleVia x.2.Eb coord hcoord _ θE hθE
        hΛ1 (r ^ x.2.d) hrd B' J m hJ s hs, mapPt_coe, ← (compφ hrd).1, ← Category.assoc, hτrep B' J m hJ s hs,
        hσrep B' J m hJ _ (fun j => nilEval_mem B' J m _ (hτOD.constantCoeff j) s hs)]
      exact congrArg Subtype.val (congrArg (θE B') (funext fun j => (MvFormalGroup.nilEval_subst_of_mem J m hJ s hs τ hτOD.constantCoeff (σ j)).2)))
    exact congrFun key i

