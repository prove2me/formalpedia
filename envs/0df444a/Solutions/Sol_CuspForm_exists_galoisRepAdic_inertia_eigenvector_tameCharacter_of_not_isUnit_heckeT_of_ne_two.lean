variable {A : Type*} [CommRing A] {G : Type*} [Monoid G]
  (X : Type*) [AddCommGroup X] [Module A X]

private def levelFactor {I J : Ideal A} (h : J ≤ I) :
    (X ⧸ (J • (⊤ : Submodule A X))) →ₗ[A] (X ⧸ (I • (⊤ : Submodule A X))) :=
