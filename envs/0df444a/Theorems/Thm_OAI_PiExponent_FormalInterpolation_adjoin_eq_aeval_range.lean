-- title:
--   Adjoin elements are polynomial evaluations
-- statement:
--   Every element of the subalgebra generated by the entries of `g` is the evaluation at `g` of a multivariate polynomial over `Complex`. This follows by identifying the evaluation map’s range as a subalgebra containing the constants and generators, then using the minimality of the adjoin.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Definitions.Def_OAI_PiExponent_WeightedIdealCurveCriterion
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open OAI.PiExponent.FormalInterpolation

theorem OAI.PiExponent.FormalInterpolation.adjoin_eq_aeval_range
    {d m : Nat} (g : Fin m → MvPolynomial (Fin d) Complex)
    (c : Algebra.adjoin Complex (Set.range g)) :
    ∃ F : MvPolynomial (Fin m) Complex,
      MvPolynomial.aeval g F = (c : MvPolynomial (Fin d) Complex) := by sorry
