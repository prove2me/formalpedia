section
-- Source module: Solutions.R6ChkBitDim
/-!
# Bit round six (h = 23): soundness of the node-dimension checker

`spanS sup = span_ℚ {𝟙_{tri i} : sup.testBit i}` (`𝟙_{tri i} ∈ ℚ^23` the indicator vector of the
`i`-th triple). `recChk_sound`: if `recChk sup R = true` then `finrank ℚ (spanS sup) = d`
(the record's claimed dimension); `dimChk_sound` lifts this to a whole element.
-/

set_option maxRecDepth 100000
set_option exponentiation.threshold 2000

namespace R6Chk.Bit

open R6Chk Matrix Module

/-! ## Independence over `ℚ` from a dual family modulo `q` -/

theorem linIndep_of_modDual {d n q : ℕ} (hq : (1 : ZMod q) ≠ 0) (v y : Fin d → Fin n → ℤ)
    (h : ∀ a b, ((v a ⬝ᵥ y b : ℤ) : ZMod q) = if a = b then 1 else 0) :
    LinearIndependent ℚ (fun a => fun p => (v a p : ℚ)) := by
  let M : Matrix (Fin d) (Fin d) ℤ := Matrix.of fun a b => v a ⬝ᵥ y b
  have hM : (Int.castRingHom (ZMod q)).mapMatrix M = 1 := by
    ext a b
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, M, Matrix.of_apply, eq_intCast, h,
      Matrix.one_apply]
  have hdet : M.det ≠ 0 := by
    intro h0
    have := RingHom.map_det (Int.castRingHom (ZMod q)) M
    rw [h0, hM, det_one, map_zero] at this
    exact hq this.symm
  have hdetQ : ((Int.castRingHom ℚ).mapMatrix M).det ≠ 0 := by
    rw [← RingHom.map_det, eq_intCast]
    exact_mod_cast hdet
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hv : g ᵥ* ((Int.castRingHom ℚ).mapMatrix M) = 0 := by
    funext b
    have := congrArg (fun z => z ⬝ᵥ (fun p => (y b p : ℚ))) hg
    simp only [zero_dotProduct] at this
    rw [Pi.zero_apply, ← this]
    simp only [vecMul, dotProduct, RingHom.mapMatrix_apply, Matrix.map_apply, M, Matrix.of_apply,
      eq_intCast, Int.cast_sum, Int.cast_mul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
      Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun p _ => ?_
    ring
  exact congrFun (eq_zero_of_vecMul_eq_zero hdetQ hv)

/-! ## Bit helpers -/

theorem nlor' (x y : ℕ) : Nat.lor x y = x ||| y := rfl

theorem mem_F {m : ℕ} {p : Fin 23} : p ∈ F m ↔ m.testBit p = true := by simp [F]

/-! ## Table facts -/

theorem umq_spec (j r i : ℕ) : ∀ n, (umq j r n).testBit i = true ↔
    ∃ t < n, r.testBit t = true ∧ (star (6 * j + t)).testBit i = true
  | 0 => by simp [umq]
  | n + 1 => by
    show (Nat.lor (umq j r n) (cond (tb r n) (star (Nat.add (Nat.mul 6 j) n)) 0)).testBit i = true ↔ _
    rw [nlor', Nat.testBit_lor, Bool.or_eq_true, umq_spec j r i n, tb_eq, nadd, nmul]
    constructor
    · rintro (⟨t, ht, h1, h2⟩ | h)
      · exact ⟨t, by omega, h1, h2⟩
      · cases hr : r.testBit n
        · rw [hr] at h; simp at h
        · rw [hr] at h; exact ⟨n, by omega, hr, h⟩
    · rintro ⟨t, ht, h1, h2⟩
      rcases Nat.lt_succ_iff_lt_or_eq.1 ht with ht | rfl
      · exact Or.inl ⟨t, ht, h1, h2⟩
      · right; rw [h1]; exact h2

theorem chunk_lt (P j : ℕ) : Nat.land (Nat.shiftRight P (6 * j)) 63 < 64 := by
  rw [nland]; exact Nat.and_lt_two_pow (n := 6) _ (by norm_num)

theorem chunk_bit (P j t : ℕ) (ht : t < 6) :
    (Nat.land (Nat.shiftRight P (6 * j)) 63).testBit t = P.testBit (6 * j + t) := by
  rw [nland, nshr, Nat.testBit_and, Nat.testBit_shiftRight,
    show (63 : ℕ) = 2 ^ 6 - 1 by norm_num, Nat.testBit_two_pow_sub_one]
  simp [ht]

theorem fld_P {U j P o : ℕ} (hU : allN 64 (fun r => Nat.beq (fieldOf U 1792 r) (umq j r 6)) = true)
    (ho : o = 6 * j) (i : ℕ) :
    (fieldOf U 1792 (Nat.land (Nat.shiftRight P o) 63)).testBit i = true ↔
      ∃ t < 6, P.testBit (o + t) = true ∧ (star (o + t)).testBit i = true := by
  subst ho
  have := allN_spec hU _ (chunk_lt P j)
  rw [Nat.beq_eq] at this
  rw [this, umq_spec]
  refine exists_congr fun t => ⟨fun ⟨ht, h1, h2⟩ => ⟨ht, (chunk_bit P j t ht) ▸ h1, h2⟩,
    fun ⟨ht, h1, h2⟩ => ⟨ht, (chunk_bit P j t ht).symm ▸ h1, h2⟩⟩

/-- **Semantics of `um`**: triples meeting `P`. -/
theorem um_spec {P : ℕ} (hP : P < 2 ^ 23) (i : ℕ) :
    (um P).testBit i = true ↔ ∃ p < 23, P.testBit p = true ∧ (star p).testBit i = true := by
  have e0 := fld_P (P := P) (o := 0) umt0_eq rfl i
  have e1 := fld_P (P := P) (o := 6) umt1_eq rfl i
  have e2 := fld_P (P := P) (o := 12) umt2_eq rfl i
  have e3 := fld_P (P := P) (o := 18) umt3_eq rfl i
  have hu : um P = Nat.lor (Nat.lor (fieldOf UMT0 1792 (Nat.land (Nat.shiftRight P 0) 63))
      (fieldOf UMT1 1792 (Nat.land (Nat.shiftRight P 6) 63)))
      (Nat.lor (fieldOf UMT2 1792 (Nat.land (Nat.shiftRight P 12) 63))
        (fieldOf UMT3 1792 (Nat.land (Nat.shiftRight P 18) 63))) := rfl
  rw [hu, nlor', nlor', nlor', Nat.testBit_lor, Nat.testBit_lor, Nat.testBit_lor]
  simp only [Bool.or_eq_true]
  rw [e0, e1, e2, e3]
  constructor
  · rintro ((⟨t, ht, h1, h2⟩ | ⟨t, ht, h1, h2⟩) | (⟨t, ht, h1, h2⟩ | ⟨t, ht, h1, h2⟩))
    · exact ⟨0 + t, by omega, h1, h2⟩
    · exact ⟨6 + t, by omega, h1, h2⟩
    · exact ⟨12 + t, by omega, h1, h2⟩
    · by_cases ht' : 18 + t < 23
      · exact ⟨18 + t, ht', h1, h2⟩
      · exfalso
        rw [Nat.testBit_lt_two_pow (lt_of_lt_of_le hP (Nat.pow_le_pow_right (by norm_num) (by omega)))] at h1
        exact Bool.false_ne_true h1
  · rintro ⟨p, hp, h1, h2⟩
    by_cases a : p < 6
    · refine Or.inl (Or.inl ⟨p, a, ?_, ?_⟩) <;> rw [show 0 + p = p by omega] <;> assumption
    by_cases b : p < 12
    · refine Or.inl (Or.inr ⟨p - 6, by omega, ?_, ?_⟩) <;> rw [show 6 + (p - 6) = p by omega] <;> assumption
    by_cases c : p < 18
    · refine Or.inr (Or.inl ⟨p - 12, by omega, ?_, ?_⟩) <;> rw [show 12 + (p - 12) = p by omega] <;> assumption
    · refine Or.inr (Or.inr ⟨p - 18, by omega, ?_, ?_⟩) <;> rw [show 18 + (p - 18) = p by omega] <;> assumption

/-! ## Mask semantics -/

theorem star_bit {c i : ℕ} (hc : c < 23) (h : (star c).testBit i = true) : i < 1771 ∧ (tri i).testBit c = true := by
  by_cases hi : i < 1792
  · rw [star_spec hc hi] at h
    simpa using h
  · have hl : star c < 2 ^ i :=
      lt_of_lt_of_le (fieldOf_lt STARL 1792 c) (Nat.pow_le_pow_right (by norm_num) (by omega))
    rw [Nat.testBit_lt_two_pow hl] at h
    exact absurd h Bool.false_ne_true

theorem star_of_tri {c i : ℕ} (hc : c < 23) (hi : i < 1771) (h : (tri i).testBit c = true) : (star c).testBit i = true := by
  rw [star_spec hc (by omega)]; simp [hi, h]

theorem PF_eq : PF = 2 ^ 23 - 1 := rfl

theorem pc_bit {m p : ℕ} (hp : p < 23) : (pc m).testBit p = !m.testBit p := by
  rw [pc, nxor, Nat.testBit_xor, PF_eq, Nat.testBit_two_pow_sub_one]; simp [hp]

theorem pc_lt (m : ℕ) (hm : m < 2 ^ 23) : pc m < 2 ^ 23 := by
  rw [pc, nxor]; exact Nat.xor_lt_two_pow hm (by rw [PF_eq]; omega)

theorem tnot_bit {m i : ℕ} (hi : i < 1792) : (tnot m).testBit i = !m.testBit i := by
  rw [tnot, nxor, Nat.testBit_xor, TF, nsub, nshl, Nat.one_shiftLeft, Nat.testBit_two_pow_sub_one]; simp [hi]

/-- `¬ um (pc S)` at a triple `i`: every point of the triple is in `S`. -/
theorem not_um_pc {S i : ℕ} (hS : S < 2 ^ 23) (hi : i < 1771) (h : (um (pc S)).testBit i = false) :
    ∀ p < 23, (tri i).testBit p = true → S.testBit p = true := by
  intro p hp ht
  by_contra hs
  have : (um (pc S)).testBit i = true :=
    (um_spec (pc_lt S hS) i).2 ⟨p, hp, by rw [pc_bit hp]; simpa using hs, star_of_tri hp hi ht⟩
  rw [h] at this; exact Bool.false_ne_true this

theorem um_bit {P i : ℕ} (hP : P < 2 ^ 23) (h : (um P).testBit i = true) :
    ∃ p < 23, P.testBit p = true ∧ (tri i).testBit p = true := by
  obtain ⟨p, hp, h1, h2⟩ := (um_spec hP i).1 h
  exact ⟨p, hp, h1, (star_bit hp h2).2⟩

theorem lt23_or {a b : ℕ} (ha : a < 2 ^ 23) (hb : b < 2 ^ 23) : a ||| b < 2 ^ 23 := Nat.or_lt_two_pow ha hb

theorem bit_lt23 {c : ℕ} (hc : c < 23) : 1 <<< c < 2 ^ 23 := by
  rw [Nat.one_shiftLeft]; exact Nat.pow_lt_pow_right (by norm_num) hc

theorem compMask_sound {c i : ℕ} {e : ℕ × ℕ × ℕ} (hc : c < 23) (hX : e.1 < 2 ^ 23) (hY : e.2.1 < 2 ^ 23)
    (hi : i < 1771) (h : (compMask c e).testBit i = true) : CompAllows c e i := by
  have hbc := bit_lt23 hc
  unfold compMask at h
  unfold CompAllows
  by_cases hy : e.2.1 = 0
  · rw [if_pos hy]
    rw [show Nat.beq e.2.1 0 = true by simp [hy], cond_true, tnot_bit (by omega)] at h
    have := not_um_pc (lt23_or hX hbc) hi (by simpa using h)
    intro p hp ht
    have := this p hp ht
    rw [Nat.testBit_lor, Nat.one_shiftLeft, Nat.testBit_two_pow] at this
    simp only [Bool.or_eq_true, decide_eq_true_eq] at this
    exact this.imp id (fun h => h.symm)
  · rw [if_neg hy]
    rw [show Nat.beq e.2.1 0 = false from Bool.eq_false_iff.2 (fun h' => hy (Nat.eq_of_beq_eq_true h')), cond_false, nland, nland, Nat.testBit_and,
      Nat.testBit_and, tnot_bit (by omega)] at h
    simp only [Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨⟨h1, h2⟩, h3⟩ := h
    refine ⟨um_bit hX h1, um_bit hY h2, ?_⟩
    have := not_um_pc (lt23_or (lt23_or hX hY) hbc) hi h3
    intro p hp ht
    have := this p hp ht
    rw [Nat.testBit_lor, Nat.testBit_lor, Nat.one_shiftLeft, Nat.testBit_two_pow] at this
    simp only [Bool.or_eq_true, decide_eq_true_eq] at this
    rcases this with (h | h) | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr h.symm)

theorem orL_bit {c i : ℕ} : ∀ {L : List (ℕ × ℕ × ℕ)}, (orL c L).testBit i = true → ∃ e ∈ L, (compMask c e).testBit i = true
  | [], h => by simp [orL] at h
  | e :: L, h => by
    rw [orL, nlor', Nat.testBit_lor, Bool.or_eq_true] at h
    rcases h with h | h
    · exact ⟨e, List.mem_cons_self .., h⟩
    · obtain ⟨e', he', h'⟩ := orL_bit h
      exact ⟨e', List.mem_cons_of_mem _ he', h'⟩

theorem pwD_sound : ∀ {acc : ℕ} {L : List (ℕ × ℕ × ℕ)}, pwD acc L = true →
    (∀ e ∈ L, acc &&& cm e = 0) ∧ L.Pairwise DisjC
  | acc, [], _ => ⟨by simp, List.Pairwise.nil⟩
  | acc, e :: L, h => by
    simp only [pwD, Bool.and_eq_true, Nat.beq_eq] at h
    obtain ⟨h1, h2⟩ := pwD_sound h.2
    refine ⟨?_, List.Pairwise.cons ?_ h2⟩
    · intro e' he'
      rcases List.mem_cons.1 he' with rfl | he'
      · exact h.1
      · have := h1 e' he'
        apply Nat.eq_of_testBit_eq; intro j
        have := congrArg (fun z => z.testBit j) this
        simp only [nlor', Nat.testBit_and, Nat.testBit_lor, Nat.zero_testBit] at this ⊢
        cases hb : acc.testBit j <;> simp_all
    · intro e' he'
      have := h1 e' he'
      show cm e &&& cm e' = 0
      apply Nat.eq_of_testBit_eq; intro j
      have := congrArg (fun z => z.testBit j) this
      simp only [nlor', Nat.testBit_and, Nat.testBit_lor, Nat.zero_testBit] at this ⊢
      cases hb : (cm e).testBit j <;> simp_all

/-! ## The rational span and the upper bound -/

/-- **Upper bound.** -/
theorem finrank_le_Q {c Q sup : ℕ} (hc : c < 23) {L : List (ℕ × ℕ × ℕ)} (hcf : ∀ e ∈ L, CompFacts c Q e)
    (hS : spanS sup ≤ Wp c L) : finrank ℚ (spanS sup) ≤ (F Q).card := by
  let f : spanS sup →ₗ[ℚ] (F Q → ℚ) :=
    (LinearMap.funLeft ℚ ℚ (fun q : F Q => (q : Fin 23))).comp (spanS sup).subtype
  have hf : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have := eq_zero_of_Q hc hcf (hS x.2) (fun p hp => congrFun hx ⟨p, hp⟩)
    exact Subtype.ext this
  have := LinearMap.finrank_le_finrank_of_injective hf
  rwa [Module.finrank_fintype_fun_eq_card, Fintype.card_coe] at this

/-! ## Lower bound -/

theorem tri_lt32 (i : ℕ) : tri i < 2 ^ 32 := fieldOf_lt _ _ _

theorem triP_lt : ∀ I : List ℕ, triP I < 2 ^ (32 * I.length)
  | [] => Nat.two_pow_pos _
  | i :: I => by
    show tri i + (triP I <<< (32 * 1)) < _
    rw [List.length_cons, add_comm I.length 1]
    exact append_lt (by simpa using tri_lt32 i) (triP_lt I)

theorem row_triP : ∀ (I : List ℕ) (a : ℕ), a < I.length → row (triP I) a = tri (I.getD a 0)
  | [], a, h => by simp at h
  | i :: I, a, h => by
    show row (tri i + (triP I <<< (32 * 1))) a = _
    rw [row_append (by simpa using tri_lt32 i)]
    split_ifs with ha
    · have : a = 0 := by omega
      subst this
      rw [row, Nat.mul_zero, Nat.shiftRight_zero, Nat.mod_eq_of_lt (tri_lt32 i)]; rfl
    · obtain ⟨a', rfl⟩ : ∃ a', a = a' + 1 := ⟨a - 1, by omega⟩
      rw [List.length_cons] at h
      rw [show a' + 1 - 1 = a' by omega, row_triP I a' (by omega)]
      simp

theorem b2z_cast (b : Bool) : (((if b = true then 1 else 0 : ℤ)) : ZMod 2) = b2z b := by
  cases b <;> simp [b2z]

theorem bz_cast (m : ℕ) : (fun p => (bz m p : ℚ)) = fun p : Fin 23 => if m.testBit p = true then (1 : ℚ) else 0 := by
  funext p; simp only [bz]; split_ifs <;> simp

theorem cert2_sound {d : ℕ} {I : List ℕ} {P : ℕ} (hd : I.length = d) (h : cert2 d I P = true) :
    LinearIndependent ℚ (fun a : Fin d => tvQ (I.getD a 0)) := by
  simp only [cert2, Bool.and_eq_true, Nat.ble_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨hd24, hA⟩, hB⟩, hdot⟩ := h
  rw [dotsF_eq, tgtF_eq] at hdot
  have hAl : triP I < 2 ^ 768 := pow768 (k := d) hd24 (hd ▸ triP_lt I)
  have hBl : tk P d < 2 ^ 768 := pow768 hd24 (tk_lt P d)
  have key : ∀ a b : Fin d, ((bz (tri (I.getD a 0)) ⬝ᵥ bz (row (tk P d) b) : ℤ) : ZMod 2) =
      if a = b then 1 else 0 := by
    intro a b
    have := dot_of_dotsP_tgt (n := 23) (by norm_num) hAl hBl hdot (by omega)
      (j := a) (i := b) (by omega) (by omega) (okR_spec BAD23L_eq (by norm_num) hA (by omega))
    rw [vr, vr, row_triP I a (by omega)] at this
    have e : ((bz (tri (I.getD a 0)) ⬝ᵥ bz (row (tk P d) b) : ℤ) : ZMod 2) =
        bv 23 (tri (I.getD a 0)) ⬝ᵥ bv 23 (row (tk P d) b) := by
      simp only [dotProduct, Int.cast_sum, Int.cast_mul, bz, b2z_cast, bv]
    rw [e, this]
    by_cases hab : a = b
    · subst hab; simp
    · rw [if_neg hab, if_neg]; rintro ⟨-, h2⟩; exact hab (Fin.ext (by omega))
  have := linIndep_of_modDual (q := 2) (by decide) _ _ key
  convert this using 1
  funext a
  rw [bz_cast]; rfl

theorem dot3_eq (i y : ℕ) : dot3 i y = ∑ p : Fin 23, (if (tri i).testBit p = true then 1 else 0) * fieldOf y 2 p := by
  have : ∀ n, (Nat.rec (motive := fun _ => ℕ) 0
      (fun p ih => Nat.add ih (Nat.mul (Nat.land (Nat.shiftRight (tri i) p) 1) (fieldOf y 2 p))) n : ℕ) =
      ∑ p ∈ Finset.range n, (if (tri i).testBit p = true then 1 else 0) * fieldOf y 2 p := by
    intro n
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [Finset.sum_range_succ, ← ih]
      show Nat.add _ (Nat.mul (Nat.land (Nat.shiftRight (tri i) n) 1) (fieldOf y 2 n)) = _
      rw [land1]; rfl
  rw [dot3, this 23, ← Fin.sum_univ_eq_sum_range (fun p => (if (tri i).testBit p = true then 1 else 0) * fieldOf y 2 p)]

theorem cert3_sound {d : ℕ} {I : List ℕ} {P : ℕ} (h : cert3 d I P = true) :
    LinearIndependent ℚ (fun a : Fin d => tvQ (I.getD a 0)) := by
  simp only [cert3, Bool.and_eq_true] at h
  have key : ∀ a b : Fin d, ((bz (tri (I.getD a 0)) ⬝ᵥ (fun p => (fieldOf (fieldOf P 64 b) 2 p : ℤ)) : ℤ) :
      ZMod 3) = if a = b then 1 else 0 := by
    intro a b
    have := allN_spec (allN_spec h.1 b b.2) a a.2
    simp only [Nat.beq_eq] at this
    have e : ((bz (tri (I.getD a 0)) ⬝ᵥ (fun p => (fieldOf (fieldOf P 64 b) 2 p : ℤ)) : ℤ) : ZMod 3) =
        ((dot3 (I.getD a 0) (fieldOf P 64 b) : ℕ) : ZMod 3) := by
      rw [dot3_eq]
      simp only [dotProduct, bz, Int.cast_sum, Int.cast_mul, Nat.cast_sum, Nat.cast_mul]
      refine Finset.sum_congr rfl fun p _ => ?_
      split_ifs <;> simp
    rw [e, ← ZMod.natCast_mod, nmod] at *
    rw [this]
    by_cases hab : a = b
    · subst hab; simp
    · rw [if_neg hab]
      have : Nat.beq (a : ℕ) b = false := Bool.eq_false_iff.2 fun h' => hab (Fin.ext (Nat.eq_of_beq_eq_true h'))
      rw [this]; rfl
  have := linIndep_of_modDual (q := 3) (by decide) _ _ key
  convert this using 1
  funext a
  rw [bz_cast]; rfl

/-- **Lower bound.** -/
theorem le_finrank {sup d : ℕ} {I : List ℕ} (hd : I.length = d) (hI : ∀ i ∈ I, sup.testBit i = true)
    (hli : LinearIndependent ℚ (fun a : Fin d => tvQ (I.getD a 0))) : d ≤ finrank ℚ (spanS sup) := by
  have h1 := finrank_span_eq_card hli
  rw [Fintype.card_fin] at h1
  rw [← h1]
  apply Submodule.finrank_mono
  rw [Submodule.span_le]
  rintro _ ⟨a, rfl⟩
  apply Submodule.subset_span
  refine ⟨I.getD a 0, hI _ ?_, rfl⟩
  rw [List.getD_eq_getElem _ _ (by omega)]
  exact List.getElem_mem _

/-! ## Assembly -/

theorem PF_succ : PF.succ = 2 ^ 23 := rfl

theorem compOK_sound {c Q : ℕ} {e : ℕ × ℕ × ℕ} (h : compOK c Q e = true) : CompFacts c Q e := by
  obtain ⟨X, Y, x0⟩ := e
  simp only [compOK, Bool.and_eq_true, blt_dec, PF_succ, decide_eq_true_eq, Bool.not_eq_true', tb_eq,
    Nat.beq_eq, nland] at h
  obtain ⟨⟨⟨⟨⟨hX, hY⟩, hcX⟩, hcY⟩, hXY⟩, hrest⟩ := h
  refine ⟨hcX, hcY, hXY, ?_, ?_, hX, hY⟩
  · intro hy p hp
    simp only at hy
    rw [hy] at hrest
    have hq : X &&& Q = X := by simpa using hrest
    rw [mem_F] at hp ⊢
    have := congrArg (fun z => z.testBit p) hq
    simp only [Nat.testBit_and] at this
    rw [hp] at this; simpa using this
  · intro hy
    simp only at hy
    have hb : Nat.beq Y 0 = false := Bool.eq_false_iff.2 fun h' => hy (Nat.eq_of_beq_eq_true h')
    rw [hb, cond_false] at hrest
    simp only [Bool.and_eq_true, decide_eq_true_eq, Nat.beq_eq, nshl] at hrest
    obtain ⟨⟨hx0, hXx0⟩, hm⟩ := hrest
    refine ⟨⟨x0, hx0⟩, mem_F.2 hXx0, fun p hp hpQ => ?_⟩
    have := congrArg (fun z => z.testBit p) hm
    simp only [Nat.testBit_and, pc_bit p.2, Nat.one_shiftLeft, Nat.testBit_two_pow] at this
    rw [mem_F.1 hp, show Q.testBit p = false by simpa [mem_F] using hpQ] at this
    have h2 : x0 = (p : ℕ) := by simpa using this
    exact Fin.ext h2.symm

theorem allL_mem {α : Type} {p : α → Bool} {l : List α} (h : allL p l = true) {a : α} (ha : a ∈ l) : p a = true :=
  allL_spec h a ha

theorem recBody_sound {sup c d md Q P : ℕ} {L : List (ℕ × ℕ × ℕ)} {I : List ℕ} (hI : I.length = d)
    (h : recBody sup c d md Q L I P = true) : finrank ℚ (spanS sup) = d := by
  simp only [recBody, Bool.and_eq_true, blt_dec, PF_succ, decide_eq_true_eq, Nat.beq_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨hc, hQ⟩, hpop⟩, hpw⟩, hcomp⟩, halw⟩, hIs⟩, hcert⟩ := h
  have hpw' := (pwD_sound hpw).2
  have hcf : ∀ e ∈ L, CompFacts c Q e := fun e he => compOK_sound (allL_mem hcomp he)
  -- upper bound
  have hS : spanS sup ≤ Wp c L := by
    rw [spanS, Submodule.span_le]
    rintro _ ⟨i, hi, rfl⟩
    have ha : (alw c L).testBit i = true := by
      have := congrArg (fun z => z.testBit i) halw
      simp only [nland, Nat.testBit_and, hi, Bool.true_and] at this
      exact this
    rw [alw, nland, Nat.testBit_and, Bool.and_eq_true] at ha
    obtain ⟨hi1771, hci⟩ := star_bit hc ha.1
    obtain ⟨e, he, hm⟩ := orL_bit ha.2
    exact tv_mem hc hpw' hcf hi1771 hci he
      (compMask_sound hc (hcf e he).hX (hcf e he).hY hi1771 hm)
  have hup := finrank_le_Q hc hcf hS
  rw [← popc_card, hpop] at hup
  -- lower bound
  have hIs' : ∀ i ∈ I, sup.testBit i = true := by
    intro i hi
    have := allL_mem hIs hi
    simp only [Bool.and_eq_true, tb_eq] at this
    exact this.2
  have hli : LinearIndependent ℚ (fun a : Fin d => tvQ (I.getD a 0)) := by
    cases hmd : Nat.beq md 0
    · rw [hmd, cond_false] at hcert; exact cert3_sound hcert
    · rw [hmd, cond_true] at hcert; exact cert2_sound hI hcert
  exact le_antisymm hup (le_finrank hI hIs' hli)

theorem idxDec_length : ∀ d s, (idxDec d s).length = d
  | 0, _ => rfl
  | d + 1, s => by
    show (fieldOf s 16 0 :: idxDec d (Nat.shiftRight s 16)).length = d + 1
    rw [List.length_cons, idxDec_length d]

/-- **Soundness of one record.** -/
theorem recChk_sound {sup R : ℕ} (h : recChk sup R = true) : finrank ℚ (spanS sup) = fieldOf R 8 1 :=
  recBody_sound (idxDec_length _ _) h

/-! ## Label nesting from the DAG checks -/

theorem spanS_mono {a b : ℕ} (h : ∀ i, a.testBit i = true → b.testBit i = true) : spanS a ≤ spanS b := by
  apply Submodule.span_mono
  rintro _ ⟨i, hi, rfl⟩
  exact ⟨i, h i hi, rfl⟩

/-- **Label nesting at a gate**: both operand labels lie in the result label. -/
theorem gate_nest {sg : ℕ → ℕ} {g : ℕ × ℕ × ℕ} (h : GateOK sg g) :
    spanS (sg g.2.1) ≤ spanS (sg g.1) ∧ spanS (sg g.2.2) ≤ spanS (sg g.1) := by
  obtain ⟨-, hu⟩ := h
  constructor <;> apply spanS_mono <;> intro i hi <;> rw [← hu, Nat.testBit_lor, hi]
  · rfl
  · simp

end R6Chk.Bit

