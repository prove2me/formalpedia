section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.GL
open IntMul NLogN IntMul.HvdH IntMul.HvdH.Ref
variable {M : MulSpec} {Ctx : IState HS → Prop} {PreW : List (ℤ × ℤ) → List (ℤ × ℤ) → Prop}
  {q : Params} {CW : ℕ}
set_option maxHeartbeats 4000000
theorem solution (fw : NLogN.GL.LProg2 M Ctx PreW (fermatW q) CW) (hfw : NLogN.GL.FwOK fw) {m Φm : ℕ}
    (hM : NLogN.MulBnd M m Φm) (s : NLogN.IState NLogN.HS) (hC : Ctx s) (U : List (ℤ × ℤ))
    (R RC LN LT LP : List NLogN.Item) (T Q : ℕ)
    (hU : s.G NLogN.GL.gD = NLogN.gints U ++ R) (hCH : s.G NLogN.GL.gCH = NLogN.gints (chirpL q) ++ RC) (hUl : U.length = T)
    (hAl : (chirpL q).length = T) (hN : s.G NLogN.GL.gPN = .int T :: LN)
    (hT : s.G NLogN.GL.gPT = .int (2 ^ (q.p + q.logT)) :: LT) (hP : s.G NLogN.GL.gPP = .int (2 ^ q.p) :: LP)
    (hUb : NLogN.GL.GB m U) (hAb : NLogN.GL.GB m (chirpL q)) (hPre : PreW (NLogN.GL.ftlV q U) (chirpL q))
    (hWl : (fermatW q (NLogN.GL.ftlV q U) (chirpL q)).length = T)
    (hWb : NLogN.GL.GB Q (fermatW q (NLogN.GL.ftlV q U) (chirpL q))) (hCb : NLogN.GL.GB m (convL q (NLogN.GL.ftlV q U) (chirpL q)))
    (hmQ : 2 * m + 1 ≤ Q) (hk : q.p + q.logT + 1 ≤ Q) (hNQ : NLogN.zsz ((2 * T : ℕ) : ℤ) ≤ Q) :
    (NLogN.GL.ftlP fw).run s = s.upd NLogN.GL.gD (NLogN.gints (FtL q U) ++ R) ∧
    (NLogN.GL.ftlP fw).ok M s ∧
    (NLogN.GL.ftlP fw).cost M s ≤ CW + 8 * T * Φm + 1000000 * (T + 1) * (Q + 2) := by
  set A := chirpL q with hAdef
  set V := NLogN.GL.ftlV q U with hV
  have hpQ : q.p + 1 ≤ Q := by omega
  have hAQ : NLogN.GL.GB Q A := hAb.mono (by omega)
  -- 1: copy
  obtain ⟨r1, o1, c1⟩ := NLogN.GL.copyP_all M NLogN.GL.gPN (Or.inl rfl) Q T s A RC LN hCH hAl hN hAQ hNQ
  set s1 := s.upd NLogN.GL.gZA (NLogN.gints A ++ s.G NLogN.GL.gZA) with hs1
  -- 2: zip
  obtain ⟨r2, o2, c2⟩ := NLogN.GL.zipP_all M hM NLogN.GL.sgConjMul NLogN.GL.gPN (Or.inl rfl) q.p Q T s1 A U (s.G NLogN.GL.gZA) R LN
    LP (by simp (config := {decide := true}) [hs1]) (by simp (config := {decide := true}) [hs1, hU]) hAl hUl (by simp (config := {decide := true}) [hs1, hN]) (by simp (config := {decide := true}) [hs1, hP])
    hAb hUb hmQ hpQ hNQ
  have e2 : (s1.upd NLogN.GL.gZA (s.G NLogN.GL.gZA)).upd NLogN.GL.gD (NLogN.gints (List.zipWith (NLogN.GL.gzF NLogN.GL.sgConjMul q.p) A U) ++ R)
      = s.upd NLogN.GL.gD (NLogN.gints V ++ R) := by
    rw [hs1, NLogN.IState.upd_upd_same, NLogN.IState.upd_self, NLogN.GL.zipC_eq]; rfl
  rw [e2] at r2
  set s2 := s.upd NLogN.GL.gD (NLogN.gints V ++ R) with hs2
  have hVl : V.length = T := by
    have h' := hAl; rw [hAdef] at h'; simp [hV, NLogN.GL.ftlV, h', hUl]
  have hVb : NLogN.GL.GB Q V := by
    have := NLogN.GL.GB_zip NLogN.GL.sgConjMul q.p m A U hAb hUb
    rw [NLogN.GL.zipC_eq] at this; exact this.mono hmQ
  -- 3: copy
  obtain ⟨r3, o3, c3⟩ := NLogN.GL.copyP_all M NLogN.GL.gPN (Or.inl rfl) Q T s2 A RC LN
    (by simp (config := {decide := true}) [hs2, hCH]) hAl (by simp (config := {decide := true}) [hs2, hN]) hAQ hNQ
  set s3 := s2.upd NLogN.GL.gZA (NLogN.gints A ++ s2.G NLogN.GL.gZA) with hs3
  -- 4: conv
  have s3C : Ctx s3 := hfw.stab s s3 hC (by
    intro j hj
    simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or] at hj
    have e1 : j ≠ gD := fun h => hj.1 (by subst h; decide)
    have e2 : j ≠ gZA := fun h => hj.1 (by subst h; decide)
    simp (config := {decide := true}) [hs3, hs2, e1, e2])
  obtain ⟨r4, o4, c4⟩ := NLogN.GL.convP_all fw hfw s3 s3C V A R (s.G NLogN.GL.gZA) LN LT T Q
    (by simp (config := {decide := true}) [hs3, hs2]) (by simp (config := {decide := true}) [hs3, hs2]) hVl hAl (by simp (config := {decide := true}) [hs3, hs2, hN])
    (by simp (config := {decide := true}) [hs3, hs2, hT]) hPre hWl hWb hVb hAQ hk hNQ
  have e4 : (s3.upd NLogN.GL.gZA (s.G NLogN.GL.gZA)).upd NLogN.GL.gD (NLogN.gints (convL q V A) ++ R) =
      s.upd NLogN.GL.gD (NLogN.gints (convL q V A) ++ R) := by
    rw [hs3, hs2]; simp only [NLogN.IState.upd_G]
    rw [NLogN.GL.upd_back, NLogN.IState.upd_upd_same]
  rw [e4] at r4
  set s4 := s.upd NLogN.GL.gD (NLogN.gints (convL q V A) ++ R) with hs4
  have hCl : (convL q V A).length = T := by simp [convL, hWl]
  -- 5: copy
  obtain ⟨r5, o5, c5⟩ := NLogN.GL.copyP_all M NLogN.GL.gPN (Or.inl rfl) Q T s4 A RC LN
    (by simp (config := {decide := true}) [hs4, hCH]) hAl (by simp (config := {decide := true}) [hs4, hN]) hAQ hNQ
  set s5 := s4.upd NLogN.GL.gZA (NLogN.gints A ++ s4.G NLogN.GL.gZA) with hs5
  -- 6: zip
  obtain ⟨r6, o6, c6⟩ := NLogN.GL.zipP_all M hM NLogN.GL.sgConjMul NLogN.GL.gPN (Or.inl rfl) q.p Q T s5 A (convL q V A)
    (s.G NLogN.GL.gZA) R LN LP (by simp (config := {decide := true}) [hs5, hs4]) (by simp (config := {decide := true}) [hs5, hs4]) hAl hCl (by simp (config := {decide := true}) [hs5, hs4, hN])
    (by simp (config := {decide := true}) [hs5, hs4, hP]) hAb hCb hmQ hpQ hNQ
  have e6 : (s5.upd NLogN.GL.gZA (s.G NLogN.GL.gZA)).upd NLogN.GL.gD
      (NLogN.gints (List.zipWith (NLogN.GL.gzF NLogN.GL.sgConjMul q.p) A (convL q V A)) ++ R) =
      s.upd NLogN.GL.gD (NLogN.gints (FtL q U) ++ R) := by
    rw [hs5, hs4]; simp only [NLogN.IState.upd_G]
    rw [NLogN.GL.upd_back, NLogN.IState.upd_upd_same, NLogN.GL.zipC_eq]; rfl
  rw [e6] at r6
  refine ⟨?_, ?_, ?_⟩
  · show (NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run ((NLogN.GL.copyP NLogN.GL.gPN).run ((NLogN.GL.convP fw).run ((NLogN.GL.copyP NLogN.GL.gPN).run
      ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run ((NLogN.GL.copyP NLogN.GL.gPN).run s))))) = _
    rw [r1, r2, r3, r4, r5, r6]
  · refine ⟨o1, ?_⟩; rw [r1]
    refine ⟨o2, ?_⟩; rw [r2]
    refine ⟨o3, ?_⟩; rw [r3]
    refine ⟨o4, ?_⟩; rw [r4]
    refine ⟨o5, ?_⟩; rw [r5]
    exact o6
  · show (NLogN.GL.copyP NLogN.GL.gPN).cost M s + ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).cost M ((NLogN.GL.copyP NLogN.GL.gPN).run s) +
      ((NLogN.GL.copyP NLogN.GL.gPN).cost M ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run ((NLogN.GL.copyP NLogN.GL.gPN).run s)) +
      ((NLogN.GL.convP fw).cost M ((NLogN.GL.copyP NLogN.GL.gPN).run ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run ((NLogN.GL.copyP NLogN.GL.gPN).run s))) +
      ((NLogN.GL.copyP NLogN.GL.gPN).cost M ((NLogN.GL.convP fw).run ((NLogN.GL.copyP NLogN.GL.gPN).run ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run
        ((NLogN.GL.copyP NLogN.GL.gPN).run s)))) +
      (NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).cost M ((NLogN.GL.copyP NLogN.GL.gPN).run ((NLogN.GL.convP fw).run ((NLogN.GL.copyP NLogN.GL.gPN).run
        ((NLogN.GL.zipP NLogN.GL.sgConjMul NLogN.GL.gPN).run ((NLogN.GL.copyP NLogN.GL.gPN).run s))))))))) ≤ _
    rw [r1, r2, r3, r4, r5]
    nlinarith
end
