-- title:
--   Theorem 6.2.7 — N_{1,k+1} = N₁₁A₀N_{1k}, hence N_{1k} = N₁₁(A₀N₁₁)^{k−1} = N₁₁R^{k−1}
-- statement:
--   Consider an irreducible, positive recurrent homogeneous QBD with blocks $B,A_0,A_1,A_2$ on the levels $\ell(n)=\{(n,i):i\in\iota\}$. Fix $n\ge0$ and, for $k\ge1$, let $N_{1k}$ be the matrix whose $(i,j)$ entry is the expected number of visits to $(n+k,j)$, starting from $(n+1,i)$, before the first visit to $\ell(0)\cup\cdots\cup\ell(n)$. Let $R$ be the matrix whose $(i,j)$ entry is the expected number of visits to $(n+1,j)$, starting from $(n,i)$, before a return to $\ell(0)\cup\cdots\cup\ell(n)$. Then
--   $$N_{1,k+1}=N_{11}A_0N_{1k}\qquad\text{for }k\ge1,$$
--   and hence
--   $$N_{1k}=N_{11}(A_0N_{11})^{k-1}=N_{11}R^{k-1}\qquad\text{for }k\ge1.$$
--
--   The blocks $N_{1k}$ are the first block row of the expected-visits matrix of the upper part of the state space; the theorem says they are all generated by one block and the rate matrix $R$.
--
--   **Formalization Note** All matrices have entries in $[0,+\infty]$ and their products are computed there, so no summability needs to be assumed. The standing assumptions of §6.2 (irreducibility, positive recurrence) are kept as hypotheses; aperiodicity, which §6.2 also assumes temporarily, is not used and is omitted.
-- source:
--   Latouche & Ramaswami, Introduction to Matrix Analytic Methods in Stochastic Modeling, SIAM 1999, p. 135, Theorem 6.2.7

import Mathlib
import Definitions.Def_MatrixAnalytic_MatrixGeometric_Chain
import Definitions.Def_MatrixAnalytic_MatrixGeometric_QBD
import Definitions.Def_MatrixAnalytic_MatrixGeometric_Passage

open scoped ENNReal

namespace MatrixAnalytic.MatrixGeometric

/-- Theorem 6.2.7 (p. 135). For every `n ≥ 0`, the blocks `N_{1k}` (expected visits to
`ℓ(n + k)` from `ℓ(n + 1)` before the first visit to `ℓ(0) ∪ ⋯ ∪ ℓ(n)`) satisfy
`N_{1,k+1} = N_{11} A₀ N_{1k}` for `k ≥ 1`, hence `N_{1k} = N_{11}(A₀N_{11})^{k−1} = N_{11}R^{k−1}`,
with `R` the expected-visits matrix of Theorem 6.2.1. Products are computed in `ℝ≥0∞`. -/
theorem N_block_recurrence {ι : Type*} [Countable ι] [DecidableEq ι]
    (B A₀ A₁ A₂ : ι → ι → ℝ)
    (hP : IsStochasticC (qbdP B A₀ A₁ A₂))
    (hirr : IrreducibleC (qbdP B A₀ A₁ A₂))
    (hpos : ∀ x : ℕ × ι, PositiveRecurrent (qbdP B A₀ A₁ A₂) x) (n : ℕ) :
    (∀ k : ℕ, 1 ≤ k →
      matNblock (qbdP B A₀ A₁ A₂) n (k + 1) =
        matMulE (matMulE (matNblock (qbdP B A₀ A₁ A₂) n 1) (ennMat A₀))
          (matNblock (qbdP B A₀ A₁ A₂) n k)) ∧
    (∀ k : ℕ, 1 ≤ k →
      matNblock (qbdP B A₀ A₁ A₂) n k =
          matMulE (matNblock (qbdP B A₀ A₁ A₂) n 1)
            (matPowE (matMulE (ennMat A₀) (matNblock (qbdP B A₀ A₁ A₂) n 1)) (k - 1)) ∧
        matNblock (qbdP B A₀ A₁ A₂) n k =
          matMulE (matNblock (qbdP B A₀ A₁ A₂) n 1)
            (matPowE (matR (qbdP B A₀ A₁ A₂) n) (k - 1))) := by sorry

end MatrixAnalytic.MatrixGeometric
