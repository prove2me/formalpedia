/-!
## COU-20: exact separation criterion and order-three quotient corollary
-/

theorem abelianThreeSeparations_iff_double_ne_zero
    (a d h : G) (hhalf : h + h = 0)
    (hthree : (d + d) + d = 0 ∨ (d + d) + d = h) :
    (a ≠ a + d ∧ a ≠ (a + d) + h ∧
      a ≠ a - d ∧ a ≠ (a - d) + h ∧
      a + d ≠ a - d ∧ a + d ≠ (a - d) + h) ↔
        d + d ≠ 0 := by sorry


























