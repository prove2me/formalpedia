theorem atan_body_cost_sol_aux (x N K : ℕ) (σ : ℤ) (hσ : |σ| = 1) (s0 t : IState HS) (k : ℕ)
    (h : atanInv' x N K σ s0 k t) (hk : k < K) (hx : 0 < x) :
    (atanBody x σ).cost t + asgCost 45 (decE 45) ((atanBody x σ).run t) ≤
      30 * 10 ^ 7 * (atanB x N K + 2) ^ 2 := by
  obtain ⟨h40, h41, h42, h43, h44, h45, hj⟩ := h
  have hM := atanM_lt x N K
  set B := atanB x N K
  set M := atanM x N K with hMdef
  have hS := atanSum_abs_le x N σ hσ k
  have hS1 := atanSum_abs_le x N σ hσ (k + 1)
  rw [atanSum_succ] at hS1
  have hxk : (1 : ℤ) ≤ (x : ℤ) ^ (2 * k + 1) := one_le_pow₀ (by exact_mod_cast hx)
  have hxK : (x : ℤ) ^ (2 * k + 3) ≤ (x : ℤ) ^ (2 * K + 3) :=
    pow_le_pow_right₀ (by exact_mod_cast hx) (by omega)
  have hMz : (M : ℤ) = 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
    simp [hMdef, atanM]
  have h2N : (1 : ℤ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
  have hpos : (0 : ℤ) ≤ (x : ℤ) ^ (2 * K + 3) := by positivity
  have hxx : (x : ℤ) ^ (2 * k + 1) * ((x : ℤ) * x) = (x : ℤ) ^ (2 * k + 3) := by ring
  have hxle : (x : ℤ) ^ (2 * k + 1) ≤ (x : ℤ) ^ (2 * k + 3) := by
    have h1x : (1 : ℤ) ≤ x := by exact_mod_cast hx
    have : (1 : ℤ) ≤ (x : ℤ) * x := by nlinarith
    rw [← hxx]; nlinarith
  have hx1 : (1 : ℤ) ≤ (x : ℤ) ^ (2 * K + 3) := one_le_pow₀ (by exact_mod_cast hx)
  -- generic: anything bounded by `(2K+3) 2^N x^(2K+3)` fits
  have big : ∀ z : ℤ, |z| ≤ M → zsz z ≤ B := fun z hz => zsz_le_of_abs_le hz hM
  have hd : (0 : ℤ) < ((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1) := by positivity
  have hq0 : (0 : ℤ) ≤ 2 ^ N / (((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1)) :=
    Int.ediv_nonneg (by positivity) hd.le
  have hq1 : (2 : ℤ) ^ N / (((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1)) ≤ 2 ^ N :=
    Int.ediv_le_self _ (by positivity)
  have hqe : ((2 ^ N / ((2 * k + 1) * x ^ (2 * k + 1)) : ℕ) : ℤ) =
      (2 : ℤ) ^ N / (((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1)) := by
    push_cast; ring_nf
  rw [hqe] at hS1
  have hK1 : (k : ℤ) + 1 ≤ K := by exact_mod_cast hk
  have hR1 : (1 : ℤ) ≤ (x : ℤ) ^ (2 * K + 3) * 2 ^ N := by nlinarith
  have hRQ : (2 * (K : ℤ) + 3) ≤ 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by nlinarith
  have hRP : (2 : ℤ) ^ N ≤ 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by nlinarith
  have hRX : (x : ℤ) ^ (2 * k + 3) ≤ 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by nlinarith
  have hxx2 : (x : ℤ) * x ≤ (x : ℤ) ^ (2 * k + 3) := by
    have : (x : ℤ) ^ (2 * k + 3) = (x : ℤ) ^ (2 * k + 1) * (x * x) := by ring
    rw [this]; nlinarith
  have hkx : ((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1) ≤
      2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
    have : ((k : ℤ) + k + 1) * (x : ℤ) ^ (2 * k + 1) ≤ (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
      apply mul_le_mul (by omega) (le_trans hxle hxK) (by positivity) (by omega)
    nlinarith
  have hQX : (k : ℤ) + 1 ≤ (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
    have : (2 * (K : ℤ) + 3) ≤ (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
      have := mul_le_mul_of_nonneg_left hx1 (show (0 : ℤ) ≤ 2 * K + 3 by positivity)
      simpa using this
    linarith
  have hSk1 : ((k + 1 : ℕ) : ℤ) * 2 ^ N ≤ 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
    push_cast
    calc ((k : ℤ) + 1) * 2 ^ N ≤ ((2 * K + 3) * (x : ℤ) ^ (2 * K + 3)) * 2 ^ N :=
          mul_le_mul_of_nonneg_right hQX (by positivity)
      _ = _ := by ring
  have hSk : (k : ℤ) * 2 ^ N ≤ 2 ^ N * (2 * K + 3) * (x : ℤ) ^ (2 * K + 3) := by
    have : (k : ℤ) * 2 ^ N ≤ ((k + 1 : ℕ) : ℤ) * 2 ^ N := by
      push_cast; exact mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    linarith
  have hk0 : (0 : ℤ) ≤ k := by positivity
  have hxk1 := le_trans hxle hRX
  simp only [atanBody, seqL, RS.cost, run_seq]
  refine le_trans (add_le_add (add_le_add (asgCost_le _ _ _ B ?_ ?_) (add_le_add
    (asgCost_le _ _ _ B ?_ ?_) (add_le_add (asgCost_le _ _ _ B ?_ ?_) (asgCost_le _ _ _ B ?_ ?_))))
    (asgCost_le _ _ _ B ?_ ?_)) ?_
  all_goals simp (config := {decide := true}) only [Ex.Bnd, Ex.eval, Ex.size, decE, IState.top,
    RS.run_asg_G, h40, h41, h42, h43, h44, h45, if_true, if_false, List.tail_cons]
  all_goals (repeat' apply And.intro)
  all_goals (try (apply big; rw [hMz]))
  rotate_right
  · generalize (B + 2) ^ 2 = X; norm_num; omega
  all_goals first
    | exact le_trans hS hSk
    | exact le_trans hS1 hSk1
    | (rw [abs_of_nonneg hq0]; exact le_trans hq1 hRP)
    | (rw [abs_mul, abs_pow, hσ, one_pow, one_mul, abs_of_nonneg hq0]; exact le_trans hq1 hRP)
    | (rw [abs_pow, hσ, one_pow]; linarith [hRQ])
    | (rw [abs_mul, abs_pow, hσ, one_pow, one_mul]; linarith [hRQ])
    | (rw [hσ]; linarith [hRQ])
    | (rw [abs_one]; linarith [hRQ])
    | (rw [abs_neg, abs_one]; linarith [hRQ])
    | (rw [hxx, abs_of_nonneg (by positivity)]; exact hRX)
    | (rw [abs_of_nonneg (by positivity)]; exact hkx)
    | (rw [abs_of_nonneg (by positivity)]; exact hxk1)
    | (rw [abs_of_nonneg (by positivity)]; linarith [hxx2, hRX])
    | (rw [abs_of_nonneg (by positivity)]; exact hRP)
    | linarith [hRQ]
    | (rw [abs_of_nonneg (by linarith)]; linarith [hRQ, hK1])

end NLogN

