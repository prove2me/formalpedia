    (h : RootConstants b R U D C TB ZB cap L m) (a : F) (ha : m 96 = enc b a) :
    RootEnvironment b R U D C TB ZB cap L a m :=
  ⟨h.length, h.dimension, h.unit, h.capacity, ha, h.fixedR, h.fixedD, h.fixedU, h.fixedC, h.fixedT, h.fixedZ, h.zero⟩

theorem root_prepare_writable_le_basis (R U D C TB cap BQ QB T addr : ℕ) (h : rootPrepareMeta addr) :
