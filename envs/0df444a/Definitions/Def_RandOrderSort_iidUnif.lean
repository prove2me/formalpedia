-- title:
--   The i.i.d. uniform experiment and $\sigma(P_L)$
-- statement:
--   Through §4.5 the paper analyzes $n$ independent uniform inputs in $[0,1]$. This module defines their product law `iidUnif n`, the key order of that run (by value, with ties broken by arrival index, a null event), the first $m$ inputs (`prefixOf`), the input vector with given first $m$ inputs and later inputs (`joinIn`), the order statistics of the prefix, and $\sigma(P_L)$ (`HL`), the $\sigma$-algebra generated by those order statistics, that is, by the unordered prefix set $P_L$.
--
--   **Formalization Note** The stream is the input order ($\pi=\sigma=1$). Conditioning on $P_L$ is written either as a conditional expectation given `HL n`, or by fixing a realization of the first $m$ inputs and drawing the other $N$ inputs i.i.d., which is a version of the regular conditional law of the product measure.
-- source:
--   Kang, Fan, Optimal High Probability Bounds for Random Order Online Sorting, arXiv:2610.15438 (version of 2026-11-01), §3.2, p.13 (P_j); §4.2, p.23

import Mathlib
import Definitions.Def_RandOrderSort_OnlineCmpAlg
import Definitions.Def_RandOrderSort_phaseStart

namespace RandOrderSort

open MeasureTheory

/-! # The i.i.d. uniform experiment of §§4.2–4.5 (p.23)

Kang, Fan, arXiv:2610.15438 (version of 2026-11-01), §4.2, p.23: "Through Section 4.5, we analyze
independent uniform inputs in [0, 1] and fix a deterministic cut q ∈ (0, 1). Almost surely, the
input keys are distinct and none equals q." §3.2, p.13: "Let P_j be the unordered set of the first
t_j keys, including j = L."

**Formalization Note.**
* The law of `n` i.i.d. `U[0,1]` inputs is `iidUnif n`, the product of Lebesgue measure on `[0,1]`.
  Arrival `t` has value `X t` (the stream is the input order, `π = σ = 1`); value ties, a null
  event, are broken by arrival index (`iidLt`).
* Conditioning on the unordered prefix set `P_L` is either written as the conditional expectation
  given `HL n`, the σ-algebra generated by the order statistics of the first `m` inputs (which
  determine `P_L` and are determined by it), or by fixing a realization `y` of the first `m`
  inputs and drawing the remaining `N = n − m` inputs i.i.d. (`joinIn y w`), the regular conditional
  law of the product measure.
-/

/-- The law of `n` independent `U[0,1]` inputs. -/
noncomputable def iidUnif (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ => (volume : Measure ℝ).restrict (Set.Icc (0 : ℝ) 1))

/-- The product law is a finite measure (structural instance). -/
instance iidUnif_isFiniteMeasure (n : ℕ) : IsFiniteMeasure (iidUnif n) := by
  unfold iidUnif; infer_instance

/-- The key order of the i.i.d. run: by value, ties by arrival index. -/
noncomputable def iidLt {n : ℕ} (X : Fin n → ℝ) : ℕ → ℕ → Bool := ltOf X 1 1

/-- The first `m` inputs (`m = 2t_J`, (10)), the observed prefix whose set is `P_L`. -/
def prefixOf {n : ℕ} (X : Fin n → ℝ) : Fin (m n) → ℝ :=
  fun a => if h : a.1 < n then X ⟨a.1, h⟩ else 0

/-- The input vector with first `m` inputs `y` and later inputs `w` (for `m ≤ n`). -/
def joinIn {n : ℕ} (y : Fin (m n) → ℝ) (w : Fin (N n) → ℝ) : Fin n → ℝ :=
  fun a => if h : a.1 < m n then y ⟨a.1, h⟩ else w ⟨a.1 - m n, by have := a.2; unfold N; omega⟩

/-- The order statistics of the first `m` inputs, `y_1 ≤ ⋯ ≤ y_m`. -/
noncomputable def sortedPrefix {n : ℕ} (X : Fin n → ℝ) : Fin (m n) → ℝ :=
  prefixOf X ∘ Tuple.sort (prefixOf X)

/-- `σ(P_L)`: the σ-algebra on input vectors generated by the unordered prefix set `P_L`, i.e. by
the order statistics of the first `m` inputs. -/
@[instance_reducible] noncomputable def HL (n : ℕ) : MeasurableSpace (Fin n → ℝ) :=
  MeasurableSpace.comap (sortedPrefix (n := n)) inferInstance

end RandOrderSort


