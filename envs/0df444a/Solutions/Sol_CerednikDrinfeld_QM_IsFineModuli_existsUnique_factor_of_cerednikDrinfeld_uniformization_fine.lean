      Spec.map (CommRingCat.ofHom φ.toRingHom) ≫ (ρ' B hB₀ x).1 = (ρ' C hC ((AlgFunctor.prod (AlgFunctor.prod (AlgFunctor.corep Onr) (Omega K₀ π)) (AlgFunctor.const G)).map φ x)).1 := by
