theorem sum_pd_mul (K : Fin 5 → ℝ) {ρ φ : Pt 5 → ℝ} {x : Pt 5} (hρ : DifferentiableAt ℝ ρ x)
    (hφ : DifferentiableAt ℝ φ x) :
    ∑ j, K j * pd j (fun y => ρ y * φ y) x =
      (∑ j, K j * pd j ρ x) * φ x + ρ x * ∑ j, K j * pd j φ x := by
  simp only [pd_mul _ hρ hφ, Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
