        MultiplicativeTypeNat (B.inertiaSubgroupIn ℚ) n
          ((Submodule.torsionBy ℤ (JZero p) ((2 : ℤ) ^ m)).toAddSubgroup ⊓ AddSubgroup.closure
            {y : JZero p | ∃ σ ∈ B.inertiaSubgroupIn ℚ, ∃ M : ℕ,
