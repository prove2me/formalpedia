/-! # Finite spatial matrix images and their unit balls -/

namespace KadisonKastler

open UnitalTomsWinter Generator
open scoped BigOperators

noncomputable section

variable {H K : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
  [CompleteSpace H] [NormedAddCommGroup K] [InnerProductSpace ℂ K] [CompleteSpace K]
variable {ι : Type*} [Fintype ι] [DecidableEq ι]

attribute [local instance] OAI.KadisonKastler.spatialImageOperatorStarOrder
local instance spatialImageAlgebraOrder_re898af_1 (M : VonNeumannAlgebra H) :
    PartialOrder (Algebra M) := CStarAlgebra.spectralOrder _
attribute [local instance] OAI.KadisonKastler.spatialImageOperatorOrder
local instance spatialImageAlgebraStarOrder_re898af_1 (M : VonNeumannAlgebra H) :
    StarOrderedRing (Algebra M) := CStarAlgebra.spectralOrderedRing _
theorem spatialMatrixAlgebraHom_apply (M : VonNeumannAlgebra H)
    (E : MatrixUnitSystem ι (K →L[ℂ] K)) (X : CStarMatrix ι ι (Algebra M)) :
    spatialMatrixAlgebraHom M E X =
      ∑ i, ∑ j, spatialTensorOp (X i j).val (E.entry i j) :=
  spatialMatrixHom_apply E (coefficientMatrixMap M.toStarSubalgebra.subtype X)

omit [CompleteSpace H] [CompleteSpace K] [Fintype ι] in
private theorem spatialTensorOp_sum_right (a : H →L[ℂ] H) (s : Finset ι)
    (b : ι → K →L[ℂ] K) :
    spatialTensorOp a (∑ i ∈ s, b i) = ∑ i ∈ s, spatialTensorOp a (b i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih => simp only [Finset.sum_insert hi, spatialTensorOp_add_right, ih]

theorem spatialLeft_mem_matrixAlgebra (M : VonNeumannAlgebra H)
    (E : MatrixUnitSystem ι (K →L[ℂ] K)) {a : H →L[ℂ] H} (ha : a ∈ M) :
    spatialLeft (K := K) a ∈ spatialMatrixAlgebra M E := by
  let X : CStarMatrix ι ι (Algebra M) := fun i j => if i = j then ⟨a, ha⟩ else 0
  refine ⟨X, ?_⟩
  change spatialMatrixAlgebraHom M E X = spatialLeft (K := K) a
  rw [spatialMatrixAlgebraHom_apply]
  have hX (i j : ι) : (X i j).val = if i = j then a else 0 := by
    dsimp [X]
    split_ifs <;> rfl
  have hh (i j : ι) : spatialTensorOp (X i j).val (E.entry i j) =
      if i = j then spatialTensorOp a (E.entry i j) else 0 := by
    rw [hX]
    split_ifs <;> simp only [spatialTensorOp_zero_left]
  simp only [hh]
  have hd (i : ι) : (∑ j, if i = j then spatialTensorOp a (E.entry i j) else 0) =
      spatialTensorOp a (E.entry i i) := by
    classical
    rw [Finset.sum_eq_single i]
    · simp only [ite_true, if_true]
    · intro j _ hji
      simp only [ite_eq_right (Ne.symm hji)]
    · intro hi
      exact False.elim (hi (Finset.mem_univ i))
  simp only [hd]
  rw [← spatialTensorOp_sum_right, E.total]
  rfl

theorem spatialRight_mem_matrixAlgebra (M : VonNeumannAlgebra H)
    (E : MatrixUnitSystem ι (K →L[ℂ] K)) {b : K →L[ℂ] K} (hb : b ∈ E.algebra) :
    spatialRight (H := H) b ∈ spatialMatrixAlgebra M E := by
  obtain ⟨c, rfl⟩ := (E.mem_algebra b).mp hb
  let X : CStarMatrix ι ι (Algebra M) := fun i j => c i j • 1
  refine ⟨X, ?_⟩
  change spatialMatrixAlgebraHom M E X = spatialRight (H := H) _
  rw [spatialMatrixAlgebraHom_apply]
  change (∑ i, ∑ j, spatialTensorOp (c i j • (1 : H →L[ℂ] H)) (E.entry i j)) =
    spatialRight (H := H) (∑ i, ∑ j, c i j • E.entry i j)
  simp only [map_sum, map_smul, spatialTensorOp_smul_left]
  rfl

theorem spatialMatrixAlgebra_le_product (M : VonNeumannAlgebra H) (D : VonNeumannAlgebra K)
    (E : MatrixUnitSystem ι (K →L[ℂ] K)) (hE : ∀ i j, E.entry i j ∈ D) :
    spatialMatrixAlgebra M E ≤ (spatialProductAlgebra M D).toStarSubalgebra := by
  rintro T ⟨X, rfl⟩
  exact spatialMatrixHom_mem M D E hE
    (coefficientMatrixMap M.toStarSubalgebra.subtype X) (fun i j => (X i j).property)

end

end KadisonKastler

end OAI
end

