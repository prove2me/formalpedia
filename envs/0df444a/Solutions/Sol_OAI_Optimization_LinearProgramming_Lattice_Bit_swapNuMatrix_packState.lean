  · simpa using hlen
  · intro i hi _
    have hin : i<n := hlen ▸ hi
    have hh := h ⟨i,hin⟩
    change readAt [] rows i = _ at hh
    rw [readAt_eq_getElem [] rows i hi] at hh
    simpa [packMatrix] using hh

