/-
# `CertifiedEvidence.mcnugget_gaps`
Target `4801d159` (Open, not deprecated at draft time; re-read live immediately before submitting).

ORDINARY PROOF — imports nothing from `Theorems`, so no `sorryAx` and no axiom audit.

The numerical semigroup generated by 3 and 5. Its Frobenius number is 3·5−3−5 = 7, and the
non-representable naturals are exactly {1, 2, 4, 7}.

  (→) If n = 3x + 5y then n is none of 1, 2, 4, 7 — each is a linear-arithmetic impossibility.
  (←) Below 8 the representable values are 0 = 0+0, 3 = 3·1, 5 = 5·1, 6 = 3·2, and the excluded
      four are exactly the rest. From 8 upward, strong induction with step 3: 8, 9, 10 are given
      explicitly (3+5, 3·3, 5·2), and any m ≥ 11 reduces to m−3 ≥ 8.
-/
import Mathlib
import Definitions.Def_MachineLearning_CertifiedEvidence_Core
import Definitions.Def_MachineLearning_CertifiedEvidence_Sufficiency

set_option autoImplicit false

/-- **The target, verbatim.** -/
theorem solution (n : ℕ) :
    (∃ x y : ℕ, n = 3 * x + 5 * y) ↔ n ∉ ({1, 2, 4, 7} : Finset ℕ) := by
  have key : ∀ m : ℕ, 8 ≤ m → ∃ x y : ℕ, m = 3 * x + 5 * y := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      intro hm
      rcases Nat.lt_or_ge m 11 with h11 | h11
      · interval_cases m
        · exact ⟨1, 1, by norm_num⟩
        · exact ⟨3, 0, by norm_num⟩
        · exact ⟨0, 2, by norm_num⟩
      · obtain ⟨x, y, hxy⟩ := ih (m - 3) (by omega) (by omega)
        exact ⟨x + 1, y, by omega⟩
  constructor
  · rintro ⟨x, y, rfl⟩
    simp only [Finset.mem_insert, Finset.mem_singleton]
    push_neg
    refine ⟨?_, ?_, ?_, ?_⟩ <;> omega
  · intro h
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at h
    obtain ⟨h1, h2, h4, h7⟩ := h
    rcases Nat.lt_or_ge n 8 with hlt | hge
    · interval_cases n
      · exact ⟨0, 0, by norm_num⟩
      · exact absurd rfl h1
      · exact absurd rfl h2
      · exact ⟨1, 0, by norm_num⟩
      · exact absurd rfl h4
      · exact ⟨0, 1, by norm_num⟩
      · exact ⟨2, 0, by norm_num⟩
      · exact absurd rfl h7
    · exact key n hge
