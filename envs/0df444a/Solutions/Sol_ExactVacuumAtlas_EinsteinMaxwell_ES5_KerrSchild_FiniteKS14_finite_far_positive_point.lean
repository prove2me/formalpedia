variable {I : Set ℝ} {s h x : ℝ}

/-! ## Chain rule for the chart `x ↦ s + 1/x` -/

theorem hasDerivAt_chart (s : ℝ) (hx : x ≠ 0) :
    HasDerivAt (fun y => s + y⁻¹) (-(x ^ 2)⁻¹) x :=
  (hasDerivAt_inv hx).const_add s

theorem eventually_chart (hI : IsOpen I) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I) :
    ∀ᶠ y in 𝓝 x, y ≠ 0 ∧ s + y⁻¹ ∈ I :=
  (eventually_ne_nhds hx).and
    ((continuousAt_const.add (continuousAt_inv₀ hx)).preimage_mem_nhds (hI.mem_nhds hxI))

theorem hasDerivAt_pull {g : ℝ → ℝ} {g' : ℝ} (hg : HasDerivAt g g' (s + x⁻¹)) (hx : x ≠ 0) :
    HasDerivAt (pull s g) (-g' / x ^ 2) x :=
  (hg.comp x (hasDerivAt_chart s hx)).congr_deriv (by ring)

section Second

variable {g : ℝ → ℝ} (hI : IsOpen I) (hgd : ∀ R ∈ I, HasDerivAt g (deriv g R) R)
  (hg2 : HasDerivAt (deriv g) (deriv (deriv g) (s + x⁻¹)) (s + x⁻¹)) (hx : x ≠ 0)
  (hxI : s + x⁻¹ ∈ I)
include hI hgd hx hxI

theorem deriv_pull_eventually :
    deriv (pull s g) =ᶠ[𝓝 x] fun y => -deriv g (s + y⁻¹) / y ^ 2 :=
  (eventually_chart hI hx hxI).mono fun _ hy => (hasDerivAt_pull (hgd _ hy.2) hy.1).deriv

include hg2

end Second

/-! ## Values on the chart for paper-gauge data -/

section Paper

variable {f m N w p a : ℝ → ℝ} (hP : PaperData I f m N w p a) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I)
include hP hx hxI

omit hP in
theorem deriv_pull_of (g : ℝ → ℝ) (hgd : ∀ R ∈ I, HasDerivAt g (deriv g R) R) :
    deriv (pull s g) x = -deriv g (s + x⁻¹) / x ^ 2 :=
  (hasDerivAt_pull (hgd _ hxI) hx).deriv

variable (hN : FactorizedN I N s h)
include hN

omit hP in
theorem N_chart : N (s + x⁻¹) = (1 - h * x) / x ^ 2 := by
  rw [hN _ hxI]; field_simp; ring

theorem deriv_N_chart : deriv N (s + x⁻¹) = (2 - h * x) / x := by
  have hev : N =ᶠ[𝓝 (s + x⁻¹)] fun R => (R - s) * (R - s - h) :=
    Filter.eventuallyEq_of_mem (hP.isOpen.mem_nhds hxI) fun R hR => hN R hR
  have hd : HasDerivAt (fun R => (R - s) * (R - s - h))
      (1 * (s + x⁻¹ - s - h) + (s + x⁻¹ - s) * 1) (s + x⁻¹) :=
    ((hasDerivAt_id' (s + x⁻¹)).sub_const s).mul
      (((hasDerivAt_id' (s + x⁻¹)).sub_const s).sub_const h)
  rw [hev.deriv_eq, hd.deriv]; field_simp; ring

theorem u_chart_ne_zero : 1 - h * x ≠ 0 := by
  intro hu
  have h0 := hP.nN _ hxI
  rw [N_chart hx hxI hN, hu, zero_div] at h0
  exact h0 rfl

/-! ## The four compactified residual identities (genuine chain rule) -/

end Paper

/-! ## The real geodesic defect on the chart -/

section Gamma

variable {f m N w p a : ℝ → ℝ} (hP : PaperData I f m N w p a) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I)
  (hN : FactorizedN I N s h)
include hP hx hxI hN

omit hN in
/-- `δ` really is `d/dR` on the chart: `δA = a'`, `δ²A = a''`, `δ(x²F) = (f/(R-s)²)'`. -/
theorem deltaFun_pull_a : deltaFun (pull s a) x = deriv a (s + x⁻¹) := by
  show -x ^ 2 * deriv (pull s a) x = _
  rw [deriv_pull_of hx hxI a (fun R hR => hP.da hR)]
  generalize deriv a (s + x⁻¹) = t
  field_simp

omit hN in
theorem deltaFun_deltaFun_pull_a :
    deltaFun (deltaFun (pull s a)) x = deriv (deriv a) (s + x⁻¹) := by
  have hev : deltaFun (pull s a) =ᶠ[𝓝 x] pull s (deriv a) := by
    filter_upwards [deriv_pull_eventually hP.isOpen (fun R hR => hP.da hR) hx hxI,
      eventually_ne_nhds hx] with y hy hy0
    show -y ^ 2 * deriv (pull s a) y = pull s (deriv a) y
    rw [hy]
    simp only [pull]
    generalize deriv a (s + y⁻¹) = t
    field_simp
  show -x ^ 2 * deriv (deltaFun (pull s a)) x = _
  rw [hev.deriv_eq, (hasDerivAt_pull (hP.d2a hxI) hx).deriv]
  generalize deriv (deriv a) (s + x⁻¹) = t
  field_simp

omit hN in
theorem deltaFun_sq_pull_f :
    deltaFun (fun y => y ^ 2 * pull s f y) x =
      -2 * x ^ 3 * f (s + x⁻¹) + x ^ 2 * deriv f (s + x⁻¹) := by
  have hd : HasDerivAt (fun y => y ^ 2 * pull s f y)
      (((2 : ℕ) : ℝ) * x ^ (2 - 1) * pull s f x + x ^ 2 * (-deriv f (s + x⁻¹) / x ^ 2)) x :=
    (hasDerivAt_pow 2 x).mul (hasDerivAt_pull (hP.df hxI) hx)
  show -x ^ 2 * deriv (fun y => y ^ 2 * pull s f y) x = _
  rw [hd.deriv]
  simp only [pull, Nat.cast_ofNat, Nat.reduceSub, pow_one]
  generalize f (s + x⁻¹) = t₀; generalize deriv f (s + x⁻¹) = t₁
  field_simp; ring

/-- **Real G compactification.** With the conservation law `q = -Q` on `I` and the `w'` relation
at `R = s + 1/x` (VII-02's `G_onshell` premises), `u² G(R) = realGamma …(x)`, the real-function
version of F1's Γ expression. Valid on the chart only (`x ≠ 0`), not a Taylor statement. -/
theorem realGamma_eq {Q J : ℝ} (hq : ∀ r ∈ I, qFun f N w p a r = -Q)
    (hw : deriv w (s + x⁻¹) = -2 * (J + 2 * Q * a (s + x⁻¹)) * f (s + x⁻¹) * m (s + x⁻¹) /
      N (s + x⁻¹) ^ 2) :
    (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) =
      realGamma h Q J (pull s f) (pullM s m) (pull s a) x := by
  have hf := hP.nf _ hxI; have hm := hP.nm _ hxI; have hu := u_chart_ne_zero hP hx hxI hN
  rw [G_onshell hP hxI hq hw, (hasDerivAt_Ffun hP hxI).deriv]
  unfold realGamma
  rw [deltaFun_pull_a hP hx hxI, deltaFun_deltaFun_pull_a hP hx hxI,
    deltaFun_sq_pull_f hP hx hxI]
  simp only [Ffun, N_chart hx hxI hN, deriv_N_chart hP hx hxI hN, pull, pullM]
  generalize s + x⁻¹ = R at hf hm ⊢
  field_simp
  ring

end Gamma

/-! ## Roots: `PaperBVP` on `I` ⇒ the compactified system on the chart -/

section Roots

variable {f m N w p a : ℝ → ℝ}

/-- **VII-04 bridge root (F2c1, real part).** On the factorized-N branch, the actual `PaperBVP`
on `I` implies, at every chart point `x ≠ 0` with `s + 1/x ∈ I`: the four real compactified
residuals of `F = pull s f`, `b = pullM s m`, `A = pull s a` vanish, and
`u² G(s + 1/x) = realGamma …(x)`. -/
theorem vii04_compactified_bridge (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    {Q J : ℝ} (hB : PaperBVP I f m N w p a Q J) (hx : x ≠ 0) (hxI : s + x⁻¹ ∈ I) :
    realPF h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPM h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPA h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    realPC h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
    (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) =
      realGamma h Q J (pull s f) (pullM s m) (pull s a) x := by
  obtain ⟨hq, hl, -, hF, hM, h24, hC⟩ := hB _ hxI
  have h24' : eq24cResidual f m N a Q J (s + x⁻¹) = 0 := sub_eq_zero.mpr h24
  obtain ⟨e1, e2, e3, e4⟩ := (compact_iff_paper hP hN hx hxI Q J).mpr ⟨hF, hM, h24', hC⟩
  exact ⟨e1, e2, e3, e4, realGamma_eq hP hx hxI hN (fun r hr => (hB r hr).1)
    (e_w_of_constants hP hxI hq hl).2⟩

/-- The same on an explicit interval `0 < x < ε` of the chart, for `I ⊇ (s + 1/ε, ∞)`. -/
theorem vii04_compactified_bridge_Ioo (hP : PaperData I f m N w p a) (hN : FactorizedN I N s h)
    {Q J : ℝ} (hB : PaperBVP I f m N w p a Q J) {ε : ℝ} (hε : 0 < ε)
    (hsub : Set.Ioi (s + ε⁻¹) ⊆ I) :
    ∀ x ∈ Set.Ioo 0 ε,
      realPF h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPM h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPA h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      realPC h Q J (pull s f) (pullM s m) (pull s a) x = 0 ∧
      (1 - h * x) ^ 2 * Gfun p a (s + x⁻¹) =
        realGamma h Q J (pull s f) (pullM s m) (pull s a) x := by
  intro x hx
  have hxI : s + x⁻¹ ∈ I :=
    hsub (show s + ε⁻¹ < s + x⁻¹ by linarith [(inv_lt_inv₀ hε hx.1).mpr hx.2])
  exact vii04_compactified_bridge hP hN hB hx.1.ne' hxI

end Roots

