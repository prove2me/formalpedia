theorem solution
    (K : Type u) [Field K] [IsAlgClosed K] {A : Scheme.{u}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (n : ℕ) (hn : (n : K) ≠ 0)
    (hG : ∀ x ∈ L.torsionSubset (𝟙 (Spec (CommRingCat.of K))) n, L.translate x ≫ L.schemeNsmul n = L.schemeNsmul n) :
    (∀ (χ ψ : SchemeHomOver (𝟙 (Spec (CommRingCat.of K))) f → K),
      L.IsNsmulCharacter n χ → L.IsNsmulCharacter n ψ →
      ∀ y : A, ∃ V : A.affineOpens, y ∈ V.1 ∧
        ∃ (s : (L.eigenSubdatum n hG χ).obj V.1) (t : (L.eigenSubdatum n hG ψ).obj V.1),
          ∀ (W : A.affineOpens) (hW : W.1 ≤ V.1),
            Function.Bijective (fun a : Γ(A, W.1) => a • (L.eigenSubdatum n hG χ).res hW s) ∧
            Function.Bijective (fun a : Γ(A, W.1) => a • (L.eigenSubdatum n hG ψ).res hW t) ∧
            Function.Bijective (fun a : Γ(A, W.1) => a • (L.eigenSubdatum n hG (χ * ψ)).res hW (L.eigenMul n hG s t))) ∧
    (∀ U : A.affineOpens, Function.Bijective (fun a : Γ(A, U.1) => a • L.eigenOne n hG U.1)) := by
  have hb : ∀ U : A.affineOpens, Function.Bijective (fun a : Γ(A, U.1) => a • L.eigenOne n hG U.1) :=
    fun U => GoodReductionJacobian.AbelianSchemePropertyBundle.bijective_smul_eigenOne K f L hc hA g n hn hG U
  refine ⟨?_, hb⟩
  intro χ ψ hχ hψ y
  obtain ⟨V₁, hy₁, s₁, hs₁⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_affineOpens_isUnit_eigenSubdatum K f L hc hA g n hn hG χ hχ y
  obtain ⟨V₂, hy₂, t₂, ht₂⟩ :=
    GoodReductionJacobian.AbelianSchemePropertyBundle.exists_affineOpens_isUnit_eigenSubdatum K f L hc hA g n hn hG ψ hψ y
  obtain ⟨V', hV', hyV', hV'le⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp A.isBasis_affineOpens) (show y ∈ V₁.1 ⊓ V₂.1 from ⟨hy₁, hy₂⟩)
  let V : A.affineOpens := ⟨V', hV'⟩
  have h₁ : V.1 ≤ V₁.1 := hV'le.trans inf_le_left
  have h₂ : V.1 ≤ V₂.1 := hV'le.trans inf_le_right
  refine ⟨V, hyV', (L.eigenSubdatum n hG χ).res h₁ s₁, (L.eigenSubdatum n hG ψ).res h₂ t₂, ?_⟩
  intro W hW
  have hs₁' : IsUnit (val L n hG s₁) := hs₁
  have ht₂' : IsUnit (val L n hG t₂) := ht₂
  exact ⟨bijective_smul_of_isUnit L n hG W.1 (hb W) χ _ (isUnit_res L n hG χ hW _ (isUnit_res L n hG χ h₁ s₁ hs₁')),
    bijective_smul_of_isUnit L n hG W.1 (hb W) ψ _ (isUnit_res L n hG ψ hW _ (isUnit_res L n hG ψ h₂ t₂ ht₂')),
    bijective_smul_of_isUnit L n hG W.1 (hb W) (χ * ψ) _ (isUnit_res L n hG (χ * ψ) hW _
      (isUnit_eigenMul L n hG _ _ (isUnit_res L n hG χ h₁ s₁ hs₁') (isUnit_res L n hG ψ h₂ t₂ ht₂')))⟩

