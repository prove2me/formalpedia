theorem solution (A : Expr) (hA : TypeWf [] A) :
    (∃ t, TermWf (diagonalContext A) t (diagonalConclusion A)) ↔
      (∃ t, TermWf (uipContext A) t (uipConclusion A)) := by
  constructor
  · rintro ⟨t, ht⟩; exact S108HS.diag_to_uip hA t ht
  · rintro ⟨t, ht⟩; exact S108HS.uip_to_diag hA t ht

