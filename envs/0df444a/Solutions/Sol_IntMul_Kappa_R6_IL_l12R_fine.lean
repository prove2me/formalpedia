      have step2 : ∑ j ∈ range (Nat.digits m n).length,
          ((digit m n j : ℝ) * (K₁ * Kc' * V') * ((m : ℝ) ^ j) ^ τ +
            (m : ℝ) * ((K₂ + 1) * (((u : ℝ) + 1) ^ c₁ * X))) =
          (K₁ * Kc' * V') * ∑ j ∈ range (Nat.digits m n).length,
            (digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ +
          ((Nat.digits m n).length : ℝ) * ((m : ℝ) * ((K₂ + 1) * (((u : ℝ) + 1) ^ c₁ * X))) := by
        rw [sum_add_distrib, mul_sum, sum_const, card_range, nsmul_eq_mul]
        congr 1
        apply sum_congr rfl; intro j _; ring
      have step3 := hK'b n hn1
      have hnτ : (n : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
        Real.rpow_le_rpow (Nat.cast_nonneg _) hnu hτ0'
      have hlen : ((Nat.digits m n).length : ℝ) ≤ (u : ℝ) + 1 := by
        have := digits_len_le hm hn1
        have h' : ((Nat.digits m n).length : ℝ) ≤ n := by exact_mod_cast this
        linarith
      have hsum0 : 0 ≤ ∑ j ∈ range (Nat.digits m n).length, (digit m n j : ℝ) * ((m : ℝ) ^ j) ^ τ :=
        sum_nonneg fun j _ => by positivity
      have hZ0 : (0 : ℝ) ≤ (m : ℝ) * ((K₂ + 1) * (((u : ℝ) + 1) ^ c₁ * X)) := by positivity
      have hKK : 0 ≤ K₁ * Kc' := mul_nonneg hK₁ hKc'0
      calc (D : ℝ) ≤ _ := step1
        _ = _ := step2
        _ ≤ (K₁ * Kc' * (2 * (q : ℝ) ^ 2 * Vb)) * (K' * (u : ℝ) ^ τ) +
            ((u : ℝ) + 1) * ((m : ℝ) * ((K₂ + 1) * (((u : ℝ) + 1) ^ c₁ * X))) := by
          gcongr
          · exact le_trans step3 (mul_le_mul_of_nonneg_left hnτ hK')
        _ ≤ 4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
            (m : ℝ) * (K₂ + 1) * (((u : ℝ) + 1) ^ (c₁ + 1) * X) := by
          have h0 : (0 : ℝ) ≤ 2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ := by positivity
          have h1 : (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * Vb ≤
              (4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) := by
            have hVb0 : (0 : ℝ) ≤ Vb := Nat.cast_nonneg _
            have h5 : (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * Vb ≤
                (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) :=
              mul_le_mul_of_nonneg_left (by linarith) h0
            have h6 : 0 ≤ (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) :=
              mul_nonneg h0 (by linarith)
            have e : (4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) =
                (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) +
                (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) := by ring
            linarith
          have e1 : (K₁ * Kc' * (2 * (q : ℝ) ^ 2 * Vb)) * (K' * (u : ℝ) ^ τ) =
              (2 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * Vb := by ring
          have e2 : 4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) =
              (4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (u : ℝ) ^ τ) * (Vb + 1) := by ring
          have e3 : ((u : ℝ) + 1) * ((m : ℝ) * ((K₂ + 1) * (((u : ℝ) + 1) ^ c₁ * X))) =
              (m : ℝ) * (K₂ + 1) * (((u : ℝ) + 1) ^ (c₁ + 1) * X) := by ring
          rw [e1, e2, e3]
          linarith
  -- `Kp + 1 ≤ (Ck + 1) u^τ`
  have hKpb : (Kp : ℝ) + 1 ≤ (Ck + 1) * (u : ℝ) ^ τ := by
    have h1 := hCkb e he1
    rw [← hKp] at h1
    have h2 : (e : ℝ) ^ τ ≤ (u : ℝ) ^ τ :=
      Real.rpow_le_rpow (Nat.cast_nonneg _) (by exact_mod_cast heu) hτ0'
    have h3 : Ck * (e : ℝ) ^ τ ≤ Ck * (u : ℝ) ^ τ := mul_le_mul_of_nonneg_left h2 hCk
    have e4 : (Ck + 1) * (u : ℝ) ^ τ = Ck * (u : ℝ) ^ τ + (u : ℝ) ^ τ := by ring
    rw [e4]
    linarith
  have hlinR : (cL12F u e r Kp n Vq V' m q cO Bb : ℝ) ≤
      (Av q W' : ℝ) * (((Vb : ℝ) + 1) * ((Kp : ℝ) + 1)) + (Ao m W' : ℝ) * (X * ((u : ℝ) + 1)) +
        D := by
    have h' : ((cL12F u e r Kp n Vq V' m q cO Bb : ℕ) : ℝ) ≤
        ((Av q W' * ((Vb + 1) * (Kp + 1)) + Ao m W' * ((Bb + 2) ^ 2 * (u + 1)) + D : ℕ) : ℝ) := by
      exact_mod_cast hlin
    push_cast at h'
    rw [hX]; linarith
  have hAv : (0 : ℝ) ≤ Av q W' := Nat.cast_nonneg _
  have hAo : (0 : ℝ) ≤ Ao m W' := Nat.cast_nonneg _
  have hVb0 : (0 : ℝ) ≤ (Vb : ℝ) + 1 := by positivity
  have hP : 0 ≤ ((u : ℝ) + 1) ^ (c₁ + 1) * X := by positivity
  have hQ : 0 ≤ ((Vb : ℝ) + 1) * (u : ℝ) ^ τ := by positivity
  have hX0 : (0 : ℝ) ≤ X := by positivity
  have a1 := mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hKpb hVb0) hAv
  have a2 : (Ao m W' : ℝ) * (X * ((u : ℝ) + 1)) ≤ (Ao m W' : ℝ) * (((u : ℝ) + 1) ^ (c₁ + 1) * X) :=
    mul_le_mul_of_nonneg_left (by rw [mul_comm X]; exact mul_le_mul_of_nonneg_right hUc hX0) hAo
  have hfin : (cL12F u e r Kp n Vq V' m q cO Bb : ℝ) ≤
      A0 * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) + A1 * (((u : ℝ) + 1) ^ (c₁ + 1) * X) := by
    have e5 : A0 * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) + A1 * (((u : ℝ) + 1) ^ (c₁ + 1) * X) =
        (Av q W' : ℝ) * (((Vb : ℝ) + 1) * ((Ck + 1) * (u : ℝ) ^ τ)) +
        (Ao m W' : ℝ) * (((u : ℝ) + 1) ^ (c₁ + 1) * X) +
        (4 * (q : ℝ) ^ 2 * K₁ * Kc' * K' * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
          (m : ℝ) * (K₂ + 1) * (((u : ℝ) + 1) ^ (c₁ + 1) * X)) := by
      rw [hA0, hA1]; ring
    rw [e5]
    linarith
  have hfin2 : A0 * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) + A1 * (((u : ℝ) + 1) ^ (c₁ + 1) * X) ≤
      (A0 + A1 + 1) * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ + ((u : ℝ) + 1) ^ (c₁ + 1) * X) := by
    have e : (A0 + A1 + 1) * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ + ((u : ℝ) + 1) ^ (c₁ + 1) * X) =
        A0 * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) + A1 * (((u : ℝ) + 1) ^ (c₁ + 1) * X) +
        (A0 * (((u : ℝ) + 1) ^ (c₁ + 1) * X) + A1 * (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) +
          (((Vb : ℝ) + 1) * (u : ℝ) ^ τ) + ((u : ℝ) + 1) ^ (c₁ + 1) * X) := by ring
    have f1 := mul_nonneg hA00 hP
    have f2 := mul_nonneg hA10 hQ
    linarith
  rw [hX] at hfin hfin2
  exact le_trans hfin hfin2

