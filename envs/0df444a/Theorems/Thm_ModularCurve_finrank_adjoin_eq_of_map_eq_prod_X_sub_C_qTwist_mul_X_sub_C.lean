-- title:
--   Degree of F(x) from a twist-orbit factorisation
-- statement:
--   Let $\kappa$ be a field, $\ell$ a prime, and $\zeta$ a unit of $\kappa$ whose underlying element is a primitive $\ell$-th root of unity. For a unit $u$ of $\kappa$, [`ModularCurve.qTwist u`](def/ModularCurve_PhiGen.html#L35) denotes the ring endomorphism of the Laurent series field $\kappa((q))$ (Hahn series over $\kappa$ with value group $\mathbb{Z}$) which multiplies the coefficient of index $k$ by $u^{k}$, i.e. the substitution $q \mapsto u q$. Let $F$ be an intermediate field between $\kappa$ and $\kappa((q))$ such that `qTwist ζ` fixes every element of $F$, let $x, r \in \kappa((q))$ with $\mathrm{qTwist}(\zeta)(x) \neq x$, and let $P \in F[X]$ be a polynomial whose image under the coefficientwise map $F[X] \to \kappa((q))[X]$ factors as $$\Bigl(\prod_{k=0}^{\ell-1}\bigl(X - \mathrm{qTwist}(\zeta^{k})(x)\bigr)\Bigr)\,(X - r).$$ Then the conjunction of two assertions holds for the degree $[\,F(x):F\,]$, computed as the $F$-module rank of the intermediate field `IntermediateField.adjoin ↥F {x}` inside $\kappa((q))$: if $r \notin F$, this rank equals $\ell + 1$; and if $r \in F$, it equals $\ell$.
--
--   This is a Kummer-style degree computation for the field generated by a Laurent series over a subfield fixed by the twist $q \mapsto \zeta q$: the minimal polynomial of $x$ divides $P$ and its roots are stable under the twist, so the $\ell$-element twist orbit of $x$ occurs and only the extra factor $X - r$ can be adjoined. It is used in [`ModularCurve.finrank_adjoin_jqNModC_igusaFunctionFieldX1C_eq`](thm.html#ModularCurve.finrank_adjoin_jqNModC_igusaFunctionFieldX1C_eq) to determine the degree arising from the modular equation relating $q$-expansions of $j$ at $q$, $q^{\ell}$ and $q^{\ell^{2}}$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_ModularCurve_finrank_adjoin_eq_of_map_eq_prod_X_sub_C_qTwist_mul_X_sub_C.lean

import Mathlib
import Definitions.Def_ModularCurve_PhiGen

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open ModularCurve Polynomial

universe u

theorem ModularCurve.finrank_adjoin_eq_of_map_eq_prod_X_sub_C_qTwist_mul_X_sub_C
    (κ : Type u) [Field κ] (ℓ : ℕ) [Fact ℓ.Prime] (ζ : κˣ) (hζ : IsPrimitiveRoot (ζ : κ) ℓ)
    (F : IntermediateField κ (LaurentSeries κ))
    (hF : ∀ f : LaurentSeries κ, f ∈ F → ModularCurve.qTwist ζ f = f)
    (x r : LaurentSeries κ) (hx : ModularCurve.qTwist ζ x ≠ x)
    (P : Polynomial ↥F)
    (hP : P.map (algebraMap ↥F (LaurentSeries κ)) =
      (∏ k ∈ Finset.range ℓ, (Polynomial.X - Polynomial.C (ModularCurve.qTwist (ζ ^ k) x))) *
        (Polynomial.X - Polynomial.C r)) :
    (r ∉ F → Module.finrank ↥F ↥(IntermediateField.adjoin ↥F ({x} : Set (LaurentSeries κ))) = ℓ + 1) ∧
    (r ∈ F → Module.finrank ↥F ↥(IntermediateField.adjoin ↥F ({x} : Set (LaurentSeries κ))) = ℓ) := by sorry
