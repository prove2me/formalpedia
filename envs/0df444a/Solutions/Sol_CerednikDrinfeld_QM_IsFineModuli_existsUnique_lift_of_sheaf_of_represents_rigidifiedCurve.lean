theorem idem_trivial_away_of_primitive {S : Type} [CommRing S] (e : S) (he : IsIdempotentElem e)
    (hprim : ∀ x : S, IsIdempotentElem x → x * e = 0 ∨ x * e = e)
    (B : Type) [CommRing B] [Algebra S B] [IsLocalization.Away e B] :
    ∀ f : B, IsIdempotentElem f → f = 0 ∨ f = 1 := by
  intro f hf

  have he1 : algebraMap S B e = 1 := by
    have hu : IsUnit (algebraMap S B e) := IsLocalization.Away.algebraMap_isUnit e
    have hid : IsIdempotentElem (algebraMap S B e) := by
      show algebraMap S B e * algebraMap S B e = algebraMap S B e
      rw [← map_mul, he.eq]
    exact hu.mul_left_cancel (by rw [hid.eq, mul_one])

  obtain ⟨x, n, hx⟩ : ∃ (x : S) (n : ℕ), f * algebraMap S B e ^ n = algebraMap S B x := by
    obtain ⟨⟨x, ⟨_, n, rfl⟩⟩, h⟩ := IsLocalization.surj (Submonoid.powers e) f
    exact ⟨x, n, by simpa [map_pow] using h⟩
  rw [he1, one_pow, mul_one] at hx

  have hxx : algebraMap S B (x * x - x) = 0 := by
    rw [map_sub, map_mul, ← hx, hf.eq, sub_self]
  obtain ⟨⟨_, k, rfl⟩, hk⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers e) B _).1 hxx
  simp only at hk

  have hek : e ^ k * e = e := by
    cases k with
    | zero => simp
    | succ k => rw [← pow_succ, he.pow_succ_eq]
  have hxe : IsIdempotentElem (x * e) := by
    show x * e * (x * e) = x * e
    have h0 : e ^ k * (x * x - x) = 0 := hk
    have : (x * x - x) * e = 0 := by
      calc (x * x - x) * e = (x * x - x) * (e ^ k * e) := by rw [hek]
        _ = (e ^ k * (x * x - x)) * e := by ring
        _ = 0 := by rw [h0, zero_mul]
    have : x * x * e = x * e := by
      have := sub_eq_zero.1 (by rw [← sub_mul] ; exact this : x * x * e - x * e = 0)
      exact this
    calc x * e * (x * e) = x * x * (e * e) := by ring
      _ = x * x * e := by rw [he.eq]
      _ = x * e := this
  have hfxe : f = algebraMap S B (x * e) := by rw [map_mul, he1, mul_one, hx]
  rcases hprim (x * e) hxe with h | h
  · left
    rw [hfxe, show x * e = x * e * e by rw [mul_assoc, he.eq], h, map_zero]
  · right
    rw [hfxe, show x * e = x * e * e by rw [mul_assoc, he.eq], h, he1]

theorem isUnit_natCast_of_isNilpotent {S : Type} [CommRing S] {r n : ℕ} (hr : r.Prime) (hrn : ¬ r ∣ n)
    (hnil : IsNilpotent ((r : ℕ) : S)) : IsUnit ((n : ℕ) : S) := by
  have hcop : Nat.Coprime n r := (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hr).2 hrn))
  obtain ⟨u, v, huv⟩ := Nat.isCoprime_iff_coprime.2 hcop
  have h1 : ((u : ℤ) : S) * (n : ℕ) = 1 - ((v : ℤ) : S) * (r : ℕ) := by
    have := congrArg (fun z : ℤ => (z : S)) huv
    simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, Int.cast_one] at this
    linear_combination this
  have hu : IsUnit (1 - ((v : ℤ) : S) * (r : ℕ)) := by
    apply IsNilpotent.isUnit_one_sub
    exact Commute.isNilpotent_mul_left (Commute.all _ _) hnil
  rw [← h1] at hu
  exact isUnit_of_mul_isUnit_right hu

theorem isNilpotent_natCast_of_span_eq {𝒪 : Type} [CommRing 𝒪] (π : 𝒪) (r : ℕ)
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π})
    {B : Type} [CommRing B] [Algebra 𝒪 B] (hB : IsNilpotent (algebraMap 𝒪 B π)) :
    IsNilpotent ((r : ℕ) : B) := by
  have hr : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := hunr ▸ Ideal.subset_span rfl
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 hr
  have : ((r : ℕ) : B) = algebraMap 𝒪 B a * algebraMap 𝒪 B π := by
    rw [← map_mul, ha, map_natCast]
  rw [this]
  exact Commute.isNilpotent_mul_left (Commute.all _ _) hB

theorem isNilpotent_natCast_quotient {𝒪 : Type} [CommRing 𝒪] (π : 𝒪) (r : ℕ)
    (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π}) (B : Type) [CommRing B] [Algebra 𝒪 B] :
    IsNilpotent ((r : ℕ) : B ⧸ Ideal.span {algebraMap 𝒪 B π}) := by
  have hr : ((r : ℕ) : 𝒪) ∈ Ideal.span {π} := hunr ▸ Ideal.subset_span rfl
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.1 hr
  have h1 : ((r : ℕ) : B ⧸ Ideal.span {algebraMap 𝒪 B π}) =
      Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 B π}) (algebraMap 𝒪 B a * algebraMap 𝒪 B π) := by
    rw [← map_mul, ha, map_natCast, map_natCast]
  have h2 : Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 B π}) (algebraMap 𝒪 B π) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  rw [h1, map_mul, h2, mul_zero]
  exact IsNilpotent.zero

theorem idem_trivial_of_surjective_sq {S S₀ : Type} [CommRing S] [CommRing S₀] (p : S →+* S₀)
    (hp : Function.Surjective p) (hsq : ∀ s t : S, p s = 0 → p t = 0 → s * t = 0)
    (hconn : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1) :
    ∀ e : S₀, IsIdempotentElem e → e = 0 ∨ e = 1 := by
  intro e he
  have hker : ∀ x ∈ RingHom.ker p, IsNilpotent x := fun x hx =>
    ⟨2, by rw [pow_two]; exact hsq x x ((RingHom.mem_ker).1 hx) ((RingHom.mem_ker).1 hx)⟩
  obtain ⟨e', he', rfl⟩ := exists_isIdempotentElem_eq_of_ker_isNilpotent p hker e (hp e) he
  rcases hconn e' he' with h | h
  · left; rw [h, map_zero]
  · right; rw [h, map_one]

theorem existsUnique_lift_of_R
    {r N : ℕ} [Fact r.Prime] [NeZero N] (hrN : ¬ r ∣ N) {rbar : ℕ} [Fact rbar.Prime] (hrr : rbar ≠ r)

    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π}) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (hBq : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)

    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))

    (n : ℕ) (hn : 3 ≤ n) (hrn : ¬ r ∣ n) (M : Scheme.{0}) (fM : M ⟶ Spec (CommRingCat.of 𝒪))
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N n S → SchemeHomOver s fM)
    (hM : IsFineModuli Λ N n M fM ptF)

    (C : Type) [CommRing C] [IsNoetherianRing C] [Algebra 𝒪 C] (hC : IsNilpotent (algebraMap 𝒪 C π)) (ψ : Onr →ₐ[𝒪] C)
    (PR : CerednikDrinfeld.FormalOmega.AlgFunctor C)
    (ptR : ∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
      (ψS : Onr →ₐ[𝒪] S) (_ : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
      (u : FakeEllipticCurve.WithFullLevel Λ N n S), FakeEllipticCurve.Rigidification r π A₀ ψS u.1 → PR.obj S)
    (toM : ∀ (S : Type) [CommRing S] [Algebra C S],
      PR.obj S → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))))
    (hR1 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1)
          (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f),
          FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi →
          (∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩) →
            ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ'))
    (hR2 :
      (∀ (S S' : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          [CommRing S'] [Algebra C S'] [Algebra 𝒪 S'] [IsScalarTower 𝒪 C S'] (φ : S →ₐ[C] S')
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hψS' : (φ.restrictScalars 𝒪).comp ψS = (IsScalarTower.toAlgHom 𝒪 C S').comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (u' : FakeEllipticCurve.WithFullLevel Λ N n S')
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1)
          (ρ' : FakeEllipticCurve.Rigidification r π A₀ ((φ.restrictScalars 𝒪).comp ψS) u'.1)
          (g : u'.1.A ⟶ u.1.A) (hg : FakeEllipticCurve.IsPullbackVia (φ : S →+* S') u.1 u'.1 g),
          (u'.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (u.2.P).1 →
          FakeEllipticCurve.Rigidification.IsPullbackVia (φ.restrictScalars 𝒪) g hg ρ ρ' →
            PR.map φ (ptR S ψS hψS u ρ) = ptR S' ((φ.restrictScalars 𝒪).comp ψS) hψS' u' ρ'))
    (hR3s :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ) (z : PR.obj S),
          ∃ (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1), ptR S ψS hψS u ρ = z))
    (hR3i :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hSc : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1),
          ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ' →
            ∃ (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi ∧
              ∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩))
    (hR4 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1),
          (toM S (ptR S ψS hψS u ρ)).1 ≫ Limits.pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
            (ptF S (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S))) u).1)) :
    ∀ (S S₀ : Type) [CommRing S] [IsNoetherianRing S] [Algebra C S] [CommRing S₀] [Algebra C S₀] (p : S →ₐ[C] S₀),
      Function.Surjective p → RingHom.ker (p : S →+* S₀) ^ 2 = ⊥ →
      (∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1) →
      ∀ (x₀ : PR.obj S₀) (t : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))),
      Spec.map (CommRingCat.ofHom (p : S →+* S₀)) ≫ t.1 = (toM S₀ x₀).1 →
      ∃! x : PR.obj S, PR.map p x = x₀ ∧ toM S x = t := by
  intro S S₀ _ _ _ _ _ p hp hp2 hSc x₀ t ht
  classical

  letI algS : Algebra 𝒪 S := ((algebraMap C S).comp (algebraMap 𝒪 C)).toAlgebra
  haveI towS : IsScalarTower 𝒪 C S := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI algS₀ : Algebra 𝒪 S₀ := ((algebraMap C S₀).comp (algebraMap 𝒪 C)).toAlgebra
  haveI towS₀ : IsScalarTower 𝒪 C S₀ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsNoetherianRing S₀ := isNoetherianRing_of_surjective S S₀ p hp
  let ψS : Onr →ₐ[𝒪] S := (IsScalarTower.toAlgHom 𝒪 C S).comp ψ
  let ψS₀ : Onr →ₐ[𝒪] S₀ := (p.restrictScalars 𝒪).comp ψS
  have hψS₀ : ψS₀ = (IsScalarTower.toAlgHom 𝒪 C S₀).comp ψ := by
    apply AlgHom.ext; intro x
    show p (algebraMap C S (ψ x)) = algebraMap C S₀ (ψ x)
    exact p.commutes _

  let sC : Spec (CommRingCat.of C) ⟶ Spec (CommRingCat.of 𝒪) := Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))
  let sS : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪) := Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S))
  let sS₀ : Spec (CommRingCat.of S₀) ⟶ Spec (CommRingCat.of 𝒪) := Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S₀))
  have hpss : Spec.map (CommRingCat.ofHom (p : S →+* S₀)) ≫ sS = sS₀ := by
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
    ext x
    show p (algebraMap C S (algebraMap 𝒪 C x)) = algebraMap C S₀ (algebraMap 𝒪 C x)
    exact p.commutes _

  obtain ⟨u₀, ρ₀, hx₀⟩ := hR3s S₀ ψS₀ hψS₀ x₀

  have htF : (t.1 ≫ pullback.fst fM sC) ≫ fM = sS := by
    rw [Category.assoc, pullback.condition, ← Category.assoc, t.2]
    show Spec.map _ ≫ Spec.map _ = Spec.map _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  obtain ⟨u, hu⟩ := hM.ptF_surjective S sS ⟨t.1 ≫ pullback.fst fM sC, htF⟩

  obtain ⟨E₀', g', hpb, hmul, hact, hlev, -⟩ := FakeEllipticCurve.exists_isPullback_levelIff (p : S →+* S₀) u.1
  have hg' : FakeEllipticCurve.IsPullbackVia (p : S →+* S₀) u.1 E₀' g' := ⟨hpb, hmul, hact, hlev⟩
  obtain ⟨L₀', hL₀'⟩ := FakeEllipticCurve.FullLevel.exists_comp_eq_specMap_comp_of_isPullbackVia n (p : S →+* S₀) u.1 E₀' g' hg' u.2

  have hpt0 : (ptF S₀ sS₀ ⟨E₀', L₀'⟩).1 = Spec.map (CommRingCat.ofHom (p : S →+* S₀)) ≫ (ptF S sS u).1 :=
    hM.ptF_pullback S S₀ (p : S →+* S₀) sS sS₀ hpss u ⟨E₀', L₀'⟩ ⟨g', hpb, hmul, hact, hlev, hL₀'⟩
  have hR4' := hR4 S₀ ψS₀ hψS₀ u₀ ρ₀
  have hEq : ptF S₀ sS₀ u₀ = ptF S₀ sS₀ ⟨E₀', L₀'⟩ := by
    apply Subtype.ext
    rw [hpt0, hu, ← hR4', hx₀, ← ht]
    rfl
  obtain ⟨e, he, hvia⟩ := hM.ptF_injective S₀ sS₀ u₀ ⟨E₀', L₀'⟩ hEq

  obtain ⟨ρ₀E, ib0, hib0g, hib0f, uA0, huA0, huA0g, i0, j0, hc0⟩ :=
    FakeEllipticCurve.Rigidification.exists_corr_of_isoVia hΛℤ ρ₀ e he ⟨hvia.1, hvia.2.1, hvia.2.2.1⟩
  have hpt1 : ptR S₀ ψS₀ hψS₀ u₀ ρ₀ = ptR S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ρ₀E :=
    hR1 S₀ ψS₀ hψS₀ u₀ ⟨E₀', L₀'⟩ ρ₀ ρ₀E e he hvia ⟨ib0, hib0g, hib0f, uA0, huA0, huA0g, i0, j0, hc0⟩

  obtain ⟨⟨ρ, ρ₀', hϱ, ib, hibg, hibf, uA, huA, huAg, i₁, j₁, hcorr⟩, -⟩ :=
    FakeEllipticCurve.Rigidification.exists_lift_corr_and_equiv_of_isPullbackVia_corr_of_ker_sq_eq_bot hrN 𝒪 π hunr Onr Λ hΛℤ
      coord hcoord A₀ n hn hrn M fM ptF hM C hC ψ S S₀ p hp hp2 ψS rfl u ⟨E₀', L₀'⟩ g' hg' hL₀' ρ₀E

  have isoVia_refl : ∀ (w : FakeEllipticCurve.WithFullLevel Λ N n S₀),
      FakeEllipticCurve.WithFullLevel.IsoVia w w (Iso.refl w.1.A) (by simp) := by
    intro w
    have hmp : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S₀)) (P : SchemeHomOver t w.1.f),
        mapPt (Iso.refl w.1.A).hom (by simp) P = P := by
      intro T t P; apply Subtype.ext; simp [mapPt_coe]
    refine ⟨fun t P Q => by rw [hmp, hmp, hmp], fun x => by simp, fun t P => by rw [hmp], hmp _ _⟩
  have hpt2 : ptR S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ρ₀E = ptR S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ρ₀' :=
    hR1 S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ⟨E₀', L₀'⟩ ρ₀E ρ₀' (Iso.refl _) (by simp) (isoVia_refl _)
      ⟨ib, hibg, hibf, uA, huA, huAg, i₁, j₁, hcorr⟩

  have isoVia_reflS : ∀ (w : FakeEllipticCurve.WithFullLevel Λ N n S),
      FakeEllipticCurve.WithFullLevel.IsoVia w w (Iso.refl w.1.A) (by simp) := by
    intro w
    have hmp : ∀ {T : Scheme.{0}} (t : T ⟶ Spec (CommRingCat.of S)) (P : SchemeHomOver t w.1.f),
        mapPt (Iso.refl w.1.A).hom (by simp) P = P := by
      intro T t P; apply Subtype.ext; simp [mapPt_coe]
    refine ⟨fun t P Q => by rw [hmp, hmp, hmp], fun x => by simp, fun t P => by rw [hmp], hmp _ _⟩

  have hmap : PR.map p (ptR S ψS rfl u ρ) = x₀ := by
    rw [hR2 S S₀ p ψS rfl hψS₀ u ⟨E₀', L₀'⟩ ρ ρ₀' g' hg' hL₀' hϱ, ← hx₀, hpt1, hpt2]
  have htoM : toM S (ptR S ψS rfl u ρ) = t := by
    apply Subtype.ext
    apply pullback.hom_ext
    · rw [hR4 S ψS rfl u ρ, hu]
    · rw [(toM S _).2, t.2]
  refine ⟨ptR S ψS rfl u ρ, ⟨hmap, htoM⟩, ?_⟩
  ·

    intro x' hx'
    obtain ⟨hx'1, hx'2⟩ := hx'

    obtain ⟨u', ρ', hx'⟩ := hR3s S ψS rfl x'

    have hEq' : ptF S sS u' = ptF S sS u := by
      apply Subtype.ext
      rw [← hR4 S ψS rfl u' ρ', ← hR4 S ψS rfl u ρ, hx', hx'2, htoM]
    obtain ⟨i', hi', hvia'⟩ := hM.ptF_injective S sS u' u hEq'
    obtain ⟨ρ'', ib', hib'g, hib'f, uA', huA', huA'g, i₃, j₃, hc'⟩ :=
      FakeEllipticCurve.Rigidification.exists_corr_of_isoVia hΛℤ ρ' i' hi' ⟨hvia'.1, hvia'.2.1, hvia'.2.2.1⟩
    have hpt3 : ptR S ψS rfl u' ρ' = ptR S ψS rfl u ρ'' :=
      hR1 S ψS rfl u' u ρ' ρ'' i' hi' hvia' ⟨ib', hib'g, hib'f, uA', huA', huA'g, i₃, j₃, hc'⟩

    obtain ⟨ρ₀'', hϱ''⟩ := FakeEllipticCurve.Rigidification.exists_isPullbackVia_of_isPullbackVia 𝒪 π Onr Λ A₀ S S₀
      (p.restrictScalars 𝒪) ψS u.1 E₀' g' hg' ρ''

    have hm'' : ptR S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ρ₀' = ptR S₀ ψS₀ hψS₀ ⟨E₀', L₀'⟩ ρ₀'' := by
      rw [← hR2 S S₀ p ψS rfl hψS₀ u ⟨E₀', L₀'⟩ ρ'' ρ₀'' g' hg' hL₀' hϱ'',
        ← hR2 S S₀ p ψS rfl hψS₀ u ⟨E₀', L₀'⟩ ρ ρ₀' g' hg' hL₀' hϱ, ← hpt3, hx', hx'1, hmap]

    have hp2' : ∀ s t : S, (p : S →+* S₀) s = 0 → (p : S →+* S₀) t = 0 → s * t = 0 := by
      intro s t hs ht
      have hst : s * t ∈ RingHom.ker (p : S →+* S₀) ^ 2 := by rw [pow_two]; exact Ideal.mul_mem_mul hs ht
      rw [hp2] at hst
      exact (Submodule.mem_bot _).mp hst
    have hSc₀ : ∀ e : S₀, IsIdempotentElem e → e = 0 ∨ e = 1 := idem_trivial_of_surjective_sq (p : S →+* S₀) hp hp2' hSc

    obtain ⟨j, hj, hviaj, ibj, hibjg, hibjf, uAj, huAj, huAjg, i₂, j₂, hcj⟩ :=
      hR3i S₀ ψS₀ hψS₀ hSc₀ ⟨E₀', L₀'⟩ ⟨E₀', L₀'⟩ ρ₀' ρ₀'' hm''

    have hnS₀ : IsUnit ((n : ℕ) : S₀) :=
      isUnit_natCast_of_isNilpotent (Fact.out) hrn (isNilpotent_natCast_of_span_eq π r hunr
        (show IsNilpotent (algebraMap 𝒪 S₀ π) from by
          have := IsNilpotent.map hC (algebraMap C S₀)
          exact this))
    have hjr : j = Iso.refl _ :=
      FakeEllipticCurve.WithFullLevel.eq_refl_of_mapPt_eq_of_three_le hrr hBq Λ hΛ hn hnS₀ ⟨E₀', L₀'⟩ j hj
        hviaj.1 hviaj.2.1 hviaj.2.2.2
    subst hjr

    obtain ⟨-, huniq⟩ :=
      FakeEllipticCurve.Rigidification.exists_lift_corr_and_equiv_of_isPullbackVia_corr_of_ker_sq_eq_bot hrN 𝒪 π hunr Onr Λ hΛℤ
        coord hcoord A₀ n hn hrn M fM ptF hM C hC ψ S S₀ p hp hp2 ψS rfl u ⟨E₀', L₀'⟩ g' hg' hL₀' ρ₀'
    have heq : FakeEllipticCurve.Rigidification.Equiv hΛℤ ρ ρ'' := by
      refine huniq ρ ρ'' ρ₀' ρ₀'' hϱ hϱ'' ?_ ⟨ibj, hibjg, hibjf, uAj, huAj, huAjg, i₂, j₂, hcj⟩
      refine ⟨𝟙 _, by simp, by simp, 𝟙 _, ?_, by simp, 0, 0, by simp⟩
      simpa using FakeEllipticCurve.isPullbackVia_id _ ρ₀'.Ab

    obtain ⟨uc, uAc, ⟨huc, hucg, huAc, huAcg⟩, i₄, j₄, hc4⟩ := heq
    have hNb : IsUnit ((N : ℕ) : S ⧸ Ideal.span {algebraMap 𝒪 S π}) :=
      isUnit_natCast_of_isNilpotent (Fact.out) hrN (isNilpotent_natCast_quotient π r hunr S)
    obtain ⟨w, hwg, hwf, hw⟩ :=
      FakeEllipticCurve.exists_isPullbackVia_id_comp_eq_of_isPullbackVia_of_isPullbackVia_of_isUnit
        _ hNb A₀ ρ''.Ab ρ''.gA ρ''.isPullback_Ab ρ.Ab ρ.gA ρ.isPullback_Ab
    obtain ⟨huAcpb, -, -, -⟩ := id huAc
    obtain ⟨hpbA'', -, -, -⟩ := id ρ''.isPullback_Ab
    have huAcw : uAc ≫ w = 𝟙 _ := by
      apply hpbA''.hom_ext
      · rw [Category.assoc, hwg, huAcg, Category.id_comp]
      · rw [Category.assoc, hwf, Category.id_comp]
        have := huAcpb.w
        simp only [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id] at this
        exact this
    obtain ⟨hwpb, hwmul, hwact, hwlev⟩ := hw
    have hucf : uc ≫ ρ.Eb.f = ρ''.Eb.f := by
      obtain ⟨hucpb, -, -, -⟩ := huc
      have := hucpb.w
      simp only [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id] at this
      exact this
    have hpt4 : ptR S ψS rfl u ρ'' = ptR S ψS rfl u ρ := by
      refine hR1 S ψS rfl u u ρ'' ρ (Iso.refl _) (by simp) (isoVia_reflS u)
        ⟨uc, by simpa using hucg, hucf, w, ⟨hwpb, hwmul, hwact, hwlev⟩, hwg, i₄, j₄, ?_⟩

      have e := congrArg (· ≫ w) hc4
      simp only [Category.assoc] at e
      rw [hwact, hwact, ← Category.assoc uAc w, huAcw, Category.id_comp] at e
      exact e
    rw [← hx', hpt3, hpt4]

theorem subsingleton_of_sh
    (C : Type) [CommRing C] (PR : CerednikDrinfeld.FormalOmega.AlgFunctor C)
    (hsh :
      (∀ (A : Type) [CommRing A] [Algebra C A] (n : ℕ) (f : Fin n → A),
        Ideal.span (Set.range f) = ⊤ →
        ∀ (B : Fin n → Type) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] [∀ i, Algebra C (B i)]
          [∀ i, IsScalarTower C A (B i)] [∀ i, IsLocalization.Away (f i) (B i)] (s : ∀ i, PR.obj (B i)),
        (∀ (i j : Fin n) (D : Type) [CommRing D] [Algebra A D] [Algebra C D] [IsScalarTower C A D]
            [IsLocalization.Away (f i * f j) D] (ρ₁ : B i →ₐ[A] D) (ρ₂ : B j →ₐ[A] D),
            PR.map (ρ₁.restrictScalars C) (s i) = PR.map (ρ₂.restrictScalars C) (s j)) →
        ∃! s₀ : PR.obj A, ∀ i, PR.map (IsScalarTower.toAlgHom C A (B i)) s₀ = s i))
    (D : Type) [CommRing D] [Algebra C D] [Subsingleton D] (a b : PR.obj D) : a = b := by
  have hsp : Ideal.span (Set.range (Fin.elim0 : Fin 0 → D)) = ⊤ :=
    eq_top_iff.2 fun x _ => by rw [Subsingleton.elim x 0]; exact Ideal.zero_mem _
  obtain ⟨s, -, hu⟩ := @hsh D _ _ 0 Fin.elim0 hsp (fun _ => D) (fun _ => inferInstance) (fun _ => inferInstance)
    (fun _ => inferInstance) (fun _ => inferInstance) (fun i => i.elim0) (fun i => i.elim0) (fun i => i.elim0)
  rw [hu a (fun i => i.elim0), hu b (fun i => i.elim0)]

theorem existsUnique_lift_of_R_sh
    {r N : ℕ} [Fact r.Prime] [NeZero N] (hrN : ¬ r ∣ N) {rbar : ℕ} [Fact rbar.Prime] (hrr : rbar ≠ r)

    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π}) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (hBq : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)

    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))

    (n : ℕ) (hn : 3 ≤ n) (hrn : ¬ r ∣ n) (M : Scheme.{0}) (fM : M ⟶ Spec (CommRingCat.of 𝒪))
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N n S → SchemeHomOver s fM)
    (hM : IsFineModuli Λ N n M fM ptF)

    (C : Type) [CommRing C] [IsNoetherianRing C] [Algebra 𝒪 C] (hC : IsNilpotent (algebraMap 𝒪 C π)) (ψ : Onr →ₐ[𝒪] C)
    (PR : CerednikDrinfeld.FormalOmega.AlgFunctor C)
    (ptR : ∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
      (ψS : Onr →ₐ[𝒪] S) (_ : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
      (u : FakeEllipticCurve.WithFullLevel Λ N n S), FakeEllipticCurve.Rigidification r π A₀ ψS u.1 → PR.obj S)
    (toM : ∀ (S : Type) [CommRing S] [Algebra C S],
      PR.obj S → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))))
    (hsh :
      (∀ (A : Type) [CommRing A] [Algebra C A] (n : ℕ) (f : Fin n → A),
        Ideal.span (Set.range f) = ⊤ →
        ∀ (B : Fin n → Type) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] [∀ i, Algebra C (B i)]
          [∀ i, IsScalarTower C A (B i)] [∀ i, IsLocalization.Away (f i) (B i)] (s : ∀ i, PR.obj (B i)),
        (∀ (i j : Fin n) (D : Type) [CommRing D] [Algebra A D] [Algebra C D] [IsScalarTower C A D]
            [IsLocalization.Away (f i * f j) D] (ρ₁ : B i →ₐ[A] D) (ρ₂ : B j →ₐ[A] D),
            PR.map (ρ₁.restrictScalars C) (s i) = PR.map (ρ₂.restrictScalars C) (s j)) →
        ∃! s₀ : PR.obj A, ∀ i, PR.map (IsScalarTower.toAlgHom C A (B i)) s₀ = s i))
    (hR0 :
      (∀ (S S' : Type) [CommRing S] [Algebra C S] [CommRing S'] [Algebra C S'] (φ : S →ₐ[C] S') (x : PR.obj S),
          (toM S' (PR.map φ x)).1 = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (toM S x).1))
    (hR1 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1)
          (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f),
          FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi →
          (∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩) →
            ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ'))
    (hR2 :
      (∀ (S S' : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          [CommRing S'] [Algebra C S'] [Algebra 𝒪 S'] [IsScalarTower 𝒪 C S'] (φ : S →ₐ[C] S')
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hψS' : (φ.restrictScalars 𝒪).comp ψS = (IsScalarTower.toAlgHom 𝒪 C S').comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (u' : FakeEllipticCurve.WithFullLevel Λ N n S')
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1)
          (ρ' : FakeEllipticCurve.Rigidification r π A₀ ((φ.restrictScalars 𝒪).comp ψS) u'.1)
          (g : u'.1.A ⟶ u.1.A) (hg : FakeEllipticCurve.IsPullbackVia (φ : S →+* S') u.1 u'.1 g),
          (u'.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (u.2.P).1 →
          FakeEllipticCurve.Rigidification.IsPullbackVia (φ.restrictScalars 𝒪) g hg ρ ρ' →
            PR.map φ (ptR S ψS hψS u ρ) = ptR S' ((φ.restrictScalars 𝒪).comp ψS) hψS' u' ρ'))
    (hR3s :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ) (z : PR.obj S),
          ∃ (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1), ptR S ψS hψS u ρ = z))
    (hR3i :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hSc : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1),
          ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ' →
            ∃ (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi ∧
              ∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩))
    (hR4 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1),
          (toM S (ptR S ψS hψS u ρ)).1 ≫ Limits.pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
            (ptF S (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S))) u).1)) :
    ∀ (S S₀ : Type) [CommRing S] [IsNoetherianRing S] [Algebra C S] [CommRing S₀] [Algebra C S₀] (p : S →ₐ[C] S₀),
      Function.Surjective p → RingHom.ker (p : S →+* S₀) ^ 2 = ⊥ →
      ∀ (x₀ : PR.obj S₀) (t : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))),
      Spec.map (CommRingCat.ofHom (p : S →+* S₀)) ≫ t.1 = (toM S₀ x₀).1 →
      ∃! x : PR.obj S, PR.map p x = x₀ ∧ toM S x = t := by
  intro S S₀ _ _ _ _ _ p hp hp2 x₀ t ht
  classical
  have G := existsUnique_lift_of_R hrN hrr 𝒪 π hunr Onr hBq Λ hΛ hΛℤ coord hcoord A₀ n hn hrn M fM ptF hM C hC ψ
    PR ptR toM hR1 hR2 hR3s hR3i hR4
  let sC : Spec (CommRingCat.of C) ⟶ Spec (CommRingCat.of 𝒪) := Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))
  have hp2' : ∀ s t : S, p s = 0 → p t = 0 → s * t = 0 := by
    intro s t hs ht
    have hst : s * t ∈ RingHom.ker (p : S →+* S₀) ^ 2 := by rw [pow_two]; exact Ideal.mul_mem_mul hs ht
    rw [hp2] at hst
    exact (Submodule.mem_bot _).mp hst

  obtain ⟨m, e, hce, hprim⟩ := IsNoetherianRing.exists_completeOrthogonalIdempotents_forall_mul_eq_zero_or_eq S
  let pk : ∀ k : Fin m, Localization.Away (e k) →ₐ[C] Localization.Away (p (e k)) := fun k => ETEGlue.locRed p (e k)
  let ι : ∀ k : Fin m, S →ₐ[C] Localization.Away (e k) := fun k => IsScalarTower.toAlgHom C S _
  let ι₀ : ∀ k : Fin m, S₀ →ₐ[C] Localization.Away (p (e k)) := fun k => IsScalarTower.toAlgHom C S₀ _
  have hpk : ∀ k, (pk k).comp (ι k) = (ι₀ k).comp p := fun k => ETEGlue.locRed_comp_toAlgHom p (e k)
  have hpk' : ∀ k, ((pk k : Localization.Away (e k) →ₐ[C] Localization.Away (p (e k))) :
      Localization.Away (e k) →+* Localization.Away (p (e k))).comp (algebraMap S (Localization.Away (e k))) =
      (algebraMap S₀ (Localization.Away (p (e k)))).comp (p : S →+* S₀) := by
    intro k
    have := congrArg (fun φ : S →ₐ[C] Localization.Away (p (e k)) => (φ : S →+* Localization.Away (p (e k)))) (hpk k)
    exact this

  let tk : ∀ k : Fin m, SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C (Localization.Away (e k)))))
      (Limits.pullback.snd fM sC) := fun k =>
    ⟨Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (e k)))) ≫ t.1, by
      rw [Category.assoc, t.2, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]⟩
  have htk : ∀ k, (tk k).1 = Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (e k)))) ≫ t.1 := fun k => rfl
  have Hk : ∀ k : Fin m, ∃! x : PR.obj (Localization.Away (e k)),
      PR.map (pk k) x = PR.map (ι₀ k) x₀ ∧ toM _ x = tk k := by
    intro k
    haveI : IsNoetherianRing (Localization.Away (e k)) :=
      IsLocalization.isNoetherianRing (Submonoid.powers (e k)) _ inferInstance
    refine G _ _ (pk k) (ETEGlue.locRed_surjective p hp (e k)) ?_
      (idem_trivial_away_of_primitive (e k) (hce.idem k) (hprim k).2 _) (PR.map (ι₀ k) x₀) (tk k) ?_
    · rw [pow_two, ← le_bot_iff, Ideal.mul_le]
      intro s hs s' hs'
      rw [ETEGlue.locRed_sq p hp2' (e k) s s' hs hs']
      exact Ideal.zero_mem _
    · rw [hR0, htk, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hpk', CommRingCat.ofHom_comp,
        Spec.map_comp, Category.assoc, ht]
      rfl
  choose xk hxk hxku using Hk

  have hspan : Ideal.span (Set.range e) = ⊤ :=
    (Ideal.eq_top_iff_one _).2 (hce.complete ▸ Ideal.sum_mem _ (fun k _ => Ideal.subset_span ⟨k, rfl⟩))
  have hspan₀ : Ideal.span (Set.range (fun k => p (e k))) = ⊤ := by
    refine (Ideal.eq_top_iff_one _).2 ?_
    have : (∑ k, p (e k)) = 1 := by rw [← map_sum, hce.complete, map_one]
    exact this ▸ Ideal.sum_mem _ (fun k _ => Ideal.subset_span ⟨k, rfl⟩)

  have hcompat : ∀ (i j : Fin m) (D : Type) [CommRing D] [Algebra S D] [Algebra C D] [IsScalarTower C S D]
      [IsLocalization.Away (e i * e j) D] (ρ₁ : Localization.Away (e i) →ₐ[S] D) (ρ₂ : Localization.Away (e j) →ₐ[S] D),
      PR.map (ρ₁.restrictScalars C) (xk i) = PR.map (ρ₂.restrictScalars C) (xk j) := by
    intro i j D _ _ _ _ _ ρ₁ ρ₂
    by_cases hij : i = j
    · subst hij
      have : ρ₁ = ρ₂ := (IsLocalization.algHom_subsingleton (Submonoid.powers (e i))).elim _ _
      rw [this]
    · have h0 : e i * e j = 0 := hce.ortho hij
      haveI : Subsingleton D :=
        (IsLocalization.uniqueOfZeroMem (S := D) (M := Submonoid.powers (e i * e j)) ⟨1, by simp [h0]⟩).instSubsingleton
      exact subsingleton_of_sh C PR hsh D _ _
  obtain ⟨s₀, hs₀, hs₀u⟩ := hsh S m e hspan (fun k => Localization.Away (e k)) xk hcompat
  refine ⟨s₀, ⟨?_, ?_⟩, ?_⟩
  ·
    have hc0 : ∀ (i j : Fin m) (D : Type) [CommRing D] [Algebra S₀ D] [Algebra C D] [IsScalarTower C S₀ D]
        [IsLocalization.Away (p (e i) * p (e j)) D]
        (ρ₁ : Localization.Away (p (e i)) →ₐ[S₀] D) (ρ₂ : Localization.Away (p (e j)) →ₐ[S₀] D),
        PR.map (ρ₁.restrictScalars C) (PR.map (ι₀ i) x₀) = PR.map (ρ₂.restrictScalars C) (PR.map (ι₀ j) x₀) := by
      intro i j D _ _ _ _ _ ρ₁ ρ₂
      rw [← PR.map_comp, ← PR.map_comp]
      congr 1
      apply AlgHom.ext; intro a
      show ρ₁ (algebraMap S₀ _ a) = ρ₂ (algebraMap S₀ _ a)
      rw [ρ₁.commutes, ρ₂.commutes]
    obtain ⟨y, -, hyu⟩ := hsh S₀ m (fun k => p (e k)) hspan₀ (fun k => Localization.Away (p (e k)))
      (fun k => PR.map (ι₀ k) x₀) hc0
    have h1 : PR.map p s₀ = y := hyu _ (fun k => by
      show PR.map (ι₀ k) (PR.map p s₀) = PR.map (ι₀ k) x₀
      rw [← PR.map_comp, ← hpk k, PR.map_comp]
      show PR.map (pk k) (PR.map (ι k) s₀) = _
      rw [hs₀ k, (hxk k).1])
    have h2 : x₀ = y := hyu _ (fun k => rfl)
    rw [h1, ← h2]
  ·
    apply Subtype.ext
    refine (Scheme.affineOpenCoverOfSpanRangeEqTop (R := CommRingCat.of S) e hspan).openCover.hom_ext _ _ (fun k => ?_)
    show Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (e k)))) ≫ (toM S s₀).1 =
      Spec.map (CommRingCat.ofHom (algebraMap S (Localization.Away (e k)))) ≫ t.1
    have := hR0 S _ (ι k) s₀
    rw [hs₀ k, (hxk k).2, htk] at this
    exact this.symm
  ·
    intro x' hx'
    obtain ⟨hx'1, hx'2⟩ := hx'
    apply hs₀u
    intro k
    apply hxku k
    refine ⟨?_, ?_⟩
    · show PR.map (pk k) (PR.map (ι k) x') = PR.map (ι₀ k) x₀
      rw [← PR.map_comp, hpk k, PR.map_comp, hx'1]
    · apply Subtype.ext
      rw [hR0, hx'2]
      rfl

end ETBlock

theorem solution
    {r N : ℕ} [Fact r.Prime] [NeZero N] (hrN : ¬ r ∣ N) {rbar : ℕ} [Fact rbar.Prime] (hrr : rbar ≠ r)

    (𝒪 : Type) [CommRing 𝒪] (π : 𝒪) (hunr : Ideal.span {((r : ℕ) : 𝒪)} = Ideal.span {π}) (Onr : Type) [CommRing Onr] [Algebra 𝒪 Onr]
    {a b : ℚ} (hBq : IsIndefiniteRamifiedExactlyAt a b r rbar)
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) (hΛℤ : ∀ m : ℤ, ((m : ℚ) : ℍ[ℚ, a, b]) ∈ Λ)

    (coord : ↥Λ → Zp2 r × Zp2 r) (hcoord : IsOrderCoord Λ r coord)
    (A₀ : FakeEllipticCurve Λ N (Onr ⧸ Ideal.span {algebraMap 𝒪 Onr π}))

    (n : ℕ) (hn : 3 ≤ n) (hrn : ¬ r ∣ n) (M : Scheme.{0}) (fM : M ⟶ Spec (CommRingCat.of 𝒪))
    (ptF : ∀ (S : Type) [CommRing S] (s : Spec (CommRingCat.of S) ⟶ Spec (CommRingCat.of 𝒪)),
      FakeEllipticCurve.WithFullLevel Λ N n S → SchemeHomOver s fM)
    (hM : IsFineModuli Λ N n M fM ptF)

    (C : Type) [CommRing C] [IsNoetherianRing C] [Algebra 𝒪 C] (hC : IsNilpotent (algebraMap 𝒪 C π)) (ψ : Onr →ₐ[𝒪] C)
    (PR : CerednikDrinfeld.FormalOmega.AlgFunctor C)
    (ptR : ∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
      (ψS : Onr →ₐ[𝒪] S) (_ : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
      (u : FakeEllipticCurve.WithFullLevel Λ N n S), FakeEllipticCurve.Rigidification r π A₀ ψS u.1 → PR.obj S)
    (toM : ∀ (S : Type) [CommRing S] [Algebra C S],
      PR.obj S → SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C)))))
    (hsh :
      (∀ (A : Type) [CommRing A] [Algebra C A] (n : ℕ) (f : Fin n → A),
        Ideal.span (Set.range f) = ⊤ →
        ∀ (B : Fin n → Type) [∀ i, CommRing (B i)] [∀ i, Algebra A (B i)] [∀ i, Algebra C (B i)]
          [∀ i, IsScalarTower C A (B i)] [∀ i, IsLocalization.Away (f i) (B i)] (s : ∀ i, PR.obj (B i)),
        (∀ (i j : Fin n) (D : Type) [CommRing D] [Algebra A D] [Algebra C D] [IsScalarTower C A D]
            [IsLocalization.Away (f i * f j) D] (ρ₁ : B i →ₐ[A] D) (ρ₂ : B j →ₐ[A] D),
            PR.map (ρ₁.restrictScalars C) (s i) = PR.map (ρ₂.restrictScalars C) (s j)) →
        ∃! s₀ : PR.obj A, ∀ i, PR.map (IsScalarTower.toAlgHom C A (B i)) s₀ = s i))
    (hR0 :
      (∀ (S S' : Type) [CommRing S] [Algebra C S] [CommRing S'] [Algebra C S'] (φ : S →ₐ[C] S') (x : PR.obj S),
          (toM S' (PR.map φ x)).1 = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (toM S x).1))
    (hR1 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1)
          (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f),
          FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi →
          (∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩) →
            ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ'))
    (hR2 :
      (∀ (S S' : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          [CommRing S'] [Algebra C S'] [Algebra 𝒪 S'] [IsScalarTower 𝒪 C S'] (φ : S →ₐ[C] S')
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hψS' : (φ.restrictScalars 𝒪).comp ψS = (IsScalarTower.toAlgHom 𝒪 C S').comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (u' : FakeEllipticCurve.WithFullLevel Λ N n S')
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1)
          (ρ' : FakeEllipticCurve.Rigidification r π A₀ ((φ.restrictScalars 𝒪).comp ψS) u'.1)
          (g : u'.1.A ⟶ u.1.A) (hg : FakeEllipticCurve.IsPullbackVia (φ : S →+* S') u.1 u'.1 g),
          (u'.2.P).1 ≫ g = Spec.map (CommRingCat.ofHom (φ : S →+* S')) ≫ (u.2.P).1 →
          FakeEllipticCurve.Rigidification.IsPullbackVia (φ.restrictScalars 𝒪) g hg ρ ρ' →
            PR.map φ (ptR S ψS hψS u ρ) = ptR S' ((φ.restrictScalars 𝒪).comp ψS) hψS' u' ρ'))
    (hR3s :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ) (z : PR.obj S),
          ∃ (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1), ptR S ψS hψS u ρ = z))
    (hR3i :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (hSc : ∀ e : S, IsIdempotentElem e → e = 0 ∨ e = 1)
          (u u' : FakeEllipticCurve.WithFullLevel Λ N n S)
          (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1) (ρ' : FakeEllipticCurve.Rigidification r π A₀ ψS u'.1),
          ptR S ψS hψS u ρ = ptR S ψS hψS u' ρ' →
            ∃ (i : u.1.A ≅ u'.1.A) (hi : i.hom ≫ u'.1.f = u.1.f), FakeEllipticCurve.WithFullLevel.IsoVia u u' i hi ∧
              ∃ (ib : ρ.Eb.A ⟶ ρ'.Eb.A) (_ : ib ≫ ρ'.gb = ρ.gb ≫ i.hom) (_ : ib ≫ ρ'.Eb.f = ρ.Eb.f)
              (uA : ρ'.Ab.A ⟶ ρ.Ab.A) (_ : FakeEllipticCurve.IsPullbackVia (RingHom.id _) ρ.Ab ρ'.Ab uA) (_ : uA ≫ ρ.gA = ρ'.gA)
              (i₁ j₁ : ℕ),
              ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩))
    (hR4 :
      (∀ (S : Type) [CommRing S] [Algebra C S] [Algebra 𝒪 S] [IsScalarTower 𝒪 C S]
          (ψS : Onr →ₐ[𝒪] S) (hψS : ψS = (IsScalarTower.toAlgHom 𝒪 C S).comp ψ)
          (u : FakeEllipticCurve.WithFullLevel Λ N n S) (ρ : FakeEllipticCurve.Rigidification r π A₀ ψS u.1),
          (toM S (ptR S ψS hψS u ρ)).1 ≫ Limits.pullback.fst fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))) =
            (ptF S (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 S))) u).1)) :
    ∀ (S S₀ : Type) [CommRing S] [IsNoetherianRing S] [Algebra C S] [CommRing S₀] [Algebra C S₀] (p : S →ₐ[C] S₀),
      Function.Surjective p → RingHom.ker (p : S →+* S₀) ^ 2 = ⊥ →
      ∀ (x₀ : PR.obj S₀) (t : SchemeHomOver (Spec.map (CommRingCat.ofHom (algebraMap C S))) (Limits.pullback.snd fM (Spec.map (CommRingCat.ofHom (algebraMap 𝒪 C))))),
      Spec.map (CommRingCat.ofHom (p : S →+* S₀)) ≫ t.1 = (toM S₀ x₀).1 →
      ∃! x : PR.obj S, PR.map p x = x₀ ∧ toM S x = t :=
  ETBlock.existsUnique_lift_of_R_sh hrN hrr 𝒪 π hunr Onr hBq Λ hΛ hΛℤ coord hcoord A₀ n hn hrn M fM ptF hM C hC ψ
    PR ptR toM hsh hR0 hR1 hR2 hR3s hR3i hR4

