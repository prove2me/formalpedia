namespace ResolvingNRM.FRLower.ProofPlan

/-! ### Helper: Indicator Product Identities -/

lemma indR_and (P Q : Prop) : indR (P ∧ Q) = indR P * indR Q := by
  by_cases hP : P <;> by_cases hQ : Q
  · rw [indR_true ⟨hP, hQ⟩, indR_true hP, indR_true hQ]; ring
  · have hPQ : ¬ (P ∧ Q) := fun h => hQ h.2
    rw [indR_false hPQ, indR_true hP, indR_false hQ]; ring
  · have hPQ : ¬ (P ∧ Q) := fun h => hP h.1
    rw [indR_false hPQ, indR_false hP, indR_true hQ]; ring
  · have hPQ : ¬ (P ∧ Q) := fun h => hP h.1
    rw [indR_false hPQ, indR_false hP, indR_false hQ]; ring

lemma indR_not (P : Prop) : indR (¬ P) = 1 - indR P := by
  by_cases hP : P
  · rw [indR_false (not_not.mpr hP), indR_true hP]; ring
  · rw [indR_true hP, indR_false hP]; ring

lemma treeIntegrable_indR {p : Policy} (hp : ∀ h, ValidProb (p h))
    (k : ℕ) (h : History) (P : History → Prop) :
    TreeIntegrable p k h (fun h' => indR (P h')) :=
  (treeExp_bdd hp k h 1 zero_le_one (fun h' => abs_indR_le_one (P h'))).1

/-! ### Concentration 1: Conditional Probability of `Q₂` (`≥ 3 / 4`) -/

theorem q2_cond_prob_ge (T : ℕ) (hn1 : 1 ≤ T / 3) {h₁ : History}
    (hlen₁ : h₁.length = T / 3) :
    (3 : ℝ) / 4 ≤
      treeExp (canonicalPolicy T) (T / 3) h₁ (fun h' => indR (EventQ2 T h')) := by
  set n := T / 3
  set s := Real.sqrt (n : ℝ)
  set p := canonicalPolicy T
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  let V : History → ℝ := fun h => (frozenQ2 T h) ^ 2
  have hV_nn : ∀ h, 0 ≤ V h := fun h => sq_nonneg _
  -- One-step integrability and drift `≤ 1` for `V`.
  have hstep_V : ∀ h : History,
      StepAbsIntegrable (p h) (fun w => V (h ++ [w])) ∧
        stepExp (p h) (fun w => V (h ++ [w])) ≤ V h + 1 := by
    intro h
    by_cases hgate : n ≤ h.length ∧ h.length < 2 * n ∧ |frozenQ2 T h| ≤ 2 * s
    · have hm := stepExp_offered_high_moments (hp h)
      have heq : (fun w => V (h ++ [w])) =
          (fun w => V h + 2 * frozenQ2 T h * ((winOffered 0 w : ℝ) - 1) +
            ((winOffered 0 w : ℝ) - 1) ^ 2) := by
        ext w
        dsimp [V]
        rw [frozenQ2_append_singleton, if_pos hgate]
        ring
      rw [heq]
      have hi0 := stepAbsIntegrable_const (hp h) (V h)
      have hi1 := stepAbsIntegrable_mul_left (hp h) (2 * frozenQ2 T h) hm.1
      have hi01 := stepAbsIntegrable_add (hp h) hi0 hi1
      have hi := stepAbsIntegrable_add (hp h) hi01 hm.2.1
      refine ⟨hi, ?_⟩
      rw [stepExp_add (hp h) hi01 hm.2.1, stepExp_add (hp h) hi0 hi1,
        stepExp_const, stepExp_mul_left, hm.2.2.1, hm.2.2.2]
      linarith
    · have heq : (fun w => V (h ++ [w])) = (fun _ => V h) := by
        ext w
        dsimp [V]
        rw [frozenQ2_append_singleton, if_neg hgate, add_zero]
      rw [heq]
      exact ⟨stepAbsIntegrable_const (hp h) (V h), by rw [stepExp_const]; linarith⟩
  have hpot := treeExp_potential_bound p V 1 hp zero_le_one hV_nn
    (fun h => (hstep_V h).1) (fun h => (hstep_V h).2) n h₁
  have hV_h1 : V h₁ = 0 := by
    dsimp [V]
    rw [frozenQ2_of_len_le T (le_of_eq hlen₁)]
    ring
  have hub_V : treeExp p n h₁ V ≤ (n : ℝ) := by
    have := hpot.2.2
    rw [hV_h1] at this
    linarith
  -- Compare `4 * n * indR (¬ EventQ2)` with `V` on supported extensions from `h₁`.
  have hs_sq : s ^ 2 = (n : ℝ) := Real.sq_sqrt (Nat.cast_nonneg n)
  let Fbad : History → ℝ := fun h' => (4 * (n : ℝ)) * indR (¬ EventQ2 T h')
  have hFbad_int : TreeIntegrable p n h₁ Fbad :=
    (treeExp_mul_left hp n h₁ (4 * (n : ℝ)) (treeIntegrable_indR hp n h₁ _)).1
  have hdom : ∀ h', ExtSupported p n h₁ h' → Fbad h' ≤ V h' := by
    intro h' hsupp
    rcases hsupp.exists_suffix with ⟨s₂, hs₂_len, rfl⟩
    by_cases hq2 : EventQ2 T (h₁ ++ s₂)
    · dsimp [Fbad]
      rw [indR_false (not_not.mpr hq2), mul_zero]
      exact hV_nn _
    · dsimp [Fbad, V]
      rw [indR_true hq2, mul_one]
      have hgt := frozenQ2_gt_of_not_eventQ2 T hlen₁ hs₂_len hq2
      have h2s_nn : 0 ≤ 2 * s := by positivity
      have hsq : (2 * s) ^ 2 ≤ |frozenQ2 T (h₁ ++ s₂)| ^ 2 :=
        sq_le_sq.mpr (by rw [abs_of_nonneg h2s_nn, abs_abs]; exact le_of_lt hgt)
      rw [sq_abs] at hsq
      calc
        4 * (n : ℝ) = (2 * s) ^ 2 := by rw [ ← hs_sq]; ring
        _ ≤ (frozenQ2 T (h₁ ++ s₂)) ^ 2 := hsq
  have hbad_le : treeExp p n h₁ Fbad ≤ (n : ℝ) :=
    le_trans (treeExp_mono_of_support hp n h₁ hFbad_int hpot.1 hdom) hub_V
  have hbad_eq : treeExp p n h₁ Fbad =
      (4 * (n : ℝ)) * (1 - treeExp p n h₁ (fun h' => indR (EventQ2 T h'))) := by
    dsimp [Fbad]
    rw [(treeExp_mul_left hp n h₁ (4 * (n : ℝ)) (treeIntegrable_indR hp n h₁ _)).2]
    congr 1
    have hfun : (fun h' => indR (¬ EventQ2 T h')) = (fun h' => 1 - indR (EventQ2 T h')) := by
      ext h'; exact indR_not _
    rw [hfun, (treeExp_sub hp n h₁ (treeExp_const hp n h₁ 1).1 (treeIntegrable_indR hp n h₁ _)).2,
      (treeExp_const hp n h₁ 1).2]
  rw [hbad_eq] at hbad_le
  have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hn1
  nlinarith

theorem prob_Q1_inter_Q2_ge (T : ℕ) (hn1 : 1 ≤ T / 3) :
    let n := T / 3
    let p := canonicalPolicy T
    (3 / 4 : ℝ) * treeExp p n [] (fun h₁ => indR (EventQ1 T h₁)) ≤
      treeExp p (2 * n) [] (fun h => indR (EventQ1 T h ∧ EventQ2 T h)) := by
  intro n p
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  have h2n : 2 * n = n + n := by omega
  rw [h2n, treeExp_add_steps]
  let LHS_fn : History → ℝ := fun h₁ => (3 / 4 : ℝ) * indR (EventQ1 T h₁)
  let RHS_fn : History → ℝ := fun h₁ =>
    treeExp p n h₁ (fun h₂ => indR (EventQ1 T h₂ ∧ EventQ2 T h₂))
  have hLHS_int : TreeIntegrable p n [] LHS_fn :=
    (treeExp_mul_left hp n [] (3 / 4 : ℝ) (treeIntegrable_indR hp n [] _)).1
  have hRHS_int : TreeIntegrable p n [] RHS_fn := by
    refine (treeExp_bdd hp n [] 1 zero_le_one fun h₁ => ?_).1
    exact (treeExp_bdd hp n h₁ 1 zero_le_one fun h₂ => abs_indR_le_one _).2
  have hLHS_val : treeExp p n [] LHS_fn =
      (3 / 4 : ℝ) * treeExp p n [] (fun h₁ => indR (EventQ1 T h₁)) :=
    (treeExp_mul_left hp n [] (3 / 4 : ℝ) (treeIntegrable_indR hp n [] _)).2
  rw [← hLHS_val]
  refine treeExp_mono_of_support hp n [] hLHS_int hRHS_int fun h₁ hsupp₁ => ?_
  have hlen₁ : h₁.length = n := by simpa using hsupp₁.length_eq
  dsimp [LHS_fn, RHS_fn]
  -- On extensions `h₂` of `h₁`, `EventQ1 T h₂ ↔ EventQ1 T h₁`.
  let G_inner : History → ℝ := fun h₂ => indR (EventQ1 T h₁) * indR (EventQ2 T h₂)
  have hG_int : TreeIntegrable p n h₁ G_inner :=
    (treeExp_mul_left hp n h₁ (indR (EventQ1 T h₁)) (treeIntegrable_indR hp n h₁ _)).1
  have hG_eq : treeExp p n h₁ G_inner =
      treeExp p n h₁ (fun h₂ => indR (EventQ1 T h₂ ∧ EventQ2 T h₂)) := by
    apply le_antisymm
    · refine treeExp_mono_of_support hp n h₁ hG_int (treeIntegrable_indR hp n h₁ _) fun h₂ hs₂ => ?_
      rcases hs₂.exists_suffix with ⟨s₂, _, rfl⟩
      dsimp [G_inner]
      rw [indR_and, eventQ1_append_of_len T (le_of_eq hlen₁.symm) s₂]
    · refine treeExp_mono_of_support hp n h₁ (treeIntegrable_indR hp n h₁ _) hG_int fun h₂ hs₂ => ?_
      rcases hs₂.exists_suffix with ⟨s₂, _, rfl⟩
      dsimp [G_inner]
      rw [indR_and, eventQ1_append_of_len T (le_of_eq hlen₁.symm) s₂]
  rw [← hG_eq]
  dsimp [G_inner]
  rw [(treeExp_mul_left hp n h₁ (indR (EventQ1 T h₁)) (treeIntegrable_indR hp n h₁ _)).2]
  have hq2 := q2_cond_prob_ge T hn1 hlen₁
  have hind_nn := indR_nonneg (EventQ1 T h₁)
  nlinarith

/-! ### Concentration 2: Probability of `EventE` (`≤ 864 / √n`) -/

theorem prob_EventE_le (T : ℕ) (hn4 : 4 ≤ T / 3) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    let p := canonicalPolicy T
    treeExp p (2 * n) [] (fun h => indR (EventE T h)) ≤ 864 / s := by
  intro n s p
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  have hs_pos : 0 < s := Real.sqrt_pos.mpr (by exact_mod_cast (by omega : 0 < n))
  have hs_sq : s ^ 2 = (n : ℝ) := Real.sq_sqrt (Nat.cast_nonneg n)
  let V : History → ℝ := fun h => (gatedLowSum T h) ^ 2
  have hV_nn : ∀ h, 0 ≤ V h := fun h => sq_nonneg _
  have hstep_V : ∀ h : History,
      StepAbsIntegrable (p h) (fun w => V (h ++ [w])) ∧
        stepExp (p h) (fun w => V (h ++ [w])) ≤ V h + 12 / s := by
    intro h
    by_cases hgate : n ≤ h.length ∧ h.length < 2 * n ∧ p h 1 ≤ 12 / s
    · have hm := stepExp_enabled_low_moments (hp h)
      have heq : (fun w => V (h ++ [w])) =
          (fun w => V h + 2 * gatedLowSum T h * (p h 1 - (winEnabled 1 w : ℝ)) +
            (p h 1 - (winEnabled 1 w : ℝ)) ^ 2) := by
        ext w
        dsimp [V]
        rw [gatedLowSum_append_singleton, if_pos hgate]
        ring
      rw [heq]
      have hi0 := stepAbsIntegrable_const (hp h) (V h)
      have hi1 := stepAbsIntegrable_mul_left (hp h) (2 * gatedLowSum T h) hm.1
      have hi01 := stepAbsIntegrable_add (hp h) hi0 hi1
      have hi := stepAbsIntegrable_add (hp h) hi01 hm.2.1
      refine ⟨hi, ?_⟩
      rw [stepExp_add (hp h) hi01 hm.2.1, stepExp_add (hp h) hi0 hi1,
        stepExp_const, stepExp_mul_left, hm.2.2.1, hm.2.2.2]
      linarith [hgate.2.2]
    · have heq : (fun w => V (h ++ [w])) = (fun _ => V h) := by
        ext w
        dsimp [V]
        rw [gatedLowSum_append_singleton, if_neg hgate, add_zero]
      rw [heq]
      have hv_nn : 0 ≤ 12 / s := by positivity
      exact ⟨stepAbsIntegrable_const (hp h) (V h), by rw [stepExp_const]; linarith⟩
  have hpot := treeExp_potential_bound p V (12 / s) hp (by positivity) hV_nn
    (fun h => (hstep_V h).1) (fun h => (hstep_V h).2) (2 * n) []
  have hV_nil : V [] = 0 := by
    dsimp [V]; simp [gatedLowSum]
  have hub_V : treeExp p (2 * n) [] V ≤ 24 * s := by
    have h1 := hpot.2.2
    rw [hV_nil, zero_add] at h1
    refine le_trans h1 ?_
    have hs_ne : s ≠ 0 := ne_of_gt hs_pos
    have hcast : ((2 * n : ℕ) : ℝ) = 2 * (s ^ 2) := by push_cast; rw [hs_sq]
    rw [hcast]
    field_simp [hs_ne]
    ring_nf
    exact le_rfl
  let FE : History → ℝ := fun h => ((n : ℝ) / 36) * indR (EventE T h)
  have hFE_int : TreeIntegrable p (2 * n) [] FE :=
    (treeExp_mul_left hp (2 * n) [] ((n : ℝ) / 36) (treeIntegrable_indR hp (2 * n) [] _)).1
  have hdom : ∀ h, ExtSupported p (2 * n) [] h → FE h ≤ V h := by
    intro h hsupp
    by_cases hE : EventE T h
    · dsimp [FE, V]
      rw [indR_true hE, mul_one]
      have hgt := gatedLowSum_gt_on_EventE T hn4 hsupp hE
      have hs6_nn : 0 ≤ s / 6 := by positivity
      have hsq : (s / 6) ^ 2 ≤ (gatedLowSum T h) ^ 2 := by nlinarith
      calc
        (n : ℝ) / 36 = (s / 6) ^ 2 := by rw [← hs_sq]; ring
        _ ≤ (gatedLowSum T h) ^ 2 := hsq
    · dsimp [FE]
      rw [indR_false hE, mul_zero]
      exact hV_nn h
  have hle_FE : ((n : ℝ) / 36) * treeExp p (2 * n) [] (fun h => indR (EventE T h)) ≤ 24 * s := by
    have h := le_trans (treeExp_mono_of_support hp (2 * n) [] hFE_int hpot.1 hdom) hub_V
    simpa [FE, (treeExp_mul_left hp (2 * n) [] ((n : ℝ) / 36)
      (treeIntegrable_indR hp (2 * n) [] _)).2] using h
  rw [le_div_iff₀ hs_pos]
  have hmul : s * (((n : ℝ) / 36) * treeExp p (2 * n) [] (fun h => indR (EventE T h))) ≤
      s * (24 * s) :=
    mul_le_mul_of_nonneg_left hle_FE (le_of_lt hs_pos)
  -- `s * (n / 36 * P) = (n / 36) * (P * s)` and `s * (24 * s) = 24 * n`.
  have hn_pos : (0 : ℝ) < (n : ℝ) := by exact_mod_cast (by omega : 0 < n)
  have h1 : (n : ℝ) * (treeExp p (2 * n) [] (fun h => indR (EventE T h)) * s) ≤
      (n : ℝ) * 864 := by
    calc
      (n : ℝ) * (treeExp p (2 * n) [] (fun h => indR (EventE T h)) * s)
          = 36 * (s * (((n : ℝ) / 36) * treeExp p (2 * n) [] (fun h => indR (EventE T h)))) := by
            ring
      _ ≤ 36 * (s * (24 * s)) := by linarith
      _ = 864 * (s ^ 2) := by ring
      _ = (n : ℝ) * 864 := by rw [hs_sq]; ring
  exact le_of_mul_le_mul_left h1 hn_pos

/-! ### Block Offered-Arrival Bounds for `Q₁`, `Q₃`, `Q₄` -/

theorem prob_Q1_ge (T : ℕ) (hn1 : 1 ≤ T / 3) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    let p := canonicalPolicy T
    0.0013 - 0.9496 / s ≤ treeExp p n [] (fun h₁ => indR (EventQ1 T h₁)) := by
  intro n s p
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  let g : ℕ → ℝ := fun a =>
    indR ((n : ℝ) - 4 * s ≤ (a : ℝ) ∧ (a : ℝ) ≤ (n : ℝ) - 3 * s)
  have hg_bdd : ∀ a, |g a| ≤ 1 := fun a => abs_indR_le_one _
  -- On `ExtSupported p n [] h₁`, `h₁.length = n`, so `h₁.take n = h₁`.
  have heq_tree :
      treeExp p n [] (fun h₁ => g (histOffered 0 h₁ - histOffered 0 [])) =
        treeExp p n [] (fun h₁ => indR (EventQ1 T h₁)) := by
    have hint1 : TreeIntegrable p n [] (fun h₁ => g (histOffered 0 h₁ - histOffered 0 [])) :=
      (treeExp_bdd hp n [] 1 zero_le_one fun h₁ => hg_bdd _).1
    have hint2 := treeIntegrable_indR hp n [] (EventQ1 T)
    apply le_antisymm
    · refine treeExp_mono_of_support hp n [] hint1 hint2 fun h₁ hs₁ => ?_
      have hlen : h₁.length = n := by simpa using hs₁.length_eq
      have htake : h₁.take (T / 3) = h₁ := List.take_of_length_le (le_of_eq hlen)
      have hinc : histOffered 0 h₁ - histOffered 0 [] = histOffered 0 h₁ := by simp
      dsimp only [g, EventQ1, n, s]
      rw [hinc, htake]
    · refine treeExp_mono_of_support hp n [] hint2 hint1 fun h₁ hs₁ => ?_
      have hlen : h₁.length = n := by simpa using hs₁.length_eq
      have htake : h₁.take (T / 3) = h₁ := List.take_of_length_le (le_of_eq hlen)
      have hinc : histOffered 0 h₁ - histOffered 0 [] = histOffered 0 h₁ := by simp
      dsimp only [g, EventQ1, n, s]
      rw [hinc, htake]
  rw [← heq_tree, treeExp_offered_high_inc p n [] 1 zero_le_one hg_bdd]
  have hq1 := ResolvingNRM.FRLower.q1_probability n hn1
  have hnn : ((n : ℝ)).toNNReal = (n : ℝ≥0) := by ext; simp
  rw [hnn] at hq1
  refine le_trans hq1 (le_of_eq ?_)
  congr 1; ext a
  dsimp only [g, s]
  by_cases ha : (n : ℝ) - 4 * Real.sqrt (n : ℝ) ≤ (a : ℝ) ∧
      (a : ℝ) ≤ (n : ℝ) - 3 * Real.sqrt (n : ℝ)
  · rw [if_pos ha, indR_true ha, mul_one]
  · rw [if_neg ha, indR_false ha, mul_zero]

theorem prob_Q3_cond_ge (T : ℕ) (hn1 : 1 ≤ T / 3) {h₂ : History}
    (hlen₂ : h₂.length = 2 * (T / 3)) :
    let n := T / 3
    let s := Real.sqrt (n : ℝ)
    let p := canonicalPolicy T
    cdf (gaussianReal 0 1) 7 - cdf (gaussianReal 0 1) 6 - 0.9496 / s ≤
      treeExp p n h₂ (fun h₃ => indR (EventQ3 T h₃)) := by
  intro n s p
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  let g : ℕ → ℝ := fun a =>
    indR ((n : ℝ) + 6 * s ≤ (a : ℝ) ∧ (a : ℝ) ≤ (n : ℝ) + 7 * s)
  have hg_bdd : ∀ a, |g a| ≤ 1 := fun a => abs_indR_le_one _
  have heq_tree :
      treeExp p n h₂ (fun h₃ => g (histOffered 0 h₃ - histOffered 0 h₂)) =
        treeExp p n h₂ (fun h₃ => indR (EventQ3 T h₃)) := by
    have hint1 : TreeIntegrable p n h₂ (fun h₃ => g (histOffered 0 h₃ - histOffered 0 h₂)) :=
      (treeExp_bdd hp n h₂ 1 zero_le_one fun _ => hg_bdd _).1
    have hint2 := treeIntegrable_indR hp n h₂ (EventQ3 T)
    apply le_antisymm
    · refine treeExp_mono_of_support hp n h₂ hint1 hint2 fun h₃ hs₃ => ?_
      rcases hs₃.exists_suffix with ⟨s₃, hs₃_len, rfl⟩
      have hdrop : ((h₂ ++ s₃).drop (2 * (T / 3))).take (T / 3) = s₃ := by
        rw [List.drop_left' hlen₂]
        exact List.take_of_length_le (le_of_eq hs₃_len)
      have hinc : histOffered 0 (h₂ ++ s₃) - histOffered 0 h₂ = histOffered 0 s₃ := by
        rw [histOffered_append, Nat.add_sub_cancel_left]
      dsimp only [g, EventQ3, n, s]
      rw [hinc, hdrop]
    · refine treeExp_mono_of_support hp n h₂ hint2 hint1 fun h₃ hs₃ => ?_
      rcases hs₃.exists_suffix with ⟨s₃, hs₃_len, rfl⟩
      have hdrop : ((h₂ ++ s₃).drop (2 * (T / 3))).take (T / 3) = s₃ := by
        rw [List.drop_left' hlen₂]
        exact List.take_of_length_le (le_of_eq hs₃_len)
      have hinc : histOffered 0 (h₂ ++ s₃) - histOffered 0 h₂ = histOffered 0 s₃ := by
        rw [histOffered_append, Nat.add_sub_cancel_left]
      dsimp only [g, EventQ3, n, s]
      rw [hinc, hdrop]
  rw [← heq_tree, treeExp_offered_high_inc p n h₂ 1 zero_le_one hg_bdd]
  have hq3 := ResolvingNRM.FRLower.q3_probability n hn1
  have hnn : ((n : ℝ)).toNNReal = (n : ℝ≥0) := by ext; simp
  rw [hnn] at hq3
  refine le_trans hq3 (le_of_eq ?_)
  congr 1; ext a
  dsimp only [g, s]
  by_cases ha : (n : ℝ) + 6 * Real.sqrt (n : ℝ) ≤ (a : ℝ) ∧
      (a : ℝ) ≤ (n : ℝ) + 7 * Real.sqrt (n : ℝ)
  · rw [if_pos ha, indR_true ha, mul_one]
  · rw [if_neg ha, indR_false ha, mul_zero]

theorem prob_Q4_cond_ge (T : ℕ) {h₃ : History}
    (hlen₃ : h₃.length = 3 * (T / 3)) :
    let r := T % 3
    let p := canonicalPolicy T
    Real.exp (-2) ≤ treeExp p r h₃ (fun h₄ => indR (EventQ4 T h₄)) := by
  intro r p
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  let g : ℕ → ℝ := fun a => indR (a = r)
  have hg_bdd : ∀ a, |g a| ≤ 1 := fun a => abs_indR_le_one _
  have heq_tree :
      treeExp p r h₃ (fun h₄ => g (histOffered 0 h₄ - histOffered 0 h₃)) =
        treeExp p r h₃ (fun h₄ => indR (EventQ4 T h₄)) := by
    have hint1 : TreeIntegrable p r h₃ (fun h₄ => g (histOffered 0 h₄ - histOffered 0 h₃)) :=
      (treeExp_bdd hp r h₃ 1 zero_le_one fun _ => hg_bdd _).1
    have hint2 := treeIntegrable_indR hp r h₃ (EventQ4 T)
    apply le_antisymm
    · refine treeExp_mono_of_support hp r h₃ hint1 hint2 fun h₄ hs₄ => ?_
      rcases hs₄.exists_suffix with ⟨s₄, hs₄_len, rfl⟩
      have hdrop : ((h₃ ++ s₄).drop (3 * (T / 3))).take (T % 3) = s₄ := by
        rw [List.drop_left' hlen₃]
        exact List.take_of_length_le (le_of_eq hs₄_len)
      have hinc : histOffered 0 (h₃ ++ s₄) - histOffered 0 h₃ = histOffered 0 s₄ := by
        rw [histOffered_append, Nat.add_sub_cancel_left]
      dsimp only [g, EventQ4, r]
      rw [hinc, hdrop]
    · refine treeExp_mono_of_support hp r h₃ hint2 hint1 fun h₄ hs₄ => ?_
      rcases hs₄.exists_suffix with ⟨s₄, hs₄_len, rfl⟩
      have hdrop : ((h₃ ++ s₄).drop (3 * (T / 3))).take (T % 3) = s₄ := by
        rw [List.drop_left' hlen₃]
        exact List.take_of_length_le (le_of_eq hs₄_len)
      have hinc : histOffered 0 (h₃ ++ s₄) - histOffered 0 h₃ = histOffered 0 s₄ := by
        rw [histOffered_append, Nat.add_sub_cancel_left]
      dsimp only [g, EventQ4, r]
      rw [hinc, hdrop]
  rw [← heq_tree, treeExp_offered_high_inc p r h₃ 1 zero_le_one hg_bdd]
  have htsum : (∑' a : ℕ, poissonPMFReal (r : ℝ≥0) a * g a) =
      poissonPMFReal (r : ℝ≥0) r := by
    have hfun : (fun a : ℕ => poissonPMFReal (r : ℝ≥0) a * g a) =
        (fun a : ℕ => if a = r then poissonPMFReal (r : ℝ≥0) r else 0) := by
      ext a
      by_cases ha : a = r
      · subst ha; simp [g, indR_true rfl]
      · simp [g, ha, indR_false ha]
    rw [hfun, tsum_ite_eq]
  rw [htsum]
  have hr_lt : r < 3 := Nat.mod_lt T (by norm_num)
  have hr_cases : r = 0 ∨ r = 1 ∨ r = 2 := by omega
  rcases hr_cases with hr0 | hr1 | hr2
  · rw [hr0]; simp [poissonPMFReal]
  · rw [hr1]; simp [poissonPMFReal]
  · rw [hr2]; unfold poissonPMFReal
    have hval : Real.exp (-(((2 : ℕ) : ℝ≥0) : ℝ)) * (((2 : ℕ) : ℝ≥0) : ℝ) ^ 2 / ((2 : ℕ).factorial : ℝ) =
        2 * Real.exp (-2) := by
      norm_num [Nat.factorial]; ring
    rw [hval]
    linarith [Real.exp_pos (-2)]

/-! ### Full Four-Phase Probability & Final Theorem Assembly -/

theorem prob_EventG_ge (T : ℕ)
    (hs_big : (4000000 : ℝ) ≤ Real.sqrt ((T / 3 : ℕ) : ℝ))
    (hs_gam : 2 / (cdf (gaussianReal 0 1) 7 - cdf (gaussianReal 0 1) 6) ≤
      Real.sqrt ((T / 3 : ℕ) : ℝ)) :
    let γ := cdf (gaussianReal 0 1) 7 - cdf (gaussianReal 0 1) 6
    γ * Real.exp (-2) / 4000 ≤
      treeExp (canonicalPolicy T) T [] (fun h => indR (EventG T h)) := by
  intro γ
  set n := T / 3
  set r := T % 3
  set s := Real.sqrt (n : ℝ)
  set p := canonicalPolicy T
  have hp : ∀ h, ValidProb (p h) := validProb_canonicalPolicy T
  have hγ_pos : 0 < γ := gaussian_cdf_gap_pos
  have hs_pos : 0 < s := by linarith
  have hn4 : 4 ≤ n := by
    by_contra hlt
    have hle3 : (n : ℝ) ≤ 3 := by exact_mod_cast (by omega : n ≤ 3)
    have hsq3 : s ≤ Real.sqrt 3 := Real.sqrt_le_sqrt hle3
    have h3_lt : Real.sqrt 3 < 2 := by
      rw [Real.sqrt_lt' (by norm_num)]; norm_num
    linarith
  have hn1 : 1 ≤ n := by omega
  -- Prefix probability `P(G_pre) ≥ 1 / 2000`.
  have hq1_lb : (1 : ℝ) / 1000 ≤ treeExp p n [] (fun h₁ => indR (EventQ1 T h₁)) := by
    have hq1 := prob_Q1_ge T hn1
    have hdiv : 0.9496 / s ≤ 0.9496 / 4000000 :=
      div_le_div_of_nonneg_left (by norm_num) (by norm_num) hs_big
    linarith
  have hq12_lb : (3 : ℝ) / 4000 ≤
      treeExp p (2 * n) [] (fun h => indR (EventQ1 T h ∧ EventQ2 T h)) := by
    have h12 := prob_Q1_inter_Q2_ge T hn1
    linarith
  have hE_ub : treeExp p (2 * n) [] (fun h => indR (EventE T h)) ≤ (1 : ℝ) / 4000 := by
    have hE := prob_EventE_le T hn4
    have hdiv : 864 / s ≤ 864 / 4000000 :=
      div_le_div_of_nonneg_left (by norm_num) (by norm_num) hs_big
    linarith
  have hGpre_lb : (1 : ℝ) / 2000 ≤
      treeExp p (2 * n) [] (fun h => indR (EventGPre T h)) := by
    have hpart : (fun h => indR (EventQ1 T h ∧ EventQ2 T h)) =
        (fun h => indR (EventGPre T h) + indR (EventE T h)) := by
      ext h; exact indR_Q1_inter_Q2_eq T h
    have hsum_eq := (treeExp_add hp (2 * n) []
      (treeIntegrable_indR hp (2 * n) [] (EventGPre T))
      (treeIntegrable_indR hp (2 * n) [] (EventE T))).2
    rw [← hpart] at hsum_eq
    linarith
  -- `γ - 0.9496 / s ≥ γ / 2`.
  have hq3_const : γ / 2 ≤ γ - 0.9496 / s := by
    have h1 : 0.9496 / s ≤ 1 / s :=
      div_le_div_of_nonneg_right (by norm_num) (le_of_lt hs_pos)
    have h2 : 1 / s ≤ γ / 2 := by
      rw [div_le_div_iff₀ hs_pos (by norm_num : (0 : ℝ) < 2)]
      have h3 := (div_le_iff₀ hγ_pos).mp hs_gam
      linarith
    linarith
  -- Compose `(2 * n) + n + r = T`.
  have hT_split : T = 2 * n + (n + r) := by
    have := Nat.div_add_mod T 3
    omega
  have hsplit_exp : treeExp p T [] (fun h => indR (EventG T h)) =
      treeExp p (2 * n) [] (fun h₂ => treeExp p (n + r) h₂ (fun h₄ => indR (EventG T h₄))) := by
    conv_lhs => arg 2; rw [hT_split]
    exact treeExp_add_steps p (2 * n) (n + r) [] (fun h => indR (EventG T h))
  rw [hsplit_exp]
  -- For any `h₂` with `ExtSupported p (2 * n) [] h₂`, lower-bound `treeExp p (n + r) h₂ (indR EventG)`.
  let F_lhs : History → ℝ := fun h₂ => (γ * Real.exp (-2) / 2) * indR (EventGPre T h₂)
  let F_rhs : History → ℝ := fun h₂ => treeExp p (n + r) h₂ (fun h₄ => indR (EventG T h₄))
  have hFlhs_int : TreeIntegrable p (2 * n) [] F_lhs :=
    (treeExp_mul_left hp (2 * n) [] _ (treeIntegrable_indR hp (2 * n) [] _)).1
  have hFrhs_int : TreeIntegrable p (2 * n) [] F_rhs := by
    refine (treeExp_bdd hp (2 * n) [] 1 zero_le_one fun h₂ => ?_).1
    exact (treeExp_bdd hp (n + r) h₂ 1 zero_le_one fun h₄ => abs_indR_le_one _).2
  have hstep234 : ∀ h₂, ExtSupported p (2 * n) [] h₂ → F_lhs h₂ ≤ F_rhs h₂ := by
    intro h₂ hs₂
    have hlen₂ : h₂.length = 2 * n := by simpa using hs₂.length_eq
    dsimp [F_lhs, F_rhs]
    rw [treeExp_add_steps]
    -- First peel Phase 4 (`r` steps from `h₃`).
    let M_lhs : History → ℝ := fun h₃ =>
      Real.exp (-2) * (indR (EventGPre T h₂) * indR (EventQ3 T h₃))
    let M_rhs : History → ℝ := fun h₃ => treeExp p r h₃ (fun h₄ => indR (EventG T h₄))
    have hMlhs_int : TreeIntegrable p n h₂ M_lhs :=
      (treeExp_mul_left hp n h₂ (Real.exp (-2))
        ((treeExp_mul_left hp n h₂ (indR (EventGPre T h₂))
          (treeIntegrable_indR hp n h₂ _)).1)).1
    have hMrhs_int : TreeIntegrable p n h₂ M_rhs := by
      refine (treeExp_bdd hp n h₂ 1 zero_le_one fun h₃ => ?_).1
      exact (treeExp_bdd hp r h₃ 1 zero_le_one fun h₄ => abs_indR_le_one _).2
    have hpeel4 : ∀ h₃, ExtSupported p n h₂ h₃ → M_lhs h₃ ≤ M_rhs h₃ := by
      intro h₃ hs₃
      have hlen₃ : h₃.length = 3 * n := by
        have := hs₃.length_eq; omega
      rcases hs₃.exists_suffix with ⟨s₃, _, h₃_eq⟩
      dsimp [M_lhs, M_rhs]
      let K_inner : History → ℝ := fun h₄ =>
        (indR (EventGPre T h₂) * indR (EventQ3 T h₃)) * indR (EventQ4 T h₄)
      have hK_int : TreeIntegrable p r h₃ K_inner :=
        (treeExp_mul_left hp r h₃ _ (treeIntegrable_indR hp r h₃ _)).1
      have hK_le : treeExp p r h₃ K_inner ≤ treeExp p r h₃ (fun h₄ => indR (EventG T h₄)) := by
        refine treeExp_mono_of_support hp r h₃ hK_int (treeIntegrable_indR hp r h₃ _) fun h₄ hs₄ => ?_
        rcases hs₄.exists_suffix with ⟨s₄, _, rfl⟩
        dsimp [K_inner, EventG]
        rw [indR_and, indR_and]
        have hgpre_eq : EventGPre T (h₃ ++ s₄) ↔ EventGPre T h₂ := by
          rw [h₃_eq, List.append_assoc]
          exact eventGPre_append_of_len T (le_of_eq hlen₂.symm) (s₃ ++ s₄)
        have hq3_eq : EventQ3 T (h₃ ++ s₄) ↔ EventQ3 T h₃ :=
          eventQ3_append_of_len T (le_of_eq hlen₃.symm) s₄
        rw [hgpre_eq, hq3_eq, mul_assoc]
      refine le_trans ?_ hK_le
      dsimp [K_inner]
      rw [(treeExp_mul_left hp r h₃ _ (treeIntegrable_indR hp r h₃ _)).2]
      have hq4 := prob_Q4_cond_ge T hlen₃
      have hc_nn : 0 ≤ indR (EventGPre T h₂) * indR (EventQ3 T h₃) :=
        mul_nonneg (indR_nonneg _) (indR_nonneg _)
      nlinarith
    have h34 := treeExp_mono_of_support hp n h₂ hMlhs_int hMrhs_int hpeel4
    refine le_trans ?_ h34
    dsimp [M_lhs]
    rw [(treeExp_mul_left hp n h₂ (Real.exp (-2))
      ((treeExp_mul_left hp n h₂ (indR (EventGPre T h₂))
        (treeIntegrable_indR hp n h₂ _)).1)).2,
      (treeExp_mul_left hp n h₂ (indR (EventGPre T h₂))
        (treeIntegrable_indR hp n h₂ _)).2]
    have hq3 := prob_Q3_cond_ge T hn1 hlen₂
    have hq3' : γ / 2 ≤ treeExp p n h₂ (fun h₃ => indR (EventQ3 T h₃)) := le_trans hq3_const hq3
    have hexp_pos : 0 < Real.exp (-2) := Real.exp_pos (-2)
    have hg_nn : 0 ≤ indR (EventGPre T h₂) := indR_nonneg _
    calc
      (γ * Real.exp (-2) / 2) * indR (EventGPre T h₂)
          = Real.exp (-2) * (indR (EventGPre T h₂) * (γ / 2)) := by ring
      _ ≤ Real.exp (-2) *
            (indR (EventGPre T h₂) * treeExp p n h₂ (fun h₃ => indR (EventQ3 T h₃))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hq3' hg_nn) (le_of_lt hexp_pos)
  have htotal := treeExp_mono_of_support hp (2 * n) [] hFlhs_int hFrhs_int hstep234
  refine le_trans ?_ htotal
  dsimp [F_lhs]
  rw [(treeExp_mul_left hp (2 * n) [] _ (treeIntegrable_indR hp (2 * n) [] _)).2]
  have hc_nn : 0 ≤ γ * Real.exp (-2) / 2 := by positivity
  calc
    γ * Real.exp (-2) / 4000 = (γ * Real.exp (-2) / 2) * (1 / 2000) := by ring
    _ ≤ (γ * Real.exp (-2) / 2) * treeExp p (2 * n) [] (fun h => indR (EventGPre T h)) :=
      mul_le_mul_of_nonneg_left hGpre_lb hc_nn

theorem final_loss_arithmetic
    (gap d s g eta u : ℝ)
    (hd : 0 < d) (hg : 0 < g) (heta : 0 < eta)
    (hu : u ≤ 2 * s)
    (hloss : (d * s / 6) * (g * eta / 4000) ≤ gap) :
    (d * g * eta / 48000) * u ≤ gap := by
  have hcoef : 0 ≤ d * g * eta / 48000 := by positivity
  calc
    (d * g * eta / 48000) * u
        ≤ (d * g * eta / 48000) * (2 * s) :=
      mul_le_mul_of_nonneg_left hu hcoef
    _ = (d * s / 6) * (g * eta / 4000) := by ring
    _ ≤ gap := hloss

end ResolvingNRM.FRLower.ProofPlan

open ResolvingNRM.FRLower
open ResolvingNRM.FRLower.ProofPlan

theorem solution (r₁ r₂ : ℝ) (hr₂ : 0 < r₂) (hr : r₂ < r₁) :
    ∃ M : ℝ, 0 < M ∧ ∃ T₀ : ℕ, 1 ≤ T₀ ∧
      ∀ sel : (Fin 1 → ℝ) → Fin 2 → ℝ,
        IsDLPSelector (twoClass r₁ r₂ (le_of_lt hr₂) (le_of_lt hr)) sel →
        ∀ T : ℕ, T₀ ≤ T →
          hindsightValue (twoClass r₁ r₂ (le_of_lt hr₂) (le_of_lt hr)) (T : ℝ)
              (initialCapacity T) -
            frTail (twoClass r₁ r₂ (le_of_lt hr₂) (le_of_lt hr)) sel T
              (initialCapacity T) ≥ M * Real.sqrt (T : ℝ) := by
  let γ := ProbabilityTheory.cdf (ProbabilityTheory.gaussianReal 0 1) 7 -
    ProbabilityTheory.cdf (ProbabilityTheory.gaussianReal 0 1) 6
  have hγ : 0 < γ := gaussian_cdf_gap_pos
  have hδ : 0 < r₁ - r₂ := sub_pos.mpr hr
  have heta : 0 < Real.exp (-2) := Real.exp_pos (-2)
  let M : ℝ := (r₁ - r₂) * γ * Real.exp (-2) / 48000
  have hM : 0 < M := by dsimp [M]; positivity
  let K : ℝ := 4000000 + 2 / γ
  have hK_nn : 0 ≤ K := by dsimp [K]; positivity
  let N : ℕ := Nat.ceil (K ^ 2) + 4
  let T₀ : ℕ := 3 * N
  have hT₀ : 1 ≤ T₀ := by dsimp [T₀, N]; omega
  refine ⟨M, hM, T₀, hT₀, ?_⟩
  intro sel hsel T hT
  set n := T / 3
  set s := Real.sqrt (n : ℝ)
  have hn_ge_N : N ≤ n := by
    have : 3 * N ≤ T := hT
    omega
  have hn_ge_4 : 4 ≤ n := by dsimp [N] at hn_ge_N; omega
  have hK2_le_n : K ^ 2 ≤ (n : ℝ) := by
    have h1 : K ^ 2 ≤ (Nat.ceil (K ^ 2) : ℝ) := Nat.le_ceil _
    have h2 : (Nat.ceil (K ^ 2) : ℝ) ≤ (N : ℝ) := by
      exact_mod_cast (by dsimp [N]; omega : Nat.ceil (K ^ 2) ≤ N)
    have h3 : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_N
    linarith
  have hK_le_s : K ≤ s := by
    have hsq := Real.sqrt_le_sqrt hK2_le_n
    rwa [Real.sqrt_sq hK_nn] at hsq
  have hs_big : (4000000 : ℝ) ≤ s := by
    have : (0 : ℝ) ≤ 2 / γ := by positivity
    dsimp [K] at hK_le_s; linarith
  have hs_gam : 2 / γ ≤ s := by
    dsimp [K] at hK_le_s; linarith
  -- Convert `hindsightValue - frTail` to `treeExp` of `piValue - histRev`.
  have hho := hindsightValue_eq_treeExp_piValue r₁ r₂ hr₂ hr (canonicalPolicy T) T
  have hfr := frTail_eq_treeExp_histRev r₁ r₂ hr₂ hr sel hsel T
  let I := tcInst r₁ r₂ hr₂ hr
  change hindsightValue I (T : ℝ) (initialCapacity T) -
    frTail I sel T (initialCapacity T) ≥ M * Real.sqrt (T : ℝ)
  rw [hho, hfr]
  have hp := validProb_canonicalPolicy T
  have hr₁ : 0 < r₁ := lt_trans hr₂ hr
  let F_pi : History → ℝ := fun h =>
    RLPBidPrice.Unbiased.piValue I.A I.r (initialCapacity T)
      ![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)]
  have hFpi_int : TreeIntegrable (canonicalPolicy T) T [] F_pi := by
    refine (treeExp_bdd hp T [] (r₁ * (T : ℝ)) (by positivity) fun h => ?_).1
    have hy₀ : 0 ≤ (![(histOffered 0 h : ℝ), (histOffered 1 h : ℝ)] : Fin 2 → ℝ) := by
      intro j; rcases fin2_eq_or j with rfl | rfl <;> simp
    rw [abs_of_nonneg (piValue_tcInst_nonneg r₁ r₂ hr₂ hr T _ hy₀)]
    exact piValue_tcInst_le r₁ r₂ hr₂ hr T _ hy₀
  have hRev_int : TreeIntegrable (canonicalPolicy T) T [] (histRev T r₁ r₂) := by
    refine (treeExp_bdd hp T [] (r₁ * (T : ℝ)) (by positivity) fun h => ?_).1
    rw [abs_of_nonneg (histRev_nonneg r₁ r₂ hr₂ hr T h)]
    exact histRev_le r₁ r₂ hr₂ hr T h
  rw [← (treeExp_sub hp T [] hFpi_int hRev_int).2]
  let F_ind : History → ℝ := fun h => ((r₁ - r₂) * s / 6) * indR (EventG T h)
  have hFind_int : TreeIntegrable (canonicalPolicy T) T [] F_ind :=
    (treeExp_mul_left hp T [] _ (treeIntegrable_indR hp T [] _)).1
  have hdom : ∀ h, ExtSupported (canonicalPolicy T) T [] h →
      F_ind h ≤ F_pi h - histRev T r₁ r₂ h := by
    intro h hsupp
    have hlen : h.length = T := by simpa using hsupp.length_eq
    exact pointwise_loss_bound r₁ r₂ hr₂ hr T h hlen
  have hgap_ge : ((r₁ - r₂) * s / 6) * (γ * Real.exp (-2) / 4000) ≤
      treeExp (canonicalPolicy T) T [] (fun h => F_pi h - histRev T r₁ r₂ h) := by
    have h1 := treeExp_mono_of_support hp T [] hFind_int
      (treeExp_sub hp T [] hFpi_int hRev_int).1 hdom
    dsimp [F_ind] at h1
    rw [(treeExp_mul_left hp T [] _ (treeIntegrable_indR hp T [] _)).2] at h1
    have hpG := prob_EventG_ge T hs_big hs_gam
    have hcoef_nn : 0 ≤ (r₁ - r₂) * s / 6 := by
      have : 0 ≤ s := Real.sqrt_nonneg _
      positivity
    exact le_trans (mul_le_mul_of_nonneg_left hpG hcoef_nn) h1
  -- Finally, `Real.sqrt T ≤ 2 * s` since `T ≤ 4 * n`.
  have hsqrtT : Real.sqrt (T : ℝ) ≤ 2 * s := by
    have hT_le_4n : (T : ℝ) ≤ 4 * (n : ℝ) := by
      have hdiv := Nat.div_add_mod T 3
      have hmod := Nat.mod_lt T (by norm_num : 0 < 3)
      have hnat : T ≤ 4 * n := by omega
      exact_mod_cast hnat
    have hsq := Real.sqrt_le_sqrt hT_le_4n
    have h4 : Real.sqrt (4 * (n : ℝ)) = 2 * s := by
      rw [Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
      have : Real.sqrt 4 = 2 := by norm_num
      rw [this]
    rwa [h4] at hsq
  exact final_loss_arithmetic _ (r₁ - r₂) s γ (Real.exp (-2)) (Real.sqrt (T : ℝ))
    hδ hγ heta hsqrtT hgap_ge
