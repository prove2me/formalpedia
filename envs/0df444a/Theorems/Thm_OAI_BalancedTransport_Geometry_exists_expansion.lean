open OAI OAI.BalancedTransport OAI.BalancedTransport.Geometry
open Set
variable {ι : Type*} [Fintype ι]

theorem OAI.BalancedTransport.Geometry.exists_expansion {a b : ι → Space} (ha : Function.Injective a)
    (hb : Function.Injective b) {D R : ℝ} (hD : 0 ≤ D) :
    ∃ Λ : ℝ, 1 ≤ Λ ∧ R + 2 ≤ Λ ∧
      CenterSeparated (fun i k => Λ * a i k) D ∧
      CenterSeparated (fun i k => Λ * b i k) D := by sorry
