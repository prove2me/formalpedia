  have tK := free_top (s0 := s0) fK hGK (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33)
    [(j : ℤ) + 1] X
  have h1 := pushP s0 (tbS G [(j : ℤ) + 1] X) (i := 44) (e := .reg iK) (v := K) (A := A) (D := DD)
    (by decide) (fun r hr => by simp [Ex.regs] at hr; subst hr; exact fK.1) tK.2 tK.1
    (fun r hr => by simp [Ex.regs] at hr; subst hr; rw [tK.1]; exact hKA) hA
    (by simp [J6Seg.PreT.Poly]) (by simp [J6Seg.PreT.dg, DD])
  simp only [tbS] at h1
  (simp only [J6Seg.Src.bS_13, J6Seg.Src.bS_14, J6Seg.Src.bS_15, J6Seg.Src.bS_30, J6Seg.Src.bS_31, J6Seg.Src.bS_32, J6Seg.Src.bS_33, J6Seg.Src.bS_43, J6Seg.Src.bS_44, J6Seg.Src.bS_upd_13, J6Seg.Src.bS_upd_14, J6Seg.Src.bS_upd_15, J6Seg.Src.bS_upd_30, J6Seg.Src.bS_upd_31, J6Seg.Src.bS_upd_32, J6Seg.Src.bS_upd_33, J6Seg.Src.bS_upd_43, J6Seg.Src.bS_upd_44] at h1)
  obtain ⟨Y, hY⟩ : ∃ Y, Y = bS G (G 13) (G 14) (G 15) (G 30) (G 31) (G 32) (G 33) [(j : ℤ) + 1]
      (K :: X) := ⟨_, rfl⟩
  rw [← hY] at h1
  have tS : (encK s0 Y).top iS = s ∧ (encK s0 Y).IsInt iS := by
    rw [hY]; exact free_top fS hGS _ _ _ _ _ _ _ _ _
  have tT : (encK s0 Y).top iT = t ∧ (encK s0 Y).IsInt iT := by
    rw [hY]; exact free_top fT hGT _ _ _ _ _ _ _ _ _
  have t43 : (encK s0 Y).top 43 = (j : ℤ) + 1 := topv (by rw [hY, bS_43])
  have i43 : (encK s0 Y).IsInt 43 := isInt_encK (by rw [hY, bS_43])
  have hv : (selE iS iT).eval (encK s0 Y) = J6Seg.Slab.code (J6Seg.selSrc s t j) := by
    simp only [selE, rrE, jB, Ex.eval, tS.1, tT.1, t43]
    unfold J6Seg.selSrc J6Seg.rowSel
    by_cases h : j < s
    · rw [if_pos (by omega), if_pos h]
      simp only [J6Seg.Slab.code]; push_cast; ring_nf
    · rw [if_neg (by omega), if_neg h]; rfl
  have hok : (selE iS iT).ok (encK s0 Y) := by
    simp only [selE, rrE, jB, Ex.ok, Ex.eval, tS.1, tT.1, t43]
    refine ⟨⟨⟨i43, trivial⟩, tS.2⟩, ?_⟩
    split_ifs with h
    · refine ⟨⟨⟨⟨trivial, tT.2⟩, i43, trivial⟩, tS.2⟩, ⟨trivial, tS.2⟩, ?_, ?_⟩
      · have : (0 : ℤ) ≤ (j : ℤ) + 1 + -1 := by omega
        positivity
      · have : (0 : ℤ) < s := by exact_mod_cast hs
        omega
  have hR : RB (encK s0 Y) A (selE iS iT) := fun r hr => by
    rcases selE_regs iS iT r hr with rfl | rfl | rfl
    · rw [tS.1]; exact abs_nat_le hsA
    · rw [tT.1]; exact abs_nat_le htA
    · rw [t43]; have := abs_nat_le hjA; push_cast at this; exact this
  obtain ⟨hp, hd, hsz⟩ := selE_poly iS iT
  have h2 := pushP s0 Y (i := 44) (e := selE iS iT) (v := J6Seg.Slab.code (J6Seg.selSrc s t j)) (A := A)
    (D := DD) (by decide)
    (fun r hr => by rcases selE_regs iS iT r hr with rfl | rfl | rfl; exacts [fS.1, fT.1, by decide])
    hok hv hR hA hp hd
  rw [hY] at h2 h1
  (simp only [J6Seg.Src.bS_13, J6Seg.Src.bS_14, J6Seg.Src.bS_15, J6Seg.Src.bS_30, J6Seg.Src.bS_31, J6Seg.Src.bS_32, J6Seg.Src.bS_33, J6Seg.Src.bS_43, J6Seg.Src.bS_44, J6Seg.Src.bS_upd_13, J6Seg.Src.bS_upd_14, J6Seg.Src.bS_upd_15, J6Seg.Src.bS_upd_30, J6Seg.Src.bS_upd_31, J6Seg.Src.bS_upd_32, J6Seg.Src.bS_upd_33, J6Seg.Src.bS_upd_43, J6Seg.Src.bS_upd_44] at h2)
  have e : J6Seg.Slab.code (J6Seg.selSrc s t j) :: K :: X = tlT (J6Seg.selSrc s t) (fun _ => K) n' j ++ G 44 := by
    rw [tlT_pred hj, hX]; rfl
