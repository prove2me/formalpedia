    rw [r0, H.run, hne', Int.toNat_natCast, min_eq_right hμ]

theorem srch_cost (s : IState HS) (m C : Fin HS) (hmC : m ≠ C) (n c : Ex HS) (hnm : m ∉ n.regs)
    (N μ : ℕ) (hne : n.eval s = N) (hμ : μ ≤ N) (hcC : C ∉ c.regs)
