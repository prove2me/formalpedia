  have key : ((Φ m).restrict (hΦA m)).comp ψe.toLinearMap =
      ψe.toLinearMap.comp (φH.toLinearMap.restrict hprim) := by
    ext x
    change (Φ m (ψ x : H)) = (ψ ⟨φH x, hprim _ x.2⟩ : H)
    rw [hψ, hψ]
    exact hinter x
  have hconj : (Φ m).restrict (hΦA m) = ψe.conj (φH.toLinearMap.restrict hprim) := by
    rw [LinearEquiv.conj_apply, ← key, LinearMap.comp_assoc]
    ext a
    simp
  rw [hconj, LinearMap.trace_conj']
  exact htr

