theorem exists_projector (M K : ℕ) :
    letI := heckeModuleBar p
    ∃ r : ℕ, M ≤ r ∧ ∃ ρ : HeckeAlg, ρ - 1 ∈ (eisensteinMaximalIdeal p 2) ^ r ∧
      ∀ y : JZero p, 2 ^ K • y = 0 → ρ • y ∈ eisensteinTorsionBar p 2 r := by
  letI := heckeModuleBar p
  set P : Ideal HeckeAlg := eisensteinMaximalIdeal p 2 with hP

  let V : Submodule HeckeAlg (JZero p) :=
    Submodule.torsionBy HeckeAlg (JZero p) ((2 ^ K : ℕ) : HeckeAlg)
  have hmemV : ∀ y : JZero p, y ∈ V ↔ 2 ^ K • y = 0 := by
    intro y
    rw [Submodule.mem_torsionBy_iff, Nat.cast_smul_eq_nsmul]
  haveI hfinT : Finite ↥(AlgebraicCurve.Pic0.torsion Qbar (modularFunctionFieldBar p) (2 ^ K)) :=
    jZeroTorsionFinite p (2 ^ K) (Nat.pos_of_ne_zero (NeZero.ne _))
  haveI hVfin : Finite ↥V := by
    refine Finite.of_injective
      (fun v : ↥V =>
        (⟨(v : JZero p), ?_⟩ :
          ↥(AlgebraicCurve.Pic0.torsion Qbar (modularFunctionFieldBar p) (2 ^ K)))) ?_
    · rw [AlgebraicCurve.Pic0.mem_torsion, natCast_zsmul]
      exact (hmemV _).1 v.2
    · intro a b h
      exact Subtype.ext (congrArg Subtype.val h :)
  haveI : IsArtinian HeckeAlg ↥V := isArtinian_of_finite

  let f : ℕ →o (Submodule HeckeAlg ↥V)ᵒᵈ :=
    ⟨fun j => OrderDual.toDual (P ^ j • (⊤ : Submodule HeckeAlg ↥V)), by
      intro j j' hjj'
      change P ^ j' • (⊤ : Submodule HeckeAlg ↥V) ≤ P ^ j • ⊤
      exact Submodule.smul_mono_left (Ideal.pow_le_pow_right hjj')⟩
  obtain ⟨r₀, hr₀⟩ := IsArtinian.monotone_stabilizes f
  have hf : ∀ j, r₀ ≤ j → P ^ j • (⊤ : Submodule HeckeAlg ↥V) = P ^ r₀ • ⊤ := by
    intro j hj
    have h := hr₀ j hj
    exact (OrderDual.toDual.injective h).symm
  obtain ⟨r, -, hMr, hr₀r⟩ : ∃ r : ℕ, r = r₀ + M ∧ M ≤ r ∧ r₀ ≤ r :=
    ⟨r₀ + M, rfl, Nat.le_add_left M r₀, Nat.le_add_right r₀ M⟩

  have hWW : P ^ r • (P ^ r • (⊤ : Submodule HeckeAlg ↥V)) = P ^ r • ⊤ := by
    rw [← Submodule.mul_smul, ← pow_add, hf (r + r) (le_trans hr₀r (Nat.le_add_right r r)),
      hf r hr₀r]
  haveI hWfin : Finite ↥(P ^ r • (⊤ : Submodule HeckeAlg ↥V)) :=
    Finite.of_injective (fun w => (w : ↥V)) Subtype.coe_injective
  have hWfg : (P ^ r • (⊤ : Submodule HeckeAlg ↥V)).FG :=
    Module.Finite.iff_fg.1 Module.Finite.of_finite
  obtain ⟨ρ, hρ1, hρW⟩ :=
    Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul (P ^ r) _ hWfg hWW.symm.le
  refine ⟨r, hMr, ρ, hρ1, ?_⟩
  intro y hy
  rw [mem_eisensteinTorsionBar_iff]
  intro t ht
  have hyV : y ∈ V := (hmemV y).2 hy
  have htv : t • (⟨y, hyV⟩ : ↥V) ∈ P ^ r • (⊤ : Submodule HeckeAlg ↥V) :=
    Submodule.smul_mem_smul ht Submodule.mem_top
  have h0 : ρ • (t • (⟨y, hyV⟩ : ↥V)) = 0 := hρW _ htv
  have h0' : ((ρ • (t • (⟨y, hyV⟩ : ↥V)) : ↥V) : JZero p) = 0 := by
    rw [h0]; rfl
  rw [Submodule.coe_smul, Submodule.coe_smul] at h0'
  change ρ • t • y = 0 at h0'
  rw [← mul_smul, mul_comm, mul_smul]
  exact h0'

def connectedPart : AddSubgroup (JZero p) where
  carrier := {x | (∃ M : ℕ, x ∈ eisensteinTorsionBar p 2 M) ∧ reductionModL B p x = 0}
  zero_mem' := ⟨⟨0, AddSubgroup.zero_mem _⟩, map_zero _⟩
  add_mem' := by
    rintro a b ⟨⟨M, hM⟩, ha⟩ ⟨⟨M', hM'⟩, hb⟩
    refine ⟨⟨M + M', AddSubgroup.add_mem _ (eisensteinTorsionBar_mono p 2 (by omega) hM)
      (eisensteinTorsionBar_mono p 2 (by omega) hM')⟩, ?_⟩
    rw [map_add, ha, hb, add_zero]
  neg_mem' := by
    rintro a ⟨⟨M, hM⟩, ha⟩
    exact ⟨⟨M, AddSubgroup.neg_mem _ hM⟩, by rw [map_neg, ha, neg_zero]⟩

theorem mem_connectedPart_iff (x : JZero p) :
    x ∈ connectedPart p B ↔
      (∃ M : ℕ, x ∈ eisensteinTorsionBar p 2 M) ∧ reductionModL B p x = 0 :=
  Iff.rfl

include h2n hB in

theorem content :
    ∃ C : AddSubgroup (JZero p),
      (∀ c ∈ C, ∃ M : ℕ, c ∈ eisensteinTorsionBar p 2 M) ∧
      (∀ c ∈ C, ∃ c' ∈ C, 2 • c' = c) ∧
      (∀ (k : ℕ) (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ),
          (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
            ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ k) = 1 → σ ζ = ζ ^ n σ) →
          ∀ σ ∈ B.inertiaSubgroupIn ℚ, ∀ c ∈ C, 2 ^ k • c = 0 → σ • c = n σ • c) ∧
      (∀ σ ∈ B.inertiaSubgroupIn ℚ, ∀ M : ℕ, ∀ x ∈ eisensteinTorsionBar p 2 M,
          σ • x - x ∈ C) := by
  letI := heckeModuleBar p
  have hRI := reductionInputs p h2n B hB
  refine ⟨connectedPart p B, ?_, ?_, ?_, ?_⟩
  ·
    rintro c ⟨hM, -⟩
    exact hM
  ·
    rintro c ⟨⟨M, hcM⟩, hcred⟩
    obtain ⟨y, hy2, hyred⟩ := exists_half p h2n B hB c hcred
    have hyK : 2 ^ (M + 1) • y = 0 := by
      rw [pow_succ, mul_nsmul', hy2]
      exact nsmul_eq_zero_of_mem p 2 M hcM
    obtain ⟨r, hMr, ρ, hρ1, hρ⟩ := exists_projector p M (M + 1)
    refine ⟨ρ • y, ⟨⟨r, hρ y hyK⟩, reductionModL_smul_eq_zero p h2n B hB ρ y hyred⟩, ?_⟩
    have hρc : ρ • c = c := by
      have h1 : (ρ - 1) • c = 0 :=
        (mem_eisensteinTorsionBar_iff p 2 M c).1 hcM _ (Ideal.pow_le_pow_right hMr hρ1)
      rwa [sub_smul, one_smul, sub_eq_zero] at h1
    rw [smul_comm (2 : ℕ) ρ y, hy2, hρc]
  ·
    rintro k n hn σ hσ c ⟨⟨M, hcM⟩, hcred⟩ h2k
    obtain ⟨n', hn', hcong⟩ := exists_cyclotomicExponent (M + k)
    have hc' : c ∈ eisensteinTorsionBar p 2 (M + k) ⊓ (reductionModL B p).ker :=
      AddSubgroup.mem_inf.2 ⟨eisensteinTorsionBar_mono p 2 (by omega) hcM,
        (AddMonoidHom.mem_ker).2 hcred⟩
    have h := multiplicativeTypeNat_inf_ker_reductionModL_eisensteinTorsionBar p h2n B hB hRI
      (M + k) n' hn' σ hσ c hc'
    rw [h]
    exact (nsmul_eq_nsmul_of_modEq h2k (hcong k (by omega) n hn σ)).symm
  ·
    intro σ hσ M x hx
    refine ⟨⟨M, AddSubgroup.sub_mem _ (gal_smul_mem p 2 M σ hx) hx⟩, ?_⟩
    rw [map_sub, reductionModL_smul_eq_self_of_mem_inertiaSubgroupIn p B hRI σ hσ x, sub_self]

end Content

theorem main (p : ℕ) [Fact p.Prime]
    (B : ValuationSubring (AlgebraicClosure ℚ)) (hB : B.LiesOverPrime 2) :
    ∃ C : AddSubgroup (JZero p),
      (∀ c ∈ C, ∃ M : ℕ, c ∈ eisensteinTorsionBar p 2 M) ∧
      (∀ c ∈ C, ∃ c' ∈ C, 2 • c' = c) ∧
      (∀ (k : ℕ) (n : (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ) → ℕ),
          (∀ σ : AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ,
            ∀ ζ : AlgebraicClosure ℚ, ζ ^ (2 ^ k) = 1 → σ ζ = ζ ^ n σ) →
          ∀ σ ∈ B.inertiaSubgroupIn ℚ, ∀ c ∈ C, 2 ^ k • c = 0 → σ • c = n σ • c) ∧
      (∀ σ ∈ B.inertiaSubgroupIn ℚ, ∀ M : ℕ, ∀ x ∈ eisensteinTorsionBar p 2 M,
          σ • x - x ∈ C) := by
  by_cases h2n : 2 ∣ eisensteinNumerator p
  · exact content p h2n B hB
  ·
    have hcop : Nat.Coprime 2 (eisensteinNumerator p) :=
      (Nat.Prime.coprime_iff_not_dvd Nat.prime_two).2 h2n
    refine ⟨⊥, ?_, ?_, ?_, ?_⟩
    · intro c hc
      exact ⟨0, by rw [(AddSubgroup.mem_bot).1 hc]; exact AddSubgroup.zero_mem _⟩
    · intro c hc
      exact ⟨0, AddSubgroup.zero_mem _, by rw [(AddSubgroup.mem_bot).1 hc, nsmul_zero]⟩
    · intro k n _ σ _ c hc _
      rw [(AddSubgroup.mem_bot).1 hc, gal_smul_zero, nsmul_zero]
    · intro σ _ M x hx
      rw [eq_zero_of_coprime p 2 hcop M hx, gal_smul_zero, sub_zero]
      exact AddSubgroup.zero_mem _

end EisTwoConnectedPartSol

