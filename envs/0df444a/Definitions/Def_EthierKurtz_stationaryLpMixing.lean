-- title:
--   Stationary-sequence Lp mixing coefficient
-- statement:
--   The Lp distance from independence between the sigma-algebra generated by sequence coordinates through time zero and the sigma-algebra generated from lag m onward, defined as the supremum over future events of the Lp norm of conditional probability minus unconditional probability.
-- source:
--   Stewart N. Ethier and Thomas G. Kurtz, Markov Processes: Characterization and Convergence, Wiley, 1986. Chapter 7, equations (2.3) and (3.1), printed pp. 346 and 350 (PDF pp. 355 and 359).

import Mathlib

open MeasureTheory ProbabilityTheory Filter
open scoped ENNReal NNReal Topology BigOperators

namespace EthierKurtz

/-- Equations (2.3) and (3.1): Lp mixing between the future from m onwards
and the entire past through zero. The supremum is over future events;
conditional probabilities are conditional expectations of indicators. -/
noncomputable def stationaryLpMixing {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) (Y : ℤ → Ω → ℝ) (p : ℝ) (m : ℕ) : ℝ≥0∞ :=
  let past : MeasurableSpace Ω :=
    ⨆ k : {k : ℤ // k ≤ 0}, MeasurableSpace.comap (Y k.val) inferInstance
  let future : MeasurableSpace Ω :=
    ⨆ k : {k : ℤ // (m : ℤ) ≤ k}, MeasurableSpace.comap (Y k.val) inferInstance
  ⨆ A : {A : Set Ω // MeasurableSet[future] A},
    eLpNorm (fun ω =>
      (P[A.val.indicator (fun _ => (1 : ℝ)) | past]) ω - (P A.val).toReal)
      (ENNReal.ofReal p) P

end EthierKurtz


