-- title:
--   Uniformly finite exact gate generation
-- statement:
--   Fix a finite system of n≥1 positive-dimensional sites, its on-site symmetry representation, and 1≤k≤n. Let V_k be the subgroup generated by symmetric k-local unitaries. There is a finite integer B, depending on this fixed system, representation, and k, such that
--
--   $$\forall V\in V_k\quad V=V_1\cdots V_m,\qquad m\le B,$$
--
--   where each V_j is a symmetric k-local unitary. This is an exact finite-product bound uniform over the target V, without a polynomial complexity claim.
-- source:
--   Restrictions on realizable unitary operations imposed by symmetry and locality, arXiv:2003.05524v3, PDF p. 2, II.A / A.2: uniformly finite exact gate generation

import Definitions.Def_QAlgorithms_Papers_Independent_Extend50_P14

noncomputable section

namespace QAlgorithms.Papers.Independent.Extend50.P14

open scoped Classical Matrix ComplexConjugate Matrix.Norms.Frobenius

open MeasureTheory

-- Exact accepted aliases and physical operators, without local redeclarations.

open QAlgorithms.Papers.Independent.Information100.P60 (Mat)

open QAlgorithms.Papers.Independent.Advance50.P49 (onWire multiSwap)

attribute [local instance 100] LieRing.ofAssociativeRing

section General

variable {G : Type*} [Group G] {n : ℕ} {D : Fin n → Type*}

variable [∀ j, Fintype (D j)] [∀ j, DecidableEq (D j)] [hD : ∀ j, Nonempty (D j)]

-- Positive local dimensions are a physical standing assumption even when unused
-- in the displayed formula; include it in each theorem's elaborated binders.

include hD

/-- PDF pp.2,14: the finite bound depends on the system, representation and k,
but is chosen before the target V. Provenance: the paper cites control theory [17]. -/
theorem uniformly_finite_generation (hn : 1 ≤ n) (r : OnSite G D)
    (k : ℕ) (hk : 1 ≤ k) (hkn : k ≤ n) :
    ∃ B : ℕ, ∀ V ∈ symmetricLocalGroup r.total k,
      ∃ gates : List (Mat (SiteBasis D)), gates.length ≤ B ∧
        (∀ g ∈ gates, g ∈ localGates r.total k) ∧ gates.prod = V := by sorry

end General

end QAlgorithms.Papers.Independent.Extend50.P14

end
