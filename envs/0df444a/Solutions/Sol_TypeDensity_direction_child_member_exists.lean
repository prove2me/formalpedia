theorem solution (m : TypeDensity.ConcreteMember)
    (e : (TypeDensity.BlowupChart m.R m.S.t m.S.x ⧸ TypeDensity.chartExceptional m.R m.S.t m.S.x) ≃+* Polynomial
        (IsLocalRing.ResidueField m.R))
    (he : ∀ r : m.R, e (Ideal.Quotient.mk (TypeDensity.chartExceptional m.R m.S.t m.S.x)
        (TypeDensity.chartBase m.R m.S.t m.S.x r)) = Polynomial.C (IsLocalRing.residue m.R r))
    (heZ : e (Ideal.Quotient.mk (TypeDensity.chartExceptional m.R m.S.t m.S.x) (TypeDensity.chartSlope m.R m.S.t m.S.x)) =
        Polynomial.X)
    (hinf : (TypeDensity.infinityPoint m.R m.S.t m.S.x).IsPrime)
    (Dv : TypeDensity.ExceptionalDivisor (IsLocalRing.ResidueField m.R)) (d : ℕ) (Q : TypeDensity.divisorSupport Dv)
    (hb : Q.val = TypeDensity.infinityDirection (IsLocalRing.ResidueField m.R) → d < TypeDensity.stateContactT m.s)
    (hz : Q.val = TypeDensity.zeroDirection (IsLocalRing.ResidueField m.R) →
      ∀ h : ℕ, TypeDensity.stateContactX m.s = some h → d < h) :
    ∃ cm : TypeDensity.ChildMember m (TypeDensity.directionDegree (IsLocalRing.ResidueField m.R) Q.val)
        (TypeDensity.pointChildState (IsLocalRing.ResidueField m.R) m.s d Dv Q.val),
    ∃ Eq : TypeDensity.divisorLocalRing m.R m.S.t m.S.x e Dv hinf Q ≃+* cm.mc.R,
    Eq (TypeDensity.divisorException m.R m.S.t m.S.x e Dv hinf Q) = cm.mc.S.t ∧
    ((Q.val = TypeDensity.infinityDirection (IsLocalRing.ResidueField m.R) ∨ Q.val = TypeDensity.zeroDirection
        (IsLocalRing.ResidueField m.R)) → Eq (TypeDensity.divisorBoundary m.R m.S.t m.S.x e Dv hinf Q) =
        cm.mc.S.x) ∧
    ∀ r : m.O,
    Eq (TypeDensity.divisorFromSurface m.R m.S.t m.S.x e Dv hinf Q (algebraMap m.O m.R r)) = algebraMap cm.mc.O
        cm.mc.R (algebraMap m.O cm.mc.O r) := by
  refine TypeDensity.direction_child_member_of_eq m m.S.t m.S.x m.hS_t m.hS_x e (fun φ => ?_) hinf Dv d Q hb hz
  obtain ⟨h1, h2, h3, -, h5, -⟩ :=
