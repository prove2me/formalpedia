/-!
# Segmented inverse (S2): fixed-point primitives and elimination without pivoting

Fixed-point numbers of precision `P` are integers `a` standing for `a / 2^P`.
* `rq a b = ⌊a/b + 1/2⌋` (rounded quotient), `rs P a = rq a (2^P)`,
  `fmul P x y = rs P (x*y)` and `fdiv P x y = rq (x 2^P) y` (errors `≤ 1/2` ulp).
* `geSolve P L A b`: Gaussian elimination **without pivoting** in the order of the index list
  `L`, written as forward elimination of the head pivot followed by back substitution.
* `schur_row` (report L9): if every row of `A - I` has absolute sum `≤ η ≤ 1/2`, the same holds for
  the Schur complement after eliminating one pivot; hence for every Schur complement, and no
  pivoting is ever needed (any order, any sparsity pattern, cyclic borders included).
* `near_id`: `‖A - I‖_∞ ≤ η < 1` and `‖A z - r‖ ≤ ρ` give `‖z‖ ≤ (‖r‖ + ρ)/(1 - η)`.
* `geSolve_resid`: the computed solution has residual `≤ (Z+1)(|L|+1)²/2^P`;
  `geSolve_bound`: and `|z| ≤ 4B + 1`.
-/

open Finset

namespace J6Seg

lemma kd_self (i : ℕ) : kd i i = 1 := by simp [kd]
lemma kd_ne {i k : ℕ} (h : i ≠ k) : kd i k = 0 := by simp [kd, h]

/-! ### Gaussian elimination without pivoting -/

/-- **Schur lemma (report L9).** If every row of `a - I` on `j :: L` has absolute sum `≤ η ≤ 1/2`,
then so does every row of the Schur complement `a_ik - a_ij a_jk / a_jj` on `L`. -/
theorem schur_row_sol_aux {a : ℕ → ℕ → ℝ} {j : ℕ} {L : List ℕ} (hj : j ∉ L) {η : ℝ} (hη : η ≤ 1 / 2)
    (hrow : ∀ i ∈ j :: L, |a i j - kd i j| + ∑ k ∈ L.toFinset, |a i k - kd i k| ≤ η) :
    ∀ i ∈ L, ∑ k ∈ L.toFinset, |a i k - a i j * a j k / a j j - kd i k| ≤ η := by
  intro i hi
  have hij : i ≠ j := fun h => hj (h ▸ hi)
  have hrj := hrow j (List.mem_cons_self ..)
  have hri := hrow i (List.mem_cons_of_mem _ hi)
  rw [kd_self] at hrj
  rw [kd_ne hij, sub_zero] at hri
  have hjk : ∀ k ∈ L.toFinset, kd j k = 0 := fun k hk =>
    kd_ne (fun (h : j = k) => hj (h ▸ List.mem_toFinset.1 hk))
  have hR : ∑ k ∈ L.toFinset, |a j k - kd j k| = ∑ k ∈ L.toFinset, |a j k| :=
    sum_congr rfl fun k hk => by rw [hjk k hk, sub_zero]
  rw [hR] at hrj
  set R := ∑ k ∈ L.toFinset, |a j k|
  set A0 := |a j j - 1|
  have hA0 : 0 ≤ A0 := abs_nonneg _
  have hRn : 0 ≤ R := sum_nonneg fun _ _ => abs_nonneg _
  have hajj : 1 - A0 ≤ a j j := by
    have := neg_abs_le (a j j - 1); linarith
  have hajj' : 0 < a j j := by linarith
  have hsplit : ∀ k ∈ L.toFinset, |a i k - a i j * a j k / a j j - kd i k| ≤
      |a i k - kd i k| + |a i j| * |a j k| / a j j := by
    intro k _
    have : a i k - a i j * a j k / a j j - kd i k = (a i k - kd i k) - a i j * a j k / a j j := by
      ring
    rw [this]
    refine (abs_sub _ _).trans ?_
    rw [abs_div, abs_mul, abs_of_pos hajj']
  refine (sum_le_sum hsplit).trans ?_
  rw [sum_add_distrib, ← sum_div, ← mul_sum]
  show ∑ x ∈ L.toFinset, |a i x - kd i x| + |a i j| * R / a j j ≤ η
  have h1 : |a i j| * R / a j j ≤ |a i j| * η := by
    rw [div_le_iff₀ hajj', mul_assoc]
    apply mul_le_mul_of_nonneg_left _ (abs_nonneg _)
    nlinarith
  have h2 : |a i j| * η ≤ |a i j| := by
    have := abs_nonneg (a i j); nlinarith
  linarith

