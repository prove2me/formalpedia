  have hBb : Bb ≤ W := by omega
  set V := P * (Q * B)
  have hQB : Q ≤ Q * B := Nat.le_mul_of_pos_right _ hB
  have hPQ : P * Q ≤ V := Nat.mul_le_mul_left _ hQB
  have hP' : P ≤ P * Q := Nat.le_mul_of_pos_right _ hQ
  -- every term is a multiple of `P * Q * c * W`, `V * W`, `P * W`, `P * c * W`, `W`
  have e : (1 + 1) * 2000 * W + P * (((1 + 1) * 2000 * W + Q * B * (14000 * W) + 32) +
      (c * ((1 + 1) * 2000 * W + 32) + 1 + Q * B * (14000 * W)) + (1 + 1) * 2000 * W +
      ((1 + 1) * 2000 * W + Q * (c * ((3 + 1) * 2000 * W + (2 * Bb + 2) + 25) +
        ((1 + 1) * 2000 * W + B * (14000 * W) + 32) + (14 + 1) * 2000 * W + 8000 * W + 30) + 32)
      + (2 * Bb + 2) + 8000 * W + 30) + 32 + ((1 + 1) * 2000 * W + V * (14000 * W) + 32) =
      4000 * W + P * (4000 * W + 14000 * (Q * B * W) + 32 + 4000 * (c * W) + 32 * c + 1 +
        14000 * (Q * B * W) + 4000 * W + 4000 * W + Q * c * (8000 * W + 2 * Bb + 27) +
        Q * (4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30) + 32 + 2 * Bb + 2 +
        8000 * W + 30) + 32 + 4000 * W + 14000 * (V * W) + 32 := by ring
  rw [e]
  have h1 : P * (Q * c * (8000 * W + 2 * Bb + 27)) ≤ V * (20 * (8100 * W)) := by
    have : Q * c * (8000 * W + 2 * Bb + 27) ≤ Q * B * (20 * (8100 * W)) := by
      calc Q * c * (8000 * W + 2 * Bb + 27) ≤ Q * B * 20 * (8100 * W) :=
            Nat.mul_le_mul (Nat.mul_le_mul hQB hc20) (by omega)
        _ = _ := by ring
    calc _ ≤ P * (Q * B * (20 * (8100 * W))) := Nat.mul_le_mul_left _ this
      _ = _ := by ring
  have h2 : P * (Q * (4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30)) ≤
      V * (56100 * W) := by
    have : Q * (4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30) ≤
        Q * B * (56100 * W) := by
      have : 4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30 ≤ B * (56100 * W) := by
        nlinarith
      calc _ ≤ Q * (B * (56100 * W)) := Nat.mul_le_mul_left _ this
        _ = _ := by ring
    calc _ ≤ P * (Q * B * (56100 * W)) := Nat.mul_le_mul_left _ this
      _ = _ := by ring
  have h3 : P * (28000 * (Q * B * W)) = V * (28000 * W) := by ring
  have h4 : P * (4000 * (c * W) + 32 * c) ≤ V * (20 * 4100 * W) := by
    have : 4000 * (c * W) + 32 * c ≤ 20 * 4100 * W := by nlinarith
    calc _ ≤ P * (20 * 4100 * W) := Nat.mul_le_mul_left _ this
      _ ≤ V * (20 * 4100 * W) := Nat.mul_le_mul_right _ (le_trans hP' hPQ)
  have h5 : P * (4000 * W + 32 + 1 + 4000 * W + 4000 * W + 32 + 2 * Bb + 2 + 8000 * W + 30) ≤
      V * (21000 * W) := by
    have : 4000 * W + 32 + 1 + 4000 * W + 4000 * W + 32 + 2 * Bb + 2 + 8000 * W + 30 ≤
        21000 * W := by omega
    calc _ ≤ P * (21000 * W) := Nat.mul_le_mul_left _ this
      _ ≤ V * (21000 * W) := Nat.mul_le_mul_right _ (le_trans hP' hPQ)
  have e2 : P * (4000 * W + 14000 * (Q * B * W) + 32 + 4000 * (c * W) + 32 * c + 1 +
        14000 * (Q * B * W) + 4000 * W + 4000 * W + Q * c * (8000 * W + 2 * Bb + 27) +
        Q * (4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30) + 32 + 2 * Bb + 2 +
        8000 * W + 30) =
      P * (28000 * (Q * B * W)) + P * (4000 * (c * W) + 32 * c) +
        P * (Q * (c * (8000 * W + 2 * Bb + 27))) +
        P * (Q * (4000 * W + 14000 * (B * W) + 32 + 30000 * W + 8000 * W + 30)) +
        P * (4000 * W + 32 + 1 + 4000 * W + 4000 * W + 32 + 2 * Bb + 2 + 8000 * W + 30) := by
    ring
  rw [e2]
  have h1' : P * (Q * (c * (8000 * W + 2 * Bb + 27))) ≤ V * (20 * (8100 * W)) := by
    rw [← mul_assoc Q]; exact h1
  have e3 : 10 ^ 7 * (V + 1) * W = 10 ^ 7 * (V * W) + 10 ^ 7 * W := by ring
  have e4 : V * (20 * (8100 * W)) = 162000 * (V * W) := by ring
  have e5 : V * (56100 * W) = 56100 * (V * W) := by ring
  have e6 : V * (28000 * W) = 28000 * (V * W) := by ring
  have e7 : V * (20 * 4100 * W) = 82000 * (V * W) := by ring
  have e8 : V * (21000 * W) = 21000 * (V * W) := by ring
  rw [e3]
  omega

section ShiftU

open AModelL12

variable {sh : Shape} {n Q : ℕ} (Λ : Layout sh n Q)

/-- **Any coefficient `u`.** -/
theorem shiftArr_u_eq [NeZero Q] {α : Type*} (i : Fin n) (u : ZMod Q) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (d : α) (xs : List α) :
    shiftArr Λ i u c d xs =
      AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (uAddr Q u (offs Λ c A)) d xs := by
  have hv : AModel.vol sh = AModel.vol [AModel.vol A, Q, AModel.vol C] := by
    rw [hsh, vol_append, vol_cons]; simp [AModel.vol]
  unfold shiftArr
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  have hval := valid_decode h2
  obtain ⟨p, y, b, hdec, hp, hy, hb⟩ : ∃ p y b, decode [AModel.vol A, Q, AModel.vol C] j = [p, y, b] ∧
      p < AModel.vol A ∧ y < Q ∧ b < AModel.vol C := by
    generalize decode [AModel.vol A, Q, AModel.vol C] j = D at hval
    rcases hval with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
    cases h
    exact ⟨_, _, _, rfl, hp, hy, hb⟩
  have hj : j = (p * Q + y) * AModel.vol C + b := by
    rw [← encode_decode h2, hdec]; simp [encode, AModel.vol]; ring
  have hlA : (decode A p).length = A.length := length_decode _ _
  have hDv : Valid sh (decode A p ++ y :: decode C b) := by
    rw [hsh]; exact valid_append (valid_decode hp) (List.Forall₂.cons hy (valid_decode hb))
  have henc : ∀ w, encode sh (decode A p ++ w :: decode C b) = (p * Q + w) * AModel.vol C + b := by
    intro w
    rw [hsh, encode_append_len _ _ hlA, encode_decode hp]
    simp only [encode, List.headD_cons, List.tail_cons, encode_decode hb, vol_cons]; ring
  have hdD : decode sh j = decode A p ++ y :: decode C b := by
    rw [← decode_encode hDv, henc, hj]
  rw [hdD, hdec, shiftInv_split_u Λ i u c hc _ _ y (by rw [hA, hlA]) hDv, henc]
  simp [uAddr, encode, AModel.vol, offs]
  ring_nf

theorem valid_refAddr {P Q B : ℕ} (hQ : 0 < Q) (as : ℕ → ℕ) (a : List ℕ) (h : Valid [P, Q, B] a) :
    Valid [P, Q, B] (refAddr Q as a) := by
  rcases h with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  exact List.Forall₂.cons hp (List.Forall₂.cons (Nat.mod_lt _ hQ) (List.Forall₂.cons hb .nil))

theorem cast_ref [NeZero Q] (y : ℕ) (hy : y < Q) (s : ZMod Q) :
    (((s.val + Q - y) % Q : ℕ) : ZMod Q) = s - (y : ZMod Q) := by
  rw [ZMod.natCast_mod, Nat.cast_sub (by omega), Nat.cast_add, ZMod.natCast_self, add_zero,
    ZMod.natCast_zmod_val]

/-- **`u = -c`: reflection after the multiplicative permutation.** -/
theorem shiftArr_negmul_eq [NeZero Q] (i : Fin n) (c : Fin n → ZMod Q)
    (hc : ∀ j, i ≤ j → c j = 0) (A C : Shape) (hsh : sh = A ++ Q :: C)
    (hA : (Λ.pos i : ℕ) = A.length) (k : ℕ) (hk : 0 < k) (hQk : Nat.Coprime Q k) (xs : List ℤ) :
    shiftArr Λ i (-(k : ZMod Q)) c 0 xs =
      shiftArr Λ i (-1) c 0 (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (mulAddr Q k) 0 xs) := by
  have hQ : 0 < Q := Nat.pos_of_ne_zero (NeZero.ne Q)
  have hu : IsUnit (k : ZMod Q) := (ZMod.isUnit_iff_coprime k Q).2 hQk.symm
  have hinv : (-(k : ZMod Q))⁻¹ = -((k : ZMod Q)⁻¹) :=
    ZMod.inv_eq_of_mul_eq_one _ _ _ (by rw [neg_mul_neg, ZMod.mul_inv_of_unit _ hu])
  rw [shiftArr_neg_eq_ref Λ i c hc A C hsh hA, pull_comp _ _ (valid_refAddr hQ _),
    shiftArr_u_eq Λ i _ c hc A C hsh hA]
  refine pull_congr (fun a ha => ?_) _ _
  rcases ha with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
  cases h
  simp only [Function.comp_apply, refAddr, mulAddr, uAddr, List.getD_cons_zero,
    List.getD_cons_succ]
  rw [yOf_eq hk hQk _ (Nat.mod_lt _ hQ), offs, cast_ref _ hy, hinv]
  congr 1
  simp only [ZMod.natCast_val, ZMod.cast_id', id]
  ring_nf

theorem mul_stage [NeZero Q] (A C : Shape) (hsh : sh = A ++ Q :: C) (k : ℕ) (hk2 : 2 ≤ k)
    (hk20 : k ≤ 20) (hkQ : k < Q) (hQk : Nat.Coprime Q k) (t : IState HS) (xs : List ℤ) (Bb : ℕ)
    (R : List Item) (hlen : xs.length = AModel.vol sh) (hb : Bnd Bb xs) (hB1 : 1 ≤ AModel.vol C) (hQ1 : 1 ≤ Q)
    (hP1 : 1 ≤ AModel.vol A) (hV : zsz ((AModel.vol A * (Q * AModel.vol C) : ℕ) : ℤ) ≤ Bb)
    (hQ2 : zsz ((2 * Q : ℕ) : ℤ) ≤ Bb) (h0 : t.G 0 = ints xs ++ R) :
    Sp (mulPc (AModel.vol A) Q k (AModel.vol C)) t
      (t.upd 0 (ints (AModel.pull [AModel.vol A, Q, AModel.vol C] [AModel.vol A, Q, AModel.vol C] (mulAddr Q k) 0 xs) ++ R))
      (10 ^ 7 * (AModel.vol A * (Q * AModel.vol C) + 1) * (Bb + 2)) := by
  set V := AModel.vol A * (Q * AModel.vol C)
  have hle : ∀ m : ℕ, m ≤ V → zsz (m : ℤ) ≤ Bb := fun m hm => le_trans (NLogN.KIL.zsz_nat_le hm) hV
  have zA := hle (AModel.vol A) (Nat.le_mul_of_pos_right _ (Nat.mul_pos (by omega) (by omega)))
  have zQB := hle (Q * AModel.vol C) (Nat.le_mul_of_pos_left _ hP1)
  have zQ := hle Q (le_trans (Nat.le_mul_of_pos_right _ (by omega)) (Nat.le_mul_of_pos_left _ hP1))
  have zC := hle (AModel.vol C) (le_trans (Nat.le_mul_of_pos_left _ (by omega))
    (Nat.le_mul_of_pos_left _ hP1))
  have hlen3 : xs.length = AModel.vol A * Q * AModel.vol C := by
    rw [hlen, hsh, vol_append, vol_cons]; ring
  exact (mulPc_spec t xs (AModel.vol A) Q k (AModel.vol C) Bb R hlen3 hb hk2 hk20 hQk zC
    (le_trans (NLogN.KIL.zsz_nat_le (by omega)) hQ2) zQ zQB zA hV h0).mono (cMulPc_le hk20 hQ1 hB1)

end ShiftU

