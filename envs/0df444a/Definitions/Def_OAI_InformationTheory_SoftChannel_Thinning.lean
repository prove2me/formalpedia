def thinningPolynomial (t u : ℝ) : ℝ :=
  3 * (2 - t * u - t ^ 2 * u ^ 2) -
    (2 * (2 + t * u) * (1 - t) - 3 * t * u ^ 2 * (1 - t * u)) *
      (1 + t * (3 - u))

def clipKernel (β v : ℝ) : ℝ := max (v - β) 0 / v ^ 2

open MeasureTheory

def clipPrimitive (β w : ℝ) : ℝ := ∫ v in (1 : ℝ)..w, clipKernel β v

