set_option autoImplicit false
open scoped Quaternion
open QuaternionAlgebra

theorem WeierstrassCurve.exists_supersingular_rationalEndSubring_range_eq_of_isMaximalOrder
    {κ : Type} [Field κ] [IsAlgClosed κ] [DecidableEq κ]
    (q' : ℕ) [Fact q'.Prime] [CharP κ q'] [Algebra (ZMod q') κ] [Algebra.IsAlgebraic (ZMod q') κ]
    (a b : ℚ) (hdef : IsDefiniteRamifiedExactlyAt a b q')
    (Λ : Submodule ℤ ℍ[ℚ, a, b]) (hΛ : IsMaximalOrder Λ) :
    ∃ (X₀ : WeierstrassCurve κ) (_ : X₀.IsElliptic),
      (∀ P : X₀.toAffine.Point, q' • P = 0 → P = 0) ∧
      ∃ θ : ↥(WeierstrassCurve.rationalEndSubring κ X₀) →+* ℍ[ℚ, a, b],
        Function.Injective θ ∧ Set.range θ = (Λ : Set ℍ[ℚ, a, b]) := by sorry
