theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨244641337180,245191092995⟩ ⟨748304196366,748399284391⟩ ⟨116190891265,128725323822⟩ := rfl
noncomputable def centerUpper : ℝ := (522773793661 / 1099511627776)
