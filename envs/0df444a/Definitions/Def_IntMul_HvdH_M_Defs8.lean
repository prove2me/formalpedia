/-! ## Popping a list of distinct registers -/

/-- `t` with the stacks `l` replaced by `L r`. -/
def upds (t : IState HS) (L : Fin HS → List Item) : List (Fin HS) → IState HS
  | [] => t
  | r :: l => (upds t L l).upd r (L r)

end NLogN.ST

