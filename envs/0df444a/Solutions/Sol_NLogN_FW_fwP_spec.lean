  have h1 := NLogN.FW.encL_spec M s q.P q.r N W U RU LCR LCM LRW LFR LNN hU hUl hUb hP hr1 hCR hCM hRW hFR
    hNN Q hPQ hrQ (by omega) hNW
  set s1 := (s.upd NLogN.GU RU).upd NLogN.FW.XD (NLogN.ints EA ++ s.G NLogN.FW.XD) with hs1
  -- stage 2: forward transform of U
  have h2 := NLogN.FW.passF_spec M q.fn kb W N q.e D hLD hfn1 hNkb hWW hJ hmW s1 EA (s.G NLogN.FW.XD) Rs LKBR LNN
    LXN LXF LNAX hEAl hEAc (by simp [hs1]) (by simp (config := {decide := true}) [hs1, hAXS, hD8])
    (by simp (config := {decide := true}) [hs1, hKBR])
    (by simp (config := {decide := true}) [hs1, hNN])
    (by simp (config := {decide := true}) [hs1, hXN])
    (by simp (config := {decide := true}) [hs1, hXF])
    (by simp (config := {decide := true}) [hs1, hNAX, hDl])
  set s2 := ((s1.upd NLogN.FW.XD (NLogN.ints FA ++ s.G NLogN.FW.XD)).upd NLogN.FW.AXS Rs).upd NLogN.FW.AXR (NLogN.ints D8.reverse ++ s1.G NLogN.FW.AXR)
    with hs2
  -- stage 3: park the transform of U on SA
  have h3 := NLogN.FW.spec_mv M NLogN.FW.XD NLogN.FW.SA NLogN.FW.C2 NLogN.FW.NN s2 FA (s.G NLogN.FW.XD) LNN (by decide) (by decide) (by decide)
    (by simp (config := {decide := true}) [hs2, hs1])
    (by rw [hFAl]; simp (config := {decide := true}) [hs2, hs1, hNN])
    (by decide) (by decide) (by decide) (by decide) W (by rw [hFAl]; exact hNW)
    (fun x hx => (NLogN.FW.canon_zsz hFAc x hx).trans (by omega))
  rw [hFAl] at h3
  set s3 := (s2.upd NLogN.FW.XD (s.G NLogN.FW.XD)).upd NLogN.FW.SA (NLogN.ints FA.reverse ++ s2.G NLogN.FW.SA) with hs3
  -- stage 4: encode V
  have h4 := NLogN.FW.encV_spec M s3 q.P q.r N W V RV LCR LCM LRW LFR LNN
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hV]) hVl hVb hP hr1
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hCR])
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hCM])
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hRW])
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hFR, ← hfn])
    (by simp (config := {decide := true}) [hs3, hs2, hs1, hNN]) Q hPQ hrQ (by omega) hNW
  set s4 := (s3.upd NLogN.FW.VI RV).upd NLogN.FW.XD (NLogN.ints EB ++ s3.G NLogN.FW.XD) with hs4
  -- stage 5: move the descriptors back from AXR to AXS
  have t4 : s4.G NLogN.FW.NAX = .int ((q.K - 1 : ℕ) : ℤ) :: LNAX := by
    simp (config := {decide := true}) [hs4, hs3, hs2, hs1, hNAX]
  have e4 := NLogN.IState.top_eq t4
  have hD8l : D8.reverse.length = 8 * (q.K - 1) := by
    rw [List.length_reverse, hD8, NLogN.FW.length_flatMap_enc8, hDl]
  have hK8 : 8 * (q.K - 1) ≤ 2 ^ (q.fn + 3) := by rw [pow_add]; norm_num; omega
  have h5 := NLogN.FW.spec_mvList M NLogN.FW.AXR NLogN.FW.AXS NLogN.FW.C2 NLogN.FW.c8E s4 D8.reverse (s.G NLogN.FW.AXR) (by decide) (by decide)
    (by decide) (by simp (config := {decide := true}) [hs4, hs3, hs2, hs1])
    (by rw [hD8l]; simp [NLogN.FW.c8E, NLogN.Ex.eval, e4]; ring)
    (by decide) (by decide) (by decide)
    (by intro i hi; simp [NLogN.FW.c8E, NLogN.Ex.regs] at hi; subst hi; simp (config := {decide := true}) [NLogN.zX_all])
    ⟨⟨LNAX, by rw [t4, e4]⟩, trivial, 3, by simp [NLogN.FW.c8E, NLogN.Ex.eval]⟩ W ⟨trivial, trivial⟩
    ⟨by simp only [NLogN.Ex.Bnd, e4]; exact (NLogN.FW.zsz_nat_le_pow hK2).trans (by omega),
      by simp only [NLogN.Ex.Bnd]; exact (NLogN.FW.zsz_nat_le_pow (x := 8) (kb := 3) (by norm_num)).trans (by omega),
      by simp only [NLogN.Ex.eval, e4]
         rw [show ((q.K - 1 : ℕ) : ℤ) * 8 = ((8 * (q.K - 1) : ℕ) : ℤ) by push_cast; ring]
         exact (NLogN.FW.zsz_nat_le_pow hK8).trans (by omega)⟩
    (fun x hx => by
      rw [List.mem_reverse, hD8, List.mem_flatMap] at hx
      obtain ⟨d, hd, hx⟩ := hx
      exact (pF d hd).1.bounds.2.2.2.2.2.2 x hx)
  rw [List.reverse_reverse, hD8l] at h5
  set s5 := (s4.upd NLogN.FW.AXR (s.G NLogN.FW.AXR)).upd NLogN.FW.AXS (NLogN.ints D8 ++ s4.G NLogN.FW.AXS) with hs5
  -- stage 6: forward transform of V
  have h6 := NLogN.FW.passF_spec M q.fn kb W N q.e D hLD hfn1 hNkb hWW hJ hmW s5 EB (s.G NLogN.FW.XD) Rs LKBR LNN
    LXN LXF LNAX hEBl hEBc (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hD8])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hKBR])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hNN])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hXN])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hXF])
    (by simp (config := {decide := true}) [hs5, hs4, hs3, hs2, hs1, hNAX, hDl])
  set s6 := ((s5.upd NLogN.FW.XD (NLogN.ints FB ++ s.G NLogN.FW.XD)).upd NLogN.FW.AXS Rs).upd NLogN.FW.AXR (NLogN.ints D8.reverse ++ s5.G NLogN.FW.AXR)
    with hs6
  -- stage 7: bring the transform of U to YC
  have h7 := NLogN.FW.spec_mv M NLogN.FW.SA NLogN.FW.YC NLogN.FW.C2 NLogN.FW.NN s6 FA.reverse (s.G NLogN.FW.SA) LNN (by decide) (by decide) (by decide)
    (by simp (config := {decide := true}) [hs6, hs5, hs4, hs3, hs2, hs1])
    (by rw [List.length_reverse, hFAl]
        simp (config := {decide := true}) [hs6, hs5, hs4, hs3, hs2, hs1, hNN])
    (by decide) (by decide) (by decide) (by decide) W (by rw [List.length_reverse, hFAl]; exact hNW)
    (fun x hx => (NLogN.FW.canon_zsz hFAc x (List.mem_reverse.1 hx)).trans (by omega))
  rw [List.reverse_reverse, List.length_reverse, hFAl] at h7
  set s7 := (s6.upd NLogN.FW.SA (s.G NLogN.FW.SA)).upd NLogN.FW.YC (NLogN.ints FA ++ s6.G NLogN.FW.YC) with hs7
  -- stage 8: pointwise products
  have h8 := NLogN.FW.pmL_spec M q.fn W N hMB s7 FA FB (s.G NLogN.FW.XD) (s.G NLogN.FW.YC) LNN LXN LXF hFAl hFBl hFAc hFBc
    (by simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1, hNN])
    (by simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXN])
    (by simp (config := {decide := true}) [hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXF])
    (by omega) hNW
  set s8 := (s7.upd NLogN.FW.XD (NLogN.ints PM ++ s.G NLogN.FW.XD)).upd NLogN.FW.YC (s.G NLogN.FW.YC) with hs8
  -- stage 9: inverse transform
  have h9 := NLogN.FW.passT_spec M q.fn kb W N q.e D.reverse hLD.reverse hfn1 hNkb hWW hJ
    (by rw [List.length_reverse]; exact hmW) s8 PM (s.G NLogN.FW.XD) (s.G NLogN.FW.AXR) LKBR LNN
    LXN LXF LNAX hPMl hPMc (by simp (config := {decide := true}) [hs8])
    (by rw [← NLogN.FW.flatMap_enc8_reverse, ← hD8]
        simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hKBR])
    (by simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hNN])
    (by simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXN])
    (by simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXF])
    (by simp (config := {decide := true}) [hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hNAX, hDl])
  rw [hD8r, List.length_reverse, hDl] at h9
  rw [hDl] at h2 h6
  set s9 := ((s8.upd NLogN.FW.XD (NLogN.ints CC ++ s.G NLogN.FW.XD)).upd NLogN.FW.AXR (s.G NLogN.FW.AXR)).upd NLogN.FW.AXS (NLogN.ints D8 ++ s8.G NLogN.FW.AXS)
    with hs9
  -- stage 10: scale and decode
  have h10 : NLogN.FW.Spec M NLogN.FW.dcL s9 ((s9.upd NLogN.FW.XD (s.G NLogN.FW.XD)).upd NLogN.KO (NLogN.gints X.reverse ++ s9.G NLogN.KO))
      (NLogN.FW.dcCost N q.r q.P Q W) :=
    NLogN.FW.dcL_spec M q.P q.r q.logOuter N W hP hr1 (by omega) s9 CC (s.G NLogN.FW.XD) LNN LSH LXN LXF LKB LKN
      LKR hCCl hCCc (by simp (config := {decide := true}) [hs9])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hNN])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hSH,
        ← hfn])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXN,
        ← hfn])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hXF,
        ← hfn])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hKB])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hKN,
        ← hfn])
      (by simp (config := {decide := true}) [hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hKR])
      (by omega) hNW Q hPQ hrQ
  set s10 := (s9.upd NLogN.FW.XD (s.G NLogN.FW.XD)).upd NLogN.KO (NLogN.gints X.reverse ++ s9.G NLogN.KO) with hs10
  -- stage 11: reverse the pairs onto OUT
  have hNe : N * 2 ^ q.e ≤ 2 ^ (kb + q.e) := by
    rw [hNd, ← pow_add]; exact Nat.pow_le_pow_right (by norm_num) (by omega)
  have h11 := NLogN.FW.mvPairs_spec M N q.e (NLogN.FW.fwW2 q kb) s10 X.reverse (s.G NLogN.KO) LNN LKR
    (by rw [List.length_reverse, hXl])
    (by simp (config := {decide := true}) [hs10, hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1])
    (by simp (config := {decide := true}) [hs10, hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hNN])
    (by rw [show ((2 ^ q.e : ℕ) : ℤ) = (q.r : ℤ) from rfl]
        simp (config := {decide := true}) [hs10, hs9, hs8, hs7, hs6, hs5, hs4, hs3, hs2, hs1, hKR])
    (fun p hp => by
      rw [List.mem_reverse, hX, List.mem_flatMap] at hp
      obtain ⟨z, _, hp⟩ := hp
      obtain ⟨b1, b2⟩ := NLogN.FW.decBlk_bound _ _ _ z p hp
      have h4 : (2 : ℤ) * 2 ^ q.P < 2 ^ (q.P + 2) := by
        rw [pow_add]; have : (0 : ℤ) < 2 ^ q.P := by positivity
        nlinarith
      exact ⟨(NLogN.zsz_le_of_abs_lt (b1.trans_lt h4)).trans (by rw [NLogN.FW.fwW2]; omega),
        (NLogN.zsz_le_of_abs_lt (b2.trans_lt h4)).trans (by rw [NLogN.FW.fwW2]; omega)⟩)
    ((NLogN.FW.zsz_nat_le_pow hNe).trans (by rw [NLogN.FW.fwW2]; omega))
    ((NLogN.FW.zsz_nat_le_pow hNkb).trans (by rw [NLogN.FW.fwW2]; omega)) (by rw [NLogN.FW.fwW2]; omega)
  rw [List.reverse_reverse] at h11
  have H := h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq (h8.seq (h9.seq
    (h10.seq h11)))))))))
  simp only [NLogN.FW.fwP, NLogN.RM.seqL]
  refine H.congr ?_ |>.mono ?_
  · rw [hfw]
    clear H h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 hfw
    clear_value s1 s2 s3 s4 s5 s6 s7 s8 s9 s10
    subst hs10 hs9 hs8 hs7 hs6 hs5 hs4 hs3 hs2 hs1
    clear * - hAXS
    ((apply NLogN.IState.ext' <;> intros <;> simp (config := {decide := true}) only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.withCtr] <;> split_ifs <;> simp_all (config := {decide := true})))
  · simp only [NLogN.FW.fwCost, ← hWd, ← hQd, ← hNd, NLogN.FW.c8E, NLogN.Ex.size]
    omega
end
