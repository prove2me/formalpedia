@[simp] theorem St.push_stk (σ : St S) (i j : Fin S) (a : Sym) :
    (σ.push i a).stk j = if j = i then a :: σ.stk i else σ.stk j := by
  simp [St.push, Function.update_apply]

theorem St.ext_iff' {σ τ : St S} :
    σ = τ ↔ (∀ j, σ.stk j = τ.stk j) ∧ σ.ip = τ.ip ∧ σ.out = τ.out := by
  constructor
  · rintro rfl; simp
  · rintro ⟨h1, h2, h3⟩; exact St.ext (funext h1) h2 h3

