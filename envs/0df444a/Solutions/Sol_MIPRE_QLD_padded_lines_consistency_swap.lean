/-- The expanded state's two halves are exchanged by the swap. -/
theorem hatVec_swapVec (ψ : dA × dB → ℂ) :
    hatVec (F := F) (m := m) (swapVec ψ) = swapVec (hatVec (F := F) (m := m) ψ) := by
