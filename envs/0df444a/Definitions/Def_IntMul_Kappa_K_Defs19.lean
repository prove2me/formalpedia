-- Source module: Solutions.KFNGate
/-!
# KFN: classification of the scalar gates of the complex network (task 1)

Every `RStep.gate G` of `P8Lift.complexIface.net` is one of the two kinds of fine IL gates of
KFG:

* a **dyadic atom gate** `G = gateMat W_c as` (`KFG.gateMat`: `1 + Σ_a (c_a/2^{h_a}) e_{t_a,s_a}`)
  for a list of atoms with `c_a ∈ {±1}`, `h_a ≤ 1`, every atom `Ok` and no target of the list a
  source of the list (`KFG.NoTS`), so `KFG.gate_iruns` applies; these are the side injections,
  scatters, copies and gathers of the schedule (2) of `NetComplexLemma5` and their inverses;
* the **sign gate** `fixG`, a diagonal `±1` matrix (one unit scaling `KFG.UAtom` with `u = -1`
  per physical `X` wire).

`GOK G`: `G = 1 + Σ_{x ∈ l} (ε_x / 2^{h_x}) e_{t_x, s_x}` with `ε_x = ±1`, `h_x ≤ 1`, targets
never sources.  `cxNamed_GOK`: every gate of `cxNamed` is `GOK`.  `GOK_atoms`: a `GOK` matrix
transported along `W ≃ Fin n` is `gateMat n as` for an `Ok`, `NoTS` atom list.
**`complexIface_gate_class`**: the classification of all gate steps of `complexIface`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option synthInstance.maxSize 512

namespace NLogN.KFN

open Matrix Finset Complex

section Generic

variable {W : Type*} [Fintype W] [DecidableEq W]

/-- The matrix of an elementary dyadic list. -/
noncomputable def eMat (l : List (W × W × ℤ × ℕ)) : Matrix W W ℂ :=
  (l.map fun x => single x.1 x.2.1 ((x.2.2.1 : ℂ) / 2 ^ x.2.2.2)).sum

/-- A dyadic elementary gate whose targets are never sources. -/
def GOK (G : Matrix W W ℂ) : Prop :=
  ∃ l : List (W × W × ℤ × ℕ), G = 1 + eMat l ∧ (∀ x ∈ l, ∀ y ∈ l, x.1 ≠ y.2.1) ∧
    ∀ x ∈ l, (x.2.2.1 = 1 ∨ x.2.2.1 = -1) ∧ x.2.2.2 ≤ 1

/-- The atoms of a `GOK` list, transported along `e : W ≃ Fin n`. -/
def atomsOf {n : ℕ} (e : W ≃ Fin n) (l : List (W × W × ℤ × ℕ)) : List KFG.Atom :=
  l.map fun x => ⟨(e x.1).val, (e x.2.1).val, (x.2.2.1, 0), x.2.2.2⟩

end Generic

