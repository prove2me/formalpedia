open DrinfeldCurve
open AlgebraicCurve

theorem DrinfeldCurve.natCard_mul_two_mul_genusFF_quotField_add_eq
    (q : ℕ) [Fact q.Prime] (k : Type) [Field k] [IsAlgClosed k] [Algebra (GaloisField q 2) k]
    [IsDomain (CoordRing q k)] (C : Subgroup (rootsOfUnity (q + 1) (GaloisField q 2))) :
    Nat.card C * (2 * genusFF k ↥(DrinfeldCurve.quotField q k C) + q) + 1 = q ^ 2 + Nat.card C := by sorry
