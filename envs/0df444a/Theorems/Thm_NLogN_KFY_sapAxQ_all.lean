    (st : IState HS) (L : List (ℤ × ℤ)) (Rest : List Item) (hR : SapRegsQ p s t α m st)
    (hD : st.G NLogN.GL.gD = gints L ++ Rest) (hL : L.length = m * t) (hLB : NLogN.GL.GB Bi L) :
