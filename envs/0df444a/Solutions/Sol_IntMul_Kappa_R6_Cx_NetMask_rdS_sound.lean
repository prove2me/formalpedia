/-! ## Bit vectors -/

lemma bvec_le (v u : ℕ) : bvec v u ≤ 1 := by unfold bvec; split_ifs <;> omega

/-! ## The run on coefficient vectors and its kernel form -/

lemma NR_lt : NR < 2 ^ 16 := by norm_num [NR]

/-! ## Placement of the inputs -/

/-! ## The readout check (bit-sliced counters) -/

lemma add1_cnt : ∀ (ps : List ℕ) (c u : ℕ), cnt ps u + bvec c u < 2 ^ ps.length →
    cnt (add1 ps c) u = cnt ps u + bvec c u
  | [], c, u, h => by
    simp only [cnt, add1, List.length_nil, pow_zero] at h ⊢
    have := bvec_le c u; omega
  | p :: ps, c, u, h => by
    simp only [cnt, List.length_cons, pow_succ] at h
    show bvec (Nat.xor p c) u + 2 * cnt (add1 ps (Nat.land p c)) u = bvec p u + 2 * cnt ps u + bvec c u
    have hb : bvec (Nat.xor p c) u + 2 * bvec (Nat.land p c) u = bvec p u + bvec c u := by
      simp only [bvec, show Nat.xor p c = p ^^^ c from rfl, show Nat.land p c = p &&& c from rfl,
        Nat.testBit_xor, Nat.testBit_and]
      cases p.testBit u <;> cases c.testBit u <;> rfl
    have h1 : cnt ps u + bvec (Nat.land p c) u < 2 ^ ps.length := by
      have : bvec (Nat.land p c) u ≤ bvec p u := by
        simp only [bvec, show Nat.land p c = p &&& c from rfl, Nat.testBit_and]
        cases p.testBit u <;> cases c.testBit u <;> simp
      have : bvec (Nat.land p c) u ≤ bvec c u := by
        simp only [bvec, show Nat.land p c = p &&& c from rfl, Nat.testBit_and]
        cases p.testBit u <;> cases c.testBit u <;> simp
      have := bvec_le p u; have := bvec_le c u
      have : bvec (Nat.land p c) u = 1 → bvec p u = 1 ∧ bvec c u = 1 := by omega
      by_cases e : bvec (Nat.land p c) u = 1
      · have := this e; omega
      · omega
    rw [add1_cnt ps _ u h1]
    omega

lemma addK_cnt (c u : ℕ) (ps : List ℕ) : ∀ k, cnt ps u + k < 2 ^ ps.length →
    cnt (addK c k ps) u = cnt ps u + k * bvec c u ∧ (addK c k ps).length = ps.length
  | 0, _ => by
    refine And.intro ?_ ?_
    · show cnt ps u = cnt ps u + 0 * bvec c u
      simp
    · rfl
  | k + 1, h => by
    have ih := addK_cnt c u ps k (by omega)
    have hl : (add1 (addK c k ps) c).length = (addK c k ps).length := by
      clear ih h
      generalize addK c k ps = l
      induction l generalizing c with
      | nil => rfl
      | cons p l ihl => simp [add1, ihl]
    show cnt (add1 (addK c k ps) c) u = _ ∧ (add1 (addK c k ps) c).length = _
    have hb := bvec_le c u
    have hlt : cnt (addK c k ps) u + bvec c u < 2 ^ (addK c k ps).length := by
      rw [ih.1, ih.2]; nlinarith
    rw [add1_cnt _ c u hlt, ih.1, hl, ih.2]
    exact ⟨by ring, rfl⟩

lemma accK_cnt (t : BT) (C : ℕ → ℕ → ℕ) (hE : Enc t C) (neg : Bool) (u : ℕ) :
    ∀ (L : List (ℕ × ℤ)) (ps : List ℕ), (∀ p ∈ L, p.1 < NR) → cnt ps u + wK neg L < 2 ^ ps.length →
      cnt (accK t neg L ps) u = cnt ps u + (L.map fun p => Int.toNat (cond neg (-p.2) p.2) * C p.1 u).sum ∧
      (accK t neg L ps).length = ps.length
  | [], ps, _, _ => by simp [accK]
  | p :: L, ps, hL, h => by
    have hp : p.1 < 2 ^ 16 := lt_trans (hL p List.mem_cons_self) NR_lt
    simp only [wK, List.map_cons, List.sum_cons] at h
    have h1 := addK_cnt (vget t p.1) u ps (Int.toNat (cond neg (-p.2) p.2)) (by omega)
    have hb := bvec_le (vget t p.1) u
    have h2 : cnt (addK (vget t p.1) (Int.toNat (cond neg (-p.2) p.2)) ps) u + wK neg L <
        2 ^ (addK (vget t p.1) (Int.toNat (cond neg (-p.2) p.2)) ps).length := by
      rw [h1.1, h1.2]; unfold wK; nlinarith
    obtain ⟨k1, k2⟩ := accK_cnt t C hE neg u L _ (fun q hq => hL q (List.mem_cons_of_mem _ hq)) h2
    show cnt (accK t neg L (addK (vget t p.1) (Int.toNat (cond neg (-p.2) p.2)) ps)) u = _ ∧
      (accK t neg L (addK (vget t p.1) (Int.toNat (cond neg (-p.2) p.2)) ps)).length = _
    rw [k1, k2, h1.1, h1.2, ← hE.2 _ hp]
    simp only [List.map_cons, List.sum_cons]
    refine ⟨?_, ?_⟩
    · ring
    · trivial

lemma eq_of_beqL : ∀ a b : List ℕ, beqL a b = true → a = b
  | [], [], _ => rfl
  | a :: l, b :: l', h => by
    simp only [beqL, Bool.and_eq_true, Nat.beq_eq] at h
    rw [h.1, eq_of_beqL l l' h.2]
  | [], _ :: _, h => by simp [beqL] at h
  | _ :: _, [], h => by simp [beqL] at h

lemma cnt_Z6 (u : ℕ) : cnt Z6 u = 0 := by simp [Z6, cnt, bvec]

lemma sum_mulC_le (t : BT) (C : ℕ → ℕ → ℕ) (hE : Enc t C) (u : ℕ) (f : ℕ × ℤ → ℕ) :
    ∀ L : List (ℕ × ℤ), (∀ p ∈ L, p.1 < NR) → (L.map fun p => f p * C p.1 u).sum ≤ (L.map f).sum
  | [], _ => le_rfl
  | p :: L, hL => by
    simp only [List.map_cons, List.sum_cons]
    have h1 : f p * C p.1 u ≤ f p := by
      rw [hE.2 _ (lt_trans (hL p List.mem_cons_self) NR_lt)]
      have := bvec_le (vget t p.1) u
      nlinarith
    have := sum_mulC_le t C hE u f L (fun q hq => hL q (List.mem_cons_of_mem _ hq))
    omega

lemma add1_length : ∀ (l : List ℕ) (c : ℕ), (add1 l c).length = l.length
  | [], _ => rfl
  | _ :: l, c => by simp [add1, add1_length l]

/-- **Soundness of the readout check.** -/
theorem rdS_sound_sol_aux (t : BT) (C : ℕ → ℕ → ℕ) (hE : Enc t C) (S : ℕ) (L : List (ℕ × ℤ))
    (h : rdS t S L = true) (u : ℕ) :
    (L.map fun p => p.2 * (C p.1 u : ℤ)).sum = if u = S then 2 else 0 := by
  simp only [rdS, Bool.and_eq_true, Nat.blt_eq, List.all_eq_true] at h
  obtain ⟨⟨⟨hL, hp⟩, hn⟩, hb⟩ := h
  have hZ : Z6.length = 6 := rfl
  have hP := accK_cnt t C hE false u L Z6 hL (by rw [cnt_Z6, hZ]; norm_num; omega)
  have hN := accK_cnt t C hE true u L Z6 hL (by rw [cnt_Z6, hZ]; norm_num; omega)
  set P := (L.map fun p => Int.toNat (cond false (-p.2) p.2) * C p.1 u).sum with hPdef
  set N := (L.map fun p => Int.toNat (cond true (-p.2) p.2) * C p.1 u).sum with hNdef
  have hNle : N ≤ wK true L := sum_mulC_le t C hE u _ L hL
  have hS : bvec (Nat.pow 2 S) u = if u = S then 1 else 0 := by
    simp only [bvec, show Nat.pow 2 S = 2 ^ S from rfl, Nat.testBit_two_pow]
    by_cases e : u = S
    · subst e; simp
    · simp [e, Ne.symm e]
  have hs1 : bvec (Nat.pow 2 S) u ≤ 1 := bvec_le _ u
  have hs2 : bvec (2 ^ S) u ≤ 1 := bvec_le _ u
  rw [cnt_Z6, zero_add] at hP hN
  have e1 : cnt (add1 (accK t true L Z6) (Nat.pow 2 S)) u = N + bvec (Nat.pow 2 S) u := by
    have hlt : cnt (accK t true L Z6) u + bvec (Nat.pow 2 S) u < 2 ^ (accK t true L Z6).length := by
      rw [hN.1, hN.2, hZ]; have : (2:ℕ) ^ 6 = 64 := rfl; rw [this]; omega
    rw [add1_cnt _ _ u hlt, hN.1]
  have e2 : cnt (add1 (add1 (accK t true L Z6) (Nat.pow 2 S)) (Nat.pow 2 S)) u =
      N + bvec (Nat.pow 2 S) u + bvec (Nat.pow 2 S) u := by
    have hlt : cnt (add1 (accK t true L Z6) (Nat.pow 2 S)) u + bvec (Nat.pow 2 S) u <
        2 ^ (add1 (accK t true L Z6) (Nat.pow 2 S)).length := by
      rw [e1, add1_length, hN.2, hZ]; have : (2:ℕ) ^ 6 = 64 := rfl; rw [this]; omega
    rw [add1_cnt _ _ u hlt, e1]
  have key := congrArg (fun l => cnt l u) (eq_of_beqL _ _ hb)
  simp only [e2, hP.1, hS] at key
  have e : ∀ L' : List (ℕ × ℤ), (L'.map fun p => p.2 * (C p.1 u : ℤ)).sum =
      ((L'.map fun p => Int.toNat (cond false (-p.2) p.2) * C p.1 u).sum : ℤ) -
        ((L'.map fun p => Int.toNat (cond true (-p.2) p.2) * C p.1 u).sum : ℤ) := by
    intro L'
    induction L' with
    | nil => simp
    | cons p L' ih =>
      simp only [List.map_cons, List.sum_cons, Nat.cast_add, Nat.cast_mul, ih, cond_true, cond_false]
      have h0 := Int.toNat_sub_toNat_neg p.2
      linear_combination (-(C p.1 u : ℤ)) * h0
  rw [e, ← hPdef, ← hNdef]
  have key' : (P : ℤ) = (N : ℤ) + ((if u = S then 1 else 0 : ℕ) : ℤ) + ((if u = S then 1 else 0 : ℕ) : ℤ) := by
    exact_mod_cast key
  rw [key']
  split_ifs <;> push_cast <;> ring

