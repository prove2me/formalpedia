-- title:
--   Definitions for Minimal output entropy for the channels that add or remove a box of a Young diagram, and a Pauli principle for every permutation symmetry
-- statement:
--   The objects the formalized statements of *Minimal output entropy for the channels that add or remove a box of a Young diagram, and a Pauli principle for every permutation symmetry* (arXiv:2609.33498) are stated in. Each was checked against the paper by a blind read-back and a moderator.
--
--   - `tensorDifferential`: Sum-of-sites differential of a tensor power, not its homogeneous polynomial value at A (arxiv-2609.33498v1, PDF pp.4,14).
--   - `derivedAction`: Derived gl_d action on the concrete Young-symmetrizer image. Tensor permutations commute with the sum-of-sites action, so projection supplies only the subtype-valued expression (arxiv-2609.33498v1, PDF pp.4,14).
--   - `HasWeight`: Weight-space membership includes the zero vector; weights are integral (arxiv-2609.33498v1, PDF pp.4,14).
--   - `cyclicModule`: The actual gl_n cyclic submodule generated by the fixed highest-weight vector: span of all finite words of generators with indices in the first n coordinates (arxiv-2609.33498v1, PDF p.13).
--   - `RestrictedInvariant`: Invariance under the computed first-n-coordinate Lie action (arxiv-2609.33498v1, PDF pp.13-14).
--   - `RestrictedIrreducible`: An actual nonzero irreducible subrepresentation of the restriction, rather than an unrelated representation parameter (arxiv-2609.33498v1, PDF p.14).
--   - `weylDimension`: Weyl's dimension formula for the first n rows, with all differences taken in the reals (arxiv-2609.33498v1, PDF p.14, proof of Lemma 3.5). For decreasing nonnegative integral rows this is D_n of that diagram.
--   - `addedRows`: Add the box in zero-based row j (arxiv-2609.33498v1, PDF p.4).
--   - `dimensionRatio`: The dimension ratio D_n(lambda+e_j)/D_n(lambda); theorems impose the source domain j+1 ≤ n ≤ d and an admissible box (PDF pp.6,14).
--   - `shiftedRow`: Source's omega_a=lambda_a-a, with a translated from zero-based indexing (arxiv-2609.33498v1, PDF p.14).
--   - `IsBoxPair`: Admissible one-box pair, using actual Young diagrams and zero-based row j. Both height bounds and d≥1 are included (arxiv-2609.33498v1, PDF p.4).
--   - `deletedColumnRows`: Deletion of one column of height h, computed from the rows. Theorems require an existing column (arxiv-2609.33498v1, PDF p.14).
--   - `complementRows`: Complement in a d-by-R rectangle, rotated by 180 degrees; rows outside that rectangle are zero (arxiv-2609.33498v1, PDF pp.6,18-19).
--   - `hookLength`: Hook length at a zero-based occupied cell: boxes strictly right, boxes strictly below, and the cell itself (arxiv-2609.33498v1, PDF p.4).
-- source:
--   Minimal output entropy for the channels that add or remove a box of a Young diagram, and a Pauli principle for every permutation symmetry, arXiv:2609.33498v1, https://arxiv.org/abs/2609.33498v1

import Mathlib
import Definitions.Def_QAlgorithms_Defs_SchurModules

noncomputable section

namespace QAlgorithms.Papers.Independent.Information100.P65

attribute [local instance] Classical.propDecidable

/-- Sum-of-sites differential of a tensor power, not its homogeneous polynomial
value at A (arxiv-2609.33498v1, PDF pp.4,14). -/
def tensorDifferential (d N : ℕ) (A : Matrix (Fin d) (Fin d) ℂ) :
    Matrix (Fin N → Fin d) (Fin N → Fin d) ℂ :=
  fun x y => ∑ t : Fin N, A (x t) (y t) *
    ∏ s ∈ Finset.univ.erase t, if x s = y s then 1 else 0

/-- Derived gl_d action on the concrete Young-symmetrizer image. Tensor
permutations commute with the sum-of-sites action, so projection supplies only
the subtype-valued expression (arxiv-2609.33498v1, PDF pp.4,14). -/
def derivedAction {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N)
    (A : Matrix (Fin d) (Fin d) ℂ) :
    QAlgorithms.Schur.schurModule mu →ₗ[ℂ] QAlgorithms.Schur.schurModule mu :=
  (QAlgorithms.Schur.schurModule mu).orthogonalProjectionOnto.toLinearMap.comp
    ((Matrix.toEuclideanLin (tensorDifferential d N A)).comp
      (QAlgorithms.Schur.schurModule mu).subtype)

/-- Weight-space membership includes the zero vector; weights are integral
(arxiv-2609.33498v1, PDF pp.4,14). -/
def HasWeight {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N)
    (theta : Fin d → ℤ) (v : QAlgorithms.Schur.schurModule mu) : Prop :=
  ∀ a : Fin d, derivedAction mu (Matrix.single a a 1) v =
    (theta a : ℂ) • v

/-- The actual gl_n cyclic submodule generated by the fixed highest-weight
vector: span of all finite words of generators with indices in the first n
coordinates (arxiv-2609.33498v1, PDF p.13). -/
def cyclicModule {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N) (n : ℕ) :
    Submodule ℂ (QAlgorithms.Schur.schurModule mu) :=
  Submodule.span ℂ {v | ∃ w : List (Fin d × Fin d),
    (∀ ab ∈ w, ab.1.val < n ∧ ab.2.val < n) ∧
    v = w.foldr (fun ab z => derivedAction mu
      (Matrix.single ab.1 ab.2 1) z)
      (QAlgorithms.Schur.highestWeightVector mu)}

/-- Invariance under the computed first-n-coordinate Lie action
(arxiv-2609.33498v1, PDF pp.13-14). -/
def RestrictedInvariant {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N)
    (n : ℕ) (L : Submodule ℂ (QAlgorithms.Schur.schurModule mu)) : Prop :=
  ∀ a b : Fin d, a.val < n → b.val < n →
    ∀ v ∈ L, derivedAction mu (Matrix.single a b 1) v ∈ L

/-- An actual nonzero irreducible subrepresentation of the restriction, rather
than an unrelated representation parameter (arxiv-2609.33498v1, PDF p.14). -/
def RestrictedIrreducible {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N)
    (n : ℕ) (L : Submodule ℂ (QAlgorithms.Schur.schurModule mu)) : Prop :=
  L ≠ ⊥ ∧ RestrictedInvariant mu n L ∧
    ∀ K : Submodule ℂ (QAlgorithms.Schur.schurModule mu),
      K ≤ L → RestrictedInvariant mu n K → K = ⊥ ∨ K = L

example (d N : ℕ) : tensorDifferential d N 0 = 0 := by
  ext x y
  simp [tensorDifferential]

example (d : ℕ) (A : Matrix (Fin d) (Fin d) ℂ) :
    tensorDifferential d 0 A = 0 := by
  ext x y
  simp [tensorDifferential]

/-- At one tensor site the differential is exactly the original matrix. -/
example (d : ℕ) (A : Matrix (Fin d) (Fin d) ℂ)
    (x y : Fin 1 → Fin d) :
    tensorDifferential d 1 A x y = A (x 0) (y 0) := by
  simp [tensorDifferential]

/-- The empty word includes the highest-weight vector even at n=0. -/
example {d N : ℕ} (mu : QAlgorithms.Schur.Partition d N) :
    QAlgorithms.Schur.highestWeightVector mu ∈ cyclicModule mu 0 := by
  apply Submodule.subset_span
  refine ⟨[], ?_, ?_⟩
  · simp
  · rfl

/-- Weyl's dimension formula for the first n rows, with all differences taken
in the reals (arxiv-2609.33498v1, PDF p.14, proof of Lemma 3.5).
For decreasing nonnegative integral rows this is D_n of that diagram. -/
def weylDimension (rows : ℕ → ℕ) (n : ℕ) : ℝ :=
  ∏ a ∈ Finset.range n, ∏ b ∈ Finset.Ico (a + 1) n,
    (((rows a : ℝ) - (a : ℝ)) - ((rows b : ℝ) - (b : ℝ))) /
      ((b : ℝ) - (a : ℝ))

/-- Add the box in zero-based row j (arxiv-2609.33498v1, PDF p.4). -/
def addedRows (rows : ℕ → ℕ) (j : ℕ) : ℕ → ℕ :=
  fun a => rows a + if a = j then 1 else 0

/-- The dimension ratio D_n(lambda+e_j)/D_n(lambda); theorems impose the
source domain j+1 ≤ n ≤ d and an admissible box (PDF pp.6,14). -/
def dimensionRatio (rows : ℕ → ℕ) (j n : ℕ) : ℝ :=
  weylDimension (addedRows rows j) n / weylDimension rows n

/-- Source's omega_a=lambda_a-a, with a translated from zero-based indexing
(arxiv-2609.33498v1, PDF p.14). -/
def shiftedRow (rows : ℕ → ℕ) (a : ℕ) : ℝ :=
  (rows a : ℝ) - ((a + 1 : ℕ) : ℝ)

/-- Admissible one-box pair, using actual Young diagrams and zero-based row j.
Both height bounds and d≥1 are included (arxiv-2609.33498v1, PDF p.4). -/
def IsBoxPair (d : ℕ) (lower upper : YoungDiagram) (j : ℕ) : Prop :=
  0 < d ∧ lower.colLen 0 ≤ d ∧ upper.colLen 0 ≤ d ∧ j < d ∧
    ∀ a : ℕ, upper.rowLen a = addedRows lower.rowLen j a

/-- Deletion of one column of height h, computed from the rows. Theorems
require an existing column (arxiv-2609.33498v1, PDF p.14). -/
def deletedColumnRows (rows : ℕ → ℕ) (h : ℕ) : ℕ → ℕ :=
  fun a => rows a - if a < h then 1 else 0

/-- Complement in a d-by-R rectangle, rotated by 180 degrees; rows outside
that rectangle are zero (arxiv-2609.33498v1, PDF pp.6,18-19). -/
def complementRows (mu : YoungDiagram) (R d : ℕ) : ℕ → ℕ :=
  fun a => if a < d then R - mu.rowLen (d - 1 - a) else 0

/-- Hook length at a zero-based occupied cell: boxes strictly right, boxes
strictly below, and the cell itself (arxiv-2609.33498v1, PDF p.4). -/
def hookLength (mu : YoungDiagram) (a c : ℕ) : ℕ :=
  (mu.rowLen a - (c + 1)) + (mu.colLen c - (a + 1)) + 1

example (rows : ℕ → ℕ) : weylDimension rows 0 = 1 := by
  simp [weylDimension]

example (rows : ℕ → ℕ) (j : ℕ) : dimensionRatio rows j 0 = 1 := by
  simp [dimensionRatio, weylDimension]

example (rows : ℕ → ℕ) (j : ℕ) : addedRows rows j j = rows j + 1 := by
  simp [addedRows]

example (rows : ℕ → ℕ) : deletedColumnRows rows 0 = rows := by
  funext a
  simp [deletedColumnRows]

example (mu : YoungDiagram) (R d : ℕ) : complementRows mu R d d = 0 := by
  simp [complementRows]

end QAlgorithms.Papers.Independent.Information100.P65


