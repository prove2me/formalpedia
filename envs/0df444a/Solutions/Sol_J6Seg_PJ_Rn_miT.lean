  obtain ⟨w4, hw4⟩ : ∃ w4 : Vr, w4 = update (update w3 29 ((lam - 1 - (a - c) : ℕ) : ℤ)) 4
      ((D SDD).getD (lam - 1 - (a - c)) 0) := ⟨_, rfl⟩
  have d5 : (ixGE (.r 3)).den w4 = ((lam - 1 - uu : ℕ) : ℤ) := by
