variable {G : Type*} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- A subgroup is discrete if some neighbourhood of `1` meets it only in `1`. -/
def IsDiscreteSub (S : Subgroup G) : Prop := ∃ W ∈ 𝓝 (1 : G), ∀ z ∈ S, z ∈ W → z = 1

lemma exists_nhds_inv_mul {W : Set G} (hW : W ∈ 𝓝 (1 : G)) :
    ∃ W₁ ∈ 𝓝 (1 : G), ∀ a ∈ W₁, ∀ b ∈ W₁, a⁻¹ * b ∈ W := by
  obtain ⟨V, hV, hVW⟩ := exists_nhds_one_split hW
  refine ⟨V ∩ V⁻¹, inter_mem hV (inv_mem_nhds_one G hV), fun a ha b hb => hVW _ ha.2 _ hb.1⟩

lemma IsDiscreteSub.isClosed [T2Space G] {S : Subgroup G} (h : IsDiscreteSub S) :
    IsClosed (S : Set G) := by
  obtain ⟨W₀, hW₀, hW₀S⟩ := h
  obtain ⟨W₁, hW₁, hW₁W⟩ := exists_nhds_inv_mul hW₀
  refine closure_subset_iff_isClosed.1 fun x hx => ?_
  have hO : (fun y => x⁻¹ * y) ⁻¹' W₁ ∈ 𝓝 x := by
    have hc : Continuous (fun y : G => x⁻¹ * y) := continuous_const.mul continuous_id
    exact hc.continuousAt.preimage_mem_nhds (by simpa using hW₁)
  obtain ⟨s, hsO, hsS⟩ := mem_closure_iff_nhds.1 hx _ hO
  by_contra hxS
  have hxs : x ≠ s := fun h => hxS (h ▸ hsS)
  obtain ⟨t, ⟨htO, hts⟩, htS⟩ := mem_closure_iff_nhds.1 hx _
    (inter_mem hO (isOpen_compl_singleton.mem_nhds hxs))
  have h1 : s⁻¹ * t ∈ W₀ := by
    have := hW₁W _ hsO _ htO
    simpa [mul_assoc] using this
  have h2 := hW₀S _ (S.mul_mem (S.inv_mem hsS) htS) h1
  exact hts (by rw [inv_mul_eq_one] at h2; exact h2.symm)

lemma lift_compact [LocallyCompactSpace G] (N : Subgroup G) [N.Normal] {K : Set (G ⧸ N)}
    (hK : IsCompact K) : ∃ K' : Set G, IsCompact K' ∧ K ⊆ (QuotientGroup.mk : G → G ⧸ N) '' K' := by
  obtain ⟨V, hVc, hV⟩ := exists_compact_mem_nhds (1 : G)
  let O : G → Set (G ⧸ N) := fun g =>
    (QuotientGroup.mk : G → G ⧸ N) '' ((fun y => g⁻¹ * y) ⁻¹' interior V)
  have hOo : ∀ g, IsOpen (O g) := fun g =>
    QuotientGroup.isOpenMap_coe _ (isOpen_interior.preimage (continuous_const.mul continuous_id))
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover O hOo (by
    intro y _
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
    exact mem_iUnion.2 ⟨g, g, by simpa using mem_interior_iff_mem_nhds.2 hV, rfl⟩)
  refine ⟨⋃ g ∈ t, (fun y => g * y) '' V,
    t.isCompact_biUnion fun g _ => hVc.image (continuous_const.mul continuous_id), ?_⟩
  intro y hy
  obtain ⟨g, hg, h, hh, rfl⟩ := mem_iUnion₂.1 (ht hy)
  exact ⟨h, mem_iUnion₂.2 ⟨g, hg, g⁻¹ * h, interior_subset hh, by simp⟩, rfl⟩

end

/-- Main inductive statement. -/
theorem exists_lattice_aux (k : ℕ) :
    ∀ (G : Type u) [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [T2Space G]
      [LocallyCompactSpace G] (F : Fin k → G) (V : Set G), IsCompact V →
      (∀ g : G, ∃ d ∈ Subgroup.closure (range F), ∃ v ∈ V, g = d * v) →
      ∃ (j : ℕ) (T : Fin j → G) (V' : Set G), IsCompact V' ∧
        IsDiscreteSub (Subgroup.closure (range T)) ∧
        ∀ g : G, ∃ z ∈ Subgroup.closure (range T), ∃ v ∈ V', g = z * v := by
  induction k with
  | zero =>
    intro G _ _ _ _ _ F V hV hcov
    exact ⟨0, F, V, hV, ⟨univ, univ_mem, fun z hz _ => by
      rwa [range_eq_empty, Subgroup.closure_empty, Subgroup.mem_bot] at hz⟩, hcov⟩
  | succ k ih =>
    intro G _ _ _ _ _ F V hV hcov
    set f := F (Fin.last k) with hf
    let F' : Fin k → G := fun i => F (Fin.castSucc i)
    have hFle : Subgroup.closure (range F) ≤ Subgroup.closure (range F') ⊔ Subgroup.zpowers f := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      induction i using Fin.lastCases with
      | last => exact Subgroup.mem_sup_right (Subgroup.mem_zpowers _)
      | cast i => exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨i, rfl⟩)
    rcases weil f with hcpt | ⟨W₀, hW₀, hW₀f⟩
    · -- the closure of `⟨f⟩` is compact: absorb it into `V`
      refine ih G F' (closure (Subgroup.zpowers f : Set G) * V) (hcpt.mul hV) fun g => ?_
      obtain ⟨d, hd, v, hv, rfl⟩ := hcov g
      obtain ⟨y, hy, z, hz, rfl⟩ := Subgroup.mem_sup.1 (hFle hd)
      exact ⟨y, hy, z * v, Set.mul_mem_mul (subset_closure hz) hv, by rw [mul_assoc]⟩
    · -- `⟨f⟩` is discrete: pass to the quotient
      let Zf : Subgroup G := Subgroup.zpowers f
      have hZfd : IsDiscreteSub Zf := ⟨W₀, hW₀, by
        rintro _ ⟨n, rfl⟩ hn
        exact hW₀f n hn⟩
      have : IsClosed (Zf : Set G) := hZfd.isClosed
      let q : G →* G ⧸ Zf := QuotientGroup.mk' Zf
      have hq : ∀ g, q g = (g : G ⧸ Zf) := fun _ => rfl
      obtain ⟨j, T', V'', hV''c, ⟨W', hW', hW'Z⟩, hcov'⟩ :=
        ih (G ⧸ Zf) (fun i => q (F' i)) (q '' V) (hV.image QuotientGroup.continuous_mk) (by
          intro y
          obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
          obtain ⟨d, hd, v, hv, rfl⟩ := hcov g
          refine ⟨q d, ?_, q v, ⟨v, hv, rfl⟩, map_mul q d v⟩
          obtain ⟨y, hy, z, hz, rfl⟩ := Subgroup.mem_sup.1 (hFle hd)
          have hqz : q z = 1 := (QuotientGroup.eq_one_iff z).2 hz
          rw [map_mul, hqz, mul_one]
          have : (Subgroup.closure (range F')).map q ≤
              Subgroup.closure (range fun i => q (F' i)) := by
            rw [MonoidHom.map_closure, ← range_comp]
            exact le_rfl
          exact this ⟨y, hy, rfl⟩)
      obtain ⟨V₂, hV₂c, hV₂⟩ := lift_compact Zf hV''c
      choose T'' hT'' using fun i => QuotientGroup.mk_surjective (T' i)
      let T : Fin (j + 1) → G := Fin.cons f T''
      have hfT : f ∈ Subgroup.closure (range T) := Subgroup.subset_closure ⟨0, rfl⟩
      have hZfT : Zf ≤ Subgroup.closure (range T) :=
        (Subgroup.zpowers_le).2 hfT
      have hi : ∀ z ∈ Subgroup.closure (range T), q z ∈ Subgroup.closure (range T') := by
        intro z hz
        have : Subgroup.closure (range T) ≤ (Subgroup.closure (range T')).comap q := by
          rw [Subgroup.closure_le]
          rintro _ ⟨i, rfl⟩
          induction i using Fin.cases with
          | zero =>
            rw [SetLike.mem_coe, Subgroup.mem_comap]
            simp only [T, Fin.cons_zero]
            rw [hq, (QuotientGroup.eq_one_iff f).2 (Subgroup.mem_zpowers f)]
            exact Subgroup.one_mem _
          | succ i =>
            rw [SetLike.mem_coe, Subgroup.mem_comap]
            simp only [T, Fin.cons_succ]
            rw [hq, hT'']
            exact Subgroup.subset_closure ⟨i, rfl⟩
        exact this hz
      have hii : ∀ z' ∈ Subgroup.closure (range T'), ∃ z ∈ Subgroup.closure (range T), q z = z' := by
        intro z' hz'
        have : Subgroup.closure (range T') ≤ (Subgroup.closure (range T)).map q := by
          rw [Subgroup.closure_le]
          rintro _ ⟨i, rfl⟩
          exact ⟨T'' i, Subgroup.subset_closure ⟨i.succ, rfl⟩, hT'' i⟩
        obtain ⟨z, hz, h⟩ := this hz'
        exact ⟨z, hz, h⟩
      refine ⟨j + 1, T, V₂, hV₂c, ⟨q ⁻¹' W' ∩ W₀, inter_mem ?_ hW₀, ?_⟩, ?_⟩
      · exact QuotientGroup.continuous_mk.continuousAt.preimage_mem_nhds (by simpa using hW')
      · rintro z hz ⟨hzW', hzW₀⟩
        have h1 : q z = 1 := hW'Z _ (hi z hz) hzW'
        obtain ⟨n, rfl⟩ := (QuotientGroup.eq_one_iff z).1 h1
        exact hW₀f n hzW₀
      · intro g
        obtain ⟨z', hz', v', hv', hg⟩ := hcov' (q g)
        obtain ⟨v₂, hv₂, hv₂'⟩ := hV₂ hv'
        obtain ⟨z, hz, rfl⟩ := hii z' hz'
        have heq : q g = q (z * v₂) := by rw [hg, map_mul]; rw [← hv₂']; rfl
        have hmem : (z * v₂)⁻¹ * g ∈ Zf := QuotientGroup.eq.1 heq.symm
        refine ⟨z * ((z * v₂)⁻¹ * g), Subgroup.mul_mem _ hz (hZfT hmem), v₂, hv₂, ?_⟩
        rw [mul_right_comm, mul_inv_cancel_left]

/-- A compactly generated locally compact abelian group contains a finitely generated discrete
subgroup `Z` with `G = Z * V` for a compact set `V`. -/
theorem exists_lattice (G : Type u) [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G]
    [T2Space G] [LocallyCompactSpace G] (hcg : ∃ C : Set G, IsCompact C ∧ Subgroup.closure C = ⊤) :
    ∃ (j : ℕ) (T : Fin j → G) (V' : Set G), IsCompact V' ∧
      IsDiscreteSub (Subgroup.closure (range T)) ∧
      ∀ g : G, ∃ z ∈ Subgroup.closure (range T), ∃ v ∈ V', g = z * v := by
  obtain ⟨C, hCc, hC⟩ := hcg
  obtain ⟨V₀, hV₀c, hV₀⟩ := exists_compact_mem_nhds (1 : G)
  let V : Set G := C ∪ C⁻¹ ∪ V₀
  have hVc : IsCompact V := (hCc.union hCc.inv).union hV₀c
  have hV1 : (1 : G) ∈ V := Or.inr (mem_of_mem_nhds hV₀)
  obtain ⟨t, ht⟩ := (hVc.mul hVc).elim_finite_subcover (fun g : G => (fun y => g⁻¹ * y) ⁻¹' interior V₀)
    (fun g => isOpen_interior.preimage (continuous_const.mul continuous_id)) (by
      intro y _
      exact mem_iUnion.2 ⟨y, by simpa using mem_interior_iff_mem_nhds.2 hV₀⟩)
  classical
  let F : Fin t.card → G := fun i => (t.equivFin.symm i : G)
  have hFt : ∀ g ∈ t, g ∈ Subgroup.closure (range F) := fun g hg =>
    Subgroup.subset_closure ⟨t.equivFin ⟨g, hg⟩, by simp [F]⟩
  apply exists_lattice_aux t.card G F V hVc
  intro g
  have hg : g ∈ Subgroup.closure C := by rw [hC]; trivial
  let p : G → Prop := fun g => ∃ d ∈ Subgroup.closure (range F), ∃ v ∈ V, g = d * v
  have hstep : ∀ c ∈ V, ∀ y, p y → p (c * y) := by
    rintro c hc y ⟨d, hd, v, hv, rfl⟩
    obtain ⟨g', hg', hg'V⟩ := mem_iUnion₂.1 (ht (Set.mul_mem_mul hc hv))
    refine ⟨g' * d, Subgroup.mul_mem _ (hFt g' hg') hd, g'⁻¹ * (c * v),
      Or.inr (interior_subset hg'V), ?_⟩
    rw [mul_comm g' d, mul_assoc, mul_inv_cancel_left, mul_left_comm]
  refine Subgroup.closure_induction_left (p := fun g _ => p g) ⟨1, Subgroup.one_mem _, 1, hV1, by simp⟩
    (fun c hc y _ hy => hstep c (Or.inl (Or.inl hc)) y hy)
    (fun c hc y _ hy => hstep c⁻¹ (Or.inl (Or.inr (by simpa using hc))) y hy) hg

end LCA

end Lattice_sec

section ClosedSub_sec

open Set Filter Topology Module

namespace LCA

lemma sumExtend_inl {K V ι : Type*} [DivisionRing K] [AddCommGroup V] [Module K V] {v : ι → V}
    (hs : LinearIndependent K v) (i : ι) : Basis.sumExtend hs (Sum.inl i) = v i := by
  simp only [Basis.sumExtend, Basis.reindex_apply, Basis.coe_extend]
  rfl

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]

/-- The largest real subspace contained in `A`. -/
def lineSpace (A : AddSubgroup E) : Submodule ℝ E where
  carrier := {v | ∀ t : ℝ, t • v ∈ A}
  add_mem' := fun ha hb t => by rw [smul_add]; exact A.add_mem (ha t) (hb t)
  zero_mem' := fun t => by rw [smul_zero]; exact A.zero_mem
  smul_mem' := fun c v hv t => by
    show t • c • v ∈ A
    rw [smul_smul]; exact hv _

lemma lineSpace_le (A : AddSubgroup E) {v : E} (hv : v ∈ lineSpace A) : v ∈ A := by
  have := hv 1
  rwa [one_smul] at this

lemma no_small (A : AddSubgroup E) (hA : IsClosed (A : Set E)) (W : Submodule ℝ E)
    (hVW : Disjoint (lineSpace A) W) :
    ∃ ε > 0, ∀ w ∈ A, w ∈ W → ‖w‖ < ε → w = 0 := by
  by_contra hcon
  push Not at hcon
  have : ∀ n : ℕ, ∃ w ∈ A, w ∈ W ∧ ‖w‖ < 1 / ((n : ℝ) + 1) ∧ w ≠ 0 :=
    fun n => hcon _ (by positivity)
  choose w hwA hwW hwn hw0 using this
  set r : ℕ → ℝ := fun n => ‖w n‖ with hrdef
  have hr0 : ∀ n, 0 < r n := fun n => norm_pos_iff.2 (hw0 n)
  have hrt : Tendsto r atTop (𝓝 0) :=
    squeeze_zero (fun n => (hr0 n).le) (fun n => (hwn n).le) tendsto_one_div_add_atTop_nhds_zero_nat
  let u : ℕ → E := fun n => (r n)⁻¹ • w n
  have hu1 : ∀ n, ‖u n‖ = 1 := fun n => by
    simp only [u, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos (hr0 n)]
    exact inv_mul_cancel₀ (hr0 n).ne'
  have huW : ∀ n, u n ∈ W := fun n => W.smul_mem _ (hwW n)
  have hK : IsCompact (Metric.sphere (0 : E) 1 ∩ (W : Set E)) :=
    (isCompact_sphere 0 1).inter_right W.closed_of_finiteDimensional
  obtain ⟨u₀, ⟨hu₀1, hu₀W⟩, φ, hφ, hlim⟩ :=
    hK.tendsto_subseq (x := u) (fun n => ⟨by simp [hu1 n], huW n⟩)
  have hline : u₀ ∈ lineSpace A := by
    intro t
    let y : ℕ → E := fun n => (⌊t / r (φ n)⌋ : ℤ) • w (φ n)
    have hyA : ∀ n, y n ∈ A := fun n => A.zsmul_mem (hwA _) _
    have hy : Tendsto y atTop (𝓝 (t • u₀)) := by
      rw [tendsto_iff_norm_sub_tendsto_zero]
      have hb : ∀ n, ‖y n - t • u₀‖ ≤ r (φ n) + |t| * ‖u (φ n) - u₀‖ := by
        intro n
        have hr := hr0 (φ n)
        have hwn' : w (φ n) = r (φ n) • u (φ n) := by
          simp only [u, smul_smul, mul_inv_cancel₀ hr.ne', one_smul]
        have e : y n - t • u₀ =
            (((⌊t / r (φ n)⌋ : ℤ) : ℝ) * r (φ n) - t) • u (φ n) + t • (u (φ n) - u₀) := by
          simp only [y, hwn', ← Int.cast_smul_eq_zsmul ℝ, smul_smul, sub_smul, smul_sub]
          abel
        rw [e]
        refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
        · rw [norm_smul, hu1, mul_one, Real.norm_eq_abs]
          set q := t / r (φ n)
          have hq : t = q * r (φ n) := (div_mul_cancel₀ t hr.ne').symm
          have h1 := Int.floor_le q
          have h2 := Int.lt_floor_add_one q
          have e2 : ((⌊q⌋ : ℤ) : ℝ) * r (φ n) - t = (((⌊q⌋ : ℤ) : ℝ) - q) * r (φ n) := by
            rw [hq]; ring
          rw [e2, abs_mul, abs_of_pos hr]
          have : |((⌊q⌋ : ℤ) : ℝ) - q| ≤ 1 := by
            rw [abs_le]; constructor <;> linarith
          nlinarith
        · rw [norm_smul, Real.norm_eq_abs]
      refine squeeze_zero (fun n => norm_nonneg _) hb ?_
      have h1 : Tendsto (fun n => r (φ n)) atTop (𝓝 0) := hrt.comp hφ.tendsto_atTop
      have h2 : Tendsto (fun n => ‖u (φ n) - u₀‖) atTop (𝓝 0) :=
        (tendsto_iff_norm_sub_tendsto_zero.1 hlim)
      simpa using h1.add (h2.const_mul |t|)
    exact hA.mem_of_tendsto hy (Eventually.of_forall hyA)
  have h0 : u₀ = 0 := by
    exact Submodule.disjoint_def.1 hVW u₀ hline hu₀W
  rw [h0, mem_sphere_zero_iff_norm, norm_zero] at hu₀1
  exact zero_ne_one hu₀1

/-- **Structure of closed subgroups of a finite-dimensional real vector space.** -/
theorem closedSubgroup_structure (A : AddSubgroup E) (hA : IsClosed (A : Set E)) :
    ∃ (p k m : ℕ) (v : Fin p → E) (b : Fin k → E) (κ : E →ₗ[ℝ] (Fin k → ℝ) × (Fin m → ℝ)),
      Function.Surjective κ ∧
      (∀ x, x ∈ A ↔ (∀ j, ∃ n : ℤ, (κ x).1 j = n) ∧ (κ x).2 = 0) ∧
      (∀ x, x ∈ A ↔ ∃ (t : Fin p → ℝ) (n : Fin k → ℤ),
        x = ∑ i, t i • v i + ∑ j, (n j : ℝ) • b j) := by
  classical
  set V := lineSpace A with hVdef
  obtain ⟨W, hVW⟩ := Submodule.exists_isCompl V
  obtain ⟨ε, hε, hsmall⟩ := no_small A hA W hVW.disjoint
  let Λ : Submodule ℤ E := (A ⊓ W.toAddSubgroup).toIntSubmodule
  have hΛ : ∀ x, x ∈ Λ ↔ x ∈ A ∧ x ∈ W := fun x => Iff.rfl
  haveI : DiscreteTopology Λ := by
    apply discreteTopology_of_isOpen_singleton_zero
    have : ({0} : Set Λ) = Subtype.val ⁻¹' Metric.ball 0 ε := by
      ext ⟨x, hx⟩
      simp only [mem_singleton_iff, mem_preimage, Metric.mem_ball, dist_zero_right]
      constructor
      · intro h
        have : x = 0 := congrArg Subtype.val h
        subst this
        simpa using hε
      · intro h
        exact Subtype.ext (hsmall x ((hΛ x).1 hx).1 ((hΛ x).1 hx).2 h)
    rw [this]
    exact Metric.isOpen_ball.preimage continuous_subtype_val
  set k := finrank ℤ Λ
  let bΛ : Basis (Fin k) ℤ Λ := Module.finBasis ℤ Λ
  let b : Fin k → E := fun j => (bΛ j : E)
  have hbspan : Submodule.span ℤ (range b) = Λ := by
    have h1 : range b = Λ.subtype '' range bΛ := by rw [← range_comp]; rfl
    rw [h1, ← Submodule.map_span, bΛ.span_eq, Submodule.map_top, Submodule.range_subtype]
  have hbind : LinearIndependent ℝ b := by
    rw [linearIndependent_iff_card_eq_finrank_span, Fintype.card_fin]
    have hd : DiscreteTopology (Submodule.span ℤ (Λ : Set E)) := by
      rw [Submodule.span_eq]; infer_instance
    have h1 := Real.finrank_eq_int_finrank_of_discrete hd
    have h2 : Set.finrank ℝ (range b) = Set.finrank ℝ (Λ : Set E) := by
      unfold Set.finrank
      rw [← Submodule.span_span_of_tower ℤ ℝ (range b), hbspan]
    have h3 : Set.finrank ℤ (Λ : Set E) = k := by
      unfold Set.finrank
      rw [Submodule.span_eq]
    rw [h2, h1, h3]
  set p := finrank ℝ V
  let bV : Basis (Fin p) ℝ V := Module.finBasis ℝ V
  let v : Fin p → E := fun i => (bV i : E)
  have hvspan : Submodule.span ℝ (range v) = V := by
    have h1 : range v = V.subtype '' range bV := by rw [← range_comp]; rfl
    rw [h1, ← Submodule.map_span, bV.span_eq, Submodule.map_top, Submodule.range_subtype]
  have hvind : LinearIndependent ℝ v := bV.linearIndependent.map' V.subtype V.ker_subtype
  have hbW : Submodule.span ℝ (range b) ≤ W := by
    rw [Submodule.span_le]
    rintro _ ⟨j, rfl⟩
    exact ((hΛ _).1 (bΛ j).2).2
  have hu : LinearIndependent ℝ (Sum.elim v b) :=
    hvind.sum_type hbind (by rw [hvspan]; exact hVW.disjoint.mono_right hbW)
  let B := Basis.sumExtend hu
  have hBv : ∀ i, B (Sum.inl (Sum.inl i)) = v i := fun i => sumExtend_inl hu _
  have hBb : ∀ j, B (Sum.inl (Sum.inr j)) = b j := fun j => sumExtend_inl hu _
  let S := Basis.sumExtendIndex hu
  have : Finite S := by
    have := Module.Finite.finite_basis B
    exact Finite.of_injective (Sum.inr : S → (Fin p ⊕ Fin k) ⊕ S) Sum.inr_injective
  haveI : Fintype S := Fintype.ofFinite S
  set m := Fintype.card S
  let eS : S ≃ Fin m := Fintype.equivFin S
  let κ : E →ₗ[ℝ] (Fin k → ℝ) × (Fin m → ℝ) :=
    LinearMap.prod (LinearMap.pi fun j => B.coord (Sum.inl (Sum.inr j)))
      (LinearMap.pi fun l => B.coord (Sum.inr (eS.symm l)))
  have hκ1 : ∀ x j, (κ x).1 j = B.repr x (Sum.inl (Sum.inr j)) := fun _ _ => rfl
  have hκ2 : ∀ x l, (κ x).2 l = B.repr x (Sum.inr (eS.symm l)) := fun _ _ => rfl
  -- decomposition of an arbitrary vector
  have hdec : ∀ x, x = ∑ i, B.repr x (Sum.inl (Sum.inl i)) • v i +
      ∑ j, B.repr x (Sum.inl (Sum.inr j)) • b j + ∑ s, B.repr x (Sum.inr s) • B (Sum.inr s) := by
    intro x
    conv_lhs => rw [← B.sum_repr x]
    rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
    simp only [hBv, hBb]
  -- coefficients of a combination
  have hcoef : ∀ (t : Fin p → ℝ) (n : Fin k → ℝ),
      ⇑(B.repr (∑ i, t i • v i + ∑ j, n j • b j)) = Sum.elim (Sum.elim t n) 0 := by
    intro t n
    rw [← B.repr_sum_self (Sum.elim (Sum.elim t n) 0)]
    congr 1
    rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
    simp [hBv, hBb]
  -- the generator description
  have hgen : ∀ x, x ∈ A ↔ ∃ (t : Fin p → ℝ) (n : Fin k → ℤ),
      x = ∑ i, t i • v i + ∑ j, (n j : ℝ) • b j := by
    intro x
    constructor
    · intro hx
      have htop : x ∈ V ⊔ W := by rw [hVW.sup_eq_top]; trivial
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 htop
      have hzA : z ∈ A := by
        have := A.sub_mem hx (lineSpace_le A hy)
        simpa using this
      have hzΛ : z ∈ Submodule.span ℤ (range b) := by rw [hbspan]; exact (hΛ z).2 ⟨hzA, hz⟩
      rw [← hvspan] at hy
      obtain ⟨t, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℝ).1 hy
      obtain ⟨n, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ).1 hzΛ
      refine ⟨t, n, ?_⟩
      simp only [Int.cast_smul_eq_zsmul]
    · rintro ⟨t, n, rfl⟩
      refine A.add_mem (lineSpace_le A ?_) ?_
      · rw [← hVdef, ← hvspan]
        exact (Submodule.mem_span_range_iff_exists_fun ℝ).2 ⟨t, rfl⟩
      · refine (hΛ _).1 ?_ |>.1
        rw [← hbspan]
        simp only [Int.cast_smul_eq_zsmul]
        exact (Submodule.mem_span_range_iff_exists_fun ℤ).2 ⟨n, rfl⟩
  refine ⟨p, k, m, v, b, κ, ?_, ?_, hgen⟩
  · rintro ⟨α, γ⟩
    let c : (Fin p ⊕ Fin k) ⊕ S → ℝ := Sum.elim (Sum.elim 0 α) (fun s => γ (eS s))
    refine ⟨∑ i, c i • B i, ?_⟩
    ext j
    · rw [hκ1, B.repr_sum_self]; rfl
    · rw [hκ2, B.repr_sum_self]; simp [c]
  · intro x
    rw [hgen x]
    constructor
    · rintro ⟨t, n, rfl⟩
      refine ⟨fun j => ⟨n j, ?_⟩, ?_⟩
      · rw [hκ1, hcoef]; rfl
      · ext l
        rw [hκ2, hcoef]; rfl
    · rintro ⟨hint, hzero⟩
      choose n hn using hint
      have hz : ∀ s, B.repr x (Sum.inr s) = 0 := by
        intro s
        have := congrFun hzero (eS s)
        rw [hκ2] at this
        simpa using this
      refine ⟨fun i => B.repr x (Sum.inl (Sum.inl i)), n, ?_⟩
      conv_lhs => rw [hdec x]
      simp only [hz, zero_smul, Finset.sum_const_zero, add_zero]
      congr 1
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [← hn j, hκ1]

end LCA

end ClosedSub_sec

section QuotElem_sec

open Set Topology Module

namespace LCA

/-- The elementary groups `ℝ^m × 𝕋^n × ℤ^r × F`. -/
abbrev ElemG (m n r s : ℕ) (d : Fin s → ℕ) : Type :=
  (Fin m → ℝ) × (Fin n → UnitAddCircle) × (Fin r → ℤ) × ((i : Fin s) → ZMod (d i))

lemma rho_exists {D : ℕ} (A₁ : AddSubgroup (Fin D → ℝ)) (hA₁ : IsClosed (A₁ : Set (Fin D → ℝ))) :
    ∃ (m k : ℕ) (ρ : (Fin D → ℝ) →+ (Fin m → ℝ) × (Fin k → UnitAddCircle)),
      Continuous ρ ∧ IsOpenMap ρ ∧ Function.Surjective ρ ∧ ∀ x, ρ x = 0 ↔ x ∈ A₁ := by
  obtain ⟨p, k, m, v, b, κ, hκs, hκA, -⟩ := closedSubgroup_structure A₁ hA₁
  let F : (Fin k → ℝ) × (Fin m → ℝ) → (Fin m → ℝ) × (Fin k → UnitAddCircle) :=
    fun y => (y.2, fun j => ((y.1 j : ℝ) : UnitAddCircle))
  let ρ : (Fin D → ℝ) →+ (Fin m → ℝ) × (Fin k → UnitAddCircle) :=
    AddMonoidHom.mk' (fun x => F (κ x)) (by
      intro x y
      simp only [F, map_add, Prod.fst_add, Prod.snd_add, Pi.add_apply, AddCircle.coe_add]
      rfl)
  have hκc : Continuous κ := LinearMap.continuous_of_finiteDimensional κ
  refine ⟨m, k, ρ, ?_, ?_, ?_, ?_⟩
  · refine (continuous_snd.comp hκc).prodMk (continuous_pi fun j => ?_)
    exact QuotientAddGroup.continuous_mk.comp ((continuous_apply j).comp (continuous_fst.comp hκc))
  · have hF : IsOpenMap F := by
      have h1 : IsOpenMap (Prod.map (fun (y : Fin k → ℝ) (j : Fin k) => ((y j : ℝ) : UnitAddCircle))
          (id : (Fin m → ℝ) → (Fin m → ℝ))) :=
        (IsOpenMap.piMap (fun _ => QuotientAddGroup.isOpenMap_coe)
          (Filter.Eventually.of_forall fun _ => QuotientAddGroup.mk_surjective)).prodMap IsOpenMap.id
      exact (Homeomorph.prodComm _ _).isOpenMap.comp h1
    exact hF.comp (κ.isOpenMap_of_finiteDimensional hκs)
  · rintro ⟨γ, θ⟩
    choose t ht using fun j => QuotientAddGroup.mk_surjective (θ j)
    obtain ⟨x, hx⟩ := hκs (t, γ)
    refine ⟨x, ?_⟩
    simp only [ρ, AddMonoidHom.mk'_apply, F, hx]
    ext j
    · rfl
    · exact ht j
  · intro x
    rw [hκA x]
    simp only [ρ, AddMonoidHom.mk'_apply, F, Prod.ext_iff, Prod.fst_zero, Prod.snd_zero]
    constructor
    · rintro ⟨h2, h1⟩
      refine ⟨fun j => ?_, h2⟩
      have := congrFun h1 j
      obtain ⟨n, hn⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).1 this
      exact ⟨n, by rw [← hn, zsmul_one]⟩
    · rintro ⟨h1, h2⟩
      refine ⟨h2, funext fun j => ?_⟩
      obtain ⟨n, hn⟩ := h1 j
      exact (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).2 ⟨n, by rw [hn, zsmul_one]⟩

lemma snf_coeff_ne_zero {a s : ℕ} {M : Submodule ℤ (Fin a → ℤ)}
    (snf : Basis.SmithNormalForm M (Fin a) s) (i : Fin s) : snf.a i ≠ 0 := by
  intro hci
  have := snf.snf i
  rw [hci, zero_smul] at this
  exact snf.bN.ne_zero i (Subtype.ext this)

lemma snf_repr {a s : ℕ} {M : Submodule ℤ (Fin a → ℤ)}
    (snf : Basis.SmithNormalForm M (Fin a) s) {z : Fin a → ℤ} (hz : z ∈ M) (i : Fin s) :
    snf.bM.repr z (snf.f i) = snf.a i * snf.bN.repr ⟨z, hz⟩ i := by
  have := snf.repr_apply_embedding_eq_repr_smul ⟨z, hz⟩ (i := i)
  rw [map_smul, Finsupp.smul_apply, smul_eq_mul] at this
  exact this

lemma tau_exists {a : ℕ} (M : AddSubgroup (Fin a → ℤ)) :
    ∃ (r s : ℕ) (d : Fin s → ℕ) (τ : (Fin a → ℤ) →+ (Fin r → ℤ) × ((i : Fin s) → ZMod (d i))),
      (∀ i, d i ≠ 0) ∧ Function.Surjective τ ∧ ∀ z, τ z = 0 ↔ z ∈ M := by
  classical
  obtain ⟨s, snf⟩ := M.toIntSubmodule.smithNormalForm (Pi.basisFun ℤ (Fin a))
  have hc := snf_coeff_ne_zero snf
  let R := {l : Fin a // l ∉ range snf.f}
  let g : Fin (Fintype.card R) ≃ R := (Fintype.equivFin R).symm
  let d : Fin s → ℕ := fun i => (snf.a i).natAbs
  have hd : ∀ i, d i ≠ 0 := fun i => Int.natAbs_ne_zero.2 (hc i)
  let τ : (Fin a → ℤ) →+ (Fin (Fintype.card R) → ℤ) × ((i : Fin s) → ZMod (d i)) :=
    AddMonoidHom.mk' (fun z => (fun l => snf.bM.repr z (g l).1,
      fun i => ((snf.bM.repr z (snf.f i) : ℤ) : ZMod (d i)))) (by
      intro z w
      ext <;> simp)
  have hmem : ∀ z, z ∈ M ↔ (∀ l : R, snf.bM.repr z l.1 = 0) ∧
      ∀ i, snf.a i ∣ snf.bM.repr z (snf.f i) := by
    intro z
    constructor
    · intro hz
      have hz' : z ∈ M.toIntSubmodule := hz
      refine ⟨fun l => snf.repr_eq_zero_of_notMem_range ⟨z, hz'⟩ l.2, fun i => ?_⟩
      rw [snf_repr snf hz' i]
      exact dvd_mul_right _ _
    · rintro ⟨h0, hdvd⟩
      have e : z = ∑ i, (snf.bM.repr z (snf.f i) / snf.a i) • (snf.bN i : Fin a → ℤ) := by
        conv_lhs => rw [← snf.bM.sum_repr z]
        symm
        refine Fintype.sum_of_injective snf.f snf.f.injective _ _ (fun l hl => ?_) (fun i => ?_)
        · rw [h0 ⟨l, hl⟩, zero_smul]
        · rw [snf.snf i, smul_smul, Int.ediv_mul_cancel (hdvd i)]
      show z ∈ M.toIntSubmodule
      rw [e]
      exact M.toIntSubmodule.sum_mem fun i _ => M.toIntSubmodule.smul_mem _ (snf.bN i).2
  refine ⟨Fintype.card R, s, d, τ, hd, ?_, ?_⟩
  · rintro ⟨α, β⟩
    let F : Fin a → ℤ := fun l => if h : l ∈ range snf.f then
      ((β (snf.f.invOfMemRange ⟨l, h⟩)).val : ℤ) else α (g.symm ⟨l, h⟩)
    refine ⟨snf.bM.equivFun.symm F, ?_⟩
    have hF : ∀ l, snf.bM.repr (snf.bM.equivFun.symm F) l = F l := fun l => by
      rw [← Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    simp only [τ, AddMonoidHom.mk'_apply, hF]
    ext l
    · simp only [F, dif_neg (g l).2]
      congr 1
      simp
    · simp only [F]
      rw [dif_pos (Set.mem_range_self l)]
      haveI : NeZero (d l) := ⟨hd l⟩
      have key : ((β (snf.f.invOfMemRange ⟨snf.f l, Set.mem_range_self l⟩)).val : ℕ) = (β l).val := by
        rw [Function.Embedding.right_inv_of_invOfMemRange]
      rw [key, Int.cast_natCast, ZMod.natCast_zmod_val]
  · intro z
    rw [hmem z]
    simp only [τ, AddMonoidHom.mk'_apply, Prod.ext_iff, Prod.fst_zero, Prod.snd_zero, funext_iff,
      Pi.zero_apply, d, ZMod.intCast_zmod_eq_zero_iff_dvd, Int.natAbs_dvd]
    constructor
    · rintro ⟨h1, h2⟩
      exact ⟨fun l => by simpa using h1 (g.symm l), h2⟩
    · rintro ⟨h1, h2⟩
      exact ⟨fun l => h1 (g l), h2⟩

lemma exists_section {D a : ℕ} (A : AddSubgroup ((Fin D → ℝ) × (Fin a → ℤ))) :
    ∃ g : (Fin a → ℤ) →+ (Fin D → ℝ), ∀ z ∈ A.map (AddMonoidHom.snd _ _), (g z, z) ∈ A := by
  classical
  let M := A.map (AddMonoidHom.snd (Fin D → ℝ) (Fin a → ℤ))
  obtain ⟨s, snf⟩ := M.toIntSubmodule.smithNormalForm (Pi.basisFun ℤ (Fin a))
  have hc := snf_coeff_ne_zero snf
  have hlift : ∀ i, ∃ y ∈ A, y.2 = (snf.bN i : Fin a → ℤ) := fun i => by
    obtain ⟨y, hy, h⟩ := (snf.bN i).2
    exact ⟨y, hy, h⟩
  choose y hyA hy2 using hlift
  let g : (Fin a → ℤ) →+ (Fin D → ℝ) := AddMonoidHom.mk'
    (fun z => ∑ i, (((snf.bM.repr z (snf.f i) : ℤ) : ℝ) / snf.a i) • (y i).1) (by
      intro z w
      simp [add_div, add_smul, Finset.sum_add_distrib])
  refine ⟨g, fun z hz => ?_⟩
  have hz' : z ∈ M.toIntSubmodule := hz
  let q := snf.bN.repr ⟨z, hz'⟩
  have hgz : g z = ∑ i, q i • (y i).1 := by
    simp only [g, AddMonoidHom.mk'_apply, snf_repr snf hz']
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Int.cast_mul, mul_div_cancel_left₀ _ (Int.cast_ne_zero.2 (hc i)), Int.cast_smul_eq_zsmul]
  have hzsum : z = ∑ i, q i • (y i).2 := by
    simp only [hy2]
    have h := congrArg Subtype.val (snf.bN.sum_repr ⟨z, hz'⟩)
    rw [Submodule.coe_sum] at h
    simpa using h.symm
  have e : (g z, z) = ∑ i, q i • y i := by
    refine Prod.ext ?_ ?_
    · rw [hgz, Prod.fst_sum]; simp
    · rw [Prod.snd_sum]
      conv_lhs => rw [hzsum]
      simp
  rw [e]
  exact A.sum_mem fun i _ => A.zsmul_mem (hyA i) _

/-- **Quotients of `ℝ^D × ℤ^a` by closed subgroups are elementary.** -/
theorem quotient_elem (D a : ℕ) (A : AddSubgroup ((Fin D → ℝ) × (Fin a → ℤ)))
    (hA : IsClosed (A : Set ((Fin D → ℝ) × (Fin a → ℤ)))) :
    ∃ (m n r s : ℕ) (d : Fin s → ℕ) (ψ : ((Fin D → ℝ) × (Fin a → ℤ)) →+ ElemG m n r s d),
      (∀ i, d i ≠ 0) ∧ Continuous ψ ∧ IsOpenMap ψ ∧ Function.Surjective ψ ∧
        ∀ x, ψ x = 0 ↔ x ∈ A := by
  let A₁ : AddSubgroup (Fin D → ℝ) := A.comap (AddMonoidHom.inl _ _)
  have hA₁ : IsClosed (A₁ : Set (Fin D → ℝ)) :=
    hA.preimage (continuous_id.prodMk continuous_const)
  obtain ⟨m, k, ρ, hρc, hρo, hρs, hρk⟩ := rho_exists A₁ hA₁
  obtain ⟨r, s, d, τ, hd, hτs, hτk⟩ := tau_exists (A.map (AddMonoidHom.snd _ _))
  obtain ⟨g, hg⟩ := exists_section A
  have hgc : Continuous g := continuous_of_discreteTopology
  let σ : (Fin D → ℝ) × (Fin a → ℤ) → (Fin D → ℝ) × (Fin a → ℤ) := fun x => (x.1 - g x.2, x.2)
  let σ' : (Fin D → ℝ) × (Fin a → ℤ) → (Fin D → ℝ) × (Fin a → ℤ) := fun x => (x.1 + g x.2, x.2)
  let ψ : ((Fin D → ℝ) × (Fin a → ℤ)) →+ ElemG m k r s d := AddMonoidHom.mk'
    (fun x => ((ρ (x.1 - g x.2)).1, (ρ (x.1 - g x.2)).2, (τ x.2).1, (τ x.2).2)) (by
      intro x y
      simp only [Prod.fst_add, Prod.snd_add, map_add, add_sub_add_comm]
      rfl)
  refine ⟨m, k, r, s, d, ψ, hd, ?_, ?_, ?_, ?_⟩
  · have h1 : Continuous fun x : (Fin D → ℝ) × (Fin a → ℤ) => ρ (x.1 - g x.2) :=
      hρc.comp (continuous_fst.sub (hgc.comp continuous_snd))
    have h2 : Continuous fun x : (Fin D → ℝ) × (Fin a → ℤ) => τ x.2 :=
      (continuous_of_discreteTopology (f := τ)).comp continuous_snd
    exact (continuous_fst.comp h1).prodMk ((continuous_snd.comp h1).prodMk
      ((continuous_fst.comp h2).prodMk (continuous_snd.comp h2)))
  · have hσo : IsOpenMap σ := by
      intro U hU
      rw [image_eq_preimage_of_inverse (f := σ) (g := σ')
        (fun x => by simp [σ, σ']) (fun x => by simp [σ, σ'])]
      exact hU.preimage ((continuous_fst.add (hgc.comp continuous_snd)).prodMk continuous_snd)
    have hτo : IsOpenMap τ := fun U _ => isOpen_discrete _
    exact (Homeomorph.prodAssoc _ _ _).isOpenMap.comp ((hρo.prodMap hτo).comp hσo)
  · rintro ⟨u1, u2, t1, t2⟩
    obtain ⟨x', hx'⟩ := hρs (u1, u2)
    obtain ⟨z, hz⟩ := hτs (t1, t2)
    refine ⟨(x' + g z, z), ?_⟩
    simp only [ψ, AddMonoidHom.mk'_apply, add_sub_cancel_right, hx', hz]
  · intro x
    have e : ψ x = 0 ↔ ρ (x.1 - g x.2) = 0 ∧ τ x.2 = 0 := by
      simp only [ψ, AddMonoidHom.mk'_apply, Prod.ext_iff, Prod.fst_zero, Prod.snd_zero]
      tauto
    rw [e, hρk, hτk]
    constructor
    · rintro ⟨h1, h2⟩
      have h3 := hg _ h2
      have : x = (x.1 - g x.2, 0) + (g x.2, x.2) := by ext <;> simp
      rw [this]
      exact A.add_mem h1 h3
    · intro hx
      have h2 : x.2 ∈ A.map (AddMonoidHom.snd _ _) := ⟨x, hx, rfl⟩
      refine ⟨?_, h2⟩
      have := A.sub_mem hx (hg _ h2)
      show (x.1 - g x.2, (0 : Fin a → ℤ)) ∈ A
      have e2 : x - (g x.2, x.2) = (x.1 - g x.2, 0) := by ext <;> simp
      rwa [e2] at this

end LCA

end QuotElem_sec

section PW1_sec

open MeasureTheory Topology Set Filter ComplexConjugate
open scoped InnerProductSpace

set_option linter.unusedSectionVars false

namespace LCA.PW

variable {C : Type*} [CommGroup C] [TopologicalSpace C] [IsTopologicalGroup C] [T2Space C]
  [CompactSpace C] [MeasurableSpace C] [BorelSpace C] (μ : Measure C) [μ.IsHaarMeasure]

/-- The embedding of continuous functions into `L²`. -/
noncomputable def J : C(C, ℂ) →L[ℂ] Lp ℂ 2 μ := ContinuousMap.toLp 2 μ ℂ

lemma ip_eq (f g : C(C, ℂ)) : ⟪J μ f, J μ g⟫_ℂ = ∫ x, g x * conj (f x) ∂μ :=
  ContinuousMap.inner_toLp μ f g

lemma J_inj : Function.Injective (J μ) := ContinuousMap.toLp_injective μ

/-- Right translation. -/
noncomputable def rt (g : C) : C(C, ℂ) →ₗ[ℂ] C(C, ℂ) where
  toFun f := f.comp (ContinuousMap.mulRight g)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [T2Space C] [CompactSpace C] in
@[simp] lemma rt_apply (g : C) (f : C(C, ℂ)) (x : C) : rt g f x = f (x * g) := rfl

omit [T2Space C] [CompactSpace C] in
lemma rt_rt (g h : C) (f : C(C, ℂ)) : rt g (rt h f) = rt (h * g) f := by
  ext x; simp [mul_assoc, mul_comm g h]

omit [T2Space C] [CompactSpace C] in
lemma rt_comm (g h : C) (f : C(C, ℂ)) : rt g (rt h f) = rt h (rt g f) := by
  rw [rt_rt, rt_rt, mul_comm]

omit [T2Space C] [CompactSpace C] in
@[simp] lemma rt_one (f : C(C, ℂ)) : rt 1 f = f := by ext x; simp

lemma integral_rt (F : C → ℂ) (g : C) : ∫ x, F (x * g) ∂μ = ∫ x, F x ∂μ := by
  simp_rw [mul_comm _ g]
  exact integral_mul_left_eq_self F g

lemma ip_rt (g : C) (a b : C(C, ℂ)) : ⟪J μ (rt g a), J μ (rt g b)⟫_ℂ = ⟪J μ a, J μ b⟫_ℂ := by
  rw [ip_eq, ip_eq]
  exact integral_rt μ (fun x => b x * conj (a x)) g

lemma norm_rt (g : C) (f : C(C, ℂ)) : ‖rt g f‖ = ‖f‖ := by
  apply le_antisymm
  · exact (ContinuousMap.norm_le _ (norm_nonneg _)).2 fun x => f.norm_coe_le_norm _
  · refine (ContinuousMap.norm_le _ (norm_nonneg _)).2 fun x => ?_
    have := (rt g f).norm_coe_le_norm (x * g⁻¹)
    simpa using this

section kernel

variable (φ : C(C, ℝ))

/-- The convolution kernel `x ↦ (y ↦ φ (x y⁻¹))`. -/
noncomputable def kk : C(C, C(C, ℂ)) :=
  ContinuousMap.curry ⟨fun p : C × C => ((φ (p.1 * p.2⁻¹) : ℝ) : ℂ),
    Complex.continuous_ofReal.comp (φ.continuous.comp (continuous_fst.mul continuous_snd.inv))⟩

omit [T2Space C] in
@[simp] lemma kk_apply (x y : C) : kk φ x y = ((φ (x * y⁻¹) : ℝ) : ℂ) := rfl

/-- The convolution operator. -/
noncomputable def T : C(C, ℂ) →ₗ[ℂ] C(C, ℂ) where
  toFun f := ⟨fun x => ⟪J μ (kk φ x), J μ f⟫_ℂ,
    ((J μ).continuous.comp (kk φ).continuous).inner continuous_const⟩
  map_add' f g := by ext x; simp [inner_add_right]
  map_smul' c f := by ext x; simp [inner_smul_right]

lemma T_apply' (f : C(C, ℂ)) (x : C) : T μ φ f x = ⟪J μ (kk φ x), J μ f⟫_ℂ := rfl

lemma T_apply (f : C(C, ℂ)) (x : C) : T μ φ f x = ∫ y, f y * ((φ (x * y⁻¹) : ℝ) : ℂ) ∂μ := by
  rw [T_apply', ip_eq]
  simp [kk_apply, Complex.conj_ofReal]

omit [T2Space C] in
lemma norm_kk (x : C) : ‖kk φ x‖ ≤ ‖φ‖ :=
  (ContinuousMap.norm_le _ (norm_nonneg _)).2 fun y => by
    rw [kk_apply, Complex.norm_real]
    exact φ.norm_coe_le_norm _

lemma norm_T_le (f : C(C, ℂ)) : ‖T μ φ f‖ ≤ ‖J μ‖ * ‖φ‖ * ‖J μ f‖ :=
  (ContinuousMap.norm_le _ (by positivity)).2 fun x =>
    (norm_inner_le_norm _ _).trans (mul_le_mul_of_nonneg_right
      (((J μ).le_opNorm _).trans (mul_le_mul_of_nonneg_left (norm_kk φ x) (norm_nonneg _)))
      (norm_nonneg _))

lemma dist_T (f : C(C, ℂ)) (x x' : C) :
    ‖T μ φ f x - T μ φ f x'‖ ≤ ‖J μ‖ * ‖kk φ x - kk φ x'‖ * ‖J μ f‖ := by
  rw [T_apply', T_apply', ← inner_sub_left, ← map_sub]
  exact (norm_inner_le_norm _ _).trans
    (mul_le_mul_of_nonneg_right ((J μ).le_opNorm _) (norm_nonneg _))

/-- The image of an `L²`-ball under `T` has compact closure (Arzelà–Ascoli). -/
lemma isCompact_closure_T (L : ℝ) :
    IsCompact (closure {g | ∃ f, ‖J μ f‖ ≤ L ∧ g = T μ φ f}) := by
  set A := {g | ∃ f, ‖J μ f‖ ≤ L ∧ g = T μ φ f}
  let e := ContinuousMap.isometryEquivBoundedOfCompact C ℂ
  have h' : IsCompact (closure (e '' A)) := by
    refine BoundedContinuousFunction.arzela_ascoli (Metric.closedBall 0 (‖J μ‖ * ‖φ‖ * L))
      (isCompact_closedBall _ _) _ ?_ ?_
    · rintro _ x ⟨g, ⟨f, hf, rfl⟩, rfl⟩
      rw [mem_closedBall_zero_iff]
      have h1 : ‖T μ φ f x‖ ≤ ‖T μ φ f‖ := (T μ φ f).norm_coe_le_norm x
      have h2 := norm_T_le μ φ f
      have h3 : ‖J μ‖ * ‖φ‖ * ‖J μ f‖ ≤ ‖J μ‖ * ‖φ‖ * L :=
        mul_le_mul_of_nonneg_left hf (by positivity)
      exact h1.trans (h2.trans h3)
    · intro x₀
      rw [Metric.equicontinuousAt_iff_right]
      intro ε hε
      have hc : Tendsto (fun x => kk φ x) (𝓝 x₀) (𝓝 (kk φ x₀)) := (kk φ).continuous.tendsto x₀
      have hK : 0 < ‖J μ‖ * (|L| + 1) + 1 := by positivity
      have := (Metric.tendsto_nhds.1 hc) (ε / (‖J μ‖ * (|L| + 1) + 1)) (by positivity)
      filter_upwards [this] with x hx
      rintro ⟨_, ⟨g, ⟨f, hf, rfl⟩, rfl⟩⟩
      show dist (T μ φ f x₀) (T μ φ f x) < ε
      rw [dist_eq_norm]
      refine (dist_T μ φ f x₀ x).trans_lt ?_
      rw [dist_eq_norm, norm_sub_rev] at hx
      have hL : ‖J μ f‖ ≤ |L| + 1 := hf.trans ((le_abs_self L).trans (by linarith))
      calc ‖J μ‖ * ‖kk φ x₀ - kk φ x‖ * ‖J μ f‖
          ≤ ‖J μ‖ * (ε / (‖J μ‖ * (|L| + 1) + 1)) * (|L| + 1) := by
            gcongr
        _ = ε * (‖J μ‖ * (|L| + 1)) / (‖J μ‖ * (|L| + 1) + 1) := by ring
        _ < ε := by
            rw [div_lt_iff₀ hK]
            nlinarith
  have : closure A = e.symm '' closure (e '' A) := by
    have h := e.symm.toHomeomorph.image_closure (e '' A)
    have h2 : (e.symm.toHomeomorph : BoundedContinuousFunction C ℂ → C(C, ℂ)) = e.symm := rfl
    rw [h2, image_image] at h
    simp only [IsometryEquiv.symm_apply_apply, image_id'] at h
    exact h.symm
  rw [this]
  exact h'.image e.symm.continuous

end kernel

end LCA.PW

end PW1_sec

section PW2_sec

open MeasureTheory Topology Set Filter ComplexConjugate
open scoped InnerProductSpace

set_option linter.unusedSectionVars false

namespace LCA.PW

variable {C : Type*} [CommGroup C] [TopologicalSpace C] [IsTopologicalGroup C] [T2Space C]
  [CompactSpace C] [MeasurableSpace C] [BorelSpace C] [SecondCountableTopology C]
  (μ : Measure C) [μ.IsHaarMeasure] (φ : C(C, ℝ))

lemma integrable_of_continuous {Y : Type*} [TopologicalSpace Y] [CompactSpace Y]
    [MeasurableSpace Y] [OpensMeasurableSpace Y] (ν : Measure Y) [IsFiniteMeasure ν]
    {F : Y → ℂ} (hF : Continuous F) : Integrable F ν :=
  hF.integrable_of_hasCompactSupport
    (isCompact_univ.of_isClosed_subset (isClosed_tsupport _) (subset_univ _))

lemma re_smul_inner_self {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] (x : E)
    (c : ℝ) : RCLike.re (((c ^ 2 : ℝ) : ℂ) * ⟪x, x⟫_ℂ) = c ^ 2 * ‖x‖ ^ 2 := by
  rw [inner_self_eq_norm_sq_to_K]
  simp only [RCLike.re_to_complex]
  norm_cast
  simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
  rfl

lemma T_symm (hφ : ∀ x, φ x⁻¹ = φ x) (f g : C(C, ℂ)) :
    ⟪J μ (T μ φ f), J μ g⟫_ℂ = ⟪J μ f, J μ (T μ φ g)⟫_ℂ := by
  rw [ip_eq, ip_eq]
  simp_rw [T_apply]
  have hL : ∀ x, g x * conj (∫ y, f y * ((φ (x * y⁻¹) : ℝ) : ℂ) ∂μ) =
      ∫ y, g x * conj (f y) * ((φ (x * y⁻¹) : ℝ) : ℂ) ∂μ := by
    intro x
    rw [← integral_conj, ← integral_const_mul]
    congr 1; ext y
    simp only [map_mul, Complex.conj_ofReal]
    ring
  have hR : ∀ y, (∫ x, g x * ((φ (y * x⁻¹) : ℝ) : ℂ) ∂μ) * conj (f y) =
      ∫ x, g x * conj (f y) * ((φ (x * y⁻¹) : ℝ) : ℂ) ∂μ := by
    intro y
    rw [← integral_mul_const]
    congr 1; ext x
    rw [show y * x⁻¹ = (x * y⁻¹)⁻¹ by group, hφ]
    ring
  simp_rw [hL, hR]
  refine integral_integral_swap (integrable_of_continuous _ ?_)
  exact ((g.continuous.comp continuous_fst).mul
    ((Complex.continuous_conj.comp f.continuous).comp continuous_snd)).mul
    (Complex.continuous_ofReal.comp (φ.continuous.comp (continuous_fst.mul continuous_snd.inv)))

lemma T_comm (g : C) (f : C(C, ℂ)) : T μ φ (rt g f) = rt g (T μ φ f) := by
  ext x
  rw [rt_apply, T_apply, T_apply]
  conv_rhs => rw [← integral_rt μ _ g]
  congr 1; ext y
  rw [rt_apply, show x * g * (y * g)⁻¹ = x * y⁻¹ by group]

lemma N_le (v : C(C, ℂ)) : ‖J μ v‖ ≤ ‖J μ‖ * ‖v‖ := (J μ).le_opNorm v

lemma T_bound (v : C(C, ℂ)) : ‖T μ φ v‖ ≤ ‖J μ‖ * ‖φ‖ * ‖J μ‖ * ‖v‖ := by
  have := norm_T_le μ φ v
  have h2 := N_le μ v
  calc ‖T μ φ v‖ ≤ ‖J μ‖ * ‖φ‖ * ‖J μ v‖ := this
    _ ≤ ‖J μ‖ * ‖φ‖ * (‖J μ‖ * ‖v‖) := by gcongr
    _ = _ := by ring

lemma T_continuous : Continuous (T μ φ) :=
  AddMonoidHomClass.continuous_of_bound (T μ φ) (‖J μ‖ * ‖φ‖ * ‖J μ‖) (T_bound μ φ)

lemma J_eq_zero {f : C(C, ℂ)} (h : ‖J μ f‖ = 0) : f = 0 := by
  apply J_inj μ
  rw [map_zero]
  exact norm_eq_zero.1 h

/-- **Rayleigh quotient argument**: a nonzero self-adjoint compact operator on an invariant
closed subspace has a positive eigenvalue for `T²`. -/
lemma exists_eigen (hφ : ∀ x, φ x⁻¹ = φ x) (M : Submodule ℂ C(C, ℂ))
    (hMc : IsClosed (M : Set C(C, ℂ))) (hMT : ∀ f ∈ M, T μ φ f ∈ M) {u : C(C, ℂ)}
    (hu : u ∈ M) (hTu : T μ φ u ≠ 0) :
    ∃ c : ℝ, 0 < c ∧ ∃ h ∈ M, h ≠ 0 ∧ T μ φ (T μ φ h) = ((c ^ 2 : ℝ) : ℂ) • h := by
  set K := ‖J μ‖ * ‖φ‖ with hK
  have hK0 : 0 ≤ K := by positivity
  let S : Set ℝ := {r | ∃ f ∈ M, ‖J μ f‖ ≤ 1 ∧ r = ‖J μ (T μ φ f)‖}
  have hSbdd : BddAbove S := ⟨‖J μ‖ * K, by
    rintro _ ⟨f, -, hf, rfl⟩
    calc ‖J μ (T μ φ f)‖ ≤ ‖J μ‖ * ‖T μ φ f‖ := N_le μ _
      _ ≤ ‖J μ‖ * (K * ‖J μ f‖) := by gcongr; exact norm_T_le μ φ f
      _ ≤ ‖J μ‖ * (K * 1) := by gcongr
      _ = ‖J μ‖ * K := by ring⟩
  have hSne : S.Nonempty := ⟨_, 0, M.zero_mem, by simp, rfl⟩
  set c := sSup S with hcdef
  have hcb : ∀ f ∈ M, ‖J μ (T μ φ f)‖ ≤ c * ‖J μ f‖ := by
    intro f hf
    by_cases h0 : ‖J μ f‖ = 0
    · rw [J_eq_zero μ h0]; simp
    · have hpos : 0 < ‖J μ f‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm h0)
      have hmem : ‖J μ f‖⁻¹ * ‖J μ (T μ φ f)‖ ∈ S := by
        refine ⟨((‖J μ f‖⁻¹ : ℝ) : ℂ) • f, M.smul_mem _ hf, ?_, ?_⟩
        · rw [map_smul, norm_smul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (inv_pos.2 hpos), inv_mul_cancel₀ h0]
        · rw [map_smul, map_smul, norm_smul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (inv_pos.2 hpos)]
      have := le_csSup hSbdd hmem
      rw [inv_mul_le_iff₀ hpos] at this
      linarith
  have hTu0 : 0 < ‖J μ (T μ φ u)‖ := by
    refine lt_of_le_of_ne (norm_nonneg _) (Ne.symm fun h => hTu (J_eq_zero μ h))
  have hc0 : 0 < c := by
    by_contra hneg
    push Not at hneg
    have := hcb u hu
    have : c * ‖J μ u‖ ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hneg (norm_nonneg _)
    linarith
  obtain ⟨r, -, hr_lim, hrS⟩ := exists_seq_tendsto_sSup hSne hSbdd
  choose f hfM hf1 hrf using hrS
  obtain ⟨h, -, ψ, hψ, hlim⟩ := (isCompact_closure_T μ φ 1).tendsto_subseq
    (x := fun n => T μ φ (f n)) (fun n => subset_closure ⟨f n, hf1 n, rfl⟩)
  have hhM : h ∈ M := hMc.mem_of_tendsto hlim (Eventually.of_forall fun n => hMT _ (hfM _))
  have hNh : ‖J μ h‖ = c := by
    have h1 : Tendsto (fun n => ‖J μ (T μ φ (f (ψ n)))‖) atTop (𝓝 c) := by
      have := hr_lim.comp hψ.tendsto_atTop
      refine this.congr fun n => ?_
      simp [hrf]
    have h2 : Tendsto (fun n => ‖J μ (T μ φ (f (ψ n)))‖) atTop (𝓝 ‖J μ h‖) :=
      ((J μ).continuous.norm.tendsto h).comp hlim
    exact tendsto_nhds_unique h2 h1
  refine ⟨c, hc0, h, hhM, fun h0 => by rw [h0, map_zero, norm_zero] at hNh; linarith, ?_⟩
  -- key estimate
  have hest : ∀ n, ‖J μ (T μ φ (T μ φ (f n)) - ((c ^ 2 : ℝ) : ℂ) • f n)‖ ^ 2 ≤
      c ^ 2 * (c ^ 2 - ‖J μ (T μ φ (f n))‖ ^ 2) := by
    intro n
    rw [map_sub, map_smul, @norm_sub_sq ℂ, inner_smul_right, T_symm μ φ hφ (T μ φ (f n)) (f n),
      re_smul_inner_self, norm_smul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (by positivity)]
    have ha : ‖J μ (T μ φ (T μ φ (f n)))‖ ≤ c * ‖J μ (T μ φ (f n))‖ := hcb _ (hMT _ (hfM n))
    have hb : ‖J μ (f n)‖ ≤ 1 := hf1 n
    have h0 : 0 ≤ ‖J μ (T μ φ (T μ φ (f n)))‖ := norm_nonneg _
    have h0' : 0 ≤ ‖J μ (f n)‖ := norm_nonneg _
    have hsq1 : ‖J μ (T μ φ (T μ φ (f n)))‖ ^ 2 ≤ c ^ 2 * ‖J μ (T μ φ (f n))‖ ^ 2 := by
      have := pow_le_pow_left₀ h0 ha 2
      nlinarith
    have hsq2 : (c ^ 2 * ‖J μ (f n)‖) ^ 2 ≤ c ^ 2 * c ^ 2 := by
      have : c ^ 2 * ‖J μ (f n)‖ ≤ c ^ 2 := by nlinarith
      have h1 : 0 ≤ c ^ 2 * ‖J μ (f n)‖ := by positivity
      calc (c ^ 2 * ‖J μ (f n)‖) ^ 2 ≤ (c ^ 2) ^ 2 := pow_le_pow_left₀ h1 this 2
        _ = c ^ 2 * c ^ 2 := by ring
    nlinarith
  have he : Tendsto (fun n => ‖J μ (T μ φ (T μ φ (f n)) - ((c ^ 2 : ℝ) : ℂ) • f n)‖) atTop (𝓝 0) := by
    have hrhs : Tendsto (fun n => Real.sqrt (c ^ 2 * (c ^ 2 - ‖J μ (T μ φ (f n))‖ ^ 2))) atTop
        (𝓝 0) := by
      have : Tendsto (fun n => ‖J μ (T μ φ (f n))‖) atTop (𝓝 c) :=
        hr_lim.congr fun n => by simp [hrf]
      have h2 := ((this.pow 2).const_sub (c ^ 2)).const_mul (c ^ 2)
      have h3 := (Real.continuous_sqrt.tendsto _).comp h2
      simp only [sub_self, mul_zero, Real.sqrt_zero] at h3
      exact h3
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => ?_) hrhs
    exact Real.le_sqrt_of_sq_le (hest n)
  -- `c² f (ψ n) → T h` in `L²`
  have hL2 : Tendsto (fun n => ‖J μ (((c ^ 2 : ℝ) : ℂ) • f (ψ n) - T μ φ h)‖) atTop (𝓝 0) := by
    have hb : ∀ n, ‖J μ (((c ^ 2 : ℝ) : ℂ) • f (ψ n) - T μ φ h)‖ ≤
        ‖J μ (T μ φ (T μ φ (f (ψ n))) - ((c ^ 2 : ℝ) : ℂ) • f (ψ n))‖ +
          ‖J μ‖ * (K * (‖J μ‖ * ‖T μ φ (f (ψ n)) - h‖)) := by
      intro n
      have e : ((c ^ 2 : ℝ) : ℂ) • f (ψ n) - T μ φ h =
          -(T μ φ (T μ φ (f (ψ n))) - ((c ^ 2 : ℝ) : ℂ) • f (ψ n)) +
            T μ φ (T μ φ (f (ψ n)) - h) := by
        rw [map_sub]; abel
      rw [e, map_add, map_neg]
      refine (norm_add_le _ _).trans (add_le_add (le_of_eq (norm_neg _)) ?_)
      calc ‖J μ (T μ φ (T μ φ (f (ψ n)) - h))‖ ≤ ‖J μ‖ * ‖T μ φ (T μ φ (f (ψ n)) - h)‖ :=
            N_le μ _
        _ ≤ ‖J μ‖ * (K * ‖J μ (T μ φ (f (ψ n)) - h)‖) := by gcongr; exact norm_T_le μ φ _
        _ ≤ ‖J μ‖ * (K * (‖J μ‖ * ‖T μ φ (f (ψ n)) - h‖)) := by gcongr; exact N_le μ _
    refine squeeze_zero (fun n => norm_nonneg _) hb ?_
    have h1 := he.comp hψ.tendsto_atTop
    have h2 : Tendsto (fun n => ‖T μ φ (f (ψ n)) - h‖) atTop (𝓝 0) :=
      tendsto_iff_norm_sub_tendsto_zero.1 hlim
    have h3 := ((h2.const_mul ‖J μ‖).const_mul K).const_mul ‖J μ‖
    simpa using h1.add h3
  have hlim2 : Tendsto (fun n => ((c ^ 2 : ℝ) : ℂ) • T μ φ (f (ψ n))) atTop
      (𝓝 (T μ φ (T μ φ h))) := by
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => ?_) ((hL2.const_mul K).trans_eq ?_ )
    · rw [← map_smul, ← map_sub]
      exact norm_T_le μ φ _
    · simp
  have hlim3 : Tendsto (fun n => ((c ^ 2 : ℝ) : ℂ) • T μ φ (f (ψ n))) atTop
      (𝓝 (((c ^ 2 : ℝ) : ℂ) • h)) := hlim.const_smul _
  exact tendsto_nhds_unique hlim2 hlim3

/-- The eigenspace of `T²` (inside a closed subspace) for a nonzero eigenvalue. -/
noncomputable def eigenSub (M : Submodule ℂ C(C, ℂ)) (lam : ℂ) : Submodule ℂ C(C, ℂ) :=
  M ⊓ LinearMap.ker (T μ φ ∘ₗ T μ φ - lam • LinearMap.id)

lemma mem_eigenSub (M : Submodule ℂ C(C, ℂ)) (lam : ℂ) (f : C(C, ℂ)) :
    f ∈ eigenSub μ φ M lam ↔ f ∈ M ∧ T μ φ (T μ φ f) = lam • f := by
  simp [eigenSub, sub_eq_zero]

lemma eigenSub_finiteDimensional (M : Submodule ℂ C(C, ℂ)) (hMc : IsClosed (M : Set C(C, ℂ)))
    (lam : ℂ) (hlam : lam ≠ 0) : FiniteDimensional ℂ (eigenSub μ φ M lam) := by
  have hEc : IsClosed ((eigenSub μ φ M lam : Submodule ℂ C(C, ℂ)) : Set C(C, ℂ)) := by
    have : ((eigenSub μ φ M lam : Submodule ℂ C(C, ℂ)) : Set C(C, ℂ)) =
        (M : Set C(C, ℂ)) ∩ {f | T μ φ (T μ φ f) = lam • f} := by
      ext f; exact mem_eigenSub μ φ M lam f
    rw [this]
    exact hMc.inter (isClosed_eq ((T_continuous μ φ).comp (T_continuous μ φ))
      (continuous_const_smul _))
  have hsub : ((eigenSub μ φ M lam : Submodule ℂ C(C, ℂ)) : Set C(C, ℂ)) ∩ Metric.closedBall 0 1 ⊆
      closure {g | ∃ f, ‖J μ f‖ ≤ ‖lam‖⁻¹ * (‖J μ‖ * (‖J μ‖ * ‖φ‖) * ‖J μ‖) ∧ g = T μ φ f} := by
    rintro f ⟨hfE, hf⟩
    rw [mem_closedBall_zero_iff] at hf
    refine subset_closure ⟨lam⁻¹ • T μ φ f, ?_, ?_⟩
    · rw [map_smul, norm_smul, norm_inv]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      calc ‖J μ (T μ φ f)‖ ≤ ‖J μ‖ * ‖T μ φ f‖ := N_le μ _
        _ ≤ ‖J μ‖ * ((‖J μ‖ * ‖φ‖) * ‖J μ f‖) := by gcongr; exact norm_T_le μ φ f
        _ ≤ ‖J μ‖ * ((‖J μ‖ * ‖φ‖) * (‖J μ‖ * ‖f‖)) := by gcongr; exact N_le μ f
        _ ≤ ‖J μ‖ * ((‖J μ‖ * ‖φ‖) * (‖J μ‖ * 1)) := by gcongr
        _ = ‖J μ‖ * (‖J μ‖ * ‖φ‖) * ‖J μ‖ := by ring
    · have := ((mem_eigenSub μ φ M lam f).1 hfE).2
      rw [map_smul, this, smul_smul, inv_mul_cancel₀ hlam, one_smul]
  have hcpt : IsCompact (((eigenSub μ φ M lam : Submodule ℂ C(C, ℂ)) : Set C(C, ℂ)) ∩
      Metric.closedBall 0 1) :=
    (isCompact_closure_T μ φ _).of_isClosed_subset (hEc.inter Metric.isClosed_closedBall) hsub
  have hball : IsCompact (Metric.closedBall (0 : eigenSub μ φ M lam) 1) := by
    rw [Subtype.isCompact_iff]
    convert hcpt using 1
    ext f
    constructor
    · rintro ⟨g, hg, rfl⟩
      exact ⟨g.2, by rw [mem_closedBall_zero_iff] at hg ⊢; exact hg⟩
    · rintro ⟨hf, h⟩
      refine ⟨⟨f, hf⟩, ?_, rfl⟩
      rw [mem_closedBall_zero_iff] at h ⊢
      exact h
  exact FiniteDimensional.of_isCompact_closedBall₀ ℂ zero_lt_one hball

end LCA.PW

end PW2_sec

section PW3_sec

open MeasureTheory Topology Set Filter ComplexConjugate Module
open scoped InnerProductSpace

set_option linter.unusedSectionVars false

namespace LCA

universe u w

/-- A commuting family of endomorphisms of a nonzero finite-dimensional complex vector space has
a common eigenvector. -/
theorem common_eigen (n : ℕ) : ∀ (V : Type u) [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V],
    finrank ℂ V = n → Nontrivial V → ∀ {ι : Type w} (A : ι → Module.End ℂ V),
    (∀ i j, A i * A j = A j * A i) → ∃ v : V, v ≠ 0 ∧ ∀ i, ∃ c : ℂ, A i v = c • v := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro V _ _ _ hn hnt ι A hcomm
  by_cases hsc : ∀ i, ∃ c : ℂ, ∀ v, A i v = c • v
  · obtain ⟨v, hv⟩ := exists_ne (0 : V)
    exact ⟨v, hv, fun i => let ⟨c, hc⟩ := hsc i; ⟨c, hc v⟩⟩
  push Not at hsc
  obtain ⟨i₀, hi₀⟩ := hsc
  obtain ⟨c₀, hc₀⟩ := Module.End.exists_eigenvalue (A i₀)
  let W : Submodule ℂ V := Module.End.eigenspace (A i₀) c₀
  have hWne : W ≠ ⊥ := hc₀
  have hWtop : W ≠ ⊤ := by
    intro htop
    obtain ⟨v, hv⟩ := hi₀ c₀
    have : v ∈ W := by rw [htop]; trivial
    exact hv (Module.End.mem_eigenspace_iff.1 this)
  have hinv : ∀ j, ∀ v ∈ W, A j v ∈ W := by
    intro j v hv
    rw [Module.End.mem_eigenspace_iff] at hv ⊢
    have := congrArg (fun F => F v) (hcomm i₀ j)
    simp only [Module.End.mul_apply] at this
    rw [this, hv, map_smul]
  let A' : ι → Module.End ℂ W := fun j => (A j).restrict (hinv j)
  have hcomm' : ∀ i j, A' i * A' j = A' j * A' i := by
    intro i j
    ext v
    have := congrArg (fun F => F (v : V)) (hcomm i j)
    simpa [A', LinearMap.restrict_apply] using this
  have hlt : finrank ℂ W < n := hn ▸ Submodule.finrank_lt hWtop
  haveI : Nontrivial W := Submodule.nontrivial_iff_ne_bot.2 hWne
  obtain ⟨w, hw0, hw⟩ := ih _ hlt W rfl inferInstance A' hcomm'
  refine ⟨w, fun h => hw0 (Subtype.ext h), fun i => ?_⟩
  obtain ⟨c, hc⟩ := hw i
  exact ⟨c, congrArg Subtype.val hc⟩

namespace PW

variable {C : Type*} [CommGroup C] [TopologicalSpace C] [IsTopologicalGroup C] [T2Space C]
  [CompactSpace C] [MeasurableSpace C] [BorelSpace C] [SecondCountableTopology C]
  (μ : Measure C) [μ.IsHaarMeasure]

include μ in
/-- The core of Peter–Weyl: a continuous unitary character not trivial at `g₀`. -/
theorem exists_char_aux (g₀ : C) (hg₀ : g₀ ≠ 1) :
    ∃ χc : C → ℂ, Continuous χc ∧ (∀ g h, χc (g * h) = χc g * χc h) ∧ (∀ g, ‖χc g‖ = 1) ∧
      χc g₀ ≠ 1 := by
  -- a function separating `1` and `g₀`
  obtain ⟨f₀, hf₀1, hf₀g, -⟩ := exists_continuous_zero_one_of_isClosed (isClosed_singleton (x := (1 : C)))
    (isClosed_singleton (x := g₀)) (disjoint_singleton.2 (Ne.symm hg₀))
  let h₀ : C(C, ℂ) := ⟨fun x => ((f₀ x : ℝ) : ℂ), Complex.continuous_ofReal.comp f₀.continuous⟩
  let u : C(C, ℂ) := h₀ - rt g₀ h₀
  have hu1 : u 1 = -1 := by
    simp [u, h₀, hf₀1 (mem_singleton 1), hf₀g (mem_singleton g₀)]
  -- the kernel
  let O : Set C := {y | ‖u y - u 1‖ < 1 / 2}
  have hOo : IsOpen O := isOpen_lt (continuous_norm.comp (u.continuous.sub continuous_const))
    continuous_const
  let O' : Set C := O ∩ (fun y => y⁻¹) ⁻¹' O
  have hO'o : IsOpen O' := hOo.inter (hOo.preimage continuous_inv)
  have hO'1 : (1 : C) ∈ O' := ⟨by simp [O], by simp [O]⟩
  obtain ⟨φ₀, hφ₀0, hφ₀1, hφ₀r⟩ := exists_continuous_zero_one_of_isClosed hO'o.isClosed_compl
    (isClosed_singleton (x := (1 : C))) (disjoint_compl_left_iff_subset.2 (singleton_subset_iff.2 hO'1))
  let φ : C(C, ℝ) := ⟨fun x => φ₀ x + φ₀ x⁻¹, φ₀.continuous.add (φ₀.continuous.comp continuous_inv)⟩
  have hφ : ∀ x, φ x⁻¹ = φ x := fun x => by
    show φ₀ x⁻¹ + φ₀ x⁻¹⁻¹ = φ₀ x + φ₀ x⁻¹
    rw [inv_inv, add_comm]
  have hφnn : ∀ x, 0 ≤ φ x := fun x => add_nonneg (hφ₀r x).1 (hφ₀r x⁻¹).1
  have hφO : ∀ x, x ∉ O → φ x = 0 := by
    intro x hx
    have h1 : x ∉ O' := fun h => hx h.1
    have h2 : x⁻¹ ∉ O' := fun h => hx (by simpa using h.2)
    show φ₀ x + φ₀ x⁻¹ = 0
    rw [hφ₀0 h1, hφ₀0 h2]; simp
  have hφ1 : φ 1 ≠ 0 := by
    show φ₀ 1 + φ₀ 1⁻¹ ≠ 0
    rw [inv_one, hφ₀1 (mem_singleton 1)]; norm_num
  -- `T u 1 ≠ 0`
  have hI : 0 < ∫ y, φ y ∂μ :=
    φ.continuous.integral_pos_of_hasCompactSupport_nonneg_nonzero
      (isCompact_univ.of_isClosed_subset (isClosed_tsupport _) (subset_univ _)) hφnn hφ1
  have hTu : T μ φ u ≠ 0 := by
    intro h0
    have hT1 : T μ φ u 1 = ∫ y, u y * ((φ y : ℝ) : ℂ) ∂μ := by
      rw [T_apply]
      congr 1; ext y
      rw [one_mul, hφ]
    have hint1 : Integrable (fun y => u y * ((φ y : ℝ) : ℂ)) μ :=
      integrable_of_continuous μ (u.continuous.mul (Complex.continuous_ofReal.comp φ.continuous))
    have hint2 : Integrable (fun y => u 1 * ((φ y : ℝ) : ℂ)) μ :=
      integrable_of_continuous μ (continuous_const.mul (Complex.continuous_ofReal.comp φ.continuous))
    have hdiff : T μ φ u 1 - u 1 * ((∫ y, φ y ∂μ : ℝ) : ℂ) =
        ∫ y, (u y - u 1) * ((φ y : ℝ) : ℂ) ∂μ := by
      rw [hT1, integral_complex_ofReal.symm, ← integral_const_mul, ← integral_sub hint1 hint2]
      congr 1; ext y; ring
    have hbound : ‖∫ y, (u y - u 1) * ((φ y : ℝ) : ℂ) ∂μ‖ ≤ ∫ y, (1 / 2) * φ y ∂μ := by
      refine norm_integral_le_of_norm_le ((integrable_of_continuous μ
        (Complex.continuous_ofReal.comp φ.continuous)).norm.const_mul (1 / 2) |>.congr ?_) ?_
      · exact Eventually.of_forall fun y => by simp [abs_of_nonneg (hφnn y)]
      · refine Eventually.of_forall fun y => ?_
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hφnn y)]
        by_cases hy : y ∈ O
        · exact mul_le_mul_of_nonneg_right (le_of_lt hy) (hφnn y)
        · rw [hφO y hy]; simp
    rw [h0, ContinuousMap.zero_apply, zero_sub] at hdiff
    have hn : ‖∫ y, (u y - u 1) * ((φ y : ℝ) : ℂ) ∂μ‖ = ∫ y, φ y ∂μ := by
      rw [← hdiff, norm_neg, hu1, norm_mul, norm_neg, norm_one, one_mul, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hI]
    rw [integral_const_mul, hn] at hbound
    linarith
  -- the closed invariant subspace `M`
  let M : Submodule ℂ C(C, ℂ) :=
    { carrier := {f | ∀ w : C(C, ℂ), rt g₀ w = w → ⟪J μ w, J μ f⟫_ℂ = 0}
      add_mem' := fun ha hb w hw => by rw [map_add, inner_add_right, ha w hw, hb w hw, add_zero]
      zero_mem' := fun w _ => by rw [map_zero, inner_zero_right]
      smul_mem' := fun c f hf w hw => by
        show ⟪J μ w, J μ (c • f)⟫_ℂ = 0
        rw [map_smul, inner_smul_right, hf w hw, mul_zero] }
  have hMc : IsClosed (M : Set C(C, ℂ)) := by
    have : (M : Set C(C, ℂ)) = ⋂ w ∈ {w : C(C, ℂ) | rt g₀ w = w},
        {f | ⟪J μ w, J μ f⟫_ℂ = 0} := by
      ext f; simp only [mem_iInter]; rfl
    rw [this]
    exact isClosed_biInter fun w _ => isClosed_eq
      (continuous_const.inner (J μ).continuous) continuous_const
  have hMT : ∀ f ∈ M, T μ φ f ∈ M := by
    intro f hf w hw
    rw [← T_symm μ φ hφ]
    exact hf _ (by rw [← T_comm, hw])
  have hMrt : ∀ g, ∀ f ∈ M, rt g f ∈ M := by
    intro g f hf w hw
    have hw' : rt g (rt g⁻¹ w) = w := by rw [rt_rt, inv_mul_cancel, rt_one]
    rw [← hw', ip_rt]
    exact hf _ (by rw [rt_comm, hw])
  have huM : u ∈ M := by
    intro w hw
    show ⟪J μ w, J μ (h₀ - rt g₀ h₀)⟫_ℂ = 0
    rw [map_sub, inner_sub_right]
    conv_lhs => arg 2; rw [← hw, ip_rt]
    exact sub_self _
  obtain ⟨c, hc0, h, hhM, hh0, hTh⟩ := exists_eigen μ φ hφ M hMc hMT huM hTu
  set lam : ℂ := ((c ^ 2 : ℝ) : ℂ)
  have hlam : lam ≠ 0 := by
    simp only [lam, ne_eq, Complex.ofReal_eq_zero]; positivity
  let E := eigenSub μ φ M lam
  haveI : FiniteDimensional ℂ E := eigenSub_finiteDimensional μ φ M hMc lam hlam
  have hhE : h ∈ E := (mem_eigenSub μ φ M lam h).2 ⟨hhM, hTh⟩
  haveI : Nontrivial E := ⟨⟨⟨h, hhE⟩, 0, fun e => hh0 (congrArg Subtype.val e)⟩⟩
  have hEinv : ∀ g, ∀ f ∈ E, rt g f ∈ E := by
    intro g f hf
    obtain ⟨hfM, hfT⟩ := (mem_eigenSub μ φ M lam f).1 hf
    refine (mem_eigenSub μ φ M lam _).2 ⟨hMrt g f hfM, ?_⟩
    rw [T_comm, T_comm, hfT, map_smul]
  let A : C → Module.End ℂ E := fun g => (rt g).restrict (hEinv g)
  have hAcomm : ∀ g h, A g * A h = A h * A g := by
    intro g h'
    ext v
    simp [A, LinearMap.restrict_apply, rt_comm]
  obtain ⟨v, hv0, hv⟩ := common_eigen (finrank ℂ E) E rfl inferInstance A hAcomm
  choose χc hχc using hv
  set v' : C(C, ℂ) := (v : C(C, ℂ))
  have hv'0 : v' ≠ 0 := fun h => hv0 (Subtype.ext h)
  have hv'M : v' ∈ M := ((mem_eigenSub μ φ M lam v').1 v.2).1
  have hrt : ∀ g, rt g v' = χc g • v' := fun g => congrArg Subtype.val (hχc g)
  have hval : ∀ g x, v' (x * g) = χc g * v' x := fun g x => by
    have := congrArg (fun F : C(C, ℂ) => F x) (hrt g)
    simpa using this
  obtain ⟨x₀, hx₀⟩ : ∃ x₀, v' x₀ ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact hv'0 (ContinuousMap.ext hcon)
  have hχeq : ∀ g, χc g = v' (x₀ * g) / v' x₀ := fun g => by
    rw [hval g x₀, mul_div_assoc, div_self hx₀, mul_one]
  refine ⟨χc, ?_, ?_, ?_, ?_⟩
  · have : χc = fun g => v' (x₀ * g) / v' x₀ := funext hχeq
    rw [this]
    exact (v'.continuous.comp (continuous_const.mul continuous_id)).div_const _
  · intro g h'
    have e1 := hval (g * h') x₀
    have e2 : v' (x₀ * (g * h')) = χc h' * (χc g * v' x₀) := by
      rw [← mul_assoc, hval h', hval g]
    rw [e2] at e1
    have h3 : χc g * χc h' * v' x₀ = χc (g * h') * v' x₀ := by rw [← e1]; ring
    exact (mul_right_cancel₀ hx₀ h3).symm
  · intro g
    have h1 := norm_rt g v'
    rw [hrt g, norm_smul] at h1
    have hv'pos : 0 < ‖v'‖ := norm_pos_iff.2 hv'0
    nlinarith
  · intro h1
    have hinvar : rt g₀ v' = v' := by rw [hrt, h1, one_smul]
    have := hv'M v' hinvar
    rw [inner_self_eq_zero] at this
    exact hv'0 (J_inj μ (by rw [this, map_zero]))

end PW

/-- **Peter–Weyl for compact abelian groups**: continuous characters separate points. -/
theorem peterWeyl {C : Type*} [CommGroup C] [TopologicalSpace C] [IsTopologicalGroup C] [T2Space C]
    [CompactSpace C] [SecondCountableTopology C] (g₀ : C) (hg₀ : g₀ ≠ 1) :
    ∃ χ : C →* Multiplicative UnitAddCircle, Continuous χ ∧ χ g₀ ≠ 1 := by
  borelize C
  obtain ⟨χc, hχcont, hχmul, hχnorm, hχg₀⟩ := PW.exists_char_aux (Measure.haar : Measure C) g₀ hg₀
  let e := AddCircle.homeomorphCircle (T := (1 : ℝ)) one_ne_zero
  have he : ∀ t, e t = AddCircle.toCircle t := fun t => AddCircle.homeomorphCircle_apply _ t
  let circ : C → Circle := fun g => ⟨χc g, mem_sphere_zero_iff_norm.2 (hχnorm g)⟩
  have hcirc : Continuous circ := hχcont.subtype_mk _
  have hadd : ∀ a b : Circle, e.symm (a * b) = e.symm a + e.symm b := by
    intro a b
    apply e.injective
    rw [he (e.symm a + e.symm b), AddCircle.toCircle_add, ← he, ← he, e.apply_symm_apply,
      e.apply_symm_apply, e.apply_symm_apply]
  have hcirc_mul : ∀ g h, circ (g * h) = circ g * circ h := fun g h => Circle.ext (hχmul g h)
  have hcirc_one : circ 1 = 1 := by
    have h1 := hχmul 1 1
    rw [one_mul] at h1
    have hne : χc 1 ≠ 0 := by
      intro h0; have := hχnorm 1; rw [h0, norm_zero] at this; exact zero_ne_one this
    apply Circle.ext
    show χc 1 = 1
    have := mul_left_cancel₀ hne (h1.symm.trans (mul_one _).symm)
    exact this
  let χ : C →* Multiplicative UnitAddCircle :=
    { toFun := fun g => Multiplicative.ofAdd (e.symm (circ g))
      map_one' := by
        rw [hcirc_one]
        show Multiplicative.ofAdd (e.symm 1) = Multiplicative.ofAdd 0
        congr 1
        apply e.injective
        rw [e.apply_symm_apply, he]
        simpa using (AddCircle.toCircle_nsmul (0 : UnitAddCircle) 0).symm
      map_mul' := fun g h => by
        rw [hcirc_mul, hadd]; rfl }
  refine ⟨χ, ?_, ?_⟩
  · exact continuous_ofAdd.comp (e.symm.continuous.comp hcirc)
  · intro h1
    have h2 : e.symm (circ g₀) = 0 := congrArg Multiplicative.toAdd h1
    have h3 : circ g₀ = 1 := by
      have := congrArg e h2
      rw [e.apply_symm_apply, he] at this
      rw [this]
      simpa using (AddCircle.toCircle_nsmul (0 : UnitAddCircle) 0)
    exact hχg₀ (congrArg Subtype.val h3)

/-- Finitely many characters with small common kernel. -/
theorem exists_chars_small {C : Type*} [CommGroup C] [TopologicalSpace C] [IsTopologicalGroup C]
    [T2Space C] [CompactSpace C] [SecondCountableTopology C] (W : Set C) (hW : W ∈ 𝓝 (1 : C)) :
    ∃ (p : ℕ) (χ : C →* Multiplicative (Fin p → UnitAddCircle)), Continuous χ ∧
      ∀ x, χ x = 1 → x ∈ W := by
  classical
  let K : Set C := (interior W)ᶜ
  have hKc : IsCompact K := isOpen_interior.isClosed_compl.isCompact
  have hK1 : ∀ x ∈ K, x ≠ 1 := fun x hx h => hx (h ▸ mem_interior_iff_mem_nhds.2 hW)
  choose χs hχc hχne using fun x : K => peterWeyl (x : C) (hK1 x x.2)
  obtain ⟨t, ht⟩ := hKc.elim_finite_subcover (fun x : K => {y | χs x y ≠ 1})
    (fun x => (isOpen_ne_fun (hχc x) continuous_const))
    (fun x hx => mem_iUnion.2 ⟨⟨x, hx⟩, hχne _⟩)
  let e := t.equivFin
  let χ : C →* Multiplicative (Fin t.card → UnitAddCircle) :=
    { toFun := fun y => Multiplicative.ofAdd (fun j => Multiplicative.toAdd (χs (e.symm j) y))
      map_one' := by ext j; simp
      map_mul' := fun a b => by ext j; simp }
  refine ⟨t.card, χ, ?_, ?_⟩
  · refine continuous_ofAdd.comp (continuous_pi fun j => ?_)
    exact continuous_toAdd.comp (hχc _)
  · intro x hx
    by_contra hxW
    have hxK : x ∈ K := fun h => hxW (interior_subset h)
    obtain ⟨i, hi, hxi⟩ := mem_iUnion₂.1 (ht hxK)
    apply hxi
    have := congrFun (congrArg Multiplicative.toAdd hx) (e ⟨i, hi⟩)
    simp only [χ, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_ofAdd, Equiv.symm_apply_apply] at this
    exact congrArg Multiplicative.ofAdd this

end LCA

end PW3_sec

section Lift_sec

open Set Filter Topology

namespace LCA

variable {X Y : Type*} [CommGroup X] [TopologicalSpace X] [IsTopologicalGroup X]
  [CommGroup Y] [TopologicalSpace Y] [IsTopologicalGroup Y]

lemma hom_pow (γ : ℝ → Y) (hγ : ∀ s t, γ (s + t) = γ s * γ t) (k : ℕ) (t : ℝ) :
    γ (k * t) = γ t ^ k := by
  induction k with
  | zero =>
    have h := hγ 0 0
    simp only [add_zero] at h
    have : γ 0 = 1 := by
      have := congrArg (fun z => z * (γ 0)⁻¹) h
      simpa using this.symm
    simpa using this
  | succ k ih =>
    rw [Nat.cast_succ, add_mul, one_mul, hγ, ih, pow_succ]

/-- **Lifting one-parameter subgroups** through a continuous homomorphism which is a local
homeomorphism onto its range near `1`. -/
theorem lift_one_param (χ : X →* Y) (hχc : Continuous χ)
    (hloc : ∃ N ∈ 𝓝 (1 : X), ∀ x ∈ N, ∀ y ∈ N, χ x = χ y → x = y)
    (hopen : ∀ N ∈ 𝓝 (1 : X), ∃ V ∈ 𝓝 (1 : Y), ∀ y ∈ V, y ∈ χ.range → ∃ x ∈ N, χ x = y)
    (γ : ℝ → Y) (hγ : ∀ s t, γ (s + t) = γ s * γ t) (hγc : Continuous γ)
    (hγr : ∀ t, γ t ∈ χ.range) :
    ∃ G : ℝ → X, Continuous G ∧ (∀ s t, G (s + t) = G s * G t) ∧ ∀ t, χ (G t) = γ t := by
  classical
  obtain ⟨N₀, hN₀, hinj⟩ := hloc
  obtain ⟨N₁, hN₁, hN₁N₀⟩ := exists_nhds_one_split hN₀
  have h1N₁ : (1 : X) ∈ N₁ := mem_of_mem_nhds hN₁
  have hN₁sub : ∀ x ∈ N₁, x ∈ N₀ := fun x hx => by simpa using hN₁N₀ x hx 1 h1N₁
  obtain ⟨V₁, hV₁, hV₁r⟩ := hopen N₁ hN₁
  have hγ0 : γ 0 = 1 := by simpa using hom_pow γ hγ 0 0
  have hγcont0 : γ ⁻¹' V₁ ∈ 𝓝 (0 : ℝ) := hγc.continuousAt.preimage_mem_nhds (by rwa [hγ0])
  obtain ⟨δ, hδ, hδV⟩ := Metric.mem_nhds_iff.1 hγcont0
  have hex : ∀ t : ℝ, |t| < δ → ∃ x ∈ N₁, χ x = γ t := fun t ht =>
    hV₁r _ (hδV (by simpa [Metric.mem_ball, Real.dist_eq] using ht)) (hγr t)
  let ℓ : ℝ → X := fun t => if h : |t| < δ then (hex t h).choose else 1
  have hℓ : ∀ t, |t| < δ → ℓ t ∈ N₁ ∧ χ (ℓ t) = γ t := fun t ht => by
    simp only [ℓ, dif_pos ht]
    exact (hex t ht).choose_spec
  have huniq : ∀ t, |t| < δ → ∀ x ∈ N₀, χ x = γ t → x = ℓ t := fun t ht x hx hχx =>
    hinj x hx (ℓ t) (hN₁sub _ (hℓ t ht).1) (by rw [hχx, (hℓ t ht).2])
  have hlhom : ∀ s t, |s| < δ → |t| < δ → |s + t| < δ → ℓ (s + t) = ℓ s * ℓ t := by
    intro s t hs ht hst
    refine (huniq (s + t) hst _ (hN₁N₀ _ (hℓ s hs).1 _ (hℓ t ht).1) ?_).symm
    rw [map_mul, (hℓ s hs).2, (hℓ t ht).2, hγ]
  have hℓ0 : ℓ 0 = 1 := (huniq 0 (by simpa using hδ) 1 (mem_of_mem_nhds hN₀)
    (by rw [map_one, hγ0])).symm
  have hlpow : ∀ (k : ℕ) (t : ℝ), |t| * k < δ → ℓ (k * t) = ℓ t ^ k := by
    intro k t
    induction k with
    | zero => intro _; simpa using hℓ0
    | succ k ih =>
      intro hk
      have hk2 : |t| * ((k : ℝ) + 1) < δ := by push_cast at hk; exact hk
      have hk' : |t| * k < δ := by nlinarith [abs_nonneg t]
      have ht : |t| < δ := by nlinarith [abs_nonneg t, (k.cast_nonneg : (0 : ℝ) ≤ k)]
      have e : ((k + 1 : ℕ) : ℝ) * t = k * t + t := by push_cast; ring
      have h1 : |(k : ℝ) * t| < δ := by rw [abs_mul, Nat.abs_cast, mul_comm]; exact hk'
      have h2 : |(k : ℝ) * t + t| < δ := by
        rw [← e, abs_mul, Nat.abs_cast, mul_comm]; exact hk
      rw [e, hlhom _ _ h1 ht h2, ih hk', pow_succ]
  set δ₂ := δ / 2 with hδ₂
  have hδ₂pos : 0 < δ₂ := by positivity
  -- independence of the subdivision
  have hindep : ∀ (t : ℝ) (k₁ k₂ : ℕ), 0 < k₁ → 0 < k₂ → |t| < k₁ * δ₂ → |t| < k₂ * δ₂ →
      ℓ (t / k₁) ^ k₁ = ℓ (t / k₂) ^ k₂ := by
    intro t k₁ k₂ hk₁ hk₂ h₁ h₂
    have hk₁' : (0 : ℝ) < k₁ := by exact_mod_cast hk₁
    have hk₂' : (0 : ℝ) < k₂ := by exact_mod_cast hk₂
    have e₁ : ℓ (t / k₁) = ℓ (t / (k₁ * k₂)) ^ k₂ := by
      rw [← hlpow k₂ _ ?_]
      · congr 1; field_simp
      · rw [abs_div, abs_of_pos (mul_pos hk₁' hk₂'),
          show |t| / ((k₁ : ℝ) * k₂) * k₂ = |t| / k₁ by field_simp, div_lt_iff₀ hk₁']
        nlinarith
    have e₂ : ℓ (t / k₂) = ℓ (t / (k₁ * k₂)) ^ k₁ := by
      rw [← hlpow k₁ _ ?_]
      · congr 1; field_simp
      · rw [abs_div, abs_of_pos (mul_pos hk₁' hk₂'),
          show |t| / ((k₁ : ℝ) * k₂) * k₁ = |t| / k₂ by field_simp, div_lt_iff₀ hk₂']
        nlinarith
    rw [e₁, e₂, ← pow_mul, ← pow_mul]
    congr 1 <;> ring_nf
  let kk : ℝ → ℕ := fun t => ⌈|t| / δ₂⌉₊ + 1
  have hkk : ∀ t, |t| < kk t * δ₂ := by
    intro t
    have := Nat.le_ceil (|t| / δ₂)
    rw [div_le_iff₀ hδ₂pos] at this
    push_cast [kk]
    nlinarith
  let G : ℝ → X := fun t => ℓ (t / kk t) ^ kk t
  have hG : ∀ (t : ℝ) (k : ℕ), 0 < k → |t| < k * δ₂ → G t = ℓ (t / k) ^ k := fun t k hk h =>
    hindep t _ _ (Nat.succ_pos _) hk (hkk t) h
  -- continuity of `ℓ` at `0` and on the small ball
  have hℓc0 : Tendsto ℓ (𝓝 0) (𝓝 1) := by
    intro N hN
    show ℓ ⁻¹' N ∈ 𝓝 (0 : ℝ)
    obtain ⟨V, hV, hVr⟩ := hopen (N ∩ N₀) (inter_mem hN hN₀)
    have h1 : γ ⁻¹' V ∈ 𝓝 (0 : ℝ) := hγc.continuousAt.preimage_mem_nhds (by rwa [hγ0])
    have h2 : Metric.ball (0 : ℝ) δ ∈ 𝓝 (0 : ℝ) := Metric.ball_mem_nhds _ hδ
    filter_upwards [h1, h2] with u hu hub
    have hu' : |u| < δ := by simpa [Metric.mem_ball, Real.dist_eq] using hub
    obtain ⟨x, ⟨hxN, hxN₀⟩, hx⟩ := hVr _ hu (hγr u)
    show ℓ u ∈ N
    rw [← huniq u hu' x hxN₀ hx]
    exact hxN
  have hℓc : ∀ u₀, |u₀| < δ₂ → ContinuousAt ℓ u₀ := by
    intro u₀ hu₀
    have hev : ∀ᶠ u in 𝓝 u₀, ℓ u = ℓ u₀ * ℓ (u - u₀) := by
      have : Metric.ball u₀ δ₂ ∈ 𝓝 u₀ := Metric.ball_mem_nhds _ hδ₂pos
      filter_upwards [this] with u hu
      have hu' : |u - u₀| < δ₂ := by simpa [Metric.mem_ball, Real.dist_eq] using hu
      have := hlhom u₀ (u - u₀) (by linarith) (by linarith) (by
        rw [add_sub_cancel]
        calc |u| = |u₀ + (u - u₀)| := by ring_nf
          _ ≤ |u₀| + |u - u₀| := abs_add_le _ _
          _ < δ := by linarith)
      rw [add_sub_cancel] at this
      exact this
    have ht : Tendsto (fun u => ℓ u₀ * ℓ (u - u₀)) (𝓝 u₀) (𝓝 (ℓ u₀ * 1)) := by
      refine tendsto_const_nhds.mul (hℓc0.comp ?_)
      have : Tendsto (fun u : ℝ => u - u₀) (𝓝 u₀) (𝓝 (u₀ - u₀)) :=
        (continuous_id.sub continuous_const).tendsto u₀
      simpa using this
    rw [mul_one] at ht
    exact ht.congr' (hev.mono fun u hu => hu.symm)
  refine ⟨G, ?_, ?_, ?_⟩
  · rw [continuous_iff_continuousAt]
    intro t₀
    let k : ℕ := ⌈(|t₀| + 1) / δ₂⌉₊ + 1
    have hk : |t₀| + 1 < k * δ₂ := by
      have := Nat.le_ceil ((|t₀| + 1) / δ₂)
      rw [div_le_iff₀ hδ₂pos] at this
      push_cast [k]
      nlinarith
    have hkpos : (0 : ℝ) < k := by positivity
    have hev : ∀ᶠ t in 𝓝 t₀, G t = ℓ (t / k) ^ k := by
      have : Metric.ball t₀ 1 ∈ 𝓝 t₀ := Metric.ball_mem_nhds _ one_pos
      filter_upwards [this] with t ht
      refine hG t k (Nat.succ_pos _) ?_
      have : |t - t₀| < 1 := by simpa [Metric.mem_ball, Real.dist_eq] using ht
      calc |t| = |t₀ + (t - t₀)| := by ring_nf
        _ ≤ |t₀| + |t - t₀| := abs_add_le _ _
        _ < k * δ₂ := by linarith
    have hc : ContinuousAt (fun t => ℓ (t / k) ^ k) t₀ := by
      have h1 : ContinuousAt ℓ (t₀ / k) := hℓc _ (by
        rw [abs_div, abs_of_pos hkpos, div_lt_iff₀ hkpos]
        linarith)
      exact (ContinuousAt.comp (f := fun t : ℝ => t / k) h1
        ((continuous_id.div_const (k : ℝ)).continuousAt)).pow _
    exact hc.congr (hev.mono fun t ht => ht.symm)
  · intro s t
    let k : ℕ := ⌈(|s| + |t|) / δ₂⌉₊ + 1
    have hk : |s| + |t| < k * δ₂ := by
      have := Nat.le_ceil ((|s| + |t|) / δ₂)
      rw [div_le_iff₀ hδ₂pos] at this
      push_cast [k]
      nlinarith
    have hkpos : (0 : ℝ) < k := by positivity
    have hs : |s| < k * δ₂ := by linarith [abs_nonneg t]
    have ht : |t| < k * δ₂ := by linarith [abs_nonneg s]
    have hst : |s + t| < k * δ₂ := lt_of_le_of_lt (abs_add_le _ _) hk
    rw [hG _ k (Nat.succ_pos _) hst, hG _ k (Nat.succ_pos _) hs, hG _ k (Nat.succ_pos _) ht,
      ← mul_pow, add_div]
    have hsk : |s / k| < δ := by
      rw [abs_div, abs_of_pos hkpos, div_lt_iff₀ hkpos]; nlinarith [abs_nonneg s, abs_nonneg t]
    have htk : |t / k| < δ := by
      rw [abs_div, abs_of_pos hkpos, div_lt_iff₀ hkpos]; nlinarith [abs_nonneg s, abs_nonneg t]
    have hstk : |s / k + t / k| < δ := by
      rw [← add_div, abs_div, abs_of_pos hkpos, div_lt_iff₀ hkpos]
      nlinarith [abs_nonneg s, abs_nonneg t, abs_add_le s t]
    rw [hlhom _ _ hsk htk hstk]
  · intro t
    have hkpos : (0 : ℝ) < kk t := by positivity
    have htk : |t / kk t| < δ := by
      rw [abs_div, abs_of_pos hkpos, div_lt_iff₀ hkpos]; nlinarith [hkk t]
    show χ (ℓ (t / kk t) ^ kk t) = γ t
    rw [map_pow, (hℓ _ htk).2, ← hom_pow γ hγ, mul_div_cancel₀ _ hkpos.ne']

end LCA

end Lift_sec

section Main_sec

open Set Filter Topology

namespace LCA

lemma isOpenMap_ofAdd' {E : Type*} [TopologicalSpace E] :
    IsOpenMap (Multiplicative.ofAdd : E → Multiplicative E) := fun U hU => by
  rw [Equiv.image_eq_preimage_symm]
  exact hU.preimage continuous_toAdd

lemma isOpenMap_toAdd' {E : Type*} [TopologicalSpace E] :
    IsOpenMap (Multiplicative.toAdd : Multiplicative E → E) := fun U hU => by
  rw [Equiv.image_eq_preimage_symm]
  exact hU.preimage continuous_ofAdd

theorem structure_main (H : Type*) [CommGroup H] [TopologicalSpace H] [IsTopologicalGroup H]
    [T2Space H] [LocallyCompactSpace H] [SecondCountableTopology H]
    (hcg : ∃ C : Set H, IsCompact C ∧ Subgroup.closure C = ⊤)
    (U : Set H) (hU : U ∈ 𝓝 (1 : H)) :
    ∃ K : Subgroup H, IsCompact (K : Set H) ∧ (K : Set H) ⊆ U ∧
      ∃ (m n r s : ℕ) (d : Fin s → ℕ) (π : H →* Multiplicative (ElemG m n r s d)),
        (∀ i, d i ≠ 0) ∧ Continuous π ∧ IsOpenMap π ∧ Function.Surjective π ∧
          ∀ x, π x = 1 ↔ x ∈ K := by
  classical
  -- Step 1: the lattice
  obtain ⟨j, T, V', hV'c, ⟨WZ, hWZ, hWZZ⟩, hcov⟩ := exists_lattice H hcg
  set Z := Subgroup.closure (range T) with hZdef
  have hZd : IsDiscreteSub Z := ⟨WZ, hWZ, hWZZ⟩
  haveI hZcl : IsClosed (Z : Set H) := hZd.isClosed
  -- Step 2: the compact symmetric set `Q`
  obtain ⟨V₁, hV₁, hV₁W⟩ := exists_nhds_one_split hWZ
  obtain ⟨V₂, hV₂, hV₂V₁⟩ := exists_nhds_one_split hV₁
  obtain ⟨Kc, hKcc, hKc⟩ := exists_compact_mem_nhds (1 : H)
  have hS : V₁ ∩ V₂ ∩ U ∩ Kc ∈ 𝓝 (1 : H) :=
    inter_mem (inter_mem (inter_mem hV₁ hV₂) hU) hKc
  obtain ⟨Q₀, hQ₀, hQ₀cl, hQ₀S⟩ := exists_mem_nhds_isClosed_subset hS
  let Q : Set H := Q₀ ∩ Q₀⁻¹
  have hQ : Q ∈ 𝓝 (1 : H) := inter_mem hQ₀ (inv_mem_nhds_one H hQ₀)
  have hQcl : IsClosed Q := hQ₀cl.inter hQ₀cl.inv
  have hQS : Q ⊆ V₁ ∩ V₂ ∩ U ∩ Kc := fun x hx => hQ₀S hx.1
  have hQc : IsCompact Q := hKcc.of_isClosed_subset hQcl fun x hx => (hQS hx).2
  have hQU : Q ⊆ U := fun x hx => (hQS hx).1.2
  have hQinv : ∀ a ∈ Q, a⁻¹ ∈ Q := fun a ha => ⟨ha.2, by simpa using ha.1⟩
  have hQ1 : (1 : H) ∈ Q := mem_of_mem_nhds hQ
  have hQ3 : ∀ a ∈ Q, ∀ b ∈ Q, ∀ c ∈ Q, a * b * c ∈ WZ := fun a ha b hb c hc =>
    hV₁W _ (hV₂V₁ _ (hQS ha).1.1.2 _ (hQS hb).1.1.2) _ (hQS hc).1.1.1
  let O : Set H := interior Q
  have hOo : IsOpen O := isOpen_interior
  have hO1 : (1 : H) ∈ O := mem_interior_iff_mem_nhds.2 hQ
  have hOQ : O ⊆ Q := interior_subset
  -- Step 3: characters of the compact group `H ⧸ Z`
  haveI : CompactSpace (H ⧸ Z) := by
    refine ⟨?_⟩
    have : (QuotientGroup.mk '' V' : Set (H ⧸ Z)) = univ := by
      refine eq_univ_of_forall fun y => ?_
      obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
      obtain ⟨z, hz, v, hv, rfl⟩ := hcov g
      refine ⟨v, hv, ?_⟩
      rw [QuotientGroup.eq]
      simpa using Z.inv_mem hz
    rw [← this]
    exact hV'c.image QuotientGroup.continuous_mk
  have hOq : (QuotientGroup.mk '' O : Set (H ⧸ Z)) ∈ 𝓝 (1 : H ⧸ Z) :=
    (QuotientGroup.isOpenMap_coe O hOo).mem_nhds ⟨1, hO1, rfl⟩
  obtain ⟨p, χb, hχbc, hχbs⟩ := exists_chars_small _ hOq
  let χH : H →* Multiplicative (Fin p → UnitAddCircle) := χb.comp (QuotientGroup.mk' Z)
  have hχHc : Continuous χH := hχbc.comp QuotientGroup.continuous_mk
  have hZker : ∀ z ∈ Z, χH z = 1 := fun z hz => by
    show χb (z : H ⧸ Z) = 1
    rw [(QuotientGroup.eq_one_iff z).2 hz, map_one]
  have hker : ∀ h, χH h = 1 → ∃ z ∈ Z, ∃ o ∈ O, h = z * o := by
    intro h hh
    obtain ⟨o, ho, hoh⟩ := hχbs _ hh
    have : o⁻¹ * h ∈ Z := QuotientGroup.eq.1 hoh
    exact ⟨o⁻¹ * h, this, o, ho, by rw [mul_comm, mul_inv_cancel_left]⟩
  have hkerQQ : ∀ a ∈ Q, ∀ b ∈ Q, χH (a * b) = 1 → a * b ∈ O := by
    intro a ha b hb hab
    obtain ⟨z, hz, o, ho, he⟩ := hker _ hab
    have hz' : z = a * b * o⁻¹ := by rw [he, mul_inv_cancel_right]
    have hz1 : z = 1 := hWZZ z hz (by rw [hz']; exact hQ3 a ha b hb _ (hQinv _ (hOQ ho)))
    rw [he, hz1, one_mul]
    exact ho
  -- Step 4: the compact subgroup `K`
  let K : Subgroup H :=
    { carrier := {h | χH h = 1 ∧ h ∈ Q}
      mul_mem' := fun {a b} ha hb => ⟨by rw [map_mul, ha.1, hb.1, one_mul],
        hOQ (hkerQQ a ha.2 b hb.2 (by rw [map_mul, ha.1, hb.1, one_mul]))⟩
      one_mem' := ⟨map_one _, hQ1⟩
      inv_mem' := fun {a} ha => ⟨by rw [map_inv, ha.1, inv_one], hQinv a ha.2⟩ }
  have hKmem : ∀ h, h ∈ K ↔ χH h = 1 ∧ h ∈ Q := fun h => Iff.rfl
  have hKcl : IsClosed (K : Set H) :=
    (isClosed_eq hχHc continuous_const).inter hQcl
  have hKc : IsCompact (K : Set H) := hQc.of_isClosed_subset hKcl fun h hh => hh.2
  have hKU : (K : Set H) ⊆ U := fun h hh => hQU hh.2
  have hkerK : ∀ h, χH h = 1 → ∃ z ∈ Z, ∃ k ∈ K, h = z * k := by
    intro h hh
    obtain ⟨z, hz, o, ho, rfl⟩ := hker h hh
    refine ⟨z, hz, o, ⟨?_, hOQ ho⟩, rfl⟩
    rw [map_mul, hZker z hz, one_mul] at hh
    exact hh
  refine ⟨K, hKc, hKU, ?_⟩
  -- Step 5: the quotient `X = H ⧸ K`
  haveI : IsClosed (K : Set H) := hKcl
  let χX : H ⧸ K →* Multiplicative (Fin p → UnitAddCircle) :=
    QuotientGroup.lift K χH (fun k hk => (MonoidHom.mem_ker).2 hk.1)
  have hχX : ∀ h : H, χX (h : H ⧸ K) = χH h := fun h => QuotientGroup.lift_mk _ _ _
  have hχXc : Continuous χX := by
    rw [(QuotientGroup.isQuotientMap_mk K).continuous_iff]
    exact hχHc
  -- local injectivity
  have hloc : ∃ N ∈ 𝓝 (1 : H ⧸ K), ∀ x ∈ N, ∀ y ∈ N, χX x = χX y → x = y := by
    refine ⟨QuotientGroup.mk '' O, (QuotientGroup.isOpenMap_coe O hOo).mem_nhds ⟨1, hO1, rfl⟩, ?_⟩
    rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ hab
    rw [hχX, hχX] at hab
    have h1 : χH (a * b⁻¹) = 1 := by rw [map_mul, map_inv, hab, mul_inv_cancel]
    have h2 : a * b⁻¹ ∈ K := ⟨h1, hOQ (hkerQQ a (hOQ ha) b⁻¹ (hQinv _ (hOQ hb)) h1)⟩
    rw [QuotientGroup.eq]
    have := K.inv_mem h2
    rwa [mul_inv_rev, inv_inv, mul_comm] at this
  -- the range of `χX` is compact
  have hrange : (χX.range : Set (Multiplicative (Fin p → UnitAddCircle))) = χH '' V' := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective x
      obtain ⟨z, hz, v, hv, rfl⟩ := hcov h
      refine ⟨v, hv, ?_⟩
      rw [hχX, map_mul, hZker z hz, one_mul]
    · rintro ⟨v, -, rfl⟩
      exact ⟨v, hχX v⟩
  have hrc : IsCompact (χX.range : Set (Multiplicative (Fin p → UnitAddCircle))) := by
    rw [hrange]; exact hV'c.image hχHc
  haveI : CompactSpace χX.range := isCompact_iff_compactSpace.1 hrc
  have hopen : ∀ N ∈ 𝓝 (1 : H ⧸ K), ∃ V ∈ 𝓝 (1 : Multiplicative (Fin p → UnitAddCircle)),
      ∀ y ∈ V, y ∈ χX.range → ∃ x ∈ N, χX x = y := by
    intro N hN
    have hrr : IsOpenMap χX.rangeRestrict :=
      MonoidHom.isOpenMap_of_sigmaCompact _ χX.rangeRestrict_surjective
        (hχXc.subtype_mk _)
    have h1 : χX.rangeRestrict '' N ∈ 𝓝 (1 : χX.range) := by
      have := hrr.image_mem_nhds hN
      rwa [map_one] at this
    obtain ⟨V, hV, hVsub⟩ := (mem_nhds_subtype _ _ _).1 h1
    refine ⟨V, hV, fun y hy hyr => ?_⟩
    obtain ⟨x, hx, hxy⟩ := hVsub (show (⟨y, hyr⟩ : χX.range).1 ∈ V from hy)
    exact ⟨x, hx, congrArg Subtype.val hxy⟩
  -- Step 7: the closed subgroup `B̃ ⊆ ℝ^p`
  let πa : (Fin p → ℝ) →+ (Fin p → UnitAddCircle) :=
    AddMonoidHom.compLeft (QuotientAddGroup.mk' _) (Fin p)
  have hπa : ∀ y i, πa y i = ((y i : ℝ) : UnitAddCircle) := fun _ _ => rfl
  have hπac : Continuous πa := continuous_pi fun i =>
    QuotientAddGroup.continuous_mk.comp (continuous_apply i)
  let Bt : AddSubgroup (Fin p → ℝ) :=
    { carrier := {y | Multiplicative.ofAdd (πa y) ∈ χX.range}
      add_mem' := fun {a b} ha hb => by
        show Multiplicative.ofAdd (πa (a + b)) ∈ χX.range
        rw [map_add, ofAdd_add]
        exact χX.range.mul_mem ha hb
      zero_mem' := by
        show Multiplicative.ofAdd (πa 0) ∈ χX.range
        rw [map_zero, ofAdd_zero]
        exact χX.range.one_mem
      neg_mem' := fun {a} ha => by
        show Multiplicative.ofAdd (πa (-a)) ∈ χX.range
        rw [map_neg, ofAdd_neg]
        exact χX.range.inv_mem ha }
  have hBtcl : IsClosed (Bt : Set (Fin p → ℝ)) :=
    hrc.isClosed.preimage (continuous_ofAdd.comp hπac)
  obtain ⟨p', k', m', v, b, -, -, -, hgen⟩ := closedSubgroup_structure Bt hBtcl
  -- Step 8: lifts
  have hγ : ∀ i : Fin p', ∃ G : ℝ → H ⧸ K, Continuous G ∧ (∀ s t, G (s + t) = G s * G t) ∧
      ∀ t, χX (G t) = Multiplicative.ofAdd (πa (t • v i)) := by
    intro i
    refine lift_one_param χX hχXc hloc hopen (fun t => Multiplicative.ofAdd (πa (t • v i)))
      (fun s t => by rw [add_smul, map_add, ofAdd_add])
      (continuous_ofAdd.comp (hπac.comp (continuous_id.smul continuous_const))) (fun t => ?_)
    have : t • v i ∈ Bt := (hgen _).2 ⟨fun l => if l = i then t else 0, 0, by simp⟩
    exact this
  choose G hGc hGhom hGχ using hγ
  have hG0 : ∀ i, G i 0 = 1 := fun i => by
    have h := hGhom i 0 0
    rw [add_zero] at h
    have := congrArg (fun z => z * (G i 0)⁻¹) h
    simpa using this.symm
  have hβ : ∀ l : Fin k', ∃ β : H ⧸ K, χX β = Multiplicative.ofAdd (πa (b l)) := by
    intro l
    have : b l ∈ Bt := (hgen _).2 ⟨0, fun l' => if l' = l then 1 else 0, by simp⟩
    obtain ⟨β, hβ⟩ := this
    exact ⟨β, hβ⟩
  choose β hβχ using hβ
  let gen : Fin (k' + j) → H ⧸ K := Fin.append β (fun l => (T l : H ⧸ K))
  -- Step 9: the surjection `Φ`
  let Φ : Multiplicative ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)) →* H ⧸ K :=
    { toFun := fun x => (∏ i, G i ((Multiplicative.toAdd x).1 i)) *
        ∏ l, gen l ^ ((Multiplicative.toAdd x).2 l)
      map_one' := by simp [hG0]
      map_mul' := fun x y => by
        simp only [toAdd_mul, Prod.fst_add, Prod.snd_add, Pi.add_apply, hGhom, zpow_add,
          Finset.prod_mul_distrib]
        exact mul_mul_mul_comm _ _ _ _ }
  have hΦ : ∀ x, Φ x = (∏ i, G i ((Multiplicative.toAdd x).1 i)) *
      ∏ l, gen l ^ ((Multiplicative.toAdd x).2 l) := fun _ => rfl
  have hΦc : Continuous Φ := by
    have h1 : Continuous fun x : Multiplicative ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)) =>
        ∏ i, G i ((Multiplicative.toAdd x).1 i) :=
      continuous_finsetProd _ fun i _ =>
        (hGc i).comp ((continuous_apply i).comp (continuous_fst.comp continuous_toAdd))
    have h2 : Continuous fun x : Multiplicative ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)) =>
        ∏ l, gen l ^ ((Multiplicative.toAdd x).2 l) :=
      (continuous_of_discreteTopology (f := fun n : Fin (k' + j) → ℤ => ∏ l, gen l ^ n l)).comp
        (continuous_snd.comp continuous_toAdd)
    exact h1.mul h2
  -- the kernel of `χX` is the image of `Z`
  have hkerX : ∀ x : H ⧸ K, χX x = 1 → ∃ a : Fin j → ℤ, x = ∏ l, (T l : H ⧸ K) ^ a l := by
    intro x hx
    obtain ⟨h, rfl⟩ := QuotientGroup.mk_surjective x
    rw [hχX] at hx
    obtain ⟨z, hz, k, hk, rfl⟩ := hkerK h hx
    obtain ⟨a, rfl⟩ := (Subgroup.mem_closure_range_iff_of_fintype).1 hz
    refine ⟨a, ?_⟩
    rw [QuotientGroup.mk_mul, (QuotientGroup.eq_one_iff k).2 hk, mul_one]
    simp [QuotientGroup.mk_prod, QuotientGroup.mk_zpow]
  have htoAddχX : ∀ x y : H ⧸ K, Multiplicative.toAdd (χX (x * y)) =
      Multiplicative.toAdd (χX x) + Multiplicative.toAdd (χX y) := fun x y => by
    rw [map_mul, toAdd_mul]
  have hΦs : Function.Surjective Φ := by
    intro x
    obtain ⟨y₀, hy₀⟩ : ∃ y₀ : Fin p → ℝ, Multiplicative.ofAdd (πa y₀) = χX x := by
      choose y hy using fun i => QuotientAddGroup.mk_surjective (Multiplicative.toAdd (χX x) i)
      exact ⟨y, by ext i; exact hy i⟩
    have hy₀B : y₀ ∈ Bt := by
      show Multiplicative.ofAdd (πa y₀) ∈ χX.range
      rw [hy₀]; exact ⟨x, rfl⟩
    obtain ⟨t, n, hy⟩ := (hgen y₀).1 hy₀B
    let w : H ⧸ K := (∏ i, G i (t i)) * ∏ l, β l ^ n l
    have hχw : χX w = χX x := by
      rw [← hy₀, hy]
      apply Multiplicative.toAdd.injective
      simp only [w, map_mul, map_prod, map_zpow, hGχ, hβχ, toAdd_mul, toAdd_prod, toAdd_zpow,
        toAdd_ofAdd, map_add, map_sum, map_zsmul, Int.cast_smul_eq_zsmul]
    obtain ⟨a, ha⟩ := hkerX (w⁻¹ * x) (by rw [map_mul, map_inv, hχw, inv_mul_cancel])
    refine ⟨Multiplicative.ofAdd (t, Fin.append n a), ?_⟩
    rw [hΦ, toAdd_ofAdd]
    simp only [Fin.prod_univ_add, gen, Fin.append_left, Fin.append_right]
    rw [← ha, ← mul_assoc]
    show w * (w⁻¹ * x) = x
    rw [mul_inv_cancel_left]
  -- Step 10: open mapping
  haveI : T2Space (H ⧸ K) := inferInstance
  haveI : LocallyCompactSpace (H ⧸ K) := inferInstance
  haveI : BaireSpace (H ⧸ K) := inferInstance
  haveI : SigmaCompactSpace (Multiplicative ((Fin p' → ℝ) × (Fin (k' + j) → ℤ))) :=
    inferInstanceAs (SigmaCompactSpace ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)))
  have hΦo : IsOpenMap Φ := MonoidHom.isOpenMap_of_sigmaCompact Φ hΦs hΦc
  -- Step 11: the quotient of `ℝ^p' × ℤ^a` by `ker Φ`
  let Aker : AddSubgroup ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)) :=
    { carrier := {x | Φ (Multiplicative.ofAdd x) = 1}
      add_mem' := fun {a b} ha hb => by
        show Φ (Multiplicative.ofAdd (a + b)) = 1
        rw [ofAdd_add, map_mul, ha, hb, one_mul]
      zero_mem' := by
        show Φ (Multiplicative.ofAdd 0) = 1
        rw [ofAdd_zero, map_one]
      neg_mem' := fun {a} ha => by
        show Φ (Multiplicative.ofAdd (-a)) = 1
        rw [ofAdd_neg, map_inv, ha, inv_one] }
  have hAcl : IsClosed (Aker : Set ((Fin p' → ℝ) × (Fin (k' + j) → ℤ))) :=
    isClosed_eq (hΦc.comp continuous_ofAdd) continuous_const
  obtain ⟨m, n, r, s, d, ψ, hd, hψc, hψo, hψs, hψk⟩ := quotient_elem p' (k' + j) Aker hAcl
  -- Step 12: the induced isomorphism on `X`
  let ψm : Multiplicative ((Fin p' → ℝ) × (Fin (k' + j) → ℤ)) → Multiplicative (ElemG m n r s d) :=
    fun q => Multiplicative.ofAdd (ψ (Multiplicative.toAdd q))
  have hψmc : Continuous ψm := continuous_ofAdd.comp (hψc.comp continuous_toAdd)
  have hkey : ∀ q₁ q₂, Φ q₁ = Φ q₂ → ψm q₁ = ψm q₂ := by
    intro q₁ q₂ h
    have hmem : Multiplicative.toAdd q₁ - Multiplicative.toAdd q₂ ∈ Aker := by
      show Φ (Multiplicative.ofAdd (Multiplicative.toAdd q₁ - Multiplicative.toAdd q₂)) = 1
      rw [ofAdd_sub, ofAdd_toAdd, ofAdd_toAdd, map_div, h, div_self']
    have := (hψk _).2 hmem
    rw [map_sub, sub_eq_zero] at this
    simp only [ψm, this]
  let sec := Function.surjInv hΦs
  have hsec : ∀ x, Φ (sec x) = x := Function.surjInv_eq hΦs
  let πb : H ⧸ K →* Multiplicative (ElemG m n r s d) :=
    MonoidHom.mk' (fun x => ψm (sec x)) (by
      intro x y
      have h1 : ψm (sec (x * y)) = ψm (sec x * sec y) := hkey _ _ (by rw [hsec, map_mul, hsec, hsec])
      rw [h1]
      simp only [ψm, toAdd_mul, map_add, ofAdd_add])
  have hπbΦ : ∀ q, πb (Φ q) = ψm q := fun q => hkey _ _ (hsec _)
  have hπbc : Continuous πb := by
    rw [continuous_def]
    intro W hW
    have : πb ⁻¹' W = Φ '' (ψm ⁻¹' W) := by
      ext x
      constructor
      · intro hx
        refine ⟨sec x, ?_, hsec x⟩
        show ψm (sec x) ∈ W
        exact hx
      · rintro ⟨q, hq, rfl⟩
        show πb (Φ q) ∈ W
        rw [hπbΦ]; exact hq
    rw [this]
    exact hΦo _ (hW.preimage hψmc)
  have hπbo : IsOpenMap πb := by
    intro W hW
    have : πb '' W = Multiplicative.ofAdd '' (ψ '' (Multiplicative.toAdd '' (Φ ⁻¹' W))) := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        refine ⟨ψ (Multiplicative.toAdd (sec x)), ⟨_, ⟨sec x, by rw [mem_preimage, hsec]; exact hx,
          rfl⟩, rfl⟩, rfl⟩
      · rintro ⟨_, ⟨_, ⟨q, hq, rfl⟩, rfl⟩, rfl⟩
        exact ⟨Φ q, hq, hπbΦ q⟩
    rw [this]
    exact isOpenMap_ofAdd' _ (hψo _ (isOpenMap_toAdd' _ (hW.preimage hΦc)))
  have hπbs : Function.Surjective πb := by
    intro y
    obtain ⟨q, hq⟩ := hψs (Multiplicative.toAdd y)
    refine ⟨Φ (Multiplicative.ofAdd q), ?_⟩
    rw [hπbΦ]
    simp [ψm, hq]
  have hπbk : ∀ x, πb x = 1 → x = 1 := by
    intro x hx
    rw [← hsec x] at hx ⊢
    rw [hπbΦ] at hx
    have h0 : ψ (Multiplicative.toAdd (sec x)) = 0 := congrArg Multiplicative.toAdd hx
    have := (hψk _).1 h0
    simpa [Aker] using this
  -- Step 13: the presentation
  refine ⟨m, n, r, s, d, πb.comp (QuotientGroup.mk' K), hd, hπbc.comp QuotientGroup.continuous_mk,
    hπbo.comp QuotientGroup.isOpenMap_coe, hπbs.comp (QuotientGroup.mk'_surjective K),
    fun x => ?_⟩
  constructor
  · intro hx
    exact (QuotientGroup.eq_one_iff x).1 (hπbk _ hx)
  · intro hx
    show πb (x : H ⧸ K) = 1
    rw [(QuotientGroup.eq_one_iff x).2 hx, map_one]

end LCA

end Main_sec

