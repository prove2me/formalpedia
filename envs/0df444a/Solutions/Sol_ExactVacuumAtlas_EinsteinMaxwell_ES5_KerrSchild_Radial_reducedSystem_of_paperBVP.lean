open scoped ContDiff Topology
open ExactVacuumAtlas ExactVacuumAtlas.EinsteinMaxwell ExactVacuumAtlas.EinsteinMaxwell.D
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas
open ExactVacuumAtlas.EinsteinMaxwell
open ExactVacuumAtlas.EinsteinMaxwell.ES5
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}
theorem solution (hP : PaperData I f m N w p a) {Q J : ℝ}
    (hB : PaperBVP I f m N w p a Q J) :
    Generic.ReducedSystem f (Dfun f m N) (Afun f m) (Hfun m N) w p a I := by
  intro r hr
  obtain ⟨hq, hl, hN2, hA, hBm, h24, hC⟩ := hB r hr
  have hq' : deriv (qFun f N w p a) r = 0 :=
    deriv_eq_zero_of_eqOn_const hP.isOpen hr fun s hs => (hB s hs).1
  have hl' : deriv (ellFun f m N w p a) r = 0 :=
    deriv_eq_zero_of_eqOn_const hP.isOpen hr fun s hs => (hB s hs).2.1
  have hJt : Generic.redJ_t f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0 := by
    rw [redJ_t_eq hP hr, hq', mul_zero]
  have hEts : Generic.redE_tσ f (Dfun f m N) (Afun f m) (Hfun m N) w p a r = 0 := by
    have h := redE_tσ_sub_eq hP hr
    rw [hJt, hl', mul_zero, mul_zero, sub_zero] at h
    exact h
  have hD : paperNResidual N r = 0 := by rw [paperNResidual, hN2, sub_self]
  obtain ⟨htt, hrr, huu, hss⟩ := (einstein4_iff_paper4_of_eq hP hr hq hl).mpr ⟨hD, hA, hBm, hC⟩
  exact ⟨htt, hEts, hrr, huu, hss, hJt, redJ_σ_eq_zero_of_24c hP hr hq hl h24⟩
