section ZetaFactor

variable {S : Finset (HeightOneSpectrum (𝓞 K))} {Pi : HeckeEigensystem K ℂ}

private scoped instance i007 (v : HeightOneSpectrum (𝓞 K)) : Finite (𝓞 K ⧸ v.asIdeal) :=
  Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot

private noncomputable scoped instance i008 (v : HeightOneSpectrum (𝓞 K)) : Fintype (𝓞 K ⧸ v.asIdeal) :=
  Fintype.ofFinite _

private theorem t0342 (v : HeightOneSpectrum (𝓞 K)) :
    Fintype.card (𝓞 K ⧸ v.asIdeal) = Ideal.absNorm v.asIdeal := by
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]

private theorem t0343 {G : Type*} [Group G] {U : Subgroup G} {g : G} {ι : Type*} {reps : ι → G}
    (hsys : HeckeIntegralSeam.IsHeckeCosetSystem U g reps) {κ : Type*} (e : κ ≃ ι) :
    HeckeIntegralSeam.IsHeckeCosetSystem U g (fun i => reps (e i)) where
  mem_doubleCoset i := hsys.mem_doubleCoset (e i)
  covers x hx := by
    obtain ⟨i, hi⟩ := hsys.covers x hx
    exact ⟨e.symm i, by simpa using hi⟩
  mk_injective i j hij := e.injective (hsys.mk_injective hij)

private theorem t0344 (v : HeightOneSpectrum (𝓞 K)) (ϖ : v.adicCompletionIntegers K)
    (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0) (b : v.adicCompletionIntegers K) :
    finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.localRepSome ϖ hϖ b))
      = placeEmbed K v (repSome (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ
          (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) b)) := by
  show _ = finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v _)
  congr 2
  exact Units.ext (by rw [LocalGL2.coe_localRepSome]; rfl)

private theorem t0345 (v : HeightOneSpectrum (𝓞 K)) (ϖ : v.adicCompletionIntegers K)
    (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0) :
    finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.localRepInf ϖ hϖ))
      = placeEmbed K v (repInf (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ) := by
  show _ = finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v _)
  congr 2
  exact Units.ext (by rw [LocalGL2.coe_localRepInf]; rfl)

private theorem t0346 (dF : FinWhittakerDatum K S Pi) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    {ι : Type*} [Fintype ι] (reps : ι → AdelicGL2 (𝓞 K) K)
    (hsys : HeckeIntegralSeam.IsHeckeCosetSystem (levelOne (𝓞 K) K ⊤ ⊓ finiteAdelicGL2Subgroup K)
      (heckeGen (𝓞 K) K v) reps) (hcard : Fintype.card ι = Ideal.absNorm v.asIdeal + 1) (x g : AdelicGL2 (𝓞 K) K) :
    ∑ i, dF.Wf (x * (g * reps i)) = Pi.a v * dF.Wf (x * g) := by
  obtain ⟨reps₀, hsys₀, heq⟩ := dF.hecke_eigen v hv ⊤ (t0011 v)
  let e : Fin (Ideal.absNorm v.asIdeal + 1) ≃ ι := (Fintype.equivFinOfCardEq hcard).symm
  have hsys' := t0343 hsys e
  have hinv : ∀ h : AdelicGL2 (𝓞 K) K, ∀ u ∈ levelOne (𝓞 K) K ⊤ ⊓ finiteAdelicGL2Subgroup K,
      dF.Wf (h * u) = dF.Wf h := fun h u hu => t0017 dF h hu
  have h1 := HeckeIntegralSeam.heckeCosetSum_eq_of_isHeckeCosetSystem hsys' hsys₀ hinv (x * g)
  have h2 := heq (x * g)
  unfold SmoothCusp.heckeCosetSum at h2
  rw [← Fintype.sum_equiv e (fun i => dF.Wf (x * (g * reps (e i)))) (fun i => dF.Wf (x * (g * reps i)))
    (fun _ => rfl)]
  simp only [← mul_assoc] at h1 h2 ⊢
  rw [← h1, h2]

variable {v : HeightOneSpectrum (𝓞 K)}

private theorem unipotent_mul_unipotent (x y : v.adicCompletion K) :
    (unipotent x : GL (Fin 2) (v.adicCompletion K)) * unipotent y = unipotent (x + y) := by
  refine Units.ext ?_
  show (!![1, x; 0, 1] : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) * !![1, y; 0, 1] = !![1, x + y; 0, 1]
  ext i j
  fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, add_comm]

private theorem t0347 (x : v.adicCompletion K) :
    (unipotent x : GL (Fin 2) (v.adicCompletion K))⁻¹ = unipotent (-x) := by
  refine inv_eq_of_mul_eq_one_right ?_
  rw [unipotent_mul_unipotent, add_neg_cancel]
  refine Units.ext ?_
  show (!![1, (0 : v.adicCompletion K); 0, 1] : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) = 1
  rw [Matrix.one_fin_two]

private theorem t0348 {x : v.adicCompletion K} (hx : Valued.v x ≤ 1) :
    LocalWhittaker.IsIntegral Valued.v (unipotent x : GL (Fin 2) (v.adicCompletion K)) := by
  intro i j
  show Valued.v ((!![1, x; 0, 1] : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) i j) ≤ 1
  fin_cases i <;> fin_cases j <;> simp [hx]

private theorem t0349 (dF : FinWhittakerDatum K S Pi) (v : HeightOneSpectrum (𝓞 K))
    (r : v.adicCompletionIntegers K) (g : AdelicGL2 (𝓞 K) K) :
    dF.Wf (g * placeEmbed K v (unipotent (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r)))
      = dF.Wf g := by
  have hr : Valued.v (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r) ≤ 1 :=
    (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp r.2
  refine t0012 dF v (t0348 hr) ?_ g
  rw [t0347]
  exact t0348 (by rw [Valuation.map_neg]; exact hr)

private theorem t0350 (v : HeightOneSpectrum (𝓞 K))
    (ϖ : v.adicCompletionIntegers K) (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0)
    (hgen : finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.diagPi ϖ hϖ)) = heckeGen (𝓞 K) K v) :
    algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ = (uniformizerUnit K v : v.adicCompletion K) := by
  have h := congrArg (compAt v) hgen
  have hl : compAt v (finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.diagPi ϖ hϖ))) = LocalGL2.diagPi ϖ hϖ :=
    t0003 v _
  have hr : compAt v (heckeGen (𝓞 K) K v) = diagOne (unitAt v (d004 v (uniformizerUnit K v))) :=
    t0099 v _
  rw [hl, hr] at h
  have h00 := congrArg
    (fun M : GL (Fin 2) (v.adicCompletion K) => (M : Matrix (Fin 2) (Fin 2) (v.adicCompletion K)) 0 0) h
  simp only [LocalGL2.coe_diagPi, Matrix.of_apply, Matrix.cons_val_zero, diagOne_coe_apply] at h00
  rw [h00]
  simp [t0051, t0034]

private theorem t0351 (dF : FinWhittakerDatum K S Pi) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (ϖ : v.adicCompletionIntegers K) (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0)
    (hgen : finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.diagPi ϖ hϖ)) = heckeGen (𝓞 K) K v)
    (g : AdelicGL2 (𝓞 K) K) :
    dF.Wf (g * placeEmbed K v (scalarPi (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ))
      = Pi.toRawCentral.b v * dF.Wf g := by
  have hϖu := t0350 v ϖ hϖ hgen
  have hsc : scalarPi (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ
      = d007 (uniformizerUnit K v) := by
    refine Units.ext ?_
    rw [t0065, ← hϖu]
    show (!![algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ, 0; 0,
      algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ] : Matrix (Fin 2) (Fin 2) _) = _
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.scalar_apply]
  have h := dF.central_eigen v hv g
  rw [t0037, t0031, t0074] at h
  rw [hsc, ← t0074, t0067, t0074, h]

private theorem t0352 {u : (AdeleRing (𝓞 K) K)ˣ}
    (hu : ∀ v : HeightOneSpectrum (𝓞 K),
      ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v ∈ v.adicCompletionIntegers K) :
    IsLevelOneMatrix (𝓞 K) K ⊤ ((glFin (𝓞 K) K (diagOne u) :
      GL (Fin 2) (FiniteAdeleRing (𝓞 K) K)) : Matrix (Fin 2) (Fin 2) (FiniteAdeleRing (𝓞 K) K)) := by
  have huint : ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2
      ∈ NumberField.AdelicLevel.integralFiniteAdeles (𝓞 K) K := hu
  refine ⟨⟨fun i j => ?_, ?_⟩, ?_⟩
  · rw [glFin_apply, diagOne_coe_apply]
    fin_cases i <;> fin_cases j <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
      first
        | exact huint
        | exact NumberField.AdelicLevel.one_mem_integralFiniteAdeles
        | exact NumberField.AdelicLevel.zero_mem_integralFiniteAdeles
        | simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
            Matrix.head_cons, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.head_fin_const] <;>
          first
            | exact huint
            | exact NumberField.AdelicLevel.one_mem_integralFiniteAdeles
            | exact NumberField.AdelicLevel.zero_mem_integralFiniteAdeles
  · rw [glFin_apply, diagOne_coe_apply]
    exact zero_mem_idealBall _
  · rw [glFin_apply, diagOne_coe_apply]
    simp only [Matrix.diagonal_apply_eq, Matrix.cons_val_one, Matrix.cons_val_zero]
    rw [show ((1 : AdeleRing (𝓞 K) K)).2 = (1 : FiniteAdeleRing (𝓞 K) K) from rfl, sub_self]
    exact zero_mem_idealBall _

private theorem t0353 {u : (AdeleRing (𝓞 K) K)ˣ}
    (hu : ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1) : glArch (𝓞 K) K (diagOne u) = 1 := by
  refine Units.ext (Matrix.ext fun i j => ?_)
  rw [glArch_apply, Units.val_one, diagOne_coe_apply]
  fin_cases i <;> fin_cases j <;> simp [hu] <;> rfl

private theorem t0354 {u : (AdeleRing (𝓞 K) K)ˣ} (hu : s001 S u) :
    diagOne u ∈ levelOne (𝓞 K) K ⊤ ⊓ finiteAdelicGL2Subgroup K := by
  refine Subgroup.mem_inf.mpr ⟨?_, (mem_finiteAdelicGL2Subgroup_iff K _).mpr
    (t0353 (funext hu.arch))⟩
  rw [mem_levelOne_iff, mem_finiteLevelOne_iff]
  refine ⟨t0352 hu.integral, ?_⟩
  rw [← map_inv, ← map_inv]
  exact t0352 hu.integral_inv

private theorem t0355 {u : (AdeleRing (𝓞 K) K)ˣ}
    (h1 : ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1)
    (hS : ∀ v ∈ S, ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1)
    (hfin : NumberField.AdeleRing.finitePartUnits (𝓞 K) K u ∈ IsDedekindDomain.FiniteAdeleRing.unitIdeles (𝓞 K) K) :
    s001 S u := by
  obtain ⟨hint, hinv⟩ := (IsDedekindDomain.FiniteAdeleRing.mem_unitIdeles_iff _).mp hfin
  refine ⟨fun w => by rw [h1]; rfl, fun v => hint v, fun v => ?_, hS⟩
  have h := hinv v
  rwa [← map_inv] at h

private theorem t0356 (dF : FinWhittakerDatum K S Pi) {u : (AdeleRing (𝓞 K) K)ˣ}
    (hu : s001 S u) (g : AdelicGL2 (𝓞 K) K) : dF.Wf (g * diagOne u) = dF.Wf g :=
  t0017 dF g (t0354 hu)

private def d040 (v : HeightOneSpectrum (𝓞 K)) : ℤ :=
  LanglandsTunnell.TateLocal.addCharLevel (StandardAddChar.psiLocal K v)

private theorem t0357 :
    ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, d040 (K := K) v = 0 := by
  have h := FractionalIdeal.finite_factors (R := 𝓞 K) (K := K)
    (differentIdeal ℤ (𝓞 K) : FractionalIdeal (nonZeroDivisors (𝓞 K)) K)
  refine h.mono fun v hv => ?_
  rw [d040, LanglandsTunnell.TateLocal.addCharLevel_psiLocal_eq_count_differentIdeal K v, hv]

private def d041 (δ : (AdeleRing (𝓞 K) K)ˣ) (v : HeightOneSpectrum (𝓞 K)) : AddChar (v.adicCompletion K) ℂ :=
  (StandardAddChar.psiLocal K v).compAddMonoidHom
    (AddMonoidHom.mulLeft (((δ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v))

private theorem t0358 (δ : (AdeleRing (𝓞 K) K)ˣ) (v : HeightOneSpectrum (𝓞 K)) (x : v.adicCompletion K) :
    d041 δ v x = StandardAddChar.psiLocal K v (((δ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v * x) := rfl

private theorem t0359 (v : HeightOneSpectrum (𝓞 K)) (n : ℤ) :
    Valued.v ((uniformizerUnit K v ^ n : (v.adicCompletion K)ˣ) : v.adicCompletion K) = WithZero.exp (-n) := by
  rw [Units.val_zpow_eq_zpow_val, map_zpow₀, valued_uniformizerUnit K v, ← WithZero.exp_zsmul, smul_eq_mul,
    mul_neg_one]

private theorem t0360 (v : HeightOneSpectrum (𝓞 K)) :
    (∀ x : v.adicCompletion K, Valued.v x ≤ WithZero.exp (d040 (K := K) v) → StandardAddChar.psiLocal K v x = 1) ∧
      ∃ x : v.adicCompletion K, Valued.v x ≤ WithZero.exp (d040 (K := K) v + 1) ∧
        StandardAddChar.psiLocal K v x ≠ 1 := by
  unfold d040
  exact LanglandsTunnell.TateLocal.forall_eq_one_and_exists_ne_one_of_addCharLevel K v (StandardAddChar.psiLocal K v)
    ⟨0, fun x hx => LanglandsTunnell.TateLocal.psiLocal_eq_one_of_mem_integers K v x
      ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr (by simpa using hx))⟩
    (LanglandsTunnell.TateLocal.psiLocal_ne_one K v)

private theorem t0361 {δ : (AdeleRing (𝓞 K) K)ˣ}
    (hδ : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S → ((δ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v
      = ((uniformizerUnit K v ^ (-d040 (K := K) v) : (v.adicCompletion K)ˣ) : v.adicCompletion K))
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (r : v.adicCompletionIntegers K) :
    d041 δ v (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r) = 1 := by
  rw [t0358, hδ v hv]
  refine (t0360 v).1 _ ?_
  rw [Valuation.map_mul, t0359, neg_neg]
  calc WithZero.exp (d040 (K := K) v) * Valued.v (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r)
      ≤ WithZero.exp (d040 (K := K) v) * 1 :=
        mul_le_mul_right ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp r.2) _
    _ = WithZero.exp (d040 (K := K) v) := mul_one _

private theorem t0362 {δ : (AdeleRing (𝓞 K) K)ˣ}
    (hδ : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ S → ((δ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v
      = ((uniformizerUnit K v ^ (-d040 (K := K) v) : (v.adicCompletion K)ˣ) : v.adicCompletion K))
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (ϖ : v.adicCompletionIntegers K)
    (hϖ : Valued.v (ϖ : v.adicCompletion K) = WithZero.exp (-1 : ℤ)) :
    ∃ r : v.adicCompletionIntegers K,
      d041 δ v (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r /
        algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) ≠ 1 := by
  obtain ⟨x, hx, hψ⟩ := (t0360 v).2
  have hπ0 : (ϖ : v.adicCompletion K) ≠ 0 := fun h => by
    rw [h, Valuation.map_zero] at hϖ
    exact WithZero.exp_ne_zero hϖ.symm

  set c : v.adicCompletion K :=
    ((uniformizerUnit K v ^ (-d040 (K := K) v) : (v.adicCompletion K)ˣ) : v.adicCompletion K) with hc
  have hc0 : c ≠ 0 := Units.ne_zero _
  have hcval : Valued.v c⁻¹ = WithZero.exp (-d040 (K := K) v) := by
    rw [map_inv₀, hc, t0359, neg_neg, ← WithZero.exp_neg]

  have hval : Valued.v ((ϖ : v.adicCompletion K) * c⁻¹ * x) ≤ 1 := by
    rw [Valuation.map_mul, Valuation.map_mul, hϖ, hcval, ← WithZero.exp_add]
    calc WithZero.exp (-1 + -d040 (K := K) v) * Valued.v x
        ≤ WithZero.exp (-1 + -d040 (K := K) v) * WithZero.exp (d040 (K := K) v + 1) :=
          mul_le_mul_right hx _
      _ = 1 := by rw [← WithZero.exp_add, show (-1 + -d040 (K := K) v) + (d040 (K := K) v + 1) = 0 by ring,
            WithZero.exp_zero]
  refine ⟨⟨(ϖ : v.adicCompletion K) * c⁻¹ * x, (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mpr hval⟩, ?_⟩
  rw [t0358, hδ v hv]
  convert hψ using 2
  show c * ((ϖ : v.adicCompletion K) * c⁻¹ * x / (ϖ : v.adicCompletion K)) = x
  field_simp

private def cutS (S : Finset (HeightOneSpectrum (𝓞 K))) (g : AdelicGL2 (𝓞 K) K) : ℂ :=
  if ∀ v ∈ S, LocalWhittaker.IsIntegral Valued.v (compAt v g) ∧ LocalWhittaker.IsIntegral Valued.v (compAt v g)⁻¹
    then 1 else 0

private theorem t0363 {g g' : AdelicGL2 (𝓞 K) K} (h : ∀ v ∈ S, compAt v g' = compAt v g) :
    cutS S g' = cutS S g := by
  unfold cutS
  congr 1
  exact propext (forall_congr' fun v => forall_congr' fun hv => by rw [h v hv])

private theorem t0364 {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (h : GL (Fin 2) (v.adicCompletion K)) (g : AdelicGL2 (𝓞 K) K) :
    ∀ w ∈ S, compAt w (g * placeEmbed K v h) = compAt w g := fun w hw => by
  rw [map_mul, t0004 (ne_of_mem_of_not_mem hw hv), mul_one]

private theorem t0365 {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S)
    (h : GL (Fin 2) (v.adicCompletion K)) (g : AdelicGL2 (𝓞 K) K) :
    ∀ w ∈ S, compAt w (placeEmbed K v h * g) = compAt w g := fun w hw => by
  rw [map_mul, t0004 (ne_of_mem_of_not_mem hw hv), one_mul]

private theorem t0366 {u : (AdeleRing (𝓞 K) K)ˣ}
    (hS : ∀ v ∈ S, ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v = 1) (g : AdelicGL2 (𝓞 K) K) :
    ∀ w ∈ S, compAt w (g * diagOne u) = compAt w g := fun w hw => by
  have h1 : unitAt w u = 1 := Units.ext (by rw [t0051, hS w hw]; rfl)
  rw [map_mul, t0099, h1, map_one, mul_one]

private def cutWf (dF : FinWhittakerDatum K S Pi) (A : AdelicGL2 (𝓞 K) K → ℂ) (δ : (AdeleRing (𝓞 K) K)ˣ)
    (g : AdelicGL2 (𝓞 K) K) : ℂ :=
  cutS S g * A g * dF.Wf (diagOne δ * g)

private theorem t0367 {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) (g : AdelicGL2 (𝓞 K) K)
    (v : HeightOneSpectrum (𝓞 K)) (h : GL (Fin 2) (v.adicCompletion K)) : A (g * placeEmbed K v h) = A g :=
  hA g _ (by rw [map_mul, t0019, mul_one])

private theorem t0368 {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) (g : AdelicGL2 (𝓞 K) K)
    (v : HeightOneSpectrum (𝓞 K)) (h : GL (Fin 2) (v.adicCompletion K)) : A (placeEmbed K v h * g) = A g :=
  hA g _ (by rw [map_mul, t0019, one_mul])

private theorem t0369 {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) (g : AdelicGL2 (𝓞 K) K)
    {u : (AdeleRing (𝓞 K) K)ˣ} (hu : ((u : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).1 = 1) :
    A (g * diagOne u) = A g :=
  hA g _ (by rw [map_mul, t0353 hu, mul_one])

private theorem t0370 (δ : (AdeleRing (𝓞 K) K)ˣ) (v : HeightOneSpectrum (𝓞 K))
    (x : v.adicCompletion K) :
    diagOne δ * placeEmbed K v (unipotent x)
      = placeEmbed K v (unipotent (((δ : (AdeleRing (𝓞 K) K)ˣ) : AdeleRing (𝓞 K) K).2 v * x)) * diagOne δ := by
  refine t0018 ?_ fun w => ?_
  · rw [map_mul, map_mul, t0019, t0019, mul_one, one_mul]
  · rw [map_mul, map_mul, t0099]
    by_cases hw : w = v
    · subst hw
      rw [t0003, t0003]
      refine Units.ext ?_
      rw [Units.val_mul, Units.val_mul]
      show (diagOne (unitAt w δ) : Matrix (Fin 2) (Fin 2) _) * !![1, x; 0, 1]
        = !![1, _ * x; 0, 1] * (diagOne (unitAt w δ) : Matrix (Fin 2) (Fin 2) _)
      ext i j
      fin_cases i <;> fin_cases j <;> simp [Matrix.mul_apply, Fin.sum_univ_two, diagOne_coe_apply, t0051]
    · rw [t0004 hw, t0004 hw, mul_one, one_mul]

section TailKernel

private def d042 (dF : FinWhittakerDatum K S Pi) (A : AdelicGL2 (𝓞 K) K → ℂ) (m g : AdelicGL2 (𝓞 K) K) : ℂ :=
  cutS S g * A g * dF.Wf (g * m)

private theorem t0371 {m : AdelicGL2 (𝓞 K) K} (hm : ∀ v ∉ S, compAt v m = 1)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (h : GL (Fin 2) (v.adicCompletion K)) :
    placeEmbed K v h * m = m * placeEmbed K v h := by
  refine t0018 ?_ fun w => ?_
  · rw [map_mul, map_mul, t0019, one_mul, mul_one]
  · rw [map_mul, map_mul]
    by_cases hw : w = v
    · subst hw
      rw [t0003, hm _ hv, one_mul, mul_one]
    · rw [t0004 hw, one_mul, mul_one]

private theorem t0372 {m : AdelicGL2 (𝓞 K) K} (hm : ∀ v ∉ S, compAt v m = 1)
    {u : (AdeleRing (𝓞 K) K)ˣ} (hu : s001 S u) : diagOne u * m = m * diagOne u := by
  refine t0018 ?_ fun w => ?_
  · rw [map_mul, map_mul, t0353 (funext hu.arch), one_mul, mul_one]
  · rw [map_mul, map_mul]
    by_cases hw : w ∈ S
    · have h1 : unitAt w u = 1 := Units.ext (by rw [t0051, hu.trivial_on w hw]; rfl)
      rw [t0099, h1, map_one, one_mul, mul_one]
    · rw [hm w hw, one_mul, mul_one]

private theorem t0373 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) (m : AdelicGL2 (𝓞 K) K)
    {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (x : v.adicCompletion K) (g : AdelicGL2 (𝓞 K) K) :
    d042 dF A m (placeEmbed K v (unipotent x) * g) = StandardAddChar.psiLocal K v x * d042 dF A m g := by
  unfold d042
  rw [t0363 (t0365 hv _ g), t0368 hA,
    mul_assoc (placeEmbed K v (unipotent x)), dF.unipotent_left v hv, mul_left_comm]

private theorem t0374 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {m : AdelicGL2 (𝓞 K) K}
    (hm : ∀ v ∉ S, compAt v m = 1) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (r : v.adicCompletionIntegers K)
    (g : AdelicGL2 (𝓞 K) K) :
    d042 dF A m
        (g * placeEmbed K v (unipotent (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) r)))
      = d042 dF A m g := by
  unfold d042
  rw [t0363 (t0364 hv _ g), t0367 hA, mul_assoc g,
    t0371 hm hv, ← mul_assoc g m, t0349]

private theorem t0375 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {m : AdelicGL2 (𝓞 K) K}
    (hm : ∀ v ∉ S, compAt v m = 1) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (ϖ : v.adicCompletionIntegers K)
    (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0)
    (hgen : finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v (LocalGL2.diagPi ϖ hϖ)) = heckeGen (𝓞 K) K v)
    (g : AdelicGL2 (𝓞 K) K) :
    d042 dF A m
        (g * placeEmbed K v (scalarPi (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ))
      = Pi.toRawCentral.b v * d042 dF A m g := by
  unfold d042
  rw [t0363 (t0364 hv _ g), t0367 hA, mul_assoc g,
    t0371 hm hv, ← mul_assoc g m, t0351 dF hv ϖ hϖ hgen,
    mul_left_comm]

private theorem t0376 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {m : AdelicGL2 (𝓞 K) K}
    (hm : ∀ v ∉ S, compAt v m = 1) {u : (AdeleRing (𝓞 K) K)ˣ} (hu : s001 S u) (g : AdelicGL2 (𝓞 K) K) :
    d042 dF A m (g * diagOne u) = d042 dF A m g := by
  unfold d042
  rw [t0363 (t0366 hu.trivial_on g), t0369 hA g (funext hu.arch),
    mul_assoc g, t0372 hm hu, ← mul_assoc g m, t0356 dF hu]

private theorem t0377 (dF : FinWhittakerDatum K S Pi) {A : AdelicGL2 (𝓞 K) K → ℂ}
    (hA : ∀ g g' : AdelicGL2 (𝓞 K) K, glArch (𝓞 K) K g' = glArch (𝓞 K) K g → A g' = A g) {m : AdelicGL2 (𝓞 K) K}
    (hm : ∀ v ∉ S, compAt v m = 1) {v : HeightOneSpectrum (𝓞 K)} (hv : v ∉ S) (ϖ : v.adicCompletionIntegers K)
    (hϖ : algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ ≠ 0) (sec : 𝓞 K ⧸ v.asIdeal → 𝓞 K)
    (hsys : HeckeIntegralSeam.IsHeckeCosetSystem (levelOne (𝓞 K) K ⊤ ⊓ finiteAdelicGL2Subgroup K)
      (heckeGen (𝓞 K) K v)
      (fun i : Option (𝓞 K ⧸ v.asIdeal) => finEmbed (𝓞 K) K (localEmbed (𝓞 K) K v
        (i.elim (LocalGL2.localRepInf ϖ hϖ) (fun c => LocalGL2.localRepSome ϖ hϖ
          (algebraMap (𝓞 K) (v.adicCompletionIntegers K) (sec c)))))))
    (g : AdelicGL2 (𝓞 K) K) :
    (∑ c : 𝓞 K ⧸ v.asIdeal, d042 dF A m (g * placeEmbed K v (repSome
        (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ
        (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K)
          (algebraMap (𝓞 K) (v.adicCompletionIntegers K) (sec c)))))) +
      d042 dF A m (g * placeEmbed K v (repInf
        (algebraMap (v.adicCompletionIntegers K) (v.adicCompletion K) ϖ) hϖ)) =
      Pi.a v * d042 dF A m g := by
  have h := t0346 dF hv _ hsys (by rw [Fintype.card_option, t0342]) g m
  rw [Fintype.sum_option] at h
  simp only [Option.elim] at h
  simp only [t0344, t0345] at h
  unfold d042
  have hcut : ∀ k : GL (Fin 2) (v.adicCompletion K),
      cutS S (g * placeEmbed K v k) * A (g * placeEmbed K v k) * dF.Wf (g * placeEmbed K v k * m)
        = cutS S g * A g * dF.Wf (g * (m * placeEmbed K v k)) := fun k => by
    rw [t0363 (t0364 hv k g), t0367 hA, mul_assoc g,
      t0371 hm hv]
  rw [hcut, Finset.sum_congr rfl fun c _ => hcut _, ← Finset.mul_sum]
  linear_combination (cutS S g * A g) * h

end TailKernel
