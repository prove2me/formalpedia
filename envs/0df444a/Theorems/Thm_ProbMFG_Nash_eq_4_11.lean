-- title:
--   (4.11), p. 2726 — propagation of chaos: max_i 𝔼 sup_t |X^i_t − X̄^i_t|² ≤ c N^{−2/(d+4)}
-- statement:
--   This is the propagation-of-chaos estimate (4.11) in the proof of Theorem 4.2 of Carmona and Delarue.
--
--   Throughout, assumptions (A.1)–(A.7) are in force with constants $\lambda, c_L > 0$. Let $(X_t, Y_t, Z_t)_{0\le t\le T}$ be a solution of the McKean–Vlasov FBSDE (3.1) on a probability space $(\Omega_0, \mathbb P_0)$ carrying an $m$-dimensional Brownian motion, let $\mu_t = \mathbb P_{X_t}$ be its flow of marginal laws, and let $u : [0,T]\times\mathbb R^d \to \mathbb R^d$ be the associated FBSDE value function: for some $c \ge 0$, $|u(t,x)| \le c(1+|x|)$ and $|u(t,x)-u(t,x')| \le c|x-x'|$ for all $t \in [0,T]$, $x, x'$ (this is (3.3)), and $\mathbb P_0$-a.s., $Y_t = u(t, X_t)$ for all $t \in [0,T]$. Let $J$ be the optimal cost of the limiting mean-field problem (4.1),
--   $$J = \mathbb E\Big[g(X_T,\mu_T) + \int_0^T f\big(t, X_t, \mu_t, \hat\alpha(t, X_t, \mu_t, Y_t)\big)\,dt\Big].$$
--   On a probability space $(\Omega, \mathbb P)$ fix a sequence $(W^i)_{i\ge1}$ of independent $m$-dimensional Brownian motions. For $N \ge 1$, $(X^1,\dots,X^N)$ denotes a solution of the particle system (4.2),
--   $$dX^i_t = b\big(t, X^i_t, \bar\mu^N_t, \hat\alpha(t, X^i_t, \mu_t, u(t, X^i_t))\big)dt + \sigma\,dW^i_t,\quad X^i_0 = x_0,\quad \bar\mu^N_t = \frac1N\sum_{j=1}^N \delta_{X^j_t},$$
--   and $\bar\alpha^{N,i}_t = \hat\alpha(t, X^i_t, \mu_t, u(t, X^i_t))$ are the strategies (4.3). For a strategy profile $(\beta^1,\dots,\beta^N)$, $U^i$ are the states (4.5), $dU^i_t = b(t, U^i_t, \bar\nu^N_t, \beta^i_t)dt + \sigma dW^i_t$, $U^i_0 = x_0$, $\bar\nu^N_t = \frac1N\sum_j\delta_{U^j_t}$, and $\bar J^{N,i}(\beta^1,\dots,\beta^N) = \mathbb E[g(U^i_T, \bar\nu^N_T) + \int_0^T f(t, U^i_t, \bar\nu^N_t, \beta^i_t)dt]$ is the cost (4.6) to player $i$. Strategies are progressively measurable for the filtration generated by $(W^1,\dots,W^N)$.
--
--   Let $(\bar X^1,\dots,\bar X^N)$ solve the decoupled system $d\bar X^i_t = b\big(t,\bar X^i_t,\mu_t,\hat\alpha(t,\bar X^i_t,\mu_t,u(t,\bar X^i_t))\big)dt + \sigma\,dW^i_t$, $\bar X^i_0 = x_0$, driven by the same $W^i$ as (4.2); the paper notes that "the stochastic processes $\bar X^i$ are independent copies of $X$ and, in particular, $\mathbb P_{\bar X^i_t} = \mu_t$ for any $t\in[0,T]$ and $i\in\{1,\dots,N\}$."
--
--   **Statement.** There is a constant $c$ such that for every $N\ge1$, every solution of (4.2), every solution of the decoupled system and every $i$,
--   $$\mathbb E\Big[\sup_{0\le t\le T}|X^i_t-\bar X^i_t|^2\Big]\le c\,N^{-2/(d+4)}.$$
--
--   It quantifies how close each player's state under the mean-field strategies is to an independent copy of the mean-field state; together with (4.13) and Lemma 4.1 it gives (4.12).
--
--   **Formalization Note** The model, (A.1)–(A.7), $\hat\alpha$ and (3.1) are those of `ProbMFG.Nash.Model` and `ProbMFG.Nash.MFGSolution`; the game objects are those of `ProbMFG.Nash.Game`. Players are indexed by `Fin N`, so the paper's player $1$ is index $0$ and "$2 \le i \le N$" is "$i \ne 0$". The mean-field solution and the game live on two probability spaces; only $\mu$, $J$ and $u$ pass from the first to the second (the paper's "for convenience, we fix a sequence … of independent Brownian motions"). Beyond the page, the hypotheses include: $u$ jointly measurable in $(t,x)$ (the value function $u^\mu$ of Lemma 3.5 is measurable), and Borel measurability of $f$ and $g$ on $[0,T]\times\mathbb R^d\times\mathcal P_2\times\mathbb R^k$ and $\mathbb R^d\times\mathcal P_2$ (part of `Assumptions`), so that the expected costs are expectations of measurable integrands. Solutions of the SDEs are Itô processes in Peng's sense with almost surely continuous paths on $[0,T]$. All norms are Euclidean. Expectations of nonnegative quantities are lower Lebesgue integrals in $[0,\infty]$; costs are real expectations. The constant $c$ is chosen before $N$; the bound in $[0,\infty]$ compares a lower Lebesgue integral with the real number $cN^{-2/(d+4)}$.
-- source:
--   Carmona and Delarue, Probabilistic analysis of mean-field games, SIAM J. Control Optim. 51 (2013), p. 2726, (4.11); the decoupled system on p. 2725

import Mathlib
import Definitions.Def_ProbMFG_Nash_Game

open MeasureTheory
open scoped NNReal ENNReal

namespace ProbMFG.Nash

/-- (4.11), p. 2726: `max_i 𝔼 sup_{t ≤ T} |X^i_t − X̄^i_t|² ≤ c N^{-2/(d+4)}` for the particle system (4.2) and the decoupled copies. -/
theorem eq_4_11 {d m k : ℕ} (M : Model d m k) (lam cL : ℝ) (hA : Assumptions M lam cL)
    {Ω₀ : Type*} [MeasurableSpace Ω₀] (P₀ : Measure Ω₀) [IsProbabilityMeasure P₀]
    (W₀ : ℝ≥0 → Ω₀ → Fin m → ℝ) (hW₀ : Peng1990.SMP.IsStdBrownian P₀ W₀)
    (X Y : ℝ≥0 → Ω₀ → EuclideanSpace ℝ (Fin d))
    (Z : Fin m → ℝ≥0 → Ω₀ → EuclideanSpace ℝ (Fin d))
    (hXYZ : SolvesMKV M P₀ hW₀ X Y Z)
    (u : ℝ≥0 → EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d))
    (hu : ∃ c ≥ (0 : ℝ), ∀ t ≤ M.T, ∀ x x' : EuclideanSpace ℝ (Fin d),
      ‖u t x‖ ≤ c * (1 + ‖x‖) ∧ ‖u t x - u t x'‖ ≤ c * ‖x - x'‖)
    (hu_meas : Measurable (fun p : ℝ≥0 × EuclideanSpace ℝ (Fin d) => u p.1 p.2))
    (hYu : ∀ᵐ ω ∂P₀, ∀ t ≤ M.T, Y t ω = u t (X t ω))
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (Ws : ℕ → ℝ≥0 → Ω → Fin m → ℝ) (hWs : ∀ i, Peng1990.SMP.IsStdBrownian P (Ws i))
    (hind : ProbabilityTheory.iIndepFun (fun i ω t => Ws i t ω) P) :
    ∃ c : ℝ, ∀ N : ℕ, 1 ≤ N → ∀ Xs Xbar : Fin N → ℝ≥0 → Ω → EuclideanSpace ℝ (Fin d),
      IsParticleSystem M P hWs (lawFlow P₀ X) u N Xs → IsDecoupled M P hWs (lawFlow P₀ X) u N Xbar → ∀ i : Fin N,
        ∫⁻ ω, (⨆ t ≤ M.T, ‖Xs i t ω - Xbar i t ω‖ₑ ^ 2) ∂P ≤
          ENNReal.ofReal (c * (N : ℝ) ^ (-(2 : ℝ) / ((d : ℝ) + 4))) := by sorry

end ProbMFG.Nash
