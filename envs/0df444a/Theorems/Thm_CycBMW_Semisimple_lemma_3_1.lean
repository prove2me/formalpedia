-- title:
--   Lemma 3.1 (corrected) — $E_{n-1}\mathscr B_{r,n}E_{n-1} = E_{n-1}\mathscr B_{r,n-2}$
-- statement:
--   Let $F$, $r \ge 1$, $q$, $u$, $\varepsilon$ be as in the setting (non-zero $q, u_i$, $q^2 \ne 1$, pairwise distinct $u_i$, u-admissible parameters), and let $n \ge 2$. Assume either $n \ge 3$ or $\omega_a \ne 0$ for some integer $a$. Write $\mathscr B_{r,n-2} \subseteq \mathscr B_{r,n}$ for the subalgebra generated by $T_i, E_i$ ($1 \le i < n-2$) and $X_j^{\pm1}$ ($1 \le j \le n-2$). Then
--   $$E_{n-1}\,\mathscr B_{r,n}\,E_{n-1} = E_{n-1}\,\mathscr B_{r,n-2},$$
--   that is, every element $E_{n-1}bE_{n-1}$ with $b \in \mathscr B_{r,n}$ equals $E_{n-1}b'$ for some $b' \in \mathscr B_{r,n-2}$, and conversely.
--
--   The lemma identifies the corner of $\mathscr B_{r,n}$ cut out by the last contraction with the algebra on two fewer strands. The condition at $n=2$ corrects the printed statement: if every $\omega_a$ vanishes, its left side can be zero while $E_1$ on the right is nonzero.
--
--   **Formalization Note** Both sides are sets of elements of $\mathscr B_{r,n}$. $E_{n-1}$ is the Lean generator with 0-based index $n-2$. $\mathscr B_{r,n-2}$ is the subalgebra generated by the first generators (for $n = 2$ it is $F \cdot 1$); injectivity of the natural map is not claimed.
-- source:
--   Rui and Si, The representation theory of cyclotomic BMW algebras, arXiv:0807.4149v1, p. 7, Lemma 3.1

import Mathlib
import Definitions.Def_CycBMW_Semisimple_Setting

namespace CycBMW.Semisimple

/-- Corrected Lemma 3.1, p. 7. At `n = 2` the printed equality needs a nonzero
unwrapping parameter: otherwise `E₁ B_{r,2} E₁ = 0` can hold while `E₁ ≠ 0`.
For `n ≥ 3`, `E_{n-1} E_{n-2} E_{n-1} = E_{n-1}` supplies the missing inclusion. -/
theorem lemma_3_1 {F : Type*} [Field F] (r n : ℕ) (hr : 1 ≤ r) (hn : 2 ≤ n)
    (q : F) (u : Fin r → F) (ε : ℤˣ) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1)
    (hu : ∀ i, u i ≠ 0) (hinj : Function.Injective u)
    (hcorner : 3 ≤ n ∨ ∃ a : ℤ, omega r q u ε a ≠ 0) :
    {x : B F r n q u ε | ∃ b : B F r n q u ε,
        x = Eat F r n q u ε (n - 2) * b * Eat F r n q u ε (n - 2)} =
      {x : B F r n q u ε | ∃ b ∈ Bsub F r n q u ε (n - 2),
        x = Eat F r n q u ε (n - 2) * b} := by sorry

end CycBMW.Semisimple
