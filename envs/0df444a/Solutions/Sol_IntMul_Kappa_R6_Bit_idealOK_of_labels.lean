-- Source module: Solutions.R6BitLab
/-!
# Round six, bit side: `IdealOK` from frame labels and a scalar routing identity

A sufficient condition for `QHNet.IdealOK N` in the style of OpenAI's network theorem
(`AModel.network_realizes`), but with **multiplicative** (non-commuting) frames:

* every edge `e` has lower triangular rational Bruhat factors with unit diagonals mod `N`
  (`EdgesOK`); its frame matrix is `X_e = E₁ · σ_e · E₂` mod `N` (`edgeMat`);
* labels (frames) are tracked along the program: initially `1` on every wire, an edge on `w`
  multiplies the label of `w` on the left by `X_e`; every gate touches wires with equal labels,
  and the final label of every role `ρ w` is `swapMat` (`LabOK`);
* the scalar circuit (gates only; temporaries start at `0`) routes role `w` to role `ρ w`
  (`ScalarOK`).

Then `C.IdealOK N` (`idealOK_of_labels`). The physical content of each wire is the array
permutation `Φ(F) = pull (amap F⁻¹)` of its logical content (`frameArr`), `Φ` is multiplicative
(`frameArr_mul`), commutes with pointwise gates (`frameArr_gate`), and the ideal edge is
`Φ(X_e)` (`runArr_steps_eq`, from `AModel.linear_via_bruhat_array`).
-/

set_option linter.unusedSectionVars false

namespace IntMul.Kappa.R6.Bit

open AModel AModelFac Matrix

variable {R : Type*} [CommRing R] {m : ℕ}

/-! ## Frames as array permutations -/

section Frame

variable {sh : Shape} {N : ℕ} [NeZero N] (Λ : Layout sh (m + m) N)

lemma frameArr_one {xs : List R} (h : xs.length = vol sh) : frameArr Λ 1 xs = xs := by
  unfold frameArr
  rw [inv_one]
  exact (pull_congr (g' := id) (fun a ha => amap_one Λ ha) 0 xs).trans (pull_id 0 h)

end Frame

/-! ## Labels and the scalar circuit -/

section Labels

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] (N : ℕ)

/-- Logical run on streams: gates pointwise, edges trivial. -/
lemma logical_getD (n : ℕ) :
    ∀ (prog : List (Instr Wr R m)) (st : Wr → List R), (∀ w, (st w).length = n) →
      ∀ i < n, ∀ w, (netRunH n (fun _ ys => ys) prog st w).getD i 0 =
        prog.foldl scalarStepH (fun x => (st x).getD i 0) w := by
  intro prog
  induction prog with
  | nil => intro st _ i _ w; rfl
  | cons ins l ih =>
    intro st hst i hi w
    have hst' : ∀ w, (instrRun n (fun _ ys => ys) st ins w).length = n := by
      intro w'
      cases ins with
      | gate g S => simp only [instrRun, gateApply]; split_ifs <;> simp [hst w']
      | edge w0 e =>
        simp only [instrRun]
        by_cases h : w' = w0
        · subst h; simp [hst]
        · rw [Function.update_of_ne h]; exact hst w'
    simp only [netRunH, List.foldl_cons] at ih ⊢
    rw [ih _ hst' i hi w]
    refine congrArg (fun v => List.foldl scalarStepH v l w) (funext fun x => ?_)
    cases ins with
    | gate g S =>
      simp only [instrRun, gateApply, scalarStepH, gateVec]
      split_ifs
      · rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn]
      · rfl
    | edge w0 e =>
      simp only [instrRun, scalarStepH]
      by_cases h : x = w0
      · subst h; simp
      · rw [Function.update_of_ne h]

end Labels

namespace QHNet

variable {W T : ℕ}

end QHNet

/-! ## The invariant and `idealOK_of_labels` -/

section Main

variable {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {sh : Shape} {N : ℕ} [NeZero N]
  (Λ : Layout sh (m + m) N)

lemma length_netRunH_id (n : ℕ) (prog : List (Instr Wr R m)) (st : Wr → List R)
    (hst : ∀ w, (st w).length = n) (w : Wr) :
    (netRunH n (fun _ ys => ys) prog st w).length = n :=
  (netRunH_congr n (fun _ ys => ys) (fun _ ys => ys) (fun _ _ h => h) prog
    (fun _ _ _ _ => rfl) st hst).2 w

/-- **`IdealOK` from frame labels.** -/
theorem idealOK_of_labels_sol_aux {W T : ℕ} (C : QHNet R W T m) (hE : C.EdgesOK N) (hlab : C.LabOK N)
    (hsc : C.ScalarOK) : C.IdealOK N := by
  intro sh Λ ins hins w
  have hinit : ∀ x, (QHNet.initH (T := T) (vol sh) ins x).length = vol sh := by
    intro x; cases x with
    | inl w => exact hins w
    | inr t => simp [QHNet.initH]
  have h1 := physical_inv Λ C.prog hE (QHNet.initH (vol sh) ins) (QHNet.initH (vol sh) ins)
    (fun _ => 1) hinit (fun x => (frameArr_one Λ (hinit x)).symm) hlab.1 (.inl (C.ρ w))
  rw [QHNet.idealOut, h1, hlab.2 w]
  have hlog : netRunH (vol sh) (fun _ ys => ys) C.prog (QHNet.initH (vol sh) ins)
      (.inl (C.ρ w)) = ins w := by
    apply List.ext_getElem (by rw [length_netRunH_id _ _ _ hinit, hins])
    intro i h₁ h₂
    rw [length_netRunH_id _ _ _ hinit] at h₁
    rw [← List.getD_eq_getElem _ 0, ← List.getD_eq_getElem _ 0,
      logical_getD (vol sh) C.prog _ hinit i h₁]
    have : (fun x => (QHNet.initH (T := T) (vol sh) ins x).getD i 0) =
        Sum.elim (fun w => (ins w).getD i 0) fun _ => 0 := by
      funext x; cases x with
      | inl w => rfl
      | inr t => simp [QHNet.initH]
    rw [this, hsc]
  rw [hlog, frameArr, Matrix.inv_eq_left_inv swapMat_mul_self]

end Main

end IntMul.Kappa.R6.Bit

