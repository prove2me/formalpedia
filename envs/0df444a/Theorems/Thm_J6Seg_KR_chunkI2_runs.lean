theorem J6Seg.KR.chunkI2_runs {M : MulSpec} {pM : Fin Pp} (hM : MulOK I iprog pM M) (hdom : ∀ x y, M.dom x y)
    {b pk φD B BH : ℕ} {φT : ℕ → ℕ} (hΦD : ∀ x y : ℤ, zsz x ≤ B → zsz y ≤ B → M.Φ x y ≤ φD)
    (hΦT : ∀ n, ∀ x y : ℤ, zsz x ≤ b * (2 * n) + 2 → zsz y ≤ b * (2 * n) + 2 → M.Φ x y ≤ φT n)
    (hb : 1 ≤ b) (P lam : ℕ) (hlam : 1 ≤ lam) (s : IState HS) (di gi gam dd : List ℤ)
    (ds : List (ℕ × List ℤ × List ℤ)) (x : List GI) (l : List ℤ)
    (hx : x.length = lam) (hdi : di.length = lam) (hgi : gi.length = lam) (hga : gam.length = lam)
    (hdd : dd.length = lam)
    (hds : ∀ d ∈ ds, 1 ≤ d.1 ∧ d.2.1.length = d.1 ∧ d.2.2.length = d.1 ∧ d.1 ≤ lam ∧
        d.1 ≤ lam ∧ d.1 ≤ lam ∧ d.1 ≤ lam ∧ TB (2 ^ pk) d.2.1 ∧
        TB (2 ^ pk) d.2.2 ∧ 2 * (2 * d.1) * 2 ^ (2 * pk) < 2 ^ (b - 1) ∧
        zsz ((2 * d.1 : ℕ) : ℤ) ≤ B ∧ (∀ v ∈ blkHdr2 d.1 b, zsz v ≤ BH))
    (hsum : J6Seg.KR.sumN ds ≤ lam) (hok : chunkOK P (2 ^ pk) di gi gam dd ds x) (hxb : AB (2 ^ pk) x)
    (tdi : TB (2 ^ pk) di) (tgi : TB (2 ^ pk) gi) (tga : TB (2 ^ pk) gam) (tdd : TB (2 ^ pk) dd)
    (hBb : b + 4 ≤ B) (hBp : 2 * pk + 4 ≤ B) (hPB : P + 3 ≤ B) (hlB : zsz ((2 * lam : ℕ) : ℤ) ≤ B)
    (hBBH : B ≤ BH) (hBH : ∀ v ∈ tabK2 P pk b lam di gi gam dd ds, zsz v ≤ BH) :
    IRuns I iprog (chunkI2 pM)
      (encK s (BF (KF [] [] [] [] [] [] [] [] [] [] [] []) (gflat x ++ l) [] [] []
        (tabK2 P pk b lam di gi gam dd ds) [] [] [] [] [] [] []))
      (encK s (BF (KF [] [] [] [] [] [] [] [] [] [] [] []) (gflat (chunkG2 P di gi gam dd ds x) ++ l)
        [] [] [] (tabK2 P pk b lam di gi gam dd ds) [] [] [] [] [] [] []))
      (cKer2 pk b lam φD φT B BH ds) := by sorry
