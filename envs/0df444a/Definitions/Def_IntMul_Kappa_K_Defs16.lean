namespace NLogN.KFM

open IntMul NLogN IntMul.HvdH.Ref NLogN.GL NLogN.Rsp NLogN.AX

/-! ## The list form -/

/-- `B̃₀` on a slice of length `t`, producing length `s`. -/
def b0L (p s t α : ℕ) (V : List (ℤ × ℤ)) : List (ℤ × ℤ) :=
  (List.range s).map (B0approx p s t α fun j => V.getD j (0, 0))

/-! ## The slice program on `CU` -/

/-- **`B̃₀` on the slice stack**: `C̃` stage, `J̃'`, `D̃'` stage (no permutations). -/
def bapP0 : RM := RM.seqL [(stageP Ac).ren σc, JP, (stageP Ad).ren σd]

/-- Cost bound of `bapP0`: the `C̃` and `D̃'` stages and the `J̃'` loop. -/
def bap0Cost (p s t α mm Φ B : ℕ) : ℕ :=
  NLogN.Rsp.stCost t 1 s mm Φ B (t / s + 1) +
  jCost s (2 * HvdH.eWidth p α + 1) (HvdH.jIter p s t α) mm Φ B +
  NLogN.Rsp.stCost s 1 s mm Φ B 1

/-! ## The slice program on the `B̃` axis layout -/

/-- The `B̃₀` slice program: `bapP0` in place on `bI`, then transfer to `bO`. -/
def bap0SlP : RM := .seq (RM.ren σP bapP0) (xferP bI bO (cnt2 bS))

/-- Cost bound of one `B̃₀` slice. -/
def bap0SlC (p s t α mm Φ Bacc Q : ℕ) : ℕ :=
  bap0Cost p s t α mm Φ Bacc + (16000 * (Q + 2) + s * 60000 * (Q + 2) + 64)

end NLogN.KFM

end

