    split_ifs <;> simp_all
  · simp only [catCost, List.length_replicate, List.length_reverse]
    have : max (nbits b).length m = m := max_eq_right hbl
    rw [this]
    have : (padL (nbits b) m).length = m := by simp [padL]; omega
    rw [this]; omega
