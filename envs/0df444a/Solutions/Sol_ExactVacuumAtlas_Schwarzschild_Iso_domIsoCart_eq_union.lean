open Real Matrix
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas
open ExactVacuumAtlas.Schwarzschild
open ExactVacuumAtlas.Schwarzschild.Iso
set_option maxHeartbeats 4000000
variable {M : ℝ}
theorem solution (M : ℝ) : domIsoCart M = domCartSlit M ∪ (domRefl M ∪ domRot M) := by
  ext y
  constructor
  · rintro ⟨hρ, hne⟩
    by_cases h1 : 0 < rxy y + y 1
    · exact Or.inl ⟨hρ, hne, h1⟩
    by_cases h2 : 0 < rxy y - y 1
    · refine Or.inr (Or.inl ?_)
      show reflX y ∈ domCartSlit M
      refine ⟨by rw [rho_reflX]; exact hρ, by rw [rho_reflX]; exact hne, ?_⟩
      rw [rxy_reflX, reflX_1]; linarith
    · refine Or.inr (Or.inr ?_)
      show rotC y ∈ domCartSlit M
      refine ⟨by rw [rho_rotC]; exact hρ, by rw [rho_rotC]; exact hne, ?_⟩
      push_neg at h1 h2
      have hr0 : rxy y = 0 := by have := rxy_nonneg y; linarith
      have h12 : y 1 ^ 2 + y 2 ^ 2 = 0 := by rw [← sq_rxy, hr0]; ring
      have hy1 : y 1 = 0 := by nlinarith [sq_nonneg (y 1), sq_nonneg (y 2)]
      have hy2 : y 2 = 0 := by nlinarith [sq_nonneg (y 1), sq_nonneg (y 2)]
      have hy3 : y 3 ≠ 0 := by
        intro h3
        apply hρ.ne'
        unfold rho; rw [hy1, hy2, h3]; simp
      show 0 < rxy (rotC y) + rotC y 1
      unfold rxy
      simp only [rotC_1, rotC_2, hy2, add_zero]
      rw [zero_pow (by norm_num), zero_add, Real.sqrt_sq_eq_abs]
      exact abs_pos.mpr hy3
  · rintro (h | h | h)
    · exact ⟨h.1, h.2.1⟩
    · exact ⟨by rw [← rho_reflX]; exact h.1, by rw [← rho_reflX]; exact h.2.1⟩
    · exact ⟨by rw [← rho_rotC]; exact h.1, by rw [← rho_rotC]; exact h.2.1⟩
