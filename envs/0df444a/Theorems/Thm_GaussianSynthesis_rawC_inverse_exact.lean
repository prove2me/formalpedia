theorem GaussianSynthesis.rawC_inverse_exact (u v : GInt) (e : Nat) :
    SameValue (packedLeft (rawCInverse (rawC u v e))) ⟨u,e⟩ ∧
    SameValue (packedRight (rawCInverse (rawC u v e))) ⟨v,e⟩ := by sorry
