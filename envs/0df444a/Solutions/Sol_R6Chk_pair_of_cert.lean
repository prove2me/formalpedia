/-!
# `F₂` linear algebra from packed certificates

Semantics: `vr n X i : Fin n → ZMod 2` is row `i` of the packed number `X` (bit `t` of the
32-bit field `i`). Certificates are lists of rows; all checks are `dotsP` products compared with
target patterns (`R6ChkPack`).

* `dot_of_dotsP`: a `dotsP` equation gives every inner product `vr A j ⬝ᵥ vr B i`.
* `indep_of_dual`: rows with a dual family (`e_j ⬝ v_i = δ`) are independent.
* `mem_iff_of_cert` (label certificate): `B` (`k` rows), `H` (`n-k` rows) with
  `H Bᵀ = 0`, `H Eᵀ = I`, `D Hᵀ = 0`, `D Bᵀ = I` ⟹ `span B = ker H`, `dim = k`, nondegenerate.
* `pair_of_cert` (edge certificate): `U ⊆ V`, a dual of `U`, and an orthonormal basis `R`
  of the residual (`R ⊥ U`, `R ⊆ V`, `|R| = dim V − |U|`) ⟹ `span U` nondegenerate of dim `|U|`,
  and `U = V` or a norm-one `w ∈ V` orthogonal to `U` exists.
-/

namespace R6Chk

open Matrix Module

/-! ## Vectors -/

/-! ## Linear algebra over `F₂` -/

section LA

variable {n : ℕ}

theorem dot_sum {k : ℕ} (a : (Fin n → ZMod 2)) (c : Fin k → ZMod 2) (v : Fin k → (Fin n → ZMod 2)) :
    a ⬝ᵥ (∑ i, c i • v i) = ∑ i, c i * (a ⬝ᵥ v i) := by
  rw [dotProduct_sum]
  simp [dotProduct_smul]

/-- Orthogonality to a family extends to its span. -/
theorem dot_span_zero {k : ℕ} {a : (Fin n → ZMod 2)} {v : Fin k → (Fin n → ZMod 2)} (h : ∀ i, a ⬝ᵥ v i = 0) :
    ∀ z ∈ spanF v, a ⬝ᵥ z = 0 := by
  intro z hz
  obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hz
  rw [dot_sum]; simp [h]

theorem indep_of_dual {k : ℕ} {v e : Fin k → (Fin n → ZMod 2)} (h : ∀ i j, e j ⬝ᵥ v i = if i = j then 1 else 0) :
    LinearIndependent (ZMod 2) v := by
  rw [Fintype.linearIndependent_iff]
  intro g hg j
  have := congrArg (fun z => e j ⬝ᵥ z) hg
  simp only [dot_sum, h, dotProduct_zero] at this
  simpa [Finset.sum_ite_eq'] using this

theorem finrank_of_dual {k : ℕ} {v e : Fin k → (Fin n → ZMod 2)} (h : ∀ i j, e j ⬝ᵥ v i = if i = j then 1 else 0) :
    finrank (ZMod 2) (spanF v) = k := by
  rw [spanF, finrank_span_eq_card (indep_of_dual h), Fintype.card_fin]

/-- **Edge certificate.** `SV` is a nondegenerate subspace of dimension `kU + kR` containing
`U` and `R`; `U` has a dual family; `R` is orthonormal and orthogonal to `U`. -/
theorem pair_of_cert_sol_aux {kU kR : ℕ} {SV : Submodule (ZMod 2) (Fin n → ZMod 2)} {u eu : Fin kU → (Fin n → ZMod 2)} {r : Fin kR → (Fin n → ZMod 2)}
    (hV : NondegF SV) (hVd : finrank (ZMod 2) SV = kU + kR)
    (huV : ∀ i, u i ∈ SV) (hrV : ∀ i, r i ∈ SV)
    (hUE : ∀ j i, u j ⬝ᵥ eu i = if i = j then 1 else 0)
    (hRU : ∀ j i, r j ⬝ᵥ u i = 0) (hRR : ∀ j i, r j ⬝ᵥ r i = if i = j then 1 else 0) :
    spanF u ≤ SV ∧ finrank (ZMod 2) (spanF u) = kU ∧ NondegF (spanF u) ∧
      (spanF u = SV ∨ ∃ w ∈ SV, w ⬝ᵥ w = 1 ∧ ∀ z ∈ spanF u, z ⬝ᵥ w = 0) := by
  have hle : spanF u ≤ SV := by
    rw [spanF, Submodule.span_le]; rintro _ ⟨i, rfl⟩; exact huV i
  have hRle : spanF r ≤ SV := by
    rw [spanF, Submodule.span_le]; rintro _ ⟨i, rfl⟩; exact hrV i
  have hu : finrank (ZMod 2) (spanF u) = kU :=
    finrank_of_dual (e := eu) (fun i j => by
      rw [dotProduct_comm, hUE]; by_cases hij : i = j <;> simp [hij, eq_comm])
  have hr : finrank (ZMod 2) (spanF r) = kR := finrank_of_dual (e := r) (fun i j => hRR j i)
  -- every `z ∈ span U` is orthogonal to every `r j`
  have horth : ∀ z ∈ spanF u, ∀ j, r j ⬝ᵥ z = 0 := fun z hz j => dot_span_zero (hRU j) z hz
  have hdisj : spanF u ⊓ spanF r = ⊥ := by
    rw [eq_bot_iff]; intro x ⟨hxu, hxr⟩
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hxr
    have hc : ∀ j, c j = 0 := by
      intro j
      have h1 := horth _ hxu j
      rw [dot_sum] at h1
      simpa [hRR, Finset.sum_ite_eq'] using h1
    simp [hc]
  have hsup : spanF u ⊔ spanF r = SV := by
    apply Submodule.eq_of_le_of_finrank_eq (sup_le hle hRle)
    have := Submodule.finrank_sup_add_finrank_inf_eq (spanF u) (spanF r)
    rw [hdisj, finrank_bot, hu, hr] at this
    omega
  refine ⟨hle, hu, ?_, ?_⟩
  · intro x hx hperp
    apply hV x (hle hx)
    intro y hy
    rw [← hsup] at hy
    obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.1 hy
    rw [dotProduct_add, hperp a ha, zero_add, dotProduct_comm]
    obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).1 hb
    rw [dotProduct_comm, dot_sum]
    simp [dotProduct_comm x, horth x hx]
  · by_cases hk : kR = 0
    · left
      subst hk
      apply Submodule.eq_of_le_of_finrank_eq hle (by rw [hu, hVd, add_zero])
    · right
      refine ⟨r ⟨0, by omega⟩, hrV _, by rw [hRR]; simp, fun z hz => ?_⟩
      rw [dotProduct_comm]; exact horth z hz _

end LA

end R6Chk

