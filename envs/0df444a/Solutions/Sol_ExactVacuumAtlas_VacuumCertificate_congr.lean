open Filter Topology
open scoped ContDiff
open ExactVacuumAtlas
open ExactVacuumAtlas.VacuumCertificate
variable {n : ℕ} {g ginv : Metric (n + 1)} {U : Set (Pt (n + 1))}
theorem solution (h : VacuumCertificate g ginv U) {g' ginv' : Metric (n + 1)}
    (hg : ∀ i j, Set.EqOn (g i j) (g' i j) U) (hgi : ∀ i j, Set.EqOn (ginv i j) (ginv' i j) U) :
    VacuumCertificate g' ginv' U where
  isOpen := h.isOpen
  nonempty := h.nonempty
  symm x hx i j := by rw [← hg i j hx, ← hg j i hx]; exact h.symm x hx i j
  inv x hx := by
    have e1 : metricMatrix g' x = metricMatrix g x := by
      ext i j; simp [metricMatrix, hg i j hx]
    have e2 : metricMatrix ginv' x = metricMatrix ginv x := by
      ext i j; simp [metricMatrix, hgi i j hx]
    rw [e1, e2]; exact h.inv x hx
  smooth i j := (h.smooth i j).congr fun x hx => (hg i j hx).symm
  smooth_inv i j := (h.smooth_inv i j).congr fun x hx => (hgi i j hx).symm
  lorentz x hx := by
    have e1 : metricMatrix g' x = metricMatrix g x := by
      ext i j; simp [metricMatrix, hg i j hx]
    rw [e1]; exact h.lorentz x hx
  ricci_flat x hx b d := by
    rw [← ricciOf_congr_of_eqOn h.isOpen hg hgi hx]
    exact h.ricci_flat x hx b d
