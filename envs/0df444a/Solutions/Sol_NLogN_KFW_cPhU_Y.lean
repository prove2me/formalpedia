-- Source module: Solutions.KFWCost1
/-!
# KFW: cost units of the uniform level procedure

All costs of the level procedure are evaluated at widths in the window `[0, H]` (plus small
offsets and the scale `ES k ≤ H`), so they are bounded by multiples of the **cost unit**

  `Yu r Z H = r (2H + 21) + (Z + 2)³`

(per record).  This file bounds the elementary cost pieces (`cAtom`, `cPhU`, push and move
overheads, `pow2Cost`) by multiples of `n · Yu`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

theorem yu_z (r Z H : ℕ) : (Z + 2) ^ 3 ≤ Yu r Z H := Nat.le_add_left _ _

theorem yu_r (r Z H : ℕ) : r * (2 * H + 21) ≤ Yu r Z H := Nat.le_add_right _ _

theorem yu_z2 (r Z H : ℕ) : (Z + 2) ^ 2 ≤ Yu r Z H := by
  have : (Z + 2) ^ 2 ≤ (Z + 2) ^ 3 := Nat.pow_le_pow_right (by omega) (by omega)
  exact this.trans (yu_z r Z H)

theorem yu_z1 (r Z H : ℕ) : Z + 2 ≤ Yu r Z H := by
  have : Z + 2 ≤ (Z + 2) ^ 2 := by nlinarith
  exact this.trans (yu_z2 r Z H)

theorem yu_8 (r Z H : ℕ) : 8 ≤ Yu r Z H := by
  have : 2 ^ 3 ≤ (Z + 2) ^ 3 := Nat.pow_le_pow_left (by omega) 3
  exact le_trans (by simpa using this) (yu_z r Z H)

/-- **The uniform phase pass** at a width in the window. -/
theorem cPhU_Y_sol_aux {Bn t S0 r Z H x sz : ℕ} (hS : 1 ≤ S0) (hBn : 1 ≤ Bn) (hx : x ≤ 2 * H + 16)
    (εE : Ex HS) (hsz : εE.size ≤ sz) :
    cPhU x (Bn * (S0 * r * 2 ^ t)) t Bn Z (S0 * r) (xPh εE Z Z) ≤
      1000000000 * (sz + 2) * nN Bn t S0 * Yu r Z H := by
  set n := nN Bn t S0 with hn
  have ht : t < 2 ^ t := Nat.lt_two_pow_self
  have h2t : 1 ≤ 2 ^ t := Nat.one_le_two_pow
  have hn1 : 2 ^ t ≤ n := by
    simp only [n, nN]; nlinarith [Nat.mul_le_mul hBn hS]
  have hnB : Bn ≤ n := by simp only [n, nN]; nlinarith [Nat.mul_le_mul h2t hS]
  have hn0 : 1 ≤ n := le_trans h2t hn1
  have hV : Bn * (S0 * r * 2 ^ t) = n * r := by simp only [n, nN]; ring
  have hR : S0 * r * 2 ^ t ≤ n * r := by
    rw [← hV]; exact Nat.le_mul_of_pos_left _ hBn
  have hY1 := yu_r r Z H
  have hY3 := yu_z r Z H
  have hY2 := yu_z2 r Z H
  have hY0 := yu_z1 r Z H
  set Y := Yu r Z H
  have hY8 : 1 ≤ Y := le_trans (by norm_num) (yu_8 r Z H)
  have hnY : 1 ≤ n * Y := by have := Nat.mul_le_mul hn0 hY8; simpa using this
  -- the pieces
  have p1 : cPhL x (Bn * (S0 * r * 2 ^ t)) t Bn Z ≤ 2000000 * n * Y := by
    unfold cPhL cMulB
    rw [hV]
    have a : n * r * (200000 * (x + 5) + 300000 + 500 * x) ≤ 1000000 * n * (r * (2 * H + 21)) := by
      have : 200000 * (x + 5) + 300000 + 500 * x ≤ 1000000 * (2 * H + 21) := by omega
      calc n * r * (200000 * (x + 5) + 300000 + 500 * x) ≤ n * r * (1000000 * (2 * H + 21)) :=
            Nat.mul_le_mul_left _ this
        _ = 1000000 * n * (r * (2 * H + 21)) := by ring
    have b : (t + Bn + 10) * (20000 * (Z + 2) + 30000) ≤ 12 * n * (35000 * (Z + 2)) := by
      exact Nat.mul_le_mul (by omega) (by omega)
    have c : 12 * n * (35000 * (Z + 2)) ≤ 1000000 * n * Y := by
      have : 12 * (35000 * (Z + 2)) ≤ 1000000 * Y := by
        calc 12 * (35000 * (Z + 2)) = 420000 * (Z + 2) := by ring
          _ ≤ 1000000 * (Z + 2) := Nat.mul_le_mul_right _ (by norm_num)
          _ ≤ 1000000 * Y := Nat.mul_le_mul_left _ hY0
      calc 12 * n * (35000 * (Z + 2)) = n * (12 * (35000 * (Z + 2))) := by ring
        _ ≤ n * (1000000 * Y) := Nat.mul_le_mul_left _ this
        _ = 1000000 * n * Y := by ring
    have d : 1000000 * n * (r * (2 * H + 21)) ≤ 1000000 * n * Y := Nat.mul_le_mul_left _ hY1
    have e : 2000000 * n * Y = 1000000 * n * Y + 1000000 * n * Y := by ring
    omega
  have p2 : 120000 * (S0 * r * 2 ^ t) + t * (10000 * (Z + 2) + 20000) ≤ 200000 * n * Y := by
    have a : 120000 * (S0 * r * 2 ^ t) ≤ 120000 * (n * r) := Nat.mul_le_mul_left _ hR
    have a' : n * r ≤ n * Y := Nat.mul_le_mul_left _ (le_trans (by nlinarith) hY1)
    have b : t * (10000 * (Z + 2) + 20000) ≤ n * (30000 * Y) :=
      Nat.mul_le_mul (by omega) (by omega)
    have e1 : 200000 * n * Y = 120000 * (n * Y) + 80000 * (n * Y) := by ring
    have e2 : n * (30000 * Y) = 30000 * (n * Y) := by ring
    omega
  have p3 : xPh εE Z Z ≤ 10000000 * (sz + 2) * Y := by
    unfold xPh
    have a : (εE.size + 1) * 10 ^ 7 * (Z + 2) ^ 2 ≤ (sz + 1) * 10 ^ 7 * Y :=
      Nat.mul_le_mul (Nat.mul_le_mul_right _ (by omega)) hY2
    have e : 10000000 * (sz + 2) * Y = (sz + 1) * 10 ^ 7 * Y + 10 ^ 7 * Y := by ring
    omega
  have p4 : t * xPh εE Z Z ≤ 10000000 * (sz + 2) * n * Y := by
    calc t * xPh εE Z Z ≤ n * (10000000 * (sz + 2) * Y) := Nat.mul_le_mul (by omega) p3
      _ = 10000000 * (sz + 2) * n * Y := by ring
  have p5 : cRep t ≤ 3000 * n * Y := by
    unfold cRep
    have := zsz_natCast_le_self t
    have e : 3000 * n * Y = 3000 * (n * Y) := by ring
    have : t ≤ n * Y := le_trans (by omega) (Nat.le_mul_of_pos_right _ (by omega : 0 < Y))
    omega
  have p6 : 1000 * (Z + 2) + 20000 ≤ 21000 * n * Y := by
    have : Y ≤ n * Y := Nat.le_mul_of_pos_left _ hn0
    have e : 21000 * n * Y = 21000 * (n * Y) := by ring
    omega
  unfold cPhU
  have e : 1000000000 * (sz + 2) * n * Y = 1000000000 * (sz + 2) * (n * Y) := by ring
  have f1 : 400 * cPhL x (Bn * (S0 * r * 2 ^ t)) t Bn Z ≤ 800000000 * (n * Y) := by
    have := Nat.mul_le_mul_left 400 p1
    have e' : 400 * (2000000 * n * Y) = 800000000 * (n * Y) := by ring
    omega
  have f2 : 400 * (120000 * (S0 * r * 2 ^ t) + t * (10000 * (Z + 2) + 20000)) ≤
      80000000 * (n * Y) := by
    have := Nat.mul_le_mul_left 400 p2
    have e' : 400 * (200000 * n * Y) = 80000000 * (n * Y) := by ring
    omega
  have f4 : t * xPh εE Z Z ≤ 10000000 * (sz + 2) * (n * Y) := by
    have e' : 10000000 * (sz + 2) * n * Y = 10000000 * (sz + 2) * (n * Y) := by ring
    omega
  have f5 : cRep t ≤ 3000 * (n * Y) := by
    have e' : 3000 * n * Y = 3000 * (n * Y) := by ring
    omega
  have f6 : 1000 * (Z + 2) + 20000 ≤ 21000 * (n * Y) := by
    have e' : 21000 * n * Y = 21000 * (n * Y) := by ring
    omega
  have hs2 : 1 ≤ sz + 2 := by omega
  have g : 800000000 * (n * Y) + 80000000 * (n * Y) + 10000000 * (sz + 2) * (n * Y) +
      21000 * (n * Y) + 3000 * (n * Y) ≤ 1000000000 * (sz + 2) * (n * Y) := by
    have : 800000000 + 80000000 + 21000 + 3000 ≤ 990000000 * (sz + 2) := by omega
    nlinarith
  rw [e]
  omega

end NLogN.KFW

