      rw [hJf, IntermediateField.coe_inclusion]
    have hjmem : coeffEmb (AlgebraicClosure ℚ) jq ∈
        laurentBaseChange (AlgebraicClosure ℚ) (qExpFunctionFieldC ℚ (Gamma0 M')) := by
      rw [ModularCurve.qExpFunctionFieldC_rat_gamma0_eq_modularFunctionFieldFull]
      exact coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))
    have cmC : ∀ {S : Type} [CommRing S] (f : ↥A →+* S) (a : ↥A), coeffMap f (HahnSeries.C a) = HahnSeries.C (f a) := by
      intro S _ f a; ext n
      rw [coeffMap_coeff, HahnSeries.C_apply, HahnSeries.C_apply, HahnSeries.coeff_single, HahnSeries.coeff_single]
      split_ifs <;> simp
    have hcC : (((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ)) : ↥(fieldBar q M')) :
        LaurentSeries (AlgebraicClosure ℚ)) = HahnSeries.C (c : AlgebraicClosure ℚ) := by
      show HahnSeries.ofPowerSeries ℤ (AlgebraicClosure ℚ) (algebraMap (AlgebraicClosure ℚ) (PowerSeries (AlgebraicClosure ℚ)) (c : AlgebraicClosure ℚ)) = _
      rw [← PowerSeries.C_eq_algebraMap, HahnSeries.ofPowerSeries_C]
    have hζA : (ζ.val : AlgebraicClosure ℚ) ∈ A := by
      have hq0 : q ≠ 0 := (Fact.out : q.Prime).ne_zero
      have hζpow : (ζ.val : AlgebraicClosure ℚ) ^ q = 1 :=
        ((mem_primitiveRoots (Nat.pos_of_ne_zero hq0)).mp ζ.2).pow_eq_one
      rw [← A.valuation_le_one_iff]
      have h : A.valuation ζ.val ^ q = 1 := by rw [← map_pow, hζpow, map_one]
      rcases pow_eq_one_iff.mp h with h | h
      · exact h.le
      · exact absurd h hq0
    have hζunit : IsUnit (⟨ζ.val, hζA⟩ : ↥A) := by
      have hq0 : q ≠ 0 := (Fact.out : q.Prime).ne_zero
      have hζpow : (⟨ζ.val, hζA⟩ : ↥A) ^ q = 1 := by
        apply Subtype.ext; push_cast
        exact ((mem_primitiveRoots (Nat.pos_of_ne_zero hq0)).mp ζ.2).pow_eq_one
      exact IsUnit.of_pow_eq_one hζpow hq0
    have hT : ∃ T : LaurentSeries ↥A, coeffMap A.subtype T =
        ((levelAutBar q M' ζ γ Jf - algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) : ↥(fieldBar q M')) :
          LaurentSeries (AlgebraicClosure ℚ)) ∧ coeffMap (IsLocalRing.residue ↥A) T ≠ 0 := by
      by_cases hdvd : (q : ℤ) ∣ (γ : Matrix (Fin 2) (Fin 2) ℤ) 0 0
      · have hτJ := ModularCurve.FullLevel.coe_levelAutBar_apply_eq_qExpand_sq_of_dvd_of_mem_laurentBaseChange_gamma0
          q M' hqM' ζ γ hγ hdvd _ hjmem Jf hJfcoe
        refine ⟨qExpand (↥A) (q ^ 2) (jqModC ↥A) - HahnSeries.C ⟨(c : AlgebraicClosure ℚ), hcA⟩, ?_, ?_⟩
        · rw [map_sub, ModularCurve.coeffMap_qExpand, hmapA, cmC, AddSubgroupClass.coe_sub, hτJ, hcC]; rfl
        · intro h0
          have h1 := congrArg (fun z : LaurentSeries (ResidueField ↥A) => z.coeff (((q ^ 2 : ℕ) : ℤ) * (-1))) h0
          simp only [map_sub, HahnSeries.coeff_sub, HahnSeries.coeff_zero, ModularCurve.coeffMap_qExpand, cmC,
            qExpand_coeff_mul] at h1
          have h2 : (coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A)).coeff (-1) = 1 := by
            rw [show coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A) = jqModC (ResidueField ↥A) from map_jqModC _,
              coeff_jqModC_neg_one]
          rw [h2, HahnSeries.C_apply, HahnSeries.coeff_single_of_ne] at h1
          · rw [sub_zero] at h1; exact one_ne_zero h1
          · have : (0 : ℤ) < ((q ^ 2 : ℕ) : ℤ) := by positivity
