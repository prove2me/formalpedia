theorem pdMC_add (hA : SmoothOnC A U) (hB : SmoothOnC B U) :
    pdMC i (fun z => A z + B z) y = pdMC i A y + pdMC i B y := by
  ext a b
  simp only [pdMC_apply, Matrix.add_apply]
  exact cpdC_add_of hU hy i (hA a b) (hB a b)

theorem pdMC_sub (hA : SmoothOnC A U) (hB : SmoothOnC B U) :
    pdMC i (fun z => A z - B z) y = pdMC i A y - pdMC i B y := by
  ext a b
  simp only [pdMC_apply, Matrix.sub_apply]
  exact cpdC_sub_of hU hy i (hA a b) (hB a b)

/-- **Product rule.** -/
theorem pdMC_mul (hA : SmoothOnC A U) (hB : SmoothOnC B U) :
    pdMC i (fun z => A z * B z) y = pdMC i A y * B y + A y * pdMC i B y := by
  ext a b
  simp only [pdMC_apply, Matrix.mul_apply, Matrix.add_apply]
  rw [cpdC_sum_of hU hy i Finset.univ (fun c _ => (hA a c).mul (hB c b)), ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun c _ => ?_
  exact cpdC_mul_of hU hy i (hA a c) (hB c b)

theorem pdMC_smul {f : Pt n → ℂ} (hf : ContDiffOn ℝ ∞ f U) (hA : SmoothOnC A U) :
    pdMC i (fun z => f z • A z) y = cpdC i f y • A y + f y • pdMC i A y := by
  ext a b
  simp only [pdMC_apply, Matrix.smul_apply, Matrix.add_apply, smul_eq_mul]
  exact cpdC_mul_of hU hy i hf (hA a b)

theorem pdMC_sum {ι : Type*} (s : Finset ι) {A : ι → Pt n → Matrix (Fin n) (Fin n) ℂ}
    (hA : ∀ e ∈ s, SmoothOnC (A e) U) :
    pdMC i (fun z => ∑ e ∈ s, A e z) y = ∑ e ∈ s, pdMC i (A e) y := by
  ext a b
  simp only [pdMC_apply, Matrix.sum_apply]
  exact cpdC_sum_of hU hy i s fun e he => hA e he a b

theorem pdMC_congr_of_eqOn (h : Set.EqOn A B U) : pdMC i A y = pdMC i B y := by
  ext a b
  simp only [pdMC_apply]
  exact cpdC_congr_of_eqOn hU hy (fun z hz => by rw [h hz]) i

/-- **Symmetry of mixed matrix partials.** -/
theorem pdMC_pdMC_symm (hA : SmoothOnC A U) (c d : Fin n) :
    pdMC c (fun z => pdMC d A z) y = pdMC d (fun z => pdMC c A z) y := by
  ext a b
  simp only [pdMC_apply]
  exact cpdC_cpdC_symm hU (hA a b) hy c d

