open NLogN
open IntMul
variable (n : ℕ)
theorem solution (j E : ℕ) (hjE : j = 0 ∨ 2 ^ j * E = 2 * n) (A B : List ℤ)
    (hA : A.length = 2 ^ j) (hB : B.length = 2 ^ j) :
    NLogN.pmulZ (2 ^ n + 1) (NLogN.difZ (2 ^ n + 1) E j A) (NLogN.difZ (2 ^ n + 1) E j B) =
      NLogN.difZ (2 ^ n + 1) E j (NLogN.cycZ (2 ^ n + 1) (2 ^ j) A B) := by
  have hF : (0 : ℤ) < 2 ^ n + 1 := by positivity
  have la := NLogN.length_difZ (2 ^ n + 1) j E A hA
  have lb := NLogN.length_difZ (2 ^ n + 1) j E B hB
  have lc := NLogN.length_difZ (2 ^ n + 1) j E _ (NLogN.length_cycZ (2 ^ n + 1) (2 ^ j) A B)
  have lp := NLogN.length_pmulZ (2 ^ n + 1) _ _ (la.trans lb.symm)
  apply NLogN.canon_ext (NLogN.canon_pmulZ hF _ _) (NLogN.canon_difZ hF j E _ (NLogN.canon_cycZ hF _ _ _))
    (by rw [lp, la, lc])
  intro r hr
  rw [lp, la] at hr
  obtain ⟨x, hx, hev⟩ := NLogN.difZ_eval n j E hjE r hr
  rw [NLogN.pmulZ_getD _ _ _ r (by rw [la]; exact hr) (la.trans lb.symm), NLogN.cast_emod]
  push_cast
  rw [hev A hA, hev B hB, hev _ (NLogN.length_cycZ _ _ _ _), NLogN.peval_cycZ n _ A B x hx]
end
