@[simp] theorem coeff_section5 (R : Type*) [CommRing R] (r : ℕ) (φ : R⟦X⟧)
    (n : ℕ) :
    (section5 R r φ).coeff n = if n % 5 = r then φ.coeff n else 0 := by
  rw [section5, PowerSeries.coeff_mk]

