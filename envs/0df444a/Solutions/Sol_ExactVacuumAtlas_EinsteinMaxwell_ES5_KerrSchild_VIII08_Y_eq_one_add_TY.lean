/-! ## Additivity of `segV` and `T` -/

theorem segV_add {g h : ℝ → ℝ} (hg : ContinuousOn g (Ici 3)) (hh : ContinuousOn h (Ici 3))
    {t : ℝ} (ht : 3 ≤ t) :
    segV (fun s => g s + h s) t = segV g t + segV h t := by
  unfold segV
  have h1 : IntervalIntegrable (fun u : ℝ => Vfun (3 + (t - 3) * u) * g (3 + (t - 3) * u))
      volume (0:ℝ) 1 :=
    (continuousOn_seg_integrand hg ht).intervalIntegrable_of_Icc (by norm_num)
  have h2 : IntervalIntegrable (fun u : ℝ => Vfun (3 + (t - 3) * u) * h (3 + (t - 3) * u))
      volume (0:ℝ) 1 :=
    (continuousOn_seg_integrand hh ht).intervalIntegrable_of_Icc (by norm_num)
  rw [← intervalIntegral.integral_add h1 h2]
  congr 1
  funext u
  ring

theorem T_add {g h : ℝ → ℝ} (hg : ContinuousOn g (Ici 3)) (hh : ContinuousOn h (Ici 3))
    {R : ℝ} (hR : 3 ≤ R) :
    T (fun s => g s + h s) R = T g R + T h R := by
  have h1 : IntervalIntegrable (fun t : ℝ => t / (t - 1) * segV g t) volume 3 R :=
    ((continuousOn_outer_integrand_Ici hg).mono (fun x hx => hx.1)).intervalIntegrable_of_Icc hR
  have h2 : IntervalIntegrable (fun t : ℝ => t / (t - 1) * segV h t) volume 3 R :=
    ((continuousOn_outer_integrand_Ici hh).mono (fun x hx => hx.1)).intervalIntegrable_of_Icc hR
  unfold T
  rw [← intervalIntegral.integral_add h1 h2]
  refine intervalIntegral.integral_congr (fun t ht => ?_)
  have ht3 : 3 ≤ t := mem_Icc.mp (by simpa [uIcc_of_le hR] using ht) |>.1
  rw [segV_add hg hh ht3]
  ring

