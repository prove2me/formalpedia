theorem zC_congr {T : Type} [CommRing T] (φ : S →+* T) (E' : FakeEllipticCurve Λ N₀ T) (g : E'.A ⟶ u.1.A)
    (hg : FakeEllipticCurve.IsPullbackVia φ u.1 E' g) {U₁ U₂ : (E'.L.schemeKer N).Opens} (h : U₁ = U₂)
    (h₁ : IsClosed (U₁ : Set ↥(E'.L.schemeKer N))) (h₂ : IsClosed (U₂ : Set ↥(E'.L.schemeKer N))) :
    zC D φ E' g hg U₁ h₁ = zC D φ E' g hg U₂ h₂ := by subst h; rfl

theorem law_i {T : Type} [CommRing T] (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K K' : u'.1.ExtraLevel N)
    (h : ∀ {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t u'.1.f),
      CerednikDrinfeld.QM.FactorsThrough K.levK P ↔ CerednikDrinfeld.QM.FactorsThrough K'.levK P) :
    ptZ u D s φ u' hu' K = ptZ u D s φ u' hu' K' := by
  have hU : UK (N := N) φ u' K = UK (N := N) φ u' K' :=
    opens_eq_of_pts u'.1.L N _ _ (fun t P => by rw [← UK_pts (N := N) φ u' K, ← UK_pts (N := N) φ u' K', h t P])
  apply (cancel_mono (Zsub D s).ι).mp
  rw [ptZ_ι, ptZ_ι, zCK, zCK]
  exact zC_congr u D φ u'.1 _ _ hU _ _

theorem law_iv {T : Type} [CommRing T] (φ : S →+* T) (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u') (K K' : u'.1.ExtraLevel N)
    (h : ptZ u D s φ u' hu' K = ptZ u D s φ u' hu' K')
    {TT : Scheme.{0}} (t : TT ⟶ Spec (CommRingCat.of T)) (P : SchemeHomOver t u'.1.f) :
    CerednikDrinfeld.QM.FactorsThrough K.levK P ↔ CerednikDrinfeld.QM.FactorsThrough K'.levK P := by
  have h1 : zCK u D φ u' hu' K = zCK u D φ u' hu' K' := by rw [← ptZ_ι u D s, ← ptZ_ι u D s, h]
  have h2 : z₀ D φ u'.1 hu'.choose (via_of_wfl φ u u' hu') (UK (N := N) φ u' K) (UK_closed (N := N) φ u' K) =
      z₀ D φ u'.1 hu'.choose (via_of_wfl φ u u' hu') (UK (N := N) φ u' K') (UK_closed (N := N) φ u' K') := by
    apply (cancel_mono (Aff.eX D.ζ₀).hom).mp
    exact h1
  have hU : UK (N := N) φ u' K = UK (N := N) φ u' K' := D.h4 T φ _ _ _ _ _ _ _ _ h2
  rw [UK_pts (N := N) φ u' K, UK_pts (N := N) φ u' K', hU]

theorem law_iii (hs : Submodule.span ℤ (s : Set ↥Λ) = ⊤) {T : Type} [CommRing T] (φ : S →+* T)
    (u' : FakeEllipticCurve.WithFullLevel Λ N₀ m T)
    (hu' : FakeEllipticCurve.WithFullLevel.IsPullback φ u u')
    (z : Spec (CommRingCat.of T) ⟶ ↑(Zsub D s)) (hz : z ≫ ζZ D s = Spec.map (CommRingCat.ofHom φ)) :
    ∃ K : u'.1.ExtraLevel N, ptZ u D s φ u' hu' K = z := by
  haveI : IsFinite (u'.1.L.schemeKerStr N) := isFinite_ker _ N (isUnit_map (S := S) (N := N) φ)
  haveI : Etale (u'.1.L.schemeKerStr N) := etale_ker _ N (isUnit_map (S := S) (N := N) φ)
  set g₁ := hu'.choose
  have via₁ := via_of_wfl φ u u' hu'
  set zc := z ≫ (Zsub D s).ι
  set z0 := zc ≫ (Aff.eX D.ζ₀).inv
  have hz0 : z0 ≫ D.ζ₀ = Spec.map (CommRingCat.ofHom φ) := by
    rw [Category.assoc, Aff.eX_inv_p]; exact hz
  obtain ⟨U, hUc, hU⟩ := D.h3 T φ _ (u'.1.L.schemeKerStr N) (kN φ u.1 u'.1 g₁ via₁ N) (kN_isPullback φ u.1 u'.1 g₁ via₁ N)
    z0 hz0

  have hzC : zC D φ u'.1 g₁ via₁ U hUc = zc := by
    show z₀ D φ u'.1 g₁ via₁ U hUc ≫ (Aff.eX D.ζ₀).hom = zc
    rw [show z₀ D φ u'.1 g₁ via₁ U hUc = z0 from hU, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hadm : ∀ t : ↥(Spec (CommRingCat.of T)), t ∈ admOf (N := N) u'.1 s U (VC (N := N) u'.1 (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ)) := by
    intro t
    rw [← admSet_preimage D φ u'.1 g₁ via₁ s U hUc t, spec_θ, hzC, Scheme.Hom.comp_apply]
    have : ((Zsub D s).ι) (z t) ∈ Set.range ((Zsub D s).ι) := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  obtain ⟨K, hK⟩ := extraLevel_of_adm u'.1 (isUnit_map (S := S) (N := N) φ) s (isUnit_mapM (S := S) (N := N) (N₀ := N₀) φ) hs U hUc hadm
  refine ⟨K, ?_⟩
  have hUK : UK (N := N) φ u' K = U :=
    opens_eq_of_pts u'.1.L N _ _ (fun t P => by rw [← UK_pts (N := N) φ u' K, hK t P])
  apply (cancel_mono (Zsub D s).ι).mp
  rw [ptZ_ι, zCK, zC_congr u D φ u'.1 g₁ via₁ hUK (UK_closed (N := N) φ u' K) hUc, hzC]

end Final
