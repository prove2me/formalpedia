  let colors : PolyProgram _root_.Integration9_9.TM2NativeBodyKernel.contextCode _root_.Integration9_9.TM2NativeFiniteSeries.ticksCode (fun x : _root_.Integration9_9.TM2NativeBodyKernel.Context => x.1.1) :=
    (show Poly (fun x : _root_.Integration9_9.TM2NativeBodyKernel.Context => x.1.1) by fun_prop).program
  let indices := colors.comp (PolyProgram.listIndices _root_.Integration9_9.TM2NativeFiniteSeries.unitCode ())
  exact ((((PolyProgram.identity _root_.Integration9_9.TM2NativeBodyKernel.contextCode).fanout indices).comp (_root_.Integration9_9.TM2NativeBodyKernel.term_poly.program.listMapWith 0 (0 : ℚ))).comp PolyProgram.ratSum)

