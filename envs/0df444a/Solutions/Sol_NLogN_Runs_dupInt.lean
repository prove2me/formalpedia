variable {S P : ℕ} {I : List Sym} {prog : Fin P → Stmt S P}

theorem hdOf_sel (z : ℤ) : (if some (hdOf z) = some hdNeg then hdNeg else hdPos) = hdOf z := by
  unfold hdOf; split_ifs <;> simp_all [hdNeg, hdPos]

end NLogN

