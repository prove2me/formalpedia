/-!
# Binary quotient for physical output indices

The existing checked doubling table is reused. During descending
subtraction this routine also accumulates the quotient bits, so its time
is logarithmic in the numerator rather than linear in the quotient.
-/

namespace ThreeSum.LightOutputDecodeDivide

open Light Light.Emod

set_option maxHeartbeats 1800000
set_option maxRecDepth 7000
























variable {lim : Limits} {P : Program} {d : ℕ} {μ ν : ℕ → ℤ} {a Mo V fr : ℕ}












































































theorem time_le_budget {a Mo V : ℕ} (ha : a ≤ V) : time a Mo ≤ budget V := by
  have hh := emodRounds_le ha (M := Mo)
  unfold time budget
  omega

theorem bounded_meets {pMain : ℕ} (hmain : P[pMain]? = some body)
    (F : Pre lim Mo V fr) (haV : a ≤ V) :
    Meets lim P pMain d [a,Mo,fr] μ (budget V)
      (fun q ν => q = ((a/Mo : ℕ) : ℤ) ∧ Kept μ ν fr) :=
  (meets hmain F haV).mono_time (time_le_budget haV)







end ThreeSum.LightOutputDecodeDivide

end

section


/-!
# Actual big-endian radix digit arrays

The running quotient is divided by the radix once per coordinate, using
the checked binary quotient routine. Digits are written backwards into a
forward-order array. This works for an arbitrary positive radix, including
the occurrence-only radix used by the shared source catalog.
-/

namespace ThreeSum.LightOutputDecodeDigits

open Light

set_option maxHeartbeats 1800000
set_option maxRecDepth 7000




















variable {lim : Limits} {P : Program} {d : ℕ} {μ : ℕ → ℤ}
    {k J m dst work V : ℕ}

theorem meets_sourceProof {pMain pDivide : ℕ}
    (hmain : P[pMain]?=some (body pDivide))
    (hdivide : P[pDivide]?=some LightOutputDecodeDivide.body)
    (hw : (lim.space : ℤ) ≤ lim.word) (hd : d+1 < lim.depth)
    (hm : 1 ≤ m) (hk : k ≤ V) (hsep : dst+J ≤ work)
    (hspace : space work V ≤ lim.space)
    (hword : (word V m J : ℤ) ≤ lim.word) :
    Meets lim P pMain d [k,J,m,dst,work] μ (time J V)
      (fun r ν => r=((k/m^J : ℕ) : ℤ) ∧
        (∀ j < J, ν (dst+j)=((OutputDecodeOrder.indices m J k).getD j 0 : ℤ)) ∧
        Kept μ ν dst) := by
  have hbudget (x : ℕ) (hx : x ≤ word V m J) : (x : ℤ) ≤ lim.word :=
    (Int.ofNat_le.mpr hx).trans hword
