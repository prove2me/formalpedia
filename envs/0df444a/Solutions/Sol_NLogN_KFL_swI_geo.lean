/-- Digits of `decode sh8`. -/
theorem decode_getD (g : Geo) (hg : g.Pos) {j : ℕ} (hj : j < g.V) (k : ℕ) (hk : k < 8) :
    (decode g.sh8 j).getD k 0 = j / vol (g.sh8.drop (k + 1)) % g.sh8.getD k 0 := by
