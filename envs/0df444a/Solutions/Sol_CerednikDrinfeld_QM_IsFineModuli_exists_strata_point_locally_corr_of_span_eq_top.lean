abbrev I (T : Type) [CommRing T] [Algebra C T] : Ideal T := Ideal.span {algebraMap C T ϖ}

theorem I_le_comap : I ϖ A ≤ (I ϖ S).comap (algebraMap A S) := by
  rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, ← IsScalarTower.algebraMap_apply]
  exact Ideal.subset_span rfl

abbrev algebraQuot : Algebra (A ⧸ I ϖ A) (S ⧸ I ϖ S) :=
  (Ideal.quotientMap (I ϖ S) (algebraMap A S) (I_le_comap ϖ A S)).toAlgebra

theorem algebraMap_quot_comp_mk :
    letI := algebraQuot ϖ A S
    (algebraMap (A ⧸ I ϖ A) (S ⧸ I ϖ S)).comp (Ideal.Quotient.mk (I ϖ A)) = (Ideal.Quotient.mk (I ϖ S)).comp (algebraMap A S) :=
  Ideal.quotientMap_comp_mk _

theorem isScalarTower_quot : letI := algebraQuot ϖ A S; IsScalarTower C (A ⧸ I ϖ A) (S ⧸ I ϖ S) := by
  letI := algebraQuot ϖ A S
  refine IsScalarTower.of_algebraMap_eq (fun c => ?_)
  show algebraMap C (S ⧸ I ϖ S) c = Ideal.quotientMap (I ϖ S) (algebraMap A S) (I_le_comap ϖ A S) (algebraMap C (A ⧸ I ϖ A) c)
  rw [← Ideal.Quotient.mk_algebraMap, ← Ideal.Quotient.mk_algebraMap, Ideal.quotientMap_mk, IsScalarTower.algebraMap_apply C A S]

theorem away_quot (s : A) [IsLocalization.Away s S] :
    letI := algebraQuot ϖ A S; IsLocalization.Away (Ideal.Quotient.mk (I ϖ A) s) (S ⧸ I ϖ S) := by
  letI := algebraQuot ϖ A S
  have h : IsLocalization ((Submonoid.powers s).map (Ideal.Quotient.mk (I ϖ A))) (S ⧸ I ϖ S) :=
    IsLocalization.of_surjective (Submonoid.powers s) S (Ideal.Quotient.mk (I ϖ A)) Ideal.Quotient.mk_surjective
      (Ideal.Quotient.mk (I ϖ S)) Ideal.Quotient.mk_surjective (algebraMap_quot_comp_mk ϖ A S).symm
      (by rw [Ideal.mk_ker, Ideal.mk_ker, Ideal.map_span, Set.image_singleton, ← IsScalarTower.algebraMap_apply])
  rwa [Submonoid.map_powers] at h

