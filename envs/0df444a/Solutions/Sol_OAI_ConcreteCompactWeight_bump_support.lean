namespace OAI.ConcreteCompactWeight
theorem _root_.solution (y : ℝ) (hy : y ≤ 1 ∨ 2 ≤ y) : bump y = 0 := by
  change bumpData y = 0
  apply bumpData.zero_of_le_dist
  rw [Real.dist_eq]
  change (1 / 4 : ℝ) ≤ |y - 3 / 2|
  rcases hy with h | h
  · rw [abs_of_nonpos (by linarith)]
    linarith
  · rw [abs_of_nonneg (by linarith)]
    linarith
end OAI.ConcreteCompactWeight
