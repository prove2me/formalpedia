theorem _root_.solution (f : ℕ → Option ℕ) (l : List ℕ) :
    l.foldr (fun a o => o.bind fun v => (f a).map (max v)) (some 0) =
      if (l.map f).all (fun o => o.isSome) then some (((l.map f).map fun o => o.getD 0).foldr max 0) else none := by
