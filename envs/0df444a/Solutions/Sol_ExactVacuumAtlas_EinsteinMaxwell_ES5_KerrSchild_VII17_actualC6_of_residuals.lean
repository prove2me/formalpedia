open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.VII13FiniteBranchSpec
theorem solution
    {s h Q J ε : ℝ} (hε : 0 < ε)
    {I : Set ℝ} {f m N w p a : ℝ → ℝ}
    (hP : PaperData I f m N w p a)
    (hN : FactorizedN I N s h)
    (hB : PaperBVP I f m N w p a Q J)
    (htail : Set.Ioi (s + ε⁻¹) ⊆ I)
    {f₁ b₁ a₁ C_F C_b C_A : ℝ}
    (hCF : 0 ≤ C_F) (hCb : 0 ≤ C_b) (hCA : 0 ≤ C_A)
    (hvalF : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pull  s f x - (1 + f₁ * x)| ≤ C_F * x ^ 2)
    (hvalb : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pullM s m x - (1 + b₁ * x)| ≤ C_b * x ^ 2)
    (hvalA : ∀ x ∈ Set.Ioo (0:ℝ) ε, |pull  s a x - a₁ * x|       ≤ C_A * x ^ 2) :
    ∃ η, 0 < η ∧ η ≤ ε ∧ ∃ Fe be Ae : ℝ → ℝ, FiniteBranch6 I s η f m a Fe be Ae := by
  obtain ⟨dF, db, dA, rel⟩ :=
    VII16R.actualL1_of_residuals hε hP hN hB htail hCF hCb hCA hvalF hvalb hvalA
  have hsubI : Ioo (0:ℝ) ε ⊆ {y | y ≠ 0 ∧ s + y⁻¹ ∈ I} := by
    intro x hx
    refine ⟨hx.1.ne', htail ?_⟩
    show s + ε⁻¹ < s + x⁻¹
    linarith [(inv_lt_inv₀ hε hx.1).mpr hx.2]
  have evR : ∀ {P : ℝ → Prop}, (∀ x ∈ Ioo (0:ℝ) ε, P x) → ∀ᶠ x in 𝓝[>] (0:ℝ), P x :=
    fun H => by filter_upwards [VII16.Ioo_mem_nhdsGT' hε] with x hx using H x hx
  have psOf : ∀ {g : ℝ → ℝ}, ContDiffOn ℝ ∞ g {y | y ≠ 0 ∧ s + y⁻¹ ∈ I} → PS g :=
    fun hc => evR fun x hx => (hc.mono hsubI).contDiffAt (isOpen_Ioo.mem_nhds hx)
  have hR := vii04_compactified_bridge_Ioo hP hN hB hε htail
  have S : Std h Q J f₁ b₁ a₁ (pull s f) (pullM s m) (pull s a) :=
    { cF := psOf (contDiffOn_pull (I := I) (s := s) hP.cf)
      cb := psOf (contDiffOn_pullM (I := I) (s := s) hP.cm)
      cA := psOf (contDiffOn_pull (I := I) (s := s) hP.ca)
      hPF := evR fun x hx => (hR x hx).1
      hPA := evR fun x hx => (hR x hx).2.2.1
      hPC := evR fun x hx => (hR x hx).2.2.2.1
      tF := VII16R.k0_value hε hvalF
      tb := VII16R.k0_value hε hvalb
      tA := VII16R.k0_value (c₁ := a₁) (C := C_A) hε fun x hx => by
        rw [zero_add]; exact hvalA x hx
      dF := dF, db := db, dA := dA, rel := rel }
  obtain ⟨eF, eb, eA⟩ := S.c6
  obtain ⟨GF, δF, hδF, cF, mF, vF⟩ := eF.local
  obtain ⟨Gb, δb, hδb, cb, mb, vb⟩ := eb.local
  obtain ⟨GA, δA, hδA, cA, mA, vA⟩ := eA.local
  set η := min (min δF δb) (min δA ε) with hη
  have hη0 : 0 < η := lt_min (lt_min hδF hδb) (lt_min hδA hε)
  have hηF : η ≤ δF := (min_le_left _ _).trans (min_le_left _ _)
  have hηb : η ≤ δb := (min_le_left _ _).trans (min_le_right _ _)
  have hηA : η ≤ δA := (min_le_right _ _).trans (min_le_left _ _)
  have hηε : η ≤ ε := (min_le_right _ _).trans (min_le_right _ _)
  have sub : ∀ {δ}, η ≤ δ → Ioo (-η) η ⊆ Ioo (-δ) δ := fun h =>
    Ioo_subset_Ioo (neg_le_neg h) h
  have subP : ∀ {δ}, η ≤ δ → Ioo 0 η ⊆ Ioo 0 δ := fun h => Ioo_subset_Ioo le_rfl h
  refine ⟨η, hη0, hηε, GF, Gb, GA, ?_⟩
  exact
    { eps_pos := hη0
      chart_tail := fun x hx => htail (show s + ε⁻¹ < x by
        have h1 := inv_anti₀ hη0 hηε
        have h2 : s + η⁻¹ < x := hx
        linarith)
      cF := by exact_mod_cast cF.mono (sub hηF)
      cb := by exact_mod_cast cb.mono (sub hηb)
      cA := by exact_mod_cast cA.mono (sub hηA)
      matchF := mF.mono (subP hηF)
      matchb := mb.mono (subP hηb)
      matchA := mA.mono (subP hηA)
      F0 := vF, b0 := vb, A0 := vA }
