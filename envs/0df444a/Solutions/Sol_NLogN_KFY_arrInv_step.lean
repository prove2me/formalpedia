theorem disc_getD {p : ℕ} {L : List GI} (h : DiscL p L) (x : ℕ) : ‖gC (L.getD x (0, 0))‖ ≤ 2 ^ p := by
  rcases getD_mem_or L x (0, 0) with h1 | h1
  · exact h _ h1
  · rw [h1]; simp [gC]

theorem discL_transposeL {p : ℕ} (n m : ℕ) {L : List GI} (h : DiscL p L) :
    DiscL p (transposeL n m L) := by
  intro z hz
  simp only [transposeL, List.mem_map, List.mem_range] at hz
  obtain ⟨q, -, rfl⟩ := hz
  exact disc_getD h _

theorem discL_stepL {p : ℕ} (n m : ℕ) (f : List GI → List GI)
    (hf : ∀ X, DiscL p X → DiscL p (f X)) {L : List GI} (hL : DiscL p L) :
    DiscL p ((chunkL n (transposeL n m L)).flatMap f) := by
  intro z hz
  simp only [List.mem_flatMap] at hz
  obtain ⟨X, hX, hz⟩ := hz
  refine hf X ?_ z hz
  intro y hy
  simp only [chunkL, List.mem_map, List.mem_range] at hX
  obtain ⟨i, -, rfl⟩ := hX
  exact discL_transposeL n m hL y (List.mem_of_mem_drop (List.mem_of_mem_take hy))

