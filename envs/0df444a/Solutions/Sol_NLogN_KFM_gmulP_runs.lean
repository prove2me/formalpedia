section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000
open NLogN
open NLogN.KFM
open IntMul KFC KFB KFT KIL
variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt HS P}
theorem solution {M : NLogN.MulSpec} {pM : Fin P} (hM : NLogN.MulOK I iprog pM M)
    (hdom : ∀ x y, M.dom x y) {w φ : ℕ} (hΦ : ∀ x y : ℤ, NLogN.zsz x ≤ w → NLogN.zsz y ≤ w → M.Φ x y ≤ φ)
    (Δ : ℕ) (s : NLogN.IState NLogN.HS) (zs ts : List NLogN.KFB.GI) (R0 RW LR : List NLogN.Item) (hlen : ts.length = zs.length)
    (h0 : s.G 0 = NLogN.ints (NLogN.KFB.gflat zs) ++ R0) (hW : s.G NLogN.KFM.pW = NLogN.ints (NLogN.KFB.gflat ts) ++ RW)
    (hR : s.G NLogN.KFM.pR = .int (2 ^ Δ) :: LR) (hz : NLogN.KFB.GB w zs) (ht : NLogN.KFB.GB w ts) :
    NLogN.IRuns I iprog (NLogN.KFM.gmulP pM zs.length) s
      ((s.upd 0 (NLogN.ints (NLogN.KFB.gflat (List.zipWith (NLogN.KFM.gmulT Δ) zs ts)) ++ R0)).upd NLogN.KFM.pW RW)
      (NLogN.KFM.cGmul zs.length w Δ φ) := by
  set N := zs.length with hN
  set us := List.zipWith (NLogN.KFM.gmulT Δ) zs ts with hus
  have hul : us.length = N := by rw [hus, List.length_zipWith, hlen, min_self]
  let T : ℕ → NLogN.IState HS := fun k =>
    ((s.upd 0 (NLogN.ints (NLogN.KFB.gflat (zs.drop k)) ++ R0)).upd NLogN.KFM.pW (NLogN.ints (NLogN.KFB.gflat (ts.drop k)) ++ RW)).upd NLogN.KFM.pO
      (NLogN.ints (NLogN.KFB.gflat (us.take k)).reverse ++ s.G NLogN.KFM.pO)
  have h1 := NLogN.KFT.rpt_runs (I := I) (iprog := iprog) (A := NLogN.KFM.pA) (C := NLogN.KFM.pC) (D := NLogN.KFM.pD) (by decide)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) N T
    (fun k => by simp +decide [T]) (fun k => by simp +decide [T]) (fun k => by simp +decide [T])
    (NLogN.KFM.entryB pM) (4 * φ + 100000 * (w + Δ + 1))
    (by
      intro k hk LA LC LD
      have hkt : k < ts.length := by omega
      have hku : k < us.length := by omega
      have hdz : zs.drop k = zs[k] :: zs.drop (k + 1) := List.drop_eq_getElem_cons hk
      have hdt : ts.drop k = ts[k] :: ts.drop (k + 1) := List.drop_eq_getElem_cons hkt
      have huk : us[k] = NLogN.KFM.gmulT Δ zs[k] ts[k] := by simp [hus]
      have H := NLogN.KFM.entry_runs (I := I) (iprog := iprog) hM hdom hΦ Δ (NLogN.KFT.cf3 (T k) NLogN.KFM.pA NLogN.KFM.pC NLogN.KFM.pD LA LC LD)
        zs[k] ts[k] (NLogN.ints (NLogN.KFB.gflat (zs.drop (k + 1))) ++ R0) (NLogN.ints (NLogN.KFB.gflat (ts.drop (k + 1))) ++ RW)
        LR (by simp +decide only [T, NLogN.KFT.cf3, NLogN.IState.upd_G, if_true, if_false]; rw [hdz, NLogN.KFB.gflat_cons]; simp [NLogN.ints])
        (by simp +decide only [T, NLogN.KFT.cf3, NLogN.IState.upd_G, if_true, if_false]; rw [hdt, NLogN.KFB.gflat_cons]; simp [NLogN.ints])
        (by simp +decide [T, NLogN.KFT.cf3, hR]) (hz _ (List.getElem_mem hk)) (ht _ (List.getElem_mem hkt))
      refine H.mono' ?_ le_rfl
      have htk : us.take (k + 1) = us.take k ++ [us[k]] := by
        rw [List.take_add_one, List.getElem?_eq_getElem hku]; rfl
      have e2 : NLogN.ints (NLogN.KFB.gflat (us.take (k + 1))).reverse =
          .int (NLogN.KFM.gmulT Δ zs[k] ts[k]).2 :: .int (NLogN.KFM.gmulT Δ zs[k] ts[k]).1 ::
            NLogN.ints (NLogN.KFB.gflat (us.take k)).reverse := by
        rw [htk, NLogN.KFB.gflat_append, List.reverse_append, huk]; simp [NLogN.ints]
      simp only [T, NLogN.KFT.cf3, e2]
      clear H e2 htk hdz hdt huk
      ((apply NLogN.IState.ext' <;> intros <;>
               simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
             split_ifs <;>
           simp_all +decide)))
  have e0 : T 0 = s := by
    simp only [T, List.drop_zero, List.take_zero, NLogN.KFB.gflat_nil, List.reverse_nil]
    rw [← h0, ← hW]; simp [NLogN.ints]
  have e1 : T N = ((s.upd 0 R0).upd NLogN.KFM.pW RW).upd NLogN.KFM.pO (NLogN.ints (NLogN.KFB.gflat us).reverse ++ s.G NLogN.KFM.pO) := by
    simp only [T, hN, List.drop_length, List.take_of_length_le (le_of_eq hul),
      List.take_of_length_le (show us.length ≤ zs.length by omega),
      List.drop_eq_nil_of_le (show ts.length ≤ zs.length by omega)]; simp [NLogN.ints]
  rw [e0, e1] at h1
  have hB : ∀ x ∈ (NLogN.KFB.gflat us).reverse, NLogN.zsz x ≤ 4 * w + 1 := by
    intro x hx
    obtain ⟨u, hu, rfl | rfl⟩ := NLogN.KFB.mem_gflat.1 (List.mem_reverse.1 hx) <;>
    · obtain ⟨j, hj, rfl⟩ := List.getElem_of_mem hu
      have hj' : j < zs.length := by rw [← hN, ← hul]; exact hj
      have hj'' : j < ts.length := by rw [hlen, ← hul]; exact hj
      have := NLogN.KFM.zsz_gmulT_le (Δ := Δ) (hz _ (List.getElem_mem hj')) (ht _ (List.getElem_mem hj''))
      simp only [hus, List.getElem_zipWith]
      omega
  have h2 := NLogN.KFM.mvBack_runs (I := I) (iprog := iprog) (NLogN.KFB.gflat us).reverse (4 * w + 1) hB
    (((s.upd 0 R0).upd NLogN.KFM.pW RW).upd NLogN.KFM.pO (NLogN.ints (NLogN.KFB.gflat us).reverse ++ s.G NLogN.KFM.pO)) (s.G NLogN.KFM.pO) (by simp)
  rw [List.length_reverse, NLogN.KFB.length_gflat, hul, List.reverse_reverse] at h2
  refine (h1.seq h2).mono' ?_ ?_
  · simp only [NLogN.IState.upd_G]
    ((apply NLogN.IState.ext' <;> intros <;>
             simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;>
           split_ifs <;>
         simp_all +decide))
  · rw [show 4 * w + 1 + 1 = 4 * w + 2 from rfl]
    unfold NLogN.KFM.cGmul; omega
end
