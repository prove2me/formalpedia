/-!
# The logical effect of the global chunk program

With all temporaries starting at zero (`Λ0 (inr _) = 0`), the logical state after `CH` is, on
the data roles, `X(a,b) ↦ Y0(a,b)`, `Y(a,b) ↦ X0(a,b)`, `A ↦ A0` (`ΛF_X`, `ΛF_Y`, `ΛF_A1`, `ΛF_A2`):
stage one adds `X` to `Y`, stage two subtracts `Y` from `X`, the corrections fix the signs.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace IntMul.Kappa.R6.Cx.NetG

attribute [local irreducible] G1 G2 cs1 cs2 E4mv S1 E4s S2 KK PL

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8 NetF2 NetT NetLoc
  NetSpec NetBT NetFast NetMask NetData NetEff NetSeg NetScal NetFr NetRaw

variable {Vt : Type*} [AddCommGroup Vt] [Module ℂ Vt]

lemma progOps_nil' : progOps ([] : List (GChunk Rl 576)) = [] := rfl
lemma runOps_nil' (Λ : Rl → Vt) : runOps ([] : List (GOp Rl)) Λ = Λ := rfl

/-! ## Stage one -/

variable (Λ0 : Rl → Vt) (htemp : ∀ n, Λ0 (Sum.inr n) = 0)
include htemp

lemma L1_zero : L1 Λ0 0 Λ0 :=
  ⟨fun b _ S _ => by rw [if_neg (Nat.not_lt_zero b), add_zero], fun _ _ _ _ => rfl,
    fun _ _ _ _ => rfl, fun _ _ _ _ _ => htemp _, fun _ _ => rfl⟩

omit htemp in
lemma L1_step {k : ℕ} (hk : k < NV) {Λ : Rl → Vt} (h : L1 Λ0 k Λ) :
    L1 Λ0 (k + 1) (runOps (progOps (G1 k)) Λ) := by
  obtain ⟨n1, n2, n3, n4⟩ := log1 hk Λ (h.2.2.2.1 k hk le_rfl)
  have off : ∀ b < NV, b ≠ k → ∀ w < NL, runOps (progOps (G1 k)) Λ (ι1 b w) = Λ (ι1 b w) :=
    fun b hb hbk w hw => n4 _ (fun w' hw' e => hbk (ι1_eq hk hb hw' hw e).1.symm)
  refine ⟨fun b hb S hS => ?_, fun b hb t ht => ?_, fun b hb q hq => ?_, fun b hb hkb j hj => ?_,
    fun r hr => ?_⟩
  · by_cases hbk : b = k
    · subst hbk
      rw [n1 S hS, h.1 b hb S hS, h.2.1 b hb S hS, if_neg (lt_irrefl b), if_pos (Nat.lt_succ_self b),
        add_zero]
    · rw [← ι1_y hS, off b hb hbk _ (by simp only [yw_eq, NL, NV] at *; omega), ι1_y hS, h.1 b hb S hS]
      by_cases hlt : b < k
      · rw [if_pos hlt, if_pos (by omega)]
      · rw [if_neg hlt, if_neg (by omega)]
  · by_cases hbk : b = k
    · subst hbk; rw [n3 t ht, h.2.1 b hb t ht]
    · rw [← ι1_x ht, off b hb hbk _ (by simp only [xw, NL, NV] at *; omega), ι1_x ht, h.2.1 b hb t ht]
  · by_cases hbk : b = k
    · subst hbk; rw [n2 q hq, h.2.2.1 b hb q hq]
    · rw [← ι1_a hq, off b hb hbk _ (by simp only [aw_eq, NL, NV, NR] at *; omega), ι1_a hq,
        h.2.2.1 b hb q hq]
  · rw [← ι1_m, off b hb (by omega) _ (by rw [mw_eq]; simp only [NL, NV, NR] at *; omega), ι1_m,
      h.2.2.2.1 b hb (by omega) j hj]
  · rw [n4 r (fun w hw => hr k hk w hw), h.2.2.2.2 r hr]

theorem S1_log : ∀ k ≤ NV, L1 Λ0 k (runOps (progOps ((List.range k).flatMap G1)) Λ0)
  | 0, _ => by rw [List.range_zero, List.flatMap_nil, progOps_nil', runOps_nil']; exact L1_zero Λ0 htemp
  | k + 1, hk => by
    rw [range_succ_flatMap, progOps_append, runOps_append]
    exact L1_step Λ0 (by omega) (S1_log k (by omega))

lemma Λ1_L1 : L1 Λ0 NV (Λ1 Λ0) := by
  unfold Λ1 S1; exact S1_log Λ0 htemp NV le_rfl

omit htemp in
lemma progOps_E4s : progOps E4s = [] := by
  unfold E4s
  rw [progOps, List.flatMap_map]
  exact List.flatMap_eq_nil_iff.2 (fun _ _ => rfl)

/-! ## Stage two -/

lemma L2_zero : L2 (Λ1 Λ0) 0 (Λ1 Λ0) := by
  refine ⟨fun a _ S _ => by rw [if_neg (Nat.not_lt_zero a), sub_zero], fun _ _ _ _ => rfl,
    fun _ _ _ _ => rfl, fun a ha _ j hj => ?_, fun _ _ => rfl⟩
  have hw : mw j < NL := by rw [mw_eq]; simp only [NL, NV, NR] at *; omega
  rw [← ι2_m, (Λ1_L1 Λ0 htemp).2.2.2.2 _ (fun b hb w hw' => ι1_ne_ι2 hb hw' ha hw
    (by rw [mw_eq]; omega)), ι2_m]
  exact htemp _

omit htemp in
lemma L2_step (Λa : Rl → Vt) {k : ℕ} (hk : k < NV) {Λ : Rl → Vt} (h : L2 Λa k Λ) :
    L2 Λa (k + 1) (runOps (progOps (G2 k)) Λ) := by
  obtain ⟨n1, n2, n3, n4⟩ := log2 hk Λ (h.2.2.2.1 k hk le_rfl)
  have off : ∀ a < NV, a ≠ k → ∀ w < NL, runOps (progOps (G2 k)) Λ (ι2 a w) = Λ (ι2 a w) :=
    fun a ha hak w hw => n4 _ (fun w' hw' e => hak (ι2_eq hk ha hw' hw e).1.symm)
  refine ⟨fun a ha S hS => ?_, fun a ha t ht => ?_, fun a ha q hq => ?_, fun a ha hka j hj => ?_,
    fun r hr => ?_⟩
  · by_cases hak : a = k
    · subst hak
      rw [n1 S hS, h.1 a ha S hS, h.2.1 a ha S hS, if_neg (lt_irrefl a), if_pos (Nat.lt_succ_self a),
        sub_zero]
    · rw [← ι2_y hS, off a ha hak _ (by simp only [yw_eq, NL, NV] at *; omega), ι2_y hS, h.1 a ha S hS]
      by_cases hlt : a < k
      · rw [if_pos hlt, if_pos (by omega)]
      · rw [if_neg hlt, if_neg (by omega)]
  · by_cases hak : a = k
    · subst hak; rw [n3 t ht, h.2.1 a ha t ht]
    · rw [← ι2_x ht, off a ha hak _ (by simp only [xw, NL, NV] at *; omega), ι2_x ht, h.2.1 a ha t ht]
  · by_cases hak : a = k
    · subst hak; rw [n2 q hq, h.2.2.1 a ha q hq]
    · rw [← ι2_a hq, off a ha hak _ (by simp only [aw_eq, NL, NV, NR] at *; omega), ι2_a hq,
        h.2.2.1 a ha q hq]
  · rw [← ι2_m, off a ha (by omega) _ (by rw [mw_eq]; simp only [NL, NV, NR] at *; omega), ι2_m,
      h.2.2.2.1 a ha (by omega) j hj]
  · rw [n4 r (fun w hw => hr k hk w hw), h.2.2.2.2 r hr]

omit htemp in
theorem S2_log (Λa : Rl → Vt) (h0 : L2 Λa 0 Λa) :
    ∀ k ≤ NV, L2 Λa k (runOps (progOps ((List.range k).flatMap G2)) Λa)
  | 0, _ => by rw [List.range_zero, List.flatMap_nil, progOps_nil', runOps_nil']; exact h0
  | k + 1, hk => by
    rw [range_succ_flatMap, progOps_append, runOps_append]
    exact L2_step Λa (by omega) (S2_log Λa h0 k (by omega))

lemma Λ2_L2 : L2 (Λ1 Λ0) NV (Λ2 Λ0) := by
  unfold Λ2 S2; exact S2_log (Λ1 Λ0) (L2_zero Λ0 htemp) NV le_rfl

/-! ## Corrections -/

/-! ## The final logical state on the data roles -/

omit htemp in
lemma ΛF_eq : ΛF Λ0 = runOps (progOps (PL.flatMap K)) (Λ2 Λ0) := by
  unfold ΛF Λ2 Λ1
  rw [CH, progOps_append, progOps_append, progOps_append, progOps_E4s, List.append_nil, runOps_append,
    runOps_append, KK]

lemma Λ2_τ {a b : ℕ} (ha : a < NV) (hb : b < NV) : Λ2 Λ0 (τr a b) = 0 := by
  rw [(Λ2_L2 Λ0 htemp).2.2.2.2 _ (fun a' ha' w hw => ι2_ne_τ ha' hw ha hb),
    (Λ1_L1 Λ0 htemp).2.2.2.2 _ (fun b' hb' w hw => ι1_ne_τ hb' hw ha hb)]
  exact htemp _

lemma KK_fin : ∀ p ∈ PL, (Λ2 Λ0) (τr p.1 p.2) = 0 := fun p hp =>
  Λ2_τ Λ0 htemp (mem_PL.1 hp).1 (mem_PL.1 hp).2

theorem ΛF_X {a b : ℕ} (ha : a < NV) (hb : b < NV) : ΛF Λ0 (Xr a b) = Λ0 (Yr a b) := by
  rw [ΛF_eq, (KK_log PL PL_nodup (fun p hp => mem_PL.1 hp) _ (KK_fin Λ0 htemp)).1 (a, b)
    (mem_PL.2 ⟨ha, hb⟩), (Λ2_L2 Λ0 htemp).1 a ha b hb, if_pos ha, (Λ1_L1 Λ0 htemp).1 b hb a ha,
    (Λ1_L1 Λ0 htemp).2.1 b hb a ha, if_pos hb]
  abel

theorem ΛF_Y {a b : ℕ} (ha : a < NV) (hb : b < NV) : ΛF Λ0 (Yr a b) = Λ0 (Xr a b) := by
  rw [ΛF_eq, (KK_log PL PL_nodup (fun p hp => mem_PL.1 hp) _ (KK_fin Λ0 htemp)).2.1 (a, b)
    (mem_PL.2 ⟨ha, hb⟩), (Λ2_L2 Λ0 htemp).1 a ha b hb, (Λ2_L2 Λ0 htemp).2.1 a ha b hb, if_pos ha,
    (Λ1_L1 Λ0 htemp).1 b hb a ha, (Λ1_L1 Λ0 htemp).2.1 b hb a ha, if_pos hb]
  abel

omit htemp in
lemma A_notK {r : Rl} (hX : ∀ a < NV, ∀ b < NV, r ≠ Xr a b) (hY : ∀ a < NV, ∀ b < NV, r ≠ Yr a b)
    (hτ : ∀ a < NV, ∀ b < NV, r ≠ τr a b) :
    ∀ p ∈ PL, r ≠ Xr p.1 p.2 ∧ r ≠ Yr p.1 p.2 ∧ r ≠ τr p.1 p.2 := fun p hp => by
  obtain ⟨ha, hb⟩ := mem_PL.1 hp
  exact ⟨hX _ ha _ hb, hY _ ha _ hb, hτ _ ha _ hb⟩

theorem ΛF_A1 {b q : ℕ} (hb : b < NV) (hq : q < NR) : ΛF Λ0 (A1r b q) = Λ0 (A1r b q) := by
  rw [ΛF_eq, (KK_log PL PL_nodup (fun p hp => mem_PL.1 hp) _ (KK_fin Λ0 htemp)).2.2 _
    (A_notK (fun a ha c hc e => X_ne_A1 ha hc hb hq e.symm) (fun a ha c hc e => Y_ne_A1 ha hc hb hq e.symm)
      (fun a ha c hc e => τ_ne_A1 ha hc hb hq e.symm)),
    (Λ2_L2 Λ0 htemp).2.2.2.2 _ (fun a ha w hw e => A1_ne_ι2 hb hq ha hw e.symm),
    (Λ1_L1 Λ0 htemp).2.2.1 b hb q hq]

theorem ΛF_A2 {a q : ℕ} (ha : a < NV) (hq : q < NR) : ΛF Λ0 (A2r a q) = Λ0 (A2r a q) := by
  have hw : aw q < NL := by rw [aw_eq]; simp only [NL, NV, NR] at *; omega
  have hX : ∀ a' < NV, ∀ c < NV, A2r a q ≠ Xr a' c := fun a' ha' c hc e => by
    have := congrArg rc e; rw [rc_A2 ha hq, rc_X ha' hc] at this
    simp only [NV, NR, NN] at *; nlinarith
  have hY : ∀ a' < NV, ∀ c < NV, A2r a q ≠ Yr a' c := fun a' ha' c hc e => by
    have := congrArg rc e; rw [rc_A2 ha hq, rc_Y ha' hc] at this
    simp only [NV, NR, NN] at *; nlinarith
  rw [ΛF_eq, (KK_log PL PL_nodup (fun p hp => mem_PL.1 hp) _ (KK_fin Λ0 htemp)).2.2 _
    (A_notK hX hY (fun _ _ _ _ => rW_ne_rT)),
    (Λ2_L2 Λ0 htemp).2.2.1 a ha q hq, ← ι2_a hq,
    (Λ1_L1 Λ0 htemp).2.2.2.2 _ (fun b hb w hw' => ι1_ne_ι2 hb hw' ha hw (by rw [aw_eq]; omega))]

end IntMul.Kappa.R6.Cx.NetG

