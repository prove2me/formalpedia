open AlgebraicCurve ModularCurve

theorem ModularCurve.cuspChartInftyZero_place_unique (K : Type*) [Field K] (p : ℕ) [Fact p.Prime] : ∀ u u' : Place K (modularFunctionFieldC K p), u.ord ⟨jqModC K, jqModC_mem K p⟩ < 0 → 0 < u.ord (⟨jqNModC K p, jqNModC_mem K p⟩ * (⟨jqModC K, jqModC_mem K p⟩)⁻¹ ^ p) → u'.ord ⟨jqModC K, jqModC_mem K p⟩ < 0 → 0 < u'.ord (⟨jqNModC K p, jqNModC_mem K p⟩ * (⟨jqModC K, jqModC_mem K p⟩)⁻¹ ^ p) → u = u' := by sorry
