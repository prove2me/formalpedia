section ComplexBorel

p2m_open "Complex Function.Complex ComplexConjugate AutomorphicForm.ComplexIwasawa"

variable {g : Matrix (Fin 2) (Fin 2) ℂ}

private theorem radC_sq_raw (g : Matrix (Fin 2) (Fin 2) ℂ) (z : ℂ) :
    radC g z ^ 2 = Complex.normSq (botP g z) + Complex.normSq (botQ g z) := by
  rw [radC]
  exact Real.sq_sqrt (add_nonneg (Complex.normSq_nonneg _) (Complex.normSq_nonneg _))

private theorem bot_det_rel (g : Matrix (Fin 2) (Fin 2) ℂ) (z : ℂ) :
    g 1 1 * botP g z - g 1 0 * botQ g z = g.det := by
  simp only [botP, botQ, Matrix.det_fin_two]
  ring

variable (g)

private def borelC (z : ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![-g.det / (radC g z : ℂ),
       (g 1 0 * conj (botP g z) + g 1 1 * conj (botQ g z)) / (radC g z : ℂ);
     0, (radC g z : ℂ)]

private def weylUnipC (z : ℂ) : Matrix (Fin 2) (Fin 2) ℂ :=
  !![0, 1; 1, 0] * !![1, z; 0, 1] * g

variable {g}

@[scoped simp] private theorem borelC_apply_00 (z : ℂ) : borelC g z 0 0 = -g.det / (radC g z : ℂ) := rfl
@[scoped simp] private theorem borelC_apply_01 (z : ℂ) : borelC g z 0 1
    = (g 1 0 * conj (botP g z) + g 1 1 * conj (botQ g z)) / (radC g z : ℂ) := rfl
@[scoped simp] private theorem borelC_apply_10 (z : ℂ) : borelC g z 1 0 = 0 := rfl
@[scoped simp] private theorem borelC_apply_11 (z : ℂ) : borelC g z 1 1 = (radC g z : ℂ) := rfl

private theorem kC_apply_00 (z : ℂ) : kC g z 0 0 = conj (botQ g z) / (radC g z : ℂ) := rfl

private theorem kC_apply_01 (z : ℂ) : kC g z 0 1 = -conj (botP g z) / (radC g z : ℂ) := rfl

private theorem det_borelC (hg : g.det ≠ 0) (z : ℂ) : (borelC g z).det = -g.det := by
  have hrC : (radC g z : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 (radC_pos hg z).ne'
  rw [borelC, Matrix.det_fin_two_of, mul_zero, sub_zero, div_mul_cancel₀ _ hrC]

private theorem weylUnipC_eq (z : ℂ) :
    weylUnipC g z = !![g 1 0, g 1 1; botP g z, botQ g z] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [weylUnipC, botP, botQ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem weylUnipC_eq_borelC_mul_kC (hg : g.det ≠ 0) (z : ℂ) :
    weylUnipC g z = borelC g z * kC g z := by
  have hrC : (radC g z : ℂ) ≠ 0 := Complex.ofReal_ne_zero.2 (radC_pos hg z).ne'
  have hr2 : (radC g z : ℂ) * (radC g z : ℂ)
      = botP g z * conj (botP g z) + botQ g z * conj (botQ g z) := by
    calc (radC g z : ℂ) * (radC g z : ℂ)
        = ((radC g z ^ 2 : ℝ) : ℂ) := by push_cast; ring
      _ = ((Complex.normSq (botP g z) : ℝ) : ℂ) + ((Complex.normSq (botQ g z) : ℝ) : ℂ) := by
          rw [radC_sq_raw]; push_cast; ring
      _ = botP g z * conj (botP g z) + botQ g z * conj (botQ g z) := by
          rw [Complex.mul_conj, Complex.mul_conj]
  have hPQ := bot_det_rel g z
  rw [weylUnipC_eq]
  ext i j
  fin_cases i <;> fin_cases j
  · show g 1 0 = (borelC g z * kC g z) 0 0
    rw [Matrix.mul_apply, Fin.sum_univ_two, borelC_apply_00, borelC_apply_01,
      kC_apply_00, kC_apply_10]
    field_simp
    linear_combination (g 1 0) * hr2 - conj (botQ g z) * hPQ
  · show g 1 1 = (borelC g z * kC g z) 0 1
    rw [Matrix.mul_apply, Fin.sum_univ_two, borelC_apply_00, borelC_apply_01,
      kC_apply_01, kC_apply_11]
    field_simp
    linear_combination (g 1 1) * hr2 + conj (botP g z) * hPQ
  · show botP g z = (borelC g z * kC g z) 1 0
    rw [Matrix.mul_apply, Fin.sum_univ_two, borelC_apply_10, borelC_apply_11, kC_apply_10,
      zero_mul, zero_add, mul_div_cancel₀ _ hrC]
  · show botQ g z = (borelC g z * kC g z) 1 1
    rw [Matrix.mul_apply, Fin.sum_univ_two, borelC_apply_10, borelC_apply_11, kC_apply_11,
      zero_mul, zero_add, mul_div_cancel₀ _ hrC]

end ComplexBorel
