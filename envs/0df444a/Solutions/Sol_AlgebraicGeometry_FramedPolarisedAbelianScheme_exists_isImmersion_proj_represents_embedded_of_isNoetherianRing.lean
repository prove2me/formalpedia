theorem projSpaceMap_eq_of_algebraMap_eq {R : Type} [CommRing R] (i₁ i₂ : Algebra B R)
    (h : ∀ b, @algebraMap B R _ _ i₁ b = @algebraMap B R _ _ i₂ b) (N : ℕ) :
    @ProjSpace.map B _ R _ i₁ N = @ProjSpace.map B _ R _ i₂ N := by
  have : i₁ = i₂ := Algebra.algebra_ext i₁ i₂ h
  subst this; rfl

theorem β_eq_algebraMap {R : Type} [CommRing R] [Algebra B R]
    (s : {s : Spec (CommRingCat.of R) ⟶ C.W₀ // s ≫ C.πW = Spec.map (CommRingCat.ofHom (algebraMap B R))}) :
    C.β s.1 = algebraMap B R := by
  have h : Spec.map (CommRingCat.ofHom (C.β s.1)) = Spec.map (CommRingCat.ofHom (algebraMap B R)) := by
    rw [specMap_β, s.2]
  exact congrArg CommRingCat.Hom.hom (Spec.map_injective h)

theorem ptW_framedOf {R : Type} [CommRing R] [Algebra B R]
    (s : {s : Spec (CommRingCat.of R) ⟶ C.W₀ // s ≫ C.πW = Spec.map (CommRingCat.ofHom (algebraMap B R))})
    (hn : IsUnit ((n : ℕ) : R)) (hs : C.Mem n s.1)
    (hid : ∀ {X : Scheme.{0}} (f : X ⟶ Spec (CommRingCat.of R)) (M : X.Modules) {m : ℕ} (σ : Fin m → Γ(M, ⊤)),
      Scheme.Modules.IsSectionBasisOn f ((Scheme.Modules.pullback (𝟙 X)).obj M) ((𝟙 X) ⁻¹ᵁ ⊤)
          (fun i => Scheme.Modules.pullbackLocalSection (𝟙 X) (σ i)) →
        Scheme.Modules.IsSectionBasis f M σ) :
    (C.ptW F (C.framedOf s.1 hn hs hid)).1 = s.1 := by
  classical
  let X := C.framedOf s.1 hn hs hid
  have hframe : X.frame.toProj = C.ι s.1 := C.polPres_toProj s.1

  have hq : F.pt R X = C.q s.1 := by
    obtain ⟨e, he⟩ := F.iso R X
    exact C.Φ_inj R _ _ ⟨e, by rw [← he, hframe]; rfl⟩

  have key : C.ptW F X = s := (C.hW R).1 (by
    apply Subtype.ext; apply Prod.ext
    · show (C.ptW F X).1 ≫ C.prH = s.1 ≫ C.prH
      rw [ptW_prH, hq, q, Equiv.apply_symm_apply]
    · funext j
      show (C.ptW F X).1 ≫ C.prY j = s.1 ≫ C.prY j
      rw [ptW_prY]
      have hmap := projSpaceMap_eq_of_algebraMap_eq (B := B) (inferInstance) (C.β s.1).toAlgebra
        (fun b => by rw [C.β_eq_algebraMap s]; rfl) N
      have hsec : (if h : j.1 = 0 then (X.L.one (𝟙 _)).1 else (X.P ⟨j.1 - 1, by omega⟩).1) =
          (C.zsec s.1 (C.lifts_of_iSup_eq_bot s.1 hs.fst) j).1 := by
        split_ifs with h
        · have h0 : j = 0 := Fin.ext h
          subst h0
          show ((C.law s.1 (C.lifts_of_iSup_eq_bot s.1 hs.fst) hs.snd.fst).one (𝟙 _)).1 = _
          rw [(C.law_spec s.1 (C.lifts_of_iSup_eq_bot s.1 hs.fst) hs.snd.fst).1]
        · show (C.Psec s.1 (C.lifts_of_iSup_eq_bot s.1 hs.fst) ⟨j.1 - 1, _⟩).1 = _
          simp only [Psec]
          congr 2; ext; simp only; omega
      show framedSec (B := B) X j = s.1 ≫ C.prY j
      unfold framedSec
      rw [hsec, hmap, hframe, ← Category.assoc]
      have hz := C.zsec_ι s.1 (C.lifts_of_iSup_eq_bot s.1 hs.fst) j
      have hy := C.ysec_map s.1 j
      exact (congrArg (fun t => t ≫ _) hz).trans hy)
  rw [key]

end KCtx
