-- title:
--   Proof of Proposition 5.1, p. 487, (20) — if x^r → z along ℛ, then x^{r+j} → z along ℛ for j = 0, 1, …, T
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3 and either C1 or C2, and let $\{x^r\}$ be generated by the BCD method (2)–(3) from $x^0\in\operatorname{dom}f$ using the essentially cyclic rule with bound $T\ge N$, with values $\{f(x^r)\}$ that do not decrease to $-\infty$. If $\{x^r\}_{r\in\mathcal R}\to z$ along an infinite index set $\mathcal R$, then
--   $$\{x^{r+j}\}_{r\in\mathcal R}\to z,\qquad\forall j=0,1,\dots,T.\tag{20}$$
--
--   This iterates (11) along the shifted subsequences and covers a whole window of $T$ iterations, in which every block is updated.
--
--   **Formalization Note.** The subsequence $\mathcal R$ is a strictly increasing $\rho:\mathbb N\to\mathbb N$. $T$ is the bound of the essentially cyclic rule: $T\ge N$ and every block occurs among any $T$ consecutive choices. The page's proof does not use these two properties of $T$ for (20); they are kept so that $T$ is the paper's $T$.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), p. 487, proof of Proposition 5.1, (20)

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem claim_20 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (s : ℕ → Fin N) (x : ℕ → TsengBCD.Stationary.X n) (hrun : TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x)
    (T : ℕ) (hT : N ≤ T) (hcyc : ∀ (r : ℕ) (k : Fin N), ∃ j < T, s (r + j) = k)
    (hfin : ¬ Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 ⊥))
    (ρ : ℕ → ℕ) (hρ : StrictMono ρ) (z : TsengBCD.Stationary.X n)
    (hz : Tendsto (fun m => x (ρ m)) atTop (𝓝 z)) :
    ∀ j : ℕ, j ≤ T → Tendsto (fun m => x (ρ m + j)) atTop (𝓝 z) := by sorry

end TsengBCD.Hemivariate
