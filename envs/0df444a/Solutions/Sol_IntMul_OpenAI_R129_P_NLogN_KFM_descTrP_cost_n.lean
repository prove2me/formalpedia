       congr 1; omega)

theorem pushL_full (v : ℕ → ℤ) (d : ℕ) : NLogN.KFM.pushL v d d = (List.range d).map v := by
  simp [NLogN.KFM.pushL]

/-- **Push loop.** `rep mOc (reg zD) B` with `d` on `zD`, where `B` pushes `v (c−1)` on `dst`
