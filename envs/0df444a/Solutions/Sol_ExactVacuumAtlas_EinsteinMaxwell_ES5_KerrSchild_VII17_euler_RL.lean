theorem RL_succ {k : ℕ} {g : ℝ → ℝ} :
    RL (k + 1) g ↔ (∃ L, Tendsto g (𝓝[>] (0:ℝ)) (𝓝 L)) ∧ RL k (deriv g) := Iff.rfl

theorem ev_pos : ∀ᶠ x in 𝓝[>] (0:ℝ), 0 < x := self_mem_nhdsWithin

theorem ev_nhds {p : ℝ → Prop} (h : ∀ᶠ x in 𝓝[>] (0:ℝ), p x) :
    ∀ᶠ y in 𝓝[>] (0:ℝ), ∀ᶠ x in 𝓝 y, p x := by
  filter_upwards [eventually_eventually_nhdsWithin.2 h, ev_pos] with y hy hy0
  rwa [nhdsWithin_eq_nhds.2 (Ioi_mem_nhds hy0)] at hy

theorem deriv_congr {f g : ℝ → ℝ} (h : f =ᶠ[𝓝[>] (0:ℝ)] g) :
    deriv f =ᶠ[𝓝[>] (0:ℝ)] deriv g := by
  filter_upwards [ev_nhds h] with y hy using Filter.EventuallyEq.deriv_eq hy

theorem PS.contDiffOn {g : ℝ → ℝ} (hg : PS g) : ∃ δ > 0, ContDiffOn ℝ ∞ g (Ioo 0 δ) := by
  obtain ⟨δ, hδ, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hg
  exact ⟨δ, hδ, fun x hx => (show ContDiffAt ℝ ∞ g x from hsub hx).contDiffWithinAt⟩

theorem PS.der {g : ℝ → ℝ} (hg : PS g) : PS (deriv g) := by
