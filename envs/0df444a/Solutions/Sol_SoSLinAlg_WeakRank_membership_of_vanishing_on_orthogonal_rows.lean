theorem comp_mul (w : σ → ℕ) {a b : ℕ} {p q : MvPolynomial σ ℝ}
    (hp : DegLE w a p) (hq : DegLE w b q) :
    weightedHomogeneousComponent w (a + b) (p * q) =
      weightedHomogeneousComponent w a p * weightedHomogeneousComponent w b q := by
  classical
  ext s
  rw [coeff_weightedHomogeneousComponent, coeff_mul, coeff_mul]
  split_ifs with hs
  · apply Finset.sum_congr rfl
    rintro ⟨u, v⟩ huv
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at huv
    dsimp only
    simp only [coeff_weightedHomogeneousComponent]
    by_cases hu : coeff u p = 0
    · simp [hu]
    by_cases hv : coeff v q = 0
    · simp [hv]
    have h1 := hp u (mem_support_iff.2 hu)
    have h2 := hq v (mem_support_iff.2 hv)
    have : Finsupp.weight w u + Finsupp.weight w v = a + b := by
      rw [← map_add, huv, hs]
    rw [if_pos (by omega), if_pos (by omega)]
  · symm
    apply Finset.sum_eq_zero
    rintro ⟨u, v⟩ huv
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at huv
    dsimp only
    simp only [coeff_weightedHomogeneousComponent]
    split_ifs with h1 h2 <;> try simp
    exact absurd (by rw [← huv, map_add, h1, h2]) hs

