theorem mul_val_congr {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)} (L : RelativeGroupLaw S f)
    {T : Scheme.{0}} {s₁ s₂ : T ⟶ Spec (CommRingCat.of S)} (h : s₁ = s₂)
    (P₁ Q₁ : SchemeHomOver s₁ f) (P₂ Q₂ : SchemeHomOver s₂ f) (hP : P₁.1 = P₂.1) (hQ : Q₁.1 = Q₂.1) :
    (L.mul s₁ P₁ Q₁).1 = (L.mul s₂ P₂ Q₂).1 := by
  subst h
  obtain ⟨P₁, hP₁⟩ := P₁; obtain ⟨P₂, hP₂⟩ := P₂; obtain ⟨Q₁, hQ₁⟩ := Q₁; obtain ⟨Q₂, hQ₂⟩ := Q₂
  simp only at hP hQ
  subst hP; subst hQ
  rfl

theorem isUnit_natCast_of_not_dvd {K : Type} [CommRing K] {q m : ℕ} (hq : q.Prime) (hqm : ¬ q ∣ m)
    (hqK : ((q : ℕ) : K) = 0) : IsUnit ((m : ℕ) : K) := by
  have hcop : IsCoprime (m : ℤ) (q : ℤ) := by
    rw [Nat.isCoprime_iff_coprime]
    exact (Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hq).mpr hqm))
  obtain ⟨c, d, hcd⟩ := hcop
  have h := congrArg (fun z : ℤ => (z : K)) hcd
  simp only [Int.cast_add, Int.cast_mul, Int.cast_natCast, Int.cast_one, hqK, mul_zero, add_zero] at h
  exact ⟨⟨(m : K), (c : K), by rw [mul_comm]; exact h, h⟩, rfl⟩

