          aa j.val = r.aliceAnswer j) := by
      constructor
      · intro h j
        exact h j.val j.property
      · intro h j hj
        exact h ⟨j, hj⟩
    have hb :
        (∀ (j : Fin n) (hj : j ∈ D),
          bb j = r.bobAnswer ⟨j, hj⟩) ↔
        (∀ j : {j : Fin n // j ∈ D},
          bb j.val = r.bobAnswer j) := by
      constructor
      · intro h j
        exact h j.val j.property
      · intro h j hj
        exact h ⟨j, hj⟩
    by_cases aok : ∀ (j : Fin n) (hj : j ∈ D),
