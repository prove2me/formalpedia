      (child a b ys).length = AModel.vol (P :: L' :: AModel.hdShape A B Cs m N))
    (t : NLogN.IState NLogN.HS) (ht : NLogN.KIL.Inv G0 t) (R : List NLogN.Item) (xs : List (ZMod 2))
    (hxs : xs.length = AModel.vol (P :: W * L' :: AModel.hdShape A B Cs m N)) :
    NLogN.IRuns I iprog (NLogN.KIL.bodyU C tpl j0) (t.upd 0 (NLogN.ints (NLogN.KIL.enc2 xs) ++ R))
