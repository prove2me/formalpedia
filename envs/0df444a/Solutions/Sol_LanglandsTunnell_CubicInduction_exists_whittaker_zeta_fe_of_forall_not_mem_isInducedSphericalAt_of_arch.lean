variable {F : Type} [Field F] [NumberField F] [MeasurableSpace (AdeleRing (𝓞 F) F)ˣ]
  {ν : Measure (AdeleRing (𝓞 F) F)ˣ} {S : Finset (HeightOneSpectrum (𝓞 F))}

private theorem multipliable_and_integrable_and_integral_eq (Hν : ProductMeasureData S ν)
    (Z f : (AdeleRing (𝓞 F) F)ˣ → ℂ) (φ : HeightOneSpectrum (𝓞 F) → ℤ → ℂ) (c : HeightOneSpectrum (𝓞 F) → ℝ)
    (hfact : ∀ L : List (HeightOneSpectrum (𝓞 F)), (∀ v ∈ L, v ∉ S) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}),
        Z a = f (Hν.projS a) * (L.map fun v => φ v (Hν.ord v a)).prod)
    (hf : Integrable f Hν.νS) (hφ : ∀ v, v ∉ S → Summable fun m : ℤ => ‖φ v m‖)
    (hφc : ∀ v, v ∉ S → ∑' m : ℤ, ‖φ v m‖ ≤ 1 + c v) (hφ1 : ∀ v, v ∉ S → ‖(∑' m : ℤ, φ v m) - 1‖ ≤ c v)
    (hc0 : ∀ v, 0 ≤ c v) (hc : Summable c) :
    Multipliable (fun v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S} => ∑' m : ℤ, φ v.1 m) ∧ Integrable Z ν ∧
      (∫ a, Z a ∂ν) = Hν.c * (∫ a, f a ∂Hν.νS) *
        ∏' v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S}, ∑' m : ℤ, φ v.1 m := by
  classical
  obtain ⟨N, hfin⟩ := exists_enumeration (F := F)
  set Lf : ℕ → List (HeightOneSpectrum (𝓞 F)) :=
    fun n => ((hfin n).toFinset.filter fun v => v ∉ S).toList with hLf
  have hmem : ∀ (n : ℕ) (v : HeightOneSpectrum (𝓞 F)), v ∈ Lf n ↔ N v ≤ n ∧ v ∉ S := by
    intro n v
    simp only [hLf, Finset.mem_toList, Finset.mem_filter, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
  have hLS : ∀ n : ℕ, ∀ v ∈ Lf n, v ∉ S := fun n v hv => ((hmem n v).1 hv).2
  have hLnd : ∀ n : ℕ, (Lf n).Nodup := fun n => Finset.nodup_toList _
  have hcov : ∀ (n : ℕ) (v : HeightOneSpectrum (𝓞 F)), v ∉ S → N v ≤ n → v ∈ Lf n :=
    fun n v hvS hle => (hmem n v).2 ⟨hle, hvS⟩
  have hmono : ∀ n : ℕ, Lf n ⊆ Lf (n + 1) := by
    intro n v hv
    exact (hmem (n + 1) v).2 ⟨((hmem n v).1 hv).1.trans (Nat.le_succ n), ((hmem n v).1 hv).2⟩
  have hTmono := monotone_coe_unitIdelesOutside (F := F) S Lf hmono
  have hUn := iUnion_coe_unitIdelesOutside_eq_univ (F := F) S N Lf hcov
  have hmult : Multipliable fun v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S} => ∑' m : ℤ, φ v.1 m :=
    multipliable_subtype_of_norm_sub_one_le (fun v => v ∉ S) hc hφ1
  have hprod := hmult.hasProd
  have hpass := integrable_and_tendsto_setIntegral_of_monotone_of_iUnion_eq_univ hTmono hUn
    (fun n => (integrableOn_and_setIntegral_eq Hν hfact hf hφ (Lf n) (hLS n) (hLnd n)).1)
    (fun n => setIntegral_norm_le Hν hfact hf hφ hφc hc0 hc (Lf n) (hLS n) (hLnd n))
  have hseq : ∀ n : ℕ,
      (∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ Lf n}) :
          Set (AdeleRing (𝓞 F) F)ˣ), Z a ∂ν) =
        Hν.c * (∫ a, f a ∂Hν.νS) * ((Lf n).map fun v => ∑' m : ℤ, φ v m).prod :=
    fun n => (integrableOn_and_setIntegral_eq Hν hfact hf hφ (Lf n) (hLS n) (hLnd n)).2
  have hlim : Tendsto
      (fun n : ℕ => ∫ a in (NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ Lf n}) :
          Set (AdeleRing (𝓞 F) F)ˣ), Z a ∂ν) atTop
      (𝓝 (Hν.c * (∫ a, f a ∂Hν.νS) * ∏' v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S}, ∑' m : ℤ, φ v.1 m)) := by
    simp only [hseq]
    exact (tendsto_prod_toList_filter_of_hasProd (fun v => v ∉ S) (fun v => ∑' m : ℤ, φ v m) hprod N
      hfin).const_mul _
  exact ⟨hmult, hpass.1, tendsto_nhds_unique hpass.2 hlim⟩

private theorem multipliable_and_integrable_and_integral_eq_of_apply_zero_eq_one (Hν : ProductMeasureData S ν)
    (Z f : (AdeleRing (𝓞 F) F)ˣ → ℂ) (φ : HeightOneSpectrum (𝓞 F) → ℤ → ℂ) (c : HeightOneSpectrum (𝓞 F) → ℝ)
    (hfact : ∀ L : List (HeightOneSpectrum (𝓞 F)), (∀ v ∈ L, v ∉ S) → L.Nodup →
      ∀ a ∈ NumberField.AdeleRing.unitIdelesOutside (𝓞 F) F (↑S ∪ {v | v ∈ L}),
        Z a = f (Hν.projS a) * (L.map fun v => φ v (Hν.ord v a)).prod)
    (hf : Integrable f Hν.νS) (hφ : ∀ v, v ∉ S → Summable fun m : ℤ => ‖φ v m‖)
    (hφc : ∀ v, v ∉ S → ∑' m : ℤ, ‖φ v m‖ ≤ 1 + c v) (hφ0 : ∀ v, v ∉ S → φ v 0 = 1)
    (hc0 : ∀ v, 0 ≤ c v) (hc : Summable c) :
    Multipliable (fun v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S} => ∑' m : ℤ, φ v.1 m) ∧ Integrable Z ν ∧
      (∫ a, Z a ∂ν) = Hν.c * (∫ a, f a ∂Hν.νS) *
        ∏' v : {v : HeightOneSpectrum (𝓞 F) // v ∉ S}, ∑' m : ℤ, φ v.1 m :=
  multipliable_and_integrable_and_integral_eq Hν Z f φ c hfact hf hφ hφc
    (fun v hv => norm_tsum_sub_one_le (hφ v hv) (hφ0 v hv) (hφc v hv)) hc0 hc

end

