section Reshape

variable (F : Type) [Field F] [NumberField F] (w : InfinitePlace F)

local notation "𝔸" => AdeleRing (𝓞 F) F

private def reshapeAt (x : AdelicGL2 (𝓞 F) F) : AdelicGL2 (𝓞 F) F :=
  adelicArchGLInclAt F w ((archComponent F w (glArch (𝓞 F) F x) * gl2Weyl)⁻¹) * x

private theorem continuous_reshapeAt : Continuous (reshapeAt F w) :=
  ((continuous_adelicArchGLInclAt F w).comp
    ((((continuous_archComponent F w).comp (continuous_glArch (𝓞 F) F)).mul continuous_const).inv)).mul continuous_id

private theorem awayFrom_weyl_unipotent_eq_reshapeAt (x : AdelicGL2 (𝓞 F) F) (a : 𝔸) :
    awayFrom F w (adelicWeyl (𝓞 F) F * unipotentGL2 a * x)
      = adelicWeyl (𝓞 F) F * unipotentGL2 (zeroAt F w a) * reshapeAt F w x :=
  awayFrom_weyl_unipotent_eq F w x (fun _ hvw => zeroAt_fst_of_ne F a hvw) (zeroAt_fst_self F w a) (zeroAt_snd F w a)

end Reshape
