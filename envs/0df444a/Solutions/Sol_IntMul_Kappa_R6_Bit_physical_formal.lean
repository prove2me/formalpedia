section Sound

variable {R : Type*} [CommRing R] {m : ℕ} {Wr : Type*} [Fintype Wr] [DecidableEq Wr] {U : Type*}
  {sh : Shape} {N : ℕ} [NeZero N] (Λ : Layout sh (m + m) N) (ins : U → List R)

lemma den_lmulF {i : ℕ} (hi : i < vol sh) (X : FMat m N) (φ : FV R U m N) :
    den Λ ins i (lmulF X φ) = den Λ ins (encode sh (amap Λ X⁻¹ (decode sh i))) φ := by
  simp only [den, lmulF, Finsupp.lmapDomain_apply, Finsupp.linearCombination_mapDomain]
  congr 2
  funext p
  simp only [Function.comp_apply]
  rw [← frameArr_mul, getD_frameArr Λ X _ hi]

/-- **Formal invariant.** -/
theorem physical_formal_sol_aux :
    ∀ (prog : List (Instr Wr R m)), (∀ e ∈ progEdges prog, EdgeOK N e) →
      ∀ (st : Wr → List R) (f : Wr → FV R U m N), (∀ w, (st w).length = vol sh) →
        (∀ w, ∀ i < vol sh, (st w).getD i 0 = den Λ ins i (f w)) →
        ∀ w, ∀ i < vol sh, (netRunH (vol sh) (fun e => runArr Λ 0 (e.steps N)) prog st w).getD i 0 =
          den Λ ins i (prog.foldl (fStep N) f w) := by
  intro prog
  induction prog with
  | nil => intro _ st f _ hst w i hi; exact hst w i hi
  | cons ins0 l ih =>
    intro hE st f hlen hst
    have hE' : ∀ e ∈ progEdges l, EdgeOK N e :=
      fun e he => hE e (by rw [progEdges_cons]; exact List.mem_append_right _ he)
    simp only [netRunH, List.foldl_cons] at ih ⊢
    apply ih hE'
    · intro w
      cases ins0 with
      | gate g S =>
        simp only [instrRun, gateApply]; split_ifs <;> simp [hlen w]
      | edge w0 e =>
        simp only [instrRun]
        by_cases h : w = w0
        · subst h; rw [Function.update_self]; exact length_runArr Λ 0 _ (hlen w)
        · rw [Function.update_of_ne h]; exact hlen w
    · intro w i hi
      cases ins0 with
      | gate g S =>
        simp only [instrRun, gateApply, fStep, gateVecM]
        split_ifs with hw
        · rw [List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn, map_sum]
          refine Finset.sum_congr rfl fun w' _ => ?_
          rw [map_smul, smul_eq_mul, hst w' i hi]
        · exact hst w i hi
      | edge w0 e =>
        have he : EdgeOK N e := hE e (by rw [progEdges_cons]; simp [Instr.edgeOf])
        simp only [instrRun, fStep]
        by_cases h : w = w0
        · subst h
          simp only [Function.update_self]
          rw [runArr_steps_eq Λ he (hlen w), getD_frameArr Λ _ _ hi, den_lmulF Λ ins hi]
          exact hst w _ (encode_lt (valid_amap Λ _ (valid_decode hi)))
        · rw [Function.update_of_ne h, Function.update_of_ne h]
          exact hst w i hi

end Sound

