noncomputable def characterBasis (G : Type*) [AddCommGroup G] [Fintype G] :
    Basis (AddChar G ℂ) ℂ (G → ℂ) :=
  basisOfLinearIndependentOfCardEqFinrank' ((⇑) : AddChar G ℂ → G → ℂ)
    (AddChar.linearIndependent G ℂ) (by simp)

@[simp] theorem characterBasis_apply {G : Type*} [AddCommGroup G] [Fintype G]
    (χ : AddChar G ℂ) : characterBasis G χ = (χ : G → ℂ) := by
  simp [characterBasis, coe_basisOfLinearIndependentOfCardEqFinrank']

noncomputable def characterCoeff {G : Type*} [AddCommGroup G] [Fintype G]
    (f : G → ℂ) (χ : AddChar G ℂ) : ℂ := (characterBasis G).repr f χ

open scoped BigOperators

def cutDistance {X : Type*} (c : X → Bool) (x y : X) : ℝ :=
  if c x = c y then 0 else 1

@[simp] theorem cutDistance_self {X : Type*} (c : X → Bool) (x : X) :
    cutDistance c x x = 0 := by simp [cutDistance]

def HasCutRepresentation {X : Type*} [Fintype X] (ρ : X → X → ℝ) : Prop := by
  classical
  exact ∃ a : (X → Bool) → ℝ, (∀ c, 0 ≤ a c) ∧
    ∀ x y, ρ x y = ∑ c : X → Bool, a c * cutDistance c x y

