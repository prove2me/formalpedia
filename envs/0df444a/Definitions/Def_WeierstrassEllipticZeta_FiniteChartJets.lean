-- title:
--   Finite jet generators for both Weierstrass chart ideals
-- statement:
--   In either Weierstrass chart c, write F_c for its explicit cubic, Q_c for the normalized auxiliary polynomial, and D_c for its polynomial derivation. Define a family indexed by Fin(T+2): the first member is F_c and the remaining members are D_c^k Q_c for 0 <= k <= T. Define J_T as the ideal spanned by this finite family.
--
--   FiniteChartJetBudget retains the chart, available point in the given finite set, and all the original candidate-prime and localized-length conditions. It uses J_(iT) and J_((i+1)T) in place of the corresponding differential prolongations for i in Fin 3. No length bound, prime existence, or geometric degree theorem is included in the definition. Equality of the new and old ideals is a separate proved theorem.
-- source:
--   Philippon (1986), Lemmes de zeros dans les groupes algebriques commutatifs, Bull. Soc. Math. France 114, 355-383, section 5, pp. 380-382: derivative and translation ideals in the zero-estimate argument. https://www.numdam.org/item/10.24033/bsmf.2060.pdf. Senthil Kumar K (2026), Appendix A, Theorem A.2. https://doi.org/10.1017/S001309152610145X. The new algebraic step proves that each order-T prolongation of the explicit cubic-plus-Q chart base is generated by the cubic and the normalized Q jets through order T, preserving exact ideals and lengths. The individual jet-degree bounds were already available and are reused. The common total-degree bound max(3,m+2*n+T) depends on T; it does not prove the uniform total multiplicity budget. Geometric locus selection, coset/component control and the uniform degree estimate remain Open.

import Definitions.Def_WeierstrassEllipticZeta_CubicChartBase

noncomputable section
namespace WeierstrassEllipticZeta

/-- The cubic followed by the normalized polynomial and its first T derivatives. -/
def extensionChartJetGenerator (L : PeriodPair) (Q : MvPolynomial (Fin 7) ℂ)
    (c : Fin 2) (T : ℕ) : Fin (T + 2) → MvPolynomial (Fin 4) ℂ :=
  Fin.cases (extensionChartCubic L.g₂ L.g₃ c)
    (fun k : Fin (T + 1) => (extensionChartDerivation L.g₂ L.g₃ c)^[k.val]
      (extensionChartNormalize c Q))

/-- The finite ideal generated by the displayed cubic and polynomial jets. -/
def extensionChartJetIdeal (L : PeriodPair) (Q : MvPolynomial (Fin 7) ℂ)
    (c : Fin 2) (T : ℕ) : Ideal (MvPolynomial (Fin 4) ℂ) :=
  Ideal.span (Set.range (extensionChartJetGenerator L Q c T))

structure FiniteChartJetBudget (L : PeriodPair) (S : Fin 5 → ℂ → ℂ)
    (Q : MvPolynomial (Fin 7) ℂ) (T e : ℕ) (Z : Finset ℂ) where
  chart : Fin 2
  z : ℂ
  z_mem : z ∈ Z
  chart_ne : S (extensionChartDenominator chart) z ≠ 0
  length_le : ∀ (i : Fin 3) (p : Ideal (MvPolynomial (Fin 4) ℂ)) [p.IsPrime],
    p ≤ RingHom.ker (MvPolynomial.eval (extensionChartCoordinates S chart z)) →
    p ∈ (extensionChartJetIdeal L Q chart (i.val * T)).minimalPrimes →
    p ∈ (extensionChartJetIdeal L Q chart ((i.val + 1) * T)).minimalPrimes →
    Module.length (Localization.AtPrime p)
      ((Localization.AtPrime p) ⧸ (extensionChartJetIdeal L Q chart (i.val * T)).map
        (algebraMap (MvPolynomial (Fin 4) ℂ) (Localization.AtPrime p))) ≤ (e : ℕ∞)

end WeierstrassEllipticZeta


