-- Source module: Solutions.ButterflyProp14
set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Butterfly

open Matrix Finset Complex AModel

section Network

variable {W m : ℕ} {κ : Type} [Fintype κ] [DecidableEq κ]

lemma roleBlock_roleDiag {ι : Type} (T : Op ι) (w : Fin W) : roleBlock (roleDiag T) w = T := by
  ext x y; simp [roleBlock, roleDiag]

end Network

theorem leafOp_eq (u : ℕ) : leafOp u = Butterfly.tens Cm := by
  rw [leafOp, tens_eq_prod_kerAt Butterfly.Cm (List.finRange u) (List.nodup_finRange u)
    (List.mem_finRange), List.map_map]; rfl

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s) (u : ℕ)

/-- **Correctness of the recursion**: the depth-`k` program computes `C^{⊗}` on its
`u m^k` selected bits. -/
theorem recOp_eq : ∀ k, recOp I u k = Butterfly.tens Butterfly.Cm
  | 0 => leafOp_eq u
  | k + 1 => by
    rw [recOp, recOp_eq k, I.correct (Lvl u m k)]
    exact roleBlock_roleDiag (W := W) (Butterfly.tens Butterfly.Cm : Op (Fin m × Lvl u m k)) 0

section Blocks

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- Pieces on pairwise disjoint blocks covering all selected bits multiply to the full tensor
power (in any order: the factors commute). -/
theorem tens_blocks (A : M2) (Ss : List (Finset ι)) (hdisj : Ss.Pairwise Disjoint)
    (hcov : ∀ i, ∃ S ∈ Ss, i ∈ S) :
    (Butterfly.tens A : Op ι) = (Ss.map fun S => tensF (blockFam S A)).prod := by
  have hm : (Ss.map fun S => tensF (blockFam S A)) = ((Ss.map fun S => blockFam S A).map tensF) := by
    simp [List.map_map, Function.comp_def]
  rw [hm, ← tensF_list_prod]
  unfold Butterfly.tens
  congr 1; funext i
  obtain ⟨S, hS, hi⟩ := hcov i
  -- exactly one block contains `i`
  have key : ∀ l : List (Finset ι), l.Pairwise Disjoint →
      ((l.map fun S => blockFam S A).map fun B => B i).prod =
        if ∃ S ∈ l, i ∈ S then A else 1 := by
    intro l hl
    induction l with
    | nil => simp
    | cons T l ih =>
      rw [List.pairwise_cons] at hl
      simp only [List.map_cons, List.prod_cons, ih hl.2, blockFam, List.mem_cons]
      by_cases hT : i ∈ T
      · have : ¬ ∃ S ∈ l, i ∈ S := by
          rintro ⟨S, hS, hiS⟩
          exact Finset.disjoint_left.1 (hl.1 S hS) hT hiS
        simp [hT, this]
      · simp [hT]
  rw [key Ss hdisj, if_pos ⟨S, hS, hi⟩]

/-- Embedding the tensor power on a piece gives the block tensor. -/
theorem embed_tens {κ : Type} [Fintype κ] [DecidableEq κ] (S : Finset ι) (e : κ ≃ S) (A : M2) :
    Butterfly.embed S e (Butterfly.tens A) = tensF (blockFam S A) := by
  ext x y
  have h1 : ∀ i ∈ S, blockFam S A i (x i) (y i) = A (x i) (y i) := fun i hi => by
    show (if i ∈ S then A else 1) (x i) (y i) = _
    rw [if_pos hi]
  have h2 : ∀ i ∈ Sᶜ, blockFam S A i (x i) (y i) = if x i = y i then 1 else 0 := fun i hi => by
    rw [Finset.mem_compl] at hi
    show (if i ∈ S then A else 1) (x i) (y i) = _
    rw [if_neg hi, Matrix.one_apply]
  simp only [Butterfly.embed, Butterfly.tens, tensF]
  rw [← Finset.prod_mul_prod_compl S, Finset.prod_congr rfl h1, Finset.prod_congr rfl h2,
    Finset.prod_boole]
  congr 1
  · rw [← Finset.prod_coe_sort S (fun i => A (x i) (y i))]
    exact Fintype.prod_equiv e _ _ (fun j => rfl)
  · simp only [Finset.mem_compl]

end Blocks

section Prop14

variable {P K D S ρ r : ℕ}

/-- **Proposition 14, output (conditional on the C-layer).** Let `Cimpl` be any implementation
of `C^{⊗D}` on the selected bits (by `recOp_eq` and `tens_blocks`/`embed_tens`, the recursive
program on the pieces is one). The procedure returns exactly `Q_p(H0^{⊗D} z)`; for disk inputs
every returned coefficient lies in the disk and differs from the exact layer by less than
`√2 · 2^{-p}`. -/
theorem prop14_output (hρ : ρ < K) (p : ℕ) (Cimpl : Op (Fin D)) (hC : Cimpl = Butterfly.tens Butterfly.Cm)
    (xs : List (Fin r → ℂ)) (hxs : ∀ j (h : j < xs.length), ‖xs[j]‖ ≤ 1) :
    prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c‖ ≤ 1) ∧
    (∀ j (h : j < (prop14Proc (P := P) (S := S) hρ p Cimpl xs).length)
      (h' : j < (layerH P K D S ρ hρ xs).length), ∀ c,
      ‖(prop14Proc (P := P) (S := S) hρ p Cimpl xs)[j] c - (layerH P K D S ρ hρ xs)[j] c‖
        < Real.sqrt 2 * 2⁻¹ ^ p) := by
  have hout : prop14Proc (P := P) (S := S) hρ p Cimpl xs = QpArr p (layerH P K D S ρ hρ xs) := by
    unfold prop14Proc; rw [hC, layerH_eq]; simp only [phaseLayer, cLayer]
  refine ⟨hout, ?_, ?_⟩
  · intro j h c
    rw [List.getElem_of_eq hout h]
    have hj : j < (layerH P K D S ρ hρ xs).length := by rw [hout] at h; simpa [QpArr] using h
    have hd := butterflyLayer_norm_le (layerSel P K D S ρ hρ) xs hxs j hj
    unfold QpArr; rw [List.getElem_map]
    exact (norm_Qp_le p _).trans ((norm_le_pi_norm _ c).trans hd)
  · intro j h h' c
    rw [List.getElem_of_eq hout h]
    unfold QpArr; rw [List.getElem_map]
    exact norm_Qp_sub_lt p _

end Prop14

end Butterfly

