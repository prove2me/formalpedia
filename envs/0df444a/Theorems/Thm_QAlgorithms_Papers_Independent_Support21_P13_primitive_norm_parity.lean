-- title:
--   Norm divisibility selects the quadratic-form parity
-- statement:
--   For integer coefficients $a_0,a_1,a_2,a_3$, set $x=\sum_{j=0}^3a_j\omega^j$, $P=\sum_{j=0}^3a_j^2$, and $Q=a_0(a_1-a_3)+a_2(a_1+a_3)$. Suppose $v_{\sqrt2}(x)=0$. Then
--
--   $$
--   \begin{aligned}
--   \sqrt2\mid |x|^2&\ \Longrightarrow\ P\text{ even and }Q\text{ odd},\\
--   \sqrt2\nmid |x|^2&\ \Longrightarrow\ P\text{ odd and }Q\text{ even}.
--   \end{aligned}
--   $$
--
--   Both divisibility tests take place in $\mathbb Z[\omega]$ and use $\sqrt2$. This refines the opposite-parity alternative.
-- source:
--   Fast and efficient exact synthesis of single qubit unitaries generated by Clifford and T gates, arXiv:1206.5236v4, PDF p. 21, Proposition 4: parity selected by sqrt(2)-divisibility of norm

import Definitions.Def_QAlgorithms_Papers_Independent_Support21_P13

noncomputable section

namespace QAlgorithms.Papers.Independent.Support21.P13

open scoped Classical

/-- Proposition 4, PDF p.21: both antecedents use sqrt(2)-divisibility of the
squared norm. The primitive hypothesis is shared by the two implications. -/
theorem primitive_norm_parity (a : Fin 4 → ℤ)
    (hprimitive : gde (coordinateValue a) = 0) :
    (DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) (normSquared (coordinateValue a)) →
      Even (formP a) ∧ Odd (formQ a)) ∧
    (¬ DividesIntegral ((Real.sqrt 2 : ℝ) : ℂ) (normSquared (coordinateValue a)) →
      Odd (formP a) ∧ Even (formQ a)) := by sorry

end QAlgorithms.Papers.Independent.Support21.P13

end
