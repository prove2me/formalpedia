section
-- Source module: Solutions.AModelL12Main
/-!
# Lemma 12 (arbitrary-width interchange), array model: final statements

* `lemma12`: parametric in a Prop.-11 oracle family `child K` (level bound `K`) satisfying the
  block-swap spec (`OracleSpec`) with cost `Tc K j V ≤ K₀ V (m^j)^τ`. With the parameters of the
  paper — `e = ⌈log_q 2^u⌉` (`eOf`), `Kp = ⌈log_m e⌉` (`kOf`), `ρ = ρ₀ Kp` where
  `W ≤ q^(2ρ₀)` (so `q^(2ρ) ≥ W^Kp`) — the procedure `lemma12Prog` is the interchange
  `(…, h, g, d, …) ↦ (…, d, g, h, …)` of the two `[2^u]` fields of `Pre ++ [2^u] ++ G ++ [2^u] ++ Suf`,
  for every `u ≥ 1` and all shapes, and its cost is `≤ K V u^τ`.
* `lemma12_paper`: the layout `[P] × [2^u] × [G] × [2^u] × [B]`, permutation `swapPos 1 3`.
* `lemma12_rat`: the oracle instantiated with the Prop. 11 program of `prop11_ratLabels`
  (`prog (C.toCircuit (q ^ m ^ K)) q`, cost `progCost`), for every large prime `q`, `ρ₀ = W`.
-/

namespace AModelL12

open AModel

section Final

variable {α : Type*}

/-- `e = ⌈log_q 2^u⌉`: the least `e` with `2^u ≤ q^e`. -/
def eOf (q u : ℕ) : ℕ := Nat.clog q (2 ^ u)

/-- `Kp = ⌈log_m e⌉`: the least `k` with `e ≤ m^k`. -/
def kOf (m q u : ℕ) : ℕ := Nat.clog m (eOf q u)

/-- **The Lemma 12 procedure** with the paper's parameters (`ρ = ρ₀ Kp`). -/
noncomputable def lemma12Prog (child : ℕ → Oracle α) (W m q ρ₀ : ℕ) (Pre G Suf : Shape) (u : ℕ)
    (d : α) (xs : List α) : List α :=
  l12bin (child (kOf m q u)) W m q (kOf m q u) (ρ₀ * kOf m q u) (eOf q u) u Pre G Suf d xs

/-- Its cost under the model of `l12binCost` with oracle costs `Tc (kOf m q u)`. -/
noncomputable def lemma12Cost (Tc : ℕ → ℕ → ℝ → ℝ) (c : ℝ) (W m q ρ₀ : ℕ) (Pre G Suf : Shape)
    (u : ℕ) : ℝ :=
  l12binCost (Tc (kOf m q u)) c W m q (kOf m q u) (ρ₀ * kOf m q u) (eOf q u) Pre G Suf

end Final

