  · obtain ⟨m, hm⟩ : ∃ m, ell (IntMul.OpenAI.Glue.LP n) (D + 1) = m + 1 := ⟨ell (IntMul.OpenAI.Glue.LP n) (D + 1) - 1, by omega⟩
    rw [if_neg h, if_pos (by omega), hm, pow_succ, Nat.mul_div_cancel _ (by norm_num)]
