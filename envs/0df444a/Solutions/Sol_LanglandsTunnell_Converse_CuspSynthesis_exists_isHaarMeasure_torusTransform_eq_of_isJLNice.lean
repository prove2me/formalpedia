                * (((χ (Units.map (finIncl (𝓞 K) K) (localUnit (𝓞 K) K v (Units.mk0 _ (hπ v)))) : ℂˣ) : ℂ)
                    * ((Ideal.absNorm v.asIdeal : ℕ) : ℂ) ^ (1 - s)) ^ NumberField.Idele.ord K v a).prod‖ := by
  have hu : ∀ w ∈ L, (1 : w.adicCompletion K) ∈ unitSet w := fun w _ => by
    show Valued.v (1 : w.adicCompletion K) = 1
    exact map_one _
  have h := t0750 ϖ hπ S T hST hL hLT W hϖ lam om b hN hK hU hT hZ χ s x a
