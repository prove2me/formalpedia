/-!
# R4: Minkowski Cartesian ↔ spherical — the actual coordinate map on a chart

Chart `domChart = {r > 0, 0 < θ < π, 0 < φ < 2π}` ⊆ `domSph`. The map
`toCart (t, r, θ, φ) = (t, r sin θ cos φ, r sin θ sin φ, r cos θ)` is a `C^∞` bijection of
`domChart` onto `imgCart = ℝ⁴ ∖ {y = 0, x ≥ 0}` (the closed half-plane slit, which contains the
`z`-axis), with `C^∞` inverse `fromCart`. The Jacobian `jac` has genuine-derivative entries,
`det jac = r² sin θ`, and the pull-back identity `jacᵀ · η · jac = gSph` holds on the chart.
`φ ~ φ + 2π` is not formalised; this is one chart.
-/

open Real
open scoped ContDiff
open ExactVacuumAtlas ExactVacuumAtlas.Minkowski

namespace ExactVacuumAtlas.Minkowski.R4

@[simp] theorem toCart_0 (x : Pt 4) : toCart x 0 = x 0 := rfl
@[simp] theorem toCart_1 (x : Pt 4) : toCart x 1 = x 1 * sin (x 2) * cos (x 3) := rfl
@[simp] theorem toCart_2 (x : Pt 4) : toCart x 2 = x 1 * sin (x 2) * sin (x 3) := rfl
@[simp] theorem toCart_3 (x : Pt 4) : toCart x 3 = x 1 * cos (x 2) := rfl
@[simp] theorem fromCart_0 (y : Pt 4) : fromCart y 0 = y 0 := rfl
@[simp] theorem fromCart_1 (y : Pt 4) : fromCart y 1 = √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := rfl
@[simp] theorem fromCart_2 (y : Pt 4) :
    fromCart y 2 = arccos (y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2)) := rfl
@[simp] theorem fromCart_3 (y : Pt 4) :
    fromCart y 3 = π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) := rfl

/-! ## Domains -/

theorem S2_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < y 1 ^ 2 + y 2 ^ 2 := by
  by_cases h : y 2 = 0
  · have h1 : y 1 < 0 := by
      by_contra h'
      exact hy ⟨h, not_lt.mp h'⟩
    have h1' : y 1 ≠ 0 := h1.ne
    positivity
  · positivity

theorem S3_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2 := by
  have := S2_pos hy; positivity

theorem rho3_pos {y : Pt 4} (hy : y ∈ imgCart) : 0 < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
  Real.sqrt_pos.mpr (S3_pos hy)

theorem z_div_rho3_lt_one {y : Pt 4} (hy : y ∈ imgCart) :
    y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) < 1 := by
  rw [div_lt_one (rho3_pos hy)]
  calc y 3 ≤ |y 3| := le_abs_self _
    _ = √(y 3 ^ 2) := (Real.sqrt_sq_eq_abs _).symm
    _ < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
        Real.sqrt_lt_sqrt (by positivity) (by linarith [S2_pos hy])

theorem neg_one_lt_z_div_rho3 {y : Pt 4} (hy : y ∈ imgCart) :
    -1 < y 3 / √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) := by
  rw [lt_div_iff₀ (rho3_pos hy)]
  have : -y 3 < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
    calc -y 3 ≤ |y 3| := neg_le_abs _
      _ = √(y 3 ^ 2) := (Real.sqrt_sq_eq_abs _).symm
      _ < √(y 1 ^ 2 + y 2 ^ 2 + y 3 ^ 2) :=
          Real.sqrt_lt_sqrt (by positivity) (by linarith [S2_pos hy])
  linarith

/-! ## Maps between the domains -/

theorem toCart_mem {x : Pt 4} (hx : x ∈ domChart) : toCart x ∈ imgCart := by
  obtain ⟨hr, hθ1, hθ2, hφ1, hφ2⟩ := hx
  have hs : 0 < sin (x 2) := sin_pos_of_pos_of_lt_pi hθ1 hθ2
  have hR : 0 < x 1 * sin (x 2) := mul_pos hr hs
  rintro ⟨h2, h1⟩
  simp only [toCart_2, toCart_1] at h2 h1
  have hsφ : sin (x 3) = 0 := by
    rcases mul_eq_zero.mp h2 with h | h
    · exact absurd h hR.ne'
    · exact h
  rcases Real.sin_eq_zero_iff_cos_eq.mp hsφ with hc | hc
  · have := (Real.cos_eq_one_iff_of_lt_of_lt (by linarith) hφ2).mp hc
    linarith
  · rw [hc] at h1
    nlinarith

theorem fromCart_mem {y : Pt 4} (hy : y ∈ imgCart) : fromCart y ∈ domChart := by
  refine ⟨rho3_pos hy, ?_, ?_, ?_, ?_⟩
  · exact Real.arccos_pos.mpr (z_div_rho3_lt_one hy)
  · exact Real.arccos_lt_pi.mpr (neg_one_lt_z_div_rho3 hy)
  · show 0 < π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1))
    linarith [Real.neg_pi_div_two_lt_arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1))]
  · show π + 2 * arctan (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1)) < 2 * π
    linarith [Real.arctan_lt_pi_div_two (-(y 2) / (√(y 1 ^ 2 + y 2 ^ 2) - y 1))]

theorem mapsTo_toCart : Set.MapsTo toCart domChart imgCart := fun _ hx => toCart_mem hx
theorem mapsTo_fromCart : Set.MapsTo fromCart imgCart domChart := fun _ hy => fromCart_mem hy

theorem bijOn_toCart : Set.BijOn toCart domChart imgCart :=
  Set.InvOn.bijOn ⟨fun _ hx => fromCart_toCart hx, fun _ hy => toCart_fromCart hy⟩
    mapsTo_toCart mapsTo_fromCart

/-! ## Smoothness -/

theorem contDiffOn_toCart : ContDiffOn ℝ ∞ toCart domChart := by
  rw [contDiffOn_pi]; intro i
  fin_cases i <;> simp only [Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk, Fin.isValue, toCart_0,
    toCart_1, toCart_2, toCart_3] <;> fun_prop

