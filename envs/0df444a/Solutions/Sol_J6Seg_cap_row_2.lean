lemma tsum_int_le_geom' (f : ℤ → ℝ) (hf0 : ∀ n, 0 ≤ f n) (hz : f 0 = 0) {C r : ℝ}
    (hr0 : 0 ≤ r) (hr1 : r < 1) (hf : ∀ n, n ≠ 0 → f n ≤ C * r ^ n.natAbs) :
    Summable f ∧ ∑' n, f n ≤ 2 * C * r / (1 - r) := by
