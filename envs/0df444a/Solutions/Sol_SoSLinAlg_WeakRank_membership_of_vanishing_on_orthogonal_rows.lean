/-! ## Generic part: weights, components, monomial ideals, lifting -/
/-- Every monomial of `p` has `w`-weight at most `d`. -/
def DegLE (w : σ → ℕ) (d : ℕ) (p : MvPolynomial σ ℝ) : Prop :=
  ∀ s ∈ p.support, Finsupp.weight w s ≤ d

/-- The ideal generated by the monomials `μ l`. -/
def monIdeal {ι : Type*} (μ : ι → σ →₀ ℕ) : Ideal (MvPolynomial σ ℝ) :=
  Ideal.span (Set.range fun l => monomial (μ l) (1 : ℝ))

/-- `f = monomial μ 1 + (terms of strictly smaller weight)`. -/
def TopTerm (w : σ → ℕ) (f : MvPolynomial σ ℝ) (μ : σ →₀ ℕ) : Prop :=
  ∀ s ∈ (f - monomial μ (1 : ℝ)).support, Finsupp.weight w s < Finsupp.weight w μ

end SoSLinAlg.WeakRank.Dev.Leaf
end
