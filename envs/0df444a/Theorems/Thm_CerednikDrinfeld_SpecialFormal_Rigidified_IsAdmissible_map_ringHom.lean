-- title:
--   Admissibility of rigidified formal mathcal O_D-modules under base change
-- statement:
--   Fix a prime $p$, a commutative ring $O$ together with a ring homomorphism $\iota \colon \mathbb{Z}_{p^2} = W(\mathbb{F}_{p^2}) \to O$, and a formal $\mathcal O_D$-module $\Phi$ over $O/pO$, where $pO$ denotes the ideal generated by $p$; such a module consists of a commutative $2$-dimensional formal group law together with an action of $\mathbb{Z}_{p^2}$ by endomorphisms of the law and an endomorphism $\varpi$ satisfying $\varpi \circ \varpi = [p]$ and $\varpi \circ [a] = [\sigma(a)] \circ \varpi$ for the Witt-vector Frobenius $\sigma$. Let $B$ be a Noetherian commutative ring, $B'$ a commutative ring, $\psi \colon O \to B$ and $g \colon B \to B'$ ring homomorphisms, and let $t$ be a rigidified object over $B$, i.e. a triple consisting of a formal $\mathcal O_D$-module $t.X$ over $B$, a natural number $t.n$, and a system $t.\rho$ of two power series over $B/pB$. Assume $t$ is admissible for $(\iota,\psi)$: $t.X$ satisfies `IsSpecial` for `structureMap ι ψ`, satisfies `HasHeight 4`, and $t.\rho$ satisfies `IsIsogenyOfHeight` from `t.Φbar ψ` to `t.Xbar` of height $4 \cdot t.n$. Then the base change $t$ along $g$, namely $(t.X$ pushed forward along $g$, the same $t.n$, and $t.\rho$ pushed forward along the induced map $B/pB \to B'/pB')$, is admissible for $(\iota, g \circ \psi)$.
--
--   This is the base-change (functoriality) statement for the moduli problem of rigidified special formal $\mathcal O_D$-modules underlying the Čerednik–Drinfeld uniformisation: admissibility of a rigidified object is stable under pushing forward along an arbitrary homomorphism out of a Noetherian base. It is used throughout the construction of Cartier-theoretic data attached to edges and vertices of the Bruhat–Tits tree, where rigidified objects are transported between base rings.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CerednikDrinfeld_SpecialFormal_Rigidified_IsAdmissible_map_ringHom.lean

import Definitions.Def_CerednikDrinfeld_SpecialFormalModule

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

universe u v

open MvPowerSeries CerednikDrinfeld CerednikDrinfeld.SpecialFormal

theorem CerednikDrinfeld.SpecialFormal.Rigidified.IsAdmissible.map_ringHom
    {p : ℕ} [Fact p.Prime] {O : Type v} [CommRing O] {Φ : FormalODModule p (O ⧸ pIdeal p O)}
    (ι : Zp2 p →+* O) {B B' : Type u} [CommRing B] [IsNoetherianRing B] [CommRing B']
    (ψ : O →+* B) (g : B →+* B') (t : Rigidified p Φ B) (ht : t.IsAdmissible ι ψ) :
    (t.map g).IsAdmissible ι (g.comp ψ) := by sorry
