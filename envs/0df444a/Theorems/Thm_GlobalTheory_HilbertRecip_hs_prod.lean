theorem GlobalTheory.HilbertRecip.hs_prod (L : Finset (Place F)) (c : Place F → Fˣ) (q : Place F) (b : Fˣ)
    (h1 : q ∈ L → c q ∉ nrm q b) (h2 : ∀ p ∈ L, p ≠ q → c p ∈ nrm q b) :
    hs q (∏ p ∈ L, c p) b = if q ∈ L then -1 else 1 := by sorry
