set_option autoImplicit false

namespace N25.Endgame

/-- Every rational degree-one place is a cusp. -/
theorem _root_.solution
    (P : QPlace) (hP : P.deg = 1) :
    ModularCurve.IsCusp j25 P := by
  let : Finite ↥N25.M := N25.finite_M
  obtain ⟨D₂⟩ := nonempty_redDatum25 (ℓ := 2) (by decide)
  obtain ⟨D₃⟩ := nonempty_redDatum25 (ℓ := 3) (by decide)
  have hinj := redM25_two_injective D₂ (odd_natCard_M D₃)
  obtain ⟨G, hG, hcontract, _⟩ := exists_rational_geom_lift P hP
  obtain ⟨i, hi⟩ := rational_geom_place_eq_cusp D₂ hinj G hG
  have hc : ModularCurve.IsCusp (emb25 j25) G := by
    rw [hi]
    exact pG25_isCusp i
  change j25 ∉ P.toValuationSubring
  intro hm
  apply hc
  have hm' : j25 ∈ G.toValuationSubring.comap emb25.toRingHom := by
    rw [hcontract]
    exact hm
  exact hm'

end N25.Endgame
