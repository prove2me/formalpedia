theorem MetricCodes.Spherical.HigherHarmonicYoung.AllRankGTTransverseWrongBranchCompression.gtFullTransverseEmbedding_positiveRelativeCasimir_eq_zero_of_wrong_branch
    {r n : ℕ} (lam : Fin (r + 2) → ℕ)
    (mu nu : Fin (r + 1) → ℕ) (row : Fin (r + 1))
    (hmunu : mu = raiseWeight nu row)
    (hnu : Interlaces lam nu)
    (hnuGram : PositiveGelfandTsetlinFischerGram
      (n := n) lam nu hnu)
    (hn : 2 * (r + 1) + 5 ≤ n + 1)
    (branch : FullBranchWeight lam)
    (hwrong : branch ≠ fullBranchOfInterlaces nu hnu)
    (p : HarmonicYoungSpace (n := n) mu) :
    (gtFullTransverseEmbedding lam hn branch).toLinearMap.adjoint
      (gtRelativeCasimir (n := n + 1) lam
        (gtTransversePositiveSector lam mu nu row hmunu hnu hnuGram p)) = 0 := by sorry
