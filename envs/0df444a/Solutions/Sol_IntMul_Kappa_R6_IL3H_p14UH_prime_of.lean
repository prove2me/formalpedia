theorem RunQ.mono (H : RunQ I iprog σ U f g c) (hc : c ≤ c') : RunQ I iprog σ U f g c' :=
  fun s hs => (H s hs).mono hc

theorem RunQ.congr {g' : Fin HS → List ℤ} (H : RunQ I iprog σ U f g c) (he : g = g') :
    RunQ I iprog σ U f g' c := he ▸ H

