section
set_option linter.unusedSimpArgs false
open NLogN
open NLogN.BD
open IntMul.HvdH IntMul.HvdH.Ref NLogN.Asym
theorem solution (K N : ℕ) (hK : 20 ≤ K) (hN : 2 ^ (2 ^ (8 * K) + 1) ≤ N)
    (x y : ℕ) :
    let q := mkParams K N
    Bq q < 2 ^ q.P ∧ Nat.size (Bq q) ≤ q.p + q.p / 8 ∧
    -- (a)
    LBz (rU q x) (Bq q) ∧ LBz (rU q y) (Bq q) ∧
    LB (ecU q (rU q x)) (Bq q) ∧ LB (ecU q (rU q y)) (Bq q) ∧
    -- (b) the `S̃` stages
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecU q (rU q x))) (Bq q)) ∧
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecU q (rU q y))) (Bq q)) ∧
    (∀ k, LB (tensorGo ((axS q).take k) q.sdims (ecW q (rU q x) (rU q y))) (Bq q)) ∧
    -- (c) the `fermatW` arguments
    LB (ftIn q (ecU q (rU q x))) (Bq q) ∧ LB (ftIn q (ecU q (rU q y))) (Bq q) ∧
    LB (ftIn q (ecW q (rU q x) (rU q y))) (Bq q) ∧ LB (chirpL q) (Bq q) ∧
    -- (d)
    (∀ X Y, LB (fermatW q X Y) (2 ^ q.P)) ∧ (∀ X Y, LB (convL q X Y) (Bq q)) ∧
    (∀ X, LB (FtL q X) (Bq q)) ∧
    -- (b) the `B̃` stages
    (∀ X k, LB (tensorGo ((axB q).take k) q.tdims (FtL q X)) (Bq q)) ∧
    (∀ X, LB (fwdL q X) (Bq q)) ∧
    -- (e)
    LB (ecW q (rU q x) (rU q y)) (Bq q) ∧ LB (ecY q (rU q x) (rU q y)) (Bq q) ∧
    -- (f)
    LBz (exactConvL q (rU q x) (rU q y)) (Bq q) ∧
    LBz (crtOut q.s (2 * q.L - 1) (exactConvL q (rU q x) (rU q y))) (Bq q) := by
  intro q
  have h := NLogN.Asym.pf_of_large K hK N hN
  have hpe : q.p = 2 * q.b + 2 * q.logT + 6 * K * q.α ^ 2 + 8 * Nat.size q.b + 4 * K + 64 :=
    h.p_eq
  have hPe : q.P = 2 * q.p + q.logT + 8 := h.P_eq
  have hKe : K * q.e ≤ q.logT + K := h.Ke
  have qK : q.K = K := rfl
  have hJ := NLogN.BD.mk_HJ K N (by omega) h.e1
  have hbp : q.b ≤ q.p := by omega
  obtain ⟨a1, a2, a3, a4, -, -, -, -, -, -, a11, a12, a13, a14, -, a16, a17, a18, a19, a20⟩ :=
    NLogN.BD.refStep_bounds q hJ hbp x y
  have hBC : NLogN.BD.BC q = 2 ^ (q.p + 9) := by
    unfold NLogN.BD.BC
    rw [hPe, show 2 * q.p + q.logT + 8 = (q.p + q.logT) + (q.p + 8) by ring, pow_add,
      Nat.mul_div_cancel_left _ (by positivity), ← pow_succ']
  have hconv : 2 ^ q.P / 2 ^ (q.p + q.logT) ≤ NLogN.BD.BC q := by unfold NLogN.BD.BC; omega
  have hFW := NLogN.BD.BF_le_BW q hBC.ge
  have hBFq : NLogN.BD.BF q ≤ NLogN.BD.Bq q := by have := NLogN.BD.BW_le_Bq q; omega
  have hpq := NLogN.BD.pow_p_le_Bq q
  have hbq : 2 ^ q.b ≤ NLogN.BD.Bq q := (Nat.pow_le_pow_right (by norm_num) hbp).trans hpq
  -- `BX ≤ Bq`
  have hBX : NLogN.BD.BX q ≤ NLogN.BD.Bq q := by
    have hS := NLogN.BD.mk_S_le K N (by omega) h.e1
    have hSp : q.S ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2) ≤ 2 ^ q.p := by
      calc q.S ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2)
          ≤ (2 ^ (K * q.e)) ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2) :=
            Nat.mul_le_mul_right _ (Nat.pow_le_pow_left hS 2)
        _ = 2 ^ (2 * (K * q.e) + 2 * q.b + 6 * q.K * q.α ^ 2) := by
            rw [← pow_mul, ← pow_add]; ring_nf
        _ ≤ 2 ^ q.p := Nat.pow_le_pow_right (by norm_num) (by
            rw [qK]; omega)
    unfold NLogN.BD.BX
    have : NLogN.BD.BF q * q.S ^ 2 * 2 ^ (2 * q.b + 6 * q.K * q.α ^ 2) / 2 ^ q.p ≤ NLogN.BD.BF q := by
      apply Nat.div_le_of_le_mul
      rw [mul_assoc, mul_comm (2 ^ q.p)]
      exact Nat.mul_le_mul_left _ hSp
    have := NLogN.BD.BW_le_Bq q
    omega
  have hmaxW : NLogN.BD.BW q ≤ max (2 ^ q.p) (NLogN.BD.BW q) := le_max_right _ _
  have hmaxp : 2 ^ q.p ≤ max (2 ^ q.p) (NLogN.BD.BW q) := le_max_left _ _
  have hUx := NLogN.BD.ecU_rU_LB q hbp x
  have hUy := NLogN.BD.ecU_rU_LB q hbp y
  have hW := NLogN.BD.ecW_LB q hJ (NLogN.BD.rU q x) (NLogN.BD.rU q y)
  have stS : ∀ {L : List (ℤ × ℤ)} {B : ℕ}, NLogN.BD.LB L B → B ≤ max (2 ^ q.p) (NLogN.BD.BW q) →
      ∀ k, NLogN.BD.LB (tensorGo ((NLogN.BD.axS q).take k) q.sdims L) (NLogN.BD.Bq q) := by
    intro L B hL hB k
    refine (NLogN.BD.tensorGo_take_LB' _ (NLogN.BD.cSq_pos q) _ (NLogN.BD.axS_spec q) q.sdims hL k).mono ?_
    exact NLogN.BD.stageS_le_Bq q (by rw [NLogN.BD.axS_length]; exact min_le_right _ _) hB
  have ftI : ∀ {L : List (ℤ × ℤ)} {B : ℕ}, NLogN.BD.LB L B → B ≤ max (2 ^ q.p) (NLogN.BD.BW q) →
      NLogN.BD.LB (NLogN.BD.ftIn q L) (NLogN.BD.Bq q) := by
    intro L B hL hB
    have hSo : NLogN.BD.LB (tensorGo (NLogN.BD.axS q) q.sdims L) (NLogN.BD.cSq q ^ q.K * B) := by
      have := NLogN.BD.tensorGo_LB_mul _ (NLogN.BD.cSq_pos q) _ (NLogN.BD.axS_spec q) q.sdims hL
      rwa [NLogN.BD.axS_length] at this
    refine (NLogN.BD.FtL_in_LB q hSo).mono ?_
    unfold NLogN.BD.Bq
    calc 2 * (NLogN.BD.cSq q ^ q.K * B) ≤ 2 * (NLogN.BD.cSq q ^ q.K * max (2 ^ q.p) (NLogN.BD.BW q)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hB)
      _ = _ := by ring
  refine ⟨NLogN.BD.Bq_lt K N hK hN, NLogN.BD.Bq_size K N hK hN, a1.mono hbq, a2.mono hbq, a3.mono hpq, a4.mono hpq,
    stS hUx hmaxp, stS hUy hmaxp, stS hW hmaxW, ftI hUx hmaxp, ftI hUy hmaxp, ftI hW hmaxW,
    a11.mono hpq, a12, fun X Y => (a13 X Y).mono (hconv.trans ((NLogN.BD.BC_le_BF q).trans hBFq)),
    fun X => (a14 X).mono ((NLogN.BD.BC_le_BF q).trans hBFq), ?_, fun X => (a16 X).mono hBFq,
    a17.mono (NLogN.BD.BW_le_Bq q), a18.mono hBFq, a19.mono hBX, a20.mono hBX⟩
  intro X k
  refine (NLogN.BD.tensorGo_take_LB' _ (NLogN.BD.cBq_pos q) _ (NLogN.BD.axB_spec q hJ) q.tdims (NLogN.BD.FtL_LB q X) k).mono ?_
  exact (NLogN.BD.stageB_le_BF q (by rw [NLogN.BD.axB_length]; exact min_le_right _ _)).trans hBFq
end
