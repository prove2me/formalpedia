private theorem isUnit_add_of_not_isUnit {O : Type*} [CommRing O] [IsLocalRing O] {x y : O}
    (hx : ¬ IsUnit x) (hy : IsUnit y) : IsUnit (x + y) := by
  by_contra hxy
  have hx' : x ∈ maximalIdeal O := (IsLocalRing.mem_maximalIdeal x).mpr hx
  have hxy' : x + y ∈ maximalIdeal O := (IsLocalRing.mem_maximalIdeal _).mpr hxy
  have hy' : y ∈ maximalIdeal O := by
    have := (maximalIdeal O).sub_mem hxy' hx'
    rwa [add_sub_cancel_left] at this
  exact (IsLocalRing.mem_maximalIdeal y).mp hy' hy

private theorem isUnit_eval₂_of_map_residue_ne_zero
    {R O : Type*} [CommRing R] [IsLocalRing R] [IsAlgClosed (ResidueField R)] [CommRing O] [IsLocalRing O]
    (φ : R →+* O) (hloc : ∀ a ∈ maximalIdeal R, φ a ∈ maximalIdeal O)
    (t : O) (ht : ∀ c : R, IsUnit (t - φ c)) :
    ∀ P : Polynomial R, P.map (IsLocalRing.residue R) ≠ 0 → IsUnit (P.eval₂ φ t) := by

  have hsmall : ∀ Q : Polynomial R, Q.map (IsLocalRing.residue R) = 0 → Q.eval₂ φ t ∈ maximalIdeal O := by
    intro Q hQ
    rw [Polynomial.eval₂_eq_sum_range]
    refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_right _ _ (hloc _ ?_)
    rw [← IsLocalRing.residue_eq_zero_iff]
    have := congrArg (fun q => Polynomial.coeff q i) hQ
    simpa [Polynomial.coeff_map] using this

  suffices h : ∀ (n : ℕ) (P : Polynomial R), (P.map (IsLocalRing.residue R)).natDegree = n →
      P.map (IsLocalRing.residue R) ≠ 0 → IsUnit (P.eval₂ φ t) from fun P hP => h _ P rfl hP
  intro n
  induction n with
  | zero =>
    intro P hdeg hne

    obtain ⟨c, hc⟩ := Polynomial.natDegree_eq_zero.mp hdeg
    have hc0 : c ≠ 0 := by rintro rfl; apply hne; rw [← hc, map_zero]
    have hcoeff : IsLocalRing.residue R (P.coeff 0) = c := by
      rw [← Polynomial.coeff_map, ← hc, Polynomial.coeff_C_zero]
    have hu : IsUnit (φ (P.coeff 0)) := by
      apply (φ.isUnit_map)
      by_contra hnu
      exact hc0 (hcoeff ▸ (IsLocalRing.residue_eq_zero_iff _).mpr ((IsLocalRing.mem_maximalIdeal _).mpr hnu))
    have hrest : (P - Polynomial.C (P.coeff 0)).map (IsLocalRing.residue R) = 0 := by
      rw [Polynomial.map_sub, Polynomial.map_C, hcoeff, ← hc, sub_self]
    have hsplit : P.eval₂ φ t = (P - Polynomial.C (P.coeff 0)).eval₂ φ t + φ (P.coeff 0) := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_C, sub_add_cancel]
    rw [hsplit]
    exact isUnit_add_of_not_isUnit ((IsLocalRing.mem_maximalIdeal _).mp (hsmall _ hrest)) hu
  | succ n ih =>
    intro P hdeg hne

    have hdeg' : (P.map (IsLocalRing.residue R)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hne, hdeg]; exact_mod_cast Nat.succ_ne_zero n
    obtain ⟨cbar, hcbar⟩ := IsAlgClosed.exists_root _ hdeg'
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective cbar

    set Q : Polynomial R := P /ₘ (Polynomial.X - Polynomial.C c) with hQ
    have hmonic : (Polynomial.X - Polynomial.C c).Monic := Polynomial.monic_X_sub_C c
    have hP : P = (Polynomial.X - Polynomial.C c) * Q + Polynomial.C (P.eval c) := by
      have := Polynomial.modByMonic_add_div P (Polynomial.X - Polynomial.C c)
      rw [Polynomial.modByMonic_X_sub_C_eq_C_eval, add_comm] at this
      exact this.symm

    have heval : IsLocalRing.residue R (P.eval c) = 0 := by
      have : (P.map (IsLocalRing.residue R)).eval (IsLocalRing.residue R c) = 0 := hcbar
      rwa [Polynomial.eval_map, Polynomial.eval₂_at_apply] at this

    have hQmap : Q.map (IsLocalRing.residue R) =
        P.map (IsLocalRing.residue R) /ₘ (Polynomial.X - Polynomial.C (IsLocalRing.residue R c)) := by
      rw [hQ, Polynomial.map_divByMonic _ hmonic, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C]
    have hmonic' : (Polynomial.X - Polynomial.C (IsLocalRing.residue R c)).Monic := Polynomial.monic_X_sub_C _
    have hprod : P.map (IsLocalRing.residue R) =
        (Polynomial.X - Polynomial.C (IsLocalRing.residue R c)) * Q.map (IsLocalRing.residue R) := by
      have := Polynomial.modByMonic_add_div (P.map (IsLocalRing.residue R)) (Polynomial.X - Polynomial.C (IsLocalRing.residue R c))
      have h0 : Polynomial.eval (IsLocalRing.residue R c) (P.map (IsLocalRing.residue R)) = 0 := hcbar
      rw [Polynomial.modByMonic_X_sub_C_eq_C_eval, h0, map_zero, zero_add] at this
      rw [hQmap]
      exact this.symm
    have hQne : Q.map (IsLocalRing.residue R) ≠ 0 := by
      intro h0; apply hne; rw [hprod, h0, mul_zero]
    have hQdeg : (Q.map (IsLocalRing.residue R)).natDegree = n := by
      have := congrArg Polynomial.natDegree hprod
      rw [hmonic'.natDegree_mul' hQne, Polynomial.natDegree_X_sub_C, hdeg] at this
      omega
    have hQu : IsUnit (Q.eval₂ φ t) := ih Q hQdeg hQne

    have hsplit : P.eval₂ φ t = φ (P.eval c) + (t - φ c) * Q.eval₂ φ t := by
      conv_lhs => rw [hP]
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
        Polynomial.eval₂_C, add_comm]
    rw [hsplit]
    refine isUnit_add_of_not_isUnit ?_ ((ht c).mul hQu)
    exact (IsLocalRing.mem_maximalIdeal _).mp (hloc _ ((IsLocalRing.residue_eq_zero_iff _).mp heval))

private theorem valuationSubring_le_of_le_of_nonunits {K : Type*} [Field K] (V' V : ValuationSubring K)
    (hle : ∀ x : K, x ∈ V' → x ∈ V)
    (hdom : ∀ (x : K) (hx : x ∈ V'), ¬ IsUnit (⟨x, hx⟩ : ↥V') → ∀ hxV : x ∈ V, ¬ IsUnit (⟨x, hxV⟩ : ↥V)) :
    ∀ x : K, x ∈ V → x ∈ V' := by
  intro x hxV
  by_contra hx
  have hx0 : x ≠ 0 := fun h => hx (h ▸ V'.zero_mem)
  have hinv : x⁻¹ ∈ V' := (V'.mem_or_inv_mem x).resolve_left hx
  have hnu : ¬ IsUnit (⟨x⁻¹, hinv⟩ : ↥V') := by
    intro hu
    obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu
    have hw1 : x⁻¹ * (w : K) = 1 := by
      have h := congrArg Subtype.val hw
      simp only [MulMemClass.coe_mul, OneMemClass.coe_one] at h
      exact h
    have hwx : (w : K) = x := by
      have := eq_inv_of_mul_eq_one_right hw1
      rwa [inv_inv] at this
    exact hx (hwx ▸ w.2)
  have hxinvV : x⁻¹ ∈ V := hle _ hinv
  apply hdom _ hinv hnu hxinvV
  refine isUnit_iff_exists_inv.mpr ⟨⟨x, hxV⟩, ?_⟩
  apply Subtype.ext
  simp only [MulMemClass.coe_mul, OneMemClass.coe_one]
  exact inv_mul_cancel₀ hx0

private theorem vs_isUnit_iff {K : Type*} [Field K] (V : ValuationSubring K) (x : K) (hx : x ∈ V) :
    IsUnit (⟨x, hx⟩ : ↥V) ↔ x⁻¹ ∈ V ∧ x ≠ 0 := by
  constructor
  · intro hu
    obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu
    have hw1 : x * (w : K) = 1 := by
      have h := congrArg Subtype.val hw
      simp only [MulMemClass.coe_mul, OneMemClass.coe_one] at h
      exact h
    have hx0 : x ≠ 0 := fun h0 => by rw [h0, zero_mul] at hw1; exact zero_ne_one hw1
    refine ⟨?_, hx0⟩
    have : (w : K) = x⁻¹ := eq_inv_of_mul_eq_one_right hw1
    rw [← this]; exact w.2
  · rintro ⟨hinv, hx0⟩
    refine isUnit_iff_exists_inv.mpr ⟨⟨x⁻¹, hinv⟩, ?_⟩
    apply Subtype.ext
    simp only [MulMemClass.coe_mul, OneMemClass.coe_one]
    exact mul_inv_cancel₀ hx0

private theorem map_eval₂_intCast {S T : Type*} [CommRing S] [CommRing T] (M : Polynomial ℤ) (φ : S →+* T) (x : S) :
    φ (M.eval₂ (Int.castRingHom S) x) = M.eval₂ (Int.castRingHom T) (φ x) := by
  rw [Polynomial.hom_eval₂, RingHom.ext_int (φ.comp (Int.castRingHom S)) (Int.castRingHom T)]

private theorem coeffMap_jqModC' {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S) :
    coeffMap f (jqModC R) = jqModC S :=
  map_jqModC f

theorem j_mem_nodeRing
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ))
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ)) (s : ↥W) :
    letI : Algebra ↥k₀ ↥(fieldBar q M') :=
      ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).comp (algebraMap ↥k₀ (AlgebraicClosure ℚ))).toAlgebra
    ∀ (F₀' : IntermediateField ↥k₀ ↥(fieldBar q M'))
      (hjF₀ : (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ F₀')
      (O : Subring ↥F₀') (Wx : ValuationSubring ↥F₀')
      (hN3law : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
        (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
        (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
            ↥(modularFunctionFieldBar M'))) →
        ∃ hF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ F₀',
          (⟨_, hF⟩ : ↥F₀') ∈ Wx ∧
          (∀ hW : (⟨_, hF⟩ : ↥F₀') ∈ Wx, (⟨_, hW⟩ : ↥Wx) ∈ maximalIdeal ↥Wx ↔
            (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = 0) ∧
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
            (⟨_, hF⟩ : ↥F₀') ∈ O ∧
            ∀ (hO : (⟨_, hF⟩ : ↥F₀') ∈ O) (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A) (hcO : algebraMap ↥k₀ ↥F₀' c ∈ O),
              residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
              ¬ IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, hcO⟩))),
    (⟨_, hjF₀⟩ : ↥F₀') ∈ O := by
  intro F₀' hjF₀ O Wx hN3law
  have hJmem : coeffEmb (AlgebraicClosure ℚ) jq ∈ modularFunctionFieldBar M' :=
    coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))

  have hyA : coeffMap A.subtype (jqModC ↥A) = coeffEmb (AlgebraicClosure ℚ) jq := by
    rw [coeffMap_jqModC']
    show jqModC (AlgebraicClosure ℚ) = coeffMap (algebraMap ℚ (AlgebraicClosure ℚ)) jq
    rw [← jqModC_rat, coeffMap_jqModC']
  have hmem : coeffMap A.subtype (jqModC ↥A) ∈ modularFunctionFieldBar M' := by rw [hyA]; exact hJmem
  obtain ⟨hgi', hres'⟩ := hR₀ (jqModC ↥A) hmem
  have htrans : ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
      ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
        coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A) := by
    have aux : ∀ (z : LaurentSeries (AlgebraicClosure ℚ)) (hz : z ∈ modularFunctionFieldBar M'),
        z = coeffEmb (AlgebraicClosure ℚ) jq →
        (∃ h : (⟨z, hz⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A)) →
        ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) (jqModC ↥A) := by
      intro z hz e h
      subst e
      exact h
    exact aux _ hmem hyA ⟨hgi', hres'⟩
  obtain ⟨hgi, hres⟩ := htrans

  have hresj : (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = jGeomGen (ResidueField ↥A) M' := by
    apply Subtype.ext
    rw [hres, coeffMap_jqModC']
    rfl
  have hss : IsSupersingularPlace q M' (ResidueField ↥A)
      (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')) := (hW _).mp s.2
  have hreg : (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
      (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring := by
    rw [hresj]; exact hss.2.1.1

  obtain ⟨hF, -, -, h3⟩ := hN3law jq (modularFunctionField_le_full M' (jq_mem M')) hgi (fun _ h => h)
  exact (h3 hreg).1

set_option maxHeartbeats 8000000 in

theorem foreignSS
    (q : ℕ) [Fact q.Prime] (hq3 : q = 3) (M' : ℕ) [NeZero M'] (hqM' : ¬ q ∣ M')
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime q)
    (W : Finset (Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')))
    (hW : ∀ w, w ∈ W ↔ w ∈ ssPlaces q M' (ResidueField A))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (OSS : ↥W → ValuationSubring (fieldBar q M'))
    (hSS_over : ∀ (s : ↥W) (f : ↥(modularFunctionFieldBar M')) (hf : f ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) → 0 ≤ P.ord (f : ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨f, hf⟩ : modularFunctionFieldC (ResidueField A) M') ∈
          (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
        (IntermediateField.inclusion hle f : fieldBar q M') ∈ OSS s ∧
        ∀ a : A, residue A a =
            (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨f, hf⟩) →
          ∃ h : (IntermediateField.inclusion hle f : fieldBar q M')
              - algebraMap (AlgebraicClosure ℚ) (fieldBar q M') (a : AlgebraicClosure ℚ) ∈ OSS s,
            (⟨_, h⟩ : OSS s) ∈ maximalIdeal (OSS s))
    (k₀ : IntermediateField ℚ (AlgebraicClosure ℚ))
    (hκ : ∀ a : AlgebraicClosure ℚ, a ∈ A → ∃ c : ↥k₀, (c : AlgebraicClosure ℚ) ∈ A ∧
      ∃ h : a - c ∈ A, (⟨_, h⟩ : ↥A) ∈ maximalIdeal ↥A)
    (s : ↥W) :
    letI : Algebra ↥k₀ ↥(fieldBar q M') :=
      ((algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M')).comp (algebraMap ↥k₀ (AlgebraicClosure ℚ))).toAlgebra
    ∀ (F₀' : IntermediateField ↥k₀ ↥(fieldBar q M'))
      (O : Subring ↥F₀') (instLoc : IsLocalRing ↥O)
      (hN1const : ∀ x : ↥k₀, (x : (AlgebraicClosure ℚ)) ∈ A ↔ algebraMap ↥k₀ ↥F₀' x ∈ O)
      (Wx : ValuationSubring ↥F₀')
      (hN3law : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
        (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
        (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
            coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
            ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
          0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
            ↥(modularFunctionFieldBar M'))) →
        ∃ hF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ F₀',
          (⟨_, hF⟩ : ↥F₀') ∈ Wx ∧
          (∀ hW : (⟨_, hF⟩ : ↥F₀') ∈ Wx, (⟨_, hW⟩ : ↥Wx) ∈ maximalIdeal ↥Wx ↔
            (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') = 0) ∧
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ∈
              (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).toValuationSubring →
            (⟨_, hF⟩ : ↥F₀') ∈ O ∧
            ∀ (hO : (⟨_, hF⟩ : ↥F₀') ∈ O) (c : ↥k₀) (hc : (c : (AlgebraicClosure ℚ)) ∈ A) (hcO : algebraMap ↥k₀ ↥F₀' c ∈ O),
              residue A ⟨(c : (AlgebraicClosure ℚ)), hc⟩ =
                (s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩) →
              ¬ IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, hcO⟩))),
    ∃ T : Finset ↥F₀', (∀ t ∈ T, t ∈ O) ∧
      ∀ s' : ↥W, s' ≠ s → ¬ (∀ t ∈ T, ((t : ↥F₀') : ↥(fieldBar q M')) ∈ OSS s') := by
  intro F₀' O instLoc hN1const Wx hN3law
  classical
  haveI : IsLocalRing ↥O := instLoc

  have hconst : ∀ c : ↥k₀, ((algebraMap ↥k₀ ↥F₀' c : ↥F₀') : ↥(fieldBar q M')) =
      algebraMap (AlgebraicClosure ℚ) ↥(fieldBar q M') (c : AlgebraicClosure ℚ) := fun c => rfl

  have hlift : ∀ v : ResidueField ↥A, ∃ (c : ↥k₀) (hc : (c : AlgebraicClosure ℚ) ∈ A),
      residue A ⟨(c : AlgebraicClosure ℚ), hc⟩ = v := by
    intro v
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective v
    obtain ⟨c, hcA, h, hm⟩ := hκ (a : AlgebraicClosure ℚ) a.2
    refine ⟨c, hcA, ?_⟩
    symm
    rw [← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    have hrw : a - ⟨(c : AlgebraicClosure ℚ), hcA⟩ = ⟨(a : AlgebraicClosure ℚ) - c, h⟩ :=
      Subtype.ext (by simp only [AddSubgroupClass.coe_sub])
    rw [hrw]; exact hm

  have hcunit : ∀ (d : ↥k₀) (hd : (d : AlgebraicClosure ℚ) ∈ A), IsUnit (⟨(d : AlgebraicClosure ℚ), hd⟩ : ↥A) →
      ∀ hdO : algebraMap ↥k₀ ↥F₀' d ∈ O, IsUnit (⟨algebraMap ↥k₀ ↥F₀' d, hdO⟩ : ↥O) := by
    intro d hd hu hdO
    obtain ⟨v, hv⟩ := isUnit_iff_exists_inv.mp hu
    have hv1 : (d : AlgebraicClosure ℚ) * (v : AlgebraicClosure ℚ) = 1 := by
      have h := congrArg Subtype.val hv
      simp only [MulMemClass.coe_mul, OneMemClass.coe_one] at h
      exact h
    have hd0 : d ≠ 0 := by
      rintro rfl
      simp at hv1
    have hdinvA : ((d⁻¹ : ↥k₀) : AlgebraicClosure ℚ) ∈ A := by
      have hrw : ((d⁻¹ : ↥k₀) : AlgebraicClosure ℚ) = (v : AlgebraicClosure ℚ) := by
        rw [eq_inv_of_mul_eq_one_right hv1]; push_cast; rfl
      rw [hrw]; exact v.2
    have hdinvO : algebraMap ↥k₀ ↥F₀' d⁻¹ ∈ O := (hN1const _).mp hdinvA
    refine isUnit_iff_exists_inv.mpr ⟨⟨_, hdinvO⟩, ?_⟩
    apply Subtype.ext
    simp only [MulMemClass.coe_mul, OneMemClass.coe_one]
    rw [← map_mul, mul_inv_cancel₀ hd0, map_one]

  have hlocal : ∀ x y : ↥O, ¬ IsUnit x → IsUnit y → IsUnit (x + y) := by
    intro x y hx hy
    by_contra hxy
    have hx' : x ∈ maximalIdeal ↥O := (IsLocalRing.mem_maximalIdeal x).mpr hx
    have hxy' : x + y ∈ maximalIdeal ↥O := (IsLocalRing.mem_maximalIdeal _).mpr hxy
    have hy' : y ∈ maximalIdeal ↥O := by
      have := (maximalIdeal ↥O).sub_mem hxy' hx'
      rwa [add_sub_cancel_left] at this
    exact (IsLocalRing.mem_maximalIdeal y).mp hy' hy

  have hkey : ∀ s' : ↥W, s' ≠ s → ∃ t : ↥F₀', t ∈ O ∧ ((t : ↥F₀') : ↥(fieldBar q M')) ∉ OSS s' := by
    intro s' hs'
    obtain ⟨g, hg, hgi, hcusp, hregs, hregs', hne⟩ :=
      ModularCurve.FullLevel.exists_rational_integral_evalAt_ne_of_ne_ssPlaces_of_eq_three q hq3 M' hqM' A hA W hW hle R₀ hR₀
        s s' (Ne.symm hs')
    obtain ⟨hF, -, -, h3⟩ := hN3law g hg hgi hcusp
    obtain ⟨hO, hnu⟩ := h3 hregs
    obtain ⟨c₀, hc₀A, hc₀⟩ :=
      hlift ((s : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩))
    obtain ⟨a₀, ha₀A, ha₀⟩ :=
      hlift ((s' : Place (ResidueField A) (modularFunctionFieldC (ResidueField A) M')).evalAt (R₀.residue ⟨_, hgi⟩))
    have hc₀O : algebraMap ↥k₀ ↥F₀' c₀ ∈ O := (hN1const c₀).mp hc₀A
    have ha₀O : algebraMap ↥k₀ ↥F₀' a₀ ∈ O := (hN1const a₀).mp ha₀A

    have hnu₀ : ¬ IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, hc₀O⟩) := hnu hO c₀ hc₀A hc₀O hc₀
    have hdA : ((c₀ - a₀ : ↥k₀) : AlgebraicClosure ℚ) ∈ A := by
      have hrw : ((c₀ - a₀ : ↥k₀) : AlgebraicClosure ℚ) = (c₀ : AlgebraicClosure ℚ) - (a₀ : AlgebraicClosure ℚ) := by
        simp only [AddSubgroupClass.coe_sub]
      rw [hrw]; exact A.sub_mem hc₀A ha₀A
    have hdunit : IsUnit (⟨((c₀ - a₀ : ↥k₀) : AlgebraicClosure ℚ), hdA⟩ : ↥A) := by
      by_contra hnu'
      have hm : (⟨((c₀ - a₀ : ↥k₀) : AlgebraicClosure ℚ), hdA⟩ : ↥A) ∈ maximalIdeal ↥A :=
        (IsLocalRing.mem_maximalIdeal _).mpr hnu'
      apply hne
      rw [← hc₀, ← ha₀, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      have hrw : (⟨(c₀ : AlgebraicClosure ℚ), hc₀A⟩ : ↥A) - ⟨(a₀ : AlgebraicClosure ℚ), ha₀A⟩ =
          ⟨((c₀ - a₀ : ↥k₀) : AlgebraicClosure ℚ), hdA⟩ :=
        Subtype.ext (by simp only [AddSubgroupClass.coe_sub])
      rw [hrw]; exact hm
    have hu₁ : IsUnit ((⟨_, hc₀O⟩ : ↥O) - ⟨_, ha₀O⟩) := by
      have key := hcunit (c₀ - a₀) hdA hdunit ((hN1const _).mp hdA)
      have hrw : ((⟨_, hc₀O⟩ : ↥O) - ⟨_, ha₀O⟩) = ⟨algebraMap ↥k₀ ↥F₀' (c₀ - a₀), (hN1const _).mp hdA⟩ :=
        Subtype.ext (by simp only [AddSubgroupClass.coe_sub, map_sub])
      rw [hrw]; exact key
    have hu : IsUnit ((⟨_, hO⟩ : ↥O) - ⟨_, ha₀O⟩) := by
      have hrw : ((⟨_, hO⟩ : ↥O) - ⟨_, ha₀O⟩) = ((⟨_, hO⟩ : ↥O) - ⟨_, hc₀O⟩) + ((⟨_, hc₀O⟩ : ↥O) - ⟨_, ha₀O⟩) :=
        (sub_add_sub_cancel _ _ _).symm
      rw [hrw]; exact hlocal _ _ hnu₀ hu₁

    obtain ⟨w, hw⟩ := isUnit_iff_exists_inv.mp hu
    refine ⟨(w : ↥F₀'), w.2, fun hwSS => ?_⟩

    obtain ⟨-, hover⟩ := hSS_over s' ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩
      hgi hcusp hregs'
    obtain ⟨hmSS, hmax⟩ := hover ⟨(a₀ : AlgebraicClosure ℚ), ha₀A⟩ ha₀
    have h1 := congrArg (fun z : ↥O => ((z : ↥F₀') : ↥(fieldBar q M'))) hw
    simp only [MulMemClass.coe_mul, AddSubgroupClass.coe_sub, OneMemClass.coe_one] at h1
    rw [hconst a₀] at h1
    have hunitm : IsUnit (⟨_, hmSS⟩ : ↥(OSS s')) := by
      refine isUnit_iff_exists_inv.mpr ⟨⟨_, hwSS⟩, ?_⟩
      apply Subtype.ext
      simp only [MulMemClass.coe_mul, OneMemClass.coe_one]
      exact h1
    exact (IsLocalRing.mem_maximalIdeal _).mp hmax hunitm

  choose tf htf using hkey
  let f : ↥W → ↥F₀' := fun s' => if h : s' ≠ s then tf s' h else 0
  refine ⟨Finset.univ.image f, ?_, ?_⟩
  · intro t ht
    obtain ⟨s', -, rfl⟩ := Finset.mem_image.mp ht
    by_cases h : s' ≠ s
    · show (if h : s' ≠ s then tf s' h else 0) ∈ O
      rw [dif_pos h]; exact (htf s' h).1
    · show (if h : s' ≠ s then tf s' h else 0) ∈ O
      rw [dif_neg h]; exact O.zero_mem
  · intro s' hs' hall
    have hmem := hall (f s') (Finset.mem_image_of_mem f (Finset.mem_univ s'))
    have hf : f s' = tf s' hs' := dif_pos hs'
    rw [hf] at hmem
    exact (htf s' hs').2 hmem

private theorem eval₂_intCast_mem {F S : Type*} [Ring F] [SetLike S F] [SubringClass S F] (s : S) {x : F}
    (hx : x ∈ s) (M : Polynomial ℤ) : M.eval₂ (Int.castRingHom F) x ∈ s := by
  rw [Polynomial.eval₂_eq_sum_range]
  exact sum_mem fun i _ => mul_mem (by simp only [Int.coe_castRingHom]; exact intCast_mem s _) (pow_mem hx i)

private theorem place_ord_nonneg_of_mem {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) {f : F}
    (hf : f ∈ v.toValuationSubring) : 0 ≤ v.ord f := by
  rcases eq_or_ne f 0 with rfl | hf0
  · simp
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨n, u, hu⟩ :=
    IsDiscreteValuationRing.eq_unit_mul_pow_irreducible
      (x := (⟨f, hf⟩ : v.toValuationSubring)) (by simpa [Subtype.ext_iff] using hf0) hϖ
  have hcoe : f = ((u : v.toValuationSubring) : F) * ((ϖ : F) ^ (n : ℤ)) := by
    have h := congrArg (Subtype.val) hu
    push_cast at h
    rw [zpow_natCast]
    exact h
  rw [hcoe, v.ord_unit_smul_zpow u hϖ (n : ℤ)]
  exact Int.natCast_nonneg n

private theorem place_mem_of_ord_nonneg {K F : Type*} [Field K] [Field F] [Algebra K F] (v : Place K F) {f : F}
    (hf : f ≠ 0) (h : 0 ≤ v.ord f) : f ∈ v.toValuationSubring := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible v.toValuationSubring
  obtain ⟨u, hu⟩ := v.exists_unit_mul_zpow hf hϖ
  rw [hu, show v.ord f = (((v.ord f).toNat : ℕ) : ℤ) from (Int.toNat_of_nonneg h).symm, zpow_natCast]
  exact mul_mem (u : v.toValuationSubring).2 (pow_mem (ϖ : v.toValuationSubring).2 _)

theorem intPoly_mem_and_inv_mem_of_rational_law
    (q : ℕ) [Fact q.Prime] (M' : ℕ) [NeZero M']
    (A : ValuationSubring (AlgebraicClosure ℚ))
    (hle : modularFunctionFieldBar M' ≤ fieldBar q M')
    (R₀ : ConstantReduction A ↥(modularFunctionFieldBar M') (modularFunctionFieldC (ResidueField A) M'))
    (hR₀ : ∀ (y : LaurentSeries ↥A) (hy : coeffMap A.subtype y ∈ modularFunctionFieldBar M'),
      ∃ h : (⟨coeffMap A.subtype y, hy⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
        ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
          coeffMap (IsLocalRing.residue ↥A) y)
    (Wset : Set ↥(fieldBar q M'))
    (hW : ∀ (g : LaurentSeries ℚ) (hg : g ∈ modularFunctionFieldFull M')
      (hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers),
      (∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
          coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
          ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
        0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(modularFunctionFieldBar M')) :
          ↥(modularFunctionFieldBar M'))) →
      (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ≠ 0 →
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M')) ∈ Wset ∧
      (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ : ↥(fieldBar q M'))⁻¹ ∈ Wset)
    (M : Polynomial ℤ) (hM : M.map (Int.castRingHom (ResidueField ↥A)) ≠ 0) :
    M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ≠ 0 ∧
    M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) ∈ Wset ∧
    (M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')))⁻¹ ∈ Wset := by
  classical
  have hJmem : coeffEmb (AlgebraicClosure ℚ) jq ∈ modularFunctionFieldBar M' :=
    coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))

  set g : LaurentSeries ℚ := M.eval₂ (Int.castRingHom (LaurentSeries ℚ)) jq with hgdef
  have hg : g ∈ modularFunctionFieldFull M' :=
    modularFunctionField_le_full M' (eval₂_intCast_mem (modularFunctionField M') (jq_mem M') M)
  have hcast : ∀ {S T : Type} [CommRing S] [CommRing T] (φ : S →+* T) (x : S),
      φ (M.eval₂ (Int.castRingHom S) x) = M.eval₂ (Int.castRingHom T) (φ x) := by
    intro S T _ _ φ x
    rw [Polynomial.hom_eval₂, RingHom.ext_int (φ.comp (Int.castRingHom S)) (Int.castRingHom T)]
  have hG : coeffEmb (AlgebraicClosure ℚ) g =
      M.eval₂ (Int.castRingHom (LaurentSeries (AlgebraicClosure ℚ))) (coeffEmb (AlgebraicClosure ℚ) jq) := hcast _ _

  have hyA : coeffMap A.subtype (jqModC ↥A) = coeffEmb (AlgebraicClosure ℚ) jq := by
    rw [coeffMap_jqModC']
    show jqModC (AlgebraicClosure ℚ) = coeffMap (algebraMap ℚ (AlgebraicClosure ℚ)) jq
    rw [← jqModC_rat, coeffMap_jqModC']
  set y : LaurentSeries ↥A := M.eval₂ (Int.castRingHom (LaurentSeries ↥A)) (jqModC ↥A) with hydef
  have hy : coeffMap A.subtype y = coeffEmb (AlgebraicClosure ℚ) g := by
    rw [hG, hydef, hcast, hyA]
  have hmem : coeffMap A.subtype y ∈ modularFunctionFieldBar M' := by
    rw [hy]; exact coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg
  obtain ⟨hgi', hres'⟩ := hR₀ y hmem
  have htrans : ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
        ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
      ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
        coeffMap (IsLocalRing.residue ↥A) y := by
    have aux : ∀ (z : LaurentSeries (AlgebraicClosure ℚ)) (hz : z ∈ modularFunctionFieldBar M'),
        z = coeffEmb (AlgebraicClosure ℚ) g →
        (∃ h : (⟨z, hz⟩ : ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, h⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) y) →
        ∃ hgi : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
            ↥(modularFunctionFieldBar M')) ∈ R₀.integers,
          ((R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') : LaurentSeries (ResidueField A)) =
            coeffMap (IsLocalRing.residue ↥A) y := by
      intro z hz e h; subst e; exact h
    exact aux _ hmem hy ⟨hgi', hres'⟩
  obtain ⟨hgi, hres⟩ := htrans

  have hres_ne : (R₀.residue ⟨_, hgi⟩ : modularFunctionFieldC (ResidueField A) M') ≠ 0 := by
    intro h0
    have hval : coeffMap (IsLocalRing.residue ↥A) y = 0 := by
      rw [← hres, h0]; rfl
    rw [hydef, hcast, coeffMap_jqModC'] at hval
    apply ModularCurve.transcendental_jqModC (ResidueField ↥A)
    refine ⟨M.map (Int.castRingHom (ResidueField ↥A)), hM, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map,
      RingHom.ext_int ((algebraMap (ResidueField ↥A) (LaurentSeries (ResidueField ↥A))).comp
        (Int.castRingHom (ResidueField ↥A))) (Int.castRingHom _)]
    exact hval

  have hj0 : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ≠ 0 := by
    intro h0
    have := congrArg (fun z : ↥(modularFunctionFieldBar M') => (z : LaurentSeries (AlgebraicClosure ℚ)).coeff (-1)) h0
    simp only [coeffEmb_coeff, coeff_jq_neg_one, map_one, ZeroMemClass.coe_zero, HahnSeries.coeff_zero'] at this
    exact one_ne_zero this
  have hcusp : ∀ P : Place (AlgebraicClosure ℚ) ↥(modularFunctionFieldBar M'),
      0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) →
      0 ≤ P.ord ((⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(modularFunctionFieldBar M')) := by
    intro P hP
    have hjP : (⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ : ↥(modularFunctionFieldBar M')) ∈ P.toValuationSubring :=
      place_mem_of_ord_nonneg P hj0 hP
    have hgP := eval₂_intCast_mem P.toValuationSubring hjP M
    have heq : M.eval₂ (Int.castRingHom ↥(modularFunctionFieldBar M')) ⟨coeffEmb (AlgebraicClosure ℚ) jq, hJmem⟩ =
        (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
          ↥(modularFunctionFieldBar M')) := by
      apply Subtype.ext
      show _ = coeffEmb (AlgebraicClosure ℚ) g
      rw [hG]
      exact hcast (IntermediateField.val (modularFunctionFieldBar M')).toRingHom _
    rw [← heq]
    exact place_ord_nonneg_of_mem P hgP

  obtain ⟨hmemW, hinvW⟩ := hW g hg hgi hcusp hres_ne
  have heqF : (IntermediateField.inclusion hle ⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
      ↥(fieldBar q M')) = M.eval₂ (Int.castRingHom ↥(fieldBar q M')) (IntermediateField.inclusion hle (⟨coeffEmb (AlgebraicClosure ℚ) jq,
        coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) (modularFunctionField_le_full M' (jq_mem M'))⟩ :
        ↥(modularFunctionFieldBar M')) : ↥(fieldBar q M')) := by
    apply Subtype.ext
    refine Eq.trans ?_ (hcast (IntermediateField.val (fieldBar q M')).toRingHom _).symm
    show coeffEmb (AlgebraicClosure ℚ) g = _
    rw [hG]
    rfl
  refine ⟨?_, heqF ▸ hmemW, heqF ▸ hinvW⟩
  rw [← heqF]
  intro h0
  apply hres_ne
  have h0' : (⟨coeffEmb (AlgebraicClosure ℚ) g, coeffEmb_mem_laurentBaseChange (AlgebraicClosure ℚ) hg⟩ :
      ↥(modularFunctionFieldBar M')) = 0 := by
    have := congrArg (fun z : ↥(fieldBar q M') => (z : LaurentSeries (AlgebraicClosure ℚ))) h0
    apply Subtype.ext
    simpa using this
  have : (⟨_, hgi⟩ : ↥R₀.integers) = 0 := Subtype.ext h0'
  rw [this, map_zero]

