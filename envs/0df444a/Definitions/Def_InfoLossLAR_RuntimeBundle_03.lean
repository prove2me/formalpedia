  induction xs generalizing rest with
  | nil => simp
  | cons bit xs ih =>
    simp only [List.foldl_cons,_root_.Integration9_9.LARPlatformEncoding.markedStep,ite_true]
    rw [ih]
    simp only [List.reverse_cons,List.append_assoc,List.singleton_append]

