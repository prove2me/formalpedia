-- title:
--   Lemma 5.2.1(a) - the greedy payoff vector sums to f on every initial coalition
-- statement:
--   Suppose $(N,f)$ is a convex game, $\pi$ is a permutation of the players $N$, and $y^\pi$ is the
--   payoff vector generated by the greedy algorithm with $\pi$. Then
--   $$\sum_{i \in S_\pi(j)} y^\pi_i = f(S_\pi(j)) \qquad \text{for } j = 1,\dots,n.$$
--   This is part (a) of Lemma 5.2.1 (p. 212-213), the key partial-sum identity that Theorem 5.2.1's
--   proof of acceptability (and later results) build on.
-- source:
--   Topkis, Supermodularity and Complementarity, Princeton University Press, 2011, p. 212-213, Lemma 5.2.1(a)

import Mathlib
import Definitions.Def_Supermodularity_Cooperative_IsConvexGame
import Definitions.Def_Supermodularity_Cooperative_InitialCoalition
import Definitions.Def_Supermodularity_Cooperative_GreedyPayoff

namespace Supermodularity.Cooperative

theorem greedy_partial_sum_eq {n : ℕ} (f : Finset (Fin n) → ℝ) (hf : IsConvexGame f)
    (σ : Equiv.Perm (Fin n)) (j : ℕ) (hj1 : 1 ≤ j) (hjn : j ≤ n) :
    ∑ i ∈ InitialCoalition σ j, GreedyPayoff σ f i = f (InitialCoalition σ j) := by sorry

end Supermodularity.Cooperative
