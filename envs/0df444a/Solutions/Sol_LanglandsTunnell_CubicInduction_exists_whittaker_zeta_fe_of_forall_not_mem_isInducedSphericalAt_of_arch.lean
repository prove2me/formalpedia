private theorem _root_.LanglandsTunnell.CubicInduction.TwistConstants.hasConductorExponentAt_zero_of_isUnramifiedCharAt {F : Type} [Field F] [NumberField F]
    {μ : (AdeleRing (𝓞 F) F)ˣ →* ℂˣ} {v : HeightOneSpectrum (𝓞 F)} (h : IsUnramifiedCharAt μ v) :
    HasConductorExponentAt F v (localChar μ v) 0 := by
  refine (hasConductorExponentAt_zero_iff F v).mpr fun u hu => h u ?_ ?_
  · exact (mem_adicCompletionIntegers _ _ _).mpr hu.le
  · exact (mem_adicCompletionIntegers _ _ _).mpr (by rw [Units.val_inv_eq_inv_val, map_inv₀, hu, inv_one])

p2m_export "LanglandsTunnell.CubicInduction.TwistConstants" "hasConductorExponentAt_zero_of_isUnramifiedCharAt"
variable (K : Type) [Field K] [NumberField K] [Algebra (𝓞 ℚ) (𝓞 K)] [Algebra.IsIntegral (𝓞 ℚ) (𝓞 K)]
  (μ : (AdeleRing (𝓞 K) K)ˣ →* ℂˣ) (χ : (AdeleRing (𝓞 ℚ) ℚ)ˣ →* ℂˣ) (𝔓 : HeightOneSpectrum (𝓞 K))

private theorem hasConductorExponentAt_mul_comp_idelicNorm (hμ : IsUnramifiedCharAt μ 𝔓)
    (he : (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1) (a : ℕ)
    (ha : HasConductorExponentAt ℚ (𝔓.under (𝓞 ℚ)) (localChar χ (𝔓.under (𝓞 ℚ))) a) :
    HasConductorExponentAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) a := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hsplit := localChar_mul_comp_idelicNorm_genuineBaseChange ℚ K μ χ (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩
  have hw := hasConductorExponentAt_comp_norm_of_ramificationIdx_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ he _ a ha
  rw [show localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = _ from hsplit,
    show ∀ f g : (𝔓.adicCompletion K)ˣ →* ℂˣ, f * g = g * f from fun f g => mul_comm f g]
  exact hasConductorExponentAt_mul_of_hasConductorExponentAt_zero K _ _ _ a hw
    (hasConductorExponentAt_zero_of_isUnramifiedCharAt hμ)

private theorem pinnedExp_mul_comp_idelicNorm (hμ : IsUnramifiedCharAt μ 𝔓)
    (he : (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1) (a : ℕ)
    (ha : HasConductorExponentAt ℚ (𝔓.under (𝓞 ℚ)) (localChar χ (𝔓.under (𝓞 ℚ))) a) :
    pinnedExp K (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 =
      (a : ℤ) + addCharLevel (psiLocal ℚ (𝔓.under (𝓞 ℚ))) := by
  have hexp := hasConductorExponentAt_mul_comp_idelicNorm K μ χ 𝔓 hμ he a ha
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hlev : addCharLevel (psiLocal K 𝔓) = addCharLevel (psiLocal ℚ (𝔓.under (𝓞 ℚ))) :=
    addCharLevel_psiLocal_eq_of_ramificationIdx_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ he
  rw [pinnedExp, conductorExponentAt_eq_of_hasConductorExponentAt K 𝔓 hexp, hlev]

private theorem stdRootNumberAt_mul_comp_idelicNorm (hμ : IsUnramifiedCharAt μ 𝔓)
    (he : (𝔓.under (𝓞 ℚ)).asIdeal.ramificationIdx' 𝔓.asIdeal = 1) (a : ℕ) (B : (𝔓.adicCompletion K)ˣ →* ℂˣ)
    (hB : localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓 = localChar μ 𝔓 * B)
    (hBa : HasConductorExponentAt K 𝔓 B a) (hBu : ‖(B (uniformizerUnit K 𝔓) : ℂ)‖ = 1)
    (hμu : ‖(localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂ)‖ = 1) :
    stdRootNumberAt K 𝔓 (localChar (μ * χ.comp (genuineBaseChange ℚ K).idelicNorm) 𝔓) =
      ((localChar μ 𝔓 (uniformizerUnit K 𝔓) : ℂˣ) : ℂ) ^ ((a : ℤ) + addCharLevel (psiLocal ℚ (𝔓.under (𝓞 ℚ)))) *
        stdRootNumberAt K 𝔓 B := by
  obtain rfl := RatIntegersAlgebra.ratIntegers_algebra_eq K ‹Algebra (𝓞 ℚ) (𝓞 K)›
  have hlev : addCharLevel (psiLocal K 𝔓) = addCharLevel (psiLocal ℚ (𝔓.under (𝓞 ℚ))) :=
    addCharLevel_psiLocal_eq_of_ramificationIdx_eq_one ℚ K (𝔓.under (𝓞 ℚ)) ⟨𝔓, rfl⟩ he
  rw [hB, show ∀ f g : (𝔓.adicCompletion K)ˣ →* ℂˣ, f * g = g * f from fun f g => mul_comm f g,
    stdRootNumberAt_mul_of_hasConductorExponentAt_zero K 𝔓 B _ a hBa
      (hasConductorExponentAt_zero_of_isUnramifiedCharAt hμ) hBu hμu (psiLocal_ne_one K 𝔓), hlev]

