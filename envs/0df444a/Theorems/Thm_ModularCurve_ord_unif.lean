open AlgebraicCurve ModularCurve

theorem ModularCurve.ord_unif (K : Type) [Field K] (N : ℕ) [NeZero N]
    (x : AlgebraicCurve.Place K ↥(modularFunctionFieldC K N)) : x.ord (ModularCurve.unif N K x) = 1 := by sorry
