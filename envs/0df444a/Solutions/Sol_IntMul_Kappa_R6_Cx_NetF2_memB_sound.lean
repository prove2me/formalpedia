namespace IntMul.Kappa.R6.Cx.NetF2

open Matrix Finset Module NetLabels NetComplexOrtho NetComplexLabels NetComplexP8

/-! ## Popcount -/

lemma pcRec_eq (k n : ℕ) : pcRec k n = cntK k n := by
  induction k with
  | zero => simp [pcRec, cntK]
  | succ k ih => rw [pcRec, ih, cntK, cntK, Fin.sum_univ_castSucc]; simp

theorem allLT_spec (f : ℕ → Bool) : ∀ n, allLT f n = true → ∀ x < n, f x = true := by
  intro n
  induction n with
  | zero => intro _ x hx; omega
  | succ n ih =>
    intro h x hx
    simp only [allLT, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hx with hx | rfl
    · exact ih h.2 x hx
    · exact h.1

theorem swar12_eq : ∀ x < 4096, swar12 x = pcRec 12 x := fun x hx =>
  Nat.eq_of_beq_eq_true (allLT_spec _ _ swar12_chk x hx)

lemma m4095 : (4095 : ℕ) = 2 ^ 12 - 1 := rfl

lemma cntK_split (n : ℕ) : cntK 24 n = cntK 12 (n &&& 4095) + cntK 12 ((n >>> 12) &&& 4095) := by
  rw [cntK, show (24 : ℕ) = 12 + 12 from rfl, Fin.sum_univ_add, cntK, cntK]
  congr 1
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [m4095, Nat.testBit_and, Nat.testBit_two_pow_sub_one]
    simp [i.isLt]
  · refine Finset.sum_congr rfl fun i _ => ?_
    rw [m4095, Nat.testBit_and, Nat.testBit_two_pow_sub_one, Nat.testBit_shiftRight]
    simp [i.isLt, Nat.add_comm]

theorem pc24_eq (n : ℕ) : pc24 n = cntK 24 n := by
  have h1 : n &&& 4095 < 4096 := Nat.lt_succ_of_le Nat.and_le_right
  have h2 : (n >>> 12) &&& 4095 < 4096 := Nat.lt_succ_of_le Nat.and_le_right
  rw [pc24, swar12_eq _ h1, swar12_eq _ h2, pcRec_eq, pcRec_eq, cntK_split]

/-! ## Vectors -/

lemma cast_cntK (k n : ℕ) :
    ((cntK k n : ℕ) : ZMod 2) = ∑ i : Fin k, if n.testBit i then (1 : ZMod 2) else 0 := by
  rw [cntK]; push_cast; refine Finset.sum_congr rfl fun i _ => ?_; split_ifs <;> simp

theorem dot_bitv (a b : ℕ) : bitv a ⬝ᵥ bitv b = ((cntK 24 (a &&& b) : ℕ) : ZMod 2) := by
  rw [cast_cntK]
  simp only [dotProduct, bitv, Nat.testBit_and]
  refine Finset.sum_congr rfl fun i _ => ?_
  cases a.testBit i <;> cases b.testBit i <;> simp

lemma bitv_eq_sum (w : ℕ) : bitv w = ∑ i ∈ univ.filter (fun i : Fin 24 => w.testBit i), ev i := by
  funext j
  rw [Finset.sum_apply]
  simp only [ev, bitv]
  have : ∀ i : Fin 24, (if (j : ℕ) = (i : ℕ) then (1 : ZMod 2) else 0) = if j = i then 1 else 0 :=
    fun i => by simp [Fin.val_inj]
  simp_rw [this]
  rw [Finset.sum_ite_eq]
  simp

lemma bitv_apply (w : ℕ) (i : Fin 24) : bitv w i = if w.testBit i then 1 else 0 := rfl

lemma ev_apply (n : ℕ) (i : Fin 24) : ev n i = if (i : ℕ) = n then 1 else 0 := rfl

/-! ## Subspaces -/

lemma ev_mem_coordSp {X : ℕ} (i : Fin 24) (h : X.testBit i = true) : ev i ∈ coordSp X :=
  Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image.2 ⟨i, by simp [h], rfl⟩))

lemma gP_mem_pspSp {a b C : ℕ} (c : Fin 24) (h : C.testBit c = true) :
    ev a + ev b + ev c ∈ pspSp a b C :=
  Submodule.subset_span (Finset.mem_coe.2 (Finset.mem_image.2 ⟨c, by simp [h], rfl⟩))

lemma card_filter_testBit (X : ℕ) :
    (univ.filter fun i : Fin 24 => X.testBit i).card = cntK 24 X := by
  rw [Finset.card_filter]; rfl

lemma cast_even {n : ℕ} (h : n % 2 = 0) : ((n : ℕ) : ZMod 2) = 0 := by
  rw [← ZMod.natCast_mod, h]; rfl

/-! ## Codes and the Boolean checker -/

lemma FULL_eq : FULL = 2 ^ 24 - 1 := rfl

lemma testBit_FULL {i : ℕ} (hi : i < 24) : FULL.testBit i = true := by
  rw [FULL_eq, Nat.testBit_two_pow_sub_one]; simp [hi]

/-! ## Soundness -/

lemma testBit_lt_of_and_zero {w X : ℕ} (h : w &&& (FULL ^^^ X) = 0) {i : ℕ} (hi : i < 24)
    (hw : w.testBit i = true) : X.testBit i = true := by
  have := congrArg (fun n => n.testBit i) h
  simp only [Nat.testBit_and, Nat.testBit_xor, testBit_FULL hi, Nat.zero_testBit, hw] at this
  cases hX : X.testBit i <;> simp_all

lemma mem_perpSp {t : ℕ} {v : V24} : v ∈ perpSp t ↔ bitv t ⬝ᵥ v = 0 := by
  rw [perpSp, mem_orth_one]
  constructor
  · intro h; exact h _ (Submodule.mem_span_singleton_self _)
  · intro h x hx
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.1 hx
    rw [smul_dotProduct, h, smul_zero]

lemma cond_ite_mod {x : Bool} {p : ℕ} (h : cond x 1 0 = p % 2) :
    (if x = true then (1 : ZMod 2) else 0) = ((p : ℕ) : ZMod 2) := by
  rw [← ZMod.natCast_mod, ← h]; cases x <;> simp

theorem memB_sound_sol_aux : ∀ (c : Code), okC c = true → ∀ w, memB c w = true → bitv w ∈ dec c
  | .coord X, _, w, h => by
    simp only [memB, Nat.beq_eq] at h
    rw [dec, bitv_eq_sum]
    refine Submodule.sum_mem _ fun i hi => ev_mem_coordSp i ?_
    exact testBit_lt_of_and_zero h i.isLt (by simpa using hi)
  | .psp a b C, hok, w, h => by
    simp only [okC, Bool.and_eq_true, Nat.blt_eq, Bool.not_eq_true'] at hok
    obtain ⟨⟨⟨⟨ha, hb⟩, hab⟩, hCa⟩, hCb⟩ := hok
    have hab' : a ≠ b := Nat.ne_of_beq_eq_false (by simpa using hab)
    simp only [memB, Bool.and_eq_true, Nat.beq_eq] at h
    obtain ⟨⟨hD, hwa⟩, hwb⟩ := h
    have key : bitv w = ∑ c ∈ univ.filter (fun c : Fin 24 => (w &&& (FULL ^^^ (2 ^ a ||| 2 ^ b))).testBit c),
        (ev a + ev b + ev c) := by
      funext j
      rw [Finset.sum_apply]
      simp only [Pi.add_apply, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
      rw [card_filter_testBit, ← pc24_eq]
      have hsum : ∀ D : ℕ, (∑ x ∈ univ.filter (fun c : Fin 24 => D.testBit c), ev x j) =
          if D.testBit j then 1 else 0 := by
        intro D
        have : ∀ x : Fin 24, ev x j = if j = x then 1 else 0 := fun x => by simp [ev_apply, Fin.val_inj]
        simp_rw [this]; rw [Finset.sum_ite_eq]; simp
      rw [hsum, bitv_apply]
      simp only [Nat.testBit_and, Nat.testBit_xor, testBit_FULL j.isLt, Nat.testBit_or,
        Nat.testBit_two_pow, ev_apply]
      by_cases hja : (j : ℕ) = a
      · have hjb : (j : ℕ) ≠ b := fun e => hab' (hja.symm.trans e)
        rw [if_pos hja, if_neg hjb, hja, ← cond_ite_mod hwa]
        simp [hja.symm ▸ hjb]
      · by_cases hjb : (j : ℕ) = b
        · rw [if_neg hja, if_pos hjb, hjb, ← cond_ite_mod hwb]
          simp [hjb ▸ hja]
        · rw [if_neg hja, if_neg hjb]
          simp [Ne.symm hja, Ne.symm hjb]
    rw [dec, key]
    refine Submodule.sum_mem _ fun c hc => gP_mem_pspSp c ?_
    exact testBit_lt_of_and_zero hD c.isLt (by simpa using hc)
  | .perp t, _, w, h => by
    simp only [memB, Nat.beq_eq] at h
    rw [dec, mem_perpSp, dot_bitv, Nat.land_comm, ← pc24_eq, cast_even h]
  | .ext _, _, _, h => by simp [memB] at h

