/-- Compact discriminant core (no division at `x = 0`):
`alphaCore Q h F b A x = Q² F(x)² - x (1 - h x) b(x) F(x) (A'(x))²`. -/
noncomputable def alphaCore (Q h : ℝ) (F b A : ℝ → ℝ) (x : ℝ) : ℝ :=
  Q ^ 2 * F x ^ 2 - x * (1 - h * x) * b x * F x * deriv A x ^ 2

