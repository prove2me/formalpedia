variable {K : Type} [Field K] [NumberField K] [StarRing K]

theorem Formalism.DivisionValues.Rb.Qd_place_re {n D : ℕ} (P : Matrix (Fin D) (Fin n) K) (H : Matrix (Fin n) (Fin n) K)
    (XQ : InfinitePlace K → Matrix (Fin D) (Fin D) ℂ) (hXQ : IsQuotMetric P H XQ)
    (u : InfinitePlace K) :
    (Qd P H u.embedding).re = ((metMat XQ u).det.re)⁻¹ ∧ 0 < (metMat XQ u).det.re := by sorry
