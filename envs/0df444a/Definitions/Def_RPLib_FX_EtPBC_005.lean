-- ===== S4.Def_RP_EtPBC_A_CovPr14 =====
section

/-!
# S4-EtPBC-A, R4-T2 (A3n): the residue of a descended presentation on tensor charts

With `fh = σh ⊗ id : C ⊗ B → Ah ⊗ B`, `f' = σ ⊗ id : C ⊗ B → R' ⊗ B`, `θh : Pres (gmap fh gC) → Q` restricting to
`kap res` on `Ah ⊗ B`:
* `exists_cov`, **`hκT`** (the compatibility needed by `resid`), `lamT` (`lamT_apply`, `lamT_hlam`);
* **`resid_surj_T`**, **`resid_ker_T`**: the residue `resid fh f' gC θh (kap χ') _` is onto with kernel
  `Jt B χ' · Pres (gmap f' gC)`, when `ker θh = pI · Pres` with `pI ≤ ker res`.
-/

set_option autoImplicit false

open TensorProduct

noncomputable section

namespace RamanujanPetersson.EtPBC.Cov

universe u

variable {K A R' B Ah C Q : Type u} [Field K] [CommRing A] [CommRing R'] [Algebra A R'] [CommRing B] [Algebra A B]
  [CommRing Ah] [Algebra A Ah] [CommRing C] [Algebra A C] [CommRing Q]
  (χ : A →+* K) (χ' : R' →+* K) (res : Ah →+* K)
  (hres : ∀ a, res (algebraMap A Ah a) = χ a) (hχ' : ∀ a, χ' (algebraMap A R' a) = χ a)
  (ν : K →+* Q) (βQ : B →+* Q) (hβ : ∀ a, βQ (algebraMap A B a) = ν (χ a))

theorem exists_cov (s : K →+* R') (hs : ∀ k, χ' (s k) = k) (x : Ah ⊗[A] B) :
    ∃ a : R' ⊗[A] B, kap χ ν βQ hβ χ' hχ' a = kap χ ν βQ hβ res hres x := by
  induction x using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp only [map_zero]⟩
  | tmul y b => exact ⟨s (res y) ⊗ₜ b, by rw [kap_tmul, kap_tmul, hs]⟩
  | add x y hx hy =>
    obtain ⟨a, ha⟩ := hx
    obtain ⟨a', ha'⟩ := hy
    exact ⟨a + a', by rw [map_add, map_add, ha, ha']⟩

end RamanujanPetersson.EtPBC.Cov

end

end

-- ===== S4.Def_RP_EtPBC_A_FGS =====
section

/-!
# S4-EtPBC-A, R2(a,b): sections over compact etale objects, and local lifts on the whole fibre

* `exists_affine_refine'`: finite affine refinement of a covering sieve of a COMPACT etale object;
* `exists_cover_lift`: for an epimorphism `S.g` and a global section `q` of `S.X₃` on a compact `Y`, an affine etale
  surjection `V ⟶ Y` and a section of `S.X₂` over `V` lifting `q`;
* `isAffine_nv1`: `V ×_Y V` is affine when `V` is affine and `V ⟶ Y` is an affine morphism;
* `exists_common_rep'`, `exists_fib_at`, `exists_pullRepS`: local representation of a section of `ι^* G` over `U`;
* **`exists_fg_sec`**: a section `d` of `ι^* G` over a compact `U` is killed by every `p : G ⟶ Q` that kills
  finitely many sections `z x ∈ G(W x)` over affines.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite GrothendieckTopology Abelian

noncomputable section

namespace RamanujanPetersson.EtPBC

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtCompact.Supp

universe u

section Refine

variable {Y : Scheme.{u}}

variable {Λ : Type u} [CommRing Λ]

/-- **`V ×_Y V` is affine** for `V` affine and `V ⟶ Y` affine. -/
theorem isAffine_nv1 {V W : Y.Etale} (f : V ⟶ W) [IsAffine V.left] [IsAffineHom f.left] :
    IsAffine (nv f 1).left := by
  have hP := (nerve_isPullback f 0).map (Scheme.Etale.forget Y ⋙ CategoryTheory.Over.forget Y)
  have : IsIso (WidePullback.π (fun _ : Fin 1 => f) 0).left :=
    Functor.map_isIso (Scheme.Etale.forget Y ⋙ CategoryTheory.Over.forget Y) _
  have : IsAffine (widePullback W (fun _ : Fin 1 => V) (fun _ => f)).left :=
    IsAffine.of_isIso (WidePullback.π (fun _ : Fin 1 => f) 0).left
  have : IsAffine (pullback (WidePullback.base (fun _ : Fin 1 => f)).left f.left) := inferInstance
  let e := hP.isoPullback
  exact @IsAffine.of_isIso _ _ e.hom (Iso.isIso_hom e) this

end Refine

section Gen

end Gen

end RamanujanPetersson.EtPBC

end

end

-- ===== S4.Def_RP_EtPBC_A_DescK2 =====
section

/-!
# S4-EtPBC-A, R4-T1 (assembly): the torsor of an extension of `Λ` by `π_{s*} N`

For `q : Y_s ⟶ P_s` and a short exact `0 → q_* N → E' → Λ → 0` on `P_s`:
* `Epp` (`E'' = q^* E' ⊔_{q^* q_* N} N`), `aPP`, `bPP`, **`shortExact_Epp`**: `0 → N → E'' → Λ → 0`;
* `kap0`, **`a_kap0`**: a map `τ : E'' ⟶ ψ'_* N_Z` extending `uC` gives `κ₀ : E' ⟶ (ψ' ≫ q)_* N_Z` extending `q_*(uC)`;
* `kapU_eq`, `push_uC_comp`, `rU_congr`: `q_*(uC) = rU`;
* **`T1`**: there is a finite etale surjective `T ⟶ Y_s` such that every `ψ : U_s ⟶ T` over `Y_s` yields `κ₀` with
  `a' ≫ κ₀ = rUs` (the input of `T3d.HypT`, up to the lifting `T2`).
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.DescK

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtCompact RamanujanPetersson.EtCompact.Cech
  RamanujanPetersson.EtCompact.SgUnit RamanujanPetersson.EtPBC RamanujanPetersson.EtPBC.FBC

universe u

section RU

end RU

section Gen

end Gen

section Push

variable {Λ : Type u} [CommRing Λ] {Ys Ps : Scheme.{u}} (q : Ys ⟶ Ps) (N : ModuleCat.{u} Λ) {E' : EtSh Λ Ps}
  (a' : (push q Λ).obj (constSh Λ Ys N) ⟶ E') (b' : E' ⟶ unitSh Λ Ps) (w' : a' ≫ b' = 0)
  (hS' : (ShortComplex.mk a' b' w').ShortExact)

/-- `E'' = q^* E' ⊔_{q^* q_* N} N`. -/
abbrev Epp : EtSh Λ Ys := pushout ((pull q Λ).map a') ((pullAdj q Λ).counit.app (constSh Λ Ys N))

end Push

section T1

end T1

end RamanujanPetersson.EtPBC.DescK

end

end

-- ===== S4.Def_RP_EtPBC_A_EAlg =====
section

/-!
# S4-EtPBC-A, M4(E), ALG: maps out of a finitely generated sheaf via relations between germs

Fix `e : ∐ Λ[W j] ↠ F` (`J` finite). The generators `gen W e j ∈ F(W j)` are the images of the tautological
sections `taut Λ (W j) ∈ Λ[W j](W j)`. For sections `f j ∈ H(W j)` and `x : P`, `rel W H f x` is the linear map
`(Σ j, fibre of W j at x̄) →₀ Λ → H_x̄`, `l ↦ Σ l(j, a) · germ_a (f j)`.

* `free_stalk_span`, `coprod_span`, **`free_range`**: the stalk of `∐ Λ[W j]` at `x̄` is spanned by the germs of the
  tautological sections (the range of `rel` for `tg W` is everything);
* **`exists_desc`**: if at every `x` the relations of the generators `gen W e` are relations of `f`, there is
  `φ : F ⟶ H` with `φ (gen W e j) = f j`;
* **`mono_stalk`**: if at `x` the relations of `φ (gen W e j)` are relations of `gen W e`, then `φ` is injective on
  the stalk at `x̄`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenAlg

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC

universe u

variable {Λ : Type u} [CommRing Λ] {P : Scheme.{u}}

/-- **The stalk of a coproduct is spanned by the images of the stalks of the summands.** -/
theorem coprod_span {J : Type u} [Finite J] (G : J → EtSh Λ P) (x : P) (v : stalk Λ (∐ G) x) :
    v ∈ ⨆ j, LinearMap.range (((geomPtAt x).stalkF Λ).map (Sigma.ι G j)).hom := by
  set N := ⨆ j, LinearMap.range (((geomPtAt x).stalkF Λ).map (Sigma.ι G j)).hom
  have hc := isColimitOfPreserves ((geomPtAt x).stalkF Λ) (coproductIsCoproduct G)
  have h0 : (ModuleCat.ofHom N.mkQ : stalk Λ (∐ G) x ⟶ ModuleCat.of Λ (stalk Λ (∐ G) x ⧸ N)) = 0 := by
    refine hc.hom_ext fun j => ?_
    obtain ⟨j⟩ := j
    refine ModuleCat.hom_ext (LinearMap.ext fun w => ?_)
    change N.mkQ ((((geomPtAt x).stalkF Λ).map (Sigma.ι G j)).hom w) = 0
    exact (Submodule.Quotient.mk_eq_zero N).2 (Submodule.mem_iSup_of_mem j ⟨w, rfl⟩)
  have h1 := congrArg (fun f => f.hom v) h0
  exact (Submodule.Quotient.mk_eq_zero N).1 h1

end RamanujanPetersson.EtPBC.GenAlg

end

end

