    recoveredReciprocalPatch R h2 (Order13SingleSectionReciprocalPatch.DPrime R) =
      infinityRecoveredD R + 2 * infinityRecoveredZ R ^ 3 := by
  rw [Order13SingleSectionReciprocalPatch.DPrime,recoveredReciprocalPatch_algebraMap]
  simp only [Order13SingleSectionReciprocalPatch.dPrime,map_sub,map_add,map_pow,map_one,
    recoveredReciprocalBase_z,recoveredReciprocalBase_w,infinityRecoveredW]
  ring

theorem recoveredReciprocalPatch_mu (h2 : IsUnit (2 : R)) :
    recoveredReciprocalPatch R h2 (Order13SingleSectionReciprocalPatch.mu R) = infinityP R := by
  apply (infinityRecoveredD_isUnit R h2).mul_left_inj.mp
  have h := congrArg (recoveredReciprocalPatch R h2)
    (Order13SingleSectionReciprocalPatch.mu_mul_D R)
  rw [map_mul,map_mul,map_add,map_one,_root_.map_ofNat,
    recoveredReciprocalPatch_D,recoveredReciprocalPatch_z] at h
