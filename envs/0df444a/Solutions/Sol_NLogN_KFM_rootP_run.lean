theorem lpSt_G_i (s : IState HS) (i a : Fin HS) (La : List Item) (N k : ℕ) (c : ℤ) (hia : i ≠ a) :
    (lpSt s i a La N k c).G i = .int ((N : ℤ) - k) :: s.G i := by
