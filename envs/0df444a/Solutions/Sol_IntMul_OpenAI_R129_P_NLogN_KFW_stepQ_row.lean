  | .pop _, _ => rfl
  | .seq a b, h => by
    simp only [touch, List.mem_append] at h
    simp only [RS.sub, RS.sub_id σ a (fun i hi => h i (Or.inl hi)),
      RS.sub_id σ b (fun i hi => h i (Or.inr hi))]
  | .ite c a b, h => by
    simp only [touch, List.mem_append] at h
