  (simp only [J6Seg.Slab.cS_X, J6Seg.Slab.cS_Sv, J6Seg.Slab.cS_Cur, J6Seg.Slab.cS_T, J6Seg.Slab.cS_Cd, J6Seg.Slab.cS_A, J6Seg.Slab.cS_D, J6Seg.Slab.cS_W, J6Seg.Slab.cS_upd_X, J6Seg.Slab.cS_upd_Sv, J6Seg.Slab.cS_upd_Cur, J6Seg.Slab.cS_upd_T, J6Seg.Slab.cS_upd_Cd, J6Seg.Slab.cS_upd_A, J6Seg.Slab.cS_upd_D, J6Seg.Slab.cS_upd_W] at h3)
  rw [cS_upd_G _ _ _ _ _ _ _ _ _ _ (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) (by decide), hG G (by simp)] at h3
  refine (h1.seq (h2.seq h3)).mono' (by push_cast; rfl) ?_
  have c1 := NLogN.KFUU.dup_le_cU hn
  have c2 := NLogN.KFUU.dup_le_cU hn'
  have c3 := NLogN.KFUU.add_le_cU hn hn'
  omega

end fin

end J6Seg.Slab

