    have h := hprod ρ
    rw [hk, hk', ← pow_add] at h
    exact Nat.pow_right_injective hq h
  obtain ⟨i, j, hij, hd⟩ := exists_pad_exponents k k' ρ.d Nc hkk hN
  refine ⟨i, j, ?_, by simpa only [pad_d] using hd⟩
  rw [(hpad ρ i j).1, (hpad ρ i j).2, hk, hk', ← pow_add, ← pow_add]
  congr 1; omega

end balance
