namespace J6A.PA

open IntMul NLogN NLogN.KIL RS J6Seg.PJ IntMul.HvdH

/-! ## Expressions on `rg` -/

theorem onRg_mem {e : Ex HS} (h : OnRg e) {j : Fin HS} (hj : j ∈ e.regs) : j ∈ rg := by
  have := List.all_eq_true.1 h j hj
  simpa using this

section rgx
variable {v : Vr} {c : Cs} {W : ℕ}

theorem Rd_onRg {e : Ex HS} (h : OnRg e) : Rd c e := fun j hj => Or.inl (onRg_mem h hj)

theorem clean_onRg {e : Ex HS} (h : OnRg e) : e.Clean :=
  clean_of_regs (fun j hj => rg_lt (onRg_mem h hj))

theorem RB_onRg {e : Ex HS} (h : OnRg e) (hv : BV W v) : RB W v c e :=
  RB_of hv (fun j hj hn => absurd (onRg_mem h hj) hn)

/-- Assignment of a register from registers. -/
theorem Rn.asgR {i : Fin HS} (hi : i ∈ rg) {e : Ex HS} (he : OnRg e) (ho : okR v c e)
    (ht : Tame (2 ^ W) e) (hv : BV W v) :
    Rn (.asg i e) v c (· = Function.update v i (ev v c e)) c (J6Seg.PJ.cT e W) :=
  Rn.asg hi (Rd_onRg he) (clean_onRg he) ho ht hv (RB_onRg he hv)

theorem okR_regR {j : Fin HS} (h : j ∈ rg) : okR v c (.reg j) := okR_reg (Or.inl h)

theorem okR_plain : ∀ e : Ex HS, Plain e = true → okR v c e
  | .reg j, h => okR_regR (by simpa [Plain] using h)
  | .lit _, _ => trivial
  | .add a b, h => by
    simp only [Plain, Bool.and_eq_true] at h; exact ⟨okR_plain a h.1, okR_plain b h.2⟩
  | .mul a b, h => by
    simp only [Plain, Bool.and_eq_true] at h; exact ⟨okR_plain a h.1, okR_plain b h.2⟩
  | .neg a, h => by simp only [Plain] at h; exact okR_plain a h
  | .sel a x y, h => by
    simp only [Plain, Bool.and_eq_true] at h
    exact okR_sel (okR_plain a h.1.1) (okR_plain x h.1.2) (okR_plain y h.2)
  | .shl _ _, h | .quo _ _, h | .rem _ _, h | .pow2 _, h | .ndiv _ _, h | .nmod _ _, h => by
    simp [Plain] at h

end rgx

