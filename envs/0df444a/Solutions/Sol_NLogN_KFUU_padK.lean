  have H := NLogN.KFUU.padAllU_runs (I := I) (iprog := iprog) hM hpS hpT hST S T hF hS Z hZ w xs hxs hb
    (NLogN.KIL.encK s F) (NLogN.ints l ++ s.G 0) (NLogN.ints rS ++ s.G pS) (NLogN.ints rT ++ s.G pT) (NLogN.ints rN ++ s.G NLogN.KFUU.nR)
    (by simp [h0, NLogN.ints_append]) (by simp [hpS0, NLogN.ints_append]) (by simp [hpT0, NLogN.ints_append])
    (by simp [hN])
  rwa [NLogN.KFUU.ints_app_G, NLogN.KIL.encK_upd] at H
end
