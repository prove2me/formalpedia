theorem IntMul.OpenAI.Glue.sources_ok {n : ℕ} (hn : n0 ≤ n) (d' : ℕ) (hd' : d' ≤ dP n) :
    ∃ s : Fin (dP n) → ℕ, (∀ i, Odd (s i)) ∧ (∀ i j, i ≠ j → Nat.Coprime (s i) (s j)) ∧
      ∀ i : Fin (dP n), (4 * dP n - 2) * (if (i : ℕ) < d' then rP n / 2 else rP n) < 4 * dP n * s i ∧
        4 * dP n * s i ≤ (4 * dP n - 1) * (if (i : ℕ) < d' then rP n / 2 else rP n) := by sorry
