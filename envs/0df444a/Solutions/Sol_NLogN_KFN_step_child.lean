  unfold cWrapR
  have c1 := cAtom_X (r := r) (Ψ := Ψ) (Z := Z) (w := w + dw + (e + 2) * W) (D := e) hW hn hZΨ
  have hX : 2 ≤ Xf r Ψ (w + dw + (e + 2) * W + e + 4) := by unfold Xf; have := hZΨ (w + dw + (e + 2) * W + e + 4); omega
  have hWn : 1 ≤ W * n := Nat.mul_le_mul hW hn
