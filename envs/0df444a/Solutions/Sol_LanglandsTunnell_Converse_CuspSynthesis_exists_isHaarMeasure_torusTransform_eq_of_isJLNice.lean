  letI := TateLocal.localBorel K v
  haveI : BorelSpace (v.adicCompletion K) := ⟨rfl⟩
  haveI := t0651 v
  have hN : (2 : ℝ) ≤ (Ideal.absNorm v.asIdeal : ℝ) := by
    have h1 : 1 < Ideal.absNorm v.asIdeal := by
      refine lt_of_le_of_ne (Nat.one_le_iff_ne_zero.2 ?_) ?_
      · rw [Ne, Ideal.absNorm_eq_zero_iff]
        exact v.ne_bot
      · intro h
        exact v.isPrime.ne_top (Ideal.absNorm_eq_one_iff.1 h.symm)
