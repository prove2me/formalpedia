-- title:
--   Power-series expansion along a section with prescribed parameter
-- statement:
--   Let $R$ be a commutative ring and $A$ a commutative $R$-algebra which is formally smooth over $R$, and let $e\colon A\to R$ be an $R$-algebra homomorphism, with $I:=\ker e$ the kernel of the underlying ring homomorphism. Assume the cotangent module $I/I^2$ is free as an $R$-module and that its rank is $1$. Let $t_0\in A$ satisfy $e(t_0)=0$ and $I\le (t_0)+I^2$, where $(t_0)$ is the ideal of $A$ generated by $t_0$. Then there exists a ring homomorphism $\theta\colon A\to R[[X]]$ into the power series ring such that: $\theta$ sends the image of $r\in R$ in $A$ to the constant series $C(r)$; for every $n\in\mathbb{N}$ and every $a\in A$, all coefficients of $\theta(a)$ in degrees $k<n$ vanish if and only if $a\in I^n$; for every $n\in\mathbb{N}$ and every $p\in R[[X]]$ there is an $a\in A$ with $\operatorname{coeff}_k\theta(a)=\operatorname{coeff}_k p$ for all $k<n$; and, finally, $\theta(t_0)=X$. Thus $\theta$ induces isomorphisms $A/I^n\cong R[[X]]/(X^n)$ under which the prescribed generator $t_0$ of $I$ modulo $I^2$ becomes the variable exactly.
--
--   This is the formal-smoothness expansion of a pointed formally smooth algebra of relative cotangent rank one along its section, normalised so that a prescribed parameter $t_0$ is carried to the variable; it refines [`Algebra.FormallySmooth.exists_powerSeries_expansion_along_section`](thm.html#Algebra.FormallySmooth.exists_powerSeries_expansion_along_section), which produces such a $\theta$ with no control over $\theta(t_0)$. It is used to construct Laurent/power-series charts on schemes and, on modular curves, to produce a uniformiser together with a reading of the local ring into $R[[X]]$ at a point of the model.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_Algebra_FormallySmooth_exists_powerSeries_expansion_along_section_apply_eq_X.lean

import Mathlib

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

universe u v

theorem Algebra.FormallySmooth.exists_powerSeries_expansion_along_section_apply_eq_X
    {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A] [Algebra.FormallySmooth R A]
    (e : A →ₐ[R] R) [Module.Free R (RingHom.ker e.toRingHom).Cotangent]
    (he : Module.finrank R (RingHom.ker e.toRingHom).Cotangent = 1)
    (t₀ : A) (ht₀ : e t₀ = 0)
    (hgen : RingHom.ker e.toRingHom ≤ Ideal.span {t₀} ⊔ RingHom.ker e.toRingHom ^ 2) :
    ∃ θ : A →+* PowerSeries R,
      (∀ r : R, θ (algebraMap R A r) = PowerSeries.C r) ∧
      (∀ (n : ℕ) (a : A), (∀ k : ℕ, k < n → PowerSeries.coeff k (θ a) = 0) ↔
        a ∈ RingHom.ker e.toRingHom ^ n) ∧
      (∀ (n : ℕ) (p : PowerSeries R), ∃ a : A, ∀ k : ℕ, k < n →
        PowerSeries.coeff k (θ a) = PowerSeries.coeff k p) ∧
      θ t₀ = PowerSeries.X := by sorry
