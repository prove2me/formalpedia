  rw [h1, h2, iInf_congr hmult, finprod_eq_prod_of_fintype]
  let _ := Ideal.Quotient.field (Ideal.span ({t,x} : Set R))
  exact TypeDensity.pairwise_distinct_irreducible_pow_iInf (R ⧸ Ideal.span ({t,x} : Set R)) ι φ hmon hirr hinj m
