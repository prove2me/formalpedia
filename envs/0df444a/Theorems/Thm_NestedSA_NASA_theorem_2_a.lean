-- title:
--   Theorem 2(a) — the τ-weighted gradient-tracking error Σ τ_k E‖∇F(x^k) − z^k‖² is O(W + σ²Στ²)
-- statement:
--   Let $x^k,z^k,u^k$ be generated by Algorithm 1 under Assumptions 1 and 2 with constant $\beta>0$, with $X$ closed and convex and $F=f\circ g$ bounded below on $X$. Let $c,\gamma>0$ satisfy (3.16) with $a\beta-c\ge0$ and $\gamma b-2c\ge0$, and let the stepsizes be deterministic with $\tau_0=1/a$, $\tau_k\le1$, $b\tau_k\le1$ for all $k$, and (3.30):
--   $$\sum_{i=k+1}^N\tau_i\Gamma_i\le\bar c\,\Gamma_{k+1}\quad\forall k\ge0,\ \forall N\ge1,\qquad a\tau_k\le1/\sqrt2\quad\forall k\ge1,$$
--   for a constant $\bar c>0$, with $\Gamma_k$ from (3.27). Then for every $N\ge2$
--   $$\sum_{k=1}^N\tau_k\,\mathbb E\|\nabla F(x^k)-z^k\|^2\le a\bar c\Big(\frac1c\max(L_1,L_2)\hat\sigma^2+2a\sigma_J^2\sigma_s^2\Big)\sum_{k=0}^{N-1}\tau_k^2+\frac{a\bar c}c\max(L_1,L_2)\,W(x^0,z^0,u^0),$$
--   with $L_1,L_2$ from (3.32), $W$ the merit function (3.15) and $\hat\sigma^2$ the noise constant of Proposition 1(b); every $\|\nabla F(x^k)-z^k\|^2$ is integrable.
--
--   The running average $z^k$ thus tracks the true gradient $\nabla F(x^k)$ with an error controlled by the same quantities as the merit function.
--
--   **Formalization Note** The paper prints the left side with conditional expectations given $\mathcal F_{k-1}$ and a deterministic right side; the proof establishes the bound in total expectation, as stated. $\hat\sigma^2$ replaces the printed $\sigma^2$ (see Proposition 1(b)). The hypotheses $\tau_0=1/a$ (used in the proof, p. 15), $\tau_k\le1$, $b\tau_k\le1$ and the nonnegativity of the factors in (3.16) are used but not printed in the theorem.
-- source:
--   Ghadimi, Ruszczyński, Wang, A Single Time-Scale Stochastic Approximation Method for Nested Stochastic Optimization, arXiv:1812.01094v2, p. 14, Theorem 2(a), (3.30)–(3.32)

import Mathlib
import Definitions.Def_SpectralProjGrad_Shared_IsProjOnto
import Definitions.Def_NestedSA_NASA_Basic
import Definitions.Def_NestedSA_NASA_Model

open MeasureTheory ProbabilityTheory

namespace NestedSA.NASA

/-- Theorem 2(a), (3.31) (p. 14), in total expectation and with the corrected constant `σ̂²` (`sigmaHatSq`).
Let `x, z, u` be generated by Algorithm 1 under Assumptions 1 and 2 with constant `β`, `F = f ∘ g` bounded
below on `X`, constants `c, γ > 0` satisfying (3.16) with both factors nonnegative, deterministic stepsizes with
`τ₀ = 1/a`, `τ_k ≤ 1`, `bτ_k ≤ 1`, and (3.30) with `c̄ > 0`. Then for every `N ≥ 2`
`Σ_{k=1}^{N} τ_k E‖∇F(x^k) − z^k‖² ≤ ac̄((1/c) max(L₁, L₂) σ̂² + 2aσ_J²σ_s²) Σ_{k=0}^{N−1} τ_k²
  + (ac̄/c) max(L₁, L₂) W(x⁰, z⁰, u⁰)`, with every `‖∇F(x^k) − z^k‖²` integrable. -/
theorem theorem_2_a {n m : ℕ} {Ω : Type*} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (ℱ : Filtration ℕ mΩ)
    (X : Set (EuclideanSpace ℝ (Fin n))) (hX_cl : IsClosed X) (hX_cvx : Convex ℝ X)
    (P : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin n))
    (hP : SpectralProjGrad.Shared.IsProjOnto X P)
    (f : EuclideanSpace ℝ (Fin m) → ℝ) (g : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m))
    (Lf Lg Ldf Ldg : ℝ) (hA2 : Assumption2 f g Lf Lg Ldf Ldg)
    (hF_bdd : BddBelow ((fun x => f (g x)) '' X))
    (a b β : ℝ) (τ : ℕ → ℝ) (x0 z0 : EuclideanSpace ℝ (Fin n)) (u0 : EuclideanSpace ℝ (Fin m))
    (x z : ℕ → Ω → EuclideanSpace ℝ (Fin n)) (u G s : ℕ → Ω → EuclideanSpace ℝ (Fin m))
    (J : ℕ → Ω → (EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)))
    (hrun : IsStochRun X P a b β τ x0 z0 u0 x z u G s J)
    (σG σJ σs : ℝ) (hA1 : Assumption1 μ ℱ f g x z u G s J σG σJ σs)
    (c γ : ℝ) (hc : 0 < c) (hγ : 0 < γ) (hcβ : c ≤ a * β) (hcγ : 2 * c ≤ γ * b)
    (h316 : Lg ^ 2 * (a * Ldf + γ) ^ 2 ≤ 2 * (a * β - c) * (γ * b - 2 * c))
    (hτ_one : ∀ k, τ k ≤ 1) (hbτ : ∀ k, b * τ k ≤ 1) (hτ0 : τ 0 = 1 / a)
    (cbar : ℝ) (hcbar : 0 < cbar)
    (h330 : ∀ k N : ℕ, 1 ≤ N →
      ∑ i ∈ Finset.Icc (k + 1) N, τ i * Gamma a τ i ≤ cbar * Gamma a τ (k + 1))
    (haτ : ∀ k, 1 ≤ k → a * τ k ≤ 1 / Real.sqrt 2) :
    ∀ N : ℕ, 2 ≤ N →
      (∀ k, Integrable (fun ω => ‖gradF f g (x k ω) - z k ω‖ ^ 2) μ) ∧
      ∑ k ∈ Finset.Icc 1 N, τ k * ∫ ω, ‖gradF f g (x k ω) - z k ω‖ ^ 2 ∂μ ≤
        a * cbar * (1 / c * max (L1 a Lf Lg Ldf Ldg) (L2 Lg Ldf) *
            sigmaHatSq a b γ β Lf Lg Ldf Ldg σG σJ σs z0 + 2 * a * σJ ^ 2 * σs ^ 2) *
          (∑ k ∈ Finset.range N, τ k ^ 2)
        + a * cbar / c * max (L1 a Lf Lg Ldf Ldg) (L2 Lg Ldf) * W P f g X a γ β x0 z0 u0 := by sorry

end NestedSA.NASA
