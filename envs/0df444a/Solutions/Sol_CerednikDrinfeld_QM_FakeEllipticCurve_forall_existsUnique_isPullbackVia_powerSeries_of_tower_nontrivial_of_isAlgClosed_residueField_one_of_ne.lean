theorem ringHom_ext_powerSeries_sq {S : Type} [CommRing S] (θ₁ θ₂ : PowerSeries O →+* S)
    (hC : θ₁.comp (algebraMap O (PowerSeries O)) = θ₂.comp (algebraMap O (PowerSeries O)))
