  have hu1 := NumberField.Idele.unitPart_fst ℚ T a
  have huT := NumberField.Idele.unitPart_snd_of_mem ℚ T a
  have huU := NumberField.Idele.finitePartUnits_unitPart_mem_unitIdeles ℚ T a
  have hWa := hW L hLT hL a ha
