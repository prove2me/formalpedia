set_option autoImplicit false
suppress_compilation
variable {K : Type*} [Field K] {R : Subring K}
open BruhatTits
open Pointwise
open IsLocalRing
variable [IsDiscreteValuationRing R] [IsFractionRing R K]

theorem P2M_BruhatTits_Lattice_exists_GL_smul_eq_ntwist__of_isSimpleChain_cons_ce39f07d52dd (l : List (BruhatTits.Lattice R))
    (hlen : 2 ≤ l.length) (M : BruhatTits.Lattice R) (hMl : (M :: l).IsSimpleChain)
    (b : Basis (Fin 2) K (Fin 2 → K)) (ϖ : R) (hϖ : Irreducible ϖ)
    (hl : l.zipIdx.Forall (fun (L, n) ↦ L = (b.ntwist₂ hϖ (l.length - n - 1) 0).toLattice)) :
    ∃ (x : R), b.unipotent (ϖ ^ (l.length - 1) * x) • M =
      (b.ntwist₂ hϖ l.length 0).toLattice := by sorry

