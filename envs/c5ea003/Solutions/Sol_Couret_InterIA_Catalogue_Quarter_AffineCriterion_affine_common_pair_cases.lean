theorem p2m_local_affine_common_pair_cases (q : ℕ) (hq : 0 < q) (x : ZMod (4*q))
    (hx : x ∉ badParameters q) (u : (ZMod (4*q))ˣ) (v : ZMod (4*q))
    (hAB : (patternA q x).image (fun a => (u : ZMod (4*q))*a+v)=patternB q x) :
    (v=0 ∧ (u : ZMod (4*q))*q=q) ∨ (v=q ∧ (u : ZMod (4*q))*q= -q) := by
  have hv := affine_common_point_image q hq x hx u v 0 hAB (Or.inl rfl)
  simp only [mul_zero,zero_add] at hv
  have hu := affine_common_point_image q hq x hx u v q hAB (Or.inr rfl)
  have hne : (u : ZMod (4*q))*q ≠ 0 := by
    intro he
    exact quarter_ne_zero q hq ((Units.mul_right_inj u).mp (by simpa using he))
  rcases hv with rfl|rfl
  · simp only [add_zero] at hu
    exact Or.inl ⟨rfl,hu.resolve_left hne⟩
  · right
    refine ⟨rfl,?_⟩
    rcases hu with hu|hu
    · calc (u : ZMod (4*q))*q=((u : ZMod (4*q))*q+q)-q := by abel
           _= -q := by rw [hu]; simp
    · exact False.elim (hne (add_right_cancel (by simpa using hu : (u : ZMod (4*q))*q+q=0+q)))















