open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

theorem V3Asm.strict_iso_inf (p : ℕ) [Fact p.Prime] (𝔛 : ModularCurve.DRModelPackage p)
    (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (hϖ : IsLocalRing.maximalIdeal O = Ideal.span {((p : ℕ) : O)})
    (κ : Type) [Field κ] [CharP κ p] [IsAlgClosed κ] (toκ : O →+* κ)
    (H : V3Asm.SiteHyps p 𝔛 O κ toκ) (hξ : ∀ j, V3Asm.ξ p 𝔛 O κ toκ j ∈ (V3Asm.C p 𝔛 O κ toκ hϖ H).X0) :
    ∃ e : pullback ((V3Asm.comp p 𝔛 O κ toκ hϖ H hξ (Sum.inl 0)).subschemeι ≫ (V3Asm.toBase p 𝔛 O κ toκ hϖ H)) (Spec.map (CommRingCat.ofHom toκ)) ⟶ (𝔛.ratModel κ).C,
      IsIso e ∧ e ≫ (𝔛.ratModel κ).toBase = pullback.snd _ _ ∧
        e ≫ 𝔛.compInf κ ≫ ModularCurve.DRModel.baseChangeMap toκ = pullback.fst _ _ ≫ (V3Asm.comp p 𝔛 O κ toκ hϖ H hξ (Sum.inl 0)).subschemeι ≫ (V3Asm.toDR p 𝔛 O κ toκ hϖ H) := by sorry
