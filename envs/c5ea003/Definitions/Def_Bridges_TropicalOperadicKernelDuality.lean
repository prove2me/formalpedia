/-! ## VII. Composition and Rank Bounds -/

/-- The composed behavior table from two behavior tables via an intermediate type. -/
def composeBehavior
    {Ctx₁ X Ctx₂ Y : Type*}
    [Fintype Ctx₁] [Fintype X] [Fintype Ctx₂] [Fintype Y]
    [DecidableEq X]
    (B₁ : Ctx₁ → X → ℕ) (B₂ : Ctx₂ → Y → ℕ) :
    (Ctx₁ × Ctx₂) → Y → ℕ :=
  fun ⟨c₁, c₂⟩ y => Finset.sup Finset.univ (fun x => B₁ c₁ x * B₂ c₂ y)

