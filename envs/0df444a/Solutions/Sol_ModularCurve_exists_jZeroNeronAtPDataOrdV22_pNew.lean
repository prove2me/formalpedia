theorem solution
    (N₀ p : ℕ) [NeZero N₀] [Fact p.Prime] [NeZero p] (hpN₀ : ¬ p ∣ N₀)
    (A : ValuationSubring (AlgebraicClosure ℚ)) (hA : A.LiesOverPrime p) :
    ∃ 𝓓 : JZeroNeronAtPDataOrdV22 N₀ p hpN₀ A hA,
      (∀ (m : ℕ), ∀ x ∈ 𝓓.toric m,
      degeneracyPushforwardPair N₀ p 0 x = 0 ∧ degeneracyPushforwardPair N₀ p 1 x = 0) ∧
      (∃ c : ℕ, 0 < c ∧ ∀ (m : ℕ), ∀ x ∈ 𝓓.fin m,
      degeneracyPushforwardPair N₀ p 0 x = 0 → degeneracyPushforwardPair N₀ p 1 x = 0 →
        c • x ∈ 𝓓.toric m) ∧
      (∀ m : ℕ, 0 < m →
      Nat.card ↥(jZeroTorsion (N₀ * p) m) = m ^ (2 * 𝓓.toricRank + 2 * 𝓓.abelianRank)) := by
  obtain ⟨Λ, hΛ, O, 𝔓, -, -, hIU, hII⟩ := ModularCurve.exists_jZeroNeronObjectAtP_and_bridge N₀ p hpN₀ A hA
  obtain ⟨𝓓, htor, hfin, htR, haR, h0i, c₀, hc₀, h0ii⟩ :=
    ModularCurve.JZeroNeronObjectAtP.exists_jZeroNeronAtPDataOrdV22_toric_eq_fin_eq_of_forall_smul_sub_mem N₀ p hpN₀ A hA Λ hΛ O
      hIU hII
  obtain ⟨c₁, hc₁, hE2⟩ :=
    ModularCurve.JZeroNeronObjectAtP.exists_nsmul_mem_toricPts_of_mem_finPts N₀ p hpN₀ A hA Λ hΛ O
  refine ⟨𝓓, ?_, ⟨c₀ * c₁, Nat.mul_pos hc₀ hc₁, ?_⟩, ?_⟩
  · intro m x hx
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · exact h0i x hx
    · rw [htor m hm] at hx
      exact ModularCurve.JZeroNeronObjectAtP.toricPts_le_ker_degeneracyPushforwardPair
        N₀ p hpN₀ A hA Λ hΛ O m hm x hx
  · intro m x hx hα hβ
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · rw [mul_nsmul]
      exact AddSubgroup.nsmul_mem _ (h0ii x hx hα hβ) c₁
    · rw [hfin m hm] at hx
      rw [htor m hm, mul_comm c₀ c₁, mul_nsmul]
      exact AddSubgroup.nsmul_mem _ (hE2 m hm x hx hα hβ) c₀
  · intro m hm
    have hκ : ∀ w, w ∈ O.ssFinset ↔ w ∈ ssPlaces p N₀ (ResidueField ↥A) := O.mem_ssFinset_iff
    haveI : CharP (ResidueField ↥A) p := ValuationSubring.charP_residueField_of_liesOverPrime_def Fact.out hA
    rw [htR, haR]
    have h1 := ModularCurve.natCard_jZeroTorsion_mul_eq_pow_of_ssPlaces N₀ p hpN₀ (ResidueField ↥A)
      O.ssFinset hκ m hm
    rw [h1]
    have h2 : O.toricRank + 1 = O.ssFinset.card := O.toricRank_succ_eq_card
    congr 1
    omega

