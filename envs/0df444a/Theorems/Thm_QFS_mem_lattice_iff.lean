variable {d : ℕ}

/-! ## Lattices -/

lemma QFS.mem_lattice_iff {x : EuclideanSpace ℝ (Fin d)} :
    x ∈ lattice d ↔ ∀ i, ∃ n : ℤ, x i = n := by sorry
