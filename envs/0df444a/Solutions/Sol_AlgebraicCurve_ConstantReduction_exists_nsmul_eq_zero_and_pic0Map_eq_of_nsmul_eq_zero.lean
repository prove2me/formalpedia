p2m_open "AlgebraicCurve~genus"

private theorem natCast_ne_zero_of_residue {L : Type*} [Field L] (A : ValuationSubring L) (m : ℕ)
    (hm : (m : IsLocalRing.ResidueField A) ≠ 0) : (m : L) ≠ 0 := by
  intro h
  apply hm
  have h1 : (m : A) = 0 := by
    apply A.subtype_injective
    rw [map_natCast, map_zero]
    exact h
  rw [← map_natCast (IsLocalRing.residue A) m, h1, map_zero]

private theorem exists_nsmul_eq_of_ne_zero (K F : Type*) [Field K] [Field F] [Algebra K F] [IsAlgClosed K]
    (hfg : ∃ x : F, Transcendental K x ∧ FiniteDimensional (IntermediateField.adjoin K ({x} : Set F)) F)
    [IsCurveOver K F] (n : ℕ) (hn : n ≠ 0) (x : Pic0 K F) : ∃ y : Pic0 K F, n • y = x := by
  obtain ⟨p, hp⟩ := CharP.exists K
  haveI : CharP K p := hp
  rcases CharP.char_is_prime_or_zero K p with hprime | rfl
  · haveI : Fact p.Prime := ⟨hprime⟩
    exact Pic0.exists_nsmul_eq_of_charP K F p hfg n hn x
  · haveI : CharZero K := CharP.charP_to_charZero K
    exact Pic0.exists_nsmul_eq K F hfg n hn x

private def torsionEquiv (K F : Type*) [Field K] [Field F] [Algebra K F] (n : ℕ) :
    Pic0.torsion K F n ≃ {c : Pic0 K F // n • c = 0} :=
  Equiv.subtypeEquivRight fun c => by rw [Pic0.mem_torsion, natCast_zsmul]

private theorem exists_transcendental_residue_finiteDimensional
    {L : Type*} [Field L] {A : ValuationSubring L} {F : Type*} [Field F] [Algebra L F]
    {Fbar : Type*} [Field Fbar] [Algebra (IsLocalRing.ResidueField A) Fbar]
    (R : ConstantReduction A F Fbar)
    (hF : ∃ x : F, Transcendental L x ∧ FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F)
    [Nonempty (Place L F)] :
    ∃ x : Fbar, Transcendental (IsLocalRing.ResidueField A) x ∧
      FiniteDimensional (IntermediateField.adjoin (IsLocalRing.ResidueField A) ({x} : Set Fbar)) Fbar := by
  obtain ⟨f, hfres, hfL⟩ := R.exists_transcendental_residue
  obtain ⟨x, -, hxfd⟩ := hF
  haveI : FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F := hxfd
  haveI : FiniteDimensional (IntermediateField.adjoin L ({(f : F)} : Set F)) F :=
    finiteDimensional_adjoin_of_transcendental x hfL
  exact ⟨R.residue f, hfres, (R.finiteDimensional_and_finrank_adjoin_residue_le f hfres).1⟩

private theorem exists_nsmul_eq_zero_and_pic0Map_eq_of_prime
    {L : Type*} [Field L] [IsAlgClosed L] (A : ValuationSubring L)
    (F : Type*) [Field F] [Algebra L F]
    (hF : ∃ x : F, Transcendental L x ∧ FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F)
    (Fbar : Type*) [Field Fbar] [Algebra (IsLocalRing.ResidueField A) Fbar]
    (R : ConstantReduction A F Fbar) (hR : R.IsGood)
    (hFbar : ∃ x : Fbar, Transcendental (IsLocalRing.ResidueField A) x ∧
      FiniteDimensional (IntermediateField.adjoin (IsLocalRing.ResidueField A) ({x} : Set Fbar)) Fbar)
    [IsCurveOver L F] [IsCurveOver (IsLocalRing.ResidueField A) Fbar]
    (ℓ : ℕ) [Fact ℓ.Prime] (hℓ : (ℓ : IsLocalRing.ResidueField A) ≠ 0)
    (y : Pic0 (IsLocalRing.ResidueField A) Fbar) (hy : ℓ • y = 0) :
    ∃ z : Pic0 L F, ℓ • z = 0 ∧ R.pic0Map z = y := by
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) := A.isAlgClosed_residueField
  have hℓL : (ℓ : L) ≠ 0 := natCast_ne_zero_of_residue A ℓ hℓ
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hmap : ∀ c : {c : Pic0 L F // ℓ • c = 0}, ℓ • R.pic0Map c.1 = 0 := fun c => by
    rw [← map_nsmul, c.2, map_zero]
  let ψ : {c : Pic0 L F // ℓ • c = 0} → {c : Pic0 (IsLocalRing.ResidueField A) Fbar // ℓ • c = 0} :=
    fun c => ⟨R.pic0Map c.1, hmap c⟩
  have hinj : Function.Injective ψ := by
    intro a b hab
    have h1 : R.pic0Map (a.1 - b.1) = 0 := by
      rw [map_sub, sub_eq_zero]
      exact congrArg Subtype.val hab
    have h2 : ℓ • (a.1 - b.1) = 0 := by rw [nsmul_sub, a.2, b.2, sub_zero]
    have h3 := ConstantReduction.eq_zero_of_nsmul_eq_zero_of_pic0Map_eq_zero_of_isAlgClosed A F hF Fbar R hR ℓ hℓ
      (a.1 - b.1) h2 h1
    exact Subtype.ext (sub_eq_zero.mp h3)
  obtain ⟨hfin, hub⟩ :=
    Pic0.finite_and_card_torsion_le_of_natCast_ne_zero (IsLocalRing.ResidueField A) Fbar hFbar ℓ hℓ0 hℓ
  have hlb : ℓ ^ (2 * genusFF L F) ≤ Nat.card (Pic0.torsion L F ℓ) :=
    Pic0.pow_two_mul_genusFF_le_natCard_torsion_prime_of_natCast_ne_zero L F hF ℓ hℓL
  have hg : genusFF (IsLocalRing.ResidueField A) Fbar = genusFF L F := R.isGood_iff.mp hR
  have hcard : Nat.card {c : Pic0 (IsLocalRing.ResidueField A) Fbar // ℓ • c = 0} ≤
      Nat.card {c : Pic0 L F // ℓ • c = 0} := by
    calc Nat.card {c : Pic0 (IsLocalRing.ResidueField A) Fbar // ℓ • c = 0}
        ≤ ℓ ^ (2 * genusFF (IsLocalRing.ResidueField A) Fbar) := hub
      _ = ℓ ^ (2 * genusFF L F) := by rw [hg]
      _ ≤ Nat.card (Pic0.torsion L F ℓ) := hlb
      _ = Nat.card {c : Pic0 L F // ℓ • c = 0} := Nat.card_congr (torsionEquiv L F ℓ)
  haveI : Finite {c : Pic0 (IsLocalRing.ResidueField A) Fbar // ℓ • c = 0} := hfin
  obtain ⟨⟨z, hz⟩, hzy⟩ := (hinj.bijective_of_nat_card_le hcard).2 ⟨y, hy⟩
  exact ⟨z, hz, congrArg Subtype.val hzy⟩

private theorem exists_nsmul_eq_zero_and_pic0Map_eq_of_ne_zero
    {L : Type*} [Field L] [IsAlgClosed L] (A : ValuationSubring L)
    (F : Type*) [Field F] [Algebra L F]
    (hF : ∃ x : F, Transcendental L x ∧ FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F)
    (Fbar : Type*) [Field Fbar] [Algebra (IsLocalRing.ResidueField A) Fbar]
    (R : ConstantReduction A F Fbar) (hR : R.IsGood)
    (hFbar : ∃ x : Fbar, Transcendental (IsLocalRing.ResidueField A) x ∧
      FiniteDimensional (IntermediateField.adjoin (IsLocalRing.ResidueField A) ({x} : Set Fbar)) Fbar)
    [IsCurveOver L F] [IsCurveOver (IsLocalRing.ResidueField A) Fbar] (m : ℕ) :
    (m : IsLocalRing.ResidueField A) ≠ 0 → ∀ y : Pic0 (IsLocalRing.ResidueField A) Fbar, m • y = 0 →
      ∃ z : Pic0 L F, m • z = 0 ∧ R.pic0Map z = y := by
  induction m using Nat.strong_induction_on with
  | _ m ih =>
  intro hm y hy
  rcases Nat.lt_or_ge m 2 with hm2 | hm2
  · interval_cases m
    · simp at hm
    · refine ⟨0, by simp, ?_⟩
      rw [map_zero]
      rw [one_nsmul] at hy
      exact hy.symm
  · obtain ⟨p, hp, hpm⟩ := Nat.exists_prime_and_dvd (show m ≠ 1 by omega)
    obtain ⟨b, rfl⟩ := hpm
    haveI : Fact p.Prime := ⟨hp⟩
    have hpk : (p : IsLocalRing.ResidueField A) ≠ 0 := fun h => hm (by rw [Nat.cast_mul, h, zero_mul])
    have hbk : (b : IsLocalRing.ResidueField A) ≠ 0 := fun h => hm (by rw [Nat.cast_mul, h, mul_zero])
    have hb0 : b ≠ 0 := by
      rintro rfl
      exact hbk Nat.cast_zero
    have hblt : b < p * b := by nlinarith [hp.one_lt, Nat.pos_of_ne_zero hb0]
    have h1 : p • (b • y) = 0 := by rw [smul_smul, hy]
    obtain ⟨z₁, hz₁, hz₁y⟩ := exists_nsmul_eq_zero_and_pic0Map_eq_of_prime A F hF Fbar R hR hFbar p hpk (b • y) h1
    obtain ⟨z₂, hz₂⟩ := exists_nsmul_eq_of_ne_zero L F hF b hb0 z₁
    have h3 : b • (y - R.pic0Map z₂) = 0 := by rw [nsmul_sub, ← map_nsmul, hz₂, hz₁y, sub_self]
    obtain ⟨z₃, hz₃, hz₃y⟩ := ih b hblt hbk (y - R.pic0Map z₂) h3
    refine ⟨z₂ + z₃, ?_, ?_⟩
    · rw [nsmul_add, ← smul_smul, hz₂, hz₁, ← smul_smul, hz₃, smul_zero, add_zero]
    · rw [map_add, hz₃y]
      abel

theorem solution
    {L : Type*} [Field L] [IsAlgClosed L] (A : ValuationSubring L)
    (F : Type*) [Field F] [Algebra L F]
    (hF : ∃ x : F, Transcendental L x ∧ FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F)
    (Fbar : Type*) [Field Fbar] [Algebra (IsLocalRing.ResidueField A) Fbar]
    (R : ConstantReduction A F Fbar) (hR : R.IsGood)
    (m : ℕ) (hm : (m : IsLocalRing.ResidueField A) ≠ 0)
    (y : Pic0 (IsLocalRing.ResidueField A) Fbar) (hy : m • y = 0) :
    ∃ z : Pic0 L F, m • z = 0 ∧ R.pic0Map z = y := by
  haveI : IsAlgClosed (IsLocalRing.ResidueField A) := A.isAlgClosed_residueField
  haveI : IsCurveOver L F := by
    obtain ⟨x, hx, hxfd⟩ := hF
    haveI : FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F := hxfd
    exact isCurveOver_of_isAlgClosed_of_transcendental x hx
  haveI : Nonempty (Place L F) := by
    obtain ⟨x, hx, hxfd⟩ := hF
    haveI : FiniteDimensional (IntermediateField.adjoin L ({x} : Set F)) F := hxfd
    haveI : Algebra.EssFiniteType L F := essFiniteType_of_transcendental_of_finiteDimensional hx hxfd
    obtain ⟨hne, -⟩ := stichtenothGenusExists_of_isCurveOver (constantsAreBase_of_isAlgClosed_of_transcendental x hx)
    exact hne
  have hFbar := exists_transcendental_residue_finiteDimensional R hF
  haveI : IsCurveOver (IsLocalRing.ResidueField A) Fbar := by
    obtain ⟨x, hx, hxfd⟩ := hFbar
    haveI : FiniteDimensional (IntermediateField.adjoin (IsLocalRing.ResidueField A) ({x} : Set Fbar)) Fbar := hxfd
    exact isCurveOver_of_isAlgClosed_of_transcendental x hx
  exact exists_nsmul_eq_zero_and_pic0Map_eq_of_ne_zero A F hF Fbar R hR hFbar m hm y hy

end S_AlgebraicCurve_ConstantReduction_exists_nsmul_eq_zero_and_pic0Map_eq_of_nsmul_eq_zero
