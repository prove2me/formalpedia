/-!
# KFM S9: the cost of the source and inverse lists

Write `K = 10^7 (B+2)^2`. Assume every atom is at most `A`, with `A^k < 2^B` for `k ≤ 8`.

* **`pmLoop_cost`**: the product loop costs at most `(i+1)·40K`.
* **`sumLoop_cost`**: the sum loop costs at most `(s+1)·40K`.
* **`muB_cost`**: one inverse costs at most `(i+s+4)·40K`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFM

open IntMul RS

/-! ## The product loop -/

/-! ## The sum loop -/

/-! ## Push loops -/

theorem pushLoop_cost_sol_aux (Bd : RS) (dst : Fin HS) (hdO : dst ≠ mOc) (s : IState HS) (d : ℕ)
    (LD : List Item) (hD : s.G zD = .int (d : ℤ) :: LD) (v : ℕ → ℤ)
    (hB : ∀ (L : List Item) (c : ℕ), 1 ≤ c → c ≤ d →
      Bd.ok ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) ∧
      Bd.run ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) =
        ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)).upd dst
          (.int (v (c - 1)) :: L ++ s.G dst))
    (B C : ℕ) (hzd : zsz (d : ℤ) ≤ B) (hB1 : 1 ≤ B)
    (hbc : ∀ (L : List Item) (c : ℕ), 1 ≤ c → c ≤ d →
      Bd.cost ((s.upd dst (L ++ s.G dst)).upd mOc (.int (c : ℤ) :: s.G mOc)) ≤ C) :
    (RS.rep mOc (.reg zD) Bd).cost s ≤ 2 * 10 ^ 7 * (B + 2) ^ 2 +
      d * (C + 4 * 10 ^ 7 * (B + 2) ^ 2 + 30) + 32 := by
  set St : ℕ → IState HS := fun k => s.upd dst (ints (pushL v d k) ++ s.G dst) with hSt
  have H := loopI_cost mOc (.reg zD) Bd s d St (by simp [Ex.eval, IState.top_eq hD])
    (by simp [hSt, pushL])
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      have := hB (ints (pushL v d k)) (d - k) (by omega) (by omega)
      refine ⟨this.1, ?_⟩
      rw [this.2]
      apply IState.ext' _ (by simp [hSt]) (by simp [hSt])
      intro j
      simp only [hSt, IState.upd_G]
      by_cases j1 : j = mOc
      · subst j1; simp [Ne.symm hdO]
      by_cases j2 : j = dst
      · subst j2
        simp only [if_pos rfl, if_neg hdO]
        rw [pushL_succ v d k hk, ints_cons]
        rfl
      · simp [j1, j2])
    B C hzd hB1 (by show zsz (s.top zD) ≤ B; rw [IState.top_eq hD]; exact hzd)
    (by
      intro k hk
      have hc : ((d : ℤ) - k) = ((d - k : ℕ) : ℤ) := by omega
      simp only [lI, hc]
      exact hbc _ _ (by omega) (by omega))
  have hs : (Ex.reg zD : Ex HS).size = 1 := rfl
  rw [hs] at H
  have e : (1 + 1) * 10 ^ 7 * (B + 2) ^ 2 = 2 * 10 ^ 7 * (B + 2) ^ 2 := by ring
  rw [e] at H
  exact H

end NLogN.KFM

