theorem ModularCurve.placeWidthChar_eq_one_of_mem_ssPlaces_of_eq_three_of_dvd
    {q : ℕ} [Fact q.Prime] (hq3 : q = 3) {M' : ℕ} [NeZero M']
    {K : Type*} [Field K] [CharP K q] [IsAlgClosed K] [DecidableEq K]
    (hqM' : ¬ q ∣ M')
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hℓ12 : ℓ % 12 = 11) (hℓM' : ℓ ∣ M')
    {w : Place K (modularFunctionFieldC K M')} (hw : w ∈ ssPlaces q M' K) :
    placeWidthChar q M' w = 1 := by sorry
