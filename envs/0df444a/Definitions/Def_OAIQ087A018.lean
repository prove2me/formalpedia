-- module Solutions.OAIQ087_MC.MaxCut_PCP_ClauseVerifier
attribute [-instance] _root_.OAI.MaxCutGames.Foundations.Hastad.SourceContexts.clauseAnswerFintype _root_.OAI.MaxCutGames.Foundations.Hastad.SourceContexts.clauseAnswerInhabited _root_.OAI.MaxCutGames.Foundations.Hastad.SourceContexts.slotFintype _root_.OAI.MaxCutGames.Foundations.Hastad.SourceContexts.slotInhabited
