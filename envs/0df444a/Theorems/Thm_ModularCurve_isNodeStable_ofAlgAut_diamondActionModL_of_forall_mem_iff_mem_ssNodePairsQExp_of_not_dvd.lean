theorem ModularCurve.isNodeStable_ofAlgAut_diamondActionModL_of_forall_mem_iff_mem_ssNodePairsQExp_of_not_dvd
    (K : Type*) [Field K] [IsAlgClosed K] (p : ℕ) [Fact p.Prime] [CharP K p]
    (N : ℕ) [NeZero N] (hpN : ¬ p ∣ N) (H' : Subgroup (ZMod N)ˣ)
    (T : Finset (Place K ↥(qExpFunctionFieldC K (CohCarrier.GammaH N H')) × Place K ↥(qExpFunctionFieldC K (CohCarrier.GammaH N H'))))
    (hT : ∀ s, s ∈ T ↔ s ∈ ssNodePairsQExp K (CohCarrier.GammaH N H') p)
    (e : (ZMod N)ˣ) :
    SemilinearAut.IsNodeStable T
      (SemilinearAut.ofAlgAut (diamondActionModL K N H' (CuspForm.gammaLift N e))) := by sorry
