-- title:
--   Corollary 3.3: Nilpotent orbit reduction to center plus Levi factor
-- statement:
--   All vector spaces and Lie algebras are finite dimensional and real, with their usual Hausdorff topology. An invariant set is invariant under the group generated by $e^{\operatorname{ad}y}$. A closed convex set is pointed when its recession edge is zero. Write $\mathcal O_x=\operatorname{Inn}(\mathfrak g)x$, $\operatorname{co}(x)=\overline{\operatorname{conv}}\mathcal O_x$, and $C_x=\operatorname{cone}(\mathcal O_x)$. Admissibility means existence of a pointed generating invariant closed convex subset.
--
--   Let $\mathfrak g$ be admissible in its structural presentation, and let $\mathfrak s=[\mathfrak l,\mathfrak l]$. Every ad-nilpotent $x$ with pointed $\operatorname{co}(x)$ satisfies
--
--   $$\mathcal O_x\cap(\mathfrak z+\mathfrak s)\ne\varnothing.$$
--
--   Also, every ad-nilpotent element of $\mathfrak z+\mathfrak l$ belongs to $\mathfrak z+\mathfrak s$, without a pointedness assumption. Ad-nilpotency includes central elements. These are the two source assertions.
-- source:
--   Elements in pointed invariant cones in Lie algebras and corresponding affine pairs, arXiv:2110.07297v1, PDF p. 8, Corollary 3.3: Nilpotent orbit reduction to center plus Levi factor

import Definitions.Def_QAlgorithms_Papers_Independent_Frontier30_P26

namespace QAlgorithms.Papers.Independent.Frontier30.P26

noncomputable section

open Set

open QAlgorithms.Papers.Independent.Dependency50.P12.Coordinates (expAd)

attribute [local instance 100] LieRing.ofAssociativeRing

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedGroup

attribute [local instance] QAlgorithms.Papers.Independent.Frontier30.P26.lieNormedSpace

section Presentations

variable {G : Type*} [LieRing G] [LieAlgebra ℝ G] [FiniteDimensional ℝ G]

/-- Corollary 3.3, PDF p. 8. The second assertion has no pointedness hypothesis. -/
theorem nilpotent_orbit_levi_reduction (P : StructuralPresentation (G := G))
    (ha : LieAdmissible (G := G)) :
    (∀ x : G, AdNilpotent x → Pointed (orbitHull x) →
      (innerAdjointOrbit x ∩ ((LieAlgebra.center ℝ G).toSubmodule ⊔
        bracketSpan P.L.toSubmodule P.L.toSubmodule : Submodule ℝ G)).Nonempty) ∧
    (∀ x : G, x ∈ (LieAlgebra.center ℝ G).toSubmodule ⊔ P.L.toSubmodule → AdNilpotent x →
      x ∈ (LieAlgebra.center ℝ G).toSubmodule ⊔ bracketSpan P.L.toSubmodule P.L.toSubmodule) := by sorry

end Presentations

end

end QAlgorithms.Papers.Independent.Frontier30.P26
