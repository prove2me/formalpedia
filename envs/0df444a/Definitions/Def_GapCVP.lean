      physicalShiftedRowMixedTag formula row.val =
        sourcePrefix + decoded.2.val / moment := by
    rw [← mixedTag, rank]
    rw [show sourcePrefix * moment = moment * sourcePrefix by ac_rfl,
      Nat.mul_add_div positive]
