    refine ⟨w, hw, hc, ?_⟩
    intro c hc25
    rw [Nat.testBit_two_pow_mul_add _ hf, if_pos (by omega), Nat.zero_add, Nat.testBit_xor,
      Nat.testBit_land, Nat.testBit_mod_two_pow]
    cases w.testBit c <;> cases msk.testBit c <;> simp [hc25]
  · obtain ⟨w', h1, h2, h3⟩ := h _ hj
    refine ⟨w', h1, h2, ?_⟩
    intro c hc25
    rw [Nat.testBit_two_pow_mul_add _ hf, if_neg (by omega), ← h3 c hc25]
    congr 1; omega

theorem bld_sound {GT : ℕ} (hG : GTValid GT) (chk : ℕ → ℕ → Bool) (msk : ℕ) (κ : ℕ → ℕ → Bool) :
    ∀ fuel lst T Y, BInv chk msk T Y → bldGo GT chk msk κ fuel lst T Y = true →
      ∃ T' Y', BInv chk msk T' Y' ∧ κ T' Y' = true := by
  intro fuel
  induction fuel with
  | zero => intro lst T Y hi h; exact ⟨T, Y, hi, h⟩
  | succ n ih =>
    intro lst T Y hi h
    rw [bldGo_succ, nz_eq] at h
    split at h
    · exact ⟨T, Y, hi, h⟩
    · rw [nz_eq] at h
      split at h
      · exact absurd h (by simp)
      · rename_i hw
        rw [brec_eq] at h
        split at h
        · rename_i hc
          simp only [n_land, n_shr, n_mul, n_add, n_xor, m25, m50] at h hc hw
          exact ih _ _ _ (BInv_push hi (hG _ hw) hc) h
        · exact absurd h (by simp)

/-- For every set `Z` of at most `k` cells some good pattern word has its doubles in `B` and its other cells
in `B` or outside `Z`. -/
def LeafGoal (B k : ℕ) : Prop :=
  ∀ Z : Finset ℕ, Z.card ≤ k → ∃ w, GoodW w ∧ w / 2 ^ 25 &&& B = w / 2 ^ 25 ∧
    ∀ c ∈ Z, c < 25 → (w.testBit c && !B.testBit c) = false

theorem lrec_nil (a : Bool) (f : ℕ → List ℕ → Bool → Bool) :
    (List.rec (motive := fun _ => Bool) a f ([] : List ℕ) : Bool) = a := rfl

theorem lrec_cons (a : Bool) (f : ℕ → List ℕ → Bool → Bool) (x : ℕ) (l : List ℕ) :
    (List.rec (motive := fun _ => Bool) a f (x :: l) : Bool) = f x l (List.rec a f l) := rfl

theorem leafZ_eq (GT B k E PY : ℕ) (L : List ℕ) (κ : List ℕ → Bool) : leafZ GT B k E PY L κ =
  nz k (κ L)
    (fun k => Bool.rec (κ L)
      (List.rec (motive := fun _ => Bool) false (fun item L' _ =>
        bldGo GT (fun _ b => Nat.beq (Nat.land b B) b) B
          (fun T Y => Bool.rec false (κ L') (zphGo T k Y)) 1000 item 0 0) L)
      (domT E k)) := rfl

theorem leafZ_out (GT B k E PY : ℕ) (L : List ℕ) (κ : List ℕ → Bool) (hd : domT E k = false) :
    leafZ GT B k E PY L κ = κ L := by
  rw [leafZ_eq, nz_eq, hd]
  split <;> rfl

theorem leafZ_nil (GT B k E PY : ℕ) (κ : List ℕ → Bool) (hk : k ≠ 0) (hd : domT E k = true) :
    leafZ GT B k E PY [] κ = false := by
  rw [leafZ_eq, nz_eq, if_neg hk, hd]

theorem leafZ_cons (GT B k E PY item : ℕ) (L' : List ℕ) (κ : List ℕ → Bool) (hk : k ≠ 0)
    (hd : domT E k = true) : leafZ GT B k E PY (item :: L') κ =
      bldGo GT (fun _ b => Nat.beq (Nat.land b B) b) B
        (fun T Y => Bool.rec false (κ L') (zphGo T k Y)) 1000 item 0 0 := by
  rw [leafZ_eq, nz_eq, if_neg hk, hd]

theorem leafZ_sound {GT : ℕ} (hG : GTValid GT) (B k E PY : ℕ) (L : List ℕ) (κ : List ℕ → Bool)
    (h : leafZ GT B k E PY L κ = true) :
    ∃ L', κ L' = true ∧ (k ≠ 0 → domT E k = true → LeafGoal B k) := by
  by_cases hk : k = 0
  · rw [leafZ_eq, nz_eq, if_pos hk] at h; exact ⟨L, h, fun h0 => absurd hk h0⟩
  cases hd : domT E k with
  | false => rw [leafZ_out _ _ _ _ _ _ _ hd] at h; exact ⟨L, h, fun _ h1 => by simp at h1⟩
  | true =>
    cases L with
    | nil => rw [leafZ_nil _ _ _ _ _ _ hk hd] at h; exact absurd h (by simp)
    | cons item L' =>
      rw [leafZ_cons _ _ _ _ _ _ _ _ hk hd] at h
      obtain ⟨T, Y, hi, h2⟩ := bld_sound hG _ B _ _ item 0 0 (BInv_zero _ _) h
      rw [brec_eq] at h2
      by_cases hz : zphGo T k Y = true
      swap
      · rw [if_neg hz] at h2; exact absurd h2 (by simp)
      rw [if_pos hz] at h2
      refine ⟨L', h2, fun _ _ Z hZ => ?_⟩
      obtain ⟨j, hj, hjz⟩ := zph_sound T k Y hz Z hZ
      obtain ⟨w, hw, hc, hT⟩ := hi j hj
      simp only [n_land, n_beq] at hc
      refine ⟨w, hw, hc, fun c hcZ hc25 => ?_⟩
      rw [← hT c hc25]
      exact hjz c hcZ hc25

/-- Sum of `f` over the cells below `m` that belong to the mask `B`. -/
def Sm (m B : ℕ) (f : ℕ → ℕ) : ℕ := ∑ c ∈ range m, if B.testBit c = true then f c else 0

/-- Packed weights of the cell `24 - m`. -/
def wtAt (m : ℕ) : ℕ := WTR / 2 ^ (60 * m) % 2 ^ 60

/-- The cover lemma for the double set `Bs`. -/
def Cov (Bs : ℕ) : Prop :=
  ∀ A, (∀ c, c < 25 → Bs.testBit c = true → A.testBit c = true) →
    Sm 25 A (fun _ => 1) + Sm 25 Bs (fun _ => 1) = 25 → Concl A Bs

theorem Sm_succ_true {m B : ℕ} (f : ℕ → ℕ) (h : B.testBit m = true) : Sm (m + 1) B f = Sm m B f + f m := by
  simp [Sm, Finset.sum_range_succ, h]

theorem Sm_succ_false {m B : ℕ} (f : ℕ → ℕ) (h : B.testBit m = false) : Sm (m + 1) B f = Sm m B f := by
  simp [Sm, Finset.sum_range_succ, h]

theorem mod_succ_true {m B : ℕ} (h : B.testBit m = true) : B % 2 ^ (m + 1) = B % 2 ^ m + 2 ^ m := by
  rw [Nat.testBit_eq_decide_div_mod_eq] at h
  have h : B / 2 ^ m % 2 = 1 := by simpa using h
  rw [Nat.mod_pow_succ, h, Nat.mul_one]

theorem mod_succ_false {m B : ℕ} (h : B.testBit m = false) : B % 2 ^ (m + 1) = B % 2 ^ m := by
  rw [Nat.testBit_eq_decide_div_mod_eq] at h
  have h : B / 2 ^ m % 2 = 0 := by
    have := Nat.mod_two_eq_zero_or_one (B / 2 ^ m)
    simp at h; omega
  rw [Nat.mod_pow_succ, h, Nat.mul_zero, Nat.add_zero]

theorem Sm_mono_m {m m' : ℕ} (B : ℕ) (f : ℕ → ℕ) (h : m ≤ m') : Sm m B f ≤ Sm m' B f :=
  Finset.sum_le_sum_of_subset (Finset.range_mono h)

theorem cov_of_count {Bs X : ℕ} (hX : X ≤ 25) (h : 13 ≤ Sm X Bs (fun _ => 1)) : Cov Bs := by
  intro A hA hsum
  have h1 := Sm_mono_m Bs (fun _ => 1) hX
  have h2 : Sm 25 Bs (fun _ => 1) ≤ Sm 25 A (fun _ => 1) := by
    apply Finset.sum_le_sum
    intro c hc
    have hc : c < 25 := Finset.mem_range.mp hc
    by_cases hb : Bs.testBit c = true
    · simp [hb, hA c hc hb]
    · simp [hb]
  omega

/-- Every mark of `PY` points to a field of `PT` which is zero or a pattern of doubles only containing a placed
pattern of the library. -/
def PInv (PT PY : ℕ) : Prop := ∀ j, PY.testBit j = true → PT / 2 ^ j % 2 ^ 25 ≠ 0 →
  Concl (PT / 2 ^ j % 2 ^ 25) (PT / 2 ^ j % 2 ^ 25)

theorem PInv_sub {PT PY M : ℕ} (h : PInv PT PY) : PInv PT (PY ^^^ (PY &&& M)) := by
  intro j hj
  apply h
  rw [Nat.testBit_xor, Nat.testBit_land] at hj
  cases hh : PY.testBit j <;> simp [hh] at hj ⊢

theorem dfsGo_zero (leaf : Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool) (PT off : Nat)
    (B k E PY : Nat) (L : List Nat) (κ : List Nat → Bool) :
    dfsGo leaf PT off 0 B k E PY L κ = leaf B k E PY L κ := rfl

/-- The pruning test of `dfsGo`: 12 doubles already, or the nogood of the lowest mark of `PY` is nonempty and
lies in `B1`. -/
def pruneT (PT PY k B1 : Nat) : Bool :=
  Bool.rec
    (Nat.ble (Nat.succ (Nat.sub
        (Nat.land (Nat.div PT (Nat.sub PY (Nat.land PY (Nat.sub PY 1)))) 33554431) 1))
      (Nat.land (Nat.land (Nat.div PT (Nat.sub PY (Nat.land PY (Nat.sub PY 1)))) 33554431) B1))
    true (Nat.ble 12 k)

theorem dfsGo_succ (leaf : Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool) (PT off n : Nat)
    (B k E PY : Nat) (L : List Nat) (κ : List Nat → Bool) :
    dfsGo leaf PT off (n + 1) B k E PY L κ =
      Bool.rec
        (dfsGo leaf PT off n (Nat.add B (Nat.shiftRight 16777216 (Nat.add n off))) (Nat.succ k)
          (Nat.add E (Nat.land (Nat.shiftRight WTR (Nat.mul 60 (Nat.add n off))) 0xfffffffffffffff))
          PY L (fun L' => dfsGo leaf PT off n B k E
            (Nat.xor PY (Nat.land PY (Nat.div PT (Nat.shiftRight 16777216 (Nat.add n off))))) L' κ))
        (dfsGo leaf PT off n B k E
          (Nat.xor PY (Nat.land PY (Nat.div PT (Nat.shiftRight 16777216 (Nat.add n off))))) L κ)
        (pruneT PT PY k (Nat.add B (Nat.shiftRight 16777216 (Nat.add n off)))) := rfl

theorem m60 (x : Nat) : x &&& 0xfffffffffffffff = x % 2 ^ 60 := Nat.and_two_pow_sub_one_eq_mod x 60

/-- The pruning test of the search is sound. -/
theorem prune_sound {PT PY k B1 X Bs : ℕ} (hP : PInv PT PY) (hX : X + 1 ≤ 25)
    (hB : Bs % 2 ^ (X + 1) = B1) (hk : Sm (X + 1) Bs (fun _ => 1) = k + 1)
    (ht : pruneT PT PY k B1 = true) : Cov Bs := by
  unfold pruneT at ht
  rw [brec_eq] at ht
  simp only [n_land, n_sub, n_div, m25, Nat.succ_eq_add_one, n_ble] at ht
  split at ht
  · exact cov_of_count hX (by omega)
  · rw [n_ble] at ht
    by_cases hPY : PY = 0
    · simp [hPY] at ht
    obtain ⟨j, h1, h2, -⟩ := lowbit PY hPY
    rw [h2] at ht
    have hle := Nat.and_le_left (n := PT / 2 ^ j % 2 ^ 25) (m := B1)
    have hS := hP j h1 (by omega)
    have he : PT / 2 ^ j % 2 ^ 25 &&& B1 = PT / 2 ^ j % 2 ^ 25 := by omega
    have hsub : ∀ c, c < 25 → (PT / 2 ^ j % 2 ^ 25).testBit c = true → Bs.testBit c = true := by
      intro c _ hc
      have h3 : (PT / 2 ^ j % 2 ^ 25 &&& B1).testBit c = true := by rw [he]; exact hc
      rw [Nat.testBit_land, ← hB, Bool.and_eq_true] at h3
      have h4 := h3.2
      rw [Nat.testBit_mod_two_pow, Bool.and_eq_true] at h4
      exact h4.2
    exact fun A hA _ => hS.mono (fun c hc h => hA c hc (hsub c hc h)) hsub

/-- Soundness of the search over double sets, for an arbitrary leaf test. -/
theorem dfs_sound (leaf : Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool) (PT off : ℕ)
    (P : ℕ → ℕ → ℕ → Prop)
    (hleaf : ∀ B k E PY L κ, PInv PT PY → leaf B k E PY L κ = true → ∃ L', κ L' = true ∧ P B k E) :
    ∀ n, n + off ≤ 25 → ∀ B k E PY L κ, PInv PT PY → dfsGo leaf PT off n B k E PY L κ = true →
      ∃ L', κ L' = true ∧ ∀ Bs, Bs % 2 ^ (25 - (n + off)) = B →
        Sm (25 - (n + off)) Bs (fun _ => 1) = k → Sm (25 - (n + off)) Bs (fun c => wtAt (24 - c)) = E →
        Cov Bs ∨ P (Bs % 2 ^ (25 - off)) (Sm (25 - off) Bs (fun _ => 1))
          (Sm (25 - off) Bs (fun c => wtAt (24 - c))) := by
  intro n
  induction n with
  | zero =>
    intro _ B k E PY L κ hP h
    rw [dfsGo_zero] at h
    obtain ⟨L', h1, h2⟩ := hleaf _ _ _ _ _ _ hP h
    refine ⟨L', h1, fun Bs hB hk hE => Or.inr ?_⟩
    simp only [Nat.zero_add] at hB hk hE
    rw [hB, hk, hE]; exact h2
  | succ n ih =>
    intro hn B k E PY L κ hP h
    obtain ⟨X, hX⟩ : ∃ X, X = 25 - (n + 1 + off) := ⟨_, rfl⟩
    have hX1 : 25 - (n + off) = X + 1 := by omega
    have hq : 16777216 / 2 ^ (n + off) = 2 ^ X := by
      rw [show (16777216 : ℕ) = 2 ^ 24 by norm_num, Nat.pow_div (by omega) (by norm_num)]
      congr 1; omega
    have hw : WTR / 2 ^ (60 * (n + off)) % 2 ^ 60 = wtAt (24 - X) := by
      unfold wtAt; congr 3; omega
    rw [dfsGo_succ] at h
    simp only [n_shr, n_mul, n_add, n_land, n_xor, n_div, m60, hq, hw, Nat.succ_eq_add_one] at h
    have ih' := ih (by omega)
    rw [hX1] at ih'
    rw [← hX]
    cases ht : pruneT PT PY k (B + 2 ^ X) with
    | true =>
      rw [ht] at h
      obtain ⟨L', h1, h2⟩ := ih' _ _ _ _ _ _ (PInv_sub hP) h
      refine ⟨L', h1, fun Bs hB hk hE => ?_⟩
      cases hb : Bs.testBit X with
      | true =>
        exact Or.inl (prune_sound (k := k) (B1 := B + 2 ^ X) (X := X) hP (by omega) (by rw [mod_succ_true hb, hB])
          (by rw [Sm_succ_true _ hb, hk]) ht)
      | false =>
        exact h2 Bs (by rw [mod_succ_false hb, hB]) (by rw [Sm_succ_false _ hb, hk])
          (by rw [Sm_succ_false _ hb, hE])
    | false =>
      rw [ht] at h
      obtain ⟨L1, h1, h2⟩ := ih' _ _ _ _ _ _ hP h
      obtain ⟨L2, h3, h4⟩ := ih' _ _ _ _ _ _ (PInv_sub hP) h1
      refine ⟨L2, h3, fun Bs hB hk hE => ?_⟩
      cases hb : Bs.testBit X with
      | true =>
        exact h2 Bs (by rw [mod_succ_true hb, hB]) (by rw [Sm_succ_true _ hb, hk])
          (by rw [Sm_succ_true _ hb, hE])
      | false =>
        exact h4 Bs (by rw [mod_succ_false hb, hB]) (by rw [Sm_succ_false _ hb, hk])
          (by rw [Sm_succ_false _ hb, hE])

/-! ### The three generating symmetries on pattern words -/

/-- Cell permutations of the three generators, acting on both halves of a pattern word. -/
def pFI (i : ℕ) : ℕ := 25 * (i / 25) + (5 * (4 - i % 25 / 5) + i % 25 % 5)
def pFJ (i : ℕ) : ℕ := 25 * (i / 25) + (5 * (i % 25 / 5) + (4 - i % 25 % 5))
def pSW (i : ℕ) : ℕ := 25 * (i / 25) + (5 * (i % 25 % 5) + i % 25 / 5)

/-- Union of the masked shifts `((u &&& M) <<< sl) >>> sr` over a list of triples `(M, sl, sr)`. -/
def wsum (u : ℕ) : List (ℕ × ℕ × ℕ) → ℕ
  | [] => 0
  | t :: l => wsum u l ||| ((u &&& t.1) <<< t.2.1) >>> t.2.2

/-- Bit `i` of the term `t` of `wsum` is a bit of `u` (and not masked). -/
def wcond (i : ℕ) (t : ℕ × ℕ × ℕ) : Bool := decide (t.2.1 ≤ t.2.2 + i) && t.1.testBit (t.2.2 + i - t.2.1)

/-- Every term that contributes to bit `i` reads bit `r` of `u`, and some term does. -/
def wchk (L : List (ℕ × ℕ × ℕ)) (r i : ℕ) : Bool :=
  L.all (fun t => !wcond i t || decide (t.2.2 + i - t.2.1 = r)) && L.any (wcond i)

theorem wsum_bit_aux (u i r : ℕ) : ∀ L : List (ℕ × ℕ × ℕ),
    L.all (fun t => !wcond i t || decide (t.2.2 + i - t.2.1 = r)) = true →
    (wsum u L).testBit i = (L.any (wcond i) && u.testBit r) := by
  intro L
  induction L with
  | nil => intro _; simp [wsum]
  | cons t l ih =>
    intro h
    rw [List.all_cons, Bool.and_eq_true] at h
    rw [wsum, Nat.testBit_or, ih h.2, Nat.testBit_shiftRight, Nat.testBit_shiftLeft, Nat.testBit_and,
      List.any_cons]
    have h1 := h.1
    unfold wcond at h1 ⊢
    by_cases hc : (decide (t.2.1 ≤ t.2.2 + i) && t.1.testBit (t.2.2 + i - t.2.1)) = true
    · have e : t.2.2 + i - t.2.1 = r := by simpa [hc] using h1
      rw [Bool.and_eq_true] at hc
      have hc1 : decide (t.2.2 + i ≥ t.2.1) = true := by simpa using hc.1
      rw [e] at hc ⊢
      rw [hc1, hc.2]
      cases u.testBit r <;> simp
    · have hc' : (decide (t.2.1 ≤ t.2.2 + i) && t.1.testBit (t.2.2 + i - t.2.1)) = false := by simpa using hc
      have hz : (decide (t.2.2 + i ≥ t.2.1) &&
          (u.testBit (t.2.2 + i - t.2.1) && t.1.testBit (t.2.2 + i - t.2.1))) = false := by
        cases hd : decide (t.2.1 ≤ t.2.2 + i)
        · rfl
        · rw [hd, Bool.true_and] at hc'
          rw [hc']; simp
      rw [hz, hc']; simp

theorem wsum_bit (u i r : ℕ) (L : List (ℕ × ℕ × ℕ)) (h : wchk L r i = true) :
    (wsum u L).testBit i = u.testBit r := by
  unfold wchk at h
  rw [Bool.and_eq_true] at h
  rw [wsum_bit_aux u i r L h.1, h.2, Bool.true_and]

def LFI : List (ℕ × ℕ × ℕ) := [(0x3e00001f00000, 0, 20), (0x1f00000f8000, 0, 10), (0xf800007c00, 0, 0),
  (0x7c00003e0, 10, 0), (0x3e00001f, 20, 0)]
def LFJ : List (ℕ × ℕ × ℕ) := [(0x2108421084210, 0, 4), (0x1084210842108, 0, 2), (0x842108421084, 0, 0),
  (0x421084210842, 2, 0), (0x210842108421, 4, 0)]
def LSW : List (ℕ × ℕ × ℕ) := [(0x200000100000, 0, 16), (0x410000208000, 0, 12), (0x820800410400, 0, 8),
  (0x1041040820820, 0, 4), (0x2082083041041, 0, 0), (0x104104082082, 4, 0), (0x8208004104, 8, 0),
  (0x410000208, 12, 0), (0x20000010, 16, 0)]

theorem flipI_eq (u : ℕ) : flipI u = wsum u LFI := by
  unfold flipI; rw [force_eq]
  simp only [LFI, wsum, n_lor, n_land, n_shl, Nat.shiftRight_eq, Nat.shiftLeft_zero, Nat.shiftRight_zero,
    Nat.zero_or]
theorem flipJ_eq (u : ℕ) : flipJ u = wsum u LFJ := by
  unfold flipJ; rw [force_eq]
  simp only [LFJ, wsum, n_lor, n_land, n_shl, Nat.shiftRight_eq, Nat.shiftLeft_zero, Nat.shiftRight_zero,
    Nat.zero_or]
theorem swapIJ_eq (u : ℕ) : swapIJ u = wsum u LSW := by
  unfold swapIJ; rw [force_eq]
  simp only [LSW, wsum, n_lor, n_land, n_shl, Nat.shiftRight_eq, Nat.shiftLeft_zero, Nat.shiftRight_zero,
    Nat.zero_or]

theorem LFI_chk : ∀ i < 50, wchk LFI (pFI i) i = true := by decide +kernel
theorem LFJ_chk : ∀ i < 50, wchk LFJ (pFJ i) i = true := by decide +kernel
theorem LSW_chk : ∀ i < 50, wchk LSW (pSW i) i = true := by decide +kernel

theorem flipI_bit (u i : ℕ) (hi : i < 50) : (flipI u).testBit i = u.testBit (pFI i) := by
  rw [flipI_eq]; exact wsum_bit u i _ LFI (LFI_chk i hi)

theorem flipJ_bit (u i : ℕ) (hi : i < 50) : (flipJ u).testBit i = u.testBit (pFJ i) := by
  rw [flipJ_eq]; exact wsum_bit u i _ LFJ (LFJ_chk i hi)

theorem swapIJ_bit (u i : ℕ) (hi : i < 50) : (swapIJ u).testBit i = u.testBit (pSW i) := by
  rw [swapIJ_eq]; exact wsum_bit u i _ LSW (LSW_chk i hi)

/-! ### Validity of the table of placed nogoods -/

/-- Action of the symmetry `k` on the bits of a pattern word. -/
def pk (k b : ℕ) : ℕ :=
  (if Nat.land (Nat.shiftRight k 2) 1 = 0 then id else pSW)
    ((if Nat.land (Nat.shiftRight k 1) 1 = 0 then id else pFJ)
      ((if Nat.land k 1 = 0 then id else pFI) b))

theorem pFI_lt : ∀ b, b < 50 → pFI b < 50 ∧ pFI (pFI b) = b := by decide +kernel
theorem pFJ_lt : ∀ b, b < 50 → pFJ b < 50 ∧ pFJ (pFJ b) = b := by decide +kernel
theorem pSW_lt : ∀ b, b < 50 → pSW b < 50 ∧ pSW (pSW b) = b := by decide +kernel

theorem selF_bit (bb : ℕ) (f : ℕ → ℕ) (p : ℕ → ℕ)
    (hf : ∀ u b, b < 50 → u.testBit b = true → (f u).testBit (p b) = true ∧ p b < 50)
    (u b : ℕ) (hb : b < 50) (hu : u.testBit b = true) :
    (selF bb f u).testBit ((if bb = 0 then id else p) b) = true ∧ (if bb = 0 then id else p) b < 50 := by
  cases bb with
  | zero => exact ⟨hu, hb⟩
  | succ n => exact hf u b hb hu

theorem symU_bit (k u b : ℕ) (hb : b < 50) (hu : u.testBit b = true) :
    (symU k u).testBit (pk k b) = true ∧ pk k b < 50 := by
  have h1 := selF_bit (Nat.land k 1) flipI pFI
    (fun u b hb hu => ⟨by rw [flipI_bit u _ (pFI_lt b hb).1, (pFI_lt b hb).2]; exact hu, (pFI_lt b hb).1⟩)
    u b hb hu
  have h2 := selF_bit (Nat.land (Nat.shiftRight k 1) 1) flipJ pFJ
    (fun u b hb hu => ⟨by rw [flipJ_bit u _ (pFJ_lt b hb).1, (pFJ_lt b hb).2]; exact hu, (pFJ_lt b hb).1⟩)
    _ _ h1.2 h1.1
  exact selF_bit (Nat.land (Nat.shiftRight k 2) 1) swapIJ pSW
    (fun u b hb hu => ⟨by rw [swapIJ_bit u _ (pSW_lt b hb).1, (pSW_lt b hb).2]; exact hu, (pSW_lt b hb).1⟩)
    _ _ h2.2 h2.1

theorem pk_tab : ∀ k < 8, ∀ c < 25, pk k c < 25 ∧ pk k (25 + c) = 25 + pk k c ∧
    pk k c / 5 = (if k / 4 % 2 = 1 then (if k / 2 % 2 = 1 then 4 - c % 5 else c % 5)
      else (if k % 2 = 1 then 4 - c / 5 else c / 5)) ∧
    pk k c % 5 = (if k / 4 % 2 = 1 then (if k % 2 = 1 then 4 - c / 5 else c / 5)
      else (if k / 2 % 2 = 1 then 4 - c % 5 else c % 5)) := by
  decide +kernel

/-- `pk` acts on both halves by the cell map of `trI`. -/
theorem pk_trI (k : ℕ) (hk : k < 8) (c : ℕ) (hc : c < 25) (di dj : ℤ) :
    pk k c < 25 ∧ pk k (25 + c) = 25 + pk k c ∧
      trI k di dj c = (((pk k c / 5 : ℕ) : ℤ) + di, ((pk k c % 5 : ℕ) : ℤ) + dj) := by
  obtain ⟨h1, h2, h3, h4⟩ := pk_tab k hk c hc
  refine ⟨h1, h2, ?_⟩
  simp only [trI]
  split_ifs at h3 h4 ⊢ <;> (rw [Prod.mk.injEq]; constructor <;> omega)

/-- Cells that leave the board, as recorded in `BADT`. -/
theorem bad_spec : ∀ t < 81, ∀ b < 50, (BADT / 2 ^ (50 * t)).testBit b = false →
    4 ≤ b % 25 / 5 + t / 9 ∧ b % 25 / 5 + t / 9 < 9 ∧ 4 ≤ b % 25 % 5 + t % 9 ∧ b % 25 % 5 + t % 9 < 9 := by
  decide +kernel

/-- `v` contains the image of the pattern `x` under the symmetry `k`. -/
def VI (x : ℕ × ℕ) (k v : ℕ) : Prop :=
  ∀ c, c < 25 → (x.1.testBit c = true → v.testBit (pk k c) = true) ∧
    (x.2.testBit c = true → v.testBit (25 + pk k c) = true)

theorem tb_w (v s n d : ℕ) (hn : n < 50) (h : n + 24 = d + s) (hv : v.testBit d = true) :
    ((v <<< s) / 2 ^ 24 % 2 ^ 50).testBit n = true := by
  have e : n + 24 - s = d := by omega
  have e' : s ≤ n + 24 := by omega
  rw [Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow, Nat.testBit_shiftLeft, e]
  simp [hn, hv, e']

theorem place_good {x : ℕ × ℕ} {e : ℕ} (hx : nogoods[e]? = some x) {k : ℕ} (hk : k < 8) {v : ℕ}
    (hv : VI x k v) {t : ℕ} (ht : t < 81) (hbad : v &&& (BADT / 2 ^ (50 * t) % 2 ^ 50) = 0) :
    GoodW ((v <<< (5 * (t / 9) + t % 9)) / 2 ^ 24 % 2 ^ 50) := by
  have hb : ∀ b, b < 50 → v.testBit b = true → (BADT / 2 ^ (50 * t)).testBit b = false := by
    intro b hb50 hvb
    have := congrArg (fun z => z.testBit b) hbad
    simp only [Nat.testBit_and, Nat.testBit_mod_two_pow, hvb, Nat.zero_testBit, Bool.true_and] at this
    simpa [hb50] using this
  refine ⟨e, x, k, (t / 9 : ℕ) - 4, (t % 9 : ℕ) - 4, hx, hk, ?_, ?_⟩
  · intro c hc hxc
    obtain ⟨hd, -, htr⟩ := pk_trI k hk c hc ((t / 9 : ℕ) - 4) ((t % 9 : ℕ) - 4)
    have hvd := (hv c hc).1 hxc
    obtain ⟨b1, b2, b3, b4⟩ := bad_spec t ht _ (by omega) (hb _ (by omega) hvd)
    rw [htr]
    refine ⟨by omega, by omega, by omega, by omega, ?_⟩
    have en : (5 * (((pk k c / 5 : ℕ) : ℤ) + ((t / 9 : ℕ) - 4)) + (((pk k c % 5 : ℕ) : ℤ) + ((t % 9 : ℕ) - 4))).toNat
        = pk k c + (5 * (t / 9) + t % 9) - 24 := by omega
    show (_ % 2 ^ 25).testBit _ = true
    rw [en, Nat.testBit_mod_two_pow, tb_w v _ _ (pk k c) (by omega) (by omega) hvd]
    simp; omega
  · intro c hc hxc
    obtain ⟨hd, -, htr⟩ := pk_trI k hk c hc ((t / 9 : ℕ) - 4) ((t % 9 : ℕ) - 4)
    have hvd := (hv c hc).2 hxc
    obtain ⟨b1, b2, b3, b4⟩ := bad_spec t ht _ (by omega) (hb _ (by omega) hvd)
    rw [htr]
    refine ⟨by omega, by omega, by omega, by omega, ?_⟩
    have en : (5 * (((pk k c / 5 : ℕ) : ℤ) + ((t / 9 : ℕ) - 4)) + (((pk k c % 5 : ℕ) : ℤ) + ((t % 9 : ℕ) - 4))).toNat
        = pk k c + (5 * (t / 9) + t % 9) - 24 := by omega
    show (_ / 2 ^ 25).testBit _ = true
    rw [en, Nat.testBit_div_two_pow]
    exact tb_w v _ _ (25 + pk k c) (by omega) (by omega) hvd

theorem fld_push (acc w : ℕ) (hw : w < 2 ^ 50) (i : ℕ) :
    fld (acc * 2 ^ 50 + w) i = if i = 0 then w else fld acc (i - 1) := by
  unfold fld
  cases i with
  | zero => rw [if_pos rfl, Nat.mul_zero, pow_zero, Nat.div_one, Nat.mul_comm, Nat.mul_add_mod,
      Nat.mod_eq_of_lt hw]
  | succ i =>
    have e : 2 ^ (50 * (i + 1)) = 2 ^ 50 * 2 ^ (50 * i) := by rw [← pow_add]; congr 1; omega
    have e2 : (acc * 2 ^ 50 + w) / 2 ^ 50 = acc := by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ (by positivity), Nat.div_eq_of_lt hw, Nat.zero_add]
    simp only [Nat.add_sub_cancel, if_neg (Nat.succ_ne_zero i)]
    rw [e, ← Nat.div_div_eq_div_mul, e2]

theorem GTValid_push {acc w : ℕ} (h : GTValid acc) (hw : w < 2 ^ 50) (hg : GoodW w) :
    GTValid (acc * 2 ^ 50 + w) := by
  intro i hi
  rw [fld_push acc w hw] at hi ⊢
  split
  · exact hg
  · rename_i h0; rw [if_neg h0] at hi; exact h _ hi

theorem plcGo_zero (u0 item v acc : ℕ) : plcGo u0 0 item v acc = acc := rfl

theorem plcGo_succ (u0 n item v acc : ℕ) : plcGo u0 (n + 1) item v acc =
    force acc (fun acc => nz item acc (fun item =>
      force (Nat.land item 127) (fun code => Bool.rec
        (Bool.rec (plcGo u0 n (Nat.shiftRight item 7) v acc)
          (plcGo u0 n (Nat.shiftRight item 7) v (Nat.add (Nat.mul acc 1125899906842624)
            (Nat.land (Nat.shiftRight (Nat.shiftLeft v
              (Nat.add (Nat.mul 5 (Nat.div (Nat.sub code 1) 9)) (Nat.mod (Nat.sub code 1) 9))) 24)
              1125899906842623)))
          (Nat.beq (Nat.land v (Nat.land (Nat.shiftRight BADT (Nat.mul 50 (Nat.sub code 1)))
            1125899906842623)) 0))
        (force (Nat.land (symU (Nat.land (Nat.sub code 82) 7) u0) 1125899906842623)
          (fun v => plcGo u0 n (Nat.shiftRight item 7) v acc))
        (Nat.ble 82 code)))) := rfl

theorem plcGo_sound {x : ℕ × ℕ} {e : ℕ} (hx : nogoods[e]? = some x) (u0 : ℕ)
    (hu : ∀ c, c < 25 → (x.1.testBit c = true → u0.testBit c = true) ∧
      (x.2.testBit c = true → u0.testBit (25 + c) = true)) :
    ∀ fuel item v acc, (∃ k, k < 8 ∧ VI x k v) → GTValid acc → GTValid (plcGo u0 fuel item v acc) := by
  intro fuel
  induction fuel with
  | zero => intro item v acc _ hacc; rw [plcGo_zero]; exact hacc
  | succ n ih =>
    intro item v acc hv hacc
    rw [plcGo_succ, force_eq, nz_eq]
    split
    · exact hacc
    rw [force_eq, brec_eq]
    split
    · rw [force_eq]
      have hk8 : Nat.land (Nat.sub (Nat.land item 127) 82) 7 < 8 := by
        have : (item &&& 127) - 82 &&& 7 ≤ 7 := Nat.and_le_right
        simp only [n_land, n_sub]; omega
      generalize Nat.land (Nat.sub (Nat.land item 127) 82) 7 = kk at hk8 ⊢
      refine ih _ _ _ ⟨kk, hk8, ?_⟩ hacc
      intro c hc
      obtain ⟨-, h2, -⟩ := pk_trI kk hk8 c hc 0 0
      refine ⟨fun h => ?_, fun h => ?_⟩
      · obtain ⟨s1, s2⟩ := symU_bit kk u0 c (by omega) ((hu c hc).1 h)
        rw [n_land (symU _ _), m50, Nat.testBit_mod_two_pow, s1]; simp [s2]
      · obtain ⟨s1, s2⟩ := symU_bit kk u0 (25 + c) (by omega) ((hu c hc).2 h)
        rw [h2] at s1 s2
        rw [n_land (symU _ _), m50, Nat.testBit_mod_two_pow, s1]; simp [s2]
    · rename_i hcode
      rw [n_ble, n_land] at hcode
      rw [brec_eq]
      split
      · rename_i hbad
        obtain ⟨k, hk, hvk⟩ := hv
        simp only [n_land, n_shr, n_mul, n_sub, n_beq, m50] at hbad
        simp only [n_land, n_shr, n_mul, n_sub, n_add, n_div, n_mod, n_shl, m50]
        refine ih _ _ _ ⟨k, hk, hvk⟩ ?_
        have := GTValid_push hacc (Nat.mod_lt _ (by norm_num))
          (place_good hx hk hvk (t := (item &&& 127) - 1) (by omega) hbad)
        exact this
      · exact ih _ _ _ hv hacc

theorem gtb_nil (pl : List ℕ) (acc : ℕ) : gtb [] pl acc = acc := rfl
theorem gtb_cons_nil (x : ℕ × ℕ) (lib : List (ℕ × ℕ)) (acc : ℕ) : gtb (x :: lib) [] acc = acc := rfl
theorem gtb_cons_cons (x : ℕ × ℕ) (lib : List (ℕ × ℕ)) (item : ℕ) (pl : List ℕ) (acc : ℕ) :
    gtb (x :: lib) (item :: pl) acc =
      force (force (Nat.lor (Nat.land x.1 33554431) (Nat.shiftLeft (Nat.land x.2 33554431) 25))
        (fun u0 => plcGo u0 400 item u0 acc)) (fun acc' => gtb lib pl acc') := rfl

theorem u0_bits (x : ℕ × ℕ) (c : ℕ) (hc : c < 25) :
    (x.1.testBit c = true → (x.1 % 2 ^ 25 ||| (x.2 % 2 ^ 25) <<< 25).testBit c = true) ∧
    (x.2.testBit c = true → (x.1 % 2 ^ 25 ||| (x.2 % 2 ^ 25) <<< 25).testBit (25 + c) = true) := by
  constructor
  · intro h; rw [Nat.testBit_or, Nat.testBit_mod_two_pow, h]; simp [hc]
  · intro h
    have e : 25 + c - 25 = c := by omega
    rw [Nat.testBit_or, Nat.testBit_shiftLeft, e, Nat.testBit_mod_two_pow x.2, h]; simp [hc]

theorem gtb_sound : ∀ lib : List (ℕ × ℕ), (∀ x ∈ lib, x ∈ nogoods) → ∀ pl acc, GTValid acc →
    GTValid (gtb lib pl acc) := by
  intro lib
  induction lib with
  | nil => intro _ pl acc h; rw [gtb_nil]; exact h
  | cons x lib ih =>
    intro hl pl acc h
    cases pl with
    | nil => rw [gtb_cons_nil]; exact h
    | cons item pl =>
      rw [gtb_cons_cons, force_eq, force_eq]
      apply ih (fun y hy => hl y (List.mem_cons_of_mem _ hy))
      obtain ⟨e, he⟩ := List.mem_iff_getElem?.mp (hl x List.mem_cons_self)
      simp only [n_lor, n_land, n_shl, m25]
      refine plcGo_sound he _ (u0_bits x) _ _ _ _ ⟨0, by norm_num, ?_⟩ h
      intro c hc
      have : pk 0 c = c := by simp [pk]
      rw [this]
      exact u0_bits x c hc

theorem gt_valid (PL : List ℕ) (GT : ℕ)
    (h : Nat.beq (Nat.mul (gtb nogoods PL 0) 1125899906842624) GT = true) : GTValid GT := by
  rw [n_beq, n_mul] at h
  have h0 : GTValid 0 := by intro i hi; simp [fld] at hi
  have h1 := gtb_sound nogoods (fun _ hx => hx) PL 0 h0
  have e50 : (1125899906842624 : ℕ) = 2 ^ 50 := by norm_num
  rw [e50] at h
  subst h
  intro i hi
  have e := fld_push (gtb nogoods PL 0) 0 (by norm_num) i
  rw [Nat.add_zero] at e
  rw [e] at hi ⊢
  by_cases h0' : i = 0
  · rw [if_pos h0'] at hi; exact absurd rfl hi
  · rw [if_neg h0'] at hi ⊢; exact h1 _ hi


/-! ### Soundness of a chunk -/

/-- Leaf property of the search over double sets. -/
def LeafP (B k E : ℕ) : Prop := k ≠ 0 → domT E k = true → LeafGoal B k

/-- Property of a node at depth 6 of the search of a chunk `[lo, hi)`. -/
def ChunkP (lo hi B k E : ℕ) : Prop := lo ≤ B → B < hi →
  ∀ Bs, Bs % 2 ^ (25 - (19 + 0)) = B → Sm (25 - (19 + 0)) Bs (fun _ => 1) = k →
    Sm (25 - (19 + 0)) Bs (fun c => wtAt (24 - c)) = E →
    Cov Bs ∨ LeafP (Bs % 2 ^ (25 - 0)) (Sm (25 - 0) Bs (fun _ => 1)) (Sm (25 - 0) Bs (fun c => wtAt (24 - c)))

/-- Leaf test of the first six levels: continue with the remaining 19 levels inside the chunk. -/
def leafC (gt pt lo hi : Nat) : Nat → Nat → Nat → Nat → List Nat → (List Nat → Bool) → Bool :=
  fun B k E PY L κ => Bool.rec (κ L)
    (Bool.rec (κ L) (dfsGo (leafZ gt) pt 0 19 B k E PY L κ) (Nat.ble (Nat.succ B) hi)) (Nat.ble lo B)

/-- The certificate list is used up. -/
def kEnd : List Nat → Bool := fun L => List.rec (motive := fun _ => Bool) true (fun _ _ _ => false) L

theorem runChunk_eq (GT pidx lo hi : ℕ) (L : List ℕ) : runChunk GT pidx lo hi L =
    bldGo GT (fun a b => Nat.beq a b) 0
      (fun pt py => dfsGo (leafC GT pt lo hi) pt 19 6 0 0 0 py L kEnd) 1000 pidx 0 0 := by
  unfold runChunk
  rw [force_eq]
  rfl

theorem leafC_eq (gt pt lo hi B k E PY : ℕ) (L : List ℕ) (κ : List ℕ → Bool) :
    leafC gt pt lo hi B k E PY L κ = Bool.rec (κ L)
      (Bool.rec (κ L) (dfsGo (leafZ gt) pt 0 19 B k E PY L κ) (Nat.ble (Nat.succ B) hi)) (Nat.ble lo B) := rfl

theorem leafC_sound {GT : ℕ} (hG : GTValid GT) (pt lo hi : ℕ) (B k E PY : ℕ) (L : List ℕ)
    (κ : List ℕ → Bool) (hP : PInv pt PY) (h : leafC GT pt lo hi B k E PY L κ = true) :
    ∃ L', κ L' = true ∧ ChunkP lo hi B k E := by
  rw [leafC_eq] at h
  cases h1 : Nat.ble lo B with
  | false =>
    rw [h1] at h
    refine ⟨L, h, fun hlo => ?_⟩
    rw [← n_ble, h1] at hlo
    exact absurd hlo (by simp)
  | true =>
    rw [h1] at h
    cases h2 : Nat.ble (Nat.succ B) hi with
    | false =>
      rw [h2] at h
      refine ⟨L, h, fun _ hhi => ?_⟩
      have h3 : Nat.succ B ≤ hi := hhi
      rw [← n_ble, h2] at h3
      exact absurd h3 (by simp)
    | true =>
      rw [h2] at h
      obtain ⟨L', hk, hc⟩ := dfs_sound (leafZ GT) pt 0 LeafP
        (fun B k E PY L κ _ h => leafZ_sound hG B k E PY L κ h) 19 (by norm_num) B k E PY L κ hP h
      exact ⟨L', hk, fun _ _ => hc⟩

theorem pinv_of_binv {T Y : ℕ} (h : BInv (fun a b => Nat.beq a b) 0 T Y) : PInv T Y := by
  intro j hj _
  obtain ⟨w, hw, hc, hT⟩ := h j hj
  have hc : w % 2 ^ 25 = w / 2 ^ 25 := by rw [← n_beq]; exact hc
  have e : T / 2 ^ j % 2 ^ 25 = w % 2 ^ 25 := by
    apply Nat.eq_of_testBit_eq
    intro c
    rw [Nat.testBit_mod_two_pow, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
    by_cases hc25 : c < 25
    · rw [Nat.add_comm c j, hT c hc25]; simp
    · simp [hc25]
  rw [e]
  unfold GoodW at hw
  rw [← hc] at hw
  exact hw

/-- Soundness of a chunk: every double set whose six lowest cells fall in the chunk either satisfies the cover
lemma or passes to the hitting-set search. -/
theorem run_sound {GT pidx lo hi : ℕ} {L : List ℕ} (hG : GTValid GT)
    (h : runChunk GT pidx lo hi L = true) (Bs : ℕ) (h1 : lo ≤ Bs % 64) (h2 : Bs % 64 < hi) :
    Cov Bs ∨ LeafP (Bs % 2 ^ 25) (Sm 25 Bs (fun _ => 1)) (Sm 25 Bs (fun c => wtAt (24 - c))) := by
  rw [runChunk_eq] at h
  obtain ⟨T, Y, hi', h3⟩ := bld_sound hG _ 0 _ 1000 pidx 0 0 (BInv_zero _ _) h
  have hP : PInv T Y := pinv_of_binv hi'
  obtain ⟨L', -, h4⟩ := dfs_sound (leafC GT T lo hi) T 19 (ChunkP lo hi)
    (fun B k E PY L κ hP h => leafC_sound hG T lo hi B k E PY L κ hP h) 6 (by norm_num) 0 0 0 Y L kEnd hP h3
  have h5 := h4 Bs (by norm_num [Nat.mod_one]) (by simp [Sm]) (by simp [Sm])
  rcases h5 with h5 | h5
  · exact Or.inl h5
  · exact h5 h1 h2 Bs rfl rfl rfl

/-! ### Sums over masks -/

theorem Sm_zero (B : ℕ) (f : ℕ → ℕ) : Sm 0 B f = 0 := by simp [Sm]

theorem Sm_congr {m B : ℕ} {f g : ℕ → ℕ} (h : ∀ c, c < m → f c = g c) : Sm m B f = Sm m B g := by
  induction m with
  | zero => rw [Sm_zero, Sm_zero]
  | succ m ih =>
    have ih := ih (fun c hc => h c (by omega))
    cases hb : B.testBit m with
    | true => rw [Sm_succ_true _ hb, Sm_succ_true _ hb, ih, h m (by omega)]
    | false => rw [Sm_succ_false _ hb, Sm_succ_false _ hb, ih]

theorem Sm_lin (m B : ℕ) (f g1 g2 g3 : ℕ → ℕ) (a b : ℕ) (h : ∀ c, f c = g1 c + a * g2 c + b * g3 c) :
    Sm m B f = Sm m B g1 + a * Sm m B g2 + b * Sm m B g3 := by
  induction m with
  | zero => simp [Sm_zero]
  | succ m ih =>
    cases hb : B.testBit m with
    | true =>
      rw [Sm_succ_true _ hb, Sm_succ_true _ hb, Sm_succ_true _ hb, Sm_succ_true _ hb, ih, h m]; ring
    | false => rw [Sm_succ_false _ hb, Sm_succ_false _ hb, Sm_succ_false _ hb, Sm_succ_false _ hb, ih]

theorem Sm_bound {m B : ℕ} {f : ℕ → ℕ} {b : ℕ} (h : ∀ c, c < m → f c ≤ b) :
    Sm m B f ≤ b * Sm m B (fun _ => 1) := by
  induction m with
  | zero => simp [Sm_zero]
  | succ m ih =>
    have ih := ih (fun c hc => h c (by omega))
    have hm := h m (by omega)
    cases hb : B.testBit m with
    | true => rw [Sm_succ_true _ hb, Sm_succ_true _ hb, Nat.mul_add]; omega
    | false => rw [Sm_succ_false _ hb, Sm_succ_false _ hb]; exact ih

theorem Sm_pair {m B : ℕ} {f g : ℕ → ℕ} {a : ℕ} (h : ∀ c, c < m → f c + g c = a) :
    Sm m B f + Sm m B g = a * Sm m B (fun _ => 1) := by
  induction m with
  | zero => simp [Sm_zero]
  | succ m ih =>
    have ih := ih (fun c hc => h c (by omega))
    have hm := h m (by omega)
    cases hb : B.testBit m with
    | true => rw [Sm_succ_true _ hb, Sm_succ_true _ hb, Sm_succ_true _ hb, Nat.mul_add]; omega
    | false => rw [Sm_succ_false _ hb, Sm_succ_false _ hb, Sm_succ_false _ hb]; exact ih

theorem Sm_perm {p : ℕ → ℕ} {B B' : ℕ} (hbit : ∀ c, c < 25 → B'.testBit c = B.testBit (p c))
    (hp : ∀ c, c < 25 → p c < 25 ∧ p (p c) = c) (f : ℕ → ℕ) :
    Sm 25 B' f = Sm 25 B (fun d => f (p d)) := by
  unfold Sm
  refine Finset.sum_nbij' p p ?_ ?_ ?_ ?_ ?_
  · intro a ha; exact Finset.mem_range.mpr (hp a (Finset.mem_range.mp ha)).1
  · intro a ha; exact Finset.mem_range.mpr (hp a (Finset.mem_range.mp ha)).1
  · intro a ha; exact (hp a (Finset.mem_range.mp ha)).2
  · intro a ha; exact (hp a (Finset.mem_range.mp ha)).2
  · intro a ha
    have ha := Finset.mem_range.mp ha
    show (if B'.testBit a = true then f a else 0) = if B.testBit (p a) = true then f (p (p a)) else 0
    rw [hbit a ha, (hp a ha).2]

/-! ### The fundamental domain -/

/-- The three weights of the cell `c`. -/
def w1 (c : ℕ) : ℕ := wtAt (24 - c) % 2 ^ 20
def w2 (c : ℕ) : ℕ := wtAt (24 - c) / 2 ^ 20 % 2 ^ 20
def w3 (c : ℕ) : ℕ := wtAt (24 - c) / 2 ^ 40

theorem wt_split (c : ℕ) : wtAt (24 - c) = w1 c + 2 ^ 20 * w2 c + 2 ^ 40 * w3 c := by
  unfold w1 w2 w3; omega

theorem wfacts : ∀ c, c < 25 → w1 c ≤ 2047 ∧ w2 c ≤ 2047 ∧ w3 c ≤ 2047 ∧
    w1 (pFI c) + w1 c = 2048 ∧ w2 (pFI c) = w2 c ∧
    w2 (pFJ c) + w2 c = 2048 ∧ w1 (pFJ c) = w1 c ∧
    w1 (pSW c) = w2 c ∧ w2 (pSW c) = w1 c ∧ w3 (pSW c) + w3 c = 2048 := by decide +kernel

theorem perm_facts : ∀ c, c < 25 → (pFI c < 25 ∧ pFI (pFI c) = c) ∧ (pFJ c < 25 ∧ pFJ (pFJ c) = c) ∧
    (pSW c < 25 ∧ pSW (pSW c) = c) := by decide +kernel

theorem domT_of {S1 S2 S3 k : ℕ} (hk : k ≤ 25) (h1 : 1024 * k ≤ S1) (h2 : 1024 * k ≤ S2)
    (h3 : 1024 * k ≤ S3) (b1 : S1 ≤ 2047 * k) (b2 : S2 ≤ 2047 * k) (b3 : S3 ≤ 2047 * k) :
    domT (S1 + 2 ^ 20 * S2 + 2 ^ 40 * S3) k = true := by
  unfold domT
  simp only [force_eq, brec_eq, n_sub, n_add, n_mul, n_mod, n_ble]
  obtain ⟨t1, ht1⟩ : ∃ t1, S1 + 524288 = t1 + 1024 * k := ⟨S1 + 524288 - 1024 * k, by omega⟩
  obtain ⟨t2, ht2⟩ : ∃ t2, S2 + 524288 = t2 + 1024 * k := ⟨S2 + 524288 - 1024 * k, by omega⟩
  obtain ⟨t3, ht3⟩ : ∃ t3, S3 + 524288 = t3 + 1024 * k := ⟨S3 + 524288 - 1024 * k, by omega⟩
  have key : 576461302059761664 + (S1 + 2 ^ 20 * S2 + 2 ^ 40 * S3) - 1125900980585472 * k =
      t1 + 1048576 * t2 + 1099511627776 * t3 := by omega
  rw [key, if_pos (by omega), if_pos (by omega), n_ble]
  omega

/-! ### Transport of the conclusion under the generating symmetries -/

theorem trI_FI (k : ℕ) (hk : k < 8) (di dj : ℤ) : ∃ k', k' < 8 ∧ ∀ c,
    trI k' (-di) dj c = (4 - (trI k di dj c).1, (trI k di dj c).2) := by
  refine ⟨if k / 4 % 2 = 1 then k ^^^ 2 else k ^^^ 1, ?_, ?_⟩
  · interval_cases k <;> decide
  · intro c
    interval_cases k <;> simp [trI] <;> omega

theorem trI_FJ (k : ℕ) (hk : k < 8) (di dj : ℤ) : ∃ k', k' < 8 ∧ ∀ c,
    trI k' di (-dj) c = ((trI k di dj c).1, 4 - (trI k di dj c).2) := by
  refine ⟨if k / 4 % 2 = 1 then k ^^^ 1 else k ^^^ 2, ?_, ?_⟩
  · interval_cases k <;> decide
  · intro c
    interval_cases k <;> simp [trI] <;> omega

theorem trI_SW (k : ℕ) (hk : k < 8) (di dj : ℤ) : ∃ k', k' < 8 ∧ ∀ c,
    trI k' dj di c = ((trI k di dj c).2, (trI k di dj c).1) := by
  refine ⟨k ^^^ 4, ?_, ?_⟩
  · interval_cases k <;> decide
  · intro c
    interval_cases k <;> simp [trI]

/-- If `f` permutes the bits below 25 by `p` and `p` acts on cell coordinates as `q` does on the images of
`trI k di dj`, a placement in `(f M)` gives a placement in `M`. -/
theorem mpi_gen {f p : ℕ → ℕ} (hbit : ∀ u c, c < 25 → (f u).testBit c = u.testBit (p c))
    {k k' : ℕ} {di dj di' dj' : ℤ} {m M : ℕ}
    (htr : ∀ c, ∀ a b : ℕ, a < 5 → b < 5 → (trI k di dj c).1 = a → (trI k di dj c).2 = b →
      ∃ a' b' : ℕ, a' < 5 ∧ b' < 5 ∧ (trI k' di' dj' c).1 = a' ∧ (trI k' di' dj' c).2 = b' ∧
        p (5 * a + b) = 5 * a' + b')
    (h : MaskPlacedIn k di dj m (f M)) : MaskPlacedIn k' di' dj' m M := by
  intro c hc hm
  obtain ⟨h1, h2, h3, h4, h5⟩ := h c hc hm
  obtain ⟨a, ha⟩ := Int.eq_ofNat_of_zero_le h1
  obtain ⟨b, hb⟩ := Int.eq_ofNat_of_zero_le h3
  obtain ⟨a', b', ha', hb', e1, e2, e3⟩ := htr c a b (by omega) (by omega) ha hb
  rw [ha, hb] at h5
  have e5 : (5 * (a : ℤ) + (b : ℤ)).toNat = 5 * a + b := by omega
  rw [e5, hbit M _ (by omega), e3] at h5
  rw [e1, e2]
  have e6 : (5 * (a' : ℤ) + (b' : ℤ)).toNat = 5 * a' + b' := by omega
  rw [e6]
  exact ⟨by omega, by omega, by omega, by omega, h5⟩

/-- A generating symmetry: `f` permutes the bits below 25 by the involution `p`, and the conclusion of the
cover lemma can be pulled back along `f`. -/
def Gen (f p : ℕ → ℕ) : Prop :=
  (∀ u c, c < 25 → (f u).testBit c = u.testBit (p c)) ∧ (∀ c, c < 25 → p c < 25 ∧ p (p c) = c) ∧
    ∀ A B, Concl (f A) (f B) → Concl A B

theorem gen_FI : Gen flipI pFI := by
  have hbit : ∀ u c, c < 25 → (flipI u).testBit c = u.testBit (pFI c) :=
    fun u c hc => flipI_bit u c (by omega)
  refine ⟨hbit, fun c hc => (perm_facts c hc).1, ?_⟩
  rintro A B ⟨e, x, k, di, dj, h1, h2, h3, h4⟩
  obtain ⟨k', hk', ht⟩ := trI_FI k h2 di dj
  have htr : ∀ c, ∀ a b : ℕ, a < 5 → b < 5 → (trI k di dj c).1 = a → (trI k di dj c).2 = b →
      ∃ a' b' : ℕ, a' < 5 ∧ b' < 5 ∧ (trI k' (-di) dj c).1 = a' ∧ (trI k' (-di) dj c).2 = b' ∧
        pFI (5 * a + b) = 5 * a' + b' := by
    intro c a b ha hb e1 e2
    refine ⟨4 - a, b, by omega, hb, ?_, ?_, ?_⟩
    · rw [ht c]; simp only; omega
    · rw [ht c]; exact e2
    · unfold pFI; omega
  exact ⟨e, x, k', -di, dj, h1, hk', mpi_gen hbit htr h3, mpi_gen hbit htr h4⟩

theorem gen_FJ : Gen flipJ pFJ := by
  have hbit : ∀ u c, c < 25 → (flipJ u).testBit c = u.testBit (pFJ c) :=
    fun u c hc => flipJ_bit u c (by omega)
  refine ⟨hbit, fun c hc => (perm_facts c hc).2.1, ?_⟩
  rintro A B ⟨e, x, k, di, dj, h1, h2, h3, h4⟩
  obtain ⟨k', hk', ht⟩ := trI_FJ k h2 di dj
  have htr : ∀ c, ∀ a b : ℕ, a < 5 → b < 5 → (trI k di dj c).1 = a → (trI k di dj c).2 = b →
      ∃ a' b' : ℕ, a' < 5 ∧ b' < 5 ∧ (trI k' di (-dj) c).1 = a' ∧ (trI k' di (-dj) c).2 = b' ∧
        pFJ (5 * a + b) = 5 * a' + b' := by
    intro c a b ha hb e1 e2
    refine ⟨a, 4 - b, ha, by omega, ?_, ?_, ?_⟩
    · rw [ht c]; exact e1
    · rw [ht c]; simp only; omega
    · unfold pFJ; omega
  exact ⟨e, x, k', di, -dj, h1, hk', mpi_gen hbit htr h3, mpi_gen hbit htr h4⟩

theorem gen_SW : Gen swapIJ pSW := by
  have hbit : ∀ u c, c < 25 → (swapIJ u).testBit c = u.testBit (pSW c) :=
    fun u c hc => swapIJ_bit u c (by omega)
  refine ⟨hbit, fun c hc => (perm_facts c hc).2.2, ?_⟩
  rintro A B ⟨e, x, k, di, dj, h1, h2, h3, h4⟩
  obtain ⟨k', hk', ht⟩ := trI_SW k h2 di dj
  have htr : ∀ c, ∀ a b : ℕ, a < 5 → b < 5 → (trI k di dj c).1 = a → (trI k di dj c).2 = b →
      ∃ a' b' : ℕ, a' < 5 ∧ b' < 5 ∧ (trI k' dj di c).1 = a' ∧ (trI k' dj di c).2 = b' ∧
        pSW (5 * a + b) = 5 * a' + b' := by
    intro c a b ha hb e1 e2
    refine ⟨b, a, hb, ha, ?_, ?_, ?_⟩
    · rw [ht c]; exact e2
    · rw [ht c]; exact e1
    · unfold pSW; omega
  exact ⟨e, x, k', dj, di, h1, hk', mpi_gen hbit htr h3, mpi_gen hbit htr h4⟩

/-! ### The cover lemma from the chunks -/

/-- The hypotheses of the cover lemma, for cells below 25. -/
def Hyp (A B : ℕ) : Prop :=
  (∀ c, c < 25 → B.testBit c = true → A.testBit c = true) ∧
    Sm 25 A (fun _ => 1) + Sm 25 B (fun _ => 1) = 25 ∧ Sm 25 A (fun _ => 1) < 25

theorem hyp_gen {f p : ℕ → ℕ} (hg : Gen f p) {A B : ℕ} (h : Hyp A B) : Hyp (f A) (f B) := by
  obtain ⟨hbit, hp, -⟩ := hg
  obtain ⟨h1, h2, h3⟩ := h
  have eA : Sm 25 (f A) (fun _ => 1) = Sm 25 A (fun _ => 1) := Sm_perm (hbit A) hp _
  have eB : Sm 25 (f B) (fun _ => 1) = Sm 25 B (fun _ => 1) := Sm_perm (hbit B) hp _
  refine ⟨fun c hc hb => ?_, by rw [eA, eB]; exact h2, by rw [eA]; exact h3⟩
  rw [hbit B c hc] at hb
  rw [hbit A c hc]
  exact h1 _ (hp c hc).1 hb

/-- The certificate: a valid table and chunks covering all values of the six lowest cells. -/
def Chunks (GT pidx : ℕ) : Prop :=
  GTValid GT ∧ ∀ p, p < 64 → ∃ lo hi L, lo ≤ p ∧ p < hi ∧ runChunk GT pidx lo hi L = true

theorem card_empty (A : ℕ) :
    ((range 25).filter (fun c => A.testBit c = false)).card + Sm 25 A (fun _ => 1) = 25 := by
  have e : Sm 25 A (fun _ => 1) = ((range 25).filter (fun c => A.testBit c = true)).card := by
    unfold Sm; rw [Finset.card_filter]
  have e2 : (range 25).filter (fun c => A.testBit c = false) =
      (range 25).filter (fun c => ¬ A.testBit c = true) := by
    apply Finset.filter_congr; intro c _; simp
  rw [e, e2, Nat.add_comm, Finset.card_filter_add_card_filter_not]; simp

/-- The cover lemma for double sets of the fundamental domain. -/
theorem main_dom {GT pidx : ℕ} (hC : Chunks GT pidx) {A B : ℕ} (h : Hyp A B)
    (h1 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w1) (h2 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w2)
    (h3 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w3) : Concl A B := by
  obtain ⟨hG, hch⟩ := hC
  obtain ⟨hBA, hsum, hlt⟩ := h
  obtain ⟨lo, hi, L, hlo, hhi, hrun⟩ := hch (B % 64) (Nat.mod_lt _ (by norm_num))
  rcases run_sound hG hrun B hlo hhi with hcov | hleaf
  · exact hcov A hBA hsum
  · have hE : Sm 25 B (fun c => wtAt (24 - c)) =
        Sm 25 B w1 + 2 ^ 20 * Sm 25 B w2 + 2 ^ 40 * Sm 25 B w3 := Sm_lin 25 B _ w1 w2 w3 _ _ wt_split
    have b1 : Sm 25 B w1 ≤ 2047 * Sm 25 B (fun _ => 1) := Sm_bound (fun c hc => (wfacts c hc).1)
    have b2 : Sm 25 B w2 ≤ 2047 * Sm 25 B (fun _ => 1) := Sm_bound (fun c hc => (wfacts c hc).2.1)
    have b3 : Sm 25 B w3 ≤ 2047 * Sm 25 B (fun _ => 1) := Sm_bound (fun c hc => (wfacts c hc).2.2.1)
    have hd : domT (Sm 25 B (fun c => wtAt (24 - c))) (Sm 25 B (fun _ => 1)) = true := by
      rw [hE]; exact domT_of (by omega) h1 h2 h3 b1 b2 b3
    have hZ := card_empty A
    obtain ⟨w, hw, hwB, hwZ⟩ := hleaf (by omega) hd ((range 25).filter (fun c => A.testBit c = false))
      (by omega)
    refine Concl.mono hw (fun c hc hwc => ?_) (fun c hc hwc => ?_)
    · rw [Nat.testBit_mod_two_pow] at hwc
      have hwc : w.testBit c = true := by simpa [hc] using hwc
      by_contra hA
      have hA : A.testBit c = false := by simpa using hA
      have h5 := hwZ c (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hc, hA⟩) hc
      rw [hwc, Nat.testBit_mod_two_pow] at h5
      have h6 : B.testBit c = true := by simpa [hc] using h5
      rw [hBA c hc h6] at hA
      exact absurd hA (by simp)
    · rw [← hwB, Nat.testBit_and, Nat.testBit_mod_two_pow] at hwc
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hwc
      exact hwc.2.2

theorem main3 {GT pidx : ℕ} (hC : Chunks GT pidx) {A B : ℕ} (h : Hyp A B)
    (h1 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w1) (h2 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w2) :
    Concl A B := by
  by_cases h3 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w3
  · exact main_dom hC h h1 h2 h3
  · obtain ⟨hbit, hp, hback⟩ := gen_SW
    have eK : Sm 25 (swapIJ B) (fun _ => 1) = Sm 25 B (fun _ => 1) := Sm_perm (hbit B) hp _
    have e1 : Sm 25 (swapIJ B) w1 = Sm 25 B w2 :=
      (Sm_perm (hbit B) hp w1).trans (Sm_congr (fun c hc => (wfacts c hc).2.2.2.2.2.2.2.1))
    have e2 : Sm 25 (swapIJ B) w2 = Sm 25 B w1 :=
      (Sm_perm (hbit B) hp w2).trans (Sm_congr (fun c hc => (wfacts c hc).2.2.2.2.2.2.2.2.1))
    have e3 : Sm 25 (swapIJ B) w3 + Sm 25 B w3 = 2048 * Sm 25 B (fun _ => 1) := by
      rw [Sm_perm (hbit B) hp w3]
      exact Sm_pair (fun c hc => (wfacts c hc).2.2.2.2.2.2.2.2.2)
    exact hback A B (main_dom hC (hyp_gen gen_SW h) (by rw [eK, e1]; exact h2) (by rw [eK, e2]; exact h1)
      (by rw [eK]; omega))

theorem main2 {GT pidx : ℕ} (hC : Chunks GT pidx) {A B : ℕ} (h : Hyp A B)
    (h1 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w1) : Concl A B := by
  by_cases h2 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w2
  · exact main3 hC h h1 h2
  · obtain ⟨hbit, hp, hback⟩ := gen_FJ
    have eK : Sm 25 (flipJ B) (fun _ => 1) = Sm 25 B (fun _ => 1) := Sm_perm (hbit B) hp _
    have e1 : Sm 25 (flipJ B) w1 = Sm 25 B w1 :=
      (Sm_perm (hbit B) hp w1).trans (Sm_congr (fun c hc => (wfacts c hc).2.2.2.2.2.2.1))
    have e2 : Sm 25 (flipJ B) w2 + Sm 25 B w2 = 2048 * Sm 25 B (fun _ => 1) := by
      rw [Sm_perm (hbit B) hp w2]
      exact Sm_pair (fun c hc => (wfacts c hc).2.2.2.2.2.1)
    exact hback A B (main3 hC (hyp_gen gen_FJ h) (by rw [eK, e1]; exact h1) (by rw [eK]; omega))

theorem main1 {GT pidx : ℕ} (hC : Chunks GT pidx) {A B : ℕ} (h : Hyp A B) : Concl A B := by
  by_cases h1 : 1024 * Sm 25 B (fun _ => 1) ≤ Sm 25 B w1
  · exact main2 hC h h1
  · obtain ⟨hbit, hp, hback⟩ := gen_FI
    have eK : Sm 25 (flipI B) (fun _ => 1) = Sm 25 B (fun _ => 1) := Sm_perm (hbit B) hp _
    have e1 : Sm 25 (flipI B) w1 + Sm 25 B w1 = 2048 * Sm 25 B (fun _ => 1) := by
      rw [Sm_perm (hbit B) hp w1]
      exact Sm_pair (fun c hc => (wfacts c hc).2.2.2.1)
    exact hback A B (main2 hC (hyp_gen gen_FI h) (by rw [eK]; omega))

/-- The cover lemma, given the certificate. -/
theorem cover_of_chunks {GT pidx : ℕ} (hC : Chunks GT pidx) (A B : ℕ)
    (hBA : ∀ c, B.testBit c = true → A.testBit c = true)
    (hcard : ((Finset.range 25).filter (fun c => A.testBit c = true)).card +
      ((Finset.range 25).filter (fun c => B.testBit c = true)).card = 25)
    (hz : ∃ c, c < 25 ∧ A.testBit c = false) : Concl A B := by
  have eA : Sm 25 A (fun _ => 1) = ((range 25).filter (fun c => A.testBit c = true)).card := by
    unfold Sm; rw [Finset.card_filter]
  have eB : Sm 25 B (fun _ => 1) = ((range 25).filter (fun c => B.testBit c = true)).card := by
    unfold Sm; rw [Finset.card_filter]
  refine main1 hC ⟨fun c _ => hBA c, by rw [eA, eB]; exact hcard, ?_⟩
  obtain ⟨c, hc, hAc⟩ := hz
  have := card_empty A
  have hpos : 0 < ((range 25).filter (fun c => A.testBit c = false)).card :=
    Finset.card_pos.mpr ⟨c, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hc, hAc⟩⟩
  omega

