variable {h Q J x : ℝ} {F b A : ℝ → ℝ}
theorem solution (hx : x ≠ 0) (hF : F x ≠ 0) (hb : b x ≠ 0) (hu : 1 - h * x ≠ 0)
    (hPC : realPC h Q J F b A x = 0)
    (h1 : 0 < 2 - x * Zf h F x + 2 * (1 - h * x) * x * rf b x)
    (h2 : 0 < 2 - x * Zf h F x + (1 - h * x) * x * rf b x) :
    deriv b x = b x * rootE h Q J x (F x) (b x) (Zf h F x) (Vf A x) (Wf b A x) (Df F b x) := by
  have hq := quad_pcE x h Q J (F x) (deriv F x) (deriv (deriv F) x) (b x) (deriv b x)
    (deriv (deriv b) x) (A x) (deriv A x) (deriv (deriv A) x) hx hF hb hu
  unfold realPC at hPC
  rw [hPC, zero_div] at hq
  have hq0 : x * (1 - h * x) * rf b x ^ 2 + (2 - x * Zf h F x) * rf b x
      + rhoE h Q J x (F x) (b x) (Zf h F x) (Vf A x) (Wf b A x) (Df F b x) = 0 := by
    have := (mul_eq_zero.1 hq).resolve_left hx
    unfold rf Zf Vf Wf Df; rw [← this]
  have hr := root_eq hq0 (by linarith) (by linarith)
  unfold rootE
  rw [← hr]; unfold rf; field_simp
