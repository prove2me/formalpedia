/-- The digit decomposition really is `e = Σ_j a_j m^j`. -/
lemma digit_decomposition (m e : ℕ) :
    ∑ j ∈ range (Nat.digits m e).length, AModel.digit m e j * m ^ j = e := by
  unfold AModel.digit
  conv_rhs => rw [← Nat.ofDigits_digits m e]
  generalize Nat.digits m e = L
  induction L with
  | nil => simp
  | cons d L ih =>
    rw [List.length_cons, sum_range_succ', Nat.ofDigits_cons, ← ih, mul_sum]
    simp only [List.getD_cons_succ, List.getD_cons_zero, pow_zero, mul_one, pow_succ]
    rw [add_comm]
    congr 1
    apply sum_congr rfl
    intro j _
    ring

end AModel

