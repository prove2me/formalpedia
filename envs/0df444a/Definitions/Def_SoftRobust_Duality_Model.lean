-- title:
--   The soft robust model: decision set, payoff, families of measures, $\alpha^Q$, $\mathcal Q^\alpha$, $\rho^Q$ and the set $X^Q(\delta)$ ((5))
-- statement:
--   **The model (§2.1).** Let $(\Omega,\mathcal F)$ be a measurable space and $\mathcal P$ the set of probability measures on it. Let $X \subseteq \mathbb R^n$ be a nonempty, closed, convex set of feasible decisions, $u:\Omega\to\mathbb R^m$ a random variable of uncertain parameters, and $f:\mathbb R^n\times\mathbb R^m\to\mathbb R$ a payoff function such that $x \mapsto f(x,u(\omega))$ is concave on $X$ for every $\omega$, and such that for every $x \in X$ the random variable $f(x) := f(x,u(\cdot))$ is measurable and bounded.
--
--   **Families of measures.** A family $\mathbf Q = \{\mathcal Q(\varepsilon) \subseteq \mathcal P : \varepsilon \ge 0\}$ is **nondecreasing** if $\mathcal Q(\varepsilon_1) \subseteq \mathcal Q(\varepsilon_2)$ whenever $\varepsilon_2 \ge \varepsilon_1 \ge 0$, and **convex** if $\mathbb Q_1 \in \mathcal Q(\varepsilon_1)$ and $\mathbb Q_2 \in \mathcal Q(\varepsilon_2)$ imply $\lambda\mathbb Q_1 + (1-\lambda)\mathbb Q_2 \in \mathcal Q(\lambda\varepsilon_1 + (1-\lambda)\varepsilon_2)$ for all $\lambda\in[0,1]$. The family is **admissible** if it is nondecreasing, convex, and $\mathcal Q(0) \neq \emptyset$.
--
--   **Penalty of a family and family of a penalty.** For a family $\mathbf Q$ and a penalty $\alpha:\mathcal P\to[0,\infty]$,
--   $$
--   \alpha^Q(\mathbb Q) = \inf\{\varepsilon \ge 0 : \mathbb Q \in \mathcal Q(\varepsilon)\}, \qquad \mathcal Q^\alpha(\varepsilon) = \{\mathbb Q \in \mathcal P : \alpha(\mathbb Q) \le \varepsilon\},
--   $$
--   with $\alpha^Q(\mathbb Q) = +\infty$ when $\mathbb Q$ lies in no $\mathcal Q(\varepsilon)$. The risk measure $\rho^Q$ is the one generated by $\alpha^Q$: $\rho^Q(Y) = \sup_{\mathbb Q}\{-\mathbb E_{\mathbb Q}[Y] - \alpha^Q(\mathbb Q)\}$.
--
--   **Soft robust feasible set (5).** For $\delta \ge 0$,
--   $$
--   X^Q(\delta) = \Big\{ x \in X : \inf_{\mathbb Q \in \mathcal Q(\varepsilon)} \mathbb E_{\mathbb Q}[f(x)] \ge -\varepsilon \ \ \forall \varepsilon \in [0,\delta] \Big\}.
--   $$
--
--   **Dual objective.** For a risk measure $\rho$, $\delta$, a payoff $Y$ and $\lambda \ge 0$, the objective of (6) is $\lambda\delta + (\lambda+1)\,\rho\big(Y/(\lambda+1)\big)$.
--
--   These definitions are shared by every statement of the mission: the soft robust set on one side and the convex risk measure constraint on the other side of Theorem 2.1.
--
--   **Formalization Note** Decisions live in `EuclideanSpace ℝ (Fin n)`, parameters in `EuclideanSpace ℝ (Fin m)`; the standing assumptions of §2.1 are fields of the structure `Model` (concavity, closedness and convexity of $X$ are the paper's assumptions and are not used by Theorem 2.1). The level $\varepsilon$ ranges over `ℝ≥0`, so a family is a map `ℝ≥0 → Set (ProbabilityMeasure Ω)`. $\alpha^Q$ is an infimum in $[0,\infty]$, where the empty infimum is $+\infty$. In $X^Q(\delta)$ the bound $\inf_{\mathbb Q\in\mathcal Q(\varepsilon)} \mathbb E_{\mathbb Q}[f(x)] \ge -\varepsilon$ is written as $\mathbb E_{\mathbb Q}[f(x)] \ge -\varepsilon$ for every $\mathbb Q \in \mathcal Q(\varepsilon)$, which is equivalent (an empty infimum is $+\infty$).
-- source:
--   Ben-Tal, Bertsimas, Brown, A Soft Robust Model for Optimization Under Ambiguity, Oper. Res. 58(4) (2010), pp. 1222–1223, §2.1 (model, nondecreasing family), §2.3 (family Q, soft robust set (5)), Theorem 2.1 (α^Q, 𝒬^α, ρ^Q, objective of (6)); p. 1234, endnote 3 (convex family)

import Mathlib
import Definitions.Def_SoftRobust_Duality_Mixture
import Definitions.Def_SoftRobust_Duality_ConvexRiskMeasure

open MeasureTheory
open scoped NNReal ENNReal

namespace SoftRobust.Duality

/-- The model of §2.1 (p. 1222): a nonempty, closed, convex feasible set `X ⊆ ℝⁿ`, a random variable
`u : Ω → ℝᵐ` of uncertain parameters, and a payoff `f : ℝⁿ × ℝᵐ → ℝ` (curried) such that
`x ↦ f(x, u(ω))` is concave on `X` for every `ω`, and the random variable `f(x, u)` is measurable
and bounded for every `x ∈ X`. -/
structure Model (Ω : Type*) [MeasurableSpace Ω] (n m : ℕ) where
  X : Set (EuclideanSpace ℝ (Fin n))
  u : Ω → EuclideanSpace ℝ (Fin m)
  f : EuclideanSpace ℝ (Fin n) → EuclideanSpace ℝ (Fin m) → ℝ
  X_nonempty : X.Nonempty
  X_closed : IsClosed X
  X_convex : Convex ℝ X
  u_measurable : Measurable u
  f_concave : ∀ ω, ConcaveOn ℝ X (fun x => f x (u ω))
  payoff_measurable : ∀ x ∈ X, Measurable (fun ω => f x (u ω))
  payoff_bounded : ∀ x ∈ X, ∃ C : ℝ, ∀ ω, |f x (u ω)| ≤ C

variable {Ω : Type*} [MeasurableSpace Ω]

/-- The random payoff `f(x) : ω ↦ f(x, u(ω))` of a decision `x`. -/
def Model.payoff {n m : ℕ} (M : Model Ω n m) (x : EuclideanSpace ℝ (Fin n)) : Ω → ℝ :=
  fun ω => M.f x (M.u ω)

/-- The family `𝐐 = {𝒬(ε) : ε ≥ 0}` is *nondecreasing* (p. 1222): `𝒬(ε₁) ⊆ 𝒬(ε₂)` for `ε₂ ≥ ε₁ ≥ 0`. -/
def IsNondecreasingFamily (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) : Prop :=
  Monotone 𝒬

/-- The family is *convex* (endnote 3, p. 1234): if `ℚ₁ ∈ 𝒬(ε₁)` and `ℚ₂ ∈ 𝒬(ε₂)` then for all
`λ ∈ [0, 1]`, `λℚ₁ + (1 − λ)ℚ₂ ∈ 𝒬(λε₁ + (1 − λ)ε₂)`. -/
def IsConvexFamily (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) : Prop :=
  ∀ (ε₁ ε₂ : ℝ≥0) (Q₁ Q₂ : ProbabilityMeasure Ω) (t : ℝ≥0) (ht : t ≤ 1),
    Q₁ ∈ 𝒬 ε₁ → Q₂ ∈ 𝒬 ε₂ → mix t ht Q₁ Q₂ ∈ 𝒬 (t * ε₁ + (1 - t) * ε₂)

/-- The standing assumptions on `𝐐` (p. 1223): nondecreasing, convex, and `𝒬(0)` nonempty. -/
structure IsAdmissibleFamily (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) : Prop where
  mono : IsNondecreasingFamily 𝒬
  convex : IsConvexFamily 𝒬
  zero_nonempty : (𝒬 0).Nonempty

/-- The penalty of the family (Theorem 2.1, p. 1223): `α^Q(ℚ) = inf{ε ≥ 0 : ℚ ∈ 𝒬(ε)}`, valued in
`[0, ∞]`; it is `∞` when `ℚ` lies in no `𝒬(ε)`. -/
noncomputable def penaltyOfFamily (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω))
    (Q : ProbabilityMeasure Ω) : ℝ≥0∞ :=
  ⨅ (ε : ℝ≥0) (_ : Q ∈ 𝒬 ε), (ε : ℝ≥0∞)

/-- The family of a penalty (Theorem 2.1, p. 1223): `𝒬^α(ε) = {ℚ ∈ 𝒫 : α(ℚ) ≤ ε}`. -/
def familyOfPenalty (α : ProbabilityMeasure Ω → ℝ≥0∞) (ε : ℝ≥0) : Set (ProbabilityMeasure Ω) :=
  {Q | α Q ≤ (ε : ℝ≥0∞)}

/-- `ρ^Q`, the risk measure generated by `α^Q` (Theorem 2.1, p. 1223). -/
noncomputable def rhoQ (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) (Y : Ω → ℝ) : ℝ :=
  riskOfPenalty (penaltyOfFamily 𝒬) Y

/-- The soft robust feasible set (5), p. 1223:
`X^Q(δ) = {x ∈ X : inf_{ℚ ∈ 𝒬(ε)} E_ℚ[f(x)] ≥ −ε for all ε ∈ [0, δ]}`, with the infimum bound
written as a bound on every `E_ℚ[f(x)]`, `ℚ ∈ 𝒬(ε)`. -/
def softRobustSet {n m : ℕ} (M : Model Ω n m) (𝒬 : ℝ≥0 → Set (ProbabilityMeasure Ω)) (δ : ℝ) :
    Set (EuclideanSpace ℝ (Fin n)) :=
  {x | x ∈ M.X ∧ ∀ ε : ℝ≥0, (ε : ℝ) ≤ δ → ∀ Q ∈ 𝒬 ε,
    -(ε : ℝ) ≤ ∫ ω, M.payoff x ω ∂(Q : Measure Ω)}

/-- The objective of (6): `λ ↦ λδ + (λ + 1) ρ(Y / (λ + 1))`. -/
noncomputable def dualObjective (ρ : (Ω → ℝ) → ℝ) (δ : ℝ) (Y : Ω → ℝ) (l : ℝ) : ℝ :=
  l * δ + (l + 1) * ρ (fun ω => Y ω / (l + 1))

end SoftRobust.Duality


