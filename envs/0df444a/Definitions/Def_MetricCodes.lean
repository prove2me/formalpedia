def totalYoungRowEuler {r n : ℕ} :
    Derivation ℂ (MvPolynomial (Fin ((r + 1) * n)) ℂ)
      (MvPolynomial (Fin ((r + 1) * n)) ℂ) :=
  ∑ a : Fin (r + 1), rowDerivation a a
def antiholomorphicEulerDefect {r n : ℕ}
    (h : 2 * (r + 1) ≤ n) :
    Derivation ℂ (MvPolynomial (Fin ((r + 1) * n)) ℂ)
      (MvPolynomial (Fin ((r + 1) * n)) ℂ) :=
