-- title:
--   Powers preserve weighted component span relations
-- statement:
--   If a power of a polynomial belongs to the ideal generated by weighted degree-`q` components of elements of `I^s` whose support weights are at most `q`, then raising that relation to a positive integer power `m` gives the corresponding relation at degree `D = mq`, ideal power `s*m`, and support cutoff `D`.
-- source:
--   openai/math Ampleness stack: WeightedIdealCurveBound implies eps-ample exceptional twist, hence Serre vanishing and eventual generation of I^n by weight ≤ n(rho+eps) sections.

import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Data.Rat.Defs
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous

open scoped BigOperators

theorem OAI.PiExponent.FormalInterpolation.weighted_component_span_pow
    {d : Nat} (I : Ideal (MvPolynomial (Fin d) Complex))
    (w : Fin d → Rat) (s m n : Nat) (q D : Rat)
    (hs : 0 < s) (hm : 0 < m) (hD : q * (m : Rat) = D)
    (f : MvPolynomial (Fin d) Complex)
    (hrel : f ^ n ∈ Ideal.span (Set.range (fun (p :
      {g : MvPolynomial (Fin d) Complex //
        g ∈ I ^ s ∧
        ∀ a ∈ g.support,
          ∑ j, (w j : Real) * (a j : Real) ≤ (q : Real)}) =>
      MvPolynomial.weightedHomogeneousComponent
        (fun j => (w j : ℚ)) q p.1))) :
    f ^ (n * m) ∈ Ideal.span {h : MvPolynomial (Fin d) Complex |
      ∃ g : MvPolynomial (Fin d) Complex,
        g ∈ I ^ (s * m) ∧
        (∀ a ∈ g.support,
          ∑ k, (w k : Real) * (a k : Real) ≤ (D : Real)) ∧
        h = MvPolynomial.weightedHomogeneousComponent
          (fun k => (w k : ℚ)) D g} := by sorry
