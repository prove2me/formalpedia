    obtain ⟨h02, h4z⟩ := (add_eq_zero_iff_of_nonneg (add_nonneg t0 t2) t4).mp h
    obtain ⟨h0z, h2z⟩ := (add_eq_zero_iff_of_nonneg t0 t2).mp h02
    exact ⟨(pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp h0z).resolve_left h0.ne'),
      (pow_eq_zero_iff two_ne_zero).mp ((mul_eq_zero.mp h2z).resolve_left h2.ne'),
