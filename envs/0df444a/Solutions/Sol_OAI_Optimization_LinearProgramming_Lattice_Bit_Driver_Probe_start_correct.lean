theorem append {o a b c qs rs} (h : Steps o a qs b) (k : Steps o b rs c) : Steps o a (qs++rs) c := by
  induction h with
  | stop => exact k
  | ask _ ih => exact .ask (ih k)

theorem finish {o a b qs rs r} (h : Steps o a qs b) (k : Runs o b rs r) : Runs o a (qs++rs) r := by
  induction h with
  | stop => exact k
  | ask _ ih => exact .ask (ih k)

