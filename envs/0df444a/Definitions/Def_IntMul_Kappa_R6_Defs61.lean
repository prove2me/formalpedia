-- Source module: Solutions.KFMSetup
/-!
# KFM 14: the setup arithmetic (§9.2), in the integer form the machine computes

* **`floor_root_eq`/`floor_root_spec`**: `⌊N^{1/m}⌋ = x` iff `x^m ≤ N < (x+1)^m`, so
  **`dP_spec`** (`m = 2^75`, of `b`) and **`KP_spec`** (`m = 2^56`, of `d`) are exact integer
  comparisons (computed by saturating powers and binary search).
* **`ceil_root_eq`**, **`αP_spec`**: `α = αP n` iff `(α-1)^4 < 12 d² b ≤ α^4`.
* **`LP_spec`/`LP_eq`**: `L = LP n` iff `4n ≤ 2^L b` and (`L = 0` or `4n > 2^{L-1} b`).
* **`srcS d d' r i`**: the explicit source lengths of `RCop.coprime_params`
  (`1 + Q m_i`, `Q = 2F(⌊r/(2FD)⌋+1)`, `F = D!`, `D = 256 d²`), and **`srcS_ok`**: odd, pairwise
  coprime, in the windows `((1-2η)t_i, (1-η)t_i]`; **`srcS_ok_n`** for the parameters of `n ≥ n₀`.
* **`mu_spec`**: `μ = (P mod s)⁻¹` from `Nat.gcdA` (extended Euclid) satisfies `μ P ≡ 1 (mod s)`.
-/

namespace NLogN.KFM

open IntMul.OpenAI.Glue IntMul.OpenAI.RCost

noncomputable section

/-! ## Integer roots -/

lemma root_le_iff (N m x : ℕ) (hm : 1 ≤ m) :
    (x : ℝ) ≤ (N : ℝ) ^ ((1 : ℝ) / m) ↔ x ^ m ≤ N := by
  have hm' : (0 : ℝ) < m := by exact_mod_cast hm
  rw [one_div, Real.le_rpow_inv_iff_of_pos (Nat.cast_nonneg _) (Nat.cast_nonneg _) hm',
    Real.rpow_natCast]
  exact_mod_cast Iff.rfl

theorem floor_root_spec (N m : ℕ) (hm : 1 ≤ m) :
    ⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊ ^ m ≤ N ∧ N < (⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊ + 1) ^ m := by
  set x := ⌊(N : ℝ) ^ ((1 : ℝ) / m)⌋₊
  refine ⟨(root_le_iff N m x hm).1 (Nat.floor_le (by positivity)), ?_⟩
  by_contra h
  push Not at h
  have h3 := (root_le_iff N m (x + 1) hm).2 h
  have h4 := Nat.lt_floor_add_one ((N : ℝ) ^ ((1 : ℝ) / m))
  push_cast at h3
  linarith

lemma eps_eq : ε = (1 : ℝ) / ((2 ^ 75 : ℕ) : ℝ) := by unfold ε; norm_num

/-- `d = dP n` is the integer `2^75`-th root of `b`. -/
theorem dP_spec_r6c (n : ℕ) : dP n ^ (2 ^ 75) ≤ bP n ∧ bP n < (dP n + 1) ^ (2 ^ 75) := by
  have := floor_root_spec (bP n) (2 ^ 75) Nat.one_le_two_pow
  unfold dP; rw [eps_eq]; exact this

/-! ## Explicit source lengths -/

/-! ## Modular inverses -/

end

end NLogN.KFM

