def SelbergRealEndpointDualLargeSieve : Prop :=
  ∀ (k : ℕ) (α : ℕ → ℝ) (b : ℕ → ℂ) (P : Finset ℕ) (W' W : ℝ) (δ : ℝ),
    0 < δ → δ ≤ 1 → (∀ p ∈ P, W' < (p : ℝ) ∧ (p : ℝ) ≤ W) →
      P.Nonempty → WellSpaced δ (Finset.range k) α →
        ∑ p ∈ P,
            ‖∑ i ∈ Finset.range k,
                conj (Vinogradov.addChar (α i) p) * b i‖ ^ 2 ≤
          ((W - W') + δ⁻¹) * ∑ i ∈ Finset.range k, ‖b i‖ ^ 2
end MathExtras.NumberTheory.Analysis.LargeSieve
end
