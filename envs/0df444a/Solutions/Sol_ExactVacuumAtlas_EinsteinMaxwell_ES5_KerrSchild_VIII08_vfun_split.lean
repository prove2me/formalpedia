/-! ## The reparametrised potential `beta(t) = b_s(1/t)` -/

theorem beta_zero (j : ℝ) (q : ℝ → ℝ) : beta j q 0 = 0 := by
  unfold beta
  rw [if_pos rfl]

theorem beta_of_ne {j : ℝ} {q : ℝ → ℝ} {t : ℝ} (ht : t ≠ 0) :
    beta j q t = bfun j q (1 / t) := by
  unfold beta
  rw [if_neg ht]

/-! ## Continuity of `beta` on the compact window `[0, 1/3]` -/

theorem tendsto_one_div_Ioo_aG : Tendsto (fun t : ℝ => (1:ℝ) / t) (𝓝[Ioo (0:ℝ) aG] aG) (𝓝[>] (3:ℝ)) := by
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
  · have hc : ContinuousAt (fun t : ℝ => (1:ℝ) / t) aG := by
      refine ContinuousAt.div continuousAt_const continuousAt_id ?_
      have ha : aG = 1 / 3 := rfl
      rw [ha]; norm_num
    have hv : (1:ℝ) / aG = 3 := by have ha : aG = 1 / 3 := rfl; rw [ha]; norm_num
    simpa [hv] using hc.tendsto.mono_left nhdsWithin_le_nhds
  · filter_upwards [self_mem_nhdsWithin] with t ht
    have ht0 : (0:ℝ) < t := ht.1
    have ha : aG = 1 / 3 := rfl
    have hlt : t < 1 / 3 := ha ▸ ht.2
    show (3:ℝ) < 1 / t
    rw [lt_div_iff₀ ht0]
    linarith

theorem continuousWithinAt_beta_zero {j Aq : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) :
    ContinuousWithinAt (beta j q) (Icc (0:ℝ) aG) 0 := by
  have haG : (0:ℝ) < aG := by have ha : aG = 1 / 3 := rfl; rw [ha]; norm_num
  rw [ContinuousWithinAt, beta_zero, Icc_eq_insert,
    nhdsWithin_insert (a := (0:ℝ)), nhdsWithin_insert_of_ne (x := (0:ℝ)) (y := aG) (by linarith)]
  refine tendsto_sup.mpr ⟨?_, ?_⟩
  · simpa [beta_zero] using tendsto_pure_nhds (beta j q) (0:ℝ)
  · have hu : Tendsto (fun t : ℝ => (3 * |j| + Aq) * t / 8) (𝓝[Ioo (0:ℝ) aG] 0) (𝓝 0) := by
      have hc : ContinuousAt (fun t : ℝ => (3 * |j| + Aq) * t / 8) 0 := by
        fun_prop
      simpa using hc.tendsto.mono_left nhdsWithin_le_nhds
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le' (by simpa using hu.neg) hu ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with t ht
      exact neg_le_of_abs_le (beta_abs_le (j := j) hqc hq hAq ht)
    · filter_upwards [self_mem_nhdsWithin] with t ht
      exact le_of_abs_le (beta_abs_le (j := j) hqc hq hAq ht)

theorem continuousWithinAt_beta_third {j Aq : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) :
    ContinuousWithinAt (beta j q) (Icc (0:ℝ) aG) aG := by
  have haG : (0:ℝ) < aG := by have ha : aG = 1 / 3 := rfl; rw [ha]; norm_num
  have hval : beta j q aG = bfun j q 3 := by
    rw [beta_of_ne (ne_of_gt haG)]
    have ha : aG = 1 / 3 := rfl
    rw [ha]; norm_num
  rw [ContinuousWithinAt, hval, Icc_eq_insert,
    nhdsWithin_insert_of_ne (x := aG) (y := (0:ℝ)) (by linarith), nhdsWithin_insert (a := aG)]
  refine tendsto_sup.mpr ⟨?_, ?_⟩
  · simpa [hval] using tendsto_pure_nhds (beta j q) aG
  · have hcomp : Tendsto (fun t : ℝ => (1:ℝ) / t) (𝓝[Ioo (0:ℝ) aG] aG) (𝓝[>] (3:ℝ)) :=
      tendsto_one_div_Ioo_aG
    have hb := (tendsto_bfun_three (j := j) hqc hq hAq).comp hcomp
    refine hb.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact (beta_of_ne (ne_of_gt ht.1)).symm

theorem continuousAt_beta_interior {j Aq : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) {x : ℝ} (hx : x ∈ Ioo (0:ℝ) aG) :
    ContinuousAt (beta j q) x := by
  have hx0 : (0:ℝ) < x := hx.1
  have hx3 : (3:ℝ) < 1 / x := by
    have ha : aG = 1 / 3 := rfl
    have hlt : x < 1 / 3 := ha ▸ hx.2
    rw [lt_div_iff₀ hx0]
    linarith
  have hbf : ContinuousAt (bfun j q) (1 / x) :=
    (contDiffOn_two_bfun (j := j) hqc).continuousOn.continuousAt (isOpen_Ioi.mem_nhds hx3)
  have hinv : ContinuousAt (fun t : ℝ => (1:ℝ) / t) x := by
    refine ContinuousAt.div continuousAt_const continuousAt_id ?_
    exact ne_of_gt hx0
  refine (hbf.comp (x := x) hinv).congr ?_
  filter_upwards [isOpen_Ioo.mem_nhds hx] with t ht
  exact (beta_of_ne (ne_of_gt ht.1)).symm

theorem continuousOn_beta {j Aq : ℝ} {q : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) :
    ContinuousOn (beta j q) (Icc (0:ℝ) aG) := by
  intro x hx
  rcases eq_or_lt_of_le hx.1 with h0 | h0
  · rw [← h0]
    exact continuousWithinAt_beta_zero (j := j) hqc hq hAq
  · rcases eq_or_lt_of_le hx.2 with h1 | h1
    · rw [h1]
      exact continuousWithinAt_beta_third (j := j) hqc hq hAq
    · exact (continuousAt_beta_interior (j := j) hqc hq hAq ⟨h0, h1⟩).continuousWithinAt

/-! ## The rotation integrand and the rotation itself -/

theorem continuousOn_Gfun {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    ContinuousOn (Gfun j q r) (Icc (0:ℝ) aG) := by
  have hb : ContinuousOn (beta j q) (Icc (0:ℝ) aG) := continuousOn_beta (j := j) hqc hq hAq
  have hr' : ContinuousOn r (Icc (0:ℝ) aG) := hr.mono KG_subset_UG
  have hid : ContinuousOn (fun t : ℝ => t) (Icc (0:ℝ) aG) := continuousOn_id
  unfold Gfun
  refine hid.mul ?_
  refine (continuousOn_const.add (hb.const_mul 6)).sub (hid.mul hr')

/-! ## The derivative of `v` -/

/-! ## Continuity of `v` and the endpoint class `VClass 3` -/

/-! ## The two sharp bounds for `v` -/

theorem continuousOn_Gshift {j Aq : ℝ} {q r : ℝ → ℝ} (hqc : ContDiffOn ℝ 1 q UG)
    (hq : ∀ x ∈ KG, |q x| ≤ Aq) (hAq : 0 ≤ Aq) (hr : ContinuousOn r UG) :
    ContinuousOn (fun t : ℝ => 6 * t * beta j q t - t ^ 2 * r t) (Icc (0:ℝ) aG) := by
  have hb : ContinuousOn (beta j q) (Icc (0:ℝ) aG) := continuousOn_beta (j := j) hqc hq hAq
  have hr' : ContinuousOn r (Icc (0:ℝ) aG) := hr.mono KG_subset_UG
  have hid : ContinuousOn (fun t : ℝ => t) (Icc (0:ℝ) aG) := continuousOn_id
  exact ((continuousOn_const.mul hid).mul hb).sub ((continuousOn_id.pow 2).mul hr')

