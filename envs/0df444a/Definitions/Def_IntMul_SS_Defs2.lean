-- Source module: NLogNP.SSLoops
/-!
# Generic counted loops over item arrays
-/

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- Decrement the counter on top of `C` (uses `T3`). -/
def decC (C : Fin NS) : IStmt NS P := .seq (.op (.const T3 (-1))) (.op (.add C T3 C))

/-- Move `k` integers from `X` to `Y` (reversing them); `k` is the counter on top of `C`. -/
def mvN (X Y C : Fin NS) : IStmt NS P :=
  .loop C (fun c => c != .zero) (.seq (.op (.mv X Y)) (decC C))

def ints (A : List ℤ) : List Item := A.map .int

@[simp] theorem ints_nil : ints [] = [] := rfl
@[simp] theorem ints_cons (a : ℤ) (A : List ℤ) : ints (a :: A) = .int a :: ints A := rfl

/-- All entries have at most `m` bits. -/
def Bnd (m : ℕ) (A : List ℤ) : Prop := ∀ a ∈ A, zsz a ≤ m

end NLogN

end

section
-- Source module: NLogNP.SSDif
/-!
# The forward FFT (decimation in frequency) over `ℤ/(2^n+1)`, as a recursive procedure
-/

namespace NLogN

open IntMul

abbrev DX : Fin NS := 8
abbrev DL : Fin NS := 9
abbrev DE : Fin NS := 10
abbrev U : Fin NS := 11
abbrev V : Fin NS := 12
abbrev P1 : Fin NS := 13
abbrev P2 : Fin NS := 14
abbrev CC : Fin NS := 15
abbrev W : Fin NS := 16
abbrev HH : Fin NS := 17

/-! ## Reference functions -/

/-- Sums of the butterflies. -/
def bflyT (F : ℤ) : List ℤ → List ℤ → List ℤ
  | u :: A, v :: B => ((v + u) % F) :: bflyT F A B
  | _, _ => []

/-- Twisted differences of the butterflies, starting at index `j`. -/
def bflyB (F : ℤ) (E j : ℕ) : List ℤ → List ℤ → List ℤ
  | u :: A, v :: B => (((-v + u) * 2 ^ (j * E)) % F) :: bflyB F E (j + 1) A B
  | _, _ => []

/-- Entries are canonical residues mod `F`. -/
def Canon (F : ℤ) (A : List ℤ) : Prop := ∀ a ∈ A, 0 ≤ a ∧ a < F

/-- The forward transform: input of length `2^j`, output in "bit-reversed" order. -/
def difZ (F : ℤ) : ℕ → ℕ → List ℤ → List ℤ
  | _, 0, A => A
  | E, j + 1, A => difZ F (2 * E) j (bflyT F (A.take (2 ^ j)) (A.drop (2 ^ j))) ++
      difZ F (2 * E) j (bflyB F E 0 (A.take (2 ^ j)) (A.drop (2 ^ j)))

/-! ## The butterfly step -/

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

def bflyStep : IStmt NS P :=
  .seq (.seq (.op (.dup DX T4)) (.seq (.op (.dup V P1)) (.op (.add T4 P1 P1)))) (.seq (fred P1)
    (.seq (.seq (.op (.mv DX T4)) (.seq (.op (.neg T4)) (.seq (.op (.mv V P2))
      (.seq (.op (.add T4 P2 P2)) (.op (.shl P2 W)))))) (.seq (fred P2)
        (.seq (.op (.shl W DE)) (decC CC)))))

end NLogN

namespace NLogN

open IntMul

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

/-- Move `len` integers from `X` to `Y`, where `len` is on top of `HH`. -/
def mvH (X Y : Fin NS) : IStmt NS P := .seq (.op (.dup HH CC)) (.seq (mvN X Y CC) (.op (.drop CC)))

def difSegA : IStmt NS P :=
  .seq (.op (.dup DL HH)) (.seq (.op (.const T4 2)) (.seq (.op (.split HH T4 T3))
    (.seq (.op (.drop T3)) (.op (.drop T4)))))

def difSegD : IStmt NS P :=
  .seq (.op (.const W 1)) (.seq (.op (.dup HH CC)) (.seq (.loop CC (fun c => c != .zero) bflyStep)
    (.seq (.op (.drop CC)) (.op (.drop W)))))

def difSegE : IStmt NS P :=
  .seq (.op (.dup HH DL)) (.seq (.op (.dup DE T4)) (.seq (.op (.shl T4 DE)) (.op (.mv T4 DE))))

def difSegH : IStmt NS P := .seq (.op (.drop DE)) (.seq (.op (.drop DL)) (.op (.drop HH)))

def difMain (pD : Fin P) : IStmt NS P :=
  .seq difSegA (.seq (mvH DX U) (.seq (mvH U V) (.seq difSegD (.seq difSegE
    (.seq (mvH P2 DX) (.seq (.call pD) (.seq (mvH P1 DX) (.seq (.call pD) difSegH))))))))

def difTest : IStmt NS P := .seq (.op (.dup DL CC)) (.seq (.op (.const T4 (-1))) (.op (.add CC T4 CC)))

def difBody (pD : Fin P) : IStmt NS P :=
  .seq difTest (.ite CC (fun c => c == .zero) (.op (.drop CC)) (.seq (.op (.drop CC)) (difMain pD)))

def difCost (n j : ℕ) : ℕ := 400000 * (n + 3) * (j + 1) * 2 ^ j

end NLogN

end

section
-- Source module: NLogNP.SSDit
/-!
# The inverse FFT (decimation in time) over `ℤ/(2^n+1)`, as a recursive procedure
-/

namespace NLogN

open IntMul

/-! ## Reference functions -/

/-- `t_i - 2^(-iE) b_i`, written with `2^(n-(i+1)E)·2^E = 2^(n-iE)`. -/
def dcomX (F : ℤ) (n E i : ℕ) : List ℤ → List ℤ → List ℤ
  | t :: T, b :: B => ((t + -((b * 2 ^ (n - i * E)) % F)) % F) :: dcomX F n E (i + 1) T B
  | _, _ => []

def dcomY (F : ℤ) (n E i : ℕ) : List ℤ → List ℤ → List ℤ
  | t :: T, b :: B => ((t + (b * 2 ^ (n - i * E)) % F) % F) :: dcomY F n E (i + 1) T B
  | _, _ => []

/-- The inverse transform (input in the output order of `difZ`). -/
def ditZ (F : ℤ) (n : ℕ) : ℕ → ℕ → List ℤ → List ℤ
  | _, 0, B => B
  | E, j + 1, B =>
    dcomX F n E 0 (ditZ F n (2 * E) j (B.take (2 ^ j))) (ditZ F n (2 * E) j (B.drop (2 ^ j))) ++
      dcomY F n E 0 (ditZ F n (2 * E) j (B.take (2 ^ j))) (ditZ F n (2 * E) j (B.drop (2 ^ j)))

/-! ## The butterfly step -/

variable {P : ℕ} {I : List Sym} {iprog : Fin P → IStmt NS P}

def ditStep : IStmt NS P :=
  .seq (.seq (.op (.mv DX T4)) (.op (.shl T4 W))) (.seq (fred T4)
    (.seq (.seq (.op (.dup T4 P1)) (.seq (.op (.neg P1)) (.seq (.op (.dup V T3))
      (.op (.add T3 P1 P1))))) (.seq (fred P1)
    (.seq (.seq (.op (.mv T4 P2)) (.seq (.op (.mv V T3)) (.op (.add T3 P2 P2)))) (.seq (fred P2)
      (.seq (.op (.split W DE T3)) (.seq (.op (.drop T3)) (decC CC))))))))

def ditSegD : IStmt NS P :=
  .seq (.op (.dup RN W)) (.seq (.op (.dup HH CC)) (.seq (.loop CC (fun c => c != .zero) ditStep)
    (.seq (.op (.drop CC)) (.op (.drop W)))))

def ditSegF : IStmt NS P := .seq (.op (.drop DE)) (.op (.drop DL))

def ditMain (pT : Fin P) : IStmt NS P :=
  .seq difSegA (.seq difSegE (.seq (.call pT) (.seq (mvH DX U) (.seq (.call pT) (.seq ditSegF
    (.seq (mvH U V) (.seq ditSegD (.seq (mvH P2 DX) (.seq (mvH P1 DX) (.op (.drop HH)))))))))))

def ditBody (pT : Fin P) : IStmt NS P :=
  .seq difTest (.ite CC (fun c => c == .zero) (.op (.drop CC)) (.seq (.op (.drop CC)) (ditMain pT)))

def ditCost (n j : ℕ) : ℕ := 500000 * (n + 3) * (j + 1) * 2 ^ j

end NLogN

end

section
-- Source module: NLogNP.SSAlg
/-!
# Algebra of the Fermat-ring FFT: inversion and the convolution property
-/

namespace NLogN

open IntMul

section ring

variable (n : ℕ)

/-! ## The forward transform evaluates at roots of unity -/

/-- `∑_{i<m} A_i x^i`. -/
def peval (A : List ℤ) (x : (ZMod (2 ^ n + 1))) (m : ℕ) : (ZMod (2 ^ n + 1)) := ∑ i ∈ Finset.range m, (A.getD i 0 : (ZMod (2 ^ n + 1))) * x ^ i

end ring

section ring2

variable (n : ℕ)

end ring2

/-! ## Cyclic convolution and pointwise products -/

/-- Cyclic convolution of length `K`, reduced mod `F`. -/
def cycZ (F : ℤ) (K : ℕ) (A B : List ℤ) : List ℤ :=
  (List.range K).map fun m => (∑ i ∈ Finset.range K, ∑ l ∈ Finset.range K,
    if (i + l) % K = m then A.getD i 0 * B.getD l 0 else 0) % F

/-- Pointwise products, reduced mod `F`. -/
def pmulZ (F : ℤ) : List ℤ → List ℤ → List ℤ
  | a :: A, b :: B => (a * b) % F :: pmulZ F A B
  | _, _ => []

