variable (G : GapCompression) (U : UniversalMachine)

theorem MIPRE.Halting.lamOf_ge : ∃ n₀, ∀ n, n₀ ≤ n →
    (2 * n + 1) ^ (2 * n + 1) + esize (2 * n + 1) + 4 ≤ 2 ^ lamOf n ∧
    2 * n + 1 + esize (2 * n + 1) + 53 ≤ lamOf n := by sorry
