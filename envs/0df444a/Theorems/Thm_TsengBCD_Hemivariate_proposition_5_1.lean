-- title:
--   Proposition 5.1, p. 484 — under B1–B3 and C1 or C2, essentially cyclic BCD: f(x^r) ↓ −∞ or every cluster point is a coordinatewise minimum
-- statement:
--   Let $f=f_0+\sum_{k=1}^N f_k$ satisfy Assumptions B1–B3, and let $f_0$ satisfy either Assumption C1 or C2. Suppose that the sequence $\{x^r=(x^r_1,\dots,x^r_N)\}_{r=0,1,\dots}$ generated by the BCD method (2)–(3) from $x^0\in\operatorname{dom}f$ using the essentially cyclic rule is defined. Then either
--   $$\{f(x^r)\}\downarrow-\infty,$$
--   or else every cluster point $z=(z_1,\dots,z_N)$ of $\{x^r\}$ is a coordinatewise minimum point of $f$.
--
--   The proposition replaces the continuity of $f$ on a bounded level set (§4) by the separable structure (1) together with quasiconvexity and hemivariance of $f$ in each block.
--
--   **Formalization Note.** "Is defined" is the hypothesis that a BCD run $\{x^r\}$ with block choices $s$ is given. "$\{f(x^r)\}\downarrow-\infty$" is convergence to $-\infty$ in the extended reals (the sequence is nonincreasing for every run). $f_0,f_k$ never take the value $-\infty$; blocks are 0-based.
-- source:
--   Tseng, Convergence of a block coordinate descent method for nondifferentiable minimization, J. Optim. Theory Appl. 109 (2001), p. 484, Proposition 5.1

import Mathlib
import Definitions.Def_TsengBCD_Hemivariate_Setting

namespace TsengBCD.Hemivariate

open Filter Topology

theorem proposition_5_1 {N : ℕ} [NeZero N] {n : Fin N → ℕ} (f0 : TsengBCD.Stationary.X n → EReal)
    (fk : (k : Fin N) → EuclideanSpace ℝ (Fin (n k)) → EReal)
    (h0bot : ∀ x, f0 x ≠ ⊥) (hkbot : ∀ k y, fk k y ≠ ⊥)
    (hB : AssumptionB f0 fk) (hC : AssumptionC1 f0 ∨ AssumptionC2 f0)
    (s : ℕ → Fin N) (hs : TsengBCD.Stationary.IsEssCyclic s) (x : ℕ → TsengBCD.Stationary.X n) (hrun : TsengBCD.Stationary.IsBCDRun (TsengBCD.Stationary.fSum f0 fk) s x) :
    Tendsto (fun r => TsengBCD.Stationary.fSum f0 fk (x r)) atTop (𝓝 ⊥) ∨
      ∀ z, MapClusterPt z atTop x → TsengBCD.Stationary.IsCoordMin (TsengBCD.Stationary.fSum f0 fk) z := by sorry

end TsengBCD.Hemivariate
