      ((g.det : ℤ) : ZMod ℓ) = ((i.1 : (ZMod ℓ)ˣ) : ZMod ℓ) ∧ ((g.det : ℤ) : ZMod q) = ((i.2 : (ZMod q)ˣ) : ZMod q) :=
    fun i => Matrix.exists_det_map_eq_of_isUnit_of_ne ℓ q hℓq i.1 i.2
