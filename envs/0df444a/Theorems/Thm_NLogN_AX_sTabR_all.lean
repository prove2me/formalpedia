theorem NLogN.AX.sTabR_all (p s t α Bq : ℕ) (st : IState HS) (ht : 0 < t) (hR : STabRegs p s t α st)
    (H : TabHyp p s t α Bq) :
    sTabR.ok st ∧ sTabR.run st = st.upd aW (ints (sTab p s t α).flatten ++ st.G aW) ∧
      sTabR.cost st ≤ tabCost (2 * HvdH.sWidth p α + 1) t (sWCost p Bq) := by sorry
