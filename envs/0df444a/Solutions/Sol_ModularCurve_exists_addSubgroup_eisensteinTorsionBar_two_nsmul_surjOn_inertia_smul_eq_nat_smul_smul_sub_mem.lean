theorem exists_half (c : JZero p) (hc : reductionModL B p c = 0) :
    ∃ y : JZero p, 2 • y = c ∧ reductionModL B p y = 0 := by
  have h2p := not_two_dvd p h2n
  have hRI := reductionInputs p h2n B hB
  obtain ⟨y₀, hy₀⟩ := JZero.divisible p 2 two_ne_zero c
  have hsurj := surjOn_reductionModL_torsion_pow p 2 h2p B hB hRI 1
  have hmem : reductionModL B p y₀ ∈
      {w : JZeroC (IsLocalRing.ResidueField ↥B) p | (2 ^ 1) • w = 0} := by
    show (2 ^ 1) • reductionModL B p y₀ = 0
    rw [pow_one, ← map_nsmul, hy₀, hc]
  obtain ⟨z, hz2, hzred⟩ := hsurj hmem
  have hz2' : 2 • z = 0 := by
    have h : (2 ^ 1) • z = 0 := hz2
    rwa [pow_one] at h
  refine ⟨y₀ - z, ?_, ?_⟩
  · rw [nsmul_sub, hy₀, hz2', sub_zero]
  · rw [map_sub, hzred, sub_self]

