open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
theorem solution {Rh Ri Q : ℝ} (hQ : Q ^ 2 = 3 * Rh * Ri / 4) (c : ℝ) {R : ℝ} (hR : R ≠ 0) :
    Lop Rh Ri Q (fun x => c / x) R = 2 * n1 Rh Ri * c / R ^ 3 := by
  have hev : (fun s => Pc Rh Ri s * deriv (fun x => c / x) s) =ᶠ[𝓝 R]
      (fun s => -c * N0 Rh Ri s / s ^ 3) := by
    filter_upwards [eventually_ne_nhds hR] with s hs
    rw [(hasDerivAt_inv_c c hs).deriv]; unfold Pc; field_simp
  have hd := ((hasDerivAt_N0 Rh Ri R).const_mul (-c)).div (hasDerivAt_pow 3 R) (pow_ne_zero 3 hR)
  have hd' : HasDerivAt (fun s => -c * N0 Rh Ri s / s ^ 3)
      ((-c * N0d Rh Ri R * R ^ 3 - -c * N0 Rh Ri R * (↑3 * R ^ (3 - 1))) / (R ^ 3) ^ 2) R := by
    refine hd.congr_deriv ?_; ring
  unfold Lop
  rw [hev.deriv_eq, hd'.deriv]
  unfold Vc N0 N0d n1
  rw [hQ]
  field_simp
  ring
