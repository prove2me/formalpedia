theorem queryLocalSourcesBitBudget_mono_reads (M N P F exponent eM eF B S t Rp W R R' : ℕ)
    (hR : R ≤ R') :
    queryLocalSourcesBitBudget M N P F exponent eM eF B S t Rp R W ≤
