    · rintro ⟨i, j, k⟩ hc
      exact integrand_integrableOn_subbox hω hφ2 (hcell_sub (i, j, k) hc)
  have hBsum : B0_num + 2 * B1_num + B2_num ≤ 2 * D_den := by
    unfold B0_num B1_num B2_num D_den; omega
  have htotal : ∑ c ∈ idxSet, ∫ x in cell c, f x ≤
      (pieceSumWith ub pa_n pb_n N : ℝ) / ((S_scale : ℝ) * W_scale * W_scale * W_scale) := by
    have hsplit : ∑ c ∈ idxSet, ∫ x in cell c, f x =
        ∑ i ∈ Finset.range N, ∑ j ∈ Finset.range N, ∑ k ∈ Finset.range N,
          ∫ x in cell (i, j, k), f x := by
      simp only [idxSet, Finset.sum_product]
    rw [hsplit]
