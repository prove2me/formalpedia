set_option autoImplicit true
namespace FloorRecurrence
open scoped BigOperators
noncomputable def boundConstant (m : ℕ) (f : ℕ → ℝ) (C γ : ℝ) : ℝ :=
  (∑ e ∈ Finset.range m, |f e|) + |C| / (1 - γ)
end FloorRecurrence


