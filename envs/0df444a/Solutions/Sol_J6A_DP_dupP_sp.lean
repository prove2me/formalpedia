theorem dupL_succ' (k : ℕ) (G : List ℤ) : J6A.dupL (k + 1) G = G ++ J6A.dupL k G := by
  simp [J6A.dupL, List.replicate_succ]

theorem dupP_sp_sol_aux {X : Fin HS} (hXr : X ∉ rg) (hX5 : X.val < 56) (hXT : X ≠ sTmp)
    (hXC : X ≠ cRdC) (hX0 : X ≠ 0) (hX1 : X ≠ T1) (hX2 : X ≠ T2) (hX3 : X ≠ CC)
    (s : IState HS) (F : Fin HS → List ℤ) (hF : ∀ j, j ≠ 0 → j ≠ X → F j = [])
    {k pre post sr t p α d W Bb : ℕ}
    (hc : F X = J6A.PA.dL k pre post sr t p α d)
    (hL : ∀ x ∈ J6A.PA.dL k pre post sr t p α d, |x| < 2 ^ W) (hW : 8 ≤ 2 ^ W)
    (hN : 2 * (pre * (t * post)) ≤ 2 ^ W)
    (G l : List ℤ) (h0 : F 0 = G ++ l) (hG : G.length = 2 * (pre * (t * post)))
    (hB : Bnd Bb G) (hz : zsz (G.length : ℤ) ≤ Bb) :
    Sp (dupP X) (encK s F) (encK s (Function.update F 0 (J6A.dupL 32 G ++ l)))
      (cDupP W G.length Bb) := by
  have hrg : ∀ j ∈ rg, F j = [] := fun j hj => hF j (by rintro rfl; exact absurd hj (by decide))
    (by rintro rfl; exact hXr hj)
  have i1 := init_sp s F hrg
  obtain ⟨v, ⟨hv20, hvB⟩, r⟩ := Rn.rdN hXr hX5 hXT hXC hc hL hW hN
  have i2 := r s
  -- move the array to `T1`
  have f0 : RF v F 0 = G ++ l := by rw [RF_out (by decide), h0]
  have f20 : RF v F 20 = [(G.length : ℤ)] := by rw [RF_in (by decide), hv20, hG]
  have i3 := Sp.mvK (X := 0) (Y := T1) (C := CC) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s (RF v F) (.reg 20) (clean_reg (by decide)) (ok_reg f20) G l f0
    (by rw [eval_reg f20]) Bb hB trivial (bnd_reg f20 hz)
  have eT1 : RF v F T1 = [] := by rw [RF_out (by decide)]; exact hF _ (by decide) (Ne.symm hX1)
  rw [eT1, List.append_nil] at i3
  set f2 := Function.update (Function.update (RF v F) 0 l) T1 G.reverse with hf2
  have i4 := rpt_sp s f2 G (by simp [hf2]) (by simp [hf2, Function.update_apply, RF_out (show T2 ∉ rg by decide), hF T2 (by decide) (Ne.symm hX2)])
    (by simp [hf2, Function.update_apply, RF_out (show CC ∉ rg by decide), hF CC (by decide) (Ne.symm hX3)])
    (by simp [hf2, Function.update_apply, f20]) Bb hB hz 31
  set f3 := Function.update f2 0 (J6A.dupL 31 G ++ f2 0) with hf3
  have g20 : f3 20 = [(G.length : ℤ)] := by simp [hf3, hf2, Function.update_apply, f20]
  have i5 := Sp.mvK (X := T1) (Y := 0) (C := CC) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) s f3 (.reg 20) (clean_reg (by decide)) (ok_reg g20) G.reverse []
    (by simp [hf3, hf2]) (by rw [eval_reg g20]; simp) Bb (bnd_rev hB) trivial (bnd_reg g20 hz)
  have e5 : Function.update (Function.update f3 T1 []) 0 (G.reverse.reverse ++ f3 0) =
      RF v (Function.update F 0 (J6A.dupL 32 G ++ l)) := by
    funext j
    simp only [hf3, hf2, Function.update_apply, List.reverse_reverse]
    by_cases hj0 : j = 0
    · subst hj0; simp [RF_out (show (0 : Fin HS) ∉ rg by decide), dupL_succ']
    by_cases hj1 : j = T1
    · subst hj1; simp [RF_out (show T1 ∉ rg by decide), hF T1 (by decide) (Ne.symm hX1)]
    · simp [hj0, hj1, J6Seg.PJ.RF, Function.update_apply]
  rw [e5] at i5
  have i6 := fini_sp s (Function.update F 0 (J6A.dupL 32 G ++ l))
    (fun j hj => by rw [Function.update_of_ne (by rintro rfl; exact absurd hj (by decide))]; exact hrg j hj)
    v (W := W + 1) (fun j hj => zszW1 (hvB j hj))
  refine (i1.seq (i2.seq (i3.seq (i4.seq (i5.seq i6))))).mono ?_
  simp only [cDupP, Ex.size, List.length_reverse] at *; omega

