-- title:
--   Lemma 4.13, zero count: $n_1b+n_2a\le\Gamma_F+2ab+b\deg_XP+a\deg_YP$
-- statement:
--   This is the zero-counting step of the proof of Lemma 4.13 in the source (the inequalities preceding (20)).
--
--   Let $q$ be prime, $K=\overline{\mathbb F}_q$, and let $S_1,S_2\le\mathbb F_q^\times$ be subgroups of orders $n_1,n_2$. Let $F\in K[X,Y]$ be irreducible of bidegree $(a,b)$ with $a,b>0$, and let $P\in K[X,Y]$ with $F\nmid P$. Suppose that for every $\alpha\in S_1$ and $\beta\in S_2$,
--
--   $$F(\alpha,Y)\mid P(\alpha,Y),\qquad F(X,\beta)\mid P(X,\beta).$$
--
--   Let $K(\mathcal X_F)$ be the function field of the curve $F=0$, with coordinate functions $x,y$, and let $\Gamma_F$ be the weighted common-zero count (18) of $1-x^{n_1}$ and $1-y^{n_2}$. Then
--
--   $$n_1b+n_2a\ \le\ \Gamma_F+2ab+b\deg_XP+a\deg_YP .$$
--
--   In the source, the row divisibilities give $\operatorname{ord}_\nu P(x,y)\ge\operatorname{ord}_\nu(x-\alpha)$ above each $x=\alpha$ with $y$ finite, and similarly for the columns. The zero divisors of $x^{n_1}-1$ and $y^{n_2}-1$ have degrees $n_1b$ and $n_2a$. Their overlap is $\Gamma_F$, and at most $ab$ of each lies at infinity. On the other hand, by Bézout's theorem $P(x,y)\ne0$ has at most $b\deg_XP+a\deg_YP$ zeros. Combined with the upper bound on $\Gamma_F$, this inequality yields the contradiction that proves Lemma 4.13.
--
--   **Formalization Note** The function field is any field $L\supseteq K$ generated by $x,y$ in which the kernel of $X\mapsto x$, $Y\mapsto y$ is $(F)$, as in `PrivPCP.Supplement.theorem_4_12`, and $\Gamma_F$ is `PrivPCP.Supplement.gammaF`, a sum in $\mathbb N\cup\{\infty\}$.
-- source:
--   Bafna, Vyas, Private PCPs from Product Expansion, STOC 2027 submission manuscript (sha256 c2cac1e07fc4af8721f673867373fc5bd417aa65f45cf170c543568abcf1e47e), §4.4.1 pp.22-23 and proof of Lemma 4.13, pp.24-25 (PDF pp.26-27)

import Mathlib
import Definitions.Def_PrivPCP_Supplement_gammaF

namespace PrivPCP

theorem lemma_4_13_zero_count : ∀ (q : ℕ) [Fact q.Prime] (S₁ S₂ : Subgroup (ZMod q)ˣ)
    (F P : MvPolynomial (Fin 2) (AlgebraicClosure (ZMod q))),
    Irreducible F → 0 < F.degreeOf 0 → 0 < F.degreeOf 1 → ¬ F ∣ P →
    (∀ α ∈ S₁,
      MvPolynomial.aeval (![Polynomial.C (algebraMap (ZMod q) (AlgebraicClosure (ZMod q)) (α : ZMod q)),
        Polynomial.X] : Fin 2 → Polynomial (AlgebraicClosure (ZMod q))) F ∣
      MvPolynomial.aeval (![Polynomial.C (algebraMap (ZMod q) (AlgebraicClosure (ZMod q)) (α : ZMod q)),
        Polynomial.X] : Fin 2 → Polynomial (AlgebraicClosure (ZMod q))) P) →
    (∀ β ∈ S₂,
      MvPolynomial.aeval (![Polynomial.X, Polynomial.C (algebraMap (ZMod q) (AlgebraicClosure (ZMod q))
        (β : ZMod q))] : Fin 2 → Polynomial (AlgebraicClosure (ZMod q))) F ∣
      MvPolynomial.aeval (![Polynomial.X, Polynomial.C (algebraMap (ZMod q) (AlgebraicClosure (ZMod q))
        (β : ZMod q))] : Fin 2 → Polynomial (AlgebraicClosure (ZMod q))) P) →
    ∀ (L : Type) [Field L] [Algebra (AlgebraicClosure (ZMod q)) L] (x y : L),
    RingHom.ker (MvPolynomial.aeval (R := AlgebraicClosure (ZMod q)) ![x, y]).toRingHom =
      Ideal.span {F} →
    IntermediateField.adjoin (AlgebraicClosure (ZMod q)) {x, y} = ⊤ →
    ((Nat.card S₁ * F.degreeOf 1 + Nat.card S₂ * F.degreeOf 0 : ℕ) : ℕ∞) ≤
      PrivPCP.Supplement.gammaF (AlgebraicClosure (ZMod q)) L x y (Nat.card S₁) (Nat.card S₂) +
        ((2 * F.degreeOf 0 * F.degreeOf 1 + P.degreeOf 0 * F.degreeOf 1 + P.degreeOf 1 * F.degreeOf 0 : ℕ) : ℕ∞) := by
  sorry

end PrivPCP
