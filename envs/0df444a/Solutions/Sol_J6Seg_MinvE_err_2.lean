-- Source module: Solutions.J6SegToep
/-!
# Segmented inverse (S2): the recentred block and its explicit inverse

For a block of length `n` with recentring value `b` (`|b| ≤ 1/2`), `σ ≥ 1`, `θ = σ - 1`:
* `TF u k = e^{-πα²(σ(k-u)² + 2b(k-u))}` (the Toeplitz block, `= realToep`),
* `TinvF u v = Γ_u⁻¹ Γ_v⁻¹ Σ_{max(u,v) ≤ k < n} a⁺_{k-u} Γ_k a⁻_{k-v}` (its inverse, from the q-LU),
  with `Σ_k TF u k TinvF k v = δ_uv` (`TF_mul_TinvF`) and **persymmetry**
  `TinvF u v = TinvF (n-1-v) (n-1-u)` (`TinvF_persym`, report L6);
* `MF = D T D⁻¹`, `MinvF = D T⁻¹ D⁻¹` with `D = diag(e^{πα²θu²})` (report L4), `MF · MinvF = I`;
* the exact seven-stage pipeline `blkE` (scale by `D⁻¹`, `Γ⁻¹`, lower Toeplitz `a⁻`, `Γ`,
  upper Toeplitz `a⁺`, `Γ⁻¹`, `D`) equals `MinvF` applied to the input (`blkE_eq`).
* coefficient bounds: `|a^±_h| ≤ 1.0001 e^{-πα²θh}`, `Σ_h |a^±_h| ≤ 1.05`, `Γ_u ∈ (0,1]`,
  `Γ_u⁻¹ ≤ 1.0001`, `|TinvF u v| ≤ 1.1` (under `α ≥ 2`, `α²θ ≥ 2`).
-/

open Finset Matrix Real

namespace J6Seg
open J6QLU

/-! ### Real stage operators on `ℕ`-indexed vectors -/

section consts
variable (α σ b : ℝ)

end consts

/-! ### From matrices on `Fin n` to `ℕ`-indexed sums -/

section block
variable (α σ b : ℝ)

lemma TinvM_apply {n : ℕ} (u v : Fin n) : TinvM α σ b n u v = TinvF α σ b n u v := by
  rw [TinvM, GamInv, Gam, mul_diagonal, mul_apply]
  simp only [mul_diagonal, diagonal_mul, upT, lowT, TinvF, giR, gamR]
  have : ∀ k : Fin n, (qpoch (qR α σ) ↑u)⁻¹ * (if (u : ℕ) ≤ k then aplus α σ b (k - u) else 0) *
      qpoch (qR α σ) ↑k * (if (v : ℕ) ≤ k then aminus α σ b (k - v) else 0) * (qpoch (qR α σ) ↑v)⁻¹ =
      if max (u : ℕ) v ≤ k ∧ (k : ℕ) ≤ n - 1 then
        (qpoch (qR α σ) ↑u)⁻¹ * (qpoch (qR α σ) ↑v)⁻¹ *
          (aplus α σ b (k - u) * qpoch (qR α σ) ↑k * aminus α σ b (k - v))
      else 0 := by
    intro k; have := k.2
    by_cases h1 : (u : ℕ) ≤ k <;> by_cases h2 : (v : ℕ) ≤ k <;> simp [h1, h2] <;> try omega
    · rw [if_pos (by omega)]; ring
  have hs := sum_fin_ite (n := n) (fun k : ℕ => (qpoch (qR α σ) ↑u)⁻¹ * (qpoch (qR α σ) ↑v)⁻¹ *
    (aplus α σ b (k - u) * qpoch (qR α σ) k * aminus α σ b (k - v))) (max u v) (n - 1)
    (by have := u.2; omega)
  rw [sum_mul, sum_congr rfl fun k _ => this k, hs,
    ← mul_sum, show n - 1 + 1 = n by have := u.2; omega]

/-- **Persymmetry of the block inverse** (report L6): `T⁻¹_{uv} = T⁻¹_{n-1-v, n-1-u}`. -/
theorem TinvF_persym (h : 0 < α ^ 2 * σ) {n u v : ℕ} (hu : u < n) (hv : v < n) :
    TinvF α σ b n u v = TinvF α σ b n (n - 1 - v) (n - 1 - u) := by
  set T := realToep α σ b n
  set X := TinvM α σ b n
  have hTX : T * X = 1 := realToep_mul_inv α σ b h n
  have hXT : X * T = 1 := mul_eq_one_comm.1 hTX
  -- `T` is persymmetric
  have hTp : (T.transpose).submatrix Fin.rev Fin.rev = T := by
    ext i j
    simp only [submatrix_apply, transpose_apply, T, realToep, Fin.val_rev]
    congr 2
    have hi := i.2; have hj := j.2
    rw [Nat.cast_sub (by omega), Nat.cast_sub (by omega)]; push_cast; ring
  set X' := (X.transpose).submatrix Fin.rev Fin.rev
  have hTX' : T * X' = 1 := by
    rw [← hTp]
    rw [show X' = (X.transpose).submatrix (Fin.revPerm : Fin n ≃ Fin n) Fin.rev from rfl,
      show (T.transpose).submatrix Fin.rev Fin.rev =
        (T.transpose).submatrix Fin.rev (Fin.revPerm : Fin n ≃ Fin n) from rfl,
      submatrix_mul_equiv, ← transpose_mul, hXT, transpose_one]
    ext i j; simp [one_apply, Fin.rev_inj]
  have hXX : X' = X := by
    calc X' = (X * T) * X' := by rw [hXT, Matrix.one_mul]
      _ = X * (T * X') := Matrix.mul_assoc _ _ _
      _ = X := by rw [hTX', Matrix.mul_one]
  have := congrFun (congrFun hXX ⟨n - 1 - v, by omega⟩) ⟨n - 1 - u, by omega⟩
  simp only [X', submatrix_apply, transpose_apply, X] at this
  rw [TinvM_apply, TinvM_apply] at this
  have e1 : (Fin.rev ⟨n - 1 - u, by omega⟩ : Fin n) = ⟨u, hu⟩ := by
    ext; simp [Fin.val_rev]; omega
  have e2 : (Fin.rev ⟨n - 1 - v, by omega⟩ : Fin n) = ⟨v, hv⟩ := by
    ext; simp [Fin.val_rev]; omega
  rw [e1, e2] at this
  exact this

end block

/-! ### Coefficient bounds -/

section bounds
variable {α σ b : ℝ}

lemma exp_neg_two_pi_le' : exp (-(2 * π)) ≤ 1 / 26 := by
  have hpi := Real.pi_gt_d2
  have h := Real.quadratic_le_exp_of_nonneg (x := 2 * π) (by positivity)
  rw [Real.exp_neg, inv_eq_one_div, div_le_div_iff₀ (Real.exp_pos _) (by norm_num)]
  nlinarith

lemma gamR_pos (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : 0 < gamR α σ u :=
  (inv_qpoch_bound α σ hα hσ u).1

lemma gamR_le_one (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : gamR α σ u ≤ 1 := by
  unfold gamR qpoch
  apply prod_le_one
  · intro i _; have := pow_le_one₀ (qR_pos α σ).le (by linarith [qR_le α σ hα hσ] : qR α σ ≤ 1)
      (n := i + 1); linarith
  · intro i _; have := pow_nonneg (qR_pos α σ).le (i + 1); linarith

lemma giR_pos (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : 0 < giR α σ u :=
  inv_pos.2 (gamR_pos hα hσ u)

lemma giR_le (hα : 2 ≤ α) (hσ : 1 ≤ σ) (u : ℕ) : giR α σ u ≤ 1.0001 := by
  obtain ⟨h0, h1⟩ := inv_qpoch_bound α σ hα hσ u
  unfold giR; rw [inv_le_comm₀ h0 (by norm_num)]
  rw [inv_le_iff_one_le_mul₀ (by norm_num)]; linarith

lemma diR_pos (u : ℕ) : 0 < diR α σ u := exp_pos _
lemma ddR_pos (u : ℕ) : 0 < ddR α σ u := exp_pos _

lemma diR_le_one (hσ : 1 ≤ σ) (u : ℕ) : diR α σ u ≤ 1 := by
  unfold diR; apply Real.exp_le_one_iff.2
  have : 0 ≤ π * α ^ 2 * (σ - 1) * (u : ℝ) ^ 2 := by
    have := pi_pos; apply mul_nonneg (mul_nonneg (mul_nonneg this.le (sq_nonneg _)) (by linarith))
      (sq_nonneg _)
  linarith

lemma one_le_ddR (hσ : 1 ≤ σ) (u : ℕ) : 1 ≤ ddR α σ u := by
  unfold ddR; apply Real.one_le_exp_iff.2
  have := pi_pos
  exact mul_nonneg (mul_nonneg (mul_nonneg this.le (sq_nonneg _)) (by linarith)) (sq_nonneg _)

/-- Geometric series of the coefficient envelope. -/
lemma env_sum (hα : 2 ≤ α) (hx : 2 ≤ α ^ 2 * (σ - 1)) (N : ℕ) :
    ∑ h ∈ range N, 1.0001 * exp (-(π * α ^ 2 * (σ - 1) * h)) ≤ 1.05 := by
  set r := exp (-(π * α ^ 2 * (σ - 1)))
  have hr0 : 0 ≤ r := (exp_pos _).le
  have hr : r ≤ 1 / 26 := by
    refine le_trans (exp_le_exp.2 ?_) exp_neg_two_pi_le'
    have := pi_pos; nlinarith
  have e : ∀ h : ℕ, exp (-(π * α ^ 2 * (σ - 1) * h)) = r ^ h := by
    intro h; rw [← Real.exp_nat_mul]; congr 1; ring
  simp only [e]
  rw [← mul_sum]
  have hg : (∑ h ∈ range N, r ^ h) * (1 - r) ≤ 1 := by
    rw [geom_sum_mul_neg]; have := pow_nonneg hr0 N; linarith
  have hs : 0 ≤ ∑ h ∈ range N, r ^ h := sum_nonneg fun h _ => pow_nonneg hr0 h
  nlinarith

lemma aplus_abs (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hb : |b| ≤ 1 / 2) (h : ℕ) :
    |aplus α σ b h| ≤ 1.0001 * exp (-(π * α ^ 2 * (σ - 1) * h)) :=
  (a_bounds_report α σ b hα (by linarith) hb h).1

lemma aminus_abs (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hb : |b| ≤ 1 / 2) (h : ℕ) :
    |aminus α σ b h| ≤ 1.0001 * exp (-(π * α ^ 2 * (σ - 1) * h)) :=
  (a_bounds_report α σ b hα (by linarith) hb h).2

lemma env_le (hα : 2 ≤ α) (hσ : 1 ≤ σ) (h : ℕ) :
    1.0001 * exp (-(π * α ^ 2 * (σ - 1) * h)) ≤ 1.0001 := by
  have : exp (-(π * α ^ 2 * (σ - 1) * h)) ≤ 1 := by
    apply Real.exp_le_one_iff.2
    have := mul_nonneg (mul_nonneg (mul_nonneg pi_pos.le (sq_nonneg α)) (by linarith : (0:ℝ) ≤ σ - 1))
      (Nat.cast_nonneg h : (0 : ℝ) ≤ h)
    linarith
  linarith

lemma aplus_sum (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
    (N : ℕ) : ∑ h ∈ range N, |aplus α σ b h| ≤ 1.05 :=
  (sum_le_sum fun h _ => aplus_abs hα hσ hb h).trans (env_sum hα hx N)

/-- Row sums of the upper Toeplitz factor. -/
lemma up_rowsum (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
    (n u : ℕ) : ∑ k ∈ Ico u n, |aplus α σ b (k - u)| ≤ 1.05 := by
  rw [sum_Ico_eq_sum_range]
  simp only [Nat.add_sub_cancel_left]
  exact aplus_sum hα hσ hx hb _

/-- Entries of the block inverse are bounded by `1.1`. -/
lemma TinvF_abs (hα : 2 ≤ α) (hσ : 1 ≤ σ) (hx : 2 ≤ α ^ 2 * (σ - 1)) (hb : |b| ≤ 1 / 2)
    (n u v : ℕ) : |TinvF α σ b n u v| ≤ 1.1 := by
  unfold TinvF
  rw [abs_mul, abs_mul, abs_of_pos (giR_pos hα hσ u), abs_of_pos (giR_pos hα hσ v)]
  have hs : |∑ k ∈ Ico (max u v) n, aplus α σ b (k - u) * gamR α σ k * aminus α σ b (k - v)| ≤
      1.0001 * 1.05 := by
    refine (abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ k ∈ Ico (max u v) n, |aplus α σ b (k - u) * gamR α σ k * aminus α σ b (k - v)|
        ≤ ∑ k ∈ Ico u n, |aplus α σ b (k - u)| * 1.0001 := by
          refine (sum_le_sum fun k _ => ?_).trans
            (sum_le_sum_of_subset_of_nonneg (Ico_subset_Ico_left (le_max_left u v))
              fun _ _ _ => by positivity)
          rw [abs_mul, abs_mul, abs_of_pos (gamR_pos hα hσ k)]
          have h1 := gamR_le_one hα hσ k
          have h2 := (aminus_abs hα hσ hb (k - v)).trans (env_le hα hσ _)
          have h3 := abs_nonneg (aplus α σ b (k - u))
          have h4 := abs_nonneg (aminus α σ b (k - v))
          have h5 := (gamR_pos hα hσ k).le
          calc |aplus α σ b (k - u)| * gamR α σ k * |aminus α σ b (k - v)|
              ≤ |aplus α σ b (k - u)| * 1 * 1.0001 := by gcongr
            _ = _ := by ring
      _ = (∑ k ∈ Ico u n, |aplus α σ b (k - u)|) * 1.0001 := by rw [sum_mul]
      _ ≤ 1.05 * 1.0001 := mul_le_mul_of_nonneg_right (up_rowsum hα hσ hx hb n u) (by norm_num)
      _ = 1.0001 * 1.05 := by ring
  have h1 := giR_le hα hσ u
  have h2 := giR_le hα hσ v
  have h3 := giR_pos hα hσ u
  have h4 := giR_pos hα hσ v
  calc giR α σ u * giR α σ v * |∑ k ∈ Ico (max u v) n, _| ≤ 1.0001 * 1.0001 * (1.0001 * 1.05) := by
        gcongr
    _ ≤ 1.1 := by norm_num

end bounds

end J6Seg

end

