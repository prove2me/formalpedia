    (h : ib ≫ ρ'.φ ≫ uA ≫ ρ.Ab.act ⟨(((r ^ i₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩ = ρ.φ ≫ ρ.Ab.act ⟨(((r ^ j₁ : ℕ) : ℤ) : ℚ), hΛℤ _⟩)
    (w t t' : ℕ) :
    ib ≫ (pad hΛℤ ρ' (i₁ + w) t').φ ≫ uA = (pad hΛℤ ρ (j₁ + w) t).φ := by
  obtain ⟨-, -, huAact, -⟩ := id huA
