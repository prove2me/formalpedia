    [CommRing P] [Nontrivial P] (τ : L →+* P) (h0 : algebraMap 𝒪 L π = 0) :
    ∃ 𝔭 : ↥(Spec (CommRingCat.of (L ⧸ Ideal.span {algebraMap 𝒪 L π}))),
      ∀ a : L, IsUnit (τ a) → Ideal.Quotient.mk (Ideal.span {algebraMap 𝒪 L π}) a ∉ 𝔭.asIdeal := by
  classical
  obtain ⟨𝔮, h𝔮⟩ := Ideal.exists_maximal P
  have hbot : Ideal.span {algebraMap 𝒪 L π} = ⊥ := Ideal.span_singleton_eq_bot.mpr h0
