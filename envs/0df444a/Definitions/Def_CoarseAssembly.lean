noncomputable section

namespace CoarseAssembly.Analytic

open scoped ZeroAtInfty

universe u

variable {X Y Z : Type u} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]

abbrev LocallyFiniteK1 (X : Type u) [TopologicalSpace X] := OddK C₀(X, ℂ)

def pullback (f : CocompactMap X Y) : C₀(Y, ℂ) →⋆ₙₐ[ℂ] C₀(X, ℂ) where
  toNonUnitalAlgHom := ZeroAtInftyContinuousMap.compNonUnitalAlgHom f
  map_star' a := by ext x; rfl

def pushforward (f : CocompactMap X Y) : LocallyFiniteK1 X →+ LocallyFiniteK1 Y :=
  precomp (pullback f)

structure Coarsening where
  space : ℕ → Type u
  topology : ∀ n, TopologicalSpace (space n)
  inclusion : ∀ r s, r ≤ s → @CocompactMap (space r) (space s) (topology r) (topology s)
  inclusion_self : ∀ r h, inclusion r r h = @CocompactMap.id (space r) (topology r)
  inclusion_comp : ∀ r s t hrs hst,
    inclusion r t (hrs.trans hst) = (inclusion s t hst).comp (inclusion r s hrs)

attribute [instance] Coarsening.topology

namespace Coarsening

def map (C : Coarsening) (r s : ℕ) (h : r ≤ s) :
    LocallyFiniteK1 (C.space r) →+ LocallyFiniteK1 (C.space s) :=
  pushforward (C.inclusion r s h)

abbrev Homology (C : Coarsening) :=
  AddCommGroup.DirectLimit (fun r => LocallyFiniteK1 (C.space r)) (fun r s h => C.map r s h)

end Coarsening

end CoarseAssembly.Analytic

end
end

