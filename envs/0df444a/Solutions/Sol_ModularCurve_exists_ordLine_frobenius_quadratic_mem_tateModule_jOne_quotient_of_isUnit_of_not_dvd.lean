    finrank_map_reductionKernelSpan_tateModule_jOne_le_one_of_isUnit M p hpM O K hpO Λ hΛ a hau ha
      W π hπT P hP
  have hIV0 : ∀ τ ∈ (↑(P.inertiaSubgroupIn ℚ) : Set (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ)),
      ∀ w : W, r τ w - w ∈ Submodule.map π (connSpan M p K P) := by
