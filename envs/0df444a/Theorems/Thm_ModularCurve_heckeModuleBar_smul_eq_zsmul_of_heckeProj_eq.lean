open ModularCurve

theorem ModularCurve.heckeModuleBar_smul_eq_zsmul_of_heckeProj_eq (p : ℕ) [Fact p.Prime] (i : HeckeAlg) (c : ℤ) (hi : heckeProj p i = algebraMap ℤ (CuspForm.heckeAlgebra p 2 ∅) c) : ∀ x : JZero p, (letI := heckeModuleBar p; i • x) = c • x := by sorry
