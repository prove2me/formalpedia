private theorem transport_baseChange_cancel (q : ℕ) [Fact q.Prime] {T Λ : Type} [AddCommGroup T] [Module ℤ_[q] T]
    [AddCommGroup Λ] (e : T ≃ₗ[ℤ_[q]] ℤ_[q] ⊗[ℤ] Λ) (τ : Module.End ℤ_[q] T) (f : Module.End ℤ Λ)
    (he : ∀ x, e (τ x) = f.baseChange ℤ_[q] (e x)) (v : ℚ_[q] ⊗[ℤ_[q]] T) :
    ((e.baseChange ℤ_[q] ℚ_[q] _ _).trans (TensorProduct.AlgebraTensorModule.cancelBaseChange ℤ ℤ_[q] ℚ_[q] ℚ_[q] Λ))
        (τ.baseChange ℚ_[q] v) =
      f.baseChange ℚ_[q]
        (((e.baseChange ℤ_[q] ℚ_[q] _ _).trans
          (TensorProduct.AlgebraTensorModule.cancelBaseChange ℤ ℤ_[q] ℚ_[q] ℚ_[q] Λ)) v) := by
  induction v using TensorProduct.induction_on with
  | zero => rw [LinearMap.map_zero, LinearEquiv.map_zero, LinearMap.map_zero]
  | add x y hx hy => rw [LinearMap.map_add, LinearEquiv.map_add, hx, hy, LinearEquiv.map_add, LinearMap.map_add]
  | tmul a x =>
    rw [LinearMap.baseChange_tmul, LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.baseChange_tmul,
      LinearEquiv.baseChange_tmul, he, ← LinearMap.baseChange_tmul,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_baseChange_baseChange_apply q Λ f]

theorem solution
    (p q : ℕ) [Fact p.Prime] [Fact q.Prime] :
    letI := heckeModuleBar p
    ∃ Φ : RationalTateModule q (JZero p) ≃ₗ[ℚ_[q]] (ℚ_[q] ⊗[ℤ] ↥(periodLattice p)),
      ∀ (t : HeckeAlg) (v : RationalTateModule q (JZero p)),
        Φ (rationalHeckeRep q (JZero p) t v) = ((periodLatticeHeckeEnd p t).baseChange ℚ_[q]) (Φ v) := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  letI := heckeModuleBar p
  obtain ⟨e, he⟩ :=
    exists_heckeEquivariant_linearEquiv_tateModule_jZero_padicInt_tensor_periodLattice p q (heckeInputsAll p)
      (heckeOperatorsCommuteBar p) (periodLatticeHeckeStable p)
  refine ⟨(e.baseChange ℤ_[q] ℚ_[q] _ _).trans
      (TensorProduct.AlgebraTensorModule.cancelBaseChange ℤ ℤ_[q] ℚ_[q] ℚ_[q] ↥(periodLattice p)), fun t v => ?_⟩
  rw [rationalHeckeRep_apply]
  exact transport_baseChange_cancel q e (tateHeckeRep q (JZero p) t) (periodLatticeHeckeEnd p t) (he t) v

