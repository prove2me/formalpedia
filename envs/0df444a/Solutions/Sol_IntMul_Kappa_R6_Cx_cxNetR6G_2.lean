/-! ## Role decoding -/

/-! ## Phases and the role permutation -/

variable {κ : Type} [Fintype κ] [DecidableEq κ]

/-! ## The network -/

lemma countP_phases (S : Rl → List (RStep Rl 576)) (hS : ∀ r, ∀ st ∈ S r, st.isChild = false) :
    ((univ : Finset Rl).toList.flatMap S).countP RStep.isChild = 0 := by
  rw [List.countP_eq_zero]
  intro st hst
  obtain ⟨r, _, hr⟩ := List.mem_flatMap.1 hst
  simp [hS r st hr]

lemma preR_nc (r : Rl) : ∀ st ∈ preR r, st.isChild = false := by
  intro st hst; unfold preR at hst; split_ifs at hst <;> simp_all [RStep.isChild]

lemma postR_nc (r : Rl) : ∀ st ∈ postR r, st.isChild = false := by
  intro st hst; unfold postR at hst; split_ifs at hst <;> simp_all [RStep.isChild]

theorem net_widths : net.filterMap HStep.width = progWidths CH := by
  rw [net, List.filterMap_append, List.filterMap_append, List.filterMap_append, widths_map_ofR,
    widths_map_ofR, countP_phases _ preR_nc, countP_phases _ postR_nc,
    prog_widths CH g0 CH_valid.1, List.replicate_zero, List.nil_append, List.append_nil]
  have : ([HStep.perm σE] : List (HStep Rl 576)).filterMap HStep.width = [] := rfl
  rw [this, List.append_nil]

/-! ## Correctness -/

theorem net_correct : DataCorrect (W := Wn) (T := Tn) (denListH (chEx (κ := κ)) net) := by
  intro w w' x y
  have h := net_main (Pi.single (Sum.inl w', y) 1) (fun n z => by simp) w x
  have e1 : (denListH (chEx (κ := κ)) net *ᵥ Pi.single (Sum.inl w', y) 1) (Sum.inl w, x) =
      denListH (chEx (κ := κ)) net (Sum.inl w, x) (Sum.inl w', y) := by
    rw [Matrix.mulVec_single_one]; rfl
  rw [← e1, h]
  by_cases hw : w = w'
  · subst hw
    have e2 : (fun z => (Pi.single (Sum.inl w, y) (1 : ℂ) : Rl × Addr 576 κ → ℂ) (Sum.inl w, z)) =
        Pi.single y 1 := by
      funext z; by_cases hz : z = y <;> simp [Pi.single_apply, hz]
    rw [e2, Matrix.mulVec_single_one, if_pos rfl]; rfl
  · have e2 : (fun z => (Pi.single (Sum.inl w', y) (1 : ℂ) : Rl × Addr 576 κ → ℂ) (Sum.inl w, z)) = 0 := by
      funext z; simp [Pi.single_apply, hw]
    rw [e2, Matrix.mulVec_zero, if_neg hw]; rfl

