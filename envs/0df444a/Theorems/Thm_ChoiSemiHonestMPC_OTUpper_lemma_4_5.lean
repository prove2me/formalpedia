-- title:
--   Lemma 4.5 — simulating adaptive queries
-- statement:
--   In the experiment `QExp` of Section 4.2, suppose $t_j\le|N_j|$ and $|Q_j|\le t_j$ in every execution. Conditional on $(D,X)$, sample independent uniform subsets $E_j$ of the positions of pool $j$ with $|E_j|=t_j$. Then there is a simulator that receives only $D$, all first components $(a_{j,r})$, and $(E_j,(c_{j,r})_{r\in E_j})_j$, and produces a view $\mathrm{View}'$ with $(Z,\mathrm{View}')\overset d=(Z,\mathrm{View})$, for every variable $Z$ determined by $(D,X)$. The view consists of all observations up to $\tau$ and the continuation.
--
--   Differences from the source:
--   - reading: the experiment above (pools, data, uniform bijections, queries, the public point τ, conditions (i)–(ii)) → QExp with discrete distributions and a fixed number of query/observation steps before τ (a step may carry no query); reason: the experiment is the one generated by the protocols, whose variables are discrete and whose τ is a fixed public point; steps without a query allow any number of queries
--   - encoding: conditions (i) and (ii) → built into the argument types of respond and cont; reason: they state exactly which data the observations may depend on
--   - encoding: |Q_j| ≤ t_j in every execution → on the support of the experiment; reason: an execution is a point of positive probability
--   - encoding: server labels [n] = {1,…,n}; positions and tags counted from 1 → `Fin n` = {0,…,n−1}; positions and tags counted from 0; reason: relabelling by −1 changes no instance
-- source:
--   Choi 2026, STOC 2027 submission manuscript (sha256 3a47662a…), Lemma 4.5, p. 18 (PDF 20)

import Mathlib
import Definitions.Def_ChoiSemiHonestMPC_OTUpper_AdaptiveQueries

open scoped BigOperators ENNReal NNReal
open MeasureTheory ProbabilityTheory

noncomputable section

namespace ChoiSemiHonestMPC.OTUpper

/-- Lemma 4.5 (simulating adaptive queries). -/
theorem lemma_4_5 {J L Dsp A Cc Obs Cont Zt : Type} [Fintype J] [DecidableEq J] [Fintype L]
    [DecidableEq L] (E : QExp J L Dsp A Cc Obs Cont) (ρ : PMF (Dsp × E.Data))
    (Zf : Dsp × E.Data → Zt) (t : J → ℕ) (ht : ∀ j, t j ≤ (E.N j).card)
    (hQ : ∀ dx ∈ ρ.support, ∀ h ∈ (E.run dx).support, ∀ j, (h.1.2 j).card ≤ t j) :
    ∃ sim : Dsp → ((j : J) → Fin (E.N j).card → A) →
        ((j : J) → Finset (Fin (E.N j).card) × (Fin (E.N j).card → Option Cc)) →
        PMF (List Obs × Cont),
      (ρ.bind fun dx => (E.exposure t dx.2).bind fun ex =>
          (sim dx.1 (E.firstOf dx.2) ex).map fun v => (Zf dx, v)) =
        (ρ.bind fun dx => (E.run dx).map fun h => (Zf dx, (h.1.1, h.2))) := by sorry

end ChoiSemiHonestMPC.OTUpper
