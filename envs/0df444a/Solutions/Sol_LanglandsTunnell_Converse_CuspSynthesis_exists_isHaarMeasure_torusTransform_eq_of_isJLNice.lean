  · exact le_rfl

private theorem t0668 {σ : ℝ} (hσ : 0 < σ) (v : ↥S) :
    Summable fun m : ℤ => d070 σ v m := by
  have hN : (1 : ℝ) < ((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ) := Nat.one_lt_cast.2 (t0666 v.1)
  have hN0 : (0 : ℝ) ≤ ((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ) := zero_le_one.trans hN.le
  have hr0 : 0 ≤ ((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ) ^ (-σ) := Real.rpow_nonneg hN0 _
  have hr1 : ((Ideal.absNorm v.1.asIdeal : ℕ) : ℝ) ^ (-σ) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg hN (neg_lt_zero.2 hσ)
  refine Summable.of_nat_of_neg ?_ ?_
  · refine Summable.of_nonneg_of_le (fun k => t0667 σ v _) (fun k => ?_)
      (summable_geometric_of_lt_one hr0 hr1)
    unfold d070
    split_ifs
    · have hexp : -(((k : ℤ) : ℤ) : ℝ) * σ = -σ * (k : ℝ) := by
        rw [Int.cast_natCast]
        ring
      rw [hexp, Real.rpow_mul hN0, Real.rpow_natCast]
    · exact pow_nonneg hr0 k
  · refine summable_of_ne_finset_zero
      (s := Finset.range ((TateLocal.addCharLevel (StandardAddChar.psiLocal K v.1)).toNat + 1)) fun k hk => ?_
    rw [Finset.mem_range, not_lt] at hk
    unfold d070
    rw [if_neg (by omega)]

private theorem t0669 {σ : ℝ} (hσ : 0 < σ) :
    Summable fun n : ↥S → ℤ => ∏ v : ↥S, d070 σ v (n v) := by
  refine summable_of_sum_le (c := ∏ v : ↥S, ∑' m : ℤ, d070 σ v m)
    (fun n => Finset.prod_nonneg fun v _ => t0667 σ v (n v)) fun F => ?_
  calc ∑ n ∈ F, ∏ v : ↥S, d070 σ v (n v)
      ≤ ∑ n ∈ Fintype.piFinset (fun v : ↥S => F.image fun n => n v), ∏ v : ↥S, d070 σ v (n v) :=
        Finset.sum_le_sum_of_subset_of_nonneg
          (fun n hn => Fintype.mem_piFinset.2 fun v => Finset.mem_image_of_mem (fun n => n v) hn)
          fun n _ _ => Finset.prod_nonneg fun v _ => t0667 σ v (n v)
    _ = ∏ v : ↥S, ∑ m ∈ F.image (fun n => n v), d070 σ v m := (Finset.prod_univ_sum _ _).symm
