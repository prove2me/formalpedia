      (∀ nm ∈ init, nm ∈ arr) → ∀ xs : List α,
        runArr n d ops (AModel.pull (binSh n) (binSh n) (Synth.relabel init arr) d xs) =
          AModel.pull (binSh n) (binSh n) (Synth.relabel init (applyN ops arr)) d xs
