theorem whole_inputs_eq : wholeInitial=inputBoxes ⟨188456293000,188676195327⟩ ⟨753930492407,753954613110⟩ ⟨86209408199,102356835965⟩ := rfl
noncomputable def centerUpper : ℝ := (391476155955 / 1099511627776)
