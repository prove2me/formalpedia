/-- Denominator of the transfer ordinate. -/
noncomputable def mapDya (s₂ s₃ : ℚ) : ℚ :=
  s₂ * s₃ ^ 2 + 18 * s₂ * s₃ + 27 * s₂ + 1458 * s₃

/-- Numerator of the transfer ordinate. -/
noncomputable def mapNya (s₂ s₃ : ℚ) : ℚ :=
  -(5 * s₂ * s₃ ^ 2 + 117 * s₂ * s₃ + 378 * s₂ + 729 * s₃ + 19683)

/-- Numerator of the transfer abscissa. -/
noncomputable def mapNx (s₁ s₂ s₃ : ℚ) : ℚ :=
  3 * s₁ * (s₃ + 3) * (s₂ * s₃ + 18 * s₂ + 729) *
    (s₁ * s₂ + 9 * s₁ - 243 * s₂ + 729)

/-- Denominator of the transfer abscissa. -/
noncomputable def mapDx (s₁ s₂ s₃ : ℚ) : ℚ :=
  (s₁ + 243) * (s₁ * s₂ + 18 * s₁ + 729) * mapDya s₂ s₃

