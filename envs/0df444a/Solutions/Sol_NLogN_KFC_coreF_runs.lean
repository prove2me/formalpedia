        rw [encF_succ]; simp
      · have := hH j; simp only [kap] at *; nlinarith)
  have e0 : cf (T 0) sCM sDM (marks n ++ LCM) LDM = s := by
    simp only [T, Nat.sub_zero, encF_zero, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T n) sCM sDM (marks n ++ LCM) LDM = (s.upd sT LT).upd sA (encF h 0 n ++ s.G sA) := by
    simp only [T, Nat.sub_self, encF_zero, List.reverse_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

/-! ## Initialising and flushing the accumulator -/

theorem initA_runs (s : IState HS) (n : ℕ) (LCM LDM : List Item)
    (hCM : s.G sCM = marks n ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM) :
    IRuns I iprog initA s (s.upd sA (marks n ++ s.G sA)) (n * 65 + 60) := by
  let T : ℕ → IState HS := fun k => s.upd sA (marks k ++ s.G sA)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCM) (D := sDM) (by decide) n T LCM LDM
    hLCM hLDM 1 (.op (.mark sA)) (by
      intro k hk LC' LD'
      refine (IRuns.mark (I := I) (iprog := iprog) (s := cf (T k) sCM sDM LC' LD') sA).mono' ?_ le_rfl
      simp only [T]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide)); rfl)
  have e0 : cf (T 0) sCM sDM (marks n ++ LCM) LDM = s := by simp only [T]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T n) sCM sDM (marks n ++ LCM) LDM = s.upd sA (marks n ++ s.G sA) := by
    simp only [T]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu; exact hu

theorem flushA_runs (s : IState HS) (n G w : ℕ) (g : ℕ → List ℤ) (LA LCM LDM : List Item)
    (hA : s.G sA = encF g 0 n ++ LA)
    (hCM : s.G sCM = marks n ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hG : ∀ i, (g i).length ≤ G) (hb : ∀ i, Bnd w (g i)) :
    IRuns I iprog flushA s ((s.upd sA LA).upd sO ((ints (flF g 0 n)).reverse ++ s.G sO))
      (n * (G * kap w + 95) + 60) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd sA (encF g k (n - k) ++ LA)).upd sO ((ints (flF g 0 k)).reverse ++ s.G sO)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCM) (D := sDM) (by decide) n T LCM LDM
    hLCM hLDM (G * kap w + 31) fcol (by
      intro k hk LC' LD'
      obtain ⟨j, hj⟩ : ∃ j, n - k = j + 1 := ⟨n - k - 1, by omega⟩
      have hj' : n - (k + 1) = j := by omega
      have h1 := mvW_runs (I := I) (iprog := iprog) (X := sA) (Y := sO) (by decide)
        (cf (T k) sCM sDM LC' LD') (g k) (.mark :: (encF g (k + 1) j ++ LA)) w
        (by simp +decide [T, cf, hj, encF_succ]) (NI_mark _) (hb k)
      have h2 := IRuns.unmark (I := I) (iprog := iprog)
        (s := ((cf (T k) sCM sDM LC' LD').upd sA (.mark :: (encF g (k + 1) j ++ LA))).upd sO
          (ints (g k).reverse ++ (cf (T k) sCM sDM LC' LD').G sO)) (i := sA)
        (L := encF g (k + 1) j ++ LA) (by simp +decide)
      refine (h1.seq h2).mono' ?_ ?_
      · simp only [T, hj']
        ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
        rw [flF_snoc]; simp [ints_append, ints_reverse]
      · have := hG k; simp only [kap] at *; nlinarith)
  have e0 : cf (T 0) sCM sDM (marks n ++ LCM) LDM = s := by
    simp only [T, Nat.sub_zero, flF_zero, ints_nil, List.reverse_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T n) sCM sDM (marks n ++ LCM) LDM =
      (s.upd sA LA).upd sO ((ints (flF g 0 n)).reverse ++ s.G sO) := by
    simp only [T, Nat.sub_self, encF_zero, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

end KFC

end NLogN

end

section
-- Source module: Solutions.KFCFwd
/-!
# KFC: fine-cost paper Lemma 3, forward direction `[P, q, M, B] → [P, M, q, B]`

`fwdF` computes the same denotation as `KIL.fwdP` (`pull [P,q,M,B] [P,M,q,B] gS 0 xs`), but every
per-element step is an item move with `O(1)` overhead: rows/columns/records are counted with unary
counters (marks), groups in the accumulator are delimited by marks.  The cost is
`(2q+16)·kap w·V + cUL P + cUL q + cUL M + cUL B + 1000 ≤ (2q+67)·kap w·V` (see `KFCFwdMain`)
where `w` bounds the bit size of the **data** entries only and `kap w = 76 w + 200`;
`cUL n = 1000(n+1) + 300·zsz n` is the one-time linear binary-to-unary conversion
(`KFCUnary.toUL`) of the four size parameters.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN

open IntMul

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## One row: zip into the accumulator, then move the groups back -/

theorem zrow_runs (s : IState HS) (M B G w : ℕ) (g r : ℕ → List ℤ)
    (LA R0 LCM LDM LCB LDB : List Item)
    (hA : s.G sA = encF g 0 M ++ LA) (h0 : s.G sX = ints (flF r 0 M) ++ R0) (hT : NI (s.G sT))
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ i, (r i).length = B) (hgG : ∀ i, (g i).length ≤ G)
    (hbg : ∀ i, Bnd w (g i)) (hbr : ∀ i, Bnd w (r i)) :
    IRuns I iprog zrow s ((s.upd sX R0).upd sA (encF (fun i => g i ++ r i) 0 M ++ LA))
      (2 * M * ((G + B) * kap w + 156) + 120) := by
  have h1 := zipA_runs (I := I) (iprog := iprog) s M B G w g r LA R0 LCM LDM LCB LDB hA h0 hCM hDM
    hLCM hLDM hCB hDB hLCB hLDB hr hgG hbg hbr
  have h2 := backB_runs (I := I) (iprog := iprog) (((s.upd sA LA).upd sX R0).upd sT
      ((encF (fun i => g i ++ r i) 0 M).reverse ++ s.G sT)) M (G + B) w (fun i => g i ++ r i)
      (s.G sT) LCM LDM (by simp) hT (by simp +decide [hCM]) (by simp +decide [hDM]) hLCM hLDM
      (fun i => by simp only [List.length_append]; have := hgG i; have := hr i; omega)
      (fun i x hx => by
        simp only [List.mem_append] at hx
        rcases hx with hx | hx
        · exact hbg i x hx
        · exact hbr i x hx)
  refine (h1.seq h2).mono' ?_ (by nlinarith)
  ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))

/-! ## The rows of one block -/

theorem grpF_succ (rr : ℕ → ℕ → List ℤ) (k : ℕ) :
    (fun m => grpF rr k m ++ rr k m) = grpF rr (k + 1) := by
  funext m; simp [grpF, List.range_succ]

theorem grpF_zero (rr : ℕ → ℕ → List ℤ) : grpF rr 0 = fun _ => [] := by
  funext m; simp [grpF]

theorem length_grpF {rr : ℕ → ℕ → List ℤ} {B : ℕ} (hr : ∀ y m, (rr y m).length = B) (k m : ℕ) :
    (grpF rr k m).length = k * B := by
  unfold grpF; rw [KIL.length_fm_const _ _ B (fun y _ => hr y m)]; simp

theorem bnd_grpF {rr : ℕ → ℕ → List ℤ} {w : ℕ} (hb : ∀ y m, Bnd w (rr y m)) (k m : ℕ) :
    Bnd w (grpF rr k m) := by
  intro x hx; simp only [grpF, List.mem_flatMap] at hx
  obtain ⟨y, -, hy⟩ := hx; exact hb y m x hy

theorem rowsF_runs (s : IState HS) (q M B w : ℕ) (rr : ℕ → ℕ → List ℤ)
    (LA R0 LCQ LDQ LCM LDM LCB LDB : List Item)
    (hA : s.G sA = marks M ++ LA) (h0 : s.G sX = ints (flF (rowsOf rr M) 0 q) ++ R0)
    (hT : NI (s.G sT))
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ y m, (rr y m).length = B) (hb : ∀ y m, Bnd w (rr y m)) :
    IRuns I iprog rowsF s ((s.upd sX R0).upd sA (encF (grpF rr q) 0 M ++ LA))
      (q * (2 * M * ((q * B + B) * kap w + 156) + 184) + 60) := by
  let T : ℕ → IState HS := fun k =>
    (s.upd sX (ints (flF (rowsOf rr M) k (q - k)) ++ R0)).upd sA (encF (grpF rr k) 0 M ++ LA)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCQ) (D := sDQ) (by decide) q T LCQ LDQ
    hLCQ hLDQ (2 * M * ((q * B + B) * kap w + 156) + 120) zrow (by
      intro k hk LC' LD'
      obtain ⟨j, hj⟩ : ∃ j, q - k = j + 1 := ⟨q - k - 1, by omega⟩
      have hj' : q - (k + 1) = j := by omega
      have H := zrow_runs (I := I) (iprog := iprog) (cf (T k) sCQ sDQ LC' LD') M B (q * B) w
        (grpF rr k) (rr k) LA (ints (flF (rowsOf rr M) (k + 1) j) ++ R0) LCM LDM LCB LDB
        (by simp +decide [T, cf]) (by simp +decide [T, cf, hj, flF_succ, ints_append, rowsOf])
        (by simpa +decide [T, cf] using hT)
        (by simp +decide [T, cf, hCM]) (by simp +decide [T, cf, hDM]) hLCM hLDM
        (by simp +decide [T, cf, hCB]) (by simp +decide [T, cf, hDB]) hLCB hLDB (hr k)
        (fun m => by rw [length_grpF hr]; exact Nat.mul_le_mul_right _ hk.le)
        (fun m => bnd_grpF hb k m) (hb k)
      rw [grpF_succ] at H
      refine H.mono' ?_ le_rfl
      simp only [T, hj']; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide)))
  have e0 : cf (T 0) sCQ sDQ (marks q ++ LCQ) LDQ = s := by
    simp only [T, Nat.sub_zero, grpF_zero, encF_const_nil]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T q) sCQ sDQ (marks q ++ LCQ) LDQ =
      (s.upd sX R0).upd sA (encF (grpF rr q) 0 M ++ LA) := by
    simp only [T, Nat.sub_self, flF_zero, ints_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

/-! ## One block: init, rows, flush -/

theorem cBlk_ge (q M B w : ℕ) (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    M * 65 + 60 + (q * (2 * M * ((q * B + B) * kap w + 156) + 184) + 60 +
      (M * (q * B * kap w + 95) + 60)) ≤ cBlk q M B w + 1000 := by
  unfold cBlk
  have hk : 200 ≤ kap w := by simp [kap]
  have h1 : q * M ≤ q * M * B := Nat.le_mul_of_pos_right _ hB
  have e : q * (2 * M * ((q * B + B) * kap w + 156) + 184) =
      2 * (q + 1) * kap w * (q * M * B) + 312 * (q * M) + 184 * q := by ring
  have e2 : M * (q * B * kap w + 95) = kap w * (q * M * B) + 95 * M := by ring
  rw [e, e2]
  have h3 : (2 * q + 8) * kap w * (q * M * B) =
      2 * (q + 1) * kap w * (q * M * B) + kap w * (q * M * B) + 5 * (kap w * (q * M * B)) := by ring
  rw [h3]
  have h4 : 200 * (q * M * B) ≤ kap w * (q * M * B) := Nat.mul_le_mul_right _ hk
  have h5 : q ≤ q * M := Nat.le_mul_of_pos_right _ hM
  have h6 : M ≤ q * M := Nat.le_mul_of_pos_left _ hq
  omega

theorem blkF_runs (s : IState HS) (q M B w : ℕ) (rr : ℕ → ℕ → List ℤ)
    (R0 LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (rowsOf rr M) 0 q) ++ R0) (hT : NI (s.G sT))
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ y m, (rr y m).length = B) (hb : ∀ y m, Bnd w (rr y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog blkF s ((s.upd sX R0).upd sO ((ints (flF (grpF rr q) 0 M)).reverse ++ s.G sO))
      (cBlk q M B w + 1000) := by
  have h1 := initA_runs (I := I) (iprog := iprog) s M LCM LDM hCM hDM hLCM hLDM
  have h2 := rowsF_runs (I := I) (iprog := iprog) (s.upd sA (marks M ++ s.G sA)) q M B w rr
    (s.G sA) R0 LCQ LDQ LCM LDM LCB LDB (by simp) (by simp +decide [h0])
    (by simpa +decide using hT) (by simp +decide [hCQ]) (by simp +decide [hDQ]) hLCQ hLDQ
    (by simp +decide [hCM]) (by simp +decide [hDM]) hLCM hLDM (by simp +decide [hCB])
    (by simp +decide [hDB]) hLCB hLDB hr hb
  have h3 := flushA_runs (I := I) (iprog := iprog)
    (((s.upd sA (marks M ++ s.G sA)).upd sX R0).upd sA (encF (grpF rr q) 0 M ++ s.G sA)) M (q * B) w
    (grpF rr q) (s.G sA) LCM LDM (by simp) (by simp +decide [hCM]) (by simp +decide [hDM]) hLCM hLDM
    (fun m => by rw [length_grpF hr]) (fun m => bnd_grpF hb q m)
  refine (h1.seq (h2.seq h3)).mono' ?_ ?_
  · ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  · have := cBlk_ge q M B w hB hq hM; omega

/-! ## All blocks -/

theorem blkIn_eq (r : ℕ → ℕ → ℕ → List ℤ) (q M p : ℕ) :
    KIL.blkIn r q M p = flF (rowsOf (r p) M) 0 q := by
  simp only [KIL.blkIn, flF, List.range_eq_range']
  congr 1

theorem blkOut_eq (r : ℕ → ℕ → ℕ → List ℤ) (q M p : ℕ) :
    KIL.blkOut r q M p = flF (grpF (r p) q) 0 M := by
  simp only [KIL.blkOut, flF, List.range_eq_range']
  congr 1; funext m; simp [grpF, List.range_eq_range']

theorem allF_runs (s : IState HS) (P q M B w : ℕ) (r : ℕ → ℕ → ℕ → List ℤ)
    (R LCP LDP LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (KIL.blkIn r q M) 0 P) ++ R) (hT : NI (s.G sT))
    (hCP : s.G sCP = marks P ++ LCP) (hDP : s.G sDP = LDP) (hLCP : NM LCP) (hLDP : NM LDP)
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ p y m, (r p y m).length = B) (hb : ∀ p y m, Bnd w (r p y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog allF s ((s.upd sX R).upd sO
        ((ints (flF (KIL.blkOut r q M) 0 P)).reverse ++ s.G sO))
      (P * (cBlk q M B w + 1064) + 60) := by
  let T : ℕ → IState HS := fun p =>
    (s.upd sX (ints (flF (KIL.blkIn r q M) p (P - p)) ++ R)).upd sO
      ((ints (flF (KIL.blkOut r q M) 0 p)).reverse ++ s.G sO)
  have hu := uloop_runs (I := I) (iprog := iprog) (C := sCP) (D := sDP) (by decide) P T LCP LDP
    hLCP hLDP (cBlk q M B w + 1000) blkF (by
      intro k hk LC' LD'
      obtain ⟨j, hj⟩ : ∃ j, P - k = j + 1 := ⟨P - k - 1, by omega⟩
      have hj' : P - (k + 1) = j := by omega
      have H := blkF_runs (I := I) (iprog := iprog) (cf (T k) sCP sDP LC' LD') q M B w (r k)
        (ints (flF (KIL.blkIn r q M) (k + 1) j) ++ R) LCQ LDQ LCM LDM LCB LDB
        (by simp +decide [T, cf, hj, flF_succ, ints_append, blkIn_eq])
        (by simpa +decide [T, cf] using hT)
        (by simp +decide [T, cf, hCQ]) (by simp +decide [T, cf, hDQ]) hLCQ hLDQ
        (by simp +decide [T, cf, hCM]) (by simp +decide [T, cf, hDM]) hLCM hLDM
        (by simp +decide [T, cf, hCB]) (by simp +decide [T, cf, hDB]) hLCB hLDB (hr k) (hb k)
        hB hq hM
      refine H.mono' ?_ le_rfl
      simp only [T, hj']
      ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
      rw [flF_snoc]; simp [ints_append, blkOut_eq])
  have e0 : cf (T 0) sCP sDP (marks P ++ LCP) LDP = s := by
    simp only [T, Nat.sub_zero, flF_zero, ints_nil, List.reverse_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  have e1 : cf (T P) sCP sDP (marks P ++ LCP) LDP = (s.upd sX R).upd sO
        ((ints (flF (KIL.blkOut r q M) 0 P)).reverse ++ s.G sO) := by
    simp only [T, Nat.sub_self, flF_zero, ints_nil, List.nil_append]; ((apply NLogN.IState.ext' <;> intros <;> simp only [NLogN.IState.upd_G, NLogN.IState.upd_ip, NLogN.IState.upd_out, NLogN.KFC.cf] <;> split_ifs <;> simp_all +decide))
  rw [e0, e1] at hu
  exact hu.mono (by nlinarith)

end KFC

end NLogN

end

section
-- Source module: Solutions.KFCFwdMain
/-!
# KFC: the self-contained fine-cost forward field move `fwdF`

`fwdF_spec`: on `t` with `ints xs ++ R` on stack `0` and `P, q, M, B` on stacks `1 … 4`,
`fwdF` ends in `t.upd 0 (ints (pull [P,q,M,B] [P,M,q,B] gS 0 xs) ++ R)` (all scratch stacks
restored) with cost `≤ cFwdF P q M B w = (2q+16)·kap w·V + cUL P + cUL q + cUL M + cUL B + 1000`,
`V = P·q·M·B`, `w` a bound on the bit size of the entries of `xs` only.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option maxRecDepth 20000

namespace NLogN

open IntMul AModel

namespace KFC

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

/-! ## Prologue / epilogue of a unary counter pair -/

/-! ## The core: blocks, then copy the output back -/

theorem coreF_runs_sol_aux (s : IState HS) (P q M B w : ℕ) (r : ℕ → ℕ → ℕ → List ℤ)
    (R LCP LDP LCQ LDQ LCM LDM LCB LDB : List Item)
    (h0 : s.G sX = ints (flF (KIL.blkIn r q M) 0 P) ++ R)
    (hCP : s.G sCP = marks P ++ LCP) (hDP : s.G sDP = LDP) (hLCP : NM LCP) (hLDP : NM LDP)
    (hCQ : s.G sCQ = marks q ++ LCQ) (hDQ : s.G sDQ = LDQ) (hLCQ : NM LCQ) (hLDQ : NM LDQ)
    (hCM : s.G sCM = marks M ++ LCM) (hDM : s.G sDM = LDM) (hLCM : NM LCM) (hLDM : NM LDM)
    (hCB : s.G sCB = marks B ++ LCB) (hDB : s.G sDB = LDB) (hLCB : NM LCB) (hLDB : NM LDB)
    (hr : ∀ p y m, (r p y m).length = B) (hb : ∀ p y m, Bnd w (r p y m))
    (hB : 1 ≤ B) (hq : 1 ≤ q) (hM : 1 ≤ M) :
    IRuns I iprog coreF s (s.upd sX (ints (flF (KIL.blkOut r q M) 0 P) ++ R))
      (P * (cBlk q M B w + 1064) + (flF (KIL.blkOut r q M) 0 P).length * kap w + 100) := by
  have m1 := IRuns.mark (I := I) (iprog := iprog) (s := s) sO
  have m2 := IRuns.mark (I := I) (iprog := iprog) (s := s.upd sO (.mark :: s.G sO)) sT
  set t2 := (s.upd sO (.mark :: s.G sO)).upd sT (.mark :: (s.upd sO (.mark :: s.G sO)).G sT)
  have hA := allF_runs (I := I) (iprog := iprog) t2 P q M B w r R LCP LDP LCQ LDQ LCM LDM LCB LDB
    (by simp +decide [t2, h0]) (by simp +decide [t2]; exact NI_mark _)
    (by simp +decide [t2, hCP]) (by simp +decide [t2, hDP]) hLCP hLDP
    (by simp +decide [t2, hCQ]) (by simp +decide [t2, hDQ]) hLCQ hLDQ
    (by simp +decide [t2, hCM]) (by simp +decide [t2, hDM]) hLCM hLDM
    (by simp +decide [t2, hCB]) (by simp +decide [t2, hDB]) hLCB hLDB hr hb hB hq hM
  set t7 := (t2.upd sX R).upd sO ((ints (flF (KIL.blkOut r q M) 0 P)).reverse ++ t2.G sO)
  have hw := mvW_runs (I := I) (iprog := iprog) (X := sO) (Y := sX) (by decide) t7
    (flF (KIL.blkOut r q M) 0 P).reverse (.mark :: s.G sO) w
    (by simp +decide [t7, t2, ints_reverse]) (NI_mark _)
    (fun x hx => bnd_flF (f := KIL.blkOut r q M) (fun p => by
      rw [blkOut_eq]; exact bnd_flF (bnd_grpF (hb p) q) 0 M) 0 P x
      (by simpa using hx))
  set t8 := (t7.upd sO (.mark :: s.G sO)).upd sX
    (ints (flF (KIL.blkOut r q M) 0 P).reverse.reverse ++ t7.G sX)
  have u1 := IRuns.unmark (I := I) (iprog := iprog) (s := t8) (i := sO) (L := s.G sO)
    (by simp +decide [t8])
  have u2 := IRuns.unmark (I := I) (iprog := iprog) (s := t8.upd sO (s.G sO)) (i := sT)
    (L := s.G sT) (by simp +decide [t8, t7, t2])
  refine (m1.seq (m2.seq (hA.seq (hw.seq (u1.seq u2))))).mono' ?_ ?_
  · clear m1 m2 hA hw u1 u2
    simp only [t8, t7, t2, List.reverse_reverse]
    clear * -
    apply IState.ext'
    · intro x
      simp only [IState.upd_G]
      split_ifs <;> (try subst_vars) <;> simp +decide at *
    · rfl
    · rfl
  · simp only [List.length_reverse]; omega

/-! ## The program -/

end KFC

end NLogN

