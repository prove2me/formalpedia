/-!
# Scalar normalization in the original norm

We move the actual invariant set by a positive scalar and conjugate its
map. No norm instance is replaced. Minimality and absence of fixed points
are transported by the explicit inverse scalar multiplication.
-/

noncomputable section

open Set Metric TopologicalSpace
open scoped Pointwise

namespace ReflexiveFixedPoints

universe u
variable {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]

/-- The actual homothety between a set and its nonzero scalar image. -/
def scaledSubtypeEquiv (K : Set X) (c : ℝ) (hc : c ≠ 0) : K ≃ (c • K : Set X) where
  toFun x := ⟨c • (x : X), ⟨x, x.property, rfl⟩⟩
  invFun y := ⟨c⁻¹ • (y : X), by
    obtain ⟨x, hx, hxy⟩ := y.property
    rw [← hxy, inv_smul_smul₀ hc]
    exact hx⟩
  left_inv x := by ext; exact inv_smul_smul₀ hc (x : X)
  right_inv y := by ext; exact smul_inv_smul₀ hc (y : X)

@[simp] theorem scaledSubtypeEquiv_apply (K : Set X) (c : ℝ) (hc : c ≠ 0) (x : K) :
    (scaledSubtypeEquiv K c hc x : X) = c • (x : X) := rfl

@[simp] theorem scaledSubtypeEquiv_symm_apply
    (K : Set X) (c : ℝ) (hc : c ≠ 0) (y : (c • K : Set X)) :
    ((scaledSubtypeEquiv K c hc).symm y : X) = c⁻¹ • (y : X) := rfl

/-- Conjugate an actual selfmap by the scalar bijection. -/
def scaledMap (K : Set X) (T : K → K) (c : ℝ) (hc : c ≠ 0) :
    (c • K : Set X) → (c • K : Set X) :=
  fun y => scaledSubtypeEquiv K c hc (T ((scaledSubtypeEquiv K c hc).symm y))

/-- Fixed points pull back through the actual scalar change of variables. -/
theorem scaledMap_fixed_iff (K : Set X) (T : K → K) (c : ℝ) (hc : c ≠ 0)
    (y : (c • K : Set X)) :
    scaledMap K T c hc y = y ↔
      T ((scaledSubtypeEquiv K c hc).symm y) = (scaledSubtypeEquiv K c hc).symm y := by
  constructor
  · intro h
    have := congrArg (scaledSubtypeEquiv K c hc).symm h
    simpa only [scaledMap, Equiv.symm_apply_apply] using this
  · intro h
    change scaledSubtypeEquiv K c hc _ = y
    rw [h, Equiv.apply_symm_apply]

/-- Conjugation by a positive homothety preserves nonexpansiveness. -/
theorem scaledMap_nonexpansive (K : Set X) (T : K → K)
    (hT : LipschitzWith 1 T) (c : ℝ) (hc : 0 < c) :
    LipschitzWith 1 (scaledMap K T c hc.ne') := by
  apply LipschitzWith.of_dist_le_mul
  intro y z
  let e := scaledSubtypeEquiv K c hc.ne'
  have ht := hT.dist_le_mul (e.symm y) (e.symm z)
  have ht' : ‖(T (e.symm y) : X) - (T (e.symm z) : X)‖ ≤
      ‖(e.symm y : X) - (e.symm z : X)‖ := by
    simpa only [one_mul, NNReal.coe_one, Subtype.dist_eq, dist_eq_norm] using ht
  simp only [Subtype.dist_eq, dist_eq_norm]
  change ‖c • (T (e.symm y) : X) - c • (T (e.symm z) : X)‖ ≤
    (1 : ℝ) * ‖(y : X) - (z : X)‖
  calc
    ‖c • (T (e.symm y) : X) - c • (T (e.symm z) : X)‖ =
        c * ‖(T (e.symm y) : X) - (T (e.symm z) : X)‖ := by
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hc]
    _ ≤ c * ‖(e.symm y : X) - (e.symm z : X)‖ := mul_le_mul_of_nonneg_left ht' hc.le
    _ = c * (c⁻¹ * ‖(y : X) - (z : X)‖) := by
      change c * ‖c⁻¹ • (y : X) - c⁻¹ • (z : X)‖ = _
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hc)]
    _ = (1 : ℝ) * ‖(y : X) - (z : X)‖ := by rw [← mul_assoc, mul_inv_cancel₀ hc.ne']

/-- The image under a positive homothety retains minimality. -/
theorem scaledMap_minimal (K : Set X) (T : K → K)
    (hT : MinimalInvariant K T) (c : ℝ) (hc : 0 < c) :
    MinimalInvariant (c • K) (scaledMap K T c hc.ne') := by
  intro s hsK hs hclosed hconv hinv
  let A : Set X := (fun x : X => c • x) ⁻¹' s
  have hAK : A ⊆ K := by
    intro x hx
    obtain ⟨y, hy, heq⟩ := hsK hx
    have hxy : x = y := (smul_right_injective X hc.ne') heq.symm
    simpa [hxy] using hy
  have hAne : A.Nonempty := by
    obtain ⟨y, hy⟩ := hs
    obtain ⟨x, hx, hxy⟩ := hsK hy
    exact ⟨x, by change c • x ∈ s; simpa [hxy] using hy⟩
  have hAc : IsClosed A := hclosed.preimage (continuous_const.smul continuous_id)
  have hAv : Convex ℝ A := hconv.smul_preimage c
  have hAi : InvariantSubset K T A := by
    intro x hx
    let e := scaledSubtypeEquiv K c hc.ne'
    have hy : (e x : X) ∈ s := hx
    have h := hinv (e x) hy
    change c • (T x : X) ∈ s
    simpa only [e, scaledMap, Equiv.symm_apply_apply, scaledSubtypeEquiv_apply] using h
  have hAeq : A = K := hT A hAK hAne hAc hAv hAi
  apply Set.Subset.antisymm hsK
  rintro y ⟨x, hx, rfl⟩
  have hxA : x ∈ A := hAeq.symm ▸ hx
  exact hxA

namespace MinimalInvariantData

/-- A fixed-point-free invariant set cannot have zero diameter. -/
theorem diam_pos (D : MinimalInvariantData (X := X)) : 0 < Metric.diam D.K := by
  obtain ⟨x, hx⟩ := D.nonempty
  have hne := D.no_fixed ⟨x, hx⟩
  have hdist : 0 < dist (D.T ⟨x, hx⟩) (⟨x, hx⟩ : D.K) := dist_pos.mpr hne
  exact hdist.trans_le (Metric.dist_le_diam_of_mem D.bounded (D.T ⟨x, hx⟩).property hx)

/-- All structural properties survive the actual scalar homothety. -/
def scaled (D : MinimalInvariantData (X := X)) (hX : CanonicallyReflexive X)
    (c : ℝ) (hc : 0 < c) : MinimalInvariantData (X := X) where
  K := c • D.K
  nonempty := D.nonempty.image (fun x : X => c • x)
  closed := D.closed.smul_of_ne_zero hc.ne'
  bounded := D.bounded.smul₀ c
  convex := D.convex.smul c
  separable := D.separable.image (continuous_const.smul continuous_id)
  weak_compact := weaklyCompact_of_closed_bounded_convex hX
    (D.closed.smul_of_ne_zero hc.ne') (D.bounded.smul₀ c) (D.convex.smul c)
  T := scaledMap D.K D.T c hc.ne'
  nonexpansive := scaledMap_nonexpansive D.K D.T D.nonexpansive c hc
  no_fixed := fun y h => D.no_fixed _ ((scaledMap_fixed_iff D.K D.T c hc.ne' y).mp h)
  minimal := scaledMap_minimal D.K D.T D.minimal c hc

end MinimalInvariantData

end ReflexiveFixedPoints

end

