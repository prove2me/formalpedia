-- The proof checks all well-formed question/answer constructor pairs explicitly.
/-- The compact Boolean verifier is exactly the registered verifier after relabeling. -/
theorem pauliWin_equiv (P : _root_.MIPStarRE.QPBT.AdmissibleParams)
    (x y : _root_.MIPStarRE.QPBT.Palomar.PauliQuestion (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
      (_root_.MIPStarRE.QPBT.PauliScalar P))
    (a b : _root_.MIPStarRE.QPBT.Palomar.PauliAnswer (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
      (_root_.MIPStarRE.QPBT.PauliScalar P)) :
    _root_.MIPStarRE.QPBT.Palomar.pauliWin (_root_.MIPStarRE.QPBT.Palomar.PauliParams.ofAdmissibleParams P)
        (_root_.MIPStarRE.QPBT.binaryRepresentation P.model)
        (_root_.MIPStarRE.QPBT.fixedBinTrace P.model) x y a b =
      _root_.MIPStarRE.QPBT.pauliWinPredicate P (_root_.MIPStarRE.QPBT.Palomar.pauliQuestionEquiv P x)
        (_root_.MIPStarRE.QPBT.Palomar.pauliQuestionEquiv P y) (_root_.MIPStarRE.QPBT.Palomar.pauliAnswerEquivCompact P a)
        (_root_.MIPStarRE.QPBT.Palomar.pauliAnswerEquivCompact P b) := by
  rcases x with ⟨tA, xA⟩
  rcases y with ⟨tB, xB⟩
  unfold _root_.MIPStarRE.QPBT.Palomar.pauliWin _root_.MIPStarRE.QPBT.pauliWinPredicate
  simp only [_root_.MIPStarRE.QPBT.Palomar.pauliQuestionEquiv, Equiv.prodCongr_apply, Prod.map_fst, Prod.map_snd]
  rw [← _root_.MIPStarRE.QPBT.Palomar.validPauliAnswer_equiv P tA a, ← _root_.MIPStarRE.QPBT.Palomar.validPauliAnswer_equiv P tB b]
  by_cases hv : (_root_.MIPStarRE.QPBT.Palomar.validPauliAnswer tA a && _root_.MIPStarRE.QPBT.Palomar.validPauliAnswer tB b) = true
  · rw [if_pos hv, if_pos hv]
    by_cases ht : tA = tB
    · have ht' : _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv tA = _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv tB := congrArg _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv ht
      rw [if_pos ht, if_pos ht']
      apply decide_eq_decide.mpr
      constructor
      · exact fun h => congrArg (_root_.MIPStarRE.QPBT.Palomar.pauliAnswerEquivCompact P) h
      · exact fun h => (_root_.MIPStarRE.QPBT.Palomar.pauliAnswerEquivCompact P).injective h
    · have ht' : _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv tA ≠ _root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv tB :=
        fun h => ht (_root_.MIPStarRE.QPBT.Palomar.pauliTypeEquiv.injective h)
      rw [if_neg ht, if_neg ht']
      obtain ⟨hvA, hvB⟩ := Bool.and_eq_true_iff.mp hv
      rcases tA with (_ | _) | (_ | _) | (_ | _) | (_ | _) | (_ | _) | _ | i | j <;>
        rcases a with uA | fA | gA | bitsA | bitA | tripleA | outcomeA <;>
        (try exact Bool.noConfusion hvA) <;>
        rcases tB with (_ | _) | (_ | _) | (_ | _) | (_ | _) | (_ | _) | _ | i' | j' <;>
