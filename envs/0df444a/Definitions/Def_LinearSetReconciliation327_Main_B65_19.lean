    · exact (((hq.meta_update hBQ 91 0 (by norm_num)).meta_update hBQ 111 fs.length (by norm_num)).meta_update
        hBQ 100 1 (by norm_num)).meta_update hBQ 101 0 (by norm_num)
    · intro j hj; simp [rootPositionList, rootForest] at hj
    · simpa [m1, rootEmitInitializeMemory] using hm83
    · simpa [m1, rootEmitInitializeMemory] using hm85
    · simpa [m1, rootEmitInitializeMemory] using hm77
    · simpa [m1, rootEmitInitializeMemory] using hm81
    · simpa [m1, rootEmitInitializeMemory] using hm89
    · simp [m1, rootEmitInitializeMemory]
    · simp [m1, rootEmitInitializeMemory]
    · simp [m1, rootEmitInitializeMemory, rootPositionFlag, rootForest]
    · simp [m1, rootEmitInitializeMemory, rootForest]
  obtain ⟨hInitAt, hEmitAt⟩ := At.seqStmt hAt
  have hInit : Sem P E pc (pc + 82) (boundaryState pc m)
