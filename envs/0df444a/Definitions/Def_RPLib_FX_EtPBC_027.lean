-- ===== S4.Def_RP_EtPBC_A_EGeoB =====
section

/-!
# S4-EtPBC-A, M4(E), EGeoB: a splitting neighbourhood of a geometric point and its sections

* `exists_common_nbhd`: finitely many etale neighbourhoods of `t` have a common affine refinement;
* `FibPts x W := Σ j, fibre of W j over x̄`, finite (`finite_fibPts`); **`exists_split`**: an affine `T` with a point
  `t` over `x̄` and maps `τ p : T ⟶ W p.1` sending `t` to `p.2`, for all `p : FibPts x W`;
* `exists_opens_unique`, `specializes_of_unique`: shrinking `T` so that `fpt t` is its only point over `x`; then every
  point of `T` over a specialisation of `x` is a specialisation of `fpt t`;
* `prd W T` (`W ×_P T`), `prW`, `prT`, `sec τ` (the section of `prT` given by `τ : T ⟶ W`), `pair a t`;
* **`exists_eq_tau`**: if every point of `W` over `x̄` is `τ b (t)` and `fpt t ⤳ fpt t'` (`t'` over `ȳ`), every point
  `a` of `W` over `ȳ` is `τ b (t')` for some `b`.
-/

set_option autoImplicit false

open AlgebraicGeometry CategoryTheory Limits Opposite

noncomputable section

namespace RamanujanPetersson.EtPBC.GenGeo

open RamanujanPetersson.EtSheaves RamanujanPetersson.EtPBC RamanujanPetersson.EtCompact.Cech

universe u

variable {P : Scheme.{u}}

/-- **Finitely many etale neighbourhoods have a common affine refinement.** -/
theorem exists_common_nbhd (t : GeomPt P) {K : Type u} [Finite K] (j : K → Nbhd t) :
    ∃ (j' : Nbhd t) (_ : ∀ k, j' ⟶ j k), IsAffine j'.1.left := by
  classical
  have := Fintype.ofFinite K
  obtain ⟨S, hS⟩ := IsCofiltered.inf_objs_exists (Finset.univ.image j)
  have h : ∀ k, Nonempty (S ⟶ j k) := fun k => hS (Finset.mem_image_of_mem j (Finset.mem_univ k))
  obtain ⟨j', a, hj'⟩ := exists_affine_le t S
  exact ⟨j', fun k => a ≫ (h k).some, hj'⟩

section Prd

variable (W T : P.Etale)

variable {W T}

/-- **Agreement near the sections**: a point `pair a t'` on the section of `τ` has `a = τ (t')`. -/
theorem eq_of_mem_sec (y : P) (τ : T ⟶ W) (a : (geomPtAt y).point.fiber.obj W)
    (t' : (geomPtAt y).point.fiber.obj T) (hmem : fpt y (pair y a t') ∈ Set.range (sec τ).left) :
    a = (geomPtAt y).point.fiber.map τ t' := by
  have hβ : (pullback.snd W.hom T.hom ≫ τ.left) ≫ W.hom = (prd W T).hom :=
    (Category.assoc _ _ _).trans (congrArg (pullback.snd W.hom T.hom ≫ ·) (MorphismProperty.Over.w τ))
  have hu : (sec τ).left ≫ pullback.fst W.hom T.hom = (sec τ).left ≫ pullback.snd W.hom T.hom ≫ τ.left :=
    (sec_fst τ).trans (((Category.id_comp _).symm.trans (congrArg (· ≫ τ.left) (sec_snd τ).symm)).trans
      (Category.assoc _ _ _))
  obtain ⟨O, hO, hOe⟩ := exists_opens_eq (prd W T).hom W.hom (pullback.fst W.hom T.hom)
    (pullback.snd W.hom T.hom ≫ τ.left) pullback.condition hβ (sec τ).left hu
  have hmO : fpt y (pair y a t') ∈ O := hO hmem
  obtain ⟨d, hd, -⟩ := exists_lift_fib (opnι (prd W T) O) y (pair y a t') ⟨_, hmO⟩ rfl
  have e1 : fl y d ≫ O.ι = fl y (pair y a t') := congrArg (fun z => ((geomPtAt y).liftOf z).left) hd
  have e2 : fl y a = fl y d ≫ O.ι ≫ pullback.fst W.hom T.hom :=
    (pair_fst y a t').symm.trans ((congrArg (· ≫ pullback.fst W.hom T.hom) e1.symm).trans (Category.assoc _ _ _))
  have e4 : fl y (pair y a t') ≫ pullback.snd W.hom T.hom = fl y t' :=
    congrArg (fun z => ((geomPtAt y).liftOf z).left) (pair_snd y a t')
  have e3 : fl y t' = fl y d ≫ O.ι ≫ pullback.snd W.hom T.hom :=
    e4.symm.trans ((congrArg (· ≫ pullback.snd W.hom T.hom) e1.symm).trans (Category.assoc _ _ _))
  refine fiber_ext _ ?_
  change fl y a = fl y t' ≫ τ.left
  calc fl y a = fl y d ≫ O.ι ≫ pullback.fst W.hom T.hom := e2
    _ = fl y d ≫ O.ι ≫ pullback.snd W.hom T.hom ≫ τ.left := congrArg (fl y d ≫ ·) hOe
    _ = (fl y d ≫ O.ι ≫ pullback.snd W.hom T.hom) ≫ τ.left :=
      ((Category.assoc _ _ _).trans (congrArg (fl y d ≫ ·) (Category.assoc _ _ _))).symm
    _ = fl y t' ≫ τ.left := congrArg (· ≫ τ.left) e3.symm

end Prd

end RamanujanPetersson.EtPBC.GenGeo

end

