section
-- Source module: Solutions.KFWC15
/-!
# KFW C-layer 15: the entry procedure (descriptor in and out)

`p14C jG`: move `P, K, D, S, ρ, r` from the descriptor stack `36` to the registers
`21, 1, 22, 3, 23, 4`, `p` to stack `26` and `w` to register `25` (`dIn`), run `mainC jG` (the
remaining descriptor entry `Z` and stack `26` lie in the background), and move everything back
(`dOut`).  **`p14Q`**: the whole run on `encK st f`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

namespace NLogN.KFW

open IntMul KIL KFD KFB KFG KFH KFN Complex Butterfly

variable {Pp : ℕ}

/-- One move. -/
def mvI (X Y : Fin HS) : IStmt HS Pp := .op (.mv X Y)

/-- Descriptor in. -/
def dIn : IStmt HS Pp :=
  .seq (mvI 36 21) (.seq (mvI 36 1) (.seq (mvI 36 22) (.seq (mvI 36 3) (.seq (mvI 36 23)
    (.seq (mvI 36 4) (.seq (mvI 36 26) (mvI 36 25)))))))

/-- Descriptor out. -/
def dOut : IStmt HS Pp :=
  .seq (mvI 25 36) (.seq (mvI 26 36) (.seq (mvI 4 36) (.seq (mvI 23 36) (.seq (mvI 3 36)
    (.seq (mvI 22 36) (.seq (mvI 1 36) (mvI 21 36)))))))

/-- The entry procedure. -/
def p14C (jG : Fin Pp) : IStmt HS Pp := .seq dIn (.seq (mainC jG) dOut)

section Run

variable {Isym : List Sym} {tbl : Fin Pp → IStmt HS Pp}

/-- The state after `dIn`. -/
def fIn (f : Fin HS → List ℤ) (P K D S ρ r p w : ℤ) (rest : List ℤ) : Fin HS → List ℤ :=
  Function.update (Function.update (Function.update (Function.update (Function.update
    (Function.update (Function.update (Function.update (Function.update f 36 rest)
      21 [P]) 1 [K]) 22 [D]) 3 [S]) 23 [ρ]) 4 [r]) 26 [p]) 25 [w]

/-- The descriptor-register assignment. -/
def σD (P K D S ρ r w : ℕ) : Fin HS → Option ℤ :=
  σPush (fun _ => none) [(21, (P : ℤ)), (1, (K : ℤ)), (22, (D : ℤ)), (3, (S : ℤ)), (23, (ρ : ℤ)),
    (4, (r : ℤ)), (25, (w : ℤ))]

end Run

end NLogN.KFW

end

