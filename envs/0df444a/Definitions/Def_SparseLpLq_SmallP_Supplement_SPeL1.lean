-- title:
--   (3.4), (3.11)–(3.13), Algorithm 1, pp. 12–14 — smoothing functions g_μ, h_ν, F_{λ,μ,ν}, ∇f_{λ,μ,ν}, and sequences generated by SPeL1
-- statement:
--   Let $A\in\mathbb R^{m\times n}$, $b\in\mathbb R^m$, $\sigma\ge0$, $0<p<1$ and $\Phi(x)=\|x\|_p^p$.
--
--   1. **Smoothing functions** (p. 13): $g_\mu(s)=(s)_+$ if $|s|\ge\mu/2$ and $\frac{s^2}{2\mu}+\frac s2+\frac\mu8$ otherwise; $h_\nu(t)=|t|$ if $|t|\ge\nu/2$ and $\frac{t^2}\nu+\frac\nu4$ otherwise; $H_\nu(z)=\sum_{i=1}^m h_\nu(z_i)$.
--   2. **Smoothed penalty** (3.4): $f_{\lambda,\mu,\nu}(x)=\lambda g_\mu(H_\nu(Ax-b)-\sigma)$ and $F_{\lambda,\mu,\nu}(x)=\Phi(x)+f_{\lambda,\mu,\nu}(x)$, with gradient (3.11)–(3.13)
--   $$\nabla f_{\lambda,\mu,\nu}(x)=\lambda g'_\mu(H_\nu(Ax-b)-\sigma)\,A^\top\nabla H_\nu(Ax-b),\quad g'_\mu(s)=\min\{\max\{\tfrac s\mu+\tfrac12,0\},1\},\quad \nabla H_\nu(z)=(h'_\nu(z_i))_i,\ h'_\nu(t)=\min\{\max\{\tfrac2\nu t,-1\},1\}.$$
--   3. **Algorithm 1 (SPeL1).** A sequence $\{x^k\}_{k\ge0}$ is generated by SPeL1 from the input $x^{\mathrm{feas}}\in\mathrm{FEA}(A,b,\sigma,1)$, $\lambda_0,\mu_0,\nu_0,\epsilon_0>0$, $\rho>1$, $0<\theta<1$ if $x^0=x^{\mathrm{feas}}$ and for every $k$, with $\lambda_k=\rho^k\lambda_0$, $\mu_k=\theta^k\mu_0$, $\nu_k=\theta^k\nu_0$, $\epsilon_k=\theta^k\epsilon_0$:
--      - Step 1: $x^{k,0}=x^k$ if $F_{\lambda_k,\mu_k,\nu_k}(x^k)\le F_{\lambda_k,\mu_k,\nu_k}(x^{\mathrm{feas}})$, and $x^{k,0}=x^{\mathrm{feas}}$ otherwise;
--      - Step 2: some method started at $x^{k,0}$ returns points $x^{k,l_k}$ and $x^{k,l_k+1}$ with
--      $$\mathrm{dist}\big(0,\partial\Phi(x^{k,l_k+1})+\nabla f_{\lambda_k,\mu_k,\nu_k}(x^{k,l_k})\big)\le\epsilon_k,\quad \|x^{k,l_k+1}-x^{k,l_k}\|_2\le\epsilon_k,\quad F_{\lambda_k,\mu_k,\nu_k}(x^{k,l_k})\le F_{\lambda_k,\mu_k,\nu_k}(x^{k,0});$$
--      - Step 3: $x^{k+1}=x^{k,l_k}$.
--
--   **Formalization Note** The run is infinite (Theorem 3.1 concerns $\{x^k\}_{k=0}^\infty$), the inner method is arbitrary, and its outputs are existentially quantified for each $k$. The updates of Step 3 are written in closed form. Condition (3.8) is written as: some $\xi\in\partial\Phi(x^{k,l_k+1})$ satisfies $\|\xi+\nabla f_{\lambda_k,\mu_k,\nu_k}(x^{k,l_k})\|_2\le\epsilon_k$; this is equivalent because the limiting subdifferential is closed and the distance to the empty set is $+\infty$. The gradient is the paper's formula (3.11)–(3.13).
-- source:
--   Yang, Chen & Xiang, Sparse solutions of a class of constrained optimization problems, arXiv:1907.00880v5, pp. 12–13, (3.4) and the smoothing functions; p. 14, Algorithm 1 and (3.11)–(3.13)

import Mathlib
import Definitions.Def_SparseLpLq_SmallP_Setting
import Definitions.Def_NAPPAL_VPEB_limSubdiff
import Definitions.Def_SparseLpLq_SmallP_Supplement_Variational

open scoped ENNReal Matrix Topology

namespace SparseLpLq.SmallP.Supplement

open SparseLpLq.SmallP

/-! ### Smoothing functions (3.4), (3.11)–(3.13) (pp. 12–14) -/

/-- `g_μ(s) = (s)₊` if `|s| ≥ μ/2`, and `s²/(2μ) + s/2 + μ/8` otherwise. -/
noncomputable def gSm (μ s : ℝ) : ℝ :=
  if μ / 2 ≤ |s| then max s 0 else s ^ 2 / (2 * μ) + s / 2 + μ / 8

/-- `h_ν(t) = |t|` if `|t| ≥ ν/2`, and `t²/ν + ν/4` otherwise. -/
noncomputable def hSm (ν t : ℝ) : ℝ :=
  if ν / 2 ≤ |t| then |t| else t ^ 2 / ν + ν / 4

/-- `H_ν(z) = ∑ᵢ h_ν(zᵢ)`. -/
noncomputable def HSm {m : ℕ} (ν : ℝ) (z : Fin m → ℝ) : ℝ := ∑ i, hSm ν (z i)

/-- `f_{λ,μ,ν}(x) := λ g_μ(H_ν(Ax − b) − σ)`. -/
noncomputable def fSm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) (σ lam μ ν : ℝ)
    (x : Fin n → ℝ) : ℝ :=
  lam * gSm μ (HSm ν (A *ᵥ x - b) - σ)

/-- `F_{λ,μ,ν}(x) := ‖x‖_p^p + f_{λ,μ,ν}(x)` of (3.4). -/
noncomputable def FSm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) (σ p lam μ ν : ℝ)
    (x : Fin n → ℝ) : ℝ :=
  lpObj p x + fSm A b σ lam μ ν x

/-- `g′_μ(s) = min{max{s/μ + 1/2, 0}, 1}` of (3.12). -/
noncomputable def gSmDeriv (μ s : ℝ) : ℝ := min (max (s / μ + 1 / 2) 0) 1

/-- `h′_ν(t) = min{max{2t/ν, −1}, 1}` of (3.13). -/
noncomputable def hSmDeriv (ν t : ℝ) : ℝ := min (max (2 / ν * t) (-1)) 1

/-- `∇f_{λ,μ,ν}(x) = λ g′_μ(H_ν(Ax − b) − σ) Aᵀ ∇H_ν(Ax − b)` of (3.11), with
`∇H_ν(z) = (h′_ν(z₁), …, h′_ν(z_m))ᵀ`. -/
noncomputable def gradFSm {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ)
    (σ lam μ ν : ℝ) (x : Fin n → ℝ) : Fin n → ℝ :=
  (lam * gSmDeriv μ (HSm ν (A *ᵥ x - b) - σ)) • (Aᵀ *ᵥ (fun i => hSmDeriv ν ((A *ᵥ x - b) i)))

/-! ### Algorithm 1 (SPeL1), p. 14 -/

/-- `x` is a sequence generated by SPeL1 (Algorithm 1) from the input `x^feas, λ₀, μ₀, ν₀, ϵ₀, ρ, θ`:
the inputs satisfy `x^feas ∈ FEA(A,b,σ,1)`, `λ₀, μ₀, ν₀, ϵ₀ > 0`, `ρ > 1`, `0 < θ < 1`; `x⁰ = x^feas`;
and for every `k`, with `λₖ = ρᵏλ₀`, `μₖ = θᵏμ₀`, `νₖ = θᵏν₀`, `ϵₖ = θᵏϵ₀` (Step 3) and
`x^{k,0} = xᵏ` if `F_{λₖ,μₖ,νₖ}(xᵏ) ≤ F_{λₖ,μₖ,νₖ}(x^feas)`, else `x^feas` (Step 1), the inner method
(arbitrary) returns points `z = x^{k,l_k}`, `w = x^{k,l_k+1}` with
(3.8) `dist(0, ∂Φ(w) + ∇f_{λₖ,μₖ,νₖ}(z)) ≤ ϵₖ`, i.e. some `ξ ∈ ∂Φ(w)` has `‖ξ + ∇f(z)‖₂ ≤ ϵₖ`,
(3.9) `‖w − z‖₂ ≤ ϵₖ`, (3.10) `F_{λₖ,μₖ,νₖ}(z) ≤ F_{λₖ,μₖ,νₖ}(x^{k,0})`, and `x^{k+1} = z` (Step 3). -/
def IsSPeL1 {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℝ) (b : Fin m → ℝ) (σ p : ℝ)
    (xfeas : Fin n → ℝ) (lam0 μ0 ν0 ε0 ρ θ : ℝ) (x : ℕ → Fin n → ℝ) : Prop :=
  xfeas ∈ FEA A b σ 1 ∧ 0 < lam0 ∧ 0 < μ0 ∧ 0 < ν0 ∧ 0 < ε0 ∧ 1 < ρ ∧ 0 < θ ∧ θ < 1 ∧
  x 0 = xfeas ∧
  ∃ z w : ℕ → Fin n → ℝ, ∀ k : ℕ,
    let lam := ρ ^ k * lam0
    let μ := θ ^ k * μ0
    let ν := θ ^ k * ν0
    let ε := θ ^ k * ε0
    let xk0 := if FSm A b σ p lam μ ν (x k) ≤ FSm A b σ p lam μ ν xfeas then x k else xfeas
    (∃ ξ ∈ NAPPAL.VPEB.limSubdiff (PhiE p) (WithLp.toLp 2 (w k)),
        ‖ξ + (WithLp.toLp 2 (gradFSm A b σ lam μ ν (z k)) : EuclideanSpace ℝ (Fin n))‖ ≤ ε) ∧
    qNorm 2 (w k - z k) ≤ ε ∧
    FSm A b σ p lam μ ν (z k) ≤ FSm A b σ p lam μ ν xk0 ∧
    x (k + 1) = z k

end SparseLpLq.SmallP.Supplement


