theorem NLogN.KFE.cL12F_le {m W S : ℕ} (Kc Kb Kd q : ℕ) (hm : 2 ≤ m) (hW : 1 ≤ W) (hq : 2 ≤ q) {τ : ℝ}
    (hτ : 0 < τ ∧ τ < 1) (hs : (S : ℝ) / W < (m : ℝ) ^ τ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ (u : ℕ) (Pre G Suf : Shape) (Bb e Kp : ℕ), 1 ≤ u →
      (∀ a ∈ Pre, 1 ≤ a) → (∀ a ∈ G, 1 ≤ a) → (∀ a ∈ Suf, 1 ≤ a) →
      e = Nat.clog q (2 ^ u) → Kp = Nat.clog m e →
      (cL12F u e (min (W * Kp) e) Kp (e - min (W * Kp) e) (vol (qShape Pre G Suf q e))
        (vol (rowShape (vol Pre) (padRows W Kp (q ^ min (W * Kp) e))
          (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e))) m q
        (fun j => ilCostF W Kc Kb Kd S q Bb j
          (vol (rowShape (vol Pre) (padRows W Kp (q ^ min (W * Kp) e))
            (G ++ List.replicate (min (W * Kp) e) q) Suf q (e - min (W * Kp) e)))) Bb : ℝ) ≤
        K * (((vol (binShape Pre G Suf (2 ^ u)) : ℝ) + 1) * (u : ℝ) ^ τ +
          ((u : ℝ) + 1) ^ (Nat.clog m (S + 1) + 1) * ((Bb : ℝ) + 2) ^ 2) := by sorry
