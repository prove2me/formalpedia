-- title:
--   Semantic Sherali–Adams over parities (semantic SA(⊕)) refutation
-- statement:
--   Let $\varphi$ be a CNF formula over the variables $V$. The formal variables are $\tilde X_V=\{x_I,\bar x_I\}_{I\subseteq V}$, where $x_I$ stands for $\bigoplus_{i\in I}y_i$ and $\bar x_I$ for $1-x_I$. For a monomial $r=\prod_{I\in\mathcal I}x_I\prod_{J\in\mathcal J}\bar x_J$ let $A(r)$ be the affine space defined by $\{\bigoplus_{i\in I}y_i=1\}_{I\in\mathcal I}\cup\{\bigoplus_{j\in J}y_j=0\}_{J\in\mathcal J}$ (possibly empty). Let $I_S$ be the ideal generated by
--   $$S=\{r-s : A(r)=A(s)\} \tag{11}$$
--   over all monomials $r,s$. A clause monomial $p_C$ uses the singleton variables ($x_v\mapsto\bar x_{\{v\}}$, $\bar x_v\mapsto x_{\{v\}}$), and the complementarity axioms are $c_I=1-\bar x_I-x_I$ (8).
--
--   A **semantic SA(⊕) refutation** of $\varphi$ is a family of polynomials $q_p$ for $p\in\{p_C\}_{C\in\varphi}\cup\{c_I\}_{I\subseteq V}$ and a nonnegative multilinear $h_\alpha=\sum\alpha_{\mathcal I,\mathcal J}\prod_{I\in\mathcal I}x_I\prod_{J\in\mathcal J}\bar x_J$ (12) such that
--   $$\sum_p p\cdot q_p+h_\alpha\equiv-1 \pmod{I_S}. \tag{13}$$
--   Its **coefficient size** is the sum of the magnitudes of the coefficients of all $q_p$ and of $h_\alpha$.
--
--   This is the stronger proof system for which the paper proves its lower bounds; Lemma 3.4 bounds its coefficient size from below by pseudo-measures.
-- source:
--   de Rezende, Engström, Shekhovtsov, Lifting Sherali-Adams Degree to Unary Sherali-Adams over Parities Size (manuscript, sha256 cab5a032…), §3, p.9, eqs. (8), (11)–(13)

import Mathlib
import Definitions.Def_LiftSAParity_CNF
import Definitions.Def_LiftSAParity_IsAffineSpace
import Definitions.Def_LiftSAParity_IsNonnegMultilinear
import Definitions.Def_LiftSAParity_coeffNorm

namespace LiftSAParity

open MvPolynomial

/-- `A(r)` for a monomial `r = ∏_{I∈𝓘} x_I · ∏_{J∈𝓙} x̄_J` of `ℝ[X̃_N]` (de
Rezende–Engström–Shekhovtsov, *Lifting Sherali-Adams Degree to Unary Sherali-Adams over Parities
Size*, manuscript (sha256 cab5a032…), §3, p.9): "the affine subspace given by the system
{⊕_{i∈I} x_i = 1}_{I∈𝓘} ∪ {⊕_{j∈J} x_j = 0}_{J∈𝓙}". The variable `X (I, true)` is `x_I` and
`X (I, false)` is `x̄_I`; a monomial is its exponent `m : Finset V × Bool →₀ ℕ`, and repeated
variables impose the same equation ("we allow duplicate sets"). The set may be empty. -/
def monoSpace {V : Type*} (m : Finset V × Bool →₀ ℕ) : Set (V → ZMod 2) :=
  {y | ∀ p ∈ m.support, parity p.1 y = ofBool p.2}

/-- The ideal `I_{S_N}` generated by `S_N = {r − s | A(r) = A(s)}` (§3, p.9, eq. (11)), where `r`
and `s` range over all monomials (with coefficient `1`). -/
noncomputable def semIdeal (V : Type*) : Ideal (MvPolynomial (Finset V × Bool) ℝ) :=
  Ideal.span {f | ∃ m m' : Finset V × Bool →₀ ℕ, monoSpace m = monoSpace m' ∧
    f = monomial m 1 - monomial m' 1}

/-- The clause monomial `p_C` in `ℝ[X̃_N]` (§3, p.8): a positive literal `x_v` contributes
`x̄_{{v}}` and a negative literal `x̄_v` contributes `x_{{v}}`, so `A(p_C) = A_C`. -/
noncomputable def xorClauseMono {V : Type*} (C : Clause V) : MvPolynomial (Finset V × Bool) ℝ :=
  ∏ l ∈ C, X ({l.1}, !l.2)

/-- The complementarity axiom `c_I = 1 − x̄_I − x_I` of `C_N` (§3, p.9, eq. (8)). -/
noncomputable def xorCompAxiom {V : Type*} (I : Finset V) : MvPolynomial (Finset V × Bool) ℝ :=
  1 - X (I, false) - X (I, true)

/-- **Semantic SA(⊕) refutation** (§3, p.9): "A semantic SA(⊕) refutation π of P is a set of
polynomials {q_p}_{p∈P∪C_n} and a polynomial h_α of the form ∑_{𝓘,𝓙} α_{𝓘,𝓙} · ∏_{I∈𝓘} x_I ·
∏_{J∈𝓙} x̄_J, (12) where α_{𝓘,𝓙} ≥ 0 for any 𝓘 and 𝓙, such that
∑_{p∈P∪C_n} p · q_p + h_α ≡ −1 mod I_{S_n}. (13)" Here `P = {p_C : C ∈ φ}` and the variables of
`φ` are `V` (so `X̃_N = {x_I, x̄_I}_{I ⊆ V}`).

**Formalization Note** Multipliers are indexed by the names of the axioms (a clause of `φ`, a set
`I ⊆ V` for `c_I`); distinct names give distinct polynomials, so this is the paper's indexing. The
form (12) is `IsNonnegMultilinear h` (𝓘, 𝓙 are sets, so each variable occurs at most once). -/
structure SemSAXorRefutation {V : Type*} [Fintype V] [DecidableEq V] (φ : CNF V) where
  /-- the multiplier `q_{p_C}` of each clause `C` of `φ` -/
  qClause : φ → MvPolynomial (Finset V × Bool) ℝ
  /-- the multiplier `q_{c_I}` of each complementarity axiom -/
  qComp : Finset V → MvPolynomial (Finset V × Bool) ℝ
  /-- the nonnegative part `h_α` -/
  h : MvPolynomial (Finset V × Bool) ℝ
  h_form : IsNonnegMultilinear h
  congr : (∑ C : φ, xorClauseMono C.1 * qClause C) + (∑ I : Finset V, xorCompAxiom I * qComp I) +
      h + 1 ∈ semIdeal V

/-- The **coefficient size** of a semantic SA(⊕) refutation (§3, p.9): "the sum of the magnitudes
of the coefficients of the monomials in each of the polynomials {q_p}_{p∈P∪C_n} and h_α". -/
noncomputable def SemSAXorRefutation.coeffSize {V : Type*} [Fintype V] [DecidableEq V]
    {φ : CNF V} (π : SemSAXorRefutation φ) : ℝ :=
  (∑ C : φ, coeffNorm (π.qClause C)) + (∑ I : Finset V, coeffNorm (π.qComp I)) + coeffNorm π.h

end LiftSAParity


