-- name    : NonconvexSplitting_Shared_IsProxADMMSeq
-- status  : Definition
-- author  : @mikedeng1
-- created : 2026-09-28T12:57:31.502257+00:00
-- url     : https://prove2.me/theorems/c04d8083-9fdc-4f20-8991-c8ff092886ad
-- title:
--   Augmented Lagrangian, Bregman distance, and sequences of the proximal ADMM
-- statement:
--   Let $h : \mathbb{R}^n \to \mathbb{R}$, $P : \mathbb{R}^m \to (-\infty, +\infty]$, $\phi : \mathbb{R}^n \to \mathbb{R}$ differentiable, $\mathcal M : \mathbb{R}^n \to \mathbb{R}^m$ linear, and $\beta \in \mathbb{R}$.
--
--   The **augmented Lagrangian** is
--   $$
--   L_\beta(x, y, z) := h(x) + P(y) - \langle z, \mathcal M x - y\rangle + \frac{\beta}{2}\|\mathcal M x - y\|^2 \in (-\infty, +\infty],
--   $$
--   and the **Bregman distance** of $\phi$ is $D_\phi(x_1, x_2) := \phi(x_1) - \phi(x_2) - \langle \nabla\phi(x_2), x_1 - x_2\rangle$.
--
--   A sequence $(x^t, y^t, z^t)_{t \ge 0}$ is **generated by the proximal ADMM** if for every $t \ge 0$
--   $$
--   \begin{cases}
--   y^{t+1} \in \operatorname{Arg\,min}_y L_\beta(x^t, y, z^t),\\
--   x^{t+1} \in \operatorname{Arg\,min}_x \{L_\beta(x, y^{t+1}, z^t) + D_\phi(x, x^t)\},\\
--   z^{t+1} = z^t - \beta(\mathcal M x^{t+1} - y^{t+1}).
--   \end{cases}
--   $$
--   The initial points $x^0, z^0$ are arbitrary, and $y^0$ is not an input of the method and is unconstrained.
--
--   **Formalization Note** "Arg min" means global minimizer (not necessarily unique), compared in `EReal`. The three updates are one relation on the sequences; nothing asserts that minimizers exist.
--
--   **Shared definition.** Serves chunks `01-admm-stationary` (p. 5, the augmented Lagrangian and the Proximal ADMM box, Eq. (7); p. 4, Bregman distance; previously `NonconvexSplitting.ProxADMM.IsProxADMMSeq`), `02-admm-bounded` (p. 5, the augmented Lagrangian and the Proximal ADMM box, Eq. (7); p. 4, Bregman distance; previously `NonconvexSplitting.ADMMBounded.IsProxADMMSeq`) and `03-admm-kl-convergence` (p. 5, the augmented Lagrangian and the Proximal ADMM box, (7); p. 4 (Bregman distance); previously `NonconvexSplitting.ADMMKL.IsProxADMMSeq`). Every copy had the same Lean body, identical up to the namespace, and the same conventions; it is reviewed once here for all of them.
-- source:
--   Li & Pong, Global Convergence of Splitting Methods for Nonconvex Composite Optimization, arXiv:1407.0753v6, p. 5, the augmented Lagrangian and the Proximal ADMM box, Eq. (7); p. 4, Bregman distance; shared by chunks 01-admm-stationary, 02-admm-bounded, 03-admm-kl-convergence

import Mathlib

open scoped InnerProductSpace

namespace NonconvexSplitting.Shared

/-- The augmented Lagrangian of Li–Pong (p. 5):
`L_β(x, y, z) = h(x) + P(y) - ⟪z, M x - y⟫ + (β/2) ‖M x - y‖²`, with values in `(-∞, +∞]`. -/
noncomputable def augLag {n m : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ)
    (P : EuclideanSpace ℝ (Fin m) → EReal)
    (M : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)) (β : ℝ)
    (x : EuclideanSpace ℝ (Fin n)) (y z : EuclideanSpace ℝ (Fin m)) : EReal :=
  ((h x : ℝ) : EReal) + P y + ((-⟪z, M x - y⟫_ℝ + β / 2 * ‖M x - y‖ ^ 2 : ℝ) : EReal)

/-- The Bregman distance of Li–Pong (p. 4):
`D_φ(x₁, x₂) = φ(x₁) - φ(x₂) - ⟪∇φ(x₂), x₁ - x₂⟫`. -/
noncomputable def bregman {n : ℕ} (phi : EuclideanSpace ℝ (Fin n) → ℝ)
    (x₁ x₂ : EuclideanSpace ℝ (Fin n)) : ℝ :=
  phi x₁ - phi x₂ - ⟪gradient phi x₂, x₁ - x₂⟫_ℝ

/-- `(x, y, z)` is a sequence generated by the proximal ADMM (7) of Li–Pong (p. 5) with
penalty `β` and proximal function `phi`: for every `t`,
`y (t+1)` minimizes `L_β(x t, ·, z t)`, `x (t+1)` minimizes
`L_β(·, y (t+1), z t) + D_φ(·, x t)`, and `z (t+1) = z t - β (M x (t+1) - y (t+1))`.
The inputs `x 0`, `z 0` are free and `y 0` is not constrained. -/
def IsProxADMMSeq {n m : ℕ} (h : EuclideanSpace ℝ (Fin n) → ℝ)
    (P : EuclideanSpace ℝ (Fin m) → EReal) (phi : EuclideanSpace ℝ (Fin n) → ℝ)
    (M : EuclideanSpace ℝ (Fin n) →L[ℝ] EuclideanSpace ℝ (Fin m)) (β : ℝ)
    (x : ℕ → EuclideanSpace ℝ (Fin n)) (y z : ℕ → EuclideanSpace ℝ (Fin m)) : Prop :=
  ∀ t : ℕ,
    (∀ w, augLag h P M β (x t) (y (t + 1)) (z t) ≤ augLag h P M β (x t) w (z t)) ∧
    (∀ w, augLag h P M β (x (t + 1)) (y (t + 1)) (z t) +
          ((bregman phi (x (t + 1)) (x t) : ℝ) : EReal) ≤
        augLag h P M β w (y (t + 1)) (z t) + ((bregman phi w (x t) : ℝ) : EReal)) ∧
    z (t + 1) = z t - β • (M (x (t + 1)) - y (t + 1))

end NonconvexSplitting.Shared


