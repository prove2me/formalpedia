theorem NLogN.twoAtanP_cost (x₁ x₂ : ℕ) (σ c₁ c₂ : ℤ) (hx₁ : 0 < x₁) (hx₂ : 0 < x₂) (hσ : |σ| = 1)
    (hc₁ : |c₁| ≤ 16) (hc₂ : |c₂| ≤ 16) (n : ℕ)
    (s : IState HS) (L3 : List Item) (h3 : s.G 3 = .int n :: L3) :
    (twoAtanP x₁ x₂ σ c₁ c₂).cost s ≤
      10 ^ 11 * (2 * n + 11) * (atanB x₁ (2 * n + 9) (2 * n + 9) +
        atanB x₂ (2 * n + 9) (2 * n + 9) + 6) ^ 2 := by sorry
