                        rw [mul_comm, Complex.mul_conj]]
                  _ = (c₀ * conj c₁) * c₁ := by ring
                  _ = ((c₀ * conj c₁).re : ℂ) * c₁ := by rw [← hc₀]
              push_cast
              field_simp
              linear_combination hkey
            obtain ⟨w₀, hw₀⟩ := hw
            have hform : ∀ u : ℝ, c₀ + u * c₁ = ((w₀ + u : ℝ) : ℂ) * c₁ := by
              intro u
              rw [hw₀]
              push_cast
              ring
            have hnz : ∀ u ∈ s, w₀ + u ≠ 0 := by
              intro u hu h0
              have := hne u hu
              rw [hform u, h0] at this
              simp at this

            have hsign : 0 < (w₀ + t) * (w₀ + t₀) := by
              rcases lt_or_gt_of_ne (hnz t ht) with hneg | hpos
              · rcases lt_or_gt_of_ne (hnz t₀ ht₀) with hneg₀ | hpos₀
                · exact mul_pos_of_neg_of_neg hneg hneg₀
                · exfalso
                  have hmem : -w₀ ∈ s := by
                    have h1 : t ≤ -w₀ := by linarith
                    have h2 : -w₀ ≤ t₀ := by linarith
                    exact hconv.ordConnected.out ht ht₀ ⟨h1, h2⟩
                  exact hnz _ hmem (by ring)
              · rcases lt_or_gt_of_ne (hnz t₀ ht₀) with hneg₀ | hpos₀
                · exfalso
                  have hmem : -w₀ ∈ s := by
                    have h1 : t₀ ≤ -w₀ := by linarith
                    have h2 : -w₀ ≤ t := by linarith
                    exact hconv.ordConnected.out ht₀ ht ⟨h1, h2⟩
                  exact hnz _ hmem (by ring)
                · exact mul_pos hpos hpos₀

            have hρ : c₀ + t * c₁
                = (((w₀ + t) / (w₀ + t₀) : ℝ) : ℂ) * (c₀ + t₀ * c₁) := by
              rw [hform t, hform t₀]
