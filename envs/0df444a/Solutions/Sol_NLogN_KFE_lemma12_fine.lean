section triples
variable {h : ℕ}

lemma sum_ind (S : Finset (Fin h)) : ∑ i, ind K S i = S.card := by
  simp [ind]

lemma bf_ind (S T : Finset (Fin h)) :
    bf (bitGram K h) (ind K S) (ind K T) = (S ∩ T).card - (S.card : K) * T.card / 9 := by
  rw [bf_bitGram, ind_dotProduct_ind, sum_ind, sum_ind]; ring

variable [CharZero K]

/-- For triples: `⟨t_S, t_T⟩ = |S ∩ T| − 1`. -/
theorem bf_triple (S T : Finset (Fin h)) (hS : S.card = 3) (hT : T.card = 3) :
    bf (bitGram K h) (ind K S) (ind K T) = (S ∩ T).card - 1 := by
  rw [bf_ind, hS, hT]; norm_num

theorem bf_triple_self (T : Finset (Fin h)) (hT : T.card = 3) :
    bf (bitGram K h) (ind K T) (ind K T) = 2 := by
  rw [bf_triple T T hT hT, Finset.inter_self, hT]; norm_num

/-- Neighbouring triples (`|S ∩ T| = 1`) are orthogonal. -/
theorem bf_triple_neighbors (S T : Finset (Fin h)) (hS : S.card = 3) (hT : T.card = 3)
    (hST : (S ∩ T).card = 1) : bf (bitGram K h) (ind K S) (ind K T) = 0 := by
  rw [bf_triple S T hS hT, hST]; norm_num

end triples

