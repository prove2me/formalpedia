variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {k : ℕ} (X : Idx k → Ω → ℝ)

lemma mS_mono {S T : Set (Idx k)} (h : S ⊆ T) : mS X S ≤ mS X T :=
  biSup_mono fun j hj => h hj

lemma meas_mS {S : Set (Idx k)} {j : Idx k} (hj : j ∈ S) : Measurable[mS X S] (X j) :=
  Measurable.of_comap_le (le_iSup₂ (f := fun j (_ : j ∈ S) =>
    MeasurableSpace.comap (X j) (inferInstance : MeasurableSpace ℝ)) j hj)

lemma mS_le (hm : ∀ j, Measurable (X j)) (S : Set (Idx k)) : mS X S ≤ mΩ :=
  iSup₂_le fun j _ => (hm j).comap_le

lemma hitSet_meas (t : ℕ) : MeasurableSet[mS X (Bt k t)] (hitSet X t) := by
  have : hitSet X t = ⋃ i, X (.branch t i) ⁻¹' {1} := by
    ext ω; simp [hitSet, hitAt]
  rw [this]
  exact MeasurableSet.iUnion fun i => meas_mS X (S := Bt k t) (j := .branch t i) ⟨i, rfl⟩ (measurableSet_singleton 1)

lemma hI_meas (t : ℕ) : Measurable[mS X (Bt k t)] (hI X t) :=
  measurable_const.indicator (hitSet_meas X t)

variable {X} {P : Measure Ω} [IsProbabilityMeasure P] {α β p : ℝ}

lemma indepFun_of (hX : IsSpecModel P k α β p X) {S T : Set (Idx k)} (hST : Disjoint S T)
    {f g : Ω → ℝ} (hf : Measurable[mS X S] f) (hg : Measurable[mS X T] g) : IndepFun f g P := by
  have hi := (iIndepFun_iff_iIndep (fun _ => (inferInstance : MeasurableSpace ℝ)) X P).1 hX.indep
  have h := indep_iSup_of_disjoint (fun j => (hX.meas j).comap_le) hi hST
  rw [IndepFun_iff_Indep]
  exact indep_of_indep_of_le_left (indep_of_indep_of_le_right h hg.comap_le) hf.comap_le

lemma prodInt (hX : IsSpecModel P k α β p X) {S T : Set (Idx k)} (hST : Disjoint S T)
    {f g : Ω → ℝ} (hf : Measurable[mS X S] f) (hg : Measurable[mS X T] g)
    (hfi : Integrable f P) (hgi : Integrable g P) :
    Integrable (fun ω => f ω * g ω) P ∧ ∫ ω, f ω * g ω ∂P = (∫ ω, f ω ∂P) * ∫ ω, g ω ∂P := by
  have hind := indepFun_of hX hST hf hg
  exact ⟨hind.integrable_mul hfi hgi, hind.integral_mul_eq_mul_integral hfi.1 hgi.1⟩
