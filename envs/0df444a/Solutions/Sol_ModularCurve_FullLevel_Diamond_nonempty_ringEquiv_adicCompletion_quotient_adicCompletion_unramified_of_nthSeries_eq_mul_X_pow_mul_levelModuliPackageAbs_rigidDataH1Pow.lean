    intro c hc
    have h1 : ((Ideal.Quotient.mk 𝔭z c) ⊗ₜ[V] (1 : A) : ((Pz.B₀ ⧸ 𝔭z) ⊗[V] A)) = σS (Ideal.Quotient.mk JA (algebraMap Pz.B₀ PA.B₀ c)) := by
