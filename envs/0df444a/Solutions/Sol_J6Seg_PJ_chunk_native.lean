  obtain ⟨n₅, hBud⟩ := budget_ev P hP (K * Cs ^ e) (7 * e)
  refine ⟨max (max n₁ n₂) (max n₃ (max n₄ n₅)), fun n hn src hs D hD k hk A' => ?_⟩
  have an := hAx n (by omega) src hs D hD k hk
