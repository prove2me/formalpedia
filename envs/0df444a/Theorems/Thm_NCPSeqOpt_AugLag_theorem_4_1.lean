-- title:
--   Theorem 4.1, p. 9 — feasible limit points of the Augmented Lagrangian method satisfy AGP
-- statement:
--   Consider (NCP) with $f$, $G$ continuously differentiable and $\mathcal K$ a nonempty closed convex cone. Let $\{x^k\}_{k\in\mathbb N}$ be a sequence generated by Algorithm 1, the augmented Lagrangian method, and let $\bar x$ be a limit point of $\{x^k\}$ that is feasible, $G(\bar x)\in\mathcal K$. Then
--   $$\bar x \text{ satisfies AGP (Definition 3.2).}$$
--
--   No constraint qualification is assumed: the theorem says the augmented Lagrangian method always produces solution candidates satisfying this sequential optimality condition.
--
--   **Formalization Note** "Limit point" is a cluster point (`MapClusterPt`) of the sequence $\{x^k\}$; the AGP sequences may be taken along a subsequence.
-- source:
--   Andreani, Gómez, Haeser, Mito & Ramos, On Optimality Conditions for Nonlinear Conic Programming, author's manuscript (revised 2021-04-20; Math. Oper. Res. doi:10.1287/moor.2021.1203), Theorem 4.1, p. 9

import Mathlib
import Definitions.Def_MoreauProx_Decomposition_Cones
import Definitions.Def_NCPSeqOpt_AugLag_Setting

namespace NCPSeqOpt.AugLag

open MoreauProx.Decomposition
open scoped InnerProductSpace
open Filter Topology

theorem theorem_4_1 {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    [FiniteDimensional ℝ E] {n : ℕ}
    (f : EuclideanSpace ℝ (Fin n) → ℝ) (hf : ContDiff ℝ 1 f)
    (G : EuclideanSpace ℝ (Fin n) → E) (hG : ContDiff ℝ 1 G)
    (K : Set E) (hK : IsClosedConvexCone K)
    (ε : ℕ → ℝ) (B : Set E) (τ σ ρ₀ : ℝ) (x : ℕ → EuclideanSpace ℝ (Fin n))
    (Λhat : ℕ → E) (ρ : ℕ → ℝ) (hrun : IsALRun f G K ε B τ σ ρ₀ x Λhat ρ)
    (xbar : EuclideanSpace ℝ (Fin n)) (hfeas : G xbar ∈ K) (hlim : MapClusterPt xbar atTop x) :
    IsAGP f G K xbar := by sorry

end NCPSeqOpt.AugLag
