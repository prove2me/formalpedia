variable {k : Type} [CommRing k] {d : ℕ}

theorem GlobalTheory.AdditiveSeries.pderiv_pt {n : ℕ} (a b : Fin n) (i l : Fin d) :
    pderiv k (a, i) (pt k d b l) = if b = a ∧ l = i then 1 else 0 := by sorry
