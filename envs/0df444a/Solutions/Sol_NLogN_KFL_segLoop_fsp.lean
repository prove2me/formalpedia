section
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
open NLogN
open NLogN.KFL
open IntMul RS KIL KFD
theorem solution {K : ℕ} (hK : 1 ≤ K) {T : NLogN.Ex NLogN.HS} {tf : ℤ → ℤ → ℤ} {Bb : ℕ}
    (hT : NLogN.KFL.SegT T tf Bb) (s : NLogN.IState NLogN.HS) (F : Fin NLogN.HS → List ℤ) (hF : F NLogN.KFL.rC = [])
    (a u v w : ℤ) (hu : 0 ≤ u) (hv : 0 ≤ v) (hw : 0 < w)
    (n : ℕ) (hub : NLogN.zsz u ≤ Bb) (hvb : NLogN.zsz v ≤ Bb) (hKb : NLogN.zsz ((2 : ℤ) ^ K) ≤ Bb)
    (hnb : NLogN.zsz (n : ℤ) ≤ Bb) (hbig : |a| + 2 * w * 2 ^ (n * K) < 2 ^ Bb) :
    NLogN.KFD.FSp (NLogN.KFL.segLoop K n T) (NLogN.KIL.encK s (NLogN.KFL.segF F K tf a u v w 0)) (NLogN.KIL.encK s (NLogN.KFL.segF F K tf a u v w n))
      (NLogN.KFD.cLp n (NLogN.KFL.cSegIt T Bb) Bb) := by
  refine NLogN.KFD.FSp.repLit (F := fun k => NLogN.KFL.segF F K tf a u v w k) (by decide)
    (fun k => NLogN.KFL.segF_rC hF K tf a u v w k) ?_ hnb ?_
  · simp +decide [NLogN.KFL.segBody, NLogN.RS.writes]
  · intro k hk
    exact NLogN.KFD.FSp.of_norep (by simp [NLogN.KFL.segBody, NLogN.KFD.norep])
      (NLogN.KFL.segBody_sp hK hT s F a u v w hu hv hw n hub hvb hKb hbig k hk _)
end
