/-! ### Part 1: Fast Segment-Tree & Pure-`Nat` Buchstab Envelope (`K = 256`) -/

inductive SegTree where
  | L (v : Nat)
  | N (m : Nat) (l r : SegTree)

def SegTree.top : SegTree → Nat
  | .L v => v
  | .N m _ _ => m

def SegTree.isValid : Nat → SegTree → Bool
  | 0, .L _ => true
  | d + 1, .N m l r =>
      l.isValid d && r.isValid d && Nat.ble l.top m && Nat.ble r.top m
  | _, _ => false

def SegTree.get : Nat → SegTree → Nat → Nat
  | 0, .L v, _ => v
  | d + 1, .N _ l r, k =>
      let half := 2 ^ d
      if k < half then l.get d k else r.get d (k - half)
  | _, _, _ => 0

def SegTree.getAux : SegTree → Nat → Nat → Nat
  | .L v, _, _ => v
  | .N _ l r, half, k =>
      match Nat.ble half k with
      | false => l.getAux (half / 2) k
      | true => r.getAux (half / 2) (k - half)

def SegTree.rangeMax : Nat → SegTree → Nat → Nat → Nat
  | 0, .L v, _, _ => v
  | d + 1, .N m l r, lo, hi =>
      let half := 2 ^ d
      if lo == 0 && hi + 1 >= 2 * half then m
      else if hi < half then l.rangeMax d lo hi
      else if half <= lo then r.rangeMax d (lo - half) (hi - half)
      else max (l.rangeMax d lo (half - 1)) (r.rangeMax d 0 (hi - half))
  | _, _, _, _ => 0

theorem SegTree.get_le_top {d : Nat} {t : SegTree} (hv : t.isValid d = true)
    {k : Nat} (hk : k < 2 ^ d) : t.get d k ≤ t.top := by
  induction d generalizing t k with
  | zero =>
    cases t with
    | L v => simp [SegTree.get, SegTree.top]
    | N _ _ _ => simp [SegTree.isValid] at hv
  | succ d ih =>
    cases t with
    | L _ => simp [SegTree.isValid] at hv
    | N m l r =>
      simp only [SegTree.isValid, Bool.and_eq_true, Nat.ble_eq] at hv
      rcases hv with ⟨⟨⟨hl, hr⟩, hlm⟩, hrm⟩
      simp only [SegTree.get, SegTree.top]
      split_ifs with h
      · exact le_trans (ih hl h) hlm
      · have hk' : k - 2 ^ d < 2 ^ d := by
          have : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
          omega
        exact le_trans (ih hr hk') hrm

theorem SegTree.get_le_rangeMax {d : Nat} {t : SegTree} (hv : t.isValid d = true)
    {lo hi k : Nat} (hlo : lo ≤ k) (hhi : k ≤ hi) (hk : k < 2 ^ d) :
    t.get d k ≤ t.rangeMax d lo hi := by
  induction d generalizing t lo hi k with
  | zero =>
    cases t with
    | L v => simp [SegTree.get, SegTree.rangeMax]
    | N _ _ _ => simp [SegTree.isValid] at hv
  | succ d ih =>
    cases t with
    | L _ => simp [SegTree.isValid] at hv
    | N m l r =>
      have hv0 := hv
      simp only [SegTree.isValid, Bool.and_eq_true, Nat.ble_eq] at hv
      rcases hv with ⟨⟨⟨hl, hr⟩, _⟩, _⟩
      unfold SegTree.rangeMax
      dsimp only
      split_ifs with hfull hleft hright
      · exact SegTree.get_le_top hv0 hk
      · have hk' : k < 2 ^ d := by omega
        simp only [SegTree.get, hk', ↓reduceIte]
        exact ih hl hlo hhi hk'
      · have hnk : ¬ k < 2 ^ d := by omega
        have hk' : k - 2 ^ d < 2 ^ d := by
          have : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
          omega
        simp only [SegTree.get, hnk, ↓reduceIte]
        exact ih hr (by omega) (by omega) hk'
      · simp only [SegTree.get]
        split_ifs with hk'
        · exact le_trans (ih hl hlo (by omega) hk') (le_max_left _ _)
        · have hk'' : k - 2 ^ d < 2 ^ d := by
            have : 2 ^ (d + 1) = 2 ^ d + 2 ^ d := by ring
            omega
          exact le_trans (ih hr (by omega) (by omega) hk'') (le_max_right _ _)

