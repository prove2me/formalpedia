            (X₂.vertexHecke ⟨q', hq'⟩).mulVec ((eX₂ x).1 : ↥(ssPlaces q N (IsLocalRing.ResidueField ↥A₂)) → ℤ) - ((eX₂ x).2 : ↥(ssPlaces q N (IsLocalRing.ResidueField ↥A₂)) → ℤ) ∧
