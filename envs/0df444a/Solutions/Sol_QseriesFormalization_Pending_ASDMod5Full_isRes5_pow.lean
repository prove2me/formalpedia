theorem solution {R : Type*} [CommRing R] {r : ℕ} {φ : R⟦X⟧}
    (hφ : IsRes5 r φ) :
    ∀ m, IsRes5 ((m * r) % 5) (φ ^ m)
  | 0 => by
      intro n hn
      rw [pow_zero]
      by_cases hn0 : n = 0
      · subst hn0
        simp at hn
      · rw [PowerSeries.coeff_one]
        simp [hn0]
  | m + 1 => by
      have hm := solution hφ m
      simpa [Nat.succ_mul, Nat.add_mod, Nat.mod_mod, pow_succ]
        using isRes5_mul hm hφ
