/-- **The paper's observation** that "every `ω ∈ M` is of the form
`h^{-d-α} ω̃(h^{-1}x, h^{-1}y)` for some `ω̃ ∈ N`", read backwards: rescaling a
kernel on `hℤ^d` gives a kernel on `ℤ^d` satisfying (4) with the same `Λ` and
`R₀`, for the rescaled configuration. -/
theorem solution {Γ : QFS.Configuration (EuclideanSpace ℝ (Fin d))}
    {α Λ R₀ h : ℝ} (hh : 0 < h)
    {ω : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℝ≥0∞}
    (hω : QFS.DiscreteKernelBounds Γ α Λ (R₀ * h) (QFS.scaledLattice d h) ω) :
    QFS.DiscreteKernelBounds (fun x => Γ (h • x)) α Λ R₀ (QFS.lattice d)
      (fun x y => ENNReal.ofReal (h ^ ((d:ℝ) + α)) * ω (h • x) (h • y)) where
  one_le := hω.one_le
  symm := fun x hx y hy => by
    rw [hω.symm (h • x) (QFS.smul_mem_scaledLattice hx) (h • y) (QFS.smul_mem_scaledLattice hy)]
  lower := by
    intro x hx y hy hxy
    have hd : (R₀ * h) < ‖h • x - h • y‖ := by
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hh]
      have : ‖x - y‖ = ‖x - y‖ := rfl
      nlinarith [hω.one_le]
    have hcone : ∀ a b : EuclideanSpace ℝ (Fin d),
        QFS.indE (QFS.coneAt (fun z => Γ (h • z)) a) b = QFS.indE (QFS.coneAt Γ (h • a)) (h • b) := by
      intro a b
      refine QFS.indE_congr ?_
      simp only [QFS.mem_coneAt]
      have he : h • b - h • a = h • (b - a) := by rw [smul_sub]
      rw [he]
      exact (QFS.smul_mem_doubleCone_iff hh (Γ (h • a)).norm_axis (Γ (h • a)).apex_pos
        (Γ (h • a)).apex_le (b - a)).symm
    rw [hcone x y, hcone y x, ← QFS.ofReal_rpow_mul_jumpKernel hh α x y]
    have hlow := hω.lower (h • x) (QFS.smul_mem_scaledLattice hx) (h • y)
      (QFS.smul_mem_scaledLattice hy) hd
    calc ENNReal.ofReal Λ⁻¹ * ((QFS.indE (QFS.coneAt Γ (h • x)) (h • y)
            + QFS.indE (QFS.coneAt Γ (h • y)) (h • x))
          * (ENNReal.ofReal (h ^ ((d:ℝ) + α)) * QFS.jumpKernel d α (h • x) (h • y)))
        = ENNReal.ofReal (h ^ ((d:ℝ) + α)) * (ENNReal.ofReal Λ⁻¹ *
            ((QFS.indE (QFS.coneAt Γ (h • x)) (h • y) + QFS.indE (QFS.coneAt Γ (h • y)) (h • x))
              * QFS.jumpKernel d α (h • x) (h • y))) := by ring
      _ ≤ ENNReal.ofReal (h ^ ((d:ℝ) + α)) * ω (h • x) (h • y) := mul_le_mul' le_rfl hlow
  upper := by
    intro x hx y hy hxy
    have hd : (R₀ * h) < ‖h • x - h • y‖ := by
      rw [← smul_sub, norm_smul, Real.norm_eq_abs, abs_of_pos hh]
      nlinarith [hω.one_le]
    have hup := hω.upper (h • x) (QFS.smul_mem_scaledLattice hx) (h • y)
      (QFS.smul_mem_scaledLattice hy) hd
    calc ENNReal.ofReal (h ^ ((d:ℝ) + α)) * ω (h • x) (h • y)
        ≤ ENNReal.ofReal (h ^ ((d:ℝ) + α)) *
            (ENNReal.ofReal Λ * QFS.jumpKernel d α (h • x) (h • y)) := mul_le_mul' le_rfl hup
      _ = ENNReal.ofReal Λ * (ENNReal.ofReal (h ^ ((d:ℝ) + α))
            * QFS.jumpKernel d α (h • x) (h • y)) := by ring
      _ = ENNReal.ofReal Λ * QFS.jumpKernel d α x y := by
          rw [QFS.ofReal_rpow_mul_jumpKernel hh]
