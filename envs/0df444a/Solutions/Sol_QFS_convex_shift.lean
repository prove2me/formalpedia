open QFS

variable {E : Type*} [NormedAddCommGroup E]

lemma solution {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F] {S : Set F}
    (hS : Convex ℝ S) (x : F) : Convex ℝ (QFS.shift S x) := by
  rintro p hp q hq a b ha hb hab
  simp only [QFS.mem_shift] at hp hq ⊢
  have he : a • p + b • q - x = a • (p - x) + b • (q - x) := by
    rw [smul_sub, smul_sub]
    rw [show a • p - a • x + (b • q - b • x) = a • p + b • q - (a • x + b • x) by abel]
    rw [← add_smul, hab, one_smul]
  rw [he]
  exact hS hp hq ha hb hab
