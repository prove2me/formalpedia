-- Source module: Solutions.R6BitNBRk
/-!
# Round six, bit network: pivot lemmas

* `isPiv_block`: pivots of a block in the top-right part pass to the whole matrix.
* `isPiv_diag_of_lower`: a lower triangular matrix with nonzero diagonal pivots on its diagonal.
* `isPiv_mid`: an idempotent of rank `m - k` with invertible `k × k` corner pivots on the middle
  diagonal (`CornerLib.solution`).
* `isPiv_rank1_lower`: a matrix that is rank one strictly above the diagonal pivots at `(l, l)`.
* `rk_mul_lower`, `isPiv_side`: lower triangular factors keep the rank profile; the pivots of
  `B M A` (`B` with lower triangular top, `A` with lower triangular right end) are those of `M`,
  moved to the top-right corner.
-/

namespace IntMul.Kappa.R6.Bit.NB

open Matrix Finset

variable {K : Type*} [Field K]

/-! ## Blocks -/

/-- The rank profile of a top-right block. -/
lemma rk_block {a b a' b' c0 : ℕ} (C : Matrix (Fin a) (Fin b) K) (B : Matrix (Fin a') (Fin b') K)
    (ha : a' ≤ a) (hb : c0 + b' = b)
    (hCB : ∀ (i : Fin a') (j : Fin b'),
      B i j = C ⟨i.val, lt_of_lt_of_le i.isLt ha⟩ ⟨c0 + j.val, by have := j.isLt; omega⟩)
    {X : ℕ} (hX : X ≤ a') (y : ℕ) : rk C X (c0 + y) = rk B X y := by
  unfold rk
  have e : B.submatrix (fun r : {r : Fin a' // r.val < X} => r.1)
      (fun c : {c : Fin b' // y ≤ c.val} => c.1) =
      C.submatrix (fun r : {r : Fin a' // r.val < X} => (⟨r.1.val, lt_of_lt_of_le r.1.isLt ha⟩ : Fin a))
        (fun c : {c : Fin b' // y ≤ c.val} =>
          (⟨c0 + c.1.val, by have := c.1.isLt; omega⟩ : Fin b)) := by
    ext r c; simp [hCB]
  rw [e]
  apply RunsLib.RunsAux.rank_submatrix_range
  · ext x
    simp only [Set.mem_range, Subtype.exists]
    constructor
    · rintro ⟨x', hx', rfl⟩
      exact ⟨⟨x'.val, by omega⟩, hx', rfl⟩
    · rintro ⟨x', hx', rfl⟩
      exact ⟨_, hx', rfl⟩
  · ext x
    simp only [Set.mem_range, Subtype.exists]
    constructor
    · rintro ⟨x', hx', rfl⟩
      refine ⟨⟨x'.val - c0, by have := x'.isLt; omega⟩, by simp only; omega, ?_⟩
      ext; simp only; omega
    · rintro ⟨x', hx', rfl⟩
      exact ⟨_, by simp only; omega, rfl⟩

lemma isPiv_block {a b a' b' c0 : ℕ} (C : Matrix (Fin a) (Fin b) K) (B : Matrix (Fin a') (Fin b') K)
    (ha : a' ≤ a) (hb : c0 + b' = b)
    (hCB : ∀ (i : Fin a') (j : Fin b'),
      B i j = C ⟨i.val, lt_of_lt_of_le i.isLt ha⟩ ⟨c0 + j.val, by have := j.isLt; omega⟩)
    {i j : ℕ} (h : IsPiv B i j) : IsPiv C i (c0 + j) := by
  have hi := (isPiv_lt h).1
  unfold IsPiv at h ⊢
  rw [show c0 + j + 1 = c0 + (j + 1) by omega, rk_block C B ha hb hCB (X := i + 1) (by omega),
    rk_block C B ha hb hCB (X := i + 1) (by omega), rk_block C B ha hb hCB (X := i) (by omega),
    rk_block C B ha hb hCB (X := i) (by omega)]
  exact h

/-! ## Lower triangular matrices -/

/-! ## The middle diagonal of an idempotent with invertible corner -/

/-! ## Rank one above the diagonal -/

/-! ## Lower triangular factors -/

lemma rk_mul_lower {m : ℕ} (L q R : Matrix (Fin m) (Fin m) K)
    (hL : ∀ i j, i < j → L i j = 0) (hLd : ∀ i, L i i ≠ 0)
    (hR : ∀ i j, i < j → R i j = 0) (hRd : ∀ i, R i i ≠ 0) (X Y : ℕ) :
    rk (L * q * R) X Y = rk q X Y := by
  classical
  unfold rk
  have hfac : (L * q * R).submatrix (fun r : {r : Fin m // r.val < X} => r.1)
        (fun c : {c : Fin m // Y ≤ c.val} => c.1) =
      L.submatrix (fun r : {r : Fin m // r.val < X} => r.1) (fun r : {r : Fin m // r.val < X} => r.1) *
        q.submatrix (fun r : {r : Fin m // r.val < X} => r.1) (fun c : {c : Fin m // Y ≤ c.val} => c.1) *
        R.submatrix (fun c : {c : Fin m // Y ≤ c.val} => c.1)
          (fun c : {c : Fin m // Y ≤ c.val} => c.1) := by
    ext r c
    simp only [submatrix_apply, mul_apply]
    rw [RunsLib.BruhatRankAux.sum_sub (p := fun b => Y ≤ b.val)
      (fun b => (∑ a, L r.1 a * q a b) * R b c.1)
      (fun b hb => by rw [hR b c.1 (show b.val < c.1.val by have := c.2; omega), mul_zero])]
    refine Finset.sum_congr rfl fun b _ => ?_
    congr 1
    exact RunsLib.BruhatRankAux.sum_sub (p := fun a => a.val < X) (fun a => L r.1 a * q a b.1)
      (fun a ha => by rw [hL r.1 a (show r.1.val < a.val by have := r.2; omega), zero_mul])
  have hdet : ∀ (p : Fin m → Prop) [DecidablePred p] (E : Matrix (Fin m) (Fin m) K),
      (∀ i j, i < j → E i j = 0) → (∀ i, E i i ≠ 0) →
      IsUnit (E.submatrix (fun r : {r // p r} => r.1) (fun r : {r // p r} => r.1)).det := by
    intro p _ E hE hd
    have hl : (E.submatrix (fun r : {r // p r} => r.1) (fun r : {r // p r} => r.1)).IsLowerTriangular :=
      fun a b hab => hE _ _ (show a.1 < b.1 from hab)
    rw [det_of_isLowerTriangular _ hl, isUnit_iff_ne_zero]
    exact Finset.prod_ne_zero_iff.2 fun a _ => hd a.1
  rw [hfac, rank_mul_eq_left_of_isUnit_det _ _ (hdet (fun c => Y ≤ c.val) R hR hRd),
    rank_mul_eq_right_of_isUnit_det _ _ (hdet (fun r => r.val < X) L hL hLd)]

/-! ## Side edges: low rank through lower triangular frames -/

theorem isPiv_side_sol_aux {m n : ℕ} (hnm : n ≤ m) (Bm : Matrix (Fin m) (Fin n) K)
    (M : Matrix (Fin n) (Fin n) K) (Am : Matrix (Fin n) (Fin m) K)
    (hB : ∀ i j : Fin n, i < j → Bm ⟨i.val, by omega⟩ j = 0)
    (hBd : ∀ i : Fin n, Bm ⟨i.val, by omega⟩ i ≠ 0)
    (hA : ∀ i j : Fin n, i < j → Am i ⟨m - n + j.val, by omega⟩ = 0)
    (hAd : ∀ i : Fin n, Am i ⟨m - n + i.val, by omega⟩ ≠ 0)
    {i j : ℕ} (h : IsPiv M i j) : IsPiv (Bm * M * Am) i (m - n + j) := by
  classical
  -- frames
  obtain ⟨Lh, hLh⟩ : ∃ L : Matrix (Fin m) (Fin m) K, L = Matrix.of fun x a =>
      if ha : a.val < n then Bm x ⟨a.val, ha⟩ else if x = a then 1 else 0 := ⟨_, rfl⟩
  obtain ⟨Ah, hAh⟩ : ∃ A : Matrix (Fin m) (Fin m) K, A = Matrix.of fun b y =>
      if hb : m - n ≤ b.val then Am ⟨b.val - (m - n), by omega⟩ y else if b = y then 1 else 0 :=
    ⟨_, rfl⟩
  obtain ⟨Mh, hMh⟩ : ∃ A : Matrix (Fin m) (Fin m) K, A = Matrix.of fun a b =>
      if hab : a.val < n ∧ m - n ≤ b.val then M ⟨a.val, hab.1⟩ ⟨b.val - (m - n), by omega⟩
      else 0 := ⟨_, rfl⟩
  have hfac : Bm * M * Am = Lh * Mh * Ah := by
    ext x y
    simp only [mul_apply]
    refine Fintype.sum_of_injective (M := K) (fun j : Fin n => (⟨m - n + j.val, by omega⟩ : Fin m))
      (fun j j' e => Fin.ext (by simpa using congrArg Fin.val e)) _ _ ?_ ?_
    · intro b hb
      have hb' : ¬ m - n ≤ b.val := by
        intro hb'
        exact hb ⟨⟨b.val - (m - n), by omega⟩, Fin.ext (by simp only; omega)⟩
      rw [Finset.sum_eq_zero, zero_mul]
      intro a _
      rw [hMh, of_apply, dif_neg (fun h => hb' h.2), mul_zero]
    · intro j'
      rw [hAh, of_apply, dif_pos (by simp only; omega)]
      have ej : (⟨(⟨m - n + j'.val, by omega⟩ : Fin m).val - (m - n), by simp only; omega⟩ : Fin n)
          = j' := by ext; simp only; omega
      rw [ej]
      congr 1
      refine Fintype.sum_of_injective (M := K) (fun a : Fin n => (⟨a.val, by omega⟩ : Fin m))
        (fun a a' e => Fin.ext (by simpa using congrArg Fin.val e)) _ _ ?_ ?_
      · intro a ha
        have ha' : ¬ a.val < n := fun ha' => ha ⟨⟨a.val, ha'⟩, rfl⟩
        rw [hMh, of_apply, dif_neg (fun h => ha' h.1), mul_zero]
      · intro a
        rw [hLh, hMh, of_apply, of_apply, dif_pos a.isLt, dif_pos ⟨a.isLt, by simp only; omega⟩, ej]
  have hLl : ∀ x a : Fin m, x < a → Lh x a = 0 := by
    intro x a hxa
    rw [hLh, of_apply]
    split_ifs with ha
    · exact hB ⟨x.val, by omega⟩ ⟨a.val, ha⟩ hxa
    · exact absurd (Fin.ext_iff.1 ‹x = a›) (by omega)
    · rfl
  have hLd : ∀ x : Fin m, Lh x x ≠ 0 := by
    intro x
    rw [hLh, of_apply]
    split_ifs with ha
    · exact hBd ⟨x.val, ha⟩
    · exact one_ne_zero
    · exact absurd rfl ‹_›
  have hAl : ∀ b y : Fin m, b < y → Ah b y = 0 := by
    intro b y hby
    rw [hAh, of_apply]
    split_ifs with hb
    · have := hA ⟨b.val - (m - n), by omega⟩ ⟨y.val - (m - n), by omega⟩
        (show b.val - (m - n) < y.val - (m - n) by have : b.val < y.val := hby; omega)
      rw [← this]; congr 1; ext; simp only; omega
    · exact absurd (Fin.ext_iff.1 ‹b = y›) (by omega)
    · rfl
  have hAd' : ∀ b : Fin m, Ah b b ≠ 0 := by
    intro b
    rw [hAh, of_apply]
    split_ifs with hb
    · have := hAd ⟨b.val - (m - n), by omega⟩
      rw [show (⟨m - n + (b.val - (m - n)), by omega⟩ : Fin m) = b by ext; simp only; omega] at this
      exact this
    · exact one_ne_zero
    · exact absurd rfl ‹_›
  have hpiv : IsPiv Mh i (m - n + j) :=
    isPiv_block Mh M hnm (by omega) (fun a b => by
      rw [hMh, of_apply, dif_pos ⟨a.isLt, by simp only; omega⟩]
      congr 1; ext; simp only; omega) h
  unfold IsPiv at hpiv ⊢
  rw [hfac, rk_mul_lower Lh Mh Ah hLl hLd hAl hAd', rk_mul_lower Lh Mh Ah hLl hLd hAl hAd',
    rk_mul_lower Lh Mh Ah hLl hLd hAl hAd', rk_mul_lower Lh Mh Ah hLl hLd hAl hAd']
  exact hpiv

end IntMul.Kappa.R6.Bit.NB

