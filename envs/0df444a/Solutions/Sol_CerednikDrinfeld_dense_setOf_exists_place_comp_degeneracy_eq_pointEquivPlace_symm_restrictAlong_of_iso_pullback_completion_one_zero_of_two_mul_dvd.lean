theorem dense_of_closedPoint_lift
    {C k : Type u} [Field C] [IsAlgClosed C] [Field k] [IsAlgClosed k] (ι : k →+* C)
    {Y X M : Scheme.{u}} (pY : Y ⟶ Spec (.of C)) (pX : X ⟶ Spec (.of C)) (pM : M ⟶ Spec (.of k))
    [IsIntegral Y] [IsIntegral X] [LocallyOfFiniteType pY] [LocallyOfFiniteType pX] [QuasiCompact pX] [QuasiSeparated pX]
    [LocallyOfFiniteType pM]
    (d : Y ⟶ X) (hd : d ≫ pX = pY) (hdom : d.base (genericPoint ↥Y) = genericPoint ↥X)
    (θ : X ⟶ M) (hθo : UniversallyOpen θ) (hθ : θ ≫ pM = pX ≫ Spec.map (CommRingCat.ofHom ι))
    (S : Set ↥Y)
    (hS : ∀ (y' : Spec (.of C) ⟶ Y), y' ≫ pY = 𝟙 _ → ∀ (x : ↥M) (hx : IsClosed ({x} : Set ↥M)),
      y' ≫ d ≫ θ = Spec.map (CommRingCat.ofHom ι) ≫ AlgebraicGeometry.pointOfClosedPoint pM x hx →
      y'.base (IsLocalRing.closedPoint C) ∈ S) :
    Dense S := by
  classical
  have hθopen : IsOpenMap θ.base := Scheme.Hom.isOpenMap θ
  haveI : CompactSpace ↥X := QuasiCompact.compactSpace_of_compactSpace pX
  haveI : QuasiSeparatedSpace ↥X := quasiSeparatedSpace_of_quasiSeparated pX
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian pX
  haveI : LocallyOfFiniteType d := by
    have : LocallyOfFiniteType (d ≫ pX) := by rw [hd]; infer_instance
    exact locallyOfFiniteType_of_comp d pX
  haveI hJM : JacobsonSpace ↥M := LocallyOfFiniteType.jacobsonSpace pM
  haveI hJY : JacobsonSpace ↥Y := LocallyOfFiniteType.jacobsonSpace pY
  rw [dense_iff_inter_open]
  intro V hVo ⟨y₀, hy₀⟩

  obtain ⟨_, ⟨V', hV'aff, rfl⟩, hy₀V', hV'V⟩ := Y.isBasis_affineOpens.exists_subset_of_mem_open hy₀ hVo
  haveI : Nonempty ↥(V' : Scheme.{u}) := ⟨⟨y₀, hy₀V'⟩⟩
  haveI : IsAffine (V' : Scheme.{u}) := hV'aff
  have hdomV : ((Scheme.Opens.ι V') ≫ d).base (genericPoint ↥(V' : Scheme.{u})) = genericPoint ↥X := by
    rw [Scheme.Hom.comp_base, TopCat.comp_app, genericPoint_eq_of_isOpenImmersion (Scheme.Opens.ι V'), hdom]

  obtain ⟨W₁, hW₁ne, hW₁sub⟩ :=
    AlgebraicGeometry.exists_opens_nonempty_subset_image_of_apply_genericPoint_eq ((Scheme.Opens.ι V') ≫ d) hdomV ⊤ (by simp)

  have hW₂o : IsOpen (θ.base '' (W₁ : Set ↥X)) := hθopen _ W₁.isOpen
  obtain ⟨q, ⟨x₁, hx₁W, hx₁q⟩, hqcl⟩ := nonempty_inter_closedPoints (hW₁ne.image _) hW₂o.isLocallyClosed
  obtain ⟨v₁, -, hv₁x⟩ := hW₁sub hx₁W
  have hqcl' : IsClosed ({q} : Set ↥M) := hqcl

  have hFcont : Continuous (fun y : ↥Y => θ.base (d.base y)) := θ.base.hom.continuous.comp d.base.hom.continuous
  have hZne : ((V' : Set ↥Y) ∩ (fun y : ↥Y => θ.base (d.base y)) ⁻¹' {q}).Nonempty := by
    refine ⟨(Scheme.Opens.ι V').base v₁, ?_, ?_⟩
    · exact v₁.2
    · show θ.base (d.base ((Scheme.Opens.ι V').base v₁)) = q
      rw [← hx₁q, ← hv₁x, Scheme.Hom.comp_base, TopCat.comp_app]
  have hZlc : IsLocallyClosed ((V' : Set ↥Y) ∩ (fun y : ↥Y => θ.base (d.base y)) ⁻¹' {q}) :=
    V'.isOpen.isLocallyClosed.inter (hqcl'.preimage hFcont).isLocallyClosed
  obtain ⟨y₁, ⟨hy₁V', hy₁q⟩, hy₁cl⟩ := nonempty_inter_closedPoints hZne hZlc
  have hy₁cl' : IsClosed ({y₁} : Set ↥Y) := hy₁cl

  refine ⟨y₁, hV'V hy₁V', ?_⟩
  have hy' := AlgebraicGeometry.pointOfClosedPoint_comp pY y₁ hy₁cl'
  have hy'pt : (AlgebraicGeometry.pointOfClosedPoint pY y₁ hy₁cl').base (IsLocalRing.closedPoint C) = y₁ :=
    AlgebraicGeometry.pointOfClosedPoint_apply pY y₁ hy₁cl' _
  have hp : (AlgebraicGeometry.pointOfClosedPoint pY y₁ hy₁cl' ≫ d ≫ θ) ≫ pM = Spec.map (CommRingCat.ofHom ι) := by
    rw [Category.assoc, Category.assoc, hθ, ← Category.assoc d, hd, ← Category.assoc, hy', Category.id_comp]
  have hpq : (AlgebraicGeometry.pointOfClosedPoint pY y₁ hy₁cl' ≫ d ≫ θ).base (IsLocalRing.closedPoint C) = q := by
    rw [Scheme.Hom.comp_base, TopCat.comp_app, hy'pt, Scheme.Hom.comp_base, TopCat.comp_app]
    exact hy₁q
  have hQ := AlgebraicGeometry.eq_specMap_comp_pointOfClosedPoint_of_apply_closedPoint_eq ι pM
    (AlgebraicGeometry.pointOfClosedPoint pY y₁ hy₁cl' ≫ d ≫ θ) hp q hqcl' hpq
  rw [← hy'pt]
  exact hS _ hy' q hqcl' hQ

theorem pointEquivPlace_symm_placeEquiv {k L : Type u} [Field k] [IsAlgClosed k] [Field L] [Algebra k L]
    (M : AlgebraicCurve.CurveModel k L) (x : ↥M.C) (hx : IsClosed ({x} : Set ↥M.C)) :
    (M.pointEquivPlace.symm (M.placeEquiv ⟨x, hx⟩)).1 = AlgebraicGeometry.pointOfClosedPoint M.toBase x hx := by
  simp only [AlgebraicCurve.CurveModel.pointEquivPlace, Equiv.symm_trans_apply, Equiv.symm_apply_apply,
    AlgebraicGeometry.pointEquivClosedPoint_symm_apply_coe]

