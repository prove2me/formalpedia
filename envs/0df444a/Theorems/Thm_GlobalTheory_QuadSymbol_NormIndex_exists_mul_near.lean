theorem GlobalTheory.QuadSymbol.NormIndex.exists_mul_near (h2 : (2 : K) ≠ 0) {π : K} (hπ : w π = WithZero.exp (-1))
    (hres : w 2 < 1 → ∀ x : K, w x ≤ 1 → ∃ y : K, w y ≤ 1 ∧ w (x - y ^ 2) < 1)
