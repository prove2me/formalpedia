/-- The padded row volume is at most twice the radix-`q` volume. -/
theorem rowVol_le {q W K r n : ℕ} (hq : 2 ≤ q) (hW : 1 ≤ W) (Pre G Suf : Shape)
    (hWK : W ^ K ≤ q ^ r) :
    vol (rowShape (vol Pre) (padRows W K (q ^ r)) (G ++ List.replicate r q) Suf q n) ≤
      2 * vol (qShape Pre G Suf q (r + n)) := by
  rw [vol_qShape_row, vol_rowShape]
  have h1 := padRows_le W K (q ^ r) hW
  have h2 : padRows W K (q ^ r) ≤ 2 * q ^ r := by omega
  calc vol Pre * padRows W K (q ^ r) * vol (restShape (G ++ List.replicate r q) Suf q n)
      ≤ vol Pre * (2 * q ^ r) * vol (restShape (G ++ List.replicate r q) Suf q n) :=
        Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ h2)
    _ = 2 * (vol Pre * (q ^ r * vol (restShape (G ++ List.replicate r q) Suf q n))) := by ring

