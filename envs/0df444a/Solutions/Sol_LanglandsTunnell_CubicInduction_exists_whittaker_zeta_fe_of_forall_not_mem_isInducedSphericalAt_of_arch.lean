namespace ArchCharFaithful
p2m_open "LanglandsTunnell.CubicInduction LanglandsTunnell"

open IsDedekindDomain NumberField NumberField.StandardAddChar

private def archEmb : (default : InfinitePlace ℚ).Completion →+* ℝ :=
  InfinitePlace.Completion.extensionEmbeddingOfIsReal (IsTotallyReal.isReal (default : InfinitePlace ℚ))

private theorem psiArch_eq_exp (x : InfiniteAdeleRing ℚ) :
    psiArch x = Complex.exp ((2 * Real.pi * Complex.I) * ((archEmb (x default) : ℝ) : ℂ)) := by
  rw [psiArch_apply,
    finprod_eq_single _ (default : InfinitePlace ℚ) (fun w hw => (hw (Subsingleton.elim w default)).elim)]
  rfl

private theorem archEmb_algebraMap_mul (q : ℚ) (x : InfiniteAdeleRing ℚ) :
    archEmb ((algebraMap ℚ (InfiniteAdeleRing ℚ) q * x) default) = (q : ℝ) * archEmb (x default) := by
  have hq : archEmb ((algebraMap ℚ (InfiniteAdeleRing ℚ) q) default) = (q : ℝ) :=
    eq_ratCast (archEmb.comp ((Pi.evalRingHom (fun v : InfinitePlace ℚ => v.Completion) default).comp
      (algebraMap ℚ (InfiniteAdeleRing ℚ)))) q
  rw [show (algebraMap ℚ (InfiniteAdeleRing ℚ) q * x) default
      = (algebraMap ℚ (InfiniteAdeleRing ℚ) q) default * x default from rfl, map_mul, hq]

private theorem eq_of_forall_psiArch_algebraMap_mul_eq (a a' : ℚ)
    (hAA : ∀ x : InfiniteAdeleRing ℚ, psiArch (algebraMap ℚ (InfiniteAdeleRing ℚ) a * x)
      = psiArch (algebraMap ℚ (InfiniteAdeleRing ℚ) a' * x)) : a = a' := by
  by_contra hne
  have hd : ((a : ℝ) - a') ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hne)
  obtain ⟨y, hy⟩ := InfinitePlace.Completion.surjective_extensionEmbeddingOfIsReal
    (IsTotallyReal.isReal (default : InfinitePlace ℚ)) (1 / (2 * ((a : ℝ) - a')))
  obtain ⟨x, hx⟩ := Function.surjective_eval (β := fun v : InfinitePlace ℚ => v.Completion) default y
  have hr : archEmb (x default) = 1 / (2 * ((a : ℝ) - a')) := by
    rw [show x default = y from hx]
    exact hy
  have h := hAA x
  rw [psiArch_eq_exp, psiArch_eq_exp, archEmb_algebraMap_mul, archEmb_algebraMap_mul, hr] at h
  obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp h
  have h2 : (2 * (Real.pi : ℂ) * Complex.I) ≠ 0 :=
    mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)) Complex.I_ne_zero
  have h3 : ((((a : ℝ) * (1 / (2 * ((a : ℝ) - a'))) : ℝ)) : ℂ)
      - (((a' : ℝ) * (1 / (2 * ((a : ℝ) - a'))) : ℝ) : ℂ) = (n : ℂ) := by
    apply mul_left_cancel₀ h2
    linear_combination hn
  have h4 : ((a : ℝ) * (1 / (2 * ((a : ℝ) - a'))) - (a' : ℝ) * (1 / (2 * ((a : ℝ) - a'))) : ℝ) = n := by
    exact_mod_cast h3
  have h5 : ((n : ℝ)) = 1 / 2 := by
    rw [← h4, ← sub_mul]
    field_simp
  have h6 : (2 * n : ℤ) = 1 := by
    have : (2 * (n : ℝ)) = 1 := by rw [h5]; ring
    exact_mod_cast this
  omega

private theorem norm_eq_one_of_valued_eq_one {v : HeightOneSpectrum (𝓞 ℚ)} {x : v.adicCompletion ℚ}
    (hx : Valued.v x = 1) : ‖x‖ = 1 := by
  rw [FinitePlace.norm_def, hx, map_one, NNReal.coe_one]

end LanglandsTunnell.CubicInduction.ArchCharFaithful

