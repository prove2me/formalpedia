-- Source module: Solutions.R6IL3Net
/-!
# Round six, item language (I3): the network in the item-language numbering

* `mapR e`: transport of a step along a role equivalence; `denListH_mapR`: the denotation
  is reindexed.
* **`netF J`**: the normalized network (`R6IL3Norm`) with roles `Fin (W + T)` (data first,
  `roleEqv`); `netF_child` (children are forward prefix children of width `< m`), `netF_gate`
  (gate class), **`netF_data`** (the data-to-data block is `C^{⊗}` on every data role),
  `netF_widths`.
* `Gs A p m x`: the closed-form scale bound (`x` below `2m`, `A((x+1)^p - 1)` above);
  **`Gs_node`**: a node on `E = mF + r ≥ 2m` bits whose children have widths `s F` (`s` in
  `ws`, `2 Σ (2s+1)^p ≤ (2m)^p`) has local scale `c` plus child scales plus leftover scale at
  most `Gs E`.
* `dep m x`: the number of node levels below `x` bits (`dep_child`, `dep_mono`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace IntMul.Kappa.R6.IL3H

open Matrix Finset Complex Butterfly P8Lift IntMul.Kappa.R6.Cx

/-! ## Role transport -/

section Map

variable {R R' : Type} [Fintype R] [DecidableEq R] [Fintype R'] [DecidableEq R'] {m : ℕ}

theorem reidx_mul {κ : Type} [Fintype κ] [DecidableEq κ] (e : R ≃ R') (A B : ROp R m κ) :
    reidx e (A * B) = reidx e A * reidx e B := by
  unfold reidx
  have := Matrix.submatrix_mul_equiv A B (fun p : R' × Addr m κ => (e.symm p.1, p.2))
    (Equiv.prodCongr e.symm (Equiv.refl (Addr m κ))) (fun p : R' × Addr m κ => (e.symm p.1, p.2))
  exact this.symm

theorem reidx_one {κ : Type} [Fintype κ] [DecidableEq κ] (e : R ≃ R') :
    reidx e (1 : ROp R m κ) = 1 := by
  ext p q
  simp only [reidx, submatrix_apply, one_apply, Prod.mk.injEq]
  by_cases h : p = q
  · subst h; simp
  · rw [if_neg, if_neg h]
    rintro ⟨h1, h2⟩
    exact h (Prod.ext (e.symm.injective h1) h2)

theorem width_mapR (e : R ≃ R') (st : HStep R m) : (mapR e st).width = st.width := by
  cases st <;> rfl

theorem reidx_apply {κ : Type} (e : R ≃ R') (A : ROp R m κ) (p q : R' × Addr m κ) :
    reidx e A p q = A (e.symm p.1, p.2) (e.symm q.1, q.2) := rfl

theorem den_mapR {κ : Type} [Fintype κ] [DecidableEq κ] (e : R ≃ R')
    (ch : Finset (Fin m) → Op (Fin m × κ)) (st : HStep R m) :
    (mapR e st).den ch = reidx e (st.den ch) := by
  ext ⟨p1, p2⟩ ⟨q1, q2⟩
  rw [reidx_apply]
  have h1 : (p1 = q1) ↔ (e.symm p1 = e.symm q1) := e.symm.injective.eq_iff.symm
  cases st with
  | gate G => rfl
  | rowAdd w i j hij =>
    have h2 : (p1 = e w) ↔ (e.symm p1 = w) := (Equiv.symm_apply_eq e).symm
    simp only [mapR, HStep.den, RStep.den]
    simp only [h1, h2]
  | phase w k₀ k₁ a =>
    have h2 : (p1 = e w) ↔ (e.symm p1 = w) := (Equiv.symm_apply_eq e).symm
    simp only [mapR, HStep.den, RStep.den, diagonal_apply, Prod.mk.injEq]
    simp only [h1, h2]
  | perm σ =>
    simp only [mapR, HStep.den, RStep.den, Equiv.permCongr_apply]
    have h3 : (p1 = e (σ (e.symm q1))) ↔ (e.symm p1 = σ (e.symm q1)) := (Equiv.symm_apply_eq e).symm
    simp only [h3]
  | child w S neg =>
    have h2 : (p1 = e w) ↔ (e.symm p1 = w) := (Equiv.symm_apply_eq e).symm
    simp only [mapR, HStep.den, wireOp, blockOp]
    simp only [h1, h2]

theorem denListH_mapR {κ : Type} [Fintype κ] [DecidableEq κ] (e : R ≃ R')
    (ch : Finset (Fin m) → Op (Fin m × κ)) (l : List (HStep R m)) :
    denListH ch (l.map (mapR e)) = reidx e (denListH ch l) := by
  induction l using List.reverseRecOn with
  | nil => simp [reidx_one]
  | append_singleton l s ih =>
    rw [List.map_append, List.map_singleton, denListH_append, denListH_append, ih,
      denListH_single, denListH_single, den_mapR, reidx_mul]

theorem widths_mapR (e : R ≃ R') (l : List (HStep R m)) :
    (l.map (mapR e)).filterMap HStep.width = l.filterMap HStep.width := by
  rw [List.filterMap_map]
  congr 1
  funext st
  exact width_mapR e st

end Map

/-! ## The item-language network -/

section NetF

variable {W T m : ℕ} {h : List (ℕ × ℕ)}

theorem netF_widths (J : Prop8IfaceH W T m h) :
    (netF J).filterMap HStep.width = J.widths := by
  rw [netF, widths_mapR]
  exact Prop8IfaceH'.norm_widths J

theorem netF_child (J : Prop8IfaceH W T m h) {w : Fin (W + T)} {S neg : Finset (Fin m)}
    (hc : HStep.child w S neg ∈ netF J) : neg = ∅ ∧ S = pref m S.card ∧ S.card < m := by
  obtain ⟨st, hst, he⟩ := List.mem_map.1 hc
  cases st with
  | child w' S' neg' =>
    simp only [mapR, HStep.child.injEq] at he
    obtain ⟨-, rfl, rfl⟩ := he
    exact Prop8IfaceH'.norm_child J hst
  | gate _ => cases he
  | rowAdd _ _ _ _ => cases he
  | phase _ _ _ _ => cases he
  | perm _ => cases he

/-- **The gate class of the item-language network.** -/
theorem netF_gate {J : Prop8IfaceH W T m h} {A : ℕ} (hJ : GClassH J A)
    {G : Matrix (Fin (W + T)) (Fin (W + T)) ℂ} (hg : HStep.gate G ∈ netF J) :
    (∃ as : List NLogN.KFG.Atom, as.length ≤ A ∧ (∀ a ∈ as, a.Ok (W + T) ∧ a.h ≤ 1) ∧
        NLogN.KFG.NoTS as ∧ G = NLogN.KFG.gateMat (W + T) as) ∨
      (∃ U : Finset (Fin (W + T)), G = Matrix.diagonal fun w => if w ∈ U then -1 else 1) := by
  obtain ⟨st, hst, he⟩ := List.mem_map.1 hg
  cases st with
  | gate G0 =>
    simp only [mapR, HStep.gate.injEq] at he
    subst he
    rcases hJ.norm G0 hst with ⟨as, h1, h2, h3, h4⟩ | ⟨U, hU⟩
    · refine Or.inl ⟨as, h1, h2, h3, ?_⟩
      rw [h4]; ext p q; simp
    · refine Or.inr ⟨U.map (roleEqv W T).toEmbedding, ?_⟩
      rw [hU]; ext p q
      simp only [submatrix_apply, diagonal_apply, (roleEqv W T).symm.injective.eq_iff,
        Finset.mem_map_equiv]
  | rowAdd _ _ _ _ => cases he
  | phase _ _ _ _ => cases he
  | perm _ => cases he
  | child _ _ _ => cases he

/-- **Data correctness** in the item-language numbering. -/
theorem netF_data (J : Prop8IfaceH W T m h) (κ : Type) [Fintype κ] [DecidableEq κ]
    (w w' : Fin W) (x y : Addr m κ) :
    denListH (chEx (κ := κ)) (netF J) (Fin.castAdd T w, x) (Fin.castAdd T w', y) =
      if w = w' then (tens Cm : Op (Fin m × κ)) x y else 0 := by
  rw [netF, denListH_mapR]
  simp only [reidx, submatrix_apply]
  have e1 : (roleEqv W T).symm (Fin.castAdd T w) = Sum.inl w := by
    simp [roleEqv]
  have e2 : (roleEqv W T).symm (Fin.castAdd T w') = Sum.inl w' := by
    simp [roleEqv]
  rw [e1, e2]
  exact (Prop8IfaceH'.norm J).correct κ w w' x y

end NetF

