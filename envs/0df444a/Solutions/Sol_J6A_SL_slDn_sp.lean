section
-- Source module: Solutions.J6SegILCtl1
/-!
# B-line IL, B1 follow-up: building the control list, §1 the list level

The control builder streams a **source table** `srcTab src argOf n'` (two integers per output
slab `l < n'`: `code (src l)` (`-1` for `none`, `k` for `some k`) and `argOf l`) and produces
`ctlOf n n' src argOf`. The list facts:

* `ctlAux_snoc`: `ctlAux` on `ls ++ [l]` is `ctlAux` on `ls` followed by the step of `l`
  (`stepC`: `none ↦ [(0,0)]`, `some k ↦ (k - cur)` drops then `(1, argOf l)`; `stepK`: the new
  position).
* `flatC_snoc`, `srcTab_succ`: the table and the control list grow one entry at a time.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace J6Seg.Slab

theorem ctlAux_snoc (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) :
    ∀ (ls : List ℕ) (l cur : ℕ),
      J6Seg.ctlAux src argOf (ls ++ [l]) cur =
        ((J6Seg.ctlAux src argOf ls cur).1 ++ stepC src argOf l (J6Seg.ctlAux src argOf ls cur).2,
          stepK src l (J6Seg.ctlAux src argOf ls cur).2)
  | [], l, cur => by
    simp only [List.nil_append, J6Seg.ctlAux, stepC, stepK]
    cases src l <;> simp
  | l' :: ls, l, cur => by
    simp only [List.cons_append, J6Seg.ctlAux]
    cases src l' with
    | none => simp only []; rw [ctlAux_snoc src argOf ls l cur]; simp
    | some k => simp only []; rw [ctlAux_snoc src argOf ls l k]; simp

/-- The positions along the source table are bounded (from `SrcFrom`). -/
theorem srcFrom_range_take {n n' : ℕ} {src : ℕ → Option ℕ} (hs : J6Seg.MonoSrc n n' src) (j : ℕ)
    (hj : j < n') : ∀ k, src j = some k →
      (J6Seg.ctlAux src (fun _ => 0) (List.range j) 0).2 ≤ k ∧ k < n := by
  intro k hk
  refine ⟨?_, hs.1 j hj k hk⟩
  -- the position after `range j` is the last source below `j` (or `0`)
  suffices H : ∀ i, i ≤ j → (J6Seg.ctlAux src (fun _ => 0) (List.range i) 0).2 ≤ k by
    exact H j le_rfl
  intro i
  induction i with
  | zero => intro _; simp [J6Seg.ctlAux]
  | succ i ih =>
    intro hi
    rw [List.range_succ, ctlAux_snoc]
    simp only [stepK]
    cases hsi : src i with
    | none => exact ih (by omega)
    | some k' => exact hs.2 i j k' k (by omega) hj hsi hk

/-- The position never decreases along a monotone source. -/
theorem ctlAux_pos_le {n n' : ℕ} {src : ℕ → Option ℕ} (hs : J6Seg.MonoSrc n n' src)
    (argOf : ℕ → ℤ) (j : ℕ) (hj : j ≤ n') : (J6Seg.ctlAux src argOf (List.range j) 0).2 ≤ n := by
  have := J6Seg.ctlAux_le src argOf n (List.range j) 0 (Nat.zero_le _)
    (by
      have h := J6Seg.srcFrom_range hs
      -- `SrcFrom` on a prefix of `range n'`
      have e : List.range n' = List.range j ++ (List.range (n' - j)).map (j + ·) := by
        rw [← List.range_add]; congr 1; omega
      rw [e] at h
      exact srcFrom_prefix _ _ _ _ _ h)
  exact this.2
where
  srcFrom_prefix (src : ℕ → Option ℕ) (n : ℕ) :
      ∀ (a : List ℕ) (b : List ℕ) (cur : ℕ), J6Seg.SrcFrom src n (a ++ b) cur → J6Seg.SrcFrom src n a cur
    | [], _, _, _ => trivial
    | l :: a, b, cur, h => by
      simp only [List.cons_append, J6Seg.SrcFrom] at h ⊢
      cases hs : src l with
      | none => simp only [hs] at h ⊢; exact srcFrom_prefix src n a b cur h
      | some k =>
        simp only [hs] at h ⊢
        exact ⟨h.1, h.2.1, srcFrom_prefix src n a b k h.2.2⟩

end J6Seg.Slab

end

section
-- Source module: Solutions.J6SegILCtl2
/-!
# B-line IL, B1 follow-up: building the control list, §2 one table entry

**Register convention of the control builder** (all below `56`, none `0`, none in `26–29`;
`lA lC lD = 34–36` are the `rptX` counters, empty in the managed state):

| stack | role |
|---|---|
| `bX = 44` | the source table `srcTab src argOf n'` (input, restored) |
| `bN' = 20`, `bN = 21` | `n'`, `n` (inputs, one value each, preserved) |
| `bSv = 25` | the consumed table entries (scratch, emptied by the restore) |
| `bCur = 30` | the input position (scratch) |
| `bT = 33` | the reversed control list being built (scratch, emptied by the transfer) |
| `bCd = 24`, `bA = 23`, `bW = 22`, `bD = 32` | scratch of one entry |
| `rC = 45`, `rNC = 38` | outputs: `flatC cs` pushed on `rC`, `|cs|` pushed on `rNC` |

Here: `loopMV` (a variable-cost `rptX` over managed states) and **`entry_runs`** (one table
entry: the commands of one output slab pushed reversed onto `bT`, the position updated, the entry
saved on `bSv`).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxRecDepth 20000

namespace J6Seg.Slab

open IntMul NLogN NLogN.KIL Function
open NLogN.KFUU (lA lC lD cU)
open NLogN.KFT (cf3 rptX)

/-! ## List level: one step -/

theorem stepC_eq (src : ℕ → Option ℕ) (argOf : ℕ → ℤ) (l cur : ℕ) :
    stepC src argOf l cur = stO (src l) (argOf l) cur := by
  unfold stepC stO; cases src l <;> rfl

theorem stepK_eq (src : ℕ → Option ℕ) (l cur : ℕ) : stepK src l cur = kO (src l) cur := by
