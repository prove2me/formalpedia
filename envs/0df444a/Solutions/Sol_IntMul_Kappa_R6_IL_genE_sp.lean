theorem vPre_zero :
    vPre m q e P L a b c rLp = 0 ∧ vPre m q e P L a b c gA = 0 ∧ vPre m q e P L a b c rXs = 0 ∧
    vPre m q e P L a b c rVB = 0 ∧ vPre m q e P L a b c rVC = 0 ∧ vPre m q e P L a b c rV = 0 ∧
    vPre m q e P L a b c rWV = 0 ∧ vPre m q e P L a b c gTV = 0 := by
  simp +decide [vPre, entA1, evalA, NE.val, Function.update_apply, vDesc]

end Vals

/-! ## The entry specification -/

theorem fDesc_mem (e P L a b c : ℕ) {j : Fin HS} (h : j ∈ descD) :
    fDesc e P L a b c j = [((vDesc e P L a b c j : ℕ) : ℤ)] := by
  simp [fDesc, regState, h]

theorem vDesc_genD (e P L a b c : ℕ) : ∀ i ∈ genD, vDesc e P L a b c i = 0 := by
  intro i hi
  simp only [genD, List.mem_cons, List.not_mem_nil, or_false] at hi
  rcases hi with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp +decide [vDesc]

set_option maxHeartbeats 1000000 in
/-- **The entry computes the register file.** -/
theorem genE_sp_sol_aux (s : IState HS) {m q W T e P L a b c M Bb : ℕ} (hM : zsz (M : ℤ) ≤ Bb)
    (h : EntB m q W T e P L a b c M) :
    Sp (genE m q W T) (encK s (fDesc e P L a b c))
      (encK s (regState (fDesc e P L a b c) (vEnt m q W T e P L a b c) genD))
      (cGenE m q W T e Bb) := by
  set F := fDesc e P L a b c with hF
  set v0 := vDesc e P L a b c with hv0
  have hF27 : F gC = [] := fDesc_free (by decide)
  have hd := h.desc
  have hlit := h.lit
  have hm1 := h.m1
  have hFd : ∀ j ∈ descD, ∃ L, F j = ((v0 j : ℕ) : ℤ) :: L := fun j hj => ⟨[], fDesc_mem _ _ _ _ _ _ hj⟩
  have S0 := Sp.pushZ s Bb genD F genD_lt genD_nodup
  rw [regState_congr F genD (v' := v0) (fun i hi => (vDesc_genD e P L a b c i hi).symm)] at S0
  -- the first assignments
  have SA := Sp.asgs s F genD hM (entA1 m) v0 (by
    simp +decide [OKA, entA1, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, v0,
      vDesc, F, fDesc, regState, descD, genD]
    omega)
  set v1 := evalA (entA1 m) v0 with hv1
  have v1F : v1 gF = e / m := by simp +decide [v1, v0, entA1, evalA, NE.val, Function.update_apply, vDesc]
  have v1R : v1 gR = e % m := by simp +decide [v1, v0, entA1, evalA, NE.val, Function.update_apply, vDesc]
  have v1Q : v1 sQQ = 1 := by simp +decide [v1, v0, entA1, evalA, NE.val, Function.update_apply, vDesc]
  have v1QR : v1 gQR = 1 := by simp +decide [v1, v0, entA1, evalA, NE.val, Function.update_apply, vDesc]
  have v1G : v1 kG = 1 := by simp +decide [v1, v0, entA1, evalA, NE.val, Function.update_apply, vDesc]
  have hN1 : 1 ≤ q ^ (e / m) := Nat.one_le_pow _ _ (by have := h.q1; omega)
  have hNN : q ^ (e / m) ≤ (q ^ (e / m)) ^ m := Nat.le_self_pow (by omega) _
  have hfe : e / m ≤ e := Nat.div_le_self _ _
  have hre : e % m ≤ e := Nat.mod_le _ _
  -- the loop for `N = q ^ f`
  have SB := Sp.repA s F genD hM (C := gC) (by decide) (by decide) hF27 (mulL sQQ q) (by simp +decide [mulL])
    (.reg gF) trivial v1 (fun j hj => by
      simp [NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by show v1 gF ≤ M; rw [v1F]; omega)
    (by
      intro k hk
      simp only [NE.val, v1F] at hk
      rw [iter_mulL, v1Q, one_mul]
      have hk2 : q ^ k * q ≤ q ^ (e / m) := by
        rw [← pow_succ]; exact Nat.pow_le_pow_right h.q1 hk
      have hk3 : q ^ k ≤ q ^ (e / m) := Nat.pow_le_pow_right h.q1 hk.le
      exact okA_mulL (by decide) (by decide) (by omega) (by simp; have := h.Nm; omega)
        (by simp; have := h.Nm; omega))
  simp only [NE.val, v1F] at SB
  rw [iter_mulL, v1Q, one_mul] at SB
  set v2 := Function.update v1 sQQ (q ^ (e / m)) with hv2
  have v2R : v2 gR = e % m := by rw [hv2, Function.update_of_ne (by decide), v1R]
  have v2QR : v2 gQR = 1 := by rw [hv2, Function.update_of_ne (by decide), v1QR]
  -- the loop for `q ^ r`
  have hr1 : 1 ≤ q ^ (e % m) := Nat.one_le_pow _ _ (by have := h.q1; omega)
  have hqrM : q ^ (e % m) ≤ M := le_trans (Nat.le_mul_of_pos_right _ h.b1) h.qb
  have SC := Sp.repA s F genD hM (C := gC) (by decide) (by decide) hF27 (mulL gQR q) (by simp +decide [mulL])
    (.reg gR) trivial v2 (fun j hj => by
      simp [NE.regs] at hj; subst hj; exact ⟨by decide, Or.inl (by decide)⟩)
    (by show v2 gR ≤ M; rw [v2R]; omega)
    (by
      intro k hk
      simp only [NE.val, v2R] at hk
      rw [iter_mulL, v2QR, one_mul]
      have hk2 : q ^ k * q ≤ q ^ (e % m) := by
        rw [← pow_succ]; exact Nat.pow_le_pow_right h.q1 hk
      have hk3 : q ^ k ≤ q ^ (e % m) := Nat.pow_le_pow_right h.q1 hk.le
      exact okA_mulL (by decide) (by decide) (by omega) (by simp; omega) (by simp; omega))
  simp only [NE.val, v2R] at SC
  rw [iter_mulL, v2QR, one_mul] at SC
  set v3 := Function.update v2 gQR (q ^ (e % m)) with hv3
  have v3G : v3 kG = 1 := by
    rw [hv3, Function.update_of_ne (by decide), hv2, Function.update_of_ne (by decide), v1G]
  have v3Q : v3 sQQ = q ^ (e / m) := by
    rw [hv3, Function.update_of_ne (by decide), hv2, Function.update_self]
  -- the loop for `N ^ m`
  have SD := Sp.repA s F genD hM (C := gC) (by decide) (by decide) hF27 (mulR kG sQQ) (by simp +decide [mulR])
    (.lit m) trivial v3 (fun j hj => by simp [NE.regs] at hj)
    (by show m ≤ M; omega)
    (by
      intro k hk
      simp only [NE.val] at hk
      rw [iter_mulR (by decide), v3G, one_mul, v3Q]
      have hk2 : (q ^ (e / m)) ^ k * q ^ (e / m) ≤ (q ^ (e / m)) ^ m := by
        rw [← pow_succ]; exact Nat.pow_le_pow_right hN1 hk
      have hk3 : (q ^ (e / m)) ^ k ≤ (q ^ (e / m)) ^ m := Nat.pow_le_pow_right hN1 hk.le
      have hNm := h.Nm
      refine ⟨by decide, by decide, by simp only [Function.update_self]; omega, fun j hj => ?_,
        ⟨by simp only [NE.OK, Function.update_self]; omega, ?_, ?_⟩, trivial⟩
      · simp [NE.regs] at hj
        rcases hj with rfl | rfl
        · exact ⟨by decide, Or.inl (by decide)⟩
        · exact ⟨by decide, Or.inl (by decide)⟩
      · show (Function.update v3 kG ((q ^ (e / m)) ^ k)) sQQ ≤ M
        rw [Function.update_of_ne (by decide), v3Q]; omega
      · simp only [NE.val, Function.update_self]
        rw [Function.update_of_ne (by decide), v3Q]; omega)
  simp only [NE.val] at SD
  rw [iter_mulR (by decide), v3G, one_mul, v3Q] at SD
  have hvP : Function.update v3 kG ((q ^ (e / m)) ^ m) = vPre m q e P L a b c := rfl
  rw [hvP] at SD
  -- the level quantities
  obtain ⟨p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11⟩ := vPre_vals m q e P L a b c
  have hX : P * (L / W) * a ≤ (T + W) * volE m q W e P L a b c := by
    have h1 : 1 ≤ (q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m * (q ^ (e % m) * c) :=
      Nat.mul_pos (Nat.mul_pos (Nat.mul_pos (Nat.one_le_pow _ _ hN1) (Nat.mul_pos hr1 h.b1))
        (Nat.one_le_pow _ _ hN1)) (Nat.mul_pos hr1 h.c1)
    have h2 : P * (L / W) * a ≤ volE m q W e P L a b c := by
      unfold volE
      calc P * (L / W) * a = P * (L / W) * a * 1 := (mul_one _).symm
        _ ≤ P * (L / W) * a * ((q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m *
            (q ^ (e % m) * c)) := Nat.mul_le_mul_left _ h1
        _ = _ := by ring
    exact le_trans h2 (Nat.le_mul_of_pos_left _ (by have := h.W1; omega))
  have hvv := h.vv
  have hV1 : volE m q W e P L a b c ≤ (T + W) * volE m q W e P L a b c :=
    Nat.le_mul_of_pos_left _ (by have := h.W1; omega)
  have hTV : T * volE m q W e P L a b c ≤ (T + W) * volE m q W e P L a b c :=
    Nat.mul_le_mul_right _ (by omega)
  have hPL : P * (L / W) ≤ P * (L / W) * a := Nat.le_mul_of_pos_right _ h.a1
  have hLW : L / W ≤ L := Nat.div_le_self _ _
  -- partial products of the volume
  have hpp : ∀ x y : ℕ, 1 ≤ y → x * y ≤ volE m q W e P L a b c → x ≤ volE m q W e P L a b c :=
    fun x y hy hxy => le_trans (Nat.le_mul_of_pos_right _ hy) hxy
  have hNm1 : 1 ≤ (q ^ (e / m)) ^ m := Nat.one_le_pow _ _ hN1
  have hb' : 1 ≤ q ^ (e % m) * b := Nat.mul_pos hr1 h.b1
  have hc' : 1 ≤ q ^ (e % m) * c := Nat.mul_pos hr1 h.c1
  have q1 : P * (L / W) * a * (q ^ (e / m)) ^ m * (q ^ (e % m) * b) * (q ^ (e / m)) ^ m ≤
      volE m q W e P L a b c := hpp _ _ hc' le_rfl
  have q2 : P * (L / W) * a * (q ^ (e / m)) ^ m * (q ^ (e % m) * b) ≤ volE m q W e P L a b c :=
    hpp _ _ hNm1 q1
  have q3 : P * (L / W) * a * (q ^ (e / m)) ^ m ≤ volE m q W e P L a b c := hpp _ _ hb' q2
  obtain ⟨z1, z2, z3, z4, z5, z6, z7, z8⟩ := vPre_zero m q e P L a b c
  have hqb := h.qb
  have hqc := h.qc
  have hNm := h.Nm
  have hW1 := h.W1
  have hb1 := h.b1
  have hc1 := h.c1
  unfold volE at q1 q2 q3 hvv hV1 hTV hX
  have SE := Sp.asgs s F genD hM (entA2 W T) (vPre m q e P L a b c) (by
    simp +decide [OKA, entA2, RegsIn, NE.regs, NE.OK, NE.val, Function.update_apply, F, fDesc,
      regState, descD, genD, vDesc, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, z1, z2, z3, z4,
      z5, z6, z7, z8]
    and_intros <;> omega)
  refine ((S0.seq (SA.seq (SB.seq (SC.seq (SD.seq SE)))))).mono (le_of_eq ?_)
  simp only [cGenE, cRep, NE.size]

end

end IntMul.Kappa.R6.IL

end

theorem solution : type_of% @IntMul.Kappa.R6.IL.genE_sp_sol_aux := @IntMul.Kappa.R6.IL.genE_sp_sol_aux
