    have hψ1G : (ψ : G) ≠ 1 := fun h => hψ1 (Subtype.ext h)
    have hψgenR : Subgroup.zpowers (ψ : G) = R := zpowers_eq_of_prime_card hRp' ψ.2 hψ1G
