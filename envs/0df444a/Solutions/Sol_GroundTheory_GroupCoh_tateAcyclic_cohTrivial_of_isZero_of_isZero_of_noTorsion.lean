    rfl
  have c := tateAcyclic_of_shortExact_of_comp_eq_nsmul (hG.to_subgroup H) hS'
    (Iso.refl (S.map (resFunctor H.subtype)).X₁) hf' h₃
  rw [ShortComplex.map_X₁] at c
  exact c
