    (fun q => blockB certificate133 q certificate133.blockers[q]!) = true := by
  apply List.all_eq_true.mpr
  intro q hq
  have hq' : q < 6561 := List.mem_range.mp hq
  by_cases h : q < 3328
  · simpa only [Nat.zero_add] using case133_blockers0 ⟨q,h⟩
  · have hle : 3328 ≤ q := by omega
    simpa only [Nat.add_sub_of_le hle] using
      case133_blockers1 ⟨q-3328,by omega⟩
private theorem rows_check : certificate133.rows.toList.all (rowB certificate133) = true := by
  decide_cbv
private theorem covers_check : (List.range certificate133.pool.size).all (localCoverB certificate133) = true := by
  decide_cbv
private theorem cost_check : decide (cost certificate133 < certificate133.denominator * (deletedCount certificate133+1)) = true := by
  decide_cbv
theorem solution : CompletionBound (decode 1004) (1 : ZMod 3) := by
  have hs : certificate133.blockers.size = 6561 := by
    simp only [certificate133, binaryBlockers, Array.size_ofFn]
  have hb : CompletionBound (decode certificate133.normal) certificate133.level := by
    apply boolean_check_completion_bound
    unfold verifyB
    rw [hs, all_blocks, rows_check, covers_check, cost_check]
    decide_cbv
  exact hb
