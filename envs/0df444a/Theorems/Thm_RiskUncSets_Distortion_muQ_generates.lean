-- title:
--   Proof of Theorem 4.2, p. 1489 — for q ∈ Δ̂ᴺ, μ_q(X) = −Σ qᵢ x₍ᵢ₎ is generated by the permutations of q
-- statement:
--   Let $N \ge 1$ and $q \in \hat\Delta^N$, i.e. $q \in \Delta^N$ with $q_1 \ge \cdots \ge q_N$. Let $\mu_q(X) = -\sum_{i=1}^N q_i x_{(i)}$, where $x_{(1)} \le \cdots \le x_{(N)}$ are the increasing order statistics of $X \in \mathbb R^N$ (display (4)). Then $\mu_q$ is generated, in the sense of (1), by the family of permuted vectors
--   $$\mathcal Q = \{q' \in \Delta^N : q'_i = q_{\sigma(i)},\ \sigma \in S(N)\},$$
--   that is,
--   $$\mu_q(X) = \sup_{\sigma \in S(N)} \Big(-\sum_{i=1}^N q_{\sigma(i)} X_i\Big) \qquad \text{for all } X \in \mathbb R^N.$$
--
--   By Theorem 2.1 this shows that $\mu_q$ is a coherent risk measure, the first step of the "if" direction of Theorem 4.2; it also identifies the uncertainty set of $\mu_q$ in Theorem 3.1 as the $q$-permutohull.
--
--   **Formalization Note** The family is the range of $\sigma \mapsto q \circ \sigma$ over `Equiv.Perm (Fin N)`, and the supremum is `IsLUB` (`Generates`). Order statistics are `X ∘ Tuple.sort X`. Indices are 0-based.
-- source:
--   Bertsimas & Brown, Constructing uncertainty sets for robust linear optimization, Oper. Res. 57(6) (2009), p. 1489, proof of Theorem 4.2, first paragraph

import Mathlib
import Definitions.Def_RiskUncSets_Distortion_Setting

namespace RiskUncSets.Distortion

theorem muQ_generates {N : ℕ} (hN : 0 < N) (q : Fin N → ℝ) (hq : q ∈ restrictedSimplex N) :
    Generates (Set.range fun σ : Equiv.Perm (Fin N) => q ∘ σ) (muQ q) := by sorry

end RiskUncSets.Distortion
