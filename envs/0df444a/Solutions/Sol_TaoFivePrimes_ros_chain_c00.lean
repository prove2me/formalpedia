theorem check_u001 : grpOK gu001 = true := by decide +kernel

theorem wf_u001 : grpWF gu001 = true := by decide

theorem sol_u001 (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu001.lin : ℝ) ≤ (S : ℝ) * logProd gu001.lo) :
    (gu001.lfin : ℝ) ≤ (S : ℝ) * logProd gu001.top ∧
      (∀ x : ℝ, (gu001.lo : ℝ) < x → x ≤ (gu001.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) :=
  grp_solution gu001 check_u001 wf_u001 hγ hstate



theorem child00_solution (hγ : Real.eulerMascheroniConstant < (gammaUpS : ℝ) / (S : ℝ))
    (hstate : (gu000.lin : ℝ) ≤ (S : ℝ) * logProd gu000.lo) :
    (gu001.lfin : ℝ) ≤ (S : ℝ) * logProd gu001.top ∧
      (∀ x : ℝ, (gu000.lo : ℝ) < x → x ≤ (gu001.top : ℝ) →
        Real.exp Real.eulerMascheroniConstant * Real.log x < eulerProduct ⌊x⌋₊) := by
  have s0 := sol_u000 hγ hstate
  have s1 := sol_u001 hγ (by simpa [gu000, gu001] using s0.1)
  refine ⟨s1.1, ?_⟩
  intro x hx htop
  by_cases h0 : x ≤ (gu000.top : ℝ)
  · exact s0.2 x hx h0
  · have hx1 : (gu001.lo : ℝ) < x := by
        have hb : (gu000.top : ℝ) = (gu001.lo : ℝ) := by simp [gu000, gu001]
        linarith
    exact s1.2 x hx1 htop

