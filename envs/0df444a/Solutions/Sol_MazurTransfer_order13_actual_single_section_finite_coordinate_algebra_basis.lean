/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: linear independence of nonzero polynomials of distinct degrees.
Named downstream consumer: actual single-section finite-algebra basis.
-/

noncomputable section
namespace MazurTransfer.PolynomialDistinctDegree
open Polynomial
variable {R ι : Type*} [CommRing R] [IsDomain R]

theorem linearIndependent_of_injective_natDegree (v : ι → Polynomial R)
    (hn : ∀ i, v i ≠ 0) (hd : Function.Injective (fun i => (v i).natDegree)) :
    LinearIndependent R v := by
  classical
  apply linearIndependent_iff'.mpr
  intro s g hs i hi
  by_contra hgi
  let k : Finset ι := s.filter (fun j => g j ≠ 0)
  have hk : k.Nonempty := ⟨i, Finset.mem_filter.mpr ⟨hi,hgi⟩⟩
  obtain ⟨j,hj,hmax⟩ := k.exists_max_image (fun j => (v j).natDegree) hk
  obtain ⟨hjs,hgj⟩ := Finset.mem_filter.mp hj
  have hcoeff : (∑ l ∈ s, g l • v l).coeff (v j).natDegree =
      g j * (v j).leadingCoeff := by
    rw [finsetSum_coeff]
    apply Finset.sum_eq_single j
    · intro l hls hlj
      by_cases hgl : g l = 0
      · simp [hgl]
      · have hlk : l ∈ k := Finset.mem_filter.mpr ⟨hls,hgl⟩
        have hlt : (v l).natDegree < (v j).natDegree :=
          lt_of_le_of_ne (hmax l hlk) (fun he => hlj (hd he))
        rw [coeff_smul, coeff_eq_zero_of_natDegree_lt hlt, smul_zero]
    · exact fun h => (h hjs).elim
  have hz : g j * (v j).leadingCoeff = 0 := by rw [← hcoeff, hs, coeff_zero]
  exact (mul_ne_zero hgj (leadingCoeff_ne_zero.mpr (hn j))) hz

end MazurTransfer.PolynomialDistinctDegree
#print axioms MazurTransfer.PolynomialDistinctDegree.linearIndependent_of_injective_natDegree

end
end

section
/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: independence of actual parameter-polynomial combinations
of 1,p,q over an integral base where two is nonzero.
Named downstream consumer: the actual R[T]-basis of the finite subalgebra.
The canonical R-scalar structure is used; polynomial actions are explicit.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence
open Polynomial
open MazurTorsion.XOneThirteenAffineCurve
open Order13SingleSectionFiniteMapIdentities
open Order13SingleSectionWeightedPolynomialCoordinates
variable (R : Type u) [CommRing R] [IsDomain R]

def generator : Fin 3 → CoordinateRing R :=
  fun i => if i = 0 then 1 else if i = 1 then p R else q R

omit [IsDomain R] in
theorem weightedPowers_eq (i : Fin 3) (n : ℕ) :
    weightedPowers R (i,n) = generator R i * t R ^ n := by
  fin_cases i <;> simp [weightedPowers,generator]

theorem weightedPowers_linearIndependent (h2 : (2 : R) ≠ 0) :
    LinearIndependent R (weightedPowers R) := by
  apply LinearIndependent.of_comp (firstComponent R)
  apply PolynomialDistinctDegree.linearIndependent_of_injective_natDegree
  · exact weighted_first_nonzero R h2
  · intro i j hij
    apply weight_injective
    simpa only [Function.comp_apply, weighted_first_degree R h2] using hij

theorem polynomial_combination_expansion (F : Fin 3 → Polynomial R) (N : ℕ)
    (hN : ∀ i, (F i).natDegree < N) :
    (∑ i, aeval (t R) (F i) * generator R i) =
      ∑ k ∈ ((Finset.univ : Finset (Fin 3)) ×ˢ Finset.range N),
        (F k.1).coeff k.2 • weightedPowers R k := by
  rw [Finset.sum_product (Finset.univ : Finset (Fin 3)) (Finset.range N)
    (fun k => (F k.1).coeff k.2 • weightedPowers R k)]
  apply Finset.sum_congr rfl
  intro i hi
  rw [aeval_eq_sum_range' (hN i) (t R), Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro n hn
  rw [weightedPowers_eq]
  simp only [Algebra.smul_def]
  ring

theorem polynomial_combination_kernel (h2 : (2 : R) ≠ 0)
    (F : Fin 3 → Polynomial R)
    (hF : ∑ i, aeval (t R) (F i) * generator R i = 0) : ∀ i, F i = 0 := by
  classical
  let N : ℕ := (Finset.univ.image (fun i => (F i).natDegree)).max' (by simp) + 1
  have hN : ∀ i, (F i).natDegree < N := by
    intro i
    exact Nat.lt_succ_of_le (Finset.le_max' _ _ (by simp))
  have hs : ∑ k ∈ ((Finset.univ : Finset (Fin 3)) ×ˢ Finset.range N),
      (F k.1).coeff k.2 • weightedPowers R k = 0 := by
    rw [← polynomial_combination_expansion R F N hN]
    exact hF
  have hcoeff := (linearIndependent_iff'.mp (weightedPowers_linearIndependent R h2))
    (((Finset.univ : Finset (Fin 3)) ×ˢ Finset.range N)) (fun k => (F k.1).coeff k.2) hs
  intro i
  apply Polynomial.ext
  intro n
  by_cases hn : n < N
  · simpa using hcoeff (i,n) (by simp [hn])
  · rw [coeff_eq_zero_of_natDegree_lt (by have := hN i; omega), coeff_zero]

end MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence
#print axioms MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence.polynomial_combination_kernel

end
end

section
/-
Copyright (c) 2026 Vas and contributors. Released under Apache-2.0.
Design boundary: the actual finite subalgebra has the explicit R[T]-basis
1,p,q over an integral base where two is a unit. Named downstream consumer:
finite free level sets in single-section FiniteMapData.
The parameter T acts by t. The exact affine-open identification remains separate.
-/

noncomputable section
universe u
namespace MazurTransfer.Order13SingleSectionFiniteAlgebra
open Polynomial Module
open MazurTorsion.XOneThirteenAffineCurve
open Order13SingleSectionFiniteMapIdentities
open Order13SingleSectionPolynomialCombinationIndependence
variable (R : Type u) [CommRing R] [IsDomain R]

theorem generator_linearIndependent (h2 : IsUnit (2 : R)) :
    LinearIndependent (Polynomial R) (generator R) := by
  apply Fintype.linearIndependent_iff.mpr
  intro F hF
  apply polynomial_combination_kernel R h2.ne_zero F
  simpa only [Algebra.smul_def,parameter_algebraMap] using hF

omit [IsDomain R] in
theorem generator_range : Set.range (generator R) = generators R := by
  ext z
  constructor
  · rintro ⟨i,rfl⟩
    fin_cases i <;> simp [generator,generators]
  · intro hz
    simp only [generators,Set.mem_insert_iff,Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact ⟨0,by simp [generator]⟩
    · exact ⟨1,by simp [generator]⟩
    · exact ⟨2,by simp [generator]⟩

noncomputable def candidateBasis (h2 : IsUnit (2 : R)) :
    Basis (Fin 3) (Polynomial R) (candidateAlgebra R) := by
  change Basis (Fin 3) (Polynomial R) (candidateAlgebra R).toSubmodule
  exact (Basis.span (generator_linearIndependent R h2)).map
    (LinearEquiv.ofEq _ _ (by
      rw [generator_range]
      exact (candidateAlgebra_eq_span R h2).symm))

theorem candidateBasis_value (h2 : IsUnit (2 : R)) (i : Fin 3) :
    (candidateBasis R h2 i : CoordinateRing R) = generator R i := by
  simp [candidateBasis]

theorem candidateAlgebra_free (h2 : IsUnit (2 : R)) :
    Module.Free (Polynomial R) (candidateAlgebra R) := Module.Free.of_basis (candidateBasis R h2)

theorem candidateAlgebra_finrank (h2 : IsUnit (2 : R)) :
    Module.finrank (Polynomial R) (candidateAlgebra R) = 3 := by
  simpa using Module.finrank_eq_card_basis (candidateBasis R h2)

end MazurTransfer.Order13SingleSectionFiniteAlgebra
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.generator_linearIndependent
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis_value
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_free
#print axioms MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_finrank

end
end

end SingleSectionFiniteBasisPublicProof

theorem solution.{u}
    (R : Type u) [CommRing R] [IsDomain R] (h2 : IsUnit (2 : R)) :
    let τ : CoordinateRing R := yCoordinate R + (xCoordinate R ^ 3 + xCoordinate R ^ 2 + 1)
    let μ : CoordinateRing R := xCoordinate R * τ
    let ν : CoordinateRing R := xCoordinate R * (μ + 2)
    let α : Algebra (Polynomial R) (CoordinateRing R) := (aeval τ).toRingHom.toAlgebra
    letI : Algebra (Polynomial R) (CoordinateRing R) := α
    letI : SMul (Polynomial R) (CoordinateRing R) := α.toSMul
    letI : Module (Polynomial R) (CoordinateRing R) :=
      @Algebra.toModule (Polynomial R) (CoordinateRing R) _ _ α
    ∃ B : Subalgebra (Polynomial R) (CoordinateRing R),
      B = Algebra.adjoin (Polynomial R) ({μ, ν} : Set (CoordinateRing R)) ∧
      B.toSubmodule = Submodule.span (Polynomial R) ({1, μ, ν} : Set (CoordinateRing R)) ∧
      Module.Finite (Polynomial R) B ∧
      Module.Free (Polynomial R) B ∧ Module.finrank (Polynomial R) B = 3 ∧
      ∃ b : Module.Basis (Fin 3) (Polynomial R) B,
        (b 0 : CoordinateRing R) = 1 ∧ (b 1 : CoordinateRing R) = μ ∧
          (b 2 : CoordinateRing R) = ν := by
  dsimp only
  refine ⟨SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra R,
    rfl, ?_, ?_, ?_, ?_, ?_⟩
  · exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_eq_span R h2
  · exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_finite R h2
  · exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_free R h2
  · exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateAlgebra_finrank R h2
  · refine ⟨SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis R h2, ?_, ?_, ?_⟩
    · change (SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis R h2 0 : CoordinateRing R) = SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence.generator R 0
      exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis_value R h2 0
    · change (SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis R h2 1 : CoordinateRing R) = SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence.generator R 1
      exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis_value R h2 1
    · change (SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis R h2 2 : CoordinateRing R) = SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionPolynomialCombinationIndependence.generator R 2
      exact SingleSectionFiniteBasisPublicProof.MazurTransfer.Order13SingleSectionFiniteAlgebra.candidateBasis_value R h2 2

#print axioms solution
