theorem multipliesAt_mono' {M : IntMul.MultitapeTM} {n : ℕ} {T T' : ℝ}
    (h : IntMul.MultipliesAt M n T) (hT : T ≤ T') : IntMul.MultipliesAt M n T' := by
  intro x y hx hy
  obtain ⟨t, ht, hh⟩ := h x y hx hy
  exact ⟨t, ht.trans hT, hh⟩

/-- **§9.8, final theorem (reduction to the machine)**.  Suppose a multitape machine `M`
multiplies correctly for every `n ≥ 1`, and for `n ≥ n₀` its running time is at most
`C₀ (V(n) · Ncost(p, d, K, ℓ, α) + n)` where `V(n) ≤ 48 n` (the bit volume `T p`),
`p = 6 lg n`, and the parameters obey the pointwise bounds of §9.2.1.  Then
`KappaBound (2⁻¹⁸²)`: multiplication in time `O(n (lg n)^{1-κ})`. -/
theorem kappaBound_of_table (M : IntMul.MultitapeTM)
    (hcorr : ∀ n : ℕ, 1 ≤ n → ∃ T : ℝ, IntMul.MultipliesAt M n T)
    (n₀ : ℕ) (C₀ : ℝ) (hC₀ : 0 ≤ C₀) (V d K ℓ α : ℕ → ℝ)
    (hV : ∀ n, n₀ ≤ n → V n ≤ 48 * n) (hV0 : ∀ n, n₀ ≤ n → 0 ≤ V n)
    (hd1 : ∀ n, n₀ ≤ n → (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε / 12 ≤ d n)
    (hd2 : ∀ n, n₀ ≤ n → d n ≤ (6 * (IntMul.lg n : ℝ)) ^ IntMul.OpenAI.RCost.ε)
    (hK1 : ∀ n, n₀ ≤ n → (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c) / 24 ≤ K n)
    (hK2 : ∀ n, n₀ ≤ n → K n ≤ (6 * (IntMul.lg n : ℝ)) ^ (IntMul.OpenAI.RCost.ε * c))
    (hℓ0 : ∀ n, n₀ ≤ n → 0 ≤ ℓ n) (hℓ : ∀ n, n₀ ≤ n → ℓ n ≤ 6 * (IntMul.lg n : ℝ) / (3 * d n))
    (hα0 : ∀ n, n₀ ≤ n → 0 ≤ α n)
    (hα : ∀ n, n₀ ≤ n → α n ≤ 4 * (6 * (IntMul.lg n : ℝ)) ^ (1 / 4 + IntMul.OpenAI.RCost.ε / 2))
    (htime : ∀ n, n₀ ≤ n → IntMul.MultipliesAt M n
      (C₀ * (V n * Ncost (6 * (IntMul.lg n : ℝ)) (d n) (K n) (ℓ n) (α n) + n))) :
    IntMul.KappaBound (1 / 2 ^ 182) := by
  refine ⟨M, hcorr, C₀ * (48 * 50 * 6 + 1) + 1, by positivity, n₀, fun n hn _ => ?_⟩
  apply multipliesAt_mono' (htime n hn)
  have hL : (1 : ℝ) ≤ (IntMul.lg n : ℝ) := by
    have : 1 ≤ IntMul.lg n := le_max_right _ _
    exact_mod_cast this
  set L : ℝ := (IntMul.lg n : ℝ)
  have hp : (1 : ℝ) ≤ 6 * L := by linarith
  have hN := Ncost_le (6 * L) (d n) (K n) (ℓ n) (α n) hp (hd1 n hn) (hd2 n hn) (hK1 n hn)
    (hK2 n hn) (hℓ0 n hn) (hℓ n hn) (hα0 n hn) (hα n hn)
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg n
  -- (6L)^{es} ≤ 6 L^{1-κ}
  have hes : (6 * L) ^ es ≤ 6 * L ^ (1 - 1 / 2 ^ 182 : ℝ) := by
    rw [Real.mul_rpow (by norm_num) (by linarith)]
    have h6 : (6 : ℝ) ^ es ≤ 6 := by
      calc (6 : ℝ) ^ es ≤ 6 ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by unfold es κ; norm_num)
        _ = 6 := Real.rpow_one 6
    have hLe : L ^ es ≤ L ^ (1 - 1 / 2 ^ 182 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le hL (by unfold es κ; norm_num)
    have : 0 ≤ L ^ es := Real.rpow_nonneg (by linarith) _
    nlinarith
  have hLk : 1 ≤ L ^ (1 - 1 / 2 ^ 182 : ℝ) := Real.one_le_rpow hL (by norm_num)
  have hNn : 0 ≤ Ncost (6 * L) (d n) (K n) (ℓ n) (α n) ∨ True := Or.inr trivial
  clear hNn
  have hVN : V n * Ncost (6 * L) (d n) (K n) (ℓ n) (α n) ≤
