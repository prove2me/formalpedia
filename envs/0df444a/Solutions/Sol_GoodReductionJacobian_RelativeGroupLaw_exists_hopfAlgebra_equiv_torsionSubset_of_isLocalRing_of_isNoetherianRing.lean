variable {S : Type} [CommRing S] {A : Scheme.{0}} {f : A ⟶ Spec (CommRingCat.of S)}
  (L : RelativeGroupLaw S f) {R : Type} [CommRing R]
  (ι : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of S))

theorem toBase_nsmul {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (n : ℕ)
    (x : SchemeHomOver t' (baseChangeStr ι f)) :
    baseChangePointToBase ι ((L.baseChange ι).nsmul t' n x) = L.nsmul (t' ≫ ι) n (baseChangePointToBase ι x) := by
  induction n with
  | zero =>
      show baseChangePointToBase ι ((L.baseChange ι).one t') = L.one (t' ≫ ι)
      rw [baseChange_one, baseChangePointToBase_ofBase]
  | succ n ih =>
      rw [nsmul_succ, nsmul_succ, baseChangePointToBase_mul, ih]

theorem isTorsionPoint_baseChange_iff {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (n : ℕ)
    (x : SchemeHomOver t' (baseChangeStr ι f)) :
    (L.baseChange ι).IsTorsionPoint t' n x ↔ L.IsTorsionPoint (t' ≫ ι) n (baseChangePointToBase ι x) := by
  rw [isTorsionPoint_def, isTorsionPoint_def, ← toBase_nsmul]
  constructor
  · intro h; rw [h, baseChange_one, baseChangePointToBase_ofBase]
  · intro h
    apply (baseChangePointEquiv ι t').injective
    show baseChangePointToBase ι _ = baseChangePointToBase ι _
    rw [h, baseChange_one, baseChangePointToBase_ofBase]

noncomputable def torsionEquiv {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (n : ℕ) :
    ↥((L.baseChange ι).torsionSubset t' n) ≃ ↥(L.torsionSubset (t' ≫ ι) n) :=
  (baseChangePointEquiv ι t').subtypeEquiv (fun x => isTorsionPoint_baseChange_iff L ι t' n x)

@[scoped simp] theorem torsionEquiv_val {T : Scheme.{0}} (t' : T ⟶ Spec (CommRingCat.of R)) (n : ℕ)
    (x : ↥((L.baseChange ι).torsionSubset t' n)) :
    ((torsionEquiv L ι t' n x) : SchemeHomOver (t' ≫ ι) f) = baseChangePointToBase ι x.val := rfl

end TorsHopfLocal
