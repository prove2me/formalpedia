open OAI OAI.Cotype
open scoped BigOperators
open Polynomial Polynomial.Chebyshev

theorem OAI.Cotype.chebyshevTruncation_bound {n : ℕ} (c : Fin (n+1) → ℝ) (d : ℕ)
    {M : ℝ} (hM : 0 ≤ M)
    (hQ : ∀ x ∈ Set.Icc (-1) 1, |(chebyshevExpansion c).eval x| ≤ M)
    {x : ℝ} (hx : x ∈ Set.Icc (-1) 1) :
    |(chebyshevTruncation c d).eval x| ≤ 2*M*(d+1) := by sorry
