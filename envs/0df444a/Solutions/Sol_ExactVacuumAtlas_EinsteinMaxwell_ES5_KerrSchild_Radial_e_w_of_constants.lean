open ExactVacuumAtlas.EinsteinMaxwell.ES5.KerrSchild.Radial
variable {I : Set ℝ} {f m N w p a : ℝ → ℝ} {r : ℝ}
theorem solution (hP : PaperData I f m N w p a) (hr : r ∈ I) {Q J : ℝ}
    (hq : qFun f N w p a r = -Q) (hl : ellFun f m N w p a r = -2 * J) :
    eFun w p a r = -Q * f r / N r ∧
      deriv w r = -2 * (J + 2 * Q * a r) * f r * m r / N r ^ 2 := by
  have hf := hP.nf r hr; have hm := hP.nm r hr; have hN := hP.nN r hr
  have he : eFun w p a r = -Q * f r / N r := by
    rw [eq_div_iff hN, ← (show N r / f r * eFun w p a r = -Q from hq)]
    field_simp
  have h1 : N r ^ 2 / (f r * m r) * deriv w r = -2 * J - 4 * Q * a r := by
    have h := hl
    simp only [ellFun, Kfun] at h
    rw [hq] at h
    linear_combination h
  have hK : N r ^ 2 / (f r * m r) * (f r * m r) = N r ^ 2 := div_mul_cancel₀ _ (mul_ne_zero hf hm)
  refine ⟨he, ?_⟩
  rw [eq_div_iff (pow_ne_zero 2 hN)]
  linear_combination (f r * m r) * h1 - deriv w r * hK
