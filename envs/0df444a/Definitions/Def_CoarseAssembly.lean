namespace CoarseAssembly.Rips

open Topology

variable {X Y : Type*} [PseudoMetricSpace X] [PseudoMetricSpace Y]
  {r : ℝ}

def mapPoint (e : X ↪ Y) (he : ∀ x y, dist (e x) (e y) ≤ dist x y)
    (p : Point X r) : Point Y r where
  weight := p.weight.embDomain e
  nonneg y := by
    classical
    by_cases hy : y ∈ Set.range e
    · obtain ⟨x, rfl⟩ := hy
      simpa using p.nonneg x
    · rw [Finsupp.embDomain_of_notMem_range e p.weight y hy]
  total := by simpa only [Finsupp.sum_embDomain] using p.total
  diameter x hx y hy := by
    rw [Finsupp.support_embDomain, Finset.mem_map] at hx hy
    obtain ⟨u, hu, rfl⟩ := hx
    obtain ⟨v, hv, rfl⟩ := hy
    exact (he u v).trans (p.diameter u hu v hv)

def unmapPoint (e : X ↪ Y) (he : Isometry e) (q : Point Y r)
    (hq : ↑q.weight.support ⊆ Set.range e) : Point X r where
  weight := q.weight.comapDomain e e.injective.injOn
  nonneg x := by simpa only [Finsupp.comapDomain_apply] using q.nonneg (e x)
  total := by
    have hm := Finsupp.embDomain_comapDomain hq
    have hs := congrArg (fun f : Y →₀ ℝ => f.sum (fun _ t => t)) hm
    simpa only [Finsupp.sum_embDomain, q.total] using hs
  diameter x hx y hy := by
    rw [← he.dist_eq]
    exact q.diameter (e x)
      (by simpa only [Finsupp.mem_support_iff, Finsupp.comapDomain_apply] using hx) (e y)
      (by simpa only [Finsupp.mem_support_iff, Finsupp.comapDomain_apply] using hy)

end CoarseAssembly.Rips

end
