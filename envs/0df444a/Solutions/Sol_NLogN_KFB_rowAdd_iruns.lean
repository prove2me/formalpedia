-- Source module: Solutions.KFBGate
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace NLogN.KFB

open IntMul RS AModel KIL KFD Complex

theorem getD_segApply (off : ℕ) (Ms : List M2G) (B1 G : ℕ) (zs : List GI)
    (h : off + G * (2 * B1 * Ms.length) ≤ zs.length) (i : ℕ) :
    (segApply off Ms B1 G zs).getD i 0 =
      if off ≤ i ∧ i < off + G * (2 * B1 * Ms.length) then
        pent (Ms.getD ((i - off) % (2 * B1 * Ms.length) / (2 * B1)) M0) B1 (zs.drop off) (i - off)
      else zs.getD i 0 := by
  have hl := length_qopL Ms B1 G (zs.drop off) (by simp; omega)
  have ht : (zs.take off).length = off := by simp; omega
  unfold segApply
  by_cases h1 : i < off
  · rw [if_neg (by omega), List.getD_append _ _ _ _ (by omega), getD_take' _ _ _ h1]
  rw [List.getD_append_right _ _ _ _ (by omega), ht]
  by_cases h2 : i < off + G * (2 * B1 * Ms.length)
  · rw [if_pos ⟨by omega, h2⟩, List.getD_append _ _ _ _ (by omega),
      getD_qopL Ms B1 _ G (by simp; omega) _ (by omega)]
  · rw [if_neg (by omega), List.getD_append_right _ _ _ _ (by omega), hl, NLogN.KFB.getD_drop', NLogN.KFB.getD_drop']
    congr 1; omega

/-- One pass on a clean managed state. -/
theorem pass_fsp (s : IState HS) (w B1 G off : ℕ) (Ms : List M2G) (hM : ∀ M ∈ Ms, M.Ok)
    (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ)
    (hlen : off + G * (2 * B1 * Ms.length) ≤ zs.length) (h0 : f 0 = gflat zs ++ l)
    (hC : Cl f) (hb : NLogN.KFB.GB w zs) (Z : ℕ)
    (hZ : zsz (((4 * (B1 + G + G * (2 * B1 * Ms.length) + off)) : ℕ) : ℤ) ≤ Z) :
    FSp (qopW Ms B1 G off) (encK s f)
      (encK s (Function.update f 0 (gflat (segApply off Ms B1 G zs) ++ l)))
      (cQopW w B1 Ms.length G off Z) :=
  qopW_fsp s w B1 G off Ms hM f (zs.take off) (zs.drop off) l (by simp; omega)
    (by simp; omega) (by rw [List.take_append_drop]; exact h0) hC
    (by rw [List.take_append_drop]; exact hb) Z hZ

theorem GB_getD_all {w : ℕ} {zs : List GI} (h : NLogN.KFB.GB w zs) (j : ℕ) :
    zsz (zs.getD j 0).1 ≤ w ∧ zsz (zs.getD j 0).2 ≤ w := by
  by_cases hj : j < zs.length
  · exact (GB_getD.1 h) j hj
  · rw [List.getD_eq_default _ _ (by omega)]
    exact ⟨by simp [zsz_zero], by simp [zsz_zero]⟩

theorem swM_ok : swM.Ok := ⟨Sm_zero, Sm_ipw 0, Sm_ipw 0, Sm_zero⟩

theorem rep_congr {W m n : ℕ} {zs : List GI} {x y : Fin W × (Fin m × Fin n → Fin 2) → ℂ}
    (h : Rep zs x) (e : x = y) : Rep zs y := e ▸ h

theorem cPass_mono {w N off off' Z Z' : ℕ} (h1 : off ≤ off') (h2 : Z ≤ Z') :
    NLogN.KFB.cPass w N off Z ≤ NLogN.KFB.cPass w N off' Z' := by
  unfold NLogN.KFB.cPass
  have : 4 * off * (250 * w + 2600) ≤ 4 * off' * (250 * w + 2600) :=
    Nat.mul_le_mul_right _ (by omega)
  nlinarith

end NLogN.KFB

