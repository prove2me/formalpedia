lemma d_le_b {n : ℕ} (hn : IntMul.OpenAI.Glue.n0 ≤ n) : IntMul.OpenAI.R129.dP n ≤ bP n := by
  have hb1 : (1 : ℝ) ≤ bP n := by exact_mod_cast bP_pos n
  have : (IntMul.OpenAI.R129.dP n : ℝ) ≤ bP n := (d_le_beps n).trans (by
