  secD (chEt c (locF (B := CommRingCat.of k[X]) G)) (opnDg c G) (fun _ hx => hx) ≫
    prdMapR (chEt c (locF (B := CommRingCat.of k[X]) G)) (opEtMap hle)

/-- The map `m : D₂ ×_P U₀ ⟶ D_G ×_P U₀` of `uk_diff`. -/
def mG (D₂ : P.Etale) (hD₂ : ∀ v : (prd D₂ (opEt Uo)).left, (prd D₂ (opEt Uo)).hom v ∈ opnDg c G) :
    prd D₂ (opEt Uo) ⟶ prd (chEt c (locF (B := CommRingCat.of k[X]) G)) (opEt Uo) :=
  toOpEt (prd D₂ (opEt Uo)) (opnDg c G) hD₂ ≫ sigG c hle

