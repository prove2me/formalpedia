section
-- Source module: Solutions.KFURot
/-!
# KFU §7: one prefix-controlled cyclic shift with a linear offset table

`rotStep Q P B ac`: generate the offset table `tbl Q ac` (KIL2 `genP`, register code), push
`P, Q, B`, run KFC `rotF`, pop.  For the shape `A ++ Q :: C` and coefficients `cs` (one per
field of `A`), `rotStep_spec` computes the full-shape pull by

  `rotG |A| Q f b = b.take |A| ++ ((b_{|A|} + Q - f (b.take |A|)) mod Q) :: b.drop (|A|+1)`,
  `f a = (Σ_k cs_k a_k) mod Q`,

i.e. the entry at address `a` moves to the address whose `|A|`-th digit is
`(a_{|A|} + Σ_k cs_k a_k) mod Q` (the controls `a_k`, `k < |A|`, are the outer fields).
Cost `cRotF (vol A) Q (vol C) w + 4·10^5 (|A|+1) vol A (Bb+2) + O(Bb)`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

theorem pull_rotG {α : Type*} (A C : Shape) (Q : ℕ) (as : ℕ → ℕ) (d : α) (xs : List α) :
    pull (A ++ Q :: C) (A ++ Q :: C) (rotG A.length Q (fun a => as (encode A a))) d xs =
      pull [vol A, Q, vol C] [vol A, Q, vol C] (KIL.rotAddr Q as) d xs := by
  have hv : vol (A ++ Q :: C) = vol [vol A, Q, vol C] := by
    rw [vol_append, vol_cons]; simp [vol]
  apply List.ext_getElem (by rw [length_pull, length_pull, hv])
  intro j h1 h2
  simp only [length_pull] at h1 h2
  rw [getElem_pull, getElem_pull]
  congr 1
  have hval := valid_decode h2
  obtain ⟨p, y, b, hdec, hp, hy, hb⟩ : ∃ p y b, decode [vol A, Q, vol C] j = [p, y, b] ∧
      p < vol A ∧ y < Q ∧ b < vol C := by
    generalize decode [vol A, Q, vol C] j = D at hval
    rcases hval with _ | ⟨hp, _ | ⟨hy, _ | ⟨hb, h⟩⟩⟩
    cases h
    exact ⟨_, _, _, rfl, hp, hy, hb⟩
  have hj : j = (p * Q + y) * vol C + b := by
    rw [← encode_decode h2, hdec]; simp [encode, vol]; ring
  have hlA : (decode A p).length = A.length := length_decode _ _
  have hDv : Valid (A ++ Q :: C) (decode A p ++ y :: decode C b) :=
    valid_append (valid_decode hp) (List.Forall₂.cons hy (valid_decode hb))
  have henc : ∀ w, encode (A ++ Q :: C) (decode A p ++ w :: decode C b) = (p * Q + w) * vol C + b := by
    intro w
    rw [encode_append_len _ _ hlA, encode_decode hp]
    simp only [encode, List.headD_cons, List.tail_cons, encode_decode hb, vol_cons]; ring
  have hdD : decode (A ++ Q :: C) j = decode A p ++ y :: decode C b := by
    rw [← decode_encode hDv, henc, hj]
  rw [hdD, hdec]
  have e1 : (decode A p ++ y :: decode C b).take A.length = decode A p := by
    rw [List.take_append_of_le_length (by omega), List.take_of_length_le (by omega)]
  have e2 : (decode A p ++ y :: decode C b).getD A.length 0 = y := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hlA]; simp
  have e3 : (decode A p ++ y :: decode C b).drop (A.length + 1) = decode C b := by
    rw [← hlA, List.drop_append]; simp
  simp only [rotG, e1, e2, e3, encode_decode hp, henc]
  simp [KIL.rotAddr, encode, vol]; ring

end NLogN.KFU

end

section
-- Source module: Solutions.KFUURot1
/-!
# KFUU §7a: register programs for the uniform shifts — helpers and the stage lists

The uniform prefix-controlled shift of target `i` (sizes `s_j = sF j`, coefficient list
`cs = cF neg sF μ Q`) computes the stage data of KIL4's uniform table generator at run time:

* `Pv sF j = ∏_{k<j} s_k`;
* `stgM_rev` / `stgAM_rev`: closed forms of the stage stacks `stgM`, `stgAM` of the
  stage list `(A.zip cs).reverse` (`A = [s_0, …, s_{i-1}]`): `P_i / P_{j+1}` and `P_i / P_j`;
* `encK_lift`: a stack prefix of the unmanaged part becomes managed.
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFUU

open IntMul KIL AModel

/-! ## Managed-state helpers -/

theorem encK_lift (s : IState HS) (f : Fin HS → List ℤ) (r : Fin HS) (L : List ℤ) (R : List Item)
    (h : s.G r = ints L ++ R) :
    encK s f = encK (s.upd r R) (Function.update f r (f r ++ L)) := by
  refine IState.ext' (fun j => ?_) rfl rfl
  by_cases hj : j = r
  · subst hj; simp [h, ints_append]
  · simp [hj]

/-! ## Prefix products and the stage lists -/

theorem Pv_succ (sF : ℕ → ℕ) (j : ℕ) : Pv sF (j + 1) = Pv sF j * sF j := by
  simp [Pv, List.range_succ, vol_append, vol]

theorem Pv_pos (sF : ℕ → ℕ) {i : ℕ} (hs : ∀ j < i, 1 ≤ sF j) : ∀ j ≤ i, 1 ≤ Pv sF j
  | 0, _ => by simp [Pv, vol]
  | j + 1, hj => by
    rw [Pv_succ]; exact Nat.mul_pos (Pv_pos sF hs j (by omega)) (hs j (by omega))

end NLogN.KFUU

end

