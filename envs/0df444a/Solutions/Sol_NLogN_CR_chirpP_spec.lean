theorem ChirpRegs.of_eq {q : Params} {w w' : IState HS}
    (h : ∀ i : Fin HS, i ∈ [hM2, hRr, hRh, hNa, hNb, hTT] → w'.G i = w.G i) (hw : ChirpRegs q w) :
