open OAI OAI.CirculantHadamard OAI.CirculantHadamard.CyclotomicLocalBase
universe uK uR uA
open IsLocalRing
variable {eta : ℂ} {L p : ℕ}
theorem solution (hp : p.Prime) (m : Ideal (Order eta)) [hm : m.IsMaximal]
    (hpm : (p : Order eta) ∈ m) : m.LiesOver (Ideal.span {(p : ℤ)}) := by
  constructor
  have hmax : (Ideal.span {(p : ℤ)}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible (Nat.prime_iff_prime_int.1 hp).irreducible
  apply hmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance)
  rw [Ideal.span_le, Set.singleton_subset_iff]
  show algebraMap ℤ (Order eta) (p : ℤ) ∈ m
  simpa using hpm
