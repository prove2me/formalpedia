-- title:
--   Level lowering by one power of p via Uₚ(gᵖ)
-- statement:
--   Let $p$ be a prime, let $M$ be a nonzero natural number with $p^2 \mid M$, let $k$ be an integer, and let $g$ be a cusp form of weight $k$ for $\Gamma_0(M)$ whose $q$-expansion coefficients at the cusp $\infty$ of width $1$, $\mathrm{qCoeff}\,g\,n :=$ the $n$-th coefficient of `qExpansion 1 g`, all lie in the integral closure $\bar{\mathbb{Z}}$ of $\mathbb{Z}$ in $\mathbb{C}$ (each is the image of some element of `integralClosure ℤ ℂ`). Then there exists a cusp form $F$ of weight $p\cdot k$ for $\Gamma_0(M/p)$ with the following four properties. First, as a function on the upper half-plane, $F$ equals $\mathrm{heckeU}\,(pk)\,p$ applied to the pointwise $p$-th power of $g$, that is $\sum_{j=0}^{p-1}(g^p)\mid_{pk}\begin{pmatrix}1&j\\0&p\end{pmatrix}$ with Mathlib's weight-$pk$ slash action. Second, every coefficient $\mathrm{qCoeff}\,F\,n$ lies in $\bar{\mathbb{Z}}$. Third, for every intermediate field $K$ of $\mathbb{C}/\mathbb{Q}$, if all $\mathrm{qCoeff}\,g\,n$ lie in $K$ then so do all $\mathrm{qCoeff}\,F\,n$. Fourth, for every $n$ and all $a, A \in \bar{\mathbb{Z}}$ with $a = \mathrm{qCoeff}\,g\,n$ and $A = \mathrm{qCoeff}\,F\,n$, the difference $A - a^p$ lies in the ideal generated by $p$ in $\bar{\mathbb{Z}}$.
--
--   This is the elementary step that removes one power of $p$ from the level: raising a cusp form to the $p$-th power and applying $U_p$ produces, modulo $p$, the coefficientwise Frobenius twist of the original form, at $p$ times the weight and at level $M/p$. It is used in [`CuspForm.exists_cuspForm_mul_ordCompl_qCoeff_congr_pow_of_sq_dvd`](thm.html#CuspForm.exists_cuspForm_mul_ordCompl_qCoeff_congr_pow_of_sq_dvd), which iterates the construction to reach level prime to (or only singly divisible by) $p$.
-- source:
--   https://github.com/anthropics/fermats-last-theorem/blob/aa2d8b34692b16c70f699536de0d8e75b9a3e9ef/Theorems/Thm_CuspForm_exists_coe_eq_heckeU_pow_and_qCoeff_sub_pow_mem_span.lean

import Definitions.Def_FLTPrelim_Modularity
import Definitions.Def_ModularForm_HeckeOperator

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false
open ModularFormClass

theorem CuspForm.exists_coe_eq_heckeU_pow_and_qCoeff_sub_pow_mem_span (p : ℕ) [Fact p.Prime] {M : ℕ} [NeZero M] (hpM : p ^ 2 ∣ M) (k : ℤ)
    (g : CuspForm (CongruenceSubgroup.Gamma0 M) k)
    (hgint : ∀ n : ℕ, ∃ a : integralClosure ℤ ℂ, (a : ℂ) = qCoeff g n) :
    ∃ F : CuspForm (CongruenceSubgroup.Gamma0 (M / p)) (p * k),
      ⇑F = ModularForm.heckeU (p * k) p ((⇑g) ^ p) ∧
      (∀ n : ℕ, ∃ A : integralClosure ℤ ℂ, (A : ℂ) = qCoeff F n) ∧
      (∀ K : IntermediateField ℚ ℂ, (∀ n : ℕ, qCoeff g n ∈ K) → ∀ n : ℕ, qCoeff F n ∈ K) ∧
      (∀ (n : ℕ) (a A : integralClosure ℤ ℂ), (a : ℂ) = qCoeff g n → (A : ℂ) = qCoeff F n →
        A - a ^ p ∈ Ideal.span {(p : integralClosure ℤ ℂ)}) := by sorry
