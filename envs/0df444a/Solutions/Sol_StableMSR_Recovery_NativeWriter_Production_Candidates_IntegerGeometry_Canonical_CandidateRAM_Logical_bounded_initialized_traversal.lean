    have bj:x.n^(b*E) ≤ x.n^((b+5)*E):=Nat.pow_le_pow_right hn (Nat.mul_le_mul_right E (by omega))
    have f:5 ≤ (b+5)*E := (Nat.le_mul_of_pos_right 5 hE).trans (Nat.mul_le_mul_right E (by omega))
