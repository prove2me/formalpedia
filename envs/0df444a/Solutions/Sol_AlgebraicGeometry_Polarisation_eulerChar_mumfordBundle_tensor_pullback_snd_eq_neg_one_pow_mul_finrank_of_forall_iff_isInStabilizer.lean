theorem perPointAlg
    (R : Type) [CommRing R] [IsNoetherianRing R] [IsLocalRing R] (g : ℕ)
    (Kc : ℕ → Type) [∀ i, AddCommGroup (Kc i)] [∀ i, Module R (Kc i)]
    [∀ i, Module.Finite R (Kc i)] [∀ i, Module.Free R (Kc i)]
    (hbdd : ∀ i, g < i → Subsingleton (Kc i))
    (δ : ∀ i, Kc i →ₗ[R] Kc (i + 1)) (hdd : ∀ i, δ (i + 1) ∘ₗ δ i = 0)
    (H0M : Type) [AddCommGroup H0M] [Module R H0M]
    (HSM : ℕ → Type) [∀ i, AddCommGroup (HSM i)] [∀ i, Module R (HSM i)]
    (e0 : LinearMap.ker (δ 0) ≃ₗ[R] H0M)
    (heS : ∀ i : ℕ, Nonempty
      ((LinearMap.ker (δ (i + 1)) ⧸ (LinearMap.range (δ i)).comap (LinearMap.ker (δ (i + 1))).subtype) ≃ₗ[R] HSM i))
    (n : ℕ)
    (htors0 : ∀ a ∈ IsLocalRing.maximalIdeal R ^ n, ∀ z : LinearMap.ker (δ 0), a • z = 0)
    (htors : ∀ (i : ℕ), ∀ a ∈ IsLocalRing.maximalIdeal R ^ n,
      ∀ q : LinearMap.ker (δ (i + 1)) ⧸ (LinearMap.range (δ i)).comap (LinearMap.ker (δ (i + 1))).subtype, a • q = 0)
    (hF0 : ∃ rs : List R, Ideal.ofList rs = IsLocalRing.maximalIdeal R ∧ rs.length = g ∧
      RingTheory.Sequence.IsRegular R rs)
    (I : Ideal R) (hI : I ≤ IsLocalRing.maximalIdeal R) (hIN : ∃ N : ℕ, IsLocalRing.maximalIdeal R ^ N ≤ I)
    (hU : Module.finrank (R ⧸ IsLocalRing.maximalIdeal R)
      (LinearMap.ker ((δ 0).baseChange (R ⧸ IsLocalRing.maximalIdeal R))) = 1)
    (hW : ∀ (J' : Ideal R) (hJ' : J' ≤ IsLocalRing.maximalIdeal R), (∃ N : ℕ, IsLocalRing.maximalIdeal R ^ N ≤ J') →
      ((∀ z : (R ⧸ IsLocalRing.maximalIdeal R) ⊗[R] Kc 0, (δ 0).baseChange (R ⧸ IsLocalRing.maximalIdeal R) z = 0 →
          ∃ w : (R ⧸ J') ⊗[R] Kc 0, (δ 0).baseChange (R ⧸ J') w = 0 ∧
            LinearMap.rTensor (Kc 0) (Submodule.factor hJ') w = z) ↔ I ≤ J')) :
    ((Module.length R H0M).toNat : ℤ) +
        ∑ i ∈ Finset.range g, (-1) ^ (i + 1) * ((Module.length R (HSM i)).toNat : ℤ) =
      (-1) ^ g * ((Module.length R (R ⧸ I)).toNat : ℤ) := by
  classical
  obtain ⟨rs, hmax, hlen, hreg⟩ := hF0
  obtain ⟨N₁, hIN⟩ := hIN
  have eS := fun i => Classical.choice (heS i)
  have hle1 : IsLocalRing.maximalIdeal R ^ (n + N₁) ≤ IsLocalRing.maximalIdeal R ^ n :=
    Ideal.pow_le_pow_right (Nat.le_add_right n N₁)
  have hle2 : IsLocalRing.maximalIdeal R ^ (n + N₁) ≤ IsLocalRing.maximalIdeal R ^ N₁ :=
    Ideal.pow_le_pow_right (Nat.le_add_left N₁ n)
  have key := Module.toNat_length_ker_add_sum_neg_one_pow_toNat_length_eq_neg_one_pow_mul_toNat_length_quotient
    R g rs hreg hlen hmax Kc hbdd δ hdd (n + N₁)
    (fun a ha z => htors0 a (hle1 ha) z)
    (fun i a ha q => htors i a (hle1 ha) q)
    I hI (hle2.trans hIN) hU hW
  rw [e0.length_eq] at key
  rw [← key]
  congr 1
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [(eS i).length_eq]

theorem perPointGeo
    (K : Type) [Field K] [IsAlgClosed K] {A : Scheme.{0}} (f : A ⟶ Spec (CommRingCat.of K))
    (L : RelativeGroupLaw K f) (hc : L.IsCommutative) (hA : AbelianSchemePropertyBundle K f)
    (g : ℕ) [SmoothOfRelativeDimension g f]
    (M : A.Modules) (hM : Scheme.Modules.IsInvertible M)
    {KM : Scheme.{0}} (κ : KM ⟶ A) (hκ : IsClosedImmersion κ) (hfin : IsFinite (κ ≫ f))
    (hK : ∀ (R : Type) [CommRing R] (t : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of K)) (x : SchemeHomOver t f),
      (∃ x₀ : Spec (CommRingCat.of R) ⟶ KM, x₀ ≫ κ = x.1) ↔ L.IsInStabilizer M t x)
    (N : A.Modules) (hN : Scheme.Modules.IsInvertible N)
    (𝒦 : A.OrderedAffineCover) (h𝒦 : Fintype.card 𝒦.ι = g + 1)
    (y' : KM) (hy : IsClosed ({κ.base y'} : Set A)) :
    letI y : A := κ.base y'
    letI R : Type := ↥(A.presheaf.stalk y)
    letI bR : Spec (CommRingCat.of R) ⟶ A := A.fromSpecStalk y
    letI tR : Spec (CommRingCat.of R) ⟶ Spec (CommRingCat.of K) := bR ≫ f
    letI xR : SchemeHomOver tR f := ⟨bR, rfl⟩
    letI FR : (pullback f tR).Modules :=
      (Scheme.Modules.pullback (sliceAt f xR)).obj
        (mumfordBundle f L M ⊗ (Scheme.Modules.pullback (pullback.snd f f)).obj N)
    letI _ : IsAffineHom (pullback.fst f tR) := MorphismProperty.pullback_fst _ _ inferInstance
    letI 𝒦R : (pullback f tR).OrderedAffineCover := 𝒦.comap (pullback.fst f tR)
    letI G := OModulePresheaf.ofModules (pullback.snd f tR) FR
    (((Module.length R (G.H0 𝒦R)).toNat : ℤ) +
        ∑ i ∈ Finset.range g, (-1) ^ (i + 1) * ((Module.length R (G.HSucc 𝒦R i)).toNat : ℤ)) =
      (-1) ^ g * ((Module.length R (R ⧸ RingHom.ker (κ.stalkMap y').hom)).toNat : ℤ) := by
  classical
  have hD := exists_free_complex_cech_sliceAt_stalk_and_seesaw K f L hc hA g M hM κ hκ hfin hK N hN 𝒦 h𝒦 y'
  obtain ⟨Kc, _, _, _, _, hbdd, δ, hdd, hrest⟩ := hD
  obtain ⟨he0, heS, hI𝔪, hIN', hU, hW⟩ := hrest
  have e0 := Classical.choice he0
  have hT3 := exists_pow_maximalIdeal_smul_cech_sliceAt_stalk_eq_bot K f L hc hA g M hM κ hκ hfin hK N hN 𝒦 h𝒦 (κ.base y')
  obtain ⟨n, hn0, hnS⟩ := hT3
  haveI : Smooth f := SmoothOfRelativeDimension.smooth (n := g) (f := f)
  haveI hRL : IsRegularLocalRing (↥(A.presheaf.stalk (κ.base y'))) := Smooth.isRegularLocalRing_stalk (f := f) (κ.base y')
  haveI : IsNoetherianRing (↥(A.presheaf.stalk (κ.base y'))) := IsRegularLocalRing.toIsNoetherian
  exact perPointAlg _ g Kc hbdd δ hdd _ _ e0 heS n
