    have : ((e % K : ℕ) : ℤ) ≤ ((e - K * (F * (x + 1) - 1) : ℕ) : ℤ) := by exact_mod_cast hmod
    rw [Nat.cast_sub hE, Nat.cast_mul, Nat.cast_sub n2] at this; push_cast at this ⊢; exact this
  have hρ0 : (0 : ℤ) ≤ ((e % K : ℕ) : ℤ) := Nat.cast_nonneg _
