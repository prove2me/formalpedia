-- title:
--   Real Esscher drift normalisation gives full geometric renewal convolution density
-- statement:
--   If the finite renewal kernel κ is the Lebesgue-density measure of a nonnegative measurable real function K, and r≥0 is the real drift or Esscher normalisation, then the full geometric measure renewal sum weighted by (ofReal r)^(n+1) is exactly (ofReal r) times the initial Dirac atom and the density measure of the real convolution powers generated by r*K. The scaled-kernel equality is proved by the Proved real_nonnegative_scalar_withDensity lemma. The Proved geometric_renewal_from_scaled_kernel_real_density then supplies the full renewal measure identity. The conclusion is the correctly normalised finite BV Esscher renewal series required on the cstar_lt_top route.
-- source:
--   Canonical Proved real_nonnegative_scalar_withDensity and geometric_renewal_from_scaled_kernel_real_density.

import Mathlib.MeasureTheory.Measure.WithDensity
import Theorems.Thm_AvramDividend_Classical_real_nonnegative_scalar_withDensity
import Theorems.Thm_AvramDividend_Classical_geometric_renewal_from_scaled_kernel_real_density
open AvramDividend.Classical MeasureTheory
open scoped NNReal ENNReal

theorem AvramDividend.Classical.real_scaled_geometric_renewal_series_measure
    (r : ℝ) (hr : 0 ≤ r)
    (K : ℝ → ℝ) (hKpos : ∀ x : ℝ, 0 ≤ K x) (hKmeas : Measurable K)
    (F : ℕ → ℝ → ℝ) (m : ℕ → Measure ℝ)
    (hFpos : ∀ n : ℕ, ∀ x : ℝ, 0 ≤ F n x)
    (hFmeas : ∀ n : ℕ, Measurable (F n))
    (hconv : ∀ n : ℕ, ∀ x : ℝ,
      Integrable (fun y : ℝ => (r * K y) * F n (x - y)) volume)
    (hFsummable : ∀ x : ℝ,
      Summable (fun n : ℕ => if n = 0 then (0 : ℝ) else F (n - 1) x))
    (hFzero : F 0 = fun x : ℝ => r * K x)
    (hFsucc : ∀ n : ℕ, F (n + 1) =
      fun x : ℝ => ∫ y : ℝ, (r * K y) * F n (x - y) ∂volume)
    (κ : Measure ℝ) [SFinite κ]
    (hκdensity : κ = volume.withDensity
      (fun x : ℝ => ENNReal.ofReal (K x)))
    (hmzero : m 0 = Measure.dirac (0 : ℝ))
    (hmsucc : ∀ n : ℕ, m (n + 1) = κ.conv (m n))
    (hmsfinite : ∀ n : ℕ, SFinite (m n)) :
    Measure.sum (fun n : ℕ => (ENNReal.ofReal r) ^ (n + 1) • m n) =
      ENNReal.ofReal r • (Measure.dirac (0 : ℝ) +
        volume.withDensity (fun x : ℝ =>
          ENNReal.ofReal (∑' n : ℕ,
            if n = 0 then (0 : ℝ) else F (n - 1) x))) := by sorry
