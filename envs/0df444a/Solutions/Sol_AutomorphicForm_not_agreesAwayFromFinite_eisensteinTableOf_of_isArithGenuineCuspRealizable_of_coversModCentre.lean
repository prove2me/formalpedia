      IsIdeleClassChar (𝓞 M) M μ₁ → IsIdeleClassChar (𝓞 M) M μ₂ → Continuous μ₁ → Continuous μ₂ →
      ¬ Ψ.AgreesAwayFromFinite (eisensteinTableOf M Ψ.level Ψ.level_ne_bot μ₁ μ₂) := by
