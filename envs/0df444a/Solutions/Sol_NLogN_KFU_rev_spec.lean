-- Source module: Solutions.KFURevTop
set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace NLogN.KFU

open IntMul KFC AModel AModelL12

@[simp] theorem length_rv (r k : ℕ) (l : List ℕ) : (rv r k l).length = l.length := by simp [rv]

theorem rv_zero (r : ℕ) (l : List ℕ) : rv r 0 l = l :=
  permIdx_of_id (fun i _ => by unfold rIdx; split_ifs <;> omega)

theorem rv_step {r k : ℕ} {l : List ℕ} (hk : 2 * k + 2 ≤ r) (hr : r ≤ l.length) :
    swapPos k (r - 1 - k) (rv r (k + 1) l) = rv r k l := by
  rw [swapPos_eq_permIdx (by simp; omega) (by simp; omega), rv, permIdx_permIdx]
  · apply permIdx_congr
    intro i hi
    simp only [Function.comp_apply, rIdx, swapIdx]
    split_ifs <;> omega
  · intro i hi; unfold swapIdx; split_ifs <;> omega

theorem rv_half {r : ℕ} {l : List ℕ} (hr : r ≤ l.length) :
    rv r (r / 2) l = (l.take r).reverse ++ l.drop r := by
  apply List.ext_getElem (by simp; omega)
  intro i h1 h2
  simp only [rv, getElem_permIdx]
  by_cases hi : i < r
  · rw [List.getElem_append_left (by simp; omega), List.getElem_reverse, List.getElem_take]
    unfold rIdx
    rw [List.getD_eq_getElem _ _ (by split_ifs <;> omega)]
    congr 1; simp; split_ifs <;> omega
  · rw [List.getElem_append_right (by simp; omega), List.getElem_drop]
    unfold rIdx
    rw [if_neg (by omega), List.getD_eq_getElem _ _ (by simp at h1; omega)]
    congr 1; simp; omega

theorem map_rv (f : ℕ → ℕ) {r k : ℕ} {l : List ℕ} (hr : r ≤ l.length) (hk : k ≤ r) (c : ℕ)
    (hc : ∀ i < r, f (l.getD i 0) = c) : (rv r k l).map f = l.map f := by
  apply List.ext_getElem (by simp)
  intro i h1 h2
  simp only [List.getElem_map, rv, getElem_permIdx]
  have h2' : i < l.length := by simpa using h2
  by_cases hi : i < r
  · have h1 : f (l.getD (rIdx r k i) 0) = c := hc _ (by unfold rIdx; split_ifs <;> omega)
    rw [h1, ← hc i hi, List.getD_eq_getElem _ _ h2']
  · unfold rIdx; rw [if_neg (by omega), List.getD_eq_getElem _ _ h2']

theorem swC_spec {q' : ℕ} {K : ℝ} (hK : SwOK q' K) (hK0 : 0 ≤ K) (mz : ℕ → ℕ) (bg : ℕ → Bool)
    (hmz : ∀ j, 1 ≤ mz j) (u : ℕ) (hu : 1 ≤ u) (ax0 lay0 : List ℕ) (hnd : lay0.Nodup)
    (hF : Full bg ax0 lay0) (r : ℕ) (hr : r ≤ lay0.length)
    (hS : ∀ i < r, asz mz (lay0.getD i 0) = 2 ^ u) (w : ℕ) (xs0 : List ℤ) (hx : Bnd w xs0)
    (I : List Sym) (t : IState HS) (R : List Item)
    (h0 : t.G 0 = ints (Dl mz bg ax0 lay0 xs0 0) ++ R) :
    ∀ k, k ≤ r / 2 → (rv r k lay0).Nodup ∧ Full bg ax0 (rv r k lay0) ∧
      ∃ c : ℕ, IRuns I KFL.l12prog (swC q' w u (lay0.map (asz mz)) r k) t
        (t.upd 0 (ints (Dl mz bg ax0 (rv r k lay0) xs0 0) ++ R)) c ∧
        (c : ℝ) ≤ k * (K * ((w : ℝ) + 1) * ((vol (lay0.map (asz mz)) : ℝ) + 1) * (u : ℝ) ^ KFS.τS) + 1
  | 0, _ => by
    rw [rv_zero]
    refine ⟨hnd, hF, 1, (IRuns.skip t).mono' ?_ le_rfl, by simp⟩
    rw [← h0]; simp
  | k + 1, hk => by
    obtain ⟨hnd1, hF1, c1, H1, hc1⟩ := swC_spec hK hK0 mz bg hmz u hu ax0 lay0 hnd hF r hr hS w xs0
      hx I t R h0 k (by omega)
    have hk2 : 2 * k + 2 ≤ r := by omega
    set sh := lay0.map (asz mz)
    have hsh : ∀ m ≤ r, (rv r m lay0).map (asz mz) = sh := fun m hm => map_rv _ hr hm _ hS
    have hlen : (rv r (k + 1) lay0).length = lay0.length := length_rv _ _ _
    have hP := pop_swapPos (p := k) (q := r - 1 - k) (n := lay0.length) (by omega) (by omega)
    have hg := rv_step (l := lay0) hk2 hr
    have hD := Dl_step mz bg hP ax0 (rv r (k + 1) lay0) hlen (by rw [hg]; exact hnd1)
      (by rw [hg]; exact hF1) xs0 0
    rw [hg, hsh _ (by omega), hsh _ (by omega)] at hD
    have hpos : ∀ a ∈ sh, 1 ≤ a := by
      intro a ha; simp only [sh, List.mem_map] at ha; obtain ⟨l, -, rfl⟩ := ha
      exact asz_pos mz hmz l
    have gp : sh.getD k 0 = 2 ^ u := by
      simp only [sh, List.getD_eq_getElem?_getD, List.getElem?_map]
      rw [List.getElem?_eq_getElem (by omega)]
      simp only [Option.map_some, Option.getD_some]
      rw [← hS k (by omega), List.getD_eq_getElem _ _ (by omega)]
    have gq : sh.getD (r - 1 - k) 0 = 2 ^ u := by
      simp only [sh, List.getD_eq_getElem?_getD, List.getElem?_map]
      rw [List.getElem?_eq_getElem (by omega)]
      simp only [Option.map_some, Option.getD_some]
      rw [← hS (r - 1 - k) (by omega), List.getD_eq_getElem _ _ (by omega)]
    obtain ⟨c2, H2, hc2⟩ := hK u w sh k (r - 1 - k) hu hpos (by omega) (by simp [sh]; omega) gp gq
      I (t.upd 0 (ints (Dl mz bg ax0 (rv r k lay0) xs0 0) ++ R)) (Dl mz bg ax0 (rv r k lay0) xs0 0) R
      (by simp) (by simp [Dl, hsh _ (show k ≤ r by omega)]) (bnd_pull _ _ _ hx)
    rw [hD] at H2
    refine ⟨hP.nodup hlen (by rw [hg]; exact hnd1),
      hF1.mono (fun x hx => by rw [← hg] at hx; exact hP.mem hlen hx), c1 + c2,
      (H1.seq H2).mono' (by simp) le_rfl, ?_⟩
    push_cast
    nlinarith

end NLogN.KFU

end

