theorem yp_eq (C : CoeffModel y r) (e : ℤ) : yp y e = (y : R) ^ sOf r e := by
  have hr := C.pos
  have h2r : (0 : ℤ) < 2 * r := by positivity
  have hm : 0 ≤ e % (2 * r : ℤ) := Int.emod_nonneg _ h2r.ne'
