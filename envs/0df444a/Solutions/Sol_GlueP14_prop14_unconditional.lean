namespace GlueP14

open Matrix Finset Butterfly AModel

variable {W m s : ℕ} [NeZero W] (I : Prop8Iface W m s)

theorem pieceOp_eq {D off u k : ℕ} (h : off + u * m ^ k ≤ D) :
    pieceOp I D off u k = tensF (blockFam (blk D off (u * m ^ k)) Cm) := by
  rw [pieceOp, dif_pos h, recOp_eq, embed_tens]

theorem pieceList_eq (D : ℕ) : ∀ (ps : List (ℕ × ℕ)) (off : ℕ), off + tot m ps ≤ D →
    pieceList I D off ps = (blocks D m off ps).map fun S => tensF (blockFam S Cm)
  | [], _, _ => rfl
  | (u, k) :: ps, off, h => by
    simp only [tot] at h
    simp only [pieceList, blocks, List.map_cons]
    rw [pieceOp_eq I (by omega), pieceList_eq D ps (off + u * m ^ k) (by omega)]

lemma mem_blocks_ge {D : ℕ} : ∀ (ps : List (ℕ × ℕ)) (off : ℕ) (S : Finset (Fin D)),
    S ∈ blocks D m off ps → ∀ j ∈ S, off ≤ (j : ℕ)
  | [], _, _, hS, _, _ => by simp [blocks] at hS
  | (u, k) :: ps, off, S, hS, j, hj => by
    simp only [blocks, List.mem_cons] at hS
    rcases hS with rfl | hS
    · exact (mem_blk.1 hj).1
    · have := mem_blocks_ge ps _ S hS j hj; omega

lemma blocks_pairwise {D : ℕ} : ∀ (ps : List (ℕ × ℕ)) (off : ℕ),
    (blocks D m off ps).Pairwise Disjoint
  | [], _ => List.Pairwise.nil
  | (u, k) :: ps, off => by
    simp only [blocks, List.pairwise_cons]
    refine ⟨fun S hS => ?_, blocks_pairwise ps _⟩
    rw [Finset.disjoint_left]
    intro j hj hj'
    have h1 := (mem_blk.1 hj).2
    have h2 := mem_blocks_ge ps _ S hS j hj'
    omega

lemma blocks_cover {D : ℕ} : ∀ (ps : List (ℕ × ℕ)) (off : ℕ) (j : Fin D),
    off ≤ (j : ℕ) → (j : ℕ) < off + tot m ps → ∃ S ∈ blocks D m off ps, j ∈ S
  | [], off, j, h1, h2 => by simp [tot] at h2; omega
  | (u, k) :: ps, off, j, h1, h2 => by
    simp only [tot] at h2
    by_cases hj : (j : ℕ) < off + u * m ^ k
    · exact ⟨_, List.mem_cons_self .., mem_blk.2 ⟨h1, hj⟩⟩
    · obtain ⟨S, hS, hjS⟩ := blocks_cover ps (off + u * m ^ k) j (by omega) (by omega)
      exact ⟨S, List.mem_cons_of_mem _ hS, hjS⟩

/-- **The pieces multiply to `C^{⊗D}`** whenever their sizes add up to `D`. -/
theorem pieceList_prod (D : ℕ) (ps : List (ℕ × ℕ)) (hps : tot m ps = D) :
    (pieceList I D 0 ps).prod = Butterfly.tens Cm := by
  rw [pieceList_eq I D ps 0 (by omega), tens_blocks Cm _ (blocks_pairwise ps 0)
    (fun j => blocks_cover (m := m) ps 0 j (Nat.zero_le _) (by have := j.isLt; omega))]

lemma tot_digitPieces (m : ℕ) : ∀ f D k, tot m (digitPieces m f D k) = D % m ^ f * m ^ k
  | 0, D, k => by simp [digitPieces, tot, Nat.mod_one]
  | f + 1, D, k => by
    simp only [digitPieces, tot, tot_digitPieces m f (D / m) (k + 1)]
    rw [pow_succ' m f, Nat.mod_mul, pow_succ]; ring

lemma tot_digitPieces_full {m : ℕ} (hm : 2 ≤ m) (D : ℕ) : tot m (digitPieces m D D 0) = D := by
  rw [tot_digitPieces, pow_zero, mul_one, Nat.mod_eq_of_lt (Nat.lt_pow_self (by omega))]

theorem cRec_eq (hm : 2 ≤ m) (D : ℕ) : cRec I D = Butterfly.tens Cm :=
  pieceList_prod I D _ (tot_digitPieces_full hm D)

theorem cRecC_eq (D : ℕ) : cRecC D = Butterfly.tens Cm := cRec_eq _ (by norm_num) D

