-- title:
--   Actual contract laws, conditional utility, admissibility and extended principal value
-- statement:
--   A contract specifies a sample space, the arrival and random-switch event streams, deterministic switches, a nonnegative locally finite payment measure, its continuous flow, a predictable switching intensity, and the law induced by each admissible binary effort. Public information is generated by arrivals and total switches. The deterministic control may use this history and the initial public lottery; it introduces no third independent noise source. This last condition makes precise the intended word “deterministic”; see DISPROOF.md for the failure of promise keeping under adaptedness alone.
--
--   The complying effort is $\mu$ in the working state and $\underline\mu$ in suspension. All publicly adapted right-continuous binary deviations are included, with the predictable left version used for intensities. No left-limit condition is imposed on effort paths. Payments have an absolutely continuous continuous part, satisfy limited liability, and include any payment at time zero. Conditional continuation utility excludes the payment at the conditioning time.
--
--   Utilities are computed from the actual cash flows:
--   $$u(\Gamma,\nu)=E^{\nu,q}\!\left[\int_0^\infty e^{-\rho t}(dL_t-b\mathbf1_{\nu_t=\mu}\,dt)\right],$$
--   $$U(\Gamma)=E^{\bar\nu,q}\!\left[\int_0^\infty e^{-rt}(R\,dN_t-dL_t-(c-b)\mathbf1_{E_t=I}\,dt)-\sum_{t\ge0}e^{-rt}\kappa(E_{t-},E_t)\right].$$
--   The contract class enforces (1), (LL), (IR), a single existential (WU) bound per contract, uniform over its admissible efforts and time, and utility-based incentive compatibility over every admissible deviation. Promise keeping is not an assumed field. Infinite initial expected payments are allowed: agent utility may be $+\infty$ and principal utility $-\infty$. Finiteness of future rho-discounted expected payments follows from bounded conditional utility and bounded effort cost; it is not an extra integrability premise. Optimality means feasibility and dominance over all feasible contracts on all sample spaces; the extended supremum does not assume attainment.
-- source:
--   Cao, Sun, Tian, Punish Underperformance with Suspension: Optimal Dynamic Contracts in the Presence of Switching Cost, Management Science (2024), doi:10.1287/mnsc.2023.4845, authors' manuscript (2023-03-15), SHA-256 39e9a1afe4665462f93250c221173be577581eb346a2679660d4de54a49b3304, §2 pp. 7–12, (1)–(10), (LL), (IR), (WU); endnotes 3–6 pp.33–34

import Mathlib
import Definitions.Def_SuspensionContract_HighCostC2_Supplement_PointProcesses
import Definitions.Def_SuspensionContract_HighCostC2_Setting

namespace SuspensionContract.HighCostC2.Supplement

open MeasureTheory ProbabilityTheory Set Filter
open scoped ENNReal NNReal Topology

/-- The law-free primitives of a weak controlled counting-process contract. The law family is
indexed by the entire effort process. Intensities and nonanticipation are checked separately;
there is no utility, promise-keeping identity or optimality axiom among these data. -/
structure RawContract (Ω : Type) [m : MeasurableSpace Ω] where
  N : EventStream Ω
  Q : EventStream Ω
  D : EventStream Ω
  payment : Ω → Measure ℝ≥0
  flow : ℝ≥0 → Ω → ℝ
  q : ℝ≥0 → Ω → ℝ
  F : Filtration ℝ≥0 m
  law : (ℝ≥0 → Ω → ℝ) → Measure Ω

/-- Bundle the sample space as well: optimality compares contracts on every probability space,
not merely controls representable on a previously fixed finite sample space. -/
structure Contract where
  Ω : Type
  space : MeasurableSpace Ω
  data : @RawContract Ω space

attribute [instance] Contract.space

/-- Public information generated by the complete arrival/switching history up to t, §2 p.8. -/
@[instance_reducible] noncomputable def publicInfo {Ω : Type} [MeasurableSpace Ω] (G : RawContract Ω) (t : ℝ≥0) :
    MeasurableSpace Ω :=
  ⨆ s : {s : ℝ≥0 // s ≤ t}, MeasurableSpace.comap
    (fun ω => (G.N.count s ω, G.D.count s ω + G.Q.count s ω)) inferInstance

/-- Information carried by the two stochastic event streams. Deterministic switching may
react to these events and the initial public lottery, but may not introduce a third noise source. -/
@[instance_reducible] noncomputable def eventInfo {Ω : Type} [MeasurableSpace Ω]
    (G : RawContract Ω) (t : ℝ≥0) : MeasurableSpace Ω :=
  ⨆ s : {s : ℝ≥0 // s ≤ t}, MeasurableSpace.comap
    (fun ω => (G.N.count s ω, G.Q.count s ω)) inferInstance

open Classical in
/-- Odd total switching count means working; the pre-time-zero state is suspension. -/
def working {Ω : Type} [MeasurableSpace Ω] (G : RawContract Ω) (t : ℝ≥0) (ω : Ω) : Prop :=
  Odd (Nat.floor (G.D.count t ω + G.Q.count t ω))

open Classical in
/-- State just before t (including suspension at 0-). -/
def workingBefore {Ω : Type} [MeasurableSpace Ω] (G : RawContract Ω) (t : ℝ≥0) (ω : Ω) : Prop :=
  Odd (Nat.floor (G.D.before t ω + G.Q.before t ω))

open Classical in
/-- Complying effort, exactly μ in state I and μlow in suspension. -/
noncomputable def complying (P : Params) (G : Contract) : ℝ≥0 → G.Ω → ℝ :=
  fun t ω => if working G.data t ω then P.μ else P.μlow

open Classical in
/-- Predictable left-limsup version of a binary right-continuous effort. It equals the ordinary
left limit wherever that limit exists and agrees with the effort dt-a.e. The bounded binary
range prevents any unbounded-limsup default; no càdlàg restriction is imposed on deviations. -/
noncomputable def rateBefore {Ω : Type} (ν : ℝ≥0 → Ω → ℝ) (t : ℝ≥0) (ω : Ω) : ℝ :=
  if t = 0 then ν 0 ω else limsup (fun s => ν s ω) (nhdsWithin t (Iio t))

/-- All binary, publicly adapted right-continuous efforts that cannot exert effort in suspension.
The intensity uses the predictable left version, as specified in endnote 6 (p.34). -/
def AdmissibleEffort (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ) : Prop :=
  (∀ t, Measurable[G.data.F t] (ν t)) ∧
  (∀ ω t, ContinuousWithinAt (fun s => ν s ω) (Ici t) t) ∧
  IsStronglyPredictable G.data.F (rateBefore ν) ∧
  ∀ t ω, (ν t ω = P.μlow ∨ ν t ω = P.μ) ∧
    (¬working G.data t ω → ν t ω = P.μlow)

/-- Contract/law requirements of §2, (1), LL and endnote 3. These constraints describe the
stochastic environment, not any assertion to be proved in Proposition 1 or Theorem 1. -/
def WellFormed (P : Params) (G : Contract) : Prop :=
  (∀ t, G.data.F t = publicInfo G.data t) ∧
  (∀ t, G.data.F t = G.data.F 0 ⊔ eventInfo G.data t) ∧
  (∀ n, Measurable (G.data.D.time n)) ∧
  (∀ t, Measurable[G.data.F t] (G.data.D.count t)) ∧
  (∀ t, Measurable[G.data.F t] (fun ω => G.data.payment ω (Iic t))) ∧
  IsStronglyProgressive G.data.F G.data.flow ∧
  IsStronglyPredictable G.data.F G.data.q ∧
  (∀ t ω, 0 ≤ G.data.q t ω ∧ 0 ≤ G.data.flow t ω ∧
    (working G.data t ω → P.b ≤ G.data.flow t ω)) ∧
  (∀ ω t, G.data.payment ω (Iic t) < ⊤) ∧
  (∀ ω, G.data.payment ω = timeMeasure.withDensity (fun t => ENNReal.ofReal (G.data.flow t ω)) +
    Measure.sum (fun t : ℝ≥0 => G.data.payment ω {t} • Measure.dirac t)) ∧
  (∀ ν ν', AdmissibleEffort P G ν → AdmissibleEffort P G ν' →
    ∀ A : Set G.Ω, MeasurableSet[G.data.F 0] A → G.data.law ν A = G.data.law ν' A) ∧
  ∀ ν, AdmissibleEffort P G ν →
    G.data.law ν Set.univ = 1 ∧
    HasIntensity G.data.F (G.data.law ν) G.data.N (rateBefore ν) ∧
    HasIntensity G.data.F (G.data.law ν) G.data.Q G.data.q ∧
    (∀ᵐ ω ∂G.data.law ν, G.data.N.jump 0 ω = 0 ∧ G.data.Q.jump 0 ω = 0 ∧
      ∀ t, G.data.N.jump t ω * G.data.Q.jump t ω = 0 ∧
        G.data.D.jump t ω + G.data.Q.jump t ω ≤ 1) ∧
    (∫⁻ ω, ∫⁻ t, ENNReal.ofReal (G.data.q t ω * Real.exp (-P.r * (t : ℝ)))
      ∂timeMeasure ∂G.data.law ν) < ⊤

open Classical in
/-- Discounted effort disutility after (or including) t. -/
noncomputable def effortTail (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ)
    (t : ℝ≥0) (ω : G.Ω) : ℝ≥0∞ :=
  ∫⁻ s in Ioi t, ENNReal.ofReal
    (Real.exp (-P.ρ * (s : ℝ)) * (if ν s ω = P.μ then P.b else 0)) ∂timeMeasure

/-- Expected utility (2), as an extended real difference of nonnegative integrals. Positive
payment expectations may be infinite; effort cost is finite under the standing assumptions. -/
noncomputable def agentUtility (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ) : EReal :=
  ((∫⁻ ω, discounted P.ρ (G.data.payment ω) ∂G.data.law ν) : EReal) -
    ((∫⁻ ω, effortTail P G ν 0 ω ∂G.data.law ν) : EReal)

/-- Conditional continuation utility (4). The strict tail excludes a payment at t, endnote 4.
The conditional expectations are nonnegative extended integrals, so nonintegrability does
not turn an infinite expected payment into a spurious zero. -/
noncomputable def conditionalUtility (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ)
    (t : ℝ≥0) (ω : G.Ω) : EReal :=
  (Real.exp (P.ρ * (t : ℝ)) : EReal) *
    (((condLExp (G.data.F t) (G.data.law ν)
        (fun ω' => discounted P.ρ ((G.data.payment ω').restrict (Ioi t)))) ω : EReal) -
      ((condLExp (G.data.F t) (G.data.law ν) (effortTail P G ν t)) ω : EReal))

/-- A càdlàg version of (4), with no dynamical or incentive assertion built in. -/
def ContinuationVersion (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ)
    (X : ℝ≥0 → G.Ω → ℝ) : Prop :=
  (∀ ω, CadlagOnHalfLine (fun t => X t ω)) ∧
  ∀ t, (fun ω => (X t ω : EReal)) =ᵐ[G.data.law ν] conditionalUtility P G ν t

open Classical in
/-- The promised utility is a version of the actual conditional expectation, not an arbitrary
state variable or a solution of PK. Values outside existence of a version are unused. -/
noncomputable def promised (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ) :
    ℝ≥0 → G.Ω → ℝ :=
  if h : ∃ X, ContinuationVersion P G ν X then Classical.choose h
  else fun t ω => (conditionalUtility P G ν t ω).toReal

/-- A real càdlàg version of the actual conditional utility exists. No dynamics are assumed. -/
def UtilityRegular (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ) : Prop :=
  ∃ X, ContinuationVersion P G ν X

/-- WU is one existential finite bound for this contract, uniform over its admissible efforts
and time. There is no bound fixed across all contracts. Bounded effort cost and the conditional
expectation identity then imply finite expected future rho-discounted payments. -/
def BoundedContinuation (P : Params) (G : Contract) : Prop :=
  ∃ B : ℝ, ∀ ν, AdmissibleEffort P G ν →
    ∀ᵐ ω ∂G.data.law ν, ∀ t, promised P G ν t ω ≤ B

/-- Individual rationality (IR), interpreted as an indistinguishable pathwise condition. -/
def IR (P : Params) (G : Contract) (ν : ℝ≥0 → G.Ω → ℝ) : Prop :=
  ∀ᵐ ω ∂G.data.law ν, ∀ t, 0 ≤ promised P G ν t ω

/-- Incentive compatibility quantifies over every admissible deviation, using its own law. -/
def IC (P : Params) (G : Contract) : Prop :=
  ∀ ν, AdmissibleEffort P G ν → agentUtility P G ν ≤ agentUtility P G (complying P G)

/-- The source class C: the primitive stochastic constraints, bounded conditional utilities,
individual rationality, and the genuine utility-comparison definition of IC. PK is not assumed. -/
def Feasible (P : Params) (G : Contract) : Prop :=
  WellFormed P G ∧ AdmissibleEffort P G (complying P G) ∧ BoundedContinuation P G ∧
  (∀ ν, AdmissibleEffort P G ν → UtilityRegular P G ν ∧ IR P G ν) ∧ IC P G

open Classical in
/-- Discounted cost of restarting, including a start at time 0. -/
noncomputable def restartCost (P : Params) (G : Contract) (ω : G.Ω) : ℝ≥0∞ :=
  ∫⁻ t, ENNReal.ofReal (Real.exp (-P.r * (t : ℝ)) *
      (if ¬workingBefore G.data t ω ∧ working G.data t ω then P.K else 0))
    ∂(G.data.D.measure ω + G.data.Q.measure ω)

open Classical in
/-- Principal utility (6): actual discounted revenue minus payment, operating and restart costs.
It can equal -infinity when r-discounted payment costs are infinite. -/
noncomputable def principalUtility (P : Params) (G : Contract) : EReal :=
  ((∫⁻ ω, ENNReal.ofReal P.R * discounted P.r (G.data.N.measure ω)
    ∂G.data.law (complying P G)) : EReal) -
  ((∫⁻ ω, discounted P.r (G.data.payment ω) + restartCost P G ω +
    ∫⁻ t, ENNReal.ofReal (Real.exp (-P.r * (t : ℝ)) *
      (if working G.data t ω then P.c - P.b else 0)) ∂timeMeasure
    ∂G.data.law (complying P G)) : EReal)

/-- Optimality is feasibility plus dominance over the complete source contract class. -/
def IsOptimal (P : Params) (G : Contract) : Prop :=
  Feasible P G ∧ ∀ G' : Contract, Feasible P G' → principalUtility P G' ≤ principalUtility P G

/-- Extended optimum; attainment is a theorem, not built into the supremum definition. -/
noncomputable def optimalValue (P : Params) : EReal :=
  ⨆ G : {G : Contract // Feasible P G}, principalUtility P G.val

end SuspensionContract.HighCostC2.Supplement


