variable {Pp : ℕ} {I : List Sym} {iprog : Fin Pp → IStmt HS Pp}

section Lay

variable (mz : ℕ → ℕ) (bg : ℕ → Bool)

theorem bitsF_cons (j : ℕ) (L : List ℕ) :
    bitsF bg (j :: L) = (if bg j then [2 * j + 1] else []) ++ bitsF bg L := by
  simp only [bitsF, List.filter_cons]
  by_cases h : bg j <;> simp [h]

theorem perm_layA_F : ∀ L : List ℕ, List.Perm (layA bg L) (mains L ++ bitsF bg L)
  | [] => by simp [layA, mains, bitsF]
  | j :: L => by
    rw [layA_cons, bitsF_cons]
    simp only [atm, mains, List.map_cons, List.cons_append]
    refine List.Perm.cons _ ?_
    have IH := perm_layA_F L
    set bj : List ℕ := if bg j = true then [2 * j + 1] else []
    have h1 : List.Perm (bj ++ layA bg L) (bj ++ (mains L ++ bitsF bg L)) := IH.append_left _
    have h2 : List.Perm (bj ++ (mains L ++ bitsF bg L)) (mains L ++ (bj ++ bitsF bg L)) := by
      rw [← List.append_assoc, ← List.append_assoc]; exact List.perm_append_comm.append_right _
    simpa [mains] using h1.trans h2

theorem perm_layA_R (L : List ℕ) : List.Perm (layA bg L) (mains L ++ bitsR bg L) := by
  refine (perm_layA_F bg L).trans (List.Perm.append_left _ ?_)
  simp only [bitsR, bitsF, List.filter_reverse, List.map_reverse]
  exact (List.reverse_perm _).symm

theorem vol_perm {L M : List ℕ} (h : List.Perm L M) : AModel.vol (L.map (asz mz)) = AModel.vol (M.map (asz mz)) :=
  (h.map _).prod_eq

end Lay

