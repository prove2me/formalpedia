section PowerSums

variable {F : Type} [Field F] [Algebra (ZMod 2) F]

variable {N : ℕ}

/-- The power sums commute with scalar multiplication. -/
theorem pinPower_smul (ι : ℕ → F) (a : ℕ) (c : ZMod 2) (x : Fin N → ZMod 2) :
    pinPower ι a (c • x) = c • pinPower ι a x := by
  have h : ∀ i : Fin N, (c • x) i • (ι i.val ^ a) = c • (x i • (ι i.val ^ a)) := by
    intro i
    rw [Pi.smul_apply, smul_eq_mul, smul_smul]
  simp only [pinPower]
  rw [Finset.smul_sum]
  exact Finset.sum_congr rfl (fun i _ => h i)

/-- **Proposition 2.1, first conjunct**: `Pin_{N,t}` is `F₂`-linear. -/
theorem pin_isLinearMap (ι : ℕ → F) (t : ℕ) :
    IsLinearMap (ZMod 2) (pin (N := N) ι t) := by
  constructor
  · intro x y
    funext j
    show pinPower ι (2 * j.val + 1) (x + y)
      = pinPower ι (2 * j.val + 1) x + pinPower ι (2 * j.val + 1) y
    exact pinPower_add ι _ x y
  · intro c x
    funext j
    show pinPower ι (2 * j.val + 1) (c • x) = c • pinPower ι (2 * j.val + 1) x
    exact pinPower_smul ι _ c x

end PowerSums

