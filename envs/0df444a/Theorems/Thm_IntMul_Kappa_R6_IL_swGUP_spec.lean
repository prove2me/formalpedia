variable {tab : Fin 1 → IStmt HS 1} {l12 : IStmt HS 1} {τ : ℝ}

theorem IntMul.Kappa.R6.IL.swGUP_spec (hτ : 0 ≤ τ) (h : L12Canon tab l12 τ) :
    ∃ K : ℝ, 0 ≤ K ∧
      ∀ (u w : ℕ) (sh : Shape) (p q : ℕ), 1 ≤ u → (∀ a ∈ sh, 1 ≤ a) → p < q → q < sh.length →
      sh.getD p 0 = 2 ^ u → sh.getD q 0 = 2 ^ u →
      ∀ (I : List Sym) (s : IState HS) (f : Fin HS → List ℤ) (zs : List GI) (l : List ℤ),
      (∀ j, j ≠ 0 → j ≠ dS → f j = []) → f dS = KFM.descSw w u p q sh →
      f 0 = gflat zs ++ l → zs.length = vol sh → GB w zs →
      ∃ c : ℕ, IRuns I tab (swGUP l12) (encK s f)
        (encK s (Function.update f 0 (gflat (pull sh sh (swapPos p q) 0 zs) ++ l))) c ∧
        (c : ℝ) ≤ K * (((w : ℝ) + 1) * ((vol sh : ℝ) + 1) * (u : ℝ) ^ τ +
          (((sh.length + 1) * (Nat.size (vol sh) + w + u + 1) ^ 2 : ℕ) : ℝ)) := by sorry
