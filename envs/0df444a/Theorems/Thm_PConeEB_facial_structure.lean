-- title:
--   Display (4.5) — $\mathcal F_z$ is the ray generated by $f$
-- statement:
--   Let $n\ge2$, $p,q\in(1,\infty)$ with $\frac1p+\frac1q=1$, and $z=(z_0,\bar z)\in\partial\mathcal K_q^{n+1}\setminus\{0\}$. Then $z_0=\|\bar z\|_q>0$ and
--   $$
--   \mathcal F_z:=\{z\}^\perp\cap\mathcal K_p^{n+1}=\{tf: t\ge0\},\qquad f:=\begin{bmatrix}1\\-\operatorname{sgn}(\bar z)\circ|z_0^{-1}\bar z|^{q-1}\end{bmatrix},
--   $$
--   and $f$ is a nonzero point of $\mathcal K_p^{n+1}$.
--
--   The display identifies the nontrivial faces of the $p$-cone as explicit extreme rays.
--
--   Differences from the source:
--   - encoding: f ∈ F_z \ {0}, stated at Lemma 4.2, p.22, and implicit in (4.5) → the clauses facialVec q z ∈ pCone n p and facialVec q z ≠ 0 in this item; reason: the ray is one-dimensional because of them; recorded in one place
--   - encoding: ℝ^{n+1}, x₀, x̄, ‖x̄‖_p, ∂ → RR n = EuclideanSpace ℝ (Fin (n + 1)), x 0, x i.succ for i : Fin n, pNorm with real rpow, frontier; reason: Lean conventions; same instances
-- source:
--   Lindstrom, Lourenço & Pong, Optimal error bounds in the absence of constraint qualifications, arXiv:2109.11729v4, (4.5), p.18

import Mathlib
import Definitions.Def_PConeEB_hyperplane
import Definitions.Def_PConeEB_pCone
import Definitions.Def_PConeEB_pNorm
import Definitions.Def_PConeEB_facialVec

namespace PConeEB

/-- The facial structure (4.5): for `z ∈ ∂K_q^{n+1} \ {0}`, `z₀ = ‖z̄‖_q > 0` and
`F_z := {z}^⊥ ∩ K_p^{n+1} = {t f | t ≥ 0}`, where `f := (1, -sgn(z̄) ∘ |z₀⁻¹ z̄|^{q-1})` is a nonzero
point of `K_p^{n+1}`. Lindstrom, Lourenço & Pong, arXiv:2109.11729v4, (4.5), p.18.

**Formalization Note.** `∂` is `frontier` in `ℝ^{n+1}`. -/
theorem facial_structure {n : ℕ} (hn : 2 ≤ n) {p q : ℝ} (hp : 1 < p)
    (hpq : 1 / p + 1 / q = 1) {z : RR n} (hz : z ∈ frontier (pCone n q)) (hz0 : z ≠ 0) :
    z 0 = pNorm q (fun i : Fin n => z i.succ) ∧ 0 < z 0 ∧
      pCone n p ∩ hyperplane z = {x | ∃ t : ℝ, 0 ≤ t ∧ x = t • facialVec q z} ∧
      facialVec q z ∈ pCone n p ∧ facialVec q z ≠ 0 := by sorry

end PConeEB
