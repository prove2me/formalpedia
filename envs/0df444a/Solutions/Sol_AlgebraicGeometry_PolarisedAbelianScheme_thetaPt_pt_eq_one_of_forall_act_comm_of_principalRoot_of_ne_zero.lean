theorem g1_isCommutative : L'.IsCommutative := by
  intro T t' x y
  apply Subtype.ext
  apply pullback.hom_ext
  · rw [hL', hL', u.comm]
  · rw [(L'.mul t' x y).2, (L'.mul t' y x).2]

