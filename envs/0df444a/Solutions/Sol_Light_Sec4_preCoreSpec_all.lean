    (τ : Leaf p.L) (hτ : (digitsT τ).count 9 ≤ p.m) : memCol p b0 μ β τ = encCol p hmL Y β τ :=
  memEnc_eq (h.encB β hβ) τ hτ

/-- The tries built from the encodings as the memory holds them are the tries of the data
structure. -/
