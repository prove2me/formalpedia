-- Source module: Solutions.J6Sieve
/-!
# J6Sieve: pairwise coprime odd numbers in short windows

Elementary (Brun pure sieve + greedy) construction: if `d` windows `(A_i, A_i + H]` lie in
`(0, X]` and `H > sieveBound d X`, one can choose odd, pairwise coprime `s_i` in them.
`sieveBound d X < 2 ^ (4 * (log₂ (4 (d (log₂ X + 1) + 1)) + 2)^2)`.
-/

namespace J6Sieve
open Finset

lemma bound_core (z Ω k m : ℕ) (hzΩ : z = 4 * (Ω + 1)) (hk : z < 2 ^ k) (hmk : m = 4 * k + 3) :
    2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1) < 2 ^ (4 * (k + 1) ^ 2) := by
  have hΩ : Ω + 2 ≤ 2 ^ k := by omega
  have hm : m + 2 ≤ 2 ^ (k + 3) := by
    have := Nat.lt_two_pow_self (n := k)
    rw [pow_add]; omega
  have hzpos : 0 < z := by omega
  have h1 : z ^ (m + 1) ≤ (2 ^ k) ^ (m + 1) := Nat.pow_le_pow_left hk.le _
  have h2 : 0 < z ^ (m + 1) := by positivity
  calc 2 * z * (Ω + 2) * (m + 2) * z ^ (m + 1)
      < 2 * 2 ^ k * (Ω + 2) * (m + 2) * z ^ (m + 1) := by
        apply Nat.mul_lt_mul_of_pos_right _ h2
        apply Nat.mul_lt_mul_of_pos_right _ (by omega)
        apply Nat.mul_lt_mul_of_pos_right _ (by omega)
        omega
    _ ≤ 2 * 2 ^ k * 2 ^ k * 2 ^ (k + 3) * (2 ^ k) ^ (m + 1) := by gcongr
    _ = 2 ^ (4 * k ^ 2 + 7 * k + 4) := by
        rw [hmk, ← pow_mul, show 2 * 2 ^ k * 2 ^ k * 2 ^ (k + 3) = 2 ^ (3 * k + 4) by ring,
          ← pow_add]
        congr 1; ring
    _ ≤ 2 ^ (4 * (k + 1) ^ 2) := Nat.pow_le_pow_right (by norm_num) (by nlinarith)

/-- Explicit size of the bound: `log₂ sieveBound < 4 (log₂ (4(Ω+1)) + 2)^2`. -/
theorem sieveBound_lt (d X : ℕ) :
    sieveBound d X < 2 ^ (4 * (Nat.log 2 (4 * (d * (Nat.log 2 X + 1) + 1)) + 2) ^ 2) :=
  bound_core (zz d X) (Om d X) (kk d X) (mm d X) rfl
    (Nat.lt_pow_succ_log_self (by norm_num) _) rfl

end J6Sieve

end

