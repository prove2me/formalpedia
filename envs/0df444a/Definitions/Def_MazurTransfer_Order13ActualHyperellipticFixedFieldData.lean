import Definitions.Def_MazurTransfer_Order13ActualOrderThreeFixedFieldData

noncomputable section
namespace MazurTransfer.Order13ActualHyperellipticFixedField
open Polynomial
open GoodCharacteristicGeometryPublicProof.MazurTransfer.Order13GoodCharacteristicCurveModel
open Order13PellActualOrdinaryChart Order13ActualOrdinaryPolynomialTranscendence
open Order13ActualDiamondFunctionFieldAutomorphism Order13ActualDiamondExactOrder
open Order13ActualDiamondFunctionFieldMap Order13ActualFunctionFieldGenerators
open Order13PellChartCertificate
local instance : Fact ((104 : ℚ) ≠ 0) := ⟨by norm_num⟩

def xField : IntermediateField ℚ (actualCurveFunctionField ℚ) :=
  IntermediateField.adjoin ℚ {xImage ℚ}

theorem x_mem : xImage ℚ ∈ xField := IntermediateField.subset_adjoin ℚ _ (by simp)

theorem sextic_mem : sextic (xImage ℚ) ∈ xField := by
  change Order13PellChartCertificate.sextic (xImage ℚ) ∈ xField
  unfold Order13PellChartCertificate.sextic
  exact xField.add_mem
    (xField.add_mem
      (xField.add_mem
        (xField.add_mem
          (xField.add_mem
            (xField.add_mem (pow_mem x_mem 6)
              (xField.mul_mem (xField.natCast_mem 2) (pow_mem x_mem 5)))
            (pow_mem x_mem 4))
          (xField.mul_mem (xField.natCast_mem 2) (pow_mem x_mem 3)))
        (xField.mul_mem (xField.natCast_mem 6) (pow_mem x_mem 2)))
      (xField.mul_mem (xField.natCast_mem 4) x_mem))
    xField.one_mem

theorem y_generates : IntermediateField.adjoin xField {yImage ℚ} = ⊤ := by
  apply IntermediateField.restrictScalars_injective ℚ
  rw [IntermediateField.restrictScalars_top]
  apply intermediateField_eq_top
  · exact (IntermediateField.adjoin xField {yImage ℚ}).algebraMap_mem ⟨xImage ℚ, x_mem⟩
  · exact IntermediateField.subset_adjoin xField _ (by simp)

def quadratic : Polynomial xField := X ^ 2 - C ⟨sextic (xImage ℚ), sextic_mem⟩

theorem quadratic_monic : quadratic.Monic := monic_X_pow_sub_C _ (by decide : 2 ≠ 0)
theorem quadratic_degree : quadratic.natDegree = 2 := by unfold quadratic; compute_degree!
theorem quadratic_root : aeval (yImage ℚ) quadratic = 0 := by
  simp only [quadratic, map_sub, map_pow, aeval_X, aeval_C]
  change yImage ℚ ^ 2 - sextic (xImage ℚ) = 0
  exact sub_eq_zero.mpr yImage_sq

theorem y_integral : IsIntegral xField (yImage ℚ) := ⟨quadratic, quadratic_monic, quadratic_root⟩
theorem curveField_finite : FiniteDimensional xField (actualCurveFunctionField ℚ) := by
  have := IntermediateField.adjoin.finiteDimensional y_integral
  rw [y_generates] at this
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

theorem curveField_degree_le_two : Module.finrank xField (actualCurveFunctionField ℚ) ≤ 2 := by
  have H := Polynomial.natDegree_le_natDegree (minpoly.min xField (yImage ℚ) quadratic_monic quadratic_root)
  rw [quadratic_degree] at H
  rw [← IntermediateField.finrank_top', ← y_generates, IntermediateField.adjoin.finrank y_integral]
  exact H

def involutionGroup : Subgroup (actualCurveFunctionField ℚ ≃ₐ[ℚ] actualCurveFunctionField ℚ) :=
  Subgroup.zpowers (diamondAlgEquiv ^ 3)

theorem involutionGroup_card : Nat.card involutionGroup = 2 := by
  rw [involutionGroup, Nat.card_zpowers,
    orderOf_pow' (x := diamondAlgEquiv) (n := 3) (by decide), diamondAlgEquiv_order]
  norm_num
instance : Finite involutionGroup := Nat.finite_of_card_ne_zero (by rw [involutionGroup_card]; decide)

def involutionFixedField : IntermediateField ℚ (actualCurveFunctionField ℚ) :=
  IntermediateField.fixedField involutionGroup

theorem fixedField_degree : Module.finrank involutionFixedField (actualCurveFunctionField ℚ) = 2 := by
  rw [involutionFixedField, FiniteAutomorphismSubgroupFixedFieldDegree.finrank_fixedField,
    involutionGroup_card]

theorem x_fixedField_mem : xImage ℚ ∈ involutionFixedField := by
  apply (IntermediateField.mem_fixedField_iff _ _).mpr
  intro f hf
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hf
  have H : xImage ℚ ∈ MulAction.fixedBy (actualCurveFunctionField ℚ) (diamondAlgEquiv ^ 3) := by
    change diamondThird (xImage ℚ) = xImage ℚ
    exact diamondThird_x
  exact MulAction.mem_fixedBy_zpow H n

theorem actual_hyperelliptic_fixed_field : xField = involutionFixedField := by
  have hle : xField ≤ involutionFixedField := by
    apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    exact Set.mem_singleton_iff.mp hz ▸ x_fixedField_mem
  letI := curveField_finite
  apply IntermediateField.eq_of_le_of_finrank_le' hle
  rw [fixedField_degree]
  exact curveField_degree_le_two

theorem curveField_degree_two : Module.finrank xField (actualCurveFunctionField ℚ) = 2 := by
  rw [actual_hyperelliptic_fixed_field]
  exact fixedField_degree

local instance : Algebra ℚ xField := IntermediateField.algebra' xField
local instance : Algebra ℚ (RatFunc ℚ) := RatFunc.instAlgebraOfPolynomial ℚ ℚ

def rationalInvolutionFieldEquiv : RatFunc ℚ ≃ₐ[ℚ] xField :=
  RatFunc.algEquivOfTranscendental (xImage ℚ) xImage_transcendental

theorem curveField_galois : IsGalois xField (actualCurveFunctionField ℚ) := by
  rw [actual_hyperelliptic_fixed_field]
  exact IsGalois.of_fixed_field (actualCurveFunctionField ℚ) involutionGroup

end MazurTransfer.Order13ActualHyperellipticFixedField
