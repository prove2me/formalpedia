theorem IntMul.Kappa.R6.IL3H.midQ {c : IntMul.Kappa.R6.IL3H.Cfg} (jL : Fin Pp) (rowC : IStmt HS Pp)
    (hL : tbl jL = levCH c jL rowC)
    {K S r H P D ρ q0 Bp qB Z Zf Zr G : ℕ} {CB : ℕ → ℝ}
    (LV : LvH c Isym tbl jL rowC K r Z Zr H G CB (D - q0 - qB))
    (hρ : ρ < K) (hS : 1 ≤ S) (hP : 1 ≤ P) (hr : 1 ≤ r) (hlt : q0 + qB < D)
    (hBpP : P * 2 ^ (K * q0) ≤ Bp) (hBp2 : Bp ≤ 2 * (P * 2 ^ (K * q0)))
    (hdvd : c.W ^ dep c.m (D - q0 - qB) * 2 ^ (2 * (((D - q0 - qB) / c.m - 1) * G)) ∣ Bp)
    (hSd : ((D - q0 - qB) / c.m - 1) * G ≤ K * qB)
    (hZl : zsz ((32 * c.Wr * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Z)
    (hZf : zsz ((32 * (P * 2 ^ (K * D) * S * r) : ℕ) : ℤ) ≤ Zf)
    (hHf : zsz (H : ℤ) ≤ Zf) (hGH : c.G (D - q0 - qB) ≤ H)
    (hV : zsz ((VbH c K (K * (D - q0 - qB)) (S * 2 ^ (K * qB)) r H (D - q0 - qB)
